Dialogue: 0,0:07:00.25,0:07:02.55,كيث,,0,0,0,,لقد تم تأخير مراسم العزاء لشهر من الأن
Dialogue: 0,0:07:02.58,0:07:04.37,كيث,,0,0,0,,و تم تحديد المدعوين أيضاً
Dialogue: 0,0:07:05.02,0:07:08.02,all,,0,0,0,,بمثل هذه الحادثة , ليس لدينا خيارً آخر
Dialogue: 0,0:07:08.88,0:07:12.17,all,,0,0,0,,مع ذلك لقد كنت بجانبهم , هذا حزين جداً
Dialogue: 0,0:07:13.00,0:07:13.80,all,,0,0,0,,على الأقل
Dialogue: 0,0:07:13.92,0:07:16.00,all,,0,0,0,,علينا أن نحمي الأميرة قبل أن تنتحر هي الأخري
Dialogue: 0,0:07:16.66,0:07:21.66,note,,0,0,0,,{\pos(570,410)}كيث دان ستينغر\N كونت فيسبانيا
Dialogue: 0,0:07:16.67,0:07:18.71,كيث,,0,0,0,,لاتلم نفسك
Dialogue: 0,0:07:19.59,0:07:21.34,كيث,,0,0,0,,لقد حصل وأنتهى الآمر
Dialogue: 0,0:07:22.04,0:07:24.14,كيث,,0,0,0,,يجب علينا أن نركز على الاشياء القادمة
Dialogue: 0,0:07:24.14,0:07:27.14,all,,0,0,0,,. أنا سعيد لسماع ذلك
Dialogue: 0,0:07:28.55,0:07:30.25,all,,0,0,0,,كيف حال الأميرة ميرا الان ؟
Dialogue: 0,0:07:30.51,0:07:32.22,كيث,,0,0,0,,مازالت كما هي
Dialogue: 0,0:07:32.51,0:07:35.22,كيث,,0,0,0,,مازالت ترفض أن تصبح الملكة
Dialogue: 0,0:07:36.15,0:07:40.56,all,,0,0,0,,كل من والدتها وأخيها قد ماتا في يوم واحد , هذا مفهوم
Dialogue: 0,0:07:40.96,0:07:41.74,all,,0,0,0,,... بالأضافة
Dialogue: 0,0:07:43.59,0:07:45.09,all,,0,0,0,,مازال هناك أمرً أخر
Dialogue: 0,0:07:48.45,0:07:52.77,all,,0,0,0,,! لا تعطوا العرش للأميرة ميرا , مازالت فتاة صغيرة
Dialogue: 0,0:07:53.14,0:07:55.76,all,,0,0,0,,! أقضوا علي الملكية
Dialogue: 0,0:07:56.28,0:07:58.18,all,,0,0,0,,هذه مجموعة معارضة للأميرة
Dialogue: 0,0:07:58.48,0:08:01.75,كيث,,0,0,0,,و تجرأو ليصفوا جلالتها بالفتاة
Dialogue: 0,0:08:02.56,0:08:05.48,all,,0,0,0,,لقد سمعت أن هنالك عدة أشخاص من الإرهابيين بين هذه الحشود
Dialogue: 0,0:08:06.12,0:08:08.74,all,,0,0,0,,سأدعك تهتم بحماية الأميرة
Dialogue: 0,0:08:09.05,0:08:09.82,كيث,,0,0,0,,مفهوم
Dialogue: 0,0:08:15.13,0:08:16.03,ميرا,,0,0,0,,!لا تقفوا هكذا
Dialogue: 0,0:08:16.03,0:08:18.13,ميرا,,0,0,0,,! بسرعه أجعلوا أولئك الحمقى يصمتوا
Dialogue: 0,0:08:18.45,0:08:20.26,all,,0,0,0,,...أميرة ميرا , أرجوكِ آهدئي
Dialogue: 0,0:08:20.27,0:08:23.27,ميرا,,0,0,0,,أصمتي ! لقد أسيئ لي ! وتريدينني أن أجلس بهدوء ؟
Dialogue: 0,0:08:24.00,0:08:27.00,ميرا,,0,0,0,,! كيث ! أين كيث ؟ دعيه يأتي إلى هنا حالاً
Dialogue: 0,0:08:28.07,0:08:29.07,كيث,,0,0,0,,... أنا هنا
Dialogue: 0,0:08:30.09,0:08:32.51,كيث,,0,0,0,,مالخطب , أيتها الأميرة ميرا ؟
Dialogue: 0,0:08:33.01,0:08:34.83,ميرا,,0,0,0,,هاه , هل سمعت ؟
Dialogue: 0,0:08:34.83,0:08:35.75,ميرا,,0,0,0,,تلك الضوضاء
Dialogue: 0,0:08:35.92,0:08:37.25,ميرا,,0,0,0,,تلك أصوات مواطنين هذه البلاد
Dialogue: 0,0:08:38.55,0:08:41.22,ميرا,,0,0,0,,هم لا يحتاجوا لقول ذلك , لقد رفضت الأمر مسبقاً
Dialogue: 0,0:08:41.08,0:08:45.53,note,,0,0,0,,{\pos(534,426)}ميرا جولييتا فيسبالاند\Nالمرشحة للملكة
Dialogue: 0,0:08:41.71,0:08:45.24,ميرا,,0,0,0,,لن أكون الملكة أبداً
Dialogue: 0,0:08:45.67,0:08:48.72,كيث,,0,0,0,,أنتِ المرشحه الأولى لتكوني الملكة
Dialogue: 0,0:08:49.09,0:08:51.64,كيث,,0,0,0,,لذا أرجو أن تتفهمي موقفكِ في القصر الآن
Dialogue: 0,0:08:52.13,0:08:53.30,ميرا,,0,0,0,,لايمكنني فهم هذه الأمور
Dialogue: 0,0:08:54.03,0:08:57.15,ميرا,,0,0,0,,... كنت أعتقد  أن أخي هو المرشح الأول
Dialogue: 0,0:08:59.58,0:09:02.93,ميرا,,0,0,0,,...أعتقدت ذلك
Dialogue: 0,0:09:04.14,0:09:08.98,كيث,,0,0,0,,أول مسئولياتك هي السفر لليابان من أجل المعاملات الرسمية بين البلدين
Dialogue: 0,0:09:09.15,0:09:10.02,ميرا,,0,0,0,,اليابان ؟
Dialogue: 0,0:09:11.03,0:09:12.12,ميرا,,0,0,0,,لايمكن
Dialogue: 0,0:09:12.12,0:09:15.89,ميرا,,0,0,0,,. لقد سمعت أن هنالك أشخاص يرغبون في قتلي
Dialogue: 0,0:09:16.79,0:09:17.42,ميرا,,0,0,0,,... أنا
Dialogue: 0,0:09:17.71,0:09:19.15,ميرا,,0,0,0,,. لن أترك هذا المكان أبداً
Dialogue: 0,0:09:20.03,0:09:22.69,كيث,,0,0,0,,. سنقوم بحماية سموكم بحياتنا
Dialogue: 0,0:09:23.75,0:09:24.48,كيث,,0,0,0,,... لذا
Dialogue: 0,0:09:25.06,0:09:27.40,كيث,,0,0,0,,لقد قمنا بأحضار حارس شخصي
Dialogue: 0,0:09:28.44,0:09:29.16,كيث,,0,0,0,,تستطيع الدخول
Dialogue: 0,0:09:34.74,0:09:36.33,all,,0,0,0,,. مرحباً, أيتها الأميرة
Dialogue: 0,0:09:38.87,0:09:41.20,ميرا,,0,0,0,,. انا اكره الرجال أصحاب اللحاء
Dialogue: 0,0:09:45.27,0:09:48.52,note,,0,0,0,,{\pos(638,447)}بعد ثمان ساعات
Dialogue: 0,0:09:55.11,0:09:59.36,note,,0,0,0,,{\pos(626,196)}طائرة فيسبانيا الملكية
Dialogue: 0,0:09:57.03,0:09:59.36,note,,0,0,0,,{\pos(640,458)}الرحيل لليابان
Dialogue: 0,0:10:05.88,0:10:07.26,all,,0,0,0,,.يووه, عملً جيد
Dialogue: 0,0:10:08.27,0:10:11.27,all,,0,0,0,,من فضلك دربني علي إطلاق الرصاص مجدداً
Dialogue: 0,0:10:12.01,0:10:13.21,all,,0,0,0,,علي الرحب
Dialogue: 0,0:10:13.64,0:10:14.55,all,,0,0,0,,المعلم جيغن
Dialogue: 0,0:10:15.08,0:10:16.64,all,,0,0,0,,لاتدعوني بالمعلم
Dialogue: 0,0:10:17.02,0:10:19.47,all,,0,0,0,,ظننتك ذهبت لليابان مع جلالتها
Dialogue: 0,0:10:19.89,0:10:22.01,all,,0,0,0,,من الواضح أنه قد كرهتني الأميرة
Dialogue: 0,0:10:22.81,0:10:28.35,all,,0,0,0,,لقد سمعت بأن تاج الملكة هنا من أجل مراسم التتويج
Dialogue: 0,0:10:28.56,0:10:30.23,all,,0,0,0,,أجل , أتريد أن تلقي نظره ؟
Dialogue: 0,0:10:30.44,0:10:33.23,all,,0,0,0,,آه .. أيمكنني أخذ نظره خاطفه ؟
Dialogue: 0,0:10:44.53,0:10:46.65,all,,0,0,0,,هذا هو تاج الملكة ؟
Dialogue: 0,0:10:47.11,0:10:49.41,all,,0,0,0,,هذا التاج قد تم توارثه من جيل إلى آخر
Dialogue: 0,0:10:49.52,0:10:50.86,all,,0,0,0,,أنه الكنز الأكثر قيمة في البلاد
Dialogue: 0,0:10:51.24,0:10:52.04,all,,0,0,0,,... آوه
Dialogue: 0,0:10:52.24,0:10:53.45,all,,0,0,0,, مثل هذا الشيء الرائع
Dialogue: 0,0:10:53.66,0:10:54.82,all,,0,0,0,,لاتفعلها أيها المعلم
Dialogue: 0,0:10:55.53,0:10:57.12,all,,0,0,0,,لن أقوم بسرقته
Dialogue: 0,0:10:57.16,0:10:58.02,all,,0,0,0,,.. ليس كذلك
Dialogue: 0,0:10:58.43,0:11:00.97,all,,0,0,0,,هنالك أجهزة أستشعار لا يمكن تعطيلها من هذه المحطة
Dialogue: 0,0:11:01.83,0:11:03.23,all,,0,0,0,,... خطوه آخرى
Dialogue: 0,0:11:03.31,0:11:05.03,all,,0,0,0,,وسيتم حبسك بالداخل بشكل آلي
Dialogue: 0,0:11:05.74,0:11:08.98,all,,0,0,0,,ونحن حتى لانعرف كلمة السر للقفل
Dialogue: 0,0:11:09.41,0:11:10.05,all,,0,0,0,,... أوه
Dialogue: 0,0:11:10.80,0:11:12.42,all,,0,0,0,,ذلك سيكون مزعجً
Dialogue: 0,0:11:17.65,0:11:22.95,note,,0,0,0,,{\pos(634,257)}فيسبانيا\Nميدان فيسبالاند
Dialogue: 0,0:11:16.65,0:11:18.78,لوبين,,0,0,0,,في الحقيقه ذلك شديد للغاية
Dialogue: 0,0:11:18.99,0:11:22.63,لوبين,,0,0,0,,الحماية دائماً مشددة جداً هناك
Dialogue: 0,0:11:23.06,0:11:24.08,لوبين,,0,0,0,,... أولاً
Dialogue: 0,0:11:25.00,0:11:26.82,لوبين,,0,0,0,, ...إذا أرتفعت مقدار قدم واحدة عن الأرض
Dialogue: 0,0:11:27.89,0:11:29.11,لوبين,,0,0,0,,سوف يتم كشفي بأجهزه للأستشعار بالوزن
Dialogue: 0,0:11:30.47,0:11:31.80,لوبين,,0,0,0,, ...و حتي إذا تجنبته
Dialogue: 0,0:11:34.03,0:11:36.05,لوبين,,0,0,0,,سأنكشف من أجهزة استشعار بالأشعة
Dialogue: 0,0:11:37.06,0:11:38.56,لوبين,,0,0,0,,أن تمكنا وتجاوزنا كل ذلك
Dialogue: 0,0:11:40.07,0:11:42.26,لوبين,,0,0,0,,لايزال هنالك الاستشعار الحراري
Dialogue: 0,0:11:43.10,0:11:45.30,لوبين,,0,0,0,,كيف يمكننا أن نتفادى ذلك ؟
Dialogue: 0,0:11:45.81,0:11:49.00,all,,0,0,0,,من الممكن أن الحراسة زادت فوق المطلوب بسبب أن أحدهم قد حاول سرقة التاج مرة و فشل
Dialogue: 0,0:11:49.24,0:11:52.24,all,,0,0,0,,وجعلهم يشددون الحراسة عليها
Dialogue: 0,0:11:52.24,0:11:54.21,لوبين,,0,0,0,,ليس بسبب فشلي
Dialogue: 0,0:11:54.79,0:11:56.84,all,,0,0,0,,إذاً , ماذا يجب أن نفعل ؟
Dialogue: 0,0:11:57.01,0:11:59.24,all,,0,0,0,,لنستسلم فقط
Dialogue: 0,0:11:59.28,0:12:01.12,all,,0,0,0,,... أستخدم مرتبي وأذهب في رحلة
Dialogue: 0,0:12:01.52,0:12:04.33,لوبين,,0,0,0,,هل تعتقد بأنني سأستسلم بعد أن وصلنا لهذا الحد ؟
Dialogue: 0,0:12:05.06,0:12:07.06,all,,0,0,0,,لهذا دائماً أقع في جميع أنواع المشاكل
Dialogue: 0,0:12:07.06,0:12:08.67,لوبين,,0,0,0,, ...أنظر لهذا
Dialogue: 0,0:12:09.40,0:12:10.82,all,,0,0,0,,تستعرض مهاراتك في البرمجة ؟
Dialogue: 0,0:12:11.10,0:12:13.82,لوبين,,0,0,0,,لا , هذا حجر صغير
Dialogue: 0,0:12:14.20,0:12:16.07,لوبين,,0,0,0,,أنه جالب الحظ لنا
Dialogue: 0,0:12:16.49,0:12:18.01,لوبين,,0,0,0,,حجر الفيسبارايت
Dialogue: 0,0:12:30.31,0:12:33.23,note,,0,0,0,,{\pos(638,247)}طوكيو\Nفندق ساكوراساكو
Dialogue: 0,0:12:29.15,0:12:32.15,all,,0,0,0,,من مروحية 2 للقاعدة\N نحن نحلق فوق سطح فندق ساكوراساكو
Dialogue: 0,0:12:32.79,0:12:34.87,all,,0,0,0,,هل وصلنا أي خبر بخصوص حماية شخصية مهمة ؟
Dialogue: 0,0:12:35.29,0:12:37.25,all,,0,0,0,,هنا القاعده , لم تصلنا آي آخبار
Dialogue: 0,0:12:38.15,0:12:39.94,note,,0,0,0,,{\pos(802,239)}حفلة الإستقبال
Dialogue: 0,0:12:38.15,0:12:39.94,note,,0,0,0,,{\pos(1154,198)}فندق\Nساكوراساكو
Dialogue: 0,0:12:40.09,0:12:46.00,all,,0,0,0,,يا الهي... هذه فرصة جيدة لنكون مع المشاهير والرياضيين
Dialogue: 0,0:12:46.21,0:12:48.13,all,,0,0,0,,... و ران لا زالت في تدريب الكاراتيه
Dialogue: 0,0:12:48.17,0:12:50.63,كونان,,0,0,0,,مازالتِ دائماً تحبين أن تفعلي ذلك ,  سونوكو
Dialogue: 0,0:12:51.17,0:12:53.42,all,,0,0,0,,أجل , ران لديها ذوق في الأختيار لكني لا أفهم سبب تأخرها
Dialogue: 0,0:12:54.07,0:12:56.38,كونان,,0,0,0,,في الواقع كنت أتحدث عنك
Dialogue: 0,0:12:57.04,0:12:58.88,all,,0,0,0,,لاتهتموا ... لقد قالت أنها ستأتي حتي لو تأخرت
Dialogue: 0,0:12:59.18,0:13:00.14,all,,0,0,0,,... بالحديث عن
Dialogue: 0,0:13:00.15,0:13:01.72,all,,0,0,0,,ماالذي يقصده بالحديث عن ؟
Dialogue: 0,0:13:02.30,0:13:03.22,كونان,,0,0,0,,أليس ذلك واضحاً ؟
Dialogue: 0,0:13:04.12,0:13:05.89,كونان,,0,0,0,,... أنه يبحث عن الآنسة أوكينو يوكو
Dialogue: 0,0:13:06.39,0:13:07.43,all,,0,0,0,,! كالمعتاد
Dialogue: 0,0:13:09.35,0:13:10.52,ميرا,,0,0,0,,!هل جننت ؟
Dialogue: 0,0:13:10.69,0:13:12.66,ميرا,,0,0,0,,! أقامة حفلةً في هذا الوقت
Dialogue: 0,0:13:13.09,0:13:14.22,ميرا,,0,0,0,,... أظن بأنني قلت لا
Dialogue: 0,0:13:14.02,0:13:15.14,كيث,,0,0,0,,... أنا أفهم ذلك جلالتك
Dialogue: 0,0:13:16.06,0:13:16.94,كيث,,0,0,0,,... إذاً
Dialogue: 0,0:13:17.05,0:13:20.06,كيث,,0,0,0,,ستوقفي الحفلة التي قامت بتنظيمها والدتكِ
Dialogue: 0,0:13:20.32,0:13:23.07,كيث,,0,0,0,,... لندع أولئك الضيوف الذين أتوا ليشاركونا حزننا
Dialogue: 0,0:13:23.16,0:13:25.30,كيث,,0,0,0,,... و لا نقول لهم شيئاً و يعودوا
Dialogue: 0,0:13:24.94,0:13:26.16,ميرا,,0,0,0,,! أصمت
Dialogue: 0,0:13:27.26,0:13:28.39,all,,0,0,0,,أيتها الأميرة
Dialogue: 0,0:13:30.86,0:13:32.69,كيث,,0,0,0,,حان الوقت تقريباً
Dialogue: 0,0:13:32.94,0:13:34.28,كيث,,0,0,0,,بسرعه ساعدوا الأميرة
Dialogue: 0,0:13:35.01,0:13:35.49,all,,0,0,0,,حاضر
Dialogue: 0,0:13:37.08,0:13:38.28,all,,0,0,0,,أميرة ميرا
Dialogue: 0,0:13:40.28,0:13:41.29,ميرا,,0,0,0,,كم أكره ذلك
Dialogue: 0,0:13:43.49,0:13:44.87,كونان,,0,0,0,,إذاً , هل وجدت الأنسة يوكو ؟
Dialogue: 0,0:13:45.12,0:13:46.49,all,,0,0,0,,أنها ليست هنا
Dialogue: 0,0:13:51.03,0:13:53.26,all,,0,0,0,,سيداتي و ساداتي , آسفون لجعلكم تنتظرون
Dialogue: 0,0:13:53.55,0:13:57.60,all,,0,0,0,,رجاءً قوموا بالترحيب بضيفتنا الخاصه
Dialogue: 0,0:13:58.10,0:14:01.10,all,,0,0,0,,من بلاد فيسبانيا , أقدم لكم الأميرة ميرا
Dialogue: 0,0:14:01.21,0:14:03.11,all,,0,0,0,,رجاءً رحبوا بضيفتنا المفاجئه
Dialogue: 0,0:14:03.11,0:14:04.27,all,,0,0,0,,هاهي الأميرة ميرا
Dialogue: 0,0:14:04.59,0:14:05.61,all,,0,0,0,,... الأميرة قد خرجت
Dialogue: 0,0:14:05.81,0:14:08.11,all,,0,0,0,,إلي جميع الوحدات , أبقوا أعينكم علي المدعوين
Dialogue: 0,0:14:08.11,0:14:11.27,all,,0,0,0,,أتبعوا أي شخص يحاول الخروج من القاعة من الأن
Dialogue: 0,0:14:12.26,0:14:12.78,all,,0,0,0,,. مفهوم
Dialogue: 0,0:14:13.28,0:14:15.09,all,,0,0,0,,. هنا المدخل الرئيسي
Dialogue: 0,0:14:15.46,0:14:17.13,all,,0,0,0,,لقد منعنا الدخول من الباب الرئيسي للأن
Dialogue: 0,0:14:17.67,0:14:19.76,all,,0,0,0,,سنرسل باقي المدعوين من الباب الجانبي
Dialogue: 0,0:14:20.09,0:14:21.29,all,,0,0,0,,هل تسمعني يا (ب) ؟
Dialogue: 0,0:14:21.29,0:14:22.29,all,,0,0,0,,. مفهوم
Dialogue: 0,0:14:23.03,0:14:24.59,all,,0,0,0,,. تفضلي جلالتك
Dialogue: 0,0:14:32.64,0:14:33.25,كونان,,0,0,0,, ران ؟
Dialogue: 0,0:14:33.80,0:14:35.22,all,,0,0,0,,... أنها تشبه ران
Dialogue: 0,0:14:35.71,0:14:36.52,all,,0,0,0,,هاه ؟
Dialogue: 0,0:14:38.08,0:14:40.07,all,,0,0,0,,ران لا تلبس أبداً هكذا
Dialogue: 0,0:14:43.44,0:14:46.05,ران,,0,0,0,,اللعنة ! هل أصبت بالزكام بعد الأستحمام ؟
Dialogue: 0,0:14:47.90,0:14:49.73,ران,,0,0,0,,آه , لقد تأخر الوقت بالفعل
Dialogue: 0,0:14:50.52,0:14:52.86,ران,,0,0,0,,هل سونكو غاضبة الأن ؟
Dialogue: 0,0:14:54.23,0:14:58.18,all,,0,0,0,,اهـ ... أيتها الأميرة ميرا هل تريدين قول بعض الكلمات ؟
Dialogue: 0,0:15:04.00,0:15:07.57,كيث,,0,0,0,,هذه المره الأولي للأميرة ميرا أن تأتي إلى اليابان و هي مسرورة بالزيارة
Dialogue: 0,0:15:07.95,0:15:10.66,all,,0,0,0,,هيه , الرجل الذي بالخلف يتحدث مكانها
Dialogue: 0,0:15:11.53,0:15:13.37,all,,0,0,0,,الأميرة لا تبدو مبتهجه
Dialogue: 0,0:15:13.74,0:15:15.91,all,,0,0,0,,حتى لو كانت أميرة البلاد
Dialogue: 0,0:15:16.18,0:15:19.15,all,,0,0,0,,هل كانت ستأتي إلى حفل أفتتاح الفندق ؟
Dialogue: 0,0:15:19.29,0:15:22.33,كونان,,0,0,0,,أسم هذا الفندق ساكورا ساكو
Dialogue: 0,0:15:23.09,0:15:24.62,كونان,,0,0,0,,... الملكة المتوفاه ساكورا كانت تحب
Dialogue: 0,0:15:25.06,0:15:28.06,كونان,,0,0,0,,. أزهار الساكورا اليابانية , وأيضاً أسم هذا الفندق
Dialogue: 0,0:15:29.09,0:15:32.09,كونان,,0,0,0,,وعند بوابة الفندق قد أستخدموا الساكورا
Dialogue: 0,0:15:32.30,0:15:34.23,كونان,,0,0,0,,لو لم تحدث تلك الحادثة
Dialogue: 0,0:15:34.50,0:15:36.80,كونان,,0,0,0,,لكانت أفتتحت هذا الفندق بنفسها
Dialogue: 0,0:15:37.14,0:15:40.54,كونان,,0,0,0,,عادة , كان على الأميرة الغاء الزيارة إلى اليابان
Dialogue: 0,0:15:41.14,0:15:42.63,كونان,,0,0,0,,... لكن, أعتقد أن بلاد فيسبانيا
Dialogue: 0,0:15:42.84,0:15:46.01,كونان,,0,0,0,,تريد بناء علاقة مع اليابان لتقوية المصالح
Dialogue: 0,0:15:47.08,0:15:48.64,كونان,,0,0,0,,أشعر بالأسف لأجلها
Dialogue: 0,0:15:50.21,0:15:52.12,all,,0,0,0,,آي مكان ترغب بزيارته في اليابان ؟
Dialogue: 0,0:15:52.12,0:15:53.35,كيث,,0,0,0,,... الأميرة ميرا
Dialogue: 0,0:15:53.35,0:15:55.12,كيث,,0,0,0,,ترغب دائماً بزيارة كيوتو
Dialogue: 0,0:15:55.72,0:15:57.18,all,,0,0,0,,أري ذلك
Dialogue: 0,0:15:57.16,0:15:59.85,all,,0,0,0,,حسناً إذاً , مالأكله اليابانية التي تفضلها ؟
Dialogue: 0,0:16:00.27,0:16:02.57,كيث,,0,0,0,,جلالتها تحب السوشي
Dialogue: 0,0:16:03.18,0:16:05.52,all,,0,0,0,,! مالأمر , ذلك الشاب يجيب عنها دائماً
Dialogue: 0,0:16:05.72,0:16:06.94,all,,0,0,0,,أمسك هذا دقيقة
Dialogue: 0,0:16:07.23,0:16:08.85,all,,0,0,0,,أريد الذهاب لدورة المياة
Dialogue: 0,0:16:09.37,0:16:12.13,كونان,,0,0,0,,! ماهذا ! تجعل طفلاً صغيراً يحمل شرابك
Dialogue: 0,0:16:12.81,0:16:14.02,all,,0,0,0,,... هيا جميعاً
Dialogue: 0,0:16:14.23,0:16:17.35,all,,0,0,0,,لنحظى بهذا النخب مع الأميرة ميرا
Dialogue: 0,0:16:18.04,0:16:20.24,all,,0,0,0,,سيداتي و ساداتي , فليرفع الجميع أكوابه من فضلكم
Dialogue: 0,0:16:20.24,0:16:23.15,all,,0,0,0,,ألا يوجد عصير هنا ؟
Dialogue: 0,0:16:23.15,0:16:25.86,كونان,,0,0,0,,آه دعيني أحضر لنا
Dialogue: 0,0:16:26.12,0:16:28.15,all,,0,0,0,,آه شكراً لك ... لكن لا تتأخر
Dialogue: 0,0:16:28.15,0:16:31.29,كونان,,0,0,0,,آه , حقاً , لقد كانت نواياكِ من البدايه أن أحضر لكِ شرابً
Dialogue: 0,0:16:38.18,0:16:41.98,note,,0,0,0,,{\pos(638,211)}فندق ساكوراساكو
Dialogue: 0,0:16:47.77,0:16:49.11,all,,0,0,0,,... إذاً أيتها الأميرة ميرا
Dialogue: 0,0:16:49.11,0:16:51.24,all,,0,0,0,,هل تريدين قول شيءً من أجل النخب
Dialogue: 0,0:16:51.24,0:16:52.18,all,,0,0,0,,... أيتها الأميرة ميرا
Dialogue: 0,0:16:52.18,0:16:53.93,all,,0,0,0,,هل تريدين قول شيءً من أجل النخب
Dialogue: 0,0:16:55.46,0:16:56.88,كونان,,0,0,0,,! لاتشربي منه
Dialogue: 0,0:16:59.05,0:17:01.18,كونان,,0,0,0,,... أنا آسف أيتها الأميرة
Dialogue: 0,0:17:01.71,0:17:03.12,كونان,,0,0,0,,... لكن قبل ذلك
Dialogue: 0,0:17:03.70,0:17:06.65,كونان,,0,0,0,,هل يمكنكِ أعطائه إلى الساقي لكي يشرب منه أولاً ؟
Dialogue: 0,0:17:09.28,0:17:10.67,all,,0,0,0,,... أرجوكم أي أحد
Dialogue: 0,0:17:10.96,0:17:12.70,all,,0,0,0,, !أرجوكم أمسكوا هذا الرجل
Dialogue: 0,0:17:12.90,0:17:13.62,كيث,,0,0,0,,... أمسكوه
Dialogue: 0,0:17:16.03,0:17:17.55,all,,0,0,0,,إلي المطبخ ... استدعوا الوحدات الخارجية أيضاً
Dialogue: 0,0:17:18.48,0:17:20.20,all,,0,0,0,,أرجو منكم الهدوء جميعاً
Dialogue: 0,0:17:20.20,0:17:22.12,all,,0,0,0,,!لاتتدافعوا هكذا ! ذلك خطر
Dialogue: 0,0:17:26.28,0:17:27.41,all,,0,0,0,,... أبتعد
Dialogue: 0,0:17:27.59,0:17:29.73,كونان,,0,0,0,,... عمي أوقف ذلك الرجل
Dialogue: 0,0:17:38.40,0:17:41.16,all,,0,0,0,,! .. توجه سكيناً ناحية المحقق موري كوجورو
Dialogue: 0,0:17:41.29,0:17:44.68,all,,0,0,0,,!أ ... أنتظر أنا لم انهي جملتي بعد
Dialogue: 0,0:17:41.41,0:17:45.25,all,,0,0,0,,{\pos(646,273)}فندق ساكوراساكو
Dialogue: 0,0:17:42.66,0:17:45.25,all,,0,0,0,,{\pos(634,516)}غرفة المؤتمر
Dialogue: 0,0:17:45.66,0:17:49.51,all,,0,0,0,,وجدنا أثاراً للسم في شراب الأميرة
Dialogue: 0,0:17:50.32,0:17:51.73,all,,0,0,0,,... سيد كيث
Dialogue: 0,0:17:52.43,0:17:54.16,all,,0,0,0,,المفاجأة كانت رائعه
Dialogue: 0,0:17:54.48,0:17:58.18,all,,0,0,0,,لكن أن كنت تخبئ شيءً عنا , فلن تستطيع الشرطة حمايتكم
Dialogue: 0,0:17:59.08,0:18:02.43,كيث,,0,0,0,,أعتقد أن أعضاء الـ (أس بي) الخاصة بنا قاموا بما عليهم وهم كافون
Dialogue: 0,0:18:03.11,0:18:04.17,all,,0,0,0,,!كافون ؟
Dialogue: 0,0:18:04.66,0:18:07.29,all,,0,0,0,,كافون لدرجة أنه ليس معكم حراس لمراقبة المطبخ ؟
Dialogue: 0,0:18:07.38,0:18:08.30,all,,0,0,0,,تاكاجي
Dialogue: 0,0:18:09.49,0:18:10.79,كيث,,0,0,0,,... من البداية
Dialogue: 0,0:18:11.51,0:18:15.06,كيث,,0,0,0,,نحن نصحنا جلالتها أن لا تقترب من أي طعام أو شراب في الحفلة
Dialogue: 0,0:18:15.23,0:18:17.26,كيث,,0,0,0,,لقد ناقشنا ذلك من قبل
Dialogue: 0,0:18:17.64,0:18:18.37,كيث,,0,0,0,,... لكن
Dialogue: 0,0:18:19.75,0:18:22.18,كيث,,0,0,0,,علي شكر هذين السيدين
Dialogue: 0,0:18:28.54,0:18:29.35,all,,0,0,0,,سيدتي ميرا
Dialogue: 0,0:18:31.18,0:18:32.24,ميرا,,0,0,0,,! لا
Dialogue: 0,0:18:32.51,0:18:36.87,all,,0,0,0,,رجاءً .. لاتقلقي هذا الماء نحن من قمنا بتجهيزه
Dialogue: 0,0:18:38.98,0:18:40.49,ميرا,,0,0,0,,! يكفي هذا غادرا الغرفة
Dialogue: 0,0:18:41.01,0:18:42.02,ميرا,,0,0,0,,دعوني لوحدي
Dialogue: 0,0:18:47.69,0:18:49.26,all,,0,0,0,,سنكون أمام الباب
Dialogue: 0,0:18:49.62,0:18:52.05,all,,0,0,0,,رجاءً نادينا عند الحاجة
Dialogue: 0,0:19:04.05,0:19:04.66,ميرا,,0,0,0,,... أمي
Dialogue: 0,0:19:06.08,0:19:06.69,ميرا,,0,0,0,,لا أستطيع
Dialogue: 0,0:19:08.18,0:19:11.18,ميرا,,0,0,0,,... لا أستطيع فعلها
Dialogue: 0,0:19:16.09,0:19:17.50,all,,0,0,0,,سأذهب لإستطلاع السطح
Dialogue: 0,0:19:18.69,0:19:19.73,all,,0,0,0,,لاتدعو آي شخصاً يدخل
Dialogue: 0,0:19:20.88,0:19:21.41,all,,0,0,0,,عُلم
Dialogue: 0,0:19:28.63,0:19:29.56,ميرا,,0,0,0,,... هذا يكفي
Dialogue: 0,0:19:30.86,0:19:31.55,ميرا,,0,0,0,,لن أتحمل المزيد
Dialogue: 0,0:19:37.37,0:19:39.54,all,,0,0,0,,لقد أعترف الشخص الذي حاول تسميم الأميرة
Dialogue: 0,0:19:39.58,0:19:41.71,all,,0,0,0,,لقد دُفع له المال ليفعل ذلك
Dialogue: 0,0:19:42.22,0:19:43.32,all,,0,0,0,,... وكمزحه
Dialogue: 0,0:19:43.53,0:19:45.64,all,,0,0,0,,قيل له أنه تم وضع مسهل فقط
Dialogue: 0,0:19:46.15,0:19:48.22,all,,0,0,0,,أنه يقول الحقيقة الآن
Dialogue: 0,0:19:48.46,0:19:50.01,all,,0,0,0,,من الذي عينه ؟
Dialogue: 0,0:19:50.55,0:19:53.59,all,,0,0,0,,رجل يقول أنه رأه لأول المرة اليوم و كان أجنبياً
Dialogue: 0,0:19:54.13,0:19:55.58,all,,0,0,0,,اللعنة
Dialogue: 0,0:19:55.90,0:19:59.43,all,,0,0,0,,يفعل اي شيءً من أجل المال
Dialogue: 0,0:20:00.20,0:20:02.23,all,,0,0,0,,طبقاً لمعلوماتنا هنا
Dialogue: 0,0:20:02.23,0:20:05.23,all,,0,0,0,,هناك جماعة من الإرهابيين في تلك المجموعة الرافضة للأميرة
Dialogue: 0,0:20:06.17,0:20:09.17,all,,0,0,0,,هل يمكنكم حماية الأميرة لوحدكم ؟
Dialogue: 0,0:20:09.43,0:20:10.45,كيث,,0,0,0,,... في هذه الحالة
Dialogue: 0,0:20:10.56,0:20:14.99,كيث,,0,0,0,,ليس لدينا معروف نريد طلبه من الشرطة اليابانية
Dialogue: 0,0:20:15.15,0:20:17.01,all,,0,0,0,,بالحديث عن هذا , كونان
Dialogue: 0,0:20:17.01,0:20:19.64,all,,0,0,0,,... عندما علمت أن ذلك الشخص محتال
Dialogue: 0,0:20:20.13,0:20:21.35,all,,0,0,0,,كيف عرفت ذلك ؟
Dialogue: 0,0:20:21.75,0:20:25.08,كونان,,0,0,0,,عندما مررت بجانب الساقي
Dialogue: 0,0:20:25.16,0:20:27.19,كونان,,0,0,0,,شممت رائحة الدخان
Dialogue: 0,0:20:27.68,0:20:31.32,كونان,,0,0,0,,ولقد سمعت أن موظفي الفنادق عالية المستوى لايسمح لهم بالتدخين
Dialogue: 0,0:20:31.53,0:20:33.23,كونان,,0,0,0,,لذلك أعتقدت أن ذلك غريب
Dialogue: 0,0:20:33.64,0:20:36.07,كونان,,0,0,0,,أليس هذا فندق خمس نجوم ؟
Dialogue: 0,0:20:36.33,0:20:39.97,all,,0,0,0,,ولكن , من الممكن أن يكون هنا بعض الموظفين الذين يدخنون
Dialogue: 0,0:20:40.38,0:20:45.46,all,,0,0,0,,لذلك على الأقل قبل أن يسكب الشراب للأميرة , عليه أن يتجنب التدخين
Dialogue: 0,0:20:46.04,0:20:50.47,all,,0,0,0,,لكن ليس العديد من الأشخاص يدركون أنهم يدخنون قبل أرتكابهم للجريمة
Dialogue: 0,0:20:51.71,0:20:53.53,all,,0,0,0,,عملاً جيد يا كونان
Dialogue: 0,0:20:58.51,0:20:59.26,all,,0,0,0,,! أيتها الأميرة
Dialogue: 0,0:20:59.52,0:21:00.53,all,,0,0,0,,الأميرة ميرا
Dialogue: 0,0:21:02.61,0:21:03.42,all,,0,0,0,,هل هنالك حريق ؟
Dialogue: 0,0:21:03.62,0:21:05.24,all,,0,0,0,,... لا , لايوجد حريق في اي مكان
Dialogue: 0,0:21:06.10,0:21:08.02,all,,0,0,0,,نحن لانستطيع إيجاد الاميرة ميرا في اي مكان
Dialogue: 0,0:21:08.13,0:21:08.83,all,,0,0,0,,!.. لماذا
Dialogue: 0,0:21:09.41,0:21:11.13,all,,0,0,0,,!أتفقد أحدكم الباب الأخر ؟
Dialogue: 0,0:21:11.14,0:21:12.27,all,,0,0,0,,... آه , لاأحد
Dialogue: 0,0:21:12.76,0:21:13.17,all,,0,0,0,,... أغبياء
Dialogue: 0,0:21:14.73,0:21:15.45,all,,0,0,0,,!.. الأميرة ميرا
Dialogue: 0,0:21:21.21,0:21:22.71,all,,0,0,0,,... نحن آسفون سيدي
Dialogue: 0,0:21:22.80,0:21:23.52,all,,0,0,0,,لنستعمل السلالم
Dialogue: 0,0:21:24.12,0:21:26.25,all,,0,0,0,,و هل تعتقد أن هذا سينجح و نحن في الطابق الأخير ؟
Dialogue: 0,0:21:26.56,0:21:27.80,all,,0,0,0,,!بسرعه أتصل بالإستقبال
Dialogue: 0,0:21:28.02,0:21:28.96,all,,0,0,0,,و أرسل رجالاً لتفقد القبو أيضاً
Dialogue: 0,0:21:28.98,0:21:29.48,all,,0,0,0,,عُلم
Dialogue: 0,0:21:29.82,0:21:31.24,all,,0,0,0,,أنت أبقى هنا وأنتبه للمصعد
Dialogue: 0,0:21:32.06,0:21:33.35,all,,0,0,0,,وأخبرنا أين يتوقف
Dialogue: 0,0:21:33.47,0:21:33.96,all,,0,0,0,,عُلم
Dialogue: 0,0:22:41.39,0:22:43.62,all,,0,0,0,,!.. أنذار الحريق قد أطلق بأستخدام القداحة
Dialogue: 0,0:22:44.06,0:22:47.06,كونان,,0,0,0,,وهربت عن طريق الغرفة الأخرى عندما حلت الفوضى
Dialogue: 0,0:22:48.10,0:22:50.23,all,,0,0,0,,لكن لن يكون بمقدورها ذلك إن لم يكن هذا هو الجناح الملكي
Dialogue: 0,0:22:50.23,0:22:52.24,all,,0,0,0,,هل يجب أن نجعل أفراد الشرطه تمشط المكان ؟
Dialogue: 0,0:22:52.41,0:22:53.54,كيث,,0,0,0,,... لاحاجة لذلك
Dialogue: 0,0:22:54.14,0:22:56.57,all,,0,0,0,,! الوقت متأخر جداً إن حدث لها شئ
Dialogue: 0,0:22:59.41,0:23:00.21,all,,0,0,0,,أكرر ... هنا كايل
Dialogue: 0,0:23:00.45,0:23:02.88,all,,0,0,0,,... لقد وجدت الأميرة ميرا
Dialogue: 0,0:23:03.15,0:23:04.00,all,,0,0,0,,سنعيدها الآن
Dialogue: 0,0:23:07.91,0:23:08.52,all,,0,0,0,,... سيدتي ميرا
Dialogue: 0,0:23:12.12,0:23:14.15,ران,,0,0,0,,هل أنتهت الحفلة الآن ؟
Dialogue: 0,0:23:17.19,0:23:18.72,ران,,0,0,0,,... أنا آسفه
Dialogue: 0,0:23:18.87,0:23:22.00,ميرا,,0,0,0,,! ... هيه , أنظري إلى أين تسـ
Dialogue: 0,0:23:30.01,0:23:31.21,all,,0,0,0,,! حسناً جلالتك , لنعد الآن
Dialogue: 0,0:23:31.21,0:23:34.21,ميرا,,0,0,0,,! لا , أتركني , أتركني
Dialogue: 0,0:23:34.74,0:23:37.29,all,,0,0,0,,... أميرة ميرا , أرجوكِ
Dialogue: 0,0:23:38.05,0:23:40.12,ران,,0,0,0,,... أمم , أترك ذراعها من فضلك
Dialogue: 0,0:23:40.12,0:23:41.42,ران,,0,0,0,,!.. أنها لاتريدك كما رأيت
Dialogue: 0,0:23:44.86,0:23:48.13,all,,0,0,0,,أنا آسف , لكن لاعلاقة لكِ بذلك
Dialogue: 0,0:23:48.26,0:23:49.23,ميرا,,0,0,0,,... ساعديني
Dialogue: 0,0:23:49.40,0:23:52.24,ميرا,,0,0,0,,! هذا الشخص مزعجاً جداً
Dialogue: 0,0:23:52.42,0:23:53.26,ران,,0,0,0,,!أتركها
Dialogue: 0,0:23:53.97,0:23:54.49,all,,0,0,0,,... لا أستطيع
Dialogue: 0,0:23:55.39,0:23:56.81,all,,0,0,0,,... توقفي , هل تريدين أن
Dialogue: 0,0:24:04.70,0:24:05.31,ران,,0,0,0,,! بسرعه
Dialogue: 0,0:24:07.91,0:24:08.75,all,,0,0,0,,! مستحيل
Dialogue: 0,0:24:10.15,0:24:11.67,كيث,,0,0,0,,... ماذا ؟ أيها
Dialogue: 0,0:24:12.25,0:24:13.26,كيث,,0,0,0,,!ماذا فعلت ؟
Dialogue: 0,0:24:13.75,0:24:14.59,all,,0,0,0,,تاكاجي
Dialogue: 0,0:24:15.09,0:24:15.60,all,,0,0,0,,حاضر
Dialogue: 0,0:24:16.05,0:24:17.31,all,,0,0,0,,جهز مقراً للشرطه
Dialogue: 0,0:24:17.92,0:24:19.26,all,,0,0,0,,مفهوم
Dialogue: 0,0:24:19.45,0:24:20.66,all,,0,0,0,,... مقر للشرطه
Dialogue: 0,0:24:21.27,0:24:25.00,all,,0,0,0,,سنعتبر هذا طلباً رسميا من بلاد فيسبانيا
Dialogue: 0,0:24:25.38,0:24:26.39,all,,0,0,0,,أي إعتراض ؟
Dialogue: 0,0:24:30.17,0:24:32.98,كونان,,0,0,0,,المعذرة , أريد أن أخذ شيئاً
Dialogue: 0,0:24:33.44,0:24:35.70,all,,0,0,0,,حسناً , لحظة من فضلك
Dialogue: 0,0:24:38.53,0:24:39.86,all,,0,0,0,,وجدتها
Dialogue: 0,0:24:40.47,0:24:41.69,all,,0,0,0,,هل هذه هي ؟
Dialogue: 0,0:24:43.19,0:24:44.84,كونان,,0,0,0,,أجل , شكراً لكِ
Dialogue: 0,0:24:51.19,0:24:51.89,ران,,0,0,0,,... آه
Dialogue: 0,0:24:52.70,0:24:54.32,ران,,0,0,0,,!أنتي أميرة حقيقية ؟
Dialogue: 0,0:24:56.75,0:24:58.26,ميرا,,0,0,0,,هل أنتي حقاً متفاجئة ؟
Dialogue: 0,0:24:58.57,0:25:00.91,ران,,0,0,0,,!.. بالطبع
Dialogue: 0,0:25:03.95,0:25:06.29,ران,,0,0,0,,... إذاً , الرجل قبل قليل كان
Dialogue: 0,0:25:07.07,0:25:08.61,ميرا,,0,0,0,,حارسي الشخصي
Dialogue: 0,0:25:09.14,0:25:10.40,ران,,0,0,0,,! أعتقدت ذلك
Dialogue: 0,0:25:11.28,0:25:14.01,ران,,0,0,0,,! سوف أذهب وأعتذر , هيا لنذهب ونعد بسرعه
Dialogue: 0,0:25:14.22,0:25:15.11,ميرا,,0,0,0,,... توقفي
Dialogue: 0,0:25:15.34,0:25:17.25,ميرا,,0,0,0,,لقد هربت لأنني لاأريد البقاء هناك
Dialogue: 0,0:25:17.74,0:25:18.87,ميرا,,0,0,0,,لن أعود
Dialogue: 0,0:25:19.07,0:25:19.97,ران,,0,0,0,,لماذا ؟
Dialogue: 0,0:25:20.35,0:25:22.23,ران,,0,0,0,,لماذا تريدين الفرار بعيداً ؟
Dialogue: 0,0:25:25.23,0:25:26.22,ميرا,,0,0,0,,لقد تعبت من الحفلة
Dialogue: 0,0:25:27.95,0:25:29.60,ران,,0,0,0,,...ليتني أقول مثل هذه الأشياء
Dialogue: 0,0:25:29.89,0:25:31.31,ميرا,,0,0,0,,هل معكي سجائر ؟
Dialogue: 0,0:25:31.74,0:25:35.26,ران,,0,0,0,,علبة دخان ؟! أنا مازالت تحت السن القانوني ! كيف يمكن أن أحمله ؟
Dialogue: 0,0:25:35.76,0:25:36.48,ميرا,,0,0,0,,كم عمركِ ؟
Dialogue: 0,0:25:36.77,0:25:37.81,ران,,0,0,0,,سبعة عشر سنة
Dialogue: 0,0:25:38.48,0:25:39.69,ران,,0,0,0,,السنة الثانية في مدرسة تيتان الثانوية
Dialogue: 0,0:25:39.89,0:25:41.95,ران,,0,0,0,,أنا مازلت في المرحلة الثانوية
Dialogue: 0,0:25:42.24,0:25:43.48,ميرا,,0,0,0,,لا تغضبي هكذا
Dialogue: 0,0:25:43.65,0:25:45.16,ران,,0,0,0,,... أليس من الأفضل أن نعود
Dialogue: 0,0:25:45.56,0:25:47.50,ران,,0,0,0,,الحفله مازالت مستمره إلى الآن
Dialogue: 0,0:25:47.96,0:25:49.81,ميرا,,0,0,0,,! لا , لقد قلت لكِ لا
Dialogue: 0,0:25:50.77,0:25:54.29,ميرا,,0,0,0,,نحن متشابهتان , بالحقيقه أنا أكبر منكِ بسنتين
Dialogue: 0,0:25:54.87,0:25:56.29,ران,,0,0,0,,إذاً عمركِ 19 سنة
Dialogue: 0,0:25:57.04,0:25:59.04,ران,,0,0,0,,! ومازالتِ تحت السن القانونية
Dialogue: 0,0:25:59.50,0:26:03.12,ميرا,,0,0,0,,في فيسبانيا , عندما تصلين إلى سن الثامنة عشر \N يكون بأمكانكِ التدخين والشراب
Dialogue: 0,0:26:03.43,0:26:04.44,ران,,0,0,0,,هكذا إذاً ؟
Dialogue: 0,0:26:09.30,0:26:09.82,ميرا,,0,0,0,,مالأمر ؟
Dialogue: 0,0:26:10.84,0:26:12.05,ران,,0,0,0,,.. أنا فقط متفاجأه
Dialogue: 0,0:26:12.97,0:26:15.00,ران,,0,0,0,,!.. أن الأميرة تدخن
Dialogue: 0,0:26:15.38,0:26:17.40,ميرا,,0,0,0,,أنا آسفه لأفساد أحلامك
Dialogue: 0,0:26:18.18,0:26:19.94,ميرا,,0,0,0,,لكن ألا يمكن للأميرة أن تدخن ؟
Dialogue: 0,0:26:20.46,0:26:23.30,ران,,0,0,0,,أنا مازلت أنسانه كما تعرفين , ولست دمية
Dialogue: 0,0:26:23.91,0:26:26.02,ران,,0,0,0,,... أنا آسفة , لم أكن أقصدها بتلك الطريقة
Dialogue: 0,0:26:26.51,0:26:28.94,ميرا,,0,0,0,,لاتهتمي  , أنا معتاده على هذا
Dialogue: 0,0:26:29.57,0:26:30.96,ميرا,,0,0,0,,الجميع يقولون نفس الشئ
Dialogue: 0,0:26:33.01,0:26:36.25,ران,,0,0,0,,... لكن أي فتاة ستحسدك
Dialogue: 0,0:26:37.35,0:26:40.27,ران,,0,0,0,,أن يصبحنا أميرات و لو مرة
Dialogue: 0,0:26:40.59,0:26:43.02,ران,,0,0,0,,... حلم الجميع
Dialogue: 0,0:26:48.48,0:26:49.58,ميرا,,0,0,0,,... أتريدين أن تصبحي
Dialogue: 0,0:26:50.28,0:26:50.91,ميرا,,0,0,0,,أميرة ؟
Dialogue: 0,0:26:52.30,0:26:54.44,ران,,0,0,0,,أنتـ . أنتظري ! ماذا .. ؟
Dialogue: 0,0:26:56.38,0:26:57.07,all,,0,0,0,,المفتش ميغوري
Dialogue: 0,0:26:57.28,0:26:58.61,all,,0,0,0,,لقد تمت التجهيزات
Dialogue: 0,0:26:59.50,0:27:02.45,all,,0,0,0,,إيجاد الأميرة الأن سيكون بضعً من الوقت
Dialogue: 0,0:27:02.86,0:27:05.49,all,,0,0,0,,هيه , تاكاجي , هل رأيت كونان ؟
Dialogue: 0,0:27:06.01,0:27:07.51,all,,0,0,0,,أليس كونان هنا ؟
Dialogue: 0,0:27:08.15,0:27:10.78,all,,0,0,0,,ذلك الشقي , يجري بالأرجاء مجدداً
Dialogue: 0,0:27:13.44,0:27:15.26,ران,,0,0,0,,أنتظري .. لماذا ؟
Dialogue: 0,0:27:15.58,0:27:17.20,ميرا,,0,0,0,,أه ... هيا
Dialogue: 0,0:27:18.90,0:27:20.44,ميرا,,0,0,0,,جسدي أكبر بقليل من جسدك
Dialogue: 0,0:27:21.94,0:27:24.23,ميرا,,0,0,0,,أصمتي , يجب أن تطيعي أوامر الكبار
Dialogue: 0,0:27:24.23,0:27:26.37,ران,,0,0,0,,! لكن .. لا .. لا
Dialogue: 0,0:27:25.24,0:27:29.25,note,,0,0,0,,{\pos(638,188)}حمام سيدات موقف السيارات
Dialogue: 0,0:27:28.16,0:27:29.25,note,,0,0,0,,{\pos(656,449)}بعد عشر دقائق
Dialogue: 0,0:27:33.25,0:27:34.75,ميرا,,0,0,0,,حسناً , يمكنكِ تركه الآن
Dialogue: 0,0:27:37.59,0:27:38.80,ميرا,,0,0,0,,!كيف هو الآن ؟
Dialogue: 0,0:27:40.10,0:27:42.85,ميرا,,0,0,0,,من الآن وصاعداً , أنتِ الأميرة , حسناً ؟
Dialogue: 0,0:27:46.49,0:27:48.02,ران,,0,0,0,,!هذه أنا ؟
Dialogue: 0,0:27:50.22,0:27:50.92,ران,,0,0,0,,... لكن
Dialogue: 0,0:27:53.06,0:27:53.98,ران,,0,0,0,,... أيتها الأميرة
Dialogue: 0,0:27:55.72,0:27:57.83,all,,0,0,0,,سوف أعود عندما تنتهي الحفلة
Dialogue: 0,0:27:58.46,0:28:00.49,ران,,0,0,0,,!لا يمكن ... لا تفعلي هذا
Dialogue: 0,0:28:01.41,0:28:02.71,ميرا,,0,0,0,,... هيا عودي بسرعه
Dialogue: 0,0:28:02.83,0:28:05.35,ميرا,,0,0,0,,ذلك الحارس سيعود قريباً
Dialogue: 0,0:28:07.08,0:28:08.21,ران,,0,0,0,,... لايمكن
Dialogue: 0,0:28:10.84,0:28:12.86,ميرا,,0,0,0,,و لكني لن أعود
Dialogue: 0,0:28:21.28,0:28:22.52,كونان,,0,0,0,,لقد تعبت
Dialogue: 0,0:28:23.10,0:28:24.60,كونان,,0,0,0,,... أعتقدت بأن البحث
Dialogue: 0,0:28:24.81,0:28:26.54,كونان,,0,0,0,,عن شخص يرتدي فستان سهلاً جداً
Dialogue: 0,0:28:28.88,0:28:31.72,كونان,,0,0,0,,!  ران ,  ران
Dialogue: 0,0:28:32.64,0:28:35.77,كونان,,0,0,0,,أنتِ متأخره جداً , سونكو غاضبه منكِ جداً
Dialogue: 0,0:28:36.00,0:28:36.66,ميرا,,0,0,0,,!ران ؟
Dialogue: 0,0:28:37.10,0:28:38.28,ميرا,,0,0,0,,!الفتى
Dialogue: 0,0:28:38.63,0:28:39.61,ميرا,,0,0,0,,!الذي بالحفلة ؟
Dialogue: 0,0:28:48.52,0:28:49.96,كونان,,0,0,0,,... آه ؟ أنتـ . أنتظري
Dialogue: 0,0:28:50.66,0:28:53.29,كونان,,0,0,0,,ياألهي .. لم ألاحظ ذلك
Dialogue: 0,0:29:04.21,0:29:04.80,فوجي,,0,0,0,,... أصعدي
Dialogue: 0,0:29:05.49,0:29:06.27,فوجي,,0,0,0,,... لاتفكري كثيراً
Dialogue: 0,0:29:06.59,0:29:08.53,فوجي,,0,0,0,,أنا أعرف من أنتِ
Dialogue: 0,0:29:08.90,0:29:11.07,فوجي,,0,0,0,,لو كنت عدواً لكنت صدمتكي الأن
Dialogue: 0,0:29:12.58,0:29:13.59,فوجي,,0,0,0,,ثقي بي
Dialogue: 0,0:29:29.00,0:29:32.24,ران,,0,0,0,,ماذا يجب أن أقول ؟\Nلقد أضعنا الكثير من الوقت في الإستراحة
Dialogue: 0,0:29:32.83,0:29:34.35,ران,,0,0,0,,!المكان كان كبيراً جداً فتهت
Dialogue: 0,0:29:35.07,0:29:35.80,ران,,0,0,0,,... لن يفيد هذا
Dialogue: 0,0:29:37.21,0:29:38.80,ران,,0,0,0,,يجب أن أخبرهم بالحقيقة
Dialogue: 0,0:29:45.01,0:29:47.16,ران,,0,0,0,,... أتمنى أن لا أقابل أحد
Dialogue: 0,0:30:08.41,0:30:09.63,ران,,0,0,0,,... أيتها الاميرة
Dialogue: 0,0:30:10.84,0:30:11.65,كونان,,0,0,0,,الأميرة ران
Dialogue: 0,0:30:15.99,0:30:17.73,كونان,,0,0,0,,!أنتِ هنا إذاً ؟
Dialogue: 0,0:30:18.28,0:30:19.14,ران,,0,0,0,,! سينشي
Dialogue: 0,0:30:19.63,0:30:21.25,كونان,,0,0,0,,هيا الجميع ينتظركِ
Dialogue: 0,0:30:21.86,0:30:22.53,كونان,,0,0,0,,هيا لنذهب
Dialogue: 0,0:30:23.48,0:30:25.10,ران,,0,0,0,,ماهذه  الملابس ؟
Dialogue: 0,0:30:26.12,0:30:27.56,كونان,,0,0,0,,هل بها شيءً ما ؟
Dialogue: 0,0:30:27.64,0:30:29.87,كونان,,0,0,0,,... نعم , أنت تبدو كالأمير
Dialogue: 0,0:30:30.97,0:30:32.21,كونان,,0,0,0,,انا أبدو كأمير ؟
Dialogue: 0,0:30:32.79,0:30:36.06,كونان,,0,0,0,,... تبدين وكأنكِ تأملين حدوث شيءً ما
Dialogue: 0,0:30:37.79,0:30:39.41,ران,,0,0,0,,! لا يا سينشي أنزلني
Dialogue: 0,0:30:40.08,0:30:41.84,كونان,,0,0,0,,لا لن أنزلكِ
Dialogue: 0,0:30:53.08,0:30:54.22,ران,,0,0,0,,ما الأمر ؟
Dialogue: 0,0:30:55.14,0:30:56.56,كونان,,0,0,0,, لدي شيءً اخبركم به
Dialogue: 0,0:30:57.89,0:30:58.70,كونان,,0,0,0,,... هذا اليوم
Dialogue: 0,0:30:59.19,0:31:01.26,كونان,,0,0,0,,سأجعل الأميرة ران ملكتي
Dialogue: 0,0:31:03.82,0:31:05.15,ران,,0,0,0,,... سينشي
Dialogue: 0,0:31:07.75,0:31:10.90,كونان,,0,0,0,,لقد .. أتخذت قراري
Dialogue: 0,0:31:12.93,0:31:14.14,ران,,0,0,0,,... لايمكن
Dialogue: 0,0:31:15.56,0:31:17.70,all,,0,0,0,,ما الذي تفعله الأميرة ؟
Dialogue: 0,0:31:18.25,0:31:19.26,all,,0,0,0,,من يعرف
Dialogue: 0,0:31:19.61,0:31:22.04,all,,0,0,0,,يبدو وكأنها معجبة بنفسها
Dialogue: 0,0:31:22.27,0:31:25.91,all,,0,0,0,,الجانب الاخر من الزجاج يبدو كالمرآة
Dialogue: 0,0:31:26.11,0:31:29.03,ران,,0,0,0,,!تتخذ قرار مفاجئ كهذا ؟
Dialogue: 0,0:31:29.15,0:31:33.49,ران,,0,0,0,,لا ليس لأني لست موافقه, لكني أشعر بالخجل فقط
Dialogue: 0,0:31:34.50,0:31:36.41,all,,0,0,0,,من القاعدة للجميع .. من القاعدة للجميع
Dialogue: 0,0:31:37.02,0:31:38.03,all,,0,0,0,,لقد وجدنا الهدف
Dialogue: 0,0:31:38.61,0:31:41.06,all,,0,0,0,,تم إيجاد الهدف في 19:53
Dialogue: 0,0:31:41.84,0:31:43.90,all,,0,0,0,,من الآن كل الفرق فلتوقف البحث
Dialogue: 0,0:31:44.68,0:31:46.90,فوجي,,0,0,0,,حسناً, لنذهب الان
Dialogue: 0,0:31:47.43,0:31:48.23,ميرا,,0,0,0,,بالحقيقة
Dialogue: 0,0:31:48.93,0:31:49.85,ميرا,,0,0,0,,!من أنتِ ؟
Dialogue: 0,0:31:51.68,0:31:54.71,فوجي,,0,0,0,,ألم أخبركِ ؟ أنا أختكِ
Dialogue: 0,0:31:54.91,0:31:55.93,ميرا,,0,0,0,,أتظنين أنني غبيه ؟
Dialogue: 0,0:31:56.33,0:31:58.04,فوجي,,0,0,0,,أنتِ , أميرة حقاً
Dialogue: 0,0:31:58.64,0:32:02.15,فوجي,,0,0,0,,هل تريدين البقاء هنا , أم تريدين العوده إلى الفندق ؟َ
Dialogue: 0,0:32:02.49,0:32:06.05,فوجي,,0,0,0,,ستمرحين أن بقيتِ معي هذه الليله
Dialogue: 0,0:32:09.86,0:32:10.59,ميرا,,0,0,0,,!آداه تعقب ؟
Dialogue: 0,0:32:11.08,0:32:13.71,فوجي,,0,0,0,,أجل , على القلاده التي ترتدينها
Dialogue: 0,0:32:15.04,0:32:16.05,ميرا,,0,0,0,,! ... إذاً
Dialogue: 0,0:32:16.26,0:32:18.28,فوجي,,0,0,0,,سيعرفون مكانك أينما ذهبتي
Dialogue: 0,0:32:18.89,0:32:20.48,ميرا,,0,0,0,,لابد أن هذا من أعداد كيث
Dialogue: 0,0:32:20.71,0:32:22.13,فوجي,,0,0,0,,! لابأس أن كان هو
Dialogue: 0,0:32:23.24,0:32:26.24,فوجي,,0,0,0,,لكن يبدو أن شخصاً آخر
Dialogue: 0,0:32:26.29,0:32:27.47,فوجي,,0,0,0,, يريدكِ
Dialogue: 0,0:32:28.63,0:32:29.64,فوجي,,0,0,0,,تمسكِ جيداً
Dialogue: 0,0:32:34.91,0:32:36.21,فوجي,,0,0,0,,هذا هو العدو
Dialogue: 0,0:32:36.70,0:32:38.14,ميرا,,0,0,0,,لكني تخلصت من القلادة
Dialogue: 0,0:32:39.26,0:32:42.26,فوجي,,0,0,0,,لابد وأنه تمت مشاهدتكِ بالمتنزة أثناء تبديل أماكنكم
Dialogue: 0,0:32:42.35,0:32:45.26,فوجي,,0,0,0,,...تماماً مثلما أفعل ... أنه من الصعب أن
Dialogue: 0,0:32:45.02,0:32:46.24,ميرا,,0,0,0,,! توقفي عن الكلام و هيا بنا
Dialogue: 0,0:32:46.36,0:32:47.05,فوجي,,0,0,0,,! حسناً
Dialogue: 0,0:32:57.98,0:32:59.51,فوجي,,0,0,0,,...أفسحوا طريق الحمام
Dialogue: 0,0:33:07.38,0:33:09.20,ميرا,,0,0,0,,! يبدو أنكِ تستمتعين جداً
Dialogue: 0,0:33:09.46,0:33:11.60,فوجي,,0,0,0,,! آه , تستطيعين قول ذلك
Dialogue: 0,0:33:11.80,0:33:15.53,فوجي,,0,0,0,,لاتقلقي , أنا لست غبية ليمسكو بي كسائقه دراجة
Dialogue: 0,0:33:15.65,0:33:17.38,ميرا,,0,0,0,,ماذا يجب أن نفعل أذا أطلقوا الرصاص ؟
Dialogue: 0,0:33:18.20,0:33:21.84,فوجي,,0,0,0,,هذه اليابان , من المؤكد أنهم يريدونها تبدو كحادثة
Dialogue: 0,0:33:23.54,0:33:26.41,فوجي,,0,0,0,,يااللهي ! يبدو أننا يجب أن نكون جادين أكثر
Dialogue: 0,0:33:30.43,0:33:32.05,فوجي,,0,0,0,,.. إذا كنتم تريدون أن تكونوا الأشرار
Dialogue: 0,0:33:53.13,0:33:55.06,ميرا,,0,0,0,,هل قتلتيهم ؟
Dialogue: 0,0:33:55.35,0:33:58.68,فوجي,,0,0,0,,! لا , قلت لكِ أنا لست بذلك السوء
Dialogue: 0,0:33:59.40,0:34:01.42,فوجي,,0,0,0,,أنا فقط لاأريد أن أضيع وقتِ على هؤلاء المبتدئين
Dialogue: 0,0:34:01.83,0:34:05.21,ميرا,,0,0,0,,! مبتدئين ؟! لكنهم يستخدمون الأسلحة
Dialogue: 0,0:34:05.59,0:34:06.92,فوجي,,0,0,0,,هذا لا ليس له معني
Dialogue: 0,0:34:07.61,0:34:11.00,فوجي,,0,0,0,,... هنالك سيارتان تطاردنا , شخصان في كل سيارة
Dialogue: 0,0:34:11.40,0:34:15.57,فوجي,,0,0,0,,وقد أخفقوا بالهجوم علينا من الأمام عن طريق المقعد الخلفي
Dialogue: 0,0:34:16.40,0:34:23.09,فوجي,,0,0,0,,لكن ... لقد كانوا يستهدفون الآطارات لكن فشلوا\N ... بالقيام بمثل هذه الأعمال ليلاً
Dialogue: 0,0:34:23.29,0:34:25.51,فوجي,,0,0,0,,أنهم فقط مستأجرين
Dialogue: 0,0:34:26.81,0:34:29.53,ميرا,,0,0,0,,! ياه , أنتي رائعة
Dialogue: 0,0:34:39.11,0:34:40.61,فوجي,,0,0,0,,هل هذا صديقك ؟
Dialogue: 0,0:34:42.14,0:34:43.04,ميرا,,0,0,0,,! هذا الفتي
Dialogue: 0,0:34:53.29,0:34:56.29,فوجي,,0,0,0,,! لقد أستطاع أن يقرأ طريقي\Nكيف خُدعت بذلك ؟
Dialogue: 0,0:34:56.94,0:34:58.28,فوجي,,0,0,0,,هيا لنمرح قليلاً
Dialogue: 0,0:35:19.24,0:35:20.45,كونان,,0,0,0,,! يجب أن أفعلها
Dialogue: 0,0:35:35.07,0:35:37.31,فوجي,,0,0,0,,! أبتعد عن طريقي
Dialogue: 0,0:35:46.65,0:35:49.98,فوجي,,0,0,0,,... أنا آسفه , لقد بالغت قليلاً
Dialogue: 0,0:35:51.19,0:35:52.49,فوجي,,0,0,0,,... لكن
Dialogue: 0,0:35:53.30,0:35:55.96,فوجي,,0,0,0,,أنه خطأك لأنك جعلتني جادة في الأمر
Dialogue: 0,0:36:02.09,0:36:03.08,كونان,,0,0,0,,... ماهذا
Dialogue: 0,0:36:03.68,0:36:04.49,كونان,,0,0,0,,... أنها
Dialogue: 0,0:36:05.62,0:36:07.04,كونان,,0,0,0,,لاتبدو كالمجرمين
Dialogue: 0,0:36:09.31,0:36:13.48,note,,0,0,0,,{\pos(642,415)}فندق ساكوراساكو
Dialogue: 0,0:36:15.27,0:36:17.25,all,,0,0,0,,أنتِ حقاً .. ران ؟
Dialogue: 0,0:36:18.98,0:36:21.01,ران,,0,0,0,,حتى أنك لاتستطيع أن تميز أبنتك الوحيدة ؟
Dialogue: 0,0:36:21.84,0:36:24.59,all,,0,0,0,,تبدين أكثر ذكائاً بعض الشيء
Dialogue: 0,0:36:24.85,0:36:25.63,ران,,0,0,0,,! سوف أغضب
Dialogue: 0,0:36:27.77,0:36:28.70,all,,0,0,0,,... إذاً ران
Dialogue: 0,0:36:28.99,0:36:33.32,all,,0,0,0,,الأميرة الحقيقية قالت بأنها ستعود بعد أن تنتهي الحفلة ؟
Dialogue: 0,0:36:33.82,0:36:39.98,ران,,0,0,0,,أجل , لكني لم أعلم أن الحفلة تحولت إلي فوضي ... الحقيقة لم أعلم علي الإطلاق
Dialogue: 0,0:36:41.31,0:36:42.32,ران,,0,0,0,,أنا آسفه
Dialogue: 0,0:36:42.81,0:36:45.85,all,,0,0,0,,الخطأ ليس خطأكِ , آنسة ران
Dialogue: 0,0:36:45.99,0:36:46.92,all,,0,0,0,,... هذا كله
Dialogue: 0,0:36:48.22,0:36:51.24,كيث,,0,0,0,,جيد , حسناً
Dialogue: 0,0:36:51.98,0:36:53.05,all,,0,0,0,, سيد كيث
Dialogue: 0,0:36:53.36,0:36:57.67,all,,0,0,0,,كما سمعت مسبقاً نحن نود أن نكمل البحث عن الأميرة
Dialogue: 0,0:36:57.90,0:36:59.90,كيث,,0,0,0,,!هذا ليس ضرورياً
Dialogue: 0,0:37:00.82,0:37:03.37,all,,0,0,0,,... أنت تتكلم بكلام غير منطقي مجدداً , أسمع
Dialogue: 0,0:37:04.22,0:37:07.59,all,,0,0,0,,!أتمنى أن تخبرنا لماذا هذا ليس ضرورياً ؟
Dialogue: 0,0:37:08.23,0:37:10.86,كيث,,0,0,0,,نبحث ؟
Dialogue: 0,0:37:11.26,0:37:13.08,كيث,,0,0,0,,عن من نبحث بأية حال ؟
Dialogue: 0,0:37:20.17,0:37:21.88,كونان,,0,0,0,,!  سونوكو
Dialogue: 0,0:37:23.06,0:37:25.09,all,,0,0,0,,! هاه يجب أن يكون لديك تفسيراً لهذا
Dialogue: 0,0:37:25.09,0:37:26.94,all,,0,0,0,,!أين كنت ؟ لقد كنا نبحث عنك في كل مكان ؟
Dialogue: 0,0:37:27.05,0:37:28.76,كونان,,0,0,0,,أنا آسف , لقد تهت
Dialogue: 0,0:37:29.16,0:37:31.07,all,,0,0,0,,ماذا تقصد بـ " تهت " ؟
Dialogue: 0,0:37:31.48,0:37:34.43,all,,0,0,0,,أنت بالتأكيد متورط ببعض الأمور الغريبة
Dialogue: 0,0:37:34.66,0:37:36.94,كونان,,0,0,0,,... امم , ران .. لا
Dialogue: 0,0:37:37.23,0:37:38.88,كونان,,0,0,0,,الأميرة هل عادت ؟
Dialogue: 0,0:37:39.37,0:37:40.87,all,,0,0,0,,...في الواقع
Dialogue: 0,0:37:41.48,0:37:43.50,all,,0,0,0,,الأميرة محتمل أنها بالأعلي
Dialogue: 0,0:37:44.03,0:37:46.02,all,,0,0,0,,...  والمفتش ميغوري أيضاً كان معها منذ قليل
Dialogue: 0,0:37:46.34,0:37:46.95,كونان,,0,0,0,,لنذهب
Dialogue: 0,0:37:47.26,0:37:48.19,all,,0,0,0,,!هيه , أنتظر
Dialogue: 0,0:37:49.92,0:37:51.83,all,,0,0,0,,هل تدرك معني كلامك ؟
Dialogue: 0,0:37:52.58,0:37:55.82,all,,0,0,0,,أن كان من قام بخطفها من هذه البلاد
Dialogue: 0,0:37:56.63,0:37:59.87,all,,0,0,0,,ماالذي سيحدث للعلاقة بين اليابان وفيسبانيا ؟
Dialogue: 0,0:38:01.14,0:38:04.09,all,,0,0,0,,أنا حقاً غاضب ! أتريد أستخدام بديل ؟
Dialogue: 0,0:38:04.59,0:38:08.95,all,,0,0,0,,أنا لن أوافق على ذلك , الآنسة ران من المدنيين
Dialogue: 0,0:38:09.88,0:38:13.81,all,,0,0,0,,! لن أسمح لها أن تكون في موقف يعرض حياتها للخطر
Dialogue: 0,0:38:14.50,0:38:16.21,all,,0,0,0,,هيا يا ران غيري ملابسك و لنذهب
Dialogue: 0,0:38:17.16,0:38:18.67,ران,,0,0,0,,... اممم بالحقيقة
Dialogue: 0,0:38:20.08,0:38:23.03,ران,,0,0,0,,أرغب بأخذ مكان الأميرة إلى أن تعود
Dialogue: 0,0:38:23.53,0:38:25.14,all,,0,0,0,,!حمقاء عن ماذا تتحدثين ؟
Dialogue: 0,0:38:25.32,0:38:28.27,all,,0,0,0,,أجل , ماذ أن لم تعد الأميرة ؟
Dialogue: 0,0:38:28.47,0:38:32.61,all,,0,0,0,,هذا صحيح , يا ران , لقد ذكر ذلك قبل قليل \N  ليس من الضروري أنت تتحملي المسئولية
Dialogue: 0,0:38:32.69,0:38:33.70,كيث,,0,0,0,,أحموا جلالتها
Dialogue: 0,0:38:38.50,0:38:45.79,all,,0,0,0,,آه , أنتظر  .. أتركني ! ماذا تفعل ؟
Dialogue: 0,0:38:47.18,0:38:50.62,كيث,,0,0,0,,من الآن وصاعداً , أتبعوا القوانيين الدبلوماسية المناسبة
Dialogue: 0,0:39:02.42,0:39:07.77,all,,0,0,0,,المفتش ميغوري , أرجو أن تعطي الأمر بالبحث عن ران
Dialogue: 0,0:39:11.21,0:39:12.10,all,,0,0,0,,... امم
Dialogue: 0,0:39:12.11,0:39:13.08,all,,0,0,0,,فهمت
Dialogue: 0,0:39:13.08,0:39:14.13,all,,0,0,0,,سنبذل كل جهدنا لأحضارها
Dialogue: 0,0:39:15.14,0:39:17.17,all,,0,0,0,,!أنا لا أفهم عن ماذا تتحدثون ؟
Dialogue: 0,0:39:20.09,0:39:23.16,كيث,,0,0,0,,لقد طلبت تجهيز الغرفة الآخرى لك , أحرس جلالتها حتي ننتهي
Dialogue: 0,0:39:23.41,0:39:23.73,all,,0,0,0,,حسناً
Dialogue: 0,0:39:34.34,0:39:36.25,ران,,0,0,0,,! مستحيل ! أنه هو
Dialogue: 0,0:39:38.48,0:39:39.92,ران,,0,0,0,,... من فضلك
Dialogue: 0,0:39:40.91,0:39:44.87,ران,,0,0,0,,أنا لم أعرف أنك الحارس الشخصي للأميرة
Dialogue: 0,0:39:45.88,0:39:46.37,ران,,0,0,0,,... اممم
Dialogue: 0,0:39:47.59,0:39:48.31,ران,,0,0,0,,أنا آسفة
Dialogue: 0,0:39:50.19,0:39:51.37,all,,0,0,0,,لاحاجة للأعتذار
Dialogue: 0,0:39:51.98,0:39:54.41,all,,0,0,0,,أنا من يجب عليه أن يعتذر
Dialogue: 0,0:39:55.16,0:39:56.43,all,,0,0,0,,حدث هذا الأمر بسبب تهوري
Dialogue: 0,0:39:57.24,0:39:58.60,all,,0,0,0,,أنا الذي عليه الأعتذار
Dialogue: 0,0:39:58.98,0:40:00.28,ران,,0,0,0,,لا , علي الإطلاق
Dialogue: 0,0:40:04.33,0:40:06.15,ران,,0,0,0,,... اممم .. بخصوص
Dialogue: 0,0:40:06.35,0:40:09.30,ران,,0,0,0,,ما حصل بذلك الوقت
Dialogue: 0,0:40:10.11,0:40:11.73,ران,,0,0,0,,زر البنطال قد سقط
Dialogue: 0,0:40:13.64,0:40:16.60,note,,0,0,0,,{\pos(646,393)}منجم الفيسبارايت
Dialogue: 0,0:40:18.93,0:40:21.02,note,,0,0,0,,{\pos(646,406)}(منطقة محظورة(
Dialogue: 0,0:40:24.86,0:40:28.19,لوبين,,0,0,0,,منذ نصف عام ، كانت هنالك حركة لقشرة الأرض
Dialogue: 0,0:40:28.59,0:40:34.13,لوبين,,0,0,0,,تسمى بـ موكولوفيتش والتي تظهر بالعادة \N تحت الأرض بالكثير من الكيلومترات
Dialogue: 0,0:40:34.78,0:40:35.79,all,,0,0,0,,هوموفيتش ؟
Dialogue: 0,0:40:35.88,0:40:36.98,لوبين,,0,0,0,,موكولوفيتش
Dialogue: 0,0:40:37.61,0:40:38.42,لوبين,,0,0,0,,... آه فليكن
Dialogue: 0,0:40:39.01,0:40:41.37,لوبين,,0,0,0,,... المهم الصخور التي وجدت هنا كانت
Dialogue: 0,0:40:42.85,0:40:44.58,لوبين,,0,0,0,,نوعاً مجهولاً من الخام
Dialogue: 0,0:40:49.41,0:40:51.03,لوبين,,0,0,0,,... خام الفيسبارايت
Dialogue: 0,0:40:53.52,0:40:55.05,all,,0,0,0,,هل هذا كل شئ ؟
Dialogue: 0,0:40:55.43,0:40:58.37,لوبين,,0,0,0,,... لا , لقد وجد هكذا
Dialogue: 0,0:40:58.98,0:41:00.80,لوبين,,0,0,0,,بمحض الصدفة
Dialogue: 0,0:41:01.21,0:41:02.22,all,,0,0,0,,... مصادفة
Dialogue: 0,0:41:02.63,0:41:05.03,all,,0,0,0,,ما نوع القوة التي يملكها هذا الحجر إذاً ؟
Dialogue: 0,0:41:05.66,0:41:06.79,لوبين,,0,0,0,,أتريد أن تعرف ؟
Dialogue: 0,0:41:08.58,0:41:10.98,لوبين,,0,0,0,,...من منظور بسيط لعقولنا الضعيفة
Dialogue: 0,0:41:11.50,0:41:13.04,لوبين,,0,0,0,,القوة المطلقة للتسلل
Dialogue: 0,0:41:14.05,0:41:14.86,all,,0,0,0,,التسلل ؟
Dialogue: 0,0:41:15.35,0:41:16.36,لوبين,,0,0,0,,أنت سمعت عنها من قبل ؟
Dialogue: 0,0:41:17.31,0:41:19.98,لوبين,,0,0,0,,الطائرات المقاتلة التي لا تكتشف في الرادار
Dialogue: 0,0:41:20.76,0:41:24.14,لوبين,,0,0,0,,هذا يمكن أن يقوي قوة التسلل إلى الأفضل
Dialogue: 0,0:41:25.04,0:41:28.28,لوبين,,0,0,0,,كما أن تقنيات المعادن الممتصة للموجات في تقدم مستمر بينما نتحدث
Dialogue: 0,0:41:28.88,0:41:33.45,لوبين,,0,0,0,,لكن هذا فقط يحتسب مبدأياً و ليس تخفيً كاملاً
Dialogue: 0,0:41:34.16,0:41:37.29,all,,0,0,0,,إذاً بإستخدام هذا يمكنك أن تختفي تماماً ؟
Dialogue: 0,0:41:37.59,0:41:39.00,لوبين,,0,0,0,,. نعم , بالتأكيد
Dialogue: 0,0:41:39.46,0:41:42.04,لوبين,,0,0,0,,يبدو أنهم أستعملو العديد من أجهزة الفحص
Dialogue: 0,0:41:42.62,0:41:44.47,لوبين,,0,0,0,,لكنهم فشلوا بإيجاده
Dialogue: 0,0:41:45.24,0:41:48.60,لوبين,,0,0,0,,الفيسبارايت لن يظهر علي هذه
Dialogue: 0,0:41:49.07,0:41:50.08,all,,0,0,0,,هكذا إذاً
Dialogue: 0,0:41:50.57,0:41:55.22,all,,0,0,0,,إذاً كيف ستقوم بتحديد مكان الصخور ؟
Dialogue: 0,0:41:59.10,0:42:00.43,لوبين,,0,0,0,,بأستخدام عصا التغطيس
Dialogue: 0,0:42:00.95,0:42:03.38,all,,0,0,0,,!هيه , ألم تقم بتجربة ذلك من قبل ؟
Dialogue: 0,0:42:03.45,0:42:08.41,all,,0,0,0,,{\pos(610,108)}عن عصا التغطيس
Dialogue: 0,0:42:03.45,0:42:08.41,all,,0,0,0,,{\pos(654,688.5)}هي طريقة تستخدم في إكتشاف الماء و المعادن القيمة تحت الأرض عن طريق عصا او بندول
Dialogue: 0,0:42:04.25,0:42:04.88,لوبين,,0,0,0,,{\pos(1102,402)}. لا
Dialogue: 0,0:42:09.02,0:42:12.57,لوبين,,0,0,0,,أثنين فقط أصدقهم ... عصا التغطيس و فوجيكو
Dialogue: 0,0:42:12.98,0:42:13.50,all,,0,0,0,,! غبي
Dialogue: 0,0:42:23.30,0:42:25.47,ميرا,,0,0,0,,! هيا , هيا , هيا
Dialogue: 0,0:42:19.05,0:42:20.47,ميرا,,0,0,0,,أجل
Dialogue: 0,0:42:18.93,0:42:20.47,note,,0,0,0,,{\pos(632,344)}طوكيو\Nكابوكيتشو
Dialogue: 0,0:42:28.48,0:42:31.11,ميرا,,0,0,0,,! اللعنة , لقد حصلت عليها للتو
Dialogue: 0,0:42:36.46,0:42:37.93,ميرا,,0,0,0,,أنتِ تبدين حذرة جداً
Dialogue: 0,0:42:39.21,0:42:40.07,فوجي,,0,0,0,,... بالطبع
Dialogue: 0,0:42:40.91,0:42:43.37,فوجي,,0,0,0,,لقد قمت بإختطاف أميرة
Dialogue: 0,0:42:44.41,0:42:45.57,ميرا,,0,0,0,,! لذيذ
Dialogue: 0,0:42:46.49,0:42:48.66,فوجي,,0,0,0,,هل يمكنكِ أن تتصرفي كرهينة رجاءً
Dialogue: 0,0:42:49.01,0:42:49.99,ميرا,,0,0,0,,حسناً
Dialogue: 0,0:42:50.31,0:42:52.42,فوجي,,0,0,0,,لاتضعي الطبق الذي أنتهيتِ منه هنا
Dialogue: 0,0:42:53.35,0:42:55.00,ميرا,,0,0,0,,... مع أنني لاأعرف ماهو هدفكِ
Dialogue: 0,0:42:55.60,0:42:57.28,ميرا,,0,0,0,,لكنكِ لاتبدين كشخصاً سيئ
Dialogue: 0,0:42:59.01,0:43:01.04,ميرا,,0,0,0,,أن كنتِ لاتمانعين هل تخبريني بها ؟
Dialogue: 0,0:43:02.77,0:43:05.54,ميرا,,0,0,0,,ماهي نواياكِ الحقيقية ؟
Dialogue: 0,0:43:07.55,0:43:08.75,ميرا,,0,0,0,,لقد عرفت ذلك , ترفضين الرد
Dialogue: 0,0:43:09.14,0:43:11.85,ميرا,,0,0,0,,... لكنني قررت أن أثق
Dialogue: 0,0:43:12.55,0:43:13.44,ميرا,,0,0,0,,... بكي
Dialogue: 0,0:43:14.60,0:43:16.02,ميرا,,0,0,0,,و بحدسي أيضاً
Dialogue: 0,0:43:19.60,0:43:20.90,فوجي,,0,0,0,,هنالك حبة من الرز على خدكِ
Dialogue: 0,0:43:21.49,0:43:24.98,note,,0,0,0,,{\pos(350,158)}SUSHI\NTRAIN
Dialogue: 0,0:43:21.49,0:43:24.98,note,,0,0,0,,{\pos(970,142)}من 120\N ين للطبق
Dialogue: 0,0:43:22.78,0:43:24.98,فوجي,,0,0,0,,لقد أخبرتك من قبل أن لاتضعي الطبق الفارغ هناك
Dialogue: 0,0:43:26.43,0:43:27.56,all,,0,0,0,, ماذا تعني ؟
Dialogue: 0,0:43:28.13,0:43:29.87,all,,0,0,0,,!أنا لست راضياً عن ذلك
Dialogue: 0,0:43:31.26,0:43:34.44,all,,0,0,0,,نعم , نعم , حسناً
Dialogue: 0,0:43:35.39,0:43:38.72,all,,0,0,0,,سوف أذهب إلى المقر الرئيسي , أبقى أنت هنا
Dialogue: 0,0:43:39.06,0:43:40.51,all,,0,0,0,,هل يضغطون عليهم ؟
Dialogue: 0,0:43:41.06,0:43:45.02,all,,0,0,0,,أعتقد ذلك , لاتقم بعمل شيءً حتى أعود
Dialogue: 0,0:43:45.60,0:43:46.41,all,,0,0,0,,فهمت ذلك
Dialogue: 0,0:43:48.46,0:43:51.67,all,,0,0,0,, أنتظر ! من الأفضل لكم أن تمسكوا بهذه الأميرة الأنانية و إلا ران سوف
Dialogue: 0,0:43:51.82,0:43:53.38,all,,0,0,0,,! أعلم ذلك
Dialogue: 0,0:43:53.70,0:43:56.59,all,,0,0,0,, إذاً لماذا لم يوافقوا على أمر البحث ؟
Dialogue: 0,0:43:56.82,0:43:59.42,all,,0,0,0,,!مستحيل .. كيف علمتي بهذا ؟
Dialogue: 0,0:43:59.57,0:44:02.78,all,,0,0,0,,أستطيع أن أراه من خلال نظراتك
Dialogue: 0,0:44:03.93,0:44:07.00,كونان,,0,0,0,,! لماذا ؟ هل هنالك حاجةً لعرقلة الأمر من الداخل
Dialogue: 0,0:44:08.30,0:44:11.83,كونان,,0,0,0,,!هل سيستفيدون من جعل ران بديلة لها ؟
Dialogue: 0,0:44:13.24,0:44:14.11,all,,0,0,0,, تاكاجي
Dialogue: 0,0:44:15.27,0:44:16.86,all,,0,0,0,,...إذا أحتجتك
Dialogue: 0,0:44:17.35,0:44:18.82,all,,0,0,0,,هل سوف تساعدني ؟
Dialogue: 0,0:44:19.63,0:44:20.47,all,,0,0,0,,بالطبع
Dialogue: 0,0:44:21.02,0:44:22.70,all,,0,0,0,,أتراهن حياتك على هذا ؟
Dialogue: 0,0:44:23.23,0:44:24.20,all,,0,0,0,,بالطبع سوف افعل
