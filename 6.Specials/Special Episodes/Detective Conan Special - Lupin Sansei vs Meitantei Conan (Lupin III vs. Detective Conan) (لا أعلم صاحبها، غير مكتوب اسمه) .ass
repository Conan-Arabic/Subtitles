Dialogue: 0,0:53:33.01,0:53:34.02,all,,0,0,0,,ماذا تقول ؟
Dialogue: 0,0:53:34.26,0:53:37.73,all,,0,0,0,,!كمحقق مشهور ولم تكن تعلم بوجود لوبين ؟
Dialogue: 0,0:53:34.69,0:53:38.15,note,,0,0,0,,{\pos(648,349)}الوقت للوصول إلي فيسبانيا\Nثماني ساعات و نصف
Dialogue: 0,0:53:40.47,0:53:41.37,كونان,,0,0,0,,{\fad(500,500)}ران
Dialogue: 0,0:53:42.58,0:53:43.42,كونان,,0,0,0,,{\fad(500,500)}ران
Dialogue: 0,0:53:44.81,0:53:45.88,ران,,0,0,0,,سينشي
Dialogue: 0,0:53:49.84,0:53:50.68,كيث,,0,0,0,,لقد أستيقظتي ؟
Dialogue: 0,0:53:51.35,0:53:51.95,ران,,0,0,0,,...أين
Dialogue: 0,0:53:53.20,0:53:55.13,ران,,0,0,0,,هل أوضحت لي مايجري ؟
Dialogue: 0,0:53:55.97,0:53:58.92,كيث,,0,0,0,,!من أنتِ من الأشخاص بالحقيقة ؟
Dialogue: 0,0:53:59.96,0:54:02.33,ران,,0,0,0,,أنا التي أسأل هنا
Dialogue: 0,0:54:03.11,0:54:06.85,كيث,,0,0,0,,هل الفتاة التي اشتركت معنا ستبدأ بالصراخ الآن ؟
Dialogue: 0,0:54:07.48,0:54:09.25,ران,,0,0,0,,هل تريدني أن أنفذ رغبتك ؟
Dialogue: 0,0:54:10.26,0:54:12.02,ران,,0,0,0,,أخشى أن أزعجكم به
Dialogue: 0,0:54:13.44,0:54:14.94,كيث,,0,0,0,,عندما كنتِ نائمة
Dialogue: 0,0:54:15.35,0:54:16.82,كيث,,0,0,0,,كان لدينا اضطراب في الداخل
Dialogue: 0,0:54:17.63,0:54:18.41,كيث,,0,0,0,,... في الحفلة
Dialogue: 0,0:54:18.90,0:54:21.19,كيث,,0,0,0,,الفتى الصغير الذي عرف الساقي المزيف
Dialogue: 0,0:54:22.34,0:54:26.74,كيث,,0,0,0,,قفز علي الطائرة بينما كانت تستعد للأقلاع
Dialogue: 0,0:54:27.81,0:54:28.56,ران,,0,0,0,,كونان
Dialogue: 0,0:54:29.72,0:54:33.51,كيث,,0,0,0,,و بالتالي لن نستطيع الإرتفاع إذا كانت مقصورةّ الطائرة مفتوحة
Dialogue: 0,0:54:34.06,0:54:37.50,كيث,,0,0,0,,لهذا قللنا الإرتفاع حتي نفحص المقصورة
Dialogue: 0,0:54:40.36,0:54:43.05,كيث,,0,0,0,,... ووجدنا هناك
Dialogue: 0,0:54:43.71,0:54:44.81,كيث,,0,0,0,,! ذلك الفتى الصغير
Dialogue: 0,0:54:45.68,0:54:50.05,كيث,,0,0,0,,الطيار صدم ... بهدوئه وذكائه
Dialogue: 0,0:54:51.23,0:54:55.86,كيث,,0,0,0,,لو كان متهوراً , لأصبحنا في خطر محدق فوق سطح البحر بحوالي 10 الاف متر
Dialogue: 0,0:54:57.13,0:55:00.28,كيث,,0,0,0,,لكنه وجد موقع أجهزة الإستشعار وأعلم قمرة القيادة بذلك
Dialogue: 0,0:55:01.93,0:55:06.18,كيث,,0,0,0,, وفي ذلك الجزء من الطائرة يوجد القليل من الهواء البارد
Dialogue: 0,0:55:07.83,0:55:08.76,ران,,0,0,0,,هل هو بخير ؟
Dialogue: 0,0:55:09.28,0:55:10.35,كيث,,0,0,0,,. لا تقلقي
Dialogue: 0,0:55:10.87,0:55:12.66,كيث,,0,0,0,,. مجرد بردً خفيف
Dialogue: 0,0:55:13.58,0:55:17.23,كيث,,0,0,0,,من الآن وصاعداً , لن أكذب عليكِ مطلقاً
Dialogue: 0,0:55:18.30,0:55:19.28,كيث,,0,0,0,,أريدكِ أن تستمعي
Dialogue: 0,0:55:21.13,0:55:23.96,note,,0,0,0,,{\pos(646,351)}الوقت للوصول لفيسبانيا
Dialogue: 0,0:55:22.42,0:55:23.96,note,,0,0,0,,{\pos(638,416)}ثلاثة ّساعات
Dialogue: 0,0:55:31.11,0:55:33.77,فوجي,,0,0,0,,لوبين , سأستعير الدش قليلاً
Dialogue: 0,0:55:34.20,0:55:35.01,لوبين,,0,0,0,,. حسناً
Dialogue: 0,0:55:38.34,0:55:39.38,لوبين,,0,0,0,,فوجيكو
Dialogue: 0,0:55:49.35,0:55:52.85,فوجي,,0,0,0,,ألم أقل لك بأني سأستعيره ؟ ياغبي
Dialogue: 0,0:55:54.01,0:55:58.87,لوبين,,0,0,0,,يالسوء الحظ , لكن أعتقد أني رأيت شيءً جميلاً
Dialogue: 0,0:55:59.62,0:56:00.81,لوبين,,0,0,0,,! المرحاض
Dialogue: 0,0:56:02.40,0:56:05.23,لوبين,,0,0,0,,لا عجب أن هناك العديد من الأمتعة
Dialogue: 0,0:56:05.32,0:56:06.62,فوجي,,0,0,0,,أنت لم تقم بفتحها ؟
Dialogue: 0,0:56:06.97,0:56:08.68,لوبين,,0,0,0,,أعتقدت أنها لجيغن
Dialogue: 0,0:56:09.01,0:56:11.22,فوجي,,0,0,0,,الآن خدمات التوصيل أصبحت جيدة جداً
Dialogue: 0,0:56:11.47,0:56:12.76,لوبين,,0,0,0,,جيدة أكثر من اللازم
Dialogue: 0,0:56:13.64,0:56:15.56,لوبين,,0,0,0,,كيف علمتِ بهذا المخبئ ؟
Dialogue: 0,0:56:16.02,0:56:20.85,فوجي,,0,0,0,,لايوجد شيءً لاأعلمه عنك يا لوبين , صحيح ؟
Dialogue: 0,0:56:21.64,0:56:24.02,فوجي,,0,0,0,,!لماذا تركتني ؟
Dialogue: 0,0:56:24.10,0:56:27.44,لوبين,,0,0,0,,... لا , بالحقيقة لقد كنت سأخبركِ
Dialogue: 0,0:56:27.85,0:56:29.98,فوجي,,0,0,0,,كنت ستفعل ذلك ؟
Dialogue: 0,0:56:30.11,0:56:32.86,فوجي,,0,0,0,,جيد , لهذا قد جلبت الأميرة إلى هنا
Dialogue: 0,0:56:33.15,0:56:35.23,فوجي,,0,0,0,,يتوجب علي إعادتها للقصر غداً
Dialogue: 0,0:56:35.40,0:56:37.73,فوجي,,0,0,0,,هذه فرصة جيدة لدخول القصر
Dialogue: 0,0:56:38.15,0:56:39.65,فوجي,,0,0,0,,إذاً تصبح على خير
Dialogue: 0,0:56:40.28,0:56:42.65,فوجي,,0,0,0,,لم أنم كفاية منذ الأمس
Dialogue: 0,0:56:43.65,0:56:45.32,لوبين,,0,0,0,,تنامي ؟
Dialogue: 0,0:56:47.03,0:56:49.57,لوبين,,0,0,0,,إلي الثمانيين مليون مشاهد من الكبار
Dialogue: 0,0:56:49.70,0:56:52.08,لوبين,,0,0,0,,لقد حانت اللحظة الي انتظرتموها بفارغ الصبر
Dialogue: 0,0:56:52.24,0:56:54.08,لوبين,,0,0,0,,... هيا
Dialogue: 0,0:56:57.97,0:56:59.68,note,,0,0,0,,{\pos(616,592)}...و كالمعتاد
Dialogue: 0,0:57:00.75,0:57:01.75,فوجي,,0,0,0,,إذاً , أراك غداً
Dialogue: 0,0:57:05.58,0:57:06.87,فوجي,,0,0,0,,لقد نسيت هذه
Dialogue: 0,0:57:10.28,0:57:11.44,لوبين,,0,0,0,,تباً
Dialogue: 0,0:57:12.24,0:57:16.91,note,,0,0,0,,{\pos(640,420)}في اليوم التالي
Dialogue: 0,0:57:15.25,0:57:16.88,all,,0,0,0,,كيف هو حال الأميرة ؟
Dialogue: 0,0:57:17.34,0:57:18.71,كيث,,0,0,0,,أنها هادئة الآن
Dialogue: 0,0:57:18.92,0:57:19.96,كيث,,0,0,0,,لقد أنهت أفطارها حتى
Dialogue: 0,0:57:20.76,0:57:22.84,كيث,,0,0,0,,آسف , لجعلك تقلق
Dialogue: 0,0:57:23.51,0:57:25.01,all,,0,0,0,,لاحاجة للأعتذار
Dialogue: 0,0:57:26.18,0:57:29.18,all,,0,0,0,,المجموعة المعارضة للأميرة قد أرسلوا لليابان أيضاً
Dialogue: 0,0:57:30.34,0:57:31.89,all,,0,0,0,,ذلك لم يكن متوقعاً أبداً
Dialogue: 0,0:57:32.80,0:57:37.01,all,,0,0,0,,أنا أقترح أن نقوم بتقديم الأحتفال بمراسم تتويج الأميرة
Dialogue: 0,0:57:38.01,0:57:40.56,كيث,,0,0,0,,!تقديم مراسم التتويج ؟
Dialogue: 0,0:57:50.35,0:57:51.31,كيث,,0,0,0,,شكراً لإنتظارك
Dialogue: 0,0:57:51.73,0:57:52.40,ران,,0,0,0,,أين الأميرة ؟
Dialogue: 0,0:57:52.73,0:57:54.73,كيث,,0,0,0,,لم تصل حتى الآن
Dialogue: 0,0:57:55.27,0:57:56.07,all,,0,0,0,,... هيه
Dialogue: 0,0:57:56.94,0:57:59.36,all,,0,0,0,,لقد سمعت القصة كاملةً منها
Dialogue: 0,0:57:59.86,0:58:02.36,all,,0,0,0,,اليس هذا كثير أن تحضرونني مع هذا الفتى ؟
Dialogue: 0,0:58:02.90,0:58:05.78,كيث,,0,0,0,,لكنكما تبدوان كالأب والأبن اليابانيين
Dialogue: 0,0:58:05.95,0:58:06.99,all,,0,0,0,,توقف
Dialogue: 0,0:58:07.99,0:58:11.32,ران,,0,0,0,,هل يجب عليك أن تقحم كونان في هذا الأمر ؟
Dialogue: 0,0:58:12.12,0:58:16.91,كيث,,0,0,0,,أنا محرج لقول هذا , لكن يمكنني أن أثق فقط بهولاء الذين في الغرفة الأن
Dialogue: 0,0:58:17.28,0:58:21.29,all,,0,0,0,,لقد كانت فكرة الكونت كيث بإرسال جلالتها إلي اليابان في وقت مثل هذا
Dialogue: 0,0:58:21.66,0:58:25.41,all,,0,0,0,,SP ونتيجةً لذلك أشتبهنا بأشخاص من الـ
Dialogue: 0,0:58:25.87,0:58:27.62,all,,0,0,0,,يالهُ من كلامً مثير للشفقة
Dialogue: 0,0:58:28.62,0:58:32.63,all,,0,0,0,,الشخص الوحيد الذي شعر بالسعاده لخسارة الأميرة \N هو الوريث القادم للحكم
Dialogue: 0,0:58:33.25,0:58:36.42,all,,0,0,0,,حتى هذا الطفل يعلم من وراء كل هذا
Dialogue: 0,0:58:37.21,0:58:37.79,كيث,,0,0,0,,... أجل
Dialogue: 0,0:58:38.50,0:58:43.01,كيث,,0,0,0,,أنا متأكد أن الدوق جيرارد هو من قتل الأثنين لتبدو و كأنها حادثة
Dialogue: 0,0:58:44.01,0:58:47.38,all,,0,0,0,,!هيه, هل يجب أن تقولها بصوتً عالي ؟
Dialogue: 0,0:58:48.09,0:58:50.97,ران,,0,0,0,,هل .. وجدت دليلاً ؟
Dialogue: 0,0:58:51.51,0:58:52.68,كيث,,0,0,0,,لا لاشيء بعد
Dialogue: 0,0:58:53.89,0:58:57.05,كيث,,0,0,0,,نحن خدم العائلة الملكية منذ أجيال
Dialogue: 0,0:58:57.68,0:58:59.06,كيث,,0,0,0,,ومن ضمنهم السيد جيرارد
Dialogue: 0,0:58:59.68,0:59:02.97,all,,0,0,0,,ولأنك لاتستطيع فعل شيءً بنفسك , فأنت تطلب منا ذلك ؟
Dialogue: 0,0:59:04.18,0:59:07.14,all,,0,0,0,,هذه البلاد فاسدة , هاه ؟
Dialogue: 0,0:59:08.31,0:59:10.89,كيث,,0,0,0,,الملكة فقط التي تطلق الأحكام على أعضاء العائلة الملكية
Dialogue: 0,0:59:11.48,0:59:14.40,كيث,,0,0,0,,الأميرة ميرا لم تحصل على حقها بعد
Dialogue: 0,0:59:15.86,0:59:17.86,all,,0,0,0,,أنتم مازلتم تعيشون في القرن التاسع عشر ؟
Dialogue: 0,0:59:18.40,0:59:19.27,كيث,,0,0,0,,أرجوك
Dialogue: 0,0:59:19.82,0:59:21.07,كيث,,0,0,0,,لم يتبقى هنالك أي وقت
Dialogue: 0,0:59:21.86,0:59:25.53,كيث,,0,0,0,,الأحتفال بالتتويج سيكون بعد الغد
Dialogue: 0,0:59:25.94,0:59:30.15,ران,,0,0,0,,لايمكن, أن لم تظهر الأميرة قبل ذلك
Dialogue: 0,0:59:31.07,0:59:32.78,كونان,,0,0,0,,فعلى ران حضوره
Dialogue: 0,0:59:36.57,0:59:37.70,ران,,0,0,0,,كونان
Dialogue: 0,0:59:39.12,0:59:41.24,all,,0,0,0,,أميرة ران , رجاءً أغلقي الستار
Dialogue: 0,0:59:42.04,0:59:44.29,all,,0,0,0,,نحن لا نعلم من أين قد يهاجم قناص
Dialogue: 0,0:59:44.91,0:59:46.83,ران,,0,0,0,,! لايجب عليكِ أن تناديني بـ أميرة
Dialogue: 0,0:59:47.25,0:59:48.91,ران,,0,0,0,,فأنا مجرد شبيه
Dialogue: 0,0:59:50.37,0:59:52.33,ران,,0,0,0,,أنتما الاثنتان كنتما تخدمان الأميرة ميرا لفترة ؟
Dialogue: 0,0:59:52.71,0:59:55.58,all,,0,0,0,,نعم, أنا أخدم جلالتها منذ خمس سنوات
Dialogue: 0,0:59:56.29,0:59:58.71,all,,0,0,0,,وأنا دخلت القصر الملكي قبل ثلاث سنوات فقط
Dialogue: 0,0:59:59.34,1:00:03.10,ران,,0,0,0,,أنا لم أرى الحياة اليومية للأميرة من قبل
Dialogue: 0,1:00:03.80,1:00:06.01,ران,,0,0,0,,هل كانت هكذا منذ أن كانت طفلة ؟
Dialogue: 0,1:00:08.51,1:00:10.67,all,,0,0,0,,لا , لقد كانت لطيفة جداً
Dialogue: 0,1:00:10.92,1:00:11.93,all,,0,0,0,,وتبكي بسهولة
Dialogue: 0,1:00:13.93,1:00:15.84,all,,0,0,0,,... الأميرة ميرا, لم يسبق لها
Dialogue: 0,1:00:17.80,1:00:20.43,ران,,0,0,0,,!لم .. لم يسبق لها ماذا ؟
Dialogue: 0,1:00:22.22,1:00:25.01,all,,0,0,0,,لم يسبق لها .. أن بكت أمام أحد
Dialogue: 0,1:00:25.89,1:00:29.02,all,,0,0,0,,حتى خسرت الشخصان اللذان أحَبتهما في وقتً واحد
Dialogue: 0,1:00:30.19,1:00:34.48,all,,0,0,0,,لقد كان الحزن فوق إحتمالها
Dialogue: 0,1:00:35.73,1:00:38.06,all,,0,0,0,,من الصعب رؤيتها في هذه الحالة
Dialogue: 0,1:00:40.11,1:00:42.19,ران,,0,0,0,,وليس معترف بها من الشعب
Dialogue: 0,1:00:42.65,1:00:43.57,ران,,0,0,0,,... لهذا
Dialogue: 0,1:00:44.02,1:00:46.57,ران,,0,0,0,,لهذا السبب صنعت لها شخصية مغايره
Dialogue: 0,1:00:50.24,1:00:53.57,كيث,,0,0,0,,أنت أيضاً تشعر بالذهول لأنني أعتمدت علي هذين الأثنين ؟
Dialogue: 0,1:00:54.03,1:00:54.53,all,,0,0,0,,. أجل
Dialogue: 0,1:00:55.36,1:00:57.07,all,,0,0,0,,أنا أتفهم المعلم جيغن
Dialogue: 0,1:00:57.28,1:00:58.78,all,,0,0,0,, لكن الفتى الصغير ماذا تتوقع منه ؟
Dialogue: 0,1:00:59.95,1:01:01.66,كيث,,0,0,0,,! لا أعرف لماذا
Dialogue: 0,1:01:02.53,1:01:03.58,كيث,,0,0,0,,... ذلك الفتى
Dialogue: 0,1:01:04.83,1:01:08.66,كيث,,0,0,0,,ذلك الفتى .. لايبدو كما يظهر
Dialogue: 0,1:01:10.62,1:01:14.33,كيث,,0,0,0,,لديه جسد طفل وعقل رجلاً بالغ
Dialogue: 0,1:01:18.83,1:01:21.00,لوبين,,0,0,0,,فوجيكو , أنه الصباح
Dialogue: 0,1:01:21.25,1:01:22.25,فوجي,,0,0,0,,! اصمت
Dialogue: 0,1:01:27.46,1:01:30.17,فوجي,,0,0,0,,! لقد أصابك البرد , لاتقترب مني
Dialogue: 0,1:01:30.30,1:01:34.30,لوبين,,0,0,0,,حقاً , من له الذنب في نومي في موقف السيارات ؟
Dialogue: 0,1:01:34.67,1:01:37.30,فوجي,,0,0,0,,آه لا .. أنه يضع اللوم عليكِ
Dialogue: 0,1:01:37.38,1:01:38.38,ميرا,,0,0,0,,أنه الأسوء
Dialogue: 0,1:01:38.64,1:01:40.26,لوبين,,0,0,0,,ليس هكذا
Dialogue: 0,1:01:40.59,1:01:44.47,فوجي,,0,0,0,,!أياً يكن , هل يمكن لهذه السيارة الإسراع ؟
Dialogue: 0,1:01:44.55,1:01:45.89,لوبين,,0,0,0,,هذه أسرع واحدة
Dialogue: 0,1:01:46.22,1:01:47.89,فوجي,,0,0,0,,أين سيارتك المعتادة ؟
Dialogue: 0,1:01:48.06,1:01:50.47,لوبين,,0,0,0,,لن تكونان هنا مجدداً
Dialogue: 0,1:01:56.23,1:01:59.31,ميرا,,0,0,0,,أشعر بالعطش , أشتر لي بعض الكولا
Dialogue: 0,1:01:59.48,1:02:00.44,لوبين,,0,0,0,,حسناً
Dialogue: 0,1:02:00.69,1:02:02.19,فوجي,,0,0,0,,وأنا أريد قهوة مثلجة
Dialogue: 0,1:02:02.36,1:02:03.36,لوبين,,0,0,0,,حسناً , حسناً
Dialogue: 0,1:02:03.48,1:02:04.40,فوجي,,0,0,0,,إجابة واحده تكفي
Dialogue: 0,1:02:05.02,1:02:06.32,لوبين,,0,0,0,,اللعنة
Dialogue: 0,1:02:09.44,1:02:12.99,كونان,,0,0,0,,الأطول بناية في طريق الاحتفال هي هذه
Dialogue: 0,1:02:13.82,1:02:14.69,كونان,,0,0,0,,هيه , أبي
Dialogue: 0,1:02:15.15,1:02:16.82,كونان,,0,0,0,,أبي إن كنت أنت القناص من أين ستطلق ؟
Dialogue: 0,1:02:17.11,1:02:18.78,كونان,,0,0,0,,مؤكد من على البناية الأطول
Dialogue: 0,1:02:19.36,1:02:20.99,all,,0,0,0,,لاتبالغ
Dialogue: 0,1:02:21.45,1:02:22.07,all,,0,0,0,,انزل
Dialogue: 0,1:02:24.53,1:02:25.78,all,,0,0,0,,توقف عن إدعاء البلاهة
Dialogue: 0,1:02:26.16,1:02:26.78,كونان,,0,0,0,,بخيل
Dialogue: 0,1:02:27.37,1:02:28.99,كونان,,0,0,0,,هيه , أجبني ؟
Dialogue: 0,1:02:29.16,1:02:31.45,كونان,,0,0,0,,سيكون من السهل الهرب من تلك البناية
Dialogue: 0,1:02:33.58,1:02:34.50,كونان,,0,0,0,,أنتظر
Dialogue: 0,1:02:35.12,1:02:36.62,all,,0,0,0,,! أنا لست قاتلاً محترفاً
Dialogue: 0,1:02:37.50,1:02:40.04,all,,0,0,0,,لا أعرف أي مكان هو الأفضل للتصويب
Dialogue: 0,1:02:40.29,1:02:42.92,كونان,,0,0,0,,أنا لم أقل أنك قاتل محترف أبي
Dialogue: 0,1:02:43.63,1:02:48.55,كونان,,0,0,0,,لكن أبي المفصل الثاني في سبابتك اليمني عليه علامات و علي كفك الأيسر
Dialogue: 0,1:02:49.30,1:02:50.09,كونان,,0,0,0,,... وأيضاً
Dialogue: 0,1:02:50.71,1:02:54.34,كونان,,0,0,0,,يدك معتادة على تغيير أسطوانة المسدس , أليس كذلك ؟
Dialogue: 0,1:02:56.01,1:02:56.88,all,,0,0,0,,!متى رأيتها ؟
Dialogue: 0,1:02:57.26,1:03:00.34,all,,0,0,0,,. كانت يدي في جيبي طوال الوقت
Dialogue: 0,1:03:00.72,1:03:02.84,كونان,,0,0,0,,لقد رأيتهم عندما كنا في القصر
Dialogue: 0,1:03:03.59,1:03:04.47,all,,0,0,0,,هيه أيها الفتى
Dialogue: 0,1:03:05.72,1:03:07.51,all,,0,0,0,,لدي شيءً واحداً لأقوله
Dialogue: 0,1:03:08.89,1:03:10.76,all,,0,0,0,,! لا تقل لي أبي مجدداً
Dialogue: 0,1:03:12.18,1:03:15.29,كونان,,0,0,0,,لاأستطيع , مازلنا في فترة الظهيرة
Dialogue: 0,1:03:15.60,1:03:18.06,كونان,,0,0,0,,لقد قلت أننا سنذهب لمكان الحادثة
Dialogue: 0,1:03:18.69,1:03:20.06,all,,0,0,0,,هذه ليست غلطتي
Dialogue: 0,1:03:20.39,1:03:22.77,all,,0,0,0,,هذه غلطت المتاجر التي تفتح أبوابها في هذا الوقت
Dialogue: 0,1:03:23.27,1:03:25.48,كونان,,0,0,0,,الا تري أنه عذر واضح جداً ؟
Dialogue: 0,1:03:26.11,1:03:27.94,all,,0,0,0,,لاتقلق , مجرد كوباً واحداً
Dialogue: 0,1:03:28.52,1:03:28.98,all,,0,0,0,,خذ
Dialogue: 0,1:03:29.73,1:03:31.61,all,,0,0,0,,حوالي 500 ين ياباني
Dialogue: 0,1:03:31.86,1:03:33.94,all,,0,0,0,,أشتر لنفسك عصيراً أو شيء كهذا و أحتفظ بالباقي
Dialogue: 0,1:03:34.61,1:03:35.69,كونان,,0,0,0,,كوباً فقط
Dialogue: 0,1:03:36.11,1:03:39.74,لوبين,,0,0,0,,يا اللهي , كأن معي أميرتان
Dialogue: 0,1:03:40.11,1:03:41.61,لوبين,,0,0,0,,الأولى ترغب في الكولا
Dialogue: 0,1:03:44.82,1:03:46.66,لوبين,,0,0,0,,! ماذا , هيه كولا
Dialogue: 0,1:03:47.66,1:03:48.74,لوبين,,0,0,0,,!لماذا لا تخرج الكولا ؟
Dialogue: 0,1:03:49.33,1:03:52.12,لوبين,,0,0,0,,والمال لن يخرج ايضاً, ماهذا ؟
Dialogue: 0,1:03:52.87,1:03:53.91,لوبين,,0,0,0,,! اها عرفت
Dialogue: 0,1:03:54.24,1:03:55.79,لوبين,,0,0,0,,إذاً هذا ماتريد
Dialogue: 0,1:03:56.95,1:04:00.27,لوبين,,0,0,0,,سوف أستخدم حركتي القاضية , راقبني
Dialogue: 0,1:04:05.79,1:04:08.79,لوبين,,0,0,0,,حصلت على بعض الفكة ايضاً
Dialogue: 0,1:04:09.00,1:04:11.00,كونان,,0,0,0,,سيدي لا يجب أن تسرق
Dialogue: 0,1:04:12.38,1:04:14.13,لوبين,,0,0,0,,لا تلومني يا صغير
Dialogue: 0,1:04:14.71,1:04:16.51,لوبين,,0,0,0,,لقد دفعت , أليس كذلك ؟
Dialogue: 0,1:04:16.59,1:04:17.55,كونان,,0,0,0,,دفعت لواحدة فقط
Dialogue: 0,1:04:17.71,1:04:20.92,لوبين,,0,0,0,,لابأس , أنهم يطلبون مني أن أخذ أكثر
Dialogue: 0,1:04:21.13,1:04:22.80,كونان,,0,0,0,,أنت حقاً شخصاً سيء ؟
Dialogue: 0,1:04:23.38,1:04:25.68,كونان,,0,0,0,,عمي أنت لاتبدو سيئً
Dialogue: 0,1:04:25.89,1:04:29.80,لوبين,,0,0,0,,خذ حذرك , أنا لصً سيئ جداً
Dialogue: 0,1:04:29.97,1:04:33.97,كونان,,0,0,0,,فهمت , لهذا لديك حافظة مسدس تحت كتفك , صحيح ؟
Dialogue: 0,1:04:35.52,1:04:38.39,كونان,,0,0,0,,كتفك الأيسر أعلي قليلاً من الطبيعي
Dialogue: 0,1:04:39.68,1:04:41.06,لوبين,,0,0,0,,Cheese قل
Dialogue: 0,1:04:42.39,1:04:45.35,لوبين,,0,0,0,,ياللعار , أنها مجرد كاميرا فيديو
Dialogue: 0,1:04:46.56,1:04:49.90,كونان,,0,0,0,,آسف , أعتقدت حقاً أنك رجلاً سيء
Dialogue: 0,1:04:50.36,1:04:51.15,كونان,,0,0,0,,هذا جيد
Dialogue: 0,1:04:51.44,1:04:54.65,كونان,,0,0,0,,قول شيءً مثل ذلك لشخصاً سيء سيكون خطراً
Dialogue: 0,1:04:56.82,1:04:58.57,لوبين,,0,0,0,,!هيه , ستأخد واحدة فقط ؟
Dialogue: 0,1:04:59.40,1:05:00.69,لوبين,,0,0,0,,يمكنك أن تأخذ أكثر
Dialogue: 0,1:05:01.15,1:05:02.82,لوبين,,0,0,0,,دعنا نصبح شركاء في ذلك
Dialogue: 0,1:05:03.57,1:05:05.20,كونان,,0,0,0,,لا يجب أن تسرق
Dialogue: 0,1:05:08.11,1:05:12.08,لوبين,,0,0,0,,ماخطبُ هذا الفتى ؟! أصدقائة سيهربون منه أن كان هكذا دوماً
Dialogue: 0,1:05:24.00,1:05:26.58,لوبين,,0,0,0,,لقد دفعت لشرابين
Dialogue: 0,1:05:28.61,1:05:31.65,note,,0,0,0,,{\pos(654,418)}قصر فيسبانيا الملكي
Dialogue: 0,1:05:39.01,1:05:42.05,all,,0,0,0,, ؟ICPO مرحباً أنت من الـ
Dialogue: 0,1:05:42.51,1:05:44.05,all,,0,0,0,,نعم , أنا زينيجاتا
Dialogue: 0,1:05:44.55,1:05:45.55,all,,0,0,0,,لندخل بالموضوع مباشرةً
Dialogue: 0,1:05:45.68,1:05:48.26,all,,0,0,0,,دعنا لا نستعجل
Dialogue: 0,1:05:48.59,1:05:50.68,all,,0,0,0,,لنتكلم بالداخل , أتوافقني على ذلك ؟
Dialogue: 0,1:05:51.55,1:05:52.89,all,,0,0,0,,وهذا يكون ؟
Dialogue: 0,1:05:53.85,1:05:55.32,all,,0,0,0,,أنا مساعد المفتش زينيجاتا
Dialogue: 0,1:05:55.32,1:05:57.01,all,,0,0,0,,كوغورو موري
Dialogue: 0,1:05:57.47,1:06:00.97,all,,0,0,0,,حضرت المفتش أرغب بأخذ جولة حول المكان
Dialogue: 0,1:06:01.32,1:06:02.81,all,,0,0,0,,لا داعي للعجلة
Dialogue: 0,1:06:03.10,1:06:04.52,all,,0,0,0,,... قد تم اعداد الشاي
Dialogue: 0,1:06:04.53,1:06:05.77,all,,0,0,0,,أنا ذاهب
Dialogue: 0,1:06:06.69,1:06:08.81,all,,0,0,0,,أين أنت يا لوبين ؟
Dialogue: 0,1:06:10.40,1:06:12.81,all,,0,0,0,,تستطيع أن تتجاهله
Dialogue: 0,1:06:14.40,1:06:17.37,all,,0,0,0,,! لوبين! لوبين
Dialogue: 0,1:06:17.69,1:06:19.15,all,,0,0,0,,! ران
Dialogue: 0,1:06:19.65,1:06:21.61,all,,0,0,0,,أين أنتِ ران ؟
Dialogue: 0,1:06:22.07,1:06:23.03,ران,,0,0,0,,لذيذ
Dialogue: 0,1:06:23.35,1:06:25.19,all,,0,0,0,,! ران
Dialogue: 0,1:06:25.41,1:06:27.11,ران,,0,0,0,,هذا الصوت .. والدي ؟
Dialogue: 0,1:06:27.35,1:06:29.35,all,,0,0,0,,رجاءً انتظري أميرة ران
Dialogue: 0,1:06:29.53,1:06:31.07,all,,0,0,0,,قد يكون شخصاً مريباً
Dialogue: 0,1:06:32.82,1:06:34.57,all,,0,0,0,,! ران
Dialogue: 0,1:06:35.03,1:06:36.49,all,,0,0,0,,شخصاً مريباً بالفعل
Dialogue: 0,1:06:36.87,1:06:38.26,all,,0,0,0,,رجلاً ذو شوارب قصيرة
Dialogue: 0,1:06:38.26,1:06:39.43,all,,0,0,0,,و شكله مخيف
Dialogue: 0,1:06:39.43,1:06:42.20,all,,0,0,0,,!مستحيل أن يكون والدك يا أميرة ران
Dialogue: 0,1:06:42.41,1:06:43.54,ران,,0,0,0,,أنه هو تماماً
Dialogue: 0,1:06:45.37,1:06:47.23,all,,0,0,0,,ران , انت بخير ؟ -
Dialogue: 0,1:06:46.24,1:06:47.47,ران,,0,0,0,,أبي لماذا أنت هنا ؟ -
Dialogue: 0,1:06:47.47,1:06:50.47,all,,0,0,0,,! كل شئ سيكون بخير , سنترك هذا المكان فوراً -
Dialogue: 0,1:06:47.47,1:06:50.47,ران,,0,0,0,,أرجوك ساعد كونان -
Dialogue: 0,1:06:51.27,1:06:52.34,كيث,,0,0,0,,ماهذه الجلبة ؟
Dialogue: 0,1:06:52.34,1:06:53.34,all,,0,0,0,,كونت كيث
Dialogue: 0,1:06:53.34,1:06:55.48,all,,0,0,0,,... كيف تجرؤ -
Dialogue: 0,1:06:54.34,1:06:55.48,ران,,0,0,0,,أستمع لي أبي -
Dialogue: 0,1:06:56.31,1:06:58.25,all,,0,0,0,,أنظر إلي أيها الحقير -
Dialogue: 0,1:06:56.88,1:06:58.25,ران,,0,0,0,,توقف يا أبي -
Dialogue: 0,1:06:58.25,1:07:00.32,all,,0,0,0,,سألكمك كبداية -
Dialogue: 0,1:06:58.25,1:07:00.32,ران,,0,0,0,,! أستمع لي -
Dialogue: 0,1:07:00.32,1:07:01.25,ران,,0,0,0,,! لاتفعل
Dialogue: 0,1:07:01.25,1:07:03.28,all,,0,0,0,,لا تقلقي معي ورقة الإستقالة
Dialogue: 0,1:07:02.76,1:07:04.42,كيث,,0,0,0,,هل يمكنك رجاءً أن تدعني أوضح ؟
Dialogue: 0,1:07:04.33,1:07:05.20,all,,0,0,0,,!أصمت -
Dialogue: 0,1:07:06.29,1:07:09.29,all,,0,0,0,,وهل حقاً لوبين يسعى للحصول على تاج الملكة ؟
Dialogue: 0,1:07:10.71,1:07:13.84,note,,0,0,0,,{\pos(656,410)}حجرة الضيوف الملكية
Dialogue: 0,1:07:09.39,1:07:11.72,all,,0,0,0,,نعم , لاشك بهذا
Dialogue: 0,1:07:12.19,1:07:18.33,all,,0,0,0,,لكن ألم يحاول لوبين من قبل أن يسرق التاج مرةً ويأس ؟
Dialogue: 0,1:07:18.33,1:07:21.33,all,,0,0,0,,لم ييأس عن أي شئ فيما مضي
Dialogue: 0,1:07:21.72,1:07:23.43,all,,0,0,0,,لقد فهمت الآن
Dialogue: 0,1:07:23.89,1:07:28.02,all,,0,0,0,,يمكننا أن نجعل لوبين ييأس مجدداً , صحيح ؟
Dialogue: 0,1:07:28.94,1:07:31.45,all,,0,0,0,,أن كان نظامنا الأمني قابل للأختراق
Dialogue: 0,1:07:31.81,1:07:33.56,all,,0,0,0,,سوف أسلمه التاج بسرور
Dialogue: 0,1:07:35.40,1:07:38.40,all,,0,0,0,,لنأمل استسلامه
Dialogue: 0,1:07:40.94,1:07:43.49,all,,0,0,0,,الطعام جاهز في الغرفة المجاوره
Dialogue: 0,1:07:43.73,1:07:46.46,all,,0,0,0,,سأتفقد الخزنة أولاً
Dialogue: 0,1:07:46.82,1:07:48.95,all,,0,0,0,,ذلك الشخص هناك سيرشدك
Dialogue: 0,1:07:49.03,1:07:49.70,all,,0,0,0,,شكراً لك
Dialogue: 0,1:07:54.11,1:07:56.62,all,,0,0,0,,أرجو أن تقوم بتحريك الأمور من أجلي
Dialogue: 0,1:07:59.72,1:08:02.72,ران,,0,0,0,,كونان و ذلك الرجل يحاولان أن يجدا أدلة و أريدك أن تساعدهم
Dialogue: 0,1:08:00.22,1:08:02.72,note,,0,0,0,,{\pos(632,419)}شرح ران
Dialogue: 0,1:08:02.72,1:08:05.72,all,,0,0,0,,بما أنه لم يستطع الذهاب بنفسه , فلقد فضل ذهابي بدلأ منه
Dialogue: 0,1:08:03.22,1:08:05.72,note,,0,0,0,,{\pos(644,420)}شرح كوغورو
Dialogue: 0,1:08:06.70,1:08:08.83,كيث,,0,0,0,,هل أنت راضً الأن ؟
Dialogue: 0,1:08:09.32,1:08:10.54,all,,0,0,0,,لا يمكن
Dialogue: 0,1:08:11.25,1:08:16.29,ران,,0,0,0,,أبي , من الصعب على كونان و ذلك الرجل أن يجدا الدليل وحدهم
Dialogue: 0,1:08:16.67,1:08:20.67,all,,0,0,0,,لايمكننا القول إلى حد الآن أن الدوق جيرارد هو المذنب
Dialogue: 0,1:08:20.84,1:08:22.25,ران,,0,0,0,,...لكن في مسرح الجريمة
Dialogue: 0,1:08:22.30,1:08:23.33,all,,0,0,0,,لا تكوني ساذجة
Dialogue: 0,1:08:23.59,1:08:26.09,all,,0,0,0,,هذا مايقولونه
Dialogue: 0,1:08:26.55,1:08:28.30,all,,0,0,0,,أنت الكونت , أليس كذلك ؟
Dialogue: 0,1:08:28.51,1:08:33.13,all,,0,0,0,,من المحتمل أنك تضعها على جيرارد لتكون أنت الحاكم التالي
Dialogue: 0,1:08:33.34,1:08:36.59,all,,0,0,0,,مستحيل ! السيد كيث كان في القصر ذلك اليوم
Dialogue: 0,1:08:36.97,1:08:39.05,all,,0,0,0,,لم يكن بحاجه أن يفعلها بنفسه
Dialogue: 0,1:08:39.32,1:08:42.32,all,,0,0,0,,ذلك بسيط يقوم بأستخدام قناصاً محترف
Dialogue: 0,1:08:43.25,1:08:45.26,ران,,0,0,0,,قناصاً محترف ؟
Dialogue: 0,1:08:47.39,1:08:48.77,note,,0,0,0,,{\pos(632,648.5)}شخصاً مشبوه
Dialogue: 0,1:08:49.06,1:08:51.27,all,,0,0,0,,هه ... إذاً هناك شخص تشتبهون به ؟
Dialogue: 0,1:08:51.85,1:08:53.39,كيث,,0,0,0,,أنت علي حق
Dialogue: 0,1:08:54.02,1:08:57.44,كيث,,0,0,0,,يمكنني أن أفهم لماذا نشأ أبنك بهذه الطريقة
Dialogue: 0,1:08:58.30,1:08:59.06,all,,0,0,0,,أنه ليس أبني
Dialogue: 0,1:08:59.37,1:09:00.73,all,,0,0,0,,أنا فقط أعتني به
Dialogue: 0,1:09:01.27,1:09:03.52,كيث,,0,0,0,,أنا أرغب بأستخدام شخصاً مثلك
Dialogue: 0,1:09:04.86,1:09:07.44,كيث,,0,0,0,,لتحقيقً كبير
Dialogue: 0,1:09:08.61,1:09:12.07,كيث,,0,0,0,,بالرغم من أنه عدداً ليس بالكثير , لكنه يحسب بالين الياباني
Dialogue: 0,1:09:15.32,1:09:17.29,كيث,,0,0,0,,هل تقبل بهذا ؟
Dialogue: 0,1:09:17.29,1:09:20.29,all,,0,0,0,,! سأقبل به وبسرور
Dialogue: 0,1:09:21.26,1:09:22.46,كيث,,0,0,0,,... أتطلع لذلك
Dialogue: 0,1:09:22.83,1:09:24.37,ران,,0,0,0,,... أبي
Dialogue: 0,1:09:34.91,1:09:38.04,لوبين,,0,0,0,,لازالت تريد زيارة ذلك المكان قبل العودة
Dialogue: 0,1:09:38.67,1:09:41.38,فوجي,,0,0,0,,أنه هناك , صحيح ؟ المكان الذي ماتا به
Dialogue: 0,1:09:41.41,1:09:42.25,لوبين,,0,0,0,,أجل
Dialogue: 0,1:09:43.28,1:09:45.41,فوجي,,0,0,0,,هل من الجيد تركها تذهب لوحدها ؟
Dialogue: 0,1:09:45.41,1:09:47.45,فوجي,,0,0,0,,أنها خبيرةً بالهرب
Dialogue: 0,1:09:47.96,1:09:50.76,لوبين,,0,0,0,,أن كانت تريد الهرب , لما عادت
Dialogue: 0,1:09:51.71,1:09:55.43,لوبين,,0,0,0,,وأن تبعناها , فلن تستطيع البكاء , صحيح ؟
Dialogue: 0,1:09:55.84,1:09:59.72,فوجي,,0,0,0,,أنت تفهمها جيداً , هاه ؟
Dialogue: 0,1:10:00.26,1:10:01.46,فوجي,,0,0,0,,سأشتبه بك
Dialogue: 0,1:10:01.46,1:10:04.30,لوبين,,0,0,0,,... لا , فقط لكن
Dialogue: 0,1:10:04.30,1:10:05.14,فوجي,,0,0,0,,لكن ماذا ؟
Dialogue: 0,1:10:06.40,1:10:07.89,لوبين,,0,0,0,,أنها مألوفه لدي
Dialogue: 0,1:10:18.77,1:10:21.10,ميرا,,0,0,0,,أمي , أخي
Dialogue: 0,1:10:22.25,1:10:24.31,ميرا,,0,0,0,,هذا هو مكاني الوحيد
Dialogue: 0,1:10:26.26,1:10:28.26,ميرا,,0,0,0,,لايمكنني فعل أي شيء
Dialogue: 0,1:10:28.26,1:10:30.49,ميرا,,0,0,0,,لا أستطيع فعل ما يتوقعه مني الجميع
Dialogue: 0,1:10:31.32,1:10:33.49,ميرا,,0,0,0,,لا أحد يحبني
Dialogue: 0,1:10:34.65,1:10:36.86,ميرا,,0,0,0,,لكن .. لا مزيد من ذلك
Dialogue: 0,1:10:37.43,1:10:41.11,ميرا,,0,0,0,,... ماعدا هذا المكان , حيث كلاكما
