Dialogue: 0,0:00:13.36,0:00:16.16,note,,0,0,0,,{\pos(404,514)}مملكة فيسبانيا
Dialogue: 0,0:00:18.16,0:00:21.16,note,,0,0,0,,{\pos(414,508)}الغابة الملكية الخاصة
Dialogue: 0,0:00:31.16,0:00:32.22,all,,0,0,0,,لقد وصلنا إلى الموقع
Dialogue: 0,0:00:32.39,0:00:33.14,all,,0,0,0,,لتبدأ العمليات الآن
Dialogue: 0,0:00:33.39,0:00:34.10,all,,0,0,0,, كل شيءً يبدو جيداً
Dialogue: 0,0:00:34.22,0:00:35.72,all,,0,0,0,,الجميع في مواقعهم
Dialogue: 0,0:00:40.10,0:00:43.35,note,,0,0,0,,{\pos(536,422)}جيرارد موسكا فيسبالاند\N دوق فيسبانيا
Dialogue: 0,0:00:44.27,0:00:48.56,note,,0,0,0,,{\pos(564,422)}جيل كاول فيسبالاند\N أمير فيسبانبا
Dialogue: 0,0:01:03.69,0:01:06.26,all,,0,0,0,,جميعكم أنتظروا هنا , حتى أطلبكم مجدداً
Dialogue: 0,0:01:06.27,0:01:09.27,all,,0,0,0,,الكثير من الأشخاص سيُخيف الحيوانات وستبتعد
Dialogue: 0,0:01:13.07,0:01:14.37,all,,0,0,0,,سأخذ هذه
Dialogue: 0,0:01:15.11,0:01:18.11,all,,0,0,0,,أستعملها كم علمتك من قبل , أتذكر ؟
Dialogue: 0,0:01:18.91,0:01:20.41,all,,0,0,0,,...بالطبع
Dialogue: 0,0:01:20.60,0:01:23.16,all,,0,0,0,,و كيف أنسي ذلك ؟
Dialogue: 0,0:01:23.25,0:01:25.28,all,,0,0,0,,سعيد لسماع ذلك
Dialogue: 0,0:01:25.25,0:01:26.83,all,,0,0,0,,تفضل
Dialogue: 0,0:01:28.02,0:01:31.37,all,,0,0,0,,يا ويلي ... أنه شرف أن تحمليها لي جلالتك
Dialogue: 0,0:01:32.09,0:01:35.09,all,,0,0,0,,أمي , أنتِ حقاً لا ترغبي بالقدوم معنا ؟
Dialogue: 0,0:01:35.23,0:01:38.06,all,,0,0,0,,لا , شكراً
Dialogue: 0,0:01:38.07,0:01:42.07,note,,0,0,0,,{\pos(484,430)}ساكورا ألديا فيسبالاند\N ملكة فيسبانيا
Dialogue: 0,0:01:38.06,0:01:41.59,all,,0,0,0,,أنا لا أحب مثل هذه النشاطات البربريه , مثل الصيد
Dialogue: 0,0:01:42.67,0:01:44.13,all,,0,0,0,,...إنها ليست بربرية
Dialogue: 0,0:01:45.07,0:01:47.21,all,,0,0,0,,إن الصيد رياضه نبيله
Dialogue: 0,0:01:47.21,0:01:49.14,all,,0,0,0,,لا بأس , أيها الأمير
Dialogue: 0,0:01:49.14,0:01:52.14,all,,0,0,0,,دعنا نحظى بمعركه الرجال , واحد ضد واحد
Dialogue: 0,0:01:53.05,0:01:56.01,all,,0,0,0,,الرجال هم فقط من يفهمون الشعور بلذة الصيد , أليس كذلك ؟
Dialogue: 0,0:01:56.01,0:01:57.18,all,,0,0,0,,! لقد سمعت ذلك
Dialogue: 0,0:01:57.18,0:02:00.18,all,,0,0,0,,هاه ... يا للهول
Dialogue: 0,0:03:03.18,0:03:05.15,all,,0,0,0,,لايمكنك البقاء هنا
Dialogue: 0,0:03:05.15,0:03:08.15,all,,0,0,0,,! بسرعه , أهرب بعيداً
Dialogue: 0,0:03:39.73,0:03:40.44,all,,0,0,0,,! أمي
Dialogue: 0,0:03:41.44,0:03:42.69,all,,0,0,0,,! لا
Dialogue: 0,0:03:44.40,0:03:45.23,all,,0,0,0,,... مستحيل
Dialogue: 0,0:03:48.19,0:03:50.07,all,,0,0,0,,!!! مستحيل
Dialogue: 0,0:03:52.53,0:03:53.86,all,,0,0,0,,! أذهب وأستطلع الأمر , بسرعه
Dialogue: 0,0:03:54.11,0:03:54.45,all,,0,0,0,,حسناً
Dialogue: 0,0:03:54.90,0:03:55.78,all,,0,0,0,,أنتم , إلي السيارة
Dialogue: 0,0:03:55.78,0:03:56.24,all,,0,0,0,,عُلم
Dialogue: 0,0:04:11.79,0:04:12.70,all,,0,0,0,,دوق جيرارد
Dialogue: 0,0:04:17.06,0:04:20.06,all,,0,0,0,,لم أستطع إيقافه
Dialogue: 0,0:04:26.03,0:04:28.23,all,,0,0,0,,و مرة ثانية يمر بقاعدة أخري
Dialogue: 0,0:04:28.42,0:04:30.17,all,,0,0,0,,! هذا مخيف
Dialogue: 0,0:04:30.17,0:04:30.92,all,,0,0,0,,جميع القواعد الأن مملؤة
Dialogue: 0,0:04:31.17,0:04:32.76,all,,0,0,0,,! عظيم
Dialogue: 0,0:04:33.21,0:04:34.84,all,,0,0,0,,!شراب , شراب
Dialogue: 0,0:04:35.84,0:04:36.72,all,,0,0,0,,!لذيذ
Dialogue: 0,0:04:37.04,0:04:39.34,ران,,0,0,0,,! أبي , توقف عن الشرب , لقد شربت خمسة
Dialogue: 0,0:04:39.80,0:04:43.76,كونان,,0,0,0,,من وجهة نظري \N يبدو أن هذا هو اهتمامه الوحيد
Dialogue: 0,0:04:44.28,0:04:46.25,all,,0,0,0,,! هيا , يارومي
Dialogue: 0,0:04:46.25,0:04:48.12,all,,0,0,0,,! ضربة واحدة ستفعلها
Dialogue: 0,0:04:48.12,0:04:51.06,all,,0,0,0,,!أو أفضل اصنع دوره كامله
Dialogue: 0,0:04:51.06,0:04:53.12,ران,,0,0,0,,لماذ أخذت علبتين ثانيةً ؟
Dialogue: 0,0:04:53.13,0:04:55.13,all,,0,0,0,,لا تخذلني
Dialogue: 0,0:04:55.13,0:04:56.16,ران,,0,0,0,,... أبي
Dialogue: 0,0:04:57.19,0:04:58.19,note,,0,0,0,,{\pos(534,220)}NNN أخبار عاجلة
Dialogue: 0,0:04:57.19,0:04:58.98,all,,0,0,0,,!يجب أن يقذفوا الكرة وإلا الهزيمة
Dialogue: 0,0:04:58.19,0:05:01.57,note,,0,0,0,,{\pos(624,234)}ساكورا ملكة فيسبانيا و\N الأمير جيل ماتوا في حادث
Dialogue: 0,0:04:58.98,0:05:01.57,all,,0,0,0,,لذا , أختيار المدرب هوشينو هو ؟
Dialogue: 0,0:05:03.27,0:05:06.27,all,,0,0,0,,وفي منتصف هذه المبارة المباشرة نجلب لكم آخر الآخبار
Dialogue: 0,0:05:07.04,0:05:08.21,all,,0,0,0,,... هيه , دعوني أكمـ
Dialogue: 0,0:05:08.12,0:05:10.12,more,,0,0,0,,وفي منتصف هذه المبارة المباشرة نجلب لكم آخر الآخبار
Dialogue: 0,0:05:08.12,0:05:15.62,note,,0,0,0,,{\pos(1010,428)}!!ملكة فيسبانيا ماتت
Dialogue: 0,0:05:08.21,0:05:11.14,all,,0,0,0,,في هذا الصباح , حوالي الساعه 10:25 صباحاً -
Dialogue: 0,0:05:08.21,0:05:11.14,all,,0,0,0,,لا توقفوا بث المبارة -
Dialogue: 0,0:05:11.14,0:05:14.24,all,,0,0,0,,من بلاد فيسبانيا الملكه ساكورا والأمير جيل
Dialogue: 0,0:05:14.36,0:05:16.15,all,,0,0,0,,ماتا بالخطأ عندما ذهبوا للصيد سويةً
Dialogue: 0,0:05:16.15,0:05:17.18,all,,0,0,0,,دعوني أعيد الخبر
Dialogue: 0,0:05:17.18,0:05:20.53,all,,0,0,0,,من بلاد فيسبانيا الملكه ساكورا والأمير جيل ماتا بالخطأ
Dialogue: 0,0:05:21.03,0:05:24.99,all,,0,0,0,,وفي بلاد فيسبانيا تم ايجاد معدن مجهول
Dialogue: 0,0:05:24.07,0:05:25.70,all,,0,0,0,,ماتا في حادث صيد ؟ -
Dialogue: 0,0:05:25.02,0:05:27.03,all,,0,0,0,,وعيون كُل العالم عليه -
Dialogue: 0,0:05:27.66,0:05:29.28,all,,0,0,0,,... المتوفاه الملكه ساكورا كانت معروفة بحبها لليابان
