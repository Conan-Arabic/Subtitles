Dialogue: 0,1:18:58.82,1:19:00.24,ران,,0,0,0,,أنتما الأثنان
Dialogue: 0,1:19:01.61,1:19:03.07,all,,0,0,0,,ران -
Dialogue: 0,1:19:01.61,1:19:03.07,كونان,,0,0,0,, ران -
Dialogue: 0,1:19:03.44,1:19:04.87,ران,,0,0,0,,! لايعقل هذا
Dialogue: 0,1:19:04.95,1:19:05.83,ران,,0,0,0,,! أنتما الآسوء
Dialogue: 0,1:19:06.45,1:19:08.34,all,,0,0,0,,لاتغضبي يا ران
Dialogue: 0,1:19:08.34,1:19:10.12,كونان,,0,0,0,, ران
Dialogue: 0,1:19:10.38,1:19:11.99,all,,0,0,0,,قهوتك جاهزه
Dialogue: 0,1:19:12.38,1:19:13.25,all,,0,0,0,,شكراً لكِ
Dialogue: 0,1:19:13.95,1:19:15.58,all,,0,0,0,,أنتِ بقيتي هنا , هاه ؟
Dialogue: 0,1:19:15.83,1:19:19.25,all,,0,0,0,,أجل , أنا فقط والطباخ
Dialogue: 0,1:19:19.42,1:19:22.96,all,,0,0,0,,أنا آسف , لكن هل يمكننا التحدث قليلاً ؟
Dialogue: 0,1:19:23.43,1:19:25.43,all,,0,0,0,,لما هذا العجوز هنا ؟
Dialogue: 0,1:19:25.58,1:19:27.43,لوبين,,0,0,0,,كيف لي أن أعرف ؟
Dialogue: 0,1:19:27.75,1:19:28.88,all,,0,0,0,,هل هي تلك الفتاة ؟
Dialogue: 0,1:19:29.00,1:19:31.21,لوبين,,0,0,0,,مستحيل , صحيح ؟
Dialogue: 0,1:19:31.80,1:19:34.23,لوبين,,0,0,0,,...حسناً إذاً , بما أن الجميع أصبحوا هنا
Dialogue: 0,1:19:34.24,1:19:36.63,لوبين,,0,0,0,,هل نبدأ الأن ؟
Dialogue: 0,1:19:42.93,1:19:45.68,ميرا,,0,0,0,,... عطر أمي
Dialogue: 0,1:19:47.60,1:19:48.72,ران,,0,0,0,,الأميرة ميرا ؟
Dialogue: 0,1:19:49.26,1:19:50.14,ميرا,,0,0,0,,الباب مفتوح
Dialogue: 0,1:19:51.89,1:19:53.14,ران,,0,0,0,,آسفه على الآزعاج
Dialogue: 0,1:19:53.49,1:19:55.31,ران,,0,0,0,,لقد أحضرت الآثنان
Dialogue: 0,1:19:56.32,1:19:57.77,ران,,0,0,0,,الا بأس بهذا حقاً ؟
Dialogue: 0,1:19:58.39,1:19:59.64,ميرا,,0,0,0,,هذا لايهم
Dialogue: 0,1:20:00.06,1:20:01.44,ميرا,,0,0,0,,هذه غرفة والدتي
Dialogue: 0,1:20:02.10,1:20:04.86,ميرا,,0,0,0,,ولم يتغير شيءً في ترتيبها منذ وفاتها
Dialogue: 0,1:20:04.86,1:20:07.28,ميرا,,0,0,0,,لم أسمح لأحد بلمس أي شئ
Dialogue: 0,1:20:07.81,1:20:10.15,ميرا,,0,0,0,,أنتما ستقومان بتفتيش الغرفة ؟\Nإذاً سأساعدكم
Dialogue: 0,1:20:11.32,1:20:13.40,all,,0,0,0,,إذاً , لنبدأ
Dialogue: 0,1:20:14.44,1:20:16.11,ميرا,,0,0,0,,لكن ستسخر من ذلك , صحيح ؟
Dialogue: 0,1:20:16.61,1:20:21.24,ميرا,,0,0,0,,خالي قتل والدتي و أخي , سأساعدك لتجد أدلة
Dialogue: 0,1:20:21.53,1:20:24.42,ران,,0,0,0,,... ذلك ... لم يقرر بعد
Dialogue: 0,1:20:26.07,1:20:27.12,ران,,0,0,0,,أنا آسفه
Dialogue: 0,1:20:27.62,1:20:29.70,ميرا,,0,0,0,,على ماذا تعتذرين ؟
Dialogue: 0,1:20:30.58,1:20:33.33,ميرا,,0,0,0,,هذه البلد ملعونه
Dialogue: 0,1:20:34.54,1:20:36.37,ميرا,,0,0,0,,بذلك المعدن
Dialogue: 0,1:20:36.83,1:20:37.79,ران,,0,0,0,,آنسة ميرا
Dialogue: 0,1:20:42.71,1:20:44.58,كونان,,0,0,0,,مذهل , هاه ؟
Dialogue: 0,1:20:52.67,1:20:53.50,كونان,,0,0,0,,... هذه
Dialogue: 0,1:21:02.22,1:21:05.05,كونان,,0,0,0,,لقد فهمت أخيراً مشاعر الملكة ساكورا
Dialogue: 0,1:21:08.09,1:21:10.22,كونان,,0,0,0,,ذلك الحب الكبير للملكة
Dialogue: 0,1:21:21.85,1:21:25.56,لوبين,,0,0,0,,الباب مفتوح , واللص قادم
Dialogue: 0,1:21:26.10,1:21:29.02,لوبين,,0,0,0,,الرذاذ المنوم , مزحه فقط
Dialogue: 0,1:21:29.45,1:21:31.03,لوبين,,0,0,0,,!لماذا هو نائم ؟
Dialogue: 0,1:21:31.49,1:21:32.61,لوبين,,0,0,0,,!لماذا هي مفتوحة ؟
Dialogue: 0,1:21:33.45,1:21:35.03,لوبين,,0,0,0,,!لماذا هي خالية ؟
Dialogue: 0,1:21:35.02,1:21:37.07,لوبين,,0,0,0,,ما الفائده من تلك الكرة إذاً ؟
Dialogue: 0,1:21:37.44,1:21:39.07,لوبين,,0,0,0,,آه , ما هذا ؟
Dialogue: 0,1:21:39.28,1:21:42.11,فوجي,,0,0,0,,أنا آسفة لوبين , أنا آسفة لوبين
Dialogue: 0,1:21:42.24,1:21:44.07,لوبين,,0,0,0,,! لايمكن , لايمكن
Dialogue: 0,1:21:44.37,1:21:46.53,فوجي,,0,0,0,,... أنا آسفة لوبين , أنا آسفة لوبين
Dialogue: 0,1:21:51.37,1:21:53.08,all,,0,0,0,,دخول , حراره , وزن
Dialogue: 0,1:21:55.37,1:21:56.99,لوبين,,0,0,0,,لقد أصبتهم جميعاً
Dialogue: 0,1:22:01.58,1:22:04.83,فوجي,,0,0,0,,آسفة لوبين , لقد وقعت في مكاني
Dialogue: 0,1:22:07.12,1:22:11.88,فوجي,,0,0,0,,ماهذا ؟ أليسوا مُبكرين قليلاً ؟
Dialogue: 0,1:22:13.33,1:22:15.46,all,,0,0,0,,شكراً لك على تعاونك
Dialogue: 0,1:22:15.46,1:22:20.09,all,,0,0,0,,لا لا , لقد أتى لوبين , كما هو متوقع من محترف
Dialogue: 0,1:22:20.40,1:22:22.92,all,,0,0,0,,سأعود حالاً
Dialogue: 0,1:22:22.97,1:22:25.34,all,,0,0,0,,... لوبين , لوبين
Dialogue: 0,1:22:26.21,1:22:29.21,all,,0,0,0,,سأذهب للشرفة الملكية ... هل كل شئ جاهز ؟
Dialogue: 0,1:22:29.80,1:22:32.09,all,,0,0,0,,نعم , كل شيءً جاهز
Dialogue: 0,1:22:34.43,1:22:35.51,all,,0,0,0,,أخيراً سينتهي الأمر
Dialogue: 0,1:22:36.93,1:22:38.85,لوبين,,0,0,0,,مرحباً , هل تسمعني ؟
Dialogue: 0,1:22:39.27,1:22:39.93,all,,0,0,0,,أجل
Dialogue: 0,1:22:40.18,1:22:43.52,لوبين,,0,0,0,,أنا عالق , هل يمكن أن تأتي و تساعدني ؟
Dialogue: 0,1:22:44.02,1:22:44.85,all,,0,0,0,,ماذا عن الكنز ؟
Dialogue: 0,1:22:45.02,1:22:46.10,لوبين,,0,0,0,,ليس هنا
Dialogue: 0,1:22:46.19,1:22:46.81,all,,0,0,0,,أنا سأعود
Dialogue: 0,1:22:47.06,1:22:48.81,لوبين,,0,0,0,,...أه , هيا
Dialogue: 0,1:22:48.94,1:22:50.98,all,,0,0,0,,من الأفضل لك أن تتعلم من هذا الدرس
Dialogue: 0,1:22:51.02,1:22:51.85,لوبين,,0,0,0,,أجل
Dialogue: 0,1:22:52.35,1:22:54.19,all,,0,0,0,,معلمي , قد حان دورك
Dialogue: 0,1:22:57.02,1:22:58.52,all,,0,0,0,,حسناً , مفهوم
Dialogue: 0,1:23:11.07,1:23:13.78,لوبين,,0,0,0,,أنه يقطع أكثر من اللازم
Dialogue: 0,1:23:19.91,1:23:24.79,all,,0,0,0,,لقد قطعت الكثير من عديمي القيمة مجدداً
Dialogue: 0,1:23:25.20,1:23:27.21,لوبين,,0,0,0,,متعبة تلك الوقفة أليس كذلك ؟
Dialogue: 0,1:23:27.33,1:23:27.83,all,,0,0,0,,أجل
Dialogue: 0,1:23:34.42,1:23:35.67,لوبين,,0,0,0,,شكراً لك
Dialogue: 0,1:23:38.38,1:23:39.84,لوبين,,0,0,0,,سوف أحتاج لدعمكم الأن
Dialogue: 0,1:23:45.42,1:23:46.22,all,,0,0,0,,... هاه
Dialogue: 0,1:23:47.13,1:23:50.72,all,,0,0,0,,جيغن وغويمون فقط رحلوا , كما توقعت
Dialogue: 0,1:23:51.76,1:23:52.89,all,,0,0,0,,هل الجميع هنا ؟
Dialogue: 0,1:23:53.09,1:23:55.14,all,,0,0,0,,أظن أننا الوحيدون المتبقون
Dialogue: 0,1:23:55.85,1:23:56.89,all,,0,0,0,,مالذي يحدث هنا ؟
Dialogue: 0,1:23:57.01,1:23:58.47,all,,0,0,0,,المفتش زينيجاتا طلب ذلك
Dialogue: 0,1:23:57.27,1:24:00.01,note,,0,0,0,,{\pos(658,421)}الشرفة الملكية
Dialogue: 0,1:24:00.37,1:24:03.37,all,,0,0,0,,هل هذا جيد أيها المفتش زينيجاتا ؟
Dialogue: 0,1:24:03.68,1:24:06.06,all,,0,0,0,,نعم . شكراً لك
Dialogue: 0,1:24:07.93,1:24:11.35,all,,0,0,0,,السبب الذي جمعتكم من اجله هنا
Dialogue: 0,1:24:11.98,1:24:17.02,all,,0,0,0,,قبل فترة قليله, تاج الملكة سرق من الخزنة الملكية
Dialogue: 0,1:24:17.39,1:24:21.11,all,,0,0,0,,... و لكي نمسك اللص و نسترد تاج الملكة -
Dialogue: 0,1:24:18.45,1:24:21.11,كونان,,0,0,0,,أنا آسف , لكن علي أن أتكلم أولاُ -
Dialogue: 0,1:24:21.26,1:24:25.73,all,,0,0,0,,...كان علي إفراغ القصر بأي شكل لكي
Dialogue: 0,1:24:28.57,1:24:29.15,كونان,,0,0,0,,! تباً
Dialogue: 0,1:24:33.40,1:24:35.44,كونان,,0,0,0,,بما أن الوضع هكذا
Dialogue: 0,1:24:35.61,1:24:36.66,all,,0,0,0,,!ماالأمر ؟
Dialogue: 0,1:24:37.12,1:24:38.99,كونان,,0,0,0,,! .. أنهُ هنا
Dialogue: 0,1:24:40.33,1:24:42.99,كونان,,0,0,0,,الشخص الذي يحاول أن يقتل الأميرة ميرا
Dialogue: 0,1:24:43.99,1:24:45.74,ران,,0,0,0,,لكنك أنت الذي كنت تحقق بالقضية ؟
Dialogue: 0,1:24:45.79,1:24:47.25,all,,0,0,0,,آه , أنا ؟
Dialogue: 0,1:24:47.87,1:24:52.21,كونان,,0,0,0,,كل هذا بسبب حادث الصيد المؤسف
Dialogue: 0,1:24:52.42,1:24:53.49,all,,0,0,0,,أنه .. ؟
Dialogue: 0,1:24:53.79,1:24:56.00,all,,0,0,0,,لا , لايمكن أن يكون هو
Dialogue: 0,1:24:56.36,1:24:59.36,all,,0,0,0,,الفتى الصغير ووالد الآنسة ران كانا يحققان في القضية , أليس كذلك ؟
Dialogue: 0,1:24:59.84,1:25:01.59,كونان,,0,0,0,,تلك لم تكن حادثة
Dialogue: 0,1:25:02.67,1:25:04.21,كونان,,0,0,0,,!آه , ماذا ؟
Dialogue: 0,1:25:06.55,1:25:07.42,all,,0,0,0,,ماذا ؟
Dialogue: 0,1:25:07.71,1:25:11.13,كونان,,0,0,0,,هل هو وحش ؟ حتى الفيل سيغط بالنوم لمدة 30 دقيقة
Dialogue: 0,1:25:11.76,1:25:15.59,لوبين,,0,0,0,,فهمت , أنها قضية قتل فجُعلت وكأنها حادثة
Dialogue: 0,1:25:17.18,1:25:20.22,all,,0,0,0,,... آه , ماالذي يحدث
Dialogue: 0,1:25:21.30,1:25:22.85,كونان,,0,0,0,,ذلك اللص متنكر ؟
Dialogue: 0,1:25:23.45,1:25:26.31,لوبين,,0,0,0,,!هذا مثير , أيها المحقق الصغير
Dialogue: 0,1:25:26.52,1:25:29.68,لوبين,,0,0,0,,هل يمكنني الكلام قليلاً , أيها العجوز ؟
Dialogue: 0,1:25:29.89,1:25:31.43,كونان,,0,0,0,,هل هو جاد ؟
Dialogue: 0,1:25:31.89,1:25:35.02,كونان,,0,0,0,,فهمتك , من الأفضل أن تؤدي ذلك جيداً
Dialogue: 0,1:25:35.81,1:25:43.32,كونان,,0,0,0,,الأمير جيل كان يصوب علي ثعلب خلف شجرة الكرز من علي تل
Dialogue: 0,1:25:43.52,1:25:48.03,كونان,,0,0,0,,الثعلب تجنبها لكن الملكة ساكورا أصيبت بها عندما خرجت من وراء الشجرة
Dialogue: 0,1:25:48.15,1:25:50.44,كونان,,0,0,0,,. هذا ماقاله الدوق جيرارد
Dialogue: 0,1:25:50.69,1:25:52.57,كونان,,0,0,0,,أليس هذا صحيح , أيتها الأميرة ميرا ؟
Dialogue: 0,1:25:52.86,1:25:53.61,لوبين,,0,0,0,,!آه ؟
Dialogue: 0,1:25:53.78,1:25:55.65,ميرا,,0,0,0,,نعم , هذا ماسمعته
Dialogue: 0,1:25:56.28,1:26:00.35,ران,,0,0,0,,!لا تقل لي أنك أخطأت بيننا ثانيةً يا أبي
Dialogue: 0,1:26:00.36,1:26:01.53,لوبين,,0,0,0,,... أنا والدكِ
Dialogue: 0,1:26:03.33,1:26:05.87,all,,0,0,0,,!لماذا هذه الفتاة هنا ؟
Dialogue: 0,1:26:06.58,1:26:09.75,كيث,,0,0,0,,إذاً أنت تعلم بأمر الفتاة اليابانية ؟
Dialogue: 0,1:26:10.50,1:26:14.00,all,,0,0,0,, SPنعم لقد سمعت عنها من الـ
Dialogue: 0,1:26:14.40,1:26:20.33,كيث,,0,0,0,,أنا آسف , لأحضارها إلى هنا بدون إذن
Dialogue: 0,1:26:20.32,1:26:21.48,كيث,,0,0,0,,و بدون إعلام أحد
Dialogue: 0,1:26:21.50,1:26:24.38,all,,0,0,0,,فهمت , هكذا إذاً
Dialogue: 0,1:26:24.79,1:26:29.34,كونان,,0,0,0,,الأمير جيل الذي قتل نفسه كان يحمل المسدس بيده اليمنى
Dialogue: 0,1:26:29.80,1:26:32.01,كونان,,0,0,0,,فيطلق على صدغة الأيمن
Dialogue: 0,1:26:32.26,1:26:34.47,كونان,,0,0,0,, هذا يعني بأنه من الطبيعي أن يحمله بيده اليمنى
Dialogue: 0,1:26:34.72,1:26:36.59,كونان,,0,0,0,,صحيح أيتها الأميرة ؟
Dialogue: 0,1:26:37.55,1:26:39.84,ميرا,,0,0,0,,أخي ... كان أعسر
Dialogue: 0,1:26:40.80,1:26:46.14,كونان,,0,0,0,,! آه , هذا يعني بأن شخصاً ما أخطأ ووضع المسدس بيده اليمنى
Dialogue: 0,1:26:46.56,1:26:49.85,كونان,,0,0,0,,!لماذا أعَتقد بأن الأمير أيمن ؟
Dialogue: 0,1:26:50.41,1:26:54.48,كونان,,0,0,0,,. لقد رأيت صورة للأمير في غرفة الملكة ساكورا
Dialogue: 0,1:26:55.31,1:26:58.31,كونان,,0,0,0,,صورة للأمير عندما كان صغيراً وهو يلعب البيسبول
Dialogue: 0,1:26:58.60,1:27:00.65,كونان,,0,0,0,,القفاز كان بيده اليمنى
Dialogue: 0,1:27:01.32,1:27:06.98,ميرا,,0,0,0,,عندما كان أخي صغيراً طُلب منه أن يستعمل يده اليمنى ليأكل ويوقع بها
Dialogue: 0,1:27:07.52,1:27:12.65,كونان,,0,0,0,,فهمت , ليس غريباً بأن يُدرب على ذلك فهو سيصبح الملك
Dialogue: 0,1:27:13.44,1:27:17.11,كونان,,0,0,0,,سيد كايل , هل من الممكن أن تعطيني البندقية التي أُستعملت ؟
Dialogue: 0,1:27:17.95,1:27:22.49,all,,0,0,0,,نعم تفضل , الفتى الصغير قال أنك ستطلبها
Dialogue: 0,1:27:23.30,1:27:26.30,كونان,,0,0,0,,كلاهما يستخدم نفس النوع من البندقيه
Dialogue: 0,1:27:26.78,1:27:30.54,كونان,,0,0,0,,...إلا إذا كانت البندقية معدلة الصنع
Dialogue: 0,1:27:30.91,1:27:34.29,كونان,,0,0,0,,فإن هذه النوعية لا تستخدم إلا باليد اليمني
Dialogue: 0,1:27:35.87,1:27:37.04,كونان,,0,0,0,,لماذا إذاً ؟
Dialogue: 0,1:27:37.39,1:27:40.39,كونان,,0,0,0,,لأن مخزن الطلقات موجود فقط في الجانب الأيمن
Dialogue: 0,1:27:42.63,1:27:45.29,لوبين,,0,0,0,,آه , هكذا إذاً
Dialogue: 0,1:27:45.33,1:27:47.59,كونان,,0,0,0,,لاتفتح فمك كما تريد
Dialogue: 0,1:27:47.67,1:27:49.96,لوبين,,0,0,0,,لقد عرفت القاتل
Dialogue: 0,1:27:50.00,1:27:50.75,كونان,,0,0,0,,! عمي
Dialogue: 0,1:27:51.13,1:27:53.09,كونان,,0,0,0,,أود أن أسمع بقيةّ إستنتاجك
Dialogue: 0,1:27:53.17,1:27:56.30,ران,,0,0,0,,كونان هذا ليس مكاناً جيداً لتجلس به
Dialogue: 0,1:27:56.37,1:27:58.09,كونان,,0,0,0,,آسف
Dialogue: 0,1:27:58.09,1:28:00.25,لوبين,,0,0,0,,...دوق جيرارد
Dialogue: 0,1:28:00.25,1:28:02.38,لوبين,,0,0,0,,!أعطيني دقيقة
Dialogue: 0,1:28:02.93,1:28:05.93,كونان,,0,0,0,,...هنا قد أرتكبت خطأً فادحاً
Dialogue: 0,1:28:06.31,1:28:09.93,كونان,,0,0,0,,حتى ذلك الحين , لقد رأيت الأمير يحمل البندقية بيده اليمنى
Dialogue: 0,1:28:10.26,1:28:15.22,كونان,,0,0,0,,فقمت بوضع المسدس بيده اليمني بدون تفكير
Dialogue: 0,1:28:21.85,1:28:24.81,all,,0,0,0,,... !لماذا ؟! لماذا ؟
Dialogue: 0,1:28:25.44,1:28:27.15,all,,0,0,0,,!لماذا أطلقت على أمي ؟
Dialogue: 0,1:28:29.65,1:28:33.73,all,,0,0,0,,الذي أطلق الرصاص علي الملكة ... هو أنت
Dialogue: 0,1:28:37.31,1:28:40.07,ميرا,,0,0,0,,هل هو أنت حقاً يا خالي ؟
Dialogue: 0,1:28:40.57,1:28:42.95,all,,0,0,0,,هل هذا ما استدعيتنا لاجله ؟
Dialogue: 0,1:28:43.25,1:28:44.45,all,,0,0,0,,مفتش زينجياتا
Dialogue: 0,1:28:44.45,1:28:47.45,all,,0,0,0,,يبدو أن مساعدك يريد تحويل القضية لجريمة قتل
Dialogue: 0,1:28:48.32,1:28:50.39,all,,0,0,0,,ما الذي علي فعله ؟
Dialogue: 0,1:28:51.53,1:28:54.70,all,,0,0,0,,سيد موري هل هذا كل ماترغب بقوله ؟
Dialogue: 0,1:28:55.16,1:28:57.62,لوبين,,0,0,0,,لا , الخاتمة هي الجزء المثير
Dialogue: 0,1:28:57.87,1:29:00.16,كونان,,0,0,0,,لقد تكلم مجدداً
Dialogue: 0,1:29:01.66,1:29:03.46,لوبين,,0,0,0,,الو ... الو ... قسم الأتصالات
Dialogue: 0,1:29:04.75,1:29:08.46,لوبين,,0,0,0,,لقد رأيت الطلقة بالداخل ... دعني أريك
Dialogue: 0,1:29:09.67,1:29:15.00,لوبين,,0,0,0,,حسناً , إذاً مازلت تصر على أنها حادثة
Dialogue: 0,1:29:15.25,1:29:18.67,لوبين,,0,0,0,,هذه بندقية الصيد التي قُتلت بها الملكة , صحيح ؟
Dialogue: 0,1:29:19.26,1:29:20.01,all,,0,0,0,,إذاً ؟
Dialogue: 0,1:29:20.76,1:29:22.59,لوبين,,0,0,0,,لقد تم أبدالها
Dialogue: 0,1:29:23.01,1:29:29.05,لوبين,,0,0,0,,بعد أن قتلت الأمير قمت بإبدال بندقيتك ببندقيته , صحيح ؟
Dialogue: 0,1:29:31.37,1:29:36.43,all,,0,0,0,,أليس هذا غير كافياً ؟ أين دليلك أن كنت تصر بأن هذه جريمة قتل ؟
Dialogue: 0,1:29:54.02,1:29:56.22,ران,,0,0,0,,!أبي ماالذي تفعله ؟
Dialogue: 0,1:29:56.86,1:29:58.19,لوبين,,0,0,0,,... اليست طلقة فارغة
Dialogue: 0,1:29:58.65,1:30:00.65,all,,0,0,0,,!طلـ .. طلقة فارغة ؟
Dialogue: 0,1:30:01.07,1:30:05.20,لوبين,,0,0,0,,الجزء الذي شغلني هو الملكة ساكورا و ذهابها للرحلة الصيد
Dialogue: 0,1:30:06.36,1:30:08.74,ميرا,,0,0,0,,هل والدكِ وأمي يعرفان بعضهما ؟
Dialogue: 0,1:30:09.24,1:30:10.78,ران,,0,0,0,,لم أسمع عن ذلك مطلقاً
Dialogue: 0,1:30:11.28,1:30:13.83,ران,,0,0,0,,وأبي يبدو على غير عادته
Dialogue: 0,1:30:12.67,1:30:14.93,note,,0,0,0,,{\pos(608,562)}الحمام ... القصر الملكي
Dialogue: 0,1:30:13.83,1:30:15.27,ميرا,,0,0,0,,عادته ؟
Dialogue: 0,1:30:15.34,1:30:19.29,ران,,0,0,0,,أبي المعتاد هو المحقق كوغورو النائم
Dialogue: 0,1:30:19.87,1:30:21.79,ران,,0,0,0,,يحل القضايا وهو نائم
Dialogue: 0,1:30:22.25,1:30:24.25,note,,0,0,0,,{\pos(612,574)}كوغورو النائم
Dialogue: 0,1:30:22.25,1:30:24.38,ران,,0,0,0,,لا أصدق أنه يتكلم في القضية بهذه الجرأة
Dialogue: 0,1:30:24.39,1:30:26.92,لوبين,,0,0,0,,أليس هذا غريباً ؟ دوق جيرارد
Dialogue: 0,1:30:27.25,1:30:29.33,لوبين,,0,0,0,,لماذا كنت مصدوماً ؟
Dialogue: 0,1:30:30.00,1:30:31.63,ران,,0,0,0,,هل فقد عقله ؟
Dialogue: 0,1:30:31.88,1:30:33.25,كونان,,0,0,0,,لايمكنني أحتمال هذا
Dialogue: 0,1:30:33.34,1:30:33.96,لوبين,,0,0,0,,هذا
Dialogue: 0,1:30:34.00,1:30:37.75,كونان,,0,0,0,,هذه البندقية التي أُستخدمت في ذلك اليوم , صحيح ؟
Dialogue: 0,1:30:38.30,1:30:46.47,كونان,,0,0,0,,لقد جعلت كونان يطلب البندقية التي أستعملها\N الدوق جيرارد في ذلك اليوم من السيد كايل
Dialogue: 0,1:30:46.68,1:30:48.43,all,,0,0,0,,نعم , هذا صحيح
Dialogue: 0,1:30:48.93,1:30:50.01,كونان,,0,0,0,,... المقصود
Dialogue: 0,1:30:50.34,1:30:55.26,كونان,,0,0,0,,أنك ذهبت إلى الصيد دون أن تعلم بأن الرصاصات فارغة
Dialogue: 0,1:30:56.01,1:31:02.22,كونان,,0,0,0,,الملكة ساكورا لم تتقبل فكرة قتل الحيوانات كرياضة
Dialogue: 0,1:31:02.85,1:31:06.48,كونان,,0,0,0,,هي لم تتمنى بأن يفعل الأمير أمراً كهذا
Dialogue: 0,1:31:07.43,1:31:12.10,كونان,,0,0,0,,ولهذا الملكة قامت بوضع طلقات فارغة للأمير جيل
Dialogue: 0,1:31:12.44,1:31:13.15,ميرا,,0,0,0,,... أمي
Dialogue: 0,1:31:13.81,1:31:19.48,كونان,,0,0,0,,وهذا كله ذُكر في ملفات السيد كايل بالتفصيل
Dialogue: 0,1:31:19.78,1:31:25.82,all,,0,0,0,,لكني لا أصدق أن ملكة لديها كل هذا العلم بالأسلحة
Dialogue: 0,1:31:26.28,1:31:27.45,لوبين,,0,0,0,,. هذا سؤال جيد
Dialogue: 0,1:31:27.70,1:31:28.99,كونان,,0,0,0,, اخرس
Dialogue: 0,1:31:29.53,1:31:30.53,لوبين,,0,0,0,,حسناً
Dialogue: 0,1:31:31.25,1:31:33.74,كونان,,0,0,0,,الجوائز التي في غرفة الملكة ساكورا
Dialogue: 0,1:31:34.53,1:31:36.91,كونان,,0,0,0,,أظهرت بأنها جيدة بالألعاب الرياضية
Dialogue: 0,1:31:37.46,1:31:41.58,كونان,,0,0,0,,يبدو أنها ربحت كل جولات الخماسي في صغرها
Dialogue: 0,1:31:42.30,1:31:44.29,كونان,,0,0,0,,بكل الرياضات الخمسة و هي
Dialogue: 0,1:31:44.47,1:31:48.66,كونان,,0,0,0,,ركوب الخيل , السباحة , الجري , المبارزة
Dialogue: 0,1:31:49.00,1:31:51.96,كونان,,0,0,0,,بالإضافة إلي ... إطلاق النار
Dialogue: 0,1:31:52.79,1:31:58.67,كونان,,0,0,0,,لاحظت أيضاً أنك فزت بكأس أيها الدوق , صحيح ؟
Dialogue: 0,1:31:59.31,1:32:03.67,كونان,,0,0,0,,... أثناء مسابقة الرماية منذ ثلاث سنوات\N... إنه حقاً عظيم أن
Dialogue: 0,1:32:03.67,1:32:05.26,all,,0,0,0,,هذا يكفي أيها المحقق
Dialogue: 0,1:32:05.92,1:32:09.80,all,,0,0,0,,أن كنت أنا المذنب إذاً لماذا لم أُزل كل الآدلة ؟
Dialogue: 0,1:32:10.38,1:32:13.43,all,,0,0,0,,وأظهر هنا هكذا ؟
Dialogue: 0,1:32:14.33,1:32:16.01,لوبين,,0,0,0,,أنا سوف أجيب عن هذا
Dialogue: 0,1:32:16.89,1:32:19.72,لوبين,,0,0,0,,لكي تُزيل الحاجز الأخير
Dialogue: 0,1:32:20.56,1:32:22.39,all,,0,0,0,,كما هو متوقع من المحقق المشهور
Dialogue: 0,1:32:23.27,1:32:25.81,all,,0,0,0,,أنت هو الحاجز الأخير
Dialogue: 0,1:32:29.31,1:32:30.60,لوبين,,0,0,0,,أليس ذلك سيئاً ؟
Dialogue: 0,1:32:30.89,1:32:32.60,لوبين,,0,0,0,,ماذا ستفعل الآن ؟
Dialogue: 0,1:32:34.60,1:32:37.06,all,,0,0,0,,أوه , يبدو أن هذا كل شئ
Dialogue: 0,1:32:37.38,1:32:38.61,all,,0,0,0,,هل هذه النهاية ؟
Dialogue: 0,1:32:38.94,1:32:39.69,all,,0,0,0,,. ممل
Dialogue: 0,1:32:40.29,1:32:43.29,all,,0,0,0,,حسناً , أنهم ضعفاء قليلاً ليواجهوننا
Dialogue: 0,1:32:44.07,1:32:45.53,لوبين,,0,0,0,,سأترك الأمر لك
Dialogue: 0,1:32:45.94,1:32:46.57,كيث,,0,0,0,,حرس
Dialogue: 0,1:32:48.57,1:32:49.45,all,,0,0,0,,كيث
Dialogue: 0,1:32:50.74,1:32:55.36,all,,0,0,0,,لا يوجد جندي واحد في هذا القصر يستمع لك
Dialogue: 0,1:32:56.57,1:32:59.47,لوبين,,0,0,0,,لقد قلت أنك مستعد لهذا الموقف , أليس كذلك ؟
Dialogue: 0,1:32:59.87,1:33:02.16,لوبين,,0,0,0,,!أحسنت , أيها الغبي
Dialogue: 0,1:33:02.70,1:33:04.83,all,,0,0,0,,ماذا عن هذا ؟
Dialogue: 0,1:33:05.04,1:33:06.04,all,,0,0,0,,! لاتتحركوا
Dialogue: 0,1:33:07.25,1:33:11.04,all,,0,0,0,,لقد قمت بتجهيز مفاجأة لكم على العمود الرئيسي
Dialogue: 0,1:33:11.35,1:33:15.25,all,,0,0,0,,ستقوم بإرسال الجميع إلى الملكة
Dialogue: 0,1:33:15.49,1:33:17.00,لوبين,,0,0,0,,!و ماذا عنك ؟
Dialogue: 0,1:33:17.32,1:33:18.75,لوبين,,0,0,0,,ستنفجر معنا ؟
Dialogue: 0,1:33:19.39,1:33:21.00,all,,0,0,0,,من هذه المسافة
Dialogue: 0,1:33:21.40,1:33:23.30,all,,0,0,0,,سأفعلها , أن كنت مهملاً
Dialogue: 0,1:33:23.59,1:33:25.50,all,,0,0,0,,لذا لاتجعلني أضطر لفعلها
Dialogue: 0,1:33:26.76,1:33:28.30,all,,0,0,0,,وأخيراً , الفرصة الأخيرة
Dialogue: 0,1:33:29.17,1:33:30.01,all,,0,0,0,,كيث
Dialogue: 0,1:33:30.80,1:33:32.05,all,,0,0,0,,أنها لك
Dialogue: 0,1:33:33.27,1:33:34.34,all,,0,0,0,,هذه فيسبانيا
Dialogue: 0,1:33:35.47,1:33:37.76,all,,0,0,0,,لنصنع لها مستقبلاً عظيماً معاً
Dialogue: 0,1:33:38.72,1:33:40.05,all,,0,0,0,,الكونت لقب لا قيمة له
Dialogue: 0,1:33:41.01,1:33:43.72,all,,0,0,0,,هل تشعر بالسعادة و أنت كالخادم في هذا المكان ؟
Dialogue: 0,1:33:44.81,1:33:49.35,all,,0,0,0,,هل من الممكن أن الدم الذي يتدفق بك , سيسمح بضياع هذه الفرصه ؟
Dialogue: 0,1:33:50.39,1:33:53.56,all,,0,0,0,,ستصبح بمأمن , و كايل أيضاً معنا
Dialogue: 0,1:33:54.60,1:33:59.52,all,,0,0,0,,اليس الرجل يفترض عليه أن يقوم بتحويل الأحلام لحقيقة للعالم كهدفً له ؟
Dialogue: 0,1:34:00.15,1:34:02.61,all,,0,0,0,,... هذا من أجل شعب هذه البلاد
Dialogue: 0,1:34:03.19,1:34:07.23,all,,0,0,0,,الآن , فيسبانيا علي شفة امتلاك القوة
Dialogue: 0,1:34:07.94,1:34:09.57,all,,0,0,0,,طاقة جديدة
Dialogue: 0,1:34:10.03,1:34:12.78,all,,0,0,0,,العالم يحتاج للقوة الغير محدودة
Dialogue: 0,1:34:15.74,1:34:16.61,ميرا,,0,0,0,,كيث
Dialogue: 0,1:34:17.66,1:34:18.70,all,,0,0,0,,كونت كيث
Dialogue: 0,1:34:20.39,1:34:23.99,كيث,,0,0,0,,عائلة ستينغر كانت تخدم العائلة المالكة لـ 200 عام
Dialogue: 0,1:34:24.49,1:34:26.70,كيث,,0,0,0,,دمائهم تجري بي
Dialogue: 0,1:34:31.75,1:34:34.43,كيث,,0,0,0,,كل نقطة به مخلصة للعائلة المالكة حتي النهاية
Dialogue: 0,1:34:36.04,1:34:37.37,لوبين,,0,0,0,,قرر إذاً
Dialogue: 0,1:34:40.88,1:34:42.41,لوبين,,0,0,0,,!ماهذا ؟
Dialogue: 0,1:34:42.41,1:34:44.50,all,,0,0,0,,... تتنكر وتحدث فوضى
Dialogue: 0,1:34:45.09,1:34:48.28,all,,0,0,0,,وتنسحب خلال الفوضى , أليس هذه العادة , لوبين ؟
Dialogue: 0,1:34:48.84,1:34:50.38,لوبين,,0,0,0,,آه , إذاً كنت تعرف ؟
Dialogue: 0,1:34:50.63,1:34:53.80,all,,0,0,0,,حاول أن تتذكر شئ قلته قبل 9 دقائق و 30 ثانية مضت
Dialogue: 0,1:34:54.17,1:34:57.30,لوبين,,0,0,0,,هل يمكنني أن أتكلم قليلاً , أيها العجوز ؟
Dialogue: 0,1:34:57.80,1:35:00.46,all,,0,0,0,,لقد ناديتني بالعجوز , اليس كذلك ؟
Dialogue: 0,1:35:01.01,1:35:03.85,لوبين,,0,0,0,,!اه ... لما هذا التوقيت
Dialogue: 0,1:35:04.18,1:35:09.24,لوبين,,0,0,0,,.الرجل هناك تصرف كرجل حقيقي\Nلما تريد إفساد هذه الأجواء ؟
Dialogue: 0,1:35:09.24,1:35:13.14,all,,0,0,0,,من يهتم ؟ طالما أعتقلتك
Dialogue: 0,1:35:13.41,1:35:14.52,all,,0,0,0,,أيها الأوغاد
Dialogue: 0,1:35:14.77,1:35:18.56,ميرا,,0,0,0,,هل قمت حقاً , بقتل والدتي ؟
Dialogue: 0,1:35:19.06,1:35:22.77,all,,0,0,0,,نعم , لم أستطع أعطاء هذه البلاد إلى أختي
Dialogue: 0,1:35:23.28,1:35:26.28,all,,0,0,0,,أن تمت الموافقة على أستخراج المعادن
Dialogue: 0,1:35:26.32,1:35:29.32,all,,0,0,0,,بيئة فيسبانيا سوف تكون ملوثة
Dialogue: 0,1:35:29.57,1:35:30.78,all,,0,0,0,,أنتِ لاتفهمين
Dialogue: 0,1:35:31.11,1:35:33.82,all,,0,0,0,,قيمة هذه البلاد ستتأخر
Dialogue: 0,1:35:34.15,1:35:36.46,all,,0,0,0,,!الشخص الذي لايفهم هو أنت
Dialogue: 0,1:35:36.61,1:35:41.86,all,,0,0,0,,من أجل كسب الربح , سنفقد الكنوز التي لاتعوض
Dialogue: 0,1:35:42.37,1:35:44.49,all,,0,0,0,,! نظرتك للمستقبل قصيرة
Dialogue: 0,1:35:44.95,1:35:49.66,all,,0,0,0,,! الكثير من البشر الذين يعتمدون على الأرض يحاولون تدميرها
Dialogue: 0,1:35:50.41,1:35:52.83,all,,0,0,0,,!حتى أنت لاتستطيع فهم ذلك ؟
Dialogue: 0,1:35:54.33,1:35:58.33,all,,0,0,0,, ...الحاكم بلا طموح لا يصلح للحكم
Dialogue: 0,1:35:59.04,1:36:02.62,all,,0,0,0,,سيكون الحال نفسه حتى و إن ورثه الأطفال
Dialogue: 0,1:36:02.83,1:36:06.26,ميرا,,0,0,0,,... هذا يعني , أخي وأنا
Dialogue: 0,1:36:07.00,1:36:08.38,all,,0,0,0,,يالها من خسارة يا كيث
Dialogue: 0,1:36:09.26,1:36:12.84,all,,0,0,0,,لكن في النهاية سأمنحك رغبتك
Dialogue: 0,1:36:15.05,1:36:17.40,فوجي,,0,0,0,,لقد ضغطت على الزر
Dialogue: 0,1:36:17.54,1:36:18.79,لوبين,,0,0,0,,حسناً إذاً
Dialogue: 0,1:36:20.59,1:36:22.68,لوبين,,0,0,0,,أمسكته , أسحب بقوة يا عجوز
Dialogue: 0,1:36:22.80,1:36:23.80,all,,0,0,0,,!ماذا ؟
Dialogue: 0,1:36:24.18,1:36:25.30,all,,0,0,0,,! دوق جيرارد
Dialogue: 0,1:36:25.51,1:36:26.01,كيث,,0,0,0,,! كايل
Dialogue: 0,1:36:26.09,1:36:26.64,all,,0,0,0,,! حسناً
Dialogue: 0,1:36:31.01,1:36:32.06,ميرا,,0,0,0,,!.. مينيكو
Dialogue: 0,1:36:32.18,1:36:34.18,فوجي,,0,0,0,,! رائعة حقاً هذه الكرة
Dialogue: 0,1:36:38.85,1:36:40.77,ميرا,,0,0,0,,لن أناديك بـ خالي مرةً أخرى
Dialogue: 0,1:36:41.60,1:36:46.65,ميرا,,0,0,0,,فعل شيءً كهذا بأختك وأبنها
Dialogue: 0,1:36:50.82,1:36:54.24,ميرا,,0,0,0,,أنا لن أسامحك أبداً
Dialogue: 0,1:36:57.31,1:37:00.31,ميرا,,0,0,0,,لن أدع هذه البلاد تحت يدك أبداً
Dialogue: 0,1:37:02.35,1:37:04.03,ميرا,,0,0,0,,... حاكمة هذه البلاد
Dialogue: 0,1:37:05.49,1:37:06.62,ميرا,,0,0,0,,! هي أنا
Dialogue: 0,1:37:12.19,1:37:13.91,all,,0,0,0,,الأميرة ميرا
Dialogue: 0,1:37:17.43,1:37:19.33,كونان,,0,0,0,, صاحبة الدراجة
Dialogue: 0,1:37:19.54,1:37:22.21,كونان,,0,0,0,, كم من الوقت تدوم هذه ؟
Dialogue: 0,1:37:24.48,1:37:25.98,كونان,,0,0,0,,!أعتقد أنهم 3 ثواني فقط
Dialogue: 0,1:37:25.98,1:37:27.38,لوبين,,0,0,0,,! أهربوااا
Dialogue: 0,1:37:34.41,1:37:38.20,note,,0,0,0,,{\pos(666,216)}جيرارد و ثلاث حراس إصابات بليغة\Nو أثنان أخرون إصابات عادية
Dialogue: 0,1:37:44.21,1:37:46.33,note,,0,0,0,,{\pos(628,422)}في الصباح التالي
Dialogue: 0,1:37:43.47,1:37:46.09,لوبين,,0,0,0,,لقد قابلت أمكِ هنا
Dialogue: 0,1:37:46.68,1:37:50.10,all,,0,0,0,,أرجوك , خُذني مع هذا التاج أيضاً
Dialogue: 0,1:37:50.68,1:37:54.22,all,,0,0,0,,لاأريد أن أكون طائراً عالقاً في قفص \N يحلم بالطيران بحريةً في السماء
Dialogue: 0,1:37:55.24,1:37:57.56,لوبين,,0,0,0,,هذا شئ لا أستطيع فعله
Dialogue: 0,1:37:58.10,1:37:59.10,all,,0,0,0,,!لماذا ؟
Dialogue: 0,1:37:59.56,1:38:00.43,لوبين,,0,0,0,,... أستمعي لي
Dialogue: 0,1:38:01.02,1:38:03.56,لوبين,,0,0,0,,لقد كان جدي لصاً عظيماً
Dialogue: 0,1:38:04.10,1:38:06.44,لوبين,,0,0,0,,ووالدكِ هو حاكم هذه البلاد
Dialogue: 0,1:38:07.19,1:38:10.06,لوبين,,0,0,0,,وقريباً أنتِ ستصبحين حاكمة لها
Dialogue: 0,1:38:10.69,1:38:12.02,لوبين,,0,0,0,,... أرتدي هذا التاج
Dialogue: 0,1:38:12.94,1:38:17.57,لوبين,,0,0,0,,ستحلقين بحرية بالسماء مع شعب هذه البلاد وليس معي
Dialogue: 0,1:38:17.90,1:38:18.78,all,,0,0,0,, لوبين
Dialogue: 0,1:38:19.46,1:38:20.36,لوبين,,0,0,0,,... إلى اللقاء
Dialogue: 0,1:38:21.19,1:38:24.53,لوبين,,0,0,0,,...عندما تصبح هذه البلاد جميلة بفضلك
Dialogue: 0,1:38:24.74,1:38:27.11,لوبين,,0,0,0,,سأعود لأسرق التاج يوماً ما ونتقابل ثانيةً
Dialogue: 0,1:38:32.12,1:38:34.62,لوبين,,0,0,0,,هي تماماً مثلكِ الآن
Dialogue: 0,1:38:35.16,1:38:37.08,ميرا,,0,0,0,,... أمي الجميلة والحنونة
Dialogue: 0,1:38:38.04,1:38:40.04,ميرا,,0,0,0,,كانت بالحقيقة تُشبهني
Dialogue: 0,1:38:40.62,1:38:44.08,لوبين,,0,0,0,,لقد نسيت أمر هذا الوعد منذ وقت طويل
Dialogue: 0,1:38:44.79,1:38:48.87,لوبين,,0,0,0,,لقد تذكرت ذلك بعد أن سمعت خبر وفاة الملكة
Dialogue: 0,1:38:49.29,1:38:51.58,كونان,,0,0,0,,عمي , السرقة تعتبر جريمة
Dialogue: 0,1:38:51.83,1:38:55.34,لوبين,,0,0,0,, ليس أنا , بل صاحبة الدراجة هي من سرقته
Dialogue: 0,1:38:55.59,1:38:56.96,كونان,,0,0,0,,أنتم أصدقاء , صحيح ؟
Dialogue: 0,1:38:57.33,1:39:00.33,لوبين,,0,0,0,,أنت مزعج , هل هذا جيد الآن ؟
Dialogue: 0,1:39:02.84,1:39:04.51,لوبين,,0,0,0,,ها أنا أُعيده لك
Dialogue: 0,1:39:05.55,1:39:09.01,لوبين,,0,0,0,,مازالت تبدو أفضل عليكِ
Dialogue: 0,1:39:10.51,1:39:13.60,لوبين,,0,0,0,,بالكلام عن هذا , هل أستطيع أن أسألك شيءً ما أيها الصغير ؟
Dialogue: 0,1:39:14.22,1:39:17.64,لوبين,,0,0,0,,كيف أمكنك أن تقول بأن موت الملكة ساكورا ليس حادثة ؟
Dialogue: 0,1:39:18.45,1:39:20.42,لوبين,,0,0,0,,والدك قال بأن هذا هو أستنتاجك
Dialogue: 0,1:39:20.42,1:39:23.06,لوبين,,0,0,0,,كيف علمت ذلك عندما حققت هنا ؟
Dialogue: 0,1:39:23.60,1:39:26.02,كونان,,0,0,0,,بسبب .. ذلك الغصن المكسور
Dialogue: 0,1:39:26.43,1:39:27.44,ميرا,,0,0,0,,!ذلك الغصن ؟
Dialogue: 0,1:39:28.06,1:39:32.35,كونان,,0,0,0,,الأمير جيل كان يعلم بأن والدته تحب شجرة الساكورا هذه , أليس كذلك ؟
Dialogue: 0,1:39:32.81,1:39:33.52,ميرا,,0,0,0,,أجل
Dialogue: 0,1:39:34.31,1:39:39.19,كونان,,0,0,0,,أن كان هكذا , فأنه لن يفكر بإصابة هذه الشجرة المهمة أبداً
Dialogue: 0,1:39:39.90,1:39:43.82,لوبين,,0,0,0,,فهمت , لهذا الأمير جيل لم يكن المطلق للرصاصة
Dialogue: 0,1:39:44.49,1:39:48.15,كونان,,0,0,0,,شجرة الساكورا .. هي من أخبرتني بذلك
Dialogue: 0,1:39:51.49,1:39:54.49,كونان,,0,0,0,,آه صحيح , هل يمكنني أن أسألك سؤالاً أيضاً ؟
Dialogue: 0,1:39:54.70,1:39:55.49,لوبين,,0,0,0,,هاه ؟
Dialogue: 0,1:39:55.78,1:39:59.41,كونان,,0,0,0,,لم أعرف أسمك إلى الآن
Dialogue: 0,1:40:01.41,1:40:02.79,لوبين,,0,0,0,,هكذا إذاً ؟
Dialogue: 0,1:40:03.58,1:40:04.75,لوبين,,0,0,0,,... أسمي هو
Dialogue: 0,1:40:05.54,1:40:07.33,لوبين,,0,0,0,,لوبين .. الثالث
Dialogue: 0,1:40:20.55,1:40:23.34,all,,0,0,0,,هل من الجيد أن أبقى الأمر سراً عن المفتش زينيجاتا ؟
Dialogue: 0,1:40:23.96,1:40:27.55,كيث,,0,0,0,,أنها أوامر الملكة .. لايمكننا معارضة ذلك
Dialogue: 0,1:40:37.60,1:40:42.76,all,,0,0,0,,!اللعنة ! أن وجدته مجدداً , سأمسكة بدون شك
Dialogue: 0,1:40:42.89,1:40:46.73,ران,,0,0,0,,لكن , أليس هذا جيداً , الأشرار قد أخذوا جزائهم
Dialogue: 0,1:40:46.85,1:40:48.06,all,,0,0,0,,! لوبين
Dialogue: 0,1:40:48.14,1:40:49.60,ران,,0,0,0,,! ليس جميعهم
Dialogue: 0,1:40:58.69,1:41:02.07,ميرا,,0,0,0,, لقد غادرو مسبقاً
Dialogue: 0,1:41:02.23,1:41:03.32,كيث,,0,0,0,,هكذا إذاً ؟
Dialogue: 0,1:41:04.03,1:41:08.15,ميرا,,0,0,0,,في يومً ما ... سوف أحتاج لأجعله يأتي و يسرق التاج الملكي مجدداً
Dialogue: 0,1:41:10.11,1:41:14.07,ميرا,,0,0,0,,أن لم تصبح هذه البلاد جميلة وأمنة بلا شك
Dialogue: 0,1:41:14.66,1:41:17.07,ميرا,,0,0,0,,فأنه سيعود
Dialogue: 0,1:41:26.58,1:41:31.83,ميرا,,0,0,0,,أنا ممتنة جداً , شكراً جزيلاً لكِ
Dialogue: 0,1:41:32.21,1:41:36.33,ميرا,,0,0,0,,ران لقد كنت سعيدة جداً تلك الليلة , والفضل يعود لكِ
Dialogue: 0,1:41:36.46,1:41:39.46,ران,,0,0,0,,... لا على الأطلاق , بالحقيقة يمكنني أن أكون أميرة لفترة
Dialogue: 0,1:41:39.75,1:41:41.96,all,,0,0,0,,... أميرة ميرا , لقد حان الوقت
Dialogue: 0,1:41:42.21,1:41:44.05,all,,0,0,0,,!آه , أين كونان ؟
Dialogue: 0,1:41:44.17,1:41:47.36,ران,,0,0,0,,آه , الآن قال بأنه يريد أن يشاهد مراسم التتويج
Dialogue: 0,1:41:47.63,1:41:51.26,كيث,,0,0,0,,قبل قليل , قد أخذته السفارة اليابانية
Dialogue: 0,1:41:51.55,1:41:54.34,كيث,,0,0,0,,مهما كان الوضع , فلقد دخل البلاد بصوره غير شرعية
Dialogue: 0,1:41:54.43,1:41:55.59,all,,0,0,0,,أصبت بذلك
Dialogue: 0,1:41:56.01,1:41:58.59,all,,0,0,0,,إذاً , يجب علينا الذهب أيضاً
Dialogue: 0,1:42:00.05,1:42:01.51,لوبين,,0,0,0,,الفتى معي , لوبين الثالث
Dialogue: 0,1:42:01.55,1:42:03.01,all,,0,0,0,,!ماذا ؟
Dialogue: 0,1:42:01.55,1:42:03.01,ران,,0,0,0,,!ماذا ؟
Dialogue: 0,1:42:03.35,1:42:05.01,ميرا,,0,0,0,,آه , ياللآسف
Dialogue: 0,1:42:13.31,1:42:14.06,كونان,,0,0,0,,هذا سيء
Dialogue: 0,1:42:14.64,1:42:19.48,كونان,,0,0,0,,... أن تحققوا من جوازي  .. فأنهم سيعلمون بإن كونان إيدوغاوا ليس له وجود
Dialogue: 0,1:42:20.15,1:42:23.73,لوبين,,0,0,0,,واضح أن المحقق البارع بدأ يستسلم , أليس كذلك ؟
Dialogue: 0,1:42:24.40,1:42:26.82,كونان,,0,0,0,,آه ! عمـ .. لوبين ؟
Dialogue: 0,1:42:27.27,1:42:30.27,كونان,,0,0,0,,لاتنحرج  , فقط نادني بـ عمي
Dialogue: 0,1:42:31.15,1:42:33.44,all,,0,0,0,,لم نتنكر منذ فترة طويلة
Dialogue: 0,1:42:33.57,1:42:35.03,فوجي,,0,0,0,,ألم تنتبة لذلك ؟
Dialogue: 0,1:42:35.11,1:42:36.48,كونان,,0,0,0,,! فتاة الدراجة
Dialogue: 0,1:42:36.48,1:42:38.35,كونان,,0,0,0,,! وأيضاً أبي
Dialogue: 0,1:42:38.53,1:42:40.57,all,,0,0,0,,ماذا قلت لك عن منادتي بـ أبي ؟
Dialogue: 0,1:42:40.62,1:42:41.87,كونان,,0,0,0,,! ذقنك توخذني
Dialogue: 0,1:42:42.07,1:42:44.12,all,,0,0,0,,مهما نظرت للأمر , فهو لايزال طفلاً
Dialogue: 0,1:42:45.20,1:42:48.45,لوبين,,0,0,0,,وأيضاً في داخل هذا المظهر اللطيف طالب في المرحلة الثانوية
Dialogue: 0,1:42:48.54,1:42:49.54,كونان,,0,0,0,,... ما
Dialogue: 0,1:42:49.87,1:42:53.04,فوجي,,0,0,0,,أنت تشعر بالأزعاج لأنك تحولت لطفل , صحيح ؟
Dialogue: 0,1:42:53.91,1:42:55.46,all,,0,0,0,,هل هذا فلمً للكبار ؟
Dialogue: 0,1:42:55.47,1:42:57.79,فوجي,,0,0,0,,ليس فلمً للكبار يا قديم الصيحة
Dialogue: 0,1:42:58.62,1:43:04.34,لوبين,,0,0,0,,آه , دوري الآن , لدي الذكاء , وأيضاً جسم شخصاً بالغ
Dialogue: 0,1:43:05.28,1:43:07.05,لوبين,,0,0,0,,! مؤلم
Dialogue: 0,1:43:07.13,1:43:08.71,all,,0,0,0,,بالنهاية فهو فلمً للكبار
Dialogue: 0,1:43:09.13,1:43:14.63,لوبين,,0,0,0,,لاتقلق , هذه الفتاة سترسلك إلى اليابان , يا سينشي كودو
Dialogue: 0,1:43:15.29,1:43:17.68,فوجي,,0,0,0,,سفينتها تقع في مكان قريب من هنا
Dialogue: 0,1:43:18.29,1:43:19.05,كونان,,0,0,0,,... شكراً
Dialogue: 0,1:43:20.14,1:43:20.80,كونان,,0,0,0,,... لكن
Dialogue: 0,1:43:21.22,1:43:24.85,كونان,,0,0,0,,أن سرقتم مجدداً , فسأمسك بكم جميعاً
Dialogue: 0,1:43:30.35,1:43:33.14,note,,0,0,0,,{\pos(634,588)}سفينة صديق
Dialogue: 0,1:43:36.44,1:43:37.52,all,,0,0,0,,ماذا ستفعل لوبين ؟
Dialogue: 0,1:43:37.69,1:43:39.94,all,,0,0,0,,يقول بأنه سيمسك بنا
Dialogue: 0,1:43:41.35,1:43:42.77,لوبين,,0,0,0,,! لاتكن غبياً
Dialogue: 0,1:43:43.90,1:43:47.77,note,,0,0,0,,{\frz10.14\pos(934,321)}Menu\NSlide show\NFavourite\NDelete
Dialogue: 0,1:43:44.94,1:43:46.52,لوبين,,0,0,0,,المحقق كونان ؟
Dialogue: 0,1:43:49.00,1:43:50.82,note,,0,0,0,,{\frz18.61\fscx195\fscy206\pos(674,311)}SAVED
Dialogue: 0,1:43:51.69,1:43:55.74,فوجي,,0,0,0,,هيا , لدي بعض الوقت , دعني أتأكد منك
Dialogue: 0,1:43:55.99,1:43:56.78,كونان,,0,0,0,,هاه ؟ ماذا .. ماذا ؟
Dialogue: 0,1:43:56.90,1:44:00.86,فوجي,,0,0,0,,مازلت تسأل ؟ أقصد سر التجديد بالطبع
Dialogue: 0,1:44:01.23,1:44:03.37,كونان,,0,0,0,,التجديد ؟ تعنين الأنكماش ؟
Dialogue: 0,1:44:03.37,1:44:05.47,فوجي,,0,0,0,,أنه هو بكلتا الحالتين
Dialogue: 0,1:44:07.47,1:44:10.47,كونان,,0,0,0,,هلا توقفتي عن فحصي ؟
Dialogue: 0,1:44:11.47,1:44:15.47,note,,0,0,0,,{\pos(1062,521)}النهاية
