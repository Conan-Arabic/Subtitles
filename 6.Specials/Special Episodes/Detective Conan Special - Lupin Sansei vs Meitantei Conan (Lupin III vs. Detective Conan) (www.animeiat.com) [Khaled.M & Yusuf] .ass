Dialogue: 0,0:45:20.71,0:45:22.04,all,,0000,0000,0000,,! يالهُ من عار
Dialogue: 0,0:45:22.53,0:45:24.00,لوبين,,0000,0000,0000,,كـ لص لايجب أن تقول ذلك
Dialogue: 0,0:45:24.75,0:45:28.19,لوبين,,0000,0000,0000,,أشكر الله لأن هذه الصخره لم توجد في البلاد التي في حالة حرب
Dialogue: 0,0:45:28.86,0:45:32.23,لوبين,,0000,0000,0000,,... فأن بلاد فيسبانيا فيها السلام والطبيعة
Dialogue: 0,0:45:33.46,0:45:36.44,لوبين,,0000,0000,0000,,!مالأمر ؟! لماذا تصرخ ؟
Dialogue: 0,0:45:37.94,0:45:40.40,لوبين,,0000,0000,0000,,!لماذا تقوم بتغطية وجهك الآن ؟
Dialogue: 0,0:45:44.82,0:45:45.72,all,,0000,0000,0000,,! رائع
Dialogue: 0,0:45:46.21,0:45:47.86,لوبين,,0000,0000,0000,,!لماذا تقول ذلك ؟
Dialogue: 0,0:45:48.29,0:45:48.84,all,,0000,0000,0000,,... لنجري
Dialogue: 0,0:45:50.37,0:45:54.05,لوبين,,0000,0000,0000,,لماذا تجري بذالك الأتجاه ؟! أليست السيارة في الأتجاه الأخر ؟
Dialogue: 0,0:45:54.28,0:45:57.66,all,,0000,0000,0000,,! أهنالك سيارتان
Dialogue: 0,0:45:58.07,0:45:58.96,لوبين,,0000,0000,0000,,من قال ذلك ؟
Dialogue: 0,0:46:04.11,0:46:05.93,لوبين,,0000,0000,0000,,{\pos(342,471)} سيارتي الـ
Dialogue: 0,0:46:04.11,0:46:05.93,EE,,0000,0000,0000,,{\pos(271,473)}SSK
Dialogue: 0,0:46:06.31,0:46:09.20,لوبين,,0000,0000,0000,,! أشرح لي الأمر في 15 كلمة
Dialogue: 0,0:46:09.29,0:46:12.03,all,,0000,0000,0000,,... هؤلاء هم جنود الدفاع الوطنيين
Dialogue: 0,0:46:12.21,0:46:13.25,all,,0000,0000,0000,,! لنذهب
Dialogue: 0,0:46:14.84,0:46:19.23,all,,0000,0000,0000,,أنهم يهدفون للمكان الذي نهرب به من الحراس , ولن يسمحوا لنا بذلك
Dialogue: 0,0:46:19.64,0:46:22.50,all,,0000,0000,0000,,لاتدعوا العدو يصل إلى وسط المدينة
Dialogue: 0,0:46:22.67,0:46:24.87,all,,0000,0000,0000,,تعليمات المعلم جيجن ستفيدنا الآن
Dialogue: 0,0:46:24.99,0:46:26.03,all,,0000,0000,0000,,عُلم
Dialogue: 0,0:46:27.68,0:46:30.05,لوبين,,0000,0000,0000,,! لاحاجة لأستعمال ذلك ! لافائدة
Dialogue: 0,0:46:32.45,0:46:34.65,لوبين,,0000,0000,0000,,هل من الممكن أنك قد دربت القوات الجوية ؟
Dialogue: 0,0:46:38.38,0:46:43.38,all,,0000,0000,0000,,أستمع جيداً , الشخص ذو الشعار التلفزيوني يبدو غريباً
Dialogue: 0,0:46:43.90,0:46:48.29,all,,0000,0000,0000,,حسناً , الهدف يبعد حوالي 200 درجة للأصفل
Dialogue: 0,0:46:50.38,0:46:53.21,لوبين,,0000,0000,0000,,ماذا يجب أن نفعل أن متنا بهذا الأسلوب ؟
Dialogue: 0,0:46:53.44,0:46:54.02,all,,0000,0000,0000,,لنجري
Dialogue: 0,0:46:54.37,0:46:56.28,لوبين,,0000,0000,0000,,! إذاً يافتى الأرسالية أبذل جهدك
Dialogue: 0,0:46:57.25,0:46:59.02,all,,0000,0000,0000,,! لن أكون من دون فائدة
Dialogue: 0,0:47:01.41,0:47:04.95,all,,0000,0000,0000,,لاحاجة لأن ترى موقع العدو من الهيلكوبتر
Dialogue: 0,0:47:05.50,0:47:09.32,all,,0000,0000,0000,,أطلق أولاً , وأن كنت مخطئً , عندها تكون مخطئً
Dialogue: 0,0:47:10.01,0:47:11.08,all,,0000,0000,0000,,! هذا ماكان متوقع
Dialogue: 0,0:47:11.34,0:47:12.27,all,,0000,0000,0000,, محترف بشكل لايصدق
Dialogue: 0,0:47:13.34,0:47:14.55,all,,0000,0000,0000,,... هذه
Dialogue: 0,0:47:14.81,0:47:16.40,all,,0000,0000,0000,,... " هاردُ بوُيلدُ "
Dialogue: 0,0:47:26.21,0:47:28.43,لوبين,,0000,0000,0000,,ماهو الـ هاردُ بوُيلدُ ؟
Dialogue: 0,0:47:29.53,0:47:31.96,ران,,0000,0000,0000,,في هانيدا ؟ مؤتمر صحفي ؟
Dialogue: 0,0:47:32.51,0:47:33.00,كيث,,0000,0000,0000,,أجل
Dialogue: 0,0:47:33.46,0:47:35.26,كيث,,0000,0000,0000,,سوف يبدأ غدا صباحاً عند الساعة العاشرة
Dialogue: 0,0:47:35.98,0:47:38.96,كيث,,0000,0000,0000,,وبعد ذلك سوف نعود إلى بلاد فيسبانيا
Dialogue: 0,0:47:39.48,0:47:42.22,all,,0000,0000,0000,,... ماذا قلت ؟! لايمكن ذلك
Dialogue: 0,0:47:42.77,0:47:45.75,ران,,0000,0000,0000,,لا اعرف ماذا سأقول في المؤتمر الصحفي غداً؟
Dialogue: 0,0:47:46.33,0:47:47.46,كيث,,0000,0000,0000,,لاتقلقي
Dialogue: 0,0:47:48.27,0:47:49.86,كيث,,0000,0000,0000,,دعي هذا الأمر لي
Dialogue: 0,0:47:50.21,0:47:50.84,كيث,,0000,0000,0000,,... بالأضافة
Dialogue: 0,0:47:51.45,0:47:53.62,كيث,,0000,0000,0000,,نحن نرغب بأن تعود الأميرة الحقيقة إلى البلاد معنا
Dialogue: 0,0:47:55.24,0:47:58.00,ران,,0000,0000,0000,,آه , إذاً الأميرة بخير الآن ؟
Dialogue: 0,0:47:58.33,0:48:02.67,ران,,0000,0000,0000,,إذاً لست بحاجةً إلى حضور المؤتمر الصحفي غداً ؟
Dialogue: 0,0:48:03.33,0:48:04.92,كيث,,0000,0000,0000,,... السبب الحقيقي وراء المؤتمر هو
Dialogue: 0,0:48:05.39,0:48:07.82,كيث,,0000,0000,0000,,أن نعلن فقط أنكِ بديلة للأميرة
Dialogue: 0,0:48:09.61,0:48:11.46,كيث,,0000,0000,0000,, وأن الأميرة قد فُقدت في اليابان
Dialogue: 0,0:48:12.44,0:48:13.22,كيث,,0000,0000,0000,,... وأيضاً
Dialogue: 0,0:48:13.77,0:48:16.00,كيث,,0000,0000,0000,,وجود فتاة تشبهها جداً
Dialogue: 0,0:48:16.84,0:48:18.31,كيث,,0000,0000,0000,,أريد للعالم أن يعلم بهذا
Dialogue: 0,0:48:19.67,0:48:21.41,كيث,,0000,0000,0000,,سيسبب ذلك لكِ بعض المشاكل
Dialogue: 0,0:48:22.27,0:48:25.27,كيث,,0000,0000,0000,,... لكن إلى حين أن نجد الشخص المسؤول  عن هذا
Dialogue: 0,0:48:25.92,0:48:27.51,كيث,,0000,0000,0000,,هل يمكنكِ أن تساعديني ؟
Dialogue: 0,0:48:33.78,0:48:35.69,فوجي,,0000,0000,0000,,إذاً , بماذا تشعرين ؟
Dialogue: 0,0:48:36.36,0:48:40.32,ميرا,,0000,0000,0000,,شعور رائع , أنها أول مره أشعر بها بالحرية
Dialogue: 0,0:48:41.21,0:48:42.60,ميرا,,0000,0000,0000,,إلى أين سنذهب اليوم ؟
Dialogue: 0,0:48:43.08,0:48:46.29,فوجي,,0000,0000,0000,,سنذهب إلى المكان الذي يفترض عليكِ الذهاب اليه
Dialogue: 0,0:48:48.07,0:48:50.03,ميرا,,0000,0000,0000,,لا .. لن أعود
Dialogue: 0,0:48:50.58,0:48:53.30,فوجي,,0000,0000,0000,,يااللهي من قال أننا سوف نعود ؟
Dialogue: 0,0:48:53.50,0:48:55.79,فوجي,,0000,0000,0000,,على مايبدو أن ذلك المكان هو الذي ترغبين بالعوده إلية
Dialogue: 0,0:48:56.34,0:48:57.32,ميرا,,0000,0000,0000,,. لا مستحيل
Dialogue: 0,0:48:57.87,0:49:01.86,فوجي,,0000,0000,0000,,هل هنالك مكان في المدينة أنتِ متعلقة به ؟
Dialogue: 0,0:49:02.35,0:49:05.04,فوجي,,0000,0000,0000,,في هذه البلاد , هل هنالك أي شيء يمكنكِ العمل به ؟
Dialogue: 0,0:49:07.15,0:49:08.25,فوجي,,0000,0000,0000,,تريدين المجيء للبحث عنه ؟
Dialogue: 0,0:49:11.75,0:49:13.66,فوجي,,0000,0000,0000,,طالما أن هنالك شيءً يمكنكِ عمله
