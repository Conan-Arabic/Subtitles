Dialogue: 0,0:58:37.21,0:58:37.79,كيث,,0000,0000,0000,,... أجل
Dialogue: 0,0:58:38.50,0:58:43.01,كيث,,0000,0000,0000,,السبب الذي جعلني أطلبك هو أنني أعتقد بأن السيد جيرالد هو الفاعل
Dialogue: 0,0:58:44.01,0:58:47.38,all,,0000,0000,0000,,!هيه, هل أنت متأكد مما تقول ؟
Dialogue: 0,0:58:48.09,0:58:50.97,ران,,0000,0000,0000,,هل .. وجدت دليلاً ؟
Dialogue: 0,0:58:51.51,0:58:52.68,كيث,,0000,0000,0000,,لا لاشيء بعد
Dialogue: 0,0:58:53.89,0:58:57.05,كيث,,0000,0000,0000,,نحن خدم العائلة الملكية منذ أجيال
Dialogue: 0,0:58:57.68,0:58:59.06,كيث,,0000,0000,0000,,ومن ضمنهم السيد جيرالد
Dialogue: 0,0:58:59.68,0:59:02.97,all,,0000,0000,0000,,ولأنك لاتستطيع فعل شيءً بنفسك , فأنت تطلب منا ذلك ؟
Dialogue: 0,0:59:04.18,0:59:07.14,all,,0000,0000,0000,,هذه البلاد فاسدة , هاه ؟
Dialogue: 0,0:59:08.31,0:59:10.89,كيث,,0000,0000,0000,,الملكة فقط التي تطلق الأحكام على أعضاء العائلة الملكية
Dialogue: 0,0:59:11.48,0:59:14.40,كيث,,0000,0000,0000,,الأميرة ميرا لم تحصل على حقها بعد
Dialogue: 0,0:59:15.86,0:59:17.86,all,,0000,0000,0000,,أنتم مازلتم تعيشون في القرن التاسع عشر ؟
Dialogue: 0,0:59:18.40,0:59:19.27,كيث,,0000,0000,0000,,أعتمد عليكما
Dialogue: 0,0:59:19.82,0:59:21.07,كيث,,0000,0000,0000,,لم يتبقى هنالك أي وقت
Dialogue: 0,0:59:21.86,0:59:25.53,كيث,,0000,0000,0000,,الأحتفال بالتتويج بعد يومين من الآن
Dialogue: 0,0:59:25.94,0:59:30.15,ران,,0000,0000,0000,,لايمكن, أن لم تظهر الأميرة قبل ذلك
Dialogue: 0,0:59:31.07,0:59:32.78,كونان,,0000,0000,0000,,فعلى ران حضوره
Dialogue: 0,0:59:36.57,0:59:37.70,ران,,0000,0000,0000,,كونان
Dialogue: 0,0:59:39.12,0:59:41.24,all,,0000,0000,0000,,آنسة ران , رجاءً أغلقي الستار
Dialogue: 0,0:59:42.04,0:59:44.29,all,,0000,0000,0000,,نحن لانعلم من أين قد يهاجمون
Dialogue: 0,0:59:44.91,0:59:46.83,ران,,0000,0000,0000,,! لايجب عليكِ أن تناديني بـ آنسة
Dialogue: 0,0:59:47.25,0:59:48.91,ران,,0000,0000,0000,,فأنا مجرد مزيفة
Dialogue: 0,0:59:50.37,0:59:52.33,ران,,0000,0000,0000,,أنتما الاثنتان كنتما تخدمان الأميرة ميرا ؟
Dialogue: 0,0:59:52.71,0:59:55.58,all,,0000,0000,0000,,نعم, أنا خدمتها منذ أن كنت في الخامسة من عمري
Dialogue: 0,0:59:56.29,0:59:58.71,all,,0000,0000,0000,,وأنا دخلت القصر قبل ثلاث سنوات فقط
Dialogue: 0,0:59:59.34,1:00:03.10,ران,,0000,0000,0000,,أنا لم أرى الحياة اليومية للأميرة من قبل
Dialogue: 0,1:00:03.80,1:00:06.01,ران,,0000,0000,0000,,هل كانت هكذا منذ أن كانت طفلة ؟
Dialogue: 0,1:00:08.51,1:00:10.67,all,,0000,0000,0000,,لا , لقد كانت لطيفة جداً
Dialogue: 0,1:00:10.92,1:00:11.93,all,,0000,0000,0000,,وتبكي بسهولة
Dialogue: 0,1:00:13.93,1:00:15.84,all,,0000,0000,0000,,... الأميرة ميرا, لم يسبق لها
Dialogue: 0,1:00:17.80,1:00:20.43,ران,,0000,0000,0000,,!لم .. لم يسبق لها ماذا ؟
Dialogue: 0,1:00:22.22,1:00:25.01,all,,0000,0000,0000,,لم يسبق لها .. أن بكت أمام أحد
Dialogue: 0,1:00:25.89,1:00:29.02,all,,0000,0000,0000,,حتى خسرت الشخصان اللذان أحَبتهما في وقتً واحد
Dialogue: 0,1:00:30.19,1:00:34.48,all,,0000,0000,0000,,لم تحدث للأميرة ميرا آي مأساة من قبل
Dialogue: 0,1:00:35.73,1:00:38.06,all,,0000,0000,0000,,... ياله من شيءً مؤسف
Dialogue: 0,1:00:40.11,1:00:42.19,ران,,0000,0000,0000,,وليس معترف بها من الشعب
Dialogue: 0,1:00:42.65,1:00:43.57,ران,,0000,0000,0000,,... لهذا
Dialogue: 0,1:00:44.02,1:00:46.57,ران,,0000,0000,0000,,لهذا السبب صنعت لها شخصية مغايره
Dialogue: 0,1:00:50.24,1:00:53.57,كيث,,0000,0000,0000,,أنت أيضاً تشعر بالذهول لأنني أعتمدت عليهما ؟
Dialogue: 0,1:00:54.03,1:00:54.53,all,,0000,0000,0000,,. أجل
Dialogue: 0,1:00:55.36,1:00:57.07,all,,0000,0000,0000,,دعنا لا نتكلم عن المعلم جيقن
Dialogue: 0,1:00:57.28,1:00:58.78,all,,0000,0000,0000,,... لكن الفتى الصغير
Dialogue: 0,1:00:59.95,1:01:01.66,كيث,,0000,0000,0000,,! لا أعرف لماذا
Dialogue: 0,1:01:02.53,1:01:03.58,كيث,,0000,0000,0000,,... ذلك الفتى
Dialogue: 0,1:01:04.83,1:01:08.66,كيث,,0000,0000,0000,,ذلك الفتى .. لايبدو كما يظهر
Dialogue: 0,1:01:10.62,1:01:14.33,كيث,,0000,0000,0000,,لديه جسد طفل وعقل رجلاً بالغ
Dialogue: 0,1:01:18.83,1:01:21.00,لوبين,,0000,0000,0000,,فوجيكو , أنه الصباح
Dialogue: 0,1:01:21.25,1:01:22.25,فوجي,,0000,0000,0000,,! اصمت
Dialogue: 0,1:01:27.46,1:01:30.17,فوجي,,0000,0000,0000,,! لقد أصابك البرد , لاتقترب مني
Dialogue: 0,1:01:30.30,1:01:34.30,لوبين,,0000,0000,0000,,!أحسنتِ القول , خطأ من تظنين ؟
Dialogue: 0,1:01:34.67,1:01:37.30,فوجي,,0000,0000,0000,,آه لا .. أنه يضع اللوم عليكِ
Dialogue: 0,1:01:37.38,1:01:38.38,ميرا,,0000,0000,0000,,أنه الأسواء
Dialogue: 0,1:01:38.64,1:01:40.26,لوبين,,0000,0000,0000,,ليس هكذا
Dialogue: 0,1:01:40.59,1:01:44.47,فوجي,,0000,0000,0000,,!ذلك الجانب , هل يمكنك الأسراع قليلاً ؟
Dialogue: 0,1:01:44.55,1:01:45.89,لوبين,,0000,0000,0000,,هذه السرعه القصوى
Dialogue: 0,1:01:46.22,1:01:47.89,فوجي,,0000,0000,0000,,أين المعتادة ؟
Dialogue: 0,1:01:48.06,1:01:50.47,لوبين,,0000,0000,0000,,كلهما لن تكونان هنا مجدداً
Dialogue: 0,1:01:56.23,1:01:59.31,ميرا,,0000,0000,0000,,أشعر بالعطش , أشتر لي بعض الكولا
Dialogue: 0,1:01:59.48,1:02:00.44,لوبين,,0000,0000,0000,,حسناً
Dialogue: 0,1:02:00.69,1:02:02.19,فوجي,,0000,0000,0000,,وأنا أريد قهوة مثلجة
Dialogue: 0,1:02:02.36,1:02:03.36,لوبين,,0000,0000,0000,,حسناً , حسناً
Dialogue: 0,1:02:03.48,1:02:04.40,فوجي,,0000,0000,0000,,إجابة واحده تكفي
Dialogue: 0,1:02:05.02,1:02:06.32,لوبين,,0000,0000,0000,,اللعنة
Dialogue: 0,1:02:09.44,1:02:12.99,كونان,,0000,0000,0000,,الأطول بناية في طريق الاحتفال هي هذه
Dialogue: 0,1:02:13.82,1:02:14.69,كونان,,0000,0000,0000,,هيه , بابا
Dialogue: 0,1:02:15.15,1:02:16.82,كونان,,0000,0000,0000,,بابا أن كنت أنت من أين ستطلق ؟
Dialogue: 0,1:02:17.11,1:02:18.78,كونان,,0000,0000,0000,,مؤكد من على البناية الأطول
Dialogue: 0,1:02:19.36,1:02:20.99,all,,0000,0000,0000,,لاتبالغ
Dialogue: 0,1:02:21.45,1:02:22.07,all,,0000,0000,0000,,انزل
Dialogue: 0,1:02:24.53,1:02:25.78,all,,0000,0000,0000,,ماذا تريد أن تعرف ؟
Dialogue: 0,1:02:26.16,1:02:26.78,كونان,,0000,0000,0000,,بخيل
Dialogue: 0,1:02:27.37,1:02:28.99,كونان,,0000,0000,0000,,هيه , أجبني ؟
Dialogue: 0,1:02:29.16,1:02:31.45,كونان,,0000,0000,0000,,سيكون من السهل الهرب من تلك البناية
Dialogue: 0,1:02:33.58,1:02:34.50,كونان,,0000,0000,0000,,أنتظر
Dialogue: 0,1:02:35.12,1:02:36.62,all,,0000,0000,0000,,! أنا لست قاتلاً محترفاً
Dialogue: 0,1:02:37.50,1:02:40.04,all,,0000,0000,0000,,لا أعرف أي مكان هو الأفضل
Dialogue: 0,1:02:40.29,1:02:42.92,كونان,,0000,0000,0000,,كيف لـ بابا أن يكون قاتلاً محترفاً ؟
Dialogue: 0,1:02:43.63,1:02:48.55,كونان,,0000,0000,0000,,لكن بابا أين بصمة يدك السبابة
Dialogue: 0,1:02:49.30,1:02:50.09,كونان,,0000,0000,0000,,... وأيضاً
Dialogue: 0,1:02:50.71,1:02:54.34,كونان,,0000,0000,0000,,يدك معتادة على تغيير أسطوانة المسدس , أليس كذالك ؟
Dialogue: 0,1:02:56.01,1:02:56.88,all,,0000,0000,0000,,!متى رأيتها ؟
Dialogue: 0,1:02:57.26,1:03:00.34,all,,0000,0000,0000,,. كانت يدي في جيبي طوال الوقت
Dialogue: 0,1:03:00.72,1:03:02.84,كونان,,0000,0000,0000,,لقد رأيتهم عندما كنا في القصر
Dialogue: 0,1:03:03.59,1:03:04.47,all,,0000,0000,0000,,هيه أيها الفتى
Dialogue: 0,1:03:05.72,1:03:07.51,all,,0000,0000,0000,,لدي شيءً واحداً لأقوله
Dialogue: 0,1:03:08.89,1:03:10.76,all,,0000,0000,0000,,! لا تقل لي بابا مجدداً
Dialogue: 0,1:03:12.18,1:03:15.29,كونان,,0000,0000,0000,,لاأستطيع , مازلنا في فترة الظهيرة
Dialogue: 0,1:03:15.60,1:03:18.06,كونان,,0000,0000,0000,,ونحن مازلنا بحاجة للذهاب لمكان الحادثة
Dialogue: 0,1:03:18.69,1:03:20.06,all,,0000,0000,0000,,هذه ليست غلطتي
Dialogue: 0,1:03:20.39,1:03:22.77,all,,0000,0000,0000,,هذه غلطت المتاجر التي تفتح أبوابها في هذا الوقت
Dialogue: 0,1:03:23.27,1:03:25.48,كونان,,0000,0000,0000,,طريقة سهلة الفهم للأسترخاء
Dialogue: 0,1:03:26.11,1:03:27.94,all,,0000,0000,0000,,لاتقلق , مجرد كوباً واحداً
Dialogue: 0,1:03:28.52,1:03:28.98,all,,0000,0000,0000,,خذ
Dialogue: 0,1:03:29.73,1:03:31.61,all,,0000,0000,0000,,حوالي 500 ين ياباني
Dialogue: 0,1:03:31.86,1:03:33.94,all,,0000,0000,0000,,أذهب واشتر لنفسك عصيراً  من المكينة التي خلفنا
Dialogue: 0,1:03:34.61,1:03:35.69,كونان,,0000,0000,0000,,كوباً فقط
Dialogue: 0,1:03:36.11,1:03:39.74,لوبين,,0000,0000,0000,,يا اللهي , أميرتان
Dialogue: 0,1:03:40.11,1:03:41.61,لوبين,,0000,0000,0000,,الأولى ترغب في الكولا
Dialogue: 0,1:03:44.82,1:03:46.66,لوبين,,0000,0000,0000,,! ماذا , هيه كولا
Dialogue: 0,1:03:47.66,1:03:48.74,لوبين,,0000,0000,0000,,أخرج أيها الكولا
Dialogue: 0,1:03:49.33,1:03:52.12,لوبين,,0000,0000,0000,,والمال لن يخرج ايضاً, ماهذا ؟
Dialogue: 0,1:03:52.87,1:03:53.91,لوبين,,0000,0000,0000,,! اها عرفت
Dialogue: 0,1:03:54.24,1:03:55.79,لوبين,,0000,0000,0000,,إذاً هذا ماتريد
Dialogue: 0,1:03:56.95,1:04:00.27,لوبين,,0000,0000,0000,,سوف أستخدم حركتي القاضية , راقبني
Dialogue: 0,1:04:05.79,1:04:08.79,لوبين,,0000,0000,0000,,حصلت على بعض الفكة ايضاً
Dialogue: 0,1:04:09.00,1:04:11.00,كونان,,0000,0000,0000,,عمي السرقة ليست جيدة
Dialogue: 0,1:04:12.38,1:04:14.13,لوبين,,0000,0000,0000,,تلك طريقةً سيئة لوصف ذلك
Dialogue: 0,1:04:14.71,1:04:16.51,لوبين,,0000,0000,0000,,لقد دفعت , أليس كذالك ؟
Dialogue: 0,1:04:16.59,1:04:17.55,كونان,,0000,0000,0000,,القليل فقط
Dialogue: 0,1:04:17.71,1:04:20.92,لوبين,,0000,0000,0000,,لابأس , أنهم يطلبون مني أن أخذ أكثر
Dialogue: 0,1:04:21.13,1:04:22.80,كونان,,0000,0000,0000,,أنت حقاً شخصاً سيء ؟
Dialogue: 0,1:04:23.38,1:04:25.68,كونان,,0000,0000,0000,,عمي أنت لاتبدو سيئً
Dialogue: 0,1:04:25.89,1:04:29.80,لوبين,,0000,0000,0000,,راقب ذلك , أنا لصاً سيء
Dialogue: 0,1:04:29.97,1:04:33.97,كونان,,0000,0000,0000,,فهمت , عمي لهذا لديك قراب مسدس , صحيح ؟
Dialogue: 0,1:04:35.52,1:04:38.39,كونان,,0000,0000,0000,,كتفك الأيسر أوطئ قليلاً من ذلك
Dialogue: 0,1:04:39.68,1:04:41.06,لوبين,,0000,0000,0000,,أبتسم
Dialogue: 0,1:04:42.39,1:04:45.35,لوبين,,0000,0000,0000,,ياللعار , أنها مجرد كاميرا فيديو
Dialogue: 0,1:04:46.56,1:04:49.90,كونان,,0000,0000,0000,,آسف , أعتقدت حقاً أنك رجلاً سيء
Dialogue: 0,1:04:50.36,1:04:51.15,كونان,,0000,0000,0000,,الحمدلله
Dialogue: 0,1:04:51.44,1:04:54.65,كونان,,0000,0000,0000,,قول شيءً مثل ذلك لشخصاً سيء سيكون خطراً
Dialogue: 0,1:04:56.82,1:04:58.57,لوبين,,0000,0000,0000,,!هيه , أنت موافق على واحد فقط ؟
Dialogue: 0,1:04:59.40,1:05:00.69,لوبين,,0000,0000,0000,,يمكنك أن تأخذ أكثر
Dialogue: 0,1:05:01.15,1:05:02.82,لوبين,,0000,0000,0000,,دعنا نكن متواطئين بذالك
Dialogue: 0,1:05:03.57,1:05:05.20,كونان,,0000,0000,0000,,ليس من الجيد أن تسرق
Dialogue: 0,1:05:08.11,1:05:12.08,لوبين,,0000,0000,0000,,ماخطبُ هذا الفتى ؟! أصدقائة سيهربون منه أن كان هكذا دوماً
Dialogue: 0,1:05:24.00,1:05:26.58,لوبين,,0000,0000,0000,,لقد دفعت لشرابين
Dialogue: 0,1:05:39.01,1:05:42.05,all,,0000,0000,0000,, مرحباً أنت من
Dialogue: 0,1:05:39.01,1:05:42.05,E,,0000,0000,0000,,{\pos(240,465)}ICPO
Dialogue: 0,1:05:42.51,1:05:44.05,all,,0000,0000,0000,,نعم , أنا زينيجاتا
Dialogue: 0,1:05:44.55,1:05:45.55,all,,0000,0000,0000,,لندخل بالموضوع مباشرةً
Dialogue: 0,1:05:45.68,1:05:48.26,all,,0000,0000,0000,,لا , لا , هذا المكان ليس مناسب
Dialogue: 0,1:05:48.59,1:05:50.68,all,,0000,0000,0000,,لنتكلم بالداخل , أتوافقني على ذلك ؟
Dialogue: 0,1:05:51.55,1:05:52.89,all,,0000,0000,0000,,وهذا يكون ؟
Dialogue: 0,1:05:53.85,1:05:55.32,all,,0000,0000,0000,,أنا مساعد المفتش زينيجاتا
Dialogue: 0,1:05:55.32,1:05:57.01,all,,0000,0000,0000,,توقو موري
Dialogue: 0,1:05:57.47,1:06:00.97,all,,0000,0000,0000,,حضرت المفتش أرغب بأخذ جولة حول المكان
Dialogue: 0,1:06:01.32,1:06:02.81,all,,0000,0000,0000,,لا داعي للعجلة
Dialogue: 0,1:06:03.10,1:06:04.52,all,,0000,0000,0000,,... قد تم اعداد الشاي
Dialogue: 0,1:06:04.53,1:06:05.77,all,,0000,0000,0000,,أنا ذاهب
Dialogue: 0,1:06:06.69,1:06:08.81,all,,0000,0000,0000,,أين أنت يالوبين
Dialogue: 0,1:06:10.40,1:06:12.81,all,,0000,0000,0000,,تستطيع أن تتجاهله
Dialogue: 0,1:06:14.40,1:06:17.37,all,,0000,0000,0000,,! لوبين! لوبين
Dialogue: 0,1:06:17.69,1:06:19.15,all,,0000,0000,0000,,! ران
Dialogue: 0,1:06:19.65,1:06:21.61,all,,0000,0000,0000,,أين أنتِ ران ؟
Dialogue: 0,1:06:22.07,1:06:23.03,ران,,0000,0000,0000,,لذيذ
Dialogue: 0,1:06:23.35,1:06:25.19,all,,0000,0000,0000,,! ران
Dialogue: 0,1:06:25.41,1:06:27.11,ران,,0000,0000,0000,,هذا الصوت .. والدي ؟
Dialogue: 0,1:06:27.35,1:06:29.35,all,,0000,0000,0000,,رجاءً انتظري آنسة ران
Dialogue: 0,1:06:29.53,1:06:31.07,all,,0000,0000,0000,,قد يكون شخصاً مريباً
Dialogue: 0,1:06:32.82,1:06:34.57,all,,0000,0000,0000,,! ران
Dialogue: 0,1:06:35.03,1:06:36.49,all,,0000,0000,0000,,شخصاً مريباً بالفعل
Dialogue: 0,1:06:36.87,1:06:38.26,all,,0000,0000,0000,,رجلاً عجوز له شوراب
Dialogue: 0,1:06:38.26,1:06:39.43,all,,0000,0000,0000,,ووجه مخيف
Dialogue: 0,1:06:39.43,1:06:42.20,all,,0000,0000,0000,,!كيف يمكن أن يكون والدكِ آنسة ران ؟
Dialogue: 0,1:06:42.41,1:06:43.54,ران,,0000,0000,0000,,أنه والدي
Dialogue: 0,1:06:45.37,1:06:47.23,all,,0000,0000,0000,,ران , الحمدلله -
Dialogue: 0,1:06:46.24,1:06:47.47,ران,,0000,0000,0000,,أبي لماذا أنت هنا -
Dialogue: 0,1:06:47.47,1:06:50.47,all,,0000,0000,0000,,! أنا مسروراً جداً -
Dialogue: 0,1:06:47.47,1:06:50.47,ران,,0000,0000,0000,,أرجوك ساعد كونان -
Dialogue: 0,1:06:51.27,1:06:52.34,كيث,,0000,0000,0000,,ماهذه الجلبة ؟
Dialogue: 0,1:06:52.34,1:06:53.34,all,,0000,0000,0000,,سيد كيث
Dialogue: 0,1:06:53.34,1:06:55.48,all,,0000,0000,0000,,... أنت أخيراً -
Dialogue: 0,1:06:54.34,1:06:55.48,ران,,0000,0000,0000,,أستمع لي أبي -
Dialogue: 0,1:06:56.31,1:06:58.25,all,,0000,0000,0000,,أنظر إلي أيها الحقير -
Dialogue: 0,1:06:56.88,1:06:58.25,ران,,0000,0000,0000,,توقف يا أبي -
Dialogue: 0,1:06:58.25,1:07:00.32,all,,0000,0000,0000,,خذ هذه -
Dialogue: 0,1:06:58.25,1:07:00.32,ران,,0000,0000,0000,,! أستمع لي -
Dialogue: 0,1:07:00.32,1:07:01.25,ران,,0000,0000,0000,,! لاتفعل
Dialogue: 0,1:07:01.25,1:07:03.28,all,,0000,0000,0000,,لا تقلقي سأكون بخير
Dialogue: 0,1:07:02.76,1:07:04.42,كيث,,0000,0000,0000,,هل يمكنك رجاءً أن توضح لي ؟
Dialogue: 0,1:07:06.29,1:07:09.29,all,,0000,0000,0000,,وهل حقاً لوبين يسعى للحصول على التاج ؟
Dialogue: 0,1:07:09.39,1:07:11.72,all,,0000,0000,0000,,نعم , لاشك بهذا
Dialogue: 0,1:07:12.19,1:07:18.33,all,,0000,0000,0000,,لكن ألم يحاول لوبين من قبل أن يسرق التاج مرةً ويأس ؟
Dialogue: 0,1:07:18.33,1:07:21.33,all,,0000,0000,0000,,حتى الآن لم ييأس عن ذلك
Dialogue: 0,1:07:21.72,1:07:23.43,all,,0000,0000,0000,,لقد فهمت الآن
Dialogue: 0,1:07:23.89,1:07:28.02,all,,0000,0000,0000,,يمكننا أن نجعل لوبين ييأس مجدداً , صحيح ؟
Dialogue: 0,1:07:28.94,1:07:31.45,all,,0000,0000,0000,,أن كان نظامنا الأمني قابل للأختراق
Dialogue: 0,1:07:31.81,1:07:33.56,all,,0000,0000,0000,,سوف أسلمهم التاج بسرور
Dialogue: 0,1:07:35.40,1:07:38.40,all,,0000,0000,0000,,لنأمل ذلك
Dialogue: 0,1:07:40.94,1:07:43.49,all,,0000,0000,0000,,الطعام جاهز في الغرفة المجاوره
Dialogue: 0,1:07:43.73,1:07:46.46,all,,0000,0000,0000,,سأتفقد الخزنة أولاً
Dialogue: 0,1:07:46.82,1:07:48.95,all,,0000,0000,0000,,ذلك الشخص هناك سيرشدك
Dialogue: 0,1:07:49.03,1:07:49.70,all,,0000,0000,0000,,شكراً لك
Dialogue: 0,1:07:54.11,1:07:56.62,all,,0000,0000,0000,,أرجو أن تقوم بتحريك الأمور من أجلي
Dialogue: 0,1:08:06.70,1:08:08.83,كيث,,0000,0000,0000,,هل فهمت أخيراً ؟
Dialogue: 0,1:08:09.32,1:08:10.54,all,,0000,0000,0000,,كيف يمكنني ؟
Dialogue: 0,1:08:11.25,1:08:16.29,ران,,0000,0000,0000,,أبي , من المستحيل على كونان أن يجد الدليل لوحده
Dialogue: 0,1:08:16.67,1:08:20.67,all,,0000,0000,0000,,لايمكننا القول إلى حد الآن أن الدوق جيرالد هو المذنب
Dialogue: 0,1:08:20.84,1:08:22.25,ران,,0000,0000,0000,,بسبب مكانته
Dialogue: 0,1:08:22.30,1:08:23.33,all,,0000,0000,0000,,أنتِ ساذجه
Dialogue: 0,1:08:23.59,1:08:26.09,all,,0000,0000,0000,,هذا مايقولونه
Dialogue: 0,1:08:26.55,1:08:28.30,all,,0000,0000,0000,,أنت دوق أيضاً , صحيح ؟
Dialogue: 0,1:08:28.51,1:08:33.13,all,,0000,0000,0000,,من المحتمل أنك تضعها على جيرالد لنفسك
Dialogue: 0,1:08:33.34,1:08:36.59,all,,0000,0000,0000,,مستحيل ! السيد كيث كان في القصر ذلك اليوم
Dialogue: 0,1:08:36.97,1:08:39.05,all,,0000,0000,0000,,لم يكن بحاجه أن يفعلها بنفسه
Dialogue: 0,1:08:39.32,1:08:42.32,all,,0000,0000,0000,,ذلك بسيط يقوم بأستخدام قناصاً محترف
Dialogue: 0,1:08:43.25,1:08:45.26,ران,,0000,0000,0000,,قناصاً محترف ؟
Dialogue: 0,1:08:47.39,1:08:48.77,E,,0000,0000,0000,,{\pos(319,399)}شخصاً مشبوه
Dialogue: 0,1:08:49.06,1:08:51.27,all,,0000,0000,0000,,كيف ذلك ؟ أي خيوط ؟
Dialogue: 0,1:08:51.85,1:08:53.39,كيث,,0000,0000,0000,,كما قلت
Dialogue: 0,1:08:54.02,1:08:57.44,كيث,,0000,0000,0000,,يمكنني أن أفهم لماذا نشأ أبنك بهذه الطريقة
Dialogue: 0,1:08:58.30,1:08:59.06,all,,0000,0000,0000,,أنه ليس أبني
Dialogue: 0,1:08:59.37,1:09:00.73,all,,0000,0000,0000,,أنه حمولة زائدة فقط
Dialogue: 0,1:09:01.27,1:09:03.52,كيث,,0000,0000,0000,,لا أرغب بأستخدام شخصاً مثلك
Dialogue: 0,1:09:04.86,1:09:07.44,كيث,,0000,0000,0000,,لتحقيق كبير
Dialogue: 0,1:09:08.61,1:09:12.07,كيث,,0000,0000,0000,,بالرغم من أنه عدداً ليس بالكثير , لكنه يحسب بالين الياباني
Dialogue: 0,1:09:15.32,1:09:17.29,كيث,,0000,0000,0000,,هل تقبل بهذا ؟
Dialogue: 0,1:09:17.29,1:09:20.29,all,,0000,0000,0000,,! سأقبل به وبسرور
Dialogue: 0,1:09:21.26,1:09:22.46,كيث,,0000,0000,0000,,... أتطلع لذلك
Dialogue: 0,1:09:22.83,1:09:24.37,ران,,0000,0000,0000,,... أبي
Dialogue: 0,1:09:34.91,1:09:38.04,لوبين,,0000,0000,0000,,بغض النظر عما حدث به ترغب برؤيته
Dialogue: 0,1:09:38.67,1:09:41.38,فوجي,,0000,0000,0000,,أنه هناك , صحيح ؟ المكان الذي ماتا به
Dialogue: 0,1:09:41.41,1:09:42.25,لوبين,,0000,0000,0000,,أجل
Dialogue: 0,1:09:43.28,1:09:45.41,فوجي,,0000,0000,0000,,هل من الجيد تركها تذهب لوحدها ؟
Dialogue: 0,1:09:45.41,1:09:47.45,فوجي,,0000,0000,0000,,أنها خبيرةً بالهرب
Dialogue: 0,1:09:47.96,1:09:50.76,لوبين,,0000,0000,0000,,أن كانت تريد الهرب , لما عادت
Dialogue: 0,1:09:51.71,1:09:55.43,لوبين,,0000,0000,0000,,وأن تبعناها , فلن تستطيع البكاء , صحيح ؟
Dialogue: 0,1:09:55.84,1:09:59.72,فوجي,,0000,0000,0000,,أنت تفهمها جيداً , هاه ؟
Dialogue: 0,1:10:00.26,1:10:01.46,فوجي,,0000,0000,0000,,سأشتبه بك
Dialogue: 0,1:10:01.46,1:10:04.30,لوبين,,0000,0000,0000,,... لا , فقط لكن
Dialogue: 0,1:10:04.30,1:10:05.14,فوجي,,0000,0000,0000,,لكن ماذا ؟
Dialogue: 0,1:10:06.40,1:10:07.89,لوبين,,0000,0000,0000,,أنها مألوفه لدي
Dialogue: 0,1:10:18.77,1:10:21.10,ميرا,,0000,0000,0000,,أمي , أخي
Dialogue: 0,1:10:22.25,1:10:24.31,ميرا,,0000,0000,0000,,لا يمكنني ألا أن أنظر إلى هنا
Dialogue: 0,1:10:26.26,1:10:28.26,ميرا,,0000,0000,0000,,لايمكنني فعل أي شيء
Dialogue: 0,1:10:28.26,1:10:30.49,ميرا,,0000,0000,0000,,حتى وأن كانت لديكِ توقعات , لافائده من ذلك
Dialogue: 0,1:10:31.32,1:10:33.49,ميرا,,0000,0000,0000,,لا أحد يحبني
Dialogue: 0,1:10:34.65,1:10:36.86,ميرا,,0000,0000,0000,,لكن .. لا مزيد من ذلك
Dialogue: 0,1:10:37.43,1:10:41.11,ميرا,,0000,0000,0000,,... ماعدا هذا المكان , حيث كلاكما
Dialogue: 0,1:10:43.87,1:10:46.70,ميرا,,0000,0000,0000,,حيث كلاكما .. هنا فقط
Dialogue: 0,1:11:02.46,1:11:05.46,all,,0000,0000,0000,,خمس دقائق أخرى
Dialogue: 0,1:11:08.43,1:11:10.43,all,,0000,0000,0000,,حتى وأن دخلت نملة
Dialogue: 0,1:11:10.71,1:11:14.21,all,,0000,0000,0000,,ستكون محاطه بمعدن فريد من نوعه
Dialogue: 0,1:11:14.44,1:11:16.92,all,,0000,0000,0000,,أنتما هنا 24 ساعة ؟
Dialogue: 0,1:11:17.17,1:11:19.47,all,,0000,0000,0000,,نعم , 8 ساعات لكل نوبة
Dialogue: 0,1:11:19.84,1:11:21.55,all,,0000,0000,0000,,هل تحتاج تعزيزاً للحراس ؟
Dialogue: 0,1:11:22.47,1:11:24.89,all,,0000,0000,0000,,لا , لاحاجة لذلك
Dialogue: 0,1:11:26.10,1:11:28.10,all,,0000,0000,0000,,سوف يغلبهم النعاس بدون معرفتهم بذلك
Dialogue: 0,1:11:31.22,1:11:34.22,all,,0000,0000,0000,,نحن مسؤولون عن الحفاظ والأعتناء بالأسلحة
Dialogue: 0,1:11:34.64,1:11:37.46,all,,0000,0000,0000,,لايمكن أدخال الأسلحة بسهولة
Dialogue: 0,1:11:38.02,1:11:42.52,all,,0000,0000,0000,,هل وجدت أية رصاصه في جسد الملكة ساكورا ؟
Dialogue: 0,1:11:42.98,1:11:43.94,all,,0000,0000,0000,,... لقد
Dialogue: 0,1:11:44.85,1:11:46.23,all,,0000,0000,0000,,إخترقتها الرصاصة
Dialogue: 0,1:11:46.90,1:11:48.98,all,,0000,0000,0000,,وأكتشفت الرصاصة بالقرب منها
Dialogue: 0,1:11:49.73,1:11:53.98,all,,0000,0000,0000,,والبندقية كان يملكها الأمير جيل ؟
Dialogue: 0,1:11:54.78,1:11:58.57,all,,0000,0000,0000,,هل هذه كل تفاصيل الحادثة ؟
Dialogue: 0,1:11:58.99,1:12:01.90,all,,0000,0000,0000,,نعم , لقد كنت بالمكان
Dialogue: 0,1:12:02.70,1:12:04.57,all,,0000,0000,0000,,أن كان من الممكن , دعني أهتم بالأمر
Dialogue: 0,1:12:05.57,1:12:07.20,all,,0000,0000,0000,,هل سيسمح لك ؟
Dialogue: 0,1:12:07.66,1:12:10.83,all,,0000,0000,0000,,... SP أنا كرئيس لـ
Dialogue: 0,1:12:11.36,1:12:16.45,all,,0000,0000,0000,,لم أتمكن من حماية الملكة , والأمير , والأميرة ميرا
Dialogue: 0,1:12:17.30,1:12:21.50,all,,0000,0000,0000,,وبسبب هذا , أبنتك واقعه في مشكله
Dialogue: 0,1:12:23.75,1:12:27.38,all,,0000,0000,0000,,الحقيقة بالتأكيد ستظهر
Dialogue: 0,1:12:32.28,1:12:36.09,all,,0000,0000,0000,,أنها هنا صحيح ؟ بالقرب من هنا , هاه ؟
Dialogue: 0,1:12:36.63,1:12:38.21,كونان,,0000,0000,0000,,يالها من زهور كرز جميله
Dialogue: 0,1:12:39.35,1:12:42.35,ميرا,,0000,0000,0000,,أنتظرا , لماذا أنتما هنا ؟
Dialogue: 0,1:12:43.05,1:12:45.76,all,,0000,0000,0000,,أوه , لماذا الأميرة هنا ؟
Dialogue: 0,1:12:46.22,1:12:49.30,كونان,,0000,0000,0000,,يالها من صدمه , لم نلاحظ ذلك على الأطلاق
Dialogue: 0,1:12:49.64,1:12:51.05,كونان,,0000,0000,0000,,هل بالغنا قليلاً ؟
Dialogue: 0,1:12:53.26,1:12:57.68,ميرا,,0000,0000,0000,,فهمت , أنتما الآثنان تلعبان دور المحقق
Dialogue: 0,1:12:58.14,1:13:00.81,ميرا,,0000,0000,0000,,حسناً , حظاً جيداً , أبذل جهدك ايها الفتى
Dialogue: 0,1:13:01.14,1:13:04.44,كونان,,0000,0000,0000,,إذاً , هذا هو المكان الذي سقطت فيه الملكة ساكورا , اليس كذلك ؟
Dialogue: 0,1:13:05.85,1:13:07.35,ميرا,,0000,0000,0000,,هذا ماسمعته
Dialogue: 0,1:13:07.35,1:13:08.48,كونان,,0000,0000,0000,,... إذاً
Dialogue: 0,1:13:10.36,1:13:11.19,كونان,,0000,0000,0000,,عمي
Dialogue: 0,1:13:12.57,1:13:13.94,كونان,,0000,0000,0000,,أحملني على كتفك
Dialogue: 0,1:13:14.29,1:13:15.82,all,,0000,0000,0000,,ماذا , تريدني أن أحملك مرةً أخرى ؟
Dialogue: 0,1:13:15.86,1:13:17.57,كونان,,0000,0000,0000,,سأناديك بـ بابا مجدداً
Dialogue: 0,1:13:18.57,1:13:20.07,كونان,,0000,0000,0000,,شكراً لك ياعمي
Dialogue: 0,1:13:22.20,1:13:23.12,كونان,,0000,0000,0000,,محترقة
Dialogue: 0,1:13:23.78,1:13:26.07,ميرا,,0000,0000,0000,,يبدو أن حاسة الشم والبصر لديك حادتان
Dialogue: 0,1:13:26.34,1:13:30.53,ميرا,,0000,0000,0000,,ذلك الغصن سقط أيضاً مع والدتي عندما أصيبت
Dialogue: 0,1:13:31.16,1:13:32.74,كونان,,0000,0000,0000,,... هذا يعني
Dialogue: 0,1:13:34.24,1:13:36.54,كونان,,0000,0000,0000,,عمي, رجاءً توجه إلى هناك
Dialogue: 0,1:13:37.31,1:13:39.48,all,,0000,0000,0000,,آه , غصن الساكورا ؟
Dialogue: 0,1:13:39.75,1:13:40.58,كونان,,0000,0000,0000,,لا
Dialogue: 0,1:13:41.25,1:13:46.50,ميرا,,0000,0000,0000,,أخي كان يصوب مسدسه إلى ثعلب كان تحت هذه الشجرة
Dialogue: 0,1:13:46.75,1:13:51.13,ميرا,,0000,0000,0000,,لكن أمي كانت أيضاً تحت هذه الشجره تحاول أن تجعل الثعلب يهرب بعيداً
Dialogue: 0,1:13:52.23,1:13:55.23,ميرا,,0000,0000,0000,,... ثم أخذ أخي المسدس من عمي
Dialogue: 0,1:13:55.36,1:13:57.21,all,,0000,0000,0000,,!أخذه ؟
Dialogue: 0,1:13:55.36,1:13:57.21,كونان,,0000,0000,0000,,!أخذه ؟
Dialogue: 0,1:13:59.09,1:14:00.63,all,,0000,0000,0000,,إذاً , ما الذي تخططين لفعله ؟
Dialogue: 0,1:14:00.96,1:14:02.92,all,,0000,0000,0000,,هل ستعودين معنا بالطائرة المروحية ؟
Dialogue: 0,1:14:03.24,1:14:05.01,كونان,,0000,0000,0000,,هذا العم رائع
Dialogue: 0,1:14:05.31,1:14:09.22,كونان,,0000,0000,0000,,القوة العسكرية لهذا البلد تنفذ لك كل ماتقوله
Dialogue: 0,1:14:11.31,1:14:12.35,ميرا,,0000,0000,0000,,أنا بخير
Dialogue: 0,1:14:12.35,1:14:14.26,ميرا,,0000,0000,0000,,هنالك أشخاص ينتظرونني بالأسفل
Dialogue: 0,1:14:14.47,1:14:16.85,كونان,,0000,0000,0000,,الشخص الذي ينتظرك هي أختكِ ؟
Dialogue: 0,1:14:17.25,1:14:19.49,ميرا,,0000,0000,0000,,أجل , محامية الدفاع الدولية
Dialogue: 0,1:14:19.49,1:14:22.22,ميرا,,0000,0000,0000,,قبلت القضية بسرور
Dialogue: 0,1:14:22.22,1:14:23.46,all,,0000,0000,0000,,هاه , أختكِ ؟
Dialogue: 0,1:14:24.10,1:14:25.39,all,,0000,0000,0000,,محامية الدفاع الدولية ؟
Dialogue: 0,1:14:26.14,1:14:28.46,all,,0000,0000,0000,,هل تعرفينا أسمها ؟
Dialogue: 0,1:14:29.33,1:14:31.06,ميرا,,0000,0000,0000,,فيجي مينيكو
Dialogue: 0,1:14:33.30,1:14:34.40,كونان,,0000,0000,0000,,هل تعرفها ؟
Dialogue: 0,1:14:35.24,1:14:37.07,فوجي,,0000,0000,0000,,!ماالرائع حول هذه ؟
Dialogue: 0,1:14:37.57,1:14:40.11,لوبين,,0000,0000,0000,,لديها تردد خاص يدوم لـ 30 ثانية
Dialogue: 0,1:14:42.74,1:14:43.82,فوجي,,0000,0000,0000,,. لا أحتاج لها
Dialogue: 0,1:14:45.28,1:14:48.28,فوجي,,0000,0000,0000,,أعتقد بأنك تسعى خلف شيءً رائع في هذه الاوقات
Dialogue: 0,1:14:49.32,1:14:51.29,فوجي,,0000,0000,0000,,مالغرض لتلك الكرة ؟
Dialogue: 0,1:14:51.29,1:14:54.29,فوجي,,0000,0000,0000,,ليست حتى جوهرة ثمينة , انها فقط شيءً رخيصً
Dialogue: 0,1:14:55.19,1:14:56.46,لوبين,,0000,0000,0000,,تلك طريقة سيئه لوصفها به
Dialogue: 0,1:14:56.46,1:14:58.46,لوبين,,0000,0000,0000,,لديها تاريخ مميز , أتعلمين ذلك ؟
Dialogue: 0,1:14:58.46,1:15:01.46,فوجي,,0000,0000,0000,,مقارنة بالتاريخ , القيمة هي الأهم
Dialogue: 0,1:15:03.30,1:15:06.30,all,,0000,0000,0000,,هل أكتشفت أي شيءً من خلال تلك المحادثة ؟
Dialogue: 0,1:15:06.37,1:15:10.54,كونان,,0000,0000,0000,,نعم , الأمير جيل أستعمل مسدس بدلاً من البندقية
Dialogue: 0,1:15:10.83,1:15:13.29,كونان,,0000,0000,0000,,... ذلك ممكن لكن
Dialogue: 0,1:15:14.34,1:15:17.34,كونان,,0000,0000,0000,,... حقيقة أن عمه يحمل مسدساً
Dialogue: 0,1:15:18.38,1:15:21.38,all,,0000,0000,0000,,حوله , كان ومازال يحمل معه البندقية والمسدس  SP حتى مع وجود الـ
Dialogue: 0,1:15:22.28,1:15:24.13,all,,0000,0000,0000,,عندما نعود دعنا نلقي نظرة على البندقية
Dialogue: 0,1:15:24.67,1:15:26.13,كونان,,0000,0000,0000,,أنت تتعاون معنا أخيراً ؟
Dialogue: 0,1:15:26.63,1:15:27.92,all,,0000,0000,0000,,آه , ليس باليد حيله
Dialogue: 0,1:15:28.22,1:15:29.30,all,,0000,0000,0000,,أنه عمل بالنهاية
Dialogue: 0,1:15:31.30,1:15:33.64,لوبين,,0000,0000,0000,,هل قررتِ أن تصبحي الملكة ؟
Dialogue: 0,1:15:34.26,1:15:36.05,ميرا,,0000,0000,0000,,لا خيار آخر , لايمكنني ألا العودة
Dialogue: 0,1:15:36.55,1:15:39.06,ميرا,,0000,0000,0000,,لقد فكرت بشأن أن أصبح الملكة
Dialogue: 0,1:15:39.40,1:15:44.14,فوجي,,0000,0000,0000,,أن تصبحي الملكة أم لا , عملي ينتهي بعد أن أعيدكِ
Dialogue: 0,1:15:45.06,1:15:46.23,فوجي,,0000,0000,0000,,أرجو أن تعتني بي
Dialogue: 0,1:15:46.43,1:15:49.85,لوبين,,0000,0000,0000,,فيجي مينيكو , لابد وأنها تفكر الآن بجمع ثروة طائلة
Dialogue: 0,1:15:50.52,1:15:51.41,فوجي,,0000,0000,0000,,هل قلت شيءً ؟
Dialogue: 0,1:15:51.52,1:15:52.48,لوبين,,0000,0000,0000,,آه , لاشيء
Dialogue: 0,1:15:53.40,1:15:54.15,فوجي,,0000,0000,0000,,توقف قليلاً
Dialogue: 0,1:15:55.73,1:15:57.06,لوبين,,0000,0000,0000,,مالأمر ؟
Dialogue: 0,1:15:58.90,1:16:01.77,فوجي,,0000,0000,0000,,السيدة لديها الكثير من الحاجيات
Dialogue: 0,1:16:09.43,1:16:10.82,all,,0000,0000,0000,,الآنسة ميرا
Dialogue: 0,1:16:12.40,1:16:13.66,ميرا,,0000,0000,0000,,هل أنتِ غاضبة ؟
Dialogue: 0,1:16:14.07,1:16:15.28,ران,,0000,0000,0000,,لست غاضبة
Dialogue: 0,1:16:15.37,1:16:16.44,ميرا,,0000,0000,0000,,!لماذا ؟
Dialogue: 0,1:16:16.44,1:16:18.24,ميرا,,0000,0000,0000,,لقد وضعتكِ في الفوضى
Dialogue: 0,1:16:18.53,1:16:21.44,ران,,0000,0000,0000,,تلك ليست أفعالكِ على أية حال , اليس كذلك ؟
Dialogue: 0,1:16:21.70,1:16:22.91,ران,,0000,0000,0000,,لقد سمعت ذلك من الآخرين
Dialogue: 0,1:16:23.16,1:16:24.49,ميرا,,0000,0000,0000,,! أنتما
Dialogue: 0,1:16:25.28,1:16:27.45,ران,,0000,0000,0000,,لقد سمعت ذلك من الدوق كيث
Dialogue: 0,1:16:27.83,1:16:28.91,ميرا,,0000,0000,0000,,كيث ؟
Dialogue: 0,1:16:29.87,1:16:31.46,كيث,,0000,0000,0000,,شكراً جزيلاً لكِ
Dialogue: 0,1:16:32.04,1:16:35.08,فوجي,,0000,0000,0000,,لا , هذا واجبي على أية حال
Dialogue: 0,1:16:35.36,1:16:37.29,كيث,,0000,0000,0000,,ألا مانع لديكِ أن تكون نقداً ؟
Dialogue: 0,1:16:37.79,1:16:40.42,كيث,,0000,0000,0000,,أن كنتِ تريدينه شيكً أو تحويلة فلا بأس ؟
Dialogue: 0,1:16:41.00,1:16:44.26,فوجي,,0000,0000,0000,,لاأثق بشيءً غير النقد
Dialogue: 0,1:16:45.05,1:16:46.01,كيث,,0000,0000,0000,,فهمت
Dialogue: 0,1:16:46.51,1:16:49.34,كيث,,0000,0000,0000,,إذاً , هل أستمتعت الأميرة ؟
Dialogue: 0,1:16:49.47,1:16:53.01,فوجي,,0000,0000,0000,,أجل , حتى الصباح مازالت فتاه طبيعية
Dialogue: 0,1:16:53.84,1:16:56.93,فوجي,,0000,0000,0000,,لقد نسيت هويتها كأميرة
Dialogue: 0,1:16:57.48,1:16:59.48,كيث,,0000,0000,0000,,فهمت
Dialogue: 0,1:16:59.76,1:17:01.47,فوجي,,0000,0000,0000,,أنت لطيف
Dialogue: 0,1:17:01.80,1:17:08.47,فوجي,,0000,0000,0000,,تخبرها بالحقيقه وتمنحها يوماً لحريتها لتستمتع به
Dialogue: 0,1:17:09.36,1:17:10.46,كيث,,0000,0000,0000,,مستحيل
Dialogue: 0,1:17:11.27,1:17:12.52,فوجي,,0000,0000,0000,,لاتقلق
Dialogue: 0,1:17:12.73,1:17:14.98,فوجي,,0000,0000,0000,,سوف أحفظ أسرار الناس
Dialogue: 0,1:17:15.36,1:17:18.06,فوجي,,0000,0000,0000,,لأنني محامية دفاع
Dialogue: 0,1:17:19.19,1:17:24.23,لوبين,,0000,0000,0000,,أنا محرج , حتى سائقاً مثلي يعامل بمثل هذا الكرم
Dialogue: 0,1:17:25.21,1:17:26.44,لوبين,,0000,0000,0000,,لذيذ
Dialogue: 0,1:17:26.57,1:17:29.21,all,,0000,0000,0000,,شراب و عصير , رجاءً
Dialogue: 0,1:17:29.21,1:17:30.31,all,,0000,0000,0000,,حسناً
Dialogue: 0,1:17:30.49,1:17:31.31,لوبين,,0000,0000,0000,,مرحباً
Dialogue: 0,1:17:32.28,1:17:33.86,all,,0000,0000,0000,,!مرحباً ماذا ؟
Dialogue: 0,1:17:34.35,1:17:36.48,كونان,,0000,0000,0000,,آه , ذلك الشخص
Dialogue: 0,1:17:36.48,1:17:38.07,all,,0000,0000,0000,,تعال إلى هنا
Dialogue: 0,1:17:39.22,1:17:40.45,كونان,,0000,0000,0000,,عمي
Dialogue: 0,1:17:40.46,1:17:42.62,all,,0000,0000,0000,,مالذي تعنيه بـ عمي ؟
Dialogue: 0,1:17:43.03,1:17:44.39,all,,0000,0000,0000,,ماهذا , يا لوبين ؟
Dialogue: 0,1:17:44.91,1:17:47.79,لوبين,,0000,0000,0000,,آه , أنا فقط أتناول وجبة , بعد أن أعدت الأميرة
Dialogue: 0,1:17:47.95,1:17:49.87,all,,0000,0000,0000,,ليس هذا , أنا أقصد فيجي
Dialogue: 0,1:17:50.27,1:17:51.43,لوبين,,0000,0000,0000,,... آه , ذلك
Dialogue: 0,1:17:51.58,1:17:54.75,كونان,,0000,0000,0000,,آه , لقد أنزلقت بسبب أنني لم أستطع الوقوف من البرد
Dialogue: 0,1:17:55.30,1:17:58.30,all,,0000,0000,0000,,ليس ذلك ! ألست مغروراً قليلاً ؟
Dialogue: 0,1:17:58.67,1:17:59.67,كونان,,0000,0000,0000,,آه , ذلك
Dialogue: 0,1:17:59.92,1:18:02.54,all,,0000,0000,0000,,هل حدث شيءً جيد منذ أن تعرفت بتلك المرأه ؟
Dialogue: 0,1:18:03.21,1:18:04.45,all,,0000,0000,0000,,ألم تقف  أنت في الطريق ؟
Dialogue: 0,1:18:04.92,1:18:06.75,لوبين,,0000,0000,0000,,لذلك أحتاج إلى المساعده
Dialogue: 0,1:18:07.05,1:18:08.59,كونان,,0000,0000,0000,,هذا مزعج
Dialogue: 0,1:18:10.09,1:18:14.01,all,,0000,0000,0000,,ما الذي تقوله ؟ ليس هنالك فائده الآن
Dialogue: 0,1:18:16.19,1:18:17.84,all,,0000,0000,0000,,شخصان متشابهان
Dialogue: 0,1:18:18.36,1:18:20.89,all,,0000,0000,0000,,على آيه حال , كُل بسرعه وعد من حيث أتيت
Dialogue: 0,1:18:21.26,1:18:22.01,لوبين,,0000,0000,0000,,حسناً
Dialogue: 0,1:18:22.26,1:18:24.10,all,,0000,0000,0000,,كيف المشهد هذ الآن ؟
Dialogue: 0,1:18:24.55,1:18:27.10,كونان,,0000,0000,0000,,بصمات الأصابع التي على السلاحين تم فحصها , صحيح ؟
Dialogue: 0,1:18:28.64,1:18:30.68,all,,0000,0000,0000,,شركاء مشهورون
Dialogue: 0,1:18:31.10,1:18:32.43,all,,0000,0000,0000,,آسفه لجعلك تنتظر
Dialogue: 0,1:18:33.21,1:18:36.21,all,,0000,0000,0000,,آنستي , أيمكنني الحصول على بعض القهوه ؟
Dialogue: 0,1:18:36.69,1:18:37.19,all,,0000,0000,0000,,بالتأكيد
Dialogue: 0,1:18:38.77,1:18:39.69,all,,0000,0000,0000,,مالأمر ؟
Dialogue: 0,1:18:40.56,1:18:43.42,all,,0000,0000,0000,,لحد الآن , هل كانت مخيلتي ؟
Dialogue: 0,1:18:43.98,1:18:45.65,ران,,0000,0000,0000,,أبي , كونان
Dialogue: 0,1:18:48.11,1:18:50.32,كونان,,0000,0000,0000,,هذه أختي ران , صحيح ؟
Dialogue: 0,1:18:50.82,1:18:55.03,all,,0000,0000,0000,,كن على حذر , سيكون ذلك سيءً أن أخطأنا بها
Dialogue: 0,1:18:58.82,1:19:00.24,ران,,0000,0000,0000,,أنتما الأثنان
Dialogue: 0,1:19:01.61,1:19:03.07,all,,0000,0000,0000,,ران -
Dialogue: 0,1:19:01.61,1:19:03.07,كونان,,0000,0000,0000,,أختي ران -
Dialogue: 0,1:19:03.44,1:19:04.87,ران,,0000,0000,0000,,! لايعقل هذا
Dialogue: 0,1:19:04.95,1:19:05.83,ران,,0000,0000,0000,,! أنتما الآسواء
Dialogue: 0,1:19:06.45,1:19:08.34,all,,0000,0000,0000,,لاتغضبي يا ران
Dialogue: 0,1:19:08.34,1:19:10.12,كونان,,0000,0000,0000,,أختي ران
Dialogue: 0,1:19:10.38,1:19:11.99,all,,0000,0000,0000,,قهوتك جاهزه
Dialogue: 0,1:19:12.38,1:19:13.25,all,,0000,0000,0000,,شكراً لكِ
Dialogue: 0,1:19:13.95,1:19:15.58,all,,0000,0000,0000,,أنتِ بقيتي هنا , هاه ؟
Dialogue: 0,1:19:15.83,1:19:19.25,all,,0000,0000,0000,,أجل , أنا فقط والطباخ
Dialogue: 0,1:19:19.42,1:19:22.96,all,,0000,0000,0000,,أنا آسف , لكن هل يمكننا التحدث قليلاً ؟
Dialogue: 0,1:19:23.43,1:19:25.43,all,,0000,0000,0000,,لماذا هو هنا ؟
Dialogue: 0,1:19:25.58,1:19:27.43,لوبين,,0000,0000,0000,,كيف لي أن أعرف ؟
Dialogue: 0,1:19:27.75,1:19:28.88,all,,0000,0000,0000,,هل هي تلك الفتاة ؟
Dialogue: 0,1:19:29.00,1:19:31.21,لوبين,,0000,0000,0000,,مستحيل , صحيح ؟
Dialogue: 0,1:19:31.80,1:19:34.23,لوبين,,0000,0000,0000,,حسناً إذاً , لقد أجتمع الممثلون هنا جميعاً
Dialogue: 0,1:19:34.24,1:19:36.63,لوبين,,0000,0000,0000,,هل نبدأ بالتمثيل ؟
Dialogue: 0,1:19:42.93,1:19:45.68,ميرا,,0000,0000,0000,,... عطر أمي
Dialogue: 0,1:19:47.60,1:19:48.72,ران,,0000,0000,0000,,الأميرة ميرا
Dialogue: 0,1:19:49.26,1:19:50.14,ميرا,,0000,0000,0000,,أدخلي
Dialogue: 0,1:19:51.89,1:19:53.14,ران,,0000,0000,0000,,آسفه على الآزعاج
Dialogue: 0,1:19:53.49,1:19:55.31,ران,,0000,0000,0000,,لقد أحضرت الآثنان
Dialogue: 0,1:19:56.32,1:19:57.77,ران,,0000,0000,0000,,الا بأس بهذا حقاً ؟
Dialogue: 0,1:19:58.39,1:19:59.64,ميرا,,0000,0000,0000,,هذا لايهم
Dialogue: 0,1:20:00.06,1:20:01.44,ميرا,,0000,0000,0000,,هذه غرفة والدتي
Dialogue: 0,1:20:02.10,1:20:06.56,ميرا,,0000,0000,0000,,ولم يتغير شيءً في ترتيبها منذ وفاتها
Dialogue: 0,1:20:07.81,1:20:10.15,ميرا,,0000,0000,0000,,أنتما ستقومان بتفتيش الغرفة , صحيح ؟ إذاً سأتعاون معكما
Dialogue: 0,1:20:11.32,1:20:13.40,all,,0000,0000,0000,,إذاً , لن أتراجع
Dialogue: 0,1:20:14.44,1:20:16.11,ميرا,,0000,0000,0000,,لكن ستسخر من ذلك , صحيح ؟
Dialogue: 0,1:20:16.61,1:20:21.24,ميرا,,0000,0000,0000,,لمساعدتك في أيجاد الدليل لمقتل والدتي وأخي
Dialogue: 0,1:20:21.53,1:20:24.42,ران,,0000,0000,0000,,... ذلك ... لم يقرر بعد
Dialogue: 0,1:20:26.07,1:20:27.12,ران,,0000,0000,0000,,أنا آسفه
Dialogue: 0,1:20:27.62,1:20:29.70,ميرا,,0000,0000,0000,,على ماذا تعتذرين ؟
Dialogue: 0,1:20:30.58,1:20:33.33,ميرا,,0000,0000,0000,,هذه البلد ملعونه
Dialogue: 0,1:20:34.54,1:20:36.37,ميرا,,0000,0000,0000,,بتلك الحجاره
Dialogue: 0,1:20:36.83,1:20:37.79,ران,,0000,0000,0000,,آنسة ميرا
Dialogue: 0,1:20:42.71,1:20:44.58,كونان,,0000,0000,0000,,مذهل , هاه ؟
Dialogue: 0,1:20:52.67,1:20:53.50,كونان,,0000,0000,0000,,... هذه
Dialogue: 0,1:21:02.22,1:21:05.05,كونان,,0000,0000,0000,,لقد فهمت أخيراً مشاعر الملكة ساكورا
Dialogue: 0,1:21:08.09,1:21:10.22,كونان,,0000,0000,0000,,ذلك الحب الكبير للملكة
Dialogue: 0,1:21:21.85,1:21:25.56,لوبين,,0000,0000,0000,,الباب مفتوح , والص قادم
Dialogue: 0,1:21:26.10,1:21:29.02,لوبين,,0000,0000,0000,,الرذاذ المنوم , مزحه فقط
Dialogue: 0,1:21:29.45,1:21:32.45,لوبين,,0000,0000,0000,,!لماذا هو نائم ؟ لماذا هي خالية ؟
Dialogue: 0,1:21:33.22,1:21:34.69,لوبين,,0000,0000,0000,,!لماذا لايوجد شيء ؟
Dialogue: 0,1:21:35.02,1:21:37.07,لوبين,,0000,0000,0000,,ما الفائده إذاً من أنقاذها ؟
Dialogue: 0,1:21:37.44,1:21:39.07,لوبين,,0000,0000,0000,,آه , أنتِ
Dialogue: 0,1:21:39.28,1:21:42.11,فوجي,,0000,0000,0000,,أنا آسفة لوبين , أنا آسفة لوبين
Dialogue: 0,1:21:42.24,1:21:44.07,لوبين,,0000,0000,0000,,! لايمكن , لايمكن
Dialogue: 0,1:21:44.37,1:21:46.53,فوجي,,0000,0000,0000,,... أنا آسفة لوبين , أنا آسفة لوبين
Dialogue: 0,1:21:51.37,1:21:53.08,all,,0000,0000,0000,,دخول , حراره , وزن
Dialogue: 0,1:21:55.37,1:21:56.99,لوبين,,0000,0000,0000,,لقد أصبتهم جميعاً
Dialogue: 0,1:22:01.58,1:22:04.83,فوجي,,0000,0000,0000,,آسفة لوبين , لقد وقعت في مكاني
Dialogue: 0,1:22:07.12,1:22:11.88,فوجي,,0000,0000,0000,,ماهذا ؟ أليسوا مُبكرين قليلاً ؟
Dialogue: 0,1:22:13.33,1:22:15.46,all,,0000,0000,0000,,شكراً لك على تعاونك
Dialogue: 0,1:22:15.46,1:22:20.09,all,,0000,0000,0000,,لا لا , لقد أتى لوبين , كما هو متوقع من محترف
Dialogue: 0,1:22:20.40,1:22:22.92,all,,0000,0000,0000,,لا , سأعود حالاً
Dialogue: 0,1:22:22.97,1:22:25.34,all,,0000,0000,0000,,... لوبين , لوبين
Dialogue: 0,1:22:26.21,1:22:29.21,all,,0000,0000,0000,,كيف هي التحضيرات في المنزل الشرقي ؟
Dialogue: 0,1:22:29.80,1:22:32.09,all,,0000,0000,0000,,نعم , كل شيءً جاهز
Dialogue: 0,1:22:34.43,1:22:35.51,all,,0000,0000,0000,,أكتمل آخيراً
Dialogue: 0,1:22:36.93,1:22:38.85,لوبين,,0000,0000,0000,,مرحباً , هل تسمعني ؟
Dialogue: 0,1:22:39.27,1:22:39.93,all,,0000,0000,0000,,أجل
Dialogue: 0,1:22:40.18,1:22:43.52,لوبين,,0000,0000,0000,,أنا عالق , هل تساعدني هنا ؟
Dialogue: 0,1:22:44.02,1:22:44.85,all,,0000,0000,0000,,في الخزنة ؟
Dialogue: 0,1:22:45.02,1:22:46.10,لوبين,,0000,0000,0000,,لا
Dialogue: 0,1:22:46.19,1:22:46.81,all,,0000,0000,0000,,أنا سأعود
Dialogue: 0,1:22:47.06,1:22:48.81,لوبين,,0000,0000,0000,,أنت تقول ذلك مجدداً
Dialogue: 0,1:22:48.94,1:22:50.98,all,,0000,0000,0000,,من الأفضل لك أن تتعلم من هذا الدرس
Dialogue: 0,1:22:51.02,1:22:51.85,لوبين,,0000,0000,0000,,أجل
Dialogue: 0,1:22:52.35,1:22:54.19,all,,0000,0000,0000,,معلمي , الأمر عائداً إليك
Dialogue: 0,1:22:57.02,1:22:58.52,all,,0000,0000,0000,,حسناً , لقد فهمت
Dialogue: 0,1:23:11.07,1:23:13.78,لوبين,,0000,0000,0000,,أنه يفعل شيءً أضافي للمعتاد
Dialogue: 0,1:23:19.91,1:23:24.79,all,,0000,0000,0000,,لقد قللت الكثير من القمامة مجدداً
Dialogue: 0,1:23:25.20,1:23:27.21,لوبين,,0000,0000,0000,,متعبه , صحيح ؟ تلك الوقفة
Dialogue: 0,1:23:27.33,1:23:27.83,all,,0000,0000,0000,,أجل
Dialogue: 0,1:23:34.42,1:23:35.67,لوبين,,0000,0000,0000,,شكراً لك
Dialogue: 0,1:23:38.38,1:23:39.84,لوبين,,0000,0000,0000,,سوف أدع الدعم لك
Dialogue: 0,1:23:45.42,1:23:46.22,all,,0000,0000,0000,,... هاه
Dialogue: 0,1:23:47.13,1:23:50.72,all,,0000,0000,0000,,جيجين وغويمون فقط , كما توقعت
Dialogue: 0,1:23:51.76,1:23:52.89,all,,0000,0000,0000,,هل هذا كل شئ ؟
Dialogue: 0,1:23:53.09,1:23:55.14,all,,0000,0000,0000,,أظن أننا الوحيدون المتبقون
Dialogue: 0,1:23:55.85,1:23:56.89,all,,0000,0000,0000,,مالذي يحدث ؟
Dialogue: 0,1:23:57.01,1:23:58.47,all,,0000,0000,0000,,أعطت الشرطة أوامرها
Dialogue: 0,1:23:57.27,1:24:00.01,all,,0000,0000,0000,,المنزل الشرقي
Dialogue: 0,1:24:00.37,1:24:03.37,all,,0000,0000,0000,,هل هذا جيد أيها المفتش زينيجاتا ؟
Dialogue: 0,1:24:03.68,1:24:06.06,all,,0000,0000,0000,,نعم . شكراً لك
Dialogue: 0,1:24:07.93,1:24:11.35,all,,0000,0000,0000,,السبب الذي جمعتكم من اجله هنا
Dialogue: 0,1:24:11.98,1:24:17.02,all,,0000,0000,0000,,قبل فترة قليله, تاج الملكة سرق من الخزنة الملكية
Dialogue: 0,1:24:17.39,1:24:21.11,all,,0000,0000,0000,,... المجرم الذي يحتفظ بتاج الملكة -
Dialogue: 0,1:24:18.45,1:24:21.11,كونان,,0000,0000,0000,,أنا آسف , لكن علي أن أتكلم أولاُ -
Dialogue: 0,1:24:21.26,1:24:25.73,all,,0000,0000,0000,,... حاول أن يقلل عدد الناس الذين في القصر لأجل
Dialogue: 0,1:24:28.57,1:24:29.15,كونان,,0000,0000,0000,,! تباً
Dialogue: 0,1:24:33.40,1:24:35.44,كونان,,0000,0000,0000,,بما أن الوضع هكذا
Dialogue: 0,1:24:35.61,1:24:36.66,all,,0000,0000,0000,,!ماالأمر ؟
Dialogue: 0,1:24:37.12,1:24:38.99,كونان,,0000,0000,0000,,! .. أنهُ هنا
Dialogue: 0,1:24:40.33,1:24:42.99,كونان,,0000,0000,0000,,الشخص الذي حاول أن يقتل الأميرة ميرا
Dialogue: 0,1:24:43.99,1:24:45.74,ران,,0000,0000,0000,,... الشخص الذي حقق بالأمر هو
Dialogue: 0,1:24:45.79,1:24:47.25,all,,0000,0000,0000,,آه , أنا ؟
Dialogue: 0,1:24:47.87,1:24:52.21,كونان,,0000,0000,0000,,كل هذا بسبب تلك البندقية المؤسفه
Dialogue: 0,1:24:52.42,1:24:53.49,all,,0000,0000,0000,,أنه .. ؟
Dialogue: 0,1:24:53.79,1:24:56.00,all,,0000,0000,0000,,لا , لايمكن أن يحدث هذا
Dialogue: 0,1:24:56.36,1:24:59.36,all,,0000,0000,0000,,الفتى الصغير ووالد الآنسة ران
Dialogue: 0,1:24:59.84,1:25:01.59,كونان,,0000,0000,0000,,تلك ليست القصة
Dialogue: 0,1:25:02.67,1:25:04.21,كونان,,0000,0000,0000,,!آه , ماذا ؟
Dialogue: 0,1:25:06.55,1:25:07.42,all,,0000,0000,0000,,ماذا ؟
Dialogue: 0,1:25:07.71,1:25:11.13,كونان,,0000,0000,0000,,هل هو وحش ؟ حتى الفيل سيغط بالنوم لمدة 30 دقيقة
Dialogue: 0,1:25:11.76,1:25:15.59,لوبين,,0000,0000,0000,,فهمت , أنها قضية قتل فجُعلت وكأنها حادثة
Dialogue: 0,1:25:17.18,1:25:20.22,all,,0000,0000,0000,,... آه , ماالذي يحدث
Dialogue: 0,1:25:21.30,1:25:22.85,كونان,,0000,0000,0000,,اللص متنكر ؟
