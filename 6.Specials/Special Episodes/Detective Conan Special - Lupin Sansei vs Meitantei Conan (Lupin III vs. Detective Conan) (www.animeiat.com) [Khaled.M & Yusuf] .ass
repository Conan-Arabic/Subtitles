Dialogue: 0,0:00:31.16,0:00:32.22,all,,0000,0000,0000,,لقد وصلنا إلى الموقع
Dialogue: 0,0:00:32.39,0:00:33.14,all,,0000,0000,0000,,لتبدأ العمليات الآن
Dialogue: 0,0:00:33.39,0:00:34.10,all,,0000,0000,0000,, كل شيءً يبدو جيداً
Dialogue: 0,0:00:34.22,0:00:35.72,all,,0000,0000,0000,,الجميع في مواقعهم
Dialogue: 0,0:01:03.69,0:01:06.26,all,,0000,0000,0000,,جميعكم أنتظروا هنا , حتى أطلبكم مجدداً
Dialogue: 0,0:01:06.27,0:01:09.27,all,,0000,0000,0000,,الكثير من الأشخاص سيُخيف الحيوانات وستبتعد
Dialogue: 0,0:01:13.07,0:01:14.37,all,,0000,0000,0000,,أعطني هذه
Dialogue: 0,0:01:15.11,0:01:18.11,all,,0000,0000,0000,,أستعملها كم علمتك من قبل , أتذكر ؟
Dialogue: 0,0:01:18.91,0:01:20.41,all,,0000,0000,0000,,... آه , أنها مثالية جداً
Dialogue: 0,0:01:21.54,0:01:23.16,all,,0000,0000,0000,,الأفضل نسيان طريقه أستعمالها ؟
Dialogue: 0,0:01:23.25,0:01:25.28,all,,0000,0000,0000,,أن أمكنني , سأفعل ذلك
Dialogue: 0,0:01:25.25,0:01:26.83,all,,0000,0000,0000,,تفضل
Dialogue: 0,0:01:28.02,0:01:31.37,all,,0000,0000,0000,,أنا آسف لأنني جعلتكِ تمسكين بها
Dialogue: 0,0:01:32.09,0:01:35.09,all,,0000,0000,0000,,أمي , أنتِ حقاً لم ترغبي بالقدوم إلى هنا ؟
Dialogue: 0,0:01:35.23,0:01:38.06,all,,0000,0000,0000,,لا , ليس حقاً
Dialogue: 0,0:01:38.06,0:01:41.59,all,,0000,0000,0000,,أنا لا أحب مثل هذه النشاطات البربريه , مثل الصيد
Dialogue: 0,0:01:42.67,0:01:44.13,all,,0000,0000,0000,,لقد أستخدمتِ كلمة بربريه
Dialogue: 0,0:01:45.07,0:01:47.21,all,,0000,0000,0000,,أن الصيد رياضه نبيله
Dialogue: 0,0:01:47.21,0:01:49.14,all,,0000,0000,0000,,هكذا إذاً , أيها الأمير ؟
Dialogue: 0,0:01:49.14,0:01:52.14,all,,0000,0000,0000,,دعنا نحظى بمعركه الرجال
Dialogue: 0,0:01:53.05,0:01:56.01,all,,0000,0000,0000,,الرجال هم فقط من يفهون الشعور بلذه الصيد , أليس كذالك ؟
Dialogue: 0,0:01:56.01,0:01:57.18,all,,0000,0000,0000,,! لقد سمعت ذلك
Dialogue: 0,0:01:57.18,0:02:00.18,all,,0000,0000,0000,,هاه ... حقاً , حقاً ؟
Dialogue: 0,0:03:03.18,0:03:05.15,all,,0000,0000,0000,,لايمكنك البقاء هنا
Dialogue: 0,0:03:05.15,0:03:08.15,all,,0000,0000,0000,,! بسرعه , أهرب بعيداً
Dialogue: 0,0:03:39.73,0:03:40.44,all,,0000,0000,0000,,! أمي
Dialogue: 0,0:03:41.44,0:03:42.69,all,,0000,0000,0000,,! مستحيل
Dialogue: 0,0:03:44.40,0:03:45.23,all,,0000,0000,0000,,... مستحيل
Dialogue: 0,0:03:48.19,0:03:50.07,all,,0000,0000,0000,,!!! مستحيل
Dialogue: 0,0:03:52.53,0:03:53.86,all,,0000,0000,0000,,! أذهب وأستطلع الأمر , بسرعه
Dialogue: 0,0:03:54.11,0:03:54.45,all,,0000,0000,0000,,حسناً
Dialogue: 0,0:03:54.90,0:03:55.78,all,,0000,0000,0000,,أنتم تعالوا معي
Dialogue: 0,0:03:55.78,0:03:56.24,all,,0000,0000,0000,,عُلم
Dialogue: 0,0:04:11.79,0:04:12.70,all,,0000,0000,0000,,اللورد جيرالد
Dialogue: 0,0:04:17.06,0:04:20.06,all,,0000,0000,0000,,أنتم .. متأخرون جداً
Dialogue: 0,0:04:26.03,0:04:28.23,more,,0000,0000,0000,,الرميه الرابعه
Dialogue: 0,0:04:28.42,0:04:30.17,more,,0000,0000,0000,,! هذا غريب
Dialogue: 0,0:04:30.17,0:04:30.92,more,,0000,0000,0000,,تغيير اللاعب
Dialogue: 0,0:04:31.17,0:04:32.76,all,,0000,0000,0000,,! عظيم
Dialogue: 0,0:04:33.21,0:04:34.84,all,,0000,0000,0000,,!شراب , شراب
Dialogue: 0,0:04:35.84,0:04:36.72,all,,0000,0000,0000,,! إذهب ! إذهب
Dialogue: 0,0:04:37.04,0:04:39.34,ران,,0000,0000,0000,,! أبي , توقف عن الشرب , لقد شربت الكثير
Dialogue: 0,0:04:39.80,0:04:43.76,كونان,,0000,0000,0000,,من وجهة نظري \N يبدو أن هذا هو اهتمامه الوحيد
Dialogue: 0,0:04:44.28,0:04:46.25,all,,0000,0000,0000,,! هيا , ياروبي
Dialogue: 0,0:04:46.25,0:04:48.12,all,,0000,0000,0000,,! لاتخذلني
Dialogue: 0,0:04:48.12,0:04:51.06,all,,0000,0000,0000,,! اصنع دوره كامله
Dialogue: 0,0:04:51.06,0:04:53.12,ران,,0000,0000,0000,,لماذ أخذت علبتين ؟
Dialogue: 0,0:04:53.13,0:04:55.13,all,,0000,0000,0000,,أنا كسولاً لأذهب وأخذ أخرى
Dialogue: 0,0:04:55.13,0:04:56.16,ران,,0000,0000,0000,,... أبي
Dialogue: 0,0:04:56.16,0:04:59.10,more,,0000,0000,0000,,أنا سعيدً للحصول عليها هنا
Dialogue: 0,0:04:59.69,0:05:02.10,more,,0000,0000,0000,,لذا , أختيار المدرب هوشينو هو ؟
Dialogue: 0,0:05:03.27,0:05:06.27,more,,0000,0000,0000,,وفي منتصف هذه المبارة المباشرة \N نجلب لكم آخر الآخبار
Dialogue: 0,0:05:07.04,0:05:08.21,all,,0000,0000,0000,,... هيه , دعوني أكمـ
Dialogue: 0,0:05:08.21,0:05:11.14,more,,0000,0000,0000,,في هذا الصباح , حوالي الساعه 10.25 صباحاً -
Dialogue: 0,0:05:08.21,0:05:11.14,all,,0000,0000,0000,, .. لاتوقفوا بث المبارة
Dialogue: 0,0:05:11.14,0:05:14.24,more,,0000,0000,0000,,من بلاد فيسبانيا الملكه ساكورا والأمير جيل
Dialogue: 0,0:05:14.36,0:05:16.15,more,,0000,0000,0000,,ماتا بالخطأ عندما ذهبوا للصيد سويةً
Dialogue: 0,0:05:16.15,0:05:17.18,more,,0000,0000,0000,,دعوني أعيد الخبر
Dialogue: 0,0:05:17.18,0:05:20.53,more,,0000,0000,0000,,من بلاد فيسبانيا الملكه ساكورا والأمير جيل ماتا بالخطأ
Dialogue: 0,0:05:21.03,0:05:24.99,more,,0000,0000,0000,,وفي بلاد فيسبانيا تم ايجاد معدن مجهول
Dialogue: 0,0:05:24.07,0:05:25.70,all,,0000,0000,0000,,ماتا بالخطأ
Dialogue: 0,0:05:25.02,0:05:27.03,more,,0000,0000,0000,,وعيون كُل العالم عليه
Dialogue: 0,0:05:27.66,0:05:29.28,more,,0000,0000,0000,,... المتوفاه الملكه ساكورا
Dialogue: 0,0:07:00.25,0:07:02.55,كيث,,0000,0000,0000,,المراسم الغاليه جداً
Dialogue: 0,0:07:02.58,0:07:04.37,كيث,,0000,0000,0000,,ستأخذ مدة شهر
Dialogue: 0,0:07:05.02,0:07:08.02,all,,0000,0000,0000,,بمثل هذه الحادثة , ليس لدينا خيارً آخر
Dialogue: 0,0:07:08.88,0:07:12.17,all,,0000,0000,0000,,مع ذلك لقد كنت بجانبهم , هذا حزين جداً
Dialogue: 0,0:07:13.00,0:07:13.80,all,,0000,0000,0000,,على الأقل
Dialogue: 0,0:07:13.92,0:07:16.00,all,,0000,0000,0000,,كان علي أن أمنع الأمير من الأنتحار
Dialogue: 0,0:07:16.67,0:07:18.71,كيث,,0000,0000,0000,,لاتلم نفسك
Dialogue: 0,0:07:19.59,0:07:21.34,كيث,,0000,0000,0000,,لقد حصل وأنتهى الآمر
Dialogue: 0,0:07:22.04,0:07:24.14,كيث,,0000,0000,0000,,يجب علينا أن نركز على الاشياء القادمة
Dialogue: 0,0:07:24.14,0:07:27.14,all,,0000,0000,0000,,. نعم, أنت محق
Dialogue: 0,0:07:28.55,0:07:30.25,all,,0000,0000,0000,,كيف حال الأميرة ميرا الان ؟
Dialogue: 0,0:07:30.51,0:07:32.22,كيث,,0000,0000,0000,,مازالت كما هي
Dialogue: 0,0:07:32.51,0:07:35.22,كيث,,0000,0000,0000,,مازالت ترفض أن تصبح الملكة
Dialogue: 0,0:07:36.15,0:07:40.56,all,,0000,0000,0000,,كل من والدتها وأخيها قد ماتا , هذا مفهوم
Dialogue: 0,0:07:40.96,0:07:41.74,all,,0000,0000,0000,,... بالأضافة
Dialogue: 0,0:07:43.59,0:07:45.09,all,,0000,0000,0000,,مازال هنالك معارضين
Dialogue: 0,0:07:48.45,0:07:52.77,more,,0000,0000,0000,,! لا تعطوا العرش للأميرة ميرا , مازالت فتاة صغيرة
Dialogue: 0,0:07:53.14,0:07:55.76,more,,0000,0000,0000,,! سيكون العرش مهدداً بالضياع
Dialogue: 0,0:07:56.28,0:07:58.18,all,,0000,0000,0000,,هذه مجموعة معارضة للأميرة
Dialogue: 0,0:07:58.48,0:08:01.75,كيث,,0000,0000,0000,," لقد وصفو الأميرة بـ" الفتاة
Dialogue: 0,0:08:02.56,0:08:05.48,all,,0000,0000,0000,,هنالك عدة أشخاص من المخربين بين الحشد
Dialogue: 0,0:08:06.12,0:08:08.74,all,,0000,0000,0000,,سأدعك تهتم بمراسم التتويج
Dialogue: 0,0:08:09.05,0:08:09.82,كيث,,0000,0000,0000,,مفهوم
Dialogue: 0,0:08:15.13,0:08:16.03,ميرا,,0000,0000,0000,, ماذا تفعلون ؟
Dialogue: 0,0:08:16.03,0:08:18.13,ميرا,,0000,0000,0000,,! بسرعه أجعلوا أولئك الحمقى يصمتوا
Dialogue: 0,0:08:18.45,0:08:20.26,all,,0000,0000,0000,,... ميرا - ساما , أرجوكِ آهدئي
Dialogue: 0,0:08:20.27,0:08:23.27,ميرا,,0000,0000,0000,,أصمتِ ! لقد أسيئ لي ! وتريدينني أن أجلس بهدوء ؟
Dialogue: 0,0:08:24.00,0:08:27.00,ميرا,,0000,0000,0000,,! كيث ! أين كيث ؟ دعيه يأتي إلى هنا حالاً
Dialogue: 0,0:08:28.07,0:08:29.07,كيث,,0000,0000,0000,,... أنا هنا
Dialogue: 0,0:08:30.09,0:08:32.51,كيث,,0000,0000,0000,,مالخطب , أيتها الأميرة ميرا ؟
Dialogue: 0,0:08:33.01,0:08:34.83,ميرا,,0000,0000,0000,,هاه , هل سمعت ؟
Dialogue: 0,0:08:34.83,0:08:35.75,ميرا,,0000,0000,0000,,تلك الضوضاء
Dialogue: 0,0:08:35.92,0:08:37.25,ميرا,,0000,0000,0000,,تلك أصوات مواطنين هذه البلاد
Dialogue: 0,0:08:38.55,0:08:41.22,ميرا,,0000,0000,0000,,لاتقل ذلك بعد الآن , هذه رغبتي
Dialogue: 0,0:08:41.71,0:08:45.24,ميرا,,0000,0000,0000,,من تريد أن تكون ملكة ؟
Dialogue: 0,0:08:45.67,0:08:48.72,كيث,,0000,0000,0000,,أنتِ المرشحه الأولى لتكوني الملكة
Dialogue: 0,0:08:49.09,0:08:51.64,كيث,,0000,0000,0000,,لذا أرجو أن تتفهمي موقفكِ في القصر الآن
Dialogue: 0,0:08:52.13,0:08:53.30,ميرا,,0000,0000,0000,,لايمكنني فهم هذه الأمور
Dialogue: 0,0:08:54.03,0:08:57.15,ميرا,,0000,0000,0000,,... كنت أعتقد  أن أخي هو المرشح الأول
Dialogue: 0,0:08:59.58,0:09:02.93,ميرا,,0000,0000,0000,,.. دائماً .. للعرش
Dialogue: 0,0:09:04.14,0:09:08.98,كيث,,0000,0000,0000,,أرجوكِ أسرعي وأنهي المعاملات الرسميه بأعتباركِ المسؤوله في اليابان
Dialogue: 0,0:09:09.15,0:09:10.02,ميرا,,0000,0000,0000,,اليابان ؟
Dialogue: 0,0:09:11.03,0:09:12.12,ميرا,,0000,0000,0000,,لايمكن
Dialogue: 0,0:09:12.12,0:09:15.89,ميرا,,0000,0000,0000,,. لقد سمعت أن هنالك أشخاص يرغبون في قتلي
Dialogue: 0,0:09:16.79,0:09:17.42,ميرا,,0000,0000,0000,,... أنا
Dialogue: 0,0:09:17.71,0:09:19.15,ميرا,,0000,0000,0000,,. لن أترك هذا المكان أبداً
Dialogue: 0,0:09:20.03,0:09:22.69,كيث,,0000,0000,0000,,. سنقوم بحماية سموكم بحياتنا
Dialogue: 0,0:09:23.75,0:09:24.48,كيث,,0000,0000,0000,,... لذا
Dialogue: 0,0:09:25.06,0:09:27.40,كيث,,0000,0000,0000,,لقد قمنا بأحضار حارس شخصي
Dialogue: 0,0:09:28.44,0:09:29.16,كيث,,0000,0000,0000,,أدخل
Dialogue: 0,0:09:34.74,0:09:36.33,all,,0000,0000,0000,,. مرحباً, أيتها الأميرة
Dialogue: 0,0:09:38.87,0:09:41.20,ميرا,,0000,0000,0000,,. انا اكره الرجال أصحاب اللحاء
Dialogue: 0,0:10:05.88,0:10:07.26,all,,0000,0000,0000,,.يووه, شكراً لك
Dialogue: 0,0:10:08.27,0:10:11.27,all,,0000,0000,0000,,أسفون لأزعاجك وأحضارك إلى هنا
Dialogue: 0,0:10:12.01,0:10:13.21,all,,0000,0000,0000,,أمراً سهلاً كالفطيره
Dialogue: 0,0:10:13.64,0:10:14.55,all,,0000,0000,0000,,المعلم جيجين
Dialogue: 0,0:10:15.08,0:10:16.64,all,,0000,0000,0000,,لاتدعوني بالمعلم
Dialogue: 0,0:10:17.02,0:10:19.47,all,,0000,0000,0000,,أنت ذاهب إلى اليابان مع الأميرة ؟
Dialogue: 0,0:10:19.89,0:10:22.01,all,,0000,0000,0000,,لقد كرهتني الأميرة
Dialogue: 0,0:10:22.81,0:10:28.35,all,,0000,0000,0000,,لقد سمعت بأن تاج الملكة هنا من أجل مراسم التتويج
Dialogue: 0,0:10:28.56,0:10:30.23,all,,0000,0000,0000,,أجل , أتريد أن تلقي نظره ؟
Dialogue: 0,0:10:30.44,0:10:33.23,all,,0000,0000,0000,,آه .. أيمكنني أخذ نظره خاطفه ؟
Dialogue: 0,0:10:44.53,0:10:46.65,all,,0000,0000,0000,,هذا هو تاج الملكة ؟
Dialogue: 0,0:10:47.11,0:10:49.41,all,,0000,0000,0000,,هذا التاج قد تم توارثه من جيل إلى آخر
Dialogue: 0,0:10:49.52,0:10:50.86,all,,0000,0000,0000,,أنه الكنز الأكثر قيمة في البلاد
Dialogue: 0,0:10:51.24,0:10:52.04,all,,0000,0000,0000,,... آوه
Dialogue: 0,0:10:52.24,0:10:53.45,all,,0000,0000,0000,, مثل هذا الشيء الرائع
Dialogue: 0,0:10:53.66,0:10:54.82,all,,0000,0000,0000,,لاتفعلها أيها المعلم
Dialogue: 0,0:10:55.53,0:10:57.12,all,,0000,0000,0000,,لن أقوم بسرقته
Dialogue: 0,0:10:57.16,0:10:58.02,all,,0000,0000,0000,,.. ليس كذلك
Dialogue: 0,0:10:58.43,0:11:00.97,all,,0000,0000,0000,,هنالك أجهزة أستشعار تعمل بالأشعة تحت الحمراء
Dialogue: 0,0:11:01.83,0:11:03.23,all,,0000,0000,0000,,... خطوه آخرى
Dialogue: 0,0:11:03.31,0:11:05.03,all,,0000,0000,0000,,وسيتم حبسك بالداخل بشكل آلي
Dialogue: 0,0:11:05.74,0:11:08.98,all,,0000,0000,0000,,ونحن حتى لانعرف كلمة السر للقفل
Dialogue: 0,0:11:09.41,0:11:10.05,all,,0000,0000,0000,,... أوه
Dialogue: 0,0:11:10.80,0:11:12.42,all,,0000,0000,0000,,ذلك سيكون مزعجً
Dialogue: 0,0:11:16.65,0:11:18.78,لوبين,,0000,0000,0000,,بالحقيقه ذلك شديداً للغاية
Dialogue: 0,0:11:18.99,0:11:22.63,لوبين,,0000,0000,0000,,الحماية دائماً مشددة جداً هناك
Dialogue: 0,0:11:23.06,0:11:24.08,لوبين,,0000,0000,0000,,... أولاً
Dialogue: 0,0:11:25.00,0:11:26.82,لوبين,,0000,0000,0000,,لنرى أن كانت هنالك أجهزه آخرى
Dialogue: 0,0:11:27.89,0:11:29.11,لوبين,,0000,0000,0000,,أجهزه للأستشعار بالوزن
Dialogue: 0,0:11:30.47,0:11:31.80,لوبين,,0000,0000,0000,,يجب أن نتجنب ذلك
Dialogue: 0,0:11:34.03,0:11:36.05,لوبين,,0000,0000,0000,,و أن كان هنالك أجهزة استشعار بالأشعه
Dialogue: 0,0:11:37.06,0:11:38.56,لوبين,,0000,0000,0000,,أن تمكنا وتجاوزنا ذلك
Dialogue: 0,0:11:40.07,0:11:42.26,لوبين,,0000,0000,0000,,لايزال هنالك الاستشعار الحراري
Dialogue: 0,0:11:43.10,0:11:45.30,لوبين,,0000,0000,0000,,كيف يمكننا أن نتفادى ذلك ؟
Dialogue: 0,0:11:45.81,0:11:49.00,all,,0000,0000,0000,,آي لصاً ذكي قد فشل في سرقته المرة الأخيرة ؟
Dialogue: 0,0:11:49.24,0:11:52.24,all,,0000,0000,0000,,وجعلهم يشددون الحراسة عليها
Dialogue: 0,0:11:52.24,0:11:54.21,لوبين,,0000,0000,0000,,ليس بسبب الفشل
Dialogue: 0,0:11:54.79,0:11:56.84,all,,0000,0000,0000,,إذاً , ماذا يجب أن نفعل ؟
Dialogue: 0,0:11:57.01,0:11:59.24,all,,0000,0000,0000,,لنستسلم فقط
Dialogue: 0,0:11:59.28,0:12:01.12,all,,0000,0000,0000,,... أستخدم مرتبي وأذهب في رحلة
Dialogue: 0,0:12:01.52,0:12:04.33,لوبين,,0000,0000,0000,,هل تعتقد بأنني سأستسلم بعد أن وصلنا لهذا الحد
Dialogue: 0,0:12:05.06,0:12:07.06,all,,0000,0000,0000,,لهذا أقول لك أننا بمشكلة
Dialogue: 0,0:12:07.06,0:12:08.67,لوبين,,0000,0000,0000,,أنظر لهذا , شويو
Dialogue: 0,0:12:09.40,0:12:10.82,all,,0000,0000,0000,,آينقصك المال مجدداً ؟
Dialogue: 0,0:12:11.10,0:12:13.82,all,,0000,0000,0000,,لا , هذا حجراً صغير
Dialogue: 0,0:12:14.20,0:12:16.07,لوبين,,0000,0000,0000,,أنه جالب الحظ لنا
Dialogue: 0,0:12:16.49,0:12:18.01,لوبين,,0000,0000,0000,,حجارة فيسبانيا
Dialogue: 0,0:12:21.99,0:12:26.91,حقوق 1,,0000,0000,0000,,{\pos(529,61)}ترجمة
Dialogue: 0,0:12:21.99,0:12:26.91,حقوق 2,,0000,0000,0000,,{\pos(531,111)} Khaled.M & Yusuf
Dialogue: 0,0:12:21.99,0:12:26.91,حقوق 1,,0000,0000,0000,,{\pos(115,437)}منتديات أنيميات
Dialogue: 0,0:12:21.99,0:12:26.91,حقوق 3,,0000,0000,0000,,{\pos(127,477)} www.animeiat.com\vb
Dialogue: 0,0:12:29.15,0:12:32.15,all,,0000,0000,0000,,هنا الرقم 2  \N لقد وصلنا إلى المجال الجوي
Dialogue: 0,0:12:32.79,0:12:34.87,all,,0000,0000,0000,,هل وصلنا أي خبر من المفتش زينيجاتا ؟
Dialogue: 0,0:12:35.29,0:12:37.25,all,,0000,0000,0000,,هنا القاعده , لم تصلنا آي آخبار
Dialogue: 0,0:12:40.09,0:12:46.00,all,,0000,0000,0000,,يا الهي... هذه فرصة جيدة لتكون مع الأستعرضيين والرياضيين
Dialogue: 0,0:12:46.21,0:12:48.13,all,,0000,0000,0000,,... المفتش زينيجاتا أنه
Dialogue: 0,0:12:48.17,0:12:50.63,كونان,,0000,0000,0000,,مازالتِ دائماً تحبين أن تفعلي ذلك , أختي سوزوكي
Dialogue: 0,0:12:51.17,0:12:53.42,all,,0000,0000,0000,,... أجل , هذا مزعج جداً
Dialogue: 0,0:12:54.07,0:12:56.38,كونان,,0000,0000,0000,,... قصدتكِ أنتِ , أنتِ
Dialogue: 0,0:12:57.04,0:12:58.88,all,,0000,0000,0000,,... لاتهتموا ... لاتهتموا
Dialogue: 0,0:12:59.18,0:13:00.14,all,,0000,0000,0000,,... بالحديث عن
Dialogue: 0,0:13:00.15,0:13:01.72,all,,0000,0000,0000,,ماالذي يقصده بالحديث عن ؟
Dialogue: 0,0:13:02.30,0:13:03.22,كونان,,0000,0000,0000,,أليس ذلك واضحاً ؟
Dialogue: 0,0:13:04.12,0:13:05.89,كونان,,0000,0000,0000,,... أنه يبحث عن الآنسة يوكو أوكينو
Dialogue: 0,0:13:06.39,0:13:07.43,all,,0000,0000,0000,,! ياللأزعاج
Dialogue: 0,0:13:09.35,0:13:10.52,ميرا,,0000,0000,0000,,! هل هنالك خطبً ما
Dialogue: 0,0:13:10.69,0:13:12.66,ميرا,,0000,0000,0000,,! أقامة حفلةً في هذا الوقت
Dialogue: 0,0:13:13.09,0:13:14.22,ميرا,,0000,0000,0000,,... أظن بأنني قلت لا
Dialogue: 0,0:13:14.02,0:13:15.14,كيث,,0000,0000,0000,,... أنا أفهم ذلك , أيتها الأميرة
Dialogue: 0,0:13:16.06,0:13:16.94,كيث,,0000,0000,0000,,... إذاً
Dialogue: 0,0:13:17.05,0:13:20.06,كيث,,0000,0000,0000,,أوقفي الحفلة التي قامت بتنظيمها والدتكِ
Dialogue: 0,0:13:20.32,0:13:23.07,كيث,,0000,0000,0000,,... لندع أولئك الضيوف الحزينين
Dialogue: 0,0:13:23.16,0:13:25.30,كيث,,0000,0000,0000,,... أن لايقولوا شيءً ويعودو
Dialogue: 0,0:13:24.94,0:13:26.16,ميرا,,0000,0000,0000,,! أصمت
Dialogue: 0,0:13:27.26,0:13:28.39,all,,0000,0000,0000,,أيتها الأميرة
Dialogue: 0,0:13:30.86,0:13:32.69,كيث,,0000,0000,0000,,حان الوقت تقريباً
Dialogue: 0,0:13:32.94,0:13:34.28,كيث,,0000,0000,0000,,بسرعه ساعدوا الأميرة
Dialogue: 0,0:13:35.01,0:13:35.49,all,,0000,0000,0000,,حاضر
Dialogue: 0,0:13:37.08,0:13:38.28,all,,0000,0000,0000,,أميرة ميرا
Dialogue: 0,0:13:40.28,0:13:41.29,ميرا,,0000,0000,0000,,ياللأزعاج
Dialogue: 0,0:13:43.49,0:13:44.87,كونان,,0000,0000,0000,,إذاً , هل الآنسه يوكو هنا ؟
Dialogue: 0,0:13:45.12,0:13:46.49,all,,0000,0000,0000,,لم أجدها
Dialogue: 0,0:13:51.03,0:13:53.26,more,,0000,0000,0000,,آسفون لجعلكم تنتظرون
Dialogue: 0,0:13:53.55,0:13:57.60,more,,0000,0000,0000,,رجاءً قوموا بالترحيب بضيفتنا الخاصه
Dialogue: 0,0:13:58.10,0:14:01.10,more,,0000,0000,0000,,من بلاد فيسبانيا , أقدم لكم الأميرة ميرا
Dialogue: 0,0:14:01.21,0:14:03.11,more,,0000,0000,0000,,رجاءً رحبوا بضيفتنا المفاجئه
Dialogue: 0,0:14:03.11,0:14:04.27,more,,0000,0000,0000,,هاهي الأميرة ميرا
Dialogue: 0,0:14:04.59,0:14:05.61,all,,0000,0000,0000,,... الأميرة قد خرجت
Dialogue: 0,0:14:05.81,0:14:08.11,all,,0000,0000,0000,,يجب الأنتباه لأي حركة مشبوهه من المدعوين
Dialogue: 0,0:14:08.11,0:14:11.27,all,,0000,0000,0000,,يجب عليكم أكتشاف الاشخاص الذين يحاولون عرقلة الاحتفال
Dialogue: 0,0:14:12.26,0:14:12.78,all,,0000,0000,0000,,. مفهوم
Dialogue: 0,0:14:13.28,0:14:15.09,all,,0000,0000,0000,,. هنا المدخل الرئيسي
Dialogue: 0,0:14:15.46,0:14:17.13,all,,0000,0000,0000,,لم يعبر أحد خلال الوقت الراهن
Dialogue: 0,0:14:17.67,0:14:19.76,all,,0000,0000,0000,,جاء بعض المدعوين من الباب الآخر
Dialogue: 0,0:14:20.09,0:14:21.29,all,,0000,0000,0000,,هل تسمعني ؟
Dialogue: 0,0:14:21.29,0:14:22.29,all,,0000,0000,0000,,. مفهوم
Dialogue: 0,0:14:23.03,0:14:24.59,all,,0000,0000,0000,,. تفضلي من فضلك
Dialogue: 0,0:14:32.64,0:14:33.25,كونان,,0000,0000,0000,,. ران
Dialogue: 0,0:14:33.80,0:14:35.22,all,,0000,0000,0000,,. أنها تشبه ران
Dialogue: 0,0:14:35.71,0:14:36.52,all,,0000,0000,0000,,هاه ؟
Dialogue: 0,0:14:38.08,0:14:40.07,all,,0000,0000,0000,,ران لايمكن أن تكون هنا
Dialogue: 0,0:14:43.44,0:14:46.05,ران,,0000,0000,0000,,اللعنة ! هل أصبت بالزكام بعد الأستحمام ؟
Dialogue: 0,0:14:47.90,0:14:49.73,ران,,0000,0000,0000,,آه , لقد تأخر الوقت بالفعل
Dialogue: 0,0:14:50.52,0:14:52.86,ران,,0000,0000,0000,,هل مازالت سونكو تتذكر ؟
Dialogue: 0,0:14:54.23,0:14:58.18,all,,0000,0000,0000,,اهـ ... أيتها الأميرة ميرا هل تريدين قول بعض الكلمات ؟
Dialogue: 0,0:15:04.00,0:15:07.57,كيث,,0000,0000,0000,,هذه المره الأول للأميرة ميرا أن تأتي إلى هنا لذلك هي خجولة قليلاً
Dialogue: 0,0:15:07.95,0:15:10.66,all,,0000,0000,0000,,هيه , الرجل الذي بالخلف قد تحدث
Dialogue: 0,0:15:11.53,0:15:13.37,all,,0000,0000,0000,,الأميرة لا تبدو مبتهجه
Dialogue: 0,0:15:13.74,0:15:15.91,all,,0000,0000,0000,,حتى لو كانت أميرة البلاد
Dialogue: 0,0:15:16.18,0:15:19.15,all,,0000,0000,0000,,هل كانت ستأتي إلى حفل أفتتاح الفندق ؟
Dialogue: 0,0:15:19.29,0:15:22.33,كونان,,0000,0000,0000,,أسم هذا الفندق ساكورا ساكو
Dialogue: 0,0:15:23.09,0:15:24.62,كونان,,0000,0000,0000,,... الملكة المتوفاه ساكورا كانت تحب
Dialogue: 0,0:15:25.06,0:15:28.06,كونان,,0000,0000,0000,,. أزهار الساكورا اليابانية , وأيضاً أسم هذا الفندق
Dialogue: 0,0:15:29.09,0:15:32.09,كونان,,0000,0000,0000,,وعند بوابة الفندق قد أستخدموا الساكورا
Dialogue: 0,0:15:32.30,0:15:34.23,كونان,,0000,0000,0000,,لو لم تحدث تلك الحادثة
Dialogue: 0,0:15:34.50,0:15:36.80,كونان,,0000,0000,0000,,لكانت أفتتحت هذا الفندق بنفسها
Dialogue: 0,0:15:37.14,0:15:40.54,كونان,,0000,0000,0000,,عادة , كان على الأميرة الغاء الزيارة إلى اليابان
Dialogue: 0,0:15:41.14,0:15:42.63,كونان,,0000,0000,0000,,... لكن, أعتقد أن بلاد فيسبانيا
Dialogue: 0,0:15:42.84,0:15:46.01,كونان,,0000,0000,0000,,تريد بناء علاقة مع اليابان لتقوية المصالح
Dialogue: 0,0:15:47.08,0:15:48.64,كونان,,0000,0000,0000,,... هذا مؤسف
Dialogue: 0,0:15:50.21,0:15:52.12,all,,0000,0000,0000,,آي مكان ترغب بزيارته في اليابان ؟
Dialogue: 0,0:15:52.12,0:15:53.35,كيث,,0000,0000,0000,,... الأميرة ميرا
Dialogue: 0,0:15:53.35,0:15:55.12,كيث,,0000,0000,0000,,ترغب دائماً بزيارة طوكيو
Dialogue: 0,0:15:57.16,0:15:59.85,all,,0000,0000,0000,,حسناً إذاً , مالأكله اليابانية التي تفضلها ؟
Dialogue: 0,0:16:00.27,0:16:02.57,كيث,,0000,0000,0000,,الأميرة تحب السوشي
Dialogue: 0,0:16:03.18,0:16:05.52,all,,0000,0000,0000,,! مالأمر , ذلك الشاب يجيب عنها دائماً
Dialogue: 0,0:16:05.72,0:16:06.94,all,,0000,0000,0000,,... ساعدني و أحمل هذا
Dialogue: 0,0:16:07.23,0:16:08.85,all,,0000,0000,0000,,أريد الذهاب لدورة المياة
Dialogue: 0,0:16:09.37,0:16:12.13,كونان,,0000,0000,0000,,! ماهذا ! تجعل طفلاً صغيراً يحمل شرابك
Dialogue: 0,0:16:12.81,0:16:14.02,all,,0000,0000,0000,,... هيا جميعاً
Dialogue: 0,0:16:14.23,0:16:17.35,all,,0000,0000,0000,,لنحظى بهذا النخب مع الأميرة ميرا
Dialogue: 0,0:16:18.04,0:16:20.24,all,,0000,0000,0000,,الآن فليرفع الجميع شرابه
Dialogue: 0,0:16:20.24,0:16:23.15,all,,0000,0000,0000,,ألا يوجد شراب فاكهه هنا ؟
Dialogue: 0,0:16:23.15,0:16:25.86,كونان,,0000,0000,0000,,آه دعيني أحضر لكِ واحداً
Dialogue: 0,0:16:26.12,0:16:28.15,all,,0000,0000,0000,,آه شكراً لك
Dialogue: 0,0:16:28.15,0:16:31.29,كونان,,0000,0000,0000,,آه , حقاً , لقد كانت نواياكِ من البدايه أن أحضر لكِ شرابً
Dialogue: 0,0:16:47.77,0:16:49.11,all,,0000,0000,0000,,... إذاً أيتها الأميرة ميرا
Dialogue: 0,0:16:49.11,0:16:51.24,all,,0000,0000,0000,,هل تريدين قول شيءً من أجل النخب
Dialogue: 0,0:16:51.24,0:16:52.18,more,,0000,0000,0000,,... أيتها الأميرة ميرا
Dialogue: 0,0:16:52.18,0:16:53.93,more,,0000,0000,0000,,هل تريدين قول شيءً من أجل النخب
Dialogue: 0,0:16:55.46,0:16:56.88,كونان,,0000,0000,0000,,! لاتشربي منه
Dialogue: 0,0:16:59.05,0:17:01.18,كونان,,0000,0000,0000,,... أنا آسف أيتها الأميرة
Dialogue: 0,0:17:01.71,0:17:03.12,كونان,,0000,0000,0000,,... لكن قبل ذلك
Dialogue: 0,0:17:03.70,0:17:06.65,كونان,,0000,0000,0000,,هل يمكنكِ أعطائه إلى الساقي لكي يشرب منه أولاً
Dialogue: 0,0:17:09.28,0:17:10.67,all,,0000,0000,0000,,... ليمسكه أحدكم
Dialogue: 0,0:17:10.96,0:17:12.70,all,,0000,0000,0000,,لقد سرق ملابسي
Dialogue: 0,0:17:12.90,0:17:13.62,كيث,,0000,0000,0000,,... أمسكوه
Dialogue: 0,0:17:16.03,0:17:17.55,all,,0000,0000,0000,,... أبتعدوا رجاءً
Dialogue: 0,0:17:18.48,0:17:20.20,all,,0000,0000,0000,,أرجو منكم الهدوء جميعاً
Dialogue: 0,0:17:20.20,0:17:22.12,all,,0000,0000,0000,,!لاتتدافعوا هكذا ! ذلك خطر
Dialogue: 0,0:17:26.28,0:17:27.41,all,,0000,0000,0000,,... أبتعد
Dialogue: 0,0:17:27.59,0:17:29.73,كونان,,0000,0000,0000,,... عمي أوقف ذلك الرجل
Dialogue: 0,0:17:38.40,0:17:41.16,all,,0000,0000,0000,,! .. لاتعبث مع المحقق توقو موري
Dialogue: 0,0:17:41.29,0:17:44.68,all,,0000,0000,0000,,تـ .. توقف أنا لم انتهي من الكلام بعد
Dialogue: 0,0:17:45.66,0:17:49.51,all,,0000,0000,0000,,وجدنا أثاراً للسم في شراب الأميرة
Dialogue: 0,0:17:50.32,0:17:51.73,all,,0000,0000,0000,,... سيد كيث
Dialogue: 0,0:17:52.43,0:17:54.16,all,,0000,0000,0000,,المفاجأة كانت رائعه
Dialogue: 0,0:17:54.48,0:17:58.18,all,,0000,0000,0000,,لكن أن كنت تخبئ شيءً عنا , لن تكون هنالك حراسة كافية من الشرطة
Dialogue: 0,0:17:59.08,0:18:02.43,كيث,,0000,0000,0000,,أعتقد أن أعضاء الـ             قاموا بما عليهم وهم كافون
Dialogue: 0,0:17:59.08,0:18:02.43,EE,,0000,0000,0000,,{\pos(351,470)}SP
Dialogue: 0,0:18:03.11,0:18:04.17,all,,0000,0000,0000,,!كافون ؟
Dialogue: 0,0:18:04.66,0:18:07.29,all,,0000,0000,0000,,ماذا عن أفراد الشرطة الذي يستطلعون المطبخ الآن
Dialogue: 0,0:18:07.38,0:18:08.30,all,,0000,0000,0000,,تاكاجي
Dialogue: 0,0:18:09.49,0:18:10.79,كيث,,0000,0000,0000,,... أولاً
Dialogue: 0,0:18:11.51,0:18:15.06,كيث,,0000,0000,0000,,نحن لانترك آي شخصاً يقترب من شراب أو طعام الأميرة في الحفلة
Dialogue: 0,0:18:15.23,0:18:17.26,كيث,,0000,0000,0000,,لقد ناقشنا ذلك من قبل
Dialogue: 0,0:18:17.64,0:18:18.37,كيث,,0000,0000,0000,,... لكن
Dialogue: 0,0:18:19.75,0:18:22.18,كيث,,0000,0000,0000,,... الشخصان ... اللذان أخبراني
Dialogue: 0,0:18:28.54,0:18:29.35,all,,0000,0000,0000,,سيدتي ميرا
Dialogue: 0,0:18:31.18,0:18:32.24,ميرا,,0000,0000,0000,,! لا
Dialogue: 0,0:18:32.51,0:18:36.87,all,,0000,0000,0000,,رجاءً .. لاتقلقي هذا الماء نحن من قمنا بتجهيزه
Dialogue: 0,0:18:38.98,0:18:40.49,ميرا,,0000,0000,0000,,! يكفي هذا غادرا الغرفة
Dialogue: 0,0:18:41.01,0:18:42.02,ميرا,,0000,0000,0000,,دعوني لوحدي
Dialogue: 0,0:18:47.69,0:18:49.26,all,,0000,0000,0000,,سنكون أمام الباب
Dialogue: 0,0:18:49.62,0:18:52.05,all,,0000,0000,0000,,رجاءً نادينا عندما تهدئين
Dialogue: 0,0:19:04.05,0:19:04.66,ميرا,,0000,0000,0000,,... أمي
Dialogue: 0,0:19:06.08,0:19:06.69,ميرا,,0000,0000,0000,,هذا مستحيل
Dialogue: 0,0:19:08.18,0:19:11.18,ميرا,,0000,0000,0000,,... هذا ليس ملائماً لي
Dialogue: 0,0:19:16.09,0:19:17.50,all,,0000,0000,0000,,أبقوا أعيُنكم عليها
Dialogue: 0,0:19:18.69,0:19:19.73,all,,0000,0000,0000,,لاتدعو آي شخصاً يدخل
Dialogue: 0,0:19:20.88,0:19:21.41,all,,0000,0000,0000,,عُلم
Dialogue: 0,0:19:28.63,0:19:29.56,ميرا,,0000,0000,0000,,... هذا يكفي
Dialogue: 0,0:19:30.86,0:19:31.55,ميرا,,0000,0000,0000,,لايمكنني ذلك
Dialogue: 0,0:19:37.37,0:19:39.54,all,,0000,0000,0000,,لقد أعترف الشخص الذي حاول أغتيال الأميرة
Dialogue: 0,0:19:39.58,0:19:41.71,all,,0000,0000,0000,,لقد دُفع له المال ليفعل ذلك
Dialogue: 0,0:19:42.22,0:19:43.32,all,,0000,0000,0000,,... وكمزحه
Dialogue: 0,0:19:43.53,0:19:45.64,all,,0000,0000,0000,,قيل له أنه تم وضع مسهل فقط
Dialogue: 0,0:19:46.15,0:19:48.22,all,,0000,0000,0000,,أنه يقول الحقيقة الآن
Dialogue: 0,0:19:48.46,0:19:50.01,all,,0000,0000,0000,,ماذا عن الشئ الذي طلبت منك استكشافه ؟
Dialogue: 0,0:19:50.55,0:19:53.59,all,,0000,0000,0000,,أعتقد بأن أول شخصاً قد شاهدته كان أجنبي
Dialogue: 0,0:19:54.13,0:19:55.58,all,,0000,0000,0000,,اللعنة
Dialogue: 0,0:19:55.90,0:19:59.43,all,,0000,0000,0000,,سيفعل اي شيءً من أجل المال
Dialogue: 0,0:20:00.20,0:20:02.23,all,,0000,0000,0000,,طبقاً لمعلوماتنا هنا
Dialogue: 0,0:20:02.23,0:20:05.23,all,,0000,0000,0000,,لقد كانت هنالك مقالة قاسية كتبت ضد جماعة الأميرة
Dialogue: 0,0:20:06.17,0:20:09.17,all,,0000,0000,0000,,هل يمكنكم حماية الأميرة لوحدكم ؟
Dialogue: 0,0:20:09.43,0:20:10.45,كيث,,0000,0000,0000,,... في هذه الحالة
Dialogue: 0,0:20:10.56,0:20:14.99,كيث,,0000,0000,0000,,ليس لدينا معروف نريد طلبه من الشرطة اليابانية
Dialogue: 0,0:20:15.15,0:20:17.01,all,,0000,0000,0000,,بالحديث عن هذا , كونان
Dialogue: 0,0:20:17.01,0:20:19.64,all,,0000,0000,0000,,... عندما علمت أن ذلك الشخص محتال
Dialogue: 0,0:20:20.13,0:20:21.35,all,,0000,0000,0000,,كيف عرفت ذلك ؟
Dialogue: 0,0:20:21.75,0:20:25.08,كونان,,0000,0000,0000,,عندما قد مررت بجانب الساقي
Dialogue: 0,0:20:25.16,0:20:27.19,كونان,,0000,0000,0000,,شممت رائحة الدخان
Dialogue: 0,0:20:27.68,0:20:31.32,كونان,,0000,0000,0000,,ولقد سمعت أن موظفي الفنادق عالية المستوى لايسمح لهم بالتدخين
Dialogue: 0,0:20:31.53,0:20:33.23,كونان,,0000,0000,0000,,لذلك أعتقدت أن ذلك غريب
Dialogue: 0,0:20:33.64,0:20:36.07,كونان,,0000,0000,0000,,أليس هذا فندق عالي المستوى
Dialogue: 0,0:20:36.33,0:20:39.97,all,,0000,0000,0000,,ولكن , من الممكن أن يكون هنا بعض الموظفين الذين يدخنون
Dialogue: 0,0:20:40.38,0:20:45.46,all,,0000,0000,0000,,لذلك على الأقل قبل أن يسكب الشراب للأميرة , عليه أن يتجنب التدخين
Dialogue: 0,0:20:46.04,0:20:50.47,all,,0000,0000,0000,,لكن ليس العديد من الأشخاص يدركون أنهم يدخنون قبل أرتكابهم للجريمة
Dialogue: 0,0:20:51.71,0:20:53.53,all,,0000,0000,0000,,عملاً جيد يا كونان
Dialogue: 0,0:20:58.51,0:20:59.26,all,,0000,0000,0000,,! أيتها الأميرة
Dialogue: 0,0:20:59.52,0:21:00.53,all,,0000,0000,0000,,الأميرة ميرا
Dialogue: 0,0:21:02.61,0:21:03.42,all,,0000,0000,0000,,هل هنالك حريق ؟
Dialogue: 0,0:21:03.62,0:21:05.24,all,,0000,0000,0000,,... لا , لايوجد حريق في اي مكان
Dialogue: 0,0:21:06.10,0:21:08.02,all,,0000,0000,0000,,نحن لانستطيع إيجاد الاميرة ميرا في اي مكان
Dialogue: 0,0:21:08.13,0:21:08.83,all,,0000,0000,0000,,!.. أنتم
Dialogue: 0,0:21:09.41,0:21:11.13,all,,0000,0000,0000,,!أتفقد أحدكم المصعد ؟
Dialogue: 0,0:21:11.14,0:21:12.27,all,,0000,0000,0000,,... آه , لاأحد
Dialogue: 0,0:21:12.76,0:21:13.17,all,,0000,0000,0000,,... هيا
Dialogue: 0,0:21:14.73,0:21:15.45,all,,0000,0000,0000,,!.. الأميرة ميرا
Dialogue: 0,0:21:21.21,0:21:22.71,all,,0000,0000,0000,,... أنا آسف سيدي
Dialogue: 0,0:21:22.80,0:21:23.52,all,,0000,0000,0000,,لنستعمل السلالم
Dialogue: 0,0:21:24.12,0:21:26.25,all,,0000,0000,0000,,سننزل عن طريق السلالم
Dialogue: 0,0:21:26.56,0:21:27.80,all,,0000,0000,0000,,!بسرعه أتصل باللذين بالأسفل
Dialogue: 0,0:21:28.02,0:21:28.96,all,,0000,0000,0000,,ليبقوا أعينهم على الطابق السفلي
Dialogue: 0,0:21:28.98,0:21:29.48,all,,0000,0000,0000,,عُلم
Dialogue: 0,0:21:29.82,0:21:31.24,all,,0000,0000,0000,,أنت أبقى هنا وأنتبه للمصعد
Dialogue: 0,0:21:32.06,0:21:33.35,all,,0000,0000,0000,,وأخبرنا أين يتوقف
Dialogue: 0,0:21:33.47,0:21:33.96,all,,0000,0000,0000,,عُلم
Dialogue: 0,0:22:41.39,0:22:43.62,all,,0000,0000,0000,,!.. أنذار الحريق قد أطلق بأستخدام القداحة
Dialogue: 0,0:22:44.06,0:22:47.06,كونان,,0000,0000,0000,,وهربت عن طريق الغرفة الأخرى عندما حلت الفوضى
Dialogue: 0,0:22:48.10,0:22:50.23,all,,0000,0000,0000,,هذا كثيراً جداً
Dialogue: 0,0:22:50.23,0:22:52.24,all,,0000,0000,0000,,هل يجب أن نجعل أفراد الشرطه تمشط المكان ؟
Dialogue: 0,0:22:52.41,0:22:53.54,كيث,,0000,0000,0000,,... لاحاجة لذالك
Dialogue: 0,0:22:54.14,0:22:56.57,all,,0000,0000,0000,,! الوقت متأخر جداً سيحدث أي شيء
Dialogue: 0,0:22:59.41,0:23:00.21,all,,0000,0000,0000,,التقرير , سيدي
Dialogue: 0,0:23:00.45,0:23:02.88,all,,0000,0000,0000,,... لقد وجدنا الأميرة ميرا
Dialogue: 0,0:23:03.15,0:23:04.00,all,,0000,0000,0000,,سنعيدها الآن
Dialogue: 0,0:23:07.91,0:23:08.52,all,,0000,0000,0000,,... سيدتي ميرا
Dialogue: 0,0:23:12.12,0:23:14.15,ران,,0000,0000,0000,,هل أنتهت الحفلة الآن ؟
Dialogue: 0,0:23:17.19,0:23:18.72,ران,,0000,0000,0000,,... أنا آسفه
Dialogue: 0,0:23:18.87,0:23:22.00,ميرا,,0000,0000,0000,,! ... هيه , أنظري إلى أين تسـ
Dialogue: 0,0:23:30.01,0:23:31.21,all,,0000,0000,0000,,! حسناً , لنعد الآن
Dialogue: 0,0:23:31.21,0:23:34.21,ميرا,,0000,0000,0000,,! لا , أتركني , أتركني
Dialogue: 0,0:23:34.74,0:23:37.29,all,,0000,0000,0000,,... سيدتي ميرا , أرجوكِ تعاوني معنا
Dialogue: 0,0:23:38.05,0:23:40.12,ران,,0000,0000,0000,,... أمم , أتركها
Dialogue: 0,0:23:40.12,0:23:41.42,ران,,0000,0000,0000,,!.. أنها لاتريدك
Dialogue: 0,0:23:44.86,0:23:48.13,all,,0000,0000,0000,,أنا آسف , لكن لاعلاقة لكِ بذالك
Dialogue: 0,0:23:48.26,0:23:49.23,ميرا,,0000,0000,0000,,... ساعديني
Dialogue: 0,0:23:49.40,0:23:52.24,ميرا,,0000,0000,0000,,! هذا الشخص مزعجاً جداً
Dialogue: 0,0:23:52.42,0:23:53.26,ران,,0000,0000,0000,,بسرعه أتركها
Dialogue: 0,0:23:53.97,0:23:54.49,all,,0000,0000,0000,,... لا
Dialogue: 0,0:23:55.39,0:23:56.81,all,,0000,0000,0000,,... توقفي
Dialogue: 0,0:24:04.70,0:24:05.31,ران,,0000,0000,0000,,! بسرعه
Dialogue: 0,0:24:07.91,0:24:08.75,all,,0000,0000,0000,,! مستحيل
Dialogue: 0,0:24:10.15,0:24:11.67,كيث,,0000,0000,0000,,... ماذا ؟ أيها
Dialogue: 0,0:24:12.25,0:24:13.26,كيث,,0000,0000,0000,,!ماذا فعلت ؟
Dialogue: 0,0:24:13.75,0:24:14.59,all,,0000,0000,0000,,تاكاجي
Dialogue: 0,0:24:15.09,0:24:15.60,all,,0000,0000,0000,,حاضر
Dialogue: 0,0:24:16.05,0:24:17.31,all,,0000,0000,0000,,جهز مقراً للشرطه
Dialogue: 0,0:24:17.92,0:24:19.26,all,,0000,0000,0000,,مفهوم
Dialogue: 0,0:24:19.45,0:24:20.66,all,,0000,0000,0000,,... مقر للشرطه
Dialogue: 0,0:24:21.27,0:24:25.00,all,,0000,0000,0000,,لقد أستلمنا الطلب الرسمي من بلاد فيسبانيا
Dialogue: 0,0:24:25.38,0:24:26.39,all,,0000,0000,0000,,هل أنت متأكد أن لابأس بهذا ؟
Dialogue: 0,0:24:30.17,0:24:32.98,كونان,,0000,0000,0000,,المعذرة , هل يمكنكِ مساعدتي ؟
Dialogue: 0,0:24:33.44,0:24:35.70,all,,0000,0000,0000,,حسناً , أنتظر قليلاً
Dialogue: 0,0:24:38.53,0:24:39.86,all,,0000,0000,0000,,... آسفه لجعلك تنتظر
Dialogue: 0,0:24:40.47,0:24:41.69,all,,0000,0000,0000,,هل هذه هي ؟
Dialogue: 0,0:24:43.19,0:24:44.84,كونان,,0000,0000,0000,,أجل , شكراً لكِ
Dialogue: 0,0:24:51.19,0:24:51.89,ران,,0000,0000,0000,,... آه
Dialogue: 0,0:24:52.70,0:24:54.32,ران,,0000,0000,0000,, أنتِ حقاً أميرة ؟
Dialogue: 0,0:24:56.75,0:24:58.26,ميرا,,0000,0000,0000,,هل لديك رد فعل مثل ذلك ؟
Dialogue: 0,0:24:58.57,0:25:00.91,ران,,0000,0000,0000,,!.. بالطبع
Dialogue: 0,0:25:03.95,0:25:06.29,ران,,0000,0000,0000,,... إذاً , الرجل الذي قبل قليل
Dialogue: 0,0:25:07.07,0:25:08.61,ميرا,,0000,0000,0000,,حارسي الشخصي
Dialogue: 0,0:25:09.14,0:25:10.40,ران,,0000,0000,0000,,! بالطبع , أنه كذالك
Dialogue: 0,0:25:11.28,0:25:14.01,ران,,0000,0000,0000,,! سوف أذهب وأعتذر , هيا لنذهب ونعد بسرعه
Dialogue: 0,0:25:14.22,0:25:15.11,ميرا,,0000,0000,0000,,... توقفي
Dialogue: 0,0:25:15.34,0:25:17.25,ميرا,,0000,0000,0000,,لقد هربت لأنني لاأريد البقاء هناك
Dialogue: 0,0:25:17.74,0:25:18.87,ميرا,,0000,0000,0000,,لن أعود
Dialogue: 0,0:25:19.07,0:25:19.97,ران,,0000,0000,0000,,! لايمكن
Dialogue: 0,0:25:20.35,0:25:22.23,ران,,0000,0000,0000,,لماذا تريدين الفرار بعيداً ؟
Dialogue: 0,0:25:25.23,0:25:26.22,ميرا,,0000,0000,0000,,أكره الحفلات
Dialogue: 0,0:25:27.95,0:25:29.60,ران,,0000,0000,0000,,... أنا أيضاً أرغب بقول مثل هذه الكلمات
Dialogue: 0,0:25:29.89,0:25:31.31,ميرا,,0000,0000,0000,,هل لديكِ علبة دخان ؟
Dialogue: 0,0:25:31.74,0:25:35.26,ران,,0000,0000,0000,,علبة دخان ؟! أنا مازالت تحت السن القانونية ! كيف يمكن أن أحمله ؟
Dialogue: 0,0:25:35.76,0:25:36.48,ميرا,,0000,0000,0000,,كم عمركِ ؟
Dialogue: 0,0:25:36.77,0:25:37.81,ران,,0000,0000,0000,,سبعة عشر سنة
Dialogue: 0,0:25:38.48,0:25:39.69,ران,,0000,0000,0000,,السنة الثانية في مدرسة تيتانكو العليا
Dialogue: 0,0:25:39.89,0:25:41.95,ران,,0000,0000,0000,,أنا مازلت في المرحلة الثانوية
Dialogue: 0,0:25:42.24,0:25:43.48,ميرا,,0000,0000,0000,,هل يجب أن تتصرفي هكذا ؟
Dialogue: 0,0:25:43.65,0:25:45.16,ران,,0000,0000,0000,,... أليس من الأفضل أن نعود
Dialogue: 0,0:25:45.56,0:25:47.50,ران,,0000,0000,0000,,الحفله مازالت مستمره إلى الآن
Dialogue: 0,0:25:47.96,0:25:49.81,ميرا,,0000,0000,0000,,! لا , لقد قلت لكِ لا
Dialogue: 0,0:25:50.77,0:25:54.29,ميرا,,0000,0000,0000,,نحن متشابهتان , بالحقيقه أنا أكبر منكِ بسنتين
Dialogue: 0,0:25:54.87,0:25:56.29,ران,,0000,0000,0000,,إذاً عمركِ 19 سنة
Dialogue: 0,0:25:57.04,0:25:59.04,ران,,0000,0000,0000,,! ومازالتِ تحت السن القانونية
Dialogue: 0,0:25:59.50,0:26:03.12,ميرا,,0000,0000,0000,,في فيسبانيا , عندما تصلين إلى سن السابعه عشر \N يكون بأمكانكِ التدخين والشراب
Dialogue: 0,0:26:03.43,0:26:04.44,ران,,0000,0000,0000,,هكذا إذاً ؟
Dialogue: 0,0:26:09.30,0:26:09.82,ميرا,,0000,0000,0000,,مالأمر ؟
Dialogue: 0,0:26:10.84,0:26:12.05,ران,,0000,0000,0000,,.. أنا فقط متفاجأه
Dialogue: 0,0:26:12.97,0:26:15.00,ران,,0000,0000,0000,,!.. أن الأميرة تدخن
Dialogue: 0,0:26:15.38,0:26:17.40,ميرا,,0000,0000,0000,,أنا آسفه لأفساد صورة الأميرات بنظركِ
Dialogue: 0,0:26:18.18,0:26:19.94,ميرا,,0000,0000,0000,,لكن ألا يمكن للأميرة أن تدخن ؟
Dialogue: 0,0:26:20.46,0:26:23.30,ران,,0000,0000,0000,,أنا مازلت أنسانه كما تعرفين , ولست دمية
Dialogue: 0,0:26:23.91,0:26:26.02,ران,,0000,0000,0000,,... أنا آسفة , لم أكن أقصدها بتلك الطريقة
Dialogue: 0,0:26:26.51,0:26:28.94,ميرا,,0000,0000,0000,,لاتهتمي  , أنا معتاده على هذا
Dialogue: 0,0:26:29.57,0:26:30.96,ميرا,,0000,0000,0000,,الجميع يقول ذلك
Dialogue: 0,0:26:33.01,0:26:36.25,ران,,0000,0000,0000,,... لكن هذا حلم جميع الفتيات
Dialogue: 0,0:26:37.35,0:26:40.27,ران,,0000,0000,0000,,أن يصبحنا أميرات
Dialogue: 0,0:26:40.59,0:26:43.02,ران,,0000,0000,0000,,... حلم الجميع
Dialogue: 0,0:26:48.48,0:26:49.58,ميرا,,0000,0000,0000,,... أتريدين أن تصبحي
Dialogue: 0,0:26:50.28,0:26:50.91,ميرا,,0000,0000,0000,,أميرة ؟
Dialogue: 0,0:26:52.30,0:26:54.44,ران,,0000,0000,0000,,أنتـ . أنتظري ! ماذا .. ؟
Dialogue: 0,0:26:56.38,0:26:57.07,all,,0000,0000,0000,,المفتش ميقوري
Dialogue: 0,0:26:57.28,0:26:58.61,all,,0000,0000,0000,,لقد تمت التجهيزات
Dialogue: 0,0:26:59.50,0:27:02.45,all,,0000,0000,0000,,بهذه الطريقة , بالتأكيد سنجد الأميرة
Dialogue: 0,0:27:02.86,0:27:05.49,all,,0000,0000,0000,,هيه , تاكاجي , هل رأيت كونان ؟
Dialogue: 0,0:27:06.01,0:27:07.51,all,,0000,0000,0000,,أليس كونان هنا ؟
Dialogue: 0,0:27:08.15,0:27:10.78,all,,0000,0000,0000,,ذالك الفتى , يجري بالأرجاء مجدداً
Dialogue: 0,0:27:13.44,0:27:15.26,ران,,0000,0000,0000,,أنتظري .. ماذا تفعلين ؟
Dialogue: 0,0:27:15.58,0:27:17.20,ميرا,,0000,0000,0000,,.. أهدائي , أهدائي
Dialogue: 0,0:27:18.90,0:27:20.44,ميرا,,0000,0000,0000,,جسدي أكبر بقليل من جسدك
Dialogue: 0,0:27:21.94,0:27:24.23,ميرا,,0000,0000,0000,,أصمتِ , يجب أن تطيعي أوامر معلمتكِ
Dialogue: 0,0:27:24.23,0:27:26.37,ران,,0000,0000,0000,,! لكن .. لايمكـ .. لايمكنكِ
Dialogue: 0,0:27:33.25,0:27:34.75,ميرا,,0000,0000,0000,,حسناً , يمكنكِ تركه الآن
Dialogue: 0,0:27:37.59,0:27:38.80,ميرا,,0000,0000,0000,,!كيف هو الآن ؟
Dialogue: 0,0:27:40.10,0:27:42.85,ميرا,,0000,0000,0000,,من الآن وصاعداً , أنتِ الأميرة , حسناً ؟
Dialogue: 0,0:27:46.49,0:27:48.02,ران,,0000,0000,0000,,!هذه أنا ؟
Dialogue: 0,0:27:50.22,0:27:50.92,ران,,0000,0000,0000,,... لايمكن
Dialogue: 0,0:27:53.06,0:27:53.98,ران,,0000,0000,0000,,... أيتها الأميرة
Dialogue: 0,0:27:55.72,0:27:57.83,all,,0000,0000,0000,,سوف أعود عندما تنتهي الحفلة
Dialogue: 0,0:27:58.46,0:28:00.49,ران,,0000,0000,0000,,!لايمكن ؟ وماذا بشأني ؟
Dialogue: 0,0:28:01.41,0:28:02.71,ميرا,,0000,0000,0000,,... هيا عودي بسرعه
Dialogue: 0,0:28:02.83,0:28:05.35,ميرا,,0000,0000,0000,,الحراس الشخصيون سيمسكونكِ قريباً
Dialogue: 0,0:28:07.08,0:28:08.21,ران,,0000,0000,0000,,... لايمكن
Dialogue: 0,0:28:10.84,0:28:12.86,ميرا,,0000,0000,0000,,من سيعود ؟
Dialogue: 0,0:28:21.28,0:28:22.52,كونان,,0000,0000,0000,,لقد تعبت
Dialogue: 0,0:28:23.10,0:28:24.60,كونان,,0000,0000,0000,,... أعتقدت بأن البحث
Dialogue: 0,0:28:24.81,0:28:26.54,كونان,,0000,0000,0000,,عن شخص يرتدي فستان سهلاً جداً
Dialogue: 0,0:28:28.88,0:28:31.72,كونان,,0000,0000,0000,,! أختي ران , أختي ران
Dialogue: 0,0:28:32.64,0:28:35.77,كونان,,0000,0000,0000,,أنتِ متأخره جداً , سونكو غاضبه منكِ جداً
Dialogue: 0,0:28:36.00,0:28:36.66,ميرا,,0000,0000,0000,,!ران ؟
Dialogue: 0,0:28:37.10,0:28:38.28,ميرا,,0000,0000,0000,,!الفتى
Dialogue: 0,0:28:38.63,0:28:39.61,ميرا,,0000,0000,0000,,!الذي بالحفلة ؟
Dialogue: 0,0:28:48.52,0:28:49.96,كونان,,0000,0000,0000,,... آه ؟ أنتـ . أنتظري
Dialogue: 0,0:28:50.66,0:28:53.29,كونان,,0000,0000,0000,,ياألهي .. لم ألاحظ ذلك
Dialogue: 0,0:29:04.21,0:29:04.80,فوجي,,0000,0000,0000,,... أصعدي
Dialogue: 0,0:29:05.49,0:29:06.27,فوجي,,0000,0000,0000,,... لاتفكري كثيراً
Dialogue: 0,0:29:06.59,0:29:08.53,فوجي,,0000,0000,0000,,أنا أعرف من أنتِ
Dialogue: 0,0:29:08.90,0:29:11.07,فوجي,,0000,0000,0000,,هيا العدو قادم
Dialogue: 0,0:29:12.58,0:29:13.59,فوجي,,0000,0000,0000,,ثقي بي
Dialogue: 0,0:29:29.00,0:29:30.07,ران,,0000,0000,0000,,ماالعمل الآن ؟
Dialogue: 0,0:29:30.59,0:29:34.35,ران,,0000,0000,0000,,الذهاب إلى غرفة الغسيل لن يأخذ كل هذا الوقت
Dialogue: 0,0:29:35.07,0:29:35.80,ران,,0000,0000,0000,,... لن يفيد هذا
Dialogue: 0,0:29:37.21,0:29:38.80,ران,,0000,0000,0000,,يجب أن أخبرهم بالحقيقة
Dialogue: 0,0:29:45.01,0:29:47.16,ران,,0000,0000,0000,,... أتمنى أن لا أقابل أحد
Dialogue: 0,0:30:08.41,0:30:09.63,ران,,0000,0000,0000,,... أيتها الاميرة
Dialogue: 0,0:30:10.84,0:30:11.65,كونان,,0000,0000,0000,,الأميرة ران
Dialogue: 0,0:30:15.99,0:30:17.73,كونان,,0000,0000,0000,,!أنتِ هنا إذاً ؟
Dialogue: 0,0:30:18.28,0:30:19.14,ران,,0000,0000,0000,,! سينشي
Dialogue: 0,0:30:19.63,0:30:21.25,كونان,,0000,0000,0000,,هيا الجميع ينتظركِ
Dialogue: 0,0:30:21.86,0:30:22.53,كونان,,0000,0000,0000,,هيا لنذهب
Dialogue: 0,0:30:23.48,0:30:25.10,ران,,0000,0000,0000,,ماهذه  الملابس ؟
Dialogue: 0,0:30:26.12,0:30:27.56,كونان,,0000,0000,0000,,هل بها شيءً ما ؟
Dialogue: 0,0:30:27.64,0:30:29.87,كونان,,0000,0000,0000,,... نعم , أنت تبدو كالأمير
Dialogue: 0,0:30:30.97,0:30:32.21,كونان,,0000,0000,0000,,انا أبدو كأمير ؟
Dialogue: 0,0:30:32.79,0:30:36.06,كونان,,0000,0000,0000,,... تبدين وكأنكِ تأملين حدوث شيءً ما
Dialogue: 0,0:30:37.79,0:30:39.41,ران,,0000,0000,0000,,! لا يا سينشي أنزلني
Dialogue: 0,0:30:40.08,0:30:41.84,كونان,,0000,0000,0000,,لا لن أنزلكِ
Dialogue: 0,0:30:53.08,0:30:54.22,ران,,0000,0000,0000,,! مالأمر , لماذا تبدو سعيداً
Dialogue: 0,0:30:55.14,0:30:56.56,كونان,,0000,0000,0000,, لدي شيءً اخبركم به
Dialogue: 0,0:30:57.89,0:30:58.70,كونان,,0000,0000,0000,,... هذا اليوم
Dialogue: 0,0:30:59.19,0:31:01.26,كونان,,0000,0000,0000,,سأجعل الأميرة ران مليكتي
Dialogue: 0,0:31:03.82,0:31:05.15,ران,,0000,0000,0000,,... سينشي
Dialogue: 0,0:31:07.75,0:31:10.90,كونان,,0000,0000,0000,,لقد .. أتخذت قراري
Dialogue: 0,0:31:12.93,0:31:14.14,ران,,0000,0000,0000,,... لايمكن
Dialogue: 0,0:31:15.56,0:31:17.70,all,,0000,0000,0000,,ما الذي تفعله الأميرة ؟
Dialogue: 0,0:31:18.25,0:31:19.26,all,,0000,0000,0000,,من يعرف
Dialogue: 0,0:31:19.61,0:31:22.04,all,,0000,0000,0000,,يبدو وكأنها تتخيل شيءً ما
Dialogue: 0,0:31:22.27,0:31:25.91,all,,0000,0000,0000,,الجانب الاخر من الزجاج يبدو كالمرآة
Dialogue: 0,0:31:26.11,0:31:29.03,ران,,0000,0000,0000,,!تتخذ قرار مفاجئ كهذا ؟
Dialogue: 0,0:31:29.15,0:31:33.49,ران,,0000,0000,0000,,لا ليس لأني لست موافقه, لكني أشعر بالخجل فقط
Dialogue: 0,0:31:34.50,0:31:36.41,all,,0000,0000,0000,,أنتباه للجميع .. أنتباه للجميع
Dialogue: 0,0:31:37.02,0:31:38.03,all,,0000,0000,0000,,أوقفوا البحث عن الاميرة
Dialogue: 0,0:31:38.61,0:31:41.06,all,,0000,0000,0000,,في 19:53 تم أيقاف البحث
Dialogue: 0,0:31:41.84,0:31:43.90,all,,0000,0000,0000,,منذ الآن كل الفرق فلتوقف البحث
Dialogue: 0,0:31:44.68,0:31:46.90,فوجي,,0000,0000,0000,,حسناً, لنذهب الان
Dialogue: 0,0:31:47.43,0:31:48.23,ميرا,,0000,0000,0000,,بالحقيقة
Dialogue: 0,0:31:48.93,0:31:49.85,ميرا,,0000,0000,0000,,!من أنتِ ؟
Dialogue: 0,0:31:51.68,0:31:54.71,فوجي,,0000,0000,0000,,ألم أخبركِ ؟ أنا أختكِ
Dialogue: 0,0:31:54.91,0:31:55.93,ميرا,,0000,0000,0000,,أتظنين أنني غبيه ؟
Dialogue: 0,0:31:56.33,0:31:58.04,فوجي,,0000,0000,0000,,أنتِ , أميرة حقاً
Dialogue: 0,0:31:58.64,0:32:02.15,فوجي,,0000,0000,0000,,أيمكننا الذهاب الآن , أم تريدين العوده إلى الفندق ؟َ
Dialogue: 0,0:32:02.49,0:32:06.05,فوجي,,0000,0000,0000,,ستمرحين أن بقيتِ معي هذه الليله
Dialogue: 0,0:32:09.86,0:32:10.59,ميرا,,0000,0000,0000,,!آداه تعقب ؟
Dialogue: 0,0:32:11.08,0:32:13.71,فوجي,,0000,0000,0000,,أجل , على القلاده التي ترتدينها
Dialogue: 0,0:32:15.04,0:32:16.05,ميرا,,0000,0000,0000,,! ... هذا
Dialogue: 0,0:32:16.26,0:32:18.28,فوجي,,0000,0000,0000,,لايهم إلى أين تذهبين
Dialogue: 0,0:32:18.89,0:32:20.48,ميرا,,0000,0000,0000,,لابد أن هذا من أعداد كيث
Dialogue: 0,0:32:20.71,0:32:22.13,فوجي,,0000,0000,0000,,! لابأس أن كان هو
Dialogue: 0,0:32:23.24,0:32:26.24,فوجي,,0000,0000,0000,,لكن يبدو أن شخصاً آخر
Dialogue: 0,0:32:26.29,0:32:27.47,فوجي,,0000,0000,0000,, يريدكِ
Dialogue: 0,0:32:28.63,0:32:29.64,فوجي,,0000,0000,0000,,تمسكِ جيداً
Dialogue: 0,0:32:34.91,0:32:36.21,فوجي,,0000,0000,0000,,هذا هو العدو
Dialogue: 0,0:32:36.70,0:32:38.14,ميرا,,0000,0000,0000,,لقد تخلصت من القلادة
Dialogue: 0,0:32:39.26,0:32:42.26,فوجي,,0000,0000,0000,,لابد وأنه تمت مشاهدتكِ بالمتنزة
Dialogue: 0,0:32:42.35,0:32:45.26,فوجي,,0000,0000,0000,,أنتِ مشهوره جداً , تُشبهيني تماماً
Dialogue: 0,0:32:45.02,0:32:46.24,ميرا,,0000,0000,0000,,! هل تمازحينني ؟ هيا بسرعه
Dialogue: 0,0:32:46.36,0:32:47.05,فوجي,,0000,0000,0000,,! حسناً
Dialogue: 0,0:32:57.98,0:32:59.51,فوجي,,0000,0000,0000,,... أبتعدوا عن طريقي
Dialogue: 0,0:33:07.38,0:33:09.20,ميرا,,0000,0000,0000,,! يبدو أنكِ تستمتعين جداً
Dialogue: 0,0:33:09.46,0:33:11.60,فوجي,,0000,0000,0000,,! آه , لقد أكتشفتي ذلك
Dialogue: 0,0:33:11.80,0:33:15.53,فوجي,,0000,0000,0000,,لاتقلقي , أن لست بتلك السهوله ليمسكو بي كسائقه دراجة
Dialogue: 0,0:33:15.65,0:33:17.38,ميرا,,0000,0000,0000,,ماذا يجب أن نفعل أذا أصطدموا بنا ؟
Dialogue: 0,0:33:18.20,0:33:21.84,فوجي,,0000,0000,0000,,هذه اليابان , من الأفضل أن يعلموا أن لايفعلوا ذلك
Dialogue: 0,0:33:23.54,0:33:26.41,فوجي,,0000,0000,0000,,يااللهي ! يبدو أنهم قد بدؤ يفقدون صبرهم
Dialogue: 0,0:33:30.43,0:33:32.05,فوجي,,0000,0000,0000,,.. مادمتم فعلتم ذلك
Dialogue: 0,0:33:53.13,0:33:55.06,ميرا,,0000,0000,0000,,! يا .. يااللهي
Dialogue: 0,0:33:55.35,0:33:58.68,فوجي,,0000,0000,0000,,! لقد قلت لكِ أنا لست بذلك السوء
Dialogue: 0,0:33:59.40,0:34:01.42,فوجي,,0000,0000,0000,,أنا فقط لاأريد أن أضيع وقتِ على هؤلاء البيادق
Dialogue: 0,0:34:01.83,0:34:05.21,ميرا,,0000,0000,0000,,! بيادق ؟! لكنهم يستخدمون الأسلحة
Dialogue: 0,0:34:05.59,0:34:06.92,فوجي,,0000,0000,0000,,لقد حدث وأن أخذوها فقط
Dialogue: 0,0:34:07.61,0:34:11.00,فوجي,,0000,0000,0000,,... هنالك أكثر من سيارتان تطاردنا , شخصان في كل سيارة
Dialogue: 0,0:34:11.40,0:34:15.57,فوجي,,0000,0000,0000,,وقد أخفقوا بالهجوم علينا من الأمام عن طريق المقعد الخلفي
Dialogue: 0,0:34:16.40,0:34:23.09,فوجي,,0000,0000,0000,,لكن ... لقد كانوا يستهدفون الآطارات لكن فشلوا\N ... بالقيام بمثل هذه الأعمال ليلاً
Dialogue: 0,0:34:23.29,0:34:25.51,فوجي,,0000,0000,0000,,كيف يمكن لهؤلاء البيادق أن يعرفوا شيئً ؟
Dialogue: 0,0:34:26.81,0:34:29.53,ميرا,,0000,0000,0000,,! أختي , هذا رائع
Dialogue: 0,0:34:39.11,0:34:40.61,فوجي,,0000,0000,0000,,هل هذا حارسكِ الشخصي ؟
Dialogue: 0,0:34:42.14,0:34:43.04,ميرا,,0000,0000,0000,,! أنه هو
Dialogue: 0,0:34:53.29,0:34:56.29,فوجي,,0000,0000,0000,,! لقد أستطاع أن يقرأ طريقي
Dialogue: 0,0:34:56.94,0:34:58.28,فوجي,,0000,0000,0000,,هيا لنمرح قليلاً
Dialogue: 0,0:35:19.24,0:35:20.45,كونان,,0000,0000,0000,,! لن تبتعدي عن نظري
Dialogue: 0,0:35:35.07,0:35:37.31,فوجي,,0000,0000,0000,,! أبتعد عن طريقي
Dialogue: 0,0:35:46.65,0:35:49.98,فوجي,,0000,0000,0000,,... أنا آسفه , لقد بالغت قليلاً
Dialogue: 0,0:35:51.19,0:35:52.49,فوجي,,0000,0000,0000,,... لكن
Dialogue: 0,0:35:53.30,0:35:55.96,فوجي,,0000,0000,0000,,أنه خطأك لأنك طاردتني
Dialogue: 0,0:36:02.09,0:36:03.08,كونان,,0000,0000,0000,,... ماهذا
Dialogue: 0,0:36:03.68,0:36:04.49,كونان,,0000,0000,0000,,... أنها
Dialogue: 0,0:36:05.62,0:36:07.04,كونان,,0000,0000,0000,,لاتبدو كالمجرمين
Dialogue: 0,0:36:15.27,0:36:17.25,all,,0000,0000,0000,,أنتِ حقاً .. ران ؟
Dialogue: 0,0:36:18.98,0:36:21.01,ران,,0000,0000,0000,,حتى أنك لاتستطيع أن تميز أبنتك الوحيدة ؟
Dialogue: 0,0:36:21.84,0:36:24.59,all,,0000,0000,0000,,تبدين أكثر أشراقاً بعض الشيء
Dialogue: 0,0:36:24.85,0:36:25.63,ران,,0000,0000,0000,,! سوف أغضب
Dialogue: 0,0:36:27.77,0:36:28.70,all,,0000,0000,0000,,... إذاً ران
Dialogue: 0,0:36:28.99,0:36:33.32,all,,0000,0000,0000,,الأميرة الحقيقية قالت بأنها ستعود بعد أن تنتهي الحفلة ؟
Dialogue: 0,0:36:33.82,0:36:39.98,ران,,0000,0000,0000,,!... أجل , لو كنت أعلم فقط أن الحفله قد تحولت إلى فوضى لما
Dialogue: 0,0:36:41.31,0:36:42.32,ران,,0000,0000,0000,,أنا آسفه
Dialogue: 0,0:36:42.81,0:36:45.85,all,,0000,0000,0000,,الخطأ ليس خطأكِ , آنسة ران
Dialogue: 0,0:36:45.99,0:36:46.92,all,,0000,0000,0000,,... هذا كله
Dialogue: 0,0:36:48.22,0:36:51.24,كيث,,0000,0000,0000,,حقاً , أنا أعتمد عليكِ
Dialogue: 0,0:36:51.98,0:36:53.05,all,,0000,0000,0000,, سيد كيث
Dialogue: 0,0:36:53.36,0:36:57.67,all,,0000,0000,0000,,في هذه الحالة نحن نود أن نجري البحث من جديد عن الأميرة
Dialogue: 0,0:36:57.90,0:36:59.90,كيث,,0000,0000,0000,,هذا ليس ضرورياً ؟
Dialogue: 0,0:37:00.82,0:37:03.37,all,,0000,0000,0000,,... أنت تتكلم بكلام غير منطقي مجدداً , أيها
Dialogue: 0,0:37:04.22,0:37:07.59,all,,0000,0000,0000,,!أتمنى أن تخبرنا لماذا هذا ليس ضرورياً ؟
Dialogue: 0,0:37:08.23,0:37:10.86,كيث,,0000,0000,0000,,لاحاجة بأن أفعل ذلك
Dialogue: 0,0:37:11.26,0:37:13.08,كيث,,0000,0000,0000,,عن من أبحث بأية حال ؟
Dialogue: 0,0:37:20.17,0:37:21.88,كونان,,0000,0000,0000,,! أختي سونكو
Dialogue: 0,0:37:23.06,0:37:25.09,all,,0000,0000,0000,,! هاه يجب أن يكون لديك تفسيراً لهذا
Dialogue: 0,0:37:25.09,0:37:26.94,all,,0000,0000,0000,,!أين كنت ؟ لقد كنا نبحث عنك في كل مكان ؟
Dialogue: 0,0:37:27.05,0:37:28.76,كونان,,0000,0000,0000,,أنا آسف , لقد تهت
Dialogue: 0,0:37:29.16,0:37:31.07,all,,0000,0000,0000,,ماذا تقصد بـ " تهت " ؟
Dialogue: 0,0:37:31.48,0:37:34.43,all,,0000,0000,0000,,أنت بالتأكيد متورط ببعض الأمور الغريبة
Dialogue: 0,0:37:34.66,0:37:36.94,كونان,,0000,0000,0000,,... امم , ران .. لا
Dialogue: 0,0:37:37.23,0:37:38.88,كونان,,0000,0000,0000,,الأميرة هل عادت ؟
Dialogue: 0,0:37:39.37,0:37:40.87,all,,0000,0000,0000,,ماذا تقصد بعادت ؟
Dialogue: 0,0:37:41.48,0:37:43.50,all,,0000,0000,0000,,أليست الأميرة بالأعلى ؟
Dialogue: 0,0:37:44.03,0:37:46.02,all,,0000,0000,0000,,...  والمفتش ميقوري أيضاً
Dialogue: 0,0:37:46.34,0:37:46.95,كونان,,0000,0000,0000,,لنذهب
Dialogue: 0,0:37:47.26,0:37:48.19,all,,0000,0000,0000,,!هيه , أنتظر
Dialogue: 0,0:37:49.92,0:37:51.83,all,,0000,0000,0000,,لقد عرفت ذلك ؟
Dialogue: 0,0:37:52.58,0:37:55.82,all,,0000,0000,0000,,أن كان من قام بخطفها من هذه البلاد
Dialogue: 0,0:37:56.63,0:37:59.87,all,,0000,0000,0000,,ماالذي سيحدث للعلاقة بين اليابان وفيسبانيا ؟
Dialogue: 0,0:38:01.14,0:38:04.09,all,,0000,0000,0000,,أنا حقاً غاضب ! أتريد أستخدام بديل ؟
Dialogue: 0,0:38:04.59,0:38:08.95,all,,0000,0000,0000,,أنا لن أوافق على ذلك , الآنسة ران من المدنيين
Dialogue: 0,0:38:09.88,0:38:13.81,all,,0000,0000,0000,,! لن أسمح لها أن تكون في موقف يعرض حياتها للخطر
Dialogue: 0,0:38:14.50,0:38:16.21,all,,0000,0000,0000,,هيا يا ران لنذهب
Dialogue: 0,0:38:17.16,0:38:18.67,ران,,0000,0000,0000,,... اممم بالحقيقة
Dialogue: 0,0:38:20.08,0:38:23.03,ران,,0000,0000,0000,,أرغب بأخذ مكان الأميرة إلى أن تعود
Dialogue: 0,0:38:23.53,0:38:25.14,all,,0000,0000,0000,,!حمقاء عن ماذا تتحدثين ؟
Dialogue: 0,0:38:25.32,0:38:28.27,all,,0000,0000,0000,,أجل , ماذ أن لم تعد الأميرة ؟
Dialogue: 0,0:38:28.47,0:38:32.61,all,,0000,0000,0000,,هذا صحيح , يا ران , لقد ذكر ذلك قبل قليل \N ... ليس من الضروري أن تتحمـ
Dialogue: 0,0:38:32.69,0:38:33.70,كيث,,0000,0000,0000,,أحموا الأميرة
Dialogue: 0,0:38:38.50,0:38:45.79,all,,0000,0000,0000,,آه , أنتظر  .. أتركني ! ماذا تفعل ؟
Dialogue: 0,0:38:47.18,0:38:50.62,كيث,,0000,0000,0000,,من الآن وصاعداً , أطيعوا الأوامر
Dialogue: 0,0:39:02.42,0:39:07.77,all,,0000,0000,0000,,المفتش ميقوري , أرجو أن تعطي الأمر بالبحث عن ران
Dialogue: 0,0:39:11.21,0:39:12.10,all,,0000,0000,0000,,... امم
Dialogue: 0,0:39:12.11,0:39:13.08,all,,0000,0000,0000,,فهمت
Dialogue: 0,0:39:13.08,0:39:14.13,all,,0000,0000,0000,,سنبذل كل جهداً لأحضارها
Dialogue: 0,0:39:15.14,0:39:17.17,all,,0000,0000,0000,,!أنا لا أفهم عن ماذا تتحدثون ؟
Dialogue: 0,0:39:20.09,0:39:23.16,كيث,,0000,0000,0000,,لقد طلبت منهم أن يقوم بتجهيز الغرفة الآخرى لك
Dialogue: 0,0:39:23.41,0:39:23.73,all,,0000,0000,0000,,حسناً
Dialogue: 0,0:39:34.34,0:39:36.25,ران,,0000,0000,0000,,! مستحيل ! أنه ذلك الرجل
Dialogue: 0,0:39:38.48,0:39:39.92,ران,,0000,0000,0000,,... اممم
Dialogue: 0,0:39:40.91,0:39:44.87,ران,,0000,0000,0000,,أنا لم أعرف أنك الحارس الشخصي للأميرة
Dialogue: 0,0:39:45.88,0:39:46.37,ران,,0000,0000,0000,,... اممم
Dialogue: 0,0:39:47.59,0:39:48.31,ران,,0000,0000,0000,,أنا آسفة
Dialogue: 0,0:39:50.19,0:39:51.37,all,,0000,0000,0000,,لاحاجة للأعتذار
Dialogue: 0,0:39:51.98,0:39:54.41,all,,0000,0000,0000,,أنا من يجب عليه أن يعتذر
Dialogue: 0,0:39:55.16,0:39:56.43,all,,0000,0000,0000,,حدث هذا الأمر
Dialogue: 0,0:39:57.24,0:39:58.60,all,,0000,0000,0000,,بسبب تهوري
Dialogue: 0,0:39:58.98,0:40:00.28,ران,,0000,0000,0000,,لا , ليس هكذا
Dialogue: 0,0:40:04.33,0:40:06.15,ران,,0000,0000,0000,,... اممم .. بخصوص
Dialogue: 0,0:40:06.35,0:40:09.30,ران,,0000,0000,0000,,أعتقد بأنه .. حصل بذالك الوقت
Dialogue: 0,0:40:10.11,0:40:11.73,ران,,0000,0000,0000,,السحاب قد سقط
Dialogue: 0,0:40:24.86,0:40:28.19,لوبين,,0000,0000,0000,,منذ نصف عام ، كانت هنالك حركة لقشرة الأرض
Dialogue: 0,0:40:28.59,0:40:34.13,لوبين,,0000,0000,0000,,تسمى بـ موكولوفيتش والتي تظهر بالعادة \N تحت الأرض بحوالي ألف مترا بشكلاً مفاجئ
Dialogue: 0,0:40:34.78,0:40:35.79,all,,0000,0000,0000,,هوموفيتش ؟
Dialogue: 0,0:40:35.88,0:40:36.98,لوبين,,0000,0000,0000,,موكولوفيتش
Dialogue: 0,0:40:37.61,0:40:38.42,لوبين,,0000,0000,0000,,... آه لا عليك
Dialogue: 0,0:40:39.01,0:40:41.37,لوبين,,0000,0000,0000,,... المهم الصخور التي وجدت هنا كانت
Dialogue: 0,0:40:42.85,0:40:44.58,لوبين,,0000,0000,0000,,نوعاً جديداً من الخام
Dialogue: 0,0:40:49.41,0:40:51.03,لوبين,,0000,0000,0000,,... خام فايسبانيا
Dialogue: 0,0:40:53.52,0:40:55.05,all,,0000,0000,0000,,كُل هذا ؟
Dialogue: 0,0:40:55.43,0:40:58.37,لوبين,,0000,0000,0000,,... أجل , لقد وجد هكذا
Dialogue: 0,0:40:58.98,0:41:00.80,لوبين,,0000,0000,0000,,بمحض الصدفة
Dialogue: 0,0:41:01.21,0:41:02.22,all,,0000,0000,0000,,... مصادفة
Dialogue: 0,0:41:02.63,0:41:05.03,all,,0000,0000,0000,,إذاً آي السلطات تمتلكه ؟
Dialogue: 0,0:41:05.66,0:41:06.79,لوبين,,0000,0000,0000,,أتريد أن تعرف ؟
Dialogue: 0,0:41:08.58,0:41:10.98,لوبين,,0000,0000,0000,,. أنت تفهم أن هذا
Dialogue: 0,0:41:11.50,0:41:13.04,لوبين,,0000,0000,0000,,القوة المطلقة لتسلل
Dialogue: 0,0:41:14.05,0:41:14.86,all,,0000,0000,0000,,التسلل ؟
Dialogue: 0,0:41:15.35,0:41:16.36,لوبين,,0000,0000,0000,,أنت سمعت عنها من قبل ؟
Dialogue: 0,0:41:17.31,0:41:19.98,لوبين,,0000,0000,0000,,الطائرات المقاتلة التي لا تكتشف في الرادار
Dialogue: 0,0:41:20.76,0:41:24.14,لوبين,,0000,0000,0000,,هذا يمكن أن يقوي قوة التسلل إلى الأفضل
Dialogue: 0,0:41:25.04,0:41:28.28,لوبين,,0000,0000,0000,,كما أن تقنيات الموجات في تقدم مستمر بينما نتحدث
Dialogue: 0,0:41:28.88,0:41:33.45,لوبين,,0000,0000,0000,,لكن هذا فقط يجعل كشف الطائرات عن طريق الرادار أكثر صعوبة
Dialogue: 0,0:41:34.16,0:41:37.29,all,,0000,0000,0000,,إذاً بأستخدام هذا سيجعل الطائرات تختفي فعلاً عن الرادار ؟
Dialogue: 0,0:41:37.59,0:41:39.00,لوبين,,0000,0000,0000,,. نعم , بالتأكيد
Dialogue: 0,0:41:39.46,0:41:42.04,لوبين,,0000,0000,0000,,يبدو أنهم أستعملو العديد من الطرق لتحديد مكانه
Dialogue: 0,0:41:42.62,0:41:44.47,لوبين,,0000,0000,0000,,لكنهم فشلوا بإيجاده
Dialogue: 0,0:41:45.24,0:41:48.60,لوبين,,0000,0000,0000,,خام فيسبانيا لن يعود لهم
Dialogue: 0,0:41:49.07,0:41:50.08,all,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:41:50.57,0:41:55.22,all,,0000,0000,0000,,إذاً كيف ستقوم بتحديد مكان الصخور ؟
Dialogue: 0,0:41:59.10,0:42:00.43,لوبين,,0000,0000,0000,,بأستخدام عصا التغطيس
Dialogue: 0,0:42:00.95,0:42:03.38,all,,0000,0000,0000,,!هيه , ألم تقم بتجربة ذلك من قبل ؟
Dialogue: 0,0:42:03.35,0:42:08.41,all,,0000,0000,0000,,{\pos(321,56)}: بعد البحث توصلت لترجمة القليل من هذه الكتابة وهي
Dialogue: 0,0:42:03.35,0:42:08.41,all,,0000,0000,0000,,{\pos(324,475)}تستخدم عصا التغطيس بأختصار البحث عن الماء بوجة التحديد \N وأيضاً تستخدم أحياناً لأيجاد أنواع من الصخور الخام وغيرها
Dialogue: 0,0:42:04.25,0:42:04.88,لوبين,,0000,0000,0000,,{\pos(326,390)}. لا
Dialogue: 0,0:42:09.02,0:42:12.57,لوبين,,0000,0000,0000,,أنا أثق فقط بـ عصا التغطيس و فوجي
Dialogue: 0,0:42:12.98,0:42:13.50,all,,0000,0000,0000,,! غبي
Dialogue: 0,0:42:23.30,0:42:25.47,ميرا,,0000,0000,0000,,! هيا , هيا , هيا
Dialogue: 0,0:42:28.48,0:42:31.11,ميرا,,0000,0000,0000,,! اللعنة , لقد حصلت عليها للتو
Dialogue: 0,0:42:36.46,0:42:37.93,ميرا,,0000,0000,0000,,أنتِ تبدين حذرة جداً
Dialogue: 0,0:42:39.21,0:42:40.07,فوجي,,0000,0000,0000,,... بالطبع
Dialogue: 0,0:42:40.91,0:42:43.37,فوجي,,0000,0000,0000,,لقد قمت بإختطاف أميرة
Dialogue: 0,0:42:44.41,0:42:45.57,ميرا,,0000,0000,0000,,! لذيذ
Dialogue: 0,0:42:46.49,0:42:48.66,فوجي,,0000,0000,0000,,هل يمكنكِ أن تتصرفي كرهينة رجاءً
Dialogue: 0,0:42:49.01,0:42:49.99,ميرا,,0000,0000,0000,,حسناً
Dialogue: 0,0:42:50.31,0:42:52.42,فوجي,,0000,0000,0000,,لاتضعي الطبق الذي أنتهيتِ منه هنا
Dialogue: 0,0:42:53.35,0:42:55.00,ميرا,,0000,0000,0000,,... مع أنني لاأعرف ماهو هدفكِ
Dialogue: 0,0:42:55.60,0:42:57.28,ميرا,,0000,0000,0000,,لكنكِ لاتبدين كشخصاً سيئ
Dialogue: 0,0:42:59.01,0:43:01.04,ميرا,,0000,0000,0000,,أن كنتِ لاتمانعين هل تخبريني بها ؟
Dialogue: 0,0:43:02.77,0:43:05.54,ميرا,,0000,0000,0000,,ماهي نواياكِ الحقيقية ؟
Dialogue: 0,0:43:07.55,0:43:08.53,ميرا,,0000,0000,0000,,لقد عرفت ذلك
Dialogue: 0,0:43:09.14,0:43:11.85,ميرا,,0000,0000,0000,,... لكنني قررت أن أثق بكِ
Dialogue: 0,0:43:12.55,0:43:13.44,ميرا,,0000,0000,0000,,... يا أختي
Dialogue: 0,0:43:14.60,0:43:16.02,ميرا,,0000,0000,0000,,بسبب حدسي
Dialogue: 0,0:43:19.60,0:43:20.90,فوجي,,0000,0000,0000,,هنالك حبة من الرز على خدكِ
Dialogue: 0,0:43:22.78,0:43:24.63,فوجي,,0000,0000,0000,,لقد أخبرتك من قبل أن لاتضعي الطبق الفارغ هناك
Dialogue: 0,0:43:26.43,0:43:27.56,all,,0000,0000,0000,, ما الذي يعنيه هذا ؟
Dialogue: 0,0:43:28.13,0:43:29.87,all,,0000,0000,0000,,!وكيف وافقتم على هذا ؟
Dialogue: 0,0:43:31.26,0:43:34.44,all,,0000,0000,0000,,نعم , نعم , حسناً
Dialogue: 0,0:43:35.39,0:43:38.72,all,,0000,0000,0000,,سوف أذهب إلى المقر الرئيسي , أبقى أنت هنا
Dialogue: 0,0:43:39.06,0:43:40.51,all,,0000,0000,0000,,هل يضغطون علينا ؟
Dialogue: 0,0:43:41.06,0:43:45.02,all,,0000,0000,0000,,أعتقد ذلك , لاتقم بعمل شيءً حتى أعود
Dialogue: 0,0:43:45.60,0:43:46.41,all,,0000,0000,0000,,فهمت ذلك
Dialogue: 0,0:43:48.46,0:43:51.67,all,,0000,0000,0000,,... أنتظر ! إذا لم تجد تلك الأميرة السيئة بسرعه فأن ران سـ
Dialogue: 0,0:43:51.82,0:43:53.38,all,,0000,0000,0000,,! أعلم ذلك
Dialogue: 0,0:43:53.70,0:43:56.59,all,,0000,0000,0000,,! إذاً لماذ لم يوافقوا على أمر البحث
Dialogue: 0,0:43:56.82,0:43:59.42,all,,0000,0000,0000,,!مستحيل .. كيف علمتي بهذا ؟
Dialogue: 0,0:43:59.57,0:44:02.78,all,,0000,0000,0000,,أستطيع أن أراه من خلال نظراتك الغبية
Dialogue: 0,0:44:03.93,0:44:07.00,كونان,,0000,0000,0000,,! لماذا ؟ هل هنالك حاجةً لعرقلة الأمر من الداخل
Dialogue: 0,0:44:08.30,0:44:11.83,كونان,,0000,0000,0000,,!هل سيجعلون ران بديلة لها ؟
Dialogue: 0,0:44:13.24,0:44:14.11,all,,0000,0000,0000,, تاكاجي
Dialogue: 0,0:44:15.27,0:44:16.86,all,,0000,0000,0000,,في حالة حدوث أي شيء
Dialogue: 0,0:44:17.35,0:44:18.82,all,,0000,0000,0000,,هل سوف تساعدني ؟
Dialogue: 0,0:44:19.63,0:44:20.47,all,,0000,0000,0000,,بالطبع
Dialogue: 0,0:44:21.02,0:44:22.70,all,,0000,0000,0000,,أتراهن حياتك على هذا ؟
Dialogue: 0,0:44:23.23,0:44:24.20,all,,0000,0000,0000,,بالطبع سوف افعل
Dialogue: 0,0:44:26.37,0:44:28.05,لوبين,,0000,0000,0000,,! وجدته ! وجدته
Dialogue: 0,0:44:29.52,0:44:30.77,لوبين,,0000,0000,0000,,! هنا
Dialogue: 0,0:44:34.56,0:44:38.14,لوبين,,0000,0000,0000,,أنه أنت , كم رغبت برؤيتك ؟
Dialogue: 0,0:44:39.07,0:44:40.08,لوبين,,0000,0000,0000,,هل وجدته ؟
Dialogue: 0,0:44:40.28,0:44:42.57,لوبين,,0000,0000,0000,,أجل هذا هو المطلوب
Dialogue: 0,0:44:46.58,0:44:49.62,all,,0000,0000,0000,,هذا الحجر الصغير قادر على تغيير العالم ؟
Dialogue: 0,0:44:51.65,0:44:52.54,لوبين,,0000,0000,0000,,... فكر بالأمر
Dialogue: 0,0:44:53.84,0:44:58.47,لوبين,,0000,0000,0000,,أن كان هنالك قذيفة ستسقط على رأسك
Dialogue: 0,0:45:01.10,0:45:03.33,لوبين,,0000,0000,0000,,أنت حتى لن تعرف أطلقت من أين
Dialogue: 0,0:45:03.88,0:45:06.94,لوبين,,0000,0000,0000,,لا ربما لن تعرف حتى تسقط عليك
Dialogue: 0,0:45:07.87,0:45:10.79,all,,0000,0000,0000,,... أن كان هكذا , فأن العالم سوف
Dialogue: 0,0:45:11.16,0:45:12.75,لوبين,,0000,0000,0000,,! ينتهي
Dialogue: 0,0:45:13.33,0:45:16.43,لوبين,,0000,0000,0000,,الآن , كل شيءً على الأرض مراقب من الفضاء
Dialogue: 0,0:45:17.01,0:45:20.21,لوبين,,0000,0000,0000,,المدينة بأكملها مراقبة عن طريق                        , من يستطيع الأختباء ؟
Dialogue: 0,0:45:17.01,0:45:20.21,E,,0000,0000,0000,,{\pos(293,467)}CCTV
Dialogue: 0,0:45:17.01,0:45:20.21,note1,,0000,0000,0000,,{\move(320,-35,320,-25,30,322)\bord1.2\1c&H000000&\1a&HC0&\shad0}{\p1} m 40 20 l 900 20 900 80 40 80 {\p0}
