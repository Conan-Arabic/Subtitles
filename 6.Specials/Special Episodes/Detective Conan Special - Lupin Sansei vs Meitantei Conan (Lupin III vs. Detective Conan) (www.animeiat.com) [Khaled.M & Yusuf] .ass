Dialogue: 0,1:34:00.15,1:34:02.61,all,,0000,0000,0000,,... هذا من أجل شعب هذه البلاد
Dialogue: 0,1:34:03.19,1:34:07.23,all,,0000,0000,0000,,الآن , فيسبانيا تحتاج لهذه القوة
Dialogue: 0,1:34:07.94,1:34:09.57,all,,0000,0000,0000,,لطاقة جديدة
Dialogue: 0,1:34:10.03,1:34:12.78,all,,0000,0000,0000,,العالم يحتاج للقوة الغير محدودة
Dialogue: 0,1:34:15.74,1:34:16.61,ميرا,,0000,0000,0000,,كيث
Dialogue: 0,1:34:17.66,1:34:18.70,all,,0000,0000,0000,,سيد كيث
Dialogue: 0,1:34:20.39,1:34:23.99,كيث,,0000,0000,0000,,عائلة ستينقر كانت تخدم العائلة المالكة لـ 200 عام
Dialogue: 0,1:34:24.49,1:34:26.70,كيث,,0000,0000,0000,,دمائهم تجري بي
Dialogue: 0,1:34:31.75,1:34:34.43,كيث,,0000,0000,0000,,سأخدم العائلة المالكة لفيسبانيا حتى النهاية
Dialogue: 0,1:34:36.04,1:34:37.37,لوبين,,0000,0000,0000,,قرر إذاً
Dialogue: 0,1:34:40.88,1:34:42.41,لوبين,,0000,0000,0000,,!ماهذا ؟
Dialogue: 0,1:34:42.41,1:34:44.50,all,,0000,0000,0000,,... تتنكر وتحدث فوضى
Dialogue: 0,1:34:45.09,1:34:48.28,all,,0000,0000,0000,,وتنسحب خلال الفوضى , أليس هذه العادة , لوبين ؟
Dialogue: 0,1:34:48.84,1:34:50.38,لوبين,,0000,0000,0000,,آه , أنكشفت
Dialogue: 0,1:34:50.63,1:34:53.80,all,,0000,0000,0000,,حاول أن تتذكر شي قلته قبل 30 ثانية مضت
Dialogue: 0,1:34:54.17,1:34:57.30,لوبين,,0000,0000,0000,,هل يمكنني أن أتكلم قليلاً , تو ؟
Dialogue: 0,1:34:57.80,1:35:00.46,all,,0000,0000,0000,,لقد ناديتني , تو , اليس كذلك ؟
Dialogue: 0,1:35:01.01,1:35:03.85,لوبين,,0000,0000,0000,,مالأمر بهذا التوقيت الدقيق ؟
Dialogue: 0,1:35:04.18,1:35:09.24,لوبين,,0000,0000,0000,,لازلت أرغب بأن أكون رائعاً لفترة أطول \N تو , يجب أن تكون أكثر مراعاةً لشعور الآخرين
Dialogue: 0,1:35:09.24,1:35:13.14,all,,0000,0000,0000,,من يهتم ؟ طالما أعتقلك
Dialogue: 0,1:35:13.41,1:35:14.52,all,,0000,0000,0000,,أيها الأوغاد
Dialogue: 0,1:35:14.77,1:35:18.56,ميرا,,0000,0000,0000,,هل قمت حقاً , بقتل والدتي ؟
Dialogue: 0,1:35:19.06,1:35:22.77,all,,0000,0000,0000,,نعم , لم أستطع أعطاء هذه البلاد إلى أختي
Dialogue: 0,1:35:23.28,1:35:26.28,all,,0000,0000,0000,,أن تمت الموافقة على أستخراج المعادن
Dialogue: 0,1:35:26.32,1:35:29.32,all,,0000,0000,0000,,بيئة فيسبانيا سوف تكون ملوثة
Dialogue: 0,1:35:29.57,1:35:30.78,all,,0000,0000,0000,,أنتِ لاتفهمين
Dialogue: 0,1:35:31.11,1:35:33.82,all,,0000,0000,0000,,قيمة هذه البلاد ستتأخر
Dialogue: 0,1:35:34.15,1:35:36.46,all,,0000,0000,0000,,!الشخص الذي لايفهم هو أنت
Dialogue: 0,1:35:36.61,1:35:41.86,all,,0000,0000,0000,,من أجل كسب الربح , سنفقد الأشياء التي لاتعوض
Dialogue: 0,1:35:42.37,1:35:44.49,all,,0000,0000,0000,,! نظرتك للمستقبل قصيرة
Dialogue: 0,1:35:44.95,1:35:49.66,all,,0000,0000,0000,,! الكثير من البشر الذين يعتمدون على الأرض يحاولون تدميرها
Dialogue: 0,1:35:50.41,1:35:52.83,all,,0000,0000,0000,,!حتى أنت لاتستطيع فهم ذلك ؟
Dialogue: 0,1:35:54.33,1:35:58.33,all,,0000,0000,0000,,بدون طموح كبير , فأنها ستصبح غير مؤهلة لكي تكون الملكة
Dialogue: 0,1:35:59.04,1:36:02.62,all,,0000,0000,0000,,سيكون الحال نفسة حتى وأن أستلمه الأطفال
Dialogue: 0,1:36:02.83,1:36:06.26,ميرا,,0000,0000,0000,,... هذا يعني , أخي وأنا
Dialogue: 0,1:36:07.00,1:36:08.38,all,,0000,0000,0000,,يالها من خسارة يا كيث
Dialogue: 0,1:36:09.26,1:36:12.84,all,,0000,0000,0000,,لكن في النهاية سأمنحك رغبتك
Dialogue: 0,1:36:15.05,1:36:17.40,فوجي,,0000,0000,0000,,لقد حصلت على المفتاح
Dialogue: 0,1:36:20.59,1:36:22.68,لوبين,,0000,0000,0000,,أمسكة بقوة
Dialogue: 0,1:36:22.80,1:36:23.80,all,,0000,0000,0000,,!ماذا ؟
Dialogue: 0,1:36:24.18,1:36:25.30,all,,0000,0000,0000,,! سيد جيرالد
Dialogue: 0,1:36:25.51,1:36:26.01,كيث,,0000,0000,0000,,! كايرو
Dialogue: 0,1:36:26.09,1:36:26.64,all,,0000,0000,0000,,! حسناً
Dialogue: 0,1:36:31.01,1:36:32.06,ميرا,,0000,0000,0000,,!.. مينيكو
Dialogue: 0,1:36:32.18,1:36:34.18,فوجي,,0000,0000,0000,,! رائعة حقاً هذه الكرة
Dialogue: 0,1:36:38.85,1:36:40.77,ميرا,,0000,0000,0000,,لن أناديك بـ عمي مرةً أخرى
Dialogue: 0,1:36:41.60,1:36:46.65,ميرا,,0000,0000,0000,,فعل شيءً كهذا بأختك وأبنها
Dialogue: 0,1:36:50.82,1:36:54.24,ميرا,,0000,0000,0000,,أنا لن أسامحك أبداً
Dialogue: 0,1:36:57.31,1:37:00.31,ميرا,,0000,0000,0000,,لن أدع هذه البلاد تحت يدك أبداً
Dialogue: 0,1:37:02.35,1:37:04.03,ميرا,,0000,0000,0000,,... حاكمة هذه البلاد
Dialogue: 0,1:37:05.49,1:37:06.62,ميرا,,0000,0000,0000,,! هي أنا
Dialogue: 0,1:37:12.19,1:37:13.91,all,,0000,0000,0000,,الأميرة ميرا
Dialogue: 0,1:37:17.43,1:37:19.33,كونان,,0000,0000,0000,,أختي صاحبة الدراجة
Dialogue: 0,1:37:19.54,1:37:22.21,كونان,,0000,0000,0000,,! كم من الوقت تدوم هذه
Dialogue: 0,1:37:22.40,1:37:25.40,كونان,,0000,0000,0000,,! اممم .. باقي ثلاثة ثواني فقط
Dialogue: 0,1:37:25.92,1:37:27.38,لوبين,,0000,0000,0000,,! أهربوااا
Dialogue: 0,1:37:43.47,1:37:46.09,لوبين,,0000,0000,0000,,لقد قابلت أمكِ هنا
Dialogue: 0,1:37:46.68,1:37:50.10,all,,0000,0000,0000,,أرجوك , خُذني مع هذا التاج أيضاً
Dialogue: 0,1:37:50.68,1:37:54.22,all,,0000,0000,0000,,لاأريد أن أكون طائراً عالقاً في قفص \N يحلم بالطيران بحريةً في السماء
Dialogue: 0,1:37:55.24,1:37:57.56,لوبين,,0000,0000,0000,,هذا مستحيل
Dialogue: 0,1:37:58.10,1:37:59.10,all,,0000,0000,0000,,!لماذا ؟
Dialogue: 0,1:37:59.56,1:38:00.43,لوبين,,0000,0000,0000,,... أستمعي لي
Dialogue: 0,1:38:01.02,1:38:03.56,لوبين,,0000,0000,0000,,لقد كان جدي لصاً عظيماً
Dialogue: 0,1:38:04.10,1:38:06.44,لوبين,,0000,0000,0000,,ووالدكِ هو حاكم هذه البلاد
Dialogue: 0,1:38:07.19,1:38:10.06,لوبين,,0000,0000,0000,,وقريباً أنتِ ستصبحين حاكمة هذه البلاد
Dialogue: 0,1:38:10.69,1:38:12.02,لوبين,,0000,0000,0000,,... أرتدي هذا التاج
Dialogue: 0,1:38:12.94,1:38:17.57,لوبين,,0000,0000,0000,,ستحلقين بحرية بالسماء مع شعب هذه البلاد وليس معي
Dialogue: 0,1:38:17.90,1:38:18.78,all,,0000,0000,0000,, لوبين
Dialogue: 0,1:38:19.46,1:38:20.36,لوبين,,0000,0000,0000,,... إلى اللقاء
Dialogue: 0,1:38:21.19,1:38:24.53,لوبين,,0000,0000,0000,,وشكراً لكِ لجعلي أفهم هذه البلاد الجميلة
Dialogue: 0,1:38:24.74,1:38:27.11,لوبين,,0000,0000,0000,,لننتظر إلى اليوم الذي سنتقابل به مجدداً
Dialogue: 0,1:38:32.12,1:38:34.62,لوبين,,0000,0000,0000,,هي تماماً مثلكِ الآن
Dialogue: 0,1:38:35.16,1:38:37.08,ميرا,,0000,0000,0000,,... أمي الجميلة والحنونة
Dialogue: 0,1:38:38.04,1:38:40.04,ميرا,,0000,0000,0000,,كانت بالحقيقة تُشبهني
Dialogue: 0,1:38:40.62,1:38:44.08,لوبين,,0000,0000,0000,,رغم ذلك لاتفي بوعودها  , هاه ؟
Dialogue: 0,1:38:44.79,1:38:48.87,لوبين,,0000,0000,0000,,لقد تذكرت ذلك بعد أن سمعت خبر وفاة الملكة
Dialogue: 0,1:38:49.29,1:38:51.58,كونان,,0000,0000,0000,,عمي , السرقة تعتبر جريمة
Dialogue: 0,1:38:51.83,1:38:55.34,لوبين,,0000,0000,0000,, ليس أنا , بل الفتاة التي على الدراجة
Dialogue: 0,1:38:55.59,1:38:56.96,كونان,,0000,0000,0000,,أنتم أصدقاء , صحيح ؟
Dialogue: 0,1:38:57.33,1:39:00.33,لوبين,,0000,0000,0000,,أنت مزعج , هل هذا جيد الآن ؟
Dialogue: 0,1:39:02.84,1:39:04.51,لوبين,,0000,0000,0000,,ها أنا أُعيد هذا
Dialogue: 0,1:39:05.55,1:39:09.01,لوبين,,0000,0000,0000,,مازالت تبدو أفضل عليكِ
Dialogue: 0,1:39:10.51,1:39:13.60,لوبين,,0000,0000,0000,,بالكلام عن هذا , هل أستطيع أن أسألك شيءً ما ؟
Dialogue: 0,1:39:14.22,1:39:17.64,لوبين,,0000,0000,0000,,!كيف أمكنك أن تقول بأن موت الملكة ساكورا ليس حادثة ؟
Dialogue: 0,1:39:18.45,1:39:20.42,لوبين,,0000,0000,0000,,والدك قال بأن هذا هو أستنتاجك
Dialogue: 0,1:39:20.42,1:39:23.06,لوبين,,0000,0000,0000,,لتنجح بذلك متى حققت هنا
Dialogue: 0,1:39:23.60,1:39:26.02,كونان,,0000,0000,0000,,بسبب .. ذلك الغصن المكسور
Dialogue: 0,1:39:26.43,1:39:27.44,ميرا,,0000,0000,0000,,!ذلك الغصن ؟
Dialogue: 0,1:39:28.06,1:39:32.35,كونان,,0000,0000,0000,,الأمير جيل كان يعلم بأن والدته تحب شجرة الساكورا هذه ؟
Dialogue: 0,1:39:32.81,1:39:33.52,ميرا,,0000,0000,0000,,أجل
Dialogue: 0,1:39:34.31,1:39:39.19,كونان,,0000,0000,0000,,أن كان هكذا , فأنه لن يفكر بإصابة هذه الشجرة المهمة أبداً
Dialogue: 0,1:39:39.90,1:39:43.82,لوبين,,0000,0000,0000,,فهمت , هكذا إذاً قد علمت بالأمر
Dialogue: 0,1:39:44.49,1:39:48.15,كونان,,0000,0000,0000,,شجرة الساكورا .. هي من أخبرتني بذلك
Dialogue: 0,1:39:51.49,1:39:54.49,كونان,,0000,0000,0000,,آه صحيح , هل يمكنني أن أسألك سؤالاً أيضاً ؟
Dialogue: 0,1:39:54.70,1:39:55.49,لوبين,,0000,0000,0000,,هاه ؟
Dialogue: 0,1:39:55.78,1:39:59.41,كونان,,0000,0000,0000,,لم أعرف أسمك إلى الآن
Dialogue: 0,1:40:01.41,1:40:02.79,لوبين,,0000,0000,0000,,هكذا إذاً ؟
Dialogue: 0,1:40:03.58,1:40:04.75,لوبين,,0000,0000,0000,,... أسمي هو
Dialogue: 0,1:40:05.54,1:40:07.33,لوبين,,0000,0000,0000,,لوبين .. الثالث
Dialogue: 0,1:40:20.55,1:40:23.34,all,,0000,0000,0000,,هل من الجيد أبقى الأمر سراً عن المفتش زينيجاتا ؟
Dialogue: 0,1:40:23.96,1:40:27.55,كيث,,0000,0000,0000,,أنها أوامر الملكة .. لايمكننا معارضة ذلك
Dialogue: 0,1:40:37.60,1:40:42.76,all,,0000,0000,0000,,!اللعنة ! أن وجدته مجدداً , سأمسكة بدون شك
Dialogue: 0,1:40:42.89,1:40:46.73,ران,,0000,0000,0000,,لكن , أليس هذا جيداً , الأشرار قد أخذوا جزائهم
Dialogue: 0,1:40:46.85,1:40:48.06,all,,0000,0000,0000,,! لوبين
Dialogue: 0,1:40:48.14,1:40:49.60,ران,,0000,0000,0000,,! ليس جميعهم
Dialogue: 0,1:40:58.69,1:41:02.07,ميرا,,0000,0000,0000,,أولئك الأشخاص قد غادرو مسبقاً
Dialogue: 0,1:41:02.23,1:41:03.32,كيث,,0000,0000,0000,,هكذا إذاً ؟
Dialogue: 0,1:41:04.03,1:41:08.15,ميرا,,0000,0000,0000,,لنعد بسرعة ... لنحمي التاج الملكي
Dialogue: 0,1:41:10.11,1:41:14.07,ميرا,,0000,0000,0000,,أن لم تصبح هذه البلاد جميلة وأمنة
Dialogue: 0,1:41:14.66,1:41:17.07,ميرا,,0000,0000,0000,,فأنه سيعود
Dialogue: 0,1:41:26.58,1:41:31.83,ميرا,,0000,0000,0000,,لقد حصلتِ على تقديري , شكراً جزيلاً لكِ
Dialogue: 0,1:41:32.21,1:41:36.33,ميرا,,0000,0000,0000,,ران لقد كنت سعيدة جداً تلك الليلة , والفضل يعودو لكِ ران
Dialogue: 0,1:41:36.46,1:41:39.46,ران,,0000,0000,0000,,... لا على الأطلاق , بالحقيقة يمكنني أن أكون أميرة لفترة
Dialogue: 0,1:41:39.75,1:41:41.96,all,,0000,0000,0000,,... أميرة ميرا , لقد حان الوقت
Dialogue: 0,1:41:42.21,1:41:44.05,all,,0000,0000,0000,,!آه , أين كونان ؟
Dialogue: 0,1:41:44.17,1:41:47.36,ران,,0000,0000,0000,,آه , الآن قال بأنه يريد أن يشاهد مراسم التتويج
Dialogue: 0,1:41:47.63,1:41:51.26,كيث,,0000,0000,0000,,قبل قليل , قد أخذته السفارة اليابانية
Dialogue: 0,1:41:51.55,1:41:54.34,كيث,,0000,0000,0000,,مهما كان الوضع , فلقد دخل البلاد بصوره غير شرعية
Dialogue: 0,1:41:54.43,1:41:55.59,all,,0000,0000,0000,,أصبت بذلك
Dialogue: 0,1:41:56.01,1:41:58.59,all,,0000,0000,0000,,إذاً , يجب علينا الذهب أيضاً
Dialogue: 0,1:42:00.05,1:42:01.51,لوبين,,0000,0000,0000,,الفتى معي , لوبين الثالث
Dialogue: 0,1:42:01.55,1:42:03.01,all,,0000,0000,0000,,!ماذا ؟
Dialogue: 0,1:42:01.55,1:42:03.01,ران,,0000,0000,0000,,!ماذا ؟
Dialogue: 0,1:42:03.35,1:42:05.01,ميرا,,0000,0000,0000,,آه , ياللآسف
Dialogue: 0,1:42:13.31,1:42:14.06,كونان,,0000,0000,0000,,هذا سيء
Dialogue: 0,1:42:14.64,1:42:19.48,كونان,,0000,0000,0000,,... أن تحققوا من جوازي  .. فأنهم سيعلمون بإن كونان إيدغوا ليس له وجود
Dialogue: 0,1:42:20.15,1:42:23.73,لوبين,,0000,0000,0000,,كما هو متوقع من المحقق البارع
Dialogue: 0,1:42:24.40,1:42:26.82,كونان,,0000,0000,0000,,آه ! عمـ .. لوبين ؟
Dialogue: 0,1:42:27.27,1:42:30.27,كونان,,0000,0000,0000,,لاتنحرج  , فقط نادني بـ عمي
Dialogue: 0,1:42:31.15,1:42:33.44,all,,0000,0000,0000,,لقد كان متنكراً
Dialogue: 0,1:42:33.57,1:42:35.03,فوجي,,0000,0000,0000,,ألم تنتبة لذلك ؟
Dialogue: 0,1:42:35.11,1:42:36.48,كونان,,0000,0000,0000,,! فتاة الدراجة
Dialogue: 0,1:42:36.48,1:42:38.35,كونان,,0000,0000,0000,,! وأيضاً بابا
Dialogue: 0,1:42:38.53,1:42:40.57,all,,0000,0000,0000,,أنت حقاً تستمتع بمنادتي بـ بابا ؟
Dialogue: 0,1:42:40.62,1:42:41.87,كونان,,0000,0000,0000,,! مؤلم
Dialogue: 0,1:42:42.07,1:42:44.12,all,,0000,0000,0000,,مهما نظرت للأمر , فهو لايزال طفلاً
Dialogue: 0,1:42:45.20,1:42:48.45,لوبين,,0000,0000,0000,,وأيضاً في داخل هذا المظهر اللطيف طالب في المرحلة الثانوية
Dialogue: 0,1:42:48.54,1:42:49.54,كونان,,0000,0000,0000,,... ما
Dialogue: 0,1:42:49.87,1:42:53.04,فوجي,,0000,0000,0000,,أنت تشعر بالأزعاج لأنك تحولت لطفل , صحيح ؟
Dialogue: 0,1:42:53.91,1:42:55.46,all,,0000,0000,0000,,هل هذا فلمً للكبار ؟
Dialogue: 0,1:42:55.47,1:42:57.79,فوجي,,0000,0000,0000,,ليس فلمً للكبار
Dialogue: 0,1:42:58.62,1:43:04.34,لوبين,,0000,0000,0000,,آه , دوري الآن , لدي الذكاء , وأيضاً جسم شخصاً بالغ
Dialogue: 0,1:43:05.28,1:43:07.05,لوبين,,0000,0000,0000,,! مؤلم
Dialogue: 0,1:43:07.13,1:43:08.71,all,,0000,0000,0000,,بالنهاية فهو فلمً للكبار
Dialogue: 0,1:43:09.13,1:43:14.63,لوبين,,0000,0000,0000,,لاتقلق , هذه الفتاة سترسلك إلى اليابان , يا سينشي كودو
Dialogue: 0,1:43:15.29,1:43:17.68,فوجي,,0000,0000,0000,,بين الحين والآخر , ستصدم بسفينة شخصاً تعرفة
Dialogue: 0,1:43:18.29,1:43:19.05,كونان,,0000,0000,0000,,... شكراً
Dialogue: 0,1:43:20.14,1:43:20.80,كونان,,0000,0000,0000,,... لكن
Dialogue: 0,1:43:21.22,1:43:24.85,كونان,,0000,0000,0000,,أن سرقتم مجدداً , فسأمسك بكم جميعاً
Dialogue: 0,1:43:36.44,1:43:37.52,all,,0000,0000,0000,,ماذا ستفعل لوبين ؟
Dialogue: 0,1:43:37.69,1:43:39.94,all,,0000,0000,0000,,يقول بأنه سيمسك بنا
Dialogue: 0,1:43:41.35,1:43:42.77,لوبين,,0000,0000,0000,,! لاتكن غبياً
Dialogue: 0,1:43:44.94,1:43:46.52,لوبين,,0000,0000,0000,,المحقق كونان ؟
Dialogue: 0,1:43:51.69,1:43:55.74,فوجي,,0000,0000,0000,,هيا , لدي بعض الوقت , دعني أتأكد منه
Dialogue: 0,1:43:55.99,1:43:56.78,كونان,,0000,0000,0000,,هاه ؟ ماذا .. ماذا ؟
Dialogue: 0,1:43:56.90,1:44:00.86,فوجي,,0000,0000,0000,,مازلت تحتاج للسؤال ؟ بالطبع لسر التجديد
Dialogue: 0,1:44:01.23,1:44:03.37,كونان,,0000,0000,0000,,التجديد ؟ تعنين الأنكماش ؟
