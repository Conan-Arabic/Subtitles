1
00:00:01,010 --> 00:00:04,250
تتضاعف القضايا المعقّدة
مع مضيّ خط الوقت

2
00:00:04,600 --> 00:00:08,430
! الوقت الآن السابعة والنصف!
هناك شيءٌ سيحصل قرب أيومي

3
00:00:08,800 --> 00:00:10,209
يرى الحقيقة الواحدة

4
00:00:10,210 --> 00:00:12,469
يحمل مظهر طفل، لكنّ عقله عقل بالغ

5
00:00:12,470 --> 00:00:14,960
! اسمه المتحرّي كونان

6
00:01:45,960 --> 00:01:50,290
جريمة قتل يوم الإثنين، 7:30 مساءً

7
00:01:54,360 --> 00:01:57,649
يجب ألّا تفوتنا حلقة
! يايبا المقنّع اليوم قطعاً

8
00:01:57,650 --> 00:02:01,569
! إنّها المعركة الحاسمة ضدّ مُحارب ميدوري،
باتلر

9
00:02:01,570 --> 00:02:03,989
! أشعر بحماسٍ من الآن

10
00:02:03,990 --> 00:02:06,980
ما الخطب يا أيومي-تشان؟
لا تبدين على خير

11
00:02:07,570 --> 00:02:11,930
عليّ الذهاب للعيادة وخلع سنٍّ اليوم

12
00:02:12,910 --> 00:02:14,370
تعانين من تسوّس؟

13
00:02:14,420 --> 00:02:19,029
كلا، هذا سنٌّ لبنيّ يرفض السقوط

14
00:02:19,030 --> 00:02:22,830
قالت الطبيبة أنّه سيعترض نمو سنّي الدائم

15
00:02:23,060 --> 00:02:26,439
! تؤلمني أسناني من مجرد سماع ذلك

16
00:02:26,440 --> 00:02:28,170
من هي طبيبتك؟

17
00:02:28,440 --> 00:02:31,299
عيادة ساواكي قرب حديقة بيكا

18
00:02:31,300 --> 00:02:34,149
! ذهبتُ هناك قبلاً

19
00:02:34,150 --> 00:02:37,269
! الطبيبة هناك جميلةٌ جدّاً ولطيفة

20
00:02:37,270 --> 00:02:41,849
أجل، كان جدول الطبيبة
يوكو مشغولاً لأسبوع من الآن

21
00:02:41,850 --> 00:02:45,689
لكنّها قالت أنّ من الأفضل الإبكار

22
00:02:45,690 --> 00:02:49,189
فستقابلني بعد ساعات
عملها الاعتيادية استثناءً

23
00:02:49,190 --> 00:02:50,969
في أيّ وقت؟

24
00:02:50,970 --> 00:02:52,019
السادسة والنصف

25
00:02:52,020 --> 00:02:56,480
يبدأ يايبا المقنّع عند السابعة والنصف
لذا يُفترض أن تصلي في الوقت

26
00:02:57,150 --> 00:03:00,229
يايبا المقنّع والأسنان اللبنية

27
00:03:00,230 --> 00:03:04,090
أصبحت أعيش حياة طالب ابتدائية بحذافيرها

28
00:03:09,440 --> 00:03:10,839
هذا هو المكان

29
00:03:10,840 --> 00:03:12,649
عيادة ساواكي للأسنان

30
00:03:12,650 --> 00:03:14,799
مُغلقة لليوم

31
00:03:14,800 --> 00:03:17,689
أخبرتني أن أدخل من الخلف

32
00:03:17,690 --> 00:03:18,710
من هنا

33
00:03:29,690 --> 00:03:32,150
باب عيادة ساواكي للأسنان الجانبيّ

34
00:03:35,950 --> 00:03:38,410
ساواكي ساما

35
00:03:40,980 --> 00:03:42,259
مرحباً

36
00:03:42,260 --> 00:03:43,370
! أنا أيومي

37
00:03:44,600 --> 00:03:46,029
أهلاً

38
00:03:46,030 --> 00:03:47,030
ماذا؟

39
00:03:47,110 --> 00:03:49,989
سأقدّمه لك، إنّه إيدوغاوا كونان-كن

40
00:03:49,990 --> 00:03:52,069
رافقني لأنّه شعر بالقلق عليّ

41
00:03:52,070 --> 00:03:54,069
مساء الخير

42
00:03:54,070 --> 00:03:58,449
، أخبرتني أيومي-تشان الكثير عنك
وعن الرجل الذي تعيش معه

43
00:03:58,450 --> 00:04:02,359
! سمعتُ أنّه مُتحرٍّ
شهير يحلّ مختلف القضايا

44
00:04:02,360 --> 00:04:04,069
أجل، نوعاً ما

45
00:04:04,070 --> 00:04:06,989
سمعتُ أنّك مُتحرٍّ بارع بدورك يا كونان-كن

46
00:04:06,990 --> 00:04:08,949
لستُ بذاك

47
00:04:08,950 --> 00:04:11,409
احترس في طريق عودتك إذاً

48
00:04:11,410 --> 00:04:14,370
سأنتظر حتّى تنتهي أيومي-تشان

49
00:04:14,950 --> 00:04:17,649
لا تقلق، سآخذها معي للبيت

50
00:04:17,650 --> 00:04:20,710
عليك العودة بما أنّ الظلام سيخيم

51
00:04:21,400 --> 00:04:23,860
هيّا، لندخل يا أيومي-تشان

52
00:04:27,200 --> 00:04:29,319
دعيها تقلّك للمنزل إذاً

53
00:04:29,320 --> 00:04:30,719
سأرجع الآن

54
00:04:30,720 --> 00:04:33,680
! أجل، شكراً لك يا كونان-كن

55
00:04:38,780 --> 00:04:41,739
سأجهز في لحظات، لذا انتظري هنا

56
00:04:41,740 --> 00:04:42,740
! حسناً

57
00:04:56,540 --> 00:04:58,610
! بطاقات لعب يايبا المقنّع

58
00:05:08,150 --> 00:05:09,569
أرجوك يا يايبا المقنّع

59
00:05:09,570 --> 00:05:12,110
احمني من الألم

60
00:05:15,490 --> 00:05:17,649
! ما الذي تقوله أيّها الأحمق؟

61
00:05:17,650 --> 00:05:19,449
لا أهتم إذا كان المبنى معيوباً أم لا

62
00:05:19,450 --> 00:05:23,340
! أنا من يقرّر بيعه! اكفني من ثرثرتك

63
00:05:24,530 --> 00:05:26,199
من هذا؟

64
00:05:26,200 --> 00:05:27,200
! سأغلق الهاتف

65
00:05:29,820 --> 00:05:32,070
أجل، من هناك؟

66
00:05:40,570 --> 00:05:42,700
لـ-لمَ؟

67
00:05:51,180 --> 00:05:52,759
ابتدائية بيكا

68
00:05:52,760 --> 00:05:54,989
أسمعتم؟

69
00:05:54,990 --> 00:05:57,720
! وقعت جريمة قتل في هايدو البارحة

70
00:05:57,990 --> 00:05:59,819
أجل، قرأتُ عنها في الصحف

71
00:05:59,820 --> 00:06:02,559
كان الضحيّة رئيس وكالة عقارات

72
00:06:02,560 --> 00:06:06,820
ومن عثر على جثّته كانت جارته ومدير المبنى

73
00:06:07,800 --> 00:06:12,310
! وخمّنوا من كانت تلك
المرأة؟ طبيبة أسنان أيومي-تشان

74
00:06:14,030 --> 00:06:17,109
أتى شرطيّ لمنزلي البارحة في وقتٍ متأخّر

75
00:06:17,110 --> 00:06:19,329
وسألني ما الذي كانت
تفعله عند السابعة والنصف

76
00:06:19,330 --> 00:06:20,749
السابعة والنصف؟

77
00:06:20,750 --> 00:06:25,109
أخبرته أنّ الطبيبة يوكو
كانت تخلع سنّي وقتها

78
00:06:25,110 --> 00:06:29,330
وشاهدنا يايبا المقنّع بعدها معاً
في غرفة الانتظار في العيادة

79
00:06:30,470 --> 00:06:33,639
! لمَ قد تسأل الشرطة عن شيء كهذا؟

80
00:06:33,640 --> 00:06:38,949
يتحققون من حجّة غيابها
بما أنّها أول من وجد الجثّة غالباً

81
00:06:38,950 --> 00:06:41,600
وقعت الجريمة عند السابعة والنصف بالتأكيد

82
00:06:41,860 --> 00:06:44,279
هذا ما قاله الشرطيّ

83
00:06:44,280 --> 00:06:47,540
! يعني أنّ الطبيبة يوكو
بريئة إذاً! حُسِم الأمر

84
00:06:48,110 --> 00:06:49,110
ميتسوهيكو

85
00:06:49,111 --> 00:06:52,030
ألم تكن حلقة يايبا المقنّع البارحة
مثيرةً جدّاً؟

86
00:06:52,320 --> 00:06:57,649
، بلى! في الذروة عند قتاله مع باتلر تحديداً
! شعرتُ بحماسٍ شديد حتّى تعرّقت يداي

87
00:06:57,650 --> 00:06:59,320
أليس كذلك يا أيومي-تشان؟

88
00:07:02,570 --> 00:07:04,250
! أشعر بالغيظ

89
00:07:04,800 --> 00:07:07,200
! لم أشاهد شيئاً تقريباً

90
00:07:07,990 --> 00:07:10,129
لكنّك قلتِ أنّك رأيته مع الطبيبة

91
00:07:10,130 --> 00:07:11,819
شاهدتُ البداية فقط

92
00:07:11,820 --> 00:07:14,089
ونمتُ خلال الباقي

93
00:07:14,090 --> 00:07:15,509
! نمتِ؟

94
00:07:15,510 --> 00:07:18,210
! ما قصدك؟ أعطنا التفاصيل

95
00:07:18,570 --> 00:07:19,950
حسناً، بالأمس

96
00:07:21,240 --> 00:07:24,109
خلعته! لم تشعري بألم، صحيح؟

97
00:07:24,110 --> 00:07:25,450
أجل

98
00:07:27,280 --> 00:07:30,230
أشعر بالنعاس لسببٍ ما

99
00:07:30,610 --> 00:07:33,279
لا بدّ أنّك مرهقة من القلق

100
00:07:33,280 --> 00:07:36,150
يمكنك الاستراحة قليلاً في غرفة الانتظار

101
00:07:36,400 --> 00:07:39,490
لكن يبدأ يايبا المقنّع عند السابعة والنصف

102
00:07:41,080 --> 00:07:44,279
لا تقلقي، سأوقظك قبلها

103
00:07:44,280 --> 00:07:46,750
فيمكنك مشاهدته هناك، اتّفقنا؟

104
00:07:47,070 --> 00:07:48,070
حسناً

105
00:07:50,780 --> 00:07:53,010
! أيومي-تشان، أيومي-تشان

106
00:07:53,450 --> 00:07:54,520
! استيقظي

107
00:07:55,010 --> 00:07:56,510
سيبدأ يايبا المقنّع

108
00:08:06,320 --> 00:08:07,730
! يايبا

109
00:08:08,990 --> 00:08:11,150
خذي هذه يا أيومي-تشان

110
00:08:11,530 --> 00:08:15,899
إنّه دواء للألم، فقد تشعرين بالجوع
بعدما يزول تأثير المخدّر

111
00:08:15,900 --> 00:08:16,900
حسناً

112
00:08:20,860 --> 00:08:21,900
فتاة مطيعة

113
00:08:33,030 --> 00:08:34,100
! صحيح

114
00:08:35,240 --> 00:08:37,739
! يايبا المقنع، شكراً لك على حمايتي

115
00:08:37,740 --> 00:08:39,930
بالكاد شعرتُ بألم بفضلك

116
00:08:43,610 --> 00:08:46,390
شكرتُه ثم أعدت البطاقة

117
00:08:47,780 --> 00:08:51,109
استعملتِ بطاقة يايبا المقنّع
كتميمة حظّ حسن إذاً؟

118
00:08:51,110 --> 00:08:52,199
وبعدها؟

119
00:08:52,200 --> 00:08:55,569
كنتُ أشاهد بتركيز في البداية

120
00:08:55,570 --> 00:08:58,820
لكن غلبني النعاس مُجدداً

121
00:09:02,110 --> 00:09:05,200
أيومي-تشان، استيقظي يا أيومي-تشان

122
00:09:08,450 --> 00:09:09,450
في الحلقة القادمة

123
00:09:10,240 --> 00:09:11,879
! انتهى

124
00:09:11,880 --> 00:09:15,949
آسفة، حاولت إيقاظك لكنّك
كنتِ مُستغرقة في النوم

125
00:09:15,950 --> 00:09:17,839
هيّا، لنرجع للبيت

126
00:09:17,840 --> 00:09:19,140
حسناً

127
00:09:21,950 --> 00:09:24,559
فلم أشاهد كاملاً

128
00:09:24,560 --> 00:09:28,649
! لا تكتئبي هكذا! لا بدّ أنّ أحداً ما سجّله

129
00:09:28,650 --> 00:09:30,940
أجل، لنسأل الجميع لاحقاً

130
00:09:35,570 --> 00:09:36,819
لقد عُدت

131
00:09:36,820 --> 00:09:37,650
! حضرة المفتّش

132
00:09:37,651 --> 00:09:39,730
! مرحباً يا كونان-كن! كنتُ أنتظرك

133
00:09:40,400 --> 00:09:43,609
أتيتُ للتحقق من شيءٍ معك بخصوص البارحة

134
00:09:43,610 --> 00:09:45,009
اجلس

135
00:09:45,010 --> 00:09:45,740
حاضر

136
00:09:45,741 --> 00:09:46,949
إذاً حضرة المفتش

137
00:09:46,950 --> 00:09:49,319
لمَ أخذت ساواكي يوكو مدير المبنى

138
00:09:49,320 --> 00:09:51,170
لشقّة الضحيّة؟

139
00:09:51,610 --> 00:09:54,199
، وفقاً للمدير

140
00:09:54,200 --> 00:09:58,209
فقد تضايقت من ارتفاع صوت تلفاز ناكاموتو

141
00:09:58,210 --> 00:10:02,779
، بعدما عادت من العيادة عند الثامنة والنصف
فذهبت للمدير وتوجّها لشقّته معاً

142
00:10:02,780 --> 00:10:06,359
لكنّه لم يسمع شيئاً، وعندما فتح الباب

143
00:10:06,360 --> 00:10:10,139
وجد جثّة الضحية أمامه

144
00:10:10,140 --> 00:10:14,569
،
إذا تكبّدت عناء القدوم هنا ومراجعتي في أمر

145
00:10:14,570 --> 00:10:16,939
فلا بدّ أنّ الطبيبة يوكو تملك دافعاً

146
00:10:16,940 --> 00:10:19,220
أ-أهذا صحيح حضرة المفتّش؟

147
00:10:19,400 --> 00:10:23,239
قبل 26 عاماً،
اُعتقل الضحيّة ناكاموتو كاتسوهيكو

148
00:10:23,240 --> 00:10:26,319
بشبهة اختطاف وقتل طفل

149
00:10:26,320 --> 00:10:28,430
من محافظة ياماناشي

150
00:10:28,780 --> 00:10:29,910
! ماذا؟

151
00:10:31,320 --> 00:10:34,289
كان الضحيّة وقتها صبيّاً في التاسعة

152
00:10:34,290 --> 00:10:39,210
لكن تمّ إطلاق سراح ناكاموتو لضعف الدلائل

153
00:10:39,840 --> 00:10:43,929
كان لذاك الصبيّ أخت في السابعة

154
00:10:43,930 --> 00:10:45,460
وهي نفسها

155
00:10:45,970 --> 00:10:48,410
! ساواكي يوكو

156
00:10:49,320 --> 00:10:53,279
أي أنّ لها دافعاً قويّاً لقتله

157
00:10:53,280 --> 00:10:56,319
صحيح، لكنّها تقول أنّها لم تعلم

158
00:10:56,320 --> 00:11:00,439
أنّ ناكاموتو كان المشتبه به الرئيسيّ
في جريمة الاختطاف والقتل قبل 26 عاماً

159
00:11:00,440 --> 00:11:03,909
تبدو أكثر من مصادفة

160
00:11:03,910 --> 00:11:09,069
أيمكن أنّك أتيت لسماع وجهة نظر
عمّي المتحرّي العظيم في الواقع؟

161
00:11:09,070 --> 00:11:13,330
كلا... حسناً،
على الشرطة عدم إقحام المدنيّين

162
00:11:14,460 --> 00:11:19,299
هكذا إذاً؟ لا أمانع المساعدة
في تلك الحالة حضرة المفتّش

163
00:11:19,300 --> 00:11:23,050
المشكلة هي حجّة الغياب
التي شهدت بها أيومي-كن

164
00:11:23,530 --> 00:11:26,149
تستغرق المسافة 15 دقيقة
من عيادة ساواكي يوكو

165
00:11:26,150 --> 00:11:28,350
إلى منزلها في هايدو بالسيّارة

166
00:11:28,950 --> 00:11:31,949
، إذا تركت أيومي-كن تنام في العيادة

167
00:11:31,950 --> 00:11:35,449
،
وذهبت بالسيّارة وحدها للمنزل وقتلت ناكاموتو

168
00:11:35,450 --> 00:11:39,320
ثم عادت قيادةً مجدداً
فستستغرق قرابة 50 دقيقة

169
00:11:39,650 --> 00:11:42,949
أي، بدون شهادة أيومي-كن
أنّ ساواكي يوكو

170
00:11:42,950 --> 00:11:46,609
أيقظتها عند السابعة والنصف
وشاهدت يايبا المقنّع معها

171
00:11:46,610 --> 00:11:50,000
فكانت لتملك وقتاً كافياً لارتكاب الجريمة

172
00:11:52,660 --> 00:11:57,129
أخبرني حضرة المفتّش، أأنتم متأكدون
من وقوع الجريمة في السابعة والنصف؟

173
00:11:57,130 --> 00:12:01,609
أجل، فأحد موظفيّ ناكاموتو كان معه
على الهاتف قبل الحادثة

174
00:12:01,610 --> 00:12:07,140
سمع صوت الجرس عند السابعة وتسع وعشرون دقيقة

175
00:12:07,570 --> 00:12:12,059
أكّد التشريح الجنائي أنّه مات قرابة
السابعة والنصف أيضاً

176
00:12:12,060 --> 00:12:16,020
أي أنّ حجّة غياب ساواكي يوكو مطبقة

177
00:12:16,860 --> 00:12:19,950
! فهمت! حللتُ الأمر حضرة المفتّش

178
00:12:20,320 --> 00:12:22,859
لنذهب لعيادة ساواكي للأسنان الآن

179
00:12:22,860 --> 00:12:25,989
سأكسر أنا المتحرّي العظيم موري كوغورو

180
00:12:25,990 --> 00:12:27,950
! حجّة غيابها أمام عينيها

181
00:12:30,400 --> 00:12:32,580
! حـ-حقاً يا موري-كن؟

182
00:12:36,200 --> 00:12:37,420
تفضّلوا

183
00:12:40,740 --> 00:12:43,399
نعتذر على مضايقتك فجأةً هكذا

184
00:12:43,400 --> 00:12:45,630
لا مشكلة، اجلسوا رجاءً

185
00:12:50,050 --> 00:12:53,009
هذه البطاقات التي تكلّمت عنها أيومي-تشان؟

186
00:12:53,010 --> 00:12:54,359
سأجلب قهوة

187
00:12:54,360 --> 00:12:55,810
انتظري قليلاً

188
00:12:56,140 --> 00:13:00,569
لا داعي للقهوة، أصغي لنظريتيّ فقط

189
00:13:00,570 --> 00:13:05,069
! قاتل السيّد ناكاموتو كان أنت

190
00:13:05,070 --> 00:13:05,780
ماذا؟

191
00:13:05,781 --> 00:13:08,909
لكن يا موري-كن، لديها حجّة غياب

192
00:13:08,910 --> 00:13:13,649
حضرة المفتّش، يايبا المقنّع الذي
أوقظت أيومي-كن لتشاهده

193
00:13:13,650 --> 00:13:15,989
كان تسجيلاً في الواقع

194
00:13:15,990 --> 00:13:19,600
! ولم تشغّله عند السابعة والنصف، بل الثامنة

195
00:13:19,610 --> 00:13:20,880
! ماذا؟

196
00:13:26,700 --> 00:13:27,970
أكمل رجاءً

197
00:13:28,530 --> 00:13:32,399
أي أنّك قتلتِ السيّد ناكاموتو

198
00:13:32,400 --> 00:13:35,480
،
ورجعتِ هنا عند السابعة وخمسٍ وخمسين تقريباً

199
00:13:36,200 --> 00:13:37,980
أيقظتِ أيومي-كن عند الثامنة

200
00:13:38,650 --> 00:13:42,910
وشغّلتِ حلقة يايبا المقنّع
التي اكتمل تسجيلها على شريط للتوّ

201
00:13:43,650 --> 00:13:47,279
، ثمّ خدعتها لتناول حبّة
منوّمة بداعي تخفيف الألم

202
00:13:47,280 --> 00:13:48,989
فنامت مُجدداً

203
00:13:48,990 --> 00:13:52,670
وأيقظتِها مُجدداً بعد 10 دقائق
وأريتِها عرض الحلقة القادمة

204
00:13:53,570 --> 00:14:00,510
عدّلتِ الساعة بالطبع فتلاعبتِ
بحسّ أيومي-كن بالوقت

205
00:14:01,450 --> 00:14:03,739
! كما يُتوقع منك يا موري-كن

206
00:14:03,740 --> 00:14:05,500
لكن يا أبي

207
00:14:05,740 --> 00:14:07,450
لا يوجد مشغّل فيديو هنا

208
00:14:09,310 --> 00:14:11,529
! حسناً، تخلّصتْ منه

209
00:14:11,530 --> 00:14:14,160
كيلا يكتشف أحدٌ الحيلة

210
00:14:14,450 --> 00:14:18,239
يؤسفني قول هذا، لكنّ نظريتك ليس صحيحاً

211
00:14:18,240 --> 00:14:20,899
فقد كانت الساعة الثامنة تماماً

212
00:14:20,900 --> 00:14:24,090
عندما أخذتُ أيومي-تشان للمنزل من العيادة

213
00:14:25,380 --> 00:14:29,569
ووصلنا لمنزلها بعد الثامنة وخمس دقائق بقليل

214
00:14:29,570 --> 00:14:32,440
أنا متأكدة بإمكانك التحقق من ذلك

215
00:14:32,490 --> 00:14:34,380
! لا-لا يمكن

216
00:14:39,400 --> 00:14:40,500
يا إلهي

217
00:14:40,540 --> 00:14:43,000
لم تُصب نظرية العمّ

218
00:14:44,200 --> 00:14:46,699
لا تقلق، سآخذها معي للبيت

219
00:14:46,700 --> 00:14:49,920
عليك العودة بما أنّ الظلام سيخيم

220
00:14:50,740 --> 00:14:53,930
لكنّها أصرّت على أن أغادر وقتها

221
00:14:54,900 --> 00:14:58,850
أكان ذلك لأنّ وجودي
سيمنعها من تزييف حجّة غيابها؟

222
00:14:59,780 --> 00:15:03,449
إذا تعمّدت أن تكون أول من يكتشف
الجثّة بعد وصولها البيت

223
00:15:03,450 --> 00:15:07,440
كي تُعطي الشرطة وقت وفاة دقيق

224
00:15:08,070 --> 00:15:10,740
! فإذاً كلّ شيء كان لتركيب حجّة غيابها

225
00:15:11,530 --> 00:15:13,649
إذا كانت المجرمة

226
00:15:13,650 --> 00:15:17,200
! فلا بدّ من وجود حيلة
في جزءٍ من حجّة غيابها

227
00:15:17,680 --> 00:15:18,910
في جزءٍ ما

228
00:15:28,460 --> 00:15:33,370
يمكن تنفيذ حيل حُجج الغياب
باستعمال الناس والأماكن والزمن

229
00:15:34,070 --> 00:15:37,860
من ناحية الناس،
لا أظنّ أنّ شهادة أيومي-تشان خاطئة

230
00:15:38,610 --> 00:15:42,290
الوفاة وموعد العيادة ثابتا الوقت

231
00:15:43,200 --> 00:15:44,920
مما يترك

232
00:15:46,650 --> 00:15:48,050
حيلة مكان

233
00:16:03,990 --> 00:16:06,020
مجمع شقق قيد الإنشاء؟

234
00:16:12,780 --> 00:16:14,980
هل أوقفوا البناء قبل اكتماله؟

235
00:16:20,200 --> 00:16:22,220
آثار الإطارات هذه حديثة

236
00:16:22,900 --> 00:16:24,630
إذا أوقفتَ سيّارةً هنا

237
00:16:25,280 --> 00:16:29,230
يمكنك الدخول لمجمع الشقق
عبر أدراج الطوارئ دون أن يراك أحد

238
00:16:32,530 --> 00:16:34,560
لا بدّ أنّ هذه شقّة الطبيبة

239
00:16:35,070 --> 00:16:37,930
فالستائر في عيادتها تحمل التصميم نفسه

240
00:16:45,580 --> 00:16:48,120
! هكذا إذاً! فهمت

241
00:16:48,740 --> 00:16:51,579
! كانت هذه حيلة مكان بالفعل

242
00:16:51,580 --> 00:16:55,960
ما يعني أنّ ذاك الشيء
! لا يزال في شقّتها حتماً

243
00:17:01,240 --> 00:17:02,240
ماذا؟

244
00:17:04,490 --> 00:17:05,719
كونان-كن؟

245
00:17:05,720 --> 00:17:06,910
! مرحباً

246
00:17:07,860 --> 00:17:10,020
أريد مناقشة موضوعٍ معك

247
00:17:10,270 --> 00:17:13,650
موضوع؟ ما هو بالضبط؟

248
00:17:18,240 --> 00:17:19,830
هيّا، تفضّل

249
00:17:27,070 --> 00:17:29,609
هل تريد عصيراً يا كونان-كن؟

250
00:17:29,610 --> 00:17:30,670
أجل

251
00:17:30,950 --> 00:17:33,010
هل تخلّصتِ من ثلّاجتك؟

252
00:17:33,320 --> 00:17:34,170
ماذا؟

253
00:17:34,290 --> 00:17:36,930
أرى أنّك غيّرتِ الساعة والتقويم

254
00:17:37,610 --> 00:17:41,650
لكن أعتقد أنّ التلفاز وجهاز التكييف
كانا كبيرين جدّاً فلم تغيريهما فوراً

255
00:17:41,950 --> 00:17:43,080
ما الذي تتكلم عنه؟

256
00:17:43,140 --> 00:17:47,109
ستُثيرين الشبهة إذا تخلّصتِ
من أريكتك وطاولتك بهذه السرعة

257
00:17:47,110 --> 00:17:48,819
، وأفهم وضع ورق الحائط

258
00:17:48,820 --> 00:17:51,550
لكن ألم يكن عليك تغيير ستائر النافذة؟

259
00:17:52,070 --> 00:17:53,540
كونان-كن

260
00:17:53,560 --> 00:17:56,680
اكتشفتُ حيلتك

261
00:17:57,530 --> 00:18:02,069
جعلتِ هذه الغرفة مُشابهةً للغرفة في عيادتك

262
00:18:02,070 --> 00:18:04,650
كي تخدعي حسّ أيومي-تشان بالموقع

263
00:18:05,200 --> 00:18:07,199
تقول كلاماً مُثيراً

264
00:18:07,200 --> 00:18:09,780
أريد الاستماع لنظريتك أيّها المتحرّي

265
00:18:10,110 --> 00:18:13,989
جعلتِ أيومي-تشان تنام بالمخدّر أوّلاً

266
00:18:13,990 --> 00:18:17,690
ووضعتِها في السيّارة وذهبتِ لهايدو
عند السابعة وخمس دقائق

267
00:18:18,650 --> 00:18:22,949
وعند قرابة السابعة والثلث، أوقفتِ السيّارة
عند موقع البناء في الخلف

268
00:18:22,950 --> 00:18:25,710
وحملتِ أيومي-تشان عبر
أدراج الطوارئ ودخلتِ المبنى

269
00:18:26,740 --> 00:18:30,730
ووضعتِها في هذه الغرفة
المحاكية لغرفة عيادتك

270
00:18:30,770 --> 00:18:33,560
ذهبتِ بعدها للشقّة المجاورة
عند السابعة والنصف

271
00:18:34,110 --> 00:18:35,110
وقتلتِ ناكاموتو-سان

272
00:18:36,570 --> 00:18:40,110
ثمّ دخلتِ شقّته ورفعتِ صوت التلفاز

273
00:18:40,530 --> 00:18:44,199
بأمل أن يكتشف أحد جثّته سريعاً

274
00:18:44,200 --> 00:18:48,319
،
فإذا لم يُحدّد وقت الوفاة بأكبر دقّة ممكنة

275
00:18:48,320 --> 00:18:50,510
ستصبح حجّة غيابك تحت الشبهة

276
00:18:50,990 --> 00:18:53,999
عدتِ لشقّتك فوراً وأيقظتِ أيومي-تشان

277
00:18:54,000 --> 00:18:56,960
وأريتِها يايبا المقنّع الذي بدأ لتوّه

278
00:18:57,200 --> 00:18:59,330
وأعطيتِها حبّةً منومة بعدها بعشر دقائق

279
00:18:59,420 --> 00:19:05,960
وأخذتِها للعيادة بعدما نامت مجدداً لتصلا
عند قرابة السابعة وأربع وخمسون دقيقة

280
00:19:06,890 --> 00:19:10,940
ثمّ أيقظتِها مُجدداً وأريتِها عرض
الحلقة القادمة ليايبا المقنّع

281
00:19:11,650 --> 00:19:13,899
يُفترض أنّ كلّ شيءٍ جرى بسلاسة

282
00:19:13,900 --> 00:19:17,310
لكن عندما رجعتِ،
كانت جثّة ناكاموتو-سان لم تُكتشف بعد

283
00:19:18,110 --> 00:19:23,819
لم يكن أمامك خيار سوى استدعاء
مدير المبنى والعثور على الجثّة معه

284
00:19:23,820 --> 00:19:25,790
مدركةً للشبهة التي ستحيطك

285
00:19:26,450 --> 00:19:28,270
هذه نظريةٌ مُثيرة

286
00:19:29,280 --> 00:19:32,490
لكن لا دليل لديك لتدعمها

287
00:19:32,900 --> 00:19:34,649
الدليل موجود

288
00:19:34,650 --> 00:19:36,590
! في مجموعة البطاقات هذه

289
00:19:39,860 --> 00:19:42,109
ربما لم تعرفي

290
00:19:42,110 --> 00:19:46,319
لكنّ أيومي-تشان وضعت
إحدى هذه البطاقات في جيبها

291
00:19:46,320 --> 00:19:48,750
ليحالفها الحظّ قبل خلع سنّها

292
00:19:49,280 --> 00:19:51,069
آص القلوب

293
00:19:51,070 --> 00:19:54,740
أعادت البطاقة بعد خلع سنّها

294
00:19:56,650 --> 00:20:01,530
، إذا فعلَتْ ذلك في هذه الغرفة وليس العيادة

295
00:20:01,990 --> 00:20:05,070
فيُفترض أن توجد بطاقتَي
آص القلوب في هذه المجموعة

296
00:20:08,950 --> 00:20:10,200
الأولى

297
00:20:24,260 --> 00:20:28,510
بإحدى هذين البطاقتين بصمات أيومي-تشان

298
00:20:29,040 --> 00:20:32,630
كونان-كن، هل أخبرتَ أحداً عن هذا؟

299
00:20:32,690 --> 00:20:34,450
كلا، لا أحد

300
00:20:35,290 --> 00:20:38,910
لا يعرف أحدٌ أنّي أتيت هنا اليوم حتّى

301
00:20:56,080 --> 00:20:59,680
خسرتُ يا كونان-كن، كما استنتجتَ تماماً

302
00:20:59,940 --> 00:21:03,810
تذكّرتِ ناكاموتو-سان، أليس كذلك؟

303
00:21:04,750 --> 00:21:07,579
! كيف لي أن أنسى وجهه؟

304
00:21:07,580 --> 00:21:12,630
! رأيتُ ناكاموتو يأخذ
أخي للسيّارة قبل 26 عاماً

305
00:21:13,160 --> 00:21:17,510
من الصعب أن تدخل شهادتي المحاكمة
وأنا في السابعة وقتها

306
00:21:18,330 --> 00:21:20,350
ذلك ما اعتقدته الشرطة

307
00:21:20,650 --> 00:21:22,320
فاستسلموا وحسب

308
00:21:22,750 --> 00:21:29,370
أتمنّى لو كان يوجد شخصٌ مثلك
في الشرطة أو القضاء آنذاك

309
00:21:30,080 --> 00:21:35,410
كان ليجد دليلاً آخراً ويُحاكم ناكاموتو

310
00:21:39,700 --> 00:21:42,749
بدا من وجه الطبيبة يوكو حينها

311
00:21:42,750 --> 00:21:44,850
أنّ نزعتها الشرّيرة قد غادرتها

312
00:23:20,080 --> 00:23:24,239
لا أزال عاجزاً عن الفهم، لمَ سلّمت نفسها؟

313
00:23:24,240 --> 00:23:28,369
لم تجد الشرطة أيّ دليل البتّة

314
00:23:28,370 --> 00:23:32,039
ليس ذلك فقط، لم يكتشفوا حيلتها حتّى

315
00:23:32,040 --> 00:23:37,460
ربما أرادت أن يُقبض عليها
لنسبةٍ ما من البداية

316
00:23:37,750 --> 00:23:42,039
لذا استعملت أيومي-تشان لتشهد بحجّة غيابها

317
00:23:42,040 --> 00:23:44,300
فقد سمعت عنك من أيومي-تشان

318
00:23:44,700 --> 00:23:49,010
تقصد أنّها أرادتني أن أجد دليلاً؟

319
00:23:49,830 --> 00:23:54,450
أو ربما ساواكي يوكو-سان من قبل 26 عاماً

320
00:23:54,910 --> 00:23:56,160
أرادت مني ذلك

321
00:24:03,160 --> 00:24:06,590
أأنت متأكد أنّها تبحث عنه لأنّها تحبّه؟

322
00:24:07,070 --> 00:24:10,000
كونان-كن، عليك ألّا تتدخل

323
00:24:10,810 --> 00:24:13,380
حسناً، أوكايا-سان تعيش في

324
00:24:13,920 --> 00:24:15,799
في عمل أبي

325
00:24:15,800 --> 00:24:16,800
! حسناً

326
00:24:17,120 --> 00:24:19,029
! أعطني العنوان أيضاً

327
00:24:19,030 --> 00:24:20,859
ماذا؟ لمَ أعطيك؟

328
00:24:20,860 --> 00:24:23,480
! علينا الذهاب سريعاً وإلّا قد يُقتل أحد

329
00:24:26,030 --> 00:24:27,350
في الحلقة القادمة من كونان

330
00:24:27,480 --> 00:24:30,160
جريمة قتل زهرة الصبّار

331
00:24:46,890 --> 00:24:49,279
تلميح الحلقة القادمة

332
00:24:49,280 --> 00:24:51,280
رسمة شخصيّة

333
00:24:51,720 --> 00:24:53,960
تحوي قضيّة الحلقة القادمة قصّةً
حزينة نوعاً ما

