1
00:00:01,580 --> 00:00:04,190
تتضاعف القضايا المعقّدة
مع مضيّ خط الوقت

2
00:00:04,910 --> 00:00:06,999
تقع قضيّة اليوم داخل منزل جبليّ
! في عاصفة ثلجية

3
00:00:07,000 --> 00:00:08,899
! لا يبقى الضحيّة المقتول صامتاً

4
00:00:08,900 --> 00:00:11,239
يرى الحقيقة الواحدة

5
00:00:11,240 --> 00:00:13,159
يحمل مظهر طفل، لكنّ عقله عقل بالغ

6
00:00:13,160 --> 00:00:15,490
! اسمه المتحرّي كونان

7
00:01:45,980 --> 00:01:49,830
جريمة قتل منزل الجبل الثلجي

8
00:01:52,200 --> 00:01:53,790
! مرحى

9
00:01:56,670 --> 00:01:59,169
ماذا؟ لن تتزلّج يا أبي؟

10
00:01:59,170 --> 00:02:00,379
حمقاء

11
00:02:00,380 --> 00:02:06,300
أنا آخذ وقتي في الاستمتاع
بمنظر هذه السماء الصافية أوّلاً

12
00:02:06,920 --> 00:02:11,270
كما هذا الكساء الثلجي الباهر ناصع البياض

13
00:02:18,550 --> 00:02:22,190
تبّاً، كنتُ أعرف أنّه لم يجدر بي القدوم

14
00:02:23,670 --> 00:02:26,879
ماذا؟ فقدت مفتاح المقصورة المستأجرة؟

15
00:02:26,880 --> 00:02:29,830
يا إلهي، هذا بسبب ما فعلتماه

16
00:02:30,250 --> 00:02:35,119
بأيّ حال، كلّ ما يمكننا فعله هو الاتّصال
بالمشرف وطلب مفتاح بديل

17
00:02:35,120 --> 00:02:37,879
لا توجد حُجر هواتف في هذه المنطقة

18
00:02:37,880 --> 00:02:39,709
والمقصورة مقابلنا لا تزال قيد البناء

19
00:02:39,710 --> 00:02:41,420
وحافلة التزلج غادرت بالفعل

20
00:02:43,880 --> 00:02:46,630
ما بقربنا هو ذاك المنزل فحسب

21
00:02:46,900 --> 00:02:52,600
! أطلب مساعدة وغد ثريّ
يبني منزلاً هنا؟ مستحيل

22
00:02:53,460 --> 00:02:55,499
! لا خيار آخر، سنفتحه بالقوّة

23
00:02:55,500 --> 00:02:56,460
! لا تفعل يا عمّ
! كلا يا أبي

24
00:02:56,461 --> 00:02:59,190
ماذا؟ أيمكن أنّك

25
00:03:00,170 --> 00:03:03,019
إنّه أنت بالفعل، المتحرّي موري كوغورو-سان

26
00:03:03,020 --> 00:03:08,489
(أوياما ماساشي (53 بروفسور في كليّة الطب لجامعة توتو،
قسم الجراحة! أقرأ دائماً عن تحريّاتك المذهلة في الصحف

27
00:03:08,490 --> 00:03:11,450
! يا للمنزل الجميل

28
00:03:11,880 --> 00:03:15,249
! تصميمٌ ولون خشبيّ يخطف الأنظار

29
00:03:15,250 --> 00:03:18,710
ألم تكن من ينعت الوغد الثريّ قبل قليل؟

30
00:03:19,090 --> 00:03:23,089
بالمناسبة، لم أتعرف على اسمك بعد

31
00:03:23,090 --> 00:03:25,089
أأنتِ ابنة موري-سان؟

32
00:03:25,090 --> 00:03:27,589
أجل، أُدعى ران

33
00:03:27,590 --> 00:03:31,800
هذا إيدوغاوا كونان-كن،
ابن أحد الأصدقاء نعتني به

34
00:03:33,210 --> 00:03:37,520
! تصميم الأسد على الباب رائع أيضاً

35
00:03:38,960 --> 00:03:40,879
أردتُ حصاناً

36
00:03:40,880 --> 00:03:42,940
لكن ربما طلبتُ الكثير

37
00:03:43,300 --> 00:03:44,399
حصان؟

38
00:03:44,400 --> 00:03:47,859
صـ-صحيح، الحصان أفضل من الأسد

39
00:03:47,860 --> 00:03:50,459
كلا، لم أقصد ذلك

40
00:03:50,460 --> 00:03:52,030
! دكتور أوياما

41
00:03:52,440 --> 00:03:53,490
ناكاهارا-كن؟

42
00:03:53,670 --> 00:03:57,910
(ناكاهارا كاوري (30 باحثة في
كليّة الطب لجامعة توتو، قسم الجراحة

43
00:03:53,880 --> 00:03:55,209
! تأخّرت

44
00:03:55,210 --> 00:03:57,549
كان الجميع بانتظارك

45
00:03:57,550 --> 00:03:58,960
من الأشخاص رفقتك؟

46
00:03:59,910 --> 00:04:03,420
أصدقاء قابلتهم للتوّ

47
00:04:05,000 --> 00:04:09,209
ماذا؟ أنتم أطّباء في نفس الجامعة إذاً

48
00:04:09,210 --> 00:04:13,850
أجل، جميعنا مساعدون للدكتور أوياما

49
00:04:14,340 --> 00:04:16,010
فالأطبّاء يميلون للتجمّع تحت راية

50
00:04:16,011 --> 00:04:19,120
(كانازاوا توموياسو (48 بروفسور مساعدة
في كليّة الطب لجامعة توتو، قسم الجراحة

51
00:04:19,121 --> 00:04:21,770
أنا أدرس تحت جناح الدكتور منذ عشرات الأعوام

52
00:04:22,210 --> 00:04:25,385
انتقلتُ هنا قبل 3 أعوام
من بروفسور أضعف مستقبلاً

53
00:04:25,386 --> 00:04:28,745
(توبيتا غينجي (31
باحث في كليّة الطب لجامعة توتو، قسم الجراحة

54
00:04:28,746 --> 00:04:30,239
أشعر بالسرور لكوني حيث أنا الآن

55
00:04:30,240 --> 00:04:35,449
البحث الذي نشره قبل بضعة أيّام كان مذهلاً (إيزومي
كاهو (30 باحثة في كليّة الطب لجامعة توتو، قسم الجراحة

56
00:04:35,450 --> 00:04:42,049
تقصدين "المداواة الجينية كعلاج
لسرطان الأمعاء الغليظة"، صحيح؟

57
00:04:42,050 --> 00:04:45,419
كليّة الطب بأسرها تُطري على بحثه الآن

58
00:04:45,420 --> 00:04:49,630
كان أمراً يسيراً بعقلي

59
00:04:53,090 --> 00:04:54,429
شكراً على الطعام

60
00:04:54,430 --> 00:04:58,920
كلا! نسيتُ شراء أكلات خفيفة مع الساكي

61
00:05:00,630 --> 00:05:03,379
سأذهب لشراء بعضها من المتجر أسفل الجبل

62
00:05:03,380 --> 00:05:04,809
هلّا جلبتِ رقائق بطاطا؟

63
00:05:04,810 --> 00:05:05,879
! حبّار مجفف لي

64
00:05:05,880 --> 00:05:06,880
! أنا أريد سلطة

65
00:05:07,210 --> 00:05:10,589
حسناً، حسناً، اكتبوا كيلا أنسى طلباتكم

66
00:05:10,590 --> 00:05:11,590
حاضر

67
00:05:14,550 --> 00:05:18,049
! يغلق متجر البقّالة ذاك
قبل العاشرة لذا أسرعي

68
00:05:18,050 --> 00:05:19,760
أجل، أعرف

69
00:05:21,160 --> 00:05:23,669
ما الوقت الآن؟

70
00:05:23,670 --> 00:05:25,539
الثامنة وثمان وخمسون

71
00:05:25,540 --> 00:05:26,540
! كلا

72
00:05:29,710 --> 00:05:30,670
ما الخطب؟

73
00:05:30,671 --> 00:05:31,920
مسلسل تلفازي

74
00:05:32,710 --> 00:05:36,749
إنّه مدمن على ميلودراما
نسبة مشاهداتها 30% الآن

75
00:05:36,750 --> 00:05:39,169
! أشاهدها أيضاً

76
00:05:39,170 --> 00:05:41,850
ماذا؟ أين تذهب يا دكتور توبيتا؟

77
00:05:43,050 --> 00:05:44,300
تزلّج ليلي

78
00:05:45,670 --> 00:05:47,410
فلم أتزلّج بعد

79
00:05:48,920 --> 00:05:50,670
سأعود قبل الحادية عشرة

80
00:05:55,550 --> 00:05:58,209
سآخذ حماماً دافئاً باسترخاء

81
00:05:58,210 --> 00:06:01,699
حتى وصول الأكلات الخفيفة إذاً

82
00:06:01,700 --> 00:06:06,080
هل اتّصلتِ بمشرف المقصورة بشأن مفتاحنا؟

83
00:06:07,300 --> 00:06:08,999
! نسيتُ تماماً

84
00:06:09,000 --> 00:06:12,170
! لا بأس، يمكنكم المبيت هنا

85
00:06:12,880 --> 00:06:16,630
فلا تستطيعون العودة بحال أبيك

86
00:06:20,170 --> 00:06:22,139
سأرمي القمامة

87
00:06:22,140 --> 00:06:23,140
حسناً

88
00:06:28,210 --> 00:06:32,999
! انتظر يا تسوتومو-سان
! لا تذهب لأيّ مكان

89
00:06:33,000 --> 00:06:37,570
عليّ ذلك يا ميتسوي-سان،
فلا نستطيع البقاء سويّاً أبداً

90
00:06:37,920 --> 00:06:40,279
! لذا أرجوك، انسي أمري

91
00:06:40,280 --> 00:06:43,870
! لمَ؟ لمَ لا نستطيع البقاء سويّاً؟

92
00:06:47,880 --> 00:06:49,040
! رجعت

93
00:06:49,380 --> 00:06:50,549
مرحباً بعودتك يا كاوري

94
00:06:50,550 --> 00:06:54,510
لا بدّ أنّك عانيتِ مع العاصفة المفاجئة

95
00:06:55,010 --> 00:06:56,549
! دكتور توبيتا

96
00:06:56,550 --> 00:07:01,050
! يا إلهي، كيف لي أن أتزلّج بتلك العاصفة

97
00:07:05,420 --> 00:07:06,959
! يُدفئني

98
00:07:06,960 --> 00:07:08,379
أتشربون؟

99
00:07:08,380 --> 00:07:09,919
كيف كان حمّامك؟

100
00:07:09,920 --> 00:07:11,769
! رائعاً

101
00:07:11,770 --> 00:07:14,959
ماذا؟ طلبتُ سلطة

102
00:07:14,960 --> 00:07:17,240
آسفة، نفدتْ

103
00:07:18,000 --> 00:07:20,380
كما لم تكن هناك مثلجات

104
00:07:20,770 --> 00:07:23,950
من طلب مثلجات في هذا الطقس البارد؟

105
00:07:24,250 --> 00:07:28,170
ربما كان الدكتور أوياما، فهو يحبّ المثلجات

106
00:07:29,050 --> 00:07:30,549
ما الخطب يا كونان-كن؟

107
00:07:30,550 --> 00:07:34,629
، يُفترض أنّ تلك الدراما تنتهي عند العاشرة
ألا ترون أنّه تأخّر؟

108
00:07:34,630 --> 00:07:37,549
يسجلها الدكتور أوياما دوماً

109
00:07:37,550 --> 00:07:40,050
ويعيد أفضل المشاهد لاحقاً

110
00:07:45,460 --> 00:07:51,129
، تبّاً لك... كانت هذه نيّتك من البداية
قتلي في المنزل الجبلي

111
00:07:51,130 --> 00:07:54,379
! لكن لن تفلت

112
00:07:54,380 --> 00:07:58,209
! فالمتحرّي العظيم موري كوغورو هنا

113
00:07:58,210 --> 00:08:02,160
! سيلاحظ هذه الرسالة بلا شكّ

114
00:08:03,090 --> 00:08:05,120
ماذا؟ موري كوغورو؟

115
00:08:05,550 --> 00:08:07,469
الشخص المذكور دوماً في الصّحف؟

116
00:08:07,470 --> 00:08:09,580
أجل، أبي مُتحرٍّ

117
00:08:10,050 --> 00:08:12,039
تجاوزت الحادية عشرة

118
00:08:12,040 --> 00:08:15,089
أراه تأخّر كثيراً

119
00:08:15,090 --> 00:08:18,420
سأذهب لتفقّد أمره

120
00:08:20,210 --> 00:08:23,209
ماذا؟ إنّه ذاك المتحرّي الشهير؟

121
00:08:23,210 --> 00:08:25,250
المظاهر خدّاعة بالفعل

122
00:08:26,670 --> 00:08:27,670
! كاوري

123
00:08:28,630 --> 00:08:29,810
! ماذا حصل؟

124
00:08:33,050 --> 00:08:35,110
! دكتور أوياما

125
00:08:38,960 --> 00:08:40,629
فات الأوان، فارق الحياة

126
00:08:40,630 --> 00:08:42,709
! لا يمكن

127
00:08:42,710 --> 00:08:44,709
لنفك رباط جثّته بأيّ حال

128
00:08:44,710 --> 00:08:47,200
! لا تلمسوه أكثر

129
00:08:47,420 --> 00:08:52,000
لا تخرّبوا مسرح جريمة قتل

130
00:08:52,550 --> 00:08:54,549
أبي! لا يمكن للشرطة أو الإسعاف

131
00:08:54,550 --> 00:08:56,960
! القدوم هنا مع العاصفة

132
00:08:57,170 --> 00:08:59,249
هكذا إذاً، لا خيار لديّ

133
00:08:59,250 --> 00:09:04,590
يبدو أنّ على المتحرّي... العظيم موري كوغورو
! تولّي المسؤولية هنا

134
00:09:04,960 --> 00:09:06,810
لا تزال ثملاً

135
00:09:08,670 --> 00:09:10,739
سأسأل من باب الحيطة

136
00:09:10,740 --> 00:09:14,050
لم يلمس أحد شيئاً في غرفته، صحيح؟

137
00:09:14,350 --> 00:09:17,429
أجل، لا شيء غير جثّة الطبيب أوياما

138
00:09:17,430 --> 00:09:21,369
أفترض أنّ الأمر ينطبق عليك أيضاً
يا مكتشفة الجثّة، ناكاهارا-سان

139
00:09:21,370 --> 00:09:23,759
أجل، رأيته غارقاً في الدماء

140
00:09:23,760 --> 00:09:26,329
وسقطتُ عند الباب

141
00:09:26,330 --> 00:09:30,679
أكان هناك شيءٌ ذو قيمة
في هذه الغرفة؟

142
00:09:30,680 --> 00:09:33,550
يملك خزنةً في الحجرة بجوار التلفاز

143
00:09:34,600 --> 00:09:35,890
هنا؟

144
00:09:38,800 --> 00:09:40,720
إنّها مخدوشة

145
00:09:41,050 --> 00:09:43,560
أتعرفون ما داخل هذه الخزنة؟

146
00:09:44,220 --> 00:09:46,009
مالٌ على الأغلب

147
00:09:46,010 --> 00:09:49,480
فقد كان يحمل مالاً كثيراً باستمرار معه

148
00:09:50,550 --> 00:09:52,940
كانت جريمةً هدفها المال إذاً

149
00:09:53,260 --> 00:09:55,219
ما خطب أثر الدم هذا؟

150
00:09:55,220 --> 00:09:57,360
كأنّه زحف للحائط

151
00:09:57,890 --> 00:10:00,450
ولمَ يجلس برسمية؟

152
00:10:03,010 --> 00:10:05,580
الدم على الطاولة متوقف عند خطّ بوضوح

153
00:10:06,470 --> 00:10:09,220
هكذا إذاً، سقط غطاء الطاولة

154
00:10:10,850 --> 00:10:12,670
علامات من الحبال الدامية؟

155
00:10:12,930 --> 00:10:17,630
أيمكن أنّها رسالة احتضار من أوياما-سان؟

156
00:10:17,890 --> 00:10:23,430
استعمل لاصقاً على النافذة
لكتم الصوت إذاً ثم تسلل

157
00:10:25,800 --> 00:10:29,690
كان لطيفاً بما يكفي لترك
آثار أقدام خارج النافذة أيضاً

158
00:10:31,390 --> 00:10:33,260
أظنني فهمت الصورة العامة

159
00:10:34,260 --> 00:10:37,610
! بلا همهمة! اخرج

160
00:10:40,470 --> 00:10:44,139
اعذروني، لكن هلّا فحصتموه؟

161
00:10:44,140 --> 00:10:47,509
فأنتم الأطبّاء مؤهلون أكثر منّي

162
00:10:47,510 --> 00:10:48,540
حسناً

163
00:10:52,600 --> 00:10:54,179
فظيع

164
00:10:54,180 --> 00:10:57,719
حتّى ساعته الذهبية
العزيزة عليه مغطاة بالدماء

165
00:10:57,720 --> 00:11:00,680
اترك التفاهات جانباً في وقت كهذا

166
00:11:01,140 --> 00:11:05,639
وقت الوفاة المقدّر هو بين
التاسعة والنصف والعاشرة

167
00:11:05,640 --> 00:11:10,599
فهمت، أثناء مشاهدته للدراما التلفزية إذاً؟

168
00:11:10,600 --> 00:11:11,350
أجل

169
00:11:11,351 --> 00:11:14,049
توجد ندوب قطع على سائر جسده

170
00:11:14,050 --> 00:11:17,349
لكن يبدو أنّه مات اختناقاً

171
00:11:17,350 --> 00:11:19,549
بعد تعرّض كلتا رئتيه للثقب

172
00:11:19,550 --> 00:11:20,820
اختناق؟

173
00:11:21,510 --> 00:11:23,179
بوجود ثقوب في رئتيه

174
00:11:23,180 --> 00:11:27,849
لا يمكنه الاحتفاظ بالهواء
للتنفّس بشكل رئيسي

175
00:11:27,850 --> 00:11:32,999
عانى كثيراً من عشر إلى
خمس عشرة دقيقة غالباً

176
00:11:33,000 --> 00:11:33,680
! فظيع

177
00:11:33,681 --> 00:11:35,249
! من قد يُقدم على فعلة كهذه؟

178
00:11:35,250 --> 00:11:38,889
كانت جريمةً هدفها المال على الأرجح

179
00:11:38,890 --> 00:11:41,349
، بعد تسلّله عبر النافذة

180
00:11:41,350 --> 00:11:44,929
هاجم القاتل أوياما-سان الذي كان
يشاهد التلفاز وقام بتقييده

181
00:11:44,930 --> 00:11:49,429
ثمّ طلب منه توليفة الخزانة، لكنّه رفض البوح

182
00:11:49,430 --> 00:11:54,860
فطعن القاتلُ أوياما-سان غضباً
ثمّ هرب من النافذة

183
00:11:55,510 --> 00:11:57,820
لا أمل منه

184
00:11:59,040 --> 00:12:01,740
! لدى هذا الرجل ساعة مذهلة! إنّها لامعة

185
00:12:02,140 --> 00:12:03,010
! كونان-كن

186
00:12:03,011 --> 00:12:05,579
كان الرجل مقيّداً، صحيح؟

187
00:12:05,580 --> 00:12:10,540
فهو محظوظ إذاً لأنّ القاتل
لم يأخذ ساعته الذهبية

188
00:12:12,010 --> 00:12:18,049
هذا غريب، كيف يتغاضى مجرم
هدفه المال عن ساعة كهذه؟

189
00:12:18,050 --> 00:12:20,879
هذا يعني

190
00:12:20,880 --> 00:12:24,760
! أنّ القاتل غبيّ جداً

191
00:12:25,470 --> 00:12:29,220
لكن ألا تظنون أنّ القاتل جريء؟

192
00:12:31,100 --> 00:12:33,690
! انظروا لآثار الأقدام خارج النافذة

193
00:12:33,890 --> 00:12:37,270
أتى لهذه الغرفة مباشرةً

194
00:12:38,220 --> 00:12:39,680
وما في ذلك؟

195
00:12:41,780 --> 00:12:44,509
لو كنتُ مكانه، لخشيت تواجد
شخص آخر في الغرفة

196
00:12:44,510 --> 00:12:49,370
فتفقدت في الأرجاء واسترقت
النظر قبل الدخول

197
00:12:50,350 --> 00:12:52,830
أبي، أيعني هذا

198
00:12:53,180 --> 00:12:57,849
خدش الخزنة وتقييد أوياما-سان كان تضليلاً

199
00:12:57,850 --> 00:13:02,840
كي نعتقد أنّها جريمة للمال

200
00:13:03,220 --> 00:13:09,310
كان القاتل يعرف أنّ أوياما-سان سيكون
أمام التلفاز بمفرده آنذاك

201
00:13:09,760 --> 00:13:14,270
! ما يعني أنّ القاتل أحدكم الأربعة

202
00:13:14,970 --> 00:13:15,970
! مستحيل
! ماذا؟

203
00:13:16,720 --> 00:13:22,610
لنسمع حجج غيابكم من بين
التاسعة والنصف للعاشرة إذاً

204
00:13:22,970 --> 00:13:25,849
كنتُ في المتجر

205
00:13:25,850 --> 00:13:29,890
غادرتُ عند التاسعة ورجعت
عند التاسعة والخمسين

206
00:13:30,800 --> 00:13:37,579
من بين الأكلات التي طلبها مني الجميع
كانت السلطة والمثلجات وحدهما ما نفدا

207
00:13:37,580 --> 00:13:40,509
لكن كان بإمكانك الانتهاء أبكر
إذا أسرعتِ بالقيادة

208
00:13:40,510 --> 00:13:42,800
! تحتاج الرحلة الكاملة ما يفوق 40 دقيقة

209
00:13:43,350 --> 00:13:46,340
! إذا ظننتني أكذب فجرّب بسيارتي

210
00:13:46,800 --> 00:13:51,809
كنتُ خارجاً لتزلّج ليلي، وتستغرق مسافة
منحدر التزلّج 40 دقيقة أيضاً

211
00:13:51,810 --> 00:13:53,569
ألديك دليل لذلك؟

212
00:13:53,570 --> 00:13:54,930
أجل

213
00:13:55,350 --> 00:13:58,049
تذكرة المصعد تحمل تاريخ اليوم

214
00:13:58,050 --> 00:13:59,859
انظر، بها الوقت حتّى

215
00:13:59,860 --> 00:14:05,570
قمتُ بالتنظيف والغسيل
رفقة ران-تشان وكونان-كن

216
00:14:05,890 --> 00:14:07,179
إنّها الحقيقة يا أبي

217
00:14:07,180 --> 00:14:10,529
غادرت بين دقيقتين لثلاث فقط لإخراج القمامة

218
00:14:10,530 --> 00:14:14,250
كنتُ أستحم من التاسعة والنصف
حتّى بُعَيد العاشرة

219
00:14:14,470 --> 00:14:18,760
يوجد شخص آخر مع كانازاوا-سان
بحجّة غياب ضعيفة

220
00:14:22,800 --> 00:14:24,010
! بـ-بقع دماء؟

221
00:14:24,850 --> 00:14:27,970
ماذا؟ لكن لمَ لا يوجد
أيّ منها على الأريكة؟

222
00:14:28,640 --> 00:14:31,430
أوضعها أحد هنا بعد جفاف الدم؟

223
00:14:32,180 --> 00:14:36,100
لحظة، غطاء الطاولة المليء بالدماء... أيمكن؟

224
00:14:37,390 --> 00:14:40,350
مُتطابق، كانت هذه القدّاحة هنا

225
00:14:42,300 --> 00:14:44,320
أيمكن أنّ هذه

226
00:14:44,720 --> 00:14:46,969
صحيح، قال أوياما-سان ظهيرة اليوم

227
00:14:46,970 --> 00:14:51,049
أردتُ حصاناً، لكن ربما طلبتُ الكثير

228
00:14:51,050 --> 00:14:54,330
كان ذلك عندما سألني وران عن اسمينا

229
00:14:55,180 --> 00:14:58,799
! فهمت! حصان! كان هذا ما قصده

230
00:14:58,800 --> 00:15:00,880
! هذه رسالة احتضار لأوياما-سان بالفعل

231
00:15:01,600 --> 00:15:03,219
يفسّر ذلك طريقة جلوسه

232
00:15:03,220 --> 00:15:07,340
! والقدّاحة الدامية على الأريكة

233
00:15:07,680 --> 00:15:11,759
وكما تقول رسالة احتضاره

234
00:15:11,760 --> 00:15:13,440
! القاتل هو ذاك الشخص

235
00:15:23,050 --> 00:15:25,570
انظر يا عمّ، يوجد شيء غريب على الأريكة

236
00:15:26,010 --> 00:15:28,190
! يكفي أيّها الشقيّ

237
00:15:31,510 --> 00:15:32,999
ما الخطب يا أبي؟

238
00:15:33,000 --> 00:15:35,080
أظن أنّه ثمل

239
00:15:35,800 --> 00:15:38,009
! أحمق! لست ثملاً

240
00:15:38,010 --> 00:15:40,039
اكتشفتُ الأمر

241
00:15:40,040 --> 00:15:43,139
ماذا؟ ما الذي اكتشفته؟

242
00:15:43,140 --> 00:15:49,420
القاتل، اكتشفتُ هويّة القاتل
! الذي طعن أوياما-سان

243
00:15:50,970 --> 00:15:55,179
نبدأ بتوبيتا-سان الذي ذهب لتزلّج ليلي

244
00:15:55,180 --> 00:15:58,100
لن يختلق قصّة كاذبة يمكن التحقق منها بسهولة

245
00:15:58,760 --> 00:16:00,509
التالية إيزومي-سان

246
00:16:00,510 --> 00:16:03,719
تركتِ ران وكونان بين دقيقتين لثلاث فقط

247
00:16:03,720 --> 00:16:07,109
ليس وقتاً كافياً لقتل أوياما-سان

248
00:16:07,110 --> 00:16:11,569
يترك هذا كانازاوا-سان وناكاهارا-سان
الاثنين بلا حجّة غياب

249
00:16:11,570 --> 00:16:15,909
انتظر! اشتريتُ الأكلات كما طلب الجميع

250
00:16:15,910 --> 00:16:18,619
كم كلّفت إذاً؟

251
00:16:18,620 --> 00:16:21,259
! نسيت

252
00:16:21,260 --> 00:16:24,579
كلا، لم تنسي. بل لم تعرفي

253
00:16:24,580 --> 00:16:30,300
لأنّك اشتريتِ كمية كبيرة
من مختلف الأكلات سلفاً

254
00:16:30,930 --> 00:16:35,349
اشتريتِها ظهيرة اليوم
عندما ابتعتِ مكوّنات العشاء

255
00:16:35,350 --> 00:16:39,009
قبل الجريمة، أخذتِ طلبات الجميع

256
00:16:39,010 --> 00:16:42,389
وتظاهرتِ بالمغادرة في سيّارتك

257
00:16:42,390 --> 00:16:45,349
توقّفتِ في مكان بعدها

258
00:16:45,350 --> 00:16:49,509
وأخرجتِ الأكلات التي طلبوها

259
00:16:49,510 --> 00:16:54,240
أصبحت لديك حجّة غياب الآن،
فقتلتِ أوياما-سان

260
00:16:54,680 --> 00:16:57,489
لا تكن أحمق، لا دليل لديك

261
00:16:57,490 --> 00:17:00,349
كلا، أنت تعرفين أنه يوجد دليل

262
00:17:00,350 --> 00:17:05,920
في هذه الغرفة يثبت أنّك القاتلة

263
00:17:06,260 --> 00:17:08,879
انظروا للطاولة

264
00:17:08,880 --> 00:17:10,259
يتوقف أثر الدماء بوضوح

265
00:17:10,260 --> 00:17:12,420
ألا يبدو كما لو كان هناك شيء عليها؟

266
00:17:12,850 --> 00:17:14,179
! غطاء الطاولة

267
00:17:14,180 --> 00:17:18,390
ضعوه على الطاولة بحيث
يطابق بقع الدم رجاءً

268
00:17:23,300 --> 00:17:27,770
إنّها رسالة احتضار أوياما-سان

269
00:17:28,220 --> 00:17:29,770
كيف لهذه أن تكون رسالة؟

270
00:17:30,010 --> 00:17:36,219
تذكّروا، مات أوياما-سان وهو جالس برسميّة

271
00:17:36,220 --> 00:17:38,889
يُفترض أن يتّضح لكم

272
00:17:38,890 --> 00:17:44,249
فبأسمائكم رموز تُستعمل في الشوغي

273
00:17:44,250 --> 00:17:45,790
الشوغي؟

274
00:17:46,140 --> 00:17:51,219
كان الدكتور أوياما يقول دائماً
أن حصاناً سيكمل المجموعة

275
00:17:51,220 --> 00:17:55,240
أجل، تشكّلون القطع كاملةً باستثناء الفارس

276
00:17:56,600 --> 00:18:01,389
ران، خذي القدّاحة على الأريكة
وضعيها على غطاء الطاولة

277
00:18:01,390 --> 00:18:02,390
حاضر

278
00:18:04,600 --> 00:18:08,850
يوجد موضع واحد يطابق فيه الدم
على القدّاحة الأثر بغطاء الطاولة

279
00:18:09,550 --> 00:18:10,550
هنا

280
00:18:12,440 --> 00:18:14,899
كاوري
! هذا رمح

281
00:18:14,900 --> 00:18:18,469
صحيح، إنّه موضع بداية الرمح

282
00:18:18,470 --> 00:18:24,829
أي أنّها رسالة احتضار
! تكشف اسمك يا ناكاهارا كاوري-سان

283
00:18:24,830 --> 00:18:29,929
لكن كيف عرفت ذلك
قبل وضع غطاء الطاولة عليها؟

284
00:18:29,930 --> 00:18:31,540
أمعنوا النظر

285
00:18:31,850 --> 00:18:34,969
ذاك المربّع هو الوحيد بأثر دم طويل

286
00:18:34,970 --> 00:18:38,470
أي أنّه كان على حافة الطاولة

287
00:18:39,720 --> 00:18:40,720
فهمت

288
00:18:40,721 --> 00:18:43,509
! حصل هذا بمحض المصادفة

289
00:18:43,510 --> 00:18:46,730
لمَ حرّكتِه إذاً؟

290
00:18:47,690 --> 00:18:51,009
ألم تكوني من خلع غطاء الطاولة؟

291
00:18:51,010 --> 00:18:55,780
كلا! حصل ذلك عندما صارع
! الدكتور أوياما القاتل حتماً

292
00:18:56,100 --> 00:19:00,849
كلا، الدم على الطاولة متوقف بوضوح

293
00:19:00,850 --> 00:19:05,789
ولم يكن هناك أيّ دم على الأريكة
التي كانت القدّاحة عليها

294
00:19:05,790 --> 00:19:10,530
هذا دليل على تحريك أحد لها بعد جفاف الدم

295
00:19:12,880 --> 00:19:17,009
أي أنّ القاتل عاد لمسرح الجريمة

296
00:19:17,010 --> 00:19:21,280
ولاحظ الرسالة وأزاحها

297
00:19:22,470 --> 00:19:25,879
أأنا مخطئ يا ناكاهارا كاوري-سان؟

298
00:19:25,880 --> 00:19:26,929
كاوري

299
00:19:26,930 --> 00:19:34,719
كان هلاكك في ملاحظتك الرسالة بعد صراخك

300
00:19:34,720 --> 00:19:36,349
وشيء آخر

301
00:19:36,350 --> 00:19:40,349
قلتِ أنّ السلطة والمثلجات نفدت

302
00:19:40,350 --> 00:19:43,469
لكن بتجاهل السلطة، يستحيل أن تنفد المثلـ

303
00:19:43,470 --> 00:19:44,800
! يكفي

304
00:19:45,800 --> 00:19:48,119
! صحيح، قتلتُه

305
00:19:48,120 --> 00:19:51,009
لم أقدمتِ على هذا يا كاوري؟

306
00:19:51,010 --> 00:19:53,429
! كنتما على وفاق

307
00:19:53,430 --> 00:19:56,349
أجل، كان كالأب لي

308
00:19:56,350 --> 00:19:58,130
لذا لم أستطع مسامحته

309
00:19:59,010 --> 00:20:02,009
! لم أستطع تصديق سرقته بحثي

310
00:20:02,010 --> 00:20:03,849
بحثك؟ أتقصدين

311
00:20:03,850 --> 00:20:06,550
المداواة الجينية كعلاج لسرطان"
الأمعاء الغليظة" التي نشرها الدكتور؟

312
00:20:06,790 --> 00:20:09,889
! صحيح! سرقه مني

313
00:20:09,890 --> 00:20:15,200
بعدما قضيتُ 6 أعوام في كتابة
! ذاك البحث بكلّ روحي

314
00:20:16,050 --> 00:20:21,200
أجل، البحث الذي كتبته لأبي الراحل

315
00:20:22,440 --> 00:20:27,159
مات أبي في صغري من سرطان الأمعاء الغليظة

316
00:20:27,160 --> 00:20:31,549
أصبحتُ طبيبة متخصصة
في سرطان الأمعاء الغليظة

317
00:20:31,550 --> 00:20:34,369
كيلا يكون هناك المزيد من الضحايا مثل أبي

318
00:20:34,370 --> 00:20:41,129
مع ذلك، سرق ذاك الرجل
البحث مني بعدما أتممته أخيراً

319
00:20:41,130 --> 00:20:42,349
لا جدوى

320
00:20:42,350 --> 00:20:47,679
لن يصغي أحد إن قلتِ أنّها من تأليفك

321
00:20:47,680 --> 00:20:52,639
لكن سينتبه المجتمع إذا نشرها بروفسور شهير

322
00:20:52,640 --> 00:20:57,399
سيكون والدك الراحل أسعد بهذا حتماً

323
00:20:57,400 --> 00:21:01,349
فكّرتُ بهذه الخطة آنذاك

324
00:21:01,350 --> 00:21:04,599
قرّرتُ قتل الرجل الذي
داس على مشاعري تجاه أبي

325
00:21:04,600 --> 00:21:09,370
بإحدى أشدّ الطرق ألماً، الموت بثقب الرئتين

326
00:21:11,800 --> 00:21:14,849
لكن لم يخطر لي أن يترك رسالة احتضار

327
00:21:14,850 --> 00:21:18,790
في ربع ساعة المعاناة تلك

328
00:21:19,430 --> 00:21:20,639
لكن أيّها المتحرّي العظيم

329
00:21:20,640 --> 00:21:23,719
كان هناك خطأ في نظريّتك

330
00:21:23,720 --> 00:21:28,429
تكهّنتُ بالسلطة والمثلجات

331
00:21:28,430 --> 00:21:32,179
نفدت السلطة، لكنّي اشتريت المثلجات

332
00:21:32,180 --> 00:21:33,890
لمَ إذاً؟

333
00:21:34,350 --> 00:21:36,850
ذابت داخل السيّارة

334
00:21:37,760 --> 00:21:40,389
جهّزتُ أكلات الجميع

335
00:21:40,390 --> 00:21:43,299
"وأخبرتُ نفسي "حسناً، حان وقت قتله

336
00:21:43,300 --> 00:21:45,820
ثم عادت إليّ ذكريات أبي فجأةً

337
00:21:46,420 --> 00:21:49,780
وبعد شرود ذهني لبرهة،
أذابت مدفأة السيّارة المثلجات

338
00:21:52,050 --> 00:21:55,460
لم أتصوّر أن توقع بي مثلجات ذاك الرجل

339
00:21:58,100 --> 00:21:59,430
! يا للحماقة

340
00:23:32,150 --> 00:23:37,120
رسائل الاحتضار، يُعبّر عنها أحياناً
بطرق غير مألوفة

341
00:23:37,460 --> 00:23:39,649
! أطحت بملاكك

342
00:23:39,650 --> 00:23:41,580
! أهدرت قائدك الفضيّ

343
00:23:41,950 --> 00:23:45,200
! رائع! انتهيت الآن

344
00:23:46,090 --> 00:23:49,059
عندما تغيّر منظورك عن شيء عاديّ أحياناً

345
00:23:49,060 --> 00:23:51,250
انظر من الأعلى

346
00:23:53,700 --> 00:23:55,410
أحمق؟

347
00:23:56,400 --> 00:23:58,130
! أنت

348
00:24:03,990 --> 00:24:06,690
مات في المسبح؟

349
00:24:06,810 --> 00:24:07,900
مات غرقاً

350
00:24:08,150 --> 00:24:11,149
مجرد دخولك الماء سابقاً

351
00:24:11,150 --> 00:24:12,650
! لا يجعلك خبيراً

352
00:24:14,000 --> 00:24:16,360
أرسمت هذه بناءً على ما رأيته من هنا؟

353
00:24:16,710 --> 00:24:21,909
! هذه... فهمت الآن! القاتل هو ذاك الشخص

354
00:24:21,910 --> 00:24:25,410
صحيح، كانت جريمة قتل زُيّفت لتبدو حادثة

355
00:24:25,820 --> 00:24:27,279
في الحلقة القادمة كونان

356
00:24:27,280 --> 00:24:30,490
جريمة قتل نادي الرياضة

357
00:24:46,900 --> 00:24:49,469
تلميح الحلقة القادمة

358
00:24:49,470 --> 00:24:51,470
قبّعة

359
00:24:51,670 --> 00:24:53,729
تقع أحداث الحلقة القادمة
! في نادي رياضات شعبيّ

360
00:24:53,730 --> 00:24:55,509
! هيّا يا غينتا، سنركض جولةً أخرى

361
00:24:55,510 --> 00:25:00,130
لم أعد أستطيع

