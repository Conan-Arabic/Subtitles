1
00:00:01,510 --> 00:00:04,789
تتضاعف القضايا المعقّدة
مع مضيّ خط الوقت

2
00:00:04,790 --> 00:00:07,039
! رجل ضمادات مُريب للغاية

3
00:00:07,040 --> 00:00:09,169
! لن أدعه يمسّ ران

4
00:00:09,170 --> 00:00:11,259
يرى الحقيقة الواحدة

5
00:00:11,260 --> 00:00:13,639
يحمل مظهر طفل، لكنّ عقله عقل بالغ

6
00:00:13,640 --> 00:00:16,010
! اسمه المتحرّي كونان

7
00:01:46,600 --> 00:01:49,840
ذهبتُ مع ران لمنزل سوزوكي سونوكو الجبليّ

8
00:01:50,500 --> 00:01:52,549
لمشاهدة أوراق الخريف

9
00:01:52,550 --> 00:01:55,919
والتقينا هناك أخت سونوكو،
طالبة الدراسات العليا أياكو

10
00:01:55,920 --> 00:02:00,390
وصديق أياكو من أيام الدراسة
وسمسار السيّارات المستوردة أوتا ماسارو

11
00:02:00,880 --> 00:02:03,470
ومحرّر صحيفة الأفلام سوميا هيروكي

12
00:02:04,150 --> 00:02:06,690
وموظّف شركة الغذاء تاكاهاشي ريويتشي

13
00:02:07,430 --> 00:02:10,610
وكاتبة السيناريو إيكيدا تشيكاكو،
كان مجموعنا 8 أشخاص

14
00:02:10,890 --> 00:02:14,439
بدأت الحوادث بمحاولة
رجل مُريب ملفوف بالضماد

15
00:02:14,440 --> 00:02:16,930
قتل ران التائهة في الغابة

16
00:02:18,510 --> 00:02:22,700
، وفي تلك الليلة، بعدما قُطع الجسر الوحيد

17
00:02:23,010 --> 00:02:26,350
أخذ رجل الضماد إيكيدا تشيكاكو وقتلها

18
00:02:27,040 --> 00:02:31,260
ثمّ حاول قتل ران مُجدداً

19
00:02:35,970 --> 00:02:40,850
! لمَ؟ لمَ يستهدف رجل الضماد ران؟

20
00:02:46,010 --> 00:02:50,680
جريمة قتل رجل ضماد السكن الجبلي
(الجزء الثاني)

21
00:02:51,890 --> 00:02:53,359
ما-ماذا؟

22
00:02:53,360 --> 00:02:55,149
! هاجمها مُجدداً؟

23
00:02:55,150 --> 00:02:56,900
! رجل الضماد؟

24
00:02:57,180 --> 00:02:58,969
يبدو ذلك

25
00:02:58,970 --> 00:03:00,019
أأنت بخير؟

26
00:03:00,020 --> 00:03:00,970
أجل

27
00:03:00,971 --> 00:03:02,410
لكن كيف دخل؟

28
00:03:02,850 --> 00:03:04,679
ألم تقفلي النافذة؟

29
00:03:04,680 --> 00:03:05,680
بلى انظروا

30
00:03:05,820 --> 00:03:06,260
ماذا؟

31
00:03:06,261 --> 00:03:07,789
قُطِع زجاج النافذة

32
00:03:07,790 --> 00:03:08,889
هكذا إذاً

33
00:03:08,890 --> 00:03:10,750
! أدخل يده وفتح القفل

34
00:03:11,300 --> 00:03:15,429
لكنّنا في الطابق الثاني، كيف صعد هنا؟

35
00:03:15,430 --> 00:03:16,430
! أوتا! تلك

36
00:03:17,430 --> 00:03:20,180
لا بدّ أنّه استعمل الشجرة وتسلّق للشرفة

37
00:03:20,430 --> 00:03:22,279
يا للوغد

38
00:03:22,280 --> 00:03:23,220
ثمّ

39
00:03:23,221 --> 00:03:26,180
غريب، المطر يهطل بغزارة خارجاً

40
00:03:26,510 --> 00:03:28,719
، إن تسلّل من الخارج

41
00:03:28,720 --> 00:03:30,849
فيُفترض أنّ تكون هناك آثار وحل في الداخل

42
00:03:30,850 --> 00:03:32,600
لكن لا شيء منها أبداً

43
00:03:34,100 --> 00:03:35,100
لمَ؟

44
00:03:37,300 --> 00:03:39,030
بأيّ حال، من الخطر أن نتفرّق

45
00:03:39,510 --> 00:03:41,889
لنجتمع في غرفة الطعام ونبقى للصباح

46
00:03:41,890 --> 00:03:42,990
أ-أجل

47
00:03:44,350 --> 00:03:47,349
! أكره صعود الظهر! هذا سخيف

48
00:03:47,350 --> 00:03:51,179
! ما الذي تقوله؟ لويتَ كاحلك

49
00:03:51,180 --> 00:03:53,389
أياكو-سان، أليس هذا

50
00:03:53,390 --> 00:03:55,510
ما كانت تضعه تشيكاكو-سان على عنقها؟

51
00:03:56,180 --> 00:03:58,670
صحيح، إنّه شريط عنقها

52
00:03:59,010 --> 00:04:04,179
، بعدما لاحقتم جميعاً رجل الضماد

53
00:04:04,180 --> 00:04:06,640
وجدتُه عند الباب الأمامي

54
00:04:11,970 --> 00:04:14,549
! ما الذي يفكّر به رجل الضماد ذاك؟

55
00:04:14,550 --> 00:04:17,519
! هاجم ران-تشان مرّتين فوق قتل تشيكاكو؟

56
00:04:17,520 --> 00:04:20,359
ماذا لو كان يريد قتلنا جميعاً؟

57
00:04:20,360 --> 00:04:21,709
مستحيل

58
00:04:21,710 --> 00:04:22,770
لا يُعقل

59
00:04:24,640 --> 00:04:25,780
غريب

60
00:04:26,220 --> 00:04:30,370
حمل تشيكاكو-سان للغابة معه بعدها

61
00:04:30,850 --> 00:04:33,889
لذا لو سرق شريط عنقها فيُفترض أن يكون هناك

62
00:04:33,890 --> 00:04:36,330
فلمَ كان عند الباب الأمامي؟

63
00:04:36,720 --> 00:04:41,639
لمَ لم تستعملي الكاراتيه
وتبرحيه ضرباً عندما هاجمك؟

64
00:04:41,640 --> 00:04:43,219
! ليس من طباعك يا ران

65
00:04:43,220 --> 00:04:47,300
ليس بيدي حيلة،
فأنا أخاف الأشباح والوحوش وما شابه

66
00:04:49,300 --> 00:04:52,020
لا حاجة للقلق

67
00:04:52,640 --> 00:04:55,889
نحن ستّة، وهو بمفرده

68
00:04:55,890 --> 00:04:58,440
لن يكون قادراً على هزيمة

69
00:05:00,100 --> 00:05:01,150
أوتا-سان؟

70
00:05:02,060 --> 00:05:03,549
! تألمتُ أيضاً

71
00:05:03,550 --> 00:05:04,569
! كونان-كن

72
00:05:04,570 --> 00:05:05,990
! ما الذي تفعله يا صبيّ؟

73
00:05:06,350 --> 00:05:08,450
! نحن سبعة ولسنا ستّة

74
00:05:08,850 --> 00:05:11,679
! لا يدخل الأطفال الحساب

75
00:05:11,680 --> 00:05:13,680
ليس صحيحاً

76
00:05:14,680 --> 00:05:17,969
فقد حماني عندما تعرّضتُ للهجوم

77
00:05:17,970 --> 00:05:18,970
صحيح؟

78
00:05:21,430 --> 00:05:22,430
شكراً

79
00:05:24,010 --> 00:05:28,139
ران، هل نظرتِ لوجه رجل الضماد عن قرب؟

80
00:05:28,140 --> 00:05:28,850
كلا

81
00:05:28,851 --> 00:05:30,890
لكنّي أعرف بُنيته

82
00:05:31,510 --> 00:05:34,389
لم أتمكن من رؤية وجهه بوضوح
بما أنّه كان ملفوفاً بالضماد

83
00:05:34,390 --> 00:05:37,980
لكنّي أعرف بُنيته لأنّي تمسّكتُ به

84
00:05:41,800 --> 00:05:44,440
كان صدره بهذا الحجم تقريباً

85
00:05:44,720 --> 00:05:48,510
فلم يكن بديناً أو نحيلاً بالتحديد

86
00:05:49,370 --> 00:05:51,890
كأنّ بإمكاننا تصديق كلام طفل

87
00:05:56,390 --> 00:05:58,250
كاميرا تصوير سوميا-سان

88
00:05:59,880 --> 00:06:02,679
وفقما أذكر، كان رجل الضماد يصوّر عندما

89
00:06:02,680 --> 00:06:04,370
هرب ومعه تشيكاكو-سان

90
00:06:07,760 --> 00:06:08,930
! ها هو

91
00:06:09,720 --> 00:06:13,520
كما ظننت، إنّها ترتدي شريط العنق

92
00:06:13,970 --> 00:06:16,889
ما يعني أنّ جثّتها التي
كان يمسكها رجل الضماد

93
00:06:16,890 --> 00:06:19,810
عندما مرّ بالنافذة

94
00:06:20,510 --> 00:06:23,820
عبرت داخل السكن لسببٍ ما

95
00:06:24,640 --> 00:06:27,719
كان بإمكان أحدٍ داخل السكن حملها

96
00:06:27,720 --> 00:06:30,780
من البيت للغابة

97
00:06:31,220 --> 00:06:36,450
! لكن كان الجميع في هذه الغرفة عندما أُخذت

98
00:06:41,850 --> 00:06:43,549
هل أعدّ قهوة؟

99
00:06:43,550 --> 00:06:44,799
فكرة حسنة

100
00:06:44,800 --> 00:06:49,840
أخبريني، كنتِ آخر من رأى
تشيكاكو-سان، صحيح يا أياكو-سان؟

101
00:06:50,350 --> 00:06:51,100
أجل

102
00:06:51,101 --> 00:06:54,280
هل بدا عليها أمرٌ غريب وقتها؟

103
00:06:55,930 --> 00:06:58,099
بذكرك ذلك

104
00:06:58,100 --> 00:07:01,150
قرأتْ رسالةً كانت تحت باب غرفتها

105
00:07:01,970 --> 00:07:04,770
شحب لون وجهها فجأةً

106
00:07:05,430 --> 00:07:09,740
! فهمت، استدرجتها الرسالة للخارج

107
00:07:10,180 --> 00:07:12,369
لهذا السّبب كان خُفّاها عند الباب الخلفي

108
00:07:12,370 --> 00:07:15,009
حيث يمكنها التسلل دون أن يراها أحد

109
00:07:15,010 --> 00:07:20,219
والوحيد الذي كان بمقدوره وضع الرسالة هناك
هو أحد المقيمين هنا

110
00:07:20,220 --> 00:07:24,090
! أكان قاتلها بيننا حقاً؟

111
00:07:24,510 --> 00:07:27,800
لكن لمَ حاول قتل ران مرّتين؟

112
00:07:29,220 --> 00:07:32,549
لا أعرف دافع قتله لتشيكاكو-سان

113
00:07:32,550 --> 00:07:36,600
لكن لمَ هاجم ران التي شاركت في آخر لحظة؟

114
00:07:37,980 --> 00:07:40,060
لحظة! ماذا لو وقتها

115
00:07:42,720 --> 00:07:45,650
! آسفة! أخطأت

116
00:07:46,180 --> 00:07:47,759
أخبريني يا ران-نيتشان

117
00:07:47,760 --> 00:07:48,500
ماذا؟

118
00:07:48,501 --> 00:07:50,139
، عندما وصلنا هنا

119
00:07:50,140 --> 00:07:52,609
فتحتِ أبواب غرف الجميع بالخطأ، صحيح؟

120
00:07:52,610 --> 00:07:53,649
أجل

121
00:07:53,650 --> 00:07:55,179
ألم تري شيئاً وقتها؟

122
00:07:55,180 --> 00:07:56,559
ما قصدك؟

123
00:07:56,560 --> 00:07:58,429
مثل معطف أو ضماد؟

124
00:07:58,430 --> 00:08:01,079
ما الذي يقوله هذا الطفل؟ أتشكّ بنا؟

125
00:08:01,080 --> 00:08:05,509
! لا-لا تهتموا له رجاءً!
إنّه يحب لعب لعبة التحرّي

126
00:08:05,510 --> 00:08:07,699
لم تري شيئاً حقاً؟

127
00:08:07,700 --> 00:08:09,049
! بالطبع لا

128
00:08:09,050 --> 00:08:11,509
كانوا يغيّرون ملابسهم فأغلقت الباب فوراً

129
00:08:11,510 --> 00:08:15,849
إن أعدتُ التفكير، هناك ما حيّر بالي

130
00:08:15,850 --> 00:08:18,470
مُذ ذاك الوقت

131
00:08:19,300 --> 00:08:22,140
لا أظنّه مُهماً جدّاً

132
00:08:22,510 --> 00:08:24,229
لكن لا أستطيع تذكره

133
00:08:24,230 --> 00:08:25,980
! تذكّري يا ران-نيتشان

134
00:08:28,850 --> 00:08:29,850
! انقطعت الكهرباء

135
00:08:29,851 --> 00:08:32,190
! أسقطت الصاعقة للتوّ برج طاقة

136
00:08:32,510 --> 00:08:34,099
! أشعر بالخوف

137
00:08:34,100 --> 00:08:36,160
سأجلب أعواد شمع من المطبخ

138
00:08:36,720 --> 00:08:38,719
أستكونين بخيرٍ بمفردك؟

139
00:08:38,720 --> 00:08:39,939
! سأرافقك

140
00:08:39,940 --> 00:08:40,940
! وأنا

141
00:08:43,600 --> 00:08:45,720
يُفترض أن تحلّ المشكلة لبرهة

142
00:08:49,260 --> 00:08:50,759
ما كان ذلك الصوت؟

143
00:08:50,760 --> 00:08:52,719
أتى من غرفة الطعام حيث الجميع

144
00:08:52,720 --> 00:08:55,260
! أيمكن أنّه رجل الضماد مُجدداً؟

145
00:09:03,140 --> 00:09:04,349
! أأنت بخيرٍ يا كونان-كن؟

146
00:09:04,350 --> 00:09:06,009
! كان ذلك قاسياً يا ران-نيتشان

147
00:09:06,010 --> 00:09:07,010
آسفة

148
00:09:07,011 --> 00:09:08,180
ذاك

149
00:09:10,640 --> 00:09:12,689
لحظة، أليس فأساً؟

150
00:09:12,690 --> 00:09:14,650
الشخص الذي كان هنا إذاً

151
00:09:15,140 --> 00:09:17,740
! رجل الضماد يلاحق ران فعلاً

152
00:09:19,010 --> 00:09:20,720
! لكن لمَ هي؟

153
00:09:23,510 --> 00:09:25,119
! كان ذلك صوت سونوكو

154
00:09:25,120 --> 00:09:26,960
! ران-نيتشان! لنسرع

155
00:09:27,200 --> 00:09:28,200
! بسرعة! بسرعة

156
00:09:30,470 --> 00:09:32,709
! النافذة العلوية مكسورة

157
00:09:32,710 --> 00:09:35,009
! ران-نيتشان، اذهبي للنافذة

158
00:09:35,010 --> 00:09:37,550
أياكو-سان، هلّا حملتِ هذه؟

159
00:09:39,720 --> 00:09:41,549
يا للفوضى

160
00:09:41,550 --> 00:09:44,099
الأرض مليئة بكسور الزجاج

161
00:09:44,100 --> 00:09:48,480
لا بدّ أنّ رجل الضماد دخل من هذه النافذة

162
00:09:48,940 --> 00:09:50,230
كلا

163
00:09:50,760 --> 00:09:53,190
أحد القفلين مفتوح

164
00:09:53,700 --> 00:09:54,700
لو

165
00:09:55,360 --> 00:10:00,960
لو حطّم زجاج النافذة من الخارج حقاً... ودخل

166
00:10:02,490 --> 00:10:04,910
فيُفترض أن تبقى الأقفال

167
00:10:05,390 --> 00:10:07,369
لكنّها ليست كذلك

168
00:10:07,370 --> 00:10:10,469
ما يعني أنّه فتحها من الداخل غالباً

169
00:10:10,470 --> 00:10:12,590
وخرج للشرفة وأغلق النافذة

170
00:10:12,800 --> 00:10:17,050
! ثمّ حطّم الزجاج
ليخدعنا أنّه دخل من الخارج

171
00:10:18,930 --> 00:10:21,099
تسلّل من الطابق الثاني مُجدداً؟

172
00:10:21,100 --> 00:10:25,179
أجل، أتى للشرفة عبر تلك
الشجرة مُجدداً على الأرجح

173
00:10:25,180 --> 00:10:26,759
لا شكّ

174
00:10:26,760 --> 00:10:28,429
المجرم المجنون الذي قتل تشيكاكو-سان

175
00:10:28,430 --> 00:10:31,150
! وهاجم ران ثلاث مرّات موجودٌ بيننا

176
00:10:35,350 --> 00:10:36,670
ما هذه الخطوط؟

177
00:10:38,350 --> 00:10:40,929
! هكذا إذاً! فهمت

178
00:10:40,930 --> 00:10:43,160
! كانت حيلة

179
00:10:45,850 --> 00:10:47,250
شكراً لك يا ران-نيتشان

180
00:10:48,140 --> 00:10:51,560
لكن لمَ رجل الضماد مصرٌّ على قتل ران؟

181
00:10:52,720 --> 00:10:55,150
ما الذي رأته بالضبط؟

182
00:10:56,420 --> 00:10:57,889
! بالطبع لا

183
00:10:57,890 --> 00:11:00,260
كانوا يغيّرون ملابسهم فأغلقت الباب فوراً

184
00:11:01,390 --> 00:11:03,010
ماذا لو كان

185
00:11:03,800 --> 00:11:07,599
! رجل الضماد... هو إذاً

186
00:11:07,600 --> 00:11:08,979
عندها، الألغاز الثلاثة

187
00:11:08,980 --> 00:11:11,969
سبب مرور رجل الضماد بالنافذة مع تشيكاكو-سان

188
00:11:11,970 --> 00:11:13,900
كي نراه جميعاً

189
00:11:14,720 --> 00:11:17,740
وحمله الجثّة للغابة دون أن يلاحظه أحد

190
00:11:18,180 --> 00:11:19,950
وسبب مهاجمته لران

191
00:11:20,470 --> 00:11:22,299
! توضّحت الصُّورة

192
00:11:22,300 --> 00:11:23,300
! حسنٌ

193
00:11:23,510 --> 00:11:25,330
! لا لديّ سوى ران لتؤدي دور المتحرّي

194
00:11:26,260 --> 00:11:28,620
المعذرة،
أين أعواد الشمع التي أعطيتك يا أياكو-سان؟

195
00:11:31,800 --> 00:11:32,960
! أخطأت التصويب

196
00:11:37,680 --> 00:11:39,509
سونوكو؟

197
00:11:39,510 --> 00:11:40,929
! ما الخطب يا سونوكو؟

198
00:11:40,930 --> 00:11:44,849
! تبّاً! لا أمامي سوى استعمال سونوكو الآن

199
00:11:44,850 --> 00:11:46,299
! سونوكو

200
00:11:46,300 --> 00:11:49,770
لـ-لقد اكتشفت

201
00:11:50,180 --> 00:11:53,350
! هويّة المجرم الذي قتل تشيكاكو-سان

202
00:12:00,640 --> 00:12:03,009
لقد اكتشفت

203
00:12:03,010 --> 00:12:05,869
! هويّة المجرم الذي قتل تشيكاكو-سان

204
00:12:05,870 --> 00:12:08,969
ما الذي تقولينه يا سونوكو-تشان؟

205
00:12:08,970 --> 00:12:12,099
المجرم رجل الضماد بالطبع

206
00:12:12,100 --> 00:12:14,639
صحيح، إنّه في الغابة الآن غالباً

207
00:12:14,640 --> 00:12:16,849
يخطّط للنيل منّا

208
00:12:16,850 --> 00:12:20,100
أتظنّون أنّ شخصاً مثله في الغابة حقاً؟

209
00:12:21,100 --> 00:12:27,139
أعيدوا التفكير بحالة غرفة
ران عندما تعرّضت للهجوم

210
00:12:27,140 --> 00:12:30,730
دخل من الشرفة، صحيح؟

211
00:12:30,890 --> 00:12:35,190
أجل، صعد لشرفة الطابق الثاني عبر الشجرة

212
00:12:35,510 --> 00:12:39,150
لمَ لم تكن هناك آثار وحل في غرفة ران؟

213
00:12:39,530 --> 00:12:43,639
كان المطر يهطل عندما تسلّل رجل الضماد

214
00:12:43,640 --> 00:12:45,679
! صـ-صحيح

215
00:12:45,680 --> 00:12:47,120
السبب بسيط

216
00:12:47,510 --> 00:12:51,079
لأنّ رجل الضماد كان داخل السكن

217
00:12:51,080 --> 00:12:56,299
نقطة الدخول كانت غرفة تشيكاكو-سان
بجوار غرفة ران على الأرجح

218
00:12:56,300 --> 00:13:00,219
خرج القاتل للشرفة منها
ودخل غرفة ران ثمّ هاجمها

219
00:13:00,220 --> 00:13:03,010
لكنّ ران صرخت

220
00:13:05,640 --> 00:13:09,009
فهرب بعجلة لغرفة تشيكاكو-سان

221
00:13:09,010 --> 00:13:12,770
وغيّر ثيابه هناك بمنتهى السرعة

222
00:13:13,510 --> 00:13:18,429
والتمّ بالجميع في غرفة
ران بقناع الجهل على وجهه

223
00:13:18,430 --> 00:13:23,150
أي أنّ القاتل المجنون الذي
قتل تشيكاكو-سان وهاجم ران

224
00:13:23,510 --> 00:13:25,330
! هو بيننا

225
00:13:26,640 --> 00:13:29,549
سونوكو-تشان، لا بأس من لعب لعبة المتحرّي

226
00:13:29,550 --> 00:13:31,349
لكن أمعني التفكير

227
00:13:31,350 --> 00:13:34,040
، عندما مرّ رجل الضماد بالنافذة

228
00:13:34,510 --> 00:13:37,680
كنّا جميعاً داخل السكن

229
00:13:39,550 --> 00:13:43,259
يستحيل أن يكون أحدنا

230
00:13:43,260 --> 00:13:47,099
، لكن لو استعمل دميةً وأسلاك بيانو

231
00:13:47,100 --> 00:13:50,220
يمكنه خداع أنظارنا من الداخل

232
00:13:50,470 --> 00:13:51,679
د-دمية؟

233
00:13:51,680 --> 00:13:56,100
أجل، دمية قابلة للنفخ على الأرجح

234
00:13:56,510 --> 00:14:00,009
، ثبّت جثّة تشيكاكو-سان بالدمية

235
00:14:00,010 --> 00:14:03,610
وربط سلكي بيانو برأس الدمية

236
00:14:03,970 --> 00:14:08,679
مرّر أحد السلكين بحاجز الشرفة الوسطى

237
00:14:08,680 --> 00:14:14,009
وربط طرفَي السلكين بالحاجز فوق النافذة

238
00:14:14,010 --> 00:14:17,390
ثمّ قطع السلك الذي كان مربوطاً بالحاجز

239
00:14:21,050 --> 00:14:23,799
، وبعدما لوّح بهما أمام النافذة

240
00:14:23,800 --> 00:14:27,760
استرجع الدمية وتشيكاكو-سان سريعاً

241
00:14:28,140 --> 00:14:29,350
! تشيكاكو

242
00:14:30,350 --> 00:14:33,009
الوحيد القادر على ذلك

243
00:14:33,010 --> 00:14:35,980
كان الشخص على الشرفة الذي يصلح السقف وقتها

244
00:14:36,350 --> 00:14:38,890
! تاكاهاشي-سان! لا أحد غيرك

245
00:14:41,100 --> 00:14:42,939
أنتِ تمزحين يا سونوكو-تشان

246
00:14:42,940 --> 00:14:47,860
آثار سلكَي البيانو
الواضحة على حاجز الشرفة

247
00:14:48,260 --> 00:14:49,820
! هي الدليل

248
00:14:50,100 --> 00:14:52,509
وحده مدير مسرح نادي إنتاج الأفلام

249
00:14:52,510 --> 00:14:56,970
بإمكانه تجهيز شيء بهذه التفاصيل

250
00:14:58,050 --> 00:15:00,389
عـ-على مهلك

251
00:15:00,390 --> 00:15:03,790
ماذا فعلتُ بالجثّة بعدما سحبتها إذاً؟

252
00:15:05,300 --> 00:15:09,180
بعد ذلك مباشرة، لحقنا به جميعاً إلى الغابة

253
00:15:09,510 --> 00:15:12,220
حيث وجدنا أجزاء جثّة تشيكاكو

254
00:15:13,930 --> 00:15:17,279
لم تروني أحمل جثّة وقتها، صحيح؟

255
00:15:17,280 --> 00:15:18,010
أجل

256
00:15:18,011 --> 00:15:20,480
هناك دليل لحملك لها

257
00:15:21,900 --> 00:15:25,320
فقد وجدت أختي شريط
عنق تشيكاكو-سان عند المدخل

258
00:15:25,890 --> 00:15:29,280
كانت ترتدي الشريط عندما اُختُطِفت

259
00:15:29,550 --> 00:15:33,199
وجوده عند المدخل بعد مغادرة الجميع

260
00:15:33,200 --> 00:15:38,160
دليلٌ على أنّ أحدهم عبر
الباب وهو يحمل جثّتها

261
00:15:38,550 --> 00:15:42,389
! أخبرتك، لم أكن أحمل شيئاً

262
00:15:42,390 --> 00:15:46,879
كما،
كيف يمكن لأحد حمل جثّة دون أن يلاحظه أحد؟

263
00:15:46,880 --> 00:15:48,799
بافتراض أنّها جثّة كاملة

264
00:15:48,800 --> 00:15:51,180
لكن لو كان الرأس فقط

265
00:15:51,890 --> 00:15:53,799
! فيمكن حمله

266
00:15:53,800 --> 00:15:55,139
! ماذا؟

267
00:15:55,140 --> 00:15:58,849
فما رأيناه من النافذة

268
00:15:58,850 --> 00:16:01,639
! كان رأسها والمعطف يغطيها

269
00:16:01,640 --> 00:16:05,690
كانت جثّتها متراميةً عندما وجدناها

270
00:16:06,720 --> 00:16:07,720
! سخافة

271
00:16:07,850 --> 00:16:12,509
! لمَ قد أقتل تشيكاكو؟! كما أهاجم ران-تشان؟

272
00:16:12,510 --> 00:16:16,330
أ-أيضاً... أيضاً

273
00:16:16,720 --> 00:16:17,910
أيضاً؟

274
00:16:19,760 --> 00:16:21,290
لمَ لا تقولها؟

275
00:16:22,470 --> 00:16:24,710
أليس هناك دليل؟

276
00:16:24,890 --> 00:16:29,670
تمتلك ورجل الضماد بُنيتين مختلفتين تماماً

277
00:16:31,800 --> 00:16:33,219
! صحيح يا تاكاهاشي-كن

278
00:16:33,220 --> 00:16:35,549
! رجل الضماد ليس بديناً

279
00:16:35,550 --> 00:16:37,970
تاكاهاشي، لمَ لم تقل ذلك؟

280
00:16:38,300 --> 00:16:43,349
كان يخشى ما سأسأله ردّاً على كلامه

281
00:16:43,350 --> 00:16:46,860
"أأنت بدينٌ حقاً؟"

282
00:16:49,010 --> 00:16:51,780
صحيح، ليس بديناً البتّة

283
00:16:52,220 --> 00:16:55,739
لذا كان بإمكانه وضع
الرأس داخل قميصه وحمله

284
00:16:55,740 --> 00:16:59,990
استدرج تشيكاكو-سان
للغابة أوّلاً وقطّع جسدها

285
00:17:00,390 --> 00:17:03,969
واستبدل البطانة تحت قميصه برأسها

286
00:17:03,970 --> 00:17:06,009
وأخذها للسكن

287
00:17:06,010 --> 00:17:09,509
بعدها، بعد تنفيذ حيلة الشرفة

288
00:17:09,510 --> 00:17:12,969
أعاد الدمية مفرغة الهواء والرأس تحت قميصه

289
00:17:12,970 --> 00:17:15,679
وتوجّه للغابة مع الجميع

290
00:17:15,680 --> 00:17:17,889
ثمّ رمى رأسها في الغابة

291
00:17:17,890 --> 00:17:20,010
مُتظاهراً بالبحث عنها

292
00:17:20,510 --> 00:17:24,799
أي أنّه زيّف بُنيته ليخدع الجميع

293
00:17:24,800 --> 00:17:31,360
! وينقل الجثّة بحريّة في
حيلة بمُنتهى الجرأة والمكر

294
00:17:33,180 --> 00:17:36,719
باستعمال هذه الحيلة، تمكن من جعلنا نعتقد

295
00:17:36,720 --> 00:17:40,890
أنّ رجل الضماد أخذ
تشيكاكو-سان للغابة وقتلها

296
00:17:41,870 --> 00:17:46,289
! وأنّه المسؤول عن كلّ ما حصل

297
00:17:46,290 --> 00:17:49,749
لكن خطّته المُتقنة ظاهرياً

298
00:17:49,750 --> 00:17:53,100
تفكّكت عندما فعلَتْ ران شيئاً

299
00:17:54,010 --> 00:17:57,799
أجل، عندما فتحت باب غرفته عن طريق الخطأ

300
00:17:57,800 --> 00:17:59,470
رأت

301
00:18:02,300 --> 00:18:05,060
! بُنيته الحقيقية

302
00:18:05,430 --> 00:18:09,020
لم تهتم ران بالأمر وقتها

303
00:18:09,390 --> 00:18:13,509
لكن إذا تذكّرَتْ، فخطّة قتله المدروسة

304
00:18:13,510 --> 00:18:15,939
! ستتبخّر

305
00:18:15,940 --> 00:18:19,209
لذا هاجمها في الغابة

306
00:18:19,210 --> 00:18:21,869
! لإسكاتها

307
00:18:21,870 --> 00:18:24,330
لكنّه فشل

308
00:18:24,720 --> 00:18:28,179
وفي قلقه من أن تغادر تشيكاكو-سان
التي كانت هدفه الرئيسي

309
00:18:28,180 --> 00:18:30,290
، أثناء كلّ هذه الفوضى

310
00:18:30,930 --> 00:18:34,460
قطع خطّ الهاتف وأسقط الجسر

311
00:18:34,720 --> 00:18:37,550
واحتجز الجميع في السكن

312
00:18:39,600 --> 00:18:42,299
استدرج تشيكاكو-سان للغابة كما خطّط

313
00:18:42,300 --> 00:18:44,390
وقتلها

314
00:18:44,600 --> 00:18:46,509
استدرجها برسالة

315
00:18:46,510 --> 00:18:50,020
وضعها تحت بابها على الأرجح

316
00:18:51,010 --> 00:18:55,679
كان موضوعها غالباً أتسوكو-سان
زميلة أختي في النادي

317
00:18:55,680 --> 00:18:58,449
التي انتحرت قبل عامين

318
00:18:58,450 --> 00:19:01,509
! صحيح! فعلتُ كلّ هذا لأجل أتسوكو

319
00:19:01,510 --> 00:19:02,910
تـ-تاكاهاشي

320
00:19:04,350 --> 00:19:09,139
أطلعتني سرّاً على قصّةٍ كتبتها

321
00:19:09,140 --> 00:19:12,830
ولمعت عيناها بينما تكلمت
عن حلمها في أن تصبح روائية

322
00:19:13,890 --> 00:19:16,679
لكن، شنقت نفسها فجأةً في غرفة اجتماعنا

323
00:19:16,680 --> 00:19:20,469
"عندما رأيتُ فيلم تشيكاكو الأخير،
"المملكة الزرقاء

324
00:19:20,470 --> 00:19:23,260
! أدركتُ السبب بوضوح

325
00:19:23,890 --> 00:19:25,649
المملكة الزرقاء؟

326
00:19:25,650 --> 00:19:27,219
أ-أيمكن

327
00:19:27,220 --> 00:19:30,259
أجل، قصّة عمل تشيكاكو الرسميّ الأوّل

328
00:19:30,260 --> 00:19:36,150
! كانت مُطابقة لـ"البلد
الأزرق" الذي أرتني إيّاه أتسوكو

329
00:19:36,640 --> 00:19:37,959
أتقصد أنّ تشيكاكو

330
00:19:37,960 --> 00:19:39,099
سرقته؟

331
00:19:39,100 --> 00:19:41,990
أجل، فازت تشيكاكو بجائزة
كاتب السيناريو الواعد بفضله

332
00:19:42,510 --> 00:19:46,330
بينما كانت لا تزال تدرس، وأصبحت شهيرةً الآن

333
00:19:48,050 --> 00:19:50,509
لكن كيف تجزم بأنّه سبب انتحار أتسوكو؟

334
00:19:50,510 --> 00:19:53,849
يوم فوز تشيكاكو بالجائزة،
أي اليوم السابق لموت أتسوكو

335
00:19:53,850 --> 00:19:55,920
أخبرتني أتسوكو على الهاتف

336
00:19:56,350 --> 00:19:59,879
! أنّها لم تعد تستطيع الثقة بأحد

337
00:19:59,880 --> 00:20:04,389
لذا استدرجتُ تشيكاكو للغابة برسالة
"تهديد لفضح سرقة "البلد الأزرق

338
00:20:04,390 --> 00:20:07,720
! وقطعتُ رأسها

339
00:20:08,140 --> 00:20:10,680
! هذا ما تستحقه لقطع حُلم أتسوكو

340
00:20:14,050 --> 00:20:15,609
انتهى

341
00:20:15,610 --> 00:20:17,100
كلّ شيءٍ الآن

342
00:20:18,010 --> 00:20:19,689
حان وقت ذهابي لأتسوكو

343
00:20:19,690 --> 00:20:21,280
! ا-انتظر يا تاكاهشي

344
00:20:21,570 --> 00:20:22,570
! ابتعدوا
! تاكاهاشي-كن

345
00:20:23,510 --> 00:20:26,349
سأذهب للعيش معها في العالم الآخر

346
00:20:26,350 --> 00:20:28,469
! بصفتي رسول العدالة الذي أخذ بثأرها

347
00:20:28,470 --> 00:20:29,970
! يكفي هراءً

348
00:20:30,580 --> 00:20:33,890
! إذا أردت الموت فلتمت يا وغد

349
00:20:34,550 --> 00:20:36,539
سـ-سونوكو

350
00:20:36,540 --> 00:20:41,510
ربما أقدمت على خطيئة لأجل أتسوكو-سان

351
00:20:41,850 --> 00:20:44,679
، لكن عندما هاجمت ران

352
00:20:44,680 --> 00:20:46,469
لم يكن لأجلها أبداً

353
00:20:46,470 --> 00:20:48,009
كنت خائفاً

354
00:20:48,010 --> 00:20:51,799
! خائفاً من أن تُضبط كمجرم فهاجمتها

355
00:20:51,800 --> 00:20:53,440
أنتَ لست

356
00:20:55,180 --> 00:20:57,389
رسول عدالة

357
00:20:57,390 --> 00:21:00,360
! مجرّد قاتل بشع متعطّش للدماء

358
00:21:14,390 --> 00:21:18,349
قادت خيانة صديق لموت آخر

359
00:21:18,350 --> 00:21:21,510
مما أدّى لسواد قلب صديقٍ

360
00:21:22,390 --> 00:21:27,230
انقشع ظلام المأساة البارد عن السكن أخيراً

361
00:21:27,970 --> 00:21:29,849
لكن احذروا

362
00:21:29,850 --> 00:21:32,469
افتحوا له طريقاً وسيعاود الظهور

363
00:21:32,470 --> 00:21:35,599
داخل قلب إنسان

364
00:21:35,600 --> 00:21:39,010
القاتل المجنون المعروف بالانتقام

365
00:23:11,300 --> 00:23:14,530
أنا مسرورة لكون أختك في حالٍ أفضل الآن

366
00:23:14,930 --> 00:23:16,549
أنا أيضاً

367
00:23:16,550 --> 00:23:19,960
فقد لازمت الفراش لأسبوع بعد الحادثة

368
00:23:20,350 --> 00:23:23,679
لكن حُلّت القضية

369
00:23:23,680 --> 00:23:26,420
! بفضل استنتاجاتك البارعة

370
00:23:26,760 --> 00:23:27,760
ماذا؟

371
00:23:27,970 --> 00:23:29,010
! كـ-كلا

372
00:23:29,550 --> 00:23:33,009
! بدوتِ متحرّيةً رائعة

373
00:23:33,010 --> 00:23:34,509
! عليّ تغيير الموضوع

374
00:23:34,510 --> 00:23:35,679
بالمناسبة

375
00:23:35,680 --> 00:23:40,100
أجل، فقضايا كتلك كشرب الماء بالنسبة لي

376
00:23:40,550 --> 00:23:44,060
زمن شينتشي-كن ووالدك قد ولّى

377
00:23:45,020 --> 00:23:48,990
! إنّه عصر المتحرية
العظيمة سوزوكي سونوكو الآن

378
00:23:52,470 --> 00:23:56,850
جعلها متحرية كان غلطةً كبيرة بالفعل

379
00:24:02,620 --> 00:24:05,590
تملك الطبيبة يوكو دافعاً لقتل ناكاموتو-سان

380
00:24:06,100 --> 00:24:09,419
لكن لديها حجّة غياب قويّة

381
00:24:09,420 --> 00:24:11,880
إذا كانت القاتلة

382
00:24:12,220 --> 00:24:14,840
لا يوجد مشغّل فيديو هنا

383
00:24:15,640 --> 00:24:18,470
! هكذا إذاً! فهمت

384
00:24:19,510 --> 00:24:24,890
كانت هذه حيلة حجّة غياب
! باستعمال أيومي-تشان

385
00:24:26,350 --> 00:24:27,849
في الحلقة القادمة من كونان

