1
00:00:01,540 --> 00:00:04,720
تتضاعف القضايا المعقّدة
مع مضيّ خط الوقت

2
00:00:04,920 --> 00:00:06,440
! قضيّة اليوم بحثٌ عن كنز

3
00:00:06,650 --> 00:00:08,400
هل سنجد كنز القلب؟

4
00:00:08,600 --> 00:00:12,060
يرى الحقيقة الواحدة، يحمل
مظهر طفل، لكنّ عقله عقل بالغ

5
00:00:12,260 --> 00:00:14,360
! اسمه المتحرّي كونان

6
00:01:46,000 --> 00:01:49,900
قضيّة نجاة فرقة فتيان التحرّي

7
00:02:02,930 --> 00:02:04,970
! كانت هنا

8
00:02:14,970 --> 00:02:17,540
أخبرنا يا بروفسور، أهذه الخريطة حقيقية؟

9
00:02:17,740 --> 00:02:19,240
! أجل، حقيقية

10
00:02:19,480 --> 00:02:22,490
يوجد كنزٌ بالفعل إذاً؟

11
00:02:22,690 --> 00:02:25,450
انتظروا وستكتشفون

12
00:02:27,310 --> 00:02:30,320
! سأجد الكنز حتماً

13
00:02:30,520 --> 00:02:31,539
! أنا أيضاً

14
00:02:31,540 --> 00:02:32,710
! وأنا

15
00:02:33,340 --> 00:02:34,720
، بالمناسبة يا بروفسور

16
00:02:34,920 --> 00:02:37,680
من أين حصلت على تلك الخريطة المريبة؟

17
00:02:39,000 --> 00:02:40,630
تريد أن تعرف؟

18
00:02:41,670 --> 00:02:43,389
ستكذب بأيّ حال

19
00:02:43,390 --> 00:02:46,720
ستكتشف عندما تصل للنهاية

20
00:02:48,150 --> 00:02:49,560
النهاية؟

21
00:03:05,320 --> 00:03:08,210
أنا أكبر من أن أذهب في رحلات بحث عن كنز

22
00:03:08,410 --> 00:03:11,289
نحن هنا، عند شجرة الجمجمة

23
00:03:11,290 --> 00:03:14,750
علينا شقّ طريقنا لجسر لندن أوّلاً
! أجل

24
00:03:14,920 --> 00:03:18,150
حسناً، سأقوم بالصيد هنا

25
00:03:18,350 --> 00:03:20,220
لذا استمتعوا أنتم

26
00:03:20,420 --> 00:03:22,070
! أجل

27
00:03:22,270 --> 00:03:24,510
يا إلهي، لستُ طفلاً

28
00:03:24,710 --> 00:03:26,720
ربما أنا الآن

29
00:03:30,090 --> 00:03:32,990
أخبرني يا كونان-كن؟ ما الكنز برأيك؟

30
00:03:33,190 --> 00:03:35,610
لم نجزم بأنّه كنز بعد

31
00:03:35,810 --> 00:03:40,690
بلى! يوجد كنز بلا شكّ، صحيح يا ميتسوهيكو؟

32
00:03:40,890 --> 00:03:43,330
! أجل، ألماس أو جواهر

33
00:03:43,810 --> 00:03:46,520
! أو ربما ذهب مدفون حتّى

34
00:03:47,090 --> 00:03:48,780
! مُذهل! سيكون ذلك رائعاً

35
00:03:48,200 --> 00:03:48,990
! نعم

36
00:03:48,991 --> 00:03:50,539
مستحيل

37
00:03:50,540 --> 00:03:51,540
شجرة الجمجمة

38
00:03:52,250 --> 00:03:54,330
جسر لندن

39
00:04:05,240 --> 00:04:09,910
كنت قلقاً من أن نسقط بما أنّ اسمه جسر لندن

40
00:04:10,780 --> 00:04:14,200
تسقط هذه الجسور في الأفلام دوماً

41
00:04:27,880 --> 00:04:28,949
! مـ-محال

42
00:04:28,950 --> 00:04:30,700
! ليس طريفاً

43
00:04:31,070 --> 00:04:35,230
بمَ كان يفكّر البروفسور عندما أرسلنا
لمكان خطر كهذا؟

44
00:04:35,430 --> 00:04:37,079
! كيف سنرجع الآن؟

45
00:04:37,080 --> 00:04:39,590
جسر لندن

46
00:04:40,420 --> 00:04:42,800
يد الشيطان
ادخل من البوّابة الضيّقة

47
00:04:43,480 --> 00:04:47,680
يبدو أنّ بوصلتي لا تعمل هنا

48
00:04:47,850 --> 00:04:51,760
لمَ خبّأ الكنز في الجبال هنا؟

49
00:04:51,960 --> 00:04:54,640
كان مهووس غموض

50
00:04:55,060 --> 00:04:57,100
لكنّ هذا تمادٍ

51
00:04:57,620 --> 00:05:01,620
سحقاً، وفق الخريطة يجب أن تكون
! هناك 5 أشجار أرز، لكن توجد 4 فحسب

52
00:05:01,820 --> 00:05:03,570
! أهذا المكان حقاً؟

53
00:05:03,890 --> 00:05:05,680
كان تعيس الحظّ

54
00:05:05,880 --> 00:05:09,660
مات في حادث بعدما دفن الكنز فوراً

55
00:05:12,010 --> 00:05:16,190
! أنت! الكنز على المحكّ هنا
! أجب عندما أسألك

56
00:05:16,390 --> 00:05:18,500
! هذا خطر يا سيّد

57
00:05:19,110 --> 00:05:21,340
عليك إطفاء السجائر

58
00:05:21,890 --> 00:05:24,050
فقد تسبب حرائق غابات

59
00:05:24,250 --> 00:05:25,930
مـ-من أنتم؟

60
00:05:26,130 --> 00:05:28,590
نحن فرقة فتيان التحرّي

61
00:05:31,760 --> 00:05:34,770
ماذا؟ تشبه هذه الخريطة خريطتنا

62
00:05:34,970 --> 00:05:37,520
! أنت! ما الذي تنظر له؟

63
00:05:38,010 --> 00:05:39,350
! لا-لا شيء

64
00:05:39,550 --> 00:05:40,310
لنذهب

65
00:05:40,311 --> 00:05:42,650
نذهب أين؟

66
00:05:42,850 --> 00:05:44,110
! تعال وحسب

67
00:05:48,140 --> 00:05:51,090
لا يبدو أنّهما ينويان التنّزه في الجبال

68
00:05:51,290 --> 00:05:54,380
لديهما مجرف كما يرتديان بذلاً

69
00:05:54,580 --> 00:05:56,620
وما كانت تلك الخريطة بالضبط؟

70
00:05:58,310 --> 00:06:01,920
نحن هنا الآن، صحيح؟

71
00:06:02,120 --> 00:06:04,880
ماذا؟ أجل، أظنّ ذلك

72
00:06:05,080 --> 00:06:07,200
لكن البوصلة لا تعمل

73
00:06:08,020 --> 00:06:11,300
، كونان، توجد 4 أشجار أزر فحسب هنا
أهذا هو المكان حقاً؟

74
00:06:11,500 --> 00:06:12,610
أجل

75
00:06:13,000 --> 00:06:14,800
ابتعدوا قليلاً

76
00:06:15,990 --> 00:06:18,560
انظروا، ها هي شجرة الأرز الخامسة

77
00:06:19,020 --> 00:06:22,150
قُطعت فيصعب ملاحظتها

78
00:06:22,350 --> 00:06:24,490
ترون كيف أنّ الحلقات السنوية أوسع هنا؟

79
00:06:24,690 --> 00:06:29,040
تعرّض هذا الجانب لضوء شمس أكثر
فنما أكثر من الآخر

80
00:06:30,150 --> 00:06:31,860
الجنوب من هناك إذاً؟

81
00:06:32,060 --> 00:06:33,230
تماماً

82
00:06:33,430 --> 00:06:35,770
أيّ طريق نسلك إذاً؟

83
00:06:35,970 --> 00:06:37,499
دعني أرى الخريطة

84
00:06:37,500 --> 00:06:41,170
يد الشّيطان
"يد الشيطان، ادخل من البوّابة الضيّقة

85
00:06:41,370 --> 00:06:45,350
يد الشيطان هي يدك اليسرى فيقلّص
هذا الاحتمالات للاثنين على اليسار

86
00:06:45,550 --> 00:06:47,450
"ومكتوب هنا "ادخل من البوّابة الضيّقة

87
00:06:47,650 --> 00:06:50,150
مما يعني أن علينا أخذ أضيق طريق أقصى اليسار

88
00:06:50,350 --> 00:06:53,100
! يا لذكائك يا كونان-كن

89
00:06:54,470 --> 00:06:56,830
يد الشيطان هي يدك اليسرى إذاً؟

90
00:06:57,030 --> 00:06:58,660
ماذا عن يدك اليمنى؟

91
00:06:58,860 --> 00:07:00,760
لا بدّ أنّها يد الملاك

92
00:07:02,040 --> 00:07:03,080
يا لبساطتك

93
00:07:06,120 --> 00:07:09,320
لمَ بحوزة أولئك الأطفال تلك الخريطة؟

94
00:07:09,820 --> 00:07:12,580
يا له من صبيّ ذكي

95
00:07:12,780 --> 00:07:14,900
لنسرع قبل أن يسبقونا

96
00:07:15,100 --> 00:07:16,260
! أجل

97
00:07:16,660 --> 00:07:17,660
يد الشيطان

98
00:07:18,580 --> 00:07:20,660
الرباط المرقّط

99
00:07:27,420 --> 00:07:29,650
بدا ذلكما الاثنان مُريبين

100
00:07:29,850 --> 00:07:33,390
أجل! يبحثان عن نفس الكنز معنا بالتأكيد

101
00:07:33,590 --> 00:07:36,430
أجل، فقد ذكرا كنزاً

102
00:07:36,600 --> 00:07:38,810
نعم، لا شكّ في الأمر

103
00:07:54,200 --> 00:07:58,040
! النجدة، أنا أغرق! أمّي

104
00:07:58,240 --> 00:08:00,310
! أمّي! أمّي! أنا أغرق

105
00:08:00,510 --> 00:08:02,330
أنت، ميتسوهيكو

106
00:08:03,480 --> 00:08:05,330
جرّب الوقوف

107
00:08:07,630 --> 00:08:08,630
ماذا؟

108
00:08:10,050 --> 00:08:11,480
ظننتني سأموت

109
00:08:12,720 --> 00:08:14,380
الرباط المرقّط

110
00:08:14,640 --> 00:08:16,050
حمامة النهر

111
00:08:16,260 --> 00:08:17,890
ضفّة والتون

112
00:08:21,490 --> 00:08:26,190
حتّى أفضل عيدان ثقاب التخييم
لن تشتعل في أيّ ريح بعدما تبللت

113
00:08:26,390 --> 00:08:30,530
تبّاً، كنت أتمنى إشعال نار وتجفيف ثيابنا

114
00:08:30,730 --> 00:08:31,850
يمكننا

115
00:08:33,930 --> 00:08:36,240
أنزع رأس المصباح اليدوي

116
00:08:36,500 --> 00:08:39,990
أستخرج العاكس وأضع عود ثقاب به

117
00:08:40,190 --> 00:08:43,750
أوجّهه الآن نحو الشمس وأجمع الضوء

118
00:08:46,030 --> 00:08:49,130
قد يكون عود ثقاب تخييم جيّد،
لكن لا يزال مبللاً

119
00:08:49,330 --> 00:08:51,670
ليس صالحاً للاستعمال الآن، أليس كذلك؟

120
00:08:57,260 --> 00:08:58,180
! رائع

121
00:08:58,181 --> 00:08:59,890
! أحسنت يا كونان-كن

122
00:09:03,150 --> 00:09:03,980
! حسنٌ

123
00:09:03,981 --> 00:09:07,400
! كأنّ لديك حكمة العجوزة

124
00:09:08,770 --> 00:09:12,229
ألا يمكنك مناداتها بمعرفة النجاة على الأقل؟

125
00:09:12,230 --> 00:09:13,280
الرباط المرقّط

126
00:09:14,400 --> 00:09:16,360
السهم مزدوج الرأس

127
00:09:20,130 --> 00:09:22,350
! تبّاً! أين الطريق الصحيح؟

128
00:09:22,550 --> 00:09:25,710
! تبّاً! تبّاً

129
00:09:26,340 --> 00:09:30,000
يبدو أنّ هناك كتابة عليها لكن يصعب قراءتها

130
00:09:30,360 --> 00:09:31,960
ربما نذهب شرقاً

131
00:09:32,120 --> 00:09:34,990
! أين الشرق إذاً؟

132
00:09:35,190 --> 00:09:36,550
لا أدري

133
00:09:45,830 --> 00:09:49,440
ربما كان خطراً عليهم الذهاب بمفردهم

134
00:09:51,170 --> 00:09:52,560
تمّ الإطفاء

135
00:09:52,760 --> 00:09:54,300
تمّ تأكيد الإطفاء

136
00:09:55,110 --> 00:09:57,810
أتظن بإمكاننا الوصول للنهاية حقاً؟

137
00:09:58,010 --> 00:09:59,760
أين نذهب من هنا؟

138
00:09:59,960 --> 00:10:02,210
لا أريد تسلّق ذاك المكان مجدداً

139
00:10:02,410 --> 00:10:04,080
لا تقلق

140
00:10:04,240 --> 00:10:05,586
نحن هنا الآن، لذا إذا أخذنا هذا الطريق

141
00:10:05,610 --> 00:10:09,170
سنصل لوجهتنا التالية

142
00:10:11,170 --> 00:10:13,330
! حسنٌ، لنذهب في هذه الحالة

143
00:10:13,530 --> 00:10:14,759
! أجل

144
00:10:14,760 --> 00:10:16,210
ضفّة والتون

145
00:10:17,090 --> 00:10:18,340
عارضة توازن قاطع الطريق

146
00:10:22,510 --> 00:10:23,970
عارضة توازن قاطع الطريق

147
00:10:24,350 --> 00:10:26,930
وادي مولر الحكيم

148
00:11:16,130 --> 00:11:17,130
! مستحيل

149
00:11:21,890 --> 00:11:23,420
! تسعة فاصل تسعة

150
00:11:24,240 --> 00:11:25,890
وادي مولر الحكيم

151
00:11:27,620 --> 00:11:29,620
السهم مزدوج الرأس

152
00:11:38,360 --> 00:11:40,330
كُسِرت حديثاً

153
00:11:40,530 --> 00:11:43,430
يبدو أنّها قُطِعت بشيءٍ حاد

154
00:11:43,940 --> 00:11:45,610
لكن ليس سكيناً أو شفرة

155
00:11:45,810 --> 00:11:47,290
ربما مجرف وما شابه

156
00:11:47,490 --> 00:11:48,600
مجرف؟

157
00:11:49,710 --> 00:11:52,880
هكذا إذاً، كان ذلكما الاثنان هنا

158
00:11:58,580 --> 00:12:00,530
ما المكتوب برأيكم؟

159
00:12:01,000 --> 00:12:04,030
تبدو شفرةً ما، لكن يصعب قراءتها

160
00:12:04,230 --> 00:12:05,240
! وجدتُها

161
00:12:05,670 --> 00:12:09,020
إن وضعنا ورقةً عليها ومسحنا بقلم رصاص

162
00:12:09,220 --> 00:12:11,080
ألن تظهر الأحرف؟

163
00:12:11,850 --> 00:12:12,910
! فهمت

164
00:12:13,450 --> 00:12:16,670
لكن لم نجلب معنا ورقاً أو قلم رصاص

165
00:12:16,870 --> 00:12:17,879
أجل

166
00:12:17,880 --> 00:12:20,230
لديّ قلم تحديد لسببٍ ما

167
00:12:20,430 --> 00:12:21,820
سينجح ذلك

168
00:12:22,750 --> 00:12:23,840
هذا القلم؟

169
00:12:24,020 --> 00:12:26,090
كلا، ما اقترحته أيومي-تشان

170
00:12:26,550 --> 00:12:28,059
أعرني هذا قليلاً

171
00:12:28,060 --> 00:12:29,210
ما الذي ستفعله؟

172
00:12:29,410 --> 00:12:30,720
انظروا وحسب

173
00:12:32,680 --> 00:12:35,100
أسكب من ماء الحافظة على اللافتة أوّلاً

174
00:12:35,350 --> 00:12:38,570
ثمّ أفرك تراباً بالكتابة

175
00:12:38,810 --> 00:12:41,190
وعندما أمسحه

176
00:12:41,660 --> 00:12:45,410
أرأيتم؟ يبقى التراب في
الكتابة المنحوتة فيمكن القراءة

177
00:12:46,570 --> 00:12:50,710
"يُظهر عقرب الشمس الزمن والطريق،
اذهب شرقاً"

178
00:12:51,500 --> 00:12:53,460
أيّ اتّجاه هو الشرق؟

179
00:12:53,660 --> 00:12:55,120
ماذا؟ لا أدري

180
00:12:55,320 --> 00:12:57,120
لا جذع أشجار هذه المرّة

181
00:12:57,900 --> 00:13:00,620
عقرب الشمس؟ اذهب شرقاً؟

182
00:13:00,820 --> 00:13:01,820
لحظة

183
00:13:03,300 --> 00:13:04,930
ما الخطب يا كونان-كن؟

184
00:13:07,170 --> 00:13:10,100
سيعطينا هذا الاتجاه بالفعل

185
00:13:10,690 --> 00:13:12,390
، إنّ وجهت عقرب الساعة للشمس

186
00:13:12,590 --> 00:13:16,670
سيكون الجنوب منتصف
المسافة بينه والثانية عشرة

187
00:13:16,870 --> 00:13:19,800
فيكون الشرق تسعين درجة يساراً

188
00:13:20,000 --> 00:13:22,070
ما يعني

189
00:13:22,920 --> 00:13:24,020
الشرق من هنا

190
00:13:24,220 --> 00:13:28,030
"مذهل يا كونان-كن! "حكمة العجوزة، الجزء 2

191
00:13:28,580 --> 00:13:30,260
يـ-يكفي من هذا

192
00:13:30,450 --> 00:13:32,039
! حسنٌ! هيّا بنا

193
00:13:32,040 --> 00:13:33,040
! أجل

194
00:13:35,210 --> 00:13:37,580
شجرة بوسبوروس

195
00:13:41,290 --> 00:13:44,970
منزل كبير القبيلة

196
00:13:49,180 --> 00:13:53,560
تلّ الدبّ الأكبر والدبّ الأصغر

197
00:14:05,530 --> 00:14:09,980
"امش من حيث يشير ماء السماء والصخور. خمسة"

198
00:14:10,180 --> 00:14:12,220
ما المقصود بماء السماء؟

199
00:14:12,420 --> 00:14:13,739
المطر؟

200
00:14:13,740 --> 00:14:15,250
أليس ذلك تفكيراً بسيطاً؟

201
00:14:15,450 --> 00:14:16,820
بلى

202
00:14:18,350 --> 00:14:22,000
خمسة أعمدة صخرية... إن كانت هذه الصخور

203
00:14:22,740 --> 00:14:24,209
! ارفعني قليلاً يا غينتا

204
00:14:24,210 --> 00:14:26,840
! ما بك فجأةً؟

205
00:14:31,180 --> 00:14:33,310
"تشكّل الأعمدة حرف "دبليو

206
00:14:33,510 --> 00:14:36,770
! دبليو... ويست... الغرب، هكذا إذاً

207
00:14:36,970 --> 00:14:39,480
ما المقصود بماء السماء في هذه الحالة؟

208
00:14:39,640 --> 00:14:42,170
أوجدت شيئاً يا كونان-كن؟

209
00:14:42,370 --> 00:14:45,940
أجل،
أتساءل إن كانت خمس خطوات غرب العمود الأوسط؟

210
00:14:51,610 --> 00:14:53,370
لنرَ

211
00:14:53,570 --> 00:14:56,450
! كونان! لا شيء هنا

212
00:14:59,090 --> 00:15:01,920
"إذا لم تكن دبليو الرامزة للغرب،
ربما كانت "إم

213
00:15:02,120 --> 00:15:04,180
أو "بي" حتّى

214
00:15:04,380 --> 00:15:06,330
لكن ما المقصود بماء السمـ

215
00:15:08,130 --> 00:15:09,429
ما الخطب يا ميتسوهيكو؟

216
00:15:09,430 --> 00:15:10,930
! أين أنت؟ يا ميتسوهيكو-كن

217
00:15:11,130 --> 00:15:12,720
! هنا، هنا

218
00:15:12,970 --> 00:15:14,100
! ميتسوهيكو

219
00:15:14,300 --> 00:15:19,370
تعثّرت على شجرة ثمّ ارتطم رأسي بتلك الصخرة

220
00:15:21,240 --> 00:15:22,730
! شجرة وصخرة؟

221
00:15:26,150 --> 00:15:28,580
يبدو أنّها لم تُحرّك لوقت طويل

222
00:15:30,970 --> 00:15:31,990
ما هذا؟

223
00:15:34,440 --> 00:15:36,370
أيمكن أنّ هذا الشكل

224
00:15:40,830 --> 00:15:44,290
إنّها مجموعة الدبّ الأكبر
النجمية من جذوع أشجار وصخور

225
00:15:44,490 --> 00:15:45,510
! هكذا إذاً

226
00:15:45,710 --> 00:15:48,380
"شكلها كمغرفة، لذا "ماء السماء

227
00:15:48,580 --> 00:15:50,510
ما يعني

228
00:15:54,740 --> 00:15:58,080
فهمت، تلك الأعمدة هي كوكبة ذات الكرسيّ

229
00:15:58,280 --> 00:16:02,730
أي أنّ ماء السماء والصخور تشير لنجم الشمال

230
00:16:03,380 --> 00:16:07,580
يبعد نجم الشمال خمسة أضعاف المسافة

231
00:16:07,780 --> 00:16:09,780
! بين نجمي طرف الدبّ الأكبر

232
00:16:11,030 --> 00:16:14,430
ويقع أيضاً مقابل نجم ذات الكرسيّ الأوسط

233
00:16:14,630 --> 00:16:20,320
وبخمسة أضعاف المسافة بين كلّ من نجومها

234
00:16:25,940 --> 00:16:28,870
البروفسور المخادع

235
00:16:31,350 --> 00:16:33,920
! توجد صخرة بكتابة عليها هنا

236
00:16:34,120 --> 00:16:35,460
توقّعت ذلك

237
00:16:35,880 --> 00:16:38,930
"بولاريس هو النجم الشمالي، لذا حرف "بّي

238
00:16:39,310 --> 00:16:42,390
ها هو، إنّه المكان بلا شك

239
00:16:44,790 --> 00:16:47,170
تذكّروا، خمس خطوات

240
00:16:47,370 --> 00:16:48,370
أجل

241
00:16:48,900 --> 00:16:52,820
واحد، اثنان، ثلاثة، أربعة

242
00:16:53,240 --> 00:16:54,310
! خمسة

243
00:16:58,070 --> 00:16:59,570
! ابتعدوا جميعاً

244
00:17:03,740 --> 00:17:04,869
! حسنٌ، لنذهب

245
00:17:04,870 --> 00:17:06,210
! أجل

246
00:17:14,510 --> 00:17:16,190
كونان-كن، أهذا

247
00:17:16,390 --> 00:17:17,870
! الكنز حتماً

248
00:17:18,070 --> 00:17:19,930
! أسرع وافتحه يا كونان

249
00:17:27,660 --> 00:17:29,550
أيمكن أنّ هذه الجواهر

250
00:17:29,730 --> 00:17:31,140
! فعلناها يا ميتسوهيكو

251
00:17:31,340 --> 00:17:33,850
يمكنني أكل قدرما أشاء
! من أطباق الأنقليس في العالم الآن

252
00:17:34,050 --> 00:17:36,570
أجل! وأنا سوف

253
00:17:36,740 --> 00:17:39,280
أعتذر على مقاطعة تسليتكم

254
00:17:40,080 --> 00:17:42,180
لكن عليكم تسليمه لنا

255
00:17:42,380 --> 00:17:44,200
! أنتَ ذاك الرجل

256
00:17:44,600 --> 00:17:47,670
لا شكّ، إنّهما لصّا الجواهر

257
00:17:47,870 --> 00:17:50,130
! هيّا، سلّموه

258
00:17:51,980 --> 00:17:52,980
! هيّا

259
00:17:56,940 --> 00:17:59,510
لا تثر المتاعب يا أحمق

260
00:18:01,770 --> 00:18:03,260
! انطلقي

261
00:18:07,610 --> 00:18:10,400
أخبرني الرجل في الأسفل أن أعطيك هذه

262
00:18:11,850 --> 00:18:12,850
هاك

263
00:18:19,820 --> 00:18:23,380
كونان-كن، ما الذي حصل؟

264
00:18:24,470 --> 00:18:27,390
ربما تعثّر بصخرة وارتطم رأسه؟

265
00:18:27,590 --> 00:18:28,790
تقصد مثل ميتسوهيكو؟

266
00:18:28,990 --> 00:18:32,710
! ليس شيئاً مُضحكاً! كان يؤلم حقاً

267
00:18:36,140 --> 00:18:39,040
ها هو، هذا كنزنا الحقيقيّ

268
00:18:39,240 --> 00:18:40,430
أجل

269
00:18:45,690 --> 00:18:49,980
أتقصد أنّ هذا الكنز؟

270
00:18:50,180 --> 00:18:52,300
لفافة الورق الوحيدة هذه؟

271
00:18:52,500 --> 00:18:54,520
ما المكتوب يا كونان-كن؟

272
00:18:56,700 --> 00:19:02,080
الكنز هو كلّ تجاربكم التي"
مررتم بها للوصول هنا

273
00:19:03,320 --> 00:19:05,740
، ربما سقطتم في النهر

274
00:19:06,030 --> 00:19:07,920
أشعلتم ناراً واصطدتم سمكاً

275
00:19:08,430 --> 00:19:11,190
وتعاونتم مع أصدقائكم للوصول هنا

276
00:19:11,390 --> 00:19:13,170
كلّ تلك التجارب

277
00:19:14,470 --> 00:19:16,610
قد لا تفهمون الآن

278
00:19:16,810 --> 00:19:21,460
لكن يوماً ما سيكون كلّ هذا
كنزاً نفيساً بلا شك

279
00:19:21,830 --> 00:19:23,430
وثروة ربما

280
00:19:24,330 --> 00:19:30,100
"! إن أمكن،
انقلوا هذه المغامرة لمن يتبعونكم رجاءً

281
00:19:30,630 --> 00:19:33,700
لا أفهم حقاً

282
00:19:33,900 --> 00:19:36,870
حسناً، لا يهم... شعورٌ كهذا، صحيح؟

283
00:19:37,070 --> 00:19:40,110
أجل، نوعاً ما

284
00:19:50,460 --> 00:19:52,790
يوساكو كودو

285
00:19:53,960 --> 00:19:57,450
ستكتشف عندما تصل للنهاية

286
00:20:00,220 --> 00:20:02,220
! أبي كتب هذه

287
00:20:02,850 --> 00:20:07,490
من غيره قد يستطيع محاكاة
انعقافة حرف "كيه" تلك؟

288
00:20:11,180 --> 00:20:13,670
كان عليّ أن ألحظ من البداية

289
00:20:13,870 --> 00:20:16,970
القمّة مقابل النهر الذي كنّا نخيّم عنده

290
00:20:17,170 --> 00:20:19,740
كانت المكان الذي نسعى له

291
00:20:21,230 --> 00:20:25,260
لم أتصوّر أن أرى مخيم
البروفسور من فوق تلك الشجرة

292
00:20:31,900 --> 00:20:34,170
لكن رغم أنّ المسافة لم تكن بعيدة

293
00:20:34,650 --> 00:20:37,130
كانت الرحلة مُضنية

294
00:20:38,230 --> 00:20:41,420
بعد سماعه بالوضع،
اتّصل البروفسور بالشرطة فوراً

295
00:20:41,620 --> 00:20:43,790
وتمّ اعتقال لِصَّي المجوهرات

296
00:20:43,990 --> 00:20:48,530
، قرّروا استجوابنا في اليوم التالي
فتركونا بحالنا الليلة

297
00:20:54,950 --> 00:20:57,860
اعتبرتها رحلة بحث عن كنز سخيفة بدايةً

298
00:20:58,340 --> 00:21:00,980
لكنّ المغامرات كهذه لا يُملّ منها

299
00:21:02,140 --> 00:21:05,700
رغم أنّي في السابعة عشر،
استمتعتُ بها كثيراً

300
00:21:09,490 --> 00:21:12,530
لم تكن الجواهر الكنز في النهاية

301
00:21:14,110 --> 00:21:15,550
لكنّي وجدتُه يا أبي، وجدتُه فعلاً

302
00:21:16,260 --> 00:21:20,169
الكنز الحقيقيّ

303
00:21:20,170 --> 00:21:27,800
شينتشي كودو

304
00:23:00,570 --> 00:23:04,020
حدث ذلك بعد فترة قصيرة من ولادتك يا شينتشي

305
00:23:04,610 --> 00:23:08,220
سُرقت مخطوطة أبيك التي كاد يُعلن عنها

306
00:23:08,420 --> 00:23:09,580
سُرقت؟

307
00:23:09,740 --> 00:23:15,040
بالنظر للوضع، بدا أنّه عمل أحد معجبيه

308
00:23:15,240 --> 00:23:18,310
لكن لم يُعثر على اللصّ أو المخطوطة أبداً

309
00:23:19,410 --> 00:23:24,920
لصّ المجوهرات الذي مات في حادث
هو من رسم الخريطة الأخرى إذاً

310
00:23:25,080 --> 00:23:31,380
أجل، لم يستطع نشر المخطوطة بما أنّها
مسروقة، فبقيت حبيسة الورق حتّى الآن

311
00:23:31,740 --> 00:23:35,430
لكن لم يخطر لي أن تظهر هكذا

312
00:23:38,680 --> 00:23:40,350
يوساكو كودو

313
00:23:45,310 --> 00:23:47,980
إلى ابني شينتشي

314
00:24:04,440 --> 00:24:05,880
! تبّاً! اختفيا

315
00:24:10,900 --> 00:24:12,260
! ران! انتبهي

316
00:24:15,470 --> 00:24:17,560
! ران! استيقظي! استيقظي

317
00:24:22,550 --> 00:24:25,010
! لمَ؟ لمَ يستهدف ران؟

318
00:24:25,640 --> 00:24:26,770
في الحلقة القادمة من كونان

319
00:24:26,970 --> 00:24:31,110
جريمة قتل رجل الضماد في المنزل الجبلي
(الجزء الأوّل)

320
00:24:46,930 --> 00:24:48,980
تلميح الحلقة القادمة

321
00:24:49,180 --> 00:24:51,010
استراق نظر

