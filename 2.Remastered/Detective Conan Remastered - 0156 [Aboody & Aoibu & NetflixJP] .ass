Dialogue: 0,0:00:01.81,0:00:03.81,Default,,0,0,0,,.نور البصيرة يشرق ليكشف لي الحقيقة
Dialogue: 0,0:00:03.81,0:00:05.61,Default,,0,0,0,,.بمجرد أن يبدأ، لا شيء يمكن أن يوقفه
Dialogue: 0,0:00:05.61,0:00:07.71,Default,,0,0,0,,.في حلقة اليوم، يظهر العديد من ضباط الشرطة
Dialogue: 0,0:00:07.71,0:00:10.61,Default,,0,0,0,,.يساهم فريق المحققين الصغار في الوصول إلى الحقيقة
Dialogue: 0,0:00:10.61,0:00:12.01,Default,,0,0,0,,.يسعى وراء الحقيقة دائما
Dialogue: 0,0:00:12.01,0:00:13.91,Default,,0,0,0,,.طفل في المظهر بذكاء شخص بالغ
Dialogue: 0,0:00:13.91,0:00:16.31,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:00:16.05,0:00:19.30,DCOpening,,0,0,0,,لا يهم أي مجلة أتصفحها
Dialogue: 0,0:00:19.30,0:00:23.14,DCOpening,,0,0,0,,بلا جدوى، أتنفس بيأس
Dialogue: 0,0:00:24.27,0:00:27.36,DCOpening,,0,0,0,,الملابس الوحيدة التي تناسبني
Dialogue: 0,0:00:27.52,0:00:31.19,DCOpening,,0,0,0,,تنتمي إلى أسلوب القرن الجديد
Dialogue: 0,0:00:32.65,0:00:35.44,DCOpening,,0,0,0,,لا يهم، فكل هذا لا يليق بك
Dialogue: 0,0:00:35.69,0:00:39.28,DCOpening,,0,0,0,,أعتذر كثيراً إن خيب ذلك ظنك
Dialogue: 0,0:00:40.32,0:00:43.99,DCOpening,,0,0,0,,بأعجوبة، فقط حتى قمة الجرف
Dialogue: 0,0:00:44.41,0:00:48.12,DCOpening,,0,0,0,,باضطراب، أتساءل إن كان الوضع جيدًا حقًا؟
Dialogue: 0,0:00:48.16,0:00:52.25,DCOpening,,0,0,0,,رغم كل هذا، ليس أمامي سوى طريق واحد
Dialogue: 0,0:00:52.59,0:00:56.80,DCOpening,,0,0,0,,لا مشكلة، أنا في وضع جيد تماماً
Dialogue: 0,0:01:01.80,0:01:05.47,DCOpening,,0,0,0,,بأعجوبة، لن أتراجع ولو قليلاً
Dialogue: 0,0:01:05.93,0:01:09.52,DCOpening,,0,0,0,,أرجوك، لا توجه لي نظراتك الباردة
Dialogue: 0,0:01:09.85,0:01:13.60,DCOpening,,0,0,0,,كما قلت، دعني أفعل ذلك 
Dialogue: 0,0:01:13.94,0:01:17.90,DCOpening,,0,0,0,,إن رفضتَ، سينهار كل شيء
Dialogue: 0,0:01:18.24,0:01:21.91,DCOpening,,0,0,0,,بأعجوبة، فقط حتى قمة الجرف
Dialogue: 0,0:01:22.37,0:01:25.83,DCOpening,,0,0,0,,باضطراب، أتساءل إن كان الوضع جيدًا حقًا؟
Dialogue: 0,0:01:26.16,0:01:30.21,DCOpening,,0,0,0,,رغم كل هذا، ليس أمامي سوى طريق واحد
Dialogue: 0,0:01:30.46,0:01:34.76,DCOpening,,0,0,0,,لا مشكلة، أنا في وضع جيد تماماً
Dialogue: 0,0:01:36.68,0:01:40.88,Default,,0,0,0,,قصة حب ضابط شرطة العاصمة 2 - الجزء الأول 
Dialogue: 0,0:01:36.68,0:01:40.88,Default,,0,0,0,,{\fs120\pos(950,240)} قصة حب ضابط شرطة العاصمة 2
Dialogue: 0,0:01:36.68,0:01:40.88,Default,,0,0,0,,{\fs120\pos(959,830)} (الجزء الأول) 
Dialogue: 0,0:01:44.35,0:01:45.95,Default,,0,0,0,,،لا شك في ذلك
Dialogue: 0,0:01:45.95,0:01:49.75,Default,,0,0,0,,.لقد بدأت اشك في هويتك الحقيقية
Dialogue: 0,0:01:49.75,0:01:53.75,Default,,0,0,0,,،لا فائدة من محاولة إخفاء الأمر عنها بعد الآن
Dialogue: 0,0:01:53.75,0:01:56.35,Default,,0,0,0,, .ستنتهي فقط بإيذائها
Dialogue: 0,0:01:56.35,0:01:59.65,Default,,0,0,0,,لماذا تخبريني بهذا؟
Dialogue: 0,0:01:59.65,0:02:03.45,Default,,0,0,0,,افهم أنك تستطيع قراءة أفكار المجرم
Dialogue: 0,0:02:03.45,0:02:05.75,Default,,0,0,0,,لكنك لا تستطيع قراءة قلب امرأة؟
Dialogue: 0,0:02:05.75,0:02:07.25,Default,,0,0,0,,قلب امرأة؟
Dialogue: 0,0:02:08.35,0:02:10.95,Default,,0,0,0,,.أنا أحبك
Dialogue: 0,0:02:10.95,0:02:13.15,Default,,0,0,0,,...كنت أحبك منذ اللحظة التي التقينا فيها
Dialogue: 0,0:02:15.45,0:02:17.35,Default,,0,0,0,,لم تكن تعرف ذلك، أليس كذلك؟
Dialogue: 0,0:02:17.35,0:02:19.05,Default,,0,0,0,,يا يايبا المقنع؟
Dialogue: 0,0:02:20.05,0:02:22.15,Default,,0,0,0,,!توقف! توقف
Dialogue: 0,0:02:22.15,0:02:23.55,Default,,0,0,0,,.هذا غير مقبول، كونان
Dialogue: 0,0:02:23.55,0:02:25.65,Default,,0,0,0,,.عليك أن تبدو أكثر دهشة
Dialogue: 0,0:02:25.65,0:02:28.95,Default,,0,0,0,,هذا هو المشهد الحاسم
Dialogue: 0,0:02:28.95,0:02:31.15,Default,,0,0,0,,حيث تعترف الجاسوسة التي خانت العالم السفلي
Dialogue: 0,0:02:31.15,0:02:34.05,Default,,0,0,0,,!بحبها ليايبا المقنع
Dialogue: 0,0:02:34.05,0:02:38.05,Default,,0,0,0,,تبا. أليس هذا من المفترض أن تكون مسرحية مدرسية؟
Dialogue: 0,0:02:38.05,0:02:40.85,Default,,0,0,0,,.إذن لنقم بقصة عادية
Dialogue: 0,0:02:40.85,0:02:43.75,Default,,0,0,0,,."مثل "موموتارو" أو "الفتى الصغير
Dialogue: 0,0:02:43.75,0:02:47.85,Default,,0,0,0,,.لا أستطيع إخراج شيء يفتقر للواقعية مثل تلك القصص
Dialogue: 0,0:02:47.85,0:02:50.85,Default,,0,0,0,,إذن ماذا تسمي يايبا المقنع؟
Dialogue: 0,0:02:50.85,0:02:52.85,Default,,0,0,0,,لست سعيدًا بدور العملاق البطاطس
Dialogue: 0,0:02:52.85,0:02:55.75,Default,,0,0,0,,!توقف عن التذمر وتحمل
Dialogue: 0,0:02:55.75,0:02:57.35,Default,,0,0,0,,.هو محق
Dialogue: 0,0:02:57.35,0:02:59.25,Default,,0,0,0,,بعد كل شيء، تسللنا إلى هذا المبنى المهجور
Dialogue: 0,0:02:59.25,0:03:02.05,Default,,0,0,0,,.لخلق جو من التشويق
Dialogue: 0,0:03:02.05,0:03:04.55,Default,,0,0,0,,.إذن لنقم بقصة شرطية
Dialogue: 0,0:03:04.55,0:03:05.95,Default,,0,0,0,,تعرف ما أعنيه، أليس كذلك؟
Dialogue: 0,0:03:05.95,0:03:07.55,Default,,0,0,0,,حيث يهرب المجرم إلى مبنى مهجور
Dialogue: 0,0:03:07.55,0:03:08.95,Default,,0,0,0,,...ويحدث تبادل لإطلاق النار
Dialogue: 0,0:03:08.95,0:03:09.95,Default,,0,0,0,,!انتظر
Dialogue: 0,0:03:13.95,0:03:15.05,Default,,0,0,0,,!توقف
Dialogue: 0,0:03:16.05,0:03:18.55,Default,,0,0,0,,!ارفع يديك ولا تتحرك
Dialogue: 0,0:03:19.65,0:03:21.05,Default,,0,0,0,,. الضابطة ساتو
Dialogue: 0,0:03:22.35,0:03:23.55,Default,,0,0,0,,!أيومي
Dialogue: 0,0:03:23.55,0:03:24.95,Default,,0,0,0,,.لا تقتربون مني
Dialogue: 0,0:03:24.95,0:03:26.65,Default,,0,0,0,,!أيومي - \N!أيومي -
Dialogue: 0,0:03:28.15,0:03:31.55,Default,,0,0,0,,.لا... لا تقتربون مني
Dialogue: 0,0:03:31.55,0:03:32.95,Default,,0,0,0,,!كونان
Dialogue: 0,0:03:36.05,0:03:38.45,Default,,0,0,0,,!دعني أذهب
Dialogue: 0,0:03:38.45,0:03:39.55,Default,,0,0,0,,.لا
Dialogue: 0,0:03:39.55,0:03:43.05,Default,,0,0,0,,!دعني أذهب! دعني أذهب
Dialogue: 0,0:03:45.55,0:03:46.85,Default,,0,0,0,,.آسف، يا صغيرة
Dialogue: 0,0:03:46.85,0:03:48.65,Default,,0,0,0,,.لابد أنني أخفتك
Dialogue: 0,0:03:49.85,0:03:51.35,Default,,0,0,0,,.أنا آسف حقًا
Dialogue: 0,0:04:04.25,0:04:05.55,Default,,0,0,0,,.تبًا
Dialogue: 0,0:04:10.45,0:04:11.75,Default,,0,0,0,,!أيومي
Dialogue: 0,0:04:11.75,0:04:14.05,Default,,0,0,0,,.كونان -\Nأين هو؟ -
Dialogue: 0,0:04:14.05,0:04:15.75,Default,,0,0,0,,.أظن أنه على السطح
Dialogue: 0,0:04:15.75,0:04:16.75,Default,,0,0,0,,.لنذهب
Dialogue: 0,0:04:23.75,0:04:25.65,Default,,0,0,0,,.انتظر. قلت لك أن تتوقف
Dialogue: 0,0:04:55.95,0:04:57.85,Default,,0,0,0,,.انها مذهلة
Dialogue: 0,0:04:57.85,0:04:59.65,Default,,0,0,0,,.انسة ساتو
Dialogue: 0,0:04:59.65,0:05:00.85,Default,,0,0,0,,.الضابط تاكاجي
Dialogue: 0,0:05:02.45,0:05:04.15,Default,,0,0,0,,!انسة ساتو
Dialogue: 0,0:05:04.15,0:05:07.25,Default,,0,0,0,,.تاكاجي، أذهب إلى الأمام
Dialogue: 0,0:05:07.25,0:05:08.65,Default,,0,0,0,,!حالًا
Dialogue: 0,0:05:08.65,0:05:10.65,Default,,0,0,0,,مهلا، ماذا حدث؟
Dialogue: 0,0:05:13.05,0:05:16.75,Default,,0,0,0,,ماذا؟ هروب سجين؟
Dialogue: 0,0:05:16.75,0:05:18.75,Default,,0,0,0,,.نعم، هذا صحيح
Dialogue: 0,0:05:18.75,0:05:20.55,Default,,0,0,0,,،كنا ننقله إلى المقر
Dialogue: 0,0:05:20.55,0:05:23.45,Default,,0,0,0,,.حدث حادث بين سيارة ودراجة نارية
Dialogue: 0,0:05:23.45,0:05:24.65,Default,,0,0,0,,كان المشتبه به يجلس بجواري
Dialogue: 0,0:05:24.65,0:05:27.85,Default,,0,0,0,,.وبينما كنا منشغلين بذلك، هرب
Dialogue: 0,0:05:27.85,0:05:29.05,Default,,0,0,0,,،كان رجلاً هادئًا جدًا
Dialogue: 0,0:05:29.05,0:05:32.15,Default,,0,0,0,,.لم أتوقع أبدًا أنه سيحاول الهروب
Dialogue: 0,0:05:32.15,0:05:33.35,Default,,0,0,0,,.لقد أفسدت الأمر
Dialogue: 0,0:05:33.35,0:05:34.35,Default,,0,0,0,,،لقد سمحت له بالهروب
Dialogue: 0,0:05:34.35,0:05:36.65,Default,,0,0,0,,لن تنجو بمجرد تقديم تقرير، أتعلم؟
Dialogue: 0,0:05:36.65,0:05:38.75,Default,,0,0,0,,.أنا أعرف ذلك
Dialogue: 0,0:05:46.05,0:05:48.65,Default,,0,0,0,,.6:43 مساءً
Dialogue: 0,0:05:48.65,0:05:52.85,Default,,0,0,0,,...تم القبض على المشتبه به الهارب
Dialogue: 0,0:05:55.15,0:05:58.45,Default,,0,0,0,,.تبًا. كسرت الأصفاد
Dialogue: 0,0:05:58.45,0:06:01.25,Default,,0,0,0,,.يا للإزعاج، أنت لا تجلب سوى المتاعب
Dialogue: 0,0:06:03.55,0:06:05.85,Default,,0,0,0,,،حسنًا، قم الآن
Dialogue: 0,0:06:09.25,0:06:10.45,Default,,0,0,0,,.مستحيل 
Dialogue: 0,0:06:11.65,0:06:14.05,Default,,0,0,0,,المفتاح! المفتاح! أين المفتاح؟
Dialogue: 0,0:06:14.05,0:06:16.35,Default,,0,0,0,,.لا، إنه ليس هنا
Dialogue: 0,0:06:18.25,0:06:20.75,Default,,0,0,0,,.لا بد أنني أسقطته في مكان ما
Dialogue: 0,0:06:20.75,0:06:25.35,Default,,0,0,0,,.لم يكن عليّ أن أكون قاسية -\N .أنا بريء -
Dialogue: 0,0:06:25.35,0:06:27.35,Default,,0,0,0,,.أنا بريء
Dialogue: 0,0:06:27.35,0:06:30.35,Default,,0,0,0,,!لم أقتل احداً، أيتها الضابطة
Dialogue: 0,0:06:33.45,0:06:36.85,Default,,0,0,0,,مهلا، هل سمعتم نوعًا من الضوضاء من الطابق العلوي؟
Dialogue: 0,0:06:36.85,0:06:37.95,Default,,0,0,0,,.لا بد أنه خيالك
Dialogue: 0,0:06:37.95,0:06:40.05,Default,,0,0,0,,.المكان مغلق بإحكام
Dialogue: 0,0:06:40.05,0:06:42.35,Default,,0,0,0,,.هيا. لننهي هذا العمل
Dialogue: 0,0:06:42.55,0:06:43.15,Default,NTP,,0000,0000,0000,.نعم 
Dialogue: 0,0:06:44.25,0:06:47.25,Default,,0,0,0,,انسة ساتو، أين أنتِ؟
Dialogue: 0,0:06:47.25,0:06:48.65,Default,,0,0,0,,.انسة ساتو
Dialogue: 0,0:06:48.65,0:06:49.65,Default,,0,0,0,, . هذا غريب
Dialogue: 0,0:06:50.65,0:06:52.55,Default,,0,0,0,,أليس هذا متحفًا فنيًا؟
Dialogue: 0,0:06:52.55,0:06:53.55,Default,,0,0,0,,.نعم
Dialogue: 0,0:06:53.55,0:06:57.35,Default,,0,0,0,,إذن لماذا لا توجد أي لوحات؟
Dialogue: 0,0:06:57.35,0:06:58.95,Default,,0,0,0,,.أنتِ محقة
Dialogue: 0,0:06:58.95,0:07:01.05,Default,,0,0,0,,.ربما يتم تغيير المعروضات
Dialogue: 0,0:07:01.05,0:07:02.15,Default,,0,0,0,,.اسمعوا
Dialogue: 0,0:07:02.15,0:07:05.35,Default,,0,0,0,,.هذا خطير جدًا، ألم أقل لكم أن تعودوا إلى المنزل
Dialogue: 0,0:07:05.35,0:07:06.65,Default,,0,0,0,,.تاكاجي
Dialogue: 0,0:07:06.65,0:07:07.85,Default,,0,0,0,,انسة ساتو؟
Dialogue: 0,0:07:07.85,0:07:08.85,Default,,0,0,0,,.تاكاجي
Dialogue: 0,0:07:08.85,0:07:10.25,Default,,0,0,0,,!انا هنا
Dialogue: 0,0:07:10.25,0:07:11.95,Default,,0,0,0,,انسة ساتو؟
Dialogue: 0,0:07:13.35,0:07:14.55,Default,,0,0,0,,كيف سارت الأمور، انسة ساتو؟
Dialogue: 0,0:07:14.55,0:07:15.95,Default,,0,0,0,,!هنا! هنا
Dialogue: 0,0:07:17.15,0:07:18.35,Default,,0,0,0,,ماذا تفعلين هناك؟
Dialogue: 0,0:07:18.35,0:07:20.35,Default,,0,0,0,,.هذا حمام الرجال
Dialogue: 0,0:07:20.35,0:07:22.95,Default,,0,0,0,,وماذا حدث للمشتبه به؟
Dialogue: 0,0:07:24.35,0:07:26.55,Default,,0,0,0,,...لقد تمكنت من القبض عليه مرة أخرى، لكن
Dialogue: 0,0:07:26.55,0:07:28.75,Default,,0,0,0,,.لقد ارتكبت خطأً ما
Dialogue: 0,0:07:28.75,0:07:30.75,Default,,0,0,0,,إذن، ما الذي فعلتيه؟
Dialogue: 0,0:07:30.75,0:07:34.25,Default,,0,0,0,,أليس من الإجراءات الطبيعية تقييد يدي المشتبه به؟
Dialogue: 0,0:07:34.25,0:07:36.15,Default,,0,0,0,,،لم أرد أن يهرب مرة أخرى
Dialogue: 0,0:07:36.15,0:07:38.75,Default,,0,0,0,,.فقيّدت نفسي به دون قصد
Dialogue: 0,0:07:38.75,0:07:39.75,Default,,0,0,0,,أين المفتاح؟
Dialogue: 0,0:07:39.75,0:07:41.35,Default,,0,0,0,,.أظن أنني فقدته
Dialogue: 0,0:07:41.35,0:07:42.95,Default,,0,0,0,,،إذا سمع الضباط الآخرون عن هذا
Dialogue: 0,0:07:42.95,0:07:44.15,Default,,0,0,0,,.سأشعر بالإحراج
Dialogue: 0,0:07:44.15,0:07:46.35,Default,,0,0,0,,فهل يمكنك الذهاب لإحضار المفتاح الاحتياطي وعدم إخبار أحد؟
Dialogue: 0,0:07:46.35,0:07:48.35,Default,,0,0,0,,،لن أستطيع الدخول والخروج دون أن يلاحظني أحد
Dialogue: 0,0:07:48.35,0:07:51.45,Default,,0,0,0,,.اصبح الجميع في حالة اضطراب بسبب هذا السجين الهارب
Dialogue: 0,0:07:51.45,0:07:52.85,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:07:52.85,0:07:55.35,Default,,0,0,0,,أهذه طريقة للتحدث مع ضابط أعلى رتبة؟
Dialogue: 0,0:07:55.35,0:07:56.65,Default,,0,0,0,,...بالإضافة إلى ذلك، حدث هذا
Dialogue: 0,0:07:56.65,0:07:58.55,Default,,0,0,0,,.لأنك لم تراقبه جيدًا
Dialogue: 0,0:07:58.55,0:07:59.85,Default,,0,0,0,,وسمحت له بالهروب، أليس كذلك؟
Dialogue: 0,0:07:59.85,0:08:01.95,Default,,0,0,0,,.نعم. أنتِ محقة تمامًا
Dialogue: 0,0:08:01.95,0:08:04.35,Default,,0,0,0,,.حسنًا، أعتمد عليك، تاكاجي
Dialogue: 0,0:08:04.35,0:08:05.55,Default,,0,0,0,,.نعم، نعم
Dialogue: 0,0:08:05.55,0:08:07.85,Default,,0,0,0,,لم أفعلها.
Dialogue: 0,0:08:07.85,0:08:09.35,Default,,0,0,0,,.لم أقتل احداً
Dialogue: 0,0:08:09.35,0:08:10.85,Default,,0,0,0,,لا أعرف ما حدث
Dialogue: 0,0:08:10.85,0:08:13.65,Default,,0,0,0,,.لكن عندما استيقظت في الصباح، كانت السيدة مورانشي ميتة
Dialogue: 0,0:08:13.65,0:08:15.85,Default,,0,0,0,,.هذا كل ما يقوله منذ البداية
Dialogue: 0,0:08:15.85,0:08:18.15,Default,,0,0,0,,!إنها الحقيقة! صدقوني من فضلكم
Dialogue: 0,0:08:18.15,0:08:20.75,Default,,0,0,0,,.اسمعني، سيد هيغاشيدا
Dialogue: 0,0:08:20.75,0:08:23.65,Default,,0,0,0,,،المتوفاة هي ماني مورانشي
Dialogue: 0,0:08:23.65,0:08:25.25,Default,,0,0,0,,كانت تعيش في نفس مبنى الشقة الذي تعيش فيه
Dialogue: 0,0:08:25.25,0:08:26.85,Top,,0,0,0,,.وكانت صدفة رئيستك في العمل
Dialogue: 0,0:08:25.45,0:08:29.45,Default,NTP,,0000,0000,0000,{\fs90\pos(900,790)}ماسامي مورانشي\Nالضحية
Dialogue: 0,0:08:26.85,0:08:29.65,Top,,0,0,0,,.الجريمة حدثت في حمامها
Dialogue: 0,0:08:30.15,0:08:32.85,Default,,0,0,0,,،عندما عُثر على جثتها
Dialogue: 0,0:08:32.85,0:08:37.15,Default,,0,0,0,,.كنت سكرانًا جدًا ونائمًا على سريرها
Dialogue: 0,0:08:37.15,0:08:40.75,Default,,0,0,0,,.الباب الأمامي كان مقفلاً ومقيدًا من الداخل
Dialogue: 0,0:08:40.75,0:08:42.65,Default,,0,0,0,,.الشقة كانت مغلقة تمامًا
Dialogue: 0,0:08:42.65,0:08:45.85,Default,,0,0,0,,بالإضافة إلى ذلك، بصمات أصابعك كانت على قفل الباب والسلسلة
Dialogue: 0,0:08:45.85,0:08:51.25,Default,,0,0,0,,.وحتى على سلك الفيديو الذي وجدناه حول عنقها
Dialogue: 0,0:08:51.25,0:08:54.85,Default,,0,0,0,,،بالإضافة إلى ذلك، كنت دائمًا تتجادل معها بشأن العمل
Dialogue: 0,0:08:54.85,0:08:57.75,Default,,0,0,0,,في يوم الجريمة، كنتَ في أحد الحانات وانت\N.تحتسي الشرب، وتناقل الناس الحديث عنها
Dialogue: 0,0:08:57.75,0:09:00.75,Default,,0,0,0,,ثم انطلقت إلى المنزل، أليس كذلك؟
Dialogue: 0,0:09:00.75,0:09:03.05,Default,,0,0,0,,كنت سكرانًا، ذهبت إلى شقتها
Dialogue: 0,0:09:03.05,0:09:04.95,Default,,0,0,0,,،وقتلتها في خلاف حاد
Dialogue: 0,0:09:04.95,0:09:06.35,Default,,0,0,0,,أليس هذا ما حدث؟
Dialogue: 0,0:09:06.35,0:09:10.35,Default,,0,0,0,,قفلت الباب حتى لا تهرب
Dialogue: 0,0:09:10.35,0:09:12.55,Default,,0,0,0,,.وبعد أن قتلتها، كنت سكرانًا جدًا
Dialogue: 0,0:09:12.55,0:09:15.85,Default,,0,0,0,,فنمت على سريرها، أليس كذلك؟
Dialogue: 0,0:09:15.85,0:09:19.65,Default,,0,0,0,,.لكنني لا أتذكر أي شيء
Dialogue: 0,0:09:19.65,0:09:23.45,Default,,0,0,0,,.ذلك لأنك كنت سكرانًا تمامًا
Dialogue: 0,0:09:23.45,0:09:29.25,Default,,0,0,0,,.نعم، صحيح أنني كرهتها لأنها كانت تنتقد كل عمل أقوم به
Dialogue: 0,0:09:29.25,0:09:32.85,Default,,0,0,0,,.لكنني لم أكرهها بما يكفي لقتلها
Dialogue: 0,0:09:32.85,0:09:35.35,Default,,0,0,0,,إذن لماذا حاولت الهروب؟
Dialogue: 0,0:09:35.35,0:09:38.05,Default,,0,0,0,,.هناك مكان يجب أن أكون فيه
Dialogue: 0,0:09:38.05,0:09:39.55,Default,,0,0,0,,وأين هو؟
Dialogue: 0,0:09:39.55,0:09:41.55,Default,,0,0,0,,.لدي ابنة في شيكاغو
Dialogue: 0,0:09:43.05,0:09:46.15,Default,,0,0,0,,،أخذتها زوجتي عندما انفصلنا
Dialogue: 0,0:09:46.15,0:09:49.95,Default,,0,0,0,,.لكنها أرسلت لي دعوة لحضور حفل زفافها
Dialogue: 0,0:09:49.95,0:09:54.15,Default,,0,0,0,,...ظننت أنها تكرهني طوال هذه الـ17 عامًا
Dialogue: 0,0:09:54.15,0:09:57.05,Default,,0,0,0,,.لهذا يجب أن أذهب
Dialogue: 0,0:09:59.45,0:10:00.45,Default,,0,0,0,,!إنها الحقيقة
Dialogue: 0,0:10:00.45,0:10:01.75,Default,,0,0,0,,،اذهبوا إلى شقتي
Dialogue: 0,0:10:01.75,0:10:05.65,Default,,0,0,0,,.ستجدون الرسالة والتذكرة
Dialogue: 0,0:10:05.65,0:10:07.65,Default,,0,0,0,,...لكن ماذا يمكنني أن أفعل
Dialogue: 0,0:10:07.65,0:10:10.85,Default,,0,0,0,,.هذا الرجل ليس رجلًا سيئًا
Dialogue: 0,0:10:10.85,0:10:13.45,Default,,0,0,0,,.أعرف ذلك لأنه أطلق سراحي
Dialogue: 0,0:10:13.45,0:10:15.75,Default,,0,0,0,,! حتى أنه قال إنه آسف
Dialogue: 0,0:10:15.75,0:10:18.75,Default,,0,0,0,,.لو كان رجلًا سيئًا، لما فعل ذلك
Dialogue: 0,0:10:18.75,0:10:21.65,Default,,0,0,0,,...لكن
Dialogue: 0,0:10:21.65,0:10:23.95,Default,,0,0,0,,اسمع. في أي وقت تكون الرحلة غدًا؟
Dialogue: 0,0:10:23.95,0:10:27.25,Default,,0,0,0,,.تغادر من ناريتا في الساعة 12:30 ظهرًا
Dialogue: 0,0:10:27.25,0:10:29.25,Default,,0,0,0,,انسة ساتو؟
Dialogue: 0,0:10:29.25,0:10:30.65,Default,,0,0,0,,تاكاجي؟
Dialogue: 0,0:10:30.65,0:10:32.35,Default,,0,0,0,,أريدك أن تستمع جيدًا
Dialogue: 0,0:10:32.35,0:10:33.95,Default,,0,0,0,,.إلى ما سأقوله لك
Dialogue: 0,0:10:33.95,0:10:35.15,Top,,0,0,0,,ماذا؟
Dialogue: 0,0:10:34.08,0:10:36.89,Default,NTP,,0000,0000,0000,{\fs90\pos(900,790)} مقر شرطة العاصمة 
Dialogue: 0,0:10:35.15,0:10:37.75,Top,,0,0,0,,لا يمكنك الاتصال بتاكاجي وساتو؟
Dialogue: 0,0:10:37.75,0:10:38.85,Default,,0,0,0,,.نعم
Dialogue: 0,0:10:38.85,0:10:41.85,Default,,0,0,0,,.كنت أحاول الوصول إليهم على الهاتف الخلوي
Dialogue: 0,0:10:41.85,0:10:43.85,Default,,0,0,0,,قد يكون قد حدث لهم شيء
Dialogue: 0,0:10:43.85,0:10:45.15,Default,,0,0,0,,أثناء مطاردة المشتبه به؟
Dialogue: 0,0:10:45.15,0:10:49.15,Default,,0,0,0,,!اعثروا عليهم! لا بد أنهم ما زالوا في تلك المنطقة
Dialogue: 0,0:10:49.15,0:10:50.35,Default,,0,0,0,,.يا شيراتوري
Dialogue: 0,0:10:50.35,0:10:52.35,Default,,0,0,0,,! نحن ذاهبون أيضًا - \N .حسناً -
Dialogue: 0,0:10:53.55,0:10:55.85,Default,,0,0,0,, اقبض على القاتل الحقيقي قبل ظهر الغد؟
Dialogue: 0,0:10:55.85,0:10:58.45,Default,,0,0,0,,هل تقصدنين أنا؟
Dialogue: 0,0:10:58.45,0:10:59.95,Default,,0,0,0,,.نعم، هذا صحيح
Dialogue: 0,0:10:59.95,0:11:03.95,Default,,0,0,0,,.سأراقب هذا الرجل نيابة عنك حتى ذلك الحين
Dialogue: 0,0:11:03.95,0:11:06.05,Default,,0,0,0,,.بالإضافة إلى ذلك، لن أذهب إلى أي مكان لفترة
Dialogue: 0,0:11:06.05,0:11:08.75,Default,,0,0,0,,،حسنًا إذن. سأذهب لإحضار المفتاح
Dialogue: 0,0:11:08.75,0:11:10.45,Default,,0,0,0,,،لنأخده إلى المقر أولاً
Dialogue: 0,0:11:10.45,0:11:12.15,Default,,0,0,0,,.ثم يمكننا الذهاب معًا
Dialogue: 0,0:11:12.15,0:11:13.15,Default,,0,0,0,,.إياك
Dialogue: 0,0:11:13.15,0:11:16.55,Default,,0,0,0,,،إذا رأى أحدك في المقر تحضر المفتاح
Dialogue: 0,0:11:16.55,0:11:18.55,Default,,0,0,0,,،الرئيس سيعاقبك بشدة
Dialogue: 0,0:11:18.55,0:11:20.65,Default,,0,0,0,,،أثناء كتابتك للتقرير
Dialogue: 0,0:11:20.65,0:11:23.35,Default,,0,0,0,,.ستقلع الطائرة وسيكون الأوان قد فات
Dialogue: 0,0:11:23.35,0:11:24.35,Default,,0,0,0,,،اسمع الآن
Dialogue: 0,0:11:24.35,0:11:26.95,Default,,0,0,0,,.ما زلنا في مطاردة السجين الهارب
Dialogue: 0,0:11:26.95,0:11:28.45,Default,,0,0,0,,.هذا ما يجب أن يبدو عليه الأمر
Dialogue: 0,0:11:28.45,0:11:30.85,Default,,0,0,0,,.في هذه الأثناء، ستعمل بمفردك للعثور على القاتل الحقيقي
Dialogue: 0,0:11:30.85,0:11:32.55,Default,,0,0,0,,.هذا هو خيارنا الوحيد
Dialogue: 0,0:11:32.55,0:11:34.75,Default,,0,0,0,,إذا تمت تبرئة المشتبه به
Dialogue: 0,0:11:34.75,0:11:36.55,Default,,0,0,0,,،قبل تسليمه إلى المحكمة
Dialogue: 0,0:11:36.55,0:11:40.95,Default,,0,0,0,,.فلدى إدارة الشرطة الحق في إطلاق سراحه حسب تقديرها
Dialogue: 0,0:11:40.95,0:11:42.65,Default,,0,0,0,,...لكن
Dialogue: 0,0:11:42.65,0:11:46.05,Default,,0,0,0,,الحد الزمني هو صباح الغد
Dialogue: 0,0:11:46.05,0:11:48.15,Default,,0,0,0,,.حوالي الساعة 10 صباحًا عندما يفتح هذا المتحف
Dialogue: 0,0:11:48.15,0:11:50.35,Default,,0,0,0,,،لأنه بمجرد دخول أحدهم هنا
Dialogue: 0,0:11:50.35,0:11:53.45,Default,,0,0,0,,.سيتصل بالشرطة بالتأكيد
Dialogue: 0,0:11:53.45,0:11:56.15,Default,,0,0,0,,،سأصدقك حتى ذلك الحين
Dialogue: 0,0:11:56.15,0:11:57.85,Default,,0,0,0,,هل هذا مقبول بالنسبة لك؟
Dialogue: 0,0:11:57.85,0:11:59.55,Default,,0,0,0,,!شكرا لكم
Dialogue: 0,0:11:59.55,0:12:02.45,Default,,0,0,0,,.لكنني لا أعرف إذا كنت أستطيع فعل ذلك بمفردي
Dialogue: 0,0:12:02.45,0:12:04.35,Default,,0,0,0,,.لماذا؟ أنت لست وحدك
Dialogue: 0,0:12:04.35,0:12:07.25,Default,,0,0,0,,.هؤلاء الأطفال يبدون متحمسين للمساعدة
Dialogue: 0,0:12:17.94,0:12:18.94,Default,,0,0,0,,اذن، هل فهمتني؟
Dialogue: 0,0:12:18.94,0:12:22.24,Default,,0,0,0,,.الحد الزمني هو 10 صباحًا غدًا
Dialogue: 0,0:12:22.24,0:12:25.24,Default,,0,0,0,,لديك حتى ذلك الوقت للقبض على القاتل الحقيقي
Dialogue: 0,0:12:25.24,0:12:27.24,Default,,0,0,0,,.وإثبات براءة هذا الرجل
Dialogue: 0,0:12:28.54,0:12:31.04,Default,,0,0,0,,.لا تقلق، يمكنك فعل ذلك
Dialogue: 0,0:12:31.04,0:12:33.04,Default,,0,0,0,,.كن واثقًا من نفسك
Dialogue: 0,0:12:36.34,0:12:38.24,Default,,0,0,0,,هيا، ماذا تفعل؟
Dialogue: 0,0:12:38.24,0:12:39.44,Default,,0,0,0,,.نحن ذاهبون
Dialogue: 0,0:12:41.34,0:12:42.64,Default,,0,0,0,,.مهلا لحظة
Dialogue: 0,0:12:42.64,0:12:45.74,Default,,0,0,0,,،أعرف أن الانسة ساتو على علاقة جيدة بالمفتش ميغوري
Dialogue: 0,0:12:45.74,0:12:48.54,Default,,0,0,0,,.قالت هذا الكلام فقط لتشجعني
Dialogue: 0,0:12:50.54,0:12:53.04,Default,,0,0,0,,مزاجه يتأرجح صعودًا وهبوطًا مثل الأرجوحة.
Dialogue: 0,0:12:53.04,0:12:54.24,Default,,0,0,0,,.هذا غريب
Dialogue: 0,0:12:54.24,0:12:56.84,Default,,0,0,0,,مهلاً! ماذا تفعلون هناك بالأعلى؟
Dialogue: 0,0:12:58.74,0:13:01.04,Default,,0,0,0,,ألم تروا اللافتة هناك؟
Dialogue: 0,0:13:01.04,0:13:03.34,Default,,0,0,0,,".مكتوب عليها "ممنوع الدخول
Dialogue: 0,0:13:03.34,0:13:05.14,Default,,0,0,0,,.كانت حالة طارئة
Dialogue: 0,0:13:05.14,0:13:08.34,Default,,0,0,0,,.هذا صحيح. نحن نطارد مجرمًا
Dialogue: 0,0:13:08.34,0:13:09.84,Default,,0,0,0,,اي مجرم؟
Dialogue: 0,0:13:09.84,0:13:11.54,Default,,0,0,0,,.أنتم لستم الشرطة
Dialogue: 0,0:13:11.54,0:13:14.94,Default,,0,0,0,,...قد لا أبدو كذلك لكنني
Dialogue: 0,0:13:14.94,0:13:18.84,Default,,0,0,0,,بالطبع إذا اكتشف أحد
Dialogue: 0,0:13:18.84,0:13:20.64,Default,,0,0,0,,.أنا وهذا الرجل هنا هكذا
Dialogue: 0,0:13:20.64,0:13:22.54,Default,,0,0,0,,.فسينتهي كل شيء
Dialogue: 0,0:13:22.54,0:13:25.14,Default,,0,0,0,,،لكي يصل هذا الرجل إلى حفل زفاف ابنته
Dialogue: 0,0:13:25.14,0:13:27.74,Default,,0,0,0,,.عليك العمل بمفردك وبسرية
Dialogue: 0,0:13:29.34,0:13:30.54,Default,,0,0,0,,،آسف على ذلك
Dialogue: 0,0:13:30.54,0:13:32.34,Default,,0,0,0,,.كنا فقط نلعب دور الشرطة والمجرمين
Dialogue: 0,0:13:32.34,0:13:33.94,Default,,0,0,0,,.تبا
Dialogue: 0,0:13:33.94,0:13:36.44,Default,,0,0,0,,أتعتقدين أنه سيكون بخير؟
Dialogue: 0,0:13:36.44,0:13:37.64,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:37.64,0:13:41.64,Default,,0,0,0,,.ذلك الضابط لم يبدو موثوقًا به كثيرًا
Dialogue: 0,0:13:41.64,0:13:43.04,Default,,0,0,0,,.أنت محق تمامًا
Dialogue: 0,0:13:43.04,0:13:44.94,Default,,0,0,0,,،يبدو لطيفًا نوعًا ما وأخرق
Dialogue: 0,0:13:44.94,0:13:46.94,Default,,0,0,0,,.النوع الذي لا يمكنك إلا أن تقلق عليه
Dialogue: 0,0:13:47.94,0:13:51.14,Default,,0,0,0,,.لكنه في الحقيقة يعتمد عليه عندما يضع عقله في الأمر
Dialogue: 0,0:13:51.14,0:13:52.74,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:13:52.74,0:13:55.24,Default,,0,0,0,,...بالإضافة إلى ذلك، ذلك الطفل معه
Dialogue: 0,0:13:55.24,0:13:56.54,Default,,0,0,0,,ذلك الطفل؟
Dialogue: 0,0:13:56.54,0:13:58.74,Default,,0,0,0,,.الطفل الذي يرتدي النظارات
Dialogue: 0,0:13:58.74,0:14:02.54,Default,,0,0,0,,.بطريقة ما، ذلك الطفل يعطيني الأمل
Dialogue: 0,0:14:03.68,0:14:05.48,Default,,0,0,0,,"حانة ياما"
Dialogue: 0,0:14:06.54,0:14:07.94,Default,,0,0,0,,.هذا الخامس
Dialogue: 0,0:14:07.94,0:14:09.84,Default,,0,0,0,,.أتساءل ماذا حدث
Dialogue: 0,0:14:09.84,0:14:11.04,Default,,0,0,0,,.أخبرتك
Dialogue: 0,0:14:11.04,0:14:14.04,Default,,0,0,0,,.إنهم يبحثون عن القاتل والضابطة ساتو وأنا
Dialogue: 0,0:14:14.04,0:14:16.74,Default,,0,0,0,,.ضابط تاكاجي، تبدو مثل رجل عصابة
Dialogue: 0,0:14:16.74,0:14:19.94,Default,,0,0,0,,.ليس لدي خيار اخر، فأنا أقوم بتحقيق سري
Dialogue: 0,0:14:19.94,0:14:23.04,Default,,0,0,0,,على أي حال، يجب أن نذهب إلى تلك الحانة أولاً.
Dialogue: 0,0:14:23.04,0:14:26.34,Default,,0,0,0,,هذا حيث سنبدأ لأن السيد هيغاشيدا قال إنه توقف هناك
Dialogue: 0,0:14:26.34,0:14:28.14,Default,,0,0,0,,.قبل الجريمة مباشرة
Dialogue: 0,0:14:28.14,0:14:31.64,Default,,0,0,0,,.نعم، أتذكر. لقد كان في حالة سكر شديدة
Dialogue: 0,0:14:31.64,0:14:34.84,Default,,0,0,0,,."قال إنه سوف "يصحح لها الأمر
Dialogue: 0,0:14:34.84,0:14:39.04,Default,,0,0,0,,.لكنني لا أصدق أبدًا أنه سيقتلها
Dialogue: 0,0:14:39.04,0:14:41.74,Default,,0,0,0,,هل كان وحده عندما غادر؟
Dialogue: 0,0:14:41.74,0:14:46.04,Default,,0,0,0,,.السيد كيتاغاوا الذي كان يشرب معه أخذَه إلى المنزل
Dialogue: 0,0:14:46.04,0:14:47.94,Default,,0,0,0,,.هناك، هذا هو
Dialogue: 0,0:14:47.94,0:14:51.24,Default,,0,0,0,,.هو والسيد هيغاشيدا يعملان في نفس الشركة
Dialogue: 0,0:14:51.24,0:14:56.34,Default,,0,0,0,,.إذن هو نفسه كيتاغاوا الذي اكتشف الجثة أولاً
Dialogue: 0,0:14:56.34,0:14:57.74,Default,,0,0,0,,هو الذي اكتشف الجثة؟
Dialogue: 0,0:14:57.74,0:14:58.84,Default,,0,0,0,,.نعم
Dialogue: 0,0:14:58.84,0:15:01.74,Default,,0,0,0,,عندما لم يحضران السيد هيغاشيدا والسيدة مورانشي إلى العمل
Dialogue: 0,0:15:01.74,0:15:02.84,Default,,0,0,0,,.في صباح اليوم التالي
Dialogue: 0,0:15:02.84,0:15:05.44,Default,,0,0,0,,.جعل المالك يستخدم المفتاح الرئيسي لفتح الباب
Dialogue: 0,0:15:05.44,0:15:07.54,Default,,0,0,0,,.هكذا وجد الجثة
Dialogue: 0,0:15:11.64,0:15:13.84,Default,,0,0,0,,.سأترك المال على الطاولة
Dialogue: 0,0:15:13.84,0:15:15.94,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:15:15.94,0:15:17.74,Default,,0,0,0,,!يا سيد كيتاغاوا
Dialogue: 0,0:15:18.84,0:15:20.04,Default,,0,0,0,,.أنا من الشرطة
Dialogue: 0,0:15:20.04,0:15:22.04,Default,,0,0,0,,.لدي بعض الأسئلة لك
Dialogue: 0,0:15:22.04,0:15:24.34,Default,,0,0,0,,.لقد أخبرت الشرطة بكل شيء بالفعل
Dialogue: 0,0:15:24.34,0:15:26.14,Default,,0,0,0,,،أنا في حالة صدمة
Dialogue: 0,0:15:26.14,0:15:28.44,Default,,0,0,0,,.صديقي قتل رئيستنا
Dialogue: 0,0:15:28.44,0:15:30.94,Default,,0,0,0,,.من فضلك اتركني وشأني
Dialogue: 0,0:15:30.94,0:15:32.84,Default,,0,0,0,,.حسناً
Dialogue: 0,0:15:34.64,0:15:35.94,Default,,0,0,0,,.انه محق
Dialogue: 0,0:15:35.94,0:15:40.14,Default,,0,0,0,,.لقد تم استجوابه بالفعل من قبل الشرطة
Dialogue: 0,0:15:40.14,0:15:43.54,Default,,0,0,0,,.وكذلك صاحبة الحانة، ربما عدة مرات
Dialogue: 0,0:15:44.94,0:15:48.84,Default,,0,0,0,,هذا صحيح! السيدة مورانشي كانت معجبة بفريق طوكيو سبيريتس
Dialogue: 0,0:15:48.84,0:15:52.04,Default,,0,0,0,,والسيد هيغاشيدا كان يكره السبيريتس!
Dialogue: 0,0:15:52.04,0:15:54.34,Default,,0,0,0,,مهلاً انتم!، ما الذي تسألونها؟  
Dialogue: 0,0:15:54.34,0:15:57.14,Default,,0,0,0,,.أنا آسف جدًا، سنغادر الآن
Dialogue: 0,0:15:57.14,0:16:00.24,Default,,0,0,0,,.عليّ الاتصال بالمنزل. أمي ستقلق
Dialogue: 0,0:16:00.24,0:16:02.34,Default,,0,0,0,,.وأنا أيضًا -\N !وأنا أيضًا -
Dialogue: 0,0:16:02.34,0:16:03.44,Default,,0,0,0,,،تبا
Dialogue: 0,0:16:03.44,0:16:05.74,Default,,0,0,0,,لن أتمكن أبدًا من القبض على القاتل الحقيقي
Dialogue: 0,0:16:05.74,0:16:07.74,Default,,0,0,0,,.قبل ظهر الغد بهذا الحالة
Dialogue: 0,0:16:08.37,0:16:12.10,Default,,0,0,0,,{\fs90\pos(900,790)} منزل البروفيسور اغاسا 
Dialogue: 0,0:16:08.74,0:16:09.74,Top,,0,0,0,,ماذا؟
Dialogue: 0,0:16:09.74,0:16:13.34,Top,,0,0,0,,تريد مني أن أتظاهر أنكم جميعًا ستقضون الليل عندي؟
Dialogue: 0,0:16:13.34,0:16:15.04,Default,,0,0,0,,.لا، لا مانع لدي
Dialogue: 0,0:16:15.04,0:16:18.14,Default,,0,0,0,,.إذا كان الضابط تاكاجي معكم، فأنا لست قلقًا
Dialogue: 0,0:16:18.14,0:16:20.34,Default,,0,0,0,,.غدًا الأحد، اليوم الكبير
Dialogue: 0,0:16:20.34,0:16:21.44,Default,,0,0,0,,سأخبر والديكم فقط
Dialogue: 0,0:16:21.44,0:16:24.84,Default,,0,0,0,,.أنكم جميعًا تأتون معي إلى فعالية الغد
Dialogue: 0,0:16:24.84,0:16:27.14,Default,,0,0,0,,فعالية؟ أي فعالية؟
Dialogue: 0,0:16:27.14,0:16:31.54,Default,,0,0,0,,.غدًا هو اليوم الذي ستخدم فيه اختراعي مدينتنا
Dialogue: 0,0:16:31.54,0:16:34.24,Default,,0,0,0,,."أسميه "قوس قزح الاستوائي
Dialogue: 0,0:16:34.24,0:16:36.94,Default,,0,0,0,,.عندما ينفجر، يتوهج مثل قوس قزح
Dialogue: 0,0:16:36.94,0:16:40.34,Default,,0,0,0,,.عندما تنتهون مما تفعلونه، تعالوا لرؤيته
Dialogue: 0,0:16:40.34,0:16:41.74,Default,,0,0,0,,.ح-حسنًا
Dialogue: 0,0:16:41.74,0:16:43.94,Default,,0,0,0,,هل وافق البروفيسور أغاسا على ذلك؟
Dialogue: 0,0:16:43.94,0:16:45.74,Default,,0,0,0,,نعم، كان متحمسًا جدًا
Dialogue: 0,0:16:45.74,0:16:49.24,Default,,0,0,0,,.بخصوص عرض الألعاب النارية الذي سيقام في هايدو غدًا
Dialogue: 0,0:16:49.24,0:16:50.34,Default,,0,0,0,,ألعاب نارية؟
Dialogue: 0,0:16:50.34,0:16:52.34,Default,,0,0,0,,.لم أسمع أي شيء عن ذلك
Dialogue: 0,0:16:52.34,0:16:53.34,Default,,0,0,0,,،لا تهتم بذلك
Dialogue: 0,0:16:53.34,0:16:56.34,Default,,0,0,0,,بعد ذلك نذهب إلى شقة الضحية، أليس كذلك؟
Dialogue: 0,0:16:56.34,0:16:58.84,Default,,0,0,0,,.صحيح
Dialogue: 0,0:16:58.84,0:17:00.94,Default,,0,0,0,,الشرطة مرة أخرى؟
Dialogue: 0,0:17:00.94,0:17:04.74,Default,,0,0,0,,.الضباط الذين جاءوا في الظهيرة غادروا للتو
Dialogue: 0,0:17:04.74,0:17:05.94,Default,,0,0,0,,...حسناً، في الحقيقة
Dialogue: 0,0:17:05.94,0:17:07.74,Default,,0,0,0,,.هناك شيء نسوا فحصه
Dialogue: 0,0:17:07.74,0:17:09.94,Default,,0,0,0,,من هؤلاء الأطفال؟
Dialogue: 0,0:17:09.94,0:17:12.04,Default,,0,0,0,,.هذا مشروع دراسات اجتماعية
Dialogue: 0,0:17:12.04,0:17:13.64,Default,,0,0,0,,نختبر عمل الشرطة
Dialogue: 0,0:17:13.64,0:17:15.14,Default,,0,0,0,,.ثم نقدم تقريرًا إلى الفصل
Dialogue: 0,0:17:15.14,0:17:18.34,Default,,0,0,0,,.إذن، أنتم تدرسون الوظائف والأشخاص الذين يقومون بها
Dialogue: 0,0:17:19.64,0:17:23.34,Default,,0,0,0,,.سأعيد المفتاح إليك لاحقًا إذن
Dialogue: 0,0:17:23.34,0:17:25.24,Default,,0,0,0,,.حسنًا، شكرًا
Dialogue: 0,0:17:29.64,0:17:30.74,Default,,0,0,0,,!مهلاً لحظة
Dialogue: 0,0:17:30.74,0:17:32.54,Default,,0,0,0,,...إذا لمستو الأشياء، فإن
Dialogue: 0,0:17:32.54,0:17:34.44,Default,,0,0,0,,.لا تقلق، انظر
Dialogue: 0,0:17:34.44,0:17:37.14,Default,,0,0,0,,،بينما كنت تشتري قبعتك
Dialogue: 0,0:17:37.14,0:17:39.14,Default,,0,0,0,,.اشترينا هذه القفازات
Dialogue: 0,0:17:39.14,0:17:41.54,Default,,0,0,0,,.كونان هو من أخبرنا بذلك
Dialogue: 0,0:17:41.54,0:17:43.04,Default,,0,0,0,,...حقا
Dialogue: 0,0:17:43.04,0:17:44.34,Default,,0,0,0,,.تبا
Dialogue: 0,0:17:44.34,0:17:48.14,Default,,0,0,0,,إلى أين ذهبوا المشتبه به والضابطان ساتو وتاكاجي؟
Dialogue: 0,0:17:48.14,0:17:51.84,Default,,0,0,0,,يبدو أنه فقدنا الاتصال بهم عندما دخلوا مبنى مهجور في مدينة هايدو
Dialogue: 0,0:17:51.84,0:17:53.64,Default,,0,0,0,,.في مطاردة السجين الهارب
Dialogue: 0,0:17:53.64,0:17:56.04,Default,,0,0,0,,ألا تجد ذلك غريبًا؟
Dialogue: 0,0:17:56.04,0:17:59.94,Default,,0,0,0,,.ليس من عادة الانسة ساتو ألا تتصل لفترة طويلة
Dialogue: 0,0:17:59.94,0:18:01.54,Default,,0,0,0,,...ايعقل
Dialogue: 0,0:18:01.54,0:18:04.84,Default,,0,0,0,,.أنهم وقعوا في قبضة المشتبه به
Dialogue: 0,0:18:08.84,0:18:10.04,Default,,0,0,0,,!لا
Dialogue: 0,0:18:11.44,0:18:13.04,Default,,0,0,0,,!كيف يجرؤ
Dialogue: 0,0:18:13.04,0:18:15.74,Default,,0,0,0,,...الحقير، كيف يتعامل مع ضباطي بهذه الطريقة
Dialogue: 0,0:18:17.54,0:18:18.74,Default,,0,0,0,,الضابطة ساتو؟
Dialogue: 0,0:18:18.74,0:18:20.84,Default,,0,0,0,,ماذا؟، الضابطة ساتو تحت قبضة المشتبه به؟
Dialogue: 0,0:18:20.84,0:18:22.84,Default,,0,0,0,,الانسة ميوّا محتجزة كرهينة؟
Dialogue: 0,0:18:33.74,0:18:36.14,Default,,0,0,0,,هل أصابني الزكام؟
Dialogue: 0,0:18:36.14,0:18:39.84,Default,,0,0,0,,.أنا آسف، إنه خطئي أننا وقعنا في هذا الموقف
Dialogue: 0,0:18:39.84,0:18:40.94,Default,,0,0,0,,.لا بأس
Dialogue: 0,0:18:40.94,0:18:44.34,Default,,0,0,0,,.إذا كنا قد اعتقلناك ظلمًا، فسيتعين علينا الاعتذار لك
Dialogue: 0,0:18:44.34,0:18:47.84,Default,,0,0,0,,.بالإضافة إلى ذلك، هذا ليس لأجلك
Dialogue: 0,0:18:48.84,0:18:53.54,Default,,0,0,0,,.أنا فقط لا أريد أن تمر ابنتك بما مررت به
Dialogue: 0,0:18:53.54,0:18:57.64,Default,,0,0,0,,...فقدت والدي عندما كنت صغيرة
Dialogue: 0,0:18:57.64,0:18:59.84,Default,,0,0,0,,.هيا يا أطفال، لنعود إلى المنزل
Dialogue: 0,0:18:59.84,0:19:02.84,Default,,0,0,0,,.لن نتوصل إلى أي شيء بغض النظر عن مدى بحثنا
Dialogue: 0,0:19:02.84,0:19:04.24,Default,,0,0,0,,،رجال مختبر الجريمة كانوا هنا بالفعل
Dialogue: 0,0:19:04.24,0:19:06.74,Default,,0,0,0,,.لا توجد أي أدلة هنا
Dialogue: 0,0:19:06.74,0:19:08.64,Default,,0,0,0,,.هناك أربعة أشياء خارج المكان
Dialogue: 0,0:19:09.64,0:19:11.24,Default,,0,0,0,,،الأول هو لون الفوتون
Dialogue: 0,0:19:11.24,0:19:14.94,Default,,0,0,0,,.الملاءات، الوسادة والستارة بجانب السرير
Dialogue: 0,0:19:14.94,0:19:17.64,Default,,0,0,0,,،كل شيء من أدوات المطبخ
Dialogue: 0,0:19:17.64,0:19:20.14,Default,,0,0,0,,.إلى الأطباق وحتى الديكور بلون رمليّ
Dialogue: 0,0:19:20.14,0:19:23.24,Default,,0,0,0,,لماذا إذن فقط السرير والستارة باللون الرمادي؟
Dialogue: 0,0:19:23.24,0:19:25.64,Default,,0,0,0,,.أعتقد أنها مجرد صدفة
Dialogue: 0,0:19:25.64,0:19:30.34,Default,,0,0,0,,.ولكن كانت هناك ملاءات وستائر رملية في الخزانة
Dialogue: 0,0:19:30.34,0:19:32.94,Default,,0,0,0,,وصاحبة الحانة أخبرتنا
Dialogue: 0,0:19:32.94,0:19:35.64,Default,,0,0,0,,.أن الانسة مورانشي كانت تحب اللون الرملي كثيراً
Dialogue: 0,0:19:37.04,0:19:40.44,Default,,0,0,0,,.كما أخبرتنا أنها أحبت فريق سبيريتس
Dialogue: 0,0:19:40.44,0:19:43.74,Default,,0,0,0,,وقالت أيضاً أن السيد هيغاشيدا كان خبيراً في معدات الفيديو
Dialogue: 0,0:19:43.74,0:19:44.74,Default,,0,0,0,,.ويكره الاستحمام
Dialogue: 0,0:19:44.74,0:19:46.74,Default,,0,0,0,,وأنه عندما كان يسكر، كان ينام دائماً
Dialogue: 0,0:19:46.74,0:19:49.44,Default,,0,0,0,,.ولا يستطيع الاستيقاظ، لذلك كان يتأخر عن العمل كثيراً
Dialogue: 0,0:19:49.44,0:19:51.44,Default,,0,0,0,,لا أعتقد أنها أخبرت المحققين بذلك
Dialogue: 0,0:19:51.44,0:19:53.54,Default,,0,0,0,,.عندما استجوبوها
Dialogue: 0,0:19:53.54,0:19:56.54,Default,,0,0,0,,،عندما يتم استجواب الناس من قبل الشرطة
Dialogue: 0,0:19:56.54,0:19:58.64,Default,,0,0,0,,،يعتقد الناس أنه إذا ذكروا شيئاً غير مرتبط بالجريمة
Dialogue: 0,0:19:58.64,0:20:01.74,Default,,0,0,0,,.فسيتم توبيخهم
Dialogue: 0,0:20:01.74,0:20:04.34,Default,,0,0,0,,.لكن التوتر يجعلهم يتحدثون أحياناً
Dialogue: 0,0:20:04.34,0:20:07.94,Default,,0,0,0,,.قد لا تبدو خائفة لكني أعتقد أنها كانت كذلك
Dialogue: 0,0:20:07.94,0:20:09.54,Default,,0,0,0,,خائفة؟
Dialogue: 0,0:20:09.54,0:20:11.64,Default,,0,0,0,,الشيء الثاني هو، لماذا تم نزع هذا التقويم
Dialogue: 0,0:20:11.64,0:20:13.44,Default,,0,0,0,,عن الحائط بجانب السرير؟
Dialogue: 0,0:20:16.14,0:20:20.94,Default,,0,0,0,,.انظر، هذا تقويم فريق طوكيو سبيريتس لهذا العام، كان في الخزانة
Dialogue: 0,0:20:20.94,0:20:24.34,Default,,0,0,0,,.إنه يتطابق تماماً مع البقعة على الحائط
Dialogue: 0,0:20:24.34,0:20:27.04,Default,,0,0,0,, ربما أزالته
Dialogue: 0,0:20:27.04,0:20:29.04,Default,,0,0,0,,.لأن الفريق لم يكن يلعب جيداً مؤخراً
Dialogue: 0,0:20:29.04,0:20:30.84,Default,,0,0,0,,.لكن انظر
Dialogue: 0,0:20:30.84,0:20:35.04,Default,,0,0,0,,.جدولها الكامل حتى ديسمبر مدون عليه
Dialogue: 0,0:20:35.04,0:20:37.34,Default,,0,0,0,,.أنت محق
Dialogue: 0,0:20:37.34,0:20:38.44,Default,,0,0,0,,،الشيء الثالث هو
Dialogue: 0,0:20:38.44,0:20:41.24,Default,,0,0,0,,.هناك آثار طفيفة لتحريك الأثاث
Dialogue: 0,0:20:41.24,0:20:43.54,Default,,0,0,0,,،رجال مختبر الجريمة ذكروا ذلك أيضاً
Dialogue: 0,0:20:43.54,0:20:45.64,Default,,0,0,0,,.قالوا إنها ربما أعادت ترتيب الغرفة
Dialogue: 0,0:20:45.64,0:20:47.54,Default,,0,0,0,,لكن ألا تجده غريباً
Dialogue: 0,0:20:47.54,0:20:51.74,Default,,0,0,0,,أنها لم تلاحظ شيء ثمين كهذا
Dialogue: 0,0:20:51.74,0:20:53.04,Default,,0,0,0,,عندما حركت الخزانة؟
Dialogue: 0,0:20:54.14,0:20:55.54,Default,,0,0,0,,.إنه مجرد علبة كبريت
Dialogue: 0,0:20:55.54,0:20:56.54,Default,,0,0,0,,.افتحها
Dialogue: 0,0:20:58.44,0:21:00.74,Default,,0,0,0,,.هناك قطعة ورق بداخلها
Dialogue: 0,0:21:00.74,0:21:02.64,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:21:02.64,0:21:04.94,Default,,0,0,0,,.إنه استمارة زواجها
Dialogue: 0,0:21:04.94,0:21:07.14,Default,,0,0,0,,.كانت ستتزوج
Dialogue: 0,0:21:07.14,0:21:09.54,Default,,0,0,0,,.لكن اسم العريس غير مكتوب
Dialogue: 0,0:21:09.54,0:21:12.04,Default,,0,0,0,,.لكن ختمه موجود عليها
Dialogue: 0,0:21:12.04,0:21:14.04,Default,,0,0,0,,.الشيء الرابع هو نبات الصبار
Dialogue: 0,0:21:14.04,0:21:15.04,Default,,0,0,0,,،في يوم الجريمة
Dialogue: 0,0:21:15.04,0:21:18.04,Default,,0,0,0,,.كان المطر غزيراً منذ الصباح
Dialogue: 0,0:21:18.04,0:21:21.84,Default,,0,0,0,,هل كانت محبة للصبار تترك الأصص في الشرفة؟
Dialogue: 0,0:21:21.84,0:21:24.44,Default,,0,0,0,,ما يعني أن شخصاً آخر غير الضحية
Dialogue: 0,0:21:24.44,0:21:29.04,Default,,0,0,0,,.حرك الأشياء لسبب مجهول
Dialogue: 0,0:21:29.04,0:21:31.14,Default,,0,0,0,,.نعم، ها هو
Dialogue: 0,0:21:31.14,0:21:34.74,Default,,0,0,0,,هذا صبار الدلفين الذهبي الذي أعطتها إياه صاحبة الحانة
Dialogue: 0,0:21:34.74,0:21:36.04,Default,,0,0,0,,.في اليوم الذي قتلت فيه
Dialogue: 0,0:21:36.04,0:21:39.24,Default,,0,0,0,,.لكن الأشواك انحنت، يا لها من مأساة
Dialogue: 0,0:21:39.24,0:21:42.14,Default,,0,0,0,,لكن ماذا يثبت ذلك؟ 
Dialogue: 0,0:21:42.14,0:21:44.04,Default,,0,0,0,,المشتبه به، السيد هيغاشيدا
Dialogue: 0,0:21:44.04,0:21:47.64,Default,,0,0,0,,وجد نائماً على السرير في هذه الغرفة
Dialogue: 0,0:21:47.64,0:21:49.94,Default,,0,0,0,,.ممتداً كأنه في بيته
Dialogue: 0,0:21:49.94,0:21:51.94,Default,,0,0,0,,،بصماته وجدت ليس فقط على سلك الفيديو
Dialogue: 0,0:21:51.94,0:21:53.54,Default,,0,0,0,,،الذي كان أداة الجريمة
Dialogue: 0,0:21:53.54,0:21:58.64,Default,,0,0,0,,.بل أيضاً على قفل الباب وحتى سلسلة الباب
Dialogue: 0,0:21:59.74,0:22:01.24,Default,,0,0,0,,...ايعقل
Dialogue: 0,0:22:01.24,0:22:02.84,Default,,0,0,0,,أتقصد، هذه الغرفة؟
Dialogue: 0,0:22:02.84,0:22:05.34,Default,,0,0,0,,هل نذهب لنتحقق إذن؟
Dialogue: 0,0:22:05.34,0:22:08.54,Default,,0,0,0,,شقته في هذا المبنى أيضاً، أليس كذلك؟
Dialogue: 0,0:22:10.54,0:22:11.54,Default,,0,0,0,, .لنذهب
Dialogue: 0,0:22:35.31,0:22:40.23,DCEnding,,0,0,0,,سحر بلا حدود، المكان الأصيل
Dialogue: 0,0:22:40.69,0:22:45.44,DCEnding,,0,0,0,,سحر بلا حدود، هل للحب معنى واضح؟
Dialogue: 0,0:22:46.12,0:22:51.13,DCEnding,,0,0,0,,وسط عتمة باردة، أبحث بشدة عن ذرة دفء
Dialogue: 0,0:22:51.45,0:22:57.25,DCEnding,,0,0,0,,يوماً ما، لا بد أن تحدث معجزة
Dialogue: 0,0:22:59.76,0:23:09.85,DCEnding,,0,0,0,,سحر بلا حدود، لو كان للحب وجود، فلابد أنه على هيئة دائرة
Dialogue: 0,0:23:10.68,0:23:20.77,DCEnding,,0,0,0,,سحر بلا حدود، بين أصابعي المرتجفة تولد صرختي الأولى
Dialogue: 0,0:23:21.34,0:23:29.27,DCEnding,,0,0,0,,حتى بدافع الغرور، فهذا تجاوز غير معقول
Dialogue: 0,0:23:29.80,0:23:34.68,DCEnding,,0,0,0,,سحر بلا حدود، يكفيه أن يُلامس قلبًا فيه قليل من الشجاعة
Dialogue: 0,0:23:35.22,0:23:45.98,DCEnding,,0,0,0,,سحر بلا حدود، فلنتحد جميعًا ونكبر سويًا
