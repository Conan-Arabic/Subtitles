Dialogue: 0,0:00:01.03,0:00:04.54,Narration,,0,0,0,,{\blur2.6}!المواجهات غامضةٌ و لكن القضايا أكثر غموضاً
Dialogue: 0,0:00:04.54,0:00:06.54,Narration,,0,0,0,,{\blur2.6}!أنا حقاً مسرورٌ لتواجدي معك
Dialogue: 0,0:00:06.54,0:00:08.38,Narration,,0,0,0,,{\blur2.6}كيف سيبدو مذاق المشروب اليوم؟
Dialogue: 0,0:00:08.38,0:00:10.15,Narration,,0,0,0,,{\blur2.6}!لا تحكم على شيءٍ ما من خلال اسمه
Dialogue: 0,0:00:10.15,0:00:11.95,Narration,,0,0,0,,{\blur2.6}يرى الحقيقة واحدة كما هي
Dialogue: 0,0:00:11.95,0:00:13.90,Narration,,0,0,0,,{\blur2.6}يبدو كطفل صغير و لكنه بعقل كبير
Dialogue: 0,0:00:13.90,0:00:16.23,Narration,,0,0,0,,{\blur2.6}!و اسمه هو، المحقق كونان
Dialogue: 0,0:01:50.81,0:01:56.85,Title,,0,0,0,,{\pos(449,200)}جريمة قتل نَخب الوداع
Dialogue: 0,0:01:57.70,0:02:00.08,Default,,0,0,0,,أنا لا أفهم
Dialogue: 0,0:02:00.08,0:02:02.65,Default,,0,0,0,,لماذا نحن مدعوون أيضاً؟
Dialogue: 0,0:02:02.65,0:02:03.45,Default,,0,0,0,,!لا أعرف
Dialogue: 0,0:02:03.45,0:02:04.72,Default,,0,0,0,,أحقاً لا يهمك هذا؟
Dialogue: 0,0:02:04.72,0:02:06.26,Default,,0,0,0,,!بالطبع لا
Dialogue: 0,0:02:06.26,0:02:11.80,Default,,0,0,0,,قد يكون كوتارو إيتشيواكا الرئيس التنفيذي لشركات إيتشيواكا
Dialogue: 0,0:02:11.22,0:02:14.18,Default,,0,0,0,,{\a6}"مصانع إيتشيواكا"
Dialogue: 0,0:02:11.80,0:02:14.47,Default,,0,0,0,,و لكنه مخادعٌ بغيضٌ أيضاً
Dialogue: 0,0:02:14.47,0:02:17.14,Default,,0,0,0,,أشك إن كان يريد مني عملاً نظيفاً
Dialogue: 0,0:02:17.14,0:02:19.28,Default,,0,0,0,,إذاً لِمَ لم ترفض طلبه؟
Dialogue: 0,0:02:19.28,0:02:22.46,Default,,0,0,0,,!الكبار لديهم مسائلهم الخاصة ليعتنوا بها
Dialogue: 0,0:02:22.46,0:02:24.33,Thoughts,,0,0,0,,{\blur2.6}!نعم هذا صحيح
Dialogue: 0,0:02:24.33,0:02:27.63,Thoughts,,0,0,0,,{\blur2.6}لم يأته أي عمل منذ وقتٍ طويل
Dialogue: 0,0:02:34.65,0:02:36.75,Default,,0,0,0,,السيد موري أليس كذلك؟
Dialogue: 0,0:02:36.75,0:02:38.42,Default,,0,0,0,,نعم
Dialogue: 0,0:02:38.42,0:02:40.30,Default,,0,0,0,,لقد كنا ننتظر وصولك
Dialogue: 0,0:02:40.30,0:02:41.63,Default,,0,0,0,,تفضلوا
Dialogue: 0,0:02:45.60,0:02:48.14,Default,,0,0,0,,هل تقيمون حفلةً ما؟
Dialogue: 0,0:02:48.14,0:02:53.08,Default,,0,0,0,,لدى الرئيس اجتماعٌ عائلي كل سنة بمناسبة عيد ميلاده
Dialogue: 0,0:02:58.32,0:03:00.77,Default,,0,0,0,,السيد موري قد وصل لرؤيتك
Dialogue: 0,0:03:00.77,0:03:02.07,Default,,0,0,0,,ادخلوا
Dialogue: 0,0:03:04.77,0:03:07.00,Default,,0,0,0,,هذا هو إيتشيواكا، مالك هذا المنزل
Dialogue: 0,0:03:08.04,0:03:09.92,Default,,0,0,0,,شكراً لك على مجيئك
Dialogue: 0,0:03:09.92,0:03:14.06,Default,,0,0,0,,فقد لأخذ علمك، أنا لم أقرر بعد فيما إن كنت أريد مساعدتك
Dialogue: 0,0:03:14.06,0:03:15.23,Default,,0,0,0,,..إيمامورا
Dialogue: 0,0:03:15.14,0:03:17.26,RMLyrics,,0,0,0,,{\p1\pos(769,414)}m 0 0 l -29 0 l -29 11 l 0 11{\p0}
Dialogue: 0,0:03:15.14,0:03:17.26,CharCard,,0,0,0,,{\pos(404,524)}(توشياكي إيمامورا (٥٥\Nخادم عائلة إيتشيواكا
Dialogue: 0,0:03:20.88,0:03:22.28,Default,,0,0,0,,مئة ألف ين!؟
Dialogue: 0,0:03:22.28,0:03:26.54,Default,,0,0,0,,!!لابد أنك تمارس مزحةً رخيصةً ما مع العظيم موري كوغورو
Dialogue: 0,0:03:28.92,0:03:30.70,Default,,0,0,0,,عمي؟
Dialogue: 0,0:03:30.70,0:03:31.63,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:03:31.63,0:03:33.29,Default,,0,0,0,,إنها ليست مئة ألف ين
Dialogue: 0,0:03:34.03,0:03:34.70,Default,,0,0,0,,أترى؟
Dialogue: 0,0:03:34.70,0:03:38.64,Default,,0,0,0,,..واحد، عشرة، مئة، ألف، عشرة آلاف، مئة ألف
Dialogue: 0,0:03:39.57,0:03:41.82,Default,,0,0,0,,مليون ين!!؟
Dialogue: 0,0:03:41.65,0:03:45.41,RMLyrics2,,0,0,0,,{\p1\pos(793,412)}m 0 0 l -29 0 l -29 11 l 0 11{\p0}
Dialogue: 0,0:03:41.65,0:03:45.41,CharCard,,0,0,0,,{\pos(406,510)\fs38\b1}(كوتارو إيتشيواكا (٦٥\Nرئيس شركة إيتشيواكا التنفيذي
Dialogue: 0,0:03:41.82,0:03:45.41,Default,,0,0,0,,قمت بتجهيز مليون ين اخرى لك إذا أتممت عملك
Dialogue: 0,0:03:47.59,0:03:50.30,Default,,0,0,0,,إذاً.. كيف يمكنني مساعدتك؟
Dialogue: 0,0:03:50.30,0:03:52.14,Thoughts,,0,0,0,,{\blur2.6}..تباً
Dialogue: 0,0:03:52.14,0:03:56.97,Default,,0,0,0,,ابنتاي سوف تحضران اجتماع العائلة اليوم
Dialogue: 0,0:03:58.54,0:04:03.89,Default,,0,0,0,,أريدك أن تراقب ماذا يفعلون و ماذا سيحاولون أن يفعلوا
Dialogue: 0,0:04:05.29,0:04:07.23,Default,,0,0,0,,المعذرة.. هل يجب أن أغادر؟
Dialogue: 0,0:04:07.23,0:04:11.71,Default,,0,0,0,,كلا، لا مشكلة، يمكنك شرح وضعي الصحي لهم
Dialogue: 0,0:04:11.71,0:04:12.78,Default,,0,0,0,,حسناً
Dialogue: 0,0:04:12.17,0:04:16.93,TLLyrics2,,0,0,0,,{\p1\pos(735,552)}m 0 0 l -29 0 l -29 11 l 0 11{\p0}
Dialogue: 0,0:04:12.17,0:04:16.93,CharCard,,0,0,0,,{\pos(406,524)} (هيتشوي أوكانو (٣٠\Nطبيب كوتارو الفيزيائي
Dialogue: 0,0:04:12.78,0:04:17.38,Default,,0,0,0,,{\pos(414,638)}إذا استمر في إرهاق نفسه لن يكون هناك ضمانٌ بأنه سيعيش أكثر
Dialogue: 0,0:04:17.38,0:04:23.60,Default,,0,0,0,,لذلك أفكر في التقاعد الآن، و لكنني أحتاج أن أختار خليفةً لي
Dialogue: 0,0:04:23.60,0:04:27.10,Default,,0,0,0,,ستكون إحدى بناتك الإثنتين صحيح؟
Dialogue: 0,0:04:27.10,0:04:28.77,Default,,0,0,0,,ليس بالضرورة
Dialogue: 0,0:04:28.77,0:04:32.35,Default,,0,0,0,,ليس لدي نوايا بمشاركة ثروتي مع أناسٍ جشعين و فظّين
Dialogue: 0,0:04:32.35,0:04:34.55,Default,,0,0,0,,و قد يشمل هذا أولادي
Dialogue: 0,0:04:34.55,0:04:39.66,Default,,0,0,0,,و مع هذا، الوراثة تخضع لإجراءات قانونية آمنة
Dialogue: 0,0:04:39.66,0:04:43.84,Default,,0,0,0,,أولادك سيأخذون نسبةً منها مهما حصل
Dialogue: 0,0:04:43.84,0:04:48.87,Default,,0,0,0,,و لكن ليس إن كان هناك مشكلة مع الذي سيأخذها
Dialogue: 0,0:04:49.99,0:04:51.05,Default,,0,0,0,,مشكلة!؟
Dialogue: 0,0:04:53.16,0:04:58.36,Default,,0,0,0,,هناك شيءٌ ما سيحدث، شيءٌ.. أستطيع الشعور به
Dialogue: 0,0:04:58.36,0:05:00.34,Default,,0,0,0,,شيءٌ ما؟
Dialogue: 0,0:05:00.34,0:05:04.21,Default,,0,0,0,,أخبرت الجميع بأنك صديقي، و أنك هنا مع عائلتك
Dialogue: 0,0:05:04.21,0:05:08.15,Default,,0,0,0,,انتبه أن لا ينكشف أمرك أثناء عملك
Dialogue: 0,0:05:08.15,0:05:09.42,Default,,0,0,0,,حسناً
Dialogue: 0,0:05:09.42,0:05:12.57,Thoughts,,0,0,0,,{\blur2.6}إذاً أنا و ران للتمويه فقط؟
Dialogue: 0,0:05:12.57,0:05:16.16,Thoughts,,0,0,0,,{\blur2.6}و مع هذا، يالا فظاعة هذا الرجل
Dialogue: 0,0:05:25.82,0:05:27.29,Default,,0,0,0,,!بصحتك
Dialogue: 0,0:05:28.32,0:05:33.07,Default,,0,0,0,,سيد موري، هناك توجد السيدة كازوي، الإبنة الأكبر
Dialogue: 0,0:05:33.07,0:05:36.20,Default,,0,0,0,,إنها حالياً تدير متحفاً فنياً
Dialogue: 0,0:05:38.71,0:05:40.82,Default,,0,0,0,,إيمامورا، من يكون هذا؟
Dialogue: 0,0:05:40.82,0:05:44.96,Default,,0,0,0,,نعم، هذا السيد موري، إحدى أصدقاء والدك
Dialogue: 0,0:05:44.96,0:05:46.30,Default,,0,0,0,,كيف حالكِ؟
Dialogue: 0,0:05:46.30,0:05:48.56,Default,,0,0,0,,صديق والدي؟
Dialogue: 0,0:05:46.73,0:05:52.75,RMLyrics2,,0,0,0,,{\p1\pos(793,412)}m 0 0 l -29 0 l -29 11 l 0 11{\p0}
Dialogue: 0,0:05:46.73,0:05:52.75,CharCard,,0,0,0,,{\fs52\b1\pos(404,534)}(كازوي إيتشيواكا (٣٠\Nالإبنة الأكبر
Dialogue: 0,0:05:48.56,0:05:53.05,Default,,0,0,0,,أليس هذا مزعجاً، أن تكون مجبراً على حضور اجتماع كهذا؟
Dialogue: 0,0:05:53.05,0:05:56.98,Default,,0,0,0,,..كلا، على الإطلاق! لقد أتيت مع عائلتي
Dialogue: 0,0:05:56.98,0:05:58.58,Default,,0,0,0,,!و نحن نستمتع بوقتنا
Dialogue: 0,0:05:58.58,0:06:00.76,Default,,0,0,0,,!اختي
Dialogue: 0,0:06:00.76,0:06:03.50,Default,,0,0,0,,لم أعتقد أنك ستأتين حقاً
Dialogue: 0,0:06:03.50,0:06:06.60,Default,,0,0,0,,بالطبع سأحضر
Dialogue: 0,0:06:06.60,0:06:09.61,Default,,0,0,0,,سأكون ثاني من يقود عائلة إيتشيواكا
Dialogue: 0,0:06:09.61,0:06:14.02,Default,,0,0,0,,أشك.. بأن والدي سيعطيكي كل شيء بطريقةٍ أو بأخرى
Dialogue: 0,0:06:09.61,0:06:14.12,RMLyrics2,,0,0,0,,{\p1\pos(793,417)}m 0 0 l -29 0 l -29 11 l 0 11{\p0}
Dialogue: 0,0:06:09.61,0:06:14.12,CharCard,,0,0,0,,{\pos(404,532)\fnAl-Jazeera-Arabic-Bold\fs52\b1}(ميزوي إيتشيواكا (٢٧\Nالإبنة الثانية
Dialogue: 0,0:06:14.02,0:06:19.16,Default,,0,0,0,,لقد تصرفتي بأنانية و غادرتي المنزل بعد أن تشاجرتي معه
Dialogue: 0,0:06:19.16,0:06:20.57,Default,,0,0,0,,و من أنتي لتقولي هذا؟
Dialogue: 0,0:06:20.57,0:06:25.78,Default,,0,0,0,,لقد تزوجتي حين سمحت الفرصة لأنكِ سئمتي من رؤية وجهه كل يوم
Dialogue: 0,0:06:25.78,0:06:30.12,Default,,0,0,0,,بالمناسبة، سمعت أنه تم رفع دعوى قضائية على متحفك
Dialogue: 0,0:06:30.12,0:06:33.13,Default,,0,0,0,,لبيعه تحفاً مزيفة أو شيءٌ كهذا
Dialogue: 0,0:06:33.13,0:06:34.35,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:06:35.80,0:06:37.93,Thoughts,,0,0,0,,{\blur2.6}..كلاهما أسوأ من الآخر
Dialogue: 0,0:06:37.93,0:06:42.27,Default,,0,0,0,,"كلتا الإبنتين لديهما شخصياتٌ فظيعة"
Dialogue: 0,0:07:00.26,0:07:03.09,TLLyrics,,0,0,0,,{\p1\pos(670,564)}m 0 0 l -29 0 l -29 11 l 0 11{\p0}
Dialogue: 0,0:07:00.26,0:07:03.09,CharCard,,0,0,0,,{\i0\fs50\b1\pos(400,528)}مخزن المشروبات
Dialogue: 0,0:07:03.92,0:07:05.32,Thoughts,,0,0,0,,{\blur2.6}إنها السيدة كازوي
Dialogue: 0,0:07:12.51,0:07:15.34,Thoughts,,0,0,0,,{\blur2.6}إبرة! ما الذي تخطط لفعله!؟
Dialogue: 0,0:07:18.81,0:07:19.81,Thoughts,,0,0,0,,{\blur2.6}ماذا في داخلها!؟
Dialogue: 0,0:07:23.56,0:07:24.96,Thoughts,,0,0,0,,{\blur2.6}تباً
Dialogue: 0,0:07:24.96,0:07:27.16,Thoughts,,0,0,0,,{\blur2.6}كلوروفورم
Dialogue: 0,0:07:31.71,0:07:34.47,Default,,0,0,0,,إلى أين من الممكن أن يكون كونان قد ذهب؟
Dialogue: 0,0:07:36.78,0:07:42.00,Default,,0,0,0,,أشكركم على اجتماعكم هنا في حفلة مولدي
Dialogue: 0,0:07:42.00,0:07:45.73,Default,,0,0,0,,أريد أن أتخلى عن منصبي  كرئيس شركةٍ قريباً جداً
Dialogue: 0,0:07:45.73,0:07:47.83,Default,,0,0,0,,بمعنى آخر، لقد تقاعدت
Dialogue: 0,0:07:49.71,0:07:55.32,Default,,0,0,0,,لذلك، قررت أن بيع كل بضاعتي و حقوق أملاكي
Dialogue: 0,0:07:55.32,0:07:57.69,Default,,0,0,0,,لشركة نيتشيوري
Dialogue: 0,0:07:57.69,0:07:59.87,Default,,0,0,0,,- ماذا!؟\N- هل أنت جاد!؟
Dialogue: 0,0:07:59.87,0:08:03.74,Default,,0,0,0,,سيدي! ما الذي سيحصل لنا إذاً!؟
Dialogue: 0,0:08:04.77,0:08:07.08,Default,,0,0,0,,إن أردتم البقاء في الشركة
Dialogue: 0,0:08:07.08,0:08:10.32,Default,,0,0,0,,سيتوجّب عليكم إثبات مهاراتكم للإدارة الجديدة
Dialogue: 0,0:08:10.32,0:08:11.99,Default,,0,0,0,,هل أنت جادٌّ بهذا!؟؟
Dialogue: 0,0:08:11.99,0:08:15.79,Default,,0,0,0,,ما الذي ستفعله بالأموال التي ستجنيها من بيع الشركة!؟
Dialogue: 0,0:08:15.79,0:08:18.30,Default,,0,0,0,,أنا حرٌّ في التصرف بالمبلغ
Dialogue: 0,0:08:18.30,0:08:21.58,Default,,0,0,0,,ليس لدي نيّةٌ بأن أعطي يناً واحداً لأيٍّ منكم
Dialogue: 0,0:08:21.58,0:08:23.35,Default,,0,0,0,,ولا حتى لبناتي
Dialogue: 0,0:08:29.18,0:08:32.32,Thoughts,,0,0,0,,{\blur2.6}!اللعنة! لم أتوخى الحذر، يجب أن أُسرع
Dialogue: 0,0:08:33.87,0:08:37.14,Thoughts,,0,0,0,,{\blur2.6}على الأغلب أن الذي دسّته في المشروب كان سم
Dialogue: 0,0:08:37.14,0:08:39.30,Thoughts,,0,0,0,,{\blur2.6}كيف تخطط لاستعماله!؟
Dialogue: 0,0:08:40.92,0:08:44.52,Default,,0,0,0,,أنا لن أوافق على قرارك يا أبي
Dialogue: 0,0:08:44.52,0:08:46.19,Default,,0,0,0,,ولا أنا أيضاً
Dialogue: 0,0:08:46.19,0:08:52.30,Default,,0,0,0,,أحضرت مشروباً عمره 57 عاماً للاحتفال بهذه المرحلة الجديدة من حياتك يا أبي
Dialogue: 0,0:08:52.30,0:08:57.18,Default,,0,0,0,,تصبح قيمة المشروب أكبر بكثير عندما يشربه شخصٌ مثلك يا أبي
Dialogue: 0,0:08:57.18,0:09:02.68,Default,,0,0,0,,سأشعر بالحزن على المشروب إذا قام بشربه أُناسٌ لا يعرفون عنه شيئاً مثلنا
Dialogue: 0,0:09:04.33,0:09:05.42,Default,,0,0,0,,تفضل
Dialogue: 0,0:09:07.30,0:09:09.63,Default,,0,0,0,,إنها محترمةٌ جداً أكثر مما توقعت
Dialogue: 0,0:09:09.63,0:09:12.28,Default,,0,0,0,,لم أرى كونان-كن منذ مدة
Dialogue: 0,0:09:19.83,0:09:21.06,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:09:22.26,0:09:23.36,Default,,0,0,0,,!ممتاز
Dialogue: 0,0:09:28.90,0:09:30.15,Default,,0,0,0,,!نجحت
Dialogue: 0,0:09:48.78,0:09:50.12,Default,,0,0,0,,ما الذي حدث للسيد إيتشيواكا!؟
Dialogue: 0,0:09:50.12,0:09:51.75,Default,,0,0,0,,لقد انهار فجأةً
Dialogue: 0,0:09:56.96,0:09:58.12,Default,,0,0,0,,!أيها الرئيس
Dialogue: 0,0:10:01.51,0:10:02.77,Default,,0,0,0,,ماذا حصل!؟
Dialogue: 0,0:10:09.49,0:10:11.43,Default,,0,0,0,,- أبي\N- سيدي
Dialogue: 0,0:10:12.30,0:10:14.10,Default,,0,0,0,,!اتصلوا بالشرطة
Dialogue: 0,0:10:14.83,0:10:19.07,Default,,0,0,0,,إنه موت غير طبيعي حتى الآن\Nتحقيقات الشرطة ضرورية
Dialogue: 0,0:10:28.32,0:10:29.69,Thoughts,,0,0,0,,{\blur2.6}كأس!؟
Dialogue: 0,0:10:29.69,0:10:34.14,Default,,0,0,0,,إذاً، لقد انهار مباشرةً بعد أن شرب المشروب؟
Dialogue: 0,0:10:34.14,0:10:35.14,Default,,0,0,0,,نعم
Dialogue: 0,0:10:35.14,0:10:37.34,Default,,0,0,0,,!!لقد قُتِل
Dialogue: 0,0:10:37.34,0:10:42.26,Default,,0,0,0,,!صحيح أن لديه ضعفاً بالقلب، و لكن كأسٌ واحدٌ من الشراب لا يمكنه قتله
Dialogue: 0,0:10:42.26,0:10:44.46,Default,,0,0,0,,!كان هناك سمٌ في الشراب
Dialogue: 0,0:10:44.46,0:10:48.73,Default,,0,0,0,,ماذا قلتي!؟ هل تقصدين أنني سممته!؟
Dialogue: 0,0:10:48.73,0:10:50.57,Default,,0,0,0,,!!هذه الإحتمالية الوحيدة
Dialogue: 0,0:10:50.57,0:10:51.74,Default,,0,0,0,,!!أنتي فظيعة
Dialogue: 0,0:10:51.74,0:10:53.85,Default,,0,0,0,,هل لديكَ دليلٌ على ادعائك؟
Dialogue: 0,0:10:53.85,0:10:57.75,Default,,0,0,0,,!يعلم الطبيب أوكانو حالة والدنا
Dialogue: 0,0:10:57.75,0:11:01.56,Default,,0,0,0,,صحيحٌ أن لديه صعفاً في القلب
Dialogue: 0,0:11:01.56,0:11:03.97,Default,,0,0,0,,و لكن تعرضه للنوبات المفاجئة أمرٌ مستبعد
Dialogue: 0,0:11:03.97,0:11:05.43,Default,,0,0,0,,!أترين
Dialogue: 0,0:11:05.43,0:11:07.14,Default,,0,0,0,,هل ما زلتِ تقولين بأنها كانت أنا!؟
Dialogue: 0,0:11:07.14,0:11:12.48,Default,,0,0,0,,اعذريني على السؤال، هل يمكننا أن نفتش ممتلكاتك؟
Dialogue: 0,0:11:21.40,0:11:25.24,Default,,0,0,0,,استاذ أوكانو، هل يمكنك إخباري ماذا يوجد داخل هذه الإبرة؟
Dialogue: 0,0:11:26.81,0:11:29.18,Default,,0,0,0,,يبدو بأنه مرخي عضلي
Dialogue: 0,0:11:29.18,0:11:33.86,Default,,0,0,0,,ما الذي سيحدث لو تعاطى هذا السيد إيتشيواكا؟
Dialogue: 0,0:11:33.86,0:11:37.06,Default,,0,0,0,,إنه خطيرٌ جداً حتى على ذوو الصحة الجيدة
Dialogue: 0,0:11:37.06,0:11:40.27,Default,,0,0,0,,..و باستخدامها على الرئيس الذي يعاني من مرضٍ في القلب
Dialogue: 0,0:11:44.31,0:11:48.12,Thoughts,,0,0,0,,{\blur2.6}ليس هناك شك بأنها هي من وضعت السم في المشروب
Dialogue: 0,0:11:48.12,0:11:51.46,Thoughts,,0,0,0,,{\blur2.6}و لكن من الذي هاجمني!؟
Dialogue: 0,0:12:02.14,0:12:05.74,Default,,0,0,0,,هل لديكِ أي فكرةٍ عن الدافع لفعلة السيدة كازومي؟
Dialogue: 0,0:12:05.74,0:12:09.49,Default,,0,0,0,,متحفها الفني كان متراكماً بالديون
Dialogue: 0,0:12:09.49,0:12:11.83,Default,,0,0,0,,لذلك من الممكن أنها كانت تريد أخذ إرثه
Dialogue: 0,0:12:11.83,0:12:16.88,Default,,0,0,0,,لقد قال السيد إيتشيواكا بأنه لن يترك ين واحد حتى لبناته
Dialogue: 0,0:12:16.88,0:12:18.24,Default,,0,0,0,,كم هي غبية
Dialogue: 0,0:12:18.24,0:12:21.58,Default,,0,0,0,,كان بإمكاننا الحصول على إرثنا قانونياً مهما حصل
Dialogue: 0,0:12:21.58,0:12:25.08,Default,,0,0,0,,حتى لو عارضَ هذا، سيكون بوسعنا الحصول على نسبةٍ منه
Dialogue: 0,0:12:25.08,0:12:28.00,Thoughts,,0,0,0,,{\blur2.6}هل قامت الأخت الصغيرة بمهاجمتي!؟
Dialogue: 0,0:12:28.00,0:12:29.67,Thoughts,,0,0,0,,{\blur2.6}إن كانت تعلم بخطة اختها
Dialogue: 0,0:12:29.67,0:12:33.57,Thoughts,,0,0,0,,{\blur2.6}و أقفلت عليّ الباب لأبقى بعيداً عن مخططها
Dialogue: 0,0:12:36.41,0:12:38.65,Thoughts,,0,0,0,,{\blur2.6}إذا تم إدانة الأخت الكبرى
Dialogue: 0,0:12:38.65,0:12:40.74,Thoughts,,0,0,0,,{\blur2.6}!سيكون كامل الإرث لها وحدها فقط
Dialogue: 0,0:12:45.66,0:12:48.43,Thoughts,,0,0,0,,{\blur2.6}مفتاحٌ بلا حلقة!؟
Dialogue: 0,0:12:51.34,0:12:53.47,Default,,0,0,0,,لأي غرفة هذا المفتاح؟
Dialogue: 0,0:12:54.31,0:12:56.79,Default,,0,0,0,,أعتقد أنه مفتاح القبو
Dialogue: 0,0:12:56.79,0:13:00.69,Default,,0,0,0,,هذا غريب، السيد تقريباً لا يدخل إلاّ نادراً إلى القبو
Dialogue: 0,0:13:03.90,0:13:05.23,Thoughts,,0,0,0,,{\blur2.6}أيعقل!؟
Dialogue: 0,0:13:05.23,0:13:09.04,Thoughts,,0,0,0,,{\blur2.6}هل كان الضحية السيد إيتشيواكا من رماني في القبو!؟
Dialogue: 0,0:13:10.81,0:13:15.78,Thoughts,,0,0,0,,{\blur2.6}إن كان هذا صحيحاً، هذا يعني أنه كان يعلم\N!!بأمر المشروب المسمم حين شربه
Dialogue: 0,0:13:15.78,0:13:17.42,Thoughts,,0,0,0,,{\blur2.6}هذا هراء
Dialogue: 0,0:13:31.72,0:13:33.92,Thoughts,,0,0,0,,{\blur2.6}عدسات كاميرا فيديو
Dialogue: 0,0:13:34.66,0:13:36.62,Thoughts,,0,0,0,,{\blur2.6}السلك متجه نحو السقف
Dialogue: 0,0:13:52.69,0:13:56.06,Thoughts,,0,0,0,,{\blur2.6}هل كانت لتصوير الشخص الذي قتله!؟
Dialogue: 0,0:14:22.22,0:14:26.45,Thoughts,,0,0,0,,{\blur2.6}هذه الرائحة.. بالفعل السيد إيتشيواكا لم يحتسي المشروب المسمم
Dialogue: 0,0:14:27.77,0:14:31.94,Thoughts,,0,0,0,,{\blur2.6}كان يعلم بأن ابنته الكبيرة السيدة كازوي قامت بتسميم المشروب
Dialogue: 0,0:14:31.94,0:14:34.64,Thoughts,,0,0,0,,{\blur2.6}لذلك قام بسكبه في حوض الزرع هذا
Dialogue: 0,0:14:34.64,0:14:38.22,Thoughts,,0,0,0,,{\blur2.6}ثم تظاهر بأنه شرب منه و سقط على الأرض
Dialogue: 0,0:14:38.22,0:14:41.09,Thoughts,,0,0,0,,{\blur2.6}ليرى ردة فعل ابنتيه
Dialogue: 0,0:14:42.19,0:14:46.60,Thoughts,,0,0,0,,{\blur2.6}و لكن ليس هناك شك بأنه تعرض للتسمم
Dialogue: 0,0:14:46.60,0:14:49.94,Thoughts,,0,0,0,,{\blur2.6}أنا لا أفهم!! كيف تجرّع السم!؟
Dialogue: 0,0:14:52.55,0:14:54.68,Thoughts,,0,0,0,,{\blur2.6}تباً.. إنه يجول في كل مكان
Dialogue: 0,0:14:59.30,0:15:04.93,Thoughts,,0,0,0,,{\blur2.6}ربما أعطوه السم بكبسولةٍ ما أو بشيءٍ آخر غير المشروب؟
Dialogue: 0,0:15:05.57,0:15:09.14,Thoughts,,0,0,0,,{\blur2.6}كلا، الوقت غير كافٍ لهذا
Dialogue: 0,0:15:10.25,0:15:11.39,Thoughts,,0,0,0,,{\blur2.6}لا فائدة
Dialogue: 0,0:15:11.39,0:15:14.65,Thoughts,,0,0,0,,{\blur2.6}لا يمكن لأحد أن يقوم بإعطائه السم أمام أعين الجميع
Dialogue: 0,0:15:16.46,0:15:18.46,Thoughts,,0,0,0,,{\blur2.6}إعطائه!؟
Dialogue: 0,0:15:19.44,0:15:24.24,Default,,0,0,0,,!صحيح! من يمكنه فعل ذلك هو ذاك الشخص فقط
Dialogue: 0,0:15:26.82,0:15:30.86,Default,,0,0,0,,أيها الطفل!! ما الذي تفعله في مكانٍ كهذا!؟؟
Dialogue: 0,0:15:30.86,0:15:32.12,Default,,0,0,0,,ماذا؟؟
Dialogue: 0,0:15:40.01,0:15:41.25,Thoughts,,0,0,0,,{\blur2.6}و الآن إذاً
Dialogue: 0,0:15:41.25,0:15:45.52,Default,,0,0,0,,..أنا طبيبٌ مثير للشفقة.. لم أستطع أن أنقذ حياة الرئيس
Dialogue: 0,0:15:45.52,0:15:49.00,Default,,0,0,0,,!لا تقل هذا! إنها ليست غلطتك
Dialogue: 0,0:15:49.00,0:15:52.13,Default,,0,0,0,,آسفٌ لجعلكم تنتظرون هكذا
Dialogue: 0,0:15:52.13,0:15:55.47,Default,,0,0,0,,لقد قمت أخيراً باكتشاف حقيقة ما حصل وراء هذه الحادثة
Dialogue: 0,0:15:55.47,0:15:58.38,Default,,0,0,0,,لذلك رجاءً اجتمعوا جميعاً في غرفة المكتب
Dialogue: 0,0:16:03.39,0:16:06.59,Default,,0,0,0,,\Nما الذي تعنيه بكلمة "الحقيقة" يا موري؟
Dialogue: 0,0:16:06.59,0:16:11.94,Default,,0,0,0,,بالفعل ليس لدي شك بأن السيدة كازوي سممت المشروب
Dialogue: 0,0:16:13.51,0:16:17.82,Default,,0,0,0,,على أي حال السيد إيتشيواكا لم يقم بشربه على الإطلاق
Dialogue: 0,0:16:17.82,0:16:20.03,Default,,0,0,0,,و لا رشفةً حتى
Dialogue: 0,0:16:20.03,0:16:21.53,Default,,0,0,0,,ما الذي تعنيه!؟
Dialogue: 0,0:16:21.53,0:16:26.06,Default,,0,0,0,,قام بالتظاهر بشربه، و لكنه سكبه في حوض الزرع بجانب النافذة
Dialogue: 0,0:16:26.06,0:16:27.98,Default,,0,0,0,,إذاً هل كان قلبه؟
Dialogue: 0,0:16:27.98,0:16:34.02,Default,,0,0,0,,كلا، لقد مات بسمٍّ سبّب له نوبةً قلبية، أنا متأكدٌ من هذا
Dialogue: 0,0:16:34.02,0:16:39.16,Default,,0,0,0,,ما هذا الكلام الغير منطقي!؟ أختي من قامت بقتله بكل وضوح
Dialogue: 0,0:16:39.16,0:16:43.10,Default,,0,0,0,,أعتقد أنه لم يتقبل أن يموت ميتةً عادية
Dialogue: 0,0:16:43.10,0:16:46.85,Default,,0,0,0,,مع أنه وثق بكما حتى ٱخر لحظة من عمره
Dialogue: 0,0:16:46.85,0:16:49.72,Default,,0,0,0,,و لكن ألم يقم باستئجارك للتحقيق لأنه لا يثق بهن؟
Dialogue: 0,0:16:49.72,0:16:54.36,Default,,0,0,0,,أراد أن يثق بهن، لذلك قام باختبارهن
Dialogue: 0,0:16:54.36,0:16:56.99,Default,,0,0,0,,ران، قومي بتشغيل ذلك الفيديو
Dialogue: 0,0:16:57.50,0:16:58.49,Default,,0,0,0,,حسناً
Dialogue: 0,0:17:02.07,0:17:03.64,Default,,0,0,0,,هذا!؟
Dialogue: 0,0:17:03.64,0:17:04.81,Default,,0,0,0,,ما هذا!؟
Dialogue: 0,0:17:04.81,0:17:08.26,Default,,0,0,0,,كل هذا كان مدبراً بواسطة السيد إيتشيواكا
Dialogue: 0,0:17:08.26,0:17:13.93,Default,,0,0,0,,على الأرجح خطّط للتظاهر بالإنهيار جرّاء نوبةٍ قلبية
Dialogue: 0,0:17:13.93,0:17:19.44,Default,,0,0,0,,و ثم بعد هذا يتفقد الشريط ليرى كيف كانت ردة فعل ابنتيه
Dialogue: 0,0:17:19.44,0:17:22.05,Default,,0,0,0,,و لكن الخطة تغيرت بطريقةٍ ما
Dialogue: 0,0:17:22.05,0:17:26.93,Default,,0,0,0,,عندما علم بأن السيدة كازوي كانت تخطط لقتله
Dialogue: 0,0:17:26.93,0:17:28.05,Default,,0,0,0,,..لذلك
Dialogue: 0,0:17:29.03,0:17:34.14,Default,,0,0,0,,لذلك حينها قرر أن يتظاهر بشرب الشراب المسموم
Dialogue: 0,0:17:34.14,0:17:39.25,Default,,0,0,0,,لحظة، انتظر قليلاً، ألم يكن السم هو سبب وفاته!؟
Dialogue: 0,0:17:39.25,0:17:41.45,Default,,0,0,0,,بالطبع، لا شك في هذا
Dialogue: 0,0:17:41.45,0:17:45.19,Default,,0,0,0,,و لكنه لم يكن محقوناً في مشروبه أو طعامه
Dialogue: 0,0:17:45.19,0:17:48.80,Default,,0,0,0,,لقد تم إعطائه إياه بطريقةٍ مباشرةٍ أكثر
Dialogue: 0,0:17:48.80,0:17:54.31,Default,,0,0,0,,انتظر، لست متأكداً بأنه كان هناك الوقت الكافي لأحدٍ ما لكي يفعل هذا
Dialogue: 0,0:17:54.31,0:17:56.48,Default,,0,0,0,,!صحيح! الجميع كانوا يشاهدون
Dialogue: 0,0:17:56.48,0:18:03.53,Default,,0,0,0,,صحيح، القاتل قام بإعطائه السم أمام أنظار الجميع
Dialogue: 0,0:18:03.53,0:18:06.33,Default,,0,0,0,,ران، أوقفي الشريط
Dialogue: 0,0:18:06.33,0:18:07.33,Default,,0,0,0,,حسناً
Dialogue: 0,0:18:08.48,0:18:09.67,Default,,0,0,0,,أيعقل!؟
Dialogue: 0,0:18:13.08,0:18:14.02,Default,,0,0,0,,نعم
Dialogue: 0,0:18:14.02,0:18:15.35,Default,,0,0,0,,السيد أوكانو
Dialogue: 0,0:18:15.35,0:18:21.73,Default,,0,0,0,,لقد قمت بإعطائه حقنةً من السم بدلاً من الدواء
Dialogue: 0,0:18:21.73,0:18:26.78,Default,,0,0,0,,كنت تعرف بأمر خطة السيد إيتشيواكا صحيح؟
Dialogue: 0,0:18:26.78,0:18:27.95,Default,,0,0,0,,..و عندما نفكر بهذا قليلاً
Dialogue: 0,0:18:27.95,0:18:33.22,Default,,0,0,0,,سيحتاج إلى مساعدة طبيبه للقيام بمسرحيةٍ كهذه
Dialogue: 0,0:18:33.22,0:18:40.57,Default,,0,0,0,,لذلك لقد كنت مدركاً على الفور بأن ما يفعله كان كله مزيفاً
Dialogue: 0,0:18:40.57,0:18:46.61,Default,,0,0,0,,قام السيد إيتشيواكا بمشاركة خطته معك فقط
Dialogue: 0,0:18:46.61,0:18:48.52,Default,,0,0,0,,لا أعلم ماذا كانت هذه الخطة
Dialogue: 0,0:18:48.52,0:18:55.53,Default,,0,0,0,,و لكنك قررت استعمالها كفرصةٍ لقتله
Dialogue: 0,0:18:55.53,0:19:00.91,Default,,0,0,0,,الجميع كان يعلم بأن لديه ضعفاً بالقلب
Dialogue: 0,0:19:00.91,0:19:05.92,Default,,0,0,0,,لذلك لا أحد سوف يشك بنتائج تشخيصات طبيبه الفيزيائي
Dialogue: 0,0:19:05.92,0:19:10.73,Default,,0,0,0,,و لكن لماذا!؟ لا علاقة للسيد بإرث الضحية صحيح؟
Dialogue: 0,0:19:10.73,0:19:14.87,Default,,0,0,0,,على الأرجح أن السبب المحتمل هو الإنتقام
Dialogue: 0,0:19:14.87,0:19:16.37,Default,,0,0,0,,بما أنك طبيبه الشخصي
Dialogue: 0,0:19:16.37,0:19:22.09,Default,,0,0,0,,لم يكن هناك حاجةٌ لتلويث يديك بقتله
Dialogue: 0,0:19:22.09,0:19:26.22,Default,,0,0,0,,إذا قلت له أن وضعه الصحي بدأ يتحسن، بالنظر إلى ما كان عليه
Dialogue: 0,0:19:26.22,0:19:33.17,Default,,0,0,0,,كان سيقوم بالمزيد من الجهد بنفسه و يسبب موته نتيجةً لذلك
Dialogue: 0,0:19:33.17,0:19:36.99,Default,,0,0,0,,حقيقة أنك قمت بقتله مباشرةً هكذا تعني
Dialogue: 0,0:19:36.99,0:19:39.25,Default,,0,0,0,,أنني أبغضه
Dialogue: 0,0:19:40.83,0:19:42.99,Default,,0,0,0,,لأقصى درجة
Dialogue: 0,0:19:42.99,0:19:49.67,Default,,0,0,0,,الرئيس.. لا، كوتارو إيتشيواكا قتل والدي
Dialogue: 0,0:19:52.65,0:19:58.40,Default,,0,0,0,,والدي و إيتشيواكا كانا شركاءً عندما تأسست الشركة
Dialogue: 0,0:19:58.40,0:20:01.40,Default,,0,0,0,,حصل هذا قبل ثلاثين سنة
Dialogue: 0,0:20:01.40,0:20:06.20,Default,,0,0,0,,المشاريع التي بدأوها سويةً حققت نجاحاً باهراً
Dialogue: 0,0:20:06.20,0:20:10.02,Default,,0,0,0,,و لكنه خان والدي و قام بطرده
Dialogue: 0,0:20:10.02,0:20:12.45,Default,,0,0,0,,بدون أن يعطيه تعويضاً بقيمة ين واحدٍ حتى
Dialogue: 0,0:20:13.52,0:20:16.39,Default,,0,0,0,,ساءت حياة اسرتنا بعد هذا
Dialogue: 0,0:20:16.39,0:20:20.41,Default,,0,0,0,,كان دائماً يروي شكاويه لي بما أني طفل صغير
Dialogue: 0,0:20:20.41,0:20:25.01,Default,,0,0,0,,بعد هذا، توفت والدتي قبل أن أدخل المدرسة الإعدادية
Dialogue: 0,0:20:25.01,0:20:30.66,Default,,0,0,0,,و قَصُر عمر والدي بسبب هذا حينها
Dialogue: 0,0:20:30.66,0:20:35.79,Default,,0,0,0,,بعدها،حين أصبحت طبيباً ظهر هذا الرجل أمامي
Dialogue: 0,0:20:38.41,0:20:43.41,Default,,0,0,0,,لم يدرك أبداً من أكون
Dialogue: 0,0:20:43.41,0:20:49.90,Default,,0,0,0,,و لكن حين أخبرني عن خطته ليختبر ولاء ابنتيه
Dialogue: 0,0:20:49.90,0:20:52.06,Default,,0,0,0,,قررت حينها أن أقوم بهذا
Dialogue: 0,0:20:53.07,0:20:58.82,Default,,0,0,0,,..رجلٌ فظيعٌ و خائنٌ مثله.. يريد اختبار ولاء الآخرين
Dialogue: 0,0:20:58.82,0:21:00.48,Default,,0,0,0,,..كان يجب أن يدفع الثمن
Dialogue: 0,0:21:01.95,0:21:03.98,Default,,0,0,0,,..كان يجب أن يدفع ثمن هذا
Dialogue: 0,0:22:46.56,0:22:48.80,Default,,0,0,0,,!سأكون مشغولةً الآن
Dialogue: 0,0:22:48.80,0:22:51.54,Default,,0,0,0,,يجب أن أنظّم الأشياء التي تركها والدي لي
Dialogue: 0,0:22:51.54,0:22:52.53,Default,,0,0,0,,!سيدتي
Dialogue: 0,0:22:53.71,0:22:56.11,Default,,0,0,0,,...سيدتي! بشأن هذا الأمر
Dialogue: 0,0:22:56.11,0:23:00.46,Default,,0,0,0,,قال والدكِ في وصيته بأنه إذا حدث شيءٌ ما له
Dialogue: 0,0:23:00.46,0:23:03.16,Default,,0,0,0,,ستذهب جميع أملاكه للتبرعات
Dialogue: 0,0:23:03.16,0:23:06.23,Default,,0,0,0,,لا تكن أبلهاً! لن أسمح بحصول شيءٍ كهذا
Dialogue: 0,0:23:06.23,0:23:11.35,Default,,0,0,0,,و لكنها وصية دوّنها محامي
Dialogue: 0,0:23:11.35,0:23:14.42,Default,,0,0,0,,إسمع، هناك شيءٌ يدعى نظام حماية الإرث
Dialogue: 0,0:23:14.42,0:23:17.09,Default,,0,0,0,,!لدي الحق بأن أطالب ما أستحقه منها
Dialogue: 0,0:23:17.09,0:23:18.12,Default,,0,0,0,,سيدة ميزوي
Dialogue: 0,0:23:18.12,0:23:19.66,Default,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:23:19.66,0:23:24.80,Default,,0,0,0,,سمعت بأنكِ رتبت شهادات أسهم والدك بلا تفويض
Dialogue: 0,0:23:26.78,0:23:31.39,Default,,0,0,0,,قيل لي أن حفنةً من المدراء قاموا برفع دعاوي اختلاسٍ عليكِ
Dialogue: 0,0:23:31.39,0:23:36.59,Default,,0,0,0,,!كذب! مستحيل مستحيل
Dialogue: 0,0:23:36.59,0:23:39.80,Default,,0,0,0,,في النهاية إذاً، أبناء السيد إيتشيواكا
Dialogue: 0,0:23:39.80,0:23:42.24,Default,,0,0,0,,لم يحصلوا حتى على ينٍّ واحدٍ من إرثه
Dialogue: 0,0:23:42.24,0:23:45.78,Default,,0,0,0,,ما الذي سيحصل لهذا المنزل إذاً؟؟
Dialogue: 0,0:23:45.78,0:23:48.76,Default,,0,0,0,,ما الذي تعنيه؟ سيتم التبرع به لأحدٍ ما صحيح؟
Dialogue: 0,0:23:48.76,0:23:51.83,Default,,0,0,0,,إذاً ما الذي سيحصل لإجرتي!؟
Dialogue: 0,0:23:51.83,0:23:53.63,Default,,0,0,0,,لقد أخذت مليون ين سلفاً
Dialogue: 0,0:23:53.63,0:23:55.33,Default,,0,0,0,,ماذا عن المليون الأخرى!؟
Dialogue: 0,0:23:55.33,0:23:56.33,Default,,0,0,0,,ما رأيك أن تنساها فقط؟
Dialogue: 0,0:23:56.33,0:23:59.21,Default,,0,0,0,,!!لا أريد
Dialogue: 0,0:24:01.18,0:24:25.12,Flashback,,0,0,0,,{\pos(178,130)}الحلقة القادمة
Dialogue: 0,0:24:08.70,0:24:10.01,Default,,0,0,0,,ما الذي يحصل..؟
Dialogue: 0,0:24:12.30,0:24:15.84,Default,,0,0,0,,!أبي هذا فظيع! جميع الساعات في المنزل تقوم بالرنين
Dialogue: 0,0:24:16.39,0:24:18.06,Default,,0,0,0,,!ماذا!؟ في المنزل بأكمله
Dialogue: 0,0:24:19.02,0:24:20.40,Default,,0,0,0,,حتى جهاز تسجيل الفيديو يعمل
Dialogue: 0,0:24:21.99,0:24:23.53,Default,,0,0,0,,ما هذا الذي يجري هنا..؟
