Dialogue: 0,0:00:01.00,0:00:08.00,DCRights,,0,0,0,,{\fs70\pos(999,25)} ABOODY SUBS | ترجمة وتوقيت\NAoibu_Arabic | تدقيق \NX : @ABOODY_SUBS & @Aoibu_Arabic
Dialogue: 0,0:00:02.61,0:00:04.51,Default,,0,0,0,,.نور البصيرة يشرق ليكشف لي الحقيقة
Dialogue: 0,0:00:04.51,0:00:06.21,Default,,0,0,0,,بمجرد أن يبدأ، لا شيء يمكن أن يوقفه
Dialogue: 0,0:00:06.21,0:00:08.21,Default,,0,0,0,,.في حلقة اليوم، البروفيسور أغاسا يسبب ضجة
Dialogue: 0,0:00:08.21,0:00:10.31,Default,,0,0,0,,.قنبلة متورطة في الغموض
Dialogue: 0,0:00:10.31,0:00:11.81,Default,,0,0,0,,.يسعى وراء الحقيقة دائما
Dialogue: 0,0:00:11.81,0:00:13.71,Default,,0,0,0,,.طفل في المظهر بذكاء شخص بالغ
Dialogue: 0,0:00:13.71,0:00:16.01,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:00:16.05,0:00:19.30,DCOpening,,0,0,0,,لا يهم أي مجلة أتصفحها
Dialogue: 0,0:00:19.30,0:00:23.14,DCOpening,,0,0,0,,بلا جدوى، أتنفس بيأس
Dialogue: 0,0:00:24.27,0:00:27.36,DCOpening,,0,0,0,,الملابس الوحيدة التي تناسبني
Dialogue: 0,0:00:27.52,0:00:31.19,DCOpening,,0,0,0,,تنتمي إلى أسلوب القرن الجديد
Dialogue: 0,0:00:32.65,0:00:35.44,DCOpening,,0,0,0,,لا يهم، فكل هذا لا يليق بك
Dialogue: 0,0:00:35.69,0:00:39.28,DCOpening,,0,0,0,,أعتذر كثيراً إن خيب ذلك ظنك
Dialogue: 0,0:00:40.32,0:00:43.99,DCOpening,,0,0,0,,بأعجوبة، فقط حتى قمة الجرف
Dialogue: 0,0:00:44.41,0:00:48.12,DCOpening,,0,0,0,,باضطراب، أتساءل إن كان الوضع جيدًا حقًا؟
Dialogue: 0,0:00:48.16,0:00:52.25,DCOpening,,0,0,0,,رغم كل هذا، ليس أمامي سوى طريق واحد
Dialogue: 0,0:00:52.59,0:00:56.80,DCOpening,,0,0,0,,!لا مشكلة، أنا في وضع جيد تماماً
Dialogue: 0,0:01:01.80,0:01:05.47,DCOpening,,0,0,0,,بأعجوبة، لن أتراجع ولو قليلاً
Dialogue: 0,0:01:05.93,0:01:09.52,DCOpening,,0,0,0,,أرجوك، لا توجه لي نظراتك الباردة
Dialogue: 0,0:01:09.85,0:01:13.60,DCOpening,,0,0,0,,كما قلت، دعني أفعل ذلك 
Dialogue: 0,0:01:13.94,0:01:17.90,DCOpening,,0,0,0,,!إن رفضتَ، سينهار كل شيء
Dialogue: 0,0:01:18.24,0:01:21.91,DCOpening,,0,0,0,,بأعجوبة، فقط حتى قمة الجرف
Dialogue: 0,0:01:22.37,0:01:25.83,DCOpening,,0,0,0,,باضطراب، أتساءل إن كان الوضع جيدًا حقًا؟
Dialogue: 0,0:01:26.16,0:01:30.21,DCOpening,,0,0,0,,رغم كل هذا، ليس أمامي سوى طريق واحد
Dialogue: 0,0:01:30.46,0:01:34.76,DCOpening,,0,0,0,,!لا مشكلة، أنا في وضع جيد تماماً
Dialogue: 0,0:01:36.95,0:01:39.15,Default,,0,0,0,,تسللنا إلى مبنى مهجور
Dialogue: 0,0:01:39.15,0:01:42.15,Default,,0,0,0,,.لنتدرب على مسرحية المدرسة
Dialogue: 0,0:01:42.15,0:01:43.85,Default,,0,0,0,,،فجأة يدخل سجين هارب
Dialogue: 0,0:01:43.85,0:01:46.85,Default,,0,0,0,,.يتم ملاحقته من قبل الضابطة ساتو والضابط تاكاجي
Dialogue: 0,0:01:48.45,0:01:51.25,Default,,0,0,0,,.وصل إلى المبنى المجاور من السطح
Dialogue: 0,0:01:51.25,0:01:54.15,Default,,0,0,0,,...الضابطة ساتو تلقى القبض على المشتبه به في الحمام
Dialogue: 0,0:01:55.15,0:01:56.65,Default,,0,0,0,,،ولكن بسبب خطأ بسيط
Dialogue: 0,0:01:56.65,0:01:59.35,Default,,0,0,0,,.علق الاثنان ولم يتمكنا من الخروج
Dialogue: 0,0:02:02.05,0:02:05.05,Default,,0,0,0,,.المشتبه به، السيد هيغاشيدا يصر على براءته
Dialogue: 0,0:02:05.05,0:02:08.15,Default,,0,0,0,,قال إنه حاول الهروب ليذهب إلى شيكاغو
Dialogue: 0,0:02:08.15,0:02:10.75,Default,,0,0,0,,.ليحضر حفل زفاف ابنته
Dialogue: 0,0:02:10.75,0:02:14.95,Default,,0,0,0,,وهكذا تم إرسال الضابط تاكاجي وفريق المحققين الصغار
Dialogue: 0,0:02:14.95,0:02:17.55,Default,,0,0,0,,.للعثور على القاتل الحقيقي
Dialogue: 0,0:02:19.75,0:02:25.85,Default,,0,0,0,,قصة حب ضابط شرطة العاصمة 2 - الجزء الثاني 
Dialogue: 0,0:02:19.75,0:02:25.85,Default,,0,0,0,,{\fs120\pos(950,240)} قصة حب ضابط شرطة العاصمة 2
Dialogue: 0,0:02:19.75,0:02:25.85,Default,,0,0,0,,{\fs120\pos(959,830)} (الجزء الثاني)
Dialogue: 0,0:02:26.05,0:02:29.25,Default,,0,0,0,,.هناك أربعة أشياء غريبة
Dialogue: 0,0:02:29.25,0:02:30.85,Default,,0,0,0,,،أول شيء هو لون السرير
Dialogue: 0,0:02:30.85,0:02:34.55,Default,,0,0,0,,.الملاءات، الوسادة والستارة بجانب السرير
Dialogue: 0,0:02:34.55,0:02:36.05,Default,,0,0,0,,،كل شيء من أدوات المطبخ
Dialogue: 0,0:02:36.05,0:02:39.65,Default,,0,0,0,,.إلى الأطباق وحتى الديكور باللون الرملي
Dialogue: 0,0:02:39.65,0:02:42.85,Default,,0,0,0,,فلماذا فقط السرير والستارة باللون الرمادي؟
Dialogue: 0,0:02:42.85,0:02:45.15,Default,,0,0,0,,.أعتقد أنها مجرد صدفة
Dialogue: 0,0:02:45.15,0:02:49.75,Default,,0,0,0,,.ولكن كانت هناك ملاءات وستائر رملية في الخزانة
Dialogue: 0,0:02:49.75,0:02:51.95,Default,,0,0,0,,الشيء الثاني هو، لماذا تم نزع هذا التقويم
Dialogue: 0,0:02:51.95,0:02:53.55,Default,,0,0,0,,.عن الجدار بجانب السرير
Dialogue: 0,0:02:56.05,0:02:59.35,Default,,0,0,0,,،انظر، هذا تقويم طوكيو سبيريتس لهذا العام
Dialogue: 0,0:02:59.35,0:03:00.75,Default,,0,0,0,,.كان في الخزانة
Dialogue: 0,0:03:00.75,0:03:04.25,Default,,0,0,0,,.إنه يتطابق مع البقعة على الحائط تمامًا
Dialogue: 0,0:03:04.25,0:03:08.75,Default,,0,0,0,,.ربما أزالته لأن الفريق لا يقدم أداءً جيدًا مؤخرًا
Dialogue: 0,0:03:08.75,0:03:10.75,Default,,0,0,0,,.لكن انظر
Dialogue: 0,0:03:10.75,0:03:14.55,Default,,0,0,0,,.جدولها الكامل حتى ديسمبر مكتوب فيه
Dialogue: 0,0:03:14.55,0:03:16.65,Default,,0,0,0,,.أنت محق
Dialogue: 0,0:03:16.65,0:03:17.85,Default,,0,0,0,,،الشيء الثالث هو
Dialogue: 0,0:03:17.85,0:03:20.55,Default,,0,0,0,,.هناك آثار طفيفة على تحريك الأثاث
Dialogue: 0,0:03:20.55,0:03:22.75,Default,,0,0,0,,،رجال مختبر الجريمة ذكروا ذلك أيضًا
Dialogue: 0,0:03:22.75,0:03:24.85,Default,,0,0,0,,.قالوا إنها ربما أعادت ترتيب الغرفة
Dialogue: 0,0:03:24.85,0:03:26.95,Default,,0,0,0,,لكن ألا تعتقد أنه من الغريب
Dialogue: 0,0:03:26.95,0:03:31.05,Default,,0,0,0,,أنها لم تلاحظ أنها سحقت شيئًا بهذه القيمة
Dialogue: 0,0:03:31.05,0:03:33.15,Default,,0,0,0,,عندما حركت الخزانة؟
Dialogue: 0,0:03:33.15,0:03:34.65,Default,,0,0,0,,.إنها مجرد علبة كبريت
Dialogue: 0,0:03:34.65,0:03:35.75,Default,,0,0,0,,.افتحها
Dialogue: 0,0:03:37.45,0:03:39.05,Default,,0,0,0,,.هناك قطعة من الورق بالداخل
Dialogue: 0,0:03:40.15,0:03:41.65,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:03:41.65,0:03:44.05,Default,,0,0,0,,.إنه استمارة تسجيل زواجها
Dialogue: 0,0:03:44.05,0:03:46.15,Default,,0,0,0,,.كانت ستتزوج
Dialogue: 0,0:03:46.15,0:03:48.55,Default,,0,0,0,,.لكن اسم العريس غير مكتوب
Dialogue: 0,0:03:48.55,0:03:51.05,Default,,0,0,0,,.لكن ختمه موجود عليها
Dialogue: 0,0:03:51.05,0:03:52.95,Default,,0,0,0,,.الشيء الرابع هو الصبار
Dialogue: 0,0:03:52.95,0:03:54.15,Default,,0,0,0,,،في يوم الجريمة
Dialogue: 0,0:03:54.15,0:03:57.05,Default,,0,0,0,,.كان المطر غزيرًا منذ الصباح
Dialogue: 0,0:03:57.05,0:04:00.85,Default,,0,0,0,,هل كان عاشق الصبار مثلها سيترك الأصص بالشرفة؟
Dialogue: 0,0:04:00.85,0:04:03.45,Default,,0,0,0,,مما يعني أن شخصًا آخر غير الضحية
Dialogue: 0,0:04:03.45,0:04:08.05,Default,,0,0,0,,.حرك الأشياء لسبب مجهول
Dialogue: 0,0:04:08.05,0:04:10.15,Default,,0,0,0,,.نعم، ها هو
Dialogue: 0,0:04:10.15,0:04:13.75,Default,,0,0,0,,هذا هو صبار الدولفين الذهبي الذي  أعطتها إياه صاحبة الحانة
Dialogue: 0,0:04:13.75,0:04:15.05,Default,,0,0,0,,.في اليوم الذي قتلت فيه
Dialogue: 0,0:04:15.05,0:04:17.65,Default,,0,0,0,,.لكن الأشواك منحنية، يا للأسف
Dialogue: 0,0:04:18.85,0:04:20.35,Default,,0,0,0,,...ايعقل
Dialogue: 0,0:04:20.35,0:04:21.85,Default,,0,0,0,,أتقصد، هذه الغرفة؟
Dialogue: 0,0:04:21.85,0:04:24.55,Default,,0,0,0,,هل نذهب لتفحصها إذن؟
Dialogue: 0,0:04:24.55,0:04:28.05,Default,,0,0,0,,شقته في هذا المبنى السكني أيضًا، أليس كذلك؟
Dialogue: 0,0:04:29.25,0:04:30.55,Default,,0,0,0,,.لنذهب
Dialogue: 0,0:04:43.55,0:04:45.05,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:04:45.05,0:04:49.35,Default,,0,0,0,,.يا أطفال، ستصابون بالبرد إذا نمتم هنا
Dialogue: 0,0:04:49.35,0:04:50.45,Default,,0,0,0,,.المالك
Dialogue: 0,0:04:50.45,0:04:52.15,Default,,0,0,0,,.أنا مندهش جدًا
Dialogue: 0,0:04:52.15,0:04:54.05,Default,,0,0,0,,هل قضيتم الليل كله تحققون؟
Dialogue: 0,0:04:54.05,0:04:55.15,Default,,0,0,0,,.نعم
Dialogue: 0,0:04:55.15,0:04:58.65,Default,,0,0,0,,...لكن لحسن الحظ، تمكنا من حل الجريمة
Dialogue: 0,0:04:58.65,0:05:00.55,Default,,0,0,0,,.بالكامل
Dialogue: 0,0:05:00.55,0:05:02.95,Default,,0,0,0,,.شكرا على تعاونكَ معنا
Dialogue: 0,0:05:02.95,0:05:04.35,Default,,0,0,0,,.على الرحب والسعة
Dialogue: 0,0:05:04.35,0:05:07.35,Default,,0,0,0,,.سعيد لأنني استطعت المساعدة
Dialogue: 0,0:05:07.35,0:05:11.75,Default,,0,0,0,,الآن كيف نجعل القاتل يعترف؟
Dialogue: 0,0:05:11.75,0:05:12.95,Default,,0,0,0,,!مهلا
Dialogue: 0,0:05:12.95,0:05:14.45,Default,,0,0,0,,هل هناك أحد بالداخل؟
Dialogue: 0,0:05:14.45,0:05:15.65,Default,,0,0,0,,!مهلا
Dialogue: 0,0:05:16.65,0:05:18.85,Default,,0,0,0,,تبا، هذه هي المرة الخامسة
Dialogue: 0,0:05:18.85,0:05:20.65,Default,,0,0,0,,.التي يطلب منا فيها رجال الشرطة تفتيش المكان
Dialogue: 0,0:05:20.65,0:05:23.45,Default,,0,0,0,,.المكان كان مغلقًا، لا يمكن لأحد أن يدخل
Dialogue: 0,0:05:23.45,0:05:24.95,Default,,0,0,0,,!مهلا
Dialogue: 0,0:05:24.95,0:05:26.65,Default,,0,0,0,,.القفل مكسور
Dialogue: 0,0:05:26.65,0:05:27.85,Default,,0,0,0,,هل أنت جاد؟
Dialogue: 0,0:05:30.15,0:05:34.25,Default,,0,0,0,,ذلك الشخص الغريب الذي يلعب دور الشرطة\N. واللصوص مع هؤلاء الأطفال ربما فعل هذا
Dialogue: 0,0:05:34.25,0:05:35.45,Default,,0,0,0,,.هذا مزعج
Dialogue: 0,0:05:35.45,0:05:36.85,Default,,0,0,0,,المكان سينفجر
Dialogue: 0,0:05:36.85,0:05:39.25,Default,,0,0,0,,.لكنني سأضع قفلًا جديدًا على أي حال
Dialogue: 0,0:05:39.25,0:05:41.75,Default,,0,0,0,,بالمناسبة، ما اسم تلك القنبلة مرة أخرى؟
Dialogue: 0,0:05:41.75,0:05:44.35,Default,,0,0,0,,يا صاح، هل نسيت بالفعل؟
Dialogue: 0,0:05:44.35,0:05:46.45,Default,,0,0,0,,.إنها تروبيكال راينبو
Dialogue: 0,0:05:54.25,0:05:57.35,Default,,0,0,0,,ماذا؟ شوهد تاكاجي في هايدو؟
Dialogue: 0,0:05:57.35,0:05:58.45,Default,,0,0,0,,هل أنت متأكد؟
Dialogue: 0,0:05:58.45,0:06:03.85,Default,,0,0,0,,.نعم. رأى زوجان شابان رجلاً يشبه الضابط تاكاجي تمامًا
Dialogue: 0,0:06:03.85,0:06:06.75,Default,,0,0,0,,وماذا عن ساتو؟ هل كانا معًا؟
Dialogue: 0,0:06:06.75,0:06:11.15,Default,,0,0,0,,،حسنًا، يبدو أنه لم يكن مع الضابطة ساتو
Dialogue: 0,0:06:11.15,0:06:12.95,Default,,0,0,0,,...بل كان مع 5 أطفال صغار
Dialogue: 0,0:06:12.95,0:06:14.35,Default,,0,0,0,,!يا أحمق
Dialogue: 0,0:06:14.35,0:06:16.65,Default,,0,0,0,,أي نوع من ضباط الشرطة يلعب مع أطفال صغار
Dialogue: 0,0:06:16.65,0:06:17.85,Default,,0,0,0,,وهو في منتصف قضية؟
Dialogue: 0,0:06:17.85,0:06:19.85,Default,,0,0,0,,!إنه الشخص الخطأ، استمر في البحث
Dialogue: 0,0:06:19.85,0:06:22.15,Default,,0,0,0,,.تباً!، الجميع عديم الفائدة
Dialogue: 0,0:06:22.15,0:06:23.85,Default,,0,0,0,,.اعذرني، المفتش ميغوري
Dialogue: 0,0:06:23.85,0:06:25.85,Default,,0,0,0,,نعم، شيراتوري، ما الأمر؟
Dialogue: 0,0:06:25.85,0:06:27.85,Default,,0,0,0,,...ربما أكون مخطئاً تماماً، لكن
Dialogue: 0,0:06:27.85,0:06:32.85,Default,,0,0,0,,...هل يمكن أن يكون هؤلاء الأطفال هم المحققين الصغار من مكتب المحقق موري
Dialogue: 0,0:06:32.85,0:06:34.85,Default,,0,0,0,,.هذا مستحيل
Dialogue: 0,0:06:34.85,0:06:39.25,Default,,0,0,0,,.لكنه قد يفسر لماذا لم تتصل الضابطة ساتو
Dialogue: 0,0:06:39.25,0:06:41.65,Default,,0,0,0,,...هل تقصد أنها
Dialogue: 0,0:06:41.65,0:06:44.55,Default,,0,0,0,,.ربما يتم احتجازها كرهينة من قبل القاتل
Dialogue: 0,0:06:44.55,0:06:46.95,Default,,0,0,0,,!كما توقعت
Dialogue: 0,0:06:54.85,0:06:56.25,Default,,0,0,0,,.اسمعوا يا أطفال
Dialogue: 0,0:06:56.25,0:06:59.45,Default,,0,0,0,,إذا كنتم تشعرون بالنعاس، لماذا لا تذهبون إلى المنزل؟
Dialogue: 0,0:06:59.45,0:07:00.75,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:07:00.75,0:07:03.35,Default,,0,0,0,,.لا تكن قاسيًا، نحن نريد المساعدة أيضًا
Dialogue: 0,0:07:03.35,0:07:04.35,Default,,0,0,0,,...أنتم 
Dialogue: 0,0:07:04.35,0:07:07.55,Default,,0,0,0,,.من فضلك دعنا نساعدك
Dialogue: 0,0:07:07.55,0:07:09.45,Default,,0,0,0,,أراهن أنك تريد القبض على القاتل بنفسك
Dialogue: 0,0:07:09.45,0:07:12.05,Default,,0,0,0,,.لتأخذ كل الفضل وتبدو جيدًا
Dialogue: 0,0:07:12.05,0:07:16.45,Default,,0,0,0,,.احمق... هذا ما يفترض بنا كشرطة فعله، إنه عملنا
Dialogue: 0,0:07:16.45,0:07:19.35,Default,,0,0,0,,.الوقت... لم يتبق لدينا الكثير من الوقت
Dialogue: 0,0:07:20.45,0:07:23.45,Default,,0,0,0,,هيا، لننطلق
Dialogue: 0,0:07:23.45,0:07:25.85,Default,,0,0,0,,.إلى منزل القاتل الحقيقي
Dialogue: 0,0:07:27.35,0:07:30.35,Default,,0,0,0,,.خمس دقائق حتى انتهاء المهلة
Dialogue: 0,0:07:30.35,0:07:32.95,Default,,0,0,0,,.يبدو أنهم لم يتمكنوا من فعل ذلك
Dialogue: 0,0:07:35.35,0:07:37.35,Default,,0,0,0,,.لا تبكي
Dialogue: 0,0:07:37.35,0:07:40.75,Default,,0,0,0,,لم نتمكن من إيصالك إلى حفل زفاف ابنتك
Dialogue: 0,0:07:40.75,0:07:43.15,Default,,0,0,0,,لكنني أعدك أننا سنقبض على القاتل الحقيقي
Dialogue: 0,0:07:43.15,0:07:45.85,Default,,0,0,0,,.ونثبت براءتك
Dialogue: 0,0:07:46.85,0:07:48.25,Default,,0,0,0,,...أتعلم، هذا غريب
Dialogue: 0,0:07:48.25,0:07:52.85,Default,,0,0,0,,.كان ينبغي أن يصل عمال النظافة بالفعل لتنظيف المراحيض
Dialogue: 0,0:07:52.85,0:07:55.05,Default,,0,0,0,,ربما هي مغلقة اليوم؟
Dialogue: 0,0:07:55.05,0:07:57.95,Default,,0,0,0,,.هذا مستحيل، اليوم الأحد
Dialogue: 0,0:07:57.95,0:08:02.65,Default,,0,0,0,,.واسمع، يمكنك سماع أصوات الناس
Dialogue: 0,0:08:02.65,0:08:05.65,Default,,0,0,0,,.ربما يصطفون بالخارج في انتظار فتحها
Dialogue: 0,0:08:06.65,0:08:09.65,Default,,0,0,0,,"وداعًا لمتحف مدينة هايدو للفنون"
Dialogue: 0,0:08:09.65,0:08:12.25,Default,,0,0,0,,"العد التنازلي للتفجير، 34 دقيقة و 04 ثواني"
Dialogue: 0,0:08:12.25,0:08:14.85,Default,,0,0,0,,"كيتاغاوا"
Dialogue: 0,0:08:14.85,0:08:17.55,Default,,0,0,0,,.لماذا؟ أنت ضابط الشرطة الذي قابلته الليلة الماضية
Dialogue: 0,0:08:17.55,0:08:19.15,Default,,0,0,0,,.مرحبًا مرة أخرى
Dialogue: 0,0:08:19.15,0:08:20.45,Default,,0,0,0,,ألم تسمعني؟
Dialogue: 0,0:08:20.45,0:08:23.25,Default,,0,0,0,,.قلت إنني تحدثت بالفعل مع الشرطة
Dialogue: 0,0:08:23.25,0:08:26.65,Default,,0,0,0,,أعلم ولكن أود أن أعرف
Dialogue: 0,0:08:26.65,0:08:29.15,Default,,0,0,0,,.حول الوقت الذي اكتشفت فيه الجثة
Dialogue: 0,0:08:29.15,0:08:30.75,Default,,0,0,0,,،لقد أخبرتك بالفعل
Dialogue: 0,0:08:30.75,0:08:33.95,Default,,0,0,0,,كل من هيغاشيدا ومورانيشي لم يحضروا إلى العمل
Dialogue: 0,0:08:33.95,0:08:36.95,Default,,0,0,0,,.ولم يردوا على الهاتف فذهبت إلى الشقة
Dialogue: 0,0:08:36.95,0:08:39.15,Default,,0,0,0,,دققت على الجرس ولكن لم يكن هناك رد
Dialogue: 0,0:08:39.15,0:08:40.45,Default,,0,0,0,,فطلبت من المالك استخدام المفتاح الرئيسي
Dialogue: 0,0:08:40.45,0:08:42.15,Default,,0,0,0,,،وفتح للتحقق من أنه لم يكن هناك مالك لاستخدام الباب
Dialogue: 0,0:08:42.15,0:08:44.45,Default,,0,0,0,,.مكان مورانيشي كان الأول
Dialogue: 0,0:08:44.45,0:08:46.95,Default,,0,0,0,,،سلسلة الباب كانت موضوعة ولسبب ما
Dialogue: 0,0:08:46.95,0:08:52.55,Default,,0,0,0,,كان هيغاشيدا نائمًا على سريرها صرخت من خارج الباب
Dialogue: 0,0:08:52.55,0:08:54.45,Default,,0,0,0,,،وأيقظته لفك السلسلة
Dialogue: 0,0:08:54.45,0:08:56.45,Default,,0,0,0,,ثم دخلت أنا والمالك
Dialogue: 0,0:08:56.45,0:09:00.35,Default,,0,0,0,,.ووجدنا مورانيشي ميتة على أرضية الحمام
Dialogue: 0,0:09:01.45,0:09:03.75,Default,,0,0,0,,.وهذا كل شيء لدي
Dialogue: 0,0:09:04.75,0:09:06.45,Default,,0,0,0,,.السيد كيتاغاوا
Dialogue: 0,0:09:06.45,0:09:09.85,Default,,0,0,0,,.هذا كل ما لدي لأقوله، من فضلك اتركني الآن
Dialogue: 0,0:09:09.85,0:09:12.65,Default,,0,0,0,,.من فضلك اسمح لي بطرح بعض الأسئلة
Dialogue: 0,0:09:12.65,0:09:17.55,Default,,0,0,0,,ما هذا؟ لا تخبرني أنك تشك بي؟
Dialogue: 0,0:09:17.55,0:09:20.55,Default,,0,0,0,,.لا، لا شيء من هذا القبيل
Dialogue: 0,0:09:20.55,0:09:22.45,Default,,0,0,0,,!بالطبع نحن نشك
Dialogue: 0,0:09:23.45,0:09:25.45,Default,,0,0,0,,أنت القاتل، أليس كذلك؟
Dialogue: 0,0:09:25.45,0:09:27.45,Default,,0,0,0,,!لا تحاول الكذب علينا
Dialogue: 0,0:09:27.45,0:09:30.15,Default,,0,0,0,,!لا يمكنك الهروب بعد ارتكاب جريمة قتل
Dialogue: 0,0:09:30.15,0:09:34.05,Default,,0,0,0,,.أيها الأطفال، اهدأوا. التزموا الأدب
Dialogue: 0,0:09:34.05,0:09:36.15,Default,,0,0,0,,.توقفوا عن هذا... هناك طريقة للقيام بهذه الأمور
Dialogue: 0,0:09:36.15,0:09:38.45,Default,,0,0,0,,من هؤلاء الأطفال؟
Dialogue: 0,0:09:38.45,0:09:40.15,Default,,0,0,0,,.نحن فريق المحققين الصغار
Dialogue: 0,0:09:40.15,0:09:42.95,Default,,0,0,0,,.لا توجد قضية لا نستطيع حلها
Dialogue: 0,0:09:44.25,0:09:45.65,Default,,0,0,0,,...هذا
Dialogue: 0,0:09:46.65,0:09:48.65,Default,,0,0,0,,تبا، لا أعرف ما كل هذا
Dialogue: 0,0:09:48.65,0:09:50.65,Default,,0,0,0,,.لكن انتظروا ، لحظة
Dialogue: 0,0:09:50.65,0:09:54.35,Default,,0,0,0,,.في تلك الظروف، لا يمكن أن أكون القاتل
Dialogue: 0,0:09:54.35,0:09:58.45,Default,,0,0,0,,إذن لماذا غيرت لون الملاءات والستائر؟
Dialogue: 0,0:09:58.45,0:10:00.25,Default,,0,0,0,,أنت فعلت ذلك، أليس كذلك؟
Dialogue: 0,0:10:00.25,0:10:02.75,Default,,0,0,0,,غيرت لون الملاءات والستائر
Dialogue: 0,0:10:02.75,0:10:05.15,Default,,0,0,0,,.من الرملي إلى الرمادي
Dialogue: 0,0:10:06.45,0:10:07.65,Default,,0,0,0,,!انت
Dialogue: 0,0:10:08.75,0:10:10.75,Default,,0,0,0,,.لقد سئمت من هذا
Dialogue: 0,0:10:10.75,0:10:13.45,Default,,0,0,0,,خذ هؤلاء الأطفال واخرج من هنا الآن
Dialogue: 0,0:10:13.45,0:10:15.55,Default,,0,0,0,,.وإلا سأقاضيك بتهمة التشهير
Dialogue: 0,0:10:16.85,0:10:19.95,Default,,0,0,0,,كنا في المتجر القريب من هنا
Dialogue: 0,0:10:19.95,0:10:21.85,Default,,0,0,0,,.وحصلنا على كل الأدلة التي نحتاجها
Dialogue: 0,0:10:21.85,0:10:23.25,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:10:23.25,0:10:25.95,Default,,0,0,0,,،لقد اشتريت أغطية بطانيات رمادية
Dialogue: 0,0:10:25.95,0:10:28.45,Default,,0,0,0,,،ملاءات وستائر
Dialogue: 0,0:10:28.45,0:10:29.95,Default,,0,0,0,,.لدينا شهادة البائع
Dialogue: 0,0:10:29.95,0:10:31.65,Default,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:10:31.65,0:10:36.15,Default,,0,0,0,,.اشتريتها لاستبدال القديمة في مكاني
Dialogue: 0,0:10:36.15,0:10:39.15,Default,,0,0,0,,.لكني لم تعجبني فرميتها
Dialogue: 0,0:10:39.15,0:10:41.85,Default,,0,0,0,,كما أنك نزعت تقويم مورانيشي
Dialogue: 0,0:10:41.85,0:10:44.85,Default,,0,0,0,,ووضعت أصص الصبار في الشرفة، أليس كذلك؟
Dialogue: 0,0:10:46.95,0:10:49.15,Default,,0,0,0,,.لكنك لم يكن لديك خيار
Dialogue: 0,0:10:49.15,0:10:51.75,Default,,0,0,0,,،هيغاشيدا يكره سبيريتس
Dialogue: 0,0:10:51.75,0:10:53.05,Default,,0,0,0,,لو رأى ذلك التقويم
Dialogue: 0,0:10:53.05,0:10:55.25,Default,,0,0,0,,،والصبار الذي لم يشتره في غرفته المفترضة
Dialogue: 0,0:10:55.25,0:10:57.35,Default,,0,0,0,,،رغم أنه كان ثملًا
Dialogue: 0,0:10:57.35,0:11:00.65,Default,,0,0,0,,.لم تستطع المجازفة بملاحظته
Dialogue: 0,0:11:00.65,0:11:03.65,Default,,0,0,0,,هذا صحيح، لقد أزلت كل شيء
Dialogue: 0,0:11:03.65,0:11:06.55,Default,,0,0,0,,،الذي قد يحددها كغرفتها
Dialogue: 0,0:11:06.55,0:11:08.25,Default,,0,0,0,,،ثم غيرت الستائر والفراش
Dialogue: 0,0:11:08.25,0:11:09.55,Default,,0,0,0,,وأعدت ترتيب الأثاث
Dialogue: 0,0:11:09.55,0:11:12.05,Default,,0,0,0,,لتبدو كغرفته
Dialogue: 0,0:11:12.05,0:11:14.65,Default,,0,0,0,,ثم بعد أن قتلت مورانيشي
Dialogue: 0,0:11:14.65,0:11:17.15,Default,,0,0,0,,،وأحضرت هيغاشيدا إلى غرفتها
Dialogue: 0,0:11:17.15,0:11:19.35,Default,,0,0,0,,،بعد أن جعلته يشرب في الحانة مساءً
Dialogue: 0,0:11:19.35,0:11:21.65,Default,,0,0,0,,.لتلصق به الجريمة
Dialogue: 0,0:11:22.95,0:11:25.75,Default,,0,0,0,,.وجعلته يعتقد أنه في مكانه
Dialogue: 0,0:11:27.95,0:11:29.45,Default,,0,0,0,,،كان ثملًا
Dialogue: 0,0:11:29.45,0:11:33.15,Default,,0,0,0,,.جعلته يضع سلسلة الباب بنفسه
Dialogue: 0,0:11:33.15,0:11:34.25,Default,,0,0,0,,،بعد أن تأكدت من ذلك
Dialogue: 0,0:11:34.25,0:11:37.65,Default,,0,0,0,,.كل ما كان عليك فعله هو جعله يقفل الباب
Dialogue: 0,0:11:37.65,0:11:39.85,Default,,0,0,0,,.كان ثملًا جدًا، فذهب مباشرة إلى السرير
Dialogue: 0,0:11:39.85,0:11:42.85,Default,,0,0,0,,وبهذا في الصباح التالي، سيُعثر عليه في شقة مقفلة
Dialogue: 0,0:11:42.85,0:11:45.95,Default,,0,0,0,,.مع جثتها
Dialogue: 0,0:11:45.95,0:11:48.05,Default,,0,0,0,,.هكذا حدث الأمر
Dialogue: 0,0:11:49.65,0:11:51.65,Default,,0,0,0,,ماذا عن سلك الفيديو؟
Dialogue: 0,0:11:51.65,0:11:55.95,Default,,0,0,0,,ماذا عن السلك الذي وجد ملفوفًا حول عنقها؟
Dialogue: 0,0:11:55.95,0:11:59.35,Default,,0,0,0,,.بصماته كانت عليه
Dialogue: 0,0:11:59.35,0:12:02.25,Default,,0,0,0,,هايبارا، هل وجدتِه؟
Dialogue: 0,0:12:02.25,0:12:03.75,Default,,0,0,0,,.تمامًا كما توقعت
Dialogue: 0,0:12:05.05,0:12:08.75,Default,,0,0,0,,.سلك فيديو واحد مفقود من وحدته
Dialogue: 0,0:12:11.05,0:12:15.15,Default,,0,0,0,,،هيغاشيدا كان خبيرًا في أجهزة الفيديو \Nربما طلبت منه توصيل الفيديو الخاص بك
Dialogue: 0,0:12:15.15,0:12:18.05,Default,,0,0,0,,ثم استخدمت السلك كسلاح، أليس كذلك؟
Dialogue: 0,0:12:18.05,0:12:21.65,Default,,0,0,0,,،بالإضافة إلى ذلك، بالإضافة إلى ذلك، لقد أخذت إجازة في يوم القتل ذلك المساء
Dialogue: 0,0:12:19.05,0:12:21.65,Default,,0,0,0,,،لقد أخذت إجازة في يوم القتل ذلك المساء
Dialogue: 0,0:12:21.65,0:12:25.45,Default,,0,0,0,,.تسلقت السلالم الطارئة للوصول إلى شقتها
Dialogue: 0,0:12:25.45,0:12:28.95,Default,,0,0,0,,،استخدمت المفتاح الاحتياطي الذي أعطتك إياه للدخول
Dialogue: 0,0:12:28.95,0:12:32.55,Default,,0,0,0,,ثم رتبت الشقة، وانتظرت عودتها من العمل
Dialogue: 0,0:12:32.55,0:12:35.85,Default,,0,0,0,,.وعندما عادت، خنقتها، ها هي أدلتنا
Dialogue: 0,0:12:35.85,0:12:38.45,Default,,0,0,0,,!أي أدلة؟ هذا هراء
Dialogue: 0,0:12:38.45,0:12:39.95,Default,,0,0,0,,!أرني الأدلة إذن
Dialogue: 0,0:12:39.95,0:12:43.15,Default,,0,0,0,,.أرني الأدلة التي تثبت أنني قتلتها
Dialogue: 0,0:12:43.15,0:12:45.15,Default,,0,0,0,,.لا يوجد شيء من هذا القبيل
Dialogue: 0,0:12:45.15,0:12:49.85,Default,,0,0,0,,.أخذت إجازة ذلك اليوم لكنني لم أرها
Dialogue: 0,0:12:53.55,0:12:56.15,Default,,0,0,0,, ماذا حدث لك يا عمي؟
Dialogue: 0,0:12:57.55,0:12:59.95,Default,,0,0,0,,...كيف جرحت إصبعك
Dialogue: 0,0:13:10.95,0:13:13.75,Default,,0,0,0,,أتساءل لماذا هذه الموسيقى؟
Dialogue: 0,0:13:13.75,0:13:17.75,Default,,0,0,0,,.حسنًا، من الجيد أن يكون هناك موسيقى أثناء الانتظار
Dialogue: 0,0:13:17.75,0:13:18.95,Default,,0,0,0,,"وداعًا لمتحف مدينة هايدو للفنون"
Dialogue: 0,0:13:18.95,0:13:21.15,Default,,0,0,0,,"العد التنازلي للتفجير، 10 دقائق"
Dialogue: 0,0:13:22.25,0:13:24.55,Default,,0,0,0,,.حسنًا، سيداتي سادتي
Dialogue: 0,0:13:24.55,0:13:26.05,Default,,0,0,0,,،خلال 10 دقائق أخرى
Dialogue: 0,0:13:26.05,0:13:28.45,Default,,0,0,0,,سنودع متحف مدينة هايدو للفنون
Dialogue: 0,0:13:28.45,0:13:30.85,Default,,0,0,0,,.الذي خدمنا لمدة 40 عامًا
Dialogue: 0,0:13:30.85,0:13:32.65,Default,,0,0,0,,.شكرًا لخدمتكم
Dialogue: 0,0:13:33.65,0:13:34.85,Default,,0,0,0,,هل قال وداعًا؟
Dialogue: 0,0:13:34.85,0:13:40.65,Default,,0,0,0,,والآن أود أن أدعو عبقري المدينة، البروفيسور أغاسا ليلقي كلمته
Dialogue: 0,0:13:40.65,0:13:44.15,Default,,0,0,0,,.من فضلك تفضل إلى المنصة، بروفيسور
Dialogue: 0,0:13:49.05,0:13:55.05,Default,,0,0,0,,.أنا البروفيسور أغاسا، كما تم تقديمي
Dialogue: 0,0:13:55.05,0:13:58.75,Default,,0,0,0,,قنبلة تروبيكال راينبو التي اخترعتها
Dialogue: 0,0:13:58.75,0:14:01.75,Default,,0,0,0,,ستوفر نهاية جميلة وملونة
Dialogue: 0,0:14:01.75,0:14:04.35,Default,,0,0,0,,.تليق بمتحفنا الفني
Dialogue: 0,0:14:06.15,0:14:08.15,Default,,0,0,0,,ماذا قال؟
Dialogue: 0,0:14:09.15,0:14:11.25,Default,,0,0,0,,.أنا متأكد أنه قال قنبلة
Dialogue: 0,0:14:11.25,0:14:13.25,Default,,0,0,0,,...ا-انتظر
Dialogue: 0,0:14:13.25,0:14:14.95,Default,,0,0,0,,!هذا لا يمكن أن يحدث
Dialogue: 0,0:14:20.94,0:14:25.34,Default,,0,0,0,,ماذا عن إبهامك، لديك ضمادة عليه
Dialogue: 0,0:14:25.34,0:14:27.04,Default,,0,0,0,,.لذا لا بد أنك مصاب
Dialogue: 0,0:14:28.64,0:14:31.14,Default,,0,0,0,,وماذا لو أصبت؟
Dialogue: 0,0:14:31.14,0:14:33.24,Default,,0,0,0,,.خذ هؤلاء الأطفال واخرج من هنا
Dialogue: 0,0:14:33.24,0:14:34.74,Default,,0,0,0,,.من فضلك لحظة
Dialogue: 0,0:14:34.74,0:14:36.84,Default,,0,0,0,,مهلاً، ماذا تفعل؟
Dialogue: 0,0:14:38.64,0:14:40.54,Default,,0,0,0,,.كما توقعت
Dialogue: 0,0:14:40.54,0:14:44.54,Default,,0,0,0,,اشرح هذا. كيف أصبت إبهامك؟
Dialogue: 0,0:14:44.54,0:14:46.14,Default,,0,0,0,,...حسنًا
Dialogue: 0,0:14:46.14,0:14:49.64,Default,,0,0,0,,سنعرف على الفور عندما نحلل ذلك الإصبع
Dialogue: 0,0:14:49.64,0:14:51.54,Default,,0,0,0,,.والصبار التالف في المقر الرئيسي
Dialogue: 0,0:14:51.54,0:14:54.64,Default,,0,0,0,,.مورانيشي أحضرت ذلك الصبار إلى المنزل في ذلك اليوم
Dialogue: 0,0:14:54.64,0:14:55.74,Default,,0,0,0,,،بعد أن قتلتها
Dialogue: 0,0:14:55.74,0:14:58.44,Default,,0,0,0,,أسرعت لوضع الصبار في الشرفة، أليس كذلك؟
Dialogue: 0,0:14:58.44,0:15:01.34,Default,,0,0,0,,.والآن، أجب على سؤالي
Dialogue: 0,0:15:01.34,0:15:05.54,Default,,0,0,0,,قلت أنك لم ترها في يوم مقتلها
Dialogue: 0,0:15:05.54,0:15:07.14,Default,,0,0,0,,،ولكن إذا كان الأمر كذلك
Dialogue: 0,0:15:07.14,0:15:09.74,Default,,0,0,0,,فلماذا كان دمك على شوكة الصبار عندما
Dialogue: 0,0:15:09.74,0:15:12.64,Default,,0,0,0,,حصلت مورانيشي عليها من صاحبة الحانة مساءً؟
Dialogue: 0,0:15:16.04,0:15:17.34,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:17.34,0:15:20.14,Default,,0,0,0,,تاكاجي كان في مكان الجريمة؟
Dialogue: 0,0:15:20.14,0:15:22.04,Default,,0,0,0,,نعم، لقد تفحص المكان
Dialogue: 0,0:15:22.04,0:15:23.44,Default,,0,0,0,,،ثم يبدو أنه توجه إلى منزل السيد كيتاغاوا
Dialogue: 0,0:15:23.44,0:15:25.34,Default,,0,0,0,,.الرجل الذي اكتشف الجثة
Dialogue: 0,0:15:25.34,0:15:26.74,Default,,0,0,0,,.فهمت
Dialogue: 0,0:15:26.74,0:15:28.94,Default,,0,0,0,,هذا الأحمق، ماذا يفعل؟
Dialogue: 0,0:15:28.94,0:15:30.74,Default,,0,0,0,,.من المفترض أن يبحث عن السجين
Dialogue: 0,0:15:30.74,0:15:33.34,Default,,0,0,0,,.على أي حال، لنذهب إلى هناك
Dialogue: 0,0:15:33.34,0:15:36.34,Default,,0,0,0,,.ثلاث دقائق حتى التفجير
Dialogue: 0,0:15:36.34,0:15:40.64,Default,,0,0,0,,.بعدها سيضغط البروفيسور أغاسا على المفجر
Dialogue: 0,0:15:40.64,0:15:43.24,Default,,0,0,0,,...مرحبًا
Dialogue: 0,0:15:43.24,0:15:45.94,Default,,0,0,0,,.لا أصدق ذلك. البطارية فارغة
Dialogue: 0,0:15:45.94,0:15:49.94,Default,,0,0,0,,...ماذا عن مسدسك؟ يمكننا إطلاق النار على السلسلة
Dialogue: 0,0:15:49.94,0:15:52.94,Default,,0,0,0,,،أطلقت رصاصتين في أنبوب الصرف، واحدة على القفل
Dialogue: 0,0:15:52.94,0:15:54.44,Default,,0,0,0,,،رصاصتين تحذيريتين
Dialogue: 0,0:15:54.44,0:15:56.64,Default,,0,0,0,,.استخدمت كل الرصاصات الخمس
Dialogue: 0,0:15:56.64,0:15:59.44,Default,,0,0,0,,لماذا لم تحتفظ برصاصة واحدة لوقت لاحق؟
Dialogue: 0,0:15:59.44,0:16:01.74,Default,,0,0,0,,!لأنك استمرريت في الهروب
Dialogue: 0,0:16:01.74,0:16:05.44,Default,,0,0,0,,يا إلهي! تاكاجي، أين أنت؟
Dialogue: 0,0:16:06.74,0:16:08.74,Default,,0,0,0,,.لا أستطيع الوصول
Dialogue: 0,0:16:08.74,0:16:10.74,Default,,0,0,0,,.أتساءل ما الذي يحدث مع الانسة ساتو
Dialogue: 0,0:16:10.74,0:16:12.44,Default,,0,0,0,,.لقد تجاوزت الساعة 10 صباحًا
Dialogue: 0,0:16:12.44,0:16:15.94,Default,,0,0,0,,.أراهن أن أحدًا من المتحف وجدهم
Dialogue: 0,0:16:15.94,0:16:18.34,Default,,0,0,0,,.نعم، بالتأكيد، لكن دعونا نسرع بالعودة على أي حال
Dialogue: 0,0:16:26.24,0:16:29.24,Default,,0,0,0,,تاكاجي! ماذا تفعل هنا؟
Dialogue: 0,0:16:29.24,0:16:31.04,Default,,0,0,0,,.المفتش ميغوري
Dialogue: 0,0:16:31.04,0:16:33.04,Default,,0,0,0,,.لقد قبضت على القاتل الحقيقي
Dialogue: 0,0:16:33.04,0:16:34.44,Default,,0,0,0,,...انسَ ذلك
Dialogue: 0,0:16:35.44,0:16:36.94,Default,,0,0,0,,القاتل الحقيقي؟
Dialogue: 0,0:16:36.94,0:16:38.04,Default,,0,0,0,,.نعم
Dialogue: 0,0:16:38.04,0:16:40.54,Default,,0,0,0,,الضابطة مورانيشي كانت تلاحق السيد كيتاغاوا هنا
Dialogue: 0,0:16:40.54,0:16:43.64,Default,,0,0,0,,.للتزوج بها لذا قتلها
Dialogue: 0,0:16:43.64,0:16:47.64,Default,,0,0,0,,.حاول أن يلصق التهمة بزميله في العمل، السيد هيغاشيدا
Dialogue: 0,0:16:47.64,0:16:49.64,Default,,0,0,0,,واعترف بكل شيء.
Dialogue: 0,0:16:49.64,0:16:52.64,Default,,0,0,0,,ايها المفتش! أسرع، اتصل برئيس مركز شرطة هايدو
Dialogue: 0,0:16:52.64,0:16:56.64,Default,,0,0,0,,.واطلب منه بدء الإجراءات لإطلاق سراح السيد هيغاشيدا
Dialogue: 0,0:16:56.64,0:16:58.84,Default,,0,0,0,,.حسناً
Dialogue: 0,0:16:58.84,0:17:00.94,Default,,0,0,0,,إذن، أين هي الانسة ساتو؟
Dialogue: 0,0:17:00.94,0:17:04.94,Default,,0,0,0,,.هي مع السيد هيغاشيدا في متحف هايدو للفنون
Dialogue: 0,0:17:06.14,0:17:07.94,Default,,0,0,0,,.توقف عن المزاح
Dialogue: 0,0:17:07.94,0:17:09.64,Default,,0,0,0,,...ففي هذه اللحظة، ذلك المكان
Dialogue: 0,0:17:12.14,0:17:14.54,Default,,0,0,0,,!حسنًا، حان الوقت. أصدقائي
Dialogue: 0,0:17:14.54,0:17:18.24,Default,,0,0,0,,!اجتمعوا حولي وسنعد معًا
Dialogue: 0,0:17:19.44,0:17:22.44,Default,,0,0,0,,ماذا؟ لا يزال هناك أشخاص داخل المتحف؟
Dialogue: 0,0:17:22.44,0:17:23.54,Default,,0,0,0,,.هذا مستحيل
Dialogue: 0,0:17:24.54,0:17:27.14,Default,,0,0,0,,مرحبًا، هل ما زلت هناك؟
Dialogue: 0,0:17:27.14,0:17:29.34,Default,,0,0,0,,!ما الذي يحدث؟ أجبني
Dialogue: 0,0:17:29.34,0:17:32.14,Default,,0,0,0,,.تبا!، لم يعد هناك وقت. أسرع
Dialogue: 0,0:17:32.14,0:17:36.04,Default,,0,0,0,,...أسرع
Dialogue: 0,0:17:37.04,0:17:38.94,Default,,0,0,0,,.لنبدأ
Dialogue: 0,0:17:38.94,0:17:43.74,Default,,0,0,0,,،10، 9، 8، 7
Dialogue: 0,0:17:43.74,0:17:48.44,Default,,0,0,0,,،6، 5، 4، 3
Dialogue: 0,0:17:48.44,0:17:51.14,Default,,0,0,0,,!2، 1
Dialogue: 0,0:17:56.74,0:17:58.64,Default,,0,0,0,,سيد أغاسا؟
Dialogue: 0,0:17:58.64,0:18:00.54,Default,,0,0,0,,.كان ذلك وشيكاً
Dialogue: 0,0:18:11.04,0:18:13.64,Default,,0,0,0,,.ها أنتِ! يمكنكِ التحرك الآن
Dialogue: 0,0:18:13.64,0:18:14.94,Default,,0,0,0,,أين تاكاجي؟
Dialogue: 0,0:18:14.94,0:18:16.44,Default,,0,0,0,,...ربما هو
Dialogue: 0,0:18:17.44,0:18:19.74,Default,,0,0,0,,!أنسة ساتو
Dialogue: 0,0:18:19.74,0:18:21.54,Default,,0,0,0,,!تاكاجي
Dialogue: 0,0:18:21.54,0:18:23.24,Default,,0,0,0,,!انسة ساتو
Dialogue: 0,0:18:23.24,0:18:24.74,Default,,0,0,0,,!تاكاجي
Dialogue: 0,0:18:24.74,0:18:27.64,Default,,0,0,0,,!انسة ساتو. لقد فعلتها
Dialogue: 0,0:18:27.64,0:18:30.04,Default,,0,0,0,,!لقد فعلتها! انسة ساتو
Dialogue: 0,0:18:31.14,0:18:33.94,Default,,0,0,0,,المرحاض... أين هو؟
Dialogue: 0,0:18:33.94,0:18:35.64,Default,,0,0,0,,.كنت أحبس نفسي منذ البارحة
Dialogue: 0,0:18:35.64,0:18:37.04,Default,,0,0,0,,.والماء مقطوع في ذلك المرحاض
Dialogue: 0,0:18:37.04,0:18:38.54,Default,,0,0,0,,،وأنت متأخر جدًا
Dialogue: 0,0:18:38.54,0:18:40.24,Default,,0,0,0,,.لذا هيا أخبرني بسرعة
Dialogue: 0,0:18:40.24,0:18:43.34,Default,,0,0,0,,.أعتقد أن هناك واحدًا في مركز الألعاب عند الزاوية
Dialogue: 0,0:18:44.84,0:18:46.84,Default,,0,0,0,,...أنسة ساتو
Dialogue: 0,0:18:47.94,0:18:49.44,Default,,0,0,0,,.الضابط تاكاجي
Dialogue: 0,0:18:49.44,0:18:50.44,Default,,0,0,0,,نعم؟
Dialogue: 0,0:18:50.44,0:18:53.24,Default,,0,0,0,,أنسة ساتو كانت تبكي، أليس كذلك؟
Dialogue: 0,0:18:53.24,0:18:55.34,Default,,0,0,0,,.تاكاجي
Dialogue: 0,0:18:55.34,0:18:56.74,Default,,0,0,0,,.نعم
Dialogue: 0,0:18:56.74,0:18:59.94,Default,,0,0,0,,أنت حقير. ماذا فعلت بميوا؟
Dialogue: 0,0:18:59.94,0:19:03.04,Default,,0,0,0,,.لا شيء، لا أعرف ما تعنيه
Dialogue: 0,0:19:10.44,0:19:14.14,Default,,0,0,0,,!أنسة ساتو
Dialogue: 0,0:19:15.64,0:19:17.94,Default,,0,0,0,,.أرى استمارة تسجيل زواج في علبة الكبريت
Dialogue: 0,0:19:17.94,0:19:20.74,Default,,0,0,0,,.كانت مخبأة تحت أعواد الثقاب
Dialogue: 0,0:19:20.74,0:19:23.44,Default,,0,0,0,,.كان لدى الاثنين مفاتيح لغرفة الآخر
Dialogue: 0,0:19:23.44,0:19:27.74,Default,,0,0,0,,أعتقد أنها تركت تلك الثقاب في مكانها كمفاجأة له
Dialogue: 0,0:19:27.74,0:19:31.14,Default,,0,0,0,,.عندما يستخدمها لإشعال سجائره
Dialogue: 0,0:19:31.14,0:19:32.84,Default,,0,0,0,,أليس كذلك، كونان؟
Dialogue: 0,0:19:33.84,0:19:37.14,Default,,0,0,0,,.تاكاجي فاجأني
Dialogue: 0,0:19:37.14,0:19:40.84,Default,,0,0,0,,.قلب القضية رأسًا على عقب في ليلة واحدة
Dialogue: 0,0:19:40.84,0:19:42.44,Default,,0,0,0,,.لم يكن هناك مفر
Dialogue: 0,0:19:42.44,0:19:44.04,Default,,0,0,0,,.عند اكتشاف الجثة
Dialogue: 0,0:19:44.04,0:19:46.54,Default,,0,0,0,,كانت الشرطة تعتبر السيد هيغاشيدا المشتبه به الرئيسي
Dialogue: 0,0:19:46.54,0:19:49.02,Default,,0,0,0,,.بدليل واضح
Dialogue: 0,0:19:49.04,0:19:54.84,Default,,0,0,0,,،كان لدينا أسباب كثيرة لشك في براءة السيد هيغاشيدا وبدأنا تحقيقاتنا بموضوعية
Dialogue: 0,0:19:54.84,0:19:57.74,Default,,0,0,0,,.على عكس المحققين الآخرين
Dialogue: 0,0:19:57.74,0:20:00.14,Default,,0,0,0,,.هذا ما قاله الضابط تاكاجي
Dialogue: 0,0:20:01.74,0:20:03.44,Default,,0,0,0,,.يا له من رجل
Dialogue: 0,0:20:03.44,0:20:05.04,Default,,0,0,0,,إنه غريب 
Dialogue: 0,0:20:14.34,0:20:16.54,Default,,0,0,0,,{\fs90\pos(900,790)}مطار ناريتا
Dialogue: 0,0:20:16.54,0:20:20.14,Default,,0,0,0,,.الحمد لله، السيد هغاشيدا وصل إلى الطائرة في الوقت المحدد
Dialogue: 0,0:20:20.14,0:20:21.64,Default,,0,0,0,,.نعم
Dialogue: 0,0:20:21.64,0:20:22.84,Default,,0,0,0,,،من ناحيةٍ أخرى
Dialogue: 0,0:20:22.84,0:20:29.14,Default,,0,0,0,,"المفتش ميغوري وبّخني بشدة، قائلاً: "ألا تثقِ بنا؟
Dialogue: 0,0:20:34.34,0:20:38.44,Default,,0,0,0,,هل لي أن أسألك سؤالاً واحداً؟
Dialogue: 0,0:20:38.44,0:20:43.24,Default,,0,0,0,,...أنسة ساتو، ما رأيك في المفتش ميغوري
Dialogue: 0,0:20:43.24,0:20:46.04,Default,,0,0,0,,هل تحبينه؟
Dialogue: 0,0:20:46.04,0:20:49.84,Default,,0,0,0,,ماذا؟، كيف عرفت؟
Dialogue: 0,0:20:49.84,0:20:51.94,Default,,0,0,0,,.الحقيقة هي أنني أحبه
Dialogue: 0,0:20:52.94,0:20:55.14,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:20:55.14,0:20:58.44,Default,,0,0,0,,.بعد كل شيء، إنه مثل الأب لي
Dialogue: 0,0:20:58.44,0:21:00.34,Default,,0,0,0,,مثل الأب؟
Dialogue: 0,0:21:00.34,0:21:02.94,Default,,0,0,0,,.نعم، كأب
Dialogue: 0,0:21:02.94,0:21:05.64,Default,,0,0,0,,.والدي كان ضابط شرطة أيضاً
Dialogue: 0,0:21:05.64,0:21:08.44,Default,,0,0,0,,،قُتل أثناء العمل عندما كنت في المدرسة الابتدائية
Dialogue: 0,0:21:08.44,0:21:10.94,Default,,0,0,0,,.لهذا لا أستطيع إلا أن أرى أبي فيه
Dialogue: 0,0:21:10.94,0:21:13.84,Default,,0,0,0,,...في تلك الهيئة العريضة للمفتش ميغوري
Dialogue: 0,0:21:19.64,0:21:22.24,Default,,0,0,0,,.ماذا؟ هل تظن أنني أعاني من عقدة أوديب
Dialogue: 0,0:21:22.24,0:21:23.84,Default,,0,0,0,,.لا
Dialogue: 0,0:21:23.84,0:21:25.34,Default,,0,0,0,,...حسناً، أعتقد أنني سأذهب إلى أبي
Dialogue: 0,0:21:25.34,0:21:28.34,Default,,0,0,0,,.أعني المفتش وسأتعرض للتوبيخ
Dialogue: 0,0:21:51.51,0:21:56.43,DCEnding,,0,0,0,,سحر بلا حدود، المكان الأصيل
Dialogue: 0,0:21:56.89,0:22:01.64,DCEnding,,0,0,0,,سحر بلا حدود، هل للحب معنى واضح؟
Dialogue: 0,0:22:02.32,0:22:07.33,DCEnding,,0,0,0,,وسط عتمة باردة، أبحث بشدة عن ذرة دفء
Dialogue: 0,0:22:07.65,0:22:13.45,DCEnding,,0,0,0,,يوماً ما، لا بد أن تحدث معجزة
Dialogue: 0,0:22:15.96,0:22:26.05,DCEnding,,0,0,0,,سحر بلا حدود، لو كان للحب وجود، فلابد أنه على هيئة دائرة
Dialogue: 0,0:22:26.88,0:22:36.97,DCEnding,,0,0,0,,سحر بلا حدود، بين أصابعي المرتجفة تولد صرختي الأولى
Dialogue: 0,0:22:37.54,0:22:45.47,DCEnding,,0,0,0,,حتى بدافع الغرور، فهذا تجاوز غير معقول
Dialogue: 0,0:22:46.00,0:22:50.88,DCEnding,,0,0,0,,سحر بلا حدود، يكفيه أن يُلامس قلبًا فيه قليل من الشجاعة
Dialogue: 0,0:22:51.42,0:23:02.18,DCEnding,,0,0,0,,سحر بلا حدود، فلنتحد جميعًا ونكبر سويًا
Dialogue: 0,0:23:03.34,0:23:06.94,Default,,0,0,0,,تفجير المتحف الفني الذي تم تأجيله
Dialogue: 0,0:23:06.94,0:23:08.94,Default,,0,0,0,,.تم تنفيذه في اليوم التالي دون مشاكل
Dialogue: 0,0:23:16.84,0:23:19.64,Default,,0,0,0,,.تروبيكال راينبو نجاح كبير
Dialogue: 0,0:23:21.24,0:23:24.24,Default,,0,0,0,,بالمناسبة، مسرحية مدرستنا تغيرت
Dialogue: 0,0:23:24.24,0:23:27.74,Default,,0,0,0,,.من "يايبا المقنع" إلى "قصة تحقيق"
Dialogue: 0,0:23:27.74,0:23:30.54,Default,,0,0,0,,.أبي
Dialogue: 0,0:23:30.54,0:23:32.64,Default,,0,0,0,,.يا لها من قضية مروعة
Dialogue: 0,0:23:32.64,0:23:35.14,Default,,0,0,0,,هذه المأساة حدثت لأن هذا الأب وابنته
Dialogue: 0,0:23:35.14,0:23:37.44,Default,,0,0,0,,.لم يفهموا بعضهم البعض
Dialogue: 0,0:23:37.44,0:23:40.34,Default,,0,0,0,,!أبي
Dialogue: 0,0:23:41.64,0:23:45.04,Default,,0,0,0,,.هكذا سأكون إذا اكتشفت ران سرّي
