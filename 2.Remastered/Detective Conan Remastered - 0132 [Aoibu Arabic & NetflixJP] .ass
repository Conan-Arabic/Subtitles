Dialogue: 0,0:00:01.09,0:00:06.89,Top,,0,0,0,,\N‫ ترجمة : ABOODY SUBS  \N‫Aoibu_Arabic : محاكاة\N‫X : @ABOODY_SUBS & X : @Aoibu_Arabic
Dialogue: 0,0:00:01.98,0:00:04.78,Default,,0,0,0,,.أحجيات، رموز سرية، حيل، صفقات
Dialogue: 0,0:00:04.78,0:00:06.78,Default,,0,0,0,,.المنظمة الغامضة لرجال الرداء الأسود
Dialogue: 0,0:00:06.78,0:00:08.48,Default,,0,0,0,,.هذه حلقة من ثلاثة أجزاء لم نشاهدها منذ وقت طويل
Dialogue: 0,0:00:08.48,0:00:10.38,Default,,0,0,0,,.جريمة أشبه بالسحر قد وقعت
Dialogue: 0,0:00:10.38,0:00:11.98,Default,,0,0,0,,.يسعى وراء الحقيقة دائما
Dialogue: 0,0:00:11.98,0:00:14.28,Default,,0,0,0,,.بجسد طفل وعقل بالغ
Dialogue: 0,0:00:14.28,0:00:16.88,Default,,0,0,0,,!اسمه هو المحقق كونان
Dialogue: 0,0:00:16.46,0:00:18.17,DCOpening,,0,0,0,,!بحثًا عن الحب  ! بحثًا عن الحلم
Dialogue: 0,0:00:18.17,0:00:19.59,DCOpening,,0,0,0,,بحثًا عن كل الحقيقة!!  
Dialogue: 0,0:00:19.59,0:00:22.59,DCOpening,,0,0,0,,لا أحد يستطيع أن ينتزع  
Dialogue: 0,0:00:22.59,0:00:25.97,DCOpening,,0,0,0,,!الحلم الذي أخفيته في عينيك
Dialogue: 0,0:00:25.97,0:00:32.39,DCOpening,,0,0,0,,!الآن أمسك الحقيقة بوضوح
Dialogue: 0,0:00:38.23,0:00:44.15,DCOpening,,0,0,0,,الدموع الدافئة التي سالت عندما لمست كتفك
Dialogue: 0,0:00:44.15,0:00:49.95,DCOpening,,0,0,0,,!!ستولد من جديد قبل الفجر... لتصبح قوة
Dialogue: 0,0:00:50.57,0:00:56.66,DCOpening,,0,0,0,,...حتى لو لم نكن معًا
Dialogue: 0,0:00:56.66,0:01:03.00,DCOpening,,0,0,0,,...بالحب، يمكننا إيقاف الزمن لندعو بعضنا
Dialogue: 0,0:01:04.59,0:01:06.09,DCOpening,,0,0,0,,!بحثًا عن الحب!   بحثًا عن الحلم
Dialogue: 0,0:01:06.09,0:01:07.59,DCOpening,,0,0,0,,!!بحثًا عن كل الحقيقة
Dialogue: 0,0:01:07.59,0:01:10.55,DCOpening,,0,0,0,,شغفي اللامحدود  
Dialogue: 0,0:01:10.55,0:01:13.93,DCOpening,,0,0,0,,يدفعني لأصل إلى المستقبل الذي أردته  
Dialogue: 0,0:01:13.93,0:01:16.93,DCOpening,,0,0,0,,!!لأنك كنت دائمًا إجابتي
Dialogue: 0,0:01:16.93,0:01:18.44,DCOpening,,0,0,0,,!بحثًا عن الحب!  بحثًا عن الحلم
Dialogue: 0,0:01:18.44,0:01:19.94,DCOpening,,0,0,0,,!!بحثًا عن كل الحقيقة
Dialogue: 0,0:01:19.94,0:01:23.23,DCOpening,,0,0,0,,لا أحد يستطيع أن ينتزع  
Dialogue: 0,0:01:23.23,0:01:26.11,DCOpening,,0,0,0,,!الحلم الذي أخفيته في عينيك
Dialogue: 0,0:01:26.11,0:01:32.78,DCOpening,,0,0,0,,!!الآن أمسك الحقيقة بوضوح
Dialogue: 0,0:01:52.29,0:01:58.29,Default,,0,0,0,,"قضية قتل عشاق السحر - جزء الأحداث"
Dialogue: 0,0:01:58.69,0:02:01.29,Default,,0,0,0,,!حسنًا، انتبهوا جميعًا
Dialogue: 0,0:02:01.29,0:02:04.99,Default,,0,0,0,,.كما ترون، لدي منديل أبيض هنا
Dialogue: 0,0:02:04.99,0:02:08.39,Default,,0,0,0,,.وهنا، لدي خيط أحمر وخاتم ذهبي
Dialogue: 0,0:02:08.39,0:02:09.69,Default,,0,0,0,,.نعم، نعم
Dialogue: 0,0:02:09.69,0:02:14.79,Default,,0,0,0,,.ثم، اصنعي عقدة في منتصف الخيط، يا آنسة
Dialogue: 0,0:02:15.69,0:02:17.39,Default,,0,0,0,,هكذا؟
Dialogue: 0,0:02:17.39,0:02:20.69,Default,,0,0,0,,،ثم، ضعي الخيط مع العقدة في منتصف كفك
Dialogue: 0,0:02:20.69,0:02:23.09,Default,,0,0,0,,.وضعي الخاتم بجانبه
Dialogue: 0,0:02:23.09,0:02:25.69,Default,,0,0,0,,.ثم غطيه بالمنديل
Dialogue: 0,0:02:25.69,0:02:30.59,Default,,0,0,0,,،أدخل إصبعي المثير تحت المنديل
Dialogue: 0,0:02:30.59,0:02:33.79,Default,,0,0,0,,.وأردد تعويذة غامضة
Dialogue: 0,0:02:37.49,0:02:42.09,Default,,0,0,0,,!ارأيتِ! الخاتم مر عبر الخيط
Dialogue: 0,0:02:42.09,0:02:43.99,Default,,0,0,0,,!هذا رائع
Dialogue: 0,0:02:43.99,0:02:46.09,Default,,0,0,0,,كيف فعلتِ ذلك، سونوكو؟
Dialogue: 0,0:02:46.09,0:02:48.29,Default,,0,0,0,,!إنه سر، سر
Dialogue: 0,0:02:48.29,0:02:50.79,Default,,0,0,0,,!سأقوم بهذا أمام الجميع الليلة
Dialogue: 0,0:02:50.79,0:02:53.39,Default,,0,0,0,,فهمت! الأشخاص الذين سيجتمعون الليلة
Dialogue: 0,0:02:53.39,0:02:55.39,Default,,0,0,0,,كلهم من عشاق السحر، أليس كذلك؟
Dialogue: 0,0:02:55.39,0:02:58.39,Default,,0,0,0,,!نعم، تعرفت عليهم جميعًا عبر الإنترنت
Dialogue: 0,0:02:58.39,0:03:00.69,Default,,0,0,0,,!إنه ما يسمى بلقاء خارج الشبكة
Dialogue: 0,0:03:00.69,0:03:07.09,Default,,0,0,0,,لكن، من كان ليظن أن الابنة الكبرى لمجموعة سوزوكي المالية مدمنة على الانترنت و الكمبيوتر؟
Dialogue: 0,0:03:07.09,0:03:11.79,Default,,0,0,0,,عجباً، ألا تعلم أن الإنترنت ضروري في مجتمع المعلومات هذا؟
Dialogue: 0,0:03:11.79,0:03:15.19,Default,,0,0,0,,لماذا لا تثبت جهاز كمبيوتر في مكتبك أيضًا؟
Dialogue: 0,0:03:16.19,0:03:18.39,Default,,0,0,0,,،يا للمفاجأة
Dialogue: 0,0:03:18.39,0:03:21.09,Default,,0,0,0,,رغم أنكِ بدأت فجأة باستخدام الإنترنت
Dialogue: 0,0:03:21.09,0:03:23.29,Default,,0,0,0,,.والسحر أيضًا، سونوكو
Dialogue: 0,0:03:23.29,0:03:27.29,Default,,0,0,0,,.حسنًا، لقد قابلت شابًا رائعًا
Dialogue: 0,0:03:27.29,0:03:29.39,Default,,0,0,0,,شاب رائع؟
Dialogue: 0,0:03:29.39,0:03:33.19,Default,,0,0,0,,!إنه السيد كاتسوكي دويتو، عمره 21 عامًا
Dialogue: 0,0:03:33.19,0:03:37.69,Default,,0,0,0,,وهو عضو في مجموعة عشاق السحر
Dialogue: 0,0:03:37.69,0:03:40.79,Default,,0,0,0,,.لديه أسلوب كلام مهذب ونكاته مليئة بالذكاء
Dialogue: 0,0:03:40.79,0:03:44.49,Default,,0,0,0,,...وأحيانًا يقول أشياء تبقى في ذهنك
Dialogue: 0,0:03:46.59,0:03:49.79,Default,,0,0,0,,.لكنني متأكدة أنه شاب رائع
Dialogue: 0,0:03:49.79,0:03:51.89,Default,,0,0,0,,هل يعني هذا أنكِ لم تقابليه أبدًا؟
Dialogue: 0,0:03:51.89,0:03:54.49,Default,,0,0,0,,!سأقابله لأول مرة اليوم
Dialogue: 0,0:03:54.49,0:03:58.19,Default,,0,0,0,,!سأريه هذا السحر اليوم، وسأفاجئه
Dialogue: 0,0:03:58.19,0:04:01.49,Default,,0,0,0,,.لا أعتقد أنه سيفاجأ
Dialogue: 0,0:04:01.49,0:04:04.99,Default,,0,0,0,,.هذا مجرد سحر للمبتدئين يُعرض عادةً على التلفزيون
Dialogue: 0,0:04:04.99,0:04:06.39,Default,,0,0,0,,كل ما فعلتيه
Dialogue: 0,0:04:06.39,0:04:08.69,Default,,0,0,0,,،هو دفع عقدة الخيط عبر الخاتم
Dialogue: 0,0:04:08.69,0:04:11.79,Default,,0,0,0,,ثم دفع إبهامكِ عبره وسحبه للخارج، أليس كذلك؟
Dialogue: 0,0:04:11.79,0:04:12.79,Default,,0,0,0,,!فهمت
Dialogue: 0,0:04:12.79,0:04:14.89,Default,,0,0,0,,.أنت مزعج كالعادة
Dialogue: 0,0:04:14.89,0:04:16.39,Default,,0,0,0,,.لا تهتمي به
Dialogue: 0,0:04:16.39,0:04:20.59,Default,,0,0,0,,.إنه في مزاج سيء منذ أن أخبرته أنني أريد المجيء
Dialogue: 0,0:04:20.59,0:04:23.49,Default,,0,0,0,,هل تعتقدين أن ذهابي معكِ فكرة جيدة؟
Dialogue: 0,0:04:23.49,0:04:27.49,Default,,0,0,0,,.لا مشكلة! لقد أخبرتهم بالفعل أنني سأحضر صديقتي معي
Dialogue: 0,0:04:27.49,0:04:28.99,Default,,0,0,0,,صديقتك؟
Dialogue: 0,0:04:30.99,0:04:32.79,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:04:34.19,0:04:36.39,Default,,0,0,0,,!كنتِ تتظاهرين بأنك رجل؟
Dialogue: 0,0:04:36.39,0:04:39.59,Default,,0,0,0,,!نعم! رجل بعمر 30 عامًا
Dialogue: 0,0:04:39.59,0:04:42.29,Default,,0,0,0,,!كان الأمر ممتعًا حقًا
Dialogue: 0,0:04:42.29,0:04:46.79,Default,,0,0,0,,لكن ألم يكتشفوا ذلك عندما قلتِ أن اسمك سونوكو سوزوكي؟
Dialogue: 0,0:04:46.79,0:04:48.09,Default,,0,0,0,,!لا تقلقي
Dialogue: 0,0:04:48.09,0:04:52.29,Default,,0,0,0,,.لأننا جميعًا نتواصل باستخدام أسماء مستعارة تسمى ألقاب
Dialogue: 0,0:04:52.29,0:04:55.59,Default,,0,0,0,,"مثلًا، أنا أُدعى "التلميذة الساحرة
Dialogue: 0,0:04:55.59,0:04:57.79,Default,,0,0,0,,."وهو يُدعى "الرنجة الحمراء
Dialogue: 0,0:04:57.79,0:05:00.49,Default,,0,0,0,,.إنها مفردات قديمة تُستخدم في السحر القديم
Dialogue: 0,0:05:01.19,0:05:03.29,Default,,0,0,0,,إذن، كيف تعرفين اسمه الحقيقي؟
Dialogue: 0,0:05:03.29,0:05:05.49,Default,,0,0,0,,.سألته مباشرة عبر البريد الإلكتروني
Dialogue: 0,0:05:05.49,0:05:08.69,Default,,0,0,0,,.إذن، لا زلتِ صريحة كعادتك
Dialogue: 0,0:05:08.69,0:05:10.29,Default,,0,0,0,,.أنتِ تعرفنين
Dialogue: 0,0:05:10.99,0:05:15.19,Default,,0,0,0,,.ما رأيكِ؟، الأشخاص الذين يتواصلون عبر الإنترنت\Nولم يروا بعضهم البعض من قبل، سيجتمعون فجأة
Dialogue: 0,0:05:16.19,0:05:18.39,Default,,0,0,0,,أليس هذا مثيرًا؟
Dialogue: 0,0:05:18.39,0:05:19.29,Default,,0,0,0,,!بالتأكيد
Dialogue: 0,0:05:19.29,0:05:23.49,Default,,0,0,0,,.إنه مثل الذهاب إلى حفلة تنكرية
Dialogue: 0,0:05:26.49,0:05:29.39,Default,,0,0,0,, إلا تشمون رائحة غريبة هنا؟
Dialogue: 0,0:05:36.19,0:05:39.59,Default,,0,0,0,,.مرحبًا. أنا هنا من أجل الاجتماع
Dialogue: 0,0:05:40.19,0:05:41.59,Default,,0,0,0,,.أهلاً بكِ
Dialogue: 0,0:05:41.59,0:05:44.89,Default,,0,0,0,,أوه، أنتِ "تلميذة الساحرة"، أليس كذلك؟
Dialogue: 0,0:05:44.89,0:05:45.89,Default,,0,0,0,,.نعم
Dialogue: 0,0:05:45.89,0:05:47.89,Default,,0,0,0,,!كنا ننتظركِ
Dialogue: 0,0:05:47.89,0:05:50.29,Default,,0,0,0,,كيف عرفتِ؟
Dialogue: 0,0:05:50.29,0:05:53.39,Default,,0,0,0,,أنني "التلميذة الساحرة"؟
Dialogue: 0,0:05:53.39,0:05:56.79,Default,,0,0,0,,.اكتشفت ذلك بمجرد أن رأيت كيف تتحدثين
Dialogue: 0,0:05:56.79,0:06:00.79,Default,,0,0,0,,.كان من الواضح أنها فتاة تحاول التظاهر بأنها رجل أكبر سنًا
Dialogue: 0,0:06:00.79,0:06:01.99,Default,,0,0,0,,أليس كذلك، يا جماعة؟
Dialogue: 0,0:06:01.99,0:06:05.99,Default,,0,0,0,,.نعم، كان مضحكًا من الجانب الآخر من الشاشة
Dialogue: 0,0:06:05.99,0:06:07.09,Default,,0,0,0,,.نعم، نعم
Dialogue: 0,0:06:07.09,0:06:09.19,Default,,0,0,0,,.تبا
Dialogue: 0,0:06:09.19,0:06:10.29,Default,,0,0,0,,،إذا كنتِ ستقومين بشيء كهذا
Dialogue: 0,0:06:10.29,0:06:13.09,Default,,0,0,0,,.فعليكِ أن تفعليه بشكل جيد مثل الآنسة تاناكا
Dialogue: 0,0:06:13.09,0:06:14.49,Default,,0,0,0,,...بخصوص ذلك
Dialogue: 0,0:06:14.49,0:06:19.19,Default,,0,0,0,,.لم أكن أحاول التظاهر بأنني رجل كما تقول
Dialogue: 0,0:06:19.19,0:06:21.59,Default,,0,0,0,,"على العكس، اعتقدت أن "الأرنب المتلاشي
Dialogue: 0,0:06:21.59,0:06:23.99,Default,,0,0,0,,.كان امرأة
Dialogue: 0,0:06:23.99,0:06:26.99,Default,,0,0,0,,.حقًا؟ أنا سعيد لأنني قمت بعمل جيد
Dialogue: 0,0:06:26.99,0:06:29.29,Default,,0,0,0,,ماذا تقصد بعمل جيد؟
Dialogue: 0,0:06:29.29,0:06:31.99,Default,,0,0,0,,اعتقدت أنه كان امرأة
Dialogue: 0,0:06:31.99,0:06:36.69,Default,,0,0,0,,.حتى أنني تحدثت معه عن الملابس الداخلية
Dialogue: 0,0:06:36.69,0:06:40.39,Default,,0,0,0,,.نعم، كنت محرجًا عندما فعلتِ ذلك
Dialogue: 0,0:06:40.39,0:06:42.49,Default,,0,0,0,,، دعيني أقدم نفسي
Dialogue: 0,0:06:42.49,0:06:46.59,Default,,0,0,0,,.أنا يوشينوري آرا، صاحب هذا المكان
Dialogue: 0,0:06:46.59,0:06:50.99,Default,,0,0,0,,.وخلفي هو الموظف المؤقت الذي وظفته، السيد سوغاما
Dialogue: 0,0:06:50.99,0:06:52.39,Default,,0,0,0,,.مرحبًا
Dialogue: 0,0:06:52.39,0:06:54.09,Default,,0,0,0,,.أهلاً
Dialogue: 0,0:06:54.09,0:06:56.29,Default,,0,0,0,,...كا... كاتسوكي
Dialogue: 0,0:06:56.29,0:06:59.19,Default,,0,0,0,,ألم يصل السيد "الرنجة الحمراء" بعد؟
Dialogue: 0,0:06:59.19,0:07:02.39,Default,,0,0,0,, إنه في الطابق العلوي.
Dialogue: 0,0:07:02.39,0:07:04.39,Default,,0,0,0,,.ها هو يأتي، نازلاً الدرج
Dialogue: 0,0:07:10.09,0:07:12.79,Default,,0,0,0,,هل أنتِ "التلميذة الساحرة"؟
Dialogue: 0,0:07:12.79,0:07:15.59,Default,,0,0,0,,!أنا كاتسوكي دويتو
Dialogue: 0,0:07:15.59,0:07:17.19,Default,,0,0,0,,...مستحيل
Dialogue: 0,0:07:17.19,0:07:19.69,Default,,0,0,0,,...الصورة الذهنية التي كونتها
Dialogue: 0,0:07:20.59,0:07:24.49,Default,,0,0,0,,!إذن، كنتِ فتاة بعد كل هذا
Dialogue: 0,0:07:24.49,0:07:26.29,Default,,0,0,0,,.كم هذا مثير
Dialogue: 0,0:07:27.09,0:07:29.09,Default,,0,0,0,,بالمناسبة، من أنتم؟
Dialogue: 0,0:07:29.09,0:07:31.89,Default,,0,0,0,,.أنا ران موري، التي دُعيت للحضور معها
Dialogue: 0,0:07:31.89,0:07:34.29,Default,,0,0,0,,.وأنا والدها، الذي جاء لإيصالهن
Dialogue: 0,0:07:34.29,0:07:36.49,Default,,0,0,0,,.المعذرة لكم
Dialogue: 0,0:07:36.49,0:07:38.09,Default,,0,0,0,,.من فضلكم، ادخلوا
Dialogue: 0,0:07:39.19,0:07:41.39,Default,,0,0,0,,.دعني أحمل الحقائب عنك
Dialogue: 0,0:07:41.39,0:07:42.99,Default,,0,0,0,,،أنا متأكد أن نيتك حسنة
Dialogue: 0,0:07:42.99,0:07:45.69,Default,,0,0,0,,.لكن دعني أحذرك من التصرف بطريقة غير لائقة مع الفتيات
Dialogue: 0,0:07:45.69,0:07:49.59,Default,,0,0,0,,!أبي -\N.يمكنك أن تطمئن -
Dialogue: 0,0:07:49.59,0:07:51.09,Default,,0,0,0,,!انت
Dialogue: 0,0:07:51.89,0:07:52.99,Default,,0,0,0,,!سنعود إلى المنزل
Dialogue: 0,0:07:52.99,0:07:55.39,Default,,0,0,0,,!أريد البقاء أيضًا
Dialogue: 0,0:07:55.39,0:07:59.29,Default,,0,0,0,,أحمق، ألا ترى أنك مصاب بالبرد؟
Dialogue: 0,0:07:59.29,0:08:02.39,Default,,0,0,0,,.إذن، اعتنوا بابنتي وصديقتها من فضلكم
Dialogue: 0,0:08:02.39,0:08:03.79,Default,,0,0,0,,،حاضر
Dialogue: 0,0:08:05.29,0:08:08.29,Default,,0,0,0,,إذن، الأشخاص الذين لم يصلوا بعد
Dialogue: 0,0:08:08.29,0:08:12.39,Default,,0,0,0,,."هما قائد المجموعة "ملك الهروب" و"الظل
Dialogue: 0,0:08:12.39,0:08:15.89,Default,,0,0,0,,ماذا؟ هل "الظل" سيحضر أيضًا؟
Dialogue: 0,0:08:15.89,0:08:18.29,Default,,0,0,0,,ما الأمر، سونوكو؟
Dialogue: 0,0:08:18.29,0:08:20.09,Default,,0,0,0,,"حسنًا، "الظل
Dialogue: 0,0:08:20.09,0:08:25.09,Default,,0,0,0,,."دائمًا ما يكتب أشياء غريبة مثل، "أستطيع الطيران
Dialogue: 0,0:08:25.09,0:08:27.69,Default,,0,0,0,,."أو "أستطيع الاختفاء متى شئت
Dialogue: 0,0:08:28.69,0:08:32.49,Default,,0,0,0,,...على أي حال، لا يمكننا البدء بدون القائد
Dialogue: 0,0:08:32.49,0:08:36.79,Default,,0,0,0,,هل يعرف أحد رقم هاتف "ملك الهروب"؟
Dialogue: 0,0:08:36.79,0:08:40.69,Default,,0,0,0,,.أعرفه، وكذلك اسمه الحقيقي
Dialogue: 0,0:08:44.59,0:08:46.29,Default,,0,0,0,,!هذا منزل عائلة نيشياما
Dialogue: 0,0:08:46.29,0:08:48.09,Default,,0,0,0,,.لا يمكنني الرد على الهاتف الآن
Dialogue: 0,0:08:48.09,0:08:51.19,Default,,0,0,0,,.ماذا؟ إنه جهاز الرد الآلي
Dialogue: 0,0:08:51.19,0:08:53.59,Default,,0,0,0,,.من فضلك اترك رسالة بعد الصوت
Dialogue: 0,0:08:59.89,0:09:04.39,Default,,0,0,0,,.ليس لدينا خيار، دعونا نستمتع حتى يصل
Dialogue: 0,0:09:04.39,0:09:08.19,Default,,0,0,0,,،سأجهز العشاء مع السيد سوغاما
Dialogue: 0,0:09:08.19,0:09:11.89,Default,,0,0,0,,لذا لماذا لا تذهبون جميعًا إلى غرفكم وتغيرون الملاءات؟
Dialogue: 0,0:09:11.89,0:09:13.79,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:09:13.79,0:09:16.79,Default,,0,0,0,,!رائعة! ما هذه الحديقة الخلفية الكبيرة
Dialogue: 0,0:09:16.79,0:09:18.19,Default,,0,0,0,,.كم هذا جميل
Dialogue: 0,0:09:18.19,0:09:19.89,Default,,0,0,0,,.أنا سعيدة أننا جئنا
Dialogue: 0,0:09:21.19,0:09:23.49,Default,,0,0,0,,،لو كان السيد دويتو كما تخيلته
Dialogue: 0,0:09:23.49,0:09:25.89,Default,,0,0,0,,.لكان الأمر مثاليًا
Dialogue: 0,0:09:25.89,0:09:28.39,Default,,0,0,0,,.مهلا، مهلا، لا تكوني هكذا
Dialogue: 0,0:09:33.09,0:09:36.69,Default,,0,0,0,,.العشاء جاهز
Dialogue: 0,0:09:36.69,0:09:37.79,Default,,0,0,0,,.حـ...حسناً
Dialogue: 0,0:09:42.09,0:09:43.59,Default,,0,0,0,,.لقد أخافني
Dialogue: 0,0:09:43.59,0:09:46.19,Default,,0,0,0,,.تبا، لا يوجد رجل لائق هنا
Dialogue: 0,0:09:46.19,0:09:51.69,Default,,0,0,0,,.حسنًا، لا يهم. في النهاية، أنا أحب رجلًا واحدًا فقط
Dialogue: 0,0:09:51.69,0:09:53.99,Default,,0,0,0,,لديكِ شخص تحبينه؟
Dialogue: 0,0:09:53.99,0:09:58.09,Default,,0,0,0,,.نعم، أميري الذي لم أقابله بعد
Dialogue: 0,0:09:58.89,0:10:01.89,Default,,0,0,0,,إذن، ماذا عن عشائي؟
Dialogue: 0,0:10:01.89,0:10:04.69,Default,,0,0,0,,.سأعد لك بعض العصيدة أو شيء ما
Dialogue: 0,0:10:04.69,0:10:06.39,Default,,0,0,0,,.نم حتى نعود إلى المنزل
Dialogue: 0,0:10:06.59,0:10:09.99,Default,,0,0,0,,السيد تسوتومو نيشياما، 41 عامًا، مقيم في حي هايدو
Dialogue: 0,0:10:09.99,0:10:12.09,Default,,0,0,0,,.وجد ميتًا في شقته
Dialogue: 0,0:10:12.09,0:10:14.09,Default,,0,0,0,,والدته التي جاءت لتنظيف الشقة
Dialogue: 0,0:10:14.09,0:10:16.09,Default,,0,0,0,,.أبلغت الشرطة بوفاته
Dialogue: 0,0:10:16.09,0:10:18.29,Default,,0,0,0,,".عبارة غامضة، "هو ليس سوى الأول... من الظل
Dialogue: 0,0:10:18.29,0:10:20.39,Default,,0,0,0,,وجدت معروضة على الشاشة
Dialogue: 0,0:10:20.39,0:10:22.69,Default,,0,0,0,,.لجهاز الكمبيوتر الشخصي القريب
Dialogue: 0,0:10:22.69,0:10:23.69,Default,,0,0,0,,الشرطة
Dialogue: 0,0:10:23.69,0:10:26.19,Default,,0,0,0,,.تحقق في صلة هذه العبارة بوفاته
Dialogue: 0,0:10:26.19,0:10:29.19,Default,,0,0,0,,،يبدو أن السيد نيشياما كان مهتمًا بالإنترنت
Dialogue: 0,0:10:29.19,0:10:31.79,Default,,0,0,0,,وكان على وشك المغادرة لحضور اجتماع
Dialogue: 0,0:10:31.79,0:10:33.59,Default,,0,0,0,,مع مجموعة عشاق السحر
Dialogue: 0,0:10:33.59,0:10:35.29,Default,,0,0,0,,.قبل وقوع هذه المأساة
Dialogue: 0,0:10:36.89,0:10:38.29,Default,,0,0,0,,...الخبر التالي هو
Dialogue: 0,0:10:39.59,0:10:42.79,Default,,0,0,0,,.مهلا، ايعقل انه يقصد الاجتماع الذي تشارك فيه ران الآن
Dialogue: 0,0:10:42.79,0:10:44.39,Default,,0,0,0,,.عمي، دعنا نعود فورًا إلى هناك
Dialogue: 0,0:10:44.39,0:10:45.49,Default,,0,0,0,,!بسرعة
Dialogue: 0,0:10:46.09,0:10:49.19,Default,,0,0,0,,ماذا؟ ساحر ياباني أحترمه؟
Dialogue: 0,0:10:49.19,0:10:52.59,Default,,0,0,0,,.أحببت السيد تويشي كوروبان
Dialogue: 0,0:10:52.59,0:10:55.89,Default,,0,0,0,,.كانت عروضه مليئة بالأمل والحلم
Dialogue: 0,0:10:55.89,0:10:58.29,Default,,0,0,0,,!نعم! أنا أيضًا أحب السيد كوروبان
Dialogue: 0,0:10:58.29,0:11:02.59,Default,,0,0,0,,.أنا أحب يوشيرو كينوشيتا
Dialogue: 0,0:11:02.59,0:11:04.49,Default,,0,0,0,,عبقري سرق كل الألقاب
Dialogue: 0,0:11:04.49,0:11:06.99,Default,,0,0,0,,.في سن العشرين فقط
Dialogue: 0,0:11:06.99,0:11:11.09,Default,,0,0,0,,.أنا أحب معلمه، السيد موتوياسو تسوكومو
Dialogue: 0,0:11:11.09,0:11:14.19,Default,,0,0,0,,.ما خطبكم جميعًا؟ كلهم ماتوا بالفعل
Dialogue: 0,0:11:14.19,0:11:17.19,Default,,0,0,0,,!أنا أحب السيد كازومي سانادا المشهور جدًا الآن
Dialogue: 0,0:11:17.19,0:11:18.59,Default,,0,0,0,,ماذا عنكما أنتما؟
Dialogue: 0,0:11:18.59,0:11:21.09,Default,,0,0,0,,بالطبع، من غيرُ
Dialogue: 0,0:11:21.09,0:11:23.19,Default,,0,0,0,,!الامير كايتو كيد
Dialogue: 0,0:11:23.19,0:11:24.69,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:11:24.69,0:11:26.89,Default,,0,0,0,,.لكنه لص
Dialogue: 0,0:11:26.89,0:11:29.89,Default,,0,0,0,,!بغض النظر عما يقوله أي شخص، بالنسبة لي فهو كايتو كيد
Dialogue: 0,0:11:29.89,0:11:32.59,Default,,0,0,0,,...لا تخبريني أن الأمير الذي تحبينه هو
Dialogue: 0,0:11:32.59,0:11:34.09,Default,,0,0,0,,نعم، هل يزعجك ذلك؟
Dialogue: 0,0:11:34.09,0:11:35.89,Default,,0,0,0,,!بسرعة، عمي، أسرع
Dialogue: 0,0:11:35.89,0:11:38.99,Default,,0,0,0,,!اصمت! أنا أسير بأقصى سرعة
Dialogue: 0,0:11:38.99,0:11:41.09,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:11:41.09,0:11:42.79,Default,,0,0,0,,حريق؟
Dialogue: 0,0:11:47.69,0:11:49.89,Default,,0,0,0,,!الجسر يحترق
Dialogue: 0,0:11:49.89,0:11:53.99,Default,,0,0,0,,!الطريق الوحيد للوصول إلى المكان هو عبر هذا الجسر
Dialogue: 0,0:11:55.09,0:11:57.79,Default,,0,0,0,,.عمي، اتصل بالشرطة
Dialogue: 0,0:11:59.89,0:12:01.09,Default,,0,0,0,,!مهلا
Dialogue: 0,0:12:01.09,0:12:02.19,Default,,0,0,0,,،ران
Dialogue: 0,0:12:02.19,0:12:03.29,Default,,0,0,0,,!انتظريني
Dialogue: 0,0:12:06.99,0:12:08.69,Default,,0,0,0,,!ران
Dialogue: 0,0:12:10.39,0:12:11.59,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:12:11.59,0:12:13.19,Default,,0,0,0,,...غريب
Dialogue: 0,0:12:13.19,0:12:15.19,Default,,0,0,0,,.الهاتف لا يعمل
Dialogue: 0,0:12:15.89,0:12:17.49,Default,,0,0,0,,ما الخطب يا ران؟
Dialogue: 0,0:12:17.49,0:12:21.09,Default,,0,0,0,,.شعرت وكأن أحدًا ناداني
Dialogue: 0,0:12:21.09,0:12:23.59,Default,,0,0,0,,أحد يناديك في الجبال هكذا؟
Dialogue: 0,0:12:23.59,0:12:25.69,Default,,0,0,0,,.سأذهب لأتفقد المدخل
Dialogue: 0,0:12:26.99,0:12:29.59,Default,,0,0,0,,.هل أنتِ مجنونة؟ لا أحد سيأتي إلى هنا
Dialogue: 0,0:12:35.99,0:12:38.59,Default,,0,0,0,,كونان؟ -\Nماذا؟ -
Dialogue: 0,0:12:40.19,0:12:42.99,Default,,0,0,0,,لماذا هو مستلقي على الأرض هنا؟
Dialogue: 0,0:12:44.19,0:12:45.79,Default,,0,0,0,,.لديه حمى شديدة
Dialogue: 0,0:12:45.79,0:12:47.19,Default,,0,0,0,,...ران
Dialogue: 0,0:12:47.19,0:12:48.79,Default,,0,0,0,,.اخرجي من هنا
Dialogue: 0,0:12:48.79,0:12:52.49,Default,,0,0,0,,.بسرعة، اخرجي من هنا
Dialogue: 0,0:12:53.99,0:12:55.99,Default,,0,0,0,,!كونان
Dialogue: 0,0:12:55.99,0:12:57.89,Default,,0,0,0,,!تماسك يا كونان
Dialogue: 0,0:12:57.89,0:13:01.19,Default,,0,0,0,,!كونان! كونان
Dialogue: 0,0:13:06.78,0:13:07.78,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:07.78,0:13:09.88,Default,,0,0,0,,ذلك الطفل كان مستلقيًا على الأرض عند المدخل؟
Dialogue: 0,0:13:09.88,0:13:12.08,Default,,0,0,0,,لكن، لماذا؟
Dialogue: 0,0:13:12.08,0:13:14.58,Default,,0,0,0,,.ربما أراد البقاء هنا ليلاً
Dialogue: 0,0:13:14.58,0:13:16.48,Default,,0,0,0,,.لا أعتقد ذلك
Dialogue: 0,0:13:18.08,0:13:20.78,Default,,0,0,0,,...كان كونان يقول
Dialogue: 0,0:13:20.78,0:13:22.18,Default,,0,0,0,,"."اخرجي من هنا
Dialogue: 0,0:13:23.58,0:13:25.88,Default,,0,0,0,,"."بسرعة، اخرجي من هنا
Dialogue: 0,0:13:29.08,0:13:31.08,Default,,0,0,0,,ما... ما الذي يعنيه هذا؟
Dialogue: 0,0:13:31.08,0:13:34.98,Default,,0,0,0,,.لا أعرف. لقد أغمي عليه بعد أن قال ذلك
Dialogue: 0,0:13:35.88,0:13:38.48,Default,,0,0,0,,.أحضرت دواءً للحرارة
Dialogue: 0,0:13:38.48,0:13:40.78,Default,NTP,,0000,0000,0000,،يبدو أنه يعاني من نزلة برد عادية
Dialogue: 0,0:13:40.78,0:13:44.88,Default,,0,0,0,,.لذا أنا متأكد أنه سيكون بخير إذا شرب هذا واستراح
Dialogue: 0,0:13:44.88,0:13:46.08,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:13:46.08,0:13:48.48,Default,,0,0,0,, على الرحب والسعة -\N كيف عرفت؟ -
Dialogue: 0,0:13:48.48,0:13:49.98,Default,,0,0,0,,،قد لا أبدو كذلك
Dialogue: 0,0:13:49.98,0:13:52.78,Default,,0,0,0,,.لكني طالب في كلية الطب
Dialogue: 0,0:13:52.78,0:13:56.38,Default,,0,0,0,,.حسنًا، لنجرب الاتصال بقائد المجموعة مرة أخرى
Dialogue: 0,0:13:56.38,0:13:58.08,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:58.08,0:14:01.78,Default,,0,0,0,,ماذا تقصد لا يمكنك فعل أي شيء حتى الصباح، أيها المفتش؟
Dialogue: 0,0:14:01.78,0:14:04.38,Default,,0,0,0,,.لا تصرخ هكذا، موري
Dialogue: 0,0:14:04.38,0:14:08.98,Default,,0,0,0,,،تخطيط طريق آخر عبر تلك الجبال ليلاً خطر جدًا
Dialogue: 0,0:14:08.98,0:14:10.38,Default,,0,0,0,,وحتى إرسال مروحية 
Dialogue: 0,0:14:10.38,0:14:15.48,Default,,0,0,0,,.قد يعرضنا لخطر الاصطدام بالأشجار وخطوط الكهرباء في وقت متأخر مثل هذا
Dialogue: 0,0:14:15.48,0:14:18.18,Default,,0,0,0,,إذن هل يمكنك على الأقل محاولة الاتصال بهم؟
Dialogue: 0,0:14:18.18,0:14:22.48,Default,,0,0,0,,.كنا نحاول منذ فترة، لكن خط الهاتف مشغول أو مقطوع
Dialogue: 0,0:14:22.48,0:14:25.58,Default,,0,0,0,,!سأكون هناك قريبًا، لذا ابقوا مكانكم
Dialogue: 0,0:14:25.58,0:14:27.78,Default,,0,0,0,,!تبًا
Dialogue: 0,0:14:28.48,0:14:30.68,Default,,0,0,0,,.ماذا؟ الهاتف لا يعمل
Dialogue: 0,0:14:30.68,0:14:34.18,Default,,0,0,0,,ربما خط الهاتف مقطوع في مكان ما؟
Dialogue: 0,0:14:34.18,0:14:36.58,Default,,0,0,0,,.نحن حقًا في مأزق
Dialogue: 0,0:14:36.58,0:14:37.98,Default,,0,0,0,,كان هو المسؤول عن التخطيط لكل شيء
Dialogue: 0,0:14:37.98,0:14:40.78,Default,,0,0,0,,...الذي كان من المقرر حدوثه الليلة، لذا
Dialogue: 0,0:14:40.78,0:14:44.18,Default,,0,0,0,,هل نختار قائدًا مؤقتًا إذن؟
Dialogue: 0,0:14:44.18,0:14:45.38,Default,,0,0,0,,.أعتقد ذلك
Dialogue: 0,0:14:45.38,0:14:48.28,Default,,0,0,0,,.لا أريد أن أكون القائد الآن
Dialogue: 0,0:14:48.28,0:14:50.48,Default,,0,0,0,,ماذا لو لعبنا حجرة ورقة مقص؟
Dialogue: 0,0:14:50.48,0:14:51.88,Default,,0,0,0,,،مهلا، انتظروا
Dialogue: 0,0:14:51.88,0:14:54.18,Default,,0,0,0,,.مجرد الاختيار ليس ممتعًا
Dialogue: 0,0:14:54.18,0:14:57.98,Default,,0,0,0,,لماذا لا نقرر كما يفعل عشاق السحر؟
Dialogue: 0,0:14:57.98,0:14:59.88,Default,,0,0,0,,بالسحر؟
Dialogue: 0,0:14:59.88,0:15:02.28,Default,,0,0,0,,.من فضلكِ ساعديني إذن
Dialogue: 0,0:15:02.28,0:15:05.08,Default,,0,0,0,, أنا؟
Dialogue: 0,0:15:05.08,0:15:06.48,Default,,0,0,0,,.نعم
Dialogue: 0,0:15:07.88,0:15:14.38,Default,,0,0,0,,.أولاً، سأغطي عيني سونوكو الجميلة بهذا المنديل
Dialogue: 0,0:15:15.48,0:15:18.38,Default,,0,0,0,,هل مع أحدكم ورقة وقلم؟
Dialogue: 0,0:15:18.38,0:15:21.28,Default,,0,0,0,, ماذا عن هذا، أيها الساحر؟
Dialogue: 0,0:15:21.28,0:15:22.28,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:15:22.28,0:15:26.28,Default,,0,0,0,,.من فضلكم، خذوا ورقة واحدة لكل منكم واكتبوا أسماءكم عليها
Dialogue: 0,0:15:26.28,0:15:27.38,Default,,0,0,0,,.نعم، نعم
Dialogue: 0,0:15:31.38,0:15:33.38,Default,,0,0,0,,،بعد كتابة جميع الأسماء، اجمعوها
Dialogue: 0,0:15:33.38,0:15:36.38,Default,,0,0,0,,.اقلبوها وأعطوها لسونوكو
Dialogue: 0,0:15:36.38,0:15:39.58,Default,,0,0,0,,.إذن هؤلاء هم جميع الأعضاء الموجودين هنا
Dialogue: 0,0:15:42.68,0:15:44.48,Default,,0,0,0,,.تفضلي، يا سونوكو
Dialogue: 0,0:15:44.48,0:15:46.18,Default,,0,0,0,,.أعطوها القلم أيضًا
Dialogue: 0,0:15:46.18,0:15:48.08,Default,,0,0,0,,.حسنًا، تفضلي
Dialogue: 0,0:15:48.08,0:15:51.18,Default,,0,0,0,,.من فضلكم، تراجعوا للخلف جميعًا
Dialogue: 0,0:15:51.18,0:15:52.38,Default,,0,0,0,,.سونوكو
Dialogue: 0,0:15:52.38,0:15:53.88,Default,,0,0,0,,،بدون أن تري أحدًا
Dialogue: 0,0:15:53.88,0:15:57.58,Default,,0,0,0,,!ضعي دائرة أو علامة أكس أو مثلث على الأوراق
Dialogue: 0,0:15:57.58,0:15:59.38,Default,,0,0,0,,دائرة، علامة اكس ومثلث؟
Dialogue: 0,0:15:59.38,0:16:01.38,Default,,0,0,0,,.من يحصل على الدائرة يصبح القائد المؤقت
Dialogue: 0,0:16:01.38,0:16:02.28,Default,,0,0,0,,من يحصل على علامة الاكس 
Dialogue: 0,0:16:02.28,0:16:05.28,Default,,0,0,0,,.يكون قائداً عن إحياء الاجتماع الليلة
Dialogue: 0,0:16:05.28,0:16:06.98,Default,,0,0,0,,ومن يحصل على المثلث
Dialogue: 0,0:16:06.98,0:16:09.78,Default,,0,0,0,,.يمكنه تحضير الحمام أو شيء ما
Dialogue: 0,0:16:09.78,0:16:12.38,Default,,0,0,0,,.سأذهب لأحضر الحمام
Dialogue: 0,0:16:12.38,0:16:13.88,Default,,0,0,0,,.لا بأس
Dialogue: 0,0:16:13.88,0:16:14.78,Default,,0,0,0,,،إنها لعبة
Dialogue: 0,0:16:14.78,0:16:17.78,Default,,0,0,0,,.لذا من الممتع أن يكون هناك عقوبات
Dialogue: 0,0:16:17.78,0:16:20.28,Default,,0,0,0,,!لقد انتهيت من وضع العلامات على الأوراق
Dialogue: 0,0:16:20.28,0:16:24.08,Default,,0,0,0,,.من فضلكم، ضعوا ورقة أحدهم على الطاولة
Dialogue: 0,0:16:24.08,0:16:26.88,Default,,0,0,0,,.تأكدوا من أن الاسم في الأسفل
Dialogue: 0,0:16:30.48,0:16:33.68,Default,,0,0,0,,.حسنًا، لنرى من سيكون القائد
Dialogue: 0,0:16:33.68,0:16:34.98,Default,,0,0,0,,!انتظر
Dialogue: 0,0:16:34.98,0:16:37.78,Default,,0,0,0,,سأتنبأ باسم الشخص المكتوب على هذه الورقة
Dialogue: 0,0:16:37.78,0:16:39.58,Default,,0,0,0,,!قبل أن تقلبوها
Dialogue: 0,0:16:39.58,0:16:40.68,Default,,0,0,0,,تنبأ؟
Dialogue: 0,0:16:41.78,0:16:44.68,Default,,0,0,0,,...إذا كان حدسي صحيحًا
Dialogue: 0,0:16:45.68,0:16:48.88,Default,,0,0,0,,!القائد المؤقت هو أنتِ، ناوكو كورودا
Dialogue: 0,0:16:49.88,0:16:51.18,Default,,0,0,0,,.لا يمكن أن يكون
Dialogue: 0,0:16:52.88,0:16:54.58,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:16:54.58,0:16:56.18,Default,,0,0,0,,.إنه محق
Dialogue: 0,0:16:56.18,0:16:59.08,Default,,0,0,0,,،التالي، الشخص الذي سيحضر الحمام
Dialogue: 0,0:16:59.08,0:17:00.48,Default,,0,0,0,,!كيكوي تاناكا، إنها أنتِ
Dialogue: 0,0:17:00.48,0:17:02.78,Default,,0,0,0,, أنا؟
Dialogue: 0,0:17:04.18,0:17:06.78,Default,,0,0,0,,!رائع! لقد خمنها
Dialogue: 0,0:17:06.78,0:17:08.18,Default,,0,0,0,,!انظري
Dialogue: 0,0:17:08.18,0:17:09.98,Default,,0,0,0,,.نعم
Dialogue: 0,0:17:10.68,0:17:13.68,Default,,0,0,0,,.أتمنى ألا تكون الأوراق الحقيقية مخبأة في مكان آخر
Dialogue: 0,0:17:13.68,0:17:15.98,Default,,0,0,0,,،مستحيل. لقد رأيتم بأنفسكم
Dialogue: 0,0:17:15.98,0:17:18.88,Default,,0,0,0,,لم ألمس الأوراق أبدًا
Dialogue: 0,0:17:18.88,0:17:20.28,Default,,0,0,0,,والشخص الذي وضع العلامات
Dialogue: 0,0:17:20.28,0:17:22.88,Default,,0,0,0,,.هي سونوكو التي كانت معصوبة العينين
Dialogue: 0,0:17:24.68,0:17:25.88,Default,,0,0,0,,،فهمت
Dialogue: 0,0:17:25.88,0:17:28.38,Default,,0,0,0,,.سواء كان تحضير الحمام أو أي شيء آخر، سأفعله
Dialogue: 0,0:17:28.38,0:17:29.58,Default,,0,0,0,,.آسف
Dialogue: 0,0:17:31.08,0:17:33.88,Default,,0,0,0,,هل تعرفين أين يوجد الحطب؟
Dialogue: 0,0:17:33.88,0:17:38.58,Default,,0,0,0,,.لا تقلق، لقد تجولنا جميعًا في المكان عندما وصلنا
Dialogue: 0,0:17:42.78,0:17:45.58,Default,,0,0,0,,.الآن، كل ما تبقى هو علامة الاكس
Dialogue: 0,0:17:45.58,0:17:48.08,Default,,0,0,0,,...الشخص المسؤول عن اجتماع الليلة هو
Dialogue: 0,0:17:48.08,0:17:49.48,Default,,0,0,0,,!أنت، السيد دويتو
Dialogue: 0,0:17:49.48,0:17:52.88,Default,,0,0,0,,...لا بد أنك تمزح
Dialogue: 0,0:17:52.88,0:17:54.18,Default,,0,0,0,,.لنرى
Dialogue: 0,0:17:54.98,0:17:56.18,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:17:57.68,0:17:59.48,Default,,0,0,0,,...اسم الشخص المسؤول هو
Dialogue: 0,0:17:59.48,0:18:02.68,Default,,0,0,0,,.اسمك مكتوب، السيد هامانو
Dialogue: 0,0:18:04.28,0:18:05.88,Default,,0,0,0,,.انظر، لا يوجد خطأ في ذلك
Dialogue: 0,0:18:05.88,0:18:08.68,Default,,0,0,0,,.هذا غريب
Dialogue: 0,0:18:08.68,0:18:12.18,Default,,0,0,0,,!حسنًا، إذن اذهب إلى غرفتك وفكر في شيء ممتع
Dialogue: 0,0:18:12.18,0:18:14.98,Default,,0,0,0,,!حاول ألا تفوت أي شيء
Dialogue: 0,0:18:14.98,0:18:16.78,Default,,0,0,0,,...حسنًا، حسنًا
Dialogue: 0,0:18:17.88,0:18:23.68,Default,,0,0,0,,.لكن ماذا أفعل؟ آخر مرة كنت قائدة كانت عندما كنتُ في فريق الكشافة
Dialogue: 0,0:18:23.68,0:18:26.28,Default,,0,0,0,,.لا تقلقي، هذا مؤقت فقط
Dialogue: 0,0:18:26.28,0:18:29.98,Default,,0,0,0,,.سأذهب لأختار نبيذًا جيدًا من القبو
Dialogue: 0,0:18:29.98,0:18:33.88,Default,,0,0,0,,!سيد سوغاما، من فضلك أحضر لنا بعض الوجبات الخفيفة التي يمكننا تناولها
Dialogue: 0,0:18:33.88,0:18:34.98,Default,,0,0,0,,.نعم
Dialogue: 0,0:18:34.98,0:18:38.08,Default,,0,0,0,,.نحن نعتمد عليكِ، أيتها الفائدة
Dialogue: 0,0:18:38.08,0:18:39.48,Default,,0,0,0,,...حسنًا، إذن
Dialogue: 0,0:18:39.48,0:18:43.38,Default,,0,0,0,,سونوكو، هل يمكنكِ الذهاب لتفقدي الصبي المريض في الفراش؟
Dialogue: 0,0:18:43.38,0:18:46.38,Default,,0,0,0,,.نعم! فهمت
Dialogue: 0,0:18:46.38,0:18:49.48,Default,,0,0,0,,هل نرتب أكواب الزجاج على الطاولة إذن؟
Dialogue: 0,0:18:49.48,0:18:50.48,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:18:54.08,0:18:56.28,Default,,0,0,0,,كيف حال كونان؟
Dialogue: 0,0:18:56.28,0:18:57.38,Default,,0,0,0,,.نعم
Dialogue: 0,0:18:57.38,0:18:59.68,Default,,0,0,0,,،يبدو أن حرارته انخفضت قليلاً
Dialogue: 0,0:18:59.68,0:19:01.78,Default,,0,0,0,,.بفضل دواء السيد دويتو
Dialogue: 0,0:19:01.78,0:19:03.58,Default,,0,0,0,,.أنا سعيدة
Dialogue: 0,0:19:03.58,0:19:06.58,Default,,0,0,0,,،لا أعتقد أنه سيئ
Dialogue: 0,0:19:06.58,0:19:08.38,Default,,0,0,0,,.كما ذكرتِ، سونوكو
Dialogue: 0,0:19:08.38,0:19:13.18,Default,,0,0,0,,.حسنًا، لقد أثار اهتمامي قليلاً أنه طالب طب
Dialogue: 0,0:19:13.18,0:19:17.28,Default,,0,0,0,,!لكن، كنت أتمنى لو رأيتِ سحر السيد هامانو، يا ران
Dialogue: 0,0:19:17.28,0:19:22.38,Default,,0,0,0,,.رغم أنه أخطأ في النهاية، إلا أنه كان رائعًا حقًا
Dialogue: 0,0:19:22.38,0:19:26.08,Default,,0,0,0,,.سيفعل شيئًا خلال الاجتماع أيضًا، لذا تعالي إلى الطابق السفلي لمشاهدته، يا ران
Dialogue: 0,0:19:26.08,0:19:27.38,Default,,0,0,0,,.لكن ماذا عن كونان
Dialogue: 0,0:19:27.38,0:19:30.08,Default,,0,0,0,,،سيكون بخير! حرارته انخفضت بالفعل
Dialogue: 0,0:19:30.08,0:19:33.48,Default,,0,0,0,,.لذا لا بأس بتركه لساعة أو ساعتين
Dialogue: 0,0:19:38.88,0:19:40.68,Default,,0,0,0,,.إذن كل شيء جاهز
Dialogue: 0,0:19:40.68,0:19:43.28,Default,,0,0,0,,!اجلسوا! اجلسوا
Dialogue: 0,0:19:44.18,0:19:46.48,Default,,0,0,0,,ماذا؟ أين الآخرون؟
Dialogue: 0,0:19:46.48,0:19:48.38,Default,,0,0,0,,السيد هامانو المسؤول عن اجتماع الليلة
Dialogue: 0,0:19:48.38,0:19:51.48,Default,,0,0,0,,!في غرفته يفكر في بعض الخدع السحرية
Dialogue: 0,0:19:51.48,0:19:53.88,Default,,0,0,0,,.السيد آرا في قبو النبيذ
Dialogue: 0,0:19:53.88,0:19:55.48,Default,,0,0,0,,.الجو بارد جدًا
Dialogue: 0,0:19:57.48,0:20:00.58,Default,,0,0,0,,"ملك الهروب" و"الظل" لم يصلوا بعد، أليس كذلك؟
Dialogue: 0,0:20:00.58,0:20:03.28,Default,,0,0,0,,هذان الاثنان لا يتفقان، لذا ربما تقابلا في مكان ما بالطريق
Dialogue: 0,0:20:03.28,0:20:04.88,Default,,0,0,0,,.وتشاجرو أو شيء من هذا القبيل
Dialogue: 0,0:20:04.88,0:20:06.68,Default,,0,0,0,,لا يتفقان؟
Dialogue: 0,0:20:06.68,0:20:10.48,Default,,0,0,0,,.نعم، تشاجرو حول ساحر ما
Dialogue: 0,0:20:10.48,0:20:14.58,Default,,0,0,0,,.حسنًا، دعونا لا نتحدث عن أمور مزعجة في مثل هذا الوقت
Dialogue: 0,0:20:14.58,0:20:16.38,Default,,0,0,0,,،"لا أعرف عن "الظل
Dialogue: 0,0:20:16.38,0:20:19.38,Default,,0,0,0,,.لكنني متأكد أن قائد المجموعة "ملك الهروب" سيأتي في الوقت المحدد
Dialogue: 0,0:20:19.38,0:20:21.68,Default,,0,0,0,,.لن يأتي
Dialogue: 0,0:20:21.68,0:20:23.58,Default,,0,0,0,,كونان؟
Dialogue: 0,0:20:23.58,0:20:27.28,Default,,0,0,0,,.لقد قُتل في شقته
Dialogue: 0,0:20:27.28,0:20:29.18,Default,,0,0,0,,قُتل؟
Dialogue: 0,0:20:29.18,0:20:31.38,Default,,0,0,0,,ماذا تقصد يا كونان؟
Dialogue: 0,0:20:31.38,0:20:34.58,Default,,0,0,0,,اسمه تسوتومو نيشياما، أليس كذلك؟
Dialogue: 0,0:20:34.58,0:20:36.78,Default,,0,0,0,,.صحيح
Dialogue: 0,0:20:36.78,0:20:39.88,Default,,0,0,0,,.إذن الأمر كما قال الراديو. لا شك في ذلك
Dialogue: 0,0:20:39.88,0:20:42.88,Default,,0,0,0,,.لقد عدت لإخباركم عنه
Dialogue: 0,0:20:42.88,0:20:45.38,Default,,0,0,0,,.وأنكم جميعًا في خطر
Dialogue: 0,0:20:45.38,0:20:48.08,Default,,0,0,0,,ماذا؟ لماذا نحن؟
Dialogue: 0,0:20:48.08,0:20:50.08,Default,,0,0,0,,كانت هناك رسالة
Dialogue: 0,0:20:50.08,0:20:53.38,Default,,0,0,0,,.على حاسوب السيد نيشياما الذي قُتل
Dialogue: 0,0:20:53.38,0:20:57.08,Default,,0,0,0,,"!تقول: "هذا مجرد البداية... من الظل
Dialogue: 0,0:20:57.08,0:20:59.38,Default,,0,0,0,,""هذا مجرد البداية... من الظل
Dialogue: 0,0:20:59.38,0:21:00.98,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:21:00.98,0:21:04.48,Default,,0,0,0,,السيد هامانو أيضًا تدخل في شجارهم
Dialogue: 0,0:21:04.48,0:21:06.48,Default,,0,0,0,,.وواجه مشاكل بسبب ذلك
Dialogue: 0,0:21:06.48,0:21:10.28,Default,,0,0,0,,.علينا إخباره بهذا أيضًا
Dialogue: 0,0:21:15.48,0:21:16.78,Default,,0,0,0,,السيد هامانو؟
Dialogue: 0,0:21:16.78,0:21:18.98,Default,,0,0,0,,.سأدخل يا سيد هامانو
Dialogue: 0,0:21:18.98,0:21:20.88,Default,,0,0,0,,.ماذا؟ إنه ليس هنا
Dialogue: 0,0:21:21.38,0:21:23.28,Default,,0,0,0,,.النافذة مفتوحة
Dialogue: 0,0:21:23.28,0:21:24.98,Default,,0,0,0,,.ايعقل
Dialogue: 0,0:21:29.68,0:21:31.68,Default,,0,0,0,,.على الأقل لم يسقط
Dialogue: 0,0:21:31.68,0:21:32.78,Default,,0,0,0,,.انظروا
Dialogue: 0,0:21:34.28,0:21:36.28,Default,,0,0,0,,.انظروا إلى ذلك
Dialogue: 0,0:21:36.28,0:21:38.78,Default,,0,0,0,,أليس هذا السيد هامانو؟ -\N!مستحيل -
Dialogue: 0,0:21:42.38,0:21:44.18,Default,,0,0,0,,!هذا مستحيل
Dialogue: 0,0:21:45.58,0:21:46.98,Default,,0,0,0,,السيد هامانو؟
Dialogue: 0,0:21:46.98,0:21:48.88,Default,,0,0,0,,ما الخطب يا سيد هامانو؟
Dialogue: 0,0:21:52.38,0:21:53.58,Default,,0,0,0,,!لا تقتربوا
Dialogue: 0,0:21:56.18,0:21:59.08,Default,,0,0,0,,.لا فائدة، إنه ميت بالفعل
Dialogue: 0,0:21:59.08,0:22:00.18,Default,,0,0,0,,!مستحيل
Dialogue: 0,0:22:00.18,0:22:03.18,Default,,0,0,0,,.بالإضافة إلى ذلك، لا نريد العبث بمسرح الجريمة أكثر مما هو عليه
Dialogue: 0,0:22:03.18,0:22:04.68,Default,,0,0,0,,مسرح الجريمة؟
Dialogue: 0,0:22:04.68,0:22:06.88,Default,,0,0,0,,ألا ترون؟
Dialogue: 0,0:22:06.88,0:22:10.28,Default,,0,0,0,,،الجثة على بعد أكثر من 10 أمتار من المكان
Dialogue: 0,0:22:10.28,0:22:14.38,Default,,0,0,0,,.والآثار الوحيدة هي آثار الرجل الذي ركض إليه للتو
Dialogue: 0,0:22:14.38,0:22:16.48,Default,,0,0,0,,...لكن إذن
Dialogue: 0,0:22:16.48,0:22:22.08,Default,,0,0,0,,.صحيح، هذه جريمة لا يمكن ارتكابها إلا إذا كان للجاني أجنحة
Dialogue: 0,0:22:22.68,0:22:24.58,Default,,0,0,0,,!هذه جريمة مستحيلة
Dialogue: 0,0:22:40.17,0:22:44.97,DCEnding,,0,0,0,,شيء ما سيحدث الليلة  
Dialogue: 0,0:22:44.97,0:22:51.22,DCEnding,,0,0,0,,.فادعُ، لكن لا تغمض عينيك 
Dialogue: 0,0:22:51.22,0:22:55.65,DCEnding,,0,0,0,,قالت أمي إن في هذه الليالي  
Dialogue: 0,0:22:55.65,0:23:02.19,DCEnding,,0,0,0,,عندما يذوب القمر، يولد الحب  
Dialogue: 0,0:23:08.25,0:23:14.38,DCEnding,,0,0,0,,والآن كل شيء يدور في مكانه  
Dialogue: 0,0:23:14.38,0:23:21.22,DCEnding,,0,0,0,,لأني أرى مستقبلي يتمزق  
Dialogue: 0,0:23:21.22,0:23:27.77,DCEnding,,0,0,0,,فاقرع الأرض حافي القدمين  
Dialogue: 0,0:23:27.77,0:23:33.77,DCEnding,,0,0,0,,!اعبر القوس قزح، وأمسك السماء
Dialogue: 0,0:23:34.48,0:23:40.23,DCEnding,,0,0,0,,في الصباح، أتمنى على الصليب في صدري  
Dialogue: 0,0:23:40.23,0:23:46.61,DCEnding,,0,0,0,,في المساء، تمطر الأماني عليك  
Dialogue: 0,0:23:46.61,0:23:52.79,DCEnding,,0,0,0,,ضوء لطيف يلفك  
Dialogue: 0,0:23:52.79,0:24:02.50,DCEnding,,0,0,0,, للأبد ثابت من أجلك، من أجل حبك  
