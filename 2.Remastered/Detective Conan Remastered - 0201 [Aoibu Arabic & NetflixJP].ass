Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs40\pos(200,200)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS \NX : @Theconansign
Dialogue: 0,0:00:03.04,0:00:04.46,Default,,0,0,0,,‫كما يتدفق الماء بلا شكل،
Dialogue: 0,0:00:04.59,0:00:06.05,Default,,0,0,0,,‫وتَهُب الريح بلا هيئة.
Dialogue: 0,0:00:06.38,0:00:07.88,Default,,0,0,0,,‫لا قضية تستطيع أن تمنعك من كشف الحقيقة.
Dialogue: 0,0:00:08.34,0:00:09.80,Default,,0,0,0,,‫اليوم هو موعد رحلة الحافلة ذات الغطاء، مليئة بالحنين.
Dialogue: 0,0:00:10.09,0:00:11.64,Default,,0,0,0,,‫إنها تسافر عبر الزمان، حاملة معها قضية.
Dialogue: 0,0:00:12.01,0:00:13.39,Default,,0,0,0,,‫يسعى وراء الحقيقة دائماً،
Dialogue: 0,0:00:13.43,0:00:14.85,Default,,0,0,0,,يجسد طفل وعقل بالغ
Dialogue: 0,0:00:15.31,0:00:17.27,Default,,0,0,0,,‫اسمه المحقق كونان!
Dialogue: 0,0:00:17.73,0:00:22.99,DCOpening,,0,0,0,,نحن مختلفان تمامًا
Dialogue: 0,0:00:24.94,0:00:31.53,DCOpening,,0,0,0,,نحب أشياءً مختلفة، ونعبر عن مشاعرنا بطرق مختلفة
Dialogue: 0,0:00:32.28,0:00:38.45,DCOpening,,0,0,0,,الآن، ونحن نرتب ذكريات وقتنا معًا الباهتة
Dialogue: 0,0:00:39.37,0:00:45.96,DCOpening,,0,0,0,,نحن نبحث بلا هدى عن شخصٍ ما عن مستقبل
Dialogue: 0,0:00:45.96,0:00:49.51,DCOpening,,0,0,0,,كن أقوى مما كنت تظن أنك قادر عليه
Dialogue: 0,0:00:49.51,0:00:53.26,DCOpening,,0,0,0,,ابحث عن الشخص المميز لك
Dialogue: 0,0:00:53.26,0:00:57.31,DCOpening,,0,0,0,,رغم أن بعض الأيام قد لا تسير على ما يرام
Dialogue: 0,0:00:57.31,0:01:00.39,DCOpening,,0,0,0,,قلبٌ صادقٌ لعينيك الغامضتين
Dialogue: 0,0:01:00.39,0:01:08.15,DCOpening,,0,0,0,,لا تترك ذراعي أبدًا، كي لا أفقدك مجددًا
Dialogue: 0,0:01:08.15,0:01:10.78,DCOpening,,0,0,0,,حتى عندما نجرح بعضنا
Dialogue: 0,0:01:15.03,0:01:22.29,DCOpening,,0,0,0,,في كل مرة ضللت فيها الطريق، أبحث ببساطة عن إجابات
Dialogue: 0,0:01:22.29,0:01:28.88,DCOpening,,0,0,0,,كنت تتحرك قدمًا بالفعل
Dialogue: 0,0:01:29.42,0:01:33.13,DCOpening,,0,0,0,,تمسك بي
Dialogue: 0,0:01:33.13,0:01:40.39,DCOpening,,0,0,0,,فهذه هي حياتي السرية
Dialogue: 0,0:01:57.20,0:02:00.75,Default,,0,0,0,,‫"الراكب العاشر - الجزء الأول"
Dialogue: 0,0:02:12.54,0:02:14.29,Default,,0,0,0,,‫يا له من شعور رائع.
Dialogue: 0,0:02:14.42,0:02:15.75,Default,,0,0,0,,‫الهواء نقي أيضًا.
Dialogue: 0,0:02:16.38,0:02:18.05,Default,,0,0,0,,‫هذه الحافلة تبعث على الحنين حقًا.
Dialogue: 0,0:02:18.34,0:02:21.01,Default,,0,0,0,,‫الشعور رائع بدون تشغيل مكيف الهواء.
Dialogue: 0,0:02:21.55,0:02:26.89,Default,,0,0,0,,تبا، لماذا يجب أن أركب حافلة قديمة هذه الأيام؟
Dialogue: 0,0:02:27.85,0:02:29.56,Default,,0,0,0,,‫قدمها هو ما يجعلها مميزة.
Dialogue: 0,0:02:30.10,0:02:32.77,Default,,0,0,0,,‫لم أكن أعرف عنها حتى، لذا فهي جديدة بالنسبة لي.
Dialogue: 0,0:02:33.23,0:02:35.52,Default,,0,0,0,,ماذا كان يُسمى هذا النوع من الحافلات؟
Dialogue: 0,0:02:36.19,0:02:37.65,Default,,0,0,0,,‫حافلة ذات غطاء.
Dialogue: 0,0:02:37.98,0:02:42.20,Default,,0,0,0,,‫حتى حوالي 30 عامًا مضت، كانت مستخدمة في جميع أنحاء اليابان.
Dialogue: 0,0:02:42.78,0:02:45.20,Default,,0,0,0,,‫انظري، مقدمتها مدببة ونحيفة.
Dialogue: 0,0:02:45.32,0:02:48.37,Default,,0,0,0,,‫لهذا من الأسهل لها أن تتجاوز المركبات الأخرى على المنعطفات.
Dialogue: 0,0:02:49.33,0:02:50.29,Default,,0,0,0,,‫هذا صحيح تمامًا.
Dialogue: 0,0:02:51.00,0:02:52.71,Default,,0,0,0,,‫أنا مُندهشة أنك تعرف هذا أيها الصبي.
Dialogue: 0,0:02:53.92,0:02:55.50,Default,,0,0,0,,‫قرأته في كتاب.
Dialogue: 0,0:02:55.75,0:02:58.55,Default,,0,0,0,,‫هذا الشقي يعرف الكثير من الهراء الذي لا يهم.
Dialogue: 0,0:02:59.13,0:03:01.84,Default,,0,0,0,,‫لا، بل العكس.{\an8}
Dialogue: 0,0:02:59.71,0:03:03.05,sign_CharSync,,0,0,0,,{\fs80\pos(1400,770)}(32) يابي تاكورو
Dialogue: 0,0:03:02.09,0:03:03.84,Default,,0,0,0,,{\an8}بالنسبة لنا، نحن أهل قرية كاجيكورا
Dialogue: 0,0:03:04.13,0:03:07.55,Default,,0,0,0,,‫الحافلة ذات الغطاء هي معلم سياحي مهم.
Dialogue: 0,0:03:08.22,0:03:10.39,Default,,0,0,0,,‫لا...لم أقصد ذلك.
Dialogue: 0,0:03:11.43,0:03:13.64,Default,,0,0,0,,‫أنا يابي تاكورو من قرية كاجيكورا.
Dialogue: 0,0:03:15.02,0:03:17.44,Default,,0,0,0,,قائد مجموعة الشباب؟
Dialogue: 0,0:03:18.48,0:03:21.53,Default,,0,0,0,,‫إلى جانب ركوب الحافلة ذات الغطاء، استمتع بوقتك في قرية كاجيكورا.
Dialogue: 0,0:03:23.29,0:03:26.97,Default,,0,0,0,,جميعًا، قد لا يوجد الكثير في قرية كاجيكورا
Dialogue: 0,0:03:27.07,0:03:28.91,Default,,0,0,0,,‫ولكن هناك الكثير من الطبيعة.
Dialogue: 0,0:03:29.74,0:03:32.95,Default,,0,0,0,,‫أرجو الاستمتاع بإقامتكم!
Dialogue: 0,0:03:33.75,0:03:34.87,Default,,0,0,0,,‫إنه شخص مرح.
Dialogue: 0,0:03:37.25,0:03:40.21,sign_CharSync,,0,0,0,,{\fs75\pos(950,690)}(25) ناتسومي توكو\Nمرشدة الحافلة
Dialogue: 0,0:03:41.25,0:03:42.71,Default,,0,0,0,,مهلاً، ناتسومي
Dialogue: 0,0:03:42.96,0:03:44.09,Default,,0,0,0,,‫هيا ووجهني، من فضلك.
Dialogue: 0,0:03:45.01,0:03:46.22,Default,,0,0,0,,حاضرة، آسفة.
Dialogue: 0,0:04:05.78,0:04:09.82,Default,,0,0,0,,مهلاً، أليست هذه الصخرة شيئًا سقط من الأعلى؟
Dialogue: 0,0:04:13.41,0:04:14.79,Default,,0,0,0,,‫رائع.
Dialogue: 0,0:04:15.00,0:04:16.21,Default,,0,0,0,,هل أنتِ بخير؟
Dialogue: 0,0:04:19.63,0:04:20.84,Default,,0,0,0,,‫كان ذلك مخيفًا.
Dialogue: 0,0:04:26.01,0:04:27.18,Default,,0,0,0,,‫نصب تذكاري...
Dialogue: 0,0:04:31.39,0:04:34.43,sign_CharSync,,0,0,0,,{\fs75\pos(960,740)}قرية كاجيكورا
Dialogue: 0,0:04:50.15,0:04:50.65,Default,,0,0,0,,‫أنت.
Dialogue: 0,0:04:51.82,0:04:53.57,Default,,0,0,0,,‫المقعد بجانبي فارغ.
Dialogue: 0,0:04:53.94,0:04:56.82,sign_CharSync,,0,0,0,,{\fs75\pos(950,690)}(60) أوكومورا سوتشيكي\Nمساعد عمدة قرية كاجيكورا
Dialogue: 0,0:04:54.11,0:04:55.28,Default,,0,0,0,,‫أسرع وابتعد.{\an8}
Dialogue: 0,0:04:55.32,0:04:56.65,Default,,0,0,0,,‫هذا مقعدي.{\an8}
Dialogue: 0,0:04:57.32,0:05:00.58,Default,,0,0,0,,مقعدك...؟ هل لهذه الحافلة مقاعد محجوزة؟
Dialogue: 0,0:05:01.49,0:05:03.41,Default,,0,0,0,,‫توقف عن هذا، سيد أوكومورا.
Dialogue: 0,0:05:03.62,0:05:05.00,Default,,0,0,0,,‫اليوم هو يوم الأحد.
Dialogue: 0,0:05:05.08,0:05:06.25,Default,,0,0,0,,‫أنا أعلم ذلك.
Dialogue: 0,0:05:06.83,0:05:11.67,Default,,0,0,0,,‫لقد قررنا في اجتماع القرية إعطاء المقاعد للضيوف في عطلات نهاية الأسبوع.
Dialogue: 0,0:05:12.00,0:05:16.55,Default,,0,0,0,,‫هذا كان شيئًا قررته أنت ورئيس القرية بمفردكما.
Dialogue: 0,0:05:16.67,0:05:18.05,Default,,0,0,0,,‫مـ-ماذا؟!
Dialogue: 0,0:05:18.43,0:05:21.51,Default,,0,0,0,,كم هذا مثير للاهتمام، هل ستجبرني على النزول؟
Dialogue: 0,0:05:21.76,0:05:23.39,Default,,0,0,0,,‫إذا استطعت، تفضل.
Dialogue: 0,0:05:25.73,0:05:26.85,Default,,0,0,0,,‫ابتعد!
Dialogue: 0,0:05:28.19,0:05:32.40,Default,,0,0,0,,‫لمدة 40 عامًا، كان هذا المقعد ملكي.
Dialogue: 0,0:05:33.11,0:05:34.90,Default,,0,0,0,,‫أعتذر عن ذلك يا سيدي.
Dialogue: 0,0:05:35.15,0:05:36.61,Default,,0,0,0,,‫أرجو أن تأخذ مقعدًا آخر.
Dialogue: 0,0:05:37.20,0:05:39.57,Default,,0,0,0,,ما الذي يحدث بالضبط مع هذه الحافلة؟
Dialogue: 0,0:05:49.18,0:05:51.23,Default,,0,0,0,,‫يبدو أنها تصبح مزدحمة للغاية.
Dialogue: 0,0:05:51.35,0:05:54.35,Default,,0,0,0,,بالنسبة لأهل المنطقة، إنها ليست فقط للسياحة
Dialogue: 0,0:05:54.44,0:05:55.73,Default,,0,0,0,,‫ولكنها أيضًا بمثابة وسيلة نقلهم.
Dialogue: 0,0:06:13.75,0:06:14.50,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:06:15.79,0:06:17.25,Default,,0,0,0,,ما المشكلة، سيد أوكومورا؟
Dialogue: 0,0:06:17.75,0:06:18.92,Default,,0,0,0,,‫هل حدث شيء ما؟!
Dialogue: 0,0:06:23.34,0:06:24.51,Default,,0,0,0,,مـ-ما الأمر؟
Dialogue: 0,0:06:24.68,0:06:26.43,Default,,0,0,0,,‫أعتقد أن أحدهم سقط مريضًا.
Dialogue: 0,0:06:26.72,0:06:28.30,Default,,0,0,0,,‫سأذهب به إلى المستشفى فورًا.{\an8}
Dialogue: 0,0:06:26.80,0:06:30.64,sign_CharSync,,0,0,0,,{\fs75\pos(950,690)}(35)كاجيتا مامورو\Nسائق الحافلة
Dialogue: 0,0:06:28.55,0:06:29.51,Default,,0,0,0,,‫لا جدوى من ذلك.{\an8}
Dialogue: 0,0:06:30.68,0:06:31.68,Default,,0,0,0,,هل يعني ذلك...؟
Dialogue: 0,0:06:33.52,0:06:34.56,Default,,0,0,0,,‫إنه ميت.
Dialogue: 0,0:06:37.27,0:06:41.07,Default,,0,0,0,,‫على الأرجح، تم وضع السم داخل الزجاجة.
Dialogue: 0,0:06:41.98,0:06:42.99,Default,,0,0,0,,‫لا يتحرك أحد!
Dialogue: 0,0:06:43.32,0:06:45.36,Default,,0,0,0,,‫لا ينزل أحد من الحافلة حتى تصل الشرطة.
Dialogue: 0,0:06:45.74,0:06:47.41,Default,,0,0,0,,لماذا؟
Dialogue: 0,0:06:48.41,0:06:50.95,Default,,0,0,0,,‫انتظر، لا داعي للمبالغة...
Dialogue: 0,0:06:51.66,0:06:52.91,Default,,0,0,0,,‫خاصة أنت، سيد يابي.
Dialogue: 0,0:06:53.41,0:06:55.08,Default,,0,0,0,,إذا كانت هذه جريمة قتل
Dialogue: 0,0:06:55.42,0:06:59.79,Default,,0,0,0,,‫فإن الشخص الذي تجادل مع الضحية وجلس خلفه مباشرة هو المشتبه به الرئيسي.
Dialogue: 0,0:07:00.29,0:07:03.30,Default,,0,0,0,,‫قـ-قتل... من... بالضبط...
Dialogue: 0,0:07:03.55,0:07:06.55,Default,,0,0,0,,‫أنا موري كوغورو، محقق.
Dialogue: 0,0:07:07.47,0:07:09.39,Default,,0,0,0,,‫موري... ذلك الشهير...
Dialogue: 0,0:07:09.85,0:07:12.18,Default,,0,0,0,,‫إذن هذا يعني أن القضية كبيرة.
Dialogue: 0,0:07:12.43,0:07:13.72,Default,,0,0,0,,‫لا شك في ذلك.
Dialogue: 0,0:07:13.89,0:07:15.69,Default,,0,0,0,,ولكن من فعل شيئًا كهذا؟
Dialogue: 0,0:07:21.32,0:07:22.44,Default,,0,0,0,,‫شكرًا على مجهودك.{\an8}
Dialogue: 0,0:07:21.44,0:07:25.53,sign_CharSync,,0,0,0,,{\fs60\pos(550,710)}(28) شينكاي هيتوشي جونسا\Nضابط فرعي في قرية كاجيكورا
Dialogue: 0,0:07:22.82,0:07:25.74,Default,,0,0,0,,‫أنا ضابط من مركز شرطة قرية كاجيكورا.{\an8}
Dialogue: 0,0:07:26.74,0:07:30.78,Default,,0,0,0,,‫أنا سعيد جدًا بالتحقيق في هذه القضية مع المحقق الشهير موري.
Dialogue: 0,0:07:33.29,0:07:36.21,Default,,0,0,0,,‫أرى أنك ضابط ذو إمكانيات كبيرة.
Dialogue: 0,0:07:36.66,0:07:38.71,Default,,0,0,0,,‫سأفعل كل ما بوسعي للمساعدة.
Dialogue: 0,0:07:39.17,0:07:40.59,Default,,0,0,0,,‫شكرًا جزيلاً لك.
Dialogue: 0,0:07:41.75,0:07:44.96,Default,,0,0,0,,‫بالمناسبة، سمعت أنها قضية قتل.
Dialogue: 0,0:07:45.59,0:07:46.47,Default,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:07:46.88,0:07:49.34,Default,,0,0,0,,‫إذا كان الأمر كذلك، فهذا يعني...
Dialogue: 0,0:07:50.76,0:07:53.10,Default,,0,0,0,,‫يجب أن ننظر عن قرب قبل أن نستطيع...
Dialogue: 0,0:07:53.10,0:07:54.06,Default,,0,0,0,,‫إنها جريمة قتل.
Dialogue: 0,0:07:55.35,0:07:57.52,Default,,0,0,0,,‫توقف عن حشر أنفك فيما لا يعنيك!
Dialogue: 0,0:07:57.64,0:07:59.69,Default,,0,0,0,,‫انظر إلى الزجاجة البلاستيكية.
Dialogue: 0,0:08:00.86,0:08:01.69,Default,,0,0,0,,زجاجة بلاستيكية؟
Dialogue: 0,0:08:02.19,0:08:03.98,Default,,0,0,0,,انظر، الشاي يتسرب
Dialogue: 0,0:08:04.36,0:08:05.94,Default,,0,0,0,,‫من ثقب أحدثته إبرة على الأرجح.
Dialogue: 0,0:08:06.61,0:08:09.70,Default,,0,0,0,,صحيح! هل يمكن أن يكون السم قد حُقن بإبرة إذن؟
Dialogue: 0,0:08:10.53,0:08:12.91,Default,,0,0,0,,‫حسنًا، افتشوا الجميع!
Dialogue: 0,0:08:13.20,0:08:15.37,Default,,0,0,0,,‫من معه إبرة هو الجاني!
Dialogue: 0,0:08:15.50,0:08:16.20,Default,,0,0,0,,‫لا نعرف...
Dialogue: 0,0:08:16.95,0:08:18.16,Default,,0,0,0,,‫النوافذ كانت مفتوحة.
Dialogue: 0,0:08:18.37,0:08:20.88,Default,,0,0,0,,‫إذا أراد الجاني التخلص منها، كان بإمكانه فعل ذلك في أي وقت.
Dialogue: 0,0:08:21.42,0:08:24.55,Default,,0,0,0,,‫أيضًا، يمكن أن يكون الجاني شخصًا نزل بالفعل.
Dialogue: 0,0:08:27.17,0:08:28.38,Default,,0,0,0,,‫ستأتي عاصفة...
Dialogue: 0,0:08:30.84,0:08:32.14,Default,,0,0,0,,‫ليست مجرد عاصفة...
Dialogue: 0,0:08:32.80,0:08:34.31,Default,,0,0,0,,‫ستكون حربًا!
Dialogue: 0,0:08:34.76,0:08:35.35,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:08:35.89,0:08:36.81,Default,,0,0,0,,حرب!؟
Dialogue: 0,0:08:37.23,0:08:38.85,Default,,0,0,0,,‫هذا سيئ!
Dialogue: 0,0:08:38.89,0:08:39.77,Default,,0,0,0,,ماذا سنفعل؟
Dialogue: 0,0:08:39.81,0:08:41.02,Default,,0,0,0,,‫سينزل مطر من الدماء!
Dialogue: 0,0:08:41.81,0:08:43.31,Default,,0,0,0,,مطر من الدماء؟
Dialogue: 0,0:08:51.63,0:08:53.76,Default,,0,0,0,,سيد موري، لقد عثروا على إبرة
Dialogue: 0,0:08:54.30,0:08:55.97,Default,,0,0,0,,‫من الحفرة بجانب طريق الحافلة.
Dialogue: 0,0:08:56.18,0:08:58.68,Default,,0,0,0,,‫على الرغم من وجود القليل فقط، إلا أنهم عثروا على آثار سم.
Dialogue: 0,0:08:58.93,0:09:00.18,Default,,0,0,0,,ماذا عن بصمات الأصابع؟
Dialogue: 0,0:09:00.31,0:09:01.43,Default,,0,0,0,,‫أيها الضابط شينكاي.
Dialogue: 0,0:09:02.60,0:09:03.60,Default,,0,0,0,,‫مفتش هينو.
Dialogue: 0,0:09:04.06,0:09:07.44,sign_CharSync,,0,0,0,,{\fs75\pos(990,710)}(41) هينو شيوهي\Nمفتش قسم الاختصاص
Dialogue: 0,0:09:04.19,0:09:07.23,Default,,0,0,0,,‫لا يمكنني السماح لك بنشر تقارير القضية بحرية.{\an8}
Dialogue: 0,0:09:07.98,0:09:09.52,Default,,0,0,0,,هذا يعني أنه لم تكن هناك أي بصمات، صحيح؟
Dialogue: 0,0:09:09.73,0:09:10.32,Default,,0,0,0,,‫بصمات الأصابع...
Dialogue: 0,0:09:11.78,0:09:16.45,Default,,0,0,0,,‫إذا كانت موجودة، لكنت طلبت بصمات الجميع وقارنتها.
Dialogue: 0,0:09:16.86,0:09:18.95,Default,,0,0,0,,‫نـ-نعم، هذا صحيح تمامًا.
Dialogue: 0,0:09:20.28,0:09:21.74,Default,,0,0,0,,من هم هؤلاء الناس؟
Dialogue: 0,0:09:23.20,0:09:25.67,Default,,0,0,0,,‫هذا هو المحقق الشهير، السيد موري كوغورو.
Dialogue: 0,0:09:25.92,0:09:26.87,Default,,0,0,0,,‫لقد كانوا على متن الحافلة بالصدفة.
Dialogue: 0,0:09:27.38,0:09:30.34,Default,,0,0,0,,‫كوغورو النائم يود المساعدة في التحقيق.
Dialogue: 0,0:09:30.46,0:09:31.50,Default,,0,0,0,,‫كم هذا غبي.
Dialogue: 0,0:09:33.05,0:09:37.51,Default,,0,0,0,,‫على الأرجح هناك من يحل القضايا نيابة عنك بينما أنت نائم.
Dialogue: 0,0:09:38.09,0:09:40.39,Default,,0,0,0,,‫لقد أصبت.
Dialogue: 0,0:09:40.89,0:09:45.14,Default,,0,0,0,,‫حسنًا، افعلوا ما تشاؤون طالما لا تعيقون طريقنا.
Dialogue: 0,0:09:48.70,0:09:50.25,Default,,0,0,0,,‫يا له من شخص وقح.
Dialogue: 0,0:09:50.29,0:09:51.46,Default,,0,0,0,,‫إذن دعنا نفعل ما نشاء.
Dialogue: 0,0:09:53.08,0:09:57.42,Default,,0,0,0,,لا تحتاج مساعدة المفتش لحل هذه القضية، صحيح؟
Dialogue: 0,0:09:58.34,0:09:59.63,Default,,0,0,0,,‫بالطبع!
Dialogue: 0,0:09:59.92,0:10:01.34,Default,,0,0,0,,‫فقط انتظر أيها المفتش هينو!
Dialogue: 0,0:10:01.51,0:10:02.93,Default,,0,0,0,,‫سأريك!
Dialogue: 0,0:10:03.59,0:10:07.43,Default,,0,0,0,,‫سيد موري، سأساعدك بقدر ما أستطيع أيضًا.
Dialogue: 0,0:10:08.22,0:10:09.02,Default,,0,0,0,,‫لن أسامحه.
Dialogue: 0,0:10:09.68,0:10:12.48,Default,,0,0,0,,‫ليرتكب جريمة أمامي بهذه الجرأة...
Dialogue: 0,0:10:13.60,0:10:16.02,Default,,0,0,0,,‫سأجد الجاني بنفسي!
Dialogue: 0,0:10:17.57,0:10:18.53,Default,,0,0,0,,آسف لإخباركم
Dialogue: 0,0:10:18.57,0:10:21.32,Default,,0,0,0,,‫ولكن حتى ينتهي الاستجواب، أود منكم جميعًا البقاء هنا.
Dialogue: 0,0:10:21.82,0:10:25.45,Default,,0,0,0,,‫حسنًا، في الواقع... هذا هو المكان الوحيد في القرية الذي يمكنكم الإقامة فيه على أي حال.
Dialogue: 0,0:10:25.99,0:10:27.74,Default,,0,0,0,,‫أيها الضابط شينكاي.
Dialogue: 0,0:10:27.99,0:10:29.79,Default,,0,0,0,,‫المكان الوحيد، يا لها من كلمات فظيعة لتقولها.
Dialogue: 0,0:10:29.83,0:10:31.87,Default,,0,0,0,,‫صاحبة النزل، لم أقصد...
Dialogue: 0,0:10:32.54,0:10:35.17,sign_CharSync,,0,0,0,,{\fs75\pos(950,710)}(41) كوماي كينو\Nصاحبة نزل كوماي 
Dialogue: 0,0:10:32.92,0:10:33.75,Default,,0,0,0,,‫أنا أمزح فقط.{\an8}
Dialogue: 0,0:10:34.12,0:10:35.63,Default,,0,0,0,,‫مرحبًا بكم في نزل كوماي.{\an8}
Dialogue: 0,0:10:36.17,0:10:38.59,Default,,0,0,0,,‫إنه نزل جميل بسحر العصور القديمة.
Dialogue: 0,0:10:38.92,0:10:40.88,Default,,0,0,0,,‫أجل، المباني الخشبية رائعة.
Dialogue: 0,0:10:41.05,0:10:42.30,Default,,0,0,0,,‫لطيفة جدًا مع الناس.
Dialogue: 0,0:10:42.88,0:10:44.18,Default,,0,0,0,,‫شكرًا لكم.
Dialogue: 0,0:10:44.30,0:10:46.39,Default,,0,0,0,,‫هذا المكان منطقة محايدة، لذا...
Dialogue: 0,0:10:46.76,0:10:47.64,Default,,0,0,0,,محايدة؟
Dialogue: 0,0:10:48.81,0:10:51.52,Default,,0,0,0,,‫لقد ظللت تقول الكثير من الأشياء التي لا معنى لها.
Dialogue: 0,0:10:51.85,0:10:53.81,Default,,0,0,0,,‫شيء عن عاصفة وحرب.
Dialogue: 0,0:10:54.14,0:10:55.94,Default,,0,0,0,,‫هذا...
Dialogue: 0,0:10:56.56,0:10:57.86,Default,,0,0,0,,‫ستعرفون مع الوقت.
Dialogue: 0,0:10:58.32,0:11:00.15,Default,,0,0,0,,‫لكن أولاً، من فضلكم أرجو الدخول إلى غرفكم.
Dialogue: 0,0:11:02.53,0:11:05.66,Default,,0,0,0,,‫يمكنكنا رؤية جبل فوجي من هذه القرية.
Dialogue: 0,0:11:05.66,0:11:07.20,Default,,0,0,0,,‫هذا رائع!
Dialogue: 0,0:11:08.03,0:11:09.70,Default,,0,0,0,,أنت كونان، صحيح؟
Dialogue: 0,0:11:09.87,0:11:10.74,Default,,0,0,0,,هل تلك غرفتك؟
Dialogue: 0,0:11:11.04,0:11:12.62,Default,,0,0,0,,‫آنسة مرشدة الحافلة!
Dialogue: 0,0:11:12.91,0:11:14.50,Default,,0,0,0,,‫غرفتكِ بجانب غرفتنا تمامًا.
Dialogue: 0,0:11:15.25,0:11:19.09,Default,,0,0,0,,‫نعم، يمكنني الحصول على أفضل منظر لجبل فوجي من هذا المكان.
Dialogue: 0,0:11:19.77,0:11:21.61,Default,,0,0,0,,‫سيد موري، هناك مشكلة!
Dialogue: 0,0:11:22.40,0:11:22.98,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:11:23.15,0:11:27.57,Default,,0,0,0,,‫كما تعلم، المفتش في المركز يستجوب السيد يابي.
Dialogue: 0,0:11:28.07,0:11:29.28,Default,,0,0,0,,‫كما توقعت.
Dialogue: 0,0:11:29.49,0:11:31.57,Default,,0,0,0,,ذلك الرجل هو المشتبه به الرئيسي، صحيح؟
Dialogue: 0,0:11:31.95,0:11:33.70,Default,,0,0,0,,‫حسنًا، لا أعرف بخصوص ذلك...
Dialogue: 0,0:11:33.99,0:11:36.87,Default,,0,0,0,,‫لكن المشكلة هي مكان الاستجواب.
Dialogue: 0,0:11:37.04,0:11:37.54,Default,,0,0,0,,المكان؟
Dialogue: 0,0:11:37.96,0:11:40.54,Default,,0,0,0,,‫لو كان في مبنى المركز لكان الأمر جيدًا.
Dialogue: 0,0:11:41.00,0:11:44.21,Default,,0,0,0,,‫لكن في المركز، اقتحم الجانب المؤيد والجانب المعارض المكان و...
Dialogue: 0,0:11:44.96,0:11:46.88,Default,,0,0,0,,جانب مؤيد ومعارض؟
Dialogue: 0,0:11:47.80,0:11:48.84,Default,,0,0,0,,‫أرجو العودة إلى منازلكم.
Dialogue: 0,0:11:48.92,0:11:50.97,Default,,0,0,0,,‫سنقوم بالاستجواب هنا!
Dialogue: 0,0:11:51.34,0:11:53.30,Default,,0,0,0,,‫لا يمكننا الوثوق بك، أعطنا يابي!
Dialogue: 0,0:11:53.55,0:11:54.81,Default,,0,0,0,,‫إنه من فعلها!
Dialogue: 0,0:11:54.93,0:11:55.68,Default,,0,0,0,,‫سلموه لنا!
Dialogue: 0,0:11:55.76,0:11:56.77,Default,,0,0,0,,‫هذا صحيح!
Dialogue: 0,0:11:56.97,0:11:57.81,Default,,0,0,0,,ما الذي تتحدثون عنه؟
Dialogue: 0,0:11:57.93,0:11:59.48,Default,,0,0,0,,‫يابي ليس الجاني!
Dialogue: 0,0:11:59.64,0:12:00.73,Default,,0,0,0,,‫إنه بريء!
Dialogue: 0,0:12:00.81,0:12:03.44,Default,,0,0,0,,أيها الرئيس، لقد أمرت يابي بفعلها، أليس كذلك؟
Dialogue: 0,0:12:03.65,0:12:04.40,Default,,0,0,0,,‫سأمسك بك!
Dialogue: 0,0:12:05.90,0:12:09.15,Default,,0,0,0,,‫توقفوا وإلا سأعتقلكم جميعًا بتهمة الإخلال بالهدوء!
Dialogue: 0,0:12:17.54,0:12:19.12,Default,,0,0,0,,‫توقفوا، اهدأوا!
Dialogue: 0,0:12:19.25,0:12:20.79,Default,,0,0,0,,‫الجميع، أرجو الهدوء!
Dialogue: 0,0:12:24.46,0:12:25.17,Default,,0,0,0,,‫عمي!
Dialogue: 0,0:12:25.29,0:12:25.88,Default,,0,0,0,,‫أبي!
Dialogue: 0,0:12:26.59,0:12:28.09,Default,,0,0,0,,هل أنت بخير، سيد موري؟
Dialogue: 0,0:12:29.88,0:12:30.72,Default,,0,0,0,,‫توقفوا...
Dialogue: 0,0:12:32.72,0:12:35.80,Default,,0,0,0,,‫توقفوا!
Dialogue: 0,0:12:45.91,0:12:49.96,Default,,0,0,0,,‫نعم، الشغب هنا توقف والجميع غادروا.
Dialogue: 0,0:12:50.17,0:12:50.88,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:12:51.21,0:12:52.92,Default,,0,0,0,,‫شكرًا لمساعدتك!
Dialogue: 0,0:12:53.59,0:12:54.67,Default,,0,0,0,,‫سيكون كل شيء على ما يرام.
Dialogue: 0,0:12:54.84,0:12:59.05,Default,,0,0,0,,‫سيد موري، سيارة الشرطة التي تقل السيد يابي وصلت إلى مبنى المركز بأمان.
Dialogue: 0,0:12:59.60,0:13:03.02,Default,,0,0,0,,هذا جيد، ولكن ما قصة هذه البلدة؟
Dialogue: 0,0:13:03.52,0:13:06.98,Default,,0,0,0,,‫كما تعلم، حتى حوالي عام مضى، لم يحدث شيء كهذا أبدًا.
Dialogue: 0,0:13:07.39,0:13:12.69,Default,,0,0,0,,ولكن عندما قررنا في اجتماع القرية استخدام الحافلة ذات الغطاء كوسيلة لجذب السياح
Dialogue: 0,0:13:13.78,0:13:18.11,Default,,0,0,0,,الجانب المؤيد، بقيادة رئيس القرية وتطوير السياحة مع السيد يابي
Dialogue: 0,0:13:18.74,0:13:23.12,Default,,0,0,0,,‫والجانب المعارض، بقيادة السيد أوكومورا المتوفى، بدأوا في الصراعات.
Dialogue: 0,0:13:24.95,0:13:28.75,Default,,0,0,0,,‫تلك الحافلة كانت تستخدم في الأصل كوسيلة نقل للقرويين.
Dialogue: 0,0:13:29.46,0:13:31.79,Default,,0,0,0,,‫إنها بلدة صغيرة والجميع يعرف الجميع.
Dialogue: 0,0:13:32.04,0:13:36.80,Default,,0,0,0,,‫لذلك تشكلت مقاعدهم بشكل طبيعي واعتبرت أنها يجب أن تبقى على هذا النحو.
Dialogue: 0,0:13:37.13,0:13:42.26,Default,,0,0,0,,‫قرروا فتح المقاعد للسياح في عطلات نهاية الأسبوع...
Dialogue: 0,0:13:42.80,0:13:47.18,Default,,0,0,0,,لكن السيد أوكومورا وغيره من المعارضين رفضوا التخلي عن مقاعدهم، صحيح؟
Dialogue: 0,0:13:47.94,0:13:51.61,Default,,0,0,0,,‫بالضبط، وأصبحوا أكثر معارضة لذلك.
Dialogue: 0,0:13:52.36,0:13:54.32,Default,,0,0,0,,‫لكني لم أعتقد أبدًا أن الأمر سيصل إلى القتل.
Dialogue: 0,0:13:54.86,0:13:56.32,Default,,0,0,0,,‫يابي بريء!
Dialogue: 0,0:13:58.86,0:14:01.95,Default,,0,0,0,,‫آسف بشأن ما حدث سابقًا، أنا رئيس القرية، فوناكي.
Dialogue: 0,0:14:02.57,0:14:04.41,Default,,0,0,0,,‫سمعت أنك محقق مشهور.
Dialogue: 0,0:14:03.08,0:14:06.41,sign_CharSync,,0,0,0,,{\fs75\pos(990,700)}(48) فوناكي تاكيهيكو\Nرئيس قرية كاجيكورا
Dialogue: 0,0:14:05.24,0:14:07.25,Default,,0,0,0,,‫أود منك أن تتولى طلبنا.{\an8}
Dialogue: 0,0:14:09.54,0:14:13.00,Default,,0,0,0,,‫الذي قتل السيد أوكومورا ليس يابي!{\an8}
Dialogue: 0,0:14:13.79,0:14:17.92,Default,,0,0,0,,‫لا أريد أن أكون وقحًا ولكن كان هناك الكثير ممن يكرهونه.
Dialogue: 0,0:14:18.67,0:14:20.13,Default,,0,0,0,,‫حتى في صفوف المعارضة.
Dialogue: 0,0:14:20.93,0:14:23.18,Default,,0,0,0,,‫أود منك أن تجد الجاني الحقيقي.
Dialogue: 0,0:14:23.68,0:14:27.14,Default,,0,0,0,,‫ولكن قد يظل الجاني هو السيد يابي.
Dialogue: 0,0:14:27.77,0:14:29.39,Default,,0,0,0,,‫مهما يحدث، سيحدث.
Dialogue: 0,0:14:29.94,0:14:33.56,Default,,0,0,0,,‫على أي حال، أود أن يعود الهدوء إلى القرية في أسرع وقت ممكن.
Dialogue: 0,0:14:34.44,0:14:39.86,Default,,0,0,0,,‫أن تعتقد أن الذكريات الرهيبة من سبع سنوات مضت بدأت تتلاشى والآن يحدث هذا.
Dialogue: 0,0:14:40.74,0:14:42.41,Default,,0,0,0,,الذكريات من سبع سنوات مضت؟
Dialogue: 0,0:14:42.86,0:14:45.03,Default,,0,0,0,,‫لا شيء، إنه شأننا الخاص.
Dialogue: 0,0:14:45.41,0:14:48.00,Default,,0,0,0,,ولكن، هل ستتولى القضية مقابل مليون؟
Dialogue: 0,0:14:48.37,0:14:49.75,Default,,0,0,0,,‫مـ-مليون!
Dialogue: 0,0:14:52.35,0:14:55.89,Default,,0,0,0,,‫مهما كانت القضية، أريد وقف هذه الفوضى في أسرع وقت ممكن.
Dialogue: 0,0:14:56.56,0:14:58.36,Default,,0,0,0,,‫حسنًا، سأترك الأمور لك إذن.
Dialogue: 0,0:15:02.69,0:15:04.90,Default,,0,0,0,,‫حسنًا، لنذهب للقيام ببعض التحقيقات!
Dialogue: 0,0:15:05.49,0:15:07.70,Default,,0,0,0,,‫في هذه الحالة، سأكون مرشدك.
Dialogue: 0,0:15:09.66,0:15:15.54,Default,,0,0,0,,المعذرة، هل كان السيد أوكومورا، المتوفى، دائمًا في ذلك المكان في ذلك الوقت؟
Dialogue: 0,0:15:15.83,0:15:16.96,Default,,0,0,0,,‫اذهب!
Dialogue: 0,0:15:20.79,0:15:22.46,Default,,0,0,0,,‫أود أن أسألك عن...
Dialogue: 0,0:15:24.26,0:15:25.80,Default,,0,0,0,,‫هل يمكنني التحدث إليك...
Dialogue: 0,0:15:32.43,0:15:34.47,Default,,0,0,0,,‫انت، ما الذي يحدث في هذه البلدة؟!
Dialogue: 0,0:15:35.06,0:15:37.56,Default,,0,0,0,,‫في الواقع، هناك عدد أكبر من المعارضين.
Dialogue: 0,0:15:38.06,0:15:43.07,Default,,0,0,0,,‫على الأرجح انتشر الخبر أنك انحزت إلى جانب الرئيس وبدأت التحقيق.
Dialogue: 0,0:15:43.57,0:15:44.36,Default,,0,0,0,,‫لذا...
Dialogue: 0,0:15:45.28,0:15:48.11,Default,,0,0,0,,‫تبا، لا يمكن حتى اعتبار هذا تحقيقًا.
Dialogue: 0,0:15:48.74,0:15:51.70,Default,,0,0,0,,‫ران، خذي كونان وارجعا إلى النزل.
Dialogue: 0,0:15:52.28,0:15:53.70,Default,,0,0,0,,‫سأتجول قليلاً.
Dialogue: 0,0:15:53.83,0:15:54.54,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:15:55.58,0:15:57.29,Default,,0,0,0,,‫يمكنكما بدء العشاء بدوني.
Dialogue: 0,0:15:57.75,0:15:58.87,Default,,0,0,0,,‫لا تنتظراني.
Dialogue: 0,0:16:00.38,0:16:01.50,Default,,0,0,0,,‫مهلاً أيها الضابط...
Dialogue: 0,0:16:03.30,0:16:04.38,Default,,0,0,0,,ما الأمر، كونان؟
Dialogue: 0,0:16:04.96,0:16:06.63,Default,,0,0,0,,هل حدث شيء قبل سبع سنوات
Dialogue: 0,0:16:06.76,0:16:07.38,Default,,0,0,0,,في هذه البلدة؟
Dialogue: 0,0:16:08.26,0:16:10.64,Default,,0,0,0,,تقصد ما كان يتحدث عنه الرئيس فوناكي سابقًا، صحيح؟
Dialogue: 0,0:16:10.89,0:16:12.85,Default,,0,0,0,,‫لقد كان حادثًا. حادث حافلة.
Dialogue: 0,0:16:13.26,0:16:14.14,Default,,0,0,0,,حادث حافلة؟
Dialogue: 0,0:16:14.26,0:16:15.81,Default,,0,0,0,,هل تقصد تلك الحافلة ذات الغطاء؟
Dialogue: 0,0:16:16.18,0:16:19.81,Default,,0,0,0,,‫لكن، قمنا بإصلاح الحافلة.
Dialogue: 0,0:16:20.69,0:16:21.94,Default,,0,0,0,,ما كان سبب الحادث؟
Dialogue: 0,0:16:22.15,0:16:24.73,Default,,0,0,0,,هل أصيب أو مات أحد بسببها؟
Dialogue: 0,0:16:25.07,0:16:28.74,Default,,0,0,0,,‫في الحقيقة، لم أكن هنا قبل سبع سنوات.
Dialogue: 0,0:16:29.03,0:16:30.57,Default,,0,0,0,,‫لذا لا أعرف الكثير من التفاصيل.
Dialogue: 0,0:16:31.95,0:16:34.41,Default,,0,0,0,,‫أعتقد أن شخصين ماتا تقريبًا.
Dialogue: 0,0:16:36.83,0:16:37.91,Default,,0,0,0,,ما الأمر بشأن ذلك؟
Dialogue: 0,0:16:38.33,0:16:40.50,Default,,0,0,0,,‫لا شيء، أردت فقط أن أسأل.
Dialogue: 0,0:16:40.96,0:16:42.92,Default,,0,0,0,,‫أيها الضابط شينكاي، لنذهب!
Dialogue: 0,0:16:43.21,0:16:45.00,Default,,0,0,0,,‫نـ-نعم! أنا قادم!
Dialogue: 0,0:16:46.84,0:16:48.55,Default,,0,0,0,,‫حادث حافلة قبل سبع سنوات...
Dialogue: 0,0:16:49.45,0:16:51.20,Default,,0,0,0,,‫انفعال الرئيس فوناكي...
Dialogue: 0,0:16:51.83,0:16:53.83,Default,,0,0,0,,‫وعرضه للمليون...
Dialogue: 0,0:16:54.58,0:16:56.00,Default,,0,0,0,,‫هناك شيء ما.
Dialogue: 0,0:16:57.82,0:16:59.41,Default,,0,0,0,,‫تبدو لذيذة!
Dialogue: 0,0:16:59.45,0:17:00.99,Default,,0,0,0,,‫أتمنى أن تناسب ذوقكم.
Dialogue: 0,0:17:01.62,0:17:04.12,Default,,0,0,0,,‫كلها أطباق من النباتات البرية.
Dialogue: 0,0:17:04.29,0:17:05.08,Default,,0,0,0,,‫يا آنسة!
Dialogue: 0,0:17:05.29,0:17:07.17,Default,,0,0,0,,‫يا آنسة مرشدة الحافلة!
Dialogue: 0,0:17:08.04,0:17:09.75,Default,,0,0,0,,كونان، ماذا تفعل؟
Dialogue: 0,0:17:10.25,0:17:11.92,Default,,0,0,0,,آنسة توكو، هل أنتِ هناك؟
Dialogue: 0,0:17:13.59,0:17:15.09,Default,,0,0,0,,ما الأمر يا كونان؟
Dialogue: 0,0:17:15.63,0:17:17.84,Default,,0,0,0,,‫لدي شيء أريد أن أسألكِ عنه.
Dialogue: 0,0:17:18.01,0:17:20.43,Default,,0,0,0,,‫لا يمكنك الصراخ هكذا من هنا.
Dialogue: 0,0:17:20.64,0:17:21.60,Default,,0,0,0,,‫آسفان.
Dialogue: 0,0:17:21.97,0:17:22.72,Default,,0,0,0,,‫لا بأس.
Dialogue: 0,0:17:23.14,0:17:24.56,Default,,0,0,0,,وما الذي أردت سؤالي عنه؟
Dialogue: 0,0:17:24.85,0:17:27.48,Default,,0,0,0,,‫إنه عن حادث الحافلة قبل سبع سنوات.
Dialogue: 0,0:17:30.48,0:17:35.82,Default,,0,0,0,,‫آسفة يا كونان، لقد بدأت العمل هنا فقط منذ حوالي نصف عام.
Dialogue: 0,0:17:36.20,0:17:39.62,Default,,0,0,0,,‫لقد سمعت عن الحادث، لكني لا أعرف الكثير من التفاصيل عنه.
Dialogue: 0,0:17:39.95,0:17:40.99,Default,,0,0,0,,‫هكذا إذن...
Dialogue: 0,0:17:41.87,0:17:46.16,Default,,0,0,0,,‫ولكني أمر من هناك كل يوم لذا أعتقد أنه لا يمكنني القول إنه لا يعنيني.
Dialogue: 0,0:17:47.83,0:17:49.29,Default,,0,0,0,,‫إنه المكان الذي يوجد به النصب التذكاري الحجري.
Dialogue: 0,0:17:49.71,0:17:50.67,Default,,0,0,0,,‫ذلك المكان.
Dialogue: 0,0:17:51.00,0:17:53.00,Default,,0,0,0,,المكان ذو الجرف المخيف؟
Dialogue: 0,0:17:53.38,0:17:56.93,Default,,0,0,0,,‫سمعت أن راكبين كانا ثملين وأحدثا شغبًا.
Dialogue: 0,0:17:57.80,0:17:59.64,Default,,0,0,0,,‫لذا انشغل السائق بهما وسقط من الجرف.
Dialogue: 0,0:18:07.48,0:18:09.77,Default,,0,0,0,,‫آسفة، لقد انزلقت يدي.
Dialogue: 0,0:18:09.90,0:18:10.86,Default,,0,0,0,,‫سأحضر بديلاً فورًا.
Dialogue: 0,0:18:11.31,0:18:12.61,Default,,0,0,0,,هل أصبتِ بأذى؟
Dialogue: 0,0:18:12.65,0:18:13.98,Default,,0,0,0,,‫لا، أنا بخير.
Dialogue: 0,0:18:19.74,0:18:21.24,Default,,0,0,0,,آنسة توكو، هل هناك خطب ما؟
Dialogue: 0,0:18:22.62,0:18:23.87,Default,,0,0,0,,‫لا، لا شيء.
Dialogue: 0,0:18:24.99,0:18:28.33,Default,,0,0,0,,‫حسنًا، لا يزال علي تحضير العشاء لذا سأراك لاحقًا يا كونان.
Dialogue: 0,0:18:38.38,0:18:40.09,Default,,0,0,0,,‫تبا، هذا ليس مضحكًا.
Dialogue: 0,0:18:40.76,0:18:42.01,Default,,0,0,0,,‫ليس فقط المعارضون.
Dialogue: 0,0:18:42.30,0:18:47.60,Default,,0,0,0,,‫حتى الناس في الجانب المؤيد لن يقولوا كلمة واحدة.
Dialogue: 0,0:18:47.68,0:18:49.89,Default,,0,0,0,,‫اهدأ يا أبي، الجيران سيسمعونك!
Dialogue: 0,0:18:50.60,0:18:52.19,Default,,0,0,0,,‫لا يهمني.
Dialogue: 0,0:18:52.61,0:18:54.19,Default,,0,0,0,,‫بالإضافة إلى ذلك، هذا المكان محايد.
Dialogue: 0,0:18:54.65,0:18:57.36,Default,,0,0,0,,لكن لماذا لا يساعدنا أحد؟
Dialogue: 0,0:18:58.15,0:18:59.95,Default,,0,0,0,,مما قاله الضابط شينكاي
Dialogue: 0,0:19:00.36,0:19:02.45,Default,,0,0,0,,حتى لو كانوا يرحبون بالسياح على السطح
Dialogue: 0,0:19:02.74,0:19:04.87,Default,,0,0,0,,في داخلهم، يعتقدون أننا لا نلتقط قمامتنا
Dialogue: 0,0:19:04.99,0:19:06.33,Default,,0,0,0,,وندمر الطبيعة
Dialogue: 0,0:19:06.79,0:19:09.25,Default,,0,0,0,,‫ولا نتوقف عن الصراخ حتى وقت متأخر من الليل.
Dialogue: 0,0:19:10.62,0:19:12.33,Default,,0,0,0,,‫إنه يثير فينا تساؤلات عديدة.
Dialogue: 0,0:19:12.75,0:19:16.17,Default,,0,0,0,,‫إذاً؟ لا أستطيع حتى القيام بعملي هنا!
Dialogue: 0,0:19:18.17,0:19:21.38,Default,,0,0,0,,‫ليس جيدًا إذا لم نتمكن من الحصول على معلومات.
Dialogue: 0,0:19:22.76,0:19:25.89,Default,,0,0,0,,‫تبا!
Dialogue: 0,0:19:30.48,0:19:31.48,Default,,0,0,0,,ما الأمر، أبي؟
Dialogue: 0,0:19:31.60,0:19:33.48,Default,,0,0,0,,هل دخلت في غفوتك المعتادة؟
Dialogue: 0,0:19:41.55,0:19:43.59,Default,,0,0,0,,‫لقد سكر للتو ونام.
Dialogue: 0,0:19:44.63,0:19:45.72,Default,,0,0,0,,‫أعلم ذلك!
Dialogue: 0,0:19:46.47,0:19:48.76,Default,,0,0,0,,يا كونان، هل يمكنك أن تطلب منهم تجهيز الملاءات؟
Dialogue: 0,0:19:48.97,0:19:51.10,Default,,0,0,0,,‫والمراتب أيضًا.
Dialogue: 0,0:19:52.06,0:19:52.93,Default,,0,0,0,,‫أسرع!
Dialogue: 0,0:19:53.27,0:19:54.02,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:19:58.37,0:19:59.37,Default,,0,0,0,,‫إنها صاحبة النزل.
Dialogue: 0,0:20:00.42,0:20:02.67,Default,,0,0,0,,إلى أين ذاهبة ومعها باقة زهور في هذا الوقت؟
Dialogue: 0,0:20:20.16,0:20:21.45,Default,,0,0,0,,كونان؟
Dialogue: 0,0:20:22.04,0:20:23.75,Default,,0,0,0,,أين ذهب؟
Dialogue: 0,0:20:26.12,0:20:27.42,Default,,0,0,0,,‫حذاء كونان مفقود.
Dialogue: 0,0:20:28.92,0:20:30.17,Default,,0,0,0,,هل هرب إلى الخارج؟
Dialogue: 0,0:20:40.64,0:20:41.51,Default,,0,0,0,,‫أنا آسفة.
Dialogue: 0,0:20:42.27,0:20:43.47,Default,,0,0,0,,‫أنا آسفة.
Dialogue: 0,0:21:03.08,0:21:03.91,Default,,0,0,0,,‫إنها آنسة توكو.
Dialogue: 0,0:21:08.58,0:21:11.13,Default,,0,0,0,,ماذا يعني... هذا؟
Dialogue: 0,0:21:12.13,0:21:14.46,Default,,0,0,0,,أين أنت يا كونان؟
Dialogue: 0,0:21:17.38,0:21:18.80,Default,,0,0,0,,ضريح كاجيكورا؟
Dialogue: 0,0:21:19.55,0:21:21.35,Default,,0,0,0,,هل يمكن أنه...؟
Dialogue: 0,0:21:45.95,0:21:47.21,Default,,0,0,0,,‫أنت! ماذا تفعل هنا؟!
Dialogue: 0,0:21:48.33,0:21:50.71,Default,,0,0,0,,‫اهذا أنت يا كونان!
Dialogue: 0,0:21:51.25,0:21:53.17,Default,,0,0,0,,ما الذي تفعله في مكان كهذا؟
Dialogue: 0,0:21:53.92,0:21:55.80,Default,,0,0,0,,‫فـ-فقط أختبر شجاعتي...
Dialogue: 0,0:21:56.13,0:21:57.63,Default,,0,0,0,,‫لا تخفني هكذا.
Dialogue: 0,0:21:57.67,0:21:59.13,Default,,0,0,0,,ولكن هل حدث شيء ما؟
Dialogue: 0,0:21:59.47,0:22:02.55,Default,,0,0,0,,‫السيد يابي أُطلق سراحه لعدم وجود أدلة كافية لاحتجازه.
Dialogue: 0,0:22:03.05,0:22:05.22,Default,,0,0,0,,‫ظننت أنه يجب علي إخبار السيد موري بذلك.
Dialogue: 0,0:22:09.85,0:22:11.52,Default,,0,0,0,,‫كان هذا صوت الرئيس فوناكي!
Dialogue: 0,0:22:12.02,0:22:13.19,Default,,0,0,0,,‫كـ-كونان!
Dialogue: 0,0:22:16.23,0:22:17.28,Default,,0,0,0,,ما الذي تفعله؟
Dialogue: 0,0:22:21.28,0:22:22.32,Default,,0,0,0,,‫ران!
Dialogue: 0,0:22:49.34,0:22:53.07,DCEnding,,0,0,0,,كيف أستطيع أن أغيّر كلماتي
Dialogue: 0,0:22:55.01,0:23:00.68,DCEnding,,0,0,0,,لكي تتمكن من الفهم
Dialogue: 0,0:23:01.78,0:23:09.76,DCEnding,,0,0,0,,منذ ذلك الحين، مرّت فصولٌ كثيرة
Dialogue: 0,0:23:11.66,0:23:15.93,DCEnding,,0,0,0,,لكنّك دائمًا كنت تبتسم بجانبي
Dialogue: 0,0:23:17.63,0:23:23.17,DCEnding,,0,0,0,,ومع ذلك، ما زال هناك أمر واحد لا أستطيع قوله
Dialogue: 0,0:23:24.14,0:23:33.78,DCEnding,,0,0,0,,‫سرّ قلبي...
Dialogue: 0,0:23:33.88,0:23:35.88,DCEnding,,0,0,0,,لا أحمل أي شكوك
Dialogue: 0,0:23:35.95,0:23:38.69,DCEnding,,0,0,0,,طالما بقي هناك ولو قليلٌ من المستقبل
Dialogue: 0,0:23:38.75,0:23:44.69,DCEnding,,0,0,0,,فلا بدّ أن أستطيع العثور على الحقيقة
Dialogue: 0,0:23:44.99,0:23:49.63,DCEnding,,0,0,0,,لا أستطيع البوح بها، فقط القليل بعد
Dialogue: 0,0:23:50.03,0:23:56.30,DCEnding,,0,0,0,,‫أنا أنتظر الفرصة...
Dialogue: 0,0:24:03.10,0:24:05.01,Default,,0,0,0,,‫تلميح كونان القادم!
Dialogue: 0,0:24:05.31,0:24:07.18,Default,,0,0,0,,‫دفتر البنك.
Dialogue: 0,0:24:07.73,0:24:09.14,Default,,0,0,0,,‫في الحلقة القادمة، سيُحل الكثير من الألغاز.
Dialogue: 0,0:24:09.31,0:24:11.02,Default,,0,0,0,,من هو الراكب العاشر؟
Dialogue: 0,0:24:11.19,0:24:12.27,Default,,0,0,0,,‫ذلك أيضًا في الحلقة القادمة...
