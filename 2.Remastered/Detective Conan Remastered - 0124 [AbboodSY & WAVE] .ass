Dialogue: 0,0:00:00.71,0:00:03.87,Default,,0,0,0,,أعذار، ألغاز، خُدع، صفقات
Dialogue: 0,0:00:04.54,0:00:06.22,Default,,0,0,0,,و منظمةٌ سوداءَ غامضة
Dialogue: 0,0:00:06.78,0:00:08.55,Default,,0,0,0,,قضية اليوم ستكون في حفلة
Dialogue: 0,0:00:08.55,0:00:09.81,Default,,0,0,0,,!انتبهوا جيداً يا رجال الأعمال
Dialogue: 0,0:00:10.14,0:00:11.68,Default,,0,0,0,,يرى الحقيقة واحدةً كما هي
Dialogue: 0,0:00:11.68,0:00:13.65,Default,,0,0,0,,يبدو كطفل صغير و لكنه بعقل كبير
Dialogue: 0,0:00:13.65,0:00:15.57,Default,,0,0,0,,و اسمه هو، المحقق كونان
Dialogue: 0,0:01:51.69,0:01:55.45,Default,,0,0,0,,{\pos(410,494)}جريمة قتل القنّاص الغامض\N(الجزء الأول)
Dialogue: 0,0:02:06.23,0:02:07.98,Default,,0,0,0,,!تباً! لقد كان يسبب لنا الصداع
Dialogue: 0,0:02:10.03,0:02:10.97,Default,,0,0,0,,تفضل كونان-كن
Dialogue: 0,0:02:10.97,0:02:11.87,Default,,0,0,0,,شكراً لكِ
Dialogue: 0,0:02:12.83,0:02:14.91,Default,,0,0,0,,رغم أن دور الإنتظار كان طويلاً
Dialogue: 0,0:02:14.91,0:02:17.55,Default,,0,0,0,,إلا أن ذلك الرجل اللطيف سمح لي بأخذ بعض الطعام أولاً
Dialogue: 0,0:02:18.00,0:02:20.18,Default,,0,0,0,,ذاك الذي يتحدث هناك مع مصارع السومو
Dialogue: 0,0:02:20.18,0:02:22.51,Default,,0,0,0,,ذلك الرجل هو مدير مصنع للطلاء
Dialogue: 0,0:02:22.51,0:02:23.98,Default,,0,0,0,,هل تعرفه كونان-كن؟
Dialogue: 0,0:02:24.52,0:02:25.88,Default,,0,0,0,,..ليس فعلاً و لكن
Dialogue: 0,0:02:25.88,0:02:27.18,Default,,0,0,0,,إنظري إلى أصابعه{\fnArial\c&H3132A5&}
Dialogue: 0,0:02:27.18,0:02:27.94,Default,,0,0,0,,أصابعه؟
Dialogue: 0,0:02:28.52,0:02:32.03,Default,,0,0,0,,..إذا كنتِ تتعاملين بالطلاء يومياً
Dialogue: 0,0:02:32.62,0:02:35.71,Default,,0,0,0,,{\b1\i0\u0\s0\fnArial}ستكون أصابعك و حتى أظافرك مطليةً به
Dialogue: 0,0:02:37.21,0:02:39.42,Default,,0,0,0,,و لكن ألن يكون لدى عامل الطلاء الشيء نفسه أيضاً؟
Dialogue: 0,0:02:40.04,0:02:42.00,Default,,0,0,0,,كيف عرفت أنه هو المدير؟
Dialogue: 0,0:02:42.00,0:02:44.31,Default,,0,0,0,,انظري إلى الفرق بين يده اليسرى و اليمنى
Dialogue: 0,0:02:45.60,0:02:48.69,Default,,0,0,0,,اليمنى مسمرّة و لكن اليسرى ليست كذلك صحيح؟
Dialogue: 0,0:02:49.48,0:02:51.99,Default,,0,0,0,,باختصار، يبدو أنه يلعب الغولف كثيراً
Dialogue: 0,0:02:53.12,0:02:56.83,Default,,0,0,0,,إذا لم يذهب للعب الغولف كثيراً مؤخراً، فلن يكون الفرق واضحاً لهذه الدرجة
Dialogue: 0,0:02:57.62,0:03:00.62,Default,,0,0,0,,إذا كان موظفاً فقط، فلن يمكنه الذهاب ليلعب كثيراً
Dialogue: 0,0:03:00.62,0:03:02.27,Default,,0,0,0,,..مما يجعله هو المدير هكذا
Dialogue: 0,0:03:02.27,0:03:03.38,Default,,0,0,0,,!تماماً
Dialogue: 0,0:03:04.01,0:03:05.55,Default,,0,0,0,,المعذرة، اعذروني
Dialogue: 0,0:03:06.39,0:03:08.80,Default,,0,0,0,,هل يمكنني الحصول على توقيعك أيضاً لو سمحت؟
Dialogue: 0,0:03:08.80,0:03:11.86,Default,,0,0,0,,!أنا معجبٌ كبيرٌ لك.. يا كازيكابوتو زيكي
Dialogue: 0,0:03:12.83,0:03:14.75,Default,,0,0,0,,!اسمي هو كازي إيواتو
Dialogue: 0,0:03:17.45,0:03:18.95,Default,,0,0,0,,..أعتذر عن هذا
Dialogue: 0,0:03:24.60,0:03:26.46,Default,,0,0,0,,..كان مخيفاً
Dialogue: 0,0:03:26.46,0:03:29.69,Default,,0,0,0,,من الصعب التمييز بين لاعبي السومو بدون ملابسهم الخاصة
Dialogue: 0,0:03:30.44,0:03:32.66,Default,,0,0,0,,!في هذه الحالة لن أحصل أنا أيضاً على توقيع
Dialogue: 0,0:03:37.66,0:03:39.15,Default,,0,0,0,,!انتظر يا أبي
Dialogue: 0,0:03:39.15,0:03:41.66,Default,,0,0,0,,!أنت تحرجنا هكذا توقف عن الأكل بصوتٍ مرتفع
Dialogue: 0,0:03:42.38,0:03:45.67,Default,,0,0,0,,أعطاني أحدٌ ما تذكرة دخول هذه الحفلة كأجرة عملي كمحقق
Dialogue: 0,0:03:45.67,0:03:47.47,Default,,0,0,0,,!سيكون هذا هدراً لها إن لم أتناول كل ما أستطيع
Dialogue: 0,0:03:49.02,0:03:50.40,Default,,0,0,0,,أنت السيد موري كوغورو صحيح؟
Dialogue: 0,0:03:50.89,0:03:51.43,Default,,0,0,0,,نعم؟
Dialogue: 0,0:03:53.57,0:03:55.99,Default,,0,0,0,,اسمي هو تاناكا يوكيكو
Dialogue: 0,0:03:53.59,0:03:58.82,bb,,0,0,0,,{\p1\pos(826,755)}m -3 -4 l -3 -4 l -3 -4 l -30 -4 l -30 -12 l -30 -12 l -3 -12{\p0}
Dialogue: 0,0:03:53.59,0:03:58.82,11,,0,0,0,,{\pos(402,522)}{\c&HDD95AC&}(٢٥) تاناكا يوكيكو
Dialogue: 0,0:03:56.91,0:03:58.70,Default,,0,0,0,,هل يمكنك منحي بعض الوقت؟
Dialogue: 0,0:04:00.08,0:04:01.32,Default,,0,0,0,,!نعم! بالطبع بالطبع
Dialogue: 0,0:04:01.32,0:04:02.62,Default,,0,0,0,,!وقتي كله لكِ
Dialogue: 0,0:04:02.62,0:04:04.60,Default,,0,0,0,,!يمكننا التزوج أيضاً إذا أردتِ
Dialogue: 0,0:04:06.26,0:04:07.46,Default,,0,0,0,,اتبعني من فضلك
Dialogue: 0,0:04:07.46,0:04:09.39,Default,,0,0,0,,!بالتأكيد، سأذهب أينما كان
Dialogue: 0,0:04:13.03,0:04:15.82,Default,,0,0,0,,اوه... أنت رئيس شركة؟
Dialogue: 0,0:04:16.16,0:04:16.90,Default,,0,0,0,,{\an8}صحيح
Dialogue: 0,0:04:16.19,0:04:22.90,bb,,0,0,0,,{\p1\pos(826,755)}m -3 -4 l -3 -4 l -3 -4 l -30 -4 l -30 -12 l -30 -12 l -3 -12{\p0}
Dialogue: 0,0:04:16.19,0:04:22.90,11,,0,0,0,,{\c&HFFB9CD&\pos(404,519)}(٥٤) سيجي إيشيموتو
Dialogue: 0,0:04:16.90,0:04:22.88,Default,,0,0,0,,{\an8}أنا أنتج و أبيع قطع الأجهزة الموجودة بشكلٍ رئيسي في الحواسيب و الطائرات
Dialogue: 0,0:04:23.34,0:04:25.54,Default,,0,0,0,,إذاً.. ما الذي تريده مني؟
Dialogue: 0,0:04:25.54,0:04:26.22,Default,,0,0,0,,..تاناكا-كن
Dialogue: 0,0:04:26.76,0:04:27.83,Default,,0,0,0,,حاضر
Dialogue: 0,0:04:27.83,0:04:30.36,Default,,0,0,0,,في الحقيقة، تلقى مديرنا تهديداً ما
Dialogue: 0,0:04:30.36,0:04:31.52,Default,,0,0,0,,تهديداً؟
Dialogue: 0,0:04:34.15,0:04:37.35,Default,,0,0,0,,لقد خسرت قيمتك أياً كانت بالنسبة لك كرجل
Dialogue: 0,0:04:37.35,0:04:39.36,Default,,0,0,0,,سأتأكد من القيام بقتلك بنفسي
Dialogue: 0,0:04:39.99,0:04:42.59,Default,,0,0,0,,سيد موري، نريد منك أن تجد الشخص الذي كتبها
Dialogue: 0,0:04:43.59,0:04:44.79,Default,,0,0,0,,إذاً كونان-كن
Dialogue: 0,0:04:44.79,0:04:46.05,Default,,0,0,0,,هل تعرف الشخص الذي يقف هناك؟
Dialogue: 0,0:04:46.76,0:04:47.43,Default,,0,0,0,,الذي يقف على اليسار
Dialogue: 0,0:04:48.76,0:04:51.71,Default,,0,0,0,,الرجل الذي أعطى الآخر بطاقة عمله يبدو كشخصٍ مهم
Dialogue: 0,0:04:51.71,0:04:53.64,Default,,0,0,0,,كما أن لا يزال ينحني بكثرة للرجل الآخر
Dialogue: 0,0:04:53.64,0:04:55.29,Default,,0,0,0,,أعتقد أن الرجل الذي على اليسار ذو نفوذٍ عالي
Dialogue: 0,0:05:02.92,0:05:06.63,Default,,0,0,0,,بالنسبة لي، أعتقد أنه إبن أحد المحتكرين الأثرياء
Dialogue: 0,0:05:07.17,0:05:08.42,Default,,0,0,0,,لا أعتقد هذا
Dialogue: 0,0:05:09.29,0:05:13.80,bb,,0,0,0,,{\p1\pos(824,755)}m -3 -4 l -3 -4 l -3 -4 l -30 -4 l -30 -12 l -30 -12 l -3 -12{\p0}
Dialogue: 0,0:05:09.29,0:05:13.80,11,,0,0,0,,{\c&HEDADC7&\pos(402,526)}(٣٢) تسونياكي نيكورا
Dialogue: 0,0:05:09.72,0:05:13.15,Default,,0,0,0,,{\an8}على الأرجح أنه سكرتير إحدى السياسيين المعروفين ألا تظني؟
Dialogue: 0,0:05:15.03,0:05:16.11,Default,,0,0,0,,أعتقد هذا..؟
Dialogue: 0,0:05:16.57,0:05:18.11,Default,,0,0,0,,..على أي حال، ذلك الرجل
Dialogue: 0,0:05:19.66,0:05:21.69,Default,,0,0,0,,لا أعتقد أنه مدعو هنا
Dialogue: 0,0:05:21.69,0:05:24.71,Default,,0,0,0,,منذ لحظة دخوله قبل قليل و هو يسترق النظر على الجميع
Dialogue: 0,0:05:25.46,0:05:27.59,Default,,0,0,0,,إنه ليس هنا للإستمتاع بالحفلة على الإطلاق
Dialogue: 0,0:05:27.97,0:05:28.93,Default,,0,0,0,,ما هي مهنته؟
Dialogue: 0,0:05:31.85,0:05:34.55,Default,,0,0,0,,هل لديك عداوةٌ مع أشخاص محددين؟
Dialogue: 0,0:05:34.55,0:05:35.19,Default,,0,0,0,,كلا
Dialogue: 0,0:05:35.73,0:05:38.57,Default,,0,0,0,,إذاً، لماذا لم تتصلوا بالشرطة؟
Dialogue: 0,0:05:38.99,0:05:41.65,Default,,0,0,0,,المدير لم يُعجب أبداً بالشرطة من قبل
Dialogue: 0,0:05:41.65,0:05:47.55,Default,,0,0,0,,و أيضاً، الشرطة لن تقوم بفعل شيءٍ حتى يحصل شيئاً ما جدياً صحيح؟
Dialogue: 0,0:05:48.17,0:05:51.54,Default,,0,0,0,,..حسناً.. تلك عادةٌ بشعة في معاملتهم
Dialogue: 0,0:05:51.54,0:05:54.14,Default,,0,0,0,,!و لكن.. تبدين على إتطلاعٍ جيدٍ بهذا الأمر
Dialogue: 0,0:05:55.15,0:05:59.07,Default,,0,0,0,,لست أنا من يفهم التعامل مع الشرطة فحسب، بل أنت كذلك أيضاً، سيد موري
Dialogue: 0,0:05:59.82,0:06:02.17,Default,,0,0,0,,لهذا السبب اخترتك خصيصاً للقيام بهذا
Dialogue: 0,0:06:02.66,0:06:03.62,Default,,0,0,0,,هل فعلتِ؟
Dialogue: 0,0:06:04.21,0:06:07.96,Default,,0,0,0,,بعد قيامي بالبحث في حاسوبي، وجدت أن السيد موري هو أفضل اختيار بالتأكيد
Dialogue: 0,0:06:08.88,0:06:09.84,Default,,0,0,0,,!هكذا إذاً
Dialogue: 0,0:06:10.80,0:06:12.44,Default,,0,0,0,,لقد قبلت بهذه القضية صحيح؟
Dialogue: 0,0:06:12.77,0:06:14.30,Default,,0,0,0,,!لا مشكلة
Dialogue: 0,0:06:14.30,0:06:18.91,Default,,0,0,0,,و لكن من الآن فصاعداً، سأضطر أن أبقى قريباً من السيد إيشموتو
Dialogue: 0,0:06:18.91,0:06:19.27,Default,,0,0,0,,حسناً
Dialogue: 0,0:06:20.03,0:06:22.67,Default,,0,0,0,,سأترك لك مسألة التعامل مع التحقيقات كلها
Dialogue: 0,0:06:24.33,0:06:26.62,Default,,0,0,0,,!يمكنني التقرب هكذا من السيدة يوكيكو أيضاً
Dialogue: 0,0:06:27.75,0:06:28.75,Default,,0,0,0,,!يا فتى
Dialogue: 0,0:06:29.54,0:06:31.33,Default,,0,0,0,,!سوف ألتقط لك صورةً للذكرى
Dialogue: 0,0:06:32.47,0:06:34.68,Default,,0,0,0,,!ران-نيتشان دعينا نتصور سويةً
Dialogue: 0,0:06:34.68,0:06:34.93,Default,,0,0,0,,بسرعة
Dialogue: 0,0:06:35.39,0:06:36.27,Default,,0,0,0,,من هنا
Dialogue: 0,0:06:36.77,0:06:37.52,Default,,0,0,0,,من هذا الإتجاه
Dialogue: 0,0:06:39.27,0:06:40.98,Default,,0,0,0,,نحن مستعدون
Dialogue: 0,0:06:41.32,0:06:42.50,Default,,0,0,0,,و الآن قل
Dialogue: 0,0:06:42.95,0:06:43.91,Default,,0,0,0,,!ابتسم
Dialogue: 0,0:06:47.29,0:06:51.38,Default,,0,0,0,,على أي حال، أنا لم أقم بفعل شيءٍ يغضب الناس
Dialogue: 0,0:06:52.31,0:06:55.51,Default,,0,0,0,,و لكن، بصفتي رجلاً عاش لسنواتٍ عديدة
Dialogue: 0,0:06:55.51,0:06:59.27,Default,,0,0,0,,من المحتمل أنني قد أكون جرحت أحداً ما بغير علمٍ في مرحلةٍ ما من عمري
Dialogue: 0,0:06:59.77,0:07:02.07,Default,,0,0,0,,!و لكن بالطبع هذا ليس خطأي
Dialogue: 0,0:07:05.62,0:07:06.78,Default,,0,0,0,,سوف نبدأ الآن
Dialogue: 0,0:07:06.78,0:07:10.37,Default,,0,0,0,,أريد أن أرحب بضيوفنا لليوم ليلقوا بعض الكلمات أمامنا
Dialogue: 0,0:07:11.04,0:07:14.46,Default,,0,0,0,,عضو مجلس النواب الياباني، الاستاذ تاكادا ماساو
Dialogue: 0,0:07:14.46,0:07:15.98,Default,,0,0,0,,تفضل إلى المسرح من فضلك
Dialogue: 0,0:07:21.91,0:07:23.50,Default,,0,0,0,,من هنا سيدي
Dialogue: 0,0:07:25.41,0:07:27.95,Default,,0,0,0,,!أرأيتِ! إنه سكرتير البرلماني بالفعل
Dialogue: 0,0:07:28.58,0:07:29.28,Default,,0,0,0,,!أنت محق
Dialogue: 0,0:07:29.28,0:07:30.42,Default,,0,0,0,,!كونان-كن أنت مدهش
Dialogue: 0,0:07:30.92,0:07:32.68,Default,,0,0,0,,شكراً لكم، شكراً لكم
Dialogue: 0,0:07:34.05,0:07:35.30,Default,,0,0,0,,و لكن هذا رائع صحيح؟
Dialogue: 0,0:07:35.30,0:07:38.52,Default,,0,0,0,,لقد تمكنوا من تصويب الأضواء عليه بالرغم من حلكة الظلام هنا
Dialogue: 0,0:07:38.98,0:07:41.51,Default,,0,0,0,,ربما قد طُلب منه أن يقف في مكانٍ محدد مسبقاً
Dialogue: 0,0:07:41.51,0:07:45.74,Default,,0,0,0,,أو ربما ضوء المسرح تم تصميمه على أن يذهب باتجاه المايكروفون الذي على صدره اوتوماتيكياً
Dialogue: 0,0:07:48.91,0:07:51.92,Default,,0,0,0,,لماذا لم يتجه مباشرةً نحو المسرح؟
Dialogue: 0,0:07:51.92,0:07:52.96,Default,,0,0,0,,..من يعلم
Dialogue: 0,0:07:52.96,0:07:55.68,Default,,0,0,0,,ربما يريد لفت انتباه الجميع نحوه؟
Dialogue: 0,0:07:58.93,0:07:59.55,Default,,0,0,0,,لقد رحل
Dialogue: 0,0:08:01.60,0:08:03.36,Default,,0,0,0,,اوه سيد إيشيموتو، اعذرنا من فضلك
Dialogue: 0,0:08:03.95,0:08:05.24,Default,,0,0,0,,أهلاً بكم، شكراً على مجيئكم
Dialogue: 0,0:08:08.70,0:08:09.45,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:08:10.91,0:08:11.54,Default,,0,0,0,,!أيها المدير
Dialogue: 0,0:08:13.34,0:08:14.43,Default,,0,0,0,,..نيكورا-كن
Dialogue: 0,0:08:34.38,0:08:36.34,Default,,0,0,0,,!سيدي! سيدي! سيدي
Dialogue: 0,0:08:50.19,0:08:50.69,Default,,0,0,0,,تباً
Dialogue: 0,0:08:51.24,0:08:52.66,Default,,0,0,0,,لقد هرب من هنا بسرعة
Dialogue: 0,0:09:01.22,0:09:03.31,Default,,0,0,0,,!شيءٌ ما فظيعٌ حصل لسيدي
Dialogue: 0,0:09:03.98,0:09:05.98,Default,,0,0,0,,نعم، اتصل باللجنة من فضلك
Dialogue: 0,0:09:09.94,0:09:11.36,Default,,0,0,0,,نعم، إنه أنا نيكورا
Dialogue: 0,0:09:11.82,0:09:14.91,Default,,0,0,0,,..إيشموتو تعرض للتهديد من أحدهم
Dialogue: 0,0:09:14.91,0:09:17.49,Default,,0,0,0,,حيث أنه يستهدف حياته صحيح؟
Dialogue: 0,0:09:17.49,0:09:18.24,Default,,0,0,0,,نعم
Dialogue: 0,0:09:18.24,0:09:19.97,Default,,0,0,0,,قام بتوكيلي لديه لهذا السبب
Dialogue: 0,0:09:20.34,0:09:24.09,Default,,0,0,0,,مما يعني، الرصاصة التي كانت تستهدف إيشموتو قد انحرفت عن مسارها
Dialogue: 0,0:09:24.09,0:09:27.06,Default,,0,0,0,,و أصابت السياسي تاكادا بدلاً عن ذلك صحيح؟
Dialogue: 0,0:09:27.06,0:09:28.69,Default,,0,0,0,,نعم، هذا ما حصل
Dialogue: 0,0:09:29.31,0:09:31.77,Default,,0,0,0,,كان هناك العديد من الحضور هنا
Dialogue: 0,0:09:31.77,0:09:33.75,Default,,0,0,0,,من الممكن أن يكون هناك بعض الشهود
Dialogue: 0,0:09:35.33,0:09:37.05,Default,,0,0,0,,أين هم الحضور الآن؟
Dialogue: 0,0:09:37.05,0:09:39.96,Default,,0,0,0,,نعم، لقد قمنا بجمعهم في الغرفة المجاورة
Dialogue: 0,0:09:43.63,0:09:45.68,Default,,0,0,0,,كيف أمكنك الذهاب هكذا؟
Dialogue: 0,0:09:46.02,0:09:48.40,Default,,0,0,0,,كنت خائفاً كثيراً.. لذا ذهبت إلى الحمام
Dialogue: 0,0:09:49.02,0:09:49.48,Default,,0,0,0,,!عمي
Dialogue: 0,0:09:50.73,0:09:53.07,Default,,0,0,0,,هذه القضية لا تحتاج مساعدة شقيٍّ مثلك
Dialogue: 0,0:09:53.91,0:09:57.05,Default,,0,0,0,,..و لكنني رأيت مشتبهاً به للتو
Dialogue: 0,0:09:57.05,0:09:57.95,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:09:57.95,0:10:01.42,Default,,0,0,0,,ذاك الرجل كان يتّكئ على الجدار منذ بداية الإجتماع و لكن
Dialogue: 0,0:10:01.42,0:10:04.97,Default,,0,0,0,,مباشرةً بعد أن أُطلقت النار قام بالصعود إلى غرفة التحكم بالإضاءة هناك
Dialogue: 0,0:10:05.68,0:10:06.97,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:10:07.60,0:10:11.31,Default,,0,0,0,,إذا كان المكان ذاك، سيكون من السهل التصويب على جميع الحضور
Dialogue: 0,0:10:12.86,0:10:14.87,Default,,0,0,0,,و من كان ذلك الشخص؟
Dialogue: 0,0:10:15.66,0:10:16.12,Default,,0,0,0,,!ذلك الرجل
Dialogue: 0,0:10:18.16,0:10:19.79,Default,,0,0,0,,!يبدو تماماً مثل القاتل
Dialogue: 0,0:10:20.33,0:10:22.45,Default,,0,0,0,,ما الذي تفعله موري-كن؟
Dialogue: 0,0:10:22.45,0:10:23.09,Default,,0,0,0,,!لنذهب
Dialogue: 0,0:10:23.55,0:10:24.88,Default,,0,0,0,,!أيها المفتش
Dialogue: 0,0:10:24.88,0:10:27.22,Default,,0,0,0,,!هذه صورةٌ لأحدٍ ما قد يكون المشتبه به
Dialogue: 0,0:10:27.64,0:10:29.24,Default,,0,0,0,,ماذا، حقاً!؟
Dialogue: 0,0:10:29.24,0:10:31.52,Default,,0,0,0,,نعم، يجب أن يكون القاتل هو
Dialogue: 0,0:10:40.54,0:10:42.63,Default,,0,0,0,,كونان-كن، لا يمكنك لمس هذا
Dialogue: 0,0:10:43.08,0:10:45.55,Default,,0,0,0,,سيد تاكاغي، ما هذه؟
Dialogue: 0,0:10:46.10,0:10:47.06,Default,,0,0,0,,هذه قِطع مكسورة
Dialogue: 0,0:10:47.56,0:10:50.61,Default,,0,0,0,,إنها لذلك المايكروفون الذي كان يرتديه السياسي تاكادا في ذلك الوقت
Dialogue: 0,0:10:50.98,0:10:52.86,Default,,0,0,0,,إذاً هل أصابت الرصاصة ذلك المايكروفون؟
Dialogue: 0,0:10:53.44,0:10:54.87,Default,,0,0,0,,هكذا يبدو
Dialogue: 0,0:10:56.95,0:10:59.20,Default,,0,0,0,,..هيا هذا يكفي الآن، كونان-كن
Dialogue: 0,0:10:59.79,0:11:01.53,Default,,0,0,0,,المعذرة منك سيد تاكاغي
Dialogue: 0,0:11:01.53,0:11:03.08,Default,,0,0,0,,دائماً ما يفعل هذا كلما أبعدت ناظري عنه
Dialogue: 0,0:11:03.88,0:11:05.92,Default,,0,0,0,,كونان-كن، لنذهب و ننتظر في الرواق
Dialogue: 0,0:11:16.41,0:11:18.61,Default,,0,0,0,,كونان-كن إلى أين أنت ذاهب؟
Dialogue: 0,0:11:18.61,0:11:19.90,Default,,0,0,0,,!إلى الحمام
Dialogue: 0,0:11:19.90,0:11:21.24,Default,,0,0,0,,!لا أستطيع الصبر أكثر
Dialogue: 0,0:11:24.09,0:11:25.22,Default,,0,0,0,,إلى أي حمام ستذهب؟
Dialogue: 0,0:11:33.06,0:11:34.31,Default,,0,0,0,,!كان هذا ممتعاً للغاية
Dialogue: 0,0:11:34.31,0:11:35.11,Default,,0,0,0,,صحيح
Dialogue: 0,0:11:40.45,0:11:42.16,Default,,0,0,0,,تبدو متوترةً جداً
Dialogue: 0,0:11:43.29,0:11:45.76,Default,,0,0,0,,من هو.. هذا الرجل ذو الشعر الطويل؟
Dialogue: 0,0:12:06.59,0:12:07.01,Default,,0,0,0,,لقد رحل
Dialogue: 0,0:12:09.43,0:12:11.27,Default,,0,0,0,,كانت حياة المدير على المحك
Dialogue: 0,0:12:12.10,0:12:14.24,Default,,0,0,0,,و ها هي ذا تتركه وحيداً لتقابل هذا الرجل
Dialogue: 0,0:12:15.40,0:12:16.99,Default,,0,0,0,,هناك شيءٌ ما ليس صحيحاً
Dialogue: 0,0:12:31.96,0:12:34.70,Default,,0,0,0,,سيد موري، انتهى استجواب الشرطة لي
Dialogue: 0,0:12:34.70,0:12:36.84,Default,,0,0,0,,أريد العودة لمنزلي الآن
Dialogue: 0,0:12:36.84,0:12:40.81,Default,,0,0,0,,سيد إيشيموتو، صحيحٌ أن إصابتك\N..ليست شديدة الخطورة و لكن
Dialogue: 0,0:12:40.81,0:12:43.43,Default,,0,0,0,,!حياتك هي ما يسعى خلفها القاتل الآن
Dialogue: 0,0:12:43.43,0:12:45.32,Default,,0,0,0,,دعنا نذهب إلى مستشفى الشرطة
Dialogue: 0,0:12:45.32,0:12:46.57,Default,,0,0,0,,نحن لا نتعامل مع الشرطة
Dialogue: 0,0:12:47.95,0:12:50.45,Default,,0,0,0,,هنالك مستشفى اخرى نذهب إليها في العادة
Dialogue: 0,0:12:50.45,0:12:55.05,Default,,0,0,0,,و أيضاً، يجب أن يكون حر الإختيار في ما إن كان يريد حماية الشرطة له أم لا
Dialogue: 0,0:12:55.46,0:12:57.71,Default,,0,0,0,,...صحيح و لكن
Dialogue: 0,0:12:57.71,0:13:00.73,Default,,0,0,0,,في هذه الحالة، من الذي سيقوم بحماية السيد إيشموتو؟
Dialogue: 0,0:13:01.27,0:13:03.39,Default,,0,0,0,,أنت يا سيد موري
Dialogue: 0,0:13:03.39,0:13:04.44,Default,,0,0,0,,نحن نعتمد عليك
Dialogue: 0,0:13:05.11,0:13:07.61,Default,,0,0,0,,!لقد فهمت، عُلِم
Dialogue: 0,0:13:07.61,0:13:09.86,Default,,0,0,0,,سأبقى معه بدءاً من الليلة
Dialogue: 0,0:13:09.86,0:13:11.41,Default,,0,0,0,,إذاً يا مدير، لنذهب للمشفى
Dialogue: 0,0:13:16.62,0:13:16.96,Default,,0,0,0,,نعم؟
Dialogue: 0,0:13:16.96,0:13:18.35,Default,,0,0,0,,فيما يخص الرجل الذي في الصورة
Dialogue: 0,0:13:18.89,0:13:20.09,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,0:13:20.09,0:13:24.73,Default,,0,0,0,,لقد ألقينا نظرةً على لائحة المدعوين و لا يبدو أنه كان فيها
Dialogue: 0,0:13:25.23,0:13:29.90,Default,,0,0,0,,و لكننا قمنا بتشديد الحراسة في المكان لذا قد نتوصل لشيءٍ ما قريباً
Dialogue: 0,0:13:29.90,0:13:31.91,Default,,0,0,0,,بالنسبة للسجلات الإجرامية، لا تزال تحت التفتيش
Dialogue: 0,0:13:32.25,0:13:35.03,Default,,0,0,0,,سيد موري ما الذي تفعله!؟
Dialogue: 0,0:13:35.03,0:13:36.62,Default,,0,0,0,,!لا تدعني لوحدي
Dialogue: 0,0:13:37.18,0:13:39.67,Default,,0,0,0,,!حسناً حسناً! سآتي على الفور
Dialogue: 0,0:13:39.67,0:13:42.84,Default,,0,0,0,,هل تعلم ما هي مشفى الشرطة التي من المفترض أن يذهب لها؟
Dialogue: 0,0:13:42.84,0:13:45.06,Default,,0,0,0,,يقول أنه يكره الشرطة
Dialogue: 0,0:13:45.77,0:13:49.16,Default,,0,0,0,,بدءاً من اليوم، سأبقى مع السيدة يوكيكو كحارس أمن لهم
Dialogue: 0,0:13:51.45,0:13:53.08,Default,,0,0,0,,..من الأفضل أن تبقى بعيداً عن هذا
Dialogue: 0,0:13:54.16,0:13:55.12,Default,,0,0,0,,حسناً، تفضل
Dialogue: 0,0:13:56.71,0:13:59.01,Default,,0,0,0,,!يالها من سيارةٍ فارهة
Dialogue: 0,0:14:01.93,0:14:03.93,Default,,0,0,0,,سيدة يوكيكو، لِمَ لا تجلسين هنا؟
Dialogue: 0,0:14:04.39,0:14:08.32,Default,,0,0,0,,لأسبابٍ أمنية، ألا تعتقد أن كلانا يجب أن يجلس على جانبي المدير؟
Dialogue: 0,0:14:09.24,0:14:10.91,Default,,0,0,0,,..هذا.. هذا صحيح
Dialogue: 0,0:14:11.62,0:14:13.33,Default,,0,0,0,,هيا لنعود إلى المنزل
Dialogue: 0,0:14:20.51,0:14:23.35,Default,,0,0,0,,..لنرى.. محطة القطار من هناك
Dialogue: 0,0:14:32.99,0:14:35.08,Default,,0,0,0,,كان هناك العديد من الضيوف في ذلك الإزدحام
Dialogue: 0,0:14:35.95,0:14:38.38,Default,,0,0,0,,إذا أراد أحدٌ ما إطلاق النار على السيد إيشموتو سيكون هذا صعباً قليلاً
Dialogue: 0,0:14:39.80,0:14:41.47,Default,,0,0,0,,مالم يكن محترفاً بهذا
Dialogue: 0,0:14:55.45,0:14:56.45,Default,,0,0,0,,ما هذه الآثار؟
Dialogue: 0,0:14:57.09,0:14:58.63,Default,,0,0,0,,..هناك مواد لاصقة و خدوش حديثة
Dialogue: 0,0:14:59.97,0:15:01.35,Default,,0,0,0,,لم قد يكون شيئاً ما كهذا هنا
Dialogue: 0,0:15:02.59,0:15:03.17,Default,,0,0,0,,!انتظر
Dialogue: 0,0:15:05.81,0:15:06.64,Default,,0,0,0,,..بقايا المايكروفون
Dialogue: 0,0:15:08.28,0:15:09.61,Default,,0,0,0,,..غرفة التحكم بالإضاءة
Dialogue: 0,0:15:18.67,0:15:20.71,Default,,0,0,0,,!هذا رائع
Dialogue: 0,0:15:20.71,0:15:22.67,Default,,0,0,0,,!هذه لا تبدو كغرفة في مستشفى
Dialogue: 0,0:15:22.67,0:15:25.13,Default,,0,0,0,,!تبدو كجناحٍ في فندق
Dialogue: 0,0:15:25.13,0:15:29.15,Default,,0,0,0,,سيد موري غرفتك ستكون تلك التي مررنا بها منذ لحظات من هنا
Dialogue: 0,0:15:29.57,0:15:32.24,Default,,0,0,0,,باختصار، هناك مخرجٌ واحد بين الغرفتين
Dialogue: 0,0:15:33.32,0:15:37.96,Default,,0,0,0,,إن أراد أحدٌ ما المجيء إلى هنا سيضطر للعبور من خلال غرفتك أولاً
Dialogue: 0,0:15:38.50,0:15:39.79,Default,,0,0,0,,!لقد فهمت
Dialogue: 0,0:15:39.79,0:15:42.08,Default,,0,0,0,,..كما هو متوقع من السيدة يوكيكو
Dialogue: 0,0:15:42.08,0:15:44.38,Default,,0,0,0,,!لقد فكرتِّ حتى في كيفية إبقاء الغرفة آمنة
Dialogue: 0,0:15:45.01,0:15:46.67,Default,,0,0,0,,بالطبع
Dialogue: 0,0:15:46.67,0:15:49.40,Default,,0,0,0,,مديرنا كان يدير شركتنا بنفسه فقط
Dialogue: 0,0:15:49.86,0:15:52.66,Default,,0,0,0,,إذا حصل شيءٌ ما للمدير\N..سينتهي أمر شركتنا أيضاً
Dialogue: 0,0:15:53.70,0:15:57.41,Default,,0,0,0,,بالمناسبة، سيدة يوكيكو، أين ستبيتين الليلة؟
Dialogue: 0,0:15:57.41,0:15:59.21,Default,,0,0,0,,هناك سريرٌ واحدٌ هنا
Dialogue: 0,0:15:59.71,0:16:01.49,Default,,0,0,0,,سأذهب لمنزلي كي أنام
Dialogue: 0,0:16:01.49,0:16:04.18,Default,,0,0,0,,لأن السيد موري موجودٌ هنا الآن ليحرس مديرنا
Dialogue: 0,0:16:04.51,0:16:05.97,Default,,0,0,0,,..هكذا إذاً
Dialogue: 0,0:16:06.98,0:16:07.65,Default,,0,0,0,,تباً
Dialogue: 0,0:16:08.81,0:16:11.06,Default,,0,0,0,,ما رأيك سيد موري
Dialogue: 0,0:16:11.06,0:16:12.35,Default,,0,0,0,,هذه الغرفة جميلةٌ جداً صحيح؟
Dialogue: 0,0:16:12.35,0:16:14.36,Default,,0,0,0,,سأعتمد عليك هذه الليلة
Dialogue: 0,0:16:15.82,0:16:16.99,Default,,0,0,0,,نعم.. سأفعل ما بوسعي
Dialogue: 0,0:16:16.99,0:16:19.58,Default,,0,0,0,,أيها المدير، كيف تجري معالجتك؟
Dialogue: 0,0:16:20.29,0:16:23.25,Default,,0,0,0,,سهلةٌ للغاية، إنه مجرد خدشٍ صغير
Dialogue: 0,0:16:24.01,0:16:27.11,Default,,0,0,0,,تاناكا-كن، سأعتمد عليكِ في التعامل مع مسألة تاكادا
Dialogue: 0,0:16:27.48,0:16:29.94,Default,,0,0,0,,حاضر، سأحرص على الإهتمام بها
Dialogue: 0,0:16:32.90,0:16:34.90,Default,,0,0,0,,السياسي تاكادا؟
Dialogue: 0,0:16:35.36,0:16:37.99,Default,,0,0,0,,يقصد عن جنازته و تكاليفها
Dialogue: 0,0:16:37.99,0:16:42.95,Default,,0,0,0,,بعد كل هذا.. السياسي تاكادا ذهب اضحيةً بدلاً عن مديرنا هذه المرة
Dialogue: 0,0:16:42.95,0:16:44.50,Default,,0,0,0,,لهذا السبب يجب أن أهتم بهذه الأشياء الآن
Dialogue: 0,0:16:44.88,0:16:46.88,Default,,0,0,0,,إذاً يجب أن تغادري الآن؟
Dialogue: 0,0:16:48.48,0:16:52.55,Default,,0,0,0,,موعدي مع سكرتيره السيد نيكورا لم يحن بعد
Dialogue: 0,0:16:52.55,0:16:54.06,Default,,0,0,0,,أعتقد أنه يمكنني البقاء معك لوهلة
Dialogue: 0,0:16:54.90,0:16:55.90,Default,,0,0,0,,حقاً!؟
Dialogue: 0,0:16:56.61,0:16:57.49,Default,,0,0,0,,!أجل
Dialogue: 0,0:16:58.91,0:17:00.37,Default,,0,0,0,,هل تود شيئاً ما للشرب؟
Dialogue: 0,0:17:00.92,0:17:02.34,Default,,0,0,0,,حسناً.. بعض النبيذ
Dialogue: 0,0:17:03.08,0:17:05.33,Default,,0,0,0,,كلا أقصد.. كولا
Dialogue: 0,0:17:06.67,0:17:09.56,Default,,0,0,0,,لو سمحتِ.. أيمكنني أن أطرح سؤالاً؟
Dialogue: 0,0:17:10.14,0:17:11.56,Default,,0,0,0,,نعم، ما هو؟
Dialogue: 0,0:17:12.27,0:17:15.85,Default,,0,0,0,,قلتِ لي أنك استعملتِ حاسوباً لاختياري من أجل التحقيق
Dialogue: 0,0:17:15.85,0:17:19.12,Default,,0,0,0,,و لكن إلى جانب كوني محققاً، هناك محققون آخرون  أيضاً كانوا متوفرين صحيح؟
Dialogue: 0,0:17:19.79,0:17:21.42,Default,,0,0,0,,لماذا اخترتني أنا بالضبط إذاً؟
Dialogue: 0,0:17:22.00,0:17:27.84,Default,,0,0,0,,إذا ركّزنا على الخبرات القديمة و مهارات التحقيق، سيكون لدينا بالطبع العديد من المحققين المهرة
Dialogue: 0,0:17:27.84,0:17:31.15,Default,,0,0,0,,و لكن إذا أردنا أحداً ما يتميز بالجاذبية
Dialogue: 0,0:17:31.77,0:17:33.40,Default,,0,0,0,,سيكون الجواب واضحاً حينها
Dialogue: 0,0:17:33.90,0:17:36.94,Default,,0,0,0,,من يمكننا أن نختار غيرك أنت سيد موري؟
Dialogue: 0,0:17:36.94,0:17:39.62,Default,,0,0,0,,نعم، لقد قمتم بالإختيار الأمثل
Dialogue: 0,0:17:44.12,0:17:45.50,Default,,0,0,0,,!هذا رائعٌ جداً
Dialogue: 0,0:17:46.42,0:17:49.00,Default,,0,0,0,,هذه الكولا لذيذةٌ جداً
Dialogue: 0,0:17:49.00,0:17:49.93,Default,,0,0,0,,جدديها لي من فضلك
Dialogue: 0,0:17:54.81,0:17:57.10,Default,,0,0,0,,نعم؟ صحيح
Dialogue: 0,0:17:57.10,0:17:57.82,Default,,0,0,0,,انتظر من فضلك
Dialogue: 0,0:17:58.62,0:18:00.02,Default,,0,0,0,,سيد موري، مكالمةٌ لك
Dialogue: 0,0:18:00.02,0:18:00.74,Default,,0,0,0,,لي أنا؟
Dialogue: 0,0:18:03.37,0:18:04.04,Default,,0,0,0,,شكراً
Dialogue: 0,0:18:04.83,0:18:07.63,Default,,0,0,0,,نعم، معك المحقق العظيم موري كوغورو
Dialogue: 0,0:18:08.01,0:18:11.97,Default,,0,0,0,,أنت مغرورٌ جداً.. تطلق على\N..نفسك لقب المحقق العظيم
Dialogue: 0,0:18:13.14,0:18:14.35,Default,,0,0,0,,!مفتش ميغوري
Dialogue: 0,0:18:15.06,0:18:17.90,Default,,0,0,0,,بما يخص ذلك الرجل المثير للشك الذي كان في الحفل
Dialogue: 0,0:18:17.90,0:18:19.53,Default,,0,0,0,,لقد استطعنا أن نجد سجله الإجرامي
Dialogue: 0,0:18:19.53,0:18:20.91,Default,,0,0,0,,حقاً تقول!؟
Dialogue: 0,0:18:20.91,0:18:23.33,Default,,0,0,0,,نعم، كان هذا صادماً أيضاً
Dialogue: 0,0:18:23.11,0:18:29.80,bb1,,0,0,0,,{\p1\pos(840,680)}m -3 -4 l -3 -4 l -3 -4 l -30 -4 l -30 -12 l -30 -12 l -3 -12{\p0}
Dialogue: 0,0:18:23.11,0:18:29.80,11,,0,0,0,,{\c&HEF6285&\pos(402,548)}(٣٥) هيراوكا شيرو
Dialogue: 0,0:18:24.00,0:18:26.11,Default,,0,0,0,,{\an8}\Nهيراوكا شيرو، عمره ٣٥ سنة
Dialogue: 0,0:18:26.11,0:18:29.97,Default,,0,0,0,,{\an8}إنه مختصٌ في كشف أسرار الصفقات التجارية ثم التهديد بها من أجل المال
Dialogue: 0,0:18:30.39,0:18:33.88,Default,,0,0,0,,يشاع عنه أنه حين يستهدف أحداً ما لا يتركه أبداً
Dialogue: 0,0:18:33.88,0:18:36.39,Default,,0,0,0,,"أطلق عليه الناس لقب "البيرانا هيراوكا
Dialogue: 0,0:18:36.89,0:18:40.15,Default,,0,0,0,,إذاً هل تعني أن هيراوكا أقحم نفسه في هذه القضية؟
Dialogue: 0,0:18:40.15,0:18:40.98,Default,,0,0,0,,نعم
Dialogue: 0,0:18:40.98,0:18:45.72,Default,,0,0,0,,أعتقد أن السيد إيشموتو قام بفعل شيءٍ ما يستطيع هيراوكا تهديده به
Dialogue: 0,0:18:45.72,0:18:50.00,Default,,0,0,0,,و لكن، بالحكم على تصرفات السيد إيشموتو، يبدو أنه قام بالرفض
Dialogue: 0,0:18:50.00,0:18:55.39,Default,,0,0,0,,و بسبب غضب هيراوكا من رفضه، حاول أن يقوم بإنهاء حياة السيد إيشموتو صحيح؟
Dialogue: 0,0:19:06.33,0:19:10.94,Default,,0,0,0,,من المؤسف لك أنك الآن في قبضتي أنا القاتل الأفعى
Dialogue: 0,0:19:10.94,0:19:13.89,Default,,0,0,0,,و لكن سوف أعطيك فرصةً واحدة لتعيش
Dialogue: 0,0:19:15.93,0:19:17.90,Default,,0,0,0,,كل ما عليك فعله هو هزيمتي
Dialogue: 0,0:19:20.78,0:19:22.81,Default,,0,0,0,,تماماً كما توقعت أين ستكون
Dialogue: 0,0:19:22.81,0:19:24.50,Default,,0,0,0,,إذاً انت هنا تشاهد التلفاز
Dialogue: 0,0:19:25.03,0:19:26.16,Default,,0,0,0,,حان وقت نومك الآن
Dialogue: 0,0:19:29.55,0:19:31.71,Default,,0,0,0,,هل سمعت ما أقول، كونان-كن؟
Dialogue: 0,0:19:31.71,0:19:32.54,Default,,0,0,0,,سأطفئه
Dialogue: 0,0:19:32.54,0:19:33.01,Default,,0,0,0,,!انتظري
Dialogue: 0,0:19:54.47,0:19:56.98,Default,,0,0,0,,!صحيح، هذا ما حصل إذاً
Dialogue: 0,0:19:57.31,0:19:58.14,Default,,0,0,0,,ما هو؟
Dialogue: 0,0:19:59.15,0:20:03.86,Default,,0,0,0,,الحقيقة هي أن القاتل الحقيقي كان يخدعنا طوال الوقت
Dialogue: 0,0:20:04.82,0:20:07.08,Default,,0,0,0,,يالها من خدعةٍ ماكرةٍ تماماً
Dialogue: 0,0:20:08.25,0:20:11.55,Default,,0,0,0,,و لكن ليس هناك دليلٌ في حوزتي لإثبات ذلك بعد
Dialogue: 0,0:20:26.78,0:20:28.96,Default,,0,0,0,,سيد موري، الهاتف يرن
Dialogue: 0,0:20:30.42,0:20:32.09,Default,,0,0,0,,..لقد غفوت قليلاً ياللهول
Dialogue: 0,0:20:32.96,0:20:34.13,Default,,0,0,0,,أعتذر عن هذا
Dialogue: 0,0:20:35.84,0:20:37.43,Default,,0,0,0,,نعم، المعذرة على جعلك تنتظر
Dialogue: 0,0:20:37.43,0:20:38.66,Default,,0,0,0,,معك موري
Dialogue: 0,0:20:38.66,0:20:40.15,Default,,0,0,0,,هذا سيء، موري-كن
Dialogue: 0,0:20:40.65,0:20:41.97,Default,,0,0,0,,!أيها المفتش
Dialogue: 0,0:20:41.97,0:20:42.65,Default,,0,0,0,,ماذا حصل؟
Dialogue: 0,0:20:43.40,0:20:45.86,Default,,0,0,0,,ذلك الرجل هيراوكا شيرو قد وُجد ميتاً
Dialogue: 0,0:20:46.36,0:20:47.74,Default,,0,0,0,,ماذا قلت!؟
Dialogue: 0,0:20:47.74,0:20:48.88,Default,,0,0,0,,و لكن أين!؟
Dialogue: 0,0:20:49.50,0:20:54.20,Default,,0,0,0,,لقد انزلق و سقط من على درج بيتٍ مهجور
Dialogue: 0,0:20:54.20,0:20:57.60,Default,,0,0,0,,ارتطم رأسه بالأرض، مما سبب له الوفاة فوراً
Dialogue: 0,0:20:58.10,0:21:00.03,Default,,0,0,0,,أكانت حادثة؟ أم أنها..؟
Dialogue: 0,0:21:00.03,0:21:01.59,Default,,0,0,0,,لا نعلم بعد
Dialogue: 0,0:21:01.59,0:21:04.18,Default,,0,0,0,,سنذهب إلى هناك الآن
Dialogue: 0,0:21:04.18,0:21:06.15,Default,,0,0,0,,إذا وجدت شيئاً ما سأعلمك بالأمر
Dialogue: 0,0:21:07.12,0:21:09.75,Default,,0,0,0,,تقوم الشرطة القضائية بالعمل في ذلك المكان حالياً
Dialogue: 0,0:21:23.02,0:21:23.85,Default,,0,0,0,,صباح الخير
Dialogue: 0,0:21:24.44,0:21:25.07,Default,,0,0,0,,حقاً!؟
Dialogue: 0,0:21:25.94,0:21:30.75,Default,,0,0,0,,إذاً، تعني أنك لن تعود للمنزل حتى تتأكد أن السيد إيشموتو سيكون بخيرٍ تماماً؟
Dialogue: 0,0:21:32.67,0:21:33.30,Default,,0,0,0,,فهمت
Dialogue: 0,0:21:37.18,0:21:38.77,Default,,0,0,0,,هل كان هذا عمي؟
Dialogue: 0,0:21:39.10,0:21:39.92,Default,,0,0,0,,نعم
Dialogue: 0,0:21:39.92,0:21:46.01,Default,,0,0,0,,انظر، الصورة التي التقطناها سويةً كان فيها رجلٌ يدعى هيراوكا\Nو هو مشتبهٌ به باستهداف السيد إيشموتو
Dialogue: 0,0:21:46.01,0:21:47.41,Default,,0,0,0,,و لكن تم العثور عليه ميتاً
Dialogue: 0,0:21:48.45,0:21:50.08,Default,,0,0,0,,إذاً هل كانت جريمة قتل!؟
Dialogue: 0,0:21:50.41,0:21:52.28,Default,,0,0,0,,أعتقد أنها كانت حادثة
Dialogue: 0,0:21:52.28,0:21:53.79,Default,,0,0,0,,لأنه سقط من على الدرج
Dialogue: 0,0:21:54.42,0:21:57.04,Default,,0,0,0,,قالوا أنه كان مختبئاً في بناءٍ ما ثم فقد توازنه
Dialogue: 0,0:21:57.04,0:21:58.84,Default,,0,0,0,,و تعرض لضررٍ جسيمٍ برأسه
Dialogue: 0,0:21:59.64,0:22:01.35,Default,,0,0,0,,كلا، لم تكن حادثة
Dialogue: 0,0:22:02.48,0:22:06.11,Default,,0,0,0,,!إذا صحّ استنتاجي، ستكون هذه جريمة قتل
Dialogue: 0,0:22:07.20,0:22:10.62,Default,,0,0,0,,القاتل الحقيقي قام بقتل هيراوكا لأنو اكتشف السر
Dialogue: 0,0:22:12.24,0:22:15.70,Default,,0,0,0,,هذه القضية.. سلسلة أحداثٍ بدأت منذ حصول السيد إيشموتو على تهديد القتل ذاك
Dialogue: 0,0:22:16.58,0:22:18.83,Default,,0,0,0,,..قد تبدو أن حلها بسيطٌ في البداية و لكن
Dialogue: 0,0:22:18.83,0:22:21.30,Default,,0,0,0,,في الواقع، الحقيقة الصادمة لم يتم كشفها بعد
Dialogue: 0,0:22:22.97,0:22:24.43,Default,,0,0,0,,سأكتشفها بالتأكيد
Dialogue: 0,0:22:25.43,0:22:27.44,Default,,0,0,0,,من بين كومة الأحداث المتشابكة بشكل معقد
Dialogue: 0,0:22:28.28,0:22:29.57,Default,,0,0,0,,!سأقوم بإيجاد الأحداث الحقيقية
Dialogue: 0,0:24:00.38,0:24:24.18,Default,,0,0,0,,{\pos(170,136)\fnTahoma}الحلقة القادمة
Dialogue: 0,0:24:07.56,0:24:12.71,Default,,0,0,0,,في الحقيقة، السيدة يوكيكو لديها عشيقٌ اسمه شيباتا كينيتشي
Dialogue: 0,0:24:13.07,0:24:14.29,Default,,0,0,0,,كما توقعت
Dialogue: 0,0:24:14.67,0:24:17.83,Default,,0,0,0,,جيد جداً، سأكشف كل شيءٍ لكم
Dialogue: 0,0:24:18.25,0:24:20.50,Default,,0,0,0,,!القاتل، هو أنت
Dialogue: 0,0:24:26.67,0:24:29.89,Default,,0,0,0,,{\pos(410,146)}جريمة قتل القنّاص الغامض\N(الجزء الثاني)
Dialogue: 0,0:24:31.18,0:24:33.52,Default,,0,0,0,,تلميح كونان القادم
Dialogue: 0,0:24:33.88,0:24:35.39,Default,,0,0,0,,جهاز التحكم
Dialogue: 0,0:24:35.39,0:24:36.69,Default,,0,0,0,,{\an8}الحلقة القادمة ستكون الجزء الثاني
Dialogue: 0,0:24:36.69,0:24:38.24,Default,,0,0,0,,{\an8}ما هو عنوان شارة البداية الجديدة؟
Dialogue: 0,0:24:38.24,0:24:38.66,Default,,0,0,0,,{\an8}\N..تر
Dialogue: 0,0:24:39.27,0:24:41.27,Default,,0,0,0,,{\an8}\N..عضضت لساني

