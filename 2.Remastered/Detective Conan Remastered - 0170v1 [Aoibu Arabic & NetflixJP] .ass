Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs40\pos(200,200)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS \NX : @Theconansign
Dialogue: 0,0:00:02.24,0:00:03.84,Default,,0,0,0,,كما يتدفق الماء بلا شكل
Dialogue: 0,0:00:03.84,0:00:05.54,Default,,0,0,0,,.وتهب الرياح بلا هيئة
Dialogue: 0,0:00:05.54,0:00:07.64,Default,,0,0,0,,!لا توجد جريمة تستطيع إيقافك عن استنتاج الحقيقة
Dialogue: 0,0:00:07.64,0:00:09.54,Default,,0,0,0,,.حلقة اليوم في مستشفىى، كوغورو يتلقى صدمة كبيرة
Dialogue: 0,0:00:09.54,0:00:11.24,Default,,0,0,0,,.وران تتصرف بغرابة أيضاً
Dialogue: 0,0:00:11.24,0:00:12.84,Default,,0,0,0,,،يسعى وراء الحقيقة دائما
Dialogue: 0,0:00:12.84,0:00:15.04,Default,,0,0,0,,.بجسد طفل وعقل بالغ
Dialogue: 0,0:00:15.04,0:00:17.54,Default,,0,0,0,,!اسمه هو المحقق كونان
Dialogue: 0,0:00:17.73,0:00:22.99,DCOpening,,0,0,0,,نحن مختلفان تمامًا
Dialogue: 0,0:00:25.24,0:00:31.83,DCOpening,,0,0,0,,نحب أشياءً مختلفة، ونعبر عن مشاعرنا بطرق مختلفة
Dialogue: 0,0:00:32.58,0:00:38.75,DCOpening,,0,0,0,,الآن، ونحن نرتب ذكريات وقتنا معًا الباهتة
Dialogue: 0,0:00:39.67,0:00:46.26,DCOpening,,0,0,0,,نحن نبحث بلا هدى عن شخصٍ ما عن مستقبل
Dialogue: 0,0:00:46.26,0:00:49.81,DCOpening,,0,0,0,,كن أقوى مما كنت تظن أنك قادر عليه
Dialogue: 0,0:00:49.81,0:00:53.56,DCOpening,,0,0,0,,ابحث عن الشخص المميز لك
Dialogue: 0,0:00:53.56,0:00:57.61,DCOpening,,0,0,0,,رغم أن بعض الأيام قد لا تسير على ما يرام
Dialogue: 0,0:00:57.61,0:01:00.69,DCOpening,,0,0,0,,قلبٌ صادقٌ لعينيك الغامضتين
Dialogue: 0,0:01:00.69,0:01:08.45,DCOpening,,0,0,0,,لا تترك ذراعي أبدًا، كي لا أفقدك مجددًا
Dialogue: 0,0:01:08.45,0:01:11.08,DCOpening,,0,0,0,,حتى عندما نجرح بعضنا
Dialogue: 0,0:01:15.33,0:01:22.59,DCOpening,,0,0,0,,في كل مرة ضللت فيها الطريق، أبحث ببساطة عن إجابات
Dialogue: 0,0:01:22.59,0:01:29.18,DCOpening,,0,0,0,,كنت تتحرك قدمًا بالفعل
Dialogue: 0,0:01:29.72,0:01:33.43,DCOpening,,0,0,0,,تمسك بي
Dialogue: 0,0:01:33.43,0:01:40.69,DCOpening,,0,0,0,,فهذه هي حياتي السرية
Dialogue: 0,0:01:56.84,0:01:59.64,Default,,0,0,0,,.نعم، سأكون غائبًا لفترة أطول قليلًا
Dialogue: 0,0:01:59.64,0:02:02.14,Default,,0,0,0,,تبا، ماذا تفعل بالضبط؟
Dialogue: 0,0:02:02.14,0:02:04.24,Default,,0,0,0,,.كل زملائك في الصف قلقون عليك أيضاً
Dialogue: 0,0:02:04.24,0:02:06.04,Default,,0,0,0,,.ليس لدي خيار
Dialogue: 0,0:02:06.04,0:02:09.54,Default,,0,0,0,,"أنا أتعامل مع قضية خطيرة وصعبة"، هذا ما تقوله دائما ؟
Dialogue: 0,0:02:09.54,0:02:12.44,Default,,0,0,0,,.نعم -\N.أنا آسفة، شينيتشي -
Dialogue: 0,0:02:12.44,0:02:15.44,Default,,0,0,0,,.لدي شيء لأفعله ويجب أن أذهب
Dialogue: 0,0:02:15.44,0:02:18.84,Default,,0,0,0,,.إلى اللقاء إذن، واعتن بنفسك لأن الجو بارد
Dialogue: 0,0:02:23.94,0:02:25.54,Default,,0,0,0,,...هناك شيء
Dialogue: 0,0:02:25.54,0:02:28.34,Default,,0,0,0,,.شيء غريب حول ران مؤخراً
Dialogue: 0,0:02:28.34,0:02:31.74,Default,,0,0,0,,.يبدو أنها تتجاهلني عندما أتصل بها
Dialogue: 0,0:02:31.74,0:02:35.04,Default,,0,0,0,,.ولم تعد تبكي وتقول "شينتشي! شينتشي!" كما اعتادت
Dialogue: 0,0:02:36.14,0:02:39.34,Default,,0,0,0,,...و، الشيء الأكثر غرابة
Dialogue: 0,0:02:39.34,0:02:40.54,Default,,0,0,0,,.كونان
Dialogue: 0,0:02:40.54,0:02:42.44,Default,,0,0,0,,.سأخرج لبعض الوقت
Dialogue: 0,0:02:42.44,0:02:44.84,Default,,0,0,0,,،تركت عشاءك على الطاولة
Dialogue: 0,0:02:44.84,0:02:47.04,Default,,0,0,0,,فقم بتسخينه في المايكروويف قبل أن تأكله، حسناً؟
Dialogue: 0,0:02:47.04,0:02:49.24,Default,,0,0,0,,.حسناً
Dialogue: 0,0:02:50.44,0:02:54.44,Default,,0,0,0,,.إنها تخرج في المساء تقريباً كل يوم مؤخراً
Dialogue: 0,0:02:54.44,0:02:57.34,Default,,0,0,0,,.على الرغم من أن ران تقول إنها ذاهبة لدروس الكاراتيه
Dialogue: 0,0:02:57.34,0:03:01.84,Default,,0,0,0,,.شيء يقلقني في الطريقة التي تبدو بها سعيدة جداً
Dialogue: 0,0:03:03.04,0:03:09.04,Default,,0,0,0,,"النقطة العمياء في الظلام - الجزء الأول"
Dialogue: 0,0:03:10.04,0:03:11.84,Default,,0,0,0,,...في أحد الأيام
Dialogue: 0,0:03:11.84,0:03:13.34,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:03:13.34,0:03:15.44,Default,,0,0,0,,كنت ذاهباً إلى المستشفى؟
Dialogue: 0,0:03:15.44,0:03:19.64,Default,,0,0,0,,.نعم. أنا ذاهب الآن للحصول على نتائج الفحص
Dialogue: 0,0:03:19.64,0:03:21.74,Default,,0,0,0,,هل هناك خطب ما بك؟
Dialogue: 0,0:03:21.74,0:03:24.84,Default,,0,0,0,,.أشعر بقليل من التعب مؤخراً
Dialogue: 0,0:03:24.84,0:03:27.24,Default,,0,0,0,,.على الأرجح أنك تشرب أكثر من اللازم
Dialogue: 0,0:03:27.24,0:03:28.54,Default,,0,0,0,,.صحيح، صحيح
Dialogue: 0,0:03:28.54,0:03:30.34,Default,,0,0,0,,لا أرى لماذا يجب أن تصطحبنا معك
Dialogue: 0,0:03:30.34,0:03:31.54,Default,,0,0,0,,.بعد أن عدنا من المدرسة للتو
Dialogue: 0,0:03:31.54,0:03:33.74,Default,,0,0,0,,...ربما لا شيء
Dialogue: 0,0:03:33.74,0:03:37.04,Default,,0,0,0,,الطبيب أخبرني أن أحضر عائلتي معي
Dialogue: 0,0:03:37.04,0:03:40.44,Default,,0,0,0,,.عندما أذهب إلى المستشفى
Dialogue: 0,0:03:40.44,0:03:43.14,Default,,0,0,0,,...مهلاً، لا تخبرني أنك
Dialogue: 0,0:03:44.44,0:03:46.34,Default,,0,0,0,,.السيد موري كوغورو
Dialogue: 0,0:03:46.94,0:03:48.34,Default,,0,0,0,,.السيد موري
Dialogue: 0,0:03:50.34,0:03:52.44,Default,,0,0,0,,.ستة أشهر أخرى
Dialogue: 0,0:03:53.74,0:03:56.04,Default,,0,0,0,,أعلم تماماً ما تشعر به لكن، لسوء الحظ
Dialogue: 0,0:03:56.04,0:03:58.44,Default,,0,0,0,,...في الأشهر الستة القادمة يجب
Dialogue: 0,0:03:58.44,0:04:01.04,Default,,0,0,0,,مهلاً، أنت! كم أنت قاسٍ؟
Dialogue: 0,0:04:01.04,0:04:03.44,Default,,0,0,0,,!تخبرني فجأة أن أمامي ستة أشهر فقط لأعيشها
Dialogue: 0,0:04:03.44,0:04:05.94,Default,,0,0,0,,إذا كان مرضاً بهذه الخطورة، أليس من الأدب
Dialogue: 0,0:04:05.94,0:04:09.04,Default,,0,0,0,,أن تبلغني بذلك تدريجياً كطبيب؟
Dialogue: 0,0:04:10.14,0:04:11.84,Default,,0,0,0,,مرض خطير؟
Dialogue: 0,0:04:11.84,0:04:13.54,Default,,0,0,0,,أردت فقط أن أخبرك أن تبتعد عن المشروبات الكحولية
Dialogue: 0,0:04:13.54,0:04:15.74,Default,,0,0,0,,.للأشهر الستة القادمة
Dialogue: 0,0:04:16.64,0:04:17.74,Default,,0,0,0,,كحول؟
Dialogue: 0,0:04:17.74,0:04:20.04,Default,,0,0,0,,نعم. نتائج الفحوصات تظهر أن
Dialogue: 0,0:04:20.04,0:04:23.44,Default,,0,0,0,,.لديك مشكلة في الكلى بسبب الإفراط في الشرب
Dialogue: 0,0:04:23.44,0:04:26.34,Default,,0,0,0,,.على الرغم من أن الأعراض لا تزال خفيفة جداً
Dialogue: 0,0:04:29.04,0:04:30.54,Default,,0,0,0,,.كما توقعت
Dialogue: 0,0:04:31.24,0:04:33.94,Default,,0,0,0,,.يا سيد أرايدي، لقد أخفتني حقاً
Dialogue: 0,0:04:33.94,0:04:36.34,Default,,0,0,0,,.عندما طلبت مني إحضار عائلتي معي
Dialogue: 0,0:04:36.38,0:04:41.80,Default,,0,0,0,,{\fs90\pos(960,800)} (51) يوشيتيرو أرايدي \Nطيب 
Dialogue: 0,0:04:36.34,0:04:39.44,Default,,0,0,0,,،لشخص مثلك يحب المشروبات الكحولية
Dialogue: 0,0:04:39.44,0:04:42.74,Default,,0,0,0,,.تعاون عائلتك ضروري حتماً
Dialogue: 0,0:04:42.74,0:04:45.14,Default,,0,0,0,,.يرجى تقليل تناولك اليومي للمشروبات الكحولية
Dialogue: 0,0:04:45.14,0:04:48.14,Default,,0,0,0,,.لا، سأجعله يتوقف عن الشرب نهائياً
Dialogue: 0,0:04:49.74,0:04:52.34,Default,,0,0,0,,.عزيزي، هناك مكالمة لك من الآنسة سوغيتا
Dialogue: 0,0:04:52.34,0:04:53.94,Default,,0,0,0,,.إنها تطلب منك زيارتها في المنزل
Dialogue: 0,0:04:53.94,0:04:56.94,Default,,0,0,0,,.ليس مجدداً
Dialogue: 0,0:04:56.94,0:04:58.64,Default,,0,0,0,,.يا لها من مريضة متعبة
Dialogue: 0,0:04:58.64,0:05:02.14,Default,,0,0,0,,.كل ما لديها هو قرحة بسيطة، لكنها شديدة القلق
Dialogue: 0,0:05:04.10,0:05:08.38,Default,,0,0,0,,{\fs90\pos(960,800)} (46)يوكو أرايدي \N زوجة يوشيتيرو 
Dialogue: 0,0:05:04.34,0:05:05.64,Default,,0,0,0,,مريضة؟
Dialogue: 0,0:05:05.64,0:05:08.34,Default,,0,0,0,,.حقا؟، إنها صديقتك
Dialogue: 0,0:05:10.24,0:05:11.44,Default,,0,0,0,,.لا شيء
Dialogue: 0,0:05:11.44,0:05:14.84,Default,,0,0,0,,.سيعود بعد قليل، لذا ارجو أن انتظروا هنا
Dialogue: 0,0:05:15.74,0:05:18.14,Default,,0,0,0,,.المعذرة
Dialogue: 0,0:05:18.14,0:05:20.34,Default,,0,0,0,,هل يمكنني استخدام المرحاض؟
Dialogue: 0,0:05:20.34,0:05:22.74,Default,,0,0,0,,.مرحاض العيادة معطل
Dialogue: 0,0:05:24.94,0:05:29.74,Default,,0,0,0,,...لنرى، انعطفت يميناً عند الممر لذا
Dialogue: 0,0:05:29.74,0:05:31.64,Default,,0,0,0,,.من هذا الطريق
Dialogue: 0,0:05:31.64,0:05:35.04,Default,,0,0,0,,.هذا يعني غرفة الفحص مباشرة أمامي
Dialogue: 0,0:05:36.04,0:05:38.64,Default,,0,0,0,,.يا له من منزل كبير هذا
Dialogue: 0,0:05:41.54,0:05:43.54,Default,,0,0,0,,.أنا آسفة، لم أكن أنتبه إلى طريقي
Dialogue: 0,0:05:43.54,0:05:46.44,Default,,0,0,0,,.لا، الخطأ خطأي
Dialogue: 0,0:05:52.44,0:05:54.44,Default,,0,0,0,,.حسناً، هذا كل شيء
Dialogue: 0,0:05:54.44,0:05:56.14,Default,,0,0,0,,.شكراً لكِ
Dialogue: 0,0:05:56.14,0:05:58.14,Default,,0,0,0,,من أنتِ؟
Dialogue: 0,0:05:58.14,0:06:01.64,Default,,0,0,0,,.أنا ابنة موري، إحدى مرضى الطبيب
Dialogue: 0,0:06:01.64,0:06:04.14,Default,,0,0,0,,.انتِ ابنة السيد موري
Dialogue: 0,0:06:04.10,0:06:10.28,Default,,0,0,0,,{\fs90\pos(960,800)} (25) تومواكي أرايدي \N ابن يوشيتيرو - طيب 
Dialogue: 0,0:06:04.14,0:06:06.44,Default,,0,0,0,,.و، أنا ابن الطبيب
Dialogue: 0,0:06:06.44,0:06:09.04,Default,,0,0,0,,أنا تومواكي وأشارك في فحص المرضى هنا
Dialogue: 0,0:06:09.04,0:06:10.34,Default,,0,0,0,,.مع والدي
Dialogue: 0,0:06:10.34,0:06:13.14,Default,,0,0,0,,لكن، سأعمل في مستشفى في آوموري
Dialogue: 0,0:06:13.14,0:06:15.14,Default,,0,0,0,,.بدءاً من الشهر القادم
Dialogue: 0,0:06:17.24,0:06:18.94,Default,,0,0,0,,!مهلاً! لا تخبريني أنكِ مجدداً
Dialogue: 0,0:06:18.94,0:06:22.44,Default,,0,0,0,,كم سيستغرق منكِ الوقت حتى تعتادي على هذا المنزل؟
Dialogue: 0,0:06:22.44,0:06:25.44,Default,,0,0,0,,أنتِ من أرادتِ أن تكوني خادمة هنا، أليس كذلك؟
Dialogue: 0,0:06:25.44,0:06:28.04,Default,,0,0,0,,.أنا آسفة
Dialogue: 0,0:06:28.04,0:06:29.84,Default,,0,0,0,,،أهدا يا أبي
Dialogue: 0,0:06:29.84,0:06:32.94,Default,,0,0,0,,.الانفعال الزائد مضر لقلبك
Dialogue: 0,0:06:32.94,0:06:34.94,Default,,0,0,0,,،اسمعي. إذا فعلتِ شيئاً كهذا مرة أخرى
Dialogue: 0,0:06:34.94,0:06:37.14,Default,,0,0,0,,ستُطردين، فهمتِ؟
Dialogue: 0,0:06:37.14,0:06:39.84,Default,,0,0,0,,.عديمة الفائدة
Dialogue: 0,0:06:39.58,0:06:42.45,Default,,0,0,0,,{\fs90\pos(960,800)} (22) هيكارو ياسوموتو \Nخادمة المنزل
Dialogue: 0,0:06:43.64,0:06:45.84,Default,,0,0,0,,.شكراً جزيلاً لك
Dialogue: 0,0:06:45.84,0:06:49.24,Default,,0,0,0,,.ابتعد عن الشرب إذا أردت حياة طويلة وسعيدة
Dialogue: 0,0:06:49.24,0:06:53.24,Default,,0,0,0,,.بعد كل شيء، لديك نفس اسم موري كوغورو الشهير
Dialogue: 0,0:06:54.04,0:06:57.24,Default,,0,0,0,,لم تسمع بالمحقق الشهير؟
Dialogue: 0,0:06:57.24,0:07:00.64,Default,,0,0,0,,...حسناً، في الحقيقة
Dialogue: 0,0:07:01.54,0:07:04.44,Default,,0,0,0,,!ماذا؟ أنت المحقق الشهير
Dialogue: 0,0:07:04.44,0:07:05.74,Default,,0,0,0,,.نعم
Dialogue: 0,0:07:05.74,0:07:09.74,Default,,0,0,0,,،حسناً، كنت أتساءل منذ أن رأيت اسمك
Dialogue: 0,0:07:09.74,0:07:11.54,Default,,0,0,0,,لكنك هو شخصياً، أهكذا؟
Dialogue: 0,0:07:11.54,0:07:14.14,Default,,0,0,0,,،لقد خُدعت تماماً
Dialogue: 0,0:07:14.14,0:07:18.84,Default,,0,0,0,,.لأنك تصرفت وكأنك لا تعرف شيئاً عن الطب
Dialogue: 0,0:07:18.84,0:07:21.24,Default,,0,0,0,,ما رأيك في تناول العشاء في منزلنا الليلة؟
Dialogue: 0,0:07:21.24,0:07:24.04,Default,,0,0,0,,.لنتحدث عن الطب، نحن الاثنان
Dialogue: 0,0:07:24.04,0:07:25.14,Default,,0,0,0,,!مصبية
Dialogue: 0,0:07:25.14,0:07:28.04,Default,,0,0,0,,،لا نستطيع، فأنا لدي واجبات منزلية لأنجزها
Dialogue: 0,0:07:28.04,0:07:30.44,Default,,0,0,0,,.و أختي ران لديها تدريب كاراتيه أيضاً
Dialogue: 0,0:07:30.44,0:07:31.64,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:07:31.64,0:07:35.14,Default,,0,0,0,,.لمَ لا؟ لنتناول العشاء هنا
Dialogue: 0,0:07:35.14,0:07:39.24,Default,,0,0,0,,.أغيب عن درس واحد لن يضر على الأرجح
Dialogue: 0,0:07:39.24,0:07:40.74,Default,,0,0,0,,...كما توقعت
Dialogue: 0,0:07:40.74,0:07:42.84,Default,,0,0,0,,.هناك خطب ما
Dialogue: 0,0:07:45.24,0:07:48.84,Default,,0,0,0,,تخرجت بامتياز من جامعة توهتو، سيد تومواكي؟
Dialogue: 0,0:07:48.84,0:07:50.04,Default,,0,0,0,,.رائع
Dialogue: 0,0:07:50.04,0:07:51.94,Default,,0,0,0,,صحيح، أليس كذلك، سيد تومواكي؟
Dialogue: 0,0:07:51.94,0:07:53.54,Default,,0,0,0,,.كنت محظوظاً فقط
Dialogue: 0,0:07:53.54,0:07:57.24,Default,,0,0,0,,إذن، ما رأيك في الزواج من ابنتي؟
Dialogue: 0,0:07:57.24,0:07:59.24,Default,,0,0,0,,!مهلا يا أبي
Dialogue: 0,0:07:59.24,0:08:01.94,Default,,0,0,0,,.صحيح، أعتقد أنكما تشكلان ثنائياً لطيفاً
Dialogue: 0,0:08:01.94,0:08:04.14,Default,,0,0,0,,.توقفي رجاءً يا أمي
Dialogue: 0,0:08:04.14,0:08:05.34,Default,,0,0,0,,!ساخن
Dialogue: 0,0:08:06.24,0:08:10.24,Default,,0,0,0,,.هل أنتِ بخير؟ كوني حذرة لأن طبق البيض ساخن
Dialogue: 0,0:08:10.24,0:08:11.64,Default,,0,0,0,,.أنا آسفة
Dialogue: 0,0:08:11.64,0:08:13.74,Default,,0,0,0,,هل كل شيء على ما يرام؟
Dialogue: 0,0:08:13.99,0:08:16.59,Default,,0,0,0,,ألم يكن من المفترض أن يكون لديك اجتماع الليلة حول لقاء صفك؟
Dialogue: 0,0:08:16.59,0:08:19.69,Default,,0,0,0,,.هذا صحيح. يجب أن أتصل بماساي
Dialogue: 0,0:08:23.19,0:08:26.39,Default,,0,0,0,,.حسناً، إذا أردت الزواج منها، أخبرني في أي وقت
Dialogue: 0,0:08:26.39,0:08:30.19,Default,,0,0,0,,.إذا اتحدنا، سنكون بالفعل مثل هولمز وواطسون
Dialogue: 0,0:08:30.19,0:08:32.59,Default,,0,0,0,,.كل قضية سيتم حلها في لمح البصر
Dialogue: 0,0:08:32.59,0:08:34.09,Default,,0,0,0,,.سأعتذر عن ذلك
Dialogue: 0,0:08:34.09,0:08:38.39,Default,,0,0,0,,.بالإضافة إلى ذلك، لا أعتقد أن ثنائي المحقق والطبيب جيدان معاً
Dialogue: 0,0:08:38.39,0:08:40.79,Default,,0,0,0,,مهمتنا كأطباء ليست إجراء تشريح للجثة
Dialogue: 0,0:08:40.79,0:08:43.69,Default,,0,0,0,,،حتى يتم القبض على القاتل
Dialogue: 0,0:08:43.69,0:08:46.69,Default,,0,0,0,,.بل بالأحرى، إنقاذ حياة الضحية
Dialogue: 0,0:08:47.89,0:08:50.19,Default,,0,0,0,,.لقد أحرجتني
Dialogue: 0,0:08:50.19,0:08:51.39,Default,,0,0,0,,.لا
Dialogue: 0,0:08:51.39,0:08:56.09,Default,,0,0,0,,...لا أعرف أيهما سيكون هولمز، أليس كذلك يا أختي ران
Dialogue: 0,0:09:00.69,0:09:01.79,Default,,0,0,0,,.ران
Dialogue: 0,0:09:02.49,0:09:04.79,Default,,0,0,0,,.لكن الطيب تأخر حقاً
Dialogue: 0,0:09:04.79,0:09:07.59,Default,,0,0,0,,.كان يجب أن يكون قد انتهى من العمل بالفعل
Dialogue: 0,0:09:07.59,0:09:09.39,Default,,0,0,0,,.إنه يستحم
Dialogue: 0,0:09:10.09,0:09:14.29,Default,,0,0,0,,.لديه عادة الاستحمام قبل العشاء
Dialogue: 0,0:09:12.10,0:09:17.65,Default,,0,0,0,,{\fs90\pos(960,800)} (74) ميتسو أرايدي\Nجدة تومواكي
Dialogue: 0,0:09:14.29,0:09:17.89,Default,,0,0,0,,.يدخل قبل الجميع ويلوث الماء
Dialogue: 0,0:09:17.89,0:09:20.69,Default,,0,0,0,,.يا جدتي، لا تتحدثي هكذا
Dialogue: 0,0:09:20.69,0:09:23.19,Default,,0,0,0,,إنه بالتأكيد رب الأسرة بهذا المنزل لهذا
Dialogue: 0,0:09:23.19,0:09:25.79,Default,,0,0,0,,.يكون أول من يستحم
Dialogue: 0,0:09:25.79,0:09:27.99,Default,,0,0,0,,!تقول رب الأسرة
Dialogue: 0,0:09:27.99,0:09:31.59,Default,,0,0,0,,.هو الذي تزوج من عائلتي، ومع ذلك يتصرف بتكبر
Dialogue: 0,0:09:31.59,0:09:32.89,Default,,0,0,0,,!يا جدتي
Dialogue: 0,0:09:32.89,0:09:36.19,Default,,0,0,0,,الشخص الوحيد المرتبط بنا برباط الدم في هذا المنزل
Dialogue: 0,0:09:36.19,0:09:38.19,Default,,0,0,0,,.هو أنت، يا حفيدي
Dialogue: 0,0:09:38.19,0:09:40.19,Default,,0,0,0,,وتفكر في مغادرة هذا المنزل
Dialogue: 0,0:09:40.19,0:09:42.39,Default,,0,0,0,,...بنهاية هذا الشهر
Dialogue: 0,0:09:42.39,0:09:44.59,Default,,0,0,0,,هل تقول لي إنه يجب أن أموت؟
Dialogue: 0,0:09:44.59,0:09:46.39,Default,,0,0,0,,.يا جدتي
Dialogue: 0,0:09:46.39,0:09:48.49,Default,,0,0,0,,أمي، ماذا عن العشاء؟
Dialogue: 0,0:09:48.49,0:09:49.49,Default,,0,0,0,,،لا أريد
Dialogue: 0,0:09:49.49,0:09:52.79,Default,,0,0,0,,لمَ لا تستمتعون جميعاً أنتم الغرباء بالعشاء معاً؟
Dialogue: 0,0:09:55.69,0:09:57.79,Default,,0,0,0,,.لا تفكرو في گلامها
Dialogue: 0,0:09:57.79,0:10:00.59,Default,,0,0,0,,جدتي منزعجة لأن أبي غير المرحاض وحوض الاستحمام
Dialogue: 0,0:10:00.59,0:10:02.69,Default,,0,0,0,,.من الطراز الياباني إلى الغربي
Dialogue: 0,0:10:02.69,0:10:04.29,Default,,0,0,0,,الطراز الغربي؟
Dialogue: 0,0:10:04.29,0:10:05.49,Default,,0,0,0,,.نعم
Dialogue: 0,0:10:05.49,0:10:10.89,Default,,0,0,0,,!كانت غاضبة خاصة عندما غير حوض الإستحمام إلى السيراميك الغربي مع ستائره
Dialogue: 0,0:10:10.89,0:10:12.19,Default,,0,0,0,,: وكانت تقول 
Dialogue: 0,0:10:12.19,0:10:14.09,Default,,0,0,0,,"هل تحاول إهانة تقاليد هذا المنزل؟"
Dialogue: 0,0:10:14.09,0:10:17.39,Default,,0,0,0,,.حسناً، إنها بالتأكيد امرأة مسنة نشيطة
Dialogue: 0,0:10:17.39,0:10:19.39,Default,,0,0,0,,انقطاع الكهرباء؟
Dialogue: 0,0:10:20.69,0:10:23.09,Default,,0,0,0,,.يبدو أن الانقطاع الكهربائي في هذا المنزل فقط
Dialogue: 0,0:10:23.09,0:10:25.39,Default,,0,0,0,,.أضواء المنزل المجاور مضاءة
Dialogue: 0,0:10:27.59,0:10:29.79,Default,,0,0,0,,مهلا، هل أنتِ بخير؟
Dialogue: 0,0:10:29.79,0:10:33.29,Default,,0,0,0,,.أنا متأكد أن هناك مصباحاً يدوياً في ذلك الدرج هناك
Dialogue: 0,0:10:35.89,0:10:36.89,Default,,0,0,0,,.هذا هو
Dialogue: 0,0:10:37.59,0:10:40.19,Default,,0,0,0,,.سأذهب للتحقق من قاطع التيار
Dialogue: 0,0:10:40.19,0:10:41.29,Default,,0,0,0,,هل ستكونين بخير؟
Dialogue: 0,0:10:41.29,0:10:42.49,Default,,0,0,0,,.نعم
Dialogue: 0,0:10:43.64,0:10:45.84,Default,,0,0,0,,.انتبهي لخطواتكِ،  أنسة هيكارو
Dialogue: 0,0:10:45.84,0:10:47.24,Default,,0,0,0,,.حسناً
Dialogue: 0,0:10:47.24,0:10:49.54,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:10:49.54,0:10:51.14,Default,,0,0,0,,.لدينا انقطاع للكهرباء
Dialogue: 0,0:10:54.74,0:10:57.84,Default,,0,0,0,,أليس هذا صوت المطر؟
Dialogue: 0,0:10:57.84,0:10:58.84,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:10:58.84,0:11:00.84,Default,,0,0,0,,.ياللإحباط
Dialogue: 0,0:11:04.74,0:11:06.24,Default,,0,0,0,,.الكهرباء عادت
Dialogue: 0,0:11:13.84,0:11:16.94,Default,,0,0,0,,.أنا آسفة. ظننت أنك أبي
Dialogue: 0,0:11:18.64,0:11:21.14,Default,,0,0,0,,ما الذي يحدث هنا؟
Dialogue: 0,0:11:21.14,0:11:22.44,Default,,0,0,0,,.أمي
Dialogue: 0,0:11:22.44,0:11:25.54,Default,,0,0,0,,...وبخصوص التكاليف
Dialogue: 0,0:11:25.79,0:11:28.29,Default,,0,0,0,,.حسناً، أعتقد أن 30,000 ين مكلفة قليلاً
Dialogue: 0,0:11:28.29,0:11:29.69,Default,,0,0,0,,هل عادت الكهرباء؟
Dialogue: 0,0:11:29.69,0:11:32.29,Default,,0,0,0,,أيتها الحمقاء، ألا ترين بنفسك؟
Dialogue: 0,0:11:32.29,0:11:35.59,Default,,0,0,0,,ربما يجب أن تتحققي من كيف حال أبي؟
Dialogue: 0,0:11:35.59,0:11:37.79,Default,,0,0,0,,ربما يكون غاضباً لأن الكهرباء انقطعت
Dialogue: 0,0:11:37.79,0:11:39.79,Default,,0,0,0,,.بالإضافة إلى ذلك، أنا قلق على قلبه أيضاً
Dialogue: 0,0:11:39.79,0:11:42.39,Default,,0,0,0,,.أعتقد كذلك -\N.سأذهب للتحقق إذن -
Dialogue: 0,0:11:42.39,0:11:44.29,Default,,0,0,0,,.سأذهب أيضاً
Dialogue: 0,0:11:44.29,0:11:46.49,Default,,0,0,0,,لماذا انقطعت الكهرباء؟
Dialogue: 0,0:11:46.49,0:11:47.99,Default,,0,0,0,,.أتساءل
Dialogue: 0,0:11:47.99,0:11:51.89,Default,,0,0,0,,.قد يكون السبب خللًا في الدائرة، أو استهلاكًا مفرطًا للكهرباء في وقت واحد
Dialogue: 0,0:11:54.49,0:11:55.49,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:11:55.49,0:11:57.19,Default,,0,0,0,,.إنه من حوض الاستحمام
Dialogue: 0,0:12:08.39,0:12:09.59,Default,,0,0,0,,!أبي
Dialogue: 0,0:12:18.18,0:12:19.08,Default,,0,0,0,,!أبي
Dialogue: 0,0:12:19.08,0:12:20.48,Default,,0,0,0,,!لا تلمسه
Dialogue: 0,0:12:24.08,0:12:26.58,Default,,0,0,0,,.إذا لمسته، ستُصعق أيضاً
Dialogue: 0,0:12:26.58,0:12:28.68,Default,,0,0,0,,صعق كهربائي؟
Dialogue: 0,0:12:31.28,0:12:33.58,Default,,0,0,0,,...مهلاً، أيعقل
Dialogue: 0,0:12:36.38,0:12:38.18,Default,,0,0,0,,لقد قُتل بسبب ماكينة الحلاقة هذه
Dialogue: 0,0:12:38.18,0:12:40.18,Default,,0,0,0,,.المتصلة بسلك التمديد
Dialogue: 0,0:12:40.58,0:12:43.18,Default,,0,0,0,,!سأحاول إنعاشه
Dialogue: 0,0:12:43.18,0:12:45.38,Default,,0,0,0,,!أمي، رجاءً جهزي المحول الوريدي بدواء مقوي للقلب
Dialogue: 0,0:12:45.38,0:12:47.58,Default,,0,0,0,,!أنسة هيكارو، اتصلي بالإسعاف
Dialogue: 0,0:12:47.58,0:12:49.08,Default,,0,0,0,,!أسرعوا
Dialogue: 0,0:12:49.08,0:12:52.18,Default,,0,0,0,,!- نعم\N!- واتصلي بالشرطة أيضاً
Dialogue: 0,0:12:52.18,0:12:53.98,Default,,0,0,0,,!حسناً
Dialogue: 0,0:12:57.98,0:13:00.08,Default,,0,0,0,,يبدو أنه لا شك في أن
Dialogue: 0,0:13:00.08,0:13:01.58,Default,,0,0,0,,سلك التمديد هذا غُمر في الماء
Dialogue: 0,0:13:01.58,0:13:03.48,Default,,0,0,0,,.وتم صعقه
Dialogue: 0,0:13:04.08,0:13:05.78,Default,,0,0,0,,كان يستخدم المرآة فوق حوض الاستحمام
Dialogue: 0,0:13:05.78,0:13:08.38,Default,,0,0,0,,.عندما حلق باستخدام ماكينة الحلاقة
Dialogue: 0,0:13:08.38,0:13:10.88,Default,,0,0,0,,لكن، لماذا كان يحلق أثناء الاستحمام؟
Dialogue: 0,0:13:12.18,0:13:15.28,Default,,0,0,0,,...لحظة، ايعقل
Dialogue: 0,0:13:16.28,0:13:17.88,Default,,0,0,0,,.للأسف
Dialogue: 0,0:13:17.88,0:13:21.98,Default,,0,0,0,,.السيد أرايدي يوشيتيرو قد توفي
Dialogue: 0,0:13:21.98,0:13:24.78,Default,,0,0,0,,.كان لديه قلب ضعيف من الأساس
Dialogue: 0,0:13:24.78,0:13:28.68,Default,,0,0,0,,...مستحيل
Dialogue: 0,0:13:28.68,0:13:29.78,Default,,0,0,0,,إذن؟
Dialogue: 0,0:13:29.78,0:13:32.28,Default,,0,0,0,,في  أي حالة وجدتم السيد يوشيتيرو؟
Dialogue: 0,0:13:32.28,0:13:34.38,Default,,0,0,0,,...حسناً
Dialogue: 0,0:13:34.38,0:13:37.18,Default,,0,0,0,,.كان رأسه متجهاً بهذا الاتجاه، وكان مرتخياً
Dialogue: 0,0:13:37.18,0:13:39.88,Default,,0,0,0,,أتساءل لماذا استخدم ماكينة الحلاقة الكهربائية
Dialogue: 0,0:13:39.88,0:13:41.68,Default,,0,0,0,,.وهو منغمس في الحوض
Dialogue: 0,0:13:41.68,0:13:43.68,Default,,0,0,0,,.كانت لديه عادة فعل ذلك
Dialogue: 0,0:13:43.68,0:13:46.88,Default,,0,0,0,,...كان دائمًا يفعل ذلك بينما ينتظر الضيوف
Dialogue: 0,0:13:46.88,0:13:50.78,Default,,0,0,0,,.المرآة عليها طلاء خاص تمنع تكوّن الضباب
Dialogue: 0,0:13:50.78,0:13:53.08,Default,,0,0,0,,،يا لها من عادة غريبة
Dialogue: 0,0:13:53.08,0:13:55.98,Default,,0,0,0,,.أن يستحم وهو يجعل ضيوفه ينتظرون
Dialogue: 0,0:13:55.98,0:13:57.58,Default,,0,0,0,,أبي كان يحب الاستحمام
Dialogue: 0,0:13:57.58,0:13:59.38,Default,,0,0,0,,،وكان يستحم مرتين يومياً
Dialogue: 0,0:13:59.38,0:14:01.08,Default,,0,0,0,,،في الصباح وقبل العشاء
Dialogue: 0,0:14:01.08,0:14:03.58,Default,,0,0,0,,.قائلاً أن النظافة ضرورية للأطباء
Dialogue: 0,0:14:03.58,0:14:06.08,Default,,0,0,0,,.إنه يستحق ذلك
Dialogue: 0,0:14:06.08,0:14:10.28,Default,,0,0,0,,.العقاب السماوي لأنه لم يستمع لتحذير تشياكي
Dialogue: 0,0:14:10.28,0:14:12.68,Default,,0,0,0,,هذا على الأرجح عقاب من تشياكي
Dialogue: 0,0:14:12.68,0:14:15.08,Default,,0,0,0,,.الموجودة في العالم الآخر
Dialogue: 0,0:14:15.08,0:14:16.68,Default,,0,0,0,,.يا جدتي
Dialogue: 0,0:14:16.68,0:14:18.88,Default,,0,0,0,,من تكون تشياكي؟
Dialogue: 0,0:14:18.88,0:14:23.88,Default,,0,0,0,,.إنها أمي التي توفيت في حادث مرور منذ 4 سنوات
Dialogue: 0,0:14:23.88,0:14:26.38,Default,,0,0,0,,تشياكي كانت دائماً تحذره من استخدام ماكينة الحلاقة الكهربائية
Dialogue: 0,0:14:26.38,0:14:28.48,Default,,0,0,0,,،أثناء الاستحمام قائلة
Dialogue: 0,0:14:28.48,0:14:31.88,Default,,0,0,0,,"لا تستخدمها والسلك متصل لأنها خطيرة."
Dialogue: 0,0:14:31.88,0:14:34.78,Default,,0,0,0,,وأنتِ، يا أنسة يوكو؟
Dialogue: 0,0:14:34.78,0:14:37.38,Default,,0,0,0,,.أنا زوجته الثانية وتزوجته منذ عامين
Dialogue: 0,0:14:37.38,0:14:39.68,Default,,0,0,0,,،كنت في نفس صف تشياكي في مدرسة التمريض
Dialogue: 0,0:14:39.68,0:14:42.28,Default,,0,0,0,,.وكانت تشكو لي كثيراً
Dialogue: 0,0:14:43.48,0:14:45.58,Default,,0,0,0,,.أيها المفتش، أنظر إلى هنا
Dialogue: 0,0:14:45.58,0:14:48.38,Default,,0,0,0,,،يستخدم الحلاقة باستخدام هذه المرآة
Dialogue: 0,0:14:48.38,0:14:51.08,Default,,0,0,0,,الجزء حيث تتصل ماكينة الحلاقة بسلك التمديد
Dialogue: 0,0:14:51.08,0:14:53.18,Default,,0,0,0,,.يتوقف على حافة الحوض
Dialogue: 0,0:14:53.18,0:14:55.68,Default,,0,0,0,,.هذا خطير حقاً
Dialogue: 0,0:14:55.68,0:14:58.28,Default,,0,0,0,,أين كنتم جميعاً أثناء انقطاع الكهرباء؟
Dialogue: 0,0:14:58.28,0:15:00.88,Default,,0,0,0,,.كنا جميعاً في المطبخ
Dialogue: 0,0:15:00.88,0:15:05.28,Default,,0,0,0,,رأيت أمي تصعد السلالم عبر الممر
Dialogue: 0,0:15:05.28,0:15:06.98,Default,,0,0,0,,.المقابل للحمام أيضاً
Dialogue: 0,0:15:06.98,0:15:10.68,Default,,0,0,0,,إذن، فالاستنتاج الوحيد المحتمل سيكون أن السيد يوشيتيرو سحب سلك ماكينة الحلاقة عن طريق الخطأ إلى الماء
Dialogue: 0,0:15:14.68,0:15:17.78,Default,,0,0,0,,.بينما كان يحلق، وصُعق
Dialogue: 0,0:15:17.78,0:15:19.48,Default,,0,0,0,,.هذه حالة وفاة عرضية
Dialogue: 0,0:15:19.48,0:15:20.98,Default,,0,0,0,,.أعتقد ذلك
Dialogue: 0,0:15:26.08,0:15:29.08,Default,,0,0,0,,!مهلاً. توقف عن هذا الإزعاج
Dialogue: 0,0:15:29.08,0:15:32.08,Default,,0,0,0,,.لكن، رأسي مشوش وأشعر أنني سأقع
Dialogue: 0,0:15:32.08,0:15:33.78,Default,,0,0,0,,لماذا؟
Dialogue: 0,0:15:33.78,0:15:37.38,Default,,0,0,0,,،حسناً، العم الذي مات كان يحلق واقفاً
Dialogue: 0,0:15:37.38,0:15:40.38,Default,,0,0,0,,وكان الضابط تاكاغي يقلده، أليس كذلك؟
Dialogue: 0,0:15:40.38,0:15:42.58,Default,,0,0,0,,،إذن، عندما صُعق بالكهرباء
Dialogue: 0,0:15:42.58,0:15:46.28,Default,,0,0,0,,كان من المفترض أن يكون رأسه بهذا الاتجاه مثل الضابط تاكاغي، أليس كذلك؟
Dialogue: 0,0:15:46.28,0:15:49.58,Default,,0,0,0,,.لكن، رأس ذلك العم كان متجهاً للاتجاه الآخر
Dialogue: 0,0:15:49.58,0:15:50.78,Default,,0,0,0,,أتساءل لماذا؟
Dialogue: 0,0:15:50.78,0:15:52.18,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:15:52.18,0:15:54.58,Default,,0,0,0,,...مهلاً، هذا قد يكون على الأرجح
Dialogue: 0,0:15:55.48,0:15:57.68,Default,,0,0,0,,.لا شيء مهم
Dialogue: 0,0:16:01.38,0:16:04.18,Default,,0,0,0,,،بينما كان السيد يوشيتيرو يحلق
Dialogue: 0,0:16:04.18,0:16:07.28,Default,,0,0,0,,أدرك أن السلك على وشك السقوط في الماء
Dialogue: 0,0:16:07.28,0:16:09.38,Default,,0,0,0,,،وأسرع لالتقاطه
Dialogue: 0,0:16:09.38,0:16:12.08,Default,,0,0,0,,.لكنه سحبه إلى الحوض بدلاً من ذلك
Dialogue: 0,0:16:12.08,0:16:15.08,Default,,0,0,0,,ثم لمس الدرابزين عن طريق الخطأ
Dialogue: 0,0:16:15.08,0:16:19.58,Default,,0,0,0,,.وصُعق
Dialogue: 0,0:16:19.58,0:16:21.48,Default,,0,0,0,,.إذن، كما ترى
Dialogue: 0,0:16:23.08,0:16:25.38,Default,,0,0,0,,.ليس سيئًا، أيها العجوز
Dialogue: 0,0:16:25.78,0:16:28.98,Default,,0,0,0,,.لا. لا تلمس ذلك يا عمي
Dialogue: 0,0:16:28.98,0:16:31.48,Default,,0,0,0,,ماكينة الحلاقة دليل مهم، أليس كذلك؟
Dialogue: 0,0:16:31.48,0:16:34.88,Default,,0,0,0,,.ألمسه؟ أنا فقط أمسكها
Dialogue: 0,0:16:34.88,0:16:36.48,Default,,0,0,0,,ماذا عنك ايها الضابط تاكاغي؟
Dialogue: 0,0:16:36.48,0:16:39.28,Default,,0,0,0,,.لا، أنا فقط أمسكتها بيدي أيضاً
Dialogue: 0,0:16:39.28,0:16:41.18,Default,,0,0,0,,ماذا عن ضابط التحقيق؟
Dialogue: 0,0:16:41.18,0:16:43.98,Default,,0,0,0,,.أنا فقط التقطت الصور
Dialogue: 0,0:16:43.98,0:16:48.28,Default,,0,0,0,,غريب. إذن من يمكنه العبث بها؟
Dialogue: 0,0:16:48.28,0:16:51.38,Default,,0,0,0,,!إلى ماذا ترمي بالضبط؟
Dialogue: 0,0:16:51.38,0:16:55.58,Default,,0,0,0,,.لكن انظر، مفتاح ماكينة الحلاقة مطفأ
Dialogue: 0,0:16:56.58,0:16:58.58,Default,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:16:58.58,0:17:00.68,Default,,0,0,0,,.هذا غريب بعد كل شيء
Dialogue: 0,0:17:00.68,0:17:02.08,Default,,0,0,0,,،إذا كان يُصعق أثناء الحلاقة
Dialogue: 0,0:17:02.08,0:17:09.78,Default,,0,0,0,,!أيها الضابط تاكاغي يجب أن يكون ضغط على مفتاح التشغيل عندما سقط
Dialogue: 0,0:17:09.78,0:17:11.08,Default,,0,0,0,,...هكذا
Dialogue: 0,0:17:13.38,0:17:17.58,Default,,0,0,0,,.ماذا؟ كان يجب سحب القابس لتجنب الخطر
Dialogue: 0,0:17:17.58,0:17:19.68,Default,,0,0,0,,.نعم، لقد فعلنا
Dialogue: 0,0:17:19.68,0:17:23.08,Default,,0,0,0,,.فهمت. هذا النوع يعمل بالبطارية المشحونة
Dialogue: 0,0:17:24.68,0:17:26.68,Default,,0,0,0,,إذن، لماذا كانت مطفأة؟
Dialogue: 0,0:17:26.68,0:17:29.98,Default,,0,0,0,,لم تكن تعمل عندما عثرتم على الجثة، أليس كذلك؟
Dialogue: 0,0:17:29.98,0:17:31.28,Default,,0,0,0,,.نعم
Dialogue: 0,0:17:31.28,0:17:34.38,Default,,0,0,0,,ربما السبب هو الصوت؟
Dialogue: 0,0:17:34.38,0:17:37.58,Default,,0,0,0,,.شخص ما لم يرد سماع ضوضاء ماكينة الحلاقة
Dialogue: 0,0:17:37.58,0:17:40.68,Default,,0,0,0,,من هو الذي لا يريد أن يسمع احد الصوت؟
Dialogue: 0,0:17:40.68,0:17:46.38,Default,,0,0,0,,.لا أعرف. أنا فقط أخمّن
Dialogue: 0,0:17:46.38,0:17:53.68,Default,,0,0,0,,ربما حتى يتمكن شخص ما من وضع السلك في الحوض دون أن يلاحظ السيد يوشيتيرو؟
Dialogue: 0,0:17:53.68,0:17:55.18,Default,,0,0,0,,!أيها الأحمق
Dialogue: 0,0:17:55.18,0:17:59.18,Default,,0,0,0,,.كان سيلاحظ إذا فعل شيئاً كهذا، حتى لو لم تصدر ماكينة الحلاقة أي صوت
Dialogue: 0,0:17:59.18,0:18:03.88,Default,,0,0,0,,.بالإضافة إلى ذلك، الجميع لديهم حجة غياب عندما انقطع التيار
Dialogue: 0,0:18:03.88,0:18:05.98,Default,,0,0,0,,،عندما عادت الأضواء
Dialogue: 0,0:18:05.98,0:18:08.98,Default,,0,0,0,,انطفأت مرة ثم عادت، أليس كذلك؟
Dialogue: 0,0:18:10.98,0:18:12.28,Default,,0,0,0,,أنسة هيكارو؟
Dialogue: 0,0:18:12.28,0:18:15.18,Default,,0,0,0,,أنتِ من ذهبتِ لرفع قاطع التيار، أليس كذلك؟
Dialogue: 0,0:18:15.18,0:18:16.28,Default,,0,0,0,,.نعم
Dialogue: 0,0:18:16.28,0:18:20.78,Default,,0,0,0,,هل رفعتِ قاطع التيار مرتين في ذلك الوقت؟
Dialogue: 0,0:18:20.78,0:18:26.38,Default,,0,0,0,,.أنا آسفة. اعتقدت أنني ربما رفعت على القاطع الخطأ
Dialogue: 0,0:18:26.38,0:18:31.28,Default,,0,0,0,,.انقطع قاطع مختلف، فرفعته مجدداً
Dialogue: 0,0:18:31.28,0:18:33.88,Default,,0,0,0,,.أنا آسفة حقاً
Dialogue: 0,0:18:33.88,0:18:37.48,Default,,0,0,0,,،أيها المفتش، المرة الثانية التي انقطع فيها القاطع
Dialogue: 0,0:18:37.48,0:18:39.28,Default,,0,0,0,,...ربما كان
Dialogue: 0,0:18:39.28,0:18:41.08,Default,,0,0,0,,.نعم
Dialogue: 0,0:18:41.08,0:18:44.18,Default,,0,0,0,,،ربما تم تركيب مؤقت من قبل الجاني بحيث يكون هناك انقطاع للتيار
Dialogue: 0,0:18:44.18,0:18:46.78,Default,,0,0,0,,.ثم يستغل الفرصة ليتسلل إلى الحمام ويلقي السلك في حوض الاستحمام
Dialogue: 0,0:18:46.78,0:18:51.78,Default,,0,0,0,,.أي من هؤلاء الأربعة كان يمكنه فعل ذلك
Dialogue: 0,0:18:51.78,0:18:53.98,Default,,0,0,0,,.هذا ممكن
Dialogue: 0,0:18:53.98,0:18:56.48,Default,,0,0,0,,مهلا، عم تتحدثون بالهمس؟
Dialogue: 0,0:18:56.48,0:18:58.08,Default,,0,0,0,,.لا، لا شيء
Dialogue: 0,0:18:58.08,0:19:00.38,Default,,0,0,0,,،أود تأكيد حجة غيابكم قبل انقطاع التيار
Dialogue: 0,0:19:00.38,0:19:02.58,Default,,0,0,0,,.كأجراء احتياطي
Dialogue: 0,0:19:02.58,0:19:05.28,Default,,0,0,0,,.لقد قدمنا لكم حجة غيابنا قبل قليل
Dialogue: 0,0:19:05.28,0:19:09.58,Default,,0,0,0,,ماذا؟ هل تعني أن الجاني بيننا؟
Dialogue: 0,0:19:09.58,0:19:12.98,Default,,0,0,0,,.نريد فقط التأكد، هذا كل شيء
Dialogue: 0,0:19:14.78,0:19:17.18,Default,,0,0,0,,كنتِ على الهاتف طوال فترة الانقطاع؟
Dialogue: 0,0:19:17.18,0:19:18.98,Default,,0,0,0,,نعم. منذ وقت قبل الانقطاع
Dialogue: 0,0:19:18.98,0:19:20.58,Default,,0,0,0,,،حتى عودة الأضواء
Dialogue: 0,0:19:20.58,0:19:25.58,Default,,0,0,0,,.كنت على الهاتف عند مدخل المطبخ
Dialogue: 0,0:19:25.58,0:19:27.98,Default,,0,0,0,,كنت أتحدث مع صديقتي، ماساي
Dialogue: 0,0:19:27.98,0:19:31.58,Default,,0,0,0,,.حول ترتيبات اللقاء
Dialogue: 0,0:19:31.58,0:19:34.38,Default,,0,0,0,,.تلقيت مكالمة أنتظارية، مع ذلك
Dialogue: 0,0:19:34.38,0:19:37.88,Default,,0,0,0,,.لكن، لم يجب أحد عندما رديت ثم أنقطع الخط
Dialogue: 0,0:19:37.88,0:19:39.78,Default,,0,0,0,,أيها الضابط تاكاغي، هل يمكنك التحقق من هذا حالاً؟
Dialogue: 0,0:19:39.78,0:19:40.88,Default,,0,0,0,,.نعم
Dialogue: 0,0:19:41.38,0:19:44.58,Default,,0,0,0,,كنت أبحث عن مصباح يدوي عندما انقطع التيار
Dialogue: 0,0:19:44.58,0:19:46.48,Default,,0,0,0,,.وسلمته للأنسة هيكارو
Dialogue: 0,0:19:46.48,0:19:49.38,Default,,0,0,0,,.كنت هنا في المطبخ طوال الوقت
Dialogue: 0,0:19:49.38,0:19:51.48,Default,,0,0,0,,هل يمكنك إثبات ذلك؟
Dialogue: 0,0:19:51.48,0:19:53.58,Default,,0,0,0,,...لا، لا أعتقد
Dialogue: 0,0:19:53.58,0:19:57.48,Default,,0,0,0,,.السيد تومواكي كان هنا طوال الوقت
Dialogue: 0,0:19:57.48,0:20:01.58,Default,,0,0,0,,،بعد أن ذهبت الإنسة هيكارو لرفع القاطع، كنتُ خائفة
Dialogue: 0,0:20:01.58,0:20:04.58,Default,,0,0,0,,.لذا أمسكت بذراع بتومواكي طوال الوقت حتى عادت الأضواء
Dialogue: 0,0:20:04.58,0:20:06.68,Default,,0,0,0,,طوال الوقت؟
Dialogue: 0,0:20:08.18,0:20:09.18,Default,,0,0,0,,لماذا؟
Dialogue: 0,0:20:10.48,0:20:14.58,Default,,0,0,0,,.كما قلت، ظننت أنه أبي
Dialogue: 0,0:20:15.28,0:20:18.18,Default,,0,0,0,,التالي، أنسة ميتسو، أين كنتِ؟
Dialogue: 0,0:20:18.18,0:20:23.98,Default,,0,0,0,,.كنت قد انتهيت للتو من صعود السلالم عندما انقطعت الكهرباء
Dialogue: 0,0:20:23.98,0:20:27.38,Default,,0,0,0,,.تلمست طريقي إلى غرفتي في الطابق العلوي
Dialogue: 0,0:20:27.38,0:20:33.78,Default,,0,0,0,,.لكن عندما عادت الأضواء، عدتِ نزولاً إلى المطبخ
Dialogue: 0,0:20:33.78,0:20:40.68,Default,,0,0,0,,.شعرت بوجود شخص ما عندما كنت على وشك النوم
Dialogue: 0,0:20:40.68,0:20:42.18,Default,,0,0,0,,أيعقل
Dialogue: 0,0:20:42.18,0:20:45.18,Default,,0,0,0,,شخصاً آخر غيركم جميعاً تسلل إلى المنزل؟
Dialogue: 0,0:20:45.18,0:20:49.98,Default,,0,0,0,,.هذا ما اعتقدته لذا تبعت الصوت إلى الطابق السفلي
Dialogue: 0,0:20:49.98,0:20:50.98,Default,,0,0,0,,.لكن، اكتشفت
Dialogue: 0,0:20:50.98,0:20:52.38,Default,,0,0,0,,ماذا اكتشفتِ؟
Dialogue: 0,0:20:52.38,0:20:54.88,Default,,0,0,0,,.كان صوت المطر
Dialogue: 0,0:20:54.88,0:20:56.68,Default,,0,0,0,,.فهمت
Dialogue: 0,0:20:58.38,0:21:00.68,Default,,0,0,0,,.وأخيراً أنتِ، أنسة هيكارو
Dialogue: 0,0:21:00.68,0:21:01.88,Default,,0,0,0,,.نعم
Dialogue: 0,0:21:01.88,0:21:05.78,Default,,0,0,0,,.ذهبت إلى القاطع لتشغيل الكهرباء
Dialogue: 0,0:21:05.78,0:21:10.38,Default,,0,0,0,,.ما زلت غير معتادة على هذا المنزل، لذا ضللت الطريق قليلاً
Dialogue: 0,0:21:10.38,0:21:13.78,Default,,0,0,0,,لم تلاحظي أي شخص مريب، أليس كذلك؟
Dialogue: 0,0:21:13.78,0:21:15.68,Default,,0,0,0,,.نعم، لا أحد
Dialogue: 0,0:21:19.78,0:21:21.18,Default,,0,0,0,,.كما توقعت
Dialogue: 0,0:21:21.18,0:21:22.88,Default,,0,0,0,,.تبا
Dialogue: 0,0:21:22.88,0:21:25.58,Default,,0,0,0,,.كنت أتساءل لماذا كنتِ تلمسين ذراعك
Dialogue: 0,0:21:25.58,0:21:28.98,Default,,0,0,0,,.ما زلتِ تتحملين كل شيء
Dialogue: 0,0:21:28.98,0:21:30.58,Default,,0,0,0,,أثر حرق؟
Dialogue: 0,0:21:30.58,0:21:32.98,Default,,0,0,0,,،المعذرة، لكني أود علاج جرحها
Dialogue: 0,0:21:32.98,0:21:35.28,Default,,0,0,0,,فهل يمكنني الذهاب إلى العيادة؟
Dialogue: 0,0:21:35.28,0:21:39.08,Default,,0,0,0,,.نعم، لكن أرجو أن يرافقكما الضابط الواقف أمام الباب
Dialogue: 0,0:21:39.08,0:21:41.68,Default,,0,0,0,,.تريده أن يراقبنا
Dialogue: 0,0:21:42.48,0:21:44.58,Default,,0,0,0,,.وشيء آخر
Dialogue: 0,0:21:44.58,0:21:49.28,Default,,0,0,0,,يبدو أنك الوحيد الذي غادر المنزل
Dialogue: 0,0:21:49.28,0:21:52.38,Default,,0,0,0,,بين 5:00 و 7:00، إلى أين ذهبت؟
Dialogue: 0,0:21:52.38,0:21:55.38,Default,,0,0,0,,.ذهبت كمدرب كرة سلة مؤقت لنادي مدرسي ثانوي
Dialogue: 0,0:21:55.38,0:21:57.08,Default,,0,0,0,,،مدربهم كان معلمي سابقًا
Dialogue: 0,0:21:57.08,0:22:03.38,Default,,0,0,0,,.لكنه أصيب بكسر ، فتطوعت لأكون مكانه حتى يتعافى
Dialogue: 0,0:22:03.38,0:22:06.58,Default,,0,0,0,,أنت، طبيب، مدرب كرة سلة؟
Dialogue: 0,0:22:06.58,0:22:10.18,Default,,0,0,0,,.إذا كنت لا تصدقني يمكنك أن تسأل الإنسة ران عن ذلك
Dialogue: 0,0:22:10.18,0:22:14.88,Default,,0,0,0,,.أذهب لأدرب في ثانوية تيتان، المدرسة التي تذهب إليها ران
Dialogue: 0,0:22:15.98,0:22:19.18,Default,,0,0,0,,تعرفين مدرب نادي كرة السلة السيد تابوتشي، أليس كذلك؟
Dialogue: 0,0:22:19.18,0:22:20.98,Default,,0,0,0,,.نعم
Dialogue: 0,0:22:20.98,0:22:23.58,Default,,0,0,0,,مهلاً... ايعقل
Dialogue: 0,0:22:23.58,0:22:27.48,Default,,0,0,0,,...نادي الكاراتيه الذي كانت ران تذهب إليه يومياً هو
Dialogue: 0,0:22:28.88,0:22:30.08,Default,,0,0,0,,أيعقل؟
Dialogue: 0,0:22:31.58,0:22:32.78,Default,,0,0,0,,أيعقل؟
Dialogue: 0,0:22:50.71,0:22:55.63,DCEnding,,0,0,0,,سحر بلا حدود، المكان الأصيل
Dialogue: 0,0:22:56.19,0:23:00.94,DCEnding,,0,0,0,,سحر بلا حدود، هل للحب معنى واضح؟
Dialogue: 0,0:23:01.62,0:23:06.63,DCEnding,,0,0,0,,وسط عتمة باردة، أبحث بشدة عن ذرة دفء
Dialogue: 0,0:23:06.95,0:23:12.75,DCEnding,,0,0,0,,يوماً ما، لا بد أن تحدث معجزة
Dialogue: 0,0:23:15.26,0:23:25.35,DCEnding,,0,0,0,,سحر بلا حدود، لو كان للحب وجود، فلابد أنه على هيئة دائرة
Dialogue: 0,0:23:26.18,0:23:36.27,DCEnding,,0,0,0,,سحر بلا حدود، بين أصابعي المرتجفة تولد صرختي الأولى
Dialogue: 0,0:23:36.84,0:23:44.77,DCEnding,,0,0,0,,حتى بدافع الغرور، فهذا تجاوز غير معقول
Dialogue: 0,0:23:45.30,0:23:50.18,DCEnding,,0,0,0,,سحر بلا حدود، يكفيه أن يُلامس قلبًا فيه قليل من الشجاعة
Dialogue: 0,0:23:50.62,0:24:01.38,DCEnding,,0,0,0,,سحر بلا حدود، فلنتحد جميعًا ونكبر سويًا