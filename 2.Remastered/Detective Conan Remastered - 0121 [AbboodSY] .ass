Dialogue: 0,0:00:01.06,0:00:04.33,Narration,,0000,0000,0000,,{\blur2}المواقف التي نواجهها غامضة \Nولكن العالم غامضٌ أكثر منها
Dialogue: 0,0:00:04.33,0:00:06.44,Narration,,0000,0000,0000,,{\blur2}أنا سعيدٌ حقاً بأنني معك
Dialogue: 0,0:00:06.44,0:00:08.11,Narration,,0000,0000,0000,,{\blur2}اليوم متعلق بِأختين جميلتين
Dialogue: 0,0:00:08.11,0:00:09.98,Narration,,0000,0000,0000,,{\blur2}و قضيةٌ تحصل وراء كلمات الموت
Dialogue: 0,0:00:09.98,0:00:11.65,Narration,,0000,0000,0000,,{\blur2}يرى الحقيقة واحدةً كما هي
Dialogue: 0,0:00:11.65,0:00:13.45,Narration,,0000,0000,0000,,{\blur2}يبدو كطفل صغير و لكنه بعقل كبير
Dialogue: 0,0:00:13.45,0:00:16.05,Default,NTP,,0000,0000,0000,{\blur2}و اسمه هو، المحقق كونان
Dialogue: 0,0:01:51.14,0:01:56.90,Default,,0000,0000,0000,,{\pos(320,112)\b0\bord0\shad0\fscx100\fscy100\fnDINk\fsp0\fs36}جريمة قتل الحمّام المغلق
Dialogue: 0,0:01:51.14,0:01:56.90,Default,,0000,0000,0000,,{\pos(320,315)\a6\b0\bord0\shad0\fscx100\fscy100\fnDINk\fsp0\fs32}(الجزء الأول)
Dialogue: 0,0:02:17.28,0:02:21.57,Default,,0000,0000,0000,,{\a6}"أوشيما"
Dialogue: 0,0:02:19.99,0:02:21.57,Default,,0000,0000,0000,,!لقد عدت
Dialogue: 0,0:02:21.57,0:02:25.12,Default,,0000,0000,0000,,أين كنتي؟ لقد غبتي لوقتٍ طويل
Dialogue: 0,0:02:25.12,0:02:28.17,Default,,0000,0000,0000,,لقد علَقت لبعض الوقت في المتجر
Dialogue: 0,0:02:27.38,0:02:34.55,CharCard,,0000,0000,0000,,{\fad(400,0)\pos(306,320)}مينا اوشيما (٢٤)\Nمبنى هايدو، موظفة في متجر
Dialogue: 0,0:02:28.17,0:02:31.94,Default,,0000,0000,0000,,لقد تأكدت من شراء كل شيء طلبتيه يا أختي
Dialogue: 0,0:02:31.94,0:02:34.94,Default,,0000,0000,0000,,منظفات الحمام، شريط، و مشروب
Dialogue: 0,0:02:34.60,0:02:40.86,CharCard,,0000,0000,0000,,{\fad(400,0)\pos(324,320)}اوشيما ماسايو(٢٦)\Nموظفة في بنك بيكا
Dialogue: 0,0:02:34.94,0:02:39.09,Default,,0000,0000,0000,,شكراً، نسيت أن أشتري منظّفاً للحمام
Dialogue: 0,0:02:39.09,0:02:42.90,Default,,0000,0000,0000,,لأن متجر الحاجيّات القريب من شقتي يتم ترميمه
Dialogue: 0,0:02:42.90,0:02:49.45,Default,,0000,0000,0000,,و لكن أحقاً ستشاهدين شريط الفيديو ذاك بوجود تلك الممثلة فيه؟
Dialogue: 0,0:02:49.45,0:02:56.72,Default,,0000,0000,0000,,لا تقولي هذا\Nستنتقل اختك من هنا لأجلك
Dialogue: 0,0:02:59.70,0:03:03.27,Default,,0000,0000,0000,,يبدو أن هذا يتطلب الكثير من العمل، أيمكنني المساعدة؟
Dialogue: 0,0:03:03.27,0:03:10.62,Default,,0000,0000,0000,,أيمكنك أن تقطعي بعض الأشرطة اللاصقة و تلصقيها على الطاولة؟
Dialogue: 0,0:03:10.62,0:03:13.46,Default,,0000,0000,0000,,آسفة لقدومي إلى هنا فجأةً هكذا
Dialogue: 0,0:03:13.46,0:03:16.09,Default,,0000,0000,0000,,و جعلك تذهبين للتبضّع لي و مساعدتي على حزم أمتعتي
Dialogue: 0,0:03:16.09,0:03:19.20,Default,,0000,0000,0000,,ما هذا الذي تقولينه، هذه ليست بمشكلة
Dialogue: 0,0:03:19.20,0:03:24.98,Default,,0000,0000,0000,,أه يجب أن أشكركِ! لطالما انتظر السيد كينجي لحفلة الغد
Dialogue: 0,0:03:24.98,0:03:27.72,Default,,0000,0000,0000,,صحيح! لقد نسيت
Dialogue: 0,0:03:30.06,0:03:32.73,Default,,0000,0000,0000,,قبل أن نحزم الأمتعة
Dialogue: 0,0:03:32.73,0:03:37.21,Default,,0000,0000,0000,,يجب أن أعدّ احتفالاً صغيراً لأختي الصغيرة بهذه المناسبة
Dialogue: 0,0:03:37.21,0:03:39.98,Default,,0000,0000,0000,,لا يُعقل، ليس علينا أن نقوم بذلك
Dialogue: 0,0:03:39.98,0:03:41.95,Default,,0000,0000,0000,,..كلا كلا
Dialogue: 0,0:03:41.95,0:03:46.12,Default,,0000,0000,0000,,كنت مشغولةً جداً منذ أن أعلنتي أنك ستتزوجين
Dialogue: 0,0:03:46.12,0:03:48.83,Default,,0000,0000,0000,,لدرجة أنني لم أحظى بفرصة الإحتفال بهذا معك
Dialogue: 0,0:03:48.83,0:03:53.03,Default,,0000,0000,0000,,لذلك هذا هو احتفال اختك الصغير معكِ
Dialogue: 0,0:03:55.47,0:03:57.45,Default,,0000,0000,0000,,أرجو أن تقبلي به
Dialogue: 0,0:04:14.68,0:04:18.16,Default,,0000,0000,0000,,الأميرة الحسناء يوكو
Dialogue: 0,0:04:18.16,0:04:21.13,Default,,0000,0000,0000,,!جمالك بحد ذاته جريمة
Dialogue: 0,0:04:21.13,0:04:24.76,Default,,0000,0000,0000,,ألقي نظرةً على هذه الزهور التي أحضرتها لك
Dialogue: 0,0:04:24.76,0:04:31.77,Default,,0000,0000,0000,,جميعها أصبحت حمراء برّاقة عندما وقِعت في عشقكِ
Dialogue: 0,0:04:32.85,0:04:34.44,Default,,0000,0000,0000,,أليس كذلك؟؟
Dialogue: 0,0:04:36.52,0:04:39.73,Default,,0000,0000,0000,,أظن أن سخافة عمي هو الجريمة الحقيقية بذاتها
Dialogue: 0,0:04:39.73,0:04:40.82,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:04:47.55,0:04:52.49,Default,,0000,0000,0000,,أعتقد أن الصغار لا يستطيعون فهم هذه الأبيات الشعرية الجميلة ببساطة هكذا
Dialogue: 0,0:04:52.49,0:04:56.48,Thoughts,,0000,0000,0000,,{\blur2}نعم، جميلةٌ جداً
Dialogue: 0,0:05:00.04,0:05:02.67,Default,,0000,0000,0000,,يبدو عمي بمزاجٍ جيد اليوم
Dialogue: 0,0:05:02.67,0:05:07.56,Default,,0000,0000,0000,,نعم، لأن السيدة يوكو ستقيم حفلاً الليلة
Dialogue: 0,0:05:07.56,0:05:12.43,Default,,0000,0000,0000,,هيا يا أبي أليس من المفترض أن نذهب الآن؟ سيزدحم المكان كثيراً إذا لم نذهب حالاً
Dialogue: 0,0:05:12.43,0:05:15.40,Default,,0000,0000,0000,,لا تقلقي
Dialogue: 0,0:05:15.40,0:05:20.51,Default,,0000,0000,0000,,إذأ أعطيناهم التذاكر التي تحمل توقيع يوكو عليها
Dialogue: 0,0:05:20.51,0:05:25.75,Default,,0000,0000,0000,,سيسمحون لنا بالدخول من الباب الخلفي
Dialogue: 0,0:05:25.75,0:05:27.16,Default,,0000,0000,0000,,!هاه
Dialogue: 0,0:05:33.17,0:05:35.44,Default,,0000,0000,0000,,ماذا هناك أبي!؟
Dialogue: 0,0:05:35.44,0:05:39.85,Default,,0000,0000,0000,,!!يوجد ثقبٌ هنا
Dialogue: 0,0:05:41.92,0:05:44.12,Default,,0000,0000,0000,,لا تقل لي أنك أضعت التذاكر!؟
Dialogue: 0,0:05:44.12,0:05:49.87,Default,,0000,0000,0000,,ليس هنا! ليس هنا! ليس هنا! أين ذهبت.. يوكو خاصتي
Dialogue: 0,0:05:49.87,0:05:56.18,Default,,0000,0000,0000,,ماذا عن الحمام؟ لقد ركضت إلى هناك مباشرةً عندما وصلنا هنا
Dialogue: 0,0:05:56.18,0:05:58.69,Default,,0000,0000,0000,,!يجب أن يكونوا هناك
Dialogue: 0,0:05:58.69,0:06:01.89,Default,,0000,0000,0000,,هذا صحيح! الحمام! الحمام! يجب أن يكونوا هناك
Dialogue: 0,0:06:10.18,0:06:12.48,Default,,0000,0000,0000,,إذاً؟ هل وجدتهم؟
Dialogue: 0,0:06:12.48,0:06:16.25,Default,,0000,0000,0000,,لا، أبداً
Dialogue: 0,0:06:16.25,0:06:20.60,Default,,0000,0000,0000,,لا بأس، أنا متأكدةٌ أنهم سيدعونا ندخل إن شرحنا لهم القصة
Dialogue: 0,0:06:20.60,0:06:21.93,Default,,0000,0000,0000,,!أيها الغبية
Dialogue: 0,0:06:21.93,0:06:26.57,Default,,0000,0000,0000,,لا أستطيع أن أجعل نفسي أبدو بمظهرٍ أحمق عندما أعطيها باقة الزهور
Dialogue: 0,0:06:26.57,0:06:28.48,Default,,0000,0000,0000,,إنتظري لحظة
Dialogue: 0,0:06:28.48,0:06:32.95,Default,,0000,0000,0000,,حسبما أذكر، لديك امتحانات الفصل الأول الأسبوع القادم صحيح؟
Dialogue: 0,0:06:32.95,0:06:34.26,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:06:34.26,0:06:39.94,Default,,0000,0000,0000,,إذاً أعطني تذكرتك و اذهبي للمنزل لتذاكري لامتحاناتك
Dialogue: 0,0:06:39.94,0:06:41.44,Default,,0000,0000,0000,,!ماذا تقول
Dialogue: 0,0:06:41.44,0:06:45.04,Default,,0000,0000,0000,,..صحيح! لنقل في الواقع أنه
Dialogue: 0,0:06:45.04,0:06:47.49,Default,,0000,0000,0000,,لحظة.. أبي؟
Dialogue: 0,0:06:47.49,0:06:51.73,Default,,0000,0000,0000,,..نعم نعم! لنقل أن كونان أضاع تذكرته و
Dialogue: 0,0:06:51.73,0:06:53.56,Default,,0000,0000,0000,,!!توقف عن هذا
Dialogue: 0,0:06:53.56,0:06:55.23,Default,,0000,0000,0000,,!!آسف آسف
Dialogue: 0,0:06:55.23,0:06:58.54,Default,,0000,0000,0000,,ما الذي تعنيه بأنك لا تستطيع القدوم يا كينجي!؟
Dialogue: 0,0:06:58.54,0:07:02.28,Default,,0000,0000,0000,,نزلة برد؟ ستتجاوزها هنا عند حضورك الحفلة
Dialogue: 0,0:07:02.28,0:07:04.78,Default,,0000,0000,0000,,هل تعلم كم كان صعباً
Dialogue: 0,0:07:04.78,0:07:08.10,Default,,0000,0000,0000,,الحصول على تذاكر لحفلة يوكو؟؟
Dialogue: 0,0:07:08.10,0:07:14.70,Default,,0000,0000,0000,,على أي حال فقط تعال إلى هنا، أنا و اختي خططنا للذهاب بسيارتك إلى هناك
Dialogue: 0,0:07:14.70,0:07:19.42,Default,,0000,0000,0000,,ماذا!؟ لا تستطيع! كينجي
Dialogue: 0,0:07:19.42,0:07:21.15,Default,,0000,0000,0000,,كينجي!؟
Dialogue: 0,0:07:21.15,0:07:23.86,Default,,0000,0000,0000,,أيها التافه عديم النفع
Dialogue: 0,0:07:25.69,0:07:28.07,Default,,0000,0000,0000,,..لو سمحتي\Nنعم؟؟
Dialogue: 0,0:07:28.07,0:07:34.88,Default,,0000,0000,0000,,هل لديكي تذكرة إضافية لحفل اوكينا يوكو الليلة؟
Dialogue: 0,0:07:34.88,0:07:36.48,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:07:36.48,0:07:41.26,Default,,0000,0000,0000,,في هذه الحالة.. هل يمكنك بيعها لي بسعر معقول؟
Dialogue: 0,0:07:41.26,0:07:47.18,Default,,0000,0000,0000,,لحظة، أبي! هذا هدر للنقود! يمكننا الدخول إذا شرحت لهم ما الذي حدث
Dialogue: 0,0:07:47.18,0:07:52.88,Default,,0000,0000,0000,,اصمتي! فخر الرجال لا يمكن تبديله بالنقود
Dialogue: 0,0:07:52.88,0:07:54.32,Default,,0000,0000,0000,,يالك من مغرور
Dialogue: 0,0:07:54.32,0:07:56.45,Default,,0000,0000,0000,,!عمي
Dialogue: 0,0:07:56.45,0:08:00.97,Default,,0000,0000,0000,,بالفعل لم تفقد تذكرتك بالسيارة أيضاً
Dialogue: 0,0:08:00.97,0:08:04.20,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:04.20,0:08:08.85,Default,,0000,0000,0000,,إذاً، هل تمانعين بأن تبيعيها لي؟
Dialogue: 0,0:08:08.85,0:08:12.29,Default,,0000,0000,0000,,لا لا، يبدو أنك واقعٌ بمشكلةٍ ما، لذلك يمكنك أخذها بلا مقابل
Dialogue: 0,0:08:12.29,0:08:14.56,Default,,0000,0000,0000,,مجاناً؟؟
Dialogue: 0,0:08:14.56,0:08:17.44,Default,,0000,0000,0000,,مجاناً!؟ حقاً!؟؟
Dialogue: 0,0:08:17.44,0:08:24.18,Default,,0000,0000,0000,,نعم، و لكن بالمقابل، هل يمكنني أن أطلب منك معروفاً؟
Dialogue: 0,0:08:24.18,0:08:26.75,Default,,0000,0000,0000,,!نعم، أي شيء تريدينه
Dialogue: 0,0:08:26.75,0:08:28.92,Default,,0000,0000,0000,,ما الذي يحصل مع عمي؟؟
Dialogue: 0,0:08:28.92,0:08:34.16,Default,,0000,0000,0000,,اعتقدت أنه يحافظ على كبريائه و لكن يبدو أنه لا يهمه
Dialogue: 0,0:08:35.93,0:08:38.58,Default,,0000,0000,0000,,أعتذر منك لأنني طلبت هذا
Dialogue: 0,0:08:38.58,0:08:43.95,Default,,0000,0000,0000,,لا، هذا لا يهم، نحن فقط ذاهببن لنحضر اختك
Dialogue: 0,0:08:43.95,0:08:46.45,Default,,0000,0000,0000,,هذا جيدٌ أننا استأجرنا هذه السيارة صحيح
Dialogue: 0,0:08:46.45,0:08:51.83,Default,,0000,0000,0000,,نعم، إنه حظٌ جيد أنه كان لدي أعمالٌ بعيدة عن هنا هذا الصباح
Dialogue: 0,0:08:51.83,0:08:55.10,Default,,0000,0000,0000,,و لكن ما الذي يمكن أنه قد حصل مع مينا؟
Dialogue: 0,0:08:55.10,0:09:01.32,Default,,0000,0000,0000,,كانت تنتظر الحفل بفارغ الصبر، و لكنها لم تأتي
Dialogue: 0,0:09:01.32,0:09:03.42,Default,,0000,0000,0000,,هل جرّبتي الإتصال بها؟
Dialogue: 0,0:09:03.42,0:09:09.07,Default,,0000,0000,0000,,نعم و لكنها لم تجب \Nو آلة التسجيل الصوتي لم تعمل
Dialogue: 0,0:09:09.07,0:09:11.91,Default,,0000,0000,0000,,أتمنى بأنه لم يحصل لها مكروه
Dialogue: 0,0:09:11.91,0:09:13.48,Default,,0000,0000,0000,,مكروه؟
Dialogue: 0,0:09:13.48,0:09:17.59,Default,,0000,0000,0000,,أختي كانت تتصرف بغرابة مؤخراً
Dialogue: 0,0:09:17.59,0:09:20.76,Default,,0000,0000,0000,,أصبحت كئيبةً منذ أن أعلنت عن أنها ستتزوج
Dialogue: 0,0:09:20.76,0:09:23.43,Default,,0000,0000,0000,,و أحياناً تنهال بالبكاء بلا سبب
Dialogue: 0,0:09:23.43,0:09:29.51,Default,,0000,0000,0000,,لهذا، دعوتها لحفلة الليلة، لكي أرفع من معنوياتها قليلاً
Dialogue: 0,0:09:29.51,0:09:32.61,Default,,0000,0000,0000,,بالمناسبة، كنت أشعر بالفضول كل الوقت
Dialogue: 0,0:09:32.61,0:09:37.33,Default,,0000,0000,0000,,..هذا الوشاح الذي على رأسك، هل هو
Dialogue: 0,0:09:37.33,0:09:40.10,Default,,0000,0000,0000,,آه، هذا وشاح محدود الكمية
Dialogue: 0,0:09:40.10,0:09:43.80,Default,,0000,0000,0000,,تم توزيعه مع ألبوم يوكو الذي أُطلق البارحة
Dialogue: 0,0:09:43.80,0:09:46.67,Default,,0000,0000,0000,,إذاً بالفعل إنه لِيوكو
Dialogue: 0,0:09:46.67,0:09:49.28,Default,,0000,0000,0000,,و لكن، من المذهل أنه يمكنك الحصول على أشياء كهذه
Dialogue: 0,0:09:49.28,0:09:50.42,Default,,0000,0000,0000,,أنتي محظوظةٌ جداً
Dialogue: 0,0:09:50.42,0:09:54.02,Default,,0000,0000,0000,,ماذا!؟ أنت من معجبيها و لم تشتريه؟؟
Dialogue: 0,0:09:54.02,0:09:57.47,Default,,0000,0000,0000,,يأتي أيضاً بحاملة مفاتيح
Dialogue: 0,0:09:58.60,0:10:04.24,Default,,0000,0000,0000,,أعطتنا جميع أقراصها شخصياً، لذلك لم نحصل على الإضافات هذه
Dialogue: 0,0:10:04.24,0:10:09.09,Default,,0000,0000,0000,,ماذا!؟ شخصياً!؟ هل تعرف يوكو!؟
Dialogue: 0,0:10:09.09,0:10:12.26,Default,,0000,0000,0000,,أجل، بالكاد تقابلنا خلال قضيةٍ
Dialogue: 0,0:10:12.26,0:10:14.10,Default,,0000,0000,0000,,قضية!؟
Dialogue: 0,0:10:14.10,0:10:20.64,Default,,0000,0000,0000,,نعم، اسمي موري كوغورو، أنا محقق
Dialogue: 0,0:10:24.28,0:10:26.48,Default,,0000,0000,0000,,ماذا؟ هل هنالك مشكلة؟
Dialogue: 0,0:10:26.48,0:10:33.97,Default,,0000,0000,0000,,لا! و لكني سمعت عن هذا الإسم، أنت مشهورٌ جداً هنا
Dialogue: 0,0:10:33.97,0:10:37.54,Default,,0000,0000,0000,,لا.. لست مشهوراً كثيراً
Dialogue: 0,0:10:47.67,0:10:51.04,Default,,0000,0000,0000,,آه!؟ منزل
Dialogue: 0,0:10:52.21,0:10:55.08,Default,,0000,0000,0000,,اختك الصغيرة تعيش هنا لوحدها؟
Dialogue: 0,0:10:55.08,0:11:00.02,Default,,0000,0000,0000,,لا، لقد كنت أسكن معها حتى الأسبوع الماضي
Dialogue: 0,0:11:00.02,0:11:05.39,Default,,0000,0000,0000,,انتقلت من هنا لكي يستطيع خطيبها أن يسكن معها هنا الشهر القادم
Dialogue: 0,0:11:07.64,0:11:10.68,Default,,0000,0000,0000,,حذائها هنا
Dialogue: 0,0:11:10.68,0:11:12.91,Default,,0000,0000,0000,,يبدو أنها ما تزال نائمة
Dialogue: 0,0:11:12.91,0:11:20.03,Default,,0000,0000,0000,,سأذهب لإيقاظها، تستطيعون الإستراحة في غرفة الجلوس
Dialogue: 0,0:11:20.03,0:11:22.47,Default,,0000,0000,0000,,..و لكن الوقت
Dialogue: 0,0:11:22.47,0:11:24.70,Default,,0000,0000,0000,,سنأخذ دقيقة فقط
Dialogue: 0,0:11:24.70,0:11:28.05,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:11:28.05,0:11:32.59,Default,,0000,0000,0000,,ما هذا.. سنحتاج ساعةً للعودة إلى هناك
Dialogue: 0,0:11:32.59,0:11:36.09,Default,,0000,0000,0000,,لا عليك، هدّء من روعك
Dialogue: 0,0:11:36.09,0:11:38.74,Default,,0000,0000,0000,,يا إلهي! ما هذا
Dialogue: 0,0:11:38.74,0:11:42.27,Default,,0000,0000,0000,,هذه الغرفة مليئة بملصقات المشاهير
Dialogue: 0,0:11:42.27,0:11:47.46,Default,,0000,0000,0000,,..يوكو، أسوكا أنزاي، تو-ميكس، تيرومي هوشينو
Dialogue: 0,0:11:47.46,0:11:52.26,Default,,0000,0000,0000,,مدهش! إنها تمتلك ملصقاً لفرقة ليكس، مع أنهم افترقوا
Dialogue: 0,0:11:52.26,0:11:55.63,Thoughts,,0000,0000,0000,,{\blur2}المدهش أيضاً أنك تعرف الكثير عن هؤلاء
Dialogue: 0,0:11:55.63,0:11:59.81,Default,,0000,0000,0000,,يبدو أن السيدة ماسايو بالتأكيد تعشق المشاهير
Dialogue: 0,0:11:59.81,0:12:04.15,Default,,0000,0000,0000,,و لكن يبدو أن اختها تعاني كثيراً من هذا الأمر
Dialogue: 0,0:12:04.15,0:12:07.03,Default,,0000,0000,0000,,أعتقد أن كلاهما يحب المشاهير
Dialogue: 0,0:12:07.03,0:12:11.37,Default,,0000,0000,0000,,أترى؟ هناك نسختان من كل شيء، حتى الكتب المصورة و الأقراص
Dialogue: 0,0:12:11.37,0:12:13.67,Default,,0000,0000,0000,,و أسمائهما مكتوبةٌ عليهم
Dialogue: 0,0:12:13.67,0:12:18.18,Default,,0000,0000,0000,,و لكن لمَ لم تأخذهم السيدة ماسايو معها عند انتقالها؟
Dialogue: 0,0:12:18.18,0:12:22.29,Default,,0000,0000,0000,,يبدو أن هناك الكثير منهم لدرجة أنها لا تستطيع أخذهم جميعاً في نفس الوقت
Dialogue: 0,0:12:22.29,0:12:28.00,Default,,0000,0000,0000,,انظري، هناك الكثير من صناديق الأثاث التي لم تُنقل بعد
Dialogue: 0,0:12:28.00,0:12:31.44,Default,,0000,0000,0000,,و لكن
Dialogue: 0,0:12:31.44,0:12:32.61,Default,,0000,0000,0000,,ما هذا!؟
Dialogue: 0,0:12:32.61,0:12:35.18,Default,,0000,0000,0000,,!مينا! مينا
Dialogue: 0,0:12:35.18,0:12:36.95,Default,,0000,0000,0000,,- عمي\N- حسناً
Dialogue: 0,0:12:36.95,0:12:38.36,Default,,0000,0000,0000,,أعلم أنك هناك
Dialogue: 0,0:12:38.36,0:12:40.52,Default,,0000,0000,0000,,ما الخطب!؟
Dialogue: 0,0:12:40.52,0:12:41.82,Default,,0000,0000,0000,,مينا
Dialogue: 0,0:12:43.52,0:12:47.46,Default,,0000,0000,0000,,{\a6\fry180}"الوداع"
Dialogue: 0,0:12:43.90,0:12:47.46,Default,,0000,0000,0000,,!مينا! مينا
Dialogue: 0,0:12:47.46,0:12:49.48,Default,,0000,0000,0000,,ما هذا!!؟
Dialogue: 0,0:12:55.48,0:12:58.06,Default,,0000,0000,0000,,أيعقل.. أن الباب مقفولٌ من الداخل؟
Dialogue: 0,0:12:58.06,0:13:01.50,Default,,0000,0000,0000,,كلا! ليس هناك أقفال على هذا الباب
Dialogue: 0,0:13:01.50,0:13:05.66,Default,,0000,0000,0000,,أعتقد أنها استعملت الأشرطة اللاصقة لتبقيه مغلقاً من الداخل
Dialogue: 0,0:13:07.68,0:13:10.62,Default,,0000,0000,0000,,حسناً! لنقم بخلع الباب
Dialogue: 0,0:13:10.62,0:13:12.68,Default,,0000,0000,0000,,جاهز، انطلق
Dialogue: 0,0:13:17.74,0:13:19.13,Default,,0000,0000,0000,,...مينا
Dialogue: 0,0:13:32.76,0:13:34.99,Default,,0000,0000,0000,,انتحار
Dialogue: 0,0:13:37.01,0:13:39.94,Default,,0000,0000,0000,,ران! الشرطة! استدعي الشرطة حالاً
Dialogue: 0,0:13:39.94,0:13:41.31,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:13:41.31,0:13:45.42,Default,,0000,0000,0000,,أختي.. هل ستعيش!؟؟
Dialogue: 0,0:13:45.42,0:13:47.96,Default,,0000,0000,0000,,أنا آسف.. و لكنها رحلت
Dialogue: 0,0:13:47.96,0:13:50.16,Default,,0000,0000,0000,,مستحيل
Dialogue: 0,0:13:50.16,0:13:55.57,Thoughts,,0000,0000,0000,,{\blur2}الباب و النافذة كلاهما كان مغلقاً بالأشرطة اللاصقة
Dialogue: 0,0:13:55.57,0:14:01.39,Thoughts,,0000,0000,0000,,{\blur2}ثم على أرضية الحمام، هناك زجاجتين مفتوحتين لأنواع مختلفة من منظفات الحمام
Dialogue: 0,0:14:01.39,0:14:03.99,Thoughts,,0000,0000,0000,,{\blur2}هل كان انتحار حقاً
Dialogue: 0,0:14:03.99,0:14:08.23,Thoughts,,0000,0000,0000,,{\blur2}و لكن الجروح التي على معصمها.. تزعجني بطريقةٍ ما
Dialogue: 0,0:14:12.11,0:14:18.69,Thoughts,,0000,0000,0000,,{\blur2}لا، هذا خطأ! هذا لم يكن انتحاراً! إنها جريمة قتل
Dialogue: 0,0:14:18.69,0:14:23.56,Thoughts,,0000,0000,0000,,{\blur2}و لكن في هذه الحالة، لا أستطيع فهم كيف تم فعل هذا
Dialogue: 0,0:14:23.56,0:14:27.51,Thoughts,,0000,0000,0000,,{\blur2}كيف قام القاتل بمغادرة الحمام
Dialogue: 0,0:14:27.51,0:14:34.21,Thoughts,,0000,0000,0000,,{\blur2}كيف يمكن لأحدٍ ما أن يغادر هذا المكان المغلق تماماً
Dialogue: 0,0:14:38.79,0:14:42.90,Default,,0000,0000,0000,,الضحية هي السيدة مينا اوشيما، عمرها ٢٤
Dialogue: 0,0:14:42.90,0:14:46.50,Default,,0000,0000,0000,,سبب الوفاة هو نزيف الدماء
Dialogue: 0,0:14:46.50,0:14:49.56,Default,,0000,0000,0000,,الذي نتج عن الجروح التي تعرضت لها في معصمها الأيسر
Dialogue: 0,0:14:49.56,0:14:54.84,Default,,0000,0000,0000,,و كان أنتِ، اختها، التي عثرت عليها، السيدة ماسايو؟
Dialogue: 0,0:14:54.84,0:14:56.47,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:14:56.47,0:15:01.45,Default,,0000,0000,0000,,و أيضاً، كنتم هنا في هذا المكان بالصدفة مجدداً كالعادة
Dialogue: 0,0:15:01.45,0:15:03.99,Default,,0000,0000,0000,,كنت أنا، موري كوغورو
Dialogue: 0,0:15:03.99,0:15:06.05,Default,,0000,0000,0000,,أيها المفتش ميغوري
Dialogue: 0,0:15:06.05,0:15:11.44,Default,,0000,0000,0000,,في الواقع، طلبت مني السيدة ماسايو أن أحضر السيدة مينا بسيارتي
Dialogue: 0,0:15:11.44,0:15:15.22,Default,,0000,0000,0000,,ذهبنا إلى الحمام و لاحظنا شيئاً غريباً
Dialogue: 0,0:15:15.22,0:15:20.69,Default,,0000,0000,0000,,و الذي كان هو الأشرطة اللاصقة الموجودة على الباب و النافذة
Dialogue: 0,0:15:20.69,0:15:26.60,Default,,0000,0000,0000,,نعم، كان هناك أشرطة بداخل المكان بأكمله، لذلك الغرفة كانت موصدة تماماً
Dialogue: 0,0:15:26.60,0:15:29.71,Default,,0000,0000,0000,,ليس هنا شك بأنه كان انتحاراً على أي حال
Dialogue: 0,0:15:29.71,0:15:33.85,Default,,0000,0000,0000,,و لكن، لماذا قد يقوم أحدٌ ما يجرح معصمه بقصد الإنتحار
Dialogue: 0,0:15:33.85,0:15:36.35,Default,,0000,0000,0000,,بقفل هذه الغرفة؟
Dialogue: 0,0:15:36.35,0:15:41.80,Default,,0000,0000,0000,,ربما لأن مزج منظفات تحتوي على الكلورين و الأسيد
Dialogue: 0,0:15:41.80,0:15:45.07,Default,,0000,0000,0000,,يقوم بإنتاج غاز الكلورين السام
Dialogue: 0,0:15:45.07,0:15:48.48,Default,,0000,0000,0000,,لذلك أغلقت الغرفة بحيث لا يتسرب الغاز للخارج
Dialogue: 0,0:15:48.48,0:15:52.69,Default,,0000,0000,0000,,و لكن يا موري، كلتا الزجاجتين مصنوعتين من الأسيد
Dialogue: 0,0:15:52.69,0:15:58.37,Default,,0000,0000,0000,,و أيضاً، غاز الكلورين ليس ساماً بما يكفي لكي تقوم بإغلاق الغرفة بسببه
Dialogue: 0,0:15:58.37,0:16:03.98,Default,,0000,0000,0000,,أيها المفتش، المتوفاة مينا لم تكن محترفة مثلنا بهذا
Dialogue: 0,0:16:03.98,0:16:06.99,Default,,0000,0000,0000,,لم تكن لتعرف مدى سمية غار الكلورين
Dialogue: 0,0:16:06.99,0:16:08.89,Default,,0000,0000,0000,,..و حتى
Dialogue: 0,0:16:08.89,0:16:14.96,Default,,0000,0000,0000,,أعتقد أنها كانت بحالة ارتباك شديدة قبل أن تقتل نفسها
Dialogue: 0,0:16:14.96,0:16:17.51,Default,,0000,0000,0000,,لذلك، هذا ما حصل باختصار
Dialogue: 0,0:16:17.51,0:16:22.08,Default,,0000,0000,0000,,لتنفذ الإنتحار، قامت بتجهيز نوعين مختلفين من منظفات الحمام
Dialogue: 0,0:16:22.08,0:16:24.62,Default,,0000,0000,0000,,و أغلقت الغرفة
Dialogue: 0,0:16:24.62,0:16:28.86,Default,,0000,0000,0000,,و لكن عندما حاولت إنتاج الغاز
Dialogue: 0,0:16:28.86,0:16:33.10,Default,,0000,0000,0000,,أدركت أنها اشترت المنظفات الغلط
Dialogue: 0,0:16:33.10,0:16:37.72,Default,,0000,0000,0000,,لذا مع عدم وجود خيارات اخرى، قامت بتقطيع معصمها بالسكين في هذه الغرفة
Dialogue: 0,0:16:37.72,0:16:42.42,Default,,0000,0000,0000,,و وضعت الجروح في الماء الدافئ لتقتل نفسها بسرعة
Dialogue: 0,0:16:42.42,0:16:47.87,Default,,0000,0000,0000,,أيها المفتش، انظر لهذا، وجدت هذه الفاتورة في غرفة الجلوس
Dialogue: 0,0:16:47.87,0:16:51.47,Default,,0000,0000,0000,,السيدة مينا اشترت منظفين للحمام و شريط لاصق
Dialogue: 0,0:16:51.47,0:16:54.70,Default,,0000,0000,0000,,اشترتها من المتجر البارحة
Dialogue: 0,0:16:55.61,0:16:59.62,Default,,0000,0000,0000,,إنه دليلٌ على أنها قررت الإنتحار و خططت لهذا
Dialogue: 0,0:16:59.62,0:17:01.19,Default,,0000,0000,0000,,تاغاكي
Dialogue: 0,0:17:01.19,0:17:02.09,Default,,0000,0000,0000,,حاضر سيدي
Dialogue: 0,0:17:02.09,0:17:04.40,Default,,0000,0000,0000,,تأكد من هذه عند متجر الحاجيّات
Dialogue: 0,0:17:04.40,0:17:05.89,Default,,0000,0000,0000,,عُلم
Dialogue: 0,0:17:08.54,0:17:13.25,Default,,0000,0000,0000,,و لفافة الشريط وُجدت في أرضية الحمام
Dialogue: 0,0:17:13.25,0:17:19.40,Default,,0000,0000,0000,,لذلك هذه الحالة تُعتبر مستعجلة بالأخذ بالاعتبار أنها خططت للإنتحار
Dialogue: 0,0:17:19.40,0:17:22.93,Default,,0000,0000,0000,,و لكنها كانت مستعجلة جداً تلك السيدة
Dialogue: 0,0:17:22.93,0:17:24.67,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:17:24.67,0:17:30.55,Default,,0000,0000,0000,,جروح معصم هذه السيدة قد تمت على عَجَل
Dialogue: 0,0:17:32.12,0:17:35.76,Default,,0000,0000,0000,,!بالفعل
Dialogue: 0,0:17:35.76,0:17:42.47,Default,,0000,0000,0000,,معظم جروح المعصم التي يرتكبها من يريد الإنتحار تكون مستقيمة
Dialogue: 0,0:17:42.47,0:17:45.81,Default,,0000,0000,0000,,إنه من النادر جداً القيام بجرحها بهذا الشكل
Dialogue: 0,0:17:45.81,0:17:47.49,Default,,0000,0000,0000,,بهذا الشكل يجب أن أقول
Dialogue: 0,0:17:47.49,0:17:50.12,Default,,0000,0000,0000,,لقد حصل الإنتحار بهذا الشكل اساساً
Dialogue: 0,0:17:50.12,0:17:54.83,Default,,0000,0000,0000,,هذا فقط يثبت كم أنها كانت متوترة في ذلك الوقت
Dialogue: 0,0:17:54.83,0:17:56.87,Thoughts,,0000,0000,0000,,{\blur2}يا رجل
Dialogue: 0,0:17:56.87,0:18:00.34,Default,,0000,0000,0000,,و لكن هل يمكن لشخصٍ مثلها أن يقوم بالتنظيف بعد هذا؟
Dialogue: 0,0:18:00.34,0:18:02.81,Default,,0000,0000,0000,,بالتنظيف!؟
Dialogue: 0,0:18:02.81,0:18:07.86,Default,,0000,0000,0000,,انظروا إلى هذه الدماء، توقفت فجأةً عند الحافة
Dialogue: 0,0:18:07.86,0:18:12.90,Default,,0000,0000,0000,,هذا يعني أنها قامت بتنظيف الدماء بعد أن بدأت بالنزيف صحيح؟
Dialogue: 0,0:18:12.90,0:18:17.38,Default,,0000,0000,0000,,غبي\Nكيف يمكن لأحدٍ يقوم بالإنتحار أن يفعل هكذا
Dialogue: 0,0:18:17.38,0:18:19.58,Default,,0000,0000,0000,,إذاً لماذا توقف الدم هنا فجأةً؟
Dialogue: 0,0:18:19.58,0:18:22.25,Default,,0000,0000,0000,,..حسناً.. باختصار
Dialogue: 0,0:18:22.25,0:18:28.40,Default,,0000,0000,0000,,..عندما تدفق الدم، كان هناك شيئاً ما هنا أو
Dialogue: 0,0:18:28.40,0:18:34.04,Default,,0000,0000,0000,,شخصاً ما كان بجانبها عندما قامت بجرح معصمها
Dialogue: 0,0:18:34.04,0:18:35.68,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:18:37.76,0:18:40.76,Default,,0000,0000,0000,,..أيها المفتش، أرغب بالقول أيضاً أنه ربما
Dialogue: 0,0:18:40.76,0:18:42.83,Default,,0000,0000,0000,,صحيح، ربما كانت جريمة قتل
Dialogue: 0,0:18:42.83,0:18:46.13,Default,,0000,0000,0000,,هل ممكن أنه كان الشريط؟
Dialogue: 0,0:18:46.13,0:18:50.31,Default,,0000,0000,0000,,الشريط كان في أرضية الحمام صحيح؟
Dialogue: 0,0:18:50.31,0:18:54.75,Default,,0000,0000,0000,,صحيح! إذا كانت لفافة الشريط على حافة الحوض
Dialogue: 0,0:18:54.75,0:18:59.66,Default,,0000,0000,0000,,و سقطت عندما قامت بجرح معصمها
Dialogue: 0,0:18:59.66,0:19:02.27,Default,,0000,0000,0000,,لقد أصبح كل شيءٍ واضحاً
Dialogue: 0,0:19:02.27,0:19:08.38,Default,,0000,0000,0000,,شكراً جزيلاً لك! ساعدتنا على حل غموض هذا
Dialogue: 0,0:19:08.38,0:19:09.68,Default,,0000,0000,0000,,..على الرحب
Dialogue: 0,0:19:12.19,0:19:14.02,Default,,0000,0000,0000,,مفتش ميغوري
Dialogue: 0,0:19:14.02,0:19:18.90,Default,,0000,0000,0000,,تظهر بصمات أصابع السيدة مينا فقط على الأشرطة
Dialogue: 0,0:19:18.90,0:19:25.24,Default,,0000,0000,0000,,البصمات الخاصة بالسبابة و الإبهام ظاهرين بوضوح
Dialogue: 0,0:19:25.24,0:19:26.48,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:19:26.48,0:19:32.73,Default,,0000,0000,0000,,لذلك نستطيع الإفتراض بأنها هذه ال"الوداع" كانت رسالة الموت خاصتها
Dialogue: 0,0:19:32.73,0:19:35.70,Default,,0000,0000,0000,,مما يعني أنه انتحار
Dialogue: 0,0:19:35.70,0:19:41.51,Default,,0000,0000,0000,,بالتأكيد كان كذلك! هذا الحمام كان مغلقاً تماماً
Dialogue: 0,0:19:43.21,0:19:46.89,Default,,0000,0000,0000,,اوه لا، لقد نسيت تماماً
Dialogue: 0,0:19:46.89,0:19:49.70,Default,,0000,0000,0000,,نسيت ماذا يا موري؟
Dialogue: 0,0:19:49.70,0:19:50.83,Default,,0000,0000,0000,,سيدة ماسايو
Dialogue: 0,0:19:50.83,0:19:52.43,Default,,0000,0000,0000,,نعم؟
Dialogue: 0,0:19:52.43,0:19:56.95,Default,,0000,0000,0000,,..حسبما أذكر، لقد قلتي لي من قبل مؤخراً
Dialogue: 0,0:19:56.95,0:19:59.58,Default,,0000,0000,0000,,مؤخراً؟
Dialogue: 0,0:19:59.58,0:20:04.66,Default,,0000,0000,0000,,!قلتي أني أستطيع أن آخذ التذكرة لحضور حفل يوكو الليلة
Dialogue: 0,0:20:05.26,0:20:08.57,Default,,0000,0000,0000,,انتظر يا أبي! هذا ليس الوقت المناسب لذلك
Dialogue: 0,0:20:08.57,0:20:15.48,Default,,0000,0000,0000,,لا يهم، إذا ذهبنا الآن، يمكننا على الأقل حضور اغنيتها الأخيرة
Dialogue: 0,0:20:15.48,0:20:20.82,Default,,0000,0000,0000,,سأذهب و أحضرها حالاً، أعتقد ان اختي وضعتهم جميعاً في غرفة الجلوس
Dialogue: 0,0:20:20.82,0:20:23.05,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:20:38.80,0:20:43.07,Default,,0000,0000,0000,,هذه الصناديق عليها آثار استعمال\Nهل وضعتيهم بجانب بعض من قبل؟
Dialogue: 0,0:20:43.07,0:20:50.75,Default,,0000,0000,0000,,نعم! لدي الكثير من الأشياء لأخذها لذلك قررت أخذهم لاحقاً
Dialogue: 0,0:20:50.75,0:20:56.39,Default,,0000,0000,0000,,صحيح! إذاً لهذا حصلتِ على مساعدة اختك حينها
Dialogue: 0,0:20:56.39,0:21:01.04,Default,,0000,0000,0000,,أعني، جميع حواف هذه الطاولة لاصقة
Dialogue: 0,0:21:01.04,0:21:05.64,Default,,0000,0000,0000,,يعني هذا أنها حصلت بسبب أشرطة لاصقة كانت عليها صحيح؟
Dialogue: 0,0:21:05.64,0:21:12.18,Default,,0000,0000,0000,,و وجود شخصاً ما يضع الأشرطة بهذا الشكل يسهّل من حزم الأمتعة صحيح؟
Dialogue: 0,0:21:13.33,0:21:15.36,Default,,0000,0000,0000,,كونان-كن أين أنت؟
Dialogue: 0,0:21:15.36,0:21:18.54,Default,,0000,0000,0000,,ذلك الطفل اللعين، دائماً في كل مرة
Dialogue: 0,0:21:18.54,0:21:20.11,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:21:20.11,0:21:23.18,Default,,0000,0000,0000,,أيها الفتى، إنّ اختك تناديك
Dialogue: 0,0:21:23.18,0:21:24.55,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:21:24.55,0:21:27.15,Default,,0000,0000,0000,,صحيح، سأذهب
Dialogue: 0,0:21:43.25,0:21:47.33,Default,,0000,0000,0000,,لا فائدة من إزالة آثار المادة اللاصقة
Dialogue: 0,0:21:47.33,0:21:53.47,Default,,0000,0000,0000,,معاون الشرطة لمسهم و أخذ صور لهم بعدما أخبرته بذلك
Dialogue: 0,0:21:53.47,0:21:55.14,Default,,0000,0000,0000,,ها أنت ذا
Dialogue: 0,0:21:55.14,0:21:56.99,Default,,0000,0000,0000,,آسفة جداً
Dialogue: 0,0:21:56.99,0:21:58.69,Default,,0000,0000,0000,,وداعاً يا سيدتي
Dialogue: 0,0:21:58.69,0:22:00.32,Default,,0000,0000,0000,,وداعاً
Dialogue: 0,0:22:00.32,0:22:03.88,Default,,0000,0000,0000,,كونان-كن كم مرةً أخبرتك أن لا تعبث بالمكان
Dialogue: 0,0:22:10.38,0:22:11.65,Default,,0000,0000,0000,,ليس هناك شك
Dialogue: 0,0:22:11.65,0:22:12.91,Default,,0000,0000,0000,,كونان
Dialogue: 0,0:22:12.91,0:22:18.20,Thoughts,,0000,0000,0000,,{\blur2}نعم، قاتل السيدة مينا كان السيدة ماسايو
Dialogue: 0,0:22:17.34,0:22:25.01,Default,,0000,0000,0000,,{\a6\fad(450,500)\fs24\c&HCFCFCF&}"الوداع"
Dialogue: 0,0:22:18.20,0:22:24.77,Thoughts,,0000,0000,0000,,{\blur2}و لكن ما لا أعرفه هو كيف أنها خرجت من الغرفة و هي مغلقة بأشرطة لاصقة
Dialogue: 0,0:22:24.77,0:22:33.05,Thoughts,,0000,0000,0000,,{\blur2}و أيضاً ما هذا الشعور الغريب الذي كان يدايقني معظم الوقت
Dialogue: 0,0:24:01.33,0:24:25.38,Default,,0000,0000,0000,,{\pos(134,100)\fnSegoe\fscx105\fs28\fsp1\shad0\bord0\alpha&H1F&}الحلقة القادمة
Dialogue: 0,0:24:04.99,0:24:08.20,Default,,0000,0000,0000,,لحظة، ما هذا؟؟
Dialogue: 0,0:24:08.20,0:24:10.94,Default,,0000,0000,0000,,هل من الممكن أن يكون هذا...؟
Dialogue: 0,0:24:10.94,0:24:17.76,Default,,0000,0000,0000,,نعم، السيدة مينا لم تنتحر، لقد تعرضت للقتل
Dialogue: 0,0:24:17.76,0:24:22.63,Default,,0000,0000,0000,,!من قِبلك، سيدة ماسايو، اختها الأكبر
Dialogue: 0,0:24:25.38,0:24:31.40,Default,,0000,0000,0000,,{\pos(316,123)\a2\fscx80\fscy80\fnDINk\c&HFFFFFF&\b0\fs36\bord0\shad0}جريمة قتل الحمّام المغلق
Dialogue: 0,0:24:25.38,0:24:31.40,Default,,0000,0000,0000,,{\pos(316,253)\a6\fscx80\fscy80\fnDINk\c&HFFFFFF&\b0\fs36\bord0\shad0}(الجزء الثاني)
Dialogue: 0,0:24:47.09,0:24:52.13,Default,,0000,0000,0000,,تلميح كونان القادم: وشاح
Dialogue: 0,0:24:52.13,0:24:58.02,Default,,0000,0000,0000,,{\pos(314,410)\1a&H1F&\fnSegoe\3c&H7F001F&\3a&H7F&\fscx100\bord2\shad0\fs28}تطلّعوا جميعاً إلى الحلقة القادمة
Dialogue: 0,0:24:52.13,0:24:53.12,Default,,0000,0000,0000,,{\a6}في المرة المقبلة، الجزء الثاني
Dialogue: 0,0:24:53.12,0:24:55.08,Default,,0000,0000,0000,,{\a6}أنت، خطيبها، من فعلت ذلك
Dialogue: 0,0:24:55.08,0:24:56.71,Default,,0000,0000,0000,,{\a6}كلا كانت السيدة ماسايو

