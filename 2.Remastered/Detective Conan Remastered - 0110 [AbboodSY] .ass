Dialogue: 0,0:00:00.63,0:00:04.14,Narration,,0,0,0,,المواقف التي تواجهها غامضة\N!و لكن العالم غامضٌ أكثر
Dialogue: 0,0:00:04.14,0:00:06.34,Narration,,0,0,0,,{\blur2.6}أنا سعيدٌ حقاً بأنني معك
Dialogue: 0,0:00:06.34,0:00:08.18,Narration,,0,0,0,,{\blur2.6}اليوم لدينا درس طبخ صارم
Dialogue: 0,0:00:08.18,0:00:10.36,Narration,,0,0,0,,{\blur2.6}ماذا لدينا على لائحة الطعام؟\Nقضية قتل أم حادثة؟
Dialogue: 0,0:00:10.36,0:00:12.15,Narration,,0,0,0,,{\blur2.6}يرى الحقيقة واحدة كما هي
Dialogue: 0,0:00:12.15,0:00:13.95,Narration,,0,0,0,,{\blur2.6}يبدو كطفل صغير و لكنه بعقل كبير
Dialogue: 0,0:00:13.95,0:00:16.20,Narration,NTP,0,0,0,0000,{\blur2.6} و اسمه هو، المحقق كونان
Dialogue: 0,0:01:51.05,0:01:56.82,Credits,,0,0,0,,{\fs122\pos(444,132)}جريمة قتل صف الطبخ
Dialogue: 0,0:01:51.05,0:01:56.82,Credits,,0,0,0,,{\fs60\pos(414,468)}الجزء الأول
Dialogue: 0,0:01:51.05,0:01:56.82,Default,,0,0,0,,{\pos(320,476)}(
Dialogue: 0,0:01:51.05,0:01:56.82,Default,,0,0,0,,{\pos(492,471)})
Dialogue: 0,0:02:01.85,0:02:03.57,Default,,0,0,0,,صفٌ للطبخ؟؟
Dialogue: 0,0:02:03.57,0:02:05.13,Default,,0,0,0,,نعم
Dialogue: 0,0:02:05.13,0:02:08.80,Default,,0,0,0,,هناك معلمة طبخ اسمها ميتشي يوموري تديره من خارج منزلها
Dialogue: 0,0:02:08.80,0:02:12.11,Default,,0,0,0,,سمعت بها من قبل\Nهيَ تُدّرس الطبخ الفرنسي صحيح؟
Dialogue: 0,0:02:12.11,0:02:17.82,Default,,0,0,0,,نعم، سألتني سونوكو إذا كنت أود الذهاب معها هذا الأحد
Dialogue: 0,0:02:21.96,0:02:23.37,Default,,0,0,0,,شكراً على الطعام
Dialogue: 0,0:02:24.44,0:02:30.48,Default,,0,0,0,,لطالما أردتّ دائماً تعلم الطهو الفرنسي، لذلك قلت لها أود الذهاب
Dialogue: 0,0:02:30.48,0:02:32.34,Default,,0,0,0,,متى يبدأ الدرس؟
Dialogue: 0,0:02:34.19,0:02:39.27,Default,,0,0,0,,يبدأ عند السادسة و النصف و ينتهي حوالي التاسعة و النصف
Dialogue: 0,0:02:39.27,0:02:41.13,Default,,0,0,0,,التاسعة و النصف!؟
Dialogue: 0,0:02:41.13,0:02:44.15,Default,,0,0,0,,انسي الأمر، إنه وقت متأخر جداً
Dialogue: 0,0:02:44.15,0:02:46.25,Default,,0,0,0,,و لكن المكان قريب جداً، في هايدو
Dialogue: 0,0:02:46.25,0:02:48.12,Default,,0,0,0,,ما زال لا يهمني
Dialogue: 0,0:02:48.12,0:02:51.42,Default,,0,0,0,,دعنا نذهب معها إذاً
Dialogue: 0,0:02:51.42,0:02:52.42,Default,,0,0,0,,ماذا؟؟
Dialogue: 0,0:02:52.42,0:02:58.39,Default,,0,0,0,,قد نتمكن من تناول طعام المعلمة الفرنسي اللذيذ مجاناً
Dialogue: 0,0:03:01.07,0:03:04.32,Default,,0,0,0,,..طعامٌ فرنسي لذيذ
Dialogue: 0,0:03:04.32,0:03:08.37,RMLyrics,,0,0,0,,{\p1\pos(698,446)}m 0 0 l -31 0 l -31 12 l 0 12{\p0}
Dialogue: 0,0:03:04.32,0:03:08.37,CharCard,,0,0,0,,{\fad(0,600)\fnAl-Jazeera-Arabic-Bold\fs80\b1\pos(404,544)}الأحد
Dialogue: 0,0:03:05.25,0:03:12.36,Default,,0,0,0,,شيءٌ ما مفاجئ حصل مع سونوكو لذلك لم تستطع المجيء
Dialogue: 0,0:03:12.36,0:03:17.58,Default,,0,0,0,,اسمعي يا ران، أنا لم آتي معك لأني أريد تناول الطعام الفرنسي
Dialogue: 0,0:03:17.58,0:03:19.55,Default,,0,0,0,,بل لأني فقط قلقٌ عليكي
Dialogue: 0,0:03:19.55,0:03:22.18,Default,,0,0,0,,نعم نعم أتَفهّم هذا
Dialogue: 0,0:03:22.18,0:03:24.39,Default,,0,0,0,,هل حقاً تتفهمين هذا؟
Dialogue: 0,0:03:26.53,0:03:29.20,Default,,0,0,0,,{\a6}"يوموري"
Dialogue: 0,0:03:29.90,0:03:31.06,Default,,0,0,0,,أبي! هذه هيَ
Dialogue: 0,0:03:40.85,0:03:42.42,Default,,0,0,0,,السيدة ران أليس كذلك؟
Dialogue: 0,0:03:42.42,0:03:43.80,Default,,0,0,0,,نعم
Dialogue: 0,0:03:43.80,0:03:45.27,Default,,0,0,0,,لقد أخبرونا بأنك ستأتين
Dialogue: 0,0:03:46.50,0:03:47.87,Default,,0,0,0,,تفضّلي
Dialogue: 0,0:03:47.87,0:03:49.77,Default,,0,0,0,,شكراً جزيلاً
Dialogue: 0,0:03:50.51,0:03:52.10,Default,,0,0,0,,تفضّل
Dialogue: 0,0:03:53.79,0:03:55.45,Default,,0,0,0,,شكراً
Dialogue: 0,0:03:56.26,0:03:59.72,TLLyrics,,0,0,0,,{\p1\pos(708,552)}m 0 0 l -31 0 l -31 12 l 0 12{\p0}
Dialogue: 0,0:03:56.26,0:03:59.72,CharCard,,0,0,0,,{\pos(406,536)}(يوكو كومياما (٢٣
Dialogue: 0,0:03:56.56,0:04:01.26,Default,,0,0,0,,أنا يوكو كومياما، مساعدة المعلمة
Dialogue: 0,0:04:01.26,0:04:07.14,Default,,0,0,0,,\Nالتي تجلس هناك هي طالبةٌ هنا\Nو زميلةٌ قديمة للمعلمة في الثانوية
Dialogue: 0,0:04:07.14,0:04:10.25,Default,,0,0,0,,و مالكةٌ لمتجر أزياء، السيدة كازي ياشيرو
Dialogue: 0,0:04:07.53,0:04:10.99,TLLyrics2,,0,0,0,,{\p1\pos(732,554)}m 0 0 l -31 0 l -31 12 l 0 12{\p0}
Dialogue: 0,0:04:07.53,0:04:10.99,CharCard,,0,0,0,,{\pos(410,536)}(كازي ياشيرو (٥٢
Dialogue: 0,0:04:10.25,0:04:11.88,Default,,0,0,0,,أهلاً بكم
Dialogue: 0,0:04:11.88,0:04:13.89,Default,,0,0,0,,نحن سعداء بلقائك
Dialogue: 0,0:04:13.89,0:04:17.06,Default,,0,0,0,,هذا هو أبي و كونان-كن
Dialogue: 0,0:04:17.06,0:04:21.27,Default,,0,0,0,,يا له من صفٍّ مدهش
Dialogue: 0,0:04:21.27,0:04:24.38,Default,,0,0,0,,هل هذه طاولات الطبخ؟
Dialogue: 0,0:04:24.38,0:04:27.98,Default,,0,0,0,,!يا له من فرن كبير
Dialogue: 0,0:04:27.98,0:04:30.75,Default,,0,0,0,,الأفران شيءٌ أساسي في الطبخ الفرنسي
Dialogue: 0,0:04:30.75,0:04:34.43,Default,,0,0,0,,و نستطيع تناول الطعام الذي تُعِدّونه على تلك الطاولة؟
Dialogue: 0,0:04:34.43,0:04:35.80,Default,,0,0,0,,نعم
Dialogue: 0,0:04:38.54,0:04:40.54,Default,,0,0,0,,إنه السيد نيشيتاني
Dialogue: 0,0:04:40.54,0:04:43.14,Default,,0,0,0,,مساء الخير، هيا لنبدأ بحصّةٍ أخرى رائعة
Dialogue: 0,0:04:48.86,0:04:50.15,Default,,0,0,0,,لقد نمت جيداً
Dialogue: 0,0:04:51.99,0:04:53.64,Default,,0,0,0,,دعيني أعّرفك عليهم
Dialogue: 0,0:04:53.64,0:04:57.74,Default,,0,0,0,,هذه السيدة ران، و التي ستحل مكان السيدة سونوكو الليلة
Dialogue: 0,0:04:57.74,0:05:00.51,Default,,0,0,0,,و هؤلاء والدها و كونان-كن
Dialogue: 0,0:05:00.51,0:05:02.38,Default,,0,0,0,,نتشرف بلقائكِ
Dialogue: 0,0:05:01.55,0:05:07.86,TLLyrics2,,0,0,0,,{\p1\pos(736,550)}m 0 0 l -31 0 l -31 12 l 0 12{\p0}
Dialogue: 0,0:05:01.55,0:05:07.86,CharCard,,0,0,0,,{\fs50\b1\pos(408,532)}(كاورا يوماري (٢٥
Dialogue: 0,0:05:02.38,0:05:04.46,Default,,0,0,0,,حسناً، حظاً جيداً
Dialogue: 0,0:05:04.46,0:05:08.30,Default,,0,0,0,,السيدة كاورا هي زوجة ابنها للمعلمة
Dialogue: 0,0:05:07.86,0:05:12.83,TLLyrics2,,0,0,0,,{\p1\pos(728,552)}m 0 0 l -31 0 l -31 12 l 0 12{\p0}
Dialogue: 0,0:05:07.86,0:05:12.83,CharCard,,0,0,0,,{\fs42\b1\pos(400,532)}(هيراوكي نيشيتاني (٢٩
Dialogue: 0,0:05:08.30,0:05:10.87,Default,,0,0,0,,أنا نيشيتاني، أتشرف بلقائكم
Dialogue: 0,0:05:10.87,0:05:13.65,Default,,0,0,0,,نيشيتاني طباخٌ فرنسي ماهر
Dialogue: 0,0:05:13.65,0:05:18.02,Default,,0,0,0,,سيدة كاورا، ما قصة حاجب العين الذي تضعينه؟
Dialogue: 0,0:05:18.02,0:05:20.99,Default,,0,0,0,,لدي جنجل
Dialogue: 0,0:05:21.79,0:05:25.53,Default,,0,0,0,,هل السيدة سونوكو بخير؟
Dialogue: 0,0:05:25.53,0:05:29.04,Default,,0,0,0,,لا، يبدو أنه حصل معها شيءٌ طارئ
Dialogue: 0,0:05:29.04,0:05:32.01,Default,,0,0,0,,من الطبيعي أنها أرادت التغيّب عن الحصة
Dialogue: 0,0:05:32.01,0:05:35.19,Default,,0,0,0,,كونها تتعرض للتوبيخ و الصراخ في كل مرة
Dialogue: 0,0:05:35.19,0:05:38.26,Default,,0,0,0,,يجب أن تكوني مستعدة بنفسك لهذا
Dialogue: 0,0:05:38.26,0:05:41.26,Default,,0,0,0,,\N!توقف عن إخافتها سيد كازي
Dialogue: 0,0:05:41.26,0:05:45.57,Default,,0,0,0,,لا تقلقي، لن تكوني الوحيدة التي ستصرخ عليها
Dialogue: 0,0:05:45.57,0:05:47.20,Default,,0,0,0,,حسناً
Dialogue: 0,0:05:47.91,0:05:51.38,Thoughts,,0,0,0,,{\blur2.6}تبدو السيدة يوموري صارمة حقاً
Dialogue: 0,0:05:51.38,0:05:58.63,Thoughts,,0,0,0,,{\blur2.6}فهمت، لهذا السبب تهرّبت سونوكو و استعملت ران كبديل لها
Dialogue: 0,0:05:58.63,0:06:01.22,Default,,0,0,0,,سيدة يوكو، سأساعدك
Dialogue: 0,0:06:02.30,0:06:06.82,Default,,0,0,0,,بالمناسبة، هل ذهبت السيدة يوموري إلى مكانٍ ما؟
Dialogue: 0,0:06:06.82,0:06:08.75,Default,,0,0,0,,نعم، إلى صالون التجميل
Dialogue: 0,0:06:09.82,0:06:12.83,Default,,0,0,0,,صالون التجميل؟
Dialogue: 0,0:06:12.83,0:06:14.63,Default,,0,0,0,,صالون التجميل!؟
Dialogue: 0,0:06:14.63,0:06:19.17,Default,,0,0,0,,أصبح كتاب الوصفات الفرنسية خاصتها الأكثر شراءً
Dialogue: 0,0:06:19.17,0:06:22.78,Default,,0,0,0,,و هناك حفلةٌ للإحتفال بهذا غداً
Dialogue: 0,0:06:22.78,0:06:25.12,Default,,0,0,0,,إنها حقاً غريبة
Dialogue: 0,0:06:25.12,0:06:28.62,Default,,0,0,0,,تجني الكثير من المال باستعمال أفكار الآخرين
Dialogue: 0,0:06:28.62,0:06:30.29,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:06:30.29,0:06:37.57,Default,,0,0,0,,ثلث الوصفات في كتابها من تأليفها، للسيدة يوكو
Dialogue: 0,0:06:41.15,0:06:45.13,Default,,0,0,0,,توقفي عن هذا سيد كازي، هذا لا يهم
Dialogue: 0,0:06:45.13,0:06:50.07,Default,,0,0,0,,!!ماذا؟ لم لا! أفكارك تتعرض للسرقة
Dialogue: 0,0:06:50.07,0:06:52.81,Default,,0,0,0,,أنتِ من أتى بهذه الوصفات أولاً
Dialogue: 0,0:06:52.81,0:06:56.44,Default,,0,0,0,,بينما كنتي تعملين هذه السنوات الخمس الماضية بمشقّة كمساعدة لِميتشي
Dialogue: 0,0:06:57.52,0:07:00.49,Default,,0,0,0,,و لكنها قدمت لي المساعدة
Dialogue: 0,0:07:00.49,0:07:05.17,Default,,0,0,0,,و ماذا إن ساعدتك قليلاً؟ \Nإنهم وصفاتك بوضوح
Dialogue: 0,0:07:05.17,0:07:09.37,Default,,0,0,0,,و مع هذا لا تزالين لا تشتكين! لابد أنك مجنونة
Dialogue: 0,0:07:09.37,0:07:11.84,Default,,0,0,0,,كفى سيدة كازي
Dialogue: 0,0:07:11.84,0:07:16.89,Default,,0,0,0,,هذا بين معلمتنا و السيدة يوكا، لا علاقة لنا بهم
Dialogue: 0,0:07:16.89,0:07:19.56,Default,,0,0,0,,أحقاً!؟
Dialogue: 0,0:07:19.56,0:07:21.13,Default,,0,0,0,,أعتقد أنك محق
Dialogue: 0,0:07:21.13,0:07:24.84,Default,,0,0,0,,ميتشي كانت تقدم لك الدعم المادي كل هذه السنوات
Dialogue: 0,0:07:24.84,0:07:28.08,Default,,0,0,0,,لذلك لا تستطيع قول أي شيء سيء عنها
Dialogue: 0,0:07:28.08,0:07:30.78,Default,,0,0,0,,ذلك الأمر لا علاقة له بما يحصل الآن
Dialogue: 0,0:07:30.78,0:07:35.26,Default,,0,0,0,,حقاً؟ أود أن أعرف كيف هما غير متعلقان ببعضهما
Dialogue: 0,0:07:35.26,0:07:36.63,Default,,0,0,0,,..حسناً
Dialogue: 0,0:07:42.78,0:07:47.65,Thoughts,,0,0,0,,{\blur2.6}يا رجل.. الأمور تزداد غرابةً هنا
Dialogue: 0,0:07:49.25,0:07:51.15,Default,,0,0,0,,لقد وصلت المعلمة
Dialogue: 0,0:07:59.30,0:08:01.41,Default,,0,0,0,,مرحباً بعودتك أيها المعلمة
Dialogue: 0,0:08:00.69,0:08:04.42,TLLyrics2,,0,0,0,,{\p1\pos(728,554)}m 0 0 l -31 0 l -31 12 l 0 12{\p0}
Dialogue: 0,0:08:00.69,0:08:04.42,CharCard,,0,0,0,,{\fad(0,500)\pos(404,536)}(ميتشي يوموري (٥٢
Dialogue: 0,0:08:01.41,0:08:05.72,Default,,0,0,0,,لقد عدت، يبدو أني تأخرت قليلاً
Dialogue: 0,0:08:05.72,0:08:07.42,Default,,0,0,0,,يجب أن تكوني السيدة ران
Dialogue: 0,0:08:07.42,0:08:10.16,Default,,0,0,0,,نعم! تشرفت بلقائك
Dialogue: 0,0:08:10.16,0:08:12.53,Default,,0,0,0,,..أنا والد ران! موري
Dialogue: 0,0:08:12.53,0:08:14.97,Default,,0,0,0,,أه، كتفاي يؤلماني
Dialogue: 0,0:08:14.97,0:08:16.55,Default,,0,0,0,,سيد نيشيتاني، لو سمحت
Dialogue: 0,0:08:16.55,0:08:17.18,Default,,0,0,0,,حسناً
Dialogue: 0,0:08:17.18,0:08:21.81,Default,,0,0,0,,...أنا موري
Dialogue: 0,0:08:21.81,0:08:25.63,Default,,0,0,0,,تفضلي الثوب الذي طلبتي مني تخييطه
Dialogue: 0,0:08:25.63,0:08:26.65,Default,,0,0,0,,نعم، ضعيه هناك
Dialogue: 0,0:08:29.03,0:08:30.97,Default,,0,0,0,,سيدة كاورو، تفقدي نبضات قلبي
Dialogue: 0,0:08:30.97,0:08:33.08,Default,,0,0,0,,حسناً
Dialogue: 0,0:08:33.08,0:08:36.58,Default,,0,0,0,,تباً ألا يمكنها قول شكراً لك حتى
Dialogue: 0,0:08:36.58,0:08:40.22,Default,,0,0,0,,هل هي بخير؟
Dialogue: 0,0:08:40.22,0:08:42.42,Default,,0,0,0,,إنها سمينة فقط
Dialogue: 0,0:08:42.42,0:08:45.97,Default,,0,0,0,,دائماً تتفقد نبضها هكذا بعد العودة من مكانٍ ما
Dialogue: 0,0:08:45.97,0:08:48.67,Default,,0,0,0,,كانت السيدة كاورو ممرضة
Dialogue: 0,0:08:48.67,0:08:51.54,Default,,0,0,0,,إنه سريع قليلاً و لكن جيد
Dialogue: 0,0:08:51.54,0:08:54.49,Default,,0,0,0,,ابنها رجل أعمال لامع
Dialogue: 0,0:08:54.49,0:08:58.92,Default,,0,0,0,,و لكنه كَبِر و كأنه طفل وحيد و تعرّض لعقدة نفسية سيئة في امه
Dialogue: 0,0:08:58.92,0:09:03.71,Default,,0,0,0,,السيدة كاورو تعرضت للقسوة كونها كنّة السيدة ميتشي
Dialogue: 0,0:09:03.71,0:09:08.41,Default,,0,0,0,,سمعت أن زوج المعلمة توفى بسبب مرضٍ ما
Dialogue: 0,0:09:08.41,0:09:10.91,Default,,0,0,0,,نعم
Dialogue: 0,0:09:10.91,0:09:14.09,Default,,0,0,0,,كان رجلاً جيداً و لطيفاً
Dialogue: 0,0:09:18.90,0:09:21.17,Default,,0,0,0,,هذا يكفي، سأذهب لتغيير ملابسي
Dialogue: 0,0:09:21.17,0:09:22.10,Default,,0,0,0,,حسناً
Dialogue: 0,0:09:25.78,0:09:27.68,Default,,0,0,0,,أريد الذهاب للحمام
Dialogue: 0,0:09:27.68,0:09:30.71,Default,,0,0,0,,سأذهب لأحضر المئزر
Dialogue: 0,0:09:35.03,0:09:36.57,Default,,0,0,0,,!توقف
Dialogue: 0,0:09:36.57,0:09:38.97,Default,,0,0,0,,ممنوع التدخين هنا
Dialogue: 0,0:09:38.97,0:09:42.88,Default,,0,0,0,,أنا آسفة و لكن ستضطّر للتدخين خارجاً
Dialogue: 0,0:09:42.88,0:09:44.39,Default,,0,0,0,,آسف
Dialogue: 0,0:09:44.39,0:09:46.79,Default,,0,0,0,,أين يقع الحمام؟
Dialogue: 0,0:09:46.79,0:09:51.69,Default,,0,0,0,,وراء ذلك الباب و إلى اليسار\Nهناك واحدٌ للرجال و واحدٌ للنساء
Dialogue: 0,0:09:51.69,0:09:54.51,Default,,0,0,0,,شكراً لك
Dialogue: 0,0:09:54.51,0:09:55.87,Default,,0,0,0,,أعتقد بأني سأذهب أيضاً
Dialogue: 0,0:10:03.12,0:10:06.12,Default,,0,0,0,,..سيدة يوكو أعلم ما قلته منذ قليل و لكنّي
Dialogue: 0,0:10:08.33,0:10:09.56,Default,,0,0,0,,!!سيدة ران
Dialogue: 0,0:10:09.56,0:10:13.48,Default,,0,0,0,,عفواً لقد أخطأت، بديتي لي مثلها
Dialogue: 0,0:10:45.94,0:10:48.38,Default,,0,0,0,,حسناً، لنبدأ
Dialogue: 0,0:10:48.38,0:10:52.05,Default,,0,0,0,,اليوم سنعِد حساء الفطور و البط بصلصة البرتقال
Dialogue: 0,0:10:52.05,0:10:55.76,Default,,0,0,0,,الحلويات ستكون فطيرة الإجاص
Dialogue: 0,0:10:55.76,0:11:00.00,Thoughts,,0,0,0,,{\blur2.6}ماذا؟ حقاً، ستطهين و انتي ترتدين الخاتم؟
Dialogue: 0,0:11:00.00,0:11:04.24,Thoughts,,0,0,0,,{\blur2.6}حتى و إن كنتي جيدة هذا ليس احترافياً جداً
Dialogue: 0,0:11:06.85,0:11:10.65,Thoughts,,0,0,0,,{\blur2.6}السيد نيشيتاني يرتدي خاتماً أيضاً؟
Dialogue: 0,0:11:10.65,0:11:14.87,Thoughts,,0,0,0,,{\blur2.6}أيفعل كل ما تفعله المعلمة
Dialogue: 0,0:11:14.87,0:11:20.97,Default,,0,0,0,,!يبدو هذا شهياً! البط؟ أحب البط
Dialogue: 0,0:11:20.97,0:11:22.04,Default,,0,0,0,,..سيدة يوكو
Dialogue: 0,0:11:22.04,0:11:24.38,Default,,0,0,0,,حسناً! أنا آسفة
Dialogue: 0,0:11:25.72,0:11:28.96,Default,,0,0,0,,ماذا!؟ ستغلقينه؟
Dialogue: 0,0:11:28.96,0:11:30.08,Default,,0,0,0,,ٱسفة
Dialogue: 0,0:11:31.66,0:11:32.90,Thoughts,,0,0,0,,{\blur2.6}تباً
Dialogue: 0,0:11:32.90,0:11:35.51,Default,,0,0,0,,...أبي
Dialogue: 0,0:11:35.51,0:11:38.68,Default,,0,0,0,,سنبدأ أولاً بحساء الفطر
Dialogue: 0,0:11:38.68,0:11:44.46,Default,,0,0,0,,سأعد القليل أولاً، لذلك راقبوني و اتبعو خطواتي
Dialogue: 0,0:11:44.46,0:11:49.23,Default,,0,0,0,,أولاً، نقطع عشرين غراماً من الشامبينيون
Dialogue: 0,0:11:49.23,0:11:52.00,Default,,0,0,0,,ما هو الشامبينيون؟
Dialogue: 0,0:11:52.00,0:11:54.48,Default,,0,0,0,,إنه الفطر
Dialogue: 0,0:11:54.48,0:11:56.97,Default,,0,0,0,,الآن نضعه بالزبدة
Dialogue: 0,0:11:58.25,0:12:02.45,Default,,0,0,0,,تأكدوا من جعلها تذوب جيداً
Dialogue: 0,0:12:03.56,0:12:05.87,Default,,0,0,0,,لقد بدأت تفوح رائحتها الزكية
Dialogue: 0,0:12:05.87,0:12:08.96,Default,,0,0,0,,و لكننا لن نتمكن من تناولها لوقت طويل
Dialogue: 0,0:12:12.41,0:12:15.65,Default,,0,0,0,,أنتِ جيدة بهذا
Dialogue: 0,0:12:15.65,0:12:16.92,Default,,0,0,0,,شكراً
Dialogue: 0,0:12:19.92,0:12:25.10,Default,,0,0,0,,أنتِ غير ملائمة أبداً، ما تزالين لم تتغيري أبداً
Dialogue: 0,0:12:27.34,0:12:31.61,Default,,0,0,0,,ما هذا!؟ لن تستطيع الآن الفصل بين البياض و الصفار
Dialogue: 0,0:12:31.61,0:12:33.79,Default,,0,0,0,,نحن سنستعمل البياض فقط
Dialogue: 0,0:12:33.79,0:12:37.20,Default,,0,0,0,,آسفة جداً، أستطيع الرؤية بعيني اليمين فقط لذلك من الصعب الانتباه
Dialogue: 0,0:12:37.20,0:12:39.20,Default,,0,0,0,,!بلا أعذار
Dialogue: 0,0:12:39.20,0:12:42.94,Default,,0,0,0,,سيدة يوكو! أنا لا أرى الجبنة السويسرية هنا
Dialogue: 0,0:12:42.94,0:12:46.05,Default,,0,0,0,,حسناً! آسفة! سأجلبها فوراً
Dialogue: 0,0:12:46.05,0:12:50.05,Default,,0,0,0,,حقاً لا أمَلَ فيكم أنتم الثلاثة
Dialogue: 0,0:12:50.05,0:12:52.93,Default,,0,0,0,,يالها من معلمة قاسية
Dialogue: 0,0:12:52.93,0:12:57.16,Thoughts,,0,0,0,,{\blur2.6}صحيح، لا ريب أن سونوكو تتجنبها
Dialogue: 0,0:13:03.02,0:13:06.79,Thoughts,,0,0,0,,{\blur2.6}السيد نيشيتاني ماهر بهذا، لذلك لن يمكنها قول شيء له
Dialogue: 0,0:13:06.79,0:13:09.79,Default,,0,0,0,,!!لا أستطيع التحمل أكثر من هذا
Dialogue: 0,0:13:09.79,0:13:11.99,Default,,0,0,0,,سأذهب لأدخن
Dialogue: 0,0:13:11.99,0:13:16.87,Default,,0,0,0,,انتظر لحظة، الطريق الوحيد للخارج هو عبر المطبخ
Dialogue: 0,0:13:16.87,0:13:20.14,Default,,0,0,0,,رأيت باباً خلفياً عند الحمامات
Dialogue: 0,0:13:29.06,0:13:31.93,Default,,0,0,0,,ماذا!؟ انه غير مقفل
Dialogue: 0,0:13:31.93,0:13:34.34,Default,,0,0,0,,يالهم من مهملين
Dialogue: 0,0:13:36.85,0:13:39.68,Default,,0,0,0,,ماذا حدث؟ انقطع التيار؟
Dialogue: 0,0:13:42.52,0:13:44.02,Default,,0,0,0,,من هناك؟؟
Dialogue: 0,0:13:49.09,0:13:52.10,Default,,0,0,0,,سيدة يوكو! اذهبي لغرفة الكهرباء و تفقدي القاطع
Dialogue: 0,0:13:52.10,0:13:53.06,Default,,0,0,0,,حسناً
Dialogue: 0,0:14:15.57,0:14:19.27,Default,,0,0,0,,\Nقل لي، هل سمعت صوت الباب السحاب يفتح؟
Dialogue: 0,0:14:19.27,0:14:20.64,Default,,0,0,0,,باب سحّاب؟
Dialogue: 0,0:14:20.64,0:14:21.88,Default,,0,0,0,,اعذرني
Dialogue: 0,0:14:22.89,0:14:24.89,Default,,0,0,0,,المعذرة، هل يمكنك أن تضيء لي؟
Dialogue: 0,0:14:24.89,0:14:26.38,Default,,0,0,0,,حسناً
Dialogue: 0,0:14:27.45,0:14:29.57,Default,,0,0,0,,{\a6}"غرفة الكهرباء"
Dialogue: 0,0:14:34.01,0:14:36.74,Default,,0,0,0,,هذا غريب، لماذا القاطع مغلق
Dialogue: 0,0:14:36.74,0:14:38.74,Default,,0,0,0,,سأشغّله
Dialogue: 0,0:14:41.79,0:14:43.78,Default,,0,0,0,,ثلج
Dialogue: 0,0:14:45.13,0:14:47.10,Default,,0,0,0,,لماذا موجودٌ هنا
Dialogue: 0,0:14:57.79,0:14:59.62,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:14:59.62,0:15:03.20,Default,,0,0,0,,عمي! أحدٌ ما هنا قام بتركيب خدعةٍ لقطع التيار
Dialogue: 0,0:15:03.20,0:15:04.17,Default,,0,0,0,,ماذا
Dialogue: 0,0:15:04.17,0:15:07.97,Default,,0,0,0,,هذا الوزن مربوط بالحلقة
Dialogue: 0,0:15:07.97,0:15:13.15,Default,,0,0,0,,قاموا بوضع الحلقة حول الزر، و الوزن على مكعب الثلج
Dialogue: 0,0:15:15.66,0:15:19.75,Default,,0,0,0,,بمعنى آخر، إن ذاب الثلج
Dialogue: 0,0:15:21.94,0:15:26.60,Default,,0,0,0,,ستُسحب الحلقة، و الزر سينزل و ينطفئ
Dialogue: 0,0:15:27.91,0:15:30.78,Default,,0,0,0,,و لكن من الذي أعدّ هذا؟
Dialogue: 0,0:15:31.89,0:15:35.36,Default,,0,0,0,,لنعد لغرفة الصف\Nشيئاً ما قد يكون حدث هناك
Dialogue: 0,0:15:35.36,0:15:36.95,Default,,0,0,0,,حسناً
Dialogue: 0,0:15:40.53,0:15:41.67,Default,,0,0,0,,أبي
Dialogue: 0,0:15:41.67,0:15:42.85,Default,,0,0,0,,ما الذي حدث!؟
Dialogue: 0,0:15:42.85,0:15:47.48,Default,,0,0,0,,إنها المعلمة! تقول أنّ صدرها يؤلمها و أنها تتنفس بصعوبة
Dialogue: 0,0:15:52.17,0:15:55.44,Default,,0,0,0,,من الذي فتح الباب السحّاب الأمامي؟
Dialogue: 0,0:15:55.44,0:15:57.67,Default,,0,0,0,,لا أحد
Dialogue: 0,0:15:57.67,0:15:59.16,Default,,0,0,0,,لا أحد!؟
Dialogue: 0,0:16:04.19,0:16:07.53,Default,,0,0,0,,ظهري يؤلمني
Dialogue: 0,0:16:07.53,0:16:12.54,Default,,0,0,0,,شعرت بألم ثاقب في ظهري عند انقطاع التيار
Dialogue: 0,0:16:12.54,0:16:14.81,Default,,0,0,0,,بالكاد أستطيع التنفس
Dialogue: 0,0:16:14.81,0:16:18.21,Default,,0,0,0,,هل أصابك شد عضلي؟؟
Dialogue: 0,0:16:18.21,0:16:21.05,Thoughts,,0,0,0,,{\blur2.6}بالكاد تستطيع التنفس!؟ أيعقل؟
Dialogue: 0,0:16:21.05,0:16:22.65,Default,,0,0,0,,دعيني أرى
Dialogue: 0,0:16:27.13,0:16:29.57,Default,,0,0,0,,ما هذا الذي تفعله!؟
Dialogue: 0,0:16:29.57,0:16:31.16,Default,,0,0,0,,كونان-كن!؟
Dialogue: 0,0:16:32.68,0:16:34.55,Thoughts,,0,0,0,,{\blur2.6}كما توقعت
Dialogue: 0,0:16:34.55,0:16:36.92,Default,,0,0,0,,لقد تعرضت للسعة نحلة
Dialogue: 0,0:16:36.92,0:16:37.81,Default,,0,0,0,,نحلة!؟
Dialogue: 0,0:16:37.81,0:16:39.35,Default,,0,0,0,,أترى؟ هنا
Dialogue: 0,0:16:39.35,0:16:41.34,Default,,0,0,0,,يوجد هنا نقطةٌ حمراء
Dialogue: 0,0:16:42.80,0:16:45.67,Default,,0,0,0,,تقع تماماً خلف الرئة اليمنى
Dialogue: 0,0:16:45.67,0:16:47.53,Default,,0,0,0,,رئتها اليمنى!؟
Dialogue: 0,0:16:48.34,0:16:50.11,Default,,0,0,0,,...هذا
Dialogue: 0,0:16:50.11,0:16:55.09,Default,,0,0,0,,ران! إتصلي بالإسعاف حالاً! و بالمفتش ميغوري أيضاً
Dialogue: 0,0:16:55.09,0:16:56.96,Default,,0,0,0,,حسناً
Dialogue: 0,0:16:56.96,0:16:59.86,Thoughts,,0,0,0,,{\blur2.6}عليها أن تدخل المشفى حالاً
Dialogue: 0,0:16:59.86,0:17:02.24,Thoughts,,0,0,0,,{\blur2.6}و لكن من الذي فعلها
Dialogue: 0,0:17:03.61,0:17:07.11,Default,,0,0,0,,يا جماعة رجاءاً أن لا يخرج أحد من هذا الصف
Dialogue: 0,0:17:07.11,0:17:09.91,Default,,0,0,0,,و لا تلمسوا الباب الأمامي أيضاً
Dialogue: 0,0:17:09.91,0:17:13.92,Default,,0,0,0,,من يعطيك الحق بإملاء الأوامر علينا!؟
Dialogue: 0,0:17:14.96,0:17:20.20,Default,,0,0,0,,أعتذر عن تقديم نفسي بوقتٍ متأخر\Nأنا المحقق موري كوغورو
Dialogue: 0,0:17:21.27,0:17:22.88,Default,,0,0,0,,..المحقق الشهير
Dialogue: 0,0:17:22.88,0:17:25.54,Default,,0,0,0,,موري كوغورو!؟
Dialogue: 0,0:17:28.82,0:17:32.43,Default,,0,0,0,,أيمكنك شرح ما الذي حصل هنا؟؟
Dialogue: 0,0:17:32.43,0:17:37.44,Default,,0,0,0,,أعتقد أن أحداً ما طعن السيدة ميتشي يوموري في ظهرها
Dialogue: 0,0:17:37.44,0:17:42.99,Default,,0,0,0,,بواسطة شيءٍ ذو حافةٍ حادة، مثل معوَل الثلج أو إبرة
Dialogue: 0,0:17:42.99,0:17:44.32,Default,,0,0,0,,ماذا قلت!؟
Dialogue: 0,0:17:44.32,0:17:45.64,Default,,0,0,0,,..لقد طُعنت
Dialogue: 0,0:17:45.64,0:17:47.09,Default,,0,0,0,,في الظهر!؟
Dialogue: 0,0:17:47.09,0:17:54.14,Default,,0,0,0,,نعم  كان هناك نقطةً حمراء على ظهرها، تبدو و كأنها لدغة حشرة
Dialogue: 0,0:17:54.14,0:17:59.51,Default,,0,0,0,,معولٌ للثلج أو شيءٍ مشابهٍ له يمكنه أن يترك هكذا أثر
Dialogue: 0,0:17:59.51,0:18:04.80,Default,,0,0,0,,و حتى أيضاً أثر طعنة معول الثلج لا يبدو مشابهاً لهذه الدرجة
Dialogue: 0,0:18:04.80,0:18:09.07,Default,,0,0,0,,يستطيعون أحياناً ثقب الرئتين و الأعضاء الداخلية الأخرى
Dialogue: 0,0:18:09.07,0:18:13.35,Default,,0,0,0,,إذاً السبب وراء إصابة صدرها و صعوبة تنفسها كان
Dialogue: 0,0:18:13.35,0:18:16.55,Default,,0,0,0,,أن يكون إحدى رئتيها تعرضت للثقب
Dialogue: 0,0:18:16.55,0:18:19.22,Default,,0,0,0,,إذاً، من فعل هذا؟
Dialogue: 0,0:18:19.22,0:18:25.10,Default,,0,0,0,,ران و الآخرون سمعوا صوت انزلاق الباب بوقتٍ قصير بعد انقطاع التيار
Dialogue: 0,0:18:25.10,0:18:28.11,Default,,0,0,0,,لذلك هناك شك كبير بأن الجاني قد دخل من الخارج
Dialogue: 0,0:18:28.11,0:18:28.84,Default,,0,0,0,,من الخارج!؟
Dialogue: 0,0:18:29.47,0:18:33.28,Default,,0,0,0,,و لكن هذا لا ينفي احتمالية ان يكون الجاني من الداخل
Dialogue: 0,0:18:34.32,0:18:35.89,Default,,0,0,0,,فهمت هذا
Dialogue: 0,0:18:35.89,0:18:38.93,Default,,0,0,0,,يجب علي أن أطلب منكم عدم مغادرة هذه الغرفة
Dialogue: 0,0:18:38.93,0:18:41.91,Default,,0,0,0,,سوف نتفقد بصمات الأصابع على الباب أولاً
Dialogue: 0,0:18:41.91,0:18:45.48,Default,,0,0,0,,من كان آخر من لمس مقبض الباب؟
Dialogue: 0,0:18:45.48,0:18:47.38,Default,,0,0,0,,لقد كان السيد نيشيتاني
Dialogue: 0,0:18:47.38,0:18:51.22,Default,,0,0,0,,كان آخر من وصل إلى هنا
Dialogue: 0,0:18:51.22,0:18:57.23,Default,,0,0,0,,و عندما وصلت المعلمة يوموري، كان هو من فتح لها الباب من الداخل
Dialogue: 0,0:18:57.23,0:19:00.23,Default,,0,0,0,,إذاً سنحتاج لأخذ بصماتكم
Dialogue: 0,0:19:00.23,0:19:03.71,Default,,0,0,0,,لنستطيع تمييزها عن بصمات يد الجاني
Dialogue: 0,0:19:03.71,0:19:06.08,Default,,0,0,0,,أخبرني عن الذي حصل معك بعدها
Dialogue: 0,0:19:06.08,0:19:07.35,Default,,0,0,0,,حسناً
Dialogue: 0,0:19:09.42,0:19:13.20,Default,,0,0,0,,إذاً، الباب الخلفي هذا كان مفتوحاً؟
Dialogue: 0,0:19:13.20,0:19:14.87,Default,,0,0,0,,نعم أيها المفتش
Dialogue: 0,0:19:14.87,0:19:21.68,Default,,0,0,0,,أعتقد أن الجاني تسلل إلى غرفة الكهرباء عن طريق الباب الخلفي
Dialogue: 0,0:19:21.68,0:19:25.32,Default,,0,0,0,,ثم أعدّ خدعة الثلج
Dialogue: 0,0:19:25.32,0:19:29.16,Default,,0,0,0,,ثم ذهب الجاني إلى الباب الأمامي
Dialogue: 0,0:19:29.16,0:19:34.47,Default,,0,0,0,,و اختبئ بين الشجيرات في الحديقة منتظراً انقطاع التيار
Dialogue: 0,0:19:34.47,0:19:39.75,Default,,0,0,0,,و فور انقاطع التيار فتح الباب و تسلل إلى الصف
Dialogue: 0,0:19:39.75,0:19:42.36,Default,,0,0,0,,ثم قام بطعن السيدة يوموري و هرب
Dialogue: 0,0:19:42.36,0:19:45.90,Default,,0,0,0,,و لكن غرفة الصف كانت مظلمة جداً
Dialogue: 0,0:19:45.90,0:19:49.40,Default,,0,0,0,,كيف استطاع الجاني أن يجدها؟
Dialogue: 0,0:19:49.40,0:19:51.23,Default,,0,0,0,,..آه حسناً
Dialogue: 0,0:19:51.23,0:19:55.98,Default,,0,0,0,,كانت ترتدي شيئاً مضيئاً، أو شيئاً ما جعلها تصبح واضحة له
Dialogue: 0,0:19:55.98,0:19:57.95,Default,,0,0,0,,كلا
Dialogue: 0,0:19:57.95,0:20:01.05,Default,,0,0,0,,لم تكن ترتدي أي شي كهذا
Dialogue: 0,0:20:01.05,0:20:03.57,Default,,0,0,0,,لا أعتقد أنها كانت كذلك أيضاً
Dialogue: 0,0:20:03.57,0:20:07.74,Default,,0,0,0,,إذاً لابد أن الجاني استعمل جهاز كشف الأشعة تحت الحمراء او شيءٌ كهذا
Dialogue: 0,0:20:07.74,0:20:10.34,Default,,0,0,0,,هذا سيجعله يرى في الظلام
Dialogue: 0,0:20:10.34,0:20:11.17,Default,,0,0,0,,صحيح
Dialogue: 0,0:20:11.17,0:20:18.42,Thoughts,,0,0,0,,{\blur2.6}هل تمزح معي؟ ليس من السهل أبداً الحصول على جهاز كشف الأشعة تحت الحمراء
Dialogue: 0,0:20:20.16,0:20:25.04,Thoughts,,0,0,0,,{\blur2.6}بالمناسبة، قال العجوز أن الجاني قد يكون من الخارج
Dialogue: 0,0:20:25.04,0:20:29.10,Thoughts,,0,0,0,,{\blur2.6}و لكنه أمر غريب أنه لم يكن هناك طبعات أحذية على الأرض
Dialogue: 0,0:20:31.83,0:20:35.43,Thoughts,,0,0,0,,{\blur2.6}هل قام الجاني حقاً بخلع حذائه قبل أن يدخل!؟
Dialogue: 0,0:20:35.43,0:20:36.86,Thoughts,,0,0,0,,{\blur2.6}هذا هراء
Dialogue: 0,0:20:36.86,0:20:38.73,Default,,0,0,0,,حسناً!؟
Dialogue: 0,0:20:38.73,0:20:47.28,Default,,0,0,0,,حسناً، بصمات السيد نيشيتاني فقط كانت على كلتا مقابض الباب
Dialogue: 0,0:20:47.28,0:20:50.39,Default,,0,0,0,,الجاني على الأغلب كان يرتدي قفازات
Dialogue: 0,0:20:50.39,0:20:55.70,Default,,0,0,0,,و السيد نيشيتاني آخر من لمس الباب، لذلك هذا يضعه تحت الشبهة
Dialogue: 0,0:20:55.70,0:20:56.60,Default,,0,0,0,,نعم
Dialogue: 0,0:20:56.60,0:21:01.41,Default,,0,0,0,,و لكن العجيب بالأمر أن البصمات موجودة بالكامل على المقبض الخارجي
Dialogue: 0,0:21:01.41,0:21:04.69,Default,,0,0,0,,بينما بصمات المقبض الداخلي بطريقةٍ ما قد أُزيلت
Dialogue: 0,0:21:04.69,0:21:06.18,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:21:07.69,0:21:09.86,Default,,0,0,0,,!!هذا ليس صحيح
Dialogue: 0,0:21:09.86,0:21:13.71,Default,,0,0,0,,إذا فتح الجاني الباب من الخارج
Dialogue: 0,0:21:13.71,0:21:17.81,Default,,0,0,0,,يجب أن تكون بصمات السيد نيشيتاني على المقبض الخارجي قد أُزيلت
Dialogue: 0,0:21:17.81,0:21:21.45,Default,,0,0,0,,..حقيقة أن بصمات المقبض الداخلي قد أُزيلت
Dialogue: 0,0:21:21.45,0:21:25.16,Thoughts,,0,0,0,,{\blur2.6}تعني أن الجاني فتح الباب من الداخل
Dialogue: 0,0:21:25.16,0:21:27.80,Default,,0,0,0,,ماذا؟ إلى ماذا تريد أن تصل!؟
Dialogue: 0,0:21:27.80,0:21:31.10,Default,,0,0,0,,الجاني لم يدخل من الخارج
Dialogue: 0,0:21:31.10,0:21:37.48,Default,,0,0,0,,أحدٌ ما بداخل الغرفة فتحه من الداخل لِكي يربكنا
Dialogue: 0,0:21:37.48,0:21:41.66,Default,,0,0,0,,استعمل الجاني منديلاً أو شيءٌ كهذا ليفتحه دون أثر
Dialogue: 0,0:21:41.66,0:21:46.53,Default,,0,0,0,,بمعنى آخر، أحدٌ ما منكم أنتم الأربعة فعلها
Dialogue: 0,0:21:48.44,0:21:50.20,Default,,0,0,0,,!!مستحيل
Dialogue: 0,0:21:54.65,0:21:56.86,Default,,0,0,0,,إنه أنا
Dialogue: 0,0:21:56.86,0:21:58.76,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:21:58.76,0:22:00.23,Default,,0,0,0,,حسناً
Dialogue: 0,0:22:01.84,0:22:04.57,Default,,0,0,0,,لقد توفت السيدة يوموري نتيجةً لفشل التنفس
Dialogue: 0,0:22:04.57,0:22:06.91,Default,,0,0,0,,بسبب رئةٍ مثقوبة
Dialogue: 0,0:22:14.36,0:22:18.53,Default,NTP,0,0,0,0000,هذا يعني أن القضية أصبحت الآن جريمة قتل
Dialogue: 0,0:24:01.30,0:24:25.35,Flashback,,0,0,0,,{\pos(162,128)}الحلقة القادمة
Dialogue: 0,0:24:01.85,0:24:04.18,Default,,0,0,0,,!أنتي من قتلتيها، سيدة كازي
Dialogue: 0,0:24:06.32,0:24:14.07,Default,,0,0,0,,سيد نيشيتاني، سمعت أنها كانت تريد أن تنهي دعمها المادي لك
Dialogue: 0,0:24:14.07,0:24:20.24,Default,,0,0,0,,سيدة يوكو، لقد ملكك الحقد تجاهها لأنها كانت تسرق وصفاتك
Dialogue: 0,0:24:20.24,0:24:22.15,Default,,0,0,0,,!لقد فهمت الآن
Dialogue: 0,0:24:22.15,0:24:24.64,Default,,0,0,0,,!أنتي من قتلتيها، سيدة كاورو
Dialogue: 0,0:24:25.35,0:24:31.28,Credits,,0,0,0,,{\fs80\pos(422,150)\c&HDFEBF6&}جريمة قتل صف الطبخ
Dialogue: 0,0:24:25.35,0:24:31.28,Credits,,0,0,0,,{\fs40\pos(404,366)\c&HDFEBF6&}الجزء الثاني
Dialogue: 0,0:24:25.35,0:24:31.28,Default,,0,0,0,,{\pos(468,376)\c&HDFEBF6&})
Dialogue: 0,0:24:25.35,0:24:31.28,Default,,0,0,0,,{\pos(330,380)\c&HDFEBF6&}(
Dialogue: 0,0:24:48.57,0:24:53.59,RMLyrics2,,0,0,0,,{\pos(384,534)}تلميح كونان القادم
Dialogue: 0,0:24:48.57,0:24:53.59,RMLyrics2,,0,0,0,,{\pos(536,332)\c&H5C98C0&}خاتم
Dialogue: 0,0:24:53.89,0:24:55.66,Default,,0,0,0,,{\a6}في المرة القادمة سأعرف من فعلها
Dialogue: 0,0:24:55.66,0:24:57.66,Default,,0,0,0,,{\a6}..اقتحم الجاني المنزل منذ البداية

