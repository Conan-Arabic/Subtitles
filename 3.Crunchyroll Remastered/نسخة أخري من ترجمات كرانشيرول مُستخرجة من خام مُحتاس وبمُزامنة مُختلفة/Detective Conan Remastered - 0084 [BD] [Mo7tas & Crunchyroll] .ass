Dialogue: 0,0:00:02.34,0:00:04.09,Default,,0000,0000,0000,,عقرب دقائق مسرِع، اتّصالات منفصلة
Dialogue: 0,0:00:04.09,0:00:07.04,Default,,0000,0000,0000,,تُعالج استنتاجات كونان القلوب\Nالمُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.75,0:00:10.53,Default,,0000,0000,0000,,!حلّ موسم التزلّج! احترسوا من الجرائم الباردة
Dialogue: 0,0:00:11.00,0:00:12.58,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.58,0:00:14.46,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:15.00,0:00:16.54,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.33,0:01:57.21,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل نزل التزلّج\N(الجزء الأوّل)
Dialogue: 0,0:01:52.19,0:01:55.79,Default,,0000,0000,0000,,جريمة قتل نزل التزلّج\Nالجزء الأوّل
Dialogue: 0,0:01:57.51,0:01:59.41,Default,,0000,0000,0000,,...الشتاء! والجبال الثلجية تعني
Dialogue: 0,0:01:59.76,0:02:01.81,Default,,0000,0000,0000,,!أنّه وقت التزلّج
Dialogue: 0,0:02:03.47,0:02:05.89,Default,,0000,0000,0000,,!ورحلة بحثي عن شبّان التي طال انتظارها
Dialogue: 0,0:02:05.89,0:02:09.63,Default,,0000,0000,0000,,مع ذلك، عدد الشبّان في المنحدر\Nلا يتجاوز خمسة إلى ستّة
Dialogue: 0,0:02:09.63,0:02:11.80,Default,,0000,0000,0000,,وكلّهم مع رفيقاتهم أيضاً
Dialogue: 0,0:02:11.80,0:02:14.61,Default,,0000,0000,0000,,أجل، عدد المتزلجين قليل حقّاً
Dialogue: 0,0:02:14.61,0:02:18.07,Default,,0000,0000,0000,,والفتى الوحيد الأعزب هنا هو كونان-كن
Dialogue: 0,0:02:18.37,0:02:19.89,Default,,0000,0000,0000,,...نعم، نعم
Dialogue: 0,0:02:20.20,0:02:22.37,Default,,0000,0000,0000,,أين المشكلة؟ لنستمتع بالتزلّج فحسب
Dialogue: 0,0:02:22.37,0:02:25.54,Default,,0000,0000,0000,,يا لحظّك، لديك شينتشي-كن بالفعل
Dialogue: 0,0:02:26.70,0:02:30.81,Default,,0000,0000,0000,,أنا بذلتُ قصارى جهدي\Nفي السبعة عشر عاماً الفائتة
Dialogue: 0,0:02:31.36,0:02:33.73,Default,,0000,0000,0000,,لكن لم يحصل لي أيّ أمرٍ حسن
Dialogue: 0,0:02:34.28,0:02:35.69,Default,,0000,0000,0000,,...سونوكو
Dialogue: 0,0:02:36.61,0:02:39.43,Default,,0000,0000,0000,,!لذا، سيكون الغداء على حسابك
Dialogue: 0,0:02:43.73,0:02:45.81,Default,,0000,0000,0000,,!مرحباً أيّتها الهرّتان الظريفتان
Dialogue: 0,0:02:47.52,0:02:49.68,Default,,0000,0000,0000,,هل تريدان التزلّج معنا؟
Dialogue: 0,0:02:49.68,0:02:51.26,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:02:51.39,0:02:53.27,Default,,0000,0000,0000,,هرّتان؟
Dialogue: 0,0:02:53.63,0:02:56.81,Default,,0000,0000,0000,,نحن أستاذا تزلّج، صحيح؟
Dialogue: 0,0:02:56.96,0:02:58.20,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:58.20,0:02:59.22,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:02:59.58,0:03:02.19,Default,,0000,0000,0000,,ماذا؟ أليست موري-سان وسوزوكي-سان؟
Dialogue: 0,0:03:02.50,0:03:04.36,Default,,0000,0000,0000,,!إنّهما أنتما فعلاً! تسرّني رؤيتكما مجدداً
Dialogue: 0,0:03:04.36,0:03:06.08,Default,,0000,0000,0000,,!يونيهارا سينسي
Dialogue: 0,0:03:06.08,0:03:08.52,Default,,0000,0000,0000,,ماذا؟ أتعرفينهما يا يونيهارا سينسي؟
Dialogue: 0,0:03:08.99,0:03:12.98,Default,,0000,0000,0000,,نعم، كانتا طالبتين لي عندما\Nكنتُ أدرّس في ابتدائية تيتان
Dialogue: 0,0:03:12.98,0:03:15.90,Default,,0000,0000,0000,,صحيح، أتذكّر معلمة مثلها
Dialogue: 0,0:03:16.32,0:03:18.98,Default,,0000,0000,0000,,!لكنّكما أصبحتما امرأتين ناضجتين حقّاً
Dialogue: 0,0:03:18.98,0:03:22.35,Default,,0000,0000,0000,,وأنتِ لا تزالين بديعة المظهر\Nكعادتكِ يا سينسي بشعرك الطويل
Dialogue: 0,0:03:22.60,0:03:24.48,On Top,,0000,0000,0000,,ماذا؟ شعري فحسب؟
Dialogue: 0,0:03:22.84,0:03:28.56,CharCard,,0160,0000,0003,,{\fad(300,300)}(يونيهارا أكيكو (30\Nمعلّمة في ابتدائية هايدو
Dialogue: 0,0:03:24.48,0:03:28.28,On Top,,0000,0000,0000,,إنّه كشعرة تتمسك بها امرأة وصلت\N!سنّ الثلاثين ولم تتزوّج بعد حرفياً
Dialogue: 0,0:03:28.55,0:03:29.60,On Top,,0000,0000,0000,,!صمتاً
Dialogue: 0,0:03:30.80,0:03:35.22,Default,,0000,0000,0000,,لكن يوجد لديك هذين الأستاذين الرائعين
Dialogue: 0,0:03:36.22,0:03:37.48,Default,,0000,0000,0000,,أستاذين؟
Dialogue: 0,0:03:38.87,0:03:41.04,Default,,0000,0000,0000,,أستاذين إذاً؟
Dialogue: 0,0:03:41.39,0:03:43.85,Default,,0000,0000,0000,,ماذا؟ معلّمي ابتدائية؟
Dialogue: 0,0:03:44.50,0:03:48.82,Default,,0000,0000,0000,,أي تعملان مع يونيهارا سينسي في ابتدائيّة هايدو\Nالتي انتقلت لها؟
Dialogue: 0,0:03:48.95,0:03:51.69,Default,,0000,0000,0000,,صحيح، إنّهما زميلان لي
Dialogue: 0,0:03:52.18,0:03:55.38,CharCard,,0000,0210,0004,,{\fad(300,300)}(شيمودا كوهي (30 \Nمعلّم في ابتدائية هايدو
Dialogue: 0,0:03:52.32,0:03:55.70,On Top,,0000,0000,0000,,المعلّم المسؤول عن الفصل الأول\N...للصفّ الخامس، شيمودا سينسي
Dialogue: 0,0:03:55.70,0:03:58.44,On Top,,0000,0000,0000,,ومعلّم التربية البدنية للفتيان، ساكاي سينسي
Dialogue: 0,0:03:57.17,0:04:00.64,CharCard,,0000,0090,0004,,{\fad(300,0)}(ساكاي ريويتشي (29\Nمعلّم تربية رياضية في ابتدائية هايدو
Dialogue: 0,0:03:58.98,0:04:00.64,On Top,,0000,0000,0000,,!سـ-سررت بلقائكما
Dialogue: 0,0:04:01.19,0:04:05.61,On Top,,0000,0000,0000,,لكن تقرّب معلّمي مدرسة ابتدائية\N...من طالبتين في الثانوية
Dialogue: 0,0:04:01.19,0:04:05.61,CharCard,,0000,0000,0004,,{\fad(300,300)}(ناكامورا مينوري (27\Nممرضة في ابتدائية هايدو
Dialogue: 0,0:04:05.94,0:04:08.31,Default,,0000,0000,0000,,!لا تزالان مفعمين بالشباب
Dialogue: 0,0:04:08.68,0:04:11.63,Default,,0000,0000,0000,,لكن لا أحد يستعمل "هرّة" هذه الأيام
Dialogue: 0,0:04:13.76,0:04:16.76,Default,,0000,0000,0000,,ماذا حدث لسوغياما سينسي يا ترى؟ لقد تأخّر
Dialogue: 0,0:04:16.76,0:04:17.98,Default,,0000,0000,0000,,سوغياما سينسي؟
Dialogue: 0,0:04:18.58,0:04:21.33,Default,,0000,0000,0000,,معلّم موسيقى أتى رفقتنا
Dialogue: 0,0:04:21.33,0:04:25.19,Default,,0000,0000,0000,,اتّفقنا على الالتقاء هنا عند الثانية، لكنّه تأخّر كثيراً
Dialogue: 0,0:04:25.58,0:04:29.74,Default,,0000,0000,0000,,أتعتقدون أنّه سبقنا للنزل\Nالذي سنمكث فيه
Dialogue: 0,0:04:29.74,0:04:31.48,Default,,0000,0000,0000,,كي يخيفنا؟
Dialogue: 0,0:04:31.82,0:04:35.19,Default,,0000,0000,0000,,ذلك مُحتمل، فسوغياما سينسي يهوى هذه المقالب
Dialogue: 0,0:04:35.78,0:04:38.48,Default,,0000,0000,0000,,ما رأيكما؟ هل تريدان مرافقتنا للنزل أيضاً؟
Dialogue: 0,0:04:39.44,0:04:40.77,Default,,0000,0000,0000,,أيمكننا؟
Dialogue: 0,0:04:40.77,0:04:43.40,Default,,0000,0000,0000,,!انتبه، لا تستدرج تلميذتيّ
Dialogue: 0,0:04:43.47,0:04:48.34,Default,,0000,0000,0000,,لا تقلقي! سنقلّهما بالسيّارة قبل مغادرة\Nحافلة التزلّج التي سترجعهما
Dialogue: 0,0:04:49.64,0:04:52.52,Default,,0000,0000,0000,,أأنت متأكّد أنه هذا الطريق؟
Dialogue: 0,0:04:53.89,0:04:54.90,Default,,0000,0000,0000,,سيّارة
Dialogue: 0,0:04:54.90,0:04:55.98,Default,,0000,0000,0000,,من أهل المنطقة؟
Dialogue: 0,0:04:59.00,0:05:02.23,Default,,0000,0000,0000,,المعذرة! يُفترض أنّ هناك\Nنزلاً في هذه الأرجاء
Dialogue: 0,0:05:02.23,0:05:05.88,Default,,0000,0000,0000,,نعم، يوجد نُزل واحد في منتصف الطريق\Nعلى ذاك الجبل
Dialogue: 0,0:05:05.88,0:05:08.37,Default,,0000,0000,0000,,لكن لا تخبرني أنّك تريد الذهاب هناك
Dialogue: 0,0:05:08.37,0:05:09.06,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:05:09.06,0:05:10.62,Default,,0000,0000,0000,,أنصحك ألّا تفعل
Dialogue: 0,0:05:10.62,0:05:14.02,Default,,0000,0000,0000,,تهبّ عواصف شديدة في هذه المنطقة كلّ مساء
Dialogue: 0,0:05:14.37,0:05:16.61,Default,,0000,0000,0000,,إذا أردت الرجوع فالآن فرصتك
Dialogue: 0,0:05:17.87,0:05:19.56,Default,,0000,0000,0000,,هل نرجع؟
Dialogue: 0,0:05:19.56,0:05:22.61,Default,,0000,0000,0000,,لكل لعلّ سوغياما سينسي ينتظرنا
Dialogue: 0,0:05:22.61,0:05:25.44,Default,,0000,0000,0000,,يا إلهي... من حجز في هذا المكان؟
Dialogue: 0,0:05:26.02,0:05:29.26,Default,,0000,0000,0000,,ماذا؟ ظننتُ أنّك من فعل
Dialogue: 0,0:05:29.26,0:05:31.93,Default,,0000,0000,0000,,كلا، ألم يكن أنت يا ساكاي سينسي؟
Dialogue: 0,0:05:31.93,0:05:33.14,Default,,0000,0000,0000,,لا
Dialogue: 0,0:05:33.14,0:05:34.65,Default,,0000,0000,0000,,أكانت أنت يا يونيهارا سينسي إذاً؟
Dialogue: 0,0:05:34.79,0:05:44.04,Radio,,0000,0000,15,,رحلة تزلّج ليومين وليلة، الواحد والعشرون من ديسمبر
Dialogue: 0,0:05:34.97,0:05:36.35,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:05:36.35,0:05:42.13,Default,,0000,0000,0000,,اتّبعتُ ما كان في الورقة التي وجدتُها\Nعلى مكتبي قبل أسبوعين لا أكثر
Dialogue: 0,0:05:42.13,0:05:43.90,Default,,0000,0000,0000,,واخترتُ أنّي سأشارك
Dialogue: 0,0:05:44.54,0:05:49.35,Default,,0000,0000,0000,,كنتِ من تنظّم رحلاتنا عادةً، فظننت أنّكِ من وضعتها
Dialogue: 0,0:05:49.83,0:05:54.61,Default,,0000,0000,0000,,كلا، كما أنّي وجدتُ ورقةً أخرى\Nعلى مكتبي بالأمس
Dialogue: 0,0:05:54.61,0:05:55.53,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:05:55.53,0:05:59.65,Default,,0000,0000,0000,,لائحة بالمشاركين وخريطة لمكان اللقاء والنزل
Dialogue: 0,0:05:59.65,0:06:03.27,Default,,0000,0000,0000,,وصلتني أيضاً، من وضعها يا ترى؟
Dialogue: 0,0:06:03.40,0:06:05.98,Default,,0000,0000,0000,,أليس الشخص الذي يحمل مفتاح النزل؟
Dialogue: 0,0:06:06.57,0:06:10.85,Default,,0000,0000,0000,,لا بدّ أن من بينكم من استلم\Nمفتاح النزل من المالك
Dialogue: 0,0:06:11.64,0:06:16.12,Default,,0000,0000,0000,,المفتاح معي، فقد كان في مكتبي بالأمس
Dialogue: 0,0:06:16.39,0:06:17.82,Default,,0000,0000,0000,,من استأجر السيّارة إذاً؟
Dialogue: 0,0:06:18.13,0:06:22.03,Default,,0000,0000,0000,,أنا، اتّصل بي سوغياما سينسي البارحة
Dialogue: 0,0:06:22.30,0:06:24.27,Default,,0000,0000,0000,,وأخبرني باستئجار سيّارة
Dialogue: 0,0:06:24.67,0:06:28.18,Default,,0000,0000,0000,,أليس هو من نظّم الرحلة سوغياما سينسي إذاً؟
Dialogue: 0,0:06:34.62,0:06:37.13,Default,,0000,0000,0000,,ما الذي تفعله يا كونان-كن؟ لندخل
Dialogue: 0,0:06:37.70,0:06:38.18,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:06:41.11,0:06:43.65,Default,,0000,0000,0000,,!فسيح
Dialogue: 0,0:06:44.78,0:06:46.94,Default,,0000,0000,0000,,كان الجوّ بارداً
Dialogue: 0,0:06:46.94,0:06:48.22,Default,,0000,0000,0000,,!توجد مدفأة حطب
Dialogue: 0,0:06:48.89,0:06:50.74,Default,,0000,0000,0000,,ألا تشعرين بالسرور لقدومنا يا ران؟
Dialogue: 0,0:06:51.02,0:06:53.76,Default,,0000,0000,0000,,لكن لا يبدو أنّ بإمكاننا\Nالرجوع مع هذه العاصفة
Dialogue: 0,0:06:53.93,0:06:55.36,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:06:55.77,0:07:00.59,Default,,0000,0000,0000,,سأتّصل بوالديكما عنكما، لذا يمكنكما المبيت هنا
Dialogue: 0,0:07:00.59,0:07:01.19,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:07:01.92,0:07:05.83,Default,,0000,0000,0000,,لكن أكان استئجار نزل فاخر كهذا\Nفكرة حسنة حقّاً؟
Dialogue: 0,0:07:06.13,0:07:11.19,Default,,0000,0000,0000,,لنجعل سوغياما سينسي يدفع الأجر\N!بما أنّه منظّم الرحلة إذاً
Dialogue: 0,0:07:11.91,0:07:13.52,Default,,0000,0000,0000,,!بالحديث عنه
Dialogue: 0,0:07:13.52,0:07:16.40,Default,,0000,0000,0000,,!إنّه راعينا، سوغياما سينسي
Dialogue: 0,0:07:16.91,0:07:18.21,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:07:18.42,0:07:18.97,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:07:19.53,0:07:21.44,Default,,0000,0000,0000,,!سأفتح الآن
Dialogue: 0,0:07:22.57,0:07:24.61,Default,,0000,0000,0000,,...مرحباً يا سوغياما سينسي
Dialogue: 0,0:07:26.94,0:07:28.43,Default,,0000,0000,0000,,يبدو أنّكم اجتمعتم
Dialogue: 0,0:07:30.52,0:07:32.02,Default,,0000,0000,0000,,من ذاك الشخص؟
Dialogue: 0,0:07:32.48,0:07:34.73,On Top,,0000,0000,0000,,مجرّد صحفيّ ساعده هؤلاء السادة
Dialogue: 0,0:07:32.62,0:07:37.63,CharCard,,0000,0000,0003,,{\fad(300,0)}(موري أتسوشي (37\Nمراسل صحفيّ
Dialogue: 0,0:07:34.73,0:07:37.36,On Top,,0000,0000,0000,,قبل ثلاثة أعوام
Dialogue: 0,0:07:37.78,0:07:38.72,Default,,0000,0000,0000,,قبل ثلاثة أعوام؟
Dialogue: 0,0:07:39.13,0:07:40.68,Default,,0000,0000,0000,,!لـ-لمَ أنت هنا؟
Dialogue: 0,0:07:41.30,0:07:45.26,Default,,0000,0000,0000,,وصلتني معلومة بوقوع شيءٍ هنا الليلة
Dialogue: 0,0:07:45.65,0:07:46.61,Default,,0000,0000,0000,,...وقوع
Dialogue: 0,0:07:46.61,0:07:47.57,Default,,0000,0000,0000,,...شيء هنا
Dialogue: 0,0:07:48.25,0:07:49.02,Default,,0000,0000,0000,,الليلة؟
Dialogue: 0,0:07:49.37,0:07:54.69,Default,,0000,0000,0000,,أوقفتُ سيّارتي في الغابة\Nوهبّت العاصفة بينما كنت أنتظركم
Dialogue: 0,0:07:55.12,0:07:57.37,Default,,0000,0000,0000,,سأمكث هنا قليلاً
Dialogue: 0,0:07:57.37,0:07:58.52,Default,,0000,0000,0000,,...تـ-تمهل
Dialogue: 0,0:07:59.11,0:08:01.95,Default,,0000,0000,0000,,أأنت متأكّد؟ يمكنني كتابة مقالة
Dialogue: 0,0:08:01.95,0:08:07.94,Default,,0000,0000,0000,,معلّم في ابتدائيّة هايدو"\N"يطرد صحفيّاً في عاصفة ثلجيّة
Dialogue: 0,0:08:09.94,0:08:12.31,Default,,0000,0000,0000,,لنكن على وفاق
Dialogue: 0,0:08:12.31,0:08:14.77,Default,,0000,0000,0000,,ماذا؟ أين يونيهارا سينسي والبقيّة؟
Dialogue: 0,0:08:15.10,0:08:18.22,Default,,0000,0000,0000,,لا أدري، توقّف الجميع عن الكلام فجأةً
Dialogue: 0,0:08:18.55,0:08:22.19,Default,,0000,0000,0000,,كنّا نستمتع، لكن أفسد ذاك الرجل كلّ شيء
Dialogue: 0,0:08:22.51,0:08:23.51,Default,,0000,0000,0000,,سوزوكي-سان
Dialogue: 0,0:08:23.51,0:08:27.52,Default,,0000,0000,0000,,انسي أمره وساعديني\Nفي إعداد أسرّة الجميع
Dialogue: 0,0:08:27.92,0:08:29.21,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:29.21,0:08:34.98,Default,,0000,0000,0000,,بينما أريد من موري-سان والصبيّ مساعدة ناكامورا سينسي \Nالتي تعدّ العشاء في المطبخ، أيمكنكما؟
Dialogue: 0,0:08:34.98,0:08:36.33,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:36.53,0:08:40.63,Default,,0000,0000,0000,,أخبريني، أأتاكم اتّصال من سوغياما سينسي\Nالذي لم يأت بعد؟
Dialogue: 0,0:08:40.75,0:08:47.18,Default,,0000,0000,0000,,كلا، تردّ عليّ آلة الردّ الآلي عندما أتّصل\Nبهاتف منزله، فأظنّه في طريقه إلى هنا
Dialogue: 0,0:08:49.84,0:08:51.84,Default,,0000,0000,0000,,سأترك لك تلك الغرفة يا سوزوكي-سان
Dialogue: 0,0:08:51.84,0:08:52.72,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:56.97,0:08:59.65,Default,,0000,0000,0000,,ماذا؟ ناكامورا سينسي ليست هنا
Dialogue: 0,0:09:10.33,0:09:13.03,Default,,0000,0000,0000,,أهناك خطبٌ ما يا يونيهارا سينسي؟
Dialogue: 0,0:09:16.83,0:09:17.80,Default,,0000,0000,0000,,!سونوكو؟
Dialogue: 0,0:09:17.80,0:09:20.65,Default,,0000,0000,0000,,!سينسي! سينسي! تماسكي
Dialogue: 0,0:09:21.82,0:09:22.72,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:09:23.15,0:09:23.92,Default,,0000,0000,0000,,..."مي"
Dialogue: 0,0:09:39.05,0:09:40.76,Default,,0000,0000,0000,,!سونوكو! ما الذي يجري؟! افتحي
Dialogue: 0,0:09:41.21,0:09:42.61,Default,,0000,0000,0000,,!أنتِ هنا، صحيح؟
Dialogue: 0,0:09:47.09,0:09:49.38,Default,,0000,0000,0000,,!ما الخطب؟! سونوكو
Dialogue: 0,0:09:50.29,0:09:52.46,Default,,0000,0000,0000,,!أرجوك! افتحي عينيك
Dialogue: 0,0:09:55.95,0:09:57.43,Default,,0000,0000,0000,,نـ-نائمة؟
Dialogue: 0,0:09:58.94,0:10:00.34,Default,,0000,0000,0000,,يونيهارا سينسي؟
Dialogue: 0,0:10:00.90,0:10:02.69,Default,,0000,0000,0000,,لمَ الجلبة؟
Dialogue: 0,0:10:02.69,0:10:04.21,Default,,0000,0000,0000,,ماذا حصل هنا؟
Dialogue: 0,0:10:05.44,0:10:08.67,Default,,0000,0000,0000,,!ماذا؟ تعرّضتِ للهجوم؟! صدقاً؟
Dialogue: 0,0:10:09.27,0:10:09.93,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:10:09.93,0:10:14.21,Default,,0000,0000,0000,,غطّى أحدهم فمي من الخلف فجأةً\Nبينما كنت أعدّ الفراش
Dialogue: 0,0:10:14.60,0:10:16.64,Default,,0000,0000,0000,,ثم بدأتُ أفقد الوعي
Dialogue: 0,0:10:17.06,0:10:21.33,Default,,0000,0000,0000,,أكان هذا المنديل؟ أرى ذلك في التلفاز كثيراً
Dialogue: 0,0:10:21.67,0:10:25.72,Default,,0000,0000,0000,,يستعمل الفاعل منديلاً مغموراً بالكلوروفورم\Nلإفقاد المرء وعيه
Dialogue: 0,0:10:26.17,0:10:27.66,Default,,0000,0000,0000,,ما هذا الحبل إذاً؟
Dialogue: 0,0:10:27.66,0:10:30.43,Default,,0000,0000,0000,,خنقها به بعدما أفقدها وعيها
Dialogue: 0,0:10:31.25,0:10:34.91,Default,,0000,0000,0000,,أترون؟ توجد آثار حبل على عنقها
Dialogue: 0,0:10:34.91,0:10:35.97,Default,,0000,0000,0000,,فلا شكّ في الأمر
Dialogue: 0,0:10:36.41,0:10:38.90,Default,,0000,0000,0000,,أخُنقتِ أيضاً إذاً يا يونيهارا سينسي؟
Dialogue: 0,0:10:38.90,0:10:40.03,Default,,0000,0000,0000,,لستُ متأكدة
Dialogue: 0,0:10:40.03,0:10:44.65,Default,,0000,0000,0000,,قاومتُه، لكنّي فقدتُ الوعي فلا أعرف\Nما الذي حصل بعدها
Dialogue: 0,0:10:44.65,0:10:45.39,Default,,0000,0000,0000,,قاومتِه؟
Dialogue: 0,0:10:45.82,0:10:49.85,Default,,0000,0000,0000,,أجل، ضرب رأسي عدّة مرّات بالحائط حتّى
Dialogue: 0,0:10:49.85,0:10:50.59,Default,,0000,0000,0000,,انظروا
Dialogue: 0,0:10:51.56,0:10:52.50,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:52.85,0:10:54.68,Default,,0000,0000,0000,,ما الذي حصل ليدك؟
Dialogue: 0,0:10:55.14,0:10:56.06,Default,,0000,0000,0000,,يدي؟
Dialogue: 0,0:10:56.06,0:10:57.97,Default,,0000,0000,0000,,!ما-ما هذا؟
Dialogue: 0,0:10:57.97,0:10:58.38,Default,,0000,0000,0000,,..."مي"
Dialogue: 0,0:10:59.01,0:11:00.67,Default,,0000,0000,0000,,هذا أحمر شفاه
Dialogue: 0,0:11:00.67,0:11:02.13,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:11:03.67,0:11:06.60,Default,,0000,0000,0000,,!اختفى أحمر شفاهي! وضعتُه هنا
Dialogue: 0,0:11:06.92,0:11:10.55,Default,,0000,0000,0000,,انظروا، توجد كتابة بأحمر شفاه\Nعلى يد سونوكو أيضاً
Dialogue: 0,0:11:10.91,0:11:12.51,Default,,0000,0000,0000,,"تقول "نا
Dialogue: 0,0:11:12.71,0:11:14.17,Default,,0000,0000,0000,,مي" و"نا"؟"
Dialogue: 0,0:11:14.17,0:11:15.42,Default,,0000,0000,0000,,ما معنى ذلك؟
Dialogue: 0,0:11:15.71,0:11:18.42,Default,,0000,0000,0000,,(مي نا غو رو شي" (مذبحة
Dialogue: 0,0:11:18.85,0:11:20.27,Default,,0000,0000,0000,,!مـ-مذبحة؟
Dialogue: 0,0:11:20.85,0:11:24.38,Default,,0000,0000,0000,,لعلّ ذلك ما يحاول القاتل إيصاله لكم
Dialogue: 0,0:11:25.02,0:11:28.18,Default,,0000,0000,0000,,لكن من الجيّد أن أحداً لم يمت
Dialogue: 0,0:11:28.18,0:11:32.84,Default,,0000,0000,0000,,ليس عليكم الآن تعويج الحقيقة\Nوإخفاؤها مثلما حدث قبل 3 أعوام
Dialogue: 0,0:11:34.39,0:11:37.26,Default,,0000,0000,0000,,!يكفي! لا تزال تتكلّم عن ذلك؟
Dialogue: 0,0:11:37.71,0:11:40.58,Default,,0000,0000,0000,,!ألم تكن أنت من هاجمهما؟
Dialogue: 0,0:11:40.58,0:11:42.42,Default,,0000,0000,0000,,بلا هراء
Dialogue: 0,0:11:42.42,0:11:47.26,Default,,0000,0000,0000,,كنتُ أمام مدفأة الحطب\Nعندما صرخت تلك الفتاة
Dialogue: 0,0:11:47.26,0:11:51.49,Default,,0000,0000,0000,,بأيّ حال، أترون ترك الصبيّ يلاحق\Nالفاعل بمفرده فكرة حسنة؟
Dialogue: 0,0:11:52.20,0:11:52.88,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:11:53.16,0:11:55.31,Default,,0000,0000,0000,,!ممتاز! بقيت آثار أقدامه
Dialogue: 0,0:11:55.53,0:11:56.97,Default,,0000,0000,0000,,!انتظر يا كونان-كن
Dialogue: 0,0:11:56.97,0:11:58.25,Default,,0000,0000,0000,,...إذا تتبعتُها
Dialogue: 0,0:12:00.54,0:12:01.54,Default,,0000,0000,0000,,!الباب الأمامي؟
Dialogue: 0,0:12:03.19,0:12:05.88,Default,,0000,0000,0000,,...لحظة... هذا يعني أنّ الفاعل
Dialogue: 0,0:12:06.44,0:12:08.11,Default,,0000,0000,0000,,!لا يزال داخل النزل
Dialogue: 0,0:12:09.01,0:12:10.51,Default,,0000,0000,0000,,...سونوكو
Dialogue: 0,0:12:10.51,0:12:13.14,Default,,0000,0000,0000,,لا بدّ أنّها تنشقت كميّة كبيرة\Nمن الكلوروفورم
Dialogue: 0,0:12:13.14,0:12:15.56,Default,,0000,0000,0000,,ستفيق قريباً
Dialogue: 0,0:12:17.18,0:12:19.88,Default,,0000,0000,0000,,بوضع ذلك جانباً، أكان موضوع آثار الأقدام حقيقياً؟
Dialogue: 0,0:12:19.88,0:12:23.30,Default,,0000,0000,0000,,نعم، تمتد من النافذة للمدخل
Dialogue: 0,0:12:24.63,0:12:27.09,Default,,0000,0000,0000,,لكن كيف تعرف أنّها آثار الفاعل؟
Dialogue: 0,0:12:27.09,0:12:28.62,Default,,0000,0000,0000,,يا لحماقتك
Dialogue: 0,0:12:28.62,0:12:32.24,Default,,0000,0000,0000,,ركلت ران-نيتشان الباب لأنّه كان مقفلاً
Dialogue: 0,0:12:32.24,0:12:33.25,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:12:33.66,0:12:37.03,Default,,0000,0000,0000,,لا يمكنك قفل ذاك الباب\Nسوى من الداخل
Dialogue: 0,0:12:37.03,0:12:39.82,Default,,0000,0000,0000,,لذا النافذة هي مخرجك الوحيد
Dialogue: 0,0:12:39.82,0:12:41.21,Default,,0000,0000,0000,,مـ-معك حقّ
Dialogue: 0,0:12:41.82,0:12:45.55,Default,,0000,0000,0000,,!إذاً ربما الفاعل مختبئ في مكانٍ ما داخل النزل؟
Dialogue: 0,0:12:45.98,0:12:49.97,Default,,0000,0000,0000,,أنا متأكّد أنّه سوغياما سينسي\Nالذي لم يظهر بعد
Dialogue: 0,0:12:49.97,0:12:54.46,Default,,0000,0000,0000,,كما ظننت! يقوم ذاك الوغد بهذا لإخافتنا
Dialogue: 0,0:12:54.81,0:12:59.71,Default,,0000,0000,0000,,!لا تمزحا! بوضعي جانباً، سوزوكي-سان قد خُنقت
Dialogue: 0,0:12:59.71,0:13:01.67,Default,,0000,0000,0000,,!هذا كثيرٌ على مقلب
Dialogue: 0,0:13:03.30,0:13:04.50,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:13:05.25,0:13:08.83,Default,,0000,0000,0000,,مع ذلك، ما الذي يفكّر به سوغياما سينسي يا ترى؟
Dialogue: 0,0:13:09.29,0:13:11.54,Default,,0000,0000,0000,,أتمنّى أن يظهر
Dialogue: 0,0:13:11.54,0:13:15.30,Default,,0000,0000,0000,,لن يستطيع الظهور الآن لأنّ الأمر\Nلم يعد مضحكاً بالتأكيد
Dialogue: 0,0:13:16.04,0:13:17.86,Default,,0000,0000,0000,,وماذا عنكما؟
Dialogue: 0,0:13:17.86,0:13:20.75,Default,,0000,0000,0000,,!تعرّضت فتاتان للهجوم، أين كنتما؟
Dialogue: 0,0:13:21.07,0:13:24.19,Default,,0000,0000,0000,,لا تلوميني، كنتُ أستحمّ
Dialogue: 0,0:13:24.19,0:13:27.96,Default,,0000,0000,0000,,كنتُ في غرفتي بمفردي أستمع\Nللموسيقى على سمّاعاتي
Dialogue: 0,0:13:28.60,0:13:30.93,Default,,0000,0000,0000,,أيمكنك حراسة سوزوكي-سان إذاً؟
Dialogue: 0,0:13:30.93,0:13:33.38,Default,,0000,0000,0000,,إذا هاجم مجدداً، فأريه مهاراتك في الكاراتيه
Dialogue: 0,0:13:33.77,0:13:34.84,Default,,0000,0000,0000,,حاضرة
Dialogue: 0,0:13:40.76,0:13:42.84,Default,,0000,0000,0000,,قدما ناكامورا سينسي مُبللتان
Dialogue: 0,0:13:43.30,0:13:46.17,Default,,0000,0000,0000,,أخبريني يا ناكامورا سينسي، أين كنتِ قبل قليل؟
Dialogue: 0,0:13:46.17,0:13:47.91,Default,,0000,0000,0000,,لم نجدكِ في المطبخ
Dialogue: 0,0:13:49.12,0:13:51.37,Default,,0000,0000,0000,,لم يخرج الغاز
Dialogue: 0,0:13:51.37,0:13:53.88,Default,,0000,0000,0000,,فذهبتُ للخلف لتفقّد الأسطوانة
Dialogue: 0,0:13:55.25,0:13:57.78,Default,,0000,0000,0000,,بالمناسبة، لم يجهز العشاء بعد؟
Dialogue: 0,0:13:57.78,0:14:00.44,Default,,0000,0000,0000,,انتظروا قليلاً فحسب، إنّه على النار الآن
Dialogue: 0,0:14:00.44,0:14:02.25,Default,,0000,0000,0000,,!أشمّ رائحة كاري
Dialogue: 0,0:14:03.03,0:14:05.88,Default,,0000,0000,0000,,سأنهي أنا إعداد الأسرّة خلال ذلك
Dialogue: 0,0:14:06.86,0:14:08.68,Default,,0000,0000,0000,,سأكون في حوض الاستحمام
Dialogue: 0,0:14:08.68,0:14:11.06,Default,,0000,0000,0000,,وأنا سأذهب لتفقّد الطعام
Dialogue: 0,0:14:11.06,0:14:13.30,Default,,0000,0000,0000,,تنوي سرقة بعضه إذاً؟
Dialogue: 0,0:14:13.85,0:14:17.71,Default,,0000,0000,0000,,شكراً على إعداد حصّة لي أيضاً
Dialogue: 0,0:14:17.71,0:14:20.97,Default,,0000,0000,0000,,لا مشكلة، كانت هناك حصّة فائضة بأيّ حال
Dialogue: 0,0:14:20.97,0:14:24.42,Default,,0000,0000,0000,,لكنّي لن أنسى الأمر قبل 3 أعوام البتّة
Dialogue: 0,0:14:24.88,0:14:26.38,Default,,0000,0000,0000,,حقّاً ذلك؟
Dialogue: 0,0:14:26.92,0:14:30.00,Default,,0000,0000,0000,,ما هذا الأمر الذي حدث قبل 3 أعوام؟
Dialogue: 0,0:14:30.00,0:14:32.84,Default,,0000,0000,0000,,لا تهتم يا فتى، دعك منه
Dialogue: 0,0:14:33.58,0:14:36.04,Default,,0000,0000,0000,,ماذا؟ لم تأكلا؟
Dialogue: 0,0:14:36.04,0:14:38.95,Default,,0000,0000,0000,,قالت أنّها ستأكل مع سونوكو-تشان عندما تستيقظ
Dialogue: 0,0:14:38.95,0:14:42.04,Default,,0000,0000,0000,,هكذا إذاً، أقحمناهما في أمور مزعجة
Dialogue: 0,0:14:44.49,0:14:45.76,Default,,0000,0000,0000,,من قد يكون؟
Dialogue: 0,0:14:45.76,0:14:47.60,Default,,0000,0000,0000,,أهو سوغياما سينسي؟
Dialogue: 0,0:14:47.60,0:14:49.37,Default,,0000,0000,0000,,...ذاك الوغد
Dialogue: 0,0:14:50.19,0:14:52.85,Default,,0000,0000,0000,,!اسمع يا سوغياما! نعرف أنّك في هذا النزل
Dialogue: 0,0:14:52.85,0:14:55.34,Default,,0000,0000,0000,,كفّ عن الاختباء واخرج... ماذا؟
Dialogue: 0,0:14:55.85,0:14:59.21,Default,,0000,0000,0000,,أجل، نحن بخير، جهاز التدفئة
Dialogue: 0,0:15:00.68,0:15:02.97,Default,,0000,0000,0000,,إنّه صاحب النزل
Dialogue: 0,0:15:02.97,0:15:07.05,Default,,0000,0000,0000,,كان قلقاً من عدم عمل جهاز التدفئة\Nمع سقوط الثلج
Dialogue: 0,0:15:07.62,0:15:11.66,Default,,0000,0000,0000,,غريب، هناك خطبٌ ما في هذا النزل
Dialogue: 0,0:15:11.66,0:15:14.12,Default,,0000,0000,0000,,يبدو أنّ عليّ التحرّي
Dialogue: 0,0:15:14.12,0:15:17.29,Default,,0000,0000,0000,,سأبدأ بالحادثة قبل ثلاثة أعوام\N!التي يتكتّم عليها الجميع
Dialogue: 0,0:15:18.40,0:15:20.31,Default,,0000,0000,0000,,أين تذهب يا فتى؟
Dialogue: 0,0:15:20.52,0:15:21.96,Default,,0000,0000,0000,,إلى الحمّام
Dialogue: 0,0:15:22.73,0:15:26.16,Default,,0000,0000,0000,,...ماذا؟ أنا متأكد أنّي جلبته معي
Dialogue: 0,0:15:26.69,0:15:27.41,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:15:27.76,0:15:30.62,Default,,0000,0000,0000,,هاتف القرط الخلويّ الذي\N!أعطاني إيّاه البروفسور
Dialogue: 0,0:15:30.97,0:15:33.58,Default,,0000,0000,0000,,...حسناً، رقم منزله
Dialogue: 0,0:15:33.94,0:15:38.16,CharCard,,0000,0000,0005,,{\fad(300,0)}منزل البروفسور آغاسا
Dialogue: 0,0:15:34.10,0:15:38.03,On Top,,0000,0000,0000,,ماذا؟ حادثة في ابتدائية هايدو\Nقبل 3 أعوام؟
Dialogue: 0,0:15:38.41,0:15:40.09,Default,,0000,0000,0000,,!تحرّ في أمرها فحسب رجاءً
Dialogue: 0,0:15:40.09,0:15:42.04,Default,,0000,0000,0000,,لكن كيف؟
Dialogue: 0,0:15:42.04,0:15:44.70,Default,,0000,0000,0000,,يُفترض أنّ هناك ملفّات قضايا\Nفي مكتب أبي
Dialogue: 0,0:15:45.17,0:15:47.89,Default,,0000,0000,0000,,بأيّ حال، لتسرع! يراودني شعورٌ سيّئ
Dialogue: 0,0:15:48.16,0:15:50.04,Default,,0000,0000,0000,,...إذا لم نسرع، قد يتعرّض شخص آخر
Dialogue: 0,0:15:55.58,0:15:56.96,Default,,0000,0000,0000,,!قادم
Dialogue: 0,0:15:59.90,0:16:01.99,Default,,0000,0000,0000,,!كان أنت بالفعل يا سوغياما سينسي
Dialogue: 0,0:16:02.48,0:16:04.48,Default,,0000,0000,0000,,!وصل معلّم الموسيقى
Dialogue: 0,0:16:04.48,0:16:06.21,Default,,0000,0000,0000,,لا تخفنا هكذا
Dialogue: 0,0:16:06.65,0:16:09.16,Default,,0000,0000,0000,,!ما الذي تفعله؟ فلتدخل
Dialogue: 0,0:16:24.77,0:16:27.25,Default,,0000,0000,0000,,!ما الخطب؟! تماسك يا سوغياما سينسي
Dialogue: 0,0:16:27.25,0:16:28.91,Default,,0000,0000,0000,,!سوغياما سينسي
Dialogue: 0,0:16:30.76,0:16:33.38,Default,,0000,0000,0000,,لا جدوى، فارق الحياة
Dialogue: 0,0:16:33.63,0:16:36.04,Default,,0000,0000,0000,,...لكن كيف
Dialogue: 0,0:16:36.04,0:16:38.20,Default,,0000,0000,0000,,أمات تجمّداً؟
Dialogue: 0,0:16:38.20,0:16:39.54,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:16:40.41,0:16:42.37,Default,,0000,0000,0000,,قُتل هذا الرجل
Dialogue: 0,0:16:42.98,0:16:44.34,Default,,0000,0000,0000,,شنقاً
Dialogue: 0,0:16:44.91,0:16:47.57,Default,,0000,0000,0000,,انظروا، يوجد أثر على عنقه
Dialogue: 0,0:16:47.57,0:16:49.42,Default,,0000,0000,0000,,كما أنّ الجثّة متيبسة
Dialogue: 0,0:16:49.99,0:16:52.65,Default,,0000,0000,0000,,ألا يُدعى ذلك بتصلّب الجثّة؟
Dialogue: 0,0:16:52.65,0:16:53.78,Default,,0000,0000,0000,,...بـ-بلى
Dialogue: 0,0:16:53.78,0:16:58.25,Default,,0000,0000,0000,,وجوده يعني أنّه قُتل\Nقبل 9 ساعات من الآن
Dialogue: 0,0:16:58.64,0:17:04.97,Default,,0000,0000,0000,,قرع جثّته للجرس يعني \Nأن أحدهم أماله عليه
Dialogue: 0,0:17:05.64,0:17:10.88,Default,,0000,0000,0000,,لكننا كنّا نأكل جميعاً عند مدفأة الحطب\Nعندما قُرع الجرس
Dialogue: 0,0:17:10.88,0:17:14.17,Default,,0000,0000,0000,,هذا يعني أنّ القاتل ليس أحدنا
Dialogue: 0,0:17:14.63,0:17:16.41,Default,,0000,0000,0000,,من إذاً؟
Dialogue: 0,0:17:16.41,0:17:21.33,Default,,0000,0000,0000,,أظنّه نفس الشخص الذي هاجم \Nيونيهارا سينسي وسونوكو-نيتشان
Dialogue: 0,0:17:21.33,0:17:21.88,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:22.29,0:17:25.29,Default,,0000,0000,0000,,انظر! توجد "كو" على يده
Dialogue: 0,0:17:25.29,0:17:28.79,Default,,0000,0000,0000,,يوجد رمز مكتوب بأحمر شفاه\Nعلى يده مثلما حصل معهما
Dialogue: 0,0:17:30.45,0:17:35.01,Default,,0000,0000,0000,,،"كان مكتوباً على يونيهارا سينسي "مي\N...وعلى سونوكو-نيتشان "نا"، ما يعني
Dialogue: 0,0:17:35.01,0:17:36.96,Default,,0000,0000,0000,,"مي نا كو"
Dialogue: 0,0:17:40.27,0:17:41.67,Default,,0000,0000,0000,,ما الأمر يا شيمودا سينسي؟
Dialogue: 0,0:17:41.67,0:17:42.60,Default,,0000,0000,0000,,!لا تلمسيني
Dialogue: 0,0:17:42.60,0:17:45.59,Default,,0000,0000,0000,,!لا علاقة لي! لا علاقة لي
Dialogue: 0,0:17:51.68,0:17:54.55,Default,,0000,0000,0000,,!شيمادا سينسي، أنا يونيهارا! افتح
Dialogue: 0,0:17:54.55,0:17:56.50,Default,,0000,0000,0000,,!اصمتي! دعيني وشأني
Dialogue: 0,0:17:56.79,0:17:58.30,Default,,0000,0000,0000,,ليس باليد حيلة
Dialogue: 0,0:17:58.30,0:18:00.79,Default,,0000,0000,0000,,لننتظر حتى يهدأ روعه
Dialogue: 0,0:18:00.79,0:18:02.70,Default,,0000,0000,0000,,لنتّصل بالشرطة بأيّ حال
Dialogue: 0,0:18:02.70,0:18:03.67,Default,,0000,0000,0000,,نـ-نعم
Dialogue: 0,0:18:04.33,0:18:06.12,Default,,0000,0000,0000,,!قُتِل شخص؟
Dialogue: 0,0:18:06.36,0:18:11.07,Default,,0000,0000,0000,,نعم، وجدنا جثّة سوغياما سينسي الذي لم يكن\Nقد أتى بعد عند الباب الأماميّ
Dialogue: 0,0:18:11.07,0:18:12.74,Default,,0000,0000,0000,,وماذا عن القاتل؟
Dialogue: 0,0:18:12.74,0:18:17.83,Default,,0000,0000,0000,,لعلّه تسلّل للداخل بينما\Nكنّا مجتمعين عند الباب
Dialogue: 0,0:18:18.23,0:18:22.43,Default,,0000,0000,0000,,لا تقلقي، ساكاي سينسي يتّصل بالشرطة الآن
Dialogue: 0,0:18:23.19,0:18:24.22,Default,,0000,0000,0000,,!لا جدوى
Dialogue: 0,0:18:24.52,0:18:27.05,Default,,0000,0000,0000,,قالوا أنّ من المخاطرة إرسال\Nسيّارة شرطة في هذه العاصفة
Dialogue: 0,0:18:27.05,0:18:31.05,Default,,0000,0000,0000,,!لذا علينا انتظار استقرارها حتّى الصباح
Dialogue: 0,0:18:31.47,0:18:32.64,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:18:32.64,0:18:35.72,Default,,0000,0000,0000,,!أيقصدون أنّ علينا المكوث هنا للصباح إذاً؟
Dialogue: 0,0:18:35.72,0:18:38.25,Default,,0000,0000,0000,,قد لا يزال القاتل مختبئاً
Dialogue: 0,0:18:38.83,0:18:43.72,Default,,0000,0000,0000,,لمَ؟ لمَ حصل كلّ هذا؟\Nكانت رحلة تزلّج مسليّة
Dialogue: 0,0:18:44.21,0:18:46.54,Default,,0000,0000,0000,,...ليته كان هنا
Dialogue: 0,0:18:47.16,0:18:50.17,Default,,0000,0000,0000,,أقصد شينتشي! شينتشي! ألا تذكرين؟
Dialogue: 0,0:18:50.70,0:18:54.87,Default,,0000,0000,0000,,كان من وجد مال غداء الجميع الذي فقدتُه
Dialogue: 0,0:18:54.87,0:18:57.02,Default,,0000,0000,0000,,عندما كنت في الصفّ الرابع
Dialogue: 0,0:18:57.77,0:19:02.93,Default,,0000,0000,0000,,تقصدين ذاك الصغير المتبجّح من الفصل المجاور\Nالذي كان يتصرّف كمتحرٍّ؟
Dialogue: 0,0:19:03.77,0:19:05.92,Default,,0000,0000,0000,,اعذريني على كوني متبجّحاً
Dialogue: 0,0:19:06.39,0:19:09.51,Default,,0000,0000,0000,,إنّه مُتحرٍّ في الثانوية الآن
Dialogue: 0,0:19:09.51,0:19:13.13,Default,,0000,0000,0000,,،بالمناسبة، رأيتُه فعلاً في الصحف\N...كان اسمه
Dialogue: 0,0:19:13.29,0:19:15.05,Default,,0000,0000,0000,,كودو شينتشي
Dialogue: 0,0:19:15.51,0:19:20.30,Default,,0000,0000,0000,,مُتحرٍّ لامع حلّ العديد من القضايا\Nالمستعصية وهو في السادسة عشر
Dialogue: 0,0:19:21.04,0:19:26.20,Default,,0000,0000,0000,,كان بارعاً بالنسبة لصبيّ، فكنتُ سأكتب مقالةً عنه
Dialogue: 0,0:19:26.33,0:19:28.38,Default,,0000,0000,0000,,لكن انقطعت أخباره مؤخراً
Dialogue: 0,0:19:29.08,0:19:32.71,Default,,0000,0000,0000,,يُشاع أنّه أقحم نفسه في قضيّة مشبوهة ولقي حتفه
Dialogue: 0,0:19:33.04,0:19:35.86,Default,,0000,0000,0000,,...يا للفظاظة! شينتشي على قيد
Dialogue: 0,0:19:38.82,0:19:40.77,Default,,0000,0000,0000,,!ما الذي تريده بأيّ حال؟
Dialogue: 0,0:19:40.77,0:19:43.40,Default,,0000,0000,0000,,أتيتُ لتحذيركم فحسب
Dialogue: 0,0:19:43.40,0:19:48.00,Default,,0000,0000,0000,,لا تزيحوا بنظركم عن ذاك الرجل\Nالمُغلق على نفسه في الطابق الثاني
Dialogue: 0,0:19:48.00,0:19:52.97,Default,,0000,0000,0000,,إذا أصاب حدسي الصحفي، فسيكون هو الهدف التالي
Dialogue: 0,0:19:53.35,0:19:58.72,Default,,0000,0000,0000,,مع أنّ تزايد الضحايا سيزيد الإقبال\Nعلى مقالتي فسيصبّ ذلك في صالحي
Dialogue: 0,0:20:00.00,0:20:03.00,Default,,0000,0000,0000,,ما الذي يقوله؟ نوافذ الطابق الثاني لا تُفتح
Dialogue: 0,0:20:03.00,0:20:06.75,Default,,0000,0000,0000,,ولا يمكن أن يهاجمه المجرم إذا كان مُغلقاً على نفسه
Dialogue: 0,0:20:07.33,0:20:12.91,Default,,0000,0000,0000,,،لكنّ شيمادا سينسي منفعل قليلاً\Nفأرى أنّ من الخطر تركه بمفرده
Dialogue: 0,0:20:12.91,0:20:14.97,Default,,0000,0000,0000,,لنقدّم له قهوةً ونجعله يهدأ
Dialogue: 0,0:20:15.70,0:20:21.86,Default,,0000,0000,0000,,سأعدّ القهوة مع ناكامورا سينسي، لذا فلتكن\Nبجواره يا ساكاي سينسي
Dialogue: 0,0:20:21.86,0:20:22.63,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:20:23.03,0:20:27.25,Default,,0000,0000,0000,,توخّ الحذر، قد لا يزال القاتل مختبئاً في الداخل
Dialogue: 0,0:20:27.25,0:20:30.21,Default,,0000,0000,0000,,!سأُقتل! سأُقتل
Dialogue: 0,0:20:30.60,0:20:32.97,Default,,0000,0000,0000,,!سيقتلني أحدهم
Dialogue: 0,0:20:35.56,0:20:38.54,Default,,0000,0000,0000,,هاك يا موري-سان، قهوة وكاكاو
Dialogue: 0,0:20:39.26,0:20:40.55,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:20:40.55,0:20:42.26,Default,,0000,0000,0000,,أين ذاك الصبيّ؟
Dialogue: 0,0:20:42.26,0:20:44.88,Default,,0000,0000,0000,,ماذا؟ لم يكن معك؟
Dialogue: 0,0:20:45.38,0:20:47.96,Default,,0000,0000,0000,,جريمة من الخارج... أحقّاً ذلك؟
Dialogue: 0,0:20:48.87,0:20:52.79,Default,,0000,0000,0000,,كان الجميع معاً عندما قُرع الجرس\Nباستثناء ران وسونوكو
Dialogue: 0,0:20:52.79,0:20:56.96,Default,,0000,0000,0000,,فلا بدّ أنّ شخصاً غيرنا وضع الجثّة هنا
Dialogue: 0,0:20:58.69,0:21:02.99,Default,,0000,0000,0000,,ماذا؟ ذاك الجزء وحده\Nلا ثلج عليه
Dialogue: 0,0:21:02.99,0:21:04.68,Default,,0000,0000,0000,,هل أزاحه أحدهم؟
Dialogue: 0,0:21:05.85,0:21:07.79,Default,,0000,0000,0000,,ما خطب هذا الخطّ؟
Dialogue: 0,0:21:08.31,0:21:09.88,Default,,0000,0000,0000,,يوجد على الطرف الآخر أيضاً
Dialogue: 0,0:21:11.31,0:21:13.63,Default,,0000,0000,0000,,...أيمكن أنّه
Dialogue: 0,0:21:13.93,0:21:14.90,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:21:15.34,0:21:18.22,Default,,0000,0000,0000,,تعرف أنّه لا يجدر بك التجوّل هكذا
Dialogue: 0,0:21:18.22,0:21:20.72,Default,,0000,0000,0000,,لترجع لغرفتك وتخلد للنوم
Dialogue: 0,0:21:20.72,0:21:23.50,Default,,0000,0000,0000,,!اصمتي! دعيني وشأني
Dialogue: 0,0:21:24.17,0:21:25.23,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:21:25.23,0:21:28.37,Default,,0000,0000,0000,,يرفض شيمودا سينسي السماح لي بالدخول
Dialogue: 0,0:21:28.37,0:21:32.67,Default,,0000,0000,0000,,لنتركه إذاً، علينا إقفال غرفنا
Dialogue: 0,0:21:32.67,0:21:34.25,Default,,0000,0000,0000,,والاستراحة حتّى الصباح
Dialogue: 0,0:21:37.70,0:21:39.13,Default,,0000,0000,0000,,إنّه من البروفسور
Dialogue: 0,0:21:40.45,0:21:42.78,Default,,0000,0000,0000,,نعم يا بروفسور، أوجدت القضيّة؟
Dialogue: 0,0:21:42.78,0:21:44.84,Default,,0000,0000,0000,,أجل، وجدتُ الملف أخيراً
Dialogue: 0,0:21:45.61,0:21:49.02,Default,,0000,0000,0000,,قبل ثلاثة أعوام، أقدمت فتاة في ابتدائية\Nهايدو في غرفة نادي كرة الطائرة
Dialogue: 0,0:21:49.02,0:21:50.81,Default,,0000,0000,0000,,على شنق نفسها
Dialogue: 0,0:21:50.81,0:21:51.85,Default,,0000,0000,0000,,انتحار؟
Dialogue: 0,0:21:51.85,0:21:54.30,Default,,0000,0000,0000,,يبدو أنّ السبب كان اضطراباً عصبياً من الاختبارات
Dialogue: 0,0:21:54.60,0:21:58.34,Default,,0000,0000,0000,,وأُلقي اللوم على معلّم فصلها جرّاء ذلك
Dialogue: 0,0:21:58.34,0:21:59.93,Default,,0000,0000,0000,,ما اسم المعلّم؟
Dialogue: 0,0:21:59.93,0:22:03.88,Default,,0000,0000,0000,,غير مذكور، لكنّ اسم الفتاة موجود
Dialogue: 0,0:22:03.88,0:22:07.29,Default,,0000,0000,0000,,ابتدائية هايدو، الصفّ 6 الفصل 2، موتشيزوكي ميناكو
Dialogue: 0,0:22:07.29,0:22:08.25,Default,,0000,0000,0000,,!ميناكو؟
Dialogue: 0,0:22:08.64,0:22:10.33,Default,,0000,0000,0000,,!أذُكر شيء غير ذلك؟
Dialogue: 0,0:22:10.33,0:22:12.86,Default,,0000,0000,0000,,ما الذي تفعله يا كونان-كن؟
Dialogue: 0,0:22:14.21,0:22:15.54,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:22:15.54,0:22:16.70,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:22:16.70,0:22:19.59,Default,,0000,0000,0000,,ماذا؟ إنّه صوت البروفسور، أهذا هاتف؟
Dialogue: 0,0:22:20.07,0:22:21.57,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:22:21.57,0:22:23.00,Default,,0000,0000,0000,,شينتشي؟
Dialogue: 0,0:22:23.32,0:22:25.05,Default,,0000,0000,0000,,!أشينتشي عندك يا بروفسور؟
Dialogue: 0,0:22:25.18,0:22:27.00,Default,,0000,0000,0000,,!ماذا؟! ران-كن
Dialogue: 0,0:22:30.42,0:22:33.19,Default,,0000,0000,0000,,!الـ-الطابق الثاني! تبّاً
Dialogue: 0,0:24:00.07,0:24:00.94,Default,,0000,0000,0000,,!ما الأمر؟
Dialogue: 0,0:24:00.94,0:24:01.86,Default,,0000,0000,0000,,!ماذا هناك؟
Dialogue: 0,0:24:01.86,0:24:03.82,Default,,0000,0000,0000,,...شيمادا سينسي قد
Dialogue: 0,0:24:05.64,0:24:07.07,Default,,0000,0000,0000,,!تمهل
Dialogue: 0,0:24:07.07,0:24:09.90,Default,,0000,0000,0000,,!ليس هنا، ليس هنا، ليس هنا
Dialogue: 0,0:24:10.24,0:24:16.07,Default,,0000,0000,0000,,عدم وجوده في أيّ مكان يعني\Nأنّ الحبل لا يزال مع القاتل
Dialogue: 0,0:24:16.07,0:24:18.48,Default,,0000,0000,0000,,مع أحدهم
Dialogue: 0,0:24:20.35,0:24:23.14,Default,,0000,0000,0000,,!الفاعل... هو أنت
Dialogue: 0,0:24:23.93,0:24:29.92,On Top,,0000,0000,0000,,جريمة قتل نزل التزلّج\N(الجزء الثاني)
Dialogue: 0,0:24:24.44,0:24:26.16,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.16,0:24:29.06,Default,,0000,0000,0000,,جريمة قتل نزل التزلّج\N(الجزء الثاني)
Dialogue: 0,0:24:45.69,0:24:47.85,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.85,0:24:49.85,Default,,0000,0000,0000,,خصلة شعر
Dialogue: 0,0:24:49.92,0:24:51.47,Default,,0000,0000,0000,,الحلقة القادمة هي الأخيرة\N!هذه السنة لكونان
Dialogue: 0,0:24:51.47,0:24:52.84,Default,,0000,0000,0000,,...في الكريسماس
Dialogue: 0,0:24:52.84,0:24:54.00,Default,,0000,0000,0000,,هل اكتشفت هويّة القاتل؟
Dialogue: 0,0:24:54.00,0:24:55.99,Default,,0000,0000,0000,,!تبّاً! أنا في مأزق

