Dialogue: 0,0:00:02.04,0:00:04.99,Default,,0000,0000,0000,,طالما جرائم العصر الحديث تتضمّن بشراً
Dialogue: 0,0:00:04.99,0:00:07.03,Default,,0000,0000,0000,,!لا توجد ألغاز لا تُحلّ
Dialogue: 0,0:00:07.03,0:00:08.87,Default,,0000,0000,0000,,!ضيوف اليوم مميّزون جداً
Dialogue: 0,0:00:08.87,0:00:10.83,Default,,0000,0000,0000,,!يمكن للعلاقات البشرية أن تكون معقّدة
Dialogue: 0,0:00:10.83,0:00:12.74,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.74,0:00:14.77,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.77,0:00:16.39,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:02:06.94,0:02:12.86,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل أوجامانبو
Dialogue: 0,0:02:07.67,0:02:10.47,Default,,0000,0000,0000,,جريمة قتل أوجامانبو
Dialogue: 0,0:02:12.90,0:02:15.50,Default,,0000,0000,15,,الأحد، السابعة صباحاً
Dialogue: 0,0:02:20.16,0:02:22.20,Default,,0000,0000,0000,,!أسرع يا أبي
Dialogue: 0,0:02:22.20,0:02:23.56,Default,,0000,0000,0000,,هل أصابك الإنهاك بهذه السرعة؟
Dialogue: 0,0:02:25.99,0:02:28.77,Default,,0000,0000,0000,,ليس بيدي، فلا أزال أعاني أثر الشراب
Dialogue: 0,0:02:29.11,0:02:31.73,Default,,0000,0000,0000,,كنتَ من اقترح خروجنا في المقام الأوّل
Dialogue: 0,0:02:31.73,0:02:34.68,Default,,0000,0000,0000,,صحيح، رافقناك فحسب
Dialogue: 0,0:02:36.48,0:02:39.68,Default,,0000,0000,0000,,!هيّا، تبقّى كيلومتران فحسب للحديقة
Dialogue: 0,0:02:39.68,0:02:41.48,Default,,0000,0000,0000,,!هيّا، اجتهد
Dialogue: 0,0:02:41.81,0:02:43.93,Default,,0000,0000,0000,,...مهلك، لنسترح قليلاً يا ران
Dialogue: 0,0:02:43.93,0:02:46.89,CharCard,,0000,0000,0005,,{\fad(00,0)}(فوجي تسونيهيسا (27\Nمدير الأعمال الشرقية لشركة أوجامانبو للتنظيف
Dialogue: 0,0:02:49.72,0:02:50.56,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:02:58.87,0:02:59.76,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:03:11.15,0:03:12.87,Default,,0000,0000,0000,,!ابقيا هنا
Dialogue: 0,0:03:20.25,0:03:22.61,CharCard,,0000,0000,0005,,{\fad(300,0)}(ناكاياما هيديوكي (29\Nرئيس شركة أوجامانبو للتنظيف
Dialogue: 0,0:03:28.05,0:03:29.85,Default,,0000,0000,0000,,!أساغي-سان! أساغي-سان
Dialogue: 0,0:03:30.25,0:03:33.81,CharCard,,0000,0000,0005,,{\fad(300,0)}(أساغي كونيكو (31\Nسكرتيرة رئيس شركة أوجامانبو للتنظيف
Dialogue: 0,0:03:31.01,0:03:33.81,On Top,,0000,0000,0000,,أجل، أهناك خطبٌ ما سيّدي؟
Dialogue: 0,0:03:33.81,0:03:38.08,Default,,0000,0000,0000,,يبدو أنّ أمراً وقع في الخارج
Dialogue: 0,0:03:38.08,0:03:39.77,Default,,0000,0000,0000,,هلّا تفقدتِ الأمر؟
Dialogue: 0,0:03:40.42,0:03:42.67,Default,,0000,0000,0000,,حاضر، بالطبع
Dialogue: 0,0:03:44.22,0:03:45.66,Default,,0000,0000,0000,,!اطلبوا الإسعاف
Dialogue: 0,0:03:45.66,0:03:47.18,Default,,0000,0000,0000,,!يبدو هذا سيّئاً
Dialogue: 0,0:03:50.57,0:03:52.31,Default,,0000,0000,0000,,نفس الرسمة على تلك الشاحنة
Dialogue: 0,0:03:53.03,0:03:54.56,Default,,0000,0000,0000,,إنّه ميت
Dialogue: 0,0:03:54.56,0:03:58.73,Default,,0000,0000,0000,,يبدو أنّ العارضة الحديدية سقطت من الأعلى
Dialogue: 0,0:03:58.73,0:04:00.90,Default,,0000,0000,0000,,لا نوافذ بأيّ من البنائين
Dialogue: 0,0:04:00.90,0:04:03.73,Default,,0000,0000,0000,,ما يعني أنّ هذه العارضة\Nسقطت من السقف؟
Dialogue: 0,0:04:03.73,0:04:05.14,Default,,0000,0000,0000,,من أنتم؟
Dialogue: 0,0:04:05.39,0:04:07.59,Default,,0000,0000,0000,,كنّا ننظف البناية مقابل الشارع
Dialogue: 0,0:04:07.59,0:04:08.93,Default,,0000,0000,0000,,نحن من أوجامانبو
Dialogue: 0,0:04:08.93,0:04:12.39,Default,,0000,0000,0000,,المعذرة، لكن هلّا تفقدتم هذا المبنى المهجور؟
Dialogue: 0,0:04:12.39,0:04:15.54,Default,,0000,0000,0000,,ربما أسقط أحدهم العارضة منه
Dialogue: 0,0:04:15.54,0:04:15.93,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:04:18.83,0:04:21.19,Default,,0000,0000,0000,,...ماذا؟ أولئك
Dialogue: 0,0:04:21.79,0:04:23.79,Default,,0000,0000,0000,,يا لحظّي لأصادف حادثةً كهذه
Dialogue: 0,0:04:23.79,0:04:25.01,Default,,0000,0000,0000,,في صباح الأحد
Dialogue: 0,0:04:26.47,0:04:27.47,Default,,0000,0000,0000,,!فوجي-سان
Dialogue: 0,0:04:27.87,0:04:29.45,Default,,0000,0000,0000,,تعرفينه؟
Dialogue: 0,0:04:29.45,0:04:32.74,Default,,0000,0000,0000,,!أجل! إنّه أحد مدراء شركتنا
Dialogue: 0,0:04:32.74,0:04:34.68,Default,,0000,0000,0000,,لكن لمَ؟
Dialogue: 0,0:04:45.72,0:04:49.26,Default,,0000,0000,0000,,كان فوجي-سان في طريقه\Nمن المكتب هناك
Dialogue: 0,0:04:49.26,0:04:51.31,Default,,0000,0000,0000,,إلى هذا المكتب الرئيسي إذاً؟
Dialogue: 0,0:04:51.31,0:04:54.84,Default,,0000,0000,0000,,أجل، كان يُفترض أن يلتقي الرئيس عند التاسعة
Dialogue: 0,0:04:54.84,0:04:57.02,Default,,0000,0000,0000,,!صحيح، عليّ إخباره
Dialogue: 0,0:04:57.96,0:04:58.73,Default,,0000,0000,0000,,!حضرة الرئيس
Dialogue: 0,0:04:59.88,0:05:01.44,Default,,0000,0000,0000,,أساغي-سان، ماذا حصل؟
Dialogue: 0,0:05:02.00,0:05:03.14,Default,,0000,0000,0000,,إنّه المدير فوجي
Dialogue: 0,0:05:03.14,0:05:05.00,Default,,0000,0000,0000,,أحلّ أمرٌ به؟
Dialogue: 0,0:05:07.43,0:05:07.98,Default,,0000,0000,0000,,!فوجي
Dialogue: 0,0:05:08.66,0:05:09.66,Default,,0000,0000,0000,,!أساغي-سان
Dialogue: 0,0:05:09.66,0:05:13.33,Default,,0000,0000,0000,,انقلي شاحنة مانبو\N!من المبنى المقابل فوراً
Dialogue: 0,0:05:13.33,0:05:16.27,Default,,0000,0000,0000,,!ستعترض الطريق عند وصول الشرطة، أسرعي
Dialogue: 0,0:05:16.27,0:05:16.85,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:05:19.73,0:05:22.52,Default,,0000,0000,0000,,لكن لمَ حصل هذا؟
Dialogue: 0,0:05:31.97,0:05:33.33,Default,,0000,0000,0000,,تفضّلوا
Dialogue: 0,0:05:38.55,0:05:40.19,Default,,0000,0000,0000,,ما وظيفة ذاك المفتاح؟
Dialogue: 0,0:05:40.80,0:05:43.15,Default,,0000,0000,0000,,،إذاً، عندما وقعت الحادثة
Dialogue: 0,0:05:43.55,0:05:45.37,Default,,0000,0000,0000,,كانا ناكاياما-سان في هذه الغرفة
Dialogue: 0,0:05:45.37,0:05:48.35,Default,,0000,0000,0000,,وأنت يا أساغي-سان في الغرفة المجاورة، صحيح؟
Dialogue: 0,0:05:48.66,0:05:49.62,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:05:49.62,0:05:52.56,Default,,0000,0000,0000,,أهناك من يشهد على ذلك؟
Dialogue: 0,0:05:52.56,0:05:54.51,Default,,0000,0000,0000,,...قصدك
Dialogue: 0,0:05:54.51,0:05:56.94,Default,,0000,0000,0000,,في الواقع، بعد الحادثة
Dialogue: 0,0:05:56.94,0:05:58.90,Default,,0000,0000,0000,,طلب موري-كن هنا من موظّفيكم البحث
Dialogue: 0,0:05:58.90,0:06:01.11,Default,,0000,0000,0000,,في البناية المجاورة المهجورة
Dialogue: 0,0:06:01.11,0:06:03.03,Default,,0000,0000,0000,,سمعتُ بذلك
Dialogue: 0,0:06:03.03,0:06:05.60,Default,,0000,0000,0000,,لكنّهم لم يجدوا أيّ شيء مشبوه، صحيح؟
Dialogue: 0,0:06:05.60,0:06:06.35,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:06:06.35,0:06:08.77,Default,,0000,0000,0000,,،لكن عندما أمعنتُ التفكير
Dialogue: 0,0:06:08.77,0:06:10.93,Default,,0000,0000,0000,,أدركتُ وجود احتمال لسقوط العارضة
Dialogue: 0,0:06:10.93,0:06:13.93,Default,,0000,0000,0000,,من سطح هذا المبنى
Dialogue: 0,0:06:14.96,0:06:18.67,Default,,0000,0000,0000,,الطابق الثالث فما فوق من هذا المبنى\Nيخصّ الشركة المالكة
Dialogue: 0,0:06:18.67,0:06:22.63,Default,,0000,0000,0000,,سمعتُ أنّ الطابقين الأوّل والثاني مؤجران لشركتكم
Dialogue: 0,0:06:22.63,0:06:26.16,Default,,0000,0000,0000,,،ومما أخبرنا به حارس الأمن
Dialogue: 0,0:06:26.16,0:06:30.04,Default,,0000,0000,0000,,كانت الشركة المالكة مغلقة بما\Nأنّ اليوم عطلة أسبوع
Dialogue: 0,0:06:30.04,0:06:32.25,Default,,0000,0000,0000,,فباستثناء ناكاياما-سان وأساغي-سان
Dialogue: 0,0:06:32.25,0:06:34.68,Default,,0000,0000,0000,,لم يدخل أحد هذا المبنى
Dialogue: 0,0:06:35.28,0:06:37.64,Default,,0000,0000,0000,,هذا ما قاله
Dialogue: 0,0:06:37.90,0:06:39.93,Default,,0000,0000,0000,,تريد معرفة حجّة غيابنا إذاً؟
Dialogue: 0,0:06:41.24,0:06:42.61,Default,,0000,0000,0000,,...هذه مشكلة
Dialogue: 0,0:06:43.07,0:06:45.43,Default,,0000,0000,0000,,فلم يكن هناك من يشهد لنا
Dialogue: 0,0:06:49.73,0:06:52.06,Default,,0000,0000,0000,,...هذا المفتاح
Dialogue: 0,0:06:52.64,0:06:54.18,Default,,0000,0000,0000,,!يمكنني رؤية الشارع الأمامي
Dialogue: 0,0:06:54.72,0:06:58.14,Default,,0000,0000,0000,,بناءً من هذه الزاوية، فلا بدّ أن\Nهناك كاميرا على السطح
Dialogue: 0,0:06:58.80,0:07:00.22,Default,,0000,0000,0000,,إنّها تسجّل
Dialogue: 0,0:07:02.61,0:07:07.54,Default,,0000,0000,0000,,فهمت! تتغيّر زاوية الكاميرا آلياً
Dialogue: 0,0:07:07.54,0:07:09.96,Default,,0000,0000,0000,,ما يعني أنّه عندما تُضبط\Nعلى الوضع اليدوي
Dialogue: 0,0:07:09.96,0:07:12.61,Default,,0000,0000,0000,,تستعمل هذه العصا لتغيير الزاوية
Dialogue: 0,0:07:13.33,0:07:17.20,Default,,0000,0000,0000,,!أنت! لا تلمس أغراض الآخرين
Dialogue: 0,0:07:20.61,0:07:23.53,Default,,0000,0000,0000,,أهذه زوجتك يا ناكاياما-سان؟
Dialogue: 0,0:07:23.53,0:07:25.23,Default,,0000,0000,0000,,كلا، أختي
Dialogue: 0,0:07:25.23,0:07:26.35,Default,,0000,0000,0000,,أختك؟
Dialogue: 0,0:07:26.89,0:07:30.81,Default,,0000,0000,0000,,أجل، لكنّها تُوفيت في يناير هذا العام
Dialogue: 0,0:07:31.10,0:07:32.48,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:07:32.98,0:07:36.18,Default,,0000,0000,0000,,...يؤسفني سماع ذلك
Dialogue: 0,0:07:36.59,0:07:40.09,Default,,0000,0000,0000,,لكن وصولك لمنصب رئيس شركة\Nفي هذا العمر اليافع
Dialogue: 0,0:07:40.09,0:07:41.77,Default,,0000,0000,0000,,أمر مبهر بحق
Dialogue: 0,0:07:42.18,0:07:45.25,Default,,0000,0000,0000,,كانت هذه الشركة تحتويني\Nأنا وفوجي وأختي كوميكو فحسب
Dialogue: 0,0:07:45.25,0:07:47.12,Default,,0000,0000,0000,,من أيامي في الجامعة
Dialogue: 0,0:07:47.12,0:07:49.48,Default,,0000,0000,0000,,أسسناها كشركة متنوّعة الأعمال
Dialogue: 0,0:07:49.75,0:07:52.54,Default,,0000,0000,0000,,"خطر لنا اسم "أوجامانبو
Dialogue: 0,0:07:52.54,0:07:57.49,Default,,0000,0000,0000,,لأنّنا نذهب لمنازل الناس عشوائياً\Nونعرض عليهم تنفيذ أيّ عمل لهم
Dialogue: 0,0:07:57.49,0:07:58.43,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:07:58.99,0:08:03.28,Default,,0000,0000,0000,,لكن ما سرّنا هو أنّ عملنا ازدهر أكثر مما توقّعنا
Dialogue: 0,0:08:03.28,0:08:06.15,Default,,0000,0000,0000,,وبعد عامين، خطونا خطوتنا الأولى في التنظيف
Dialogue: 0,0:08:06.15,0:08:08.43,Default,,0000,0000,0000,,بتأسيس شركة تنظيف أوجامانبو
Dialogue: 0,0:08:09.85,0:08:13.10,Default,,0000,0000,0000,,تقلدتُ منصب رئيس الشركة
Dialogue: 0,0:08:13.10,0:08:17.02,Default,,0000,0000,0000,,وأشرف فوجي على العمل في منصب\Nمدير أعمال المنطقة الشرقية
Dialogue: 0,0:08:17.79,0:08:20.92,Default,,0000,0000,0000,,بينما عملت أختي كسكرتيرتي
Dialogue: 0,0:08:20.92,0:08:23.62,Default,,0000,0000,0000,,لكنّها ماتت في حادث في يناير
Dialogue: 0,0:08:24.58,0:08:25.49,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:08:25.49,0:08:28.70,Default,,0000,0000,0000,,سأخبرك بما أنّك ستكتشف\Nبالتحقيق بأيّ حال
Dialogue: 0,0:08:28.70,0:08:32.03,Default,,0000,0000,0000,,كانت هناك مشاكل بيني وفوجي
Dialogue: 0,0:08:32.03,0:08:32.89,Default,,0000,0000,0000,,مشاكل؟
Dialogue: 0,0:08:34.77,0:08:39.15,Default,,0000,0000,0000,,كان فوجي سيؤسس شركة تنظيفه الخاصة
Dialogue: 0,0:08:39.15,0:08:42.82,Default,,0000,0000,0000,,لذا حاول أخذ عدد من موظّفينا المهرة
Dialogue: 0,0:08:42.82,0:08:44.97,Default,,0000,0000,0000,,...للعمل معه، فكنّا
Dialogue: 0,0:08:45.89,0:08:49.68,Default,,0000,0000,0000,,نتشاجر كلّما التقينا
Dialogue: 0,0:08:50.22,0:08:53.40,Default,,0000,0000,0000,,كان يُفترض أن أتكلم\Nمع فوجي مُجدداً اليوم
Dialogue: 0,0:08:53.81,0:08:54.96,Default,,0000,0000,0000,,!اكتشفتُ الأمر
Dialogue: 0,0:08:54.96,0:08:56.80,Default,,0000,0000,0000,,بـ-بهذه السرعة؟
Dialogue: 0,0:08:57.13,0:09:01.38,Default,,0000,0000,0000,,كان ناكاياما-سان من أسقط\N!العارضة من سطح المبنى
Dialogue: 0,0:09:01.38,0:09:04.12,Default,,0000,0000,0000,,أساغي-سان وناكاياما-سان حبيبان
Dialogue: 0,0:09:04.12,0:09:08.22,Default,,0000,0000,0000,,!لذا هي تكذب للتغطية عليه
Dialogue: 0,0:09:10.66,0:09:13.14,Default,,0000,0000,0000,,ما-ما الذي يدعو للضحك؟
Dialogue: 0,0:09:13.45,0:09:17.09,Default,,0000,0000,0000,,مُحال أن أكون أنا والرئيس حبيبين
Dialogue: 0,0:09:17.61,0:09:21.11,Default,,0000,0000,0000,,آسف، لكنّك مخطئ يا موري-سان
Dialogue: 0,0:09:21.11,0:09:24.30,Default,,0000,0000,0000,,فهي ستتزوّج الشهر المقبل
Dialogue: 0,0:09:24.68,0:09:27.39,Default,,0000,0000,0000,,تتزوّج؟
Dialogue: 0,0:09:29.18,0:09:30.26,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:09:30.26,0:09:32.93,Default,,0000,0000,0000,,كان خفيفاً، لكن وجدنا أثر من عارضة معدنية
Dialogue: 0,0:09:32.93,0:09:34.67,Default,,0000,0000,0000,,على سطح المبنى المهجور المجاور
Dialogue: 0,0:09:34.87,0:09:36.12,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:09:36.12,0:09:38.83,Default,,0000,0000,0000,,سقطت العارضة من سطح \N!المبنى المهجور إذاً
Dialogue: 0,0:09:39.00,0:09:42.80,Default,,0000,0000,0000,,وجدنا هذه الهارمونيكا بجوار الجثّة أيضاً
Dialogue: 0,0:09:42.80,0:09:46.75,Default,,0000,0000,0000,,اسمه عليها، فيبدو أنّها كانت تخصّ فوجي-سان
Dialogue: 0,0:09:47.20,0:09:49.86,Default,,0000,0000,0000,,تلك له بالفعل
Dialogue: 0,0:09:49.86,0:09:52.09,Default,,0000,0000,0000,,فقد رأيتُها عدّة مرات
Dialogue: 0,0:09:52.78,0:09:56.04,Default,,0000,0000,0000,,لكننا لم نجد أيّ بصمات عليها
Dialogue: 0,0:09:57.77,0:10:01.60,Default,,0000,0000,0000,,إنّها نظيفة كما لو مُسحت بقطعة قماش
Dialogue: 0,0:10:01.60,0:10:05.18,Default,,0000,0000,0000,,إذا كانت تخصّ فوجي-سان، أفلا يُفترض\Nأن تكون بصماته عليها؟
Dialogue: 0,0:10:05.18,0:10:07.37,Default,,0000,0000,0000,,...أجل، لكن
Dialogue: 0,0:10:07.93,0:10:10.18,Default,,0000,0000,0000,,المعذرة، تذكّرتُ عملاً صغيراً
Dialogue: 0,0:10:10.18,0:10:12.18,Default,,0000,0000,0000,,هل تمانعون خروجي قليلاً؟
Dialogue: 0,0:10:12.18,0:10:13.69,Default,,0000,0000,0000,,كلا، البتّة
Dialogue: 0,0:10:13.69,0:10:14.71,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:10:15.00,0:10:18.92,Default,,0000,0000,0000,,أساغي-سان، اتّصلي بوالديّ\Nفوجي-كن وخطيبته
Dialogue: 0,0:10:18.92,0:10:19.58,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:22.54,0:10:25.03,Default,,0000,0000,0000,,لفوجي-سان خطيبة؟
Dialogue: 0,0:10:25.03,0:10:27.74,Default,,0000,0000,0000,,أجل، يبدو أنّها ابنة رجل ثريّ
Dialogue: 0,0:10:27.74,0:10:29.91,Default,,0000,0000,0000,,ورأس مال تأسيس شركته الجديدة
Dialogue: 0,0:10:29.91,0:10:32.21,Default,,0000,0000,0000,,كان سيأتي منه وفقما يبدو
Dialogue: 0,0:10:32.21,0:10:35.96,Default,,0000,0000,0000,,أخبريني، كيف ماتت أخت ناكاياما-سان؟
Dialogue: 0,0:10:35.96,0:10:37.98,Default,,0000,0000,0000,,كانت حادثة
Dialogue: 0,0:10:37.98,0:10:38.90,Default,,0000,0000,0000,,حادثة؟
Dialogue: 0,0:10:38.90,0:10:39.67,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:40.23,0:10:43.23,Default,,0000,0000,0000,,يبدو أنّها خاضت شجاراً شديداً مع أخيها
Dialogue: 0,0:10:43.23,0:10:44.72,Default,,0000,0000,0000,,واستقالت في ديسمبر العام الفائت
Dialogue: 0,0:10:44.72,0:10:47.87,Default,,0000,0000,0000,,وتمّ تعييني مكانها
Dialogue: 0,0:10:48.20,0:10:52.84,Default,,0000,0000,0000,,لكنّها عملت بدوام جزئيّ\Nفي شركة إنشاء في يوكوهاما
Dialogue: 0,0:10:52.84,0:10:56.79,Default,,0000,0000,0000,,وسقطت عليها عارضة حديدية\Nعلى الرأس في موقع البناء
Dialogue: 0,0:10:56.79,0:10:58.17,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:58.17,0:11:01.25,Default,,0000,0000,0000,,!هذا كحادثة صباح اليوم تماماً
Dialogue: 0,0:11:01.50,0:11:05.71,Default,,0000,0000,0000,,...لذا كنتُ أفكّر برعب المصادفات أحياناً
Dialogue: 0,0:11:06.28,0:11:08.42,Default,,0000,0000,0000,,أكانت مصادفة حقّاً؟
Dialogue: 0,0:11:08.87,0:11:11.37,Default,,0000,0000,0000,,أيمكن أنّ لموت أخته
Dialogue: 0,0:11:11.37,0:11:13.46,Default,,0000,0000,0000,,علاقة ما بهذه الحادثة؟
Dialogue: 0,0:11:14.56,0:11:18.42,Default,,0000,0000,0000,,في تلك الحالة، يُرجّح جدّاً أن\Nناكاياما-سان كان الفاعل
Dialogue: 0,0:11:19.11,0:11:20.88,Default,,0000,0000,0000,,لكن كيف؟
Dialogue: 0,0:11:21.23,0:11:24.05,Default,,0000,0000,0000,,بأيّ حال، سأعيد استجواب العمّال
Dialogue: 0,0:11:24.05,0:11:26.21,Default,,0000,0000,0000,,الذين كانوا ينظّفون البناية المقابلة
Dialogue: 0,0:11:26.68,0:11:28.44,Default,,0000,0000,0000,,ابقوا هنا
Dialogue: 0,0:11:28.44,0:11:30.26,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:11:30.26,0:11:31.42,Default,,0000,0000,0000,,هيّا، لنذهب
Dialogue: 0,0:11:31.42,0:11:32.42,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:32.80,0:11:37.46,Default,,0000,0000,0000,,بعد دخوله هذه الغرفة، غيّر ناكاياما-سان\Nوضعية الكاميرا للآلية
Dialogue: 0,0:11:37.46,0:11:42.42,Default,,0000,0000,0000,,إذا كان القاتل، فلا بدّ أن ذلك مفتاح لشيء
Dialogue: 0,0:11:46.08,0:11:49.13,Default,,0000,0000,0000,,!يمكنني رؤية الطريق المقابل! هذا رائع
Dialogue: 0,0:11:49.49,0:11:53.52,Default,,0000,0000,0000,,هذا تسجيل كاميرا مراقبة على السطح
Dialogue: 0,0:11:53.52,0:11:54.82,Default,,0000,0000,0000,,كاميرا مراقبة؟
Dialogue: 0,0:11:54.82,0:11:59.32,Default,,0000,0000,0000,,أجل، يتفقّد رئيس الشركة الشاشة دوماً
Dialogue: 0,0:11:59.32,0:12:02.80,Default,,0000,0000,0000,,للتأكد من عدم وجود قمامة\Nعلى الشارع مقابل المبنى
Dialogue: 0,0:12:03.15,0:12:07.47,Default,,0000,0000,0000,,فهمت، هذه سياسة رئيس شركة تنظيف
Dialogue: 0,0:12:07.47,0:12:10.34,Default,,0000,0000,0000,,أجل، أفكاره فريدة دوماً
Dialogue: 0,0:12:10.34,0:12:13.06,Default,,0000,0000,0000,,شاحنة مانبو كانت فكرته أيضاً
Dialogue: 0,0:12:13.06,0:12:17.79,Default,,0000,0000,0000,,ركنها أمام مبنى لامع النظافة\Nيشكّل إعلاناً ممتازاً
Dialogue: 0,0:12:17.79,0:12:20.63,Default,,0000,0000,0000,,هذه مضبوطة على الوضع الآلي
Dialogue: 0,0:12:20.63,0:12:23.34,Default,,0000,0000,0000,,لكن أيمكننا رؤية ذاك الزقاق\Nإن بدّلناها لليدوي؟
Dialogue: 0,0:12:23.79,0:12:26.54,Default,,0000,0000,0000,,لستُ متأكدة، لمَ لا تجرب؟
Dialogue: 0,0:12:26.54,0:12:27.14,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:12:38.11,0:12:39.66,Default,,0000,0000,0000,,لا يمكننا رؤيته أبداً
Dialogue: 0,0:12:39.66,0:12:40.66,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:45.10,0:12:46.67,Default,,0000,0000,0000,,ما هذا الشريط؟
Dialogue: 0,0:12:46.67,0:12:48.50,Default,,0000,0000,0000,,منظار؟
Dialogue: 0,0:12:48.50,0:12:49.35,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:12:50.35,0:12:53.35,Default,,0000,0000,0000,,!لا يصحّ بك فتح أدراج الآخرين
Dialogue: 0,0:12:56.59,0:12:59.50,Default,,0000,0000,0000,,!سأذهب للسطح قليلاً
Dialogue: 0,0:13:04.75,0:13:06.50,Default,,0000,0000,0000,,هذه كاميرا المراقبة إذاً
Dialogue: 0,0:13:06.50,0:13:08.10,Default,,0000,0000,0000,,إنّها كبيرة الحجم
Dialogue: 0,0:13:12.75,0:13:16.21,Default,,0000,0000,0000,,البناية المهجورة المقابلة\Nأقصر بطابق من هذه
Dialogue: 0,0:13:16.99,0:13:19.67,Default,,0000,0000,0000,,لا بدّ أن ذاك الأثر\Nالذي تركه انزلاق العارضة الحديدة
Dialogue: 0,0:13:20.28,0:13:21.99,Default,,0000,0000,0000,,فرق الارتفاع هذا يمنع العودة
Dialogue: 0,0:13:21.99,0:13:24.10,Default,,0000,0000,0000,,للمبنى المرتفع بعد إسقاط العارضة
Dialogue: 0,0:13:24.10,0:13:26.12,Default,,0000,0000,0000,,من المبنى المنخفض
Dialogue: 0,0:13:28.14,0:13:30.39,Default,,0000,0000,0000,,معنى ذلك لا يمكن لناكاياما-سان إسقاط العارضة
Dialogue: 0,0:13:30.39,0:13:33.06,Default,,0000,0000,0000,,بما أنّه كان في هذا المبنى
Dialogue: 0,0:13:33.06,0:13:36.08,Default,,0000,0000,0000,,كما أنّه كان في مكتبه وقت الحادثة
Dialogue: 0,0:13:41.97,0:13:43.75,Default,,0000,0000,0000,,...لحظة، أيمكن
Dialogue: 0,0:13:46.12,0:13:47.21,Default,,0000,0000,0000,,ها هو
Dialogue: 0,0:13:47.21,0:13:49.21,Default,,0000,0000,0000,,إنّه خفيف، لكن يوجد أثر خدش حديث
Dialogue: 0,0:13:49.21,0:13:50.50,Default,,0000,0000,0000,,!من شيء رفيع
Dialogue: 0,0:13:54.36,0:13:55.57,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:13:55.57,0:13:58.20,Default,,0000,0000,0000,,سيمكنه إسقاط العارضة حتّى من مكتبه
Dialogue: 0,0:13:58.20,0:14:00.00,Default,,0000,0000,0000,,باستعمال هذه الطريقة
Dialogue: 0,0:14:00.36,0:14:03.86,Default,,0000,0000,0000,,لكن كيف عرف أنّ فوجي-سان\Nكان في الزقاق؟
Dialogue: 0,0:14:07.70,0:14:08.67,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:14:17.55,0:14:18.68,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:14:18.68,0:14:21.59,Default,,0000,0000,0000,,لا شيء من الطوابق السفلية يعكس ما بالزقاق
Dialogue: 0,0:14:22.05,0:14:24.42,Default,,0000,0000,0000,,أكان مستحيلاً على ناكاياما-سان\Nارتكاب الجريمة حقّاً؟
Dialogue: 0,0:14:24.42,0:14:26.04,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:14:26.37,0:14:28.17,Default,,0000,0000,0000,,ما الذي تفعله؟
Dialogue: 0,0:14:28.17,0:14:30.50,Default,,0000,0000,0000,,...لا-لا شيء
Dialogue: 0,0:14:31.08,0:14:33.09,Default,,0000,0000,0000,,...لحظة، كما أذكر
Dialogue: 0,0:14:33.86,0:14:34.86,Default,,0000,0000,0000,,!أساغي-سان
Dialogue: 0,0:14:34.86,0:14:37.87,Default,,0000,0000,0000,,انقلي شاحنة مانبو\N!من المبنى المقابل فوراً
Dialogue: 0,0:14:38.49,0:14:40.07,Default,,0000,0000,0000,,!فهمت الآن
Dialogue: 0,0:14:40.07,0:14:43.06,Default,,0000,0000,0000,,!لهذا لم تتواجد أيّ بصمات على الهارمونيكا
Dialogue: 0,0:14:43.73,0:14:45.87,Default,,0000,0000,0000,,!كان الفاعل ناكاياما-سان حقّاً
Dialogue: 0,0:14:48.31,0:14:49.46,Default,,0000,0000,0000,,كيف مضى الأمر حضرة المفتّش؟
Dialogue: 0,0:14:49.46,0:14:51.23,Default,,0000,0000,0000,,لا نتائج
Dialogue: 0,0:14:51.23,0:14:53.34,Default,,0000,0000,0000,,يبدو أنّهم أنهوا تنظيف النوافذ
Dialogue: 0,0:14:53.34,0:14:56.55,Default,,0000,0000,0000,,وانتقلوا لتنظيف الطابق الأول\Nعندما وقعت الحادثة
Dialogue: 0,0:14:56.55,0:14:58.47,Default,,0000,0000,0000,,قالوا أنّهم لم يروا شيئاً
Dialogue: 0,0:14:58.47,0:14:59.75,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:15:00.14,0:15:01.14,Default,,0000,0000,0000,,...تبّاً
Dialogue: 0,0:15:01.14,0:15:02.89,Default,,0000,0000,0000,,هل ستثبت مجرّد مراجعة التسجيل
Dialogue: 0,0:15:02.89,0:15:06.17,Default,,0000,0000,0000,,أنّه حرّك الكاميرا الوحيدة على السطح؟
Dialogue: 0,0:15:06.17,0:15:07.71,Default,,0000,0000,0000,,...لكن أيكفي ذلك
Dialogue: 0,0:15:07.71,0:15:09.62,Default,,0000,0000,0000,,ليكون دليلاً قاطعاً؟
Dialogue: 0,0:15:23.71,0:15:24.54,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:15:29.19,0:15:31.94,Default,,0000,0000,0000,,!حسناً، لديّ الدليل الآن
Dialogue: 0,0:15:31.94,0:15:33.37,Default,,0000,0000,0000,,أعتذر على الإطالة
Dialogue: 0,0:15:34.23,0:15:37.26,Default,,0000,0000,0000,,ناكاياما-سان، انتهينا اليوم
Dialogue: 0,0:15:37.26,0:15:39.80,Default,,0000,0000,0000,,سنتواصل معك في وقت لاحق
Dialogue: 0,0:15:39.80,0:15:40.75,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:15:40.75,0:15:41.93,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:15:41.93,0:15:45.34,Default,,0000,0000,0000,,!سيُمسح هذا التسجيل إن لاحظه ناكاياما-سان
Dialogue: 0,0:15:45.34,0:15:47.75,Default,,0000,0000,0000,,!لا خيار أمامي، سأستعمل طريقتي المعتادة
Dialogue: 0,0:15:49.34,0:15:50.67,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:56.58,0:15:57.99,Default,,0000,0000,0000,,ما الأمر يا موري-كن؟
Dialogue: 0,0:15:57.99,0:16:01.75,Default,,0000,0000,0000,,حضرة المفتّش، لا يمكن المغادرة بعد
Dialogue: 0,0:16:01.75,0:16:06.19,Default,,0000,0000,0000,,فقد تبيّنت لي الحيلة الماكرة
Dialogue: 0,0:16:06.19,0:16:09.42,Default,,0000,0000,0000,,التي استعملها ناكاياما-سان\Nلقتل فوجي-سان من هذه الغرفة
Dialogue: 0,0:16:09.42,0:16:11.07,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:16:11.07,0:16:14.25,Default,,0000,0000,0000,,!أتقصد أنّ ناكاياما-سان هو القاتل؟
Dialogue: 0,0:16:14.25,0:16:18.83,Default,,0000,0000,0000,,أجل، مفتاح الحيلة هو كاميرا المراقبة على السطح
Dialogue: 0,0:16:18.83,0:16:20.29,Default,,0000,0000,0000,,كاميرا المراقبة؟
Dialogue: 0,0:16:20.64,0:16:24.80,Default,,0000,0000,0000,,وضع ناكاياما-سان عارضة حديدية\Nعلى سطح البناية المجاورة
Dialogue: 0,0:16:24.80,0:16:29.67,Default,,0000,0000,0000,,ثم ربطها بكاميرا المراقبة بشيء رفيع
Dialogue: 0,0:16:29.67,0:16:32.75,Default,,0000,0000,0000,,سلك بيانو على الأرجح
Dialogue: 0,0:16:33.87,0:16:37.17,Default,,0000,0000,0000,,،بعدها، عندما دخل فوجي-سان الزقاق
Dialogue: 0,0:16:37.17,0:16:39.04,Default,,0000,0000,0000,,حرّك كاميرا المراقبة
Dialogue: 0,0:16:39.04,0:16:41.25,Default,,0000,0000,0000,,التي حوّلها للوضع اليدوي سلفاً
Dialogue: 0,0:16:55.31,0:17:00.72,Default,,0000,0000,0000,,سبب جعله أساغي-سان تتفقد\Nما حصل بالخارج
Dialogue: 0,0:17:00.72,0:17:02.52,Default,,0000,0000,0000,,هو كي يصعد للسطح
Dialogue: 0,0:17:02.52,0:17:05.58,Default,,0000,0000,0000,,وينزع سلك البيانو من الكاميرا
Dialogue: 0,0:17:06.01,0:17:08.51,Default,,0000,0000,0000,,وسبب خروجه قبل قليل
Dialogue: 0,0:17:08.51,0:17:11.42,Default,,0000,0000,0000,,هو للتخلّص من ذاك السلك
Dialogue: 0,0:17:11.76,0:17:12.92,Default,,0000,0000,0000,,ألستُ محقّاً؟
Dialogue: 0,0:17:13.58,0:17:18.29,Default,,0000,0000,0000,,فوق خطئك، فهناك خلل جوهريّ\Nفي استنتاجك يا موري-سان
Dialogue: 0,0:17:18.29,0:17:21.41,Default,,0000,0000,0000,,كيف لي أن أعرف وقت\Nدخول فوجي-كن الزقاق
Dialogue: 0,0:17:21.41,0:17:23.68,Default,,0000,0000,0000,,وأنا هنا؟
Dialogue: 0,0:17:24.49,0:17:25.90,Default,,0000,0000,0000,,أتفق معه
Dialogue: 0,0:17:25.90,0:17:28.32,Default,,0000,0000,0000,,سيكون مستحيلاً إسقاط العارضة\Nعلى فوجي-سان
Dialogue: 0,0:17:28.32,0:17:30.34,Default,,0000,0000,0000,,لو أخطأ التوقيت ولو بثانية
Dialogue: 0,0:17:30.34,0:17:35.79,Default,,0000,0000,0000,,،كي يجعل فوجي-سان يقف في نقطة محددة
Dialogue: 0,0:17:36.67,0:17:39.13,Default,,0000,0000,0000,,سرق ناكاياما-سان الهارمونيكا خاصته سلفاً
Dialogue: 0,0:17:39.13,0:17:41.59,Default,,0000,0000,0000,,ووضعها في الزقاق
Dialogue: 0,0:17:42.64,0:17:47.04,Default,,0000,0000,0000,,ثمّ استعمل المنظار لرؤية\Nدخول فوجي-سان الزقاق
Dialogue: 0,0:17:47.04,0:17:50.25,Default,,0000,0000,0000,,كيف؟ لا يمكنك رؤية الزقاق من هنا
Dialogue: 0,0:17:50.25,0:17:52.92,Default,,0000,0000,0000,,حضرة المفتّش، في وقت وقوع الحادثة
Dialogue: 0,0:17:52.92,0:17:55.29,Default,,0000,0000,0000,,كانت شاحنة مانبو مركونة
Dialogue: 0,0:17:55.29,0:17:57.58,Default,,0000,0000,0000,,أمام المبنى المقابل
Dialogue: 0,0:17:57.58,0:18:01.59,Default,,0000,0000,0000,,وعين الشعار كانت مرآة
Dialogue: 0,0:18:01.59,0:18:02.67,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:18:03.11,0:18:05.20,Default,,0000,0000,0000,,أفهمت الآن؟
Dialogue: 0,0:18:05.20,0:18:09.61,Default,,0000,0000,0000,,استعمل ناكاياما-سان المنظار\Nلرؤية انعكاس الزقاق
Dialogue: 0,0:18:09.61,0:18:11.84,Default,,0000,0000,0000,,ثمّ أسقط العارضة
Dialogue: 0,0:18:12.24,0:18:14.25,Default,,0000,0000,0000,,انتظر اللحظة المناسبة
Dialogue: 0,0:18:17.35,0:18:20.35,Default,,0000,0000,0000,,لذا طلبتَ تحريك شاحنة مانبو
Dialogue: 0,0:18:20.35,0:18:22.92,Default,,0000,0000,0000,,فورما رأيت جثّة فوجي-سان
Dialogue: 0,0:18:22.92,0:18:26.04,Default,,0000,0000,0000,,كيلا تنتبه الشرطة لحيلتك
Dialogue: 0,0:18:27.34,0:18:30.43,Default,,0000,0000,0000,,لكنّك ارتكبت خطأً
Dialogue: 0,0:18:30.43,0:18:35.83,Default,,0000,0000,0000,,أسقطتَ العارضة قبل أن\Nيمسك فوجي-سان بالهارمونيكا
Dialogue: 0,0:18:37.33,0:18:41.58,Default,,0000,0000,0000,,لذا لم تكن بصماته عليها
Dialogue: 0,0:18:41.58,0:18:43.54,Default,,0000,0000,0000,,تعجّلت
Dialogue: 0,0:18:46.82,0:18:48.16,Default,,0000,0000,0000,,لا يمكن لومك
Dialogue: 0,0:18:48.61,0:18:52.00,Default,,0000,0000,0000,,فقد تدّخلت ران في أسوأ وقت
Dialogue: 0,0:18:58.94,0:19:01.94,Default,,0000,0000,0000,,لكن لا دليل لديك يا موري-سان
Dialogue: 0,0:19:01.94,0:19:06.55,Default,,0000,0000,0000,,وفقاً لاستنتاجك، فقد تخلّصتُ من سلك البيانو سلفاً
Dialogue: 0,0:19:06.55,0:19:08.40,Default,,0000,0000,0000,,الدليل موجود
Dialogue: 0,0:19:09.25,0:19:13.13,Default,,0000,0000,0000,,بعدما استعملت كاميرا المراقبة لإسقاط العارضة
Dialogue: 0,0:19:13.13,0:19:15.71,Default,,0000,0000,0000,,غيّرت زاوية الكاميرا
Dialogue: 0,0:19:15.71,0:19:17.96,Default,,0000,0000,0000,,كيف يسهل نزع سلك البيانو
Dialogue: 0,0:19:18.63,0:19:20.21,Default,,0000,0000,0000,,آنذاك، سجّلت الكاميرا الانعكاس
Dialogue: 0,0:19:20.21,0:19:23.91,Default,,0000,0000,0000,,في نوافذ البناية المقابلة الزجاجية
Dialogue: 0,0:19:23.91,0:19:26.20,Default,,0000,0000,0000,,الباقي لك يا كونان
Dialogue: 0,0:19:27.53,0:19:29.69,Default,,0000,0000,0000,,!اجتمعوا هنا
Dialogue: 0,0:19:29.69,0:19:30.89,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:19:35.11,0:19:36.79,Default,,0000,0000,0000,,راقبوا جميعاً
Dialogue: 0,0:19:40.48,0:19:44.35,Default,,0000,0000,0000,,يمكنكم رؤية الكاميرا في انعكاس النوافذ، صحيح؟
Dialogue: 0,0:19:44.35,0:19:45.71,Default,,0000,0000,0000,,...بعد قليل
Dialogue: 0,0:19:48.26,0:19:48.71,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:20:04.92,0:20:06.12,Default,,0000,0000,0000,,!الرئيس
Dialogue: 0,0:20:09.91,0:20:12.84,Default,,0000,0000,0000,,كانت أختي على علاقة بفوجي
Dialogue: 0,0:20:14.82,0:20:18.48,Default,,0000,0000,0000,,لكنّ فوجي التقى ابنة رجل ثريّ
Dialogue: 0,0:20:18.48,0:20:20.71,Default,,0000,0000,0000,,وتخلّى عن أختي كما لو كانت نكرة
Dialogue: 0,0:20:21.48,0:20:24.66,Default,,0000,0000,0000,,استقالت أختي جرّاء ذلك
Dialogue: 0,0:20:25.22,0:20:27.97,Default,,0000,0000,0000,,لم يكن بسبب شجاركما إذاً؟
Dialogue: 0,0:20:27.97,0:20:30.13,Default,,0000,0000,0000,,ذلك ما اعتقدتُه أيضاً
Dialogue: 0,0:20:30.39,0:20:34.13,Default,,0000,0000,0000,,فقد تُوفيّ أبوانا في صغرنا
Dialogue: 0,0:20:34.13,0:20:37.13,Default,,0000,0000,0000,,لطالما اعتبرتني أختي كالأب
Dialogue: 0,0:20:37.13,0:20:38.80,Default,,0000,0000,0000,,لكنّها أصبحت مرتبكة
Dialogue: 0,0:20:38.80,0:20:41.67,Default,,0000,0000,0000,,فتركت الشركة للابتعاد من أخيها
Dialogue: 0,0:20:41.67,0:20:44.12,Default,,0000,0000,0000,,ذلك ما ظننتُه
Dialogue: 0,0:20:44.12,0:20:46.04,Default,,0000,0000,0000,,لكن لم يكن الوضع كذلك
Dialogue: 0,0:20:48.45,0:20:50.91,Default,,0000,0000,0000,,،بعد موتها في الحادثة
Dialogue: 0,0:20:50.91,0:20:54.48,Default,,0000,0000,0000,,ذهبت لشقّتها في يوكوهاما لجمع أغراضها
Dialogue: 0,0:21:05.10,0:21:08.13,Default,,0000,0000,0000,,أدركتُ كلّ شيء آنذاك
Dialogue: 0,0:21:08.55,0:21:11.21,Default,,0000,0000,0000,,لذا مسحت البصمات عن الهارمونيكا\Nووضعتها في الزقاق؟
Dialogue: 0,0:21:11.72,0:21:15.76,Default,,0000,0000,0000,,!لو لم يهجر فوجي أختي، لما ماتت
Dialogue: 0,0:21:15.76,0:21:18.67,Default,,0000,0000,0000,,!لم أستطع مسامحته
Dialogue: 0,0:21:23.83,0:21:26.08,Default,,0000,0000,0000,,لكنّ الأمر مثير للسخرية حقّاً
Dialogue: 0,0:21:26.45,0:21:30.79,Default,,0000,0000,0000,,استعملتُ مرآة شاحنة مانبو لارتكاب جريمة
Dialogue: 0,0:21:30.79,0:21:35.83,Default,,0000,0000,0000,,ثمّ تمت إدانتي لانعكاسي في زجاج النوافذ
Dialogue: 0,0:21:35.83,0:21:39.24,Default,,0000,0000,0000,,وكانت شركتك بالذات
Dialogue: 0,0:21:39.24,0:21:41.88,Default,,0000,0000,0000,,هي من مسح ذاك الزجاج
Dialogue: 0,0:21:42.40,0:21:43.73,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:21:43.73,0:21:46.23,Default,,0000,0000,0000,,فتقنيات تنظيف شركة أوجامانبو
Dialogue: 0,0:21:46.23,0:21:47.86,Default,,0000,0000,0000,,!هي الأفضل في العالم
Dialogue: 0,0:21:49.98,0:21:51.88,Default,,0000,0000,0000,,...أخي
Dialogue: 0,0:23:29.63,0:23:32.67,Default,,0000,0000,0000,,مرّت أمامي شاحنة مانبو اليوم
Dialogue: 0,0:23:32.67,0:23:35.66,Default,,0000,0000,0000,,يبدو أنّ الشركة لا تزال تعمل\Nحتّى بعد اعتقال الرئيس
Dialogue: 0,0:23:35.66,0:23:40.37,Default,,0000,0000,0000,,أجل، لكن يبدو أنّ مساعدته أساغي-سان استقالت
Dialogue: 0,0:23:40.37,0:23:42.45,Default,,0000,0000,0000,,لا بدّ أنّ الأمر صدمها
Dialogue: 0,0:23:42.45,0:23:44.08,Default,,0000,0000,0000,,ما الذي تفعله الآن يا ترى؟
Dialogue: 0,0:23:44.61,0:23:45.54,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:23:46.02,0:23:50.15,Default,,0000,0000,0000,,!أنا مُذيعة أوجامانبو الجديدة، أساغي كونيكو
Dialogue: 0,0:23:52.11,0:23:54.20,Default,,0000,0000,0000,,يُشرفني الوجود هنا
Dialogue: 0,0:23:55.51,0:23:57.55,Default,,0000,0000,0000,,...يا للمرأة الصلبة
Dialogue: 0,0:24:09.09,0:24:13.95,Default,,0000,0000,0000,,كلا، لا بدّ أنها وجدت دليلاً\Nلا نزال نجهله
Dialogue: 0,0:24:14.53,0:24:17.42,Default,,0000,0000,0000,,بالمناسبة، كانت أياكاو-سان تتصرف بغرابة\Nنوعاً ما ظهيرة اليوم
Dialogue: 0,0:24:18.46,0:24:19.65,Default,,0000,0000,0000,,!مـ-ماذا؟
Dialogue: 0,0:24:22.24,0:24:24.06,Default,,0000,0000,0000,,أيمكن أنّ أياكو-سان هناك؟
Dialogue: 0,0:24:24.06,0:24:30.06,On Top,,0000,0000,15,,(جريمة قتل مهووس هولمز (الجزء الأوّل
Dialogue: 0,0:24:24.77,0:24:26.11,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.11,0:24:29.23,Default,,0000,0000,0000,,(جريمة قتل مهووس هولمز (الجزء الأوّل
Dialogue: 0,0:24:45.61,0:24:48.06,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.06,0:24:49.69,Default,,0000,0000,0000,,لحاف
Dialogue: 0,0:24:50.21,0:24:52.20,Default,,0000,0000,0000,,!يرجع منافس كونان في الحلقة القادمة
Dialogue: 0,0:24:52.20,0:24:53.76,Default,,0000,0000,0000,,!ماذا؟! أنا مجدّداً؟
Dialogue: 0,0:24:53.76,0:24:55.76,Default,,0000,0000,0000,,!ليس أنت

