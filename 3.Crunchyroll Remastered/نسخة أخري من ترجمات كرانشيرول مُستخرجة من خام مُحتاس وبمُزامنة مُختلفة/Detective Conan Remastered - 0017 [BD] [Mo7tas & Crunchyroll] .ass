Dialogue: 0,0:00:00.49,0:00:02.14,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.14,0:00:05.12,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.12,0:00:08.07,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل مُتحرٍّ عظيم
Dialogue: 0,0:00:08.07,0:00:10.03,Default,,0000,0000,0000,,تدور أحداث قضيّة اليوم في مركز تسوّق ليلاً
Dialogue: 0,0:00:10.24,0:00:11.57,Default,,0000,0000,0000,,...الطوابق الفارغة بعد وقت الإغلاق
Dialogue: 0,0:00:12.04,0:00:14.86,Default,,0000,0000,0000,,!حتّى تحت غطاء الليل، الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.89,0:01:49.02,Default,,0000,0000,0000,,سرقة مركز التسوق
Dialogue: 0,0:01:59.80,0:02:01.43,Default,,0000,0000,0000,,!أنت لنا الآن يا يايبا
Dialogue: 0,0:02:01.43,0:02:04.12,Default,,0000,0000,0000,,!أرسلاه للجحيم
Dialogue: 0,0:02:06.12,0:02:08.88,Default,,0000,0000,0000,,!سأحمي أنا، يايبا، سلام الأرض
Dialogue: 0,0:02:08.88,0:02:10.33,Default,,0000,0000,0000,,!يايبا
Dialogue: 0,0:02:10.33,0:02:12.24,Default,,0000,0000,0000,,!اقض على هؤلاء الأشرار
Dialogue: 0,0:02:12.24,0:02:13.34,Default,,0000,0000,0000,,!استعمل ركلتك
Dialogue: 0,0:02:14.92,0:02:17.09,Default,,0000,0000,0000,,!ركلة يايبا
Dialogue: 0,0:02:17.99,0:02:21.55,Default,,0000,0000,0000,,أنا طالبٌ في الثانوية، فلمَ أشاهد\Nمسرحيات كهذه؟
Dialogue: 0,0:02:22.06,0:02:25.15,Default,,0000,0000,0000,,لا تُحب يايبا يا كونان-كن؟
Dialogue: 0,0:02:25.15,0:02:29.68,Default,,0000,0000,0000,,!أ-أحبه كثيراً! انطلق يا يايبا
Dialogue: 0,0:02:33.93,0:02:36.14,Default,,0000,0000,0000,,!حسنٌ، سنلتقط الصورة
Dialogue: 0,0:02:41.14,0:02:42.75,Default,,0000,0000,0000,,!يا للتسلية
Dialogue: 0,0:02:43.00,0:02:47.34,Default,,0000,0000,0000,,شكراً على تسوّقكم معنا اليوم
Dialogue: 0,0:02:48.63,0:02:53.17,Default,,0000,0000,0000,,شكراً جزيلاً، نتمنى رؤيتكم مُجدداً
Dialogue: 0,0:02:53.17,0:02:54.95,Default,,0000,0000,0000,,!إلى اللقاء
Dialogue: 0,0:02:54.95,0:02:56.38,Default,,0000,0000,0000,,!إلى اللقاء
Dialogue: 0,0:02:57.37,0:03:02.29,Default,,0000,0000,0000,,!يايبا! يايبا! يقاتل للعدالة! يايبا
Dialogue: 0,0:03:02.29,0:03:05.27,Default,,0000,0000,0000,,!ا-اختفى
Dialogue: 0,0:03:05.27,0:03:07.40,Default,,0000,0000,0000,,!توقيع يايبا
Dialogue: 0,0:03:07.40,0:03:09.69,Default,,0000,0000,0000,,فقدته؟
Dialogue: 0,0:03:09.69,0:03:13.34,Default,,0000,0000,0000,,...كنتُ سأكتنزه لبقيّة حياتي أيضاً
Dialogue: 0,0:03:14.01,0:03:15.60,Default,,0000,0000,0000,,...انتظر لحظة
Dialogue: 0,0:03:15.60,0:03:19.97,Default,,0000,0000,0000,,...بعد التقاطنا الصورة مع يايبا، وفقما أذكر
Dialogue: 0,0:03:19.97,0:03:21.82,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:03:22.29,0:03:24.45,Default,,0000,0000,0000,,أريني الصورة يا أيومي-تشان
Dialogue: 0,0:03:24.45,0:03:25.31,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:03:26.26,0:03:27.18,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:03:27.97,0:03:31.99,Default,,0000,0000,0000,,...قال غينتا أنّه جائع عندما التقطناها على ما أذكر
Dialogue: 0,0:03:34.50,0:03:39.09,Default,,0000,0000,0000,,...أجل، اشتريتُ هوت دوغ ثمّ
Dialogue: 0,0:03:39.95,0:03:42.71,Default,,0000,0000,0000,,!إنّه ذاك المحلّ! سأذهب لأخذه
Dialogue: 0,0:03:43.02,0:03:47.98,Default,,0000,0000,0000,,لكنّ المركز مغلقٌ الآن، يجدر بك تأجيله للغد
Dialogue: 0,0:03:47.98,0:03:51.97,Default,,0000,0000,0000,,!افعل ما تشاء، أنا سأذهب لأخذه
Dialogue: 0,0:03:51.97,0:03:53.31,Default,,0000,0000,0000,,!غينتا-كن
Dialogue: 0,0:03:53.31,0:03:54.64,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:03:54.64,0:03:55.17,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:03:55.72,0:03:59.63,Default,,0000,0000,0000,,تبّاً، ارتدّ تحليلي عليّ
Dialogue: 0,0:04:08.96,0:04:13.83,Default,,0000,0000,0000,,بسرعة من فضلكما، سيتفعّل نظام الأمان\Nبعد 10 دقائق
Dialogue: 0,0:04:13.83,0:04:20.41,Default,,0000,0000,0000,,غينتا-كن، سيُقفل الباب عندما\Nيتفعّل نظام الأمان
Dialogue: 0,0:04:20.41,0:04:23.42,Default,,0000,0000,0000,,!يمكنني أخذه في أقلّ من 10 دقائق
Dialogue: 0,0:04:23.86,0:04:24.81,Default,,0000,0000,0000,,إلى اللقاء
Dialogue: 0,0:04:24.81,0:04:25.88,Default,,0000,0000,0000,,مع السلامة
Dialogue: 0,0:04:25.88,0:04:26.71,Default,,0000,0000,0000,,!الآن
Dialogue: 0,0:04:27.28,0:04:28.78,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:04:28.78,0:04:30.53,Default,,0000,0000,0000,,!أنتم! توقفوا
Dialogue: 0,0:04:30.53,0:04:31.13,Default,,0000,0000,0000,,!يا إلهي
Dialogue: 0,0:04:35.27,0:04:37.30,Default,,0000,0000,0000,,...تبّاً
Dialogue: 0,0:04:45.42,0:04:46.63,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:04:47.05,0:04:49.21,Default,,0000,0000,0000,,!حمداً لله! وجدت كنزي
Dialogue: 0,0:04:49.21,0:04:51.55,Default,,0000,0000,0000,,هذا بفضل تحليل كونان-كن الدقيق
Dialogue: 0,0:04:51.55,0:04:54.55,Default,,0000,0000,0000,,كلا، لم يكن شيئاً يُذكر
Dialogue: 0,0:04:54.55,0:04:56.92,Default,,0000,0000,0000,,!علينا الإسراع وإلّا سيتفعّل نظام الأمان
Dialogue: 0,0:05:03.65,0:05:05.21,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:05:07.90,0:05:09.90,Default,,0000,0000,0000,,ما-ما العمل الآن؟
Dialogue: 0,0:05:09.90,0:05:12.10,Default,,0000,0000,0000,,إن ذهبنا لمكتب الحرّاس في المبنى
Dialogue: 0,0:05:12.10,0:05:14.89,Default,,0000,0000,0000,,وشرحنا الظروف فسيتركوننا نخرج حتماً
Dialogue: 0,0:05:14.89,0:05:16.34,Default,,0000,0000,0000,,حقاً؟
Dialogue: 0,0:05:16.64,0:05:19.31,Default,,0000,0000,0000,,...حسنٌ، مكتب الحرّاس
Dialogue: 0,0:05:20.16,0:05:22.04,Default,,0000,0000,0000,,!إنّه في الطابق السفليّ الثاني
Dialogue: 0,0:05:29.92,0:05:31.72,Default,,0000,0000,0000,,...يايبا المقنـ
Dialogue: 0,0:05:31.72,0:05:33.54,Default,,0000,0000,0000,,متجر المجوهرات في الطابق السادس، صحيح؟
Dialogue: 0,0:05:33.54,0:05:37.30,Default,,0000,0000,0000,,أجل، وتوجد تحف أثرية في \Nقاعة المؤتمرات في الطابق السابع
Dialogue: 0,0:05:37.66,0:05:39.05,Default,,0000,0000,0000,,...إنّها مضيفة المصـ
Dialogue: 0,0:05:39.41,0:05:43.00,Default,,0000,0000,0000,,حسنٌ، لدينا حتّى الصباح لأخذ كل ما نشتهيه
Dialogue: 0,0:05:43.20,0:05:44.86,Default,,0000,0000,0000,,!عـ-عصابة لصوص
Dialogue: 0,0:05:44.86,0:05:46.74,Default,,0000,0000,0000,,!سنكون في ورطة لو أمسكوا بنا
Dialogue: 0,0:05:46.74,0:05:49.24,Default,,0000,0000,0000,,!سيقتلوننا! لنهرب بسرعة
Dialogue: 0,0:05:49.24,0:05:51.96,Default,,0000,0000,0000,,لكن ماذا عن مضيفة المصعد والحراس؟
Dialogue: 0,0:05:52.31,0:05:56.10,Default,,0000,0000,0000,,لنختبئ حالياً بأيّ حال\Nونتصل بالشرطة، واضح؟
Dialogue: 0,0:05:56.10,0:05:57.31,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:03.22,0:06:05.51,Default,,0000,0000,0000,,ماذا؟ لا رنين خطّ؟
Dialogue: 0,0:06:05.51,0:06:07.59,Default,,0000,0000,0000,,!السلك مقطوع
Dialogue: 0,0:06:07.88,0:06:09.01,Default,,0000,0000,0000,,!هذا أيضاً
Dialogue: 0,0:06:09.01,0:06:10.55,Default,,0000,0000,0000,,كلّها مقطوعة
Dialogue: 0,0:06:12.25,0:06:13.63,Default,,0000,0000,0000,,!لنستعمل هذا الهاتف
Dialogue: 0,0:06:14.96,0:06:17.50,Default,,0000,0000,0000,,لا جدوى، لا حرارة
Dialogue: 0,0:06:17.50,0:06:21.79,Default,,0000,0000,0000,,لا بدّ أنّ الهواتف لا تعمل بسبب نظام الأمان
Dialogue: 0,0:06:22.28,0:06:24.45,Default,,0000,0000,0000,,لن يأتي أحد لنجدتنا إذاً؟
Dialogue: 0,0:06:24.45,0:06:27.71,Default,,0000,0000,0000,,أريد أكل الكثير من سمك\Nالأنقليس قبل أن أُقتل
Dialogue: 0,0:06:28.41,0:06:30.51,Default,,0000,0000,0000,,!من المبكر الاستسلام
Dialogue: 0,0:06:35.27,0:06:37.42,Default,,0000,0000,0000,,!لاحظوه رجاءً
Dialogue: 0,0:06:43.97,0:06:45.55,Default,,0000,0000,0000,,!النجدة
Dialogue: 0,0:06:45.55,0:06:47.38,Default,,0000,0000,0000,,!انظروا هنا
Dialogue: 0,0:06:50.26,0:06:51.83,Default,,0000,0000,0000,,لا جدوى
Dialogue: 0,0:06:53.21,0:06:54.46,Default,,0000,0000,0000,,غينتا-كن
Dialogue: 0,0:06:54.46,0:06:55.58,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:06:55.58,0:06:57.76,Default,,0000,0000,0000,,!سيسمعنا اللصوص
Dialogue: 0,0:07:00.00,0:07:02.78,Default,,0000,0000,0000,,تبّاً، لا تُكسر أبداً
Dialogue: 0,0:07:03.28,0:07:08.12,Default,,0000,0000,0000,,لن تنجح، النوافذ هنا من زجاج سميك خاص
Dialogue: 0,0:07:08.12,0:07:10.63,Default,,0000,0000,0000,,...حسناً، في هذه الحالة
Dialogue: 0,0:07:18.61,0:07:19.72,Default,,0000,0000,0000,,حسنٌ، اقطعها
Dialogue: 0,0:07:20.21,0:07:21.07,Default,,0000,0000,0000,,عُلِم
Dialogue: 0,0:07:29.39,0:07:30.43,Default,,0000,0000,0000,,!تعالي
Dialogue: 0,0:07:35.38,0:07:37.29,Default,,0000,0000,0000,,!ما-ما هذا؟
Dialogue: 0,0:07:37.29,0:07:40.30,Default,,0000,0000,0000,,!مكتب الحراسة! يوجد صوت غريب في الطابق السابع
Dialogue: 0,0:07:40.30,0:07:41.29,Default,,0000,0000,0000,,عُلِم
Dialogue: 0,0:07:41.29,0:07:44.22,Default,,0000,0000,0000,,تفقد الطابق السابع باستعمال كاميرات المراقبة
Dialogue: 0,0:07:46.28,0:07:47.87,Default,,0000,0000,0000,,...تعبت
Dialogue: 0,0:07:47.87,0:07:49.67,Default,,0000,0000,0000,,!أخبرتك أنك لن تنجح
Dialogue: 0,0:07:51.90,0:07:53.27,Default,,0000,0000,0000,,!انبطحوا جميعاً
Dialogue: 0,0:07:54.15,0:07:55.88,Default,,0000,0000,0000,,!كونان! ماذا عن النافذة؟
Dialogue: 0,0:07:55.88,0:07:57.11,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:07:59.52,0:08:01.79,Default,,0000,0000,0000,,!لا جدوى، لن تنتهي في الوقت
Dialogue: 0,0:08:05.01,0:08:07.46,Default,,0000,0000,0000,,لا أرى شيئاً غريباً
Dialogue: 0,0:08:07.93,0:08:11.31,Default,,0000,0000,0000,,لا شيء غريب؟ سمعنا أصواتاً عالية
Dialogue: 0,0:08:11.31,0:08:13.34,Default,,0000,0000,0000,,لنسرع بأخذ الغنائم ونرحل فقط
Dialogue: 0,0:08:13.34,0:08:15.67,Default,,0000,0000,0000,,كلا، علينا تفقد الأمر من باب الحيطة
Dialogue: 0,0:08:15.96,0:08:18.38,Default,,0000,0000,0000,,تبّاً، ألا توجد مخارج هنا؟
Dialogue: 0,0:08:18.38,0:08:19.43,Default,,0000,0000,0000,,!صمتاً
Dialogue: 0,0:08:20.30,0:08:21.34,Default,,0000,0000,0000,,أحدهم قادم
Dialogue: 0,0:08:34.86,0:08:36.11,Default,,0000,0000,0000,,!غينتا-كن
Dialogue: 0,0:08:36.11,0:08:37.57,Default,,0000,0000,0000,,!ها أنتم أيّها الصغار
Dialogue: 0,0:08:37.57,0:08:38.42,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:08:40.86,0:08:43.52,Default,,0000,0000,0000,,!آسفةٌ على التأخير
Dialogue: 0,0:08:43.52,0:08:46.42,Default,,0000,0000,0000,,أطلتُ في الكلام مع سونوكو
Dialogue: 0,0:08:46.42,0:08:48.52,Default,,0000,0000,0000,,سأعدّ العشاء سريعاً
Dialogue: 0,0:08:52.50,0:08:54.46,Default,,0000,0000,0000,,!رأوا وجهينا! أمسك بهم
Dialogue: 0,0:08:54.46,0:08:56.92,Default,,0000,0000,0000,,!اصعدوا جميعاً
Dialogue: 0,0:08:56.92,0:08:57.59,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:09:03.37,0:09:05.67,Default,,0000,0000,0000,,!ارجعوا
Dialogue: 0,0:09:05.67,0:09:08.63,Default,,0000,0000,0000,,!مكتب الحراسة! أتسمعني؟ أضيئوا المكان
Dialogue: 0,0:09:08.63,0:09:11.00,Default,,0000,0000,0000,,...ماذا قلت؟ لم نسمعك
Dialogue: 0,0:09:11.00,0:09:13.11,Default,,0000,0000,0000,,!يوجد جماعة صغار في المركز
Dialogue: 0,0:09:19.36,0:09:21.30,Default,,0000,0000,0000,,أين ذهب أولئك الملاعين؟
Dialogue: 0,0:09:36.75,0:09:39.47,Default,,0000,0000,0000,,!ما الذي يجري؟! أجبني
Dialogue: 0,0:09:44.37,0:09:46.87,Default,,0000,0000,0000,,!ماذا هناك؟
Dialogue: 0,0:09:46.87,0:09:49.54,Default,,0000,0000,0000,,انتبه الآخرون في مكتب الحراسة لوجودنا
Dialogue: 0,0:09:49.54,0:09:53.03,Default,,0000,0000,0000,,شغّلوا الأنوار للإمساك بنا
Dialogue: 0,0:09:53.03,0:09:55.46,Default,,0000,0000,0000,,!لنهرب من هنا بسرعة
Dialogue: 0,0:09:55.78,0:09:58.78,Default,,0000,0000,0000,,!أبي، أبي
Dialogue: 0,0:10:02.44,0:10:04.60,Default,,0000,0000,0000,,ماذا تريدين؟
Dialogue: 0,0:10:04.60,0:10:07.48,Default,,0000,0000,0000,,!لم يعد كونان-كن بعد
Dialogue: 0,0:10:07.48,0:10:10.84,Default,,0000,0000,0000,,كيف لي أن أعرف حياته؟
Dialogue: 0,0:10:11.44,0:10:14.22,Default,,0000,0000,0000,,...لمَ أيقظتني
Dialogue: 0,0:10:15.22,0:10:16.42,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:10:20.76,0:10:22.92,Default,,0000,0000,0000,,!توقيت ممتاز
Dialogue: 0,0:10:29.25,0:10:31.66,Default,,0000,0000,0000,,!اخرج يا غينتا! أنتما أيضاً! بسرعة
Dialogue: 0,0:10:31.66,0:10:33.14,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:10:36.28,0:10:40.11,Default,,0000,0000,0000,,هكذا إذاً، كادوا يحتجزوننا
Dialogue: 0,0:10:40.11,0:10:41.42,Default,,0000,0000,0000,,كان ذلك وشيكاً
Dialogue: 0,0:10:41.98,0:10:44.40,Default,,0000,0000,0000,,شكراً لك يا كونان-كن
Dialogue: 0,0:10:44.40,0:10:47.63,Default,,0000,0000,0000,,احتفظي بكلامك لحين خروجنا
Dialogue: 0,0:10:49.77,0:10:52.30,Default,,0000,0000,0000,,ظننتُ كونان في مركز التسوّق
Dialogue: 0,0:10:52.30,0:10:57.01,Default,,0000,0000,0000,,قال أنّه سيذهب مع بقية الصبية\Nلمشاهدة عرض أطفالٍ ما
Dialogue: 0,0:10:57.59,0:10:59.80,Default,,0000,0000,0000,,الظلام حالك في الخارج
Dialogue: 0,0:10:59.80,0:11:02.09,Default,,0000,0000,0000,,جرّبتِ الاتصال بمركز التسوّق؟
Dialogue: 0,0:11:06.42,0:11:08.96,Default,,0000,0000,0000,,وأين طعامي؟
Dialogue: 0,0:11:08.96,0:11:11.08,Default,,0000,0000,0000,,أتنوين تجويعي للموت؟
Dialogue: 0,0:11:12.07,0:11:13.07,Default,,0000,0000,0000,,...يا ربّي
Dialogue: 0,0:11:14.78,0:11:17.71,Default,,0000,0000,0000,,هذا مركز تسوّق ماروتان
Dialogue: 0,0:11:17.71,0:11:21.42,Default,,0000,0000,0000,,نحن مغلقون حالياً
Dialogue: 0,0:11:23.00,0:11:26.59,Default,,0000,0000,0000,,!بسرعة! علينا الابتعاد عنهم قدر المستطاع
Dialogue: 0,0:11:26.59,0:11:29.01,Default,,0000,0000,0000,,!ها أنتم
Dialogue: 0,0:11:29.44,0:11:33.71,Default,,0000,0000,0000,,سنعاود الافتتاح في ساعات عملنا\N...الاعتيادية غداً من العاشرة صباحاً
Dialogue: 0,0:11:36.68,0:11:41.42,Default,,0000,0000,0000,,أخبرتك، ما رأيك بأن تعدّي عشائي الآن؟
Dialogue: 0,0:11:41.42,0:11:43.71,Default,,0000,0000,0000,,بمن ستتصلين هذه المرّة؟
Dialogue: 0,0:11:43.71,0:11:45.84,Default,,0000,0000,0000,,أهذا منزل كوجيما؟ أنا ابنة موري
Dialogue: 0,0:11:45.84,0:11:46.80,Default,,0000,0000,0000,,...هل عاد غينتا-كن
Dialogue: 0,0:11:46.80,0:11:48.72,Default,,0000,0000,0000,,!انتظرا
Dialogue: 0,0:11:53.12,0:11:54.37,Default,,0000,0000,0000,,...هذان الصوتان
Dialogue: 0,0:11:54.37,0:11:55.78,Default,,0000,0000,0000,,...أمسكوا بغينتا وميتسوهيكو
Dialogue: 0,0:11:55.78,0:11:58.20,Default,,0000,0000,0000,,ابقي هنا واختبئي
Dialogue: 0,0:11:58.20,0:11:59.05,Default,,0000,0000,0000,,واضح؟
Dialogue: 0,0:11:59.05,0:11:59.61,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:12:01.44,0:12:03.04,Default,,0000,0000,0000,,!دعني
Dialogue: 0,0:12:03.44,0:12:06.23,Default,,0000,0000,0000,,!أين الآخران؟
Dialogue: 0,0:12:06.23,0:12:09.17,Default,,0000,0000,0000,,!النجدة! لا أريد الموت
Dialogue: 0,0:12:09.52,0:12:11.42,Default,,0000,0000,0000,,!توقفوا! نحن الشرطة
Dialogue: 0,0:12:11.89,0:12:13.89,Default,,0000,0000,0000,,!مركز التسوّق هذا محاصر
Dialogue: 0,0:12:13.89,0:12:15.55,Default,,0000,0000,0000,,!لا مهرب لكم
Dialogue: 0,0:12:15.55,0:12:18.34,Default,,0000,0000,0000,,!ارموا أسلحتكم وأطلقوا سراح الأطفال
Dialogue: 0,0:12:23.75,0:12:26.50,Default,,0000,0000,0000,,!من هنا! بسرعة
Dialogue: 0,0:12:26.50,0:12:28.26,Default,,0000,0000,0000,,!تبّاً لكم
Dialogue: 0,0:12:28.50,0:12:30.26,Default,,0000,0000,0000,,!لا توجد شرطة هنا
Dialogue: 0,0:12:30.26,0:12:32.17,Default,,0000,0000,0000,,!فقط الأطفال
Dialogue: 0,0:12:34.29,0:12:37.79,Default,,0000,0000,0000,,!اللعنة! استعملوا هذه المجسمات
Dialogue: 0,0:12:37.79,0:12:39.51,Default,,0000,0000,0000,,!لا تدعوهم يهربوا
Dialogue: 0,0:12:43.53,0:12:47.52,Default,,0000,0000,0000,,...أهذا منزل يوشيدا؟ أنا من بيت إيدوغاوا كونان
Dialogue: 0,0:12:49.69,0:12:52.38,Default,,0000,0000,0000,,ماذا؟ لم ترجع أيومي-تشان بعد أيضاً؟
Dialogue: 0,0:12:54.27,0:12:57.52,Default,,0000,0000,0000,,...تلقيتُ اتصالاً من عائلة ميتسوهيكو-كن أيضاً
Dialogue: 0,0:12:57.52,0:13:01.01,Default,,0000,0000,0000,,ماذا؟ ما الذي يجري؟
Dialogue: 0,0:13:08.84,0:13:12.66,Default,,0000,0000,0000,,!انهض يا غينتا! تريدهم أن يمسكوا بك؟
Dialogue: 0,0:13:12.66,0:13:14.65,Default,,0000,0000,0000,,...أعرف ذلك
Dialogue: 0,0:13:26.09,0:13:27.46,Default,,0000,0000,0000,,!نحن محاصرون
Dialogue: 0,0:13:28.24,0:13:29.65,Default,,0000,0000,0000,,!من هنا
Dialogue: 0,0:13:34.13,0:13:35.75,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:13:45.42,0:13:47.42,Default,,0000,0000,0000,,ما الأمر يا كونان-كن؟
Dialogue: 0,0:13:47.42,0:13:48.72,Default,,0000,0000,0000,,هل نسيت شيئاً؟
Dialogue: 0,0:13:48.72,0:13:51.83,Default,,0000,0000,0000,,...كلا، ليس ذلك
Dialogue: 0,0:13:51.83,0:13:54.67,Default,,0000,0000,0000,,...لمع أمر ما في بالي للتوّ
Dialogue: 0,0:13:55.54,0:13:58.72,Default,,0000,0000,0000,,...ما هو؟ ماذا بالضبط
Dialogue: 0,0:14:04.11,0:14:06.67,Default,,0000,0000,0000,,اُختطف كونان وأصدقاؤه؟
Dialogue: 0,0:14:07.11,0:14:09.45,Default,,0000,0000,0000,,أجل، هذا التفسير الوحيد
Dialogue: 0,0:14:09.45,0:14:15.19,Default,,0000,0000,0000,,انتظري، هل تلقت عوائل بقية الأطفال طلب فدية؟
Dialogue: 0,0:14:15.19,0:14:17.14,Default,,0000,0000,0000,,...كلا، لكن
Dialogue: 0,0:14:17.14,0:14:22.09,Default,,0000,0000,0000,,لعلّهم يأخذون وقتهم في طريق العودة
Dialogue: 0,0:14:22.09,0:14:24.88,Default,,0000,0000,0000,,سيرجعون قريباً
Dialogue: 0,0:14:24.88,0:14:26.67,Default,,0000,0000,0000,,...أتساءل عن ذلك
Dialogue: 0,0:14:26.67,0:14:29.59,Default,,0000,0000,0000,,حسناً، ماذا عن العشاء الآن؟
Dialogue: 0,0:14:34.83,0:14:38.42,Default,,0000,0000,0000,,...أنت! يكفي وجهّزي طعامي
Dialogue: 0,0:14:38.42,0:14:41.49,Default,,0000,0000,0000,,أهذا قسم التحرّي؟ أيمكنكم إيصالي بالمفتش ميغوري؟
Dialogue: 0,0:14:47.07,0:14:48.95,Default,,0000,0000,0000,,جرى الأمر أفضل مما توقعت
Dialogue: 0,0:14:51.03,0:14:51.75,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:14:52.27,0:14:54.57,Default,,0000,0000,0000,,!غينتا-كن
Dialogue: 0,0:14:54.57,0:14:56.17,Default,,0000,0000,0000,,!أنت ومعدتك المُهلِكة
Dialogue: 0,0:14:56.17,0:14:59.84,Default,,0000,0000,0000,,!ليس بيدي حيلة، كنتُ جائعاً
Dialogue: 0,0:15:00.56,0:15:02.50,Default,,0000,0000,0000,,!توقفوا
Dialogue: 0,0:15:00.56,0:15:02.50,Default,,0000,0000,0000,,!توقفوا
Dialogue: 0,0:15:04.46,0:15:08.30,Default,,0000,0000,0000,,نعتذر على إزعاجكم في هذا الوقت المتأخر
Dialogue: 0,0:15:08.30,0:15:09.97,Default,,0000,0000,0000,,إذاً؟
Dialogue: 0,0:15:09.97,0:15:14.63,Default,,0000,0000,0000,,لم تكن هناك حوادث بها أطفال للآن
Dialogue: 0,0:15:14.63,0:15:18.38,Default,,0000,0000,0000,,لكن من الغريب أنّه لم يعد منهم أحد
Dialogue: 0,0:15:19.04,0:15:20.71,Default,,0000,0000,0000,,هل حصل مكروه لهم؟
Dialogue: 0,0:15:20.71,0:15:23.32,Default,,0000,0000,0000,,أذعت بلاغ بحث
Dialogue: 0,0:15:23.32,0:15:25.99,Default,,0000,0000,0000,,لا تقلقي، سنجدهم قريباً
Dialogue: 0,0:15:25.99,0:15:27.74,Default,,0000,0000,0000,,!شكراً جزيلاً
Dialogue: 0,0:15:27.74,0:15:32.71,Default,,0000,0000,0000,,أتمنى أن تعذروني الآن، فأنا في خضم قضيّة مهمة
Dialogue: 0,0:15:33.02,0:15:37.11,Default,,0000,0000,0000,,حسنٌ، فعلنا كلّ ما بيدنا
Dialogue: 0,0:15:37.11,0:15:39.65,Default,,0000,0000,0000,,ما تبقى الآن هو انتظار تقارير عنهم فقط
Dialogue: 0,0:15:40.65,0:15:42.97,Default,,0000,0000,0000,,!لنذهب للأكل
Dialogue: 0,0:15:42.97,0:15:44.17,Default,,0000,0000,0000,,...لنذهب
Dialogue: 0,0:15:53.50,0:15:56.17,Default,,0000,0000,0000,,لطالما أردتُ القيام بهذا ولو لمرّة
Dialogue: 0,0:15:56.17,0:16:00.43,Default,,0000,0000,0000,,سامحونا، سندفع الثمن إن نجونا
Dialogue: 0,0:16:01.62,0:16:04.13,Default,,0000,0000,0000,,أتساءل إن كنّا سننجو حقاً؟
Dialogue: 0,0:16:05.87,0:16:07.91,Default,,0000,0000,0000,,لا يغلبك الإحباط أيضاً يا غينتا-كن
Dialogue: 0,0:16:07.91,0:16:11.73,Default,,0000,0000,0000,,!أكلتَ الكثير لذا حان الوقت لتبتهج
Dialogue: 0,0:16:11.73,0:16:15.59,Default,,0000,0000,0000,,!سنغلبهم ونخرج من هنا حتماً
Dialogue: 0,0:16:15.59,0:16:17.80,Default,,0000,0000,0000,,!باسم فرقة فتيان التحرّي على المحك
Dialogue: 0,0:16:18.11,0:16:20.31,Default,,0000,0000,0000,,...باسم فرقة
Dialogue: 0,0:16:20.31,0:16:21.83,Default,,0000,0000,0000,,...فتيان التحرّي
Dialogue: 0,0:16:22.06,0:16:29.93,Default,,0000,0000,0000,,لا بدّ أنّها قضية مهمة حقاً\Nإن كانوا لا يزالون يعملون في هذا الوقت
Dialogue: 0,0:16:29.93,0:16:33.25,Default,,0000,0000,0000,,!أتقصد أنّ كونان-كن والبقية غير مهمين؟
Dialogue: 0,0:16:33.25,0:16:36.46,Default,,0000,0000,0000,,...كلا، لم أعن ذلك
Dialogue: 0,0:16:39.88,0:16:42.37,Default,,0000,0000,0000,,...تبّاً لكونان ذاك
Dialogue: 0,0:16:42.37,0:16:46.38,Default,,0000,0000,0000,,عشائي يفوتني بسببه
Dialogue: 0,0:16:47.91,0:16:50.04,Default,,0000,0000,0000,,عصابة لصوص مراكز تسوّق؟
Dialogue: 0,0:16:50.04,0:16:55.44,Default,,0000,0000,0000,,يتسللون بعد إغلاق المراكز\N...ويسرقون الجواهر والالكترونيات
Dialogue: 0,0:16:55.44,0:16:59.00,Default,,0000,0000,0000,,أيمكن أنّ هذه هي القضية المهمة؟
Dialogue: 0,0:17:00.82,0:17:02.02,Default,,0000,0000,0000,,!مراكز تسوّق؟
Dialogue: 0,0:17:02.02,0:17:03.59,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:17:03.59,0:17:05.21,Default,,0000,0000,0000,,!اهدئي يا ران
Dialogue: 0,0:17:07.81,0:17:09.97,Default,,0000,0000,0000,,!حسنٌ! وقت الهجوم المعاكس
Dialogue: 0,0:17:24.13,0:17:26.25,Default,,0000,0000,0000,,!أين يختبئون الآن؟
Dialogue: 0,0:17:26.87,0:17:28.01,Default,,0000,0000,0000,,!هناك
Dialogue: 0,0:17:42.31,0:17:47.01,Default,,0000,0000,0000,,...لا أحتمل الكحول
Dialogue: 0,0:17:47.01,0:17:48.66,Default,,0000,0000,0000,,...أشعر بدوار
Dialogue: 0,0:17:48.66,0:17:49.88,Default,,0000,0000,0000,,!ميتسوهيكو-كن
Dialogue: 0,0:18:02.29,0:18:04.41,Default,,0000,0000,0000,,!اللعنة على أولئك الأطفال
Dialogue: 0,0:18:04.41,0:18:06.50,Default,,0000,0000,0000,,!لن أسامحكم! لن تهربوا أحياءً
Dialogue: 0,0:18:19.07,0:18:21.17,Default,,0000,0000,0000,,...لا أطيق الحيوانات
Dialogue: 0,0:18:22.10,0:18:25.42,Default,,0000,0000,0000,,...حسنٌ حسنٌ
Dialogue: 0,0:18:25.42,0:18:27.26,Default,,0000,0000,0000,,!اجلبوها
Dialogue: 0,0:18:47.21,0:18:48.50,Default,,0000,0000,0000,,!نجحنا
Dialogue: 0,0:18:47.21,0:18:48.50,Default,,0000,0000,0000,,!نجحنا
Dialogue: 0,0:18:48.50,0:18:51.54,Default,,0000,0000,0000,,!مرحى لفرقة فتيان التحرّي
Dialogue: 0,0:18:48.50,0:18:51.54,Default,,0000,0000,0000,,!مرحى لفرقة فتيان التحرّي
Dialogue: 0,0:18:52.57,0:18:53.29,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:18:54.41,0:18:57.00,Default,,0000,0000,0000,,!فهمت، هكذا إذاً
Dialogue: 0,0:19:01.12,0:19:03.35,Default,,0000,0000,0000,,!من هناك؟
Dialogue: 0,0:19:04.81,0:19:07.09,Default,,0000,0000,0000,,إنّه أنا يا مضيفة المصعد
Dialogue: 0,0:19:07.73,0:19:11.30,Default,,0000,0000,0000,,أنت يا فتى، ماذا تفعل هنا؟
Dialogue: 0,0:19:11.30,0:19:14.76,Default,,0000,0000,0000,,!بأيّ حال، نحن في خطر\Nالأشرار في الجوار
Dialogue: 0,0:19:14.76,0:19:17.05,Default,,0000,0000,0000,,لنهرب معاً
Dialogue: 0,0:19:17.26,0:19:19.93,Default,,0000,0000,0000,,يمكنك إيقاف التمثيل
Dialogue: 0,0:19:19.93,0:19:23.46,Default,,0000,0000,0000,,نعرف ما يجري يا مضيفة المصعد
Dialogue: 0,0:19:23.46,0:19:26.71,Default,,0000,0000,0000,,أو بالأحرى، عضو عصابة اللصوص الخامس
Dialogue: 0,0:19:27.29,0:19:29.59,Default,,0000,0000,0000,,ما-ما الذي تقصده؟
Dialogue: 0,0:19:30.29,0:19:34.50,Default,,0000,0000,0000,,كان الشخص الخامس هو من فعّل\Nالدرج المتحرك آنذاك
Dialogue: 0,0:19:34.78,0:19:37.49,Default,,0000,0000,0000,,كان ينتظر للإمساك بنا الأربعة معاً
Dialogue: 0,0:19:37.49,0:19:40.42,Default,,0000,0000,0000,,،بين الأشخاص المتبقين في مكتب الحراسة
Dialogue: 0,0:19:40.42,0:19:44.90,Default,,0000,0000,0000,,كنتِ الوحيدة التي تعرف عددنا
Dialogue: 0,0:19:44.90,0:19:49.15,Default,,0000,0000,0000,,خططتِ للتوغل سلفاً عبر التوظّف كمضيفة مصعد
Dialogue: 0,0:19:49.15,0:19:50.96,Default,,0000,0000,0000,,كي يمكنك استكشاف المكان
Dialogue: 0,0:19:51.26,0:19:52.83,Default,,0000,0000,0000,,!مـ-من أنت؟
Dialogue: 0,0:19:53.26,0:19:55.55,Default,,0000,0000,0000,,إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:19:56.01,0:19:58.10,Default,,0000,0000,0000,,يا للاستنتاج البارع يا فتى
Dialogue: 0,0:19:58.10,0:20:02.40,Default,,0000,0000,0000,,لكن يبدو أنّك لم تكتشف أنّي زعيمة العصابة
Dialogue: 0,0:20:03.96,0:20:05.21,Default,,0000,0000,0000,,!مسدّس؟
Dialogue: 0,0:20:05.21,0:20:07.25,Default,,0000,0000,0000,,!ليس عدلاً امتلاكك لسلاح ناري
Dialogue: 0,0:20:09.21,0:20:10.23,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:20:11.58,0:20:14.04,Default,,0000,0000,0000,,!حسناً، سأستدرجها للسطح
Dialogue: 0,0:20:31.06,0:20:33.71,Default,,0000,0000,0000,,!إنّها النهاية يا فتى! اكشف عن نفسك
Dialogue: 0,0:20:36.68,0:20:37.71,Default,,0000,0000,0000,,!ها أنت
Dialogue: 0,0:20:40.81,0:20:42.58,Default,,0000,0000,0000,,!كرات سلّة
Dialogue: 0,0:20:42.58,0:20:44.17,Default,,0000,0000,0000,,!صبيّ مزعج
Dialogue: 0,0:20:47.59,0:20:48.92,Default,,0000,0000,0000,,!أوقف مقاومتك العقيمة
Dialogue: 0,0:20:52.79,0:20:54.46,Default,,0000,0000,0000,,!انطلقي
Dialogue: 0,0:20:56.62,0:20:58.24,Default,,0000,0000,0000,,!سحقاً
Dialogue: 0,0:21:10.44,0:21:12.67,Default,,0000,0000,0000,,!انزلني
Dialogue: 0,0:21:18.14,0:21:19.17,Default,,0000,0000,0000,,فعلتُها
Dialogue: 0,0:21:38.95,0:21:41.10,Default,,0000,0000,0000,,ما-ما هذا؟
Dialogue: 0,0:21:42.78,0:21:45.46,Default,,0000,0000,0000,,!إنّهم اللصوص! اعتقلوهم
Dialogue: 0,0:21:47.32,0:21:49.59,Default,,0000,0000,0000,,...لا أشعر على ما يرام
Dialogue: 0,0:21:50.81,0:21:52.93,Default,,0000,0000,0000,,...هؤلاء الأطفال
Dialogue: 0,0:21:52.93,0:21:55.03,Default,,0000,0000,0000,,إنّهم معضلة حقاً
Dialogue: 0,0:23:35.33,0:23:39.38,Default,,0000,0000,0000,,احتفلوا بنا في اليوم التالي
Dialogue: 0,0:23:39.38,0:23:41.28,Default,,0000,0000,0000,,لقبضنا على اللصوص
Dialogue: 0,0:23:41.28,0:23:43.28,Default,,0000,0000,0000,,لم يكن علينا دفع تكاليف الأكل
Dialogue: 0,0:23:43.28,0:23:47.37,Default,,0000,0000,0000,,وبقية الأشياء التي استعملناها\Nوحطمناها في المركز
Dialogue: 0,0:23:47.37,0:23:48.93,Default,,0000,0000,0000,,أهذا حسن حقاً؟
Dialogue: 0,0:23:48.93,0:23:51.06,Default,,0000,0000,0000,,!إنّه كذلك
Dialogue: 0,0:23:51.06,0:23:52.94,Default,,0000,0000,0000,,...نصرٌ آخر
Dialogue: 0,0:23:52.94,0:23:54.46,Default,,0000,0000,0000,,!لفرقة فتيان التحرّي
Dialogue: 0,0:24:02.89,0:24:04.39,Default,,0000,0000,0000,,!ما كان ذاك الصوت؟
Dialogue: 0,0:24:04.39,0:24:07.26,Default,,0000,0000,0000,,!أتى من غرفتها
Dialogue: 0,0:24:07.26,0:24:09.04,Default,,0000,0000,0000,,!سينسي! سينسي
Dialogue: 0,0:24:12.34,0:24:15.00,Default,,0000,0000,0000,,بالمناسبة، كنا نسجل تصويراً
Dialogue: 0,0:24:15.00,0:24:15.50,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:24:16.00,0:24:20.13,Default,,0000,0000,0000,,!قد يكون المجرم ظاهراً في الفيلم
Dialogue: 0,0:24:20.13,0:24:23.24,Default,,0000,0000,0000,,!كان هو من دنّس فستانها بالدم إذاً
Dialogue: 0,0:24:25.16,0:24:26.62,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.62,0:24:29.22,Default,,0000,0000,0000,,جريمة قتل عروس يونيو
Dialogue: 0,0:24:45.85,0:24:47.85,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.85,0:24:49.78,Default,,0000,0000,0000,,كبسولات دواء
Dialogue: 0,0:24:49.78,0:24:51.77,Default,,0000,0000,0000,,

