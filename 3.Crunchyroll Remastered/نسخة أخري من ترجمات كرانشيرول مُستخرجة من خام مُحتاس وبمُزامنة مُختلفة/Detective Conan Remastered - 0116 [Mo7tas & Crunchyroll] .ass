Dialogue: 0,0:00:00.91,0:00:04.20,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.20,0:00:06.14,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.41,0:00:09.65,Default,,0000,0000,0000,,!قضيّة اليوم عن روائيّ غموض\N!توجد ألغاز خارج إطار الأوراق
Dialogue: 0,0:00:10.07,0:00:11.61,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.61,0:00:13.66,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.66,0:00:16.07,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.74,0:00:24.24,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.24,0:00:31.28,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.96,0:00:39.41,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.41,0:00:46.91,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.91,0:00:59.36,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.20,0:01:06.66,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.57,0:01:13.46,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.46,0:01:19.91,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.91,0:01:26.85,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.26,0:01:57.30,Title,,0000,0000,15,,{\fad(300,0)}جريمة اختفاء مؤلف روايات الغموض\N(الجزء الأوّل)
Dialogue: 0,0:01:52.01,0:01:55.71,Default,,0000,0000,0000,,جريمة اختفاء مؤلف روايات الغموض\N(الجزء الأوّل)
Dialogue: 0,0:02:10.34,0:02:16.23,Default,,0000,0000,0000,,حللتُ أنا، ماتسودا سامونجي، سلسلة جرائم\N!قتل الليلة الدامية
Dialogue: 0,0:02:17.76,0:02:22.24,Default,,0000,0000,0000,,المجرم هو ذاك الشخص بلا شكّ
Dialogue: 0,0:02:19.80,0:02:22.24,Narration - Copy,,0260,0000,15,,{\fs(18)\fad(200,0)} المتحرّي سامونجي
Dialogue: 0,0:02:27.70,0:02:31.29,Default,,0000,0000,0000,,!الابن! الابن! المجرم هو الابن
Dialogue: 0,0:02:31.55,0:02:36.25,Default,,0000,0000,0000,,حمقاء، الابن تمويه، والفاعل الحقيقيّ\Nهي زوجة الرجل المقتول
Dialogue: 0,0:02:36.71,0:02:39.71,Default,,0000,0000,0000,,من تظنّه الفاعل يا كونان-كن؟
Dialogue: 0,0:02:39.96,0:02:42.68,Default,,0000,0000,0000,,سأختار نفس الشخص مثلك
Dialogue: 0,0:02:42.88,0:02:45.39,Default,,0000,0000,0000,,!رأيت! كونان-كن يوافقني
Dialogue: 0,0:02:46.09,0:02:48.69,Default,,0000,0000,0000,,هذا مجرّد تفكير أطفال سطحيّ
Dialogue: 0,0:02:49.27,0:02:51.63,Default,,0000,0000,0000,,لا يفهم شيئاً
Dialogue: 0,0:02:53.63,0:02:55.63,Default,,0000,0000,0000,,...القاتل
Dialogue: 0,0:02:55.63,0:02:56.52,Default,,0000,0000,0000,,!هو أنت
Dialogue: 0,0:02:58.65,0:03:00.49,Default,,0000,0000,0000,,أليس كذلك أيّها الابن؟
Dialogue: 0,0:03:00.84,0:03:02.19,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:03:02.19,0:03:04.42,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:03:04.42,0:03:06.49,Default,,0000,0000,0000,,...في المرّة السابقة التي شاهدته فيها، كان
Dialogue: 0,0:03:06.96,0:03:10.34,Default,,0000,0000,0000,,يُعاد إنتاج سلسلة المتحرّي سامونجي هذه عدّة مرّات
Dialogue: 0,0:03:10.34,0:03:13.46,Default,,0000,0000,0000,,والقاتل يتغيّر كلّ مرة
Dialogue: 0,0:03:13.46,0:03:16.42,Default,,0000,0000,0000,,!لذا تبقى مسليّة مهما شاهدتها
Dialogue: 0,0:03:21.01,0:03:22.09,Default,,0000,0000,0000,,!يا أحمق
Dialogue: 0,0:03:22.09,0:03:25.68,Default,,0000,0000,0000,,!لمَ فعلت هذا فجأةً؟! لا تغضبني
Dialogue: 0,0:03:25.90,0:03:27.67,On Top,,0000,0000,0000,,أيّ غضب هذا؟
Dialogue: 0,0:03:27.67,0:03:30.46,Default,,0000,0000,0000,,!ما الذي تفعله يا أبي؟
Dialogue: 0,0:03:30.46,0:03:33.02,Default,,0000,0000,0000,,المتحرّي سريع الاستلال"؟" يا للسخافة"
Dialogue: 0,0:03:33.38,0:03:39.17,Default,,0000,0000,0000,,أرجع القناة! سامونجي على وشك استسلال\N!سيفه وإلقاء قصيدة هايكو للقاتل
Dialogue: 0,0:03:39.17,0:03:41.26,Default,,0000,0000,0000,,!كلا، كلا
Dialogue: 0,0:03:41.26,0:03:46.20,Default,,0000,0000,0000,,!لمَ؟! أرجع جهاز التحكّم فوراً! سينتهي
Dialogue: 0,0:03:46.42,0:03:50.55,Default,,0000,0000,0000,,يا للأجواء المسالمة ليتشاجر الأب\Nوابنته في أشياء كهذه
Dialogue: 0,0:03:51.84,0:03:56.21,Default,,0000,0000,0000,,تسبّبت منظمتهم بوقوع الكثير من الضحايا
Dialogue: 0,0:03:56.21,0:04:00.17,Default,,0000,0000,0000,,لكن لم يدرك أحد بعد أنّها أفعال المنظمة
Dialogue: 0,0:04:00.84,0:04:03.13,Default,,0000,0000,0000,,،إذا أردت العودة لجسدي الطبيعيّ
Dialogue: 0,0:04:03.30,0:04:08.09,Default,,0000,0000,0000,,فعليّ تحويل هذا المتحرّي تائه السبيل لمتحرٍّ حقيقي
Dialogue: 0,0:04:08.09,0:04:11.70,Default,,0000,0000,0000,,وأن أحصل على معلومات عن منظمتهم
Dialogue: 0,0:04:11.70,0:04:13.46,Default,,0000,0000,0000,,منظمة الرجال ذوي الرداء الأسود
Dialogue: 0,0:04:14.46,0:04:20.02,Default,,0000,0000,0000,,،إذا ارتفع عدد العملاء الذين يتلقّاهم\Nفلا بدّ أن تمر قضيّة تتعلّق بهم
Dialogue: 0,0:04:20.34,0:04:26.45,Default,,0000,0000,0000,,،إذا واصلتُ السعي وراء الحقيقة هكذا\N...فلا بدّ، لا بدّ أنّي
Dialogue: 0,0:04:27.51,0:04:29.41,Default,,0000,0000,0000,,انتهى الآن
Dialogue: 0,0:04:30.38,0:04:36.12,Default,,0000,0000,0000,,ما المثير فيه بأيّ حال؟ إنّه مجرد\Nمتحرٍّ من الطراز الثالث
Dialogue: 0,0:04:36.63,0:04:41.21,Default,,0000,0000,0000,,هذا ما يقوله المتحرّي البليد
Dialogue: 0,0:04:41.63,0:04:45.21,Default,,0000,0000,0000,,،كما أنّ السلسلة الأصليّة انتهت قبل وقتٍ طويل
Dialogue: 0,0:04:45.21,0:04:48.01,Default,,0000,0000,0000,,!فلمَ يعرضونه باستمرار على التلفاز؟ يا للإزعاج
Dialogue: 0,0:04:49.14,0:04:50.76,Default,,0000,0000,0000,,بدأت سلسلته مُجدداً
Dialogue: 0,0:04:54.30,0:04:56.71,Default,,0000,0000,0000,,حسناً، كانت هنا كما أظنّ
Dialogue: 0,0:04:56.71,0:04:59.07,Default,,0000,0000,0000,,..."قبل شهرين في "عصر الأدب
Dialogue: 0,0:05:00.01,0:05:00.69,Default,,0000,0000,0000,,انظرا
Dialogue: 0,0:05:01.36,0:05:05.65,Default,,0000,0000,0000,,عودة (المتحرّي سامونجي) لـ شينمي نينتارو"\N"!التي يترقّبها الجميع
Dialogue: 0,0:05:06.76,0:05:08.91,Default,,0000,0000,0000,,!حقّاً؟
Dialogue: 0,0:05:10.20,0:05:12.13,Default,,0000,0000,0000,,!هذا يشعرني بالحنين
Dialogue: 0,0:05:12.13,0:05:15.17,Default,,0000,0000,0000,,،اختفى مع القاتل في النار قبل 10 أعوام
Dialogue: 0,0:05:15.17,0:05:17.16,Default,,0000,0000,0000,,لكنّه كان حيّاً إذاً؟
Dialogue: 0,0:05:17.42,0:05:19.12,Default,,0000,0000,0000,,بالحنين؟
Dialogue: 0,0:05:19.42,0:05:23.09,Default,,0000,0000,0000,,هذا ما قاله شينتشي-نيتشان\N...على الهاتف ذاك اليوم
Dialogue: 0,0:05:23.42,0:05:25.38,Default,,0000,0000,0000,,شينتشي؟
Dialogue: 0,0:05:25.38,0:05:27.05,Default,,0000,0000,0000,,مهووس التحرّي ذاك؟
Dialogue: 0,0:05:37.96,0:05:41.65,Default,,0000,0000,0000,,ماذا؟ يبدو أنّ هناك عميلاً\Nعند المكتب في الأسفل
Dialogue: 0,0:05:41.94,0:05:45.57,Default,,0000,0000,0000,,أجل، أخبريه أنّ الوقت تأخّر\Nلذا فليأت غداً
Dialogue: 0,0:05:45.92,0:05:46.99,Default,,0000,0000,0000,,حسناً، حسناً
Dialogue: 0,0:05:51.67,0:05:54.08,Default,,0000,0000,0000,,المعذرة، المكتب مقفل الآن
Dialogue: 0,0:05:54.34,0:05:57.75,Default,,0000,0000,0000,,لكنّي بحاجة ملحّة لاستشارة\Nالمتحرّي موري في شيء
Dialogue: 0,0:06:00.17,0:06:03.00,Default,,0000,0000,0000,,هل يمكنه الاستماع لي على الأقل؟
Dialogue: 0,0:06:05.01,0:06:06.21,Default,,0000,0000,0000,,!حسناء
Dialogue: 0,0:06:06.88,0:06:10.71,Default,,0000,0000,0000,,لكن الوقت تأخّر، لذا هلّا أتيتِ مُجدداً في الغد؟
Dialogue: 0,0:06:10.71,0:06:13.03,Default,,0000,0000,0000,,!انتظري، انتظري، انتظري
Dialogue: 0,0:06:13.03,0:06:15.85,Default,,0000,0000,0000,,!ما الذي تقولينه لعميلتنا؟
Dialogue: 0,0:06:16.21,0:06:21.52,Default,,0000,0000,0000,,!آسفٌ على الإطالة! أنا موري كوغورو
Dialogue: 0,0:06:21.84,0:06:24.44,Default,,0000,0000,0000,,اعذري ابنتي الفظّة
Dialogue: 0,0:06:25.17,0:06:28.09,Default,,0000,0000,0000,,هيّا، تفضّلي بالدخول
Dialogue: 0,0:06:28.09,0:06:28.92,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:06:28.92,0:06:29.65,Default,,0000,0000,0000,,هيّا
Dialogue: 0,0:06:31.84,0:06:36.03,Default,,0000,0000,0000,,ما هذا السلوك؟ أنت من أخبرني بردّها
Dialogue: 0,0:06:36.42,0:06:38.55,Default,,0000,0000,0000,,هيّا، تفضّلي بالجلوس
Dialogue: 0,0:06:44.83,0:06:47.26,Default,,0000,0000,0000,,المعذرة، تفضّلي
Dialogue: 0,0:06:47.26,0:06:47.80,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:06:55.63,0:06:57.32,Default,,0000,0000,0000,,...مجرّد شاي، لكن
Dialogue: 0,0:06:57.32,0:06:58.14,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:07:01.84,0:07:05.11,Default,,0000,0000,0000,,إذاً، هلّا أخبرتِني بطلبك؟
Dialogue: 0,0:07:05.55,0:07:08.20,Default,,0000,0000,0000,,...أجل، أنا
Dialogue: 0,0:07:09.14,0:07:10.66,Default,,0000,0000,0000,,أُدعى شينمي كاوري
Dialogue: 0,0:07:11.18,0:07:13.13,Default,,0000,0000,0000,,...شينمي؟ أيمكن
Dialogue: 0,0:07:13.13,0:07:14.58,Default,,0000,0000,0000,,...روائيّ الغموض
Dialogue: 0,0:07:14.58,0:07:19.04,On Top,,0000,0000,0000,,أجل، شينمي نينتارو أبي
Dialogue: 0,0:07:14.72,0:07:18.55,CharCard,,0000,0000,0004,,{\fad(200,200)}(شينمي كاوري (22\Nموظّفة شركة
Dialogue: 0,0:07:19.26,0:07:22.67,Default,,0000,0000,0000,,!أنتِ ابنة ذاك المعلّم المبجّل إذاً؟
Dialogue: 0,0:07:23.18,0:07:27.39,Default,,0000,0000,0000,,!لا أسأم من هايكو سامونجي مهما سمعت منها
Dialogue: 0,0:07:27.81,0:07:29.35,Default,,0000,0000,0000,,أليس كذلك؟
Dialogue: 0,0:07:29.76,0:07:35.81,Default,,0000,0000,0000,,إذاً، كيف أساعدك؟ أيريد منّي الظهور في رواية؟
Dialogue: 0,0:07:35.81,0:07:38.08,Default,,0000,0000,0000,,...لا، في الواقع
Dialogue: 0,0:07:38.08,0:07:42.28,Default,,0000,0000,0000,,أبي مفقود... منذ شهرين
Dialogue: 0,0:07:42.28,0:07:44.24,Default,,0000,0000,0000,,مفقود؟
Dialogue: 0,0:07:44.64,0:07:47.01,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:07:47.01,0:07:48.89,Default,,0000,0000,0000,,ما الذي تقولينه؟
Dialogue: 0,0:07:48.89,0:07:53.20,Default,,0000,0000,0000,,"كان يكتب سلسلةً لـ "عصر الأدب\N!للشهرين الفائتين
Dialogue: 0,0:07:53.36,0:07:57.17,Default,,0000,0000,0000,,!لكنّها الحقيقة! اختفى من المنزل مع أمّي
Dialogue: 0,0:07:57.17,0:07:59.58,Default,,0000,0000,0000,,مـ-مع أمّك؟
Dialogue: 0,0:08:01.13,0:08:07.36,Default,,0000,0000,0000,,اختفيا قبل قرابة أسبوع من بدء السلسلة الحاليّة
Dialogue: 0,0:08:07.36,0:08:11.10,Default,,0000,0000,0000,,وتركا ملاحظةً تفيد بأنّهما سيغادران لفترة
Dialogue: 0,0:08:11.10,0:08:14.10,Default,,0000,0000,0000,,،سألتُ أقاربنا ومعارفنا بالطبع
Dialogue: 0,0:08:14.10,0:08:15.56,Default,,0000,0000,0000,,لكن لم يعرف أحدٌ شيئاً
Dialogue: 0,0:08:15.56,0:08:21.48,Default,,0000,0000,0000,,لكن ألا تعني السلسلة أنّه يكتب النصوص؟
Dialogue: 0,0:08:21.93,0:08:23.48,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:24.18,0:08:29.57,Default,,0000,0000,0000,,لغرابة الأمر، تُرسل النصوص بالفاكس لدائرة التحرير
Dialogue: 0,0:08:29.85,0:08:33.36,Default,,0000,0000,0000,,كلّ سبت في منتصف الليل تماماً
Dialogue: 0,0:08:38.26,0:08:43.59,Default,,0000,0000,0000,,لـ-لكن ألا تحمل رسائل الفاكس تلك\Nرقم هاتف المرسل وما شابه؟
Dialogue: 0,0:08:43.98,0:08:46.06,Default,,0000,0000,0000,,كلا، لا شيء
Dialogue: 0,0:08:46.06,0:08:49.55,Default,,0000,0000,0000,,يبدو أنّ المرسل ضبطها بحيث \Nلا تعرض تلك الأشياء
Dialogue: 0,0:08:49.97,0:08:51.06,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:08:51.06,0:08:52.55,Default,,0000,0000,0000,,...لعلّه
Dialogue: 0,0:08:53.42,0:08:56.27,Default,,0000,0000,0000,,في رحلة في مكان ما مع زوجته
Dialogue: 0,0:08:56.60,0:08:59.35,Default,,0000,0000,0000,,ويرسل الفاكس من الفندق\Nالذي يقطنان فيه
Dialogue: 0,0:08:59.35,0:09:02.23,Default,,0000,0000,0000,,ذلك ما ظننتُه بدايةً
Dialogue: 0,0:09:02.69,0:09:08.97,Default,,0000,0000,0000,,لكن لم يسبق أن يقطعا\N!تواصلهما معي لشهرين هكذا
Dialogue: 0,0:09:08.97,0:09:11.91,Default,,0000,0000,0000,,!لا يسعني سوى التفكير أنّ أمراً ما حلّ بهما
Dialogue: 0,0:09:13.68,0:09:16.45,Default,,0000,0000,0000,,هلّ اتّصلتِ بالشرطة؟
Dialogue: 0,0:09:16.45,0:09:17.76,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:17.76,0:09:22.56,Default,,0000,0000,0000,,قدّمت طلب تحقيق لهم، لكن لم ترد مكالمات فدية
Dialogue: 0,0:09:22.56,0:09:26.42,Default,,0000,0000,0000,,والنصوص تُرسل، فأخبروني أنّ لا داعي للقلق
Dialogue: 0,0:09:27.30,0:09:32.02,Default,,0000,0000,0000,,،جرّبتُ الذهاب لوكالات التحرّي الأخرى\Nلكنّهم قالوا جميعاً الأمر نفسه
Dialogue: 0,0:09:34.92,0:09:36.97,Default,,0000,0000,0000,,هذا أملي الأخير
Dialogue: 0,0:09:37.98,0:09:39.93,Default,,0000,0000,0000,,لا أستطيع الاعتماد على سواك يا موري-سان
Dialogue: 0,0:09:41.42,0:09:43.59,Default,,0000,0000,0000,,لا فائدة
Dialogue: 0,0:09:43.59,0:09:46.11,Default,,0000,0000,0000,,نحن نهدر وقتنا بالجلوس هنا
Dialogue: 0,0:09:47.82,0:09:53.38,Default,,0000,0000,0000,,لنذهب لدائرة التحرير التي تتلقّى النصوص
Dialogue: 0,0:09:53.38,0:09:56.33,Default,,0000,0000,0000,,يمكنك تأجيل قلقك لبعد ذلك
Dialogue: 0,0:09:57.87,0:09:59.79,Default,,0000,0000,0000,,!أ-أجل
Dialogue: 0,0:10:03.00,0:10:05.38,Default,,0000,0000,0000,,!تاكسي
Dialogue: 0,0:10:08.67,0:10:09.55,Default,,0000,0000,0000,,تفضّلي
Dialogue: 0,0:10:22.63,0:10:26.81,Default,,0000,0000,0000,,أجل، تصلنا نصوص شينمي سينسي أسبوعياً
Dialogue: 0,0:10:23.96,0:10:26.81,On Top,,0000,0000,0000,,دايغاكوكان
Dialogue: 0,0:10:27.17,0:10:32.46,Default,,0000,0000,0000,,الليلة هي الموعد المعتاد، يُفترض أن تُرسل قريباً
Dialogue: 0,0:10:32.46,0:10:36.74,Default,,0000,0000,0000,,أتلك النصوص من تأليفه حقّاً؟
Dialogue: 0,0:10:37.17,0:10:42.34,Default,,0000,0000,0000,,أجل، إنّها مطبوعة،  لكن أسلوب الكتابة يخصّه بلا شكّ
Dialogue: 0,0:10:42.34,0:10:46.75,Default,,0000,0000,0000,,ويوقّع باسمه بجوار العنوان كلّ مرّة أيضاً
Dialogue: 0,0:10:46.75,0:10:50.34,Default,,0000,0000,0000,,يمكنني أن أريكم فاكس النصّ إذا أردتم
Dialogue: 0,0:10:50.34,0:10:55.30,On Top,,0000,0000,0000,,نصفان في القمّة
Dialogue: 0,0:10:57.01,0:10:59.26,Default,,0000,0000,0000,,العنوان هو "نصفان في القمّة" إذاً؟
Dialogue: 0,0:11:00.13,0:11:02.27,Default,,0000,0000,0000,,وتوقيعه موجود أيضاً
Dialogue: 0,0:11:06.05,0:11:09.21,Default,,0000,0000,0000,,أأنتِ متأكّدة أنّ هذا توقيعه؟
Dialogue: 0,0:11:09.21,0:11:13.15,Default,,0000,0000,0000,,أجل، فقد تأكّدت منه عندما أتيت هنا قبلاً
Dialogue: 0,0:11:13.44,0:11:16.76,Default,,0000,0000,0000,,لا تقلقي يا كاوري-سان
Dialogue: 0,0:11:16.76,0:11:22.51,Default,,0000,0000,0000,,لا بدّ أنّه منهمك بالكتابة ونسي التواصل معك
Dialogue: 0,0:11:22.51,0:11:25.87,Default,,0000,0000,0000,,!هذا شائعٌ بين الروائيين
Dialogue: 0,0:11:28.05,0:11:32.55,Default,,0000,0000,0000,,لكن أنسي حقّاً؟ فزوجته معه
Dialogue: 0,0:11:34.51,0:11:36.51,Default,,0000,0000,0000,,...حسناً، بذكرك ذلك
Dialogue: 0,0:11:36.51,0:11:40.84,Default,,0000,0000,0000,,هل بدا عليه أيّ اختلاف؟
Dialogue: 0,0:11:40.84,0:11:42.13,Default,,0000,0000,0000,,اختلاف؟
Dialogue: 0,0:11:42.13,0:11:44.98,Default,,0000,0000,0000,,تجرون اجتماعات، أليس كذلك؟
Dialogue: 0,0:11:44.98,0:11:50.59,Default,,0000,0000,0000,,،بلى، أجرينا اجتماعاً بسيطاً قبل بدئنا السلسلة
Dialogue: 0,0:11:50.59,0:11:54.44,Default,,0000,0000,0000,,لكن لم يبد عليه اختلاف محدّد
Dialogue: 0,0:11:54.71,0:11:59.67,Default,,0000,0000,0000,,أيمكنك التذكّر؟ أيّ شيء بسيط قد يفيد
Dialogue: 0,0:12:00.84,0:12:06.96,Default,,0000,0000,0000,,إذا كنتُ سأذكر شيئاً، فهو إكماله\Nلسلسلة المتحرّي سامونجي هذه
Dialogue: 0,0:12:07.24,0:12:07.92,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:08.38,0:12:14.17,Default,,0000,0000,0000,,في الواقع، كنتُ ألحّ عليه بإكمال\Nهذه السلسلة للأربعة أعوام الفائتة
Dialogue: 0,0:12:14.17,0:12:17.05,Default,,0000,0000,0000,,لكن كان ردّه ثابتاً
Dialogue: 0,0:12:17.05,0:12:22.34,Default,,0000,0000,0000,,"سامونجي ميت، لا يمكن أن أعيده للحياة"
Dialogue: 0,0:12:22.34,0:12:27.94,Default,,0000,0000,0000,,ما قاله، فكنتُ مستسلماً تقريباً\Nحتّى اتّصل فجأةً قبل شهرين
Dialogue: 0,0:12:27.94,0:12:34.42,Default,,0000,0000,0000,,وسألنا إذا ما نستطيع توفير مساحة في المجلة\Nبما أنّه يريد إكمال سامونجي
Dialogue: 0,0:12:35.36,0:12:39.34,Default,,0000,0000,0000,,سرّنا قبول ذلك بالطبع
Dialogue: 0,0:12:39.34,0:12:42.34,Default,,0000,0000,0000,,وألغينا السلسلة الجديدة التي حدّدناها في عجلة
Dialogue: 0,0:12:42.34,0:12:44.33,Default,,0000,0000,0000,,واستبدلناها بسامونجي
Dialogue: 0,0:12:44.63,0:12:47.04,Default,,0000,0000,0000,,فهمت، أيّ شيءٍ آخر؟
Dialogue: 0,0:12:50.15,0:12:54.05,Default,,0000,0000,0000,,...بالمناسبة، لا يخصّه هذا تحديداً
Dialogue: 0,0:12:54.05,0:12:56.96,Default,,0000,0000,0000,,:لكنّه كتب التالي في صفحة الإهداء في السلسلة
Dialogue: 0,0:12:57.63,0:13:00.76,Default,,0000,0000,0000,,،إلى كلّ متحرّيي البلاد المرموقين"
Dialogue: 0,0:13:00.76,0:13:07.02,Default,,0000,0000,0000,,إذا أردتم تخطّي حنكتي، فحلّوا لغز \N!هذه القضيّة الحقيقيّ
Dialogue: 0,0:13:07.02,0:13:09.94,Default,,0000,0000,0000,,يا للإهداء المشعّ تحدياً
Dialogue: 0,0:13:10.34,0:13:14.34,Default,,0000,0000,0000,,أجل، وأصبحنا نتلقى رسائل ومكالمات\Nمن المعجبين منذ الفصل الأوّل
Dialogue: 0,0:13:14.34,0:13:18.90,Default,,0000,0000,0000,,"!بـ "هذا الشخص مريب!" و"هكذا هي الحيلة
Dialogue: 0,0:13:19.46,0:13:22.21,Default,,0000,0000,0000,,الأمر يسعدني بصفتي المحرّر
Dialogue: 0,0:13:22.21,0:13:26.24,Default,,0000,0000,0000,,لكنّي رأيتها بادرة نادرة من روائيّ خلوق مثله
Dialogue: 0,0:13:26.46,0:13:31.55,Default,,0000,0000,0000,,رغم أنّه عمل جديد لسلسلة كان المعجبون\N بانتظارها بإلحاح لعشرة أعوام
Dialogue: 0,0:13:31.55,0:13:33.96,Default,,0000,0000,0000,,فمن الطبيعيّ أن يكون التفاعل مرتفعاً
Dialogue: 0,0:13:34.68,0:13:36.85,Default,,0000,0000,0000,,بإلحاح؟
Dialogue: 0,0:13:37.06,0:13:41.39,Default,,0000,0000,0000,,أجل، وصل الأمر بحيث تلقّينا اتّصالاً\Nمخيفاً من معجب مجنون العام الفائت
Dialogue: 0,0:13:41.39,0:13:46.77,Default,,0000,0000,0000,,يهدّدنا فيه بإضرام الحريق في المكان\Nإذا لم نكمل السلسلة
Dialogue: 0,0:13:48.26,0:13:50.15,Default,,0000,0000,0000,,يا للتطرّف
Dialogue: 0,0:13:50.56,0:13:54.61,Default,,0000,0000,0000,,صحيح، صحيح، هنالك أمرٌ غريب آخر
Dialogue: 0,0:13:54.61,0:13:57.56,Default,,0000,0000,0000,,ظهر سينسي في روايته
Dialogue: 0,0:13:57.56,0:13:58.58,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:58.97,0:14:04.85,Default,,0000,0000,0000,,يظهر شينمي سينسي في القصّة بصفته\Nصديقاً قديماً لسامونجي
Dialogue: 0,0:14:04.85,0:14:08.59,Default,,0000,0000,0000,,في إطار روائيّ غير ناجح يقيم في فرنسا
Dialogue: 0,0:14:09.39,0:14:13.55,Default,,0000,0000,0000,,،تتألّف السلسلة من قرابة 40 كتاباً\Nلكن هذا الأمر غير مسبوق
Dialogue: 0,0:14:15.22,0:14:19.31,Default,,0000,0000,0000,,أظنّه سيختتم القصّة بكون\Nكلّ القضايا السابقة
Dialogue: 0,0:14:19.31,0:14:22.31,Default,,0000,0000,0000,,أشياء أخبره سامونجي عنها
Dialogue: 0,0:14:22.31,0:14:26.27,Default,,0000,0000,0000,,مثل وضع واتسون بالنسبة لشارلوك هولمز
Dialogue: 0,0:14:26.64,0:14:29.23,Default,,0000,0000,0000,,أيمكنك أن تريني ذاك المشهد؟
Dialogue: 0,0:14:29.23,0:14:30.97,Default,,0000,0000,0000,,!أجل، بالطبع
Dialogue: 0,0:14:35.14,0:14:37.97,Default,,0000,0000,0000,,لكن أيمكنك قراءة الكانجي يا فتى؟
Dialogue: 0,0:14:37.97,0:14:39.49,Default,,0000,0000,0000,,قليلاً
Dialogue: 0,0:14:42.88,0:14:44.91,Default,,0000,0000,0000,,!بالفعل! ها هو
Dialogue: 0,0:14:44.91,0:14:48.14,Default,,0000,0000,0000,,يحقّق شينمي سينسي ظهوره الأوّل
Dialogue: 0,0:14:48.14,0:14:54.51,Default,,0000,0000,0000,,عندما يتّصل سامونجي بصديق يعيش\Nفي فرنسا لاستشارته في قضيّة
Dialogue: 0,0:14:54.51,0:14:57.85,Default,,0000,0000,0000,,!شخصيته متحامقة وطريفة
Dialogue: 0,0:14:58.89,0:15:01.43,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:15:06.39,0:15:07.56,Default,,0000,0000,0000,,!هذا غريب
Dialogue: 0,0:15:08.68,0:15:10.02,Default,,0000,0000,0000,,انظروا
Dialogue: 0,0:15:10.47,0:15:14.86,Default,,0000,0000,0000,,،العاشرة في "12" مكتوبة هنا بالكانجي\Nلكن "1" مكتوبٌ كرقم
Dialogue: 0,0:15:15.47,0:15:19.85,Default,,0000,0000,0000,,لا بدّ أنّه كان متعباً جدّاً
Dialogue: 0,0:15:21.10,0:15:25.25,Default,,0000,0000,0000,,...هذا غريب بالفعل، أيمكن أّنّه
Dialogue: 0,0:15:25.93,0:15:29.60,Default,,0000,0000,0000,,خطأ... في الطباعة لديكم؟
Dialogue: 0,0:15:29.60,0:15:30.71,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:15:31.47,0:15:36.01,Default,,0000,0000,0000,,،أردنا إصلاحها لتسهيل القراءة أيضاً
Dialogue: 0,0:15:36.01,0:15:41.47,Default,,0000,0000,0000,,لكنّه قال "تنظيم الأحرف هو بمثابة \N"حياة الرواية! لا تغيّروه أبداً
Dialogue: 0,0:15:41.47,0:15:44.14,Default,,0000,0000,0000,,ردّد هذا مراراً قبل بدء السلسلة
Dialogue: 0,0:15:44.14,0:15:51.77,Default,,0000,0000,0000,,كما قال أنّه سيلغي السلسلة فوراً\Nإذا نشرنا شيئاً يخالف إرادته
Dialogue: 0,0:15:52.56,0:15:55.26,Default,,0000,0000,0000,,هذا يثير الغرابة أكثر
Dialogue: 0,0:15:55.26,0:15:59.74,Default,,0000,0000,0000,,كما لو أنّ هنالك شيئاً\Nمخفيّاً في هذا العمل
Dialogue: 0,0:16:00.81,0:16:04.66,Default,,0000,0000,0000,,وما يثير حيرتي هو توقيع شينمي سينسي الخطّي
Dialogue: 0,0:16:06.26,0:16:10.62,Default,,0000,0000,0000,,إذا أصاب استنتاجي، ففي أسوأ الأحوال\N...لعلّه بالفعل فارق
Dialogue: 0,0:16:13.31,0:16:16.09,Default,,0000,0000,0000,,!ها هو! فاكس سينسي
Dialogue: 0,0:16:20.35,0:16:22.01,Default,,0000,0000,0000,,...لنرَ
Dialogue: 0,0:16:22.01,0:16:24.26,Default,,0000,0000,0000,,!لا يمكنك النظر بعد
Dialogue: 0,0:16:24.26,0:16:29.56,Default,,0000,0000,0000,,إنّها رواية غموض، انتظر نشرها في الكتاب لقراءتها
Dialogue: 0,0:16:31.47,0:16:32.67,Default,,0000,0000,0000,,!مهلك
Dialogue: 0,0:16:35.64,0:16:36.90,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:16:38.64,0:16:40.35,Default,,0000,0000,0000,,أنت! ما الذي تفعله؟
Dialogue: 0,0:16:40.35,0:16:43.03,Default,,0000,0000,0000,,لكنّ توقيعه غريب
Dialogue: 0,0:16:43.81,0:16:46.45,Default,,0000,0000,0000,,إنّه متطابق من الفصل السادس حتّى الثامن
Dialogue: 0,0:16:49.10,0:16:51.37,On Top,,0000,0000,0000,,نينتارو
Dialogue: 0,0:16:51.76,0:16:53.33,Default,,0000,0000,0000,,مـ-معك حقّ
Dialogue: 0,0:16:53.81,0:16:59.05,Default,,0000,0000,0000,,توقيع الفصول من الأوّل حتّى السادس\Nمختلف قليلاً، فلمَ يا ترى؟
Dialogue: 0,0:16:59.39,0:17:03.01,Default,,0000,0000,0000,,من الجلّي أنّه نسخ توقيعاً سابقاً
Dialogue: 0,0:17:03.39,0:17:05.22,Default,,0000,0000,0000,,ولمَ قد يفعل ذلك؟
Dialogue: 0,0:17:05.22,0:17:07.93,Default,,0000,0000,0000,,...لأنّه لم يعد يريد الكتابة
Dialogue: 0,0:17:09.64,0:17:10.89,Default,,0000,0000,0000,,أو لم يعد يستطيع؟
Dialogue: 0,0:17:11.35,0:17:12.64,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:17:12.64,0:17:14.40,Default,,0000,0000,0000,,،إذا لم يعد يستطيع الكتابة
Dialogue: 0,0:17:15.10,0:17:19.57,Default,,0000,0000,0000,,فلربما فارق شينمي سينسي الحياة سلفاً، أليس كذلك؟
Dialogue: 0,0:17:20.14,0:17:21.36,Default,,0000,0000,0000,,!لا-لا يمكن
Dialogue: 0,0:17:21.94,0:17:26.12,Default,,0000,0000,0000,,!هذا سيّئ! لا بدّ من تدخّل عاجل
Dialogue: 0,0:17:26.77,0:17:29.31,Default,,0000,0000,0000,,!أنت! اتّصل بالشرطة! الشرطة
Dialogue: 0,0:17:29.31,0:17:30.00,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:17:33.52,0:17:37.43,Default,,0000,0000,0000,,ليس الأمر مؤكّداً، هنالك فرصة ببقائه على قيد الحياة
Dialogue: 0,0:17:38.52,0:17:42.44,Default,,0000,0000,0000,,مفتاح إنقاذ حياته هو هذه الرواية غالباً
Dialogue: 0,0:17:42.44,0:17:44.10,Default,,0000,0000,0000,,لا بدّ أنّها موجودة في الداخل
Dialogue: 0,0:17:45.31,0:17:48.33,Default,,0000,0000,0000,,!رسالة تركها لنا نحن المتحرّيين
Dialogue: 0,0:17:52.44,0:17:54.57,Default,,0000,0000,0000,,لا يمكنكم بدء تحقيق رسميّ؟
Dialogue: 0,0:17:55.02,0:17:58.35,Default,,0000,0000,0000,,أجل، ليس في هذه المرحلة
Dialogue: 0,0:17:58.35,0:17:59.49,Default,,0000,0000,0000,,لا نستطيع بعد
Dialogue: 0,0:17:59.98,0:18:02.45,Default,,0000,0000,0000,,!مهلك رجاءً حضرة المفتّش
Dialogue: 0,0:18:03.11,0:18:08.31,Default,,0000,0000,0000,,والد كاوري-سان وروائيّ التحرّي الشهير شينمي نينتارو
Dialogue: 0,0:18:08.31,0:18:11.42,Default,,0000,0000,0000,,!مفقود لشهرين الآن
Dialogue: 0,0:18:11.86,0:18:15.56,Default,,0000,0000,0000,,!كما أنّ زوجته مفقودة معه
Dialogue: 0,0:18:15.56,0:18:19.89,Default,,0000,0000,0000,,لا يسعني التفكير سوى بأنّهما\N!علقا في حادثة ما
Dialogue: 0,0:18:20.40,0:18:27.85,Default,,0000,0000,0000,,لكنّ نصوصه تُرسل إلى دائرة التحرير\Nهذه بالفاكس أسبوعياً
Dialogue: 0,0:18:31.48,0:18:33.06,Default,,0000,0000,0000,,،رغم أنّه فاكس
Dialogue: 0,0:18:33.06,0:18:38.82,Default,,0000,0000,0000,,الابنة والمحرّرون مجمعون\Nعلى أنّ هذه كتابته
Dialogue: 0,0:18:39.15,0:18:44.61,Default,,0000,0000,0000,,!لكن كما قلت، المشكلة هي نصوص الفاكس هذه
Dialogue: 0,0:18:44.61,0:18:47.00,Default,,0000,0000,0000,,ألا تجد التواقيع غريبة؟
Dialogue: 0,0:18:47.31,0:18:52.46,Default,,0000,0000,0000,,التواقيع؟ لكن تمّ تأكيد أنّها للسيّد شينمي
Dialogue: 0,0:18:52.81,0:19:00.77,Default,,0000,0000,0000,,تواقيعه التي بجوار العنوان من الفصل\N،الأوّل حتّى السادس بها اختلاف جميعها
Dialogue: 0,0:19:00.77,0:19:04.43,Default,,0000,0000,0000,,!لكنّها متطابقة من الفصل السادس للثامن
Dialogue: 0,0:19:05.11,0:19:08.77,Default,,0000,0000,0000,,إنّها منسوخة من التوقيع السابق بلا شكّ
Dialogue: 0,0:19:08.77,0:19:13.48,Default,,0000,0000,0000,,وبرهانٌ على أنّه في حالة\Nلا تسمح له بالكتابة حالياً
Dialogue: 0,0:19:13.48,0:19:17.44,Default,,0000,0000,0000,,!مما يعني أنّ أمراً ما حلّ به
Dialogue: 0,0:19:17.66,0:19:22.90,Default,,0000,0000,0000,,أخبرني إذاً، من فعل ماذا لـ شينمي-سان؟
Dialogue: 0,0:19:22.90,0:19:27.73,Default,,0000,0000,0000,,كنتُ لأقتنع بكلامك أكثر\Nلو ورد اتّصال تهديد وما شابه
Dialogue: 0,0:19:27.73,0:19:30.37,Default,,0000,0000,0000,,لكن لم يرد شيء حتّى الآن
Dialogue: 0,0:19:30.94,0:19:36.34,Default,,0000,0000,0000,,كما لعلّه سئم من التوقيع كلّ مرّة\Nوقرر استعمال النسخ
Dialogue: 0,0:19:37.06,0:19:41.80,Default,,0000,0000,0000,,بالفعل، المفتّش ميغوري على حقّ بالنظر للظروف
Dialogue: 0,0:19:42.65,0:19:46.65,Default,,0000,0000,0000,,ليس غريباً في المرحلة الحالية\Nذهاب روائيّ غريب الطباع
Dialogue: 0,0:19:46.65,0:19:51.77,Default,,0000,0000,0000,,مع زوجته لعزل نفسيهما في مكان\Nللتركيز على الكتابة
Dialogue: 0,0:19:52.77,0:19:54.76,Default,,0000,0000,0000,,لكن هناك ما يضايقني
Dialogue: 0,0:19:54.11,0:19:57.87,On Top,,0000,0000,0000,,{\fad(600,0)}!إلى كلّ متحرّيي البلاد المرموقين
Dialogue: 0,0:19:54.76,0:19:57.73,Default,,0000,0000,0000,,ذاك التحدّي الذي لا يوافق صفاته \Nفي صفحة الإهداء
Dialogue: 0,0:19:58.27,0:20:03.66,Default,,0000,0000,0000,,كان متطرّفاً واستفزازياً بالنسبة\Nلرجل خلوق مثله
Dialogue: 0,0:20:03.66,0:20:08.00,Default,,0000,0000,0000,,كما هناك ظهور المؤلف الأوّل\Nالمفاجئ في السلسلة
Dialogue: 0,0:20:10.77,0:20:13.69,Default,,0000,0000,0000,,وهذا الحوار الغريب
Dialogue: 0,0:20:13.69,0:20:18.47,Default,,0000,0000,0000,,الذي يخلط الأرقام العددية وأرقام الكانجي والأحرف الإنجليزية
Dialogue: 0,0:20:20.59,0:20:22.69,Default,,0000,0000,0000,,،إذا أصاب استنتاجي
Dialogue: 0,0:20:22.69,0:20:27.06,Default,,0000,0000,0000,,فيُفترض أنّ هنالك رسالة من شينمي سينسي\Nبين ثنايا هذه الجمل
Dialogue: 0,0:20:27.36,0:20:34.65,Default,,0000,0000,0000,,حضرة المفتّش، نسخت كلّ الأسطر التي\Nأثارت حفيظة موري-سان
Dialogue: 0,0:20:37.86,0:20:40.99,Default,,0000,0000,0000,,ظهر السيّد شينمي أربع مرّات للآن؟
Dialogue: 0,0:20:41.94,0:20:43.45,Default,,0000,0000,0000,,هلّا أعطيتني نسخة؟
Dialogue: 0,0:20:43.73,0:20:46.41,Default,,0000,0000,0000,,!كلا! لا تتدخّل
Dialogue: 0,0:20:47.31,0:20:49.61,Default,,0000,0000,0000,,لا بأس، توجد نسخ إضافيّة
Dialogue: 0,0:20:49.61,0:20:50.42,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:20:50.42,0:20:51.37,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:20:51.61,0:20:57.61,Default,,0000,0000,0000,,حسناً، كان ظهوره الأوّل عندما اتّصل\Nالبطل المتحرّي
Dialogue: 0,0:20:57.61,0:21:01.34,Default,,0000,0000,0000,,بالسيّد شينمي المقيم في فرنسا
Dialogue: 0,0:21:02.36,0:21:04.80,Default,,0000,0000,0000,,وهو في فرنسا في المرّة الثانية أيضاً
Dialogue: 0,0:21:06.40,0:21:08.93,Default,,0000,0000,0000,,...وكذلك فرنسا في المرّة الثالثة
Dialogue: 0,0:21:09.86,0:21:11.64,Default,,0000,0000,0000,,والمرّة الرابعة أيضاً
Dialogue: 0,0:21:13.11,0:21:15.94,Default,,0000,0000,0000,,هل يحبّ السيّد شينمي فرنسا؟
Dialogue: 0,0:21:15.94,0:21:19.11,Default,,0000,0000,0000,,أجل، اعتاد السفر لها مع أمّي
Dialogue: 0,0:21:19.44,0:21:25.19,Default,,0000,0000,0000,,تبّاً! حتّى القراءة بالمقلوب\N!وإعادة الترتيب لا تعطي شيئاً
Dialogue: 0,0:21:25.19,0:21:28.12,Default,,0000,0000,0000,,...لو، لو امتلكت نقطة بداية
Dialogue: 0,0:21:29.20,0:21:34.91,Default,,0000,0000,0000,,المعذرة، أتمانع لو استعملنا نصّ\Nالفصل الثامن من "نصفان في القمّة
Dialogue: 0,0:21:34.91,0:21:36.34,Default,,0000,0000,0000,,الذي أرسله سينسي قبل قليل؟
Dialogue: 0,0:21:36.78,0:21:38.55,Default,,0000,0000,0000,,نصفان في القمّة؟
Dialogue: 0,0:21:38.55,0:21:43.39,Default,,0000,0000,0000,,بربّك، إنّه عنوان العمل الذي تقرؤه الآن
Dialogue: 0,0:21:44.28,0:21:45.95,Default,,0000,0000,0000,,...نصفان في
Dialogue: 0,0:21:47.74,0:21:49.61,Default,,0000,0000,0000,,!نصفان في القمّة؟
Dialogue: 0,0:21:50.74,0:21:54.28,Default,,0000,0000,0000,,...انتظر، أيمكن... أيمكن أنّ هذه
Dialogue: 0,0:22:01.07,0:22:02.70,Default,,0000,0000,0000,,!هـ-هذا
Dialogue: 0,0:22:03.41,0:22:05.07,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:22:05.07,0:22:08.66,Default,,0000,0000,0000,,توجد رسالة مخفية من شينمي سينسي\N!بين هذه الأسطر
Dialogue: 0,0:22:09.36,0:22:15.07,Default,,0000,0000,0000,,في تلك الحالة، ذاك الإهداء الاستفزازي\Nوظهور المؤلّف في العمل
Dialogue: 0,0:22:15.07,0:22:18.70,Default,,0000,0000,0000,,!والحوار الغريب، كلّها تتوافق
Dialogue: 0,0:22:20.32,0:22:26.83,Default,,0000,0000,0000,,لكن ما هدف الفاعل الذي يحتجز\N!شينمي سينسي وزوجته؟
Dialogue: 0,0:24:01.83,0:24:02.95,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:24:03.55,0:24:05.09,Default,,0000,0000,0000,,ما الأمر يا تاكاغي-كن؟
Dialogue: 0,0:24:05.09,0:24:07.71,Default,,0000,0000,0000,,انظر لهذا النصّ، لا يزال هنالك حوار
Dialogue: 0,0:24:09.81,0:24:13.67,Default,,0000,0000,0000,,ماذا؟ هذا الفصل الثامن\Nالذي أُرسل للتوّ؟
Dialogue: 0,0:24:14.40,0:24:15.38,Default,,0000,0000,0000,,"أسرعوا"
Dialogue: 0,0:24:15.93,0:24:17.39,Default,,0000,0000,0000,,"الوقت"
Dialogue: 0,0:24:17.39,0:24:19.06,Default,,0000,0000,0000,,"ينفد"
Dialogue: 0,0:24:20.97,0:24:23.52,Default,,0000,0000,0000,,"بسرعة، الوقت ينفد"
Dialogue: 0,0:24:25.60,0:24:31.60,On Top,,0000,0000,0000,,جريمة اختفاء مؤلف روايات الغموض\N(الجزء الثاني)
Dialogue: 0,0:24:26.14,0:24:27.64,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.64,0:24:31.28,Default,,0000,0000,0000,,جريمة اختفاء مؤلف روايات الغموض\N(الجزء الثاني)
Dialogue: 0,0:24:47.42,0:24:50.17,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:50.17,0:24:51.62,Default,,0000,0000,0000,,لغة فرنسيّة
Dialogue: 0,0:24:52.01,0:24:54.37,Default,,0000,0000,0000,,لدينا رسالة من المؤلف آوياما سينسي
Dialogue: 0,0:24:54.37,0:24:56.37,Default,,0000,0000,0000,,ماذا؟ أيقول أنّ هذا الركن ناجح؟

