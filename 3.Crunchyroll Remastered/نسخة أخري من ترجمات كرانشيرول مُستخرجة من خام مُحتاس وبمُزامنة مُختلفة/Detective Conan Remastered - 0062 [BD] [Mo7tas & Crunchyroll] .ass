Dialogue: 0,0:00:01.63,0:00:04.84,Default,,0000,0000,0000,,،عقرب دقائق مسرِع، مُذنّب ساقط\Nدمية آلية الخروج، وحشد ناس
Dialogue: 0,0:00:04.84,0:00:08.40,Default,,0000,0000,0000,,تبلل الاستنتاجات المفككة للغموض\Nأسوار القلوب الجافة
Dialogue: 0,0:00:08.40,0:00:11.28,Default,,0000,0000,0000,,!قضيّة اليوم عن الطمع! مليار ينّ ذهباً
Dialogue: 0,0:00:11.63,0:00:13.49,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:13.49,0:00:15.24,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:15.24,0:00:16.81,Default,,0000,0000,0000,,!إنّه المتحرّي كونان
Dialogue: 0,0:01:51.66,0:01:54.33,Default,,0000,0000,0000,,ريوجين مارو التي اختفت قبل 7 أعوام
Dialogue: 0,0:01:54.33,0:01:59.03,Default,,0000,0000,0000,,وعلى متنها مليار ينّ ذهباً عاودت الظهور\Nعلى جزيرة شيكي فجأةً
Dialogue: 0,0:01:59.94,0:02:01.95,Default,,0000,0000,0000,,لكنّ الذهب اختفى
Dialogue: 0,0:02:03.32,0:02:08.06,Default,,0000,0000,0000,,دُعي العمّ للجزيرة التي جذبت انتباهاً
Dialogue: 0,0:02:08.06,0:02:09.53,Default,,0000,0000,0000,,بسبب سفينة الأشباح
Dialogue: 0,0:02:10.99,0:02:16.21,Default,,0000,0000,0000,,...أتينا كسيّاح، لكنّ دافع العمدة الحقيقيّ
Dialogue: 0,0:02:16.21,0:02:20.07,Default,,0000,0000,0000,,كان جعل العمّ يجد مكان الذهب المفقود
Dialogue: 0,0:02:22.46,0:02:25.12,Default,,0000,0000,0000,,حاول أحدهم قتله أثناء محاضرته
Dialogue: 0,0:02:26.04,0:02:28.98,Default,,0000,0000,0000,,كان الفاعل هامادا، حارس المنارة بحروق الوجه
Dialogue: 0,0:02:29.45,0:02:34.41,Default,,0000,0000,0000,,وبدا أنّ موظف وكالة السفر المشبوه\Nالمدعوّ أويهارا يعرفه
Dialogue: 0,0:02:35.16,0:02:37.57,Default,,0000,0000,0000,,من هذان الاثنان بالضبط؟
Dialogue: 0,0:02:38.40,0:02:41.57,Default,,0000,0000,0000,,تعرّض العمّ تلك الليلة للهجوم من قبل مُحارب
Dialogue: 0,0:02:41.57,0:02:45.37,Default,,0000,0000,0000,,ولاحقه بعدما نجا من الموت بصعوبة
Dialogue: 0,0:02:46.35,0:02:49.57,Default,,0000,0000,0000,,...أفقده أحدهم وعيه ونصب له فخّاً
Dialogue: 0,0:02:52.27,0:02:55.10,Default,,0000,0000,0000,,فجعله قاتل هامادا
Dialogue: 0,0:02:58.67,0:03:04.66,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل سفينة الأشباح (الجزء الثاني
Dialogue: 0,0:02:59.26,0:03:02.37,Default,,0000,0000,0000,,(جريمة قتل سفينة الأشباح (الجزء الثاني
Dialogue: 0,0:03:04.66,0:03:05.71,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:03:05.71,0:03:07.50,Default,,0000,0000,0000,,حتّى لو كنت متحرّياً شهيراً
Dialogue: 0,0:03:07.50,0:03:09.86,Default,,0000,0000,0000,,!لا يمكنك أن تفلت بجريمة قتل
Dialogue: 0,0:03:09.86,0:03:14.08,Default,,0000,0000,0000,,الأمر ليس هكذا! هاجمني هذا الشخص\N!فجأةً أثناء نومي
Dialogue: 0,0:03:14.08,0:03:17.61,Default,,0000,0000,0000,,لاحقتُه إلى هنا، وضُربت من مؤخرة رأسي
Dialogue: 0,0:03:17.61,0:03:19.82,Default,,0000,0000,0000,,!وعندما أفقت كان على حاله هذه
Dialogue: 0,0:03:19.82,0:03:24.07,Default,,0000,0000,0000,,قتلته في نوبة غضبك غالباً
Dialogue: 0,0:03:24.07,0:03:25.07,Default,,0000,0000,0000,,!أخبرتك كلا
Dialogue: 0,0:03:25.40,0:03:28.98,Default,,0000,0000,0000,,...لكنّ الدرع الذي يرتديه كان مُحتفظاً به
Dialogue: 0,0:03:28.98,0:03:30.73,Default,,0000,0000,0000,,في متحف أثريات سويغون
Dialogue: 0,0:03:30.73,0:03:33.35,Default,,0000,0000,0000,,لمَ درع سويغون آخر؟
Dialogue: 0,0:03:33.95,0:03:36.23,Default,,0000,0000,0000,,أيمكن أنّها اللعنة؟
Dialogue: 0,0:03:36.23,0:03:37.94,Default,,0000,0000,0000,,!لا تكن أحمق
Dialogue: 0,0:03:38.26,0:03:40.13,Default,,0000,0000,0000,,!كلا، لا بدّ أنّها هي
Dialogue: 0,0:03:40.13,0:03:42.91,Default,,0000,0000,0000,,!مُسَّ هامادا ودُفِع لارتداء هذا الزيّ حتماً
Dialogue: 0,0:03:43.22,0:03:46.11,Default,,0000,0000,0000,,!اصمتوا! اللعنة مجرد خرافة
Dialogue: 0,0:03:46.46,0:03:49.03,Default,,0000,0000,0000,,!لمَ يرتدي هامادا هذا الدرع إذاً؟
Dialogue: 0,0:03:49.03,0:03:50.25,Default,,0000,0000,0000,,...في الواقع، هذا
Dialogue: 0,0:03:50.25,0:03:54.07,Default,,0000,0000,0000,,مهلكم، لا جدوى من الجدال هنا
Dialogue: 0,0:03:55.21,0:03:57.73,Default,,0000,0000,0000,,طعنة السيف هذه هي ما قتله
Dialogue: 0,0:03:59.32,0:04:01.70,Default,,0000,0000,0000,,هل نُزعت أكمامه أثناء الصراع؟
Dialogue: 0,0:04:02.86,0:04:04.12,Default,,0000,0000,0000,,!آثار تقييد
Dialogue: 0,0:04:06.69,0:04:09.89,Default,,0000,0000,0000,,...تغطيه الجروح، لكنّ هذه
Dialogue: 0,0:04:10.98,0:04:13.45,Default,,0000,0000,0000,,على الأطفال ألّا يروا أشياء كهذه
Dialogue: 0,0:04:14.31,0:04:15.48,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:04:17.68,0:04:20.61,Default,,0000,0000,0000,,لحظة، أين تذهب يا كونان-كن؟
Dialogue: 0,0:04:24.01,0:04:27.12,Default,,0000,0000,0000,,كونان-كن! ستقع في مشكلة\N!إن دخلت هكذا
Dialogue: 0,0:04:30.92,0:04:33.92,Default,,0000,0000,0000,,!لا شكّ في الأمر، قُتل هامادا-سان هنا
Dialogue: 0,0:04:35.91,0:04:37.32,Default,,0000,0000,0000,,جافّ
Dialogue: 0,0:04:37.32,0:04:38.61,Default,,0000,0000,0000,,أهذا دم؟
Dialogue: 0,0:04:38.61,0:04:40.82,Default,,0000,0000,0000,,!ران-نيتشان! استدعي الشرطيّ
Dialogue: 0,0:04:46.52,0:04:49.65,Default,,0000,0000,0000,,يبدو أنّه قُتل هنا بالفعل
Dialogue: 0,0:04:49.65,0:04:53.02,Default,,0000,0000,0000,,...لكنّ ذلك لا يُبرئ ساحة المتحرّي
Dialogue: 0,0:04:53.02,0:04:54.16,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:04:54.16,0:04:58.72,Default,,0000,0000,0000,,غضب سويغون-ساما بسبب عبث\N!دخيل في الأرجاء
Dialogue: 0,0:04:58.72,0:05:00.16,Default,,0000,0000,0000,,...انتظروا
Dialogue: 0,0:05:00.16,0:05:01.26,Default,,0000,0000,0000,,!ستحميه؟
Dialogue: 0,0:05:01.26,0:05:03.57,Default,,0000,0000,0000,,!ستصيبك لعنة سويغون-ساما أيضاً هكذا
Dialogue: 0,0:05:03.57,0:05:05.30,Default,,0000,0000,0000,,!أنتم! توقفوا
Dialogue: 0,0:05:06.38,0:05:07.98,Default,,0000,0000,0000,,...الوضع سيّئ هكذا
Dialogue: 0,0:05:10.63,0:05:11.84,Default,,0000,0000,0000,,!ها هي
Dialogue: 0,0:05:13.96,0:05:17.41,Default,,0000,0000,0000,,!ماذا؟ ما الذي يجري؟! سويغون-ساما؟
Dialogue: 0,0:05:19.95,0:05:21.24,Default,,0000,0000,0000,,يا للسخرية
Dialogue: 0,0:05:21.24,0:05:23.03,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:05:23.03,0:05:26.48,Default,,0000,0000,0000,,لا أعرف من وراء هذا، لكن إن ظنّ\Nبإمكانه تلفيق تهمة بي
Dialogue: 0,0:05:26.48,0:05:30.15,Default,,0000,0000,0000,,بحيلة طفولية كهذه، فقد اقترف خطأً فادحاً
Dialogue: 0,0:05:30.52,0:05:32.36,Default,,0000,0000,0000,,!تقصد أنّك لم تكن الفاعل؟
Dialogue: 0,0:05:32.36,0:05:33.77,Default,,0000,0000,0000,,بالطبع لا
Dialogue: 0,0:05:33.77,0:05:37.52,Default,,0000,0000,0000,,كان ميتاً قبل وصولي هنا
Dialogue: 0,0:05:37.52,0:05:38.82,Default,,0000,0000,0000,,!هراء
Dialogue: 0,0:05:39.10,0:05:42.35,Default,,0000,0000,0000,,دليل ذلك هي بركة الدم على القارب
Dialogue: 0,0:05:42.35,0:05:45.14,Default,,0000,0000,0000,,إذا كنتُ قد قتلته، فيُفترض أنّ ذلك\Nكان قبل 30 دقيقة
Dialogue: 0,0:05:46.25,0:05:48.82,Default,,0000,0000,0000,,لكنّ الدم على القارب جاف تماماً
Dialogue: 0,0:05:49.17,0:05:53.03,Default,,0000,0000,0000,,كيفما نظرتم للأمر، فقد مضت 3 إلى 4 ساعات
Dialogue: 0,0:05:53.25,0:05:54.99,Default,,0000,0000,0000,,...صـ-صحيح
Dialogue: 0,0:05:54.99,0:05:58.49,Default,,0000,0000,0000,,من هاجمني كان شخصاً غير هامادا
Dialogue: 0,0:05:58.49,0:06:00.15,Default,,0000,0000,0000,,هو من قتل هامادا
Dialogue: 0,0:06:01.49,0:06:06.73,Default,,0000,0000,0000,,بعد قتله له، هاجمني بدرع سويغون
Dialogue: 0,0:06:06.73,0:06:12.07,Default,,0000,0000,0000,,لاستدراجي هنا وجعلي أبدو قاتل هامادا
Dialogue: 0,0:06:12.32,0:06:13.73,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:06:13.73,0:06:18.39,Default,,0000,0000,0000,,قيّد ذاك الشخص هامادا في القارب وعذّبه
Dialogue: 0,0:06:18.39,0:06:21.39,Default,,0000,0000,0000,,ودليل ذلك هي آثار الحبل على معصميه
Dialogue: 0,0:06:23.82,0:06:31.78,Default,,0000,0000,0000,,كما الجروح التي تغطي جسده كثيرة\Nوسطحية على أن تكون مُميتة
Dialogue: 0,0:06:31.78,0:06:33.61,Default,,0000,0000,0000,,مـ-معه حق
Dialogue: 0,0:06:33.88,0:06:38.37,Default,,0000,0000,0000,,أي أنّ القاتل قيّد هامادا وعذّبه
Dialogue: 0,0:06:38.37,0:06:40.82,Default,,0000,0000,0000,,لمَ قد يفعل شيئاً بهذه الفظاعة؟
Dialogue: 0,0:06:40.82,0:06:44.41,Default,,0000,0000,0000,,كان لهامادا علاقة بريوجين مارو غالباً
Dialogue: 0,0:06:44.41,0:06:46.23,Default,,0000,0000,0000,,لعلّه كان على متنها
Dialogue: 0,0:06:46.82,0:06:48.65,Default,,0000,0000,0000,,!وما أدراك بذلك؟
Dialogue: 0,0:06:48.98,0:06:53.16,Default,,0000,0000,0000,,كان منظار ريوجين مارو على المنارة
Dialogue: 0,0:06:53.16,0:06:55.86,Default,,0000,0000,0000,,ماذا؟ كيف عرفت ذلك؟
Dialogue: 0,0:06:55.86,0:06:57.18,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:06:57.18,0:06:59.28,Default,,0000,0000,0000,,!لا شيء يخفى على المتحرّي العظيم
Dialogue: 0,0:06:59.85,0:07:03.35,Default,,0000,0000,0000,,بالمناسبة، ظهر هامادا قبل 7 أعوام أيضاً
Dialogue: 0,0:07:03.35,0:07:07.78,Default,,0000,0000,0000,,كان القاتل يستخرج موقع\Nالذهب من هامادا إذاً؟
Dialogue: 0,0:07:08.26,0:07:12.24,Default,,0000,0000,0000,,أجل، كان هامادا يعرف مكانه على الأغلب
Dialogue: 0,0:07:12.92,0:07:18.09,Default,,0000,0000,0000,,وانتقل لهذه الجزيرة لحراسته
Dialogue: 0,0:07:18.09,0:07:25.57,Default,,0000,0000,0000,,لكنّه خشي أن أجده بعدما ظهرتُ فجأةً، فحاول قتلي
Dialogue: 0,0:07:26.57,0:07:33.07,Default,,0000,0000,0000,,رآه كونان وسوزو-كن يغادر\Nمن الباب الخلفيّ للمسرح أيضاً
Dialogue: 0,0:07:33.07,0:07:34.49,Default,,0000,0000,0000,,سوزو؟
Dialogue: 0,0:07:35.49,0:07:40.64,Default,,0000,0000,0000,,لكن كان هناك شخصاً آخر يبحث عن الذهب
Dialogue: 0,0:07:40.64,0:07:44.53,Default,,0000,0000,0000,,في نظره، كنتُ وهامادا عقبتين أمامه
Dialogue: 0,0:07:45.30,0:07:48.71,Default,,0000,0000,0000,,يفسّر ذلك مكيدته هنا
Dialogue: 0,0:07:48.71,0:07:51.19,Default,,0000,0000,0000,,...لـ-لكن لا يوجد شخص كهذا من أهل الجزيرة
Dialogue: 0,0:07:51.45,0:07:54.75,Default,,0000,0000,0000,,!ذاك الشخص! من أتى من طوكيو
Dialogue: 0,0:07:54.75,0:07:56.10,Default,,0000,0000,0000,,عامل وكالة السفر؟
Dialogue: 0,0:07:56.30,0:07:59.13,Default,,0000,0000,0000,,!كان يتشاجر مع هامادا
Dialogue: 0,0:07:59.13,0:08:00.94,Default,,0000,0000,0000,,مـ-ماذا؟
Dialogue: 0,0:08:00.94,0:08:02.34,Default,,0000,0000,0000,,أين يقيم؟
Dialogue: 0,0:08:02.34,0:08:04.10,Default,,0000,0000,0000,,في النُزل وفقما أظن
Dialogue: 0,0:08:04.94,0:08:07.12,Default,,0000,0000,0000,,هذا رائع يا أبي
Dialogue: 0,0:08:07.68,0:08:10.01,Default,,0000,0000,0000,,!لم أكن الفاعل! صدّقوني
Dialogue: 0,0:08:10.44,0:08:12.47,Default,,0000,0000,0000,,نعرف ذلك الآن
Dialogue: 0,0:08:17.29,0:08:19.07,Default,,0000,0000,0000,,!أيّها الشرطيّ، أسرع
Dialogue: 0,0:08:19.07,0:08:22.71,Default,,0000,0000,0000,,!لـ-لم يسبق وأن اعتقلنا مجرماً
Dialogue: 0,0:08:22.71,0:08:25.04,Default,,0000,0000,0000,,يا إلهي، لمَ أنت هنا إذاً؟
Dialogue: 0,0:08:25.04,0:08:26.02,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:08:26.02,0:08:27.84,Default,,0000,0000,0000,,إنّه خائف
Dialogue: 0,0:08:27.84,0:08:29.86,Default,,0000,0000,0000,,سأذهب أنا
Dialogue: 0,0:08:29.86,0:08:31.05,Default,,0000,0000,0000,,!نائب العمدة
Dialogue: 0,0:08:31.05,0:08:34.52,Default,,0000,0000,0000,,سأحاول إقناعه بتسليم نفسه
Dialogue: 0,0:08:34.52,0:08:35.65,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:08:35.65,0:08:38.65,Default,,0000,0000,0000,,كانت البلدية من استدعته هنا
Dialogue: 0,0:08:38.65,0:08:41.36,Default,,0000,0000,0000,,لذا هي مسؤوليتي كنائب العمدة
Dialogue: 0,0:08:52.72,0:08:54.26,Default,,0000,0000,0000,,...مضت 5 دقائق
Dialogue: 0,0:09:05.84,0:09:07.13,Default,,0000,0000,0000,,!كينوشيتا-سان
Dialogue: 0,0:09:07.83,0:09:08.78,Default,,0000,0000,0000,,أأنت بخير؟
Dialogue: 0,0:09:08.78,0:09:10.09,Default,,0000,0000,0000,,...هرب
Dialogue: 0,0:09:11.70,0:09:13.66,Default,,0000,0000,0000,,!فرّ من الخلف! الحقوا به
Dialogue: 0,0:09:15.04,0:09:19.01,Default,,0000,0000,0000,,...حاولتُ إقناعه، لكنه أطلق عليّ النار فجأةً
Dialogue: 0,0:09:19.01,0:09:21.47,Default,,0000,0000,0000,,!علينا أخذك للطبيب فوراً
Dialogue: 0,0:09:21.47,0:09:24.43,Default,,0000,0000,0000,,لا بأس، إنّه مجرد خدش
Dialogue: 0,0:09:27.22,0:09:30.96,Default,,0000,0000,0000,,لا أثر له على الطريق الخلفي، حوّل
Dialogue: 0,0:09:32.68,0:09:35.71,Default,,0000,0000,0000,,لا أثر له هنا أيضاً، حوّل
Dialogue: 0,0:09:36.34,0:09:40.26,Default,,0000,0000,0000,,عمل موفق، أعتذر لكن هلّا تركتما حرّاساً
Dialogue: 0,0:09:40.26,0:09:42.76,Default,,0000,0000,0000,,ورجعتما إلى هنا حالياً؟
Dialogue: 0,0:09:42.76,0:09:45.76,Default,,0000,0000,0000,,انتظر! بقيت هذه المنطقة
Dialogue: 0,0:09:47.91,0:09:50.68,Default,,0000,0000,0000,,...لا يمكننا تفقّد كهف سويغون
Dialogue: 0,0:09:51.50,0:09:57.32,Default,,0000,0000,0000,,،لن يقترب أحد من أهل الجزيرة منه\N...لا يمكن لمجرّد شرطيّ واحد
Dialogue: 0,0:09:57.32,0:09:59.73,Default,,0000,0000,0000,,!أيّ جُبن هذا؟
Dialogue: 0,0:09:59.73,0:10:01.49,Default,,0000,0000,0000,,!لمَ لا تذهب أنت إذاً؟
Dialogue: 0,0:10:01.49,0:10:03.64,Default,,0000,0000,0000,,سخافة! لمَ أنا؟
Dialogue: 0,0:10:10.56,0:10:16.55,Default,,0000,0000,0000,,إذا قتل أويهارا هامادا-سان، فلا بدّ أنه عرف مكان الذهب
Dialogue: 0,0:10:16.55,0:10:21.01,Default,,0000,0000,0000,,لكن في تلك الحالة، لمَ كان عليه تفتيش المنارة؟
Dialogue: 0,0:10:26.67,0:10:31.64,On Top,,0000,0000,0000,,الدخول ممنوع
Dialogue: 0,0:10:40.53,0:10:41.78,Default,,0000,0000,0000,,طُحلب
Dialogue: 0,0:10:41.78,0:10:44.61,Default,,0000,0000,0000,,!وهذا من الصنف الذي ينمو على الأرض
Dialogue: 0,0:10:45.60,0:10:47.97,Default,,0000,0000,0000,,لم يغرق هذا القارب بالفعل إذاً
Dialogue: 0,0:10:48.60,0:10:54.39,Default,,0000,0000,0000,,لكن هل سيمكن إخفاؤه عن أنظار\Nأهل الجزيرة لسبعة أعوام؟
Dialogue: 0,0:10:54.39,0:10:55.32,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:11:02.47,0:11:04.77,Default,,0000,0000,0000,,ذاك كهف سويغون
Dialogue: 0,0:11:05.34,0:11:09.01,Default,,0000,0000,0000,,...لا يقترب أحد من هناك، أيمكن
Dialogue: 0,0:11:13.00,0:11:16.22,Default,,0000,0000,0000,,...كان ليلاحظ لو نظر من المنظار
Dialogue: 0,0:11:16.70,0:11:19.68,Default,,0000,0000,0000,,لم يكن هناك داعٍ لتعذيب هامادا-سان
Dialogue: 0,0:11:19.68,0:11:24.47,On Top,,0000,0000,0000,,كهف سويغون
Dialogue: 0,0:11:25.24,0:11:28.43,Default,,0000,0000,0000,,هذا سيّئ، سيوقفونني إذا رأوني
Dialogue: 0,0:11:31.10,0:11:32.27,Default,,0000,0000,0000,,...أنت فحسب
Dialogue: 0,0:11:32.27,0:11:35.71,Default,,0000,0000,0000,,ما قصدك؟! تريد الذهاب للكهف، صحيح؟
Dialogue: 0,0:11:36.05,0:11:37.22,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:37.22,0:11:39.45,Default,,0000,0000,0000,,أعرف طريقاً سرّياً
Dialogue: 0,0:11:39.45,0:11:40.05,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:41.76,0:11:43.32,Default,,0000,0000,0000,,!أين؟! أخبريني
Dialogue: 0,0:11:43.32,0:11:46.33,Default,,0000,0000,0000,,أهكذا تسأل؟! أين الأدب؟
Dialogue: 0,0:11:47.21,0:11:48.59,Default,,0000,0000,0000,,من فضلك
Dialogue: 0,0:11:48.96,0:11:49.80,Default,,0000,0000,0000,,فقط؟
Dialogue: 0,0:11:49.80,0:11:51.51,Default,,0000,0000,0000,,ماذا تريدين أيضاً؟
Dialogue: 0,0:11:55.46,0:11:57.77,Default,,0000,0000,0000,,حـ-حمقاء! ما الذي تفكّرين به؟
Dialogue: 0,0:11:57.77,0:11:58.91,Default,,0000,0000,0000,,لا بأس إذا لم تكن تريد
Dialogue: 0,0:11:58.91,0:11:59.89,Default,,0000,0000,0000,,...تبّاً
Dialogue: 0,0:11:59.89,0:12:01.97,Default,,0000,0000,0000,,هنا إذاً
Dialogue: 0,0:12:08.31,0:12:10.68,Default,,0000,0000,0000,,!حسناً، سأرشدك! اتبعني
Dialogue: 0,0:12:10.68,0:12:12.64,Default,,0000,0000,0000,,...طفلة متسلّطة
Dialogue: 0,0:12:13.27,0:12:15.15,Default,,0000,0000,0000,,!هنا! ها هو
Dialogue: 0,0:12:20.60,0:12:22.41,Default,,0000,0000,0000,,لن تدخل، صحيح؟
Dialogue: 0,0:12:22.41,0:12:23.51,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:12:23.51,0:12:24.26,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:12:24.60,0:12:27.22,Default,,0000,0000,0000,,ظننتك لا تؤمنين بالخرافات
Dialogue: 0,0:12:27.42,0:12:31.50,Default,,0000,0000,0000,,بالطبع لا! سألتُ لأنّي قلقة عليك فحسب
Dialogue: 0,0:12:31.50,0:12:33.88,Default,,0000,0000,0000,,يمكنك البقاء هنا إن كنتِ خائفة
Dialogue: 0,0:12:34.96,0:12:36.91,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:12:36.91,0:12:39.59,Default,,0000,0000,0000,,إنّها مجرد خرافة، صحيح؟
Dialogue: 0,0:12:57.38,0:13:01.35,Default,,0000,0000,0000,,يبدو أنّ المقتول هامادا-سان كان يعتني بهذا
Dialogue: 0,0:13:07.34,0:13:09.18,Default,,0000,0000,0000,,!سويغون-ساما غاضب
Dialogue: 0,0:13:15.05,0:13:17.26,Default,,0000,0000,0000,,!كونان-كن! ستُعاقب
Dialogue: 0,0:13:22.16,0:13:24.12,Default,,0000,0000,0000,,كهف آخر
Dialogue: 0,0:13:24.12,0:13:26.69,Default,,0000,0000,0000,,لم يكن ذاك صوت غضب سويغون
Dialogue: 0,0:13:26.69,0:13:29.73,Default,,0000,0000,0000,,بل تيّار هوائي يرتدّ بأرجاء الكهف
Dialogue: 0,0:13:29.73,0:13:30.80,Default,,0000,0000,0000,,سندخل؟
Dialogue: 0,0:13:30.80,0:13:31.43,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:34.69,0:13:39.89,Default,,0000,0000,0000,,هذه الأدراج ليست طبيعية، بل صنعها أحدهم
Dialogue: 0,0:13:43.22,0:13:44.31,Default,,0000,0000,0000,,ضوء في الأسفل
Dialogue: 0,0:13:56.83,0:14:01.04,Default,,0000,0000,0000,,ما خطب هذه الأدراج؟ عليك بناؤها بحيث لا تنهار
Dialogue: 0,0:14:03.04,0:14:05.32,Default,,0000,0000,0000,,!هذا الطُحلب، هذا هو المكان إذاً
Dialogue: 0,0:14:06.49,0:14:07.32,Default,,0000,0000,0000,,...أهذا
Dialogue: 0,0:14:07.32,0:14:08.76,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:14:08.94,0:14:10.97,Default,,0000,0000,0000,,!المكان جميل جدّاً
Dialogue: 0,0:14:17.39,0:14:21.43,Default,,0000,0000,0000,,لا طحالب هنا، انهار مؤخراً
Dialogue: 0,0:14:21.43,0:14:24.45,Default,,0000,0000,0000,,...فهمت، فتحت العاصفة المخرج و
Dialogue: 0,0:14:25.80,0:14:27.76,Default,,0000,0000,0000,,أثر انزلاج شيء
Dialogue: 0,0:14:28.17,0:14:31.15,Default,,0000,0000,0000,,لا شكّ في الأمر، كانت ريوجين مارو مخبّأة هنا
Dialogue: 0,0:14:33.30,0:14:36.62,Default,,0000,0000,0000,,المعبر الذي كانت ريوجين مارو داخله
Dialogue: 0,0:14:36.62,0:14:39.79,Default,,0000,0000,0000,,هدمته العاصفة ففُتح مُجدداً
Dialogue: 0,0:14:52.89,0:14:53.95,Default,,0000,0000,0000,,!ما الخطب؟
Dialogue: 0,0:15:06.22,0:15:07.40,Default,,0000,0000,0000,,انتحار؟
Dialogue: 0,0:15:11.09,0:15:14.65,Default,,0000,0000,0000,,...كلا، لم يكن انتحاراً! ما يعني أنّ القاتل
Dialogue: 0,0:15:24.67,0:15:27.86,Default,,0000,0000,0000,,مرحباً؟ أجل، أجل
Dialogue: 0,0:15:27.86,0:15:30.82,Default,,0000,0000,0000,,!سيساعدنا ذلك كثيراً
Dialogue: 0,0:15:30.82,0:15:32.55,Default,,0000,0000,0000,,أجل، شكراً
Dialogue: 0,0:15:33.74,0:15:36.98,Default,,0000,0000,0000,,متحرّي موري! سيعيرنا الصيّادون قارباً
Dialogue: 0,0:15:36.98,0:15:39.76,Default,,0000,0000,0000,,لنذهب لكهف سويغون
Dialogue: 0,0:15:39.76,0:15:41.26,Default,,0000,0000,0000,,!حسنٌ، هيّا بنا يا ران
Dialogue: 0,0:15:41.26,0:15:44.31,Default,,0000,0000,0000,,انتظر يا أبي! هل رأيت كونان-كن؟
Dialogue: 0,0:15:44.31,0:15:47.67,Default,,0000,0000,0000,,من يهتم؟ إنّه يعبث في الأرجاء غالباً
Dialogue: 0,0:15:47.97,0:15:49.09,Default,,0000,0000,0000,,!أسرعي وحسب
Dialogue: 0,0:15:54.80,0:15:58.51,Default,,0000,0000,0000,,انتحر بعد تقبّل أنّ لم يعد بإمكانه الهروب غالباً
Dialogue: 0,0:15:58.88,0:16:00.38,Default,,0000,0000,0000,,...كينوشيتا-سان
Dialogue: 0,0:16:00.38,0:16:03.26,Default,,0000,0000,0000,,تبعتكما بعدما رأيتكما تدخلان
Dialogue: 0,0:16:03.26,0:16:05.14,Default,,0000,0000,0000,,هيّا، لنرجع للبلدة
Dialogue: 0,0:16:05.49,0:16:06.20,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:08.57,0:16:09.64,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:16:10.03,0:16:13.62,Default,,0000,0000,0000,,لم ينتحر هذا الرجل، بل قُتل
Dialogue: 0,0:16:13.62,0:16:14.78,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:16:14.78,0:16:16.09,Default,,0000,0000,0000,,انظر لجرحه
Dialogue: 0,0:16:16.61,0:16:21.02,Default,,0000,0000,0000,,الفجوة على اليمين أكبر من التي على اليسار
Dialogue: 0,0:16:21.02,0:16:24.72,Default,,0000,0000,0000,,هذا دليل أنّ الطلقة عبرت من اليسار لليمين
Dialogue: 0,0:16:24.94,0:16:28.01,Default,,0000,0000,0000,,مع ذلك المسدّس في يده اليمنى
Dialogue: 0,0:16:28.93,0:16:32.97,Default,,0000,0000,0000,,أليس غريباً أن تُطلق من اليسار بيدك اليمنى؟
Dialogue: 0,0:16:36.79,0:16:39.47,Default,,0000,0000,0000,,في تلك الحالة، لم تعد هناك حاجة لإخفاء الحقيقة
Dialogue: 0,0:16:44.50,0:16:45.67,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:16:46.03,0:16:48.63,Default,,0000,0000,0000,,لا تبدو الدهشة على كونان-كن
Dialogue: 0,0:16:49.28,0:16:52.10,Default,,0000,0000,0000,,أطلقت على ذراعك بنفسك، صحيح؟
Dialogue: 0,0:16:52.78,0:16:54.81,Default,,0000,0000,0000,,أدركت ذلك حتّى؟
Dialogue: 0,0:16:55.08,0:16:57.73,Default,,0000,0000,0000,,كانت هناك آثار احتراق على الفجوة بقميصك
Dialogue: 0,0:16:57.73,0:17:00.80,Default,,0000,0000,0000,,ما يعني أنّك أطلقت والفوهة عليها تماماً
Dialogue: 0,0:17:01.36,0:17:04.82,Default,,0000,0000,0000,,قلتَ أنّه أطلق النار عليك فجأةً
Dialogue: 0,0:17:04.82,0:17:08.76,Default,,0000,0000,0000,,لا أحد يطلق النار "فجأةً" هكذا
Dialogue: 0,0:17:08.76,0:17:11.26,Default,,0000,0000,0000,,أذهلتني، أنت مُبهر
Dialogue: 0,0:17:11.26,0:17:13.72,Default,,0000,0000,0000,,أنت من قتل هامادا-سان أيضاً
Dialogue: 0,0:17:14.26,0:17:19.46,Default,,0000,0000,0000,,صحيح، لطالما بدا لي مريباً
Dialogue: 0,0:17:19.46,0:17:22.68,Default,,0000,0000,0000,,فتفقدت المنارة في غيابه
Dialogue: 0,0:17:22.68,0:17:24.64,Default,,0000,0000,0000,,ووجدت المنظار، صحيح؟
Dialogue: 0,0:17:24.96,0:17:30.23,Default,,0000,0000,0000,,أجل، خطّطت للبحث عن الذهب\Nيوماً ما على مهلي
Dialogue: 0,0:17:30.99,0:17:35.05,Default,,0000,0000,0000,,...لكنّ العمدة الطمّاع بدأ يتدخل
Dialogue: 0,0:17:35.05,0:17:40.59,Default,,0000,0000,0000,,!أبي ليس طمّاعاً! قال أنّك استغللت مال البلدة
Dialogue: 0,0:17:43.86,0:17:47.96,Default,,0000,0000,0000,,أصبحتُ متوتراً، فموري كوغورو مُتحرٍّ عظيم
Dialogue: 0,0:17:48.89,0:17:54.85,Default,,0000,0000,0000,,خشيت أن يجد الذهب قبلي إن بدأ التحقيق
Dialogue: 0,0:17:54.85,0:17:58.38,Default,,0000,0000,0000,,وفوقها تدخل هذا الشخص أيضاً
Dialogue: 0,0:17:58.80,0:18:02.89,Default,,0000,0000,0000,,لذا خدعت العمّ وجعلته يبدو قاتل هامادا-سان
Dialogue: 0,0:18:04.01,0:18:07.33,Default,,0000,0000,0000,,لكنّي أخطأت في التقليل من شأنه
Dialogue: 0,0:18:07.33,0:18:11.66,Default,,0000,0000,0000,,لكنّك عرفت موقع الذهب من هامادا-سان
Dialogue: 0,0:18:11.66,0:18:14.43,Default,,0000,0000,0000,,أخبرني أخيراً عن هذا المكان\Nبعدما عذّبته بما يكفي
Dialogue: 0,0:18:14.95,0:18:19.49,Default,,0000,0000,0000,,كما قال موري، لقد كان على متن ريوجين مارو
Dialogue: 0,0:18:19.49,0:18:21.35,Default,,0000,0000,0000,,وكذلك هذا الشخص كما أظن، صحيح؟
Dialogue: 0,0:18:21.35,0:18:26.67,Default,,0000,0000,0000,,أجل، دفعه هامادا مع المالك في المحيط العاصف
Dialogue: 0,0:18:26.67,0:18:28.95,Default,,0000,0000,0000,,ليحتكر الذهب لنفسه
Dialogue: 0,0:18:29.89,0:18:33.39,Default,,0000,0000,0000,,هامادا، اسمه الحقيقيّ آوكي وفقما يبدو
Dialogue: 0,0:18:33.39,0:18:38.05,Default,,0000,0000,0000,,جلب ريوجين مارو هنا للاحتماء من العاصفة
Dialogue: 0,0:18:38.05,0:18:42.85,Default,,0000,0000,0000,,لكنّ العاصفة أسقطت الصخور وأغلقت المخرج
Dialogue: 0,0:18:43.30,0:18:48.55,Default,,0000,0000,0000,,لم تكن نيّته غالباً، لكن لم تكن هناك\Nأماكن إخفاء أخرى
Dialogue: 0,0:18:48.55,0:18:52.12,Default,,0000,0000,0000,,ابتعد أهل القرية بسبب اللعنة
Dialogue: 0,0:18:52.12,0:18:57.15,Default,,0000,0000,0000,,خصوصاً بعدما قتل هامادا البروفسور ليجعلها
Dialogue: 0,0:18:57.15,0:18:59.30,Default,,0000,0000,0000,,تبدو من صنيع لعنة سويغون
Dialogue: 0,0:18:59.61,0:19:01.22,Default,,0000,0000,0000,,ما حلّ بوجهه؟
Dialogue: 0,0:19:01.78,0:19:03.86,Default,,0000,0000,0000,,سمعتُ أنّه حرقه بنفسه
Dialogue: 0,0:19:03.86,0:19:07.22,Default,,0000,0000,0000,,لأنّه خشي أن يتعرّف أحد عليه
Dialogue: 0,0:19:07.52,0:19:12.44,Default,,0000,0000,0000,,تظاهرت بتعرضك للإصابة بطلقة\Nكي تجعل أويهارا-سان يهرب، صحيح؟
Dialogue: 0,0:19:12.44,0:19:16.18,Default,,0000,0000,0000,,فإذا اُعتقل كنّا سنعرف هويّة\Nقاتل هامادا-سان
Dialogue: 0,0:19:16.18,0:19:17.22,Default,,0000,0000,0000,,كما موقع الذهب
Dialogue: 0,0:19:17.72,0:19:22.85,Default,,0000,0000,0000,,صحيح، بدا أنّه يدرك وجود\Nهذا المكان لحدٍّ ما
Dialogue: 0,0:19:23.18,0:19:25.13,Default,,0000,0000,0000,,لـ-لمَ تتركني أهرب؟
Dialogue: 0,0:19:25.13,0:19:29.59,Default,,0000,0000,0000,,!لا تهتم، ستلقى حتفك إن أمسكوا بك
Dialogue: 0,0:19:32.87,0:19:34.75,Default,,0000,0000,0000,,سأبقيه معي
Dialogue: 0,0:19:34.75,0:19:39.38,Default,,0000,0000,0000,,ستكون في ورطة أكبر لو وجدوه معك
Dialogue: 0,0:19:39.78,0:19:41.35,Default,,0000,0000,0000,,...شـ-شكراً
Dialogue: 0,0:19:54.23,0:19:55.13,Default,,0000,0000,0000,,!كينوشيتا-سان
Dialogue: 0,0:19:55.84,0:19:59.18,Default,,0000,0000,0000,,ثمّ سبقته للكهف وقتلته
Dialogue: 0,0:19:59.18,0:20:02.89,Default,,0000,0000,0000,,صحيح، انتهى نقاشنا الآن
Dialogue: 0,0:20:05.67,0:20:11.75,Default,,0000,0000,0000,,!لن يجد أحد جثّتيكما هنا! أبداً
Dialogue: 0,0:20:12.75,0:20:13.77,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:20:14.88,0:20:16.47,Default,,0000,0000,0000,,أوجدت الذهب؟
Dialogue: 0,0:20:16.74,0:20:20.07,Default,,0000,0000,0000,,إنّه مدفون في مكان ما هنا بالتأكيد
Dialogue: 0,0:20:20.07,0:20:24.16,Default,,0000,0000,0000,,سأبحث عنه على مهلي بعدما تهدأ الأوضاع
Dialogue: 0,0:20:24.16,0:20:25.38,Default,,0000,0000,0000,,!ما الذي يضحكك؟
Dialogue: 0,0:20:25.38,0:20:29.44,Default,,0000,0000,0000,,لن تجده بعقلك هذا ولو بعد 100 سنة
Dialogue: 0,0:20:29.44,0:20:30.34,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:31.19,0:20:32.39,Default,,0000,0000,0000,,لم تعرفه بعد؟
Dialogue: 0,0:20:32.83,0:20:34.35,Default,,0000,0000,0000,,!أي عرفت؟
Dialogue: 0,0:20:34.35,0:20:36.55,Default,,0000,0000,0000,,أجل، عند قدميك
Dialogue: 0,0:20:39.76,0:20:40.64,Default,,0000,0000,0000,,!انطلقي
Dialogue: 0,0:20:51.09,0:20:55.87,Default,,0000,0000,0000,,كان الذهب في هذه القراميد\Nالتي اُستعملت كجزء من الأدراج
Dialogue: 0,0:20:56.84,0:20:59.96,Default,,0000,0000,0000,,!مذهل! أحبّك يا كونان-كن
Dialogue: 0,0:21:00.58,0:21:01.85,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:21:03.28,0:21:04.96,Default,,0000,0000,0000,,!هزّة؟
Dialogue: 0,0:21:06.73,0:21:07.30,Default,,0000,0000,0000,,ها هو
Dialogue: 0,0:21:10.61,0:21:14.36,Default,,0000,0000,0000,,!خذي اللوح للمخرج! سأجلب كينوشيتا-سان
Dialogue: 0,0:21:14.36,0:21:15.09,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:21:20.22,0:21:21.55,Default,,0000,0000,0000,,!كونان-كن! أسرع
Dialogue: 0,0:21:23.35,0:21:25.21,Default,,0000,0000,0000,,!أسرع! أسرع
Dialogue: 0,0:21:28.59,0:21:29.72,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:51.61,0:21:54.78,Default,,0000,0000,0000,,لم تعد هناك طريقة لاستخراج الذهب
Dialogue: 0,0:21:54.78,0:21:57.72,Default,,0000,0000,0000,,من الكهف المنهار كليّاً الآن غالباً
Dialogue: 0,0:21:58.68,0:22:01.52,Default,,0000,0000,0000,,أشكّ بأن ينفق أحد ما يفوق مليار ينّ
Dialogue: 0,0:22:01.52,0:22:05.13,Default,,0000,0000,0000,,لاستخراج مجرّد مليار ينّ
Dialogue: 0,0:22:05.34,0:22:10.43,Default,,0000,0000,0000,,في النهاية، رجع الذهب الذي أوقد الطمع بالناس للأرض
Dialogue: 0,0:22:11.34,0:22:13.33,Default,,0000,0000,0000,,مع لعنة سويغون
Dialogue: 0,0:23:43.03,0:23:46.40,Default,,0000,0000,0000,,،أيّها الغبيّ! لو لم آت لإنقاذك بقارب صيد
Dialogue: 0,0:23:46.40,0:23:48.29,Default,,0000,0000,0000,,!من يعرف ما كان سيحلّ بك؟
Dialogue: 0,0:23:52.81,0:23:55.49,Default,,0000,0000,0000,,!ماذا تفعل لعزيزي كونان-كن؟
Dialogue: 0,0:23:56.31,0:23:57.30,Default,,0000,0000,0000,,...مخيفة
Dialogue: 0,0:24:13.41,0:24:14.29,Default,,0000,0000,0000,,!إ-إنّه فارغ
Dialogue: 0,0:24:14.78,0:24:18.41,Default,,0000,0000,0000,,لا  أفهم، أين اختفى القاتل؟
Dialogue: 0,0:24:19.11,0:24:23.90,Default,,0000,0000,0000,,لحظة، في هذه الحالة لا يمكن\N!أن يكون القاتل سوى ذاك الشخص
Dialogue: 0,0:24:24.07,0:24:30.06,On Top,,0000,0000,15,,جريمة قتل الوحش العملاق غوميرا
Dialogue: 0,0:24:24.93,0:24:26.22,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.22,0:24:29.22,Default,,0000,0000,0000,,جريمة قتل الوحش العملاق غوميرا
Dialogue: 0,0:24:45.47,0:24:47.88,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.88,0:24:49.55,Default,,0000,0000,0000,,طلاء
Dialogue: 0,0:24:50.32,0:24:52.87,Default,,0000,0000,0000,,يظهر في الحلقة القادمة\N!الوحش الكبير، غينتا
Dialogue: 0,0:24:52.87,0:24:54.45,Default,,0000,0000,0000,,!أنقليس

