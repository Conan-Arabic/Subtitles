Dialogue: 0,0:00:01.47,0:00:03.42,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.42,0:00:06.82,Default,,0000,0000,0000,,ستبلل استنتاجات كونان القلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.21,0:00:10.53,Default,,0000,0000,0000,,دليل اليوم فريد! لنغيّر منظور تفكيرنا
Dialogue: 0,0:00:10.88,0:00:12.58,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.58,0:00:14.38,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.38,0:00:16.82,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.17,0:01:57.11,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل البصمة الثالثة
Dialogue: 0,0:01:52.08,0:01:55.45,Default,,0000,0000,0000,,جريمة قتل البصمة الثالثة
Dialogue: 0,0:02:01.20,0:02:03.62,Default,,0000,0000,0000,,انتهيت من الاستحمام يا ران-نيتشان
Dialogue: 0,0:02:04.19,0:02:06.32,Default,,0000,0000,0000,,أأنت متفرّغ غداً يا كونان-كن؟
Dialogue: 0,0:02:06.65,0:02:09.52,Default,,0000,0000,0000,,أجل، لا جدول محدد لديّ. ما الأمر؟
Dialogue: 0,0:02:09.52,0:02:12.29,Default,,0000,0000,0000,,اتّصل أحد معارف أبي للتو
Dialogue: 0,0:02:12.65,0:02:17.49,Default,,0000,0000,0000,,ودعانا لحفلة شواء ظهيرة الغد
Dialogue: 0,0:02:18.60,0:02:20.08,Default,,0000,0000,0000,,أحد معارفك؟
Dialogue: 0,0:02:20.08,0:02:22.05,Default,,0000,0000,0000,,اسمه تيراوكا-سان
Dialogue: 0,0:02:22.05,0:02:27.38,Default,,0000,0000,0000,,اعتنى بي عندما كنتُ\Nمحقّقاً في الشرطة لعامين
Dialogue: 0,0:02:27.38,0:02:31.87,Default,,0000,0000,0000,,منصبه كبير المفتّشين في قسم\Nالتحقيق الرابع الآن
Dialogue: 0,0:02:32.13,0:02:36.53,Default,,0000,0000,0000,,!هذا القسم المكلّف بقضايا العصابات! سآتي
Dialogue: 0,0:02:36.95,0:02:40.70,Default,,0000,0000,0000,,قد يكون لدى محقّقي الشرطة الحقيقيين\Nالكثير من القصص المثيرة
Dialogue: 0,0:02:40.70,0:02:42.37,Default,,0000,0000,0000,,!أتحرّق شوقاً
Dialogue: 0,0:02:46.53,0:02:47.99,On Top,,0000,0000,0000,,تيراوكا
Dialogue: 0,0:02:48.19,0:02:52.52,Default,,0000,0000,0000,,كنتَ تقول دائماً أن استنتاجي خاطئ
Dialogue: 0,0:02:52.52,0:02:56.70,Default,,0000,0000,0000,,!وفي النهاية يتّضح أنك أنت المخطئ
Dialogue: 0,0:02:56.70,0:02:58.62,Default,,0000,0000,0000,,لا يزال هكذا
Dialogue: 0,0:02:59.26,0:03:05.32,Default,,0000,0000,0000,,!أصبحتَ متحرّياً مشهوراً الآن\Nأجد صعوبة في تصديق الأمر بصراحة
Dialogue: 0,0:03:05.50,0:03:08.78,Default,,0000,0000,0000,,...لا تحرجني يا سينباي
Dialogue: 0,0:03:09.25,0:03:11.25,Default,,0000,0000,0000,,هاك شراباً... ماذا؟
Dialogue: 0,0:03:12.92,0:03:16.57,Default,,0000,0000,0000,,!لم تشرب البتّة! ليس هذا من طباعك
Dialogue: 0,0:03:16.95,0:03:20.81,Default,,0000,0000,0000,,أنا خارج العمل، لكن لا تعلم ما قد يطرأ أبداً
Dialogue: 0,0:03:26.78,0:03:30.08,Default,,0000,0000,0000,,!هذه سيّارة مذهلة يا عمّ! لا بد أنّها باهظة الثمن
Dialogue: 0,0:03:30.73,0:03:35.61,Default,,0000,0000,0000,,،السيّارات هي هوايتي الوحيدة\Nلذا أنفق مالي عليها
Dialogue: 0,0:03:36.60,0:03:40.56,Default,,0000,0000,0000,,أخبريني يا ران-تشان، أكان لديك مخطّط ما اليوم؟
Dialogue: 0,0:03:40.56,0:03:42.09,Default,,0000,0000,0000,,كلا، مُطلقاً
Dialogue: 0,0:03:42.09,0:03:44.76,Default,,0000,0000,0000,,أعتذر على مباغتتكم
Dialogue: 0,0:03:44.76,0:03:48.05,Default,,0000,0000,0000,,فقد اتّخذ قراره فجأةً البارحة
Dialogue: 0,0:03:48.05,0:03:52.53,Default,,0000,0000,0000,,"غادر غرفته عند التاسعة وقال "سأدعو موري غداً
Dialogue: 0,0:03:52.53,0:03:56.29,Default,,0000,0000,0000,,يميل للتخطيط أكثر في العادة
Dialogue: 0,0:03:56.29,0:04:00.79,Default,,0000,0000,0000,,خطر لي أنّها ستكون مناسبة جميلة
Dialogue: 0,0:04:11.86,0:04:12.54,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:04:16.31,0:04:17.95,Default,,0000,0000,0000,,أوقعت حادثة؟
Dialogue: 0,0:04:17.95,0:04:19.03,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:04:22.77,0:04:23.89,Default,,0000,0000,0000,,أين أنت؟
Dialogue: 0,0:04:25.63,0:04:27.78,Default,,0000,0000,0000,,!حسناً، سآتي فوراً
Dialogue: 0,0:04:29.01,0:04:32.22,Default,,0000,0000,0000,,لن أخبر أحداً! سآتي بمفردي، واضح؟
Dialogue: 0,0:04:32.22,0:04:33.59,Default,,0000,0000,0000,,!سأنتظرك
Dialogue: 0,0:04:36.16,0:04:38.01,Default,,0000,0000,0000,,آسف، سأغادر قليلاً
Dialogue: 0,0:04:39.21,0:04:40.70,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:04:42.00,0:04:45.86,Default,,0000,0000,0000,,كان ذلك ماتسوياما، زعيم عصابة
Dialogue: 0,0:04:45.86,0:04:49.16,Default,,0000,0000,0000,,يبدو أنّه قتل شخصاً بالخطأ البارحة
Dialogue: 0,0:04:49.53,0:04:50.70,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:51.15,0:04:55.39,Default,,0000,0000,0000,,أراد تصحيح مساره، وكنتُ أساعده بالنصح
Dialogue: 0,0:04:55.39,0:04:58.03,Default,,0000,0000,0000,,سأذهب لإقناعه بتسليم نفسه
Dialogue: 0,0:04:58.03,0:05:02.06,Default,,0000,0000,0000,,بمفردك يا سينباي؟ ليست فكرةً حسنة
Dialogue: 0,0:05:02.06,0:05:07.18,Default,,0000,0000,0000,,!ستقع عليك المسؤولية إن هرب
Dialogue: 0,0:05:08.01,0:05:11.24,Default,,0000,0000,0000,,...كما أنّ الأمر خطر! عليك الاتّصال بالمركز و
Dialogue: 0,0:05:12.00,0:05:15.45,Default,,0000,0000,0000,,لا يمكنني! وعدته أن آتي بمفردي\N!وألّا أخبر أحداً
Dialogue: 0,0:05:15.83,0:05:18.28,Default,,0000,0000,0000,,...لكنّك خارج وقت عملك، وبلا مسدّس
Dialogue: 0,0:05:18.67,0:05:23.16,Default,,0000,0000,0000,,!لا أحتاج مسدّساً! فقد استدعاني لثقته بي
Dialogue: 0,0:05:23.16,0:05:26.12,Default,,0000,0000,0000,,!لا يمكنني خيانة ذلك
Dialogue: 0,0:05:26.12,0:05:28.45,Default,,0000,0000,0000,,!سأرافقك إذاً
Dialogue: 0,0:05:28.45,0:05:29.33,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:05:29.82,0:05:32.66,Default,,0000,0000,0000,,!وإلّا سأضطر للاتصال بالمفتّش ميغوري
Dialogue: 0,0:05:32.66,0:05:33.61,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:05:36.15,0:05:40.79,Default,,0000,0000,0000,,حسناً، لا بأس. لكني سألتقيه وحدي، مفهوم؟
Dialogue: 0,0:05:40.79,0:05:43.14,Default,,0000,0000,0000,,أجل، أين المكان؟
Dialogue: 0,0:05:43.14,0:05:45.59,Default,,0000,0000,0000,,رصيف كوان، المستودع 13
Dialogue: 0,0:05:46.68,0:05:50.09,Default,,0000,0000,0000,,سأجلب معطفي، انتظر عند السيّارة
Dialogue: 0,0:05:50.09,0:05:51.45,Default,,0000,0000,0000,,سأجلب أنا معطفك
Dialogue: 0,0:05:51.85,0:05:54.03,Default,,0000,0000,0000,,!كلا! ابقي هنا فحسب
Dialogue: 0,0:06:05.57,0:06:07.37,Default,,0000,0000,0000,,...تأخّر
Dialogue: 0,0:06:15.40,0:06:17.62,Default,,0000,0000,0000,,آسف، استغرق البحث عن المفتاح وقتاً
Dialogue: 0,0:06:24.22,0:06:25.66,Default,,0000,0000,0000,,ما كان ذلك الصوت؟
Dialogue: 0,0:06:39.91,0:06:43.49,Default,,0000,0000,0000,,...ما كان ذلك الصوت بالضبط؟ أيمكن
Dialogue: 0,0:06:43.87,0:06:46.95,Default,,0000,0000,0000,,...هل سيكون أبي بخير؟ شرب الكثير من الساكي
Dialogue: 0,0:06:47.28,0:06:49.70,Default,,0000,0000,0000,,!ران-نيتشان، لنذهب لرصيف كوان أيضاً
Dialogue: 0,0:06:50.45,0:06:54.44,Default,,0000,0000,0000,,!أنتِ قلقة عليه، صحيح؟ سأوقف سيّارة أجرة
Dialogue: 0,0:06:54.44,0:06:55.36,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:06:56.77,0:06:58.33,Default,,0000,0000,0000,,...أبي
Dialogue: 0,0:06:58.57,0:07:01.79,CharCard,,0000,0000,15,,{\fad(300,0)}رصيف كوان
Dialogue: 0,0:07:10.09,0:07:11.86,Default,,0000,0000,0000,,!لمَ أتيتما هنا؟
Dialogue: 0,0:07:12.12,0:07:15.37,Default,,0000,0000,0000,,آسفة! كنا قلقين عليك
Dialogue: 0,0:07:15.37,0:07:16.32,Default,,0000,0000,0000,,أين تيراوكا-سان؟
Dialogue: 0,0:07:16.32,0:07:18.70,Default,,0000,0000,0000,,في الخلف هناك
Dialogue: 0,0:07:18.70,0:07:21.28,Default,,0000,0000,0000,,أخبرني بالانتظار مكاني
Dialogue: 0,0:07:22.37,0:07:24.23,Default,,0000,0000,0000,,لنذهب لتفقّد الوضع
Dialogue: 0,0:07:24.78,0:07:29.11,Default,,0000,0000,0000,,...ما الذي تقوله؟! سيضعه ذلك في
Dialogue: 0,0:07:30.69,0:07:31.24,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:07:31.73,0:07:34.02,Default,,0000,0000,0000,,!لا يحمل سينباي مسدّساً
Dialogue: 0,0:07:34.02,0:07:35.44,Default,,0000,0000,0000,,...ما يعني أنّ الرجل الآخر
Dialogue: 0,0:07:37.06,0:07:38.19,Default,,0000,0000,0000,,!انتظر يا كونان
Dialogue: 0,0:07:52.17,0:07:53.10,Default,,0000,0000,0000,,...سينباي
Dialogue: 0,0:07:58.78,0:08:02.16,Default,,0000,0000,0000,,عندما حاولتَ إقناع ماتسوياما بتسليم نفسه إذاً
Dialogue: 0,0:08:02.16,0:08:06.19,Default,,0000,0000,0000,,أخرج مسدّسه وطلب منك إخراج\Nمالك وبطاقاتك الائتمانية؟
Dialogue: 0,0:08:06.19,0:08:09.80,Default,,0000,0000,0000,,أجل، يبدو أنّه كان يخطط لمغادرة البلاد من البداية
Dialogue: 0,0:08:13.14,0:08:17.69,Default,,0000,0000,0000,,أخبرته أنّه لن يستطيع الهرب أبداً، وعلينا مناقشة الأمر
Dialogue: 0,0:08:17.69,0:08:21.60,Default,,0000,0000,0000,,رفعتُ ذراعيّ ومشيت نحوه ببطء
Dialogue: 0,0:08:21.60,0:08:25.71,Default,,0000,0000,0000,,...ثمّ باغتّه وحاولت سحب المسدس
Dialogue: 0,0:08:27.51,0:08:29.49,Default,,0000,0000,0000,,وانطلقت الرصاصة
Dialogue: 0,0:08:34.50,0:08:38.62,Default,,0000,0000,0000,,!كان حادثاً! إنّه مجرد حادث مؤسف يا مفتّش ميغوري
Dialogue: 0,0:08:38.62,0:08:41.40,Default,,0000,0000,0000,,من الذي قتله ماتسوياما؟
Dialogue: 0,0:08:41.83,0:08:45.36,Default,,0000,0000,0000,,لا أعرف اسمه، لكنّه قال أنّه عميل قمار
Dialogue: 0,0:08:45.66,0:08:48.70,Default,,0000,0000,0000,,وما علاقتك بماتسوياما بالأصل؟
Dialogue: 0,0:08:48.70,0:08:53.65,Default,,0000,0000,0000,,!كانا يتكلمان حول إخراج ماتسوياما من حياة الجريمة
Dialogue: 0,0:08:53.65,0:08:56.44,Default,,0000,0000,0000,,!لذا أتى سينباي للقائه بمفرده لثقته به
Dialogue: 0,0:08:57.19,0:09:01.52,Default,,0000,0000,0000,,كانت تلك غلطة، أتحمّل المسؤولية كاملة
Dialogue: 0,0:09:01.52,0:09:03.40,Default,,0000,0000,0000,,أخطأت في حكمي
Dialogue: 0,0:09:03.40,0:09:05.06,Default,,0000,0000,0000,,...سينباي
Dialogue: 0,0:09:06.80,0:09:11.76,Default,,0000,0000,0000,,إن أصاب استنتاجي، فلم يكن ذلك حادثاً\N!بل جريمة قتل
Dialogue: 0,0:09:11.76,0:09:13.94,Default,,0000,0000,0000,,!المجرم هو تيراوكا-سان بلا شك
Dialogue: 0,0:09:16.33,0:09:19.74,Default,,0000,0000,0000,,!لكن لا دليل لديّ
Dialogue: 0,0:09:22.13,0:09:23.10,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:09:23.10,0:09:24.99,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:09:27.62,0:09:31.57,Default,,0000,0000,0000,,لعلّك عرفت من التلفاز أو الصحف سلفاً
Dialogue: 0,0:09:31.57,0:09:34.52,Default,,0000,0000,0000,,لكن الضحيّة التي قتلها ماتسوياما\Nكان عميل قمار حقّاً
Dialogue: 0,0:09:35.02,0:09:38.23,Default,,0000,0000,0000,,وقعت الجريمة عند الثامنة مساءً قبل ليلتين
Dialogue: 0,0:09:38.23,0:09:41.36,Default,,0000,0000,0000,,وكان السلاح سكّيناً، وليس مسدّساً
Dialogue: 0,0:09:41.61,0:09:47.43,Default,,0000,0000,0000,,أجل، لا نزال نجهل لمَ لم يستعمل مسدّساً
Dialogue: 0,0:09:47.43,0:09:52.69,Default,,0000,0000,0000,,لكن يبدو أنّ دين القمار كان أساس النزاع
Dialogue: 0,0:09:52.69,0:09:56.40,Default,,0000,0000,0000,,ماذا عن تورّط تيراوكا سينباي إذاً؟
Dialogue: 0,0:09:58.38,0:10:02.74,Default,,0000,0000,0000,,لم يُتّخذ قرار رسميّ بعد، لكنه ذهب بمفرده
Dialogue: 0,0:10:02.74,0:10:06.40,Default,,0000,0000,0000,,وتسبب بموت ماتسوياما، كان حادثاً أم لا
Dialogue: 0,0:10:06.87,0:10:09.19,Default,,0000,0000,0000,,سيفقد مرتّب بضعة أشهر غالباً
Dialogue: 0,0:10:09.19,0:10:10.95,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:10:10.95,0:10:15.90,Default,,0000,0000,0000,,ما يعني أنّ لا أحد يشكّ بكلام تيراوكا-سان
Dialogue: 0,0:10:16.15,0:10:21.23,Default,,0000,0000,0000,,بالمناسبة، هناك ما أخفيناه عن الإعلام\Nبشأن حادثة الأمس
Dialogue: 0,0:10:21.23,0:10:23.85,Default,,0000,0000,0000,,وجدنا 3 بصمات مختلفة على المسدّس
Dialogue: 0,0:10:24.18,0:10:25.36,Default,,0000,0000,0000,,ثلاث بصمات؟
Dialogue: 0,0:10:25.60,0:10:29.93,Default,,0000,0000,0000,,إحداها لماتسوياما، والأخرى للمفتّش تيراوكا
Dialogue: 0,0:10:29.93,0:10:36.55,Default,,0000,0000,0000,,حددنا أن بصماته سببها منازعة المسدّس مع ماتسوياما
Dialogue: 0,0:10:36.55,0:10:38.82,Default,,0000,0000,0000,,لكن لا نزال نجهل صاحب البصمة الثالثة
Dialogue: 0,0:10:39.21,0:10:42.70,Default,,0000,0000,0000,,لعلّه أحد أفراد عصابة ماتسوياما
Dialogue: 0,0:10:42.70,0:10:47.52,Default,,0000,0000,0000,,كلا، لدينا كلّ بصماتهم، لكن لم نجد أيّ تطابق
Dialogue: 0,0:10:47.74,0:10:50.69,Default,,0000,0000,0000,,ربما لتاجر أسلحة غير ذي علاقة إذاً؟
Dialogue: 0,0:10:51.12,0:10:56.65,Default,,0000,0000,0000,,فكّرنا بذلك أيضاً، لكن لا نملك أيّ خيوط
Dialogue: 0,0:10:57.16,0:11:03.01,Default,,0000,0000,0000,,لمن هي البصمة الثالثة؟ إن كان \N...مالك المسدّس هو من أشتبه به
Dialogue: 0,0:11:05.60,0:11:10.06,Default,,0000,0000,0000,,حضرة المفتّش! أخبرتَ تيراوكا-سان\Nعن أمر البصمات الثلاث، صحيح؟
Dialogue: 0,0:11:10.06,0:11:12.28,Default,,0000,0000,0000,,كيف كانت ملامحه آنذاك؟
Dialogue: 0,0:11:12.82,0:11:17.16,Default,,0000,0000,0000,,كيف كانت؟ صحيح... بدا أنّه مصدوم
Dialogue: 0,0:11:19.61,0:11:23.87,Default,,0000,0000,0000,,!لا شكّ في الأمر! أطلق تيراوكا-سان على ماتسوياما
Dialogue: 0,0:11:23.87,0:11:26.36,Default,,0000,0000,0000,,!البصمة الثالثة هي الدليل
Dialogue: 0,0:11:35.86,0:11:37.30,Default,,0000,0000,0000,,مرحباً، منزل تيراوكا
Dialogue: 0,0:11:38.36,0:11:40.03,Default,,0000,0000,0000,,!مفتّش ميغوري
Dialogue: 0,0:11:40.36,0:11:43.98,Default,,0000,0000,0000,,أريد مناقشة أمر معك بخصوص حادثة الأمس
Dialogue: 0,0:11:45.89,0:11:50.43,Default,,0000,0000,0000,,من الغريب أنّ المفتّش ميغوري طلب منّي
Dialogue: 0,0:11:50.43,0:11:53.84,Default,,0000,0000,0000,,!القدوم لمنزل تيراوكا سينباي في وقت كهذا
Dialogue: 0,0:11:53.84,0:11:58.65,Default,,0000,0000,0000,,منّي وكونان-كن أيضاً! أوقع أمرٌ ما؟
Dialogue: 0,0:11:59.13,0:12:02.30,Default,,0000,0000,0000,,واتّصلت بالمفتّش باستعمال صوت العمّ
Dialogue: 0,0:12:02.30,0:12:04.61,Default,,0000,0000,0000,,!كلّ شيء جاهز
Dialogue: 0,0:12:07.12,0:12:11.50,Default,,0000,0000,0000,,لم أعلم أنّ المفتّش ميغوري استدعاكم كذلك
Dialogue: 0,0:12:11.50,0:12:13.24,Default,,0000,0000,0000,,تفضّلوا بالجلوس
Dialogue: 0,0:12:13.24,0:12:17.57,Default,,0000,0000,0000,,لا أعرف لمَ استدعانا أيضاً بصراحة
Dialogue: 0,0:12:18.15,0:12:20.03,Default,,0000,0000,0000,,يا عمّة
Dialogue: 0,0:12:20.40,0:12:22.60,Default,,0000,0000,0000,,هناك مسلسل أريد مشاهدته
Dialogue: 0,0:12:22.81,0:12:27.52,Default,,0000,0000,0000,,يوجد تلفاز في غرفة شاغرة\Nفي الطابق الثاني، يمكنك المشاهدة هناك
Dialogue: 0,0:12:27.52,0:12:29.49,Default,,0000,0000,0000,,!لكمة يايبا
Dialogue: 0,0:12:30.27,0:12:33.94,Default,,0000,0000,0000,,هذه الغرفة لمبيت الضيوف عند زيارتهم
Dialogue: 0,0:12:34.34,0:12:37.40,Default,,0000,0000,0000,,عليك أن تبيت وران-تشان هنا\Nمن حين لآخر
Dialogue: 0,0:12:37.40,0:12:38.53,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:12:57.57,0:12:59.74,Default,,0000,0000,0000,,...هذه غرفة تيراوكا-سان إذاً
Dialogue: 0,0:13:14.68,0:13:17.22,Default,,0000,0000,0000,,...يوجد واحد ناقص
Dialogue: 0,0:13:18.93,0:13:19.99,Default,,0000,0000,0000,,في القمامة؟
Dialogue: 0,0:13:25.04,0:13:26.23,Default,,0000,0000,0000,,لُباد؟
Dialogue: 0,0:13:28.67,0:13:32.62,Default,,0000,0000,0000,,...رائحة زيت، أيمكن أنّ تيراوكا-سان وضع هنا
Dialogue: 0,0:13:40.20,0:13:43.19,Default,,0000,0000,0000,,ما الذي أردت قوله إذاً يا موري-كن؟
Dialogue: 0,0:13:43.19,0:13:45.69,Default,,0000,0000,0000,,أنت من قال أنّ لديه ما يريد قوله
Dialogue: 0,0:13:45.69,0:13:50.90,Default,,0000,0000,0000,,ما الذي تتكلّم عنه؟! أنت من اتّصل\N!وقال أنّه يريد قول شيء
Dialogue: 0,0:13:51.31,0:13:54.15,Default,,0000,0000,0000,,...لكن من اتّصل بي
Dialogue: 0,0:13:55.43,0:13:56.71,Default,,0000,0000,0000,,...مُجدداً
Dialogue: 0,0:13:57.89,0:14:05.34,Default,,0000,0000,0000,,حسناً، لنترك التفاصيل جانباً\Nوندخل في صلب الموضوع
Dialogue: 0,0:14:05.34,0:14:09.90,Default,,0000,0000,0000,,لكن أوّلاً، هلّا جلستِ من فضلك يا آنسة؟\Nأنت أيضاً يا ران
Dialogue: 0,0:14:12.45,0:14:17.07,Default,,0000,0000,0000,,تيراوكا سينباي، قمتَ بقتل ماتسوياما، صحيح؟
Dialogue: 0,0:14:20.24,0:14:25.15,Default,,0000,0000,0000,,!تباغتني بكلام كهذا! أرى أنّك لم تتغير أبداً
Dialogue: 0,0:14:25.48,0:14:30.43,Default,,0000,0000,0000,,عندما التقيتَ ماتسوياما، ضربته وأفقدته وعيه
Dialogue: 0,0:14:31.40,0:14:36.88,Default,,0000,0000,0000,,،ثمّ وضعت المسدّس في يده\Nوجّهته نحو صدره وأطلقت النار
Dialogue: 0,0:14:38.82,0:14:40.81,Default,,0000,0000,0000,,ألستُ محقّاً؟
Dialogue: 0,0:14:40.81,0:14:44.77,Default,,0000,0000,0000,,يا للسخافة! أيّ مزحة هذه يا موري؟
Dialogue: 0,0:14:45.05,0:14:49.19,Default,,0000,0000,0000,,بدايةً، عندما دعوتنا للشواء بالأمس
Dialogue: 0,0:14:49.75,0:14:52.20,Default,,0000,0000,0000,,لم تتناول حتّى رشفة واحدة من الجعّة
Dialogue: 0,0:14:53.91,0:14:55.65,Default,,0000,0000,0000,,...أخبرتك وقتها
Dialogue: 0,0:14:55.91,0:15:00.58,Default,,0000,0000,0000,,...أجل، حتّى الشرطة خارج العمل لا يعرفون
Dialogue: 0,0:15:00.58,0:15:03.07,Default,,0000,0000,0000,,متى قد يُستدعون كما قلت
Dialogue: 0,0:15:03.07,0:15:07.52,Default,,0000,0000,0000,,لذا امتنعتَ عن الشراب، ذلك ما اعتقدتُه أيضاً
Dialogue: 0,0:15:08.32,0:15:12.46,Default,,0000,0000,0000,,لكنّك كنت تتفقد الساعة باستمرار لسببٍ ما
Dialogue: 0,0:15:14.02,0:15:19.89,Default,,0000,0000,0000,,ربما لأنّك كنت تعرف متى\Nسيتّصل ماتسوياما بك؟
Dialogue: 0,0:15:19.89,0:15:23.98,Default,,0000,0000,0000,,لذا تركت هاتفك على حزام\Nبنطالك ولم تشرب
Dialogue: 0,0:15:24.55,0:15:29.94,Default,,0000,0000,0000,,أحمل هاتفي معي دوماً! في حال أتاني نداء طوارئ
Dialogue: 0,0:15:29.94,0:15:31.90,Default,,0000,0000,0000,,أهو بحوزتك الآن؟
Dialogue: 0,0:15:32.75,0:15:35.87,Default,,0000,0000,0000,,...أنا في غرفتي الآن، لكن عادةً
Dialogue: 0,0:15:35.87,0:15:38.78,Default,,0000,0000,0000,,تالياً، عندما تكلّمت مع ماتسوياما على الهاتف
Dialogue: 0,0:15:39.20,0:15:44.36,Default,,0000,0000,0000,,همست بدايةً، لكنك بدأت برفع صوتك فجأة
Dialogue: 0,0:15:44.36,0:15:45.56,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:49.03,0:15:50.11,Default,,0000,0000,0000,,أين أنت؟
Dialogue: 0,0:15:51.75,0:15:53.31,Default,,0000,0000,0000,,!حسناً، سآتي فوراً
Dialogue: 0,0:15:53.31,0:15:58.23,Default,,0000,0000,0000,,كما لو كنتَ تحاول\Nاطلاعنا على ما يتمّ قوله
Dialogue: 0,0:15:59.02,0:16:04.23,Default,,0000,0000,0000,,...ثم رغم أنّك كنت في عجلة، عندما سألتُك عن الأمر
Dialogue: 0,0:16:05.09,0:16:09.94,Default,,0000,0000,0000,,توقفت مكانك وشرحت المكالمة بإسهاب
Dialogue: 0,0:16:10.88,0:16:14.80,Default,,0000,0000,0000,,كان ذلك ماتسوياما، زعيم عصابة
Dialogue: 0,0:16:14.80,0:16:17.90,Default,,0000,0000,0000,,يبدو أنّه قتل شخصاً بالخطأ البارحة
Dialogue: 0,0:16:18.54,0:16:24.03,Default,,0000,0000,0000,,لكن نصف ما قلتَه كان كذبة
Dialogue: 0,0:16:24.03,0:16:30.08,Default,,0000,0000,0000,,أظنّه اتصل بك بشأن الجريمة\Nليلة البارحة في الواقع
Dialogue: 0,0:16:30.82,0:16:34.69,Default,,0000,0000,0000,,اتّفقت معه آنذاك
Dialogue: 0,0:16:35.19,0:16:41.65,Default,,0000,0000,0000,,كان عليه أن يتّصل بك اليوم التالي عند 12:00
Dialogue: 0,0:16:42.02,0:16:45.61,Default,,0000,0000,0000,,...الشخص الذي كان يتكلّم معه وقتها إذاً
Dialogue: 0,0:16:46.19,0:16:48.47,Default,,0000,0000,0000,,كان نفسه أثناء الهمس
Dialogue: 0,0:16:48.47,0:16:51.22,Default,,0000,0000,0000,,والباقي تمثيل فرديّ
Dialogue: 0,0:16:51.22,0:16:53.56,Default,,0000,0000,0000,,كان المتّصل قد أغلق المكالمة بالفعل
Dialogue: 0,0:16:54.04,0:16:58.96,Default,,0000,0000,0000,,ثمّ، بتوقعك أنّي سأطلب أن نذهب معاً
Dialogue: 0,0:16:58.96,0:17:02.04,Default,,0000,0000,0000,,قلتَ أنّك ستلتقي ماتسوياما بمفردك
Dialogue: 0,0:17:02.95,0:17:03.98,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:17:04.45,0:17:10.78,Default,,0000,0000,0000,,كي أشهد أنّك ذهبت له بلا سلاح
Dialogue: 0,0:17:12.48,0:17:19.15,Default,,0000,0000,0000,,لذا كنت تحتاج لأن أكون\Nبالجوار عندما يكلّمك
Dialogue: 0,0:17:19.65,0:17:22.84,Default,,0000,0000,0000,,فقد اتّخذ قراره فجأةً البارحة
Dialogue: 0,0:17:22.84,0:17:27.15,Default,,0000,0000,0000,,"غادر غرفته عند التاسعة وقال "سأدعو موري غداً
Dialogue: 0,0:17:27.64,0:17:33.19,Default,,0000,0000,0000,,أي أنّي اُستغلِلت كجزء من مكيدتك
Dialogue: 0,0:17:33.54,0:17:37.13,Default,,0000,0000,0000,,لكن يا موري-كن، لم يكن المسدّس بحوزته
Dialogue: 0,0:17:37.13,0:17:42.14,Default,,0000,0000,0000,,عندما غادر السيّارة عند رصيف كوان، أليس كذلك؟
Dialogue: 0,0:17:42.41,0:17:45.49,Default,,0000,0000,0000,,ذلك ما بدا لي على الأقل
Dialogue: 0,0:17:45.49,0:17:50.07,Default,,0000,0000,0000,,تعمّد عدم ارتداء معطفه كي يبدو الأمر كذلك
Dialogue: 0,0:17:50.78,0:17:55.31,Default,,0000,0000,0000,,رغم ذهابه لغرفته لأخذه قبل المغادرة
Dialogue: 0,0:17:57.23,0:17:58.98,Default,,0000,0000,0000,,أين كان المسدّس إذاً؟
Dialogue: 0,0:17:59.43,0:18:01.95,Default,,0000,0000,0000,,مربوطاً بكاحله الأيمن
Dialogue: 0,0:18:05.22,0:18:09.43,Default,,0000,0000,0000,,كان لديه مسدّس مخبّأ في غرفته
Dialogue: 0,0:18:09.43,0:18:15.31,Default,,0000,0000,0000,,لذا رفض بنبرة حادة عندما اقترحت\Nزوجته أن تجلب هي المعطف
Dialogue: 0,0:18:15.75,0:18:18.07,Default,,0000,0000,0000,,!كلا! ابقي هنا فحسب
Dialogue: 0,0:18:18.71,0:18:21.15,Default,,0000,0000,0000,,إذاً يا سينباي؟ أأنا مخطئ؟
Dialogue: 0,0:18:21.71,0:18:24.78,Default,,0000,0000,0000,,كلّ ما تقوله افتراضات، لا دليل لديك
Dialogue: 0,0:18:24.78,0:18:27.24,Default,,0000,0000,0000,,سيبدو متناقضاً في المحكمة
Dialogue: 0,0:18:27.24,0:18:34.06,Default,,0000,0000,0000,,كلا، لديّ دليل. البصمة الثالثة\Nالتي كانت على المسدّس
Dialogue: 0,0:18:34.44,0:18:36.23,Default,,0000,0000,0000,,البصمة الثالثة؟
Dialogue: 0,0:18:36.23,0:18:40.15,Default,,0000,0000,0000,,،بينما كنتُ أنتظر خروجك بالأمس
Dialogue: 0,0:18:40.73,0:18:44.48,Default,,0000,0000,0000,,نظرت زوجتك بقلق لغرفة الطابق الثاني
Dialogue: 0,0:18:46.10,0:18:50.60,Default,,0000,0000,0000,,ظننتُها كانت قلقةً وقتها لأنّك كنت ستذهب
Dialogue: 0,0:18:50.60,0:18:56.25,Default,,0000,0000,0000,,للقاء ماتسوياما دون أخذ مسدّس
Dialogue: 0,0:18:56.25,0:18:58.42,Default,,0000,0000,0000,,لكنّي لم أصب
Dialogue: 0,0:18:58.42,0:19:06.19,Default,,0000,0000,0000,,كانت قلقةً لأنّك ستلتقيه وأنت تخفي مسدّساً
Dialogue: 0,0:19:07.10,0:19:12.96,Default,,0000,0000,0000,,ما يعني أنّها كانت تعلم بوجود\Nمسدّس مخبّأ في غرفتك
Dialogue: 0,0:19:14.55,0:19:20.30,Default,,0000,0000,0000,,...وجدته صدفةً في السابق غالباً
Dialogue: 0,0:19:20.30,0:19:22.56,Default,,0000,0000,0000,,وحملته دون تفكير
Dialogue: 0,0:19:23.95,0:19:26.32,Default,,0000,0000,0000,,ثمّ أعادته سريعاً
Dialogue: 0,0:19:27.78,0:19:31.78,Default,,0000,0000,0000,,أرادت أن تسألك على الأرجح\Nلكن منعها الخوف
Dialogue: 0,0:19:31.78,0:19:35.14,Default,,0000,0000,0000,,وواصلت العيش مع هذا القلق المستمر
Dialogue: 0,0:19:37.43,0:19:43.85,Default,,0000,0000,0000,,وفي جهلك لذلك، أخذت المسدّس وقتلت ماتسوياما
Dialogue: 0,0:19:43.85,0:19:45.97,Default,,0000,0000,0000,,فيما جعلته يبدو حادثاً
Dialogue: 0,0:19:45.97,0:19:51.53,Default,,0000,0000,0000,,البصمة الثالثة التي كانت على المسدّس تخصّ الزوجة
Dialogue: 0,0:19:52.92,0:19:56.13,Default,,0000,0000,0000,,أهذا صحيح يا سيّدة؟
Dialogue: 0,0:19:56.13,0:19:58.08,Default,,0000,0000,0000,,موري-سان مُحق
Dialogue: 0,0:19:58.64,0:19:59.83,Default,,0000,0000,0000,,!ميساكو
Dialogue: 0,0:20:07.28,0:20:12.19,Default,,0000,0000,0000,,هلّا فسّرت دافعك لقتلك ماتسوياما يا سينباي؟
Dialogue: 0,0:20:12.19,0:20:14.50,Default,,0000,0000,0000,,...أيمكن أنّك كنت تأخذ
Dialogue: 0,0:20:14.86,0:20:19.95,Default,,0000,0000,0000,,رشوة. سرّبتُ معلومات عن الشرطة\Nله مقابل النقود
Dialogue: 0,0:20:20.27,0:20:21.41,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:21.89,0:20:26.52,Default,,0000,0000,0000,,كان مجرد مبلغ صغير، والمعلومات تافهة بدايةً
Dialogue: 0,0:20:26.52,0:20:30.42,Default,,0000,0000,0000,,...لكن بدأت أفقد إحساسي شيئاً فشيئاً، وبعدما فتحتُ عيناي
Dialogue: 0,0:20:30.42,0:20:34.17,Default,,0000,0000,0000,,وجدتُ أني تجاوزت نقطة العودة
Dialogue: 0,0:20:34.17,0:20:38.13,Default,,0000,0000,0000,,ثمّ تلقيت اتّصالاً منه قبل ليلتين في الساعة الثامنة
Dialogue: 0,0:20:39.41,0:20:44.29,Default,,0000,0000,0000,,قتل شخصاً، وطلب منّي مالاً لمغادرة البلاد
Dialogue: 0,0:20:44.29,0:20:48.24,Default,,0000,0000,0000,,!قال أنّه سيفضحني إذا قُبض عليه
Dialogue: 0,0:20:48.90,0:20:52.11,Default,,0000,0000,0000,,قرّرتُ قتله حينها
Dialogue: 0,0:20:52.11,0:20:58.20,Default,,0000,0000,0000,,أخبرته أنّي سأجهّز المال اليوم التالي\Nوعليه أنّ يتصل بي عند الثانية عشر
Dialogue: 0,0:20:58.85,0:21:06.00,Default,,0000,0000,0000,,أخفيتُ المسدّس في حال أتى يوم كهذا وأجبرتني الظروف
Dialogue: 0,0:21:07.06,0:21:09.66,Default,,0000,0000,0000,,الباقي كما قال موري
Dialogue: 0,0:21:10.93,0:21:13.62,Default,,0000,0000,0000,,أعتذر على خيانتي
Dialogue: 0,0:22:48.28,0:22:53.67,Default,,0000,0000,0000,,...الناس يتغيّرون بالفعل... لا أصدّق أن تيراوكا سينباي
Dialogue: 0,0:22:56.78,0:22:59.62,Default,,0000,0000,0000,,...لكنّك سمعت ما قاله في النهاية
Dialogue: 0,0:22:59.94,0:23:03.17,Default,,0000,0000,0000,,أصبحت متحرّياً عظيماً حقّاً
Dialogue: 0,0:23:03.57,0:23:06.50,Default,,0000,0000,0000,,بدا سعيداً نوعاً ما
Dialogue: 0,0:23:06.90,0:23:08.62,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:23:09.85,0:23:11.81,Default,,0000,0000,0000,,...يبدو أنّه فعلاً
Dialogue: 0,0:23:12.35,0:23:16.93,Default,,0000,0000,0000,,خبّأ تيراوكا-سان المسدّس في حافظة شريط فيديو، صحيح؟
Dialogue: 0,0:23:17.80,0:23:20.91,Default,,0000,0000,0000,,أنت لا تخفي أشياء خطيرة، أليس كذلك؟
Dialogue: 0,0:23:26.80,0:23:28.12,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:23:30.37,0:23:31.04,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:23:31.29,0:23:33.50,Default,,0000,0000,0000,,...يوجد شيء آخر داخله
Dialogue: 0,0:23:40.11,0:23:40.70,Default,,0000,0000,0000,,!انتظري
Dialogue: 0,0:23:44.15,0:23:45.13,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:23:45.13,0:23:48.54,Default,,0000,0000,0000,,!ألقي اللوم عليهم، وليس عليّ
Dialogue: 0,0:23:49.93,0:23:52.22,Default,,0000,0000,0000,,!هذه غلطتك
Dialogue: 0,0:23:52.88,0:23:53.70,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:23:54.39,0:23:56.65,Default,,0000,0000,0000,,!لا تخبّئها هنا
Dialogue: 0,0:24:01.80,0:24:04.33,Default,,0000,0000,0000,,هل اُختطف طفل هذا الرجل؟
Dialogue: 0,0:24:05.01,0:24:07.78,Default,,0000,0000,0000,,أبي! ألديك دليل عن الخاطف؟
Dialogue: 0,0:24:07.78,0:24:12.62,Default,,0000,0000,0000,,كيتا-كن عند مكان فيه الكثير\N!من السرطانات، وحوت ينفخ فقاعات
Dialogue: 0,0:24:13.33,0:24:15.33,Default,,0000,0000,0000,,!رقم اللوحة هذا مزيّف
Dialogue: 0,0:24:16.41,0:24:19.70,Default,,0000,0000,0000,,...كلا! بعدما يأخذ الخاطف المال، كيتا-سان سوف
Dialogue: 0,0:24:21.74,0:24:24.37,Default,,0000,0000,0000,,!فهمت! السرطانات والحوت
Dialogue: 0,0:24:24.38,0:24:30.37,On Top,,0000,0000,15,,قضيّة اختطاف السرطانات والحوت
Dialogue: 0,0:24:25.36,0:24:26.74,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.74,0:24:28.98,Default,,0000,0000,0000,,قضيّة اختطاف السرطانات والحوت
Dialogue: 0,0:24:46.00,0:24:48.32,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.32,0:24:50.11,Default,,0000,0000,0000,,كراسي وطاولات
Dialogue: 0,0:24:50.52,0:24:52.11,Default,,0000,0000,0000,,عنوان الحلقة القادمة غريب نوعاً ما
Dialogue: 0,0:24:52.11,0:24:54.27,Thoughts,,0000,0000,0000,,{\fs14\pos(257.25,346)}سلطعون
Dialogue: 0,0:24:52.11,0:24:54.27,Thoughts,,0000,0000,0000,,{\fs15\pos(198.75,346)}حوت
