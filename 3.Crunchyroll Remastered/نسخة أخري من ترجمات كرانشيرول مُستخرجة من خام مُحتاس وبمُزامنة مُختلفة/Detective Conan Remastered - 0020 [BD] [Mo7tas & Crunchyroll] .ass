Dialogue: 0,0:00:01.40,0:00:02.90,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.90,0:00:06.06,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:06.06,0:00:08.89,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.89,0:00:11.89,Default,,0000,0000,0000,,تقع أحداث قضيّة اليوم\Nفي منزلٍ مسكون
Dialogue: 0,0:00:11.89,0:00:15.34,Default,,0000,0000,0000,,،حتّى لو كانت مخفيةً في قبوٍ مخيف\N!تبقى الحقيقة واحدة دوماً
Dialogue: 0,0:01:47.00,0:01:50.13,Default,,0000,0000,0000,,جريمة قتل المنزل المسكون
Dialogue: 0,0:02:30.46,0:02:33.62,Default,,0000,0000,0000,,!رافقنا في صيد الأشباح يا كونان-كن
Dialogue: 0,0:02:33.99,0:02:35.37,Default,,0000,0000,0000,,صيد أشباح؟
Dialogue: 0,0:02:35.37,0:02:36.87,Default,,0000,0000,0000,,دعيه يا أيومي
Dialogue: 0,0:02:36.87,0:02:40.08,Default,,0000,0000,0000,,فلن يفيدنا بشيء ولو أتى
Dialogue: 0,0:02:40.08,0:02:42.70,Default,,0000,0000,0000,,...لكن إن كنتَ وأنا وحدنا من سنذهب
Dialogue: 0,0:02:43.12,0:02:46.36,Default,,0000,0000,0000,,وأين تكون تلك الأشباح؟
Dialogue: 0,0:02:46.36,0:02:48.40,Default,,0000,0000,0000,,منزل قديم في الشارع الرابع
Dialogue: 0,0:02:48.40,0:02:49.41,Default,,0000,0000,0000,,الشارع الرابع؟
Dialogue: 0,0:02:49.41,0:02:50.90,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:50.90,0:02:52.69,Default,,0000,0000,0000,,يدعوه الناس بقصر الرعب
Dialogue: 0,0:02:52.69,0:02:56.24,Default,,0000,0000,0000,,لتعرض رجلٍ للضرب حتى الموت هناك\N!قبل خمسة أعوام
Dialogue: 0,0:03:02.60,0:03:03.88,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:03:03.88,0:03:06.49,Default,,0000,0000,0000,,أذكر حادثةً غامضة وقعت هناك
Dialogue: 0,0:03:06.80,0:03:10.21,Default,,0000,0000,0000,,،يُقال أنّ زوجته وابنه قد انتقلا
Dialogue: 0,0:03:10.21,0:03:12.67,Default,,0000,0000,0000,,!لكن سكنت الأرواح الشريرة المنزل
Dialogue: 0,0:03:12.67,0:03:13.80,Default,,0000,0000,0000,,أرواح شريرة؟
Dialogue: 0,0:03:13.80,0:03:17.08,Default,,0000,0000,0000,,سمع الناس عويلاً مخيفاً من الداخل ليلاً
Dialogue: 0,0:03:17.08,0:03:20.58,Default,,0000,0000,0000,,وينتهي المطاف بالكلاب الضالة التي\Nتدخل المكان هياكلاً عظمية اليوم التالي
Dialogue: 0,0:03:20.58,0:03:28.95,Default,,0000,0000,0000,,!وفي ليلة البارحة، رأيتُ كرة روح عبر إحدى النوافذ
Dialogue: 0,0:03:31.23,0:03:33.73,Default,,0000,0000,0000,,!ما رأيك؟ ألم تشعر بالحماس؟
Dialogue: 0,0:03:33.73,0:03:35.86,Default,,0000,0000,0000,,هذه مجرد خرافات
Dialogue: 0,0:03:35.86,0:03:39.89,Default,,0000,0000,0000,,يجب أن تُترك الأشباح والأرواح للتلفاز والمانغا
Dialogue: 0,0:03:39.89,0:03:42.28,Default,,0000,0000,0000,,في عصر العلم هذا
Dialogue: 0,0:03:42.64,0:03:46.38,Default,,0000,0000,0000,,!ماذا؟ أتقصد أنّ أيومي كاذبة؟
Dialogue: 0,0:03:46.38,0:03:48.49,Default,,0000,0000,0000,,...كلا، كنتُ فقط
Dialogue: 0,0:03:49.01,0:03:54.82,Default,,0000,0000,0000,,سترافقنا إذاً وتثبت أنّ الأشباح\N!غير موجودة، واضح؟
Dialogue: 0,0:03:55.20,0:03:58.12,Default,,0000,0000,0000,,!لن أرحمك إن خفت
Dialogue: 0,0:03:58.12,0:04:00.74,Default,,0000,0000,0000,,ماذا؟ أرافقكم؟
Dialogue: 0,0:04:01.12,0:04:04.27,Default,,0000,0000,0000,,تصدّقني يا كونان-كن، صحيح؟
Dialogue: 0,0:04:04.27,0:04:05.40,Default,,0000,0000,0000,,...أ-أنا
Dialogue: 0,0:04:05.40,0:04:06.69,Default,,0000,0000,0000,,!صحيح؟
Dialogue: 0,0:04:06.69,0:04:07.40,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:07.40,0:04:08.90,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:04:08.90,0:04:11.94,Default,,0000,0000,0000,,!لنتجهز ونذهب نحن الأربعة لضرب الأشباح
Dialogue: 0,0:04:11.94,0:04:12.83,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:04:13.57,0:04:14.78,Default,,0000,0000,0000,,أهو جاد؟
Dialogue: 0,0:04:29.17,0:04:31.95,Default,,0000,0000,0000,,أخرجوا جميعاً ما جلبتموه
Dialogue: 0,0:04:32.34,0:04:35.54,Default,,0000,0000,0000,,!جلبتُ معي المضرب المعدني طارد الأشباح
Dialogue: 0,0:04:35.54,0:04:37.82,Default,,0000,0000,0000,,أحضرتُ معي طعاماً لوقت الجوع
Dialogue: 0,0:04:38.29,0:04:43.29,Default,,0000,0000,0000,,وأحضرتُ مصابيح يدوية وبوصلةً كيلا نتوه
Dialogue: 0,0:04:43.82,0:04:45.15,Default,,0000,0000,0000,,ماذا عنك يا كونان-كن؟
Dialogue: 0,0:04:45.15,0:04:47.95,Default,,0000,0000,0000,,لـ-لم أجلب شيئاً
Dialogue: 0,0:04:47.95,0:04:49.53,Default,,0000,0000,0000,,!إن متَ فهي مسؤوليتك أنت
Dialogue: 0,0:04:49.53,0:04:51.87,Default,,0000,0000,0000,,!صحيح! سينالون منك إن استهترت
Dialogue: 0,0:04:53.53,0:04:56.06,Default,,0000,0000,0000,,...سأحاول ألّا أموت
Dialogue: 0,0:04:56.06,0:04:58.82,Default,,0000,0000,0000,,أيظنّ هؤلاء أنهم يدخلون قلعة ملك الشياطين؟
Dialogue: 0,0:04:59.85,0:05:02.27,Default,,0000,0000,0000,,هذه البوابة لا تُفتح
Dialogue: 0,0:05:02.27,0:05:03.48,Default,,0000,0000,0000,,لا تقلق
Dialogue: 0,0:05:03.48,0:05:07.08,Default,,0000,0000,0000,,وجدتُ حلّاً عندما أتيت\N...لاستكشاف المكان قبلاً
Dialogue: 0,0:05:07.90,0:05:09.24,Default,,0000,0000,0000,,!مدخل سرّي
Dialogue: 0,0:05:09.80,0:05:11.74,Default,,0000,0000,0000,,مدخل سرّي؟
Dialogue: 0,0:05:15.79,0:05:17.70,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:05:18.29,0:05:19.87,Default,,0000,0000,0000,,تخفيه الأعشاب
Dialogue: 0,0:05:19.87,0:05:22.87,Default,,0000,0000,0000,,لكنه كبير بما يكفي ليعبر الناس، رأيتم؟
Dialogue: 0,0:05:22.87,0:05:24.36,Default,,0000,0000,0000,,!مذهل يا غينتا-كن
Dialogue: 0,0:05:26.66,0:05:28.91,Default,,0000,0000,0000,,مدخل سرّي؟
Dialogue: 0,0:05:28.91,0:05:30.64,Default,,0000,0000,0000,,!كونان-كن! أسرع
Dialogue: 0,0:05:30.64,0:05:31.66,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:05:33.57,0:05:35.01,Default,,0000,0000,0000,,إنّه مفتوح
Dialogue: 0,0:05:35.94,0:05:38.98,Default,,0000,0000,0000,,الظلام حالك، لا أرى شيئاً
Dialogue: 0,0:05:38.98,0:05:40.57,Default,,0000,0000,0000,,...مريبٌ حقاً
Dialogue: 0,0:05:40.90,0:05:43.56,Default,,0000,0000,0000,,ر-ربما علينا العودة
Dialogue: 0,0:05:43.56,0:05:45.76,Default,,0000,0000,0000,,فالمطر بدأ يهطل
Dialogue: 0,0:05:45.76,0:05:49.05,Default,,0000,0000,0000,,!حمقاء! لم نأت هنا لننسحب
Dialogue: 0,0:05:49.05,0:05:51.47,Default,,0000,0000,0000,,يمكنك أن ترجعي بمفردك إن أردتِ
Dialogue: 0,0:05:51.47,0:05:52.53,Default,,0000,0000,0000,,!لكن
Dialogue: 0,0:06:00.29,0:06:01.29,Default,,0000,0000,0000,,!رعد
Dialogue: 0,0:06:01.29,0:06:02.54,Default,,0000,0000,0000,,!أيومي
Dialogue: 0,0:06:13.20,0:06:17.28,Default,,0000,0000,0000,,أمعني النظر، إنّه مجرد تمثال شيطان
Dialogue: 0,0:06:17.65,0:06:21.86,Default,,0000,0000,0000,,فظيع، سقطتُ فحسب لكن\Nاتّسخت ساقيّ وذراعيّ بالكامل
Dialogue: 0,0:06:21.86,0:06:26.24,Default,,0000,0000,0000,,لم يأت أحدٌ هنا لوقت طويل\Nفالأرض مغطاة بالغبار
Dialogue: 0,0:06:27.55,0:06:29.45,Default,,0000,0000,0000,,!توجد مغسلة
Dialogue: 0,0:06:30.26,0:06:32.16,Default,,0000,0000,0000,,!يا لحظّي
Dialogue: 0,0:06:35.09,0:06:37.00,Default,,0000,0000,0000,,...المشي معكم هكذا
Dialogue: 0,0:06:37.00,0:06:39.21,Default,,0000,0000,0000,,!يُشعرني أنّنا في لعبة تبادل أدوار
Dialogue: 0,0:06:39.21,0:06:41.33,Default,,0000,0000,0000,,!أجل، نحن فرقة
Dialogue: 0,0:06:41.59,0:06:43.37,Default,,0000,0000,0000,,!أنا البطل بالطبع
Dialogue: 0,0:06:43.37,0:06:45.70,Default,,0000,0000,0000,,!أنا المحاربة الظريفة
Dialogue: 0,0:06:45.70,0:06:48.03,Default,,0000,0000,0000,,أنا الساحر الذكيّ
Dialogue: 0,0:06:48.03,0:06:49.28,Default,,0000,0000,0000,,...أنا إذاً
Dialogue: 0,0:06:49.28,0:06:50.73,Default,,0000,0000,0000,,...أنت قرويّ
Dialogue: 0,0:06:51.58,0:06:54.36,Default,,0000,0000,0000,,لكن القرويين ليسوا أعضاءً في الفرقة
Dialogue: 0,0:06:54.36,0:06:57.23,Default,,0000,0000,0000,,لكنّك شخصية مهمة تعطينا المعلومات
Dialogue: 0,0:06:57.23,0:06:58.91,Default,,0000,0000,0000,,أجل، دورٌ مثاليّ لك
Dialogue: 0,0:06:59.52,0:07:02.07,Default,,0000,0000,0000,,!لا تستخفوا بي
Dialogue: 0,0:07:08.22,0:07:11.74,Default,,0000,0000,0000,,ما خطبكم؟ تختبئون وراء ظهر القرويّ؟
Dialogue: 0,0:07:12.22,0:07:14.33,Default,,0000,0000,0000,,!اذهب يا قرويّ
Dialogue: 0,0:07:14.33,0:07:15.69,Default,,0000,0000,0000,,!أنتَ لها يا كونان-كن
Dialogue: 0,0:07:27.66,0:07:32.78,Default,,0000,0000,0000,,فهمت، فتحت الرياح الباب
Dialogue: 0,0:07:33.20,0:07:36.53,Default,,0000,0000,0000,,هكذا تكون حقيقة معظم الأشباح
Dialogue: 0,0:07:37.48,0:07:40.07,Default,,0000,0000,0000,,تبدو كمتحرٍّ يا ميتسوهيكو-كن
Dialogue: 0,0:07:40.07,0:07:44.22,Default,,0000,0000,0000,,سأذهب لدورة المياه لذا انتظروا هنا
Dialogue: 0,0:07:44.22,0:07:45.72,Default,,0000,0000,0000,,ستكون بخيرٍ بمفردك؟
Dialogue: 0,0:07:45.72,0:07:48.61,Default,,0000,0000,0000,,!بالطبع، فالعلم والمنطق في صفيّ
Dialogue: 0,0:07:49.56,0:07:52.10,Default,,0000,0000,0000,,يا له من منزلٍ كبير
Dialogue: 0,0:07:52.10,0:07:54.57,Default,,0000,0000,0000,,كان يعيش هنا رجلٌ فاحش الثراء بالتأكيد
Dialogue: 0,0:08:08.37,0:08:13.41,Default,,0000,0000,0000,,لا يمكن أن توجد الأشباح\N...في عصر العلم هذا
Dialogue: 0,0:08:13.41,0:08:17.19,Default,,0000,0000,0000,,لا بد أنّه كان صوت هبوب الرياح\Nعبر فتحة صغيرة
Dialogue: 0,0:08:17.19,0:08:19.53,Default,,0000,0000,0000,,وما شابه
Dialogue: 0,0:08:19.53,0:08:23.16,Default,,0000,0000,0000,,!حسنٌ، سأرى بنفسي
Dialogue: 0,0:08:26.27,0:08:28.82,Default,,0000,0000,0000,,...تقود هذه الأدراج للقبو
Dialogue: 0,0:08:29.48,0:08:32.48,Default,,0000,0000,0000,,سمعتُ الصوت من الأسفل
Dialogue: 0,0:08:32.48,0:08:33.78,Default,,0000,0000,0000,,...حـ-حسنٌ
Dialogue: 0,0:08:34.38,0:08:36.38,Default,,0000,0000,0000,,تأخّر ميتسوهيكو-كن
Dialogue: 0,0:08:36.38,0:08:38.17,Default,,0000,0000,0000,,مضت 20 دقيقة
Dialogue: 0,0:08:38.17,0:08:40.70,Default,,0000,0000,0000,,ربما يتغوّط
Dialogue: 0,0:08:42.22,0:08:44.62,Default,,0000,0000,0000,,الصوت يرتفع
Dialogue: 0,0:08:47.75,0:08:49.61,Default,,0000,0000,0000,,يصدر من تلك الغرفة
Dialogue: 0,0:09:01.57,0:09:02.74,Default,,0000,0000,0000,,!ذاك صوت ميتسوهيكو
Dialogue: 0,0:09:02.74,0:09:04.78,Default,,0000,0000,0000,,!انتظر يا كونان-كن
Dialogue: 0,0:09:05.23,0:09:07.74,Default,,0000,0000,0000,,!يوجد شيءٌ في هذا القصر بالفعل{\i1}{\i0}
Dialogue: 0,0:09:08.44,0:09:11.31,Default,,0000,0000,0000,,ميتسوهيكو! أين أنت؟
Dialogue: 0,0:09:11.31,0:09:14.55,Default,,0000,0000,0000,,!أجبنا! ميتسوهيكو-كن
Dialogue: 0,0:09:14.55,0:09:16.59,Default,,0000,0000,0000,,
Dialogue: 0,0:09:16.59,0:09:18.93,Default,,0000,0000,0000,,أين ذهب؟
Dialogue: 0,0:09:18.93,0:09:20.41,Default,,0000,0000,0000,,لم يكن في الحمّام أيضاً
Dialogue: 0,0:09:20.41,0:09:23.22,Default,,0000,0000,0000,,لم يكن ذاك الصراخ بسيطاً
Dialogue: 0,0:09:23.22,0:09:25.54,Default,,0000,0000,0000,,حلّ أمرٌ ما بميتسوهيكو
Dialogue: 0,0:09:25.54,0:09:26.82,Default,,0000,0000,0000,,...حسنٌ
Dialogue: 0,0:09:27.54,0:09:30.42,Default,,0000,0000,0000,,!اختبئا في غرفة مجاورة
Dialogue: 0,0:09:30.42,0:09:32.37,Default,,0000,0000,0000,,سأبحث عن ميتسوهيكو
Dialogue: 0,0:09:32.37,0:09:34.70,Default,,0000,0000,0000,,!إيّاكما أن تغادرا
Dialogue: 0,0:09:34.70,0:09:35.96,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:09:35.96,0:09:37.11,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:09:37.82,0:09:38.95,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:09:38.95,0:09:42.20,Default,,0000,0000,0000,,يُفترض أنّ لا أحد يعيش هنا\N،مذ وقعت الحادثة
Dialogue: 0,0:09:42.86,0:09:44.90,Default,,0000,0000,0000,,فلمَ الماء يصبّ؟
Dialogue: 0,0:09:45.52,0:09:47.85,Default,,0000,0000,0000,,كما الغرفة بالنافذة المفتوحة
Dialogue: 0,0:09:47.85,0:09:50.62,Default,,0000,0000,0000,,لم تكن بها آثار ضرر من الرياح أو المطر
Dialogue: 0,0:09:50.62,0:09:54.57,Default,,0000,0000,0000,,مما يعني أنّها فُتحت مؤخراً نسبياً
Dialogue: 0,0:09:55.22,0:09:59.03,Default,,0000,0000,0000,,وذاك المدخل السرّي الذي صُنع\Nخارج مرأى الجميع
Dialogue: 0,0:09:59.39,0:10:02.39,Default,,0000,0000,0000,,هناك من يدخل ويغادر هذا القصر
Dialogue: 0,0:10:02.39,0:10:03.69,Default,,0000,0000,0000,,لكن من؟
Dialogue: 0,0:10:04.08,0:10:05.65,Default,,0000,0000,0000,,ولمَ؟
Dialogue: 0,0:10:10.54,0:10:13.45,Default,,0000,0000,0000,,لا بد أنّ أمهاتنا يشعرن بالقلق علينا الآن
Dialogue: 0,0:10:13.45,0:10:15.69,Default,,0000,0000,0000,,الظلام مخيم في الخارج
Dialogue: 0,0:10:15.95,0:10:19.16,Default,,0000,0000,0000,,تأخّر كونان حقاً
Dialogue: 0,0:10:19.16,0:10:21.12,Default,,0000,0000,0000,,!لا يمكنك أخذ هذه
Dialogue: 0,0:10:21.12,0:10:25.73,Default,,0000,0000,0000,,ميتسوهيكو-كن تائه في مكانٍ ما\Nويتضور جوعاً حتماً
Dialogue: 0,0:10:25.73,0:10:27.07,Default,,0000,0000,0000,,...كونان-كن أيضاً
Dialogue: 0,0:10:27.40,0:10:30.27,Default,,0000,0000,0000,,!هذه لهما! لا يمكنك أكلها
Dialogue: 0,0:10:30.27,0:10:31.53,Default,,0000,0000,0000,,فـ-فهمت
Dialogue: 0,0:10:35.80,0:10:37.75,Default,,0000,0000,0000,,!أشتم رائحة طعام
Dialogue: 0,0:10:38.72,0:10:40.55,Default,,0000,0000,0000,,من ذاك الاتجاه
Dialogue: 0,0:10:40.55,0:10:42.23,Default,,0000,0000,0000,,سأذهب للتفقد
Dialogue: 0,0:10:42.23,0:10:45.88,Default,,0000,0000,0000,,!لا يمكنك! أخبرنا كونان-كن ألّا نغادر
Dialogue: 0,0:10:45.88,0:10:46.99,Default,,0000,0000,0000,,سأعود فوراً
Dialogue: 0,0:10:47.42,0:10:48.95,Default,,0000,0000,0000,,!غينتا-كن
Dialogue: 0,0:10:52.00,0:10:56.20,Default,,0000,0000,0000,,غريب، لا علامات على وجود أحد\Nفي أيّ مكان
Dialogue: 0,0:10:56.20,0:10:57.90,Default,,0000,0000,0000,,ربما لا يوجد شخص حقاً؟
Dialogue: 0,0:11:02.70,0:11:03.82,Default,,0000,0000,0000,,...صورة
Dialogue: 0,0:11:04.32,0:11:08.65,Default,,0000,0000,0000,,أهذا مالك القصر الذي قُتل\Nقبل خمسة أعوام؟
Dialogue: 0,0:11:08.65,0:11:11.78,Default,,0000,0000,0000,,ومن خلفه هما زوجته وابنه؟
Dialogue: 0,0:11:12.19,0:11:15.01,Default,,0000,0000,0000,,...ظننتُ أنّ القاتل لم يُقبض عليه
Dialogue: 0,0:11:15.01,0:11:18.19,Default,,0000,0000,0000,,...وانتقل أفراد العائلة المتبقين
Dialogue: 0,0:11:21.06,0:11:22.97,Default,,0000,0000,0000,,!كان ذلك صوت غينتا
Dialogue: 0,0:11:22.97,0:11:25.28,Default,,0000,0000,0000,,!تبّاً! أخبرته أن يختبئ
Dialogue: 0,0:11:27.25,0:11:32.20,Default,,0000,0000,0000,,غينتا-كن؟ ما الخطب؟ أحصل أمرٌ ما؟
Dialogue: 0,0:11:35.41,0:11:39.70,Default,,0000,0000,0000,,!غينتا-كن! لا تخفني هكذا
Dialogue: 0,0:11:41.58,0:11:45.15,Default,,0000,0000,0000,,!كلا! ليست هذه خطوات غينتا-كن
Dialogue: 0,0:11:45.15,0:11:48.07,Default,,0000,0000,0000,,!من إذاً؟ من؟
Dialogue: 0,0:11:59.06,0:12:00.72,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:12:00.72,0:12:01.87,Default,,0000,0000,0000,,!لا تصدري صوتاً
Dialogue: 0,0:12:07.38,0:12:07.99,Default,,0000,0000,0000,,إنّه قادم
Dialogue: 0,0:12:46.01,0:12:47.97,Default,,0000,0000,0000,,شـ-شبح
Dialogue: 0,0:12:47.97,0:12:50.38,Default,,0000,0000,0000,,!كلا، أمعني النظر! إنّه إنسان
Dialogue: 0,0:12:50.38,0:12:52.59,Default,,0000,0000,0000,,ينقل شيئاً ما
Dialogue: 0,0:12:52.59,0:12:53.69,Default,,0000,0000,0000,,لكن أين؟
Dialogue: 0,0:12:57.54,0:12:59.12,Default,,0000,0000,0000,,!انتظر يا كونان-كن
Dialogue: 0,0:13:04.28,0:13:05.36,Default,,0000,0000,0000,,!اختفى
Dialogue: 0,0:13:08.03,0:13:10.07,Default,,0000,0000,0000,,لا توجد غرف في الجوار
Dialogue: 0,0:13:10.07,0:13:11.49,Default,,0000,0000,0000,,والطريق مسدود أمامنا
Dialogue: 0,0:13:12.07,0:13:13.73,Default,,0000,0000,0000,,أين اختفى؟
Dialogue: 0,0:13:13.73,0:13:15.86,Default,,0000,0000,0000,,!أخبرتك أنّه شبح
Dialogue: 0,0:13:19.23,0:13:22.06,Default,,0000,0000,0000,,يوجد خطّ على الغبار في الأرض
Dialogue: 0,0:13:22.06,0:13:23.78,Default,,0000,0000,0000,,...لحظة، أيمكن
Dialogue: 0,0:13:25.26,0:13:27.22,Default,,0000,0000,0000,,هذا باب
Dialogue: 0,0:13:27.22,0:13:29.91,Default,,0000,0000,0000,,!فهمت، نزل ذاك الشخص هنا
Dialogue: 0,0:13:35.37,0:13:38.49,Default,,0000,0000,0000,,لا جدوى، لا يمكنني رفعه بقوّة صبي
Dialogue: 0,0:13:38.87,0:13:39.95,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:13:39.95,0:13:42.92,Default,,0000,0000,0000,,أسميّها الحمّالات القابلة للسحب
Dialogue: 0,0:13:42.92,0:13:46.36,Default,,0000,0000,0000,,بضغطة واحدة تتكمّش من حالتها المتمددة
Dialogue: 0,0:13:46.36,0:13:49.41,Default,,0000,0000,0000,,!ستفيدك في ربط المجرمين
Dialogue: 0,0:13:49.70,0:13:52.20,Default,,0000,0000,0000,,أجل، سأجرب استعمالها
Dialogue: 0,0:13:52.20,0:13:53.81,Default,,0000,0000,0000,,ماذا ستفعل بها؟
Dialogue: 0,0:13:53.81,0:13:55.36,Default,,0000,0000,0000,,راقبي فقط
Dialogue: 0,0:14:06.76,0:14:08.11,Default,,0000,0000,0000,,!مُذهل
Dialogue: 0,0:14:08.55,0:14:10.51,Default,,0000,0000,0000,,!درج للقبو
Dialogue: 0,0:14:10.51,0:14:12.83,Default,,0000,0000,0000,,لعلّ ميتسوهيكو وغينتا في الأسفل
Dialogue: 0,0:14:22.46,0:14:23.19,Default,,0000,0000,0000,,!أرى ضوءاً
Dialogue: 0,0:14:38.65,0:14:40.06,Default,,0000,0000,0000,,!زنزانة
Dialogue: 0,0:14:40.06,0:14:42.65,Default,,0000,0000,0000,,لمَ توجد واحدة هنا؟
Dialogue: 0,0:14:42.65,0:14:46.32,Default,,0000,0000,0000,,!يوجد شخص! انظر، على السرير
Dialogue: 0,0:14:54.34,0:14:56.29,Default,,0000,0000,0000,,من هذا الشخص؟
Dialogue: 0,0:14:57.54,0:14:58.53,Default,,0000,0000,0000,,!أحدهم قادم
Dialogue: 0,0:15:11.95,0:15:14.65,Default,,0000,0000,0000,,كابوس آخر؟
Dialogue: 0,0:15:14.65,0:15:15.90,Default,,0000,0000,0000,,...يا للمسكين
Dialogue: 0,0:15:16.61,0:15:20.87,Default,,0000,0000,0000,,،لكن وقع ذلك قبل 5 أعوام\N!فلتنس أمره وحسب
Dialogue: 0,0:15:21.40,0:15:26.03,Default,,0000,0000,0000,,مهما عانيتَ فلن يرجع الموتى
Dialogue: 0,0:15:26.31,0:15:27.97,Default,,0000,0000,0000,,الموتى؟
Dialogue: 0,0:15:27.97,0:15:31.49,Default,,0000,0000,0000,,أيمكن أنّها تقصد مالك هذا المنزل المقتول؟
Dialogue: 0,0:15:32.35,0:15:35.44,Default,,0000,0000,0000,,...مما يعني أنّ هذين الاثنين
Dialogue: 0,0:15:35.80,0:15:37.87,Default,,0000,0000,0000,,هيّا، كُل
Dialogue: 0,0:15:48.12,0:15:54.03,Default,,0000,0000,0000,,!لا أحتجزك هنا كي تعاني
Dialogue: 0,0:15:54.03,0:15:57.61,Default,,0000,0000,0000,,!أكيو! أفعل هذا لتحظى بمستقبل
Dialogue: 0,0:15:58.19,0:16:03.82,Default,,0000,0000,0000,,فهمت الآن سرّ هذا القصر \N!وحقيقة تلك الجريمة
Dialogue: 0,0:16:21.16,0:16:27.11,Default,,0000,0000,0000,,يبدو أنّه تسللت جرذان أخرى\Nمع الجرذين السابقين
Dialogue: 0,0:16:27.37,0:16:31.07,Default,,0000,0000,0000,,اظهروا، لا جدوى من الاختباء
Dialogue: 0,0:16:31.07,0:16:32.45,Default,,0000,0000,0000,,!اظهروا
Dialogue: 0,0:16:33.69,0:16:35.11,Default,,0000,0000,0000,,...لا جدوى من الاختباء
Dialogue: 0,0:16:35.69,0:16:38.24,Default,,0000,0000,0000,,!هذا موجّه لك يا سيّدة
Dialogue: 0,0:16:38.49,0:16:41.40,Default,,0000,0000,0000,,وجدتُها في المكتب قبل قليل
Dialogue: 0,0:16:41.40,0:16:44.48,Default,,0000,0000,0000,,صورتك ومالك هذا المنزل
Dialogue: 0,0:16:44.48,0:16:46.69,Default,,0000,0000,0000,,الذي قُتل قبل 5 أعوام
Dialogue: 0,0:16:47.18,0:16:52.02,Default,,0000,0000,0000,,كما من تغيّر مظهره بشكل جذري\Nفي الخمسة أعوام التي قضاها هنا
Dialogue: 0,0:16:52.02,0:16:55.55,Default,,0000,0000,0000,,...الشاب الذي كان بجوارك في الصورة هو ابنك
Dialogue: 0,0:16:55.55,0:16:58.07,Default,,0000,0000,0000,,!أجل، المحتجز في تلك الزنزانة
Dialogue: 0,0:16:58.55,0:17:01.03,Default,,0000,0000,0000,,الشامة تحت عينه كانت الشيء الوحيد\Nالذي لم يتغير
Dialogue: 0,0:17:01.47,0:17:05.61,Default,,0000,0000,0000,,شعرتُ أن هناك أمراً غريباً\Nمُذ دخلت القصر
Dialogue: 0,0:17:05.87,0:17:10.33,Default,,0000,0000,0000,,يُفترض أنّ العائلة انتقلت \Nوأصبح القصر فارغاً
Dialogue: 0,0:17:10.33,0:17:11.54,Default,,0000,0000,0000,,لكن كان الماء لا يزال يجري مع ذلك
Dialogue: 0,0:17:12.66,0:17:18.78,Default,,0000,0000,0000,,فلا أحد مستهتر كفاية ليدفع\Nفاتورة الماء باستمرار
Dialogue: 0,0:17:18.78,0:17:20.16,Default,,0000,0000,0000,,لبيت لا يعيش فيه أحد
Dialogue: 0,0:17:20.70,0:17:24.77,Default,,0000,0000,0000,,كما هناك موضوع المدخل المخبأ
Dialogue: 0,0:17:24.77,0:17:26.85,Default,,0000,0000,0000,,كان لا يزال ذاك الباب الخشبي جديداً
Dialogue: 0,0:17:26.85,0:17:29.73,Default,,0000,0000,0000,,مقارنةً بعمر الجدران المجاورة
Dialogue: 0,0:17:29.73,0:17:33.09,Default,,0000,0000,0000,,صُنع بعد وقوع الحادثة غالباً
Dialogue: 0,0:17:33.09,0:17:36.47,Default,,0000,0000,0000,,كي يمكنك الدخول والمغادرة دون أن يراك أحد
Dialogue: 0,0:17:36.47,0:17:40.97,Default,,0000,0000,0000,,لكن سبب حرصك على جعل المكان \Nيبدو غير مسكون
Dialogue: 0,0:17:40.97,0:17:45.28,Default,,0000,0000,0000,,...واحتجازك لابنك في القبو
Dialogue: 0,0:17:46.04,0:17:50.08,Default,,0000,0000,0000,,تبيّن لي من محادثتكما قبل قليل
Dialogue: 0,0:17:50.08,0:17:52.70,Default,,0000,0000,0000,,!من أنت؟ من أنت؟
Dialogue: 0,0:17:53.91,0:17:56.69,Default,,0000,0000,0000,,إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:17:57.07,0:17:58.95,Default,,0000,0000,0000,,!مُتحرٍّ؟
Dialogue: 0,0:17:59.32,0:18:02.94,Default,,0000,0000,0000,,يوجد احتمالان يمكنني التفكير بهما
Dialogue: 0,0:18:02.94,0:18:06.27,Default,,0000,0000,0000,,الأول هو أن مالك المنزل قُتل\N،بواسطتك أنت، زوجته
Dialogue: 0,0:18:06.27,0:18:09.41,Default,,0000,0000,0000,,وسجنتِ ابنك لأنّه شهد الجريمة
Dialogue: 0,0:18:09.94,0:18:15.68,Default,,0000,0000,0000,,!والثاني أنّ ابنك من قتل زوجك
Dialogue: 0,0:18:15.68,0:18:17.39,Default,,0000,0000,0000,,،بعلمك أنّه القاتل
Dialogue: 0,0:18:17.39,0:18:21.64,Default,,0000,0000,0000,,قرّرتِ حماية ابنك بإخفاء حقيقة الجريمة
Dialogue: 0,0:18:21.64,0:18:24.15,Default,,0000,0000,0000,,لكنّ عبء الذنب كان ثقيلاً عليه
Dialogue: 0,0:18:24.88,0:18:29.88,Default,,0000,0000,0000,,العويل الصادر من القصر\Nكان صرخاته المتشققة غالباً
Dialogue: 0,0:18:29.88,0:18:35.11,Default,,0000,0000,0000,,أراد ابنك تسليم نفسه للتكفير \Nعن جريمته على الأرجح
Dialogue: 0,0:18:35.11,0:18:38.07,Default,,0000,0000,0000,,لكنك أبيتِ السماح بذلك
Dialogue: 0,0:18:38.37,0:18:42.66,Default,,0000,0000,0000,,!حاول أن تفهم! هذا لأجلك
Dialogue: 0,0:18:44.36,0:18:48.94,Default,,0000,0000,0000,,أجل، لم تريدي أن يُعتبر ابنك مجرماً
Dialogue: 0,0:18:48.94,0:18:52.71,Default,,0000,0000,0000,,فاخترتِ إخفاءه هنا دون السماح\Nله بأخذ خطوة خارجاً
Dialogue: 0,0:18:53.89,0:18:57.15,Default,,0000,0000,0000,,...من محادثتكما قبل قليل وردّة فعلكما
Dialogue: 0,0:18:57.72,0:18:59.49,Default,,0000,0000,0000,,...أرجّح أنّ قاتل زوجك كان
Dialogue: 0,0:18:59.49,0:19:02.23,Default,,0000,0000,0000,,!ا-اخرس! اخرس
Dialogue: 0,0:19:05.21,0:19:06.36,Default,,0000,0000,0000,,!توقفي
Dialogue: 0,0:19:08.25,0:19:12.00,Default,,0000,0000,0000,,!توقفي يا أمّي! إنّه محق
Dialogue: 0,0:19:12.00,0:19:16.24,Default,,0000,0000,0000,,!صحيح، كنتُ من قتل أبي
Dialogue: 0,0:19:19.87,0:19:21.20,Default,,0000,0000,0000,,أكيو
Dialogue: 0,0:19:22.28,0:19:24.40,Default,,0000,0000,0000,,وقع الأمر في ليلة ربيع قبل 5 أعوام
Dialogue: 0,0:19:24.40,0:19:27.65,Default,,0000,0000,0000,,...فشلتُ في امتحان القبول الجامعي للمرة الثالثة
Dialogue: 0,0:19:28.65,0:19:31.37,Default,,0000,0000,0000,,ماذا؟ فشلت مجدداً؟
Dialogue: 0,0:19:32.40,0:19:34.32,Default,,0000,0000,0000,,!أنت عار على عائلتك
Dialogue: 0,0:19:35.10,0:19:37.74,Default,,0000,0000,0000,,!بل نكرة! أنت نكرة
Dialogue: 0,0:19:38.18,0:19:40.16,Default,,0000,0000,0000,,...كنتُ متمزقاً ذهنياً
Dialogue: 0,0:19:40.72,0:19:42.66,Default,,0000,0000,0000,,...فعندما سمعت كلمات أبي
Dialogue: 0,0:19:43.17,0:19:45.11,Default,,0000,0000,0000,,فقدتُ السيطرة على نفسي للحظة
Dialogue: 0,0:19:45.84,0:19:47.03,Default,,0000,0000,0000,,!أكيو
Dialogue: 0,0:19:47.67,0:19:52.12,Default,,0000,0000,0000,,عندما استعدتُ وعيي، كنتُ أحمل\Nشمعداناً مغطّى بالدماء
Dialogue: 0,0:19:52.83,0:19:56.07,Default,,0000,0000,0000,,وأبي طريحاً غير واضح الملامح
Dialogue: 0,0:19:56.58,0:20:00.66,Default,,0000,0000,0000,,لا تقلق، سأحميك
Dialogue: 0,0:20:00.66,0:20:02.03,Default,,0000,0000,0000,,!أمّي
Dialogue: 0,0:20:02.66,0:20:05.57,Default,,0000,0000,0000,,الباقي كما قلت
Dialogue: 0,0:20:05.57,0:20:08.15,Default,,0000,0000,0000,,جعلت أُمي الحادثة كأنها جريمة سطو
Dialogue: 0,0:20:08.15,0:20:10.74,Default,,0000,0000,0000,,واحتجزتني في هذه الزنزانة
Dialogue: 0,0:20:11.57,0:20:15.47,Default,,0000,0000,0000,,لكن لم أعد أحتمل! لا أستطيع العيش
Dialogue: 0,0:20:15.47,0:20:18.81,Default,,0000,0000,0000,,!وذنب قتل أبي يطاردني
Dialogue: 0,0:20:18.81,0:20:21.27,Default,,0000,0000,0000,,!أريد الاعتراف بجريمتي كي أعيش بسلام مع نفسي
Dialogue: 0,0:20:21.27,0:20:23.07,Default,,0000,0000,0000,,!تماسك يا أكيو
Dialogue: 0,0:20:23.51,0:20:26.51,Default,,0000,0000,0000,,!تحمّل حتى ينتهي الحدّ الزمني
Dialogue: 0,0:20:26.51,0:20:30.24,Default,,0000,0000,0000,,لـ-لن يعرف أحد إن لزمنا الصمت
Dialogue: 0,0:20:30.71,0:20:35.32,Default,,0000,0000,0000,,معكِ حق، سيفلت من الشرطة\Nإن واصل الاختباء هكذا
Dialogue: 0,0:20:35.70,0:20:38.70,Default,,0000,0000,0000,,!لكنه لن يستطيع الهروب من ذنبه أبداً
Dialogue: 0,0:20:40.08,0:20:41.16,Default,,0000,0000,0000,,أمّاه
Dialogue: 0,0:20:41.16,0:20:43.90,Default,,0000,0000,0000,,أتنوين جعل ابنك يتحمّل هذا العبء
Dialogue: 0,0:20:43.90,0:20:45.36,Default,,0000,0000,0000,,الثقيل لبقية حياته؟
Dialogue: 0,0:21:02.23,0:21:04.05,Default,,0000,0000,0000,,،انتهت ليلة الرعب
Dialogue: 0,0:21:04.05,0:21:06.65,Default,,0000,0000,0000,,وأشرق ضوء الشمس على القصر
Dialogue: 0,0:21:07.26,0:21:09.01,Default,,0000,0000,0000,,من اختفيا البارحة
Dialogue: 0,0:21:09.01,0:21:12.38,Default,,0000,0000,0000,,كانا نائمين بين الأعشاب خارجاً
Dialogue: 0,0:21:12.38,0:21:15.54,Default,,0000,0000,0000,,يبدو أنّ الأم نوّمتهما بمخدر
Dialogue: 0,0:21:15.54,0:21:18.11,Default,,0000,0000,0000,,وألقتهما خارجاً
Dialogue: 0,0:21:18.58,0:21:22.53,Default,,0000,0000,0000,,سلّمت نفسها وابنها في اليوم نفسه للسلطات
Dialogue: 0,0:21:22.53,0:21:27.11,Default,,0000,0000,0000,,وُحلّت القضيّة المحيرة بعد 5 أعوام طويلة
Dialogue: 0,0:21:28.24,0:21:32.45,Default,,0000,0000,0000,,تعرضنا الأربعة لتوبيخ شديد من البالغين بالطبع
Dialogue: 0,0:21:32.73,0:21:36.52,Default,,0000,0000,0000,,أتمنى لو أرجع لجسدي الطبيعي
Dialogue: 0,0:23:11.18,0:23:13.15,Default,,0000,0000,0000,,!منزل مسكون آخر؟
Dialogue: 0,0:23:13.15,0:23:16.04,Default,,0000,0000,0000,,أجل، وجدت أيومي منزلاً آخر
Dialogue: 0,0:23:16.04,0:23:18.71,Default,,0000,0000,0000,,!إنّه في الشارع الثاني ويخصّ عائلة إيتو
Dialogue: 0,0:23:18.71,0:23:19.49,Default,,0000,0000,0000,,إيتو؟
Dialogue: 0,0:23:19.92,0:23:25.24,Default,,0000,0000,0000,,يقول أهل الحيّ أنّ ذاك القصر المريب\Nمليء بالكتب الغريبة
Dialogue: 0,0:23:25.24,0:23:29.41,Default,,0000,0000,0000,,!والفتى الذي كان يعيش بمفرده أكلته الوحوش
Dialogue: 0,0:23:30.03,0:23:33.82,Default,,0000,0000,0000,,فتى يعيش بمفرده في قصر مريب مليء بالكتب؟
Dialogue: 0,0:23:33.82,0:23:36.36,Default,,0000,0000,0000,,الشارع الثاني؟ إيتو؟
Dialogue: 0,0:23:36.73,0:23:39.73,Default,,0000,0000,0000,,أأنتِ متأكدة أن الاسم كان إيتو؟
Dialogue: 0,0:23:39.73,0:23:43.07,Default,,0000,0000,0000,,"أجل، تكتبه بكاتاكانا "إي" وكانجي "تو
Dialogue: 0,0:23:45.53,0:23:49.56,Default,,0000,0000,0000,,!حسناً! لنتجهز لهجوم آخر
Dialogue: 0,0:23:49.56,0:23:50.78,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:23:51.20,0:23:54.46,Default,,0000,0000,0000,,!"انتظروا! تلك ليست "إيتو"، بل "كودو
Dialogue: 0,0:23:54.46,0:23:56.05,Default,,0000,0000,0000,,!إنّه منزلي
Dialogue: 0,0:23:56.05,0:23:58.21,Default,,0000,0000,0000,,!هيّا بنا أيّها القرويَ
Dialogue: 0,0:24:06.87,0:24:08.20,Default,,0000,0000,0000,,!إنّه ميت
Dialogue: 0,0:24:08.20,0:24:09.74,Default,,0000,0000,0000,,يجب الاتصال بالشرطة
Dialogue: 0,0:24:10.74,0:24:13.69,Default,,0000,0000,0000,,هذه... السكّين التي اُستعملت في التصوير
Dialogue: 0,0:24:14.32,0:24:18.20,Default,,0000,0000,0000,,مما يعني أنّ القاتل أحد العمّال
Dialogue: 0,0:24:18.20,0:24:20.65,Default,,0000,0000,0000,,!فهمت! هكذا إذاً
Dialogue: 0,0:24:20.65,0:24:23.69,Default,,0000,0000,0000,,!عرفت حقيقة هذه القضية
Dialogue: 0,0:24:24.47,0:24:25.72,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.72,0:24:28.56,Default,,0000,0000,0000,,جريمة قتل الدراما التلفزية
Dialogue: 0,0:24:45.79,0:24:48.29,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.29,0:24:49.81,Default,,0000,0000,0000,,كلب أسد
Dialogue: 0,0:24:49.81,0:24:51.81,Default,,0000,0000,0000,,

