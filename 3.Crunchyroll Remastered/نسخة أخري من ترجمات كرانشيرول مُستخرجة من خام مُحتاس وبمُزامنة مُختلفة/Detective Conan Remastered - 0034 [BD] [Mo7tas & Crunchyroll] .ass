Dialogue: 0,0:00:01.37,0:00:04.82,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:05.02,0:00:06.50,Default,,0000,0000,0000,,!قضيّة اليوم غموض منزل جبلي
Dialogue: 0,0:00:06.70,0:00:08.49,Default,,0000,0000,0000,,من هو رجل الضماد الغامض؟
Dialogue: 0,0:00:09.28,0:00:10.95,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.15,0:00:13.17,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.37,0:00:15.47,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.89,0:01:51.97,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل رجل ضماد السّكن الجبلي\N(الجزء الأوّل)
Dialogue: 0,0:01:46.62,0:01:51.55,Default,,0000,0000,0000,,
Dialogue: 0,0:01:52.90,0:01:56.60,Default,,0000,0000,0000,,...ماذا؟ غريب
Dialogue: 0,0:01:57.04,0:02:00.31,Default,,0000,0000,0000,,...يُفترض أن يكون السّكن في هذه الأرجاء
Dialogue: 0,0:02:00.73,0:02:04.12,Default,,0000,0000,0000,,أيمكن أنّنا ضللنا طريقنا؟
Dialogue: 0,0:02:04.32,0:02:07.31,Default,,0000,0000,0000,,!بـ... بالطبع لا
Dialogue: 0,0:02:07.51,0:02:09.71,Default,,0000,0000,0000,,نسلك طريقاً التفافيّاً فحسب
Dialogue: 0,0:02:09.91,0:02:11.10,Default,,0000,0000,0000,,ضللنا
Dialogue: 0,0:02:16.41,0:02:20.22,Default,,0000,0000,0000,,!وصلنا! انظر يا كونان-كن، ذاك هو
Dialogue: 0,0:02:20.63,0:02:22.18,Default,,0000,0000,0000,,...ماذا؟ أحدهم يمشي
Dialogue: 0,0:02:23.26,0:02:25.30,Default,,0000,0000,0000,,أتساءل لو سيذهب للمنزل أيضاً؟
Dialogue: 0,0:02:34.18,0:02:36.33,Default,,0000,0000,0000,,أ-أتساءل لو سيذهب للمنزل أيضاً؟
Dialogue: 0,0:02:36.53,0:02:38.64,Default,,0000,0000,0000,,...لا-لا أظنّ
Dialogue: 0,0:02:39.09,0:02:41.60,Default,,0000,0000,0000,,تأخّرتِ يا ران! ماذا كنتِ تفعلين؟
Dialogue: 0,0:02:42.19,0:02:43.52,Default,,0000,0000,0000,,!آسفة يا سونوكو
Dialogue: 0,0:02:43.72,0:02:48.56,Default,,0000,0000,0000,,كنتُ لطيفة بما يكفي لدعوتكِ لمنزل \Nعائلتي الجبليّ وتصلين متأخّرة
Dialogue: 0,0:02:48.76,0:02:51.04,Default,,0000,0000,0000,,جلبته معك بالفعل
Dialogue: 0,0:02:51.24,0:02:53.76,Default,,0000,0000,0000,,أظهر بعض المراعاة يا كونان-كن
Dialogue: 0,0:02:55.05,0:02:56.72,Default,,0000,0000,0000,,كأنّك أهلٌ لقول ذلك
Dialogue: 0,0:02:56.92,0:03:00.32,Default,,0000,0000,0000,,بوجود هذا الصغير حولنا\Nلن نقع في الحُب أبداً
Dialogue: 0,0:03:00.69,0:03:01.68,Default,,0000,0000,0000,,الحُب؟
Dialogue: 0,0:03:02.04,0:03:07.12,Default,,0000,0000,0000,,أجل، نحن هنا للقاء شبّان رائعين\N ،وبالطبيعة تحيطنا
Dialogue: 0,0:03:07.32,0:03:13.13,Default,,0000,0000,0000,,!سنعيش تجارب عاطفية كالأحلام معهم
Dialogue: 0,0:03:13.39,0:03:17.10,Default,,0000,0000,0000,,...صحيح، إنّها من هذا الصنف
Dialogue: 0,0:03:18.22,0:03:21.92,Default,,0000,0000,0000,,ماذا؟ لم يأت "الشبّان الرائعون" بعد؟
Dialogue: 0,0:03:22.23,0:03:23.72,Default,,0000,0000,0000,,ما الذي تقولينه؟
Dialogue: 0,0:03:23.72,0:03:28.56,Default,,0000,0000,0000,,وصل أصدقاء أختي منذ فترة \Nوهم يستريحون في غرفهم الآن
Dialogue: 0,0:03:29.20,0:03:34.01,Default,,0000,0000,0000,,تذكّرت، أبينهم شخصٌ وجهه ملفوف بالضماد؟
Dialogue: 0,0:03:34.38,0:03:38.72,Default,,0000,0000,0000,,ضماد؟ كلا، لا أحد من القادمين مُصاب
Dialogue: 0,0:03:39.18,0:03:40.54,Default,,0000,0000,0000,,...لكنّنا رأينا قبل قليل
Dialogue: 0,0:03:41.00,0:03:43.18,Default,,0000,0000,0000,,...ربما يعيش بالقرب إذاً
Dialogue: 0,0:03:43.41,0:03:46.81,Default,,0000,0000,0000,,دعيك من الكلام الغريب وأفرغي أمتعتك
Dialogue: 0,0:03:47.01,0:03:49.19,Default,,0000,0000,0000,,غرفتكما في الأعلى
Dialogue: 0,0:03:49.39,0:03:50.61,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:03:53.96,0:03:57.83,Default,,0000,0000,0000,,لحظة، توجد غرف كثيرة هنا
Dialogue: 0,0:03:58.03,0:04:01.50,Default,,0000,0000,0000,,أيّ واحدة... هي غرفتنا؟
Dialogue: 0,0:04:02.97,0:04:05.32,Default,,0000,0000,0000,,!آ-آسفة! أخطأت
Dialogue: 0,0:04:14.68,0:04:17.14,Default,,0000,0000,0000,,!ها هي! يبدو أنّ هذه غرفتنا يا كونان-كن
Dialogue: 0,0:04:17.80,0:04:21.36,Default,,0000,0000,0000,,يا إلهي، تعلّمي قرع الباب قبل الفتح
Dialogue: 0,0:04:29.04,0:04:31.33,Default,,0000,0000,0000,,كلّكم من نفس المجموعة إذاً؟
Dialogue: 0,0:04:31.53,0:04:35.26,Default,,0000,0000,0000,,أجل، جميعهم صوّروا أفلام معاً\Nأثناء دراسة أختي في الجامعة
Dialogue: 0,0:04:35.59,0:04:39.13,Default,,0000,0000,0000,,اجتمع الأشخاص الخمسة المقرّبون\Nلأوّل مرّة منذ عامين
Dialogue: 0,0:04:39.33,0:04:43.82,On Top,,0000,0000,0000,,حسناً... من بجانب ران هو أوتا-سان\Nالذي كان يلعب دور البطل عادةً
Dialogue: 0,0:04:41.39,0:04:44.93,CharCard,,0000,0000,0000,,(أوتا ماسارو (24\Nسمسار سيّارات أجنبية
Dialogue: 0,0:04:44.02,0:04:44.93,On Top,,0000,0000,0000,,مرحباً
Dialogue: 0,0:04:45.11,0:04:48.32,On Top,,0000,0000,0000,,وبجواره سوميا-سان الذي كان المصوّر
Dialogue: 0,0:04:45.85,0:04:49.39,CharCard,,0000,0000,0000,,(سوميا هيروكي (25\Nمحرّر صحيفة أفلام
Dialogue: 0,0:04:48.52,0:04:49.24,On Top,,0000,0000,0000,,كيف الحال؟
Dialogue: 0,0:04:49.39,0:04:51.64,On Top,,0000,0000,0000,,ومدير المسرح تاكاهاشي-سان
Dialogue: 0,0:04:50.35,0:04:53.09,CharCard,,0000,0000,0000,,(تاكاهاشي ريويتشي (25\Nموظّف شركة غذاء
Dialogue: 0,0:04:51.83,0:04:53.09,On Top,,0000,0000,0000,,مـ-مرحباً
Dialogue: 0,0:04:53.57,0:04:55.59,Default,,0000,0000,0000,,أعتذر عمَّ فعلت قبل قليل
Dialogue: 0,0:04:55.79,0:04:56.80,Default,,0000,0000,0000,,لا مشكلة
Dialogue: 0,0:04:56.98,0:04:58.70,Default,,0000,0000,0000,,ماذا؟ ما الذي فعلته؟
Dialogue: 0,0:04:59.50,0:05:00.74,Default,,0000,0000,0000,,...لا شيء مهم
Dialogue: 0,0:05:01.79,0:05:05.84,On Top,,0000,0000,0000,,حسنٌ، التالية هي مسؤولة المكياج والثياب
Dialogue: 0,0:05:04.80,0:05:10.60,CharCard,,0000,0000,0000,,(سوزوكي أياكو (24\Nطالبة دراسات عليا
Dialogue: 0,0:05:06.04,0:05:09.39,On Top,,0000,0000,0000,,والتي تبحث عن زوجٍ حالياً، أختي الكبرى
Dialogue: 0,0:05:09.59,0:05:10.60,On Top,,0000,0000,0000,,يكفي هذا
Dialogue: 0,0:05:10.79,0:05:14.47,On Top,,0000,0000,0000,,والأخيرة هي المخرجة وكاتبة النصّ ورئيسة النادي
Dialogue: 0,0:05:11.52,0:05:17.56,CharCard,,0000,0000,0000,,(إيكيدا تشيكاكو (24\Nكاتبة سيناريو
Dialogue: 0,0:05:14.67,0:05:16.21,On Top,,0000,0000,0000,,إيكيدا تشيكاكو-سان
Dialogue: 0,0:05:16.41,0:05:17.56,On Top,,0000,0000,0000,,سُررت بلقائك
Dialogue: 0,0:05:18.73,0:05:23.01,Default,,0000,0000,0000,,إيكيدا تشيكاكو-سان نفسها التي كتبت \Nفيلم "المملكة الزرقاء" الأخير؟
Dialogue: 0,0:05:23.16,0:05:23.92,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:05:24.12,0:05:28.86,Default,,0000,0000,0000,,كتبته أثناء دراستها، وكان عملها الرسميّ الأوّل، صحيح؟
Dialogue: 0,0:05:29.06,0:05:31.23,Default,,0000,0000,0000,,توقفي عن قصّ حكايا الماضي
Dialogue: 0,0:05:31.39,0:05:34.86,Default,,0000,0000,0000,,هناك شائعات عن فيلمٍ قادم لك
Dialogue: 0,0:05:35.39,0:05:38.68,Default,,0000,0000,0000,,إذاً يا إيكيدا سينسي، ألديكِ كلمة لمعجبيك؟
Dialogue: 0,0:05:38.98,0:05:41.14,Default,,0000,0000,0000,,توقّف عن التصرف بسخافة يا سوميا-كن
Dialogue: 0,0:05:41.60,0:05:44.98,Default,,0000,0000,0000,,لا تزال الكاميرا ملتصقةً بيدك
Dialogue: 0,0:05:45.18,0:05:47.41,Default,,0000,0000,0000,,أجل، لا يمكنني التوقف عن التصوير
Dialogue: 0,0:05:47.60,0:05:51.25,Default,,0000,0000,0000,,بالمناسبة يا تاكاهاشي، هل أصحبت أبدن؟
Dialogue: 0,0:05:51.56,0:05:54.49,Default,,0000,0000,0000,,ماذا؟ لعلّي أزن 100 كيلو الآن
Dialogue: 0,0:05:54.69,0:05:56.53,Default,,0000,0000,0000,,لا تتسع في إطار الكاميرا حتّى
Dialogue: 0,0:05:57.46,0:05:58.35,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:06:00.01,0:06:03.72,Default,,0000,0000,0000,,وجودي معكم يعيد لي ذكريات الجامعة حقاً
Dialogue: 0,0:06:04.74,0:06:05.80,Default,,0000,0000,0000,,...وذكريات أتسوكو
Dialogue: 0,0:06:06.33,0:06:09.59,Default,,0000,0000,0000,,...كانت لتكون هنا حتماً لو لم يحصل ذلك
Dialogue: 0,0:06:12.85,0:06:13.59,Default,,0000,0000,0000,,أتسوكو؟
Dialogue: 0,0:06:14.73,0:06:16.80,Default,,0000,0000,0000,,!لنمتنع عن ذكرها
Dialogue: 0,0:06:17.75,0:06:18.76,Default,,0000,0000,0000,,...تشيكاكو
Dialogue: 0,0:06:22.05,0:06:25.27,Default,,0000,0000,0000,,اقتطعتُ وقتاً من أشغالي للقدوم هنا
Dialogue: 0,0:06:25.67,0:06:28.28,Default,,0000,0000,0000,,لا تتكلّمي عن شخص مات قبل عامين
Dialogue: 0,0:06:28.48,0:06:29.51,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:06:30.38,0:06:33.13,Default,,0000,0000,0000,,المشاهير يتكلمون بأسلوبٍ مختلف حقاً
Dialogue: 0,0:06:33.13,0:06:33.64,Default,,0000,0000,0000,,!ما قصدك؟
Dialogue: 0,0:06:33.64,0:06:35.18,Default,,0000,0000,0000,,!رويدكما
Dialogue: 0,0:06:35.98,0:06:39.48,Default,,0000,0000,0000,,سأعدّ العشاء فوراً، لذا اعتبروا أنفسكم في منازلكم
Dialogue: 0,0:06:39.95,0:06:42.88,Default,,0000,0000,0000,,سأذهب لإنهاء إصلاح السقف إذاً
Dialogue: 0,0:06:43.08,0:06:44.84,Default,,0000,0000,0000,,فيُقال أنّها ستُمطر هذا المساء
Dialogue: 0,0:06:45.04,0:06:48.64,Default,,0000,0000,0000,,أجل، أنا ممتنة لك يا تاكاهاشي-كن، توخّ الحذر
Dialogue: 0,0:06:48.64,0:06:49.29,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:50.73,0:06:54.14,Default,,0000,0000,0000,,هذا عملٌ يليق بمصمم المسرح حقّاً
Dialogue: 0,0:06:54.53,0:06:56.89,Default,,0000,0000,0000,,ما رأيك أن نلعب نحن الباقون بطاقات؟
Dialogue: 0,0:06:57.15,0:06:58.74,Default,,0000,0000,0000,,!أجل! سألعب
Dialogue: 0,0:06:59.87,0:07:01.84,Default,,0000,0000,0000,,أين تذهبين يا تشيكاكو؟
Dialogue: 0,0:07:02.04,0:07:04.15,Default,,0000,0000,0000,,للتنزه
Dialogue: 0,0:07:06.41,0:07:07.78,Default,,0000,0000,0000,,!انتظري يا تشيكاكو
Dialogue: 0,0:07:09.59,0:07:11.84,Default,,0000,0000,0000,,قال تاكاهاشي أنّها ستُمطر
Dialogue: 0,0:07:12.70,0:07:14.58,Default,,0000,0000,0000,,!أنت، تشيكاكو
Dialogue: 0,0:07:26.85,0:07:28.54,Default,,0000,0000,0000,,إنّه يهطل بغزارة
Dialogue: 0,0:07:28.74,0:07:31.35,Default,,0000,0000,0000,,لن نستطيع الاستمتاع بالمنظر الآن
Dialogue: 0,0:07:31.83,0:07:33.14,Default,,0000,0000,0000,,ران
Dialogue: 0,0:07:33.60,0:07:35.80,Default,,0000,0000,0000,,ألا تجدينه مناسباً؟
Dialogue: 0,0:07:36.29,0:07:40.77,Default,,0000,0000,0000,,!يبدو رائعاً وواثقاً، إنّه صنفي تماماً
Dialogue: 0,0:07:41.07,0:07:42.34,Default,,0000,0000,0000,,حقاً؟
Dialogue: 0,0:07:42.91,0:07:46.47,Default,,0000,0000,0000,,نسيت، لديك شينتشي-كن، صحيح؟
Dialogue: 0,0:07:46.74,0:07:48.93,Default,,0000,0000,0000,,من المؤسف أنّه لم يأت معك
Dialogue: 0,0:07:49.24,0:07:52.63,Default,,0000,0000,0000,,!من يهتمّ له؟ كنت سأبرحه ضرباً لو كان هنا
Dialogue: 0,0:07:52.82,0:07:54.50,Default,,0000,0000,0000,,لكنّه هنا
Dialogue: 0,0:07:54.70,0:07:55.76,Default,,0000,0000,0000,,أخبريني، ما رأيك أن ترافقيني في نزهة؟
Dialogue: 0,0:07:56.76,0:07:58.72,Default,,0000,0000,0000,,!يـ-يسرّني ذلك
Dialogue: 0,0:07:59.17,0:08:00.87,Default,,0000,0000,0000,,فلا شيء لديك لتفعليه
Dialogue: 0,0:08:03.13,0:08:05.01,Default,,0000,0000,0000,,لكن المطر يهطل خارجاً
Dialogue: 0,0:08:05.21,0:08:07.65,Default,,0000,0000,0000,,المشي في المطر يبعث الحيوية
Dialogue: 0,0:08:08.74,0:08:12.24,Default,,0000,0000,0000,,!هيّا بنا
Dialogue: 0,0:08:12.76,0:08:14.09,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:08:15.75,0:08:17.19,Default,,0000,0000,0000,,!ذ-ذاك الوغد
Dialogue: 0,0:08:17.39,0:08:18.72,Default,,0000,0000,0000,,!لن أسامحك
Dialogue: 0,0:08:27.51,0:08:31.09,Default,,0000,0000,0000,,!ران تلك لديها شينتشي-كن
Dialogue: 0,0:08:31.29,0:08:32.31,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:08:32.51,0:08:34.43,Default,,0000,0000,0000,,!ربما سأسرق شينتشي-كن منها
Dialogue: 0,0:08:34.63,0:08:36.10,Default,,0000,0000,0000,,كلا، لن تفعلي
Dialogue: 0,0:08:36.30,0:08:38.57,Default,,0000,0000,0000,,حقاً؟ لديكِ شخص يعجبك؟
Dialogue: 0,0:08:39.07,0:08:39.97,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:39.97,0:08:42.92,Default,,0000,0000,0000,,لكن لا تعرفين متى قد يعود، صحيح؟
Dialogue: 0,0:08:43.12,0:08:45.41,Default,,0000,0000,0000,,عليكِ هجر بارد الإحساس ذاك
Dialogue: 0,0:08:45.61,0:08:48.25,Default,,0000,0000,0000,,والعثور على شابٍ جديد
Dialogue: 0,0:08:48.65,0:08:51.23,Default,,0000,0000,0000,,...ما رأيك بأن أعلّمك
Dialogue: 0,0:08:52.23,0:08:54.68,Default,,0000,0000,0000,,كيف هو حُبّ البالغين؟
Dialogue: 0,0:08:56.20,0:08:57.31,Default,,0000,0000,0000,,...انتظـ
Dialogue: 0,0:09:01.04,0:09:02.13,Default,,0000,0000,0000,,!رعد
Dialogue: 0,0:09:02.13,0:09:03.18,Default,,0000,0000,0000,,!انتظري
Dialogue: 0,0:09:07.94,0:09:11.30,Default,,0000,0000,0000,,أخافني ذلك، كانت الصاعقة قريبة
Dialogue: 0,0:09:12.02,0:09:13.93,Default,,0000,0000,0000,,!تبّاً! اختفيا
Dialogue: 0,0:09:15.76,0:09:17.46,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:09:17.66,0:09:18.78,Default,,0000,0000,0000,,يا إلهي
Dialogue: 0,0:09:20.58,0:09:23.63,Default,,0000,0000,0000,,...ربما ضللت الطريق
Dialogue: 0,0:09:28.10,0:09:29.76,Default,,0000,0000,0000,,أين أنت يا أوتا-سان؟
Dialogue: 0,0:09:30.21,0:09:32.55,Default,,0000,0000,0000,,!أجبني إن كنت موجوداً! أوتا-سان
Dialogue: 0,0:09:42.24,0:09:42.93,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:09:52.77,0:09:53.69,Default,,0000,0000,0000,,...إنّه
Dialogue: 0,0:09:53.89,0:09:56.61,Default,,0000,0000,0000,,...ما الخطب يا ران
Dialogue: 0,0:09:58.42,0:09:59.55,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:10:00.24,0:10:02.01,Default,,0000,0000,0000,,!من كان ذاك الشخص؟
Dialogue: 0,0:10:02.71,0:10:04.47,Default,,0000,0000,0000,,رجل بضماد؟
Dialogue: 0,0:10:04.67,0:10:07.41,Default,,0000,0000,0000,,!أجل! هاجم ران في الغابة
Dialogue: 0,0:10:07.61,0:10:08.93,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:10:09.13,0:10:11.57,Default,,0000,0000,0000,,ماذا؟ لم يره أحدكم؟
Dialogue: 0,0:10:11.77,0:10:14.14,Default,,0000,0000,0000,,ألم تكونوا الثلاثة في الغابة؟
Dialogue: 0,0:10:14.73,0:10:17.88,Default,,0000,0000,0000,,لم أره، ذهبت للبحث عن ران-تشان بعدما انفصلت عنّي
Dialogue: 0,0:10:18.08,0:10:20.03,Default,,0000,0000,0000,,ولم يكن هناك شيء كذاك
Dialogue: 0,0:10:20.23,0:10:22.38,Default,,0000,0000,0000,,لم نره نحن أيضاً، صحيح يا تشيكاكو؟
Dialogue: 0,0:10:22.57,0:10:26.07,Default,,0000,0000,0000,,نحن؟ اختفيتَ وحدك
Dialogue: 0,0:10:26.27,0:10:29.68,Default,,0000,0000,0000,,!كنتُ قد ذهبت لجلب مظلّة
Dialogue: 0,0:10:29.88,0:10:32.00,Default,,0000,0000,0000,,لم يخفك الرعد ورجعت هارباً؟
Dialogue: 0,0:10:32.20,0:10:33.22,Default,,0000,0000,0000,,!تشيكاكو
Dialogue: 0,0:10:33.22,0:10:33.95,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:34.15,0:10:36.10,Default,,0000,0000,0000,,!رويدكما
Dialogue: 0,0:10:37.46,0:10:40.30,Default,,0000,0000,0000,,...ربما اقتربت نهايتهما
Dialogue: 0,0:10:40.50,0:10:43.27,Default,,0000,0000,0000,,لم تري الرجل يا أختي؟
Dialogue: 0,0:10:43.47,0:10:45.78,Default,,0000,0000,0000,,ركض نحو المنزل
Dialogue: 0,0:10:45.98,0:10:48.04,Default,,0000,0000,0000,,كلا، لم أرَ أحداً
Dialogue: 0,0:10:48.24,0:10:49.77,Default,,0000,0000,0000,,هل رأيته يا تاكاهاشي-كن؟
Dialogue: 0,0:10:50.08,0:10:52.22,Default,,0000,0000,0000,,كنتُ فوق السقف طوال الوقت
Dialogue: 0,0:10:52.42,0:10:54.84,Default,,0000,0000,0000,,ولا أتذكر رؤية شخصٍ كذاك
Dialogue: 0,0:10:55.04,0:10:58.22,Default,,0000,0000,0000,,لكنّي رأيت شخصاً غريباً قرب الجسر
Dialogue: 0,0:10:58.42,0:11:02.19,Default,,0000,0000,0000,,عندما وصلتُ هنا
Dialogue: 0,0:11:02.86,0:11:04.51,Default,,0000,0000,0000,,لم أرَ وجهه بوضوح
Dialogue: 0,0:11:04.71,0:11:08.47,Default,,0000,0000,0000,,لكن كان يرتدي معطفاً أسود وقلنسوة
Dialogue: 0,0:11:09.43,0:11:12.82,Default,,0000,0000,0000,,!أجل! ذاك هو الرجل الذي هاجمني
Dialogue: 0,0:11:13.02,0:11:13.97,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:11:13.97,0:11:14.43,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:14.77,0:11:18.04,Default,,0000,0000,0000,,رأيتُ ذاك الشخص عندما وصلت أيضاً
Dialogue: 0,0:11:18.24,0:11:21.38,Default,,0000,0000,0000,,وأنا، لكنّني ظننته يعيش في الجوار
Dialogue: 0,0:11:21.73,0:11:22.98,Default,,0000,0000,0000,,!هذا مستحيل
Dialogue: 0,0:11:23.18,0:11:27.25,Default,,0000,0000,0000,,فلا يوجد سوى منزلين أو ثلاث على الجانب \Nالآخر البعيد من الجسر
Dialogue: 0,0:11:27.45,0:11:29.85,Default,,0000,0000,0000,,وهنا جبل يحجز الطريق
Dialogue: 0,0:11:30.21,0:11:32.20,Default,,0000,0000,0000,,!من كان ذاك الرجل إذاً؟
Dialogue: 0,0:11:32.40,0:11:33.97,Default,,0000,0000,0000,,!لنتّصل بالشرطة بأيّ حال
Dialogue: 0,0:11:33.97,0:11:34.95,Default,,0000,0000,0000,,!أ-أجل
Dialogue: 0,0:11:39.95,0:11:41.78,Default,,0000,0000,0000,,!ماذا؟ لا يعمل الهاتف؟
Dialogue: 0,0:11:41.98,0:11:44.92,Default,,0000,0000,0000,,أجل، مع أنّه كان يعمل ظهيرة اليوم
Dialogue: 0,0:11:45.12,0:11:47.93,Default,,0000,0000,0000,,ربما قطعت الصاعقة الأخيرة خطوط الهاتف
Dialogue: 0,0:11:48.13,0:11:52.49,Default,,0000,0000,0000,,!كان هو! رجل الضماد ذاك هو من قطع الخطّ
Dialogue: 0,0:11:52.69,0:11:54.58,Default,,0000,0000,0000,,!كان هو! كان هو
Dialogue: 0,0:11:56.33,0:11:57.93,Default,,0000,0000,0000,,!تاكاهاشي
Dialogue: 0,0:11:58.13,0:11:59.29,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:12:03.22,0:12:04.95,Default,,0000,0000,0000,,!ما الأمر؟ ماذا هناك؟
Dialogue: 0,0:12:10.89,0:12:12.37,Default,,0000,0000,0000,,!سقط الجسر
Dialogue: 0,0:12:17.80,0:12:18.86,Default,,0000,0000,0000,,ماذا حصل؟
Dialogue: 0,0:12:19.06,0:12:20.36,Default,,0000,0000,0000,,سقط الجسر
Dialogue: 0,0:12:21.16,0:12:24.00,Default,,0000,0000,0000,,ربما سقط من تلقاء نفسه، فقد كان قديماً
Dialogue: 0,0:12:24.20,0:12:25.26,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:12:25.94,0:12:27.89,Default,,0000,0000,0000,,قطعه أحدهم
Dialogue: 0,0:12:28.30,0:12:32.13,Default,,0000,0000,0000,,انظر لعمادة الجسر هذه
Dialogue: 0,0:12:32.88,0:12:35.59,Default,,0000,0000,0000,,!ما هذا؟! تملأها آثار القطع
Dialogue: 0,0:12:36.17,0:12:38.91,Default,,0000,0000,0000,,...فهمت، استعمل أحدهم شفرةً
Dialogue: 0,0:12:39.11,0:12:41.54,Default,,0000,0000,0000,,لكن من فعل ذلك؟
Dialogue: 0,0:12:41.74,0:12:44.51,Default,,0000,0000,0000,,!إنّه هو! هذا من فعله أيضاً
Dialogue: 0,0:12:44.88,0:12:45.92,Default,,0000,0000,0000,,!يكفي هذا
Dialogue: 0,0:12:46.12,0:12:48.35,Default,,0000,0000,0000,,ما هراء رجل الضماد هذا؟
Dialogue: 0,0:12:49.05,0:12:55.80,Default,,0000,0000,0000,,هاجم فتاةً في الغابة وقطع خطّ الهاتف وأسقط \Nالجسر كي يستمتع برؤية الخوف على وجوهنا
Dialogue: 0,0:12:56.33,0:13:00.03,Default,,0000,0000,0000,,إن تركنا الخوف يتسلّل لنا أكثر\N سنعطيه ما يريد تماماً
Dialogue: 0,0:13:02.83,0:13:03.92,Default,,0000,0000,0000,,...تشيكاكو
Dialogue: 0,0:13:04.77,0:13:06.68,Default,,0000,0000,0000,,بأيّ حال، خيّم الظلام الآن
Dialogue: 0,0:13:06.84,0:13:09.89,Default,,0000,0000,0000,,فلا أمامنا سوى الانتظار للصباح للمغادرة
Dialogue: 0,0:13:10.84,0:13:16.39,Default,,0000,0000,0000,,كما أنّ رجل الضماد الذي يشغلكم \Nهذا لا يزال مُختبئاً في الغابة غالباً
Dialogue: 0,0:13:16.59,0:13:17.47,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:17.47,0:13:18.35,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:25.74,0:13:26.72,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:13:27.90,0:13:32.68,Default,,0000,0000,0000,,سأخلد للنوم الآن، فأشعر بالإرهاق \Nفجأةً، لا أحتاج عشاءً
Dialogue: 0,0:13:33.57,0:13:34.64,Default,,0000,0000,0000,,...تشيكاكو
Dialogue: 0,0:13:44.36,0:13:47.01,Default,,0000,0000,0000,,أعتذر على جعلك تساعدينني يا ران-تشان
Dialogue: 0,0:13:47.38,0:13:49.60,Default,,0000,0000,0000,,لا مشكلة، أقوم بهذا في منزلنا دوماً
Dialogue: 0,0:13:50.02,0:13:53.00,Default,,0000,0000,0000,,انقلب حال لمّ الشمل هذا تماماً
Dialogue: 0,0:13:53.20,0:13:55.55,Default,,0000,0000,0000,,أصبح الجميع متضايقين
Dialogue: 0,0:13:55.94,0:13:59.08,Default,,0000,0000,0000,,هذا لأنّك ذكرتِ أمرها
Dialogue: 0,0:13:59.28,0:14:01.38,Default,,0000,0000,0000,,تقصدين أتسوكو-سان؟
Dialogue: 0,0:14:02.49,0:14:04.99,Default,,0000,0000,0000,,الفتاة التي حصل لها شيءٌ ما قبل عامين
Dialogue: 0,0:14:05.19,0:14:06.35,Default,,0000,0000,0000,,!يكفي يا كونان-كن
Dialogue: 0,0:14:07.28,0:14:10.81,Default,,0000,0000,0000,,انتحرت أتسوكو، قبل عامين
Dialogue: 0,0:14:11.59,0:14:14.26,Default,,0000,0000,0000,,كانت من فريق إنتاج الأفلام أيضاً
Dialogue: 0,0:14:15.02,0:14:17.75,Default,,0000,0000,0000,,لكنّها شنقت نفسها فجأةً في غرفتها
Dialogue: 0,0:14:17.95,0:14:20.19,Default,,0000,0000,0000,,وتوقّف الجميع عن الاجتماع بعدها
Dialogue: 0,0:14:20.71,0:14:22.72,Default,,0000,0000,0000,,مع أنّنا كنّا مقرّبين جداً
Dialogue: 0,0:14:23.70,0:14:29.02,Default,,0000,0000,0000,,لذا طلبتُ منهم القدوم هنا \Nللمّ شمل بعد انقطاع طويل
Dialogue: 0,0:14:29.22,0:14:32.38,Default,,0000,0000,0000,,لذا لنكفّ عن ذكر الموضوع، اتّفقنا يا كونان-كن؟
Dialogue: 0,0:14:32.38,0:14:33.18,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:14:33.63,0:14:35.64,Default,,0000,0000,0000,,أتضوّر جوعاً
Dialogue: 0,0:14:36.28,0:14:37.58,Default,,0000,0000,0000,,ماذا؟ أين تشيكاكو؟
Dialogue: 0,0:14:37.78,0:14:39.60,Default,,0000,0000,0000,,قالت أنّها مرهقة وستنام
Dialogue: 0,0:14:40.11,0:14:42.31,Default,,0000,0000,0000,,!تاكاهاشي-كن! العشاء جاهز
Dialogue: 0,0:14:42.51,0:14:44.30,Default,,0000,0000,0000,,سآتي قريباً
Dialogue: 0,0:14:44.54,0:14:46.15,Default,,0000,0000,0000,,كيف الأمر؟ هل أصلحت السقف؟
Dialogue: 0,0:14:46.35,0:14:47.76,Default,,0000,0000,0000,,أجل، تقريباً
Dialogue: 0,0:14:48.13,0:14:50.22,Default,,0000,0000,0000,,!حسناً، ابتسما
Dialogue: 0,0:14:52.57,0:14:55.58,Default,,0000,0000,0000,,!انزل بسرعة يا تاكاهاشي! سيبرد الطعام
Dialogue: 0,0:14:55.78,0:14:57.30,Default,,0000,0000,0000,,حسناً، قادم الآن
Dialogue: 0,0:14:58.63,0:15:00.39,Default,,0000,0000,0000,,!مـ-من أنت؟
Dialogue: 0,0:15:00.39,0:15:00.98,Default,,0000,0000,0000,,!ما الخطب؟
Dialogue: 0,0:15:01.38,0:15:03.55,Default,,0000,0000,0000,,!يوجد شخصٌ عند نافذة الطابق السفليّ
Dialogue: 0,0:15:04.23,0:15:05.51,Default,,0000,0000,0000,,عند النافذة؟
Dialogue: 0,0:15:12.33,0:15:13.36,Default,,0000,0000,0000,,!تشيكاكو
Dialogue: 0,0:15:13.86,0:15:16.85,Default,,0000,0000,0000,,!تبّاً! لا يمكننا رؤية أين ذهبا في الظلام
Dialogue: 0,0:15:18.32,0:15:19.10,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:15:21.10,0:15:23.34,Default,,0000,0000,0000,,!حسنٌ! لنتبع الصبيّ
Dialogue: 0,0:15:23.94,0:15:25.80,Default,,0000,0000,0000,,!لتنتظر الفتيات هنا وتقفلن الأبواب
Dialogue: 0,0:15:26.20,0:15:27.26,Default,,0000,0000,0000,,!أسرع يا تاكاهاشي
Dialogue: 0,0:15:27.26,0:15:28.13,Default,,0000,0000,0000,,!ماذا؟ أنا أيضاً؟
Dialogue: 0,0:15:28.33,0:15:29.49,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:15:36.18,0:15:38.64,Default,,0000,0000,0000,,!ا-انتظروني
Dialogue: 0,0:15:40.30,0:15:41.55,Default,,0000,0000,0000,,!إنّها ساق
Dialogue: 0,0:15:41.96,0:15:44.07,Default,,0000,0000,0000,,!أ-أيمكن أنّها لتشيكاكو؟
Dialogue: 0,0:15:46.37,0:15:47.85,Default,,0000,0000,0000,,!توجد ذراع هنا
Dialogue: 0,0:15:48.80,0:15:50.20,Default,,0000,0000,0000,,يا للهول
Dialogue: 0,0:15:50.40,0:15:52.50,Default,,0000,0000,0000,,!لننفصل ونبحث عنها
Dialogue: 0,0:15:52.70,0:15:55.01,Default,,0000,0000,0000,,!تشيكاكو! تشيكاكو
Dialogue: 0,0:15:55.88,0:15:57.59,Default,,0000,0000,0000,,!أين أنت يا تشيكاكو؟
Dialogue: 0,0:16:03.81,0:16:05.22,Default,,0000,0000,0000,,تشيكاكو؟
Dialogue: 0,0:16:07.69,0:16:09.64,Default,,0000,0000,0000,,!تشيكاكو! تماسكي! تشيكاكو
Dialogue: 0,0:16:17.29,0:16:19.14,Default,,0000,0000,0000,,!تشيكاكو؟
Dialogue: 0,0:16:19.52,0:16:21.59,Default,,0000,0000,0000,,...أجل، قُتلت
Dialogue: 0,0:16:22.46,0:16:24.19,Default,,0000,0000,0000,,مع وقت وصولنا
Dialogue: 0,0:16:24.78,0:16:26.20,Default,,0000,0000,0000,,...لا-لا يمكن
Dialogue: 0,0:16:26.59,0:16:29.85,Default,,0000,0000,0000,,غطّينا الجثة بمعطفي للوقت الراهن وتركناها في الغابة
Dialogue: 0,0:16:30.51,0:16:32.26,Default,,0000,0000,0000,,لمَ قد يقتل أحدهم تشيكاكو-سان؟
Dialogue: 0,0:16:32.49,0:16:34.46,Default,,0000,0000,0000,,!إنّها غلطتي
Dialogue: 0,0:16:34.66,0:16:37.42,Default,,0000,0000,0000,,...لو لم أخطط للقاء لمّ الشمل هذا
Dialogue: 0,0:16:38.08,0:16:39.72,Default,,0000,0000,0000,,...لما حصل
Dialogue: 0,0:16:40.46,0:16:43.44,Default,,0000,0000,0000,,ليس صحيحاً يا أياكو، ليست غلطتك
Dialogue: 0,0:16:43.64,0:16:45.76,Default,,0000,0000,0000,,!إنّها غلطة رجل الضماد ذاك
Dialogue: 0,0:16:45.96,0:16:48.39,Default,,0000,0000,0000,,ذاك القاتل الذي هرب بتشيكاكو
Dialogue: 0,0:16:48.89,0:16:50.68,Default,,0000,0000,0000,,!أمام أنظارنا
Dialogue: 0,0:16:53.60,0:16:56.85,Default,,0000,0000,0000,,ماذا نفعل لو هاجمنا مُجدداً؟
Dialogue: 0,0:16:58.06,0:17:00.67,Default,,0000,0000,0000,,سنكون بخير طالما نقفل المكان
Dialogue: 0,0:17:00.87,0:17:04.80,Default,,0000,0000,0000,,فقد أهملت تشيكاكو بتجوّلها خارجاً\Nفي هذا الوقت المتأخّر
Dialogue: 0,0:17:05.26,0:17:09.10,Default,,0000,0000,0000,,بأيّ حال، لننسَ الموضوع سريعاً ونخلد للنوم
Dialogue: 0,0:17:09.30,0:17:10.46,Default,,0000,0000,0000,,...أوتا، كيف لك
Dialogue: 0,0:17:10.66,0:17:12.76,Default,,0000,0000,0000,,صحيح، تأخّر الوقت
Dialogue: 0,0:17:13.40,0:17:16.57,Default,,0000,0000,0000,,لنتحقق من إقفال كلّ شيء مُجدداً وننم
Dialogue: 0,0:17:17.10,0:17:20.16,Default,,0000,0000,0000,,سننزل من الجبل صباحاً ونخبر الشرطة
Dialogue: 0,0:17:20.36,0:17:21.09,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:17:26.19,0:17:28.81,Default,,0000,0000,0000,,الباب الأمامي مُقفل
Dialogue: 0,0:17:29.01,0:17:31.01,Default,,0000,0000,0000,,تبقّت غرفنا فقط
Dialogue: 0,0:17:31.21,0:17:32.55,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:17:32.99,0:17:35.80,Default,,0000,0000,0000,,خُفّا تشيكاكو-سان ليسا هنا
Dialogue: 0,0:17:36.04,0:17:37.26,Default,,0000,0000,0000,,خُفّاها؟
Dialogue: 0,0:17:37.60,0:17:41.95,Default,,0000,0000,0000,,،إذا خرجت تشيكاكو-سان من الباب الأمامي\Nفيُفترض أنّ خُفيّها هنا
Dialogue: 0,0:17:42.15,0:17:45.22,Default,,0000,0000,0000,,ربما لم تغادر من هنا
Dialogue: 0,0:17:45.87,0:17:46.94,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:17:47.14,0:17:52.15,Default,,0000,0000,0000,,ماذا لو تسلل ذاك الرجل للمنزل وهاجم \Nتشيكاكو-سان النائمة في الطابق الثاني؟
Dialogue: 0,0:17:52.35,0:17:54.36,Default,,0000,0000,0000,,هذا مستحيل يا سونوكو
Dialogue: 0,0:17:54.56,0:17:57.51,Default,,0000,0000,0000,,أتذكرين؟ عندما لاحق كونان-كن والبقية ذاك الرجل
Dialogue: 0,0:17:57.71,0:18:02.17,Default,,0000,0000,0000,,انفصلتُ وأنت وأياكو-سان وتحققنا من كلّ الأقفال
Dialogue: 0,0:18:02.84,0:18:05.78,Default,,0000,0000,0000,,لم تكن هناك فوضى في غرفة تشيكاكو-سان
Dialogue: 0,0:18:05.98,0:18:08.75,Default,,0000,0000,0000,,والنافذة مغلقة من الداخل
Dialogue: 0,0:18:09.56,0:18:10.57,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:18:11.60,0:18:14.59,Default,,0000,0000,0000,,أنا متأكدٌ أنّها خرجت
Dialogue: 0,0:18:15.21,0:18:17.76,Default,,0000,0000,0000,,فقد كانت ترتدي حذاءً
Dialogue: 0,0:18:17.96,0:18:19.55,Default,,0000,0000,0000,,رغم أنّ ساقها قد قُطعت
Dialogue: 0,0:18:20.28,0:18:21.51,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:18:23.02,0:18:26.04,Default,,0000,0000,0000,,أخبريني، أتوجد مخارج أخرى لهذا المنزل؟
Dialogue: 0,0:18:26.24,0:18:28.31,Default,,0000,0000,0000,,أجل، الباب الخلفي
Dialogue: 0,0:18:28.31,0:18:28.97,Default,,0000,0000,0000,,الباب الخلفي؟
Dialogue: 0,0:18:30.32,0:18:31.67,Default,,0000,0000,0000,,هذا الباب الخلفي
Dialogue: 0,0:18:31.87,0:18:37.39,Default,,0000,0000,0000,,ها هما، خفّاها. إنّهما لتشيكاكو-سان بلا شك
Dialogue: 0,0:18:37.96,0:18:40.60,Default,,0000,0000,0000,,فلم يكن لدينا أزواج إضافية
Dialogue: 0,0:18:40.90,0:18:44.06,Default,,0000,0000,0000,,خرجت تشيكاكو-سان من هنا إذاً
Dialogue: 0,0:18:44.26,0:18:45.55,Default,,0000,0000,0000,,أجل، على الأرجح
Dialogue: 0,0:18:46.33,0:18:50.79,Default,,0000,0000,0000,,لكن لمَ خرجت من هنا وليس الباب الأمامي؟
Dialogue: 0,0:18:51.22,0:18:53.50,Default,,0000,0000,0000,,كأنّها كانت تحاول التسلّل\Nدون أن يراها أحد
Dialogue: 0,0:18:54.53,0:18:58.35,Default,,0000,0000,0000,,المكان مُوحل، هنا أكان يستعمل أحدهم هذا الباب؟
Dialogue: 0,0:18:58.68,0:19:02.55,Default,,0000,0000,0000,,لعلّها كانت أختي، فمفتاح الغاز \Nوأشياء أخرى توجد في الفناء الخلفي
Dialogue: 0,0:19:03.39,0:19:06.05,Default,,0000,0000,0000,,وجدنا خُفّاها، فلنخلد للنوم الآن
Dialogue: 0,0:19:06.25,0:19:07.46,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:19:17.70,0:19:20.95,Default,,0000,0000,0000,,!حسنٌ، غرفتنا بأمان الآن يا كونان-كن
Dialogue: 0,0:19:21.34,0:19:22.57,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:19:22.77,0:19:25.60,Default,,0000,0000,0000,,لا تقلق، سيكون كلّ شيءٍ بخير
Dialogue: 0,0:19:25.80,0:19:30.02,Default,,0000,0000,0000,,،إذا هاجمنا رجل الضماد مُجدداً\N !سأسحقه بالكاراتيه
Dialogue: 0,0:19:30.40,0:19:31.78,Default,,0000,0000,0000,,!حـ-حسناً
Dialogue: 0,0:19:31.98,0:19:36.48,Default,,0000,0000,0000,,مليئة بالجرأة رغم أنّ الخوف جمّدك\Nعندما هاجمك في الغابة
Dialogue: 0,0:19:37.21,0:19:40.59,Default,,0000,0000,0000,,بالمناسبة، لمَ هاجمك بالتحديد؟
Dialogue: 0,0:19:40.79,0:19:43.93,Default,,0000,0000,0000,,لا أدري، ربما لم تهم الضحيّة
Dialogue: 0,0:19:44.51,0:19:48.46,Default,,0000,0000,0000,,أخبريني يا ران-نيتشان\N أهناك أحدٌ يكنّ ضغينةً لك؟
Dialogue: 0,0:19:48.66,0:19:51.93,Default,,0000,0000,0000,,مثل شخص سحقتِ وجهه بالكاراتيه؟
Dialogue: 0,0:19:52.13,0:19:53.88,Default,,0000,0000,0000,,!بالطبع لا
Dialogue: 0,0:19:54.12,0:19:55.97,Default,,0000,0000,0000,,!اخلد للنوم وحسب
Dialogue: 0,0:19:55.97,0:19:56.76,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:20:01.58,0:20:04.94,Default,,0000,0000,0000,,لكن هناك أمرٌ غريب\Nحيال رجل الضماد ذاك
Dialogue: 0,0:20:05.56,0:20:09.14,Default,,0000,0000,0000,,،لو أخذ تشيكاكو-سان التي خرجت من الباب الخلفي
Dialogue: 0,0:20:09.34,0:20:12.76,Default,,0000,0000,0000,,فلمَ استدار وأظهر نفسه لنا عند الباب الأمامي؟
Dialogue: 0,0:20:13.93,0:20:16.93,Default,,0000,0000,0000,,...لإخافتنا؟ أم ربما
Dialogue: 0,0:20:17.13,0:20:18.06,Default,,0000,0000,0000,,أخبرني
Dialogue: 0,0:20:19.63,0:20:21.05,Default,,0000,0000,0000,,أيمكنني النوم معك؟
Dialogue: 0,0:20:21.46,0:20:22.72,Default,,0000,0000,0000,,لـ-لمَ؟
Dialogue: 0,0:20:22.92,0:20:24.91,Default,,0000,0000,0000,,لا يهم
Dialogue: 0,0:20:25.11,0:20:26.51,Default,,0000,0000,0000,,أيمكن أنّك خائفة؟
Dialogue: 0,0:20:26.51,0:20:28.01,Default,,0000,0000,0000,,لا يهم
Dialogue: 0,0:20:28.88,0:20:30.47,Default,,0000,0000,0000,,عمت مساءً يا كونان-كن
Dialogue: 0,0:20:30.82,0:20:33.63,Default,,0000,0000,0000,,يا إلهي، يا للفتيات
Dialogue: 0,0:20:33.83,0:20:35.93,Default,,0000,0000,0000,,حسنٌ، أين كنت؟
Dialogue: 0,0:20:36.14,0:20:38.52,Default,,0000,0000,0000,,...رجل الضماد كان قد
Dialogue: 0,0:20:40.13,0:20:43.57,Default,,0000,0000,0000,,...كما قلت
Dialogue: 0,0:20:44.54,0:20:46.67,Default,,0000,0000,0000,,!كلا! لا يمكنني التفكير
Dialogue: 0,0:20:46.87,0:20:49.79,Default,,0000,0000,0000,,حسنٌ، نحن نتعامل مع قاتلٍ مجنون
Dialogue: 0,0:20:49.99,0:20:52.41,Default,,0000,0000,0000,,هذا عمل الشرطة وليس عملي
Dialogue: 0,0:20:52.61,0:20:53.72,Default,,0000,0000,0000,,...لأنم
Dialogue: 0,0:20:54.31,0:20:56.01,Default,,0000,0000,0000,,لكن أيمكنني النوم؟
Dialogue: 0,0:22:53.47,0:22:55.68,Default,,0000,0000,0000,,!إنّه يستهدف ران
Dialogue: 0,0:22:57.23,0:22:58.22,Default,,0000,0000,0000,,!استيقظي يا ران
Dialogue: 0,0:22:58.42,0:22:59.84,Default,,0000,0000,0000,,!ران! ران
Dialogue: 0,0:23:00.04,0:23:01.09,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:23:05.07,0:23:06.20,Default,,0000,0000,0000,,!هذا مؤلم
Dialogue: 0,0:23:06.40,0:23:08.83,Default,,0000,0000,0000,,!سحقاً! لويتُ كاحلي
Dialogue: 0,0:23:09.37,0:23:11.56,Default,,0000,0000,0000,,!لا شيء يوقظ ران بعدما تغطّ في النوم
Dialogue: 0,0:23:11.76,0:23:13.40,Default,,0000,0000,0000,,أليس هناك ما يمكنني استعماله؟
Dialogue: 0,0:23:14.07,0:23:16.53,Default,,0000,0000,0000,,!وجدتُها! ربطة تغيير الصوت
Dialogue: 0,0:23:16.73,0:23:18.82,Default,,0000,0000,0000,,...سأرفع الصوت لأعلى حدّ و
Dialogue: 0,0:23:19.39,0:23:21.35,Default,,0000,0000,0000,,!استيقظي
Dialogue: 0,0:23:33.39,0:23:35.89,Default,,0000,0000,0000,,!ران! كونان-كن! ما الذي يجري؟
Dialogue: 0,0:23:36.22,0:23:38.85,Default,,0000,0000,0000,,!افتحا الباب! كونان-كن! ران
Dialogue: 0,0:23:42.09,0:23:43.22,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:23:44.22,0:23:45.12,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:23:45.48,0:23:47.86,Default,,0000,0000,0000,,!اللعنة! لمَ؟
Dialogue: 0,0:23:48.27,0:23:50.02,Default,,0000,0000,0000,,!لمَ يستهدف ران؟
Dialogue: 0,0:24:02.90,0:24:05.55,Default,,0000,0000,0000,,!رجل الضماد يلاحق ران فعلاً
Dialogue: 0,0:24:05.92,0:24:07.40,Default,,0000,0000,0000,,لكن لمَ هي؟
Dialogue: 0,0:24:08.10,0:24:10.06,Default,,0000,0000,0000,,...هناك ما حيّر بالي
Dialogue: 0,0:24:10.40,0:24:11.92,Default,,0000,0000,0000,,!تذكّري يا ران-نيتشان
Dialogue: 0,0:24:12.32,0:24:15.14,Default,,0000,0000,0000,,...لا أستطيع أن
Dialogue: 0,0:24:15.88,0:24:17.60,Default,,0000,0000,0000,,...لقد اكتشفت
Dialogue: 0,0:24:20.19,0:24:23.09,Default,,0000,0000,0000,,!هويّة المجرم الذي قتل تشيكاكو-سان
Dialogue: 0,0:24:24.41,0:24:25.68,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.88,0:24:29.97,Default,,0000,0000,0000,,جريمة قتل رجل ضماد المنزل الجبلي\N(الجزء الثاني)
Dialogue: 0,0:24:33.47,0:24:35.47,Default,,0000,0000,0000,,
Dialogue: 0,0:24:45.72,0:24:47.71,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.91,0:24:49.60,Default,,0000,0000,0000,,أسلاك بيانو

