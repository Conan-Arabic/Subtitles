Dialogue: 0,0:00:01.22,0:00:03.05,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب لامع
Dialogue: 0,0:00:03.05,0:00:06.74,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:06.74,0:00:10.24,Default,,0000,0000,0000,,قضيّة اليوم تتضمّن ذكرى حزينة\Nتختبئ خلف الضمادات
Dialogue: 0,0:00:10.54,0:00:12.62,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.62,0:00:14.32,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.32,0:00:16.86,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:52.58,0:01:55.90,Default,,0000,0000,0000,,،أثناء حفلة عيد ميلاد رئيس مجموعة ناغاتو
Dialogue: 0,0:01:55.90,0:01:57.98,Default,,0000,0000,0000,,،تعرّض ميتسواكي-سان، زوج الابنة الثانية ياسوي-سان
Dialogue: 0,0:01:57.98,0:02:00.59,Default,,0000,0000,0000,,لهجوم من قِبل أحدهم\Nفي الغرفة السفلية
Dialogue: 0,0:02:01.03,0:02:03.49,Default,,0000,0000,0000,,ظهر الابن الأكبر، هيدومي-سان، على الشرفة
Dialogue: 0,0:02:03.49,0:02:05.06,Default,,0000,0000,0000,,!بسكّينٍ في فمه
Dialogue: 0,0:02:06.15,0:02:09.12,Default,,0000,0000,0000,,أسرعنا للغرفة السفليّة\Nلكن الأوان كان قد فات
Dialogue: 0,0:02:10.14,0:02:14.17,Default,,0000,0000,0000,,اخترق ميتسواكي الأسوار الحديدية ولقي حتفه
Dialogue: 0,0:02:16.05,0:02:20.88,Default,,0000,0000,0000,,بعد يومين للحادثة، وجدنا جثّة هيدومي-سان في البركة
Dialogue: 0,0:02:20.88,0:02:22.52,Default,,0000,0000,0000,,مع وصيّة له
Dialogue: 0,0:02:22.71,0:02:25.12,Default,,0000,0000,0000,,وبدا أنّه مُرتكب الجريمة بلا شكّ
Dialogue: 0,0:02:26.99,0:02:29.65,Default,,0000,0000,0000,,هناك شيءٌ غريب حيال تلك الوصية
Dialogue: 0,0:02:29.91,0:02:35.15,Default,,0000,0000,0000,,مما يعني أنّ هيدومي-سان\N!قُتل قبل وقوع الجريمة
Dialogue: 0,0:02:36.96,0:02:42.91,Title,,0000,0000,15,,{\fad(300,0)} قضيّة سلسلة حوادث الموت الغريبة للعائلة المرموقة\Nا(لجزء الثاني)
Dialogue: 0,0:02:37.36,0:02:40.82,Default,,0000,0000,0000,,قضيّة سلسلة حوادث الموت الغريبة للعائلة المرموقة\Nالجزء الثاني
Dialogue: 0,0:02:43.19,0:02:45.77,Default,,0000,0000,0000,,ماذا؟ لم يغادر أحد؟
Dialogue: 0,0:02:46.27,0:02:48.73,Default,,0000,0000,0000,,لم يغادر أحد بينهم المحيط
Dialogue: 0,0:02:49.18,0:02:51.70,Default,,0000,0000,0000,,دخلوا القصر جميعاً قبل المساء
Dialogue: 0,0:02:52.43,0:02:56.69,Default,,0000,0000,0000,,أخبرنا والدك أن نتوخّى\Nالحذر تحديداً ذاك اليوم
Dialogue: 0,0:02:57.92,0:02:59.42,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:02:59.42,0:03:02.84,Default,,0000,0000,0000,,فقد تركنا المدخل لمجرّد دقيقة أو اثنتين
Dialogue: 0,0:03:02.84,0:03:06.50,Default,,0000,0000,0000,,عندما ذهبنا لمكان الجثّة معك
Dialogue: 0,0:03:06.50,0:03:10.29,Default,,0000,0000,0000,,لا بدّ أنّ هيدومي-سان استغلّ\Nتلك الفرصة لدخول البركة
Dialogue: 0,0:03:10.29,0:03:12.07,Default,,0000,0000,0000,,من الاتّجاه الآخر
Dialogue: 0,0:03:12.07,0:03:16.27,Default,,0000,0000,0000,,كان ميتسواكي-سان هو الوحيد الذي خرج
Dialogue: 0,0:03:16.53,0:03:19.49,Default,,0000,0000,0000,,ميتسواكي-سان؟ متى فعل ذلك؟
Dialogue: 0,0:03:19.49,0:03:21.70,Default,,0000,0000,0000,,...عند التاسعة والنصف تقريباً
Dialogue: 0,0:03:22.19,0:03:24.98,Default,,0000,0000,0000,,قال أنّه يبحث عن هيدومي-سان
Dialogue: 0,0:03:24.98,0:03:30.45,Default,,0000,0000,0000,,...كان يبحث في كلّ مكان، بين الأشجار وحول البركة
Dialogue: 0,0:03:31.36,0:03:34.31,On Top,,0000,0000,0000,,شيء غريب في هيدومي-سان مؤخراً؟
Dialogue: 0,0:03:31.93,0:03:34.41,CharCard,,0000,0000,15,,{\fad(300,0)}مطبخ عائلة ناغاتو
Dialogue: 0,0:03:34.41,0:03:38.33,Default,,0000,0000,0000,,!نعم، أيّ شيء يفي بالغرض\Nأكان هناك ما يشغله؟
Dialogue: 0,0:03:38.33,0:03:41.91,Default,,0000,0000,0000,,لا أدري، لم يكن كثير الكلام
Dialogue: 0,0:03:42.57,0:03:43.84,Default,,0000,0000,0000,,!صحيح، وجباته
Dialogue: 0,0:03:43.84,0:03:44.93,Default,,0000,0000,0000,,وجباته؟
Dialogue: 0,0:03:44.93,0:03:49.00,Default,,0000,0000,0000,,أكل أكثر بكثير من العادة يوم الحادثة\Nوفي اليوم السابق لها
Dialogue: 0,0:03:49.00,0:03:52.71,Default,,0000,0000,0000,,!صحيح! أكل التحلية التي يتركها دائماً حتّى
Dialogue: 0,0:03:53.22,0:03:57.07,Default,,0000,0000,0000,,كان ذلك مُفاجئاً بما أنّه\Nلا يتناول الإفطار عادةً
Dialogue: 0,0:03:57.34,0:04:01.63,Default,,0000,0000,0000,,هل كان هيدومي-سان\Nيرتدي نفس الضمادات باستمرار؟
Dialogue: 0,0:04:01.63,0:04:06.08,Default,,0000,0000,0000,,كلا، كانت شقيقته ياسوي-سان\Nتغيّرها كل ثلاثة أيام
Dialogue: 0,0:04:06.08,0:04:10.09,Default,,0000,0000,0000,,أظنّ آخر مرة كانت قبل يومين من الحادثة
Dialogue: 0,0:04:10.09,0:04:12.04,Default,,0000,0000,0000,,!تذكّرت، كان هناك أمر غريب
Dialogue: 0,0:04:12.04,0:04:14.58,Default,,0000,0000,0000,,!اختفت إحدى أغطية فراشه قبل ثلاثة أيام
Dialogue: 0,0:04:14.58,0:04:16.29,Default,,0000,0000,0000,,هل عددتِ كما يجب؟
Dialogue: 0,0:04:16.29,0:04:16.82,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:16.82,0:04:19.00,Default,,0000,0000,0000,,كودو! تعال معي قليلاً
Dialogue: 0,0:04:19.82,0:04:20.86,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:04:22.44,0:04:23.90,Default,,0000,0000,0000,,انظر لذلك
Dialogue: 0,0:04:24.02,0:04:27.12,Default,,0000,0000,0000,,أسفل شرفة غرفة ميتسواكي-سان وياسوي-سان
Dialogue: 0,0:04:27.38,0:04:31.09,Default,,0000,0000,0000,,...ما ذاك الأثر؟ يبدو أنّه ارتطام شيء
Dialogue: 0,0:04:31.35,0:04:35.42,Default,,0000,0000,0000,,كانت هذه الشرفة التي دُفع منها\Nميتسواكي-سان وفقما أظن
Dialogue: 0,0:04:35.67,0:04:36.81,Default,,0000,0000,0000,,!تعال
Dialogue: 0,0:04:37.17,0:04:39.42,Default,,0000,0000,0000,,!يوجد الأثر نفسه هنا
Dialogue: 0,0:04:40.80,0:04:44.50,Default,,0000,0000,0000,,رغم أنّها آثار كثيرة، وليست واحداً
Dialogue: 0,0:04:44.79,0:04:45.92,Default,,0000,0000,0000,,هذه غرفة من؟
Dialogue: 0,0:04:45.92,0:04:47.05,Default,,0000,0000,0000,,نوبوكو-سان
Dialogue: 0,0:04:47.54,0:04:49.67,Default,,0000,0000,0000,,...يبدو مُريباً
Dialogue: 0,0:04:49.67,0:04:51.50,Default,,0000,0000,0000,,!حسناً، لنذهب لتفقد الأمر
Dialogue: 0,0:04:57.15,0:04:59.42,Default,,0000,0000,0000,,أأنت واثق من هذا يا كودو؟
Dialogue: 0,0:04:59.74,0:05:01.87,Default,,0000,0000,0000,,!لا فرق بيننا واللصوص
Dialogue: 0,0:04:59.74,0:05:02.87,CharCard,,0000,0000,15,,{\fad(300,0)}غرفة نوبوكو
Dialogue: 0,0:05:01.87,0:05:02.82,Default,,0000,0000,0000,,!لا مشكلة
Dialogue: 0,0:05:03.17,0:05:05.48,Default,,0000,0000,0000,,لا مشكلة؟
Dialogue: 0,0:05:06.99,0:05:09.93,Default,,0000,0000,0000,,!الـ-الهاتف! ماذا نفعل؟
Dialogue: 0,0:05:11.14,0:05:13.01,Default,,0000,0000,0000,,نعم، معك نوبوكو
Dialogue: 0,0:05:13.26,0:05:15.97,Default,,0000,0000,0000,,...يا لجرأته
Dialogue: 0,0:05:16.47,0:05:18.51,Default,,0000,0000,0000,,إذاً، ماذا تريد؟
Dialogue: 0,0:05:18.51,0:05:23.38,Default,,0000,0000,0000,,أتذكرين الرسالة التي تركتِها على آلة\Nالرد خاصتي أثناء ثملك قبل يومين؟
Dialogue: 0,0:05:23.87,0:05:25.96,Default,,0000,0000,0000,,متى قبل يومين بالضبط؟
Dialogue: 0,0:05:26.30,0:05:28.29,Default,,0000,0000,0000,,أنسيتِ؟
Dialogue: 0,0:05:28.29,0:05:33.59,Default,,0000,0000,0000,,تركتِ مجموعةً من الرسائل بطول\Nنصف ساعة قبل العاشرة ليلاً
Dialogue: 0,0:05:34.36,0:05:35.96,Default,,0000,0000,0000,,ماذا؟ أحقّاً ذلك؟
Dialogue: 0,0:05:36.53,0:05:40.70,Default,,0000,0000,0000,,لا يهمّ إذا كنتِ لا تذكرين، إلى اللقاء
Dialogue: 0,0:05:42.15,0:05:46.42,Default,,0000,0000,0000,,العاشرة مساءً قبل يومين\Nأي عندما وقعت الجريمة
Dialogue: 0,0:05:46.57,0:05:47.52,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:05:47.52,0:05:50.77,Default,,0000,0000,0000,,عرفنا أنّ رجل الضماد الذي أرانا وجهه على الشرفة
Dialogue: 0,0:05:50.77,0:05:52.64,Default,,0000,0000,0000,,لم يكن نوبوكو-سان على الأقل
Dialogue: 0,0:05:52.64,0:05:56.74,Default,,0000,0000,0000,,ما يعني أنّ الوحيد القادر على ذلك\N!هو هيدومي-سان فقط
Dialogue: 0,0:05:56.74,0:05:59.63,Default,,0000,0000,0000,,!بأيّ حال، لنبحث في غرفته
Dialogue: 0,0:06:01.48,0:06:05.11,On Top,,0000,0000,0000,,!إنّها تعجّ بالكتب! كما تتوقّع من روائيّ
Dialogue: 0,0:06:01.56,0:06:08.14,CharCard,,0000,0000,0000,,{\fad(300,0)}غرفة هيدومي
Dialogue: 0,0:06:05.18,0:06:08.09,On Top,,0000,0000,0000,,...أنتَ من يعبث الآن
Dialogue: 0,0:06:09.14,0:06:10.33,Default,,0000,0000,0000,,!آلة رد
Dialogue: 0,0:06:10.81,0:06:13.03,Default,,0000,0000,0000,,وردت فيها رسائل على ما يبدو
Dialogue: 0,0:06:13.03,0:06:13.77,Default,,0000,0000,0000,,!حقّاً؟
Dialogue: 0,0:06:13.77,0:06:15.09,Default,,0000,0000,0000,,لنسمعها
Dialogue: 0,0:06:18.26,0:06:20.84,Default,,0000,0000,0000,,"مرحباً، أنا يامادا من "عصر الأدب
Dialogue: 0,0:06:20.84,0:06:23.55,Default,,0000,0000,0000,,سأكون في المكان المعتاد\Nعند الواحدة بعد الظهر غداً
Dialogue: 0,0:06:23.55,0:06:25.23,Default,,0000,0000,0000,,!لمناقشة نصّك التالي
Dialogue: 0,0:06:29.33,0:06:34.65,Default,,0000,0000,0000,,الواحد والثلاثون من أكتوبر، 1:28 مساءً
Dialogue: 0,0:06:34.65,0:06:38.81,Default,,0000,0000,0000,,الواحد والثلاثون من أكتوبر؟\Nأي اليوم السابق للجريمة
Dialogue: 0,0:06:39.14,0:06:42.40,Default,,0000,0000,0000,,أنا يامادا، وصلتُ المقهى المعتاد
Dialogue: 0,0:06:43.74,0:06:47.67,Default,,0000,0000,0000,,الأوّل من نوفمبر، 3:04 مساءً
Dialogue: 0,0:06:49.98,0:06:52.93,Default,,0000,0000,0000,,أنا يامادا، انتظرتُ 6 ساعات
Dialogue: 0,0:06:52.93,0:06:55.43,Default,,0000,0000,0000,,يبدو أنّك لن تأتي لذا سأغادر
Dialogue: 0,0:06:55.43,0:06:58.89,Default,,0000,0000,0000,,...أيمكن أنّ هيدومي-سان
Dialogue: 0,0:06:58.89,0:07:02.52,Default,,0000,0000,0000,,...مستحيل! وقت وفاته المقدّر
Dialogue: 0,0:07:04.62,0:07:07.39,Default,,0000,0000,0000,,!كانت هناك طريقة إذاً
Dialogue: 0,0:07:07.91,0:07:12.35,Default,,0000,0000,0000,,نعم، وذاك الشخص وحده\N!من كان يستطيع فعلها
Dialogue: 0,0:07:13.08,0:07:14.64,Default,,0000,0000,0000,,...ما يعني
Dialogue: 0,0:07:14.82,0:07:18.78,CharCard,,0000,0000,15,,غرفة ميتسواكي وياسوي
Dialogue: 0,0:07:15.10,0:07:16.49,Default,,0000,0000,0000,,يُفترض أنّه هنا
Dialogue: 0,0:07:16.67,0:07:18.62,Default,,0000,0000,0000,,...إذا أصاب استنتاجنا
Dialogue: 0,0:07:19.09,0:07:20.90,Default,,0000,0000,0000,,فسيكون هنا غالباً
Dialogue: 0,0:07:20.90,0:07:22.31,Default,,0000,0000,0000,,!وجدتُه
Dialogue: 0,0:07:22.61,0:07:24.97,Default,,0000,0000,0000,,!غطاء فراش متّسخ بالوحل
Dialogue: 0,0:07:25.08,0:07:26.81,Default,,0000,0000,0000,,!هناك غطاء رأس سباحة أيضاً
Dialogue: 0,0:07:26.98,0:07:30.27,Default,,0000,0000,0000,,وجدتُ ما أبحث عنه بدوري
Dialogue: 0,0:07:36.38,0:07:38.64,Default,,0000,0000,0000,,ها أنت يا هاتّوري-كن
Dialogue: 0,0:07:39.25,0:07:42.60,Default,,0000,0000,0000,,!أعد قلم ميوكي-سان لها
Dialogue: 0,0:07:42.60,0:07:44.92,Default,,0000,0000,0000,,!آسف، آسف! نسيت
Dialogue: 0,0:07:44.92,0:07:48.10,Default,,0000,0000,0000,,هيّا، سنرجع يا كونان-كن\Nفالظلام قد خيّم
Dialogue: 0,0:07:49.17,0:07:50.56,Default,,0000,0000,0000,,كم الساعة الآن؟
Dialogue: 0,0:07:52.75,0:07:54.51,Default,,0000,0000,0000,,السابعة إلّا عشر دقائق
Dialogue: 0,0:07:54.90,0:07:56.97,Default,,0000,0000,0000,,!حسناً، لا يزال المتجر مفتوحاً
Dialogue: 0,0:07:57.26,0:08:00.53,Default,,0000,0000,0000,,ران-نيتشان، هلّا اشتريتِ هذه لنا من فضلك؟
Dialogue: 0,0:08:00.53,0:08:05.02,Default,,0000,0000,0000,,وأيضاً، أتعرفان من كان يقطن الغرفة\Nفوق غرفة نوبوكو-سان؟
Dialogue: 0,0:08:05.02,0:08:07.39,Default,,0000,0000,0000,,...إنّها أنا حالياً
Dialogue: 0,0:08:07.78,0:08:11.35,Default,,0000,0000,0000,,فلتطلبي من الجميع القدوم هناك\Nخلال ساعة من فضلك
Dialogue: 0,0:08:11.73,0:08:13.86,Default,,0000,0000,0000,,!سأبقي هذا الصبيّ معي حتّى حينها
Dialogue: 0,0:08:13.86,0:08:14.81,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:08:14.81,0:08:17.39,Default,,0000,0000,0000,,!أخبري العمّ كوغورو أن يأتي فوراً
Dialogue: 0,0:08:17.97,0:08:19.85,Default,,0000,0000,0000,,!ما خطبهما؟
Dialogue: 0,0:08:20.39,0:08:23.29,Default,,0000,0000,0000,,نوّمنا الرجل المُسن بالساعة المخدّرة
Dialogue: 0,0:08:24.22,0:08:27.34,On Top,,0000,0000,0000,,حصلنا على كلّ ما نحتاجه لعرض استنتاجنا
Dialogue: 0,0:08:24.43,0:08:29.99,CharCard,,0000,0000,0000,,{\fad(300,0)}غرفة ميوكي
Dialogue: 0,0:08:27.63,0:08:29.77,On Top,,0000,0000,0000,,!والاستنتاج لا تشوبه شائبة
Dialogue: 0,0:08:30.04,0:08:33.25,Default,,0000,0000,0000,,لكن، نسينا أمراً مهماً
Dialogue: 0,0:08:33.25,0:08:34.22,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:08:34.64,0:08:37.18,Default,,0000,0000,0000,,!الدليل، لا دليل لدينا
Dialogue: 0,0:08:37.18,0:08:40.64,Default,,0000,0000,0000,,كنا منهمكين في الاستنتاج\Nوغفلنا عن ذلك تماماً
Dialogue: 0,0:08:41.04,0:08:42.81,Default,,0000,0000,0000,,ما الساعة الآن؟
Dialogue: 0,0:08:43.37,0:08:46.96,Default,,0000,0000,0000,,السابعة وأربعون دقيقة، سيأتي الجميع\Nبعد عشر دقائق
Dialogue: 0,0:08:46.96,0:08:49.81,Default,,0000,0000,0000,,!لمَ لم تدرك الأمر؟
Dialogue: 0,0:08:49.81,0:08:51.98,Default,,0000,0000,0000,,ألستَ متحرّي الشرق العظيم؟
Dialogue: 0,0:08:52.26,0:08:54.72,Default,,0000,0000,0000,,...أيّها الأحمق! ألستَ متحرّي الغرب
Dialogue: 0,0:08:55.71,0:08:56.48,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:08:56.71,0:08:58.31,Default,,0000,0000,0000,,...لمَ ذاك الشخص
Dialogue: 0,0:08:59.01,0:09:00.23,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:09:00.23,0:09:02.19,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:09:02.19,0:09:05.67,Default,,0000,0000,0000,,حسناً، سنبدأ بعد عشر دقائق وفق الجدول
Dialogue: 0,0:09:11.17,0:09:12.44,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:09:13.13,0:09:14.89,Default,,0000,0000,0000,,أخبرني يا هاتّوري
Dialogue: 0,0:09:15.37,0:09:19.35,Default,,0000,0000,0000,,أسبق وقتلتَ أحدهم؟
Dialogue: 0,0:09:24.57,0:09:27.27,Default,,0000,0000,0000,,أتينا يا هاتّوري-كن، ما الأمر بالضبط؟
Dialogue: 0,0:09:27.48,0:09:29.52,Default,,0000,0000,0000,,ماذا؟ أين هاتّوري-كن؟
Dialogue: 0,0:09:29.52,0:09:32.44,Default,,0000,0000,0000,,أنا من استدعاكم جميعاً
Dialogue: 0,0:09:32.69,0:09:34.07,Default,,0000,0000,0000,,أنت يا أبي؟
Dialogue: 0,0:09:34.07,0:09:35.39,Default,,0000,0000,0000,,ما الذي يجري؟
Dialogue: 0,0:09:35.64,0:09:40.06,Default,,0000,0000,0000,,اكتشفتُ أخيراً هويّة المجرم\Nالذي قتل ميتسواكي-سان
Dialogue: 0,0:09:40.06,0:09:42.81,Default,,0000,0000,0000,,وألقى هيدومي-سان في البركة
Dialogue: 0,0:09:43.14,0:09:47.21,Default,,0000,0000,0000,,مهلك، كان هيدومي-سان\N!من قتل ميتسواكي-سان
Dialogue: 0,0:09:47.21,0:09:50.17,Default,,0000,0000,0000,,ثمّ سمّم نفسه وانتحر في البركة
Dialogue: 0,0:09:50.17,0:09:54.67,Default,,0000,0000,0000,,حتّى خطّ الوصيّة موافق \N...لخطّ هيدومي-سان تماماً
Dialogue: 0,0:09:57.58,0:09:59.18,Default,,0000,0000,0000,,...الـ-الهاتف
Dialogue: 0,0:09:59.18,0:10:02.90,Default,,0000,0000,0000,,إذاً يا حضرة المفتّش، هلا أجبت؟
Dialogue: 0,0:10:02.90,0:10:05.82,Default,,0000,0000,0000,,...افعل ذلك وسيتكرر أمامنا مشهد
Dialogue: 0,0:10:06.27,0:10:11.31,Default,,0000,0000,0000,,موت ميتسواكي-سان على الأسوار\Nفي تلك الليلة المأساوية
Dialogue: 0,0:10:17.14,0:10:18.34,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:10:18.34,0:10:19.78,Default,,0000,0000,0000,,!إنّه أنا
Dialogue: 0,0:10:19.78,0:10:21.34,Default,,0000,0000,0000,,...ماذا؟ أنت يا هاتّوري-كن
Dialogue: 0,0:10:22.23,0:10:24.01,Default,,0000,0000,0000,,!ما الذي تفعله يا هذا؟
Dialogue: 0,0:10:24.01,0:10:25.47,Default,,0000,0000,0000,,!ما الخطب؟
Dialogue: 0,0:10:25.47,0:10:28.55,Default,,0000,0000,0000,,...أطفأ أحدهم الأنوار وهاجمني
Dialogue: 0,0:10:28.55,0:10:29.95,Default,,0000,0000,0000,,أين أنت الآن؟
Dialogue: 0,0:10:29.95,0:10:32.44,Default,,0000,0000,0000,,!في الغرفة أسفلكم! ألق نظرة
Dialogue: 0,0:10:38.23,0:10:40.19,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:40.61,0:10:41.96,Default,,0000,0000,0000,,ما الذي يجري؟
Dialogue: 0,0:10:41.96,0:10:44.64,Default,,0000,0000,0000,,!لا أدري، لكن علينا النزول وإنقاذه فوراً
Dialogue: 0,0:10:44.64,0:10:46.10,Default,,0000,0000,0000,,تمهل رجاءً
Dialogue: 0,0:10:47.14,0:10:52.60,Default,,0000,0000,0000,,هكذا أخرج القاتل الجميع من الغرفة آنذاك
Dialogue: 0,0:10:52.94,0:10:58.56,Default,,0000,0000,0000,,لإخفاء الحقيقة المرعبة التي\Nحصلت هنا بعدها
Dialogue: 0,0:11:10.51,0:11:12.84,Default,,0000,0000,0000,,!مـ-من أنت؟
Dialogue: 0,0:11:14.50,0:11:16.00,Default,,0000,0000,0000,,إنّه أنا
Dialogue: 0,0:11:16.00,0:11:17.68,Default,,0000,0000,0000,,!هاتّوري-كن؟
Dialogue: 0,0:11:18.06,0:11:24.10,Default,,0000,0000,0000,,الاتّصال المُفزع والسكّين بالفمّ\N...والوجه الملفوف بالضماد
Dialogue: 0,0:11:24.69,0:11:30.58,Default,,0000,0000,0000,,كانت كلها تمثيلاً من ميتسواكي-سان\Nلإلفاق التهمة بهيدومي-سان
Dialogue: 0,0:11:30.81,0:11:35.64,Default,,0000,0000,0000,,لا-لا يمكن! كان القاتل يحمل\N!دماء ميتسواكي-سان
Dialogue: 0,0:11:35.82,0:11:38.77,Default,,0000,0000,0000,,كما كانت هناك آثار جروح سكّين\Nعلى جثّة ميتسواكي-سان
Dialogue: 0,0:11:39.00,0:11:42.64,Default,,0000,0000,0000,,كانت تلك الآثار من صنعه
Dialogue: 0,0:11:42.64,0:11:46.97,Default,,0000,0000,0000,,رشّ الدم على ضمادات الوجه\Nبمحقنة طبيّة
Dialogue: 0,0:11:47.47,0:11:50.97,Default,,0000,0000,0000,,كانت الضمادات والقبعة تخصّ هيدومي-سان غالباً
Dialogue: 0,0:11:51.15,0:11:54.79,Default,,0000,0000,0000,,لذا ارتدى قبعة سباحة\Nكيلا يلتصق شعره
Dialogue: 0,0:11:55.03,0:11:58.39,Default,,0000,0000,0000,,وجدنا المحقنة وقبّعة السباحة\Nفي غرفة ميتسواكي-سان
Dialogue: 0,0:11:58.62,0:12:03.60,Default,,0000,0000,0000,,!لكن، كان ميتسواكي من قُتِل\Nلمَ قد يفعل كلّ هذا؟
Dialogue: 0,0:12:03.60,0:12:07.31,Default,,0000,0000,0000,,لقتل الرئيس ناغاتو على الأرجح
Dialogue: 0,0:12:07.31,0:12:08.49,Default,,0000,0000,0000,,الرئيس؟
Dialogue: 0,0:12:08.49,0:12:12.26,Default,,0000,0000,0000,,نعم، الرئيس الذي خدّره شريكه ونوّمه
Dialogue: 0,0:12:12.78,0:12:14.26,Default,,0000,0000,0000,,!شريكه؟
Dialogue: 0,0:12:14.40,0:12:15.65,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:12:15.65,0:12:19.98,Default,,0000,0000,0000,,كانت الخطّة هي قتل ميتسواكي-سان\N...للرئيس غالباً
Dialogue: 0,0:12:19.98,0:12:24.67,Default,,0000,0000,0000,,ويرجع لغرفته بينما يُبقي شريكه الجميع في الأسفل
Dialogue: 0,0:12:25.14,0:12:28.63,Default,,0000,0000,0000,,لكنّه قُتل على يد شريكه بدل ذلك
Dialogue: 0,0:12:28.89,0:12:32.22,Default,,0000,0000,0000,,يد ذاك الشخص الذي\N...بقي مع الرئيس في الغرفة
Dialogue: 0,0:12:32.22,0:12:35.23,Default,,0000,0000,0000,,!هيوغا ميوكي-سان، أنت
Dialogue: 0,0:12:36.50,0:12:38.48,Default,,0000,0000,0000,,...ميوكي-سان؟ مستحيل
Dialogue: 0,0:12:38.59,0:12:41.53,Default,,0000,0000,0000,,لا بدّ أنّ ميتسواكي-سان كان مصدوماً
Dialogue: 0,0:12:41.71,0:12:45.45,Default,,0000,0000,0000,,عندما رآك في شرفة الغرفة\Nالتي يُفترض أنّها تحوي الرئيس فقط
Dialogue: 0,0:12:45.45,0:12:48.14,Default,,0000,0000,0000,,وفوق ذلك، قمتِ بدفعه
Dialogue: 0,0:12:48.40,0:12:53.60,Default,,0000,0000,0000,,لكن يُفترض أنّ السكّين \Nسقطت معه في تلك الحالة
Dialogue: 0,0:12:53.85,0:12:59.02,Default,,0000,0000,0000,,رمى السكّين والضمادات والقبّعة خارجاً\Nقبل صعوده على الأرجح
Dialogue: 0,0:12:59.38,0:13:02.98,Default,,0000,0000,0000,,نوى ميتسواكي-سان قتل الرئيس بخيط رفيع
Dialogue: 0,0:13:02.98,0:13:04.97,Default,,0000,0000,0000,,في جيب معطفه
Dialogue: 0,0:13:05.11,0:13:09.43,Default,,0000,0000,0000,,هدف ميوكي-سان الوحيد\Nكان ميتسواكي-سان بالطبع
Dialogue: 0,0:13:09.62,0:13:14.33,Default,,0000,0000,0000,,لن يشكّ أحد أنّ رجلاً مقتولاً استعمل حيلة
Dialogue: 0,0:13:14.43,0:13:16.98,Default,,0000,0000,0000,,ماذا عن الحبل بالخطّاف إذاً؟
Dialogue: 0,0:13:16.98,0:13:18.84,Default,,0000,0000,0000,,ذلك بسيط
Dialogue: 0,0:13:19.59,0:13:24.81,Default,,0000,0000,0000,,سحبت الحبل الذي استعمله ميتسواكي-سان\Nوأمسكت بالثقل في طرفه الآخر
Dialogue: 0,0:13:25.49,0:13:27.99,Default,,0000,0000,0000,,ثمّ علّقته بأسوار الشرفة السفلية
Dialogue: 0,0:13:27.99,0:13:30.57,Default,,0000,0000,0000,,...بعدها، ألقت نهاية الطرف الثاني
Dialogue: 0,0:13:32.25,0:13:36.32,Default,,0000,0000,0000,,فأصاب الثقل الجانب السفليّ للشرفة\Nوتوقّف من تلقاء نفسه
Dialogue: 0,0:13:36.52,0:13:39.98,Default,,0000,0000,0000,,ودليلاً على ذلك، توجد آثار اصطدام ثقل
Dialogue: 0,0:13:39.98,0:13:43.54,Default,,0000,0000,0000,,في أسفل شرفة غرفة الرئيس، كما شرفة غرفة ميتسواكي-سان
Dialogue: 0,0:13:44.26,0:13:47.90,Default,,0000,0000,0000,,وأيضاً شرفة غرفة نوبوكو-سان أسفلنا
Dialogue: 0,0:13:48.06,0:13:53.02,Default,,0000,0000,0000,,اختبرت ميوكي-سان فعالية الأمر\Nفي اليوم السابق للحادثة غالباً
Dialogue: 0,0:13:53.34,0:13:54.51,Default,,0000,0000,0000,,اليوم السابق؟
Dialogue: 0,0:13:54.51,0:13:57.44,Default,,0000,0000,0000,,نعم، لقد سمع الرئيس الصوت
Dialogue: 0,0:13:57.60,0:13:59.05,Default,,0000,0000,0000,,الرئيس؟
Dialogue: 0,0:13:59.27,0:14:02.81,Default,,0000,0000,0000,,أجل، مع صوت ركض أحدهم في الرواق
Dialogue: 0,0:14:02.81,0:14:07.67,Default,,0000,0000,0000,,كانت تلك خطوات ميوكي-سان\Nالتي كانت تحسب الوقت الذي ستستغرقه
Dialogue: 0,0:14:07.79,0:14:12.12,Default,,0000,0000,0000,,للركض من غرفة ميتسواكي-سان إلى المخزن\Nلجلب المفتاح الاحتياطيّ ثمّ العودة
Dialogue: 0,0:14:12.26,0:14:18.48,Default,,0000,0000,0000,,أي أنّها كانت جريمة قتل جهّزت لها\Nميوكي-سان في اليوم السابق
Dialogue: 0,0:14:18.69,0:14:23.43,Default,,0000,0000,0000,,أتقصد أنّها قتلت هيدومي-سان أيضاً؟\Nوماذا عن الوصيّة؟
Dialogue: 0,0:14:23.57,0:14:29.29,Default,,0000,0000,0000,,أخبرتُك حضرة المفتّش، هدفها الوحيد كان ميتسواكي-سان
Dialogue: 0,0:14:29.47,0:14:30.39,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:30.39,0:14:32.85,Default,,0000,0000,0000,,الوصيّة كتبها هيدومي-سان
Dialogue: 0,0:14:32.95,0:14:35.85,Default,,0000,0000,0000,,في اليوم السابق قبل إقدامه على الانتحار
Dialogue: 0,0:14:36.08,0:14:37.77,Default,,0000,0000,0000,,!اليوم السابق؟
Dialogue: 0,0:14:37.77,0:14:38.59,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:14:38.59,0:14:43.41,Default,,0000,0000,0000,,وجدته ميوكي-سان في غرفته\Nبعد انتحاره غالباً
Dialogue: 0,0:14:43.41,0:14:46.22,Default,,0000,0000,0000,,ثمّ خطّطت لهذه الجريمة
Dialogue: 0,0:14:46.81,0:14:52.61,Default,,0000,0000,0000,,لكن يا موري-كن، قدّر الطبيب الشرعيّ\N...وقت وفاة هيدومي-سان، ولم يكن
Dialogue: 0,0:14:52.69,0:14:54.18,Default,,0000,0000,0000,,كان مدفوناً في الأرض
Dialogue: 0,0:14:54.18,0:14:54.99,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:55.30,0:14:58.74,Default,,0000,0000,0000,,إذا دفنت الجثّة في الأرض\Nوحبست الهواء عنها
Dialogue: 0,0:14:58.74,0:15:01.35,Default,,0000,0000,0000,,سيتقلّص معدل تعفّنها بمقدار الثُمن
Dialogue: 0,0:15:01.43,0:15:05.98,Default,,0000,0000,0000,,استدعت ميوكي-سان ميتسواكي-سان غالباً\Nولفّا هيدومي-سان بغطاء فراش
Dialogue: 0,0:15:05.98,0:15:10.35,Default,,0000,0000,0000,,ثمّ دفناه سرّاً في الصباح قُرب البركة
Dialogue: 0,0:15:10.35,0:15:14.51,Default,,0000,0000,0000,,كانت توجد الكثير من الحفر سلفاً\Nلتُزرع بها أشجار
Dialogue: 0,0:15:14.51,0:15:17.43,Default,,0000,0000,0000,,فلن يلاحظ أحد زيادة حفرة إضافية
Dialogue: 0,0:15:17.43,0:15:20.39,Default,,0000,0000,0000,,من أغرقه في البركة إذاً؟
Dialogue: 0,0:15:20.39,0:15:22.04,Default,,0000,0000,0000,,ميتسواكي-سان
Dialogue: 0,0:15:22.30,0:15:26.03,Default,,0000,0000,0000,,أخرجه قبل وقوع الجريمة\Nورماه في البركة
Dialogue: 0,0:15:26.46,0:15:28.98,Default,,0000,0000,0000,,بينما كان يتظاهر بالبحث عنه بالطبع
Dialogue: 0,0:15:29.09,0:15:33.12,Default,,0000,0000,0000,,...لكنّنا رأينا هيدومي-ساما يوم الجريمة
Dialogue: 0,0:15:33.45,0:15:40.10,Default,,0000,0000,0000,,كلا، ما رأيتموه هي ميوكي-سان\Nأو ميتسواكي-سان متنكّران على هيئته
Dialogue: 0,0:15:40.74,0:15:44.60,Default,,0000,0000,0000,,تبيّن لنا بوضوح بعدما استمعنا\N...للرسائل على آلة الردّ خاصته
Dialogue: 0,0:15:44.60,0:15:48.78,Default,,0000,0000,0000,,أنّه كان ميتاً في اليوم السابق للجريمة
Dialogue: 0,0:15:48.94,0:15:54.30,Default,,0000,0000,0000,,لكن، لمَ تعاون ميتسواكي-سان\Nمع ميوكي-سان في خطّتها؟
Dialogue: 0,0:15:54.72,0:15:57.84,Default,,0000,0000,0000,,:أخبرتُه بشيء على هذا السياق غالباً
Dialogue: 0,0:15:57.84,0:16:01.59,Default,,0000,0000,0000,,لديّ طريقة ممتازة لتأخذ منصب الرئيس"
Dialogue: 0,0:16:01.59,0:16:05.10,Default,,0000,0000,0000,,"وتلقي كلّ اللوم على هيدومي-سان
Dialogue: 0,0:16:05.36,0:16:06.18,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:16:06.68,0:16:12.65,Default,,0000,0000,0000,,أنقذ هيدومي-سان حياة ميوكي-سان\N!في السابق! يستحيل أن تمكر به
Dialogue: 0,0:16:13.47,0:16:15.62,Default,,0000,0000,0000,,!لا تقل كلاماً كهذا بلا دليل
Dialogue: 0,0:16:15.99,0:16:18.60,Default,,0000,0000,0000,,ما الساعة الآن يا ميوكي-سان؟
Dialogue: 0,0:16:18.96,0:16:22.06,Default,,0000,0000,0000,,لحظة، ما الذي تتكلّم عنه يا أبي؟
Dialogue: 0,0:16:22.06,0:16:24.63,Default,,0000,0000,0000,,عجباً، ماذا حلّ بساعة معصمك؟
Dialogue: 0,0:16:25.35,0:16:28.23,Default,,0000,0000,0000,,...إنّها... صادف أن نسيتُ اليوم
Dialogue: 0,0:16:28.63,0:16:32.69,Default,,0000,0000,0000,,كلا، لم تنسيها، بل لم تستطيعي ارتداءها
Dialogue: 0,0:16:33.47,0:16:36.74,Default,,0000,0000,0000,,فقد انكسر رباطها آنذاك
Dialogue: 0,0:16:38.20,0:16:40.76,Default,,0000,0000,0000,,،عندما دفعتِ ميتسواكي-سان من الشرفة
Dialogue: 0,0:16:40.76,0:16:43.85,Default,,0000,0000,0000,,تمسّك برباط ساعتك
Dialogue: 0,0:16:44.51,0:16:49.14,Default,,0000,0000,0000,,إذا نزعها، ستكون ساعتك بجوار موضع سقوطه
Dialogue: 0,0:16:49.51,0:16:55.64,Default,,0000,0000,0000,,في هلعك، استعملتِ شيئاً كان معك\N!وطعنتِ يد ميتسواكي-سان اليُمنى
Dialogue: 0,0:16:56.56,0:16:59.14,Default,,0000,0000,0000,,...شيئاً كان معها؟ أ-أيمكن
Dialogue: 0,0:16:59.59,0:17:01.04,Default,,0000,0000,0000,,!قلم الحبر؟
Dialogue: 0,0:17:01.20,0:17:05.99,Default,,0000,0000,0000,,نعم، نزعت الغطاء بفمها وطعنته
Dialogue: 0,0:17:06.17,0:17:09.03,Default,,0000,0000,0000,,بالقلم التذكار من أبيها
Dialogue: 0,0:17:11.62,0:17:15.07,Default,,0000,0000,0000,,لكن كيف عرفتم ذلك؟
Dialogue: 0,0:17:15.07,0:17:21.29,Default,,0000,0000,0000,,خلعتُ الغطاء لكتابة بعض الملاحظات\Nووجدتُ رأس القلم ملتوياً
Dialogue: 0,0:17:21.53,0:17:26.33,Default,,0000,0000,0000,,لا يمكن حتّى لنار الحريق التي\Nخرج منها القلم أن تثنيه هكذا
Dialogue: 0,0:17:27.24,0:17:29.66,Default,,0000,0000,0000,,لكن لمَ قد تفعل ميوكي-سان هذا؟
Dialogue: 0,0:17:29.94,0:17:31.98,Default,,0000,0000,0000,,كان الحريق الدافع غالباً
Dialogue: 0,0:17:31.98,0:17:37.62,Default,,0000,0000,0000,,...إذا أصاب استنتاجنا، فمن أضرم الحريق قبل 20 عاماً
Dialogue: 0,0:17:38.18,0:17:40.58,Default,,0000,0000,0000,,!كانا هيدومي-سان وميتسواكي-سان
Dialogue: 0,0:17:40.58,0:17:42.58,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:17:42.58,0:17:49.40,Default,,0000,0000,0000,,بافتراض أنّ هيدومي-سان لم يُعالج\N...آثار الحروق على وجهه للتكفير عن ذنبه
Dialogue: 0,0:17:49.87,0:17:54.49,Default,,0000,0000,0000,,...وأنّ هناك تتمة لوصيّته اعترف فيها بكلّ شيء
Dialogue: 0,0:17:54.49,0:17:56.74,Default,,0000,0000,0000,,ستكتمل الصورة
Dialogue: 0,0:17:56.85,0:18:01.70,Default,,0000,0000,0000,,فهمت، كان انتقاماً لوالديها اللذين\Nماتا في الحريق إذاً
Dialogue: 0,0:18:01.75,0:18:04.66,Default,,0000,0000,0000,,لكن هناك شيءٌ لا أفهمه
Dialogue: 0,0:18:05.18,0:18:09.67,Default,,0000,0000,0000,,لمَ استفززتِ نوبوكو-سان\Nوقدتِنا لإيجاد هيدومي-سان؟
Dialogue: 0,0:18:10.06,0:18:12.35,Default,,0000,0000,0000,,فعلتِ ذلك عمداً، أليس كذلك؟
Dialogue: 0,0:18:12.75,0:18:16.14,Default,,0000,0000,0000,,كانت الشرطة لتعثر عليه قريباً لو تركتِه وحسب
Dialogue: 0,0:18:20.30,0:18:25.08,Default,,0000,0000,0000,,لم أرد تركه في الماء البارد أكثر
Dialogue: 0,0:18:28.58,0:18:29.66,Default,,0000,0000,0000,,!ميوكي-سان
Dialogue: 0,0:18:30.46,0:18:33.36,Default,,0000,0000,0000,,!لا تقتربوا! يوجد بنزين في هذا الوعاء
Dialogue: 0,0:18:33.56,0:18:35.28,Default,,0000,0000,0000,,...مهلك! لا تُقدمي على أيّ حماقات
Dialogue: 0,0:18:35.28,0:18:36.32,Default,,0000,0000,0000,,!أنا جادة
Dialogue: 0,0:18:37.32,0:18:38.41,Default,,0000,0000,0000,,...ميوكي-سان
Dialogue: 0,0:18:38.41,0:18:44.03,Default,,0000,0000,0000,,ما قاله ذاك المتحرّي صحيح، كان كلّ شيء\Nعن الحريق مكتوباً في وصيّته
Dialogue: 0,0:18:44.56,0:18:46.27,Default,,0000,0000,0000,,...لم أستطع مسامحتهما
Dialogue: 0,0:18:46.87,0:18:50.19,Default,,0000,0000,0000,,،الذي أقدم على فعلته وعاش حياته بلا مبالاة، ميتسواكي-سان
Dialogue: 0,0:18:50.19,0:18:53.45,Default,,0000,0000,0000,,وهيدومي-سان الذي أخفى الأمر طوال الوقت
Dialogue: 0,0:18:54.73,0:18:56.87,Default,,0000,0000,0000,,...لكن، أنا
Dialogue: 0,0:18:57.20,0:18:59.79,Default,,0000,0000,0000,,!وقعتُ في حبّه، بلا حيلة لي
Dialogue: 0,0:19:00.18,0:19:03.17,Default,,0000,0000,0000,,!خاطر بحياته لإنقاذي
Dialogue: 0,0:19:03.59,0:19:08.87,Default,,0000,0000,0000,,كان يأتي دوماً لزيارتي وإبهاجي\N!بعدما فقدتُ عائلتي
Dialogue: 0,0:19:09.29,0:19:14.03,Default,,0000,0000,0000,,كما قبِل عرضي للزواج
Dialogue: 0,0:19:16.66,0:19:19.44,Default,,0000,0000,0000,,...لكنّ هيدومي-سان رحل الآن
Dialogue: 0,0:19:20.35,0:19:22.08,Default,,0000,0000,0000,,...أصبحتُ وحدي مجدداً
Dialogue: 0,0:19:22.77,0:19:24.32,Default,,0000,0000,0000,,عليّ الإسراع له
Dialogue: 0,0:19:24.43,0:19:25.32,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:19:25.65,0:19:26.82,Default,,0000,0000,0000,,لا جدوى
Dialogue: 0,0:19:28.32,0:19:30.83,Default,,0000,0000,0000,,لا يوجد سوى ماء في الوعاء
Dialogue: 0,0:19:36.89,0:19:39.20,Default,,0000,0000,0000,,!لمَ؟ لمَ؟
Dialogue: 0,0:19:40.37,0:19:43.42,Default,,0000,0000,0000,,!لمَ؟! لمَ؟! لمَ؟
Dialogue: 0,0:19:44.30,0:19:49.79,Default,,0000,0000,0000,,!أضرم ناره بسهولة، فلمَ لا أستطيع إضرام ناري؟
Dialogue: 0,0:19:54.79,0:19:59.79,Default,,0000,0000,0000,,اسمع يا كودو، ربما كان علينا تركها تموت
Dialogue: 0,0:19:59.79,0:20:00.70,Default,,0000,0000,0000,,أيّها الأحمق
Dialogue: 0,0:20:01.20,0:20:03.40,Default,,0000,0000,0000,,المتحرّي الذي يحاصر المجرم باستنتاجاته
Dialogue: 0,0:20:03.40,0:20:07.53,Default,,0000,0000,0000,,ويجرّه للانتحار لا يختلف عن القاتل
Dialogue: 0,0:20:08.91,0:20:13.45,Default,,0000,0000,0000,,هذا كلام ثقيل على الأذن، لا يصدر إلّا\Nمن الشاب المثاليّ أنت
Dialogue: 0,0:20:14.10,0:20:17.15,Default,,0000,0000,0000,,لا يوجد شخص مثاليّ في هذا العالم
Dialogue: 0,0:20:17.93,0:20:19.59,Default,,0000,0000,0000,,...حتّى أنا لم أستطع إنقاذ مجرّد شخص
Dialogue: 0,0:20:21.40,0:20:22.52,Default,,0000,0000,0000,,...مجرّد شخص
Dialogue: 0,0:20:34.95,0:20:37.95,Default,,0000,0000,0000,,كما أنا متأكد أنّ "ذاك الشخص" سينقذ ميوكي-سان
Dialogue: 0,0:20:38.16,0:20:39.02,Default,,0000,0000,0000,,ذاك الشخص؟
Dialogue: 0,0:20:39.02,0:20:40.99,Default,,0000,0000,0000,,يكفي يا هيوغا-كن
Dialogue: 0,0:20:41.70,0:20:45.73,Default,,0000,0000,0000,,اتركي الكلام السخيف عن اللحاق بهيدومي
Dialogue: 0,0:20:46.35,0:20:47.41,Default,,0000,0000,0000,,!سيّدي
Dialogue: 0,0:20:48.28,0:20:51.11,Default,,0000,0000,0000,,لم تكن أمّك من هذا الصنف
Dialogue: 0,0:20:51.62,0:20:55.41,Default,,0000,0000,0000,,!وما أدراك؟! لم تعرف أمّي قطّ
Dialogue: 0,0:20:56.02,0:20:57.89,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:20:57.89,0:21:02.35,Default,,0000,0000,0000,,...فقلم الحبر الذي معك هو هديّة منّي
Dialogue: 0,0:21:02.35,0:21:07.18,Default,,0000,0000,0000,,لأمّك عندما انتقلت لمدرستي الابتدائية
Dialogue: 0,0:21:08.55,0:21:12.79,Default,,0000,0000,0000,,يبدو أنّكِ ظننتِ أنّه لوالدك
Dialogue: 0,0:21:13.21,0:21:17.49,Default,,0000,0000,0000,,لن أطلب منك مسامحة هيدومي على فعلته
Dialogue: 0,0:21:18.17,0:21:21.50,Default,,0000,0000,0000,,لكنّكِ لا تزالين شابة، حياتك في مُقتبلها
Dialogue: 0,0:21:22.33,0:21:25.32,Default,,0000,0000,0000,,احرصي على العيش لأجل هيدومي أيضاً
Dialogue: 0,0:21:26.06,0:21:28.70,Default,,0000,0000,0000,,فأنا متأكد أنّها رغبة أمّك كذلك
Dialogue: 0,0:23:02.28,0:23:04.31,CharCard,,0000,0000,0000,,{\fad(300,0)} محطّة شين يوكوهاما
Dialogue: 0,0:23:02.96,0:23:04.21,On Top,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:23:04.57,0:23:08.27,Default,,0000,0000,0000,,!محبوبة الرئيس الأولى كانت أمّ ميوكي-سان؟
Dialogue: 0,0:23:08.57,0:23:13.73,Default,,0000,0000,0000,,نعم، غالباً. لذا اختلق تلك الكذبة للتستر على ميوكي-سان
Dialogue: 0,0:23:14.20,0:23:19.37,Default,,0000,0000,0000,,فهمت، ظننتُ ادّعاءه أنّ ميوكي-سان\N...كانت بجواره طوال الوقت
Dialogue: 0,0:23:19.37,0:23:22.94,Default,,0000,0000,0000,,كان للتكفير عن ذنب ابنه، لكن كان هناك سبب آخر
Dialogue: 0,0:23:23.03,0:23:26.03,Default,,0000,0000,0000,,شعر برغبة في رؤية محبوبته الأولى
Dialogue: 0,0:23:26.03,0:23:29.61,Default,,0000,0000,0000,,عندما رآها في ملامح ميوكي-سان بالتأكيد
Dialogue: 0,0:23:30.07,0:23:35.31,Default,,0000,0000,0000,,أنت، لا تخبرني يا كودو أنّك أدركت ذلك وأخفيته عني؟
Dialogue: 0,0:23:36.27,0:23:37.65,Default,,0000,0000,0000,,!قلتَ كودو مجدداً
Dialogue: 0,0:23:39.11,0:23:41.18,Default,,0000,0000,0000,,...أتقصد بكودو
Dialogue: 0,0:23:41.56,0:23:43.07,Default,,0000,0000,0000,,...لا، ما قلتُه
Dialogue: 0,0:23:43.17,0:23:45.95,Default,,0000,0000,0000,,هو "كودوي"، أي إلحاح
Dialogue: 0,0:23:46.13,0:23:48.84,Default,,0000,0000,0000,,أصرّ هذا القزم على سماع المزيد عن القضيّة
Dialogue: 0,0:23:48.84,0:23:50.81,Default,,0000,0000,0000,,!فقلتُ يا لإلحاحك فقط
Dialogue: 0,0:23:54.20,0:23:56.12,Default,,0000,0000,0000,,كما تتوقّع من ابن أوساكا
Dialogue: 0,0:23:56.12,0:23:57.96,Default,,0000,0000,0000,,!الأفضل في اليابان في التلاعب
Dialogue: 0,0:24:08.74,0:24:13.79,Default,,0000,0000,0000,,عندما همّ الفاعل بضرب مايجيما-سان\N...بسيف خشبيّ
Dialogue: 0,0:24:14.53,0:24:20.54,Default,,0000,0000,0000,,رنّ هذا الهاتف الخلويّ الذي كان\Nفي جيب مايجيما-سان إذاً؟
Dialogue: 0,0:24:20.86,0:24:24.11,Default,,0000,0000,0000,,!كلا، يوجد جانب خلفيّ لهذه القضيّة
Dialogue: 0,0:24:24.11,0:24:30.11,On Top,,0000,0000,0000,,جريمة قتل عملية سطو المصرف
Dialogue: 0,0:24:24.60,0:24:26.28,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.28,0:24:30.20,Default,,0000,0000,0000,,جريمة قتل عملية سطو المصرف
Dialogue: 0,0:24:45.92,0:24:48.13,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.13,0:24:50.13,Default,,0000,0000,0000,,هاتف خلوي
Dialogue: 0,0:24:50.13,0:24:51.80,Default,,0000,0000,0000,,!قضيّة الحلقة القادمة مسليّة
Dialogue: 0,0:24:51.80,0:24:54.25,Default,,0000,0000,0000,,...هاتفه الخلويّ

