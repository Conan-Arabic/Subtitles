Dialogue: 0,0:00:01.09,0:00:04.59,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.59,0:00:06.58,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.76,0:00:08.25,Default,,0000,0000,0000,,!اليوم فصل طهوٍ صارم
Dialogue: 0,0:00:08.25,0:00:10.01,Default,,0000,0000,0000,,ما على القائمة؟ حادث أم حادثة؟
Dialogue: 0,0:00:10.01,0:00:11.68,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.68,0:00:13.21,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.47,0:00:15.63,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.30,0:00:23.76,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:23.76,0:00:30.80,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.52,0:00:38.93,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:38.93,0:00:46.43,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.43,0:00:58.88,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:00:59.76,0:01:06.18,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.14,0:01:13.02,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.02,0:01:19.43,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.43,0:01:26.41,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.16,0:01:57.07,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل فصل الطهو الدراسيّ\N(الجزء الأوّل)
Dialogue: 0,0:01:52.09,0:01:56.02,Default,,0000,0000,0000,,جريمة قتل فصل الطهو الدراسيّ\N(الجزء الأوّل)
Dialogue: 0,0:02:02.09,0:02:03.82,Default,,0000,0000,0000,,فصل طهو دراسيّ؟
Dialogue: 0,0:02:03.82,0:02:04.68,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:05.34,0:02:08.65,Default,,0000,0000,0000,,تُديره معلّمة تُدعى أويموري ميتشي من منزلها
Dialogue: 0,0:02:09.01,0:02:11.98,Default,,0000,0000,0000,,أعرفها، فهي معلّمة في الطهو الفرنسيّ، صحيح؟
Dialogue: 0,0:02:12.30,0:02:17.62,Default,,0000,0000,0000,,أجل! دعتني سونوكو لمرافقتها إذا \Nكنتُ أريد الذهاب هذا الأحد
Dialogue: 0,0:02:22.22,0:02:23.51,Default,,0000,0000,0000,,شكراً على الطعام
Dialogue: 0,0:02:24.68,0:02:30.72,Default,,0000,0000,0000,,لطالما أردتُ دراسة الطهو الفرنسيّ، فقبلتُ دعوتها
Dialogue: 0,0:02:30.72,0:02:32.47,Default,,0000,0000,0000,,ومتى يبدأ الفصل؟
Dialogue: 0,0:02:34.43,0:02:39.47,Default,,0000,0000,0000,,يبدأ عند السادسة والنصف وينتهي\Nعند قرابة التاسعة والنصف
Dialogue: 0,0:02:39.47,0:02:40.55,Default,,0000,0000,0000,,التاسعة والنصف؟
Dialogue: 0,0:02:41.30,0:02:43.47,Default,,0000,0000,0000,,!لا ينفع! هذا متأخّر كثيراً
Dialogue: 0,0:02:44.34,0:02:46.43,Default,,0000,0000,0000,,!لكنّه في جادة هايدو بالقرب
Dialogue: 0,0:02:46.43,0:02:48.30,Default,,0000,0000,0000,,!وإن كان بالقرب
Dialogue: 0,0:02:48.30,0:02:51.59,Default,,0000,0000,0000,,لنرافقها في تلك الحالة إذاً
Dialogue: 0,0:02:51.59,0:02:52.19,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:02:52.59,0:02:57.78,Default,,0000,0000,0000,,قد نستطيع أكل الطعام الفرنسيّ اللذيذ\N!الذي تعدّه المعلّمة بالمجّان
Dialogue: 0,0:03:01.26,0:03:04.70,Default,,0000,0000,0000,,طعام فرنسيّ لذيذ؟
Dialogue: 0,0:03:04.60,0:03:08.51,CharCard,,0000,0000,0010,,{\fad(0,300)}الأحد
Dialogue: 0,0:03:05.43,0:03:10.38,On Top,,0000,0000,0000,,وهكذا، لم تستطع سونوكو القدوم\Nبسبب ظرفها الطارئ
Dialogue: 0,0:03:12.51,0:03:17.76,Default,,0000,0000,0000,,اسمعي يا ران، لم أرافقك لأنّي\Nأريد أكل الطهو الفرنسيّ
Dialogue: 0,0:03:17.76,0:03:19.34,Default,,0000,0000,0000,,بل لأنّي قلق عليك
Dialogue: 0,0:03:19.76,0:03:22.38,Default,,0000,0000,0000,,حسناً، حسناً، فهمت
Dialogue: 0,0:03:22.38,0:03:24.51,Default,,0000,0000,0000,,أفهمتِ حقّاً؟
Dialogue: 0,0:03:27.66,0:03:29.52,On Top,,0000,0000,0000,,أويموري
Dialogue: 0,0:03:30.09,0:03:31.46,Default,,0000,0000,0000,,!هذا هو المكان يا أبي
Dialogue: 0,0:03:41.01,0:03:42.59,Default,,0000,0000,0000,,موري ران-سان، صحيح؟
Dialogue: 0,0:03:42.59,0:03:43.93,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:43.93,0:03:45.62,Default,,0000,0000,0000,,أخبرتنا المعلّمة بأنّك ستأتين
Dialogue: 0,0:03:46.63,0:03:47.83,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:03:48.01,0:03:49.35,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:03:50.63,0:03:51.51,Default,,0000,0000,0000,,هاكما
Dialogue: 0,0:03:53.93,0:03:55.47,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:03:56.68,0:04:00.01,On Top,,0000,0000,0000,,أنا كومياما يوكو، مساعدة المعلّمة
Dialogue: 0,0:03:56.85,0:04:00.01,CharCard,,0000,0000,0014,,{\fad(200,0)} (24) كومياما يوكو
Dialogue: 0,0:04:01.38,0:04:07.26,On Top,,0000,0000,0000,,الجالسة هناك هي تلميذة وزميلة\Nقديمة للمعلّمة من المدرسة الثانويّة
Dialogue: 0,0:04:07.26,0:04:10.34,On Top,,0000,0000,0000,,ومالكة متجر أزياء، ياشيرو كازوي-سان
Dialogue: 0,0:04:08.05,0:04:11.27,CharCard,,0000,0000,0014,,{\fad(300,0)}(ياشيرو كازوي (52
Dialogue: 0,0:04:10.34,0:04:11.27,On Top,,0000,0000,0000,,سُررت بلقائكم
Dialogue: 0,0:04:11.97,0:04:13.97,Default,,0000,0000,0000,,!سُررنا بلقائك
Dialogue: 0,0:04:13.97,0:04:17.22,Default,,0000,0000,0000,,هذا أبي، وكونان-كن
Dialogue: 0,0:04:17.22,0:04:21.28,Default,,0000,0000,0000,,!يا للفصل الحسن
Dialogue: 0,0:04:21.28,0:04:23.24,Default,,0000,0000,0000,,أهذه منضدات الطهو؟
Dialogue: 0,0:04:24.51,0:04:26.70,Default,,0000,0000,0000,,!يا للفرن الكبير
Dialogue: 0,0:04:28.09,0:04:30.41,Default,,0000,0000,0000,,!لا غنى عن الفرن في الطهو الفرنسيّ
Dialogue: 0,0:04:30.88,0:04:34.55,Default,,0000,0000,0000,,أسنأكل الطعام الذي تصنعونه\Nعلى تلك الطاولة إذاً؟
Dialogue: 0,0:04:34.55,0:04:35.33,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:38.63,0:04:39.75,Default,,0000,0000,0000,,إنّه نيشيتاني-كن
Dialogue: 0,0:04:40.63,0:04:43.13,Default,,0000,0000,0000,,!مساء الخير"! أتمنّى درساً موفقاً لنا اليوم أيضاً"
Dialogue: 0,0:04:48.93,0:04:50.13,Default,,0000,0000,0000,,نمتُ كثيراً
Dialogue: 0,0:04:52.09,0:04:53.72,Default,,0000,0000,0000,,!سأعرّفكما عليهم
Dialogue: 0,0:04:53.72,0:04:57.80,Default,,0000,0000,0000,,هذه موري ران-سان التي تشغل\N!مكان سونوكو-سان الليلة
Dialogue: 0,0:04:57.80,0:05:00.59,Default,,0000,0000,0000,,كما والدها وكونان-كن
Dialogue: 0,0:05:00.59,0:05:01.74,Default,,0000,0000,0000,,!سُررنا بلقائكم
Dialogue: 0,0:05:01.74,0:05:08.07,CharCard,,0000,0000,0014,,{\fad(300,0)}(أويموري كاورو (25
Dialogue: 0,0:05:02.43,0:05:04.51,On Top,,0000,0000,0000,,حسناً، بالتوفيق
Dialogue: 0,0:05:04.51,0:05:08.07,On Top,,0000,0000,0000,,كاورو-سان هي زوجة ابن المعلّمة
Dialogue: 0,0:05:08.07,0:05:13.08,CharCard,,0000,0000,0014,,{\fad(0,0)}(نيشيتاني هيرواكي (29
Dialogue: 0,0:05:08.34,0:05:10.93,On Top,,0000,0000,0000,,أنا نيشيتاني، سُررت بلقائكم
Dialogue: 0,0:05:10.93,0:05:13.08,On Top,,0000,0000,0000,,نيشيتاني-سان طاهي مطعم فرنسيّ
Dialogue: 0,0:05:13.68,0:05:17.00,Default,,0000,0000,0000,,كاورو-سان، ما خطب ضمادة العين هذه؟
Dialogue: 0,0:05:18.09,0:05:20.50,Default,,0000,0000,0000,,...بي شحاذ عين
Dialogue: 0,0:05:21.88,0:05:25.59,Default,,0000,0000,0000,,أتعاني سونوكو-سان من توعّكٍ ما؟
Dialogue: 0,0:05:25.59,0:05:29.09,Default,,0000,0000,0000,,كلا، كان لديها ظرفٌ طارئ
Dialogue: 0,0:05:29.09,0:05:31.68,Default,,0000,0000,0000,,لا عجب أنّها لن تحضر الفصل
Dialogue: 0,0:05:32.09,0:05:35.26,Default,,0000,0000,0000,,فقد كانت تتلقّى الصراخ كلّ مرّة
Dialogue: 0,0:05:35.26,0:05:37.27,Default,,0000,0000,0000,,يجدر بك تحضير نفسك
Dialogue: 0,0:05:38.30,0:05:41.30,Default,,0000,0000,0000,,!كازوي-سان! كفّي عن إخافتها
Dialogue: 0,0:05:41.30,0:05:45.59,Default,,0000,0000,0000,,لا تقلقي، لن تكوني الوحيدة التي ستصرخ عليها
Dialogue: 0,0:05:45.59,0:05:46.11,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:47.93,0:05:51.08,Default,,0000,0000,0000,,!تبدو أويموري سينسي صارمةً جدّاً
Dialogue: 0,0:05:51.43,0:05:58.00,Default,,0000,0000,0000,,فهمت، لذا افتدت سونوكو نفسها بران وهربت
Dialogue: 0,0:05:58.63,0:06:00.71,Default,,0000,0000,0000,,!يوكو-سان! سأساعدك
Dialogue: 0,0:06:02.30,0:06:06.80,Default,,0000,0000,0000,,بالمناسبة، أذهبت أويموري سينسي لمكانٍ ما؟
Dialogue: 0,0:06:06.80,0:06:08.63,Default,,0000,0000,0000,,أجل، صالون التجميل
Dialogue: 0,0:06:09.76,0:06:12.01,Default,,0000,0000,0000,,صالون التجميل؟
Dialogue: 0,0:06:12.80,0:06:14.14,Default,,0000,0000,0000,,!صالون التجميل؟
Dialogue: 0,0:06:14.59,0:06:19.22,Default,,0000,0000,0000,,،أصبح كتابها للطهو الفرنسيّ من الكتب الأكثر مبيعاً
Dialogue: 0,0:06:19.22,0:06:22.80,Default,,0000,0000,0000,,وستُقام حفلة غداً احتفالاً بذلك
Dialogue: 0,0:06:22.80,0:06:24.61,Default,,0000,0000,0000,,إنّها عجيبةٌ حقّاً
Dialogue: 0,0:06:25.13,0:06:28.32,Default,,0000,0000,0000,,تسرق أفكار الناس وتجني طنّاً من الأموال منها
Dialogue: 0,0:06:30.30,0:06:33.84,Default,,0000,0000,0000,,...ثلث الوصفات المذكورة في الكتاب
Dialogue: 0,0:06:33.84,0:06:36.87,Default,,0000,0000,0000,,تخصّ هذه الفتاة، يوكو-سان
Dialogue: 0,0:06:41.13,0:06:44.63,Default,,0000,0000,0000,,توقّفي رجاءً يا كازوي-سان، لا يهمّ ذلك
Dialogue: 0,0:06:45.09,0:06:50.05,Default,,0000,0000,0000,,!ماذا؟ لمَ؟ فقد سُرقت وصفاتك
Dialogue: 0,0:06:50.05,0:06:52.76,Default,,0000,0000,0000,,ابتكرتِ تلك الوصفات الأصليّة بينما تجتهدين
Dialogue: 0,0:06:52.76,0:06:56.30,Default,,0000,0000,0000,,!مساعدةً لميتشي في الخمسة أعوامٍ الفائتة
Dialogue: 0,0:06:57.77,0:07:00.07,Default,,0000,0000,0000,,...لكنّها ساعدت
Dialogue: 0,0:07:00.73,0:07:05.39,Default,,0000,0000,0000,,!وماذا إذا ساعدتك قليلاً؟ تبقى وصفاتك أنت
Dialogue: 0,0:07:05.39,0:07:09.60,Default,,0000,0000,0000,,مع ذلك لا تتذمّرين البتّة، لا بدّ أنّ هناك علّةً بك
Dialogue: 0,0:07:09.60,0:07:11.12,Default,,0000,0000,0000,,!توقّفي يا كازوي-سان
Dialogue: 0,0:07:12.06,0:07:16.71,Default,,0000,0000,0000,,!هذا أمرٌ بين المعلّمة ويوكو-سان! لا حقّ لنا بالكلام
Dialogue: 0,0:07:17.18,0:07:18.72,Default,,0000,0000,0000,,حقّاً ذلك؟
Dialogue: 0,0:07:19.85,0:07:21.39,Default,,0000,0000,0000,,ربما صحيح
Dialogue: 0,0:07:21.39,0:07:25.10,Default,,0000,0000,0000,,فقد كانت ميتشي تقدّم لك\Nدعماً مادياً باستمرار
Dialogue: 0,0:07:25.10,0:07:28.35,Default,,0000,0000,0000,,فلا تستطيع التفوّه بسوء عنها
Dialogue: 0,0:07:28.35,0:07:30.52,Default,,0000,0000,0000,,الموضوعان مختلفان
Dialogue: 0,0:07:31.06,0:07:34.98,Default,,0000,0000,0000,,ماذا؟ كيف مختلفان؟ هلّا أسمعتني؟
Dialogue: 0,0:07:35.52,0:07:36.52,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:07:43.02,0:07:47.77,Default,,0000,0000,0000,,مهلكم، الجوّ ينقلب هنا
Dialogue: 0,0:07:49.48,0:07:50.79,Default,,0000,0000,0000,,!رجعت المعلّمة
Dialogue: 0,0:07:59.52,0:08:01.05,Default,,0000,0000,0000,,!مرحباً بعودتك يا معلّمة
Dialogue: 0,0:08:01.05,0:08:04.56,CharCard,,0000,0000,0014,,{\fad(0,250)}(أويموري ميتشي (52
Dialogue: 0,0:08:01.60,0:08:04.88,On Top,,0000,0000,0000,,رجعت، يبدو أنّي تأخّرت قليلاً
Dialogue: 0,0:08:05.89,0:08:07.01,Default,,0000,0000,0000,,لا بدّ أنّك موري ران-سان
Dialogue: 0,0:08:07.60,0:08:09.47,Default,,0000,0000,0000,,!أجل! سُررت بلقائك
Dialogue: 0,0:08:10.35,0:08:12.73,Default,,0000,0000,0000,,...أنا والدها، موري
Dialogue: 0,0:08:12.73,0:08:14.44,Default,,0000,0000,0000,,يا إلهي، كتفاي متصلّبان
Dialogue: 0,0:08:15.10,0:08:16.83,Default,,0000,0000,0000,,نيشيتاني-كن، من فضلك
Dialogue: 0,0:08:16.83,0:08:17.43,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:17.43,0:08:20.99,Default,,0000,0000,0000,,...ا-المعذرة، أنا مـ-موري
Dialogue: 0,0:08:22.06,0:08:25.85,Default,,0000,0000,0000,,هذه البلوزة التي طلبتِ منّي إصلاحها
Dialogue: 0,0:08:25.85,0:08:27.24,Default,,0000,0000,0000,,حسناً، ضعيها هناك
Dialogue: 0,0:08:29.23,0:08:31.18,Default,,0000,0000,0000,,كاورو-سان، تفقّدي نبضي
Dialogue: 0,0:08:31.18,0:08:31.58,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:33.27,0:08:36.77,Default,,0000,0000,0000,,يا إلهي، دون كلمة شكر واحدة حتّى
Dialogue: 0,0:08:36.77,0:08:40.39,Default,,0000,0000,0000,,أتعاني المعلّمة من توعّكٍ ما؟
Dialogue: 0,0:08:40.39,0:08:41.80,Default,,0000,0000,0000,,إنّها بدينةٌ وحسب
Dialogue: 0,0:08:42.60,0:08:46.14,Default,,0000,0000,0000,,تطلب تفقّد نبضها بعدما ترجع من مكان دوماً
Dialogue: 0,0:08:46.14,0:08:48.85,Default,,0000,0000,0000,,كانت كاورو-سان ممرضة
Dialogue: 0,0:08:48.85,0:08:51.22,Default,,0000,0000,0000,,إنّه سريعٌ قليلاً، لكن لا داعي للقلق
Dialogue: 0,0:08:51.73,0:08:54.64,Default,,0000,0000,0000,,ابنها رجل أعمالٌ متفوّق
Dialogue: 0,0:08:54.64,0:08:59.06,Default,,0000,0000,0000,,لكنّه كان ابنها الوحيد، وربّته بحُب \Nفلديه عقدة أمّ كبيرة
Dialogue: 0,0:08:59.06,0:09:03.19,Default,,0000,0000,0000,,وضع كاورو-سان صعب بما أنّها زوجة ابنها
Dialogue: 0,0:09:03.85,0:09:07.78,Default,,0000,0000,0000,,سمعتُ أنّ زوج المعلّمة تُوفي من مرض
Dialogue: 0,0:09:08.56,0:09:09.70,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:09:11.06,0:09:14.25,Default,,0000,0000,0000,,كان رجلاً لطيفاً وصالحاً
Dialogue: 0,0:09:19.06,0:09:21.35,Default,,0000,0000,0000,,يكفي هذا، سأغيّر ثيابي
Dialogue: 0,0:09:21.35,0:09:21.79,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:09:25.93,0:09:27.22,Default,,0000,0000,0000,,سأذهب لدورة المياه
Dialogue: 0,0:09:27.85,0:09:29.72,Default,,0000,0000,0000,,وسأذهب أنا لجلب مريلة
Dialogue: 0,0:09:35.18,0:09:35.98,Default,,0000,0000,0000,,!مهلك
Dialogue: 0,0:09:36.73,0:09:38.44,Default,,0000,0000,0000,,!التدخين ممنوع في هذه الغرفة
Dialogue: 0,0:09:39.06,0:09:41.83,Default,,0000,0000,0000,,آسفة، لكن عليك التدخين في الخارج
Dialogue: 0,0:09:43.02,0:09:43.65,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:09:44.52,0:09:46.89,Default,,0000,0000,0000,,لو سمحتِ، أين دورة المياه؟
Dialogue: 0,0:09:46.89,0:09:51.81,Default,,0000,0000,0000,,،اذهبي عبر ذاك الباب وانعطفي يساراً\Nتوجد واحدة للفتيان وأخرى للفتيات
Dialogue: 0,0:09:51.81,0:09:53.23,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:09:54.60,0:09:55.62,Default,,0000,0000,0000,,سأذهب بدوري
Dialogue: 0,0:10:03.23,0:10:05.81,Default,,0000,0000,0000,,...يوكو-سان، رغم كلامي قبل قليل
Dialogue: 0,0:10:08.39,0:10:09.64,Default,,0000,0000,0000,,!ران-سان
Dialogue: 0,0:10:09.64,0:10:12.68,Default,,0000,0000,0000,,!آسف! تبدوان متشابهتين فخلطت بينكما
Dialogue: 0,0:10:45.93,0:10:47.43,Default,,0000,0000,0000,,لنبدأ إذاً
Dialogue: 0,0:10:48.39,0:10:51.63,Default,,0000,0000,0000,,سنعدّ اليوم طاجن فطر وبطّ بصلصة البرتقال
Dialogue: 0,0:10:52.06,0:10:55.51,Default,,0000,0000,0000,,ستكون التحلية كلافوتي إجاص
Dialogue: 0,0:10:55.73,0:10:59.98,Default,,0000,0000,0000,,مهلك، ستطهين وأنت ترتدين خاتمك؟
Dialogue: 0,0:10:59.98,0:11:03.19,Default,,0000,0000,0000,,حتّى لو كنتِ بارعة، هذا ليس احترافياً
Dialogue: 0,0:11:06.81,0:11:09.11,Default,,0000,0000,0000,,!حتّى نيشيتاني-سان يرتدي خاتماً؟
Dialogue: 0,0:11:10.60,0:11:14.07,Default,,0000,0000,0000,,هذا التلميذ من تلك المعلّمة
Dialogue: 0,0:11:15.11,0:11:21.28,Default,,0000,0000,0000,,!يبدو هذا رائعاً! بطّ إذاً؟ أنا أحب البطّ
Dialogue: 0,0:11:21.28,0:11:21.88,Default,,0000,0000,0000,,يوكو-سان
Dialogue: 0,0:11:22.36,0:11:24.18,Default,,0000,0000,0000,,!أ-أجل! آسفة
Dialogue: 0,0:11:26.03,0:11:28.18,Default,,0000,0000,0000,,ماذا؟ ستغلقينه؟
Dialogue: 0,0:11:29.23,0:11:30.28,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:11:31.94,0:11:32.52,Default,,0000,0000,0000,,!يا إلهي
Dialogue: 0,0:11:33.19,0:11:35.48,Default,,0000,0000,0000,,...أنت يا أبي
Dialogue: 0,0:11:35.78,0:11:38.94,Default,,0000,0000,0000,,سنبدأ بصنع طاجن الفطر
Dialogue: 0,0:11:38.94,0:11:44.49,Default,,0000,0000,0000,,سأعدّه حتّى المنتصف، فراقبوني\Nوقوموا بتقليدي
Dialogue: 0,0:11:44.49,0:11:48.70,Default,,0000,0000,0000,,نقطّع 200 غراماً من الغاريقون أوّلاً
Dialogue: 0,0:11:49.48,0:11:52.23,Default,,0000,0000,0000,,أخبرني، ما هو هذا الغاريقون؟
Dialogue: 0,0:11:52.23,0:11:53.75,Default,,0000,0000,0000,,إنّه فطر
Dialogue: 0,0:11:54.69,0:11:56.89,Default,,0000,0000,0000,,نقليه بالزبدة
Dialogue: 0,0:11:58.48,0:12:02.11,Default,,0000,0000,0000,,تأكّدوا من غلي النداوة تماماً
Dialogue: 0,0:12:03.78,0:12:06.07,Default,,0000,0000,0000,,!بدأت رائحته تطيب
Dialogue: 0,0:12:06.07,0:12:08.59,Default,,0000,0000,0000,,لكنّك لن تستطيع أكله لفترة
Dialogue: 0,0:12:12.61,0:12:15.86,Default,,0000,0000,0000,,أنتِ تعدّينه ببراعة
Dialogue: 0,0:12:15.86,0:12:17.56,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:12:20.19,0:12:25.49,Default,,0000,0000,0000,,أنتِ عديمة الكفاءة حقّاً، لم تتغيّري عن الماضي البتّة
Dialogue: 0,0:12:27.57,0:12:31.70,Default,,0000,0000,0000,,ماذا؟ لا يمكنك فصل الصفار والبياض هكذا
Dialogue: 0,0:12:31.70,0:12:34.03,Default,,0000,0000,0000,,سنستعمل البياض فقط
Dialogue: 0,0:12:34.03,0:12:37.40,Default,,0000,0000,0000,,،آسفة، أستطيع الرؤية بعيني اليمنى فحسب\N...لذا يصعب عليّ الانتباه
Dialogue: 0,0:12:37.40,0:12:39.40,Default,,0000,0000,0000,,!بلا أعذار
Dialogue: 0,0:12:39.40,0:12:43.15,Default,,0000,0000,0000,,كما يوكو-سان، لا أرى جبنة الغرويير
Dialogue: 0,0:12:43.72,0:12:45.51,Default,,0000,0000,0000,,!آسفة! سأجلبها فوراً
Dialogue: 0,0:12:46.23,0:12:49.93,Default,,0000,0000,0000,,!لا أمل منكنّ أنتنّ الثلاثة حقّاً
Dialogue: 0,0:12:50.23,0:12:53.11,Default,,0000,0000,0000,,...يا لها من معلّمة حادّة الطباع
Dialogue: 0,0:12:53.11,0:12:56.89,Default,,0000,0000,0000,,بالفعل، لا عجب أنّ سونوكو هربت
Dialogue: 0,0:13:03.19,0:13:06.90,Default,,0000,0000,0000,,نيشيتاني-سان بارع، فلم تقل شيئاً له
Dialogue: 0,0:13:06.90,0:13:09.11,Default,,0000,0000,0000,,!لم أعد أحتمل
Dialogue: 0,0:13:10.00,0:13:11.37,Default,,0000,0000,0000,,!سأذهب للتدخين
Dialogue: 0,0:13:12.15,0:13:16.37,Default,,0000,0000,0000,,انتظر، الطريق الوحيد للخروج\Nهو عبر المطبخ
Dialogue: 0,0:13:17.07,0:13:20.23,Default,,0000,0000,0000,,كان هناك باب خلفيّ عند\Nدورة المياه وفقما أذكر
Dialogue: 0,0:13:29.23,0:13:31.18,Default,,0000,0000,0000,,ماذا؟ إنّه غير مقفل
Dialogue: 0,0:13:32.11,0:13:34.40,Default,,0000,0000,0000,,...يا للمنزل المهمل
Dialogue: 0,0:13:37.03,0:13:38.77,Default,,0000,0000,0000,,ما الذي حصل؟ انقطاع تيّار؟
Dialogue: 0,0:13:42.69,0:13:43.36,Default,,0000,0000,0000,,من هناك؟
Dialogue: 0,0:13:49.32,0:13:52.36,Default,,0000,0000,0000,,يوكو-سان! اذهبي لغرفة المفاتيح \N!الكهربائيّة وتفقّدي القواطع
Dialogue: 0,0:13:52.36,0:13:53.37,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:14:15.65,0:14:19.40,Default,,0000,0000,0000,,أخبرني، ألم تسمع صوت فتح باب مزلاجيّ؟
Dialogue: 0,0:14:19.40,0:14:20.78,Default,,0000,0000,0000,,باب مزلاجيّ؟
Dialogue: 0,0:14:20.78,0:14:21.90,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:14:23.03,0:14:24.57,Default,,0000,0000,0000,,آسفة، لكنّي أحتاج إنارة
Dialogue: 0,0:14:24.71,0:14:25.66,Default,,0000,0000,0000,,قادم
Dialogue: 0,0:14:27.57,0:14:29.74,On Top,,0000,0000,0000,,غرفة المفاتيح
Dialogue: 0,0:14:34.11,0:14:36.86,Default,,0000,0000,0000,,هذا غريب، لمَ المفتاح مطفأ؟
Dialogue: 0,0:14:36.86,0:14:38.26,Default,,0000,0000,0000,,سأفتحه
Dialogue: 0,0:14:41.86,0:14:43.42,Default,,0000,0000,0000,,...جليد
Dialogue: 0,0:14:45.19,0:14:46.96,Default,,0000,0000,0000,,لمَ يوجد هنا؟
Dialogue: 0,0:14:57.86,0:14:59.69,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:14:59.69,0:15:03.23,Default,,0000,0000,0000,,!يا عمّ! نصب أحدهم حيلةً لقطع التيّار
Dialogue: 0,0:15:03.23,0:15:04.19,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:04.19,0:15:08.03,Default,,0000,0000,0000,,ذاك الثقل مربوط بحلقة
Dialogue: 0,0:15:08.03,0:15:12.74,Default,,0000,0000,0000,,!وُضعت الحلقة حول المفتاح، والثقل على الجليد
Dialogue: 0,0:15:15.69,0:15:16.70,Default,,0000,0000,0000,,...أي
Dialogue: 0,0:15:17.88,0:15:19.73,Default,,0000,0000,0000,,...إذا ذاب الجليد
Dialogue: 0,0:15:22.03,0:15:26.13,Default,,0000,0000,0000,,ستُسحب الحلقة، وتطفئ المفتاح تلقائياً
Dialogue: 0,0:15:27.98,0:15:30.73,Default,,0000,0000,0000,,لكن من نصب هذا؟
Dialogue: 0,0:15:31.94,0:15:35.40,Default,,0000,0000,0000,,!لنرجع للفصل! ربما حصل شيءٌ ما
Dialogue: 0,0:15:35.40,0:15:35.93,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:15:40.57,0:15:41.69,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:15:41.69,0:15:42.35,Default,,0000,0000,0000,,ما الذي حصل؟
Dialogue: 0,0:15:42.86,0:15:47.06,Default,,0000,0000,0000,,المعلّمة! إنّها تقول أن صدرها يؤلمها\N!ولا تستطيع التنفّس
Dialogue: 0,0:15:52.15,0:15:54.61,Default,,0000,0000,0000,,!أخبروني، من فتح الباب المزلاجيّ الأمامي؟
Dialogue: 0,0:15:55.44,0:15:57.69,Default,,0000,0000,0000,,لم يفتحه أحد
Dialogue: 0,0:15:57.69,0:15:58.78,Default,,0000,0000,0000,,!لا أحد؟
Dialogue: 0,0:16:04.19,0:16:06.66,Default,,0000,0000,0000,,...ظـ-ظهري يؤلمني
Dialogue: 0,0:16:07.53,0:16:12.17,Default,,0000,0000,0000,,شعرتُ بألمٍ حادّ في ظهري\N...بينما الأنوار مُطفأة
Dialogue: 0,0:16:12.53,0:16:14.78,Default,,0000,0000,0000,,...التنفّس صعب
Dialogue: 0,0:16:14.78,0:16:16.76,Default,,0000,0000,0000,,هل أجهدتِ عضلةً ما؟
Dialogue: 0,0:16:18.23,0:16:20.97,Default,,0000,0000,0000,,!تعاني في التنفّس؟ أيمكن؟
Dialogue: 0,0:16:20.97,0:16:21.68,Default,,0000,0000,0000,,!اسمحوا لي قليلاً
Dialogue: 0,0:16:27.15,0:16:29.57,Default,,0000,0000,0000,,!ما-ما الذي تفعله؟
Dialogue: 0,0:16:29.57,0:16:30.81,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:16:32.69,0:16:34.48,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:16:34.48,0:16:36.36,Default,,0000,0000,0000,,!طعنتها نحلة
Dialogue: 0,0:16:36.86,0:16:37.82,Default,,0000,0000,0000,,نحلة؟
Dialogue: 0,0:16:37.82,0:16:38.82,Default,,0000,0000,0000,,انظر، هنا
Dialogue: 0,0:16:39.36,0:16:41.09,Default,,0000,0000,0000,,!توجد نقطة حمراء
Dialogue: 0,0:16:42.78,0:16:45.65,Default,,0000,0000,0000,,إنّها وراء رئتها اليمنى تماماً
Dialogue: 0,0:16:45.65,0:16:47.40,Default,,0000,0000,0000,,رئتها اليمنى؟
Dialogue: 0,0:16:48.32,0:16:49.58,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:16:50.07,0:16:55.03,Default,,0000,0000,0000,,!ران! اطلبي الإسعاف فوراً\N!واتّصلي بالمفتّش ميغوري أيضاً
Dialogue: 0,0:16:55.03,0:16:56.47,Default,,0000,0000,0000,,!حـ-حسناً
Dialogue: 0,0:16:56.90,0:16:59.82,Default,,0000,0000,0000,,ستكون في خطر إذا لم\N!ننقلها للمشفى فوراً
Dialogue: 0,0:16:59.82,0:17:02.07,Default,,0000,0000,0000,,لكن من فعل هذا؟
Dialogue: 0,0:17:03.53,0:17:07.03,Default,,0000,0000,0000,,يا جماعة، لا يغادر أحدكم الفصل رجاءً
Dialogue: 0,0:17:07.03,0:17:09.35,Default,,0000,0000,0000,,ولا تلمسوا الباب الأمامي أيضاً
Dialogue: 0,0:17:09.86,0:17:13.36,Default,,0000,0000,0000,,أيّ حقّ لديك لتملي علينا الأوامر؟
Dialogue: 0,0:17:14.86,0:17:19.28,Default,,0000,0000,0000,,،اعذروني على التأخّر بتقديم نفسي\Nلكنّي موري كوغورو، مُتحرٍّ
Dialogue: 0,0:17:21.23,0:17:22.78,Default,,0000,0000,0000,,...ذاك المتحرّي الشهير
Dialogue: 0,0:17:23.08,0:17:25.88,Default,,0000,0000,0000,,موري كوغورو؟
Dialogue: 0,0:17:29.08,0:17:32.66,Default,,0000,0000,0000,,هلّا شرحت ما حصل هنا؟
Dialogue: 0,0:17:32.66,0:17:37.66,Default,,0000,0000,0000,,أظنّ أحدهم طعن أويموري ميتشي-سان في ظهرها
Dialogue: 0,0:17:37.66,0:17:42.69,Default,,0000,0000,0000,,بشيءٍ حاد الرأس، مثل كسّارة ثلج أو مثقاب
Dialogue: 0,0:17:43.20,0:17:44.53,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:44.53,0:17:45.72,Default,,0000,0000,0000,,...طُعنت
Dialogue: 0,0:17:45.72,0:17:47.11,Default,,0000,0000,0000,,في ظهرها؟
Dialogue: 0,0:17:47.33,0:17:54.33,Default,,0000,0000,0000,,أجل، كانت هناك نقطة حمراء على\Nظهرها، كما لو لسعتها حشرة
Dialogue: 0,0:17:54.33,0:17:59.08,Default,,0000,0000,0000,,تترك كسّارة الثلج وما شابهها آثاراً كتلك
Dialogue: 0,0:17:59.66,0:18:04.99,Default,,0000,0000,0000,,ورغم أنّ طعنة كسّارة الثلج\N،لا تبدو شيئاً كبيراً
Dialogue: 0,0:18:04.99,0:18:08.55,Default,,0000,0000,0000,,لكنّها قد تخترق الرئتين وأعضاء\Nداخليّة أخرى في حالات كثيرة
Dialogue: 0,0:18:09.24,0:18:13.49,Default,,0000,0000,0000,,...سبب ألم صدرها ومعاناتها في التنفّس إذاً
Dialogue: 0,0:18:13.49,0:18:16.26,Default,,0000,0000,0000,,لعلّ هنالك ثقباً برئتها
Dialogue: 0,0:18:16.78,0:18:19.45,Default,,0000,0000,0000,,ومن الفاعل إذاً؟
Dialogue: 0,0:18:19.45,0:18:25.33,Default,,0000,0000,0000,,سمعت ران والبقيّة صوت فتح الباب\N،المزلاجيّ بعد انقطاع التيّار بقليل
Dialogue: 0,0:18:25.33,0:18:28.33,Default,,0000,0000,0000,,فمن المرجّح أنّ الفاعل أتى من الخارج
Dialogue: 0,0:18:28.33,0:18:28.94,Default,,0000,0000,0000,,من الخارج؟
Dialogue: 0,0:18:29.66,0:18:33.37,Default,,0000,0000,0000,,لكن لا ينفي ذلك احتماليّة الهجوم الداخليّ
Dialogue: 0,0:18:34.49,0:18:36.08,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:18:36.08,0:18:39.08,Default,,0000,0000,0000,,أرجو ألّا يغادر أحدكم الغرفة
Dialogue: 0,0:18:39.08,0:18:42.03,Default,,0000,0000,0000,,سنرفع البصمات عن الباب المزلاجيّ أوّلاً
Dialogue: 0,0:18:42.03,0:18:45.37,Default,,0000,0000,0000,,من كان آخر شخص لمس مقبض الباب؟
Dialogue: 0,0:18:45.66,0:18:47.53,Default,,0000,0000,0000,,!نيشيتاني-سان
Dialogue: 0,0:18:47.53,0:18:51.37,Default,,0000,0000,0000,,كان آخر الواصلين هنا
Dialogue: 0,0:18:51.37,0:18:57.37,Default,,0000,0000,0000,,وعندما رجعت أويموري سينسي، فتح الباب من الداخل
Dialogue: 0,0:18:57.37,0:19:00.37,Default,,0000,0000,0000,,سنحتاج لأخذ بصماتك أوّلاً
Dialogue: 0,0:19:00.37,0:19:03.83,Default,,0000,0000,0000,,للتمييز بينها وبين بصمات الفاعل
Dialogue: 0,0:19:03.83,0:19:06.20,Default,,0000,0000,0000,,أخبرني عن ذاك الموضوع الآخر أيضاً
Dialogue: 0,0:19:06.20,0:19:07.37,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:19:09.53,0:19:13.33,Default,,0000,0000,0000,,كان هذا الباب الخلفيّ غير مقفل إذاً؟
Dialogue: 0,0:19:13.33,0:19:14.99,Default,,0000,0000,0000,,أجل حضرة المفتّش
Dialogue: 0,0:19:14.99,0:19:21.78,Default,,0000,0000,0000,,وفق استنتاجي، فقد تسلّل الفاعل لغرفة المفاتيح\Nهذه عبر الباب الخلفيّ مع بدء الفصل
Dialogue: 0,0:19:21.78,0:19:24.08,Default,,0000,0000,0000,,ونصب حيلة القالب الجليديّ
Dialogue: 0,0:19:25.49,0:19:28.50,Default,,0000,0000,0000,,ذهب بعدها للجانب الأمامي من هنا
Dialogue: 0,0:19:29.33,0:19:33.96,Default,,0000,0000,0000,,واختبأ في شجيرات الفناء، وانتظر انقطاع التيّار
Dialogue: 0,0:19:34.62,0:19:39.87,Default,,0000,0000,0000,,ولحظة انقطاعه، فتح الباب واندفع لغرفة الفصل
Dialogue: 0,0:19:39.87,0:19:42.49,Default,,0000,0000,0000,,!وطعن أويموري-سان ثمّ هرب
Dialogue: 0,0:19:42.49,0:19:45.31,Default,,0000,0000,0000,,لكن كانت الغرفة مُظلمة
Dialogue: 0,0:19:45.99,0:19:49.49,Default,,0000,0000,0000,,كيف وجدها القاتل؟
Dialogue: 0,0:19:49.49,0:19:51.33,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:19:51.33,0:19:56.08,Default,,0000,0000,0000,,،لعلّها كانت ترتدي شيئاً لامعاً\N!أو شيئاً جعلها تبرز
Dialogue: 0,0:19:56.08,0:19:56.99,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:19:58.03,0:20:01.16,Default,,0000,0000,0000,,لم تكن ترتدي أشياء كتلك
Dialogue: 0,0:20:01.16,0:20:03.62,Default,,0000,0000,0000,,أظنّ ذلك أيضاً
Dialogue: 0,0:20:03.62,0:20:07.83,Default,,0000,0000,0000,,لا بدّ أنّ الفاعل استعمل مناظير\Nأشعّة تحت الحمراء وما شابه إذاً
Dialogue: 0,0:20:07.83,0:20:10.41,Default,,0000,0000,0000,,يمكنك الرؤية في الظلام بها
Dialogue: 0,0:20:10.41,0:20:10.96,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:11.24,0:20:17.42,Default,,0000,0000,0000,,أأنت جاد؟ لا تستطيع الحصول على\Nمناظير الأشعّة الحمراء بسهولة
Dialogue: 0,0:20:20.20,0:20:25.08,Default,,0000,0000,0000,,بوضع ذلك جانباً، قال العمّ أنّ احتمالية\N،الهجوم الخارجيّ عالية
Dialogue: 0,0:20:25.08,0:20:29.03,Default,,0000,0000,0000,,لكن عدم وجود آثار حذاء الفاعل\Nعلى الأرض يثير الغرابة
Dialogue: 0,0:20:31.83,0:20:35.45,Default,,0000,0000,0000,,هل تكبّد عناء خلع حذائه قبل الدخول؟
Dialogue: 0,0:20:35.45,0:20:36.87,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:20:36.87,0:20:38.40,Default,,0000,0000,0000,,ما النتيجة؟
Dialogue: 0,0:20:38.74,0:20:46.54,Default,,0000,0000,0000,,حسناً، وجدنا بصمات نيشيتاني-سان وحده\Nعلى مقبضَي الباب
Dialogue: 0,0:20:47.24,0:20:50.37,Default,,0000,0000,0000,,كان الفاعل يرتدي قفّازات غالباً
Dialogue: 0,0:20:50.37,0:20:55.66,Default,,0000,0000,0000,,ونيشيتاني-سان آخر من لمس الباب، فلا عجب
Dialogue: 0,0:20:55.66,0:20:56.55,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:56.55,0:21:01.37,Default,,0000,0000,0000,,،لكنّ الغريب أنّ البصمات على المقبض الخارجي كانت مكتملة
Dialogue: 0,0:21:01.37,0:21:04.66,Default,,0000,0000,0000,,بينما بصمات المقبض الداخلي ممحوّة قليلاً
Dialogue: 0,0:21:04.66,0:21:05.47,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:21:07.66,0:21:09.14,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:21:09.83,0:21:13.66,Default,,0000,0000,0000,,إذا فتح الفاعل الباب\N،من الخارج بقفّازات
Dialogue: 0,0:21:13.66,0:21:17.07,Default,,0000,0000,0000,,فيُفترض أنّ بصمات نيشيتاني-سان\N!على المقبض الخارجيّ قد اختفت
Dialogue: 0,0:21:17.83,0:21:20.90,Default,,0000,0000,0000,,كون البصمات على المقبض \N...الداخليّ هي ما مُحيت
Dialogue: 0,0:21:21.45,0:21:24.87,Default,,0000,0000,0000,,!يعني أنّ الفاعل فتح الباب من الداخل
Dialogue: 0,0:21:25.16,0:21:27.74,Default,,0000,0000,0000,,ماذا؟ ما الذي تلمّح له؟
Dialogue: 0,0:21:27.74,0:21:30.71,Default,,0000,0000,0000,,!لم يدخل الفاعل من الخارج
Dialogue: 0,0:21:31.08,0:21:36.67,Default,,0000,0000,0000,,فتح أحد المتواجدين في الفصل\N!الباب من الداخل لإيهامنا بذلك
Dialogue: 0,0:21:37.45,0:21:41.26,Default,,0000,0000,0000,,!واستعمل منديلاً أو ما شابه لفعل ذلك غالباً
Dialogue: 0,0:21:42.00,0:21:46.37,Default,,0000,0000,0000,,!أي أنّ الفاعل أحدكم الأربعة
Dialogue: 0,0:21:48.76,0:21:50.03,Default,,0000,0000,0000,,!لا-لا يمكن
Dialogue: 0,0:21:54.89,0:21:55.91,Default,,0000,0000,0000,,إنّه أنا
Dialogue: 0,0:21:57.08,0:21:58.66,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:21:58.66,0:22:00.03,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:22:02.15,0:22:04.49,Default,,0000,0000,0000,,تُوفيت أويموري-سان للتوّ بسبب فشل تنفّسي
Dialogue: 0,0:22:04.49,0:22:06.41,Default,,0000,0000,0000,,من ثقب رئويّ
Dialogue: 0,0:22:14.24,0:22:18.00,Default,,0000,0000,0000,,هذا يعني أنّ هذه القضيّة\Nأصبحت قضيّة جريمة قتل
Dialogue: 0,0:24:02.86,0:24:05.02,Default,,0000,0000,0000,,!المجرم هو أنت يا كازوي-سان
Dialogue: 0,0:24:07.32,0:24:13.40,Default,,0000,0000,0000,,نيشيتاني-كن، سمعت أنّ حماتي\Nقرّرت قطع دعمها الماليّ لك
Dialogue: 0,0:24:14.98,0:24:20.70,Default,,0000,0000,0000,,يوكو-سان، كنتِ حاقدةً عليها\Nبدورك لسرقتها وصفاتك
Dialogue: 0,0:24:21.28,0:24:23.19,Default,,0000,0000,0000,,!اكتشفتُ هذه المرّة
Dialogue: 0,0:24:22.72,0:24:24.59,Default,,0000,0000,0000,,!المجرم هو أنت يا كاورو-سان
Dialogue: 0,0:24:25.72,0:24:31.75,On Top,,0000,0000,0000,,جريمة قتل فصل الطهو الدراسيّ\N(الجزء الثاني)
Dialogue: 0,0:24:26.90,0:24:28.44,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:28.44,0:24:31.03,Default,,0000,0000,0000,,جريمة قتل فصل الطهو الدراسيّ\N(الجزء الثاني)
Dialogue: 0,0:24:47.89,0:24:50.18,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:50.18,0:24:51.65,Default,,0000,0000,0000,,خاتم
Dialogue: 0,0:24:51.96,0:24:53.72,Default,,0000,0000,0000,,!في الحلقة القادمة، أعرف هويّة المجرم
Dialogue: 0,0:24:53.72,0:24:55.96,Default,,0000,0000,0000,,!إنّه الرامي الذي تسبّبت رميته الهائجة بدورة كاملة

