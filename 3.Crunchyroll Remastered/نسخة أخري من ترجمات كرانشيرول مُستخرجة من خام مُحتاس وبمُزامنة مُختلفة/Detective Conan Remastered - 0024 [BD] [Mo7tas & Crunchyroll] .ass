Dialogue: 0,0:00:01.51,0:00:03.01,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:03.01,0:00:05.93,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.93,0:00:08.38,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.85,0:00:10.47,Default,,0000,0000,0000,,قضيّة اليوم عن فقدان ذاكرة
Dialogue: 0,0:00:10.47,0:00:12.12,Default,,0000,0000,0000,,يتربّص فخّ في ظلال امرأة جميلة
Dialogue: 0,0:00:12.12,0:00:15.54,Default,,0000,0000,0000,,!يمكنكم خداع العمّ كوغورو، لكن الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.95,0:01:50.12,Default,,0000,0000,0000,,قضيّة المرأة فاقدة الذاكرة الغامضة
Dialogue: 0,0:02:16.72,0:02:19.72,Default,,0000,0000,0000,,المجرم الذي اُعتقل بفضل استنتاجات"\Nالمتحرّي موري كوغورو العظيم
Dialogue: 0,0:02:19.72,0:02:22.66,Default,,0000,0000,0000,,المدعوّ يوتا هيتوشي قد لاذ بالفرار البارحة
Dialogue: 0,0:02:22.66,0:02:25.69,Default,,0000,0000,0000,,من سجن موساشينو
Dialogue: 0,0:02:26.19,0:02:28.11,Default,,0000,0000,0000,,يودا مجرمٌ دقيق الحسابات
Dialogue: 0,0:02:28.11,0:02:30.40,Default,,0000,0000,0000,,ويجيد العديد من الحيل الماكرة
Dialogue: 0,0:02:30.40,0:02:34.85,Default,,0000,0000,0000,,قتل زوجته كيكو-سان لأخذ مبلغ\Nوثيقة تأمين حياتها
Dialogue: 0,0:02:34.85,0:02:39.51,Default,,0000,0000,0000,,لكنه اُعتقل بفضل مهارات موري\N"العالية في التحرّي
Dialogue: 0,0:02:39.51,0:02:40.61,Default,,0000,0000,0000,,أسيكون الأمر على ما يرام؟
Dialogue: 0,0:02:41.71,0:02:42.71,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:02:42.71,0:02:45.34,Default,,0000,0000,0000,,ألا تخاف أن يأتي للانتقام؟
Dialogue: 0,0:02:45.34,0:02:46.11,Default,,0000,0000,0000,,الانتقام؟
Dialogue: 0,0:02:46.59,0:02:47.94,Default,,0000,0000,0000,,...فقد قال عند اعتقاله
Dialogue: 0,0:02:50.84,0:02:54.94,Default,,0000,0000,0000,,سآخذ بثأري يوماً ما، تذكّر كلامي يا موري كوغورو
Dialogue: 0,0:02:55.33,0:02:56.90,Default,,0000,0000,0000,,أتذكر؟
Dialogue: 0,0:02:57.70,0:03:01.48,Default,,0000,0000,0000,,سنكون بخير يا ران، لا حاجة للقلق
Dialogue: 0,0:03:01.48,0:03:03.65,Default,,0000,0000,0000,,كيف لك أن تكون بهذه اللا مبالاة؟
Dialogue: 0,0:03:03.65,0:03:05.36,Default,,0000,0000,0000,,!أنتَ المُستهدف
Dialogue: 0,0:03:07.07,0:03:12.60,Default,,0000,0000,0000,,يجب أن أكون أنا من يستهدفه وليس العمّ
Dialogue: 0,0:03:12.60,0:03:16.77,Default,,0000,0000,0000,,!وبناءً على هذا، أنت القاتل يا يودا! سلّم نفسك
Dialogue: 0,0:03:17.60,0:03:19.47,Default,,0000,0000,0000,,عانى كي يستطيع الهرب
Dialogue: 0,0:03:19.47,0:03:21.80,Default,,0000,0000,0000,,لن يخاطر بإعادة اعتقاله
Dialogue: 0,0:03:21.80,0:03:23.73,Default,,0000,0000,0000,,إنّه في طريقه خارج البلاد الآن غالباً
Dialogue: 0,0:03:24.13,0:03:25.73,Default,,0000,0000,0000,,آمل ذلك
Dialogue: 0,0:03:26.30,0:03:28.19,Default,,0000,0000,0000,,!حسنٌ، وقت العمل
Dialogue: 0,0:03:28.88,0:03:30.83,Default,,0000,0000,0000,,!سأرافقك
Dialogue: 0,0:03:30.83,0:03:31.58,Default,,0000,0000,0000,,إلى أين؟
Dialogue: 0,0:03:31.58,0:03:32.52,Default,,0000,0000,0000,,ستأتي أيضاً يا كونان-كن
Dialogue: 0,0:03:32.94,0:03:33.98,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:03:35.16,0:03:38.07,Default,,0000,0000,0000,,!لحماية أبي بالطبع
Dialogue: 0,0:03:46.98,0:03:49.44,Default,,0000,0000,0000,,تعال، أنا مستعدة لك
Dialogue: 0,0:03:51.89,0:03:57.56,Default,,0000,0000,0000,,يا إلهي، لمَ كان عليّ مرافقتهما هنا؟
Dialogue: 0,0:04:01.71,0:04:05.94,Default,,0000,0000,0000,,ما خطب هذا الرجل؟ لا يشاهد السباق
Dialogue: 0,0:04:05.94,0:04:09.53,Default,,0000,0000,0000,,!هيّا! هيّا! أسرع
Dialogue: 0,0:04:10.09,0:04:10.92,Default,,0000,0000,0000,,العمّ؟
Dialogue: 0,0:04:11.66,0:04:12.63,Default,,0000,0000,0000,,...أيمكن أنّه
Dialogue: 0,0:04:13.66,0:04:14.10,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:19.87,0:04:23.69,Default,,0000,0000,0000,,تبّاً، ضربتك مرّةً ثم طار كلّ حظي
Dialogue: 0,0:04:24.11,0:04:26.32,Default,,0000,0000,0000,,لا تلم الآخرين
Dialogue: 0,0:04:34.31,0:04:36.11,Default,,0000,0000,0000,,!رجع حظّي
Dialogue: 0,0:04:41.05,0:04:42.76,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:04:42.76,0:04:44.73,Default,,0000,0000,0000,,لم يرجع حظّي
Dialogue: 0,0:04:50.01,0:04:52.69,Default,,0000,0000,0000,,لهذه المرأة عضلات مفتولة
Dialogue: 0,0:05:03.15,0:05:06.15,Default,,0000,0000,0000,,لا تعاني إصابةً بالغة إذاً؟
Dialogue: 0,0:05:06.15,0:05:09.44,Default,,0000,0000,0000,,كلا، مشكلة واحدة فقط
Dialogue: 0,0:05:09.85,0:05:14.90,Default,,0000,0000,0000,,كلّ ما تتذكره أنّ اسمها مايا
Dialogue: 0,0:05:17.23,0:05:17.97,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:05:17.97,0:05:19.36,Default,,0000,0000,0000,,فقدت ذاكرتها؟
Dialogue: 0,0:05:19.36,0:05:23.13,Default,,0000,0000,0000,,إنّها حالة فقدان ذاكرة انتكاسية \Nخفيفة تقنياً
Dialogue: 0,0:05:23.13,0:05:25.02,Default,,0000,0000,0000,,أي فقدان ذاكرة جزئي
Dialogue: 0,0:05:25.80,0:05:28.23,Default,,0000,0000,0000,,ربما حصل ذلك عندما\Nسقطت من الأدراج
Dialogue: 0,0:05:28.63,0:05:30.79,Default,,0000,0000,0000,,كلّا، بل قبلها
Dialogue: 0,0:05:30.79,0:05:32.23,Default,,0000,0000,0000,,...فقد كانت آنذاك
Dialogue: 0,0:05:35.04,0:05:36.52,Default,,0000,0000,0000,,لكن أين؟
Dialogue: 0,0:05:37.00,0:05:38.29,Default,,0000,0000,0000,,هل ستتحسن حالتها؟
Dialogue: 0,0:05:38.29,0:05:39.79,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:05:39.79,0:05:43.49,Default,,0000,0000,0000,,لكن قد يحصل ذلك غداً أو بعد\Nشهر أو حتّى بعد 3 أعوام
Dialogue: 0,0:05:43.49,0:05:45.45,Default,,0000,0000,0000,,لا مجال أن نعرف
Dialogue: 0,0:05:45.45,0:05:45.98,Default,,0000,0000,0000,,...هذا فظيع
Dialogue: 0,0:05:45.98,0:05:48.70,Default,,0000,0000,0000,,!حسنٌ! وقت المتحرّي العظيم
Dialogue: 0,0:05:48.70,0:05:52.44,Default,,0000,0000,0000,,!سأرجع أنا موري كوغورو ذاكرة مايا-سان
Dialogue: 0,0:05:52.98,0:05:56.40,Default,,0000,0000,0000,,ما علاقة ذاك بمُتحرٍّ عظيم؟
Dialogue: 0,0:05:58.10,0:06:01.31,Default,,0000,0000,0000,,مرحباً! كيف حالك؟
Dialogue: 0,0:06:04.09,0:06:05.97,Default,,0000,0000,0000,,اسمك مايا-سان، صحيح؟
Dialogue: 0,0:06:05.97,0:06:07.97,Default,,0000,0000,0000,,أنا موري، موري كوغورو
Dialogue: 0,0:06:07.97,0:06:08.78,Default,,0000,0000,0000,,مُتحرٍّ
Dialogue: 0,0:06:09.15,0:06:11.18,Default,,0000,0000,0000,,مُتحرٍّ؟
Dialogue: 0,0:06:11.83,0:06:14.63,Default,,0000,0000,0000,,استرخي وحاولي التذكر
Dialogue: 0,0:06:14.63,0:06:19.67,Default,,0000,0000,0000,,ألا تذكرين أين فقدتِ\Nذاكرتك على الأقل؟
Dialogue: 0,0:06:19.67,0:06:20.15,Default,,0000,0000,0000,,...آسفة
Dialogue: 0,0:06:20.66,0:06:24.61,Default,,0000,0000,0000,,لم تكوني قادرةً على قطع\Nمسافة طويلة في حالتك تلك
Dialogue: 0,0:06:24.99,0:06:30.62,Default,,0000,0000,0000,,أستنتج أنّك فقدتِ ذاكرتك في مكان بالقرب
Dialogue: 0,0:06:30.62,0:06:32.76,Default,,0000,0000,0000,,أهناك شيءٌ تكادين تذكرينه؟
Dialogue: 0,0:06:34.65,0:06:37.15,Default,,0000,0000,0000,,يبدو أنّكِ تتمرنين
Dialogue: 0,0:06:37.15,0:06:39.03,Default,,0000,0000,0000,,فلعلك كنتِ في طريق \Nعودتك من الصالة الرياضية
Dialogue: 0,0:06:39.48,0:06:40.24,Default,,0000,0000,0000,,الصالة الرياضية؟
Dialogue: 0,0:06:41.85,0:06:45.55,Default,,0000,0000,0000,,جسمك متناسقٌ فعلاً
Dialogue: 0,0:06:45.55,0:06:50.49,Default,,0000,0000,0000,,أنا متأكدٌ أنّكِ تمارسين رياضةً\Nمثل بناء الأجسام أو رفع الأثقال
Dialogue: 0,0:06:51.13,0:06:53.44,Default,,0000,0000,0000,,هناك ندوب على سبّابتيها
Dialogue: 0,0:06:53.88,0:06:57.23,Default,,0000,0000,0000,,ما الذي تمارسه كي تُصاب بتلك الندوب؟
Dialogue: 0,0:06:58.59,0:07:02.83,Default,,0000,0000,0000,,أخبريني، هل يتضمن عملك أيّ أسلاك؟
Dialogue: 0,0:07:05.16,0:07:07.55,Default,,0000,0000,0000,,...أنا... أنا
Dialogue: 0,0:07:11.82,0:07:13.57,Default,,0000,0000,0000,,!ما كان ذلك؟
Dialogue: 0,0:07:13.57,0:07:15.15,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:07:15.15,0:07:18.94,Default,,0000,0000,0000,,!رأسي! أشعر بألم! لا أستطيع التذكر أكثر
Dialogue: 0,0:07:18.94,0:07:20.40,Default,,0000,0000,0000,,!ساعدني
Dialogue: 0,0:07:20.97,0:07:25.35,Default,,0000,0000,0000,,!كونان! انظر لمَ فعلته
Dialogue: 0,0:07:25.35,0:07:28.61,Default,,0000,0000,0000,,!لكن، يبدو أنّ حظّي قد رجع
Dialogue: 0,0:07:30.80,0:07:32.21,Default,,0000,0000,0000,,يا للمأزق
Dialogue: 0,0:07:33.30,0:07:37.17,Default,,0000,0000,0000,,أيمكنك إرجاع ذاكرتها حقاً؟
Dialogue: 0,0:07:37.17,0:07:39.68,Default,,0000,0000,0000,,مُطلقاً، لا أملك أيّ فكرة
Dialogue: 0,0:07:39.68,0:07:40.53,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:07:40.53,0:07:43.98,Default,,0000,0000,0000,,هل أخذت هذه من المرأة في المشفى؟
Dialogue: 0,0:07:44.45,0:07:46.94,Default,,0000,0000,0000,,أجل، كان كلّ ما بحوزتها
Dialogue: 0,0:07:48.58,0:07:53.02,Default,,0000,0000,0000,,قطعة أحجية وورقة ممزقة من كتاب
Dialogue: 0,0:07:53.65,0:07:56.98,Default,,0000,0000,0000,,الإنجيل وفقاً لماثيو، الفصل 5، الآية 3
Dialogue: 0,0:07:57.69,0:07:58.94,Default,,0000,0000,0000,,أليس هذا من الإنجيل؟
Dialogue: 0,0:07:59.73,0:08:00.85,Default,,0000,0000,0000,,الإنجيل؟
Dialogue: 0,0:08:00.85,0:08:03.06,Default,,0000,0000,0000,,ماذا؟ ذلك صحيح
Dialogue: 0,0:08:03.06,0:08:06.23,Default,,0000,0000,0000,,مما يعني... لعلّها نصرانية
Dialogue: 0,0:08:06.23,0:08:08.52,Default,,0000,0000,0000,,هل يمزّق نصرانيّ الإنجيل؟
Dialogue: 0,0:08:08.52,0:08:10.96,Default,,0000,0000,0000,,ربما ليست كذلك
Dialogue: 0,0:08:10.96,0:08:11.73,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:08:12.42,0:08:14.34,Default,,0000,0000,0000,,ربما استعملته كمذكّرة
Dialogue: 0,0:08:14.34,0:08:15.67,Default,,0000,0000,0000,,مذكّرة؟
Dialogue: 0,0:08:15.67,0:08:18.65,Default,,0000,0000,0000,,انظري، توجد آثار خفيفة\Nكما لو كانت كتابة
Dialogue: 0,0:08:19.34,0:08:20.54,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:08:20.54,0:08:23.16,Default,,0000,0000,0000,,هكذا إذاً، لا بدّ أنها كتبت\Nعلى الصفحة السابقة
Dialogue: 0,0:08:23.16,0:08:26.15,Default,,0000,0000,0000,,ومزّقت هذه بالخطأ مع الأخرى
Dialogue: 0,0:08:33.40,0:08:35.45,Default,,0000,0000,0000,,9.13
Dialogue: 0,0:08:36.05,0:08:38.77,Default,,0000,0000,0000,,"العشاء الأخير"
Dialogue: 0,0:08:39.28,0:08:41.27,Default,,0000,0000,0000,,ربما كان موعد عشاء
Dialogue: 0,0:08:41.27,0:08:43.68,Default,,0000,0000,0000,,!هذه هي، لا شكّ
Dialogue: 0,0:08:43.68,0:08:45.86,Default,,0000,0000,0000,,لكن مع من؟
Dialogue: 0,0:08:46.39,0:08:48.64,Default,,0000,0000,0000,,...مع من، ذلك حتماً
Dialogue: 0,0:08:48.64,0:08:49.78,Default,,0000,0000,0000,,لحظة، مع من؟
Dialogue: 0,0:08:50.59,0:08:52.72,Default,,0000,0000,0000,,أين كتبتْ هذه؟
Dialogue: 0,0:08:52.72,0:08:57.13,Default,,0000,0000,0000,,قد يكون من الأسرع إطلاعها\Nعلى شيء يصلها بهويّتها
Dialogue: 0,0:08:57.13,0:09:01.73,Default,,0000,0000,0000,,أين قد تستعمل إنجيلاً مكان مذكّرة\Nدون وعي لتدوين ملاحظات؟
Dialogue: 0,0:09:02.29,0:09:05.63,Default,,0000,0000,0000,,،يمكنني تصورها تسجّل وهي على الهاتف\Nثم تمزق الصفحة
Dialogue: 0,0:09:07.33,0:09:07.92,Default,,0000,0000,0000,,!فندق
Dialogue: 0,0:09:09.40,0:09:12.14,Default,,0000,0000,0000,,تضع الفنادق أناجيل في كلّ غرفها، صحيح؟
Dialogue: 0,0:09:12.46,0:09:13.22,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:13.22,0:09:14.10,Default,,0000,0000,0000,,الفنادق؟
Dialogue: 0,0:09:14.72,0:09:17.57,Default,,0000,0000,0000,,هذه ورقة جميلة إن أمعنت النظر
Dialogue: 0,0:09:17.57,0:09:20.35,Default,,0000,0000,0000,,إنّها ملساء وعالية الجودة
Dialogue: 0,0:09:20.35,0:09:24.88,Default,,0000,0000,0000,,وجدتُها! لا بدّ أن يكون فندقاً من 3 نجوم\Nأو أعلى على الأقل
Dialogue: 0,0:09:24.88,0:09:26.52,Default,,0000,0000,0000,,يقلّص هذا قائمة الفنادق المحتملة
Dialogue: 0,0:09:27.04,0:09:30.21,Default,,0000,0000,0000,,صحيح يا أبي، لنتفقد كلّ فندق على حدة
Dialogue: 0,0:09:30.21,0:09:31.48,Default,,0000,0000,0000,,!لنذهب
Dialogue: 0,0:09:32.95,0:09:34.44,Default,,0000,0000,0000,,ستأتيان؟
Dialogue: 0,0:09:34.74,0:09:36.11,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:09:36.11,0:09:38.44,Default,,0000,0000,0000,,!لا شيء
Dialogue: 0,0:09:38.44,0:09:40.89,On Top,,0000,0000,0000,,مشفى يوكوياما العام
Dialogue: 0,0:09:41.69,0:09:43.33,Default,,0000,0000,0000,,هل ستكونين بخير حقاً؟
Dialogue: 0,0:09:43.33,0:09:46.02,Default,,0000,0000,0000,,أجل، حصلتُ على إذن الطبيب
Dialogue: 0,0:09:46.02,0:09:48.57,Default,,0000,0000,0000,,لم أكن أسألك
Dialogue: 0,0:09:48.57,0:09:50.89,Default,,0000,0000,0000,,سأكون بخير
Dialogue: 0,0:09:50.89,0:09:55.31,Default,,0000,0000,0000,,أريد فقط معرفة من أكون\Nومن أين أنا
Dialogue: 0,0:09:55.31,0:09:57.82,Default,,0000,0000,0000,,!دعني أرافقك رجاءً
Dialogue: 0,0:09:58.22,0:09:59.89,Default,,0000,0000,0000,,دعي الأمر لي
Dialogue: 0,0:09:59.89,0:10:01.55,Default,,0000,0000,0000,,استعملتُ مهارات استنتاجي
Dialogue: 0,0:10:01.55,0:10:06.05,Default,,0000,0000,0000,,وأدركتُ أنّ هذه صفحة إنجيل\Nمن فندق مرموق
Dialogue: 0,0:10:06.05,0:10:09.74,Default,,0000,0000,0000,,سأكتشف أيّ فندق كنتِ تقيمين فيه سريعاً
Dialogue: 0,0:10:10.79,0:10:13.69,Default,,0000,0000,0000,,...لن نعاني إن كان كلّ شيء بهذه السهولة
Dialogue: 0,0:10:13.69,0:10:17.15,Default,,0000,0000,0000,,!لننطلق نحو فندق ماونت فيو أوّلاً
Dialogue: 0,0:10:17.49,0:10:19.83,Default,,0000,0000,0000,,!سنغادر يا أبي
Dialogue: 0,0:10:22.98,0:10:26.86,Default,,0000,0000,0000,,هل كانت هذه السيّدة تقطن في فندقكم؟
Dialogue: 0,0:10:26.86,0:10:27.57,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:27.57,0:10:30.52,Default,,0000,0000,0000,,هل كانت نزيلةً في هذا الفندق
Dialogue: 0,0:10:31.10,0:10:33.44,Default,,0000,0000,0000,,أرأيتم هذه السيّدة قبلاً؟
Dialogue: 0,0:10:49.92,0:10:53.35,Default,,0000,0000,0000,,هذا الفندق الثاني عشر! أشعر بالإرهاق
Dialogue: 0,0:10:57.20,0:10:59.53,Default,,0000,0000,0000,,مرحباً بعودتك يا تاتشيبانا-ساما
Dialogue: 0,0:11:00.90,0:11:03.19,Default,,0000,0000,0000,,!تـ-تعرف من تكون؟
Dialogue: 0,0:11:03.53,0:11:06.52,Default,,0000,0000,0000,,أجل، إنّها نزيلةٌ هنا
Dialogue: 0,0:11:06.99,0:11:10.98,Default,,0000,0000,0000,,تاتشيبانا مايا-ساما، سجّلت دخولها قبل يومين
Dialogue: 0,0:11:11.39,0:11:12.98,Default,,0000,0000,0000,,!نجحنا يا مايا-سان
Dialogue: 0,0:11:26.72,0:11:28.98,Default,,0000,0000,0000,,إصابة، إنّه هو بلا شك
Dialogue: 0,0:11:34.81,0:11:38.37,Default,,0000,0000,0000,,يا إلهي... سأبحث في أغراضها فابتعدا أنتما
Dialogue: 0,0:11:38.37,0:11:38.98,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:42.49,0:11:45.86,Default,,0000,0000,0000,,لا شيء هنا قد يساعد في تحديد هويّتك
Dialogue: 0,0:11:45.86,0:11:47.86,Default,,0000,0000,0000,,ألا تتذكرين شيئاً؟
Dialogue: 0,0:11:50.69,0:11:52.39,Default,,0000,0000,0000,,...مشكلة
Dialogue: 0,0:11:52.39,0:11:55.52,Default,,0000,0000,0000,,العنوان ورقم الهاتف المسجّلان عند الفندق
Dialogue: 0,0:11:55.52,0:11:57.86,Default,,0000,0000,0000,,كانا مزيّفين وفقما يبدو
Dialogue: 0,0:11:57.86,0:12:02.72,Default,,0000,0000,0000,,لكن لا شكّ أن مايا-سان كانت\Nتقطن في هذه الغرفة
Dialogue: 0,0:12:02.72,0:12:03.60,Default,,0000,0000,0000,,...ما الذي
Dialogue: 0,0:12:04.22,0:12:07.13,Default,,0000,0000,0000,,لا أدري إن كان ذاك اسمي الحقيقيّ حتى
Dialogue: 0,0:12:07.13,0:12:08.43,Default,,0000,0000,0000,,من أكون؟
Dialogue: 0,0:12:15.83,0:12:17.61,Default,,0000,0000,0000,,أهناك أمرٌ ما بشأن القلادة؟
Dialogue: 0,0:12:18.21,0:12:21.52,Default,,0000,0000,0000,,!رأسي يؤلمني
Dialogue: 0,0:12:21.52,0:12:22.44,Default,,0000,0000,0000,,!لم أعد أستطيع الاحتمال
Dialogue: 0,0:12:23.07,0:12:24.15,Default,,0000,0000,0000,,!آنسة
Dialogue: 0,0:12:24.15,0:12:24.98,Default,,0000,0000,0000,,!مايا-سان
Dialogue: 0,0:12:26.53,0:12:27.44,Default,,0000,0000,0000,,!انتظري
Dialogue: 0,0:12:29.32,0:12:30.24,Default,,0000,0000,0000,,!انتبهي
Dialogue: 0,0:12:32.77,0:12:33.48,Default,,0000,0000,0000,,...ذاك الرجل
Dialogue: 0,0:12:49.69,0:12:52.98,Default,,0000,0000,0000,,لمَ يستهدف ذاك الرجل من مضمار السباق مايا-سان؟
Dialogue: 0,0:12:59.95,0:13:00.95,Default,,0000,0000,0000,,أأنت بخير يا أبي؟
Dialogue: 0,0:13:01.38,0:13:04.01,Default,,0000,0000,0000,,ما الذي يجري؟ ما كان خطب تلك السيّارة؟
Dialogue: 0,0:13:04.01,0:13:05.92,Default,,0000,0000,0000,,فهمتُ الآن
Dialogue: 0,0:13:05.92,0:13:09.08,Default,,0000,0000,0000,,!أحدهم يستهدفك يا مايا-سان
Dialogue: 0,0:13:09.51,0:13:14.62,Default,,0000,0000,0000,,وفقدتِ ذاكرتك بعد صدمة من تعرضك للهجوم، لا شكّ
Dialogue: 0,0:13:14.62,0:13:16.04,Default,,0000,0000,0000,,ماذا؟ أين كونان-كن؟
Dialogue: 0,0:13:16.62,0:13:18.96,Default,,0000,0000,0000,,هذه المنطقة مليئة بشوارع المسار الواحد\Nوالنهايات المسدودة
Dialogue: 0,0:13:18.96,0:13:20.25,Default,,0000,0000,0000,,!قد أستطيع اللحاق به
Dialogue: 0,0:13:20.25,0:13:22.87,Default,,0000,0000,0000,,لكن نظرات مايا-سان تلك\N...الشبيهة بالحيوان المفترس
Dialogue: 0,0:13:23.65,0:13:26.08,Default,,0000,0000,0000,,تصرفتْ كما تعرف متى تكون في خطر
Dialogue: 0,0:13:26.08,0:13:27.49,Default,,0000,0000,0000,,!من هي بالضبط؟
Dialogue: 0,0:13:35.89,0:13:37.77,Default,,0000,0000,0000,,!تبّاً! فقدت أثره
Dialogue: 0,0:13:38.75,0:13:40.71,Default,,0000,0000,0000,,...يا للفوضى
Dialogue: 0,0:13:41.16,0:13:44.16,Default,,0000,0000,0000,,!أجل، هكذا! أمسكت بها
Dialogue: 0,0:13:44.99,0:13:45.64,Default,,0000,0000,0000,,!هكذا
Dialogue: 0,0:13:46.63,0:13:49.63,Default,,0000,0000,0000,,أخبرني حضرة الشرطيّ، ماذا حصل؟
Dialogue: 0,0:13:49.63,0:13:50.83,Default,,0000,0000,0000,,حادث مروري؟
Dialogue: 0,0:13:50.83,0:13:53.83,Default,,0000,0000,0000,,ابتعد من هنا يا فتى، المكان خطر
Dialogue: 0,0:13:53.83,0:13:55.66,Default,,0000,0000,0000,,متى وقع هذا الحادث؟
Dialogue: 0,0:13:55.66,0:13:58.63,Default,,0000,0000,0000,,قبل 3 ساعات، هيّا ابتعد
Dialogue: 0,0:14:01.49,0:14:07.16,Default,,0000,0000,0000,,وجدناها في المعبر قرب الشارع الخامس\Nقبل ثلاث ساعات
Dialogue: 0,0:14:07.16,0:14:09.53,Default,,0000,0000,0000,,ليس بعيداً عن فندق بيكا
Dialogue: 0,0:14:10.49,0:14:12.69,Default,,0000,0000,0000,,...أيمكن أنّها
Dialogue: 0,0:14:12.69,0:14:16.15,Default,,0000,0000,0000,,لعلّها استقلت الحافلة من الفندق ثمّ تعرضت لحادث هنا
Dialogue: 0,0:14:16.15,0:14:19.60,Default,,0000,0000,0000,,!وفقدت ذاكرتها من الصدمة
Dialogue: 0,0:14:19.60,0:14:22.97,Default,,0000,0000,0000,,ثمّ مشت مشوّشةً لجسر المشاة
Dialogue: 0,0:14:28.80,0:14:31.21,Default,,0000,0000,0000,,حافلة، شاحنة
Dialogue: 0,0:14:31.21,0:14:32.49,Default,,0000,0000,0000,,اصطدام؟
Dialogue: 0,0:14:38.79,0:14:42.04,Default,,0000,0000,0000,,!أتذكر! أتذكر الآن
Dialogue: 0,0:14:42.78,0:14:45.16,Default,,0000,0000,0000,,!مذهل يا كونان-كن! فعلتها
Dialogue: 0,0:14:45.16,0:14:46.32,Default,,0000,0000,0000,,كانت بالمصادفة
Dialogue: 0,0:14:46.32,0:14:50.46,Default,,0000,0000,0000,,لكن لمَ غادرت بعدها دون تلقّي أي علاج؟
Dialogue: 0,0:14:51.15,0:14:54.41,Default,,0000,0000,0000,,لأنّ ذلك الرجل كان يحاول استهدافها؟
Dialogue: 0,0:14:55.65,0:14:57.48,Default,,0000,0000,0000,,،لذا رغم فقدانها ذاكرتها
Dialogue: 0,0:14:57.48,0:15:00.34,Default,,0000,0000,0000,,هربت من مكان الخطر غريزياً
Dialogue: 0,0:15:02.29,0:15:04.47,Default,,0000,0000,0000,,لنجرب صعود الحافلة
Dialogue: 0,0:15:04.47,0:15:08.72,Default,,0000,0000,0000,,صحيح! قد تذكرين أين كنتِ تخططين الذهاب
Dialogue: 0,0:15:08.72,0:15:10.29,Default,,0000,0000,0000,,.لو لم يقع الحادث
Dialogue: 0,0:15:31.07,0:15:32.16,Default,,0000,0000,0000,,لا جدوى
Dialogue: 0,0:15:32.65,0:15:35.11,Default,,0000,0000,0000,,لا تتذكرين شيئاً؟
Dialogue: 0,0:15:35.11,0:15:38.46,Default,,0000,0000,0000,,لا تعجلي، فقد تذكرتِ الكثير في يوم واحد
Dialogue: 0,0:15:38.46,0:15:40.81,Default,,0000,0000,0000,,،لكن مع ركوب وصعود كلّ هؤلاء الناس
Dialogue: 0,0:15:40.81,0:15:42.64,Default,,0000,0000,0000,,لن يتذكرها أحد
Dialogue: 0,0:15:42.64,0:15:44.41,Default,,0000,0000,0000,,لم تترك أيّ آثار لتتبعها
Dialogue: 0,0:15:54.46,0:15:58.29,Default,,0000,0000,0000,,!هنا! كنتُ أنوي النزول هنا
Dialogue: 0,0:15:58.29,0:16:00.74,On Top,,0000,0000,0000,,صهريج غاز
Dialogue: 0,0:16:02.87,0:16:05.71,Default,,0000,0000,0000,,لنجرب المشي في المكان
Dialogue: 0,0:16:13.23,0:16:14.41,Default,,0000,0000,0000,,!انتبهوا
Dialogue: 0,0:16:23.64,0:16:24.65,Default,,0000,0000,0000,,مايا-سان؟
Dialogue: 0,0:16:28.60,0:16:30.42,Default,,0000,0000,0000,,...أيمكن أنّهما
Dialogue: 0,0:16:36.80,0:16:38.71,Default,,0000,0000,0000,,لمَ معها سلك بيانو هنا؟
Dialogue: 0,0:16:39.01,0:16:42.83,Default,,0000,0000,0000,,!الوغد! أتحاول قتلنا جميعاً؟
Dialogue: 0,0:16:42.83,0:16:44.41,Default,,0000,0000,0000,,!سأقبض عليك
Dialogue: 0,0:16:44.41,0:16:46.37,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:16:46.37,0:16:47.66,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:16:47.66,0:16:49.12,Default,,0000,0000,0000,,...في الحادثة أمام الفندق والآن
Dialogue: 0,0:16:49.12,0:16:52.29,Default,,0000,0000,0000,,بالنظر إلى التوقيت، لم يكن يستهدفها\N،أو يستهدفنا نحن جميعاً
Dialogue: 0,0:16:52.29,0:16:53.33,Default,,0000,0000,0000,,!بل العمّ فقط
Dialogue: 0,0:16:54.65,0:16:57.32,Default,,0000,0000,0000,,!ران-نيتشان! ابقي بقرب مايا-سان
Dialogue: 0,0:16:57.32,0:16:58.53,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:16:58.53,0:17:00.65,Default,,0000,0000,0000,,!مؤلم! رأسي يؤلمني
Dialogue: 0,0:17:00.65,0:17:01.24,Default,,0000,0000,0000,,أأنتِ بخير؟
Dialogue: 0,0:17:02.64,0:17:04.20,Default,,0000,0000,0000,,...ربما عليكِ الاستراحة في مكان
Dialogue: 0,0:17:05.35,0:17:06.29,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:17:06.85,0:17:09.75,Default,,0000,0000,0000,,...إن كان يسعى لقتل العمّ فلا بدّ أنّه
Dialogue: 0,0:17:16.30,0:17:18.97,Default,,0000,0000,0000,,!مشكلة! اختفت مايا-سان
Dialogue: 0,0:17:18.97,0:17:20.34,Default,,0000,0000,0000,,ما الذي تفعلانه؟
Dialogue: 0,0:17:20.34,0:17:21.62,Default,,0000,0000,0000,,!أليس واضحاً؟
Dialogue: 0,0:17:21.62,0:17:23.12,Default,,0000,0000,0000,,!ساعدينا
Dialogue: 0,0:17:25.46,0:17:26.50,Default,,0000,0000,0000,,...نجونا
Dialogue: 0,0:17:25.46,0:17:26.50,Default,,0000,0000,0000,,...نجونا
Dialogue: 0,0:17:27.00,0:17:29.92,Default,,0000,0000,0000,,!نحن في ورطة! اختفت مايا-سان
Dialogue: 0,0:17:32.16,0:17:35.95,Default,,0000,0000,0000,,...آسفة، أشحتُ بنظري للحظة
Dialogue: 0,0:17:35.95,0:17:37.08,Default,,0000,0000,0000,,أين ذهبت يا ترى؟
Dialogue: 0,0:17:37.08,0:17:38.54,Default,,0000,0000,0000,,...أيمكن أنّ ذاك الرجل قد
Dialogue: 0,0:17:38.99,0:17:41.39,Default,,0000,0000,0000,,كلا، أشكّ في ذلك
Dialogue: 0,0:17:41.39,0:17:45.00,Default,,0000,0000,0000,,ربما اختفت بنفسها
Dialogue: 0,0:17:45.39,0:17:47.46,Default,,0000,0000,0000,,أيمكن أنّها استعادت ذاكرتها؟
Dialogue: 0,0:17:47.81,0:17:49.27,Default,,0000,0000,0000,,لنبحث عنها بأيّ حال
Dialogue: 0,0:17:49.27,0:17:50.56,Default,,0000,0000,0000,,اذهبا هناك
Dialogue: 0,0:17:50.56,0:17:51.22,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:17:51.22,0:17:52.54,Default,,0000,0000,0000,,هيّا بنا يا كونان-كن
Dialogue: 0,0:17:54.09,0:17:59.09,On Top,,0000,0000,0000,,العشاء الأخير
Dialogue: 0,0:18:02.49,0:18:07.04,Default,,0000,0000,0000,,...تبّاً، أُفسدت خطّتي بسبب تلك المرأة
Dialogue: 0,0:18:22.52,0:18:24.58,Default,,0000,0000,0000,,هو الهدف إذاً؟
Dialogue: 0,0:18:25.06,0:18:26.23,Default,,0000,0000,0000,,!تأخّرتِ
Dialogue: 0,0:18:26.23,0:18:30.19,Default,,0000,0000,0000,,...أردتُ الاستمتاع بمشاهدته يتعذب ويموت، لكن
Dialogue: 0,0:18:38.22,0:18:42.45,Default,,0000,0000,0000,,لا أريد أن يعترض أحدٌ طريقي
Dialogue: 0,0:18:47.06,0:18:48.47,Default,,0000,0000,0000,,!مايا-سان
Dialogue: 0,0:18:48.47,0:18:52.55,Default,,0000,0000,0000,,!تذكرت! مخبأ ذاك الرجل هناك
Dialogue: 0,0:18:54.90,0:18:55.84,Default,,0000,0000,0000,,...إنّه
Dialogue: 0,0:18:56.23,0:18:57.76,Default,,0000,0000,0000,,!الشارع التاسع، المبنى 13
Dialogue: 0,0:18:58.50,0:19:02.49,Default,,0000,0000,0000,,!أيمكن أنّ الأرقام في ذاك الإنجيل كانت عنواناً؟
Dialogue: 0,0:19:02.49,0:19:04.56,Default,,0000,0000,0000,,!مما يعني... ذاك هو المكان
Dialogue: 0,0:19:06.04,0:19:09.39,Default,,0000,0000,0000,,العشاء الأخير" كان هذا إذاً"
Dialogue: 0,0:19:14.40,0:19:17.19,Default,,0000,0000,0000,,!يودا! كان هو إذاً
Dialogue: 0,0:19:17.19,0:19:19.56,Default,,0000,0000,0000,,كان أبي من يسعى وراءه إذاً؟
Dialogue: 0,0:19:20.61,0:19:21.51,Default,,0000,0000,0000,,...العشاء الأخير
Dialogue: 0,0:19:22.02,0:19:23.97,Default,,0000,0000,0000,,كانت قطعة الأحجية تلك جزءاً\N!من هذه الصورة إذاً
Dialogue: 0,0:19:24.68,0:19:27.02,Default,,0000,0000,0000,,أتت هي هنا أيضاً إذاً
Dialogue: 0,0:19:27.02,0:19:29.56,Default,,0000,0000,0000,,من تكون بالضبط؟
Dialogue: 0,0:19:29.56,0:19:31.39,Default,,0000,0000,0000,,ما علاقتها بهذا الرجل؟
Dialogue: 0,0:19:32.55,0:19:34.43,Default,,0000,0000,0000,,ماذا؟ ما هذا؟
Dialogue: 0,0:19:34.80,0:19:38.34,Default,,0000,0000,0000,,كانت قطعة أحجية يودا هي المفتاح\Nلأخذ المعلومات عن العمّ
Dialogue: 0,0:19:38.34,0:19:42.58,Default,,0000,0000,0000,,أي أنّها أتت هنا لأخذها منه
Dialogue: 0,0:19:42.58,0:19:44.43,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:19:47.12,0:19:49.58,Default,,0000,0000,0000,,!ران-نيتشان! اتّصلي بالشرطة
Dialogue: 0,0:19:49.58,0:19:50.56,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:19:53.19,0:19:56.47,Default,,0000,0000,0000,,كيف عرفتِ أين مخبأ ذاك الرجل يا مايا-سان؟
Dialogue: 0,0:20:02.27,0:20:05.27,Default,,0000,0000,0000,,يودا ومايا-سان كانا يعرفان بعضهما بكلّ وضوح
Dialogue: 0,0:20:05.27,0:20:07.31,Default,,0000,0000,0000,,من تكون بالضبط؟
Dialogue: 0,0:20:07.31,0:20:11.30,Default,,0000,0000,0000,,سآخذ بثأري يوماً ما، تذكّر كلامي
Dialogue: 0,0:20:11.30,0:20:13.97,Default,,0000,0000,0000,,...جسدها المُمرن وردّات فعلها السريعة
Dialogue: 0,0:20:13.97,0:20:17.17,Default,,0000,0000,0000,,!والسلك الذي أخرجته
Dialogue: 0,0:20:17.17,0:20:19.84,Default,,0000,0000,0000,,لو استعملت حافلةً بدل تاكسي أو سيّارة مُستأجرة
Dialogue: 0,0:20:19.84,0:20:23.00,Default,,0000,0000,0000,,،كي تخفي آثارها كما يفعل المحترفون
Dialogue: 0,0:20:23.00,0:20:24.16,Default,,0000,0000,0000,,!فلا شك حينها
Dialogue: 0,0:20:24.16,0:20:27.76,Default,,0000,0000,0000,,!إنّها قاتلة مُستأجرة عيّنها يودا لقتل العمّ
Dialogue: 0,0:20:40.69,0:20:43.26,Default,,0000,0000,0000,,...أنا متأكد أنّه ذهب هنا
Dialogue: 0,0:20:51.63,0:20:53.01,Default,,0000,0000,0000,,!انطلقي
Dialogue: 0,0:21:03.04,0:21:04.17,Default,,0000,0000,0000,,مايا-سان
Dialogue: 0,0:21:04.17,0:21:08.68,Default,,0000,0000,0000,,عادت ذاكرتك عندما أسقط يودا\Nالخرسانة علينا، صحيح؟
Dialogue: 0,0:21:08.96,0:21:12.61,Default,,0000,0000,0000,,أجل، عادت ذاكرتي بفضله
Dialogue: 0,0:21:12.61,0:21:14.09,Default,,0000,0000,0000,,عليّ شكره
Dialogue: 0,0:21:14.70,0:21:16.86,Default,,0000,0000,0000,,كان عليّ أن أدرك عندما\Nحاولتِ إخفاء الندوب
Dialogue: 0,0:21:16.86,0:21:18.36,Default,,0000,0000,0000,,على يديك في المشفى
Dialogue: 0,0:21:18.36,0:21:21.80,Default,,0000,0000,0000,,.أنّكِ قاتلة مُستأجرة تستعمل الأسلاك كسلاحها
Dialogue: 0,0:21:22.19,0:21:26.31,Default,,0000,0000,0000,,مجرد إدراكك لاستعمالي السلك\Nلتأمين قوت يومي كان ملاحظة مُبهرة
Dialogue: 0,0:21:26.31,0:21:27.76,Default,,0000,0000,0000,,من تكون بالضبط؟
Dialogue: 0,0:21:28.19,0:21:30.71,Default,,0000,0000,0000,,إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:21:31.14,0:21:32.30,Default,,0000,0000,0000,,مُتحرٍّ؟
Dialogue: 0,0:21:37.59,0:21:39.01,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:21:40.34,0:21:41.06,Default,,0000,0000,0000,,أأنت بخير؟
Dialogue: 0,0:21:41.06,0:21:42.80,Default,,0000,0000,0000,,ما الذي حصل؟
Dialogue: 0,0:21:43.83,0:21:46.72,Default,,0000,0000,0000,,يبدو أنّي خسرت
Dialogue: 0,0:23:27.41,0:23:33.02,Default,,0000,0000,0000,,يبدو أنّنا الاثنان اخترنا الهدف الخطأ أيّها المُتحرّي الصغير
Dialogue: 0,0:23:34.86,0:23:35.68,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:23:35.68,0:23:36.49,Default,,0000,0000,0000,,ما الذي قالته؟
Dialogue: 0,0:23:37.07,0:23:40.07,Default,,0000,0000,0000,,قالت أنّ موري كوغورو مُتحرٍّ عظيم حقاً
Dialogue: 0,0:23:40.07,0:23:43.60,Default,,0000,0000,0000,,!بقبضه على نفس الشخص مرّتين
Dialogue: 0,0:23:43.60,0:23:45.61,Default,,0000,0000,0000,,يبدو أنّ حظّك قد رجع
Dialogue: 0,0:23:45.93,0:23:47.85,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:23:47.85,0:23:51.56,Default,,0000,0000,0000,,مما يعني أنّي سأدرّ أموالاً طائلة\N!بعد سباق خيول جي-1 القادم
Dialogue: 0,0:24:00.56,0:24:03.67,Default,,0000,0000,0000,,هلّا شرحتِ ظروف الاختطاف لنا؟
Dialogue: 0,0:24:04.35,0:24:08.01,Default,,0000,0000,0000,,لا أريد التصديق أنّ ناوكو ميتة
Dialogue: 0,0:24:08.89,0:24:11.51,Default,,0000,0000,0000,,أنتَ مُغيّر شركات مشهور
Dialogue: 0,0:24:11.51,0:24:14.72,Default,,0000,0000,0000,,ألم تكوّن الكثير من الأعداء؟
Dialogue: 0,0:24:14.72,0:24:16.76,Default,,0000,0000,0000,,لا أريد مالك الوضيع
Dialogue: 0,0:24:16.76,0:24:17.72,Default,,0000,0000,0000,,احتفظ به
Dialogue: 0,0:24:17.72,0:24:19.10,Default,,0000,0000,0000,,!ران، لنذهب
Dialogue: 0,0:24:19.93,0:24:21.87,Default,,0000,0000,0000,,،حتّى لو أُخِذَ بثأره
Dialogue: 0,0:24:21.87,0:24:24.05,Default,,0000,0000,0000,,أشكّ أنه سيسعد
Dialogue: 0,0:24:24.71,0:24:26.33,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.33,0:24:29.42,Default,,0000,0000,0000,,قضيّة فدية الاختطاف الزائفة
Dialogue: 0,0:24:45.52,0:24:47.85,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.85,0:24:49.56,Default,,0000,0000,0000,,عدّة غوص
Dialogue: 0,0:24:49.56,0:24:51.55,Default,,0000,0000,0000,,

