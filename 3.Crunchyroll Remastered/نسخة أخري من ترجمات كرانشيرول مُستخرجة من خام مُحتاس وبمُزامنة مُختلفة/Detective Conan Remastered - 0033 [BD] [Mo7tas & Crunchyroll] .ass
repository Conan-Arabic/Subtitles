Dialogue: 0,0:00:01.54,0:00:04.72,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.92,0:00:06.44,Default,,0000,0000,0000,,!قضيّة اليوم بحثٌ عن كنز
Dialogue: 0,0:00:06.65,0:00:08.39,Default,,0000,0000,0000,,هل سنجد كنز القلب؟
Dialogue: 0,0:00:08.59,0:00:12.05,Default,,0000,0000,0000,,يرى الحقيقة الواحدة، يحمل \Nمظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:12.25,0:00:14.35,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.90,0:01:51.98,Title,,0000,0000,0000,,{\fad(300,0)}قضيّة نجاة فرقة فتيان التحرّي
Dialogue: 0,0:01:46.69,0:01:49.79,Default,,0000,0000,0000,,قضيّة نجاة فرقة فتيان التحرّي
Dialogue: 0,0:02:02.81,0:02:04.85,Default,,0000,0000,0000,,!كانت هنا
Dialogue: 0,0:02:14.84,0:02:17.41,Default,,0000,0000,0000,,أخبرنا يا بروفسور، أهذه الخريطة حقيقية؟
Dialogue: 0,0:02:17.61,0:02:19.10,Default,,0000,0000,0000,,!أجل، حقيقية
Dialogue: 0,0:02:19.34,0:02:22.35,Default,,0000,0000,0000,,يوجد كنزٌ بالفعل إذاً؟
Dialogue: 0,0:02:22.55,0:02:25.31,Default,,0000,0000,0000,,انتظروا وستكتشفون
Dialogue: 0,0:02:27.17,0:02:30.17,Default,,0000,0000,0000,,!سأجد الكنز حتماً
Dialogue: 0,0:02:30.37,0:02:31.39,Default,,0000,0000,0000,,!أنا أيضاً
Dialogue: 0,0:02:31.39,0:02:32.56,Default,,0000,0000,0000,,!وأنا
Dialogue: 0,0:02:33.19,0:02:34.57,Default,,0000,0000,0000,,،بالمناسبة يا بروفسور
Dialogue: 0,0:02:34.77,0:02:37.53,Default,,0000,0000,0000,,من أين حصلت على تلك الخريطة المريبة؟
Dialogue: 0,0:02:38.84,0:02:40.47,Default,,0000,0000,0000,,تريد أن تعرف؟
Dialogue: 0,0:02:41.51,0:02:43.23,Default,,0000,0000,0000,,ستكذب بأيّ حال
Dialogue: 0,0:02:43.23,0:02:46.56,Default,,0000,0000,0000,,ستكتشف عندما تصل للنهاية
Dialogue: 0,0:02:47.98,0:02:49.39,Default,,0000,0000,0000,,النهاية؟
Dialogue: 0,0:03:05.14,0:03:08.02,Default,,0000,0000,0000,,...أنا أكبر من أن أذهب في رحلات بحث عن كنز
Dialogue: 0,0:03:08.22,0:03:11.10,Default,,0000,0000,0000,,نحن هنا، عند شجرة الجمجمة
Dialogue: 0,0:03:11.10,0:03:14.56,Default,,0000,0000,0000,,علينا شقّ طريقنا لجسر لندن أوّلاً
Dialogue: 0,0:03:11.37,0:03:14.56,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:03:14.73,0:03:17.95,Default,,0000,0000,0000,,حسناً، سأقوم بالصيد هنا
Dialogue: 0,0:03:18.15,0:03:20.02,Default,,0000,0000,0000,,لذا استمتعوا أنتم
Dialogue: 0,0:03:20.22,0:03:21.87,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:03:22.07,0:03:24.31,Default,,0000,0000,0000,,يا إلهي، لستُ طفلاً
Dialogue: 0,0:03:24.51,0:03:26.52,Default,,0000,0000,0000,,...ربما أنا الآن
Dialogue: 0,0:03:29.88,0:03:32.78,Default,,0000,0000,0000,,أخبرني يا كونان-كن؟ ما الكنز برأيك؟
Dialogue: 0,0:03:32.98,0:03:35.40,Default,,0000,0000,0000,,لم نجزم بأنّه كنز بعد
Dialogue: 0,0:03:35.60,0:03:40.47,Default,,0000,0000,0000,,بلى! يوجد كنز بلا شكّ، صحيح يا ميتسوهيكو؟
Dialogue: 0,0:03:40.67,0:03:43.11,Default,,0000,0000,0000,,!أجل، ألماس أو جواهر
Dialogue: 0,0:03:43.59,0:03:46.30,Default,,0000,0000,0000,,!أو ربما ذهب مدفون حتّى
Dialogue: 0,0:03:46.87,0:03:48.55,Default,,0000,0000,0000,,!مُذهل! سيكون ذلك رائعاً
Dialogue: 0,0:03:47.97,0:03:48.76,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:03:48.75,0:03:50.31,Default,,0000,0000,0000,,مستحيل
Dialogue: 0,0:03:50.31,0:03:51.18,On Top,,0000,0000,0000,,شجرة الجمجمة
Dialogue: 0,0:03:52.02,0:03:54.10,On Top,,0000,0000,0000,,جسر لندن
Dialogue: 0,0:04:05.00,0:04:09.66,Default,,0000,0000,0000,,كنت قلقاً من أن نسقط بما أنّ اسمه جسر لندن
Dialogue: 0,0:04:10.53,0:04:13.95,Default,,0000,0000,0000,,تسقط هذه الجسور في الأفلام دوماً
Dialogue: 0,0:04:27.62,0:04:28.68,Default,,0000,0000,0000,,!مـ-محال
Dialogue: 0,0:04:28.68,0:04:30.43,Default,,0000,0000,0000,,!ليس طريفاً
Dialogue: 0,0:04:30.80,0:04:34.96,Default,,0000,0000,0000,,بمَ كان يفكّر البروفسور عندما أرسلنا\Nلمكان خطر كهذا؟
Dialogue: 0,0:04:35.16,0:04:37.25,Default,,0000,0000,0000,,!كيف سنرجع الآن؟
Dialogue: 0,0:04:36.81,0:04:39.31,On Top,,0000,0000,0000,,جسر لندن
Dialogue: 0,0:04:40.14,0:04:42.52,On Top,,0000,0000,0000,,يد الشيطان\Nادخل من البوّابة الضيّقة
Dialogue: 0,0:04:43.20,0:04:47.40,Default,,0000,0000,0000,,يبدو أنّ بوصلتي لا تعمل هنا
Dialogue: 0,0:04:47.57,0:04:51.47,Default,,0000,0000,0000,,لمَ خبّأ الكنز في الجبال هنا؟
Dialogue: 0,0:04:51.67,0:04:54.35,Default,,0000,0000,0000,,كان مهووس غموض
Dialogue: 0,0:04:54.77,0:04:56.81,Default,,0000,0000,0000,,لكنّ هذا تمادٍ
Dialogue: 0,0:04:57.33,0:05:01.32,Default,,0000,0000,0000,,سحقاً، وفق الخريطة يجب أن تكون\N!هناك 5 أشجار أرز، لكن توجد 4 فحسب
Dialogue: 0,0:05:01.52,0:05:03.27,Default,,0000,0000,0000,,!أهذا المكان حقاً؟
Dialogue: 0,0:05:03.59,0:05:05.38,Default,,0000,0000,0000,,كان تعيس الحظّ
Dialogue: 0,0:05:05.58,0:05:09.35,Default,,0000,0000,0000,,مات في حادث بعدما دفن الكنز فوراً
Dialogue: 0,0:05:11.70,0:05:15.88,Default,,0000,0000,0000,,!أنت! الكنز على المحكّ هنا\N !أجب عندما أسألك
Dialogue: 0,0:05:16.08,0:05:18.18,Default,,0000,0000,0000,,!هذا خطر يا سيّد
Dialogue: 0,0:05:18.79,0:05:21.02,Default,,0000,0000,0000,,عليك إطفاء السجائر
Dialogue: 0,0:05:21.57,0:05:23.73,Default,,0000,0000,0000,,فقد تسبب حرائق غابات
Dialogue: 0,0:05:23.93,0:05:25.61,Default,,0000,0000,0000,,مـ-من أنتم؟
Dialogue: 0,0:05:25.81,0:05:28.26,Default,,0000,0000,0000,,نحن فرقة فتيان التحرّي
Dialogue: 0,0:05:31.43,0:05:34.44,Default,,0000,0000,0000,,...ماذا؟ تشبه هذه الخريطة خريطتنا
Dialogue: 0,0:05:34.64,0:05:37.19,Default,,0000,0000,0000,,!أنت! ما الذي تنظر له؟
Dialogue: 0,0:05:37.67,0:05:39.01,Default,,0000,0000,0000,,!لا-لا شيء
Dialogue: 0,0:05:39.21,0:05:39.97,Default,,0000,0000,0000,,لنذهب
Dialogue: 0,0:05:39.97,0:05:42.31,Default,,0000,0000,0000,,نذهب أين؟
Dialogue: 0,0:05:42.51,0:05:43.77,Default,,0000,0000,0000,,!تعال وحسب
Dialogue: 0,0:05:47.79,0:05:50.74,Default,,0000,0000,0000,,لا يبدو أنّهما ينويان التنّزه في الجبال
Dialogue: 0,0:05:50.94,0:05:54.03,Default,,0000,0000,0000,,لديهما مجرف كما يرتديان بذلاً
Dialogue: 0,0:05:54.23,0:05:56.27,Default,,0000,0000,0000,,وما كانت تلك الخريطة بالضبط؟
Dialogue: 0,0:05:57.95,0:06:01.56,Default,,0000,0000,0000,,نحن هنا الآن، صحيح؟
Dialogue: 0,0:06:01.76,0:06:04.52,Default,,0000,0000,0000,,ماذا؟ أجل، أظنّ ذلك
Dialogue: 0,0:06:04.72,0:06:06.84,Default,,0000,0000,0000,,لكن البوصلة لا تعمل
Dialogue: 0,0:06:07.65,0:06:10.93,Default,,0000,0000,0000,,،كونان، توجد 4 أشجار أزر فحسب هنا\Nأهذا هو المكان حقاً؟
Dialogue: 0,0:06:11.13,0:06:12.24,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:12.63,0:06:14.43,Default,,0000,0000,0000,,ابتعدوا قليلاً
Dialogue: 0,0:06:15.62,0:06:18.18,Default,,0000,0000,0000,,انظروا، ها هي شجرة الأرز الخامسة
Dialogue: 0,0:06:18.64,0:06:21.77,Default,,0000,0000,0000,,قُطعت فيصعب ملاحظتها
Dialogue: 0,0:06:21.97,0:06:24.11,Default,,0000,0000,0000,,ترون كيف أنّ الحلقات السنوية أوسع هنا؟
Dialogue: 0,0:06:24.31,0:06:28.65,Default,,0000,0000,0000,,تعرّض هذا الجانب لضوء شمس أكثر\Nفنما أكثر من الآخر
Dialogue: 0,0:06:29.76,0:06:31.47,Default,,0000,0000,0000,,الجنوب من هناك إذاً؟
Dialogue: 0,0:06:31.67,0:06:32.84,Default,,0000,0000,0000,,تماماً
Dialogue: 0,0:06:33.04,0:06:35.38,Default,,0000,0000,0000,,أيّ طريق نسلك إذاً؟
Dialogue: 0,0:06:35.58,0:06:37.11,Default,,0000,0000,0000,,دعني أرى الخريطة
Dialogue: 0,0:06:37.11,0:06:40.77,On Top,,0000,0000,0000,,يد الشّيطان
Dialogue: 0,0:06:37.46,0:06:40.77,Default,,0000,0000,0000,,"يد الشيطان، ادخل من البوّابة الضيّقة
Dialogue: 0,0:06:40.97,0:06:44.95,Default,,0000,0000,0000,,يد الشيطان هي يدك اليسرى فيقلّص \Nهذا الاحتمالات للاثنين على اليسار
Dialogue: 0,0:06:45.15,0:06:47.05,Default,,0000,0000,0000,,"ومكتوب هنا "ادخل من البوّابة الضيّقة
Dialogue: 0,0:06:47.25,0:06:49.74,Default,,0000,0000,0000,,مما يعني أن علينا أخذ أضيق طريق أقصى اليسار
Dialogue: 0,0:06:49.94,0:06:52.69,Default,,0000,0000,0000,,!يا لذكائك يا كونان-كن
Dialogue: 0,0:06:54.06,0:06:56.42,Default,,0000,0000,0000,,يد الشيطان هي يدك اليسرى إذاً؟
Dialogue: 0,0:06:56.62,0:06:58.24,Default,,0000,0000,0000,,ماذا عن يدك اليمنى؟
Dialogue: 0,0:06:58.44,0:07:00.34,Default,,0000,0000,0000,,لا بدّ أنّها يد الملاك
Dialogue: 0,0:07:01.62,0:07:02.66,Default,,0000,0000,0000,,يا لبساطتك
Dialogue: 0,0:07:05.70,0:07:08.89,Default,,0000,0000,0000,,لمَ بحوزة أولئك الأطفال تلك الخريطة؟
Dialogue: 0,0:07:09.39,0:07:12.15,Default,,0000,0000,0000,,يا له من صبيّ ذكي
Dialogue: 0,0:07:12.35,0:07:14.47,Default,,0000,0000,0000,,لنسرع قبل أن يسبقونا
Dialogue: 0,0:07:14.67,0:07:15.83,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:07:16.23,0:07:17.15,On Top,,0000,0000,0000,,يد الشيطان
Dialogue: 0,0:07:18.14,0:07:20.22,On Top,,0000,0000,0000,,الرباط المرقّط
Dialogue: 0,0:07:26.98,0:07:29.20,Default,,0000,0000,0000,,بدا ذلكما الاثنان مُريبين
Dialogue: 0,0:07:29.40,0:07:32.94,Default,,0000,0000,0000,,أجل! يبحثان عن نفس الكنز معنا بالتأكيد
Dialogue: 0,0:07:33.14,0:07:35.98,Default,,0000,0000,0000,,أجل، فقد ذكرا كنزاً
Dialogue: 0,0:07:36.15,0:07:38.35,Default,,0000,0000,0000,,نعم، لا شكّ في الأمر
Dialogue: 0,0:07:53.73,0:07:57.56,Default,,0000,0000,0000,,!النجدة، أنا أغرق! أمّي
Dialogue: 0,0:07:57.76,0:07:59.83,Default,,0000,0000,0000,,!أمّي! أمّي! أنا أغرق
Dialogue: 0,0:08:00.03,0:08:01.85,Default,,0000,0000,0000,,أنت، ميتسوهيكو
Dialogue: 0,0:08:03.00,0:08:04.85,Default,,0000,0000,0000,,جرّب الوقوف
Dialogue: 0,0:08:07.15,0:08:07.98,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:08:09.56,0:08:10.99,Default,,0000,0000,0000,,ظننتني سأموت
Dialogue: 0,0:08:12.23,0:08:13.89,On Top,,0000,0000,0000,,الرباط المرقّط
Dialogue: 0,0:08:14.15,0:08:15.56,On Top,,0000,0000,0000,,حمامة النهر
Dialogue: 0,0:08:15.77,0:08:17.40,On Top,,0000,0000,0000,,ضفّة والتون
Dialogue: 0,0:08:20.99,0:08:25.69,Default,,0000,0000,0000,,حتّى أفضل عيدان ثقاب التخييم\Nلن تشتعل في أيّ ريح بعدما تبللت
Dialogue: 0,0:08:25.89,0:08:30.02,Default,,0000,0000,0000,,تبّاً، كنت أتمنى إشعال نار وتجفيف ثيابنا
Dialogue: 0,0:08:30.22,0:08:31.34,Default,,0000,0000,0000,,يمكننا
Dialogue: 0,0:08:33.42,0:08:35.73,Default,,0000,0000,0000,,أنزع رأس المصباح اليدوي
Dialogue: 0,0:08:35.99,0:08:39.47,Default,,0000,0000,0000,,أستخرج العاكس وأضع عود ثقاب به
Dialogue: 0,0:08:39.67,0:08:43.23,Default,,0000,0000,0000,,أوجّهه الآن نحو الشمس وأجمع الضوء
Dialogue: 0,0:08:45.51,0:08:48.60,Default,,0000,0000,0000,,قد يكون عود ثقاب تخييم جيّد، لكن لا يزال مبللاً
Dialogue: 0,0:08:48.80,0:08:51.14,Default,,0000,0000,0000,,ليس صالحاً للاستعمال الآن، أليس كذلك؟
Dialogue: 0,0:08:56.73,0:08:57.64,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:08:57.64,0:08:59.35,Default,,0000,0000,0000,,!أحسنت يا كونان-كن
Dialogue: 0,0:09:02.61,0:09:03.44,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:09:03.44,0:09:06.86,Default,,0000,0000,0000,,!كأنّ لديك حكمة العجوزة
Dialogue: 0,0:09:08.22,0:09:11.68,Default,,0000,0000,0000,,ألا يمكنك مناداتها بمعرفة النجاة على الأقل؟
Dialogue: 0,0:09:11.68,0:09:12.73,On Top,,0000,0000,0000,,الرباط المرقّط
Dialogue: 0,0:09:13.85,0:09:15.81,On Top,,0000,0000,0000,,السهم مزدوج الرأس
Dialogue: 0,0:09:19.57,0:09:21.79,Default,,0000,0000,0000,,!تبّاً! أين الطريق الصحيح؟
Dialogue: 0,0:09:21.99,0:09:25.15,Default,,0000,0000,0000,,!تبّاً! تبّاً
Dialogue: 0,0:09:25.78,0:09:29.43,Default,,0000,0000,0000,,يبدو أنّ هناك كتابة عليها لكن يصعب قراءتها
Dialogue: 0,0:09:29.79,0:09:31.39,Default,,0000,0000,0000,,ربما نذهب شرقاً
Dialogue: 0,0:09:31.55,0:09:34.42,Default,,0000,0000,0000,,!أين الشرق إذاً؟
Dialogue: 0,0:09:34.62,0:09:35.98,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:09:45.25,0:09:48.85,Default,,0000,0000,0000,,ربما كان خطراً عليهم الذهاب بمفردهم
Dialogue: 0,0:09:50.58,0:09:51.97,Default,,0000,0000,0000,,تمّ الإطفاء
Dialogue: 0,0:09:52.17,0:09:53.71,Default,,0000,0000,0000,,تمّ تأكيد الإطفاء
Dialogue: 0,0:09:54.52,0:09:57.22,Default,,0000,0000,0000,,أتظن بإمكاننا الوصول للنهاية حقاً؟
Dialogue: 0,0:09:57.41,0:09:59.16,Default,,0000,0000,0000,,أين نذهب من هنا؟
Dialogue: 0,0:09:59.36,0:10:01.61,Default,,0000,0000,0000,,لا أريد تسلّق ذاك المكان مجدداً
Dialogue: 0,0:10:01.81,0:10:03.48,Default,,0000,0000,0000,,لا تقلق
Dialogue: 0,0:10:03.64,0:10:04.81,Default,,0000,0000,0000,,نحن هنا الآن، لذا إذا أخذنا هذا الطريق
Dialogue: 0,0:10:05.01,0:10:08.56,Default,,0000,0000,0000,,سنصل لوجهتنا التالية
Dialogue: 0,0:10:10.56,0:10:12.72,Default,,0000,0000,0000,,!حسنٌ، لنذهب في هذه الحالة
Dialogue: 0,0:10:12.92,0:10:14.56,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:10:14.15,0:10:15.60,On Top,,0000,0000,0000,,ضفّة والتون
Dialogue: 0,0:10:16.48,0:10:17.72,On Top,,0000,0000,0000,,عارضة توازن قاطع الطريق
Dialogue: 0,0:10:21.89,0:10:23.35,On Top,,0000,0000,0000,,عارضة توازن قاطع الطريق
Dialogue: 0,0:10:23.73,0:10:26.31,On Top,,0000,0000,0000,,وادي مولر الحكيم
Dialogue: 0,0:11:15.46,0:11:16.37,Gen_Main,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:11:21.21,0:11:22.74,Default,,0000,0000,0000,,!تسعة فاصل تسعة
Dialogue: 0,0:11:23.56,0:11:25.21,On Top,,0000,0000,0000,,وادي مولر الحكيم
Dialogue: 0,0:11:26.94,0:11:28.93,On Top,,0000,0000,0000,,السهم مزدوج الرأس
Dialogue: 0,0:11:37.66,0:11:39.63,Default,,0000,0000,0000,,كُسِرت حديثاً
Dialogue: 0,0:11:39.83,0:11:42.73,Default,,0000,0000,0000,,يبدو أنّها قُطِعت بشيءٍ حاد
Dialogue: 0,0:11:43.24,0:11:44.91,Default,,0000,0000,0000,,لكن ليس سكيناً أو شفرة
Dialogue: 0,0:11:45.11,0:11:46.59,Default,,0000,0000,0000,,...ربما مجرف وما شابه
Dialogue: 0,0:11:46.79,0:11:47.89,Default,,0000,0000,0000,,مجرف؟
Dialogue: 0,0:11:49.00,0:11:52.17,Default,,0000,0000,0000,,هكذا إذاً، كان ذلكما الاثنان هنا
Dialogue: 0,0:11:57.86,0:11:59.81,Default,,0000,0000,0000,,ما المكتوب برأيكم؟
Dialogue: 0,0:12:00.28,0:12:03.31,Default,,0000,0000,0000,,تبدو شفرةً ما، لكن يصعب قراءتها
Dialogue: 0,0:12:03.51,0:12:04.52,Default,,0000,0000,0000,,!وجدتُها
Dialogue: 0,0:12:04.95,0:12:08.29,Default,,0000,0000,0000,,إن وضعنا ورقةً عليها ومسحنا بقلم رصاص
Dialogue: 0,0:12:08.49,0:12:10.35,Default,,0000,0000,0000,,ألن تظهر الأحرف؟
Dialogue: 0,0:12:11.12,0:12:12.18,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:12:12.72,0:12:15.94,Default,,0000,0000,0000,,لكن لم نجلب معنا ورقاً أو قلم رصاص
Dialogue: 0,0:12:16.14,0:12:17.15,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:17.15,0:12:19.49,Default,,0000,0000,0000,,لديّ قلم تحديد لسببٍ ما
Dialogue: 0,0:12:19.69,0:12:21.08,Default,,0000,0000,0000,,سينجح ذلك
Dialogue: 0,0:12:22.01,0:12:23.10,Default,,0000,0000,0000,,هذا القلم؟
Dialogue: 0,0:12:23.28,0:12:25.35,Default,,0000,0000,0000,,كلا، ما اقترحته أيومي-تشان
Dialogue: 0,0:12:25.81,0:12:27.31,Default,,0000,0000,0000,,أعرني هذا قليلاً
Dialogue: 0,0:12:27.31,0:12:28.46,Default,,0000,0000,0000,,ما الذي ستفعله؟
Dialogue: 0,0:12:28.66,0:12:29.97,Default,,0000,0000,0000,,انظروا وحسب
Dialogue: 0,0:12:31.93,0:12:34.35,Default,,0000,0000,0000,,أسكب من ماء الحافظة على اللافتة أوّلاً
Dialogue: 0,0:12:34.60,0:12:37.81,Default,,0000,0000,0000,,ثمّ أفرك تراباً بالكتابة
Dialogue: 0,0:12:38.05,0:12:40.43,Default,,0000,0000,0000,,...وعندما أمسحه
Dialogue: 0,0:12:40.90,0:12:44.65,Default,,0000,0000,0000,,أرأيتم؟ يبقى التراب في الكتابة المنحوتة فيمكن القراءة
Dialogue: 0,0:12:45.81,0:12:49.94,Default,,0000,0000,0000,,"يُظهر عقرب الشمس الزمن والطريق، اذهب شرقاً"
Dialogue: 0,0:12:50.73,0:12:52.69,Default,,0000,0000,0000,,أيّ اتّجاه هو الشرق؟
Dialogue: 0,0:12:52.89,0:12:54.35,Default,,0000,0000,0000,,ماذا؟ لا أدري
Dialogue: 0,0:12:54.55,0:12:56.35,Default,,0000,0000,0000,,لا جذع أشجار هذه المرّة
Dialogue: 0,0:12:57.13,0:12:59.84,Default,,0000,0000,0000,,عقرب الشمس؟ اذهب شرقاً؟
Dialogue: 0,0:13:00.04,0:13:00.81,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:13:02.52,0:13:04.15,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:13:06.39,0:13:09.31,Default,,0000,0000,0000,,سيعطينا هذا الاتجاه بالفعل
Dialogue: 0,0:13:09.90,0:13:11.60,Default,,0000,0000,0000,,،إنّ وجهت عقرب الساعة للشمس
Dialogue: 0,0:13:11.80,0:13:15.88,Default,,0000,0000,0000,,سيكون الجنوب منتصف المسافة بينه والثانية عشرة
Dialogue: 0,0:13:16.08,0:13:19.00,Default,,0000,0000,0000,,فيكون الشرق تسعين درجة يساراً
Dialogue: 0,0:13:19.20,0:13:21.27,Default,,0000,0000,0000,,...ما يعني
Dialogue: 0,0:13:22.12,0:13:23.22,Default,,0000,0000,0000,,الشرق من هنا
Dialogue: 0,0:13:23.42,0:13:27.22,Default,,0000,0000,0000,,"مذهل يا كونان-كن! "حكمة العجوزة، الجزء 2
Dialogue: 0,0:13:27.77,0:13:29.45,Default,,0000,0000,0000,,يـ-يكفي من هذا
Dialogue: 0,0:13:29.64,0:13:31.23,Default,,0000,0000,0000,,!حسنٌ! هيّا بنا
Dialogue: 0,0:13:31.23,0:13:32.22,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:13:34.40,0:13:36.77,On Top,,0000,0000,0000,,شجرة بوسبوروس
Dialogue: 0,0:13:40.47,0:13:44.15,On Top,,0000,0000,0000,,منزل كبير القبيلة
Dialogue: 0,0:13:48.35,0:13:52.73,On Top,,0000,0000,0000,,تلّ الدبّ الأكبر والدبّ الأصغر
Dialogue: 0,0:14:04.69,0:14:09.13,Default,,0000,0000,0000,,"امش من حيث يشير ماء السماء والصخور. خمسة"
Dialogue: 0,0:14:09.33,0:14:11.37,Default,,0000,0000,0000,,ما المقصود بماء السماء؟
Dialogue: 0,0:14:11.57,0:14:12.89,Default,,0000,0000,0000,,المطر؟
Dialogue: 0,0:14:12.89,0:14:14.40,Default,,0000,0000,0000,,أليس ذلك تفكيراً بسيطاً؟
Dialogue: 0,0:14:14.60,0:14:15.97,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:14:17.49,0:14:21.14,Default,,0000,0000,0000,,...خمسة أعمدة صخرية... إن كانت هذه الصخور
Dialogue: 0,0:14:21.88,0:14:23.35,Default,,0000,0000,0000,,!ارفعني قليلاً يا غينتا
Dialogue: 0,0:14:23.35,0:14:25.98,Default,,0000,0000,0000,,!ما بك فجأةً؟
Dialogue: 0,0:14:30.31,0:14:32.44,Default,,0000,0000,0000,,"تشكّل الأعمدة حرف "دبليو
Dialogue: 0,0:14:32.64,0:14:35.90,Default,,0000,0000,0000,,!دبليو... ويست... الغرب، هكذا إذاً
Dialogue: 0,0:14:36.10,0:14:38.60,Default,,0000,0000,0000,,ما المقصود بماء السماء في هذه الحالة؟
Dialogue: 0,0:14:38.76,0:14:41.29,Default,,0000,0000,0000,,أوجدت شيئاً يا كونان-كن؟
Dialogue: 0,0:14:41.49,0:14:45.06,Default,,0000,0000,0000,,أجل، أتساءل إن كانت خمس خطوات غرب العمود الأوسط؟
Dialogue: 0,0:14:50.72,0:14:52.48,Default,,0000,0000,0000,,...لنرَ
Dialogue: 0,0:14:52.68,0:14:55.56,Default,,0000,0000,0000,,!كونان! لا شيء هنا
Dialogue: 0,0:14:58.19,0:15:01.02,Default,,0000,0000,0000,,"إذا لم تكن دبليو الرامزة للغرب، ربما كانت "إم
Dialogue: 0,0:15:01.22,0:15:03.28,Default,,0000,0000,0000,,أو "بي" حتّى
Dialogue: 0,0:15:03.48,0:15:05.43,Default,,0000,0000,0000,,...لكن ما المقصود بماء السمـ
Dialogue: 0,0:15:07.22,0:15:08.52,Default,,0000,0000,0000,,ما الخطب يا ميتسوهيكو؟
Dialogue: 0,0:15:08.52,0:15:10.02,Default,,0000,0000,0000,,!أين أنت؟ يا ميتسوهيكو-كن
Dialogue: 0,0:15:10.22,0:15:11.81,Default,,0000,0000,0000,,!هنا، هنا
Dialogue: 0,0:15:12.06,0:15:13.19,Default,,0000,0000,0000,,!ميتسوهيكو
Dialogue: 0,0:15:13.39,0:15:18.45,Default,,0000,0000,0000,,تعثّرت على شجرة ثمّ ارتطم رأسي بتلك الصخرة
Dialogue: 0,0:15:20.32,0:15:21.81,Default,,0000,0000,0000,,!شجرة وصخرة؟
Dialogue: 0,0:15:25.23,0:15:27.65,Default,,0000,0000,0000,,يبدو أنّها لم تُحرّك لوقت طويل
Dialogue: 0,0:15:30.04,0:15:31.06,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:15:33.51,0:15:35.44,Default,,0000,0000,0000,,...أيمكن أنّ هذا الشكل
Dialogue: 0,0:15:39.89,0:15:43.35,Default,,0000,0000,0000,,إنّها مجموعة الدبّ الأكبر النجمية من جذوع أشجار وصخور
Dialogue: 0,0:15:43.55,0:15:44.57,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:15:44.77,0:15:47.43,Default,,0000,0000,0000,,"شكلها كمغرفة، لذا "ماء السماء
Dialogue: 0,0:15:47.63,0:15:49.56,Default,,0000,0000,0000,,...ما يعني
Dialogue: 0,0:15:53.79,0:15:57.12,Default,,0000,0000,0000,,فهمت، تلك الأعمدة هي كوكبة ذات الكرسيّ
Dialogue: 0,0:15:57.32,0:16:01.77,Default,,0000,0000,0000,,أي أنّ ماء السماء والصخور تشير لنجم الشمال
Dialogue: 0,0:16:02.42,0:16:06.62,Default,,0000,0000,0000,,يبعد نجم الشمال خمسة أضعاف المسافة
Dialogue: 0,0:16:06.82,0:16:08.81,Default,,0000,0000,0000,,!بين نجمي طرف الدبّ الأكبر
Dialogue: 0,0:16:10.06,0:16:13.46,Default,,0000,0000,0000,,ويقع أيضاً مقابل نجم ذات الكرسيّ الأوسط
Dialogue: 0,0:16:13.66,0:16:19.34,Default,,0000,0000,0000,,وبخمسة أضعاف المسافة بين كلّ من نجومها
Dialogue: 0,0:16:24.96,0:16:27.88,Default,,0000,0000,0000,,...البروفسور المخادع
Dialogue: 0,0:16:30.36,0:16:32.93,Default,,0000,0000,0000,,!توجد صخرة بكتابة عليها هنا
Dialogue: 0,0:16:33.13,0:16:34.47,Default,,0000,0000,0000,,توقّعت ذلك
Dialogue: 0,0:16:34.89,0:16:37.93,Default,,0000,0000,0000,,"بولاريس هو النجم الشمالي، لذا حرف "بّي
Dialogue: 0,0:16:38.31,0:16:41.39,Default,,0000,0000,0000,,ها هو، إنّه المكان بلا شك
Dialogue: 0,0:16:43.79,0:16:46.17,Default,,0000,0000,0000,,تذكّروا، خمس خطوات
Dialogue: 0,0:16:46.37,0:16:47.35,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:47.89,0:16:51.81,Default,,0000,0000,0000,,واحد، اثنان، ثلاثة، أربعة
Dialogue: 0,0:16:52.23,0:16:53.30,Default,,0000,0000,0000,,!خمسة
Dialogue: 0,0:16:57.05,0:16:58.55,Default,,0000,0000,0000,,!ابتعدوا جميعاً
Dialogue: 0,0:17:02.72,0:17:03.85,Default,,0000,0000,0000,,!حسنٌ، لنذهب
Dialogue: 0,0:17:03.85,0:17:05.19,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:17:13.48,0:17:15.16,Default,,0000,0000,0000,,...كونان-كن، أهذا
Dialogue: 0,0:17:15.36,0:17:16.84,Default,,0000,0000,0000,,!الكنز حتماً
Dialogue: 0,0:17:17.03,0:17:18.89,Default,,0000,0000,0000,,!أسرع وافتحه يا كونان
Dialogue: 0,0:17:26.62,0:17:28.50,Default,,0000,0000,0000,,...أيمكن أنّ هذه الجواهر
Dialogue: 0,0:17:28.68,0:17:30.09,Default,,0000,0000,0000,,!فعلناها يا ميتسوهيكو
Dialogue: 0,0:17:30.29,0:17:32.80,Default,,0000,0000,0000,,يمكنني أكل قدرما أشاء\N!من أطباق الأنقليس في العالم الآن
Dialogue: 0,0:17:33.00,0:17:35.52,Default,,0000,0000,0000,,...أجل! وأنا سوف
Dialogue: 0,0:17:35.69,0:17:38.22,Default,,0000,0000,0000,,أعتذر على مقاطعة تسليتكم
Dialogue: 0,0:17:39.02,0:17:41.12,Default,,0000,0000,0000,,لكن عليكم تسليمه لنا
Dialogue: 0,0:17:41.32,0:17:43.14,Default,,0000,0000,0000,,!أنتَ ذاك الرجل
Dialogue: 0,0:17:43.54,0:17:46.61,Default,,0000,0000,0000,,لا شكّ، إنّهما لصّا الجواهر
Dialogue: 0,0:17:46.81,0:17:49.06,Default,,0000,0000,0000,,!هيّا، سلّموه
Dialogue: 0,0:17:50.91,0:17:51.85,Default,,0000,0000,0000,,!هيّا
Dialogue: 0,0:17:55.87,0:17:58.43,Default,,0000,0000,0000,,لا تثر المتاعب يا أحمق
Dialogue: 0,0:18:00.69,0:18:02.18,Default,,0000,0000,0000,,!انطلقي
Dialogue: 0,0:18:06.53,0:18:09.31,Default,,0000,0000,0000,,أخبرني الرجل في الأسفل أن أعطيك هذه
Dialogue: 0,0:18:10.76,0:18:11.72,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:18:18.72,0:18:22.28,Default,,0000,0000,0000,,كونان-كن، ما الذي حصل؟
Dialogue: 0,0:18:23.37,0:18:26.29,Default,,0000,0000,0000,,ربما تعثّر بصخرة وارتطم رأسه؟
Dialogue: 0,0:18:26.49,0:18:27.68,Default,,0000,0000,0000,,تقصد مثل ميتسوهيكو؟
Dialogue: 0,0:18:27.88,0:18:31.60,Default,,0000,0000,0000,,!ليس شيئاً مُضحكاً! كان يؤلم حقاً
Dialogue: 0,0:18:35.03,0:18:37.92,Default,,0000,0000,0000,,ها هو، هذا كنزنا الحقيقيّ
Dialogue: 0,0:18:38.12,0:18:39.31,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:44.57,0:18:48.85,Default,,0000,0000,0000,,أتقصد أنّ هذا الكنز؟
Dialogue: 0,0:18:49.05,0:18:51.17,Default,,0000,0000,0000,,لفافة الورق الوحيدة هذه؟
Dialogue: 0,0:18:51.37,0:18:53.39,Default,,0000,0000,0000,,ما المكتوب يا كونان-كن؟
Dialogue: 0,0:18:55.57,0:19:00.94,Default,,0000,0000,0000,,الكنز هو كلّ تجاربكم التي"\Nمررتم بها للوصول هنا
Dialogue: 0,0:19:02.18,0:19:04.60,Default,,0000,0000,0000,,،ربما سقطتم في النهر
Dialogue: 0,0:19:04.89,0:19:06.78,Default,,0000,0000,0000,,أشعلتم ناراً واصطدتم سمكاً
Dialogue: 0,0:19:07.28,0:19:10.04,Default,,0000,0000,0000,,وتعاونتم مع أصدقائكم للوصول هنا
Dialogue: 0,0:19:10.24,0:19:12.02,Default,,0000,0000,0000,,كلّ تلك التجارب
Dialogue: 0,0:19:13.32,0:19:15.46,Default,,0000,0000,0000,,قد لا تفهمون الآن
Dialogue: 0,0:19:15.66,0:19:20.30,Default,,0000,0000,0000,,لكن يوماً ما سيكون كلّ هذا\Nكنزاً نفيساً بلا شك
Dialogue: 0,0:19:20.67,0:19:22.27,Default,,0000,0000,0000,,وثروة ربما
Dialogue: 0,0:19:23.17,0:19:28.93,Default,,0000,0000,0000,,"!إن أمكن، انقلوا هذه المغامرة لمن يتبعونكم رجاءً
Dialogue: 0,0:19:29.46,0:19:32.53,Default,,0000,0000,0000,,...لا أفهم حقاً
Dialogue: 0,0:19:32.73,0:19:35.70,Default,,0000,0000,0000,,حسناً، لا يهم... شعورٌ كهذا، صحيح؟
Dialogue: 0,0:19:35.90,0:19:38.93,Default,,0000,0000,0000,,أجل، نوعاً ما
Dialogue: 0,0:19:49.27,0:19:51.60,Default,,0000,0000,0000,,...يوساكو كودو
Dialogue: 0,0:19:52.77,0:19:56.26,Default,,0000,0000,0000,,ستكتشف عندما تصل للنهاية
Dialogue: 0,0:19:59.02,0:20:01.02,Default,,0000,0000,0000,,!أبي كتب هذه
Dialogue: 0,0:20:01.65,0:20:06.29,Default,,0000,0000,0000,,من غيره قد يستطيع محاكاة\N انعقافة حرف "كيه" تلك؟
Dialogue: 0,0:20:09.97,0:20:12.46,Default,,0000,0000,0000,,كان عليّ أن ألحظ من البداية
Dialogue: 0,0:20:12.66,0:20:15.76,Default,,0000,0000,0000,,القمّة مقابل النهر الذي كنّا نخيّم عنده
Dialogue: 0,0:20:15.96,0:20:18.52,Default,,0000,0000,0000,,كانت المكان الذي نسعى له
Dialogue: 0,0:20:20.01,0:20:24.04,Default,,0000,0000,0000,,لم أتصوّر أن أرى مخيم البروفسور من فوق تلك الشجرة
Dialogue: 0,0:20:30.67,0:20:32.94,Default,,0000,0000,0000,,لكن رغم أنّ المسافة لم تكن بعيدة
Dialogue: 0,0:20:33.42,0:20:35.90,Default,,0000,0000,0000,,كانت الرحلة مُضنية
Dialogue: 0,0:20:36.99,0:20:40.18,Default,,0000,0000,0000,,بعد سماعه بالوضع، اتّصل البروفسور بالشرطة فوراً
Dialogue: 0,0:20:40.38,0:20:42.55,Default,,0000,0000,0000,,وتمّ اعتقال لِصَّي المجوهرات
Dialogue: 0,0:20:42.75,0:20:47.28,Default,,0000,0000,0000,,،قرّروا استجوابنا في اليوم التالي\N فتركونا بحالنا الليلة
Dialogue: 0,0:20:53.70,0:20:56.61,Default,,0000,0000,0000,,اعتبرتها رحلة بحث عن كنز سخيفة بدايةً
Dialogue: 0,0:20:57.08,0:20:59.72,Default,,0000,0000,0000,,لكنّ المغامرات كهذه لا يُملّ منها
Dialogue: 0,0:21:00.88,0:21:04.44,Default,,0000,0000,0000,,رغم أنّي في السابعة عشر، استمتعتُ بها كثيراً
Dialogue: 0,0:21:08.22,0:21:11.26,Default,,0000,0000,0000,,لم تكن الجواهر الكنز في النهاية
Dialogue: 0,0:21:12.84,0:21:14.23,Default,,0000,0000,0000,,...لكنّي وجدتُه يا أبي، وجدتُه فعلاً
Dialogue: 0,0:21:14.99,0:21:22.52,Default,,0000,0000,0000,,الكنز الحقيقيّ
Dialogue: 0,0:21:18.89,0:21:26.52,On Top,,0000,0000,0000,,شينتشي كودو
Dialogue: 0,0:22:59.19,0:23:02.64,Default,,0000,0000,0000,,حدث ذلك بعد فترة قصيرة من ولادتك يا شينتشي
Dialogue: 0,0:23:03.23,0:23:06.83,Default,,0000,0000,0000,,سُرقت مخطوطة أبيك التي كاد يُعلن عنها
Dialogue: 0,0:23:07.03,0:23:08.19,Default,,0000,0000,0000,,سُرقت؟
Dialogue: 0,0:23:08.35,0:23:13.65,Default,,0000,0000,0000,,بالنظر للوضع، بدا أنّه عمل أحد معجبيه
Dialogue: 0,0:23:13.85,0:23:16.91,Default,,0000,0000,0000,,لكن لم يُعثر على اللصّ أو المخطوطة أبداً
Dialogue: 0,0:23:18.01,0:23:23.52,Default,,0000,0000,0000,,لصّ المجوهرات الذي مات في حادث\N هو من رسم الخريطة الأخرى إذاً
Dialogue: 0,0:23:23.68,0:23:29.97,Default,,0000,0000,0000,,أجل، لم يستطع نشر المخطوطة بما أنّها\Nمسروقة، فبقيت حبيسة الورق حتّى الآن
Dialogue: 0,0:23:30.33,0:23:34.02,Default,,0000,0000,0000,,لكن لم يخطر لي أن تظهر هكذا
Dialogue: 0,0:23:37.26,0:23:38.93,On Top,,0000,0000,0000,,يوساكو كودو
Dialogue: 0,0:23:43.89,0:23:46.56,On Top,,0000,0000,0000,,إلى ابني شينتشي
Dialogue: 0,0:24:03.00,0:24:04.44,Default,,0000,0000,0000,,!تبّاً! اختفيا
Dialogue: 0,0:24:09.45,0:24:10.81,Default,,0000,0000,0000,,!ران! انتبهي
Dialogue: 0,0:24:14.02,0:24:16.11,Default,,0000,0000,0000,,!ران! استيقظي! استيقظي
Dialogue: 0,0:24:21.09,0:24:23.55,Default,,0000,0000,0000,,!لمَ؟ لمَ يستهدف ران؟
