Dialogue: 0,0:00:02.09,0:00:04.30,Default,,0000,0000,0000,,!حلقة خاصة للمتحرّي كونان من 60 دقيقة
Dialogue: 0,0:00:04.90,0:00:06.60,Default,,0000,0000,0000,,قضيّة اليوم مخيفة قليلاً
Dialogue: 0,0:00:06.60,0:00:10.43,Default,,0000,0000,0000,,جريمة مستحيلة وغير منطقية\N!في معبد جبليّ معزول
Dialogue: 0,0:00:10.43,0:00:12.09,Default,,0000,0000,0000,,...أسطورة تينغو الضباب المُهيبة
Dialogue: 0,0:00:12.09,0:00:15.72,Default,,0000,0000,0000,,!مهما أُخفيت، تبقى الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.29,0:01:52.22,Title,,0000,0000,0000,,{\fad(300,0)}جرائم قتل أسطورة تينغو الضباب
Dialogue: 0,0:01:46.97,0:01:49.59,Default,,0000,0000,0000,,جرائم قتل أسطورة تينغو الضباب
Dialogue: 0,0:01:53.48,0:01:56.10,Default,,0000,0000,0000,,أزهار الكرز الجبلية جميلة حقاً
Dialogue: 0,0:01:56.10,0:01:58.09,Default,,0000,0000,0000,,انظرا، على ذاك الجبل أيضاً
Dialogue: 0,0:01:58.09,0:02:01.80,Default,,0000,0000,0000,,أزهار كرز سوميوشي لديهم في المدينة\Nليست سيّئة أيضاً
Dialogue: 0,0:02:02.05,0:02:07.12,Default,,0000,0000,0000,,لكنك تجد جمال أزهار الكرز الحقيقيّ\Nفي طبيعة الجبال فحسب
Dialogue: 0,0:02:07.12,0:02:09.67,Default,,0000,0000,0000,,بعيداً عن مظاهر الحضارة
Dialogue: 0,0:02:10.21,0:02:13.91,Default,,0000,0000,0000,,...يا لفلسفتك
Dialogue: 0,0:02:13.91,0:02:15.26,Default,,0000,0000,0000,,أقلت شيئاً؟
Dialogue: 0,0:02:15.83,0:02:19.51,Default,,0000,0000,0000,,استحقّ الأمر استئجار سيّارة والقدوم هنا، صحيح؟
Dialogue: 0,0:02:20.07,0:02:20.78,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:20.78,0:02:23.07,Default,,0000,0000,0000,,ما رأيكم بأن نلتقط صورة؟
Dialogue: 0,0:02:23.07,0:02:24.72,Default,,0000,0000,0000,,قفا هناك
Dialogue: 0,0:02:25.40,0:02:26.49,Default,,0000,0000,0000,,هيّا بنا يا كونان-كن
Dialogue: 0,0:02:26.49,0:02:27.17,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:30.73,0:02:33.05,Default,,0000,0000,0000,,!استعمل المؤقّت كي تتصوّر معنا يا أبي
Dialogue: 0,0:02:33.05,0:02:35.51,Default,,0000,0000,0000,,حسناً، انتظري قليلاً
Dialogue: 0,0:02:36.14,0:02:37.71,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:02:38.43,0:02:41.26,Default,,0000,0000,0000,,هذا الرجل هو المتحرّي الذي سيشتهر، موري كوغورو
Dialogue: 0,0:02:41.59,0:02:45.26,Default,,0000,0000,0000,,وهذه صديقة طفولتي وزميلتي، موري ران
Dialogue: 0,0:02:45.59,0:02:48.11,Default,,0000,0000,0000,,ماذا؟ كيف تكون زميلتي؟
Dialogue: 0,0:02:49.53,0:02:53.84,Default,,0000,0000,0000,,في الحقيقة، أنا مُتحرٍّ في المدرسة الثانوية\Nأُدعى كودو شينتشي
Dialogue: 0,0:02:53.84,0:02:57.21,Default,,0000,0000,0000,,...أجل، بدأ كلّ شيء ذاك اليوم
Dialogue: 0,0:02:57.95,0:03:00.42,Default,,0000,0000,0000,,ذهبتُ إلى تروبيكال لاند مع ران
Dialogue: 0,0:03:00.82,0:03:04.09,Default,,0000,0000,0000,,وشهدتُ هناك ابتزاز منظمة غامضة لأحدهم
Dialogue: 0,0:03:05.16,0:03:06.97,Default,,0000,0000,0000,,كنتُ أشاهد فودكا، رجلاً برداء أسود
Dialogue: 0,0:03:08.42,0:03:13.98,Default,,0000,0000,0000,,بينما تسلّل ورائي جين، رجل آخر برداء أسود
Dialogue: 0,0:03:13.98,0:03:15.72,Default,,0000,0000,0000,,وأطاحني بضربة
Dialogue: 0,0:03:15.72,0:03:19.51,Default,,0000,0000,0000,,بعدها جعلني أتجرّع عقاراً طوّرته المنظمة
Dialogue: 0,0:03:29.21,0:03:31.60,Default,,0000,0000,0000,,!جسمي ساخن
Dialogue: 0,0:03:32.88,0:03:36.50,Default,,0000,0000,0000,,!كأنّ... عظامي تذوب
Dialogue: 0,0:03:36.50,0:03:39.15,Default,,0000,0000,0000,,!لا-لا أستطيع
Dialogue: 0,0:03:42.20,0:03:45.39,Default,,0000,0000,0000,,...عندما أيقظني ضابط شرطة
Dialogue: 0,0:03:45.39,0:03:47.71,Default,,0000,0000,0000,,!وجدتُ أنّ جسدي تقلّص
Dialogue: 0,0:03:48.23,0:03:50.36,Default,,0000,0000,0000,,كلّ ما علينا فعله هو العثور عليهم إذاً
Dialogue: 0,0:03:50.36,0:03:51.80,Default,,0000,0000,0000,,!ثمّ أخذ ذاك العقار
Dialogue: 0,0:03:51.80,0:03:53.44,Default,,0000,0000,0000,,اسمع يا شينتشي
Dialogue: 0,0:03:53.44,0:03:55.23,Default,,0000,0000,0000,,،إن عرفوا أنّك لا تزال حيّاً
Dialogue: 0,0:03:55.23,0:03:57.67,Default,,0000,0000,0000,,سيعودون للقضاء عليك
Dialogue: 0,0:03:58.10,0:04:00.60,Default,,0000,0000,0000,,!لذا أبقِ ما حصل سرّاً بيننا فقط
Dialogue: 0,0:04:00.60,0:04:02.35,Default,,0000,0000,0000,,!إيّاك أن تخبر أحداً
Dialogue: 0,0:04:02.35,0:04:04.47,Default,,0000,0000,0000,,!حتّى ران-كن بالطبع
Dialogue: 0,0:04:04.47,0:04:07.13,Default,,0000,0000,0000,,هذا الرجل المُسن هو البروفسور أغاسا، مخترع
Dialogue: 0,0:04:09.21,0:04:13.80,Default,,0000,0000,0000,,وبعد تقلّص جسدي، غيّرت اسمي لإيدوغاوا كونان
Dialogue: 0,0:04:13.80,0:04:17.21,Default,,0000,0000,0000,,وذهبتُ للعيش مع ران ووالدها المتحرّي
Dialogue: 0,0:04:17.75,0:04:20.47,Default,,0000,0000,0000,,بأمل الحصول على معلومات عن الرجال بالرداء الأسود
Dialogue: 0,0:04:20.83,0:04:23.64,Default,,0000,0000,0000,,لكنّه كان متحرّياً فاشلاً
Dialogue: 0,0:04:24.08,0:04:29.42,Default,,0000,0000,0000,,لذا استعملتُ ساعة اليد المخدّرة لتنويمه
Dialogue: 0,0:04:29.86,0:04:34.10,Default,,0000,0000,0000,,ثمّ ربطة العنق المغيّرة للصوت\Nلحلّ مختلف القضايا الصعبة
Dialogue: 0,0:04:36.97,0:04:39.63,Default,,0000,0000,0000,,وهكذا كانت حياتي للآن ككونان
Dialogue: 0,0:04:40.06,0:04:43.93,Default,,0000,0000,0000,,متى سأرجع لجسدي الطبيعيّ يا ترى؟
Dialogue: 0,0:04:43.93,0:04:46.89,Default,,0000,0000,0000,,!حسناً، سيحصل ذلك متى يحصل
Dialogue: 0,0:04:46.89,0:04:47.67,Default,,0000,0000,0000,,!ابتسام
Dialogue: 0,0:04:50.55,0:04:51.93,Default,,0000,0000,0000,,حسناً، لنرجع
Dialogue: 0,0:04:52.42,0:04:56.14,Default,,0000,0000,0000,,يبدو أنّ هناك طريقاً مختصراً أمامنا، فلنسلكه
Dialogue: 0,0:04:56.46,0:05:00.37,Default,,0000,0000,0000,,أأنت متأكد يا أبي؟ ألن نضلّ؟
Dialogue: 0,0:05:00.37,0:05:03.24,Default,,0000,0000,0000,,!لا تقلقي، سيكون الأمر بخير
Dialogue: 0,0:05:03.24,0:05:04.66,Default,,0000,0000,0000,,هيّا بنا
Dialogue: 0,0:05:09.73,0:05:13.80,Default,,0000,0000,0000,,!كما أخبرتك! قلقي في محلّه
Dialogue: 0,0:05:14.07,0:05:16.93,Default,,0000,0000,0000,,!لدينا إطار مثقوب فوق ضياعنا
Dialogue: 0,0:05:16.93,0:05:20.10,Default,,0000,0000,0000,,أُفسدت رحلتنا المسليّة الآن
Dialogue: 0,0:05:20.10,0:05:22.14,Default,,0000,0000,0000,,اصمتي
Dialogue: 0,0:05:24.27,0:05:25.76,Default,,0000,0000,0000,,يأتي المطر ليزيد الطين بلّة
Dialogue: 0,0:05:26.10,0:05:27.21,Default,,0000,0000,0000,,ماذا سنفعل؟
Dialogue: 0,0:05:27.21,0:05:29.88,Default,,0000,0000,0000,,!لا نزال نبعد 20 إلى 30 كم عن أسفل الجيل
Dialogue: 0,0:05:29.88,0:05:31.59,Default,,0000,0000,0000,,لا خيار لدينا
Dialogue: 0,0:05:31.59,0:05:34.71,Default,,0000,0000,0000,,لا يبدو أنّ أحداً يعيش في القرب
Dialogue: 0,0:05:34.71,0:05:36.60,Default,,0000,0000,0000,,لذا علينا قضاء الليلة في السيّارة
Dialogue: 0,0:05:38.20,0:05:40.58,Default,,0000,0000,0000,,!لا أريد التخييم في مكان كهذا
Dialogue: 0,0:05:40.58,0:05:42.68,Default,,0000,0000,0000,,ألا يمكنك إصلاح الإطار المثقوب؟
Dialogue: 0,0:05:43.00,0:05:46.00,Default,,0000,0000,0000,,لا إطار بديل لدينا
Dialogue: 0,0:05:46.00,0:05:49.63,Default,,0000,0000,0000,,ثُقب إطاران في اليوم ذاته، يا للحظ السيّئ
Dialogue: 0,0:05:50.69,0:05:52.94,Default,,0000,0000,0000,,ماذا؟ أين ذهب؟
Dialogue: 0,0:05:54.69,0:05:56.69,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:05:56.69,0:05:58.42,Default,,0000,0000,0000,,أين أنت يا كونان-كن؟
Dialogue: 0,0:06:02.02,0:06:03.77,Default,,0000,0000,0000,,لمَ الهلع؟
Dialogue: 0,0:06:03.77,0:06:05.77,Default,,0000,0000,0000,,إنّها طيور فحسب
Dialogue: 0,0:06:07.97,0:06:10.92,Default,,0000,0000,0000,,ما الخطب يا ران-نيتشان؟\Nلمَ صرختِ للتو؟
Dialogue: 0,0:06:11.47,0:06:13.67,Default,,0000,0000,0000,,ماذا؟ ما الذي تتكلم عنه؟
Dialogue: 0,0:06:13.67,0:06:15.80,Default,,0000,0000,0000,,بغض النظر عن ذلك، أين كنت؟
Dialogue: 0,0:06:15.80,0:06:17.88,Default,,0000,0000,0000,,!لا يصحّ بك التجوّل بمفردك
Dialogue: 0,0:06:17.88,0:06:21.29,Default,,0000,0000,0000,,وجدتُ معبداً في الطريق هناك
Dialogue: 0,0:06:21.29,0:06:23.13,Default,,0000,0000,0000,,لا بدّ أن أحداً يعيش في تلك الأنحاء
Dialogue: 0,0:06:31.36,0:06:35.36,Default,,0000,0000,0000,,معك حق، يوجد معبد في مكان كهذا
Dialogue: 0,0:06:35.36,0:06:36.85,Default,,0000,0000,0000,,!نجونا
Dialogue: 0,0:06:37.19,0:06:39.56,Default,,0000,0000,0000,,حسنٌ، لنذهب لتفقده
Dialogue: 0,0:06:39.56,0:06:40.17,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:45.14,0:06:47.34,Default,,0000,0000,0000,,إنّه مبنيّ في مكان مُبهر بالفعل
Dialogue: 0,0:06:50.05,0:06:52.13,Default,,0000,0000,0000,,...معبد ساندي
Dialogue: 0,0:06:52.38,0:06:55.43,Default,,0000,0000,0000,,يبدو أنّ خيارنا الوحيد المبيت هنا
Dialogue: 0,0:06:57.29,0:07:00.01,Default,,0000,0000,0000,,مرحباً؟ اعذرونا على التطفّل
Dialogue: 0,0:07:00.01,0:07:01.86,Default,,0000,0000,0000,,أيوجد أحد؟
Dialogue: 0,0:07:03.21,0:07:05.14,Default,,0000,0000,0000,,ما الذي تريدونه؟
Dialogue: 0,0:07:08.70,0:07:11.63,Default,,0000,0000,0000,,سألتكم ماذا تريدون هنا؟
Dialogue: 0,0:07:12.16,0:07:17.67,Default,,0000,0000,0000,,أيمكن أنّكم من صحيفة أو محطّة تلفازية؟
Dialogue: 0,0:07:18.02,0:07:19.23,Default,,0000,0000,0000,,!ارحلوا
Dialogue: 0,0:07:19.23,0:07:22.30,Default,,0000,0000,0000,,!ليس هذا مكاناً لمتطفلين فظّين مثلكم
Dialogue: 0,0:07:22.81,0:07:26.80,Default,,0000,0000,0000,,كلا، كنا نعبر بالجوار عندما ثُقِب إطارنا
Dialogue: 0,0:07:26.80,0:07:30.47,Default,,0000,0000,0000,,...وخطر لنا أن نسألكم لو يمكننا المبيت الليلة هنا
Dialogue: 0,0:07:30.91,0:07:33.89,Default,,0000,0000,0000,,!ماذا؟ تريدون المبيت هنا؟
Dialogue: 0,0:07:34.21,0:07:35.47,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:07:35.47,0:07:39.21,Default,,0000,0000,0000,,...لكن إن كانت مشكلةً، فسنغادر فوراً
Dialogue: 0,0:07:39.21,0:07:43.42,Default,,0000,0000,0000,,!هكذا إذاً! كان عليك أن تقول قبلاً
Dialogue: 0,0:07:43.42,0:07:47.17,Default,,0000,0000,0000,,...ظننتكم صحفيّين أتوا للسؤال عن تلك الحادثة
Dialogue: 0,0:07:47.99,0:07:49.63,Default,,0000,0000,0000,,أيّ حادثة؟
Dialogue: 0,0:07:49.63,0:07:52.37,Default,,0000,0000,0000,,لا شيء مهم
Dialogue: 0,0:07:52.37,0:07:57.06,Default,,0000,0000,0000,,سيكلّف مبيت ليلة زائد وجبات نباتيّة\Nعشرة آلاف ينّ للبالغ
Dialogue: 0,0:07:57.06,0:07:58.98,Default,,0000,0000,0000,,وثمانية آلاف للطفل
Dialogue: 0,0:07:58.98,0:08:02.97,Default,,0000,0000,0000,,...هذا المعبد يمثّل نُزلاً صغيراً أيضاً
Dialogue: 0,0:08:02.97,0:08:05.06,Default,,0000,0000,0000,,!عشرة آلاف ين؟
Dialogue: 0,0:08:05.06,0:08:06.85,Default,,0000,0000,0000,,اقبل أو ارفض
Dialogue: 0,0:08:06.85,0:08:09.10,Default,,0000,0000,0000,,تستغرق المسافة 6 ساعات لأسفل الجبل
Dialogue: 0,0:08:09.10,0:08:11.01,Default,,0000,0000,0000,,امش إذا أردت
Dialogue: 0,0:08:11.01,0:08:13.43,Default,,0000,0000,0000,,لم أرفض بعد
Dialogue: 0,0:08:13.43,0:08:14.14,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:14.14,0:08:17.59,Default,,0000,0000,0000,,!اسمعوا، لدينا ضيوف بعد وقت طويل
Dialogue: 0,0:08:17.88,0:08:19.17,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:08:19.17,0:08:21.47,Default,,0000,0000,0000,,...لم أقل أنّي سأقبل أيضاً
Dialogue: 0,0:08:21.96,0:08:25.59,Default,,0000,0000,0000,,خذ نصيحتي، بِت هنا
Dialogue: 0,0:08:25.59,0:08:27.58,Default,,0000,0000,0000,,ففي ليال ممطرة كالليلة
Dialogue: 0,0:08:27.58,0:08:30.42,Default,,0000,0000,0000,,لا تعرف أين قد يختبئ
Dialogue: 0,0:08:30.70,0:08:31.91,Default,,0000,0000,0000,,قد يختبئ؟
Dialogue: 0,0:08:31.91,0:08:33.39,Default,,0000,0000,0000,,أيوجد دب في الجوار؟
Dialogue: 0,0:08:33.91,0:08:35.74,Default,,0000,0000,0000,,دب؟
Dialogue: 0,0:08:35.74,0:08:38.59,Default,,0000,0000,0000,,...ليس شيئاً بتلك الظرافة
Dialogue: 0,0:08:40.15,0:08:43.09,Default,,0000,0000,0000,,أقصد الوحش القديم الذي يُحب المطر والظلام
Dialogue: 0,0:08:43.57,0:08:45.49,Default,,0000,0000,0000,,ويلتهم أرواح الناس
Dialogue: 0,0:08:47.06,0:08:48.51,Default,,0000,0000,0000,,!تينغو الضباب
Dialogue: 0,0:08:48.89,0:08:50.51,Default,,0000,0000,0000,,تـ-تينغو الضباب؟
Dialogue: 0,0:08:55.50,0:08:58.63,Default,,0000,0000,0000,,!ما الذي أفعله؟! هذا الاسم محظور هنا
Dialogue: 0,0:08:58.63,0:09:00.67,Default,,0000,0000,0000,,!انسوا ما قلتُه
Dialogue: 0,0:09:04.88,0:09:06.22,Default,,0000,0000,0000,,ها أنتم
Dialogue: 0,0:09:07.15,0:09:12.38,Default,,0000,0000,0000,,دعوني أقدّم لكم الرهبان الأربعة\Nقيد التمرين في هذا المعبد
Dialogue: 0,0:09:12.60,0:09:18.68,Default,,0000,0000,0000,,هذا كانّين، أقدم الأربعة هنا\Nوأشبه بالأخ الكبير للبقيّة
Dialogue: 0,0:09:19.60,0:09:20.58,Default,,0000,0000,0000,,!سُررت بلقائكم
Dialogue: 0,0:09:20.89,0:09:25.55,Default,,0000,0000,0000,,هذا تونّين، شره قليلاً لكنّه طاهٍ بارع\Nوقويّ البنية أيضاً
Dialogue: 0,0:09:26.14,0:09:30.84,Default,,0000,0000,0000,,هذا موكونين، نترك كلّ أعمال التجارة له\Nلحرفيّته وبراعة يديه
Dialogue: 0,0:09:30.84,0:09:32.00,Default,,0000,0000,0000,,يسرّني لقاؤكم
Dialogue: 0,0:09:32.51,0:09:35.17,Default,,0000,0000,0000,,هذا شونين، أتى لمعبدنا هذا العام
Dialogue: 0,0:09:35.17,0:09:38.66,Default,,0000,0000,0000,,رغم أنه خجول، لكنه مُجتهد في الدراسة وحاد الذهن
Dialogue: 0,0:09:38.66,0:09:39.46,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:09:39.46,0:09:44.38,Default,,0000,0000,0000,,وأنا تيني، الراهب الأكبر لهذا المعبد
Dialogue: 0,0:09:45.25,0:09:48.45,Default,,0000,0000,0000,,تونّين وموكونين، فلتحضّرا العشاء
Dialogue: 0,0:09:48.45,0:09:53.51,Default,,0000,0000,0000,,بينما ليرشد كانّين وشونين ضيوفنا داخل المعبد
Dialogue: 0,0:09:53.51,0:09:54.09,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:09:54.78,0:09:57.48,Default,,0000,0000,0000,,يبدو أنّنا سنبيت
Dialogue: 0,0:09:57.48,0:09:58.69,Default,,0000,0000,0000,,تبّاً
Dialogue: 0,0:09:58.69,0:10:01.02,Default,,0000,0000,0000,,بأجر تأخير السيّارة المستأجرة\Nوتكلفة البقاء هنا
Dialogue: 0,0:10:01.02,0:10:03.29,Default,,0000,0000,0000,,لن أملك مالاً للساكي هذا الشهر
Dialogue: 0,0:10:03.77,0:10:06.75,Default,,0000,0000,0000,,هذه ردهة معبد ساندي الأساسية
Dialogue: 0,0:10:07.22,0:10:09.29,Default,,0000,0000,0000,,مُبهرة بحق
Dialogue: 0,0:10:10.09,0:10:13.18,Default,,0000,0000,0000,,ما رأيك بإقامة شعائر جنازتك هنا؟
Dialogue: 0,0:10:14.18,0:10:15.88,Default,,0000,0000,0000,,!أمزح فحسب
Dialogue: 0,0:10:15.88,0:10:16.51,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:10:18.92,0:10:20.33,Default,,0000,0000,0000,,من هنا إذاً
Dialogue: 0,0:10:27.70,0:10:31.03,Default,,0000,0000,0000,,ماذا؟ لمَ يوجد قفل على تلك الغرفة؟
Dialogue: 0,0:10:34.32,0:10:35.50,Default,,0000,0000,0000,,...فارغة
Dialogue: 0,0:10:36.11,0:10:38.12,Default,,0000,0000,0000,,...يا فتى، تلك
Dialogue: 0,0:10:38.90,0:10:41.69,Default,,0000,0000,0000,,...مجرّد غرفة صغيرة
Dialogue: 0,0:10:41.69,0:10:42.67,Default,,0000,0000,0000,,!أيّها الفتى
Dialogue: 0,0:10:42.67,0:10:43.84,Default,,0000,0000,0000,,!فتى
Dialogue: 0,0:10:46.31,0:10:47.87,Default,,0000,0000,0000,,!سقف عالٍ
Dialogue: 0,0:10:48.22,0:10:50.75,Default,,0000,0000,0000,,ما هذه الغرفة أيّها الراهب؟
Dialogue: 0,0:10:51.51,0:10:53.71,Default,,0000,0000,0000,,أخبرنا... أيّها الراهب؟
Dialogue: 0,0:10:54.09,0:10:56.05,Default,,0000,0000,0000,,غرفة تأملّنا
Dialogue: 0,0:10:56.47,0:10:59.63,Default,,0000,0000,0000,,كانوا يحتجزون الرهبان الذين\Nخرقوا المبادئ العقائدية هنا سابقاً
Dialogue: 0,0:10:59.63,0:11:01.42,Default,,0000,0000,0000,,لجعلهم يراجعون أخطاءهم
Dialogue: 0,0:11:01.67,0:11:04.46,Default,,0000,0000,0000,,...لا عجب أنّها بُنيت بهذه الصلابة
Dialogue: 0,0:11:04.46,0:11:08.58,Default,,0000,0000,0000,,كما غطّوا جدران الغرفة بطلاء اللَّك لمنع التسلّق
Dialogue: 0,0:11:08.78,0:11:12.95,Default,,0000,0000,0000,,أخبرني، لمَ لون هذا الجانب مختلف؟
Dialogue: 0,0:11:12.95,0:11:18.58,Default,,0000,0000,0000,,لأنّ موكونين-سان أصلحه بعدما\Nحُطّم في تلك الحادثة
Dialogue: 0,0:11:19.15,0:11:22.23,Default,,0000,0000,0000,,أليس كذلك يا كانّين-سان؟
Dialogue: 0,0:11:22.23,0:11:23.59,Default,,0000,0000,0000,,أيّ حادثة؟
Dialogue: 0,0:11:24.36,0:11:27.43,Default,,0000,0000,0000,,وقعت قبل قدومي لهذا المعبد
Dialogue: 0,0:11:27.43,0:11:29.29,Default,,0000,0000,0000,,فلا أعرف التفاصيل
Dialogue: 0,0:11:29.58,0:11:30.77,Default,,0000,0000,0000,,...لكن يبدو أنّ تينغو الضباب
Dialogue: 0,0:11:30.77,0:11:32.10,Default,,0000,0000,0000,,!يكفي يا شونين
Dialogue: 0,0:11:32.10,0:11:34.75,Default,,0000,0000,0000,,!لا داعي لتثقل على ضيوفنا بذلك
Dialogue: 0,0:11:35.76,0:11:37.20,Default,,0000,0000,0000,,...آسف
Dialogue: 0,0:11:38.00,0:11:40.29,Default,,0000,0000,0000,,ماذا؟ ما هذا الصوت؟
Dialogue: 0,0:11:40.59,0:11:41.63,Default,,0000,0000,0000,,الشلّال
Dialogue: 0,0:11:41.63,0:11:43.25,Default,,0000,0000,0000,,هل تريدين رؤيته؟
Dialogue: 0,0:11:44.04,0:11:46.70,Default,,0000,0000,0000,,إنّه بجوار هذه الغرفة
Dialogue: 0,0:11:48.33,0:11:50.95,Default,,0000,0000,0000,,!كونان-كن! أسرع
Dialogue: 0,0:11:50.95,0:11:52.00,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:55.28,0:11:58.25,Default,,0000,0000,0000,,!مُذهل! الشلّال قريب جدّاً
Dialogue: 0,0:11:58.90,0:12:00.58,Default,,0000,0000,0000,,!مُبهر
Dialogue: 0,0:12:01.69,0:12:06.00,Default,,0000,0000,0000,,انظروا، بعضٌ من ماء الشلّال\N!ينهمر فوق الحاجز
Dialogue: 0,0:12:06.32,0:12:07.72,Default,,0000,0000,0000,,توخّوا الحذر
Dialogue: 0,0:12:07.72,0:12:09.89,Default,,0000,0000,0000,,لدينا لوح تصريف
Dialogue: 0,0:12:09.89,0:12:11.71,Default,,0000,0000,0000,,لكن هناك خطر الانزلاق
Dialogue: 0,0:12:13.18,0:12:15.17,Default,,0000,0000,0000,,هذه بتلات أزهار كرز، أليس كذلك؟
Dialogue: 0,0:12:15.81,0:12:21.05,Default,,0000,0000,0000,,بلى، سقطت من أشجار الكرز في الأعلى وجرفها الماء
Dialogue: 0,0:12:21.05,0:12:22.38,Default,,0000,0000,0000,,جميل بحقّ
Dialogue: 0,0:12:22.67,0:12:24.38,Default,,0000,0000,0000,,لنرجع
Dialogue: 0,0:12:24.38,0:12:26.95,Default,,0000,0000,0000,,يُفترض أنّ العشاء قد جهز
Dialogue: 0,0:12:32.37,0:12:34.54,Default,,0000,0000,0000,,يُعرف عن الرهبان تشددهم
Dialogue: 0,0:12:34.54,0:12:36.58,Default,,0000,0000,0000,,!لكن لديكم وقت للاستمتاع
Dialogue: 0,0:12:37.15,0:12:41.57,Default,,0000,0000,0000,,أجل، نذهب أحياناً وقت عطلتنا للشاطئ حتّى
Dialogue: 0,0:12:41.57,0:12:45.30,Default,,0000,0000,0000,,نأخذ طوف المعبد القابل للنفخ وكرة شاطئ
Dialogue: 0,0:12:45.98,0:12:49.47,Default,,0000,0000,0000,,والراهب الأكبر مُعجب بالفتيات بلباس السباحة
Dialogue: 0,0:12:49.47,0:12:52.25,Default,,0000,0000,0000,,!لا داعي لذكر ذلك
Dialogue: 0,0:12:52.25,0:12:55.43,Default,,0000,0000,0000,,هناك ما يحيّرني منذ مدّة
Dialogue: 0,0:12:55.43,0:12:56.83,Default,,0000,0000,0000,,ما هو تينغو الضباب؟
Dialogue: 0,0:12:57.76,0:12:59.58,Default,,0000,0000,0000,,!أ-أين سمعت الاسم يا فتى؟
Dialogue: 0,0:12:59.96,0:13:03.92,Default,,0000,0000,0000,,آسف، زلّ لساني
Dialogue: 0,0:13:04.17,0:13:05.30,Default,,0000,0000,0000,,!الراهب الأكبر
Dialogue: 0,0:13:05.30,0:13:09.12,Default,,0000,0000,0000,,إنّها مجرد حكاية قديمة سخيفة
Dialogue: 0,0:13:09.58,0:13:13.75,Default,,0000,0000,0000,,في الليالي الممطرة، يتسلّل تينغو كالسراب للقريّة
Dialogue: 0,0:13:13.75,0:13:17.24,Default,,0000,0000,0000,,ويستعمل قوّته الهائلة لتحطيم المنازل
Dialogue: 0,0:13:17.24,0:13:18.40,Default,,0000,0000,0000,,واختطاف سكّانهم
Dialogue: 0,0:13:18.40,0:13:21.94,Default,,0000,0000,0000,,ثم يحلّق لقمّة شجرة عالية
Dialogue: 0,0:13:21.94,0:13:27.69,Default,,0000,0000,0000,,!يعلّق الجثث ويأكل لحمها
Dialogue: 0,0:13:28.31,0:13:32.83,Default,,0000,0000,0000,,!يختطف الفتيات الشابات بلحم طريّ فحسب
Dialogue: 0,0:13:34.31,0:13:39.22,Default,,0000,0000,0000,,أجل، فتيات مثلك تماماً
Dialogue: 0,0:13:40.84,0:13:45.38,Default,,0000,0000,0000,,لكنّها مجرد أسطورة من الماضي، لا تأخذيها بجديّة
Dialogue: 0,0:13:45.38,0:13:46.66,Default,,0000,0000,0000,,كما سمعتِه
Dialogue: 0,0:13:46.66,0:13:47.75,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:13:48.50,0:13:51.42,Default,,0000,0000,0000,,...لكنّها ليست مجرد حكاية
Dialogue: 0,0:13:52.83,0:13:57.24,Default,,0000,0000,0000,,...وقعت حادثة مريبة شبيهة بها قبل عامين
Dialogue: 0,0:13:57.24,0:13:57.83,Default,,0000,0000,0000,,!موكونين
Dialogue: 0,0:13:58.24,0:14:03.61,Default,,0000,0000,0000,,لمَ لا تسألهم عن تفاصيل القضيّة يا عمّ؟
Dialogue: 0,0:14:03.81,0:14:07.39,Default,,0000,0000,0000,,!فأنت المتحرّي العظيم موري كوغورو
Dialogue: 0,0:14:07.39,0:14:09.74,Default,,0000,0000,0000,,قد تكتشف شيئاً
Dialogue: 0,0:14:09.97,0:14:11.07,Default,,0000,0000,0000,,!المتحرّي العظيم؟
Dialogue: 0,0:14:11.07,0:14:12.16,Default,,0000,0000,0000,,!موري؟
Dialogue: 0,0:14:11.07,0:14:12.16,Default,,0000,0000,0000,,!موري؟
Dialogue: 0,0:14:12.56,0:14:13.62,Default,,0000,0000,0000,,!كوغورو؟
Dialogue: 0,0:14:12.56,0:14:13.62,Default,,0000,0000,0000,,!كوغورو؟
Dialogue: 0,0:14:13.62,0:14:15.30,Default,,0000,0000,0000,,!أنت ذاك المتحرّي الشهير
Dialogue: 0,0:14:15.30,0:14:18.57,Default,,0000,0000,0000,,!أنت الوحيد القادر على حلّ تلك القضية الصعبة
Dialogue: 0,0:14:18.57,0:14:20.58,Default,,0000,0000,0000,,...اسمع سيّدي المتحرّي
Dialogue: 0,0:14:20.58,0:14:23.16,Default,,0000,0000,0000,,...قبل عامين، كان هناك راهب شاب
Dialogue: 0,0:14:23.16,0:14:24.83,Default,,0000,0000,0000,,!يكفي
Dialogue: 0,0:14:26.25,0:14:30.78,Default,,0000,0000,0000,,أنسيتم وعدنا بعدم الكلام\Nعن تلك الحادثة مُجدداً؟
Dialogue: 0,0:14:31.07,0:14:32.62,Default,,0000,0000,0000,,!لـ-لكن سيّدي الراهب الأكبر
Dialogue: 0,0:14:32.62,0:14:34.62,Default,,0000,0000,0000,,انتهى العشاء
Dialogue: 0,0:14:34.62,0:14:37.40,Default,,0000,0000,0000,,!ارجعوا لغرفكم وتجهّزوا للنوم
Dialogue: 0,0:14:43.19,0:14:46.31,Default,,0000,0000,0000,,،حضرة المتحرّي، سأسمح لكم بالمبيت
Dialogue: 0,0:14:46.31,0:14:49.05,Default,,0000,0000,0000,,لكن عليكم مغادرة المعبد في الصباح الباكر
Dialogue: 0,0:14:49.05,0:14:51.28,Default,,0000,0000,0000,,لا تعتبر الأمر شخصياً
Dialogue: 0,0:14:51.85,0:14:53.99,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,0:15:30.85,0:15:32.31,Default,,0000,0000,0000,,أبي
Dialogue: 0,0:15:32.31,0:15:34.10,Default,,0000,0000,0000,,تينغو ليس حقيقيّاً، صحيح؟
Dialogue: 0,0:15:34.47,0:15:36.63,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:15:36.63,0:15:39.71,Default,,0000,0000,0000,,أتظنّين الكابّا والأوني متواجدين حقّاً؟
Dialogue: 0,0:15:39.71,0:15:45.56,Default,,0000,0000,0000,,تينغو مثلهم، مخلوق من مخيلة البشر
Dialogue: 0,0:15:46.21,0:15:47.24,Default,,0000,0000,0000,,لعلّك مُحق
Dialogue: 0,0:15:47.24,0:15:49.04,Default,,0000,0000,0000,,في الصين القديمة، كانوا يشيرون للشُهب
Dialogue: 0,0:15:49.04,0:15:52.76,Default,,0000,0000,0000,,التي تصدر صوتاً عالياً شبيهاً بالرعد
Dialogue: 0,0:15:52.99,0:15:58.90,Default,,0000,0000,0000,,بالكلاب السماوية، أو "تينغو"، ومنه الاسم
Dialogue: 0,0:15:58.90,0:16:03.69,Default,,0000,0000,0000,,كانت تعتبر تلك الشهب نذير\Nحظّ سيّئ في الصين
Dialogue: 0,0:16:03.69,0:16:05.48,Default,,0000,0000,0000,,انتقلت تلك المعتقدات لليابان
Dialogue: 0,0:16:05.86,0:16:12.43,Default,,0000,0000,0000,,وتغيّر تينغو من ظاهرة غريبة لوحش غريب
Dialogue: 0,0:16:12.68,0:16:17.34,Default,,0000,0000,0000,,تعرف الكثير من الأشياء الغريبة بالنسبة لطفل
Dialogue: 0,0:16:17.71,0:16:22.13,Default,,0000,0000,0000,,...كـ-كان ذلك على التلفاز في ذاك اليوم
Dialogue: 0,0:16:22.13,0:16:27.12,Default,,0000,0000,0000,,لذا لا شيء لتخافيه يا ران-نيتشان
Dialogue: 0,0:16:28.12,0:16:32.54,Default,,0000,0000,0000,,!لا تكن سخيفاً، لم أخف شيئاً
Dialogue: 0,0:16:32.54,0:16:33.72,Default,,0000,0000,0000,,هيّا، لننم
Dialogue: 0,0:16:40.44,0:16:41.61,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:16:41.61,0:16:45.85,Default,,0000,0000,0000,,إذا شعرت بالخوف ليلاً، يمكنك القدوم للنوم معي
Dialogue: 0,0:16:46.52,0:16:48.05,Default,,0000,0000,0000,,!عُمتما مساءً
Dialogue: 0,0:16:48.85,0:16:49.97,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:16:50.93,0:16:52.31,Default,,0000,0000,0000,,اسمع يا كونان-كن
Dialogue: 0,0:16:52.31,0:16:56.18,Default,,0000,0000,0000,,إذا شعرت بالخوف ليلاً، يمكنك القدوم للنوم معي
Dialogue: 0,0:17:21.86,0:17:26.38,Default,,0000,0000,0000,,يختطف الفتيات الشابات بلحم طريّ فحسب
Dialogue: 0,0:17:26.38,0:17:30.72,Default,,0000,0000,0000,,أجل، فتيات مثلك تماماً
Dialogue: 0,0:17:39.97,0:17:43.76,Default,,0000,0000,0000,,ران تلك، أيقظتنا في منتصف الليل
Dialogue: 0,0:17:43.76,0:17:47.25,Default,,0000,0000,0000,,!ما بكما؟ لا يسعني فعل شيء إن كنت سريعة الخوف
Dialogue: 0,0:17:47.25,0:17:49.92,Default,,0000,0000,0000,,ما كانت تلك الحادثة برأيك؟
Dialogue: 0,0:17:49.92,0:17:51.21,Default,,0000,0000,0000,,كيف لي أن أعرف
Dialogue: 0,0:17:51.21,0:17:53.77,Default,,0000,0000,0000,,لا يريد الكلام عنها، فيجدر بنا ألّا نسأل
Dialogue: 0,0:17:55.00,0:17:58.31,Default,,0000,0000,0000,,...لا يمكن أنّ تينغو الضباب ظهر حقّاً
Dialogue: 0,0:17:58.31,0:17:59.01,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:59.78,0:18:02.01,Default,,0000,0000,0000,,ماذا قلت عني؟
Dialogue: 0,0:18:06.85,0:18:09.31,Default,,0000,0000,0000,,!رأيتما؟ أنتما جبانان أيضاً
Dialogue: 0,0:18:09.31,0:18:12.23,Default,,0000,0000,0000,,ر-ران! من أين حصلتِ على هذا القناع؟
Dialogue: 0,0:18:12.23,0:18:14.31,Default,,0000,0000,0000,,كان معلّقاً في دورة المياه
Dialogue: 0,0:18:14.90,0:18:16.89,Default,,0000,0000,0000,,...أ-أنت
Dialogue: 0,0:18:16.89,0:18:17.76,Default,,0000,0000,0000,,!ماذا حصل؟
Dialogue: 0,0:18:18.22,0:18:21.01,Default,,0000,0000,0000,,...لا-لا شيء
Dialogue: 0,0:18:21.01,0:18:22.76,Default,,0000,0000,0000,,!عُمت مساءً يا كانّين-سان
Dialogue: 0,0:18:23.30,0:18:24.85,Default,,0000,0000,0000,,!نَم جيّداً
Dialogue: 0,0:18:26.83,0:18:29.17,Default,,0000,0000,0000,,انتهى بي المطاف بأخذ هذا معي، ما العمل؟
Dialogue: 0,0:18:29.17,0:18:30.85,Default,,0000,0000,0000,,!يا إلهي، لم يكن عليك ارتداؤه بدايةً
Dialogue: 0,0:18:31.88,0:18:34.54,Default,,0000,0000,0000,,طار النوم من عينيّ الآن
Dialogue: 0,0:18:42.03,0:18:44.99,Default,,0000,0000,0000,,الإفطار جاهز يا سادة
Dialogue: 0,0:18:44.99,0:18:46.42,Default,,0000,0000,0000,,حسناً، سنأتي فوراً
Dialogue: 0,0:18:48.94,0:18:51.35,Default,,0000,0000,0000,,يبدو أنّك لم تنم جيّداً يا شونين-سان
Dialogue: 0,0:18:51.94,0:18:55.69,Default,,0000,0000,0000,,صحيح، سهرتُ البارحة بالقراءة
Dialogue: 0,0:18:55.69,0:18:57.97,Default,,0000,0000,0000,,اعذروني
Dialogue: 0,0:19:04.35,0:19:06.76,Default,,0000,0000,0000,,يبدو أنّك لم تنم كفايتك أيضاً يا موكونين-سان
Dialogue: 0,0:19:07.17,0:19:09.84,Default,,0000,0000,0000,,!بسبب صراخك
Dialogue: 0,0:19:09.84,0:19:12.50,Default,,0000,0000,0000,,!لم أستطع النوم قلقاً بعده
Dialogue: 0,0:19:12.50,0:19:13.60,Default,,0000,0000,0000,,...آسف
Dialogue: 0,0:19:14.50,0:19:19.20,Default,,0000,0000,0000,,لكنّ ذلك لا يُقارن بتونّين\Nالذي لم يغمض له جفن
Dialogue: 0,0:19:22.45,0:19:25.02,Default,,0000,0000,0000,,أين الراهب الأكبر وكانّين-سان؟
Dialogue: 0,0:19:25.33,0:19:30.07,Default,,0000,0000,0000,,لم نرَ الراهب الأكبر، لذا ذهب كانّين للبحث عنه
Dialogue: 0,0:19:30.07,0:19:32.65,Default,,0000,0000,0000,,...إنّه في إحدى الغرف على الأرجح غارق في الشراب
Dialogue: 0,0:19:36.47,0:19:39.14,Default,,0000,0000,0000,,!ذاك صوت كانّين
Dialogue: 0,0:19:39.14,0:19:41.85,Default,,0000,0000,0000,,!بدا أنّه من غرفة التأمّل
Dialogue: 0,0:19:46.88,0:19:47.92,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:19:47.92,0:19:49.14,Default,,0000,0000,0000,,!هـ-هناك
Dialogue: 0,0:19:53.56,0:19:55.27,Default,,0000,0000,0000,,!الراهب الأكبر تينّي
Dialogue: 0,0:20:02.08,0:20:06.82,Default,,0000,0000,0000,,كان الضحيّة المشنوق الراهب الأكبر\Nلهذا المعبد، تينّي
Dialogue: 0,0:20:06.82,0:20:11.11,Default,,0000,0000,0000,,وقت الموت المقدّر بين العاشرة\Nومنتصف الليل البارحة
Dialogue: 0,0:20:11.11,0:20:15.57,Default,,0000,0000,0000,,وكنتَ من وجد الجثّة أيّها الراهب المتدرّب
Dialogue: 0,0:20:15.57,0:20:16.93,Default,,0000,0000,0000,,صحيح يا كانّين-سان؟
Dialogue: 0,0:20:16.93,0:20:18.52,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:18.52,0:20:22.52,Default,,0000,0000,0000,,لم نره هذا الصباح، لذا ذهبتُ للبحث عنه
Dialogue: 0,0:20:22.52,0:20:26.05,Default,,0000,0000,0000,,...ثمّ وجدته في غرفة التأمّل هكذا
Dialogue: 0,0:20:26.05,0:20:28.30,Default,,0000,0000,0000,,،وبمصادفة غريبة أخرى
Dialogue: 0,0:20:28.30,0:20:32.10,Default,,0000,0000,0000,,...الشخص الذي هرع هنا بعد سماعه الصرخة كان
Dialogue: 0,0:20:32.10,0:20:36.16,Default,,0000,0000,0000,,!أنا، موري كوغورو، حضرة المفتّش ميغوري
Dialogue: 0,0:20:37.62,0:20:42.33,Default,,0000,0000,0000,,كانت تلك صرخةً مبهرة بحقّ يا كانّين-سان
Dialogue: 0,0:20:42.33,0:20:44.06,Default,,0000,0000,0000,,!ليس بقدر صرختك
Dialogue: 0,0:20:44.58,0:20:48.19,Default,,0000,0000,0000,,لديك حواس حادّة حقّاً يا كانّين-سان
Dialogue: 0,0:20:48.19,0:20:53.06,Default,,0000,0000,0000,,فالراهب الأكبر كان متدلياً من أعلى السقف هناك
Dialogue: 0,0:20:53.53,0:20:56.51,Default,,0000,0000,0000,,لو كنتُ أنا، لما وجدته فوراً على الأغلب
Dialogue: 0,0:20:58.93,0:21:01.85,Default,,0000,0000,0000,,هذا غريب بالفعل يا كانّين-سان
Dialogue: 0,0:21:01.85,0:21:04.35,Default,,0000,0000,0000,,لم تعلم أنّه متدلٍّ
Dialogue: 0,0:21:04.35,0:21:07.43,Default,,0000,0000,0000,,من السقف سلفاً، صحيح؟
Dialogue: 0,0:21:07.84,0:21:12.01,Default,,0000,0000,0000,,...بـ-بلا مزاح! كنتُ فقط
Dialogue: 0,0:21:12.01,0:21:14.38,Default,,0000,0000,0000,,من الطبيعيّ أن يجده
Dialogue: 0,0:21:14.38,0:21:15.52,Default,,0000,0000,0000,,...موكونين
Dialogue: 0,0:21:16.21,0:21:20.47,Default,,0000,0000,0000,,فالأمر نفسه وقع قبل عامين في هذه الغرفة
Dialogue: 0,0:21:20.75,0:21:22.54,Default,,0000,0000,0000,,قبل عامين؟
Dialogue: 0,0:21:22.54,0:21:25.43,Default,,0000,0000,0000,,أجل، كنتُ المسؤول عن تلك القضيّة أيضاً
Dialogue: 0,0:21:25.75,0:21:29.34,Default,,0000,0000,0000,,أظنّ الضحيّة كان راهباً\Nقيد التمرين يُدعى تشونين
Dialogue: 0,0:21:30.03,0:21:36.19,Default,,0000,0000,0000,,وكان كانّين-سان وموكونين-سان \Nمن وجدا الجثّة، صحيح؟
Dialogue: 0,0:21:36.19,0:21:36.80,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:21:37.35,0:21:41.77,Default,,0000,0000,0000,,وقع ذلك أثناء موسم المطر
Dialogue: 0,0:21:41.77,0:21:45.69,Default,,0000,0000,0000,,،بعد قدومه لهذه الغرفة للتأمّل
Dialogue: 0,0:21:45.69,0:21:48.43,Default,,0000,0000,0000,,أحدث تشونين-سان فجوةً كبيرة في الحائط واختفى
Dialogue: 0,0:21:49.47,0:21:51.26,Default,,0000,0000,0000,,،بحثنا عنه لثلاثة أيام بلياليها
Dialogue: 0,0:21:51.26,0:21:52.63,Default,,0000,0000,0000,,لكن لم نجده
Dialogue: 0,0:21:52.63,0:21:54.22,Default,,0000,0000,0000,,،افترضنا أنّه هرب من المعبد
Dialogue: 0,0:21:54.22,0:21:55.89,Default,,0000,0000,0000,,،ثمّ في صباح اليوم الرابع
Dialogue: 0,0:21:56.87,0:21:59.59,Default,,0000,0000,0000,,أتيتُ لهذه الغرفة مع كانّين لإصلاح الحائط
Dialogue: 0,0:22:00.42,0:22:03.77,Default,,0000,0000,0000,,...وعندما نظرنا للأعلى
Dialogue: 0,0:22:12.20,0:22:14.27,Default,,0000,0000,0000,,!وجدنا تشونين-سان مشنوقاً من السقف
Dialogue: 0,0:22:14.99,0:22:19.19,Default,,0000,0000,0000,,أهذه الفجوة بنفس مكان الحادثة السابقة؟
Dialogue: 0,0:22:19.19,0:22:20.27,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:22:20.27,0:22:24.47,Default,,0000,0000,0000,,اعتقدنا أنّ تشونين-سان أحدثها للهرب بدايةً
Dialogue: 0,0:22:24.98,0:22:27.80,Default,,0000,0000,0000,,لكنّ باب الغرفة لم يكن مقفلاً
Dialogue: 0,0:22:28.18,0:22:34.01,Default,,0000,0000,0000,,وقال نجّار محليّ أتى لإصلاح الحائط الخارجي
Dialogue: 0,0:22:34.01,0:22:39.01,Default,,0000,0000,0000,,أنّ فتح فجوة بهذا الحجم\Nسيستغرق يوماً كاملاً بالنسبة لفرد
Dialogue: 0,0:22:39.46,0:22:41.58,Default,,0000,0000,0000,,...قال أنّ الوحيد بإمكانه فعل ذلك
Dialogue: 0,0:22:41.58,0:22:44.22,Default,,0000,0000,0000,,...هو الوحش القديم والقويّ
Dialogue: 0,0:22:44.22,0:22:46.42,Default,,0000,0000,0000,,!تـ-تينغو الضباب
Dialogue: 0,0:22:46.42,0:22:48.26,Default,,0000,0000,0000,,!تـ-تينغو الضباب؟
Dialogue: 0,0:22:57.73,0:23:01.36,Default,,0000,0000,0000,,سخافة، لا وجود لشيء كذاك
Dialogue: 0,0:23:01.36,0:23:02.19,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:23:03.27,0:23:05.31,Default,,0000,0000,0000,,إنّها كالحادثة قبل عامين فعلاً
Dialogue: 0,0:23:05.77,0:23:08.39,Default,,0000,0000,0000,,الغبار يغطّي العارضتين الجانبيتين
Dialogue: 0,0:23:08.39,0:23:11.39,Default,,0000,0000,0000,,ولا آثار للمس شيء لهما
Dialogue: 0,0:23:11.39,0:23:14.27,Default,,0000,0000,0000,,أُزيح جزء من الغبار عن العارضة الوسطى
Dialogue: 0,0:23:14.27,0:23:16.13,Default,,0000,0000,0000,,لكنّ ذلك بسبب الحبل المربوط بها
Dialogue: 0,0:23:16.13,0:23:18.72,Default,,0000,0000,0000,,لا آثار احتكاك تشير إلى أنّه رُفع
Dialogue: 0,0:23:18.92,0:23:21.89,Default,,0000,0000,0000,,ربما كان انتحاراً أيضاً هذه المرّة
Dialogue: 0,0:23:21.89,0:23:23.46,Default,,0000,0000,0000,,انتحار؟
Dialogue: 0,0:23:23.46,0:23:25.42,Default,,0000,0000,0000,,أجل، يمكنك الصعود هناك
Dialogue: 0,0:23:25.42,0:23:29.74,Default,,0000,0000,0000,,إذا تسلّقت العارضتين واستعملت الحبل\Nكما فعل الشرطيّ
Dialogue: 0,0:23:29.74,0:23:33.10,Default,,0000,0000,0000,,لكنّ حمل شخص إلى هناك موضوع مختلف
Dialogue: 0,0:23:33.45,0:23:37.73,Default,,0000,0000,0000,,الراهب المُتوفى تشونين والراهب الأكبر\Nلم يكونا صغيري البنية
Dialogue: 0,0:23:37.73,0:23:42.23,Default,,0000,0000,0000,,تسلّق الحبل وهما على ظهرك أشبه بالمستحيل
Dialogue: 0,0:23:42.23,0:23:45.32,Default,,0000,0000,0000,,إذا ربطت العقدة بعنقهما ورفعتهما
Dialogue: 0,0:23:45.32,0:23:47.89,Default,,0000,0000,0000,,ستكون هناك آثار على العارضة
Dialogue: 0,0:23:47.89,0:23:52.14,Default,,0000,0000,0000,,يمكن أنّ شخصاً صعد بدايةً وسحب الضحيّة
Dialogue: 0,0:23:52.14,0:23:55.35,Default,,0000,0000,0000,,لكنّ الموطئ الوحيد هي تلك العارضة الضيّقة
Dialogue: 0,0:23:55.35,0:23:56.59,Default,,0000,0000,0000,,فالأمر غير مُحتمل
Dialogue: 0,0:23:57.84,0:24:01.05,Default,,0000,0000,0000,,ما يعني أنّهما صعدا الحبل بنفسيهما
Dialogue: 0,0:24:01.05,0:24:04.17,Default,,0000,0000,0000,,وشكّلا عقدة على العارضة
Dialogue: 0,0:24:04.17,0:24:08.20,Default,,0000,0000,0000,,ثمّ قفزا بالعقدة حول عنقيهما
Dialogue: 0,0:24:10.29,0:24:13.74,Default,,0000,0000,0000,,وجدنا على الأرض بقايا حبل
Dialogue: 0,0:24:13.74,0:24:15.54,Default,,0000,0000,0000,,كما فأس اُستعمل لقطعه غالباً
Dialogue: 0,0:24:15.54,0:24:17.63,Default,,0000,0000,0000,,فيبدو أنّ هذا ما حصل
Dialogue: 0,0:24:18.22,0:24:20.90,Default,,0000,0000,0000,,لكن ما يحيّرني هو الفجوة في الحائط
Dialogue: 0,0:24:20.90,0:24:22.97,Default,,0000,0000,0000,,المماثلة للسابقة
Dialogue: 0,0:24:23.53,0:24:25.73,Default,,0000,0000,0000,,لا أعرف كيف حطّما الحائط
Dialogue: 0,0:24:25.73,0:24:29.72,Default,,0000,0000,0000,,لكنّهما فعلا ذلك وشنقا نفسيهما من السقف المرتفع
Dialogue: 0,0:24:29.72,0:24:33.93,Default,,0000,0000,0000,,لتقليد تلك الأسطورة القديمة غالباً
Dialogue: 0,0:24:34.27,0:24:36.13,Default,,0000,0000,0000,,كأنّهما يريدان إخبارنا
Dialogue: 0,0:24:36.13,0:24:41.01,Default,,0000,0000,0000,,أنّ تينغو الضباب الطائر هاجمهما
Dialogue: 0,0:24:41.01,0:24:43.93,Default,,0000,0000,0000,,تلك الحكاية السخيفة تنشر الهلع في الناس
Dialogue: 0,0:24:45.34,0:24:49.95,Default,,0000,0000,0000,,لكن ألا يبدو هذا الحائط المُحطم غريباً؟
Dialogue: 0,0:24:50.95,0:24:53.45,Default,,0000,0000,0000,,كانت توجد نافذة صغيرة هنا، صحيح؟
Dialogue: 0,0:24:53.45,0:24:54.02,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:24:55.25,0:25:01.39,Default,,0000,0000,0000,,بالكاد توجد أيّ آثار حطام\Nبالنسبة لفجوة بهذا الحجم
Dialogue: 0,0:25:02.44,0:25:04.02,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:25:05.15,0:25:08.06,Default,,0000,0000,0000,,أسقطها غالباً
Dialogue: 0,0:25:08.06,0:25:10.39,Default,,0000,0000,0000,,فقد أقدم على الانتحار بأسلوب
Dialogue: 0,0:25:10.39,0:25:11.97,Default,,0000,0000,0000,,يجعلنا نعتقد أنّه كان تينغو الضباب
Dialogue: 0,0:25:12.31,0:25:15.43,Default,,0000,0000,0000,,لا تعرف ما الذي جال برأسه
Dialogue: 0,0:25:15.43,0:25:17.43,Default,,0000,0000,0000,,!جدّي
Dialogue: 0,0:25:17.43,0:25:19.64,Default,,0000,0000,0000,,!جدّي! جدّي
Dialogue: 0,0:25:21.13,0:25:23.22,Default,,0000,0000,0000,,...ماذا؟ أليست تلك
Dialogue: 0,0:25:23.22,0:25:26.05,Default,,0000,0000,0000,,حفيدة الراهب الأكبر، كيكونو-سان
Dialogue: 0,0:25:26.05,0:25:30.00,Default,,0000,0000,0000,,!جدّي! لمَ حصل هذا؟
Dialogue: 0,0:25:31.33,0:25:36.30,Default,,0000,0000,0000,,بكت قبل عامين عندما رأت\Nجثّة الراهب تشونين أيضاً
Dialogue: 0,0:25:36.65,0:25:41.86,Default,,0000,0000,0000,,أجل، كانت تزور المعبد على فترات في السابق
Dialogue: 0,0:25:41.86,0:25:45.14,Default,,0000,0000,0000,,لكنّها توقّفت عن القدوم\Nبعد تلك الحادثة
Dialogue: 0,0:25:45.14,0:25:47.34,Default,,0000,0000,0000,,!جدّي! جدّي
Dialogue: 0,0:25:48.06,0:25:49.09,Default,,0000,0000,0000,,من هو؟
Dialogue: 0,0:25:49.52,0:25:53.10,Default,,0000,0000,0000,,إنّه زوج كيكونو-سان
Dialogue: 0,0:25:53.10,0:25:56.26,Default,,0000,0000,0000,,تزوّجا قبل بضعة أيام
Dialogue: 0,0:25:56.26,0:25:59.09,Default,,0000,0000,0000,,سمعت أنّه خليفة معبد كبير
Dialogue: 0,0:25:59.09,0:26:02.06,Default,,0000,0000,0000,,وكان زواجهما منسّقاً منذ صغرهما
Dialogue: 0,0:26:02.63,0:26:07.75,Default,,0000,0000,0000,,صُدمت عندما سمعت بذلك\Nقبل عامين من الراهب الأكبر
Dialogue: 0,0:26:07.75,0:26:11.51,Default,,0000,0000,0000,,لطالما اعتقدت أنّ تشونين-سان\Nوكيكونو-سان سيكونان معاً
Dialogue: 0,0:26:12.29,0:26:14.02,Default,,0000,0000,0000,,تشونين-سان الراحل؟
Dialogue: 0,0:26:14.42,0:26:15.46,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:26:15.46,0:26:18.97,Default,,0000,0000,0000,,كانا مقرّبين بحيث بدوا كشقيقين
Dialogue: 0,0:26:19.36,0:26:22.07,Default,,0000,0000,0000,,لا بدّ أنّ الخبر نزل على تشونين-سان كالصاعقة
Dialogue: 0,0:26:22.07,0:26:25.07,Default,,0000,0000,0000,,عندما سمع بزواج كيكونو-سان
Dialogue: 0,0:26:25.07,0:26:26.93,Default,,0000,0000,0000,,لذا أقدم على تلك الحماقة
Dialogue: 0,0:26:27.48,0:26:31.56,Default,,0000,0000,0000,,...ربما كان الراهب الأكبر متضايقاً من ذاك الأمر
Dialogue: 0,0:26:31.56,0:26:33.35,Default,,0000,0000,0000,,وقتل نفسه مثل تشونين-سان
Dialogue: 0,0:26:33.35,0:26:35.45,Default,,0000,0000,0000,,!بعد بضعة أيام من زواج كيكونو-سان
Dialogue: 0,0:26:37.14,0:26:38.89,Default,,0000,0000,0000,,هذا مُحتمل فعلاً
Dialogue: 0,0:26:39.18,0:26:42.30,Default,,0000,0000,0000,,يُفترض أن تكون هناك وصيّة\Nفي مكانٍ ما إذاً
Dialogue: 0,0:26:42.30,0:26:45.55,Default,,0000,0000,0000,,لننفصل جميعاً ونبحث عنها
Dialogue: 0,0:26:48.71,0:26:50.33,Default,,0000,0000,0000,,انتحار؟
Dialogue: 0,0:26:50.33,0:26:52.33,Default,,0000,0000,0000,,أحقّاً ذلك؟
Dialogue: 0,0:26:52.33,0:26:55.21,Default,,0000,0000,0000,,مهما بدت كأسطورة قديمة
Dialogue: 0,0:26:55.21,0:26:57.93,Default,,0000,0000,0000,,هل يشنق أحد نفسه من مكان كذاك حقّاً؟
Dialogue: 0,0:26:58.32,0:27:01.55,Default,,0000,0000,0000,,كما هل يتكبّد فتح فجوة بذاك الحجم؟
Dialogue: 0,0:27:02.70,0:27:03.97,Default,,0000,0000,0000,,إذا لم يكن انتحاراً
Dialogue: 0,0:27:05.03,0:27:08.43,Default,,0000,0000,0000,,...واُستعملت هذه الفجوة الكبيرة لحيلة ما
Dialogue: 0,0:27:08.94,0:27:12.39,Default,,0000,0000,0000,,فنُفذت هذه الحادثة وسابقتها قبل عامين بنفس الطريقة
Dialogue: 0,0:27:12.39,0:27:18.47,Default,,0000,0000,0000,,أي أنّ تشونين والراهب الأكبر\Nقُتلا على يد نفس الشخص
Dialogue: 0,0:27:18.47,0:27:20.14,Default,,0000,0000,0000,,ما الذي تفعله يا فتى؟
Dialogue: 0,0:27:22.89,0:27:24.47,Default,,0000,0000,0000,,شونين-سان
Dialogue: 0,0:27:24.93,0:27:29.43,Default,,0000,0000,0000,,بالمناسبة، قال أنّه أتى لهذا المعبد قبل عام
Dialogue: 0,0:27:32.50,0:27:36.83,Default,,0000,0000,0000,,لا أظنّه سيفتح فجوةً بذاك الحجم\Nبهذه الذراع الهزيلة
Dialogue: 0,0:27:36.83,0:27:41.72,Default,,0000,0000,0000,,قلتَ أنّك كنت تسهر بالقراءة البارحة، صحيح؟
Dialogue: 0,0:27:41.72,0:27:44.83,Default,,0000,0000,0000,,أجل، كنتُ مستيقظاً حتّى بعد الثالثة بقليل
Dialogue: 0,0:27:44.83,0:27:47.43,Default,,0000,0000,0000,,هل لاحظت شيئاً غريباً ذاك الوقت؟
Dialogue: 0,0:27:48.61,0:27:52.32,Default,,0000,0000,0000,,مثل تسلّل أحد خارج غرفته
Dialogue: 0,0:27:52.32,0:27:54.77,Default,,0000,0000,0000,,أو صوت غريب لتحطّم شيء
Dialogue: 0,0:27:54.77,0:27:56.47,Default,,0000,0000,0000,,!أو صراخ أحد؟
Dialogue: 0,0:27:56.47,0:27:58.98,Default,,0000,0000,0000,,كلا، لم أسمع شيئاً
Dialogue: 0,0:27:58.98,0:28:01.05,Default,,0000,0000,0000,,كانت البارحة ليلة هادئة
Dialogue: 0,0:28:02.14,0:28:03.26,Default,,0000,0000,0000,,لم تسمع شيئاً حقّاً؟
Dialogue: 0,0:28:03.26,0:28:04.51,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:28:04.51,0:28:06.84,Default,,0000,0000,0000,,غرفة الراهب الأكبر بعيدة
Dialogue: 0,0:28:06.84,0:28:09.13,Default,,0000,0000,0000,,لكنّ غرف نوم الجميع بجوار بعضها
Dialogue: 0,0:28:09.13,0:28:11.47,Default,,0000,0000,0000,,لذا سنعرف فوراً إن حصل شيء
Dialogue: 0,0:28:12.05,0:28:15.42,Default,,0000,0000,0000,,أيمكن أنّك تشتبه بالجميع؟
Dialogue: 0,0:28:15.42,0:28:16.20,Default,,0000,0000,0000,,..ليس تماماً
Dialogue: 0,0:28:16.20,0:28:17.93,Default,,0000,0000,0000,,!شونين
Dialogue: 0,0:28:18.16,0:28:21.20,Default,,0000,0000,0000,,!كفّ عن التخاذل وساعدنا في البحث
Dialogue: 0,0:28:21.20,0:28:22.72,Default,,0000,0000,0000,,!حـ-حاضر
Dialogue: 0,0:28:35.07,0:28:36.97,Default,,0000,0000,0000,,!حسناً، القليل فقط
Dialogue: 0,0:28:38.43,0:28:41.27,Default,,0000,0000,0000,,!أخفتني عندما بدأت قبضتك تضعف
Dialogue: 0,0:28:41.27,0:28:42.39,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:28:42.39,0:28:44.18,Default,,0000,0000,0000,,!حضرات الضبّاط
Dialogue: 0,0:28:44.77,0:28:47.01,Default,,0000,0000,0000,,هذه النافذة فوق الغرفة
Dialogue: 0,0:28:47.01,0:28:48.34,Default,,0000,0000,0000,,التي مات فيها الراهب الأكبر، صحيح؟
Dialogue: 0,0:28:48.34,0:28:49.67,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:28:50.80,0:28:55.09,Default,,0000,0000,0000,,لا يمكنك نقل شخص هنا فوق العارضة الوسطى؟
Dialogue: 0,0:28:55.09,0:28:59.58,Default,,0000,0000,0000,,كلا، ذلك مستحيل دون ترك آثار على العارضة
Dialogue: 0,0:28:59.58,0:29:02.20,Default,,0000,0000,0000,,كما سيكون من الجنون أن تحمل شخصاً هنا
Dialogue: 0,0:29:02.20,0:29:04.81,Default,,0000,0000,0000,,وتحاول القيام بشيء فوق سطح بذاك الضيق
Dialogue: 0,0:29:11.19,0:29:13.01,Default,,0000,0000,0000,,ما خطب لوح التصريف هذا؟
Dialogue: 0,0:29:14.97,0:29:16.26,Default,,0000,0000,0000,,أثر القطع معوج
Dialogue: 0,0:29:17.02,0:29:18.41,Default,,0000,0000,0000,,مع أنّ البقية بخير
Dialogue: 0,0:29:22.52,0:29:23.68,Default,,0000,0000,0000,,!يا فتى
Dialogue: 0,0:29:24.10,0:29:25.92,Default,,0000,0000,0000,,لكنّ أثر القطع قديم
Dialogue: 0,0:29:25.92,0:29:27.67,Default,,0000,0000,0000,,وقع قبل وقت طويل
Dialogue: 0,0:29:29.47,0:29:32.22,Default,,0000,0000,0000,,توجد بتلات أزهار كرز ملتصقة بالخلف
Dialogue: 0,0:29:32.84,0:29:34.18,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:29:34.80,0:29:36.13,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:29:37.67,0:29:40.65,Default,,0000,0000,0000,,كونان-كن! أين أنت؟
Dialogue: 0,0:29:41.26,0:29:42.84,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:29:42.84,0:29:44.01,Default,,0000,0000,0000,,،إن كنتِ تبحثين عن ذاك الفتى
Dialogue: 0,0:29:44.01,0:29:45.87,Default,,0000,0000,0000,,فقد سأل عن كيفية الذهاب للغابة
Dialogue: 0,0:29:45.87,0:29:47.06,Default,,0000,0000,0000,,أسفل المعبد وغادر
Dialogue: 0,0:30:00.15,0:30:02.49,Default,,0000,0000,0000,,الشيء الوحيد المفقود
Dialogue: 0,0:30:02.49,0:30:05.15,Default,,0000,0000,0000,,!هو آثار ذاك الجزء المحطم من الحائط
Dialogue: 0,0:30:05.81,0:30:09.27,Default,,0000,0000,0000,,لو رماها القاتل من هناك حقّاً
Dialogue: 0,0:30:09.27,0:30:11.60,Default,,0000,0000,0000,,فيُفترض أنّها سقطت في الأرجاء
Dialogue: 0,0:30:11.98,0:30:14.68,Default,,0000,0000,0000,,إذا وجدتُها قد أعرف السبب
Dialogue: 0,0:30:14.68,0:30:17.56,Default,,0000,0000,0000,,!الذي دفع القاتل للتخلّص منها
Dialogue: 0,0:30:17.56,0:30:20.39,Default,,0000,0000,0000,,!كما اللغز وراء حيلته
Dialogue: 0,0:30:30.10,0:30:32.06,Default,,0000,0000,0000,,!ها هي! قطعة خشب
Dialogue: 0,0:30:33.04,0:30:36.14,Default,,0000,0000,0000,,...هذا جزء من النافذة الصغيرة
Dialogue: 0,0:30:36.61,0:30:38.31,Default,,0000,0000,0000,,...يوجد شريط لاصق
Dialogue: 0,0:30:39.00,0:30:40.31,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:30:41.24,0:30:44.03,Default,,0000,0000,0000,,!ولد! ما الذي تفعله هنا؟
Dialogue: 0,0:30:44.03,0:30:45.36,Default,,0000,0000,0000,,!ران-نيتشان
Dialogue: 0,0:30:45.87,0:30:47.60,Default,,0000,0000,0000,,ما قطعة الخشب القذرة هذه؟
Dialogue: 0,0:30:48.09,0:30:49.39,Default,,0000,0000,0000,,!ارمها
Dialogue: 0,0:30:49.39,0:30:50.31,Default,,0000,0000,0000,,!لا يمكنني
Dialogue: 0,0:30:55.10,0:30:59.09,Default,,0000,0000,0000,,حسناً، لننصرف الآن
Dialogue: 0,0:30:59.09,0:30:59.81,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:31:01.09,0:31:03.11,Default,,0000,0000,0000,,أين كيكونو-سان؟
Dialogue: 0,0:31:03.43,0:31:07.06,Default,,0000,0000,0000,,ذهبت مع الجثّة لمركز الشرطة
Dialogue: 0,0:31:07.42,0:31:10.69,Default,,0000,0000,0000,,لكننا لم نجد الوصيّة في النهاية
Dialogue: 0,0:31:10.69,0:31:14.52,Default,,0000,0000,0000,,لا بأس، عرفنا أنّه انتحار على الأقل
Dialogue: 0,0:31:14.92,0:31:18.07,Default,,0000,0000,0000,,!كلا، كانت جريمة قتل
Dialogue: 0,0:31:18.07,0:31:20.78,Default,,0000,0000,0000,,وقع شيءٌ ما في هذه الغرفة البارحة
Dialogue: 0,0:31:20.78,0:31:22.70,Default,,0000,0000,0000,,!شيء يفوق التصوّر
Dialogue: 0,0:31:24.07,0:31:27.44,Default,,0000,0000,0000,,...الحائط الذي حُطّم بقوّة هائلة
Dialogue: 0,0:31:27.44,0:31:29.52,Default,,0000,0000,0000,,...أثر القطع المعوج على لوح التصريف
Dialogue: 0,0:31:29.52,0:31:33.06,Default,,0000,0000,0000,,وقطعة الخشب من النافذة المرميّة من الحائط
Dialogue: 0,0:31:33.06,0:31:34.94,Default,,0000,0000,0000,,والشريط اللاصق عليها
Dialogue: 0,0:31:36.22,0:31:38.55,Default,,0000,0000,0000,,ما المفتاح الذي يربطها كلّها؟
Dialogue: 0,0:31:47.74,0:31:48.60,Default,,0000,0000,0000,,زهرة كرز؟
Dialogue: 0,0:31:51.38,0:31:55.24,Default,,0000,0000,0000,,!هكذا إذاً! اكتشفت الحيلة التي استعملها القاتل
Dialogue: 0,0:31:56.17,0:32:01.15,Default,,0000,0000,0000,,في تلك الحالة، لا بدّ أنّ القاتل\Nأمضى الليلة بأسرها في هذه الغرفة
Dialogue: 0,0:32:02.29,0:32:05.16,Default,,0000,0000,0000,,!فهمت، لذا قال ذلك
Dialogue: 0,0:32:06.53,0:32:10.15,Default,,0000,0000,0000,,يبدو أنّ المجرم هو ذاك الشخص بلا شكّ
Dialogue: 0,0:32:30.67,0:32:32.34,Default,,0000,0000,0000,,...الجريمة المستحيلة
Dialogue: 0,0:32:32.34,0:32:36.58,Default,,0000,0000,0000,,إنّه عمل فنّي شرير يرسمه القاتل\Nفي مسرح الجريمة
Dialogue: 0,0:32:37.20,0:32:39.58,Default,,0000,0000,0000,,القطعة الفنّية المعروضة هذه المرّة
Dialogue: 0,0:32:39.58,0:32:41.71,Default,,0000,0000,0000,,هي غرفة في معبد جبليّ تتساقط عليه أزهار الكرز
Dialogue: 0,0:32:42.20,0:32:44.13,Default,,0000,0000,0000,,قتل أحدهم الراهب الأكبر للمعبد
Dialogue: 0,0:32:44.13,0:32:47.04,Default,,0000,0000,0000,,بربطه على عارضة مرتفعة ثمّ شنقه
Dialogue: 0,0:32:47.77,0:32:50.13,Default,,0000,0000,0000,,لم تكن هناك آثار على سحبه بطبيعة الأمر
Dialogue: 0,0:32:50.98,0:32:53.55,Default,,0000,0000,0000,,فبدا أنّها جريمة مستحيلة على البشر
Dialogue: 0,0:32:54.15,0:32:58.46,Default,,0000,0000,0000,,!أجل، استعمل القاتل تقنيةً ما للتحليق في الهواء
Dialogue: 0,0:32:58.46,0:33:02.02,Default,,0000,0000,0000,,!كتينغو الضباب الطائر واسع المهارة
Dialogue: 0,0:33:03.39,0:33:05.59,Default,,0000,0000,0000,,وجدنا حبلاً غير مُستعمل وفأساً على أرض الغرفة
Dialogue: 0,0:33:05.59,0:33:07.59,Default,,0000,0000,0000,,التي قُتل فيها الراهب الأكبر
Dialogue: 0,0:33:08.21,0:33:09.59,Default,,0000,0000,0000,,لكنّ أكثر الأشياء غرابة
Dialogue: 0,0:33:09.59,0:33:12.42,Default,,0000,0000,0000,,هو عدم وجود آثار حطام للفجوة الكبيرة
Dialogue: 0,0:33:12.75,0:33:15.63,Default,,0000,0000,0000,,التي كانت في الحائط
Dialogue: 0,0:33:15.63,0:33:18.25,Default,,0000,0000,0000,,ثم هناك لوح التصريف بأثر القطع المعوّج
Dialogue: 0,0:33:18.58,0:33:21.49,Default,,0000,0000,0000,,وقطعة الخشب من النافذة الصغيرة في الغابة
Dialogue: 0,0:33:21.49,0:33:23.20,Default,,0000,0000,0000,,كما الشريط اللاصق عليها
Dialogue: 0,0:33:24.16,0:33:26.38,Default,,0000,0000,0000,,ما المفتاح الذي يربطها كلّها؟
Dialogue: 0,0:33:31.90,0:33:32.55,Default,,0000,0000,0000,,زهرة كرز؟
Dialogue: 0,0:33:33.03,0:33:36.58,Default,,0000,0000,0000,,!هكذا إذاً! اكتشفت الحيلة التي استعملها القاتل
Dialogue: 0,0:33:36.93,0:33:38.60,Default,,0000,0000,0000,,في تلك الحالة، لا بدّ أنّ القاتل
Dialogue: 0,0:33:38.60,0:33:41.59,Default,,0000,0000,0000,,أمضى الليلة بأسرها في هذه الغرفة
Dialogue: 0,0:33:41.59,0:33:44.80,Default,,0000,0000,0000,,!فهمت، لذا قال ذلك
Dialogue: 0,0:33:45.67,0:33:50.17,Default,,0000,0000,0000,,!إنّه القاتل بلا شك
Dialogue: 0,0:33:50.17,0:33:53.21,Default,,0000,0000,0000,,!أرجوك سيّدي المفتش
Dialogue: 0,0:33:53.21,0:33:55.13,Default,,0000,0000,0000,,حسناً، حسناً
Dialogue: 0,0:33:55.13,0:33:57.38,Default,,0000,0000,0000,,سآخذك للمنزل بسيّارة الشرطة
Dialogue: 0,0:33:57.91,0:34:01.21,Default,,0000,0000,0000,,حسناً، عليّ إعلامهم قبل مغادرة الشرطة
Dialogue: 0,0:34:01.54,0:34:04.25,Default,,0000,0000,0000,,أعطني مفتاح سيّارتك المستأجرة
Dialogue: 0,0:34:04.25,0:34:06.99,Default,,0000,0000,0000,,التي ثُقب إطارها في الغابة
Dialogue: 0,0:34:06.99,0:34:09.90,Default,,0000,0000,0000,,سأجعل أحد رجالي يرجعها لك
Dialogue: 0,0:34:09.90,0:34:13.36,Default,,0000,0000,0000,,فأنت تساعدنا باستنتاجاتك دوماً
Dialogue: 0,0:34:13.36,0:34:15.18,Default,,0000,0000,0000,,!شكراً جزيلاً
Dialogue: 0,0:34:16.79,0:34:18.73,Default,,0000,0000,0000,,!حصلتُ على المفتاح
Dialogue: 0,0:34:18.73,0:34:19.92,Default,,0000,0000,0000,,!ارجع يا ولد
Dialogue: 0,0:34:21.56,0:34:24.88,Default,,0000,0000,0000,,!تبّاً، أين ذهب ذاك الفتى؟
Dialogue: 0,0:34:26.01,0:34:27.54,Default,,0000,0000,0000,,!لا ألواح تصريف
Dialogue: 0,0:34:30.76,0:34:34.26,Default,,0000,0000,0000,,...انزلق وأفقد وعيه بنفسه
Dialogue: 0,0:34:34.67,0:34:35.50,Default,,0000,0000,0000,,حسناً، لا يهم
Dialogue: 0,0:34:35.50,0:34:38.21,Default,,0000,0000,0000,,ليس عليّ استعمال الساعة المخدّرة الآن
Dialogue: 0,0:34:40.37,0:34:43.33,Default,,0000,0000,0000,,بهذا الزرّ وظيفة مكبّر صوت لاسلكيّ صغير
Dialogue: 0,0:34:43.33,0:34:48.34,Default,,0000,0000,0000,,أيّ ما تقوله في سمّاعة ربطة عنق سيخرج منه
Dialogue: 0,0:34:48.86,0:34:50.53,Default,,0000,0000,0000,,...سألصقه هنا
Dialogue: 0,0:34:50.53,0:34:52.13,Default,,0000,0000,0000,,!يا فتى
Dialogue: 0,0:34:52.45,0:34:54.03,Default,,0000,0000,0000,,!حضرة الشرطيّ
Dialogue: 0,0:34:54.03,0:34:55.81,Default,,0000,0000,0000,,عليك ألّا تدخل هنا دون إذن
Dialogue: 0,0:34:55.81,0:34:57.02,Default,,0000,0000,0000,,!توقيت ممتاز
Dialogue: 0,0:34:57.02,0:34:59.27,Default,,0000,0000,0000,,قال العمّ موري أنّه يريدك أن تجمع الآخرين
Dialogue: 0,0:34:59.27,0:35:01.09,Default,,0000,0000,0000,,!في غرفة وقوع الحادثة
Dialogue: 0,0:35:01.48,0:35:03.80,Default,,0000,0000,0000,,كما ألديك شريط لاصق؟
Dialogue: 0,0:35:05.34,0:35:06.75,Default,,0000,0000,0000,,شريط لاصق؟
Dialogue: 0,0:35:07.38,0:35:10.05,Default,,0000,0000,0000,,!ماذا؟ عرفت هويّة المجرم؟
Dialogue: 0,0:35:10.47,0:35:11.26,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:35:11.26,0:35:14.47,Default,,0000,0000,0000,,أعرف من قتل الراهب الأكبر\Nوجعله يبدو انتحاراً
Dialogue: 0,0:35:14.76,0:35:15.87,Default,,0000,0000,0000,,مهلك
Dialogue: 0,0:35:15.87,0:35:19.79,Default,,0000,0000,0000,,مات الراهب الأكبر بعدما رُبط بعارضة مرتفعة
Dialogue: 0,0:35:19.79,0:35:21.92,Default,,0000,0000,0000,,!وشُنِق
Dialogue: 0,0:35:21.92,0:35:24.47,Default,,0000,0000,0000,,إن كنت تقصد أنّ أحداً نصب ذلك
Dialogue: 0,0:35:24.47,0:35:26.75,Default,,0000,0000,0000,,!فكيف له أن يفعلها؟
Dialogue: 0,0:35:27.16,0:35:30.51,Default,,0000,0000,0000,,!لم تكن هناك آثار سحب على العارضة
Dialogue: 0,0:35:32.16,0:35:34.47,Default,,0000,0000,0000,,بالطبع لم تكن هناك آثار
Dialogue: 0,0:35:34.70,0:35:39.73,Default,,0000,0000,0000,,فالمجرم ارتفع للعارضة مع الراهب الأكبر مباشرةً
Dialogue: 0,0:35:39.73,0:35:42.92,Default,,0000,0000,0000,,!ثمّ ربطه بها
Dialogue: 0,0:35:43.27,0:35:45.06,Default,,0000,0000,0000,,!ارتفع؟
Dialogue: 0,0:35:45.06,0:35:47.64,Default,,0000,0000,0000,,لا يُعقل أنّه كان تينغو الضباب
Dialogue: 0,0:35:47.64,0:35:49.88,Default,,0000,0000,0000,,ولا يمكن لبشريّ فعل ذلك
Dialogue: 0,0:35:50.22,0:35:52.30,Default,,0000,0000,0000,,أتسمع هذا الصوت؟
Dialogue: 0,0:35:52.30,0:35:54.34,Default,,0000,0000,0000,,أجل، صوت الشلّال
Dialogue: 0,0:35:54.55,0:35:59.25,Default,,0000,0000,0000,,صحيح، الشلّال الذي ينهمر\Nبجوار النافذة العلوية مباشرةً
Dialogue: 0,0:35:59.88,0:36:02.96,Default,,0000,0000,0000,,ألن يكون ممكناً الارتفاع للسقف
Dialogue: 0,0:36:02.96,0:36:06.28,Default,,0000,0000,0000,,إذا أعدت توجيه الشلّال عبر النافذة
Dialogue: 0,0:36:06.28,0:36:09.71,Default,,0000,0000,0000,,وملأت الغرفة بأسرها بالماء؟
Dialogue: 0,0:36:10.16,0:36:12.42,Default,,0000,0000,0000,,ملأ هذه الغرفة بالماء؟
Dialogue: 0,0:36:14.07,0:36:16.27,Default,,0000,0000,0000,,لا بدّ أنّك تمازحني
Dialogue: 0,0:36:16.27,0:36:19.40,Default,,0000,0000,0000,,سيكون القاتل والضحيّة مبللين بالكامل عندها
Dialogue: 0,0:36:19.40,0:36:22.26,Default,,0000,0000,0000,,ولم تكن هناك أيّ آثار بلل على الجثّة
Dialogue: 0,0:36:22.53,0:36:24.47,Default,,0000,0000,0000,,طوف قابل للنفخ حضرة المفتّش
Dialogue: 0,0:36:24.47,0:36:26.54,Default,,0000,0000,0000,,طـ-طوف قابل للنفخ؟
Dialogue: 0,0:36:26.54,0:36:27.68,Default,,0000,0000,0000,,كانّين-سان
Dialogue: 0,0:36:27.68,0:36:31.76,Default,,0000,0000,0000,,قلتَ أنّه يوجد طوف قابل للنفخ\Nفي هذا المعبد، صحيح؟
Dialogue: 0,0:36:31.76,0:36:33.05,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:36:33.30,0:36:38.38,Default,,0000,0000,0000,,إن كانت الجثّة على الطوف ويغطيها\Nغطاء بلاستيكيّ أو ما شابه
Dialogue: 0,0:36:38.38,0:36:41.51,Default,,0000,0000,0000,,فيمكنها أن تصل السقف دون أن تتبلل
Dialogue: 0,0:36:41.51,0:36:45.49,Default,,0000,0000,0000,,!لكنّ الشلال والنافذة متباعدان
Dialogue: 0,0:36:45.49,0:36:47.12,Default,,0000,0000,0000,,مهما تلاءمت لك الأمور
Dialogue: 0,0:36:47.12,0:36:49.96,Default,,0000,0000,0000,,لا يمكن أن تعيد توجيه الماء للغرفة
Dialogue: 0,0:36:53.03,0:36:54.43,Default,,0000,0000,0000,,لوح تصريف
Dialogue: 0,0:36:55.15,0:36:58.52,Default,,0000,0000,0000,,غطّى القاتل الفجوات في لوح التصريف\Nبشريط لاصق وقلبه
Dialogue: 0,0:36:58.52,0:37:00.88,Default,,0000,0000,0000,,ثمّ أعاد توجيه الشلال عبر النافذة
Dialogue: 0,0:37:00.88,0:37:05.22,Default,,0000,0000,0000,,ودليلاً على ذلك، كان أثر القطع\Nعلى لوح التصريف معوجاً
Dialogue: 0,0:37:05.22,0:37:08.93,Default,,0000,0000,0000,,...قُطع ليكون قصيراً ما يكفي ليتّسع
Dialogue: 0,0:37:08.93,0:37:12.68,Default,,0000,0000,0000,,كما هناك بتلات أزهار كرز ملتصقة باللوح
Dialogue: 0,0:37:12.68,0:37:15.33,Default,,0000,0000,0000,,في المواضع التي كان سيكون مكانها الشريط اللاصق
Dialogue: 0,0:37:16.05,0:37:18.84,Default,,0000,0000,0000,,نفس البتلات التي يأخذها الشلّال
Dialogue: 0,0:37:18.84,0:37:20.87,Default,,0000,0000,0000,,من الأشجار أعلى الجبل
Dialogue: 0,0:37:27.41,0:37:31.01,Default,,0000,0000,0000,,ولم يكن لوح التصريف وحده\Nما كانت عالقةً به البتلات
Dialogue: 0,0:37:31.83,0:37:35.96,Default,,0000,0000,0000,,يُفترض أن تسقط عند قدميك قريباً حضرة المفتّش
Dialogue: 0,0:37:37.90,0:37:39.90,Default,,0000,0000,0000,,البتلة التي التصقت بجانب الحائط
Dialogue: 0,0:37:39.90,0:37:43.28,Default,,0000,0000,0000,,!بعدما أخرج القاتل الماء
Dialogue: 0,0:37:44.78,0:37:47.72,Default,,0000,0000,0000,,أي أنّه بعد قتله للكاهن الأكبر
Dialogue: 0,0:37:47.72,0:37:49.18,Default,,0000,0000,0000,,نقل الجثّة لهذه الغرفة
Dialogue: 0,0:37:49.18,0:37:50.27,Default,,0000,0000,0000,,وضعها على طوف قابل للنفخ
Dialogue: 0,0:37:50.27,0:37:54.18,Default,,0000,0000,0000,,وغطّى إطار الباب الداخليّ بشريط لاصق
Dialogue: 0,0:37:54.18,0:37:58.09,Default,,0000,0000,0000,,ثمّ غادر الغرفة مؤقتاً\Nعبر النافذة الصغيرة
Dialogue: 0,0:37:58.80,0:38:00.80,Default,,0000,0000,0000,,ثمّ بدأ بملء الغرفة بالماء من نافذة
Dialogue: 0,0:38:00.80,0:38:03.05,Default,,0000,0000,0000,,الطابق الثاني باستعمال الطريقة التي وضّحتها
Dialogue: 0,0:38:03.05,0:38:04.59,Default,,0000,0000,0000,,وعاد للطابق الأوّل سريعاً
Dialogue: 0,0:38:04.59,0:38:06.29,Default,,0000,0000,0000,,ثمّ دخل من النافذة الصغيرة
Dialogue: 0,0:38:06.29,0:38:08.09,Default,,0000,0000,0000,,وغطّاها بشريط لاصق أيضاً
Dialogue: 0,0:38:08.09,0:38:12.55,Default,,0000,0000,0000,,وإلّا كان الماء ليتسرّب من الحواف
Dialogue: 0,0:38:13.08,0:38:16.94,Default,,0000,0000,0000,,،بعدها، مع حرصه على ألّا تتبلل الجثة
Dialogue: 0,0:38:16.94,0:38:20.00,Default,,0000,0000,0000,,كلّ ما كان عليه هو انتظار\Nامتلاء الغرفة بالماء
Dialogue: 0,0:38:20.00,0:38:24.11,Default,,0000,0000,0000,,وبعد امتلائها، وصل القاتل للعارضة
Dialogue: 0,0:38:24.11,0:38:26.10,Default,,0000,0000,0000,,ربط الجثّة بها
Dialogue: 0,0:38:26.10,0:38:29.96,Default,,0000,0000,0000,,ثمّ هرب من النافذة العلوية
Dialogue: 0,0:38:30.52,0:38:33.18,Default,,0000,0000,0000,,لكن كيف أخرج القاتل الماء؟
Dialogue: 0,0:38:33.18,0:38:35.17,Default,,0000,0000,0000,,بتحطّيم النافذة الصغيرة بالفأس
Dialogue: 0,0:38:35.17,0:38:37.42,Default,,0000,0000,0000,,الذي كان في مسرح الجريمة
Dialogue: 0,0:38:37.84,0:38:41.80,Default,,0000,0000,0000,,أجل، مساحة هذه الغرفة تُعادل 4.5 تاتامي تقريباً
Dialogue: 0,0:38:41.80,0:38:43.97,Default,,0000,0000,0000,,والحائط بارتفاع 10 أمتار
Dialogue: 0,0:38:43.97,0:38:48.21,Default,,0000,0000,0000,,لذا يكون الحجم 2.7 م ضرب 2.7 م ضرب 10 م
Dialogue: 0,0:38:48.21,0:38:51.33,Default,,0000,0000,0000,,أي 72.9 متر مكعّب
Dialogue: 0,0:38:51.33,0:38:53.79,Default,,0000,0000,0000,,الكثافة النسبية للماء هي 1
Dialogue: 0,0:38:53.79,0:38:58.29,Default,,0000,0000,0000,,لذا وزن كلّ الماء في الغرفة الممتلئة سيكون 72.9 طنّاً
Dialogue: 0,0:38:58.78,0:39:01.99,Default,,0000,0000,0000,,إذا استعملت فأساً لتحطيم\Nنافذة في أسفل غرفة تحوي
Dialogue: 0,0:39:01.99,0:39:03.03,Default,,0000,0000,0000,,ذاك القدر من الماء
Dialogue: 0,0:39:03.03,0:39:05.08,Default,,0000,0000,0000,,تعرفون ما سيحصل
Dialogue: 0,0:39:06.27,0:39:14.06,Default,,0000,0000,0000,,ستُقذف النافذة المتصدّعة تحت ضغط\Nيُعادل 9.8 ضرب 10 مرفوعة لـ 4 باسكال
Dialogue: 0,0:39:14.06,0:39:15.79,Default,,0000,0000,0000,,،وبقوّة تيّار الماء الهائل
Dialogue: 0,0:39:15.79,0:39:19.67,Default,,0000,0000,0000,,!سيتحطم المزيد من الحائط فتُفتح فجوة كبيرة
Dialogue: 0,0:39:20.05,0:39:23.51,Default,,0000,0000,0000,,تسعة فاصلة ثمانية ضرب 10 مرفوعة لـ 4 باسكال؟
Dialogue: 0,0:39:23.93,0:39:28.42,Default,,0000,0000,0000,,إنّه قدر هائل من القوّة، كدهس شاحنة لك
Dialogue: 0,0:39:28.75,0:39:29.96,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:39:30.24,0:39:35.25,Default,,0000,0000,0000,,لذا لم تكن هناك بقايا حطام\Nرغم تشكّل فجوة بهذا الحجم
Dialogue: 0,0:39:35.73,0:39:40.86,Default,,0000,0000,0000,,وجد كونان جزءاً من البقايا\Nفي الغابة تحت المعبد
Dialogue: 0,0:39:40.86,0:39:41.66,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:39:42.73,0:39:44.63,Default,,0000,0000,0000,,هاك سيّدي المفتش
Dialogue: 0,0:39:47.60,0:39:48.60,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:39:48.60,0:39:50.96,Default,,0000,0000,0000,,قطعة من النافذة الصغيرة بشريط لاصق
Dialogue: 0,0:39:51.85,0:39:53.92,Default,,0000,0000,0000,,لكن من قد يُقدم على شيء كهذا؟
Dialogue: 0,0:39:54.88,0:39:58.25,Default,,0000,0000,0000,,سيحتاج خروج الماء من الغرفة أقل من 10 ثوان
Dialogue: 0,0:39:58.25,0:40:01.04,Default,,0000,0000,0000,,لكن ملء الغرفة موضوع مختلف
Dialogue: 0,0:40:01.04,0:40:03.04,Default,,0000,0000,0000,,مقدار الماء الذي دخل عبر لوح التصريف
Dialogue: 0,0:40:03.04,0:40:05.33,Default,,0000,0000,0000,,يُعادل 5 إلى 6 أضعاف ماء الصنبور
Dialogue: 0,0:40:05.33,0:40:09.58,Default,,0000,0000,0000,,إذا افترضنا أنّه ملأ 10 أمتار مكعّبة في الساعة
Dialogue: 0,0:40:09.58,0:40:15.78,Default,,0000,0000,0000,,ستحتاج 7 ساعات لملء الغرفة التي\Nحجمها 72.9 طنّاً بأسرها
Dialogue: 0,0:40:15.78,0:40:18.57,Default,,0000,0000,0000,,وقت موت الراهب الأكبر المقدّر
Dialogue: 0,0:40:18.57,0:40:21.44,Default,,0000,0000,0000,,هو بين العاشرة ليلاً لمنتصف ليل البارحة
Dialogue: 0,0:40:21.44,0:40:25.78,Default,,0000,0000,0000,,وعُثر على جثّته في الثامنة صباحاً
Dialogue: 0,0:40:25.78,0:40:29.22,Default,,0000,0000,0000,,حتى إذا اقتطعت زمن إعداد الحيلة
Dialogue: 0,0:40:29.22,0:40:33.51,Default,,0000,0000,0000,,والوقت المطلوب لإخراج الماء وجفاف الغرفة
Dialogue: 0,0:40:33.51,0:40:39.75,Default,,0000,0000,0000,,كان القاتل في هذه الغرفة بالتأكيد\N!بين منتصف الليل حتّى السادسة صباحاً
Dialogue: 0,0:40:39.75,0:40:43.33,Default,,0000,0000,0000,,ما علاقة ذاك بالقاتل؟
Dialogue: 0,0:40:43.59,0:40:44.50,Default,,0000,0000,0000,,شونين-سان
Dialogue: 0,0:40:45.70,0:40:48.99,Default,,0000,0000,0000,,قلتَ أنّك كنت تقرأ في غرفتك
Dialogue: 0,0:40:48.99,0:40:51.83,Default,,0000,0000,0000,,حتّى الثالثة من صباح البارحة، صحيح؟
Dialogue: 0,0:40:52.24,0:40:58.69,Default,,0000,0000,0000,,كان يُفترض أنّك سمعت إذاً صرخة أحدهم \N...عند دورة المياه
Dialogue: 0,0:40:58.69,0:41:01.23,Default,,0000,0000,0000,,عندما أفزعه قناع تينغو الضباب
Dialogue: 0,0:41:01.83,0:41:04.48,Default,,0000,0000,0000,,من كان؟
Dialogue: 0,0:41:04.48,0:41:06.28,Default,,0000,0000,0000,,!أجبني
Dialogue: 0,0:41:06.56,0:41:08.22,Default,,0000,0000,0000,,...شـ-شونين
Dialogue: 0,0:41:08.22,0:41:09.74,Default,,0000,0000,0000,,!سـ-سمعته بالطبع
Dialogue: 0,0:41:10.51,0:41:12.92,Default,,0000,0000,0000,,!كانت صرخة ران-سان العالية
Dialogue: 0,0:41:14.52,0:41:15.88,Default,,0000,0000,0000,,أفزعتني
Dialogue: 0,0:41:15.88,0:41:18.76,Default,,0000,0000,0000,,...لا يمكنني لومها لأنّها سريعة الخوف، لكن
Dialogue: 0,0:41:18.76,0:41:20.29,Default,,0000,0000,0000,,...شونين! أنت
Dialogue: 0,0:41:21.63,0:41:23.17,Default,,0000,0000,0000,,شونين-سان
Dialogue: 0,0:41:23.17,0:41:26.03,Default,,0000,0000,0000,,لم تكن ران من صرخ وقتها
Dialogue: 0,0:41:26.95,0:41:28.74,Default,,0000,0000,0000,,كان أنا
Dialogue: 0,0:41:30.71,0:41:34.50,Default,,0000,0000,0000,,لكن لا عجب لعدم سماعك لي
Dialogue: 0,0:41:34.50,0:41:36.82,Default,,0000,0000,0000,,فقد كنت هنا طوال الليل
Dialogue: 0,0:41:36.82,0:41:39.12,Default,,0000,0000,0000,,وهدير الماء يتردد في أذنيك
Dialogue: 0,0:41:39.49,0:41:42.83,Default,,0000,0000,0000,,!لكن لن تثبت هذه الشهادة كدليل يا موري-كن
Dialogue: 0,0:41:43.28,0:41:44.93,Default,,0000,0000,0000,,إذا كنت تريد دليلاً دامغاً
Dialogue: 0,0:41:44.93,0:41:47.64,Default,,0000,0000,0000,,فهو بيدك الآن حضرة المفتّش
Dialogue: 0,0:41:47.64,0:41:48.79,Default,,0000,0000,0000,,قطعة الخشب هذه؟
Dialogue: 0,0:41:48.79,0:41:53.81,Default,,0000,0000,0000,,تمكّن القاتل من إزالة الدليل\Nعبر مسح الماء في الغرفة لاحقاً
Dialogue: 0,0:41:53.81,0:41:55.80,Default,,0000,0000,0000,,لكنه لم يستطع مسح قطعة الخشب هذه
Dialogue: 0,0:41:55.80,0:41:57.74,Default,,0000,0000,0000,,بما أنّ التيّار قذفها
Dialogue: 0,0:41:57.74,0:41:58.84,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:41:58.84,0:42:02.83,Default,,0000,0000,0000,,إنّها الشيء الوحيد الذي فشل\Nالقاتل في استعادته
Dialogue: 0,0:42:04.55,0:42:07.91,Default,,0000,0000,0000,,أراهن بحياتي كمتحرٍّ
Dialogue: 0,0:42:07.91,0:42:12.91,Default,,0000,0000,0000,,...أنّها لا تزال على الشريط اللاصق على القطعة
Dialogue: 0,0:42:12.91,0:42:15.99,Default,,0000,0000,0000,,شونين-سان، أقصد بصماتك
Dialogue: 0,0:42:18.28,0:42:21.74,Default,,0000,0000,0000,,!لكن شونين أتى لهذا المعبد قبل عام
Dialogue: 0,0:42:21.74,0:42:24.15,Default,,0000,0000,0000,,إن كانت نفس حيلة الحادثة قبل عامين
Dialogue: 0,0:42:24.15,0:42:25.14,Default,,0000,0000,0000,,فيُفترض أنّ الشخص نفسه
Dialogue: 0,0:42:25.14,0:42:26.70,Default,,0000,0000,0000,,!يستحيل أنّه كان شونين
Dialogue: 0,0:42:27.14,0:42:31.39,Default,,0000,0000,0000,,الحادثة قبل عامين كانت\Nمن تدبير الراهب الأكبر غالباً
Dialogue: 0,0:42:31.39,0:42:33.83,Default,,0000,0000,0000,,باستعمال هذه الحيلة تماماً
Dialogue: 0,0:42:34.27,0:42:36.72,Default,,0000,0000,0000,,كان أثر القطع على لوح التصريف قديماً
Dialogue: 0,0:42:36.72,0:42:41.46,Default,,0000,0000,0000,,وكان أكثر من يخشى الكلام عن الحادثة
Dialogue: 0,0:42:42.34,0:42:45.46,Default,,0000,0000,0000,,وإذا أصاب حدسي
Dialogue: 0,0:42:45.46,0:42:50.66,Default,,0000,0000,0000,,فتشونين-سان المقتول قبل عامين\Nوشونين-سان شقيقان على الأغلب
Dialogue: 0,0:42:52.21,0:42:53.75,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:42:53.75,0:42:58.29,Default,,0000,0000,0000,,كان تشونين شقيقي بالدم
Dialogue: 0,0:42:58.99,0:43:01.66,Default,,0000,0000,0000,,من الطبيعيّ أن أحداً لم يدرك
Dialogue: 0,0:43:01.66,0:43:04.73,Default,,0000,0000,0000,,أتيت كراهب قيد التمرين لإخفاء خلفيتي التاريخية
Dialogue: 0,0:43:04.73,0:43:08.24,Default,,0000,0000,0000,,بعد دراستي في معبد بعيد الصلة أوّلاً
Dialogue: 0,0:43:08.24,0:43:10.40,Default,,0000,0000,0000,,كان هدفي من القدوم لهذا المعبد
Dialogue: 0,0:43:10.40,0:43:13.77,Default,,0000,0000,0000,,هو معرفة حقيقة موت أخي بالطبع
Dialogue: 0,0:43:13.77,0:43:15.62,Default,,0000,0000,0000,,وإيجاد الفاعل الحقيقيّ
Dialogue: 0,0:43:16.55,0:43:19.97,Default,,0000,0000,0000,,فتّشتُ المعبد لنصف عام
Dialogue: 0,0:43:19.97,0:43:23.92,Default,,0000,0000,0000,,اكتشفتُ الحيلة، لكني لم أعرف الفاعل
Dialogue: 0,0:43:24.34,0:43:27.62,Default,,0000,0000,0000,,فلم يرد أحد الكلام عن الحادثة
Dialogue: 0,0:43:28.21,0:43:32.12,Default,,0000,0000,0000,,لكنّي أدركت عندما أتيتَ بالأمس حضرة المتحرّي
Dialogue: 0,0:43:32.12,0:43:35.53,Default,,0000,0000,0000,,عرفتُ من التغيّر الغريب في سلوك الراهب الأكبر
Dialogue: 0,0:43:36.16,0:43:41.45,Default,,0000,0000,0000,,ذهبتُ بعدها لغرفته، ووجدته منكبّاً على شرابه الليلي
Dialogue: 0,0:43:41.45,0:43:44.07,Default,,0000,0000,0000,,فضغطتُ عليه وأخبرني بكلّ شيء
Dialogue: 0,0:43:44.07,0:43:46.58,Default,,0000,0000,0000,,لم يعلم أنّي أخو تشونين الأصغر
Dialogue: 0,0:43:47.02,0:43:49.02,Default,,0000,0000,0000,,سبب قتله لأخي
Dialogue: 0,0:43:49.02,0:43:53.36,Default,,0000,0000,0000,,هو أنّه لم يرده أن يأخذ حفيدته كيكونو-سان
Dialogue: 0,0:43:53.36,0:43:56.28,Default,,0000,0000,0000,,التي كان يُفترض أن تتزوّج\Nخليفة معبد كبير
Dialogue: 0,0:43:56.80,0:44:02.05,Default,,0000,0000,0000,,...اتّفق أخي مع كيكونو-سان على الفرار معاً وفقما يبدو
Dialogue: 0,0:44:02.05,0:44:04.50,Default,,0000,0000,0000,,لكنّ ذلك لا يهم الآن
Dialogue: 0,0:44:04.79,0:44:08.20,Default,,0000,0000,0000,,بأيّ حال، عندما طلبتُ من الراهب الأكبر \N...تسليم نفسه، قال
Dialogue: 0,0:44:09.46,0:44:15.00,Default,,0000,0000,0000,,لم يبق دليل من الحادثة \Nقبل عامين بأيّ حال
Dialogue: 0,0:44:15.74,0:44:21.41,Default,,0000,0000,0000,,كما أنّ هذا المعبد اكتسب سمعةً بسببها
Dialogue: 0,0:44:21.70,0:44:25.67,Default,,0000,0000,0000,,!أصبح يُعرف بمعبد ظهور تينغو الضباب
Dialogue: 0,0:44:27.82,0:44:30.48,Default,,0000,0000,0000,,فقدتُ السيطرة على أعصابي عندما قال ذلك
Dialogue: 0,0:44:30.48,0:44:35.35,Default,,0000,0000,0000,,وخنقته للموت بحزام في الغرفة
Dialogue: 0,0:44:35.35,0:44:40.39,Default,,0000,0000,0000,,أجل، كما خنق أخي قبل عامين
Dialogue: 0,0:44:40.39,0:44:42.18,Default,,0000,0000,0000,,خنقته مسنداً ظهري
Dialogue: 0,0:44:42.18,0:44:44.29,Default,,0000,0000,0000,,لترك آثار تجعله يبدو انتحاراً بالشنق
Dialogue: 0,0:44:45.00,0:44:49.34,Default,,0000,0000,0000,,لم يكن لديّ خيار آخر بوجود الجثّة بين قدميّ
Dialogue: 0,0:44:49.34,0:44:52.17,Default,,0000,0000,0000,,كان عليّ استعمال\Nنفس حيلته قبل عامين
Dialogue: 0,0:44:52.17,0:44:54.25,Default,,0000,0000,0000,,لإخفاء الحقيقة
Dialogue: 0,0:44:56.76,0:45:03.15,Default,,0000,0000,0000,,من المؤسف أنّك لم تزر المعبد\Nقبل عامين حضرة المتحرّي
Dialogue: 0,0:45:04.90,0:45:08.01,Default,,0000,0000,0000,,...لو فعلت، غالباً لكنتُ
Dialogue: 0,0:46:40.96,0:46:44.53,Default,,0000,0000,0000,,!تفاجئني كلّ مرة يا موري-كن
Dialogue: 0,0:46:45.34,0:46:48.99,Default,,0000,0000,0000,,لم أكن أعلم أنّك مُلم\N!لذاك الحد بالفيزياء
Dialogue: 0,0:46:50.50,0:46:53.95,Default,,0000,0000,0000,,أجل، عندما تكلّمت يا أبي \N...عن باسكال وما شابه
Dialogue: 0,0:46:54.53,0:46:55.42,Default,,0000,0000,0000,,باسكال؟
Dialogue: 0,0:46:55.52,0:46:56.16,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:46:59.06,0:47:00.72,Default,,0000,0000,0000,,...بايكال هو شراب صينيّ كحولي
Dialogue: 0,0:47:00.72,0:47:02.16,Default,,0000,0000,0000,,...أوسكار من تاكارازوكا
Dialogue: 0,0:47:02.54,0:47:03.99,Default,,0000,0000,0000,,...راسكال هو أحد أنواع الراكون
Dialogue: 0,0:47:04.58,0:47:05.97,Default,,0000,0000,0000,,ما باسكال بالضبط؟
Dialogue: 0,0:47:08.82,0:47:10.91,Default,,0000,0000,0000,,!تقصدون تلك المجلّة التلفزية
Dialogue: 0,0:47:12.76,0:47:15.73,Default,,0000,0000,0000,,!أحمق، تلك تيليبال
Dialogue: 0,0:47:15.86,0:47:18.10,Default,,0000,0000,0000,,!كما أصبت في جزء "ال" فقط
Dialogue: 0,0:47:21.62,0:47:23.72,Default,,0000,0000,0000,,كان السلاح أصيص أزهار
Dialogue: 0,0:47:25.10,0:47:26.66,Default,,0000,0000,0000,,دائماً أنت
Dialogue: 0,0:47:26.66,0:47:28.88,Default,,0000,0000,0000,,!كفّ عن التدخل في التحقيق
Dialogue: 0,0:47:29.75,0:47:33.22,Default,,0000,0000,0000,,المشكلة الأولى هي أنت يا دوباشي-سان
Dialogue: 0,0:47:33.22,0:47:34.92,Default,,0000,0000,0000,,ثمّ زوجتك
Dialogue: 0,0:47:37.50,0:47:40.50,Default,,0000,0000,0000,,...يبدو أنّ شيئاً صلباً أصابه من الأسفل
Dialogue: 0,0:47:41.69,0:47:44.26,Default,,0000,0000,0000,,لا يمكن أن يكون المجرم\Nسوى ذاك الشخص
Dialogue: 0,0:47:44.67,0:47:46.25,Default,,0000,0000,0000,,الحلقة القادمة من كونان
Dialogue: 0,0:47:46.25,0:47:48.67,Default,,0000,0000,0000,,قضيّة سلاح جريمة القتل الغامض
Dialogue: 0,0:47:50.67,0:47:52.95,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:47:52.95,0:47:54.94,Default,,0000,0000,0000,,طير صغير
Dialogue: 0,0:47:55.56,0:47:57.36,Default,,0000,0000,0000,,!مع الحلقة القادمة يبدأ فصلٌ جديد
Dialogue: 0,0:47:57.36,0:47:58.98,Default,,0000,0000,0000,,!لا تتأخّروا

