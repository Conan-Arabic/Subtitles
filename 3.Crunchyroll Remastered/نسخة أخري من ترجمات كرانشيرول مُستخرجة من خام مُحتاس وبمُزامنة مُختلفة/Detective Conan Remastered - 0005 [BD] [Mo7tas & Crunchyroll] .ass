Dialogue: 0,0:00:00.79,0:00:02.62,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.62,0:00:05.95,Default,,0000,0000,0000,,أُجبر الطالب في الثانوية كودو شينتشي\Nعلى تجرّع عقار قلّص جسده
Dialogue: 0,0:00:05.95,0:00:07.86,Default,,0000,0000,0000,,قد أبدو بمظهر صغير في الابتدائية
Dialogue: 0,0:00:07.86,0:00:09.86,Default,,0000,0000,0000,,لكنّ تحليلي لا مثيل له
Dialogue: 0,0:00:09.86,0:00:11.85,Default,,0000,0000,0000,,!سأريكم كيف تُحلّ الألغاز
Dialogue: 0,0:00:11.85,0:00:15.31,Default,,0000,0000,0000,,حادثة اليوم هي انفجار مريع\N!على متن قطار طلقة
Dialogue: 0,0:01:46.95,0:01:53.02,Title,,0000,0000,0000,,{\fad(300,0)}انفجار قطار الطلقة الكبير
Dialogue: 0,0:01:48.10,0:01:50.74,Default,,0000,0000,0000,,انفجار قطار الطلقة الكبير
Dialogue: 0,0:01:58.83,0:02:01.16,Default,,0000,0000,0000,,...لا أحد يحلق على متن قطار الطلقة في طريقه
Dialogue: 0,0:02:01.16,0:02:04.45,Default,,0000,0000,0000,,لزفاف صديقه المقرب
Dialogue: 0,0:02:04.45,0:02:05.99,Default,,0000,0000,0000,,!لم يكن بيدي حيلة
Dialogue: 0,0:02:05.99,0:02:09.84,Default,,0000,0000,0000,,أطلت في النوم لأني سهرت\N!ليلاً أتناقش مع عميل
Dialogue: 0,0:02:10.23,0:02:13.29,Default,,0000,0000,0000,,تقول ذلك، لكنك ثملت ونمت في الممر
Dialogue: 0,0:02:14.90,0:02:17.76,Default,,0000,0000,0000,,...جلبتك معي لأنك أردتِ القدوم، لكن لا أدري لمَ
Dialogue: 0,0:02:18.15,0:02:21.22,Default,,0000,0000,0000,,!الزفاف في طوكيو
Dialogue: 0,0:02:21.22,0:02:23.97,Default,,0000,0000,0000,,أردتَ الذهاب هناك أيضاً، صحيح يا كونان-كن؟
Dialogue: 0,0:02:23.97,0:02:24.67,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:25.35,0:02:27.80,Default,,0000,0000,0000,,لمَ جلبناه بالأصل؟
Dialogue: 0,0:02:27.80,0:02:30.34,Default,,0000,0000,0000,,!لا يمكننا تركه بمفرده
Dialogue: 0,0:02:30.34,0:02:33.63,Default,,0000,0000,0000,,لحظة، أليس هذا حذاءً جديداً؟
Dialogue: 0,0:02:33.96,0:02:36.63,Default,,0000,0000,0000,,بلى، أعطاني إيّاه البروفسور آغاسا
Dialogue: 0,0:02:36.63,0:02:38.97,Default,,0000,0000,0000,,اخترعتُ شيئاً سيعجبك
Dialogue: 0,0:02:39.29,0:02:41.46,Default,,0000,0000,0000,,!حذاء مضاعفة قوّة الركل
Dialogue: 0,0:02:41.91,0:02:43.91,Default,,0000,0000,0000,,إن ركلت كرةً بهذا الحذاء
Dialogue: 0,0:02:43.91,0:02:45.42,Default,,0000,0000,0000,,!لن يعرف المجرمون ما أصابهم
Dialogue: 0,0:02:46.12,0:02:48.78,Default,,0000,0000,0000,,يستعمل الكهرباء والمجال المغناطيسي\Nلتحفيز عضلات قدمك
Dialogue: 0,0:02:48.78,0:02:50.87,Default,,0000,0000,0000,,!فيضاعف قوّة ركلك لحدٍّ كبير
Dialogue: 0,0:02:51.40,0:02:52.52,Default,,0000,0000,0000,,ماذا عن النظارات؟
Dialogue: 0,0:02:52.52,0:02:53.71,Default,,0000,0000,0000,,جاهزة أيضاً
Dialogue: 0,0:02:54.48,0:02:57.13,Default,,0000,0000,0000,,أضفتُ ميكروفوناً صغيراً مخفياً بها
Dialogue: 0,0:02:57.13,0:02:59.77,Default,,0000,0000,0000,,سيكون ذا فائدة حتماً
Dialogue: 0,0:02:59.77,0:03:02.93,Default,,0000,0000,0000,,آمل أن يعمل متى احتجت له
Dialogue: 0,0:03:06.85,0:03:09.96,Default,,0000,0000,0000,,!قطار طلقة
Dialogue: 0,0:03:09.96,0:03:12.33,Default,,0000,0000,0000,,!لكن لمَ أتوا هم أيضاً؟
Dialogue: 0,0:03:12.33,0:03:15.29,Default,,0000,0000,0000,,ما المشكلة؟ دُفعت تذاكرهم
Dialogue: 0,0:03:15.67,0:03:18.55,Default,,0000,0000,0000,,يا إلهي، ما خطب آباء هذه الأيام؟
Dialogue: 0,0:03:19.17,0:03:21.04,Default,,0000,0000,0000,,!لنذهب للاستكشاف يا كونان-كن
Dialogue: 0,0:03:21.04,0:03:22.66,Default,,0000,0000,0000,,!يبدو أنّه سيكون مسلياً كثيراً
Dialogue: 0,0:03:22.66,0:03:23.67,Default,,0000,0000,0000,,!هيّا بنا
Dialogue: 0,0:03:26.54,0:03:29.04,Default,,0000,0000,0000,,لدى آبائهم مشاكل حقاً
Dialogue: 0,0:03:29.04,0:03:31.08,Default,,0000,0000,0000,,لكن ماذا عن والديه؟
Dialogue: 0,0:03:31.61,0:03:33.48,Default,,0000,0000,0000,,لم يتّصلوا بنا ولو لمرّة حتى
Dialogue: 0,0:03:33.48,0:03:34.04,Default,,0000,0000,0000,,!تباً
Dialogue: 0,0:03:34.61,0:03:36.05,Default,,0000,0000,0000,,!سأذهب للحمام قليلاً
Dialogue: 0,0:03:36.57,0:03:39.69,Default,,0000,0000,0000,,!لا أسكن معكم لأنّي أريد ذلك
Dialogue: 0,0:03:39.69,0:03:41.87,Default,,0000,0000,0000,,!إنها غلطتهما
Dialogue: 0,0:03:41.87,0:03:43.79,Default,,0000,0000,0000,,كانا من أجبرني على تجرّع ذاك العقار الغريب
Dialogue: 0,0:03:43.79,0:03:46.25,Default,,0000,0000,0000,,!وقلّصا جسدي هكذا
Dialogue: 0,0:03:51.67,0:03:52.93,Default,,0000,0000,0000,,!إنّهما هما
Dialogue: 0,0:04:02.00,0:04:05.72,Default,,0000,0000,0000,,!أفضل فرصة لسرقة ذاك العقار
Dialogue: 0,0:04:06.79,0:04:10.11,Default,,0000,0000,0000,,،حالما أرجع متحري الثانوية كودو شينتشي
Dialogue: 0,0:04:10.11,0:04:12.69,Default,,0000,0000,0000,,!سأكشف كلّ أفعالكم الشريرة للعالم
Dialogue: 0,0:04:12.69,0:04:13.71,Default,,0000,0000,0000,,!بلا ريب
Dialogue: 0,0:04:17.44,0:04:20.58,Default,,0000,0000,0000,,لكن ما الذي يفعلانه هنا؟
Dialogue: 0,0:04:35.34,0:04:37.00,Default,,0000,0000,0000,,يلتقيان أحدهم
Dialogue: 0,0:04:43.96,0:04:47.46,Default,,0000,0000,0000,,الآن فرصتي لتثبيت ميكروفون البروفسور المخفي
Dialogue: 0,0:04:47.46,0:04:49.34,Default,,0000,0000,0000,,!بأحد مقاعدهم
Dialogue: 0,0:05:01.48,0:05:03.46,Default,,0000,0000,0000,,!ما الذي تفعله يا كونان-كن؟
Dialogue: 0,0:05:04.06,0:05:05.08,Default,,0000,0000,0000,,ابتعد قليلاً
Dialogue: 0,0:05:05.08,0:05:05.88,Default,,0000,0000,0000,,...لم أكن أفعل
Dialogue: 0,0:05:06.39,0:05:07.20,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:05:07.20,0:05:07.64,Default,,0000,0000,0000,,انتظري
Dialogue: 0,0:05:11.47,0:05:14.13,Default,,0000,0000,0000,,يا لك من مشاغب يا كونان-كن
Dialogue: 0,0:05:14.13,0:05:18.26,Default,,0000,0000,0000,,أمثالك هم من يسيئون لسمعة الصغار
Dialogue: 0,0:05:18.26,0:05:20.25,Default,,0000,0000,0000,,!عليك لفّ العلكة بورقة ووضعها في المنفضة
Dialogue: 0,0:05:22.93,0:05:23.46,Default,,0000,0000,0000,,هكذا
Dialogue: 0,0:05:24.12,0:05:26.59,Default,,0000,0000,0000,,سأسمعهما كما يجب إن كانت هنا
Dialogue: 0,0:05:27.12,0:05:29.46,Default,,0000,0000,0000,,تعلّم من أصدقائك يا كونان-كن
Dialogue: 0,0:05:29.46,0:05:30.54,Default,,0000,0000,0000,,أنتم أطفال مهذبون
Dialogue: 0,0:05:30.54,0:05:33.16,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:05:33.16,0:05:34.36,Default,,0000,0000,0000,,!هيّا بنا
Dialogue: 0,0:05:35.95,0:05:39.24,Default,,0000,0000,0000,,لم يكن مجرد مقلب عادي بما أنّه\N!من تدبيرك يا كونان-كن
Dialogue: 0,0:05:39.24,0:05:41.56,Default,,0000,0000,0000,,أكانت تلك العلكة سلاحاً سرّياً ما؟
Dialogue: 0,0:05:41.56,0:05:43.67,Default,,0000,0000,0000,,هل ذلكما الاثنان جاسوسان؟ قاتلان مستأجران؟
Dialogue: 0,0:05:44.40,0:05:48.10,Default,,0000,0000,0000,,!كان ذلك ليكون مسلياً، لكني كنتُ أشاغب قليلاً فقط
Dialogue: 0,0:05:48.10,0:05:49.13,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:05:51.26,0:05:52.80,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:05:52.80,0:05:56.89,Default,,0000,0000,0000,,!مُمل، لنرجع للاستكشاف
Dialogue: 0,0:06:01.46,0:06:03.33,Default,,0000,0000,0000,,أعتذر على كوني مُملاً
Dialogue: 0,0:06:06.42,0:06:07.62,Default,,0000,0000,0000,,ابتعد يا صبيّ
Dialogue: 0,0:06:12.57,0:06:13.42,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:14.49,0:06:18.72,Default,,0000,0000,0000,,!ليسا هما، ليسا الرجلين بالرداء الأسود
Dialogue: 0,0:06:20.86,0:06:23.79,Default,,0000,0000,0000,,!أخطأتُ في التعرف عليهما! يا لحماقتي
Dialogue: 0,0:06:30.97,0:06:33.97,Default,,0000,0000,0000,,...يحمل حقيبة سفر بدل حقيبة الورق التي كانت معه
Dialogue: 0,0:06:42.92,0:06:44.96,Default,,0000,0000,0000,,هناك خطبٌ ما
Dialogue: 0,0:06:44.96,0:06:48.11,Default,,0000,0000,0000,,الحقيبتان مختلفتان كثيراً فلا يمكن أن تخطئ\Nفي أخذ واحدة مكان الأخرى
Dialogue: 0,0:06:49.59,0:06:52.83,Default,,0000,0000,0000,,!صحيح! سأستعمل ميكروفون البروفسور المخفي
Dialogue: 0,0:06:53.33,0:06:55.70,Default,,0000,0000,0000,,،قال إن أدرت القرص لمطابقة التردد
Dialogue: 0,0:06:55.70,0:06:57.80,Default,,0000,0000,0000,,فستحفّز موجات صوت خاصة طبلات أذني
Dialogue: 0,0:06:57.80,0:07:00.74,Default,,0000,0000,0000,,!ويمكنني السماع أثناء ارتداء نظّارتي
Dialogue: 0,0:07:02.27,0:07:05.82,Default,,0000,0000,0000,,يمكنني التدخين أخيراً
Dialogue: 0,0:07:05.82,0:07:06.67,Default,,0000,0000,0000,,!أسمعهما
Dialogue: 0,0:07:08.77,0:07:09.71,Default,,0000,0000,0000,,!يوجد شيءٌ هنا
Dialogue: 0,0:07:10.81,0:07:12.06,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:07:12.06,0:07:14.06,Default,,0000,0000,0000,,ماذا؟ مجرد علكة
Dialogue: 0,0:07:14.06,0:07:15.64,Default,,0000,0000,0000,,كان ذلك وشيكاً
Dialogue: 0,0:07:20.09,0:07:22.67,Default,,0000,0000,0000,,كانت صفقةً سهلة في النهاية يا أخي
Dialogue: 0,0:07:23.09,0:07:24.17,Default,,0000,0000,0000,,أخفض صوتك
Dialogue: 0,0:07:24.17,0:07:27.13,Default,,0000,0000,0000,,لا تقلق، لا أحد يستمع
Dialogue: 0,0:07:27.63,0:07:31.37,Default,,0000,0000,0000,,لكن مئة مليون مقابل تسليم تلك الحقيبة فقط؟
Dialogue: 0,0:07:32.16,0:07:34.54,Default,,0000,0000,0000,,ما كان بها بالضبط؟
Dialogue: 0,0:07:34.54,0:07:36.09,Default,,0000,0000,0000,,معلومات عن الذهب
Dialogue: 0,0:07:36.66,0:07:39.55,Default,,0000,0000,0000,,معلومات تفوق قيمتها مئة مليون إن اُستعملت
Dialogue: 0,0:07:40.40,0:07:43.86,Default,,0000,0000,0000,,لعلّه جالسٌ الآن والابتسامة تمتد على وجهه
Dialogue: 0,0:07:43.86,0:07:46.57,Default,,0000,0000,0000,,...بينما ينظر لآخر منظر طبيعيّ سيراه عبر النافذة
Dialogue: 0,0:07:46.57,0:07:48.48,Default,,0000,0000,0000,,آخر منظر؟
Dialogue: 0,0:07:48.48,0:07:50.29,Default,,0000,0000,0000,,...يوجد داخل الحقيبة السوداء التي أعطيناه إياها
Dialogue: 0,0:07:51.14,0:07:56.64,Default,,0000,0000,0000,,قنبلة ستنفجر في 10 ثوانٍ حال\Nتلقي صدمة قوية
Dialogue: 0,0:07:56.64,0:07:57.97,Default,,0000,0000,0000,,!قـ-قنبلة؟
Dialogue: 0,0:07:57.97,0:08:01.37,Default,,0000,0000,0000,,...إن حدث وأسقط الحقيبة أيضاً
Dialogue: 0,0:08:03.17,0:08:05.67,Default,,0000,0000,0000,,تلك المعلومة مهمة جداً له
Dialogue: 0,0:08:05.67,0:08:07.63,Default,,0000,0000,0000,,أشكّ بحصول ذلك
Dialogue: 0,0:08:07.63,0:08:10.95,Default,,0000,0000,0000,,كما أن الانفجار مؤقت على 3:10
Dialogue: 0,0:08:10.95,0:08:12.17,Default,,0000,0000,0000,,قنبلة مؤقتة؟
Dialogue: 0,0:08:12.59,0:08:14.95,Default,,0000,0000,0000,,كلا، لكن عندما يحين الوقت
Dialogue: 0,0:08:14.95,0:08:18.13,Default,,0000,0000,0000,,سيضغط مفتاح التفجير دون أن يدرك
Dialogue: 0,0:08:18.79,0:08:22.82,Default,,0000,0000,0000,,وفي غضون 10 ثوانٍ، سينفجر قطار الطلقة لأجزاء
Dialogue: 0,0:08:22.82,0:08:25.59,Default,,0000,0000,0000,,!لـ-لأجزاء؟
Dialogue: 0,0:08:30.39,0:08:32.73,Default,,0000,0000,0000,,أ-أقصد ثمانية ضرب ثمانية؟
Dialogue: 0,0:08:32.73,0:08:34.04,Default,,0000,0000,0000,,!‏64
Dialogue: 0,0:08:34.39,0:08:36.80,Default,,0000,0000,0000,,ألا تقصد "هابّا 64"؟
Dialogue: 0,0:08:37.31,0:08:39.02,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:08:40.47,0:08:42.01,Default,,0000,0000,0000,,!ثمانية ضرب ثمانية تساوي 64
Dialogue: 0,0:08:42.01,0:08:43.02,Default,,0000,0000,0000,,...ثمانية ضرب تسعة
Dialogue: 0,0:08:43.02,0:08:44.92,Default,,0000,0000,0000,,!‏72
Dialogue: 0,0:08:44.92,0:08:47.97,Default,,0000,0000,0000,,...أخافني ذاك الصبيّ
Dialogue: 0,0:08:53.87,0:08:56.38,Default,,0000,0000,0000,,!وصلنا ناغويا! ناغويا
Dialogue: 0,0:08:57.46,0:08:58.88,Default,,0000,0000,0000,,!أسرع! سننزل
Dialogue: 0,0:09:01.95,0:09:04.59,Default,,0000,0000,0000,,!انتظرا! لا يزال هناك ما أريد سؤالكما عنه
Dialogue: 0,0:09:07.84,0:09:08.80,Default,,0000,0000,0000,,!انتظرا
Dialogue: 0,0:09:08.80,0:09:09.54,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:09:11.56,0:09:15.23,Default,,0000,0000,0000,,لا يمكنني إشاحة نظري عنك يا كونان-كن
Dialogue: 0,0:09:18.73,0:09:21.21,Default,,0000,0000,0000,,...هذا سيّئ، دون وجودهما
Dialogue: 0,0:09:22.26,0:09:26.25,Default,,0000,0000,0000,,لحظة، لا يزال الطرف الآخر في صفقتهما موجوداً هنا
Dialogue: 0,0:09:28.47,0:09:31.46,Default,,0000,0000,0000,,!تبّاً، 40 دقيقة حتّى الانفجار
Dialogue: 0,0:09:31.46,0:09:34.67,Default,,0000,0000,0000,,!عليّ إيجاد الشخص قبل ذلك
Dialogue: 0,0:09:34.67,0:09:39.87,Default,,0000,0000,0000,,!لكن كيف؟ يوجد مئات الركاب، فكيف؟
Dialogue: 0,0:09:41.28,0:09:42.54,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:09:49.07,0:09:50.91,Default,,0000,0000,0000,,أين ذهب؟
Dialogue: 0,0:09:58.10,0:09:59.62,Default,,0000,0000,0000,,!قـ-قنبلة؟
Dialogue: 0,0:09:59.94,0:10:02.64,Default,,0000,0000,0000,,!أجل! أحد الركاب معه قنبلة
Dialogue: 0,0:10:02.64,0:10:04.19,Default,,0000,0000,0000,,علينا إيقاف القطار في المحطة التالية
Dialogue: 0,0:10:04.19,0:10:05.39,Default,,0000,0000,0000,,!وإخلاء كافة الركاب
Dialogue: 0,0:10:05.98,0:10:08.31,Default,,0000,0000,0000,,!سينفجر هذا القطار لأجزاء
Dialogue: 0,0:10:10.93,0:10:13.59,Default,,0000,0000,0000,,لا تضايق الكبار يا فتى
Dialogue: 0,0:10:13.59,0:10:18.18,Default,,0000,0000,0000,,انتظر، ليس لطيفاً تجاهله لأنه طفل فقط
Dialogue: 0,0:10:18.18,0:10:23.08,Default,,0000,0000,0000,,انتظرني يا بنيّ، سأتصل الآن بـ "آنبان مان" لطلب المساعدة
Dialogue: 0,0:10:25.08,0:10:27.54,Default,,0000,0000,0000,,لا جدوى، لا يصدقونني أبداً
Dialogue: 0,0:10:27.54,0:10:28.76,Default,,0000,0000,0000,,ماذا أفعل؟
Dialogue: 0,0:10:29.25,0:10:32.11,Default,,0000,0000,0000,,كونان-كن! أهناك أمرٌ مثير يجري؟
Dialogue: 0,0:10:32.11,0:10:34.22,Default,,0000,0000,0000,,!أخبرنا إن وجدت قضيّة أخرى
Dialogue: 0,0:10:35.61,0:10:38.64,Default,,0000,0000,0000,,أهؤلاء كلّ من لديّ بصفي؟
Dialogue: 0,0:10:40.10,0:10:42.77,Default,,0000,0000,0000,,توجد عشرات الحقائب السوداء
Dialogue: 0,0:10:42.77,0:10:45.13,Default,,0000,0000,0000,,وتفقّدها جميعاً مستحيل
Dialogue: 0,0:10:48.94,0:10:52.63,Default,,0000,0000,0000,,تبّاً، هل خياري الوحيد البحث عن القنبلة بمفردي؟
Dialogue: 0,0:10:53.39,0:10:55.05,Default,,0000,0000,0000,,جد خيطاً
Dialogue: 0,0:10:55.05,0:10:57.60,Default,,0000,0000,0000,,!تذكّر بداية محادثتهما
Dialogue: 0,0:10:57.89,0:11:01.05,Default,,0000,0000,0000,,يمكنني التدخين أخيراً
Dialogue: 0,0:11:01.67,0:11:03.13,Default,,0000,0000,0000,,ما قصده بذلك؟
Dialogue: 0,0:11:03.13,0:11:05.26,Default,,0000,0000,0000,,التدخين ليس محظوراً في عربة الطعام
Dialogue: 0,0:11:05.92,0:11:09.13,Default,,0000,0000,0000,,!هكذا إذاً! الطرف الآخر يكره دخان السجائر
Dialogue: 0,0:11:09.13,0:11:10.91,Default,,0000,0000,0000,,!أي أنّه لا يدخن
Dialogue: 0,0:11:10.91,0:11:13.23,Default,,0000,0000,0000,,!مما يعني أنّه في عربة لا تدخين
Dialogue: 0,0:11:15.24,0:11:18.63,Default,,0000,0000,0000,,حسناً، كم عدد عربات اللا تدخين الإجمالي\Nفي هذا القطار؟
Dialogue: 0,0:11:18.63,0:11:20.77,Default,,0000,0000,0000,,!ثمان
Dialogue: 0,0:11:20.77,0:11:21.51,Default,,0000,0000,0000,,لمَ تسأل؟
Dialogue: 0,0:11:21.51,0:11:22.51,Default,,0000,0000,0000,,أتحلّ لغزاً؟
Dialogue: 0,0:11:23.11,0:11:25.34,Default,,0000,0000,0000,,لا بد من وجود خيوط أكثر
Dialogue: 0,0:11:25.69,0:11:28.73,Default,,0000,0000,0000,,مئة مليون مقابل تسليم تلك الحقيبة فقط؟
Dialogue: 0,0:11:28.73,0:11:31.14,Default,,0000,0000,0000,,ما كان بها بالضبط؟
Dialogue: 0,0:11:31.14,0:11:32.80,Default,,0000,0000,0000,,معلومات عن الذهب
Dialogue: 0,0:11:33.43,0:11:37.01,Default,,0000,0000,0000,,لعلّه جالسٌ الآن والابتسامة ترتسم على وجهه
Dialogue: 0,0:11:37.01,0:11:39.71,Default,,0000,0000,0000,,...بينما ينظر لآخر منظر طبيعيّ سيراه عبر النافذة
Dialogue: 0,0:11:40.54,0:11:42.59,Default,,0000,0000,0000,,أين يمكنك رؤية مناظر طبيعية\Nمن النوافذ في القطار؟
Dialogue: 0,0:11:42.59,0:11:45.17,Default,,0000,0000,0000,,!العربات الخضراء بالطابقين
Dialogue: 0,0:11:45.17,0:11:49.18,Default,,0000,0000,0000,,توجد 3 عربات خضراء، صحيح؟ أيّها محظورة التدخين؟
Dialogue: 0,0:11:49.83,0:11:52.03,Default,,0000,0000,0000,,!كانت... الطابق الثاني من العربة السابعة
Dialogue: 0,0:11:52.03,0:11:53.28,Default,,0000,0000,0000,,!ماذا هناك؟
Dialogue: 0,0:11:53.28,0:11:55.18,Default,,0000,0000,0000,,!لا أدري ما الذي يجري لكن لنذهب بأيّ حال
Dialogue: 0,0:11:55.62,0:11:58.14,Default,,0000,0000,0000,,كلا، ذلك خطير على الأطفال
Dialogue: 0,0:11:58.62,0:12:02.02,Default,,0000,0000,0000,,!نحن فرقة فتيان التحرّي! هيّا بنا
Dialogue: 0,0:12:15.81,0:12:18.97,Default,,0000,0000,0000,,من يحمل الحقيبة السوداء التي تحمل القنبلة؟
Dialogue: 0,0:12:21.75,0:12:22.84,Default,,0000,0000,0000,,...واحد
Dialogue: 0,0:12:23.71,0:12:24.84,Default,,0000,0000,0000,,...اثنان
Dialogue: 0,0:12:25.59,0:12:26.80,Default,,0000,0000,0000,,...ثلاثة
Dialogue: 0,0:12:27.59,0:12:28.76,Default,,0000,0000,0000,,...أربعة
Dialogue: 0,0:12:31.79,0:12:34.68,Default,,0000,0000,0000,,عليّ التحقق منهم جميعاً
Dialogue: 0,0:12:40.11,0:12:44.47,Default,,0000,0000,0000,,!تداول أسهم... وروليكس ذهبية
Dialogue: 0,0:12:44.47,0:12:46.90,Default,,0000,0000,0000,,إنّه يرقد بين النقود حقّاً
Dialogue: 0,0:12:46.90,0:12:47.89,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:12:48.53,0:12:50.60,Default,,0000,0000,0000,,أخبرني، أيمكنني اللعب معك؟
Dialogue: 0,0:12:50.60,0:12:52.18,Default,,0000,0000,0000,,!إنّها ليست لعبة
Dialogue: 0,0:12:52.18,0:12:54.34,Default,,0000,0000,0000,,!كاذب! توجد مجموعة دوائر ومثلثات على الشاشة
Dialogue: 0,0:12:54.81,0:12:56.68,Default,,0000,0000,0000,,!أنت تعترض عملي! ارحل
Dialogue: 0,0:12:57.06,0:12:57.89,Default,,0000,0000,0000,,!لئيم
Dialogue: 0,0:12:57.89,0:13:02.13,Default,,0000,0000,0000,,دعني ألعب بهذا الأسود إذاً، إنه لعبة كذلك، صحيح؟
Dialogue: 0,0:13:02.63,0:13:05.59,Default,,0000,0000,0000,,ما الخطب يا فتى؟ أضللت طريقك؟
Dialogue: 0,0:13:12.25,0:13:13.38,Default,,0000,0000,0000,,!مُذهل
Dialogue: 0,0:13:15.12,0:13:16.01,Default,,0000,0000,0000,,!منظر جميل
Dialogue: 0,0:13:16.01,0:13:20.21,Default,,0000,0000,0000,,أجل، الطقس صحو اليوم لذا يمكنك\Nرؤية جبل فوجي من هنا
Dialogue: 0,0:13:21.44,0:13:22.44,Default,,0000,0000,0000,,جبل فوجي؟
Dialogue: 0,0:13:22.44,0:13:24.99,Default,,0000,0000,0000,,أتحب جبل فوجي يا فتى؟
Dialogue: 0,0:13:24.99,0:13:28.44,Default,,0000,0000,0000,,!أجل، أحبه كثيراً
Dialogue: 0,0:13:28.44,0:13:31.17,Default,,0000,0000,0000,,!تبّاً! إنها مقفلة
Dialogue: 0,0:13:31.77,0:13:35.77,Default,,0000,0000,0000,,!اخرس! ماذا لا تفهم في "ارحل"؟
Dialogue: 0,0:13:35.77,0:13:36.55,Default,,0000,0000,0000,,تبّاً
Dialogue: 0,0:13:37.39,0:13:39.63,Default,,0000,0000,0000,,أخبريني يا عمّة، أذهبتِ لعربة الطعام؟
Dialogue: 0,0:13:39.63,0:13:40.84,Default,,0000,0000,0000,,لمَ تسأل؟
Dialogue: 0,0:13:40.84,0:13:43.76,Default,,0000,0000,0000,,ظننتك تشبهين من كان رفقة
Dialogue: 0,0:13:43.76,0:13:45.51,Default,,0000,0000,0000,,الاثنين بالرداء الأسود
Dialogue: 0,0:13:46.13,0:13:48.17,Default,,0000,0000,0000,,أخطأت في الشخص إذاً
Dialogue: 0,0:13:48.17,0:13:50.08,Default,,0000,0000,0000,,لم أذهب لعربة الطعام
Dialogue: 0,0:13:50.08,0:13:51.37,Default,,0000,0000,0000,,ماذا عنك يا عم؟
Dialogue: 0,0:13:51.37,0:13:54.47,Default,,0000,0000,0000,,!كأن بإمكاني الذهاب لمكان وأنا مشغول هكذا
Dialogue: 0,0:13:55.00,0:13:55.89,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:14:03.36,0:14:06.11,Default,,0000,0000,0000,,أخبرني، هل ذهبت لعربة الطعام قبل قليل؟
Dialogue: 0,0:14:09.56,0:14:10.48,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:10.48,0:14:12.97,Default,,0000,0000,0000,,!سألتك إن كنت ذهبت لعربة الطعام قبل قليل؟
Dialogue: 0,0:14:13.73,0:14:15.60,Default,,0000,0000,0000,,!أجل، ذهبت
Dialogue: 0,0:14:15.75,0:14:19.19,Default,,0000,0000,0000,,!مهما ذهبت من مرّات، "ديزني لاند" مسلية دوماً
Dialogue: 0,0:14:21.13,0:14:25.14,Default,,0000,0000,0000,,لا جدوى... حسناً، سأعود له لاحقاً
Dialogue: 0,0:14:34.12,0:14:36.01,Default,,0000,0000,0000,,!إطار ذهبي
Dialogue: 0,0:14:36.62,0:14:38.72,Default,,0000,0000,0000,,هل ذهبت لعربة الطعام قبل قليل؟
Dialogue: 0,0:14:40.49,0:14:41.63,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:41.63,0:14:44.86,Default,,0000,0000,0000,,لا-لا علاقة لي، صحيح؟
Dialogue: 0,0:14:49.31,0:14:52.51,Default,,0000,0000,0000,,!إنه منديل مائدة من عربة الطعام
Dialogue: 0,0:14:53.19,0:14:55.17,Default,,0000,0000,0000,,!كان هذا الشخص هناك
Dialogue: 0,0:14:56.27,0:14:57.39,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:14:58.10,0:15:01.26,Default,,0000,0000,0000,,علقت طائرتي الورقية هناك
Dialogue: 0,0:15:01.26,0:15:02.34,Default,,0000,0000,0000,,لا تمانع إن أخذتها، صحيح؟
Dialogue: 0,0:15:03.18,0:15:04.39,Default,,0000,0000,0000,,لا مشكلة؟
Dialogue: 0,0:15:05.64,0:15:08.31,Default,,0000,0000,0000,,ماذا؟ أين هي؟ لا أجدها
Dialogue: 0,0:15:11.21,0:15:12.17,Default,,0000,0000,0000,,!لا تلمسها
Dialogue: 0,0:15:15.25,0:15:17.88,Default,,0000,0000,0000,,...يوجد داخل الحقيبة السوداء التي أعطيناه إيّاها
Dialogue: 0,0:15:18.08,0:15:22.92,Default,,0000,0000,0000,,قنبلة ستنفجر في 10 ثوانٍ حال\Nتلقي صدمة قوية
Dialogue: 0,0:15:23.25,0:15:24.11,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:15:32.31,0:15:34.56,Default,,0000,0000,0000,,!التقاط ممتاز يا غينتا-كن
Dialogue: 0,0:15:34.56,0:15:35.27,Default,,0000,0000,0000,,!مذهل
Dialogue: 0,0:15:37.06,0:15:38.46,Default,,0000,0000,0000,,ما هذا بأيّ حال؟
Dialogue: 0,0:15:39.42,0:15:40.87,Default,,0000,0000,0000,,...إ-إنّها
Dialogue: 0,0:15:41.33,0:15:43.13,Default,,0000,0000,0000,,!هلّا توقفت؟
Dialogue: 0,0:15:51.12,0:15:52.29,Default,,0000,0000,0000,,سـ-سروال داخلي؟
Dialogue: 0,0:15:55.33,0:15:57.71,Default,,0000,0000,0000,,!أيّها الأشقياء
Dialogue: 0,0:15:58.33,0:15:59.50,Default,,0000,0000,0000,,!لا ترجعوا
Dialogue: 0,0:16:02.19,0:16:05.29,Default,,0000,0000,0000,,!كونان-كن! أنتم أيضاً! يكفي عبثاً
Dialogue: 0,0:16:11.14,0:16:13.47,Default,,0000,0000,0000,,!بقي 11 دقيقة حتى الانفجار
Dialogue: 0,0:16:13.47,0:16:16.93,Default,,0000,0000,0000,,لكن تقلص عددهم بواحد على الأقل، تبقى ثلاثة
Dialogue: 0,0:16:16.93,0:16:18.76,Default,,0000,0000,0000,,!من يحمل القنبلة؟
Dialogue: 0,0:16:24.11,0:16:26.44,Default,,0000,0000,0000,,!تبّاً لهما
Dialogue: 0,0:16:26.63,0:16:28.34,Default,,0000,0000,0000,,قنبلة مؤقتة؟
Dialogue: 0,0:16:28.63,0:16:31.25,Default,,0000,0000,0000,,،كلا، لكن عندما يحين الوقت
Dialogue: 0,0:16:31.25,0:16:34.29,Default,,0000,0000,0000,,سيضغط مفتاح التفجير دون أن يدرك
Dialogue: 0,0:16:34.70,0:16:35.95,Default,,0000,0000,0000,,!ها هي
Dialogue: 0,0:16:35.95,0:16:38.95,Default,,0000,0000,0000,,...ما يعني أن الانفجار سيحدث بردة فعل الشخص لشيء
Dialogue: 0,0:16:38.95,0:16:45.13,Default,,0000,0000,0000,,،بحوزة الثلاثة أشخاص... حاسب محمول\Nهاتف خلوي، ومشغل صوت بسمّاعات
Dialogue: 0,0:16:45.79,0:16:48.45,Default,,0000,0000,0000,,!لا جدوى! كلّهم مشتبه به
Dialogue: 0,0:16:48.45,0:16:49.86,Default,,0000,0000,0000,,لا يزال ينقصني خيط
Dialogue: 0,0:16:51.07,0:16:53.40,Default,,0000,0000,0000,,توقف! أين ستذهب؟
Dialogue: 0,0:16:55.15,0:16:57.28,Default,,0000,0000,0000,,أخبرتك أن تبقى مكانك
Dialogue: 0,0:16:57.28,0:16:59.06,Default,,0000,0000,0000,,...لكن عليّ الذهاب للحمّام
Dialogue: 0,0:16:59.06,0:17:00.85,Default,,0000,0000,0000,,ذهبت قبل قليل
Dialogue: 0,0:17:00.85,0:17:01.84,Default,,0000,0000,0000,,أشعر بالعطش
Dialogue: 0,0:17:01.84,0:17:03.14,Default,,0000,0000,0000,,تحمّل فقط
Dialogue: 0,0:17:03.14,0:17:04.06,Default,,0000,0000,0000,,هدايا؟
Dialogue: 0,0:17:04.06,0:17:05.81,Default,,0000,0000,0000,,تشتريها في طريق عودتك
Dialogue: 0,0:17:05.81,0:17:06.83,Default,,0000,0000,0000,,تجوّل؟
Dialogue: 0,0:17:06.83,0:17:08.35,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:17:09.71,0:17:11.76,Default,,0000,0000,0000,,...تحب إثارة الشغب حقّاً
Dialogue: 0,0:17:13.59,0:17:16.17,Default,,0000,0000,0000,,!تبّاً! تبقت 7 دقائق
Dialogue: 0,0:17:16.17,0:17:18.55,Default,,0000,0000,0000,,ليس أمامي الآن سوى شرح كلّ شيء
Dialogue: 0,0:17:18.55,0:17:21.00,Default,,0000,0000,0000,,وجعل الركاب يخلون القطار
Dialogue: 0,0:17:21.00,0:17:23.72,Default,,0000,0000,0000,,!لكن لا أحد يصدقني لأني طفل
Dialogue: 0,0:17:24.66,0:17:28.04,Default,,0000,0000,0000,,هناك طريقة واحدة فقط لجعلها تصدقني
Dialogue: 0,0:17:28.04,0:17:30.55,Default,,0000,0000,0000,,،لو أخبرتها أنّ هويتي هي كودو شينتشي
Dialogue: 0,0:17:30.55,0:17:33.28,Default,,0000,0000,0000,,!ستصدقني ران
Dialogue: 0,0:17:33.28,0:17:35.53,Default,,0000,0000,0000,,!عندها سيصدق الجميع كلامها
Dialogue: 0,0:17:37.32,0:17:42.34,Default,,0000,0000,0000,,...إن انفجرت القنبلة، سأكون وران وجميع الركاب
Dialogue: 0,0:17:45.10,0:17:46.89,Default,,0000,0000,0000,,...ران، أنا
Dialogue: 0,0:17:46.89,0:17:50.30,Default,,0000,0000,0000,,!ليس هكذا، نادني ران-نيتشان
Dialogue: 0,0:17:50.30,0:17:53.26,Default,,0000,0000,0000,,يُفترض أن تستعمل اللّواحق عند\Nمخاطبة من أهم أكبر سنّاً منك
Dialogue: 0,0:17:54.34,0:17:55.97,Default,,0000,0000,0000,,أصغي لي يا ران
Dialogue: 0,0:17:55.97,0:17:57.51,Default,,0000,0000,0000,,!ها أنت مجدداً
Dialogue: 0,0:17:57.51,0:18:00.21,Default,,0000,0000,0000,,!أنا أتكلم بجدية
Dialogue: 0,0:18:00.75,0:18:01.97,Default,,0000,0000,0000,,آسف يا ران
Dialogue: 0,0:18:03.16,0:18:04.87,Default,,0000,0000,0000,,كنت أخفي أمراً عنك
Dialogue: 0,0:18:04.87,0:18:05.64,Default,,0000,0000,0000,,تخفي؟
Dialogue: 0,0:18:06.29,0:18:09.61,Default,,0000,0000,0000,,...لستُ إيدوغاوا كونان أو طالباً في الابتدائية
Dialogue: 0,0:18:09.61,0:18:10.09,Default,,0000,0000,0000,,...أنا
Dialogue: 0,0:18:10.78,0:18:12.62,Default,,0000,0000,0000,,...أنا في الواقع
Dialogue: 0,0:18:12.72,0:18:15.53,Default,,0000,0000,0000,,ماذا؟ هل تجاوزنا المحيط؟
Dialogue: 0,0:18:15.53,0:18:18.01,Default,,0000,0000,0000,,أجل، بينما كنت تنظر بعيداً
Dialogue: 0,0:18:18.57,0:18:21.19,Default,,0000,0000,0000,,لكن هذه المقاعد تقابلها الجبال
Dialogue: 0,0:18:21.19,0:18:22.97,Default,,0000,0000,0000,,فلم نكن لنراه بأيّ حال
Dialogue: 0,0:18:23.44,0:18:24.43,Default,,0000,0000,0000,,مقابل الجبال؟
Dialogue: 0,0:18:25.19,0:18:26.39,Default,,0000,0000,0000,,!منظر جميل
Dialogue: 0,0:18:26.94,0:18:30.59,Default,,0000,0000,0000,,أجل، الطقس صحو اليوم لذا يمكنك\Nرؤية جبل فوجي من هنا
Dialogue: 0,0:18:31.38,0:18:33.63,Default,,0000,0000,0000,,...كانت تلك المقاعد مقابل المحيط
Dialogue: 0,0:18:33.63,0:18:35.51,Default,,0000,0000,0000,,لذا من المستحيل أن ترى جبل فوجي
Dialogue: 0,0:18:36.38,0:18:40.46,Default,,0000,0000,0000,,من أين رأتْه إذاً؟
Dialogue: 0,0:18:41.37,0:18:42.73,Default,,0000,0000,0000,,!عربة الطعام
Dialogue: 0,0:18:43.92,0:18:46.58,Default,,0000,0000,0000,,جلسوا على الجانب المقابل للجبال
Dialogue: 0,0:18:46.58,0:18:50.88,Default,,0000,0000,0000,,...إن خلطت بين المنظر من هناك والمنظر من مقعدها
Dialogue: 0,0:18:51.74,0:18:54.45,Default,,0000,0000,0000,,لم أذهب لعربة الطعام
Dialogue: 0,0:18:54.45,0:18:57.85,Default,,0000,0000,0000,,...إن كانت تلك كذبة لإخفاء حقيقة الصفقة
Dialogue: 0,0:19:00.35,0:19:01.30,Default,,0000,0000,0000,,...فالقنبلة
Dialogue: 0,0:19:03.19,0:19:04.46,Default,,0000,0000,0000,,!في حقيبتها
Dialogue: 0,0:19:07.44,0:19:09.76,Default,,0000,0000,0000,,!تبّاً! تبقت دقيقة فقط
Dialogue: 0,0:19:09.76,0:19:12.55,Default,,0000,0000,0000,,انتباه لكافة الركاب
Dialogue: 0,0:19:12.55,0:19:18.01,Default,,0000,0000,0000,,استعمال الهواتف الخلوية قد يضايق بقية المسافرين
Dialogue: 0,0:19:18.01,0:19:21.51,Default,,0000,0000,0000,,لذا نأمل منكم الذهاب خارج العربة لاستعمال هاتفكم
Dialogue: 0,0:19:22.04,0:19:24.13,Default,,0000,0000,0000,,!هذا هو! الهاتف الخلوي
Dialogue: 0,0:19:25.67,0:19:27.71,Default,,0000,0000,0000,,أنت! ماذا الآن؟
Dialogue: 0,0:19:27.71,0:19:32.20,Default,,0000,0000,0000,,اسمعوا! تقول ران-نيتشان أنها ستشتري\N!لنا أيّ طعام لذيذ نريد
Dialogue: 0,0:19:32.20,0:19:34.78,Default,,0000,0000,0000,,!رائع! أريد علبة غداء أنقليس
Dialogue: 0,0:19:34.78,0:19:35.95,Default,,0000,0000,0000,,!أنا أريد سوشي
Dialogue: 0,0:19:35.95,0:19:38.98,Default,,0000,0000,0000,,!وأنا أريد وجبة طعام فرنسي كاملة
Dialogue: 0,0:19:38.98,0:19:41.21,Default,,0000,0000,0000,,...تـ-تمهلوا
Dialogue: 0,0:19:42.11,0:19:45.22,Default,,0000,0000,0000,,...من المحال أن تخطط لضغط أحد لمفتاح أو زرّ
Dialogue: 0,0:19:45.22,0:19:47.98,Default,,0000,0000,0000,,على حاسب محمول أو مشغل صوت \N!في الساعة 3:10 تماماً
Dialogue: 0,0:19:47.98,0:19:49.51,Default,,0000,0000,0000,,...لكن بالنسبة لهاتف
Dialogue: 0,0:19:49.51,0:19:52.42,Default,,0000,0000,0000,,!من الممكن ضبطه على زمن معيّن ورقم هاتف معيّن
Dialogue: 0,0:20:00.50,0:20:01.05,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:20:01.36,0:20:01.97,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:20:04.17,0:20:07.89,Default,,0000,0000,0000,,في غضون 10 ثوانٍ، سينفجر قطار الطلقة لأجزاء
Dialogue: 0,0:20:22.07,0:20:22.84,Default,,0000,0000,0000,,ما كان ذلك؟
Dialogue: 0,0:20:29.14,0:20:30.26,Default,,0000,0000,0000,,مـ-من أنت؟
Dialogue: 0,0:20:30.93,0:20:33.47,Default,,0000,0000,0000,,إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:20:34.26,0:20:35.93,Default,,0000,0000,0000,,مـ-متحرٍّ؟
Dialogue: 0,0:20:36.51,0:20:40.25,Default,,0000,0000,0000,,أنت! ماذا فعلت هذه المرة؟
Dialogue: 0,0:20:40.25,0:20:41.88,Default,,0000,0000,0000,,!لكني مجرد طالب في الابتدائية
Dialogue: 0,0:20:45.84,0:20:48.25,Default,,0000,0000,0000,,توقف قطار الطلقة بعدها
Dialogue: 0,0:20:48.25,0:20:50.41,Default,,0000,0000,0000,,وبدأ تحقيق المفتّش ميغوري ورجاله
Dialogue: 0,0:20:50.41,0:20:53.41,Default,,0000,0000,0000,,كان التأخر عن الزفاف مشكلة بحدِّ ذاته
Dialogue: 0,0:20:53.41,0:20:56.80,Default,,0000,0000,0000,,لكن انتهت الأمور دون إصابة أحد بشكل ما
Dialogue: 0,0:20:57.37,0:21:01.07,Default,,0000,0000,0000,,تبيّن أنها اشترت معلومات داخلية عن سوق التداول
Dialogue: 0,0:21:01.07,0:21:03.16,Default,,0000,0000,0000,,من الرجلين مقابل 100 مليون ين
Dialogue: 0,0:21:03.16,0:21:05.22,Default,,0000,0000,0000,,ويبدو أنّ كان عليها الاتصال بهما على رقم معين
Dialogue: 0,0:21:05.82,0:21:09.14,Default,,0000,0000,0000,,في وقت محدد لمعرفة كيفية فتح الحقيبة
Dialogue: 0,0:21:09.14,0:21:13.93,Default,,0000,0000,0000,,لكن الاثنين خططا للتخلص منها\Nبعد الحصول على المال من البداية
Dialogue: 0,0:21:13.93,0:21:21.13,Default,,0000,0000,0000,,تمّ اعتقالهما من قبل نقطة تفتيش طارئة للشرطة
Dialogue: 0,0:21:21.92,0:21:25.13,Default,,0000,0000,0000,,...تسرّعتُ بالاستنتاج حقّاً
Dialogue: 0,0:21:25.13,0:21:29.09,Default,,0000,0000,0000,,أين الرجلان بالرداء الأسود اللذان قلّصا جسدي؟
Dialogue: 0,0:21:29.62,0:21:32.20,Default,,0000,0000,0000,,!تبّاً! لن أستسلم
Dialogue: 0,0:21:32.20,0:21:34.95,Default,,0000,0000,0000,,!سألحق بكما يوماً
Dialogue: 0,0:21:34.95,0:21:36.00,Default,,0000,0000,0000,,!بالتأكيد
Dialogue: 0,0:23:15.28,0:23:18.69,Default,,0000,0000,0000,,أخبرني يا كونان-كن، ما الذي كنت تقوله؟
Dialogue: 0,0:23:18.69,0:23:19.75,Default,,0000,0000,0000,,ماذا؟ ما قصدك؟
Dialogue: 0,0:23:20.10,0:23:24.56,Default,,0000,0000,0000,,لا تتظاهر بالحماقة! كانت ملامحك جادة
Dialogue: 0,0:23:24.56,0:23:27.89,Default,,0000,0000,0000,,...لستُ إيدوغاوا كونان أو طالباً في الابتدائية
Dialogue: 0,0:23:27.89,0:23:28.47,Default,,0000,0000,0000,,...أنا
Dialogue: 0,0:23:28.88,0:23:32.30,Default,,0000,0000,0000,,...أنا في الواقع
Dialogue: 0,0:23:32.30,0:23:33.68,Default,,0000,0000,0000,,ما هويّتك بالضبط؟
Dialogue: 0,0:23:33.68,0:23:37.51,Default,,0000,0000,0000,,...أ-أنا... في الواقع
Dialogue: 0,0:23:37.72,0:23:39.71,Default,,0000,0000,0000,,!عبقري في الشغب
Dialogue: 0,0:24:03.02,0:24:04.98,Default,,0000,0000,0000,,{\a6}ما الذي تفعلينه يا ران-نيتشان؟
Dialogue: 0,0:24:04.98,0:24:09.46,Default,,0000,0000,0000,,{\a6}إنّها شوكولاتة، فالفالنتاين يوم واحد في السنة
Dialogue: 0,0:24:09.97,0:24:11.26,Default,,0000,0000,0000,,!موعد؟
Dialogue: 0,0:24:11.93,0:24:13.38,Default,,0000,0000,0000,,سأخرج إذاً
Dialogue: 0,0:24:13.80,0:24:16.47,Default,,0000,0000,0000,,اذهبي واصطادي رجلاً ثريّاً
Dialogue: 0,0:24:16.93,0:24:19.21,Default,,0000,0000,0000,,إنّها قضية سهلة كما يبدو
Dialogue: 0,0:24:20.17,0:24:22.97,Default,,0000,0000,0000,,!أي... أنت الفاعل
Dialogue: 0,0:24:23.75,0:24:25.97,Default,,0000,0000,0000,,...الفاعل الحقيقي كان
Dialogue: 0,0:24:26.13,0:24:27.83,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.83,0:24:30.07,Default,,0000,0000,0000,,قضيّة جريمة الفالنتاين
Dialogue: 0,0:24:48.66,0:24:50.98,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:51.31,0:24:52.74,Default,,0000,0000,0000,,شوكولاتة
Dialogue: 0,0:24:53.96,0:24:56.54,Default,,0000,0000,0000,,!في الحلقة القادمة أيضاً، تبقى الحقيقة واحدة

