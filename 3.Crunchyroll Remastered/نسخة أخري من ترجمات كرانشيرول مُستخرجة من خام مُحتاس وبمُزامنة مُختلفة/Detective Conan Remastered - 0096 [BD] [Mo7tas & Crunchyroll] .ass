Dialogue: 0,0:00:02.42,0:00:04.12,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مذنّب لامع
Dialogue: 0,0:00:04.12,0:00:07.32,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.58,0:00:10.70,Default,,0000,0000,0000,,!اليوم أوّل حلقة خاصة من ساعتين \N!جرّبوا حلّ اللغزين
Dialogue: 0,0:00:11.12,0:00:12.37,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.66,0:00:14.49,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.49,0:00:16.27,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.81,0:01:51.80,Title,,0000,0000,15,,{\fad(300,0)}المتحرّي العظيم محاصَر! جريمتا قتل كبيرتان توالياً
Dialogue: 0,0:01:46.66,0:01:50.90,Default,,0000,0000,0000,,المتحرّي العظيم محاصَر! جريمتا قتل كبيرتان توالياً
Dialogue: 0,0:01:52.67,0:01:56.30,CharCard,,0000,0000,0000,,{\fad(300,00)}منزل آغاسا
Dialogue: 0,0:01:54.04,0:01:56.30,On Top,,0000,0000,0000,,!اسمعني يا شين-تشان
Dialogue: 0,0:01:56.44,0:01:59.34,Default,,0000,0000,0000,,أجل، أجل، أنا أسمعك يا أمّي
Dialogue: 0,0:01:59.34,0:02:03.62,Default,,0000,0000,0000,,غادر يوساكو باكراً هذا الصباح
Dialogue: 0,0:02:03.62,0:02:05.40,On Top,,0000,0000,0000,,وبعدما عاد أخيراً، كان ثملاً بالكامل
Dialogue: 0,0:02:03.84,0:02:07.44,CharCard,,0000,0000,0004,,{\fad(300,00)} \Nكودو يوكيكو\N(أمّ شينتشي (ممثلة
Dialogue: 0,0:02:05.40,0:02:07.34,On Top,,0000,0000,0000,,!هذا يفقدني أعصابي
Dialogue: 0,0:02:07.50,0:02:11.55,Default,,0000,0000,0000,,ليس الأمر بيده، فهو روائيّ شهير
Dialogue: 0,0:02:11.86,0:02:13.85,On Top,,0000,0000,0000,,عليه مخالطة الكثير من الناس
Dialogue: 0,0:02:13.85,0:02:17.63,Default,,0000,0000,0000,,!أيّ مخالطة؟! هناك علامة قُبلة على قميصه
Dialogue: 0,0:02:17.68,0:02:21.05,On Top,,0000,0000,0000,,!أشعر بالغيظ! سأخونه بدوري
Dialogue: 0,0:02:17.97,0:02:21.15,CharCard,,0000,0000,0004,,{\fad(300,00)}كودو يوساكو\Nمؤلّف روايات تحرّي مشهور عالمياً
Dialogue: 0,0:02:21.35,0:02:23.68,Default,,0000,0000,0000,,!مهلك، اهدئي
Dialogue: 0,0:02:23.68,0:02:25.65,Default,,0000,0000,0000,,أنا مشغولٌ قليلاً الآن
Dialogue: 0,0:02:25.65,0:02:26.59,Default,,0000,0000,0000,,!انتظر! شينتشي
Dialogue: 0,0:02:28.55,0:02:32.13,Default,,0000,0000,0000,,ما الخطب؟ كانت تلك يوكيكو-سان، صحيح؟
Dialogue: 0,0:02:32.13,0:02:35.12,Default,,0000,0000,0000,,كانت تتذمّر من مشاكلها الزوجية
Dialogue: 0,0:02:35.12,0:02:38.30,Default,,0000,0000,0000,,...أبي يرجع للبيت ثملاً، أبي يخونها
Dialogue: 0,0:02:38.64,0:02:40.05,Default,,0000,0000,0000,,!يـ-يخونها؟
Dialogue: 0,0:02:40.25,0:02:42.41,Default,,0000,0000,0000,,مجرّد سوء فهم، سوء فهم
Dialogue: 0,0:02:42.41,0:02:47.32,Default,,0000,0000,0000,,،كلّ ما برأس ذاك الرجل هو الألغاز\Nفلا يملك مقدرةً على ذلك
Dialogue: 0,0:02:47.32,0:02:52.05,Default,,0000,0000,0000,,كما أنّ شجاراتهما مناسبة سنويّة، لا فائدة من القلق
Dialogue: 0,0:02:52.38,0:02:56.48,Default,,0000,0000,0000,,أجل، إنّهما شديدا التوافق بحيث يتشاجران
Dialogue: 0,0:02:56.48,0:02:59.09,Default,,0000,0000,0000,,بالمناسبة، كيف وضعك أنت؟
Dialogue: 0,0:02:59.39,0:03:00.84,Default,,0000,0000,0000,,وضعي؟
Dialogue: 0,0:03:01.14,0:03:04.27,Default,,0000,0000,0000,,أقصد مع ران-كن، أأنت متوافق معها؟
Dialogue: 0,0:03:05.04,0:03:09.83,Default,,0000,0000,0000,,"!تصرخ عليّ كلّما أتّصل بها، "متى سترجع؟
Dialogue: 0,0:03:09.83,0:03:14.35,Default,,0000,0000,0000,,رغم أنّنا نرى بعضنا لحدّ السأم يومياً
Dialogue: 0,0:03:17.91,0:03:19.20,Default,,0000,0000,0000,,لا تقل هذا
Dialogue: 0,0:03:19.20,0:03:24.36,Default,,0000,0000,0000,,لمَ لا تبتعد عن القضايا قليلاً\Nوتذهب لزيارة مكانٍ معها؟
Dialogue: 0,0:03:24.36,0:03:27.01,Default,,0000,0000,0000,,!الخريف هو فصل الحُب
Dialogue: 0,0:03:27.48,0:03:29.41,Default,,0000,0000,0000,,فصل الحُب؟
Dialogue: 0,0:03:35.97,0:03:36.64,Default,,0000,0000,0000,,رجعت
Dialogue: 0,0:03:36.64,0:03:37.97,Default,,0000,0000,0000,,!يا حمقاء
Dialogue: 0,0:03:37.97,0:03:39.51,Default,,0000,0000,0000,,!اهتمّي بشؤونك
Dialogue: 0,0:03:39.65,0:03:41.89,On Top,,0000,0000,0000,,ما خطب هذه النبرة؟
Dialogue: 0,0:03:40.16,0:03:44.94,CharCard,,0000,0000,0004,,{\fad(300,0)}كيساكي إيري\N(أمّ ران (محامية
Dialogue: 0,0:03:41.89,0:03:44.84,On Top,,0000,0000,0000,,أقدّم لك عميلاً، وهذا كلامك؟
Dialogue: 0,0:03:45.88,0:03:48.34,Default,,0000,0000,0000,,!كأنّني أحتاج مساعدتك
Dialogue: 0,0:03:48.63,0:03:50.71,Default,,0000,0000,0000,,افعل ما يحلو لك إذاً
Dialogue: 0,0:03:50.71,0:03:56.09,Default,,0000,0000,0000,,لكن لا تلمني إذا لم تعد\Nتتلقّى عملاء، أيّها المتحرّي العظيم
Dialogue: 0,0:03:56.37,0:04:00.90,Default,,0000,0000,0000,,!أجل، شكراً لقلقك أيّتها المحامية العظيمة
Dialogue: 0,0:04:03.41,0:04:05.42,Default,,0000,0000,0000,,وهذان في شجاراتهما الزوجية الخاصّة
Dialogue: 0,0:04:05.94,0:04:08.13,Default,,0000,0000,0000,,موسم الحُب؟ أعد كلامك
Dialogue: 0,0:04:11.27,0:04:13.77,Default,,0000,0000,0000,,الخريف موسم الجوع حقّاً
Dialogue: 0,0:04:14.43,0:04:18.03,Default,,0000,0000,0000,,...ران، لترجعي للبيت سريعاً. أنا أتضوّر جوعاً
Dialogue: 0,0:04:20.22,0:04:21.63,Default,,0000,0000,0000,,!رجعت
Dialogue: 0,0:04:21.89,0:04:22.72,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:22.72,0:04:23.94,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:24.42,0:04:27.55,Default,,0000,0000,0000,,تبحثين عن كونان؟ إنّه نائم على الأريكة
Dialogue: 0,0:04:27.55,0:04:28.63,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:04:29.63,0:04:32.63,Default,,0000,0000,0000,,يا إلهي، تغفو في مكانٍ كهذا
Dialogue: 0,0:04:34.58,0:04:35.67,Default,,0000,0000,0000,,...أنا جائع
Dialogue: 0,0:04:35.95,0:04:38.49,Default,,0000,0000,0000,,حسناً، حسناً! سأعدّ لك شيئاً الآن
Dialogue: 0,0:04:38.49,0:04:41.62,Default,,0000,0000,0000,,عليك خلع نظّاراتك عندما تنام على الأقل
Dialogue: 0,0:04:44.23,0:04:48.61,Default,,0000,0000,0000,,هذا الوجه... رأيتُه قبلاً في الماضي
Dialogue: 0,0:04:56.39,0:04:58.68,Default,,0000,0000,0000,,مرحباً بعودتك يا ران-نيتشان
Dialogue: 0,0:04:58.68,0:04:59.46,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:58.84,0:05:00.46,Default,,0000,0000,0000,,!أ-أعيدي لي نظّاراتي
Dialogue: 0,0:05:04.05,0:05:06.88,Default,,0000,0000,0000,,بالمناسبة، أنت ترتدي النظّارات دوماً يا كونان-كن
Dialogue: 0,0:05:06.88,0:05:10.26,Default,,0000,0000,0000,,حتّى عند النوم أو الاستحمام، لمَ؟
Dialogue: 0,0:05:10.26,0:05:14.25,Default,,0000,0000,0000,,أ-أليس ذلك واضحاً؟ نظري ضعيف
Dialogue: 0,0:05:14.66,0:05:19.25,Default,,0000,0000,0000,,!و-ولا أستطيع الاسترخاء دون ارتدائها على الدوام
Dialogue: 0,0:05:21.58,0:05:23.47,Default,,0000,0000,0000,,...المعذرة
Dialogue: 0,0:05:24.15,0:05:27.26,Default,,0000,0000,0000,,أهذه وكالة موري للتحرّي؟
Dialogue: 0,0:05:27.69,0:05:29.47,Default,,0000,0000,0000,,نـ-نعم
Dialogue: 0,0:05:29.47,0:05:35.56,Default,,0000,0000,0000,,فهمت، أنتِ من قامت بإرسالها بلا خزي إذاً
Dialogue: 0,0:05:35.56,0:05:36.37,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:36.37,0:05:37.26,Default,,0000,0000,0000,,من تقصد؟
Dialogue: 0,0:05:37.26,0:05:41.76,Default,,0000,0000,0000,,.أمّك يا ران-نيتشان، كيساكي إيري-سان\Nصحيح يا عمّ؟
Dialogue: 0,0:05:42.14,0:05:46.05,Default,,0000,0000,0000,,!ماذا؟ مستحيل! طلبت أمّي مساعدتك؟
Dialogue: 0,0:05:46.05,0:05:49.22,Default,,0000,0000,0000,,!هكذا إذاً، أنتما على وفاقٍ الآن
Dialogue: 0,0:05:49.22,0:05:52.01,Default,,0000,0000,0000,,!هذا يعني أنّكما عدتما معاً بشكلٍ عام
Dialogue: 0,0:05:52.97,0:05:54.38,Default,,0000,0000,0000,,أنتِ من نصب هذا يا ران
Dialogue: 0,0:05:55.83,0:06:00.16,Default,,0000,0000,0000,,ظننتُ أنّ من الغريب أن تتّصل بي
Dialogue: 0,0:06:00.16,0:06:04.38,Default,,0000,0000,0000,,!يا إلهي، على الأطفال ألّا يتدخّلوا في مواضيع البالغين
Dialogue: 0,0:06:04.38,0:06:09.47,Default,,0000,0000,0000,,أين المشكلة في فعل هذا؟\N!أريد أن تعود أمّي بسرعة
Dialogue: 0,0:06:10.65,0:06:12.43,Default,,0000,0000,0000,,زدتِ الطين بلّة
Dialogue: 0,0:06:12.82,0:06:15.67,Default,,0000,0000,0000,,إذاً، ما طلبك؟
Dialogue: 0,0:06:16.24,0:06:17.42,On Top,,0000,0000,0000,,أجل
Dialogue: 0,0:06:16.55,0:06:22.03,CharCard,,0000,0000,0000,,{\fad(300,0)}(تسوكامو ناناي (42
Dialogue: 0,0:06:17.42,0:06:20.06,On Top,,0000,0000,0000,,إنّه عن زوجي الذي تُوفي
Dialogue: 0,0:06:20.06,0:06:21.89,On Top,,0000,0000,0000,,قبل أسبوع في الواقع
Dialogue: 0,0:06:22.19,0:06:25.13,Default,,0000,0000,0000,,تُوفي؟ أيمكن أنّه قُتل؟
Dialogue: 0,0:06:25.63,0:06:28.67,Default,,0000,0000,0000,,لا، أظنّه كان انتحاراً
Dialogue: 0,0:06:29.13,0:06:30.47,Default,,0000,0000,0000,,تظنّين؟
Dialogue: 0,0:06:30.47,0:06:31.38,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:32.13,0:06:38.21,Default,,0000,0000,0000,,في ذاك اليوم قبل أسبوع، تركتُه بمفرده\Nفي منزلنا وغادرت
Dialogue: 0,0:06:38.21,0:06:42.42,Default,,0000,0000,0000,,وعندما رجعت، لم أجده
Dialogue: 0,0:06:42.42,0:06:46.32,Default,,0000,0000,0000,,...فنزلتُ لتفقّد غرفته الخاصة في القبو من قلقي
Dialogue: 0,0:06:48.70,0:06:52.86,Default,,0000,0000,0000,,ووجدتُ جثّته الباردة على الأرض هناك
Dialogue: 0,0:06:53.85,0:06:55.21,Default,,0000,0000,0000,,...كان قد ابتلع سمّاً
Dialogue: 0,0:06:55.44,0:06:57.35,Default,,0000,0000,0000,,أيّ سمّ؟
Dialogue: 0,0:06:57.35,0:07:01.02,Default,,0000,0000,0000,,قال شرطيّ أنّه أكونيتين أو ما شابه
Dialogue: 0,0:07:01.02,0:07:03.02,Default,,0000,0000,0000,,أكونيتين؟
Dialogue: 0,0:07:03.02,0:07:05.21,Default,,0000,0000,0000,,...وفقما أذكر، فهو
Dialogue: 0,0:07:05.76,0:07:08.88,Default,,0000,0000,0000,,سمّ يسبّب إزالة الأعصاب
Dialogue: 0,0:07:09.30,0:07:12.43,Default,,0000,0000,0000,,يتمّ استخراجه من أوراق وجذور نبتة خانق الذئب
Dialogue: 0,0:07:12.43,0:07:14.50,Default,,0000,0000,0000,,اثنان ميليغرام منه تُعتبر جرعة قاتلة
Dialogue: 0,0:07:14.50,0:07:18.88,Default,,0000,0000,0000,,إنّه سمّ قويّ يؤدي للموت\Nبعد دقائق من امتصاصه
Dialogue: 0,0:07:19.25,0:07:21.13,Default,,0000,0000,0000,,لـ-لكن من أين لك بشيءٍ كهذا؟
Dialogue: 0,0:07:21.58,0:07:23.63,Default,,0000,0000,0000,,!الجبال مليئةٌ به
Dialogue: 0,0:07:24.12,0:07:28.20,Default,,0000,0000,0000,,يُستعمل خانق الذئب في الطبّ الصيني\Nبعد نزع السمّ بالطبع
Dialogue: 0,0:07:28.20,0:07:30.30,Default,,0000,0000,0000,,كلا، كنتُ أقصدك يا كونان-كن
Dialogue: 0,0:07:30.30,0:07:31.03,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:31.03,0:07:32.64,Default,,0000,0000,0000,,كيف تعرف ذلك؟
Dialogue: 0,0:07:32.91,0:07:38.65,Default,,0000,0000,0000,,الـ-التلفاز! ذكر وحش ظهر\N!في يايبا المقنّع ذلك
Dialogue: 0,0:07:38.65,0:07:43.09,Default,,0000,0000,0000,,قال "سأقتلك بهذا الأكونيتين الذي\N"استخرجتُه من نبتة خانق الذئب
Dialogue: 0,0:07:44.22,0:07:48.63,Default,,0000,0000,0000,,يا للوحش اللبق بشرحه لسمٍّ هكذا
Dialogue: 0,0:07:50.01,0:07:52.01,Default,,0000,0000,0000,,لا يوجد وحش كهذا
Dialogue: 0,0:07:52.43,0:07:56.79,Default,,0000,0000,0000,,إذاً، أكنتِ من اكتشف الجثّة بمفردك؟
Dialogue: 0,0:07:56.79,0:07:59.55,Default,,0000,0000,0000,,كلا، كنتُ مع تلامذة زوجي الثلاثة
Dialogue: 0,0:07:59.88,0:08:00.93,Default,,0000,0000,0000,,تلامذة؟
Dialogue: 0,0:08:01.71,0:08:06.08,Default,,0000,0000,0000,,في الواقع، أنا وزوجي ساحران
Dialogue: 0,0:08:06.17,0:08:10.88,On Top,,0000,0000,0000,,،زوجي بالتحديد، تسوكومو موتوياسو\N كان ساحراً مشهوراً عالمياً
Dialogue: 0,0:08:07.10,0:08:10.88,CharCard,,0000,0000,0000,,{\fad(300,0)}تسوكومو موتوياسو
Dialogue: 0,0:08:11.12,0:08:12.83,Default,,0000,0000,0000,,تسوكومو موتوياسو؟
Dialogue: 0,0:08:12.83,0:08:17.48,Default,,0000,0000,0000,,!أعرفه، لقد ظهر في الأنباء\Nقالوا أنّ ساحراً عبقرياً قد تُوفيّ
Dialogue: 0,0:08:17.48,0:08:20.73,Default,,0000,0000,0000,,كلّ ما تشاهده هو سباق الخيول يا عمّ
Dialogue: 0,0:08:20.73,0:08:25.39,Default,,0000,0000,0000,,ألا تذكر؟ ذهبنا جميعاً لمشاهدة\N!عرضه السحريّ في الماضي
Dialogue: 0,0:08:25.39,0:08:29.13,Default,,0000,0000,0000,,بالمناسبة، أظن أنّ هنالك صورةً\N!لنا مع تسوكومو-سان
Dialogue: 0,0:08:29.31,0:08:33.67,Default,,0000,0000,0000,,التقيتُ زوجتك كيساكي-سان في ذاك العرض
Dialogue: 0,0:08:33.67,0:08:35.84,Default,,0000,0000,0000,,لذا أتيتِ اليوم إذاً؟
Dialogue: 0,0:08:35.84,0:08:43.09,Default,,0000,0000,0000,,أجل، كانت كيساكي-سان مُحاميتنا مُذ آنذاك
Dialogue: 0,0:08:43.09,0:08:45.09,Default,,0000,0000,0000,,!وجدتُها! ها هي
Dialogue: 0,0:08:46.74,0:08:48.59,Default,,0000,0000,0000,,...لحظة، أيمكن أنّ هذه
Dialogue: 0,0:08:58.65,0:08:59.88,Default,,0000,0000,0000,,هل وجدتِ الصورة؟
Dialogue: 0,0:09:00.57,0:09:03.36,Default,,0000,0000,0000,,!لا! لعلّي كنت مخطئة
Dialogue: 0,0:09:04.68,0:09:07.92,Default,,0000,0000,0000,,ما رأيك بأن نسأل أولئك التلامذة الثلاثة؟
Dialogue: 0,0:09:08.93,0:09:10.49,Default,,0000,0000,0000,,هل سيكون ذلك مقبولاً؟
Dialogue: 0,0:09:10.49,0:09:11.89,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:12.35,0:09:16.67,Default,,0000,0000,0000,,الأوّل هو سانادا كازومي-كن، نجم المجموعة
Dialogue: 0,0:09:16.67,0:09:20.42,Default,,0000,0000,0000,,يُقال بأنّه من سيخلف زوجي
Dialogue: 0,0:09:20.42,0:09:24.83,Default,,0000,0000,0000,,،والثانية هي ميوشي ماكو-سان\Nإنّها صلبة الإرادة، لكن عالية الموهبة
Dialogue: 0,0:09:24.83,0:09:28.58,Default,,0000,0000,0000,,لا ساحرة في اليابان تعلوها حالياً
Dialogue: 0,0:09:28.58,0:09:30.83,Default,,0000,0000,0000,,والثالث هو موموتشي يوجي-كن
Dialogue: 0,0:09:30.83,0:09:34.44,Default,,0000,0000,0000,,،لم يمض وقت طويل مُذ أصبح تلميذاً\Nوليس ببراعة الاثنين الآخرين
Dialogue: 0,0:09:34.44,0:09:36.88,Default,,0000,0000,0000,,لكن لديه قدرة واعدة
Dialogue: 0,0:09:37.40,0:09:41.32,Default,,0000,0000,0000,,جميعهم شبّان صالحون، ويعيشون في المنزل معنا
Dialogue: 0,0:09:41.32,0:09:43.92,Default,,0000,0000,0000,,ويتمرّنون على السحر يومياً
Dialogue: 0,0:09:44.43,0:09:46.92,Default,,0000,0000,0000,,أين كان أولئك الثلاثة\Nفي ذاك اليوم إذاً؟
Dialogue: 0,0:09:47.48,0:09:50.77,Default,,0000,0000,0000,,كانوا معي في عرض عشاء\Nفي فندق بيكا
Dialogue: 0,0:09:50.77,0:09:54.09,Default,,0000,0000,0000,,يقدّمون عرض سحر للحضور
Dialogue: 0,0:09:54.09,0:09:56.51,Default,,0000,0000,0000,,،كان يُفترض أن يأتي زوجي أيضاً
Dialogue: 0,0:09:56.51,0:09:58.63,Default,,0000,0000,0000,,لكنّه قال أنّه لا يقبل الأعمال الرخيصة
Dialogue: 0,0:09:58.97,0:10:02.88,Default,,0000,0000,0000,,لكن كان أولئك الثلاثة في المنزل\Nقبل المغادرة للعرض، صحيح؟
Dialogue: 0,0:10:02.88,0:10:05.96,Default,,0000,0000,0000,,ألم تسنح لهم فرصة تسميمه إذاً؟
Dialogue: 0,0:10:05.96,0:10:07.13,Default,,0000,0000,0000,,...أ-أنت
Dialogue: 0,0:10:07.58,0:10:11.13,Default,,0000,0000,0000,,مات زوجي أثناء العرض يا فتى
Dialogue: 0,0:10:11.13,0:10:14.63,Default,,0000,0000,0000,,لكن كان بمقدور أحدهم دسّ السمّ\Nفي كبسولة وإعطاءه إيّاها
Dialogue: 0,0:10:15.28,0:10:20.07,Default,,0000,0000,0000,,في تلك الحالة، كان زوجي ليطلب المساعدة\Nبعدما لاحظ السمّ
Dialogue: 0,0:10:20.07,0:10:22.07,Default,,0000,0000,0000,,كان هناك هاتف في القبو
Dialogue: 0,0:10:22.07,0:10:24.63,Default,,0000,0000,0000,,ويمكن فتح قفل الباب من الداخل بسهولة
Dialogue: 0,0:10:24.89,0:10:26.39,Default,,0000,0000,0000,,ماذا عن الحبوب المنوّمة؟
Dialogue: 0,0:10:26.39,0:10:30.69,Default,,0000,0000,0000,,لم نجد آثار لشيءٍ كهذا\Nفي تشريح جثّته بالطبع
Dialogue: 0,0:10:30.69,0:10:35.88,Default,,0000,0000,0000,,لم تكن هناك آثار تقييد، وكانت كلّ\Nأقفال البيت موصدة
Dialogue: 0,0:10:35.88,0:10:38.63,Default,,0000,0000,0000,,ولا آثار على دخول أو خروج دخيل البتّة
Dialogue: 0,0:10:39.05,0:10:41.63,Default,,0000,0000,0000,,هذا يعني أنّه انتحار تماماً
Dialogue: 0,0:10:42.01,0:10:44.75,Default,,0000,0000,0000,,أجل، ذلك ما يبدو
Dialogue: 0,0:10:44.75,0:10:48.67,Default,,0000,0000,0000,,لكنّي لا أستطيع تصوّر إقدام زوجي على الانتحار
Dialogue: 0,0:10:48.67,0:10:50.38,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:10:51.21,0:10:56.53,Default,,0000,0000,0000,,غداً هو عيد ميلاد ابنتنا أيانو
Dialogue: 0,0:10:56.53,0:11:00.38,Default,,0000,0000,0000,,جهّز لها هديّةً من الشهر الفائت
Dialogue: 0,0:11:00.38,0:11:04.21,Default,,0000,0000,0000,,وكان يتوق لإعطائها إيّاها
Dialogue: 0,0:11:05.02,0:11:07.90,Default,,0000,0000,0000,,أيبدو لك أنّه سينتحر؟
Dialogue: 0,0:11:07.90,0:11:09.92,Default,,0000,0000,0000,,لم يكن ذاك الشيء الوحيد الغريب
Dialogue: 0,0:11:10.35,0:11:15.00,Default,,0000,0000,0000,,وجدتُ هذه على مكتبه في القبو
Dialogue: 0,0:11:16.18,0:11:18.30,Default,,0000,0000,0000,,بطاقات لعب؟
Dialogue: 0,0:11:18.30,0:11:21.72,Default,,0000,0000,0000,,آص البستونيّ والرجل ملتصقتان معاً
Dialogue: 0,0:11:22.22,0:11:27.83,Default,,0000,0000,0000,,فصلتهما الشرطة، لكن لم يكن هناك\Nشيء مكتوب في الداخل
Dialogue: 0,0:11:27.83,0:11:31.72,Default,,0000,0000,0000,,أعدتُ لصقها لأريك فقط
Dialogue: 0,0:11:32.17,0:11:34.50,Default,,0000,0000,0000,,ألم تكن هذه مجرّد حيلة سحر؟
Dialogue: 0,0:11:35.16,0:11:38.57,Default,,0000,0000,0000,,لكن لم يكن زوجي يستعمل خدع البطاقات
Dialogue: 0,0:11:38.57,0:11:41.01,Default,,0000,0000,0000,,!ولم يسبق أن رأيت حيلةً كهذه
Dialogue: 0,0:11:41.32,0:11:44.48,Default,,0000,0000,0000,,!لنذهب لمنزلها بأيّ حال
Dialogue: 0,0:11:44.48,0:11:47.73,Default,,0000,0000,0000,,أنت تقول "لنذهب" دائماً
Dialogue: 0,0:11:47.73,0:11:50.22,Default,,0000,0000,0000,,أنا سأذهب بمفردي، لا تتدخّل يا صبيّ
Dialogue: 0,0:11:50.52,0:11:53.09,Default,,0000,0000,0000,,أين المشكلة؟ خذ كونان-كن
Dialogue: 0,0:11:53.64,0:11:57.53,Default,,0000,0000,0000,,قد يفيدك، فهو يعرف الكثير من الأشياء الغريبة
Dialogue: 0,0:11:58.93,0:12:00.55,Default,,0000,0000,0000,,...أجل، لكن
Dialogue: 0,0:12:00.93,0:12:02.43,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:12:03.38,0:12:04.84,Default,,0000,0000,0000,,نـ-نعم
Dialogue: 0,0:12:04.84,0:12:07.67,Default,,0000,0000,0000,,!يا إلهي، فلتحسنا التصرّف
Dialogue: 0,0:12:07.67,0:12:09.17,Default,,0000,0000,0000,,!حاضران
Dialogue: 0,0:12:17.41,0:12:23.05,On Top,,0000,0000,0000,,...مع شينتشي في عرض سحر
Dialogue: 0,0:12:30.69,0:12:32.90,Default,,0000,0000,0000,,!يا للقصر المُبهر
Dialogue: 0,0:12:32.90,0:12:38.92,Default,,0000,0000,0000,,بالطبع، فقد كان تسوكومو موتوياسو-سان الراحل\Nساحراً مشهوراً على مستوى العالم
Dialogue: 0,0:12:39.26,0:12:40.93,Default,,0000,0000,0000,,أليس كذلك يا كونان-كن؟
Dialogue: 0,0:12:40.93,0:12:41.89,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:42.26,0:12:45.55,Default,,0000,0000,0000,,إذاً، أين القبو الذي مات فيه زوجك؟
Dialogue: 0,0:12:45.55,0:12:46.18,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:12:46.18,0:12:47.23,Default,,0000,0000,0000,,!انتظروا
Dialogue: 0,0:12:48.25,0:12:49.92,Default,,0000,0000,0000,,موموتشي-كن؟
Dialogue: 0,0:12:49.92,0:12:52.30,Default,,0000,0000,0000,,اعذريني أيّتها الآنسة
Dialogue: 0,0:12:53.41,0:12:54.79,Default,,0000,0000,0000,,أ-أنا؟
Dialogue: 0,0:12:55.74,0:12:59.03,On Top,,0000,0000,0000,,يبدو أنّك تحملين همّاً كبيراً
Dialogue: 0,0:12:56.04,0:12:59.02,CharCard,,0000,0000,0003,,{\fad(300,0)}(موموتشي يوجي (25\Nساحر
Dialogue: 0,0:12:59.26,0:13:00.23,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:00.80,0:13:03.54,Default,,0000,0000,0000,,لا جدوى من الإخفاء، يمكنني أن أعرف
Dialogue: 0,0:13:03.54,0:13:07.21,Default,,0000,0000,0000,,فلديكِ حمامةٌ في شعرك
Dialogue: 0,0:13:07.21,0:13:08.94,Default,,0000,0000,0000,,!مُذهل
Dialogue: 0,0:13:10.29,0:13:13.27,Default,,0000,0000,0000,,دورك التالي! أأنت تلميذ جديد؟
Dialogue: 0,0:13:13.27,0:13:14.91,Default,,0000,0000,0000,,ماذا؟ أنا؟
Dialogue: 0,0:13:14.91,0:13:18.07,Default,,0000,0000,0000,,كلا، إنّه المتحرّي موري كوغورو-سان
Dialogue: 0,0:13:18.07,0:13:20.49,Default,,0000,0000,0000,,ماذا؟ ذاك المتحرّي الشهير؟
Dialogue: 0,0:13:20.49,0:13:22.49,Default,,0000,0000,0000,,لكن لمَ هو هنا؟
Dialogue: 0,0:13:22.49,0:13:24.27,Default,,0000,0000,0000,,ألا تستطيع أن تعرف؟
Dialogue: 0,0:13:25.69,0:13:27.65,On Top,,0000,0000,0000,,أتى للتحرّي في موت
Dialogue: 0,0:13:25.97,0:13:29.47,CharCard,,0000,0000,0004,,{\fad(300,300)} (20) ميوشي ماكو \Nساحرة
Dialogue: 0,0:13:27.65,0:13:30.11,On Top,,0000,0000,0000,,موتوياسو-سينسي بكلّ وضوح
Dialogue: 0,0:13:30.11,0:13:30.53,On Top,,0000,0000,0000,,...أخبرني
Dialogue: 0,0:13:31.77,0:13:33.51,Default,,0000,0000,0000,,أليس ذلك صحيحاً أيّها المتحرّي؟
Dialogue: 0,0:13:33.51,0:13:34.38,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:13:34.38,0:13:35.33,Default,,0000,0000,0000,,...الصبيّ
Dialogue: 0,0:13:36.56,0:13:39.43,Default,,0000,0000,0000,,والفتاة عامرة الصدر
Dialogue: 0,0:13:39.43,0:13:40.48,Default,,0000,0000,0000,,عـ-عامرة؟
Dialogue: 0,0:13:45.60,0:13:46.70,Default,,0000,0000,0000,,...أبيض
Dialogue: 0,0:13:49.04,0:13:49.88,Default,,0000,0000,0000,,أرأيت؟
Dialogue: 0,0:13:49.88,0:13:51.03,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:51.63,0:13:54.06,Default,,0000,0000,0000,,عليك إخراج هذا القدر\Nمن الحمام على الأقل
Dialogue: 0,0:13:54.28,0:13:55.62,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:13:55.62,0:13:59.91,Default,,0000,0000,0000,,لكن ماذا يفعل متحرٍّ هنا؟ ألم يكن\Nموت سينسي انتحاراً؟
Dialogue: 0,0:13:59.91,0:14:02.65,Default,,0000,0000,0000,,لأنّه لم يكن من الصنف الذي\Nقد يُقدم على الانتحار غالباً
Dialogue: 0,0:14:03.12,0:14:06.94,Default,,0000,0000,0000,,كما هناك أمر تلك البطاقات المحيّرة وفقما أظنّ
Dialogue: 0,0:14:06.94,0:14:07.82,Default,,0000,0000,0000,,بطاقات؟
Dialogue: 0,0:14:07.82,0:14:09.40,Default,,0000,0000,0000,,هذه
Dialogue: 0,0:14:09.40,0:14:14.43,Default,,0000,0000,0000,,إنّهما بطاقتا لعب غريبتان كانتا\Nعلى مكتب القبو حيث مات زوجي
Dialogue: 0,0:14:16.10,0:14:21.14,Default,,0000,0000,0000,,فهمت، بطاقتا آص القلوب والرجل\Nاللتان كانتا ملتصقتين
Dialogue: 0,0:14:21.14,0:14:26.13,Default,,0000,0000,0000,,لكن ألم تكن هذه حيلة لعرض؟\Nكما أنّ الشرطة قالت أنّه كان انتحاراً
Dialogue: 0,0:14:26.13,0:14:30.44,Default,,0000,0000,0000,,صحيح، صحيح. لن نجد شيئاً الآن وإن قلبنا\Nالمنزل رأساً على عقب
Dialogue: 0,0:14:30.44,0:14:32.19,Default,,0000,0000,0000,,!توقّف! ما الذي تفعله؟
Dialogue: 0,0:14:32.46,0:14:34.12,On Top,,0000,0000,0000,,...ما تبقّى
Dialogue: 0,0:14:36.91,0:14:38.87,On Top,,0000,0000,0000,,...هو حقيقة كون هناك ساحراً
Dialogue: 0,0:14:37.99,0:14:41.69,CharCard,,0000,0000,0004,,{\fad(300,0)}(سانادا كازومي (27 \Nساحر
Dialogue: 0,0:14:38.87,0:14:41.69,On Top,,0000,0000,0000,,عبقريّاً واحداً بدل اثنان الآن
Dialogue: 0,0:14:41.69,0:14:44.15,Default,,0000,0000,0000,,!أيّها الوغد! مزّقت دليلاً مهمّاً
Dialogue: 0,0:14:44.15,0:14:48.61,Default,,0000,0000,0000,,لا تقلق، فالبطاقتان الحقيقيّتان\Nفي جيب معطفك
Dialogue: 0,0:14:50.82,0:14:53.64,Default,,0000,0000,0000,,...انتظر، ألم تكن
Dialogue: 0,0:14:53.97,0:14:57.97,Default,,0000,0000,0000,,إنّه ذاك الشاب! الساحر العبقريّ\Nالذي تنكّر ككايتو كيد
Dialogue: 0,0:14:57.97,0:15:02.65,Default,,0000,0000,0000,,على السفينة في حفلة الذكرى الستّين\N!لمجموعة شركات سوزوكي
Dialogue: 0,0:15:02.65,0:15:04.38,Default,,0000,0000,0000,,...ذاك
Dialogue: 0,0:15:04.38,0:15:06.51,Default,,0000,0000,0000,,أُدعى سانادا كازومي
Dialogue: 0,0:15:06.51,0:15:12.77,Default,,0000,0000,0000,,أنصحك بالمغادرة سريعاً، إلّا إذا أردت تلطيخ سمعتك
Dialogue: 0,0:15:14.54,0:15:17.70,Default,,0000,0000,0000,,لا يبدو مهتماً لحقيقة موت معلّمه في السّحر البتّة
Dialogue: 0,0:15:17.70,0:15:19.65,Default,,0000,0000,0000,,لا أظنّ ذلك
Dialogue: 0,0:15:19.95,0:15:24.69,Default,,0000,0000,0000,,انظروا، الجانب الخلفيّ للبطاقات التي\Nاستعملها الآن يحمل تصميمات مختلفة
Dialogue: 0,0:15:24.69,0:15:28.15,Default,,0000,0000,0000,,إنّه ساعٍ للمثالية، فيستحيل أن يرتكب خطأً كهذا
Dialogue: 0,0:15:28.57,0:15:33.68,Default,,0000,0000,0000,,ربما تلقّى سانادا-سان صدمةً كبيرة
Dialogue: 0,0:15:33.68,0:15:37.15,Default,,0000,0000,0000,,أجل، فقد كان يعتبر زوجي بمثابة أبيه
Dialogue: 0,0:15:37.35,0:15:39.35,Default,,0000,0000,0000,,...هؤلاء الثلاثة هم تلامذته إذاً
Dialogue: 0,0:15:39.35,0:15:40.86,Default,,0000,0000,0000,,ماذا؟ كونان-كن؟
Dialogue: 0,0:15:41.17,0:15:44.56,CharCard,,0160,0000,0004,,{\fad(300,300)\fs(24)}(تسوكومو أيانو (6\Nابنة تسوكومو موتوياسو
Dialogue: 0,0:15:41.27,0:15:43.22,On Top,,0000,0000,0000,,...أنتِ من الفصل أ
Dialogue: 0,0:15:43.22,0:15:45.88,On Top,,0000,0000,0000,,ما الذي تفعله؟ أأتيت للزيارة؟
Dialogue: 0,0:15:45.88,0:15:48.76,Default,,0000,0000,0000,,كلا، لدينا موضوع هنا
Dialogue: 0,0:15:48.76,0:15:49.65,Default,,0000,0000,0000,,أيّ موضوع؟
Dialogue: 0,0:15:49.92,0:15:53.14,Default,,0000,0000,0000,,فهمت، هذا منزلها
Dialogue: 0,0:15:54.29,0:15:59.60,Default,,0000,0000,0000,,أنا من لديه الموضوع، هو رافقني فقط يا صغيرتي
Dialogue: 0,0:16:00.62,0:16:03.20,Default,,0000,0000,0000,,في تلك الحالة، أتريد مرافقتي للتسوّق؟
Dialogue: 0,0:16:03.20,0:16:04.11,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:16:04.11,0:16:07.15,Default,,0000,0000,0000,,سأذهب مع أمّي لشراء فستان
Dialogue: 0,0:16:07.15,0:16:09.40,Default,,0000,0000,0000,,!لحفلة عيد ميلادي غداً
Dialogue: 0,0:16:09.40,0:16:12.49,Default,,0000,0000,0000,,وصلتك بطاقة دعوة أيضاً، أليس كذلك؟
Dialogue: 0,0:16:12.49,0:16:14.31,Default,,0000,0000,0000,,...أجل، بذكركِ ذلك
Dialogue: 0,0:16:14.31,0:16:16.29,Default,,0000,0000,0000,,!هيّا! لنذهب يا كونان-كن
Dialogue: 0,0:16:16.29,0:16:17.06,Default,,0000,0000,0000,,!تـ-تمهّلي
Dialogue: 0,0:16:17.06,0:16:18.57,Default,,0000,0000,0000,,لا يمكنه
Dialogue: 0,0:16:19.14,0:16:23.24,Default,,0000,0000,0000,,!آسفة، كونان-كن مشغولٌ الآن\Nفهلّا أجّلتِ الأمر؟
Dialogue: 0,0:16:23.88,0:16:26.86,Default,,0000,0000,0000,,أين المشكلة؟ ليلعب الأطفال مع بعضهم
Dialogue: 0,0:16:28.51,0:16:33.81,Default,,0000,0000,0000,,أيانو، آسفة لكنّي لا أستطيع\Nالذهاب للتسوّق اليوم أيضاً
Dialogue: 0,0:16:34.04,0:16:36.79,Default,,0000,0000,0000,,!لكنّك وعدتِني يا أمّي! كاذبة
Dialogue: 0,0:16:36.79,0:16:42.75,Default,,0000,0000,0000,,،كذلك أبي! عيد ميلادي غداً\N!لكنّه سافر خارج البلاد ولم يعد
Dialogue: 0,0:16:42.75,0:16:45.80,Default,,0000,0000,0000,,!كلّكم كاذبون! أكرهكم
Dialogue: 0,0:16:49.16,0:16:55.44,Default,,0000,0000,0000,,ما رأيك بأن ترافقيني إذاً؟ سأنسّق فستاناً\Nلك يا أيانو-تشان
Dialogue: 0,0:16:55.44,0:16:56.10,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:16:56.77,0:16:58.61,Default,,0000,0000,0000,,أعتذر على مضايقتك يا ماكو-سان
Dialogue: 0,0:17:00.02,0:17:03.14,Default,,0000,0000,0000,,حسناً جميعاً! إلى أقفاصكم
Dialogue: 0,0:17:03.89,0:17:05.06,Default,,0000,0000,0000,,هيّا بنا
Dialogue: 0,0:17:05.76,0:17:09.59,Default,,0000,0000,0000,,لم تخبريها بوفاة أبيها بعد؟
Dialogue: 0,0:17:09.59,0:17:12.78,Default,,0000,0000,0000,,كلا، أخبرتها أنّه خرج لتقديم عرضٍ خارج البلاد
Dialogue: 0,0:17:13.25,0:17:17.02,Default,,0000,0000,0000,,ماذا؟ هذه ليس حمامتي، بل حمامة ماكو-سان
Dialogue: 0,0:17:17.16,0:17:20.53,Default,,0000,0000,0000,,من الغريب أن تخطئ في حماماتها
Dialogue: 0,0:17:21.00,0:17:23.91,Default,,0000,0000,0000,,...لا بدّ أنّ موت معلّمها أثّر عليها أيضاً
Dialogue: 0,0:17:23.91,0:17:24.78,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:17:24.78,0:17:30.07,Default,,0000,0000,0000,,ويُقال أنّ السحرة بارعون في إخفاء ما بداخلهم
Dialogue: 0,0:17:30.07,0:17:33.52,Default,,0000,0000,0000,,يبدو أنّك الوحيد الذي لم يتغيّر
Dialogue: 0,0:17:33.52,0:17:36.23,Default,,0000,0000,0000,,...أنا أصبحتُ تلميذاً مؤخراً فحسب
Dialogue: 0,0:17:36.69,0:17:38.90,Default,,0000,0000,0000,,سأذهب لتجهيز العشاء إذاً
Dialogue: 0,0:17:38.90,0:17:40.73,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:17:41.02,0:17:42.90,Default,,0000,0000,0000,,أيعدّ الوجبات دوماً؟
Dialogue: 0,0:17:42.90,0:17:46.93,Default,,0000,0000,0000,,من عاداتنا أن يعدّ التلميذ الجديد الوجبات
Dialogue: 0,0:17:46.93,0:17:47.98,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:17:48.39,0:17:52.49,Default,,0000,0000,0000,,حسناً، لنذهب لرؤية القبو الذي\Nمات فيه زوجك
Dialogue: 0,0:18:10.08,0:18:13.82,Default,,0000,0000,0000,,إذاً، ما هذا القبو بالضبط؟
Dialogue: 0,0:18:13.82,0:18:16.16,Default,,0000,0000,0000,,كان غرفة زوجي الخاصّة
Dialogue: 0,0:18:16.16,0:18:20.45,Default,,0000,0000,0000,,كان يغلق على نفسه هنا دوماً\Nويبحث في صنع حيل سحرية جديدة
Dialogue: 0,0:18:20.45,0:18:23.47,Default,,0000,0000,0000,,استعمله تلامذته مؤخراً أيضاً وفقما يبدو
Dialogue: 0,0:18:23.47,0:18:24.94,Default,,0000,0000,0000,,ما تلك الصور؟
Dialogue: 0,0:18:24.94,0:18:26.86,Default,,0000,0000,0000,,لتلامذة زوجي
Dialogue: 0,0:18:26.86,0:18:31.18,Default,,0000,0000,0000,,جميعهم، من مضى في طريقه الخاص\Nومن يأس واستسلم
Dialogue: 0,0:18:31.18,0:18:35.10,Default,,0000,0000,0000,,أخبريني يا عمّة، من هو ذاك الشاب بالقبّعة السوداء؟
Dialogue: 0,0:18:35.10,0:18:36.85,Default,,0000,0000,0000,,إنّه كينوشيتا-كن
Dialogue: 0,0:18:37.76,0:18:40.72,Default,,0000,0000,0000,,كان عبقريّاً بين العباقرة
Dialogue: 0,0:18:40.72,0:18:43.63,Default,,0000,0000,0000,,لسوء الحظّ، مات في شبابه قبل 14 عاماً
Dialogue: 0,0:18:43.63,0:18:45.85,Default,,0000,0000,0000,,في حادثٍ أثناء التمرين
Dialogue: 0,0:18:46.63,0:18:47.71,Default,,0000,0000,0000,,لكن لمَ تسأل؟
Dialogue: 0,0:18:47.71,0:18:50.84,Default,,0000,0000,0000,,إنّها الصورة الوحيدة بلا غبار عليها
Dialogue: 0,0:18:50.84,0:18:52.84,Default,,0000,0000,0000,,فتساءلتُ إذا ما كان\Nأحدٌ يعتني بها
Dialogue: 0,0:18:53.62,0:18:58.89,Default,,0000,0000,0000,,معك حق... أكان زوجي؟\Nفقد كان معجباً به
Dialogue: 0,0:18:59.45,0:19:03.89,Default,,0000,0000,0000,,هنا إذاً ابتلع زوجك السمّ وسقط؟
Dialogue: 0,0:19:04.36,0:19:07.22,Default,,0000,0000,0000,,أجل، لا تزال الغرفة بنفس الحالة\Nالتي كانت عليها
Dialogue: 0,0:19:08.11,0:19:11.92,Default,,0000,0000,0000,,كانت البطاقتان بين كومة البطاقات على مكتبه
Dialogue: 0,0:19:11.92,0:19:14.14,Default,,0000,0000,0000,,كذلك الغراء الذي اُستعمل للصقهما
Dialogue: 0,0:19:20.81,0:19:23.09,Default,,0000,0000,0000,,هذا الحائط سميكٌ لحدٍّ غريب
Dialogue: 0,0:19:23.09,0:19:28.67,Default,,0000,0000,0000,,أجل، كان زوجي يحبّ الموسيقى الكلاسيكيّة\Nويستمع لها هنا دوماً
Dialogue: 0,0:19:28.67,0:19:32.10,Default,,0000,0000,0000,,جعل جدران الغرفة كاتمةً للصوت\Nبحيث يستطيع رفع الموسيقى
Dialogue: 0,0:19:32.38,0:19:37.58,Default,,0000,0000,0000,,أي أنّه لن يستطيع أحد سماع\Nأيّ صرخة في هذه الغرفة؟
Dialogue: 0,0:19:37.58,0:19:38.60,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:19:39.41,0:19:42.41,Default,,0000,0000,0000,,لكن يمكن فتح قفل الباب \Nمن الداخل بسهولة
Dialogue: 0,0:19:42.41,0:19:45.55,Default,,0000,0000,0000,,حتّى لو كان مقفلاً من الخارج
Dialogue: 0,0:19:45.98,0:19:50.53,Default,,0000,0000,0000,,كان ليخرج ويطلب المساعدة\Nلو أدرك أنّه تجرّع سمّاً
Dialogue: 0,0:19:50.53,0:19:53.30,Default,,0000,0000,0000,,...لكنّ بقاءه في هذه الغرفة
Dialogue: 0,0:19:54.06,0:19:57.56,Default,,0000,0000,0000,,يعني أنّ الانتحار كان الاحتمال المنطقيّ الوحيد
Dialogue: 0,0:19:57.56,0:19:58.31,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:19:58.31,0:19:59.81,Default,,0000,0000,0000,,أتساءل عن ذلك
Dialogue: 0,0:20:00.14,0:20:02.52,Default,,0000,0000,0000,,انظروا لرسم موضع الجثّة
Dialogue: 0,0:20:03.13,0:20:06.01,Default,,0000,0000,0000,,ذراعاه على جانبيه بوضعيّة منظمة
Dialogue: 0,0:20:06.42,0:20:09.05,Default,,0000,0000,0000,,،في التلفاز، عندما يتسمّم أحد
Dialogue: 0,0:20:09.05,0:20:12.55,Default,,0000,0000,0000,,ألا يمسك بحنجرته أو يعصر صدره هكذا؟
Dialogue: 0,0:20:12.55,0:20:15.41,Default,,0000,0000,0000,,بذكرك الأمر، قال أحد رجال الشرطة
Dialogue: 0,0:20:15.41,0:20:18.06,Default,,0000,0000,0000,,أنّ الجثّة بدت غريبة قليلاً\Nبالنسبة لضحيّة مُسمّمة
Dialogue: 0,0:20:18.50,0:20:23.24,Default,,0000,0000,0000,,عندما وجدتِ جثّته، أأنتِ متأكّدة\Nأنّه لم يكن مقيّداً؟
Dialogue: 0,0:20:23.24,0:20:24.28,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:24.28,0:20:26.14,Default,,0000,0000,0000,,،عندما وجدته مع تلامذته الثلاثة
Dialogue: 0,0:20:26.14,0:20:29.61,Default,,0000,0000,0000,,انتابنا الهلع وأسرعنا لطلب الإسعاف
Dialogue: 0,0:20:29.61,0:20:32.76,Default,,0000,0000,0000,,لكنّهم قالوا أنّه لم يستعمل أحد\Nحبالاً عليه البتّة
Dialogue: 0,0:20:33.35,0:20:36.52,Default,,0000,0000,0000,,أيمكن أنّه خُنِق بخيطٍ رفيع؟
Dialogue: 0,0:20:36.52,0:20:39.18,Default,,0000,0000,0000,,مثل الذي يُستعمل في الحيل السحرية
Dialogue: 0,0:20:39.18,0:20:42.76,Default,,0000,0000,0000,,حمقاء، حتّى لو لم تستطيعي رؤيته\Nفسيبقى أثراً
Dialogue: 0,0:20:42.76,0:20:46.51,Default,,0000,0000,0000,,وكانت الشرطة لتجده منذ وقت طويل\Nلو كان موجوداً
Dialogue: 0,0:20:48.88,0:20:50.35,Default,,0000,0000,0000,,خواتم؟
Dialogue: 0,0:20:50.80,0:20:54.54,Default,,0000,0000,0000,,أخبريني، أكان يرتدي هذه الخواتم عندما مات؟
Dialogue: 0,0:20:54.54,0:20:58.79,Default,,0000,0000,0000,,أجل، يستعمل في حيلته المفضّلة\Nخيوطاً غير مرئيّة من خواتمه
Dialogue: 0,0:20:58.79,0:21:01.50,Default,,0000,0000,0000,,لجعل الأشياء تبدو حيّة
Dialogue: 0,0:21:01.50,0:21:05.10,Default,,0000,0000,0000,,لا بدّ أنّه كان يتدرّب عليها ذاك اليوم
Dialogue: 0,0:21:05.78,0:21:09.14,Default,,0000,0000,0000,,،لكنّه كان يرتدي الخواتم فقط\Nلم تكن هناك أيّة خيوط
Dialogue: 0,0:21:09.88,0:21:11.10,Default,,0000,0000,0000,,هذا مُطمئن
Dialogue: 0,0:21:11.32,0:21:12.28,Default,,0000,0000,0000,,مُطمئن؟
Dialogue: 0,0:21:12.28,0:21:16.35,Default,,0000,0000,0000,,،أليس صحيحاً؟ إذا تشابكت الخيوط خلفه
Dialogue: 0,0:21:16.35,0:21:18.31,Default,,0000,0000,0000,,فلن يستطيع الحركة
Dialogue: 0,0:21:19.31,0:21:23.64,Default,,0000,0000,0000,,أترون؟ من الصعب النهوض عندما\Nلا تستطيع استعمال يديك
Dialogue: 0,0:21:24.18,0:21:27.09,Default,,0000,0000,0000,,وإدارة مقبض الباب ستكون صعبة كذلك بالطبع
Dialogue: 0,0:21:27.09,0:21:28.35,Default,,0000,0000,0000,,!فـ-فهمت
Dialogue: 0,0:21:28.76,0:21:32.63,Default,,0000,0000,0000,,رُبط خاتمان على يدَي زوجك\Nبخيط أو ما شابه
Dialogue: 0,0:21:32.63,0:21:34.58,Default,,0000,0000,0000,,!على إبهاميه غالباً
Dialogue: 0,0:21:34.58,0:21:38.04,Default,,0000,0000,0000,,لكنّ الدليل كان ليبقى على الجثّة
Dialogue: 0,0:21:38.04,0:21:40.21,Default,,0000,0000,0000,,،لكن بقطعك ذاك الخيط قبل قدوم الشرطة
Dialogue: 0,0:21:40.21,0:21:45.35,Default,,0000,0000,0000,,ستبدو مجرّد آثار خواتم عاديّة\N!على أصابعه وإن فحصوا الجثّة
Dialogue: 0,0:21:45.78,0:21:49.61,Default,,0000,0000,0000,,سُمّم زوجك قبل مغادرتك والتلامذة
Dialogue: 0,0:21:49.61,0:21:52.94,Default,,0000,0000,0000,,قُطع الخيط عند اكتشاف الجثّة، من قِبل أحد
Dialogue: 0,0:21:52.94,0:21:54.52,Default,,0000,0000,0000,,!استغلّ الفوضى غالباً
Dialogue: 0,0:21:54.52,0:21:56.81,Default,,0000,0000,0000,,...إذاً، أتقصد أنّ زوجي
Dialogue: 0,0:21:57.07,0:22:00.56,Default,,0000,0000,0000,,!صحيح، قُتل زوجك
Dialogue: 0,0:22:00.56,0:22:05.59,Default,,0000,0000,0000,,وعلى أيدي أحد الثلاثة اللذين\N!اكتشفوا جثّته معك
Dialogue: 0,0:22:05.59,0:22:06.81,Default,,0000,0000,0000,,...لا يُعقل
Dialogue: 0,0:22:07.05,0:22:09.93,Default,,0000,0000,0000,,ما معنى البطاقتين إذاً؟
Dialogue: 0,0:22:09.93,0:22:12.55,Default,,0000,0000,0000,,أقصد الآص والرجل اللتين كانتا موضوعتين هنا
Dialogue: 0,0:22:12.55,0:22:16.13,Default,,0000,0000,0000,,اصمتي! أنا أحاول اكتشاف ذلك
Dialogue: 0,0:22:16.13,0:22:18.92,Default,,0000,0000,0000,,كما كان يوجد هاتف في هذه الغرفة
Dialogue: 0,0:22:18.92,0:22:22.84,Default,,0000,0000,0000,,حتّى دون استعمال إبهاميه، أظنّ كان بمقدوره\Nالضغط على مفاتيح الهاتف
Dialogue: 0,0:22:23.07,0:22:25.24,Default,,0000,0000,0000,,...أجل، معكِ حقّ
Dialogue: 0,0:22:25.24,0:22:27.01,Default,,0000,0000,0000,,...المعذرة، بخصوص الهاتف
Dialogue: 0,0:22:27.95,0:22:33.06,Default,,0000,0000,0000,,عندما وجدنا جثّة زوجي، أسرعتُ للطابق العلويّ\Nمن صدمتي لطلب الإسعاف
Dialogue: 0,0:22:33.06,0:22:37.01,Default,,0000,0000,0000,,فلم أنتبه للأمر فوراً، لكن كان الهاتف\Nمدفوناً تحت البطاقات
Dialogue: 0,0:22:38.61,0:22:40.02,Default,,0000,0000,0000,,مدفوناً؟
Dialogue: 0,0:22:40.02,0:22:45.39,Default,,0000,0000,0000,,!فهمت! أخفى القاتل الهاتف كيلا يستعمله الضحيّة
Dialogue: 0,0:22:45.39,0:22:49.77,Default,,0000,0000,0000,,لكن ألن يستطيع إيجاده إن بحث كما يجب\Nإذا كانت البطاقات تغطّيه فقط؟
Dialogue: 0,0:22:49.77,0:22:51.63,Default,,0000,0000,0000,,معكِ حقّ
Dialogue: 0,0:22:52.39,0:22:54.61,Default,,0000,0000,0000,,هذا هو الهاتف
Dialogue: 0,0:22:56.67,0:22:59.54,Default,,0000,0000,0000,,!تعال يا عمّ، أرني البطاقتين
Dialogue: 0,0:22:59.54,0:23:00.23,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:23:00.79,0:23:05.03,Default,,0000,0000,0000,,أترى هذا الرمز بالهاتف؟ إنّه بنفس شكل البطاقتين
Dialogue: 0,0:23:05.68,0:23:07.43,Default,,0000,0000,0000,,...مفتاح إعادة الاتّصال
Dialogue: 0,0:23:07.43,0:23:11.45,Default,,0000,0000,0000,,فهمت! هاتان البطاقتان رسالة\Nاحتضار من زوجك
Dialogue: 0,0:23:11.45,0:23:13.97,Default,,0000,0000,0000,,!تخبرنا بضغط مفتاح إعادة الاتّصال
Dialogue: 0,0:23:14.40,0:23:17.68,Default,,0000,0000,0000,,إذا أصاب تخميني، فسيتّصل
Dialogue: 0,0:23:17.68,0:23:20.90,Default,,0000,0000,0000,,بشخصٍ ترك زوجك رسالةً معه
Dialogue: 0,0:23:23.85,0:23:27.01,Default,,0000,0000,0000,,هذا الرقم غير مستعمل حالياً
Dialogue: 0,0:23:27.01,0:23:27.68,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:23:27.68,0:23:32.51,Default,,0000,0000,0000,,وجدت الشرطة ذاك الرقم أيضاً، لكنّه كان عابثاً
Dialogue: 0,0:23:32.51,0:23:34.93,Default,,0000,0000,0000,,فاعتقدنا أنّ ابنتي من لعبت به
Dialogue: 0,0:23:35.50,0:23:36.43,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:23:36.96,0:23:38.93,Default,,0000,0000,0000,,ما هذه الأرقام؟
Dialogue: 0,0:23:39.34,0:23:41.89,Default,,0000,0000,0000,,يا ولد، ما الذي تكتبه؟
Dialogue: 0,0:23:43.54,0:23:45.46,Default,,0000,0000,0000,,ما هذه؟ شفرة؟
Dialogue: 0,0:23:46.37,0:23:49.28,Default,,0000,0000,0000,,واحد اثنان ستّة ثمانية سبعة واحد\N...ثلاثة اثنان أربعة ثمانية تسعة
Dialogue: 0,0:23:50.12,0:23:51.23,Default,,0000,0000,0000,,!لا تعترضه
Dialogue: 0,0:23:52.45,0:23:54.09,Default,,0000,0000,0000,,أعترض من؟
Dialogue: 0,0:24:00.36,0:24:04.30,Default,,0000,0000,0000,,...انتظر! أيمكن أنّ المعنى وراء هذه الأرقام
Dialogue: 0,0:24:08.22,0:24:12.96,Default,,0000,0000,0000,,!هكذا إذاً! فهمت سرّ هذه الشفرة
Dialogue: 0,0:24:13.39,0:24:16.64,Default,,0000,0000,0000,,...في تلك الحالة، لا بدّ أنّ معناها
Dialogue: 0,0:24:16.64,0:24:19.22,Default,,0000,0000,0000,,!كلا! نفد الرصاص
Dialogue: 0,0:24:19.22,0:24:20.97,Default,,0000,0000,0000,,ألديكِ قلم؟
Dialogue: 0,0:24:20.97,0:24:23.47,Default,,0000,0000,0000,,يوجد قلم حبر في المكتب\Nإذا كان ذلك يناسبك
Dialogue: 0,0:24:24.50,0:24:28.55,Default,,0000,0000,0000,,هذا غريب... كان زوجي يحتفظ به هنا دوماً
Dialogue: 0,0:24:28.55,0:24:31.06,Default,,0000,0000,0000,,حتّى أقلامه الملوّنة التي\Nيستعملها في حيله قد اختفت
Dialogue: 0,0:24:31.06,0:24:33.79,Default,,0000,0000,0000,,إلى متى ستظلّ تحدّق في هذه الأرقام؟
Dialogue: 0,0:24:33.79,0:24:37.18,Default,,0000,0000,0000,,الشرطة محقّة، كان عبث الابنة فقط
Dialogue: 0,0:24:37.74,0:24:40.70,Default,,0000,0000,0000,,اصطحبتُ ابنتنا للعرض ذاك اليوم
Dialogue: 0,0:24:40.70,0:24:44.34,Default,,0000,0000,0000,,فافترضنا أنّها ضربت تلك الأرقام قبل ذلك
Dialogue: 0,0:24:44.73,0:24:50.35,Default,,0000,0000,0000,,ما يعني أنّ زوجك لم يستعمل\Nهذا الهاتف في ذاك اليوم لسببٍ ما
Dialogue: 0,0:24:50.86,0:24:51.86,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:24:51.86,0:24:57.68,Default,,0000,0000,0000,,سمّم القاتل الضحيّة قبل مغادرة الجميع، أليس كذلك؟
Dialogue: 0,0:24:57.68,0:25:04.17,Default,,0000,0000,0000,,أجل، باستعمال كبسولة بدأت التحلّل\Nأثناء العرض غالباً
Dialogue: 0,0:25:04.17,0:25:08.51,Default,,0000,0000,0000,,في تلك الحالة، بقي الضحيّة مُحتجزاً في هذه\Nالغرفة طوال الوقت، صحيح؟
Dialogue: 0,0:25:08.51,0:25:12.46,Default,,0000,0000,0000,,كنتُ لأفكّر بترك دليلٍ يقود\N...للقاتل لو كنتُ مكانه
Dialogue: 0,0:25:12.46,0:25:16.41,Default,,0000,0000,0000,,لكن لعلّه لم يستطع، فلا أقلام في هذه الغرفة
Dialogue: 0,0:25:16.41,0:25:18.93,Default,,0000,0000,0000,,...الموجود هذا الهاتف فقط
Dialogue: 0,0:25:19.41,0:25:24.38,Default,,0000,0000,0000,,،أحمق، إذا استعمل الضحيّة الهاتف\Nكان ليطلب النجدة
Dialogue: 0,0:25:24.38,0:25:28.43,Default,,0000,0000,0000,,صحيح، أشكّ أنّ سلك الهاتف كان\Nمفصولاً وما شابه
Dialogue: 0,0:25:28.43,0:25:30.07,Default,,0000,0000,0000,,سـ-سلك الهاتف؟
Dialogue: 0,0:25:31.18,0:25:32.32,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:25:32.32,0:25:36.89,Default,,0000,0000,0000,,احتجز القاتل زوجكِ هنا\N!بعدما فصل سلك الهاتف
Dialogue: 0,0:25:36.89,0:25:40.98,Default,,0000,0000,0000,,ثمّ أعاد ربطه باستغلال الفوضى\N!أثناء اكتشاف الجثّة
Dialogue: 0,0:25:40.98,0:25:42.39,Default,,0000,0000,0000,,...لكنّ ذلك
Dialogue: 0,0:25:42.39,0:25:45.26,Default,,0000,0000,0000,,،كل الثلاثة المشتبه بهم سحرة
Dialogue: 0,0:25:45.26,0:25:49.09,Default,,0000,0000,0000,,يمكنهم تنفيذ شيء كهذا\Nدون لفت الأنظار
Dialogue: 0,0:25:49.09,0:25:52.39,Default,,0000,0000,0000,,أخفى القاتل الهاتف بالبطاقات أيضاً
Dialogue: 0,0:25:52.75,0:25:54.04,Default,,0000,0000,0000,,،عندما اُكتشفت الجثّة
Dialogue: 0,0:25:54.04,0:25:58.79,Default,,0000,0000,0000,,كان ليُفضح أنّ الهاتف مفصول\Nإذا جرّب أحد استعماله
Dialogue: 0,0:25:58.79,0:26:03.40,Default,,0000,0000,0000,,،وزوجك المُسمّم والمحتجز في الغرفة
Dialogue: 0,0:26:03.40,0:26:05.88,Default,,0000,0000,0000,,أراد ترك دليل على هويّة الفاعل
Dialogue: 0,0:26:06.61,0:26:10.89,Default,,0000,0000,0000,,لكن اختفت الأقلام، والهاتف مفصول
Dialogue: 0,0:26:10.89,0:26:16.48,Default,,0000,0000,0000,,خياره الوحيد كان استعمال مفتاح\Nإعادة الاتّصال لترك رسالة
Dialogue: 0,0:26:16.48,0:26:22.19,Default,,0000,0000,0000,,حتّى وإن كان مفصولاً، ستُحفظ الأرقام\Nطالما هناك كهرباء
Dialogue: 0,0:26:22.19,0:26:28.89,Default,,0000,0000,0000,,وتلميحاً لذلك، ترك البطاقتين على المكتب
Dialogue: 0,0:26:28.89,0:26:31.47,Default,,0000,0000,0000,,كان زوجي من أدخل تلك الأرقام بالفعل إذاً؟
Dialogue: 0,0:26:31.47,0:26:35.42,Default,,0000,0000,0000,,أجل، أعاد إخفاء الهاتف بالبطاقات
Dialogue: 0,0:26:35.42,0:26:40.62,Default,,0000,0000,0000,,لأنّ استعمال أحدٍ له بعد اكتشافه لجثّته\Nسيمحو الرقم الذي سجّله
Dialogue: 0,0:26:40.62,0:26:46.03,Default,,0000,0000,0000,,كما أنّ القاتل قد يتخلّص من الهاتف\Nإذا لفتَ الأنظار كثيراً
Dialogue: 0,0:26:46.03,0:26:49.47,Default,,0000,0000,0000,,ما تبقّى هو حلّ رسالة\N...الأرقام الغريبة هذه فقط، لكن
Dialogue: 0,0:26:49.47,0:26:50.91,Default,,0000,0000,0000,,...لذا طلبتُ
Dialogue: 0,0:26:50.91,0:26:52.08,Default,,0000,0000,0000,,!هاك
Dialogue: 0,0:26:53.69,0:26:56.98,Default,,0000,0000,0000,,إنّه قلمي، أردت كتابة شيء، صحيح؟
Dialogue: 0,0:26:56.98,0:26:57.72,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:26:58.27,0:27:01.94,Default,,0000,0000,0000,,هكذا إذاً، أدركتَ شيئاً مثيراً من جديد
Dialogue: 0,0:27:01.94,0:27:03.67,Default,,0000,0000,0000,,أيمكنك أن تخبرنا؟
Dialogue: 0,0:27:04.01,0:27:10.84,Default,,0000,0000,0000,,لـ-ليس بالأمر المهمّ، لكن انظروا لمجموعة\Nالأرقام الأولى هذه
Dialogue: 0,0:27:10.84,0:27:15.46,Default,,0000,0000,0000,,واحد واثنان وستّة وثمانية وسبعة وواحد
Dialogue: 0,0:27:15.46,0:27:18.30,Default,,0000,0000,0000,,بمفردها لا تحمل معنى
Dialogue: 0,0:27:18.67,0:27:24.78,Default,,0000,0000,0000,,لكن إذا ربطت مفاتيح واحد واثنان وستّة\Nوثمانية وسبعة وواحد على الهاتف
Dialogue: 0,0:27:24.78,0:27:27.30,Default,,0000,0000,0000,,!ستحصل على شكلٍ غريب
Dialogue: 0,0:27:27.66,0:27:28.76,Default,,0000,0000,0000,,!دي
Dialogue: 0,0:27:29.37,0:27:31.26,Default,,0000,0000,0000,,!إنّه حرف دي في الإنجليزية
Dialogue: 0,0:27:32.28,0:27:33.94,Default,,0000,0000,0000,,يُدعى ذلك بـ دي إذاً؟
Dialogue: 0,0:27:33.94,0:27:38.74,Default,,0000,0000,0000,,انتظر، المجموعة التالية إذاً: ثلاثة واثنان\N!وأربعة وثمانية وتسعة هي سي
Dialogue: 0,0:27:39.73,0:27:46.55,Default,,0000,0000,0000,,فهمت! تسلسل الأرقام هذا\N!يشكّل أربعة أحرف
Dialogue: 0,0:27:46.55,0:27:53.50,Default,,0000,0000,0000,,بإضافة مجموعة 1-3-5-4-8\N...ومجموعة 1-3-9-7 سنرى
Dialogue: 0,0:27:53.50,0:27:56.74,Default,,0000,0000,0000,,!الرسالة التي تركها زوجك قبيل موته
Dialogue: 0,0:27:59.42,0:28:01.51,Default,,0000,0000,0000,,دي سي ماكو"؟"
Dialogue: 0,0:28:01.51,0:28:03.95,Default,,0000,0000,0000,,ماكو؟ أيمكن أنّها ماكو-سان؟
Dialogue: 0,0:28:03.95,0:28:05.74,Default,,0000,0000,0000,,أجل، غالباً
Dialogue: 0,0:28:05.74,0:28:08.24,Default,,0000,0000,0000,,أهي من قتل زوجي إذاً؟
Dialogue: 0,0:28:08.24,0:28:11.16,Default,,0000,0000,0000,,كلا، لا يكفي هذا للجزم
Dialogue: 0,0:28:11.16,0:28:14.80,Default,,0000,0000,0000,,قد تكون رسالةً تركها لماكو-سان
Dialogue: 0,0:28:15.15,0:28:18.61,Default,,0000,0000,0000,,...ولا نعرف ما معنى "دي سي" قبل ماكو
Dialogue: 0,0:28:18.61,0:28:22.80,Default,,0000,0000,0000,,أنت مذهل حقّاً لمعرفة ذلك\N!من مجرّد أرقام غريبة
Dialogue: 0,0:28:22.80,0:28:23.85,Default,,0000,0000,0000,,!مُبهر
Dialogue: 0,0:28:23.85,0:28:26.20,Default,,0000,0000,0000,,أجل، مُبهر
Dialogue: 0,0:28:27.97,0:28:30.06,Default,,0000,0000,0000,,!أنت مُبهر يا أبي! استنتاج عظيم
Dialogue: 0,0:28:30.56,0:28:33.55,Default,,0000,0000,0000,,!لم يكن شيئاً يُذكر
Dialogue: 0,0:28:36.55,0:28:37.37,Default,,0000,0000,0000,,...ران
Dialogue: 0,0:28:38.96,0:28:41.96,Default,,0000,0000,0000,,لكن ما "دي سي" هذه؟
Dialogue: 0,0:28:41.96,0:28:46.62,Default,,0000,0000,0000,,دي سي التي أعرفها هي علامة دي سي التجارية\N...واختصار واشنطن العاصمة
Dialogue: 0,0:28:46.62,0:28:48.22,Default,,0000,0000,0000,,...التيّار المستمرّ
Dialogue: 0,0:28:48.70,0:28:49.72,Default,,0000,0000,0000,,!دا كابو
Dialogue: 0,0:28:50.83,0:28:54.53,Default,,0000,0000,0000,,تعرفان، تجدان "دي س" في القطع الموسيقية كثيراً
Dialogue: 0,0:28:54.53,0:28:56.55,Default,,0000,0000,0000,,"تُقرأ "دا كابو
Dialogue: 0,0:28:56.55,0:29:00.78,Default,,0000,0000,0000,,بالمناسبة، كان زوجي يعزف على البيانو \Nمن حينٍ لآخر
Dialogue: 0,0:29:00.78,0:29:03.05,Default,,0000,0000,0000,,فأظنّه كان يقرأ القطع الموسيقية كثيراً
Dialogue: 0,0:29:03.47,0:29:06.56,Default,,0000,0000,0000,,أخبريني، ما معنى "دا كابو"؟
Dialogue: 0,0:29:06.56,0:29:09.39,Default,,0000,0000,0000,,أي ترجع للبداية وتعيد الكرّة
Dialogue: 0,0:29:09.39,0:29:11.56,Default,,0000,0000,0000,,تـ-تعيد الكرّة؟
Dialogue: 0,0:29:11.89,0:29:15.01,Default,,0000,0000,0000,,ألم تغادر ماكو-سان مع ابنتك؟
Dialogue: 0,0:29:15.01,0:29:17.01,Default,,0000,0000,0000,,بلى، لشراء الثياب
Dialogue: 0,0:29:17.01,0:29:18.97,Default,,0000,0000,0000,,!أيمكنك الاتّصال بها فوراً؟
Dialogue: 0,0:29:18.97,0:29:23.12,Default,,0000,0000,0000,,أجل، يمكنني، فلديها جهاز مناداة
Dialogue: 0,0:29:26.97,0:29:32.78,Default,,0000,0000,0000,,هذا من أمّك، لعلّها تريد عودتك سريعاً
Dialogue: 0,0:29:32.78,0:29:36.47,Default,,0000,0000,0000,,!ماذا؟ لكنّي أريد البقاء معك أكثر
Dialogue: 0,0:29:36.86,0:29:40.22,Default,,0000,0000,0000,,فنحن متّجهتان لمكانٍ مسلٍّ كثيراً الآن، صحيح؟
Dialogue: 0,0:29:40.49,0:29:42.71,Default,,0000,0000,0000,,أجل، سأصطحبك هناك
Dialogue: 0,0:29:44.14,0:29:46.61,Default,,0000,0000,0000,,لمكانٍ أروع حتّى
Dialogue: 0,0:29:47.72,0:29:50.68,Default,,0000,0000,0000,,...ماذا؟ تنوي ماكو-سان
Dialogue: 0,0:29:50.68,0:29:53.80,Default,,0000,0000,0000,,أجل، تنوي قتل ابنتك غالباً
Dialogue: 0,0:29:53.80,0:29:56.38,Default,,0000,0000,0000,,دي سي ماكو" التي تركها زوجك
Dialogue: 0,0:29:56.38,0:30:00.30,Default,,0000,0000,0000,,تعني أنّ ماكو-سان ستكرر جريمتها غالباً
Dialogue: 0,0:30:00.30,0:30:01.38,Default,,0000,0000,0000,,...لا يُعقل
Dialogue: 0,0:30:01.38,0:30:04.34,Default,,0000,0000,0000,,!بأيّ حال، استدعي التلميذين الآخرين فوراً
Dialogue: 0,0:30:04.71,0:30:06.59,Default,,0000,0000,0000,,!سننفصل ونبحث عنهما
Dialogue: 0,0:30:12.95,0:30:17.95,Default,,0000,0000,0000,,!أيانو! ماكو-سان! أين أنتما؟ أيانو
Dialogue: 0,0:30:17.95,0:30:19.14,Default,,0000,0000,0000,,!أيانو-تشان
Dialogue: 0,0:30:19.70,0:30:21.45,Default,,0000,0000,0000,,!أيانو
Dialogue: 0,0:30:21.45,0:30:23.51,Default,,0000,0000,0000,,!أيانو-تشان
Dialogue: 0,0:30:25.44,0:30:26.77,Default,,0000,0000,0000,,...لا جدوى
Dialogue: 0,0:30:28.44,0:30:29.76,Default,,0000,0000,0000,,تبّاً، لا أستطيع إيجادها
Dialogue: 0,0:30:30.81,0:30:31.61,Default,,0000,0000,0000,,ماذا عنكم؟
Dialogue: 0,0:30:31.61,0:30:33.51,Default,,0000,0000,0000,,لا، لم نجدها بأيّ مكان
Dialogue: 0,0:30:33.51,0:30:36.51,Default,,0000,0000,0000,,...يبدو أنّ علينا الاستعانة بالشرطة للبحث
Dialogue: 0,0:30:36.51,0:30:39.01,Default,,0000,0000,0000,,لكن لمَ قد تقتل ماكو-سان زوجي؟
Dialogue: 0,0:30:39.01,0:30:42.02,Default,,0000,0000,0000,,للأمر علاقة بذاك الرجل غالباً
Dialogue: 0,0:30:42.42,0:30:47.80,Default,,0000,0000,0000,,أقصد صاحب القبّعة السوداء \Nفي الصورة التي كانت في الغرفة
Dialogue: 0,0:30:47.80,0:30:50.31,Default,,0000,0000,0000,,...كان كينوشيتا يوشيرو بالفعل إذاً
Dialogue: 0,0:30:50.31,0:30:54.91,Default,,0000,0000,0000,,كـ-كينوشيتا؟ أتقصد الساحر العبقريّ\Nالذي مات قبل 14 عاماً؟
Dialogue: 0,0:30:54.91,0:30:57.55,Default,,0000,0000,0000,,ما قصدك "بالفعل" يا سانادا-كن؟
Dialogue: 0,0:30:57.55,0:31:01.43,Default,,0000,0000,0000,,رأيتُها عندما نزلتُ للقبو في إحدى الليالي
Dialogue: 0,0:31:02.11,0:31:05.69,Default,,0000,0000,0000,,كانت ماكو تحتضن تلك الصورة باهتمام
Dialogue: 0,0:31:05.69,0:31:08.80,Default,,0000,0000,0000,,اشتبهتُ بأمر، لكن لم يخطر لي \Nأن تُقدم على القتل
Dialogue: 0,0:31:10.35,0:31:12.97,Default,,0000,0000,0000,,مع ذلك، يا لي من بائس
Dialogue: 0,0:31:12.97,0:31:15.68,Default,,0000,0000,0000,,،رغم أنّي فُزعت عندما وجدنا الجثّة
Dialogue: 0,0:31:15.68,0:31:20.93,Default,,0000,0000,0000,,لم أرَ ماكو تقطع الخيط على خواتم سينسي أمامي\Nأو تعيد ربط سلك الهاتف
Dialogue: 0,0:31:20.93,0:31:22.67,Default,,0000,0000,0000,,عجباً
Dialogue: 0,0:31:25.96,0:31:27.39,Default,,0000,0000,0000,,كشفتم أمري؟
Dialogue: 0,0:31:27.63,0:31:29.00,Default,,0000,0000,0000,,ماكو-سان؟
Dialogue: 0,0:31:29.00,0:31:29.89,Default,,0000,0000,0000,,!أيانو
Dialogue: 0,0:31:30.79,0:31:31.51,Default,,0000,0000,0000,,!أيانو
Dialogue: 0,0:31:31.51,0:31:34.51,Default,,0000,0000,0000,,لا تقلقي، إنّها نائمة فحسب
Dialogue: 0,0:31:36.24,0:31:40.37,Default,,0000,0000,0000,,كنتُ سأجعلها تنام لوقتٍ\Nأطول بكثير في الواقع
Dialogue: 0,0:31:40.37,0:31:41.51,Default,,0000,0000,0000,,مثل أخي
Dialogue: 0,0:31:42.48,0:31:43.51,Default,,0000,0000,0000,,أخوك؟
Dialogue: 0,0:31:43.51,0:31:47.77,Default,,0000,0000,0000,,أجل، كينوشيتا يوشيرو الذي\Nكنتم تتكلّمون عنه للتوّ
Dialogue: 0,0:31:47.77,0:31:50.65,Default,,0000,0000,0000,,كان أخي الذي يكبرني بأربعة عشر عاماً
Dialogue: 0,0:31:50.65,0:31:56.39,Default,,0000,0000,0000,,في ربيعه العشرين فقط، تلقّى كل تشريف\Nيمكن أن يحصل عليه ساحر
Dialogue: 0,0:31:56.39,0:32:03.09,Default,,0000,0000,0000,,وكان العائلة الوحيدة الغالية لي\Nبعدما تُوفي والدانا في صغرنا
Dialogue: 0,0:32:03.09,0:32:08.04,Default,,0000,0000,0000,,!لكنّ ذاك الرجل قضى على أخي كحشرة
Dialogue: 0,0:32:08.04,0:32:11.77,Default,,0000,0000,0000,,تسوكومو موتوياسو الذي كان يغار من موهبته
Dialogue: 0,0:32:12.37,0:32:15.12,Default,,0000,0000,0000,,...لا يُعقل، يستحيل أنّ زوجي
Dialogue: 0,0:32:15.12,0:32:18.37,Default,,0000,0000,0000,,ليست كذبة، رأيتُه بأم عينيّ
Dialogue: 0,0:32:18.37,0:32:22.07,Default,,0000,0000,0000,,في ذاك اليوم قبل 14 عاماً، عبث ذاك الرجل بالأصفاد
Dialogue: 0,0:32:22.07,0:32:24.26,Default,,0000,0000,0000,,التي استعملها أخي في عروضه
Dialogue: 0,0:32:24.73,0:32:28.98,Default,,0000,0000,0000,,بعد ذلك فوراً، غرق أخي ولقي حتفه\Nفي تمرين خزّان الماء
Dialogue: 0,0:32:28.98,0:32:31.00,Default,,0000,0000,0000,,لأنّ أصفاده لم تكن قابلة للخلع
Dialogue: 0,0:32:33.89,0:32:39.47,Default,,0000,0000,0000,,تم إقفال القضيّة بأنّها حادثة أثناء التمرين بالطبع
Dialogue: 0,0:32:39.47,0:32:45.47,Default,,0000,0000,0000,,فهمت، أصبحتِ تلميذةٍ لديه\Nكي تأخذي بثأر أخيك إذاً
Dialogue: 0,0:32:45.47,0:32:49.71,Default,,0000,0000,0000,,،أجل، تغيّر اسمي الأخير عندما تبنّاني أقارب
Dialogue: 0,0:32:49.71,0:32:52.46,Default,,0000,0000,0000,,فلم يدرك ذلك الرجل أبداً غالباً
Dialogue: 0,0:32:52.87,0:32:57.20,Default,,0000,0000,0000,,قُتل أخي في عيد ميلادي السابع
Dialogue: 0,0:32:57.20,0:33:00.17,Default,,0000,0000,0000,,عيد الميلاد الذي أصبحتُ بعده بمفردي للآن
Dialogue: 0,0:33:00.81,0:33:05.79,Default,,0000,0000,0000,,لذا قتلته قبل أن تبلغ ابنته السابعة
Dialogue: 0,0:33:07.03,0:33:10.15,Default,,0000,0000,0000,,كشفتُ هويّتي له بعدما جعلته يتناول السمّ
Dialogue: 0,0:33:10.15,0:33:16.31,Default,,0000,0000,0000,,لكنّه بدا هادئاً مع ذلك، فهدّدتُه بقتل ابنته أيضاً
Dialogue: 0,0:33:16.31,0:33:19.30,Default,,0000,0000,0000,,...عندها فقد تماسكه فجأةً
Dialogue: 0,0:33:19.30,0:33:25.17,Default,,0000,0000,0000,,!آسف! كانت تلك الطريقة الوحيدة لحماية مكانتي
Dialogue: 0,0:33:25.17,0:33:28.43,Default,,0000,0000,0000,,!يمكنك أخذ حياتي، لا تورّطي ابنتي فقط
Dialogue: 0,0:33:29.17,0:33:34.04,Default,,0000,0000,0000,,،كما قلت، نويتُ قتل ابنته\N لكنّني غيّرت رأيي بعدها
Dialogue: 0,0:33:34.04,0:33:36.75,Default,,0000,0000,0000,,لذا هي لا ذنب لها
Dialogue: 0,0:33:37.75,0:33:40.25,Default,,0000,0000,0000,,كان رجلاً ساذجاً مع ذلك
Dialogue: 0,0:33:40.25,0:33:46.65,Default,,0000,0000,0000,,سمح لي بربط خاتميه معاً\Nكي أريه حيلةً جديدة دون أن يشكّ
Dialogue: 0,0:33:46.65,0:33:49.86,Default,,0000,0000,0000,,وابتلع كبسولة السمّ دون أن ينتبه
Dialogue: 0,0:33:51.65,0:33:54.43,Default,,0000,0000,0000,,!هذا يثير الضحك بالنسبة لأعظم ساحر في اليابان
Dialogue: 0,0:33:54.43,0:33:56.01,Default,,0000,0000,0000,,ذلك ليس صحيحاً يا ماكو
Dialogue: 0,0:33:57.56,0:34:01.77,Default,,0000,0000,0000,,أدرك سينسي أنّكِ ستقتلينه
Dialogue: 0,0:34:01.77,0:34:04.47,Default,,0000,0000,0000,,!تـ-تكذب
Dialogue: 0,0:34:04.47,0:34:09.42,Default,,0000,0000,0000,,أخبرتُك، رأيتك تحتضنين صورة أخيك في القبو
Dialogue: 0,0:34:09.42,0:34:11.72,Default,,0000,0000,0000,,كان سينسي معي وقتها
Dialogue: 0,0:34:12.41,0:34:18.26,Default,,0000,0000,0000,,"ثم أخبرني بالتالي: "لا تكشف الأمر حتّى يحين الوقت
Dialogue: 0,0:34:19.04,0:34:24.45,Default,,0000,0000,0000,,لكنّكِ فزتِ يا ماكو، خدعت حيلتك الشرطة بالكامل
Dialogue: 0,0:34:24.45,0:34:30.26,Default,,0000,0000,0000,,ورسالة الاحتضار التي تركها لن تنفع\Nكدليلٍ في هذه المرحلة
Dialogue: 0,0:34:31.45,0:34:37.19,Default,,0000,0000,0000,,لا تسخر منّي، لا نيّة لي بصعود المسرح\Nبعدما كُشفت حيلتي
Dialogue: 0,0:34:37.19,0:34:41.26,Default,,0000,0000,0000,,سأذهب للشرطة الآن وأسدل ستار عرضي بنفسي
Dialogue: 0,0:34:41.93,0:34:47.51,Default,,0000,0000,0000,,كما أتحمّل ذنب جعل أيانو-تشان\Nتمرّ بما مررتُ به في حياتي
Dialogue: 0,0:34:51.09,0:34:55.13,Default,,0000,0000,0000,,بعد ذلك، أخذنا ماكو-سان للشرطة
Dialogue: 0,0:34:55.46,0:35:00.12,Default,,0000,0000,0000,,وكان يُفترض أن نرجع لوكالة التحرّي\Nلعشاء متأخّر تعدّه ران
Dialogue: 0,0:35:01.87,0:35:04.84,Default,,0000,0000,0000,,تجاوزت الساعة الثانية العشرة
Dialogue: 0,0:35:04.84,0:35:06.87,Default,,0000,0000,0000,,...أتضوّر جوعاً
Dialogue: 0,0:35:10.16,0:35:13.84,Default,,0000,0000,0000,,!كلا! نسيتُ شراء مكوّنات العشاء
Dialogue: 0,0:35:15.19,0:35:19.69,Default,,0000,0000,0000,,لا تقلق! سأذهب لشراء شيء\N!من متجر التموينات مع كونان-كن
Dialogue: 0,0:35:19.69,0:35:23.17,Default,,0000,0000,0000,,لا تتأخّري، سأنتظر
Dialogue: 0,0:35:24.43,0:35:29.47,Default,,0000,0000,0000,,ران-نيتشان، هذا ليس الطريق\Nإلى متجر التموينات
Dialogue: 0,0:35:29.84,0:35:34.01,Default,,0000,0000,0000,,إذا ضللنا الطريق، فعلينا العودة إلى \Nوكالة التحرّي أولاً
Dialogue: 0,0:35:34.54,0:35:37.01,Default,,0000,0000,0000,,...صحيح، علينا العودة
Dialogue: 0,0:35:37.01,0:35:41.06,On Top,,0000,0000,0000,,كودو
Dialogue: 0,0:35:38.71,0:35:39.88,Default,,0000,0000,0000,,إلى منزلك
Dialogue: 0,0:35:44.07,0:35:48.22,Default,,0000,0000,0000,,!ما-ما الذي تقولينه؟ هذا منزل شينتشي-نيتشان
Dialogue: 0,0:35:48.22,0:35:49.81,Default,,0000,0000,0000,,!لستِ منطقيّة
Dialogue: 0,0:35:50.74,0:35:55.76,Default,,0000,0000,0000,,فهمت، هكذا خدعتنا حتّى الآن
Dialogue: 0,0:35:56.73,0:35:58.26,Default,,0000,0000,0000,,...ألستُ محقّة
Dialogue: 0,0:35:59.36,0:36:00.37,Default,,0000,0000,0000,,يا شينتشي؟
Dialogue: 0,0:36:19.84,0:36:22.00,Default,,0000,0000,0000,,أنت شينتشي، صحيح؟
Dialogue: 0,0:36:24.50,0:36:28.78,Default,,0000,0000,0000,,!ما-ما الذي تقولينه؟ يستحيل أنّي شينتشي-نيتشان
Dialogue: 0,0:36:28.78,0:36:30.83,Default,,0000,0000,0000,,!لا، لا شكّ في الأمر
Dialogue: 0,0:36:30.83,0:36:35.94,Default,,0000,0000,0000,,!قدرة الاستنتاج وحنكة التصرّف\N!كما ضعف معرفتك الموسيقية
Dialogue: 0,0:36:35.94,0:36:37.65,Default,,0000,0000,0000,,!أنت تطابقه
Dialogue: 0,0:36:37.65,0:36:40.21,Default,,0000,0000,0000,,!لكن انظري بإمعان! أنا طفل
Dialogue: 0,0:36:40.65,0:36:44.25,Default,,0000,0000,0000,,لعلّك تجرّعت عقاراً غريباً صنعه\N!البروفسور آغاسا وما شابه
Dialogue: 0,0:36:44.25,0:36:47.17,Default,,0000,0000,0000,,!يا للتوافق
Dialogue: 0,0:36:47.64,0:36:54.88,Default,,0000,0000,0000,,كفّ عن التظاهر! لديّ الكثير مما\N!أريد قوله لك
Dialogue: 0,0:36:56.34,0:36:57.88,Default,,0000,0000,0000,,...تبّاً
Dialogue: 0,0:36:58.46,0:37:00.38,Default,,0000,0000,0000,,ألديكِ دليل؟
Dialogue: 0,0:37:00.80,0:37:03.83,Default,,0000,0000,0000,,لا تتفوّهي بأمور غريبة دون دليل
Dialogue: 0,0:37:05.16,0:37:06.83,Default,,0000,0000,0000,,يوجد دليلٌ هنا
Dialogue: 0,0:37:10.80,0:37:14.50,Default,,0000,0000,0000,,!انظر وتعجّب! لم يسبق ورأيتُ شبيهاً مثلك
Dialogue: 0,0:37:14.94,0:37:16.48,Default,,0000,0000,0000,,...لـ-لكنّ ذلك
Dialogue: 0,0:37:16.48,0:37:19.69,Default,,0000,0000,0000,,!هيّا، لتعترف يا شينتشي
Dialogue: 0,0:37:19.69,0:37:21.26,Default,,0000,0000,0000,,!عجباً، ران-تشان
Dialogue: 0,0:37:23.83,0:37:27.33,Default,,0000,0000,0000,,لمَ أنتِ أمام منزلنا في هذا الوقت المتأخّر؟
Dialogue: 0,0:37:27.81,0:37:33.00,Default,,0000,0000,0000,,أمّ شينتشي-كن؟ متى رجعتِ من لوس آنجلس؟
Dialogue: 0,0:37:33.00,0:37:35.92,Default,,0000,0000,0000,,للتوّ، استقللتُ الرحلة الأخيرة
Dialogue: 0,0:37:35.92,0:37:38.50,Default,,0000,0000,0000,,طرأت بعض الأمور
Dialogue: 0,0:37:38.50,0:37:43.00,Default,,0000,0000,0000,,...تبّاً! إذا تفوّهت أمّي بشيءٍ فاضح الآن
Dialogue: 0,0:37:43.45,0:37:45.50,Default,,0000,0000,0000,,ماذا؟ من ذاك؟
Dialogue: 0,0:37:46.79,0:37:49.71,Default,,0000,0000,0000,,...توقيت ممتاز، لنطلب من أمّك بالولادة
Dialogue: 0,0:37:51.21,0:37:53.08,Default,,0000,0000,0000,,!أن تتحقّق منك
Dialogue: 0,0:37:58.90,0:37:59.88,Default,,0000,0000,0000,,!عجبي
Dialogue: 0,0:38:00.36,0:38:03.37,Default,,0000,0000,0000,,!إنّه كونان-تشان! مضى وقتٌ طويل
Dialogue: 0,0:38:03.73,0:38:06.02,Default,,0000,0000,0000,,تـ-تعرفينه؟
Dialogue: 0,0:38:06.02,0:38:06.73,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:38:06.73,0:38:11.87,Default,,0000,0000,0000,,!فهو حفيد عمّ قريب ابنة أخ جدّي
Dialogue: 0,0:38:12.30,0:38:15.80,Default,,0000,0000,0000,,لكنّه يقول أنّه ابن أحد أقرباء البروفسور آغاسا
Dialogue: 0,0:38:15.80,0:38:19.88,Default,,0000,0000,0000,,أجل، أنا والبروفسور قريبان بعيدان
Dialogue: 0,0:38:19.88,0:38:23.75,Default,,0000,0000,0000,,لكن ألا ترين أنّه يشبه شينتشي\Nكثيراً في صغره؟
Dialogue: 0,0:38:23.75,0:38:27.88,Default,,0000,0000,0000,,تظنّين ذلك؟ يبدو كونان-كن ألطف بكثير لي
Dialogue: 0,0:38:28.21,0:38:30.79,Default,,0000,0000,0000,,اسم أمّك كان فوميو-سان، صحيح؟
Dialogue: 0,0:38:30.79,0:38:31.63,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:38:33.53,0:38:35.08,Default,,0000,0000,0000,,تبدو خدعة
Dialogue: 0,0:38:36.40,0:38:41.70,Default,,0000,0000,0000,,كيفما نظرت للأمر، من الغريب جدّاً أن يستطيع\N!طالب في الابتدائيّة الاستنتاج بتلك الدقّة
Dialogue: 0,0:38:42.02,0:38:45.60,Default,,0000,0000,0000,,!لا-لا بدّ أنّه استنبط الكثير من شينتشي
Dialogue: 0,0:38:45.60,0:38:47.71,Default,,0000,0000,0000,,!فقد كان يأتي لزيارتنا كثيراً
Dialogue: 0,0:38:47.71,0:38:50.19,Default,,0000,0000,0000,,كان يزور شينتشي؟
Dialogue: 0,0:38:50.19,0:38:50.97,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:38:50.97,0:38:53.25,Default,,0000,0000,0000,,!أحبّ شينتشي-نيتشان كثيراً
Dialogue: 0,0:38:53.72,0:38:55.75,Default,,0000,0000,0000,,...مع ذلك
Dialogue: 0,0:38:56.22,0:39:01.75,Default,,0000,0000,0000,,.ران-تشان، فكّري بالأمر مليّاً\Nأتظنّين شينتشي قد يفعل شيئاً كهذا؟
Dialogue: 0,0:39:03.33,0:39:05.25,Default,,0000,0000,0000,,أنتِ مخيفة يا ران-نيتشان
Dialogue: 0,0:39:05.25,0:39:07.59,Default,,0000,0000,0000,,أنتِ مخيفة يا ران-نيتشان
Dialogue: 0,0:39:15.41,0:39:19.78,Default,,0000,0000,0000,,آسفة يا كونان-كن! أسأتُ الفهم مجدداً وفقما يبدو
Dialogue: 0,0:39:19.78,0:39:21.95,Default,,0000,0000,0000,,انسَ كلّ ما قلتُه الآن
Dialogue: 0,0:39:22.94,0:39:25.15,Default,,0000,0000,0000,,!سأعدّ لك هامبرغر لذيذ اعتذاراً
Dialogue: 0,0:39:25.15,0:39:25.73,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:39:25.73,0:39:27.31,Default,,0000,0000,0000,,!انتظري
Dialogue: 0,0:39:27.31,0:39:30.44,Default,,0000,0000,0000,,أيمكنك تركه لديّ ليومين أو ثلاثة؟
Dialogue: 0,0:39:30.44,0:39:34.68,Default,,0000,0000,0000,,تبدأ عطلتي غداً، ولم أتكلّم معه لوقتٍ طويل
Dialogue: 0,0:39:37.05,0:39:38.96,Default,,0000,0000,0000,,حسناً، لا بأس
Dialogue: 0,0:39:39.68,0:39:41.34,Default,,0000,0000,0000,,!أراك لاحقاً إذاً يا كونان-كن
Dialogue: 0,0:39:43.46,0:39:44.46,Default,,0000,0000,0000,,!عمتما مساءً
Dialogue: 0,0:39:44.46,0:39:46.29,Default,,0000,0000,0000,,!عمتِ مساءً يا ران-نيتشان
Dialogue: 0,0:39:46.29,0:39:47.71,Default,,0000,0000,0000,,!توخّي الحذر
Dialogue: 0,0:39:52.91,0:39:55.78,Default,,0000,0000,0000,,إذاً، لمَ عدتِ؟
Dialogue: 0,0:39:55.78,0:39:59.13,Default,,0000,0000,0000,,لا تخبريني أنّ شجارك مع أبي\Nظهيرة اليوم كان السبب
Dialogue: 0,0:39:59.62,0:40:03.06,Default,,0000,0000,0000,,ماذا؟ أهكذا تخاطب من أنقذت حياتك؟
Dialogue: 0,0:40:03.06,0:40:04.61,Default,,0000,0000,0000,,أنقذت حياتي؟
Dialogue: 0,0:40:04.61,0:40:06.63,Default,,0000,0000,0000,,سمعتُ من البروفسور آغاسا
Dialogue: 0,0:40:07.25,0:40:10.02,Default,,0000,0000,0000,,!أنّك استحممت مع ران-تشان
Dialogue: 0,0:40:10.02,0:40:11.56,Default,,0000,0000,0000,,لو لم أتستّر عليك، من يدري ما كانت
Dialogue: 0,0:40:11.56,0:40:14.54,Default,,0000,0000,0000,,!لتفعله لك بالكاراتيه
Dialogue: 0,0:40:18.51,0:40:19.68,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:40:22.46,0:40:26.12,Default,,0000,0000,0000,,بأيّ حال، آمل أنّك أخبرتِ أبي بقدومك هنا
Dialogue: 0,0:40:26.42,0:40:28.09,Default,,0000,0000,0000,,بالطبع لم أفعل
Dialogue: 0,0:40:28.09,0:40:29.50,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:40:29.50,0:40:33.62,Default,,0000,0000,0000,,لا بأس، سأعيش معك لفترة
Dialogue: 0,0:40:33.62,0:40:36.24,Default,,0000,0000,0000,,يا إلهي، لا تورّطاني
Dialogue: 0,0:40:36.24,0:40:39.72,Default,,0000,0000,0000,,...لكنّي عندما أكون مع شين-تشان الصغير
Dialogue: 0,0:40:39.72,0:40:42.75,Default,,0000,0000,0000,,!أشعر بالشباب مجدداً
Dialogue: 0,0:40:48.23,0:40:51.74,Default,,0000,0000,0000,,!هيّا، لتأكل العشاء مع أمّك
Dialogue: 0,0:40:53.06,0:40:54.67,Default,,0000,0000,0000,,!دعيني
Dialogue: 0,0:41:22.44,0:41:23.68,Default,,0000,0000,0000,,ماذا؟ أين أنا؟
Dialogue: 0,0:41:23.68,0:41:26.07,Default,,0000,0000,0000,,استيقظت يا شين-تشان؟
Dialogue: 0,0:41:26.44,0:41:27.86,Default,,0000,0000,0000,,!أ-أمّي
Dialogue: 0,0:41:27.86,0:41:31.68,Default,,0000,0000,0000,,رجعتُ لليابان لأنّ لديّ موضوعاً \Nأهتمّ به هنا أيضاً
Dialogue: 0,0:41:31.68,0:41:33.27,Default,,0000,0000,0000,,أيّ موضوع؟
Dialogue: 0,0:41:33.62,0:41:34.73,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:41:41.02,0:41:42.44,Default,,0000,0000,0000,,!يوكي-تشان
Dialogue: 0,0:41:42.44,0:41:44.46,On Top,,0000,0000,0000,,!أتيتِ إذاً
Dialogue: 0,0:41:42.44,0:41:46.19,CharCard,,0000,0000,0004,,(يابوتشي هيرومي (37\Nزميلة يوكيكو القديمة
Dialogue: 0,0:41:44.46,0:41:46.19,On Top,,0000,0000,0000,,!لا بدّ أنّ أشغالك كثيرة! شكراً
Dialogue: 0,0:41:46.63,0:41:49.30,Default,,0000,0000,0000,,سآتي من أقاصي الأرض
Dialogue: 0,0:41:49.30,0:41:51.83,Default,,0000,0000,0000,,!لمساعدة صديقة طفولتي هيرومي
Dialogue: 0,0:41:51.83,0:41:54.37,Default,,0000,0000,0000,,ماذا؟ أين يوساكو-سان وشينتشي-كن؟
Dialogue: 0,0:41:55.18,0:42:00.95,Default,,0000,0000,0000,,إنّهما مشغولان، لكن لا تقلقي\Nفقد أحضرتُ هذا الصبيّ مكانهما
Dialogue: 0,0:42:00.95,0:42:02.73,Default,,0000,0000,0000,,...ماذا؟ أيمكن أنّه
Dialogue: 0,0:42:02.73,0:42:06.99,Default,,0000,0000,0000,,أجل، ابني الثاني الذي أنجبتُه\N!في لوس آنجلس، كونان
Dialogue: 0,0:42:06.99,0:42:07.99,Default,,0000,0000,0000,,!مهلك
Dialogue: 0,0:42:07.99,0:42:10.32,Default,,0000,0000,0000,,!إنّه طفل، لكنّه حاد الذكاء
Dialogue: 0,0:42:10.74,0:42:14.48,Default,,0000,0000,0000,,!لا بدّ أنّك وزوجك على وفاق إذاً
Dialogue: 0,0:42:14.48,0:42:15.32,Default,,0000,0000,0000,,نوعاً ما
Dialogue: 0,0:42:17.98,0:42:22.01,Default,,0000,0000,0000,,إذاً، ما الذي أردتِ منّي النظر فيه؟
Dialogue: 0,0:42:22.01,0:42:23.65,Default,,0000,0000,0000,,...في الواقع
Dialogue: 0,0:42:24.01,0:42:26.92,Default,,0000,0000,0000,,ماذا؟ ضيوف يا هيرومي-سان؟
Dialogue: 0,0:42:26.92,0:42:28.57,Default,,0000,0000,0000,,!عمّي يوشيفوسا
Dialogue: 0,0:42:29.26,0:42:33.21,Default,,0000,0000,0000,,هذه يوكيكو-سان التي كانت تأتي\Nلزيارتنا كثيراً في صغرنا
Dialogue: 0,0:42:33.21,0:42:35.00,Default,,0000,0000,0000,,!تسرّني رؤيتك مُجدداً
Dialogue: 0,0:42:36.23,0:42:39.33,On Top,,0000,0000,0000,,للأسف، لا أتذكّرها
Dialogue: 0,0:42:36.44,0:42:40.73,CharCard,,0000,0000,0004,,{\fad(200,200)}(يابوتشي يوشيفوسا (64\Nعمّ هيرومي
Dialogue: 0,0:42:39.33,0:42:41.94,On Top,,0000,0000,0000,,فقد عشتُ لوقتٍ طويل في البرازيل
Dialogue: 0,0:42:42.08,0:42:43.10,On Top,,0000,0000,0000,,..لا بأس
Dialogue: 0,0:42:44.32,0:42:46.86,Default,,0000,0000,0000,,لتأخذي راحتك
Dialogue: 0,0:42:46.86,0:42:49.17,Default,,0000,0000,0000,,حسناً، هيّا بنا يا كارلوس
Dialogue: 0,0:42:49.29,0:42:51.49,CharCard,,0000,0000,0004,,{\fad(200,200)}(كارلوس (26\Nصديق يابوتشي يوشيفوسا
Dialogue: 0,0:42:53.02,0:42:54.27,Default,,0000,0000,0000,,كـ-كارلوس؟
Dialogue: 0,0:42:54.77,0:42:59.14,Default,,0000,0000,0000,,يقول عمّي يوشيفوسا أنّه صديق\Nجلبه من البرازيل
Dialogue: 0,0:43:00.81,0:43:04.43,Default,,0000,0000,0000,,أخبريني، كيف بدا عمّي يوشيفوسا لك؟
Dialogue: 0,0:43:04.43,0:43:05.26,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:43:05.26,0:43:07.78,Default,,0000,0000,0000,,...ملامحه مثلاً، أو صوته أو ما استشعرتِه منه
Dialogue: 0,0:43:08.26,0:43:13.00,Default,,0000,0000,0000,,حسناً، كنّا نلعب معه كثيراً
Dialogue: 0,0:43:13.00,0:43:16.53,Default,,0000,0000,0000,,...لكنّه ذهب للبرازيل قبل دخولي المدرسة الابتدائيّة، لذا
Dialogue: 0,0:43:16.75,0:43:20.46,Default,,0000,0000,0000,,أيمكن أنّ العمّ يوشيفوسا هو من\Nأردتِ منّي التحرّي في شأنه؟
Dialogue: 0,0:43:20.46,0:43:24.28,Default,,0000,0000,0000,,أجل، رجع من البرازيل قبل ثلاثة أيام
Dialogue: 0,0:43:24.28,0:43:27.99,Default,,0000,0000,0000,,لكنّه يبدو لي مختلفاً عن السابق
Dialogue: 0,0:43:28.36,0:43:34.69,Default,,0000,0000,0000,,لمَ لا تريه لوالدك إذاً؟ أليس هو شقيقه الصغير؟
Dialogue: 0,0:43:34.69,0:43:36.48,Default,,0000,0000,0000,,لا أستطيع
Dialogue: 0,0:43:37.19,0:43:42.02,Default,,0000,0000,0000,,...تُوفي والدي يوشيتشيكا بالسرطان الشهر الفائت
Dialogue: 0,0:43:42.02,0:43:43.84,Default,,0000,0000,0000,,بالـ-بالسرطان؟
Dialogue: 0,0:43:43.84,0:43:47.09,Default,,0000,0000,0000,,أجل، تُوفيت والدتي قبل 15 عاماً
Dialogue: 0,0:43:47.09,0:43:51.28,Default,,0000,0000,0000,,ومات كلّ أصدقاء عمّي يوشيفوسا باكراً لسوء الحظّ
Dialogue: 0,0:43:51.92,0:43:57.42,Default,,0000,0000,0000,,لذا نحن الوحيدتان اللتان التقيتاه عدّة مرّات
Dialogue: 0,0:43:57.42,0:44:00.54,Default,,0000,0000,0000,,لكن لمَ تشتبهين به؟
Dialogue: 0,0:44:00.54,0:44:02.03,Default,,0000,0000,0000,,الميراث
Dialogue: 0,0:44:02.03,0:44:03.27,Default,,0000,0000,0000,,!عزيزي
Dialogue: 0,0:44:03.35,0:44:05.39,On Top,,0000,0000,0000,,الجميع يشكّون
Dialogue: 0,0:44:03.35,0:44:11.31,CharCard,,0000,0000,0004,,{\fad(0,00)}(يابوتشي هيديكاسو (41\N(زوج هيرومي (صهر
Dialogue: 0,0:44:05.39,0:44:09.64,On Top,,0000,0000,0000,,بأنّ ذاك العجوز قد يكون مدّعياً
Dialogue: 0,0:44:09.64,0:44:11.31,On Top,,0000,0000,0000,,يسعى وراء ميراث أبيها
Dialogue: 0,0:44:11.76,0:44:17.17,Default,,0000,0000,0000,,كان يمتلك كلّ الأراضي في هذه المنطقة، وميراثه كبير
Dialogue: 0,0:44:17.17,0:44:21.31,Default,,0000,0000,0000,,قال المحامي أنّه ترك وصيّة
Dialogue: 0,0:44:21.87,0:44:29.30,Default,,0000,0000,0000,,وأنّ كلّ من يتغيّب عن قراءتها\Nلن يحصل على ينّ واحد
Dialogue: 0,0:44:29.95,0:44:33.40,Default,,0000,0000,0000,,متى ستُقرأ إذاً؟
Dialogue: 0,0:44:33.40,0:44:36.30,Default,,0000,0000,0000,,العاشرة مساء الغد عندما ينتهي الحِداد
Dialogue: 0,0:44:36.30,0:44:37.86,On Top,,0000,0000,0000,,ما يعني أنّ علينا خلع قناع
Dialogue: 0,0:44:36.65,0:44:40.54,CharCard,,0000,0000,0004,,{\fad(300,300)}(يابوتشي يوشيوكي (32\Nشقيق هيرومي
Dialogue: 0,0:44:37.86,0:44:40.61,On Top,,0000,0000,0000,,ذاك العجوز قبل ذاك الوقت
Dialogue: 0,0:44:41.11,0:44:44.30,CharCard,,0220,0000,0004,,{\fad(300,00)}(يابوتشي كيكو (28\Nزوجة يوشيوكي
Dialogue: 0,0:44:41.11,0:44:44.30,On Top,,0000,0000,0000,,وإلّا ستتقلّص حصّتنا
Dialogue: 0,0:44:44.30,0:44:48.18,On Top,,0000,0000,0000,,ربما لن تتقلّص فحسب
Dialogue: 0,0:44:44.30,0:44:51.96,CharCard,,0000,0000,0004,,(يابوتشي ماتشيكو (39\Nزوجة يوشيتشيكا الثانية
Dialogue: 0,0:44:48.18,0:44:51.96,On Top,,0000,0000,0000,,اعتماداً على محتوى الوصيّة، قد لا نحصل على شيء
Dialogue: 0,0:44:51.96,0:44:55.72,Default,,0000,0000,0000,,بأيّ حال، علينا فعل شيءٍ قبل ليلة الغد
Dialogue: 0,0:44:56.22,0:44:59.22,Default,,0000,0000,0000,,من أين انبثق هؤلاء؟
Dialogue: 0,0:45:01.71,0:45:02.67,Default,,0000,0000,0000,,!يا إلهي
Dialogue: 0,0:45:03.87,0:45:06.87,Default,,0000,0000,0000,,لا توجد أيّ صور قديمة؟
Dialogue: 0,0:45:06.87,0:45:12.46,Default,,0000,0000,0000,,يبدو أنّ عمّي يوشيفوسا أخذها \Nكلّها معه عندما ذهب للبرازيل
Dialogue: 0,0:45:15.70,0:45:18.46,Default,,0000,0000,0000,,أيمكن أنّ هذا هو؟
Dialogue: 0,0:45:19.15,0:45:21.85,Default,,0000,0000,0000,,انظري، أنتِ وصديقتك في الصورة أيضاً
Dialogue: 0,0:45:21.85,0:45:23.26,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:45:24.57,0:45:27.14,Default,,0000,0000,0000,,!إنّه هو! الرجل في المنتصف
Dialogue: 0,0:45:27.14,0:45:29.26,Default,,0000,0000,0000,,!إنه العمّ يوشيفوسا بلا شكّ
Dialogue: 0,0:45:29.56,0:45:33.09,Default,,0000,0000,0000,,لكنّه يافع جدّاً فقد لا تفيدنا
Dialogue: 0,0:45:33.09,0:45:35.26,Default,,0000,0000,0000,,كما أنّه يرتدي قبعة
Dialogue: 0,0:45:35.93,0:45:37.76,Default,,0000,0000,0000,,!لكن يُعيد لي هذا الذكريات
Dialogue: 0,0:45:37.76,0:45:40.60,Default,,0000,0000,0000,,!إنّها من بطولة البلدة لكرة القاعدة
Dialogue: 0,0:45:41.29,0:45:47.00,Default,,0000,0000,0000,,أتذكرين؟ تأذّت رجل عمّي في البطولة\Nبعدما أصابتها مسنّنات حذاء أحد الراكضين
Dialogue: 0,0:45:47.00,0:45:50.60,Default,,0000,0000,0000,,صحيح، نُقل للمشفى وتلقّى عدّة غرز
Dialogue: 0,0:45:51.61,0:45:54.57,Default,,0000,0000,0000,,ألا يُفترض أنّ الندبات باقية إذاً؟
Dialogue: 0,0:45:56.88,0:45:59.16,Default,,0000,0000,0000,,!هيرومي! بالتوفيق
Dialogue: 0,0:45:59.16,0:45:59.89,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:46:01.48,0:46:03.98,Default,,0000,0000,0000,,عمّي، هل تريد شاياً؟
Dialogue: 0,0:46:03.98,0:46:05.26,Default,,0000,0000,0000,,...شكراً
Dialogue: 0,0:46:06.98,0:46:07.78,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:46:07.78,0:46:09.60,Default,,0000,0000,0000,,...آسفة! سأنظّف فوراً
Dialogue: 0,0:46:10.65,0:46:11.67,Default,,0000,0000,0000,,!ليست موجودة
Dialogue: 0,0:46:11.67,0:46:13.43,Default,,0000,0000,0000,,!الندبة ليست موجودة
Dialogue: 0,0:46:13.43,0:46:14.29,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:46:14.29,0:46:15.63,Default,,0000,0000,0000,,ندبة؟
Dialogue: 0,0:46:17.03,0:46:19.14,Default,,0000,0000,0000,,أتقصدين هذه؟
Dialogue: 0,0:46:21.55,0:46:26.25,Default,,0000,0000,0000,,أصابني راكض عندما اندفع بمسنّنات حذائه\Nعلى القاعدة الأولى
Dialogue: 0,0:46:26.25,0:46:30.05,Default,,0000,0000,0000,,في مباراة كرة قاعدة قبل ثلاثين عاماً
Dialogue: 0,0:46:30.31,0:46:33.45,Default,,0000,0000,0000,,ماذا؟ لديه ندبة
Dialogue: 0,0:46:33.45,0:46:35.05,Default,,0000,0000,0000,,أي أنّه الحقيقيّ
Dialogue: 0,0:46:36.12,0:46:38.74,Default,,0000,0000,0000,,اشتبهتم بي بالفعل إذاً؟
Dialogue: 0,0:46:38.74,0:46:42.52,Default,,0000,0000,0000,,!كان أخي محقّاً! لا أحد مُحترم هنا
Dialogue: 0,0:46:42.52,0:46:45.05,Default,,0000,0000,0000,,!أصبتُ بجلب كارلوس معي
Dialogue: 0,0:46:45.05,0:46:46.05,Default,,0000,0000,0000,,أصبت؟
Dialogue: 0,0:46:46.05,0:46:49.80,Default,,0000,0000,0000,,!إنّه حارس شخصيّ عيّنتُه في البرازيل
Dialogue: 0,0:46:49.80,0:46:50.73,Default,,0000,0000,0000,,...حا
Dialogue: 0,0:46:50.73,0:46:52.05,Default,,0000,0000,0000,,حارس شخصيّ؟
Dialogue: 0,0:46:52.60,0:46:54.64,Default,,0000,0000,0000,,لمَ قد تحتاجه؟
Dialogue: 0,0:46:54.64,0:46:59.65,Default,,0000,0000,0000,,بالطبع سأعيّنه، خصوصاً بعد تلقّي رسالة كهذه
Dialogue: 0,0:47:00.47,0:47:02.25,Default,,0000,0000,0000,,،لا ميراث لك"
Dialogue: 0,0:47:02.25,0:47:04.55,Default,,0000,0000,0000,,"إذا كنت تقدّر حياتك فلا ترجع
Dialogue: 0,0:47:04.55,0:47:06.13,Default,,0000,0000,0000,,!حـ-حياتك؟
Dialogue: 0,0:47:36.81,0:47:38.79,Default,,0000,0000,0000,,متى وصلتك هذه الرسالة؟
Dialogue: 0,0:47:38.79,0:47:43.82,Default,,0000,0000,0000,,قبل شهر، أُرسلت لمنزلي في البرازيل
Dialogue: 0,0:47:43.82,0:47:47.13,Default,,0000,0000,0000,,لم تتضمن اسم المُرسل بالطبع
Dialogue: 0,0:47:48.36,0:47:53.12,Default,,0000,0000,0000,,لم أهتمّ بميراث أخي، لكنّي أردت رؤية أوجه
Dialogue: 0,0:47:53.48,0:47:58.13,Default,,0000,0000,0000,,السُذّج اللذين أرسلوا رسالةً كهذه
Dialogue: 0,0:47:58.52,0:48:00.13,Default,,0000,0000,0000,,السُذّج؟
Dialogue: 0,0:48:00.39,0:48:03.80,Default,,0000,0000,0000,,!هيّا، إذا انتهيتم فاخرجوا من هذه الغرفة
Dialogue: 0,0:48:03.80,0:48:06.13,Default,,0000,0000,0000,,يا عمّ، هلّا علّمتني رموز الكانجي؟
Dialogue: 0,0:48:07.26,0:48:10.13,Default,,0000,0000,0000,,رفضت أمّي مساعدتي
Dialogue: 0,0:48:10.13,0:48:10.96,Default,,0000,0000,0000,,...أنت يا شين
Dialogue: 0,0:48:11.62,0:48:13.62,Default,,0000,0000,0000,,!أقصد، يا كونان-تشان
Dialogue: 0,0:48:13.62,0:48:16.32,Default,,0000,0000,0000,,كيف تكتب "عام جديد سعيد"؟
Dialogue: 0,0:48:19.71,0:48:21.75,Default,,0000,0000,0000,,!أ-أعسر؟
Dialogue: 0,0:48:23.84,0:48:25.57,Default,,0000,0000,0000,,أرأيتِ ذلك يا أختي؟
Dialogue: 0,0:48:25.57,0:48:30.03,Default,,0000,0000,0000,,أجل، لكنّي لا أذكر إذا كان\Nعمّي أعسر أم لا
Dialogue: 0,0:48:30.03,0:48:31.75,Default,,0000,0000,0000,,أتذكرين يا يوكي-تشان؟
Dialogue: 0,0:48:31.75,0:48:33.44,Default,,0000,0000,0000,,البتّة
Dialogue: 0,0:48:33.44,0:48:40.01,Default,,0000,0000,0000,,،لكنّه يحمل الندبة على ساقه\Nفأظنّه العمّ يوشيفوسا نفسه
Dialogue: 0,0:48:40.44,0:48:42.89,Default,,0000,0000,0000,,كلا، ربما سمع من أحدهم
Dialogue: 0,0:48:42.89,0:48:48.01,Default,,0000,0000,0000,,ولجأ لندبة قديمة في ساقه\Nصادف أنّه أُصيب بها
Dialogue: 0,0:48:48.01,0:48:50.31,Default,,0000,0000,0000,,ذاك العجوز مزيّف إذاً؟
Dialogue: 0,0:48:50.31,0:48:52.83,Default,,0000,0000,0000,,أظنّه حقيقيّاً
Dialogue: 0,0:48:53.17,0:48:57.50,Default,,0000,0000,0000,,انظروا لصورة العمّ يوشيفوسا\Nالتي وجدناها في السقيفة
Dialogue: 0,0:48:58.17,0:49:03.00,Default,,0000,0000,0000,,أترون؟ يرتدي قفّازه على يده اليمنى\Nمما يُثبت أنّه أعسر
Dialogue: 0,0:49:03.70,0:49:04.78,Default,,0000,0000,0000,,...معك حقّ
Dialogue: 0,0:49:04.78,0:49:07.09,Default,,0000,0000,0000,,كما أنّ خطّه نفسه
Dialogue: 0,0:49:07.09,0:49:07.79,Default,,0000,0000,0000,,خطّه؟
Dialogue: 0,0:49:07.79,0:49:11.36,Default,,0000,0000,0000,,وجدتُ هذه البطاقة البريدية مع الصورة
Dialogue: 0,0:49:08.33,0:49:19.63,On Top,,0000,0000,0000,,عام جديد سعيد
Dialogue: 0,0:49:11.36,0:49:16.23,Default,,0000,0000,0000,,بطاقة تهنئة بالعام الجديد أرسلها\Nالعمّ يوشيفوسا عندما كان في البرازيل
Dialogue: 0,0:49:16.23,0:49:19.63,Default,,0000,0000,0000,,انظروا، خطّه مطابق للتي كتبها قبل قليل
Dialogue: 0,0:49:19.98,0:49:24.89,Default,,0000,0000,0000,,أيمكن أنّك طلبت منه كتابة\Nالرموز كي تتحقق من هذا؟
Dialogue: 0,0:49:24.89,0:49:27.64,Default,,0000,0000,0000,,،كما يُتوقع من ابن كودو يوساكو
Dialogue: 0,0:49:27.64,0:49:29.70,Default,,0000,0000,0000,,مؤلف روايات التحرّي المشهور عالمياً
Dialogue: 0,0:49:31.29,0:49:34.99,Default,,0000,0000,0000,,!إنّه ابني! ابني أنا
Dialogue: 0,0:49:35.52,0:49:36.75,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:49:39.13,0:49:40.17,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:49:41.20,0:49:43.59,Default,,0000,0000,0000,,لا يزال البئر القديم موجوداً هنا؟
Dialogue: 0,0:49:44.75,0:49:46.70,Default,,0000,0000,0000,,...حتّى بعد تلك الحادثة
Dialogue: 0,0:49:46.70,0:49:47.70,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:49:47.70,0:49:49.25,Default,,0000,0000,0000,,حادثة؟
Dialogue: 0,0:49:49.25,0:49:51.57,Default,,0000,0000,0000,,سقطت أمّي فيه وماتت
Dialogue: 0,0:49:53.11,0:49:58.61,Default,,0000,0000,0000,,اختفت فجأةً في إحدى الأيام قبل 15 عاماً\Nفي يومٍ غزير الثلج
Dialogue: 0,0:49:58.61,0:50:01.01,Default,,0000,0000,0000,,بحثنا عنها جميعاً، لكنّنا لم نجدها
Dialogue: 0,0:50:01.01,0:50:04.01,Default,,0000,0000,0000,,،وفي الصباح التالي، عندما كنّا على وشك الاتّصال بالشرطة
Dialogue: 0,0:50:04.01,0:50:07.79,Default,,0000,0000,0000,,وجدناها ميتةً في البئر
Dialogue: 0,0:50:08.72,0:50:11.42,Default,,0000,0000,0000,,،كنّا سنزيل البئر بما أنّه خطر
Dialogue: 0,0:50:11.42,0:50:17.80,Default,,0000,0000,0000,,لكن طلب أبي إبقاءه حتّى يفارق الحياة\Nكيلا ينساها
Dialogue: 0,0:50:18.67,0:50:21.99,Default,,0000,0000,0000,,لذا يوجد سور حوله؟
Dialogue: 0,0:50:21.99,0:50:26.75,Default,,0000,0000,0000,,ثبّتُه بنفسي، كيلا يسقط أحد مُجدداً
Dialogue: 0,0:50:26.99,0:50:31.19,Default,,0000,0000,0000,,لكنّ المشكلة ظهرت في الجنازة قبلها
Dialogue: 0,0:50:31.19,0:50:32.25,Default,,0000,0000,0000,,في الجنازة؟
Dialogue: 0,0:50:32.25,0:50:35.82,Default,,0000,0000,0000,,أثار أخو أمّي جلبةً فجأةً
Dialogue: 0,0:50:35.82,0:50:39.80,Default,,0000,0000,0000,,!وادّعى أنّ أحدنا أسقطها
Dialogue: 0,0:50:39.80,0:50:41.71,Default,,0000,0000,0000,,ماذا حصل في الواقع؟
Dialogue: 0,0:50:42.43,0:50:46.43,Default,,0000,0000,0000,,كان السبب شجرة الكاميليا
Dialogue: 0,0:50:46.43,0:50:49.71,Default,,0000,0000,0000,,التي زرعها عمّنا كهديّة زفاف لوالدينا
Dialogue: 0,0:50:49.93,0:50:51.46,Default,,0000,0000,0000,,الكاميليا؟
Dialogue: 0,0:50:51.46,0:50:54.05,Default,,0000,0000,0000,,يقصد الساسانكوا بجوار البئر
Dialogue: 0,0:50:54.05,0:50:59.46,Default,,0000,0000,0000,,وقفت أمّي على طرف البئر لقطف زهرة، لكنّها انزلقت
Dialogue: 0,0:50:59.67,0:51:05.16,Default,,0000,0000,0000,,أرادت أن ترينا إيّاها، فقد كانت تحبّ تلك الأزهار كثيراً
Dialogue: 0,0:51:05.16,0:51:09.12,Default,,0000,0000,0000,,،نادراً ما تفتّحت في شتاء ذاك العام
Dialogue: 0,0:51:09.12,0:51:13.24,Default,,0000,0000,0000,,وكانت أمي تنتظرها بشوق
Dialogue: 0,0:51:13.24,0:51:17.49,Default,,0000,0000,0000,,...وجدناها تحمل زهرة كاميليا في قبضتها، لذا
Dialogue: 0,0:51:19.40,0:51:25.17,Default,,0000,0000,0000,,لكن في النهاية، رفض أخوها تقبّل الأمر
Dialogue: 0,0:51:25.17,0:51:28.13,Default,,0000,0000,0000,,أخبريني، ما الذي يفعله الآن؟
Dialogue: 0,0:51:28.13,0:51:29.23,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:51:29.23,0:51:34.22,Default,,0000,0000,0000,,كان كبيراً في السنّ وقتها، فلعلّه تُوفي
Dialogue: 0,0:51:34.22,0:51:38.70,Default,,0000,0000,0000,,مهلك، إذا كان حيّاً فألن يحصل\Nعلى نصيب من الميراث بدوره؟
Dialogue: 0,0:51:38.70,0:51:42.75,Default,,0000,0000,0000,,لا تقلقا، لن يملك نصيباً بالقانون
Dialogue: 0,0:51:42.75,0:51:44.92,Default,,0000,0000,0000,,ليس صحيحاً بالضرورة
Dialogue: 0,0:51:45.16,0:51:51.41,Default,,0000,0000,0000,,قد يتلقّى جزءاً إذا كان ذلك\Nمذكوراً في وصيّة زوجي
Dialogue: 0,0:51:51.41,0:51:56.65,Default,,0000,0000,0000,,ماذا إذاً؟ قد يظهر قبل العاشرة ليلة الغد
Dialogue: 0,0:51:56.65,0:51:58.61,Default,,0000,0000,0000,,عندما ستُقرأ الوصيّة؟
Dialogue: 0,0:51:58.61,0:51:59.59,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:52:00.32,0:52:05.14,Default,,0000,0000,0000,,صحيح، إذا كان على قيد الحياة\Nفسيأتي هنا بلا شكّ
Dialogue: 0,0:52:05.14,0:52:09.84,Default,,0000,0000,0000,,كما يبدو أنّه لا يزال يكنّ ضغينةً\Nتجاهكم لخمسة عشر عاماً
Dialogue: 0,0:52:09.84,0:52:14.26,Default,,0000,0000,0000,,رغم أنّ لا علاقة لي بذلك بالطبع
Dialogue: 0,0:52:14.26,0:52:18.34,Default,,0000,0000,0000,,بما أنّي لم أكن جزءاً من \Nهذه العائلة عندما تُوفيت
Dialogue: 0,0:52:19.26,0:52:23.96,Default,,0000,0000,0000,,صحيح، سأذهب لحفلة ما بعد الزفاف\Nلإحدى الصديقات الآن
Dialogue: 0,0:52:23.96,0:52:27.67,Default,,0000,0000,0000,,أترك الباقي لك يا هيرومي-سان
Dialogue: 0,0:52:27.67,0:52:29.42,Default,,0000,0000,0000,,حسناً يا أمّي
Dialogue: 0,0:52:31.46,0:52:32.66,Default,,0000,0000,0000,,!مـ-من أنت؟
Dialogue: 0,0:52:34.82,0:52:36.03,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:52:36.03,0:52:38.38,Default,,0000,0000,0000,,!كان أحدهم هناك
Dialogue: 0,0:52:38.66,0:52:42.87,Default,,0000,0000,0000,,شخص مريب يسترق النظر\N!وراء تلك البوّابة الخشبية
Dialogue: 0,0:52:46.10,0:52:47.69,Default,,0000,0000,0000,,لا أحد هنا
Dialogue: 0,0:52:47.69,0:52:50.13,Default,,0000,0000,0000,,ربما كنت تتخيّل يا فتى
Dialogue: 0,0:52:50.69,0:52:54.83,Default,,0000,0000,0000,,غريب... أنا متأكّد أنّي رأيت أحداً
Dialogue: 0,0:52:55.01,0:53:01.70,Default,,0000,0000,0000,,لا يروقني هذا، أيمكن أن ذاك الشخص\Nهو أخوها في الواقع؟
Dialogue: 0,0:53:04.25,0:53:08.75,Default,,0000,0000,0000,,آسفة على مضايقتك بالمبيت هنا\N!وجعلك تطهين وجبةً كهذه
Dialogue: 0,0:53:08.75,0:53:12.83,Default,,0000,0000,0000,,لا بأس، وجبات القدر الساخن\Nتكون ألذّ بتشاركها
Dialogue: 0,0:53:13.16,0:53:16.87,Default,,0000,0000,0000,,تقولين ذلك وأنتِ جلبتِ معك غيار ثياب
Dialogue: 0,0:53:17.07,0:53:20.16,Default,,0000,0000,0000,,...كنتِ تنوين المبيت من البداية حتماً
Dialogue: 0,0:53:20.77,0:53:24.35,Default,,0000,0000,0000,,ماذا؟ أقلت شيئاً يا كونان-تشان؟
Dialogue: 0,0:53:24.35,0:53:26.12,Default,,0000,0000,0000,,...لا، لا شيء
Dialogue: 0,0:53:27.79,0:53:30.00,Default,,0000,0000,0000,,من قد يتّصل في هذا الوقت؟
Dialogue: 0,0:53:31.50,0:53:32.34,Default,,0000,0000,0000,,نعم؟
Dialogue: 0,0:53:32.34,0:53:33.67,Default,,0000,0000,0000,,هيرومي-سان؟
Dialogue: 0,0:53:33.67,0:53:36.84,Default,,0000,0000,0000,,أمّي! ما الخطب؟
Dialogue: 0,0:53:36.84,0:53:40.00,Default,,0000,0000,0000,,تذكّرت، نفد منّا الحطب للحمّام
Dialogue: 0,0:53:40.00,0:53:43.37,Default,,0000,0000,0000,,أجل، لذا خطر لي أن نمتنع \Nعن الاستحمام الليلة
Dialogue: 0,0:53:44.64,0:53:45.91,Default,,0000,0000,0000,,!أمّي؟
Dialogue: 0,0:53:47.91,0:53:50.16,Default,,0000,0000,0000,,!ماتشيكو-تشان! لنشرب معاً
Dialogue: 0,0:53:50.16,0:53:53.66,Default,,0000,0000,0000,,توقّف! أنا على الهاتف
Dialogue: 0,0:53:53.66,0:53:54.98,Default,,0000,0000,0000,,،بالمناسبة
Dialogue: 0,0:53:54.98,0:53:59.32,Default,,0000,0000,0000,,أحضرتُ حطباً للحمّام هذا الصباح\Nوتركته عند السقيفة
Dialogue: 0,0:53:59.32,0:53:59.98,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:53:59.98,0:54:02.45,Default,,0000,0000,0000,,!أعتمد عليكِ إذاً
Dialogue: 0,0:54:02.89,0:54:05.72,Default,,0000,0000,0000,,يبدو أنّ أمّي غارقة في الثمالة
Dialogue: 0,0:54:05.72,0:54:08.85,Default,,0000,0000,0000,,تترك نفسها طليقة ونحن لا نزال نرثو أبي
Dialogue: 0,0:54:10.50,0:54:15.45,Default,,0000,0000,0000,,عجباً، قدر ساخن للعشاء الليلة؟\Nيمكنني الاطمئنان الآن
Dialogue: 0,0:54:15.45,0:54:16.76,Default,,0000,0000,0000,,الاطمئنان؟
Dialogue: 0,0:54:16.76,0:54:21.54,Default,,0000,0000,0000,,لن يكون عليّ طلب تذوّق الطعام\Nمن كارلوس حذراً من السمّ
Dialogue: 0,0:54:21.54,0:54:23.17,Default,,0000,0000,0000,,!عمّي
Dialogue: 0,0:54:23.17,0:54:27.37,Default,,0000,0000,0000,,!لا بدّ أنّ الرسالة كانت مقلباً فحسب
Dialogue: 0,0:54:27.37,0:54:28.95,Default,,0000,0000,0000,,أتمنّى ذلك
Dialogue: 0,0:54:32.74,0:54:35.19,Default,,0000,0000,0000,,كيف الماء يا يوكي-تشان؟
Dialogue: 0,0:54:35.19,0:54:37.45,Default,,0000,0000,0000,,!مناسب
Dialogue: 0,0:54:37.45,0:54:40.89,Default,,0000,0000,0000,,لكن، حمّام قدر في هذه الأيام؟
Dialogue: 0,0:54:40.89,0:54:43.45,Default,,0000,0000,0000,,أين المشكلة؟ له رونقه
Dialogue: 0,0:54:43.77,0:54:48.31,Default,,0000,0000,0000,,أخبرني يا شين-تشان، أتريد الاستحمام معي\Nمثل الأيام الخوالي؟
Dialogue: 0,0:54:48.31,0:54:49.37,Default,,0000,0000,0000,,سأمتنع
Dialogue: 0,0:54:49.77,0:54:53.37,Default,,0000,0000,0000,,هلّا أخبرتِ عمّي بأنّ الحمّام جاهز؟
Dialogue: 0,0:54:53.37,0:54:56.42,Default,,0000,0000,0000,,صحيح، كان يحبّ الاستحمام
Dialogue: 0,0:54:56.42,0:54:58.37,Default,,0000,0000,0000,,دائماً من يستحمّ بدايةً أيضاً
Dialogue: 0,0:54:58.51,0:55:03.50,Default,,0000,0000,0000,,أتعتقدان أنّ هذا الحمّام الصغير\Nسيتّسع للعمّ وكارلوس حقّاً؟
Dialogue: 0,0:55:03.50,0:55:05.00,Default,,0000,0000,0000,,لا يمكن
Dialogue: 0,0:55:05.00,0:55:07.91,Default,,0000,0000,0000,,،استحمّ العمّ يومياً مُذ قدومه
Dialogue: 0,0:55:07.91,0:55:10.16,Default,,0000,0000,0000,,لكنّ كارلوس بقي في المنزل دوماً
Dialogue: 0,0:55:10.30,0:55:14.07,Default,,0000,0000,0000,,ماذا؟ يستحمّ بمفرده دون حارسه الشخصيّ؟
Dialogue: 0,0:55:16.57,0:55:22.16,Default,,0000,0000,0000,,فهمت، يراقب كارلوس الجميع\Nبينما هو يستحمّ
Dialogue: 0,0:55:22.56,0:55:25.11,Default,,0000,0000,0000,,إذاً، أعتمد عليك يا كارلوس
Dialogue: 0,0:55:29.89,0:55:32.55,Default,,0000,0000,0000,,أجل؟ أمّي؟
Dialogue: 0,0:55:32.55,0:55:34.99,Default,,0000,0000,0000,,كيف الأمر؟ وجدتِ حطب الحمّام؟
Dialogue: 0,0:55:34.99,0:55:38.26,Default,,0000,0000,0000,,أجل، عمّي متّجه للاستحمام الآن
Dialogue: 0,0:55:38.26,0:55:39.68,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:55:39.68,0:55:44.29,Default,,0000,0000,0000,,لا أزال في الحفلة الآن، لا أظنّني سأرجع\Nحتّى بعد الحادية عشرة
Dialogue: 0,0:55:44.29,0:55:47.87,Default,,0000,0000,0000,,آسفة على الطلب، لكن هلّا أدفأتِ الحمّام حتّى حينها؟
Dialogue: 0,0:55:47.87,0:55:49.50,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:55:54.95,0:55:56.66,Default,,0000,0000,0000,,!كان ذلك حمّاماً منعشاً
Dialogue: 0,0:55:56.66,0:55:58.95,Default,,0000,0000,0000,,سأدخل أنا تالياً
Dialogue: 0,0:55:58.95,0:56:01.24,Default,,0000,0000,0000,,وأنا بعدك إذاً
Dialogue: 0,0:56:04.98,0:56:07.19,Default,,0000,0000,0000,,كيف كان الماء؟
Dialogue: 0,0:56:07.19,0:56:09.85,Default,,0000,0000,0000,,باردٌ قليلاً وفقما أظنّ
Dialogue: 0,0:56:09.85,0:56:12.57,Default,,0000,0000,0000,,يجدر بي إعادة تسخينه إذاً
Dialogue: 0,0:56:12.57,0:56:13.24,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:56:13.49,0:56:14.77,Default,,0000,0000,0000,,شكراً على عملك
Dialogue: 0,0:56:14.77,0:56:16.05,Default,,0000,0000,0000,,خذي راحتك
Dialogue: 0,0:56:20.25,0:56:24.71,Default,,0000,0000,0000,,يا إلهي، تستحمّ مع ران-تشان لكن ليس معي؟
Dialogue: 0,0:56:31.07,0:56:32.66,Default,,0000,0000,0000,,!ما الأمر يا هيرومي؟
Dialogue: 0,0:56:32.66,0:56:37.45,Default,,0000,0000,0000,,كـ-كان هناك رجلٌ غريب بنظّارات\N!شمسية وراء البوّابة
Dialogue: 0,0:56:38.03,0:56:40.65,Default,,0000,0000,0000,,!كان ذلك الشخص موجوداً إذاً
Dialogue: 0,0:56:43.78,0:56:46.48,Default,,0000,0000,0000,,!انظروا! ألا يبدو ذاك الدلو غريباً؟
Dialogue: 0,0:56:46.48,0:56:47.04,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:56:47.46,0:56:49.69,Default,,0000,0000,0000,,!انظروا! دلو البئر مرفوع
Dialogue: 0,0:56:52.60,0:56:54.93,Default,,0000,0000,0000,,يبدو أنّ هناك شيئاً عالقاً به
Dialogue: 0,0:56:54.93,0:56:56.03,Default,,0000,0000,0000,,!لنرفعه
Dialogue: 0,0:56:57.39,0:56:59.04,Default,,0000,0000,0000,,!إنّه ثقيلٌ جدّاً
Dialogue: 0,0:57:02.86,0:57:04.67,Default,,0000,0000,0000,,...واحد، اثنان
Dialogue: 0,0:57:14.62,0:57:16.66,Default,,0000,0000,0000,,!أ-أمّي
Dialogue: 0,0:57:19.79,0:57:22.02,Default,,0000,0000,0000,,لـ-لمَ حصل هذا؟
Dialogue: 0,0:57:22.02,0:57:24.78,Default,,0000,0000,0000,,أيمكن أنّها قفزت في البئر وانتحرت؟
Dialogue: 0,0:57:26.86,0:57:31.49,Default,,0000,0000,0000,,!كلا، يوجد أثر طعن في صدرها\N!هذا سبب الموت
Dialogue: 0,0:57:31.49,0:57:33.24,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:57:33.24,0:57:36.37,Default,,0000,0000,0000,,أيعني ذلك أنّ أحداً هنا فعلها؟
Dialogue: 0,0:57:36.37,0:57:38.12,Default,,0000,0000,0000,,!لا-لا يُعقل
Dialogue: 0,0:57:38.12,0:57:43.13,Default,,0000,0000,0000,,أخبروني، كان اتّصال ماتشيكو-سان الأخير\Nعند التاسعة تقريباً، صحيح؟
Dialogue: 0,0:57:43.13,0:57:46.80,Default,,0000,0000,0000,,أجل، من قاعة حفلات الفندق بالقرب من المحطّة
Dialogue: 0,0:57:46.80,0:57:49.66,Default,,0000,0000,0000,,دخلتُ الحمّام قبل عشر دقائق
Dialogue: 0,0:57:50.13,0:57:54.79,Default,,0000,0000,0000,,أغادر أحدٌ الغرفة بينما كنتُ في الحمّام؟
Dialogue: 0,0:57:54.79,0:57:56.62,Default,,0000,0000,0000,,كلا، لا أحد
Dialogue: 0,0:57:57.24,0:58:00.82,Default,,0000,0000,0000,,إذاً، لا يمكن أنّه كان\Nأحد الأشخاص هنا
Dialogue: 0,0:58:00.82,0:58:05.07,Default,,0000,0000,0000,,ستحتاج ساعةً على الأقل بالسّيارة\Nمن الفندق عند المحطّة لهذا المنزل
Dialogue: 0,0:58:05.07,0:58:07.11,Default,,0000,0000,0000,,،أي أنّه بينما كنتُ في الحمّام
Dialogue: 0,0:58:07.11,0:58:11.91,Default,,0000,0000,0000,,رجعت وقتلها أحدهم وألقاها في البئر
Dialogue: 0,0:58:12.68,0:58:15.43,Default,,0000,0000,0000,,،رغم أنّها ستكون قصّة أخرى لو اشتبهتم بي
Dialogue: 0,0:58:15.43,0:58:17.77,Default,,0000,0000,0000,,مع أنّي التقيتُها لأوّل مرّةٍ اليوم
Dialogue: 0,0:58:17.77,0:58:20.31,Default,,0000,0000,0000,,من الفاعل إذاً؟
Dialogue: 0,0:58:20.31,0:58:23.63,Default,,0000,0000,0000,,أيمكن أنّه الرجل المشبوه بالنظّارات الشمسية\Nالذي رأيتِه قبل قليل؟
Dialogue: 0,0:58:23.63,0:58:26.45,Default,,0000,0000,0000,,لكن لمَ قد يقتل أمّي؟
Dialogue: 0,0:58:28.71,0:58:30.65,Default,,0000,0000,0000,,!يوجد شيءٌ في جيبها
Dialogue: 0,0:58:30.65,0:58:31.95,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:58:31.95,0:58:33.95,Default,,0000,0000,0000,,...هـ-هذه
Dialogue: 0,0:58:33.95,0:58:35.37,Default,,0000,0000,0000,,!زهرة كاميليا
Dialogue: 0,0:58:35.37,0:58:40.37,Default,,0000,0000,0000,,إذاً... الشخص الذي رأيتُه \N...قبل قليل كان حقّاً
Dialogue: 0,0:58:42.82,0:58:44.53,Default,,0000,0000,0000,,...الرجل من 15 عاماً
Dialogue: 0,0:58:51.74,0:58:55.78,Default,,0000,0000,0000,,الضحيّة هي يابوتشي ماتشيكو-سان، 39 عاماً
Dialogue: 0,0:58:55.78,0:58:58.85,Default,,0000,0000,0000,,،أنتِ متأكّدة أنّها الزوجة الثانية ليوشيتشيكا-سان
Dialogue: 0,0:58:58.85,0:59:01.67,Default,,0000,0000,0000,,مالك هذا المنزل الذي فارق الحياة الشهر الفائت؟
Dialogue: 0,0:59:01.67,0:59:02.78,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:59:03.26,0:59:04.92,Default,,0000,0000,0000,,محقّق يامامورا
Dialogue: 0,0:59:04.92,0:59:07.01,Default,,0000,0000,0000,,،لم نجد سلاح الجريمة بعد
Dialogue: 0,0:59:07.01,0:59:11.36,Default,,0000,0000,0000,,لكن يبدو أنّها ماتت نتيجة نزيف\Nالدماء بعد طعنة في الصدر
Dialogue: 0,0:59:12.00,0:59:14.12,Default,,0000,0000,0000,,هـ-هكذا إذاً؟
Dialogue: 0,0:59:14.96,0:59:19.25,CharCard,,0000,0000,0004,,{\fad(200,300)}المحقّق يامامورا
Dialogue: 0,0:59:14.96,0:59:19.83,On Top,,0000,0000,0000,,أيمكننا قول أنّ الجثّة اُكتشفت بعد \Nالعاشرة ليلاً بقليل؟
Dialogue: 0,0:59:19.83,0:59:21.11,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:59:21.11,0:59:25.66,Default,,0000,0000,0000,,...وجدنا ارتفاع دلو البئر غريباً، فعندما سحبناه
Dialogue: 0,0:59:26.03,0:59:28.70,Default,,0000,0000,0000,,اكتشفنا جثّتها في البئر
Dialogue: 0,0:59:31.85,0:59:33.99,Default,,0000,0000,0000,,المعذرة، أهناك خطبٌ ما؟
Dialogue: 0,0:59:34.56,0:59:39.48,Default,,0000,0000,0000,,لـ-لا! أصابتني قشعريرة عندما \N...تصوّرتُ الأمر فقط
Dialogue: 0,0:59:39.48,0:59:45.20,Default,,0000,0000,0000,,إذاً، هذا يعني أنّ القاتل كان أحدكم الثمانية
Dialogue: 0,0:59:45.20,0:59:48.56,Default,,0000,0000,0000,,الذين كانوا هنا في ذاك الوقت؟
Dialogue: 0,0:59:48.56,0:59:50.74,Default,,0000,0000,0000,,!تـ-تمهّل قليلاً
Dialogue: 0,0:59:50.74,0:59:56.79,Default,,0000,0000,0000,,ذهبت أمّي لحفلة ما بعد الزفاف لإحدى\Nصديقاتها في الفندق بجوار المحطّة
Dialogue: 0,0:59:56.79,1:00:00.74,Default,,0000,0000,0000,,!واتّصلت بنا من هناك عند التاسعة
Dialogue: 0,1:00:01.86,1:00:05.24,Default,,0000,0000,0000,,،حتّى لو غادرت بالسيّارة بعد المكالمة فوراً
Dialogue: 0,1:00:05.24,1:00:07.74,Default,,0000,0000,0000,,لن تصل هنا حتّى بعد العاشرة
Dialogue: 0,1:00:07.74,1:00:09.07,Default,,0000,0000,0000,,كنّا جميعاً في الغرفة نفسها
Dialogue: 0,1:00:09.07,1:00:12.48,Default,,0000,0000,0000,,بين العاشرة ووقت اكتشاف الجثّة
Dialogue: 0,1:00:12.48,1:00:14.95,Default,,0000,0000,0000,,!فيستحيل أنّنا ارتكبنا الجريمة
Dialogue: 0,1:00:14.95,1:00:20.90,Default,,0000,0000,0000,,صحيح، كنتُ الوحيدة التي لم تكن معهم\Nبما أنّي كنت أستحمّ
Dialogue: 0,1:00:21.26,1:00:24.93,Default,,0000,0000,0000,,!ماذا؟! أ-أنتِ القاتلة إذاً؟
Dialogue: 0,1:00:24.93,1:00:30.67,Default,,0000,0000,0000,,كلا، التقيتُ الضحيّة ماتشيكو-سان \N!لأوّل مرةّ اليوم فقط
Dialogue: 0,1:00:30.67,1:00:32.30,Default,,0000,0000,0000,,صحيح يا كونان-تشان؟
Dialogue: 0,1:00:32.30,1:00:33.28,Default,,0000,0000,0000,,أجل
Dialogue: 0,1:00:33.28,1:00:36.92,Default,,0000,0000,0000,,إنّها الحقيقة! كانت يوكيكو تعيش خارج البلاد
Dialogue: 0,1:00:36.92,1:00:40.45,Default,,0000,0000,0000,,وأتت اليوم بعدما صادف أن طلبتُ قدومها
Dialogue: 0,1:00:41.03,1:00:45.45,Default,,0000,0000,0000,,...يوكيكو"؟ لحظة، أيمكن أنّك تلك"
Dialogue: 0,1:00:45.45,1:00:48.41,Default,,0000,0000,0000,,!الممثلة، فوجيميني يوكيكو-سان؟
Dialogue: 0,1:00:48.41,1:00:49.67,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,1:00:49.67,1:00:51.78,Default,,0000,0000,0000,,!رائع
Dialogue: 0,1:00:51.78,1:00:57.29,Default,,0000,0000,0000,,كنتُ أشاهدك أسبوعياً في مسلسل\N!قصّة الشرطيّة الخطيرة" التي كنتِ بطلتها"
Dialogue: 0,1:00:57.94,1:01:00.97,Default,,0000,0000,0000,,!ألهمتِني بالانضمام للشرطة
Dialogue: 0,1:01:00.97,1:01:02.80,Default,,0000,0000,0000,,!عجباً
Dialogue: 0,1:01:02.80,1:01:04.61,Default,,0000,0000,0000,,هذا يجعلك أكثر إثارة للشبهة
Dialogue: 0,1:01:04.61,1:01:05.32,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,1:01:05.85,1:01:10.14,Default,,0000,0000,0000,,فأنتِ بارعة في استعمال المسدّسات والسكاكين
Dialogue: 0,1:01:10.14,1:01:12.49,Default,,0000,0000,0000,,!كان ذلك في المسلسل فقط
Dialogue: 0,1:01:12.49,1:01:15.20,Default,,0000,0000,0000,,هل سيكون الأمر على ما يرام\Nمع هذا الشرطيّ؟
Dialogue: 0,1:01:15.67,1:01:19.63,Default,,0000,0000,0000,,أخبريني، أكانت ماتشيكو-سان\Nحقّاً من اتّصلت؟
Dialogue: 0,1:01:19.63,1:01:21.62,Default,,0000,0000,0000,,أجل، كانت هي
Dialogue: 0,1:01:21.62,1:01:26.66,Default,,0000,0000,0000,,فقد استجابت للمحادثة، وسمعتُ الأصوات في الحفلة
Dialogue: 0,1:01:27.16,1:01:31.15,Default,,0000,0000,0000,,!رأيتِ؟ أنتِ الوحيدة القادرة على ارتكاب الجريمة
Dialogue: 0,1:01:31.15,1:01:32.57,Default,,0000,0000,0000,,...أخبرتُك
Dialogue: 0,1:01:32.57,1:01:34.82,Default,,0000,0000,0000,,!يوجد شخص آخر مثير للريبة
Dialogue: 0,1:01:36.74,1:01:39.15,Default,,0000,0000,0000,,كان يتسكّع في المكان
Dialogue: 0,1:01:39.15,1:01:43.74,Default,,0000,0000,0000,,شخص مريب يغطّي وجهه بنظّارات\Nشمسية وقبّعة ووشاح
Dialogue: 0,1:01:43.97,1:01:46.12,Default,,0000,0000,0000,,شـ-شخص مريب؟
Dialogue: 0,1:01:46.12,1:01:50.16,Default,,0000,0000,0000,,لا بدّ أنّه أخو أمّنا التي تُوفيت قبل 15 عاماً
Dialogue: 0,1:01:50.55,1:01:56.00,Default,,0000,0000,0000,,حاولت اقتطاف إحدى أزهار الكاميليا تلك\Nوانزلقت وسقطت في البئر
Dialogue: 0,1:01:56.00,1:02:00.16,Default,,0000,0000,0000,,لكنّه مُقتنع أنّ أحدنا دفعها
Dialogue: 0,1:02:02.99,1:02:09.16,Default,,0000,0000,0000,,لكن مثل حالي، لم تكن ماتشيكو-سان\Nمن أفراد العائلة قبل 15 سنة
Dialogue: 0,1:02:09.16,1:02:11.07,Default,,0000,0000,0000,,فلمَ يقتلها؟
Dialogue: 0,1:02:11.07,1:02:12.73,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,1:02:12.73,1:02:16.62,Default,,0000,0000,0000,,كان المكان مظلماً هنا، فلعلّه اعتقدها شخصاً آخر
Dialogue: 0,1:02:16.62,1:02:21.32,Default,,0000,0000,0000,,لم يُحسم أنّه كان الرجل\N...بالنظّارات الشمسية بعد
Dialogue: 0,1:02:21.32,1:02:23.19,Default,,0000,0000,0000,,قد يكون
Dialogue: 0,1:02:24.32,1:02:26.83,Default,,0000,0000,0000,,أترى؟ زهرة الكاميليا هذه
Dialogue: 0,1:02:27.84,1:02:29.37,Default,,0000,0000,0000,,زهرة من تلك الشجرة؟
Dialogue: 0,1:02:29.37,1:02:33.84,Default,,0000,0000,0000,,كانت في جيب صدر هذه السيّدة
Dialogue: 0,1:02:37.96,1:02:39.55,Default,,0000,0000,0000,,لمَ تهلع؟
Dialogue: 0,1:02:39.55,1:02:41.86,Default,,0000,0000,0000,,ألستَ محقّقاً في قسم جرائم القتل؟
Dialogue: 0,1:02:43.62,1:02:47.62,Default,,0000,0000,0000,,...فـ-في الواقع، هذا أوّل تحقيقٍ لي
Dialogue: 0,1:02:47.62,1:02:50.08,Default,,0000,0000,0000,,الزكام منتشر بين أفراد قسمنا
Dialogue: 0,1:02:50.08,1:02:52.57,Default,,0000,0000,0000,,...فكنتُ الوحيد المتوفّر
Dialogue: 0,1:02:52.94,1:02:55.32,Default,,0000,0000,0000,,...لذا لستُ معتاداً على الجثث
Dialogue: 0,1:02:55.32,1:02:57.33,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,1:02:57.94,1:03:01.93,Default,,0000,0000,0000,,بـ-بأيّ حال، لإيجاد وقت عودة\Nالضحيّة الدقيق للمنزل
Dialogue: 0,1:03:01.93,1:03:05.20,Default,,0000,0000,0000,,عليّ إيجاد سيّارة الأجرة التي\Nاستقلّتْها من الفندق
Dialogue: 0,1:03:05.64,1:03:06.71,Default,,0000,0000,0000,,سيّارة الأجرة؟
Dialogue: 0,1:03:06.71,1:03:10.24,Default,,0000,0000,0000,,غادرت أمّي بسيّارة العائلة
Dialogue: 0,1:03:10.24,1:03:11.70,Default,,0000,0000,0000,,سـ-سيّارة؟
Dialogue: 0,1:03:11.70,1:03:14.24,Default,,0000,0000,0000,,رأيتَ السيّارة في الفناء، أليس كذلك؟
Dialogue: 0,1:03:14.72,1:03:17.13,Default,,0000,0000,0000,,كلا، لم أرها
Dialogue: 0,1:03:18.67,1:03:21.08,Default,,0000,0000,0000,,السيّارة ليست هنا
Dialogue: 0,1:03:21.08,1:03:24.24,Default,,0000,0000,0000,,غريب، كانت تُركن هنا دوماً
Dialogue: 0,1:03:24.71,1:03:27.41,Default,,0000,0000,0000,,أين ركنت أمّي السيّارة؟
Dialogue: 0,1:03:27.41,1:03:30.24,Default,,0000,0000,0000,,،كانت تشرب ساكي في الحفلة
Dialogue: 0,1:03:30.24,1:03:33.74,Default,,0000,0000,0000,,فلعلّها تركت السيّارة ورجعت بسيّارة أجرة، صحيح؟
Dialogue: 0,1:03:33.74,1:03:34.61,Default,,0000,0000,0000,,...أجل
Dialogue: 0,1:03:34.61,1:03:36.32,Default,,0000,0000,0000,,!محقّق يامامورا
Dialogue: 0,1:03:36.32,1:03:37.07,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,1:03:38.34,1:03:41.29,Default,,0000,0000,0000,,وجدنا سيّارةً في الغابة وراء المنزل
Dialogue: 0,1:03:41.29,1:03:43.28,Default,,0000,0000,0000,,فـ-في الغابة؟
Dialogue: 0,1:03:44.20,1:03:46.78,Default,,0000,0000,0000,,لمَ توجد هناك؟
Dialogue: 0,1:03:50.94,1:03:56.28,Default,,0000,0000,0000,,إ-إنّها سيّارتنا! لكن لمَ هي في الغابة؟
Dialogue: 0,1:03:56.28,1:04:01.24,Default,,0000,0000,0000,,ربما نوى القاتل استعمالها، لكن غيّر رأيه؟
Dialogue: 0,1:04:01.77,1:04:07.68,Default,,0000,0000,0000,,لعلّ الوقود نفد من أمّكم أو واجهت\Nمشاكل في المحرّك في طريقها
Dialogue: 0,1:04:07.68,1:04:13.53,Default,,0000,0000,0000,,فرجعت للمنزل مشياً، حيث كان ذاك\N!الرجل ينتظر لطعنها
Dialogue: 0,1:04:14.51,1:04:20.33,Default,,0000,0000,0000,,هذا غريب، محرّك السيّارة يعمل\Nبلا مشاكل، والمفتاح داخلها
Dialogue: 0,1:04:20.33,1:04:23.99,Default,,0000,0000,0000,,كما أنّها مزوّدة بنقود، ولا يبدو أنّ أيّاً\Nمن الإطارات مثقوب
Dialogue: 0,1:04:24.29,1:04:27.99,Default,,0000,0000,0000,,كما علبة الكاسيت الفارغة هذه تثير الفضول
Dialogue: 0,1:04:28.29,1:04:30.74,Default,,0000,0000,0000,,لا أرى محتواها بأيّ مكان
Dialogue: 0,1:04:30.74,1:04:33.99,Default,,0000,0000,0000,,لا يوجد سوى هاتف خلويّ في المقصورة
Dialogue: 0,1:04:34.78,1:04:36.42,Default,,0000,0000,0000,,!أنتما
Dialogue: 0,1:04:38.11,1:04:43.74,Default,,0000,0000,0000,,بأيّ حال، ستنامون جميعاً الليلة تحت حراستنا
Dialogue: 0,1:04:44.27,1:04:48.21,Default,,0000,0000,0000,,كما أنّ ذاك الرجل المريب\Nقد لا يزال في الخارج
Dialogue: 0,1:04:51.45,1:04:55.45,Default,,0000,0000,0000,,يا إلهي، علينا النوم في نفس الغرفة مع أفراد شرطة؟
Dialogue: 0,1:04:55.45,1:04:56.76,Default,,0000,0000,0000,,هذا فظيع
Dialogue: 0,1:04:58.34,1:05:00.40,Default,,0000,0000,0000,,أخبرني يا شين-تشان
Dialogue: 0,1:05:00.66,1:05:02.30,Default,,0000,0000,0000,,لأيّ حدٍ عرفت؟
Dialogue: 0,1:05:03.41,1:05:05.25,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,1:05:05.25,1:05:06.75,Default,,0000,0000,0000,,!أخبرني
Dialogue: 0,1:05:06.75,1:05:11.24,Default,,0000,0000,0000,,سأُتّهم بأنّي القاتلة إذا تركنا الأمر\N!لذاك الشرطيّ الفاشل
Dialogue: 0,1:05:11.24,1:05:12.91,Default,,0000,0000,0000,,لا تزال هناك الكثير من الألغاز
Dialogue: 0,1:05:13.82,1:05:19.50,Default,,0000,0000,0000,,،بالإضافة للرجل ذي النظّارات الشمسية\N،هناك السيّارة المتروكة في الغابة
Dialogue: 0,1:05:19.82,1:05:21.70,Default,,0000,0000,0000,,،وعلبة الكاسيت الفارغة
Dialogue: 0,1:05:22.02,1:05:26.62,Default,,0000,0000,0000,,وأكثر ما يثير الفضول هي الجثّة\Nالتي رُبطت بحبل البئر
Dialogue: 0,1:05:27.02,1:05:32.80,Default,,0000,0000,0000,,،رغم أنّها كانت مخفيّة في البئر\Nكان كذلك كأنّه أراد اكتشافها
Dialogue: 0,1:05:33.88,1:05:38.37,Default,,0000,0000,0000,,صحيح، هناك الكثير من الألغاز المتناثرة
Dialogue: 0,1:05:39.30,1:05:40.49,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,1:05:41.25,1:05:43.50,Default,,0000,0000,0000,,أكان باب ذاك المستودع مفتوحاً قبلاً؟
Dialogue: 0,1:05:43.50,1:05:44.49,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,1:05:54.78,1:05:55.99,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,1:05:56.36,1:05:59.00,Default,,0000,0000,0000,,!انتظر يا شين-تشان
Dialogue: 0,1:06:01.81,1:06:04.49,Default,,0000,0000,0000,,هيّا، لنرجع للغرفة وننم
Dialogue: 0,1:06:04.85,1:06:06.40,Default,,0000,0000,0000,,!بسرعة يا شين-تشان
Dialogue: 0,1:06:17.41,1:06:19.25,Default,,0000,0000,0000,,!محقّق يامامورا
Dialogue: 0,1:06:21.29,1:06:23.28,Default,,0000,0000,0000,,أجل، أجل؟
Dialogue: 0,1:06:24.79,1:06:27.74,Default,,0000,0000,0000,,!وجدنا سلاح الجريمة في البئر
Dialogue: 0,1:06:27.74,1:06:28.83,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:06:30.32,1:06:32.82,Default,,0000,0000,0000,,سكّين إذاً؟
Dialogue: 0,1:06:32.82,1:06:36.32,Default,,0000,0000,0000,,تأكّدوا من مطابقتها للطعنة\Nعلى جثّة الضحيّة
Dialogue: 0,1:06:36.32,1:06:37.32,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,1:06:37.32,1:06:39.33,Default,,0000,0000,0000,,ما ذاك الفينيل؟
Dialogue: 0,1:06:39.33,1:06:42.48,Default,,0000,0000,0000,,إنّه معطف مطر نسائيّ
Dialogue: 0,1:06:42.48,1:06:45.07,Default,,0000,0000,0000,,كانت السكّين ملفوفةً به لسببٍ ما
Dialogue: 0,1:06:45.07,1:06:46.40,Default,,0000,0000,0000,,معطف مطر؟
Dialogue: 0,1:06:46.40,1:06:50.93,Default,,0000,0000,0000,,!كلا، لا يمكنك! الدخول للمصرّح لهم فقط
Dialogue: 0,1:06:50.93,1:06:52.47,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,1:06:52.47,1:06:54.07,Default,,0000,0000,0000,,...دخل هذا الرجل
Dialogue: 0,1:06:54.07,1:06:56.80,Default,,0000,0000,0000,,!أخبرتك أنّي المحامي
Dialogue: 0,1:06:56.80,1:06:57.87,Default,,0000,0000,0000,,محامي؟
Dialogue: 0,1:06:57.87,1:07:03.36,CharCard,,0000,0000,0004,,محامي عائلة يابوتشي
Dialogue: 0,1:06:57.87,1:07:03.36,On Top,,0000,0000,0000,,أتيتُ لقراءة وصيّة يوشيتشيكا-سان\Nالمُتوفى الشهر الفائت
Dialogue: 0,1:07:03.36,1:07:05.53,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,1:07:06.50,1:07:08.54,Default,,0000,0000,0000,,حان الوقت أخيراً
Dialogue: 0,1:07:08.54,1:07:11.53,Default,,0000,0000,0000,,!ماذا؟ نؤخّر قراءة الوصيّة؟
Dialogue: 0,1:07:11.83,1:07:15.12,Default,,0000,0000,0000,,أجل، لم يُقبض على القاتل بعد
Dialogue: 0,1:07:15.12,1:07:17.20,Default,,0000,0000,0000,,ولم ننته من تفتيش المنزل
Dialogue: 0,1:07:17.20,1:07:19.37,Default,,0000,0000,0000,,يُفترض أن تؤجل القراءة
Dialogue: 0,1:07:19.37,1:07:20.86,Default,,0000,0000,0000,,!لا تعبث معنا
Dialogue: 0,1:07:20.86,1:07:23.53,Default,,0000,0000,0000,,!أتملك حقّ تحديد ذلك؟
Dialogue: 0,1:07:24.44,1:07:27.29,Default,,0000,0000,0000,,كلما زاد الطمع زاد الصخب
Dialogue: 0,1:07:27.29,1:07:29.50,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:07:29.50,1:07:32.36,Default,,0000,0000,0000,,!أيّها العجوز! لا تكن بهذه الفظاظة
Dialogue: 0,1:07:32.82,1:07:36.24,Default,,0000,0000,0000,,!أتفهم؟! أنت مجرّد مزيّف بأيّ حال
Dialogue: 0,1:07:37.22,1:07:39.25,Default,,0000,0000,0000,,هل الألم هو السبيل الوحيد لتفهم؟
Dialogue: 0,1:07:46.71,1:07:49.16,Default,,0000,0000,0000,,!عـ-على مهلكما
Dialogue: 0,1:07:49.42,1:07:55.16,Default,,0000,0000,0000,,ما رأيكما بهذا إذاً؟ سنحضر نحن\Nالشرطة قراءة الوصيّة إذاً، اتّفقنا؟
Dialogue: 0,1:07:55.58,1:07:58.16,Default,,0000,0000,0000,,!هيّا، لنكن على وفاق
Dialogue: 0,1:07:58.41,1:08:00.15,Default,,0000,0000,0000,,...كـ-كانت تلك
Dialogue: 0,1:08:00.48,1:08:02.61,Default,,0000,0000,0000,,جوجوتسو برازيلية
Dialogue: 0,1:08:02.61,1:08:05.16,Default,,0000,0000,0000,,كما أنّه بارعٌ بها
Dialogue: 0,1:08:05.44,1:08:10.15,Default,,0000,0000,0000,,أيعني ذلك أنّ كارلوس أبرع منه حتّى؟
Dialogue: 0,1:08:10.52,1:08:15.87,Default,,0000,0000,0000,,،لكن إذا كان بارعاً في حماية نفسه لذاك الحد\Nفلمَ قد يعيّن حارساً شخصياً؟
Dialogue: 0,1:08:15.87,1:08:19.92,Default,,0000,0000,0000,,لا أدري، لعلّه من باب الحيطة
Dialogue: 0,1:08:29.26,1:08:34.49,Default,,0000,0000,0000,,ستتمّ الآن قراءة وصيّة\N يابوتشي يوشيتشيكا الراحل إذاً
Dialogue: 0,1:08:34.87,1:08:37.08,Default,,0000,0000,0000,,أطلب منكم الإنصات بصمت
Dialogue: 0,1:08:42.94,1:08:44.24,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,1:08:45.86,1:08:49.16,Default,,0000,0000,0000,,ماذا؟ ما هذا الصوت؟
Dialogue: 0,1:08:50.52,1:08:53.35,Default,,0000,0000,0000,,لمَ مسجّل الأشرطة هذا؟
Dialogue: 0,1:08:53.35,1:09:00.11,Default,,0000,0000,0000,,سجّل يوشيتشيكا-سان شريطاً بصوته\Nمع وصيّته الخطيّة
Dialogue: 0,1:09:04.63,1:09:07.22,Default,,0000,0000,0000,,ماذا؟ لا صوت
Dialogue: 0,1:09:07.22,1:09:10.32,Default,,0000,0000,0000,,مهلك، أليس ذلك زرّ التسجيل؟
Dialogue: 0,1:09:10.32,1:09:11.65,Default,,0000,0000,0000,,!أوقفه بسرعة
Dialogue: 0,1:09:17.91,1:09:18.70,Default,,0000,0000,0000,,!انخفض
Dialogue: 0,1:09:19.90,1:09:20.57,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,1:09:23.24,1:09:24.78,Default,,0000,0000,0000,,!ما كان ذلك؟
Dialogue: 0,1:09:28.70,1:09:32.20,Default,,0000,0000,0000,,!الـ-الخزانة! خرج سهم من تلك الخزانة
Dialogue: 0,1:09:33.27,1:09:34.41,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:09:36.23,1:09:38.41,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,1:09:38.89,1:09:40.57,Default,,0000,0000,0000,,!مـ-مسدّس قوس
Dialogue: 0,1:09:42.78,1:09:44.99,Default,,0000,0000,0000,,...وهذه الساعة
Dialogue: 0,1:09:45.97,1:09:47.79,Default,,0000,0000,0000,,...جـ-جهاز مؤقت
Dialogue: 0,1:09:47.79,1:09:52.12,Default,,0000,0000,0000,,...كان مضبوطاً على الإطلاق في وقت محدّد إذاً
Dialogue: 0,1:09:53.54,1:09:55.67,Default,,0000,0000,0000,,مـ-من قد يفعل ذلك؟
Dialogue: 0,1:09:55.67,1:09:57.32,Default,,0000,0000,0000,,من نصب هذا؟
Dialogue: 0,1:10:06.75,1:10:10.83,Default,,0000,0000,0000,,من نصب هذا؟
Dialogue: 0,1:10:11.37,1:10:14.83,Default,,0000,0000,0000,,لا بدّ أنّه كان ذاك الشخص الذي\N!هرب من البوّابة البارحة
Dialogue: 0,1:10:15.76,1:10:19.63,Default,,0000,0000,0000,,بافتراض أنّه أخو أمّي التي\N...تُوفيت قبل 15 عاماً حقّاً
Dialogue: 0,1:10:19.80,1:10:23.33,Default,,0000,0000,0000,,...وأنّه يكنّ الضغينة تّجاه عائلتنا، عائلة يابوتشي
Dialogue: 0,1:10:23.33,1:10:25.39,Default,,0000,0000,0000,,فهمت
Dialogue: 0,1:10:25.39,1:10:29.30,Default,,0000,0000,0000,,استغلّ تجمّعنا هنا لجلسة قراءة الوصيّة
Dialogue: 0,1:10:29.30,1:10:32.79,Default,,0000,0000,0000,,ونصب مسدّس القوس والسهم هناك
Dialogue: 0,1:10:33.32,1:10:36.05,Default,,0000,0000,0000,,أيعني ذلك أنّه كان\Nبمقدور أيّ أحد فعلها؟
Dialogue: 0,1:10:36.05,1:10:38.96,Default,,0000,0000,0000,,لا، لا يبدو ذلك
Dialogue: 0,1:10:38.96,1:10:40.58,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,1:10:40.58,1:10:43.96,Default,,0000,0000,0000,,فلتنظروا للغرفة في الجانب الآخر\Nالتي اخترق السهم حائطها
Dialogue: 0,1:10:44.37,1:10:48.37,Default,,0000,0000,0000,,أترون ثقوب الأسهم العديدة على التاتامي؟
Dialogue: 0,1:10:48.37,1:10:52.96,Default,,0000,0000,0000,,إنّها دليلٌ على إجراء الفاعل\Nلتجارب إطلاق سلفاً
Dialogue: 0,1:10:53.70,1:10:57.24,Default,,0000,0000,0000,,كي يصيب الشخص الجالس في ذاك المكان
Dialogue: 0,1:11:00.10,1:11:01.35,Default,,0000,0000,0000,,حُدّد سلفاً أنّ قراءة الوصيّة
Dialogue: 0,1:11:01.35,1:11:04.58,Default,,0000,0000,0000,,ستكون في تلك الغرفة من البداية، صحيح؟
Dialogue: 0,1:11:04.58,1:11:06.36,Default,,0000,0000,0000,,نـ-نعم
Dialogue: 0,1:11:07.06,1:11:08.62,Default,,0000,0000,0000,,ذلك دليلٌ أوضح إذاً
Dialogue: 0,1:11:09.59,1:11:13.89,Default,,0000,0000,0000,,لكن يا فتى، لا يمكنك معرفة\Nمن سيجلس هناك
Dialogue: 0,1:11:13.89,1:11:15.27,Default,,0000,0000,0000,,بلى
Dialogue: 0,1:11:17.34,1:11:21.58,Default,,0000,0000,0000,,"صُوّب السهم نحو "مقعد الرئيس
Dialogue: 0,1:11:19.24,1:11:26.90,On Top,,0000,0000,0000,,{\fs22\pos(349.5,33)}المخرج
Dialogue: 0,1:11:21.48,1:11:26.90,On Top,,0000,0000,0000,,{\fs(22)\pos(154.5,138)}مقعد الشرف
Dialogue: 0,1:11:21.58,1:11:23.54,Default,,0000,0000,0000,,الأبعد مسافةً عن المخرج
Dialogue: 0,1:11:23.48,1:11:26.90,On Top,,0000,0000,0000,,{\fs22\pos(327.25,145)}المقاعد المتواضعة
Dialogue: 0,1:11:23.54,1:11:26.49,Default,,0000,0000,0000,,حيث سيجلس أكبر الأشخاص سنّاً بالطبع
Dialogue: 0,1:11:27.46,1:11:31.66,Default,,0000,0000,0000,,...أي أنّ الشخص الذي نصب القوس
Dialogue: 0,1:11:31.91,1:11:36.21,Default,,0000,0000,0000,,كان يستهدفك من البداية\Nيا عمّ يوشيفوسا
Dialogue: 0,1:11:37.41,1:11:43.42,Default,,0000,0000,0000,,أي لا يزال هناك معتوهٌ آخر يحاول\Nسلب حياتي؟ لتحمني السماء
Dialogue: 0,1:11:43.65,1:11:46.23,Default,,0000,0000,0000,,لكن أليس هناك احتمالٌ آخر؟
Dialogue: 0,1:11:46.23,1:11:50.12,Default,,0000,0000,0000,,ماذا لو كان العمّ\Nمن نصب السهم بنفسه؟
Dialogue: 0,1:11:51.30,1:11:57.09,Default,,0000,0000,0000,,لا أظنّ ذلك، فقد تفاداه بالكاد\Nبعد استجابته لصوت كونان
Dialogue: 0,1:11:57.72,1:11:58.84,Default,,0000,0000,0000,,!انخفض
Dialogue: 0,1:12:01.21,1:12:06.04,Default,,0000,0000,0000,,أي أنّ كلّ هذا من تدبير ذاك الشخص \Nالمريب بالنظّارات الشمسية؟
Dialogue: 0,1:12:06.04,1:12:09.07,Default,,0000,0000,0000,,أجل، إنّه احتمالٌ عالٍ
Dialogue: 0,1:12:10.20,1:12:14.04,Default,,0000,0000,0000,,...المعذرة... آسفٌ على المقاطعة
Dialogue: 0,1:12:14.41,1:12:17.75,Default,,0000,0000,0000,,لكن ألا علينا إيقاف ذاك المسجّل؟
Dialogue: 0,1:12:19.13,1:12:21.41,Default,,0000,0000,0000,,!كلا! تركتُه على وضعيّة التسجيل
Dialogue: 0,1:12:22.14,1:12:25.25,Default,,0000,0000,0000,,!أنت! هل مُحيت وصيّة أبي كلّها؟
Dialogue: 0,1:12:26.79,1:12:28.07,Default,,0000,0000,0000,,!أيّها الوغد
Dialogue: 0,1:12:28.07,1:12:29.30,Default,,0000,0000,0000,,!تبّاً، تبّاً
Dialogue: 0,1:12:29.30,1:12:32.18,Default,,0000,0000,0000,,وضعتُه على الجانب ب\Nبدل الجانب أ عن طريق الخطأ
Dialogue: 0,1:12:32.75,1:12:36.38,Default,,0000,0000,0000,,مما يعني أنّ التسجيل كان\N!على الجانب ب
Dialogue: 0,1:12:36.38,1:12:39.43,Default,,0000,0000,0000,,!الوصيّة سليمة على الجانب أ
Dialogue: 0,1:12:40.55,1:12:42.12,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,1:12:42.12,1:12:44.71,Default,,0000,0000,0000,,!فلتسمعنا إيّاها سريعاً إذاً
Dialogue: 0,1:12:44.71,1:12:48.13,Default,,0000,0000,0000,,اهدأ رجاءً، سأعيدها للبداية الآن
Dialogue: 0,1:12:48.13,1:12:51.95,Default,,0000,0000,0000,,بأيّ حال، لا أظنّنا سنتمكن\Nمن حلّ هذه القضيّة
Dialogue: 0,1:12:51.95,1:12:53.95,Default,,0000,0000,0000,,دون معرفة هويّة ذاك الشخص المُريب
Dialogue: 0,1:12:53.95,1:12:58.13,Default,,0000,0000,0000,,أجل، لكنّي شكّلتُ صورةً واضحة\Nلهويّة من نصب القوس
Dialogue: 0,1:12:58.83,1:13:00.62,Default,,0000,0000,0000,,لا بدّ أنّه ذاك الشخص
Dialogue: 0,1:13:00.62,1:13:04.53,Default,,0000,0000,0000,,أ-أتقصد أنّه في هذه الغرفة؟
Dialogue: 0,1:13:04.53,1:13:05.63,Default,,0000,0000,0000,,أجل
Dialogue: 0,1:13:06.49,1:13:08.98,Default,,0000,0000,0000,,!من؟ من؟ أخبرني
Dialogue: 0,1:13:08.98,1:13:14.43,Default,,0000,0000,0000,,لا يمكنني، لا تزال هناك الكثير من الألغاز\Nفلا أستطيع التعجّل بالاستنتاج
Dialogue: 0,1:13:14.43,1:13:15.87,Default,,0000,0000,0000,,تلميح فحسب إذاً؟
Dialogue: 0,1:13:15.87,1:13:17.13,Default,,0000,0000,0000,,!كلا
Dialogue: 0,1:13:17.13,1:13:18.88,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,1:13:19.96,1:13:24.08,Default,,0000,0000,0000,,!لا يهمّ إذاً، سأكتشفه بنفسي
Dialogue: 0,1:13:24.34,1:13:27.13,Default,,0000,0000,0000,,!مهلك! لا تستائي يا أمّي
Dialogue: 0,1:13:29.09,1:13:30.54,Default,,0000,0000,0000,,!محقّق يامامورا
Dialogue: 0,1:13:30.54,1:13:35.04,Default,,0000,0000,0000,,وجدنا شريط كاسيت مُريب\N!بالقرب من فرن الاستحمام
Dialogue: 0,1:13:35.04,1:13:36.54,Default,,0000,0000,0000,,ماذا؟ شريط؟
Dialogue: 0,1:13:36.95,1:13:42.29,Default,,0000,0000,0000,,اسمعوا جميعاً! ابقوا في هذه الغرفة\N!حتّى أرجع رجاءً
Dialogue: 0,1:13:43.49,1:13:46.21,Default,,0000,0000,0000,,ما-ماذا؟ أين يوكيكو-سان وذاك الفتى؟
Dialogue: 0,1:13:46.61,1:13:48.37,Default,,0000,0000,0000,,خرجا للتوّ
Dialogue: 0,1:13:48.37,1:13:48.96,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,1:13:50.18,1:13:54.64,Default,,0000,0000,0000,,انتظرا، انتظرا! لا تتجوّلا\N!من تلقاء نفسيكما رجاءً
Dialogue: 0,1:13:54.64,1:13:57.38,Default,,0000,0000,0000,,إذاً، أين كان ذاك الشريط؟
Dialogue: 0,1:13:57.38,1:14:00.20,Default,,0000,0000,0000,,أ-أجل، كان بين الحطب
Dialogue: 0,1:14:00.20,1:14:01.42,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,1:14:01.42,1:14:05.75,Default,,0000,0000,0000,,جهّزت هيرومي الحمّام، لكنّها لم تذكر\Nشيئاً عن شريط
Dialogue: 0,1:14:06.91,1:14:10.62,Default,,0000,0000,0000,,إضافةً لذلك، تلقّينا اتّصالاً من فريق التحليل\Nوأبلغونا عن أمرٍ غريب
Dialogue: 0,1:14:10.62,1:14:12.04,Default,,0000,0000,0000,,أمر غريب؟
Dialogue: 0,1:14:12.37,1:14:18.55,Default,,0000,0000,0000,,وجدوا بصمات الضحيّة ماتشيكو-سان \Nودمها فقط على سلاح الجريمة
Dialogue: 0,1:14:19.12,1:14:25.23,Default,,0000,0000,0000,,ولغرابة الأمر، يبدو أنّها كانت تمسك به\Nكسكّين بناءً على بصماتها
Dialogue: 0,1:14:26.28,1:14:27.86,Default,,0000,0000,0000,,كـ-كسكّين؟
Dialogue: 0,1:14:27.86,1:14:29.00,Default,,0000,0000,0000,,أجل
Dialogue: 0,1:14:29.00,1:14:30.91,Default,,0000,0000,0000,,ذلك غريبٌ بالفعل
Dialogue: 0,1:14:31.31,1:14:34.56,Default,,0000,0000,0000,,،إذا أمسكت بالمقبض بعدما طُعنت
Dialogue: 0,1:14:34.56,1:14:36.34,Default,,0000,0000,0000,,فيُفترض أنّ الآثار مقلوبة
Dialogue: 0,1:14:37.14,1:14:41.30,Default,,0000,0000,0000,,لو وُضعت السكّين في يدها\N،كي يبدو انتحاراً
Dialogue: 0,1:14:41.30,1:14:43.04,Default,,0000,0000,0000,,لكان قلبها سيكون منطقياً أيضاً
Dialogue: 0,1:14:43.47,1:14:50.29,Default,,0000,0000,0000,,إضافةً لذلك، اتّصلتُ بالفندق الذي\Nذهبت له الضحيّة قبل مقتلها
Dialogue: 0,1:14:50.29,1:14:51.75,Default,,0000,0000,0000,,وماذا وجدت؟
Dialogue: 0,1:14:52.04,1:14:57.37,Default,,0000,0000,0000,,يبدو أنّها ذهبت هناك بالفعل، لكنّهم لا يعرفون\Nمتى غادرت بالضبط
Dialogue: 0,1:14:57.37,1:15:01.32,Default,,0000,0000,0000,,بالمناسبة، قالت هيرومي كلاماً غريباً
Dialogue: 0,1:15:01.32,1:15:06.61,Default,,0000,0000,0000,,بأنّ الراحلة ماتشيكو-سان أخبرتها أنّها\Nسترجع بعد الحادية عشرة للبيت
Dialogue: 0,1:15:07.61,1:15:10.75,Default,,0000,0000,0000,,فلمَ رجعت بعد العاشرة؟
Dialogue: 0,1:15:11.65,1:15:12.57,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,1:15:15.10,1:15:19.58,Default,,0000,0000,0000,,باستعمالك هذا الباب، ستخرج من الحمّام للفرن مباشرةً
Dialogue: 0,1:15:19.58,1:15:24.47,Default,,0000,0000,0000,,وهذا الفرن بجوار البئر\N!حيث أُخفيت الجثّة
Dialogue: 0,1:15:26.05,1:15:28.59,Default,,0000,0000,0000,,...مما يعني أنّ ذاك الشريط
Dialogue: 0,1:15:28.97,1:15:29.86,Default,,0000,0000,0000,,أيمكن؟
Dialogue: 0,1:15:30.79,1:15:33.63,Default,,0000,0000,0000,,بأيّ حال، لنسمع ما على الشريط
Dialogue: 0,1:15:40.74,1:15:42.87,Default,,0000,0000,0000,,ما الذي تفعلينه يا أمّي؟
Dialogue: 0,1:15:42.87,1:15:43.57,Default,,0000,0000,0000,,أخبرني
Dialogue: 0,1:15:43.57,1:15:49.30,Default,,0000,0000,0000,,قلتَ أنّ ذاك الشخص بالنظّارات الشمسية\Nكان يراقب من هذه البوّابة، صحيح؟
Dialogue: 0,1:15:49.30,1:15:53.94,Default,,0000,0000,0000,,أجل، رأته هيرومي-سان يهرب عبرها أيضاً
Dialogue: 0,1:15:59.23,1:16:02.46,Default,,0000,0000,0000,,ماذا؟ أوجدتِ شيئاً؟
Dialogue: 0,1:16:02.97,1:16:04.60,Default,,0000,0000,0000,,لا شيء
Dialogue: 0,1:16:05.60,1:16:08.46,Default,,0000,0000,0000,,!أسرعا! ارجعا للغرفة
Dialogue: 0,1:16:08.46,1:16:12.84,Default,,0000,0000,0000,,!هيّا، لنذهب لسماع ما على الشريط يا صغيري كونان-تشان
Dialogue: 0,1:16:12.84,1:16:14.96,Default,,0000,0000,0000,,!كفّي عن الكلام هكذا
Dialogue: 0,1:16:15.25,1:16:17.90,Default,,0000,0000,0000,,!ماتشيكو-تشان! لنشرب معاً
Dialogue: 0,1:16:18.54,1:16:21.91,Default,,0000,0000,0000,,هذا من الحفلة التي ذهبت لها أمّي
Dialogue: 0,1:16:21.91,1:16:24.70,Default,,0000,0000,0000,,أكان هذا الشريط عند الفرن حقّاً؟
Dialogue: 0,1:16:24.70,1:16:25.83,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,1:16:25.83,1:16:31.83,Default,,0000,0000,0000,,كما ظننت، هذا يوضّح كلّ أفعال\N!ماتشيكو-سان الغريبة
Dialogue: 0,1:16:32.15,1:16:37.88,Default,,0000,0000,0000,,!وقاتلها كان الشخص الذي تفوّه بأمرٍ غريب
Dialogue: 0,1:16:38.82,1:16:42.18,Default,,0000,0000,0000,,أمّي، سأحتاج مساعدتك
Dialogue: 0,1:16:42.18,1:16:43.83,Default,,0000,0000,0000,,وجدتُ الفاعل
Dialogue: 0,1:16:45.01,1:16:49.21,Default,,0000,0000,0000,,سأشرح استنتاجاتي بصوتك، فطابقي كلامي فحسب
Dialogue: 0,1:16:50.00,1:16:51.16,Default,,0000,0000,0000,,كلا
Dialogue: 0,1:16:52.21,1:16:56.00,Default,,0000,0000,0000,,لا تقل ذلك وأنت قد رفضت\Nإخباري بأيّ شيء قبل قليل
Dialogue: 0,1:16:56.00,1:16:58.27,Default,,0000,0000,0000,,إذا أردت فعل ذلك، فافعله بمفردك
Dialogue: 0,1:17:00.20,1:17:03.79,Default,,0000,0000,0000,,!لأنّي أعرف شيئاً تجهله يا شين-تشان
Dialogue: 0,1:17:03.79,1:17:05.52,Default,,0000,0000,0000,,!ما-ما ذلك؟
Dialogue: 0,1:17:05.71,1:17:07.66,Default,,0000,0000,0000,,من يعلم؟
Dialogue: 0,1:17:07.66,1:17:11.20,Default,,0000,0000,0000,,لا يهمّ، لا تعترضي طريقي فحسب
Dialogue: 0,1:17:11.94,1:17:16.98,Default,,0000,0000,0000,,حسناً، لنستمع لشريط الوصيّة حالياً، ما رأيكم؟
Dialogue: 0,1:17:16.98,1:17:17.96,Default,,0000,0000,0000,,أجل
Dialogue: 0,1:17:23.10,1:17:25.35,Default,,0000,0000,0000,,حـ-حضرة المحقّق؟
Dialogue: 0,1:17:25.35,1:17:30.37,Default,,0000,0000,0000,,ذلك ما أودّ قوله، لكن يمكن تأجيل الوصيّة\Nلحين انتهائي من شرح استنتاجي
Dialogue: 0,1:17:31.26,1:17:36.38,Default,,0000,0000,0000,,بعدما أكشف هويّة الفاعل وراء الحادثتين هنا
Dialogue: 0,1:17:36.38,1:17:37.50,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,1:17:37.96,1:17:39.95,Default,,0000,0000,0000,,لنبدأ بالحادثة الثانية حيث
Dialogue: 0,1:17:39.95,1:17:43.20,Default,,0000,0000,0000,,صُوّب مسدس القوس الخفيّ\Nنحو السيّد يوشيفوسا
Dialogue: 0,1:17:44.16,1:17:48.17,Default,,0000,0000,0000,,مهلك، ألم يكن الشخص بالنظّارات\Nالشمسية وراء ذلك؟
Dialogue: 0,1:17:48.54,1:17:50.74,Default,,0000,0000,0000,,،ظننتُ ذلك أيضاً
Dialogue: 0,1:17:50.74,1:17:53.62,Default,,0000,0000,0000,,حتّى سمعتُ شخصاً يتفوَه بشيءٍ معيّن
Dialogue: 0,1:17:54.07,1:17:55.61,Default,,0000,0000,0000,,شيء معيّن؟
Dialogue: 0,1:17:55.61,1:17:59.37,Default,,0000,0000,0000,,لمَ لا نستمع إذاً؟ فيُفترض أنّه موجود
Dialogue: 0,1:17:59.37,1:18:02.93,Default,,0000,0000,0000,,على الجانب ب لشريط الوصيّة
Dialogue: 0,1:18:02.93,1:18:05.38,Default,,0000,0000,0000,,حضرة المحامي، شغّله رجاءً
Dialogue: 0,1:18:05.38,1:18:07.13,Default,,0000,0000,0000,,...لا-لا يُعقل
Dialogue: 0,1:18:09.92,1:18:13.12,Default,,0000,0000,0000,,لـ-لنشغّله إذاً
Dialogue: 0,1:18:13.12,1:18:14.84,Default,,0000,0000,0000,,!انخفض
Dialogue: 0,1:18:14.84,1:18:16.47,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,1:18:16.47,1:18:17.76,Default,,0000,0000,0000,,!ما كان ذلك؟
Dialogue: 0,1:18:17.76,1:18:21.41,Default,,0000,0000,0000,,!الـ-الخزانة! خرج سهم من تلك الخزانة
Dialogue: 0,1:18:21.41,1:18:22.12,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:18:22.62,1:18:24.50,Default,,0000,0000,0000,,!مـ-مسدّس قوس
Dialogue: 0,1:18:24.50,1:18:26.21,Default,,0000,0000,0000,,ما في هذا إذاً؟
Dialogue: 0,1:18:26.21,1:18:28.13,Default,,0000,0000,0000,,ألا تجدون الأمر غريباً؟
Dialogue: 0,1:18:28.46,1:18:33.29,Default,,0000,0000,0000,,كما تعلمون، السهم الذي أُطلق من الخزانة
Dialogue: 0,1:18:34.24,1:18:36.25,Default,,0000,0000,0000,,عبرَ الغرفة بلمح البصر
Dialogue: 0,1:18:36.82,1:18:40.50,Default,,0000,0000,0000,,اخترق الحائط وغادر مجال نظرنا
Dialogue: 0,1:18:40.81,1:18:45.00,Default,,0000,0000,0000,,مع ذلك، ميّزه شخصٌ ما بدقّة على أنّه سهم
Dialogue: 0,1:18:45.73,1:18:49.55,Default,,0000,0000,0000,,قبل أن نفتح الخزانة ونكتشف\Nأنّه مسدس قوس حتّى
Dialogue: 0,1:18:50.55,1:18:52.50,Default,,0000,0000,0000,,لمَ ذلك؟
Dialogue: 0,1:18:52.88,1:18:55.54,Default,,0000,0000,0000,,...أ-أيمكن؟ كيكو، أنتِ
Dialogue: 0,1:18:55.80,1:18:58.88,Default,,0000,0000,0000,,صحيح، السبب بسيط
Dialogue: 0,1:18:58.88,1:19:04.50,Default,,0000,0000,0000,,من نصبت مسدّس القوس ذاك\N!كانت أنت يا كيكو-سان
Dialogue: 0,1:19:04.87,1:19:06.29,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:19:06.29,1:19:10.20,Default,,0000,0000,0000,,لـ-لكن لا يكفي ذلك لإثبات\N...أنّ كيكو هي الفاعلة
Dialogue: 0,1:19:10.53,1:19:16.36,Default,,0000,0000,0000,,!صحيح، أنا من نصبته\Nفي اليوم الذي رجع فيه العمّ يوشيفوسا
Dialogue: 0,1:19:16.36,1:19:18.09,Default,,0000,0000,0000,,...كـ-كيكو
Dialogue: 0,1:19:18.70,1:19:22.12,Default,,0000,0000,0000,,أوقعتنا في دين، وأخفيتُ الأمر عنك
Dialogue: 0,1:19:22.52,1:19:25.83,Default,,0000,0000,0000,,كان مقداراً كبيراً، وبفائدة متزايدة حتّى
Dialogue: 0,1:19:26.15,1:19:29.02,Default,,0000,0000,0000,,ظننت أنّ بحصولي على\N،حصّتي من الميراث
Dialogue: 0,1:19:29.02,1:19:32.83,Default,,0000,0000,0000,,سأستطيع دفعه كاملاً دون أن تعلم عنه
Dialogue: 0,1:19:33.43,1:19:39.20,Default,,0000,0000,0000,,لكن عندما سمعت أنّ العمّ رجع\Nمن البرازيل، فقدتُ رشدي
Dialogue: 0,1:19:40.17,1:19:42.50,Default,,0000,0000,0000,,لم أنو قتله
Dialogue: 0,1:19:42.50,1:19:46.75,Default,,0000,0000,0000,,أردتُ إخافته قليلاً بحيث يرجع للبرازيل فحسب
Dialogue: 0,1:19:46.75,1:19:48.99,Default,,0000,0000,0000,,وجّهتُه بحيث يخطئ الإصابة حتّى
Dialogue: 0,1:19:50.07,1:19:53.31,Default,,0000,0000,0000,,!لم أتوقّع أن يقترب منه لذاك الحدّ
Dialogue: 0,1:19:54.20,1:19:58.50,Default,,0000,0000,0000,,لكن لا يهمّ، بما أنّك من قتلتِ أمّي
Dialogue: 0,1:19:58.50,1:19:59.45,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:19:59.73,1:20:01.87,Default,,0000,0000,0000,,كان ذلك من فعلك أيضاً، أليس كذلك؟
Dialogue: 0,1:20:01.87,1:20:05.04,Default,,0000,0000,0000,,!كـ-كلا! لم تكن تلك أنا
Dialogue: 0,1:20:05.04,1:20:07.50,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,1:20:07.85,1:20:09.74,Default,,0000,0000,0000,,!إنّها الحقيقة! صدّقوني
Dialogue: 0,1:20:10.26,1:20:12.33,Default,,0000,0000,0000,,إنّها محقّة
Dialogue: 0,1:20:12.64,1:20:16.59,Default,,0000,0000,0000,,من قتل ماتشيكو-سان \N...وأخفى جثّتها في البئر
Dialogue: 0,1:20:17.05,1:20:18.34,Default,,0000,0000,0000,,هو شخصٌ آخر
Dialogue: 0,1:20:18.64,1:20:20.87,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,1:20:20.87,1:20:21.92,Default,,0000,0000,0000,,!من؟
Dialogue: 0,1:20:21.92,1:20:23.62,Default,,0000,0000,0000,,!من كان؟
Dialogue: 0,1:20:24.00,1:20:27.63,Default,,0000,0000,0000,,هيّا، أصب باستنتاجك يا شينتشي
Dialogue: 0,1:20:27.63,1:20:30.12,Default,,0000,0000,0000,,...الفاعل
Dialogue: 0,1:20:30.25,1:20:32.33,Default,,0000,0000,0000,,سنشاهد
Dialogue: 0,1:20:39.24,1:20:40.12,Default,,0000,0000,0000,,أجل
Dialogue: 0,1:20:40.12,1:20:45.38,Default,,0000,0000,0000,,من قتل ماتشيكو-سان \N...وأخفى جثّتها في البئر
Dialogue: 0,1:20:45.66,1:20:49.63,Default,,0000,0000,0000,,!أنت! لا تخبرنا أنّه الرجل بالنظّارات الشمسية
Dialogue: 0,1:20:50.11,1:20:54.06,Default,,0000,0000,0000,,إنّه أخو أمّنا الذي لا يزال\Nيلومنا على سقوط أمّنا
Dialogue: 0,1:20:54.06,1:20:58.13,Default,,0000,0000,0000,,!في البئر قبل 15 عاماً
Dialogue: 0,1:21:00.22,1:21:04.88,Default,,0000,0000,0000,,لديه الدافع، لكن أيمكنك تأجيل\Nكلامك لحين القبض عليه؟
Dialogue: 0,1:21:05.30,1:21:08.14,Default,,0000,0000,0000,,كلا، إنّه مُتحرٍّ عُيّن للتحقّق من كون
Dialogue: 0,1:21:08.14,1:21:12.88,Default,,0000,0000,0000,,السيّد بوشيفوسا هو نفسه أم لا غالباً
Dialogue: 0,1:21:13.20,1:21:16.96,Default,,0000,0000,0000,,...تـ-تمهّل، إذا لم يكن هو القاتل فذلك يعني
Dialogue: 0,1:21:16.96,1:21:18.64,Default,,0000,0000,0000,,...لا-لا يمكن
Dialogue: 0,1:21:18.64,1:21:25.68,Default,,0000,0000,0000,,بلى، قاتل ماتشيكو-سان موجودٌ\Nفي هذه الغرفة
Dialogue: 0,1:21:26.51,1:21:33.38,Default,,0000,0000,0000,,مهلك! سمعتَ أنّها اتّصلت من الفندق\N!عند المحطّة في التاسعة ليلة البارحة
Dialogue: 0,1:21:33.38,1:21:38.32,Default,,0000,0000,0000,,،حتّى لو غادرت فور انتهاء المكالمة\Nستصل هنا بعد العاشرة
Dialogue: 0,1:21:38.32,1:21:42.38,Default,,0000,0000,0000,,كنّا جميعاً في نفس الغرفة هنا منذ\Nالعاشرة، فيستحيل أنّ أحدنا القاتل
Dialogue: 0,1:21:42.38,1:21:44.74,Default,,0000,0000,0000,,فكّروا بهذا الاحتمال
Dialogue: 0,1:21:45.35,1:21:49.38,Default,,0000,0000,0000,,بعد الثامنة بقليل، أجرت ماتشيكو-سان \Nاتّصالها الأوّل من الحفلة
Dialogue: 0,1:21:49.38,1:21:51.88,Default,,0000,0000,0000,,ثمّ غادرت القاعة فوراً
Dialogue: 0,1:21:51.88,1:21:55.80,Default,,0000,0000,0000,,وبعد التاسعة، ركنت سيّارتها في الغابة
Dialogue: 0,1:21:55.80,1:22:00.37,Default,,0000,0000,0000,,وشغّلت تسجيلاً من الحفلة\Nعلى مشغّل تسجيلات السيّارة
Dialogue: 0,1:22:00.37,1:22:01.88,Default,,0000,0000,0000,,وأجرت اتّصالها الثاني
Dialogue: 0,1:22:02.58,1:22:06.39,Default,,0000,0000,0000,,كي توهمنا أنّها لا تزال في الحفلة
Dialogue: 0,1:22:06.39,1:22:12.17,Default,,0000,0000,0000,,كانت هي من قُتلت، فلمَ تصنع لنفسها حجّة غياب؟
Dialogue: 0,1:22:12.43,1:22:15.48,Default,,0000,0000,0000,,لأنّ الواقع كان عكس المخطّطات
Dialogue: 0,1:22:15.48,1:22:16.18,Default,,0000,0000,0000,,عكس؟
Dialogue: 0,1:22:16.18,1:22:18.55,Default,,0000,0000,0000,,...عكس؟ ما قصدك
Dialogue: 0,1:22:19.36,1:22:25.80,Default,,0000,0000,0000,,نوت ماتشيكو-سان استعمال حيلة\Nحجّة الغياب تلك لقتل شخص
Dialogue: 0,1:22:26.10,1:22:30.09,Default,,0000,0000,0000,,لكنّها قُتلت على يده بدل ذلك
Dialogue: 0,1:22:30.55,1:22:32.13,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:22:32.46,1:22:41.26,Default,,0000,0000,0000,,لسخرية الأمر، ساهمت حيلتها\Nفي صنع حجّة غياب قاتلها
Dialogue: 0,1:22:42.12,1:22:44.54,Default,,0000,0000,0000,,...معطف المطر الذي وجدناه في البئر
Dialogue: 0,1:22:44.54,1:22:50.80,Default,,0000,0000,0000,,ارتدته سلفاً كيلا تصل دماء الضحيّة ثيابها
Dialogue: 0,1:22:51.49,1:22:53.86,Default,,0000,0000,0000,,...وزهرة الكاميليا
Dialogue: 0,1:22:53.86,1:22:58.86,Default,,0000,0000,0000,,كانت قد وضعتها في جيبها\Nكي تسقطها في مسرح الجريمة لاحقاً
Dialogue: 0,1:22:58.86,1:23:02.44,Default,,0000,0000,0000,,فتجعله يبدو متّصلاً بالحادثة\Nقبل 15 عاماً
Dialogue: 0,1:23:04.52,1:23:06.77,Default,,0000,0000,0000,,،أمّا الشريط على الحطب
Dialogue: 0,1:23:06.77,1:23:12.10,Default,,0000,0000,0000,,فقد سقط منها في طريقها\N،لهدفها الذي كان في الحمّام
Dialogue: 0,1:23:12.76,1:23:20.71,Default,,0000,0000,0000,,أو سقط من جيبها بينما كانت\Nجثّتها تُنقل للبئر
Dialogue: 0,1:23:20.71,1:23:26.79,Default,,0000,0000,0000,,أيّاً يكن، فقد خطّطت لحرقه في الفرن غالباً
Dialogue: 0,1:23:29.24,1:23:32.46,Default,,0000,0000,0000,,وقعت الجريمة داخل الحمّام  على الأرجح
Dialogue: 0,1:23:32.46,1:23:37.76,Default,,0000,0000,0000,,هناك، حتّى لو تناثر الدمّ \Nفيمكن غسله بسهولة
Dialogue: 0,1:23:37.76,1:23:42.80,Default,,0000,0000,0000,,إذاً، من هذا الشخص الذي\N!قتلها أوّلاً في الحمّام؟
Dialogue: 0,1:23:43.06,1:23:48.80,Default,,0000,0000,0000,,كان هدف ماتشيكو-سان هو شخص\N،معروفٌ عنه حبّه للاستحمام اليوميّ
Dialogue: 0,1:23:48.80,1:23:52.80,Default,,0000,0000,0000,,والشخص الوحيد الذي كان\Nترتيبه في الاستحمام ثابتاً
Dialogue: 0,1:23:52.93,1:23:53.92,Default,,0000,0000,0000,,...أي
Dialogue: 0,1:23:54.80,1:23:57.09,Default,,0000,0000,0000,,!أنت يا يابوتشي يوشيفوسا-سان
Dialogue: 0,1:23:58.59,1:24:01.38,Default,,0000,0000,0000,,!عمّي؟ لا يمكن
Dialogue: 0,1:24:01.38,1:24:05.59,Default,,0000,0000,0000,,وفقما أذكر، توجد في الجوجوتسو\N...البرازيلية تقنية ما
Dialogue: 0,1:24:06.21,1:24:08.76,Default,,0000,0000,0000,,،تلوي بها ذراع مُهاجم مسلّح بسكّين
Dialogue: 0,1:24:08.99,1:24:11.59,Default,,0000,0000,0000,,وتجعله يطعن نفسه
Dialogue: 0,1:24:12.03,1:24:17.34,Default,,0000,0000,0000,,عندما هاجمتك ماتشيكو-سان، لجأت لتلك التقنية دون تفكير
Dialogue: 0,1:24:17.70,1:24:22.67,Default,,0000,0000,0000,,رفع نسبتها من الميراث كان دافعها غالباً
Dialogue: 0,1:24:23.06,1:24:28.68,Default,,0000,0000,0000,,،لـ-لكن سيكون ذلك دفاعاً عن النفس\Nفلمَ أخفى العمّ الأمر؟
Dialogue: 0,1:24:28.68,1:24:34.84,Default,,0000,0000,0000,,لأنّه تلقّى رسالتَي تهديد
Dialogue: 0,1:24:35.14,1:24:39.21,Default,,0000,0000,0000,,أي لا يزال هناك معتوهٌ آخر يحاول\Nسلب حياتي؟
Dialogue: 0,1:24:39.54,1:24:43.76,Default,,0000,0000,0000,,أشار ذلك لتعرّضه للهجوم سابقاً\Nمن قِبل شخص آخر بوضوح
Dialogue: 0,1:24:44.33,1:24:47.83,Default,,0000,0000,0000,,أي أنّ ماتشيكو-سان أرسلت رسالة تهديد بدورها
Dialogue: 0,1:24:47.83,1:24:51.02,Default,,0000,0000,0000,,مثل كيكو-سان التي نصبت السهم
Dialogue: 0,1:24:51.09,1:24:55.41,Default,,0000,0000,0000,,أفترض أنّه ربط الجثّة بحبل البئر\Nوجعلها سهلة الاكتشاف
Dialogue: 0,1:24:55.41,1:24:58.82,Default,,0000,0000,0000,,كي يجعلها عِبرة للمُهدّد الآخر
Dialogue: 0,1:24:58.82,1:25:02.94,Default,,0000,0000,0000,,أيّاً يكن، كان دفاعاً عن النفس في الأساس
Dialogue: 0,1:25:05.02,1:25:08.05,Default,,0000,0000,0000,,هلّا اعترفت يا يوشيفوسا-سان؟
Dialogue: 0,1:25:09.51,1:25:11.35,Default,,0000,0000,0000,,لا يزال ينقصك الكثير
Dialogue: 0,1:25:14.35,1:25:16.35,Default,,0000,0000,0000,,!أنت! من تكون؟
Dialogue: 0,1:25:20.42,1:25:21.88,Default,,0000,0000,0000,,!الرجل بالنظّارات الشمسية
Dialogue: 0,1:25:21.88,1:25:23.30,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:25:23.52,1:25:28.26,Default,,0000,0000,0000,,شريط الوصيّة، الاستماع له سيوضّح كلّ شيء
Dialogue: 0,1:25:28.63,1:25:29.91,Default,,0000,0000,0000,,أسرع
Dialogue: 0,1:25:29.91,1:25:31.30,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,1:25:32.80,1:25:38.12,Default,,0000,0000,0000,,:أقسّم ميراثي بين هؤلاء الأشخاص الستّة
Dialogue: 0,1:25:38.12,1:25:43.19,Default,,0000,0000,0000,,،زوجتي ماتشيكو، ابنتي هيرومي، زوجها هيديكازو
Dialogue: 0,1:25:43.19,1:25:46.44,Default,,0000,0000,0000,,،ابني يوشيوكي، زوجته كيكو
Dialogue: 0,1:25:46.44,1:25:48.69,Default,,0000,0000,0000,,وكارلوس
Dialogue: 0,1:25:49.41,1:25:54.30,Default,,0000,0000,0000,,!كـ-كارلوس؟! لمَ اسمه مذكور؟
Dialogue: 0,1:25:54.89,1:25:59.75,Default,,0000,0000,0000,,أقسّم ميراثي بتساوٍ بين هؤلاء الستّة
Dialogue: 0,1:25:59.75,1:26:04.17,Default,,0000,0000,0000,,هذا غريب! لمَ اسمك ليس \N!موجوداً يا عمّي؟
Dialogue: 0,1:26:04.17,1:26:06.68,Default,,0000,0000,0000,,ذلك طبيعيّ
Dialogue: 0,1:26:06.96,1:26:11.88,Default,,0000,0000,0000,,فهذا المُسنّ هو الحارس الشخصيّ\Nالذي أتى من البرازيل
Dialogue: 0,1:26:12.33,1:26:14.93,Default,,0000,0000,0000,,لحماية كارلوس
Dialogue: 0,1:26:15.16,1:26:16.39,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,1:26:16.87,1:26:18.95,Default,,0000,0000,0000,,من يكون كارلوس إذاً؟
Dialogue: 0,1:26:20.53,1:26:26.30,Default,,0000,0000,0000,,ابن يوشيفوسا-سان الحقيقيّ وامرأة برازيليّة
Dialogue: 0,1:26:26.30,1:26:27.86,Default,,0000,0000,0000,,ا-ابن؟
Dialogue: 0,1:26:28.44,1:26:31.92,Default,,0000,0000,0000,,لكن أيّها المتحرّي، أين اكتشفت ذلك؟
Dialogue: 0,1:26:31.92,1:26:34.43,Default,,0000,0000,0000,,لا، لستُ متحريّاً
Dialogue: 0,1:26:36.77,1:26:38.88,Default,,0000,0000,0000,,أنا مجرّد مؤلّف روايات غموض
Dialogue: 0,1:26:39.38,1:26:40.67,Default,,0000,0000,0000,,!يوساكو-سان
Dialogue: 0,1:26:40.93,1:26:43.63,Default,,0000,0000,0000,,!ماذا؟! أ-أبي
Dialogue: 0,1:26:43.81,1:26:46.30,Default,,0000,0000,0000,,يوساكو-سان! لمَ أنت هنا؟
Dialogue: 0,1:26:46.30,1:26:48.55,Default,,0000,0000,0000,,حسناً، بعض الأمور
Dialogue: 0,1:26:49.54,1:26:53.12,Default,,0000,0000,0000,,لكن، أهذا الشخص ليس عمّنا حقّاً؟
Dialogue: 0,1:26:53.12,1:26:56.01,Default,,0000,0000,0000,,!إنّه أعسر، وخطّ كتابته مُطابق
Dialogue: 0,1:26:56.01,1:26:59.82,Default,,0000,0000,0000,,العالم مليء بالعُسر
Dialogue: 0,1:26:59.82,1:27:01.82,Default,,0000,0000,0000,,من الطبيعيّ أن يتطابق الخطّ
Dialogue: 0,1:27:01.82,1:27:05.97,Default,,0000,0000,0000,,فقد كان هذا المُسنّ\Nيكتب مكان السيّد يوشيفوسا
Dialogue: 0,1:27:07.36,1:27:12.35,Default,,0000,0000,0000,,كان السيّد يوشيفوسا وهذا المُسنّ\Nصديقين يتشاركان مزرعة في البرازيل
Dialogue: 0,1:27:13.43,1:27:18.10,Default,,0000,0000,0000,,،لكن عندما هبّ إعصار قبل 10 أعوام\Nأُصيبت ساق المُسن اليمنى
Dialogue: 0,1:27:18.10,1:27:21.21,Default,,0000,0000,0000,,بينما فقد السيّد يوشيفوسا ذراعه اليسرى
Dialogue: 0,1:27:21.76,1:27:26.93,Default,,0000,0000,0000,,مُذ ذاك اليوم، كان المُسن يكتب مكانه
Dialogue: 0,1:27:28.55,1:27:31.08,Default,,0000,0000,0000,,تلقّى كارلوس نصيباً من الميراث
Dialogue: 0,1:27:31.08,1:27:35.33,Default,,0000,0000,0000,,لأنّ السيّد يوشيتشيكا تعاطف\Nمع شقيقه الذي فقد مزرعته
Dialogue: 0,1:27:35.33,1:27:38.42,Default,,0000,0000,0000,,ومات من مرض قبل نصف عام
Dialogue: 0,1:27:39.99,1:27:42.46,Default,,0000,0000,0000,,كلّ ذلك مذكورٌ هنا
Dialogue: 0,1:27:43.15,1:27:46.45,Default,,0000,0000,0000,,في كومة الرسائل التي كانت\Nفي لوح مخفيّ في المخزن
Dialogue: 0,1:27:47.99,1:27:50.39,Default,,0000,0000,0000,,لكن لمَ تظاهرت بأنّك عمّنا؟
Dialogue: 0,1:27:50.39,1:27:52.30,Default,,0000,0000,0000,,أيمكن لسرقة المال؟
Dialogue: 0,1:27:52.30,1:27:56.48,Default,,0000,0000,0000,,لو كانت تلك نيّته، لما أخذ دور شخص
Dialogue: 0,1:27:56.48,1:27:58.30,Default,,0000,0000,0000,,حياته تحت التهديد
Dialogue: 0,1:27:58.97,1:28:01.68,Default,,0000,0000,0000,,لو اكتشف الآخرون أنّ كارلوس\N،هو ابن السيّد بوشيفوسا
Dialogue: 0,1:28:01.68,1:28:04.59,Default,,0000,0000,0000,,كان ليتعرّض لاستهداف المُهدّدين بلا شكّ
Dialogue: 0,1:28:04.59,1:28:08.30,Default,,0000,0000,0000,,لذا لعب المُسنّ دور السيّد يوشيفوسا
Dialogue: 0,1:28:09.00,1:28:13.23,Default,,0000,0000,0000,,كي يحوّل هجمات المُهدّدين نحوه
Dialogue: 0,1:28:13.26,1:28:16.50,Default,,0000,0000,0000,,والدليل على ذلك هو ترك المُسن لكارلوس
Dialogue: 0,1:28:16.50,1:28:18.26,Default,,0000,0000,0000,,في الغرفة الأخرى بينما يذهب للاستحمام
Dialogue: 0,1:28:19.11,1:28:22.20,Default,,0000,0000,0000,,لأنّ إيهام الجميع أنّه يراقبهم
Dialogue: 0,1:28:22.20,1:28:24.30,Default,,0000,0000,0000,,سيكون أكثر أماناً له
Dialogue: 0,1:28:24.30,1:28:27.24,Default,,0000,0000,0000,,،نوى المُسنّ الإمساك بالمُهدّد
Dialogue: 0,1:28:27.24,1:28:29.77,Default,,0000,0000,0000,,لكن انتهى به المطاف بقتله
Dialogue: 0,1:28:29.77,1:28:32.19,Default,,0000,0000,0000,,،رغم أنّه كان دفاعاً عن النفس
Dialogue: 0,1:28:32.19,1:28:35.80,Default,,0000,0000,0000,,كان يجب أن يُقتاد للشرطة للاستجواب
Dialogue: 0,1:28:36.31,1:28:41.26,Default,,0000,0000,0000,,لكنّه لم يستطع ترك كارلوس بما أنّه\Nلا يزال هناك مُهدّد آخر
Dialogue: 0,1:28:41.26,1:28:45.59,Default,,0000,0000,0000,,جعل اكتشاف الجثّة سهلاً وأخفاها\Nفي البئر لمعرفة ما إذا كان المحقّق
Dialogue: 0,1:28:45.59,1:28:48.75,Default,,0000,0000,0000,,الذي سيأتي رجلاً واعياً أم لا
Dialogue: 0,1:28:48.75,1:28:52.67,Default,,0000,0000,0000,,لكنّ من أتى كان محقّقاً مبتدئاً\Nغير جدير بالثقة
Dialogue: 0,1:28:53.00,1:28:54.04,Default,,0000,0000,0000,,،لم يكن أمامه خيارٌ آخر
Dialogue: 0,1:28:54.04,1:28:58.35,Default,,0000,0000,0000,,فقرّر المُسنّ البقاء صامتاً\Nحتّى قراءة الوصيّة
Dialogue: 0,1:28:59.28,1:29:00.99,Default,,0000,0000,0000,,...فهمت
Dialogue: 0,1:29:02.08,1:29:04.07,Default,,0000,0000,0000,,هل أخطأتُ في شيء
Dialogue: 0,1:29:04.07,1:29:06.73,Default,,0000,0000,0000,,يا هيكسون تاناكا-سان، اليابانيّ البرازيليّ\Nمن الجيل الثاني؟
Dialogue: 0,1:29:08.15,1:29:12.51,Default,,0000,0000,0000,,كلّ شيءٍ كما قلت، لا خطأ واحد
Dialogue: 0,1:29:12.73,1:29:14.40,Default,,0000,0000,0000,,،إذا سلّمت نفسك للشرطة
Dialogue: 0,1:29:14.40,1:29:18.51,Default,,0000,0000,0000,,،سأعرّفك على محقّق ممتاز\Nإنّه أحد معارفي وشديد التعامل
Dialogue: 0,1:29:18.93,1:29:23.17,Default,,0000,0000,0000,,.أجل، أعتمد عليك\Nأشعر أنّ بإمكاني الثقة بك
Dialogue: 0,1:29:27.22,1:29:29.63,Default,,0000,0000,0000,,وصل المفتّش ميغوري بعد ساعتين
Dialogue: 0,1:29:30.21,1:29:33.74,Default,,0000,0000,0000,,وُاصطحب تاناكا-سان وكيكو-سان\Nلمركز شرطة غونما
Dialogue: 0,1:29:35.79,1:29:41.20,Default,,0000,0000,0000,,راقب كارلوس الضعيف في اليابانيّة\Nالسيّارة ترحل بتعابير حزينة
Dialogue: 0,1:29:42.13,1:29:46.24,Default,,0000,0000,0000,,،لكن أخبره أبي بالبرتغاليّة أنّه سيرجع قريباً
Dialogue: 0,1:29:46.24,1:29:48.49,Default,,0000,0000,0000,,فأبدى بهجةً طفوليّة
Dialogue: 0,1:29:50.52,1:29:53.90,Default,,0000,0000,0000,,،يبدو أنّه بغية حماية كارلوس
Dialogue: 0,1:29:53.90,1:29:56.44,Default,,0000,0000,0000,,لم يخبره تاناكا-سان عن الميراث
Dialogue: 0,1:29:56.44,1:30:00.02,Default,,0000,0000,0000,,أو عن كون هذا منزل عائلة أبيه
Dialogue: 0,1:30:01.85,1:30:04.78,Default,,0000,0000,0000,,ثمّ، انتهى الليل الطويل
Dialogue: 0,1:30:06.97,1:30:10.13,Default,,0000,0000,0000,,!ماذا؟ سمعت صوتي؟
Dialogue: 0,1:30:10.50,1:30:13.09,Default,,0000,0000,0000,,أجل، أعطاني البروفسور آغاسا لاقط صوت
Dialogue: 0,1:30:13.09,1:30:16.38,Default,,0000,0000,0000,,ينقل الأصوات من ربطة عنقك
Dialogue: 0,1:30:16.38,1:30:18.88,Default,,0000,0000,0000,,ساعدني ذلك باستنتاجي
Dialogue: 0,1:30:19.74,1:30:22.83,Default,,0000,0000,0000,,كنتُ لأعرف أنّ ذاك المُسنّ\Nليس الحقيقيّ
Dialogue: 0,1:30:22.83,1:30:24.88,Default,,0000,0000,0000,,!لو وجدتُ تلك الرسائل أيضاً
Dialogue: 0,1:30:24.88,1:30:30.23,Default,,0000,0000,0000,,كلا، اكتشفتُ أنّه مزيّف\Nقبل قراءة الرسائل حتّى
Dialogue: 0,1:30:30.23,1:30:31.13,Default,,0000,0000,0000,,!كيف؟
Dialogue: 0,1:30:31.13,1:30:33.40,Default,,0000,0000,0000,,ندبة ساقه
Dialogue: 0,1:30:33.40,1:30:36.86,Default,,0000,0000,0000,,لاعب القاعدة الأولى الأعسر كان\Nليمتدّ من ساقه اليسرى
Dialogue: 0,1:30:36.86,1:30:39.63,Default,,0000,0000,0000,,لكن ندبة ذاك المُسنّ كانت على ساقه اليمنى
Dialogue: 0,1:30:40.02,1:30:45.64,Default,,0000,0000,0000,,بدا ذلك غريباً لي، ففتّشتُ المخزن\Nووجدتُ تلك الرسائل
Dialogue: 0,1:30:46.64,1:30:50.63,Default,,0000,0000,0000,,يبدو أنّ قوّة ملاحظتك لم تبلغ\N!نصابها بعد يا شينتشي-كن
Dialogue: 0,1:30:50.92,1:30:52.80,Default,,0000,0000,0000,,يا للتباهي
Dialogue: 0,1:30:52.80,1:30:56.09,Default,,0000,0000,0000,,تحاول التصرّف بروعة بعدما أتيت تلاحقني
Dialogue: 0,1:30:56.51,1:31:00.45,Default,,0000,0000,0000,,!أنا مجرّد مؤلّف روايات غموض"، أيّ هراء هذا؟"
Dialogue: 0,1:31:00.45,1:31:03.12,Default,,0000,0000,0000,,أتحاول أن تبدو أكيتشي كوغورو؟
Dialogue: 0,1:31:03.12,1:31:06.61,Default,,0000,0000,0000,,!يا للسخافة! لا أطيق هذا الرجل
Dialogue: 0,1:31:06.61,1:31:07.55,Default,,0000,0000,0000,,يوكيكو
Dialogue: 0,1:31:10.57,1:31:11.51,Default,,0000,0000,0000,,سنرجع
Dialogue: 0,1:31:14.19,1:31:16.36,Default,,0000,0000,0000,,ما هذا؟ لا تهتمّ لمشاعر الآخرين
Dialogue: 0,1:31:16.69,1:31:19.31,Default,,0000,0000,0000,,!سنرجع"؟ لا تقلّل منّي"
Dialogue: 0,1:31:22.81,1:31:26.34,Default,,0000,0000,0000,,!ما الذي تفعله يا شينتشي؟! سنتركك هكذا
Dialogue: 0,1:31:26.60,1:31:27.96,Default,,0000,0000,0000,,!حـ-حسناً
Dialogue: 0,1:31:29.26,1:31:34.91,Default,,0000,0000,0000,,أيّاً كان، يبدو أنّ هذه القضيّة\Nوالخلاف الزوجيّ قد حُلّا
Dialogue: 0,1:33:03.08,1:33:04.40,Default,,0000,0000,0000,,!إلى اللقاء يا شين-تشان
Dialogue: 0,1:33:04.40,1:33:05.97,Default,,0000,0000,0000,,انقل تحيّتي لران-كن
Dialogue: 0,1:33:05.97,1:33:10.46,Default,,0000,0000,0000,,بالمناسبة، يجدر بك الانتباه من ران-تشان
Dialogue: 0,1:33:10.91,1:33:15.47,Default,,0000,0000,0000,,...هناك ما ضايقني في ابتسامتها الأخيرة تلك
Dialogue: 0,1:33:15.83,1:33:19.65,Default,,0000,0000,0000,,صحيح، الاستخفاف بالنساء سيقودك للألم
Dialogue: 0,1:33:19.65,1:33:21.61,Default,,0000,0000,0000,,عجباً، تفهم إذاً؟
Dialogue: 0,1:33:22.98,1:33:24.51,Default,,0000,0000,0000,,!إلى اللقاء
Dialogue: 0,1:33:26.25,1:33:28.50,Default,,0000,0000,0000,,لا يمكن... لا يمكن ذلك، صحيح؟
Dialogue: 0,1:33:29.64,1:33:31.01,Default,,0000,0000,0000,,...رجعت
Dialogue: 0,1:33:32.43,1:33:33.51,Default,,0000,0000,0000,,للبيت
Dialogue: 0,1:33:33.93,1:33:36.51,Default,,0000,0000,0000,,سمعتُ من البروفسور آغاسا
Dialogue: 0,1:33:37.41,1:33:39.00,Default,,0000,0000,0000,,سـ-سمعتِ ماذا؟
Dialogue: 0,1:33:39.36,1:33:44.29,Default,,0000,0000,0000,,،إذا كنت ستذهب لمنزل أحدهم وتبيت\N!فاتّصل بنا وأخبرنا أوّلاً
Dialogue: 0,1:33:45.25,1:33:46.22,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,1:33:48.74,1:33:50.45,Default,,0000,0000,0000,,!كنتُ قلقة
Dialogue: 0,1:33:50.45,1:33:53.78,Default,,0000,0000,0000,,اتّصلتُ بمنزل شينتشي باستمرار\N!لكن لم يكن هناك أحد
Dialogue: 0,1:33:53.78,1:33:54.81,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,1:33:54.81,1:33:56.59,Default,,0000,0000,0000,,...آ-آسف
Dialogue: 0,1:33:59.94,1:34:01.83,Default,,0000,0000,0000,,...لا تخيفيني هكذا
Dialogue: 0,1:34:05.05,1:34:07.73,Default,,0000,0000,0000,,!إبرة حقن! ما الذي تنوي فعله؟
Dialogue: 0,1:34:11.23,1:34:13.88,Default,,0000,0000,0000,,...تبّاً! كلوروفورم
Dialogue: 0,1:34:20.74,1:34:23.71,Default,,0000,0000,0000,,!ما حقنت النبيذ به كان سمّاً على الأرجح
Dialogue: 0,1:34:24.14,1:34:25.81,Default,,0000,0000,0000,,!كيف تنوي استعماله؟
Dialogue: 0,1:34:27.11,1:34:33.10,On Top,,0000,0000,15,,جريمة قتل نبيذ الوداع
Dialogue: 0,1:34:27.81,1:34:29.20,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,1:34:29.20,1:34:31.74,Default,,0000,0000,0000,,جريمة قتل نبيذ الوداع

