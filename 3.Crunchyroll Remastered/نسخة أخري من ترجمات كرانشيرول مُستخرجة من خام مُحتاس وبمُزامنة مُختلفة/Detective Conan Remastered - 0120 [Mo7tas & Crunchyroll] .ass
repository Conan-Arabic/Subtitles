Dialogue: 0,0:00:01.03,0:00:04.32,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.32,0:00:06.02,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.64,0:00:08.36,Default,,0000,0000,0000,,!تحمل قضيّة اليوم رائحة العسل
Dialogue: 0,0:00:08.36,0:00:10.06,Default,,0000,0000,0000,,!هنالك لسعة وراء الحلاوة
Dialogue: 0,0:00:10.06,0:00:11.94,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.94,0:00:13.53,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ دماغه لبالغ
Dialogue: 0,0:00:13.86,0:00:16.28,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.69,0:00:24.36,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.36,0:00:31.40,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:33.17,0:00:39.53,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.53,0:00:47.03,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:47.03,0:00:59.49,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.41,0:01:06.78,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.79,0:01:13.67,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.67,0:01:20.03,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:20.03,0:01:27.02,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.20,0:01:57.13,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل كوكتيل العسل
Dialogue: 0,0:01:51.93,0:01:54.47,Default,,0000,0000,0000,,جريمة قتل كوكتيل العسل
Dialogue: 0,0:02:04.76,0:02:05.81,Default,,0000,0000,0000,,...هذا مؤلم
Dialogue: 0,0:02:06.10,0:02:09.26,Default,,0000,0000,0000,,أبي، أليست الرئيسة يامازاكي هي رئيسة\Nشركة يامازاكي للتطوير نفسها
Dialogue: 0,0:02:09.26,0:02:13.24,Default,,0000,0000,0000,,التي قمت بحراستها أثناء قضيّة الابتزاز السابقة؟
Dialogue: 0,0:02:13.64,0:02:16.20,Default,,0000,0000,0000,,لمَ قامت بدعوتك اليوم؟
Dialogue: 0,0:02:16.61,0:02:23.60,Default,,0000,0000,0000,,تقول أنّها تريد طلب معروف من المتحرّي\N!ذائع الصيت وطنياً، موري كوغورو
Dialogue: 0,0:02:42.64,0:02:45.34,On Top,,0000,0000,0000,,مرحباً! أنت موري-ساما، صحيح؟
Dialogue: 0,0:02:42.69,0:02:46.24,CharCard,,0000,0000,0004,,{\fad(200,100)}(آيهارا شينغو (53\Nمدبّر المنزل
Dialogue: 0,0:02:45.34,0:02:47.22,On Top,,0000,0000,0000,,الرئيسة بانتظارك
Dialogue: 0,0:02:47.22,0:02:48.23,On Top,,0000,0000,0000,,تفضّلوا
Dialogue: 0,0:02:53.43,0:02:56.14,Default,,0000,0000,0000,,وصل موري-ساما
Dialogue: 0,0:02:56.14,0:02:57.22,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:02:57.22,0:02:58.16,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:02:59.80,0:03:01.30,On Top,,0000,0000,0000,,مرحباً يا موري-سان
Dialogue: 0,0:03:00.17,0:03:04.48,CharCard,,0000,0000,0004,,{\fad(300,200)}(يامازاكي هيرومي (50\Nرئيسة شركة يامازاكي للتطوير
Dialogue: 0,0:03:01.30,0:03:02.72,On Top,,0000,0000,0000,,أعتذر على استدعائك
Dialogue: 0,0:03:02.72,0:03:04.87,On Top,,0000,0000,0000,,لأعماق الجبال هنا
Dialogue: 0,0:03:05.16,0:03:08.51,Default,,0000,0000,0000,,البتّة، لا تزالين باهرة الجمال كالمعتاد
Dialogue: 0,0:03:08.51,0:03:10.17,Default,,0000,0000,0000,,يا إلهي، معسول الكلام
Dialogue: 0,0:03:10.80,0:03:16.13,Default,,0000,0000,0000,,دعني أعرّفك، هذا عمدة بلدة إيوامي، هاتشيماكي-ساما
Dialogue: 0,0:03:16.17,0:03:24.10,CharCard,,0000,0000,0004,,{\fad(300,0)}(هاتشيماكي هاتشيبي (62\Nعمدة بلدة إيوامي
Dialogue: 0,0:03:16.44,0:03:18.68,On Top,,0000,0000,0000,,أنا هاتشيماكي هاتشيبي
Dialogue: 0,0:03:18.68,0:03:24.10,On Top,,0000,0000,0000,,يشرّفني لقاء المرموق موري كوغورو-سان\Nوجهاً لوجه هكذا
Dialogue: 0,0:03:24.43,0:03:26.26,Default,,0000,0000,0000,,سرّني لقاؤك
Dialogue: 0,0:03:27.57,0:03:31.31,CharCard,,0000,0000,0004,,{\fad(300,100)}(ناكامورا إيري (32\Nسكرتيرة الرئيسة يامازاكي
Dialogue: 0,0:03:27.68,0:03:31.40,On Top,,0000,0000,0000,,أنا السكرتيرة ناكامورا، سُررت بلقائك
Dialogue: 0,0:03:31.85,0:03:33.26,Default,,0000,0000,0000,,السرور لي
Dialogue: 0,0:03:33.26,0:03:40.55,Default,,0000,0000,0000,,أنا مدبّر المنزل آيهارا، اطلبني متى \Nاحتجت شيئاً من فضلك
Dialogue: 0,0:03:40.55,0:03:42.19,Default,,0000,0000,0000,,سرّني لقاؤك
Dialogue: 0,0:03:42.19,0:03:43.47,Default,,0000,0000,0000,,اعذرني الآن
Dialogue: 0,0:03:51.45,0:03:53.01,Default,,0000,0000,0000,,ما هذا النموذج؟
Dialogue: 0,0:03:53.23,0:03:55.47,Default,,0000,0000,0000,,لا تلمسه يا كونان-كن
Dialogue: 0,0:03:55.47,0:03:56.84,Default,,0000,0000,0000,,لا أمانع
Dialogue: 0,0:03:57.26,0:04:02.31,Default,,0000,0000,0000,,موري-سان، هذا منتجع الينابيع المعدنيّة\Nلإيوامي الذي نقوم بتخطيطه
Dialogue: 0,0:04:02.31,0:04:05.34,Default,,0000,0000,0000,,بالإضافة للينابيع، سيحوي ملعب غولف \Nونادي كرة مضرب
Dialogue: 0,0:04:05.34,0:04:09.23,Default,,0000,0000,0000,,ومركز ألعاب فيديو، والعديد من المنشآت
Dialogue: 0,0:04:09.47,0:04:16.26,Default,,0000,0000,0000,,تعداد بلدتنا السكّاني ينخفض، فتعاونت مع الرئيسة يامازاكي
Dialogue: 0,0:04:16.26,0:04:21.55,Default,,0000,0000,0000,,لبناء منتجع ينابيع ساخنة\Nلبثّ الحياة فيها
Dialogue: 0,0:04:21.55,0:04:24.04,Default,,0000,0000,0000,,!الغد سيكون حفل الافتتاح البهيج
Dialogue: 0,0:04:24.51,0:04:28.76,Default,,0000,0000,0000,,نودّ منك المشاركة في الدعاية لو أمكن
Dialogue: 0,0:04:28.76,0:04:33.50,Default,,0000,0000,0000,,عبر الظهور في الملصقات والدعايات التلفزيّة كعارض
Dialogue: 0,0:04:33.79,0:04:36.11,Default,,0000,0000,0000,,!عـ-عارض في الدعايات التلفزيّة؟
Dialogue: 0,0:04:37.30,0:04:39.39,Default,,0000,0000,0000,,هكذا ربما؟
Dialogue: 0,0:04:40.09,0:04:41.76,Default,,0000,0000,0000,,أنت متحمّس جدّاً
Dialogue: 0,0:04:42.22,0:04:45.39,Default,,0000,0000,0000,,لننهِ كلام العمل هنا
Dialogue: 0,0:04:46.64,0:04:49.02,Default,,0000,0000,0000,,آيهارا، حضّر للاحتفال الأوليّ
Dialogue: 0,0:04:49.39,0:04:51.98,Default,,0000,0000,0000,,!حاضر! سأجلبه فوراً
Dialogue: 0,0:05:03.64,0:05:08.21,Default,,0000,0000,0000,,،مأدبة نادرة في الظهيرة وساكي\N!لا شيء أروع من هذا
Dialogue: 0,0:05:08.44,0:05:11.39,Default,,0000,0000,0000,,حساء خنزير بريّ وخضروات إيوامي طازجة
Dialogue: 0,0:05:11.39,0:05:14.21,Default,,0000,0000,0000,,!تحمل كلّها نكهات المنطقة
Dialogue: 0,0:05:14.42,0:05:18.72,Default,,0000,0000,0000,,أجل، سيكون الطعام المحليّ أحد\Nعوامل الجذب للمنتجع
Dialogue: 0,0:05:21.30,0:05:24.09,Default,,0000,0000,0000,,إنّه من مكتبك في الطابق الثاني
Dialogue: 0,0:05:24.09,0:05:25.39,Default,,0000,0000,0000,,اعذروني قليلاً
Dialogue: 0,0:05:30.26,0:05:34.44,Default,,0000,0000,0000,,صحيح، حضرة المعدة، لمَ لا تدع\Nموري-سان يجرّب الشيء الخاصّ؟
Dialogue: 0,0:05:34.76,0:05:36.92,Default,,0000,0000,0000,,تقصدين ذاك؟
Dialogue: 0,0:05:36.92,0:05:38.40,Default,,0000,0000,0000,,دعي الأمر لي
Dialogue: 0,0:05:42.99,0:05:46.62,Default,,0000,0000,0000,,!آيهارا-كن! أحضر ذاك الشيء
Dialogue: 0,0:05:48.09,0:05:49.96,Default,,0000,0000,0000,,ما الذي يفعله؟
Dialogue: 0,0:05:55.47,0:05:57.50,Default,,0000,0000,0000,,ما هو الشيء الخاصّ؟
Dialogue: 0,0:05:59.55,0:06:01.97,Default,,0000,0000,0000,,عليك الانتظار لترى
Dialogue: 0,0:06:06.30,0:06:07.51,Default,,0000,0000,0000,,!آيهارا-كن
Dialogue: 0,0:06:08.39,0:06:10.43,Default,,0000,0000,0000,,ماذا؟ أنت على الهاتف؟
Dialogue: 0,0:06:10.88,0:06:15.15,Default,,0000,0000,0000,,!إذاً، أرسلوا صندوق جعّة وصندوق عصير
Dialogue: 0,0:06:17.42,0:06:19.29,Default,,0000,0000,0000,,سآخذ ذاك الشيء
Dialogue: 0,0:06:19.29,0:06:20.31,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:06:27.69,0:06:31.32,Default,,0000,0000,0000,,!هذا فخر بلدتنا
Dialogue: 0,0:06:33.17,0:06:35.03,Default,,0000,0000,0000,,ما هو بالضبط؟
Dialogue: 0,0:06:35.03,0:06:40.00,Default,,0000,0000,0000,,!ساكي سمندل ودبّور، يعطيك حيويةً كبيرة
Dialogue: 0,0:06:42.63,0:06:44.17,Default,,0000,0000,0000,,!هيّا، اشرب
Dialogue: 0,0:06:45.33,0:06:47.04,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:06:49.09,0:06:53.64,Default,,0000,0000,0000,,يبدو أنّي شربتُ الكثير، أحتاج لتنشّق هواء طلق
Dialogue: 0,0:06:56.79,0:06:58.96,Default,,0000,0000,0000,,أأنت بخير؟
Dialogue: 0,0:06:58.96,0:07:00.77,Default,,0000,0000,0000,,أجل، أظنّ ذلك
Dialogue: 0,0:07:03.75,0:07:06.52,Default,,0000,0000,0000,,كان الطقس صحواً قبل قليل
Dialogue: 0,0:07:07.00,0:07:09.99,Default,,0000,0000,0000,,طقس الجبال سريع التقلّب
Dialogue: 0,0:07:10.34,0:07:14.34,Default,,0000,0000,0000,,"تعرف القول المشهور، "قلب المرأة أشبه بسماء الخريف
Dialogue: 0,0:07:22.12,0:07:24.58,Default,,0000,0000,0000,,!كـ-كانت تلك الرئيسة يامازاكي
Dialogue: 0,0:07:25.21,0:07:27.46,Default,,0000,0000,0000,,!اتّصلي بالشرطة وبطبيب
Dialogue: 0,0:07:27.46,0:07:28.30,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:07:40.75,0:07:41.56,Default,,0000,0000,0000,,...بالون
Dialogue: 0,0:07:54.07,0:07:56.03,Default,,0000,0000,0000,,بخّاخ مبيد للحشرات؟
Dialogue: 0,0:07:59.67,0:08:00.66,Default,,0000,0000,0000,,لا جدوى
Dialogue: 0,0:08:15.30,0:08:16.79,Default,,0000,0000,0000,,!رئيسة
Dialogue: 0,0:08:18.17,0:08:19.64,Default,,0000,0000,0000,,هذا فظيع
Dialogue: 0,0:08:21.04,0:08:24.59,Default,,0000,0000,0000,,المعذرة، أنت المتحرّي الشهير\Nموري كوغورو-سان، صحيح؟
Dialogue: 0,0:08:24.59,0:08:25.19,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:25.79,0:08:28.46,Default,,0000,0000,0000,,أنا ضابط شرطة مقيم، اسمي سوزوكي
Dialogue: 0,0:08:28.46,0:08:32.88,Default,,0000,0000,0000,,وهذا الطبيب ساكوراي الذي\Nيدير عيادةً في البلدة
Dialogue: 0,0:08:33.92,0:08:35.54,Default,,0000,0000,0000,,شكراً على قدومك
Dialogue: 0,0:08:35.54,0:08:40.75,Default,,0000,0000,0000,,سأترك الباقي لك إذاً، سأذهب لتفقّد غرفة الرئيسة
Dialogue: 0,0:08:43.29,0:08:45.91,Default,,0000,0000,0000,,هذا الباب آليّ القفل، صحيح؟
Dialogue: 0,0:08:45.91,0:08:47.79,Default,,0000,0000,0000,,!أعي ذلك
Dialogue: 0,0:08:48.21,0:08:50.21,Default,,0000,0000,0000,,!موري-سان! جلبتُ المفتاح البديل
Dialogue: 0,0:09:00.46,0:09:02.51,Default,,0000,0000,0000,,!هذه رائحة مبيد حشرات
Dialogue: 0,0:09:06.43,0:09:09.51,Default,,0000,0000,0000,,يبدو أنّها كانت مقفلةً من الداخل
Dialogue: 0,0:09:17.52,0:09:20.45,Default,,0000,0000,0000,,يبدو أنّ الرئيسة حطّمت النافذة وخرجت للشرفة
Dialogue: 0,0:09:20.45,0:09:24.87,Default,,0000,0000,0000,,ثمّ سقطت عندما انهار السور\Nالذي كانت تتكئ عليه
Dialogue: 0,0:09:24.87,0:09:27.29,Default,,0000,0000,0000,,لكن لمَ؟
Dialogue: 0,0:09:27.29,0:09:28.82,Default,,0000,0000,0000,,موري-سان
Dialogue: 0,0:09:29.37,0:09:36.33,Default,,0000,0000,0000,,قالت طبيب ساكوراي أنّ سبب وفاتها\Nكان إصابة رأسها عند السقوط
Dialogue: 0,0:09:36.74,0:09:39.58,Default,,0000,0000,0000,,،هذا المكتب آليّ القفل
Dialogue: 0,0:09:39.58,0:09:44.01,Default,,0000,0000,0000,,وكانت كلّ نوافذ الطابق العلويّ\Nمقفلةً من الداخل
Dialogue: 0,0:09:44.33,0:09:50.22,Default,,0000,0000,0000,,يستحيل أن يتسلّل أحد أمامنا في الطابق\Nالأوّل ويصعد الأدراج
Dialogue: 0,0:09:50.22,0:09:54.18,Default,,0000,0000,0000,,والتسلّل من المدخنة غير ممكن أيضاً
Dialogue: 0,0:09:54.51,0:09:57.14,Default,,0000,0000,0000,,أي كانت الغرفة مقفلةً بالكامل
Dialogue: 0,0:10:03.54,0:10:04.57,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:10:06.33,0:10:08.70,Default,,0000,0000,0000,,حضرة الضابط، هذا دبّور، صحيح؟
Dialogue: 0,0:10:09.74,0:10:13.33,Default,,0000,0000,0000,,إنّه دبور السترة الصفراء
Dialogue: 0,0:10:13.33,0:10:18.92,Default,,0000,0000,0000,,بالمناسبة، وجد الطبيب ساكوراي آثار\Nلسع دبّور على رأسها
Dialogue: 0,0:10:18.92,0:10:21.25,Default,,0000,0000,0000,,آثار لسع دبّور؟
Dialogue: 0,0:10:21.95,0:10:24.25,Default,,0000,0000,0000,,هل الدبّور منتشر في هذه المنطقة؟
Dialogue: 0,0:10:24.25,0:10:25.74,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:25.74,0:10:30.18,Default,,0000,0000,0000,,بالمناسبة، ألم تكن الرئيسة تخاف\Nالدبّور يا ناكامورا-سان؟
Dialogue: 0,0:10:30.18,0:10:32.04,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:10:32.04,0:10:37.14,Default,,0000,0000,0000,,إنّها من أهل البلدة، وقالت أنّها مرّت\Nبتجربة فظيعة في صغرها
Dialogue: 0,0:10:39.16,0:10:42.04,Default,,0000,0000,0000,,،لسعها دبّورٌ عندما كانت في الصفّ السادس
Dialogue: 0,0:10:42.04,0:10:45.27,Default,,0000,0000,0000,,وأنقذها آيهارا-سان وهي على مشارف الموت
Dialogue: 0,0:10:46.16,0:10:49.66,Default,,0000,0000,0000,,تدين له بحياتها، لذا قرّرت تعيينه
Dialogue: 0,0:10:49.66,0:10:53.74,Default,,0000,0000,0000,,للاهتمام بالمنزل وفقما سمعت
Dialogue: 0,0:10:54.33,0:10:56.66,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:10:56.66,0:11:02.71,Default,,0000,0000,0000,,كنتُ أحتفظ بمبيد حشرات بالمتناول\Nكيلا يدخل الدبّور
Dialogue: 0,0:11:03.04,0:11:07.76,Default,,0000,0000,0000,,الحوادث المتعلّقة بالدبّور كثيرة هذا العام\Nوتجاوزت الأرقام السابقة
Dialogue: 0,0:11:09.79,0:11:12.41,Default,,0000,0000,0000,,عرفتُ القاتل
Dialogue: 0,0:11:12.41,0:11:15.22,Default,,0000,0000,0000,,!إنّه الدبّور بلا شك
Dialogue: 0,0:11:17.27,0:11:21.29,Default,,0000,0000,0000,,اسمعوا، لا بدّ أنّ الرئيسة يامازاكي تعرّضت
Dialogue: 0,0:11:21.29,0:11:25.23,Default,,0000,0000,0000,,للهجوم من قِبل سرب دبّور\Nدخل عبر المدخنة
Dialogue: 0,0:11:27.08,0:11:29.28,Default,,0000,0000,0000,,،حاولت استعمال مبيد حشرات بالقرب
Dialogue: 0,0:11:30.08,0:11:34.45,Default,,0000,0000,0000,,لكن تملّكها الهلع، وحطّمت النافذة وهربت للشرفة
Dialogue: 0,0:11:34.56,0:11:39.58,Default,,0000,0000,0000,,لكن لسوء حظّها، انكسر السور الذي\Nاتّكأت عليه فسقطت
Dialogue: 0,0:11:39.58,0:11:42.58,Default,,0000,0000,0000,,أي أنّه كان حادثاً
Dialogue: 0,0:11:44.16,0:11:50.20,Default,,0000,0000,0000,,لكن لمَ هربت عبر النافذة\Nوليس عبر الباب؟
Dialogue: 0,0:11:50.20,0:11:54.95,Default,,0000,0000,0000,,عندما يتملّك البشر الهلع، تضعف قدرتهم\Nفي اتّخاذ القرارات الصائبة
Dialogue: 0,0:12:02.08,0:12:04.54,Default,,0000,0000,0000,,ما هذا الشيء الدبق؟
Dialogue: 0,0:12:07.08,0:12:07.90,Default,,0000,0000,0000,,...إنّه
Dialogue: 0,0:12:24.87,0:12:28.54,Default,,0000,0000,0000,,!ربما لم تكن هذه حادثة
Dialogue: 0,0:12:28.54,0:12:32.87,Default,,0000,0000,0000,,من المحتمل أنّها جريمة قتل من تخطيط\N!أحد الأشخاص في الداخل
Dialogue: 0,0:12:53.49,0:12:56.61,Default,,0000,0000,0000,,!ثياب حماية للتعامل مع الدبّور
Dialogue: 0,0:13:02.20,0:13:04.54,Default,,0000,0000,0000,,يبدو أنّ هاتين القنّينتين اُستعملتا مؤخراً
Dialogue: 0,0:13:05.45,0:13:08.42,Default,,0000,0000,0000,,أثير وحمض كبريتيّ؟
Dialogue: 0,0:13:15.20,0:13:18.70,Default,,0000,0000,0000,,هيليوم؟ لمَ يوجد هنا؟
Dialogue: 0,0:13:18.70,0:13:20.14,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:13:29.33,0:13:31.37,Default,,0000,0000,0000,,وفقما أذكر، فقد اتّجهت مع مجرى النهر
Dialogue: 0,0:13:56.26,0:13:59.22,Default,,0000,0000,0000,,خيط صيد وكيس بلاستيكيّ ممزق
Dialogue: 0,0:13:59.22,0:14:01.68,Default,,0000,0000,0000,,وهذا الوسخ الأسود
Dialogue: 0,0:14:09.79,0:14:13.90,Default,,0000,0000,0000,,غطاء المطر الذي يُفترض وجوده\Nفي العادة قد نُزع
Dialogue: 0,0:14:19.07,0:14:23.53,Default,,0000,0000,0000,,توجد آثار لإزالة بعض السخام في الداخل
Dialogue: 0,0:14:31.04,0:14:32.71,Default,,0000,0000,0000,,شريط لاصق؟
Dialogue: 0,0:14:37.20,0:14:38.72,Default,,0000,0000,0000,,ثقب على الأرض؟
Dialogue: 0,0:14:40.99,0:14:45.33,Default,,0000,0000,0000,,!فهمت، عرفت الحيلة الآن\N!القاتل هو ذاك الشخص
Dialogue: 0,0:14:45.33,0:14:47.16,Default,,0000,0000,0000,,كونان-كن! أين أنت؟
Dialogue: 0,0:14:47.16,0:14:50.20,Default,,0000,0000,0000,,أين ذهب ذاك الصبيّ؟
Dialogue: 0,0:14:52.45,0:14:53.77,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:14:55.02,0:14:57.99,Default,,0000,0000,0000,,!تشعرنا بالقلق عندما تختفي فجأةً هكذا
Dialogue: 0,0:14:57.99,0:15:00.54,Default,,0000,0000,0000,,!لا تتجوّل في المكان! اتبعنا
Dialogue: 0,0:15:01.99,0:15:07.29,Default,,0000,0000,0000,,مهلك، لتسترح قليلاً وتترك\Nالباقي لي يا عمّ
Dialogue: 0,0:15:09.29,0:15:10.83,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:15:16.62,0:15:19.30,Default,,0000,0000,0000,,أبي! ما كان ذاك الصوت؟
Dialogue: 0,0:15:20.95,0:15:22.01,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:15:22.01,0:15:22.76,Default,,0000,0000,0000,,ما الذي حصل؟
Dialogue: 0,0:15:24.16,0:15:26.06,Default,,0000,0000,0000,,اكتشفتُ الأمر يا سادة
Dialogue: 0,0:15:26.45,0:15:28.64,Default,,0000,0000,0000,,كانت هذه جريمة قتل
Dialogue: 0,0:15:30.12,0:15:31.91,Default,,0000,0000,0000,,لم يكن حادثاً؟
Dialogue: 0,0:15:31.91,0:15:33.60,Default,,0000,0000,0000,,لمَ لم تذكر الأمر إلى الآن؟
Dialogue: 0,0:15:33.84,0:15:39.57,Default,,0000,0000,0000,,لجعل المجرم يهمل، فقد كنت\Nأريد وقتاً للبحث عن دليل
Dialogue: 0,0:15:39.57,0:15:42.20,Default,,0000,0000,0000,,قتل المجرم الرئيسة يامازاكي
Dialogue: 0,0:15:42.20,0:15:44.99,Default,,0000,0000,0000,,وجعله يبدو حادثاً
Dialogue: 0,0:15:44.99,0:15:46.87,Default,,0000,0000,0000,,أيّ دليلٍ لديك؟
Dialogue: 0,0:15:46.87,0:15:51.50,Default,,0000,0000,0000,,انظروا لمقبض الباب، المقبض الداخليّ
Dialogue: 0,0:15:53.70,0:15:57.58,Default,,0000,0000,0000,,أهنالك خطبٌ به؟ لا نرى شيئاً عليه
Dialogue: 0,0:15:57.58,0:15:59.76,Default,,0000,0000,0000,,أسفل وصلة ربطه
Dialogue: 0,0:16:07.04,0:16:07.92,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:16:07.92,0:16:09.97,Default,,0000,0000,0000,,أجل، عسل
Dialogue: 0,0:16:10.21,0:16:16.16,Default,,0000,0000,0000,,إذا هاجمك الدبّور في الغرفة، فستهرب\Nعبر الباب في العادة
Dialogue: 0,0:16:16.16,0:16:20.90,Default,,0000,0000,0000,,لكن كانت هنالك جماعة دبابير\Nعلى المقبض المغمور بالعسل
Dialogue: 0,0:16:20.90,0:16:26.82,Default,,0000,0000,0000,,فهربت الرئيسة يامازاكي عبر النافذة\Nفي الجانب المقابل، في عجزها عن فتح الباب
Dialogue: 0,0:16:27.00,0:16:30.62,Default,,0000,0000,0000,,كان سور الشرفة متآكلاً لحدٍّ كبير
Dialogue: 0,0:16:31.08,0:16:34.74,Default,,0000,0000,0000,,وتمّ إتلافه سلفاً بحمض كبريتيّ
Dialogue: 0,0:16:34.74,0:16:37.04,Default,,0000,0000,0000,,لكن ماذا عن الدبّور؟
Dialogue: 0,0:16:37.04,0:16:41.58,Default,,0000,0000,0000,,أجل، كان الدبّور ضمن الخطّة أيضاً
Dialogue: 0,0:16:41.58,0:16:44.05,Default,,0000,0000,0000,,انظروا للسقف وراءكم
Dialogue: 0,0:16:47.33,0:16:49.44,Default,,0000,0000,0000,,...أيمكن أنّ ذاك البالون
Dialogue: 0,0:16:49.51,0:16:50.70,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:50.70,0:16:55.44,Default,,0000,0000,0000,,إنّه البالون الذي رأته ران وكونان\Nفي طريق نزولهما للنهر
Dialogue: 0,0:16:55.87,0:16:59.36,Default,,0000,0000,0000,,علق بغصن شجرة في اتّجاه مجرى النهر
Dialogue: 0,0:16:59.36,0:17:02.32,Default,,0000,0000,0000,,ران، تفقّدي الكيس البلاستيكيّ
Dialogue: 0,0:17:02.32,0:17:03.54,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:17:07.99,0:17:09.74,Default,,0000,0000,0000,,!دبّور
Dialogue: 0,0:17:10.00,0:17:14.74,Default,,0000,0000,0000,,،جمع المجرم دبابيراً في الكيس المربوط بالبالون
Dialogue: 0,0:17:14.74,0:17:17.29,Default,,0000,0000,0000,,ووضعه في المدخنة
Dialogue: 0,0:17:17.29,0:17:22.83,Default,,0000,0000,0000,,ذلك بعد تنويمها ببخّاخ الأثير غالباً
Dialogue: 0,0:17:22.83,0:17:23.67,Default,,0000,0000,0000,,آيهارا-سان
Dialogue: 0,0:17:24.20,0:17:29.64,Default,,0000,0000,0000,,يوجد زيّ نحّال تفوح منه\Nرائحة الأُثير في المخزن، أليس ذلك؟
Dialogue: 0,0:17:29.91,0:17:33.66,Default,,0000,0000,0000,,إنّه موجود في كلّ منازل هذه المنطقة
Dialogue: 0,0:17:33.66,0:17:37.33,Default,,0000,0000,0000,,ما الغرض من أسطوانات الهيليوم\Nفي المخزن إذاً؟
Dialogue: 0,0:17:37.33,0:17:41.45,Default,,0000,0000,0000,,نفخنا بالونات للأطفال في المهرجان الصيفيّ
Dialogue: 0,0:17:41.45,0:17:42.57,Default,,0000,0000,0000,,وذلك ما بقي
Dialogue: 0,0:17:42.74,0:17:47.04,Default,,0000,0000,0000,,أحقّاً ذلك؟ كانت هنالك ثلاث أسطوانات
Dialogue: 0,0:17:47.04,0:17:49.49,Default,,0000,0000,0000,,ألم تقم بتجارب طيران بالون متكرّرة
Dialogue: 0,0:17:50.01,0:17:54.58,Default,,0000,0000,0000,,وبكيس مربوطٍ به؟
Dialogue: 0,0:17:54.58,0:17:57.25,Default,,0000,0000,0000,,!ما قصدك؟ ما الذي تلمّح له؟
Dialogue: 0,0:17:57.62,0:18:02.54,Default,,0000,0000,0000,,من كان بإمكانه ترتيب كلّ تلك الأشياء\N هو مدبّر المنزل الذي يعيش هنا فحسب
Dialogue: 0,0:18:02.54,0:18:05.46,Default,,0000,0000,0000,,!أجل، المجرم هو أنت يا آيهارا-سان
Dialogue: 0,0:18:08.26,0:18:09.87,Default,,0000,0000,0000,,!ما-ما الذي تقوله؟
Dialogue: 0,0:18:09.87,0:18:13.14,Default,,0000,0000,0000,,كنتُ في غرفة المعيشة عندما\N !سقطت الرئيسة يامازاكي
Dialogue: 0,0:18:13.33,0:18:17.10,Default,,0000,0000,0000,,!كنتُ رفقتكم! فكيف أستطيع قتلها؟
Dialogue: 0,0:18:17.41,0:18:21.77,Default,,0000,0000,0000,,بدايةً، لإبقاء البالون الذي وضعته\Nداخل المدخنة هناك مؤقتاً
Dialogue: 0,0:18:22.16,0:18:26.24,Default,,0000,0000,0000,,ربطت خيط صيدٍ به، ومددته للمطبخ في الطابق السفليّ
Dialogue: 0,0:18:26.24,0:18:30.20,Default,,0000,0000,0000,,عبر ثقبٍ صغير في الأرض بجوار الموقد، وربطته بمسمار
Dialogue: 0,0:18:30.62,0:18:34.66,Default,,0000,0000,0000,,ربطت خيط صيد بشريطٍ لاصق\Nعلى البالون أيضاً
Dialogue: 0,0:18:34.66,0:18:36.62,Default,,0000,0000,0000,,ومددته للمطبخ كذلك
Dialogue: 0,0:18:36.99,0:18:39.95,Default,,0000,0000,0000,,هكذا اكتملت تجهيزاتك
Dialogue: 0,0:18:39.95,0:18:46.49,Default,,0000,0000,0000,,رنّ الهاتف آنذاك، وصعدت الرئيسة\Nيامازاكي للمكتب في الطابق العلويّ
Dialogue: 0,0:18:46.49,0:18:49.33,Default,,0000,0000,0000,,في الآن ذاته، كنتُ على الهاتف
Dialogue: 0,0:18:49.33,0:18:56.54,Default,,0000,0000,0000,,أجل، اتّصلتَ بمكتبها كي تجعلها تتوجّه له
Dialogue: 0,0:18:56.54,0:18:59.70,Default,,0000,0000,0000,,،بعد تأكّدك من رفعها للسمّاعة
Dialogue: 0,0:18:59.70,0:19:02.83,Default,,0000,0000,0000,,سحبت أحد الخيطين
Dialogue: 0,0:19:02.83,0:19:07.83,Default,,0000,0000,0000,,نُزع الشريط اللاصق الذي كان يغطّي\Nالجزء الممزّق في الكيس سلفاً
Dialogue: 0,0:19:07.83,0:19:10.44,Default,,0000,0000,0000,,فخرجت الدبابير
Dialogue: 0,0:19:11.79,0:19:17.62,Default,,0000,0000,0000,,كان البالون يحجب الجانب العلويّ\Nللمدخنة، فدخلت الدبابير الغرفة
Dialogue: 0,0:19:17.62,0:19:22.58,Default,,0000,0000,0000,,وهاجمت الدبابير المستثارة الرئيسة يامازاكي
Dialogue: 0,0:19:23.41,0:19:27.05,Default,,0000,0000,0000,,توجّهت للباب وهي ترشّها بمبيد الحشرات\Nالذي كان في مكتبها
Dialogue: 0,0:19:27.49,0:19:33.97,Default,,0000,0000,0000,,لكنّها لم تستطع فتحه، فقد كانت الدبابير\Nمتجمّعةً على مقبض الباب
Dialogue: 0,0:19:33.97,0:19:38.12,Default,,0000,0000,0000,,لم يكن أمامها خيار آخر، فاستدارت وحطّمت النافذة
Dialogue: 0,0:19:38.12,0:19:40.94,Default,,0000,0000,0000,,وقفزت إلى الشرفة
Dialogue: 0,0:19:41.12,0:19:43.45,Default,,0000,0000,0000,,اتكأت على السور، ووجّهت البخّاخ نحو الدبّور
Dialogue: 0,0:19:43.45,0:19:46.81,Default,,0000,0000,0000,,لكن انهار السور، فسقطت لحتفها
Dialogue: 0,0:19:48.32,0:19:51.41,Default,,0000,0000,0000,,بعدما هرعنا للخارج، رجعت للمطبخ من فورك
Dialogue: 0,0:19:51.41,0:19:52.78,Default,,0000,0000,0000,,وحللتَ الخيط الآخر
Dialogue: 0,0:19:53.33,0:19:58.33,Default,,0000,0000,0000,,وهكذا غادر البالون المدخنة
Dialogue: 0,0:19:58.33,0:20:01.16,Default,,0000,0000,0000,,وذلك ما شهدته ران وكونان
Dialogue: 0,0:20:01.45,0:20:04.63,Default,,0000,0000,0000,,لكن وقع شيءٌ خلاف حساباتك
Dialogue: 0,0:20:04.63,0:20:09.20,Default,,0000,0000,0000,,كان يُفترض أن يرحل البالون\Nلمكانٍ بعيد في الأفق
Dialogue: 0,0:20:09.20,0:20:14.68,Default,,0000,0000,0000,,لكن لسوء حظّك، علق في غصن شجرة\Nبسبب المطر الخفيف والرياح
Dialogue: 0,0:20:19.04,0:20:20.47,Default,,0000,0000,0000,,!وجدتُ الشريط اللاصق
Dialogue: 0,0:20:21.54,0:20:23.69,Default,,0000,0000,0000,,ويوجد ثقبٌ على الأرض بالفعل
Dialogue: 0,0:20:23.69,0:20:26.15,Default,,0000,0000,0000,,!لن ينفع هذا كدليل
Dialogue: 0,0:20:26.15,0:20:30.41,Default,,0000,0000,0000,,آيهارا-سان، هلّا أريتنا المنشفة على خصرك؟
Dialogue: 0,0:20:30.41,0:20:33.62,Default,,0000,0000,0000,,المنشفة؟! ما-ما بالمنشفة؟
Dialogue: 0,0:20:33.62,0:20:38.29,Default,,0000,0000,0000,,يُفترض أنّ مقبض الباب\Nكان غارقاً بالعسل
Dialogue: 0,0:20:38.29,0:20:41.08,Default,,0000,0000,0000,,ألم تمسحه بتلك المنشفة؟
Dialogue: 0,0:20:47.49,0:20:49.67,Default,,0000,0000,0000,,!يوجد عسلٌ عليها بالفعل
Dialogue: 0,0:20:49.67,0:20:51.95,Default,,0000,0000,0000,,وشيء آخر
Dialogue: 0,0:20:51.95,0:20:55.63,Default,,0000,0000,0000,,أخرج ما في جيب بنطالك الأيمن رجاءً
Dialogue: 0,0:20:59.49,0:21:02.14,Default,,0000,0000,0000,,ما الخطب؟ أرنا
Dialogue: 0,0:21:04.60,0:21:10.61,Default,,0000,0000,0000,,ذاك هو الخيط الذي خلع الشريط\Nاللاصق من على الكيس البلاستيكيّ
Dialogue: 0,0:21:10.95,0:21:13.94,Default,,0000,0000,0000,,آنذاك، فاجأك العمدة والكونان بدخولهما
Dialogue: 0,0:21:13.94,0:21:17.07,Default,,0000,0000,0000,,فأقحمته في جيبك في عجلة
Dialogue: 0,0:21:17.54,0:21:21.41,Default,,0000,0000,0000,,يبدو أنّك لم تمتلك وقتاً\Nللتخلّص من الدليل
Dialogue: 0,0:21:21.41,0:21:24.92,Default,,0000,0000,0000,,أو أهملتَ عندما افترضنا أنّه حادث
Dialogue: 0,0:21:26.74,0:21:31.12,Default,,0000,0000,0000,,كان تعييني مدبّر المنزل لإنقاذي\N،حياتها لافتةً جميلة
Dialogue: 0,0:21:31.12,0:21:36.05,Default,,0000,0000,0000,,لكنّها جعلتني أكدّ في العمل\Nكنحلة خادمة لملكة النحل
Dialogue: 0,0:21:36.05,0:21:40.29,Default,,0000,0000,0000,,قالت أنّها ستجعلني مدير منتجع\Nالينابيع الساخنة إذا اكتمل إنشاؤه
Dialogue: 0,0:21:40.29,0:21:42.26,Default,,0000,0000,0000,,!فصبرت واجتهدت
Dialogue: 0,0:21:42.97,0:21:48.29,Default,,0000,0000,0000,,.لكنّها كانت كذبة، كذبة بالكامل\Nلم أعد أستطيع الاحتمال
Dialogue: 0,0:21:48.54,0:21:51.23,Default,,0000,0000,0000,,أردتُ إفساد حفل الافتتاح بالغد
Dialogue: 0,0:21:51.70,0:21:53.70,Default,,0000,0000,0000,,لكن كان عليّ فعلها اليوم
Dialogue: 0,0:23:31.75,0:23:37.00,Default,,0000,0000,0000,,!كما يُتوقّع منك يا أبي! حُلّت القضيّة\N!استنتاجاتك مبهرة كالعادة
Dialogue: 0,0:23:38.63,0:23:41.22,Default,,0000,0000,0000,,!لم يكن ذلك شيئاً يُذكر، أشبه بوجبة خفيفة
Dialogue: 0,0:23:41.35,0:23:45.06,Default,,0000,0000,0000,,بالمناسبة، أشعر بالجوع، ولم نذهب للينابيع الساخنة
Dialogue: 0,0:23:45.47,0:23:50.17,Default,,0000,0000,0000,,!حسناً! سأذهب للينابيع السخنة وأصقل رجولتي
Dialogue: 0,0:23:50.17,0:23:54.25,Default,,0000,0000,0000,,!فرصة لكوغورو النائم ليستعرض ذكاءه وبدنه
Dialogue: 0,0:23:56.70,0:24:00.03,Default,,0000,0000,0000,,ما يمكنك استعراضه هو النوم فقط
Dialogue: 0,0:24:03.24,0:24:04.91,Default,,0000,0000,0000,,!ما هذا؟
Dialogue: 0,0:24:04.91,0:24:07.83,Default,,0000,0000,0000,,!الغرفة مليئة بملصقات الفنّانين
Dialogue: 0,0:24:08.12,0:24:11.91,Default,,0000,0000,0000,,وجد نسختان من كلّ شيء حتّى الكتب \Nالمصوّرة والأقراص المدمجة
Dialogue: 0,0:24:11.91,0:24:14.92,Default,,0000,0000,0000,,كما عليها اسماهما
Dialogue: 0,0:24:18.74,0:24:22.16,Default,,0000,0000,0000,,!لم يكن هذا انتحاراً، بل جريمة قتل
Dialogue: 0,0:24:22.16,0:24:25.83,Default,,0000,0000,0000,,لكنّها غرفة مغلقة، كيف هرب القاتل؟
Dialogue: 0,0:24:25.98,0:24:31.48,On Top,,0000,0000,0000,,جريمة قتل الحمّام المغلق\N(الجزء الأوّل)
Dialogue: 0,0:24:26.83,0:24:28.37,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:28.37,0:24:31.56,Default,,0000,0000,0000,,جريمة قتل الحمّام المغلق\N(الجزء الأوّل)
Dialogue: 0,0:24:47.43,0:24:49.46,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.46,0:24:51.13,Default,,0000,0000,0000,,شريط لاصق
Dialogue: 0,0:24:51.80,0:24:53.78,Default,,0000,0000,0000,,تقع أحداث الحلقة القادمة\N!في منزل شقيقتين جميلتين
Dialogue: 0,0:24:53.78,0:24:55.91,Default,,0000,0000,0000,,!وفي حمّامهما! لا تسترق النظر يا كونان-كن

