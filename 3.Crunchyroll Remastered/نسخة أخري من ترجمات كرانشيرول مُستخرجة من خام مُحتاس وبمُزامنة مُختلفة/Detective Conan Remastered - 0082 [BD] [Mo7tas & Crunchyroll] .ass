Dialogue: 0,0:00:02.04,0:00:03.70,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مجرّة لامعة
Dialogue: 0,0:00:03.70,0:00:07.39,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.39,0:00:11.10,Default,,0000,0000,0000,,!قضيّة اليوم تُظهر سرّاً كبيراً وراء الاختطاف
Dialogue: 0,0:00:11.10,0:00:12.52,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.52,0:00:14.44,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.44,0:00:16.56,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:53.09,0:01:56.79,Default,,0000,0000,0000,,كنتُ ألعب لعبة "ركل العلبة" مع غينتا\Nوميتسوهيكو وأيومي
Dialogue: 0,0:01:57.08,0:02:00.46,Default,,0000,0000,0000,,وقادتنا الظروف لتناول الغداء في مطعم
Dialogue: 0,0:02:00.46,0:02:04.53,Default,,0000,0000,0000,,رفقة مُغنّية فرقة تو-ميكس، تاكاياما مينامي-سان
Dialogue: 0,0:02:04.59,0:02:11.46,Default,,0000,0000,0000,,كانت قد تسلّلت خارج قاعة الحفل بحثاً\Nعن زميلها ناغانو شينا-سان الذي لم يجب على اتّصالاتها
Dialogue: 0,0:02:13.46,0:02:19.22,Default,,0000,0000,0000,,!لكن عند المطعم، اُختطفت تاكاياما-سان أمام أعيننا
Dialogue: 0,0:02:21.06,0:02:24.51,Default,,0000,0000,0000,,كان طلب الخاطفين هي الحقيبة\Nالتي تركتها في المطعم
Dialogue: 0,0:02:26.30,0:02:29.44,Default,,0000,0000,0000,,فوق ذلك، طلبوا أن نكون نحن من يجلبها
Dialogue: 0,0:02:30.54,0:02:34.59,Default,,0000,0000,0000,,يبدو أنّ هدفهم كان الشريط الاستعراضيّ لـ تو-ميكس
Dialogue: 0,0:02:36.04,0:02:40.92,Default,,0000,0000,0000,,بعد أخذنا الحقيبة كما أمروا، اتّصل المختطِفون بنا
Dialogue: 0,0:02:41.21,0:02:45.65,Default,,0000,0000,0000,,وأخبرونا أن نضلل رجال الشرطة الذين كانوا يتبعوننا\Nونترك أيومي تسلّم الشريط الاستعراضي بمفردها
Dialogue: 0,0:02:47.62,0:02:50.46,Default,,0000,0000,0000,,لا يمكنني تعريض أيومي للخطر
Dialogue: 0,0:02:51.34,0:02:53.57,Default,,0000,0000,0000,,...لذا فكّرتُ بخطّة
Dialogue: 0,0:03:05.65,0:03:06.72,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:03:06.72,0:03:09.51,Default,,0000,0000,0000,,أحسنتِ يا صغيرتي
Dialogue: 0,0:03:09.51,0:03:12.55,Default,,0000,0000,0000,,لا يوجد أيّ رجال شرطة في الجوار، صحيح؟
Dialogue: 0,0:03:14.09,0:03:16.00,Default,,0000,0000,0000,,كلا، لا يبدو أنّ هناك أحد
Dialogue: 0,0:03:16.00,0:03:17.92,Default,,0000,0000,0000,,حسنٌ، ممتاز
Dialogue: 0,0:03:17.92,0:03:20.39,Default,,0000,0000,0000,,مستعدّة للقدوم الآن كما أخبرتك؟
Dialogue: 0,0:03:20.39,0:03:21.27,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:03:22.59,0:03:24.51,Default,,0000,0000,0000,,!سأبذل جهدي
Dialogue: 0,0:03:25.56,0:03:31.50,Title,,0000,0000,15,,\N{\fad(300,0)}قضيّة اختطاف الفنّانين الشهيرين\N(الجزء الثاني)
Dialogue: 0,0:03:26.77,0:03:30.53,Default,,0000,0000,0000,,قضيّة اختطاف الفنّانين الشهيرين\Nالجزء الثاني
Dialogue: 0,0:03:31.66,0:03:35.17,Default,,0000,0000,0000,,!ماذا؟! بادل كونان-كن وأيومي-كن مكانيهما؟
Dialogue: 0,0:03:35.98,0:03:37.96,Default,,0000,0000,0000,,...يا للهول
Dialogue: 0,0:03:37.96,0:03:40.69,Default,,0000,0000,0000,,!كان هدف المختطفين هو الشريط الاستعراضيّ
Dialogue: 0,0:03:40.69,0:03:45.82,Default,,0000,0000,0000,,...طلبوا أن نجعل أيومي تسلّمه ونضلّل الشرطة
Dialogue: 0,0:03:45.82,0:03:48.42,Default,,0000,0000,0000,,!فبادلني كونان-كن
Dialogue: 0,0:03:48.81,0:03:52.88,Default,,0000,0000,0000,,لكن لمَ لم تخبرونا أنّكما تبادلتما؟
Dialogue: 0,0:03:52.88,0:03:58.38,Default,,0000,0000,0000,,سيخففون حذرهم إذا جعلناهم يعتقدون\Nأنّ الخطّة نجحت
Dialogue: 0,0:03:58.38,0:04:02.88,Default,,0000,0000,0000,,لذا أخبرنا كونان-كن بألّا نبوح لأحد\N!حتّى يتمّ ذلك
Dialogue: 0,0:04:02.88,0:04:07.12,Default,,0000,0000,0000,,...لكن لا يمكننا تحديد مكان المختطفين الآن
Dialogue: 0,0:04:07.12,0:04:08.79,Default,,0000,0000,0000,,كونان-كن في خطر
Dialogue: 0,0:04:09.24,0:04:11.99,Default,,0000,0000,0000,,بخصوص ذلك، قال أنّه إذا استعملنا\N...نظّارات التعقّب هذه
Dialogue: 0,0:04:12.76,0:04:16.08,Default,,0000,0000,0000,,سينال كونان المجد كلّه لوحده على هذا النحو
Dialogue: 0,0:04:16.08,0:04:20.71,Default,,0000,0000,0000,,!يمكننا إيجاد مخبئهم ثمّ إخبار الشرطة
Dialogue: 0,0:04:21.03,0:04:24.32,Default,,0000,0000,0000,,...بعدها، عندما ننقذ تو-ميكس
Dialogue: 0,0:04:25.57,0:04:29.17,On Top,,0000,0000,0000,,إنجاز كبير لفرقة\N!!فتيان التحرّي
Dialogue: 0,0:04:29.17,0:04:31.38,Default,,0000,0000,0000,,!شكراً لكم يا أولاد
Dialogue: 0,0:04:31.68,0:04:33.02,Default,,0000,0000,0000,,!كلّ هذا بفضلكم
Dialogue: 0,0:04:35.27,0:04:39.46,Default,,0000,0000,0000,,!حسنٌ، لنعتقل نحن فرقة فتيان التحرّي الخاطفين
Dialogue: 0,0:04:42.59,0:04:45.42,Default,,0000,0000,0000,,لمَ تصرخون؟
Dialogue: 0,0:04:47.16,0:04:50.26,Default,,0000,0000,0000,,...لا، كنّا نقول
Dialogue: 0,0:04:50.27,0:04:52.53,Default,,0000,0000,0000,,"!كم نشعر بالجوع"
Dialogue: 0,0:04:52.62,0:04:53.51,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:04:53.62,0:04:58.27,Default,,0000,0000,0000,,"!أ-أجل! كنّا نقول "كم نشعر بالجوع
Dialogue: 0,0:04:58.40,0:05:02.24,Default,,0000,0000,0000,,إذاً، سنذهب لشراء طعام
Dialogue: 0,0:05:02.50,0:05:03.80,Default,,0000,0000,0000,,ارجعوا سريعاً
Dialogue: 0,0:05:03.94,0:05:05.53,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:05:05.64,0:05:10.85,Default,,0000,0000,0000,,!كم نشعر بالجوع! كم نشعر بالجوع
Dialogue: 0,0:05:21.72,0:05:22.47,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:05:22.67,0:05:25.83,Default,,0000,0000,0000,,يبدو أنّك أتيتِ بمفردك\Nوفقما اتّفقنا يا صغيرتي
Dialogue: 0,0:05:25.95,0:05:30.54,Default,,0000,0000,0000,,هيّا، اجلبي الشريط للطابق الثاني\Nفي المستودع المجاور لك
Dialogue: 0,0:05:30.54,0:05:33.35,Default,,0000,0000,0000,,فرقة تو-ميكس التي تحبّينها بانتظارك
Dialogue: 0,0:05:35.46,0:05:37.71,Default,,0000,0000,0000,,انتهى دوركما الآن
Dialogue: 0,0:05:38.03,0:05:41.21,Default,,0000,0000,0000,,فلتتلوا آخر دعواتكما قبل نفاد الوقت
Dialogue: 0,0:05:41.53,0:05:43.49,Default,,0000,0000,0000,,!أحضرتُه يا سيّدي
Dialogue: 0,0:05:43.49,0:05:46.73,Default,,0000,0000,0000,,!هكذا إذاً، شكراً لك يا صغيرتي
Dialogue: 0,0:05:48.52,0:05:49.38,Default,,0000,0000,0000,,...لمَ أنت
Dialogue: 0,0:05:54.85,0:05:58.18,Default,,0000,0000,0000,,ماذا؟ الرجل الذي كان في المقهى ليس موجوداً؟
Dialogue: 0,0:05:58.18,0:05:59.46,Default,,0000,0000,0000,,أخرج لمكانٍ ما؟
Dialogue: 0,0:06:05.79,0:06:06.97,Default,,0000,0000,0000,,أذاك هو المكان؟
Dialogue: 0,0:06:06.97,0:06:08.62,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:06:08.62,0:06:10.92,Default,,0000,0000,0000,,أتظنّان كونان-كن بخير؟
Dialogue: 0,0:06:11.33,0:06:12.79,Default,,0000,0000,0000,,ماذا سنفعل الآن؟
Dialogue: 0,0:06:12.79,0:06:15.82,Default,,0000,0000,0000,,علينا الاتّصال بالشرطة مبدئياً
Dialogue: 0,0:06:15.82,0:06:18.07,Default,,0000,0000,0000,,توجد حجرة هاتف هناك
Dialogue: 0,0:06:18.07,0:06:19.32,Default,,0000,0000,0000,,!حسنٌ، لنذهب
Dialogue: 0,0:06:19.32,0:06:20.09,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:06:26.40,0:06:27.52,Default,,0000,0000,0000,,...واحد واحد تسعة
Dialogue: 0,0:06:27.52,0:06:31.73,Default,,0000,0000,0000,,!انتظر! هذا مركز الإطفاء يا غينتا-كن\Nرقم الشرطة 110
Dialogue: 0,0:06:31.73,0:06:32.81,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:06:32.81,0:06:35.02,Default,,0000,0000,0000,,أيضاً أليس عليك ضغط هذا الزرّ؟
Dialogue: 0,0:06:35.02,0:06:35.79,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:37.30,0:06:38.47,Default,,0000,0000,0000,,نعم، هنا 110
Dialogue: 0,0:06:39.41,0:06:42.39,Default,,0000,0000,0000,,!المعذرة، نريد المفتّش ميغوري من فضلك
Dialogue: 0,0:06:43.89,0:06:46.33,Default,,0000,0000,0000,,مرحباً؟ ما الخطب يا فتى؟
Dialogue: 0,0:06:46.53,0:06:47.14,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:06:47.41,0:06:48.62,Default,,0000,0000,0000,,!مرحباً؟
Dialogue: 0,0:06:50.62,0:06:51.67,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:06:52.99,0:06:55.25,Default,,0000,0000,0000,,كـ-كيف وجدتنا؟
Dialogue: 0,0:06:55.98,0:06:58.70,Default,,0000,0000,0000,,أخبروني بأن أجلب هذا الشريط هنا
Dialogue: 0,0:06:59.07,0:07:02.82,Default,,0000,0000,0000,,...صحيح، استجوبونا بشدّة عن مكان الشريط
Dialogue: 0,0:07:02.82,0:07:04.92,Default,,0000,0000,0000,,لكن لمَ قد يريدانه؟
Dialogue: 0,0:07:05.32,0:07:08.89,Default,,0000,0000,0000,,لنترك التفاصيل إلى ما بعد هروبنا من هنا
Dialogue: 0,0:07:08.89,0:07:10.71,Default,,0000,0000,0000,,والشرطة ستأتي قريباً
Dialogue: 0,0:07:10.71,0:07:11.51,Default,,0000,0000,0000,,الشرطة؟
Dialogue: 0,0:07:11.51,0:07:15.47,Default,,0000,0000,0000,,إنّهم في طريقهم الآن باستعمال\Nنظّارات التعقّب خاصتي
Dialogue: 0,0:07:16.05,0:07:18.37,Default,,0000,0000,0000,,يقودهم جهاز الإرسال على هذه الشارة
Dialogue: 0,0:07:19.05,0:07:21.16,Default,,0000,0000,0000,,مـ-من أنت؟
Dialogue: 0,0:07:21.59,0:07:23.38,Default,,0000,0000,0000,,إيدوغاوا كونان
Dialogue: 0,0:07:23.38,0:07:24.37,Default,,0000,0000,0000,,مُتحرٍّ
Dialogue: 0,0:07:24.61,0:07:25.26,Default,,0000,0000,0000,,-مـ
Dialogue: 0,0:07:25.26,0:07:26.32,Default,,0000,0000,0000,,!مُتحرٍّ؟
Dialogue: 0,0:07:27.04,0:07:30.41,Default,,0000,0000,0000,,لنسرع قبل أن يرجع المُختطف الآخر
Dialogue: 0,0:07:32.20,0:07:34.51,Default,,0000,0000,0000,,...أنظّارات التعقّب التي تقصدها
Dialogue: 0,0:07:34.88,0:07:36.41,Default,,0000,0000,0000,,هي هذه؟
Dialogue: 0,0:07:36.69,0:07:37.79,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:07:37.79,0:07:39.03,Default,,0000,0000,0000,,!أنتم؟
Dialogue: 0,0:07:39.78,0:07:41.00,Default,,0000,0000,0000,,!لمَ أنتم هنا؟
Dialogue: 0,0:07:41.00,0:07:45.37,Default,,0000,0000,0000,,أمسكتُ بهم وهم يتجسّسون خارجاً
Dialogue: 0,0:07:46.56,0:07:49.93,Default,,0000,0000,0000,,!حمقى! لمَ لم تعطوا النظّارات للشرطة؟
Dialogue: 0,0:07:49.93,0:07:51.12,Default,,0000,0000,0000,,...أردنا
Dialogue: 0,0:07:52.52,0:07:55.12,Default,,0000,0000,0000,,...سيكون لديكم وقت كثير للشجار
Dialogue: 0,0:07:55.60,0:07:57.07,Default,,0000,0000,0000,,!في العالم الآخر
Dialogue: 0,0:08:08.41,0:08:09.54,Default,,0000,0000,0000,,وداعاً
Dialogue: 0,0:08:09.54,0:08:13.54,Default,,0000,0000,0000,,سأحوّلكم لرماد معاً، فلتكونوا مُمتنين
Dialogue: 0,0:08:13.85,0:08:17.78,Default,,0000,0000,0000,,!انتظر! أخبرنا بسبب اختطافك لنا على الأقل
Dialogue: 0,0:08:19.32,0:08:21.66,Default,,0000,0000,0000,,اسألي الإله في العالم الآخر
Dialogue: 0,0:08:22.01,0:08:24.69,Default,,0000,0000,0000,,"يتردد قرع جرس العدّ التنازليّ"
Dialogue: 0,0:08:25.53,0:08:27.89,Default,,0000,0000,0000,,"ويخبرك بأن تغيّر قلبك وتركض"
Dialogue: 0,0:08:27.89,0:08:30.20,Default,,0000,0000,0000,,"ها هو يتردد مرّة، اثنتين"
Dialogue: 0,0:08:30.89,0:08:33.39,Default,,0000,0000,0000,,"كصوت ألعاب نارية خارج موسمها"
Dialogue: 0,0:08:33.39,0:08:36.34,Default,,0000,0000,0000,,"صوت إفصاح أحدهم عن حبّه في مكان ما"
Dialogue: 0,0:08:36.47,0:08:38.34,Default,,0000,0000,0000,,...أيّها الصبيّ
Dialogue: 0,0:08:38.55,0:08:42.53,Default,,0000,0000,0000,,أجل، هذه كلمات الأغنية على الشريط\Nالاستعراضيّ لـ تو-ميكس
Dialogue: 0,0:08:42.59,0:08:45.82,Default,,0000,0000,0000,,!وسبب اختطافك لهما
Dialogue: 0,0:08:47.05,0:08:49.66,Default,,0000,0000,0000,,ألستُ محقّاً يا مياهارا ساتوشي-سان؟
Dialogue: 0,0:08:51.01,0:08:56.11,Default,,0000,0000,0000,,في ليلة رأس السنة، قتلتَ رجلاً مجهولاً\Nقرب معبد شوينجي
Dialogue: 0,0:08:56.11,0:08:59.12,Default,,0000,0000,0000,,وحقّق معك المفتّش ميغوري
Dialogue: 0,0:08:59.65,0:09:01.07,Default,,0000,0000,0000,,ليلة رأس السنة؟
Dialogue: 0,0:09:01.07,0:09:02.53,Default,,0000,0000,0000,,شوينجي؟
Dialogue: 0,0:09:02.53,0:09:05.78,Default,,0000,0000,0000,,!هناك خطرت لنا الأغنية
Dialogue: 0,0:09:06.06,0:09:11.52,Default,,0000,0000,0000,,وقعت بالقرب جريمة قتل عند قرابة\N...الحادية عشرة وخمسون دقيقة
Dialogue: 0,0:09:11.52,0:09:14.00,Default,,0000,0000,0000,,وذلك وقت قرع جرس المعبد
Dialogue: 0,0:09:14.48,0:09:22.35,Default,,0000,0000,0000,,عندما وصلت الشرطة، وجدت آثار بارود\Nعلى يد الرجل الميت المُمسك بالمسدّس
Dialogue: 0,0:09:22.68,0:09:25.95,Default,,0000,0000,0000,,وكان هناك عيار فارغ في حجرة الإطلاق
Dialogue: 0,0:09:26.36,0:09:33.92,Default,,0000,0000,0000,,فصدّقت الشرطة مقولتك بأنّ رجلاً متنكّراً\Nهاجمك بمسدّس وانطلقت رصاصة أثناء الاشتباك
Dialogue: 0,0:09:33.92,0:09:35.95,Default,,0000,0000,0000,,فاعتُبرت الحادثة دفاعاً عن النفس
Dialogue: 0,0:09:36.57,0:09:38.87,Default,,0000,0000,0000,,لكن لم يكن ذلك الواقع
Dialogue: 0,0:09:39.32,0:09:44.79,Default,,0000,0000,0000,,كنتَ قد جلبت المسدّس معك\Nبنيّة قتل ذاك الرجل من البداية
Dialogue: 0,0:09:45.07,0:09:48.98,Default,,0000,0000,0000,,،بعد إطلاق الرصاصة الأولى في قلبه
Dialogue: 0,0:09:48.98,0:09:52.87,Default,,0000,0000,0000,,لقمّت المسدّس برصاصة أخرى وأطلقت على الأرض
Dialogue: 0,0:09:53.27,0:09:57.41,Default,,0000,0000,0000,,والمسدّس بيد الضحيّة كي تنتقل آثار البارود له
Dialogue: 0,0:09:59.55,0:10:04.14,Default,,0000,0000,0000,,لم يكن هناك شهود في الجوار، لذا بينما اتّصلت بالشرطة
Dialogue: 0,0:10:04.14,0:10:09.62,Default,,0000,0000,0000,,تخلّص الرجل الآخر النائم خارجاً\Nمن الرصاصة الأخرى والعيار
Dialogue: 0,0:10:09.79,0:10:11.80,Default,,0000,0000,0000,,فتكتمل روايتك
Dialogue: 0,0:10:13.08,0:10:17.70,Default,,0000,0000,0000,,...لكن كان هناك أشخاص قد سمعوا تلك الأصوات
Dialogue: 0,0:10:17.74,0:10:19.24,Default,,0000,0000,0000,,...أ-أتقصد
Dialogue: 0,0:10:19.53,0:10:22.71,Default,,0000,0000,0000,,أجل، أنتما ثنائيّ تو-ميكس
Dialogue: 0,0:10:23.57,0:10:25.98,Default,,0000,0000,0000,,جرس العدّ التنازلي" يرمز لجرس رأس السنة"
Dialogue: 0,0:10:25.98,0:10:28.73,Default,,0000,0000,0000,,والصوتان المترددان كالألعاب النارية\Nكانا صوتي الطلقتين
Dialogue: 0,0:10:28.73,0:10:34.70,Default,,0000,0000,0000,,"ومقدّمة الأغنية التي تقول "مرّت 1996 بلمح البصر\Nتشير لعام وقوع الحادثة
Dialogue: 0,0:10:36.24,0:10:40.10,Default,,0000,0000,0000,,أضف ذلك لمعبد شوينجي الذي ذُكر \Nفي بثّ تو-ميكس
Dialogue: 0,0:10:40.10,0:10:44.08,Default,,0000,0000,0000,,وستعرف زمن ومكان الطلقتين الناريتين
Dialogue: 0,0:10:44.51,0:10:48.64,Default,,0000,0000,0000,,استمعتَ للبثّ الذي أذاع\Nالشريط الاستعراضيّ، أليس كذلك؟
Dialogue: 0,0:10:49.38,0:10:51.79,Default,,0000,0000,0000,,لذا اختطفت تو-ميكس
Dialogue: 0,0:10:52.09,0:10:57.30,Default,,0000,0000,0000,,للتخلّص من الشريط قبل أن\N!تنتبه الشرطة لذلك
Dialogue: 0,0:10:59.08,0:11:01.50,Default,,0000,0000,0000,,يا لدهائك
Dialogue: 0,0:11:04.68,0:11:08.90,Default,,0000,0000,0000,,معك حقّ، أنا مياهارا ساتوشي
Dialogue: 0,0:11:08.90,0:11:14.54,Default,,0000,0000,0000,,الرجل الذي قتلتُه كان شريكاً\Nفي عمليّة سطو سابقة
Dialogue: 0,0:11:14.88,0:11:19.81,Default,,0000,0000,0000,,أتى وبدأ بتهديدي بإخبار الشرطة فجأةً، فتخلّصتُ منه
Dialogue: 0,0:11:20.05,0:11:23.06,Default,,0000,0000,0000,,ألم يكن بإمكانك الهرب بعد ذلك وحسب؟
Dialogue: 0,0:11:23.06,0:11:24.54,Default,,0000,0000,0000,,لم يكن لديّ خيار
Dialogue: 0,0:11:24.84,0:11:31.50,Default,,0000,0000,0000,,فقد رأى أحد رهبان المعبد\Nوجهي وأنا في طريقي للقائه
Dialogue: 0,0:11:31.94,0:11:34.21,Default,,0000,0000,0000,,كان ضعيف السمع لحسن الحظّ
Dialogue: 0,0:11:34.21,0:11:39.62,Default,,0000,0000,0000,,قال أنّه سيبقى في المعبد بمفرده\Nليقرع الأجراس، فتركتُه يعيش
Dialogue: 0,0:11:40.45,0:11:46.16,Default,,0000,0000,0000,,لكن لم يخطر لي أبداً أنّ هنالك\Nمن سمع الطلقات وألّف أغنيةً بها
Dialogue: 0,0:11:47.87,0:11:50.15,Default,,0000,0000,0000,,ماذا؟ هاتف خلويّ؟
Dialogue: 0,0:11:50.60,0:11:51.83,Default,,0000,0000,0000,,!سلّمه
Dialogue: 0,0:11:55.19,0:12:00.24,Default,,0000,0000,0000,,هذا هاتف الشاب طويل الشعر هنا\Nالذي جعلتُ شريكي يحتفظ به
Dialogue: 0,0:12:00.49,0:12:03.71,Default,,0000,0000,0000,,يا إلهي، صبي يتصيّد الإهمال
Dialogue: 0,0:12:04.04,0:12:09.26,Default,,0000,0000,0000,,لكن حتّى لو استدعيت الشرطة، ستحترقون\Nقبل أن يصلوا هنا غالباً
Dialogue: 0,0:12:09.98,0:12:13.31,Default,,0000,0000,0000,,فلتستمتعوا بوقتكم المتبقّي يا سادة
Dialogue: 0,0:12:19.76,0:12:21.06,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:12:21.99,0:12:27.42,Default,,0000,0000,0000,,مفتّش ميغوري؟ أطلقتُ سراح الاثنين والأطفال\Nبلا أيّ إصابات
Dialogue: 0,0:12:27.42,0:12:28.34,Default,,0000,0000,0000,,وداعاً
Dialogue: 0,0:12:29.75,0:12:34.64,Default,,0000,0000,0000,,غريب، لم يقل شيئاً عن تبدّل كونان-كن وأيومي
Dialogue: 0,0:12:34.92,0:12:37.99,Default,,0000,0000,0000,,حضرة المفتّش، وصلنا بلاغ على المذياع
Dialogue: 0,0:12:37.99,0:12:43.10,Default,,0000,0000,0000,,بأنّ طفلاً اتّصل بـ 110 وطلب الكلام معك
Dialogue: 0,0:12:43.31,0:12:44.81,Default,,0000,0000,0000,,!ماذا؟ متى؟
Dialogue: 0,0:12:45.16,0:12:47.76,Default,,0000,0000,0000,,...حسناً، قبل 15 دقيقة تقريباً
Dialogue: 0,0:12:47.76,0:12:49.52,Default,,0000,0000,0000,,!لمَ لم يخبرونا قبلاً؟
Dialogue: 0,0:12:49.52,0:12:55.06,Default,,0000,0000,0000,,،قالوا أنّ المتّصل لم يبلّغ عن شيء\Nفظنّ الموظّف أنّها كانت مكالمة عابثة
Dialogue: 0,0:12:55.33,0:12:56.38,Default,,0000,0000,0000,,!أتعرفون الموقع؟
Dialogue: 0,0:12:56.75,0:13:00.89,Default,,0000,0000,0000,,كلا، كانت قصيرة فلم يستطيعوا تعقّبها
Dialogue: 0,0:13:01.14,0:13:06.96,Default,,0000,0000,0000,,يا للهول! لو كان المختطف هو\N...من اكتشف الاتّصال وقطع الخط
Dialogue: 0,0:13:17.12,0:13:19.38,Default,,0000,0000,0000,,!لا جدوى! لا يتزحزح البتّة
Dialogue: 0,0:13:20.87,0:13:23.81,Default,,0000,0000,0000,,...حسنٌ، سأستعمل حذاء مضاعفة قوّة الركل
Dialogue: 0,0:13:26.23,0:13:26.97,Default,,0000,0000,0000,,!ابتعد
Dialogue: 0,0:13:32.01,0:13:34.47,Default,,0000,0000,0000,,!تبّاً! لا جدوى
Dialogue: 0,0:13:38.52,0:13:40.02,Default,,0000,0000,0000,,أأنتم بخير يا صغار؟
Dialogue: 0,0:13:40.02,0:13:43.18,Default,,0000,0000,0000,,!هذا سيّئ! لن ينجو أحد على هذا النحو
Dialogue: 0,0:13:43.68,0:13:47.21,Default,,0000,0000,0000,,...إيّاكم أن تستنشقوا الدخان! انخفضوا و
Dialogue: 0,0:13:49.76,0:13:50.89,Default,,0000,0000,0000,,!يا فتى
Dialogue: 0,0:13:51.51,0:13:52.85,Default,,0000,0000,0000,,أأنت بخير يا فتى؟
Dialogue: 0,0:13:53.30,0:13:54.60,Default,,0000,0000,0000,,!تماسك
Dialogue: 0,0:13:55.22,0:13:56.42,Default,,0000,0000,0000,,!يا فتى
Dialogue: 0,0:13:59.18,0:14:01.85,Default,,0000,0000,0000,,يا للحِمل
Dialogue: 0,0:14:06.99,0:14:08.61,Default,,0000,0000,0000,,...الشرطة المزعجة
Dialogue: 0,0:14:08.61,0:14:10.01,Default,,0000,0000,0000,,...أنتم! يكفي
Dialogue: 0,0:14:10.01,0:14:13.47,Default,,0000,0000,0000,,!مرحى! هربنا منذ فترة
Dialogue: 0,0:14:13.47,0:14:14.52,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:14.52,0:14:16.14,Default,,0000,0000,0000,,!نحن نتّصل من مركز الشرطة
Dialogue: 0,0:14:16.14,0:14:18.43,Default,,0000,0000,0000,,اذهب وانظر بنفسك إذا\N!كنت لا تصدّقنا
Dialogue: 0,0:14:18.64,0:14:20.52,Default,,0000,0000,0000,,!مـ-مستحيل
Dialogue: 0,0:14:30.34,0:14:31.50,Default,,0000,0000,0000,,!اختفوا
Dialogue: 0,0:14:33.05,0:14:34.68,Default,,0000,0000,0000,,...كـ-كيف
Dialogue: 0,0:14:37.25,0:14:39.13,Default,,0000,0000,0000,,كيف خرجوا؟
Dialogue: 0,0:14:44.85,0:14:46.30,Default,,0000,0000,0000,,!نجحنا
Dialogue: 0,0:14:46.78,0:14:50.72,Default,,0000,0000,0000,,!رأيتِ؟ كان هاتف القرط الخلويّ هذا مفيداً
Dialogue: 0,0:14:51.15,0:14:52.10,Default,,0000,0000,0000,,!بالفعل
Dialogue: 0,0:14:52.40,0:14:55.07,Default,,0000,0000,0000,,لنسرع! لا يزال بإمكاننا الوصول \N!للقاعة قبل الحفلة
Dialogue: 0,0:14:55.27,0:14:56.48,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:14:59.73,0:15:00.64,Default,,0000,0000,0000,,!انخفضوا جميعاً
Dialogue: 0,0:15:04.36,0:15:05.81,Default,,0000,0000,0000,,!شينا-كن
Dialogue: 0,0:15:06.88,0:15:08.77,Default,,0000,0000,0000,,!لا تستخفّوا بي يا صغار
Dialogue: 0,0:15:09.22,0:15:11.39,Default,,0000,0000,0000,,!سأقتلكم فرداً فرداً
Dialogue: 0,0:15:11.75,0:15:12.94,Default,,0000,0000,0000,,!الوغد
Dialogue: 0,0:15:11.75,0:15:12.94,Default,,0000,0000,0000,,!الوغد
Dialogue: 0,0:15:22.69,0:15:24.57,Default,,0000,0000,0000,,!مذهل يا مينامي-تشان
Dialogue: 0,0:15:24.57,0:15:25.80,Default,,0000,0000,0000,,!يا لقوّتها
Dialogue: 0,0:15:30.07,0:15:32.11,Default,,0000,0000,0000,,فعلتُها في آخر لحظة
Dialogue: 0,0:15:33.07,0:15:37.51,Default,,0000,0000,0000,,بعد 10 دقائق، وصلت عربة إطفاء\Nمع مجموعة من سيّارات الشرطة
Dialogue: 0,0:15:37.81,0:15:41.47,Default,,0000,0000,0000,,واعتقلت الشرطة المجرمين
Dialogue: 0,0:15:42.23,0:15:46.46,Default,,0000,0000,0000,,تلقّت فرقة فتيان التحرّي \Nتوبيخاً شديداً بالطبع
Dialogue: 0,0:15:47.39,0:15:51.64,Default,,0000,0000,0000,,،لكنّ تاكاياما مينامي-سان تدخّلت\Nوأُصفح عنّا للوقت الراهن
Dialogue: 0,0:15:52.01,0:15:55.29,Default,,0000,0000,0000,,ثمّ أسرعنا لقاعة بودوكان\Nبسيّارة المفتّش ميغوري
Dialogue: 0,0:15:59.55,0:16:01.81,Default,,0000,0000,0000,,!ما الذي تفعلونه؟
Dialogue: 0,0:16:01.81,0:16:04.01,Default,,0000,0000,0000,,!تأخّرتم 30 دقيقة بالفعل
Dialogue: 0,0:16:07.24,0:16:10.64,Default,,0000,0000,0000,,هذا سيّئ، الحضور يتذمرون
Dialogue: 0,0:16:11.07,0:16:15.59,Default,,0000,0000,0000,,علينا تغيير ثيابنا، لذا انتظروا في كواليس المسرح
Dialogue: 0,0:16:16.27,0:16:17.55,Default,,0000,0000,0000,,كواليس المسرح؟
Dialogue: 0,0:16:18.52,0:16:21.76,Default,,0000,0000,0000,,سنقدّمكم للجميع لاحقاً
Dialogue: 0,0:16:23.02,0:16:25.21,Default,,0000,0000,0000,,للـ-للجميع؟
Dialogue: 0,0:16:25.51,0:16:28.32,Default,,0000,0000,0000,,لم تأت مينامي-تشان بعد؟
Dialogue: 0,0:16:28.32,0:16:30.18,Default,,0000,0000,0000,,يا إلهي! ما الذي تفعله؟
Dialogue: 0,0:16:30.18,0:16:33.51,Default,,0000,0000,0000,,المعذرة... أهذه كواليس المسرح؟
Dialogue: 0,0:16:33.76,0:16:36.63,Default,,0000,0000,0000,,!أنتم! ليس مسموحاً لكم الدخول هنا
Dialogue: 0,0:16:36.89,0:16:38.54,Default,,0000,0000,0000,,!ارجعوا لمقاعدكم
Dialogue: 0,0:16:38.54,0:16:41.17,Default,,0000,0000,0000,,أخبرتنا تاكاياما-سان أن نأتي هنا
Dialogue: 0,0:16:41.17,0:16:43.10,Default,,0000,0000,0000,,!ماذا؟ وصلت مينامي-تشان؟
Dialogue: 0,0:16:44.00,0:16:46.76,Default,,0000,0000,0000,,!حسنٌ! ضعوا الأغنية الافتتاحية في وضعية الاستعداد
Dialogue: 0,0:16:46.97,0:16:50.47,Default,,0000,0000,0000,,أنتم! ليذهب أحدكم لغرفة تبديل الملابس\N!ويسألها كم ستستغرق أكثر
Dialogue: 0,0:16:50.59,0:16:51.24,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:16:51.24,0:16:52.88,Default,,0000,0000,0000,,المعذرة، ما الذي يفعله هذا؟
Dialogue: 0,0:16:52.88,0:16:54.52,Default,,0000,0000,0000,,!انتبه! لا تلمسه
Dialogue: 0,0:16:54.52,0:16:55.42,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:16:57.79,0:16:58.85,On Top,,0000,0000,0000,,!سيبدؤون
Dialogue: 0,0:17:01.82,0:17:03.43,Default,,0000,0000,0000,,!انطفأت الأنوار
Dialogue: 0,0:17:03.63,0:17:05.08,Default,,0000,0000,0000,,!حسنٌ، دوري
Dialogue: 0,0:17:05.08,0:17:05.84,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:17:17.05,0:17:20.46,Default,,0000,0000,0000,,!مـ-مشكلة! بدأت الأغنية
Dialogue: 0,0:17:20.46,0:17:23.47,Default,,0000,0000,0000,,!ما العمل؟ لم يأتيا بعد
Dialogue: 0,0:17:24.05,0:17:25.52,Default,,0000,0000,0000,,!أوقفوا الأغنية بسرعة
Dialogue: 0,0:17:25.53,0:17:28.93,Default,,0000,0000,0000,,أحمق! إذا فعلنا ذلك سيغضبون\N!أكثر من ذي قبل
Dialogue: 0,0:17:28.93,0:17:30.44,Default,,0000,0000,0000,,!ماذا نفعل إذاً؟
Dialogue: 0,0:17:30.44,0:17:32.75,Default,,0000,0000,0000,,!أفكّر بذلك الآن
Dialogue: 0,0:17:32.81,0:17:35.38,Default,,0000,0000,0000,,أخبروني، ألديكم كلمات هذه الأغنية؟
Dialogue: 0,0:17:35.69,0:17:39.30,Default,,0000,0000,0000,,ماذا؟ إنّها موجودة في علبة\N...ذاك القرص الرقمي
Dialogue: 0,0:17:40.53,0:17:42.70,Default,,0000,0000,0000,,لكن لمَ تريدها؟
Dialogue: 0,0:17:43.01,0:17:44.77,Default,,0000,0000,0000,,...ا-انتظر، أيمكن
Dialogue: 0,0:17:58.47,0:17:59.13,On Top,,0000,0000,0000,,♪ حطّم أكاذيبي ♪
Dialogue: 0,0:17:59.13,0:18:04.93,On Top,,0000,0000,0000,,♪ الحق بي مجدداً ♪
Dialogue: 0,0:18:04.93,0:18:05.95,On Top,,0000,0000,0000,,♪ أنقذ قلبي ♪
Dialogue: 0,0:18:05.95,0:18:09.91,On Top,,0000,0000,0000,,♪ أنا أنتظر في الواقع... عناقك لي ♪
Dialogue: 0,0:18:09.91,0:18:12.01,On Top,,0000,0000,0000,,♪ لنرجع للحُب الآن ♪
Dialogue: 0,0:18:12.34,0:18:16.19,Default,,0000,0000,0000,,...أشعر أنّي سمعتُ هذا الغناء قبلاً
Dialogue: 0,0:18:16.19,0:18:18.18,Default,,0000,0000,0000,,دعيك من المزح المخيفة
Dialogue: 0,0:18:21.03,0:18:22.60,Default,,0000,0000,0000,,!من الذي يغنّي؟
Dialogue: 0,0:18:23.03,0:18:24.54,Default,,0000,0000,0000,,إحساسه الموسيقيّ معدوم
Dialogue: 0,0:18:24.54,0:18:26.55,Default,,0000,0000,0000,,...لكن هذا صوت تاكاياما-سان
Dialogue: 0,0:18:28.60,0:18:30.01,Default,,0000,0000,0000,,أكان سيّئاً؟
Dialogue: 0,0:18:41.46,0:18:47.59,On Top,,0000,0000,0000,,لأنّي لم أستطع البوح بتلك ♪\N♪ الكلمة بصراحة، قد آذيتك
Dialogue: 0,0:18:47.77,0:18:54.47,On Top,,0000,0000,0000,,تسعى يدي لدفئك بشدّة ♪\N♪ بحيث تكاد دموعي تسيل
Dialogue: 0,0:18:54.81,0:19:01.17,On Top,,0000,0000,0000,,بينما تزداد خبرتي، ستصبح أحلامي أقلّ ♪\N♪ طفولية شيئاً فشيئاً
Dialogue: 0,0:18:57.45,0:18:58.48,Default,,0000,0000,0000,,...أليس ذاك
Dialogue: 0,0:18:58.48,0:19:00.46,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:19:01.18,0:19:08.63,On Top,,0000,0000,0000,,مع ذلك، بحثت لأنّني ♪\N♪ ما زلتُ أؤمن في أعماقي
Dialogue: 0,0:19:09.50,0:19:10.23,On Top,,0000,0000,0000,,♪ حطّم أكاذيبي ♪
Dialogue: 0,0:19:10.23,0:19:15.92,On Top,,0000,0000,0000,,♪ فلتلاحظ هذه الحقيقة المتموّجة في عيني ♪
Dialogue: 0,0:19:15.98,0:19:16.93,On Top,,0000,0000,0000,,♪ أنقذ قلبي ♪
Dialogue: 0,0:19:16.93,0:19:21.05,On Top,,0000,0000,0000,,♪ فلتقبّل هاتين الشفتين المرتجفتين ♪
Dialogue: 0,0:19:21.05,0:19:24.77,On Top,,0000,0000,0000,,♪ ونرجع للحُب الآن ♪
Dialogue: 0,0:19:39.16,0:19:45.63,On Top,,0000,0000,0000,,ما شعرتُ به عندما كنت معك ♪\N♪ لم يكن ضعفاً
Dialogue: 0,0:19:45.70,0:19:51.97,On Top,,0000,0000,0000,,بل طمأنينةً عوّضت عن ♪ \N♪ فجوةً داخلي
Dialogue: 0,0:19:52.34,0:19:58.63,On Top,,0000,0000,0000,,كلما كان المرء عزيزاً عليك، خشيت ♪ \N♪ فقدانك له
Dialogue: 0,0:19:58.63,0:20:06.56,On Top,,0000,0000,0000,,♪ وحيداً في الحشود، بحثتُ عن مكان أرجع له ♪
Dialogue: 0,0:20:07.45,0:20:08.11,On Top,,0000,0000,0000,,♪ حطّم أكاذيبي ♪
Dialogue: 0,0:20:08.11,0:20:13.72,On Top,,0000,0000,0000,,انتزع الألم الذي لا أستطيع ♪\N♪ التعبير عنه بكلمات
Dialogue: 0,0:20:10.47,0:20:16.37,Default,,0000,0000,0000,,وهكذا، أُقيمت حفلة تو-ميكس في بودوكان\Nالتي شاركنا فيها نحن فرقة فتيان التحرّي
Dialogue: 0,0:20:13.87,0:20:14.76,On Top,,0000,0000,0000,,♪ أنقذ قلبي ♪
Dialogue: 0,0:20:14.76,0:20:18.57,On Top,,0000,0000,0000,,♪ لا يمكنني الذهاب لأيّ مكان في صدرك ♪
Dialogue: 0,0:20:16.37,0:20:18.35,Default,,0000,0000,0000,,وانتهت دون مشاكل بشكلٍ ما
Dialogue: 0,0:20:18.59,0:20:22.49,On Top,,0000,0000,0000,,♪ فلنرجع للحُب الآن ♪
Dialogue: 0,0:20:26.94,0:20:28.34,Default,,0000,0000,0000,,نراكما لاحقاً إذاً
Dialogue: 0,0:20:28.34,0:20:29.43,Default,,0000,0000,0000,,!عمل مُوفق
Dialogue: 0,0:20:29.60,0:20:31.08,Default,,0000,0000,0000,,!عمل مُوفق
Dialogue: 0,0:20:31.08,0:20:31.92,Default,,0000,0000,0000,,عمل مُوفق
Dialogue: 0,0:20:33.56,0:20:37.34,Default,,0000,0000,0000,,إذاً، كيف كان الغناء على المسرح؟
Dialogue: 0,0:20:37.41,0:20:38.60,Default,,0000,0000,0000,,!رائعاً جدّاً
Dialogue: 0,0:20:38.60,0:20:40.02,Default,,0000,0000,0000,,!تأثّرتُ كثيراً
Dialogue: 0,0:20:40.02,0:20:41.80,Default,,0000,0000,0000,,!أريد فعلها مجدداً
Dialogue: 0,0:20:42.16,0:20:45.04,Default,,0000,0000,0000,,أليس كذلك؟ تختبر الأمر مرّةً وتصبح متعلّقاً
Dialogue: 0,0:20:45.04,0:20:48.26,Default,,0000,0000,0000,,وماذا عنك؟ ما رأي المتحرّي الصغير؟
Dialogue: 0,0:20:49.38,0:20:51.72,Default,,0000,0000,0000,,أسألك عن رأيك في الحفلة
Dialogue: 0,0:20:53.16,0:20:55.42,Default,,0000,0000,0000,,لا بأس بها
Dialogue: 0,0:20:56.28,0:20:58.03,Default,,0000,0000,0000,,!يا لغطرستك
Dialogue: 0,0:21:00.86,0:21:01.85,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:21:02.91,0:21:05.30,Default,,0000,0000,0000,,غرفة تبديل تو-ميكس؟
Dialogue: 0,0:21:05.77,0:21:08.26,Default,,0000,0000,0000,,حضرة المفتّش! أيمكننا مساعدتك؟
Dialogue: 0,0:21:08.98,0:21:12.23,Default,,0000,0000,0000,,،أعتذر على طلب هذا رغم إرهاقكما
Dialogue: 0,0:21:12.23,0:21:16.35,Default,,0000,0000,0000,,لكنّي كنت آمل أن تستطيعا\Nمرافقتنا للمركز للإدلاء بإفادتيكما
Dialogue: 0,0:21:16.78,0:21:19.33,Default,,0000,0000,0000,,هكذا إذاً؟ انتظر قليلاً من فضلك
Dialogue: 0,0:21:19.41,0:21:21.96,Default,,0000,0000,0000,,المعذرة، خذي وقتك
Dialogue: 0,0:21:23.89,0:21:26.79,Default,,0000,0000,0000,,كانت تلك حفلةً مذهلة بحقّ
Dialogue: 0,0:21:27.34,0:21:28.97,Default,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:21:29.52,0:21:30.43,Default,,0000,0000,0000,,هاكم
Dialogue: 0,0:21:31.04,0:21:34.60,Default,,0000,0000,0000,,!هذه هديّتكم لإنقاذنا اليوم\Nتمرّنوا في البيت، اتّفقنا؟
Dialogue: 0,0:21:35.10,0:21:36.09,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:21:39.35,0:21:41.01,Default,,0000,0000,0000,,واثنتان لكما سيّدي المفتّش
Dialogue: 0,0:21:42.79,0:21:44.54,Default,,0000,0000,0000,,!نحن مُمتنان
Dialogue: 0,0:21:44.54,0:21:46.92,Default,,0000,0000,0000,,أيمكنني الحصول على صورة وتوقيع أيضاً؟
Dialogue: 0,0:21:48.74,0:21:49.76,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:21:50.78,0:21:52.64,Default,,0000,0000,0000,,!مستعدّون؟ ما 1 زائد 1؟
Dialogue: 0,0:21:52.98,0:21:53.91,Default,,0000,0000,0000,,!اثنان
Dialogue: 0,0:23:29.93,0:23:32.69,On Top,,0000,0000,0000,,صندوق الكاراوكي
Dialogue: 0,0:23:35.89,0:23:36.93,On Top,,0000,0000,0000,,♪ حطّم أكاذيبي ♪
Dialogue: 0,0:23:36.93,0:23:42.64,On Top,,0000,0000,0000,,♪ الحق بي مجدّداً ♪
Dialogue: 0,0:23:39.58,0:23:41.57,Default,,0000,0000,0000,,...هذا كلّ ما كان يغنّيه
Dialogue: 0,0:23:41.57,0:23:43.48,Default,,0000,0000,0000,,لكنّه لم يتحسّن البتّة
Dialogue: 0,0:23:42.64,0:23:43.48,On Top,,0000,0000,0000,,♪ أنقذ قلبي ♪
Dialogue: 0,0:23:43.48,0:23:47.29,On Top,,0000,0000,0000,,♪ أنا أنتظر في الواقع... عناقك لي ♪
Dialogue: 0,0:23:47.29,0:23:51.16,On Top,,0000,0000,0000,,♪ فلنرجع للحُب الآن ♪
Dialogue: 0,0:23:55.28,0:23:58.06,On Top,,0000,0000,0000,,♪ فلنرجع للحُب ♪
Dialogue: 0,0:24:01.34,0:24:04.55,Default,,0000,0000,0000,,،كان العمّ نائماً في المشفى، لكنه عندما استيقظ
Dialogue: 0,0:24:04.55,0:24:08.15,Default,,0000,0000,0000,,!شاهد جريمةً في الجناح المقابل وهرع للمكان
Dialogue: 0,0:24:09.12,0:24:10.15,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:24:10.25,0:24:12.57,Default,,0000,0000,0000,,!عمّ! طبيب إيتو
Dialogue: 0,0:24:13.92,0:24:17.62,Default,,0000,0000,0000,,!من قتل الطبيب إيتو كان أنت يا موري-كن
Dialogue: 0,0:24:17.62,0:24:19.08,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:24:20.19,0:24:24.17,Default,,0000,0000,0000,,!كلا! وقع العمّ في فخّ
Dialogue: 0,0:24:24.07,0:24:30.06,On Top,,0000,0000,0000,,جريمة قتل المشفى العام
Dialogue: 0,0:24:25.06,0:24:26.47,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.47,0:24:28.93,Default,,0000,0000,0000,,جريمة قتل المشفى العام
Dialogue: 0,0:24:45.91,0:24:48.18,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.18,0:24:50.06,Default,,0000,0000,0000,,قهوة
Dialogue: 0,0:24:50.36,0:24:52.44,Default,,0000,0000,0000,,!مسرح الحلقة القادمة هو مشفى مخيف
Dialogue: 0,0:24:52.44,0:24:54.44,Default,,0000,0000,0000,,!أنا أكره الحقن

