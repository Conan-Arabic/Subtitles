Dialogue: 0,0:00:01.53,0:00:03.31,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.31,0:00:06.90,Default,,0000,0000,0000,,تُعالج استنتاجات كونان القلوب\N!المُثقلة بالمجتمع الحديث سريعًا
Dialogue: 0,0:00:07.34,0:00:10.57,Default,,0000,0000,0000,,!قضيّة اليوم جريمة مستحيلة! المال يأتي ويذهب
Dialogue: 0,0:00:10.89,0:00:12.52,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.52,0:00:14.38,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.38,0:00:16.08,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:50.87,0:01:56.75,Title,,0000,0000,15,,\N{\fad(300,0)}جريمة قتل رئيس الشركة المالية
Dialogue: 0,0:01:51.96,0:01:54.87,Default,,0000,0000,0000,,جريمة قتل رئيس الشركة المالية
Dialogue: 0,0:01:57.16,0:01:59.62,On Top,,0000,0000,15,,ماجونغ
Dialogue: 0,0:02:00.82,0:02:02.62,Default,,0000,0000,0000,,هل أترك "ريان بين" هنا؟
Dialogue: 0,0:02:02.94,0:02:05.68,Default,,0000,0000,0000,,قطعة "شابو" ستجعل الانتظار بلا جدوى
Dialogue: 0,0:02:05.99,0:02:09.49,Default,,0000,0000,0000,,!ماذا؟! أنت! لا تعبث بقطعي مُجدداً
Dialogue: 0,0:02:09.73,0:02:14.88,Default,,0000,0000,0000,,أين المشكلة؟ أنت تبلي حسناً اليوم\Nفاعتبرها عائقاً، عائق
Dialogue: 0,0:02:15.72,0:02:16.89,Default,,0000,0000,0000,,!رون
Dialogue: 0,0:02:19.22,0:02:21.33,Default,,0000,0000,0000,,!مينتشين وإبيكو ودورا دورا
Dialogue: 0,0:02:21.64,0:02:23.55,Default,,0000,0000,0000,,!"هـ-هذا "بايمان
Dialogue: 0,0:02:24.88,0:02:26.31,Default,,0000,0000,0000,,!خسرت
Dialogue: 0,0:02:26.31,0:02:28.28,Default,,0000,0000,0000,,ستغادر يا أوكانو؟
Dialogue: 0,0:02:28.75,0:02:32.38,Default,,0000,0000,0000,,.نعم، فالحظّ ليس في صفّي اليوم\Nاعذروني لكنّي سأغادر
Dialogue: 0,0:02:33.66,0:02:35.46,Default,,0000,0000,0000,,ماذا سنفعل؟ نحتاج لاعباً إضافياً
Dialogue: 0,0:02:35.46,0:02:37.07,Default,,0000,0000,0000,,لنسأل هيدا-سان
Dialogue: 0,0:02:37.07,0:02:38.41,Default,,0000,0000,0000,,هيدا-سان؟
Dialogue: 0,0:02:38.41,0:02:43.87,Default,,0000,0000,0000,,إنّه يدير الشركة المالية المقابلة، يُحب لعب الماجونغ
Dialogue: 0,0:02:44.37,0:02:46.33,On Top,,0000,0000,0000,,مكتب الرئيس
Dialogue: 0,0:02:48.92,0:02:53.32,CharCard,,0000,0000,0004,,\N{\fad(300,0)}(هيدا ميتسوهيرو (53\Nمدير شركة مالية
Dialogue: 0,0:02:49.19,0:02:53.57,On Top,,0000,0000,0000,,هذه 10 مليون ينّ، لا أستطيع التوقّف\N!عن التبسّم الليلة
Dialogue: 0,0:02:56.55,0:02:58.53,Default,,0000,0000,0000,,مرحباً؟ شركة هيدا المالية
Dialogue: 0,0:02:58.76,0:03:02.00,Default,,0000,0000,0000,,!هيدا-سان! لا تزال في مكتبك إذاً
Dialogue: 0,0:03:02.00,0:03:03.67,Default,,0000,0000,0000,,إنّه أنت يا هاسيغاوا-سان
Dialogue: 0,0:03:03.67,0:03:05.50,Default,,0000,0000,0000,,أتسمع هذا الصوت؟
Dialogue: 0,0:03:07.49,0:03:10.95,Default,,0000,0000,0000,,ينقصنا لاعب، لذا فكّرتُ بأن أسألك
Dialogue: 0,0:03:10.95,0:03:15.40,Default,,0000,0000,0000,,!سآتي! فورما أنتهي من عدّ المال المتبقي
Dialogue: 0,0:03:15.70,0:03:17.41,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:03:17.41,0:03:21.33,Default,,0000,0000,0000,,!سآتي في نصف ساعة! العبوا دوني حتّى حينها
Dialogue: 0,0:03:22.49,0:03:25.95,Default,,0000,0000,0000,,قال أنّه سيأتي بعد نصف ساعة\Nوأن نلعب دونه حتّى حينها
Dialogue: 0,0:03:25.95,0:03:28.49,Default,,0000,0000,0000,,!سأشغل مكانه إذاً
Dialogue: 0,0:03:28.82,0:03:30.52,Default,,0000,0000,0000,,جيّد يا فتى
Dialogue: 0,0:03:30.52,0:03:31.33,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:03:32.60,0:03:35.66,Default,,0000,0000,0000,,كونان-كن، كنتُ أتساءل أين كنت\N...بعدما لم ترجع
Dialogue: 0,0:03:36.14,0:03:38.82,Default,,0000,0000,0000,,!اصطحبته لمكان كهذا يا أبي؟
Dialogue: 0,0:03:39.14,0:03:40.53,Default,,0000,0000,0000,,!هيّا، لنرجع
Dialogue: 0,0:03:40.53,0:03:41.81,Default,,0000,0000,0000,,!مهلك
Dialogue: 0,0:03:41.81,0:03:45.36,Default,,0000,0000,0000,,ما رأيك أن تلعبي يا ران-تشان؟\Nتكفي نصف ساعة
Dialogue: 0,0:03:45.75,0:03:49.33,Default,,0000,0000,0000,,!كلا، أكره لعبة البالغين البائسة السخيفة هذه
Dialogue: 0,0:03:51.29,0:03:52.20,Default,,0000,0000,0000,,!رون
Dialogue: 0,0:03:53.29,0:03:56.62,Default,,0000,0000,0000,,!د-داي سان غين، سو آن كو، وتسو إي سو
Dialogue: 0,0:03:56.62,0:03:59.53,Default,,0000,0000,0000,,!يـ-ياكومان ثلاثيّ
Dialogue: 0,0:03:56.62,0:03:59.53,Default,,0000,0000,0000,,!يـ-ياكومان ثلاثيّ
Dialogue: 0,0:04:00.12,0:04:01.58,Default,,0000,0000,0000,,!فزتُ مجدداً
Dialogue: 0,0:04:01.58,0:04:02.50,Default,,0000,0000,0000,,...نعم
Dialogue: 0,0:04:02.90,0:04:05.30,Default,,0000,0000,0000,,...تأخّر هيدا-سان
Dialogue: 0,0:04:05.30,0:04:07.28,Default,,0000,0000,0000,,سأتّصل به
Dialogue: 0,0:04:11.98,0:04:15.43,Default,,0000,0000,0000,,غريب، لا يجيب مع أنّ مصابيح\Nالمكتب لا تزال مُضاءة
Dialogue: 0,0:04:15.43,0:04:16.70,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:04:16.93,0:04:20.85,Default,,0000,0000,0000,,بالمناسبة، عندما اتّصلتُ به سابقاً\Nبدا أنّه مرتبك بشكل غريب
Dialogue: 0,0:04:20.85,0:04:22.16,Default,,0000,0000,0000,,أيمكن أنّ لصّاً داهمه؟
Dialogue: 0,0:04:22.92,0:04:24.49,Default,,0000,0000,0000,,لنذهب لتفقد الأمر
Dialogue: 0,0:04:28.09,0:04:29.39,Default,,0000,0000,0000,,!هيدا-سان
Dialogue: 0,0:04:30.76,0:04:33.61,Default,,0000,0000,0000,,!أأنت في الداخل يا هيدا-سان؟ هيدا-سان
Dialogue: 0,0:04:33.83,0:04:36.83,CharCard,,0000,0000,0004,,\N{\fad(300,0)}(ميناميساوا هيسايوشي (34\Nموظّف في شركة هيدا المالية
Dialogue: 0,0:04:34.50,0:04:37.07,On Top,,0000,0000,0000,,ما الخطب؟ ماذا يجمعكم أمام مكتبنا؟
Dialogue: 0,0:04:37.41,0:04:42.03,Default,,0000,0000,0000,,انتظرنا مديركم لكنّه لم يأت، فأتينا لاستدعائه
Dialogue: 0,0:04:42.41,0:04:44.22,Default,,0000,0000,0000,,لا يزال في الداخل؟
Dialogue: 0,0:04:47.36,0:04:50.02,Default,,0000,0000,0000,,بالمناسبة، ماذا تفعل هنا؟
Dialogue: 0,0:04:50.15,0:04:52.53,Default,,0000,0000,0000,,نسيتُ هاتفي الخلويّ هنا
Dialogue: 0,0:04:55.83,0:04:56.68,Default,,0000,0000,0000,,ها هو
Dialogue: 0,0:04:56.98,0:04:57.62,Default,,0000,0000,0000,,هذا
Dialogue: 0,0:04:57.98,0:04:59.45,Default,,0000,0000,0000,,إذاً، أين المدير؟
Dialogue: 0,0:04:59.94,0:05:01.90,Default,,0000,0000,0000,,في مكتبه وفقما أظن
Dialogue: 0,0:05:07.01,0:05:09.92,Default,,0000,0000,0000,,!سيّدي! سيّدي
Dialogue: 0,0:05:09.92,0:05:11.20,Default,,0000,0000,0000,,أيوجد مفتاح بديل؟
Dialogue: 0,0:05:11.76,0:05:15.65,Default,,0000,0000,0000,,يستحيل أن يصنع مفتاحاً بديلاً\Nبما أنّ الخزنة هنا
Dialogue: 0,0:05:15.65,0:05:18.54,Default,,0000,0000,0000,,!لا أمامنا سوى فتحه بالقوّة إذاً
Dialogue: 0,0:05:21.71,0:05:22.41,Default,,0000,0000,0000,,!سـ-سيّدي
Dialogue: 0,0:05:28.28,0:05:30.83,Default,,0000,0000,0000,,لا جدوى، لا يتنفّس
Dialogue: 0,0:05:34.02,0:05:37.23,Default,,0000,0000,0000,,المُتوفى هو هيدا ميتسوهيرو-سان، 53 عاماً
Dialogue: 0,0:05:37.23,0:05:39.74,Default,,0000,0000,0000,,سبب الوفاة كان اختناقاً بسمّ سيانيد البوتاسيوم
Dialogue: 0,0:05:40.10,0:05:44.65,Default,,0000,0000,0000,,مات بين السابعة إلى السابعة والنصف مساء اليوم
Dialogue: 0,0:05:45.22,0:05:45.98,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:05:45.98,0:05:47.36,Default,,0000,0000,0000,,ما الأمر يا تاكاغي-كن؟
Dialogue: 0,0:05:48.09,0:05:51.83,Default,,0000,0000,0000,,المفتاح على الطاولة هو الخاص\Nبباب هذه الغرفة
Dialogue: 0,0:05:53.46,0:05:57.54,Default,,0000,0000,0000,,...وكون نوافذ المكتب مقفلةً من الداخل
Dialogue: 0,0:05:57.54,0:06:01.24,Default,,0000,0000,0000,,،يعني أنّها كانت جريمة مستحيلة\Nجريمة قتل غرفة مقفلة
Dialogue: 0,0:06:04.24,0:06:08.99,Default,,0000,0000,0000,,يُظهر شريط كاميرات المراقبة\Nمغادرتكم عند 7:04 مساءً
Dialogue: 0,0:06:08.99,0:06:14.61,Default,,0000,0000,0000,,ثمّ أقفل الرئيس الباب ورجع لمكتبه ليراجع الحسابات
Dialogue: 0,0:06:15.15,0:06:17.57,Default,,0000,0000,0000,,...وبعد ساعتين
Dialogue: 0,0:06:18.19,0:06:21.24,Default,,0000,0000,0000,,ظهرتم أنتم
Dialogue: 0,0:06:21.73,0:06:24.80,Default,,0000,0000,0000,,من كان الشخصان اللّذان رافقاك عندما غادرتم؟
Dialogue: 0,0:06:24.80,0:06:26.70,Default,,0000,0000,0000,,...كانا
Dialogue: 0,0:06:26.97,0:06:28.41,Default,,0000,0000,0000,,نحن
Dialogue: 0,0:06:29.58,0:06:31.89,On Top,,0000,0000,0000,,لمَ استدعيتني بالبيجر؟
Dialogue: 0,0:06:30.05,0:06:34.50,CharCard,,0000,0000,0004,,\N{\fad(300,300)}(فوجي تاكاكو (29\Nموظّفة في شركة هيدا المالية
Dialogue: 0,0:06:31.89,0:06:35.77,On Top,,0000,0000,0000,,!كنتُ أستمتع مع أصدقائي في الكاراوكي
Dialogue: 0,0:06:36.08,0:06:38.42,CharCard,,0000,0000,0004,,\N{\fad(300,0)}(إينو هيروشي (31\Nموظّف في شركة هيدا المالية
Dialogue: 0,0:06:36.08,0:06:38.53,On Top,,0000,0000,0000,,ما الذي حدث؟
Dialogue: 0,0:06:39.96,0:06:43.45,Default,,0000,0000,0000,,!قتل أحدهم رئيسكم
Dialogue: 0,0:06:45.46,0:06:48.85,Default,,0000,0000,0000,,نال هذا الفاسد جزاءه أخيراً إذاً؟
Dialogue: 0,0:06:50.12,0:06:51.70,Default,,0000,0000,0000,,...أأنت
Dialogue: 0,0:06:53.77,0:06:55.65,Default,,0000,0000,0000,,هناك مالٌ كثير مترامٍ
Dialogue: 0,0:06:57.74,0:07:00.69,Default,,0000,0000,0000,,يقضم أظافره؟ أهي عادة له؟
Dialogue: 0,0:07:00.69,0:07:01.74,Default,,0000,0000,0000,,عادة؟
Dialogue: 0,0:07:01.98,0:07:04.90,Default,,0000,0000,0000,,أخبرني، أكان لدى مديركم أيّ عادات؟
Dialogue: 0,0:07:04.90,0:07:05.85,Default,,0000,0000,0000,,عادات؟
Dialogue: 0,0:07:05.85,0:07:08.66,Default,,0000,0000,0000,,...عند عدّه للمال مثلاً
Dialogue: 0,0:07:08.97,0:07:13.34,Default,,0000,0000,0000,,صحيح، كان ينشر الأوراق كمروحة دوماً
Dialogue: 0,0:07:13.34,0:07:15.60,Default,,0000,0000,0000,,ثمّ يلعق إبهامه الأيمن هكذا
Dialogue: 0,0:07:18.46,0:07:21.10,Default,,0000,0000,0000,,!من أعطاه هذه الأوراق؟
Dialogue: 0,0:07:21.31,0:07:22.66,Default,,0000,0000,0000,,أنا
Dialogue: 0,0:07:23.99,0:07:25.74,Default,,0000,0000,0000,,الأمر بسيط إذاً
Dialogue: 0,0:07:26.33,0:07:28.70,Default,,0000,0000,0000,,!القاتل كان أنت يا إينو-سان
Dialogue: 0,0:07:29.24,0:07:32.60,Default,,0000,0000,0000,,!وضعت السمّ على الأوراق سلفاً
Dialogue: 0,0:07:32.60,0:07:33.44,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:07:34.33,0:07:36.13,Default,,0000,0000,0000,,إذاً؟
Dialogue: 0,0:07:36.13,0:07:40.57,Default,,0000,0000,0000,,كما قال المتحرّي موري، وجدنا سمّاً\Nعلى إبهام الضحيّة الأيمن
Dialogue: 0,0:07:40.57,0:07:42.17,Default,,0000,0000,0000,,ومجموعة من الأوراق
Dialogue: 0,0:07:42.17,0:07:44.38,Default,,0000,0000,0000,,!كما قلت
Dialogue: 0,0:07:44.38,0:07:49.31,Default,,0000,0000,0000,,لكن كان السمّ على الأوراق بشكل إبهامه
Dialogue: 0,0:07:49.31,0:07:52.34,Default,,0000,0000,0000,,فانتقل لها عبره غالباً
Dialogue: 0,0:07:53.27,0:07:54.92,Default,,0000,0000,0000,,أأنت متأكد من ذلك؟
Dialogue: 0,0:07:54.92,0:07:56.05,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:58.12,0:07:59.76,Default,,0000,0000,0000,,...قهوة
Dialogue: 0,0:07:59.76,0:08:03.55,Default,,0000,0000,0000,,إنّها القهوة التي قدّمتُها له\Nقبل انصرافي الليلة
Dialogue: 0,0:08:03.93,0:08:05.72,Default,,0000,0000,0000,,!أنتِ القاتلة إذاً
Dialogue: 0,0:08:05.72,0:08:08.75,Default,,0000,0000,0000,,!وضعتِ السم على حاملة الكأس غالباً
Dialogue: 0,0:08:08.75,0:08:13.34,Default,,0000,0000,0000,,كلا، لم نجد سمّاً على الكأس\Nأو في القهوة
Dialogue: 0,0:08:13.34,0:08:14.71,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:08:15.17,0:08:20.37,Default,,0000,0000,0000,,وجدنا السمّ على إبهام الضحيّة الأيمن\Nومجموعة من الأوراق
Dialogue: 0,0:08:20.37,0:08:21.67,Default,,0000,0000,0000,,ومكانين آخرين فحسب
Dialogue: 0,0:08:22.16,0:08:27.16,Default,,0000,0000,0000,,المقبض الداخليّ لباب الغرفة، ومفتاح القفل فوقه
Dialogue: 0,0:08:27.16,0:08:28.33,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:08:28.33,0:08:32.82,Default,,0000,0000,0000,,لكن مثل الأوراق، كان السمّ بشكل إبهامه
Dialogue: 0,0:08:32.82,0:08:35.80,Default,,0000,0000,0000,,فيبدو أنّه لمسهما بإبهامه الحامل للسمّ
Dialogue: 0,0:08:36.15,0:08:40.20,Default,,0000,0000,0000,,بالمناسبة، قال أنّ الضحيّة\Nكان مرتبكاً على الهاتف
Dialogue: 0,0:08:40.97,0:08:45.80,Default,,0000,0000,0000,,...أيمكن أنّه غادر الغرفة أثناء عدّه للمال
Dialogue: 0,0:08:45.80,0:08:50.38,Default,,0000,0000,0000,,لمس شيئاً يحمل السمّ ثم رجع لهذه الغرفة
Dialogue: 0,0:08:50.38,0:08:52.30,Default,,0000,0000,0000,,وأقفل الباب؟
Dialogue: 0,0:08:52.96,0:08:56.71,Default,,0000,0000,0000,,لكن كيف دفعه الفاعل للمس ذاك الشيء؟
Dialogue: 0,0:08:56.71,0:09:00.54,Default,,0000,0000,0000,,آمل أنّكم لم تلمسوا شيئاً\Nبعد وصولكم هنا
Dialogue: 0,0:09:00.54,0:09:04.46,Default,,0000,0000,0000,,كلّ ما لمستُه هو هاتفي الخلويّ هذا
Dialogue: 0,0:09:05.04,0:09:07.57,Default,,0000,0000,0000,,هلّا أبقيته معنا؟
Dialogue: 0,0:09:07.57,0:09:08.28,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:09:09.86,0:09:11.84,Default,,0000,0000,0000,,ماذا؟ أين تلك المرأة؟
Dialogue: 0,0:09:11.84,0:09:13.57,Default,,0000,0000,0000,,أنا هنا
Dialogue: 0,0:09:15.11,0:09:17.92,Default,,0000,0000,0000,,!أنت! ما الذي تفعلينه؟
Dialogue: 0,0:09:18.77,0:09:21.29,Default,,0000,0000,0000,,ألا ترى؟ أعدّ شاياً
Dialogue: 0,0:09:21.60,0:09:24.51,Default,,0000,0000,0000,,!حمقاء! لا تلمسي شيئاً
Dialogue: 0,0:09:24.51,0:09:26.20,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:09:28.30,0:09:32.20,Default,,0000,0000,0000,,!لم تلمسي شيئاً آخر بعد وصولك هنا، صحيح؟
Dialogue: 0,0:09:32.42,0:09:35.17,Default,,0000,0000,0000,,استعملتُ الحمّام عندما أتيت
Dialogue: 0,0:09:35.17,0:09:38.36,Default,,0000,0000,0000,,وأنا استعملتُه بعدها
Dialogue: 0,0:09:38.70,0:09:40.13,Default,,0000,0000,0000,,أيّ شيء آخر؟
Dialogue: 0,0:09:40.66,0:09:43.09,Default,,0000,0000,0000,,استعملتُ الحاسوب قليلاً
Dialogue: 0,0:09:45.08,0:09:47.79,Default,,0000,0000,0000,,!أنت! لا تسقطي رماداً في مسرح جريمة
Dialogue: 0,0:09:55.11,0:09:57.73,Default,,0000,0000,0000,,راضٍ الآن حضرة المتحرّي؟
Dialogue: 0,0:10:00.50,0:10:02.06,Default,,0000,0000,0000,,...تبّاً لك
Dialogue: 0,0:10:02.06,0:10:03.09,Default,,0000,0000,0000,,هوّن عليك
Dialogue: 0,0:10:08.01,0:10:10.00,Default,,0000,0000,0000,,ماذا؟ أهناك خطبٌ ما؟
Dialogue: 0,0:10:10.34,0:10:14.46,Default,,0000,0000,0000,,!أنتم مشتبه بكم! لا تتجوّلوا من تلقاء أنفسكم هكذا
Dialogue: 0,0:10:20.84,0:10:22.50,Default,,0000,0000,0000,,...ضغطتُ مفتاح التشغيل
Dialogue: 0,0:10:23.71,0:10:26.17,Default,,0000,0000,0000,,أيمكنني إطفاؤه بلا مشاكل برأيك؟
Dialogue: 0,0:10:26.17,0:10:27.12,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:10:27.57,0:10:29.33,Default,,0000,0000,0000,,!لا-لا تلمسه
Dialogue: 0,0:10:29.61,0:10:32.80,Default,,0000,0000,0000,,سأطفئه بنفسي! لا تلمسوا شيئاً رجاءً
Dialogue: 0,0:10:33.20,0:10:37.75,Default,,0000,0000,0000,,صحيح، بضغطة لمفتاح قد تظهر\Nبياناتك التي تخفيها
Dialogue: 0,0:10:38.85,0:10:42.71,Default,,0000,0000,0000,,بيانات اختلاسك أموال الشركة
Dialogue: 0,0:10:43.06,0:10:44.12,Default,,0000,0000,0000,,اختلاس؟
Dialogue: 0,0:10:44.12,0:10:46.23,Default,,0000,0000,0000,,!لـ-لا! لم أفعل شيئاً
Dialogue: 0,0:10:46.23,0:10:49.68,Default,,0000,0000,0000,,!أيمكن أنّك قتلت الرئيس لأنّه كشفك؟
Dialogue: 0,0:10:49.68,0:10:50.92,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:10:51.38,0:10:55.76,Default,,0000,0000,0000,,أردت قتله بدورك، صحيح يا ميناميساوا-سان؟
Dialogue: 0,0:10:56.67,0:10:59.92,Default,,0000,0000,0000,,كنت منكباً على وجهك بعدما لامك
Dialogue: 0,0:10:59.92,0:11:03.21,Default,,0000,0000,0000,,على هروب عميل عليه ديون كبيرة، وألقاها عليك
Dialogue: 0,0:11:04.83,0:11:10.29,Default,,0000,0000,0000,,!كنتِ تتمنين موته دوماً بدورك
Dialogue: 0,0:11:10.29,0:11:12.16,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:11:12.16,0:11:16.26,Default,,0000,0000,0000,,لكن إذا لم يكن المُقترض سيستطيع\Nردّ الدين، فعليه ألّا يقترض من البداية
Dialogue: 0,0:11:17.69,0:11:21.17,Default,,0000,0000,0000,,لم تجدوا سمّاً في أيّ مكان في المكتب؟
Dialogue: 0,0:11:21.65,0:11:23.93,Default,,0000,0000,0000,,ولا في الحمّام أو غرفة الاستراحة؟
Dialogue: 0,0:11:23.93,0:11:24.63,Default,,0000,0000,0000,,لا
Dialogue: 0,0:11:24.63,0:11:28.68,Default,,0000,0000,0000,,لمس الضحيّة سيانيد البوتاسيوم
Dialogue: 0,0:11:28.68,0:11:31.54,Default,,0000,0000,0000,,لا يمكن مسحه بلا أيّة آثار في وقت وجيز
Dialogue: 0,0:11:32.01,0:11:36.91,Default,,0000,0000,0000,,ما يعني أنّه بحوزة أحدكم الثلاثة
Dialogue: 0,0:11:37.21,0:11:40.48,Default,,0000,0000,0000,,سنطلب منكم تفريغ جيوبكم إذاً
Dialogue: 0,0:11:41.21,0:11:42.88,Default,,0000,0000,0000,,أنت أوّلاً يا ميناميساوا-سان
Dialogue: 0,0:11:43.17,0:11:43.96,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:11:43.96,0:11:48.79,Default,,0000,0000,0000,,محفظة وساعة يد ومفتاح منزل\Nومذكّرة وتذكرة قطار ومحرمة
Dialogue: 0,0:11:50.20,0:11:52.72,Default,,0000,0000,0000,,المحرمة رطبة بعض الشيء
Dialogue: 0,0:11:52.72,0:11:55.07,Default,,0000,0000,0000,,لأنّي ذهبت للحمّام قبل قليل
Dialogue: 0,0:11:55.07,0:11:56.26,Default,,0000,0000,0000,,أنتِ التالية يا فوجي-سان
Dialogue: 0,0:11:56.77,0:11:59.71,Default,,0000,0000,0000,,ماذا؟ محرمتك رطبة أيضاً
Dialogue: 0,0:12:00.11,0:12:03.44,Default,,0000,0000,0000,,بالطبع، فقد ذهبتُ للحمّام بدوري
Dialogue: 0,0:12:03.44,0:12:04.87,Default,,0000,0000,0000,,التالي، إينو-سان
Dialogue: 0,0:12:04.87,0:12:05.67,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:12:06.23,0:12:08.58,Default,,0000,0000,0000,,محرمة مبللة أخرى
Dialogue: 0,0:12:09.43,0:12:12.63,Default,,0000,0000,0000,,ماذا؟ لكنّ خاصتك بغاية البلل
Dialogue: 0,0:12:12.63,0:12:14.63,Default,,0000,0000,0000,,أنا أتعرّق كثيراً بطبيعتي
Dialogue: 0,0:12:17.92,0:12:21.25,Default,,0000,0000,0000,,!لم تظهر آثار على أيّ من أغراضهم؟
Dialogue: 0,0:12:21.63,0:12:25.17,Default,,0000,0000,0000,,كلا، لم نجد أيّ سم
Dialogue: 0,0:12:26.04,0:12:29.41,Default,,0000,0000,0000,,سـ-سأسترجع أغراضي إذاً
Dialogue: 0,0:12:29.41,0:12:31.17,Default,,0000,0000,0000,,لا تمانعون، صحيح؟
Dialogue: 0,0:12:31.17,0:12:32.84,Default,,0000,0000,0000,,...كلا
Dialogue: 0,0:12:33.41,0:12:35.89,Default,,0000,0000,0000,,كونان-كن، لنرجع نحن
Dialogue: 0,0:12:36.83,0:12:38.36,Default,,0000,0000,0000,,...انتظري، لا أزال
Dialogue: 0,0:12:39.65,0:12:43.01,Default,,0000,0000,0000,,...ماذا؟ ذاك الشخص على وضعه هذا منذ فترة
Dialogue: 0,0:12:43.57,0:12:45.26,Default,,0000,0000,0000,,لحظة، أيمكن؟
Dialogue: 0,0:12:45.48,0:12:46.79,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:12:47.35,0:12:49.10,Default,,0000,0000,0000,,!سيّدي المُحلّل
Dialogue: 0,0:12:49.10,0:12:52.68,Default,,0000,0000,0000,,قلت أنّكم تفقدتم كلّ الأماكن\Nالتي قد يلمسها الضحيّة، صحيح؟
Dialogue: 0,0:12:52.68,0:12:53.25,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:53.51,0:12:54.95,Default,,0000,0000,0000,,هل تفقدتم البصمات أيضاً؟
Dialogue: 0,0:12:54.95,0:12:56.10,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:12:56.10,0:12:58.38,Default,,0000,0000,0000,,...إذاً، هل
Dialogue: 0,0:12:59.92,0:13:02.67,Default,,0000,0000,0000,,نعم، ظننتُ الأمر غريباً بدوري
Dialogue: 0,0:13:03.42,0:13:04.59,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:13:05.84,0:13:07.58,Default,,0000,0000,0000,,يكفي
Dialogue: 0,0:13:07.91,0:13:10.68,Default,,0000,0000,0000,,سيغضبون إذا عبثت في مكان كهذا
Dialogue: 0,0:13:11.58,0:13:13.46,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:13:13.83,0:13:15.92,Default,,0000,0000,0000,,!وجدته! مُبيّض
Dialogue: 0,0:13:16.36,0:13:20.38,Default,,0000,0000,0000,,!الانسكاب من الغطاء حديث، استعمل القاتل هذا
Dialogue: 0,0:13:20.98,0:13:22.50,Default,,0000,0000,0000,,تصرّفات ذاك الشخص
Dialogue: 0,0:13:22.86,0:13:24.36,Default,,0000,0000,0000,,والبصمات الغريبة
Dialogue: 0,0:13:24.36,0:13:26.35,Default,,0000,0000,0000,,كما توقيت دخوله الحمّام
Dialogue: 0,0:13:27.64,0:13:33.42,Default,,0000,0000,0000,,تلاعب بالضحيّة في المكتب الذي\Nلم يكن فيه أحد سواه وسمّمه
Dialogue: 0,0:13:33.42,0:13:35.84,Default,,0000,0000,0000,,كما لو كان سحراً
Dialogue: 0,0:13:41.63,0:13:42.42,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:13:43.34,0:13:45.71,Default,,0000,0000,0000,,تعبث في المكان مُجدداً؟
Dialogue: 0,0:13:45.71,0:13:47.40,Default,,0000,0000,0000,,!ران! خذيه للبيت سريعاً
Dialogue: 0,0:13:47.41,0:13:48.65,Default,,0000,0000,0000,,لا خيار بيدي
Dialogue: 0,0:13:52.58,0:13:53.55,Default,,0000,0000,0000,,أبي؟
Dialogue: 0,0:13:54.58,0:13:56.50,Default,,0000,0000,0000,,صدقاً يا موري-كن؟
Dialogue: 0,0:13:56.78,0:13:58.92,Default,,0000,0000,0000,,اكتشفت هويّة القاتل؟
Dialogue: 0,0:13:58.92,0:14:02.42,Default,,0000,0000,0000,,نعم، كان هدف القاتل هو جريمة\Nفي غرفة مقفلة
Dialogue: 0,0:14:02.42,0:14:06.87,Default,,0000,0000,0000,,ران، ارجعي لمكتبي واجلبي اليود\Nمن عدّة الإسعافات الأوليّة
Dialogue: 0,0:14:07.18,0:14:08.39,Default,,0000,0000,0000,,أأنت مُصاب؟
Dialogue: 0,0:14:08.39,0:14:12.80,Default,,0000,0000,0000,,ستظهر هويّة القاتل حالما نستعمله
Dialogue: 0,0:14:13.18,0:14:14.67,Default,,0000,0000,0000,,فهمت، سأجلبه فوراً
Dialogue: 0,0:14:17.38,0:14:22.92,Default,,0000,0000,0000,,دفع القاتل الضحيّة للخروج من هذه\Nالغرفة بينما كان يعدّ النقود
Dialogue: 0,0:14:22.92,0:14:25.47,Default,,0000,0000,0000,,وجعله يلمس شيئاً بسطحه السمّ
Dialogue: 0,0:14:25.47,0:14:30.39,Default,,0000,0000,0000,,فتسمّم الضحيّة بعدما رجع للغرفة وأقفلها
Dialogue: 0,0:14:30.96,0:14:35.66,Default,,0000,0000,0000,,كان من عادة الضحيّة لعق إبهامه الأيمن
Dialogue: 0,0:14:35.66,0:14:37.83,Default,,0000,0000,0000,,قبل العدّ، فاستغلّ القاتل ذلك
Dialogue: 0,0:14:38.28,0:14:42.78,Default,,0000,0000,0000,,...ما يعني أنّ القاتل أحدكم الثلاثة الذين
Dialogue: 0,0:14:42.78,0:14:46.63,Default,,0000,0000,0000,,كانوا يعرفون عادته وما سيفعله الليلة
Dialogue: 0,0:14:47.44,0:14:52.56,Default,,0000,0000,0000,,انتظر! لم يجدوا سمّاً في أيّ مكان\N!خارج هذه الغرفة
Dialogue: 0,0:14:52.56,0:14:55.96,Default,,0000,0000,0000,,كما كيف جعله القاتل يلمسه؟
Dialogue: 0,0:14:55.96,0:15:01.92,Default,,0000,0000,0000,,يوجد شيءٌ سيدفع 10 أشخاص \Nمن أصل 10 لفعل الأمر نفسه
Dialogue: 0,0:15:03.51,0:15:05.52,Default,,0000,0000,0000,,!فهمت! الهاتف
Dialogue: 0,0:15:06.54,0:15:09.37,Default,,0000,0000,0000,,!سيستجيب أيّ أحد لرنين هاتف
Dialogue: 0,0:15:10.04,0:15:11.12,Default,,0000,0000,0000,,ميناميساوا-سان
Dialogue: 0,0:15:11.12,0:15:16.63,Default,,0000,0000,0000,,اتّصلت به من الخارج\N!كي تجعله يلمس الهاتف المسموم
Dialogue: 0,0:15:17.32,0:15:18.66,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:15:19.74,0:15:23.41,Default,,0000,0000,0000,,من عادة ميناميساوا-سان قضم أظافره
Dialogue: 0,0:15:23.41,0:15:29.50,Default,,0000,0000,0000,,،لكنّه عندما أتى لاسترجاع هاتفه\Nحمله بيديه العاريتين
Dialogue: 0,0:15:29.50,0:15:34.77,Default,,0000,0000,0000,,لو كان السمّ على الهاتف، لخشي فعل ذلك
Dialogue: 0,0:15:34.77,0:15:37.96,Default,,0000,0000,0000,,بما أنّه لن يعرف أين لمسه الرئيس بالضبط
Dialogue: 0,0:15:37.96,0:15:39.63,Default,,0000,0000,0000,,!الحاسوب إذاً
Dialogue: 0,0:15:40.26,0:15:46.21,Default,,0000,0000,0000,,إينو-سان! جعلته يقوم بتشغيله\Nكي يتحقق من بيانات ما، أليس كذلك؟
Dialogue: 0,0:15:46.21,0:15:47.33,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:15:47.63,0:15:49.38,Default,,0000,0000,0000,,ذلك ليس صحيحاً أيضاً
Dialogue: 0,0:15:49.38,0:15:52.80,Default,,0000,0000,0000,,لا ضمان لأن يشغّله الرئيس بإبهامه
Dialogue: 0,0:15:53.42,0:15:55.71,Default,,0000,0000,0000,,ما الذي وضع القاتل\Nالسمّ عليه إذاً؟
Dialogue: 0,0:15:55.71,0:16:00.62,Default,,0000,0000,0000,,توجد طريقة لجعله يلمس شيئاً بإبهامه الأيمن
Dialogue: 0,0:16:00.62,0:16:02.71,Default,,0000,0000,0000,,سواءً رغب بذلك أم لا
Dialogue: 0,0:16:04.87,0:16:07.15,Default,,0000,0000,0000,,ها هو الصوت
Dialogue: 0,0:16:07.15,0:16:12.21,Default,,0000,0000,0000,,نداء الشيطان الذي استعمله القاتل\N!ليقود الرئيس لموته
Dialogue: 0,0:16:16.80,0:16:17.98,Default,,0000,0000,0000,,!ما الذي يجري؟
Dialogue: 0,0:16:18.23,0:16:19.75,Default,,0000,0000,0000,,!إبريق الشاي يغلي
Dialogue: 0,0:16:22.68,0:16:23.94,Default,,0000,0000,0000,,إبريق الشاي؟
Dialogue: 0,0:16:27.67,0:16:29.00,Default,,0000,0000,0000,,!فهمت! هذا
Dialogue: 0,0:16:30.46,0:16:33.92,Default,,0000,0000,0000,,!وضع القاتل السمّ على مفتاح الموقد هذا
Dialogue: 0,0:16:34.42,0:16:36.06,Default,,0000,0000,0000,,!هذا ما حصل، صحيح يا موري-كن؟
Dialogue: 0,0:16:36.06,0:16:36.87,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:37.12,0:16:40.83,Default,,0000,0000,0000,,مواقد الغاز في السوق تُصنع\Nلمستعملي الأيدي اليُمنى غالباً
Dialogue: 0,0:16:40.83,0:16:47.75,Default,,0000,0000,0000,,وضع السمّ على جانب المقبض الأيسر\Nسيضمن أن يلمسه الإبهام الأيمن
Dialogue: 0,0:16:50.23,0:16:55.23,Default,,0000,0000,0000,,ودليل على ذلك، يوجد سمّ على المقبض\Nالداخلي فقط من باب هذه الغرفة
Dialogue: 0,0:16:56.31,0:17:02.32,Default,,0000,0000,0000,,ما يعني أنّه خرج دون إغلاق الباب\Nولمس السم في هلعه
Dialogue: 0,0:17:03.35,0:17:06.79,Default,,0000,0000,0000,,ثم أقفل الباب بعدما رجع
Dialogue: 0,0:17:06.79,0:17:12.00,Default,,0000,0000,0000,,من كان القاتل الذي نصب هذه الحيلة\N!وسمّم الرئيس إذاً؟
Dialogue: 0,0:17:12.46,0:17:15.46,Default,,0000,0000,0000,,...الوحيد الذي اقترب من الموقد لاحقاً
Dialogue: 0,0:17:15.46,0:17:18.18,Default,,0000,0000,0000,,!أنت يا فوجي تاكاكو-سان
Dialogue: 0,0:17:18.92,0:17:24.74,Default,,0000,0000,0000,,أجل، أشعلتِ النار تحت إبريق الشاي قبيل مغادرتك
Dialogue: 0,0:17:24.74,0:17:29.64,Default,,0000,0000,0000,,كي يصدر صوت الصفير\Nبينما يعدّ الرئيس المال
Dialogue: 0,0:17:30.38,0:17:34.94,Default,,0000,0000,0000,,كنتِ تنوين مسح السم غداً
Dialogue: 0,0:17:34.94,0:17:39.29,Default,,0000,0000,0000,,لكن عُثر على الجثّة أبكر\Nمما توقعتِ وأتت الشرطة
Dialogue: 0,0:17:40.10,0:17:45.56,Default,,0000,0000,0000,,خشيتِ أن يُكتشف السمّ\Nعلى مفتاح الموقد هكذا
Dialogue: 0,0:17:45.56,0:17:49.42,Default,,0000,0000,0000,,فدخلتِ غرفة الاستراحة\Nومسحتِ السمّ بمحرمتك
Dialogue: 0,0:17:50.30,0:17:56.36,Default,,0000,0000,0000,,كيف ذلك؟ ألم تقولوا بأنفسكم\Nأنّ المسح في وقت وجيز غير ممكن؟
Dialogue: 0,0:17:56.75,0:18:01.00,Default,,0000,0000,0000,,غير ممكن بالفعل، بافتراض أنّك \Nاستعملتِ محرمة عاديّة
Dialogue: 0,0:18:02.58,0:18:05.17,Default,,0000,0000,0000,,أبي! أحضرتُ اليود
Dialogue: 0,0:18:05.17,0:18:06.62,Default,,0000,0000,0000,,اليود؟
Dialogue: 0,0:18:06.62,0:18:12.82,Default,,0000,0000,0000,,إذاً حضرة المفتّش، هلا سكبت بعض اليود\Nعلى محرمتها الرطبة؟
Dialogue: 0,0:18:12.82,0:18:16.83,Default,,0000,0000,0000,,قطرة واحدة ستُنبت لنا الحقيقة
Dialogue: 0,0:18:23.06,0:18:26.23,Default,,0000,0000,0000,,...سيترك هذا بقعةً بنيّة فحسب
Dialogue: 0,0:18:32.05,0:18:33.55,Default,,0000,0000,0000,,!اختفى اللون
Dialogue: 0,0:18:33.88,0:18:39.15,Default,,0000,0000,0000,,أجل، ما بلّل محرمتها لم يكن\Nماءً ولا عرقاً
Dialogue: 0,0:18:39.96,0:18:42.00,Default,,0000,0000,0000,,بل ثيوكبريت الصوديوم
Dialogue: 0,0:18:42.21,0:18:44.21,Default,,0000,0000,0000,,ثيوكبريت الصوديوم؟
Dialogue: 0,0:18:44.21,0:18:48.96,Default,,0000,0000,0000,,مُبيّض يُستعمل لإزالة بقع الألوان مثل اليود
Dialogue: 0,0:18:49.40,0:18:54.67,Default,,0000,0000,0000,,كما ينفع مضاداً يقاوم تأثير كلوريد البوتاسيوم
Dialogue: 0,0:18:55.15,0:18:57.52,Default,,0000,0000,0000,,لا يزال في خزانة دورة المياه
Dialogue: 0,0:18:57.52,0:19:02.81,Default,,0000,0000,0000,,مُبيّض بمادة كيميائية خاصة\Nتجعله فعّالاً حتى في درجة حرارة الغرفة
Dialogue: 0,0:19:03.02,0:19:04.34,Default,,0000,0000,0000,,!تاكاغي-كن! تفقّد فوراً
Dialogue: 0,0:19:04.34,0:19:05.20,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:19:06.68,0:19:11.59,Default,,0000,0000,0000,,دخلت فوجي-سان دورة المياه فورما\Nأتت بعدما سمعت بوصول الشرطة
Dialogue: 0,0:19:11.59,0:19:15.26,Default,,0000,0000,0000,,وبلّلت محرمتها بالمُبيّض
Dialogue: 0,0:19:19.83,0:19:22.96,Default,,0000,0000,0000,,لم يخطر لي أن أنكشف بهذه السرعة
Dialogue: 0,0:19:23.33,0:19:24.67,Default,,0000,0000,0000,,!فوجي-سان؟
Dialogue: 0,0:19:24.67,0:19:26.16,Default,,0000,0000,0000,,كنتِ الفاعلة حقّاً؟
Dialogue: 0,0:19:26.66,0:19:29.02,Default,,0000,0000,0000,,نعم، قتلتُه
Dialogue: 0,0:19:29.81,0:19:32.13,Default,,0000,0000,0000,,شيطان المال الماكر ذاك
Dialogue: 0,0:19:32.13,0:19:34.16,Default,,0000,0000,0000,,لـ-لكن، لمَ؟
Dialogue: 0,0:19:35.16,0:19:38.88,Default,,0000,0000,0000,,الدافع بسيط، اقترض حبيبي مالاً منه
Dialogue: 0,0:19:38.89,0:19:41.27,Default,,0000,0000,0000,,ولم يستطع ردّه، فشنق نفسه
Dialogue: 0,0:19:41.27,0:19:42.84,Default,,0000,0000,0000,,بتلك البساطة
Dialogue: 0,0:19:43.25,0:19:47.29,Default,,0000,0000,0000,,لكنّك كنتِ تقولين دوماً\N!أنّ اللوم على المُقترض
Dialogue: 0,0:19:47.78,0:19:50.51,Default,,0000,0000,0000,,نعم، لم أكن لأقدم على الانتقام
Dialogue: 0,0:19:50.51,0:19:55.84,Default,,0000,0000,0000,,لو استعار المال لشراء سيّارة\Nأو منزل أو للقمار
Dialogue: 0,0:19:55.84,0:19:58.71,Default,,0000,0000,0000,,لكنّه فعل ذلك لأجلي، فلم يكن بيدي خيار
Dialogue: 0,0:19:58.92,0:20:00.50,Default,,0000,0000,0000,,لأجلك؟
Dialogue: 0,0:20:00.50,0:20:03.50,Default,,0000,0000,0000,,لطالما عانيتُ من قلبٍ ضعيف
Dialogue: 0,0:20:03.50,0:20:06.66,Default,,0000,0000,0000,,فبقيتُ في المشفى بعد تخرّجي من الجامعة لثلاثة أعوام
Dialogue: 0,0:20:07.12,0:20:11.20,Default,,0000,0000,0000,,مات والديّ باكراً ولم يكن لديّ أصدقاء بسبب شخصيّتي
Dialogue: 0,0:20:11.20,0:20:12.96,Default,,0000,0000,0000,,فكان هو زائري الوحيد
Dialogue: 0,0:20:13.91,0:20:16.62,Default,,0000,0000,0000,,قال أنّه سيتكفل بفواتير المشفى\Nبشكلٍ ما، ويطلب منّي الصمود
Dialogue: 0,0:20:17.77,0:20:20.61,Default,,0000,0000,0000,,...بعدما تحسّنتُ أخيراً وذهبتُ لشقّته
Dialogue: 0,0:20:20.61,0:20:26.04,Default,,0000,0000,0000,,وجدتُه قد انتحر وورقة اقتراض\Nعند قدميه باسم شركة هيدا المالية
Dialogue: 0,0:20:26.35,0:20:29.26,Default,,0000,0000,0000,,التحقتِ بالشركة للانتقام إذاً؟
Dialogue: 0,0:20:29.26,0:20:32.00,Default,,0000,0000,0000,,نعم، كنتُ أنتظر فرصتي طوال الوقت
Dialogue: 0,0:20:32.80,0:20:36.46,Default,,0000,0000,0000,,لكن حضرة المتحرّي، كيف عرفت أنّي الفاعلة؟
Dialogue: 0,0:20:36.88,0:20:43.34,Default,,0000,0000,0000,,لإبقائك المستمرّ ليدك اليسرى\Nداخل معطفك يا فوجي-سان
Dialogue: 0,0:20:43.67,0:20:48.99,Default,,0000,0000,0000,,كنتِ تستعملين يدك اليمنى لإخراج \Nالسجائر واستعمال القدّاحة
Dialogue: 0,0:20:48.99,0:20:53.20,Default,,0000,0000,0000,,استعملتِ يدك اليسرى مرّةً فحسب\Nعندما أدرتِ مفتاح الموقد
Dialogue: 0,0:20:53.20,0:20:58.11,Default,,0000,0000,0000,,أنتِ مُدّخنة شرهة، تمسّين شفتيك عندما تدخنين
Dialogue: 0,0:20:58.11,0:21:02.34,Default,,0000,0000,0000,,تعمدتِ إدارة المقبض بيدك اليسرى\Nلخشيتك من انتقال السم
Dialogue: 0,0:21:03.74,0:21:07.39,Default,,0000,0000,0000,,أبقيتِ يدك اليسرى في جيب معطفك
Dialogue: 0,0:21:07.39,0:21:12.42,Default,,0000,0000,0000,,كيلا تنقلي السمّ الذي يُحتمل\Nأنّه وصلها لأيّ شيء بالطبع
Dialogue: 0,0:21:13.73,0:21:16.66,Default,,0000,0000,0000,,...التدخين الذي منعني عنه قادني لهلاكي
Dialogue: 0,0:21:17.80,0:21:20.04,Default,,0000,0000,0000,,لا بدّ أنّه يضحك في العالم الآخر
Dialogue: 0,0:22:49.65,0:22:52.07,On Top,,0000,0000,0000,,مركز ألغاب\Nبيكر
Dialogue: 0,0:22:50.77,0:22:52.07,Default,,0000,0000,0000,,!كوغورو-تشان
Dialogue: 0,0:22:52.65,0:22:55.76,Default,,0000,0000,0000,,من النادر أن تأتي لمتجري
Dialogue: 0,0:22:55.76,0:22:57.51,Default,,0000,0000,0000,,ليس بيدي حيلة
Dialogue: 0,0:22:57.51,0:23:02.03,Default,,0000,0000,0000,,فلا أحد يريد لعب الماجونغ معي\Nلأنّ ذلك يذكرهم بالقضيّة
Dialogue: 0,0:23:02.30,0:23:05.75,Default,,0000,0000,0000,,لذا جلبت معك صبيّاً للعب ماجونغ التعرّي؟
Dialogue: 0,0:23:05.75,0:23:07.48,Default,,0000,0000,0000,,!أجل! ممتاز
Dialogue: 0,0:23:07.75,0:23:10.88,Default,,0000,0000,0000,,!"حسناً، ارم "تشي سو كي" هنا وتحصل على "داما تين
Dialogue: 0,0:23:10.88,0:23:13.53,Default,,0000,0000,0000,,!"أحمق! انتظر الـ "شا كي
Dialogue: 0,0:23:14.08,0:23:15.15,Default,,0000,0000,0000,,ما الذي تفعلانه؟
Dialogue: 0,0:23:16.49,0:23:18.24,Default,,0000,0000,0000,,...نحن، هذا
Dialogue: 0,0:23:18.24,0:23:22.99,Default,,0000,0000,0000,,عليك التخلّص من "با سو" واستعمال\N!"دورا أوسو ماتشي" لتحصل على "سوكو ري"
Dialogue: 0,0:23:24.87,0:23:26.06,Default,,0000,0000,0000,,(ريتشي! (قطعة باقية للفوز
Dialogue: 0,0:23:26.81,0:23:28.19,Default,,0000,0000,0000,,!بادلني
Dialogue: 0,0:23:28.19,0:23:30.02,Default,,0000,0000,0000,,!حسنٌ، تعالي
Dialogue: 0,0:23:30.05,0:23:33.49,Default,,0000,0000,0000,,"لا يمكن أن تأتي، فلديك "آن كو
Dialogue: 0,0:23:30.05,0:23:33.49,Default,,0000,0000,0000,,"لا يمكن أن تأتي، فلديك "آن كو
Dialogue: 0,0:23:35.36,0:23:36.68,Default,,0000,0000,0000,,!تسومو
Dialogue: 0,0:23:36.68,0:23:40.35,Default,,0000,0000,0000,,!ريتشي وإيبّاتسو تسومو وهون إيتسو وأربعة دورا
Dialogue: 0,0:23:40.35,0:23:43.27,Default,,0000,0000,0000,,!أورا دورا حتّى! رائع
Dialogue: 0,0:23:43.27,0:23:44.42,Default,,0000,0000,0000,,!سانبايمان
Dialogue: 0,0:23:45.14,0:23:47.46,Default,,0000,0000,0000,,!حسنٌ، الأخيرة
Dialogue: 0,0:23:47.46,0:23:51.01,Default,,0000,0000,0000,,من علّمك الماجونغ يا ران-تشان؟
Dialogue: 0,0:23:51.71,0:23:53.67,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:23:51.71,0:23:53.67,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:24:05.36,0:24:06.26,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:24:07.18,0:24:11.35,Default,,0000,0000,0000,,كايتو 1412 الذي يتلاعب بالشرطة\N...في أرجاء البلاد كالطفل
Dialogue: 0,0:24:11.85,0:24:14.69,Default,,0000,0000,0000,,!يدعوه الناس بكايتو كيد
Dialogue: 0,0:24:15.52,0:24:16.34,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:24:18.51,0:24:19.35,Default,,0000,0000,0000,,!اختفى
Dialogue: 0,0:24:19.67,0:24:23.67,Default,,0000,0000,0000,,!لا-لا يمكن! يستحيل أن يختفي شخص هكذا
Dialogue: 0,0:24:24.06,0:24:30.06,On Top,,0000,0000,0000,,كونان ضدّ كايتو كيد
Dialogue: 0,0:24:24.67,0:24:26.95,Default,,0000,0000,0000,,في حلقة كونان القادمة الخاصّة
Dialogue: 0,0:24:26.95,0:24:29.20,Default,,0000,0000,0000,,كونان ضدّ كايتو كيد
Dialogue: 0,0:24:45.75,0:24:48.64,Default,,0000,0000,0000,,تلميح الحلقة القادمة الخاصّة
Dialogue: 0,0:24:48.64,0:24:49.71,Default,,0000,0000,0000,,لؤلؤة
Dialogue: 0,0:24:50.05,0:24:50.87,Default,,0000,0000,0000,,...الحلقة القادمة
Dialogue: 0,0:24:50.87,0:24:51.95,Default,,0000,0000,0000,,!حلقة خاصّة حضرة المفتّش
Dialogue: 0,0:24:51.95,0:24:53.61,Default,,0000,0000,0000,,لكنّك لن تظهر فيها يا ضابط تاكاغي
Dialogue: 0,0:24:53.61,0:24:54.34,Default,,0000,0000,0000,,ولا أنت يا مفتّش
Dialogue: 0,0:24:54.34,0:24:58.04,Default,,0000,0000,0000,,!ماذا؟

