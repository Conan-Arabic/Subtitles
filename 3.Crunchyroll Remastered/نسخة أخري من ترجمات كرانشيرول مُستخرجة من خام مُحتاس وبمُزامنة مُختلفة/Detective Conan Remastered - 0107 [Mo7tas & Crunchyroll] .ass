Dialogue: 0,0:00:01.25,0:00:04.63,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والقضايا تلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.63,0:00:06.16,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.71,0:00:10.25,Default,,0000,0000,0000,,عنوان اليوم غريبٌ قليلاً! أيمكنكم حلّ\Nاللغز في الجزء الأوّل؟
Dialogue: 0,0:00:10.25,0:00:12.08,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.08,0:00:13.54,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.54,0:00:16.08,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.75,0:00:24.21,On Top,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.21,0:00:31.25,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.97,0:00:39.38,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.38,0:00:46.88,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.88,0:00:59.33,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.21,0:01:06.63,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.59,0:01:13.47,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.47,0:01:19.88,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.88,0:01:26.82,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.27,0:01:57.22,Title,,0000,0000,15,,{\fad(300,0)}قضيّة لغز فضائيّ الخلد\N(الجزء الأوّل)
Dialogue: 0,0:01:52.14,0:01:56.02,Default,,0000,0000,0000,,قضيّة لغز فضائيّ الخلد\N(الجزء الأوّل)
Dialogue: 0,0:02:00.60,0:02:02.48,Default,,0000,0000,0000,,ميتسوهيكو
Dialogue: 0,0:02:02.48,0:02:04.81,Default,,0000,0000,0000,,أتوجد أرضٌ فارغة بالقارب يمكننا أن
Dialogue: 0,0:02:04.81,0:02:06.48,Default,,0000,0000,0000,,نلعب فيها كرة القاعدة حقّاً؟
Dialogue: 0,0:02:06.48,0:02:08.57,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:08.57,0:02:12.49,Default,,0000,0000,0000,,!فلتلعبوا كرة القدم من حينٍ لآخر، كرة القدم
Dialogue: 0,0:02:15.31,0:02:17.08,Default,,0000,0000,0000,,!وصلنا
Dialogue: 0,0:02:17.39,0:02:18.43,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:02:18.43,0:02:19.41,Default,,0000,0000,0000,,وصلنا؟
Dialogue: 0,0:02:20.60,0:02:22.02,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:02:31.64,0:02:34.85,Default,,0000,0000,0000,,!هذا موقع بناء لبناية شقق
Dialogue: 0,0:02:34.85,0:02:40.10,Default,,0000,0000,0000,,صحيح! لكنّهم أوقفوا عمليات البناء\N!قبل نصف شهر
Dialogue: 0,0:02:40.10,0:02:42.40,Default,,0000,0000,0000,,يمكننا لعب كرة القاعدة هنا إذاً؟
Dialogue: 0,0:02:42.40,0:02:43.73,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:43.73,0:02:46.35,Default,,0000,0000,0000,,لا يمكننا الدخول هنا بما\N،أنّ المكان مقفل
Dialogue: 0,0:02:46.35,0:02:49.31,Default,,0000,0000,0000,,!لكنّي وجدت مدخلاً آخر بالأمس
Dialogue: 0,0:02:49.31,0:02:50.36,Default,,0000,0000,0000,,!من هنا
Dialogue: 0,0:02:54.98,0:02:56.23,Default,,0000,0000,0000,,يا إلهي
Dialogue: 0,0:03:02.31,0:03:03.63,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:03:04.63,0:03:06.04,Default,,0000,0000,0000,,!توجد فتحة
Dialogue: 0,0:03:06.31,0:03:08.64,Default,,0000,0000,0000,,!أحطّمتها أنت يا ميتسوهيكو-كن؟
Dialogue: 0,0:03:08.64,0:03:10.31,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:03:10.31,0:03:12.05,Default,,0000,0000,0000,,اصطدمت بها سيّارة
Dialogue: 0,0:03:12.77,0:03:16.51,Default,,0000,0000,0000,,انظروا، يوجد طلاءٌ من سيّارة على السياج
Dialogue: 0,0:03:16.77,0:03:20.18,Default,,0000,0000,0000,,لا بدّ أنّ السيّارة ارتطمت به\Nفنشأت هذه الفتحة
Dialogue: 0,0:03:20.48,0:03:22.52,Default,,0000,0000,0000,,!حسنٌ، لندخل
Dialogue: 0,0:03:22.52,0:03:24.89,Default,,0000,0000,0000,,!سأدخل أنا أوّلاً
Dialogue: 0,0:03:28.56,0:03:30.52,Default,,0000,0000,0000,,!فسيح
Dialogue: 0,0:03:31.98,0:03:34.53,Default,,0000,0000,0000,,!اسحبا بقوّةٍ أكبر
Dialogue: 0,0:03:34.93,0:03:37.52,Default,,0000,0000,0000,,!فلتقم بحمية
Dialogue: 0,0:03:39.68,0:03:43.35,Default,,0000,0000,0000,,حسنٌ، ستكون فتحة الصرف هذه\N!هي القاعدة الرئيسيّة
Dialogue: 0,0:03:43.35,0:03:44.58,Default,,0000,0000,0000,,!أنا حامل المضرب
Dialogue: 0,0:03:44.58,0:03:45.93,Default,,0000,0000,0000,,!وأنا الرامي
Dialogue: 0,0:03:45.93,0:03:47.29,Default,,0000,0000,0000,,!وأنا لاعبة الميدان الداخليّ
Dialogue: 0,0:03:50.54,0:03:53.96,Default,,0000,0000,0000,,فهمت، تريدون منّي أن أكون\Nلاعب الميدان الخارجيّ، صحيح؟
Dialogue: 0,0:03:54.64,0:03:56.93,Default,,0000,0000,0000,,!حسناً، لنبدأ
Dialogue: 0,0:03:56.93,0:03:58.25,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:03:58.25,0:03:59.10,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:03:59.36,0:04:01.85,Default,,0000,0000,0000,,!كونان-كن! صوتك منخفض
Dialogue: 0,0:04:03.29,0:04:04.16,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:04:04.16,0:04:04.77,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:04:05.77,0:04:07.73,Default,,0000,0000,0000,,!ها أنا ذا يا غينتا-كن
Dialogue: 0,0:04:07.73,0:04:09.19,Default,,0000,0000,0000,,!حسناً، تعال
Dialogue: 0,0:04:15.98,0:04:18.07,Default,,0000,0000,0000,,!كونان-كن! إنّها متّجهة نحوك
Dialogue: 0,0:04:18.07,0:04:21.04,Default,,0000,0000,0000,,...سأكون مجرّد جالب كرات هكذا
Dialogue: 0,0:04:26.37,0:04:30.84,Default,,0000,0000,0000,,مع ذلك، هذا اقتحام ودخول\Nغير شرعيّ بكلّ وضوح
Dialogue: 0,0:04:31.93,0:04:34.63,Default,,0000,0000,0000,,...إذا رآنا أحد
Dialogue: 0,0:04:36.43,0:04:37.39,Default,,0000,0000,0000,,ما ذلك؟
Dialogue: 0,0:04:42.81,0:04:46.52,Default,,0000,0000,0000,,!هذا سيّئ! إنّه يراقبنا بمنظار
Dialogue: 0,0:04:48.31,0:04:49.44,Default,,0000,0000,0000,,!أخطأت
Dialogue: 0,0:04:50.73,0:04:53.18,Default,,0000,0000,0000,,...تجاوزت السياج
Dialogue: 0,0:04:56.31,0:04:58.31,Default,,0000,0000,0000,,لا أجد الكرة
Dialogue: 0,0:04:58.31,0:05:01.28,Default,,0000,0000,0000,,أيمكن أنّها تجاوزت ذاك السياج أيضاً؟
Dialogue: 0,0:05:02.23,0:05:04.96,Default,,0000,0000,0000,,ذلك مُحتمل
Dialogue: 0,0:05:05.39,0:05:08.98,Default,,0000,0000,0000,,فلنذهب ونطلب من أهل البيت\Nإعطاءنا الكرة إذاً
Dialogue: 0,0:05:08.98,0:05:12.42,Default,,0000,0000,0000,,...لنفعل ذلك، حسناً
Dialogue: 0,0:05:12.42,0:05:14.26,Default,,0000,0000,0000,,...يبدو أنّ ذلك المدخل الخلفيّ، لذا
Dialogue: 0,0:05:14.26,0:05:17.01,Default,,0000,0000,0000,,أظنّ المدخل الأمامي كان\Nمقابل الشارع الرئيسيّ
Dialogue: 0,0:05:17.01,0:05:21.26,Default,,0000,0000,0000,,لكن ماذا نفعل لو ظهر رجلٌ متصلّب الرأس؟
Dialogue: 0,0:05:21.26,0:05:23.68,Default,,0000,0000,0000,,،لا أدري إذا كان متصلّب الرأس أم لا
Dialogue: 0,0:05:23.68,0:05:26.48,Default,,0000,0000,0000,,لكن كان أحدهم يراقب بمنظار\Nمن نافذة الطابق الثاني
Dialogue: 0,0:05:26.97,0:05:27.84,Default,,0000,0000,0000,,بمنظار؟
Dialogue: 0,0:05:27.84,0:05:31.44,Default,,0000,0000,0000,,!أي أنّ المنزل ليس فارغاً، صحيح؟ لنذهب ونجرّب
Dialogue: 0,0:05:31.44,0:05:32.72,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:05:40.01,0:05:42.59,Default,,0000,0000,0000,,طارت لهذا الفناء غالباً
Dialogue: 0,0:05:42.59,0:05:44.68,Default,,0000,0000,0000,,يبدو كمنزلٍ مسكون
Dialogue: 0,0:05:44.68,0:05:48.58,Default,,0000,0000,0000,,هل سيكون منزلًا مسكونًا\Nمطلّاً على الشارع الرئيسيّ؟
Dialogue: 0,0:05:53.84,0:05:55.72,Default,,0000,0000,0000,,أخبرني يا كونان-كن
Dialogue: 0,0:05:55.72,0:05:57.51,Default,,0000,0000,0000,,كيف تقرأ هذا؟
Dialogue: 0,0:05:58.05,0:06:01.97,On Top,,0000,0000,0000,,واتانوكي يوشيكازو
Dialogue: 0,0:05:58.80,0:06:01.97,Default,,0000,0000,0000,,واتانوكي، واتانوكي يوشيكازو
Dialogue: 0,0:06:04.18,0:06:05.43,Default,,0000,0000,0000,,!أظنّه خرج
Dialogue: 0,0:06:10.66,0:06:12.31,Default,,0000,0000,0000,,!مخيف المظهر
Dialogue: 0,0:06:12.63,0:06:14.72,Default,,0000,0000,0000,,!كـ-كونان، أنت لها
Dialogue: 0,0:06:14.72,0:06:18.28,Default,,0000,0000,0000,,يا إلهي، ضخم البنية لكن صغير الجرأة
Dialogue: 0,0:06:19.01,0:06:23.24,Default,,0000,0000,0000,,المعذرة! سقطت كرتنا في فنائك\Nفهلّا أعطيتنا إيّاها؟
Dialogue: 0,0:06:25.01,0:06:28.71,CharCard,,0000,0000,0009,,{\fad(300,0)}(واتانوكي يوشيكازو (63
Dialogue: 0,0:06:25.43,0:06:28.71,On Top,,0000,0000,0000,,أأنتم طلبة في ابتدائيّة تيتان؟
Dialogue: 0,0:06:28.71,0:06:30.13,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:30.13,0:06:32.67,Default,,0000,0000,0000,,!لن أسمح لكم بدخول فنائي
Dialogue: 0,0:06:33.13,0:06:34.84,Default,,0000,0000,0000,,!ارحلوا
Dialogue: 0,0:06:35.55,0:06:39.22,Default,,0000,0000,0000,,...ا-انتظر قليلاً! لا يمكننا دون الكرة أن
Dialogue: 0,0:06:39.72,0:06:42.13,Default,,0000,0000,0000,,هذا ما تنالونه للعبكم\N!كرة القاعدة في مكانٍ كذاك
Dialogue: 0,0:06:42.46,0:06:45.51,Default,,0000,0000,0000,,!إذا رأيتكم تدخلون المكان مُجدداً، سأتّصل بمدرستكم
Dialogue: 0,0:06:47.18,0:06:48.60,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:06:54.18,0:06:57.51,Default,,0000,0000,0000,,،لم يكن رجلاً مُتصلّب الرأس\Nبل عجوزاً مُتصلّب الرأس
Dialogue: 0,0:06:57.51,0:07:00.72,Default,,0000,0000,0000,,كان بإمكانه تركنا نبحث\Nفي الفناء على الأقل
Dialogue: 0,0:07:00.72,0:07:03.28,Default,,0000,0000,0000,,!تبّاً! أعد كرتي
Dialogue: 0,0:07:03.68,0:07:05.13,Default,,0000,0000,0000,,ليس بيدنا شيء
Dialogue: 0,0:07:05.13,0:07:10.75,Default,,0000,0000,0000,,كما قال، إنّها غلطتنا لدخولنا\Nمكاناً لا يصحّ لنا دخوله
Dialogue: 0,0:07:11.13,0:07:13.34,Default,,0000,0000,0000,,!إنّها غلطة ميتسوهيكو إذاً
Dialogue: 0,0:07:13.34,0:07:14.67,Default,,0000,0000,0000,,!فلتدفع ثمن الكرة
Dialogue: 0,0:07:14.93,0:07:19.46,Default,,0000,0000,0000,,ما رأيكم بأن نترك كرة القاعدة ونلعب\Nألعاب فيديو في منزل كونان؟
Dialogue: 0,0:07:19.46,0:07:24.34,Default,,0000,0000,0000,,فـ-فكرة حسنة! يمكننا تناول\N!أكلات خفيفة هناك أيضاً
Dialogue: 0,0:07:24.34,0:07:25.16,Default,,0000,0000,0000,,علبة غداء أنقليس؟
Dialogue: 0,0:07:25.16,0:07:25.80,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:07:25.80,0:07:28.14,Default,,0000,0000,0000,,!انتظروا! لا تحدّدوا من تلقاء أنفسكم
Dialogue: 0,0:07:28.52,0:07:30.38,Default,,0000,0000,0000,,!حسناً! لنذهب لمنزل كونان
Dialogue: 0,0:07:30.38,0:07:31.85,Default,,0000,0000,0000,,!أجل، هلمّ بنا
Dialogue: 0,0:07:40.34,0:07:43.28,Default,,0000,0000,0000,,ماذا؟ يوجد أحدهم
Dialogue: 0,0:07:43.88,0:07:46.24,Default,,0000,0000,0000,,معكِ حقّ، أهو عميل؟
Dialogue: 0,0:07:46.97,0:07:48.08,Default,,0000,0000,0000,,يا عمّ
Dialogue: 0,0:07:50.34,0:07:52.47,Default,,0000,0000,0000,,...يا للملامح الحادة
Dialogue: 0,0:07:52.47,0:07:54.87,Default,,0000,0000,0000,,هل أتيتَ لأجل وكالة موري للتحرّي؟
Dialogue: 0,0:07:56.05,0:07:57.34,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:07:57.34,0:07:59.84,Default,,0000,0000,0000,,أعيش هنا، سأرشدك لها
Dialogue: 0,0:08:08.68,0:08:10.01,Default,,0000,0000,0000,,!لقد رجعت
Dialogue: 0,0:08:10.01,0:08:11.01,Default,,0000,0000,0000,,!مرحباً بعودتك
Dialogue: 0,0:08:11.01,0:08:12.02,Default,,0000,0000,0000,,!أهلاً بكم
Dialogue: 0,0:08:12.34,0:08:13.94,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:08:14.72,0:08:17.23,Default,,0000,0000,0000,,جماعة المزعجين مُجدداً
Dialogue: 0,0:08:17.76,0:08:19.93,Default,,0000,0000,0000,,!يا عمّ! لديك ضيف
Dialogue: 0,0:08:19.93,0:08:21.03,Default,,0000,0000,0000,,زائر؟
Dialogue: 0,0:08:22.43,0:08:27.37,Default,,0000,0000,0000,,اسمي كودا، فُقدت أختي الصغيرة\Nقبل قرابة شهر
Dialogue: 0,0:08:27.93,0:08:31.26,Default,,0000,0000,0000,,!حسناً، حسناً! فلتتفضّل بالجلوس أوّلاً
Dialogue: 0,0:08:31.26,0:08:33.11,Default,,0000,0000,0000,,!ران، حضّري شاياً
Dialogue: 0,0:08:33.11,0:08:33.72,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:08:37.34,0:08:41.05,Default,,0000,0000,0000,,آسفة، لكن هلّا لعبتم خارجاً لفترة أطول؟
Dialogue: 0,0:08:41.05,0:08:42.84,Default,,0000,0000,0000,,تبّاً، الحظّ ليس معنا
Dialogue: 0,0:08:42.84,0:08:44.63,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:08:44.63,0:08:47.09,Default,,0000,0000,0000,,تريد منّي البحث عن شخص مفقود إذاً؟
Dialogue: 0,0:08:47.55,0:08:52.56,Default,,0000,0000,0000,,كلا، قُتلت أختي! بيد رجل\N!يُدعى واتانوكي يوشيكازو
Dialogue: 0,0:08:53.47,0:08:54.14,Default,,0000,0000,0000,,!واتانوكي؟
Dialogue: 0,0:08:54.84,0:08:57.80,Default,,0000,0000,0000,,أتقصد واتانوكي-سان الذي يعيش\Nبجوار موقع البناء؟
Dialogue: 0,0:08:57.80,0:08:58.86,Default,,0000,0000,0000,,أتعرفه؟
Dialogue: 0,0:08:58.86,0:09:02.51,Default,,0000,0000,0000,,!بالأحرى، قابلناه قبل قليل
Dialogue: 0,0:09:02.51,0:09:06.34,Default,,0000,0000,0000,,لم يسمح لنا بأخذ الكرة التي\N!أطارها غينتا-كن في فنائه
Dialogue: 0,0:09:06.34,0:09:09.66,Default,,0000,0000,0000,,أخبرنا أنّه لن يسمح لنا بدخول الفناء
Dialogue: 0,0:09:10.01,0:09:11.51,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:09:11.51,0:09:15.21,Default,,0000,0000,0000,,لم يسمح لكم بدخول الفناء لأنّ\N!جثّة أختي مدفونة هناك
Dialogue: 0,0:09:16.12,0:09:20.47,Default,,0000,0000,0000,,تمهّل! اشرح التفاصيل من البداية رجاءً
Dialogue: 0,0:09:20.47,0:09:21.00,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:09:24.38,0:09:27.30,Default,,0000,0000,0000,,رأيتُه في مكانٍ ما قبلاً
Dialogue: 0,0:09:28.34,0:09:31.39,Default,,0000,0000,0000,,لكنّي لا أذكر أين
Dialogue: 0,0:09:31.80,0:09:32.80,Default,,0000,0000,0000,,{\a6\a6}اسمي كودا ماساو
Dialogue: 0,0:09:32.80,0:09:34.88,On Top,,0000,0000,0000,,اسمي كودا ماساو
Dialogue: 0,0:09:32.80,0:09:39.77,CharCard,,0000,0000,0008,,{\fad(300,0)}(كودا ماساو (29
Dialogue: 0,0:09:34.88,0:09:37.18,On Top,,0000,0000,0000,,لديّ أخت واحدة
Dialogue: 0,0:09:37.18,0:09:39.35,On Top,,0000,0000,0000,,وُولدت في ساكو، محافظة ناغانو
Dialogue: 0,0:09:39.81,0:09:44.41,Default,,0000,0000,0000,,أعرف ساكو! بها طريق القسموس، صحيح؟
Dialogue: 0,0:09:44.41,0:09:48.43,Default,,0000,0000,0000,,أجل، كانت أختي تحبّ أزهار القسموس أيضاً
Dialogue: 0,0:09:48.43,0:09:50.21,Default,,0000,0000,0000,,هذه أختي ساناي
Dialogue: 0,0:09:51.18,0:09:54.21,Default,,0000,0000,0000,,يا للآنسة الجميلة
Dialogue: 0,0:09:54.21,0:09:58.64,On Top,,0000,0000,0000,,!بالفعل! لا تشبه أخيها البتّة
Dialogue: 0,0:09:54.98,0:09:59.67,CharCard,,0000,0000,0008,,{\fad(300,0)}(كودا ساناي (26
Dialogue: 0,0:09:58.64,0:09:59.67,On Top,,0000,0000,0000,,!بشرتها بيضاء أيضاً
Dialogue: 0,0:10:00.85,0:10:02.39,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:10:02.98,0:10:08.31,Default,,0000,0000,0000,,انتقلت أختي هنا قبل ستّة أعوام\Nللعمل لشركة توتو الأمنيّة
Dialogue: 0,0:10:08.31,0:10:13.35,Default,,0000,0000,0000,,وقبل عامين، أصبحت رئيسة مكتب فرع بيكا
Dialogue: 0,0:10:13.35,0:10:19.52,Default,,0000,0000,0000,,،لكن ليلة الثامن من الشهر الفائت\Nغادرت الشركة للقاء عميل
Dialogue: 0,0:10:19.52,0:10:21.81,Default,,0000,0000,0000,,وفُقد أثرها مُذ آنذاك
Dialogue: 0,0:10:21.81,0:10:26.14,Default,,0000,0000,0000,,وكان ذاك العميل هو واتانوكي يوشيكازو-سان؟
Dialogue: 0,0:10:26.14,0:10:27.29,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:10:27.68,0:10:31.56,Default,,0000,0000,0000,,أتيتُ للمدينة بعد ذلك بليلتين، يوم الأحد
Dialogue: 0,0:10:31.56,0:10:35.23,Default,,0000,0000,0000,,وعرفتُ عن هذا في شركتها من اليوم التالي
Dialogue: 0,0:10:35.23,0:10:38.81,Default,,0000,0000,0000,,متى غادرت أختك الشركة؟
Dialogue: 0,0:10:38.81,0:10:40.73,Default,,0000,0000,0000,,عند الثامنة ليلاً تقريباً
Dialogue: 0,0:10:40.73,0:10:44.56,Default,,0000,0000,0000,,وفقما يبدو، فقد قالت أنّها\Nستمرّ بمنزل واتانوكي
Dialogue: 0,0:10:44.56,0:10:45.76,Default,,0000,0000,0000,,ثمّ ترجع لبيتها
Dialogue: 0,0:10:45.76,0:10:48.72,Default,,0000,0000,0000,,لمَ تمرّ بمنزل عميل في\Nذاك الوقت المتأخّر؟
Dialogue: 0,0:10:48.72,0:10:51.64,Default,,0000,0000,0000,,،وفق كلام مدير الفرع
Dialogue: 0,0:10:51.64,0:10:54.43,Default,,0000,0000,0000,,فقد انهارت قيمة الأسهم التي اشتراها واتانوكي
Dialogue: 0,0:10:54.43,0:10:58.15,Default,,0000,0000,0000,,وكان يضغط على أختي لتعويضه عن خسائره
Dialogue: 0,0:10:58.48,0:11:02.06,Default,,0000,0000,0000,,أي إحدى حالات مدفوعات التعويض تلك؟
Dialogue: 0,0:11:02.06,0:11:05.99,Default,,0000,0000,0000,,أذهبت لمقابلة واتانوكي-سان إذاً؟
Dialogue: 0,0:11:06.31,0:11:10.48,Default,,0000,0000,0000,,أجل، ذهبتُ مع مدير الفرع\Nظهيرة الحادي عشر من الشهر
Dialogue: 0,0:11:10.48,0:11:14.92,Default,,0000,0000,0000,,!لكنّه قال أنّ أختي لم تأته ليلة الثامن
Dialogue: 0,0:11:15.31,0:11:21.18,Default,,0000,0000,0000,,لكنّها كذبة! فقد ذهبت لمنزله\Nتلك الليلة، ورفضت الدفع
Dialogue: 0,0:11:21.18,0:11:25.13,Default,,0000,0000,0000,,!أثار ذلك غضب واتانوكي، فقتلها ودفنها في الفناء
Dialogue: 0,0:11:27.64,0:11:30.56,Default,,0000,0000,0000,,أخبرني، لمَ تعتقد أنّها دُفنت في الفناء؟
Dialogue: 0,0:11:32.27,0:11:33.77,Default,,0000,0000,0000,,لسببين
Dialogue: 0,0:11:34.14,0:11:38.14,Default,,0000,0000,0000,,الأوّل، لا يملك واتانوكي رخصة قيادة
Dialogue: 0,0:11:38.14,0:11:41.94,Default,,0000,0000,0000,,فلم يكن بإمكانه نقل\Nالجثّة بعيداً دون سيّارة
Dialogue: 0,0:11:42.48,0:11:45.64,Default,,0000,0000,0000,,والثاني أنّ موظّف شركة \Nفي المنزل المجاور قد سمع
Dialogue: 0,0:11:45.64,0:11:51.95,Default,,0000,0000,0000,,في وقت متأخّر تلك الليلة عند\Nالثانية صباحاً صوت حفر بمجرفة
Dialogue: 0,0:11:51.95,0:11:52.91,Default,,0000,0000,0000,,حفر؟
Dialogue: 0,0:11:53.39,0:11:56.35,Default,,0000,0000,0000,,رجل يُدعى موتشيدا-سان يعيش بالقرب
Dialogue: 0,0:11:56.35,0:12:00.35,Default,,0000,0000,0000,,قال أنّ أعمال البناء كانت قائمة\Nفي الشارع الرئيسيّ
Dialogue: 0,0:12:00.35,0:12:02.92,Default,,0000,0000,0000,,تلك الليلة بين منتصف الليل والثالثة صباحاً
Dialogue: 0,0:12:02.92,0:12:07.89,Default,,0000,0000,0000,,استغلّ واتانوكي ضوضاء ذلك\N!وحفر حفرةً بلا شكّ
Dialogue: 0,0:12:08.64,0:12:12.22,Default,,0000,0000,0000,,فهمت، لمَ لم تخبر الشرطة بهذا إذاً؟
Dialogue: 0,0:12:12.52,0:12:14.48,Default,,0000,0000,0000,,!أخبرتهم بالطبع
Dialogue: 0,0:12:14.48,0:12:18.56,Default,,0000,0000,0000,,،لكن كان موتشيدا-سان ثملاً بشدّة تلك الليلة
Dialogue: 0,0:12:18.56,0:12:21.65,Default,,0000,0000,0000,,فقالت الشرطة أنّ شهادته ضعيفة
Dialogue: 0,0:12:22.27,0:12:28.16,Default,,0000,0000,0000,,في النهاية، استجوبوا واتانوكي \Nاتّباعاً للإجراءات لا أكثر
Dialogue: 0,0:12:28.56,0:12:35.31,Default,,0000,0000,0000,,،يعيش واتانوكي في ذاك المنزل بمفرده\Nولم يغادره مُذ تلك الليلة تقريباً
Dialogue: 0,0:12:35.31,0:12:39.48,Default,,0000,0000,0000,,،لكن صباح كلّ سبت عند العاشرة
Dialogue: 0,0:12:39.48,0:12:44.10,Default,,0000,0000,0000,,يغادر لمشفى بيكا المركزيّ، ويغيب لساعتين
Dialogue: 0,0:12:44.10,0:12:45.09,Default,,0000,0000,0000,,...لذا أريد منك يا موري-سان
Dialogue: 0,0:12:46.64,0:12:50.35,Default,,0000,0000,0000,,غداً السبت، فهلّا رافقتني لمنزله
Dialogue: 0,0:12:50.35,0:12:53.64,Default,,0000,0000,0000,,واستنتجت أين دفن جثّة أختي؟
Dialogue: 0,0:12:53.64,0:12:56.14,Default,,0000,0000,0000,,!سأستخرجها بنفسي بالطبع
Dialogue: 0,0:12:57.35,0:13:02.35,Default,,0000,0000,0000,,أي أنّك تريد منّي\Nالتسلّل لفنائه معك؟
Dialogue: 0,0:13:02.35,0:13:03.39,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:03.39,0:13:04.57,Default,,0000,0000,0000,,لا أستطيع ذلك
Dialogue: 0,0:13:06.43,0:13:09.66,Default,,0000,0000,0000,,دخول فناء الآخرين بلا إذن\Nسلوك غير شرعيّ
Dialogue: 0,0:13:10.48,0:13:15.48,Default,,0000,0000,0000,,،كما، مهما كنتُ متحرّياً بارعاً\Nفلا يمكنني إيجاد مكان دفن جثّة
Dialogue: 0,0:13:15.48,0:13:18.62,Default,,0000,0000,0000,,قد دُفنت قبل شهر\Nفي ذاك الوقت الوجيز
Dialogue: 0,0:13:21.93,0:13:23.43,Default,,0000,0000,0000,,...كودا-سان
Dialogue: 0,0:13:23.43,0:13:25.30,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:13:25.30,0:13:27.18,Default,,0000,0000,0000,,!انسَ الأمر
Dialogue: 0,0:13:27.18,0:13:28.22,Default,,0000,0000,0000,,...كودا-سان
Dialogue: 0,0:13:30.18,0:13:32.66,Default,,0000,0000,0000,,أعتذر على إزعاجك
Dialogue: 0,0:13:35.48,0:13:36.89,Default,,0000,0000,0000,,...المعذرة
Dialogue: 0,0:13:40.85,0:13:42.19,Default,,0000,0000,0000,,!تذكّرت
Dialogue: 0,0:13:42.52,0:13:45.11,Default,,0000,0000,0000,,!هذا الشخص يبدو مثل فضائيّ الخلد
Dialogue: 0,0:13:46.02,0:13:46.99,Default,,0000,0000,0000,,...فضائيّ
Dialogue: 0,0:13:46.99,0:13:47.94,Default,,0000,0000,0000,,الخلد؟
Dialogue: 0,0:13:49.10,0:13:50.98,Default,,0000,0000,0000,,!معكِ حق، يشبهه بالفعل
Dialogue: 0,0:13:50.98,0:13:55.91,Default,,0000,0000,0000,,أليس كذلك؟! ينتحل فضائيّ الخلد\N!هيئات رفاق يايبا المقنّع لخداعه
Dialogue: 0,0:13:55.91,0:13:59.87,Default,,0000,0000,0000,,!يخرج من الأرض فجأةً مثل الخلد
Dialogue: 0,0:14:00.18,0:14:03.79,Default,,0000,0000,0000,,!فهمت! لذا أراد حفر الفناء
Dialogue: 0,0:14:04.23,0:14:07.14,Default,,0000,0000,0000,,...أنتم، ليس الأمر هكذا
Dialogue: 0,0:14:07.14,0:14:09.80,Default,,0000,0000,0000,,أبي، أستتركه هكذا وحسب؟
Dialogue: 0,0:14:10.14,0:14:14.77,Default,,0000,0000,0000,,ليس بيدي حيلة، فقد أخبرني أن أنسى الموضوع بنفسه
Dialogue: 0,0:14:14.77,0:14:21.23,Default,,0000,0000,0000,,كما أنّه متيقّن أنّ واتانوكي ذاك\N،قد قتل أخته ودفنها في فنائه
Dialogue: 0,0:14:21.23,0:14:23.85,Default,,0000,0000,0000,,لكن لا دليل على ذلك
Dialogue: 0,0:14:23.85,0:14:28.48,Default,,0000,0000,0000,,يمكن أنّ صوت المجرفة كان\Nمن أعمال البناء على الشارع أيضاً
Dialogue: 0,0:14:28.81,0:14:30.89,Default,,0000,0000,0000,,...ذلك صحيح، لكن
Dialogue: 0,0:14:31.19,0:14:34.75,Default,,0000,0000,0000,,حسناً، لا أمانع إجراء تفقد سريع بدوري
Dialogue: 0,0:14:34.75,0:14:38.73,Default,,0000,0000,0000,,بالفعل، هنالك صحّةٌ في كلام العمّ
Dialogue: 0,0:14:38.73,0:14:41.15,Default,,0000,0000,0000,,...لا يمكننا الجزم بشيءٍ في هذه المرحلة
Dialogue: 0,0:14:41.15,0:14:43.72,Default,,0000,0000,0000,,!حسناً، حُسم الأمر
Dialogue: 0,0:14:43.72,0:14:46.14,Default,,0000,0000,0000,,!واحد، اثنان، هيّا
Dialogue: 0,0:14:46.78,0:14:48.82,Default,,0000,0000,0000,,...يراودني شعورٌ سيّئ
Dialogue: 0,0:14:56.69,0:14:58.77,Default,,0000,0000,0000,,قرّروا القدوم هنا بالفعل
Dialogue: 0,0:14:59.28,0:15:03.11,Default,,0000,0000,0000,,بدايةً، علينا التفكير بطريقة\Nكي نستطيع الدخول
Dialogue: 0,0:15:03.65,0:15:06.48,Default,,0000,0000,0000,,...يمكننا افتراض أنّ البوابة مقفلة، لذا
Dialogue: 0,0:15:06.48,0:15:07.07,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:09.44,0:15:10.33,Default,,0000,0000,0000,,مفتوحة
Dialogue: 0,0:15:10.86,0:15:13.48,Default,,0000,0000,0000,,!يا لحظّنا! لا بدّ أنّه غادر لمكانٍ ما
Dialogue: 0,0:15:13.48,0:15:15.28,Default,,0000,0000,0000,,!حسنٌ، الآن فرصتنا
Dialogue: 0,0:15:15.28,0:15:16.82,Default,,0000,0000,0000,,!مـ-مهلكم
Dialogue: 0,0:15:21.57,0:15:25.36,Default,,0000,0000,0000,,لا يمكننا معرفة أين دُفنت بمجرّد النظر
Dialogue: 0,0:15:25.36,0:15:29.85,Default,,0000,0000,0000,,بالطبع! لا نعرف ما إن \N!كانت مدفونةً هنا بالأصل
Dialogue: 0,0:15:30.19,0:15:34.81,Default,,0000,0000,0000,,!لنبدأ بالتنقيب في المكان إذاً\N!سأبحث عن مجرفة
Dialogue: 0,0:15:34.81,0:15:35.96,Default,,0000,0000,0000,,!انتظر، غينتا
Dialogue: 0,0:15:35.96,0:15:37.10,Default,,0000,0000,0000,,!أنتم، يا صغار
Dialogue: 0,0:15:44.49,0:15:46.88,CharCard,,0000,0000,0000,,{\fad(300,0_}مركز شرطة بيكا
Dialogue: 0,0:15:47.00,0:15:51.78,Default,,0000,0000,0000,,أجل، أتعبنا ذاك الرجل كودا كثيراً أيضاً
Dialogue: 0,0:15:51.78,0:15:53.21,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:15:54.12,0:15:58.24,Default,,0000,0000,0000,,فقد واتانوكي-سان قرابة\Nمليون ونصف ينّ في سوق الأسهم
Dialogue: 0,0:15:58.24,0:16:02.22,Default,,0000,0000,0000,,ذاك قدرٌ كبير، لكن أيكفي لتقتل شخصاً حقّاً؟
Dialogue: 0,0:16:02.66,0:16:04.08,Default,,0000,0000,0000,,...حسناً، معك حق
Dialogue: 0,0:16:04.08,0:16:07.89,Default,,0000,0000,0000,,علاوةً على ذلك، إنّه متأكّد أنّ\Nواتانوكي-سان هو الفاعل
Dialogue: 0,0:16:07.89,0:16:11.49,Default,,0000,0000,0000,,وظلّ يتتبعه لقرابة شهرٍ الآن
Dialogue: 0,0:16:11.49,0:16:15.23,Default,,0000,0000,0000,,من منظورنا، واتانوكي-سان هو الأقرب للضحيّة
Dialogue: 0,0:16:22.66,0:16:27.24,Default,,0000,0000,0000,,...آسفون! أردنا إيجاد الكرة بشدّة، فتسلّلنا للداخل
Dialogue: 0,0:16:27.24,0:16:28.91,Default,,0000,0000,0000,,!آسفون حقّاً
Dialogue: 0,0:16:28.91,0:16:30.25,Default,,0000,0000,0000,,!آسفون
Dialogue: 0,0:16:31.70,0:16:37.21,Default,,0000,0000,0000,,،لا بأس، كنتُ منفعلاً قليلاً آنذاك أيضاً\Nفأعتذر على الصراخ عليكم
Dialogue: 0,0:16:38.62,0:16:41.33,Default,,0000,0000,0000,,وجدتُ كرتكم قبل قليل
Dialogue: 0,0:16:41.33,0:16:42.66,Default,,0000,0000,0000,,سأرجعها لكم إذا
Dialogue: 0,0:16:42.66,0:16:46.30,Default,,0000,0000,0000,,وعدتموني ألّا تقتربوا من بناية\Nالشقق تلك مُجدداً
Dialogue: 0,0:16:46.30,0:16:48.95,Default,,0000,0000,0000,,!حسناً! نعدك
Dialogue: 0,0:16:48.95,0:16:50.31,Default,,0000,0000,0000,,انتظروا قليلاً
Dialogue: 0,0:16:51.16,0:16:51.90,Default,,0000,0000,0000,,!هذا رائع
Dialogue: 0,0:16:51.90,0:16:52.88,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:16:55.83,0:16:56.98,Default,,0000,0000,0000,,لديك رسالة واحدة
Dialogue: 0,0:16:59.95,0:17:02.53,Default,,0000,0000,0000,,نحن مشفى بيكا المركزي
Dialogue: 0,0:17:02.91,0:17:06.99,Default,,0000,0000,0000,,لديك موعد فحص غداً، لذا لا تنسَ القدوم رجاءً
Dialogue: 0,0:17:08.08,0:17:10.29,Default,,0000,0000,0000,,...ألم يكن ذاك صوت
Dialogue: 0,0:17:10.91,0:17:15.25,Default,,0000,0000,0000,,!ما هذا الهراء؟! أنا أعرف ذلك\N!لا داعي ليخبروني
Dialogue: 0,0:17:15.91,0:17:17.00,Default,,0000,0000,0000,,هاكم
Dialogue: 0,0:17:19.48,0:17:21.51,Default,,0000,0000,0000,,!فلتأخذوها وتغادروا سريعاً
Dialogue: 0,0:17:22.70,0:17:24.63,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:17:25.03,0:17:28.56,Default,,0000,0000,0000,,ظننتُه يتصرّف بلطف، لكنّه رجع لغضبه مُجدداً
Dialogue: 0,0:17:28.56,0:17:31.24,Default,,0000,0000,0000,,يا له من عجوز مزاجي
Dialogue: 0,0:17:31.24,0:17:33.52,Default,,0000,0000,0000,,بصرف النظر عن ذلك، ألم تسمعوا ذاك الاتّصال؟
Dialogue: 0,0:17:33.91,0:17:36.98,Default,,0000,0000,0000,,أجل، بدا مشابهاً لصوت كودا-سان
Dialogue: 0,0:17:37.41,0:17:39.13,Default,,0000,0000,0000,,ماذا؟ كودا-سان؟
Dialogue: 0,0:17:39.13,0:17:40.86,Default,,0000,0000,0000,,فضائيّ الخلد ذاك؟
Dialogue: 0,0:17:41.49,0:17:43.03,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:17:43.03,0:17:45.24,Default,,0000,0000,0000,,ينوي كودا-سان التنقيب عن الجثّة
Dialogue: 0,0:17:45.24,0:17:48.49,Default,,0000,0000,0000,,بينما ينشغل واتانوكي-سان\Nفي المشفى غداً
Dialogue: 0,0:17:50.87,0:17:54.66,Default,,0000,0000,0000,,لكن، أتوجد جثّة مدفونة\Nفي هذا الفناء حقّاً؟
Dialogue: 0,0:17:55.58,0:18:01.63,Default,,0000,0000,0000,,لو صحّ ذلك، فيستحيل تحديد مكانها\Nفي مجرّد ساعتين
Dialogue: 0,0:18:02.41,0:18:05.97,Default,,0000,0000,0000,,ما الذي ينوي كودا-سان فعله بالضبط؟
Dialogue: 0,0:18:10.21,0:18:12.75,CharCard,,0000,0000,0000,,{\fad(250,300)}(اليوم التالي (السبت
Dialogue: 0,0:18:16.78,0:18:18.77,Default,,0000,0000,0000,,كونان! ما الساعة الآن؟
Dialogue: 0,0:18:20.87,0:18:22.91,Default,,0000,0000,0000,,العاشرة إلّا سبع دقائق
Dialogue: 0,0:18:22.91,0:18:24.95,Default,,0000,0000,0000,,...بعدما أخبرتهم مراراً بعدم القدوم
Dialogue: 0,0:18:25.53,0:18:28.16,Default,,0000,0000,0000,,جلبت مجرفةً كبيرة بحقّ
Dialogue: 0,0:18:28.16,0:18:31.91,Default,,0000,0000,0000,,فكّرتُ بمساعدة فضائيّ الخلد\N!في التنقيب عن الجثّة
Dialogue: 0,0:18:32.41,0:18:35.16,Default,,0000,0000,0000,,أخبرني، ما الذي تنوي فعله يا كونان-كن؟
Dialogue: 0,0:18:35.16,0:18:38.74,Default,,0000,0000,0000,,أنوي إيقاف كودا-سان بشكلٍ ما
Dialogue: 0,0:18:38.74,0:18:43.16,Default,,0000,0000,0000,,مهما كان السبب، لا يصحّ التسلّل \Nلمنازل الآخرين
Dialogue: 0,0:18:47.91,0:18:50.14,Default,,0000,0000,0000,,!ميتسوهيكو! فلتتبع العجوز
Dialogue: 0,0:18:51.24,0:18:55.24,Default,,0000,0000,0000,,إذا رجع في منتصف الوقت، فلتعلمنا\N!عبر شارة فرقة التحرّي
Dialogue: 0,0:18:55.24,0:18:57.28,Default,,0000,0000,0000,,!حسناً، فهمت
Dialogue: 0,0:19:04.66,0:19:07.41,Default,,0000,0000,0000,,تأخّر فضائيّ الخلد
Dialogue: 0,0:19:07.41,0:19:10.08,Default,,0000,0000,0000,,كونان، ما الساعة الآن؟
Dialogue: 0,0:19:10.08,0:19:12.20,Default,,0000,0000,0000,,العاشرة وعشر دقائق
Dialogue: 0,0:19:17.58,0:19:18.67,Default,,0000,0000,0000,,!كان المفتّش ميغوري
Dialogue: 0,0:19:21.08,0:19:23.20,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:19:23.20,0:19:24.66,Default,,0000,0000,0000,,!سأذهب للتفقّد
Dialogue: 0,0:19:24.66,0:19:25.59,Default,,0000,0000,0000,,!انتظر، كونان
Dialogue: 0,0:19:28.03,0:19:29.15,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:19:32.91,0:19:35.91,Default,,0000,0000,0000,,لنلقِ نظرةً في الداخل إذاً\Nيا مفتّش ميغوري
Dialogue: 0,0:19:35.91,0:19:37.91,Default,,0000,0000,0000,,!مفتّش ميغوري
Dialogue: 0,0:19:37.91,0:19:39.78,Default,,0000,0000,0000,,موري-كن؟
Dialogue: 0,0:19:39.78,0:19:40.77,Default,,0000,0000,0000,,فلتسبقاني
Dialogue: 0,0:19:40.77,0:19:41.50,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:19:44.78,0:19:47.24,Default,,0000,0000,0000,,سمعتُ أنّه سطو مسلّح
Dialogue: 0,0:19:47.24,0:19:51.33,Default,,0000,0000,0000,,...أجل، وقع قبل قرابة سبع دقائق
Dialogue: 0,0:19:51.33,0:19:54.62,Default,,0000,0000,0000,,ما يعني أنّك لم تكن\Nموجوداً أثناءه؟
Dialogue: 0,0:19:54.62,0:19:59.03,Default,,0000,0000,0000,,كلا، صادف أنّي مررت بالمكان للتوّ
Dialogue: 0,0:19:59.03,0:20:01.08,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:20:01.08,0:20:04.34,Default,,0000,0000,0000,,...ظننتُ أنّك في مسرح جريمة أخرى كالعادة
Dialogue: 0,0:20:03.16,0:20:04.34,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:20:04.87,0:20:07.03,Default,,0000,0000,0000,,!وجدنا وجه السارق على كاميرا المراقبة
Dialogue: 0,0:20:07.03,0:20:07.95,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:20:07.95,0:20:09.95,Default,,0000,0000,0000,,!تعرفه أيضاً يا موري-سان
Dialogue: 0,0:20:10.57,0:20:11.08,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:20:11.08,0:20:12.53,Default,,0000,0000,0000,,فلندخل بأيّ حال
Dialogue: 0,0:20:21.78,0:20:24.45,Default,,0000,0000,0000,,حضرة المفتّش، إنّه هذا الرجل
Dialogue: 0,0:20:24.45,0:20:25.40,Default,,0000,0000,0000,,!أعرفه
Dialogue: 0,0:20:25.40,0:20:28.19,Default,,0000,0000,0000,,من هو يا موري-كن؟
Dialogue: 0,0:20:29.35,0:20:31.15,Default,,0000,0000,0000,,!كودا-سان
Dialogue: 0,0:20:31.62,0:20:35.41,Default,,0000,0000,0000,,!اسم هذا الرجل هو كودا ماساو
Dialogue: 0,0:20:35.41,0:20:38.83,Default,,0000,0000,0000,,لكن لمَ يسطو على محلّ مجوهرات؟
Dialogue: 0,0:20:38.83,0:20:43.12,Default,,0000,0000,0000,,أيّاً يكن، سرق كودا مجموعةً\N!من المجوهرات وهرب
Dialogue: 0,0:20:43.58,0:20:44.74,Default,,0000,0000,0000,,!مفتّش ميغوري
Dialogue: 0,0:20:44.74,0:20:48.34,Default,,0000,0000,0000,,وجدنا درّاجة السارق\N!بالقرب من محطّة بيكا
Dialogue: 0,0:20:48.34,0:20:49.50,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:55.70,0:20:57.58,Default,,0000,0000,0000,,لا شكّ في الأمر حضرة المفتّش
Dialogue: 0,0:20:57.58,0:21:00.99,Default,,0000,0000,0000,,يطابق رقم اللوحة إفادة الشهود
Dialogue: 0,0:21:00.99,0:21:02.23,Default,,0000,0000,0000,,!مفتّش ميغوري
Dialogue: 0,0:21:02.53,0:21:04.69,Default,,0000,0000,0000,,!وجدنا هذه على أدراج المحطّة
Dialogue: 0,0:21:05.53,0:21:06.65,Default,,0000,0000,0000,,جوهرة؟
Dialogue: 0,0:21:07.20,0:21:11.58,Default,,0000,0000,0000,,لا شكّ في الأمر، هرب السارق على\N!خطّ الحلقة من محطّة بيكا
Dialogue: 0,0:21:11.58,0:21:14.24,Default,,0000,0000,0000,,أرسلوا طلب انتشار عاجل\N!على محطّات خطّ الحلقة
Dialogue: 0,0:21:14.24,0:21:15.12,Default,,0000,0000,0000,,!عُلِم
Dialogue: 0,0:21:15.12,0:21:18.49,Default,,0000,0000,0000,,ليستمرّ الآخرون بتفتيش المنطقة بالجوار
Dialogue: 0,0:21:18.49,0:21:19.08,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:21:19.08,0:21:26.00,Default,,0000,0000,0000,,هل خدعنا كودا-سان بالفعل مثل\Nفضائيّ الخلد كما قالت أيومي والبقيّة؟
Dialogue: 0,0:21:26.83,0:21:31.12,Default,,0000,0000,0000,,أكانت قصّة مقتل أخته مُختلقة؟
Dialogue: 0,0:21:32.58,0:21:35.33,Default,,0000,0000,0000,,لكن لمَ قد يختلقها؟
Dialogue: 0,0:21:35.33,0:21:40.10,Default,,0000,0000,0000,,،كما، حتّى لو كان لديه دافع\Nفلمَ يقدم شخص متحضّر مثله
Dialogue: 0,0:21:40.74,0:21:46.41,Default,,0000,0000,0000,,على السطو على متجر دون\Nنظّارات شمسية أو قناع لإخفاء وجهه؟
Dialogue: 0,0:21:46.41,0:21:49.69,Default,,0000,0000,0000,,كما ترك درّاجته التي هرب بها على مرأى الجميع
Dialogue: 0,0:21:56.66,0:22:00.99,Default,,0000,0000,0000,,...ورقة؟ سقطت لتوّها وخضراء
Dialogue: 0,0:22:01.74,0:22:07.78,Default,,0000,0000,0000,,كونها عالقة هنا يعني أنّ\N!أحدهم رفع هذه الفتحة قبل قليل
Dialogue: 0,0:22:07.78,0:22:08.91,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:22:08.91,0:22:11.92,Default,,0000,0000,0000,,كانت هناك واحدة عند مدخل\N!منزل واتانوكي-سان الخلفيّ أيضاً
Dialogue: 0,0:22:17.74,0:22:18.97,Default,,0000,0000,0000,,...أيمكن أنّ
Dialogue: 0,0:22:19.58,0:22:23.10,Default,,0000,0000,0000,,...دافع كودا-سان الحقيقيّ هو
Dialogue: 0,0:24:05.66,0:24:06.53,Default,,0000,0000,0000,,!إنّه هو
Dialogue: 0,0:24:06.53,0:24:08.55,Default,,0000,0000,0000,,!إنّه فضائيّ الخلد حقّاً
Dialogue: 0,0:24:09.82,0:24:12.13,Default,,0000,0000,0000,,!خذني لشارع بيكا الأوّل! أسرع رجاءً
Dialogue: 0,0:24:12.13,0:24:13.05,Default,,0000,0000,0000,,!حـ-حاضر
Dialogue: 0,0:24:13.47,0:24:16.51,Default,,0000,0000,0000,,غينتا-كن! استقلّ المُسن سيّارة أجرة\N!وهو عائد لكم
Dialogue: 0,0:24:16.77,0:24:20.23,Default,,0000,0000,0000,,!يا عمّ! واتانوكي-سان سيرجع قريباً
Dialogue: 0,0:24:21.73,0:24:24.88,Default,,0000,0000,0000,,...إذا أصاب تحليلي، فكودا-سان
Dialogue: 0,0:24:25.57,0:24:31.57,On Top,,0000,0000,0000,,قضيّة لغز فضائيّ الخلد\N(الجزء الثاني)
Dialogue: 0,0:24:26.01,0:24:27.51,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.51,0:24:31.43,Default,,0000,0000,0000,,قضيّة لغز فضائيّ الخلد\N(الجزء الثاني)
Dialogue: 0,0:24:47.35,0:24:50.02,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:50.02,0:24:51.59,Default,,0000,0000,0000,,فتحة مجاري
Dialogue: 0,0:24:51.89,0:24:54.05,Default,,0000,0000,0000,,...في الحلقة القادمة، كبوات الضابط تاكاغي
Dialogue: 0,0:24:54.05,0:24:55.30,Default,,0000,0000,0000,,!يحفرها بنفسه
Dialogue: 0,0:24:55.30,0:24:57.65,Default,,0000,0000,0000,,!مهلكم

