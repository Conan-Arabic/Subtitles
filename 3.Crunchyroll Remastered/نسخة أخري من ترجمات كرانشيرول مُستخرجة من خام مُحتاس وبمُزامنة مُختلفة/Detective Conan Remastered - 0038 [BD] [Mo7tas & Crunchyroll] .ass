Dialogue: 0,0:00:01.33,0:00:04.23,Default,,0,0,0,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.92,0:00:07.17,Default,,0,0,0,,قضية اليوم تتمحور حول الإطاحة بحجّة غياب
Dialogue: 0,0:00:07.17,0:00:08.72,Default,,0,0,0,,!سماحك باستغلالك سيُكلّفك غالياً
Dialogue: 0,0:00:09.37,0:00:11.17,Default,,0,0,0,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.17,0:00:13.26,Default,,0,0,0,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.26,0:00:15.47,Default,,0,0,0,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:46.68,0:01:50.17,Title,,0,0,0,,{\fad(300,0)}جريمة قتل مهرجان أكاوني الناريّ
Dialogue: 0,0:01:46.68,0:01:50.17,Default,,0,0,0,,جريمة قتل مهرجان أكاوني الناريّ
Dialogue: 0,0:01:56.10,0:01:58.72,Default,,0,0,0,,متى سنمسك بأدلّة تقودنا لذوي الرداء الأسود
Dialogue: 0,0:01:58.72,0:02:03.01,Default,,0,0,0,,يا بروفسور أغاسا؟
Dialogue: 0,0:02:03.35,0:02:06.31,Default,,0,0,0,,قلتَ لي إن جعلتُ العمّ موري شهيراً
Dialogue: 0,0:02:06.35,0:02:10.59,Default,,0,0,0,,سيأتيه عملاء أكثر وربما تصله معلومات عنهم
Dialogue: 0,0:02:10.88,0:02:12.55,Default,,0,0,0,,أتاه عملاء أكثر، أليس كذلك؟
Dialogue: 0,0:02:12.97,0:02:17.97,Default,,0,0,0,,صحيح، لكن لا معلومات عن أولئك الأشخاص أبداً
Dialogue: 0,0:02:17.97,0:02:20.30,Default,,0,0,0,,لا تستعجل
Dialogue: 0,0:02:20.30,0:02:25.30,Default,,0,0,0,,فالعجلة قد تقودهم لاكتشاف أمرك
Dialogue: 0,0:02:25.30,0:02:27.10,Default,,0,0,0,,...وإن حصل ذلك
Dialogue: 0,0:02:27.10,0:02:28.01,Default,,0,0,0,,أعرف
Dialogue: 0,0:02:28.47,0:02:31.72,Default,,0,0,0,,قد تقع ران والعمّ في خطر
Dialogue: 0,0:02:32.34,0:02:34.47,Default,,0,0,0,,انتظر ساكناً الآن
Dialogue: 0,0:02:34.47,0:02:38.01,Default,,0,0,0,,فالصبر من خصائص المتحرّي المهمة، أليس كذلك؟
Dialogue: 0,0:02:39.14,0:02:41.92,Default,,0,0,0,,بالمناسبة، ما التجربة التي تعمل عليها؟
Dialogue: 0,0:02:42.88,0:02:45.34,Default,,0,0,0,,...هذه؟ إنّها
Dialogue: 0,0:02:52.47,0:02:55.64,Default,,0,0,0,,أ-أعرفت أيّ تجربة هذه الآن؟
Dialogue: 0,0:02:55.64,0:02:59.64,Default,,0,0,0,,أجل، استعوبتُ بوضوح أنّها تجربة خطيرة
Dialogue: 0,0:03:04.80,0:03:07.89,Default,,0,0,0,,يا إلهي، يا له من انفجار
Dialogue: 0,0:03:08.68,0:03:09.72,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:03:10.26,0:03:13.18,Default,,0,0,0,,إنّه العمّ موري، ما الذي يفعله؟
Dialogue: 0,0:03:18.93,0:03:22.38,Default,,0,0,0,,اخترت هذه إذاً؟ سنجهزها فوراً
Dialogue: 0,0:03:22.38,0:03:25.85,Default,,0,0,0,,هلّا أعطيتنا عنوانك للتوصيل سيّدي؟
Dialogue: 0,0:03:28.26,0:03:29.88,Default,,0,0,0,,!عمّي
Dialogue: 0,0:03:30.30,0:03:31.84,Default,,0,0,0,,ما الذي تفعله؟
Dialogue: 0,0:03:33.09,0:03:34.72,Default,,0,0,0,,!صه! أنا أعمل
Dialogue: 0,0:03:35.34,0:03:38.47,Default,,0,0,0,,هل تتبع ذاك الرجل؟
Dialogue: 0,0:03:38.47,0:03:41.84,Default,,0,0,0,,أنت! ماذا لو لاحظني؟
Dialogue: 0,0:03:41.84,0:03:43.51,Default,,0,0,0,,ارجع يا فتى
Dialogue: 0,0:03:43.51,0:03:47.01,Default,,0,0,0,,وأخبر ران أنّي سأتأخر الليلة فلا داعي للعشاء
Dialogue: 0,0:03:52.30,0:03:54.30,Default,,0,0,0,,!لا تهتم بي
Dialogue: 0,0:03:55.14,0:03:57.51,Default,,0,0,0,,.بحقّك
Dialogue: 0,0:04:03.13,0:04:08.43,Title,,0,0,10,,{\fad(340,0)}مهرجان قرية أكاوني الناريّ\Nالأحد، العاشر من نوفمبر
Dialogue: 0,0:04:46.55,0:04:49.10,Default,,0,0,0,,!كان عملاً يسيراً
Dialogue: 0,0:04:49.10,0:04:52.84,Default,,0,0,0,,نصف مليون ين مقابل تتبع شخص\N!لثلاثة أيام فحسب
Dialogue: 0,0:04:52.84,0:04:55.30,Default,,0,0,0,,!بعض الأعمال سخيّة المقابل حقّاً
Dialogue: 0,0:04:55.64,0:05:00.26,Default,,0,0,0,,!هذا يعني أنّ الجميع يقدّرون تحريّاتك العظيمة
Dialogue: 0,0:05:02.34,0:05:06.72,Default,,0,0,0,,حتّى أنا مذهول من حلّي للقضايا الصعبة\N!الواحدة تلو الأخرى
Dialogue: 0,0:05:07.81,0:05:09.92,Default,,0,0,0,,أنا من حلّها
Dialogue: 0,0:05:10.51,0:05:12.84,Default,,0,0,0,,بالمناسبة، تحسّن مجرى عملك
Dialogue: 0,0:05:12.84,0:05:15.26,Default,,0,0,0,,مُذ أتى كونان-كن إلينا
Dialogue: 0,0:05:16.14,0:05:20.72,Default,,0,0,0,,!لعلّه جلب الحظّ الحسن معه
Dialogue: 0,0:05:20.72,0:05:21.76,Default,,0,0,0,,...هذا ليس
Dialogue: 0,0:05:22.26,0:05:25.47,Default,,0,0,0,,ران، إلى متى سنعتني بهذا الطفل؟
Dialogue: 0,0:05:26.35,0:05:29.18,Default,,0,0,0,,لا يزال والداه في المشفى؟
Dialogue: 0,0:05:29.71,0:05:33.93,Default,,0,0,0,,...في الواقع، عندما زرتُ البروفسور أغاسا بالأمس
Dialogue: 0,0:05:34.89,0:05:37.51,Default,,0,0,0,,خـ-خرجا من المشفى
Dialogue: 0,0:05:37.51,0:05:40.63,Default,,0,0,0,,!لكن تمّ نقلهما فجأةً خارج البلاد
Dialogue: 0,0:05:40.63,0:05:42.63,Default,,0,0,0,,!غادرا بالأمس
Dialogue: 0,0:05:43.05,0:05:45.09,Default,,0,0,0,,!ماذا؟ وتركا كونان-كن؟
Dialogue: 0,0:05:45.39,0:05:49.88,Default,,0,0,0,,قالا أنّهما سيتّصلان بعدما يستقرّان
Dialogue: 0,0:05:50.88,0:05:54.05,Default,,0,0,0,,سنعتني بصبيّ عائلة أخرى مزيداً إذاً؟
Dialogue: 0,0:05:54.05,0:05:56.01,Default,,0,0,0,,ألا تشفق عليه؟
Dialogue: 0,0:05:56.01,0:05:57.56,Default,,0,0,0,,...لا مكان آخر ليذهب له كونان-كن
Dialogue: 0,0:05:58.14,0:06:01.17,Default,,0,0,0,,أي هجروك فعلياً
Dialogue: 0,0:06:01.17,0:06:02.84,Default,,0,0,0,,لا تحشر أنفك
Dialogue: 0,0:06:02.84,0:06:07.14,Default,,0,0,0,,إذا اتّصل والداه فسأطلب منهما تكاليف العناية به
Dialogue: 0,0:06:07.14,0:06:08.18,Default,,0,0,0,,...أنت
Dialogue: 0,0:06:08.85,0:06:12.34,Default,,0,0,0,,عُثر في الثامنة مساء اليوم على جثّة رجل
Dialogue: 0,0:06:12.34,0:06:17.10,Default,,0,0,0,,أسفل برج محترق في مهرجان أكاوني الناريّ
Dialogue: 0,0:06:17.43,0:06:19.39,Default,,0,0,0,,،وفقاً لممتلكاته الشخصية
Dialogue: 0,0:06:19.80,0:06:22.26,Default,,0,0,0,,فقد كانت الجثّة لنيغيشي ماساكي-كن، 42 عاماً
Dialogue: 0,0:06:22.84,0:06:23.72,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:06:24.18,0:06:26.51,Default,,0,0,0,,...ويتحرّون فيها كجريمة قتل مُحتملة
Dialogue: 0,0:06:26.51,0:06:29.47,Default,,0,0,0,,!إ-إنّه ذاك الرجل! لا شك
Dialogue: 0,0:06:30.30,0:06:32.93,Default,,0,0,0,,ما الخطب يا أبي؟ أتعرفه؟
Dialogue: 0,0:06:32.93,0:06:34.89,Default,,0,0,0,,،ليس ذلك فحسب
Dialogue: 0,0:06:34.89,0:06:37.93,Default,,0,0,0,,كنتُ معه لثلاثة أيام
Dialogue: 0,0:06:38.97,0:06:39.71,Default,,0,0,0,,!ثلاثة أيام؟
Dialogue: 0,0:06:39.71,0:06:40.92,Default,,0,0,0,,...أيمكن
Dialogue: 0,0:06:41.26,0:06:45.14,Default,,0,0,0,,أجل، إنّه الرجل الذي تبعته حتّى الأمس
Dialogue: 0,0:06:45.64,0:06:48.51,Default,,0,0,0,,!نيغيشي ماساكي
Dialogue: 0,0:06:54.55,0:06:58.47,Default,,0,0,0,,تأخّر أبي، قال أنّه سيدلي بشهادته سريعاً
Dialogue: 0,0:06:58.47,0:07:00.05,Default,,0,0,0,,لا عجب
Dialogue: 0,0:07:00.05,0:07:03.93,Default,,0,0,0,,فقد كان مع الضحيّة نيغيشي حتى الأمس
Dialogue: 0,0:07:04.18,0:07:07.76,Default,,0,0,0,,لا تحصل الشرطة على شهداء \Nثمينين هكذا كثيراً
Dialogue: 0,0:07:08.06,0:07:10.05,Default,,0,0,0,,أيّ قضيّة هي بالضبط يا ترى؟
Dialogue: 0,0:07:10.05,0:07:15.34,Default,,0,0,0,,!اخرج بسرعة يا عمّ وأخبرني\N!لا أستطيع الانتظار
Dialogue: 0,0:07:17.31,0:07:19.59,Default,,0,0,0,,أجل، فهمت
Dialogue: 0,0:07:19.59,0:07:21.42,Default,,0,0,0,,!نصف مليار ين؟
Dialogue: 0,0:07:21.72,0:07:25.55,Default,,0,0,0,,أجل، كان للمتُوفى نيغيشي-سان\Nوثيقة تأمين حياة
Dialogue: 0,0:07:25.55,0:07:27.47,Default,,0,0,0,,بقيمة نصف مليار ين
Dialogue: 0,0:07:27.47,0:07:29.18,Default,,0,0,0,,ألا تجد هذا غريباً؟
Dialogue: 0,0:07:29.18,0:07:32.17,Default,,0,0,0,,لمَ قد يعطي كلّ مال التأمين ذاك
Dialogue: 0,0:07:32.17,0:07:36.93,Default,,0,0,0,,!لمجرّد صديقٍ عاديّ مثلك يا آبي يوتاكا-سان؟
Dialogue: 0,0:07:37.56,0:07:42.72,Default,,0,0,0,,!كما أنّك من عيّنني وطلب مني تعقّبه
Dialogue: 0,0:07:42.72,0:07:45.76,Default,,0,0,0,,!لمَ قد يعطيك مال التأمين؟
Dialogue: 0,0:07:46.43,0:07:47.97,Default,,0,0,0,,كانت لعبة
Dialogue: 0,0:07:47.97,0:07:49.18,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:07:49.84,0:07:54.01,Default,,0,0,0,,كنا صديقين مُذ أيام الجامعة، ودامت علاقتنا 20 عاماً
Dialogue: 0,0:07:54.01,0:07:57.51,Default,,0,0,0,,...عندما ذهبنا للشرب في أحد الأيام، قال لي
Dialogue: 0,0:07:57.51,0:08:01.13,Default,,0,0,0,,نحن في الثانية والأربعين، لم نعد شبّاناً
Dialogue: 0,0:08:01.13,0:08:05.43,Default,,0,0,0,,أتريد الرهان على من سيعيش أطول بيننا؟
Dialogue: 0,0:08:05.43,0:08:07.14,Default,,0,0,0,,يبدو مُثيراً
Dialogue: 0,0:08:08.01,0:08:12.72,Default,,0,0,0,,ما رأيك بأن يكون مبلغ الرهان نصف مليار ين؟
Dialogue: 0,0:08:12.72,0:08:15.09,Default,,0,0,0,,وقبلتُ عرضه
Dialogue: 0,0:08:15.60,0:08:19.06,Default,,0,0,0,,لذا أمّنتما الاثنان على حياتكما بنصف مليار ينّ؟
Dialogue: 0,0:08:19.06,0:08:23.30,Default,,0,0,0,,لم يخطر لي أنّ الرهان سيدوم 3 أشهر فحسب
Dialogue: 0,0:08:23.30,0:08:26.26,Default,,0,0,0,,لمَ طلبت من موري-كن تعقّبه إذاً؟
Dialogue: 0,0:08:26.68,0:08:30.17,Default,,0,0,0,,لا سبب مهمّ حقاً
Dialogue: 0,0:08:30.17,0:08:32.84,Default,,0,0,0,,أخبرني مؤخراً أنّ هناك
Dialogue: 0,0:08:32.84,0:08:36.72,Default,,0,0,0,,من يستهدفه، وقد يُقتل قريباً
Dialogue: 0,0:08:36.72,0:08:38.43,Default,,0,0,0,,يُـ-يُقتل؟
Dialogue: 0,0:08:39.06,0:08:41.84,Default,,0,0,0,,ظننتها مزحة في البداية
Dialogue: 0,0:08:41.84,0:08:44.34,Default,,0,0,0,,لكنّه لم يكن يتصرف بطبيعية
Dialogue: 0,0:08:44.34,0:08:47.89,Default,,0,0,0,,فطلبتُ من موري-سان مراقبته لبضعة أيام\Nمن باب الاحتياط
Dialogue: 0,0:08:48.56,0:08:50.47,Default,,0,0,0,,أليس ذلك صحيحاً؟
Dialogue: 0,0:08:52.22,0:08:55.64,Default,,0,0,0,,إذاً، لديّ عمل لأنجزه
Dialogue: 0,0:08:55.64,0:08:59.31,Default,,0,0,0,,أدير شركةً صغيرة لذا أنا كثير الأشغال
Dialogue: 0,0:09:01.51,0:09:05.47,Default,,0,0,0,,جِدوا قاتل نيغيشي بأقرب وقت من فضلكم
Dialogue: 0,0:09:06.85,0:09:10.67,Default,,0,0,0,,سأتّصل بك فورما نفعل
Dialogue: 0,0:09:11.42,0:09:14.89,Default,,0,0,0,,أتطلّع لذلك أيّها المتحرّي العظيم
Dialogue: 0,0:09:19.06,0:09:22.84,Default,,0,0,0,,إنّه الوحيد الذي يبدو القاتل لي
Dialogue: 0,0:09:22.84,0:09:24.59,Default,,0,0,0,,لكن لديه حجّة غياب
Dialogue: 0,0:09:25.14,0:09:27.10,Default,,0,0,0,,واحدة مُطبقة
Dialogue: 0,0:09:29.63,0:09:34.14,Default,,0,0,0,,!مريب! هذا مريب حتماً\N!إنّه القاتل بلا شك
Dialogue: 0,0:09:34.80,0:09:36.14,Default,,0,0,0,,!نصف مليون ينّ
Dialogue: 0,0:09:36.14,0:09:39.06,Default,,0,0,0,,!لمجرد تعقّب شخص لثلاثة أيام
Dialogue: 0,0:09:39.06,0:09:40.84,Default,,0,0,0,,!هذا كثيرٌ جدّاً
Dialogue: 0,0:09:40.84,0:09:43.63,Default,,0,0,0,,!كما سلوكه الواثق
Dialogue: 0,0:09:43.63,0:09:46.01,Default,,0,0,0,,!يغيظني أكثر فأكثر
Dialogue: 0,0:09:46.01,0:09:48.72,Default,,0,0,0,,لمَ لا تعتقلوه إذاً؟
Dialogue: 0,0:09:48.72,0:09:51.01,Default,,0,0,0,,حجّة غيابه مطبقة
Dialogue: 0,0:09:51.01,0:09:56.68,Default,,0,0,0,,!كما كنتُ أنا شاهدها
Dialogue: 0,0:09:58.68,0:10:04.01,Default,,0,0,0,,عُثر على الجثّة ليلة الأحد أثناء المهرجان الناريّ
Dialogue: 0,0:10:04.01,0:10:07.35,Default,,0,0,0,,كنتُ أتعقّب الضحيّة طوال الوقت
Dialogue: 0,0:10:07.35,0:10:10.21,Default,,0,0,0,,حتّى الليلة السابقة
Dialogue: 0,0:10:10.67,0:10:14.01,Default,,0,0,0,,أي أنّ الجريمة وقعت
Dialogue: 0,0:10:14.01,0:10:17.51,Default,,0,0,0,,بين ليلة السبت ومساء الأحد
Dialogue: 0,0:10:17.51,0:10:19.18,Default,,0,0,0,,عندما أُشعِل برج النار
Dialogue: 0,0:10:19.51,0:10:24.39,Default,,0,0,0,,ارتكب الشخص الذي تشتبه به\Nالجريمة في تلك الفترة إذاً
Dialogue: 0,0:10:24.39,0:10:26.18,Default,,0,0,0,,لا يمكنه
Dialogue: 0,0:10:26.18,0:10:35.60,Default,,0,0,0,,،فقد كان في رحلة من صباح السبت إلى الاثنين\Nظهيرة اليوم في رحلة خاصة بشركته لكيوشو
Dialogue: 0,0:10:36.01,0:10:39.14,Default,,0,0,0,,لمَ تركّز عليه لهذا الحدّ إذاً؟
Dialogue: 0,0:10:39.14,0:10:43.51,Default,,0,0,0,,...حدس المتحرّي خاصّتي
Dialogue: 0,0:10:43.51,0:10:45.14,Default,,0,0,0,,فهمت
Dialogue: 0,0:10:45.76,0:10:47.43,Default,,0,0,0,,حجّة غيابه؟
Dialogue: 0,0:10:52.18,0:10:54.47,Title,,0,0,15,,{\fad(150,0)}بعد أسبوع
Dialogue: 0,0:10:54.47,0:10:55.60,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:10:56.39,0:10:58.06,Default,,0,0,0,,أبي، ما الخطب؟
Dialogue: 0,0:10:58.06,0:11:02.01,Default,,0,0,0,,!حصل ذاك الوغد آبي على مال تأمين نيغيشي-سان
Dialogue: 0,0:11:02.38,0:11:05.47,Default,,0,0,0,,!أخذ النصف مليار ينّ بكلّ بساطة
Dialogue: 0,0:11:05.47,0:11:09.18,Default,,0,0,0,,!سأطيح بحجّة غيابه مهما تطلّب الأمر
Dialogue: 0,0:11:10.59,0:11:11.92,Default,,0,0,0,,ما هذه؟
Dialogue: 0,0:11:12.34,0:11:16.10,Default,,0,0,0,,إنّها صور وجدول رحلته لكيوشو
Dialogue: 0,0:11:16.10,0:11:19.38,Default,,0,0,0,,طلبتُ من المفتّش ميغوري استعارتها
Dialogue: 0,0:11:19.38,0:11:22.47,Default,,0,0,0,,لا بدّ من وجود دليل بإحدى هذه الصور
Dialogue: 0,0:11:22.93,0:11:26.64,Default,,0,0,0,,انتظر وحسب! سيكشف المتحرّي العظيم\N...موري كوغورو-ساما
Dialogue: 0,0:11:26.64,0:11:29.42,Default,,0,0,0,,!حيلته
Dialogue: 0,0:11:29.42,0:11:32.01,Default,,0,0,0,,...أ-أبي يشتعل
Dialogue: 0,0:11:32.80,0:11:34.72,Default,,0,0,0,,لنأمل ألّا يحرق نفسه
Dialogue: 0,0:11:34.72,0:11:40.47,Default,,0,0,0,,لكن يا أبي، بما أنّ رحلته كانت داخل البلاد\Nأفلم يستطع العودة بوقت وجيز؟
Dialogue: 0,0:11:40.47,0:11:44.93,Default,,0,0,0,,ذلك ممكن بالفعل، لكن لا ثغرات في حجّة غيابه
Dialogue: 0,0:11:44.93,0:11:51.55,Default,,0,0,0,,،تحديداً أثناء وقت وقوع الجريمة المتوقّع\N ليلة السبت إلى مساء الأحد
Dialogue: 0,0:11:51.55,0:11:54.51,Default,,0,0,0,,فقد لعب الماجونع مع موظّفيه \Nطوال ليل السبت حتّى الصباح
Dialogue: 0,0:11:54.51,0:11:57.35,Default,,0,0,0,,وتجوّل بحافلة في المدينة ظهيرة الأحد
Dialogue: 0,0:11:57.35,0:11:59.46,Default,,0,0,0,,لديه صور لإثبات ذلك أيضاً
Dialogue: 0,0:12:00.80,0:12:02.09,Default,,0,0,0,,!هذه الصور
Dialogue: 0,0:12:02.88,0:12:08.68,Default,,0,0,0,,كان وحده عندما أخذ قيلولة ساعتين\Nظهيرة الأحد فقط
Dialogue: 0,0:12:08.68,0:12:14.01,Default,,0,0,0,,يستحيل أن يذهب لغونما حيث وُجِدت الجثّة\Nويرجع في ذاك الوقت القصير
Dialogue: 0,0:12:16.35,0:12:17.81,Default,,0,0,0,,ما المضحك؟
Dialogue: 0,0:12:17.81,0:12:19.67,Default,,0,0,0,,هذه الصور غريبة
Dialogue: 0,0:12:19.67,0:12:20.88,Default,,0,0,0,,غريبة؟
Dialogue: 0,0:12:20.88,0:12:22.97,Default,,0,0,0,,أمعن النظر
Dialogue: 0,0:12:22.97,0:12:26.80,Default,,0,0,0,,إنّه بجوار الساعة في جميع الصور
Dialogue: 0,0:12:26.80,0:12:28.06,Default,,0,0,0,,...بـ-بذكرك ذلك
Dialogue: 0,0:12:28.06,0:12:30.76,Default,,0,0,0,,لا بدّ أنّه يحب الساعات كثيراً
Dialogue: 0,0:12:31.17,0:12:32.68,Default,,0,0,0,,هذا ليس طبيعياً
Dialogue: 0,0:12:32.68,0:12:36.85,Default,,0,0,0,,كأنّه التقطها لإثبات حجّة غيابه
Dialogue: 0,0:12:36.85,0:12:39.30,Default,,0,0,0,,...والصبيّ محق
Dialogue: 0,0:12:39.30,0:12:40.47,Default,,0,0,0,,لحظة
Dialogue: 0,0:12:41.17,0:12:45.05,Default,,0,0,0,,كان الوضع هكذا سابقاً أيضاً، كلما ارتطم استنتاجي بعقبة
Dialogue: 0,0:12:45.05,0:12:47.89,Default,,0,0,0,,يمدُّني بتلميح
Dialogue: 0,0:12:52.80,0:12:54.26,Default,,0,0,0,,ما بهذا المظروف؟
Dialogue: 0,0:12:54.59,0:12:55.72,Default,,0,0,0,,...إنّها
Dialogue: 0,0:12:57.06,0:12:58.89,Default,,0,0,0,,...صور تعقّبي
Dialogue: 0,0:12:59.14,0:13:00.34,Default,,0,0,0,,!تبّاً! اختلطت
Dialogue: 0,0:13:00.34,0:13:04.59,Default,,0,0,0,,!للرجل المقتول
Dialogue: 0,0:13:04.84,0:13:06.22,Default,,0,0,0,,!أبي
Dialogue: 0,0:13:08.01,0:13:09.96,Default,,0,0,0,,أأنت بخير يا كونان-كن؟
Dialogue: 0,0:13:09.96,0:13:12.43,Default,,0,0,0,,!طِر يا ألم
Dialogue: 0,0:13:12.43,0:13:14.18,Default,,0,0,0,,بربّك
Dialogue: 0,0:13:15.14,0:13:17.39,Default,,0,0,0,,يبقى مجرّد طفل
Dialogue: 0,0:13:21.63,0:13:25.93,Default,,0,0,0,,أخبرني يا أبي، أأنت متأكّد\Nأنّ هذا الرجل من قُتل؟
Dialogue: 0,0:13:25.93,0:13:27.18,Default,,0,0,0,,فقد كانت جثته محترقة
Dialogue: 0,0:13:27.85,0:13:30.01,Default,,0,0,0,,أجل، كان هو بلا شكّ
Dialogue: 0,0:13:30.01,0:13:32.84,Default,,0,0,0,,فرخصة قيادته كانت بجوار برج النار \Nحيث كانت جثّته
Dialogue: 0,0:13:33.68,0:13:36.14,Default,,0,0,0,,في المهرجان الناريّ
Dialogue: 0,0:13:37.64,0:13:40.88,Default,,0,0,0,,طابقت أسنانه السجّلات الطبيّة أيضاً
Dialogue: 0,0:13:42.38,0:13:43.51,Default,,0,0,0,,غريب
Dialogue: 0,0:13:43.51,0:13:46.47,Default,,0,0,0,,يُخفي المجرمون جرائمهم عادةً
Dialogue: 0,0:13:47.35,0:13:50.13,Default,,0,0,0,,إخفاء الجثّة في البرج حيث سيكتشفها الجميع
Dialogue: 0,0:13:50.67,0:13:55.76,Default,,0,0,0,,!وترك دليل لهويّة الضحية بالقرب به تدبير كبير
Dialogue: 0,0:13:56.60,0:13:59.71,Default,,0,0,0,,هناك شخص واحد سيستفيد من اكتشاف الجثّة
Dialogue: 0,0:13:59.71,0:14:03.05,Default,,0,0,0,,آبي الذي سيحصل على مال التأمين
Dialogue: 0,0:14:03.05,0:14:05.76,Default,,0,0,0,,العمّ على حق، إنّه الفاعل الوحيد المُحتمل
Dialogue: 0,0:14:06.35,0:14:09.59,Default,,0,0,0,,لكن لديه حجّة غياب مطبقة
Dialogue: 0,0:14:10.38,0:14:15.55,Default,,0,0,0,,...كلا، لا بدّ من وجود شيء\Nخيط يقودنا للإطاحة بحجّته
Dialogue: 0,0:14:21.67,0:14:23.72,Default,,0,0,0,,...هـ-هذه
Dialogue: 0,0:14:28.44,0:14:29.51,Default,,0,0,0,,هذه الصورة
Dialogue: 0,0:14:31.89,0:14:35.39,Default,,0,0,0,,...غريب، نيغيشي-سان الذي رأيتُه
Dialogue: 0,0:14:36.23,0:14:37.44,Default,,0,0,0,,!كان يستخدم يده اليمنى
Dialogue: 0,0:14:39.06,0:14:40.26,Default,,0,0,0,,!أيمكن؟
Dialogue: 0,0:14:44.02,0:14:45.14,Default,,0,0,0,,كونان-كن؟
Dialogue: 0,0:14:48.77,0:14:50.39,Default,,0,0,0,,!كما ظننت
Dialogue: 0,0:14:50.93,0:14:53.09,Default,,0,0,0,,هذه من الخميس والجمعة
Dialogue: 0,0:14:53.72,0:14:55.81,Default,,0,0,0,,!وهذه من السبت
Dialogue: 0,0:14:56.52,0:14:59.76,Default,,0,0,0,,تعقّب العمّ الضحيّة نيغيشي-سان
Dialogue: 0,0:14:59.76,0:15:02.01,Default,,0,0,0,,من الخميس للسبت، أي ثلاثة أيام
Dialogue: 0,0:15:02.01,0:15:05.81,Default,,0,0,0,,عُثر على جثّته ليلة الأحد
Dialogue: 0,0:15:05.81,0:15:11.01,Default,,0,0,0,,فلا بدّ أن الجريمة وقعت بين ليلة السبت ومساء الأحد
Dialogue: 0,0:15:11.51,0:15:13.47,Default,,0,0,0,,،لكنّ المُشتبه به، آبي يوتاكا
Dialogue: 0,0:15:13.47,0:15:18.40,Default,,0,0,0,,كان في كيوشو من صباح السبت إلى ظهيرة الإثنين
Dialogue: 0,0:15:18.40,0:15:20.43,Default,,0,0,0,,!حجّة غيابه تامة
Dialogue: 0,0:15:20.85,0:15:24.73,Default,,0,0,0,,...لكن إذا أصابت نظريتي، فهي
Dialogue: 0,0:15:27.56,0:15:30.35,Default,,0,0,0,,!يكفي يا طفل
Dialogue: 0,0:15:31.18,0:15:34.18,Default,,0,0,0,,يسبب متاعب حالما أزيح بناظري عنه
Dialogue: 0,0:15:34.18,0:15:38.52,Default,,0,0,0,,!لا تضرب كونان-كن فقط لأنّك تعجز عن حلِّ القضيّة
Dialogue: 0,0:15:38.94,0:15:41.43,Default,,0,0,0,,!المجرم هو آبي يوتاكا بلا شك
Dialogue: 0,0:15:41.43,0:15:42.97,Default,,0,0,0,,!لديه دافع أيضاً
Dialogue: 0,0:15:43.60,0:15:44.43,Default,,0,0,0,,دافع؟
Dialogue: 0,0:15:45.02,0:15:48.60,Default,,0,0,0,,كانت شركته تقع تحت دين 300 مليون ينّ
Dialogue: 0,0:15:48.60,0:15:53.06,Default,,0,0,0,,استعمل مال التأمين لدفعه
Dialogue: 0,0:15:53.06,0:15:57.39,Default,,0,0,0,,!ويخطّط للهرب بالمئتي مليون المتبقيّة خارج البلاد
Dialogue: 0,0:15:57.39,0:15:58.73,Default,,0,0,0,,خارج البلاد؟
Dialogue: 0,0:15:59.05,0:16:02.93,Default,,0,0,0,,نقل إدارة الشركة لشخص آخر\Nوقال أنّه سيذهب في رحلة لفترة
Dialogue: 0,0:16:03.22,0:16:07.14,Default,,0,0,0,,!وتُقلع طائرته التاسعة هذه الليلة
Dialogue: 0,0:16:07.56,0:16:11.14,Default,,0,0,0,,!التاسعة؟! بقيت ثلاث ساعات فقط
Dialogue: 0,0:16:11.56,0:16:13.85,Default,,0,0,0,,!سيتعقّد الأمر إذا تركناه يغادر البلاد
Dialogue: 0,0:16:14.22,0:16:17.81,Default,,0,0,0,,!لا أمامي سوى محاصرته الآن وإجباره على الاعتراف
Dialogue: 0,0:16:19.05,0:16:23.77,Default,,0,0,0,,لا وقت لديّ، عليّ توجيههم للمطار
Dialogue: 0,0:16:23.77,0:16:26.51,Default,,0,0,0,,حسنٌ، سأستعمل تلك الطريقة
Dialogue: 0,0:16:27.10,0:16:32.77,Default,,0,0,0,,ماذا؟! أطحتَ بحجّة غياب آبي؟\N!أحقّاً هذا سيّدي المفتّش؟
Dialogue: 0,0:16:32.77,0:16:35.43,Default,,0,0,0,,أجل، أنا في طريقي للمطار
Dialogue: 0,0:16:36.27,0:16:39.89,Default,,0,0,0,,أريدك أن تأتي أيضاً، أيمكنك القدوم سريعاً؟
Dialogue: 0,0:16:39.89,0:16:43.10,Default,,0,0,0,,ممتاز، سأنتظرك هناك
Dialogue: 0,0:16:44.93,0:16:48.31,Default,,0,0,0,,...حسنٌ، الآن أستعمل صوت العمّ
Dialogue: 0,0:16:52.51,0:16:56.69,Default,,0,0,0,,!مرحباً مفتّش ميغوري! أنا موري كوغورو
Dialogue: 0,0:16:57.19,0:16:59.80,Title,,0,0,15,,{\fad(200,0)}مطار طوكيو الدوليّ الجديد
Dialogue: 0,0:17:00.22,0:17:03.26,Default,,0,0,0,,!اسمعا! لا تعترضا العمل
Dialogue: 0,0:17:03.26,0:17:04.77,Default,,0,0,0,,!حاضر
Dialogue: 0,0:17:04.77,0:17:08.47,Default,,0,0,0,,يا إلهي، ترافقاني كلّ مرة
Dialogue: 0,0:17:09.05,0:17:11.18,Default,,0,0,0,,المكان مكتظّ حقاً
Dialogue: 0,0:17:11.18,0:17:13.93,Default,,0,0,0,,سيكون إيجاد المفتّش صعباً
Dialogue: 0,0:17:14.27,0:17:16.94,Default,,0,0,0,,أيّ رحلة هي رحلة آبي؟
Dialogue: 0,0:17:16.94,0:17:18.64,Default,,0,0,0,,...أظنّها كانت
Dialogue: 0,0:17:19.01,0:17:23.06,Default,,0,0,0,,...تبّاً، وقت صعود الطائرة قريب
Dialogue: 0,0:17:23.06,0:17:26.60,Default,,0,0,0,,لا خيار أمامي، هذا خطرٌ قليلاً لكن عليّ استدراجه
Dialogue: 0,0:17:29.80,0:17:36.35,Default,,0,0,0,,نداء لأحد الركّاب \N...إلى آبي يوتاكا-ساما المتوجه إلى سياتل
Dialogue: 0,0:17:36.35,0:17:38.56,Default,,0,0,0,,على متن الرحلة رقم 99
Dialogue: 0,0:17:38.56,0:17:43.18,Default,,0,0,0,,ينتظرك نيغيشي ماساكي-ساما\Nعند موقف السيّارات الأمامي
Dialogue: 0,0:17:43.81,0:17:48.27,Default,,0,0,0,,أعيد، نداء لأحد الركّاب إلى آبي يوتاكا-ساما المتوجه إلى سياتل
Dialogue: 0,0:17:48.27,0:17:50.89,Default,,0,0,0,,على متن الرحلة رقم 99
Dialogue: 0,0:17:50.89,0:17:53.52,Default,,0,0,0,,ما الذي يجري يا أبي؟
Dialogue: 0,0:17:53.52,0:17:55.51,Default,,0,0,0,,
Dialogue: 0,0:17:56.02,0:17:57.60,Default,,0,0,0,,!مفتّش ميغوري
Dialogue: 0,0:17:57.60,0:17:59.85,Default,,0,0,0,,أعتذر على التأخير
Dialogue: 0,0:17:59.85,0:18:05.56,Default,,0,0,0,,لا يهم، أخبرني كيف أطحت بحجّة \Nغياب آبي أيّها المفتّش؟
Dialogue: 0,0:18:06.02,0:18:08.90,Default,,0,0,0,,قلت أنّك تمكنت من ذلك
Dialogue: 0,0:18:10.05,0:18:12.35,Default,,0,0,0,,ماذا؟ أين ذهب كونان-كن؟
Dialogue: 0,0:18:17.56,0:18:19.97,Default,,0,0,0,,كان ذلك ماكراً يا عمّ
Dialogue: 0,0:18:19.97,0:18:21.64,Default,,0,0,0,,مـ-من هناك؟
Dialogue: 0,0:18:21.64,0:18:26.27,Default,,0,0,0,,مات نيغيشي-سان ليلة الجمعة في الواقع، أليس كذلك؟
Dialogue: 0,0:18:26.27,0:18:30.55,Default,,0,0,0,,أجل، في اليوم السابق لرحلتك
Dialogue: 0,0:18:31.01,0:18:36.60,Default,,0,0,0,,ثمّ جعلت المتحرّي موري يتبع\Nبديلاً شبيهاً بنيغيشي-سان اليوم التالي
Dialogue: 0,0:18:36.60,0:18:38.44,Default,,0,0,0,,أين أنت؟
Dialogue: 0,0:18:38.44,0:18:41.76,Default,,0,0,0,,كي توهمنا أنّه كان حيّاً حتى السبت
Dialogue: 0,0:18:42.22,0:18:46.81,Default,,0,0,0,,...تحققتَ من تاريخ المهرجان سلفاً، وكما خططت له
Dialogue: 0,0:18:46.81,0:18:49.89,Default,,0,0,0,,اُكتشفت الجثّة ليلة الأحد
Dialogue: 0,0:18:49.89,0:18:53.31,Default,,0,0,0,,،مع استحالة تحديد وقت الوفاة الدقيق لاحتراق الجثّة
Dialogue: 0,0:18:53.31,0:18:56.27,Default,,0,0,0,,حصرت شهادة المتحرّي موري
Dialogue: 0,0:18:56.27,0:19:00.26,Default,,0,0,0,,موت الضحيّة بين ليلة السبت ومساء الأحد
Dialogue: 0,0:19:00.26,0:19:01.56,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:19:01.56,0:19:05.64,Default,,0,0,0,,ثمّ رجعتَ ظهيرة الإثنين كما لو لم يحصل شيء
Dialogue: 0,0:19:06.23,0:19:08.35,Default,,0,0,0,,هكذا تشكّلت حجّة غيابك
Dialogue: 0,0:19:09.93,0:19:11.17,Default,,0,0,0,,ما رأيك؟ هل أصبت؟
Dialogue: 0,0:19:11.17,0:19:12.88,Default,,0,0,0,,!طـ-طفل؟
Dialogue: 0,0:19:13.52,0:19:17.48,Default,,0,0,0,,سمعتُ شرطيّاً كان هنا يتكلم في القضيّة
Dialogue: 0,0:19:17.48,0:19:20.55,Default,,0,0,0,,وحاولتُ إضافة استنتاجي الخاص
Dialogue: 0,0:19:21.51,0:19:24.64,Default,,0,0,0,,كانت غلطتك هي البديل الذي اخترته لنيغيشي-سان
Dialogue: 0,0:19:25.43,0:19:28.06,Default,,0,0,0,,لعلّك نجحت في خداع المتحرّي
Dialogue: 0,0:19:28.06,0:19:30.47,Default,,0,0,0,,لكنك لن تخدع الكاميرا
Dialogue: 0,0:19:30.47,0:19:34.35,Default,,0,0,0,,فقد كان المزيّف أعسراً بخلاف نيغيشي-سان
Dialogue: 0,0:19:34.89,0:19:38.02,Default,,0,0,0,,استسلم، المكان يعجّ بالشرطة
Dialogue: 0,0:19:45.73,0:19:49.09,Default,,0,0,0,,أحسنتَ يا ولد، استنتاج مُبهر
Dialogue: 0,0:19:49.09,0:19:54.43,Default,,0,0,0,,كنتُ أنا آبي يوتاكا من قتل نيغيشي ماساكي بالفعل
Dialogue: 0,0:19:54.43,0:19:58.40,Default,,0,0,0,,لكنّي لن أسلّم نفسي، فسأعيش بهناء خارج البلاد
Dialogue: 0,0:19:59.51,0:20:03.84,Default,,0,0,0,,ماذا؟ لكنّي سأخبر الجميع أنّك اعترفت
Dialogue: 0,0:20:05.14,0:20:09.60,Default,,0,0,0,,لن يصدّق أحد كلام طفل
Dialogue: 0,0:20:09.60,0:20:14.89,Default,,0,0,0,,قد يصدقون كلماتك
Dialogue: 0,0:20:14.89,0:20:18.44,Default,,0,0,0,,كنتُ أنا آبي يوتاكا من قتل نيغيشي ماساكي بالفعل
Dialogue: 0,0:20:20.72,0:20:22.10,Default,,0,0,0,,!أنت
Dialogue: 0,0:20:22.39,0:20:24.48,Default,,0,0,0,,!كيف لك أن تفهم مشاعري؟
Dialogue: 0,0:20:24.73,0:20:28.47,Default,,0,0,0,,!رئيس شركة على حافّة الإفلاس؟
Dialogue: 0,0:20:39.39,0:20:41.38,Default,,0,0,0,,!اللوم عليه هو
Dialogue: 0,0:20:51.51,0:20:55.89,Default,,0,0,0,,كان غبيّاً ما يكفي لقبول عرضي وتوقيع \N!وثيقة التأمين الكبيرة تلك دون تردد
Dialogue: 0,0:20:56.56,0:20:59.18,Default,,0,0,0,,!لم يعلم أنّي سأقتله أبداً
Dialogue: 0,0:20:56.56,0:20:59.18,Default,,0,0,0,,!أنت الغبي
Dialogue: 0,0:20:59.64,0:21:02.43,Default,,0,0,0,,!كنت سأدعك تذهب لو أنك سلمت نفسك
Dialogue: 0,0:21:02.77,0:21:04.39,Default,,0,0,0,,!لكنك تماديت كثيراً الآن
Dialogue: 0,0:21:08.43,0:21:11.89,Default,,0,0,0,,!سأسحق رأسك العفن هذا
Dialogue: 0,0:21:32.01,0:21:33.43,Default,,0,0,0,,ما-ما هذا؟
Dialogue: 0,0:21:33.43,0:21:38.93,Default,,0,0,0,,كنتُ أنا آبي يوتاكا من قتل نيغيشي ماساكي بالفعل
Dialogue: 0,0:21:40.22,0:21:42.93,Default,,0,0,0,,من فعل هذا؟
Dialogue: 0,0:23:21.39,0:23:24.85,Default,,0,0,0,,إنّه وغد حقير لاستغلالي في حجّة غيابه
Dialogue: 0,0:23:25.43,0:23:29.54,Default,,0,0,0,,لكن من الرائع أنّهم وجدوا بديل نيغيشي-سان
Dialogue: 0,0:23:29.54,0:23:32.91,Default,,0,0,0,,أجل، يبدو أنّ آبي طلب منه التجوّل طوال اليوم
Dialogue: 0,0:23:32.91,0:23:34.93,Default,,0,0,0,,ولم يعلم التفاصيل
Dialogue: 0,0:23:35.58,0:23:40.38,Default,,0,0,0,,...ما يضايقني هو ما قاله آبي بعدها
Dialogue: 0,0:23:40.93,0:23:44.43,Default,,0,0,0,,!كـ-كان الطفل! هو من غلبني
Dialogue: 0,0:23:45.02,0:23:47.47,Default,,0,0,0,,...الطفل في الأرجاء وقتها
Dialogue: 0,0:23:54.87,0:23:57.73,Default,,0,0,0,,التظاهر بأنّك طفل ليس أمراً سهلاً
Dialogue: 0,0:24:06.55,0:24:08.40,On Top,,0,0,0,,ران بمفردها الآن إذاً؟
Dialogue: 0,0:24:08.89,0:24:10.47,On Top,,0,0,0,,صوت ماء؟
Dialogue: 0,0:24:17.86,0:24:19.21,On Top,,0,0,0,,!ران
Dialogue: 0,0:24:19.76,0:24:23.93,On Top,,0,0,0,,يعني أنّها قد تكون جرائم قتل عشوائية
Dialogue: 0,0:24:24.57,0:24:26.06,Default,,0,0,0,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.06,0:24:29.53,Default,,0,0,0,,جريمة قتل الابنة الثريّة\N(الجزء الأوّل)
Dialogue: 0,0:24:45.25,0:24:48.50,Default,,0,0,0,,تلميح... تلميح الحلقة القادمة
Dialogue: 0,0:24:48.50,0:24:49.97,Default,,0,0,0,,انقطاع كهرباء

