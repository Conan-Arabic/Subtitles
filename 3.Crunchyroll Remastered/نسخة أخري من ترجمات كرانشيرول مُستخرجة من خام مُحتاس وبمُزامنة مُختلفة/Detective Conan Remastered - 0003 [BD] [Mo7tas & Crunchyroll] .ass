Dialogue: 0,0:00:01.54,0:00:03.19,Default,,0000,0000,0000,,اسمي كودو شينتشي
Dialogue: 0,0:00:03.19,0:00:05.61,Default,,0000,0000,0000,,!مُتحرٍّ في الثانوية مشهور في أرجاء البلاد
Dialogue: 0,0:00:05.61,0:00:07.62,Default,,0000,0000,0000,,...لكن أجبرتني منظمة ما على تجرّع سمٍّ غريب
Dialogue: 0,0:00:07.62,0:00:09.11,Default,,0000,0000,0000,,!وأصبحت إيدوغاوا كونان
Dialogue: 0,0:00:09.11,0:00:10.47,Default,,0000,0000,0000,,!لا يهم صغر بنيتي
Dialogue: 0,0:00:10.47,0:00:11.98,Default,,0000,0000,0000,,!فدماغي ذاك لمُتحرٍّ في السابعة عشر
Dialogue: 0,0:00:11.98,0:00:14.57,Default,,0000,0000,0000,,!يمكنني حلّ قضايا تستعصي على البالغين حتّى
Dialogue: 0,0:01:47.10,0:01:52.94,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل خلف أبواب مغلقة لشقّة الفنّانة
Dialogue: 0,0:01:48.22,0:01:50.89,Default,,0000,0000,0000,,جريمة قتل خلف أبواب مغلقة لشقّة الفنّانة
Dialogue: 0,0:01:58.54,0:02:00.88,Default,,0000,0000,0000,,مضت 3 أيّام مُذ تقلّص جسدي
Dialogue: 0,0:02:03.09,0:02:07.43,Default,,0000,0000,0000,,لم تظهر أيّ معلومات عن الرجال\Nبالرداء الأسود بعد
Dialogue: 0,0:02:14.66,0:02:16.55,Default,,0000,0000,0000,,...لكن مع مُتحرّ مثله
Dialogue: 0,0:02:17.70,0:02:21.46,Default,,0000,0000,0000,,،لن يطلب أحد خدماته في الأصل\Nفكيف يتلقى معلومات عنهم؟
Dialogue: 0,0:02:22.52,0:02:25.30,Default,,0000,0000,0000,,!يوكو-تشان، ظريفة جدّاً
Dialogue: 0,0:02:25.30,0:02:26.65,Default,,0000,0000,0000,,!هيّا، هيّا، هيّا بنا
Dialogue: 0,0:02:26.65,0:02:28.76,Default,,0000,0000,0000,,لا يسمح لك عمرك بالتصرف هكذا
Dialogue: 0,0:02:28.76,0:02:31.10,Default,,0000,0000,0000,,أنت أفضل مثال للرجل اليائس
Dialogue: 0,0:02:32.26,0:02:34.22,On Top,,0000,0000,0000,,مدرسة تيتان الابتدائية
Dialogue: 0,0:02:32.85,0:02:34.22,Default,,0000,0000,0000,,اثنان ضرب اثنان يساوي 4
Dialogue: 0,0:02:34.22,0:02:35.89,Default,,0000,0000,0000,,اثنان ضرب ثلاثة يساوي 6
Dialogue: 0,0:02:35.89,0:02:37.35,Default,,0000,0000,0000,,اثنان ضرب أربعة يساوي 8
Dialogue: 0,0:02:37.35,0:02:39.21,Default,,0000,0000,0000,,...لا أستطيع الاحتمال
Dialogue: 0,0:02:39.63,0:02:42.13,Default,,0000,0000,0000,,!لنعد للبيت معاً يا كونان-كن
Dialogue: 0,0:02:43.37,0:02:45.70,Default,,0000,0000,0000,,لا بدّ أنك تشعر بالوحدة لانتقالك حديثاً
Dialogue: 0,0:02:45.70,0:02:48.09,Default,,0000,0000,0000,,!لذا سنكون أصدقاءك
Dialogue: 0,0:02:48.61,0:02:51.19,Default,,0000,0000,0000,,...كلا، لستُ حقّاً
Dialogue: 0,0:02:51.19,0:02:53.05,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:02:53.78,0:02:55.97,Default,,0000,0000,0000,,!أترفض كلام أيومي-تشان
Dialogue: 0,0:02:56.53,0:02:58.92,Default,,0000,0000,0000,,العنف ليس حسناً يا غينتا-كن
Dialogue: 0,0:02:59.39,0:03:01.81,Default,,0000,0000,0000,,!اخرس! لديك مشكلة معي يا ميتسوهيكو؟
Dialogue: 0,0:03:01.81,0:03:03.56,Default,,0000,0000,0000,,!توقف يا غينتا-كن
Dialogue: 0,0:03:03.56,0:03:05.43,Default,,0000,0000,0000,,!أنا مشغول لذا سأذهب
Dialogue: 0,0:03:05.43,0:03:06.78,Default,,0000,0000,0000,,!انتظر يا كونان-كن
Dialogue: 0,0:03:07.92,0:03:09.30,Default,,0000,0000,0000,,تبّاً
Dialogue: 0,0:03:10.17,0:03:13.80,Default,,0000,0000,0000,,لن أجد الرجال بالرداء الأسود على هذا النحو أبداً
Dialogue: 0,0:03:13.80,0:03:15.51,Default,,0000,0000,0000,,تحلَّ بالصبر يا شينتشي
Dialogue: 0,0:03:15.51,0:03:17.47,Default,,0000,0000,0000,,فكّر بما سيحصل إن استعجلت
Dialogue: 0,0:03:17.47,0:03:19.66,Default,,0000,0000,0000,,وعرفوا أنّك كودو شينتشي حقّاً
Dialogue: 0,0:03:19.66,0:03:20.83,Default,,0000,0000,0000,,أفهم ذلك
Dialogue: 0,0:03:20.83,0:03:23.47,Default,,0000,0000,0000,,،سيكون جميع من حولي في خطر\Nليس أنا فقط
Dialogue: 0,0:03:24.08,0:03:26.91,Default,,0000,0000,0000,,بالمناسبة، أتت ران-كن بالأمس
Dialogue: 0,0:03:26.91,0:03:27.43,Default,,0000,0000,0000,,ران؟
Dialogue: 0,0:03:27.75,0:03:30.28,Default,,0000,0000,0000,,لم يأت شينتشي للمدرسة مُجدداً اليوم
Dialogue: 0,0:03:30.28,0:03:31.84,Default,,0000,0000,0000,,ولا يبدو أنّه عاد لمنزله أيضاً
Dialogue: 0,0:03:32.86,0:03:33.80,Default,,0000,0000,0000,,...سأتّصل بالشرطة
Dialogue: 0,0:03:33.34,0:03:34.53,Default,,0000,0000,0000,,!انتظري
Dialogue: 0,0:03:34.53,0:03:37.75,Default,,0000,0000,0000,,أنا متأكد أنّه يعمل على إحدى\Nقضاياه الغريبة فقط
Dialogue: 0,0:03:38.10,0:03:41.73,Default,,0000,0000,0000,,،لا تقلقي، سيعود في أقرب فرصة\Nأنا على يقين
Dialogue: 0,0:03:43.10,0:03:48.67,Default,,0000,0000,0000,,أقنعتُها في الوقت الراهن، لكن إلى متى\Nيمكننا مواصلة هذا؟
Dialogue: 0,0:03:49.09,0:03:49.70,Default,,0000,0000,0000,,...ران
Dialogue: 0,0:03:51.05,0:03:51.88,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:04:00.75,0:04:03.71,Default,,0000,0000,0000,,صنعتُ شيئاً سيفيدك في قضاياك
Dialogue: 0,0:04:04.33,0:04:06.72,Default,,0000,0000,0000,,!إنّها ربطة العنق المعدّلة للصوت
Dialogue: 0,0:04:07.95,0:04:08.67,Default,,0000,0000,0000,,معدّلة للصوت؟
Dialogue: 0,0:04:09.24,0:04:12.63,Default,,0000,0000,0000,,أدر القرص في الخلف وستتمكن \Nمن إصدار مختلف الأصوات
Dialogue: 0,0:04:13.45,0:04:17.10,Default,,0000,0000,0000,,صوت رجل مُسن، طفل، رجل بالغ\Nوحتّى امرأة
Dialogue: 0,0:04:17.45,0:04:19.69,Default,,0000,0000,0000,,سيفيدك في وقت ما حتماً
Dialogue: 0,0:04:24.23,0:04:27.96,Default,,0000,0000,0000,,لا أظن سأستعمله كثيراً في وكالة التحرّي تلك
Dialogue: 0,0:04:29.84,0:04:31.92,Default,,0000,0000,0000,,!ذاك منزل كونان-كن إذاً
Dialogue: 0,0:04:32.51,0:04:35.80,Default,,0000,0000,0000,,!لا خيار لدينا، سنجبره ليصبح صديقنا
Dialogue: 0,0:04:49.74,0:04:50.55,Default,,0000,0000,0000,,...إنّها
Dialogue: 0,0:04:53.53,0:04:56.95,Default,,0000,0000,0000,,،وكالة موري للتحري مغلقة اليوم\N...إن كان لديك طلب عمل
Dialogue: 0,0:04:58.81,0:05:00.92,Default,,0000,0000,0000,,...فعد... غداً
Dialogue: 0,0:05:01.56,0:05:02.76,Default,,0000,0000,0000,,!أنت... أيمكن
Dialogue: 0,0:05:03.63,0:05:05.81,Default,,0000,0000,0000,,!أوكينو يوكو
Dialogue: 0,0:05:05.81,0:05:06.22,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:05:06.22,0:05:09.05,Default,,0000,0000,0000,,لا يمكن! لمَ قد تأتي فنّانة شهيرة هنا؟
Dialogue: 0,0:05:09.05,0:05:10.43,Default,,0000,0000,0000,,...أريد طلب خدمتك في الواقع
Dialogue: 0,0:05:16.68,0:05:19.30,Default,,0000,0000,0000,,يبدو أنّ هناك أمراً يضايقك سيّدتي
Dialogue: 0,0:05:19.75,0:05:20.92,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:05:20.92,0:05:22.76,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:05:23.42,0:05:24.72,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:05:25.25,0:05:26.68,Default,,0000,0000,0000,,يتجسّس أحدهم عليك؟
Dialogue: 0,0:05:27.09,0:05:30.66,Default,,0000,0000,0000,,أجد الأثاث في غير مكانه عند عودتي للبيت
Dialogue: 0,0:05:30.66,0:05:33.65,Default,,0000,0000,0000,,وأستلم صوراً مُلتقطة خلسة من أحدهم
Dialogue: 0,0:05:33.65,0:05:35.59,Default,,0000,0000,0000,,!بالإضافة إلى اتّصالات مجهولة يومياً
Dialogue: 0,0:05:36.33,0:05:38.48,Default,,0000,0000,0000,,!كيف يجرؤ الوغد؟
Dialogue: 0,0:05:38.48,0:05:40.55,Default,,0000,0000,0000,,نريدك أن تتحرى بهدوءٍ لو أمكن
Dialogue: 0,0:05:41.65,0:05:42.47,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:05:42.47,0:05:45.43,Default,,0000,0000,0000,,أنا مديرها، اسمي ياماغيشي
Dialogue: 0,0:05:46.90,0:05:47.88,Default,,0000,0000,0000,,مديرها؟
Dialogue: 0,0:05:48.56,0:05:50.84,Default,,0000,0000,0000,,حسناً، سأتحرّى بكتمان قدر المستطاع
Dialogue: 0,0:05:51.72,0:05:53.81,Default,,0000,0000,0000,,دوّني عنوانك ورقم هاتفك هنا من فضلك
Dialogue: 0,0:05:53.81,0:05:54.45,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:55.10,0:05:58.00,Default,,0000,0000,0000,,...كما توقيعك هنا لو أمكن
Dialogue: 0,0:05:58.00,0:05:58.54,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:59.80,0:06:01.51,Default,,0000,0000,0000,,"لا تنسي كتابة "إلى كوغورو-سان
Dialogue: 0,0:06:03.42,0:06:06.17,Default,,0000,0000,0000,,بما أنّ القضية بيد المتحرّي العظيم موري كوغورو الآن
Dialogue: 0,0:06:06.17,0:06:06.97,Default,,0000,0000,0000,,!لا شيء لتخافيه
Dialogue: 0,0:06:07.42,0:06:08.74,Default,,0000,0000,0000,,أيمكننا مرافقتكم؟
Dialogue: 0,0:06:08.74,0:06:11.54,Default,,0000,0000,0000,,لطالما أردتُ رؤية منزل فنّان شهير
Dialogue: 0,0:06:11.54,0:06:13.37,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:06:13.37,0:06:14.29,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:14.29,0:06:16.97,Default,,0000,0000,0000,,إيّاكما واعتراض العمل، مفهوم؟
Dialogue: 0,0:06:16.97,0:06:17.88,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:06:21.11,0:06:22.84,Default,,0000,0000,0000,,!هنا إذاً؟
Dialogue: 0,0:06:23.23,0:06:25.44,Default,,0000,0000,0000,,!مسكن يليق بأوكينو يوكو-سان حقّاً
Dialogue: 0,0:06:25.44,0:06:26.78,Default,,0000,0000,0000,,!لا ترفع صوتك
Dialogue: 0,0:06:26.78,0:06:28.80,Default,,0000,0000,0000,,يُفترض أن تكون إقامتها هنا سرّاً
Dialogue: 0,0:06:32.02,0:06:35.10,Default,,0000,0000,0000,,الطابق 25 إذاً؟
Dialogue: 0,0:06:35.10,0:06:37.39,Default,,0000,0000,0000,,!يوكو-تشان دون سواها! مذهل
Dialogue: 0,0:06:37.39,0:06:40.05,Default,,0000,0000,0000,,علينا أن نجعل كونان-كن صديقنا\N!مهما كلّف الأمر
Dialogue: 0,0:06:40.05,0:06:40.71,Default,,0000,0000,0000,,أتفق
Dialogue: 0,0:06:41.38,0:06:42.63,Default,,0000,0000,0000,,جميل
Dialogue: 0,0:06:45.93,0:06:47.44,Default,,0000,0000,0000,,تفضّلوا بالدخول
Dialogue: 0,0:06:51.17,0:06:52.14,Default,,0000,0000,0000,,ما الخطب يا يوكو؟
Dialogue: 0,0:06:55.84,0:06:56.81,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:06:58.06,0:06:59.27,Default,,0000,0000,0000,,...إنّه
Dialogue: 0,0:07:10.90,0:07:13.53,Default,,0000,0000,0000,,أأنتم بخير؟
Dialogue: 0,0:07:13.53,0:07:14.18,Default,,0000,0000,0000,,يا إلهي
Dialogue: 0,0:07:14.18,0:07:14.93,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:07:15.82,0:07:19.89,Default,,0000,0000,0000,,كان مقتولاً بوقت عودتك إذاً؟
Dialogue: 0,0:07:20.31,0:07:21.22,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:21.22,0:07:23.72,Default,,0000,0000,0000,,...ومن كان رفقتك
Dialogue: 0,0:07:24.18,0:07:27.64,Default,,0000,0000,0000,,!أنا سيّدي المفتش ميغوري، موري كوغورو
Dialogue: 0,0:07:27.64,0:07:30.55,Default,,0000,0000,0000,,يا إلهي، لمَ هو بالذات؟
Dialogue: 0,0:07:30.55,0:07:32.76,Default,,0000,0000,0000,,!يشعرني هذا بالحنين
Dialogue: 0,0:07:32.76,0:07:35.51,Default,,0000,0000,0000,,تذكر القضايا التي عملنا عليها سويّاً\Nفي الأيام الخوالي؟
Dialogue: 0,0:07:35.51,0:07:40.41,Default,,0000,0000,0000,,أجل، وأُغلقت معظمها دون أن تُحلّ بسببك
Dialogue: 0,0:07:42.08,0:07:44.41,Default,,0000,0000,0000,,المكان حارّ هنا
Dialogue: 0,0:07:44.41,0:07:46.75,Default,,0000,0000,0000,,أترفعين درجة جهاز التدفئة لهذا الحد دوماً؟
Dialogue: 0,0:07:46.75,0:07:47.65,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:07:48.03,0:07:51.27,Default,,0000,0000,0000,,كما أنّي أطفأته قبل مغادرتي حتماً
Dialogue: 0,0:07:51.27,0:07:53.44,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:07:53.44,0:07:56.02,Default,,0000,0000,0000,,ليس ذلك الغريب فقط حضرة المفتش
Dialogue: 0,0:07:56.02,0:07:59.56,Default,,0000,0000,0000,,إنّها طفيفة، لكن هناك بقع رطبة حول الجثة
Dialogue: 0,0:08:00.43,0:08:02.43,Default,,0000,0000,0000,,كما ذاك الكرسيّ هو الشيء\Nالوحيد الواقف
Dialogue: 0,0:08:02.43,0:08:04.43,Default,,0000,0000,0000,,بينما كلّ ما سواه في الغرفة مطروح
Dialogue: 0,0:08:04.97,0:08:07.34,Default,,0000,0000,0000,,...وهذه الحرارة
Dialogue: 0,0:08:07.34,0:08:10.01,Default,,0000,0000,0000,,أكان الهدف منها العبث بوقت الوفاة؟
Dialogue: 0,0:08:14.04,0:08:15.71,Default,,0000,0000,0000,,!يجب ألّا يتدخل الأطفال
Dialogue: 0,0:08:15.71,0:08:16.85,Default,,0000,0000,0000,,!الكلام لك
Dialogue: 0,0:08:17.21,0:08:19.00,Default,,0000,0000,0000,,هل حددتم سبب الموت؟
Dialogue: 0,0:08:19.00,0:08:21.31,Default,,0000,0000,0000,,يبدو أنّها هذه السكّين
Dialogue: 0,0:08:22.82,0:08:25.49,Default,,0000,0000,0000,,أتخصك تلك السكين؟
Dialogue: 0,0:08:25.49,0:08:26.49,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:26.49,0:08:28.20,Default,,0000,0000,0000,,أتشكّون بيوكو حقاً؟
Dialogue: 0,0:08:28.20,0:08:29.73,Default,,0000,0000,0000,,أسبق ورأيتما الضحية؟
Dialogue: 0,0:08:30.44,0:08:32.68,Default,,0000,0000,0000,,أحتاج لإلقاء نظرة أقرب
Dialogue: 0,0:08:39.97,0:08:42.09,Default,,0000,0000,0000,,أرأيتماه قبلاً إذاً؟
Dialogue: 0,0:08:42.09,0:08:44.72,Default,,0000,0000,0000,,آسف، لم نلتقه قبلاً
Dialogue: 0,0:08:44.72,0:08:45.69,Default,,0000,0000,0000,,صحيح يا يوكو؟
Dialogue: 0,0:08:45.69,0:08:46.48,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:08:47.18,0:08:49.05,Default,,0000,0000,0000,,...رأيتُه بالفعل
Dialogue: 0,0:08:49.05,0:08:51.47,Default,,0000,0000,0000,,ما كان ذلك؟ ما الذي أخذه؟
Dialogue: 0,0:08:59.17,0:09:00.32,Default,,0000,0000,0000,,لا تبالوا لي
Dialogue: 0,0:09:06.53,0:09:07.77,Default,,0000,0000,0000,,خيط شعر؟
Dialogue: 0,0:09:08.95,0:09:10.53,Default,,0000,0000,0000,,لمَ قد يحاول مديرها إخفاء هذا؟
Dialogue: 0,0:09:11.40,0:09:13.56,Default,,0000,0000,0000,,...أيمكن أنّ القاتل
Dialogue: 0,0:09:13.94,0:09:16.48,Default,,0000,0000,0000,,وقعت الجريمة في غرفة مغلقة
Dialogue: 0,0:09:16.48,0:09:20.55,Default,,0000,0000,0000,,مما يعني أنّ القاتل كان ساكناً في هذه الشقة
Dialogue: 0,0:09:21.01,0:09:23.01,Default,,0000,0000,0000,,!مُحال! لا يمكنني قتل شخص أبداً
Dialogue: 0,0:09:23.01,0:09:24.68,Default,,0000,0000,0000,,!إنّها محقة حضرة المفتش
Dialogue: 0,0:09:24.68,0:09:25.98,Default,,0000,0000,0000,,...مجرد امتلاكها للمفتاح لا يعني
Dialogue: 0,0:09:26.47,0:09:28.72,Default,,0000,0000,0000,,ألا يملك الناس مفاتيح احتياطية عادةً؟
Dialogue: 0,0:09:28.72,0:09:29.57,Default,,0000,0000,0000,,!بلى
Dialogue: 0,0:09:29.57,0:09:30.67,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:09:30.67,0:09:31.93,Default,,0000,0000,0000,,لا تتدخلوا
Dialogue: 0,0:09:31.93,0:09:35.42,Default,,0000,0000,0000,,يملك ياماغيشي-سان مفتاحاً احتياطياً
Dialogue: 0,0:09:35.42,0:09:36.42,Default,,0000,0000,0000,,!وجدتُها
Dialogue: 0,0:09:36.42,0:09:39.69,Default,,0000,0000,0000,,!ياماغيشي! أنتَ القاتل
Dialogue: 0,0:09:40.30,0:09:41.62,Default,,0000,0000,0000,,!ياماغيشي
Dialogue: 0,0:09:41.62,0:09:44.02,Default,,0000,0000,0000,,رفضت يوكو مشاعرك، لذا صببتَ جام\N!غضبك عليه، أليس كذلك؟
Dialogue: 0,0:09:44.02,0:09:47.02,Default,,0000,0000,0000,,رويدك، ما هو دليل براءتها؟
Dialogue: 0,0:09:47.02,0:09:51.93,Default,,0000,0000,0000,,فتاة حسناء ببهائها لا يمكن أن\N!تقدم على أمر كهذا أبداً
Dialogue: 0,0:09:52.27,0:09:53.44,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:09:53.44,0:09:54.39,Default,,0000,0000,0000,,أحمق
Dialogue: 0,0:09:55.15,0:10:00.22,Default,,0000,0000,0000,,،كان لديّ مفتاح بديل بالفعل\Nلكني فقدته قبل عدّة أيام
Dialogue: 0,0:10:00.22,0:10:01.56,Default,,0000,0000,0000,,!لا تكذب
Dialogue: 0,0:10:01.56,0:10:04.39,Default,,0000,0000,0000,,إنّها الحقيقة! كنتُ في غرفة تبديل\Nالملابس في محطة التلفاز
Dialogue: 0,0:10:04.39,0:10:07.31,Default,,0000,0000,0000,,!أخبرني ذلك أيضاً، إنّها الحقيقة
Dialogue: 0,0:10:07.31,0:10:09.36,Default,,0000,0000,0000,,...حسناً، إن كنتِ تشهدين بذلك يا يوكو-سان فإذاً
Dialogue: 0,0:10:10.17,0:10:13.22,Default,,0000,0000,0000,,أشعر أن شيئاً مهماً ينقصنا
Dialogue: 0,0:10:13.22,0:10:15.71,Default,,0000,0000,0000,,بإمكانه توضيح كلّ شيء هنا
Dialogue: 0,0:10:17.63,0:10:18.47,Default,,0000,0000,0000,,قرط أذن؟
Dialogue: 0,0:10:19.99,0:10:23.49,Default,,0000,0000,0000,,...مفتّش، يوجد تحت تلك الأريكة
Dialogue: 0,0:10:23.49,0:10:25.89,Default,,0000,0000,0000,,!ليبتعد الأطفال
Dialogue: 0,0:10:26.33,0:10:29.98,Default,,0000,0000,0000,,تبّاً، كلهم يتجاهلونني
Dialogue: 0,0:10:29.98,0:10:31.85,Default,,0000,0000,0000,,!وجدتُها، هذا الشيء
Dialogue: 0,0:10:32.94,0:10:34.60,Default,,0000,0000,0000,,...سأعدّله لصوت بالغ و
Dialogue: 0,0:10:35.19,0:10:38.06,Default,,0000,0000,0000,,حضرة المفتش، هناك شيء تحت الأريكة
Dialogue: 0,0:10:39.53,0:10:40.22,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:10:41.52,0:10:43.02,Default,,0000,0000,0000,,...قرط
Dialogue: 0,0:10:43.02,0:10:44.23,Default,,0000,0000,0000,,...إنّه يخص يُوكو-سان
Dialogue: 0,0:10:44.68,0:10:46.43,Default,,0000,0000,0000,,يُوكو-سان؟
Dialogue: 0,0:10:46.43,0:10:49.39,Default,,0000,0000,0000,,إيكيزاوا يُوكو-سان التي بدأت\Nمسيرتها الفنية في نفس الوقت معي
Dialogue: 0,0:10:49.39,0:10:54.60,Default,,0000,0000,0000,,سمعتُ أنّها كانت مستاءة لحصول\Nيوكو على دورها في أحد المسلسلات
Dialogue: 0,0:10:55.01,0:10:57.09,Default,,0000,0000,0000,,!حللتُ الأمر الآن
Dialogue: 0,0:10:57.09,0:11:00.43,Default,,0000,0000,0000,,!المجرمة هي إيكيزاوا يُوكو! اعتقلوها
Dialogue: 0,0:11:01.00,0:11:02.39,Default,,0000,0000,0000,,صحيح سيّدي المفتش؟
Dialogue: 0,0:11:02.79,0:11:05.25,Default,,0000,0000,0000,,...حسناً، علينا الذهاب للمركز
Dialogue: 0,0:11:05.25,0:11:07.41,Default,,0000,0000,0000,,!كلا، لنطلب قدومها هنا للاستجواب
Dialogue: 0,0:11:07.41,0:11:09.82,Default,,0000,0000,0000,,!كما سمعتم! أسرعوا
Dialogue: 0,0:11:09.82,0:11:10.69,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:10.69,0:11:14.77,Default,,0000,0000,0000,,!المجرمة هي إيكيزاوا يُوكو! لا شكّ في ذلك
Dialogue: 0,0:11:15.24,0:11:19.44,Default,,0000,0000,0000,,بناءً على مسرح الجريمة، لا بد أن\Nتكون المجرمة هي أوكينو يوكو
Dialogue: 0,0:11:20.14,0:11:22.56,Default,,0000,0000,0000,,...تصرّف المدير مجهول الدوافع
Dialogue: 0,0:11:22.56,0:11:25.31,Default,,0000,0000,0000,,...كما العلامات الغريبة المتروكة في الغرفة
Dialogue: 0,0:11:27.68,0:11:30.01,Default,,0000,0000,0000,,كلّ القطع هنا
Dialogue: 0,0:11:30.01,0:11:32.01,Default,,0000,0000,0000,,بقيت مشكلة جمعها فقط
Dialogue: 0,0:11:40.39,0:11:41.79,Default,,0000,0000,0000,,!لا تمازحوني
Dialogue: 0,0:11:42.23,0:11:44.89,Default,,0000,0000,0000,,وقعت الجريمة في شقّة يوكو
Dialogue: 0,0:11:44.89,0:11:46.75,Default,,0000,0000,0000,,لذا يُفترض أن تكون هي المشتبه بها
Dialogue: 0,0:11:47.27,0:11:48.71,Default,,0000,0000,0000,,...يُوكو-سان
Dialogue: 0,0:11:49.10,0:11:52.72,Default,,0000,0000,0000,,لم يسبق لي أن أتيت هنا، أنا بريئة
Dialogue: 0,0:11:52.72,0:11:54.66,Default,,0000,0000,0000,,كيف تفسرين وجود هذا إذًا؟
Dialogue: 0,0:11:56.13,0:11:59.91,Default,,0000,0000,0000,,،ظننتُ أني أضعته في مكان ما\N!يسرّني عثوركم عليه
Dialogue: 0,0:12:00.37,0:12:02.08,Default,,0000,0000,0000,,لا يتوقف الأمر عند القرط
Dialogue: 0,0:12:02.08,0:12:06.08,Default,,0000,0000,0000,,قال مشرف المبنى أنّه رأى شخصاً يشبهك
Dialogue: 0,0:12:06.08,0:12:08.87,Default,,0000,0000,0000,,شخص يشبهني؟ يا للسخافة
Dialogue: 0,0:12:08.87,0:12:09.91,Default,,0000,0000,0000,,سأذهب للحمام
Dialogue: 0,0:12:10.49,0:12:12.87,Default,,0000,0000,0000,,!انتظري! لم أنه كلامي
Dialogue: 0,0:12:13.16,0:12:14.32,Default,,0000,0000,0000,,!يكفي
Dialogue: 0,0:12:14.32,0:12:16.41,Default,,0000,0000,0000,,!أتعتقد أنّي المجرمة لقرط أذن فقط؟
Dialogue: 0,0:12:16.41,0:12:17.75,Default,,0000,0000,0000,,!أنا مشغولة
Dialogue: 0,0:12:19.73,0:12:24.16,Default,,0000,0000,0000,,لكن ليس بقدر الآنسة رقم 1 في الشعبية
Dialogue: 0,0:12:25.15,0:12:29.39,Default,,0000,0000,0000,,!لكن إن تسلل هذا الخبر للإعلام، فستتلطخ سمعتك
Dialogue: 0,0:12:29.39,0:12:31.80,Default,,0000,0000,0000,,فقد تصبحين متفرّغة تماماً من قلّة الأعمال
Dialogue: 0,0:12:34.08,0:12:35.58,Default,,0000,0000,0000,,!كيف تجرؤين على تهديدها؟
Dialogue: 0,0:12:39.83,0:12:43.12,Default,,0000,0000,0000,,يبدوان بنفس المظهر من الوراء
Dialogue: 0,0:12:43.75,0:12:46.29,Default,,0000,0000,0000,,...كما كيف عرفتْ
Dialogue: 0,0:12:47.25,0:12:48.71,Default,,0000,0000,0000,,!يا عمَّاه
Dialogue: 0,0:12:48.71,0:12:50.03,Default,,0000,0000,0000,,!اخرس يا فتى
Dialogue: 0,0:12:50.62,0:12:51.04,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:12:52.28,0:12:53.49,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:12:54.78,0:12:57.33,Default,,0000,0000,0000,,لا تتدخل في التحقيق يا كونان-كن
Dialogue: 0,0:12:58.20,0:13:02.48,Default,,0000,0000,0000,,لكن لو كان شينتشي هنا، كان ليحلّ\Nهذه القضية بسهولة حتماً
Dialogue: 0,0:13:04.06,0:13:07.79,Default,,0000,0000,0000,,أين ذهب مهووس التحرّي ذاك؟
Dialogue: 0,0:13:08.44,0:13:11.22,Default,,0000,0000,0000,,!سيعود قريباً بالتأكيد! لا تقلقي
Dialogue: 0,0:13:13.43,0:13:15.25,Default,,0000,0000,0000,,...أقصد، ربما
Dialogue: 0,0:13:15.68,0:13:17.54,Default,,0000,0000,0000,,ماذا عليّ أن أقول لتفهم؟
Dialogue: 0,0:13:17.93,0:13:20.49,Default,,0000,0000,0000,,أخبرتك لم يسبق لي القدوم هنا
Dialogue: 0,0:13:25.92,0:13:27.88,Default,,0000,0000,0000,,إنّها قدّاحة غريبة
Dialogue: 0,0:13:28.67,0:13:32.33,Default,,0000,0000,0000,,كيف عرفتِ أنّها قدّاحة مع أنّه\Nلم يسبق لك القدوم هنا؟
Dialogue: 0,0:13:34.24,0:13:37.16,Default,,0000,0000,0000,,صحيح، كيف عرفتِ؟
Dialogue: 0,0:13:37.16,0:13:40.11,Default,,0000,0000,0000,,توجد واحدة مثلها في منزل شخص أعرفه
Dialogue: 0,0:13:40.11,0:13:41.77,Default,,0000,0000,0000,,وأين منزل ذاك الشخص؟
Dialogue: 0,0:13:41.77,0:13:42.65,Default,,0000,0000,0000,,...في الواقع
Dialogue: 0,0:13:42.65,0:13:44.04,Default,,0000,0000,0000,,أين الحمام؟
Dialogue: 0,0:13:44.04,0:13:46.04,Default,,0000,0000,0000,,لم أزر المكان قبلاً، فلا أعرف أين هو
Dialogue: 0,0:13:46.94,0:13:48.96,Default,,0000,0000,0000,,...ماذا؟ إنّه في الرواق
Dialogue: 0,0:13:49.35,0:13:52.91,Default,,0000,0000,0000,,!صحيح، عرفتِ مكان الحمام أيضاً
Dialogue: 0,0:13:53.26,0:13:55.87,Default,,0000,0000,0000,,!ذلك لأنّك القاتلة يا إيكيزاوا يُوكو
Dialogue: 0,0:13:56.43,0:14:02.21,Default,,0000,0000,0000,,قتلتِ ذاك الرجل في هذه الشقّة \Nللتسبب بفضيحة تضرّ بيوكو-سان
Dialogue: 0,0:14:02.21,0:14:02.79,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:14:02.79,0:14:04.75,Default,,0000,0000,0000,,!كلا! لم أقتله
Dialogue: 0,0:14:05.75,0:14:08.71,Default,,0000,0000,0000,,!دافعتُ عن نفسي عندما هاجمني فجأةً فقط
Dialogue: 0,0:14:08.71,0:14:11.79,Default,,0000,0000,0000,,أعترف أنّي تسللت هنا عدّة مرات
Dialogue: 0,0:14:11.79,0:14:14.58,Default,,0000,0000,0000,,باستعمال المفتاح البديل الذي سرقته\Nمن غرفة تبديل الملابس
Dialogue: 0,0:14:14.58,0:14:17.63,Default,,0000,0000,0000,,!أردتُ العثور على أي شيء يتسبّب بفضيحة لها
Dialogue: 0,0:14:17.63,0:14:22.58,Default,,0000,0000,0000,,لكن عندما أتيتُ ظهيرة اليوم، ظهر ذاك الرجل فجأةً
Dialogue: 0,0:14:24.48,0:14:27.03,Default,,0000,0000,0000,,!دافعتُ عن نفسي بكلّ قوّتي
Dialogue: 0,0:14:27.03,0:14:29.13,Default,,0000,0000,0000,,!ثمّ هربت بأسرع ما يمكن
Dialogue: 0,0:14:29.68,0:14:33.72,Default,,0000,0000,0000,,أليس ما حصل أنّك قتلته أثناء التشابك؟
Dialogue: 0,0:14:33.72,0:14:35.81,Default,,0000,0000,0000,,!أخبرتك أنّي لم أقتله
Dialogue: 0,0:14:35.81,0:14:37.77,Default,,0000,0000,0000,,!حضرة المفتش
Dialogue: 0,0:14:37.77,0:14:40.26,Default,,0000,0000,0000,,وجدنا هويّة الضحية
Dialogue: 0,0:14:40.26,0:14:42.34,Default,,0000,0000,0000,,فوجي آكيوشي، 22 عاماً
Dialogue: 0,0:14:42.34,0:14:44.05,Default,,0000,0000,0000,,بعد تخرّجه من ثانوية كونان
Dialogue: 0,0:14:44.05,0:14:45.92,Default,,0000,0000,0000,,بدأ العمل في شركة كاكوبيني
Dialogue: 0,0:14:45.92,0:14:47.88,Default,,0000,0000,0000,,...ثانوية كونان
Dialogue: 0,0:14:48.42,0:14:50.87,Default,,0000,0000,0000,,ألم تكن هذه ثانويتك القديمة يا يوكو-سان؟
Dialogue: 0,0:14:50.87,0:14:52.16,Default,,0000,0000,0000,,!مجرد مصادفة
Dialogue: 0,0:14:52.16,0:14:53.29,Default,,0000,0000,0000,,صحيح يا يوكو؟
Dialogue: 0,0:14:53.29,0:14:56.33,Default,,0000,0000,0000,,!أنا... أنا أعرفه
Dialogue: 0,0:14:57.70,0:15:02.75,Default,,0000,0000,0000,,ليس معرفةً فقط، كان حبيبي في الثانوية
Dialogue: 0,0:15:03.15,0:15:04.21,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:04.57,0:15:06.15,Default,,0000,0000,0000,,!يوكو
Dialogue: 0,0:15:06.15,0:15:09.16,Default,,0000,0000,0000,,آسفة يا ياماغيشي-سان، لا أستطيع إخفاء الأمر
Dialogue: 0,0:15:09.56,0:15:13.12,Default,,0000,0000,0000,,أيمكن أنك أقدمتِ على هذا\N!لقطع علاقتك القديمة؟
Dialogue: 0,0:15:13.56,0:15:14.81,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:15:14.81,0:15:17.92,Default,,0000,0000,0000,,هو من هجرني في نهاية المطاف
Dialogue: 0,0:15:18.31,0:15:19.51,Default,,0000,0000,0000,,من؟
Dialogue: 0,0:15:19.51,0:15:20.91,Default,,0000,0000,0000,,من القاتل؟
Dialogue: 0,0:15:21.84,0:15:22.91,Default,,0000,0000,0000,,أوكينو يوكو؟
Dialogue: 0,0:15:23.63,0:15:25.04,Default,,0000,0000,0000,,إيكيزاوا يُوكو؟
Dialogue: 0,0:15:26.26,0:15:28.04,Default,,0000,0000,0000,,أم المدير ياماغيشي؟
Dialogue: 0,0:15:28.92,0:15:30.41,Default,,0000,0000,0000,,تبّاً
Dialogue: 0,0:15:30.41,0:15:33.25,Default,,0000,0000,0000,,!لا يزال ينقصنا شيء لإكمال الاستنتاج
Dialogue: 0,0:15:33.25,0:15:35.33,Default,,0000,0000,0000,,ماذا؟ ما الذي ينقصنا؟
Dialogue: 0,0:15:37.25,0:15:38.75,Default,,0000,0000,0000,,انبعاج في الأرض؟
Dialogue: 0,0:15:39.53,0:15:40.74,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:15:40.74,0:15:43.46,Default,,0000,0000,0000,,الكرسي هو الشيء الوحيد الواقف\Nمع أنّ الغرفة في فوضى
Dialogue: 0,0:15:44.99,0:15:47.67,Default,,0000,0000,0000,,...كما حرارة الغرفة المرتفعة جداً
Dialogue: 0,0:15:48.74,0:15:51.77,Default,,0000,0000,0000,,...بقع الماء حول الجثّة
Dialogue: 0,0:15:51.77,0:15:53.73,Default,,0000,0000,0000,,والشعر في يد الجثة؟
Dialogue: 0,0:15:56.77,0:15:58.54,Default,,0000,0000,0000,,!أجل! وجدتُها
Dialogue: 0,0:15:59.26,0:16:00.99,Default,,0000,0000,0000,,!حللتُ الأحجية أخيراً
Dialogue: 0,0:16:01.43,0:16:02.87,Default,,0000,0000,0000,,...القاتل
Dialogue: 0,0:16:02.87,0:16:04.46,Default,,0000,0000,0000,,!هو أنت يا ياماغيشي
Dialogue: 0,0:16:07.59,0:16:09.42,Default,,0000,0000,0000,,اعتبرتَه عقبة
Dialogue: 0,0:16:09.42,0:16:12.20,Default,,0000,0000,0000,,لأنّ بإمكانه التسبب بفضيحة ليوكو-سان
Dialogue: 0,0:16:12.87,0:16:16.08,Default,,0000,0000,0000,,واجهته في الغرفة بينما كان يختبئ
Dialogue: 0,0:16:16.08,0:16:17.67,Default,,0000,0000,0000,,!ثم قتلته
Dialogue: 0,0:16:18.50,0:16:19.49,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:16:19.49,0:16:21.12,Default,,0000,0000,0000,,!ياماغيشي-سان ليس القاتل
Dialogue: 0,0:16:21.91,0:16:23.28,Default,,0000,0000,0000,,نمت كثيراً
Dialogue: 0,0:16:23.28,0:16:25.82,Default,,0000,0000,0000,,أفقت مُجدداً يا غينتا-كن؟
Dialogue: 0,0:16:25.82,0:16:27.07,Default,,0000,0000,0000,,أين الحمام؟
Dialogue: 0,0:16:27.07,0:16:27.58,Default,,0000,0000,0000,,هناك
Dialogue: 0,0:16:27.58,0:16:30.41,Default,,0000,0000,0000,,لم يبق أحد يمكن أن\N!يكون المجرم سواك
Dialogue: 0,0:16:30.73,0:16:31.83,Default,,0000,0000,0000,,!آسف يا عمّ
Dialogue: 0,0:16:32.27,0:16:33.50,Default,,0000,0000,0000,,!اعترف! ستشعر بالراحة
Dialogue: 0,0:16:33.90,0:16:34.33,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:16:35.90,0:16:36.54,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:16:44.55,0:16:47.54,Default,,0000,0000,0000,,...حسنٌ، سأضبطها لصوته و
Dialogue: 0,0:16:47.54,0:16:50.49,Default,,0000,0000,0000,,ذلك ما أقول، لكنها ليست الحقيقة
Dialogue: 0,0:16:50.49,0:16:51.92,Default,,0000,0000,0000,,ياماغيشي-سان
Dialogue: 0,0:16:51.92,0:16:56.25,Default,,0000,0000,0000,,لو طلبتَ خدماتي كي أجد الجثة
Dialogue: 0,0:16:56.25,0:16:59.45,Default,,0000,0000,0000,,فكنتَ لتحضّر دليل براءة لك أيضاً
Dialogue: 0,0:17:00.07,0:17:02.24,Default,,0000,0000,0000,,ينطبق ذلك عليك أيضاً يا يوكو-سان
Dialogue: 0,0:17:02.24,0:17:05.37,Default,,0000,0000,0000,,فأنتِ المشتبه بها الأولى لكونك مالكة الشقّة
Dialogue: 0,0:17:05.76,0:17:09.36,Default,,0000,0000,0000,,!القاتل إذاً... إيكيزاوا يُوكو
Dialogue: 0,0:17:09.36,0:17:10.16,Default,,0000,0000,0000,,!تمهل
Dialogue: 0,0:17:10.16,0:17:11.86,Default,,0000,0000,0000,,ليست هي أيضاً
Dialogue: 0,0:17:11.86,0:17:14.12,Default,,0000,0000,0000,,،لو قتلتَه أثناء تشابكهما
Dialogue: 0,0:17:14.12,0:17:16.58,Default,,0000,0000,0000,,ما كانت لتخبرنا بلقائها المفاجئ به
Dialogue: 0,0:17:16.58,0:17:18.69,Default,,0000,0000,0000,,...لكن ما تقوله
Dialogue: 0,0:17:18.69,0:17:21.54,Default,,0000,0000,0000,,أجل، كلّها تخمينات حالياً
Dialogue: 0,0:17:22.05,0:17:24.51,Default,,0000,0000,0000,,لا يمكن أن تكون برهان براءة لأيّ منهم
Dialogue: 0,0:17:24.51,0:17:26.93,Default,,0000,0000,0000,,لكن يوجد دليل يدعم ذلك
Dialogue: 0,0:17:26.93,0:17:27.50,Default,,0000,0000,0000,,ياماغيشي-سان
Dialogue: 0,0:17:28.05,0:17:31.79,Default,,0000,0000,0000,,تظاهرتَ بالانزلاق ثم أزلتَ خيوط شعر من الجثة
Dialogue: 0,0:17:31.79,0:17:32.79,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:32.79,0:17:34.92,Default,,0000,0000,0000,,!أنتَ القاتل بالفعل إذاً
Dialogue: 0,0:17:34.92,0:17:36.12,Default,,0000,0000,0000,,ليس صحيحاً
Dialogue: 0,0:17:37.75,0:17:39.66,Default,,0000,0000,0000,,طُعن الرجل من الخلف
Dialogue: 0,0:17:39.66,0:17:42.33,Default,,0000,0000,0000,,لكنه كان يحمل شعرات طاعنه في يده
Dialogue: 0,0:17:42.33,0:17:44.83,Default,,0000,0000,0000,,ألا تجدون الأمر غريباً؟
Dialogue: 0,0:17:44.83,0:17:46.12,Default,,0000,0000,0000,,معك حقّ
Dialogue: 0,0:17:46.45,0:17:49.23,Default,,0000,0000,0000,,...رتّب الفاعل الأمر كي يبدو كجريمة قتل
Dialogue: 0,0:17:49.23,0:17:52.08,Default,,0000,0000,0000,,كما لو أنّه قُتل بواسطة يوكو-سان
Dialogue: 0,0:17:53.04,0:17:55.19,Default,,0000,0000,0000,,يبدو كجريمة قتل؟
Dialogue: 0,0:17:55.19,0:17:56.00,Default,,0000,0000,0000,,...أ-أتقصد
Dialogue: 0,0:17:56.40,0:17:57.86,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:17:57.86,0:18:00.56,Default,,0000,0000,0000,,...القاتل
Dialogue: 0,0:18:00.56,0:18:02.95,Default,,0000,0000,0000,,!هو المتوفى فوجي-سان نفسه
Dialogue: 0,0:18:02.95,0:18:03.75,Default,,0000,0000,0000,,!انتحار؟
Dialogue: 0,0:18:05.85,0:18:08.95,Default,,0000,0000,0000,,لا يمكن! كيف يطعن نفسه بسكّين من الوراء؟
Dialogue: 0,0:18:09.80,0:18:11.91,Default,,0000,0000,0000,,إنّها حيلة بسيطة تعتمد على الثلج
Dialogue: 0,0:18:12.71,0:18:17.37,Default,,0000,0000,0000,,رفع حرارة جهاز التدفئة، وأخذ شعر \Nيوكو-سان من فرشاتها
Dialogue: 0,0:18:17.74,0:18:22.32,Default,,0000,0000,0000,,ثمّ وقف على كرسي ورمى نفسه على السكّين
Dialogue: 0,0:18:22.32,0:18:24.49,Default,,0000,0000,0000,,كانت مُثبّتة بمكعّب ثلجي
Dialogue: 0,0:18:24.99,0:18:27.65,Default,,0000,0000,0000,,ستجد انبعاجاً سببه مِقبض السكّين
Dialogue: 0,0:18:27.65,0:18:28.94,Default,,0000,0000,0000,,بقرب مكان الجثة
Dialogue: 0,0:18:29.48,0:18:32.90,Default,,0000,0000,0000,,تكسر الثلج وذاب لاحقاً بفعل الحرارة
Dialogue: 0,0:18:32.90,0:18:37.31,Default,,0000,0000,0000,,لكن بالغ فوجي-سان في محاولة إدانتها
Dialogue: 0,0:18:37.31,0:18:38.68,Default,,0000,0000,0000,,الشعر؟
Dialogue: 0,0:18:38.68,0:18:39.59,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:39.59,0:18:41.36,Default,,0000,0000,0000,,عندما رآه ياماغيشي-سان
Dialogue: 0,0:18:41.63,0:18:45.32,Default,,0000,0000,0000,,حاول إخفاءه لاعتقاده أنّ يوكو-سان قتلته حقّاً
Dialogue: 0,0:18:45.97,0:18:48.87,Default,,0000,0000,0000,,لكن لمَ قد يقوم فوجي-كن بشيء كهذا؟
Dialogue: 0,0:18:48.87,0:18:53.12,Default,,0000,0000,0000,,لأنّه كان لا يزال يحبك غالباً
Dialogue: 0,0:18:54.16,0:18:58.24,Default,,0000,0000,0000,,ألم تدركي أنكما متشابهتان تماماً من الوراء؟
Dialogue: 0,0:18:59.28,0:19:02.90,Default,,0000,0000,0000,,لذا ظنّ أن يُوكو-سان هي يوكو-سان وهاجمها
Dialogue: 0,0:19:02.90,0:19:05.16,Default,,0000,0000,0000,,كلا، حاول الكلام معها
Dialogue: 0,0:19:05.78,0:19:09.10,Default,,0000,0000,0000,,لكنه لم يدرك أنها كانت يُوكو-سان وليس يوكو-سان
Dialogue: 0,0:19:09.10,0:19:10.98,Default,,0000,0000,0000,,فصُدم تماماً عندما قاومتْه
Dialogue: 0,0:19:10.98,0:19:15.16,Default,,0000,0000,0000,,وسقطت مشاعر الحب المجروحة لفوهة اليأس والكراهية
Dialogue: 0,0:19:15.98,0:19:19.22,Default,,0000,0000,0000,,لكنه من هجرني! لمَ قد يقوم بذلك؟
Dialogue: 0,0:19:19.22,0:19:21.07,Default,,0000,0000,0000,,ليست هذه الحقيقة يا يوكو
Dialogue: 0,0:19:21.72,0:19:25.88,Default,,0000,0000,0000,,كنتُ من طلب منه هجرك في الواقع
Dialogue: 0,0:19:25.88,0:19:28.37,Default,,0000,0000,0000,,...كـ-كيف
Dialogue: 0,0:19:29.75,0:19:30.75,Default,,0000,0000,0000,,!حضرة المفتش
Dialogue: 0,0:19:30.75,0:19:31.83,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:19:31.83,0:19:34.29,Default,,0000,0000,0000,,وجدنا مذكرة يوميات في منزل المتوفى فوجي-سان
Dialogue: 0,0:19:34.29,0:19:34.82,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:19:35.83,0:19:40.49,Default,,0000,0000,0000,,كانت المذكرة مليئة بألمه
Dialogue: 0,0:19:40.49,0:19:41.66,Default,,0000,0000,0000,,وتحكي عجزه عن نسيانها
Dialogue: 0,0:19:41.66,0:19:44.45,Default,,0000,0000,0000,,بعد انفصالهما، فذهب لرؤيتها
Dialogue: 0,0:19:44.45,0:19:49.27,Default,,0000,0000,0000,,كان يأمل أن تترك مهنتها كفنّانة وترجع له
Dialogue: 0,0:19:49.60,0:19:52.94,Default,,0000,0000,0000,,كلّ ما أراده هو توضيح ما أُسيئ فهمه
Dialogue: 0,0:19:52.94,0:19:56.77,Default,,0000,0000,0000,,آخر كلماته كانت أنّه لا يستطيع\Nالعيش هكذا أكثر
Dialogue: 0,0:19:58.93,0:20:03.15,Default,,0000,0000,0000,,...يبدو أنّها كانت مأساة مُحاكة بالأكاذيب
Dialogue: 0,0:20:04.05,0:20:06.22,Default,,0000,0000,0000,,والمغالطات والصُدف
Dialogue: 0,0:20:10.88,0:20:11.57,Default,,0000,0000,0000,,!حارّ
Dialogue: 0,0:20:12.08,0:20:14.71,Default,,0000,0000,0000,,!موري-كن! تحليلك في محله
Dialogue: 0,0:20:14.71,0:20:16.53,Default,,0000,0000,0000,,!تغيّرت نظرتي تجاهك أيّها المتحري العظيم
Dialogue: 0,0:20:17.50,0:20:18.74,Default,,0000,0000,0000,,أشعر بالإعياء
Dialogue: 0,0:20:27.78,0:20:31.40,Default,,0000,0000,0000,,كان الأمر مخيفاً قليلاً، لكن لم يسبق\Nوشعرتُ بذاك الحماس
Dialogue: 0,0:20:31.40,0:20:33.61,Default,,0000,0000,0000,,،أظن إن صادقنا كونان-كن
Dialogue: 0,0:20:33.61,0:20:36.10,Default,,0000,0000,0000,,!سنمرّ بالكثير من التشويق والإثارة
Dialogue: 0,0:20:36.36,0:20:40.32,Default,,0000,0000,0000,,حسنٌ، علينا جعل كونان-كن\Nيصبح صديقنا في هذه الحالة
Dialogue: 0,0:20:40.32,0:20:42.06,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:20:48.26,0:20:49.84,Default,,0000,0000,0000,,إنّها قويّة
Dialogue: 0,0:20:49.84,0:20:52.46,Default,,0000,0000,0000,,وقفت مجدداً بعد كلّ ما حصل
Dialogue: 0,0:21:01.49,0:21:06.28,Default,,0000,0000,0000,,...لا يمكنني أن أكون قويّةً مثلك يا يوكو-سان
Dialogue: 0,0:21:06.28,0:21:09.80,Default,,0000,0000,0000,,لا أستطيع حتّى ذالنوم ليلاً في غياب شينتشي
Dialogue: 0,0:21:11.48,0:21:12.78,Default,,0000,0000,0000,,لا أمل مني حقاً
Dialogue: 0,0:22:51.52,0:22:52.78,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:22:53.19,0:22:55.48,Default,,0000,0000,0000,,...شينتشي غائب لأسبوع الآن
Dialogue: 0,0:22:56.52,0:22:58.04,Default,,0000,0000,0000,,!حصل أمرٌ ما له حتماً
Dialogue: 0,0:22:59.10,0:23:02.31,Default,,0000,0000,0000,,!لكن... لا يمكن أن يحلّ أمر كذاك بشينتشي
Dialogue: 0,0:23:02.31,0:23:06.31,Default,,0000,0000,0000,,!شينتشي... عُد سريعاً! شينتشي
Dialogue: 0,0:23:13.30,0:23:14.70,Default,,0000,0000,0000,,...مرحباً، معك وكالة موري
Dialogue: 0,0:23:14.70,0:23:16.00,Default,,0000,0000,0000,,ران
Dialogue: 0,0:23:16.00,0:23:17.66,Default,,0000,0000,0000,,إنّه أنا، أعرفتِني؟
Dialogue: 0,0:23:18.00,0:23:19.41,Default,,0000,0000,0000,,شينتشي؟
Dialogue: 0,0:23:19.41,0:23:23.70,Default,,0000,0000,0000,,ظننتكِ غارقة في دموعكِ قلقاً عليّ
Dialogue: 0,0:23:24.65,0:23:27.81,Default,,0000,0000,0000,,أحمق! لمَ قد أبكي؟
Dialogue: 0,0:23:29.03,0:23:30.86,Default,,0000,0000,0000,,أين أنت الآن يا شينتشي؟
Dialogue: 0,0:23:30.86,0:23:34.15,Default,,0000,0000,0000,,كُلفت بقضيّة معقدة
Dialogue: 0,0:23:34.15,0:23:35.72,Default,,0000,0000,0000,,سأعود فورما أنتهي منها
Dialogue: 0,0:23:36.44,0:23:38.07,Default,,0000,0000,0000,,لذا لا تقلقي عليّ
Dialogue: 0,0:23:39.43,0:23:40.78,Default,,0000,0000,0000,,آسف يا ران
Dialogue: 0,0:23:41.47,0:23:46.70,Default,,0000,0000,0000,,سأسمعك إيّاه عندما أعود لجسدي الطبيعي
Dialogue: 0,0:23:46.93,0:23:48.39,Default,,0000,0000,0000,,...صوتي الحقيقي
Dialogue: 0,0:23:49.42,0:23:51.17,Default,,0000,0000,0000,,كما مشاعري الحقيقية
Dialogue: 0,0:24:02.70,0:24:04.37,Default,,0000,0000,0000,,ما هذه الرسمات برأيكم؟
Dialogue: 0,0:24:04.37,0:24:06.53,Default,,0000,0000,0000,,!إنّها خريطة كنز حتماً
Dialogue: 0,0:24:07.04,0:24:09.52,Default,,0000,0000,0000,,!لنذهب في رحلة بحث عن كنز يا رفاق
Dialogue: 0,0:24:10.03,0:24:12.49,Default,,0000,0000,0000,,!نحن نادي المتحرّيين الصغار من اليوم فصاعداً
Dialogue: 0,0:24:13.11,0:24:16.57,Default,,0000,0000,0000,,سأستعمل حصّتي من الكنز لأكل\N!كلّ وجبة في العالم
Dialogue: 0,0:24:17.15,0:24:18.64,Default,,0000,0000,0000,,ماذا عنك يا كونان-كن؟
Dialogue: 0,0:24:18.64,0:24:20.28,Default,,0000,0000,0000,,...أ-أظنني سأدّخره
Dialogue: 0,0:24:24.42,0:24:26.07,Default,,0000,0000,0000,,!ذاك هو
Dialogue: 0,0:24:26.34,0:24:27.65,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.88,0:24:30.79,Default,,0000,0000,0000,,قضيّة خريطة المدينة المشفرة
Dialogue: 0,0:24:48.49,0:24:50.46,Default,,0000,0000,0000,,:تلميح الحلقة القادمة
Dialogue: 0,0:24:50.94,0:24:52.56,Default,,0000,0000,0000,,لافتة نيون
Dialogue: 0,0:24:53.87,0:24:56.50,Default,,0000,0000,0000,,هل ستستطيعون حلّ الشفرة الحلقة القادمة؟

