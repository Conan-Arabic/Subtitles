Dialogue: 0,0:00:01.48,0:00:03.27,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب لامع
Dialogue: 0,0:00:03.27,0:00:06.34,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:06.93,0:00:10.33,Default,,0000,0000,0000,,!قضيّة اليوم عن سرقة مصرف\N!لكن هنالك أمر غريب
Dialogue: 0,0:00:10.76,0:00:12.50,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.67,0:00:14.47,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.47,0:00:16.89,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.21,0:01:57.01,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل عملية سطو المصرف
Dialogue: 0,0:01:51.93,0:01:55.27,Default,,0000,0000,0000,,جريمة قتل عملية سطو المصرف
Dialogue: 0,0:02:05.59,0:02:07.52,Default,,0000,0000,0000,,!مٌذهل! 3 إسقاطات متتالية
Dialogue: 0,0:02:10.20,0:02:11.47,Default,,0000,0000,0000,,!كان ذلك مُسلياً
Dialogue: 0,0:02:12.25,0:02:14.41,Default,,0000,0000,0000,,من الرائع الذهاب لقاعات البولينغ\Nعندما تكون فارغةً أيام الأسبوع
Dialogue: 0,0:02:14.41,0:02:15.43,Default,,0000,0000,0000,,!بالفعل
Dialogue: 0,0:02:15.87,0:02:19.27,Default,,0000,0000,0000,,،انتهينا من الامتحانات النصفية اليوم أيضاً\N!فمزاجنا منتعش
Dialogue: 0,0:02:19.90,0:02:23.01,Default,,0000,0000,0000,,مزاجك منتعش دوماً
Dialogue: 0,0:02:24.94,0:02:26.85,Default,,0000,0000,0000,,أأنت بخير يا كونان-كن؟
Dialogue: 0,0:02:26.85,0:02:28.81,Default,,0000,0000,0000,,أأصابك الزكام؟
Dialogue: 0,0:02:29.49,0:02:31.55,Default,,0000,0000,0000,,لا يبدو أنّك تعاني من حُمى
Dialogue: 0,0:02:34.60,0:02:37.07,Default,,0000,0000,0000,,لا يزال الوقت باكراً، لكن ربما\Nعلينا الرجوع للمنزل
Dialogue: 0,0:02:37.48,0:02:38.74,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:02:38.74,0:02:39.56,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:02:39.56,0:02:41.38,Default,,0000,0000,0000,,!نسيتُ الذهاب للمصرف
Dialogue: 0,0:02:41.38,0:02:41.93,Default,,0000,0000,0000,,المصرف؟
Dialogue: 0,0:02:41.93,0:02:47.38,Default,,0000,0000,0000,,أجل، طلب منّي أبي صرف\N!شيك استلمه من عميل
Dialogue: 0,0:02:47.38,0:02:48.89,Default,,0000,0000,0000,,أيوجد مصرف بالقرب؟
Dialogue: 0,0:02:48.89,0:02:51.55,Default,,0000,0000,0000,,...يوجد مصرف توتو
Dialogue: 0,0:02:51.95,0:02:52.84,Default,,0000,0000,0000,,بعد انعطافك عند الزاوية
Dialogue: 0,0:02:52.98,0:02:55.09,CharCard,,0000,0000,0004,,{\fad(300,0)}مصرف توتو\Nفرع حديقة شمال بيكا
Dialogue: 0,0:02:55.36,0:02:57.74,Default,,0000,0000,0000,,وصلنا قبل فوات الأوان يا ران-نيتشان
Dialogue: 0,0:02:57.74,0:02:58.71,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:02:58.71,0:03:01.01,Default,,0000,0000,0000,,لن يستغرق هذا طويلاً، لننتظر يا كونان-كن
Dialogue: 0,0:03:04.97,0:03:08.31,CharCard,,0000,0000,0004,,{\fad(300,0)} تسوجي سابورو\Nطالب جامعيّ
Dialogue: 0,0:03:08.35,0:03:11.80,CharCard,,0230,0000,15,,{\fad(300,200)} ناغاي تاكاشي\Nموظّف في المصرف
Dialogue: 0,0:03:08.90,0:03:11.76,On Top,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:03:15.23,0:03:17.56,Default,,0000,0000,0000,,يبدو أنّ الزكام مُنتشر
Dialogue: 0,0:03:20.51,0:03:21.69,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:03:22.34,0:03:26.13,CharCard,,0000,0000,0004,,{\fad(300,100)}  (45)   إيبيساوا كازو\Nمدير فرع حديقة شمال بيكا لمصرف توتو
Dialogue: 0,0:03:22.76,0:03:26.18,On Top,,0000,0000,0000,,آنسة سونوكو! ما الذي جلبك هنا اليوم؟
Dialogue: 0,0:03:27.01,0:03:29.03,Default,,0000,0000,0000,,أرافق صديقتي فحسب
Dialogue: 0,0:03:29.03,0:03:30.09,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:03:30.67,0:03:33.44,Default,,0000,0000,0000,,أوصلي تحيّتي لأبيك رجاءً
Dialogue: 0,0:03:36.75,0:03:38.86,Default,,0000,0000,0000,,من ذاك الشخص يا سونوكو؟
Dialogue: 0,0:03:38.86,0:03:40.68,Default,,0000,0000,0000,,مدير الفرع هنا
Dialogue: 0,0:03:41.28,0:03:43.74,Default,,0000,0000,0000,,!ابنة عائلة مجموعة سوزوكي تظهر نفسها
Dialogue: 0,0:03:44.86,0:03:46.21,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:03:46.21,0:03:48.01,Default,,0000,0000,0000,,يبدو زكاماً حقّاً
Dialogue: 0,0:03:48.32,0:03:49.73,Default,,0000,0000,0000,,أأنت بخير يا صبيّ؟
Dialogue: 0,0:03:49.81,0:03:53.82,CharCard,,0000,0000,0004,,{\fad(300,0)}  تانيغوتشي نوبورو\Nأمين صندوق في مصرف توتو
Dialogue: 0,0:03:50.52,0:03:53.93,On Top,,0000,0000,0000,,يبدو سعالك شديداً، معي دواء للحلق
Dialogue: 0,0:03:54.65,0:03:55.94,Default,,0000,0000,0000,,يمكنك أخذه
Dialogue: 0,0:03:56.94,0:03:58.04,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:03:58.48,0:03:59.77,Default,,0000,0000,0000,,نعتذر على الإزعاج
Dialogue: 0,0:03:59.77,0:04:00.55,Default,,0000,0000,0000,,البتّة
Dialogue: 0,0:04:01.14,0:04:03.43,Default,,0000,0000,0000,,تانيغوتشي-سان، هلّا أتيت قليلاً؟
Dialogue: 0,0:04:03.43,0:04:04.97,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:04:04.97,0:04:06.80,Default,,0000,0000,0000,,اعذروني إذاً
Dialogue: 0,0:04:13.08,0:04:14.22,Default,,0000,0000,0000,,...إنّه هذا
Dialogue: 0,0:04:14.22,0:04:15.50,Default,,0000,0000,0000,,دعيني أرى
Dialogue: 0,0:04:17.57,0:04:20.45,CharCard,,0000,0000,0004,,{\fad(300,100)}  (مايجيما تيتسويا (28\Nأمين صندوق في مصرف توتو
Dialogue: 0,0:04:24.07,0:04:27.24,Default,,0000,0000,0000,,حضرة المدير، سأذهب لإجراء الجولات الآن
Dialogue: 0,0:04:27.24,0:04:28.77,Default,,0000,0000,0000,,حسناً، بالتوفيق
Dialogue: 0,0:04:36.56,0:04:39.80,Default,,0000,0000,0000,,!ارفعوا أيديكم جميعاً وقفوا أماكنكم
Dialogue: 0,0:04:40.47,0:04:43.64,Default,,0000,0000,0000,,!إذا أقدمتم على أيّ شيء ستفقدون حياتكم
Dialogue: 0,0:04:44.19,0:04:44.90,Default,,0000,0000,0000,,!ابتعدي
Dialogue: 0,0:04:45.44,0:04:46.84,Default,,0000,0000,0000,,لا تستطيعين السماع؟
Dialogue: 0,0:04:50.65,0:04:52.56,Default,,0000,0000,0000,,ستأخذون هذا لأحد عملائكم الأثرياء؟
Dialogue: 0,0:04:52.81,0:04:54.76,Default,,0000,0000,0000,,يا لإجحاف هذا العالم
Dialogue: 0,0:04:55.85,0:04:57.58,Default,,0000,0000,0000,,!أنت هناك
Dialogue: 0,0:04:57.89,0:05:01.01,Default,,0000,0000,0000,,!أجل، أنت! ضع المال في هذه
Dialogue: 0,0:05:03.26,0:05:06.46,Default,,0000,0000,0000,,!ليبتعد البقيّة عن الطاولة
Dialogue: 0,0:05:11.87,0:05:14.95,Default,,0000,0000,0000,,!حسناً، ابقوا ساكنين جميعاً
Dialogue: 0,0:05:14.95,0:05:17.30,Default,,0000,0000,0000,,!هيّا، ضع المال في الحقيبة
Dialogue: 0,0:05:24.28,0:05:26.09,Default,,0000,0000,0000,,ران، ماذا نفعل؟
Dialogue: 0,0:05:26.09,0:05:29.33,Default,,0000,0000,0000,,لا تقلقي، لن يقوم بشيءٍ إذا بقينا أماكننا
Dialogue: 0,0:06:09.78,0:06:10.45,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:06:10.98,0:06:12.65,Default,,0000,0000,0000,,!ماذا؟ أنت
Dialogue: 0,0:06:19.99,0:06:20.94,Default,,0000,0000,0000,,!ا-اصمتي
Dialogue: 0,0:06:21.34,0:06:23.91,Default,,0000,0000,0000,,!اهدئي! اصمتي
Dialogue: 0,0:06:24.34,0:06:26.55,Default,,0000,0000,0000,,!أخبرتكم أن تصمتوا
Dialogue: 0,0:06:30.55,0:06:31.27,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:06:51.68,0:06:59.13,Default,,0000,0000,0000,,أُصيب مايجيما-سان في جانب صدره، كان جرحاً بليغاً\Nلكن لا يهدد لحياته لحسن الحظ
Dialogue: 0,0:07:04.14,0:07:10.07,Default,,0000,0000,0000,,إذاً، عندما همّ مايجيما-سان بضرب الجاني\N...بسيف خشبيّ
Dialogue: 0,0:07:10.55,0:07:16.57,Default,,0000,0000,0000,,رنّ هذا الهاتف الخلويّ الذي كان\Nفي جيب مايجيما-سان؟
Dialogue: 0,0:07:16.57,0:07:22.27,Default,,0000,0000,0000,,نعم، استدار اللصّ للصوت بعدها\Nورأى مايجيما-كن وأطلق عليه
Dialogue: 0,0:07:23.28,0:07:28.70,Default,,0000,0000,0000,,وبعدها، اندفعتَ نحو اللصّ\Nيا تانيغوتشي-سان، صحيح؟
Dialogue: 0,0:07:29.95,0:07:34.31,Default,,0000,0000,0000,,رأيتُ تعرّض مايجيما للإطلاق\Nثمّ بدأت الفتيات بالصراخ
Dialogue: 0,0:07:34.31,0:07:36.15,Default,,0000,0000,0000,,ففزعت
Dialogue: 0,0:07:36.94,0:07:40.57,Default,,0000,0000,0000,,...فزع اللصّ بدوره، فوجّه المسدّس نحوهن
Dialogue: 0,0:07:41.01,0:07:43.95,Default,,0000,0000,0000,,...وعندما شعرتُ بخطورة الوضع، تحرّك جسدي
Dialogue: 0,0:07:44.26,0:07:48.62,Default,,0000,0000,0000,,كان همّي الوحيد توجيه\Nالمسدّس لمكانٍ آخر
Dialogue: 0,0:07:49.14,0:07:51.36,Default,,0000,0000,0000,,وبعدها حصل ما حصل
Dialogue: 0,0:07:54.46,0:07:55.67,Default,,0000,0000,0000,,مفتّش ميغوري
Dialogue: 0,0:07:56.79,0:07:59.91,Default,,0000,0000,0000,,انتهينا من التحليل فيمكنك الدخول الآن
Dialogue: 0,0:07:59.91,0:08:02.86,Default,,0000,0000,0000,,انتظروا هنا قليلاً من فضلكم
Dialogue: 0,0:08:03.58,0:08:06.28,Default,,0000,0000,0000,,كان المسدّس نموذج لعبة معدّل
Dialogue: 0,0:08:06.91,0:08:11.48,Default,,0000,0000,0000,,أيضاً، لم تظهر هذه الزاوية \Nفي تسجيل كاميرات المراقبة
Dialogue: 0,0:08:18.77,0:08:21.15,Default,,0000,0000,0000,,كان مع اللصّ هاتف خلويّ إذاً
Dialogue: 0,0:08:21.15,0:08:22.47,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:08:23.35,0:08:27.51,Default,,0000,0000,0000,,سايكي تورو، وُلِد في 1970
Dialogue: 0,0:08:28.72,0:08:29.66,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:08:31.42,0:08:35.18,Default,,0000,0000,0000,,هل يتعرّف أحدكم على وجه الجاني؟
Dialogue: 0,0:08:38.57,0:08:40.01,Default,,0000,0000,0000,,عذراً
Dialogue: 0,0:08:43.04,0:08:44.65,Default,,0000,0000,0000,,لم يكن هاتفي
Dialogue: 0,0:08:48.37,0:08:50.37,Default,,0000,0000,0000,,إنّه هاتف مايجيما-سان الخلويّ
Dialogue: 0,0:08:50.58,0:08:51.46,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:08:52.44,0:08:57.93,Default,,0000,0000,0000,,،مرحباً، أنا المفتّش ميغوري من مركز الشرطة\Nمن معي؟
Dialogue: 0,0:08:59.19,0:08:59.99,Default,,0000,0000,0000,,كويكي-سان؟
Dialogue: 0,0:09:00.40,0:09:02.69,Default,,0000,0000,0000,,أحد عملاء مايجيما-سان
Dialogue: 0,0:09:03.64,0:09:08.68,Default,,0000,0000,0000,,وقعت حادثة وأُصيب فيها\Nمايجيما-سان في الواقع
Dialogue: 0,0:09:08.68,0:09:13.48,Default,,0000,0000,0000,,اعذرني على السؤال، لكن هل اتّصلتَ\Nبهذا الهاتف عند قرابة الثالثة وخمس دقائق؟
Dialogue: 0,0:09:15.71,0:09:16.61,Default,,0000,0000,0000,,لم تفعل؟
Dialogue: 0,0:09:17.46,0:09:18.88,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:09:21.08,0:09:23.59,Default,,0000,0000,0000,,!دعني أسمع أيضاً
Dialogue: 0,0:09:24.20,0:09:26.74,Default,,0000,0000,0000,,كنتَ تسجّل أثناء السطو، صحيح؟
Dialogue: 0,0:09:29.04,0:09:33.69,Default,,0000,0000,0000,,لا ترفع صوتك! سأبيع هذا للإعلام\N!بمبلغ باهظ لاحقاً
Dialogue: 0,0:09:34.15,0:09:35.17,Default,,0000,0000,0000,,...في تلك الحالة
Dialogue: 0,0:09:36.86,0:09:38.57,Default,,0000,0000,0000,,ليس بيدي حيلة
Dialogue: 0,0:09:41.43,0:09:43.61,Default,,0000,0000,0000,,!لا تتحرّكوا! ابقوا ساكنين أماكنكم
Dialogue: 0,0:09:50.33,0:09:51.53,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:09:53.37,0:09:54.57,Default,,0000,0000,0000,,!يكفي
Dialogue: 0,0:09:55.66,0:09:58.90,Default,,0000,0000,0000,,كوّنا فكرة عن وضع الجريمة الآن
Dialogue: 0,0:09:59.24,0:10:00.50,Default,,0000,0000,0000,,حضرة الضابط
Dialogue: 0,0:10:01.15,0:10:03.68,Default,,0000,0000,0000,,هل سيُدان تانيغوتشي بما فعله؟
Dialogue: 0,0:10:04.02,0:10:04.94,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:10:04.94,0:10:10.72,Default,,0000,0000,0000,,،لو لم يندفع نحو اللصّ\Nلربما أطلق عليكم
Dialogue: 0,0:10:11.18,0:10:16.36,Default,,0000,0000,0000,,أبدى شجاعةً وخاطر بحياته
Dialogue: 0,0:10:16.72,0:10:19.81,Default,,0000,0000,0000,,من الحريّ أن يُكافأ، لكن لن يُدان البتّة
Dialogue: 0,0:10:20.18,0:10:23.47,Default,,0000,0000,0000,,!حقّاً؟! هذا رائع يا تانيغوتشي
Dialogue: 0,0:10:24.09,0:10:27.09,Default,,0000,0000,0000,,!علينا مُكافأتك بدورنا
Dialogue: 0,0:10:27.09,0:10:28.34,Default,,0000,0000,0000,,...لا
Dialogue: 0,0:10:30.00,0:10:32.67,Default,,0000,0000,0000,,لكن لم يحالف الحظّ مايجيما-سان
Dialogue: 0,0:10:32.99,0:10:35.65,Default,,0000,0000,0000,,لا نزال نجهل من اتّصل به
Dialogue: 0,0:10:36.70,0:10:43.57,Default,,0000,0000,0000,,،لكن لو لم يرنّ هاتفه مصادفةً آنذاك\Nلتفادى التعرّض للإطلاق
Dialogue: 0,0:10:44.94,0:10:48.14,Default,,0000,0000,0000,,!كلا، الجميع يسيئون الفهم
Dialogue: 0,0:10:57.43,0:10:58.18,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:11:06.75,0:11:11.34,Default,,0000,0000,0000,,لا يصحّ هذا يا ولد! إنّه غرضٌ مهم\Nفلا يمكنك العبث به
Dialogue: 0,0:11:12.12,0:11:15.05,Default,,0000,0000,0000,,تانيغوتشي-سان، علينا كتابة التقرير
Dialogue: 0,0:11:15.41,0:11:17.63,Default,,0000,0000,0000,,لذا هلّا رافقتنا للمركز لتقديم إفادتك؟
Dialogue: 0,0:11:18.24,0:11:19.54,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:11:20.94,0:11:22.68,Default,,0000,0000,0000,,عليّ الذهاب للحمّام قبلها
Dialogue: 0,0:11:22.68,0:11:23.47,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:11:36.35,0:11:38.29,Default,,0000,0000,0000,,ما-ما الخطب يا فتى؟
Dialogue: 0,0:11:38.93,0:11:39.72,Default,,0000,0000,0000,,تحتاج الذهاب للحمّام؟
Dialogue: 0,0:11:39.72,0:11:40.52,Default,,0000,0000,0000,,...نعم
Dialogue: 0,0:11:40.84,0:11:41.82,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:11:45.42,0:11:48.97,Default,,0000,0000,0000,,لمَ انتاب تانيغوتشي-سان الهلع وأخفى هاتفه؟
Dialogue: 0,0:11:49.84,0:11:52.72,Default,,0000,0000,0000,,...أكان يحاول الاتّصال بمكانٍ ما؟ أم
Dialogue: 0,0:11:53.58,0:11:56.98,Default,,0000,0000,0000,,!لعلّ هناك جانباً خلفياً لهذه القضيّة
Dialogue: 0,0:11:57.66,0:12:01.24,Default,,0000,0000,0000,,لم يخطر لي أن تكونا\Nعالقتين في القضيّة
Dialogue: 0,0:12:01.24,0:12:03.22,Default,,0000,0000,0000,,حمداً لله أنّكما لم تُصابا بأذى
Dialogue: 0,0:12:08.74,0:12:11.17,Default,,0000,0000,0000,,قفل أمان يُفتح ببطاقة
Dialogue: 0,0:12:16.35,0:12:18.05,Default,,0000,0000,0000,,!معطف تانيغوتشي-سان
Dialogue: 0,0:12:19.39,0:12:20.92,Default,,0000,0000,0000,,...صحيح، آنذاك
Dialogue: 0,0:12:21.67,0:12:23.84,Default,,0000,0000,0000,,ما الذي كان يبحث عنه الجاني؟
Dialogue: 0,0:12:24.51,0:12:27.93,Default,,0000,0000,0000,,...سجائر؟ قدّاحة؟ لا أظنّ
Dialogue: 0,0:12:28.34,0:12:29.15,Default,,0000,0000,0000,,ماذا إذاً؟
Dialogue: 0,0:12:34.21,0:12:35.71,Default,,0000,0000,0000,,...لا شيء
Dialogue: 0,0:12:37.04,0:12:39.22,Default,,0000,0000,0000,,...لحظة! رمى قبل ذلك
Dialogue: 0,0:12:45.45,0:12:47.55,Default,,0000,0000,0000,,كانت في هذه الأرجاء
Dialogue: 0,0:12:55.19,0:12:56.30,Default,,0000,0000,0000,,...هذه
Dialogue: 0,0:13:02.97,0:13:04.23,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:13:05.47,0:13:09.41,Default,,0000,0000,0000,,كان لهذه القضيّة جانب\N!خلفيّ مُظلم
Dialogue: 0,0:13:21.49,0:13:25.93,Default,,0000,0000,0000,,العمّ ليس موجوداً اليوم، لذا ليس بيدي\N!حيلة، سأعتمد على سونوكو مُجدداً
Dialogue: 0,0:13:26.70,0:13:28.41,Default,,0000,0000,0000,,آسفٌ على الإطالة
Dialogue: 0,0:13:28.41,0:13:32.51,Default,,0000,0000,0000,,نعتذر على مضايقتك\Nبعدما مررت به
Dialogue: 0,0:13:32.51,0:13:33.47,Default,,0000,0000,0000,,...ران، اسمعي
Dialogue: 0,0:13:35.23,0:13:37.90,Default,,0000,0000,0000,,ماذا يا سونوكو؟ سونوكو؟
Dialogue: 0,0:13:37.90,0:13:39.56,Default,,0000,0000,0000,,...مُجدداً
Dialogue: 0,0:13:41.84,0:13:43.09,Default,,0000,0000,0000,,!سونوكو؟
Dialogue: 0,0:13:43.43,0:13:45.30,Default,,0000,0000,0000,,حضرة المفتّش، لقد عرفت
Dialogue: 0,0:13:46.96,0:13:49.66,Default,,0000,0000,0000,,عرفتِ ماذا يا سونوكو-كن؟
Dialogue: 0,0:13:49.66,0:13:52.84,Default,,0000,0000,0000,,...لهذه القضيّة جانب خلفيّ
Dialogue: 0,0:13:52.84,0:13:53.62,Default,,0000,0000,0000,,...متغطٍّ
Dialogue: 0,0:13:53.90,0:13:56.56,Default,,0000,0000,0000,,خلفي... متغطٍّ؟
Dialogue: 0,0:13:56.61,0:13:57.96,Default,,0000,0000,0000,,!أقصد جانب خفيّ
Dialogue: 0,0:13:58.36,0:14:01.58,Default,,0000,0000,0000,,!من الصعب الكلام كفتاة
Dialogue: 0,0:14:02.52,0:14:07.86,Default,,0000,0000,0000,,بدايةً، الرنين الذي صدر عندما همّ\Nمايجيما-سان بمهاجمة الجاني بالسيف الخشبيّ
Dialogue: 0,0:14:08.18,0:14:12.17,Default,,0000,0000,0000,,!لم يكن من هاتفه، بل هاتف الجاني
Dialogue: 0,0:14:12.45,0:14:18.41,Default,,0000,0000,0000,,مستحيل! الجميع متأكدون أنّ الرنين\N!صدر من هاتف مايجيما-سان وقتها
Dialogue: 0,0:14:18.41,0:14:21.95,Default,,0000,0000,0000,,،لكن عندما رنّ هاتفه قبل قليل
Dialogue: 0,0:14:21.95,0:14:26.20,Default,,0000,0000,0000,,مددتَ وتانيغوتشي-سان يديكما\Nبالخطأ لهاتفيكما
Dialogue: 0,0:14:26.58,0:14:32.86,Default,,0000,0000,0000,,بنفس الشكل، اعتقد الجميع آنذاك\Nأنّ هاتف مايجيما-سان كان من أصدر الرنين
Dialogue: 0,0:14:35.15,0:14:41.81,Default,,0000,0000,0000,,ذلك مُحتمل بالفعل، لكن ما الذي يجعلك\Nمقتنعة أنّه كان هاتف اللصّ بالفعل؟
Dialogue: 0,0:14:41.81,0:14:43.08,Default,,0000,0000,0000,,نغمة الرنين
Dialogue: 0,0:14:43.08,0:14:44.37,Default,,0000,0000,0000,,نغمة الرنين؟
Dialogue: 0,0:14:45.02,0:14:51.76,Default,,0000,0000,0000,,قارن نغمتَي هاتف مايجيما-سان واللصّ\Nوسترى بنفسك
Dialogue: 0,0:14:51.76,0:14:57.20,Default,,0000,0000,0000,,أيضاً، قام الطالب الجامعيّ بتسجيل النغمة\Nالتي صدرت وقت الجريمة
Dialogue: 0,0:14:58.20,0:15:01.07,Default,,0000,0000,0000,,!أهذا صحيح؟! هل سجّلتها؟
Dialogue: 0,0:15:01.79,0:15:02.54,Default,,0000,0000,0000,,!لا
Dialogue: 0,0:15:02.93,0:15:04.21,Default,,0000,0000,0000,,!لا تكذب يا هذا
Dialogue: 0,0:15:05.06,0:15:07.27,Default,,0000,0000,0000,,...فعلتُها مجدداً
Dialogue: 0,0:15:08.01,0:15:11.62,Default,,0000,0000,0000,,،لا، أقصد أنّ الكذب لن ينفعك\N!فأنا متأكدة
Dialogue: 0,0:15:12.15,0:15:16.12,Default,,0000,0000,0000,,!إذاً؟ تعاون معنا إذا التسجيل معك
Dialogue: 0,0:15:17.03,0:15:20.53,Default,,0000,0000,0000,,!حسناً، لكن فلتعيدوه لاحقاً رجاءً
Dialogue: 0,0:15:22.03,0:15:24.49,Default,,0000,0000,0000,,!حضرة المفتّش، أحضرت مشغّل كاسيت
Dialogue: 0,0:15:26.05,0:15:27.61,CharCard,,0000,0000,0000,,مايجيما
Dialogue: 0,0:15:28.13,0:15:29.12,CharCard,,0000,0000,0000,,اللصّ
Dialogue: 0,0:15:29.12,0:15:30.70,Default,,0000,0000,0000,,سأبدأ إذاً
Dialogue: 0,0:15:30.70,0:15:31.60,Default,,0000,0000,0000,,فلتفعل
Dialogue: 0,0:15:32.22,0:15:35.05,Default,,0000,0000,0000,,هاتف مايجيما-سان أولاً
Dialogue: 0,0:15:37.34,0:15:41.17,Default,,0000,0000,0000,,ثمّ، هاتف اللصّ تالياً
Dialogue: 0,0:15:44.54,0:15:47.67,Default,,0000,0000,0000,,الصوت نفسه، لكنّ نمطه مختلف
Dialogue: 0,0:15:47.67,0:15:49.46,Default,,0000,0000,0000,,...وهذا الرنين وقت الحادثة
Dialogue: 0,0:15:50.41,0:15:52.53,Default,,0000,0000,0000,,!اصمتي! اصمتي
Dialogue: 0,0:15:52.53,0:15:54.12,Default,,0000,0000,0000,,قبل ذلك بقليل
Dialogue: 0,0:15:54.70,0:15:55.91,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:16:01.98,0:16:04.12,Default,,0000,0000,0000,,!ارجع مجدداً
Dialogue: 0,0:16:04.12,0:16:04.95,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:16:12.05,0:16:16.33,Default,,0000,0000,0000,,هذا نمط نغمة رنين \Nهاتف اللصّ بالفعل
Dialogue: 0,0:16:16.97,0:16:19.26,Default,,0000,0000,0000,,سونوكو-كن، كما قلتِ
Dialogue: 0,0:16:19.26,0:16:23.96,Default,,0000,0000,0000,,يبدو أنّ هاتف اللصّ كان\Nما أصدر الرنين وقتها
Dialogue: 0,0:16:23.96,0:16:29.29,Default,,0000,0000,0000,,...هل اتّصل أحدهم بهاتفه مصادفةً؟ أم
Dialogue: 0,0:16:29.29,0:16:32.24,Default,,0000,0000,0000,,كان شريكه من اتّصل غالباً
Dialogue: 0,0:16:32.70,0:16:34.20,Default,,0000,0000,0000,,!شريكه؟
Dialogue: 0,0:16:34.78,0:16:39.16,Default,,0000,0000,0000,,رأى ذاك الشريك استعداد مايجيما-سان\Nلضرب اللصّ بالسيف الخشبيّ
Dialogue: 0,0:16:40.03,0:16:44.24,Default,,0000,0000,0000,,فاتّصل بهاتف اللصّ سريعاً\N!باستعمال هاتفه الخاص
Dialogue: 0,0:16:45.29,0:16:47.15,Default,,0000,0000,0000,,لتنبيهه على الخطر
Dialogue: 0,0:16:47.15,0:16:52.74,Default,,0000,0000,0000,,،مـ-ماذا؟! في تلك الحالة\N!لا يزال الشريك موجوداً هنا
Dialogue: 0,0:16:55.47,0:17:00.01,Default,,0000,0000,0000,,نعم، وذلك الشريك هو\N!أنت يا تانيغوتشي-سان
Dialogue: 0,0:17:01.84,0:17:05.29,Default,,0000,0000,0000,,ما الذي تقولينه؟\Nتوقّفي عن المزاح رجاءً
Dialogue: 0,0:17:05.67,0:17:06.88,Default,,0000,0000,0000,,تانيغوتشي-سان
Dialogue: 0,0:17:06.88,0:17:11.20,Default,,0000,0000,0000,,قمتَ أوّلاً بالاتّصال باللصّ الذي\Nكان ينتظر قرب المصرف خارجاً
Dialogue: 0,0:17:11.78,0:17:13.99,Default,,0000,0000,0000,,لإخباره باللحظة المناسبة للاقتحام
Dialogue: 0,0:17:13.99,0:17:19.93,Default,,0000,0000,0000,,ذلك لأنّ الباب المخصّص للموظفين\Nيُفتح من الداخل عندما يغادر أحدهم
Dialogue: 0,0:17:20.23,0:17:22.73,Default,,0000,0000,0000,,!لكنّك تحتاج بطاقة للدخول من الخارج
Dialogue: 0,0:17:27.15,0:17:29.91,Default,,0000,0000,0000,,حضرة المدير، سأذهب لإجراء الجولات الآن
Dialogue: 0,0:17:29.91,0:17:31.32,Default,,0000,0000,0000,,أجل، هكذا
Dialogue: 0,0:17:33.56,0:17:37.35,Default,,0000,0000,0000,,تمهلي قليلاً، سأذهب لجلب اللائحة
Dialogue: 0,0:17:37.56,0:17:38.37,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:17:46.25,0:17:48.89,Default,,0000,0000,0000,,!ارفعوا أيديكم جميعاً وقفوا أماكنكم
Dialogue: 0,0:17:49.27,0:17:54.66,Default,,0000,0000,0000,,بعدها، ملأت الحقيبة بالنقود\Nتحت أمر اللصّ وفقما خططتما
Dialogue: 0,0:17:55.24,0:17:58.41,Default,,0000,0000,0000,,وكنتَ الوحيد خلف طاولة الموظّفين
Dialogue: 0,0:17:58.41,0:18:02.41,Default,,0000,0000,0000,,تذكرتُ الآن، لم يبدِ أي اهتمام تجاهك
Dialogue: 0,0:18:03.07,0:18:06.83,Default,,0000,0000,0000,,كانت خطّتك تتضمّن ألّا يؤذي اللصّ أحداً
Dialogue: 0,0:18:07.00,0:18:10.76,Default,,0000,0000,0000,,وأن يهرب بعد استلامه الحقيبة\Nالمليئة بالمال منك
Dialogue: 0,0:18:10.95,0:18:14.85,Default,,0000,0000,0000,,كنتما ستلتقيان لاحقاً لاقتسام النقود
Dialogue: 0,0:18:16.10,0:18:19.89,Default,,0000,0000,0000,,!لكن وقع أمرٌ خارج الحسبان
Dialogue: 0,0:18:21.05,0:18:23.94,Default,,0000,0000,0000,,!استرجع مايجيما-سان وعيه
Dialogue: 0,0:18:33.08,0:18:36.04,Default,,0000,0000,0000,,أردتَ تنبيهه بشكلٍ ما
Dialogue: 0,0:18:36.91,0:18:39.50,Default,,0000,0000,0000,,،أردتَ أن تصرخ "وراءك!" في الواقع
Dialogue: 0,0:18:39.50,0:18:42.11,Default,,0000,0000,0000,,لكن كان ذلك ليكشف أمرك
Dialogue: 0,0:18:42.40,0:18:44.10,Default,,0000,0000,0000,,،عندها فكّرتَ سريعاً
Dialogue: 0,0:18:44.78,0:18:47.75,Default,,0000,0000,0000,,وضغطت زرّ إعادة الاتّصال على الهاتف
Dialogue: 0,0:18:48.61,0:18:53.87,Default,,0000,0000,0000,,رنّ هاتف اللصّ، لكن ظنّ مايجيما-سان\Nأنّه كان هاتفه
Dialogue: 0,0:18:53.95,0:18:56.24,Default,,0000,0000,0000,,وتعرّض للإطلاق عندما توقّف مكانه
Dialogue: 0,0:19:00.88,0:19:06.11,Default,,0000,0000,0000,,أكبر خلل في الحسابات كان برأيك\Nعندما أطلق على مايجيما-سان
Dialogue: 0,0:19:06.58,0:19:10.85,Default,,0000,0000,0000,,فقد اللصّ تماسكه فجأةً، وبدا أنّه قد\Nيطلق على البقيّة
Dialogue: 0,0:19:11.54,0:19:15.16,Default,,0000,0000,0000,,أدركتَ أنّ الاستمرار بالخطّة قد \N...يكون خطيراً، فقفزت عليه
Dialogue: 0,0:19:19.00,0:19:24.87,Default,,0000,0000,0000,,وأسكتّه بالتظاهر بمحاولتك إبعاد المسدّس\Nبينما أطلقت عليه
Dialogue: 0,0:19:25.10,0:19:27.83,Default,,0000,0000,0000,,هذا هراء، إنّها ادّعاءات لا أساس لها فحسب
Dialogue: 0,0:19:29.45,0:19:32.10,Default,,0000,0000,0000,,هلّا أريتنا هاتفك الخلويّ؟
Dialogue: 0,0:19:32.10,0:19:38.71,Default,,0000,0000,0000,,إذا كانت محقّة، فسيطلب زرّ إعادة الاتّصال\Nرقم هاتف اللصّ
Dialogue: 0,0:19:39.39,0:19:40.45,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:19:40.45,0:19:41.73,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:19:42.08,0:19:46.17,Default,,0000,0000,0000,,محوتَ ذاكرة إعادة الاتّصال\N!عندما ذهبت للحمّام قبل قليل
Dialogue: 0,0:19:47.29,0:19:50.76,Default,,0000,0000,0000,,حضرة المفتّش، يوجد دليل دامغ\Nيثبت كونهما شريكين
Dialogue: 0,0:19:51.03,0:19:52.82,Default,,0000,0000,0000,,!حقّاً يا سونوكو-كن؟
Dialogue: 0,0:19:52.82,0:19:54.37,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:19:54.37,0:19:55.49,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:19:57.41,0:20:00.36,Default,,0000,0000,0000,,حضرة المفتّش، افتح يديك
Dialogue: 0,0:20:01.40,0:20:03.03,Default,,0000,0000,0000,,هكذا؟
Dialogue: 0,0:20:03.03,0:20:03.56,Default,,0000,0000,0000,,!هاك
Dialogue: 0,0:20:05.48,0:20:06.99,Default,,0000,0000,0000,,ما هذه؟
Dialogue: 0,0:20:07.36,0:20:11.94,Default,,0000,0000,0000,,حبوب سعال، أعطاني إيّاها تانيغوتشي-سان\Nقبل وقوع السرقة
Dialogue: 0,0:20:14.01,0:20:16.47,Default,,0000,0000,0000,,!سونوكو-نيتشان! أنا من أعطيته إيّاها
Dialogue: 0,0:20:16.47,0:20:19.97,Default,,0000,0000,0000,,حضرة المفتّش، الورقة في يدك اليمنى\Nهي التي ألقاها اللصّ
Dialogue: 0,0:20:19.97,0:20:24.53,Default,,0000,0000,0000,,بعد فعله ذلك، كان ينبش في جيوب\Nمعطف تانيغوتشي-سان
Dialogue: 0,0:20:25.00,0:20:27.43,Default,,0000,0000,0000,,كان يبحث عن دواء السعال
Dialogue: 0,0:20:28.34,0:20:32.70,Default,,0000,0000,0000,,التقى مع تانيغوتشي-سان\Nظهيرة اليوم في مكانٍ ما غالباً
Dialogue: 0,0:20:32.70,0:20:35.21,Default,,0000,0000,0000,,لأجل اجتماعٍ أخير
Dialogue: 0,0:20:35.44,0:20:38.06,Default,,0000,0000,0000,,كان الاثنان يعانيان من الزكام وحنجرة ملتهبة
Dialogue: 0,0:20:38.12,0:20:43.09,Default,,0000,0000,0000,,فقسم أحدهما دواء السعال الذي معه\Nلنصفين وأعطاه للآخر
Dialogue: 0,0:20:43.44,0:20:47.98,Default,,0000,0000,0000,,بعدها، أصبحت حنجرة اللصّ\Nتؤلمه مجدداً عند وصوله إلى هنا
Dialogue: 0,0:20:47.98,0:20:52.35,Default,,0000,0000,0000,,،أدخل يده في جيبه لإخراج الحبوب\Nلكن كانت قد نفدت
Dialogue: 0,0:20:52.43,0:20:54.83,Default,,0000,0000,0000,,ولم يبق إلّا الغلاف
Dialogue: 0,0:20:55.43,0:21:00.35,Default,,0000,0000,0000,,عندها، تذكّر اللصّ أنّ تانيغوتشي-سان\Nيملك نصفاً في جيب معطفه
Dialogue: 0,0:21:00.42,0:21:01.78,Default,,0000,0000,0000,,وحاول أخذه
Dialogue: 0,0:21:02.09,0:21:05.44,Default,,0000,0000,0000,,في جهله من إعطاء تانيغوتشي-سان\Nإيّاها لكونان
Dialogue: 0,0:21:06.05,0:21:10.87,Default,,0000,0000,0000,,ودليلاً على ذلك، يُفترض أن يتّصل\N!نصفا الغلاف تماماً
Dialogue: 0,0:21:12.74,0:21:13.90,Default,,0000,0000,0000,,!إنّها الحقيقة
Dialogue: 0,0:21:14.74,0:21:22.40,Default,,0000,0000,0000,,أيضاً، بصمات تانيغوتشي-سان أو القاتل\Nستكون على النصفين معاً
Dialogue: 0,0:21:22.78,0:21:24.81,Default,,0000,0000,0000,,اطلب فحصهما فوراً
Dialogue: 0,0:21:24.81,0:21:25.55,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:21:26.23,0:21:29.41,Default,,0000,0000,0000,,تانيغوتشي-سان، هل لديك ما تقوله؟
Dialogue: 0,0:21:32.27,0:21:34.65,Default,,0000,0000,0000,,كان سايكي من أعطاني حبوب السعال
Dialogue: 0,0:21:36.10,0:21:38.56,Default,,0000,0000,0000,,التقيتُه عبر مُرابي قروض
Dialogue: 0,0:21:38.56,0:21:43.32,Default,,0000,0000,0000,,وخطّطنا لعملية السطو هذه\Nلردّ الديون واللهو بالمال الزائد
Dialogue: 0,0:21:45.30,0:21:47.26,Default,,0000,0000,0000,,،لو كنتُ أعرف حصول هذا
Dialogue: 0,0:21:47.35,0:21:50.91,Default,,0000,0000,0000,,لما أعطيتُك حبوب السعال
Dialogue: 0,0:23:26.93,0:23:31.02,Default,,0000,0000,0000,,!مُذهل يا سونوكو! حللتِ قضيّة أخرى
Dialogue: 0,0:23:31.54,0:23:36.33,Default,,0000,0000,0000,,لا أتذكّر الكثير، لكنّي شعرت\N...بوخز إبرة وراء عنقي
Dialogue: 0,0:23:36.33,0:23:37.42,Default,,0000,0000,0000,,وخز؟
Dialogue: 0,0:23:36.76,0:23:37.42,On Top,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:23:37.42,0:23:40.24,Default,,0000,0000,0000,,لكن، لم يعد شينتشي-كن يحتلّ الساحة
Dialogue: 0,0:23:41.57,0:23:46.51,Default,,0000,0000,0000,,الأضواء الآن ستُسلّط على متحريّة المدرسة الثانوية\N!الظريفة والساحرة، سوزوكي سونوكو
Dialogue: 0,0:23:49.90,0:23:53.81,Default,,0000,0000,0000,,!تبّاً! كان عليّ ألّا أستعملها حقّاً
Dialogue: 0,0:23:57.10,0:23:58.16,Default,,0000,0000,0000,,...يا للندم
Dialogue: 0,0:24:01.93,0:24:05.30,Default,,0000,0000,0000,,..أنا لها! سأمسكها
Dialogue: 0,0:24:06.10,0:24:07.60,Default,,0000,0000,0000,,أأنت بخيرٍ يا غينتا؟
Dialogue: 0,0:24:08.69,0:24:09.80,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:24:11.55,0:24:13.89,Default,,0000,0000,0000,,!خُنق بما يشبه الخيط
Dialogue: 0,0:24:14.25,0:24:15.73,Default,,0000,0000,0000,,!جريمة قتل؟
Dialogue: 0,0:24:17.55,0:24:20.18,Default,,0000,0000,0000,,لم تكن هذه مجرّد سرقة
Dialogue: 0,0:24:20.42,0:24:21.72,Default,,0000,0000,0000,,!إنّها القاتلة
Dialogue: 0,0:24:22.71,0:24:24.19,Default,,0000,0000,0000,,لكن لا دليل لديّ
Dialogue: 0,0:24:24.19,0:24:30.18,On Top,,0000,0000,0000,,جريمة قتل الفنّان المتجوّل
Dialogue: 0,0:24:25.08,0:24:26.58,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.58,0:24:29.23,Default,,0000,0000,0000,,جريمة قتل الفنّان المتجوّل
Dialogue: 0,0:24:46.01,0:24:48.14,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.34,0:24:50.13,On Top,,0000,0000,0000,,تنظيف منزليّ
Dialogue: 0,0:24:50.35,0:24:52.49,Default,,0000,0000,0000,,البحث عن دليل سيكون صعباً\N!في الحلقة القادمة
Dialogue: 0,0:24:52.49,0:24:53.61,Default,,0000,0000,0000,,!هي المجرمة
Dialogue: 0,0:24:53.61,0:24:55.61,Default,,0000,0000,0000,,نعرف ذلك

