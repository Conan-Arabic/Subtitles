Dialogue: 0,0:00:01.04,0:00:02.87,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:02.87,0:00:06.82,Default,,0000,0000,0000,,تُعالج استنتاجات كونان القلوب\Nالمُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:06.82,0:00:10.56,Default,,0000,0000,0000,,!تلميح اليوم سرطانات وحوت! أشياء غير متوقعة تبدو مثلها
Dialogue: 0,0:00:10.56,0:00:12.44,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.44,0:00:14.43,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.43,0:00:16.43,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.25,0:01:57.21,Title,,0000,0000,0000,,{\fad(300,0)}قضيّة اختطاف السرطانات والحوت
Dialogue: 0,0:01:52.17,0:01:54.77,Default,,0000,0000,0000,,قضيّة اختطاف السرطانات والحوت
Dialogue: 0,0:02:03.17,0:02:04.42,Default,,0000,0000,0000,,!نخبكم
Dialogue: 0,0:02:12.32,0:02:15.92,Default,,0000,0000,0000,,!لذيذ! لا غنى عن الجعّة في الصيف
Dialogue: 0,0:02:16.19,0:02:20.85,Default,,0000,0000,0000,,.أبي، لا يجدر بك الاكتفاء بالشرب\Nعليك الأكل قليلاً
Dialogue: 0,0:02:20.85,0:02:23.08,Default,,0000,0000,0000,,أجل، أفهم. لا تنقِّي
Dialogue: 0,0:02:23.56,0:02:27.96,Default,,0000,0000,0000,,أتيتُ متحمساً بعدما قال\Nأنّنا سنتعشّى في فندق فاخر
Dialogue: 0,0:02:28.35,0:02:30.75,Default,,0000,0000,0000,,لكنّها ليست سوى مجرّد أكلات جانبيّة مع شراب
Dialogue: 0,0:02:31.59,0:02:35.30,Default,,0000,0000,0000,,من يصطحب أطفالاً لحدائق جعّة للأكل؟
Dialogue: 0,0:02:39.14,0:02:42.83,CharCard,,0000,0000,0010,,(إيندو كيغو (33\Nطبيب أسنان
Dialogue: 0,0:02:47.75,0:02:52.50,Default,,0000,0000,0000,,هذا الرجل في حديقة جعّة، لكنه لم يشرب ولا قطرة
Dialogue: 0,0:02:59.14,0:03:01.48,Default,,0000,0000,0000,,هل ثملت من الآن يا أبي؟
Dialogue: 0,0:03:01.48,0:03:02.84,Default,,0000,0000,0000,,...كلا
Dialogue: 0,0:03:04.52,0:03:05.90,Default,,0000,0000,0000,,أين تذهب؟
Dialogue: 0,0:03:05.90,0:03:07.55,Default,,0000,0000,0000,,دورة المياه
Dialogue: 0,0:03:07.98,0:03:13.34,Default,,0000,0000,0000,,...ليست من ذاك الاتّجاه! لا أمل منك حقّاً
Dialogue: 0,0:03:14.75,0:03:16.32,Default,,0000,0000,0000,,!تعال
Dialogue: 0,0:03:16.32,0:03:17.47,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:03:29.78,0:03:31.38,Default,,0000,0000,0000,,أجل، معك إيندو
Dialogue: 0,0:03:32.45,0:03:35.72,Default,,0000,0000,0000,,أجل، أجل. أنا بمفردي
Dialogue: 0,0:03:35.72,0:03:37.46,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:03:43.64,0:03:47.96,Default,,0000,0000,0000,,لمَ أُلغيت الصفقة؟ جهّزتُ المال\N!ولم أخبر الشرطة
Dialogue: 0,0:03:48.77,0:03:52.67,Default,,0000,0000,0000,,!انتظر! دعني أسمع صوت كيتا مُجدداً\Nمرحباً؟ مرحباً؟
Dialogue: 0,0:03:53.26,0:03:55.34,Default,,0000,0000,0000,,...أيمكن أنّ هذا الشخص
Dialogue: 0,0:04:04.75,0:04:06.71,Default,,0000,0000,0000,,!عمّ! ران-نيتشان
Dialogue: 0,0:04:07.00,0:04:08.62,Default,,0000,0000,0000,,!لنخرج من هنا سريعاً
Dialogue: 0,0:04:08.62,0:04:10.16,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:04:11.24,0:04:15.38,Default,,0000,0000,0000,,لا يمكنني رفع صوتي، لكن أظنّ أن اختطافاً وقع
Dialogue: 0,0:04:15.78,0:04:16.84,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:04:27.40,0:04:34.47,Default,,0000,0000,0000,,كما قلت، هناك احتمال عالٍ باختطافهم ابنه\Nوطلب فدية مالية مقابله
Dialogue: 0,0:04:34.47,0:04:37.42,Default,,0000,0000,0000,,أجل، يبدو أنّه لم يخبر الشرطة
Dialogue: 0,0:04:39.04,0:04:43.38,Default,,0000,0000,0000,,حضرة السائق، احرص على ألّا تفقد سيّارة الأجرة أمامنا
Dialogue: 0,0:04:43.38,0:04:44.42,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:04:46.09,0:04:48.88,On Top,,0000,0000,0000,,عيادة إيندو الطبيّة للأسنان
Dialogue: 0,0:05:04.00,0:05:06.94,On Top,,0000,0000,0000,,مُغلق
Dialogue: 0,0:05:05.02,0:05:06.56,Default,,0000,0000,0000,,طبيب أسنان إذاً؟
Dialogue: 0,0:05:07.19,0:05:09.93,Default,,0000,0000,0000,,ماذا سنفعل الآن يا أبي؟
Dialogue: 0,0:05:09.93,0:05:13.60,Default,,0000,0000,0000,,...علينا اللقاء به والكلام معه أوّلاً
Dialogue: 0,0:05:13.60,0:05:17.01,Default,,0000,0000,0000,,لكن لا نعرف من أين يراقب الخاطف
Dialogue: 0,0:05:17.01,0:05:19.84,Default,,0000,0000,0000,,وقد يكون أحد الجيران
Dialogue: 0,0:05:19.84,0:05:21.92,Default,,0000,0000,0000,,علينا توخّي الحذر
Dialogue: 0,0:05:22.50,0:05:25.88,Default,,0000,0000,0000,,!لديّ فكرة جيّدة! سأكون مريضاً
Dialogue: 0,0:05:26.42,0:05:27.84,Default,,0000,0000,0000,,مريض؟
Dialogue: 0,0:05:30.99,0:05:32.74,Default,,0000,0000,0000,,حسناً، ابدأ
Dialogue: 0,0:05:32.74,0:05:35.96,Default,,0000,0000,0000,,!ضرسي يؤلمني! أونيتشان
Dialogue: 0,0:05:36.87,0:05:40.29,On Top,,0000,0000,0000,,!مؤلم! مؤلم! مؤلم
Dialogue: 0,0:05:36.87,0:05:43.21,Default,,0000,0000,0000,,!اصبر قليلاً! سيكلّم أبي الطبيب الآن
Dialogue: 0,0:05:40.29,0:05:43.19,On Top,,0000,0000,0000,,!لا أستطيع الاحتمال
Dialogue: 0,0:05:43.48,0:05:47.19,Default,,0000,0000,0000,,!لا، لا أستطيع الصبر! مؤلم
Dialogue: 0,0:05:47.19,0:05:48.23,Default,,0000,0000,0000,,نعم؟
Dialogue: 0,0:05:48.23,0:05:51.14,Default,,0000,0000,0000,,أعتذر على مقاطعة راحتك
Dialogue: 0,0:05:51.14,0:05:55.31,Default,,0000,0000,0000,,لديّ صغير هنا تؤلمه أسنانه\Nولا يستطيع التحمّل
Dialogue: 0,0:05:55.31,0:05:56.92,Default,,0000,0000,0000,,هلّا ألقيت نظرةً عليه؟
Dialogue: 0,0:05:56.92,0:05:59.37,Default,,0000,0000,0000,,!مؤلم! لا أستطيع الاحتمال
Dialogue: 0,0:05:59.80,0:06:03.63,Default,,0000,0000,0000,,حسناً... تفضّلوا بالدخول
Dialogue: 0,0:06:03.63,0:06:06.30,Default,,0000,0000,0000,,!مؤلم! مؤلم
Dialogue: 0,0:06:07.21,0:06:08.80,Default,,0000,0000,0000,,ادخلوا
Dialogue: 0,0:06:08.80,0:06:11.13,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:06:13.88,0:06:14.63,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:06:15.95,0:06:17.21,Default,,0000,0000,0000,,!آخ
Dialogue: 0,0:06:17.62,0:06:20.92,Default,,0000,0000,0000,,!يكفي! إلى متى ستواصل هذا؟
Dialogue: 0,0:06:21.36,0:06:24.38,Default,,0000,0000,0000,,تـ-توجّهوا لغرفة الفحص من فضلكم
Dialogue: 0,0:06:25.74,0:06:30.29,Default,,0000,0000,0000,,،اعذرني على التأخر بالتعريف بنفسي\Nأنا المتحرّي موري كوغورو
Dialogue: 0,0:06:31.18,0:06:34.75,Default,,0000,0000,0000,,موري كوغورو؟ ذاك المتحرّي الشهير؟
Dialogue: 0,0:06:39.88,0:06:44.34,Default,,0000,0000,0000,,فهمت، سمع كونان-كن مكالمتي إذاً
Dialogue: 0,0:06:44.80,0:06:48.51,Default,,0000,0000,0000,,إيندو-سان، هلّا أخبرتنا بالموضوع؟
Dialogue: 0,0:06:48.51,0:06:52.04,Default,,0000,0000,0000,,إن ما قاله الولد صحيحاً، فيمكنني مساعدتك
Dialogue: 0,0:06:55.25,0:06:58.90,Default,,0000,0000,0000,,حسناً، قد يكون هذا القدر
Dialogue: 0,0:06:58.90,0:07:02.46,Default,,0000,0000,0000,,كما قلتم، اُختطف ابني
Dialogue: 0,0:07:03.24,0:07:04.42,Default,,0000,0000,0000,,اسمه كيتا
Dialogue: 0,0:07:04.90,0:07:08.38,Default,,0000,0000,0000,,تركته يلعب بمفرده في الفناء\N...الأمامي ظهيرة اليوم، لكن
Dialogue: 0,0:07:09.48,0:07:12.70,Default,,0000,0000,0000,,كيتا، ما رأيك أن نذهب للحديقة؟
Dialogue: 0,0:07:12.70,0:07:14.18,Default,,0000,0000,0000,,كيتا؟
Dialogue: 0,0:07:18.01,0:07:22.96,Default,,0000,0000,0000,,"أخذتُ الصبيّ، إذا اتّصلت بالشرطة سأقتله. انتظر اتّصالي"
Dialogue: 0,0:07:28.87,0:07:31.71,Default,,0000,0000,0000,,إنّها مكتوبة على ورقة طباعة عادية
Dialogue: 0,0:07:32.71,0:07:35.00,Default,,0000,0000,0000,,بما أخبرك الخاطف إذاً؟
Dialogue: 0,0:07:35.00,0:07:38.75,Default,,0000,0000,0000,,كان صوت رجل شاب على الهاتف
Dialogue: 0,0:07:38.75,0:07:42.86,Default,,0000,0000,0000,,أخبرني بوضع 30 مليون ين\Nبعملات قديمة في حقيبة
Dialogue: 0,0:07:42.86,0:07:48.53,Default,,0000,0000,0000,,والتواجد في حديقة الجعّة لفندق\Nستارلايت عند السادسة
Dialogue: 0,0:07:48.53,0:07:56.96,Default,,0000,0000,0000,,لكن بعد السادسة بقليل، اتّصل بي\Nوأنا أنتظر وألغى الصفقة فجأةً
Dialogue: 0,0:07:57.39,0:08:00.05,Default,,0000,0000,0000,,أوضّح السبب؟
Dialogue: 0,0:08:00.05,0:08:05.34,Default,,0000,0000,0000,,كلا، كلّ ما قاله أنّه سيعاود\Nالاتّصال صباح الغد
Dialogue: 0,0:08:05.34,0:08:08.35,Default,,0000,0000,0000,,لعلّ حادثاً ما اعترضه
Dialogue: 0,0:08:09.00,0:08:12.42,Default,,0000,0000,0000,,لم ينو أخذ المال الليلة من البداية غالباً
Dialogue: 0,0:08:12.42,0:08:16.29,Default,,0000,0000,0000,,كان يشاهد إيندو-سان\Nمن مكان ما في حديقة الجعّة
Dialogue: 0,0:08:16.29,0:08:19.66,Default,,0000,0000,0000,,ليتأكد من أنّه لم يتّصل بالشرطة على الأرجح
Dialogue: 0,0:08:20.20,0:08:25.20,Default,,0000,0000,0000,,،عندما تلقّيت الاتّصال الأوّل\Nأسمعت صوت كيتا-كن؟
Dialogue: 0,0:08:25.20,0:08:28.81,Default,,0000,0000,0000,,أجل، طلبتُ من الخاطف إعطاءه الهاتف
Dialogue: 0,0:08:28.81,0:08:31.73,Default,,0000,0000,0000,,كيف بدا كيتا-كن؟
Dialogue: 0,0:08:31.73,0:08:36.88,Default,,0000,0000,0000,,كان مُبتهجاً لحدّ مُفاجئ، ولم يبد خائفاً البتّة
Dialogue: 0,0:08:37.31,0:08:42.58,Default,,0000,0000,0000,,هذا غريب، تتوقّع أن يفتقد أمّه في العادة
Dialogue: 0,0:08:42.89,0:08:45.00,Default,,0000,0000,0000,,لا أمّ لديه
Dialogue: 0,0:08:47.01,0:08:49.33,Default,,0000,0000,0000,,توفّيت بمرض في العام الفائت
Dialogue: 0,0:08:49.33,0:08:54.46,Default,,0000,0000,0000,,لذا أصبح كيتا متعلّقاً بمعلّمته في الحضانة
Dialogue: 0,0:08:54.46,0:08:57.13,Default,,0000,0000,0000,,ونساء الحيّ غالباً
Dialogue: 0,0:08:57.46,0:09:00.82,Default,,0000,0000,0000,,فهمت، توضّح الأمر الآن
Dialogue: 0,0:09:00.82,0:09:05.62,Default,,0000,0000,0000,,يعمل الخاطف مع امرأة تجيد\Nالتعامل مع الأطفال غالباً
Dialogue: 0,0:09:05.62,0:09:08.46,Default,,0000,0000,0000,,وهي من يعتني بكيتا-كن
Dialogue: 0,0:09:09.36,0:09:12.02,Default,,0000,0000,0000,,قد يكون العمّ مُحقاً
Dialogue: 0,0:09:12.02,0:09:19.37,Default,,0000,0000,0000,,،ما يعني لا يمكننا الاسترخاء\Nلكن ليس من المُحتمل أنّهم سيؤذون كيتا-كن
Dialogue: 0,0:09:19.85,0:09:25.59,Default,,0000,0000,0000,,...إيندو-سان، يُفترض عادةً أن نتّصل بالشرطة
Dialogue: 0,0:09:26.09,0:09:28.38,Default,,0000,0000,0000,,!لا يمكنني ذلك
Dialogue: 0,0:09:28.75,0:09:32.46,Default,,0000,0000,0000,,ربما سيُقبض على الخاطف إذا تدّخلت الشرطة
Dialogue: 0,0:09:32.46,0:09:36.34,Default,,0000,0000,0000,,!لكن ما ضمان أن يرجع كيتا سالماً؟
Dialogue: 0,0:09:36.79,0:09:38.34,Default,,0000,0000,0000,,...مع ذلك
Dialogue: 0,0:09:38.34,0:09:39.35,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:09:39.35,0:09:40.04,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:09:40.04,0:09:43.08,Default,,0000,0000,0000,,!أنت الوحيد الذي يمكنني الاعتماد عليه الآن
Dialogue: 0,0:09:43.08,0:09:47.05,Default,,0000,0000,0000,,!أرجوك! ساعدني بإعادة كيتا سالماً
Dialogue: 0,0:09:49.73,0:09:51.33,Default,,0000,0000,0000,,أتوسّل إليك
Dialogue: 0,0:09:52.32,0:09:56.36,Default,,0000,0000,0000,,فهمت! أنا من أتى بنفسه
Dialogue: 0,0:09:56.36,0:09:59.04,Default,,0000,0000,0000,,لنعمل معاً لإيجاد حلّ للأمر
Dialogue: 0,0:09:59.89,0:10:01.21,Default,,0000,0000,0000,,!شكراً جزيلاً
Dialogue: 0,0:10:03.56,0:10:07.89,Default,,0000,0000,0000,,لكن لا يمكننا البقاء هناء طويلاً
Dialogue: 0,0:10:07.89,0:10:13.00,Default,,0000,0000,0000,,سنغادر لهذه الليلة، ونتواصل على الهاتف بعدها
Dialogue: 0,0:10:13.00,0:10:13.96,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:10:16.75,0:10:18.66,Default,,0000,0000,0000,,أحتاج استعارة هذه الصورة
Dialogue: 0,0:10:18.66,0:10:20.00,Default,,0000,0000,0000,,حسناً، تفضّل
Dialogue: 0,0:10:23.88,0:10:29.83,Default,,0000,0000,0000,,لا حاجة للقلق، سأعيد كيتا-كن سالماً بكلّ تأكيد
Dialogue: 0,0:10:29.83,0:10:32.34,Default,,0000,0000,0000,,!أجل! أقدّر مساعدتك
Dialogue: 0,0:10:32.91,0:10:35.03,Default,,0000,0000,0000,,ألصقتُ جهاز الإرسال
Dialogue: 0,0:10:35.03,0:10:37.75,Default,,0000,0000,0000,,ما تبقّى هو انتظار اتّصال الخاطف فقط
Dialogue: 0,0:10:44.15,0:10:46.63,Default,,0000,0000,0000,,وكالة موري للتحرّي
Dialogue: 0,0:10:48.02,0:10:50.10,Default,,0000,0000,0000,,!اتّصل بك؟
Dialogue: 0,0:10:50.10,0:10:51.72,Default,,0000,0000,0000,,ماذا قال؟
Dialogue: 0,0:10:51.72,0:10:59.21,Default,,0000,0000,0000,,طلب 20 مليوناً إضافية، ومنحني ساعتين فحسب لتجهيزها
Dialogue: 0,0:10:59.21,0:11:00.76,Default,,0000,0000,0000,,ساعتين؟
Dialogue: 0,0:11:00.76,0:11:03.22,Default,,0000,0000,0000,,أسمعت صوت كيتا-كن؟
Dialogue: 0,0:11:03.59,0:11:07.55,Default,,0000,0000,0000,,أجل، طلبتُ أن يعطيه الهاتف كما قلتَ لي
Dialogue: 0,0:11:07.55,0:11:09.82,Default,,0000,0000,0000,,...ثمّ قال كيتا أمراً غريباً
Dialogue: 0,0:11:09.82,0:11:11.13,Default,,0000,0000,0000,,أمراً غريباً؟
Dialogue: 0,0:11:11.95,0:11:14.68,Default,,0000,0000,0000,,!كيتا؟ أهذا أنت يا كيتا؟
Dialogue: 0,0:11:15.15,0:11:16.09,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:11:16.09,0:11:17.62,Default,,0000,0000,0000,,كيتا! أأنت بخير؟
Dialogue: 0,0:11:17.62,0:11:20.19,Default,,0000,0000,0000,,!أجل! يوجد الكثير من السرطانات هنا يا أبي
Dialogue: 0,0:11:20.19,0:11:20.88,Default,,0000,0000,0000,,سرطانات؟
Dialogue: 0,0:11:20.88,0:11:22.78,Default,,0000,0000,0000,,ما الذي تتكلم عنه؟
Dialogue: 0,0:11:22.78,0:11:25.98,Default,,0000,0000,0000,,...اسمع! كما أخبرتُك بالأمس، إذا اتّصلت بالشرطة
Dialogue: 0,0:11:25.98,0:11:28.72,Default,,0000,0000,0000,,!حوت! حوت ينفث ماءً
Dialogue: 0,0:11:28.72,0:11:31.93,Default,,0000,0000,0000,,!يكفي ثرثرة! سأتّصل بك لاحقاً
Dialogue: 0,0:11:31.93,0:11:33.80,Default,,0000,0000,0000,,!كـ-كيتا
Dialogue: 0,0:11:33.80,0:11:36.18,Default,,0000,0000,0000,,!مرحباً؟ مرحباً؟
Dialogue: 0,0:11:36.93,0:11:40.26,Default,,0000,0000,0000,,يكفي ثرثرة؟ هذا ما قاله الخاطف؟
Dialogue: 0,0:11:40.26,0:11:41.22,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:41.59,0:11:45.76,Default,,0000,0000,0000,,حسناً، جهّز المال يا إيندو-سان
Dialogue: 0,0:11:45.76,0:11:49.92,Default,,0000,0000,0000,,إن مضت الأمور على ما يرام، سأُرجع كيتا-كن\Nفي غضون ساعتين
Dialogue: 0,0:11:49.92,0:11:54.13,Default,,0000,0000,0000,,!حـ-حقاً؟! ابذل ما بوسعك رجاءً
Dialogue: 0,0:11:54.75,0:11:57.47,Default,,0000,0000,0000,,أبي! لديك فكرة عن الخاطف؟
Dialogue: 0,0:11:57.79,0:12:03.18,Default,,0000,0000,0000,,أجل، كيتا-كن في مكان به الكثير\N!من السرطانات، وحوت ينفث ماءً
Dialogue: 0,0:12:03.69,0:12:05.20,Default,,0000,0000,0000,,سرطانات وحوت؟
Dialogue: 0,0:12:05.20,0:12:07.97,Default,,0000,0000,0000,,لا تقصد البحر يا عمّ، صحيح؟
Dialogue: 0,0:12:08.40,0:12:14.85,Default,,0000,0000,0000,,أحمق! عليك الإبحار لمكان مثل جزيرة أوغاساوارا\N!لرؤية نفث الحيتان للماء
Dialogue: 0,0:12:15.64,0:12:19.67,Default,,0000,0000,0000,,لم يكن ما رآه كيتا-كن حوتاً حقيقياً\Nعلى الأرجح، بل نموذج
Dialogue: 0,0:12:19.97,0:12:20.98,Default,,0000,0000,0000,,نموذج؟
Dialogue: 0,0:12:21.97,0:12:24.84,Default,,0000,0000,0000,,!وذلك في المربى المائي
Dialogue: 0,0:12:25.15,0:12:28.11,CharCard,,0000,0000,0000,,المربى المائي الجنوبي
Dialogue: 0,0:12:28.17,0:12:31.62,Default,,0000,0000,0000,,لا نماذج لحيتان لديكم؟
Dialogue: 0,0:12:31.62,0:12:36.72,Default,,0000,0000,0000,,،كلا، لدينا أنواع كثيرة من السرطانات\N...لكن لا نماذج حيتان
Dialogue: 0,0:12:36.91,0:12:40.36,Default,,0000,0000,0000,,!تبّاً! لا بدّ أنّه مربى مائيّ آخر
Dialogue: 0,0:12:40.36,0:12:42.02,Default,,0000,0000,0000,,!لا وقت لدينا! لنسرع
Dialogue: 0,0:12:47.20,0:12:51.85,Default,,0000,0000,0000,,اسمع يا عمّ، أأنت متأكد أن السرطانات حقيقية؟
Dialogue: 0,0:12:51.85,0:12:52.55,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:52.55,0:12:56.19,Default,,0000,0000,0000,,عندما قال كيتا-كن أنّه توجد سرطانات كثيرة
Dialogue: 0,0:12:56.19,0:12:59.68,Default,,0000,0000,0000,,"ردّ الخاطف "ما الذي تتكلم عنه؟
Dialogue: 0,0:12:59.98,0:13:04.64,Default,,0000,0000,0000,,ألا يعني ذلك أنّه لم تكن هناك\Nأيّ سرطانات بنظر الخاطف على الأقل؟
Dialogue: 0,0:13:05.93,0:13:07.39,Default,,0000,0000,0000,,...معك حق
Dialogue: 0,0:13:07.39,0:13:12.72,Default,,0000,0000,0000,,لم يتّصل من المربى المائيّ إذاً ربما؟
Dialogue: 0,0:13:13.39,0:13:16.35,Default,,0000,0000,0000,,!انظر هناك يا أبي! إنّه حوت
Dialogue: 0,0:13:17.31,0:13:20.87,On Top,,0000,0000,0000,,أحتاجك\Nتلفاز نيتشيوري
Dialogue: 0,0:13:21.79,0:13:26.29,Default,,0000,0000,0000,,صحيح! شخصية حملة تلفاز نيتشيوري\N!الدعائية لهذا العام هي حوت
Dialogue: 0,0:13:26.29,0:13:30.22,Default,,0000,0000,0000,,أيمكن أن يكون هذا الحوت الذي رآه كيتا-كن؟
Dialogue: 0,0:13:30.86,0:13:34.94,Default,,0000,0000,0000,,في تلك الحالة، كان في مكان استطاع \Nرؤية ذاك المنطاد منه
Dialogue: 0,0:13:40.77,0:13:48.80,Default,,0000,0000,0000,,عرفت! كان المنطاد فوق حديقة بيكا\Nفي الوقت الذي اتّصل فيه الخاطف
Dialogue: 0,0:13:48.80,0:13:49.80,Default,,0000,0000,0000,,حديقة بيكا؟
Dialogue: 0,0:13:50.26,0:13:53.89,Default,,0000,0000,0000,,عمّ! مكان صفقة الأمس كان فندقاً\N!في جادة بيكا أيضاً
Dialogue: 0,0:13:54.93,0:13:58.85,Default,,0000,0000,0000,,لنرجع هناك ونبحث عن مكان يحوي\Nالكثير من السرطانات
Dialogue: 0,0:13:59.25,0:14:02.31,Default,,0000,0000,0000,,!سنجد كيتا-كن بالقرب هناك حتماً
Dialogue: 0,0:14:44.71,0:14:45.38,Default,,0000,0000,0000,,كيف الأمر؟
Dialogue: 0,0:14:45.38,0:14:46.16,Default,,0000,0000,0000,,لم أجده
Dialogue: 0,0:14:46.16,0:14:46.81,Default,,0000,0000,0000,,ولا أنا
Dialogue: 0,0:14:47.25,0:14:52.10,Default,,0000,0000,0000,,تبّاً! الوقت نفد تقريباً! ربما اتّصل الخاطف
Dialogue: 0,0:14:54.12,0:14:55.56,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:14:56.95,0:14:59.19,Default,,0000,0000,0000,,اتّصل قبل دقيقتين
Dialogue: 0,0:14:59.19,0:15:03.19,Default,,0000,0000,0000,,أخبره بالوقوف في نهاية الرصيف الأوّل\Nفي محطّة كاراجوكو
Dialogue: 0,0:15:03.19,0:15:04.36,Default,,0000,0000,0000,,محطّة كاراجوكو؟
Dialogue: 0,0:15:04.36,0:15:07.36,Default,,0000,0000,0000,,أجل، واصل البحث عن السرطانات يا كونان
Dialogue: 0,0:15:07.36,0:15:08.88,Default,,0000,0000,0000,,فهمت؟
Dialogue: 0,0:15:08.88,0:15:09.76,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:15:10.35,0:15:15.47,Default,,0000,0000,0000,,حتّى لو فقدوا أثر الخاطف، جهاز إرسالي على الحقيبة
Dialogue: 0,0:15:15.47,0:15:18.55,Default,,0000,0000,0000,,!سأجد مكانه بالتأكيد
Dialogue: 0,0:15:22.58,0:15:25.61,CharCard,,0000,0000,15,,{\fad(300,0)}محطّة كاراجوكو
Dialogue: 0,0:15:35.98,0:15:38.58,Default,,0000,0000,0000,,أتظنّ الخاطف سيخبره بصعود القطار؟
Dialogue: 0,0:15:38.58,0:15:40.19,Default,,0000,0000,0000,,ذلك محتمل
Dialogue: 0,0:15:40.19,0:15:43.35,Default,,0000,0000,0000,,سيتمّان صفقة التبادل في مكان مختلف غالباً
Dialogue: 0,0:15:50.56,0:15:51.27,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:15:52.68,0:15:54.31,Default,,0000,0000,0000,,!ارم الحقيبة هنا
Dialogue: 0,0:15:55.18,0:15:57.26,Default,,0000,0000,0000,,!لا تهتمّ بما سيحلّ بصبيّك؟
Dialogue: 0,0:16:00.60,0:16:02.45,Default,,0000,0000,0000,,!تبّاً... ران
Dialogue: 0,0:16:02.45,0:16:03.48,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:16:16.94,0:16:18.06,Default,,0000,0000,0000,,!هرب؟
Dialogue: 0,0:16:18.06,0:16:22.69,Default,,0000,0000,0000,,أجل، لكن حصل موري-سان على صورة\Nلأرقام لوحة درّاجته
Dialogue: 0,0:16:22.69,0:16:24.39,Default,,0000,0000,0000,,!سنعرف هويّته قريباً
Dialogue: 0,0:16:24.39,0:16:25.10,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:16:31.27,0:16:35.23,Default,,0000,0000,0000,,!إنّها ساكنة في نفس المكان، يُفترض أنّ المخبأ بالقرب
Dialogue: 0,0:16:41.52,0:16:44.65,Default,,0000,0000,0000,,!أكاد أصل! عند ذاك المنعطف
Dialogue: 0,0:16:52.29,0:16:55.27,Default,,0000,0000,0000,,!تبّاً! لا بدّ أنّه بدّل الحقيبة هنا
Dialogue: 0,0:16:55.86,0:17:00.31,Default,,0000,0000,0000,,...لكنّ العم صوّر رقم لوحة الدرّاجة، لذا لن يستطيع الخاطف
Dialogue: 0,0:17:02.49,0:17:06.93,Default,,0000,0000,0000,,!أهذه للخاطف؟! أيمكن أنّ اللوحة كانت مزيّفة؟
Dialogue: 0,0:17:07.35,0:17:11.89,Default,,0000,0000,0000,,،كلا! بعدما أصبح المال بيده الآن\N!قد يُقدم على قتل كيتا-كن إذا لم ألحق به
Dialogue: 0,0:17:12.19,0:17:12.95,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:17:13.40,0:17:14.32,Default,,0000,0000,0000,,!عليّ إيجاده
Dialogue: 0,0:17:14.77,0:17:18.34,Default,,0000,0000,0000,,مكان به الكثير من السرطانات ويمكنك\N!رؤية منطاد الحوت منه
Dialogue: 0,0:17:19.22,0:17:22.81,Default,,0000,0000,0000,,ألم يقل كيتا-كن أنّ الحوت كان ينفث ماءً؟
Dialogue: 0,0:17:23.76,0:17:26.76,Default,,0000,0000,0000,,!لم يكن ذاك المنطاد ينفث شيئاً
Dialogue: 0,0:17:27.25,0:17:31.83,Default,,0000,0000,0000,,ما الذي يعنيه هذا؟ لم يكن ما رآه\N...كيتا-كن المنطاد؟ أو ربما
Dialogue: 0,0:17:48.65,0:17:49.47,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:17:56.89,0:17:58.84,Default,,0000,0000,0000,,لا يمكنني رؤيته من هنا
Dialogue: 0,0:17:59.42,0:17:59.97,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:18:01.43,0:18:04.18,Default,,0000,0000,0000,,!ربما يمكن رؤيته من فندق ستارلايت
Dialogue: 0,0:18:24.41,0:18:27.64,Default,,0000,0000,0000,,حديقة بيكا... بعدها ذاك
Dialogue: 0,0:18:28.06,0:18:31.11,Default,,0000,0000,0000,,ما رآه كيتا-كن هو الدخان من مصنع\N...حرق النفايات ذاك
Dialogue: 0,0:18:39.89,0:18:44.96,Default,,0000,0000,0000,,لا يمكن رؤية ذلك إلّا عندما تقع كلّ من الحديقة\Nومصنع حرق النّفايات على نفس خطّ البصر
Dialogue: 0,0:18:47.17,0:18:48.85,Default,,0000,0000,0000,,!هنا تماماً
Dialogue: 0,0:18:49.34,0:18:53.92,Default,,0000,0000,0000,,...لكنّ الارتفاع منخفض، يجب أن يكون عالياً بمستوى المنطاد
Dialogue: 0,0:18:53.92,0:18:55.65,Default,,0000,0000,0000,,بحيث يبدو أنّ الحوت ينفث ماءً
Dialogue: 0,0:18:58.03,0:19:00.10,Default,,0000,0000,0000,,!أيمكن أنّهما في هذا الفندق؟
Dialogue: 0,0:19:03.33,0:19:05.00,Default,,0000,0000,0000,,كان ذلك خطراً
Dialogue: 0,0:19:09.52,0:19:11.48,Default,,0000,0000,0000,,...الطاولة والكراسي
Dialogue: 0,0:19:12.48,0:19:14.27,Default,,0000,0000,0000,,...أيمكن أنّ السرطانات
Dialogue: 0,0:19:37.37,0:19:38.93,Default,,0000,0000,0000,,!ها هي! السرطانات
Dialogue: 0,0:19:40.16,0:19:43.61,Default,,0000,0000,0000,,!تبدو الطاولات والكراسي كسرطانات من الأعلى
Dialogue: 0,0:19:44.78,0:19:48.97,Default,,0000,0000,0000,,لا شكّ في الأمر! كيتا-كن في غرفة ما\N!في هذا الفندق
Dialogue: 0,0:19:56.26,0:19:57.44,Default,,0000,0000,0000,,!يا عمّة
Dialogue: 0,0:19:59.10,0:20:01.48,Default,,0000,0000,0000,,أتعرفين في أيّ غرفة يقيم هذا الفتى؟
Dialogue: 0,0:20:03.97,0:20:10.42,Default,,0000,0000,0000,,،إنّه في غرفة في الطابق أسفل هذا\Nلكنّه غادر قبل قليل مع والديه
Dialogue: 0,0:20:10.42,0:20:11.39,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:20:11.84,0:20:15.34,Default,,0000,0000,0000,,!حسناً، وجدتك! لا يزال كيتا-كن سليماً
Dialogue: 0,0:20:19.75,0:20:22.27,Default,,0000,0000,0000,,!لكمة يايبا
Dialogue: 0,0:20:22.27,0:20:24.00,Default,,0000,0000,0000,,!هيّا بنا يا جوكر
Dialogue: 0,0:20:26.32,0:20:29.32,Default,,0000,0000,0000,,أخبرني، هل سنقتله حقّاً؟
Dialogue: 0,0:20:29.32,0:20:32.31,Default,,0000,0000,0000,,!يكفي! لا تشفقي عليه
Dialogue: 0,0:20:32.90,0:20:33.59,Default,,0000,0000,0000,,هيّا بنا
Dialogue: 0,0:20:39.93,0:20:40.85,Default,,0000,0000,0000,,!كيتا-كن
Dialogue: 0,0:20:43.35,0:20:46.89,Default,,0000,0000,0000,,!هذان الاثنان خاطفان! أوقفوهما
Dialogue: 0,0:20:46.89,0:20:48.51,Default,,0000,0000,0000,,!تبّاً! لا يتحرّك أحد
Dialogue: 0,0:20:49.31,0:20:51.27,Default,,0000,0000,0000,,!سيفقد حياته إذا تحرّكتم
Dialogue: 0,0:20:52.23,0:20:54.87,Default,,0000,0000,0000,,!ابتعدا! بسرعة
Dialogue: 0,0:20:57.25,0:20:58.72,Default,,0000,0000,0000,,أهناك ما يمكنني ركله؟
Dialogue: 0,0:21:01.96,0:21:05.72,Default,,0000,0000,0000,,!ركنت الدراجة في الخارج مباشرةً\Nاركضي بأقصى سرعة حالما نغادر من الباب
Dialogue: 0,0:21:08.68,0:21:10.10,Default,,0000,0000,0000,,مستعدة؟
Dialogue: 0,0:21:15.52,0:21:16.62,Default,,0000,0000,0000,,!خُذا
Dialogue: 0,0:21:35.58,0:21:37.14,Default,,0000,0000,0000,,!حُلّت بسلام
Dialogue: 0,0:23:03.75,0:23:08.16,Default,,0000,0000,0000,,!كيتا! حمداً لله على سلامتك! كيتا
Dialogue: 0,0:23:08.16,0:23:10.31,Default,,0000,0000,0000,,أبي، هذا مؤلم
Dialogue: 0,0:23:12.16,0:23:14.80,Default,,0000,0000,0000,,كيف عرفت أنّهم هنا؟
Dialogue: 0,0:23:15.44,0:23:17.36,Default,,0000,0000,0000,,!بالصدفة
Dialogue: 0,0:23:17.36,0:23:20.98,Default,,0000,0000,0000,,!كنتُ أبحث عن السرطانات ووجدتُ كيتا-كن
Dialogue: 0,0:23:20.98,0:23:26.01,Default,,0000,0000,0000,,عندما صرختُ أنّهما مُختطفان، حاول المجرمان الهرب
Dialogue: 0,0:23:26.01,0:23:27.24,Default,,0000,0000,0000,,وانتهى بهما الأمر هكذا
Dialogue: 0,0:23:28.39,0:23:30.22,Default,,0000,0000,0000,,جنيا على نفسيهما إذاً؟
Dialogue: 0,0:23:30.22,0:23:31.43,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:23:33.43,0:23:35.68,Default,,0000,0000,0000,,!سيّدي المفتّش ميغوري
Dialogue: 0,0:23:35.68,0:23:37.38,Default,,0000,0000,0000,,أخبرني كونان-كن بكلّ شيء
Dialogue: 0,0:23:37.38,0:23:41.85,Default,,0000,0000,0000,,لمَ لم تتّصل بنا بعدما عرفت أنّه اختطاف؟
Dialogue: 0,0:23:43.05,0:23:45.32,Default,,0000,0000,0000,,لم تستطع الثقة بي؟
Dialogue: 0,0:23:45.59,0:23:49.31,Default,,0000,0000,0000,,!كلا! لم يكن شيئاً كذاك البتّة
Dialogue: 0,0:23:49.91,0:23:54.43,Default,,0000,0000,0000,,تلقّى العمّ بعدها توبيخاً مستمراً\Nلساعة من المفتّش ميغوري
Dialogue: 0,0:23:55.76,0:23:57.32,Default,,0000,0000,0000,,لا بأس بذلك من حين لآخر
Dialogue: 0,0:24:02.11,0:24:03.06,Default,,0000,0000,0000,,ما كان ذلك؟
Dialogue: 0,0:24:06.43,0:24:08.39,Default,,0000,0000,0000,,!إنّها جريمة قتل
Dialogue: 0,0:24:08.77,0:24:11.77,Default,,0000,0000,0000,,يستحيل أن يخرج أحد من هنا
Dialogue: 0,0:24:13.39,0:24:15.36,Default,,0000,0000,0000,,لمَ توجد بقعة دم هنا؟
Dialogue: 0,0:24:18.17,0:24:21.11,Default,,0000,0000,0000,,كان إيكوتا-سان يقف هنا في الظلام
Dialogue: 0,0:24:22.34,0:24:23.71,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:24:23.90,0:24:29.89,On Top,,0000,0000,15,,جريمة قتل الطريق المُظلم
Dialogue: 0,0:24:24.70,0:24:26.12,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.12,0:24:28.62,Default,,0000,0000,0000,,جريمة قتل الطريق المُظلم
Dialogue: 0,0:24:45.55,0:24:48.12,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.12,0:24:49.49,Default,,0000,0000,0000,,سجائر
Dialogue: 0,0:24:50.12,0:24:52.20,Default,,0000,0000,0000,,تتضمّن الحلقة القادمة\N!حيلة ماكرة مفاجئة
Dialogue: 0,0:24:52.20,0:24:54.54,Default,,0000,0000,0000,,أيمكنك رؤية غراب الظلام؟

