Dialogue: 0,0:00:01.06,0:00:02.60,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.60,0:00:05.60,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.60,0:00:07.96,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقل عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.59,0:00:11.58,Default,,0000,0000,0000,,تتمحور قضيّة اليوم حول عروس يونيو\N!مكسوّة بالبياض تدنّسها الدماء
Dialogue: 0,0:00:12.05,0:00:15.46,Default,,0000,0000,0000,,،حتى بينما توشك سعادتها على الانهيار\N!الحقيقة واحدة دوماً
Dialogue: 0,0:01:47.17,0:01:49.91,Default,,0000,0000,0000,,جريمة قتل عروس يونيو
Dialogue: 0,0:01:52.57,0:01:58.02,Default,,0000,0000,0000,,اليوم حفل زفاف لمعلّمةٍ كانت لي وران\Nفي المدرسة المتوسطة
Dialogue: 0,0:01:58.02,0:02:01.69,Default,,0000,0000,0000,,مع ذلك لم آت هنا لتهنئتها بالتحديد
Dialogue: 0,0:02:01.69,0:02:05.94,Default,,0000,0000,0000,,أردتُ رؤية غريب الأطوار\Nالذي سيتزوّجها وحسب
Dialogue: 0,0:02:06.40,0:02:11.14,Default,,0000,0000,0000,,ماتسوموتو سينسي... لم أرها مُذ تخرّجنا
Dialogue: 0,0:02:11.14,0:02:15.26,Default,,0000,0000,0000,,ربما سنسمع غناءها الجميل مُجدداً في الحفل
Dialogue: 0,0:02:15.26,0:02:17.36,Default,,0000,0000,0000,,بالمناسبة، ماذا عنه؟
Dialogue: 0,0:02:17.87,0:02:19.88,Default,,0000,0000,0000,,ذاك الذي كانت سينسي توبّخه دوماً
Dialogue: 0,0:02:19.88,0:02:22.61,Default,,0000,0000,0000,,لانحرافه عن النغم في درس الموسيقى
Dialogue: 0,0:02:24.02,0:02:25.54,Default,,0000,0000,0000,,تقصدين شينتشي؟
Dialogue: 0,0:02:25.54,0:02:28.06,Default,,0000,0000,0000,,"!اتّصلتُ به لكنه قال "من قد يذهب لذاك الزفاف؟
Dialogue: 0,0:02:28.06,0:02:32.02,Default,,0000,0000,0000,,فأحضرتِ هذا الفتى بدلاً من ميّت النغم ذاك؟
Dialogue: 0,0:02:32.28,0:02:34.86,Default,,0000,0000,0000,,أجل، أصرّ على القدوم
Dialogue: 0,0:02:34.86,0:02:37.24,Default,,0000,0000,0000,,أعتذر لكوني ميت النغم
Dialogue: 0,0:02:37.53,0:02:41.65,Default,,0000,0000,0000,,لم تقم تلك المرأة سوى\Nبتعذيبي لثلاث سنين
Dialogue: 0,0:02:46.86,0:02:49.77,Default,,0000,0000,0000,,!عجباً، موري-سان وسوزوكي-سان
Dialogue: 0,0:02:53.01,0:02:54.70,Default,,0000,0000,0000,,ما رأيكما؟ أيلائمني؟
Dialogue: 0,0:02:54.70,0:02:57.15,Default,,0000,0000,0000,,!تـ-تبدين جميلةً جدّاً
Dialogue: 0,0:02:57.60,0:02:59.06,Default,,0000,0000,0000,,...بـ-بالفعل
Dialogue: 0,0:02:59.06,0:03:02.52,Default,,0000,0000,15,,غرفة الانتظار
Dialogue: 0,0:02:59.06,0:03:02.52,Default,,0000,0000,0000,,ماذا؟ لم يأت كودو-كن؟
Dialogue: 0,0:03:02.52,0:03:06.40,Default,,0000,0000,0000,,أردتُ الاستعراض بهذا الفستان\N!أمام ذاك الصبيّ المغرور
Dialogue: 0,0:03:06.59,0:03:08.56,Default,,0000,0000,0000,,لم تتغير في داخلها أبداً
Dialogue: 0,0:03:08.56,0:03:09.61,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:11.49,0:03:13.84,Default,,0000,0000,0000,,هل التقينا قبلاً يا فتى؟
Dialogue: 0,0:03:13.84,0:03:14.82,Default,,0000,0000,0000,,!لا
Dialogue: 0,0:03:15.20,0:03:17.78,Default,,0000,0000,0000,,!حسنٌ، انظرا هنا
Dialogue: 0,0:03:18.77,0:03:21.07,Default,,0000,0000,0000,,!نحن المسؤولتان عن التسجيل اليوم
Dialogue: 0,0:03:21.07,0:03:23.23,Default,,0000,0000,0000,,احرصي على أن يكون\N!مشهد التقبيل ممتازاً
Dialogue: 0,0:03:23.57,0:03:25.19,Default,,0000,0000,0000,,!دعي الأمر لي
Dialogue: 0,0:03:25.77,0:03:29.65,Default,,0000,0000,0000,,أحضرتُ شاي الليمون الدافئ\Nالذي أردته يا سايوري
Dialogue: 0,0:03:30.64,0:03:31.86,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:03:32.14,0:03:35.39,Default,,0000,0000,0000,,صحيح، كانت تشرب الشاي بالليمون دوماً
Dialogue: 0,0:03:35.39,0:03:37.32,Default,,0000,0000,0000,,...حتى أثناء الدرس
Dialogue: 0,0:03:38.56,0:03:42.76,Default,,0000,0000,0000,,مهلك، سيزول أحمر شفاهك\Nإن شربتِ هكذا
Dialogue: 0,0:03:45.59,0:03:46.61,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:03:46.61,0:03:47.49,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:03:51.58,0:03:54.23,Default,,0000,0000,0000,,كازومي، أنا آسفة
Dialogue: 0,0:03:54.58,0:03:56.19,Default,,0000,0000,0000,,بخصوص توشيهيكو-سان
Dialogue: 0,0:03:56.74,0:03:59.14,Default,,0000,0000,0000,,ما الذي تقولينه في وقتٍ كهذا؟
Dialogue: 0,0:03:59.53,0:04:00.98,Default,,0000,0000,0000,,!يجدر بك أن تتجهزي
Dialogue: 0,0:04:00.98,0:04:03.19,Default,,0000,0000,0000,,سأخبر الجميع في الحفل أنّ العريس
Dialogue: 0,0:04:03.19,0:04:05.50,Default,,0000,0000,0000,,!كان حبيبي السابق
Dialogue: 0,0:04:05.50,0:04:06.11,Default,,0000,0000,0000,,...كازومي
Dialogue: 0,0:04:07.23,0:04:09.89,Default,,0000,0000,0000,,!أمزح فقط
Dialogue: 0,0:04:09.89,0:04:11.81,Default,,0000,0000,0000,,أراكِ لاحقاً
Dialogue: 0,0:04:12.37,0:04:14.12,Default,,0000,0000,0000,,يا إلهي، لا تكفّ عن مضايقتي
Dialogue: 0,0:04:14.12,0:04:15.78,Default,,0000,0000,0000,,من كانت؟
Dialogue: 0,0:04:15.78,0:04:17.24,Default,,0000,0000,0000,,صديقة سيّئة من أيام الجامعة
Dialogue: 0,0:04:17.77,0:04:21.11,Default,,0000,0000,0000,,توجد عُلبة أخرى، أيريد أحدكم الشرب؟
Dialogue: 0,0:04:21.11,0:04:22.90,Default,,0000,0000,0000,,!سآخذها
Dialogue: 0,0:04:29.35,0:04:31.10,Default,,0000,0000,0000,,!ماذا تظن أنّك تفعل؟
Dialogue: 0,0:04:31.10,0:04:33.27,Default,,0000,0000,0000,,!ران! ابرحي هذا الغوريلا ضرباً
Dialogue: 0,0:04:33.85,0:04:35.80,Default,,0000,0000,0000,,!ماذا؟ ران-كن
Dialogue: 0,0:04:35.80,0:04:38.04,Default,,0000,0000,0000,,مفتّش ميغوري! ماذا تفعل هنا؟
Dialogue: 0,0:04:38.04,0:04:42.06,Default,,0000,0000,0000,,من قد يفوت حفل زفاف ابنة مديره؟
Dialogue: 0,0:04:42.06,0:04:43.75,Default,,0000,0000,0000,,مديره؟
Dialogue: 0,0:04:43.75,0:04:49.56,Default,,0000,0000,0000,,صحيح، إنّه مفوّض الشرطة وأبي
Dialogue: 0,0:04:49.83,0:04:51.52,Default,,0000,0000,0000,,...أ-أبوك
Dialogue: 0,0:04:52.20,0:04:54.23,Default,,0000,0000,0000,,يمكنكم الذهاب
Dialogue: 0,0:04:54.23,0:04:55.61,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:04:56.66,0:04:58.06,Default,,0000,0000,0000,,!المعذرة
Dialogue: 0,0:04:56.66,0:04:58.06,Default,,0000,0000,0000,,!المعذرة
Dialogue: 0,0:04:58.32,0:05:00.07,Default,,0000,0000,0000,,لا مشكلة
Dialogue: 0,0:05:00.07,0:05:02.31,Default,,0000,0000,0000,,فاللوم على أبي لملامحه المخيفة
Dialogue: 0,0:05:02.73,0:05:06.98,Default,,0000,0000,0000,,بالمناسبة يا سايوري، أأنتِ راضية\Nبذاك الرجل حقاً؟
Dialogue: 0,0:05:06.98,0:05:10.23,Default,,0000,0000,0000,,!لديّ كتيبة شبّان أسوياء يعملون لي
Dialogue: 0,0:05:10.23,0:05:12.56,Default,,0000,0000,0000,,ما الذي تقوله في وقتٍ كهذا؟
Dialogue: 0,0:05:13.01,0:05:13.98,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:05:14.35,0:05:17.47,Default,,0000,0000,0000,,يا إلهي، لا تكفّ عن معاملتي كطفلة
Dialogue: 0,0:05:17.47,0:05:19.00,Default,,0000,0000,0000,,أنتِ كذلك
Dialogue: 0,0:05:20.25,0:05:24.30,Default,,0000,0000,0000,,...لا تزالين تشربين هذا الشراب السكّري
Dialogue: 0,0:05:24.30,0:05:25.82,Default,,0000,0000,0000,,!وما المشكلة؟ يعجبني
Dialogue: 0,0:05:26.55,0:05:28.66,Default,,0000,0000,0000,,ما رأيك أن تُدلي برأيك في شيءٍ آخر؟
Dialogue: 0,0:05:28.66,0:05:30.31,Default,,0000,0000,0000,,!انظر لفستان ابنتك
Dialogue: 0,0:05:33.91,0:05:38.27,Default,,0000,0000,0000,,أنتِ جميلة، رغم ليس بحُسن أمّك المتوفاة
Dialogue: 0,0:05:38.73,0:05:41.86,Default,,0000,0000,0000,,لا يمكنه الثناء عليّ بشكل طبيعي ولو لمرّة
Dialogue: 0,0:05:46.19,0:05:47.36,Default,,0000,0000,0000,,!يا للورود الجميلة
Dialogue: 0,0:05:48.22,0:05:49.81,Default,,0000,0000,0000,,شكراً لك يا أوميميا-كن
Dialogue: 0,0:05:50.18,0:05:51.85,Default,,0000,0000,0000,,من ذاك الشخص؟
Dialogue: 0,0:05:51.85,0:05:55.53,Default,,0000,0000,0000,,أنسيتِ؟ إنّه أوميميا-سان\Nالذي كان يسبقنا بسنة
Dialogue: 0,0:06:01.38,0:06:04.76,Default,,0000,0000,0000,,يلائمك الشاي بالليمون حقاً يا سينسي
Dialogue: 0,0:06:04.76,0:06:05.57,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:06:06.34,0:06:08.12,Default,,0000,0000,0000,,اليوم خيبة أمل كبيرة لي
Dialogue: 0,0:06:08.12,0:06:13.36,Default,,0000,0000,0000,,لطالما رأيتُ أنّي وحدي من بإمكانه منحك السعادة
Dialogue: 0,0:06:13.87,0:06:15.17,Default,,0000,0000,0000,,...أوميميا-كن
Dialogue: 0,0:06:17.78,0:06:18.47,Default,,0000,0000,0000,,إلى اللقاء
Dialogue: 0,0:06:20.11,0:06:21.65,Default,,0000,0000,0000,,يا للوغد المتبجح
Dialogue: 0,0:06:24.11,0:06:27.40,Default,,0000,0000,0000,,!كلا! تكاد البطارية تنفد
Dialogue: 0,0:06:28.06,0:06:29.35,Default,,0000,0000,0000,,!مُحال
Dialogue: 0,0:06:29.35,0:06:31.69,Default,,0000,0000,0000,,ألم يكن هناك متجر الكترونيات في القرب؟
Dialogue: 0,0:06:34.64,0:06:35.77,Default,,0000,0000,0000,,سأذهب لشراء واحدة
Dialogue: 0,0:06:35.77,0:06:37.07,Default,,0000,0000,0000,,!انتظريني
Dialogue: 0,0:06:39.38,0:06:43.26,Default,,0000,0000,0000,,كان عليكما تفقّد ذلك قبل مغادرة المنزل
Dialogue: 0,0:06:45.17,0:06:49.46,Default,,0000,0000,0000,,تبدو مطابقاً لكودو شينتشي حقاً
Dialogue: 0,0:06:50.12,0:06:53.58,Default,,0000,0000,0000,,مجرد النظر لوجهك يُشعرني\N!برغبة في مضايقتك
Dialogue: 0,0:06:53.58,0:06:55.03,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:06:55.37,0:07:00.73,Default,,0000,0000,0000,,فكان كودو-كن يشبه محبوبي الأوّل
Dialogue: 0,0:07:01.15,0:07:04.53,Default,,0000,0000,0000,,كانت عائلته تدير متجر حلويات في الحيّ
Dialogue: 0,0:07:04.53,0:07:07.64,Default,,0000,0000,0000,,وهبّ لمساعدتي متى كان أحدٌ يزعجني
Dialogue: 0,0:07:08.19,0:07:12.06,Default,,0000,0000,0000,,كان يسرق شرابي المفضّل من متجرهم
Dialogue: 0,0:07:12.06,0:07:14.44,Default,,0000,0000,0000,,ويعطيني إيّاه سرّاً دوماً
Dialogue: 0,0:07:16.48,0:07:18.59,Default,,0000,0000,0000,,شاي ليمون دافئ
Dialogue: 0,0:07:20.13,0:07:24.76,Default,,0000,0000,0000,,لا أزال أشربه على الدوام لعجزي\Nعن مفارقة هذه الذكريات
Dialogue: 0,0:07:24.76,0:07:26.53,Default,,0000,0000,0000,,أشعر أنّه يمدّني بالشجاعة
Dialogue: 0,0:07:27.22,0:07:31.87,Default,,0000,0000,0000,,لذا هو كان سبب عذابي لثلاث سنوات؟
Dialogue: 0,0:07:31.87,0:07:34.98,Default,,0000,0000,0000,,أيزال ذاك الفتى يعيش هناك؟
Dialogue: 0,0:07:36.33,0:07:40.36,Default,,0000,0000,0000,,كلا، انتقل فجأةً في أحد الأيام\Nولم أره بعدها
Dialogue: 0,0:07:40.36,0:07:43.11,Default,,0000,0000,0000,,...لكن هناك تتمة لهذه القصة
Dialogue: 0,0:07:43.11,0:07:46.28,Default,,0000,0000,0000,,!ما الذي يخجلك؟ أنتَ العريس
Dialogue: 0,0:07:47.69,0:07:49.23,Default,,0000,0000,0000,,توشيهيكو-سان
Dialogue: 0,0:07:50.89,0:07:51.98,Default,,0000,0000,0000,,تبدين جميلةً يا سايوري
Dialogue: 0,0:07:52.73,0:07:54.69,Default,,0000,0000,0000,,أبقِ هذا الكلام سرّاً بيننا، اتّفقنا؟
Dialogue: 0,0:07:57.31,0:08:01.10,Default,,0000,0000,0000,,لا تزالين تشربين هذا المشروب الرديء؟
Dialogue: 0,0:08:01.10,0:08:02.06,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:08:04.64,0:08:08.29,Default,,0000,0000,0000,,!أنتَ وريث مجموعة تاكاسوغي
Dialogue: 0,0:08:09.00,0:08:10.71,Default,,0000,0000,0000,,أنتِ من مجموعة سوزوكي
Dialogue: 0,0:08:10.71,0:08:12.45,Default,,0000,0000,0000,,تعرفينه يا سونوكو؟
Dialogue: 0,0:08:12.45,0:08:14.71,Default,,0000,0000,0000,,أراه في الحفلات دائماً
Dialogue: 0,0:08:14.71,0:08:17.21,Default,,0000,0000,0000,,إنه شخص متردّد وعديم المسؤولية
Dialogue: 0,0:08:17.21,0:08:19.69,Default,,0000,0000,0000,,...ويُقال أنّ عائلة تاكاسوغي ستنتهي به
Dialogue: 0,0:08:27.92,0:08:29.31,Default,,0000,0000,0000,,لمَ فجأةً؟
Dialogue: 0,0:08:29.73,0:08:33.27,Default,,0000,0000,0000,,لكنّها معه، لذا أظنّه سيكون بخير
Dialogue: 0,0:08:34.98,0:08:37.85,Default,,0000,0000,0000,,المعذرة، وقت الاحتفال اقترب
Dialogue: 0,0:08:37.85,0:08:39.02,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,0:08:41.39,0:08:43.69,Default,,0000,0000,0000,,يمكنك أن تسبقني يا توشيهيكو-سان
Dialogue: 0,0:08:45.51,0:08:47.24,Default,,0000,0000,0000,,لا تقلق، سألحق بك قريباً
Dialogue: 0,0:08:47.75,0:08:49.69,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,0:08:54.59,0:08:57.40,Default,,0000,0000,0000,,كيف كانت العروس إذاً؟
Dialogue: 0,0:08:57.83,0:08:59.10,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:09:07.57,0:09:08.97,Default,,0000,0000,0000,,ما كان ذاك الصوت؟
Dialogue: 0,0:09:08.97,0:09:10.27,Default,,0000,0000,0000,,أتى من غرفتها
Dialogue: 0,0:09:11.36,0:09:13.19,Default,,0000,0000,0000,,!سينسي! سينسي
Dialogue: 0,0:09:22.01,0:09:25.44,Default,,0000,0000,0000,,يبدو أنّ هيدروكسيد الصوديوم كان\Nممزوجاً مع الشاي بالليمون
Dialogue: 0,0:09:26.01,0:09:28.46,Default,,0000,0000,0000,,...شربته إذاً ثمّ
Dialogue: 0,0:09:29.88,0:09:32.06,Default,,0000,0000,0000,,...ماذا؟ يوجد شيءٌ ما يطفو على الشاي بالليمون
Dialogue: 0,0:09:36.67,0:09:39.02,Default,,0000,0000,0000,,!إنّها... كبسولة
Dialogue: 0,0:09:39.29,0:09:40.45,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:43.49,0:09:47.69,Default,,0000,0000,0000,,فهمت، ملأ الفاعل هذه الكبسولة\Nبهيدروكسيد الصوديوم
Dialogue: 0,0:09:47.69,0:09:50.03,Default,,0000,0000,0000,,ثمّ وضعها في الشاي بالليمون
Dialogue: 0,0:09:50.03,0:09:52.95,Default,,0000,0000,0000,,عندها سيستغرق انتشار السمّ وقتاً
Dialogue: 0,0:09:52.95,0:09:55.07,Default,,0000,0000,0000,,مما يعسّر تحديد وقت ارتكاب الجريمة
Dialogue: 0,0:09:56.40,0:10:00.40,Default,,0000,0000,0000,,أي أنّ القاتل أحد الستّة الذين دخلوا غرفتها
Dialogue: 0,0:10:01.47,0:10:03.86,Default,,0000,0000,0000,,!يمكن لأيٍّ منكم تسميم الشاي
Dialogue: 0,0:10:04.22,0:10:06.57,Default,,0000,0000,0000,,هل أنت جادّ؟! أأنا أحد المُشتبه بهم إذاً؟
Dialogue: 0,0:10:07.10,0:10:09.21,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:10:09.21,0:10:12.40,Default,,0000,0000,0000,,توجد كبسولات تذوب في الماء الساخن\Nببضعة دقائق فقط
Dialogue: 0,0:10:13.17,0:10:15.59,Default,,0000,0000,0000,,حسنٌ، اطلبوا تحليل الكبسولة فوراً
Dialogue: 0,0:10:15.59,0:10:19.41,Default,,0000,0000,0000,,ماذا عنه؟ لن تحسبه في القائمة؟
Dialogue: 0,0:10:19.41,0:10:22.48,Default,,0000,0000,0000,,فقد دخل غرفتها بدوره
Dialogue: 0,0:10:22.87,0:10:26.15,Default,,0000,0000,0000,,أنت، لا يُعقل أن يُسمم مفوّض الشرطة ابنته
Dialogue: 0,0:10:26.87,0:10:31.60,Default,,0000,0000,0000,,كلا، معه حق. مُشتبه بي كما البقية
Dialogue: 0,0:10:32.03,0:10:33.69,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,0:10:33.69,0:10:36.82,Default,,0000,0000,0000,,بالمناسبة، كنا نسجل تصويراً
Dialogue: 0,0:10:36.82,0:10:37.56,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:37.56,0:10:41.52,Default,,0000,0000,0000,,صحيح! أتركناها تعمل عندما غادرنا؟
Dialogue: 0,0:10:41.52,0:10:45.61,Default,,0000,0000,0000,,!قد يكون المجرم ظاهراً في الفيلم
Dialogue: 0,0:10:53.92,0:10:54.65,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:10:55.17,0:10:58.54,Default,,0000,0000,0000,,...لا تزالين تشربين هذا الشراب السكّري
Dialogue: 0,0:11:00.04,0:11:01.90,Default,,0000,0000,0000,,وحدي من بإمكانه منحك السعادة
Dialogue: 0,0:11:03.00,0:11:05.98,Default,,0000,0000,0000,,لا تزالين تشربين هذا المشروب الرديء؟
Dialogue: 0,0:11:06.71,0:11:09.49,Default,,0000,0000,0000,,يبدو أنّ التسميم المباشر لم يُسجّل
Dialogue: 0,0:11:09.49,0:11:14.57,Default,,0000,0000,0000,,لكن أظهر الفيديو أنّ الجميع\Nلمسوا العُلبة ولو مرّةً
Dialogue: 0,0:11:15.45,0:11:18.64,Default,,0000,0000,0000,,أي أنّه كانت للجميع فرصة تسميم الشراب
Dialogue: 0,0:11:24.06,0:11:26.99,Default,,0000,0000,0000,,...لا يزالون يشاهدونه
Dialogue: 0,0:11:27.43,0:11:30.26,Default,,0000,0000,0000,,هل انتهت عملية سينسي يا ترى؟
Dialogue: 0,0:11:30.26,0:11:33.94,Default,,0000,0000,0000,,يا للفظاعة، سمّموا الشاي بالليمون المفضّل لها
Dialogue: 0,0:11:35.09,0:11:36.64,Default,,0000,0000,0000,,...الشاي بالليمون
Dialogue: 0,0:11:37.67,0:11:40.73,Default,,0000,0000,0000,,...كلّما شربته سايوري تعود لي
Dialogue: 0,0:11:41.58,0:11:44.12,Default,,0000,0000,0000,,ذكريات الفتاة الصغيرة التي أحببتها في الماضي
Dialogue: 0,0:11:44.12,0:11:47.04,Default,,0000,0000,0000,,كانت تشرب الشاي بالليمون\Nالذي أعطيته إيّاها بسعادة دوماً
Dialogue: 0,0:11:47.04,0:11:48.69,Default,,0000,0000,0000,,مع أنّه لم تسنح لي معرفة اسمها أبداً
Dialogue: 0,0:11:49.74,0:11:50.65,Default,,0000,0000,0000,,...أيمكن أنّه
Dialogue: 0,0:11:53.82,0:11:55.82,Default,,0000,0000,0000,,حضرة المفتش، وصلت نتائج التحليل
Dialogue: 0,0:11:56.61,0:12:00.81,Default,,0000,0000,0000,,،بدايةً، بافتراض أنّ الكبسولة أُضيفت للشاي بالليمون
Dialogue: 0,0:12:00.81,0:12:03.48,Default,,0000,0000,0000,,سيستغرق ذوبانها بين 15 إلى 16 دقيقة
Dialogue: 0,0:12:04.06,0:12:05.85,Default,,0000,0000,0000,,خمس عشرة إلى ستّ عشرة دقيقة؟
Dialogue: 0,0:12:05.85,0:12:08.84,Default,,0000,0000,0000,,أي أنّ السم أُضيف قبل 15 دقيقة على الأقل
Dialogue: 0,0:12:08.84,0:12:11.84,Default,,0000,0000,0000,,قبل أن تسقط العروس
Dialogue: 0,0:12:11.84,0:12:16.59,Default,,0000,0000,0000,,اتّصلت ران-كن بالنجدة عند 1:46
Dialogue: 0,0:12:16.59,0:12:19.00,Default,,0000,0000,0000,,،وبافتراض أنّها سقطت دقيقةً قبل ذلك
Dialogue: 0,0:12:19.00,0:12:21.94,Default,,0000,0000,0000,,أُضيف السم قبيل الواحدة والنصف
Dialogue: 0,0:12:22.42,0:12:25.90,Default,,0000,0000,0000,,كانت الساعة الواحدة والنصف\Nعندما غادر المفوّض ماتسوموتو
Dialogue: 0,0:12:26.33,0:12:27.03,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:12:27.32,0:12:32.78,Default,,0000,0000,0000,,أي أنّ هذا يبرّئني والعريس
Dialogue: 0,0:12:32.78,0:12:35.48,Default,,0000,0000,0000,,فقد أتينا لمقابلة سينسي بعده
Dialogue: 0,0:12:35.99,0:12:38.89,Default,,0000,0000,0000,,هناك أمرٌ غريب في العلبة المسمومة
Dialogue: 0,0:12:39.69,0:12:43.86,Default,,0000,0000,0000,,لم تحتو بصمات المفوّض
Dialogue: 0,0:12:44.23,0:12:47.23,Default,,0000,0000,0000,,!أحمق! ما الذي تقوله؟
Dialogue: 0,0:12:47.23,0:12:49.51,Default,,0000,0000,0000,,...كما ترون
Dialogue: 0,0:12:49.51,0:12:51.72,Default,,0000,0000,0000,,!أمسكتُ بالعلبة بيدي
Dialogue: 0,0:12:51.72,0:12:53.53,Default,,0000,0000,0000,,هل دققتم الفحص؟
Dialogue: 0,0:12:53.53,0:12:54.42,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:12:56.05,0:12:57.11,Default,,0000,0000,0000,,...غريب
Dialogue: 0,0:12:59.96,0:13:03.59,Default,,0000,0000,0000,,!كلا! تكاد البطارية تنفد
Dialogue: 0,0:13:03.59,0:13:05.04,Default,,0000,0000,0000,,!مُحال
Dialogue: 0,0:13:07.91,0:13:09.83,Default,,0000,0000,0000,,...غريبٌ حقاً
Dialogue: 0,0:13:09.83,0:13:12.56,Default,,0000,0000,0000,,...لحظة، عندما غادرت سونوكو
Dialogue: 0,0:13:12.56,0:13:14.36,Default,,0000,0000,0000,,!لم تحمل علبتها معها
Dialogue: 0,0:13:14.74,0:13:15.98,Default,,0000,0000,0000,,أين هي يا ترى؟
Dialogue: 0,0:13:18.69,0:13:19.48,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:21.65,0:13:25.15,Default,,0000,0000,0000,,...أيمكن أنّ العلبة التي شربت منها
Dialogue: 0,0:13:26.52,0:13:30.51,Default,,0000,0000,0000,,أخبرني يا عمّ، أكانت بصمات المفوّض وحدها المفقودة؟
Dialogue: 0,0:13:30.51,0:13:33.23,Default,,0000,0000,0000,,كلا، لم تكن بصمات أوميميا ذاك موجودة أيضاً
Dialogue: 0,0:13:33.85,0:13:35.19,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:13:35.56,0:13:38.88,Default,,0000,0000,0000,,في تلك الحالة، من أين أتت تلك الكبسولة؟
Dialogue: 0,0:13:38.88,0:13:41.50,Default,,0000,0000,0000,,!وجدتُها! اكتشفت نيّة المجرم
Dialogue: 0,0:13:41.50,0:13:43.15,Default,,0000,0000,0000,,!كما حقيقة تلك الكبسولة
Dialogue: 0,0:13:44.34,0:13:47.60,Default,,0000,0000,0000,,حضرة المفتّش، وجدتُ هذه \Nفي سلّة قمامة في الرواق
Dialogue: 0,0:13:48.04,0:13:49.74,Default,,0000,0000,0000,,...قنّينة زجاجية
Dialogue: 0,0:13:49.74,0:13:52.66,Default,,0000,0000,0000,,يبدو أنّ هيدروكسيد الصوديوم بداخلها
Dialogue: 0,0:13:52.66,0:13:54.04,Default,,0000,0000,0000,,هيدروكسيد الصوديوم؟
Dialogue: 0,0:13:54.04,0:13:57.31,Default,,0000,0000,0000,,يمكن أن تكون الحاوية التي\N!استعملها المجرم عند تسميم الشاي
Dialogue: 0,0:13:57.82,0:13:59.15,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:13:59.15,0:14:01.11,Default,,0000,0000,0000,,هيدروكسيد الصوديوم مادةٌ \Nكيميائية خطرة
Dialogue: 0,0:14:01.11,0:14:04.69,Default,,0000,0000,0000,,تمتصّ الماء في الهواء وتحوّله لسائل \Nفي بضعة دقائق
Dialogue: 0,0:14:05.23,0:14:08.02,Default,,0000,0000,0000,,حسنٌ، أرسلها للتحليل أيضاً
Dialogue: 0,0:14:08.02,0:14:09.35,Default,,0000,0000,0000,,حللتُها
Dialogue: 0,0:14:09.35,0:14:13.73,Default,,0000,0000,0000,,كان ذاك الوغد هو من دنّس \N!فستان سينسي بالدماء
Dialogue: 0,0:14:18.26,0:14:19.46,Default,,0000,0000,0000,,المفتّش ميغوري
Dialogue: 0,0:14:19.46,0:14:22.51,Default,,0000,0000,0000,,نريد الذهاب لرؤية سينسي في المشفى فوراً
Dialogue: 0,0:14:22.51,0:14:25.19,Default,,0000,0000,0000,,!انتظرا قليلاً! لم ننه التحقيق بعد
Dialogue: 0,0:14:25.84,0:14:29.90,Default,,0000,0000,0000,,،العمّ موري ليس موجوداً اليوم\Nلذا أحتاج بديلَ طوارئ
Dialogue: 0,0:14:34.62,0:14:38.48,Default,,0000,0000,0000,,حسنٌ، لأطابق مبدّل الصوت هذا\N...بصوت سونوكو
Dialogue: 0,0:14:38.86,0:14:40.44,Default,,0000,0000,0000,,ما الخطب يا سونوكو؟
Dialogue: 0,0:14:40.99,0:14:46.82,Default,,0000,0000,0000,,ا-اكتشفتُ هوية من وضع السمّ\Nفي شاي ماتسوموتو سينسي بالليمون
Dialogue: 0,0:14:47.98,0:14:49.77,Default,,0000,0000,0000,,!حـ-حقاً يا سونوكو-كن؟
Dialogue: 0,0:14:50.23,0:14:53.52,Default,,0000,0000,0000,,قلتم أنّ الفاعل وضع كبسولة السمّ في الشاي
Dialogue: 0,0:14:53.52,0:14:56.74,Default,,0000,0000,0000,,قبل 15 دقيقة من سقوطها، صحيح؟
Dialogue: 0,0:14:57.17,0:15:01.69,Default,,0000,0000,0000,,أجل، لأنّ ذوبانها سيستغرق بين 15 و16 دقيقة
Dialogue: 0,0:15:02.09,0:15:06.59,Default,,0000,0000,0000,,هذا بافتراض أنّ السمّ\Nكان حقاً في تلك الكبسولة
Dialogue: 0,0:15:06.59,0:15:11.69,Default,,0000,0000,0000,,كلّ ما نحن على يقين منه الآن\Nأنّ الكبسولة كانت تطفو في الشاي بالليمون المسموم
Dialogue: 0,0:15:12.25,0:15:13.65,Default,,0000,0000,0000,,...أتقصدين أن المجرم
Dialogue: 0,0:15:14.25,0:15:18.10,Default,,0000,0000,0000,,صحيح، أُضيف السمّ والكبسولة على حدة
Dialogue: 0,0:15:18.61,0:15:24.19,Default,,0000,0000,0000,,لإيهامنا أنّ السم أُضيف قبل 15 دقيقة \Nمن سقوط سينسي
Dialogue: 0,0:15:24.19,0:15:30.06,Default,,0000,0000,0000,,إن كان ذلك صحيحاً، فأنتما لستما مُستبعدين
Dialogue: 0,0:15:30.06,0:15:33.11,Default,,0000,0000,0000,,تمهل رجاءً، كلامها مجرد افتراضات
Dialogue: 0,0:15:33.81,0:15:36.69,Default,,0000,0000,0000,,قد تكون كبسولة سُم حقاً
Dialogue: 0,0:15:36.69,0:15:37.56,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:15:37.84,0:15:41.01,Default,,0000,0000,0000,,!هناك برهان... دليل
Dialogue: 0,0:15:41.01,0:15:42.52,Default,,0000,0000,0000,,في التسجيل الذي صوّرته ران
Dialogue: 0,0:15:47.08,0:15:50.79,Default,,0000,0000,0000,,حضرة المفتّش، أمعن النظر في علبة\Nالشاي بالليمون على الشاشة
Dialogue: 0,0:15:54.52,0:15:56.35,Default,,0000,0000,0000,,!مُحال
Dialogue: 0,0:16:07.31,0:16:09.73,Default,,0000,0000,0000,,!الشعار مقلوب
Dialogue: 0,0:16:10.02,0:16:14.52,Default,,0000,0000,0000,,ران، أتذكرين أين وضعت علبة\Nالشاي بالليمون خاصتي قبل مغادرتي؟
Dialogue: 0,0:16:14.52,0:16:15.03,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:15.69,0:16:19.76,Default,,0000,0000,0000,,...كنتِ في عجلة فوضعتها على الطاولة
Dialogue: 0,0:16:21.01,0:16:21.94,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:16:22.51,0:16:24.28,Default,,0000,0000,0000,,كانت تلك علبتك؟
Dialogue: 0,0:16:26.92,0:16:27.86,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:16:27.86,0:16:29.36,Default,,0000,0000,0000,,سبب وجود صورة عُلبة واحدة
Dialogue: 0,0:16:29.36,0:16:31.54,Default,,0000,0000,0000,,أن الاثنتين منتظمتان في صفّ واحد
Dialogue: 0,0:16:34.22,0:16:39.00,Default,,0000,0000,0000,,أخذَتْ علبتي التي صادف \Nأنّها كانت في المقدمة
Dialogue: 0,0:16:39.35,0:16:40.27,Default,,0000,0000,0000,,،ودليلاً على ذلك
Dialogue: 0,0:16:40.27,0:16:42.71,Default,,0000,0000,0000,,لم تكن بصمات المفوّض أو أوميميا-سان موجودةً
Dialogue: 0,0:16:42.71,0:16:44.21,Default,,0000,0000,0000,,على العلبة المسمومة
Dialogue: 0,0:16:44.21,0:16:47.29,Default,,0000,0000,0000,,رغم أنّهما أمسكا بالعلبة بوضوح سابقاً
Dialogue: 0,0:16:47.29,0:16:50.42,Default,,0000,0000,0000,,توجد بصماتي عليها مع ذلك غالباً
Dialogue: 0,0:16:50.79,0:16:52.47,Default,,0000,0000,0000,,إنّها محقة
Dialogue: 0,0:16:52.47,0:16:53.37,Default,,0000,0000,0000,,...مما يعني
Dialogue: 0,0:16:54.08,0:16:57.16,Default,,0000,0000,0000,,في وقتٍ ما بين أخذ ابنتي\N،للعلبة الخاطئة وسقوطها
Dialogue: 0,0:16:57.16,0:17:01.29,Default,,0000,0000,0000,,أضاف أحدهم السم والكبسولة منفصلين
Dialogue: 0,0:17:01.78,0:17:05.86,Default,,0000,0000,0000,,أجل، وكان كونان-كن بجوارها آنذاك
Dialogue: 0,0:17:05.86,0:17:06.50,Default,,0000,0000,0000,,مع تاكاسوغي-سان
Dialogue: 0,0:17:06.86,0:17:09.23,Default,,0000,0000,0000,,كما أنا وران
Dialogue: 0,0:17:09.23,0:17:11.25,Default,,0000,0000,0000,,باستثناء كونان-كن
Dialogue: 0,0:17:11.25,0:17:13.72,Default,,0000,0000,0000,,عند عودتي وران من شراء البطارية
Dialogue: 0,0:17:13.72,0:17:16.18,Default,,0000,0000,0000,,،كان تاكاسوغي-سان يحمل العلبة
Dialogue: 0,0:17:16.18,0:17:19.62,Default,,0000,0000,0000,,ثمّ أخذتها سينسي، فيستحيل عليّ وران تسميمها
Dialogue: 0,0:17:20.01,0:17:23.08,Default,,0000,0000,0000,,أي هو الوحيد المتبقي؟
Dialogue: 0,0:17:23.38,0:17:25.80,Default,,0000,0000,0000,,كلا، يوجد شخصٌ آخر
Dialogue: 0,0:17:25.80,0:17:27.54,Default,,0000,0000,0000,,!إنّه سينسي نفسها
Dialogue: 0,0:17:27.54,0:17:29.46,Default,,0000,0000,0000,,أتقصدين انتحار؟
Dialogue: 0,0:17:29.92,0:17:33.91,Default,,0000,0000,0000,,،لكن إن أضافت السم للإقدام على الانتحار
Dialogue: 0,0:17:33.91,0:17:36.24,Default,,0000,0000,0000,,كانت لتضيفه قبيل سقوطها
Dialogue: 0,0:17:36.24,0:17:38.67,Default,,0000,0000,0000,,وتحتاج شيئين لإتمام ذلك
Dialogue: 0,0:17:39.24,0:17:41.63,Default,,0000,0000,0000,,حاوية مكتومة ومُجفّف
Dialogue: 0,0:17:42.28,0:17:46.23,Default,,0000,0000,0000,,يستغرق تحوّل هيدروكسيد الصوديوم لسائل\Nبضعة دقائق فقط
Dialogue: 0,0:17:46.23,0:17:48.23,Default,,0000,0000,0000,,عند تعرّضه للهواء
Dialogue: 0,0:17:48.23,0:17:50.61,Default,,0000,0000,0000,,كانت في هذه الغرفة طوال الوقت
Dialogue: 0,0:17:50.61,0:17:54.83,Default,,0000,0000,0000,,فكانت تحتاج حاويةً للاحتفاظ به بأمان
Dialogue: 0,0:17:55.31,0:17:57.81,Default,,0000,0000,0000,,...لكن عثرنا على الحاوية
Dialogue: 0,0:17:57.81,0:18:00.64,Default,,0000,0000,0000,,في سلّة مهملات في الرواق
Dialogue: 0,0:18:00.64,0:18:03.12,Default,,0000,0000,0000,,وهذا دليلٌ على أنّ شخصاً سوى سينسي
Dialogue: 0,0:18:03.92,0:18:06.76,Default,,0000,0000,0000,,جلب السم لهذه الغرفة
Dialogue: 0,0:18:06.76,0:18:07.79,Default,,0000,0000,0000,,أي أن من كان
Dialogue: 0,0:18:07.79,0:18:10.63,Default,,0000,0000,0000,,...بإمكانه وضع السم في الشاي بالليمون
Dialogue: 0,0:18:10.63,0:18:14.79,Default,,0000,0000,0000,,!كان أنت يا تاكاسوغي-سان
Dialogue: 0,0:18:15.79,0:18:17.87,Default,,0000,0000,0000,,...توشيهيكو! أنت
Dialogue: 0,0:18:17.87,0:18:22.12,Default,,0000,0000,0000,,!أخبرني! لمَ قمت بذلك لابنتي؟
Dialogue: 0,0:18:23.99,0:18:25.75,Default,,0000,0000,0000,,!سأخبرك إن كنت تريد المعرفة لذاك الحد
Dialogue: 0,0:18:26.40,0:18:28.36,Default,,0000,0000,0000,,بدأ الأمر قبل 20 عاماً
Dialogue: 0,0:18:28.36,0:18:33.89,Default,,0000,0000,0000,,!عندما دهستْ سيارةُ مجرم كنتَ تطارده أمّي
Dialogue: 0,0:18:39.31,0:18:42.49,On Top,,0000,0000,0000,,!أمّي! أمّي
Dialogue: 0,0:18:40.10,0:18:42.49,Default,,0000,0000,0000,,كانت أُمي لا تزال حيّةً آنذاك
Dialogue: 0,0:18:42.92,0:18:45.45,Default,,0000,0000,0000,,كانت لتنجو لو نقلتَها للمشفى بسيّارتك فوراً
Dialogue: 0,0:18:45.84,0:18:47.34,Default,,0000,0000,0000,,...لكنّك
Dialogue: 0,0:18:47.34,0:18:48.41,Default,,0000,0000,0000,,!أنت تعترض طريقي! ابتعد
Dialogue: 0,0:18:49.42,0:18:54.91,Default,,0000,0000,0000,,بعدها بخمس عشرة دقيقة ماتت أمي على الطريق
Dialogue: 0,0:18:54.91,0:19:00.71,Default,,0000,0000,0000,,لم أنس وجهك القاسي عديم الرحمة\N!مُذ ذاك اليوم أبداً
Dialogue: 0,0:19:01.46,0:19:03.65,Default,,0000,0000,0000,,أهذه الحقيقة سيّدي المفوّض؟
Dialogue: 0,0:19:03.65,0:19:07.65,Default,,0000,0000,0000,,أجل، لم أرها. كانت ظلال السيّارة تحجبها
Dialogue: 0,0:19:07.65,0:19:11.57,Default,,0000,0000,0000,,علمتُ بالحادثة لاحقاً وأسرعت لمنزله
Dialogue: 0,0:19:11.57,0:19:13.16,Default,,0000,0000,0000,,لكنه كان قد انتقل بالفعل
Dialogue: 0,0:19:15.02,0:19:18.23,Default,,0000,0000,0000,,كانت أُمي عائلتي الوحيدة
Dialogue: 0,0:19:18.23,0:19:22.06,Default,,0000,0000,0000,,تبنّتني عائلة تاكاسوغي\Nالتي لم تمتلك أبناءً
Dialogue: 0,0:19:22.06,0:19:26.33,Default,,0000,0000,0000,,وقبل 7 أعوام، جلبت كازومي معها فتاةً\Nفي يومٍ لا ينمحي من ذاكرتي
Dialogue: 0,0:19:26.68,0:19:30.76,Default,,0000,0000,0000,,أجل، عندما أدركت أنّها كانت ابنتك
Dialogue: 0,0:19:30.76,0:19:34.29,Default,,0000,0000,0000,,تأجّجت بداخلي نيران الانتقام التي كادت \N!تُنسى وأكلت أحشائي
Dialogue: 0,0:19:34.92,0:19:39.75,Default,,0000,0000,0000,,!لمَ لم تقتلني أنا إذاً؟
Dialogue: 0,0:19:40.25,0:19:42.95,Default,,0000,0000,0000,,إن مت أنت فلن تشعر بعذاب ألم
Dialogue: 0,0:19:42.95,0:19:46.62,Default,,0000,0000,0000,,فقدان شخصٍ عزيز
Dialogue: 0,0:19:49.36,0:19:51.99,Default,,0000,0000,0000,,لكنها كانت فتاةً غبيّة بحق
Dialogue: 0,0:19:51.99,0:19:54.83,Default,,0000,0000,0000,,لم تدرك أنّي اقتربتُ منها للانتقام
Dialogue: 0,0:19:54.83,0:19:58.73,Default,,0000,0000,0000,,مع أنّ كوني وريث عائلة تاكاسوغي \N...الثرية كان ما أغواها غالباً
Dialogue: 0,0:19:59.73,0:20:03.22,Default,,0000,0000,0000,,!أنت الذي لم يدرك شيئاً يا توشيهيكو
Dialogue: 0,0:20:03.22,0:20:04.30,Default,,0000,0000,0000,,...كازومي
Dialogue: 0,0:20:04.30,0:20:06.64,Default,,0000,0000,0000,,كانت سايوري تعرف كلّ شيء
Dialogue: 0,0:20:06.64,0:20:10.46,Default,,0000,0000,0000,,!عن الحادثة قبل 20 عاماً كما أصل دمك
Dialogue: 0,0:20:11.22,0:20:12.88,Default,,0000,0000,0000,,!كلا، تكذبين
Dialogue: 0,0:20:12.88,0:20:15.96,Default,,0000,0000,0000,,!لن تتزوّجني أبداً إن عرفت حقيقتي
Dialogue: 0,0:20:15.96,0:20:19.00,Default,,0000,0000,0000,,لا تزال لا تفهم حتّى بعد\Nرؤيتها تشرب الشاي بالليمون؟
Dialogue: 0,0:20:19.00,0:20:22.87,Default,,0000,0000,0000,,أنتَ المحبوب الأوّل الذي كانت \Nتفكّر به سايوري دوماً
Dialogue: 0,0:20:22.87,0:20:23.83,Default,,0000,0000,0000,,!للعشرين عاماً الفائتة
Dialogue: 0,0:20:29.41,0:20:31.20,Default,,0000,0000,0000,,كانت سايوري تتكلم عن شبهك به باستمرار
Dialogue: 0,0:20:31.20,0:20:33.52,Default,,0000,0000,0000,,فتحرّيتُ في الأمر وعرفت الحقيقة
Dialogue: 0,0:20:33.52,0:20:36.62,Default,,0000,0000,0000,,كانت قلقةً جداً حتى بعد قبولها تقدّمك للزواج
Dialogue: 0,0:20:37.73,0:20:41.56,Default,,0000,0000,0000,,لم تعرف كيف تكسب غفرانك
Dialogue: 0,0:20:41.56,0:20:45.93,Default,,0000,0000,0000,,...ومع ذلك قمتَ بـ... قمتَ بكلّ شناعة
Dialogue: 0,0:20:45.93,0:20:50.04,Default,,0000,0000,0000,,أيمكن أنّها رأته يُسمم الشراب؟
Dialogue: 0,0:20:51.60,0:20:54.96,Default,,0000,0000,0000,,عرفتْ أنّه مسموم؟
Dialogue: 0,0:20:54.96,0:20:57.42,Default,,0000,0000,0000,,لا تقلق، سألحق بك قريباً
Dialogue: 0,0:20:59.38,0:21:00.30,Default,,0000,0000,0000,,...سينسي
Dialogue: 0,0:21:01.96,0:21:05.24,Default,,0000,0000,0000,,!سيّدي المفوّض! وصلتنا رسالة من المشفى
Dialogue: 0,0:21:05.24,0:21:08.71,Default,,0000,0000,0000,,!استقرّت حالة الآنسة بعد العملية
Dialogue: 0,0:21:13.44,0:21:15.45,Default,,0000,0000,0000,,!مرحى
Dialogue: 0,0:21:15.45,0:21:17.11,Default,,0000,0000,0000,,!حمداً لله
Dialogue: 0,0:22:55.66,0:22:59.20,Default,,0000,0000,0000,,خرجت سينسي من المشفى بعد شهرين
Dialogue: 0,0:22:59.20,0:23:02.48,Default,,0000,0000,0000,,من الرائع أنّك غادرتِ المشفى\Nقبل الوقت المتوقع
Dialogue: 0,0:23:02.48,0:23:04.95,Default,,0000,0000,0000,,كما سمعت أن حُكم توشيهيكو-سان قد خُفّف
Dialogue: 0,0:23:04.95,0:23:08.94,Default,,0000,0000,0000,,كنتُ من شرب السمّ بإرادتي
Dialogue: 0,0:23:08.94,0:23:11.87,Default,,0000,0000,0000,,لكن في النهاية، يبدو أنّي ألحقت المتاعب به فقط
Dialogue: 0,0:23:12.72,0:23:14.87,Default,,0000,0000,0000,,يكرهني الآن حتماً
Dialogue: 0,0:23:15.14,0:23:17.71,Default,,0000,0000,0000,,!ابتهجي يا سينسي
Dialogue: 0,0:23:18.30,0:23:20.71,Default,,0000,0000,0000,,!سأشتري عصيراً لك احتفالاً بخروجك
Dialogue: 0,0:23:21.10,0:23:22.28,Default,,0000,0000,0000,,حقاً؟
Dialogue: 0,0:23:22.71,0:23:24.37,Default,,0000,0000,0000,,...إذاً سأختار
Dialogue: 0,0:23:31.17,0:23:32.83,Default,,0000,0000,0000,,!الشاي بالليمون، لا غيره
Dialogue: 0,0:23:35.95,0:23:38.91,Default,,0000,0000,0000,,!من المهم الاعتزاز بذكريات الماضي
Dialogue: 0,0:23:38.91,0:23:43.45,Default,,0000,0000,0000,,يا إلهي، لن تتزوّجي أبداً إن واصلتِ البقاء هكذا
Dialogue: 0,0:23:43.73,0:23:47.41,Default,,0000,0000,0000,,لكنّها تزوجت بعد 3 أعوام
Dialogue: 0,0:23:48.19,0:23:53.89,Default,,0000,0000,0000,,ومن نفس الشخص الذي عاش\Nفي أفكارها لعشرين عاماً بالطبع
Dialogue: 0,0:24:07.00,0:24:08.38,Default,,0000,0000,0000,,!أبداً
Dialogue: 0,0:24:08.38,0:24:10.37,Default,,0000,0000,0000,,!يستحيل أن تكوني المجرمة
Dialogue: 0,0:24:11.25,0:24:12.95,Default,,0000,0000,0000,,لمَ يستحيل ذلك؟
Dialogue: 0,0:24:13.99,0:24:18.16,Default,,0000,0000,0000,,أنتَ من وضّح أن ليس بإمكانها\N!أن تكون الفاعلة
Dialogue: 0,0:24:19.70,0:24:21.70,Default,,0000,0000,0000,,!هكذا إذاً، فهمت
Dialogue: 0,0:24:21.70,0:24:24.12,Default,,0000,0000,0000,,!إنّها حيلة حجّة غياب باستعمال المصعد
Dialogue: 0,0:24:25.44,0:24:26.78,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.78,0:24:29.28,Default,,0000,0000,0000,,جريمة قتل المصعد
Dialogue: 0,0:24:46.17,0:24:48.34,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.34,0:24:49.61,Default,,0000,0000,0000,,باقة أزهار

