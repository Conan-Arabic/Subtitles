Dialogue: 0,0:00:00.84,0:00:02.42,Default,,0000,0000,0000,,اسمي كودو شينتشي
Dialogue: 0,0:00:02.42,0:00:04.57,Default,,0000,0000,0000,,كنتُ متحرياً شهيراً في الثانوية حلّ\Nالكثير من القضايا الصعبة
Dialogue: 0,0:00:04.84,0:00:07.91,Default,,0000,0000,0000,,لكن أجبرتني منظمة ما في أحد الأيام\Nعلى تجرع عقار قلّص جسدي
Dialogue: 0,0:00:07.91,0:00:10.94,Default,,0000,0000,0000,,،وأصبحتُ إيدوغاوا كونان! مع أني أصبحت صغيراً\Nلا يزال عقلي كما هو
Dialogue: 0,0:00:10.94,0:00:12.16,Default,,0000,0000,0000,,!أخفي هويتي لكنّي مُتحرٍّ عظيم
Dialogue: 0,0:00:12.16,0:00:15.37,Default,,0000,0000,0000,,!مهما كانت القضية، الحقيقة واحدة دوماً
Dialogue: 0,0:01:45.96,0:01:52.03,Title,,0000,0000,0000,,{\fad(300,0)}ابتزاز لاعب كرة القدم المحترف
Dialogue: 0,0:01:46.98,0:01:50.27,Default,,0000,0000,0000,,ابتزاز لاعب كرة القدم المحترف
Dialogue: 0,0:01:52.48,0:01:56.64,Default,,0000,0000,0000,,هل تتطلّع لمباراة اليوم يا كونان؟
Dialogue: 0,0:01:56.64,0:01:59.05,Default,,0000,0000,0000,,مباراة كرة القدم
Dialogue: 0,0:01:59.59,0:02:02.51,Default,,0000,0000,0000,,...نهائي كأس ساندي
Dialogue: 0,0:02:02.84,0:02:05.13,Default,,0000,0000,0000,,من سيفوز برأيكم؟
Dialogue: 0,0:02:05.13,0:02:09.12,Default,,0000,0000,0000,,!أليس واضحاً؟ طوكيو سبيريتس بما أنّ هيديو لديهم
Dialogue: 0,0:02:09.12,0:02:12.43,Default,,0000,0000,0000,,!فقد سجّل أهدافاً في 17 مباراة متتالية
Dialogue: 0,0:02:12.79,0:02:16.08,Default,,0000,0000,0000,,!هيديو رائع، لكن يعجبني ناوكي أكثر
Dialogue: 0,0:02:16.08,0:02:20.11,Default,,0000,0000,0000,,،لكن أُصيب ناوكي في التمرين قبل فترة
Dialogue: 0,0:02:20.11,0:02:23.39,Default,,0000,0000,0000,,فلن يتمكن من المشاركة اليوم
Dialogue: 0,0:02:23.82,0:02:29.80,Default,,0000,0000,0000,,أظنّ هجوم ودفاع راموسو لفريق\N!بيغ أوساكا أفضل
Dialogue: 0,0:02:30.27,0:02:32.26,Default,,0000,0000,0000,,كرة القدم؟
Dialogue: 0,0:02:42.26,0:02:44.76,Default,,0000,0000,0000,,لمَ لا تدخلين؟
Dialogue: 0,0:02:44.76,0:02:47.09,Default,,0000,0000,0000,,تحتاجين مساعدة من وكالة التحري، صحيح؟
Dialogue: 0,0:02:51.03,0:02:53.66,Default,,0000,0000,0000,,أُدعى أكاغي ريوكو
Dialogue: 0,0:02:53.66,0:02:55.89,Default,,0000,0000,0000,,هناك شخص أريدك أن تجده
Dialogue: 0,0:02:56.33,0:03:00.80,Default,,0000,0000,0000,,اختفى فجأةً ولم أعلم ما عساي أفعل
Dialogue: 0,0:03:03.48,0:03:04.72,Default,,0000,0000,0000,,هذه صورة له
Dialogue: 0,0:03:05.48,0:03:06.88,Default,,0000,0000,0000,,كنّا نتواعد
Dialogue: 0,0:03:08.35,0:03:10.05,Default,,0000,0000,0000,,!كنتِ تواعدين شينتشي؟
Dialogue: 0,0:03:10.76,0:03:11.43,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:12.64,0:03:14.76,Default,,0000,0000,0000,,...أيمكن أنّ شينتشي في الواقع
Dialogue: 0,0:03:15.14,0:03:17.21,Default,,0000,0000,0000,,!لا بدّ من وجود سوء فهم ما
Dialogue: 0,0:03:17.21,0:03:18.59,Default,,0000,0000,0000,,ربما شخص يشبهه
Dialogue: 0,0:03:18.96,0:03:23.05,Default,,0000,0000,0000,,!لا شكّ في الأمر! فقد قبّلته حتى
Dialogue: 0,0:03:23.96,0:03:25.96,Default,,0000,0000,0000,,!قـ-قبّلته؟
Dialogue: 0,0:03:25.96,0:03:26.72,Default,,0000,0000,0000,,كذبة
Dialogue: 0,0:03:27.04,0:03:29.41,Default,,0000,0000,0000,,،أخبرك أنّه كان يعمل على قضية
Dialogue: 0,0:03:29.41,0:03:32.74,Default,,0000,0000,0000,,بينما كان يعبث مع فتيات أخريات إذاً
Dialogue: 0,0:03:32.74,0:03:34.35,Default,,0000,0000,0000,,...أخبرتكم أنّه مجرد سوء
Dialogue: 0,0:03:34.99,0:03:38.22,Default,,0000,0000,0000,,!اصمت فقط
Dialogue: 0,0:03:38.65,0:03:41.64,Default,,0000,0000,0000,,!لا يمكنني العيش دون شينتشي-سان
Dialogue: 0,0:03:42.11,0:03:45.40,Default,,0000,0000,0000,,!لا يمكنني المواصلة هكذا
Dialogue: 0,0:03:45.40,0:03:48.05,Default,,0000,0000,0000,,تقولين هذا، لكن لم يسبق أن رأيتك
Dialogue: 0,0:03:48.68,0:03:50.78,Default,,0000,0000,0000,,ما خطب هذه الفتاة؟
Dialogue: 0,0:03:54.01,0:03:56.56,Default,,0000,0000,0000,,أكان تبادل القبل أبعد ما وصلتما له؟
Dialogue: 0,0:03:56.56,0:03:58.67,Default,,0000,0000,0000,,أم تماديتما أكثر؟
Dialogue: 0,0:03:58.67,0:03:59.88,Default,,0000,0000,0000,,صحيح، أفعلتما؟
Dialogue: 0,0:03:59.88,0:04:02.14,Default,,0000,0000,0000,,لا-لا يمكنني الإجابة على أشياء كهذه
Dialogue: 0,0:04:04.05,0:04:06.05,Default,,0000,0000,0000,,أجل، وكالة موري للتحري
Dialogue: 0,0:04:06.05,0:04:08.33,Default,,0000,0000,0000,,!شينتشي! ممتاز
Dialogue: 0,0:04:08.33,0:04:09.26,Default,,0000,0000,0000,,بروفسور آغاسا
Dialogue: 0,0:04:09.95,0:04:13.79,Default,,0000,0000,0000,,بشأن الأداة الجديدة التي أعطيتك إيّاها\N...صباح اليوم، المدّخرة
Dialogue: 0,0:04:13.79,0:04:16.16,Default,,0000,0000,0000,,!فهمت! سأبلغها بالأمر
Dialogue: 0,0:04:16.16,0:04:18.01,Default,,0000,0000,0000,,!وداعاً يا شينتشي-نيتشان
Dialogue: 0,0:04:19.65,0:04:21.15,Default,,0000,0000,0000,,أكان ذلك شينتشي؟
Dialogue: 0,0:04:21.15,0:04:25.14,Default,,0000,0000,0000,,أجل، قال أنّه سيتصل بريوكو-سان لاحقاً\Nلذا ليس عليك القلق بشأنه
Dialogue: 0,0:04:26.32,0:04:29.27,Default,,0000,0000,0000,,!سأرى شينتشي-سان؟
Dialogue: 0,0:04:29.27,0:04:30.88,Default,,0000,0000,0000,,حمداً لله
Dialogue: 0,0:04:31.39,0:04:33.64,Default,,0000,0000,0000,,!لنذهب لمنزلها بأيّ حال
Dialogue: 0,0:04:33.64,0:04:35.39,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:04:35.39,0:04:39.09,Default,,0000,0000,0000,,لأن شينتشي قد يأتي هناك
Dialogue: 0,0:04:39.09,0:04:41.97,Default,,0000,0000,0000,,!سنذهب معاً ثم سألقنه درساً
Dialogue: 0,0:04:43.92,0:04:45.69,Default,,0000,0000,0000,,لا مشكلة، صحيح يا ريوكو-سان؟
Dialogue: 0,0:04:45.69,0:04:46.27,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:04:47.16,0:04:49.93,Default,,0000,0000,0000,,لن أتدخل، لا أهتم لسخافات حُب الصغار
Dialogue: 0,0:04:50.54,0:04:51.64,Default,,0000,0000,0000,,...أنا أيضاً
Dialogue: 0,0:04:54.08,0:04:55.81,Default,,0000,0000,0000,,ربما سأذهب
Dialogue: 0,0:05:02.15,0:05:04.00,Default,,0000,0000,0000,,تفضّلا بالدخول
Dialogue: 0,0:05:07.77,0:05:10.05,Default,,0000,0000,0000,,...علامات تلاعب بالقفل
Dialogue: 0,0:05:17.13,0:05:19.74,Default,,0000,0000,0000,,أحذية رجال وأطفال فقط
Dialogue: 0,0:05:20.97,0:05:22.97,Default,,0000,0000,0000,,لا فتيات يعشن هنا
Dialogue: 0,0:05:24.43,0:05:27.97,Default,,0000,0000,0000,,هذا غريب، من تكون بالضبط؟
Dialogue: 0,0:05:31.33,0:05:34.33,Default,,0000,0000,0000,,ماذا؟ أين كان الشاي؟
Dialogue: 0,0:05:35.58,0:05:36.47,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:05:36.95,0:05:38.30,Default,,0000,0000,0000,,...الملاعق
Dialogue: 0,0:05:39.03,0:05:40.43,Default,,0000,0000,0000,,...الإناء
Dialogue: 0,0:05:43.49,0:05:47.85,Default,,0000,0000,0000,,إذاً يا أكاغي-سان، مُذ متى وأنت تواعدين شينتشي؟
Dialogue: 0,0:05:47.85,0:05:51.02,Default,,0000,0000,0000,,أريد المعرفة بما أني صديقة طفولته
Dialogue: 0,0:05:52.65,0:05:53.71,Default,,0000,0000,0000,,أكاغي-سان؟
Dialogue: 0,0:05:55.27,0:05:57.30,Default,,0000,0000,0000,,!أكاغي ريوكو-سان
Dialogue: 0,0:05:57.30,0:05:58.34,Default,,0000,0000,0000,,أجل! ماذا هناك؟
Dialogue: 0,0:05:59.51,0:06:01.14,Default,,0000,0000,0000,,تتجاهلني هكذا
Dialogue: 0,0:06:01.14,0:06:02.80,Default,,0000,0000,0000,,لا يعجبها الكلام معي إذاً؟
Dialogue: 0,0:06:04.18,0:06:06.95,Default,,0000,0000,0000,,يبدو أنّ علي البحث أعمق في أمرها
Dialogue: 0,0:06:11.97,0:06:13.88,On Top,,0000,0000,0000,,مامورو
Dialogue: 0,0:06:14.48,0:06:15.65,Default,,0000,0000,0000,,مامورو؟
Dialogue: 0,0:06:21.59,0:06:23.66,Default,,0000,0000,0000,,!ما الذي حدث هنا؟
Dialogue: 0,0:06:36.07,0:06:38.11,On Top,,0000,0000,0000,,مامورو أكاغي
Dialogue: 0,0:06:36.91,0:06:38.11,Default,,0000,0000,0000,,مامورو؟
Dialogue: 0,0:06:40.91,0:06:43.62,Default,,0000,0000,0000,,يبدو أنّ هذه غرفة هذا الطفل
Dialogue: 0,0:06:44.57,0:06:46.53,Default,,0000,0000,0000,,ومن الشاب برفقته؟
Dialogue: 0,0:06:47.86,0:06:49.44,Default,,0000,0000,0000,,...رأيته في مكان قبلاً
Dialogue: 0,0:06:49.77,0:06:51.63,Default,,0000,0000,0000,,الأجواء تشتعل في الاستاد الرياضي الوطني
Dialogue: 0,0:06:51.63,0:06:53.47,Default,,0000,0000,0000,,مع استمرار مباراة بطولة كأس ساندي
Dialogue: 0,0:06:53.47,0:06:55.05,Default,,0000,0000,0000,,لا تزال النتيجة صفراً لصفر
Dialogue: 0,0:06:55.05,0:06:57.72,Default,,0000,0000,0000,,هل سيفتتح طوكيو سبيريتس التسجيل؟
Dialogue: 0,0:06:57.72,0:06:58.90,Default,,0000,0000,0000,,أم سيسبقونهم بيغ أوساكا؟
Dialogue: 0,0:06:59.55,0:07:02.36,Default,,0000,0000,0000,,لمَ شغلت التلفاز فجأةً؟
Dialogue: 0,0:07:02.68,0:07:05.82,Default,,0000,0000,0000,,!لا تريد الكلام معي لهذا الحد؟
Dialogue: 0,0:07:07.25,0:07:08.78,Default,,0000,0000,0000,,ماذا؟ تشاهدان كرة القدم؟
Dialogue: 0,0:07:09.17,0:07:12.59,Default,,0000,0000,0000,,أجل، كانت ريوكو-سان تريد مشاهدتها بشدّة
Dialogue: 0,0:07:12.59,0:07:14.34,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:07:14.34,0:07:15.03,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:15.03,0:07:17.41,Default,,0000,0000,0000,,!يا إلهي! ركلة أخرى سيّئة لهيدي
Dialogue: 0,0:07:17.41,0:07:20.15,Default,,0000,0000,0000,,هل يُظهر ذو الـ 19 ربيعاً أكاغي هيديو\Nعلامات قلّة خبرته؟
Dialogue: 0,0:07:20.15,0:07:21.53,Default,,0000,0000,0000,,!أكاغي؟
Dialogue: 0,0:07:24.83,0:07:30.82,Default,,0000,0000,0000,,هكذا إذاً! كانت تلك صورة أكاغي هيديو\Nمن فريق طوكيو سبيريتس
Dialogue: 0,0:07:30.82,0:07:34.53,Default,,0000,0000,0000,,ذاك الطفل المدعو أكاغي مامورو شقيقه الصغير إذاً؟
Dialogue: 0,0:07:34.82,0:07:37.72,Default,,0000,0000,0000,,بالتفكير في الأمر، انتشر في الجرائد \Nأن والداه تُوفيا قبل عامين
Dialogue: 0,0:07:37.72,0:07:40.49,Default,,0000,0000,0000,,وأصبح يعيش مع شقيقه الآن
Dialogue: 0,0:07:41.39,0:07:44.68,Default,,0000,0000,0000,,مما يعني أنّ هذه الفتاة ليست من أهل البيت
Dialogue: 0,0:07:44.68,0:07:47.79,Default,,0000,0000,0000,,لمَ هي هنا إذاً؟ ولمَ تستعمل اسماً زائفاً؟
Dialogue: 0,0:07:49.71,0:07:52.09,Default,,0000,0000,0000,,!كلا! ركلة أخرى خاطئة لهيدي
Dialogue: 0,0:07:52.09,0:07:54.37,Default,,0000,0000,0000,,ليس في مستواه اليوم حقاً
Dialogue: 0,0:07:54.95,0:07:58.45,Default,,0000,0000,0000,,غريب، لمَ ارتكب خطأً بسيطاً كهذا؟
Dialogue: 0,0:07:58.45,0:08:00.04,Default,,0000,0000,0000,,...كما لو كان متعمداً
Dialogue: 0,0:08:07.19,0:08:09.10,Default,,0000,0000,0000,,...هكذا إذاً! أيمكن أنّ هذا
Dialogue: 0,0:08:16.47,0:08:19.24,Default,,0000,0000,0000,,سأستعمل الجهاز الذي أعطاني إيّاه\Nالبروفسور هذا الصباح
Dialogue: 0,0:08:19.64,0:08:24.39,Default,,0000,0000,0000,,!إنّه آخر اختراعاتي، آلة فاكس علبة الغداء المتنقلة
Dialogue: 0,0:08:24.39,0:08:27.01,Default,,0000,0000,0000,,أيّ آخر اختراعاتي؟
Dialogue: 0,0:08:27.01,0:08:30.53,Default,,0000,0000,0000,,كلّ ما فعلته هو وضع آلة فاكس\Nداخل صندوق غداء
Dialogue: 0,0:08:37.20,0:08:38.25,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:08:38.25,0:08:39.29,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:08:39.29,0:08:41.82,Default,,0000,0000,0000,,شينتشي-سان؟ شينتشي-سان، صحيح؟
Dialogue: 0,0:08:42.50,0:08:44.78,Default,,0000,0000,0000,,...أنا، هناك
Dialogue: 0,0:08:45.49,0:08:47.23,Default,,0000,0000,0000,,اختطاف، صحيح؟
Dialogue: 0,0:08:48.36,0:08:50.40,Default,,0000,0000,0000,,المُختطف هو أكاغي مامورو-كن
Dialogue: 0,0:08:50.40,0:08:54.15,Default,,0000,0000,0000,,الشقيق الأصغر لأكاغي هيديو الذي يلعب\Nعلى التلفاز الآن
Dialogue: 0,0:08:54.15,0:08:57.57,Default,,0000,0000,0000,,طلب الخاطفُ أن يخسر المُباراة عمداً
Dialogue: 0,0:08:58.18,0:08:59.89,Default,,0000,0000,0000,,قلتِ أنّك تواعدينني
Dialogue: 0,0:08:59.89,0:09:02.95,Default,,0000,0000,0000,,لأنّك أردت الاتصال بي بأسرع ما يمكن
Dialogue: 0,0:09:03.35,0:09:06.59,Default,,0000,0000,0000,,هدّد الخاطف بقتل مامورو في حال أخبرتِ الشرطة
Dialogue: 0,0:09:06.59,0:09:08.44,Default,,0000,0000,0000,,أو أيّ محققين غالباً
Dialogue: 0,0:09:08.80,0:09:11.30,Default,,0000,0000,0000,,سبب استعمالك لاسم أكاغي ريوكو المزيف
Dialogue: 0,0:09:11.30,0:09:13.84,Default,,0000,0000,0000,,هو لأنّك لم تريدي إثارة شبهة الآخرين
Dialogue: 0,0:09:13.84,0:09:15.58,Default,,0000,0000,0000,,أردتِ إحضاري لمنزل أكاغي
Dialogue: 0,0:09:15.58,0:09:18.91,Default,,0000,0000,0000,,ثمّ إخباري وحدي بحقيقة ما يجري
Dialogue: 0,0:09:18.91,0:09:20.75,Default,,0000,0000,0000,,أليس كذلك؟
Dialogue: 0,0:09:20.75,0:09:21.32,Default,,0000,0000,0000,,!بلى
Dialogue: 0,0:09:22.33,0:09:25.28,Default,,0000,0000,0000,,لكن كيف عرفت أنه اُختطف؟
Dialogue: 0,0:09:25.28,0:09:28.74,Default,,0000,0000,0000,,لم تأت هنا بعد
Dialogue: 0,0:09:28.74,0:09:33.24,Default,,0000,0000,0000,,!الـ-السبب... لأنّي مُتحرٍّ عظيم
Dialogue: 0,0:09:33.65,0:09:36.48,Default,,0000,0000,0000,,اكتبي تفاصيل اختطاف مامورو-كن
Dialogue: 0,0:09:36.48,0:09:38.10,Default,,0000,0000,0000,,وأرسليها بالفاكس لي رجاءً
Dialogue: 0,0:09:38.10,0:09:40.14,Default,,0000,0000,0000,,...الرقم
Dialogue: 0,0:09:40.14,0:09:41.98,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:09:41.98,0:09:44.98,Default,,0000,0000,0000,,!ما الخطب؟! تكلمين شينتشي، صحيح؟
Dialogue: 0,0:09:45.93,0:09:50.20,Default,,0000,0000,0000,,...أنا سعيدة، فهمني شينتشي-سان
Dialogue: 0,0:09:51.26,0:09:54.32,Default,,0000,0000,0000,,!ما هذا؟ ما الذي يبكيها؟
Dialogue: 0,0:09:57.62,0:09:58.82,Default,,0000,0000,0000,,!أين أنت؟
Dialogue: 0,0:09:59.62,0:10:02.19,Default,,0000,0000,0000,,!تعال وفسّر أفعالك يا شينتشي
Dialogue: 0,0:10:04.74,0:10:05.77,Default,,0000,0000,0000,,...أكان ذاك
Dialogue: 0,0:10:06.28,0:10:07.45,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:10:09.74,0:10:11.24,Default,,0000,0000,0000,,!أسمع صوتي من الهاتف الآخر
Dialogue: 0,0:10:12.28,0:10:13.07,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:10:14.20,0:10:16.22,Default,,0000,0000,0000,,...مما يعني أنّ شينتشي
Dialogue: 0,0:10:18.31,0:10:20.53,Default,,0000,0000,0000,,!في هذه الشقّة
Dialogue: 0,0:10:20.94,0:10:22.28,Default,,0000,0000,0000,,!ممتاز
Dialogue: 0,0:10:27.34,0:10:28.99,Default,,0000,0000,0000,,!ها هي
Dialogue: 0,0:10:29.97,0:10:31.84,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:10:31.84,0:10:34.34,Default,,0000,0000,0000,,اكتشفت أنّ مامورو-تشان اُختطف"
Dialogue: 0,0:10:34.34,0:10:38.63,Default,,0000,0000,0000,,عندما أتيت لإعداد الإفطار له هذا الصباح
Dialogue: 0,0:10:38.63,0:10:40.90,Default,,0000,0000,0000,,سأرسل رسالة الخاطف التي كانت على الطاولة
Dialogue: 0,0:10:41.75,0:10:46.20,Default,,0000,0000,0000,,"مع رسالة مامورو-تشان التي جعله الخاطف يكتبها
Dialogue: 0,0:10:46.20,0:10:46.86,Default,,0000,0000,0000,,هذه؟
Dialogue: 0,0:10:47.62,0:10:49.43,Default,,0000,0000,0000,,"أرجِع مامورو للحياة"
Dialogue: 0,0:10:51.78,0:10:54.45,Default,,0000,0000,0000,,رسالة غريبة لشخص يطلب النجدة
Dialogue: 0,0:10:56.77,0:10:57.98,Default,,0000,0000,0000,,ما هذه العلامات؟
Dialogue: 0,0:10:59.40,0:11:00.53,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:11:03.40,0:11:05.60,Default,,0000,0000,0000,,!أين أنت؟ أظهر نفسك
Dialogue: 0,0:11:05.60,0:11:06.27,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:11:13.14,0:11:16.48,Default,,0000,0000,0000,,قد يكون التعامل مع ران أصعب من القضية
Dialogue: 0,0:11:17.21,0:11:18.84,Default,,0000,0000,0000,,يتهيّأ هيدي للتمرير
Dialogue: 0,0:11:18.84,0:11:20.79,Default,,0000,0000,0000,,!كلا! ركل الكرة بعيداً
Dialogue: 0,0:11:20.79,0:11:21.95,Default,,0000,0000,0000,,!أهذه ركلة خاطئة أخرى؟
Dialogue: 0,0:11:23.63,0:11:25.52,Default,,0000,0000,0000,,!كلا! وصلت لتاكيدا في مكان ممتاز
Dialogue: 0,0:11:25.52,0:11:26.79,Default,,0000,0000,0000,,!يراوغ الدفاع ويسدد
Dialogue: 0,0:11:28.03,0:11:29.38,Default,,0000,0000,0000,,!هدف
Dialogue: 0,0:11:31.12,0:11:32.20,Default,,0000,0000,0000,,!هذا هو هيدي
Dialogue: 0,0:11:32.20,0:11:35.74,Default,,0000,0000,0000,,لعبة ممتازة اخترقت دفاع الخصم\Nوأعطت التقدم لسبيريتس
Dialogue: 0,0:11:54.96,0:11:56.01,Default,,0000,0000,0000,,أخليت باتفاقنا
Dialogue: 0,0:11:56.01,0:11:57.19,Default,,0000,0000,0000,,لن تلتقي أخاك مجدداً
Dialogue: 0,0:11:57.63,0:11:58.56,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:12:07.57,0:12:10.61,Default,,0000,0000,0000,,!لا أمل الآن! مامورو-تشان
Dialogue: 0,0:12:11.24,0:12:12.16,Default,,0000,0000,0000,,هذا سيّئ
Dialogue: 0,0:12:12.16,0:12:16.48,Default,,0000,0000,0000,,!عليّ إيجاد المختطِف سريعاً وإلّا سيموت مامورو-كن
Dialogue: 0,0:12:17.53,0:12:19.44,Default,,0000,0000,0000,,اختطف طفلاً في السنة الثالثة في الابتدائية
Dialogue: 0,0:12:20.19,0:12:22.03,Default,,0000,0000,0000,,حتّى لو قاوم
Dialogue: 0,0:12:22.03,0:12:24.28,Default,,0000,0000,0000,,من الغريب أن تحلّ هذه الفوضى بالغرفة
Dialogue: 0,0:12:30.74,0:12:33.85,Default,,0000,0000,0000,,هذه لعبة "أونيمارو كويست" التي صدرت بالأمس
Dialogue: 0,0:12:33.85,0:12:36.17,Default,,0000,0000,0000,,لكنها فارغة
Dialogue: 0,0:12:36.17,0:12:39.19,Default,,0000,0000,0000,,لن يأخذ طفل مُختطف لعبةً معه
Dialogue: 0,0:12:39.90,0:12:41.90,Default,,0000,0000,0000,,...صحيح، قال غينتا وميتسوهيكو
Dialogue: 0,0:12:42.76,0:12:45.50,Default,,0000,0000,0000,,!يموت البطل في اللعبة
Dialogue: 0,0:12:45.50,0:12:49.15,Default,,0000,0000,0000,,!أجل، ولا يمكنك الفوز دون إعادته للحياة
Dialogue: 0,0:12:49.58,0:12:50.62,Default,,0000,0000,0000,,!إعادته للحياة؟
Dialogue: 0,0:12:52.79,0:12:53.57,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:13:03.16,0:13:04.12,Default,,0000,0000,0000,,!كنتُ محقاً
Dialogue: 0,0:13:04.56,0:13:08.07,Default,,0000,0000,0000,,!وضع مامورو-كن اسمه للشخصية الرئيسية
Dialogue: 0,0:13:08.77,0:13:12.53,Default,,0000,0000,0000,,!مامورو المذكور في تلك الرسالة هو بطل اللعبة
Dialogue: 0,0:13:14.10,0:13:14.94,Default,,0000,0000,0000,,ناوكي؟
Dialogue: 0,0:13:15.55,0:13:18.51,Default,,0000,0000,0000,,أعرف من هم مامورو وهيديو وريوكو
Dialogue: 0,0:13:18.51,0:13:21.30,Default,,0000,0000,0000,,لكن من ناوكي هذا؟
Dialogue: 0,0:13:21.30,0:13:22.95,Default,,0000,0000,0000,,أحد أصدقاء مامورو-كن؟
Dialogue: 0,0:13:24.26,0:13:27.36,Default,,0000,0000,0000,,...لحظة، هيدي وناوكي
Dialogue: 0,0:13:27.71,0:13:30.82,Default,,0000,0000,0000,,!هيديو رائع، لكن يعجبني ناوكي أكثر
Dialogue: 0,0:13:31.12,0:13:36.27,Default,,0000,0000,0000,,هكذا إذاً، أوميورا ناوكي الذي انضمّ لسبيريتس\Nمع هيدي سويّاً العام الماضي
Dialogue: 0,0:13:36.90,0:13:39.03,Default,,0000,0000,0000,,...وهاتان العلامتان
Dialogue: 0,0:13:39.86,0:13:43.20,Default,,0000,0000,0000,,ماذا لو كانت "كي" في ناوكي؟
Dialogue: 0,0:13:43.49,0:13:44.37,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:13:48.73,0:13:49.69,Default,,0000,0000,0000,,أجل! مرحباً؟
Dialogue: 0,0:13:50.23,0:13:53.66,Default,,0000,0000,0000,,اكتشفت مكان مامورو-كن يا ريوكو-سان
Dialogue: 0,0:13:54.14,0:13:57.05,Default,,0000,0000,0000,,!حـ-حقّاً يا شينتشي-سان؟
Dialogue: 0,0:13:57.05,0:13:58.84,Default,,0000,0000,0000,,أين مامورو-تشان؟
Dialogue: 0,0:13:58.84,0:14:03.66,Default,,0000,0000,0000,,قبل ذلك، أتعرفين شخصاً يُدعى أوميورا ناوكي؟
Dialogue: 0,0:14:04.05,0:14:07.42,Default,,0000,0000,0000,,أجل، إنّه صديق هيديو-سان ويعيش بالقرب
Dialogue: 0,0:14:07.42,0:14:12.83,Default,,0000,0000,0000,,أيمكن أنّه يأتي كثيراً للهو مع مامورو-كن؟
Dialogue: 0,0:14:12.83,0:14:16.11,Default,,0000,0000,0000,,أجل، يعرف ناوكي-سان الكثير عن ألعاب الفيديو
Dialogue: 0,0:14:16.11,0:14:17.57,Default,,0000,0000,0000,,لكن لمَ تسأل؟
Dialogue: 0,0:14:18.32,0:14:20.63,Default,,0000,0000,0000,,لم يُختطف مامورو-كن
Dialogue: 0,0:14:21.53,0:14:26.52,Default,,0000,0000,0000,,الخدوش على قفل الباب الأمامي \Nوالخراب في غرفة مامورو-كن
Dialogue: 0,0:14:26.52,0:14:28.03,Default,,0000,0000,0000,,كانا متعمّدين من الفاعل
Dialogue: 0,0:14:28.90,0:14:31.99,Default,,0000,0000,0000,,ليجعل الأمر يبدو عملية اختطاف مشؤومة
Dialogue: 0,0:14:32.44,0:14:34.31,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:14:34.31,0:14:36.55,Default,,0000,0000,0000,,:كانت رسالة مامورو-كن الكاملة غالباً
Dialogue: 0,0:14:36.55,0:14:41.90,Default,,0000,0000,0000,,"سأذهب لمنزل ناوكي لإرجاع مامورو للحياة"
Dialogue: 0,0:14:41.90,0:14:45.25,Default,,0000,0000,0000,,مزق الخاطف الورقة وأرسل ذاك الجزء فقط
Dialogue: 0,0:14:45.25,0:14:48.82,Default,,0000,0000,0000,,...مـ-من اختطفه إذاً
Dialogue: 0,0:14:49.08,0:14:52.50,Default,,0000,0000,0000,,أجل، الفاعل هو أوميورا ناوكي
Dialogue: 0,0:14:52.50,0:14:54.25,Default,,0000,0000,0000,,مامورو-كن في منزله غالباً
Dialogue: 0,0:14:57.41,0:15:00.49,Default,,0000,0000,0000,,!وجدتك أخيراً، أخيراً يا شينتشي
Dialogue: 0,0:15:02.16,0:15:04.32,Default,,0000,0000,0000,,!شينتشي! اخرج
Dialogue: 0,0:15:04.32,0:15:05.98,Default,,0000,0000,0000,,!أعرف أنّك هنا
Dialogue: 0,0:15:06.98,0:15:09.94,Default,,0000,0000,0000,,!أنا أستعمل المرحاض الآن فلا يمكنني الخروج يا حمقاء
Dialogue: 0,0:15:09.94,0:15:13.41,Default,,0000,0000,0000,,حقاً؟ هكذا إذاً؟
Dialogue: 0,0:15:14.02,0:15:15.15,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:15:16.93,0:15:19.03,Default,,0000,0000,0000,,!هـ-هل ستستعمل الكاراتيه على الباب؟
Dialogue: 0,0:15:20.26,0:15:21.24,Default,,0000,0000,0000,,!انتظري يا ران-سان
Dialogue: 0,0:15:23.10,0:15:23.66,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:24.18,0:15:27.65,Default,,0000,0000,0000,,قال شينتشي-سان أنه يريد محادثتك على الهاتف
Dialogue: 0,0:15:28.17,0:15:30.42,Default,,0000,0000,0000,,!إن أردت قول شيء فافعل أمامي
Dialogue: 0,0:15:30.42,0:15:33.99,Default,,0000,0000,0000,,!الأمر مهم، فأريدك وحدك أن تسمعيه
Dialogue: 0,0:15:34.58,0:15:35.94,Default,,0000,0000,0000,,كما قال
Dialogue: 0,0:15:36.49,0:15:38.09,Default,,0000,0000,0000,,أمر مهم؟
Dialogue: 0,0:15:39.58,0:15:40.89,Default,,0000,0000,0000,,وحدي؟
Dialogue: 0,0:15:43.41,0:15:46.23,Default,,0000,0000,0000,,...إن كنت ستحاول تقديم أعذار، فأنا لن
Dialogue: 0,0:15:49.44,0:15:51.28,Default,,0000,0000,0000,,ما الذي تريد قوله إذاً يا شينتشي؟
Dialogue: 0,0:15:51.90,0:15:53.61,Default,,0000,0000,0000,,تكلّم
Dialogue: 0,0:15:56.73,0:15:58.01,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:15:58.01,0:15:59.19,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:16:00.18,0:16:01.15,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:16:01.81,0:16:04.80,Default,,0000,0000,0000,,!ركض شينتشي-نيتشان للخارج لتوه
Dialogue: 0,0:16:04.80,0:16:05.92,Default,,0000,0000,0000,,!ذاك الوغد
Dialogue: 0,0:16:05.92,0:16:08.00,Default,,0000,0000,0000,,أين ذهب شينتشي-سان إذاً؟
Dialogue: 0,0:16:08.00,0:16:10.34,Default,,0000,0000,0000,,قال أنّه سينقذ مامورو-كن
Dialogue: 0,0:16:10.34,0:16:12.55,Default,,0000,0000,0000,,أيعني أنّه ذهب لمنزل ناوكي-سان؟
Dialogue: 0,0:16:12.55,0:16:15.32,Default,,0000,0000,0000,,!ناوكي؟ أهرب شينتشي هناك؟
Dialogue: 0,0:16:16.04,0:16:18.32,Default,,0000,0000,0000,,!هيا، أريني الطريق
Dialogue: 0,0:16:24.86,0:16:27.32,Default,,0000,0000,0000,,!كلا! ركلة سيّئة أخرى لهيدي
Dialogue: 0,0:16:27.32,0:16:29.36,Default,,0000,0000,0000,,!ماذا حلّ بالعبقري أكاغي هيديو؟
Dialogue: 0,0:16:30.23,0:16:31.61,Default,,0000,0000,0000,,!مامورو
Dialogue: 0,0:16:34.93,0:16:36.69,Default,,0000,0000,0000,,أجل، من هناك؟
Dialogue: 0,0:16:37.27,0:16:38.22,Default,,0000,0000,0000,,أنا ريوكو
Dialogue: 0,0:16:38.22,0:16:41.43,Default,,0000,0000,0000,,...ريوكو-تشان؟ ماذا هناك؟ أنا الآن
Dialogue: 0,0:16:41.43,0:16:43.11,Default,,0000,0000,0000,,افتح الباب بأيّ حال رجاءً
Dialogue: 0,0:16:47.92,0:16:48.61,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:16:49.59,0:16:51.59,Default,,0000,0000,0000,,آسفة، هلّا أدخلتني؟
Dialogue: 0,0:16:51.59,0:16:54.36,Default,,0000,0000,0000,,لا يمكنني، حبيبتي هنا الآن
Dialogue: 0,0:16:54.36,0:16:55.75,Default,,0000,0000,0000,,لا أريدها أن تسيء الفهم
Dialogue: 0,0:16:55.75,0:16:57.62,Default,,0000,0000,0000,,!مامورو-تشان
Dialogue: 0,0:16:57.62,0:16:59.79,Default,,0000,0000,0000,,!مامورو-تشان! تكلّم إن كنت هنا
Dialogue: 0,0:16:59.79,0:17:01.45,Default,,0000,0000,0000,,!أنت! توقفي عن هذا
Dialogue: 0,0:17:02.08,0:17:02.82,Default,,0000,0000,0000,,ابتعدي
Dialogue: 0,0:17:11.74,0:17:14.24,Default,,0000,0000,0000,,!شينتشي! اخرج فوراً
Dialogue: 0,0:17:14.24,0:17:15.68,Default,,0000,0000,0000,,!مامورو-تشان
Dialogue: 0,0:17:19.43,0:17:20.86,Default,,0000,0000,0000,,!ريوكو-نيتشان
Dialogue: 0,0:17:21.27,0:17:23.10,Default,,0000,0000,0000,,!مامورو-تشان
Dialogue: 0,0:17:23.10,0:17:26.20,Default,,0000,0000,0000,,!أحمق! أخبرتك ألا تغادر دون قول شيء
Dialogue: 0,0:17:27.09,0:17:29.51,Default,,0000,0000,0000,,لكنّي كتبت ملاحظة
Dialogue: 0,0:17:29.51,0:17:33.32,Default,,0000,0000,0000,,!صحيح! أنهيت اللعبة أخيراً بفضل ناوكي-نيتشان
Dialogue: 0,0:17:34.05,0:17:35.86,Default,,0000,0000,0000,,!حقّاً يا ريوكو؟
Dialogue: 0,0:17:36.33,0:17:38.37,Default,,0000,0000,0000,,!هل مامورو بخير حقاً؟
Dialogue: 0,0:17:38.37,0:17:39.19,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:17:39.54,0:17:41.41,Default,,0000,0000,0000,,!ما الذي تفعله يا هيديو؟
Dialogue: 0,0:17:41.41,0:17:43.03,Default,,0000,0000,0000,,!أنت في مشكلة كبيرة إن خسرت
Dialogue: 0,0:17:43.41,0:17:44.49,Default,,0000,0000,0000,,...مامورو
Dialogue: 0,0:17:44.49,0:17:47.23,Default,,0000,0000,0000,,!هيدي! سيبدأ الشوط الثاني
Dialogue: 0,0:17:48.49,0:17:49.12,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:17:55.86,0:17:57.88,Default,,0000,0000,0000,,!هدف
Dialogue: 0,0:17:57.88,0:18:00.10,Default,,0000,0000,0000,,!اثنان مقابل واحد! استعاد هيديو تسديداته الحادة
Dialogue: 0,0:18:00.10,0:18:02.23,Default,,0000,0000,0000,,يلعب كما لو أنّه كان يتظاهر بالضعف في الشوط الأوّل
Dialogue: 0,0:18:02.23,0:18:05.40,Default,,0000,0000,0000,,!إنّه عبقري بحق! العبقري أكاغي هيديو
Dialogue: 0,0:18:06.59,0:18:08.63,Default,,0000,0000,0000,,عبقري؟
Dialogue: 0,0:18:08.63,0:18:09.97,Default,,0000,0000,0000,,الأمر هكذا دوماً
Dialogue: 0,0:18:09.97,0:18:13.43,Default,,0000,0000,0000,,هيديو العبقري بالموهبة، وأنا رجل اجتهاد
Dialogue: 0,0:18:13.43,0:18:15.40,Default,,0000,0000,0000,,!شعبيته ومرتّبه أعلى مني بكثير
Dialogue: 0,0:18:15.87,0:18:18.36,Default,,0000,0000,0000,,!مع أنّنا أحرزنا نفس العدد من الأهداف في الثانوية
Dialogue: 0,0:18:19.21,0:18:26.07,Default,,0000,0000,0000,,أمضيتُ كلّ يوم بتدريب شاق ومضنٍ حتّى أتفوق عليه
Dialogue: 0,0:18:26.07,0:18:28.36,Default,,0000,0000,0000,,ثمّ لحقت به أخيراً
Dialogue: 0,0:18:28.36,0:18:30.41,Default,,0000,0000,0000,,!بل تجاوزته
Dialogue: 0,0:18:30.41,0:18:35.02,Default,,0000,0000,0000,,حتّى حطّم ساقي اليمنى في مباراة تمرينية
Dialogue: 0,0:18:35.81,0:18:38.99,Default,,0000,0000,0000,,!صحيح، تعمّد إصابة ساقي
Dialogue: 0,0:18:39.60,0:18:41.70,Default,,0000,0000,0000,,!كان يخاف أن أفوقه
Dialogue: 0,0:18:42.40,0:18:46.22,Default,,0000,0000,0000,,حُرمت من اللعب 3 أشهر بسببه
Dialogue: 0,0:18:46.22,0:18:48.65,Default,,0000,0000,0000,,من المستحيل أن أحاول تجاوزه الآن
Dialogue: 0,0:18:49.26,0:18:52.45,Default,,0000,0000,0000,,لكن لم تكن لديّ أي نية بأذية مامورو من البداية
Dialogue: 0,0:18:52.45,0:18:54.19,Default,,0000,0000,0000,,كنتُ سأعيده للمنزل بعد نهاية المباراة
Dialogue: 0,0:18:55.13,0:18:57.11,Default,,0000,0000,0000,,ثمّ أختفي في مكانٍ ما
Dialogue: 0,0:18:57.92,0:19:01.11,Default,,0000,0000,0000,,أردتُ الانتقام منه فقط
Dialogue: 0,0:19:01.58,0:19:03.21,Default,,0000,0000,0000,,!انتهت المباراة
Dialogue: 0,0:19:03.21,0:19:07.16,Default,,0000,0000,0000,,!فاز طوكيو سبيريتس بكأس ساندي 3 مقابل 1
Dialogue: 0,0:19:07.16,0:19:08.53,Default,,0000,0000,0000,,!مرحى
Dialogue: 0,0:19:09.57,0:19:11.49,Default,,0000,0000,0000,,انتهت المباراة هنا أيضاً
Dialogue: 0,0:19:12.74,0:19:15.69,Default,,0000,0000,0000,,حسناً يا ريوكو-تشان، اتصلي بالشرطة
Dialogue: 0,0:19:15.69,0:19:17.44,Default,,0000,0000,0000,,وأخبريهم أنّ هناك مختطفاً هنا
Dialogue: 0,0:19:18.26,0:19:19.68,Default,,0000,0000,0000,,مُبارك يا هيدي
Dialogue: 0,0:19:19.68,0:19:21.86,Default,,0000,0000,0000,,لمن تودّ إهداء فوزك هذا بالتحديد؟
Dialogue: 0,0:19:21.86,0:19:26.32,Default,,0000,0000,0000,,حسناً، كنتُ لأودّ إهداءه لشقيقي الصغير مامورو
Dialogue: 0,0:19:26.80,0:19:28.93,Default,,0000,0000,0000,,لكني سأهديه لناوكي
Dialogue: 0,0:19:28.93,0:19:32.28,Default,,0000,0000,0000,,منافسي الأكبر، أوميورا ناوكي
Dialogue: 0,0:19:32.76,0:19:35.11,Default,,0000,0000,0000,,أحرزتُ أهدافاً أكثر بعد انضمامه للفريق
Dialogue: 0,0:19:35.71,0:19:37.88,Default,,0000,0000,0000,,!ارجع سريعاً يا ناوكي
Dialogue: 0,0:19:37.88,0:19:39.57,Default,,0000,0000,0000,,سأنتظرك على الملعب
Dialogue: 0,0:19:43.34,0:19:45.74,Default,,0000,0000,0000,,...إنّه أحمق
Dialogue: 0,0:19:45.74,0:19:47.48,Default,,0000,0000,0000,,لا يدري ما فعلت أبداً
Dialogue: 0,0:19:48.91,0:19:50.95,Default,,0000,0000,0000,,!أحمق تماماً
Dialogue: 0,0:19:51.91,0:19:54.27,Default,,0000,0000,0000,,...أعتذر على المقاطعة
Dialogue: 0,0:19:56.19,0:19:59.61,Default,,0000,0000,0000,,!لكن أين أخفيت شينتشي؟
Dialogue: 0,0:20:00.27,0:20:02.73,Default,,0000,0000,0000,,صحيح، لم نره أبداً
Dialogue: 0,0:20:03.10,0:20:04.07,Default,,0000,0000,0000,,هل نتصل به؟
Dialogue: 0,0:20:04.46,0:20:05.00,Default,,0000,0000,0000,,نتصل؟
Dialogue: 0,0:20:05.06,0:20:07.53,Default,,0000,0000,0000,,!تبّاً! الهاتف النقّال في حقيبتي
Dialogue: 0,0:20:08.14,0:20:12.72,Default,,0000,0000,0000,,...لم أكن أعرف الرقم، أعطاني إيّاه اليوم
Dialogue: 0,0:20:27.74,0:20:30.62,Default,,0000,0000,0000,,!تبّاً! لمَ لا تُفتح في هذا الوقت بالذات؟
Dialogue: 0,0:20:33.24,0:20:34.15,Default,,0000,0000,0000,,...توقّف
Dialogue: 0,0:20:34.15,0:20:35.57,Default,,0000,0000,0000,,أنتَ هنا يا شينتشي
Dialogue: 0,0:20:35.94,0:20:36.88,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:20:37.61,0:20:39.53,Default,,0000,0000,0000,,!لن تهرب هذه المرة يا شينتشي
Dialogue: 0,0:20:40.23,0:20:42.78,Default,,0000,0000,0000,,!ما أمر تلك الفتاة ريوكو؟
Dialogue: 0,0:20:43.20,0:20:45.60,Default,,0000,0000,0000,,!ماذا كنت تفعل في منزلها؟
Dialogue: 0,0:20:45.60,0:20:47.48,Default,,0000,0000,0000,,!ظننتك تعمل على قضية صعبة
Dialogue: 0,0:20:48.07,0:20:49.44,Default,,0000,0000,0000,,...كـ-كانت فقط
Dialogue: 0,0:20:49.77,0:20:51.90,Default,,0000,0000,0000,,...كاذب! كانت تبكي
Dialogue: 0,0:20:52.93,0:20:54.81,Default,,0000,0000,0000,,!تبكي عندما اتصلت بها
Dialogue: 0,0:20:55.59,0:20:58.09,Default,,0000,0000,0000,,لم أعد أعرف ما يجري
Dialogue: 0,0:20:58.09,0:21:00.01,Default,,0000,0000,0000,,أنا من تريد البكاء
Dialogue: 0,0:21:01.50,0:21:04.85,Default,,0000,0000,0000,,!اخرج وبرّر موقفك يا شينتشي
Dialogue: 0,0:21:11.50,0:21:12.24,Default,,0000,0000,0000,,شينتشي؟
Dialogue: 0,0:21:13.13,0:21:15.32,Default,,0000,0000,0000,,أصغي لي يا ران
Dialogue: 0,0:21:15.32,0:21:16.71,Default,,0000,0000,0000,,أنا بريء
Dialogue: 0,0:21:18.10,0:21:19.24,Default,,0000,0000,0000,,لذا لا تبكي
Dialogue: 0,0:21:19.84,0:21:23.13,Default,,0000,0000,0000,,!ما علاقتك؟ أبكي أو لا أمرٌ يخصني
Dialogue: 0,0:21:23.61,0:21:28.03,Default,,0000,0000,0000,,أتضايق... بكاؤك يضايقني
Dialogue: 0,0:21:29.18,0:21:30.20,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:21:30.56,0:21:32.52,Default,,0000,0000,0000,,!سأغادر إذاً
Dialogue: 0,0:21:32.52,0:21:35.44,Default,,0000,0000,0000,,!توقف! هذه ليست إجابةً يا شينتشي
Dialogue: 0,0:21:38.44,0:21:39.50,Default,,0000,0000,0000,,بروفسور آغاسا؟
Dialogue: 0,0:21:39.50,0:21:40.76,Default,,0000,0000,0000,,!ران-كن
Dialogue: 0,0:21:41.23,0:21:43.66,Default,,0000,0000,0000,,إن كنتِ تبحثين عن شينتشي، فقد هرب\Nمن هناك وخدّاه محمران
Dialogue: 0,0:21:44.21,0:21:46.08,Default,,0000,0000,0000,,محمران؟
Dialogue: 0,0:21:46.62,0:21:48.61,Default,,0000,0000,0000,,بكاؤك يضايقني
Dialogue: 0,0:21:49.45,0:21:51.57,Default,,0000,0000,0000,,!ما خطبه؟
Dialogue: 0,0:21:53.13,0:21:54.70,Default,,0000,0000,0000,,قلتَ الكثير يا بروفيسور
Dialogue: 0,0:21:55.23,0:21:57.08,Default,,0000,0000,0000,,لا يحقّ لك الكلام أيّها الجبان الصغير
Dialogue: 0,0:21:57.56,0:21:58.31,Default,,0000,0000,0000,,!اخرس
Dialogue: 0,0:23:32.57,0:23:34.02,Default,,0000,0000,0000,,!صدقاً صدقاً؟
Dialogue: 0,0:23:34.48,0:23:36.98,Default,,0000,0000,0000,,!أجل! صدقاً صدقاً
Dialogue: 0,0:23:38.23,0:23:38.98,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:23:43.23,0:23:46.15,Default,,0000,0000,0000,,لم تتدخل الشرطة في القضية الأخيرة
Dialogue: 0,0:23:47.01,0:23:50.05,Default,,0000,0000,0000,,...لكن ران جعلت ريوكو تشرح مراراً وتكراراً
Dialogue: 0,0:23:50.05,0:23:55.24,Default,,0000,0000,0000,,واستغرق اقتناعها أنّي بريء أخيراً 3 أيّام

