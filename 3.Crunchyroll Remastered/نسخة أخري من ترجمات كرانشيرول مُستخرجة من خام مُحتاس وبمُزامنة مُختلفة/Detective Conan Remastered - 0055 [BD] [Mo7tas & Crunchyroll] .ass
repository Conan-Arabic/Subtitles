Dialogue: 0,0:00:02.11,0:00:05.07,Default,,0000,0000,0000,,،طالما جرائم العصر الحديث تتضمّن بشراً
Dialogue: 0,0:00:05.07,0:00:06.95,Default,,0000,0000,0000,,!لا توجد ألغاز لا تُحلّ
Dialogue: 0,0:00:06.95,0:00:08.77,Default,,0000,0000,0000,,!قضيّة اليوم عن حيلة قطار
Dialogue: 0,0:00:08.77,0:00:10.82,Default,,0000,0000,0000,,!الجداول هي أساس الاستنتاج
Dialogue: 0,0:00:10.82,0:00:12.60,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.60,0:00:14.94,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.94,0:00:16.51,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.33,0:01:57.18,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل حيلة القطار
Dialogue: 0,0:01:52.09,0:01:54.84,Default,,0000,0000,0000,,جريمة قتل حيلة القطار
Dialogue: 0,0:01:57.18,0:02:00.72,CharCard,,0000,0000,0007,,{\fad(0,200)}يونو ياما\Nبلدة ينابيع ساخنة جبلية
Dialogue: 0,0:02:02.50,0:02:04.13,On Top,,0000,0000,0000,,محطّة يونو ياما
Dialogue: 0,0:02:04.13,0:02:06.14,Default,,0000,0000,0000,,!أبي! أسرع
Dialogue: 0,0:02:06.14,0:02:09.56,Default,,0000,0000,0000,,أين سنذهب؟ ألن نصعد هذا؟
Dialogue: 0,0:02:09.92,0:02:12.62,Default,,0000,0000,0000,,كلا، هذا خطّ هانانو ماتشي
Dialogue: 0,0:02:12.62,0:02:16.01,Default,,0000,0000,0000,,سنصعد الذي في الأعلى، خطّ يونو ياما
Dialogue: 0,0:02:16.57,0:02:19.37,Default,,0000,0000,0000,,لا يهم أيّهما نصعد
Dialogue: 0,0:02:19.37,0:02:21.44,Default,,0000,0000,0000,,فكلاهما متّصلان بخط يقود لطوكيو
Dialogue: 0,0:02:21.44,0:02:22.72,Default,,0000,0000,0000,,في محطّة هانانو ماتشي بأيّ حال
Dialogue: 0,0:02:23.36,0:02:25.26,Default,,0000,0000,0000,,!سيفوتنا القطار إذا لم نسرع
Dialogue: 0,0:02:26.06,0:02:29.11,Default,,0000,0000,0000,,...يوجعني رأسي من تأثير الشراب
Dialogue: 0,0:02:29.11,0:02:31.59,Default,,0000,0000,0000,,!لا تصرخي بهذا الصوت المرتفع
Dialogue: 0,0:02:35.97,0:02:38.51,Default,,0000,0000,0000,,يا إلهي، لا أريد القدوم هنا مُجدداً
Dialogue: 0,0:02:50.92,0:02:52.33,Default,,0000,0000,0000,,كان ذلك مُسلياً
Dialogue: 0,0:02:52.33,0:02:55.45,Default,,0000,0000,0000,,كان الطعام والنُزل والينبوع الساخن\Nأروع ما يمكن
Dialogue: 0,0:02:55.45,0:02:56.80,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:02:56.80,0:02:57.51,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:58.45,0:02:59.74,Default,,0000,0000,0000,,شكراً لك يا أبي
Dialogue: 0,0:03:01.73,0:03:04.44,Default,,0000,0000,0000,,دعاك أحد عملائك لهذه الرحلة
Dialogue: 0,0:03:04.44,0:03:08.07,Default,,0000,0000,0000,,كمكافأة على حلّك لقضيّته، صحيح؟
Dialogue: 0,0:03:08.07,0:03:09.43,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:09.43,0:03:13.63,Default,,0000,0000,0000,,رغم أنّي من حلّ القضية وليس هو
Dialogue: 0,0:03:13.63,0:03:17.18,Default,,0000,0000,0000,,سأنام لساعة حتّى نصل هانانو ماتشي
Dialogue: 0,0:03:17.18,0:03:18.31,Default,,0000,0000,0000,,!أحمق
Dialogue: 0,0:03:20.18,0:03:22.05,Default,,0000,0000,0000,,!ما مشكلتك يا ساتو؟
Dialogue: 0,0:03:22.34,0:03:25.75,CharCard,,0000,0000,15,,{\fad(300,0)}الطبيب ساتو تايزو
Dialogue: 0,0:03:22.34,0:03:26.55,On Top,,0000,0000,0000,,ما-ما الخطب؟ ليس عليك أن تغضب هكذا
Dialogue: 0,0:03:26.85,0:03:28.50,On Top,,0000,0000,0000,,!أنت تثير اشمئزازي
Dialogue: 0,0:03:26.85,0:03:30.10,CharCard,,0000,0000,15,,{\fad(300,0)}الطبيب داتي تاكاشي
Dialogue: 0,0:03:28.50,0:03:30.97,On Top,,0000,0000,0000,,!لم أعد أستطيع الجلوس معك
Dialogue: 0,0:03:31.83,0:03:33.22,Default,,0000,0000,0000,,سأذهب لعربة مختلفة
Dialogue: 0,0:03:32.50,0:03:33.22,Default,,0000,0000,0000,,!داتي
Dialogue: 0,0:03:37.49,0:03:39.16,Default,,0000,0000,0000,,...أليسا
Dialogue: 0,0:03:39.16,0:03:42.78,Default,,0000,0000,0000,,بلى، مكثا في نفس النُزل معنا البارحة
Dialogue: 0,0:03:46.76,0:03:47.82,On Top,,0000,0000,0000,,رابطة كانيتسو الطبيّة
Dialogue: 0,0:03:53.02,0:03:53.92,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:03:55.18,0:03:57.61,Default,,0000,0000,0000,,...مجموعة الأطبّاء أولئك
Dialogue: 0,0:03:58.85,0:03:59.64,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:03:59.64,0:04:02.80,Default,,0000,0000,0000,,...أنتم من البارحة
Dialogue: 0,0:04:02.80,0:04:04.71,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:04:04.71,0:04:06.84,Default,,0000,0000,0000,,كلا، إنّه متضايق فحسب
Dialogue: 0,0:04:07.84,0:04:08.93,Default,,0000,0000,0000,,أين بقيّة الأطباء؟
Dialogue: 0,0:04:09.59,0:04:11.16,Default,,0000,0000,0000,,غادرنا منفصلين
Dialogue: 0,0:04:11.16,0:04:13.00,Default,,0000,0000,0000,,استقلّ بعضنا خطّ هانانو ماتشي
Dialogue: 0,0:04:13.00,0:04:15.33,Default,,0000,0000,0000,,بينما البعض الآخر خطّ يونو ياما مثلنا
Dialogue: 0,0:04:15.33,0:04:18.55,Default,,0000,0000,0000,,كلاهما يلتقيان في محطّة هانانو ماتشي بأيّ حال
Dialogue: 0,0:04:18.87,0:04:21.46,Default,,0000,0000,0000,,إذاً، عمتم مساءً
Dialogue: 0,0:04:32.18,0:04:35.73,Default,,0000,0000,0000,,!ميزونو كاوا! ميزونو كاوا
Dialogue: 0,0:04:38.98,0:04:41.05,Default,,0000,0000,0000,,ماذا؟ محطّة ميزونو كاوا؟
Dialogue: 0,0:04:41.63,0:04:43.51,Default,,0000,0000,0000,,مكتوبٌ أنّه يمكننا التبديل
Dialogue: 0,0:04:44.26,0:04:47.93,Default,,0000,0000,0000,,ربما علينا التبديل إلى خطّ هانانو ماتشي هنا؟
Dialogue: 0,0:04:47.93,0:04:50.13,Default,,0000,0000,0000,,كلا، للأسف
Dialogue: 0,0:04:50.13,0:04:53.29,Default,,0000,0000,0000,,وصل قطار هانانو ماتشي هنا\Nعند تمام العاشرة والنصف
Dialogue: 0,0:04:53.29,0:04:56.34,Default,,0000,0000,0000,,أي قبل 5 دقائق، غادر سلفاً
Dialogue: 0,0:05:10.28,0:05:13.72,Default,,0000,0000,0000,,أعتذر على الإزعاج، التذاكر من فضلكم
Dialogue: 0,0:05:13.72,0:05:15.17,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:05:16.19,0:05:17.51,Default,,0000,0000,0000,,شكراً يا فتى
Dialogue: 0,0:05:20.92,0:05:22.51,On Top,,0000,0000,0000,,محطّة ميزونو كاوا
Dialogue: 0,0:05:22.51,0:05:27.34,On Top,,0000,0000,0000,,خطّ يونو ياما\Nخطّ هانانو ماتشي
Dialogue: 0,0:05:27.97,0:05:29.47,On Top,,0000,0000,0000,,محطّة هانانو ماتشي
Dialogue: 0,0:05:29.80,0:05:33.46,Default,,0000,0000,0000,,شكراً لكم لاستعمالكم\Nخطّ يونو ياما اليوم
Dialogue: 0,0:05:33.46,0:05:36.46,Default,,0000,0000,0000,,هذه محطّتنا الأخيرة، هانانو ماتشي
Dialogue: 0,0:05:36.46,0:05:40.43,Default,,0000,0000,0000,,احرصوا رجاءً على ألّا تنسوا\Nأي ممتلكات على القطار
Dialogue: 0,0:05:40.43,0:05:41.94,Default,,0000,0000,0000,,الركّاب المنتقلون للقطار إلى طوكيو
Dialogue: 0,0:05:41.94,0:05:43.61,Default,,0000,0000,0000,,عليهم التبديل للرصيف 7
Dialogue: 0,0:05:43.61,0:05:46.28,Default,,0000,0000,0000,,سيغادر القطار التالي عند 11:40
Dialogue: 0,0:05:49.78,0:05:52.59,Default,,0000,0000,0000,,خمس وثلاثون دقيقة من الانتظار
Dialogue: 0,0:05:52.90,0:05:54.78,Default,,0000,0000,0000,,!ساتو-كن
Dialogue: 0,0:05:56.40,0:05:57.73,Default,,0000,0000,0000,,آسفٌ عمّا سبق
Dialogue: 0,0:05:57.73,0:06:01.76,Default,,0000,0000,0000,,شعرتُ بالسكينة بعد نظري لمشاهد الطبيعة من العربة الأخيرة
Dialogue: 0,0:06:02.05,0:06:04.48,Default,,0000,0000,0000,,توقعتُ ذلك
Dialogue: 0,0:06:04.48,0:06:05.22,Default,,0000,0000,0000,,اعذرني
Dialogue: 0,0:06:07.39,0:06:09.01,Default,,0000,0000,0000,,يبدو أنّهما تصالحا
Dialogue: 0,0:06:09.01,0:06:09.68,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:11.38,0:06:11.96,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:06:11.96,0:06:13.00,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:06:13.00,0:06:13.91,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:06:19.92,0:06:23.55,Default,,0000,0000,0000,,لديه الكثير من الفكّة بالفعل
Dialogue: 0,0:06:24.41,0:06:26.13,Default,,0000,0000,0000,,سرّنا لقاؤكم
Dialogue: 0,0:06:26.13,0:06:28.26,Default,,0000,0000,0000,,!نحن كذلك
Dialogue: 0,0:06:30.24,0:06:32.46,Default,,0000,0000,0000,,!انتبه يا عمّ، يكاد زرّك أن يسقط
Dialogue: 0,0:06:36.04,0:06:37.01,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:06:40.06,0:06:42.60,Default,,0000,0000,0000,,...مسحه؟ يا للغرابة
Dialogue: 0,0:06:44.30,0:06:46.26,Default,,0000,0000,0000,,أين وجدتم الجثّة؟
Dialogue: 0,0:06:46.76,0:06:49.18,Default,,0000,0000,0000,,في قطار هانانو ماتشي الذي وصل \N!قبل خمس دقائق
Dialogue: 0,0:06:49.18,0:06:51.55,Default,,0000,0000,0000,,!يبدو أنّ الضحيّة طبيب
Dialogue: 0,0:06:51.79,0:06:55.17,Default,,0000,0000,0000,,أ-أيمكن أنّه أحد الأطباء من مجموعتنا؟
Dialogue: 0,0:06:55.17,0:06:57.09,Default,,0000,0000,0000,,غادر الجميع بمفردهم
Dialogue: 0,0:06:57.09,0:06:59.34,Default,,0000,0000,0000,,ربما صعد أحدهم خطّ هانانو ماتشي
Dialogue: 0,0:06:59.34,0:07:00.07,Default,,0000,0000,0000,,!لنذهب ونرَ
Dialogue: 0,0:07:00.07,0:07:00.70,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:07:03.74,0:07:05.59,Default,,0000,0000,0000,,حسنٌ، سأذهب أيضاً
Dialogue: 0,0:07:05.87,0:07:07.75,Default,,0000,0000,0000,,ماذا عن أثر الشراب يا أبي؟
Dialogue: 0,0:07:07.75,0:07:09.05,Default,,0000,0000,0000,,زال منذ فترة
Dialogue: 0,0:07:09.66,0:07:12.19,Default,,0000,0000,0000,,لا يمكنني البقاء ساكناً\Nبعدما عرفت وجود جثّة
Dialogue: 0,0:07:12.19,0:07:15.13,Default,,0000,0000,0000,,!حماس المتحرّي العظيم موري كوغورو يشتعل
Dialogue: 0,0:07:28.39,0:07:30.10,Default,,0000,0000,0000,,!إنّه أوتسومي-كن
Dialogue: 0,0:07:30.92,0:07:33.06,Default,,0000,0000,0000,,أي في رابطتكم إذاً؟
Dialogue: 0,0:07:33.96,0:07:37.34,Default,,0000,0000,0000,,إنّه أوتسومي-كن، كان معنا البارحة
Dialogue: 0,0:07:39.63,0:07:41.67,Default,,0000,0000,0000,,ما خطب هذه النظرة؟
Dialogue: 0,0:07:45.12,0:07:49.14,Default,,0000,0000,0000,,أنا ضابط السكّة الحديدية المشرف، كوباياشي يوسكي
Dialogue: 0,0:07:49.83,0:07:52.65,Default,,0000,0000,0000,,يشرّفني لقاؤك أيّها المتحرّي موري
Dialogue: 0,0:07:52.65,0:07:54.63,Default,,0000,0000,0000,,!نقدّر تعاونك في التحقيق كثيراً
Dialogue: 0,0:07:54.63,0:07:57.64,Default,,0000,0000,0000,,لا مشكلة، تسرّني المساعدة
Dialogue: 0,0:08:02.81,0:08:04.51,Default,,0000,0000,0000,,ما كان سبب الوفاة إذاً؟
Dialogue: 0,0:08:05.22,0:08:07.27,Default,,0000,0000,0000,,لا نستطيع الجزم قبل التشريح
Dialogue: 0,0:08:07.27,0:08:09.18,Default,,0000,0000,0000,,لكنّها كانت سكتة قلبية غالباً
Dialogue: 0,0:08:09.18,0:08:12.34,Default,,0000,0000,0000,,في تلك الحالة فلا داعي لي هنا
Dialogue: 0,0:08:12.34,0:08:15.59,Default,,0000,0000,0000,,أليست تلك علامة مِحقنة؟
Dialogue: 0,0:08:15.59,0:08:18.76,Default,,0000,0000,0000,,أنت ابق صامتاً! لحظة، مِحقنة؟
Dialogue: 0,0:08:18.76,0:08:21.13,Default,,0000,0000,0000,,انظر لوريد ذراعه
Dialogue: 0,0:08:21.13,0:08:24.45,Default,,0000,0000,0000,,يوجد أثر إبرة بدم
Dialogue: 0,0:08:24.45,0:08:25.98,Default,,0000,0000,0000,,أثر إبرة تحت الجلد؟
Dialogue: 0,0:08:27.95,0:08:28.76,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:08:28.76,0:08:32.86,Default,,0000,0000,0000,,عندما تُحقن بجرعة كبيرة من كلوريد البوتاسيوم في الوريد
Dialogue: 0,0:08:32.86,0:08:36.40,Default,,0000,0000,0000,,يمكن أن تموت من أعراض تشبه السكتة القلبية
Dialogue: 0,0:08:36.40,0:08:36.97,Default,,0000,0000,0000,,!اصمت
Dialogue: 0,0:08:37.94,0:08:41.30,Default,,0000,0000,0000,,يوجد في المستشفيات كلوريد بوتاسيوم ومحاقن، صحيح؟
Dialogue: 0,0:08:42.73,0:08:45.43,Default,,0000,0000,0000,,أدهشتني، تعرف الكثير يا ولد
Dialogue: 0,0:08:46.27,0:08:49.10,Default,,0000,0000,0000,,!أنا أحبّ العلم
Dialogue: 0,0:08:49.10,0:08:50.78,Default,,0000,0000,0000,,...كان ذلك وشيكاً
Dialogue: 0,0:08:52.05,0:08:55.07,Default,,0000,0000,0000,,...لكن لا أرى محاقن بقربه
Dialogue: 0,0:08:55.88,0:08:56.51,Default,,0000,0000,0000,,...ما يعني
Dialogue: 0,0:08:57.14,0:08:59.27,Default,,0000,0000,0000,,!لم تكن حادثة أو انتحاراً
Dialogue: 0,0:08:59.27,0:09:01.76,Default,,0000,0000,0000,,!بل جريمة! جريمة قتل
Dialogue: 0,0:09:01.76,0:09:02.51,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:09:03.01,0:09:05.30,Default,,0000,0000,0000,,!إنّك عقبة! اخرج
Dialogue: 0,0:09:05.30,0:09:05.85,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:09:05.85,0:09:08.96,Default,,0000,0000,0000,,إذاً، المشكلة هي الدافع
Dialogue: 0,0:09:08.96,0:09:10.31,Default,,0000,0000,0000,,كانت مجرّد سرقة
Dialogue: 0,0:09:11.20,0:09:13.27,Default,,0000,0000,0000,,لم يبق حتّى ينّ واحد في محفظته
Dialogue: 0,0:09:14.16,0:09:16.23,Default,,0000,0000,0000,,لكن حتّى أصابعه مكسورة؟
Dialogue: 0,0:09:16.54,0:09:18.83,Default,,0000,0000,0000,,!كان القاتل مفتول العضلات
Dialogue: 0,0:09:18.83,0:09:20.90,Default,,0000,0000,0000,,أمسكه بشدّة بحيث كسر أصابعه
Dialogue: 0,0:09:20.90,0:09:24.52,Default,,0000,0000,0000,,!ومنعه من المقاومة ثم أقدم على الجريمة
Dialogue: 0,0:09:25.53,0:09:27.53,Default,,0000,0000,0000,,لمَ قد يعطيه حقنة إذا أمكنه
Dialogue: 0,0:09:27.53,0:09:28.73,Default,,0000,0000,0000,,قتله هكذا إذاً؟
Dialogue: 0,0:09:29.61,0:09:32.39,Default,,0000,0000,0000,,خطّ هانانو ماتشي موازٍ لخطّ يونو ياما
Dialogue: 0,0:09:32.39,0:09:33.60,Default,,0000,0000,0000,,الذي سلكناه
Dialogue: 0,0:09:34.90,0:09:36.56,Default,,0000,0000,0000,,محطّتا يونو ياما وميزونو كاوا
Dialogue: 0,0:09:36.56,0:09:38.56,Default,,0000,0000,0000,,هما نقطتا التقائهما الوحيدتان
Dialogue: 0,0:09:38.56,0:09:40.63,Default,,0000,0000,0000,,القطار الذي وقعت فيه هذه القضيّة
Dialogue: 0,0:09:40.63,0:09:44.80,Default,,0000,0000,0000,,توقّف عند محطّة ميزونو كاوا\Nعند العاشرة والنصف
Dialogue: 0,0:09:44.80,0:09:47.06,Default,,0000,0000,0000,,...السؤال هو وفت الجريمة
Dialogue: 0,0:09:47.06,0:09:52.10,Default,,0000,0000,0000,,اشترى الضحيّة قهوة معلّبة\Nعند 10:50 إذاً؟
Dialogue: 0,0:09:52.10,0:09:53.21,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:53.21,0:09:55.54,Default,,0000,0000,0000,,كدنا نصل هانانو ماتشي
Dialogue: 0,0:09:55.54,0:09:58.27,Default,,0000,0000,0000,,وكان آخر زبون لي
Dialogue: 0,0:09:58.27,0:10:00.44,Default,,0000,0000,0000,,لم أملك عملة ألف ينّ لردّ الباقي
Dialogue: 0,0:10:00.44,0:10:03.96,Default,,0000,0000,0000,,فأعطيته فكّةً مكان ذلك، لذا أتذكره
Dialogue: 0,0:10:06.32,0:10:08.45,Default,,0000,0000,0000,,أكان يجلس بمفرده وقتها؟
Dialogue: 0,0:10:09.65,0:10:10.56,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:11.44,0:10:12.77,Default,,0000,0000,0000,,وبعدها مباشرةً
Dialogue: 0,0:10:12.77,0:10:17.31,Default,,0000,0000,0000,,جلس رجل بشارب يرتدي معطفاً أزرق داكناً\Nونظّارات شمسية بجوار الضحيّة
Dialogue: 0,0:10:17.31,0:10:19.77,Default,,0000,0000,0000,,فنهضتِ وغادرتِ
Dialogue: 0,0:10:20.76,0:10:21.64,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:22.30,0:10:23.89,Default,,0000,0000,0000,,معطف أزرق داكن؟
Dialogue: 0,0:10:24.97,0:10:28.81,Default,,0000,0000,0000,,أي وقعت الجريمة بين 10:50\Nإلى 10:52 أو 10:53
Dialogue: 0,0:10:31.79,0:10:34.31,Default,,0000,0000,0000,,!معطف الطبيب داتي ذاك بوجهين
Dialogue: 0,0:10:34.92,0:10:35.98,Default,,0000,0000,0000,,!الجانب الآخر أزرق داكن
Dialogue: 0,0:10:39.12,0:10:41.07,Default,,0000,0000,0000,,ربما كان زرّه على وشك السقوط
Dialogue: 0,0:10:41.07,0:10:43.35,Default,,0000,0000,0000,,لأنّ الضحيّة أمسك به؟
Dialogue: 0,0:10:43.57,0:10:46.69,Default,,0000,0000,0000,,!كسر أصابعه وهو يحاول نزعه
Dialogue: 0,0:10:47.41,0:10:49.11,Default,,0000,0000,0000,,...لذا عندها
Dialogue: 0,0:10:49.11,0:10:50.19,Default,,0000,0000,0000,,!لا شكّ في الأمر
Dialogue: 0,0:10:51.31,0:10:53.31,Default,,0000,0000,0000,,مسح مقدّمة زرّه
Dialogue: 0,0:10:53.31,0:10:55.05,Default,,0000,0000,0000,,!لإزالة بصمات أصابع الضحيّة
Dialogue: 0,0:10:55.98,0:10:58.65,Default,,0000,0000,0000,,كما مات الضحيّة من حقنة كلوريد البوتاسيوم
Dialogue: 0,0:10:58.65,0:11:01.64,Default,,0000,0000,0000,,التي يصعب على غير الطبيب توفيرها
Dialogue: 0,0:11:01.64,0:11:04.56,Default,,0000,0000,0000,,!بالإضافة لردّة فعله عندما سمع اسم العمّ
Dialogue: 0,0:11:05.30,0:11:08.14,Default,,0000,0000,0000,,!الطبيب داتي كان هو القاتل على الأرجح
Dialogue: 0,0:11:08.14,0:11:13.60,Default,,0000,0000,0000,,لكن كيف استطاع قتل\Nشخص على متن قطار آخر؟
Dialogue: 0,0:11:17.54,0:11:20.21,Default,,0000,0000,0000,,ألن تكمل عملك؟
Dialogue: 0,0:11:20.21,0:11:21.49,Default,,0000,0000,0000,,بالطبع لا
Dialogue: 0,0:11:21.49,0:11:23.20,Default,,0000,0000,0000,,فقد بدؤوا بالبحث عن السارق
Dialogue: 0,0:11:23.20,0:11:25.68,Default,,0000,0000,0000,,انتهى عملي كمتحرٍّ
Dialogue: 0,0:11:26.12,0:11:28.52,Default,,0000,0000,0000,,لكن أكانت سرقة حقّاً؟
Dialogue: 0,0:11:29.53,0:11:31.22,Default,,0000,0000,0000,,ما قصدك يا كونان-كن؟
Dialogue: 0,0:11:31.22,0:11:37.19,Default,,0000,0000,0000,,بدت الشاهدة أكثر ثراءً من الضحيّة بكثير
Dialogue: 0,0:11:37.19,0:11:39.36,Default,,0000,0000,0000,,وكانت تجلس بالقرب، صحيح؟
Dialogue: 0,0:11:39.36,0:11:44.39,Default,,0000,0000,0000,,فلمَ استهدف القاتل الرجل وليس المرأة؟
Dialogue: 0,0:11:44.39,0:11:47.30,Default,,0000,0000,0000,,...معك حقّ
Dialogue: 0,0:11:47.30,0:11:49.35,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:11:49.35,0:11:52.31,Default,,0000,0000,0000,,أيضاً، لمَ يتعرق ذاك الرجل \Nبشدّة برأيكم؟
Dialogue: 0,0:11:54.17,0:11:55.35,Default,,0000,0000,0000,,طبيب ساتو
Dialogue: 0,0:11:56.09,0:11:59.04,Default,,0000,0000,0000,,أيمكن أنّك على علم بشيء؟
Dialogue: 0,0:11:59.04,0:12:01.31,Default,,0000,0000,0000,,...ماذا؟ ليس حقاً
Dialogue: 0,0:12:02.20,0:12:04.83,Default,,0000,0000,0000,,لا أمانع، أخبره يا ساتو
Dialogue: 0,0:12:04.83,0:12:10.27,Default,,0000,0000,0000,,أخبره أنّي تشاجرتُ مع أوتسومي\Nبشدّة البارحة في النُزل
Dialogue: 0,0:12:11.22,0:12:13.69,Default,,0000,0000,0000,,تشاجرت؟ مع الضحيّة؟
Dialogue: 0,0:12:13.69,0:12:15.27,Default,,0000,0000,0000,,أهذا صحيح؟
Dialogue: 0,0:12:15.73,0:12:17.23,Default,,0000,0000,0000,,أجل، كان شجاراً كبيراً
Dialogue: 0,0:12:17.52,0:12:19.23,Default,,0000,0000,0000,,ما سببه؟
Dialogue: 0,0:12:19.98,0:12:21.68,Default,,0000,0000,0000,,اتّهام عديم الأساس
Dialogue: 0,0:12:22.68,0:12:26.60,Default,,0000,0000,0000,,أنّي كنت أتلقى رشاوي من شركة أدوية
Dialogue: 0,0:12:27.14,0:12:30.11,Default,,0000,0000,0000,,أنا بريء بالكامل طبعاً
Dialogue: 0,0:12:31.13,0:12:34.06,Default,,0000,0000,0000,,يا إلهي، أتعتقدون أنّني قتلته؟
Dialogue: 0,0:12:34.06,0:12:36.09,Default,,0000,0000,0000,,كلا، البتّة
Dialogue: 0,0:12:36.09,0:12:39.30,Default,,0000,0000,0000,,من الواضح أنّك والضحيّة كنتما\Nعلى متن قطارين مختلفين
Dialogue: 0,0:12:39.30,0:12:43.22,Default,,0000,0000,0000,,وفق ما قاله موري-سان والبقية
Dialogue: 0,0:12:43.22,0:12:46.18,Default,,0000,0000,0000,,صحيح، للطبيب داتي حجّة غياب
Dialogue: 0,0:12:49.45,0:12:51.98,Default,,0000,0000,0000,,أخبرني، لمَ صعدتما خطّ يونو ياما
Dialogue: 0,0:12:51.98,0:12:53.94,Default,,0000,0000,0000,,بدل خطّ هانانو ماتشي؟
Dialogue: 0,0:12:53.94,0:12:56.57,Default,,0000,0000,0000,,كان يمكنني صعود أيّهما
Dialogue: 0,0:12:56.57,0:12:58.85,Default,,0000,0000,0000,,لكنّ الطبيب داتي من اشترى لي التذكرة
Dialogue: 0,0:12:59.36,0:13:00.80,Default,,0000,0000,0000,,ما كان ذاك الشجار قبلاً إذاً؟
Dialogue: 0,0:13:01.60,0:13:04.14,Default,,0000,0000,0000,,حاولتُ دفع قيمة التذكرة
Dialogue: 0,0:13:04.14,0:13:06.35,Default,,0000,0000,0000,,لكنّه رفض قبول مالي
Dialogue: 0,0:13:07.02,0:13:10.15,Default,,0000,0000,0000,,غضب فجأةً عندما أصررت على أن يأخذه
Dialogue: 0,0:13:10.84,0:13:12.76,Default,,0000,0000,0000,,لم أعرف ما أفعل وقتها
Dialogue: 0,0:13:13.13,0:13:15.55,Default,,0000,0000,0000,,كان الطبيب داتي من اقترح سلك\Nخطّ يونو ياما إذاً
Dialogue: 0,0:13:15.55,0:13:20.68,Default,,0000,0000,0000,,ثمّ تظاهر بالجدال للذهاب للعربة الخلفية
Dialogue: 0,0:13:21.50,0:13:23.75,Default,,0000,0000,0000,,ران-نيتشان، أيمكنك أن تريني جدول القطار؟
Dialogue: 0,0:13:23.75,0:13:26.08,Default,,0000,0000,0000,,جدول القطار؟ لا بأس
Dialogue: 0,0:13:26.62,0:13:27.25,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:13:27.25,0:13:28.69,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:13:29.66,0:13:34.64,Default,,0000,0000,0000,,...إذا انتقل من خطّ هانانو ماتشي آنذاك
Dialogue: 0,0:13:35.36,0:13:38.11,Default,,0000,0000,0000,,!فمحطّة ميزونو كاوا هي المكان الوحيد لفعل ذلك
Dialogue: 0,0:13:39.78,0:13:42.60,Default,,0000,0000,0000,,لكنّ قطار هاناو ماتشي الذي كان يستقلّه الضحيّة
Dialogue: 0,0:13:42.60,0:13:45.63,Default,,0000,0000,0000,,وصل لمحطّة ميزونو كاوا عند العاشرة والنصف
Dialogue: 0,0:13:46.93,0:13:51.76,Default,,0000,0000,0000,,ووصل قطار يونو ياما الذي كنّا عليه بعد 5 دقائق
Dialogue: 0,0:13:51.76,0:13:54.22,Default,,0000,0000,0000,,كان قطار هانانو ماتشي قد غادر وقتها
Dialogue: 0,0:13:54.22,0:13:56.52,Default,,0000,0000,0000,,ربما لم يستطع ارتكاب الجريمة حقّاً؟
Dialogue: 0,0:13:56.52,0:13:58.44,Default,,0000,0000,0000,,...لحظة، ألم يكن مكتوباً هناك
Dialogue: 0,0:13:59.55,0:14:01.41,Default,,0000,0000,0000,,خطّ يونو ياما هو الخطّ 1
Dialogue: 0,0:14:01.41,0:14:03.39,Default,,0000,0000,0000,,وخطّ هانانو ماتشي هو الخطّ 6
Dialogue: 0,0:14:03.87,0:14:07.97,Default,,0000,0000,0000,,يربط معبر علويّ بين الرصيف 3 والرصيف 4
Dialogue: 0,0:14:09.37,0:14:11.70,Default,,0000,0000,0000,,الأدراج بجوار العربة الخلفية
Dialogue: 0,0:14:11.70,0:14:14.58,Default,,0000,0000,0000,,!والتي كان فيها الطبيب داتي بمفرده
Dialogue: 0,0:14:16.74,0:14:19.90,Default,,0000,0000,0000,,أجل، يبدو أنّني سأتأخر أكثر
Dialogue: 0,0:14:19.90,0:14:21.94,Default,,0000,0000,0000,,هلّا أغلقت المكتب لليوم؟
Dialogue: 0,0:14:21.94,0:14:24.02,Default,,0000,0000,0000,,جيّد، شكراً
Dialogue: 0,0:14:24.48,0:14:26.52,Default,,0000,0000,0000,,هاتف؟
Dialogue: 0,0:14:26.52,0:14:27.48,Default,,0000,0000,0000,,!هاتف خلويّ
Dialogue: 0,0:14:27.89,0:14:32.26,Default,,0000,0000,0000,,كلا! نسيتُ هديّة سونوكو\N!التي طلبتها مني في القطار
Dialogue: 0,0:14:33.01,0:14:34.88,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:14:35.43,0:14:38.09,Default,,0000,0000,0000,,فهمت الحيلة التي استعملها\N!الطبيب داتي لتبديل القطار
Dialogue: 0,0:14:45.67,0:14:48.54,Default,,0000,0000,0000,,لمَ أنا؟
Dialogue: 0,0:14:48.54,0:14:50.72,Default,,0000,0000,0000,,إذا نسيت شيئاً فاسأل ران
Dialogue: 0,0:14:51.53,0:14:55.49,Default,,0000,0000,0000,,كلا، أريدك أن تبحث عن القاتل
Dialogue: 0,0:14:59.66,0:15:02.01,Default,,0000,0000,0000,,ماذا؟ أهو أثر الشراب مُجدداً؟
Dialogue: 0,0:15:06.52,0:15:08.15,Default,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:15:08.44,0:15:10.39,Default,,0000,0000,0000,,أنا موري كوغورو
Dialogue: 0,0:15:10.39,0:15:14.51,Default,,0000,0000,0000,,هلّا اجتمع ذوو العلاقة بالقضيّة\Nفي غرفة العاملين رجاءً؟
Dialogue: 0,0:15:14.51,0:15:15.56,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:15:16.22,0:15:20.18,Default,,0000,0000,0000,,اكتشفتُ المجرم الحقيقي\Nالمسؤول عن هذه الجريمة
Dialogue: 0,0:15:20.18,0:15:23.77,Default,,0000,0000,0000,,فليأت الطبيبان داتي وساتو أيضاً من فضلكم
Dialogue: 0,0:15:24.29,0:15:25.84,Default,,0000,0000,0000,,المجرم الحقيقي؟
Dialogue: 0,0:15:25.84,0:15:27.60,Default,,0000,0000,0000,,لم تكن سرقة؟
Dialogue: 0,0:15:31.12,0:15:33.49,Default,,0000,0000,0000,,نحن مشغولون
Dialogue: 0,0:15:33.49,0:15:35.39,Default,,0000,0000,0000,,ما الذي يجري يا موري-سان؟
Dialogue: 0,0:15:35.66,0:15:40.35,Default,,0000,0000,0000,,لا تقلقوا، ستُكشف الحقيقة بالكامل\Nفي غضون 15 دقيقة فحسب
Dialogue: 0,0:15:40.81,0:15:43.77,Default,,0000,0000,0000,,تقصد أنّك ستحدد القاتل وتعتقله
Dialogue: 0,0:15:43.77,0:15:45.31,Default,,0000,0000,0000,,في الربع ساعة هذه؟
Dialogue: 0,0:15:45.31,0:15:47.31,Default,,0000,0000,0000,,تماماً يا طبيب داتي
Dialogue: 0,0:15:50.55,0:15:52.85,Default,,0000,0000,0000,,أي أنّك ستحاول اعتقالي
Dialogue: 0,0:15:52.85,0:15:55.30,Default,,0000,0000,0000,,أجل، فالمجرم الحقيقيّ وراء هذا القضيّة
Dialogue: 0,0:15:55.30,0:15:57.81,Default,,0000,0000,0000,,!هو أنت يا طبيب داتي
Dialogue: 0,0:15:57.81,0:15:58.97,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:58.97,0:16:00.11,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:16:00.11,0:16:01.50,Default,,0000,0000,0000,,لكن يا أبي
Dialogue: 0,0:16:01.50,0:16:04.93,Default,,0000,0000,0000,,كان الطبيب داتي على قطار\N!يونو ياما مثلنا
Dialogue: 0,0:16:04.93,0:16:09.38,Default,,0000,0000,0000,,يمكننا تأكيد ذلك لأوّل 5 دقائق\Nبعد مغادرة القطار فحسب
Dialogue: 0,0:16:09.38,0:16:12.60,Default,,0000,0000,0000,,لم نره مُجدداً حتّى وصلنا\Nلمحطّة هانانو ماتشي
Dialogue: 0,0:16:13.74,0:16:15.62,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:16:15.62,0:16:17.06,Default,,0000,0000,0000,,أيمكن أنّه بدّل القطار؟
Dialogue: 0,0:16:17.06,0:16:19.52,Default,,0000,0000,0000,,أجل، في محطّة ميزونو كاوا
Dialogue: 0,0:16:19.52,0:16:21.36,Default,,0000,0000,0000,,ميزونو كاوا؟
Dialogue: 0,0:16:21.36,0:16:23.72,Default,,0000,0000,0000,,لكن أليس ذلك مستحيلاً من ناحية الوقت؟
Dialogue: 0,0:16:24.57,0:16:25.68,Default,,0000,0000,0000,,أمعن النظر
Dialogue: 0,0:16:26.19,0:16:31.56,Default,,0000,0000,0000,,وصل قطار يونو ياما عند الرصيف 1\Nفي محطّة ميزونو كاوا
Dialogue: 0,0:16:31.56,0:16:34.10,Default,,0000,0000,0000,,عند 10:35
Dialogue: 0,0:16:34.10,0:16:38.60,Default,,0000,0000,0000,,بعدما غادر قطار هانانو ماتشي\N!عند الرصيف 6 بالفعل
Dialogue: 0,0:16:38.60,0:16:40.64,Default,,0000,0000,0000,,كيف لي أن أبدّل القطار؟
Dialogue: 0,0:16:40.64,0:16:44.35,Default,,0000,0000,0000,,يمكن ذلك بمجرّد اتّصال هاتفي واحد
Dialogue: 0,0:16:46.05,0:16:47.27,Default,,0000,0000,0000,,اتّصال هاتفي؟
Dialogue: 0,0:16:47.63,0:16:50.00,Default,,0000,0000,0000,,إذا اتّصلت من هاتف خلويّ بمحطّة توقّف أمامية
Dialogue: 0,0:16:50.00,0:16:53.91,Default,,0000,0000,0000,,وطلبت أن يأخّروا قطار هانانو ماتشي
Dialogue: 0,0:16:53.91,0:16:56.52,Default,,0000,0000,0000,,لأنّك نسيت شيئاً على متنه
Dialogue: 0,0:16:59.54,0:17:01.32,Default,,0000,0000,0000,,عند 10:35
Dialogue: 0,0:17:01.32,0:17:03.53,Default,,0000,0000,0000,,،قبل وصولك محطّة ميزونو كاوا
Dialogue: 0,0:17:03.53,0:17:07.07,Default,,0000,0000,0000,,قلبت معطفك ثنائيّ الوجه
Dialogue: 0,0:17:07.07,0:17:09.53,Default,,0000,0000,0000,,وتنكّرت بشارب ونظّارات وما شابه
Dialogue: 0,0:17:11.22,0:17:13.18,Default,,0000,0000,0000,,،عندما وصلت محطّة ميزونو كاوا
Dialogue: 0,0:17:13.18,0:17:14.97,Default,,0000,0000,0000,,ركضت على المعبر الفوقيّ
Dialogue: 0,0:17:14.97,0:17:17.94,Default,,0000,0000,0000,,وانطلقت للرصيف 6 بأسرع ما يمكنك
Dialogue: 0,0:17:18.52,0:17:20.89,Default,,0000,0000,0000,,ذاك عندما تشاجرت مع الطبيب ساتو
Dialogue: 0,0:17:20.89,0:17:25.17,Default,,0000,0000,0000,,وانتقلت للعربة الأخيرة فورما غادر القطار
Dialogue: 0,0:17:25.17,0:17:27.55,Default,,0000,0000,0000,,طلبت من عاملي القطار\Nالبحث عن غرض مفقود
Dialogue: 0,0:17:27.55,0:17:29.71,Default,,0000,0000,0000,,لتأخير مغادرة قطار هانانو ماتشي
Dialogue: 0,0:17:29.71,0:17:32.89,Default,,0000,0000,0000,,مما سمح لك بالوصول في آخر اللحظات
Dialogue: 0,0:17:33.33,0:17:36.10,Default,,0000,0000,0000,,طلبت من الضحيّة الجلوس هناك غالباً
Dialogue: 0,0:17:37.00,0:17:39.66,Default,,0000,0000,0000,,قبل قتلك له
Dialogue: 0,0:17:40.78,0:17:42.15,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:17:42.15,0:17:45.57,Default,,0000,0000,0000,,موري-سان محق، تلقّوا اتصالاً بالبحث
Dialogue: 0,0:17:45.57,0:17:47.82,Default,,0000,0000,0000,,كان الرجل مُلحّاً لأنّه نسي ورقة عقد
Dialogue: 0,0:17:47.82,0:17:50.03,Default,,0000,0000,0000,,أهمّ من حياته وفقما يبدو
Dialogue: 0,0:17:50.03,0:17:52.98,Default,,0000,0000,0000,,لكنّهم لم يجدوها
Dialogue: 0,0:17:52.98,0:17:56.51,Default,,0000,0000,0000,,مدهش، لكن ما الذي يثبته ذلك؟
Dialogue: 0,0:17:56.51,0:18:00.80,Default,,0000,0000,0000,,هل سُجِّل الصوت وطابق صوتي؟
Dialogue: 0,0:18:00.80,0:18:02.13,Default,,0000,0000,0000,,لا يُعقل
Dialogue: 0,0:18:02.13,0:18:05.10,Default,,0000,0000,0000,,كنتُ على متن قطار يونو ياما طوال الوقت
Dialogue: 0,0:18:05.10,0:18:08.13,Default,,0000,0000,0000,,أرنا تذكرتك إذاً من فضلك
Dialogue: 0,0:18:08.13,0:18:12.81,Default,,0000,0000,0000,,أجروا تفتيش التذاكر على قطار\Nيونو ياما عند قرابة 10:40
Dialogue: 0,0:18:13.41,0:18:17.19,Default,,0000,0000,0000,,إذا لم تبدّل القطار، فيُفترض أن تحمل ختماً
Dialogue: 0,0:18:18.08,0:18:21.32,Default,,0000,0000,0000,,هلّا أريتنا تذكرتك يا داتي-سان؟
Dialogue: 0,0:18:21.32,0:18:23.22,Default,,0000,0000,0000,,آسف، لقد فقدتَها
Dialogue: 0,0:18:23.22,0:18:24.64,Default,,0000,0000,0000,,فـ-فقدتها؟
Dialogue: 0,0:18:25.26,0:18:27.60,Default,,0000,0000,0000,,هل تريدون إجراء تفتيش جسديّ؟
Dialogue: 0,0:18:28.95,0:18:31.44,Default,,0000,0000,0000,,ببساطة، لا دليل على بقائي على متن\Nالقطار طوال الوقت
Dialogue: 0,0:18:31.44,0:18:34.06,Default,,0000,0000,0000,,لكن لا دليل على تبديلي له أيضاً
Dialogue: 0,0:18:34.06,0:18:38.10,Default,,0000,0000,0000,,"المتّهم بريء حتى تثبت إدانته"
Dialogue: 0,0:18:38.10,0:18:38.81,Default,,0000,0000,0000,,صحيح حضرة المتحرّي؟
Dialogue: 0,0:18:41.11,0:18:43.38,Default,,0000,0000,0000,,آسف، لكني لا أستطيع إهدار وقتي أكثر
Dialogue: 0,0:18:43.38,0:18:44.22,Default,,0000,0000,0000,,فأنا مشغول
Dialogue: 0,0:18:44.88,0:18:47.31,Default,,0000,0000,0000,,على أيّ رصيف كان القطار إلى طوكيو مُجدداً؟
Dialogue: 0,0:18:48.06,0:18:49.82,Default,,0000,0000,0000,,...موري-سان
Dialogue: 0,0:18:52.08,0:18:53.68,Default,,0000,0000,0000,,طبيب داتي
Dialogue: 0,0:18:58.37,0:18:59.60,Default,,0000,0000,0000,,لا يزال هناك شيئًا؟
Dialogue: 0,0:18:59.60,0:19:03.52,Default,,0000,0000,0000,,كانت لديك الكثير من الفكّة في محفظتك
Dialogue: 0,0:19:08.24,0:19:09.61,Default,,0000,0000,0000,,إذاً؟
Dialogue: 0,0:19:09.61,0:19:13.23,Default,,0000,0000,0000,,من المحتمل أنّ القاتل \Nأخذ كلّ أموال الضحيّة
Dialogue: 0,0:19:13.23,0:19:16.77,Default,,0000,0000,0000,,من محفظته، بما في ذلك فكّته
Dialogue: 0,0:19:16.77,0:19:19.90,Default,,0000,0000,0000,,كي يجعلها تبدو كسرقة، وأضافها لمحفظته الشخصية
Dialogue: 0,0:19:21.05,0:19:22.35,Default,,0000,0000,0000,,وما في ذلك؟
Dialogue: 0,0:19:22.35,0:19:24.81,Default,,0000,0000,0000,,البصمات
Dialogue: 0,0:19:25.14,0:19:29.30,Default,,0000,0000,0000,,آسف، لكن أوتسومي-كن كان رفقتي البارحة
Dialogue: 0,0:19:30.38,0:19:32.92,Default,,0000,0000,0000,,دفعنا ثمن السجائر معاً
Dialogue: 0,0:19:32.92,0:19:37.46,Default,,0000,0000,0000,,فلن يكون غريباً أن تجدوا بصمات أصابعه
Dialogue: 0,0:19:37.46,0:19:39.73,Default,,0000,0000,0000,,على المال في محفظتي
Dialogue: 0,0:19:39.73,0:19:42.18,Default,,0000,0000,0000,,مـ-معه حق يا موري-سان
Dialogue: 0,0:19:42.57,0:19:43.91,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:19:43.91,0:19:47.19,Default,,0000,0000,0000,,لا أشير لبصمات أصابع الضحيّة
Dialogue: 0,0:19:47.57,0:19:48.40,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:19:49.87,0:19:53.35,Default,,0000,0000,0000,,ما قصدك؟ أيّ بصمات تشير لها؟
Dialogue: 0,0:19:55.02,0:19:56.86,Default,,0000,0000,0000,,تذكّروا
Dialogue: 0,0:19:56.86,0:19:58.56,Default,,0000,0000,0000,,،قُبيل أن يُقتل
Dialogue: 0,0:19:58.56,0:20:01.72,Default,,0000,0000,0000,,اشترى الضحيّة قهوة معلبة\Nمن العربة على متن القطار
Dialogue: 0,0:20:01.72,0:20:04.77,Default,,0000,0000,0000,,كان الزبون الأخير، ودفع بعملة 10 آلاف ين
Dialogue: 0,0:20:05.18,0:20:06.73,Default,,0000,0000,0000,,!لذا تتذكّره البائعة
Dialogue: 0,0:20:12.06,0:20:15.98,Default,,0000,0000,0000,,أجل، بصمات بائعة القطار
Dialogue: 0,0:20:19.09,0:20:20.43,Default,,0000,0000,0000,,طبيب داتي
Dialogue: 0,0:20:20.95,0:20:23.62,Default,,0000,0000,0000,,بصمات أصابع بائعة قطار هانانو ماتشي
Dialogue: 0,0:20:23.62,0:20:25.35,Default,,0000,0000,0000,,الذي يُفترض أنّك لم تكن على متنه
Dialogue: 0,0:20:28.16,0:20:32.76,Default,,0000,0000,0000,,...لو وجدناها على أيّ عملة في محفظتك
Dialogue: 0,0:20:51.21,0:20:54.39,Default,,0000,0000,0000,,كانت الشائعات صحيحة إذاً؟
Dialogue: 0,0:20:54.39,0:20:56.96,Default,,0000,0000,0000,,أجل، إنّها حقيقية
Dialogue: 0,0:20:56.96,0:21:00.70,Default,,0000,0000,0000,,!كنتُ أتلقى رشاوٍ
Dialogue: 0,0:21:00.70,0:21:04.39,Default,,0000,0000,0000,,!ضبطني وحاول ابتزازي
Dialogue: 0,0:21:05.08,0:21:06.95,Default,,0000,0000,0000,,طلب مالاً
Dialogue: 0,0:21:06.95,0:21:09.79,Default,,0000,0000,0000,,قال أنّه إذا لم أدفع\Nفلن يعود الأمر مجرد شائعة
Dialogue: 0,0:21:09.79,0:21:11.61,Default,,0000,0000,0000,,هدّدني بإرسال صور مُدينة
Dialogue: 0,0:21:11.61,0:21:14.53,Default,,0000,0000,0000,,!لرابطتي الطبيّة والمشفى الذي أعمل فيه
Dialogue: 0,0:21:14.53,0:21:19.11,Default,,0000,0000,0000,,عندها قرّرتُ عقد صفقة معه\Nللحصول على الفيلم
Dialogue: 0,0:21:19.11,0:21:20.68,Default,,0000,0000,0000,,!وقتله على القطار
Dialogue: 0,0:21:21.27,0:21:25.60,Default,,0000,0000,0000,,!لم أستطع تصديق أنّه سيسلّم كلّ الصور
Dialogue: 0,0:21:25.60,0:21:26.43,Default,,0000,0000,0000,,...كما
Dialogue: 0,0:21:26.43,0:21:29.52,Default,,0000,0000,0000,,ستدفع الشائعة بإجراء تحقيق يوماً ما
Dialogue: 0,0:21:29.52,0:21:34.76,Default,,0000,0000,0000,,لذا قرّرت استعمال حيلة\Nحجّة غياب بالقطارات
Dialogue: 0,0:21:34.76,0:21:37.14,Default,,0000,0000,0000,,وقتله لتفادي الشبهة بدل ذلك
Dialogue: 0,0:21:37.63,0:21:40.08,Default,,0000,0000,0000,,كانت خطّة متقنة
Dialogue: 0,0:21:40.08,0:21:42.26,Default,,0000,0000,0000,,!مثل كلّ عملياتي الجراحية الكبيرة
Dialogue: 0,0:21:43.25,0:21:45.66,Default,,0000,0000,0000,,حتّى أمهر الأطبّاء يبقون بشراً
Dialogue: 0,0:21:45.66,0:21:48.81,Default,,0000,0000,0000,,مع أنّ حصوله مؤسف، لكنّ تشخيصهم لا يصيب أحياناً
Dialogue: 0,0:21:49.33,0:21:54.27,Default,,0000,0000,0000,,يستحيل أن توجد جريمة كاملة لبشريّ
Dialogue: 0,0:23:29.97,0:23:31.97,Default,,0000,0000,0000,,...نمتُ جيّداً
Dialogue: 0,0:23:32.55,0:23:34.43,Default,,0000,0000,0000,,هانانو ماتشي؟
Dialogue: 0,0:23:34.43,0:23:35.93,Default,,0000,0000,0000,,لمَ لا نزال هنا؟
Dialogue: 0,0:23:36.64,0:23:40.29,Default,,0000,0000,0000,,طالما أنّنا هنا فلنقض ليلة\N!أخرى عند الينبوع الساخن
Dialogue: 0,0:23:40.29,0:23:42.38,Default,,0000,0000,0000,,!ينبوع هانانو ماتشي الساخن
Dialogue: 0,0:23:42.38,0:23:43.46,Default,,0000,0000,0000,,ليلة أخرى؟
Dialogue: 0,0:23:43.46,0:23:44.85,Default,,0000,0000,0000,,!فكرة حسنة! لنفعل ذلك
Dialogue: 0,0:23:45.63,0:23:47.38,Default,,0000,0000,0000,,...لحظة، أبي
Dialogue: 0,0:23:47.81,0:23:49.95,Default,,0000,0000,0000,,!لكن قضاء ليلة أخرى يبدو مسلياً
Dialogue: 0,0:23:49.74,0:23:50.46,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:24:11.05,0:24:12.10,Default,,0000,0000,0000,,ها هو
Dialogue: 0,0:24:12.10,0:24:14.43,Default,,0000,0000,0000,,إنّه خفيف، لكن يوجد أثر خدش حديث
Dialogue: 0,0:24:14.43,0:24:15.77,Default,,0000,0000,0000,,!من شيء رفيع
Dialogue: 0,0:24:19.92,0:24:21.21,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:24:21.21,0:24:24.39,Default,,0000,0000,0000,,!لا شكّ في الأمر، كانت جريمة قتل وليس حادثاً
Dialogue: 0,0:24:24.18,0:24:30.17,On Top,,0000,0000,15,,جريمة قتل أوجامانبو
Dialogue: 0,0:24:25.09,0:24:26.59,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.59,0:24:28.79,Default,,0000,0000,0000,,جريمة قتل أوجامانبو
Dialogue: 0,0:24:45.90,0:24:48.20,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.20,0:24:49.99,Default,,0000,0000,0000,,كاميرا مراقبة
Dialogue: 0,0:24:50.43,0:24:52.23,Default,,0000,0000,0000,,!يظهر في الحلقة ضيفان مميّزان
Dialogue: 0,0:24:52.23,0:24:55.06,Default,,0000,0000,0000,,!إنّهما ناكاياما هيديوكي-سان وأساغي كونيكو-سان

