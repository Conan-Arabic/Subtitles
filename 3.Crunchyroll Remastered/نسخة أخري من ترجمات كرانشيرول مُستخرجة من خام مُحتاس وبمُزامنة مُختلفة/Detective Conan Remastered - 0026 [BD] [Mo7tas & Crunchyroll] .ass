Dialogue: 0,0:00:01.59,0:00:03.13,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:03.13,0:00:06.05,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:06.05,0:00:08.61,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.61,0:00:10.12,Default,,0000,0000,0000,,!قضيّة اليوم عن الكلب جون
Dialogue: 0,0:00:10.12,0:00:12.12,Default,,0000,0000,0000,,إنّه كلبٌ راعٍ معروف في أرجاء الحيّ
Dialogue: 0,0:00:12.37,0:00:15.87,Default,,0000,0000,0000,,،قد لا تستطيع الكلاب الكلام\N!لكن الحقيقة واحدة دوماً
Dialogue: 0,0:01:47.02,0:01:49.56,Default,,0000,0000,0000,,جريمة قتل الكلب جون
Dialogue: 0,0:01:52.35,0:01:53.45,Default,,0000,0000,0000,,!جون
Dialogue: 0,0:01:53.45,0:01:55.02,Default,,0000,0000,0000,,!جون
Dialogue: 0,0:01:55.02,0:01:56.89,Default,,0000,0000,0000,,!جون
Dialogue: 0,0:01:56.89,0:01:58.47,Default,,0000,0000,0000,,!تعال يا جون
Dialogue: 0,0:02:01.76,0:02:03.43,Default,,0000,0000,0000,,!أتى
Dialogue: 0,0:02:03.43,0:02:05.22,Default,,0000,0000,0000,,!جون ظريفٌ جدّاً
Dialogue: 0,0:02:05.22,0:02:07.51,Default,,0000,0000,0000,,كم عمره الآن يا ترى؟
Dialogue: 0,0:02:07.51,0:02:10.54,Default,,0000,0000,0000,,كان لا يزال جرواً عندما كنتُ صغيراً
Dialogue: 0,0:02:10.54,0:02:12.73,Default,,0000,0000,0000,,...لذا قرابة الثامنة ربما
Dialogue: 0,0:02:12.73,0:02:14.69,Default,,0000,0000,0000,,ما الذي تقوله يا كونان؟
Dialogue: 0,0:02:16.37,0:02:18.03,Default,,0000,0000,0000,,!لا تهتموا
Dialogue: 0,0:02:18.03,0:02:20.53,Default,,0000,0000,0000,,...كان ذلك وشيكاً
Dialogue: 0,0:02:21.30,0:02:25.37,Default,,0000,0000,0000,,جون، لم أعد طالب الثانويّة كودو شينتشي
Dialogue: 0,0:02:25.37,0:02:27.78,Default,,0000,0000,0000,,أصبحتُ طالب الابتدائية إيدوغاوا كونان الآن
Dialogue: 0,0:02:29.19,0:02:31.06,Default,,0000,0000,0000,,إنّهم أنتم
Dialogue: 0,0:02:31.06,0:02:32.76,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:02:32.76,0:02:34.27,Default,,0000,0000,0000,,عُدنا
Dialogue: 0,0:02:34.87,0:02:35.97,Default,,0000,0000,0000,,لا أمانع
Dialogue: 0,0:02:35.97,0:02:38.02,Default,,0000,0000,0000,,ادخلوا
Dialogue: 0,0:02:38.02,0:02:39.18,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:02:40.76,0:02:42.72,On Top,,0000,0000,0000,,بعد بضعة أيّام
Dialogue: 0,0:02:43.68,0:02:46.04,Default,,0000,0000,0000,,مضى وقتٌ مذ تناولنا العشاء خارجاً
Dialogue: 0,0:02:46.04,0:02:48.22,Default,,0000,0000,0000,,كان ذلك المطعم ممتازاً
Dialogue: 0,0:02:49.21,0:02:52.18,Default,,0000,0000,0000,,!هذا هو المكان! حيث يعيش الكلب المدعو جون
Dialogue: 0,0:02:52.84,0:02:54.59,Default,,0000,0000,0000,,أعرف هذا المنزل
Dialogue: 0,0:02:54.59,0:02:55.71,Default,,0000,0000,0000,,فقد كان شينتشي يمرّ به
Dialogue: 0,0:02:55.71,0:02:58.20,Default,,0000,0000,0000,,في طريق عودتنا من المدرسة\Nعندما كنّا في الابتدائية
Dialogue: 0,0:02:58.20,0:03:01.89,Default,,0000,0000,0000,,كان يحتفظ بخبز من غدائه ويعطيه للكلب
Dialogue: 0,0:03:02.74,0:03:04.91,Default,,0000,0000,0000,,ساكاغوتشي ماسايوشي؟
Dialogue: 0,0:03:04.91,0:03:07.65,Default,,0000,0000,0000,,سمعتُ بهذا الاسم في مكان قبلاً
Dialogue: 0,0:03:07.65,0:03:09.37,Default,,0000,0000,0000,,يقول إنّه مُحامٍ
Dialogue: 0,0:03:09.37,0:03:10.35,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:03:10.86,0:03:16.01,Default,,0000,0000,0000,,إنّه مُحامٍ شهير يتخصص في القضايا\Nالمتعلقة بالقاصرين
Dialogue: 0,0:03:16.01,0:03:17.43,Default,,0000,0000,0000,,أبي
Dialogue: 0,0:03:17.43,0:03:21.56,Default,,0000,0000,0000,,أليس هذا المنزل حيث أقدم\Nفتى في المتوسطة على الانتحار
Dialogue: 0,0:03:21.56,0:03:24.31,Default,,0000,0000,0000,,عندما كنتُ في الصفّ الثالث؟
Dialogue: 0,0:03:28.63,0:03:30.10,Default,,0000,0000,0000,,!ما كان ذلك؟
Dialogue: 0,0:03:32.88,0:03:34.85,Default,,0000,0000,0000,,!ما الذي يجري؟
Dialogue: 0,0:03:37.54,0:03:38.56,Default,,0000,0000,0000,,!ماذا حصل؟
Dialogue: 0,0:03:38.56,0:03:40.12,Default,,0000,0000,0000,,...الكلب... الكلب
Dialogue: 0,0:03:40.12,0:03:41.31,Default,,0000,0000,0000,,!ماذا حدث لجون؟
Dialogue: 0,0:03:41.31,0:03:42.89,Default,,0000,0000,0000,,!قفز على تاكيشي
Dialogue: 0,0:03:45.08,0:03:46.51,Default,,0000,0000,0000,,!كونان-كن{\i1}{\i0}
Dialogue: 0,0:03:53.68,0:03:54.35,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:03:55.07,0:03:56.51,Default,,0000,0000,0000,,!لا تعترض الطريق، ابتعد
Dialogue: 0,0:04:03.43,0:04:05.19,Default,,0000,0000,0000,,!جون! إنّه أنا
Dialogue: 0,0:04:13.59,0:04:15.38,Default,,0000,0000,0000,,!أنت تدغدغني يا جون
Dialogue: 0,0:04:15.38,0:04:17.91,Default,,0000,0000,0000,,!مرحباً؟ ماذا يجري يا تاكيشي-كن؟{\i1}{\i0}
Dialogue: 0,0:04:17.91,0:04:18.70,Default,,0000,0000,0000,,!مرحباً؟
Dialogue: 0,0:04:18.70,0:04:20.58,Default,,0000,0000,0000,,!عمّ، إنّه أنا كونان
Dialogue: 0,0:04:20.58,0:04:22.20,Default,,0000,0000,0000,,ماذا؟ كونان-كن؟{\i1}{\i0}
Dialogue: 0,0:04:22.20,0:04:24.02,Default,,0000,0000,0000,,أين أنت الآن؟
Dialogue: 0,0:04:24.02,0:04:26.36,Default,,0000,0000,0000,,أنا في إيزو في عمل
Dialogue: 0,0:04:26.36,0:04:29.47,Default,,0000,0000,0000,,،سمعتُ صراخ تاكيشي-كن قبل قليل\Nما الذي حصل؟{\i1}{\i0}
Dialogue: 0,0:04:33.03,0:04:36.59,Default,,0000,0000,0000,,!ارجع بسرعة يا عمّ، أقدم جون على أمرٍ فظيع
Dialogue: 0,0:04:42.22,0:04:45.77,Default,,0000,0000,0000,,الضحيّة هو مايهارا تاكيشي، 22 عاماً
Dialogue: 0,0:04:45.77,0:04:48.34,Default,,0000,0000,0000,,طالب جامعيّ يعيش في مجمع الشقق المجاور
Dialogue: 0,0:04:48.34,0:04:50.89,Default,,0000,0000,0000,,وطلب منه ساكاغوتشي-سان حراسة\Nالمكان في غيابه، صحيح؟{\i1}{\i0}
Dialogue: 0,0:04:50.89,0:04:51.84,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:51.84,0:04:57.55,Default,,0000,0000,0000,,ودعاك تاكيشي-سان هنا يا سوغيتا ساناي-سان
Dialogue: 0,0:04:57.87,0:05:01.77,Default,,0000,0000,0000,,إذاً، هلّا وضحتِ تفاصيل ما حدث؟
Dialogue: 0,0:05:02.75,0:05:04.50,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:04.50,0:05:07.60,Default,,0000,0000,0000,,أتيتُ قرابة الثامنة
Dialogue: 0,0:05:12.43,0:05:15.11,Default,,0000,0000,0000,,لم أكن في غرفة معيشة\N!واسعة كهذه قبلاً
Dialogue: 0,0:05:15.11,0:05:16.64,Default,,0000,0000,0000,,ألستِ سعيدةً أنّك أتيتِ؟
Dialogue: 0,0:05:16.64,0:05:18.37,Default,,0000,0000,0000,,!جدّاً
Dialogue: 0,0:05:19.89,0:05:20.72,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:05:23.52,0:05:25.64,Default,,0000,0000,0000,,!كنتُ قد بدأت أستمتع
Dialogue: 0,0:05:28.05,0:05:29.60,Default,,0000,0000,0000,,أجل، مسكن ساكاغوتشي
Dialogue: 0,0:05:29.60,0:05:31.97,Default,,0000,0000,0000,,!ساكاغوتشي-سان{\i1}{\i0}
Dialogue: 0,0:05:31.97,0:05:34.14,Default,,0000,0000,0000,,أجل، لا مشاكل
Dialogue: 0,0:05:34.14,0:05:36.51,Default,,0000,0000,0000,,ماذا؟ جون؟
Dialogue: 0,0:05:37.04,0:05:39.72,Default,,0000,0000,0000,,إنّه أعلى الأدراج يتصرف بطواعية
Dialogue: 0,0:05:40.25,0:05:42.54,Default,,0000,0000,0000,,ماذا؟ تريد الكلام معه؟
Dialogue: 0,0:05:42.54,0:05:44.37,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:44.37,0:05:46.84,Default,,0000,0000,0000,,!جون، جون
Dialogue: 0,0:05:47.70,0:05:49.47,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:06:05.48,0:06:07.39,Default,,0000,0000,0000,,خذ، يريد سيّدك الكلام معك
Dialogue: 0,0:06:24.29,0:06:26.45,Default,,0000,0000,0000,,...ثم ظهرنا
Dialogue: 0,0:06:26.45,0:06:29.18,Default,,0000,0000,0000,,لكن لمَ قد يهاجم الكلب فجأةً؟
Dialogue: 0,0:06:29.18,0:06:30.74,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:06:30.74,0:06:33.89,Default,,0000,0000,0000,,لا أستطيع التفكير بسوى\N!أنّه هاجم تاكيشي بلا سبب
Dialogue: 0,0:06:33.89,0:06:37.34,Default,,0000,0000,0000,,!مستحيل! لن يهاجم جون إنساناً بلا سبب
Dialogue: 0,0:06:37.34,0:06:39.93,Default,,0000,0000,0000,,!لكن لم يقم تاكيشي بشيء
Dialogue: 0,0:06:40.44,0:06:43.14,Default,,0000,0000,0000,,ماذا سيحلّ بهذا الكلب حضرة المفتش؟
Dialogue: 0,0:06:43.14,0:06:45.27,Default,,0000,0000,0000,,لا يمكنني الجزم بعد
Dialogue: 0,0:06:45.27,0:06:49.26,Default,,0000,0000,0000,,،لكن إن هاجم دون سبب حقاً كما قالت
Dialogue: 0,0:06:49.26,0:06:51.18,Default,,0000,0000,0000,,سيُقتل قتلاً رحيماً غالباً
Dialogue: 0,0:06:51.60,0:06:54.39,Default,,0000,0000,0000,,!قتلاً رحيماً؟! ستقتلونه؟
Dialogue: 0,0:06:54.93,0:06:58.60,Default,,0000,0000,0000,,...أيّاً يكن، علينا الكلام مع السيّد ساكاغوتشي أوّلاً{\i1}{\i0}
Dialogue: 0,0:07:06.24,0:07:08.58,Default,,0000,0000,0000,,"انتحار طالب سنة أولى في المتوسطة"
Dialogue: 0,0:07:08.58,0:07:10.22,Default,,0000,0000,0000,,"أكان تعرّضه للتنمر السبب؟"
Dialogue: 0,0:07:10.22,0:07:13.24,Default,,0000,0000,0000,,"...زميلٌ تنمّر على ماساتو-كن"{\i1}{\i0}
Dialogue: 0,0:07:13.24,0:07:15.44,Default,,0000,0000,0000,,اسمه غير مذكور
Dialogue: 0,0:07:16.02,0:07:18.65,Default,,0000,0000,0000,,جون مُمرن بعناية
Dialogue: 0,0:07:18.65,0:07:21.36,Default,,0000,0000,0000,,ويستحيل أن يهاجم إنساناً بلا سبب
Dialogue: 0,0:07:21.36,0:07:21.97,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:07:23.11,0:07:27.43,Default,,0000,0000,0000,,هاجم جون الضحيّة فوراً\Nبعدما وُضعت السماعة على إذنه
Dialogue: 0,0:07:28.01,0:07:32.56,Default,,0000,0000,0000,,أيمكن أنّ ساكاغوتشي-سان أعطاه\N!أمر المهاجمة عبر الهاتف؟{\i1}{\i0}
Dialogue: 0,0:07:32.56,0:07:36.53,Default,,0000,0000,0000,,لكن يصعب أن أتخيل ساكاغوتشي-سان \Nاللطيف يقوم بذلك{\i1}{\i0}
Dialogue: 0,0:07:40.09,0:07:41.89,Default,,0000,0000,0000,,حضرة المفتش، أين جون؟
Dialogue: 0,0:07:42.21,0:07:44.59,Default,,0000,0000,0000,,!هل قتلتموه بالفعل؟
Dialogue: 0,0:07:44.59,0:07:46.45,Default,,0000,0000,0000,,لا تقلق
Dialogue: 0,0:07:46.45,0:07:49.08,Default,,0000,0000,0000,,أخذناه لمركز الشرطة في الوقت الراهن
Dialogue: 0,0:07:49.08,0:07:50.85,Default,,0000,0000,0000,,لم يُحسم أنّه سيقتل قتلاً رحيماً بعد
Dialogue: 0,0:07:52.54,0:07:55.90,Default,,0000,0000,0000,,إذاً سيّدي المفتش، ما الذي قاله السيّد ساكاغوتشي؟{\i1}{\i0}
Dialogue: 0,0:07:55.90,0:07:59.30,Default,,0000,0000,0000,,قال أنّه لا يصدّق أنّ جون هاجم شخصاً
Dialogue: 0,0:07:59.30,0:08:02.64,Default,,0000,0000,0000,,...ولا أنا! لا بدّ من وجود سبب
Dialogue: 0,0:08:02.64,0:08:05.07,Default,,0000,0000,0000,,!ابق صامتاً
Dialogue: 0,0:08:05.07,0:08:06.80,Default,,0000,0000,0000,,أكمل يا مفتّش
Dialogue: 0,0:08:07.22,0:08:13.64,Default,,0000,0000,0000,,سألتُ السيّد ساكاغوتشي عن محادثتهما الهاتفية
Dialogue: 0,0:08:13.64,0:08:17.01,Default,,0000,0000,0000,,ماذا قلتَ للضحية على الهاتف بدءاً؟
Dialogue: 0,0:08:17.01,0:08:18.42,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:08:18.42,0:08:21.71,Default,,0000,0000,0000,,سألتُه عن الأوضاع وعن أحوال جون
Dialogue: 0,0:08:21.71,0:08:24.48,Default,,0000,0000,0000,,وطلبتُ منه وضع السماعة على أذنه
Dialogue: 0,0:08:24.80,0:08:26.43,Default,,0000,0000,0000,,لمَ ذلك؟
Dialogue: 0,0:08:26.87,0:08:30.79,Default,,0000,0000,0000,,،دائماً ما ألقي عليه وداعية النوم\Nفأردتُ فعل ذلك الليلة أيضاً
Dialogue: 0,0:08:30.79,0:08:32.70,Default,,0000,0000,0000,,ودّعته إذاً؟
Dialogue: 0,0:08:32.70,0:08:37.97,Default,,0000,0000,0000,,"سألته قبلها وفقما أذكر "كيف حالك يا جون؟ بخير؟
Dialogue: 0,0:08:37.97,0:08:43.57,Default,,0000,0000,0000,,...ثمّ سمعت زمجرة جون المفاجئة وصراخ تاكيشي-كن
Dialogue: 0,0:08:45.03,0:08:47.97,Default,,0000,0000,0000,,لم يقل ساكاغوتشي-سان شيئاً آخر؟{\i1}{\i0}
Dialogue: 0,0:08:47.97,0:08:49.68,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:08:49.68,0:08:53.31,Default,,0000,0000,0000,,أكّدت الفتاة التي كانت هناك روايته
Dialogue: 0,0:08:53.31,0:08:55.93,Default,,0000,0000,0000,,ذكرتُ الموضوع البارحة، صحيح يا ران-نيتشان؟
Dialogue: 0,0:08:56.34,0:08:59.64,Default,,0000,0000,0000,,انتحار ابن ساكاغوتشي-سان في الماضي {\i1}{\i0}
Dialogue: 0,0:09:00.57,0:09:01.18,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:01.72,0:09:04.88,Default,,0000,0000,0000,,سألته عن ذلك في المركز أيضاً
Dialogue: 0,0:09:04.88,0:09:06.97,Default,,0000,0000,0000,,...قال أنّ مُتنمراً دفعه لذلك
Dialogue: 0,0:09:07.37,0:09:13.10,Default,,0000,0000,0000,,!أيمكن أنّ مُتنمر ابنه وقتها كان مايهارا تاكيشي؟{\i1}{\i0}
Dialogue: 0,0:09:13.58,0:09:15.80,Default,,0000,0000,0000,,لكن ذلك مجرد احتمال
Dialogue: 0,0:09:16.24,0:09:17.51,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:09:17.51,0:09:20.99,Default,,0000,0000,0000,,سمعتُ من السيّد ساكاغوتشي مباشرةً{\i1}{\i0}
Dialogue: 0,0:09:20.99,0:09:23.53,Default,,0000,0000,0000,,أن ابنه ماساتو-كن ومايهارا تاكيشي-كن{\i1}{\i0}{\i1}{\i0}
Dialogue: 0,0:09:23.53,0:09:25.23,Default,,0000,0000,0000,,كانا زميلين في المتوسطة
Dialogue: 0,0:09:25.98,0:09:29.60,Default,,0000,0000,0000,,كتب ماساتو-كن عن تاكيشي-كن\Nفي دفتر يومياته وفقما يبدو{\i1}{\i0}{\i1}{\i0}
Dialogue: 0,0:09:29.60,0:09:31.64,Default,,0000,0000,0000,,قُبيل شنق نفسه في غرفته
Dialogue: 0,0:09:32.44,0:09:37.09,Default,,0000,0000,0000,,سمعتُ أنّ السيّد ساكاغوتشي ملأه\Nالحقد على تاكيشي-كن بعد قراءة الدفتر{\i1}{\i0}
Dialogue: 0,0:09:37.09,0:09:42.10,Default,,0000,0000,0000,,فماساتو-كن كان كلّ ما تبقى له\Nبعد وفاة زوجته المبكرة{\i1}{\i0}
Dialogue: 0,0:09:42.72,0:09:46.21,Default,,0000,0000,0000,,لكن بعد رؤيته لنحيب تاكيشي-كن\N،واعتذاره في الجنازة{\i1}{\i0}
Dialogue: 0,0:09:46.21,0:09:48.05,Default,,0000,0000,0000,,قرّر مسامحته
Dialogue: 0,0:09:48.50,0:09:52.18,Default,,0000,0000,0000,,تاكيشي-كن كان الوحيد الذي\Nتنمرّ على ماساتو-كن؟{\i1}{\i0}{\i1}{\i0}
Dialogue: 0,0:09:52.58,0:09:53.75,Default,,0000,0000,0000,,يبدو ذلك
Dialogue: 0,0:09:53.75,0:09:56.86,Default,,0000,0000,0000,,انتقل تاكيشي-كن بعدها بفترة قصيرة لكانسي{\i1}{\i0}
Dialogue: 0,0:09:56.86,0:09:58.68,Default,,0000,0000,0000,,بسبب عمل أبيه
Dialogue: 0,0:09:59.36,0:10:03.95,Default,,0000,0000,0000,,ثمّ عاد لطوكيو قبل عامين\Nلالتحاقه بجامعة هنا
Dialogue: 0,0:10:03.95,0:10:06.51,Default,,0000,0000,0000,,انتقل هذا الربيع لمجمع الشقق
Dialogue: 0,0:10:06.51,0:10:07.89,Default,,0000,0000,0000,,بجوار منزل ساكاغوتشي
Dialogue: 0,0:10:09.06,0:10:12.35,Default,,0000,0000,0000,,كأنّها لعبة قدر
Dialogue: 0,0:10:12.85,0:10:16.51,Default,,0000,0000,0000,,يبدو أنّ السيّد ساكاغوتشي دُهش\Nمن لمّ الشمل المفاجئ أيضاً
Dialogue: 0,0:10:16.51,0:10:20.01,Default,,0000,0000,0000,,لكنه لم يعد يُضمر أيّ حقد تّجاه تاكيشي-كن{\i1}{\i0}
Dialogue: 0,0:10:20.34,0:10:24.98,Default,,0000,0000,0000,,سمعت أنّه دعاه عدّة مرات\Nللعشاء في منزله حتّى
Dialogue: 0,0:10:25.39,0:10:29.55,Default,,0000,0000,0000,,لكن إن كان لا يزال\N...حاقداً على تاكيشي-كن حقاً{\i1}{\i0}
Dialogue: 0,0:10:29.55,0:10:31.39,Default,,0000,0000,0000,,ما الذي تحاول قوله؟
Dialogue: 0,0:10:31.39,0:10:36.37,Default,,0000,0000,0000,,مرّن السيّد ساكاغوتشي جون سرّاً\Nعلى مهاجمة الناس
Dialogue: 0,0:10:36.37,0:10:38.10,Default,,0000,0000,0000,,عندما يسمع عبارةً ما
Dialogue: 0,0:10:38.10,0:10:43.20,Default,,0000,0000,0000,,!والبارحة نطق تلك العبارة لجون عبر الهاتف
Dialogue: 0,0:10:43.20,0:10:46.05,Default,,0000,0000,0000,,كيف حالك يا جون؟ بخير؟
Dialogue: 0,0:10:53.02,0:10:56.51,Default,,0000,0000,0000,,وهكذا أخذ السيّد ساكاغوتشي بثأره
Dialogue: 0,0:10:56.51,0:10:57.66,Default,,0000,0000,0000,,خطأ
Dialogue: 0,0:10:58.55,0:10:59.55,Default,,0000,0000,0000,,لمَ ذلك؟
Dialogue: 0,0:10:59.55,0:11:01.35,Default,,0000,0000,0000,,أنسيت؟
Dialogue: 0,0:11:01.35,0:11:03.85,Default,,0000,0000,0000,,عندما استجوبته البارحة
Dialogue: 0,0:11:04.35,0:11:07.14,Default,,0000,0000,0000,,ردّد العبارة التي قالها على الهاتف أمام جون
Dialogue: 0,0:11:07.59,0:11:11.06,Default,,0000,0000,0000,,لم يبد جون أيّ ردة فعل وقتها
Dialogue: 0,0:11:12.25,0:11:16.09,Default,,0000,0000,0000,,!خيبة! أظهرتُ سياديةً أيضاً
Dialogue: 0,0:11:16.09,0:11:19.80,Default,,0000,0000,0000,,لا تنتكس هكذا يا موري-كن{\i1}{\i0}
Dialogue: 0,0:11:31.69,0:11:32.57,Default,,0000,0000,0000,,...ماساتو
Dialogue: 0,0:11:38.51,0:11:40.14,Default,,0000,0000,0000,,شكراً على قدومك يا كونان-كن{\i1}{\i0}
Dialogue: 0,0:11:40.14,0:11:43.93,Default,,0000,0000,0000,,ظننتك ستشعر بالوحدة دون جون
Dialogue: 0,0:11:44.76,0:11:45.88,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:11:45.88,0:11:51.34,Default,,0000,0000,0000,,أخبرني يا عمّ، أكان جون ينام\Nفوق الأدراج دوماً؟
Dialogue: 0,0:11:51.34,0:11:52.68,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:11:52.68,0:11:54.52,Default,,0000,0000,0000,,لمَ لا ينام في الأسفل؟
Dialogue: 0,0:11:54.88,0:11:56.87,Default,,0000,0000,0000,,أترى الباب هناك؟
Dialogue: 0,0:11:56.87,0:11:57.47,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:57.87,0:12:00.18,Default,,0000,0000,0000,,كانت غرفة ابني
Dialogue: 0,0:12:01.22,0:12:04.54,Default,,0000,0000,0000,,كان يحبّ جون حبّاً جمّاً
Dialogue: 0,0:12:04.54,0:12:08.61,Default,,0000,0000,0000,,لكن لم تسمح أمّه الراحلة\Nبأن يدخل الكلب في غرفته
Dialogue: 0,0:12:08.61,0:12:11.18,Default,,0000,0000,0000,,فكان جون ينام أمام الباب دوماً
Dialogue: 0,0:12:12.48,0:12:18.64,Default,,0000,0000,0000,,لا يزال جون ينتظر خروج ابني\Nويلقي عليه تحيّة الصباح
Dialogue: 0,0:12:18.64,0:12:21.18,Default,,0000,0000,0000,,رغم أنّ 8 أعوام مضت على موته
Dialogue: 0,0:12:25.71,0:12:28.14,Default,,0000,0000,0000,,يوجد هاتفٌ كبير على الطاولة
Dialogue: 0,0:12:28.63,0:12:30.64,Default,,0000,0000,0000,,السمّاعة مربوطة بسلك
Dialogue: 0,0:12:30.88,0:12:35.80,Default,,0000,0000,0000,,أخبرني يا عمّ، ألم يكن هناك\Nهاتف بلا أسلاك البارحة؟
Dialogue: 0,0:12:36.37,0:12:40.00,Default,,0000,0000,0000,,بلى، أبدّله مع الهاتف في مكتبي أحياناً
Dialogue: 0,0:12:40.00,0:12:41.52,Default,,0000,0000,0000,,لمَ تسأل؟
Dialogue: 0,0:12:41.52,0:12:43.63,Default,,0000,0000,0000,,!لا سبب
Dialogue: 0,0:12:44.41,0:12:46.31,Default,,0000,0000,0000,,...هذا الشخص فعلاً
Dialogue: 0,0:12:52.65,0:12:53.90,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:12:53.90,0:12:57.74,Default,,0000,0000,0000,,قرعت الساعة عند التاسعة قبل وقوع الحادثة
Dialogue: 0,0:12:57.74,0:13:00.18,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:13:00.18,0:13:03.99,Default,,0000,0000,0000,,عرفت أمر الهجوم الذي أعطاه \N!ساكاغوتشي-سان لجون{\i1}{\i0}
Dialogue: 0,0:13:09.36,0:13:11.06,Default,,0000,0000,0000,,اختلف الهاتف؟
Dialogue: 0,0:13:11.06,0:13:11.60,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:11.60,0:13:14.52,Default,,0000,0000,0000,,السمّاعة على الهاتف الكبير مربوطة بسلك
Dialogue: 0,0:13:14.52,0:13:17.76,Default,,0000,0000,0000,,لكنه وضع هاتفاً بلا أسلاك البارحة وفقما قال
Dialogue: 0,0:13:17.76,0:13:18.99,Default,,0000,0000,0000,,فلمَ يا ترى؟
Dialogue: 0,0:13:19.39,0:13:22.31,Default,,0000,0000,0000,,...لمَ؟ لا سبب غالباً
Dialogue: 0,0:13:22.31,0:13:24.21,Default,,0000,0000,0000,,كلا، بل هناك سبب
Dialogue: 0,0:13:24.21,0:13:28.61,Default,,0000,0000,0000,,كان ساكاغوتشي-سان يحتاج\N!هاتفاً لا سلكياً{\i1}{\i0}
Dialogue: 0,0:13:29.67,0:13:30.60,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:13:30.60,0:13:36.48,Default,,0000,0000,0000,,اسمعا، من المستحيل أخذ هاتف عاديّ فوق الأدراج
Dialogue: 0,0:13:36.48,0:13:40.82,Default,,0000,0000,0000,,لذا تعمّد ساكاغوتشي-سان وضع هاتف \Nمحمول بلا أسلاك{\i1}{\i0}
Dialogue: 0,0:13:40.82,0:13:42.27,Default,,0000,0000,0000,,!في غرفة المعيشة
Dialogue: 0,0:13:42.61,0:13:48.02,Default,,0000,0000,0000,,لا تزال تعتقد أنّ ساكاغوتشي-سان\Nاستعمل جون لارتكاب الجريمة إذاً؟{\i1}{\i0}
Dialogue: 0,0:13:48.02,0:13:50.60,Default,,0000,0000,0000,,أنا على يقين الآن
Dialogue: 0,0:13:50.60,0:13:53.90,Default,,0000,0000,0000,,!لكني لا أزال أجهل أمرَ الهجوم والذي هو الأهمّ
Dialogue: 0,0:13:53.90,0:13:56.61,Default,,0000,0000,0000,,ساعتنا لا تصدر قرعاً، صحيح؟
Dialogue: 0,0:13:57.57,0:14:03.90,Default,,0000,0000,0000,,تصدر الساعة في غرفة معيشة ساكاغوتشي-سان\Nقرعاً عالياً كلّ ساعة
Dialogue: 0,0:14:03.90,0:14:05.30,Default,,0000,0000,0000,,الساعة؟
Dialogue: 0,0:14:05.30,0:14:06.34,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:14:06.34,0:14:08.61,Default,,0000,0000,0000,,!هاجم جون تاكيشي-كن تمام الساعة التاسعة{\i1}{\i0}
Dialogue: 0,0:14:08.61,0:14:10.37,Default,,0000,0000,0000,,!فهمتها
Dialogue: 0,0:14:10.37,0:14:14.57,Default,,0000,0000,0000,,حلّ المتحرّي العظيم موري كوغورو\N!اللغز بكلّ براعة
Dialogue: 0,0:14:18.03,0:14:21.06,On Top,,0000,0000,0000,,مركز شرطة بيكا
Dialogue: 0,0:14:25.15,0:14:27.69,Default,,0000,0000,0000,,ما الذي ستفعلونه بالضبط؟
Dialogue: 0,0:14:27.69,0:14:30.27,Default,,0000,0000,0000,,اختبار صغير فقط
Dialogue: 0,0:14:31.89,0:14:33.47,Default,,0000,0000,0000,,،عندما أعطيك الإشارة
Dialogue: 0,0:14:33.47,0:14:36.73,Default,,0000,0000,0000,,أعد ما قلتَه لجون البارحة على الهاتف
Dialogue: 0,0:14:36.73,0:14:38.69,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:15:05.49,0:15:06.98,Default,,0000,0000,0000,,الآن يا ساكاغوتشي-سان
Dialogue: 0,0:15:06.98,0:15:08.65,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:15:08.65,0:15:12.02,Default,,0000,0000,0000,,كيف حالك يا جون؟ بخير؟
Dialogue: 0,0:15:13.85,0:15:15.40,Default,,0000,0000,0000,,!بصوت أعلى
Dialogue: 0,0:15:15.77,0:15:18.36,Default,,0000,0000,0000,,كيف حالك يا جون؟ بخير؟
Dialogue: 0,0:15:20.69,0:15:22.77,Default,,0000,0000,0000,,!مُحال
Dialogue: 0,0:15:23.30,0:15:26.48,Default,,0000,0000,0000,,!أأخطأت باستنتاجي؟
Dialogue: 0,0:15:28.94,0:15:32.27,Default,,0000,0000,0000,,...كنتُ متيقناً
Dialogue: 0,0:15:32.66,0:15:35.08,Default,,0000,0000,0000,,بالغت في التحليل يا أبي
Dialogue: 0,0:15:35.08,0:15:38.99,Default,,0000,0000,0000,,لن يستعمل الكلب الذي أحبّه ابنه للانتقام
Dialogue: 0,0:15:38.99,0:15:41.70,Default,,0000,0000,0000,,لا يمكنني الجزم
Dialogue: 0,0:15:41.70,0:15:43.90,Default,,0000,0000,0000,,لكن ما وجدناه من تحقيقنا لاحقاً
Dialogue: 0,0:15:43.90,0:15:47.03,Default,,0000,0000,0000,,أنّ ساكاغوتشي-سان كان يصطحب معه جون\Nلمكانٍ ما في سيّارته
Dialogue: 0,0:15:47.03,0:15:50.27,Default,,0000,0000,0000,,كلّ يوم أحد في الثلاثة أشهر الفائتة
Dialogue: 0,0:15:51.02,0:15:53.48,Default,,0000,0000,0000,,وفقاً لكلامه، فقد أخذه لضواحي المدينة
Dialogue: 0,0:15:53.48,0:15:56.85,Default,,0000,0000,0000,,ليطلقه بحريّة في الحقول الفسيحة
Dialogue: 0,0:15:56.85,0:16:01.10,Default,,0000,0000,0000,,!سيّدي المفتّش! كان يمرّن جون وقتها بلا شك
Dialogue: 0,0:16:01.10,0:16:04.01,Default,,0000,0000,0000,,لكن لا دليل هناك
Dialogue: 0,0:16:04.01,0:16:07.51,Default,,0000,0000,0000,,...فضلاً عن ذلك، يؤسفني قول هذا
Dialogue: 0,0:16:07.51,0:16:11.06,Default,,0000,0000,0000,,لكن قُرّر أن قتل جون الرحيم\Nسيكون مساء الغد
Dialogue: 0,0:16:11.83,0:16:12.90,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:16:12.90,0:16:14.71,Default,,0000,0000,0000,,أوامر من الأعلى
Dialogue: 0,0:16:14.71,0:16:17.50,Default,,0000,0000,0000,,تفهّم السيّد ساكاغوتشي أيضاً
Dialogue: 0,0:16:23.66,0:16:25.32,Default,,0000,0000,0000,,...شينتشي
Dialogue: 0,0:16:25.32,0:16:27.23,Default,,0000,0000,0000,,أين أنت؟
Dialogue: 0,0:16:28.03,0:16:29.45,Default,,0000,0000,0000,,سيُقتل الكلب جون
Dialogue: 0,0:16:29.45,0:16:33.56,Default,,0000,0000,0000,,!الذي أحببتَه جداً إلم نفعل شيئاً
Dialogue: 0,0:16:33.56,0:16:36.92,Default,,0000,0000,0000,,أرجوك يا شينتشي، ارجع
Dialogue: 0,0:16:36.92,0:16:41.15,Default,,0000,0000,0000,,أنتَ الوحيد القادر على إنقاذ جون
Dialogue: 0,0:16:47.84,0:16:50.48,Default,,0000,0000,0000,,!سيقتلون جون مساء اليوم إذاً؟
Dialogue: 0,0:16:50.48,0:16:52.50,Default,,0000,0000,0000,,!هذا فظيع
Dialogue: 0,0:16:52.50,0:16:54.19,Default,,0000,0000,0000,,!ألا يمكننا فعل شيء؟
Dialogue: 0,0:16:54.19,0:16:57.17,Default,,0000,0000,0000,,!لم أستطع النوم البارحة من التفكير بدوري
Dialogue: 0,0:16:57.17,0:16:58.08,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:17:00.90,0:17:02.86,Default,,0000,0000,0000,,حسنٌ، الدفعة التالية
Dialogue: 0,0:17:02.86,0:17:04.32,Default,,0000,0000,0000,,في مواضعكم
Dialogue: 0,0:17:06.11,0:17:07.57,Default,,0000,0000,0000,,!استعداد
Dialogue: 0,0:17:12.31,0:17:13.40,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:17:14.11,0:17:15.94,Default,,0000,0000,0000,,!فهمتُ الأمر أخيراً
Dialogue: 0,0:17:17.32,0:17:19.65,Default,,0000,0000,0000,,ما الذي فهمه يا ترى؟
Dialogue: 0,0:17:19.65,0:17:21.52,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:17:19.65,0:17:21.52,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:17:24.93,0:17:26.73,Default,,0000,0000,0000,,!ماذا الآن؟
Dialogue: 0,0:17:27.01,0:17:30.69,Default,,0000,0000,0000,,أريد إجراء اختبارٍ آخر
Dialogue: 0,0:17:41.16,0:17:43.02,Default,,0000,0000,0000,,...في موضعك
Dialogue: 0,0:17:45.62,0:17:47.03,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:18:05.60,0:18:06.86,Default,,0000,0000,0000,,استعداد
Dialogue: 0,0:18:09.84,0:18:12.55,Default,,0000,0000,0000,,ردّد كلماتك الآن
Dialogue: 0,0:18:24.74,0:18:26.44,Default,,0000,0000,0000,,!أستسلم
Dialogue: 0,0:18:27.99,0:18:33.65,Default,,0000,0000,0000,,تعترف أنّك مرّنت جون على مهاجمة \Nمايهارا تاكيشي-كن إذاً؟{\i1}{\i0}
Dialogue: 0,0:18:33.65,0:18:37.82,Default,,0000,0000,0000,,لم يتذكر ذاك الفتى شيئاً
Dialogue: 0,0:18:38.03,0:18:40.81,Default,,0000,0000,0000,,لم يتذكرني أو ماساتو
Dialogue: 0,0:18:40.81,0:18:41.60,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:18:41.60,0:18:46.53,Default,,0000,0000,0000,,!نسي بالكامل أمر الشخص الذي دفعه للانتحار
Dialogue: 0,0:18:46.85,0:18:49.98,Default,,0000,0000,0000,,...ثمّ انتقل بلا تفكير إلى مجمع الشقق بجوارك
Dialogue: 0,0:18:50.34,0:18:53.67,Default,,0000,0000,0000,,أنا مُحامٍ متخصص في جرائم القاصرين
Dialogue: 0,0:18:53.67,0:18:57.88,Default,,0000,0000,0000,,دخلتُ هذا العمل كي أساعد\Nالشبّان الذين ضلّوا طريقهم
Dialogue: 0,0:18:57.88,0:19:02.75,Default,,0000,0000,0000,,لذا عندما رأيتُه يبكي ويعتذر\N،في الجنازة قبل 8 أعوام
Dialogue: 0,0:19:02.75,0:19:04.50,Default,,0000,0000,0000,,قرّرتُ مسامحته
Dialogue: 0,0:19:04.50,0:19:06.69,Default,,0000,0000,0000,,فقد كان لا يزال صبيّاً\Nفي السنة الأولى من المتوسطة
Dialogue: 0,0:19:07.16,0:19:09.54,Default,,0000,0000,0000,,وشعرتُ أنّ موت ماساتو لن يذهب هباءً
Dialogue: 0,0:19:09.54,0:19:12.65,Default,,0000,0000,0000,,إن تحسّف من أعماقه
Dialogue: 0,0:19:13.49,0:19:16.61,Default,,0000,0000,0000,,لكن عندما التقيته مجدداً بعد 8 أعوام
Dialogue: 0,0:19:16.61,0:19:19.81,Default,,0000,0000,0000,,!لم يذكر أيّ شيء عن الحادثة
Dialogue: 0,0:19:19.81,0:19:23.31,Default,,0000,0000,0000,,!وفوقها لم يتغير أبداً عمَّ كان عليه قبل 8 أعوام
Dialogue: 0,0:19:23.98,0:19:25.77,Default,,0000,0000,0000,,!أعد محفظتي
Dialogue: 0,0:19:25.77,0:19:27.78,Default,,0000,0000,0000,,!سأستعيرها فحسب
Dialogue: 0,0:19:31.05,0:19:34.98,Default,,0000,0000,0000,,لا تقلق، سأردّ لك الدين يوماً\Nعندما أشعر برغبة في ذلك
Dialogue: 0,0:19:36.09,0:19:39.66,Default,,0000,0000,0000,,رغم أنّي لا أدري متى قد يأتي ذلك
Dialogue: 0,0:19:39.66,0:19:44.66,Default,,0000,0000,0000,,...غلى دمي عندما رأيتُ ذلك
Dialogue: 0,0:19:45.83,0:19:49.33,Default,,0000,0000,0000,,!ما كان المغزى من موت ماساتو؟
Dialogue: 0,0:19:49.33,0:19:53.06,Default,,0000,0000,0000,,!لمَ سامحتُه آنذاك؟
Dialogue: 0,0:19:53.06,0:19:55.11,Default,,0000,0000,0000,,...استعملت جون إذاً
Dialogue: 0,0:19:55.11,0:19:56.15,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:19:56.15,0:19:57.82,Default,,0000,0000,0000,,قررتُ أن أطبق العدالة بيديّ
Dialogue: 0,0:19:57.82,0:19:59.73,Default,,0000,0000,0000,,!إن عجز القانون عن ذلك
Dialogue: 0,0:19:59.73,0:20:03.48,Default,,0000,0000,0000,,!وأنا متأكد أنّ جون سعيد بانتقامه لماساتو
Dialogue: 0,0:20:03.48,0:20:05.19,Default,,0000,0000,0000,,!هذا فظيع
Dialogue: 0,0:20:05.48,0:20:09.02,Default,,0000,0000,0000,,لم تكن الوحيد الذي غرق في الحزن\N!عندما مات ماساتو-كن{\i1}{\i0}
Dialogue: 0,0:20:09.02,0:20:11.15,Default,,0000,0000,0000,,!ألديك أيّ فكرة عن حزن جون؟
Dialogue: 0,0:20:11.15,0:20:13.01,Default,,0000,0000,0000,,ألم تقل بنفسك؟
Dialogue: 0,0:20:13.01,0:20:18.09,Default,,0000,0000,0000,,!أنّ جون لا يزال ينتظر ماساتو-كن أمام غرفته{\i1}{\i0}
Dialogue: 0,0:20:18.09,0:20:20.81,Default,,0000,0000,0000,,أتظنّ ماساتو-كن سيسعد باستعمالك كلبه المخلص{\i1}{\i0}
Dialogue: 0,0:20:20.81,0:20:23.40,Default,,0000,0000,0000,,!لقتل شخص؟
Dialogue: 0,0:20:25.00,0:20:29.74,Default,,0000,0000,0000,,ساكاغوتشي-سان، التنمّر غير مقبول أبداً بالفعل
Dialogue: 0,0:20:29.74,0:20:33.02,Default,,0000,0000,0000,,وأتفهم مشاعر حقدك على مايهارا تاكيشي-كن
Dialogue: 0,0:20:33.49,0:20:36.27,Default,,0000,0000,0000,,لكن أسبق وفكرت بمشاعر الكلب
Dialogue: 0,0:20:36.27,0:20:41.98,Default,,0000,0000,0000,,الذي استعملتَه أداةً للقتل\Nفي جهل تامٍ منه؟
Dialogue: 0,0:20:43.56,0:20:45.94,Default,,0000,0000,0000,,مشاعر جون؟
Dialogue: 0,0:20:47.31,0:20:48.82,Default,,0000,0000,0000,,هيّا، اخرج يا جون
Dialogue: 0,0:20:54.22,0:20:54.97,Default,,0000,0000,0000,,!جون
Dialogue: 0,0:20:57.05,0:20:58.51,Default,,0000,0000,0000,,ساكاغوتشي-سان
Dialogue: 0,0:20:58.51,0:21:01.52,Default,,0000,0000,0000,,يقول جون أنّه لا يزال يهتمّ بك للآن
Dialogue: 0,0:21:01.96,0:21:04.83,Default,,0000,0000,0000,,حاول فهم ذاك الشعور رجاءً
Dialogue: 0,0:21:06.13,0:21:06.98,Default,,0000,0000,0000,,!جون
Dialogue: 0,0:21:06.98,0:21:09.94,Default,,0000,0000,0000,,!سامحني رجاءً يا جون! جون
Dialogue: 0,0:21:11.32,0:21:13.87,Default,,0000,0000,0000,,!جون
Dialogue: 0,0:22:51.60,0:22:54.19,Default,,0000,0000,0000,,!لم يقتلوا جون إذاً؟
Dialogue: 0,0:22:54.19,0:22:55.22,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:22:55.22,0:22:58.15,Default,,0000,0000,0000,,تبنّاه أحد أقارب ساكاغوتشي-سان
Dialogue: 0,0:22:58.15,0:22:59.60,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:22:59.60,0:23:04.36,Default,,0000,0000,0000,,!كان كلّ ذلك بفضل المتحرّي العظيم موري كوغورو
Dialogue: 0,0:23:06.17,0:23:09.75,Default,,0000,0000,0000,,لكن لم يعد جون يعيش في ذاك المنزل
Dialogue: 0,0:23:09.75,0:23:13.52,Default,,0000,0000,0000,,هذا مؤسف، كنّا نحبّه كثيراً
Dialogue: 0,0:23:13.83,0:23:17.07,Default,,0000,0000,0000,,يمكنكم إيجاد كلبٍ آخر لمصادقته
Dialogue: 0,0:23:17.50,0:23:18.78,Default,,0000,0000,0000,,!انظروا! كذاك
Dialogue: 0,0:23:18.78,0:23:20.10,Default,,0000,0000,0000,,!يشبه جون تماماً
Dialogue: 0,0:23:20.40,0:23:22.23,Default,,0000,0000,0000,,!معها حق! لنذهب
Dialogue: 0,0:23:22.23,0:23:23.52,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:23:27.82,0:23:32.48,Default,,0000,0000,0000,,يبدو أنّ لديك كلباً مذهلاً يا آنسة
Dialogue: 0,0:23:32.48,0:23:35.36,Default,,0000,0000,0000,,...أنا من هُواة الكلاب في الواقع
Dialogue: 0,0:23:35.36,0:23:39.38,Default,,0000,0000,0000,,!ما رأيك بأن نتكلم عن الكلاب في المقهى المجاور هناك؟
Dialogue: 0,0:23:39.38,0:23:40.60,Default,,0000,0000,0000,,...كلا، شكراً
Dialogue: 0,0:23:40.60,0:23:41.84,Default,,0000,0000,0000,,!لا تقولي ذلك
Dialogue: 0,0:23:41.84,0:23:44.56,Default,,0000,0000,0000,,!هيّا! هيّا
Dialogue: 0,0:23:47.80,0:23:48.88,Default,,0000,0000,0000,,!انطلق
Dialogue: 0,0:23:48.88,0:23:50.16,Default,,0000,0000,0000,,!وراءه
Dialogue: 0,0:23:51.87,0:23:54.37,Default,,0000,0000,0000,,كوّن علاقةً مع كلب بدل ذلك
Dialogue: 0,0:24:00.24,0:24:04.40,Default,,0000,0000,0000,,!هل استحممتما معاً؟
Dialogue: 0,0:24:04.40,0:24:05.69,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:24:06.24,0:24:07.95,Default,,0000,0000,0000,,كان ذلك مُسلياً
Dialogue: 0,0:24:07.95,0:24:10.56,Default,,0000,0000,0000,,!مسحنا أظهر بعضنا حتّى
Dialogue: 0,0:24:11.14,0:24:12.69,Default,,0000,0000,0000,,نزيف أنف؟ ربما دفع الاستحمام
Dialogue: 0,0:24:12.69,0:24:13.98,Default,,0000,0000,0000,,دمك لرأسك
Dialogue: 0,0:24:14.73,0:24:17.23,Default,,0000,0000,0000,,ستقتلني لو اكتشفت هويّتي حتماً
Dialogue: 0,0:24:17.23,0:24:18.44,Default,,0000,0000,0000,,بلا شكّ
Dialogue: 0,0:24:19.30,0:24:21.43,Default,,0000,0000,0000,,،عندما تُقدم على الانتحار
Dialogue: 0,0:24:21.43,0:24:23.90,Default,,0000,0000,0000,,...تصوّب المسدس نحو رأسك هكذا
Dialogue: 0,0:24:24.53,0:24:25.93,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.93,0:24:29.46,Default,,0000,0000,0000,,جريمة قتل مناسبة لمّ شمل كوغورو\N(الجزء الأوّل)
Dialogue: 0,0:24:45.16,0:24:47.82,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.82,0:24:49.40,Default,,0000,0000,0000,,مسدّس
Dialogue: 0,0:24:49.40,0:24:51.40,Default,,0000,0000,0000,,

