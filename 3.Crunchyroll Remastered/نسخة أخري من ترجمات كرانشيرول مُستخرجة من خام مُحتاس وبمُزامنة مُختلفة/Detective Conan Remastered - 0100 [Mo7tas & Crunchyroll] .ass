Dialogue: 0,0:00:01.20,0:00:04.58,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والقضايا تلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.58,0:00:06.40,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.66,0:00:10.16,Default,,0000,0000,0000,,!اليوم يصل كونان حلقة بثّه المئة! حُبي الأوّل على وشك أن يُكشف
Dialogue: 0,0:00:10.16,0:00:11.78,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.78,0:00:13.79,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.79,0:00:15.83,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.24,0:00:23.91,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:23.91,0:00:30.95,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.72,0:00:39.08,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.08,0:00:46.58,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.58,0:00:59.04,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:00:59.96,0:01:06.33,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.34,0:01:13.22,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.22,0:01:19.58,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.58,0:01:26.57,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:50.88,0:01:56.98,Title,,0000,0000,15,,{\fad(300,0)}قضيّة ذكريات الحُب الأوّل\N(الجزء الأوّل)
Dialogue: 0,0:01:52.05,0:01:55.86,Default,,0000,0000,0000,,قضيّة ذكريات الحُب الأوّل\N(الجزء الأوّل)
Dialogue: 0,0:01:57.93,0:02:03.18,Default,,0000,0000,0000,,شكراً يا ران-كن على تفضّلك\Nبتنظيف منزل شينتشي
Dialogue: 0,0:02:03.18,0:02:06.55,Default,,0000,0000,0000,,ليست مشكلة، فلا شيء لدينا لنفعله
Dialogue: 0,0:02:06.55,0:02:08.11,Default,,0000,0000,0000,,لدينا؟
Dialogue: 0,0:02:08.11,0:02:11.01,Default,,0000,0000,0000,,!لا تقرّري الأمور من تلقاء نفسك
Dialogue: 0,0:02:11.01,0:02:14.72,Default,,0000,0000,0000,,لكن قد يتحوّل إلى منزل أشباح\N...إذا لم ننظّفه
Dialogue: 0,0:02:14.72,0:02:15.78,Default,,0000,0000,0000,,حسناً، لا بأس
Dialogue: 0,0:02:16.26,0:02:22.89,Default,,0000,0000,0000,,لا بدّ أنّ شينتشي بغاية السعادة \Nلامتلاكه حبيبةً لطيفة مثلك
Dialogue: 0,0:02:22.89,0:02:24.43,Default,,0000,0000,0000,,...ليس حقّاً
Dialogue: 0,0:02:24.43,0:02:26.25,Default,,0000,0000,0000,,ألا توافقني يا كونان-كن؟
Dialogue: 0,0:02:26.25,0:02:28.59,Default,,0000,0000,0000,,بـ-بلى
Dialogue: 0,0:02:29.26,0:02:30.46,Default,,0000,0000,0000,,...أيّها الوغد
Dialogue: 0,0:02:31.09,0:02:32.34,Default,,0000,0000,0000,,سنذهب إذاً يا بروفسور
Dialogue: 0,0:02:32.34,0:02:33.93,Default,,0000,0000,0000,,!أجل، أعتمد عليكم
Dialogue: 0,0:02:34.34,0:02:35.39,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:02:36.26,0:02:37.55,Default,,0000,0000,0000,,سأتذكّر هذا
Dialogue: 0,0:02:42.43,0:02:46.69,Default,,0000,0000,0000,,لا تفكّرين بتنظيف هذا المنزل الكبير\Nبأسره، صحيح يا ران؟
Dialogue: 0,0:02:47.14,0:02:49.90,Default,,0000,0000,0000,,حسناً، لنقم بما يسعنا اليوم
Dialogue: 0,0:02:50.14,0:02:53.74,Default,,0000,0000,0000,,ماذا؟ أتقصدين أنّنا سننظّف طوال اليوم؟
Dialogue: 0,0:02:54.64,0:02:56.70,Default,,0000,0000,0000,,أجل، كانت تلك نيّتي
Dialogue: 0,0:02:58.07,0:02:59.17,Default,,0000,0000,0000,,...لا أمل
Dialogue: 0,0:03:01.84,0:03:03.62,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:03:03.62,0:03:08.26,Default,,0000,0000,0000,,لمَ تنظّف سونوكو-ساما منزل شينتشي-كن
Dialogue: 0,0:03:08.26,0:03:10.84,Default,,0000,0000,0000,,في يوم أحد صحوٍ كهذا؟
Dialogue: 0,0:03:10.84,0:03:14.30,Default,,0000,0000,0000,,كان بإمكانك تجاهله وحسب، لكنّك ذهبتِ \N!للبروفسور وطلبتِ المفتاح البديل حتّى
Dialogue: 0,0:03:14.59,0:03:18.22,Default,,0000,0000,0000,,آسفة، اعتقدتُ أنّ المكان سيكون مليئاً بالغبار
Dialogue: 0,0:03:18.22,0:03:20.30,Default,,0000,0000,0000,,فتنظيفه بمفردي أمرٌ صعب
Dialogue: 0,0:03:21.34,0:03:22.43,Default,,0000,0000,0000,,حسناً، حسناً
Dialogue: 0,0:03:26.34,0:03:29.84,Default,,0000,0000,0000,,سونوكو، عليك تنظيف رفوف الكتب قبل المسح
Dialogue: 0,0:03:29.84,0:03:30.61,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:30.84,0:03:33.80,Default,,0000,0000,0000,,تعرفين، يُقال أنّ التنظيف يجب\Nأن يبدأ من الأعلى
Dialogue: 0,0:03:33.80,0:03:37.16,Default,,0000,0000,0000,,!كما عليك اتّباع مربّعات البلاط عند مسح الأرض
Dialogue: 0,0:03:37.16,0:03:39.49,Default,,0000,0000,0000,,...تتكلّمين كمُسنّة
Dialogue: 0,0:03:42.34,0:03:45.59,Default,,0000,0000,0000,,يُفترض أن تهتمّ فتيات\Nهذه الأيام بصيد الرجال
Dialogue: 0,0:03:45.59,0:03:48.92,Default,,0000,0000,0000,,...وتجربة الحُبّ الصافي، والحُب الأوّل وما إلى ذلك
Dialogue: 0,0:03:49.43,0:03:52.63,Default,,0000,0000,0000,,لكنّي هنا تحت أكوام الغبار\N...لأجل مهووس التحرّي ذاك
Dialogue: 0,0:03:52.93,0:03:55.59,Default,,0000,0000,0000,,أنا تعيسة حقّاً
Dialogue: 0,0:03:55.59,0:03:58.05,Default,,0000,0000,0000,,اعذراني
Dialogue: 0,0:03:59.22,0:04:02.39,Default,,0000,0000,0000,,...إذاً، بذكر الحُب الأوّل
Dialogue: 0,0:04:02.64,0:04:03.43,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:04:04.09,0:04:07.19,Default,,0000,0000,0000,,كيف كان حُب شينتشي الأوّل يا ترى؟
Dialogue: 0,0:04:08.94,0:04:12.93,Default,,0000,0000,0000,,لا بدّ أنّه مرّ بتجربة حُب\N!واحدة أو اثنتين
Dialogue: 0,0:04:12.93,0:04:18.64,Default,,0000,0000,0000,,لا أدري، إنّه بليدٌ عندما يتعلّق الأمر بهذه المواضيع
Dialogue: 0,0:04:18.64,0:04:24.62,Default,,0000,0000,0000,,،لكن بوضع أمّه الجميلة في الاعتبار\N...فربما كانت فنّانةً على التلفاز، أو
Dialogue: 0,0:04:24.93,0:04:30.80,Default,,0000,0000,0000,,بالمناسبة، كنتما معاً طوال الوقت في صغركما، صحيح؟
Dialogue: 0,0:04:30.80,0:04:31.93,Default,,0000,0000,0000,,...بلى
Dialogue: 0,0:04:31.93,0:04:34.84,Default,,0000,0000,0000,,فوق ذلك، أنتِ لطيفة وقويّة
Dialogue: 0,0:04:35.47,0:04:39.30,Default,,0000,0000,0000,,!قد تكونين أنت حبّ شينتشي-كن الأوّل
Dialogue: 0,0:04:39.30,0:04:40.09,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:40.09,0:04:41.55,Default,,0000,0000,0000,,!أنت، أنت
Dialogue: 0,0:04:42.01,0:04:46.93,Default,,0000,0000,0000,,مستحيل، كنّا نلهو لا أكثر\Nعندما كنّا صغاراً
Dialogue: 0,0:04:47.68,0:04:50.35,Default,,0000,0000,0000,,...لكن هناك علاقتك السابقة أيضاً يا ران
Dialogue: 0,0:04:50.68,0:04:54.32,Default,,0000,0000,0000,,ماذا؟ ألم يكن شينتشي-كن حبّك الأوّل؟
Dialogue: 0,0:04:56.76,0:04:59.51,Default,,0000,0000,0000,,!ا-انتظري! لا تختلقي من تلقاء نفسك
Dialogue: 0,0:04:59.51,0:05:03.95,Default,,0000,0000,0000,,ماذا؟ احمرارك يظهر خلاف ذلك\Nأيّتها الفتاة ذات العشرين وجهاً
Dialogue: 0,0:05:04.39,0:05:07.66,Default,,0000,0000,0000,,!يكفي يا سونوكو! توقّفي وإلّا سأغضب
Dialogue: 0,0:05:08.09,0:05:10.12,Default,,0000,0000,0000,,صـ-صدقاً؟
Dialogue: 0,0:05:10.76,0:05:12.34,Default,,0000,0000,0000,,ماذا؟ من قد يكون؟
Dialogue: 0,0:05:12.34,0:05:15.26,Default,,0000,0000,0000,,يا لحماقتك، إنّه شينتشي-كن بالطبع
Dialogue: 0,0:05:15.26,0:05:17.26,Default,,0000,0000,0000,,لا، ذلك مستحيل
Dialogue: 0,0:05:18.09,0:05:21.14,Default,,0000,0000,0000,,لكن هل سيقرع الجرس قبل دخول منزله؟
Dialogue: 0,0:05:21.14,0:05:24.22,Default,,0000,0000,0000,,!لا بدّ أنّه سمع أمرنا من البروفسور وأراد مفاجأتنا
Dialogue: 0,0:05:24.22,0:05:26.18,Default,,0000,0000,0000,,...ليس صحيحاً
Dialogue: 0,0:05:26.59,0:05:30.10,Default,,0000,0000,0000,,لـ-لكن لم يقل شينتشي شيئاً عن العودة للبيت
Dialogue: 0,0:05:30.10,0:05:33.86,Default,,0000,0000,0000,,!ما الذي يحرجك هكذا؟ اذهبي واستقبليه
Dialogue: 0,0:05:34.34,0:05:36.34,Default,,0000,0000,0000,,إنّه أمير حبّك الأوّل، أليس كذلك؟
Dialogue: 0,0:05:36.34,0:05:40.52,Default,,0000,0000,0000,,!أخبرتك! الأمر ليس هكذا
Dialogue: 0,0:05:41.14,0:05:41.81,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:42.76,0:05:44.45,Default,,0000,0000,0000,,أأنتِ صديقة لكودو-كن؟
Dialogue: 0,0:05:45.14,0:05:46.16,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:05:46.59,0:05:49.09,Default,,0000,0000,0000,,...ماذا؟ أليست هذه
Dialogue: 0,0:05:49.84,0:05:53.47,Default,,0000,0000,0000,,المعذرة، أأنتِ أسامي سينباي؟
Dialogue: 0,0:05:53.47,0:05:54.37,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:05:54.37,0:05:56.59,Default,,0000,0000,0000,,تعرفينها يا سونوكو؟
Dialogue: 0,0:05:56.59,0:05:58.09,Default,,0000,0000,0000,,ما الذي تقولينه؟
Dialogue: 0,0:05:58.09,0:06:01.76,Default,,0000,0000,0000,,كانت رئيسة مجلس الطلبة عندما كنّا\N!في السنة الأولى في متوسّطة تيتان
Dialogue: 0,0:06:01.76,0:06:03.79,On Top,,0000,0000,0000,,!أوتشيدا أسامي سينباي
Dialogue: 0,0:06:01.76,0:06:05.18,CharCard,,0000,0000,0004,,{\fad(300,0)}(أوتشيدا أسامي (18\Nطالبة سنة أولى، كليّة الأدب في جامعة توتو
Dialogue: 0,0:06:06.15,0:06:10.94,Default,,0000,0000,0000,,هكذا إذاً، كودو-كن غائبٌ عن منزله\Nلفترة بسبب بعض القضايا؟
Dialogue: 0,0:06:10.94,0:06:14.23,Default,,0000,0000,0000,,لذا كانت تجيبني آلة الردّ باستمرار
Dialogue: 0,0:06:14.23,0:06:17.69,Default,,0000,0000,0000,,المعذرة، أشعر كأنّي جعلتك\N...تساعديننا في التنظيف
Dialogue: 0,0:06:17.69,0:06:20.25,Default,,0000,0000,0000,,ليست مشكلة، فلا شيء لديّ لأفعله
Dialogue: 0,0:06:20.69,0:06:23.46,Default,,0000,0000,0000,,بالمناسبة يا سينباي، لمَ أردتِ لقاء شينتشي-كن؟
Dialogue: 0,0:06:24.52,0:06:29.85,Default,,0000,0000,0000,,سيستأجر أصدقائي في نادي التحرّي\Nفي الجامعة نُزلاً
Dialogue: 0,0:06:29.85,0:06:32.17,Default,,0000,0000,0000,,ويقيمون حفلةً لعيد ميلادي نهاية هذا الأسبوع
Dialogue: 0,0:06:32.77,0:06:36.32,Default,,0000,0000,0000,,أردتُ دعوة كودو-كن
Dialogue: 0,0:06:37.23,0:06:42.10,Default,,0000,0000,0000,,بما أنّه متحرٍّ شهير وزميل قديم لي\Nفي نادي كرة القدم لمتوسّطة تيتان
Dialogue: 0,0:06:42.85,0:06:46.40,Default,,0000,0000,0000,,...لكنّي أرسلت الرسالة قبل فترة
Dialogue: 0,0:06:46.40,0:06:49.52,Default,,0000,0000,0000,,لم يقل شيئاً قبل مغادرته منزله؟
Dialogue: 0,0:06:49.52,0:06:50.61,Default,,0000,0000,0000,,...ليس تماماً
Dialogue: 0,0:06:50.90,0:06:53.03,Default,,0000,0000,0000,,!تبّاً! نسيت
Dialogue: 0,0:06:53.27,0:06:57.85,Default,,0000,0000,0000,,فهمت، كنت متأكّدة أنّه سيأتي
Dialogue: 0,0:06:57.85,0:07:02.00,Default,,0000,0000,0000,,أتساءل إذا نسي ذاك الاعتراف\N...قبل أربعة أعوام
Dialogue: 0,0:07:02.00,0:07:03.46,Default,,0000,0000,0000,,الاعتراف؟
Dialogue: 0,0:07:03.46,0:07:07.19,Default,,0000,0000,0000,,رغم أنّي لا أستطيع استغراب نسياته
Dialogue: 0,0:07:07.19,0:07:09.60,Default,,0000,0000,0000,,...فزواله مع الوقت
Dialogue: 0,0:07:11.29,0:07:12.76,Default,,0000,0000,0000,,طبيعيّ للحُب الأوّل
Dialogue: 0,0:07:13.40,0:07:14.47,Default,,0000,0000,0000,,!حُب أوّل؟
Dialogue: 0,0:07:18.69,0:07:22.31,Default,,0000,0000,0000,,كانت حُبّ شينتشي الأوّل؟
Dialogue: 0,0:07:23.69,0:07:26.83,Default,,0000,0000,0000,,فهمت، توضّحت الصورة لي
Dialogue: 0,0:07:27.94,0:07:30.77,Default,,0000,0000,0000,,كان الجميع يتكلّمون في سنتنا الأولى في المتوسّطة
Dialogue: 0,0:07:30.77,0:07:33.49,Default,,0000,0000,0000,,عن مغازلة صبيّ في السنة الأولى لأسامي سينباي
Dialogue: 0,0:07:33.49,0:07:37.27,Default,,0000,0000,0000,,!وكان ذاك المُتجرّئ هو كودو شينتشي إذاً؟
Dialogue: 0,0:07:37.27,0:07:41.12,Default,,0000,0000,0000,,لم تكن مغازلة! بل اعترافاً حقيقيّاً
Dialogue: 0,0:07:41.21,0:07:42.54,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:07:43.27,0:07:44.50,Default,,0000,0000,0000,,...ثمّ
Dialogue: 0,0:07:44.63,0:07:45.96,Default,,0000,0000,0000,,!المعذرة
Dialogue: 0,0:07:47.19,0:07:51.19,Default,,0000,0000,0000,,،إذا كان شينتشي-نيتشان لن يأتي\Nفلمَ لا تقومين بدعوة شخص آخر
Dialogue: 0,0:07:51.19,0:07:52.17,Default,,0000,0000,0000,,معك حقّ
Dialogue: 0,0:07:52.17,0:07:54.98,Default,,0000,0000,0000,,ماذا عنّا إذاً؟
Dialogue: 0,0:07:54.98,0:07:59.35,Default,,0000,0000,0000,,!حللنا بضعة قضايا بدورنا
Dialogue: 0,0:07:59.35,0:08:00.64,Default,,0000,0000,0000,,مهلك يا سونوكو
Dialogue: 0,0:08:01.19,0:08:05.35,Default,,0000,0000,0000,,أين المشكلة؟ قد نستطيع الإيقاع\N!ببعض شباب توتو الحيويين
Dialogue: 0,0:08:05.69,0:08:10.65,Default,,0000,0000,0000,,أجل، قد يسرّ أصدقائي الشبّان إذا\Nحضرت فتيات في الثانويّة
Dialogue: 0,0:08:10.65,0:08:14.73,Default,,0000,0000,0000,,كما أنّه بدعوتك لنا، فسيظهر ذاك الشخص\N!أيضاً بلا شك
Dialogue: 0,0:08:14.73,0:08:16.12,Default,,0000,0000,0000,,ذاك الشخص؟
Dialogue: 0,0:08:16.12,0:08:18.32,Default,,0000,0000,0000,,...سـ-سونوكو، أتقصدين
Dialogue: 0,0:08:18.69,0:08:22.65,Default,,0000,0000,0000,,!أجل، المتحرّي العظيم الغنّي عن التعريف
Dialogue: 0,0:08:24.52,0:08:28.12,Default,,0000,0000,0000,,لقاء لنادي دراسة التحرّي لجامعة توتو؟
Dialogue: 0,0:08:28.12,0:08:29.73,Default,,0000,0000,0000,,!انسوا الأمر
Dialogue: 0,0:08:29.73,0:08:32.79,Default,,0000,0000,0000,,!لا يمكنني السماح لأطفال بالمبيت خارجاً لوحدهم
Dialogue: 0,0:08:33.02,0:08:35.27,Default,,0000,0000,0000,,لكنّك مدعوّ أيضاً يا أبي
Dialogue: 0,0:08:35.27,0:08:39.26,Default,,0000,0000,0000,,!أنا مشغول! لا وقت لديّ لهذا العبث
Dialogue: 0,0:08:41.48,0:08:47.98,Default,,0000,0000,0000,,معك حقّ، لا يمكنك يا عمّ بصفتك\Nمتحرّياَ عظيماً اللهو في عطلة نهاية أسبوع
Dialogue: 0,0:08:48.48,0:08:56.15,Default,,0000,0000,0000,,،لكن بالنسبة لنادي دراسة المتحرّي \Nموري كوغورو-سان أشبه بإله لهم
Dialogue: 0,0:08:56.15,0:09:00.44,Default,,0000,0000,0000,,!جميعهم متشوّقون لسماع قصص المتحرّي منقطع النظير
Dialogue: 0,0:09:00.44,0:09:03.44,Default,,0000,0000,0000,,كما أنّه ستحضر فتيات جميلات كثيرات بمن فيهنّ
Dialogue: 0,0:09:03.44,0:09:06.20,Default,,0000,0000,0000,,أوتشيدا أسامي سينباي التي تحمل\N!لقب آنسة توتو
Dialogue: 0,0:09:06.56,0:09:08.12,Default,,0000,0000,0000,,آ-آنسة توتو؟
Dialogue: 0,0:09:08.52,0:09:14.19,Default,,0000,0000,0000,,...لكن إذا كنت مشغولاً، فسنتخلّى عن فكرة الذهاب
Dialogue: 0,0:09:15.35,0:09:19.19,Default,,0000,0000,0000,,حسناً، ربما يمكنني إعادة ترتيب أشغالي
Dialogue: 0,0:09:19.19,0:09:21.59,Default,,0000,0000,0000,,فسأرافقكم بصفتي وصيّكم
Dialogue: 0,0:09:22.27,0:09:26.60,Default,,0000,0000,0000,,كما أنّي سأشعر بالأسف إذا خيّبتُ آمال الشبّان
Dialogue: 0,0:09:26.60,0:09:27.81,Default,,0000,0000,0000,,!الواعدين لنادي دراسة التحرّي
Dialogue: 0,0:09:28.40,0:09:35.02,Default,,0000,0000,0000,,إذا كانت قصصي عن القضايا التي حللتها\N،قد تفيدهم بأيّ شكل
Dialogue: 0,0:09:35.02,0:09:38.15,Default,,0000,0000,0000,,!فواجبي كمتحرٍّ عظيم مساعدتهم
Dialogue: 0,0:09:39.40,0:09:42.11,Default,,0000,0000,0000,,...يا للشخصيّة سهلة الفهم
Dialogue: 0,0:09:44.06,0:09:46.24,Default,,0000,0000,0000,,...آنسة توتو
Dialogue: 0,0:09:55.55,0:09:58.07,Default,,0000,0000,0000,,!حسناً، وصلنا أخيراً
Dialogue: 0,0:09:58.07,0:10:00.65,Default,,0000,0000,0000,,إذاً، أين النُزل؟
Dialogue: 0,0:10:00.65,0:10:01.52,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:10:01.82,0:10:05.42,Default,,0000,0000,0000,,...محطّة توقّف الحافلة هنا، لذا نصعد ثم نذهب يميناً
Dialogue: 0,0:10:06.74,0:10:07.98,Default,,0000,0000,0000,,!هناك
Dialogue: 0,0:10:08.81,0:10:12.99,Default,,0000,0000,0000,,!من هناك؟ لا يفصلنا الكثير عن آنسة توتو! هيّا بنا
Dialogue: 0,0:10:12.99,0:10:15.57,Default,,0000,0000,0000,,!أجل! سأحصل على شاب توتو
Dialogue: 0,0:10:21.24,0:10:23.62,Default,,0000,0000,0000,,...هذا يُشرّفني
Dialogue: 0,0:10:23.96,0:10:28.71,Default,,0000,0000,0000,,!الكلام والشراب مع عقول جامعة توتو اليافعة
Dialogue: 0,0:10:29.03,0:10:33.57,Default,,0000,0000,0000,,كما أنّكم جميعاً شبّان وسيمون وفتيات جميلات فوق ذلك
Dialogue: 0,0:10:33.57,0:10:35.13,Default,,0000,0000,0000,,...أنت تبالغ
Dialogue: 0,0:10:35.13,0:10:41.10,CharCard,,0000,0000,0004,,{\fs(22)\fad(300,0)}(ساواي مانابو (22\Nطالب سنة رابعة، كليّة الأدب في جامعة توتو\Nرئيس نادي دراسة التحرّي
Dialogue: 0,0:10:35.45,0:10:37.36,On Top,,0000,0000,0000,,كما أتوقّع من المتحرّي العظيم
Dialogue: 0,0:10:37.36,0:10:39.32,On Top,,0000,0000,0000,,تعرف كيف تتحكّم بقلوب الناس
Dialogue: 0,0:10:39.32,0:10:41.10,On Top,,0000,0000,0000,,بمجرّد الكلمات
Dialogue: 0,0:10:41.10,0:10:46.81,CharCard,,0140,0000,0004,,{\fs(22)\fad(300,0)}(هاياساكا توموكو (21\Nطالبة سنة رابعة، كليّة الأدب في جامعة توتو\Nنائبة رئيس نادي دراسة التحرّي
Dialogue: 0,0:10:41.65,0:10:44.20,On Top,,0000,0000,0000,,ماذا؟ ألا تشير لنفسك؟
Dialogue: 0,0:10:44.20,0:10:46.82,On Top,,0000,0000,0000,,أيّها الفتى العابث ساواي-كن
Dialogue: 0,0:10:46.82,0:10:53.53,CharCard,,0000,0210,0004,,{\fs(22)\fad(300,0)}(نوغوتشي شيباهيسا (20\Nطالب سنة ثانية، كليّة الأدب في جامعة توتو
Dialogue: 0,0:10:46.82,0:10:53.53,CharCard,,0204,0000,0004,,{\fs(22)\fad(300,0)}(ميازاكي تشيكا (19\Nطالبة سنة ثانية، كليّة الأدب في جامعة توتو
Dialogue: 0,0:10:46.97,0:10:49.86,On Top,,0000,0000,0000,,سمعتُ يا رئيس أنّك جعلت فتاة
Dialogue: 0,0:10:49.86,0:10:51.70,On Top,,0000,0000,0000,,!في السنة الأولى تبكي
Dialogue: 0,0:10:51.70,0:10:53.53,On Top,,0000,0000,0000,,ماذا؟! أهذا صحيح؟
Dialogue: 0,0:10:53.82,0:10:57.86,Default,,0000,0000,0000,,!مهلكما! هذه حفلة عيد ميلاد أسامي اليوم
Dialogue: 0,0:10:57.86,0:10:59.70,Default,,0000,0000,0000,,ليس وقت محاكمتي
Dialogue: 0,0:10:59.70,0:11:01.65,Default,,0000,0000,0000,,صحيح، كما أنّها للاحتفال بجائزة
Dialogue: 0,0:11:01.65,0:11:06.21,Default,,0000,0000,0000,,الوافد الجديد" التي فازت بها روايتها مؤخراً"
Dialogue: 0,0:11:06.99,0:11:08.65,Default,,0000,0000,0000,,كان ذلك مؤسفاً يا موريموتو
Dialogue: 0,0:11:08.65,0:11:11.74,Default,,0000,0000,0000,,سمعت أنّك وصلت مرحلة الاختيار النهائيّ أيضاً
Dialogue: 0,0:11:11.74,0:11:13.17,Default,,0000,0000,0000,,لم يكن باليد حيلة
Dialogue: 0,0:11:13.21,0:11:17.38,CharCard,,0000,0000,0004,,{\fs(22)\fad(300,0)}(موريموتو يوشينوبو (22\Nطالب سنة ثالثة، كليّة الأدب في جامعة توتو
Dialogue: 0,0:11:13.45,0:11:15.36,On Top,,0000,0000,0000,,،خسرت أمام أسامي-كن
Dialogue: 0,0:11:15.36,0:11:17.38,On Top,,0000,0000,0000,,!أكثر روائيّة واعدة في كليّتنا
Dialogue: 0,0:11:17.74,0:11:19.40,Default,,0000,0000,0000,,،بذكر الخسارة
Dialogue: 0,0:11:19.40,0:11:24.49,Default,,0000,0000,0000,,خسرتُ أمام ثنائيّها في مسابقة\Nكرة المضرب لكليّة الأدب
Dialogue: 0,0:11:24.49,0:11:27.40,Default,,0000,0000,0000,,!وحصلت على لقب "آنسة توتو" في سنتها الأولى
Dialogue: 0,0:11:27.40,0:11:29.35,Default,,0000,0000,0000,,...أنا لم أصل الجولة التمهيدية حتّى
Dialogue: 0,0:11:29.82,0:11:34.82,Default,,0000,0000,0000,,أنا أحترمها حقّاً، فهي لا تظهر أيّ غرور\Nرغم مقدرتها على فعل كلّ شيء
Dialogue: 0,0:11:34.82,0:11:37.40,Default,,0000,0000,0000,,!إنّها طاهية بارعة أيضاً
Dialogue: 0,0:11:37.40,0:11:40.57,Default,,0000,0000,0000,,...بالمناسبة، فطيرة الليمون خاصّتها ليست هنا
Dialogue: 0,0:11:40.57,0:11:42.61,Default,,0000,0000,0000,,!تخبزها مع ران الآن
Dialogue: 0,0:11:42.61,0:11:46.00,Default,,0000,0000,0000,,ماذا؟ قالت أسامي-كن أنّها ستخبزها وتجلبها هنا
Dialogue: 0,0:11:46.49,0:11:48.00,Default,,0000,0000,0000,,!نعتذر على الإطالة
Dialogue: 0,0:11:48.00,0:11:49.96,Default,,0000,0000,0000,,!كنّا بالانتظار
Dialogue: 0,0:11:48.00,0:11:49.96,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:11:52.42,0:11:53.37,Default,,0000,0000,0000,,...عجباً
Dialogue: 0,0:11:53.37,0:11:54.24,Default,,0000,0000,0000,,إنّها متهالكة
Dialogue: 0,0:11:54.24,0:11:56.59,Default,,0000,0000,0000,,أصنعتِ هذه حقّاً يا أسامي؟
Dialogue: 0,0:11:56.74,0:12:00.05,Default,,0000,0000,0000,,كلا، بل أنا، كانت مرّتي الأوّل
Dialogue: 0,0:12:00.32,0:12:02.32,Default,,0000,0000,0000,,ماذا عن فطيرتك يا أسامي-كن؟
Dialogue: 0,0:12:02.32,0:12:05.32,Default,,0000,0000,0000,,نسيتُ جلبها
Dialogue: 0,0:12:05.32,0:12:10.06,Default,,0000,0000,0000,,فقالت أنّها ستصنع واحدة مكاني، فطلبتُ منها
Dialogue: 0,0:12:10.32,0:12:13.56,Default,,0000,0000,0000,,يا إلهي، لمَ تصنعين أشياءً لستِ معتادةً عليها؟
Dialogue: 0,0:12:13.56,0:12:14.78,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:12:14.78,0:12:18.20,Default,,0000,0000,0000,,حسنٌ، حسنٌ، أجّلوا تذمّركم لبعد تذوّقها
Dialogue: 0,0:12:18.20,0:12:19.53,Default,,0000,0000,0000,,هيّا، كلوا
Dialogue: 0,0:12:22.15,0:12:23.49,Default,,0000,0000,0000,,...ماذا؟ هذه الفطيرة
Dialogue: 0,0:12:24.45,0:12:26.20,Default,,0000,0000,0000,,...إنّها حلوة قليلاً، لكن
Dialogue: 0,0:12:28.70,0:12:30.08,Default,,0000,0000,0000,,!لذيذة
Dialogue: 0,0:12:31.67,0:12:32.78,Default,,0000,0000,0000,,!أنا أيضاً
Dialogue: 0,0:12:32.78,0:12:34.04,Default,,0000,0000,0000,,!دعوني أجرّب
Dialogue: 0,0:12:36.57,0:12:39.05,Default,,0000,0000,0000,,!معكم حقّ! إنّها جيّدة
Dialogue: 0,0:12:40.90,0:12:44.97,Default,,0000,0000,0000,,!بالفعل! مظهرها غير جذّاب، لكنّها لذيذة
Dialogue: 0,0:12:46.28,0:12:47.68,Default,,0000,0000,0000,,هذا مُبهر حقّاً
Dialogue: 0,0:12:49.28,0:12:49.89,Default,,0000,0000,0000,,!لذيذة، لذيذة
Dialogue: 0,0:12:50.65,0:12:53.49,Default,,0000,0000,0000,,رأيتِ؟ المهمّ في الطبخ هو المحتوى
Dialogue: 0,0:12:53.49,0:12:57.11,Default,,0000,0000,0000,,بعدما تأكل، لن تعرف كيف كان شكلها حتّى
Dialogue: 0,0:13:04.74,0:13:07.99,Default,,0000,0000,0000,,!%تصيب استنتاجاتي في حلّ كلّ القضايا 100
Dialogue: 0,0:13:08.28,0:13:10.65,Default,,0000,0000,0000,,وحللتِ القضيّة إذاً؟
Dialogue: 0,0:13:10.65,0:13:11.46,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:13:11.46,0:13:14.67,Default,,0000,0000,0000,,كنتُ أنا من حلّها كلّها
Dialogue: 0,0:13:15.11,0:13:17.49,Default,,0000,0000,0000,,!يا للكعكة الجميلة
Dialogue: 0,0:13:18.49,0:13:21.15,Default,,0000,0000,0000,,!ذهبتُ لغينزا لجلبها
Dialogue: 0,0:13:21.15,0:13:22.70,Default,,0000,0000,0000,,سأبحث عن أعواد ثقاب
Dialogue: 0,0:13:22.70,0:13:26.65,Default,,0000,0000,0000,,لا داعي، استعرتُ قدّاحة ساواي-كن
Dialogue: 0,0:13:30.99,0:13:36.15,Default,,0000,0000,0000,,مشاهدة إشعال شمعات كعكة عيد ميلاد\N!مثيرٌ مهما كان عمرك
Dialogue: 0,0:13:36.15,0:13:38.65,Default,,0000,0000,0000,,ذلك حتّى تصلين العشرين فقط
Dialogue: 0,0:13:38.65,0:13:40.36,Default,,0000,0000,0000,,ماذا؟ أهذا صحيح؟
Dialogue: 0,0:13:40.82,0:13:47.32,Default,,0000,0000,0000,,أجل، بعدما تتجاوزين العشرين، تبدئين بكره\Nكلّ شمعة إضافية كلّ سنة
Dialogue: 0,0:13:48.30,0:13:49.54,Default,,0000,0000,0000,,...فهمت
Dialogue: 0,0:13:52.50,0:13:57.42,On Top,,0000,0000,0000,,.مُبارك، أدعو لك بنجاحات مستقبلية أكبر\Nبروفسور كليّة الأدب، جامعة توتو\Nتاكامورا ماساوا
Dialogue: 0,0:13:54.49,0:13:55.62,Default,,0000,0000,0000,,!ها قد أتت
Dialogue: 0,0:13:57.42,0:13:59.82,Default,,0000,0000,0000,,!مع منتصف الليل تماماً، كما اتّفقنا
Dialogue: 0,0:13:59.82,0:14:03.13,Default,,0000,0000,0000,,رأيتِ؟ استئجار نُزل بآلة فاكس\Nكان خياراً حسناً
Dialogue: 0,0:14:03.61,0:14:06.40,Default,,0000,0000,0000,,!وصلت يا أسامي! رسالة تاكامورا سينسي
Dialogue: 0,0:14:06.40,0:14:07.09,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:08.65,0:14:10.31,Default,,0000,0000,0000,,يبدو أنّها نائمة
Dialogue: 0,0:14:10.95,0:14:13.57,Default,,0000,0000,0000,,لا يُعقل، ماذا نفعل بهذه الكعكة؟
Dialogue: 0,0:14:13.57,0:14:17.00,Default,,0000,0000,0000,,كما ألم نكن سنذهب لحجرة الكاراوكي\Nبقرب المحطّة تالياً؟
Dialogue: 0,0:14:17.00,0:14:19.03,Default,,0000,0000,0000,,بلى، حجزتُ سلفاً
Dialogue: 0,0:14:19.03,0:14:20.58,Default,,0000,0000,0000,,ليس باليد حيلة
Dialogue: 0,0:14:20.58,0:14:24.50,Default,,0000,0000,0000,,لنترك الكعكة للغد ونذهب لحجرة الكاراوكي بمفردنا
Dialogue: 0,0:14:25.12,0:14:28.61,Default,,0000,0000,0000,,،أجل، لا خيار أمامنا\Nفلنفعل ذلك
Dialogue: 0,0:14:34.66,0:14:40.09,On Top,,0000,0000,0000,,غرفة الكاراوكي
Dialogue: 0,0:14:36.66,0:14:43.56,Default,,0000,0000,0000,,♪ يبدأ اللغز ينحلّ ♪
Dialogue: 0,0:14:43.56,0:14:45.21,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:14:47.20,0:14:50.50,Default,,0000,0000,0000,,اسمع يا فتى، ما رأيك بغناء\Nتو ميكس معي تالياً؟
Dialogue: 0,0:14:50.50,0:14:52.19,Default,,0000,0000,0000,,!لـ-لا داعي، سأمتنع
Dialogue: 0,0:14:52.19,0:14:54.24,Default,,0000,0000,0000,,!سأغنّي أنا تالياً
Dialogue: 0,0:14:54.87,0:14:56.54,Default,,0000,0000,0000,,ما الخطب يا ران؟
Dialogue: 0,0:14:57.58,0:14:59.62,Default,,0000,0000,0000,,كان وجهك عابساً
Dialogue: 0,0:14:59.62,0:15:02.20,Default,,0000,0000,0000,,البتّة، لست عابسة
Dialogue: 0,0:15:04.54,0:15:07.66,Default,,0000,0000,0000,,هل أخمّن ما الذي كنتِ تفكّرين به؟
Dialogue: 0,0:15:07.91,0:15:10.66,Default,,0000,0000,0000,,...ذكيّة وجميلة، متفوّقة في الرياضة والدراسة
Dialogue: 0,0:15:10.66,0:15:15.95,Default,,0000,0000,0000,,لطيفة وذات شعبية بين الآخرين\Nوهي الرقم 1 في أيّ ما تفعله
Dialogue: 0,0:15:15.95,0:15:18.13,Default,,0000,0000,0000,,أنتِ تفكّرين بأسامي سينباي، أليس صحيحاً؟
Dialogue: 0,0:15:18.13,0:15:20.09,Default,,0000,0000,0000,,ماذا؟! كيف عرفتِ؟
Dialogue: 0,0:15:20.09,0:15:25.06,Default,,0000,0000,0000,,!"مكتوبٌ على وجهك! "أنا لستُ ندّةً لها
Dialogue: 0,0:15:25.79,0:15:29.33,Default,,0000,0000,0000,,رغم أنّه لا يمكنك لوم شينتشي-كن\Nعلى الوقوع في حبّها
Dialogue: 0,0:15:29.33,0:15:32.02,Default,,0000,0000,0000,,فقد كانت مديرة كرة القدم
Dialogue: 0,0:15:35.37,0:15:40.12,Default,,0000,0000,0000,,!لكن لا تقلقي حيال الأمر! لا بدّ أنّها رفضته
Dialogue: 0,0:15:40.12,0:15:42.07,Default,,0000,0000,0000,,!كما أنّكما صديقا طفولة
Dialogue: 0,0:15:43.29,0:15:48.00,Default,,0000,0000,0000,,أكنتِ تعرفين يا سونوكو أنّ \Nشينتشي كان يحبّ فطائر الليمون؟
Dialogue: 0,0:15:49.79,0:15:53.47,Default,,0000,0000,0000,,سمعتُ ذلك لأوّل المرّة اليوم\Nمن أسامي سينباي
Dialogue: 0,0:15:54.75,0:15:57.41,Default,,0000,0000,0000,,ماذا؟ يحبّ شينتشي فطيرة الليمون؟
Dialogue: 0,0:15:57.41,0:16:00.04,Default,,0000,0000,0000,,أجل، إنّها المفضّلة له
Dialogue: 0,0:16:00.24,0:16:04.41,Default,,0000,0000,0000,,أخبرتُ الجميع أنّي سأخبز واحدة\Nلأنّني ظننت أنّه سيأتي اليوم
Dialogue: 0,0:16:04.41,0:16:05.55,Default,,0000,0000,0000,,فجلبتُ هذه
Dialogue: 0,0:16:05.87,0:16:08.21,Default,,0000,0000,0000,,...ماذا؟ شينتشي إذاً
Dialogue: 0,0:16:09.79,0:16:11.45,Default,,0000,0000,0000,,يحبّ هذه؟
Dialogue: 0,0:16:12.45,0:16:16.12,Default,,0000,0000,0000,,أتريدين أن أعلّمك كيف تصنعينها؟
Dialogue: 0,0:16:17.70,0:16:19.87,Default,,0000,0000,0000,,لا فرصة لي
Dialogue: 0,0:16:19.87,0:16:23.70,Default,,0000,0000,0000,,فهي تعرف أشياء كثيرة عن شينتشي لا أعرفها
Dialogue: 0,0:16:24.62,0:16:25.66,Default,,0000,0000,0000,,...ران
Dialogue: 0,0:16:29.37,0:16:34.08,Default,,0000,0000,0000,,!فلتبتهجي يا فتاة! أنتِ تتحلّين بميزاتك الخاصّة
Dialogue: 0,0:16:34.75,0:16:36.00,Default,,0000,0000,0000,,مثل ماذا؟
Dialogue: 0,0:16:36.00,0:16:40.92,Default,,0000,0000,0000,,تعرفين، مهارتك في الكاراتيه\N!وجسمك الصلب الذي صقلتِه
Dialogue: 0,0:16:41.20,0:16:43.25,Default,,0000,0000,0000,,!ما هذا الكلام؟
Dialogue: 0,0:16:43.25,0:16:44.23,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:16:48.45,0:16:49.35,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:16:49.90,0:16:52.37,Default,,0000,0000,0000,,أصبح العدد أقلّ بكثير
Dialogue: 0,0:16:52.37,0:16:55.58,Default,,0000,0000,0000,,لأنّك أطلت في الخروج من الحمّام
Dialogue: 0,0:16:55.58,0:16:58.27,Default,,0000,0000,0000,,فذهب الجميع لدورة المياه عند محطّة القطار
Dialogue: 0,0:16:58.62,0:17:00.79,Default,,0000,0000,0000,,!أعتذر على ذلك
Dialogue: 0,0:17:00.79,0:17:02.70,Default,,0000,0000,0000,,ألديك سجائري؟
Dialogue: 0,0:17:02.70,0:17:04.91,Default,,0000,0000,0000,,اشتريتُها من متجر التموينات بالجوار
Dialogue: 0,0:17:05.37,0:17:06.62,Default,,0000,0000,0000,,!لقد رجعوا
Dialogue: 0,0:17:07.04,0:17:08.58,Default,,0000,0000,0000,,ماذا؟ أين نوغوتشي-كن؟
Dialogue: 0,0:17:09.00,0:17:12.54,Default,,0000,0000,0000,,لا يزال يمشي أمام المحطّة\Nمحاولاً أن يصحو من ثمله
Dialogue: 0,0:17:13.45,0:17:15.41,Default,,0000,0000,0000,,...تجاوزت الساعة الثالثة
Dialogue: 0,0:17:15.41,0:17:18.75,Default,,0000,0000,0000,,ألا يجدر بنا العودة؟ فقد تركنا المكان والفوضى تعمّه
Dialogue: 0,0:17:19.45,0:17:21.67,Default,,0000,0000,0000,,...لننظّفه سريعاً ونخلد للـ
Dialogue: 0,0:17:23.79,0:17:26.30,Default,,0000,0000,0000,,ا-انظروا! أليس ذلك حريقاً؟
Dialogue: 0,0:17:27.20,0:17:28.10,Default,,0000,0000,0000,,!إنّك محق
Dialogue: 0,0:17:28.10,0:17:30.41,Default,,0000,0000,0000,,...لـ-لحظة! أيمكن أنّه
Dialogue: 0,0:17:30.59,0:17:32.06,Default,,0000,0000,0000,,!نزلنا؟
Dialogue: 0,0:17:32.62,0:17:33.79,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:33.79,0:17:39.53,Default,,0000,0000,0000,,!لا يمكن! لا تزال أسامي سينباي هناك
Dialogue: 0,0:17:41.20,0:17:44.70,Default,,0000,0000,0000,,!لنسرع للنزل بأيّ حال! قد لا نستطيع الوصول في الوقت
Dialogue: 0,0:17:45.12,0:17:46.52,Default,,0000,0000,0000,,!أين مفتاح السيّارة المستأجرة؟
Dialogue: 0,0:17:46.52,0:17:48.45,Default,,0000,0000,0000,,بحوزة نوغوتشي-كن
Dialogue: 0,0:17:48.45,0:17:49.99,Default,,0000,0000,0000,,ماذا؟ ما الخطب؟
Dialogue: 0,0:17:50.37,0:17:55.45,Default,,0000,0000,0000,,!أكبر خطب! النزل الذي استأجرناه يحترق
Dialogue: 0,0:18:01.42,0:18:04.20,Default,,0000,0000,0000,,...سينباي... سينباي
Dialogue: 0,0:18:04.63,0:18:06.07,Default,,0000,0000,0000,,...أرجوك، فلتكوني بخير
Dialogue: 0,0:18:07.92,0:18:09.05,Default,,0000,0000,0000,,!يا أسامي سينباي
Dialogue: 0,0:18:18.25,0:18:19.10,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:18:19.62,0:18:20.52,Default,,0000,0000,0000,,!أسامي
Dialogue: 0,0:18:20.52,0:18:21.82,Default,,0000,0000,0000,,!أسامي سينباي
Dialogue: 0,0:18:22.96,0:18:25.20,Default,,0000,0000,0000,,لا جدوى، لا يبدو أنّها هربت خارجاً
Dialogue: 0,0:18:25.89,0:18:27.78,Default,,0000,0000,0000,,!أ-أيمكن أنّها لا تزال نائمة في الداخل؟
Dialogue: 0,0:18:27.78,0:18:29.16,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:18:30.62,0:18:33.37,Default,,0000,0000,0000,,هل نتّصل بالهاتف ونوقظها؟ فقد كانت\N!نائمة في غرفة المعيشة
Dialogue: 0,0:18:33.37,0:18:36.16,Default,,0000,0000,0000,,!لا جدوى، لقد احترق بالفعل
Dialogue: 0,0:18:37.45,0:18:38.92,Default,,0000,0000,0000,,!تبّاً! لا خيار آخر
Dialogue: 0,0:18:38.92,0:18:39.88,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:18:42.58,0:18:45.17,Default,,0000,0000,0000,,!لا-لا جدوى! يستحيل الدخول
Dialogue: 0,0:18:45.62,0:18:46.30,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:18:46.30,0:18:47.70,Default,,0000,0000,0000,,!هذا خطر! ابتعدي
Dialogue: 0,0:18:47.70,0:18:49.13,Default,,0000,0000,0000,,!أسامي سينباي
Dialogue: 0,0:18:49.13,0:18:53.95,Default,,0000,0000,0000,,!أنتم! أبعدوا تلك الدرّاجة\N!ستكون مصيبةً إذا اشتعل البنزين
Dialogue: 0,0:18:53.95,0:18:54.58,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:18:54.58,0:18:56.10,Default,,0000,0000,0000,,!لم تصل عربة الإطفاء بعد؟
Dialogue: 0,0:18:58.42,0:19:00.28,Default,,0000,0000,0000,,...ماذا؟ الخوذة
Dialogue: 0,0:19:01.59,0:19:03.74,Default,,0000,0000,0000,,!أنا قادمة الآن يا سينباي
Dialogue: 0,0:19:05.08,0:19:05.86,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:19:07.17,0:19:10.30,Default,,0000,0000,0000,,!ماذا؟! دخلت ران وكونان؟
Dialogue: 0,0:19:10.30,0:19:12.21,Default,,0000,0000,0000,,!لحق بهما الرئيس ساواي أيضاً
Dialogue: 0,0:19:12.21,0:19:13.71,Default,,0000,0000,0000,,!تلك الحمقاء
Dialogue: 0,0:19:17.96,0:19:19.34,Default,,0000,0000,0000,,!سينباي
Dialogue: 0,0:19:21.88,0:19:24.48,Default,,0000,0000,0000,,!سينباي! أسامي سينباي
Dialogue: 0,0:19:25.80,0:19:26.84,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:19:26.84,0:19:28.26,Default,,0000,0000,0000,,!كـ-كلا يا موري-سان
Dialogue: 0,0:19:28.55,0:19:31.25,Default,,0000,0000,0000,,!دعني! ابنتي في الداخل
Dialogue: 0,0:19:31.25,0:19:32.48,Default,,0000,0000,0000,,!هذا خطرٌ عليك أيضاً
Dialogue: 0,0:19:32.84,0:19:34.01,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:19:34.80,0:19:37.80,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:19:44.09,0:19:45.82,Default,,0000,0000,0000,,!ران، ران
Dialogue: 0,0:19:47.17,0:19:49.49,Default,,0000,0000,0000,,!تماسكي يا ران
Dialogue: 0,0:19:52.30,0:19:53.59,Default,,0000,0000,0000,,...سونوكو
Dialogue: 0,0:19:53.59,0:19:54.46,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:19:55.25,0:19:57.00,Default,,0000,0000,0000,,أين نحن؟
Dialogue: 0,0:19:57.00,0:20:00.63,Default,,0000,0000,0000,,مشفى بقرب النزل، نقلوك إلى هنا بعدما حصل
Dialogue: 0,0:20:01.09,0:20:02.13,Default,,0000,0000,0000,,...فهمت
Dialogue: 0,0:20:04.21,0:20:06.59,Default,,0000,0000,0000,,!ماذا عن سينباي؟! أسامي سينباي؟
Dialogue: 0,0:20:07.75,0:20:09.56,Default,,0000,0000,0000,,إنّها نائمة بجوارك
Dialogue: 0,0:20:10.42,0:20:15.27,Default,,0000,0000,0000,,،تعاني تسمُّم خفيف من أوّل أكسيد الكربون\Nلكن لا خطر على حياتها
Dialogue: 0,0:20:15.71,0:20:18.67,Default,,0000,0000,0000,,حمداً لله... نجت
Dialogue: 0,0:20:18.67,0:20:22.50,Default,,0000,0000,0000,,ما الذي تتكلّمين عنه؟ كنتِ من أنقذتها
Dialogue: 0,0:20:22.50,0:20:23.74,Default,,0000,0000,0000,,لا تذكرين؟
Dialogue: 0,0:20:24.09,0:20:29.25,Default,,0000,0000,0000,,البتّة... اندفعتُ للداخل دون تفكير
Dialogue: 0,0:20:29.25,0:20:34.16,Default,,0000,0000,0000,,وأرشدني ساواي-سان للأمان بعدما وجدتُها
Dialogue: 0,0:20:34.88,0:20:39.25,Default,,0000,0000,0000,,شعرتُ بالارتياح بعدما خرجنا، لكن بدأ وعيي يتلاشى
Dialogue: 0,0:20:39.25,0:20:42.92,Default,,0000,0000,0000,,!لكنّك كنتِ مذهلة! أخذتِ الخوذة وهببتِ لإنقاذها
Dialogue: 0,0:20:42.92,0:20:47.25,Default,,0000,0000,0000,,،حتّى رجال الإطفاء قالوا أنّ دخولك الحريق كان تهوّراً
Dialogue: 0,0:20:47.25,0:20:50.10,Default,,0000,0000,0000,,!لكنّ ارتدائك للخوذة كان قراراً حكيماً
Dialogue: 0,0:20:50.50,0:20:54.00,Default,,0000,0000,0000,,كان ذلك... كونان-كن
Dialogue: 0,0:20:54.00,0:20:58.25,Default,,0000,0000,0000,,أعطاني إيّاها عندما كنتُ أهمّ بالدخول
Dialogue: 0,0:20:58.25,0:21:02.07,Default,,0000,0000,0000,,اقترح عليّ ارتداءها لحماية\Nشعري ووجهي من اللهب
Dialogue: 0,0:21:03.17,0:21:06.78,Default,,0000,0000,0000,,كونان-كن؟ إنّه طفل غريب كالمعتاد
Dialogue: 0,0:21:07.09,0:21:09.44,Default,,0000,0000,0000,,أجل، معكِ حقّ
Dialogue: 0,0:21:17.42,0:21:20.71,Default,,0000,0000,0000,,بدأ الحريق عند قرابة الثانية وخمسين دقيقة إذاً؟
Dialogue: 0,0:21:20.71,0:21:25.88,Default,,0000,0000,0000,,أجل، قال أشخاص في نُزل مجاور\Nأنّهم رأوا تصاعد الدخان
Dialogue: 0,0:21:26.13,0:21:29.59,Default,,0000,0000,0000,,ظنّوا أنّها مجرّد نار تخييم بدايةً
Dialogue: 0,0:21:29.92,0:21:32.75,Default,,0000,0000,0000,,إذاً، أيمكن أنّها كانت جريمة إحراق؟
Dialogue: 0,0:21:32.75,0:21:35.21,Default,,0000,0000,0000,,كلا، بدأ الحريق في غرفة المعيشة
Dialogue: 0,0:21:35.21,0:21:37.73,Default,,0000,0000,0000,,كانت شمعة الكعكة هذه هي السبب غالباً
Dialogue: 0,0:21:38.42,0:21:40.25,Default,,0000,0000,0000,,شمعة الكعكة؟
Dialogue: 0,0:21:40.25,0:21:44.90,Default,,0000,0000,0000,,أجل، لعلّها سقطت على الأرض\Nفي نقطةٍ ما وهي لا تزال مشتعلة
Dialogue: 0,0:21:45.55,0:21:50.62,Default,,0000,0000,0000,,فانتقلت الشعلة للفائف الهدايا والستائر بالقرب
Dialogue: 0,0:21:51.09,0:21:52.73,Default,,0000,0000,0000,,!لمَ لم تطفئيها؟
Dialogue: 0,0:21:52.73,0:21:55.30,Default,,0000,0000,0000,,!يا للفظاظة! قمت بإطفائها
Dialogue: 0,0:21:55.30,0:21:59.25,Default,,0000,0000,0000,,لم يكن باليد حيلة، فقد غادرنا في عجلة
Dialogue: 0,0:21:59.25,0:22:00.79,Default,,0000,0000,0000,,!أخبرتكم أنّي أطفأتها
Dialogue: 0,0:22:01.09,0:22:05.25,Default,,0000,0000,0000,,لكن كانت الشمعة محترقة لأساسها
Dialogue: 0,0:22:05.25,0:22:09.80,Default,,0000,0000,0000,,...إذا لم تنس إطفاءها، فهناك احتمال آخر
Dialogue: 0,0:22:11.34,0:22:16.47,Default,,0000,0000,0000,,أنّ أسامي-سان التي كانت في غرفة\N!المعيشة قد أضرمت الحريق بنفسها
Dialogue: 0,0:22:17.30,0:22:18.27,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:22:18.64,0:22:20.77,Default,,0000,0000,0000,,!مستحيل! لمَ قد تفعل ذلك؟
Dialogue: 0,0:24:04.12,0:24:05.95,Default,,0000,0000,0000,,سـ-سينباي؟
Dialogue: 0,0:24:06.16,0:24:07.58,Default,,0000,0000,0000,,!اختفت؟
Dialogue: 0,0:24:07.58,0:24:11.29,Default,,0000,0000,0000,,لا بدّ أنّها غادرت بينما\N!ذهبنا لجلب شراب
Dialogue: 0,0:24:11.29,0:24:13.12,Default,,0000,0000,0000,,ما العمل يا أبي؟
Dialogue: 0,0:24:17.34,0:24:21.20,Default,,0000,0000,0000,,كادت أسامي-سان تحترق موتاً
Dialogue: 0,0:24:21.20,0:24:25.12,Default,,0000,0000,0000,,!من فِعل أحدكم هنا
Dialogue: 0,0:24:25.59,0:24:31.59,On Top,,0000,0000,0000,,قضيّة ذكريات الحب الأوّل\N(الجزء الثاني)
Dialogue: 0,0:24:26.23,0:24:27.66,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.66,0:24:31.39,Default,,0000,0000,0000,,قضيّة ذكريات الحب الأوّل\N(الجزء الثاني)
Dialogue: 0,0:24:47.43,0:24:49.66,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.66,0:24:51.06,Default,,0000,0000,0000,,فاكس
Dialogue: 0,0:24:51.93,0:24:52.95,Default,,0000,0000,0000,,...الحلقة القادمة
Dialogue: 0,0:24:52.95,0:24:54.67,Default,,0000,0000,0000,,!نقترب من حقيقة الحُب الأوّل
Dialogue: 0,0:24:54.67,0:24:56.06,Default,,0000,0000,0000,,!إنّه جليّ

