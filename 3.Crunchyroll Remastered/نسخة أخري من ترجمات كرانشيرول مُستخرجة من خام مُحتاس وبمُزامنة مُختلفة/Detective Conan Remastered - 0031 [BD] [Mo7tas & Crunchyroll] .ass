Dialogue: 0,0:00:01.01,0:00:03.43,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:03.43,0:00:06.43,Default,,0000,0000,0000,,أُجبر طالب الثانويّة شينتشي على تجرّع\Nعقارٍ قلّص جسده
Dialogue: 0,0:00:06.43,0:00:07.93,Default,,0000,0000,0000,,!فأصبحتُ إيدوغاوا كونان
Dialogue: 0,0:00:07.93,0:00:10.93,Default,,0000,0000,0000,,!مسرح اليوم هو محطّة تلفاز\N!احذروا من البثّ الحيّ
Dialogue: 0,0:00:10.93,0:00:13.01,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.01,0:00:15.01,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.85,0:01:51.93,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل محطّة التلفاز
Dialogue: 0,0:01:46.93,0:01:50.05,Default,,0000,0000,0000,,جريمة قتل محطّة التلفاز
Dialogue: 0,0:01:52.47,0:01:55.30,On Top,,0000,0000,0000,,{\fad(300,0)}تلفاز نيتشيوري
Dialogue: 0,0:01:56.10,0:01:58.35,Default,,0000,0000,0000,,قسم البرامج في تلفاز نيتشيوري
Dialogue: 0,0:01:58.35,0:02:00.22,Default,,0000,0000,0000,,لحظة من فضلك
Dialogue: 0,0:02:00.29,0:02:01.88,Default,,0000,0000,0000,,!سوا-تشان
Dialogue: 0,0:02:02.22,0:02:04.97,On Top,,0000,0000,0000,,اتّصال على الخطّ الرابع من ماتسو تاكاشي-سان
Dialogue: 0,0:02:02.34,0:02:04.97,CharCard,,0000,0000,0000,,{\fad(300,0)}منتج في تلفاز نيتشيوري\N(سوا ميتشيهيكو (37
Dialogue: 0,0:02:07.73,0:02:10.13,Default,,0000,0000,0000,,.ما الذي تريده؟ أخبرتك أنّ ذاك الموضوع مستحيل
Dialogue: 0,0:02:10.33,0:02:12.55,Default,,0000,0000,0000,,سيكون الإعلان الأسبوع المقبل
Dialogue: 0,0:02:12.80,0:02:16.56,Default,,0000,0000,0000,,كلا، لديّ فكرة عن برنامج أريد أن تسمعها
Dialogue: 0,0:02:16.76,0:02:20.88,On Top,,0000,0000,0000,,آمل أن نستطيع اللقاء بمفردنا
Dialogue: 0,0:02:17.22,0:02:21.08,CharCard,,0000,0000,0000,,موهبة تلفازية\N(ماتسو تاكاشي (35
Dialogue: 0,0:02:21.78,0:02:25.51,On Top,,0000,0000,0000,,في الغرفة المعتادة بعد انتهاء\Nبثّ الغد المباشر
Dialogue: 0,0:02:25.78,0:02:28.34,On Top,,0000,0000,0000,,سيعينني كثيراً لو أخرجت الجميع باكراً
Dialogue: 0,0:02:28.54,0:02:29.72,Default,,0000,0000,0000,,يا إلهي، حسناً
Dialogue: 0,0:02:34.14,0:02:37.10,Default,,0000,0000,0000,,لكنّها المرّة الأخيرة
Dialogue: 0,0:02:34.45,0:02:36.13,On Top,,0000,0000,0000,,محطّة التحرّي
Dialogue: 0,0:02:37.31,0:02:39.01,Default,,0000,0000,0000,,معكّ حق يا سوا-تشان
Dialogue: 0,0:02:40.53,0:02:41.47,Default,,0000,0000,0000,,...ستكون هذه
Dialogue: 0,0:02:52.37,0:02:56.21,Default,,0000,0000,0000,,!المرّة الأخيرة
Dialogue: 0,0:02:56.41,0:02:59.22,Default,,0000,0000,0000,,مرحباً بكم في حلقة هذا الأسبوع\N "من "محطة تحرّي اليابان الكاشفة
Dialogue: 0,0:02:59.42,0:03:02.63,Default,,0000,0000,0000,,أنا مضيفكم ماتسو تاكاشي
Dialogue: 0,0:03:03.35,0:03:06.46,Default,,0000,0000,0000,,!وأنا مساعدته ناغاي أياكو
Dialogue: 0,0:03:06.66,0:03:09.63,Default,,0000,0000,0000,,يختار طاقمنا بين مختلف القضايا النادرة والمعقدة
Dialogue: 0,0:03:09.83,0:03:13.01,Default,,0000,0000,0000,,التي ترسلونها لنا لنحلّها على الهواء
Dialogue: 0,0:03:13.45,0:03:16.28,Default,,0000,0000,0000,,نتشرّف اليوم بحضور ضيفٍ يبعث الثقة في القلوب
Dialogue: 0,0:03:17.09,0:03:19.22,Default,,0000,0000,0000,,!المتحرّي الشهير موري كوغورو-سان
Dialogue: 0,0:03:19.62,0:03:20.90,Default,,0000,0000,0000,,!شكراً! شكراً
Dialogue: 0,0:03:21.10,0:03:25.19,Default,,0000,0000,0000,,بالمناسبة حضرة المتحرّي، ما كانت أصعب \Nقضية عملت عليها حتّى الآن؟
Dialogue: 0,0:03:25.76,0:03:30.88,Default,,0000,0000,0000,,...في الواقع، أشعر بدوار متى انتهيت من حلّ قضية
Dialogue: 0,0:03:31.08,0:03:33.39,Default,,0000,0000,0000,,!فلا أتذكر شيئاً
Dialogue: 0,0:03:35.11,0:03:36.72,Default,,0000,0000,0000,,...أبي حقّاً
Dialogue: 0,0:03:37.47,0:03:39.92,Default,,0000,0000,0000,,لا عجب، فهو ينام بالفعل
Dialogue: 0,0:03:40.22,0:03:41.87,Default,,0000,0000,0000,,حسناً، للإعلانات
Dialogue: 0,0:03:45.58,0:03:46.81,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:03:47.38,0:03:49.79,Default,,0000,0000,0000,,توجعني معدتي منذ الصباح
Dialogue: 0,0:03:49.99,0:03:54.34,Default,,0000,0000,0000,,المعذرة، أيمكنك إخباري أين سوا-تشان؟
Dialogue: 0,0:03:54.54,0:03:55.51,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:03:55.71,0:03:58.47,Default,,0000,0000,0000,,أجل، أنا في غرفة اجتماعات الطابق الرابع
Dialogue: 0,0:03:58.67,0:03:59.93,Default,,0000,0000,0000,,لا تقلق
Dialogue: 0,0:04:00.13,0:04:02.48,Default,,0000,0000,0000,,أتفقّد البرنامج على الشاشة
Dialogue: 0,0:04:02.68,0:04:05.28,Default,,0000,0000,0000,,وانقل هذا الكلام لماتسو-كن
Dialogue: 0,0:04:05.48,0:04:07.90,Default,,0000,0000,0000,,عليه أن يأتي هنا بعد انتهاء البرنامج
Dialogue: 0,0:04:08.10,0:04:12.72,Default,,0000,0000,0000,,كنتُ شرطياً، لكنّي لا أجيد استعمال \N...المسدّسات حقاً
Dialogue: 0,0:04:12.92,0:04:15.28,Default,,0000,0000,0000,,أليست المسدسات اختصاصك يا ماتسو-سان؟
Dialogue: 0,0:04:15.48,0:04:18.13,Default,,0000,0000,0000,,ألم تتدرب خارج البلاد وأصبحت محترفاً؟
Dialogue: 0,0:04:18.33,0:04:20.55,Default,,0000,0000,0000,,...كلا، ذلك قليل
Dialogue: 0,0:04:20.75,0:04:21.80,Default,,0000,0000,0000,,!مما لديّ
Dialogue: 0,0:04:23.02,0:04:26.40,Default,,0000,0000,0000,,شخصيته تلقى إقبالاً، فيبقى جمهوره ثابتاً
Dialogue: 0,0:04:26.60,0:04:28.77,Default,,0000,0000,0000,,لكنّ ذلك حدّه
Dialogue: 0,0:04:28.97,0:04:31.80,Default,,0000,0000,0000,,إن بدّلته بالمذيعة الأجمل الأعلى شعبية
Dialogue: 0,0:04:32.00,0:04:33.70,Default,,0000,0000,0000,,وأضفت أجزاء بذيئة، سيتضاعف \N!المشاهدون ضعفين! بل ثلاثة
Dialogue: 0,0:04:33.90,0:04:36.77,Default,,0000,0000,0000,,...وسأُرقّى في النهاية
Dialogue: 0,0:04:36.97,0:04:38.68,Default,,0000,0000,0000,,!لرئيس القسم
Dialogue: 0,0:04:39.01,0:04:41.22,Default,,0000,0000,0000,,التجسّس موضوع يكثر الكلام فيه مؤخراً
Dialogue: 0,0:04:41.80,0:04:43.94,Default,,0000,0000,0000,,ليس غريباً أن تُزرع أجهزة تنصت في أيّ مكان وأيّ وقت
Dialogue: 0,0:04:44.14,0:04:47.68,Default,,0000,0000,0000,,لذا أصبحت أستعمل هاتفاً خلوياً
Dialogue: 0,0:04:47.96,0:04:50.51,Default,,0000,0000,0000,,هذا ما يعيب الهواة
Dialogue: 0,0:04:51.73,0:04:54.55,Default,,0000,0000,0000,,تنقل الهواتف الخلوية التناظرية إشارات إلكترونية
Dialogue: 0,0:04:55.09,0:04:58.66,Default,,0000,0000,0000,,فلا حاجة لزرع أجهزة تنّصت بالأصل للاستماع للمحادثات
Dialogue: 0,0:04:58.86,0:05:02.68,Default,,0000,0000,0000,,!عجيب، يعرف معلومةً دقيقة
Dialogue: 0,0:05:02.88,0:05:05.51,Default,,0000,0000,0000,,...لذا
Dialogue: 0,0:05:05.90,0:05:07.35,Default,,0000,0000,0000,,!مرحباً، إيزومي-تشان! إنّه أنا، كوغورو-تشان
Dialogue: 0,0:05:09.59,0:05:13.30,Default,,0000,0000,0000,,ما رأيك بأن نذهب للعشاء في مطعم الليلة؟
Dialogue: 0,0:05:13.94,0:05:16.76,Default,,0000,0000,0000,,زوجتي؟
Dialogue: 0,0:05:17.11,0:05:20.51,Default,,0000,0000,0000,,!لا تقلقي! فنحن لم نعد معاً
Dialogue: 0,0:05:20.71,0:05:23.47,Default,,0000,0000,0000,,!لنقض ليلةً ساخنة اليوم
Dialogue: 0,0:05:23.67,0:05:26.96,Default,,0000,0000,0000,,يمكن التنصّت على محادثة خطيرة كهذه بسهولة
Dialogue: 0,0:05:27.46,0:05:30.91,Default,,0000,0000,0000,,انتباه لجميع الخائنين، ومن يقيمون علاقات لا شرعية
Dialogue: 0,0:05:31.13,0:05:33.43,Default,,0000,0000,0000,,!حاذروا من الإهمال
Dialogue: 0,0:05:33.69,0:05:37.95,Default,,0000,0000,0000,,ننتقل بعد هذا الجزء المثير للجزء \N"!التالي من البرنامج، "أنت الفاعل
Dialogue: 0,0:05:38.15,0:05:40.70,Default,,0000,0000,0000,,سنعرض مقطعاً من 4 دقائق
Dialogue: 0,0:05:40.90,0:05:43.91,Default,,0000,0000,0000,,وعليكم تحديد هويّة المجرم بعد مشاهدته
Dialogue: 0,0:05:44.34,0:05:47.85,Default,,0000,0000,0000,,اسمي كيريشيما جوجي، مُتحرٍّ خاص
Dialogue: 0,0:05:48.05,0:05:51.57,Default,,0000,0000,0000,,يا للسخافة، ينفق مالاً على مقاطع تافهة كهذا
Dialogue: 0,0:05:56.73,0:05:57.53,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:05:57.73,0:05:59.15,Default,,0000,0000,0000,,إنّه أنا يا سوا-تشان
Dialogue: 0,0:05:59.52,0:06:00.17,Default,,0000,0000,0000,,!ماتسو-كن؟! ما الذي تفعله؟
Dialogue: 0,0:06:00.77,0:06:02.93,Default,,0000,0000,0000,,!لا يزال البثّ قائماً
Dialogue: 0,0:06:03.13,0:06:05.46,Default,,0000,0000,0000,,أردتك أن تسمع آخر كلماتي
Dialogue: 0,0:06:05.66,0:06:07.39,Default,,0000,0000,0000,,آخر كلماتك؟ ماذا تقصد؟
Dialogue: 0,0:06:07.66,0:06:11.51,Default,,0000,0000,0000,,!سأموت، سأقفز من سطح هذا المبنى
Dialogue: 0,0:06:11.51,0:06:12.59,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:06:12.59,0:06:14.64,Default,,0000,0000,0000,,!أمعن النظر لموتي
Dialogue: 0,0:06:15.30,0:06:17.69,Default,,0000,0000,0000,,!فـ-فهمت! سأفعل شيئاً بشأن عملك كمضيف
Dialogue: 0,0:06:17.89,0:06:19.51,Default,,0000,0000,0000,,!لا تستعجل
Dialogue: 0,0:06:19.87,0:06:21.97,Default,,0000,0000,0000,,فات الأوان
Dialogue: 0,0:06:24.57,0:06:28.14,Default,,0000,0000,0000,,إذاً، أعرفتم هويّة المجرم؟
Dialogue: 0,0:06:28.42,0:06:31.42,Default,,0000,0000,0000,,!هذه الدراما مُتقنة كالعادة
Dialogue: 0,0:06:31.62,0:06:34.10,Default,,0000,0000,0000,,أتبتكرها كلّ مرة يا ماتسو-سان؟
Dialogue: 0,0:06:34.26,0:06:35.72,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:06:37.14,0:06:38.88,Default,,0000,0000,0000,,لمَ تتعرّق؟
Dialogue: 0,0:06:39.17,0:06:41.76,Default,,0000,0000,0000,,...حالة معدتي سيّئة اليوم
Dialogue: 0,0:06:41.96,0:06:43.84,Default,,0000,0000,0000,,يوشك المقطع على الانتهاء
Dialogue: 0,0:06:44.04,0:06:45.79,Default,,0000,0000,0000,,من المجرم؟
Dialogue: 0,0:06:45.99,0:06:47.81,Default,,0000,0000,0000,,أخت الضحيّة
Dialogue: 0,0:06:48.64,0:06:51.16,Default,,0000,0000,0000,,إذاً، من كان الفاعل؟
Dialogue: 0,0:06:52.20,0:06:53.76,Default,,0000,0000,0000,,!أخت الضحيّة
Dialogue: 0,0:06:54.05,0:06:55.91,Default,,0000,0000,0000,,حقاً؟
Dialogue: 0,0:06:56.11,0:06:57.70,Default,,0000,0000,0000,,أعرفتها يا كونان-كن؟
Dialogue: 0,0:06:57.90,0:06:59.72,Default,,0000,0000,0000,,!لم تكن لديّ فكرة
Dialogue: 0,0:07:00.00,0:07:02.39,Default,,0000,0000,0000,,!نراكم الأسبوع المقبل
Dialogue: 0,0:07:08.92,0:07:11.87,Default,,0000,0000,0000,,حسّك الفكاهي أنقذ الوضع
Dialogue: 0,0:07:12.07,0:07:15.10,Default,,0000,0000,0000,,ماتسو-سان، يبدو أنّ سوا-تشان قد اختفى
Dialogue: 0,0:07:16.07,0:07:19.17,Default,,0000,0000,0000,,لا يجيب على هاتف غرفة الاجتماعات\Nأو هاتفه الخلوي
Dialogue: 0,0:07:19.68,0:07:22.97,Default,,0000,0000,0000,,ما خطبه؟ اذهب وتفقّده
Dialogue: 0,0:07:23.17,0:07:24.00,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:07:25.06,0:07:28.22,Default,,0000,0000,0000,,ماذا؟ لمَ غرفة الاجتماعات ولا مكان آخر؟
Dialogue: 0,0:07:31.23,0:07:33.43,Default,,0000,0000,0000,,سوا-سان! أأنت بالداخل؟
Dialogue: 0,0:07:33.71,0:07:34.26,Default,,0000,0000,0000,,!سوا-سان
Dialogue: 0,0:07:35.72,0:07:37.68,Default,,0000,0000,0000,,!ماذا؟! سوا-سان غارق في الدماء؟
Dialogue: 0,0:07:38.44,0:07:40.26,Default,,0000,0000,0000,,!فهمت! سآتي فوراً
Dialogue: 0,0:07:44.63,0:07:47.18,Default,,0000,0000,0000,,!المصعد مشغول! لننزل من الأدراج
Dialogue: 0,0:07:53.63,0:07:55.81,Default,,0000,0000,0000,,تنتهي هذه الأدراج عند الطابق السابع
Dialogue: 0,0:07:56.19,0:07:57.77,Default,,0000,0000,0000,,!من هنا! بسرعة
Dialogue: 0,0:07:57.97,0:08:00.01,Default,,0000,0000,0000,,كأنّها متاهة
Dialogue: 0,0:08:03.50,0:08:04.72,Default,,0000,0000,0000,,!ابتعدوا رجاءً
Dialogue: 0,0:08:16.32,0:08:17.76,Default,,0000,0000,0000,,!كان هو
Dialogue: 0,0:08:20.86,0:08:24.63,Default,,0000,0000,0000,,،الضحيّة هو منتج محطّة التلفاز هذه\Nالسيّد سوا ميتشيهيكو، 37 عاماً
Dialogue: 0,0:08:24.83,0:08:26.47,Default,,0000,0000,0000,,سلاح الجريمة كان مسدّساً
Dialogue: 0,0:08:26.88,0:08:28.31,Default,,0000,0000,0000,,اخترقت الرصاصة رأسه وحطّمت زجاج النافذة
Dialogue: 0,0:08:28.78,0:08:32.90,Default,,0000,0000,0000,,ثمّ خرجت
Dialogue: 0,0:08:33.10,0:08:36.01,Default,,0000,0000,0000,,حضرة المفتّش، توجد ثقوب رصاصات أخرى على الحائط
Dialogue: 0,0:08:36.29,0:08:38.59,Default,,0000,0000,0000,,اثنان وراء هذا المُلصق
Dialogue: 0,0:08:38.76,0:08:40.76,Default,,0000,0000,0000,,وواحد عند الساعة
Dialogue: 0,0:08:41.39,0:08:43.72,Default,,0000,0000,0000,,حضرة المفتّش، وجدتُ خراطيش في الزاوية
Dialogue: 0,0:08:44.00,0:08:45.43,Default,,0000,0000,0000,,أربعة منها
Dialogue: 0,0:08:46.05,0:08:48.14,Default,,0000,0000,0000,,هذا يُطابق عدد الثقوب
Dialogue: 0,0:08:48.34,0:08:51.17,Default,,0000,0000,0000,,وهناك مخرج ومدخل واحد
Dialogue: 0,0:08:51.37,0:08:54.21,Default,,0000,0000,0000,,ما يعني أنّ الموضوع بسيط
Dialogue: 0,0:08:54.41,0:08:57.64,Default,,0000,0000,0000,,اقتحم القاتل الغرفة من المدخل غالباً
Dialogue: 0,0:08:57.84,0:09:00.34,Default,,0000,0000,0000,,ودفع الضحيّة للنافذة
Dialogue: 0,0:09:00.54,0:09:03.22,Default,,0000,0000,0000,,ثمّ أطلق عليه وابل رصاصات وقتله
Dialogue: 0,0:09:03.42,0:09:07.22,Default,,0000,0000,0000,,ورمى المسدّس عند قدميه ولاذ بالفرار
Dialogue: 0,0:09:07.50,0:09:11.16,Default,,0000,0000,0000,,أرأى أحدكم شخصاً مشبوهاً قد يكون القاتل؟
Dialogue: 0,0:09:11.36,0:09:14.03,Default,,0000,0000,0000,,...كان سوا-سان يُبعد الجميع دوماً، لذا
Dialogue: 0,0:09:14.23,0:09:15.56,Default,,0000,0000,0000,,يُبعد؟
Dialogue: 0,0:09:15.76,0:09:17.35,Default,,0000,0000,0000,,كان ينتظرني
Dialogue: 0,0:09:18.00,0:09:21.80,Default,,0000,0000,0000,,قال أنّ لديه أمراً مهماً ليناقشه معي بعد البرنامج
Dialogue: 0,0:09:21.98,0:09:23.81,Default,,0000,0000,0000,,لا شهود عيان
Dialogue: 0,0:09:24.01,0:09:26.64,Default,,0000,0000,0000,,لكن ربما سمع أحدهم
Dialogue: 0,0:09:27.83,0:09:30.22,Default,,0000,0000,0000,,انظروا، يبدو أنّه كان على هاتفه الخلوي
Dialogue: 0,0:09:30.54,0:09:33.68,Default,,0000,0000,0000,,ما يعني أنّ هناك احتمالاً بسماع الطرف الآخر لشيء
Dialogue: 0,0:09:34.05,0:09:35.64,Default,,0000,0000,0000,,صحيح يا عمّ؟
Dialogue: 0,0:09:35.82,0:09:36.91,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:09:37.11,0:09:38.59,Default,,0000,0000,0000,,...معك حق
Dialogue: 0,0:09:38.90,0:09:42.93,Default,,0000,0000,0000,,حسنٌ، جِدوا من كانوا على صلة بالضحيّة\Nواكتشفوا من كان يكلّم على الهاتف
Dialogue: 0,0:09:42.93,0:09:43.55,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:09:45.86,0:09:46.64,Default,,0000,0000,0000,,!ماتسو-سان
Dialogue: 0,0:09:47.97,0:09:50.01,Default,,0000,0000,0000,,ماتسو-سان! ما تعليقك على الوضع؟
Dialogue: 0,0:09:50.21,0:09:52.72,Default,,0000,0000,0000,,انتشرت شائعات عن استبدالك بمضيف آخر في البرنامج
Dialogue: 0,0:09:53.05,0:09:54.88,Default,,0000,0000,0000,,...أيمكن أنّ هذا من عمل معجبيك
Dialogue: 0,0:09:55.08,0:09:56.88,Default,,0000,0000,0000,,!توقفوا
Dialogue: 0,0:09:57.88,0:10:00.96,Default,,0000,0000,0000,,صحيحٌ أنّه دار كلام عن استبدالي
Dialogue: 0,0:10:01.36,0:10:06.26,Default,,0000,0000,0000,,لكن أخبرني سوا-سان أنّه يريد بقائي مضيفاً
Dialogue: 0,0:10:06.76,0:10:08.49,Default,,0000,0000,0000,,:سأعلن هنا
Dialogue: 0,0:10:08.69,0:10:11.51,Default,,0000,0000,0000,,!سأحمل أمنية سوا-سان وأكمل العمل مضيفاً
Dialogue: 0,0:10:11.71,0:10:16.69,Default,,0000,0000,0000,,وسأعرض هذه القضية على البرنامج\Nوأبذل قصارى جهدي لإيجاد القاتل
Dialogue: 0,0:10:16.89,0:10:19.88,Default,,0000,0000,0000,,!لن أتوقف حتى أجد الشيطان الذي قتل سوا-سان
Dialogue: 0,0:10:21.16,0:10:23.63,Default,,0000,0000,0000,,اتّصلت بسوا-سان؟
Dialogue: 0,0:10:23.83,0:10:27.49,Default,,0000,0000,0000,,أجل، أجاب عندما اتّصلت في الثامنة والربع
Dialogue: 0,0:10:27.69,0:10:30.51,Default,,0000,0000,0000,,لكن لم يجب عندما اتّصلت في الثامنة وخمس وخمسون
Dialogue: 0,0:10:30.79,0:10:34.82,Default,,0000,0000,0000,,وقعت الجريمة في الأربعين دقيقة هذه إذاً
Dialogue: 0,0:10:35.02,0:10:36.72,Default,,0000,0000,0000,,لكن لمَ اتّصلت به؟
Dialogue: 0,0:10:37.02,0:10:40.63,Default,,0000,0000,0000,,طلبت منه، لمعرفة مكان سوا-سان
Dialogue: 0,0:10:41.80,0:10:46.06,Default,,0000,0000,0000,,كنتُ على الهواء ولا أعرف رقم هاتفه
Dialogue: 0,0:10:46.40,0:10:51.14,Default,,0000,0000,0000,,بالمناسبة، سمعت أنّك بارع في استعمال المسدّسات
Dialogue: 0,0:10:51.34,0:10:53.51,Default,,0000,0000,0000,,أ-أتشكّ بي؟
Dialogue: 0,0:10:53.71,0:10:57.10,Default,,0000,0000,0000,,!كنتُ أستضيف البرنامج من الثامنة للتاسعة
Dialogue: 0,0:10:57.50,0:11:00.33,Default,,0000,0000,0000,,أي لم تملك فرصةً للتسلل؟
Dialogue: 0,0:11:00.53,0:11:04.98,Default,,0000,0000,0000,,كلا، كان هناك فاصل 4 دقائق\Nيعرضون فيه مقطعاً أثناء البرنامج
Dialogue: 0,0:11:05.18,0:11:06.56,Default,,0000,0000,0000,,...خلالها
Dialogue: 0,0:11:07.00,0:11:10.26,Default,,0000,0000,0000,,صحيحٌ أنّي غادرت الاستوديو، لكنّي ذهبت لدورة المياه
Dialogue: 0,0:11:10.51,0:11:15.84,Default,,0000,0000,0000,,أليست الحقيقة أنّك أخذت مسدساً وأتيت لهذه الغرفة؟
Dialogue: 0,0:11:16.04,0:11:19.80,Default,,0000,0000,0000,,...يا إلهي، إن كنت تظنّني أكذب
Dialogue: 0,0:11:20.08,0:11:24.69,Default,,0000,0000,0000,,فجرّب الركض من الاستوديو لغرفة\Nالطابع الرابع هذه ثمّ ارجع
Dialogue: 0,0:11:24.89,0:11:27.39,Default,,0000,0000,0000,,!ستحتاج 6 دقائق على الأقل مهما ركضت
Dialogue: 0,0:11:29.14,0:11:31.31,Default,,0000,0000,0000,,أقصد، أعتقد ذلك
Dialogue: 0,0:11:32.20,0:11:35.39,Default,,0000,0000,0000,,حسنٌ يا موري-كن، جرّب واركض
Dialogue: 0,0:11:35.97,0:11:37.60,Default,,0000,0000,0000,,!أ-أنا؟
Dialogue: 0,0:11:39.01,0:11:41.22,Default,,0000,0000,0000,,!لمَ عليّ فعل هذا؟
Dialogue: 0,0:11:47.64,0:11:49.54,Default,,0000,0000,0000,,ستّ دقائق وسبع وأربعون ثانية
Dialogue: 0,0:11:49.74,0:11:51.81,Default,,0000,0000,0000,,ألا يمكنك الركض أسرع؟
Dialogue: 0,0:11:52.01,0:11:55.76,Default,,0000,0000,0000,,!كلا! كاد قلبي ينفجر
Dialogue: 0,0:11:55.94,0:11:56.69,Default,,0000,0000,0000,,!حضرة المفتش
Dialogue: 0,0:11:56.89,0:12:01.47,Default,,0000,0000,0000,,راجعنا أشرطة كاميرات المراقبة\Nلكن لم نجد شخصاً شبيهاً بماتسو-سان
Dialogue: 0,0:12:01.84,0:12:05.45,Default,,0000,0000,0000,,يبدو أنّ براءتي أُثبتت
Dialogue: 0,0:12:05.65,0:12:08.54,Default,,0000,0000,0000,,!كلا، ماتسو-سان هو القاتل
Dialogue: 0,0:12:08.93,0:12:13.24,Default,,0000,0000,0000,,لكن كيف ذهب للغرفة ورجع في 4 دقائق؟
Dialogue: 0,0:12:14.09,0:12:15.35,Default,,0000,0000,0000,,ران-نيتشان
Dialogue: 0,0:12:15.55,0:12:17.85,Default,,0000,0000,0000,,!أين كنت؟ بحثت عنك في كلّ مكان
Dialogue: 0,0:12:18.08,0:12:20.22,Default,,0000,0000,0000,,كنتُ رفقة العمّ طوال الوقت
Dialogue: 0,0:12:20.42,0:12:22.30,Default,,0000,0000,0000,,أين كنتِ؟
Dialogue: 0,0:12:23.00,0:12:25.10,Default,,0000,0000,0000,,...أيمكن أنّك تهتِ
Dialogue: 0,0:12:25.30,0:12:27.46,Default,,0000,0000,0000,,ر-ربما
Dialogue: 0,0:12:29.75,0:12:32.47,Default,,0000,0000,0000,,المكان كالمتاهة هنا
Dialogue: 0,0:12:32.76,0:12:37.67,Default,,0000,0000,0000,,تُبنى محطّات التلفاز بتراكيب معقّدة\Nلمنع استيلاء أيّ فرق مسلحة
Dialogue: 0,0:12:38.11,0:12:40.01,Default,,0000,0000,0000,,من المذهل أنّك تعرف ذلك
Dialogue: 0,0:12:40.27,0:12:43.35,Default,,0000,0000,0000,,!أ-أخبرني عامل في المحطّة قبل قليل
Dialogue: 0,0:12:43.55,0:12:45.90,Default,,0000,0000,0000,,صحيح، إنّها كالمتاهة
Dialogue: 0,0:12:46.59,0:12:50.93,Default,,0000,0000,0000,,لكن لا بدّ من وجود\Nطريق مختصر مخفيّ داخلها
Dialogue: 0,0:12:51.35,0:12:56.14,Default,,0000,0000,0000,,طريق سرّي يقودك من الاستوديو للغرفة\N !في أقلّ من 4 دقائق
Dialogue: 0,0:12:57.87,0:13:01.43,Default,,0000,0000,0000,,ماذا؟ لا توجد أدراج للأسفل هنا
Dialogue: 0,0:13:01.76,0:13:07.08,Default,,0000,0000,0000,,يمكن استعمال الأدراج بين الطابقين التاسع \Nوالسابع وحدهما لتفادي كاميرات المراقبة
Dialogue: 0,0:13:07.50,0:13:10.84,Default,,0000,0000,0000,,يمكن الوصول هنا والعودة في دقيقتين
Dialogue: 0,0:13:12.27,0:13:13.39,Default,,0000,0000,0000,,...مخزن
Dialogue: 0,0:13:17.77,0:13:19.22,Default,,0000,0000,0000,,!لحظة، كونان-كن
Dialogue: 0,0:13:24.82,0:13:27.56,Default,,0000,0000,0000,,!هذه النافذة فوق تلك الغرفة تماماً
Dialogue: 0,0:13:27.89,0:13:29.56,Default,,0000,0000,0000,,!فهمت! حبل
Dialogue: 0,0:13:29.76,0:13:31.70,Default,,0000,0000,0000,,...إن استعمل حبلاً ونزل
Dialogue: 0,0:13:32.08,0:13:33.29,Default,,0000,0000,0000,,،كلا، لو دخل القاتل من النافذة
Dialogue: 0,0:13:33.89,0:13:38.94,Default,,0000,0000,0000,,كان ليتراجع الضحيّة نحو الباب
Dialogue: 0,0:13:39.14,0:13:42.30,Default,,0000,0000,0000,,لكنّه دُفع للنافذة
Dialogue: 0,0:13:42.62,0:13:43.55,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:43.91,0:13:45.51,Default,,0000,0000,0000,,...بقعة الدم تلك
Dialogue: 0,0:13:45.91,0:13:47.93,Default,,0000,0000,0000,,تتوقف عند طرف النافذة
Dialogue: 0,0:13:48.25,0:13:51.98,Default,,0000,0000,0000,,!كما... لا يوجد دم على إطار النافذة
Dialogue: 0,0:13:52.18,0:13:55.42,Default,,0000,0000,0000,,لم تجدوا من كان يكلّمه الضحيّة بعد؟
Dialogue: 0,0:13:55.62,0:13:56.68,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:13:56.88,0:14:00.21,Default,,0000,0000,0000,,!ماذا؟ مضت ساعة منذ الحادثة
Dialogue: 0,0:14:00.70,0:14:03.48,Default,,0000,0000,0000,,...ما يعني هناك احتمال واحد يمكنني التفكير به
Dialogue: 0,0:14:03.68,0:14:05.64,Default,,0000,0000,0000,,!الطرف الآخر على الهاتف كان القاتل
Dialogue: 0,0:14:06.11,0:14:11.13,Default,,0000,0000,0000,,لكن لمَ قد يتصل القاتل بالشخص\Nالذي يقابله وعلى وشك قتله؟
Dialogue: 0,0:14:11.92,0:14:12.84,Default,,0000,0000,0000,,...ماذا لو
Dialogue: 0,0:14:13.41,0:14:14.30,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:14:23.74,0:14:25.64,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:14:26.04,0:14:29.70,Default,,0000,0000,0000,,وجود هذا هنا يقطع أيّ شكوك
Dialogue: 0,0:14:31.62,0:14:34.57,Default,,0000,0000,0000,,ذاك الطريق السرّي
Dialogue: 0,0:14:38.42,0:14:42.09,Default,,0000,0000,0000,,لكن لا يزال ينقصني الدليل
Dialogue: 0,0:14:42.74,0:14:45.92,Default,,0000,0000,0000,,دليل دامغ أنّ ماتسو-سان هو القاتل
Dialogue: 0,0:14:47.17,0:14:50.59,Default,,0000,0000,0000,,...تبّاً، تركت هاتفي مفتوحاً
Dialogue: 0,0:14:50.89,0:14:52.92,Default,,0000,0000,0000,,...مرحباً؟ إنّه أنت
Dialogue: 0,0:14:53.12,0:14:57.43,Default,,0000,0000,0000,,وجدته! الدليل القاطع
Dialogue: 0,0:14:57.77,0:14:59.72,Default,,0000,0000,0000,,!الذي يثبت أنّك القاتل
Dialogue: 0,0:15:03.66,0:15:05.59,Default,,0000,0000,0000,,!أسرع يا عمّ
Dialogue: 0,0:15:05.79,0:15:08.13,Default,,0000,0000,0000,,!من هناك؟
Dialogue: 0,0:15:08.33,0:15:11.63,Default,,0000,0000,0000,,...فنّانتك المفضّلة، أوكينو
Dialogue: 0,0:15:11.84,0:15:13.41,Default,,0000,0000,0000,,!يوكو-تشان؟
Dialogue: 0,0:15:15.24,0:15:19.13,Default,,0000,0000,0000,,هل يوكو-تشان هنا حقاً؟
Dialogue: 0,0:15:25.80,0:15:27.93,Default,,0000,0000,0000,,...حسنٌ، الآن
Dialogue: 0,0:15:28.96,0:15:31.39,Default,,0000,0000,0000,,لا أدري ما أقول
Dialogue: 0,0:15:32.49,0:15:34.01,Default,,0000,0000,0000,,لا تقوم هذه بالعمل كما يجب
Dialogue: 0,0:15:34.21,0:15:35.64,Default,,0000,0000,0000,,سيّدي
Dialogue: 0,0:15:35.93,0:15:38.84,Default,,0000,0000,0000,,أيمكنني استعارة مسدّس الطلاء وكاميرا التلفاز؟
Dialogue: 0,0:15:39.04,0:15:41.68,Default,,0000,0000,0000,,ماذا؟ فيما ستستعملهما يا فتى؟
Dialogue: 0,0:15:41.88,0:15:45.82,Default,,0000,0000,0000,,!للبثّ الحيّ لبرنامج تحرّي موري كوغورو الواقعي
Dialogue: 0,0:15:46.56,0:15:48.30,Default,,0000,0000,0000,,المعذرة سيّدي المفتش
Dialogue: 0,0:15:48.72,0:15:50.93,Default,,0000,0000,0000,,أيمكنني المغادرة الآن؟
Dialogue: 0,0:15:50.93,0:15:53.35,Default,,0000,0000,0000,,...حسناً، انتهينا اليوم
Dialogue: 0,0:15:53.35,0:15:55.26,Default,,0000,0000,0000,,انتظر يا ماتسو-سان
Dialogue: 0,0:15:55.26,0:15:57.98,Default,,0000,0000,0000,,عليك البقاء مكانك
Dialogue: 0,0:15:58.17,0:15:59.70,Default,,0000,0000,0000,,موري-كن؟
Dialogue: 0,0:15:59.90,0:16:03.32,Default,,0000,0000,0000,,لا يمكن أن أسمح لك بالإفلات
Dialogue: 0,0:16:03.52,0:16:05.82,Default,,0000,0000,0000,,بينما يوشك برنامجي للتحرّي على البدء
Dialogue: 0,0:16:06.02,0:16:09.55,Default,,0000,0000,0000,,!وخصوصاً أن المجرم هو أنت يا ماتسو-سان
Dialogue: 0,0:16:09.80,0:16:11.67,Default,,0000,0000,0000,,!ما-ما الذي تقوله يا موري-كن؟
Dialogue: 0,0:16:11.87,0:16:12.88,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:16:13.55,0:16:16.72,Default,,0000,0000,0000,,أخبرنا المتحرّي موري بالتصوير هنا
Dialogue: 0,0:16:16.90,0:16:18.42,Default,,0000,0000,0000,,!ماذا؟ ا-انتظروا لحظة
Dialogue: 0,0:16:18.82,0:16:20.54,Default,,0000,0000,0000,,!زاد وزني قليلاً
Dialogue: 0,0:16:20.74,0:16:22.13,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:16:23.26,0:16:25.67,Default,,0000,0000,0000,,فكّر بعناية يا موري-كن
Dialogue: 0,0:16:25.87,0:16:30.34,Default,,0000,0000,0000,,أطلق المجرم وابل الرصاصات في غرفة\Nالطابق الرابع هنا وقتل الضحيّة
Dialogue: 0,0:16:30.74,0:16:34.02,Default,,0000,0000,0000,,لكن كان ماتسو-سان يستضيف برنامجاً مباشراً
Dialogue: 0,0:16:34.22,0:16:36.31,Default,,0000,0000,0000,,في استوديو الطابق التاسع وقت الجريمة
Dialogue: 0,0:16:36.51,0:16:39.75,Default,,0000,0000,0000,,كيف له أن يرتكب الجريمة؟
Dialogue: 0,0:16:40.52,0:16:42.52,Default,,0000,0000,0000,,يبدو مستحيلاً بالفعل
Dialogue: 0,0:16:42.72,0:16:45.89,Default,,0000,0000,0000,,لكن سيدخل ذلك عالم الاحتمال
Dialogue: 0,0:16:46.30,0:16:51.41,Default,,0000,0000,0000,,إذا استعملت النافذة في مخزن الطابق السابع\Nالذي أنا فيه حالياً، 3 طوابق فوقك
Dialogue: 0,0:16:51.61,0:16:55.55,Default,,0000,0000,0000,,أجل، يمكن الذهاب للاستوديو والعودة في أقلّ من دقيقتين
Dialogue: 0,0:16:55.81,0:16:57.77,Default,,0000,0000,0000,,باستعمال هذه الغرفة
Dialogue: 0,0:16:58.01,0:16:59.13,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:16:59.48,0:17:01.81,Default,,0000,0000,0000,,!أيّها المصوّر! أنت قريب جداً من المفتّش
Dialogue: 0,0:17:02.01,0:17:05.18,Default,,0000,0000,0000,,أتساءل لو كنّا سنجلب الغضب باستعمالنا الأدوات بلا إذن؟
Dialogue: 0,0:17:05.38,0:17:08.71,Default,,0000,0000,0000,,إنّه بثّ داخلي فحسب، لن يكتشف أحد
Dialogue: 0,0:17:08.92,0:17:09.63,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:17:09.63,0:17:10.50,Default,,0000,0000,0000,,!الرئيس
Dialogue: 0,0:17:10.70,0:17:12.76,Default,,0000,0000,0000,,!آسف! سنوقف البثّ فوراً
Dialogue: 0,0:17:12.96,0:17:14.65,Default,,0000,0000,0000,,!من أخبركم بالتوقف؟
Dialogue: 0,0:17:15.99,0:17:17.74,Default,,0000,0000,0000,,!سأتحمل المسؤولية كاملة
Dialogue: 0,0:17:17.93,0:17:20.55,Default,,0000,0000,0000,,!انقلوا هذا البثّ للبلد بأسره فوراً
Dialogue: 0,0:17:20.75,0:17:23.48,Default,,0000,0000,0000,,دعوني أسلط الضوء على الحقيقة
Dialogue: 0,0:17:23.68,0:17:24.51,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:17:24.51,0:17:25.47,Default,,0000,0000,0000,,!دع الأمر لي
Dialogue: 0,0:17:25.67,0:17:27.22,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:17:29.50,0:17:32.65,Default,,0000,0000,0000,,امتدّ ماسو-سان خارج هذه النافذة غالباً
Dialogue: 0,0:17:32.85,0:17:36.26,Default,,0000,0000,0000,,وصوّب نحو الغرفة 3 طوابق أسفله
Dialogue: 0,0:17:36.46,0:17:39.30,Default,,0000,0000,0000,,أُصيب الضحيّة في رأسه هنا
Dialogue: 0,0:17:39.50,0:17:44.95,Default,,0000,0000,0000,,وكانت النافذة شبه مغلقة\N ...لذا إن لم يطر، فيستحيل
Dialogue: 0,0:17:45.90,0:17:48.42,On Top,,0000,0000,0000,,!سأسقط
Dialogue: 0,0:17:45.90,0:17:48.42,Default,,0000,0000,0000,,!موري! ما الذي تفعله؟
Dialogue: 0,0:17:48.67,0:17:49.78,Default,,0000,0000,0000,,!عليّ الإسراع وإنقاذه
Dialogue: 0,0:17:53.93,0:17:58.46,Default,,0000,0000,0000,,،بعدما أطلق على ماتسو-سان هكذا\N ...أسقط المسدس
Dialogue: 0,0:17:59.75,0:18:01.85,Default,,0000,0000,0000,,فدخل الغرفة
Dialogue: 0,0:18:04.67,0:18:06.55,Default,,0000,0000,0000,,لكن يا موري-كن
Dialogue: 0,0:18:06.75,0:18:10.40,Default,,0000,0000,0000,,كيف جعل القاتل الضحيّة ينظر للأعلى من النافذة؟
Dialogue: 0,0:18:10.60,0:18:12.45,Default,,0000,0000,0000,,الهاتف الخلوي
Dialogue: 0,0:18:13.00,0:18:16.43,Default,,0000,0000,0000,,الشخص الذي اتّصل بالضحية قُبيل مقتله
Dialogue: 0,0:18:16.63,0:18:18.01,Default,,0000,0000,0000,,هو القاتل
Dialogue: 0,0:18:18.39,0:18:21.94,Default,,0000,0000,0000,,قال غالباً أنّه على وشك القفز والانتحار
Dialogue: 0,0:18:22.14,0:18:25.00,Default,,0000,0000,0000,,ففتح الضحيّة النافذة في هلع
Dialogue: 0,0:18:25.40,0:18:28.92,Default,,0000,0000,0000,,ماذا؟ أتعني التعابير على وجهك أنّي محق؟
Dialogue: 0,0:18:29.12,0:18:32.52,Default,,0000,0000,0000,,ماذا عن ثقوب الرصاصات في الغرفة والخراطيش إذاً؟
Dialogue: 0,0:18:32.72,0:18:36.44,Default,,0000,0000,0000,,جهّزها ماتسو-سان سلفاً بالطبع
Dialogue: 0,0:18:36.64,0:18:40.84,Default,,0000,0000,0000,,إن كنتَ تريد دليلاً على إطلاقه من الأعلى\N فيوجد ثقب رصاصة على الأرض أسفل النافذة
Dialogue: 0,0:18:41.04,0:18:42.26,Default,,0000,0000,0000,,!تـ-تحققوا فوراً
Dialogue: 0,0:18:42.26,0:18:43.57,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:18:44.30,0:18:45.54,Default,,0000,0000,0000,,ماتسو-سان
Dialogue: 0,0:18:45.74,0:18:49.23,Default,,0000,0000,0000,,غادرت الاستوديو أثناء عرض المقطع
Dialogue: 0,0:18:49.43,0:18:51.08,Default,,0000,0000,0000,,وأتيت لهذا المخزن في الطابق السابع
Dialogue: 0,0:18:51.28,0:18:57.26,Default,,0000,0000,0000,,وبعدما استعملت الحيلة قبل قليل \Nلقتل سوا-سان في الغرفة أسفلك بثلاثة طوابق
Dialogue: 0,0:18:57.60,0:19:01.10,Default,,0000,0000,0000,,رجعت للاستوديو قبل نهاية المقطع
Dialogue: 0,0:19:01.30,0:19:02.78,Default,,0000,0000,0000,,ألستُ محقاً؟
Dialogue: 0,0:19:04.51,0:19:09.97,Default,,0000,0000,0000,,ألديك دليلٌ قاطع على استعمالي هذه الحيلة؟
Dialogue: 0,0:19:10.14,0:19:11.23,Default,,0000,0000,0000,,ماتسو-سان
Dialogue: 0,0:19:11.43,0:19:13.93,Default,,0000,0000,0000,,ارتكبت خطأً واحداً
Dialogue: 0,0:19:14.20,0:19:18.52,Default,,0000,0000,0000,,في عجلتك، نسيت إطفاءه على الأرجح
Dialogue: 0,0:19:19.17,0:19:22.18,Default,,0000,0000,0000,,أجل، هاتفك الخلوي هو الدليل
Dialogue: 0,0:19:22.56,0:19:28.37,Default,,0000,0000,0000,,أفترض أنّك تعرف أنّ زرّ إعادة الاتصال\Nيبقى فعّالاً إذا لم تُطفئ الهاتف
Dialogue: 0,0:19:28.98,0:19:31.09,Default,,0000,0000,0000,,حضرة المفتش، جرّب الأمر
Dialogue: 0,0:19:38.16,0:19:40.21,Default,,0000,0000,0000,,!اتّصل بهاتف سوا-سان
Dialogue: 0,0:19:40.41,0:19:41.54,Default,,0000,0000,0000,,ماتسو-سان
Dialogue: 0,0:19:41.74,0:19:46.18,Default,,0000,0000,0000,,ألم تقل أنّك لم تعرف رقم هاتف سوا-سان؟
Dialogue: 0,0:19:46.58,0:19:51.64,Default,,0000,0000,0000,,و-وضعتُ هذا الهاتف على مكتبي قبل بدء البرنامج
Dialogue: 0,0:19:51.84,0:19:53.76,Default,,0000,0000,0000,,لا بدّ أنّ أحداً استعمله وقتها
Dialogue: 0,0:19:54.02,0:19:55.17,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:19:55.65,0:19:58.69,Default,,0000,0000,0000,,فقد استعملتُ الهاتف أثناء البرنامج
Dialogue: 0,0:19:58.84,0:20:01.66,Default,,0000,0000,0000,,وبافتراض أنّك لم تتصل بأحد بعدها
Dialogue: 0,0:20:01.86,0:20:04.72,Default,,0000,0000,0000,,فكان يُفترض أن يطلب الحانة التي اتّصلتُ بها
Dialogue: 0,0:20:04.95,0:20:09.07,Default,,0000,0000,0000,,من غيرك يمكنه استعمال الهاتف
Dialogue: 0,0:20:09.27,0:20:12.30,Default,,0000,0000,0000,,الذي وضعته في معطفك بعدما استعملتُه أنا؟
Dialogue: 0,0:20:12.70,0:20:14.14,Default,,0000,0000,0000,,!ماتسو-سان
Dialogue: 0,0:20:17.50,0:20:19.01,Default,,0000,0000,0000,,فشلت
Dialogue: 0,0:20:19.79,0:20:24.22,Default,,0000,0000,0000,,كانت غلطةً أن أستضيفك في حلقة اليوم يا موري-سان
Dialogue: 0,0:20:24.62,0:20:27.99,Default,,0000,0000,0000,,ماتسو-سان! يعني أنّك قتلته فعلاً؟
Dialogue: 0,0:20:28.19,0:20:29.16,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:29.79,0:20:34.43,Default,,0000,0000,0000,,لم أرد ترك دوري في استضافة البرنامج\Nالذي ابتكرناه معاً
Dialogue: 0,0:20:35.50,0:20:38.34,Default,,0000,0000,0000,,...قال سوا-سان أنّه صاحب الفكرة
Dialogue: 0,0:20:39.18,0:20:41.05,Default,,0000,0000,0000,,كان ذلك الاتّفاق
Dialogue: 0,0:20:42.14,0:20:45.44,Default,,0000,0000,0000,,يستحوذ على تقدير ابتكار البرنامج
Dialogue: 0,0:20:45.64,0:20:48.13,Default,,0000,0000,0000,,بينما أكون أنا المضيف
Dialogue: 0,0:20:48.76,0:20:51.88,Default,,0000,0000,0000,,مع ذلك أخبرني بالتنحّي فجأةً
Dialogue: 0,0:20:52.77,0:20:57.33,Default,,0000,0000,0000,,لم أستطع كبت غضبي
Dialogue: 0,0:20:58.71,0:21:01.89,Default,,0000,0000,0000,,...بالنظر للوراء، قبل بدء البرنامج
Dialogue: 0,0:21:02.34,0:21:06.76,Default,,0000,0000,0000,,كان تخطيطنا معاً أكثر ما استمتعتُ به
Dialogue: 0,0:21:07.15,0:21:09.31,Default,,0000,0000,0000,,فالقول الشائع أنّ التحضير للمهرجان
Dialogue: 0,0:21:09.51,0:21:14.67,Default,,0000,0000,0000,,أكثر تسليةً من بهرجة المهرجان نفسها
Dialogue: 0,0:21:16.66,0:21:21.79,Default,,0000,0000,0000,,لكن... لعل الكلام الآن لا يعدو \Nعن كونه مجرّد بهرجة
Dialogue: 0,0:23:01.12,0:23:02.26,Default,,0000,0000,0000,,كاميرا؟
Dialogue: 0,0:23:02.26,0:23:04.32,Default,,0000,0000,0000,,!أحسنت يا موري-كن
Dialogue: 0,0:23:06.59,0:23:07.92,Default,,0000,0000,0000,,!فعلتَها يا أبي
Dialogue: 0,0:23:07.92,0:23:09.55,Default,,0000,0000,0000,,!أنت محقق عظيم بحق
Dialogue: 0,0:23:10.09,0:23:11.49,Default,,0000,0000,0000,,ما الذي يتكلمان عنه؟
Dialogue: 0,0:23:11.69,0:23:14.32,Default,,0000,0000,0000,,!كان ذلك تحليلاً مذهلاً بالفعل يا عمّ
Dialogue: 0,0:23:14.52,0:23:17.22,Default,,0000,0000,0000,,...سأذهب لمكان الجميع الآن
Dialogue: 0,0:23:17.22,0:23:17.91,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:23:19.42,0:23:21.57,Default,,0000,0000,0000,,أخبرني يا فتى، ما الذي يجري؟
Dialogue: 0,0:23:21.77,0:23:23.34,Default,,0000,0000,0000,,!يوكو-تشان ليست هنا
Dialogue: 0,0:23:23.58,0:23:26.81,Default,,0000,0000,0000,,ودائماً ما يصيبني النعاس لسببٍ ما عندما أكون معك
Dialogue: 0,0:23:27.55,0:23:30.64,Default,,0000,0000,0000,,!تعال! ستشرح كلّ شيءٍ اليوم
Dialogue: 0,0:23:30.84,0:23:32.01,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:23:32.40,0:23:33.69,Default,,0000,0000,0000,,يوكو-تشان؟
Dialogue: 0,0:23:33.89,0:23:37.22,Default,,0000,0000,0000,,!رأيتُ استنتاجك المذهل على الشاشة
Dialogue: 0,0:23:37.58,0:23:39.99,Default,,0000,0000,0000,,كنتُ في جلسة تصوير دراما
Dialogue: 0,0:23:40.19,0:23:43.05,Default,,0000,0000,0000,,!لكنّي تأثّرتُ كثيراً وأسرعت إلى هنا
Dialogue: 0,0:23:43.36,0:23:45.66,Default,,0000,0000,0000,,...حسنًا، أنا
Dialogue: 0,0:23:45.86,0:23:47.73,Default,,0000,0000,0000,,!لم يكن شيئاً يُذكر
Dialogue: 0,0:23:54.70,0:23:57.70,Default,,0000,0000,0000,,لا أدري ما الذي حصل، لكنّي نجوت
Dialogue: 0,0:24:00.15,0:24:02.43,Default,,0000,0000,0000,,تكلّفت ران في اللبس هكذا
Dialogue: 0,0:24:02.78,0:24:06.18,Default,,0000,0000,0000,,أهي سعيدة لهذا الحدّ للخروج في موعد معي؟
Dialogue: 0,0:24:06.93,0:24:08.82,Default,,0000,0000,0000,,!لا يمكنها ذلك
Dialogue: 0,0:24:09.18,0:24:10.68,Default,,0000,0000,0000,,!فأنا كودو شينتشي
Dialogue: 0,0:24:13.49,0:24:14.40,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:24:17.88,0:24:19.86,Default,,0000,0000,0000,,جريمة قتل؟
Dialogue: 0,0:24:21.14,0:24:23.93,Default,,0000,0000,0000,,أيمكن أن ذلك الشخص تورّط؟
Dialogue: 0,0:24:24.69,0:24:26.02,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.22,0:24:28.84,Default,,0000,0000,0000,,جريمة قتل المقهى
Dialogue: 0,0:24:45.70,0:24:47.97,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.17,0:24:49.92,Default,,0000,0000,0000,,باب حجرة دورة مياه

