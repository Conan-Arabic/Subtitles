Dialogue: 0,0:00:02.78,0:00:04.46,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مذنّب لامع
Dialogue: 0,0:00:04.46,0:00:07.49,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.84,0:00:10.90,Default,,0000,0000,0000,,!يذهب العمّ في موعد عاطفيّ اليوم! تُستحدث مختلف الموجات
Dialogue: 0,0:00:11.45,0:00:12.99,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.99,0:00:14.87,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.87,0:00:16.41,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.06,0:01:57.20,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل موعد كوغورو العاطفيّ
Dialogue: 0,0:01:52.16,0:01:55.03,Default,,0000,0000,0000,,جريمة قتل موعد كوغورو العاطفيّ
Dialogue: 0,0:02:01.89,0:02:03.15,Default,,0000,0000,0000,,!لذيذة
Dialogue: 0,0:02:03.15,0:02:05.23,Default,,0000,0000,0000,,!طلب البيتزا كان خياراً صائباً
Dialogue: 0,0:02:05.23,0:02:09.93,Default,,0000,0000,0000,,بالفعل، لا يمكننا تناول عشاء\Nكهذا عندما يكون أبي موجوداً
Dialogue: 0,0:02:11.09,0:02:16.15,Default,,0000,0000,0000,,إنّه مهمل بحقّ، نسي كلّ أغراضه
Dialogue: 0,0:02:16.15,0:02:18.17,Default,,0000,0000,0000,,لا بدّ أنّه كان بغاية السرور
Dialogue: 0,0:02:18.17,0:02:21.04,Default,,0000,0000,0000,,فقد مضت 10 أعوام مُذ رأى صديقه، صحيح؟
Dialogue: 0,0:02:21.04,0:02:24.21,Default,,0000,0000,0000,,أجل، قال أنّه سيشرب بكثرة الليلة
Dialogue: 0,0:02:24.21,0:02:25.90,Default,,0000,0000,0000,,ويرجع في وقتٍ متأخّر
Dialogue: 0,0:02:27.58,0:02:29.08,Default,,0000,0000,0000,,!آسفٌ حقّاً
Dialogue: 0,0:02:29.08,0:02:31.82,Default,,0000,0000,0000,,يا إلهي، يا للتوقيت السيّئ
Dialogue: 0,0:02:32.20,0:02:35.07,Default,,0000,0000,0000,,لكن ربما ليس باليد الحيلة بما أنّها\Nحالة طارئة في الشركة
Dialogue: 0,0:02:35.07,0:02:38.65,Default,,0000,0000,0000,,سأحدّد موعداً لنجتمع مجدداً قريباً، إلى اللقاء
Dialogue: 0,0:02:43.94,0:02:48.94,Default,,0000,0000,0000,,سيصل القطار الثاني على خطّ\Nحلقة توتو قريباً
Dialogue: 0,0:02:48.94,0:02:52.05,Default,,0000,0000,0000,,انتظروا وراء الخطّ الأصفر لسلامتكم رجاءً
Dialogue: 0,0:02:53.86,0:02:56.72,Default,,0000,0000,0000,,لا تزال السابعة والنصف فقط؟
Dialogue: 0,0:02:56.72,0:02:59.57,Default,,0000,0000,0000,,كان عليّ الذهاب لمكانٍ آخر للشرب أكثر
Dialogue: 0,0:03:23.69,0:03:27.56,Default,,0000,0000,0000,,...ستّ محطّات حتّى محطّة بيكا
Dialogue: 0,0:03:37.59,0:03:40.15,On Top,,0000,0000,0000,,بيكا
Dialogue: 0,0:03:38.47,0:03:40.15,Default,,0000,0000,0000,,...بيكا
Dialogue: 0,0:03:42.13,0:03:43.70,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:03:47.79,0:03:52.32,Default,,0000,0000,0000,,كان ذلك وشيكاً، كدت أتجاوز محطّتي
Dialogue: 0,0:03:53.94,0:03:55.65,Default,,0000,0000,0000,,حلوى؟
Dialogue: 0,0:03:55.65,0:03:58.18,Default,,0000,0000,0000,,أكنتُ آكلها؟
Dialogue: 0,0:04:10.47,0:04:13.64,Default,,0000,0000,0000,,يا للمشهد الشاعريّ
Dialogue: 0,0:04:32.85,0:04:34.78,Default,,0000,0000,0000,,!إنّها أنتِ يا ساتشيكو-سان
Dialogue: 0,0:04:35.74,0:04:39.16,Default,,0000,0000,0000,,!أنا موري! موري كوغورو
Dialogue: 0,0:04:39.16,0:04:43.11,Default,,0000,0000,0000,,أتذكرين؟ التقينا عدّة مرّات\N!في مقهى بوارو أسفل مكتبي
Dialogue: 0,0:04:43.72,0:04:46.86,CharCard,,0000,0000,0004,,{\fad(300,50)}(شيمامورا ساتشيكو (31\Nمديرة شركة استيراد
Dialogue: 0,0:04:44.64,0:04:46.86,On Top,,0000,0000,0000,,ذاك المتحرّي الشهير، موري كوغورو-سان
Dialogue: 0,0:04:47.10,0:04:52.52,Default,,0000,0000,0000,,أجل! بالمناسبة، كان مجمع الشقق\Nالخاص بك بالجوار هنا، صحيح؟
Dialogue: 0,0:04:53.56,0:04:54.73,Default,,0000,0000,0000,,الثامنة؟
Dialogue: 0,0:04:54.97,0:04:57.99,Default,,0000,0000,0000,,كلا! نسيتُ ساعتي
Dialogue: 0,0:04:58.42,0:05:02.29,Default,,0000,0000,0000,,صحيح، ما رأيك بأن نذهب في نزهة\Nبالسيّارة يا موري-سان؟
Dialogue: 0,0:05:02.29,0:05:05.12,Default,,0000,0000,0000,,!أعرف مكاناً بمنظرٍ ليليّ جميل
Dialogue: 0,0:05:05.12,0:05:07.50,Default,,0000,0000,0000,,لكنّه ليس ممتعاً إذا لم يكن معك أحد
Dialogue: 0,0:05:07.50,0:05:09.20,Default,,0000,0000,0000,,هلّا رافقتني؟
Dialogue: 0,0:05:09.20,0:05:11.15,Default,,0000,0000,0000,,!يبدو ذلك رائعاً! لنذهب
Dialogue: 0,0:05:11.53,0:05:13.44,Default,,0000,0000,0000,,سأخرج السيّارة إذاً
Dialogue: 0,0:05:31.38,0:05:32.59,Default,,0000,0000,0000,,أتشعر بضيق؟
Dialogue: 0,0:05:32.59,0:05:36.09,Default,,0000,0000,0000,,يمكنك إرجاع الكرسيّ، توجد ذراع رفع تحت المقعد
Dialogue: 0,0:05:36.09,0:05:37.78,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:05:38.88,0:05:40.02,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:44.71,0:05:48.75,Default,,0000,0000,0000,,كنتُ أعمل في الشركة بمفردي\Nلوقتٍ متأخّر الليلة
Dialogue: 0,0:05:48.75,0:05:53.90,Default,,0000,0000,0000,,لكنّي شعرت بالقلق على زميلتي في الغرفة\Nالتي تعاني من زكام، ورجعت للتفقّد عليها
Dialogue: 0,0:05:54.24,0:05:56.61,Default,,0000,0000,0000,,أليس عليكِ العودة للشركة إذاً؟
Dialogue: 0,0:05:56.61,0:05:57.70,Default,,0000,0000,0000,,لا داعي
Dialogue: 0,0:05:57.70,0:06:02.65,Default,,0000,0000,0000,,الاستماع لقصص إنجازاتك في التحرّي\Nسيكون مفيداً لعملي أكثر
Dialogue: 0,0:06:03.81,0:06:06.77,Default,,0000,0000,0000,,!أنا مسرورٌ لأنّه غادر لحالته الطارئة
Dialogue: 0,0:06:06.77,0:06:08.98,Default,,0000,0000,0000,,!ولا يزال الليل في مقتبله
Dialogue: 0,0:06:18.38,0:06:20.94,On Top,,0000,0000,0000,,شيمامورا ساتشيكو\Nتاكيناكا كازومي
Dialogue: 0,0:06:19.38,0:06:20.94,Default,,0000,0000,0000,,استمتعتُ كثيراً الليلة
Dialogue: 0,0:06:20.94,0:06:23.54,Default,,0000,0000,0000,,!وأنا بدوري
Dialogue: 0,0:06:23.54,0:06:25.15,Default,,0000,0000,0000,,عمتَ مساءً إذاً
Dialogue: 0,0:06:25.62,0:06:26.92,Default,,0000,0000,0000,,!عمتِ مساءً
Dialogue: 0,0:06:28.63,0:06:30.11,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:06:30.41,0:06:33.44,Default,,0000,0000,0000,,الباب... ليس مقفلاً
Dialogue: 0,0:06:44.65,0:06:48.78,On Top,,0000,0000,0000,,الضحية هي تاكيناكا كازومي-سان، مضيفة في التاسعة والعشرين
Dialogue: 0,0:06:44.65,0:06:48.78,CharCard,,0000,0000,0004,,(تاكيناكا كازومي (29\Nمُضيفة
Dialogue: 0,0:06:49.15,0:06:54.44,Default,,0000,0000,0000,,كان موري-سان وزميلتها في الغرفة\Nشيمامورا ساتشيكو-سان من وجداها
Dialogue: 0,0:06:54.44,0:06:57.84,Default,,0000,0000,0000,,،بناءً على تصلّب فكّها السفلي وعنقها
Dialogue: 0,0:06:57.84,0:07:04.44,Default,,0000,0000,0000,,،فقد ماتت قبل ساعتين ونصف من الآن \Nأي عند قرابة التاسعة
Dialogue: 0,0:07:04.44,0:07:05.90,Default,,0000,0000,0000,,...مع ذلك
Dialogue: 0,0:07:08.33,0:07:11.99,Default,,0000,0000,0000,,موري-كن، لمَ هذان الاثنان هنا؟
Dialogue: 0,0:07:11.99,0:07:13.99,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:07:13.99,0:07:17.78,Default,,0000,0000,0000,,اتّصلت بهما لأخبرهما، لكنّهما أتيا من تلقاء نفسيهما
Dialogue: 0,0:07:18.24,0:07:21.73,Default,,0000,0000,0000,,لمَ كان أبي في شقّة فتاة؟
Dialogue: 0,0:07:24.69,0:07:27.11,Default,,0000,0000,0000,,هذه غرفة ساتشيكو-سان
Dialogue: 0,0:07:27.11,0:07:31.82,Default,,0000,0000,0000,,إنّها متّصلة بغرفة الضحيّة\Nعبر غرفة طعام ومطبخ
Dialogue: 0,0:07:32.43,0:07:36.30,Default,,0000,0000,0000,,وكما ترون، هذه النافذة مفتوحة قليلاً
Dialogue: 0,0:07:36.30,0:07:39.77,Default,,0000,0000,0000,,تقول أنّها ربما نسيت إقفالها
Dialogue: 0,0:07:39.77,0:07:43.40,Default,,0000,0000,0000,,أي أنّ القاتل دخل عبر هذه النافذة؟
Dialogue: 0,0:07:43.84,0:07:46.88,Default,,0000,0000,0000,,لكن كيف يستطيع الصعود\Nلشرفة في الطابق الثالث؟
Dialogue: 0,0:07:46.88,0:07:48.50,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:07:48.50,0:07:49.53,Default,,0000,0000,0000,,!أنت! هذا خطر
Dialogue: 0,0:07:50.33,0:07:54.91,Default,,0000,0000,0000,,!انظر، يمكنك القفز على الشرفة من سلالم الطوارئ
Dialogue: 0,0:07:54.91,0:07:56.49,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:07:58.49,0:08:02.32,Default,,0000,0000,0000,,لم ينتبه القاتل لكازومي-سان\Nالمريضة على فراشها غالباً
Dialogue: 0,0:08:02.77,0:08:06.07,Default,,0000,0000,0000,,،فبينما كان يبحث عن الأشياء القيّمة في المطبخ
Dialogue: 0,0:08:06.07,0:08:08.94,Default,,0000,0000,0000,,رأى كازومي-سان التي استيقظت من الجلبة
Dialogue: 0,0:08:08.94,0:08:11.06,Default,,0000,0000,0000,,!وطعنها في ردّة فعله
Dialogue: 0,0:08:12.06,0:08:14.60,Default,,0000,0000,0000,,ثمّ هرب من الباب الأمامي
Dialogue: 0,0:08:14.60,0:08:17.10,Default,,0000,0000,0000,,أي أنّها كانت جريمة سطو وقتل
Dialogue: 0,0:08:17.10,0:08:18.57,Default,,0000,0000,0000,,ذلك ما يبدو
Dialogue: 0,0:08:19.26,0:08:23.75,Default,,0000,0000,0000,,اعذريني على السؤال، لكن أين كنتِ عند التاسعة؟
Dialogue: 0,0:08:23.75,0:08:28.00,Default,,0000,0000,0000,,في ذاك الوقت، كنتُ أقود في نزهة مع موري-سان
Dialogue: 0,0:08:28.00,0:08:30.02,Default,,0000,0000,0000,,ماذا؟ مع موري-كن؟
Dialogue: 0,0:08:30.37,0:08:31.99,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:08:31.99,0:08:35.08,Default,,0000,0000,0000,,لكن يا أبي، ألم تكن ستلتقي صديقاً الليلة؟
Dialogue: 0,0:08:35.08,0:08:39.98,Default,,0000,0000,0000,,التقيتُه، لكن طرأ أمرٌ عاجل\Nفتعيّن عليه الذهاب
Dialogue: 0,0:08:40.48,0:08:46.32,Default,,0000,0000,0000,,فرجعتُ لمحطّة بيكا ومشيتُ\Nفي الشارع الثاني حتّى أصحو
Dialogue: 0,0:08:46.32,0:08:49.40,Default,,0000,0000,0000,,ثمّ التقيت بساتشيكو-سان\Nوراء مدرسة بيكا الإعداديّة
Dialogue: 0,0:08:49.40,0:08:51.90,Default,,0000,0000,0000,,وهي تهمّ بصعود السيّارة
Dialogue: 0,0:08:52.14,0:08:53.90,Default,,0000,0000,0000,,وراء المدرسة الإعداديّة
Dialogue: 0,0:08:54.14,0:08:55.22,Default,,0000,0000,0000,,متى كان ذلك؟
Dialogue: 0,0:08:55.22,0:08:59.81,Default,,0000,0000,0000,,عند الثامنة تقريباً، ذهبنا بعدها في نزهة بالسيّارة
Dialogue: 0,0:09:00.38,0:09:05.09,Default,,0000,0000,0000,,كانت تعرف مكاناً ممتازاً بمنظر\Nمطلّ على جسر خليج توتو
Dialogue: 0,0:09:05.09,0:09:08.24,Default,,0000,0000,0000,,ووصلنا هناك عند الثامنة والنصف تقريباً
Dialogue: 0,0:09:08.24,0:09:11.08,Default,,0000,0000,0000,,تحدّثنا بعدها لساعة ونصف
Dialogue: 0,0:09:11.08,0:09:15.95,Default,,0000,0000,0000,,بينما نشرب الجعّة والعصير اللذين\Nقامت بشرائهما من آلة البيع
Dialogue: 0,0:09:15.95,0:09:18.74,Default,,0000,0000,0000,,وغادرنا عند العاشرة وعشر دقائق
Dialogue: 0,0:09:18.74,0:09:22.15,Default,,0000,0000,0000,,مررنا بمكتبها في طريقنا لخمس دقائق
Dialogue: 0,0:09:22.15,0:09:26.14,Default,,0000,0000,0000,,ثمّ وصلنا لمجمع الشقق هذا عند العاشرة والخمسين
Dialogue: 0,0:09:27.53,0:09:31.35,Default,,0000,0000,0000,,ووجدنا الجثّة وقمنا بالاتّصال بك
Dialogue: 0,0:09:31.35,0:09:33.99,Default,,0000,0000,0000,,...أي أنّك
Dialogue: 0,0:09:33.99,0:09:36.32,Default,,0000,0000,0000,,أجل، أنا شاهد حجّة غيابها
Dialogue: 0,0:09:36.81,0:09:41.51,Default,,0000,0000,0000,,لكن، ما سرّ لقائك بموري-كن\Nوراء مدرسة بيكا الإعداديّة؟
Dialogue: 0,0:09:41.51,0:09:46.32,Default,,0000,0000,0000,,أدير شركة استيراد صغيرة في شارع أكيبونو
Dialogue: 0,0:09:46.59,0:09:48.99,Default,,0000,0000,0000,,كنتُ أعمل لوقتٍ متأخّر بمفردي الليلة
Dialogue: 0,0:09:49.38,0:09:52.73,Default,,0000,0000,0000,,لكنّي شعرت بالقلق على كازومي بما أنّها\Nكانت لزيمة الفراش بالزكام
Dialogue: 0,0:09:53.16,0:09:57.15,Default,,0000,0000,0000,,فرجعتُ لتفقّدها عند السابعة وخمسين دقيقة تقريباً
Dialogue: 0,0:09:57.66,0:10:00.98,Default,,0000,0000,0000,,هل التقيتِ كازومي-سان حينها؟
Dialogue: 0,0:10:01.45,0:10:04.99,Default,,0000,0000,0000,,التقيتُها؟ كانت تغطّ في النوم
Dialogue: 0,0:10:04.99,0:10:08.45,Default,,0000,0000,0000,,فلم أرد إيقاظها ورجعتُ لسيّارتي
Dialogue: 0,0:10:08.45,0:10:12.32,Default,,0000,0000,0000,,أخبريني، لمَ ركنتِ سيّارتك وراء المدرسة الإعداديّة؟
Dialogue: 0,0:10:12.32,0:10:13.39,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:13.39,0:10:16.64,Default,,0000,0000,0000,,لمَ لم تستعملي ساحة مواقف المبنى
Dialogue: 0,0:10:16.64,0:10:20.47,Default,,0000,0000,0000,,ساحة المواقف هنا بطابقين، فمن المتعب استعمالها
Dialogue: 0,0:10:20.47,0:10:23.05,Default,,0000,0000,0000,,وكنتُ أنوي العودة للشركة فوراً
Dialogue: 0,0:10:23.05,0:10:25.69,Default,,0000,0000,0000,,كان بإمكانك ركن السيّارة\Nأمام المبنى إذاً
Dialogue: 0,0:10:26.62,0:10:29.75,Default,,0000,0000,0000,,كنتُ لأعترض طريق الحافلات\Nالتي تمرّ أمامه
Dialogue: 0,0:10:35.98,0:10:37.72,Default,,0000,0000,0000,,"إلى شيمامورا ساتشيكو-ساما"
Dialogue: 0,0:10:38.48,0:10:40.10,Default,,0000,0000,0000,,هذا موجّه لك
Dialogue: 0,0:10:40.89,0:10:43.68,Default,,0000,0000,0000,,متى وصل هذا الطرد؟
Dialogue: 0,0:10:43.68,0:10:44.64,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:10:44.64,0:10:48.18,Default,,0000,0000,0000,,أكان هنا عندما أتيتِ\Nلتفقّد كازومي-سان؟
Dialogue: 0,0:10:48.51,0:10:50.88,Default,,0000,0000,0000,,لا، لا أتذكّر
Dialogue: 0,0:10:50.88,0:10:56.26,Default,,0000,0000,0000,,حسنٌ، سنتفقّد مع شركة التوصيل غداً
Dialogue: 0,0:11:02.79,0:11:04.55,Default,,0000,0000,0000,,هناك ما يضايقني
Dialogue: 0,0:11:04.62,0:11:07.29,Default,,0000,0000,0000,,ماذا؟ عظام السمكة؟
Dialogue: 0,0:11:07.29,0:11:11.98,Default,,0000,0000,0000,,كلا، سبب ركن ساتشيكو-سان لسيّارتها\Nوراء مدرسة بيكا الإعداديّة
Dialogue: 0,0:11:11.98,0:11:13.48,Default,,0000,0000,0000,,أخبرني يا أبي
Dialogue: 0,0:11:14.36,0:11:16.36,Default,,0000,0000,0000,,عمّا تكلّمت عند نقطة إطلالة جسر الخليج
Dialogue: 0,0:11:16.36,0:11:18.72,Default,,0000,0000,0000,,لساعة ونصف؟
Dialogue: 0,0:11:20.18,0:11:23.42,Default,,0000,0000,0000,,ولمَ ذهبت في نزهة بالسيّارة معها بالأصل؟
Dialogue: 0,0:11:24.06,0:11:25.76,Default,,0000,0000,0000,,...أيمكن أنّك يا أبي
Dialogue: 0,0:11:25.97,0:11:30.13,Default,,0000,0000,0000,,!ما-ما الذي تلمّحين له؟! لم أقم بأيّ شيءٍ شائن
Dialogue: 0,0:11:30.46,0:11:32.96,Default,,0000,0000,0000,,!أخبرني عمَّ تكلّمتما إذاً
Dialogue: 0,0:11:32.96,0:11:37.67,Default,,0000,0000,0000,,...لا أتذكّر كلّ شيءٍ قلناه! كما أنّي في المنتصف
Dialogue: 0,0:11:37.67,0:11:38.84,Default,,0000,0000,0000,,في المنتصف... ماذا؟
Dialogue: 0,0:11:38.84,0:11:40.13,Default,,0000,0000,0000,,...لا
Dialogue: 0,0:11:40.13,0:11:41.30,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:11:43.75,0:11:47.91,Default,,0000,0000,0000,,في الواقع، تكلّمنا لأوّل 30 دقيقة فقط
Dialogue: 0,0:11:47.91,0:11:50.30,Default,,0000,0000,0000,,ونمتُ بعمقٍ بعدها
Dialogue: 0,0:11:50.57,0:11:51.71,Default,,0000,0000,0000,,نمت؟
Dialogue: 0,0:11:51.94,0:11:55.97,Default,,0000,0000,0000,,أجل، غلبتني الثمالة بينما أشرب الجعّة
Dialogue: 0,0:11:56.44,0:11:58.93,Default,,0000,0000,0000,,وعندما أيقظتني، كانت الساعة قد تجاوزت العاشرة بقليل
Dialogue: 0,0:12:05.18,0:12:09.23,Default,,0000,0000,0000,,!طريف! نمت أثناء موعد
Dialogue: 0,0:12:09.40,0:12:11.30,Default,,0000,0000,0000,,...لا تضحكي! يا إلهي
Dialogue: 0,0:12:11.30,0:12:13.34,Default,,0000,0000,0000,,!لذا لم أرد قول شيء
Dialogue: 0,0:12:13.76,0:12:16.47,Default,,0000,0000,0000,,نام أثناء ذلك؟
Dialogue: 0,0:12:16.47,0:12:20.58,Default,,0000,0000,0000,,لكنّه كان مستيقظاً حتّى التاسعة يحادثها
Dialogue: 0,0:12:20.58,0:12:25.29,Default,,0000,0000,0000,,وقعت الجريمة حول التاسعة، حجّة غيابها متينة
Dialogue: 0,0:12:25.29,0:12:26.22,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:12:26.66,0:12:30.32,Default,,0000,0000,0000,,نسيتَ ساعة معصمك البارحة، صحيح يا عمّ؟
Dialogue: 0,0:12:30.32,0:12:32.86,Default,,0000,0000,0000,,كيف عرفتَ الوقت؟
Dialogue: 0,0:12:32.86,0:12:34.86,Default,,0000,0000,0000,,رأيتُ الساعة في السيّارة
Dialogue: 0,0:12:34.86,0:12:36.43,Default,,0000,0000,0000,,وقبل صعودك لها؟
Dialogue: 0,0:12:36.99,0:12:41.35,Default,,0000,0000,0000,,،كانت هناك ساعة في الحانة\Nورأيتُ الساعة في محطّة شيباهاما
Dialogue: 0,0:12:41.35,0:12:43.19,Default,,0000,0000,0000,,!ما كان الوقت؟
Dialogue: 0,0:12:43.19,0:12:44.38,Default,,0000,0000,0000,,السابعة والنصف
Dialogue: 0,0:12:44.38,0:12:45.69,Default,,0000,0000,0000,,السابعة والنصف؟
Dialogue: 0,0:12:47.64,0:12:50.80,Default,,0000,0000,0000,,،تحتاج 15 دقيقة من محطّة شيباهاما إلى محطّة بيكا
Dialogue: 0,0:12:50.80,0:12:54.55,Default,,0000,0000,0000,,وعشر دقائق مشياً من محطّة بيكا\Nلمدرسة بيكا الإعداديّة
Dialogue: 0,0:12:55.01,0:12:58.01,Default,,0000,0000,0000,,...أي أنّك التقيتَ ساتشيكو-سان عند
Dialogue: 0,0:12:58.47,0:13:00.96,Default,,0000,0000,0000,,!أخبرتُك عند الثامنة
Dialogue: 0,0:13:01.54,0:13:04.54,Default,,0000,0000,0000,,!سمعتُ جرس ساعة في منزلٍ قريب
Dialogue: 0,0:13:04.54,0:13:07.18,Default,,0000,0000,0000,,!فلتأكل طعامك وتذهب للمدرسة وحسب
Dialogue: 0,0:13:07.18,0:13:08.83,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:13:08.83,0:13:11.66,Default,,0000,0000,0000,,إنّه محق، عليّ نسيان الأمر فقط
Dialogue: 0,0:13:19.11,0:13:22.10,Default,,0000,0000,0000,,!ثلاث لفّات حول فناء المدرسة أمرٌ مرهق
Dialogue: 0,0:13:22.10,0:13:23.67,Default,,0000,0000,0000,,...لا أستطيع الاستمرار
Dialogue: 0,0:13:24.06,0:13:26.30,Default,,0000,0000,0000,,!بقي القليل! تماسك يا غينتا
Dialogue: 0,0:13:26.30,0:13:29.80,Default,,0000,0000,0000,,اسمع، التفكّير بأمرٍ تحبّه\Nيجعل الوقت يمضي أسرع
Dialogue: 0,0:13:30.05,0:13:31.80,Default,,0000,0000,0000,,أمر أحبّه؟
Dialogue: 0,0:13:31.80,0:13:34.59,Default,,0000,0000,0000,,!حسنٌ! سآكل علبة غداء أنقليس الليلة
Dialogue: 0,0:13:34.59,0:13:36.51,Default,,0000,0000,0000,,...علبة غداء أنقليس! علبة غداء أنقليس! الليلة
Dialogue: 0,0:13:36.51,0:13:38.93,Default,,0000,0000,0000,,!غينتا! لقد انتهينا
Dialogue: 0,0:13:38.93,0:13:42.13,Default,,0000,0000,0000,,كلا، إنّه منهمكٌ في التفكير بعلبة غداء الأنقليس
Dialogue: 0,0:13:42.13,0:13:44.67,Default,,0000,0000,0000,,لا بدّ أنّه سيقوم بلفّةٍ أخرى
Dialogue: 0,0:13:47.75,0:13:48.83,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:13:54.53,0:13:56.34,Default,,0000,0000,0000,,!دورة كاملة على خطّ الحلقة؟
Dialogue: 0,0:13:56.82,0:14:02.30,Default,,0000,0000,0000,,أيمكن أنّك غططت في النوم بعدما\Nصعدت القطار في محطّة شيباهاما؟
Dialogue: 0,0:14:02.77,0:14:05.15,Default,,0000,0000,0000,,تستغرق الدورة الكاملة على خطّ الحلقة ساعةً واحدة
Dialogue: 0,0:14:05.15,0:14:08.65,Default,,0000,0000,0000,,،إذا أتممتها بينما كنتَ نائماً
Dialogue: 0,0:14:08.65,0:14:14.38,Default,,0000,0000,0000,,فقد وصلتَ محطّة بيكا عند الثامنة\Nوأربعين دقيقة، وليس السابعة وأربعون
Dialogue: 0,0:14:14.93,0:14:19.50,Default,,0000,0000,0000,,!هراء! نمت لخمس عشرة دقيقة فحسب\N!يستحيل أنّني أتممت دورة
Dialogue: 0,0:14:19.50,0:14:21.96,Default,,0000,0000,0000,,لنتحقّق بأنفسنا إذاً
Dialogue: 0,0:14:21.96,0:14:22.84,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:23.09,0:14:26.00,Default,,0000,0000,0000,,!لنصعد خطّ الحلقة جميعاً الليلة
Dialogue: 0,0:14:26.00,0:14:30.05,Default,,0000,0000,0000,,نفس القطار ونفس العربة المغادران\N!لمحطّة شيباهاما عند السابعة والنصف
Dialogue: 0,0:14:31.49,0:14:33.72,Default,,0000,0000,0000,,لا أمانع ذلك
Dialogue: 0,0:14:42.94,0:14:45.77,Default,,0000,0000,0000,,إذاً يا أبي؟ أتذكّرت شيئاً؟
Dialogue: 0,0:14:45.77,0:14:49.85,Default,,0000,0000,0000,,كلا، يبدو أنّي كنت غائب العقل تماماً
Dialogue: 0,0:14:49.85,0:14:51.93,Default,,0000,0000,0000,,!لكن لا يمكن أنّها القاتلة
Dialogue: 0,0:14:51.93,0:14:54.38,Default,,0000,0000,0000,,لنكمل الدورة بأيّ حال، حسناً؟
Dialogue: 0,0:15:02.51,0:15:05.51,Default,,0000,0000,0000,,هذه أبعد محطّة من محطّة شيباهاما، صحيح؟
Dialogue: 0,0:15:16.08,0:15:19.73,Default,,0000,0000,0000,,ما الأمر؟ أتعرفون هذا الرجل؟
Dialogue: 0,0:15:19.73,0:15:21.30,Default,,0000,0000,0000,,!حلوى
Dialogue: 0,0:15:21.78,0:15:24.72,Default,,0000,0000,0000,,...كان هذا الرجل نائماً وفمه مفتوحاً بالأمس
Dialogue: 0,0:15:26.94,0:15:29.01,Default,,0000,0000,0000,,!فرمى هذا قطعة حلوى داخله
Dialogue: 0,0:15:34.68,0:15:36.14,Default,,0000,0000,0000,,متى كان ذلك؟
Dialogue: 0,0:15:36.14,0:15:38.05,Default,,0000,0000,0000,,مثل اليوم، عند الثامنة
Dialogue: 0,0:15:40.46,0:15:44.26,Default,,0000,0000,0000,,!ما يعني أنّي وصلت محطّة بيكا قبيل التاسعة
Dialogue: 0,0:15:44.26,0:15:48.05,Default,,0000,0000,0000,,!ووقت لقائي بساتشيكو-سان كان التاسعة
Dialogue: 0,0:15:48.05,0:15:51.71,Default,,0000,0000,0000,,أجل! وصلتِ نقطة إطلالة جسر\N!خليج توتو عند التاسعة والنصف
Dialogue: 0,0:15:52.67,0:15:54.59,Default,,0000,0000,0000,,!ثمّ تحادثتما لثلاثين دقيقة حتّى العاشرة
Dialogue: 0,0:15:55.55,0:15:57.26,Default,,0000,0000,0000,,!وأيقظتك عند العاشرة وعشر دقائق
Dialogue: 0,0:15:58.58,0:16:02.19,Default,,0000,0000,0000,,أخطأتَ في اعتقادك أنّك\N،كنت نائماً لساعة وعشر دقائق
Dialogue: 0,0:16:02.19,0:16:04.63,Default,,0000,0000,0000,,!بل نمت لعشر دقائق فحسب
Dialogue: 0,0:16:05.53,0:16:08.90,Default,,0000,0000,0000,,أي أنّها أعادت الساعة ساعةً واحدة
Dialogue: 0,0:16:08.90,0:16:11.59,Default,,0000,0000,0000,,لتجعلني أشهد على حجّة غيابها
Dialogue: 0,0:16:12.93,0:16:17.18,Default,,0000,0000,0000,,البارحة، ركنت سيّارتها في هذا المكان\Nالمخفيّ عن الأنظار
Dialogue: 0,0:16:17.18,0:16:20.05,Default,,0000,0000,0000,,وذهبت لقتل الضحيّة
Dialogue: 0,0:16:20.05,0:16:24.01,Default,,0000,0000,0000,,دخلت غرفتها من النافذة التي\Nتركتها مفتوحة سلفاً
Dialogue: 0,0:16:24.01,0:16:26.01,Default,,0000,0000,0000,,وأصدرت صوتاً مُتعمِّدة
Dialogue: 0,0:16:26.01,0:16:30.09,Default,,0000,0000,0000,,وقتلت الضحيّة التي استيقظت لتجعلها تبدو\Nجريمة سطو وقتل
Dialogue: 0,0:16:33.41,0:16:36.84,Default,,0000,0000,0000,,بعدها، رجعت إلى هنا والتقتك، صحيح؟
Dialogue: 0,0:16:39.00,0:16:41.30,Default,,0000,0000,0000,,...بالمناسبة، كان معها وقتها
Dialogue: 0,0:16:41.86,0:16:47.65,Default,,0000,0000,0000,,أكانت تلك الثياب المغطّاة بالدماء\Nوالقفّازات التي استعملتها في الجريمة؟
Dialogue: 0,0:16:49.60,0:16:53.88,Default,,0000,0000,0000,,في تلك الحالة، لا بدّ أنّها تخلصت منهما\Nعند نقطة الإطلالة بينما كنت نائماً
Dialogue: 0,0:16:55.44,0:16:59.68,Default,,0000,0000,0000,,قدّمت ساعة السيّارة بساعة واحدة قبل صعودك
Dialogue: 0,0:16:59.68,0:17:02.97,Default,,0000,0000,0000,,ثمّ أعادتها لطبيعتها بعدما كنت نائماً
Dialogue: 0,0:17:02.97,0:17:07.60,Default,,0000,0000,0000,,!اللعنة! كيف تجرؤ على التلاعب بالمتحرّي العظيم موري كوغورو؟
Dialogue: 0,0:17:07.80,0:17:10.05,Default,,0000,0000,0000,,أكان هناك شيءٌ آخر خارج المألوف؟
Dialogue: 0,0:17:14.87,0:17:17.22,Default,,0000,0000,0000,,رأى الأطفالُ موري-سان؟
Dialogue: 0,0:17:17.22,0:17:20.16,Default,,0000,0000,0000,,انهارت حجّة غيابك
Dialogue: 0,0:17:20.16,0:17:26.14,Default,,0000,0000,0000,,التقيتِ موري-كن وراء مدرسة\Nبيكا الإعداديّة بعد وقوع الجريمة
Dialogue: 0,0:17:28.95,0:17:33.23,Default,,0000,0000,0000,,لكن ألا يُحتمل أنّ الأطفال خلطوا بين موري-سان
Dialogue: 0,0:17:33.23,0:17:35.59,Default,,0000,0000,0000,,وشخص آخر يشبهه؟
Dialogue: 0,0:17:35.59,0:17:37.94,Default,,0000,0000,0000,,...ذلك مُحتمل
Dialogue: 0,0:17:37.94,0:17:41.17,Default,,0000,0000,0000,,،حتّى لو لم تكن حجّة غيابي تامّة
Dialogue: 0,0:17:41.89,0:17:45.64,Default,,0000,0000,0000,,فذلك لا يعني قتلي لكازومي
Dialogue: 0,0:17:46.26,0:17:51.09,Default,,0000,0000,0000,,!كلامكِ صحيح، لكن يوجد دليل
Dialogue: 0,0:17:52.79,0:17:55.26,Default,,0000,0000,0000,,أترك الأمر لك اليوم يا عمّ
Dialogue: 0,0:17:58.46,0:18:01.71,Default,,0000,0000,0000,,أتذكرين قلم الحبر الجافّ هذا؟
Dialogue: 0,0:18:02.95,0:18:06.72,Default,,0000,0000,0000,,!أجل، إنّه قلمك، أليس كذلك؟
Dialogue: 0,0:18:07.45,0:18:08.44,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:18:08.44,0:18:10.17,Default,,0000,0000,0000,,!أأنت بخير يا موري-كن؟
Dialogue: 0,0:18:10.52,0:18:13.63,Default,,0000,0000,0000,,!يا إلهي! أعليّ فعلها في النهاية؟
Dialogue: 0,0:18:15.81,0:18:19.84,Default,,0000,0000,0000,,لنرجع للثامنة والنصف قبل ليلتين
Dialogue: 0,0:18:20.64,0:18:26.39,Default,,0000,0000,0000,,،وصل رجل شركة شحن لتوصيل طرد\Nوخرجت كازومي-سان له
Dialogue: 0,0:18:26.39,0:18:29.05,Default,,0000,0000,0000,,لكنّها لم تجد ختمها الحبريّ
Dialogue: 0,0:18:29.05,0:18:30.88,Default,,0000,0000,0000,,،لم يكن أمامها خيارٌ آخر
Dialogue: 0,0:18:30.88,0:18:34.72,Default,,0000,0000,0000,,فوقّعت بقلم الحبر الجاف الذي\Nكان في غرفة الطعام
Dialogue: 0,0:18:34.72,0:18:36.75,Default,,0000,0000,0000,,لكنّه لم يكتب
Dialogue: 0,0:18:36.75,0:18:40.46,Default,,0000,0000,0000,,وفقما يبدو، فقد شكّ رجل التوصيل\Nبكون المشكلة في الحبر
Dialogue: 0,0:18:40.46,0:18:43.74,Default,,0000,0000,0000,,فأخرج القلم وتفقّده
Dialogue: 0,0:18:44.74,0:18:51.17,Default,,0000,0000,0000,,كان لا يزال هناك بعض الحبر، فحاولت كازومي-سان\Nالكتابة مجدداً، ونجحت
Dialogue: 0,0:18:52.73,0:18:59.26,Default,,0000,0000,0000,,عندما غادر رجل التوصيل، وضعت كازومي-سان\Nالقلم بجوار الهاتف في غرفة الطعام
Dialogue: 0,0:18:59.26,0:19:02.51,Default,,0000,0000,0000,,ورجعت للنوم في غرفتها مجدداً
Dialogue: 0,0:19:02.51,0:19:04.09,Default,,0000,0000,0000,,...وبعد عشرين دقيقة
Dialogue: 0,0:19:09.05,0:19:13.46,Default,,0000,0000,0000,,بعد رؤيتكِ لقلمك الذي\Nسقط بجوار الجثّة
Dialogue: 0,0:19:13.46,0:19:17.01,Default,,0000,0000,0000,,...حملتِه غريزياً لكونكِ المجرمة، ثمّ
Dialogue: 0,0:19:26.58,0:19:28.18,Default,,0000,0000,0000,,!إنها أنتِ يا ساتشيكو-سان
Dialogue: 0,0:19:30.57,0:19:34.53,Default,,0000,0000,0000,,بعدها، قمتِ بدعوتي لنزهةٍ بالسيّارة
Dialogue: 0,0:19:34.53,0:19:37.32,Default,,0000,0000,0000,,ونقلتِ الملابس والقفّازات\Nتحت مقعد الراكب الأمامي
Dialogue: 0,0:19:37.32,0:19:39.34,Default,,0000,0000,0000,,لأسفل المقاعد الخلفيّة
Dialogue: 0,0:19:39.89,0:19:43.43,Default,,0000,0000,0000,,عندها، سقط قلم الحبر السائل\Nالذي وضعتِه في جيبك
Dialogue: 0,0:19:48.35,0:19:53.34,Default,,0000,0000,0000,,يبدو أنّك لم تلحظي، لكن بعدما جلست\N،في مقعد الراكب الأمامي
Dialogue: 0,0:19:53.34,0:19:56.76,Default,,0000,0000,0000,,أسقطتُ قلمي من بدلتي بدوري
Dialogue: 0,0:19:58.46,0:20:00.66,Default,,0000,0000,0000,,يمكنكِ فهم ما حصل الآن
Dialogue: 0,0:20:00.66,0:20:06.14,Default,,0000,0000,0000,,ما حملتُه كان قلمك\Nالذي ظننتُ أنّه يخصّني
Dialogue: 0,0:20:10.15,0:20:15.84,Default,,0000,0000,0000,,وجدنا بصماتك وبصمات كازومي-سان\Nكما بصمات موري-كن على هذا القلم
Dialogue: 0,0:20:15.84,0:20:22.67,Default,,0000,0000,0000,,إضافةً لذلك، كانت بصمات رجل التوصيل على عصا الحبر
Dialogue: 0,0:20:22.67,0:20:28.43,Default,,0000,0000,0000,,هذه البصمات دليلٌ على دخولكِ الشقّة\N!بعد الثامنة والنصف
Dialogue: 0,0:20:28.43,0:20:29.63,Default,,0000,0000,0000,,ألستُ محقّاً؟
Dialogue: 0,0:20:33.67,0:20:36.34,Default,,0000,0000,0000,,!كانت كازومي تبتزّني
Dialogue: 0,0:20:37.76,0:20:46.47,Default,,0000,0000,0000,,قبل عام، استوردتُ وبعت بضائع محظورة في جهلي
Dialogue: 0,0:20:46.47,0:20:51.82,Default,,0000,0000,0000,,عرفت كازومي ذلك، وطلبت منّي دفع\Nمبلغ محدّد شهرياً
Dialogue: 0,0:20:51.82,0:20:57.40,Default,,0000,0000,0000,,هدّدت بإخبار المصرف وقطع التمويل\Nالذي أحتاجه إذا رفضت
Dialogue: 0,0:20:57.40,0:21:00.38,Default,,0000,0000,0000,,فلم يكن أمامي سوى الخضوع لها
Dialogue: 0,0:21:00.38,0:21:03.84,Default,,0000,0000,0000,,...لكن عندما فكّرتُ بابتزازها لي لبقيّة حياتي
Dialogue: 0,0:21:04.06,0:21:06.35,Default,,0000,0000,0000,,قرّرتِ قتلها
Dialogue: 0,0:21:06.35,0:21:07.81,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:21:07.81,0:21:12.30,Default,,0000,0000,0000,,،عندما ناداني موري-سان في الواقع\Nظننتُ أنّ أمري انتهى
Dialogue: 0,0:21:13.43,0:21:17.55,Default,,0000,0000,0000,,لكنّي أدركتُ أنّه متأخّر\Nفي حسابه للوقت بساعة
Dialogue: 0,0:21:17.55,0:21:19.25,Default,,0000,0000,0000,,فقرّرتُ استغلال ذلك لمصلحتي
Dialogue: 0,0:21:19.54,0:21:24.97,Default,,0000,0000,0000,,لكن كيف نويتِ صنع حجّة غيابٍ لك\Nفي حال لم يظهر موري-كن؟
Dialogue: 0,0:21:25.46,0:21:27.92,Default,,0000,0000,0000,,وضعتُ كاميرا فيديو موجّهة من نافذة مكتبي
Dialogue: 0,0:21:27.92,0:21:30.92,Default,,0000,0000,0000,,وصوّرتُ تسجيلاً للحانة على الشارع المقابل
Dialogue: 0,0:21:30.92,0:21:35.24,Default,,0000,0000,0000,,خطّطتُ لإخبار الشرطة أنّه \Nكان أحد الزبائن المغادرين
Dialogue: 0,0:21:35.24,0:21:36.59,Default,,0000,0000,0000,,وقت وقوع الجريمة
Dialogue: 0,0:21:37.07,0:21:40.48,Default,,0000,0000,0000,,مررتِ بمكتبك بعد جولتك مع موري-كن
Dialogue: 0,0:21:40.48,0:21:43.55,Default,,0000,0000,0000,,كي تزيلي كاميرا الفيديو تلك، صحيح؟
Dialogue: 0,0:21:43.85,0:21:48.97,Default,,0000,0000,0000,,أجل، الباقي كما استنتج موري-سان
Dialogue: 0,0:21:48.97,0:21:51.06,Default,,0000,0000,0000,,أعتذر على المتاعب التي تسبّبتُ بها
Dialogue: 0,0:23:27.55,0:23:29.55,Default,,0000,0000,0000,,أيمكنني سؤالك عن شيء؟
Dialogue: 0,0:23:30.13,0:23:35.21,Default,,0000,0000,0000,,كان بإمكانك قتل العمّ عندما نام\Nعند نقطة الإطلالة، صحيح؟
Dialogue: 0,0:23:35.21,0:23:36.09,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:23:37.29,0:23:41.01,Default,,0000,0000,0000,,لكنّك لم تفعلي ذلك، فلمَ؟
Dialogue: 0,0:23:43.64,0:23:48.56,Default,,0000,0000,0000,,لم أكن أكنّ أيّ ضغينة\Nتّجاه موري-سان
Dialogue: 0,0:24:04.71,0:24:07.89,Default,,0000,0000,0000,,هذا الوجه... رأيتُه في مكانٍ ما في الماضي
Dialogue: 0,0:24:11.45,0:24:14.25,Default,,0000,0000,0000,,بالمناسبة، أنت ترتدي النظّارات دوماً يا كونان-كن
Dialogue: 0,0:24:14.25,0:24:17.54,Default,,0000,0000,0000,,حتّى عند النوم وعند الاستحمام، لمَ؟
Dialogue: 0,0:24:17.54,0:24:19.16,Default,,0000,0000,0000,,لا-لا أستطيع الاسترخاء دونها
Dialogue: 0,0:24:21.87,0:24:24.08,On Top,,0000,0000,0000,,...مع شينتشي في عرض سحر
Dialogue: 0,0:24:24.08,0:24:30.07,On Top,,0000,0000,0000,,المتحرّي العظيم محاصَر! جريمتا قتل كبيرتان توالياً
Dialogue: 0,0:24:24.78,0:24:26.71,Default,,0000,0000,0000,,في الحلقة القادمة الخاصّة من كونان
Dialogue: 0,0:24:26.38,0:24:29.82,Default,,0000,0000,0000,,المتحرّي العظيم محاصَر! جريمتا قتل كبيرتان توالياً
Dialogue: 0,0:24:45.93,0:24:48.30,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.30,0:24:50.07,Default,,0000,0000,0000,,ممثلة مشهورة
Dialogue: 0,0:24:50.46,0:24:52.32,Default,,0000,0000,0000,,!الحلقة القادمة أوّل \Nحلقة خاصّة من ساعتين
Dialogue: 0,0:24:52.32,0:24:54.32,Default,,0000,0000,0000,,!حاولوا حلّ اللغزين

