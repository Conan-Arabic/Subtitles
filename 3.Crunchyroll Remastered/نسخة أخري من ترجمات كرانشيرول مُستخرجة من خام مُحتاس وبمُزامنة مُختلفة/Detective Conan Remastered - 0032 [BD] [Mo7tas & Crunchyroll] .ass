Dialogue: 0,0:00:01.04,0:00:04.43,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.73,0:00:06.23,Default,,0000,0000,0000,,مسرح اليوم هو مقهى
Dialogue: 0,0:00:06.43,0:00:08.19,Default,,0000,0000,0000,,هل زبون مجهول هو الفاعل؟
Dialogue: 0,0:00:08.69,0:00:10.34,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.54,0:00:12.44,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله لبالغ
Dialogue: 0,0:00:12.93,0:00:15.43,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.85,0:01:51.94,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل المقهى
Dialogue: 0,0:01:46.85,0:01:49.89,Default,,0000,0000,0000,,جريمة قتل المقهى
Dialogue: 0,0:02:01.23,0:02:03.18,Default,,0000,0000,0000,,أين تذهبين يا ران-نيتشان؟
Dialogue: 0,0:02:03.38,0:02:04.60,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:02:04.60,0:02:06.64,Default,,0000,0000,0000,,!ستذهبين للسينما؟ أريد الذهاب معك
Dialogue: 0,0:02:07.06,0:02:09.60,Default,,0000,0000,0000,,!صه! كلا، لديّ موعد
Dialogue: 0,0:02:09.80,0:02:10.73,Default,,0000,0000,0000,,موعد؟
Dialogue: 0,0:02:10.73,0:02:11.90,Default,,0000,0000,0000,,مع شينتشي
Dialogue: 0,0:02:12.10,0:02:13.93,Default,,0000,0000,0000,,هكذا إذاً، مع شينتشي-نيتشان؟
Dialogue: 0,0:02:14.59,0:02:19.10,Default,,0000,0000,0000,,سيغضب أبي إن عرف بالأمر\N لذا اكتم الأمر عنه، اتّفقنا؟
Dialogue: 0,0:02:19.30,0:02:21.28,Default,,0000,0000,0000,,!أجل، مع السلامة
Dialogue: 0,0:02:25.68,0:02:28.10,Default,,0000,0000,0000,,تكلّفت ران في اللبس هكذا
Dialogue: 0,0:02:28.30,0:02:31.69,Default,,0000,0000,0000,,أهي سعيدة لهذا الحدّ للخروج في موعد معي؟
Dialogue: 0,0:02:32.48,0:02:34.03,Default,,0000,0000,0000,,!لا يمكنها ذلك
Dialogue: 0,0:02:34.23,0:02:36.14,Default,,0000,0000,0000,,!فأنا كودو شينتشي
Dialogue: 0,0:02:36.34,0:02:38.77,Default,,0000,0000,0000,,من الذي ستقابله في موعدٍ إذاً؟
Dialogue: 0,0:02:39.20,0:02:40.88,Default,,0000,0000,0000,,اختلقت كذبةً لذلك حتّى
Dialogue: 0,0:02:44.64,0:02:46.27,Default,,0000,0000,0000,,حماقة
Dialogue: 0,0:02:46.47,0:02:49.48,Default,,0000,0000,0000,,يمكن لران الخروج مع من تشاء
Dialogue: 0,0:02:56.14,0:02:59.21,Default,,0000,0000,0000,,ألم أخبرك أنّي سأذهب لموعد اليوم؟
Dialogue: 0,0:02:59.41,0:03:01.64,Default,,0000,0000,0000,,لمَ تبعتني؟
Dialogue: 0,0:03:01.84,0:03:05.94,Default,,0000,0000,0000,,!لأنّي أريد رؤية شينتشي-نيتشان أيضاً
Dialogue: 0,0:03:06.14,0:03:08.59,Default,,0000,0000,0000,,...لكنّه تأخّر
Dialogue: 0,0:03:09.12,0:03:13.55,Default,,0000,0000,0000,,...في الحقيقة يا كونان-كن، من سأقابله اليوم ليس شينتشي
Dialogue: 0,0:03:14.18,0:03:19.21,Default,,0000,0000,0000,,ماذا؟ من إذاً الذي كذبتِ بشأن لقائه؟
Dialogue: 0,0:03:19.41,0:03:21.17,Default,,0000,0000,0000,,من؟
Dialogue: 0,0:03:21.78,0:03:25.76,Default,,0000,0000,0000,,شخصٌ عزيز عليّ... كثيراً
Dialogue: 0,0:03:27.71,0:03:29.57,Default,,0000,0000,0000,,أكثر من شينتشي-نيتشان حتّى؟
Dialogue: 0,0:03:29.77,0:03:33.10,Default,,0000,0000,0000,,أحمق! لا يمكنني مقارنتهما
Dialogue: 0,0:03:33.30,0:03:35.85,Default,,0000,0000,0000,,ما رأيك بأن ترجع للبيت الآن؟
Dialogue: 0,0:03:36.34,0:03:39.81,Default,,0000,0000,0000,,لم أعد أشعر برغبة في العودة لسببٍ ما
Dialogue: 0,0:03:40.20,0:03:43.02,Default,,0000,0000,0000,,وجدتُها، ألستَ تحب الكعك؟
Dialogue: 0,0:03:43.22,0:03:47.77,Default,,0000,0000,0000,,سأشتري لك واحدة لذا كُن مطيعاً وخذها وارجع
Dialogue: 0,0:03:48.44,0:03:50.39,Default,,0000,0000,0000,,آسفة، سأعود فوراً
Dialogue: 0,0:03:50.39,0:03:51.23,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:03:52.19,0:03:53.73,Default,,0000,0000,0000,,لا جدوى يا ران
Dialogue: 0,0:03:53.93,0:03:56.37,Default,,0000,0000,0000,,بقدراتي في الملاحظة والاستنتاج
Dialogue: 0,0:03:56.57,0:04:01.23,Default,,0000,0000,0000,,سأكتشف من ستلتقينه وأمعن النظر في وجهه
Dialogue: 0,0:04:03.86,0:04:07.18,Default,,0000,0000,0000,,لأنّ الحقيقة واحدة دوماً
Dialogue: 0,0:04:08.24,0:04:09.64,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:04:09.97,0:04:11.48,Default,,0000,0000,0000,,إنّها امرأة
Dialogue: 0,0:04:11.81,0:04:14.51,Default,,0000,0000,0000,,...أأنتِ بمفردك؟ يمكنك الجلوس عند المنضدة
Dialogue: 0,0:04:14.71,0:04:15.74,Default,,0000,0000,0000,,!آنستي
Dialogue: 0,0:04:17.71,0:04:18.89,Default,,0000,0000,0000,,قهوة
Dialogue: 0,0:04:19.28,0:04:22.35,On Top,,0000,0000,0000,,!القهوة تعني القهوة! هاتي كأساً بسرعة
Dialogue: 0,0:04:19.43,0:04:22.35,CharCard,,0000,0000,0000,,{\fad(300,0)}(هيمينو يايوي (24
Dialogue: 0,0:04:22.67,0:04:25.47,Default,,0000,0000,0000,,!يا لسلوك تلك المرأة
Dialogue: 0,0:04:26.40,0:04:30.18,Default,,0000,0000,0000,,ماذا؟ تشغلها ساعتها\N أيمكن أنّها هي؟
Dialogue: 0,0:04:30.47,0:04:33.21,Default,,0000,0000,0000,,...مستحيل، فهو
Dialogue: 0,0:04:34.01,0:04:36.11,Default,,0000,0000,0000,,شخصٌ عزيز عليّ
Dialogue: 0,0:04:36.31,0:04:37.64,Default,,0000,0000,0000,,...لذا أشكّ
Dialogue: 0,0:04:39.41,0:04:42.40,Default,,0000,0000,0000,,مرحباً، أأنت بمفردك؟\N ...في تلك الحالة
Dialogue: 0,0:04:43.00,0:04:46.37,On Top,,0000,0000,0000,,المعذرة، لديّ بحثٌ عليّ إنهاؤه
Dialogue: 0,0:04:46.35,0:04:48.56,On Top,,0000,0000,0000,,لذا أفضّل مقعداً هادئاً
Dialogue: 0,0:04:46.57,0:04:48.56,CharCard,,0000,0000,0000,,{\fad(300,0)}(سوميراغي يويتشي (25
Dialogue: 0,0:04:48.76,0:04:50.14,Default,,0000,0000,0000,,طالب جامعيّ
Dialogue: 0,0:04:50.51,0:04:52.22,Default,,0000,0000,0000,,لا يبدو أنّه هو أيضاً
Dialogue: 0,0:04:52.42,0:04:53.59,Default,,0000,0000,0000,,قهوة بالحليب من فضلك
Dialogue: 0,0:04:54.26,0:04:58.50,Default,,0000,0000,0000,,فلا أحد سيكتب بحثاً أمام شخص سيلتقيه
Dialogue: 0,0:05:00.52,0:05:02.06,Default,,0000,0000,0000,,امرأة هذه المرّة
Dialogue: 0,0:05:02.37,0:05:03.51,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:05:03.71,0:05:08.27,Default,,0000,0000,0000,,اتّفقت مع أحدهم على اللقاء هنا، لكن لا يبدو أنّه وصل بعد
Dialogue: 0,0:05:12.85,0:05:14.39,Default,,0000,0000,0000,,أيمكنني أخذ طلبك؟
Dialogue: 0,0:05:14.76,0:05:18.35,CharCard,,0000,0000,0000,,{\fad(300,0)}(37) كيساكي إيري
Dialogue: 0,0:05:16.16,0:05:18.35,On Top,,0000,0000,0000,,سأختار قهوة
Dialogue: 0,0:05:18.66,0:05:21.31,Default,,0000,0000,0000,,!يا لجمالها
Dialogue: 0,0:05:23.62,0:05:26.46,Default,,0000,0000,0000,,مكتب محاماة؟ أهي محامية؟
Dialogue: 0,0:05:26.66,0:05:29.36,Default,,0000,0000,0000,,يستحيل أن تلتقي ران بمحامية
Dialogue: 0,0:05:31.56,0:05:33.05,Default,,0000,0000,0000,,!تبّاً! ستوبّخني
Dialogue: 0,0:05:34.56,0:05:36.14,Default,,0000,0000,0000,,ماذا؟ توبّخني؟
Dialogue: 0,0:05:36.84,0:05:39.27,Default,,0000,0000,0000,,...كلّ ما فعلته هو النظر لها، فلمَ
Dialogue: 0,0:05:41.85,0:05:42.83,Default,,0000,0000,0000,,!مرحباً أيّها الساقي
Dialogue: 0,0:05:43.03,0:05:46.14,Default,,0000,0000,0000,,تونوياما-سان، ما حلّ بإصبعك؟
Dialogue: 0,0:05:46.47,0:05:52.44,CharCard,,0000,0000,0000,,{\fad(300,0)}(تونوياما جوزو (38
Dialogue: 0,0:05:46.76,0:05:49.52,On Top,,0000,0000,0000,,لويته في تمرين الرغبي
Dialogue: 0,0:05:49.72,0:05:52.44,On Top,,0000,0000,0000,,لا أستطيع إدخال خاتم زواجي الآن
Dialogue: 0,0:05:52.79,0:05:54.98,Default,,0000,0000,0000,,كلا، ليس هو
Dialogue: 0,0:05:55.18,0:06:00.89,Default,,0000,0000,0000,,فمن المستبعد أن يتجه شخص سيلتقي أحدهم\N لطاولة الشراب مباشرةً دون النظر في المكان
Dialogue: 0,0:06:01.23,0:06:03.13,Default,,0000,0000,0000,,ماذا؟ هل قصصت شعرك؟
Dialogue: 0,0:06:03.33,0:06:05.60,Default,,0000,0000,0000,,أجل، فكان قد بدأ يزعجني
Dialogue: 0,0:06:06.93,0:06:08.68,Default,,0000,0000,0000,,أين دورة المياه؟
Dialogue: 0,0:06:08.88,0:06:10.07,Default,,0000,0000,0000,,من هناك
Dialogue: 0,0:06:10.27,0:06:10.94,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:06:10.94,0:06:13.05,Default,,0000,0000,0000,,لكنّها دورة مياه مشتركة
Dialogue: 0,0:06:13.35,0:06:14.55,Default,,0000,0000,0000,,أعرف
Dialogue: 0,0:06:15.67,0:06:19.42,Default,,0000,0000,0000,,ماذا؟ كيف تعرف أنّها مشتركة لكن لا تعرف موقعها؟
Dialogue: 0,0:06:20.13,0:06:21.84,Default,,0000,0000,0000,,ربما لا يهمّ
Dialogue: 0,0:06:22.04,0:06:23.47,Default,,0000,0000,0000,,أعود لموعد ران
Dialogue: 0,0:06:23.98,0:06:27.36,Default,,0000,0000,0000,,عدم ظهور الطرف الثاني بعد\Nيعني أنّه موجود بالفعل
Dialogue: 0,0:06:27.56,0:06:28.89,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:06:30.12,0:06:31.47,Default,,0000,0000,0000,,أأنت بمفردك؟
Dialogue: 0,0:06:31.67,0:06:36.14,On Top,,0000,0000,0000,,اتّفقت مع فتاة على اللقاء هنا \Nلكن يبدو أنّها لم تأت بعد
Dialogue: 0,0:06:32.23,0:06:36.14,CharCard,,0000,0000,0000,,{\fad(300,0)}(واكاوجي شيرو (21
Dialogue: 0,0:06:36.45,0:06:37.93,Default,,0000,0000,0000,,اجلس هنا إذاً من فضلك
Dialogue: 0,0:06:37.93,0:06:38.69,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:06:42.07,0:06:43.34,Default,,0000,0000,0000,,قهوة ساخنة للآن
Dialogue: 0,0:06:44.48,0:06:47.52,Default,,0000,0000,0000,,...أيمكن، أيمكن أنّه
Dialogue: 0,0:06:50.48,0:06:52.14,Default,,0000,0000,0000,,!مرحباً، معك واكاوجي
Dialogue: 0,0:06:52.85,0:06:54.89,Default,,0000,0000,0000,,...ماذا؟ أنت يا يوشيو
Dialogue: 0,0:06:55.09,0:06:58.72,Default,,0000,0000,0000,,!لا تتّصل وأنا على وشك اللقاء بفتاة في مقهى
Dialogue: 0,0:06:58.90,0:07:03.50,Default,,0000,0000,0000,,إنّها الفتاة الظريفة التي أتت لمحطّة\Nالتلفاز في جولة ذاك اليوم
Dialogue: 0,0:07:03.70,0:07:05.14,Default,,0000,0000,0000,,محطّة التلفاز؟
Dialogue: 0,0:07:05.34,0:07:07.97,Default,,0000,0000,0000,,التي قُتل فيها المُنتج؟
Dialogue: 0,0:07:08.22,0:07:10.39,Default,,0000,0000,0000,,إنّها بريئة لحدٍّ نادر بالنسبة لفتيات هذه الأيام
Dialogue: 0,0:07:11.39,0:07:13.57,Default,,0000,0000,0000,,مثلها يكنّ منيعات؟
Dialogue: 0,0:07:13.77,0:07:17.47,Default,,0000,0000,0000,,!عامل الفتيات سأغراض... وسيصبحن لك
Dialogue: 0,0:07:18.27,0:07:19.94,Default,,0000,0000,0000,,!الوغد
Dialogue: 0,0:07:20.14,0:07:22.72,Default,,0000,0000,0000,,أجل، سأحرص على ألّا تكتشف بقية الفتيات
Dialogue: 0,0:07:22.92,0:07:23.96,Default,,0000,0000,0000,,إلى اللقاء
Dialogue: 0,0:07:25.55,0:07:26.82,Default,,0000,0000,0000,,سأريك
Dialogue: 0,0:07:27.02,0:07:31.77,Default,,0000,0000,0000,,سأستعمل حذاء مضاعفة قوّة الركل هذا\N!لسحق وجهك الأهبل
Dialogue: 0,0:07:31.93,0:07:32.98,Default,,0000,0000,0000,,!إيدوغاوا-ساما
Dialogue: 0,0:07:33.94,0:07:36.45,Default,,0000,0000,0000,,أيوجد إيدوغاوا-ساما بين الزبائن؟
Dialogue: 0,0:07:36.65,0:07:38.56,Default,,0000,0000,0000,,إنّه أنا
Dialogue: 0,0:07:38.76,0:07:39.95,Default,,0000,0000,0000,,اتّصال لك يا فتى
Dialogue: 0,0:07:40.15,0:07:40.99,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:07:41.19,0:07:42.36,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:07:42.55,0:07:43.46,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:07:43.66,0:07:44.64,Default,,0000,0000,0000,,!ران-نيتشان
Dialogue: 0,0:07:44.98,0:07:47.85,Default,,0000,0000,0000,,آسفة، لا يمكنني الرجوع بعد
Dialogue: 0,0:07:48.05,0:07:51.86,Default,,0000,0000,0000,,آلة حساب المتجر لا تعمل\Nولا أستطيع أخذ فكّتي
Dialogue: 0,0:07:52.06,0:07:54.80,Default,,0000,0000,0000,,أخبرني، هل أتى أحد يبحث عنّي؟
Dialogue: 0,0:07:55.68,0:07:58.14,Default,,0000,0000,0000,,رأيت الشخص، طويل الشعر
Dialogue: 0,0:07:58.32,0:08:00.27,Default,,0000,0000,0000,,!أجل، صحيح! ذاك هو
Dialogue: 0,0:08:00.47,0:08:04.01,Default,,0000,0000,0000,,...لكن غريب، لطالما كان الشعر مربوطاً
Dialogue: 0,0:08:04.62,0:08:06.69,Default,,0000,0000,0000,,أجل، ربطه للتو
Dialogue: 0,0:08:06.89,0:08:10.36,Default,,0000,0000,0000,,...انسي أمره يا ران-نيتشان، لا تلتقي بشاكلته
Dialogue: 0,0:08:10.74,0:08:13.04,Default,,0000,0000,0000,,!أصلحوا آلة الحساب! سأعود فوراً
Dialogue: 0,0:08:13.24,0:08:14.75,Default,,0000,0000,0000,,!ا-انتظري
Dialogue: 0,0:08:15.91,0:08:19.32,Default,,0000,0000,0000,,...تبّاً! لحظة مغادرة الوغد طويل الشعر ذاك للحمّام
Dialogue: 0,0:08:26.66,0:08:27.95,Default,,0000,0000,0000,,!ماذا هناك؟
Dialogue: 0,0:08:28.95,0:08:29.91,Default,,0000,0000,0000,,!دم؟
Dialogue: 0,0:08:30.47,0:08:31.53,Default,,0000,0000,0000,,!انتظر يا فتى
Dialogue: 0,0:08:33.83,0:08:36.22,Default,,0000,0000,0000,,!ماذا؟ يسدّه أحدهم
Dialogue: 0,0:08:39.99,0:08:40.73,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:08:46.93,0:08:50.56,Default,,0000,0000,0000,,!تبّاً! تأخّرت! لا بدّ أنّ ذاك الشخص غاضبٌ الآن
Dialogue: 0,0:08:50.76,0:08:52.23,Default,,0000,0000,0000,,ماذا؟ ماذا هناك؟
Dialogue: 0,0:08:53.64,0:08:55.45,Default,,0000,0000,0000,,أحصل شيءٌ هنا؟
Dialogue: 0,0:08:55.65,0:08:57.85,Default,,0000,0000,0000,,جريمة قتل
Dialogue: 0,0:08:58.57,0:09:00.20,Default,,0000,0000,0000,,!جريمة قتل؟
Dialogue: 0,0:09:01.03,0:09:04.14,Default,,0000,0000,0000,,أيمكن أنّه علق فيها؟
Dialogue: 0,0:09:06.05,0:09:11.48,Default,,0000,0000,0000,,كما تظهر هذه الصورة، كانت الضحيّة \Nعلى الأرض بجسدها يسدّ الباب
Dialogue: 0,0:09:12.04,0:09:13.70,Default,,0000,0000,0000,,أليس كذلك يا كونان-كن؟
Dialogue: 0,0:09:13.90,0:09:18.68,Default,,0000,0000,0000,,أجل، كان القفل مفتوحاً لكن الباب\Nلا يُفتح فنظرت من الأعلى
Dialogue: 0,0:09:19.17,0:09:22.84,Default,,0000,0000,0000,,الضحيّة هي هيمينو يايوي، 24 عاماً. عاطلة
Dialogue: 0,0:09:23.04,0:09:25.13,Default,,0000,0000,0000,,طعنة واحدة في القلب
Dialogue: 0,0:09:25.33,0:09:26.14,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:09:26.34,0:09:29.68,Default,,0000,0000,0000,,توجد علامات خنق رفيعة على عنقها
Dialogue: 0,0:09:31.02,0:09:33.12,Default,,0000,0000,0000,,،بناءً على بقع الدماء
Dialogue: 0,0:09:33.32,0:09:36.76,Default,,0000,0000,0000,,فقد خنقها القاتل حتّى فقدت وعيها ثمّ طعنها
Dialogue: 0,0:09:36.96,0:09:39.64,Default,,0000,0000,0000,,وسحب السكّين ليسبّب سيل الدماء
Dialogue: 0,0:09:40.43,0:09:42.72,Default,,0000,0000,0000,,رأت وجهه فشعر بالهلع بالتأكيد
Dialogue: 0,0:09:42.92,0:09:45.22,Default,,0000,0000,0000,,كانت فعلة لصّ غالباً
Dialogue: 0,0:09:45.65,0:09:47.62,Default,,0000,0000,0000,,...النافذة المفتوحة وباب الحجرة
Dialogue: 0,0:09:48.15,0:09:50.10,Default,,0000,0000,0000,,الرواق الخلفي الفارغ
Dialogue: 0,0:09:50.30,0:09:54.51,Default,,0000,0000,0000,,المحفظة الفارغة بجوار سلاح الجريمة وأغراض الضحيّة
Dialogue: 0,0:09:54.74,0:09:58.47,Default,,0000,0000,0000,,كما جثّة الضحية التي سدّت باب الحجرة
Dialogue: 0,0:09:58.64,0:10:02.65,Default,,0000,0000,0000,,،مما يعني أنّ القاتل دخل من النافذة\N ،وانتظر قدوم أحدهم
Dialogue: 0,0:10:02.85,0:10:05.77,Default,,0000,0000,0000,,،وقتل هيمينو-سان الذي صادف أنّها دخلت
Dialogue: 0,0:10:05.97,0:10:09.43,Default,,0000,0000,0000,,وسرق مالها ثمّ لاذ بالفرار سريعاً من النافذة
Dialogue: 0,0:10:09.84,0:10:11.76,Default,,0000,0000,0000,,!حسنٌ، كانت جريمة خارجية
Dialogue: 0,0:10:11.96,0:10:13.37,Default,,0000,0000,0000,,!فتّشوا المنطقة المجاورة
Dialogue: 0,0:10:13.57,0:10:15.39,Default,,0000,0000,0000,,!انتظر سيّدي المفتّش
Dialogue: 0,0:10:15.83,0:10:19.23,Default,,0000,0000,0000,,انظر لتلك النافذة! ألا تبدو نظيفةً لحدٍّ مُريب؟
Dialogue: 0,0:10:19.60,0:10:22.23,Default,,0000,0000,0000,,أين المشكلة في حمّام نظيف؟
Dialogue: 0,0:10:22.23,0:10:23.68,Default,,0000,0000,0000,,!لم أقصد ذلك
Dialogue: 0,0:10:23.88,0:10:27.01,Default,,0000,0000,0000,,الولد محقّ أيّها المفتّش المساعد ميغوري
Dialogue: 0,0:10:27.75,0:10:29.98,Default,,0000,0000,0000,,أم أنّك أصبحت مفتّشاً الآن؟
Dialogue: 0,0:10:30.16,0:10:32.07,Default,,0000,0000,0000,,!أنتِ المحامية كيساكي
Dialogue: 0,0:10:32.27,0:10:33.93,Default,,0000,0000,0000,,ماذا تفعلين هنا؟
Dialogue: 0,0:10:34.53,0:10:37.11,Default,,0000,0000,0000,,صادف أن كنتُ في هذا المقهى
Dialogue: 0,0:10:37.31,0:10:39.19,Default,,0000,0000,0000,,أتعرفها حضرة المفتّش؟
Dialogue: 0,0:10:39.39,0:10:41.35,Default,,0000,0000,0000,,...أجل، فهي
Dialogue: 0,0:10:41.77,0:10:45.04,Default,,0000,0000,0000,,،بأيّ حال، بناءً على كميّة الدماء المفقودة من الضحيّة
Dialogue: 0,0:10:45.24,0:10:48.14,Default,,0000,0000,0000,,يُفترض أن توجد بقع دماء على القاتل
Dialogue: 0,0:10:48.53,0:10:52.22,Default,,0000,0000,0000,,مع ذلك لا آثار للدماء على النافذة التي هرب منها
Dialogue: 0,0:10:52.41,0:10:53.51,Default,,0000,0000,0000,,هذا غير طبيعيّ
Dialogue: 0,0:10:53.67,0:10:56.79,Default,,0000,0000,0000,,لكن يمكن أنّ القاتل مسحها
Dialogue: 0,0:10:57.39,0:11:01.36,Default,,0000,0000,0000,,هل سيفعل قاتل رمى سلاح الجريمة وهرب هلعاً
Dialogue: 0,0:11:01.56,0:11:03.47,Default,,0000,0000,0000,,شيئاً كذلك؟
Dialogue: 0,0:11:04.51,0:11:07.95,Default,,0000,0000,0000,,ترك سلاح الجريمة لأنّه لا يستطيع أخذه
Dialogue: 0,0:11:08.15,0:11:10.43,Default,,0000,0000,0000,,أجل، كانت جريمة داخلية
Dialogue: 0,0:11:10.96,0:11:12.87,Default,,0000,0000,0000,,كان أحداً من الموجودين في المقهى
Dialogue: 0,0:11:13.29,0:11:15.84,Default,,0000,0000,0000,,أليس ذلك ما أردت قوله يا ولد؟
Dialogue: 0,0:11:16.59,0:11:18.02,Default,,0000,0000,0000,,لكن يا كيساكي-سان
Dialogue: 0,0:11:18.22,0:11:21.70,Default,,0000,0000,0000,,كانت الجثّة تسدّ باب الحجرة
Dialogue: 0,0:11:21.90,0:11:25.93,Default,,0000,0000,0000,,لا علامات على نقل الجثة ولا نافذة في الحجرة المجاورة
Dialogue: 0,0:11:26.27,0:11:29.56,Default,,0000,0000,0000,,كيف غادر القاتل الحجرة؟
Dialogue: 0,0:11:29.76,0:11:32.39,Default,,0000,0000,0000,,توجد طريقة واحدة، من الأعلى
Dialogue: 0,0:11:32.59,0:11:35.10,Default,,0000,0000,0000,,من الأعلى؟ قصدك تلك الفجوة؟
Dialogue: 0,0:11:35.49,0:11:38.17,Default,,0000,0000,0000,,لا يمكن لبالغ المرور منها
Dialogue: 0,0:11:38.37,0:11:41.49,Default,,0000,0000,0000,,أيمكنك محاولة صعودها؟
Dialogue: 0,0:11:42.31,0:11:44.80,Default,,0000,0000,0000,,الحجرة المجاورة كيلا نعبث بمسرح الجريمة
Dialogue: 0,0:11:48.38,0:11:50.27,Default,,0000,0000,0000,,مررت بطريقةٍ ما
Dialogue: 0,0:11:50.73,0:11:51.52,Default,,0000,0000,0000,,رأيت؟
Dialogue: 0,0:11:51.52,0:11:54.29,Default,,0000,0000,0000,,،لكن إن كان القاتل مُغطى بالدماء
Dialogue: 0,0:11:54.49,0:11:56.23,Default,,0000,0000,0000,,يُفترض أن تكون هناك آثار على الحائط عندما صعد
Dialogue: 0,0:11:56.43,0:12:01.14,Default,,0000,0000,0000,,لحسن الحظّ يوجد ماء لغسل الدمّ وورق للمسح
Dialogue: 0,0:12:01.34,0:12:05.06,Default,,0000,0000,0000,,فبإمكانه صعود الحائط دون ترك آثار
Dialogue: 0,0:12:05.26,0:12:09.02,Default,,0000,0000,0000,,لكن ماذا لو دخل أحدٌ صدفة ورآه؟
Dialogue: 0,0:12:09.92,0:12:11.89,Default,,0000,0000,0000,,لم تلحظ؟
Dialogue: 0,0:12:12.09,0:12:15.35,Default,,0000,0000,0000,,لباب مدخل دورة المياه قفل
Dialogue: 0,0:12:15.99,0:12:18.68,Default,,0000,0000,0000,,إقفاله يعني أنّ الغرفة ستكون عديمة المداخل
Dialogue: 0,0:12:18.94,0:12:23.07,Default,,0000,0000,0000,,حـ-حسنٌ! جِدوا جميع من دخلوا دورة المياه \N!وقت دخول الضحيّة
Dialogue: 0,0:12:23.27,0:12:24.75,Default,,0000,0000,0000,,!أنا أعرفهم
Dialogue: 0,0:12:25.35,0:12:26.81,Default,,0000,0000,0000,,فقد رأيتهم صدفةً
Dialogue: 0,0:12:27.01,0:12:28.16,Default,,0000,0000,0000,,حقاً؟
Dialogue: 0,0:12:29.65,0:12:32.80,Default,,0000,0000,0000,,كان أحدهم ذاك الشخص ضخم البنية
Dialogue: 0,0:12:33.19,0:12:34.76,Default,,0000,0000,0000,,والشخص بشعر الوجه الخفيف
Dialogue: 0,0:12:35.16,0:12:37.22,Default,,0000,0000,0000,,والشاب المختال بالشعر المربوط
Dialogue: 0,0:12:38.22,0:12:40.69,Default,,0000,0000,0000,,كـ-كما... هذه العمّة
Dialogue: 0,0:12:43.40,0:12:45.46,Default,,0000,0000,0000,,ذهبتِ لدورة المياه أيضاً؟
Dialogue: 0,0:12:45.66,0:12:47.10,Default,,0000,0000,0000,,أجل، بذكرك ذلك
Dialogue: 0,0:12:48.35,0:12:51.76,Default,,0000,0000,0000,,لديك ذاكرة جيّدة يا ولد، أحسنت
Dialogue: 0,0:12:52.43,0:12:54.51,Default,,0000,0000,0000,,أجل، نوعاً ما
Dialogue: 0,0:12:57.20,0:12:59.98,Default,,0000,0000,0000,,حسناً يا سادة، هلّا أخبرتمونا لمَ أتيتم اليوم
Dialogue: 0,0:13:00.18,0:13:03.09,Default,,0000,0000,0000,,بترتيب دخولكم لدورة المياه؟
Dialogue: 0,0:13:03.29,0:13:07.06,On Top,,0000,0000,0000,,حسناً، أتيتُ هنا لكتابة بحث اليوم
Dialogue: 0,0:13:03.68,0:13:07.06,CharCard,,0000,0000,0000,,{\fad(300,0)}طالب جامعيّ\Nسوميراغي يويتشي
Dialogue: 0,0:13:07.48,0:13:11.89,On Top,,0000,0000,0000,,دخلتُ بعده بينما لا زالت الضحية في الداخل
Dialogue: 0,0:13:07.72,0:13:14.76,CharCard,,0000,0000,0000,,{\fad(300,300)}محامية\N(كيساكي إيري (37
Dialogue: 0,0:13:12.26,0:13:15.26,On Top,,0000,0000,0000,,أتيتُ للمقهى للقاء أحدهم
Dialogue: 0,0:13:15.78,0:13:17.47,On Top,,0000,0000,0000,,دخلت بعدها
Dialogue: 0,0:13:15.97,0:13:21.23,CharCard,,0000,0000,0000,,{\fad(300,0)}مدرّب نادي رغبي في جامعة\N(تونوياما جوزو (38
Dialogue: 0,0:13:17.67,0:13:21.23,On Top,,0000,0000,0000,,آتي يومياً للكلام مع الساقي
Dialogue: 0,0:13:21.59,0:13:24.10,On Top,,0000,0000,0000,,أنا آخر من دخل
Dialogue: 0,0:13:21.77,0:13:26.18,CharCard,,0000,0000,0000,,{\fad(300,0)}موظّف في شركة إعلان\N(واكاوجي شيرو (21
Dialogue: 0,0:13:24.30,0:13:26.18,On Top,,0000,0000,0000,,كنتُ أنتظر فتاة
Dialogue: 0,0:13:26.76,0:13:29.52,Default,,0000,0000,0000,,أكان هذا الترتيب السليم يا كونان-كن؟
Dialogue: 0,0:13:29.72,0:13:30.64,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:13:31.32,0:13:32.67,Default,,0000,0000,0000,,ما هناك؟
Dialogue: 0,0:13:32.87,0:13:35.11,Default,,0000,0000,0000,,أشعر باختلاف شيءٍ عن قبل
Dialogue: 0,0:13:38.92,0:13:40.79,Default,,0000,0000,0000,,كان ذلك مروراً يسيراً
Dialogue: 0,0:13:40.99,0:13:42.68,Default,,0000,0000,0000,,أنتَ التالي يا واكاوجي-سان
Dialogue: 0,0:13:42.88,0:13:44.07,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,0:13:47.90,0:13:50.66,Default,,0000,0000,0000,,لا-لا يمكنني المرور وفقما يبدو
Dialogue: 0,0:13:52.14,0:13:53.84,Default,,0000,0000,0000,,مهلك
Dialogue: 0,0:13:54.86,0:13:56.93,Default,,0000,0000,0000,,ربما لا يمكنك حقاً يا أخّ
Dialogue: 0,0:13:57.13,0:13:58.94,Default,,0000,0000,0000,,هل عليّ فعل ذلك أيضاً؟
Dialogue: 0,0:13:59.14,0:14:01.39,Default,,0000,0000,0000,,كلا، يستحيل ذلك
Dialogue: 0,0:14:01.85,0:14:04.47,Default,,0000,0000,0000,,أفترض أنّ لا حاجة لتجربي يا كيساكي-سان
Dialogue: 0,0:14:04.67,0:14:07.28,Default,,0000,0000,0000,,كلا، فيمكنني المرور بلا مشكلة
Dialogue: 0,0:14:07.48,0:14:11.35,Default,,0000,0000,0000,,هذا يقلّص قائمة المشتبه بهم لي وسوميراغي-سان
Dialogue: 0,0:14:11.51,0:14:15.30,Default,,0000,0000,0000,,!كلا، لا أشتبه بك أبداً
Dialogue: 0,0:14:16.27,0:14:18.98,Default,,0000,0000,0000,,حضرة المفتش! وجدنا هذا الحبل \N!على طاولة سوميراغي-سان
Dialogue: 0,0:14:19.22,0:14:20.03,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:20.23,0:14:22.43,Default,,0000,0000,0000,,سوميراغي-سان، أيخصّك هذا؟
Dialogue: 0,0:14:22.73,0:14:26.63,Default,,0000,0000,0000,,!إنّه مجرد شريط أستعمله لربط كتبي ودفتر ملاحظاتي
Dialogue: 0,0:14:26.83,0:14:29.58,Default,,0000,0000,0000,,!لستُ القاتل! إنها الحقيقة
Dialogue: 0,0:14:30.33,0:14:33.22,Default,,0000,0000,0000,,دخل دورة المياه قبل الضحيّة
Dialogue: 0,0:14:33.42,0:14:34.73,Default,,0000,0000,0000,,إنه ليس القاتل
Dialogue: 0,0:14:35.22,0:14:38.03,Default,,0000,0000,0000,,سألت الضحيّة الساقي عن مكان دورة المياه
Dialogue: 0,0:14:38.23,0:14:42.50,Default,,0000,0000,0000,,كانت إشارةً للقاتل على أنّها \Nستذهب لدورة المياه غالباً
Dialogue: 0,0:14:42.70,0:14:48.04,Default,,0000,0000,0000,,ما يعني أنّ الشخص الوحيد الذي كان موجوداً\N...في المقهى وقتها وبإمكانه ارتكاب الجريمة
Dialogue: 0,0:14:49.03,0:14:51.19,Default,,0000,0000,0000,,!هو المحامية كيساكي فحسب
Dialogue: 0,0:14:56.17,0:14:58.64,Default,,0000,0000,0000,,حضرة المفتّش، أيمكننا أخذ السكّين للمركز؟
Dialogue: 0,0:14:58.84,0:15:00.10,Default,,0000,0000,0000,,أجل، لا مشكلة
Dialogue: 0,0:15:00.10,0:15:00.69,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:15:00.69,0:15:01.89,Default,,0000,0000,0000,,!دعني أرى
Dialogue: 0,0:15:02.08,0:15:03.01,Default,,0000,0000,0000,,!أنت، يا فتى
Dialogue: 0,0:15:03.33,0:15:04.91,Default,,0000,0000,0000,,هذه السكّين غريبة
Dialogue: 0,0:15:05.11,0:15:07.42,Default,,0000,0000,0000,,لمَ يوجد دم على الممسك؟
Dialogue: 0,0:15:07.62,0:15:10.98,Default,,0000,0000,0000,,كما لمَ لا توجد دماء على هذا الجزء الضيّق؟
Dialogue: 0,0:15:12.81,0:15:16.10,Default,,0000,0000,0000,,يوجد دم على راحة يدي\N ...مع أنّي لم ألمس الجثّة
Dialogue: 0,0:15:16.30,0:15:19.27,Default,,0000,0000,0000,,ربما انتقل عندما نظرتُ فوق الباب
Dialogue: 0,0:15:19.47,0:15:21.06,Default,,0000,0000,0000,,لمَ كان هناك دم في الأعلى؟
Dialogue: 0,0:15:22.59,0:15:25.10,Default,,0000,0000,0000,,..أشكّ أن الجثة نقلته هناك
Dialogue: 0,0:15:26.70,0:15:30.47,Default,,0000,0000,0000,,!فهمت الآن الحيلة الحقيقية التي استعملها القاتل
Dialogue: 0,0:15:30.67,0:15:31.94,Default,,0000,0000,0000,,،لا شكّ في الأمر
Dialogue: 0,0:15:32.13,0:15:35.01,Default,,0000,0000,0000,,!إنّه الوحيد القادر على فعل هذا
Dialogue: 0,0:15:35.70,0:15:37.77,Default,,0000,0000,0000,,...لكن لا دليل لديّ
Dialogue: 0,0:15:38.29,0:15:40.98,Default,,0000,0000,0000,,!يكفي من لعبة التحرّي يا ولد
Dialogue: 0,0:15:42.79,0:15:44.51,Default,,0000,0000,0000,,هذا عمل بالغين
Dialogue: 0,0:15:44.71,0:15:46.32,Default,,0000,0000,0000,,على الأطفال معرفة حدودهم
Dialogue: 0,0:15:46.52,0:15:48.45,Default,,0000,0000,0000,,...لكن، أنا
Dialogue: 0,0:15:50.25,0:15:51.80,Default,,0000,0000,0000,,خاتم زواج
Dialogue: 0,0:15:52.46,0:15:56.81,Default,,0000,0000,0000,,،ها هو! إن أصاب استنتاجي\N !سيكون دليلاً قاطعاً
Dialogue: 0,0:15:57.25,0:15:58.60,Default,,0000,0000,0000,,،إذاً يا سوميراغي-سان
Dialogue: 0,0:15:58.80,0:16:00.82,Default,,0000,0000,0000,,هلّا رافقتنا للمركز؟
Dialogue: 0,0:16:01.02,0:16:03.45,Default,,0000,0000,0000,,!لم أقتل أحداً
Dialogue: 0,0:16:04.69,0:16:07.39,Default,,0000,0000,0000,,!ماذا؟ يوجد دم هنا
Dialogue: 0,0:16:07.80,0:16:11.60,Default,,0000,0000,0000,,وجدتُه أيضاً عندما كنت ألتقط صوراً لمسرح الجريمة
Dialogue: 0,0:16:11.80,0:16:15.04,Default,,0000,0000,0000,,لمَ لم تخبرني قبلاً؟
Dialogue: 0,0:16:15.24,0:16:16.49,Default,,0000,0000,0000,,،بأيّ حال يا سوميراغي-سان
Dialogue: 0,0:16:16.69,0:16:19.43,Default,,0000,0000,0000,,الشبهة حولك تزداد أكثر فأكثر
Dialogue: 0,0:16:19.63,0:16:21.33,Default,,0000,0000,0000,,...لا-لا يمكن
Dialogue: 0,0:16:21.53,0:16:23.23,Default,,0000,0000,0000,,لكن أليس الأمر غريباً؟
Dialogue: 0,0:16:23.97,0:16:27.81,Default,,0000,0000,0000,,كان الدم فوق الباب الذي تسدّه الجثة
Dialogue: 0,0:16:28.01,0:16:32.53,Default,,0000,0000,0000,,لو كنت مكانه، لاستعملت المرحاض \Nلأتسلّق للحجرة المجاورة
Dialogue: 0,0:16:32.73,0:16:34.89,Default,,0000,0000,0000,,...معك حق
Dialogue: 0,0:16:35.47,0:16:39.48,Default,,0000,0000,0000,,وأتساءل إن كان القاتل مغطى بالدماء حقاً؟
Dialogue: 0,0:16:39.95,0:16:42.34,Default,,0000,0000,0000,,انظر للكيس الذي يحمله الشرطيّ
Dialogue: 0,0:16:42.60,0:16:45.44,Default,,0000,0000,0000,,السكّين مليئة ببقع الدمّ حتّى الممسك
Dialogue: 0,0:16:47.33,0:16:48.70,Default,,0000,0000,0000,,هذا غريب بالفعل
Dialogue: 0,0:16:48.90,0:16:51.81,Default,,0000,0000,0000,,وما هذا الجزء الخالي من الدم؟
Dialogue: 0,0:16:52.60,0:16:55.64,Default,,0000,0000,0000,,ربما كان هناك شيء مربوط حوله
Dialogue: 0,0:16:57.25,0:17:00.45,Default,,0000,0000,0000,,،فهمت! ربط القاتل خيطاً بالسكّين وطعنها
Dialogue: 0,0:17:00.65,0:17:03.04,Default,,0000,0000,0000,,!ثم سحبّها بعد مغادرة الحجرة
Dialogue: 0,0:17:03.24,0:17:05.85,Default,,0000,0000,0000,,!تطاير الدم عندما سُحبت السكين
Dialogue: 0,0:17:06.33,0:17:10.56,Default,,0000,0000,0000,,لكن لمَ يوجد دم في الأعلى\Nإذا لم يصب القاتل شيئاً منه؟
Dialogue: 0,0:17:10.76,0:17:13.54,Default,,0000,0000,0000,,لأنّ القاتل ليس من صعد الحجرة
Dialogue: 0,0:17:13.74,0:17:16.31,Default,,0000,0000,0000,,بل الجثّة
Dialogue: 0,0:17:16.51,0:17:18.35,Default,,0000,0000,0000,,الجثّة؟
Dialogue: 0,0:17:18.66,0:17:20.45,Default,,0000,0000,0000,,وصل الدم فوق الباب
Dialogue: 0,0:17:20.65,0:17:24.80,Default,,0000,0000,0000,,عندما رُميت الضحيّة للحجرة
Dialogue: 0,0:17:25.61,0:17:28.43,Default,,0000,0000,0000,,طعنها القاتل خارج الحجرة
Dialogue: 0,0:17:28.63,0:17:32.15,Default,,0000,0000,0000,,ثمّ رمى جثتها داخلها وسدّ الباب
Dialogue: 0,0:17:32.72,0:17:36.26,Default,,0000,0000,0000,,وسحب السكّين بجرّه للخيط
Dialogue: 0,0:17:36.99,0:17:39.65,Default,,0000,0000,0000,,،هكذا حتى لو اُكتشف أنّها جريمة داخلية
Dialogue: 0,0:17:39.85,0:17:42.36,Default,,0000,0000,0000,,يمكن للقاتل تفادي الشُبهات
Dialogue: 0,0:17:42.56,0:17:44.73,Default,,0000,0000,0000,,بما أنّ ليس بإمكانه المرور فوق باب الحجرة
Dialogue: 0,0:17:44.93,0:17:46.72,Default,,0000,0000,0000,,...أتقصدين أنّ القاتل
Dialogue: 0,0:17:48.35,0:17:50.69,Default,,0000,0000,0000,,!لا يمكن أن يكون سواك يا تونوياما-سان
Dialogue: 0,0:17:53.64,0:17:56.01,Default,,0000,0000,0000,,!حسنٌ، اعتقلوا هذا الرجل
Dialogue: 0,0:17:56.36,0:17:59.85,Default,,0000,0000,0000,,أيمكنكم اعتقالي حقاً دون دليل؟
Dialogue: 0,0:18:00.54,0:18:02.46,Default,,0000,0000,0000,,لدينا دليل بالطبع
Dialogue: 0,0:18:02.66,0:18:04.42,Default,,0000,0000,0000,,صحيح يا كيساكي-سان؟
Dialogue: 0,0:18:04.62,0:18:05.65,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:18:07.04,0:18:08.40,Default,,0000,0000,0000,,،حتّى لو اعتقلتموه
Dialogue: 0,0:18:08.60,0:18:13.26,Default,,0000,0000,0000,,لن تستغرقني أكثر من بضع ساعات لإبرائه\Nلو كنتُ محاميته
Dialogue: 0,0:18:13.49,0:18:14.76,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:18:14.96,0:18:18.35,Default,,0000,0000,0000,,فقد أتيتُ اليوم للحديث مع الساقي فحسب
Dialogue: 0,0:18:18.55,0:18:20.31,Default,,0000,0000,0000,,أجل، سمعتك
Dialogue: 0,0:18:20.51,0:18:22.98,Default,,0000,0000,0000,,لويت إصبعك أثناء لعب الرغبي
Dialogue: 0,0:18:23.18,0:18:25.64,Default,,0000,0000,0000,,...أجل، وبسبب ذلك لا يمكنني إدخال خاتم
Dialogue: 0,0:18:28.63,0:18:32.95,Default,,0000,0000,0000,,ماذا؟ ألا يضع الناس خاتم الزواج\Nعلى بنصرهم الأيسر غالباً؟
Dialogue: 0,0:18:33.15,0:18:37.03,Default,,0000,0000,0000,,كانت ضمادتك على بنصرك عندما \Nدخلت المقهى، أليس كذلك؟
Dialogue: 0,0:18:37.23,0:18:40.73,Default,,0000,0000,0000,,ربما... أعدت ربطها في دورة المياه؟
Dialogue: 0,0:18:40.88,0:18:45.80,Default,,0000,0000,0000,,هكذا إذاً! الضمادة كانت الخيط الذي \N!استعمله لخنق الضحيّة كما ما رُبط بالسكّين
Dialogue: 0,0:18:46.37,0:18:49.64,Default,,0000,0000,0000,,!ما يعني أنّ دم الضحية عليها بالتأكيد
Dialogue: 0,0:18:49.92,0:18:53.14,Default,,0000,0000,0000,,عجباً، يا للمجرم الساذج
Dialogue: 0,0:18:53.34,0:18:56.47,Default,,0000,0000,0000,,احتفظتَ بدليل كهذا عليك
Dialogue: 0,0:18:56.85,0:19:00.81,Default,,0000,0000,0000,,حتّى أنا لا يمكنني الدفاع عنك في المحكمة
Dialogue: 0,0:19:03.20,0:19:05.02,Default,,0000,0000,0000,,!ابتعدي يا امرأة
Dialogue: 0,0:19:13.51,0:19:15.55,Default,,0000,0000,0000,,!مُذهل! رمية كتف بيد واحدة
Dialogue: 0,0:19:15.75,0:19:17.14,Default,,0000,0000,0000,,!دعوني! تبّاً
Dialogue: 0,0:19:17.46,0:19:22.09,Default,,0000,0000,0000,,لحظة، رأيتُ رمية كتف اليد الواحدة هذه\N...قبلاً في مكانٍ ما
Dialogue: 0,0:19:22.51,0:19:26.18,Default,,0000,0000,0000,,اُعتقل القاتل بلا حوادث بفضل المُحامية
Dialogue: 0,0:19:26.38,0:19:30.06,Default,,0000,0000,0000,,يبدو أنّ سبب الجريمة كان علاقته\Nغير الشرعية مع الضحيّة
Dialogue: 0,0:19:30.66,0:19:35.18,Default,,0000,0000,0000,,وتهديدها له بإخبار زوجته إذا لم يتزوّجها
Dialogue: 0,0:19:38.12,0:19:43.80,Default,,0000,0000,0000,,حسناً، عليّ فعل شيء حيال هذا\N!المختال الذي سيلتقي ران
Dialogue: 0,0:19:45.82,0:19:46.93,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:19:47.13,0:19:49.91,Default,,0000,0000,0000,,!آسفة على التأخير! عانيت بالتأكيد
Dialogue: 0,0:19:50.11,0:19:51.23,Default,,0000,0000,0000,,!الوغد
Dialogue: 0,0:19:51.77,0:19:55.93,Default,,0000,0000,0000,,أخبرني، ما كان قصدك عندما قلت\N عامل الفتيات كأغراض وسيصبحن لك"؟"
Dialogue: 0,0:19:55.93,0:19:57.02,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:19:57.49,0:19:58.48,Default,,0000,0000,0000,,...قال ذلك قبلاً
Dialogue: 0,0:19:58.48,0:20:00.23,Default,,0000,0000,0000,,!انتظر! يا فتى
Dialogue: 0,0:20:00.43,0:20:01.93,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:20:02.39,0:20:03.96,Default,,0000,0000,0000,,من هذا الشخص؟
Dialogue: 0,0:20:05.33,0:20:07.05,Default,,0000,0000,0000,,أقال ذلك حقاً يا كونان-كن؟
Dialogue: 0,0:20:07.25,0:20:08.92,Default,,0000,0000,0000,,!سونوكو-تشان
Dialogue: 0,0:20:10.23,0:20:11.80,Default,,0000,0000,0000,,!أقلتها حقاً؟
Dialogue: 0,0:20:11.97,0:20:14.43,Default,,0000,0000,0000,,...لا بدّ أنّه خطأ ما
Dialogue: 0,0:20:15.49,0:20:17.44,Default,,0000,0000,0000,,!انتظري يا سونوكو-تشان
Dialogue: 0,0:20:17.64,0:20:20.91,Default,,0000,0000,0000,,كان ينتظر سونوكو؟
Dialogue: 0,0:20:21.11,0:20:24.15,Default,,0000,0000,0000,,من الذي كانت تنتظره ران إذاً؟
Dialogue: 0,0:20:24.35,0:20:26.81,Default,,0000,0000,0000,,ترتدين ثياب كهذه مُجدداً؟
Dialogue: 0,0:20:27.07,0:20:30.77,Default,,0000,0000,0000,,ألم أخبرك أنّ ارتداء التنورات القصيرة\N سيصيب معدتك بالبرد؟
Dialogue: 0,0:20:31.60,0:20:35.72,Default,,0000,0000,0000,,لا داعي لتعامليني كطفلة دوماً يا أمّي
Dialogue: 0,0:20:35.92,0:20:37.68,Default,,0000,0000,0000,,!أ-أ-أمّ... ماذا؟
Dialogue: 0,0:22:13.43,0:22:15.72,Default,,0000,0000,0000,,لمَ تتخفّى ورائي هكذا؟
Dialogue: 0,0:22:15.92,0:22:18.05,Default,,0000,0000,0000,,كان مفعماً بالقوّة حتّى قبل قليل
Dialogue: 0,0:22:18.25,0:22:21.66,Default,,0000,0000,0000,,حُلّت القضيّة بفضله
Dialogue: 0,0:22:21.86,0:22:23.18,Default,,0000,0000,0000,,أليس كذلك يا كونان-كن؟
Dialogue: 0,0:22:24.47,0:22:26.97,Default,,0000,0000,0000,,ماذا؟ يبدو أنّه لا يحبّني
Dialogue: 0,0:22:27.37,0:22:28.82,Default,,0000,0000,0000,,بالطبع لا
Dialogue: 0,0:22:29.02,0:22:33.24,Default,,0000,0000,0000,,فقد وبّختني على الدوام مع ران في صغرنا
Dialogue: 0,0:22:33.44,0:22:36.93,Default,,0000,0000,0000,,!أصبح جسدي يتفاعل لا إرادياً حولك
Dialogue: 0,0:22:37.43,0:22:40.65,Default,,0000,0000,0000,,...بالمناسبة، مضت 10 أعوام مذ تركتِ البيت
Dialogue: 0,0:22:40.85,0:22:41.88,Default,,0000,0000,0000,,لمَ تذكرين هذا فجأةً؟
Dialogue: 0,0:22:42.30,0:22:44.97,Default,,0000,0000,0000,,وتنسى وجه أحدهم بسهولة بعد 10 أعوام
Dialogue: 0,0:22:45.59,0:22:50.03,Default,,0000,0000,0000,,كنتُ أفكر أنّ الوقت ملائم الآن لترجعي لأبي
Dialogue: 0,0:22:50.40,0:22:55.68,Default,,0000,0000,0000,,!مستحيل، أُبغض ذاك المُغازل القذر الكسول الثمل
Dialogue: 0,0:22:56.38,0:23:00.02,Default,,0000,0000,0000,,...كلّ ما استفدته منه
Dialogue: 0,0:23:00.46,0:23:03.76,Default,,0000,0000,0000,,...هو أنت ورمية الكتف تلك
Dialogue: 0,0:23:03.96,0:23:05.91,Default,,0000,0000,0000,,لمَ تزوّجته إذاً؟
Dialogue: 0,0:23:06.11,0:23:08.08,Default,,0000,0000,0000,,كبرنا معاً
Dialogue: 0,0:23:08.28,0:23:09.82,Default,,0000,0000,0000,,وما سبب ارتدائك لخاتم زواجك؟
Dialogue: 0,0:23:10.02,0:23:12.47,Default,,0000,0000,0000,,طارد حشرات لإبعاد الرجال المزعجين
Dialogue: 0,0:23:12.70,0:23:14.43,Default,,0000,0000,0000,,!يا لعنادك
Dialogue: 0,0:23:14.83,0:23:16.64,Default,,0000,0000,0000,,...انتظر يا ماتسو-سان
Dialogue: 0,0:23:17.61,0:23:21.17,Default,,0000,0000,0000,,هذا مقطع للقضيّة التي حلّها أبي على التلفاز مؤخراً
Dialogue: 0,0:23:21.37,0:23:23.59,Default,,0000,0000,0000,,ألم تقولي أنّك أردتِ رؤيته؟
Dialogue: 0,0:23:24.33,0:23:29.20,Default,,0000,0000,0000,,ها هو الاتّصال الذي كان مفتاح حلّ القضيّة
Dialogue: 0,0:23:29.72,0:23:30.80,Default,,0000,0000,0000,,زوجتي؟
Dialogue: 0,0:23:31.00,0:23:33.26,Default,,0000,0000,0000,,!لا تقلقي! فنحن لم نعد معاً
Dialogue: 0,0:23:33.46,0:23:35.47,Default,,0000,0000,0000,,!لنقض ليلةً ساخنة اليوم
Dialogue: 0,0:23:35.67,0:23:37.93,Default,,0000,0000,0000,,...ليس كما تظنّين! كان
Dialogue: 0,0:23:38.13,0:23:40.94,Default,,0000,0000,0000,,يبدو ليس بإمكاني العودة بعد
Dialogue: 0,0:23:41.35,0:23:45.68,Default,,0000,0000,0000,,ران، احذري من المتحرّي صديق طفولتك أيضاً
Dialogue: 0,0:23:48.80,0:23:50.77,Default,,0000,0000,0000,,تجنّبي التعاسة
Dialogue: 0,0:23:52.54,0:23:53.98,Default,,0000,0000,0000,,!انتظري يا أمّي
Dialogue: 0,0:23:55.41,0:23:57.55,Default,,0000,0000,0000,,...يا وغد
Dialogue: 0,0:24:01.47,0:24:04.30,Default,,0000,0000,0000,,لا يبدو أنّهما مُتنزهان
Dialogue: 0,0:24:04.50,0:24:06.67,Default,,0000,0000,0000,,لديهما مجرف كما يرتديان بذلاً
Dialogue: 0,0:24:06.87,0:24:08.89,Default,,0000,0000,0000,,وما كانت تلك الخريطة؟
Dialogue: 0,0:24:24.26,0:24:25.50,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.70,0:24:28.33,Default,,0000,0000,0000,,قضيّة نجاة فرقة فتيان التحرّي
Dialogue: 0,0:24:45.69,0:24:47.76,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.96,0:24:49.93,Default,,0000,0000,0000,,خريطة كنز

