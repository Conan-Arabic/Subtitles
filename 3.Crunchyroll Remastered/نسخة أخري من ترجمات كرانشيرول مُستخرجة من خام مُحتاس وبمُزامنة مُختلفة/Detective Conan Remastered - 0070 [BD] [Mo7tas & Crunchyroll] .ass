Dialogue: 0,0:00:01.12,0:00:02.92,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:02.92,0:00:06.19,Default,,0000,0000,0000,,تُعالج استنتاجات كونان القلوب\Nالمُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:06.74,0:00:08.44,Default,,0000,0000,0000,,!اليوم هو جزء الحلّ أخيراً
Dialogue: 0,0:00:08.44,0:00:09.94,Default,,0000,0000,0000,,!مجرم غير متوقّع تحت القناع
Dialogue: 0,0:00:09.94,0:00:12.07,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.07,0:00:14.24,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.24,0:00:16.73,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.59,0:01:54.80,Default,,0000,0000,0000,,ذهبتُ مع ران والعمّ في جولة غموض إيزو
Dialogue: 0,0:01:54.80,0:01:59.13,Default,,0000,0000,0000,,مكان البروفسور آغاسا وصديقه وحفيدته\Nالذين لم يستطيعوا الحضور
Dialogue: 0,0:01:59.50,0:02:04.21,Default,,0000,0000,0000,,الهدف من هذه الجولة هو إيجاد\Nالمُنظّم الذي يختبئ بين المشاركين
Dialogue: 0,0:02:04.21,0:02:07.63,Default,,0000,0000,0000,,ومن يفعل، يحصل على أقراص مرنة\Nتحوي برنامجاً ما
Dialogue: 0,0:02:08.16,0:02:13.51,Default,,0000,0000,0000,,لكنّ إيبارا-سان الذي كان يرتدي زيّ بارون الليل \Nسقط على المطعم المفتوح ولقي حتفه
Dialogue: 0,0:02:14.20,0:02:16.30,Default,,0000,0000,0000,,!كانت جريمة قتل بكلّ وضوح
Dialogue: 0,0:02:16.94,0:02:22.72,Default,,0000,0000,0000,,كيف غادر القاتل بعد دفعه \Nإيبارا-سان من الشرفة؟
Dialogue: 0,0:02:23.59,0:02:27.42,Default,,0000,0000,0000,,ثمّ أفقد الشرطيّ حارس الجثّة وعيه\Nمع أنّه خبير في الكاراتيه
Dialogue: 0,0:02:27.42,0:02:30.01,Default,,0000,0000,0000,,!وظهر أمامنا بزيّ بارون الليل
Dialogue: 0,0:02:30.67,0:02:31.88,Default,,0000,0000,0000,,لم تنفع ركلات ران
Dialogue: 0,0:02:32.93,0:02:34.39,Default,,0000,0000,0000,,...أيمكن أنّ القاتل
Dialogue: 0,0:02:36.01,0:02:41.86,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل بارون الليل (جزء الحلّ
Dialogue: 0,0:02:37.01,0:02:40.40,Default,,0000,0000,0000,,(جريمة قتل بارون الليل (جزء الحلّ
Dialogue: 0,0:02:44.67,0:02:50.88,Default,,0000,0000,0000,,أكان ما قلتماه حقيقياً؟ أنّ الشرطي الذي\Nفقد وعيه خبيراً في الكاراتيه؟
Dialogue: 0,0:02:50.88,0:02:53.37,Default,,0000,0000,0000,,أجل، يمتلك حزام المستوى الثالث الأسود
Dialogue: 0,0:02:53.37,0:02:54.05,Default,,0000,0000,0000,,!صدقاً؟
Dialogue: 0,0:02:54.25,0:02:56.50,Default,,0000,0000,0000,,كيف هُزم شخص مثله؟
Dialogue: 0,0:02:56.99,0:03:00.63,Default,,0000,0000,0000,,!بالمناسبة، لم تصبه أيّ ركلات ران
Dialogue: 0,0:03:01.76,0:03:05.47,Default,,0000,0000,0000,,الوحيد بين المشتبه بهم الذي\N...يمتلك القدرة على التنبّؤ بحركاتها
Dialogue: 0,0:03:05.89,0:03:08.41,Default,,0000,0000,0000,,!هو بطل الكاراتيه الوطنيّ السابق، مايدا ساتورو
Dialogue: 0,0:03:08.54,0:03:10.24,Default,,0000,0000,0000,,لا أحد غيره
Dialogue: 0,0:03:10.24,0:03:15.10,Default,,0000,0000,0000,,لذا لم تلحق ران أو أكيكو-سان ببارون الليل آنذاك
Dialogue: 0,0:03:15.80,0:03:19.72,Default,,0000,0000,0000,,!أدركتا أنّه كان مايدا-سان
Dialogue: 0,0:03:21.09,0:03:21.83,Default,,0000,0000,0000,,...ران
Dialogue: 0,0:03:25.38,0:03:30.34,Default,,0000,0000,0000,,...ما قد يفعل شينتشي في هذا الوضع؟ شينتشي
Dialogue: 0,0:03:30.79,0:03:32.89,Default,,0000,0000,0000,,ماذا؟ إذا كنتُ أعرف القاتل؟
Dialogue: 0,0:03:33.16,0:03:35.76,Default,,0000,0000,0000,,أجل، لو كان المجرم البروفسور آغاسا مثلاً
Dialogue: 0,0:03:35.76,0:03:36.98,Default,,0000,0000,0000,,سأقولها
Dialogue: 0,0:03:36.98,0:03:38.65,Default,,0000,0000,0000,,ماذا؟ حقّاً؟
Dialogue: 0,0:03:38.65,0:03:41.38,Default,,0000,0000,0000,,أجل، سأصرّح بوضوح أنّه الفاعل
Dialogue: 0,0:03:42.70,0:03:44.43,Default,,0000,0000,0000,,كي تبدو رائعاً إذاً؟
Dialogue: 0,0:03:44.43,0:03:46.77,Default,,0000,0000,0000,,لن يكون هناك مكان للروعة
Dialogue: 0,0:03:46.77,0:03:49.29,Default,,0000,0000,0000,,فسأكون بحالٍ يُرثى لها آنذاك
Dialogue: 0,0:03:50.60,0:03:56.21,Default,,0000,0000,0000,,من إعياء البحث عن أعذار وتبريرات\Nقد تبرئ ساحته
Dialogue: 0,0:03:59.09,0:04:00.63,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:04:01.26,0:04:05.18,Default,,0000,0000,0000,,آسفة يا ساتورو، لو لم أقترح أن نشارك\N...في هذه الجولة
Dialogue: 0,0:04:05.18,0:04:08.51,Default,,0000,0000,0000,,لا بأس، فقد أردتُ القدوم
Dialogue: 0,0:04:08.51,0:04:11.47,Default,,0000,0000,0000,,كلّها غلطة بارون الليل
Dialogue: 0,0:04:11.47,0:04:14.18,Default,,0000,0000,0000,,...ساتورو، أيمكن أنّك
Dialogue: 0,0:04:15.39,0:04:17.30,Default,,0000,0000,0000,,كلا، لا شيء
Dialogue: 0,0:04:17.57,0:04:20.12,Default,,0000,0000,0000,,سأخلد للنوم، عُمت مساءً
Dialogue: 0,0:04:20.12,0:04:21.01,Default,,0000,0000,0000,,عُمتِ مساءً
Dialogue: 0,0:04:23.26,0:04:25.18,On Top,,0000,0000,0000,,غرفة استجواب\Nللأشخاص المعنيّين فقط
Dialogue: 0,0:04:27.44,0:04:28.85,Default,,0000,0000,0000,,محقق يوكوميزو
Dialogue: 0,0:04:28.85,0:04:31.73,Default,,0000,0000,0000,,أحضرنا غرضاً مفقوداً من غرفة الضحيّة
Dialogue: 0,0:04:31.73,0:04:32.89,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:04:33.23,0:04:36.30,Default,,0000,0000,0000,,يوجد شيء غريب على قفل الأمان
Dialogue: 0,0:04:36.30,0:04:37.32,Default,,0000,0000,0000,,ما هو؟
Dialogue: 0,0:04:37.32,0:04:39.13,Default,,0000,0000,0000,,دعني أرى
Dialogue: 0,0:04:43.59,0:04:48.01,Default,,0000,0000,0000,,أجل، هذا شريط لاصق شفّاف
Dialogue: 0,0:04:51.88,0:04:52.72,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:53.54,0:04:54.67,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:04:56.37,0:04:58.63,Default,,0000,0000,0000,,!من ربط قفل الأمان؟
Dialogue: 0,0:04:58.63,0:05:00.59,Default,,0000,0000,0000,,ربطتُه من الخارج
Dialogue: 0,0:05:01.55,0:05:03.51,Default,,0000,0000,0000,,باستعمال هذا الشريط اللاصق الشفّاف
Dialogue: 0,0:05:04.16,0:05:06.84,Default,,0000,0000,0000,,تقطعه بطول مناسب أوّلاً
Dialogue: 0,0:05:07.65,0:05:11.38,Default,,0000,0000,0000,,ثمّ تطويه وتترك بضعة سنتيمترات\Nفي الجانب اللاصق
Dialogue: 0,0:05:11.81,0:05:17.59,Default,,0000,0000,0000,,بعدها تضع القفل عامودياً بالنسبة للحائط\Nوتمدّ الشريط اللاصق عليه
Dialogue: 0,0:05:18.51,0:05:20.05,Default,,0000,0000,0000,,وتغلق الباب
Dialogue: 0,0:05:20.05,0:05:22.51,Default,,0000,0000,0000,,...بسحبك للشريط من الخارج
Dialogue: 0,0:05:24.47,0:05:26.54,Default,,0000,0000,0000,,!قُفل
Dialogue: 0,0:05:24.47,0:05:26.54,Default,,0000,0000,0000,,!قُفل
Dialogue: 0,0:05:27.17,0:05:31.34,Default,,0000,0000,0000,,تسحبه أكثر... ويُنزع الشريط\Nفيزول الدليل
Dialogue: 0,0:05:32.34,0:05:33.59,Default,,0000,0000,0000,,رأيتم؟
Dialogue: 0,0:05:33.59,0:05:38.91,Default,,0000,0000,0000,,لكن هل سينجح هذا من المرة الأولى؟\Nفغرف هذه الفندق آليّة القفل
Dialogue: 0,0:05:38.91,0:05:40.30,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:05:40.99,0:05:44.86,Default,,0000,0000,0000,,يمكنك التحقق من نجاح الإقفال من عدمه\Nإذا كان معك مفتاح الغرفة
Dialogue: 0,0:05:44.86,0:05:47.00,Default,,0000,0000,0000,,وحتّى إن قُطع الشريط اللاصق، يمكنك نزعه
Dialogue: 0,0:05:47.86,0:05:51.63,Default,,0000,0000,0000,,كما هذا الطرف خارج مجال نظر الفاعل
Dialogue: 0,0:05:52.15,0:05:55.88,Default,,0000,0000,0000,,!لذا لم ينتبه لتبقّي أثر للشريط
Dialogue: 0,0:05:56.22,0:06:01.01,Default,,0000,0000,0000,,بالمناسبة، ألم يكن المفتاح على الأرض\Nبجوار الباب مع الثياب؟
Dialogue: 0,0:06:01.01,0:06:03.34,Default,,0000,0000,0000,,!صحيح، فهمت
Dialogue: 0,0:06:03.81,0:06:09.63,Default,,0000,0000,0000,,بعدما أخذ الفاعل المفتاح من الضحيّة\Nوألبسه زيّ بارون الليل وأسقطه
Dialogue: 0,0:06:09.63,0:06:14.26,Default,,0000,0000,0000,,غادر الغرفة واستعمل الحيلة آنفة الذكر لقفل الباب
Dialogue: 0,0:06:14.26,0:06:20.27,Default,,0000,0000,0000,,وبعد تحققه من القفل، رمى المفتاح داخل الغرفة\Nمن فجوة الباب وهرب
Dialogue: 0,0:06:21.62,0:06:25.63,Default,,0000,0000,0000,,!هكذا تكون الغرفة مقفلة، ويمكن جعله يبدو حادثاً
Dialogue: 0,0:06:26.23,0:06:29.15,Default,,0000,0000,0000,,كيف اكتشفت هذه الحيلة؟
Dialogue: 0,0:06:29.15,0:06:31.34,Default,,0000,0000,0000,,رأيتها في مسلسل غموض على التلفاز
Dialogue: 0,0:06:32.23,0:06:37.30,Default,,0000,0000,0000,,المشكلة المتبقية الآن هي حجج غياب\Nالمُشتبه بهم الستّة
Dialogue: 0,0:06:37.77,0:06:40.26,Default,,0000,0000,0000,,...مايدا-سان الذي قال أنّه كان مع ران-سان وكونان
Dialogue: 0,0:06:40.26,0:06:43.22,Default,,0000,0000,0000,,وساياما-سان التي قالت أنّها كانت تشاهد التلفاز في غرفتها
Dialogue: 0,0:06:43.47,0:06:48.13,Default,,0000,0000,0000,,وكونّو-سان الذي قال أنّه كان يقرأ\Nبريده الإلكتروني في غرفته كذلك
Dialogue: 0,0:06:48.13,0:06:51.09,Default,,0000,0000,0000,,وكاميجو-سان التي كانت في الحانة مع موري-سان
Dialogue: 0,0:06:51.42,0:06:55.55,Default,,0000,0000,0000,,وكانيشيرو-سان وهاياشي-سان اللذان\Nكانا في المطعم المفتوح
Dialogue: 0,0:06:55.87,0:06:58.48,Default,,0000,0000,0000,,أعرف حجّة غياب ساياما-سان
Dialogue: 0,0:06:59.45,0:07:02.41,Default,,0000,0000,0000,,قالت أنّها اتّصلت بمكتب الاستقبال عند العاشرة
Dialogue: 0,0:07:02.62,0:07:06.63,Default,,0000,0000,0000,,أجل، طلبت اتّصال إيقاظ صباحي\Nعند العاشرة بالفعل
Dialogue: 0,0:07:07.26,0:07:12.07,Default,,0000,0000,0000,,أذكر اتّصالها، فقد كان بعدما سمعت صراخ الناس
Dialogue: 0,0:07:13.22,0:07:18.66,Default,,0000,0000,0000,,كان الضحيّة في الغرفة 2101، ربما لم يكن\N...بمقدورها ارتكاب الجريمة
Dialogue: 0,0:07:18.66,0:07:22.83,Default,,0000,0000,0000,,كانت أكيكو-سان مع ران وكونان\Nعندما التقيا بارون الليل أيضاً
Dialogue: 0,0:07:22.83,0:07:23.98,Default,,0000,0000,0000,,فهي بريئة
Dialogue: 0,0:07:25.28,0:07:30.70,Default,,0000,0000,0000,,لكن لمَ فعل القاتل ذلك؟ سرق زيّ بارون الليل حتّى
Dialogue: 0,0:07:31.11,0:07:34.02,Default,,0000,0000,0000,,لا بدّ أنّه كان قلقاً بعدما\Nاكتشفنا أنّها كانت جريمة قتل
Dialogue: 0,0:07:34.52,0:07:35.81,Default,,0000,0000,0000,,!لا شكّ بذلك
Dialogue: 0,0:07:35.81,0:07:36.48,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:07:37.69,0:07:40.40,Default,,0000,0000,0000,,ألديكم سجّلات لكونّو-سان\Nفي الغرفة 2002؟
Dialogue: 0,0:07:41.06,0:07:46.09,Default,,0000,0000,0000,,يُفترض أنّه استعمل خطّ الهاتف\Nلدخول الإنترنت حتّى بعد العاشرة بقليل
Dialogue: 0,0:07:46.09,0:07:51.11,Default,,0000,0000,0000,,أجل، استعمله من 9:45 حتّى 10:06
Dialogue: 0,0:07:51.59,0:07:55.75,Default,,0000,0000,0000,,لكن لا يعني ذلك أنّه كان يكلّم أحدهم
Dialogue: 0,0:07:55.75,0:07:57.07,Default,,0000,0000,0000,,يبدو مريباً لي
Dialogue: 0,0:07:57.60,0:08:01.07,Default,,0000,0000,0000,,كاميجو-سان التي كانت في الحانة معك\Nتبدو مريبة أيضاً
Dialogue: 0,0:08:01.07,0:08:03.28,Default,,0000,0000,0000,,...هـ-هذا الوغد
Dialogue: 0,0:08:03.47,0:08:05.42,CharCard,,0000,0000,0004,,الطابق الثاني لفندق الأميرة\N(حانة (الزمّرد
Dialogue: 0,0:08:05.56,0:08:08.69,Default,,0000,0000,0000,,!وضعت كاميجو-سان حبوباً في كأسي؟
Dialogue: 0,0:08:09.22,0:08:11.66,Default,,0000,0000,0000,,أجل، غلبك النوم بعدها
Dialogue: 0,0:08:11.95,0:08:16.31,Default,,0000,0000,0000,,كنتُ أعرف! تلك الحبوب بحوزتها حبوب منوّمة
Dialogue: 0,0:08:16.31,0:08:18.86,Default,,0000,0000,0000,,هل دسّتها في شراب العمّ لصنع حجّة غياب؟
Dialogue: 0,0:08:19.23,0:08:20.82,Default,,0000,0000,0000,,ماذا فعلت بعدها؟
Dialogue: 0,0:08:21.40,0:08:25.77,Default,,0000,0000,0000,,ذهبت لدورة المياه، لكنّها رجعت بعد 5 دقائق
Dialogue: 0,0:08:26.39,0:08:29.40,Default,,0000,0000,0000,,كانت هنا عندما وقعت الحادثة إذاً؟
Dialogue: 0,0:08:29.40,0:08:32.36,Default,,0000,0000,0000,,أجل، غادرت بعدما سمعت الجلبة
Dialogue: 0,0:08:35.21,0:08:37.99,Default,,0000,0000,0000,,أكان العجوز وخادمته هنا حقّاً؟
Dialogue: 0,0:08:37.99,0:08:43.45,Default,,0000,0000,0000,,أجل، هرعا لمقدمة الحشد بعدما سمعا بسقوط أحد
Dialogue: 0,0:08:43.69,0:08:45.48,Default,,0000,0000,0000,,المقدمة؟
Dialogue: 0,0:08:45.87,0:08:47.99,Default,,0000,0000,0000,,!تبّاً! اشتبهتُ بهما
Dialogue: 0,0:08:47.99,0:08:51.91,Default,,0000,0000,0000,,لا مشكلة، قلّصنا المشتبه بهم لاثنين الآن
Dialogue: 0,0:08:52.45,0:08:53.81,Default,,0000,0000,0000,,هذا صحيح
Dialogue: 0,0:08:54.73,0:08:58.48,Default,,0000,0000,0000,,الوحيدان دون حجّة غياب مؤكدة
Dialogue: 0,0:08:58.48,0:09:01.31,Default,,0000,0000,0000,,هما كونّو-سان ومايدا-سان فحسب
Dialogue: 0,0:09:01.31,0:09:04.68,Default,,0000,0000,0000,,كان مايدا-سان معنا في صالة المراقبة
Dialogue: 0,0:09:04.68,0:09:08.36,Default,,0000,0000,0000,,،لكنّه كان الوحيد الذي تفقّد الوقت\Nفكان بإمكانه تزييفه
Dialogue: 0,0:09:09.18,0:09:14.69,Default,,0000,0000,0000,,كما بوضع الشرطيّ في الاعتبار الذي \N...كان خبير كاراتيه وأفقده الفاعل وعيه
Dialogue: 0,0:09:16.88,0:09:19.00,Default,,0000,0000,0000,,...لا يتبين سوى أنّ الفاعل مايدا-سان
Dialogue: 0,0:09:19.00,0:09:19.99,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:09:20.59,0:09:22.21,Default,,0000,0000,0000,,...ران-نيتشان
Dialogue: 0,0:09:23.34,0:09:24.73,Default,,0000,0000,0000,,أ-أين أبي؟
Dialogue: 0,0:09:25.16,0:09:27.07,Default,,0000,0000,0000,,هناك، ما الخطب؟
Dialogue: 0,0:09:27.07,0:09:30.28,Default,,0000,0000,0000,,!وجدتُ حجّة غياب لمايدا-سان
Dialogue: 0,0:09:31.41,0:09:36.32,Default,,0000,0000,0000,,بعدما انفصل عنّا، التقى بمعجبتين له\N!عند مدخل الصالة
Dialogue: 0,0:09:36.98,0:09:41.24,Default,,0000,0000,0000,,!طلبتا منه توقيعه مع تدوين الوقت والتاريخ
Dialogue: 0,0:09:41.73,0:09:43.72,Default,,0000,0000,0000,,كان الوقت 10:03
Dialogue: 0,0:09:43.72,0:09:47.19,Default,,0000,0000,0000,,!إنّهما متأكدتان بما أنّهما نظرا لساعتيهما
Dialogue: 0,0:09:47.60,0:09:50.15,Default,,0000,0000,0000,,ألا يجدر بنا استدعاؤهما إذاً؟
Dialogue: 0,0:09:50.39,0:09:53.12,Default,,0000,0000,0000,,!معك حقّ، سأجلبهما سريعاً
Dialogue: 0,0:09:53.43,0:09:56.62,Default,,0000,0000,0000,,هكذا إذاً، لم يكن مايدا-سان الفاعل
Dialogue: 0,0:09:57.42,0:09:58.07,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:09:58.75,0:10:01.16,Default,,0000,0000,0000,,لمَ لم يذكر أمرهما عند استجوابه إذاً؟
Dialogue: 0,0:10:02.17,0:10:03.90,Default,,0000,0000,0000,,إنّها حجّة غياب مُحكمة
Dialogue: 0,0:10:04.29,0:10:06.36,Default,,0000,0000,0000,,ربما لم يستطع؟
Dialogue: 0,0:10:06.36,0:10:07.95,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:10:09.24,0:10:13.49,Default,,0000,0000,0000,,إنّه القلم الذي أوقعتُه! الحبر يسيل من صدمة السقوط
Dialogue: 0,0:10:13.94,0:10:18.11,Default,,0000,0000,0000,,لا عجب، فقد سقط من غرفة إيبارا-سان\Nفي الطابق 21
Dialogue: 0,0:10:18.11,0:10:18.94,Default,,0000,0000,0000,,...ماذا
Dialogue: 0,0:10:19.69,0:10:23.67,Default,,0000,0000,0000,,هذا غريب، سقط إيبارا-سان من نفس الشرفة\Nلكنّه وقع على التمثال
Dialogue: 0,0:10:24.48,0:10:26.94,Default,,0000,0000,0000,,...فهمت، جرفتُه الرياح
Dialogue: 0,0:10:27.43,0:10:28.20,Default,,0000,0000,0000,,الرياح؟
Dialogue: 0,0:10:29.44,0:10:31.60,Default,,0000,0000,0000,,!أيّتها النادلة
Dialogue: 0,0:10:31.60,0:10:32.36,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:32.36,0:10:35.32,Default,,0000,0000,0000,,أكانت الرياح تهبّ عندما سقط ذاك الشخص؟
Dialogue: 0,0:10:35.80,0:10:39.28,Default,,0000,0000,0000,,بالتفكير في الأمر، كانت هناك ريح قويّة
Dialogue: 0,0:10:39.76,0:10:42.59,Default,,0000,0000,0000,,تهبّ باستمرار ليلاً في هذا\Nالوقت من العام
Dialogue: 0,0:10:42.59,0:10:45.23,Default,,0000,0000,0000,,من يسار هذا التمثال ليمينه
Dialogue: 0,0:10:45.56,0:10:48.19,Default,,0000,0000,0000,,تُدعى بريح الأميرة، ومن سمات هذا المكان المعروفة
Dialogue: 0,0:10:48.66,0:10:51.16,Default,,0000,0000,0000,,رغم أنّ الريح في الأعلى أقوى
Dialogue: 0,0:10:51.70,0:10:52.53,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:10:53.00,0:10:55.48,Default,,0000,0000,0000,,...كان هناك مكان واحد حيث الريح
Dialogue: 0,0:11:00.01,0:11:03.32,Default,,0000,0000,0000,,كيف فاتني أمر بهذه البساطة؟
Dialogue: 0,0:11:03.72,0:11:06.61,Default,,0000,0000,0000,,!لا شكّ، القاتل هو ذاك الشخص
Dialogue: 0,0:11:06.61,0:11:10.57,Default,,0000,0000,0000,,ماذا؟! الشرطيّ الذي أُفقد وعيه\N!كان خبير كاراتيه؟
Dialogue: 0,0:11:11.64,0:11:14.17,Default,,0000,0000,0000,,!حسناً! عرفت الفاعل
Dialogue: 0,0:11:14.17,0:11:18.49,Default,,0000,0000,0000,,!سأبدأ شرح استنتاجاتي الآن! اجمعوا كلّ المشتبه بهم هنا
Dialogue: 0,0:11:18.72,0:11:19.84,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:19.84,0:11:21.03,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:11:21.03,0:11:22.73,Default,,0000,0000,0000,,!حضرة الضبّاط
Dialogue: 0,0:11:22.73,0:11:28.87,Default,,0000,0000,0000,,يريد عمّي المتحرّي أن تنفذوا المكتوب هنا\Nفي غرف المشتبه بهم
Dialogue: 0,0:11:28.87,0:11:30.28,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:11:30.28,0:11:32.29,Default,,0000,0000,0000,,يقول أنّها تجربة
Dialogue: 0,0:11:32.29,0:11:34.78,Default,,0000,0000,0000,,وستكشف هويّة الفاعل
Dialogue: 0,0:11:40.28,0:11:45.69,Default,,0000,0000,0000,,حسناً، بخصوص حجج غيابكم\Nوقت سقوط الضحيّة عند العاشرة
Dialogue: 0,0:11:46.35,0:11:54.31,Default,,0000,0000,0000,,تمّ التحقق من حجج غياب كانيشيرو-سان وهاياشي-سان \Nوساياما-سان وكاميجو-سان، هؤلاء الأربعة
Dialogue: 0,0:11:54.31,0:11:57.19,Default,,0000,0000,0000,,تبّاً! لم تظهر الإشارة بعد؟
Dialogue: 0,0:11:57.19,0:11:59.80,Default,,0000,0000,0000,,اللذان بحجّة غياب ضعيفة
Dialogue: 0,0:11:59.80,0:12:03.18,Default,,0000,0000,0000,,هما مايدا-سان الذي كان في صالة المراقبة
Dialogue: 0,0:12:03.18,0:12:05.61,Default,,0000,0000,0000,,وكونّو-سان الذي كان في غرفته
Dialogue: 0,0:12:06.08,0:12:10.33,Default,,0000,0000,0000,,لكن تصرّف القاتل بطيش بعد\Nارتكابه الجريمة وسرق زيّ بارون الليل
Dialogue: 0,0:12:10.33,0:12:12.78,Default,,0000,0000,0000,,من الغرفة التي كانت فيها الجثّة
Dialogue: 0,0:12:12.78,0:12:15.27,Default,,0000,0000,0000,,ثمّ مرّ بجماعة ساياما-سان
Dialogue: 0,0:12:15.91,0:12:21.24,Default,,0000,0000,0000,,لم يكن في علمه أنّ الشرطي\Nالذي أفقده وعيه كان خبيراً في الكاراتيه
Dialogue: 0,0:12:21.24,0:12:23.40,Default,,0000,0000,0000,,خبير في الكاراتيه؟
Dialogue: 0,0:12:23.98,0:12:24.98,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:24.98,0:12:28.19,Default,,0000,0000,0000,,الوحيد القادر على إفقاد شخص كهذا\N...وعيه بضربة واحدة
Dialogue: 0,0:12:29.23,0:12:32.85,Default,,0000,0000,0000,,هو بطل الكاراتيه الوطنيّ السابق، مايدا ساتورو-سان
Dialogue: 0,0:12:32.85,0:12:34.51,Default,,0000,0000,0000,,!انتظر يا أبي
Dialogue: 0,0:12:35.23,0:12:37.61,Default,,0000,0000,0000,,!لم يكن مايدا-سان الفاعل
Dialogue: 0,0:12:39.97,0:12:43.52,Default,,0000,0000,0000,,فقد كان معهما وقت وقوع الجريمة
Dialogue: 0,0:12:44.21,0:12:45.19,Default,,0000,0000,0000,,!إنّها الحقيقة
Dialogue: 0,0:12:44.21,0:12:45.19,Default,,0000,0000,0000,,!إنّها الحقيقة
Dialogue: 0,0:12:45.46,0:12:47.15,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:12:47.15,0:12:49.64,Default,,0000,0000,0000,,من كان الفاعل إذاً؟
Dialogue: 0,0:12:49.64,0:12:51.66,Default,,0000,0000,0000,,هلّا وضّحت الأمر؟
Dialogue: 0,0:12:52.96,0:12:54.57,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:12:54.57,0:12:58.28,Default,,0000,0000,0000,,!القاتل هو عديم حجّة الغياب، أنت يا كونّو شيرو
Dialogue: 0,0:12:59.12,0:13:01.74,Default,,0000,0000,0000,,!لا يخدعكم مظهره جميعاً
Dialogue: 0,0:13:02.45,0:13:06.53,Default,,0000,0000,0000,,قد يخفي الأمر، لكنّ هذا الرجل\N!خبير كاراتيه في الواقع
Dialogue: 0,0:13:09.31,0:13:10.82,Default,,0000,0000,0000,,...لا يمكن ذلك
Dialogue: 0,0:13:10.82,0:13:12.61,Default,,0000,0000,0000,,!كفّ عن العبث
Dialogue: 0,0:13:13.15,0:13:15.07,Default,,0000,0000,0000,,!ها هي! الإشارة
Dialogue: 0,0:13:15.68,0:13:17.78,Default,,0000,0000,0000,,!من القاتل؟
Dialogue: 0,0:13:17.78,0:13:21.11,Default,,0000,0000,0000,,موري-سان! هلّا أخبرتنا مباشرةً؟
Dialogue: 0,0:13:22.55,0:13:24.57,Default,,0000,0000,0000,,أأنت مُتحرٍّ عظيم حقّاً؟
Dialogue: 0,0:13:25.04,0:13:26.96,Default,,0000,0000,0000,,...كما أخبرتكم، القاتل
Dialogue: 0,0:13:30.59,0:13:31.75,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:13:33.09,0:13:35.61,Default,,0000,0000,0000,,لننه الهزل هنا
Dialogue: 0,0:13:35.61,0:13:37.16,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:13:37.16,0:13:41.83,Default,,0000,0000,0000,,تمهلي، هذه وضعية موري-سان الفريدة\Nعندما يبدأ شرح استنتاجاته
Dialogue: 0,0:13:41.83,0:13:43.38,Default,,0000,0000,0000,,أليس كذلك يا ران-سان؟
Dialogue: 0,0:13:43.38,0:13:44.02,Default,,0000,0000,0000,,!بلى
Dialogue: 0,0:13:44.27,0:13:51.18,Default,,0000,0000,0000,,قبل بدء تحليلي، أرجو أن تبتعدوا \Nعن التمثال وتتجنبوا الخطر
Dialogue: 0,0:13:53.64,0:13:54.98,Default,,0000,0000,0000,,ما الذي ستُقدم عليه؟
Dialogue: 0,0:13:54.98,0:13:56.28,Default,,0000,0000,0000,,تجربة
Dialogue: 0,0:14:07.88,0:14:08.99,Default,,0000,0000,0000,,ما-ما هذه؟
Dialogue: 0,0:14:08.99,0:14:13.44,Default,,0000,0000,0000,,ألحِفة أمرتُ بجعلها تبدو كالبشر\Nوإسقاطها من الأعلى
Dialogue: 0,0:14:13.95,0:14:18.36,Default,,0000,0000,0000,,من كلّ غرف المشتبه بهم، وبأرقامها عليها
Dialogue: 0,0:14:18.36,0:14:20.32,Default,,0000,0000,0000,,!غرفة 2101
Dialogue: 0,0:14:20.58,0:14:24.86,Default,,0000,0000,0000,,هذه غرفة الضحيّة إيبارا توكيو-سان\N!حيث وقعت الجريمة
Dialogue: 0,0:14:25.44,0:14:28.82,Default,,0000,0000,0000,,لكنّه سقط على التمثال مباشرة
Dialogue: 0,0:14:29.32,0:14:32.28,Default,,0000,0000,0000,,مهما كان للرياح تأثير، يستحيل أن يسقط\N...بعيداً لهذا الحد
Dialogue: 0,0:14:32.28,0:14:34.94,Default,,0000,0000,0000,,كان تأثير الرياح، المعروفة برياح الأميرة
Dialogue: 0,0:14:35.77,0:14:37.85,Default,,0000,0000,0000,,...تهبّ ريح قويّة
Dialogue: 0,0:14:36.76,0:14:44.94,On Top,,0000,0000,0000,,رياح الأميرة
Dialogue: 0,0:14:37.85,0:14:42.10,Default,,0000,0000,0000,,ليلاً على الفندق في هذا الموسم
Dialogue: 0,0:14:42.10,0:14:43.63,Default,,0000,0000,0000,,من يسار التمثال
Dialogue: 0,0:14:43.63,0:14:44.94,Default,,0000,0000,0000,,إلى يمينه
Dialogue: 0,0:14:45.51,0:14:50.86,Default,,0000,0000,0000,,كانت تهبّ وقت سقوط الضحيّة \Nإيبارا-سان أيضاً، صحيح أيّتها النادلة؟
Dialogue: 0,0:14:50.86,0:14:55.32,Default,,0000,0000,0000,,أ-أجل! أظنّها كانت تهبّ أقوى من الآن حينذاك
Dialogue: 0,0:14:55.32,0:15:01.28,Default,,0000,0000,0000,,كما كان يرتدي الضحيّة زيّ بارون الليل\Nالذي يسهل على الرياح حمله
Dialogue: 0,0:15:01.58,0:15:05.90,Default,,0000,0000,0000,,،لو أُلقي الضحيّة من شرفة غرفته
Dialogue: 0,0:15:05.90,0:15:09.96,Default,,0000,0000,0000,,فيصعب تصديق أنّه سيسقط على التمثال أسفلها تماماً
Dialogue: 0,0:15:10.28,0:15:13.64,Default,,0000,0000,0000,,حتّى اللحاف المُلقى من غرفة\Nكانيشيرو-سان التي تدنوها بطابق
Dialogue: 0,0:15:13.64,0:15:16.13,Default,,0000,0000,0000,,على الأرض بجوارها
Dialogue: 0,0:15:16.73,0:15:17.98,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:15:17.98,0:15:23.40,Default,,0000,0000,0000,,خدعنا القفّاز الذي كان عالقاً\N!بسوار الشرفة وحيلة الغرفة المقفلة
Dialogue: 0,0:15:24.26,0:15:27.48,Default,,0000,0000,0000,,...لم تكن حيلةً لجعلها تبدو حادثة فحسب
Dialogue: 0,0:15:27.48,0:15:30.45,Default,,0000,0000,0000,,!بلّ فخّاً لتزييف مكان وقوع الجريمة
Dialogue: 0,0:15:30.76,0:15:35.22,Default,,0000,0000,0000,,أجل، لم يقفل القاتل الغرفة\Nبعد ارتكاب الجريمة
Dialogue: 0,0:15:35.71,0:15:39.61,Default,,0000,0000,0000,,!أقفلها قبل ارتكاب الجريمة في غرفته الخاصة
Dialogue: 0,0:15:40.37,0:15:44.11,Default,,0000,0000,0000,,...ما يعني أنّ الأكثر شبهة\N!هي الألحِفة بجوار التمثال
Dialogue: 0,0:15:48.49,0:15:53.03,Default,,0000,0000,0000,,...غرفة 2102 لكاميجو-سان، وغرفة 2002 لكونّو-سان
Dialogue: 0,0:16:03.14,0:16:05.86,Default,,0000,0000,0000,,!غرفة 1901 لساياما-سان
Dialogue: 0,0:16:06.43,0:16:10.82,Default,,0000,0000,0000,,كانت مصادفة! فألحفة البقيّة حول التمثال أيضاً
Dialogue: 0,0:16:10.82,0:16:14.42,Default,,0000,0000,0000,,اختراق التمثال للحاف كان صدفة بالفعل
Dialogue: 0,0:16:14.42,0:16:16.28,Default,,0000,0000,0000,,!لكن موضع سقوطه ليس صدفة
Dialogue: 0,0:16:16.83,0:16:20.74,Default,,0000,0000,0000,,كما أنّ القاتل ليس كاميجو-سان ولا كونّو-سان
Dialogue: 0,0:16:20.74,0:16:26.11,Default,,0000,0000,0000,,فنافذتَي غرفتيهما على الجانب الآخر من شرفة الضحيّة
Dialogue: 0,0:16:26.11,0:16:30.11,Default,,0000,0000,0000,,بالنظر لمكان السقوط، يتّضح فورياً أنّ الضحيّة
Dialogue: 0,0:16:30.11,0:16:32.53,Default,,0000,0000,0000,,لم يسقط من هناك
Dialogue: 0,0:16:32.53,0:16:36.19,Default,,0000,0000,0000,,لكنّ غرفة ساياما-سان أسفلهما تماماً
Dialogue: 0,0:16:36.19,0:16:39.24,Default,,0000,0000,0000,,...لعلّ لحاف غرفتها سقط هناك بالمصادفة
Dialogue: 0,0:16:39.77,0:16:41.50,Default,,0000,0000,0000,,لم تكن مصادفة
Dialogue: 0,0:16:42.48,0:16:44.47,Default,,0000,0000,0000,,يوجد موضع واحد
Dialogue: 0,0:16:44.47,0:16:50.57,Default,,0000,0000,0000,,أسفل شرفة غرفة الضحيّة\Nحيث تكاد لا تكون هناك رياح
Dialogue: 0,0:16:52.64,0:16:55.96,Default,,0000,0000,0000,,اتّصالها بمكتب الاستقبال لصنع حجّة غياب
Dialogue: 0,0:16:55.96,0:17:00.07,Default,,0000,0000,0000,,ينقلب ليثبت أنّها كانت\Nفي غرفتها وقت وقوع الجريمة
Dialogue: 0,0:17:00.38,0:17:02.03,Default,,0000,0000,0000,,...القاتل إذاً
Dialogue: 0,0:17:04.45,0:17:08.99,Default,,0000,0000,0000,,!كـ-كلا! أنا القاتل! أنا من دفع ذاك الرجل
Dialogue: 0,0:17:08.99,0:17:12.95,Default,,0000,0000,0000,,!لا علاقة لأكيكو! ودليل ذلك أنّها واجهت القاتل
Dialogue: 0,0:17:12.95,0:17:16.07,Default,,0000,0000,0000,,!أنا بزيّ بارون الليل
Dialogue: 0,0:17:16.07,0:17:19.86,Default,,0000,0000,0000,,...أجل، كان أنا! كلّه من فعلي
Dialogue: 0,0:17:19.02,0:17:19.86,Default,,0000,0000,0000,,ساتورو
Dialogue: 0,0:17:20.27,0:17:24.77,Default,,0000,0000,0000,,كان أنت من قام بذلك\N...للتغطية عليّ إذاً
Dialogue: 0,0:17:24.82,0:17:26.27,Default,,0000,0000,0000,,للتغطية عليك؟
Dialogue: 0,0:17:26.27,0:17:27.39,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:17:27.39,0:17:32.51,Default,,0000,0000,0000,,سرق مايدا-سان زيّ بارون الليل وظهر أمامها
Dialogue: 0,0:17:32.51,0:17:35.19,Default,,0000,0000,0000,,لتبرئتها من الشبهة
Dialogue: 0,0:17:35.59,0:17:38.00,Default,,0000,0000,0000,,لكنّه لم يكن مُعاوناً في الجريمة
Dialogue: 0,0:17:38.00,0:17:42.75,Default,,0000,0000,0000,,فعل ذلك من تلقاء نفسه\Nبعدما أدرك حقيقة الجريمة وفاعلها
Dialogue: 0,0:17:42.75,0:17:46.44,Default,,0000,0000,0000,,أجل، بعد رؤيته لعقدة ربط العنق\Nعلى سبيل المثال
Dialogue: 0,0:17:46.91,0:17:50.40,Default,,0000,0000,0000,,ليس واضحاً ما إن كان\Nأسلوب القاتل الخاص أم لا
Dialogue: 0,0:17:50.40,0:17:53.86,Default,,0000,0000,0000,,لكنّ مايدا-سان وجد شيئاً في غرفته
Dialogue: 0,0:17:53.86,0:17:56.57,Default,,0000,0000,0000,,شيء كان يطفو في المسبح لاحقاً
Dialogue: 0,0:17:56.57,0:17:58.03,Default,,0000,0000,0000,,!الشعر المستعار
Dialogue: 0,0:17:58.32,0:17:59.73,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:17:59.73,0:18:03.90,Default,,0000,0000,0000,,تيقّن بعدما وجده ضمن أمتعة القاتل غالباً
Dialogue: 0,0:18:03.90,0:18:06.40,Default,,0000,0000,0000,,!تيقّن أنّها الفاعلة
Dialogue: 0,0:18:06.40,0:18:07.69,Default,,0000,0000,0000,,لا-لا يمكن
Dialogue: 0,0:18:08.01,0:18:11.01,Default,,0000,0000,0000,,كان الشعر المستعار في الغرفة\Nلأنّ إيبارا-سان وبارون الليل
Dialogue: 0,0:18:11.01,0:18:14.65,Default,,0000,0000,0000,,صادف أنّهما بنفس قصّة الشعر، فلم تعد بحاجته
Dialogue: 0,0:18:15.00,0:18:17.84,Default,,0000,0000,0000,,...فهمت! لذا خاطر بسرقة الرداء
Dialogue: 0,0:18:17.84,0:18:21.61,Default,,0000,0000,0000,,!والشعر المستعار وظهر أمامها
Dialogue: 0,0:18:21.88,0:18:24.31,Default,,0000,0000,0000,,نعم، كان متحضّراً لأن يُقبض عليه
Dialogue: 0,0:18:24.79,0:18:28.78,Default,,0000,0000,0000,,سبب إخفائه لوجود شهود على حجّة غيابه
Dialogue: 0,0:18:29.20,0:18:32.49,Default,,0000,0000,0000,,هو لأنّ ذلك سيعيق خطّته\Nإذا ما تمّ القبض عليه
Dialogue: 0,0:18:32.87,0:18:38.44,Default,,0000,0000,0000,,نوى أن يكون كبش فداء ويأخذ\Nالتهمة مكان أكيكو-سان إذا تطلّب الأمر
Dialogue: 0,0:18:39.29,0:18:40.74,Default,,0000,0000,0000,,لا تُضحكني
Dialogue: 0,0:18:41.53,0:18:45.01,Default,,0000,0000,0000,,!أفسدت جريمتي الكاملة بسببك
Dialogue: 0,0:18:45.22,0:18:46.19,Default,,0000,0000,0000,,...أ-أكيكو
Dialogue: 0,0:18:46.68,0:18:50.15,Default,,0000,0000,0000,,!صحيح، كنتُ أنا! أنا من قتله
Dialogue: 0,0:18:50.64,0:18:54.11,Default,,0000,0000,0000,,!للانتقام لأخي الذي قتله قبل 3 أعوام
Dialogue: 0,0:18:54.30,0:18:55.78,Default,,0000,0000,0000,,!قُتل؟
Dialogue: 0,0:18:56.63,0:18:58.76,Default,,0000,0000,0000,,بمثابة القتل
Dialogue: 0,0:18:58.76,0:19:03.15,Default,,0000,0000,0000,,فقد اخترق برنامج "الورشة" الذي\N!كان عماد شركة أخي
Dialogue: 0,0:19:03.44,0:19:04.86,Default,,0000,0000,0000,,!الورشة؟
Dialogue: 0,0:19:04.86,0:19:06.12,Default,,0000,0000,0000,,أتعرفينه؟
Dialogue: 0,0:19:06.12,0:19:09.86,Default,,0000,0000,0000,,أجل، إنّه البرنامج الذي باعه لي\Nإيبارا لي قبل ثلاثة أعوام
Dialogue: 0,0:19:10.37,0:19:13.81,Default,,0000,0000,0000,,!لكنّي أوقفت بيعه فورما اكتشفتُ أنّه مسروق
Dialogue: 0,0:19:14.11,0:19:18.28,Default,,0000,0000,0000,,!قفز أخي من سطح مبنى شركته قبل ذلك
Dialogue: 0,0:19:18.74,0:19:22.24,Default,,0000,0000,0000,,...عشتُ للأخذ بثأره مُذ ذاك اليوم
Dialogue: 0,0:19:22.94,0:19:26.02,Default,,0000,0000,0000,,وخططتُ لجولة الغموض هذه
Dialogue: 0,0:19:26.02,0:19:30.70,Default,,0000,0000,0000,,طُعم استدراج إيبارا كان فيروس\Nبارون الليل الذي ذاع صيتاً في السابق
Dialogue: 0,0:19:31.68,0:19:36.15,Default,,0000,0000,0000,,أكل الطُعم فوراً... دون علمه أن البرنامج ليس موجوداً
Dialogue: 0,0:19:37.47,0:19:41.03,Default,,0000,0000,0000,,...أجل، بعدما طردتُ ساتورو من الغرفة
Dialogue: 0,0:19:41.46,0:19:44.23,Default,,0000,0000,0000,,استدرجتُ إيبارا للغرفة بذكر الفيروس
Dialogue: 0,0:19:44.79,0:19:46.57,Default,,0000,0000,0000,,أتى فوراً
Dialogue: 0,0:19:47.25,0:19:49.60,Default,,0000,0000,0000,,بعدما أعطيتُه تلميحات عن مكان الفيروس
Dialogue: 0,0:19:50.53,0:19:55.90,Default,,0000,0000,0000,,،وضعتُ حبوب منوّمة في شرابه\Nوأقفلت غرفته وفق الخطّة
Dialogue: 0,0:19:55.90,0:19:57.94,Default,,0000,0000,0000,,ثم ألقيته لحتفه من غرفتي
Dialogue: 0,0:19:58.99,0:20:00.70,Default,,0000,0000,0000,,!كما لقي أخي حتفه
Dialogue: 0,0:20:01.36,0:20:06.65,Default,,0000,0000,0000,,غفلتي الوحيدة كانت عدم إدراك\Nمشاركتك في هذه الجولة يا موري كوغورو
Dialogue: 0,0:20:07.64,0:20:13.06,Default,,0000,0000,0000,,دفعتُ كونان-كن ليسقط في المسبح\Nلأخيفك، لكنّك لم تتزحزح البتّة
Dialogue: 0,0:20:13.59,0:20:16.30,Default,,0000,0000,0000,,ساتورو، أنا امرأة من هذا النوع
Dialogue: 0,0:20:17.43,0:20:19.63,Default,,0000,0000,0000,,لذا يجدر بك نسياني سريعاً
Dialogue: 0,0:20:31.25,0:20:32.45,Default,,0000,0000,0000,,سأنتظرك
Dialogue: 0,0:20:32.96,0:20:35.44,Default,,0000,0000,0000,,سأبقى منتظراً حتّى ترجعي
Dialogue: 0,0:20:36.82,0:20:38.28,Default,,0000,0000,0000,,...أحمق
Dialogue: 0,0:20:39.66,0:20:45.15,Default,,0000,0000,0000,,بعدها، انحنت أكيكو-سان بخفّة\Nبينما صعدت سيّارة الشرطة
Dialogue: 0,0:20:45.60,0:20:50.61,Default,,0000,0000,0000,,ونُقل مايدا-سان بسيّارة أخرى لإعاقته للتحقيق
Dialogue: 0,0:20:51.02,0:20:55.52,Default,,0000,0000,0000,,لكن وفقاً للمُحقق يوكوميزو، سيُرفق في الحكم عليه بظروف مُخفّفة
Dialogue: 0,0:20:56.26,0:20:59.76,Default,,0000,0000,0000,,،أثناء مراقبتنا لمغادرة سيّارتهما بصمت
Dialogue: 0,0:20:59.76,0:21:03.14,Default,,0000,0000,0000,,كان نحيب رياح الأميرة الحزين\Nهو الصوت الوحيد المسموع
Dialogue: 0,0:22:31.05,0:22:34.19,Default,,0000,0000,0000,,لذا وضعتِ حبوب منوّمة في شرابه؟
Dialogue: 0,0:22:34.19,0:22:35.04,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:22:35.04,0:22:39.69,Default,,0000,0000,0000,,ظننتُ أنّي سأكتشف هويّة\Nبارون الليل إذا تفقّدتُ دفتر ملاحظاته
Dialogue: 0,0:22:39.99,0:22:42.86,Default,,0000,0000,0000,,لكنّه لم يكتب فيه شيء
Dialogue: 0,0:22:42.86,0:22:44.65,Default,,0000,0000,0000,,لمَ قد تفعلين كلّ ذلك؟
Dialogue: 0,0:22:45.86,0:22:50.23,Default,,0000,0000,0000,,أردتُ الفيروس كي أصنع لقاحاً لا أكثر
Dialogue: 0,0:22:50.23,0:22:53.77,Default,,0000,0000,0000,,لكن يبدو أنّ النوايا الشريرة\Nكانت تتأجج داخل هؤلاء
Dialogue: 0,0:22:53.77,0:22:55.57,Default,,0000,0000,0000,,!هذه مبالغة
Dialogue: 0,0:22:56.10,0:22:59.35,Default,,0000,0000,0000,,أردتُ معاقبة مالك الفيروس فحسب
Dialogue: 0,0:22:59.35,0:23:05.52,Default,,0000,0000,0000,,الشخص الذي دمّر برنامجي الأشبه بابني\N!الذي صنعته قبل أربعة أعوام
Dialogue: 0,0:23:05.52,0:23:07.83,Default,,0000,0000,0000,,تظاهرت بعماك حتّى؟
Dialogue: 0,0:23:07.83,0:23:10.26,Default,,0000,0000,0000,,عجباً، لاحظتَ إذاً؟
Dialogue: 0,0:23:10.26,0:23:13.52,Default,,0000,0000,0000,,فعلتُ ذلك كيلا يأخذ الآخرون حيطتهم حولي
Dialogue: 0,0:23:14.00,0:23:16.87,Default,,0000,0000,0000,,ما كان برنامجك بالضبط؟
Dialogue: 0,0:23:16.87,0:23:19.19,Default,,0000,0000,0000,,...حسناً، أظنّه
Dialogue: 0,0:23:19.60,0:23:23.61,Default,,0000,0000,0000,,مشروع جنّة فتيات المدارس الثانوية" يا سيّدي"
Dialogue: 0,0:23:24.83,0:23:25.90,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:23:26.74,0:23:32.03,Default,,0000,0000,0000,,بالمناسبة، سمعت يا ران-تشان\Nأنّك قلبتِ الفندق رأساً على عقب
Dialogue: 0,0:23:32.03,0:23:34.35,Default,,0000,0000,0000,,في بحثك عن حجّة غياب لمايدا-سان
Dialogue: 0,0:23:34.35,0:23:35.86,Default,,0000,0000,0000,,!كان قدوةً أتطلّع لها
Dialogue: 0,0:23:36.31,0:23:41.45,Default,,0000,0000,0000,,...كما هنالك شخص علّمني بألّا أستسلم حتّى النهاية
Dialogue: 0,0:23:41.45,0:23:42.36,Default,,0000,0000,0000,,شخص؟
Dialogue: 0,0:23:42.99,0:23:44.70,Default,,0000,0000,0000,,ماذا؟ هل اتّصلتِ بحبيبك؟
Dialogue: 0,0:23:44.70,0:23:46.36,Default,,0000,0000,0000,,!كلا، لم أقصد ذلك
Dialogue: 0,0:23:46.36,0:23:48.30,Default,,0000,0000,0000,,!من ذاك الشخص؟
Dialogue: 0,0:23:48.30,0:23:50.28,Default,,0000,0000,0000,,!حتّى أنت يا كونان-كن
Dialogue: 0,0:23:50.80,0:23:54.61,Default,,0000,0000,0000,,أقصد مهووس التحرّي ذاك الذي\N!يتجوّل في مكان ما الآن غالباً
Dialogue: 0,0:24:00.96,0:24:03.21,Default,,0000,0000,0000,,!ما الخطب؟! تماسك
Dialogue: 0,0:24:03.40,0:24:04.58,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:24:05.40,0:24:06.40,Default,,0000,0000,0000,,!غاتس مان
Dialogue: 0,0:24:06.40,0:24:08.90,Default,,0000,0000,0000,,!هل شربت منها؟
Dialogue: 0,0:24:10.40,0:24:13.56,Default,,0000,0000,0000,,يوجد ختم على قنّينة غاتس مان هذه
Dialogue: 0,0:24:13.94,0:24:19.06,Default,,0000,0000,0000,,إنّه لحملة هدايا خاصة، لكنّها انتهت قبل ثلاثة أيام
Dialogue: 0,0:24:19.06,0:24:22.11,Default,,0000,0000,0000,,ودليلاً على ذلك، الختم ليس موجوداً\Nعلى قنّينتي العم
Dialogue: 0,0:24:23.26,0:24:24.40,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:24:24.21,0:24:30.17,On Top,,0000,0000,0000,,جريمة قتل المُلاحق
Dialogue: 0,0:24:25.26,0:24:26.59,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.59,0:24:28.59,Default,,0000,0000,0000,,جريمة قتل المُلاحق
Dialogue: 0,0:24:45.74,0:24:48.24,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.24,0:24:49.89,Default,,0000,0000,0000,,صمغ
Dialogue: 0,0:24:50.31,0:24:52.56,Default,,0000,0000,0000,,!قضيّة الحلقة القادمة اجتماعية
Dialogue: 0,0:24:52.56,0:24:54.38,Default,,0000,0000,0000,,!ستكون هناك شارة نهاية جديدة

