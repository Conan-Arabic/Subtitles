Dialogue: 0,0:00:01.83,0:00:04.48,Default,,0,0,0,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:05.08,0:00:08.74,Default,,0,0,0,,!قضيّة مرعبة لقي فيها اثنان حتفهما\N!لنراجع الأحداث مع عزف الشارة
Dialogue: 0,0:00:09.08,0:00:10.74,Default,,0,0,0,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.74,0:00:12.99,Default,,0,0,0,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:12.99,0:00:15.47,Default,,0,0,0,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:46.64,0:01:52.39,On Top,,0,0,0,,دُعيت مع ران والعمّ لحفلة عيد ميلاد\Nابنة أحد الأثرياء الوحيدة، يوتسوي ريكا
Dialogue: 0,0:01:52.39,0:01:55.52,Default,,0,0,0,,ثقب شخصٌ مجهول إطارات سيّارات الجميع
Dialogue: 0,0:01:55.52,0:02:01.93,Default,,0,0,0,,فأُجبرنا مع ريكا ومجموعة بقيت معها على الانتظار \Nفي المنزل حتّى الصباح لتأتي سيّارة وتقلّنا
Dialogue: 0,0:02:04.18,0:02:07.39,Default,,0,0,0,,،في تلك الليلة، أثناء بحثنا عن ريكا المفقودة
Dialogue: 0,0:02:07.39,0:02:09.97,Default,,0,0,0,,وجدنا نيكايدو ميتاً غرقاً في النافورة
Dialogue: 0,0:02:09.97,0:02:13.64,Default,,0,0,0,,وتعرضت ران بدورها لهجومٍ مشابه، لكنّها نجت بشكلٍ ما
Dialogue: 0,0:02:16.10,0:02:18.27,Default,,0,0,0,,،من حيلة قطع الكهرباء للقاتل
Dialogue: 0,0:02:18.60,0:02:21.14,Default,,0,0,0,,!فقد كان بين المتواجدين في المنزل بلا شك
Dialogue: 0,0:02:22.05,0:02:25.14,Default,,0,0,0,,وبعدها، وجدنا ريكا ميتة غرقاً
Dialogue: 0,0:02:25.14,0:02:26.27,Default,,0,0,0,,!في حوض استحمام
Dialogue: 0,0:02:29.02,0:02:33.18,Title,,0,0,10,,{\fad(300,0)}جريمة قتل الابنة الثريّة \N(الجزء الثاني)
Dialogue: 0,0:02:29.02,0:02:33.18,Default,,0,0,0,,جريمة قتل الابنة الثريّة \N(الجزء الثاني)
Dialogue: 0,0:02:42.68,0:02:45.56,Default,,0,0,0,,!كيف حلّ هذا بالآنسة؟
Dialogue: 0,0:02:46.02,0:02:48.02,Default,,0,0,0,,ماتت غرقاً
Dialogue: 0,0:02:48.02,0:02:49.89,Default,,0,0,0,,لا يمكنني الجزم قبل فحص
Dialogue: 0,0:02:49.89,0:02:51.01,Default,,0,0,0,,الماء الذي ابتلعته
Dialogue: 0,0:02:51.43,0:02:57.27,Default,,0,0,0,,لكن حُبِس رأسُها تحت الماء للموت غالباً
Dialogue: 0,0:02:57.27,0:03:02.05,Default,,0,0,0,,ما يعني أنّ غرق نيكايدو-سان عند النافورة
Dialogue: 0,0:03:02.81,0:03:06.43,Default,,0,0,0,,وغرق ران الوشيك في مغسلة المطبخ
Dialogue: 0,0:03:07.06,0:03:10.93,Default,,0,0,0,,وهذه الجريمة تحمل النهج نفسه تماماً
Dialogue: 0,0:03:10.93,0:03:13.18,Default,,0,0,0,,...مستحيل... أيعني ذلك
Dialogue: 0,0:03:13.18,0:03:14.27,Default,,0,0,0,,...إنّها جرائم قتل
Dialogue: 0,0:03:14.81,0:03:16.18,Default,,0,0,0,,!عشوائية
Dialogue: 0,0:03:17.60,0:03:21.68,Default,,0,0,0,,على الأرجح، والقاتل متحجّرٌ أيضاً
Dialogue: 0,0:03:22.30,0:03:26.85,Default,,0,0,0,,انظروا، تنورتها وجواربها مبللة تماماً
Dialogue: 0,0:03:26.85,0:03:30.69,Default,,0,0,0,,دلي>>>لٌ على مقاومتها قبل مقتلها
Dialogue: 0,0:03:31.39,0:03:32.47,Default,,0,0,0,,يا للمسكينة
Dialogue: 0,0:03:33.14,0:03:36.43,Default,,0,0,0,,كما توجد آثار تقييد على معصميها
Dialogue: 0,0:03:36.68,0:03:39.65,Default,,0,0,0,,وشريط لاصق على فمها
Dialogue: 0,0:03:40.14,0:03:42.85,Default,,0,0,0,,يبدو أنّها اُحتجزت في مكان
Dialogue: 0,0:03:42.85,0:03:44.59,Default,,0,0,0,,قبل أن يتمّ قتلها
Dialogue: 0,0:03:45.52,0:03:49.80,Default,,0,0,0,,مـ-من قد يُقدم على أمر بهذه الفظاعة؟
Dialogue: 0,0:03:51.43,0:03:56.77,Default,,0,0,0,,ذهبتَ يا إيتشييدا-سان وغوجو-سان\Nمع يوني-سان للحمّام قبل قليل، صحيح؟
Dialogue: 0,0:03:57.27,0:03:58.35,Default,,0,0,0,,أجل
Dialogue: 0,0:03:58.35,0:04:02.35,Default,,0,0,0,,هل رأيتم أو سمعتم شيئاً خارج المألوف؟
Dialogue: 0,0:04:02.35,0:04:03.22,Default,,0,0,0,,كلا
Dialogue: 0,0:04:04.10,0:04:08.48,Default,,0,0,0,,بينما يدخل أحدنا، كان الآخران ينتظران أمام الحمّام
Dialogue: 0,0:04:08.48,0:04:10.60,Default,,0,0,0,,لكن لم يكن هناك أيّ أمر غريب
Dialogue: 0,0:04:11.18,0:04:16.14,Default,,0,0,0,,قبل دخوله بعدنا في النهاية، طلب منا إيتشييدا-سان \Nإعداد القهوة فذهبنا للمطبخ
Dialogue: 0,0:04:16.14,0:04:18.31,Default,,0,0,0,,فلا أعرف ما حصل بعد ذلك
Dialogue: 0,0:04:18.85,0:04:20.89,Default,,0,0,0,,فهمت
Dialogue: 0,0:04:20.89,0:04:24.89,Default,,0,0,0,,هكذا حصلتَ على فرصتك لقتلها
Dialogue: 0,0:04:24.89,0:04:26.02,Default,,0,0,0,,!ميفوني
Dialogue: 0,0:04:26.68,0:04:30.51,Default,,0,0,0,,تحتاج بين خمس لستّ دقائق\Nعلى الأقل لإعداد القهوة
Dialogue: 0,0:04:30.51,0:04:35.56,Default,,0,0,0,,يمكنك في تلك المدّة التظاهر بدخول الحمّام
Dialogue: 0,0:04:35.56,0:04:39.48,Default,,0,0,0,,وأخذ الآنسة التي كنت تحتجزها في مكان\Nلحوض الاستحمام وقتلها يا إيتشييدا
Dialogue: 0,0:04:39.84,0:04:42.18,Default,,0,0,0,,!كـ-كلا! لم أكن الفاعل
Dialogue: 0,0:04:42.64,0:04:44.76,Default,,0,0,0,,الفاعل ليس إيتشييدا-سان
Dialogue: 0,0:04:46.52,0:04:51.68,Default,,0,0,0,,مضت ساعة لساعتين على الأقل على موت الضحيّة
Dialogue: 0,0:04:51.68,0:04:55.72,Default,,0,0,0,,ما يعني أنّها قُتلت بين الخامسة والسادسة صباحاً
Dialogue: 0,0:04:55.72,0:04:59.69,Default,,0,0,0,,لم يرتكبها بما أنّه ذهب للحمّام\N قبل قليل
Dialogue: 0,0:04:59.69,0:05:04.89,Default,,0,0,0,,ينطبق الأمر على غوجو-سان ويوني-سان
Dialogue: 0,0:05:04.89,0:05:12.18,Default,,0,0,0,,فقد كنتم الثلاثة معي بين الرابعة والسابعة\Nطوال الوقت في غرفة المعيشة
Dialogue: 0,0:05:13.68,0:05:19.93,Default,,0,0,0,,ثبات حجج غيابهم يقلّص لائحة المشتبه بهم
Dialogue: 0,0:05:19.93,0:05:26.81,Default,,0,0,0,,إلى ميفوني-سان وروكودا-سان اللذين كانا\Nفي غرفهما في الطابق العلوي
Dialogue: 0,0:05:28.85,0:05:32.22,Default,,0,0,0,,الأمر بسيط إذاً، القاتل هو المُسن روكودا
Dialogue: 0,0:05:32.76,0:05:34.72,Default,,0,0,0,,بما أنّه لم يكن أنا
Dialogue: 0,0:05:34.72,0:05:38.14,Default,,0,0,0,,لا تكن سخيفاً، لقد رأيتك
Dialogue: 0,0:05:38.56,0:05:42.93,Default,,0,0,0,,غادرتَ غرفتك عند السادسة صباحاً وذهبتَ لمكانٍ ما
Dialogue: 0,0:05:44.06,0:05:45.77,Default,,0,0,0,,أ-أفعلت ذلك حقاً يا ميفوني؟
Dialogue: 0,0:05:45.77,0:05:46.64,Default,,0,0,0,,أجل
Dialogue: 0,0:05:46.64,0:05:50.60,Default,,0,0,0,,شعرتُ بالنعاس فذهبت لمغسلة الطابق الثاني لغسل وجهي
Dialogue: 0,0:05:50.60,0:05:52.35,Default,,0,0,0,,أشك في ذلك
Dialogue: 0,0:05:52.35,0:05:55.31,Default,,0,0,0,,مغسلة الطابق الثاني موجودة بجانب الأدراج
Dialogue: 0,0:05:55.31,0:05:59.06,Default,,0,0,0,,كان بإمكانك قتلها في طريقك
Dialogue: 0,0:05:59.35,0:06:00.47,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:06:02.22,0:06:07.10,Default,,0,0,0,,ربما أمكنني ذلك، فلا شهيد يبرئني
Dialogue: 0,0:06:07.10,0:06:09.06,Default,,0,0,0,,!لكن ينطبق ذلك عليك أيضاً
Dialogue: 0,0:06:09.72,0:06:14.97,Default,,0,0,0,,!لم أرك أبداً عندما كنتُ في الأعلى
Dialogue: 0,0:06:14.97,0:06:19.02,Default,,0,0,0,,بأيّ حال، وقعت الجريمة بين الخامسة والسادسة صباحاً
Dialogue: 0,0:06:19.02,0:06:22.18,Default,,0,0,0,,أي بإمكان أحدكما فقط ارتكابها
Dialogue: 0,0:06:22.72,0:06:27.77,Default,,0,0,0,,هلّا أخبرتماني بالتفصيل ما كنتما تفعلانه في ذلك الوقت؟
Dialogue: 0,0:06:29.27,0:06:31.05,Default,,0,0,0,,العمّ مُحق
Dialogue: 0,0:06:31.05,0:06:36.27,Default,,0,0,0,,ماتت بين الخامسة والسادسة بلا شك
Dialogue: 0,0:06:36.68,0:06:41.68,Default,,0,0,0,,ما يعني أنّهما الأكثر شبهة
Dialogue: 0,0:06:42.93,0:06:44.47,Default,,0,0,0,,لكنّ الأمر غريب
Dialogue: 0,0:06:44.93,0:06:48.23,Default,,0,0,0,,لمَ ثيابها بهذا البلل؟
Dialogue: 0,0:06:48.23,0:06:50.97,Default,,0,0,0,,...مهما قاومت، هذا كثير
Dialogue: 0,0:06:52.68,0:06:53.60,Default,,0,0,0,,...آثار شريط
Dialogue: 0,0:06:55.18,0:06:58.69,Default,,0,0,0,,استعمل القاتل شريطاً لاصقاً مع الحبل؟
Dialogue: 0,0:06:59.59,0:07:05.31,Default,,0,0,0,,لم تغادر غرفتك بين الخامسة والسادسة\Nالبتّة إذاً يا روكودا-سان؟
Dialogue: 0,0:07:05.31,0:07:06.06,Default,,0,0,0,,أجل
Dialogue: 0,0:07:06.52,0:07:11.43,Default,,0,0,0,,وأنت يا ميفوني-سان غادرت لغسل وجهك مرّةً فحسب؟
Dialogue: 0,0:07:11.43,0:07:12.51,Default,,0,0,0,,صحيح
Dialogue: 0,0:07:12.89,0:07:14.31,Default,,0,0,0,,المعذرة
Dialogue: 0,0:07:14.31,0:07:17.97,Default,,0,0,0,,أين كانت تُحتجز الآنسة بالضبط؟
Dialogue: 0,0:07:18.23,0:07:23.68,Default,,0,0,0,,أليس الأمر غريباً؟ فقد قلبنا المكان رأساً على عقب\N!ولم نجدها أبداً
Dialogue: 0,0:07:24.27,0:07:27.94,Default,,0,0,0,,بحثنا عنها عند العاشرة ليلاً
Dialogue: 0,0:07:27.94,0:07:30.88,Default,,0,0,0,,لم يكن هناك شيء في الحمّام وقتها
Dialogue: 0,0:07:30.88,0:07:33.60,Default,,0,0,0,,أجل، وكان حوض الاستحمام فارغاً
Dialogue: 0,0:07:33.93,0:07:37.81,Default,,0,0,0,,!أكانت في الخارج إذاً؟ أيمكن في الغابة؟
Dialogue: 0,0:07:38.27,0:07:39.72,Default,,0,0,0,,كلا
Dialogue: 0,0:07:39.72,0:07:42.60,Default,,0,0,0,,يوجد مكان أفضل من الخارج
Dialogue: 0,0:07:42.60,0:07:47.81,Default,,0,0,0,,داخل صندوق إحدى سيّاراتكم\Nالمركونة أمام المنزل
Dialogue: 0,0:07:48.69,0:07:52.68,Default,,0,0,0,,وكنتما المتفرّغين الوحيدين لإخراج\Nريكا-سان من الصندوق
Dialogue: 0,0:07:52.68,0:07:57.14,Default,,0,0,0,,يا ميفوني-سان وروكودا-سان
Dialogue: 0,0:07:57.14,0:08:00.21,Default,,0,0,0,,يبدو أنّه أحدكما
Dialogue: 0,0:08:00.93,0:08:04.68,Default,,0,0,0,,القاتل المخبول الذي يستمتع بهذه الجرائم العشوائية
Dialogue: 0,0:08:04.68,0:08:08.14,Default,,0,0,0,,جرائم عشوائية؟ أهي كذلك حقاً؟
Dialogue: 0,0:08:08.90,0:08:12.01,Default,,0,0,0,,هُوجمت ران بلا سبب
Dialogue: 0,0:08:12.01,0:08:14.10,Default,,0,0,0,,فمن الطبيعيّ أن يعتقد الجميع ذلك
Dialogue: 0,0:08:14.68,0:08:16.23,Default,,0,0,0,,لكن لمَ؟
Dialogue: 0,0:08:16.23,0:08:19.51,Default,,0,0,0,,لمَ تريّث القاتل في قتل ريكا-سان
Dialogue: 0,0:08:19.51,0:08:22.18,Default,,0,0,0,,وتركنا نجدها الآن؟
Dialogue: 0,0:08:22.89,0:08:26.02,Default,,0,0,0,,وما يحيّرني هو مقتلها في حوض الاستحمام هنا
Dialogue: 0,0:08:27.73,0:08:31.51,Default,,0,0,0,,لمَ لم يقتلها في النافورة
Dialogue: 0,0:08:31.51,0:08:34.35,Default,,0,0,0,,إذا كانت في صندوق السيّارة كما قال العمّ؟
Dialogue: 0,0:08:35.02,0:08:39.55,Default,,0,0,0,,ذلك سيكون بعيداً عن الأنظار، وأسهل من ملء حوض استحمام
Dialogue: 0,0:08:41.51,0:08:42.97,Default,,0,0,0,,!ما الذي تفعله؟
Dialogue: 0,0:08:42.97,0:08:43.59,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:08:43.59,0:08:46.64,Default,,0,0,0,,إنّه على المروش! ماذا؟
Dialogue: 0,0:08:47.10,0:08:48.68,Default,,0,0,0,,المروش؟
Dialogue: 0,0:08:49.06,0:08:51.85,Default,,0,0,0,,!فهمت! هكذا إذاً
Dialogue: 0,0:08:52.93,0:08:57.10,Default,,0,0,0,,!هذه حيلة زمن استعملها المجرم
Dialogue: 0,0:08:57.10,0:09:00.30,Default,,0,0,0,,ما يعني أنّ الثياب المبللة فوق الطبيعي
Dialogue: 0,0:09:00.68,0:09:04.89,Default,,0,0,0,,وعلامات الشريط اللاصق على الجثّة، وسبب تعرّض ران للهجوم
Dialogue: 0,0:09:04.89,0:09:08.60,Default,,0,0,0,,،كما الدافع لتأخير كشف جثّة ريكا-سان
Dialogue: 0,0:09:09.80,0:09:13.35,Default,,0,0,0,,!كلّ هذه الألغاز مربوطة بخيط
Dialogue: 0,0:09:13.68,0:09:16.80,Default,,0,0,0,,ما يعني أنّه هو القاتل
Dialogue: 0,0:09:17.23,0:09:20.47,Default,,0,0,0,,!ذاك الوغد هو الذي هاجم ران
Dialogue: 0,0:09:21.18,0:09:25.85,Default,,0,0,0,,!لكن لا دليل لديّ، دليل قاطع يدينه
Dialogue: 0,0:09:25.85,0:09:27.85,Default,,0,0,0,,!تبّاً، ألا يوجد شيء ؟
Dialogue: 0,0:09:30.22,0:09:33.60,Default,,0,0,0,,!أحمق! أتريد التبلل لهذا الحد؟
Dialogue: 0,0:09:33.60,0:09:34.34,Default,,0,0,0,,!التبلل؟
Dialogue: 0,0:09:34.72,0:09:36.47,Default,,0,0,0,,...فهمت! ربما
Dialogue: 0,0:09:37.02,0:09:39.64,Default,,0,0,0,,لنذهب لغرفة المعيشة حالياً
Dialogue: 0,0:09:39.64,0:09:41.89,Default,,0,0,0,,وننتظر وصول السيّارات لتقلّنا
Dialogue: 0,0:09:41.89,0:09:44.81,Default,,0,0,0,,أنا قلقٌ على ران النائمة هناك أيضاً
Dialogue: 0,0:09:46.02,0:09:47.06,Default,,0,0,0,,!انتظروا
Dialogue: 0,0:09:48.39,0:09:49.68,Default,,0,0,0,,ماذا الآن؟
Dialogue: 0,0:09:49.68,0:09:52.30,Default,,0,0,0,,...كلا... لم يكن أنا
Dialogue: 0,0:09:53.89,0:09:58.52,Default,,0,0,0,,...بدأتْ
Dialogue: 0,0:10:00.72,0:10:03.26,Default,,0,0,0,,ما الخطب حضرة المتحرّي؟
Dialogue: 0,0:10:03.26,0:10:06.27,Default,,0,0,0,,عرفتُ هويّة القاتل
Dialogue: 0,0:10:06.27,0:10:07.19,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:10:07.19,0:10:08.27,Default,,0,0,0,,!هويّة القاتل؟
Dialogue: 0,0:10:08.65,0:10:12.47,Default,,0,0,0,,اخلعوا معاطفكم وارموها هنا رجاءً
Dialogue: 0,0:10:12.47,0:10:15.18,Default,,0,0,0,,سيوضّح هذا كلّ شيء
Dialogue: 0,0:10:15.56,0:10:17.39,Default,,0,0,0,,!يكفي هراءً
Dialogue: 0,0:10:17.39,0:10:20.60,Default,,0,0,0,,مهلك، لنفعل ما يقوله
Dialogue: 0,0:10:20.60,0:10:24.02,Default,,0,0,0,,فهذا سيساعدنا في تحديد القاتل وفق كلامه
Dialogue: 0,0:10:28.98,0:10:31.35,Default,,0,0,0,,!هيّا، تفقّدها الآن
Dialogue: 0,0:10:31.35,0:10:33.38,Default,,0,0,0,,تستطيع أن تعرف من النظر للمعاطف، صحيح؟
Dialogue: 0,0:10:41.39,0:10:44.02,Default,,0,0,0,,كان أنتَ بالفعل إذاً
Dialogue: 0,0:10:44.02,0:10:47.23,Default,,0,0,0,,!مُرتكب الثلاث جرائم في هذا المنزل
Dialogue: 0,0:10:55.31,0:10:56.39,Default,,0,0,0,,أجل
Dialogue: 0,0:10:56.39,0:11:00.46,Default,,0,0,0,,،من أغرق نيكايدو-سان أوّلاً في النافورة
Dialogue: 0,0:11:00.46,0:11:06.00,Default,,0,0,0,,ودسّ حبوباً منوّمة في قهوة ران\Nوحاول إغراقها في المطبخ
Dialogue: 0,0:11:06.00,0:11:10.41,Default,,0,0,0,,ومن أغرق ريكا-سان في حوض الاستحمام هذا
Dialogue: 0,0:11:11.08,0:11:12.81,Default,,0,0,0,,...الفاعل كان
Dialogue: 0,0:11:12.86,0:11:14.74,Default,,0,0,0,,!أنت يا إيتشييدا-سان
Dialogue: 0,0:11:18.45,0:11:21.07,Default,,0,0,0,,...إيتشييدا، أأنت حقاً من
Dialogue: 0,0:11:21.14,0:11:24.14,Default,,0,0,0,,!يـ-يكفي مزاحاً حضرة المتحري
Dialogue: 0,0:11:24.14,0:11:26.61,Default,,0,0,0,,هل أبدو كقاتل مخبول؟
Dialogue: 0,0:11:26.98,0:11:30.64,Default,,0,0,0,,،قبل مقتل نيكايدو-سان في الحادثة الأولى
Dialogue: 0,0:11:30.64,0:11:34.55,Default,,0,0,0,,دخلنا الغابة بحثاً عن ريكا-سان المفقودة
Dialogue: 0,0:11:34.55,0:11:39.97,Default,,0,0,0,,كنتما يا روكودا-سان وإيتشييدا-سان معه وقتها، صحيح؟
Dialogue: 0,0:11:39.97,0:11:40.77,Default,,0,0,0,,أجل
Dialogue: 0,0:11:41.14,0:11:45.65,Default,,0,0,0,,قررتم الانفصال في الغابة والبحث عنها
Dialogue: 0,0:11:46.61,0:11:50.14,Default,,0,0,0,,تبع إيتشييدا-سان نيكايدو-سان الذي أصبح بمفرده
Dialogue: 0,0:11:50.14,0:11:53.31,Default,,0,0,0,,واستدرجه للنافورة
Dialogue: 0,0:11:53.31,0:11:58.19,Default,,0,0,0,,قال شيئاً عن رؤيته لها قرب النافورة غالباً
Dialogue: 0,0:11:58.19,0:12:01.31,Default,,0,0,0,,ثمّ هاجم نيكايدو-سان الذي اقترب من النافورة
Dialogue: 0,0:12:01.31,0:12:03.23,Default,,0,0,0,,!من ورائه وأغرقه
Dialogue: 0,0:12:03.23,0:12:05.65,Default,,0,0,0,,!هذا افتراض فقط
Dialogue: 0,0:12:05.65,0:12:08.86,Default,,0,0,0,,كان بإمكان روكودا-سان القيام بالأمر نفسه
Dialogue: 0,0:12:08.86,0:12:14.60,Default,,0,0,0,,كما بترك نيكايدو-سان والآنسة جانباً، لمَ قد أهاجم ران-سان؟
Dialogue: 0,0:12:14.60,0:12:16.94,Default,,0,0,0,,!هذه أوّل مرّة ألتقيها
Dialogue: 0,0:12:16.94,0:12:21.56,Default,,0,0,0,,كما عندما قطع المجرم الكهرباء\N...لمهاجمة ران-سان
Dialogue: 0,0:12:21.56,0:12:23.85,Default,,0,0,0,,!كنتُ معك
Dialogue: 0,0:12:23.85,0:12:26.94,Default,,0,0,0,,كيف لي أن أقطع الكهرباء؟
Dialogue: 0,0:12:26.94,0:12:29.64,Default,,0,0,0,,لا تقل أنّ لديّ شريك
Dialogue: 0,0:12:29.93,0:12:34.60,Default,,0,0,0,,كلا، أمكنك قطعها آلياً بسهولة دون شريك
Dialogue: 0,0:12:34.60,0:12:39.23,Default,,0,0,0,,باستعمال مكيّفات الهواء وآلات المايكرويف
Dialogue: 0,0:12:39.23,0:12:40.76,Default,,0,0,0,,الأمر بسيط
Dialogue: 0,0:12:40.76,0:12:48.27,Default,,0,0,0,,ضبطت مؤقتات كلّ مكيّفات الهواء\Nعلى العمل في اللحظة نفسها
Dialogue: 0,0:12:48.61,0:12:54.43,Default,,0,0,0,,ورفعت درجة تسخين جهاز المايكرويف \Nفي المطبخ لوضعية الفرن
Dialogue: 0,0:12:54.77,0:12:58.07,Default,,0,0,0,,سيكون هناك حمل زائد عندما يحين الوقت
Dialogue: 0,0:12:58.07,0:13:01.10,Default,,0,0,0,,مما يشغّل القواطع
Dialogue: 0,0:13:02.06,0:13:07.86,Default,,0,0,0,,والدليل هو بقاء وقت انقطاع الكهرباء\Nعلى أجهزة تحكّم المكيّفات
Dialogue: 0,0:13:07.86,0:13:11.72,Default,,0,0,0,,كما سمع كونان صوتاً غريباً عند انقطاعها
Dialogue: 0,0:13:12.14,0:13:14.02,Default,,0,0,0,,أليس ذلك صحيحاً يا كونان؟
Dialogue: 0,0:13:14.02,0:13:17.48,Default,,0,0,0,,!بلى! سمعتُ جرساً
Dialogue: 0,0:13:17.48,0:13:19.81,Default,,0,0,0,,،أجهزة مايكرويف هذا المنزل بها أقراص تحكّم
Dialogue: 0,0:13:19.81,0:13:21.72,Default,,0,0,0,,فتحركت حتى دون كهرباء
Dialogue: 0,0:13:22.68,0:13:25.65,Default,,0,0,0,,كما كان المايكرويف دافئاً عندما لمسته لاحقاً
Dialogue: 0,0:13:25.65,0:13:27.14,Default,,0,0,0,,فلا شكّ في الأمر
Dialogue: 0,0:13:27.14,0:13:28.57,Default,,0,0,0,,!انتظر
Dialogue: 0,0:13:28.57,0:13:33.14,Default,,0,0,0,,بعد قطعك للكهرباء هكذا، كسرتَ زجاج النافذة في الظلام
Dialogue: 0,0:13:33.69,0:13:36.15,Default,,0,0,0,,لتوهمنا أنّ القاتل هرب للخارج
Dialogue: 0,0:13:36.15,0:13:39.11,Default,,0,0,0,,ودفعتنا للحاق به
Dialogue: 0,0:13:39.56,0:13:42.77,Default,,0,0,0,,حملتَ بعدها ران التي أصبحت بمفردها إلى المطبخ
Dialogue: 0,0:13:42.77,0:13:44.89,Default,,0,0,0,,وحاولتَ إغراقها
Dialogue: 0,0:13:45.15,0:13:50.34,Default,,0,0,0,,دسست حبوب منومة في قهوتها قبلاً كيلا تقاوم
Dialogue: 0,0:13:50.60,0:13:53.14,Default,,0,0,0,,،قُبيل انقطاع الكهرباء بالأصل
Dialogue: 0,0:13:53.14,0:13:57.44,Default,,0,0,0,,كنتَ في المطبخ معي ونحن نبحث عن ريكا-سان
Dialogue: 0,0:13:57.73,0:14:02.98,Default,,0,0,0,,كان بإمكانك بسهولة تشغيل المايكرويف خلسةً
Dialogue: 0,0:14:02.98,0:14:04.56,Default,,0,0,0,,!بعدما غادرت
Dialogue: 0,0:14:06.31,0:14:08.02,Default,,0,0,0,,!انتظر قليلاً
Dialogue: 0,0:14:08.02,0:14:11.18,Default,,0,0,0,,هل نسيت أنّ لديّ حجّة غياب؟
Dialogue: 0,0:14:11.48,0:14:18.15,Default,,0,0,0,,!كنتُ معك عندما قُتلت ريكا-سان في الحادثة الثالثة
Dialogue: 0,0:14:18.65,0:14:22.64,Default,,0,0,0,,،إذا كنتُ المسؤول عن الجرائم الثلاث
Dialogue: 0,0:14:22.64,0:14:27.11,Default,,0,0,0,,فوضّح رجاءً كيف قتلتُ الآنسة
Dialogue: 0,0:14:27.61,0:14:29.81,Default,,0,0,0,,إيتشييدا-سان محقّ
Dialogue: 0,0:14:29.81,0:14:32.94,Default,,0,0,0,,ماتت الآنسة بين الخامسة والسادسة
Dialogue: 0,0:14:32.94,0:14:37.94,Default,,0,0,0,,كان معنا طوال الوقت من الرابعة للسابعة
Dialogue: 0,0:14:38.52,0:14:42.43,Default,,0,0,0,,،وبالنسبة للحبوب المنومة في قهوة ران-سان
Dialogue: 0,0:14:42.43,0:14:44.60,Default,,0,0,0,,يوني-سان كانت من جلبت القهوة
Dialogue: 0,0:14:44.60,0:14:46.77,Default,,0,0,0,,!اخترنا أكوابنا بأنفسنا
Dialogue: 0,0:14:46.98,0:14:50.81,Default,,0,0,0,,أكان بإمكانه التجهيز لذلك سلفاً؟
Dialogue: 0,0:14:50.81,0:14:53.60,Default,,0,0,0,,ماذا لو شرب القهوة المنومة؟
Dialogue: 0,0:14:53.98,0:14:56.36,Default,,0,0,0,,الأمر بسيط
Dialogue: 0,0:14:56.36,0:15:00.06,Default,,0,0,0,,كلّ ما كان عليه فعله هو عدم الشرب
Dialogue: 0,0:15:00.06,0:15:02.64,Default,,0,0,0,,لكنّ ران-سان اختارت كوبها بنفسها
Dialogue: 0,0:15:02.64,0:15:06.06,Default,,0,0,0,,كيف أمكنه التكهن بذلك؟
Dialogue: 0,0:15:06.06,0:15:08.97,Default,,0,0,0,,لم يكن عليه
Dialogue: 0,0:15:09.31,0:15:11.23,Default,,0,0,0,,!فأيّ شخص كان سيفي بالغرض
Dialogue: 0,0:15:12.05,0:15:14.80,Default,,0,0,0,,!أتقصد أنّه كان قد يهاجمنا أيضاً؟
Dialogue: 0,0:15:15.19,0:15:18.27,Default,,0,0,0,,إذا كنتَ تعيس الحظّ بشرب تلك القهوة، أجل
Dialogue: 0,0:15:18.69,0:15:21.52,Default,,0,0,0,,عندما يخدّرك العقار
Dialogue: 0,0:15:21.52,0:15:26.48,Default,,0,0,0,,لا يهم كنتَ رجلاً أم امرأة، كنتَ لتلقى نفس مصير ران غالباً
Dialogue: 0,0:15:26.48,0:15:28.72,Default,,0,0,0,,!كان قتلاً عشوائياً بالفعل إذاً
Dialogue: 0,0:15:28.72,0:15:32.48,Default,,0,0,0,,تـ-توقفوا عن معاملتي كمجرم
Dialogue: 0,0:15:32.48,0:15:34.65,Default,,0,0,0,,كما كنتُ لأقتلها عند انقطاع الكهرباء
Dialogue: 0,0:15:34.65,0:15:36.69,Default,,0,0,0,,لو كنتُ مجرماً حقاً، أليس كذلك؟
Dialogue: 0,0:15:36.69,0:15:41.68,Default,,0,0,0,,كلا، لم تنو قتل ران من البداية
Dialogue: 0,0:15:41.68,0:15:46.69,Default,,0,0,0,,صحيح، لم تسعَ وراء حياة أحد \Nفي الحادثة الثانية
Dialogue: 0,0:15:46.69,0:15:48.18,Default,,0,0,0,,!بل الشهادة...
Dialogue: 0,0:15:48.18,0:15:52.52,Default,,0,0,0,,أردتَ أن يقول أحد أنّ المجرم حبس رأسه
Dialogue: 0,0:15:52.52,0:15:54.30,Default,,0,0,0,,!تحت الماء
Dialogue: 0,0:15:55.77,0:16:02.02,Default,,0,0,0,,سيجعلنا هذا نعتقد أنّ القاتل استعمل نفس الأسلوب \Nمعتمداً على القوّة البدنية في قتل ريكا-سان
Dialogue: 0,0:16:02.02,0:16:06.52,Default,,0,0,0,,كما الجريمتين السابقتين
Dialogue: 0,0:16:06.52,0:16:08.19,Default,,0,0,0,,...إذاً
Dialogue: 0,0:16:08.19,0:16:11.10,Default,,0,0,0,,لم تُغرق الآنسة؟
Dialogue: 0,0:16:11.10,0:16:13.10,Default,,0,0,0,,بل أُغرقت
Dialogue: 0,0:16:13.10,0:16:18.23,Default,,0,0,0,,لكن لم يُحبس رأسها تحت الماء
Dialogue: 0,0:16:18.65,0:16:21.14,Default,,0,0,0,,ألا تجدون الأمر غريباً؟
Dialogue: 0,0:16:21.14,0:16:24.48,Default,,0,0,0,,اختفت ريكا-سان عند العاشرة ليلاً
Dialogue: 0,0:16:24.48,0:16:28.23,Default,,0,0,0,,لكنّها قُتلت بين الخامسة والسادسة صباحاً
Dialogue: 0,0:16:29.01,0:16:31.81,Default,,0,0,0,,لسبب ما، انتظر المجرم سبع لثمان ساعات
Dialogue: 0,0:16:31.81,0:16:33.18,Default,,0,0,0,,قبل قتلها
Dialogue: 0,0:16:33.18,0:16:37.02,Default,,0,0,0,,وثيابها المبللة زيادةً عن اللّزوم
Dialogue: 0,0:16:37.02,0:16:40.14,Default,,0,0,0,,مهما قاومت، فلن تتبلل بذاك الشكل
Dialogue: 0,0:16:40.56,0:16:43.10,Default,,0,0,0,,ولسببٍ ما، استعمل القاتل شريطاً لاصقاً
Dialogue: 0,0:16:43.10,0:16:46.11,Default,,0,0,0,,مع الحبل لتقييد ريكا-سان
Dialogue: 0,0:16:46.31,0:16:49.31,Default,,0,0,0,,...مفتاح حلّ كل هذه الألغاز
Dialogue: 0,0:16:49.31,0:16:51.06,Default,,0,0,0,,!هو المروش
Dialogue: 0,0:16:51.31,0:16:52.60,Default,,0,0,0,,المروش؟
Dialogue: 0,0:16:52.60,0:16:58.02,Default,,0,0,0,,تملأ الحوض بالصنبور عادةً، أليس كذلك؟
Dialogue: 0,0:16:58.02,0:17:01.52,Default,,0,0,0,,،لكن عندما حاول كونان فتحه قبل قليل
Dialogue: 0,0:17:01.52,0:17:04.52,Default,,0,0,0,,خرج الماء من المروش وليس الصنبور
Dialogue: 0,0:17:04.52,0:17:06.22,Default,,0,0,0,,لمَ ذلك؟
Dialogue: 0,0:17:06.65,0:17:09.64,Default,,0,0,0,,لأنّ القاتل استعمل المروش
Dialogue: 0,0:17:09.64,0:17:12.48,Default,,0,0,0,,لملء الحوض بصمت
Dialogue: 0,0:17:12.48,0:17:16.22,Default,,0,0,0,,،لصق جسدها بالحوض بالشريط
Dialogue: 0,0:17:16.22,0:17:21.06,Default,,0,0,0,,كي تغرق بنهاية المطاف من تلقاء نفسها\Nمع مرور الوقت
Dialogue: 0,0:17:21.43,0:17:24.98,Default,,0,0,0,,نوّم إيتشييدا-سان ريكا-سان غالباً
Dialogue: 0,0:17:24.98,0:17:27.23,Default,,0,0,0,,،عندما نزلت عند العاشرة
Dialogue: 0,0:17:27.23,0:17:31.06,Default,,0,0,0,,وحملها لحوض الاستحمام واستعمل الحيلة آنفة الذكر
Dialogue: 0,0:17:31.06,0:17:34.02,Default,,0,0,0,,عدّل قوّة المروش كي تغرق
Dialogue: 0,0:17:34.02,0:17:36.47,Default,,0,0,0,,بين الخامسة والسادسة صباحاً
Dialogue: 0,0:17:37.06,0:17:41.93,Default,,0,0,0,,ثمّ بقي معنا بين الخامسة والسادسة لصنع حجّة غيابه
Dialogue: 0,0:17:41.93,0:17:44.81,Default,,0,0,0,,وتظاهر بالذهاب للحمّام عند السابعة
Dialogue: 0,0:17:44.81,0:17:48.85,Default,,0,0,0,,وأخرج جثّة ريكا-سان من الحوض
Dialogue: 0,0:17:49.14,0:17:52.35,Default,,0,0,0,,كانت هذه الحيلة الهزيلة لتُكشف
Dialogue: 0,0:17:52.35,0:17:54.10,Default,,0,0,0,,لو لم يتّخذ إجراءً إضافياً
Dialogue: 0,0:17:54.10,0:17:54.85,Default,,0,0,0,,إجراء إضافيّ؟
Dialogue: 0,0:17:55.19,0:17:59.35,Default,,0,0,0,,أجل، كان الهدف من الهجوم على ران
Dialogue: 0,0:17:59.35,0:18:04.84,Default,,0,0,0,,هو جعلنا نعتقد أنّ ريكا-سان قُتلت \Nبحبس رأسها تحت الماء أيضاً
Dialogue: 0,0:18:04.84,0:18:09.56,Default,,0,0,0,,لكن تضمنّت هذه الحيلة احتمالاً خطيراً باكتشاف ريكا-سان
Dialogue: 0,0:18:09.56,0:18:12.01,Default,,0,0,0,,في حوض الاستحمام
Dialogue: 0,0:18:12.39,0:18:15.98,Default,,0,0,0,,قطع إنارة مصابيح هذا الجانب سلفاً
Dialogue: 0,0:18:15.98,0:18:18.23,Default,,0,0,0,,كي يُبعد الناس، لكن كان أمره سينتهي
Dialogue: 0,0:18:18.23,0:18:20.31,Default,,0,0,0,,لو تفقّد أحد الحوض
Dialogue: 0,0:18:20.31,0:18:26.64,Default,,0,0,0,,لكنّه حلّ هذه المشكلة بتفقّد الحوض بنفسه
Dialogue: 0,0:18:27.94,0:18:30.34,Default,,0,0,0,,ليست هنا
Dialogue: 0,0:18:30.68,0:18:36.81,Default,,0,0,0,,أي أنّك كنتَ الوحيد القادر على\N تنفيذ هذه الحيلة يا إيتشييدا-سان
Dialogue: 0,0:18:38.32,0:18:41.35,Default,,0,0,0,,صحيحٌ أنّي سأكون الأكثر شبهة
Dialogue: 0,0:18:41.35,0:18:43.31,Default,,0,0,0,,إن اُستعملت هذه الحيلة حقاً
Dialogue: 0,0:18:43.31,0:18:44.90,Default,,0,0,0,,أعترف بذلك
Dialogue: 0,0:18:45.23,0:18:49.47,Default,,0,0,0,,لكن هل رأيتني أفعلها؟
Dialogue: 0,0:18:49.47,0:18:53.48,Default,,0,0,0,,...إذا لم تملك دليلاً فلا يهم مهما افترضت
Dialogue: 0,0:18:53.48,0:18:57.27,Default,,0,0,0,,لذا طلبتُ منكم خلع معاطفكم
Dialogue: 0,0:18:57.77,0:19:00.47,Default,,0,0,0,,!تفقّدها إذاً
Dialogue: 0,0:18:57.77,0:19:00.47,Default,,0,0,0,,فلن تجد شيئاً
Dialogue: 0,0:19:00.47,0:19:02.89,Default,,0,0,0,,لم يكن معطفك ما أردتُ رؤيته
Dialogue: 0,0:19:03.98,0:19:07.15,Default,,0,0,0,,!بل بقع الماء على قميصك
Dialogue: 0,0:19:07.15,0:19:10.92,Default,,0,0,0,,بقعة الماء على كمّ غوجو-سان
Dialogue: 0,0:19:12.31,0:19:14.69,Default,,0,0,0,,كانت من غسيله ليديه في الحمّام
Dialogue: 0,0:19:14.69,0:19:17.51,Default,,0,0,0,,والبقعة على ياقة ميفوني-سان
Dialogue: 0,0:19:17.51,0:19:19.97,Default,,0,0,0,,كانت من غسيله لوجهه
Dialogue: 0,0:19:19.97,0:19:21.98,Default,,0,0,0,,ما تفسير البقع في منتصف ذراعيك إذاً؟
Dialogue: 0,0:19:21.98,0:19:27.15,Default,,0,0,0,,...وصلتني مثلهما
Dialogue: 0,0:19:27.15,0:19:29.10,Default,,0,0,0,,وصلتك بغسل يديك؟ كلا
Dialogue: 0,0:19:29.10,0:19:32.31,Default,,0,0,0,,بغسل وجهك إذاً؟ كلا أيضاً
Dialogue: 0,0:19:32.31,0:19:35.52,Default,,0,0,0,,!لا يمكن أن تصلك بقع هناك بارتداء معطفك
Dialogue: 0,0:19:35.77,0:19:39.05,Default,,0,0,0,,أجل، خلعتَ معطفك
Dialogue: 0,0:19:39.47,0:19:42.81,Default,,0,0,0,,لحمايته من التبلل أثناء سحبك
Dialogue: 0,0:19:42.81,0:19:46.11,Default,,0,0,0,,جثّة ريكا-سان المبللة
Dialogue: 0,0:19:46.11,0:19:48.11,Default,,0,0,0,,تبلل مرفقاك لأنّك رفعت أكمامك
Dialogue: 0,0:19:48.11,0:19:51.52,Default,,0,0,0,,أليس ذلك صحيحاً يا إيتشييدا-سان؟
Dialogue: 0,0:19:51.98,0:19:54.48,Default,,0,0,0,,...لـ-لكن... لمَ إيتشييدا
Dialogue: 0,0:19:57.76,0:20:00.64,Default,,0,0,0,,،مِن تمحور كلّ هذه الحوادث حول الغرق
Dialogue: 0,0:20:00.64,0:20:03.77,Default,,0,0,0,,فلا بدّ أنّ للأمر علاقة بيايكو-سان
Dialogue: 0,0:20:03.77,0:20:06.61,Default,,0,0,0,,التي غرقت في حادثة قبل عامين
Dialogue: 0,0:20:07.86,0:20:10.14,Default,,0,0,0,,لم تمت يايكو في حادثة
Dialogue: 0,0:20:10.14,0:20:11.64,Default,,0,0,0,,...بل قتلها
Dialogue: 0,0:20:11.64,0:20:13.73,Default,,0,0,0,,!نيكايدو والآنسة
Dialogue: 0,0:20:15.31,0:20:16.94,Default,,0,0,0,,يوم العاصفة
Dialogue: 0,0:20:16.94,0:20:20.89,Default,,0,0,0,,ذهبت يايكو بطوف نجاة للجزيرة لإنقاذ الآنسة
Dialogue: 0,0:20:20.89,0:20:25.64,Default,,0,0,0,,كانت ترتدي سترة نجاة، ومعها أخرى للآنسة
Dialogue: 0,0:20:26.31,0:20:28.50,Default,,0,0,0,,لكنها تفاجأت عندما وصلت الجزيرة
Dialogue: 0,0:20:29.14,0:20:32.20,Default,,0,0,0,,فقد كان نيكايدو هناك مع الآنسة
Dialogue: 0,0:20:32.81,0:20:34.89,Default,,0,0,0,,معها سترتا نجاة فحسب
Dialogue: 0,0:20:35.23,0:20:36.77,Default,,0,0,0,,...إ-إذاً
Dialogue: 0,0:20:36.19,0:20:37.23,Default,,0,0,0,,...أيمكن
Dialogue: 0,0:20:37.23,0:20:42.05,Default,,0,0,0,,!أجل، صحيح! سرقا سترة قنجاة يايكو وأنقذا نفسيهما
Dialogue: 0,0:20:42.05,0:20:44.48,Default,,0,0,0,,!تركاها تموت وهي أتت للمساعدة
Dialogue: 0,0:20:45.30,0:20:47.59,Default,,0,0,0,,ظننتُ الأمر غريباً عندما لم تكن يايكو
Dialogue: 0,0:20:47.59,0:20:51.54,Default,,0,0,0,,ترتدي سترة نجاة عندما وجدوا جثتها
Dialogue: 0,0:20:51.54,0:20:54.98,Default,,0,0,0,,وقولهما أنهما لم يرياها
Dialogue: 0,0:20:54.98,0:20:58.02,Default,,0,0,0,,لـ-لكن كيف تجزم أنّ ذلك ما حصل؟
Dialogue: 0,0:20:59.45,0:21:03.00,Default,,0,0,0,,اعترفا قبل أن أقتلهما
Dialogue: 0,0:21:03.49,0:21:07.45,Default,,0,0,0,,!اعترفا بقتل عزيزتي يايكو
Dialogue: 0,0:21:09.19,0:21:11.25,Default,,0,0,0,,يستحقان الموت
Dialogue: 0,0:21:12.11,0:21:13.95,Default,,0,0,0,,نيكايدو وهذه المرأة
Dialogue: 0,0:21:15.98,0:21:17.22,Default,,0,0,0,,!أحمق
Dialogue: 0,0:21:17.61,0:21:19.58,Default,,0,0,0,,...يوني-سان
Dialogue: 0,0:21:20.77,0:21:24.10,Default,,0,0,0,,لا أحد يستحق الموت في هذا العالم
Dialogue: 0,0:21:25.52,0:21:29.20,Default,,0,0,0,,لا يعني هذا أنّي أصفح عن أفعال الآنسة
Dialogue: 0,0:21:29.93,0:21:34.94,Default,,0,0,0,,لكنّ موت شخص يعني بؤس آخر
Dialogue: 0,0:21:35.81,0:21:41.39,Default,,0,0,0,,حزني وحدي كافٍ... كافٍ
Dialogue: 0,0:23:19.59,0:23:21.53,Default,,0,0,0,,هاجمك أيضاً يا ران؟
Dialogue: 0,0:23:21.53,0:23:22.60,Default,,0,0,0,,أجل
Dialogue: 0,0:23:22.60,0:23:25.93,Default,,0,0,0,,،لا أذكر الكثير لأنّي كنت منوّمة
Dialogue: 0,0:23:26.44,0:23:31.09,Default,,0,0,0,,لكن أشعر كأنّ شينتشي أتى لإنقاذي وقتها
Dialogue: 0,0:23:31.34,0:23:32.05,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:23:32.41,0:23:33.21,Default,,0,0,0,,!تباً
Dialogue: 0,0:23:33.81,0:23:37.57,Default,,0,0,0,,لكنه لم يذهب لذاك المنزل، أليس كذلك؟
Dialogue: 0,0:23:37.57,0:23:41.13,Default,,0,0,0,,أجل، كان كونان-كن من أنقذني وفقما قالوا
Dialogue: 0,0:23:41.13,0:23:42.84,Default,,0,0,0,,...كـ-كان ذلك
Dialogue: 0,0:23:43.44,0:23:47.31,Default,,0,0,0,,لكن يستحيل أنّه كان مهووس التحرّي ذاك
Dialogue: 0,0:23:47.50,0:23:52.48,Default,,0,0,0,,!أجل! يستحيل أنّ يكون ذاك الأحمق نبيهاً لهذا الحد
Dialogue: 0,0:23:53.44,0:23:57.31,Default,,0,0,0,,أنتما... توقّفا عندكما
Dialogue: 0,0:24:03.35,0:24:05.05,Default,,0,0,0,,قد تكون مباراةً رائعة
Dialogue: 0,0:24:05.30,0:24:06.24,Default,,0,0,0,,...أنت
Dialogue: 0,0:24:08.85,0:24:10.97,Default,,0,0,0,,مُزّق علم البطولة؟
Dialogue: 0,0:24:11.60,0:24:13.93,Default,,0,0,0,,كان الفاعل من الداخل
Dialogue: 0,0:24:15.15,0:24:17.15,Default,,0,0,0,,
Dialogue: 0,0:24:18.11,0:24:20.46,Default,,0,0,0,,...بلا سابق إنذار مُجدداً
Dialogue: 0,0:24:21.21,0:24:24.01,Default,,0,0,0,,كلا، لستَ المجرم الحقيقيّ
Dialogue: 0,0:24:24.73,0:24:26.52,Default,,0,0,0,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.52,0:24:29.03,Default,,0,0,0,,قضيّة علم البطولة المُمزق
Dialogue: 0,0:24:45.58,0:24:47.59,Default,,0,0,0,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.59,0:24:48.82,Default,,0,0,0,,قَطع قطري

