Dialogue: 0,0:00:01.04,0:00:04.62,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.62,0:00:06.78,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.78,0:00:10.33,Default,,0000,0000,0000,,!اليوم ظهور ليايبا المقنّع أخيراً! يمكنك رؤية حادثة داخل التنكّر
Dialogue: 0,0:00:10.53,0:00:12.04,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.04,0:00:14.00,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ دماغه لبالغ
Dialogue: 0,0:00:14.00,0:00:16.21,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.66,0:00:24.33,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.33,0:00:31.37,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:33.10,0:00:39.50,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.50,0:00:47.00,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:47.00,0:00:59.46,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.33,0:01:06.75,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.72,0:01:13.60,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.60,0:01:20.00,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:20.00,0:01:26.99,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.06,0:01:57.10,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل يايبا المقنّع
Dialogue: 0,0:01:51.73,0:01:54.44,Default,,0000,0000,0000,,جريمة قتل يايبا المقنّع
Dialogue: 0,0:01:58.23,0:02:02.49,Default,,0000,0000,0000,,ماذا؟ ستأكل في الخارج اليوم يا كونان-كن؟
Dialogue: 0,0:02:02.49,0:02:06.58,Default,,0000,0000,0000,,أجل، سألتقيهما أمام هذا الضريح عند السادسة
Dialogue: 0,0:02:06.58,0:02:09.21,Default,,0000,0000,0000,,يا لحظّك، أهو أنقليس؟
Dialogue: 0,0:02:09.21,0:02:13.21,Default,,0000,0000,0000,,كلا، أظن أنّ مطعم كاري لذيذ اُفتتح بالجوار
Dialogue: 0,0:02:13.81,0:02:15.61,Default,,0000,0000,0000,,!أنا أحبّ الكاري
Dialogue: 0,0:02:15.61,0:02:18.09,Default,,0000,0000,0000,,!لنأكل أيضاً
Dialogue: 0,0:02:18.09,0:02:20.08,Default,,0000,0000,0000,,!أريد كاري قريدس مقليّ كبير
Dialogue: 0,0:02:20.56,0:02:22.68,Default,,0000,0000,0000,,...أنتم
Dialogue: 0,0:02:30.98,0:02:32.73,Default,,0000,0000,0000,,!شرطة الليزر
Dialogue: 0,0:02:33.73,0:02:35.69,Default,,0000,0000,0000,,شرطة الليزر؟
Dialogue: 0,0:02:35.69,0:02:39.11,Default,,0000,0000,0000,,!فرقة الشرطة في يايبا المقنّع
Dialogue: 0,0:02:39.90,0:02:43.28,Default,,0000,0000,0000,,مـ-مرحباً يا صغار، أأنتم معجبون بيايبا المقنّع؟
Dialogue: 0,0:02:43.28,0:02:45.93,Default,,0000,0000,0000,,!أنا أحبّ يايبا المقنّع
Dialogue: 0,0:02:45.93,0:02:49.74,Default,,0000,0000,0000,,أيمكن أنّكم تصوّرون يايبا المقنّع\Nفي هذا الضريح؟
Dialogue: 0,0:02:49.74,0:02:52.20,Default,,0000,0000,0000,,...كلا، ليس الأمر هكذا
Dialogue: 0,0:02:52.20,0:02:54.41,Default,,0000,0000,0000,,!هذا المسدّس رائع
Dialogue: 0,0:02:54.88,0:02:55.49,Default,,0000,0000,0000,,!لا تلمسه
Dialogue: 0,0:02:57.12,0:02:58.68,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:02:58.68,0:03:03.64,Default,,0000,0000,0000,,،هذا المسدّس مهمٌ لقتال الوحوش\Nلذا لا يمكن أن أترك أحداً يلمسه
Dialogue: 0,0:03:03.64,0:03:05.04,Default,,0000,0000,0000,,!إلى اللقاء
Dialogue: 0,0:03:08.84,0:03:10.71,Default,,0000,0000,0000,,ما المشكلة لو لمسته قليلاً؟
Dialogue: 0,0:03:10.71,0:03:12.76,Default,,0000,0000,0000,,كونان-كن، هل انتظرتَ طويلاً؟
Dialogue: 0,0:03:12.76,0:03:15.97,Default,,0000,0000,0000,,كلا، وصلت لتويّ
Dialogue: 0,0:03:19.21,0:03:21.38,Default,,0000,0000,0000,,ما خطبكم؟
Dialogue: 0,0:03:21.38,0:03:23.51,Default,,0000,0000,0000,,قالوا أنّهم يريدون أكل الكاري معنا
Dialogue: 0,0:03:23.51,0:03:24.40,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:03:24.88,0:03:28.63,Default,,0000,0000,0000,,أين المشكلة؟ سيكون ألذّ لو أكلنا معاً
Dialogue: 0,0:03:28.63,0:03:30.88,Default,,0000,0000,0000,,ومن سيدفع؟
Dialogue: 0,0:03:30.88,0:03:32.80,Default,,0000,0000,0000,,أنت يا أبي
Dialogue: 0,0:03:32.80,0:03:37.08,Default,,0000,0000,0000,,لكن عليكم الاتّصال بأمّهاتكم أوّلاً\Nكيلا يقلقن عليكم
Dialogue: 0,0:03:37.08,0:03:38.59,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:03:41.34,0:03:42.42,Default,,0000,0000,0000,,يا إلهي
Dialogue: 0,0:03:42.42,0:03:46.67,Default,,0000,0000,0000,,أيّ جماعة آباء يردّون بـ "نتركهم في عهدتك!"؟
Dialogue: 0,0:03:47.63,0:03:48.38,Default,,0000,0000,0000,,انظروا
Dialogue: 0,0:03:50.80,0:03:53.13,Default,,0000,0000,0000,,!يايبا المقنّع
Dialogue: 0,0:03:57.18,0:03:59.85,Default,,0000,0000,0000,,!ركلة يايبا
Dialogue: 0,0:04:01.05,0:04:02.36,Default,,0000,0000,0000,,!مذهل! مذهل
Dialogue: 0,0:04:02.36,0:04:03.46,Default,,0000,0000,0000,,!رائع جدّاً
Dialogue: 0,0:04:03.46,0:04:04.77,Default,,0000,0000,0000,,!كأنّي أحلم
Dialogue: 0,0:04:05.21,0:04:10.73,Default,,0000,0000,0000,,شرطة الليزر، ثمّ يايبا المقنّع بعدها؟\Nما الذي يجري اليوم بالضبط؟
Dialogue: 0,0:04:11.42,0:04:15.88,Default,,0000,0000,0000,,ماذا؟ أيمكن أنّك المتحرّي الشهير\Nموري كوغورو-سان؟
Dialogue: 0,0:04:15.88,0:04:17.45,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:04:18.33,0:04:22.41,Default,,0000,0000,0000,,!هذا مبهر! أنا معجبٌ كبير\N!دعني أصافحك رجاءً
Dialogue: 0,0:04:22.41,0:04:26.12,Default,,0000,0000,0000,,انظروا، العمّ يصافح يايبا المقنّع
Dialogue: 0,0:04:27.23,0:04:31.15,Default,,0000,0000,0000,,كلا، لستُ يايبا المقنّع الحقيقيّ
Dialogue: 0,0:04:32.32,0:04:37.36,CharCard,,0000,0000,0004,,{\fad(200,0)}(تسوتسومي ياسويوكي (21\Nكليّة الحقوق، جامعة جونان
Dialogue: 0,0:04:32.40,0:04:34.44,On Top,,0000,0000,0000,,اسمي تسوتسومي ياسويوكي
Dialogue: 0,0:04:34.44,0:04:37.36,On Top,,0000,0000,0000,,وأنا عضوٌ في نادي معجبين\Nشكّلناه في الجامعة
Dialogue: 0,0:04:37.65,0:04:40.86,Default,,0000,0000,0000,,!إنّه محقّ! ليس يايبا المقنّع
Dialogue: 0,0:04:40.86,0:04:43.58,Default,,0000,0000,0000,,الحقيقيّ أكثر وسامة
Dialogue: 0,0:04:45.06,0:04:47.04,Default,,0000,0000,0000,,أعتذر على تخييب أملكم
Dialogue: 0,0:04:47.04,0:04:49.75,Default,,0000,0000,0000,,...إذاً ذاك الشخص كان أيضاً
Dialogue: 0,0:04:50.19,0:04:53.36,Default,,0000,0000,0000,,بالمناسبة، أتريدون المشاركة في حفلة؟
Dialogue: 0,0:04:53.36,0:04:54.81,Default,,0000,0000,0000,,حفلة؟
Dialogue: 0,0:04:54.81,0:04:58.92,Default,,0000,0000,0000,,،اجتمع رفاقي في نادي المعجبين\Nويقيمون حفلة تنكّر
Dialogue: 0,0:04:58.92,0:05:01.10,Default,,0000,0000,0000,,!يبدو ذلك مسليّاً
Dialogue: 0,0:05:01.10,0:05:02.09,Default,,0000,0000,0000,,!أريد القدوم
Dialogue: 0,0:05:02.09,0:05:03.90,Default,,0000,0000,0000,,!فلتذهبوا
Dialogue: 0,0:05:03.90,0:05:05.76,Default,,0000,0000,0000,,هكذا لن أدفع لطعامهم
Dialogue: 0,0:05:06.27,0:05:09.48,Default,,0000,0000,0000,,،تفضّل بزيارتنا أيضاً يا موري-سان\Nلدينا جعّة أيضاً
Dialogue: 0,0:05:10.27,0:05:13.19,Default,,0000,0000,0000,,!جـ-جعّة؟ سآتي! سآتي
Dialogue: 0,0:05:13.73,0:05:16.07,Default,,0000,0000,0000,,ولن تدفع لجعّتك الآن كذلك
Dialogue: 0,0:05:16.61,0:05:19.46,Default,,0000,0000,0000,,الحفلة مقامة في قبو هذا القصر
Dialogue: 0,0:05:21.44,0:05:23.19,Default,,0000,0000,0000,,!يوجد الكثير من الوحوش
Dialogue: 0,0:05:23.19,0:05:26.49,Default,,0000,0000,0000,,!حتّى قرد الخيزران والخنزير العظميّ موجودان هنا
Dialogue: 0,0:05:26.90,0:05:28.45,Default,,0000,0000,0000,,!فضائيّ الخلد أيضاً
Dialogue: 0,0:05:29.81,0:05:31.67,Default,,0000,0000,0000,,موري-سان، دعني أعرّفك عليها
Dialogue: 0,0:05:32.48,0:05:38.31,Default,,0000,0000,0000,,إنّها رئيسة نادينا ومالكة القصر، ساوتومي مادوكا-سان
Dialogue: 0,0:05:38.31,0:05:40.13,Default,,0000,0000,0000,,أأنتِ طالة جامعيّة؟
Dialogue: 0,0:05:40.43,0:05:43.81,On Top,,0000,0000,0000,,أجل، أنا في سنتي الثالثة\Nفي كليّة الأدب
Dialogue: 0,0:05:40.77,0:05:47.16,CharCard,,0000,0000,0004,,{\fad(200,0)}(ساوتومي مادوكا (21\Nجامعة شيراكابا للإناث
Dialogue: 0,0:05:43.81,0:05:47.10,On Top,,0000,0000,0000,,يشرّفني الكلام مع المتحرّي الشهير موري-سان
Dialogue: 0,0:05:47.20,0:05:48.91,Default,,0000,0000,0000,,!البتّة
Dialogue: 0,0:05:48.91,0:05:53.87,Default,,0000,0000,0000,,يمكنني أن أحكي لك قصصي\N!نهاراً وليلاً ومتى أردتِ
Dialogue: 0,0:05:54.37,0:05:57.58,Default,,0000,0000,0000,,أتعرفون ما هو تنكّر تلك الآنسة؟
Dialogue: 0,0:05:57.58,0:05:59.71,Default,,0000,0000,0000,,أجل، ناتسومي ري، أليس كذلك؟
Dialogue: 0,0:05:59.71,0:06:01.84,Default,,0000,0000,0000,,تماماً! لا بدّ أنّكم تشاهدونه كثيراً
Dialogue: 0,0:06:02.16,0:06:05.55,Default,,0000,0000,0000,,أسبق وشاهدت يايبا المقنّع يا موري-سان؟
Dialogue: 0,0:06:05.91,0:06:10.80,Default,,0000,0000,0000,,،حسناً، كنتُ أرغب في مشاهدته\Nلكنّي مشغول بالعمل وقت عرضه دوماً
Dialogue: 0,0:06:10.92,0:06:13.52,Default,,0000,0000,0000,,بل مشغولٌ بالشرب وقتها
Dialogue: 0,0:06:13.52,0:06:17.66,Default,,0000,0000,0000,,يايبا المقنّع هو شاب عاديّ يبيع\Nالهوت دوغ في الحديقة عادةً
Dialogue: 0,0:06:17.66,0:06:21.23,Default,,0000,0000,0000,,مع صديقة طفولته، ناتسومي ري
Dialogue: 0,0:06:21.66,0:06:25.21,Default,,0000,0000,0000,,كلّما تقع حادثة، يهرع إلى مسرحها بدرّاجته الناريّة
Dialogue: 0,0:06:25.21,0:06:28.45,Default,,0000,0000,0000,,!ويقاتل الأشرار والمخلوقات الفضائيّة
Dialogue: 0,0:06:28.91,0:06:32.12,Default,,0000,0000,0000,,لكنّ ناتسومي ري تجهل\Nهويّة يايبا الحقيقيّة
Dialogue: 0,0:06:32.41,0:06:37.83,Default,,0000,0000,0000,,لذا يترك عمله دوماً ويذهب\Nإلى مكانٍ ما بدرّاجته
Dialogue: 0,0:06:37.83,0:06:42.79,Default,,0000,0000,0000,,ومع ذلك، تسامحه ناتسومي ري بكلّ رقّة
Dialogue: 0,0:06:44.25,0:06:47.01,Default,,0000,0000,0000,,أتفهّم شعورها نوعاً ما
Dialogue: 0,0:06:48.08,0:06:52.47,Default,,0000,0000,0000,,بالمناسبة، هذا الوضع يشبهني وران قليلاً
Dialogue: 0,0:06:52.79,0:06:57.41,Default,,0000,0000,0000,,!حسناً يا صغار، لنذهب للطاولة هناك! توجد عصيرات
Dialogue: 0,0:06:59.66,0:07:01.37,Default,,0000,0000,0000,,وأنا يا مادوكا-سان؟
Dialogue: 0,0:07:01.37,0:07:03.87,Default,,0000,0000,0000,,إنّها تحبّ الأطفال
Dialogue: 0,0:07:03.87,0:07:06.78,Default,,0000,0000,0000,,حسناً، ليتني أرجع طفلاً
Dialogue: 0,0:07:07.00,0:07:09.51,Default,,0000,0000,0000,,ليتني أرجع بالغاً
Dialogue: 0,0:07:14.37,0:07:17.16,Default,,0000,0000,0000,,!مرحباً يا هوندا، تأخّرت
Dialogue: 0,0:07:17.27,0:07:20.96,On Top,,0000,0000,0000,,أجل، آسف، طال الأمر قليلاً
Dialogue: 0,0:07:17.50,0:07:21.06,CharCard,,0000,0000,0004,,{\fad(200,0)}(هوندا أوسامو (21\Nكليّة الهندسة، جامعة جونان
Dialogue: 0,0:07:21.44,0:07:25.69,Default,,0000,0000,0000,,إنّه ذاك الشخص، كان عضواً في نادي\Nالمعجبين بالفعل إذاً
Dialogue: 0,0:07:26.39,0:07:28.60,Default,,0000,0000,0000,,...ماذا؟ زيّك هذا
Dialogue: 0,0:07:28.60,0:07:30.86,Default,,0000,0000,0000,,خطر لي أن أغيّر أحياناً
Dialogue: 0,0:07:31.35,0:07:36.76,Default,,0000,0000,0000,,هذه صدمة، لم تتنكّر بعير زيّ\Nيايبا المقنّع قبلاً
Dialogue: 0,0:07:36.76,0:07:40.62,Default,,0000,0000,0000,,صحيح، هذا المتحرّي الشهير موري كوغورو-سان
Dialogue: 0,0:07:41.68,0:07:43.08,Default,,0000,0000,0000,,مـ-موري؟
Dialogue: 0,0:07:44.72,0:07:49.31,Default,,0000,0000,0000,,إنّه هوندا أوسامو، طالب سنة ثالثة\Nفي كليّة الهندسة في جامعة جونان
Dialogue: 0,0:07:49.31,0:07:52.68,Default,,0000,0000,0000,,لا يزال حديثاً في النادي، مضى على التحاقه ستّة أشهر
Dialogue: 0,0:07:52.68,0:07:55.22,Default,,0000,0000,0000,,لكنّه أحد معجبي يايبا المقنّع الشغوفين جدّاً
Dialogue: 0,0:07:55.64,0:08:00.18,Default,,0000,0000,0000,,مسدّسك هذا ليس حقيقيّاً، صحيح؟
Dialogue: 0,0:08:00.18,0:08:03.56,Default,,0000,0000,0000,,!بالطبع لا! إنّه مقلّد! انظر بنفسك
Dialogue: 0,0:08:04.01,0:08:08.27,Default,,0000,0000,0000,,لا بدّ أنّه متقن الصنع، فهو مهووس بالمسدّسات
Dialogue: 0,0:08:10.85,0:08:14.78,Default,,0000,0000,0000,,الملمس والوزن دقيقان، إنّه مُبهر
Dialogue: 0,0:08:15.22,0:08:20.93,Default,,0000,0000,0000,,كلّ الطلقات فارغة، وأسطوانة المسدّس مسدودة بالطبع
Dialogue: 0,0:08:20.93,0:08:21.99,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:08:24.14,0:08:27.92,Default,,0000,0000,0000,,موري-سان! لمَ لا تأتي هنا\Nوتحكي لنا قصّة؟
Dialogue: 0,0:08:28.10,0:08:30.88,Default,,0000,0000,0000,,!أجل يا مادوكا-سان! من فوري
Dialogue: 0,0:08:31.35,0:08:32.81,Default,,0000,0000,0000,,يا للردّ
Dialogue: 0,0:08:32.81,0:08:33.84,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:08:33.84,0:08:36.08,Default,,0000,0000,0000,,رافقوني للطاولة أيضاً
Dialogue: 0,0:08:36.08,0:08:36.77,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:41.01,0:08:41.76,Default,,0000,0000,0000,,!هوندا
Dialogue: 0,0:08:46.56,0:08:51.14,CharCard,,0000,0000,0004,,{\fad(200,0)}(ميشيما كاتسوجي (21\Nكليّة التربية البدنيّة، جامعة توتو
Dialogue: 0,0:08:46.76,0:08:50.01,On Top,,0000,0000,0000,,!لن أسامحك! تحضّر يا هوندا
Dialogue: 0,0:08:50.01,0:08:51.06,On Top,,0000,0000,0000,,!سأقتلك
Dialogue: 0,0:08:54.06,0:08:55.28,Default,,0000,0000,0000,,!ميشيما-كن؟
Dialogue: 0,0:08:55.28,0:08:58.49,Default,,0000,0000,0000,,تـ-تمهّل يا ميشيما؟ ما الذي فعلتُه؟
Dialogue: 0,0:08:59.01,0:09:01.66,Default,,0000,0000,0000,,!لم أعد أحتمل سخريتك
Dialogue: 0,0:09:02.14,0:09:04.37,Default,,0000,0000,0000,,!اهدأ يا ميشيما! لنتكلّم في الأمر
Dialogue: 0,0:09:04.68,0:09:06.58,Default,,0000,0000,0000,,!اخرس! مُت
Dialogue: 0,0:09:11.81,0:09:12.71,Default,,0000,0000,0000,,!هوندا-كن
Dialogue: 0,0:09:19.01,0:09:19.55,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:09:19.55,0:09:20.51,Default,,0000,0000,0000,,!كلا يا كونان-كن
Dialogue: 0,0:09:20.51,0:09:21.93,Default,,0000,0000,0000,,!ميشيما
Dialogue: 0,0:09:33.35,0:09:34.98,Default,,0000,0000,0000,,...يا للهول
Dialogue: 0,0:09:46.18,0:09:47.20,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:55.01,0:09:56.63,Default,,0000,0000,0000,,...سترة مضادة للرصاص
Dialogue: 0,0:09:57.35,0:10:00.74,Default,,0000,0000,0000,,...كنتُ أرتديها، أنقذتني
Dialogue: 0,0:10:02.18,0:10:02.79,Default,,0000,0000,0000,,!هوندا
Dialogue: 0,0:10:02.79,0:10:04.80,Default,,0000,0000,0000,,هوندا-كن! أأنت بخير؟
Dialogue: 0,0:10:04.80,0:10:06.12,Default,,0000,0000,0000,,لا تتحرّك
Dialogue: 0,0:10:10.35,0:10:13.48,Default,,0000,0000,0000,,لا آثار حرق على صدغه
Dialogue: 0,0:10:14.06,0:10:18.78,Default,,0000,0000,0000,,صحيح، كان يبعد المسدّس عن رأسه\Nعندما أوشك على الانتحار
Dialogue: 0,0:10:19.51,0:10:20.95,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:10:23.76,0:10:27.60,Default,,0000,0000,0000,,المُتوفى هو ميشيما كاتسوجي-سان، 21 عاماً
Dialogue: 0,0:10:27.60,0:10:30.43,Default,,0000,0000,0000,,طالب سنة ثالثة في كليّة التربية\Nالبدنيّة في جامعة توتو
Dialogue: 0,0:10:30.43,0:10:31.62,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:10:31.89,0:10:34.75,Default,,0000,0000,0000,,كان هذا انتحاراً حقيقيّاً
Dialogue: 0,0:10:34.75,0:10:38.66,Default,,0000,0000,0000,,فقد شهدناه جميعاً بأنفسنا
Dialogue: 0,0:10:38.66,0:10:40.26,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:10:40.26,0:10:45.01,Default,,0000,0000,0000,,مع ذلك، يا للمنظر الغريب
Dialogue: 0,0:10:45.68,0:10:51.85,Default,,0000,0000,0000,,كانت شرطة الليزر ترتدي هذه الستر\Nالمضادة للرصاص عند قتال الوحوش دوماً
Dialogue: 0,0:10:51.85,0:10:55.56,Default,,0000,0000,0000,,فذهبتُ لمتجر أمنيّ واشتريت واحدة
Dialogue: 0,0:10:55.56,0:10:58.26,Default,,0000,0000,0000,,وفي جهله لذلك، اعتقد ميزوشيما-سان
Dialogue: 0,0:10:58.26,0:11:02.10,Default,,0000,0000,0000,,أنّه قتلك، فأطلق على رأسه بنفسه؟
Dialogue: 0,0:11:02.10,0:11:06.03,Default,,0000,0000,0000,,لكن لمَ كان يحاول قتلك؟
Dialogue: 0,0:11:06.35,0:11:07.55,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:11:09.43,0:11:10.28,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:11:10.28,0:11:14.22,Default,,0000,0000,0000,,كان هوندا-كن وميشيما-كن صديقان \Nمقرّبان كثيراً في الماضي
Dialogue: 0,0:11:14.63,0:11:16.39,Default,,0000,0000,0000,,وما الذي حصل؟
Dialogue: 0,0:11:16.91,0:11:21.57,Default,,0000,0000,0000,,قبل عشرة أيام تقريباً، عندما اجتمعنا\Nهنا للتخطيط لهذه الحفلة
Dialogue: 0,0:11:21.57,0:11:25.28,Default,,0000,0000,0000,,غضب ميشيما-كن من تعليقٍ\Nصدر عبثاً من ميشيما-كن
Dialogue: 0,0:11:25.28,0:11:27.61,Default,,0000,0000,0000,,فغادر مسرعاً
Dialogue: 0,0:11:27.99,0:11:30.91,Default,,0000,0000,0000,,وما الذي قلته له؟
Dialogue: 0,0:11:30.91,0:11:35.49,Default,,0000,0000,0000,,أخبرته أنّ درّاجته سخيفة
Dialogue: 0,0:11:35.49,0:11:36.83,Default,,0000,0000,0000,,فقط ذلك؟
Dialogue: 0,0:11:37.00,0:11:41.29,Default,,0000,0000,0000,,لا يُعقل! لا يمكن أن يُقدم أحد \N!على القتل لشيءٍ كهذا
Dialogue: 0,0:11:41.70,0:11:45.16,Default,,0000,0000,0000,,كلا، الأمر ليس مستبعداً كما يظهر
Dialogue: 0,0:11:45.16,0:11:50.26,Default,,0000,0000,0000,,فقد كان ميشيما شديد الهوس \Nبيايبا المقنّع حتّى بيننا
Dialogue: 0,0:11:50.91,0:11:53.85,Default,,0000,0000,0000,,أمضى قرابة نصف عام في تعديل\Nدرّاجة ناريّة عاديّة
Dialogue: 0,0:11:53.85,0:11:55.83,Default,,0000,0000,0000,,لتصبح درّاجة يايبا المقنّع
Dialogue: 0,0:11:57.36,0:12:01.98,Default,,0000,0000,0000,,فأتفهّم غضبه من السخرية منها
Dialogue: 0,0:12:01.98,0:12:04.36,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:12:04.36,0:12:06.94,Default,,0000,0000,0000,,لا تفسير غير هذا
Dialogue: 0,0:12:07.21,0:12:13.16,Default,,0000,0000,0000,,،لا يبدو أنّهم يكذبون في توضيحهم\Nلكن هناك ما يضايقني
Dialogue: 0,0:12:13.16,0:12:16.20,Default,,0000,0000,0000,,شيء في هذه الحادثة
Dialogue: 0,0:12:16.61,0:12:21.28,Default,,0000,0000,0000,,مفتّش ميغوري، كان المسدّس\Nمسدّس تقليد معدّل
Dialogue: 0,0:12:21.28,0:12:25.20,Default,,0000,0000,0000,,وكانت الرصاصة العالقة بالسترة\Nالمضادة للرصاص يدويّة الصنع أيضاً
Dialogue: 0,0:12:25.20,0:12:27.38,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:12:27.82,0:12:31.34,Default,,0000,0000,0000,,أكان ميشيما-سان ملمّاً بالمسدّسات؟
Dialogue: 0,0:12:31.66,0:12:33.95,Default,,0000,0000,0000,,لا أظن أنّه كان يعرف الكثير
Dialogue: 0,0:12:33.95,0:12:38.81,Default,,0000,0000,0000,,فقد سألني قبل فترة عن الفرق بين\Nالمسدّسات الآليّة والدوّارة
Dialogue: 0,0:12:39.70,0:12:42.90,Default,,0000,0000,0000,,...بالمناسبة، أكلّ أعضاء يايبا المقنّع
Dialogue: 0,0:12:45.45,0:12:49.61,Default,,0000,0000,0000,,أخبروني، أيّ شخصيات تحمل مسدّسات\Nفي يايبا المقنّع؟
Dialogue: 0,0:12:49.99,0:12:53.57,Default,,0000,0000,0000,,من يحملون المسدّسات هم شرطة\N!الليزر فحسب بالطبع
Dialogue: 0,0:12:53.99,0:12:56.49,Default,,0000,0000,0000,,لا يحمل يايبا المقنّع بنفسه مسدّساً؟
Dialogue: 0,0:12:56.49,0:13:00.70,Default,,0000,0000,0000,,!كونان-كن! لا يحتاج يايبا المقنّع لمسدّسات
Dialogue: 0,0:13:00.70,0:13:02.79,Default,,0000,0000,0000,,!يقاتل بيديه العاريتين دوماً
Dialogue: 0,0:13:03.74,0:13:05.53,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:13:05.53,0:13:09.51,Default,,0000,0000,0000,,لكن يترك ذلك أشياء كثيرة مبهمة
Dialogue: 0,0:13:09.73,0:13:13.72,Default,,0000,0000,0000,,لكنّي صُدمت لوقوع شيءٍ\Nكهذا أمام أعيننا
Dialogue: 0,0:13:14.20,0:13:18.89,Default,,0000,0000,0000,,بالفعل، يبدو أنّ الأحداث في الدراما\Nقد تقّع على الواقع أحياناً
Dialogue: 0,0:13:20.28,0:13:22.69,Default,,0000,0000,0000,,الدراما؟ تمثيل؟
Dialogue: 0,0:13:27.91,0:13:31.36,Default,,0000,0000,0000,,!اتّصلت كلّ الألغاز الآن
Dialogue: 0,0:13:31.36,0:13:34.66,Default,,0000,0000,0000,,!هذه قضيّة... جريمة قتل
Dialogue: 0,0:13:41.16,0:13:45.49,Default,,0000,0000,0000,,إذا أصاب استنتاجي، فستُحلّ كلّ الألغاز
Dialogue: 0,0:13:46.95,0:13:51.36,Default,,0000,0000,0000,,تبّاً... يرتكب جريمة قتل أمام ناظري
Dialogue: 0,0:13:51.36,0:13:52.80,Default,,0000,0000,0000,,!لن أسامحه
Dialogue: 0,0:13:53.45,0:13:56.99,Default,,0000,0000,0000,,الدليل، أنا بحاجة لدليلٍ دامغ
Dialogue: 0,0:13:58.85,0:14:00.85,Default,,0000,0000,0000,,...صحيح! آنذاك
Dialogue: 0,0:14:02.11,0:14:05.57,Default,,0000,0000,0000,,!غينتا! أعرني شارة فرقة التحرّي خاصّتك قليلاً
Dialogue: 0,0:14:05.57,0:14:07.84,Default,,0000,0000,0000,,ماذا؟ شارتي؟
Dialogue: 0,0:14:09.91,0:14:10.96,Default,,0000,0000,0000,,قال موري-سان ذلك؟
Dialogue: 0,0:14:11.19,0:14:16.47,Default,,0000,0000,0000,,أجل، طلب منّي أن أرسلها للفحص الفوريّ
Dialogue: 0,0:14:19.49,0:14:22.95,Default,,0000,0000,0000,,حضرة المفتّش، أودّ أخذ هوندا للمشفى
Dialogue: 0,0:14:22.95,0:14:25.28,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:14:25.28,0:14:29.42,Default,,0000,0000,0000,,،حتّى لو كان يرتدي سترةً مضادة للرصاص\Nفقد أُصيب برصاصة عن قرب
Dialogue: 0,0:14:29.74,0:14:34.97,Default,,0000,0000,0000,,،قد يعاني بضعة أضلاع مكسورة\Nلنأخذه هناك بسيّارة شرطة
Dialogue: 0,0:14:35.41,0:14:36.74,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:36.74,0:14:38.22,Default,,0000,0000,0000,,لـ-لمَ؟
Dialogue: 0,0:14:40.28,0:14:42.35,Default,,0000,0000,0000,,انتظر حضرة المفتّش
Dialogue: 0,0:14:42.35,0:14:46.27,Default,,0000,0000,0000,,أجّل اصطحابه للمشفى من فضلك
Dialogue: 0,0:14:46.58,0:14:51.61,Default,,0000,0000,0000,,سأحلّ الآن لغز جريمة القتل البغيضة هذه
Dialogue: 0,0:14:51.99,0:14:54.74,Default,,0000,0000,0000,,ما الذي تتكلّم عنه يا موري-كن؟
Dialogue: 0,0:14:54.74,0:14:57.03,Default,,0000,0000,0000,,ألم ينتحر ميشيما-سان؟
Dialogue: 0,0:14:57.03,0:15:00.91,Default,,0000,0000,0000,,كلا، كانت هذه جريمة قتل كليّة
Dialogue: 0,0:15:00.91,0:15:03.18,Default,,0000,0000,0000,,من تدبير أحدهم منذ البداية
Dialogue: 0,0:15:03.67,0:15:04.75,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:06.03,0:15:09.91,Default,,0000,0000,0000,,اقترح ذلك الشخص على ميشيما-سان
Dialogue: 0,0:15:09.91,0:15:15.17,Default,,0000,0000,0000,,أن يمثلا مسرحيةً صغيرة في الحفلة\Nالقادمة أمام الجميع لمفاجأتهم
Dialogue: 0,0:15:15.57,0:15:16.88,Default,,0000,0000,0000,,يمثلا؟
Dialogue: 0,0:15:17.20,0:15:24.61,Default,,0000,0000,0000,,كانت أن يتظاهر ميشيما-سان بإطلاقه\Nعلى شخصٍ ما، ثمّ ينتحر بعدها
Dialogue: 0,0:15:24.61,0:15:30.61,Default,,0000,0000,0000,,لوضع أساس ذلك، تظاهرا بجدالٍ زائف أمام الجميع قبلاً
Dialogue: 0,0:15:31.91,0:15:36.90,Default,,0000,0000,0000,,صحيح، كان ذاك الشخص هو \N!أنت يا هوندا أوسامو-سان
Dialogue: 0,0:15:41.95,0:15:42.62,Default,,0000,0000,0000,,ما الذي تقوله؟
Dialogue: 0,0:15:43.11,0:15:47.82,Default,,0000,0000,0000,,أوّلاً، عدّلت مسدّسين مقلّدين\Nمن الطراز نفسه
Dialogue: 0,0:15:47.82,0:15:50.61,Default,,0000,0000,0000,,وحضّرت صنفين من الطلقات
Dialogue: 0,0:15:50.61,0:15:56.96,Default,,0000,0000,0000,,،كان أحدهما رصاصات حقيقيّة\Nبينما الآخر ذخيرة فارغة
Dialogue: 0,0:15:57.89,0:16:02.08,Default,,0000,0000,0000,,أعطيتَ ميشيما-سان المسدّس\Nبالذخيرة الفارغة بدايةً
Dialogue: 0,0:16:02.56,0:16:08.14,Default,,0000,0000,0000,,قبل بداية الحفلة اليوم، التقيتَه في ضريح بيكا
Dialogue: 0,0:16:08.14,0:16:13.70,Default,,0000,0000,0000,,وبدّلت المسدّس ذو الذخيرة الفارغة بالآخر \Nذي الرصاصات الحقيقيّة الذي كان بحوزتك
Dialogue: 0,0:16:14.22,0:16:18.26,Default,,0000,0000,0000,,فعلتَ ذلك بقول أنّك\Nتجري مراجعة نهائيّة غالباً
Dialogue: 0,0:16:18.26,0:16:23.22,Default,,0000,0000,0000,,المسدّس الذي على خصر هوندا-سان\Nالآن هو مسدّس ميشيما-سان إذاً؟
Dialogue: 0,0:16:23.22,0:16:30.27,Default,,0000,0000,0000,,ماذا؟ لكن ألم تكن أسطوانة المسدّس\Nالذي بحوزته مسدودة؟
Dialogue: 0,0:16:30.81,0:16:34.56,Default,,0000,0000,0000,,كما أنّ المسدّس ذو الرصاصات\Nالحقيقيّة لم يكن مسدوداً
Dialogue: 0,0:16:34.56,0:16:37.24,Default,,0000,0000,0000,,ألم يكن هنالك احتمال\Nبملاحظة ميشيما-سان لذلك؟
Dialogue: 0,0:16:37.38,0:16:43.06,Default,,0000,0000,0000,,كلا، لم تكن أسطوانة المسدّس الذي\Nأعطاه ميشيما-سان مسدودة
Dialogue: 0,0:16:43.06,0:16:45.76,Default,,0000,0000,0000,,قام بسدّها بعد التبديل
Dialogue: 0,0:16:45.76,0:16:48.42,Default,,0000,0000,0000,,كيلا يثير الشبهة بعد الحادثة
Dialogue: 0,0:16:48.97,0:16:51.89,Default,,0000,0000,0000,,تنكُّر هوندا-سان كفرد\Nمن شرطة الليزر اليوم
Dialogue: 0,0:16:51.89,0:16:55.67,Default,,0000,0000,0000,,بدل تنكّره المعتاد كيايبا المقنّع
Dialogue: 0,0:16:55.67,0:16:59.26,Default,,0000,0000,0000,,كان لأنّ حمل أعضاء شرطة الليزر لمسدّس
Dialogue: 0,0:16:59.26,0:17:03.18,Default,,0000,0000,0000,,أو ارتداء سترة مضادة للرصاص\Nلن يكون غريباً في حالتهم فقط
Dialogue: 0,0:17:03.97,0:17:06.43,Default,,0000,0000,0000,,عندما قفز ميشيما-سان
Dialogue: 0,0:17:06.43,0:17:10.27,Default,,0000,0000,0000,,تحرّكت بحيث يبدو أنّك تبعدنا عن الخطر
Dialogue: 0,0:17:10.68,0:17:15.03,Default,,0000,0000,0000,,لكن كان ذلك لتجعل نفسك\Nهدفاً أسهل لـ ميشيما-سان
Dialogue: 0,0:17:15.03,0:17:17.31,Default,,0000,0000,0000,,،لـ-لكن يا موري-سان
Dialogue: 0,0:17:17.31,0:17:22.70,Default,,0000,0000,0000,,ألن يلاحظ ميشيما وجود أمرٍ غريب\Nإذا انطلقت رصاصات حقيقيّة؟
Dialogue: 0,0:17:23.14,0:17:25.72,Default,,0000,0000,0000,,قام مع هوندا-سان بتمارين سابقة غالباً
Dialogue: 0,0:17:25.72,0:17:30.12,Default,,0000,0000,0000,,بحيث تظاهر بإصابته مع صدور صوت الإطلاق
Dialogue: 0,0:17:31.25,0:17:34.42,Default,,0000,0000,0000,,لذا بعد رؤيته لإصابة هوندا-سان\Nفعلياً هذه المرة
Dialogue: 0,0:17:34.68,0:17:39.93,Default,,0000,0000,0000,,اعتقد ميشيما-سان أنّ الأمر\Nمماثل لتمارينهما
Dialogue: 0,0:17:39.93,0:17:41.64,Default,,0000,0000,0000,,ما يُعرف بالإحياء الذاتي
Dialogue: 0,0:17:42.01,0:17:47.31,Default,,0000,0000,0000,,لكن، أيوجد دليلٌ على أنّ\Nميشيما-كن لم ينتحر؟
Dialogue: 0,0:17:47.68,0:17:52.85,Default,,0000,0000,0000,,من يريد الانتحار حقّاً، ستبقى على\Nرأسه آثار احتراق
Dialogue: 0,0:17:52.85,0:17:55.44,Default,,0000,0000,0000,,عندما يلصق فوهة المسدّس به
Dialogue: 0,0:17:55.54,0:17:58.49,Default,,0000,0000,0000,,لكن لم تكن هنالك آثار على ميشيما-سان
Dialogue: 0,0:17:58.49,0:18:01.45,Default,,0000,0000,0000,,حتّى بالذخيرة الفارغة، ستصدر شعلة
Dialogue: 0,0:18:01.45,0:18:05.28,Default,,0000,0000,0000,,لذا أبعد المسدّس عن رأسه قليلاً
Dialogue: 0,0:18:05.28,0:18:07.43,Default,,0000,0000,0000,,كيلا يحترق
Dialogue: 0,0:18:07.67,0:18:12.31,Default,,0000,0000,0000,,!لا يمكنكم الجزم بذلك! فقد كان ميشيما غريب أطوار
Dialogue: 0,0:18:12.86,0:18:15.45,Default,,0000,0000,0000,,دعوني أقدّم الدليل لكم إذاً
Dialogue: 0,0:18:15.45,0:18:16.52,Default,,0000,0000,0000,,حضرة المحلّل
Dialogue: 0,0:18:19.36,0:18:25.45,Default,,0000,0000,0000,,الـ-المعذرة، وجدنا بصمات أخرى\Nلا تخصّ ميشيما-سان الميت
Dialogue: 0,0:18:25.45,0:18:27.86,Default,,0000,0000,0000,,على هذا المسدّس
Dialogue: 0,0:18:27.86,0:18:31.37,Default,,0000,0000,0000,,إنّها تطابق البصمات على شارة الطفل أيضاً
Dialogue: 0,0:18:32.40,0:18:33.42,Default,,0000,0000,0000,,...تلك الشارة
Dialogue: 0,0:18:33.42,0:18:34.79,Default,,0000,0000,0000,,!إنّها لغينتا-كن
Dialogue: 0,0:18:35.74,0:18:37.95,Default,,0000,0000,0000,,...إ-إذاً
Dialogue: 0,0:18:37.95,0:18:39.78,Default,,0000,0000,0000,,أنا القاتل؟
Dialogue: 0,0:18:39.78,0:18:44.57,Default,,0000,0000,0000,,غينتا-كن! متى لمستَ مسدّس ميشيما-سان؟
Dialogue: 0,0:18:44.57,0:18:46.51,Default,,0000,0000,0000,,!لـ-لم ألمسه
Dialogue: 0,0:18:46.51,0:18:47.78,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:18:47.78,0:18:53.72,Default,,0000,0000,0000,,،لو لم يلمس غينتا مسدّس ميشيما-سان\Nفلمَ بصماته عليه؟
Dialogue: 0,0:18:54.66,0:18:56.70,Default,,0000,0000,0000,,!للإجابة على ذلك، كونان
Dialogue: 0,0:18:56.70,0:18:58.28,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:18:58.28,0:18:59.24,Default,,0000,0000,0000,,هوندا-سان
Dialogue: 0,0:18:59.24,0:19:02.66,Default,,0000,0000,0000,,صادفتنا في ضريح بيكا قبل\Nقدومك إلى هنا، أليس كذلك؟
Dialogue: 0,0:19:02.66,0:19:04.07,Default,,0000,0000,0000,,...قام غينتا وقتها
Dialogue: 0,0:19:04.07,0:19:06.49,Default,,0000,0000,0000,,!هذا المسدّس رائع
Dialogue: 0,0:19:06.78,0:19:07.95,Default,,0000,0000,0000,,!لا تلمسه
Dialogue: 0,0:19:07.95,0:19:12.66,Default,,0000,0000,0000,,لـ-لمسه آنذاك؟
Dialogue: 0,0:19:12.95,0:19:17.95,Default,,0000,0000,0000,,كون المسدّس الذي كان معك\Nهو مسدّس ميشيما-سان
Dialogue: 0,0:19:17.95,0:19:21.40,Default,,0000,0000,0000,,!دليلٌ على تبديلك للمسدّسين لاحقاً
Dialogue: 0,0:19:23.24,0:19:24.59,Default,,0000,0000,0000,,...هوندا-كن
Dialogue: 0,0:19:25.61,0:19:29.80,Default,,0000,0000,0000,,موري-سان، متى بدأت الاشتباه بي؟
Dialogue: 0,0:19:31.07,0:19:35.49,Default,,0000,0000,0000,,أخبرني تسوتسومي-سان أنّك\Nكنت مهووساً بالمسدّسات
Dialogue: 0,0:19:35.49,0:19:40.02,Default,,0000,0000,0000,,،مع ذلك، سددت أسطوانة مسدّس\Nوذلك ما أثار غرابتي
Dialogue: 0,0:19:40.61,0:19:47.52,Default,,0000,0000,0000,,فهمت، سدّي للمسدّس لتوخّي الحذر أدّى لهلاكي
Dialogue: 0,0:19:48.95,0:19:51.11,Default,,0000,0000,0000,,...قتلت ميشيما
Dialogue: 0,0:19:51.11,0:19:52.95,Default,,0000,0000,0000,,!للانتقام لأخي الصغير
Dialogue: 0,0:19:55.66,0:19:59.45,Default,,0000,0000,0000,,قبل عامين، كان أخي الصغير هيروشي\Nمتوجّهاً لمنزل صديق
Dialogue: 0,0:19:59.45,0:20:02.00,Default,,0000,0000,0000,,بلوحة بتوقيع يايبا المقنّع
Dialogue: 0,0:19:59.54,0:20:02.10,On Top,,0000,0000,0000,,{\fad(200,0)}إلى هيروشي-كن
Dialogue: 0,0:20:02.10,0:20:04.06,Default,,0000,0000,0000,,كان قد فاز بها في مسابقة إحدى المجلّات
Dialogue: 0,0:20:11.84,0:20:13.86,Default,,0000,0000,0000,,!انتظر! أعدها لي
Dialogue: 0,0:20:17.88,0:20:21.06,Default,,0000,0000,0000,,مات هيروشي بعدها بيومين
Dialogue: 0,0:20:22.55,0:20:27.79,Default,,0000,0000,0000,,"كانت آخر كلماته "اجعل يايبا المقنّع يمسك به
Dialogue: 0,0:20:28.34,0:20:33.34,Default,,0000,0000,0000,,انضممتُ لعددٍ من أندية معجبي\Nيايبا المقنّع لجمع معلومات
Dialogue: 0,0:20:33.34,0:20:36.72,Default,,0000,0000,0000,,واكتشاف هويّة السارق
Dialogue: 0,0:20:37.51,0:20:39.31,Default,,0000,0000,0000,,...ثمّ قبل 6 أشهر
Dialogue: 0,0:20:40.01,0:20:43.39,Default,,0000,0000,0000,,!أراني ميشيما تلك اللوحة أخيراً
Dialogue: 0,0:20:43.76,0:20:48.15,Default,,0000,0000,0000,,ادّعى أنّ أخاه الكبير فاز بها وأعطاه إيّاها
Dialogue: 0,0:20:48.55,0:20:52.03,Default,,0000,0000,0000,,!لكن لم يكن لديه أخٌ يُدعى هيروشي
Dialogue: 0,0:20:52.38,0:20:55.53,Default,,0000,0000,0000,,لذا انتقمتَ منه؟
Dialogue: 0,0:20:56.05,0:20:59.42,Default,,0000,0000,0000,,،حضرة المفتّش، لا يظهر هذا في الدراما التلفزيّة
Dialogue: 0,0:20:59.42,0:21:05.25,Default,,0000,0000,0000,,لكن ليايبا المقنّع قصّة خلفيّة\Nقُتلت فيها شقيقته الصغيرة
Dialogue: 0,0:21:05.67,0:21:13.21,Default,,0000,0000,0000,,انضممتُ لأندية المعجبين لقتل الشخص الذي\Nسرق لوحة هيروشي وقاده لموته
Dialogue: 0,0:21:13.21,0:21:17.97,Default,,0000,0000,0000,,لكن في مرحلةٍ ما، بدأت أشعر أنّي\Nمشابه ليايبا المقنّع
Dialogue: 0,0:21:18.36,0:21:20.99,Default,,0000,0000,0000,,!لا شبه بينك وبين يايبا المقنّع أبداً
Dialogue: 0,0:21:22.20,0:21:25.73,Default,,0000,0000,0000,,!لا يقاتل يايبا المقنّع للانتقام
Dialogue: 0,0:21:25.73,0:21:28.91,Default,,0000,0000,0000,,!صحيح! إنّه يقاتل للعدالة
Dialogue: 0,0:21:29.44,0:21:32.98,Default,,0000,0000,0000,,أجل، الأطفال محقّون
Dialogue: 0,0:21:32.98,0:21:38.88,Default,,0000,0000,0000,,من المؤسف أنّك كنت مخطئاً\Nفي فهم يايبا المقنّع هكذا
Dialogue: 0,0:23:23.46,0:23:26.80,Default,,0000,0000,0000,,ستظهر يوكو-تشان في برنامج غنائيّ\N!في السابعة والنصف هذه الليلة
Dialogue: 0,0:23:27.26,0:23:31.26,Default,,0000,0000,0000,,لكن لا يمكنك، سنشاهد يايبا المقنّع\Nعند السابعة والنصف
Dialogue: 0,0:23:31.49,0:23:34.97,Default,,0000,0000,0000,,!ماذا؟! لا نشاهده في العادة
Dialogue: 0,0:23:35.38,0:23:37.59,Default,,0000,0000,0000,,قرّرنا البدء بمشاهدته من الليلة
Dialogue: 0,0:23:37.59,0:23:43.38,Default,,0000,0000,0000,,فيايبا المقنّع يقاتل الأشرار\N!لأجل العدالة! علينا دعمه
Dialogue: 0,0:23:43.38,0:23:44.69,Default,,0000,0000,0000,,أليس كذلك يا كونان-كن؟
Dialogue: 0,0:23:46.56,0:23:49.15,Default,,0000,0000,0000,,...يا حمقاء! يوكو-تشان أيضاً
Dialogue: 0,0:23:49.15,0:23:50.71,Default,,0000,0000,0000,,يوكو-تشان أيضاً؟
Dialogue: 0,0:23:51.13,0:23:53.92,Default,,0000,0000,0000,,!إ-إنّها تغنّي لأجلي
Dialogue: 0,0:23:56.26,0:23:59.19,Default,,0000,0000,0000,,...سيعيش هذا المُسنّ حياةً طويلة
Dialogue: 0,0:24:05.34,0:24:07.80,Default,,0000,0000,0000,,!كـ-كانت تلك الرئيسة يامازاكي
Dialogue: 0,0:24:11.31,0:24:14.27,Default,,0000,0000,0000,,ما هذا الشيء الدبق؟
Dialogue: 0,0:24:14.27,0:24:17.23,Default,,0000,0000,0000,,أي كانت الغرفة مقفلةً بالكامل
Dialogue: 0,0:24:17.56,0:24:20.76,Default,,0000,0000,0000,,ربما لم تكن هذه حادثة
Dialogue: 0,0:24:20.76,0:24:25.45,Default,,0000,0000,0000,,من المحتمل أنّها جريمة قتل من تخطيط\N!أحد الأشخاص في الداخل
Dialogue: 0,0:24:25.45,0:24:31.45,On Top,,0000,0000,0000,,جريمة قتل كوكتيل العسل
Dialogue: 0,0:24:25.68,0:24:27.22,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.22,0:24:30.43,Default,,0000,0000,0000,,جريمة قتل كوكتيل العسل
Dialogue: 0,0:24:47.16,0:24:49.46,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.46,0:24:51.46,Default,,0000,0000,0000,,بالون
Dialogue: 0,0:24:51.74,0:24:53.41,Default,,0000,0000,0000,,تحمل الحلقة القادمة\N(نكهة العسل! (هاتشيميتسو
Dialogue: 0,0:24:53.31,0:24:56.89,Thoughts,,0000,0000,15,,هاتشي: 8    ميتسو: 3
Dialogue: 0,0:24:53.41,0:24:53.94,Default,,0000,0000,0000,,!الحاصل 24
Dialogue: 0,0:24:53.94,0:24:54.89,Default,,0000,0000,0000,,ماذا؟ لمَ؟
Dialogue: 0,0:24:54.89,0:24:56.89,Default,,0000,0000,0000,,ثمانية ضرب ثلاثة، صحيح؟

