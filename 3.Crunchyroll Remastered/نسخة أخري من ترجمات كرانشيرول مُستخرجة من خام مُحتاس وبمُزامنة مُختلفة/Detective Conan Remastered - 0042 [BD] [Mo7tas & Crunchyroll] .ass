Dialogue: 0,0:00:01.67,0:00:04.22,Default,,0,0,0,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:05.01,0:00:07.05,Default,,0,0,0,,!مسرح اليوم هو حجرة كاراوكي
Dialogue: 0,0:00:07.05,0:00:09.57,Default,,0,0,0,,!أغاني حُب ووداع أثناء الكريسماس
Dialogue: 0,0:00:09.57,0:00:11.23,Default,,0,0,0,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.23,0:00:13.39,Default,,0,0,0,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.39,0:00:15.44,Default,,0,0,0,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:46.64,0:01:49.35,Title,,0,0,0,,{\fad(330,0)}جريمة قتل حجرة الكاراوكي
Dialogue: 0,0:01:46.64,0:01:49.35,Default,,0,0,0,,جريمة قتل حجرة الكاراوكي
Dialogue: 0,0:01:53.22,0:01:58.26,Default,,0,0,0,,نحن في موسم الكريسماس، فلمَ أنتما\Nمن بجواري بالتحديد؟
Dialogue: 0,0:01:58.26,0:02:00.76,Default,,0,0,0,,هذا كلامي
Dialogue: 0,0:02:00.76,0:02:03.09,Default,,0,0,0,,ما وضع شينتشي-كن بالمناسبة؟
Dialogue: 0,0:02:03.09,0:02:05.76,Default,,0,0,0,,يتّصل بي من فترة لفترة فقط
Dialogue: 0,0:02:05.76,0:02:09.68,Default,,0,0,0,,!يا للوقح! الكريسماس يحلّ مرّةً في العام فحسب
Dialogue: 0,0:02:09.68,0:02:12.34,Default,,0,0,0,,!مهووس التحرّي ذاك مجرّد متغطرس فحسب
Dialogue: 0,0:02:12.34,0:02:13.38,Default,,0,0,0,,بالفعل
Dialogue: 0,0:02:14.30,0:02:18.01,Default,,0,0,0,,دائماً مفعم بالثقة ومتعالٍ ولئيم
Dialogue: 0,0:02:19.01,0:02:22.17,Default,,0,0,0,,لكن لديه جوانب حسنة أيضاً
Dialogue: 0,0:02:23.47,0:02:24.22,Default,,0,0,0,,ران
Dialogue: 0,0:02:25.68,0:02:28.22,Default,,0,0,0,,ماذا عنك؟ أيوجد شخص تحبّينه؟
Dialogue: 0,0:02:28.22,0:02:31.42,Default,,0,0,0,,بالطبع، اسمه كيمورا تاتسويا
Dialogue: 0,0:02:31.42,0:02:33.01,Default,,0,0,0,,ماذا؟ تاتسويا؟
Dialogue: 0,0:02:33.01,0:02:39.27,Default,,0,0,0,,إنّه كيمورا تاتسويا من فرقة الروك "ليكس" الصاعدة
Dialogue: 0,0:02:39.47,0:02:42.22,Default,,0,0,0,,مجرّد مشهور إذاً
Dialogue: 0,0:02:42.63,0:02:47.60,Default,,0,0,0,,حصل لي أبي على دعوة لإحدى حفلاتهم
Dialogue: 0,0:02:47.60,0:02:50.42,Default,,0,0,0,,!سأستطيع رؤية تاتسويا مباشرةً
Dialogue: 0,0:02:50.42,0:02:51.17,Default,,0,0,0,,تريدين القدوم؟
Dialogue: 0,0:02:51.17,0:02:53.09,Default,,0,0,0,,!ستلتقينهم؟
Dialogue: 0,0:02:53.09,0:02:55.55,Default,,0,0,0,,كما تتوقّع من ابنة مجموعة سوزوكي
Dialogue: 0,0:02:56.01,0:02:57.51,Default,,0,0,0,,متى نذهب؟
Dialogue: 0,0:02:57.51,0:02:59.31,Default,,0,0,0,,الأحد القادم
Dialogue: 0,0:02:59.31,0:03:00.84,Default,,0,0,0,,!سآتي حتماً
Dialogue: 0,0:03:09.61,0:03:12.05,Default,,0,0,0,,!أنتما بارعتان
Dialogue: 0,0:03:13.51,0:03:16.77,CharCard,,0,0,7,,{\fad(33,200)} (21)  كيمورا تاتسويا\Nالمغنيّ الرئيسي
Dialogue: 0,0:03:14.31,0:03:15.90,On Top,,0,0,0,,بالفعل
Dialogue: 0,0:03:15.90,0:03:19.10,On Top,,0,0,0,,أفضل من فرقةٍ ما
Dialogue: 0,0:03:20.17,0:03:22.47,Default,,0,0,0,,!مهلك يا تاتسويا، شربت الكثير
Dialogue: 0,0:03:22.47,0:03:25.64,Default,,0,0,0,,!أخبرتك أنّ لدينا برنامجاً حوارياً بعد هذا
Dialogue: 0,0:03:26.22,0:03:27.97,Default,,0,0,0,,!اخرسي! دعيني وشأني يا قبيحة
Dialogue: 0,0:03:27.97,0:03:29.36,Default,,0,0,0,,قبيحة؟
Dialogue: 0,0:03:29.36,0:03:31.26,Default,,0,0,0,,إنّه ثمل جدّاً
Dialogue: 0,0:03:31.25,0:03:34.86,CharCard,,0,0,5,,{\fad(30,300)}(21)  يامادا كاتسومي\Nالطبّال
Dialogue: 0,0:03:31.79,0:03:35.22,On Top,,0,0,0,,ليس هكذا تخاطبها يا تاتسويا
Dialogue: 0,0:03:35.22,0:03:37.93,Default,,0,0,0,,تؤدي ماري عملها كمديرة فحسب
Dialogue: 0,0:03:38.92,0:03:44.09,Default,,0,0,0,,بذكرك ذلك، هل كنت تقوم بعملك كطبّالنا؟
Dialogue: 0,0:03:45.39,0:03:47.43,Default,,0,0,0,,وأنتِ كذلك يا مييكو
Dialogue: 0,0:03:47.43,0:03:51.14,CharCard,,0,0,5,,{\fad(30,200)}(20) شيبازوكي مييكو\Nغيتار
Dialogue: 0,0:03:48.31,0:03:50.46,On Top,,0,0,0,,ما خطبك أدائك اليوم؟
Dialogue: 0,0:03:50.46,0:03:53.30,On Top,,0,0,0,,!سئمت من عزفك السيّئ
Dialogue: 0,0:03:53.30,0:03:54.72,Default,,0,0,0,,أعتذر على الإطالة
Dialogue: 0,0:03:54.72,0:03:56.64,Default,,0,0,0,,كنت بانتظارك يا سومي-سان
Dialogue: 0,0:03:56.97,0:03:59.80,Default,,0,0,0,,طلبتُ من مديرتنا الحجز في محلّك
Dialogue: 0,0:03:59.80,0:04:03.55,CharCard,,0,220,5,,{\fad(30,0)}(28) سومي غو\Nمالك حجرة الكاراوكي
Dialogue: 0,0:04:00.55,0:04:03.55,On Top,,0,0,0,,شكراً، أقدّر زيارتك الدائمة لنا
Dialogue: 0,0:04:03.76,0:04:06.76,Default,,0,0,0,,من المحزن حقّاً أن يدير قائد فرقة سابق
Dialogue: 0,0:04:06.76,0:04:10.01,Default,,0,0,0,,محلّاً متواضعاً كهذا
Dialogue: 0,0:04:10.01,0:04:13.01,On Top,,0,0,0,,!اصمت
Dialogue: 0,0:04:10.80,0:04:12.01,Default,,0,0,0,,قائد فرقة سابق؟
Dialogue: 0,0:04:14.43,0:04:16.14,Default,,0,0,0,,...ماذا؟ هذه الأغنية
Dialogue: 0,0:04:16.14,0:04:18.35,Default,,0,0,0,,الرنّة أحمر الأنف
Dialogue: 0,0:04:18.35,0:04:19.84,Default,,0,0,0,,قمتُ بطلبها
Dialogue: 0,0:04:21.51,0:04:24.05,Default,,0,0,0,,لأجلك يا مديرتنا
Dialogue: 0,0:04:24.05,0:04:28.81,CharCard,,0,0,7,,{\fad(30,200)}(23) تيراهارا ماري\Nالمديرة
Dialogue: 0,0:04:25.47,0:04:28.81,On Top,,0,0,0,,...إنّها مثالية لك بما أنّك آمنتِ بسانتا
Dialogue: 0,0:04:29.18,0:04:31.63,Default,,0,0,0,,حتّى المدرسة الإعدادية
Dialogue: 0,0:04:31.63,0:04:36.18,Default,,0,0,0,,ألا توافقينني أيّتها المديرة الجميلة دائمة التظاهر؟
Dialogue: 0,0:04:36.68,0:04:38.18,Default,,0,0,0,,...هذا الوغد
Dialogue: 0,0:04:38.18,0:04:40.80,Default,,0,0,0,,فهمت، عليّ غناؤها فحسب إذاً
Dialogue: 0,0:04:42.80,0:04:44.05,Default,,0,0,0,,أراك لاحقاً يا تاتسويا
Dialogue: 0,0:04:44.05,0:04:45.05,Default,,0,0,0,,إلى اللقاء
Dialogue: 0,0:04:51.46,0:04:52.96,Default,,0,0,0,,!إنّها بارعة
Dialogue: 0,0:04:52.96,0:04:53.95,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:04:54.27,0:04:55.93,Default,,0,0,0,,!ما قصّته بالضبط؟
Dialogue: 0,0:04:59.39,0:05:02.51,Default,,0,0,0,,ما خطب هذه التعابير الحزينة؟
Dialogue: 0,0:05:07.10,0:05:09.76,Default,,0,0,0,,تريد الغناء أيضاً يا صبيّ؟
Dialogue: 0,0:05:09.76,0:05:11.38,Default,,0,0,0,,!كلا، لا داعي
Dialogue: 0,0:05:17.01,0:05:20.76,Default,,0,0,0,,لمَ تبكي تلك الآنسة بينما تغنّي؟
Dialogue: 0,0:05:20.76,0:05:23.22,Default,,0,0,0,,لأنّي سأودّع
Dialogue: 0,0:05:23.93,0:05:26.01,Default,,0,0,0,,أودّعها والفرقة
Dialogue: 0,0:05:27.72,0:05:29.67,Default,,0,0,0,,!هل ستترك ليكس؟
Dialogue: 0,0:05:29.92,0:05:34.14,Default,,0,0,0,,أجل، سأرحل حالما تنتهي هذه الجولة
Dialogue: 0,0:05:34.55,0:05:36.45,Default,,0,0,0,,الجميع في الفرقة على علم
Dialogue: 0,0:05:38.13,0:05:46.10,Default,,0,0,0,,سأودّع الطبّال السيّئ وعازفة الغيتار الطفولية\Nوالمديرة المغرورة
Dialogue: 0,0:05:46.58,0:05:48.39,Default,,0,0,0,,...لا-لا يمكن
Dialogue: 0,0:05:52.24,0:05:54.48,Default,,0,0,0,,!عجباً، إنّها أغنيتي
Dialogue: 0,0:05:54.48,0:05:56.11,Default,,0,0,0,,من طلبها؟
Dialogue: 0,0:05:58.07,0:06:00.10,Default,,0,0,0,,!تاتسويا! إنّه وقت الذهاب
Dialogue: 0,0:06:00.10,0:06:01.72,Default,,0,0,0,,!علينا الإسراع وإلّا سيفوتك البرنامج الحواري
Dialogue: 0,0:06:01.72,0:06:05.06,Default,,0,0,0,,!اخرسي! سأغنّي متى شعرت برغبة في ذلك
Dialogue: 0,0:06:06.06,0:06:07.06,Default,,0,0,0,,ليس باليد حيلة
Dialogue: 0,0:06:08.26,0:06:10.88,Default,,0,0,0,,سأتّصل بالاستوديو وأخبرهم أنّنا سنتأخر
Dialogue: 0,0:06:12.05,0:06:13.89,Default,,0,0,0,,!ها نحن ذا، كوكب الزُهرة الدامي
Dialogue: 0,0:06:17.85,0:06:20.87,Default,,0,0,0,,غنّى كيمورا تاتسويا بشغف
Dialogue: 0,0:06:20.87,0:06:23.30,Default,,0,0,0,,"أغنيته الناجحة "كوكب الزُهرة الدامي
Dialogue: 0,0:06:24.75,0:06:27.08,Default,,0,0,0,,لكن لم يخطر ببال أحد
Dialogue: 0,0:06:27.08,0:06:29.97,Default,,0,0,0,,أنّها آخر مرّة سنسمع غناءه فيها
Dialogue: 0,0:06:32.07,0:06:35.64,Default,,0,0,0,,باستثناء قاتله بالطبع
Dialogue: 0,0:06:40.06,0:06:41.26,Default,,0,0,0,,!مُذهل
Dialogue: 0,0:06:42.60,0:06:44.48,Default,,0,0,0,,كيف كان غنائي؟
Dialogue: 0,0:06:44.48,0:06:45.69,Default,,0,0,0,,!رائعاً
Dialogue: 0,0:06:45.97,0:06:47.01,Default,,0,0,0,,كاتسومي
Dialogue: 0,0:06:48.64,0:06:50.42,Default,,0,0,0,,أعطني من كرات الأرز
Dialogue: 0,0:06:52.63,0:06:53.93,Default,,0,0,0,,هاك
Dialogue: 0,0:06:54.72,0:06:55.80,Default,,0,0,0,,شكراً
Dialogue: 0,0:06:57.47,0:07:00.88,Default,,0,0,0,,المعذرة، هل ستترك ليكس حقاً؟
Dialogue: 0,0:07:01.63,0:07:04.89,Default,,0,0,0,,لا تقلقي، سأبدأ مسيرةً فردية فقط
Dialogue: 0,0:07:04.89,0:07:05.80,Default,,0,0,0,,مسيرة فردية؟
Dialogue: 0,0:07:06.80,0:07:08.51,Default,,0,0,0,,انتهيتُ من أغنيتي الجديدة
Dialogue: 0,0:07:10.05,0:07:11.17,Default,,0,0,0,,...أغنيته الجديدة
Dialogue: 0,0:07:11.17,0:07:12.80,Default,,0,0,0,,انتهت؟
Dialogue: 0,0:07:12.80,0:07:14.22,Default,,0,0,0,,ما اسمها؟
Dialogue: 0,0:07:14.76,0:07:17.18,Default,,0,0,0,,...اسمها؟ إنّه
Dialogue: 0,0:07:21.80,0:07:23.55,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,0:07:22.38,0:07:23.22,Default,,0,0,0,,!تاتسويا
Dialogue: 0,0:07:25.68,0:07:27.07,Default,,0,0,0,,!تاتسويا
Dialogue: 0,0:07:32.43,0:07:35.00,Default,,0,0,0,,!الإسعاف! استدعوا الإسعاف بسرعة
Dialogue: 0,0:07:35.00,0:07:35.80,Default,,0,0,0,,!حسناً
Dialogue: 0,0:07:40.67,0:07:42.25,Default,,0,0,0,,لا جدوى، إنّه ميت
Dialogue: 0,0:07:43.76,0:07:46.05,Default,,0,0,0,,هذه رائحة... سيانيد؟
Dialogue: 0,0:07:47.64,0:07:49.06,Default,,0,0,0,,هذه مكيدة أحدهم
Dialogue: 0,0:07:49.80,0:07:52.18,Default,,0,0,0,,وأمام أنظاري، من يكون؟
Dialogue: 0,0:07:54.97,0:07:59.47,Default,,0,0,0,,المُشتبه به الأوّل كان المدير سومي\Nالذي جلب الطعام
Dialogue: 0,0:07:59.47,0:08:02.43,Default,,0,0,0,,كان زميلاً في نفس الفرقة مع كيمورا تاتسويا في الماضي
Dialogue: 0,0:08:02.88,0:08:06.35,Default,,0,0,0,,لكنّ تاتسويا أصبح وحده محترفاً واكتسب شعبيّة
Dialogue: 0,0:08:07.47,0:08:09.31,Default,,0,0,0,,بدت كجريمة غيرة
Dialogue: 0,0:08:10.21,0:08:14.14,Default,,0,0,0,,لكن تمّت تبرئته عندما عرفنا
Dialogue: 0,0:08:14.14,0:08:15.76,Default,,0,0,0,,أنّ الجميع أكلوا من الطعام
Dialogue: 0,0:08:16.30,0:08:22.30,Default,,0,0,0,,وُجِدت سموم على ثياب الضحيّة\Nومكبّر الصوت بعد التحليلات
Dialogue: 0,0:08:22.30,0:08:25.22,Default,,0,0,0,,لذا فقد انتقل له السمّ قبل أكل كرة الأرز
Dialogue: 0,0:08:26.80,0:08:30.34,Default,,0,0,0,,ما يعني أنّ القاتل وضع السمّ على مكبّر الصوت
Dialogue: 0,0:08:30.34,0:08:35.22,Default,,0,0,0,,فانتقل ليد الضحيّة عندما أمسك به
Dialogue: 0,0:08:36.18,0:08:40.13,Default,,0,0,0,,من كان يمكنه فعل ذلك\Nهو الشخص الذي غنّى قبله
Dialogue: 0,0:08:40.13,0:08:42.59,Default,,0,0,0,,أي أنت يا شيبازاكي مييكو-سان
Dialogue: 0,0:08:43.34,0:08:48.31,Default,,0,0,0,,سمعتُ أنّك غنيتِ أغنية وداع بينما تبكين
Dialogue: 0,0:08:49.10,0:08:53.97,Default,,0,0,0,,هل جرى أمرٌ ما بينكما؟
Dialogue: 0,0:08:53.97,0:08:58.97,Default,,0,0,0,,!لـ-لم يهجرني تاتسويا! بل رفضني فحسب
Dialogue: 0,0:08:59.84,0:09:00.92,Default,,0,0,0,,...مييكو
Dialogue: 0,0:09:00.92,0:09:03.47,Default,,0,0,0,,...عندما بحتُ له بمشاعري
Dialogue: 0,0:09:03.88,0:09:07.47,Default,,0,0,0,,آسف يا مييكو، لديّ فتاة مُعجب بها سلفاً
Dialogue: 0,0:09:09.00,0:09:10.95,Default,,0,0,0,,ذهبت لمكان ما حالياً
Dialogue: 0,0:09:10.95,0:09:13.86,Default,,0,0,0,,لكنّي أنتظر عودتها
Dialogue: 0,0:09:14.34,0:09:17.45,Default,,0,0,0,,وسأبقى أنتظر... أنتظر
Dialogue: 0,0:09:18.53,0:09:23.31,Default,,0,0,0,,!فقال أنّه لا يستطيع مواعدتي
Dialogue: 0,0:09:23.31,0:09:25.45,Default,,0,0,0,,...لذا انتقاماً لمشاعرك قمتِ بـ
Dialogue: 0,0:09:25.45,0:09:28.56,Default,,0,0,0,,!كلا! لم أقتله
Dialogue: 0,0:09:28.60,0:09:29.84,Default,,0,0,0,,فتاة مُعجب بها؟
Dialogue: 0,0:09:29.84,0:09:34.64,Default,,0,0,0,,حضرة المفتّش، كان تاتسويا من طلب\Nالأغنية التي غنّتها مييكو
Dialogue: 0,0:09:34.64,0:09:38.18,Default,,0,0,0,,لم تكن تعلم أنّها ستغنّي، أو أنّ تاتسويا سيتبعها
Dialogue: 0,0:09:38.81,0:09:43.01,Default,,0,0,0,,يستحيل أنّها من سمّمت مكبّر الصوت
Dialogue: 0,0:09:43.01,0:09:44.14,Default,,0,0,0,,...بالفعل
Dialogue: 0,0:09:44.72,0:09:49.63,Default,,0,0,0,,"أخبروني، من طلب أغنية "كوكب الزُهرة الدامي\Nالتي غنّاها تاتسويا-سان؟
Dialogue: 0,0:09:57.14,0:10:01.17,Default,,0,0,0,,أكان يخلع سترته قبل الغناء دوماً؟
Dialogue: 0,0:10:01.59,0:10:04.01,Default,,0,0,0,,فقط عند بداية كوكب الزُهرة الدامي
Dialogue: 0,0:10:04.84,0:10:06.47,Default,,0,0,0,,...أيمكن
Dialogue: 0,0:10:06.94,0:10:12.09,Default,,0,0,0,,حضرة المفتّش، أين كان السيانيد\Nعلى ثياب تاتسويا-سان بالضبط؟
Dialogue: 0,0:10:12.09,0:10:15.34,Default,,0,0,0,,...كوعه الأيسر وفقما أظن
Dialogue: 0,0:10:15.72,0:10:17.68,Default,,0,0,0,,ماذا عن سترة الفرقة؟
Dialogue: 0,0:10:17.68,0:10:21.29,Default,,0,0,0,,كلا، لم يكن هناك شيء عليها
Dialogue: 0,0:10:21.29,0:10:22.59,Default,,0,0,0,,!فهمت
Dialogue: 0,0:10:23.29,0:10:24.74,Default,,0,0,0,,!عرفت الآن
Dialogue: 0,0:10:25.26,0:10:29.08,Default,,0,0,0,,!كيف أوصل القاتل السمّ لكيمورا تاتسويا
Dialogue: 0,0:10:29.08,0:10:32.12,Default,,0,0,0,,والقاتل الذي كان بإمكانه تنفيذ تلك الحيلة
Dialogue: 0,0:10:32.12,0:10:35.92,Default,,0,0,0,,!هو أحد الثلاثة الذين يرتدون نفس سترته
Dialogue: 0,0:10:40.36,0:10:42.57,Default,,0,0,0,,أخبريني يا عازفة الغيتار
Dialogue: 0,0:10:43.43,0:10:46.89,Default,,0,0,0,,كانت المديرة وتاتسويا-سان يتجادلان قبلاً
Dialogue: 0,0:10:46.89,0:10:48.35,Default,,0,0,0,,أكانا هكذا دوماً؟
Dialogue: 0,0:10:50.05,0:10:53.55,Default,,0,0,0,,أجل، صحيح. تجادلا في مختلف الأمور
Dialogue: 0,0:10:53.55,0:10:57.14,Default,,0,0,0,,لكنّ تاتسويا كان البادئ دائماً
Dialogue: 0,0:10:57.14,0:11:00.21,Default,,0,0,0,,ليست فتاةً سيّئة كما يدّعي تاتسويا
Dialogue: 0,0:11:00.21,0:11:03.55,Default,,0,0,0,,إنّها ذكيّة ومجتهدة وحسناء
Dialogue: 0,0:11:03.55,0:11:05.55,Default,,0,0,0,,ولم يشتك أحد منها قطّ
Dialogue: 0,0:11:06.89,0:11:07.72,Default,,0,0,0,,مفتّش ميغوري
Dialogue: 0,0:11:07.72,0:11:08.93,Default,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:11:08.93,0:11:11.97,Default,,0,0,0,,وجدنا هذه في خزانة مكتب كيمورا تاتسويا
Dialogue: 0,0:11:12.34,0:11:15.64,Default,,0,0,0,,لا أرى أيّ خيط قد يفيدنا
Dialogue: 0,0:11:18.60,0:11:21.26,Default,,0,0,0,,صورة... صورة للفرقة؟
Dialogue: 0,0:11:21.26,0:11:23.30,Default,,0,0,0,,هذا يُشعرني بالحنين
Dialogue: 0,0:11:23.68,0:11:26.97,Default,,0,0,0,,هذه من أيام عزفنا معاً في الفرقة
Dialogue: 0,0:11:26.97,0:11:29.34,Default,,0,0,0,,قبل أن يُصبح محترفاً
Dialogue: 0,0:11:29.34,0:11:32.97,Default,,0,0,0,,الوحيدان المتبقيان في عالم الموسيقى الآن
Dialogue: 0,0:11:32.97,0:11:35.22,Default,,0,0,0,,هما تاتسويا وهذا الشخص فحسب
Dialogue: 0,0:11:35.97,0:11:39.30,Default,,0,0,0,,لم يكن تاتسويا-سان الوحيد الذي ترك فرقتكم؟
Dialogue: 0,0:11:39.63,0:11:42.30,Default,,0,0,0,,إنّها تلك المرأة هناك
Dialogue: 0,0:11:42.84,0:11:47.26,Default,,0,0,0,,أبغضها تاتسويا، قال أنّه لم يكن\Nليترك الفرقة دونها
Dialogue: 0,0:11:47.60,0:11:50.67,Default,,0,0,0,,لكنّها ليست في الصورة
Dialogue: 0,0:11:50.67,0:11:52.59,Default,,0,0,0,,انظر، ها هي
Dialogue: 0,0:11:53.01,0:11:55.05,Default,,0,0,0,,مع أنّها تغيّرت كثيراً
Dialogue: 0,0:11:55.89,0:11:57.01,Default,,0,0,0,,...أيمكن
Dialogue: 0,0:11:57.33,0:11:59.75,Default,,0,0,0,,كثيراً جدّاً في الواقع
Dialogue: 0,0:12:00.78,0:12:02.78,Default,,0,0,0,,كتابة خلف الصورة؟
Dialogue: 0,0:12:02.78,0:12:03.75,Default,,0,0,0,,!دعني أراها ثانيةً
Dialogue: 0,0:12:05.90,0:12:07.69,Default,,0,0,0,,فهمت
Dialogue: 0,0:12:08.78,0:12:11.23,Default,,0,0,0,,...لكن إن كان هذا صحيحاً
Dialogue: 0,0:12:11.23,0:12:14.83,Default,,0,0,0,,فيا لها... يا لها من حادثة حزينة
Dialogue: 0,0:12:20.46,0:12:21.71,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:12:21.71,0:12:24.72,Default,,0,0,0,,!عرفت هويّة الفاعل؟! كيف؟
Dialogue: 0,0:12:25.13,0:12:27.65,Default,,0,0,0,,!حسناً، حسناً. فهمت
Dialogue: 0,0:12:29.09,0:12:33.05,Default,,0,0,0,,أوقفوا التحقيق! استدعوا كافة \N!ذوي العلاقة ولنذهب لساحة الجريمة
Dialogue: 0,0:12:33.05,0:12:33.52,Default,,0,0,0,,!حاضر
Dialogue: 0,0:12:35.45,0:12:37.25,Default,,0,0,0,,أحصل أمرٌ ما؟
Dialogue: 0,0:12:37.25,0:12:39.34,Default,,0,0,0,,لقد رجع
Dialogue: 0,0:12:39.34,0:12:40.04,Default,,0,0,0,,رجع؟
Dialogue: 0,0:12:40.28,0:12:42.75,Default,,0,0,0,,مُتحرٍّ عظيم تعرفينه جيّداً
Dialogue: 0,0:12:44.10,0:12:45.64,Default,,0,0,0,,كودو شينتشي
Dialogue: 0,0:12:50.23,0:12:52.39,Default,,0,0,0,,...رجع شينتشي
Dialogue: 0,0:12:52.39,0:12:54.42,Default,,0,0,0,,!الغائب لوقتٍ طويل
Dialogue: 0,0:12:54.89,0:12:55.96,Default,,0,0,0,,!شينتشي
Dialogue: 0,0:13:00.76,0:13:04.35,Default,,0,0,0,,مرحباً يا سادة، شكراً على قدومكم
Dialogue: 0,0:13:04.51,0:13:05.85,Default,,0,0,0,,شينتشي؟
Dialogue: 0,0:13:06.89,0:13:10.34,Default,,0,0,0,,لا بدّ أنّه يشاهد من هذه الكاميرا
Dialogue: 0,0:13:10.84,0:13:12.22,Default,,0,0,0,,تحرّكي قليلاً يا سونوكو
Dialogue: 0,0:13:12.22,0:13:14.31,Default,,0,0,0,,!أين أنت يا شينتشي؟
Dialogue: 0,0:13:14.72,0:13:18.31,Default,,0,0,0,,لنبدأ بفكّ لثام ألغاز هذه القضيّة
Dialogue: 0,0:13:18.31,0:13:19.34,Default,,0,0,0,,!شينتشي
Dialogue: 0,0:13:19.34,0:13:22.14,Default,,0,0,0,,ما خطب هذه الأغنية التي نسمعها لفترة؟
Dialogue: 0,0:13:23.01,0:13:25.77,Default,,0,0,0,,إنّها "الرنّة أحمر الأنف" يا مفتّش ميغوري
Dialogue: 0,0:13:25.77,0:13:28.06,Default,,0,0,0,,أغنية خاصة بالكريسماس تُعزف في أرجاء المدينة مع قدومه
Dialogue: 0,0:13:28.73,0:13:34.01,Default,,0,0,0,,كما تؤجج كراهية القاتل لتاتسويا-سان أيضاً
Dialogue: 0,0:13:34.01,0:13:36.93,Default,,0,0,0,,أي أنّ القاتل هو من طلب تاتسويا-سان
Dialogue: 0,0:13:36.93,0:13:38.48,Default,,0,0,0,,هذه الأغنية له
Dialogue: 0,0:13:38.89,0:13:41.64,Default,,0,0,0,,...أجل، قاتل تاتسويا-سان
Dialogue: 0,0:13:41.64,0:13:44.56,Default,,0,0,0,,!هو المديرة تيراهارا ماري-سان! أنت
Dialogue: 0,0:13:46.85,0:13:48.27,Default,,0,0,0,,المديرة قتلته؟
Dialogue: 0,0:13:48.27,0:13:49.59,Default,,0,0,0,,...مستحيل
Dialogue: 0,0:13:52.18,0:13:53.85,Default,,0,0,0,,!توقّف عن المزاح
Dialogue: 0,0:13:53.85,0:13:57.89,Default,,0,0,0,,كنتُ خارج الغرفة على الهاتف عندما انهار تاتسويا
Dialogue: 0,0:13:58.27,0:14:02.51,Default,,0,0,0,,،كان بمقدورك تسميمه حتّى مع ابتعادك
Dialogue: 0,0:14:02.51,0:14:05.22,Default,,0,0,0,,بجعله يغنّي هذه الأغنية فحسب
Dialogue: 0,0:14:06.85,0:14:10.39,Default,,0,0,0,,!هذه أغنيته الناجحة، كوكب الزُهرة الدامي
Dialogue: 0,0:14:13.26,0:14:17.06,Default,,0,0,0,,هلّا غنيتِ لنا باستعمال مكبّر الصوت الذي حضّرتُه؟
Dialogue: 0,0:14:18.10,0:14:20.55,Default,,0,0,0,,لا سمّ عليه بالطبع
Dialogue: 0,0:14:22.85,0:14:27.02,Default,,0,0,0,,لا بأس، طالما سيرضيك هذا
Dialogue: 0,0:14:29.28,0:14:30.22,Default,,0,0,0,,!انتظري رجاءً
Dialogue: 0,0:14:31.01,0:14:33.06,Default,,0,0,0,,لمَ لم تخلعي سترتك؟
Dialogue: 0,0:14:33.93,0:14:39.18,Default,,0,0,0,,كان تاتسويا-سان يخلع سترته دوماً\Nعند غنائه هذه الأغنية
Dialogue: 0,0:14:39.18,0:14:40.51,Default,,0,0,0,,أليس صحيحاً يا سادة؟
Dialogue: 0,0:14:40.51,0:14:41.64,Default,,0,0,0,,بـ-بلى
Dialogue: 0,0:14:42.05,0:14:43.72,Default,,0,0,0,,...إذاً، لنعد الكرّة
Dialogue: 0,0:14:48.23,0:14:49.64,Default,,0,0,0,,أجل، لا أنسى
Dialogue: 0,0:14:50.05,0:14:51.22,Default,,0,0,0,,تذكّري حركات الرقص
Dialogue: 0,0:15:04.18,0:15:05.68,Default,,0,0,0,,!إنّها بارعة
Dialogue: 0,0:15:05.68,0:15:06.81,Default,,0,0,0,,بالطبع
Dialogue: 0,0:15:08.23,0:15:13.06,Default,,0,0,0,,فقد كانت تغنّي رفقة تاتسويا في فرقتي
Dialogue: 0,0:15:18.60,0:15:19.97,Default,,0,0,0,,المديرة؟
Dialogue: 0,0:15:27.43,0:15:29.43,Default,,0,0,0,,أرضيت إذاً؟
Dialogue: 0,0:15:29.43,0:15:30.09,Default,,0,0,0,,أجل
Dialogue: 0,0:15:31.22,0:15:35.18,Default,,0,0,0,,لتأكلي الطعام الذي حضّرتُه إذاً
Dialogue: 0,0:15:35.18,0:15:36.02,Default,,0,0,0,,هذا؟
Dialogue: 0,0:15:36.02,0:15:39.55,Default,,0,0,0,,كما فعل تاتسويا-سان
Dialogue: 0,0:15:39.55,0:15:40.97,Default,,0,0,0,,اختاري أيّ ما يحلو لك
Dialogue: 0,0:15:41.43,0:15:43.64,Default,,0,0,0,,هذا إذا افترضنا أنه يمكنك ذلك
Dialogue: 0,0:15:45.26,0:15:46.61,Default,,0,0,0,,سأمتنع
Dialogue: 0,0:15:47.35,0:15:51.92,Default,,0,0,0,,!ألا تذكرون؟ لقد لمستُه بعدما سقط
Dialogue: 0,0:15:52.54,0:15:55.38,Default,,0,0,0,,كان هناك سمٌّ على يديه وثيابه
Dialogue: 0,0:15:55.38,0:15:58.88,Default,,0,0,0,,!يمكن أنّه انتقل ليديّ
Dialogue: 0,0:15:58.88,0:16:03.40,Default,,0,0,0,,إذاً حضرة المفتّش، تفقّد سترتها التي خلعتها رجاءً
Dialogue: 0,0:16:04.12,0:16:05.46,Default,,0,0,0,,سترتها؟
Dialogue: 0,0:16:07.27,0:16:11.39,Default,,0,0,0,,!ينطبق الأمر على سترتي! ارتديتُها بعد لمسي تاتسويا
Dialogue: 0,0:16:11.72,0:16:14.93,Default,,0,0,0,,...إن كان هناك سمٌّ عليها فلا يعني ذلك
Dialogue: 0,0:16:14.93,0:16:19.18,Default,,0,0,0,,كلا، لا أبحث عن سمّ
Dialogue: 0,0:16:22.97,0:16:23.64,Default,,0,0,0,,قدّاحة؟
Dialogue: 0,0:16:24.22,0:16:24.93,Default,,0,0,0,,أجل
Dialogue: 0,0:16:27.56,0:16:30.84,Default,,0,0,0,,إنّها قدّاحة تاتسويا المفقودة من مسرح الجريمة
Dialogue: 0,0:16:30.84,0:16:33.72,Default,,0,0,0,,أي أنّ هذه ليست سترتها
Dialogue: 0,0:16:33.72,0:16:37.85,Default,,0,0,0,,!بدّلت خاصتها بسترة تاتسويا-سان للتخلّص من الدليل
Dialogue: 0,0:16:40.05,0:16:43.64,Default,,0,0,0,,مسحت السمّ بجانب الكوع الأيسر الداخلي \Nلسترة تاتسويا-سان سلفاً
Dialogue: 0,0:16:43.64,0:16:49.93,Default,,0,0,0,,فعلت ذلك كي ينتقل
Dialogue: 0,0:16:49.93,0:16:52.68,Default,,0,0,0,,إلى قميصه الداخلي عندما يرتديه
Dialogue: 0,0:16:53.18,0:16:57.39,Default,,0,0,0,,"كلّ ما تبقّى هو جعله يغنّي "كوكب الزُهرة الدامي
Dialogue: 0,0:16:57.39,0:17:01.43,Default,,0,0,0,,كعادته أثناء الرقص، خلع سترته
Dialogue: 0,0:17:01.97,0:17:05.39,Default,,0,0,0,,ولمس بيده كوعه الأيسر في الغناء فانتقل السمّ
Dialogue: 0,0:17:05.72,0:17:11.30,Default,,0,0,0,,بعدها سيتسمّم بأكله أيّ طعام بيده تلك
Dialogue: 0,0:17:11.72,0:17:14.18,Default,,0,0,0,,لكن لمَ قد تفعل ذلك؟
Dialogue: 0,0:17:14.18,0:17:17.14,Default,,0,0,0,,دافعها موجود في الصورة على الطاولة
Dialogue: 0,0:17:18.23,0:17:22.10,Default,,0,0,0,,إنّها من عزفه في فرقة مدير المحلّ في الماضي
Dialogue: 0,0:17:24.31,0:17:26.06,Default,,0,0,0,,ما المميّز بها؟
Dialogue: 0,0:17:26.64,0:17:29.09,Default,,0,0,0,,لا يوجد غيرهما في الصورة
Dialogue: 0,0:17:29.09,0:17:32.97,Default,,0,0,0,,إنّها موجودة حضرة المفتّش، هي أيضاً
Dialogue: 0,0:17:32.97,0:17:36.48,Default,,0,0,0,,في منتصف الصورة مع تاتسويا-سان
Dialogue: 0,0:17:36.93,0:17:38.44,Default,,0,0,0,,...هـ-هذه
Dialogue: 0,0:17:38.44,0:17:41.18,Default,,0,0,0,,صحيح، هذه الصورة هي دافعها
Dialogue: 0,0:17:41.18,0:17:42.89,Default,,0,0,0,,!لارتكاب هذه الجريمة
Dialogue: 0,0:17:43.51,0:17:44.85,Default,,0,0,0,,...أيمكن أنّك
Dialogue: 0,0:17:45.72,0:17:47.60,Default,,0,0,0,,!صحيح، أجريتُ عملية تجميلية
Dialogue: 0,0:17:47.60,0:17:48.81,Default,,0,0,0,,!لأجل تاتسويا
Dialogue: 0,0:17:51.72,0:17:55.14,Default,,0,0,0,,...كنتُ مغرمةً به عندما كنّا في الفرقة
Dialogue: 0,0:17:56.39,0:17:59.26,Default,,0,0,0,,...لذا عندما تركها ليصبح محترفاً
Dialogue: 0,0:17:59.26,0:18:03.26,Default,,0,0,0,,!تعالي معي يا ماري، يمكنك أن تكوني المديرة
Dialogue: 0,0:18:03.26,0:18:07.02,Default,,0,0,0,,كنتُ بغاية السعادة عندما قال ذلك
Dialogue: 0,0:18:07.02,0:18:09.13,Default,,0,0,0,,...ظننتُ أنّه شاركني مشاعري
Dialogue: 0,0:18:09.13,0:18:14.22,Default,,0,0,0,,لذا أجريتُ العملية كي أكون امرأةً لائقة به
Dialogue: 0,0:18:14.22,0:18:17.94,Default,,0,0,0,,تغيّر سلوكه فجأةً بعدها
Dialogue: 0,0:18:17.94,0:18:20.84,Default,,0,0,0,,استمرّ بنعتي بالقبيحة
Dialogue: 0,0:18:20.84,0:18:23.68,Default,,0,0,0,,!جعلني أغنّي الرنّة أحمر الأنف حتّى
Dialogue: 0,0:18:24.10,0:18:27.64,Default,,0,0,0,,أكان ذلك المعنى وراء طلبه الأغنية لك؟
Dialogue: 0,0:18:28.02,0:18:32.05,Default,,0,0,0,,جعلني مديرةً منذ البداية للسخرية منّي
Dialogue: 0,0:18:32.05,0:18:34.22,Default,,0,0,0,,...لذا لم أستطع مسامحته
Dialogue: 0,0:18:34.22,0:18:35.60,Default,,0,0,0,,!كنتُ أحبّه
Dialogue: 0,0:18:36.73,0:18:39.30,Default,,0,0,0,,!فلم أستطع مسامحته
Dialogue: 0,0:18:39.30,0:18:40.43,Default,,0,0,0,,أخطأتِ يا ماري-سان
Dialogue: 0,0:18:41.55,0:18:45.85,Default,,0,0,0,,لطالما كان تاتسويا-سان يحبّك
Dialogue: 0,0:18:45.85,0:18:48.39,Default,,0,0,0,,!لا تسخر منّي! ما الذي تعرفه؟
Dialogue: 0,0:18:48.39,0:18:51.76,Default,,0,0,0,,ماري! إنّه يقول الحقيقة
Dialogue: 0,0:18:51.76,0:18:53.51,Default,,0,0,0,,حضرة المفتّش، هلّا أعطيتني الصورة؟
Dialogue: 0,0:18:55.60,0:18:59.22,Default,,0,0,0,,هذه أغنية حبٍّ كتبها عن مشاعره الدائمة لك
Dialogue: 0,0:18:59.22,0:19:03.18,On Top,,0,0,0,,أريد أن أخبر ذاتك الحقيقيّة
Dialogue: 0,0:19:04.14,0:19:05.35,Default,,0,0,0,,!هذه مزيّفة
Dialogue: 0,0:19:05.35,0:19:06.89,Default,,0,0,0,,ليست كذلك
Dialogue: 0,0:19:06.89,0:19:10.51,Default,,0,0,0,,إنّها كلمات أغنيته الجديدة التي \Nكان سيصدرها
Dialogue: 0,0:19:10.51,0:19:13.14,Default,,0,0,0,,لطالما كان يتكلّم عنك
Dialogue: 0,0:19:13.60,0:19:15.89,Default,,0,0,0,,لمَ تهتمّ ماري بالمظاهر؟
Dialogue: 0,0:19:15.89,0:19:19.09,Default,,0,0,0,,!لمَ غيّرت وجهها لي؟
Dialogue: 0,0:19:19.30,0:19:22.55,Default,,0,0,0,,...لكنّه كان يعاملني بازدراء دوماً
Dialogue: 0,0:19:23.26,0:19:26.43,Default,,0,0,0,,لم يكن صريحاً بطبعه
Dialogue: 0,0:19:26.43,0:19:29.55,Default,,0,0,0,,أنا متأكّد أنّه أراد أن تعودي لذاتك السابقة سريعاً
Dialogue: 0,0:19:31.30,0:19:33.47,Default,,0,0,0,,...ذ-ذلك
Dialogue: 0,0:19:38.56,0:19:39.76,Default,,0,0,0,,فهمت الآن
Dialogue: 0,0:19:40.59,0:19:44.72,Default,,0,0,0,,لكنّي أنتظر عودتها
Dialogue: 0,0:19:45.27,0:19:49.59,Default,,0,0,0,,لذا آسف يا مييكو، لديّ فتاة مُعجب بها
Dialogue: 0,0:19:51.10,0:19:55.68,Default,,0,0,0,,كانت المديرة هي من قصدها إذاً
Dialogue: 0,0:19:55.68,0:19:59.18,Default,,0,0,0,,!تاتسويا! تاتسويا
Dialogue: 0,0:19:59.18,0:20:02.14,Default,,0,0,0,,!تاتسويا
Dialogue: 0,0:20:09.43,0:20:12.39,Default,,0,0,0,,عجز شاب عن المصارحة بمشاعره
Dialogue: 0,0:20:12.39,0:20:18.31,Default,,0,0,0,,قابله فتاة أخفت مشاعرها، فأولدا نهاية حزينة
Dialogue: 0,0:20:19.30,0:20:22.43,Default,,0,0,0,,...في دموعها المتساقطة
Dialogue: 0,0:20:22.43,0:20:25.89,Default,,0,0,0,,كانت الصورة وحدها مبتسمة بحزن
Dialogue: 0,0:22:03.64,0:22:07.89,Default,,0,0,0,,يا إلهي، هذا ما تجنيه لاستعمالك اسم كودو شينتشي
Dialogue: 0,0:22:07.89,0:22:09.80,Default,,0,0,0,,كانت تنتظر لثلاث ساعات بهذا الشكل
Dialogue: 0,0:22:09.80,0:22:11.84,Default,,0,0,0,,أمام منزلك مترقبةًّ عودتك
Dialogue: 0,0:22:11.84,0:22:17.47,Default,,0,0,0,,أتمنّى لو يمكنني المساعدة، لكن لا حيلة بيدي
Dialogue: 0,0:22:21.38,0:22:22.09,Default,,0,0,0,,...ران
Dialogue: 0,0:22:29.34,0:22:31.59,Default,,0,0,0,,شينتشي؟ أأنت بالداخل؟
Dialogue: 0,0:22:31.97,0:22:33.93,Default,,0,0,0,,!شينتشي؟ شينتشي
Dialogue: 0,0:22:35.14,0:22:37.89,Default,,0,0,0,,!أين أنت؟ أجب إن كنت موجوداً
Dialogue: 0,0:22:40.26,0:22:41.80,Default,,0,0,0,,...الأضواء
Dialogue: 0,0:22:41.80,0:22:43.93,Default,,0,0,0,,!شينتشي
Dialogue: 0,0:22:43.93,0:22:45.47,Default,,0,0,0,,شينتشي؟
Dialogue: 0,0:22:49.97,0:22:51.93,Default,,0,0,0,,شينتشي؟
Dialogue: 0,0:22:51.93,0:22:54.76,Default,,0,0,0,,أجل، إنّه أنا
Dialogue: 0,0:22:54.76,0:22:56.43,Default,,0,0,0,,رجعت أخيراً
Dialogue: 0,0:22:57.06,0:22:58.43,Default,,0,0,0,,...شينتشي
Dialogue: 0,0:22:58.43,0:23:00.47,Default,,0,0,0,,لا تبكي يا حمقاء
Dialogue: 0,0:23:01.84,0:23:04.34,Default,,0,0,0,,أأردتِ رؤيتي لهذا الحدّ؟
Dialogue: 0,0:23:04.34,0:23:06.10,Default,,0,0,0,,!من قد يريد؟
Dialogue: 0,0:23:06.10,0:23:09.13,Default,,0,0,0,,أنا سعيدٌ برؤيتك
Dialogue: 0,0:23:11.63,0:23:12.97,Default,,0,0,0,,...شينتشي
Dialogue: 0,0:23:12.97,0:23:15.05,Default,,0,0,0,,أرى ملامحك الغبيّة
Dialogue: 0,0:23:15.05,0:23:16.64,Default,,0,0,0,,!ما قصدك؟
Dialogue: 0,0:23:18.43,0:23:20.46,Default,,0,0,0,,حسناً، عليّ المغادرة
Dialogue: 0,0:23:21.55,0:23:24.85,Default,,0,0,0,,!فلم أنته من القضيّة التي أعمل عليها، إلى اللقاء يا ران
Dialogue: 0,0:23:25.47,0:23:27.97,Default,,0,0,0,,...ا-انتظر، شينتشي
Dialogue: 0,0:23:28.35,0:23:29.46,Default,,0,0,0,,!شينتشي
Dialogue: 0,0:23:33.51,0:23:37.31,On Top,,0,0,0,,{\fad(300,0)}.هدية الكريسماس لك، اقبليها بامتنان\Nشينتشي -
Dialogue: 0,0:23:42.22,0:23:46.61,Default,,0,0,0,,كفّي عن القلق بلا داعٍ عليّ الآن يا ران
Dialogue: 0,0:24:00.77,0:24:02.68,On Top,,0,0,0,,!لقد أتت يا كونان-كن
Dialogue: 0,0:24:03.05,0:24:04.81,On Top,,0,0,0,,!أمّك...
Dialogue: 0,0:24:05.40,0:24:06.61,On Top,,0,0,0,,!كلا
Dialogue: 0,0:24:06.97,0:24:09.55,On Top,,0,0,0,,!يستحيل أن يملك إيدوغاوا كونان أُمّاً
Dialogue: 0,0:24:09.92,0:24:11.55,Default,,0,0,0,,...بروفسور
Dialogue: 0,0:24:15.34,0:24:17.34,Default,,0,0,0,,
Dialogue: 0,0:24:18.52,0:24:20.90,On Top,,0,0,0,,!من هذا الرجل المقنّع؟
Dialogue: 0,0:24:21.97,0:24:23.15,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:24:24.55,0:24:26.10,Default,,0,0,0,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.10,0:24:28.92,Default,,0,0,0,,قضيّة اختطاف إيدوغاوا كونان
Dialogue: 0,0:24:45.35,0:24:47.58,Default,,0,0,0,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.58,0:24:49.16,Default,,0,0,0,,بارون الليل

