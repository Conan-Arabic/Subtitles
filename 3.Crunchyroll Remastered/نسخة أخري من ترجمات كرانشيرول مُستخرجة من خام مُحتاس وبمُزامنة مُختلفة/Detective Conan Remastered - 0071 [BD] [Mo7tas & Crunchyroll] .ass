Dialogue: 0,0:00:00.97,0:00:02.89,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:02.89,0:00:06.01,Default,,0000,0000,0000,,تُعالج استنتاجات كونان القلوب\Nالمُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:06.80,0:00:09.96,Default,,0000,0000,0000,,!قضيّة اليوم عن مُلاحِق! لنفكّر بما يضايق الآخرين
Dialogue: 0,0:00:09.96,0:00:12.04,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.04,0:00:13.62,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.62,0:00:15.99,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.15,0:01:57.15,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل المُلاحِق
Dialogue: 0,0:01:52.57,0:01:55.26,Default,,0000,0000,0000,,جريمة قتل المُلاحِق
Dialogue: 0,0:02:04.36,0:02:07.09,Default,,0000,0000,0000,,!الهواء منعش
Dialogue: 0,0:02:07.09,0:02:09.81,Default,,0000,0000,0000,,!الصباح الباكر جميلٌ حقّاً
Dialogue: 0,0:02:09.81,0:02:14.24,Default,,0000,0000,0000,,.أجل، الطقس لطيفٌ اليوم أيضاً\Nفهو مناسب للتنزه
Dialogue: 0,0:02:14.24,0:02:19.08,Default,,0000,0000,0000,,!أيقظتماني قبل أن يطلع الصباح حتّى، لم أنم كفايتي
Dialogue: 0,0:02:26.41,0:02:27.55,Default,,0000,0000,0000,,!غاتس مان
Dialogue: 0,0:02:27.55,0:02:28.95,Default,,0000,0000,0000,,تمهّلا
Dialogue: 0,0:02:28.95,0:02:30.23,Default,,0000,0000,0000,,ستشرب شيئاً؟
Dialogue: 0,0:02:30.74,0:02:33.07,Default,,0000,0000,0000,,...لا أستطيع الاستمرار مع النعاس
Dialogue: 0,0:02:41.81,0:02:45.74,Default,,0000,0000,0000,,!خرجت اثنتان! يا لحظّي
Dialogue: 0,0:02:46.15,0:02:50.39,Default,,0000,0000,0000,,أأنت متأكد أنّه لم تكن\Nهناك واحدة سلفاً؟
Dialogue: 0,0:02:50.39,0:02:52.15,Default,,0000,0000,0000,,أنصحك بألّا تشرب منها
Dialogue: 0,0:02:57.79,0:03:01.04,Default,,0000,0000,0000,,لكن لا علامات على فتح الغطاء
Dialogue: 0,0:03:01.04,0:03:03.08,Default,,0000,0000,0000,,ولا شيء يبدو خارج المألوف
Dialogue: 0,0:03:04.83,0:03:06.95,Default,,0000,0000,0000,,لا رائحة غريبة أيضاً
Dialogue: 0,0:03:06.95,0:03:10.95,Default,,0000,0000,0000,,ربما نسيها شخص بعدما اشترى عدّة قنّينات
Dialogue: 0,0:03:17.06,0:03:18.06,Default,,0000,0000,0000,,!هناك
Dialogue: 0,0:03:32.93,0:03:34.68,Default,,0000,0000,0000,,!ران! اطلبي الإسعاف
Dialogue: 0,0:03:34.68,0:03:35.38,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:03:35.64,0:03:37.15,Default,,0000,0000,0000,,!ما الخطب؟! تماسك
Dialogue: 0,0:03:42.25,0:03:43.21,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:03:44.46,0:03:45.17,Default,,0000,0000,0000,,!غاتس مان
Dialogue: 0,0:03:45.17,0:03:47.23,Default,,0000,0000,0000,,!هل شربت منها؟
Dialogue: 0,0:03:53.58,0:03:55.65,Default,,0000,0000,0000,,أيمكن أنّها احتوت سمّاً؟
Dialogue: 0,0:04:01.86,0:04:06.11,Default,,0000,0000,0000,,المُتوفى هو ناغاي تاتسويا-سان، 26 عاماً
Dialogue: 0,0:04:06.11,0:04:09.10,Default,,0000,0000,0000,,كان يعيش على الشارع الثالث في ميدوري داي
Dialogue: 0,0:04:09.10,0:04:11.36,Default,,0000,0000,0000,,على بعد محطّتي قطار من هنا
Dialogue: 0,0:04:15.18,0:04:16.56,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:04:17.25,0:04:21.94,Default,,0000,0000,0000,,...أشعر أنّي رأيته في مكان ما قبلاً
Dialogue: 0,0:04:23.84,0:04:25.92,Default,,0000,0000,0000,,...طلاء على كتفه
Dialogue: 0,0:04:26.87,0:04:28.08,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:04:28.08,0:04:33.82,Default,,0000,0000,0000,,السمّ في غاتس مان التي شربها الضحيّة\Nقد يكون مركّب فوسفات عضوي
Dialogue: 0,0:04:33.82,0:04:36.03,Default,,0000,0000,0000,,فوسفات عضوي؟
Dialogue: 0,0:04:36.36,0:04:40.73,Default,,0000,0000,0000,,أجل، الكميّات الصغيرة منه تسبّب\Nالغثيان أو سيلان اللعاب
Dialogue: 0,0:04:40.98,0:04:45.15,Default,,0000,0000,0000,,لكنّ الكميات الكبيرة تسبب فشلاً \Nفي الجهاز التنفسي
Dialogue: 0,0:04:45.98,0:04:51.06,Default,,0000,0000,0000,,سيّدي المفتش، قد تكون هذه\Nجريمة عشوائية بلا هدف
Dialogue: 0,0:04:51.06,0:04:52.06,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:04:52.06,0:04:54.24,Default,,0000,0000,0000,,اتبعني
Dialogue: 0,0:04:55.78,0:04:57.73,Default,,0000,0000,0000,,أين تذهب يا موري-كن؟
Dialogue: 0,0:05:00.59,0:05:01.92,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:01.92,0:05:08.94,Default,,0000,0000,0000,,وضع المجرم قنّينة غاتس مان المسمومة\Nفي الركن هكذا سلفاً
Dialogue: 0,0:05:10.15,0:05:13.69,Default,,0000,0000,0000,,ثمّ مرّ ناغاي-سان واشترى غاتس مان
Dialogue: 0,0:05:17.35,0:05:25.53,Default,,0000,0000,0000,,لكنّه أخذ القنّينة المسمومة\Nوليس التي اشتراها
Dialogue: 0,0:05:26.23,0:05:31.15,Default,,0000,0000,0000,,بعدها، انتشر مفعول السمّ بينما يشرب في مشيه وسقط
Dialogue: 0,0:05:35.10,0:05:40.65,Default,,0000,0000,0000,,لكن أهناك دليل على وضع القاتل\Nلقنّينة غاتس مان المسمومة هنا؟
Dialogue: 0,0:05:40.88,0:05:42.17,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:05:43.17,0:05:44.63,Default,,0000,0000,0000,,هذه
Dialogue: 0,0:05:44.63,0:05:48.04,Default,,0000,0000,0000,,اشتريتُ غاتس مان من هنا بدوري
Dialogue: 0,0:05:48.04,0:05:52.61,Default,,0000,0000,0000,,وجدتُ قنّينة غاتس مان إضافيّة وقتها
Dialogue: 0,0:05:54.46,0:05:57.85,Default,,0000,0000,0000,,!يوجد ختم على قنّينة غاتس مان هذه
Dialogue: 0,0:05:59.65,0:06:05.74,Default,,0000,0000,0000,,إنّه لحملة هدايا خاصة، لكنّها انتهت قبل ثلاثة أيام
Dialogue: 0,0:06:05.74,0:06:08.86,Default,,0000,0000,0000,,ودليلاً على ذلك، الختم ليس موجوداً\Nعلى قنّينتي العم
Dialogue: 0,0:06:11.14,0:06:12.36,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:06:15.19,0:06:16.31,Default,,0000,0000,0000,,!ولا على هذه
Dialogue: 0,0:06:16.31,0:06:20.96,Default,,0000,0000,0000,,فهمت، قد يكون هذا خيطاً مهماً
Dialogue: 0,0:06:21.93,0:06:26.73,Default,,0000,0000,0000,,تذكّرت! أوقفتُ واستجوبتُ الضحيّة\N!من قبل حضرة المفتّش
Dialogue: 0,0:06:26.92,0:06:27.81,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:06:28.17,0:06:29.92,Default,,0000,0000,0000,,كان ذلك قبل ثلاثة أسابيع
Dialogue: 0,0:06:29.92,0:06:34.08,Default,,0000,0000,0000,,بلّغت امرأة شابة تقطن في شقّة مجاورة
Dialogue: 0,0:06:34.08,0:06:38.07,Default,,0000,0000,0000,,عن تضايقها من ملاحقة شاب مريب لها باستمرار
Dialogue: 0,0:06:39.19,0:06:43.69,Default,,0000,0000,0000,,!وجدتُه آنذاك يتسكّع أمام الشقّة
Dialogue: 0,0:06:43.69,0:06:47.15,Default,,0000,0000,0000,,!أي أنّه كان مُلاحِقاً
Dialogue: 0,0:06:47.56,0:06:51.15,Default,,0000,0000,0000,,أجل، لحق بها لأنّه أُعجب بها غالباً
Dialogue: 0,0:06:51.15,0:06:57.48,Default,,0000,0000,0000,,لكنّه لم يؤذها بشيء بعد، لذا أعطيتُه\Nتحذيراً بالتوقف وأمرته بالانصراف
Dialogue: 0,0:06:58.68,0:07:00.77,Default,,0000,0000,0000,,ما كان عمله؟
Dialogue: 0,0:07:01.14,0:07:04.44,Default,,0000,0000,0000,,قال أنّه يدرس لامتحانات القبول
Dialogue: 0,0:07:04.44,0:07:07.40,Default,,0000,0000,0000,,أشقّة تلك المرأة بالقرب من هنا؟
Dialogue: 0,0:07:07.75,0:07:10.86,Default,,0000,0000,0000,,أجل، بعد موقع موته بقليل
Dialogue: 0,0:07:11.21,0:07:16.35,Default,,0000,0000,0000,,لعلّه كان يتّجه لشقّتها إذاً؟ أو يلاحقها مُجدداً؟
Dialogue: 0,0:07:17.07,0:07:18.15,Default,,0000,0000,0000,,إذاً؟
Dialogue: 0,0:07:18.70,0:07:22.53,Default,,0000,0000,0000,,لكنّها لم تقدّم أيّ بلاغ آخر
Dialogue: 0,0:07:22.53,0:07:26.10,Default,,0000,0000,0000,,فظننتُ أنّه توقف عن ملاحقتها
Dialogue: 0,0:07:26.10,0:07:29.56,Default,,0000,0000,0000,,حسناً، لنذهب للكلام معها
Dialogue: 0,0:07:31.86,0:07:33.82,Default,,0000,0000,0000,,مات؟ ذاك الشاب؟
Dialogue: 0,0:07:33.82,0:07:39.77,Default,,0000,0000,0000,,أجل، شرب قنّينة شراب طاقة مسموم\Nقبل قرابة 40 دقيقة
Dialogue: 0,0:07:42.01,0:07:45.49,Default,,0000,0000,0000,,اعذريني على السؤال، لكن أين كنتِ\Nفي ذاك الوقت؟
Dialogue: 0,0:07:46.36,0:07:48.76,Default,,0000,0000,0000,,قبل 40 دقيقة؟
Dialogue: 0,0:07:49.07,0:07:51.64,Default,,0000,0000,0000,,كنتُ قد رجعت للمنزل لتويّ
Dialogue: 0,0:07:51.64,0:07:55.41,Default,,0000,0000,0000,,أعمل في مطعم عائليّ في هايدو
Dialogue: 0,0:07:55.41,0:08:01.97,Default,,0000,0000,0000,,،نغلق عند الرابعة، فبعد الانتهاء من التنظيف \Nغادرت عند قرابة الخامسة وفقما أظنّ
Dialogue: 0,0:08:01.97,0:08:05.60,Default,,0000,0000,0000,,استقللتِ القطار لمحطّة بيكا؟
Dialogue: 0,0:08:05.60,0:08:06.34,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:08:06.34,0:08:09.14,Default,,0000,0000,0000,,ورجعتِ مشياً من المحطّة؟
Dialogue: 0,0:08:09.14,0:08:09.93,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:08:09.93,0:08:13.09,Default,,0000,0000,0000,,...ما يعني حضرة المفتّش، كما قال كونان
Dialogue: 0,0:08:14.64,0:08:16.21,Default,,0000,0000,0000,,أعطنا الخريطة
Dialogue: 0,0:08:16.21,0:08:16.88,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:08:22.13,0:08:27.78,Default,,0000,0000,0000,,نيشتاني-سان، أرينا الطريق الذي سلكتِه\Nمن محطّة بيكا لمنزلك رجاءً
Dialogue: 0,0:08:27.78,0:08:29.03,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:29.03,0:08:32.35,Default,,0000,0000,0000,,ذهبتُ من أمام المحطّة بهذا الطريق
Dialogue: 0,0:08:32.35,0:08:34.28,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:08:34.28,0:08:39.13,Default,,0000,0000,0000,,مرّت بآلة البيع والمكان\Nالذي سقط عنده ناغاي-سان
Dialogue: 0,0:08:40.19,0:08:42.01,Default,,0000,0000,0000,,!ما معنى هذا؟
Dialogue: 0,0:08:43.31,0:08:46.26,Default,,0000,0000,0000,,سقط ناغاي-سان هنا
Dialogue: 0,0:08:46.26,0:08:48.76,Default,,0000,0000,0000,,أي أنّه كان يلاحقك
Dialogue: 0,0:08:48.76,0:08:50.51,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:08:50.51,0:08:57.22,Default,,0000,0000,0000,,لم أره أبداً مُذ حذّره الشرطي\Nفشعرتُ بالارتياح
Dialogue: 0,0:08:57.79,0:09:02.04,Default,,0000,0000,0000,,لم تدرك أنّ ناغاي-سان\Nكان يلاحقها حقّاً؟
Dialogue: 0,0:09:03.09,0:09:05.97,Default,,0000,0000,0000,,للنوافذ والباب أقفال إضافية
Dialogue: 0,0:09:06.49,0:09:09.43,Default,,0000,0000,0000,,ولديها بخّاخ دفاع عن النفس أيضاً
Dialogue: 0,0:09:09.87,0:09:15.70,Default,,0000,0000,0000,,أكانت هذه من وقت خوفها\Nمن ملاحقة ناغاي-سان لها فحسب؟
Dialogue: 0,0:09:16.34,0:09:20.80,Default,,0000,0000,0000,,تحقّقنا من أنّ مركب الفوسفات العضوي\Nهو ما كان بقنّينة غاتس مان
Dialogue: 0,0:09:21.48,0:09:24.86,Default,,0000,0000,0000,,لم نجد إلّا بصمات ناغاي-سان عليها
Dialogue: 0,0:09:24.86,0:09:29.59,Default,,0000,0000,0000,,أي أنّ تجهيز القاتل لها سلفاً\Nأمر مرتفع الاحتمال
Dialogue: 0,0:09:30.18,0:09:34.06,Default,,0000,0000,0000,,هل حددتم موقع شراء\Nقنّينة غاتس مان تلك؟
Dialogue: 0,0:09:34.39,0:09:38.88,Default,,0000,0000,0000,,ليس بعد، لكن إن كان \N،من آلة البيع تلك
Dialogue: 0,0:09:38.88,0:09:45.38,Default,,0000,0000,0000,,فيُرجّح أنّها اُشتريت من بين أسبوع\Nإلى ظهيرة الأمس بالنظر للختم
Dialogue: 0,0:09:45.38,0:09:52.55,Default,,0000,0000,0000,,فالشركة المُنتجة استبدلت كلّ القنّينات\Nبأخرى دون الختم بالأمس
Dialogue: 0,0:09:53.70,0:09:55.16,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:09:55.16,0:09:56.76,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:10:00.32,0:10:04.68,Default,,0000,0000,0000,,يبدو أنّ أمّ ناغاي-سان\Nانتقلت هنا من شيزوكا مؤخراً
Dialogue: 0,0:10:05.19,0:10:10.26,Default,,0000,0000,0000,,تفقّدتُ منزلها، ووجدت هذا الألبوم
Dialogue: 0,0:10:12.77,0:10:15.77,Default,,0000,0000,0000,,صور للمرأة التي التقيناها صباح اليوم
Dialogue: 0,0:10:15.77,0:10:18.80,Default,,0000,0000,0000,,ويبدو أن كلّها مُلتقطة خلسة
Dialogue: 0,0:10:19.92,0:10:24.01,Default,,0000,0000,0000,,مررتُ بنيشتاني-سان مُجدداً\Nقبل قدومي هنا
Dialogue: 0,0:10:24.01,0:10:27.58,Default,,0000,0000,0000,,لم تكن تعلم أنّه كان يصوّرها
Dialogue: 0,0:10:27.58,0:10:29.72,Default,,0000,0000,0000,,بدت مصدومة
Dialogue: 0,0:10:29.72,0:10:30.97,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:30.97,0:10:33.58,Default,,0000,0000,0000,,هذه ليست نفس الشقّة
Dialogue: 0,0:10:33.58,0:10:36.19,Default,,0000,0000,0000,,وذاك ليس مطعماً عائلياً
Dialogue: 0,0:10:36.92,0:10:41.90,Default,,0000,0000,0000,,كانت تعيش في يوكوهاما قبل قدومها لبيكا\Nوتعمل في مخبز
Dialogue: 0,0:10:41.90,0:10:45.85,Default,,0000,0000,0000,,وكان حلمها أن تفتح متجرها الخاص
Dialogue: 0,0:10:45.85,0:10:50.30,Default,,0000,0000,0000,,هل انتقلت هنا للهرب من ناغاي-سان؟
Dialogue: 0,0:10:50.53,0:10:51.68,Default,,0000,0000,0000,,ذلك ما يبدو
Dialogue: 0,0:10:51.68,0:10:56.13,Default,,0000,0000,0000,,لكنّها لم تستطع النوم بسبب الخوف
Dialogue: 0,0:10:56.13,0:11:01.26,Default,,0000,0000,0000,,فبدأت العمل ليلاً حتّى الصباح\Nفي المطعم العائلي
Dialogue: 0,0:11:01.26,0:11:04.22,Default,,0000,0000,0000,,...عانت كثيراً، المسكينة
Dialogue: 0,0:11:04.47,0:11:09.12,Default,,0000,0000,0000,,لكنّ ناغاي-سان تلقّى مالاً\Nمن أبيه الذي يعمل حدّاداً
Dialogue: 0,0:11:09.12,0:11:12.01,Default,,0000,0000,0000,,فلم يكن بحاجة للعمل
Dialogue: 0,0:11:12.01,0:11:16.53,Default,,0000,0000,0000,,لذا يمكنه ملاحقتها متى أراد
Dialogue: 0,0:11:16.53,0:11:19.47,Default,,0000,0000,0000,,يا للرجل الدنيء الذي تورّطت معه
Dialogue: 0,0:11:19.86,0:11:22.40,Default,,0000,0000,0000,,...بخصوص هذه المرأة
Dialogue: 0,0:11:22.40,0:11:25.93,Default,,0000,0000,0000,,أحقّاً لم تدرك ملاحقة ناغاي-سان لها؟
Dialogue: 0,0:11:27.26,0:11:30.59,Default,,0000,0000,0000,,!أتّفق، هناك أمرٌ ما بها
Dialogue: 0,0:11:30.59,0:11:35.06,Default,,0000,0000,0000,,أتقصد أنّها سمّمت قنّينة غاتس مان\Nوجعلته يشربها؟
Dialogue: 0,0:11:35.37,0:11:38.09,Default,,0000,0000,0000,,لا يمكننا استبعاد ذلك
Dialogue: 0,0:11:38.59,0:11:43.76,Default,,0000,0000,0000,,لعلّها عرفت أنّه كان يلحق بها
Dialogue: 0,0:11:43.76,0:11:46.58,Default,,0000,0000,0000,,فاشترت غاتس مان من آلة البيع
Dialogue: 0,0:11:46.58,0:11:49.47,Default,,0000,0000,0000,,ووضعت القنّينة المسمومة\Nأثناء أخذها للأخرى
Dialogue: 0,0:11:50.25,0:11:55.08,Default,,0000,0000,0000,,...إذا اشترى ناغاي-سان قنّينةً بدوره، وأخذ الأخرى
Dialogue: 0,0:11:55.08,0:12:00.41,Default,,0000,0000,0000,,...لكن لا ضمان لشرائه الشراب نفسه
Dialogue: 0,0:12:01.05,0:12:02.47,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:12:02.47,0:12:04.70,Default,,0000,0000,0000,,نسيت شيئاً مهماً
Dialogue: 0,0:12:05.37,0:12:05.93,Default,,0000,0000,0000,,انظر
Dialogue: 0,0:12:05.93,0:12:08.73,Default,,0000,0000,0000,,الحلقة السفلية مقطوعة، صحيح؟
Dialogue: 0,0:12:08.73,0:12:13.97,Default,,0000,0000,0000,,هكذا سيشتبه أيّ أحد إذا رأوا أنّ الغطاء\Nقد خُلع، ولن يشربوه
Dialogue: 0,0:12:14.23,0:12:15.15,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:12:15.97,0:12:20.93,Default,,0000,0000,0000,,أي أنّ القاتل لم يترك القنّينة\Nفي آلة البيع تلك؟
Dialogue: 0,0:12:21.59,0:12:24.22,Default,,0000,0000,0000,,...تداخلت الأمور الآن
Dialogue: 0,0:12:24.22,0:12:26.96,Default,,0000,0000,0000,,بالمناسبة، أمر آخر بخصوص ناغاي-سان
Dialogue: 0,0:12:27.54,0:12:33.58,Default,,0000,0000,0000,,رآه أحد جيرانه يغادر شقّته\Nعند العاشرة ليلة البارحة
Dialogue: 0,0:12:33.58,0:12:36.07,Default,,0000,0000,0000,,وبيده حقيبة صغيرة
Dialogue: 0,0:12:36.84,0:12:40.22,Default,,0000,0000,0000,,كان عاري اليدين عندما سقط صباحاً
Dialogue: 0,0:12:40.22,0:12:45.18,Default,,0000,0000,0000,,قد لا يمتّ ذلك للقضيّة بصلة، لكنّه يضايقني
Dialogue: 0,0:12:45.18,0:12:46.40,Default,,0000,0000,0000,,حقيبة؟
Dialogue: 0,0:12:56.01,0:13:01.64,Default,,0000,0000,0000,,أليست هناك طريقة مكّنتها من جعل\Nناغاي-سان يشرب قنّينة غاتس مان مفتوحة؟
Dialogue: 0,0:13:04.31,0:13:05.77,Default,,0000,0000,0000,,!لا أستطيع الشرب أكثر
Dialogue: 0,0:13:06.13,0:13:07.71,Default,,0000,0000,0000,,!لنسبح يا كونان-كن
Dialogue: 0,0:13:07.71,0:13:09.79,Default,,0000,0000,0000,,سأبقى هنا لفترة أطول
Dialogue: 0,0:13:10.54,0:13:12.22,Default,,0000,0000,0000,,!سأذهب وأسبح إذاً
Dialogue: 0,0:13:18.17,0:13:21.14,Default,,0000,0000,0000,,ما خطبكما؟ أهناك أمرٌ ما؟
Dialogue: 0,0:13:21.14,0:13:23.62,Default,,0000,0000,0000,,!لا-لا شيء
Dialogue: 0,0:13:21.14,0:13:24.06,Default,,0000,0000,0000,,!لا-لا شيء
Dialogue: 0,0:13:28.15,0:13:30.89,Default,,0000,0000,0000,,أعينكما على الكولا التي تركتها أيومي، صحيح؟
Dialogue: 0,0:13:31.15,0:13:34.32,Default,,0000,0000,0000,,!ما-ما هذا يا كونان-كن؟ كلامك غير معقول
Dialogue: 0,0:13:34.32,0:13:35.52,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:13:35.52,0:13:37.31,Default,,0000,0000,0000,,!لـ-لنذهب للسباحة يا ميتسوهيكو-كن
Dialogue: 0,0:13:37.31,0:13:38.35,Default,,0000,0000,0000,,!نعم يا غينتا-سان
Dialogue: 0,0:13:38.35,0:13:39.60,Default,,0000,0000,0000,,!الطقس حارّ بالفعل يا ميتسوهيكو-كن
Dialogue: 0,0:13:39.60,0:13:40.96,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:13:41.76,0:13:44.97,Default,,0000,0000,0000,,...أطفال يصيبهم انحراف
Dialogue: 0,0:13:46.84,0:13:49.67,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:13:56.71,0:14:00.18,Default,,0000,0000,0000,,أعرف الطريقة، لكن لا دليل لديّ
Dialogue: 0,0:14:02.64,0:14:04.10,Default,,0000,0000,0000,,حضرة الشرطيّ
Dialogue: 0,0:14:04.79,0:14:07.98,Default,,0000,0000,0000,,أنت مع موري-سان، اسمك كونان-كن؟
Dialogue: 0,0:14:07.98,0:14:08.61,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:14:08.61,0:14:09.76,Default,,0000,0000,0000,,تجري استجواباً؟
Dialogue: 0,0:14:09.76,0:14:10.78,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:14:10.78,0:14:16.55,Default,,0000,0000,0000,,كنتُ آمل التحقّق من شراء الضحيّة\Nلغاتس مان هنا على الأقل
Dialogue: 0,0:14:16.98,0:14:20.26,Default,,0000,0000,0000,,هل تفقّدت البصمات على العملات\Nداخل آلة البيع؟
Dialogue: 0,0:14:20.52,0:14:24.27,Default,,0000,0000,0000,,أجل، لكن لم نجد بصمات الضحيّة
Dialogue: 0,0:14:24.27,0:14:29.72,Default,,0000,0000,0000,,لكننا وجدنا عملتين مجموعهما 110 ينّ\Nمُسحت البصمات عنها
Dialogue: 0,0:14:29.87,0:14:33.18,Default,,0000,0000,0000,,!اشترى القاتل غاتس مان هنا بالفعل إذاً
Dialogue: 0,0:14:33.59,0:14:36.29,Default,,0000,0000,0000,,ليته يوجد متجر تموينات هنا
Dialogue: 0,0:14:36.29,0:14:39.63,Default,,0000,0000,0000,,فقد تلتقط تسجيلاً على كاميرات المراقبة أحياناً
Dialogue: 0,0:14:39.67,0:14:40.42,Default,,0000,0000,0000,,تسجيل؟
Dialogue: 0,0:14:41.46,0:14:42.58,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:14:42.58,0:14:45.47,Default,,0000,0000,0000,,هل تفقدتم كلّ ما كان\Nبحوزة ناغاي-سان؟
Dialogue: 0,0:14:45.47,0:14:46.40,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:46.40,0:14:50.18,Default,,0000,0000,0000,,أخبرني بما كان معه، فالعمّ موري طلب\Nمني التحرّي عن ذلك
Dialogue: 0,0:14:50.40,0:14:51.71,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:14:52.67,0:14:53.62,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:14:54.19,0:14:59.59,Default,,0000,0000,0000,,محفظة ورخصة قيادة وسجائر\Nومفتاح شقّة وقدّاحة
Dialogue: 0,0:14:59.89,0:15:02.05,Default,,0000,0000,0000,,قدّاحة؟! ما نوعها؟
Dialogue: 0,0:15:03.85,0:15:08.01,Default,,0000,0000,0000,,كانت تُفتح بهذا الشكل، وأكبر حجماً من العادة
Dialogue: 0,0:15:08.30,0:15:10.80,Default,,0000,0000,0000,,أين هي الآن؟
Dialogue: 0,0:15:10.80,0:15:13.05,Default,,0000,0000,0000,,أعدناها لأمّ الضحيّة
Dialogue: 0,0:15:13.05,0:15:14.80,Default,,0000,0000,0000,,!حسناً! شكراً
Dialogue: 0,0:15:17.71,0:15:18.53,Default,,0000,0000,0000,,!المعذرة
Dialogue: 0,0:15:18.53,0:15:18.86,Default,,0000,0000,0000,,نعم؟
Dialogue: 0,0:15:19.10,0:15:20.66,Default,,0000,0000,0000,,هناك ما أريد سؤالك عنه
Dialogue: 0,0:15:21.18,0:15:22.62,Default,,0000,0000,0000,,حسناً، ما الأمر؟
Dialogue: 0,0:15:26.53,0:15:28.47,Default,,0000,0000,0000,,!الطلاء الذي كان على الضحيّة
Dialogue: 0,0:15:28.86,0:15:31.55,Default,,0000,0000,0000,,!يا عمّ! من أين وصله هذا الطلاء؟
Dialogue: 0,0:15:33.70,0:15:35.76,Default,,0000,0000,0000,,...نعم، وكالة موري للتحرّي
Dialogue: 0,0:15:35.76,0:15:38.72,Default,,0000,0000,0000,,موري-كن، معك ميغوري
Dialogue: 0,0:15:41.56,0:15:44.14,Default,,0000,0000,0000,,لكن ألم تكن من استدعاني؟
Dialogue: 0,0:15:44.14,0:15:45.84,Default,,0000,0000,0000,,ما الذي تقوله؟
Dialogue: 0,0:15:45.84,0:15:47.30,Default,,0000,0000,0000,,أنت من استدعاني هنا
Dialogue: 0,0:15:47.30,0:15:48.59,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:48.59,0:15:52.10,Default,,0000,0000,0000,,ما معنى هذا؟ لديّ عمل عليّ الذهاب له
Dialogue: 0,0:15:52.88,0:15:54.10,Default,,0000,0000,0000,,...في الواقع
Dialogue: 0,0:15:57.00,0:16:00.01,Default,,0000,0000,0000,,حضرة المفتّش! يبدو أنّي من استدعاك
Dialogue: 0,0:16:00.47,0:16:03.89,Default,,0000,0000,0000,,!ها قد بدأ! أكمل رجاءً
Dialogue: 0,0:16:03.89,0:16:08.07,Default,,0000,0000,0000,,نيشتاني-سان، أنصحك بإبلاغ مديرك\Nأنّك لن تعملي الليلة
Dialogue: 0,0:16:08.07,0:16:14.35,Default,,0000,0000,0000,,!فأنتِ المجرمة التي سمّمت وقتلت ناغاي-سان
Dialogue: 0,0:16:16.23,0:16:17.59,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:16:18.48,0:16:23.51,Default,,0000,0000,0000,,كنتِ تعرفين أنّ ناغاي-سان يتبعك ذاك الصباح
Dialogue: 0,0:16:23.85,0:16:26.73,Default,,0000,0000,0000,,فاشتريتِ غاتس مان من آلة البيع تلك
Dialogue: 0,0:16:27.47,0:16:29.93,Default,,0000,0000,0000,,سنطلق عليها بالقنّينة أ
Dialogue: 0,0:16:29.93,0:16:35.22,Default,,0000,0000,0000,,أخرجتِ بعدها قنّينة غاتس مان\Nأخرى جهّزتِها سلفاً سنسمّيها بالقنّينة ب
Dialogue: 0,0:16:35.88,0:16:40.96,Default,,0000,0000,0000,,وتظاهرتِ بأخذ القنّينة أ بينما يشاهدك ناغاي-سان
Dialogue: 0,0:16:40.96,0:16:44.26,Default,,0000,0000,0000,,نزعتِ الغطاء وشربتِ بينما تمشين
Dialogue: 0,0:16:45.21,0:16:49.45,Default,,0000,0000,0000,,ثمّ وضعتِ قنّينة غاتس مان مغلقة على حائط
Dialogue: 0,0:16:49.45,0:16:53.03,Default,,0000,0000,0000,,لكنّها لم تكن القنّينة ب\Nالتي شربتِ منها
Dialogue: 0,0:16:53.03,0:16:57.63,Default,,0000,0000,0000,,،بل كانت القنّينة الأخرى التي جهزتِها\Nقنّينة غاتس مان ج
Dialogue: 0,0:16:58.98,0:17:03.85,Default,,0000,0000,0000,,بالطبع، من عادة المُلاحِقين الغريبة أن يأخذوا\Nأغراض الشخص الذي يتتبعونه
Dialogue: 0,0:17:04.94,0:17:08.17,Default,,0000,0000,0000,,فأخذ ناغاي-سان القنّينة ج
Dialogue: 0,0:17:08.60,0:17:12.18,Default,,0000,0000,0000,,وجد أنّها لا تزال تحوي شراباً كثيراً
Dialogue: 0,0:17:13.10,0:17:17.55,Default,,0000,0000,0000,,...بما أنّه كان مهووساً بك، شربها بسرور
Dialogue: 0,0:17:18.42,0:17:20.85,Default,,0000,0000,0000,,دون علمه بوجود السمّ
Dialogue: 0,0:17:22.51,0:17:26.12,Default,,0000,0000,0000,,سبب تركك لقنّينة غاتس مان في آلة البيع
Dialogue: 0,0:17:26.12,0:17:28.58,Default,,0000,0000,0000,,لجعلها تبدو جريمة عشوائية
Dialogue: 0,0:17:29.74,0:17:35.41,Default,,0000,0000,0000,,عدم وجود بصماتك على العملات التي\Nاشتريتِ بها القنّينة أ
Dialogue: 0,0:17:35.41,0:17:38.23,Default,,0000,0000,0000,,كما القنّينة ج الفارغة
Dialogue: 0,0:17:38.23,0:17:46.31,Default,,0000,0000,0000,,كان لوضعك غراءً على أصابعك\Nفي حمّام في محطّة بيكا غالباً
Dialogue: 0,0:17:47.47,0:17:49.01,Default,,0000,0000,0000,,!غراء؟
Dialogue: 0,0:17:49.01,0:17:57.13,Default,,0000,0000,0000,,عندما أتيناها أوّل مرة، كانت تفرك شيئاً من أصابعها
Dialogue: 0,0:17:57.13,0:17:59.98,Default,,0000,0000,0000,,كان غراءً جافاً
Dialogue: 0,0:18:01.18,0:18:05.05,Default,,0000,0000,0000,,من الغريب ارتداء قفّازات في هذا الموسم
Dialogue: 0,0:18:05.05,0:18:09.63,Default,,0000,0000,0000,,وإمساك القنّينة بمنديل كان سيثير ريبة ناغاي-سان
Dialogue: 0,0:18:09.63,0:18:12.85,Default,,0000,0000,0000,,لذا استعملتِ الغراء
Dialogue: 0,0:18:13.54,0:18:17.30,Default,,0000,0000,0000,,استنتج كما تشاء، لكن لا دليل لديك
Dialogue: 0,0:18:17.61,0:18:19.78,Default,,0000,0000,0000,,الدليل موجود
Dialogue: 0,0:18:19.78,0:18:20.48,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:18:22.78,0:18:23.73,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:18:28.31,0:18:29.88,Default,,0000,0000,0000,,...هـ-هذه
Dialogue: 0,0:18:37.63,0:18:42.76,Default,,0000,0000,0000,,يبدو أنّك لم تعرفي أنّه كان يصوّرك خلسة
Dialogue: 0,0:18:42.76,0:18:48.16,Default,,0000,0000,0000,,لا عجب، فقد كان يستعمل كاميرا معدّلة
Dialogue: 0,0:18:49.33,0:18:50.80,Default,,0000,0000,0000,,كاميرا معدّلة؟
Dialogue: 0,0:18:52.00,0:18:53.26,Default,,0000,0000,0000,,هذه
Dialogue: 0,0:18:55.50,0:18:58.42,Default,,0000,0000,0000,,هذه القدّاحة تخرج لهباً
Dialogue: 0,0:18:59.38,0:19:02.14,Default,,0000,0000,0000,,لكن إذا فتحت هذا الغطاء ستظهر كاميرا
Dialogue: 0,0:19:02.75,0:19:05.01,Default,,0000,0000,0000,,وهذا زرّ المصراع
Dialogue: 0,0:19:11.98,0:19:19.01,Default,,0000,0000,0000,,كان حرفياً يجيد استعمال يديه\Nمثل أبيه الحدّاد
Dialogue: 0,0:19:19.01,0:19:22.47,Default,,0000,0000,0000,,...إذا أمعنا النظر في الصور سنلاحظ
Dialogue: 0,0:19:22.97,0:19:27.22,Default,,0000,0000,0000,,وجود ختم على قنّينة غاتس مان الظاهرة
Dialogue: 0,0:19:29.33,0:19:31.64,Default,,0000,0000,0000,,ختم الحملة الخاصة؟
Dialogue: 0,0:19:31.64,0:19:37.53,Default,,0000,0000,0000,,كما قلت يا مفتّش ميغوري، كلّ قنّينات\Nغاتس مان في آلة البيع تلك
Dialogue: 0,0:19:37.53,0:19:40.57,Default,,0000,0000,0000,,...اُستبدلت بقنّينات جديدة
Dialogue: 0,0:19:40.81,0:19:43.80,Default,,0000,0000,0000,,لا تحوي ختماً ظهيرة الأمس
Dialogue: 0,0:19:44.24,0:19:45.01,Default,,0000,0000,0000,,...أي
Dialogue: 0,0:19:45.56,0:19:46.42,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:19:48.48,0:19:50.73,Default,,0000,0000,0000,,أنا قتلتُه
Dialogue: 0,0:19:51.35,0:19:54.60,Default,,0000,0000,0000,,اعتقدتُ أنّه سيقتلني إذا لم أفعل
Dialogue: 0,0:19:55.10,0:19:57.05,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:19:57.43,0:20:01.34,Default,,0000,0000,0000,,قبل أسبوع، عندما كنتُ نازلةً\Nمن أدراج المحطّة
Dialogue: 0,0:20:08.12,0:20:14.64,Default,,0000,0000,0000,,أخبرتني نظراته، "كيف تجرؤين على\N"!إخبار الشرطة؟! سأقتلك حتماً
Dialogue: 0,0:20:15.08,0:20:19.59,Default,,0000,0000,0000,,لذا ظننتُ أنّ لا خيار أمامي\N!سوى قتله قبل أن يقتلني
Dialogue: 0,0:20:21.32,0:20:26.05,Default,,0000,0000,0000,,حضرة المفتّش، من الصحيح أنّ ناغاي-سان \Nخطّط لقتل نيشتاني-سان
Dialogue: 0,0:20:26.05,0:20:26.68,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:27.40,0:20:30.01,Default,,0000,0000,0000,,انظر للحقيبة في الخلف
Dialogue: 0,0:20:31.22,0:20:34.14,Default,,0000,0000,0000,,إنّها تخصّ ناغاي-سان
Dialogue: 0,0:20:34.56,0:20:40.60,Default,,0000,0000,0000,,وكانت مخبّأة بمحاذاة عمود إنارة \Nتمّ طلاؤه حديثاً
Dialogue: 0,0:20:41.76,0:20:44.42,Default,,0000,0000,0000,,تفقّد محتواها
Dialogue: 0,0:20:46.13,0:20:52.46,Default,,0000,0000,0000,,خطّط ناغاي-سان لأخذ الحقيبة التي أخفاها\Nبعد وصول نيشتاني-سان لمنزلها غالباً
Dialogue: 0,0:20:52.46,0:20:57.87,Default,,0000,0000,0000,,وانتظار فرصته للدخول بقطع زجاج النافذة والدخول
Dialogue: 0,0:20:57.87,0:21:01.20,Default,,0000,0000,0000,,ثمّ قتلها بتلك السكّين
Dialogue: 0,0:21:02.20,0:21:04.81,Default,,0000,0000,0000,,...كانت إذاً على وشك أن
Dialogue: 0,0:21:04.81,0:21:08.15,Default,,0000,0000,0000,,لن يُقبل كدفاع عن النفس
Dialogue: 0,0:21:08.15,0:21:12.72,Default,,0000,0000,0000,,لكن ستلقين محاكمةً مُخفّفة غالباً
Dialogue: 0,0:21:13.31,0:21:14.86,Default,,0000,0000,0000,,نيشتاني-سان
Dialogue: 0,0:21:14.86,0:21:17.35,Default,,0000,0000,0000,,كفّري عن ذنبك سريعاً
Dialogue: 0,0:21:17.35,0:21:23.64,Default,,0000,0000,0000,,وارجعي للعمل على حُلمك الجميل\Nفي فتح مخبزك الخاص
Dialogue: 0,0:21:24.26,0:21:27.64,Default,,0000,0000,0000,,فلا تزالين في مُقتبل العمر
Dialogue: 0,0:21:29.75,0:21:31.57,Default,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:23:10.15,0:23:15.93,Default,,0000,0000,0000,,ملأت هذه القضيّة رأسي بالأفكار، بخصوص المُلاحِقين تحديداً
Dialogue: 0,0:23:15.93,0:23:21.10,Default,,0000,0000,0000,,كثيراً ما يأتيك يا عمّ عُملاء يشتكون \N...من ملاحقة أحد لهم
Dialogue: 0,0:23:21.10,0:23:23.10,Default,,0000,0000,0000,,أو تلقّيهم اتّصالات صامتة
Dialogue: 0,0:23:23.43,0:23:26.92,Default,,0000,0000,0000,,إثبات هكذا جرائم أمرٌ صعب
Dialogue: 0,0:23:26.92,0:23:31.47,Default,,0000,0000,0000,,لن تفعل الشرطة الكثير، وحتّى إن قاموا بشيء
Dialogue: 0,0:23:31.47,0:23:37.00,Default,,0000,0000,0000,,لحظة اكتشاف الشخص المخبول\N،أنّك صددتِه بصرامة
Dialogue: 0,0:23:37.00,0:23:40.01,Default,,0000,0000,0000,,قد تقلبه لمُجرم متوحّش
Dialogue: 0,0:23:40.45,0:23:42.48,Default,,0000,0000,0000,,أجل، عليّ توخي الحذر
Dialogue: 0,0:23:43.58,0:23:48.42,Default,,0000,0000,0000,,!لا تقلقي! لن يُفتن أحد بصبيانية سليطة مثلك
Dialogue: 0,0:23:48.68,0:23:50.05,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:23:55.56,0:23:58.19,Default,,0000,0000,0000,,لا أريد قلبها عليّ
Dialogue: 0,0:24:10.17,0:24:10.95,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:24:16.34,0:24:19.82,Default,,0000,0000,0000,,!لا دم على مساحة معصمه
Dialogue: 0,0:24:21.37,0:24:23.24,Default,,0000,0000,0000,,!المشتبه بهم ثلاثة توائم؟
Dialogue: 0,0:24:23.62,0:24:29.65,On Top,,0000,0000,0000,,جريمة قتل منزل عطلات التوائم الثلاثة
Dialogue: 0,0:24:24.53,0:24:26.02,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.02,0:24:28.73,Default,,0000,0000,0000,,جريمة قتل منزل عطلات التوائم الثلاثة
Dialogue: 0,0:24:45.34,0:24:48.00,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.00,0:24:49.23,Default,,0000,0000,0000,,هوم رن
Dialogue: 0,0:24:49.23,0:24:51.23,Default,,0000,0000,0000,,

