Dialogue: 0,0:00:01.23,0:00:04.30,Default,,0000,0000,0000,,طالما جرائم العصر الحديث تتضمّن بشراً
Dialogue: 0,0:00:04.30,0:00:05.70,Default,,0000,0000,0000,,!لا توجد ألغاز لا تُحلّ
Dialogue: 0,0:00:05.97,0:00:07.67,Default,,0000,0000,0000,,!قضيّة اليوم عن سلاح جريمة غامض
Dialogue: 0,0:00:07.67,0:00:09.20,Default,,0000,0000,0000,,!لنستعمل عقولنا ونكتشفه
Dialogue: 0,0:00:09.50,0:00:11.21,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.21,0:00:12.66,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ دماغه لبالغ
Dialogue: 0,0:00:13.29,0:00:15.07,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.06,0:01:56.95,Title,,0000,0000,0000,,{\fad(300,0)}قضيّة سلاح جريمة القتل الغامض
Dialogue: 0,0:01:51.95,0:01:54.50,Default,,0000,0000,0000,,قضيّة سلاح جريمة القتل الغامض
Dialogue: 0,0:01:57.28,0:02:00.98,Default,,0000,0000,0000,,من الجميل أنّ نتنزه نحن الثلاثة\Nبراحةٍ هكذا بين الحين والآخر
Dialogue: 0,0:02:00.98,0:02:02.48,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:02.48,0:02:05.40,Default,,0000,0000,0000,,ما المسلّي في التنزه مع هذا القزم؟
Dialogue: 0,0:02:07.85,0:02:09.97,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:02:13.93,0:02:15.86,Default,,0000,0000,0000,,ما هذا يا كونان-كن؟
Dialogue: 0,0:02:16.72,0:02:18.04,Default,,0000,0000,0000,,...طير صغير
Dialogue: 0,0:02:18.04,0:02:19.38,Default,,0000,0000,0000,,أهو ميت؟
Dialogue: 0,0:02:19.38,0:02:21.25,Default,,0000,0000,0000,,كلا، يبدو بخير
Dialogue: 0,0:02:21.25,0:02:22.57,Default,,0000,0000,0000,,لا يزال حيّاً
Dialogue: 0,0:02:23.33,0:02:25.86,Default,,0000,0000,0000,,لا يبدو مُصاباً
Dialogue: 0,0:02:30.52,0:02:31.73,Default,,0000,0000,0000,,...طار
Dialogue: 0,0:02:31.73,0:02:36.03,Default,,0000,0000,0000,,يا للطير الغريب، ربما كانت نوبة فقر دم
Dialogue: 0,0:02:37.98,0:02:39.94,Default,,0000,0000,0000,,!إنّها من مجمع الشقق ذاك
Dialogue: 0,0:02:47.23,0:02:49.04,Default,,0000,0000,0000,,...من أين
Dialogue: 0,0:02:53.26,0:02:57.24,Default,,0000,0000,0000,,توجد شقّتان مسكونتان فحسب
Dialogue: 0,0:02:57.24,0:02:59.21,Default,,0000,0000,0000,,كيف أساعدكم؟
Dialogue: 0,0:02:59.21,0:03:03.00,Default,,0000,0000,0000,,!سمعنا صرخة مرأة من المبنى قبل قليل
Dialogue: 0,0:03:03.00,0:03:07.07,Default,,0000,0000,0000,,...أأنت متأكد؟ لم أسمع شيئاً
Dialogue: 0,0:03:07.90,0:03:11.53,Default,,0000,0000,0000,,مرحباً، رجعت باكراً
Dialogue: 0,0:03:11.53,0:03:12.99,Default,,0000,0000,0000,,أهناك خطب ما؟
Dialogue: 0,0:03:12.99,0:03:15.16,Default,,0000,0000,0000,,...حسناً، هؤلاء الأشخاص يقولون
Dialogue: 0,0:03:16.78,0:03:18.27,Default,,0000,0000,0000,,أأنتِ بخير؟
Dialogue: 0,0:03:18.27,0:03:20.40,Default,,0000,0000,0000,,!إنّها مصيبة! زوجي
Dialogue: 0,0:03:20.40,0:03:22.99,Default,,0000,0000,0000,,!قُتل زوجي في شرفتنا
Dialogue: 0,0:03:26.28,0:03:27.85,Default,,0000,0000,0000,,أنا المتحرّي موري
Dialogue: 0,0:03:27.85,0:03:29.93,Default,,0000,0000,0000,,من أطلقت تلك الصرخة كانت أنت، صحيح؟
Dialogue: 0,0:03:29.93,0:03:31.35,Default,,0000,0000,0000,,ما رقم شقّتكم؟
Dialogue: 0,0:03:31.35,0:03:33.57,Default,,0000,0000,0000,,رقم 715
Dialogue: 0,0:03:36.39,0:03:39.46,Default,,0000,0000,0000,,أخبرني، نظرتُ لصناديق البريد قبل قليل
Dialogue: 0,0:03:39.46,0:03:41.25,Default,,0000,0000,0000,,يكاد لا يعيش أحد هنا، صحيح؟
Dialogue: 0,0:03:41.25,0:03:44.63,Default,,0000,0000,0000,,سيُهدم هذا المبنى في هذا الشهر
Dialogue: 0,0:03:44.63,0:03:46.13,Default,,0000,0000,0000,,لذا المقيمون الوحيدون هنا
Dialogue: 0,0:03:46.13,0:03:50.78,Default,,0000,0000,0000,,هما إيموتو الذي يدير عقاراته الخاصة، وتيراساوا-سان هذا
Dialogue: 0,0:03:57.56,0:03:58.77,Default,,0000,0000,0000,,اسمح لي
Dialogue: 0,0:04:04.40,0:04:07.86,Default,,0000,0000,0000,,زوج حذاء كعب عالٍ وزوجا أحذية رجال
Dialogue: 0,0:04:16.58,0:04:19.65,CharCard,,0000,0000,0005,,{\fad(300,0)}(ريوسكي إيموتو (39\Nرئيس وكالة عقارات
Dialogue: 0,0:04:21.01,0:04:23.59,Default,,0000,0000,0000,,ضُرب على مؤخرة رأسه
Dialogue: 0,0:04:23.59,0:04:26.88,Default,,0000,0000,0000,,يبدو أنّ سلاح الجريمة كان أصيص أزهار
Dialogue: 0,0:04:26.88,0:04:27.91,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:04:27.91,0:04:30.11,Default,,0000,0000,0000,,ا-اسمي دوباشي
Dialogue: 0,0:04:30.62,0:04:32.25,Default,,0000,0000,0000,,!أقتلته؟
Dialogue: 0,0:04:32.25,0:04:33.61,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:04:43.24,0:04:46.20,Default,,0000,0000,0000,,كان سبب الموت ضرراً دماغياً إذاً
Dialogue: 0,0:04:46.20,0:04:50.73,Default,,0000,0000,0000,,رفع القاتل أصيص أزهار\Nوراء الضحيّة غالباً
Dialogue: 0,0:04:50.73,0:04:53.18,Default,,0000,0000,0000,,وضربه بأقصى قوّته
Dialogue: 0,0:04:53.18,0:04:55.11,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:04:55.39,0:04:57.57,Default,,0000,0000,0000,,يوجد أثر هنا
Dialogue: 0,0:04:57.92,0:05:00.67,Default,,0000,0000,0000,,...ربما له علاقة بالجريمة
Dialogue: 0,0:05:00.67,0:05:01.69,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:05:02.05,0:05:07.11,Default,,0000,0000,0000,,!كفّ عن التدخل في التحقيق دوماً
Dialogue: 0,0:05:10.75,0:05:11.87,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:05:11.87,0:05:14.15,Default,,0000,0000,0000,,يوجد أثر هنا بالفعل
Dialogue: 0,0:05:14.62,0:05:19.61,Default,,0000,0000,0000,,يبدو حديثاً مقارنة ببقيّة الآثار
Dialogue: 0,0:05:21.99,0:05:24.99,Default,,0000,0000,0000,,كان الضحيّة السيّد ريوسكي، 39 عاماً
Dialogue: 0,0:05:24.99,0:05:28.06,Default,,0000,0000,0000,,رئيس "نييد"، وكالة عقارات
Dialogue: 0,0:05:28.94,0:05:32.94,Default,,0000,0000,0000,,،من وجد الجثة كانت زوجته\Nأنت يا تاكاكو-سان، صحيح؟
Dialogue: 0,0:05:32.94,0:05:33.90,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:05:35.27,0:05:37.93,Default,,0000,0000,0000,,والشخص الذي كان بجوار الجثّة
Dialogue: 0,0:05:37.93,0:05:39.86,Default,,0000,0000,0000,,...عندما وصل موري-كن والبقيّة مسرعين
Dialogue: 0,0:05:40.06,0:05:44.58,Default,,0000,0000,0000,,أُدعى دوباشي، أدير شركة استيراد
Dialogue: 0,0:05:44.58,0:05:48.49,Default,,0000,0000,0000,,أنا مدير إيموتو-كن السابق\Nومن عرّفه على زوجته
Dialogue: 0,0:05:48.49,0:05:51.52,Default,,0000,0000,0000,,أتيتُ اليوم لرؤيته بشأن موضوع متعلّق بالعمل
Dialogue: 0,0:05:51.52,0:05:53.95,Default,,0000,0000,0000,,...وسيط العلاقة إذاً
Dialogue: 0,0:05:53.95,0:05:55.56,Default,,0000,0000,0000,,ومن تكون أنت؟
Dialogue: 0,0:05:55.56,0:06:00.40,Default,,0000,0000,0000,,تيراساوا، أعيش في الطابق الخامس\Nمن هذا المبنى
Dialogue: 0,0:06:00.40,0:06:02.39,Default,,0000,0000,0000,,كنتُ أدير متجر معدّات صيد سمك
Dialogue: 0,0:06:03.27,0:06:04.85,Default,,0000,0000,0000,,كنت؟
Dialogue: 0,0:06:04.85,0:06:08.60,Default,,0000,0000,0000,,!استولى إيموتو على متجري
Dialogue: 0,0:06:08.60,0:06:11.31,Default,,0000,0000,0000,,!استعمل ثغرةً قانونية دنيئة لفعل ذلك
Dialogue: 0,0:06:11.68,0:06:14.73,Default,,0000,0000,0000,,!كان رجلاً شنيعاً
Dialogue: 0,0:06:14.97,0:06:20.47,Default,,0000,0000,0000,,قام بأشياء مشابهة لهذين الاثنين غالباً أيضاً
Dialogue: 0,0:06:20.75,0:06:23.50,Default,,0000,0000,0000,,ما قولكما؟
Dialogue: 0,0:06:23.50,0:06:24.54,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:06:24.54,0:06:28.45,Default,,0000,0000,0000,,يُفترض ألّا أقول هذا بما أنّي وسيط علاقتهما
Dialogue: 0,0:06:28.45,0:06:31.03,Default,,0000,0000,0000,,لكن كان إيموتو-كن وزوجته\Nفي منتصف إجراءات طلاق
Dialogue: 0,0:06:31.03,0:06:33.66,Default,,0000,0000,0000,,وكانت هناك مشكلة حيال التعويض
Dialogue: 0,0:06:33.66,0:06:35.08,Default,,0000,0000,0000,,لكنّ ذلك لن يهم إذا مات
Dialogue: 0,0:06:35.08,0:06:36.74,Default,,0000,0000,0000,,فستحصل هي على إرثه
Dialogue: 0,0:06:36.74,0:06:37.72,Default,,0000,0000,0000,,!ما الذي تتكلم عنه؟
Dialogue: 0,0:06:38.32,0:06:40.86,Default,,0000,0000,0000,,سمعتُ أنّ زوجي رفض طلباتك المستمرة بالإقراض
Dialogue: 0,0:06:40.86,0:06:44.82,Default,,0000,0000,0000,,!لأنّ شركتك كانت على حافة الإقفال
Dialogue: 0,0:06:44.82,0:06:47.19,Default,,0000,0000,0000,,!لذا انفعلتَ وقمت بقتله
Dialogue: 0,0:06:47.19,0:06:49.01,Default,,0000,0000,0000,,!مـ-مستحيل
Dialogue: 0,0:06:49.01,0:06:51.43,Default,,0000,0000,0000,,اهدئي قليلاً يا سيّدة
Dialogue: 0,0:06:51.72,0:06:53.51,Default,,0000,0000,0000,,بالمناسبة يا مشرف المبنى
Dialogue: 0,0:06:53.51,0:06:57.40,Default,,0000,0000,0000,,أذاك الباب الأمامي هو المدخل\Nوالمخرج الوحيد للمبنى؟
Dialogue: 0,0:06:57.40,0:06:59.60,Default,,0000,0000,0000,,أ-أجل، صحيح
Dialogue: 0,0:06:59.60,0:07:03.64,Default,,0000,0000,0000,,...والوحيدون الذي دخلوا اليوم إلى جانب الضحيّة
Dialogue: 0,0:07:03.64,0:07:09.06,Default,,0000,0000,0000,,هم زوجته ودوباشي-سان وتيراساوا-سان فحسب
Dialogue: 0,0:07:09.06,0:07:13.87,Default,,0000,0000,0000,,كما كان لكلّ منكم دافع قويّ لقتل الضحية
Dialogue: 0,0:07:13.87,0:07:18.76,Default,,0000,0000,0000,,أي أنّ المجرم بينكم الثلاثة
Dialogue: 0,0:07:19.11,0:07:21.03,Default,,0000,0000,0000,,!لا-لا يُعقل
Dialogue: 0,0:07:21.03,0:07:22.61,Default,,0000,0000,0000,,سنبدأ بك يا سيّدة
Dialogue: 0,0:07:22.61,0:07:25.73,Default,,0000,0000,0000,,وضّحي لنا الظروف عندما\Nعثرتِ على الجثّة رجاءً
Dialogue: 0,0:07:31.10,0:07:35.22,Default,,0000,0000,0000,,أتيتُ لهذا المبنى بعد الخامسة بقليل
Dialogue: 0,0:07:35.22,0:07:37.72,Default,,0000,0000,0000,,كانت بعد الـ5:05 بقليل تحديداً
Dialogue: 0,0:07:37.72,0:07:41.31,Default,,0000,0000,0000,,فأنا أسجّل دخول وخروج الجميع من المبنى
Dialogue: 0,0:07:41.59,0:07:44.80,Default,,0000,0000,0000,,سيفيدنا ذلك كثيراً
Dialogue: 0,0:07:44.80,0:07:47.27,Default,,0000,0000,0000,,أكملي من فضلك
Dialogue: 0,0:07:47.75,0:07:49.95,Default,,0000,0000,0000,,سبب قدومي اليوم
Dialogue: 0,0:07:49.95,0:07:52.87,Default,,0000,0000,0000,,هو لمناقشة التعويض مع زوجي مُجدداً
Dialogue: 0,0:07:52.87,0:07:55.20,Default,,0000,0000,0000,,كما ذكر دوباشي-سان
Dialogue: 0,0:07:55.20,0:07:58.43,Default,,0000,0000,0000,,كنّا نعيش منفصلين لفترة
Dialogue: 0,0:07:58.90,0:08:00.57,Default,,0000,0000,0000,,عندما دخلت
Dialogue: 0,0:08:00.57,0:08:03.90,Default,,0000,0000,0000,,كان يمارس زوجي التاي تشي\Nعلى الشرفة بمفرده
Dialogue: 0,0:08:03.90,0:08:05.15,Default,,0000,0000,0000,,التاي تشي؟
Dialogue: 0,0:08:05.15,0:08:06.24,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:06.24,0:08:10.35,Default,,0000,0000,0000,,كان يمارسه زوجي صباح ومساء\Nكلّ يوم لصحّته
Dialogue: 0,0:08:10.35,0:08:13.64,Default,,0000,0000,0000,,لم يلاحظني عندما دخلت
Dialogue: 0,0:08:13.64,0:08:15.77,Default,,0000,0000,0000,,ولم أناد عليه
Dialogue: 0,0:08:17.23,0:08:21.10,Default,,0000,0000,0000,,...عندما نظرتُ للشرفة مجدداً بعد استعمال الحمّام
Dialogue: 0,0:08:25.30,0:08:27.51,Default,,0000,0000,0000,,!وجدته ميتاً
Dialogue: 0,0:08:27.87,0:08:32.83,Default,,0000,0000,0000,,أي قُتل زوجك بينما كنتِ في الحمّام؟
Dialogue: 0,0:08:32.83,0:08:34.21,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:34.21,0:08:38.43,Default,,0000,0000,0000,,اعذريني، لكن كم قضيتِ في الحمّام بالضبط؟
Dialogue: 0,0:08:38.95,0:08:42.49,Default,,0000,0000,0000,,قرابة دقيقتين فحسب وفقما أظن
Dialogue: 0,0:08:42.49,0:08:46.77,Default,,0000,0000,0000,,ما يعني أنّ زوجك مات عند 5:08 تقريباً
Dialogue: 0,0:08:46.77,0:08:48.60,Default,,0000,0000,0000,,بينما كنتِ في الحمّام
Dialogue: 0,0:08:48.60,0:08:52.23,Default,,0000,0000,0000,,أسمعتِ أصوات أو كلام أحد؟
Dialogue: 0,0:08:52.64,0:08:54.14,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:08:54.14,0:08:57.65,Default,,0000,0000,0000,,أخبريني يا عمّة، عندما دخلتِ الشقّة
Dialogue: 0,0:08:57.65,0:08:59.85,Default,,0000,0000,0000,,أكانت هناك أحذية عند الباب؟
Dialogue: 0,0:09:01.18,0:09:04.27,Default,,0000,0000,0000,,أجل، حذاء زوجي فحسب
Dialogue: 0,0:09:04.47,0:09:06.42,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:09:06.42,0:09:08.17,Default,,0000,0000,0000,,التالي، دوباشي-سان
Dialogue: 0,0:09:08.66,0:09:12.37,Default,,0000,0000,0000,,متى أتيت لهذا المبنى بالضبط؟
Dialogue: 0,0:09:12.37,0:09:16.16,Default,,0000,0000,0000,,قُبيل الخامسة كما أظن
Dialogue: 0,0:09:16.16,0:09:19.38,Default,,0000,0000,0000,,كان يُفترض أن ألتقي\Nبإيموتو-كن عند الخامسة
Dialogue: 0,0:09:19.38,0:09:22.34,Default,,0000,0000,0000,,عند 4:58 بالتحديد
Dialogue: 0,0:09:22.86,0:09:25.86,Default,,0000,0000,0000,,كما قالت زوجته، سبب قدومي هنا
Dialogue: 0,0:09:25.86,0:09:29.30,Default,,0000,0000,0000,,هو طلب قرض منه لمرّة أخيرة
Dialogue: 0,0:09:29.30,0:09:30.39,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:09:33.18,0:09:35.14,Default,,0000,0000,0000,,لا جدوى مهما طلبت
Dialogue: 0,0:09:35.51,0:09:39.96,Default,,0000,0000,0000,,فلا رغبة ولا دافع لي لمساعدتك
Dialogue: 0,0:09:39.96,0:09:42.59,Default,,0000,0000,0000,,ارحل من فضلك
Dialogue: 0,0:09:43.00,0:09:46.29,Default,,0000,0000,0000,,ذهبتُ للسطح بعدها
Dialogue: 0,0:09:46.29,0:09:47.78,Default,,0000,0000,0000,,لارتكاب الانتحار
Dialogue: 0,0:09:47.78,0:09:48.78,Default,,0000,0000,0000,,!الانتحار؟
Dialogue: 0,0:09:48.78,0:09:52.18,Default,,0000,0000,0000,,لكنّي لم أستطع
Dialogue: 0,0:09:52.18,0:09:55.74,Default,,0000,0000,0000,,وقفتُ هناك لفترة شارد الذهن
Dialogue: 0,0:09:55.74,0:10:00.68,Default,,0000,0000,0000,,عندها سمعت صرخة الزوجة\Nمن الجانب الآخر للسطح
Dialogue: 0,0:10:02.40,0:10:05.05,Default,,0000,0000,0000,,بعدها أسرعتُ للغرفة
Dialogue: 0,0:10:05.48,0:10:09.22,Default,,0000,0000,0000,,ووجدت إيموتو-سان ميتاً على الشرفة؟
Dialogue: 0,0:10:09.22,0:10:10.51,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:10.93,0:10:13.68,Default,,0000,0000,0000,,ماذا عنك يا تيراساوا-سان؟
Dialogue: 0,0:10:14.72,0:10:18.80,Default,,0000,0000,0000,,لا علاقة لي، فقد كنتُ خارج المبنى
Dialogue: 0,0:10:18.80,0:10:20.63,Default,,0000,0000,0000,,علينا التحقق
Dialogue: 0,0:10:20.63,0:10:23.71,Default,,0000,0000,0000,,متى غادرت المبنى بالضبط؟
Dialogue: 0,0:10:23.71,0:10:27.46,Default,,0000,0000,0000,,...قبل الخامسة بقليل كما أذكر
Dialogue: 0,0:10:27.46,0:10:29.95,Default,,0000,0000,0000,,عند 4:50 بالتحديد
Dialogue: 0,0:10:29.95,0:10:34.20,Default,,0000,0000,0000,,ولم يرجع حتّى بعد 5:12
Dialogue: 0,0:10:34.20,0:10:35.01,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:10:35.01,0:10:36.01,Default,,0000,0000,0000,,لكن؟
Dialogue: 0,0:10:36.01,0:10:42.22,Default,,0000,0000,0000,,...رجع من تمرين الغولف أبكر من المعتاد
Dialogue: 0,0:10:42.22,0:10:45.28,Default,,0000,0000,0000,,غيّرتُ رأيي في طريقي فحسب
Dialogue: 0,0:10:45.28,0:10:47.89,Default,,0000,0000,0000,,!لطالما كنتُ سريع التقلّب
Dialogue: 0,0:10:51.68,0:10:54.27,Default,,0000,0000,0000,,ما رأيك يا موري-كن؟
Dialogue: 0,0:10:57.06,0:10:59.26,Default,,0000,0000,0000,,بدايةً، تيراساوا-سان
Dialogue: 0,0:10:59.26,0:11:04.42,Default,,0000,0000,0000,,لم تكن في المبنى عندما قُتل إيموتو-سان
Dialogue: 0,0:11:04.42,0:11:06.02,Default,,0000,0000,0000,,لذا لستَ القاتل
Dialogue: 0,0:11:07.62,0:11:10.67,Default,,0000,0000,0000,,موضوعنا مع الزوجة ودوباشي-سان
Dialogue: 0,0:11:11.08,0:11:12.26,Default,,0000,0000,0000,,أنت أوّلاً يا سيّدة
Dialogue: 0,0:11:12.26,0:11:17.22,Default,,0000,0000,0000,,قلتِ أنّك وجدت جثّة زوجك\Nبعد مغادرتك الحمّام
Dialogue: 0,0:11:17.57,0:11:20.57,Default,,0000,0000,0000,,لكن هناك احتمال بعدم ذهابك للحمّام أصلاً
Dialogue: 0,0:11:20.57,0:11:24.53,Default,,0000,0000,0000,,وقتلك زوجك، ثم تظاهرك بالعثور على جثّته
Dialogue: 0,0:11:24.53,0:11:25.90,Default,,0000,0000,0000,,والصراخ
Dialogue: 0,0:11:26.10,0:11:27.62,Default,,0000,0000,0000,,!مـ-ماذا؟
Dialogue: 0,0:11:27.62,0:11:29.22,Default,,0000,0000,0000,,وأنت يا دوباشي-سان
Dialogue: 0,0:11:29.22,0:11:32.68,Default,,0000,0000,0000,,قلتَ أنك صعدت للسطح
Dialogue: 0,0:11:32.68,0:11:34.61,Default,,0000,0000,0000,,بعدما رفض إيموتو-سان إقراضك
Dialogue: 0,0:11:34.61,0:11:37.83,Default,,0000,0000,0000,,لكن هناك احتمال أنّك كنت في مكتبه
Dialogue: 0,0:11:37.83,0:11:41.42,Default,,0000,0000,0000,,!أو معه في الشرفة
Dialogue: 0,0:11:41.71,0:11:44.75,Default,,0000,0000,0000,,ما يمكن رؤيته من هنا\Nهو جزء صغير من الشرفة فحسب
Dialogue: 0,0:11:44.75,0:11:48.61,Default,,0000,0000,0000,,هناك احتمال أنّك كنت في الشرفة
Dialogue: 0,0:11:48.61,0:11:50.99,Default,,0000,0000,0000,,أو في المكتب عندما دخلت الزوجة
Dialogue: 0,0:11:50.99,0:11:53.66,Default,,0000,0000,0000,,وقتلت الضحيّة بينما كانت هي في الحمّام
Dialogue: 0,0:11:53.66,0:11:55.30,Default,,0000,0000,0000,,ثم صعدت للسطح
Dialogue: 0,0:11:55.61,0:11:56.91,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:11:56.91,0:12:01.06,Default,,0000,0000,0000,,!كنتُ على السطح بوقت وصولها هنا
Dialogue: 0,0:12:01.06,0:12:04.71,Default,,0000,0000,0000,,قالت بنفسها أنّ حذاء إيموتو-كن\N!وحده كان عند الباب
Dialogue: 0,0:12:04.71,0:12:08.47,Default,,0000,0000,0000,,يُحتمل أنّها لم تتذكر بدقّة
Dialogue: 0,0:12:08.47,0:12:12.92,Default,,0000,0000,0000,,أم تملك دليلاً بوجودك على السطح طوال الوقت؟
Dialogue: 0,0:12:12.92,0:12:14.68,Default,,0000,0000,0000,,دليل؟
Dialogue: 0,0:12:14.68,0:12:18.21,Default,,0000,0000,0000,,كلا، لم يكن هناك أحد على السطح
Dialogue: 0,0:12:18.21,0:12:21.00,Default,,0000,0000,0000,,!صحيح! سمعتُ صوتاً
Dialogue: 0,0:12:21.00,0:12:22.13,Default,,0000,0000,0000,,صوت؟
Dialogue: 0,0:12:22.54,0:12:25.71,Default,,0000,0000,0000,,أجل، كان صوتاً معدنياً مرتفعاً
Dialogue: 0,0:12:25.71,0:12:27.49,Default,,0000,0000,0000,,أتى من اتّجاه هذه الشرفة
Dialogue: 0,0:12:27.49,0:12:29.70,Default,,0000,0000,0000,,سمعت صوتاً؟
Dialogue: 0,0:12:29.70,0:12:32.04,Default,,0000,0000,0000,,أجل، وقعه معدنيّ
Dialogue: 0,0:12:32.04,0:12:36.80,Default,,0000,0000,0000,,أيمكن أنّه كان صوت شيء\Nأصاب السور المعدنيّ؟
Dialogue: 0,0:12:37.07,0:12:39.96,Default,,0000,0000,0000,,انظروا، هناك آثر جديد عليه
Dialogue: 0,0:12:43.00,0:12:46.96,Default,,0000,0000,0000,,...يبدو أنّ شيئاً صلباً أصابه من الأسفل
Dialogue: 0,0:12:49.18,0:12:51.29,Default,,0000,0000,0000,,!هذا! هذا هو الصوت
Dialogue: 0,0:12:53.43,0:12:55.55,Default,,0000,0000,0000,,الأثر مشابه
Dialogue: 0,0:12:55.55,0:12:59.79,Default,,0000,0000,0000,,لكن الأثر الآخر كان من الأسفل
Dialogue: 0,0:12:59.79,0:13:00.79,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:00.79,0:13:04.00,Default,,0000,0000,0000,,لكن لا شكّ أن أحداً طرقه
Dialogue: 0,0:13:04.50,0:13:07.20,Default,,0000,0000,0000,,أسمعتِ الصوت يا سيّدتي؟
Dialogue: 0,0:13:07.58,0:13:08.78,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:13:08.78,0:13:12.63,Default,,0000,0000,0000,,لم أسمع لأنّي كنت في الحمام غالباً
Dialogue: 0,0:13:12.63,0:13:14.28,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:13:14.28,0:13:17.83,Default,,0000,0000,0000,,لمَ قد يتسبب أحد بأثر\Nفي موضع كذاك؟
Dialogue: 0,0:13:18.73,0:13:20.61,Default,,0000,0000,0000,,غير منطقيّ
Dialogue: 0,0:13:20.61,0:13:22.82,Default,,0000,0000,0000,,يبدو هذا السور مثيراً للريبة
Dialogue: 0,0:13:22.82,0:13:27.05,Default,,0000,0000,0000,,لكن لا يظهر لي أنّ أحد الاثنين كاذب أيضاً
Dialogue: 0,0:13:27.05,0:13:28.39,Default,,0000,0000,0000,,!لكن حضرة المفتّش
Dialogue: 0,0:13:28.39,0:13:30.39,Default,,0000,0000,0000,,سماع دوباشي لصوت طرق السور
Dialogue: 0,0:13:30.39,0:13:33.64,Default,,0000,0000,0000,,!ليس دليلاً على كونه في السطح
Dialogue: 0,0:13:33.64,0:13:35.06,Default,,0000,0000,0000,,ربما تسبب هو أو الضحية بالصوت
Dialogue: 0,0:13:35.06,0:13:38.46,Default,,0000,0000,0000,,!بينما كان في الشرفة
Dialogue: 0,0:13:39.08,0:13:42.30,Default,,0000,0000,0000,,وأيضاً لو كان القاتل شخصاً آخر
Dialogue: 0,0:13:42.30,0:13:45.46,Default,,0000,0000,0000,,هذا يعني أنّه طار كالطير وقتل الضحيّة
Dialogue: 0,0:13:45.46,0:13:48.79,Default,,0000,0000,0000,,!ثم طار مجدداً كما أتى
Dialogue: 0,0:13:49.04,0:13:51.20,Default,,0000,0000,0000,,!ذلك مستحيل
Dialogue: 0,0:13:51.20,0:13:53.50,Default,,0000,0000,0000,,...مـ-معك حق
Dialogue: 0,0:13:53.95,0:13:57.99,Default,,0000,0000,0000,,طير؟ طير... طير؟
Dialogue: 0,0:14:00.32,0:14:03.54,Default,,0000,0000,0000,,...بالمناسبة، المكان الذي سقط فيه ذاك الطير
Dialogue: 0,0:14:05.32,0:14:06.98,Default,,0000,0000,0000,,!كان ذاك
Dialogue: 0,0:14:06.98,0:14:09.50,Default,,0000,0000,0000,,!أمام الأثر على السور تماماً
Dialogue: 0,0:14:09.77,0:14:11.96,Default,,0000,0000,0000,,...موضع سقوط الضحيّة
Dialogue: 0,0:14:11.96,0:14:13.81,Default,,0000,0000,0000,,...موضع سقوط الطير
Dialogue: 0,0:14:13.81,0:14:15.03,Default,,0000,0000,0000,,...الأثر على السور
Dialogue: 0,0:14:18.46,0:14:20.13,Default,,0000,0000,0000,,بناء مهجور مقابل الشرفة؟
Dialogue: 0,0:14:21.76,0:14:23.13,Default,,0000,0000,0000,,فهمت الآن
Dialogue: 0,0:14:23.13,0:14:25.05,Default,,0000,0000,0000,,!هذه حيلة القاتل
Dialogue: 0,0:14:25.05,0:14:27.45,Default,,0000,0000,0000,,!لم يكن سلاح الجريمة أصيص أزهار
Dialogue: 0,0:14:28.91,0:14:30.98,Default,,0000,0000,0000,,!القاتل هو ذاك الشخص
Dialogue: 0,0:14:35.97,0:14:38.39,Default,,0000,0000,0000,,لا يمكن أنّ استنتاجي خاطئ
Dialogue: 0,0:14:39.34,0:14:41.25,Default,,0000,0000,0000,,إنّها زوجته وتعيش منفصلة عنه
Dialogue: 0,0:14:42.41,0:14:44.66,Default,,0000,0000,0000,,إنّه رئيس شركة استيراد
Dialogue: 0,0:14:44.66,0:14:48.60,Default,,0000,0000,0000,,وهو مالك سابق لمتجر معدّات صيد
Dialogue: 0,0:14:49.00,0:14:50.46,Default,,0000,0000,0000,,...ما يعني أنّ القاتل
Dialogue: 0,0:14:50.46,0:14:52.72,Default,,0000,0000,0000,,إذاً حضرة المفتش
Dialogue: 0,0:14:52.72,0:14:55.68,Default,,0000,0000,0000,,سأرجع لشقّتي الآن
Dialogue: 0,0:14:55.68,0:14:57.36,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:14:57.36,0:15:00.15,Default,,0000,0000,0000,,يمكنك الانصراف لليوم
Dialogue: 0,0:14:58.32,0:15:00.15,Default,,0000,0000,0000,,!لا يمكنني ترك ذلك يحدث
Dialogue: 0,0:15:00.57,0:15:02.66,Default,,0000,0000,0000,,!عليّ لفت انتباه العمّ للأمر بشكلٍ ما
Dialogue: 0,0:15:10.23,0:15:11.27,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:15:19.09,0:15:21.06,Default,,0000,0000,0000,,هل اكتشفت شيئاً يا موري-كن؟
Dialogue: 0,0:15:21.37,0:15:25.50,Default,,0000,0000,0000,,كلا... لا شيء
Dialogue: 0,0:15:25.50,0:15:28.73,Default,,0000,0000,0000,,يمكنك المغادرة إذاً يا تيراساوا-سان
Dialogue: 0,0:15:28.73,0:15:29.96,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:15:29.96,0:15:31.82,Default,,0000,0000,0000,,ماذا عنّي؟
Dialogue: 0,0:15:31.82,0:15:32.68,Default,,0000,0000,0000,,وأنا؟
Dialogue: 0,0:15:35.35,0:15:36.73,Default,,0000,0000,0000,,!هذا مُسلٍّ
Dialogue: 0,0:15:41.81,0:15:43.07,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:15:55.51,0:15:58.06,Default,,0000,0000,0000,,هيّا، أدرك الأمر يا عمّ
Dialogue: 0,0:16:00.26,0:16:01.30,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:16:03.04,0:16:05.93,Default,,0000,0000,0000,,هذا مكان سقوط الضحيّة
Dialogue: 0,0:16:06.95,0:16:11.96,Default,,0000,0000,0000,,وهنا... الأثر على السور
Dialogue: 0,0:16:13.52,0:16:15.36,Default,,0000,0000,0000,,ماذا تفعل يا عمّ؟
Dialogue: 0,0:16:15.36,0:16:19.23,Default,,0000,0000,0000,,كونان، سقط ذاك الطير هناك، صحيح؟
Dialogue: 0,0:16:19.23,0:16:20.55,Default,,0000,0000,0000,,!أجل، صحيح
Dialogue: 0,0:16:26.59,0:16:28.22,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:16:28.22,0:16:32.05,Default,,0000,0000,0000,,،الضحيّة والأثر على السور والطير\Nكما ذاك المبنى المهجور
Dialogue: 0,0:16:32.05,0:16:34.01,Default,,0000,0000,0000,,!كلّها على خطّ واحد
Dialogue: 0,0:16:34.01,0:16:37.21,Default,,0000,0000,0000,,!عرفتُ الفاعل حضرة المفتّش
Dialogue: 0,0:16:37.21,0:16:39.97,Default,,0000,0000,0000,,حقّاً؟! من إذاً؟
Dialogue: 0,0:16:40.50,0:16:42.41,Default,,0000,0000,0000,,لا تستعجل
Dialogue: 0,0:16:42.41,0:16:46.51,Default,,0000,0000,0000,,سأوضّح كلّ شيء على ذاك المبنى المهجور
Dialogue: 0,0:16:46.95,0:16:48.18,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:03.27,0:17:05.09,Default,,0000,0000,0000,,موري-كن
Dialogue: 0,0:17:05.29,0:17:08.38,Default,,0000,0000,0000,,ما الذي تتفقده في مكان كهذا؟
Dialogue: 0,0:17:08.38,0:17:10.55,Default,,0000,0000,0000,,لا أرى علاقة له بالجريمة
Dialogue: 0,0:17:15.12,0:17:18.25,Default,,0000,0000,0000,,اجتمعوا هنا من فضلكم
Dialogue: 0,0:17:21.90,0:17:24.36,Default,,0000,0000,0000,,دعوني أسأل بدايةً
Dialogue: 0,0:17:24.36,0:17:26.74,Default,,0000,0000,0000,,سيّدتي، دوباشي-سان، تيراساوا-سان
Dialogue: 0,0:17:26.74,0:17:29.71,Default,,0000,0000,0000,,أسبق لأحدكم القدوم هنا قبلاً؟
Dialogue: 0,0:17:30.03,0:17:32.02,Default,,0000,0000,0000,,بالطبع لا
Dialogue: 0,0:17:32.02,0:17:34.06,Default,,0000,0000,0000,,ولا أنا
Dialogue: 0,0:17:34.06,0:17:36.89,Default,,0000,0000,0000,,كذلك أنا
Dialogue: 0,0:17:36.89,0:17:38.79,Default,,0000,0000,0000,,دعوني أشرح إذاً
Dialogue: 0,0:17:39.35,0:17:42.75,Default,,0000,0000,0000,,يمكنكم رؤية شرفة الضحيّة من هنا، صحيح؟
Dialogue: 0,0:17:43.47,0:17:46.96,Default,,0000,0000,0000,,أجل، لكن ما أهميّة ذلك؟
Dialogue: 0,0:17:47.63,0:17:50.38,Default,,0000,0000,0000,,أسبق وسمعت بصيد الضفّة حضرة المفتش؟
Dialogue: 0,0:17:50.38,0:17:51.87,Default,,0000,0000,0000,,صيد الضفّة؟
Dialogue: 0,0:17:51.87,0:17:57.00,Default,,0000,0000,0000,,إنّه نوع من الصيد تستعمل فيه\Nما تُدعى بالبكرة الدورانية
Dialogue: 0,0:17:57.00,0:18:00.83,Default,,0000,0000,0000,,كي يستطيع الصيّاد رمي الخيط\Nمسافة عشرات الأمتار
Dialogue: 0,0:18:00.83,0:18:03.24,Default,,0000,0000,0000,,استعمل القاتل هذه التقنية من هنا
Dialogue: 0,0:18:03.24,0:18:08.08,Default,,0000,0000,0000,,وأصاب رأس الضحيّة بثقلٍ\N!وهو على الشرفة هناك
Dialogue: 0,0:18:08.32,0:18:09.29,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:18:10.40,0:18:11.05,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:18:14.31,0:18:17.21,Default,,0000,0000,0000,,الدليل هو آثار الأقدام هذه
Dialogue: 0,0:18:17.60,0:18:21.11,Default,,0000,0000,0000,,أثر القدم اليسرى محفور ويتقدم اليمنى
Dialogue: 0,0:18:21.46,0:18:25.60,Default,,0000,0000,0000,,تركه القاتل عندما كان يهمّ\Nبقذف القصبة فوق رأسه
Dialogue: 0,0:18:26.70,0:18:27.62,Default,,0000,0000,0000,,هكذا
Dialogue: 0,0:18:31.24,0:18:34.49,Default,,0000,0000,0000,,عندما قُتل، كان الضحيّة يمارس التاي تشي
Dialogue: 0,0:18:34.99,0:18:37.16,Default,,0000,0000,0000,,المعروفة بحركاتها البطيئة
Dialogue: 0,0:18:37.91,0:18:39.53,Default,,0000,0000,0000,,استغلّ القاتل ذلك
Dialogue: 0,0:18:39.53,0:18:43.65,Default,,0000,0000,0000,,وقذف الثقل عندما أدار الضحيّة ظهره
Dialogue: 0,0:18:50.48,0:18:53.99,Default,,0000,0000,0000,,...وبينما كان يُسحب
Dialogue: 0,0:18:53.99,0:18:56.70,Default,,0000,0000,0000,,أصاب الثقل السور المعدنيّ
Dialogue: 0,0:18:56.70,0:18:59.45,Default,,0000,0000,0000,,ذاك كان الصوت الذي سمعتُه إذاً؟
Dialogue: 0,0:18:59.45,0:19:00.72,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:19:00.72,0:19:05.91,Default,,0000,0000,0000,,لم يدرك القاتل أنّ الثقل\Nترك أثراً آنذاك
Dialogue: 0,0:19:05.91,0:19:11.00,Default,,0000,0000,0000,,كما كان هناك خطأ آخر في حساباته
Dialogue: 0,0:19:11.00,0:19:15.91,Default,,0000,0000,0000,,أصاب الثقل طيراً في طريقه بينما يسحبه
Dialogue: 0,0:19:19.20,0:19:23.86,Default,,0000,0000,0000,,كان الطير الذي حملتَه\Nقد أُصيب بارتجاج دماغيّ غالباً
Dialogue: 0,0:19:23.86,0:19:28.57,Default,,0000,0000,0000,,لكن يا موري-كن، المسافة تُقارب 30 متراً للشرفة
Dialogue: 0,0:19:28.57,0:19:32.93,Default,,0000,0000,0000,,أيمكن لشخص قذف وزن\Nلتلك المسافة بدقّة حقاً؟
Dialogue: 0,0:19:32.93,0:19:34.86,Default,,0000,0000,0000,,يمكنه بالتمرين
Dialogue: 0,0:19:35.14,0:19:38.58,Default,,0000,0000,0000,,لا سيّما بالنسبة لشخص يجيد صيد الضفّة بالتحديد
Dialogue: 0,0:19:38.58,0:19:41.53,Default,,0000,0000,0000,,أليس كذلك يا تيراساوا-سان؟
Dialogue: 0,0:19:43.26,0:19:45.13,Default,,0000,0000,0000,,تيراساوا-سان
Dialogue: 0,0:19:45.13,0:19:48.49,Default,,0000,0000,0000,,الحذاء الذي ترتديه الآن
Dialogue: 0,0:19:48.76,0:19:51.41,Default,,0000,0000,0000,,يُفترض أن يُطابق آثار الأقدام هنا بلا شك
Dialogue: 0,0:19:51.41,0:19:55.08,Default,,0000,0000,0000,,كما لو فتّشنا هذا المبنى المهجور بعناية
Dialogue: 0,0:19:55.08,0:19:56.16,Default,,0000,0000,0000,,...سنجد غالباً
Dialogue: 0,0:19:56.16,0:19:59.48,Default,,0000,0000,0000,,!يا عمّ! يوجد شيء على الأرض هنا
Dialogue: 0,0:20:02.44,0:20:03.65,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:20:03.65,0:20:05.94,Default,,0000,0000,0000,,!أعرفه! إنّها قبضة قصبة
Dialogue: 0,0:20:05.94,0:20:07.24,Default,,0000,0000,0000,,قبضة قصبة؟
Dialogue: 0,0:20:07.24,0:20:08.03,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:08.03,0:20:11.93,Default,,0000,0000,0000,,بعدما يربط الصيّادون قصبات الصيد أحياناً
Dialogue: 0,0:20:11.93,0:20:13.78,Default,,0000,0000,0000,,يصعب فكّها
Dialogue: 0,0:20:13.78,0:20:15.93,Default,,0000,0000,0000,,لذا لمنع أيديهم من الانزلاق
Dialogue: 0,0:20:15.93,0:20:20.58,Default,,0000,0000,0000,,يضعون أنابيب أو شرائط مطاطية\Nعند مربط القصبات
Dialogue: 0,0:20:20.58,0:20:23.40,Default,,0000,0000,0000,,ثمّ ينزعون القصبات بلفّها في الاتّجاه المعاكس
Dialogue: 0,0:20:23.67,0:20:26.63,Default,,0000,0000,0000,,...من المُبهر أنّك تعرف ذلك
Dialogue: 0,0:20:26.63,0:20:29.59,Default,,0000,0000,0000,,صادف أن رأيتُه في برنامج صيد\Nعلى التلفاز بالأمس
Dialogue: 0,0:20:29.59,0:20:32.71,Default,,0000,0000,0000,,بالمناسبة، كانوا يخلعون قفّازات أيديهم\Nعندما يستعملون هذه
Dialogue: 0,0:20:32.71,0:20:34.21,Default,,0000,0000,0000,,لأنّها ستنزلق
Dialogue: 0,0:20:34.21,0:20:37.62,Default,,0000,0000,0000,,!ما يعني أنّ بصمات الفاعل ستكون عليها
Dialogue: 0,0:20:38.41,0:20:41.65,Default,,0000,0000,0000,,تيراساوا-سان، بصماتك أنت
Dialogue: 0,0:20:45.61,0:20:48.37,Default,,0000,0000,0000,,لا يسعني سوى الضّحك
Dialogue: 0,0:20:49.83,0:20:52.54,Default,,0000,0000,0000,,استولى على متجري
Dialogue: 0,0:20:52.54,0:20:55.69,Default,,0000,0000,0000,,وقال أنّه سيبني مبنى أزياء حديث مكانه
Dialogue: 0,0:20:55.69,0:21:00.49,Default,,0000,0000,0000,,أخبرته أنّي سأترك الملكية له\N...إذا أبقى المتجر على الأقل، لكنه
Dialogue: 0,0:21:02.01,0:21:05.84,Default,,0000,0000,0000,,لا جدوى من إبقاء متجر تافه كهذا
Dialogue: 0,0:21:05.84,0:21:08.99,Default,,0000,0000,0000,,ما المسلّي في صيد السمك أصلاً؟
Dialogue: 0,0:21:08.99,0:21:10.43,Default,,0000,0000,0000,,يا للسخافة
Dialogue: 0,0:21:10.43,0:21:12.82,Default,,0000,0000,0000,,ما الذي يعجب الفاشلون بهذا؟
Dialogue: 0,0:21:26.35,0:21:28.49,Default,,0000,0000,0000,,قصبة صيدي الغالية
Dialogue: 0,0:21:28.49,0:21:31.74,Default,,0000,0000,0000,,!حطّمها أمامي
Dialogue: 0,0:21:36.06,0:21:40.94,Default,,0000,0000,0000,,!لم أستطع تركه يفلت بفعلته
Dialogue: 0,0:23:18.89,0:23:21.95,Default,,0000,0000,0000,,كان استنتاجك مذهلاً البارحة يا أبي
Dialogue: 0,0:23:21.95,0:23:24.17,Default,,0000,0000,0000,,تُغيّر رؤيتي لك أكثر فأكثر
Dialogue: 0,0:23:24.31,0:23:28.22,Default,,0000,0000,0000,,!قضايا كتلك أشبه بالماء لي
Dialogue: 0,0:23:31.81,0:23:34.99,Default,,0000,0000,0000,,هل صنع لعبة قصبة الصيد تلك
Dialogue: 0,0:23:34.99,0:23:36.90,Default,,0000,0000,0000,,كي يلفت انتباهي في الواقع؟
Dialogue: 0,0:23:38.34,0:23:39.17,Default,,0000,0000,0000,,!أمسكتُ بشيء
Dialogue: 0,0:23:40.87,0:23:41.49,Default,,0000,0000,0000,,!تعال
Dialogue: 0,0:23:49.24,0:23:50.30,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:23:50.30,0:23:51.12,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:23:54.93,0:23:56.79,Default,,0000,0000,0000,,...مستحيل
Dialogue: 0,0:24:00.96,0:24:03.88,Default,,0000,0000,0000,,!ارجع بسرعة يا شينتشي
Dialogue: 0,0:24:06.75,0:24:09.65,Default,,0000,0000,0000,,!إنّه أحد رجال الرداء الأسود
Dialogue: 0,0:24:10.42,0:24:11.83,Default,,0000,0000,0000,,!وجدتكم أخيراً
Dialogue: 0,0:24:14.29,0:24:17.58,Default,,0000,0000,0000,,!دعني! علينا الإسراع وإلّا سيفلت الفاعل
Dialogue: 0,0:24:17.58,0:24:19.84,Default,,0000,0000,0000,,!فهمت! هكذا إذاً
Dialogue: 0,0:24:20.78,0:24:24.13,Default,,0000,0000,0000,,!كانت هذه جريمة غير متوقّعة بالنسبة للقاتل
Dialogue: 0,0:24:24.13,0:24:30.13,On Top,,0000,0000,15,,جريمة قتل شركة الألعاب
Dialogue: 0,0:24:24.73,0:24:25.88,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.00,0:24:28.22,Default,,0000,0000,0000,,جريمة قتل شركة الألعاب
Dialogue: 0,0:24:45.83,0:24:48.01,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.01,0:24:49.96,Default,,0000,0000,0000,,بطاقة حجرة إيداع
Dialogue: 0,0:24:50.46,0:24:52.56,Default,,0000,0000,0000,,!يظهرٌ رجل برداء أسود في الحلقة القادمة
Dialogue: 0,0:24:52.56,0:24:54.56,Default,,0000,0000,0000,,كونان، سأرجع لكوني بالغاً أيضاً

