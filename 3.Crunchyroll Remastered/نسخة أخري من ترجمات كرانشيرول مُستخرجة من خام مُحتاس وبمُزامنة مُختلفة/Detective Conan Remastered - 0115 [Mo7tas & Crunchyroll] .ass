Dialogue: 0,0:00:01.54,0:00:04.83,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.83,0:00:06.96,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.96,0:00:09.87,Default,,0000,0000,0000,,!اليوم استنتاجات بالكامل! لنغيّر نظرتنا للطرف الآخر أحياناً
Dialogue: 0,0:00:10.21,0:00:11.74,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.74,0:00:13.79,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.79,0:00:16.04,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.54,0:00:24.21,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.21,0:00:31.25,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.93,0:00:39.38,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.38,0:00:46.88,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.88,0:00:59.33,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.17,0:01:06.63,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.54,0:01:13.43,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.43,0:01:19.88,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.88,0:01:26.82,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.58,0:01:56.33,Default,,0000,0000,0000,,بعد خطّة ران في إعادة أبيها وأمّها\N،لبعضهما بشكلٍ ما
Dialogue: 0,0:01:56.63,0:01:59.09,Default,,0000,0000,0000,,أتينا لشاطئ في منتصف الصيف
Dialogue: 0,0:01:59.71,0:02:05.41,Default,,0000,0000,0000,,لكن دخلت فتاة جامعية تعرّفنا عليها هناك\Nفي حالة حرجة بعد أن عضّتها أفعى بحر
Dialogue: 0,0:02:07.04,0:02:11.76,Default,,0000,0000,0000,,!لم تكن حادثة، بل جريمة بقناع حادث
Dialogue: 0,0:02:13.90,0:02:19.99,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل غوص السكوبا \N(الجزء الثاني)
Dialogue: 0,0:02:14.88,0:02:18.92,Default,,0000,0000,0000,,جريمة قتل غوص السكوبا \N(الجزء الثاني)
Dialogue: 0,0:02:20.00,0:02:23.46,CharCard,,0000,0000,0004,,{\fad(0,0)}فندق الملكة، إيزو
Dialogue: 0,0:02:21.18,0:02:23.46,On Top,,0000,0000,0000,,ماذا؟ بطاقة تأمينها؟
Dialogue: 0,0:02:23.85,0:02:25.92,On Top,,0000,0000,0000,,نجلبها للمشفى الآن؟
Dialogue: 0,0:02:26.31,0:02:30.10,Default,,0000,0000,0000,,قال العاملون في المشفى\Nأنّ من الأفضل امتلاكها
Dialogue: 0,0:02:30.10,0:02:33.31,Default,,0000,0000,0000,,وأنا لا أشعر بارتياح لوحدي
Dialogue: 0,0:02:33.31,0:02:37.89,Default,,0000,0000,0000,,،تجلبها كيواكو معها عند السفر دوماً\Nفلا بدّ أنّها موجودة في مكان
Dialogue: 0,0:02:38.23,0:02:41.60,Default,,0000,0000,0000,,!اترك ذلك جانباً، كيف حالها؟
Dialogue: 0,0:02:42.02,0:02:45.98,Default,,0000,0000,0000,,دخلت غرفة العناية المركّزة، ولم تخرج بعد
Dialogue: 0,0:02:45.98,0:02:47.85,Default,,0000,0000,0000,,يبدو أنّ حالتها تدهورت
Dialogue: 0,0:02:47.85,0:02:53.31,Default,,0000,0000,0000,,،الأطباء يدخلون ويخرجون باستمرار\Nلكن لا أحد يخبرني بشيء
Dialogue: 0,0:02:53.31,0:02:55.41,Default,,0000,0000,0000,,هل ستموت يا ترى؟
Dialogue: 0,0:02:55.73,0:02:58.52,Default,,0000,0000,0000,,!يا أحمق! ما الذي تهذي به؟
Dialogue: 0,0:02:58.52,0:03:02.00,Default,,0000,0000,0000,,!سأجلب بطاقة تأمينها وآتي فوراً، فلتنتظرني فقط
Dialogue: 0,0:03:03.93,0:03:06.59,Default,,0000,0000,0000,,أظنّ أنّك كنتِ في نفس الغرفة مع كيواكو، أليس كذلك؟
Dialogue: 0,0:03:07.35,0:03:08.47,Default,,0000,0000,0000,,بـ-بلى
Dialogue: 0,0:03:10.31,0:03:13.48,Default,,0000,0000,0000,,كلا، ما زالت بطاقة المفتاح في الغرفة
Dialogue: 0,0:03:13.48,0:03:17.85,Default,,0000,0000,0000,,نسيتها عندما طلبت منّي كيواكو\Nالذهاب لجلب منشفة استحمام
Dialogue: 0,0:03:17.85,0:03:18.60,Default,,0000,0000,0000,,ما العمل؟
Dialogue: 0,0:03:19.31,0:03:21.81,Default,,0000,0000,0000,,تُقفل آلياً، فلا نستطيع الدخول
Dialogue: 0,0:03:22.14,0:03:23.85,Default,,0000,0000,0000,,ليس باليد حيلة
Dialogue: 0,0:03:23.85,0:03:28.18,Default,,0000,0000,0000,,سأتّصل بمكتب الاستقبال من غرفتنا\Nوأطلب منهم جلب مفتاح بديل
Dialogue: 0,0:03:30.77,0:03:35.49,Default,,0000,0000,0000,,.أجل، صحيح، الغرفة 406\Nأجل، أجل
Dialogue: 0,0:03:35.49,0:03:38.00,Default,,0000,0000,0000,,شكراً، نعتذر على الإزعاج
Dialogue: 0,0:03:40.85,0:03:42.16,Default,,0000,0000,0000,,أخبرني
Dialogue: 0,0:03:43.10,0:03:45.42,Default,,0000,0000,0000,,ما-ما الأمر يا فتى؟ لا تفزعني هكذا
Dialogue: 0,0:03:45.89,0:03:50.96,Default,,0000,0000,0000,,ذهبتم جميعاً لغوص السكوبا\Nعند الظهيرة، أليس كذلك؟
Dialogue: 0,0:03:51.39,0:03:52.14,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:03:52.14,0:03:55.31,Default,,0000,0000,0000,,هل اصطدتم شيئاً؟
Dialogue: 0,0:03:55.31,0:03:56.05,Default,,0000,0000,0000,,مثل السمك
Dialogue: 0,0:03:56.48,0:03:59.22,Default,,0000,0000,0000,,كلا، لم أصطد شيئاً هذه المرّة
Dialogue: 0,0:03:59.60,0:04:01.35,Default,,0000,0000,0000,,والبقيّة كذلك؟
Dialogue: 0,0:04:01.35,0:04:03.02,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:04:03.02,0:04:06.81,Default,,0000,0000,0000,,جميعنا معتادون على بحر هذه المنطقة، وغصنا بمفردنا
Dialogue: 0,0:04:06.81,0:04:09.23,Default,,0000,0000,0000,,فلا أعرف ما الذي فعله الآخرون بالضبط
Dialogue: 0,0:04:10.48,0:04:13.93,Default,,0000,0000,0000,,أظنّ ماساهيكو وكيواكو-تشان ارتديا\Nبذلتَي غوص متماثلتين مع ذلك
Dialogue: 0,0:04:13.93,0:04:16.20,Default,,0000,0000,0000,,وغاصا في المكان نفسه
Dialogue: 0,0:04:16.77,0:04:18.03,Default,,0000,0000,0000,,إنّهما مقرّبان كثيراً
Dialogue: 0,0:04:18.43,0:04:23.35,Default,,0000,0000,0000,,أجل، فهما بالإضافة إلى هيروشي أصدقاء طفولة
Dialogue: 0,0:04:23.35,0:04:26.83,Default,,0000,0000,0000,,يبدو أنّهم كانوا يمرحون سوياً\Nفي صغرهم دوماً
Dialogue: 0,0:04:27.60,0:04:29.17,Default,,0000,0000,0000,,كلّهم زملاء دراسة؟
Dialogue: 0,0:04:29.17,0:04:32.68,Default,,0000,0000,0000,,كلا، هيروشي وماساهيكو في نفس عمري
Dialogue: 0,0:04:32.68,0:04:36.13,Default,,0000,0000,0000,,،لكنّ كيواكو-تشان أصغر بعام\Nمثل سنّ هارومي-تشان
Dialogue: 0,0:04:39.23,0:04:44.31,Default,,0000,0000,0000,,بصراحة، كنت أنوي ترك هذا النادي\Nفي سنتي الثانية في الجامعة
Dialogue: 0,0:04:44.31,0:04:47.40,Default,,0000,0000,0000,,لكنّي غيّرت رأيي عندما انضمّت مجموعة كيواكو-تشان
Dialogue: 0,0:04:48.60,0:04:50.40,Default,,0000,0000,0000,,لعلّه كان حُبّاً من النظرة الأولى
Dialogue: 0,0:04:52.31,0:04:52.96,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:54.89,0:04:58.78,Default,,0000,0000,0000,,يا للحماقة، ما الذي أخبر هذا الصبيّ به؟
Dialogue: 0,0:05:00.02,0:05:01.20,Default,,0000,0000,0000,,انتظر
Dialogue: 0,0:05:01.98,0:05:04.12,Default,,0000,0000,0000,,...أيعني هذا أنّه
Dialogue: 0,0:05:04.81,0:05:08.18,Default,,0000,0000,0000,,أهما... أيمكن؟
Dialogue: 0,0:05:13.48,0:05:14.40,Default,,0000,0000,0000,,تفضّلوا
Dialogue: 0,0:05:14.40,0:05:15.78,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:05:15.78,0:05:16.51,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:05:23.31,0:05:24.77,Default,,0000,0000,0000,,...بطاقة التأمين، بطاقة التأمين
Dialogue: 0,0:05:24.77,0:05:26.56,Default,,0000,0000,0000,,يا إلهي، لا أمل منك
Dialogue: 0,0:05:27.33,0:05:29.44,Default,,0000,0000,0000,,تركتِها هنا
Dialogue: 0,0:05:31.81,0:05:34.31,Default,,0000,0000,0000,,هذه بطاقة مفتاحك، أليس كذلك؟
Dialogue: 0,0:05:34.31,0:05:35.40,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:05:35.77,0:05:39.91,Default,,0000,0000,0000,,أيمكنك مساعدتي؟ لا أجد بطاقة تأمين كيواكو
Dialogue: 0,0:05:41.31,0:05:43.00,Default,,0000,0000,0000,,لعلّها نسيتها وحسب
Dialogue: 0,0:05:44.81,0:05:47.12,Default,,0000,0000,0000,,إنّها داخل المنشفة في أسفل الحقيبة
Dialogue: 0,0:05:49.10,0:05:50.49,Default,,0000,0000,0000,,ابحثي فحسب
Dialogue: 0,0:05:52.14,0:05:55.02,Default,,0000,0000,0000,,...المنشفة في أسفل الحقيبة
Dialogue: 0,0:05:56.48,0:05:59.22,Default,,0000,0000,0000,,ها-ها هي! كيف عرفت؟
Dialogue: 0,0:06:00.02,0:06:03.36,Default,,0000,0000,0000,,علّمتني جدّتي هذا في صغري، وعلّمتهما
Dialogue: 0,0:06:05.14,0:06:07.93,Default,,0000,0000,0000,,!كما يُتوقع من أصدقاء الطفولة
Dialogue: 0,0:06:07.93,0:06:10.81,Default,,0000,0000,0000,,لستُ الوحيد، يعرف ماساهيكو الأمر أيضاً
Dialogue: 0,0:06:14.39,0:06:17.35,Default,,0000,0000,0000,,اسمع أيّها المتحرّي، لديك سيارة، أليس كذلك؟
Dialogue: 0,0:06:17.35,0:06:19.52,Default,,0000,0000,0000,,أجل، إنّها مُستأجرة
Dialogue: 0,0:06:19.52,0:06:24.27,Default,,0000,0000,0000,,هلّا أخذتنا نحن الثلاثة إلى المشفى إذاً؟
Dialogue: 0,0:06:24.27,0:06:25.91,Default,,0000,0000,0000,,نعم، لا أمانع
Dialogue: 0,0:06:26.77,0:06:29.14,Default,,0000,0000,0000,,!دعني أرافقكم إذاً
Dialogue: 0,0:06:29.14,0:06:31.93,Default,,0000,0000,0000,,...فأنا أشعر بالقلق على كيواكو-سان
Dialogue: 0,0:06:31.93,0:06:35.77,Default,,0000,0000,0000,,حمقاء، لن يتّسع خمسة أشخاص\Nفي تلك السيّارة الصغيرة
Dialogue: 0,0:06:35.77,0:06:37.21,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:06:37.64,0:06:41.43,Default,,0000,0000,0000,,لا بأس، سآخذ ران بسيّارتي
Dialogue: 0,0:06:43.10,0:06:45.40,Default,,0000,0000,0000,,لمَ جلبتِ أمتعتك يا أمّي؟
Dialogue: 0,0:06:46.98,0:06:51.85,Default,,0000,0000,0000,,ماذا؟ ألم تستنتجي؟ سأرجع للمنزل بعدما أنزلك
Dialogue: 0,0:06:51.85,0:06:53.56,Default,,0000,0000,0000,,!مهلك يا أمّي
Dialogue: 0,0:06:53.56,0:06:56.44,Default,,0000,0000,0000,,لا أريد التواجد في نفس الحيّز\Nمع هذا البليد بعد الآن
Dialogue: 0,0:06:57.68,0:06:59.31,Default,,0000,0000,0000,,اسمعي يا إيري
Dialogue: 0,0:06:59.31,0:07:00.64,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:00.64,0:07:02.03,Default,,0000,0000,0000,,أريد الكلام معك لاحقاً
Dialogue: 0,0:07:02.48,0:07:06.45,Default,,0000,0000,0000,,ماذا؟ عن ماذا يا ترى؟\Nأتطلّع للمعرفة
Dialogue: 0,0:07:07.56,0:07:08.69,Default,,0000,0000,0000,,!مهلكما
Dialogue: 0,0:07:16.43,0:07:18.68,Default,,0000,0000,0000,,!أنتِ تسرعين كثيراً يا أمّي
Dialogue: 0,0:07:18.68,0:07:23.89,Default,,0000,0000,0000,,يا إلهي، لا داعي لتستائي هكذا\Nلأنّه لم يلحظ خاتمك فحسب
Dialogue: 0,0:07:24.43,0:07:27.10,Default,,0000,0000,0000,,ليس الخاتم، بل الحادثة
Dialogue: 0,0:07:27.10,0:07:28.64,Default,,0000,0000,0000,,الحادثة؟
Dialogue: 0,0:07:28.64,0:07:34.68,Default,,0000,0000,0000,,هناك أجزاء ناقصة، لكنّ هذه جريمة قتل بكلّ وضوح
Dialogue: 0,0:07:34.68,0:07:35.56,Default,,0000,0000,0000,,جريمة قتل؟
Dialogue: 0,0:07:37.10,0:07:39.86,Default,,0000,0000,0000,,وأنا غاضبةٌ منه لأنّه لم يدرك الأمر
Dialogue: 0,0:07:40.47,0:07:46.72,Default,,0000,0000,0000,,،صحيح... إنّها جريمة قتل\Nولديّ فكرة عن هويّة الفاعل
Dialogue: 0,0:07:46.72,0:07:49.05,Default,,0000,0000,0000,,هنالك نقطة واحدة فحسب لا أفهمها
Dialogue: 0,0:07:49.57,0:07:53.88,Default,,0000,0000,0000,,لمَ قام ذاك الشخص بذاك الشيء آنذاك؟
Dialogue: 0,0:07:53.88,0:07:56.00,Default,,0000,0000,0000,,ما قد يكون يا ترى؟
Dialogue: 0,0:07:56.76,0:07:58.00,Default,,0000,0000,0000,,تقصدين الحادثة؟
Dialogue: 0,0:07:58.00,0:08:01.18,Default,,0000,0000,0000,,كلا، ما يريد إخباري به
Dialogue: 0,0:08:01.18,0:08:03.51,Default,,0000,0000,0000,,فقد قال أنّه يريد الكلام معي لاحقاً
Dialogue: 0,0:08:04.84,0:08:10.18,Default,,0000,0000,0000,,...الطلاق... حقّ وصايتك... أم
Dialogue: 0,0:08:11.38,0:08:12.93,Default,,0000,0000,0000,,أمّي؟
Dialogue: 0,0:08:13.76,0:08:19.11,Default,,0000,0000,0000,,لعلّ لا شيء هناك وحسب، إنّه يختبرني فقط
Dialogue: 0,0:08:21.13,0:08:21.94,Default,,0000,0000,0000,,!يختبر؟
Dialogue: 0,0:08:22.26,0:08:23.51,Default,,0000,0000,0000,,الأمر هكذا دوماً
Dialogue: 0,0:08:23.51,0:08:27.34,Default,,0000,0000,0000,,يجعلني أنفعل، ثم يراقب ارتباكي
Dialogue: 0,0:08:27.34,0:08:28.91,Default,,0000,0000,0000,,يا لغطرسته
Dialogue: 0,0:08:29.73,0:08:32.83,Default,,0000,0000,0000,,فهمت، هكذا الأمر إذاً
Dialogue: 0,0:08:33.57,0:08:37.79,Default,,0000,0000,0000,,ران، أنا آسفة... لكن يبدو أنّي لم أعد أحتمل
Dialogue: 0,0:08:38.63,0:08:40.50,Default,,0000,0000,0000,,أمّي
Dialogue: 0,0:08:44.83,0:08:49.51,Default,,0000,0000,0000,,!لا شكّ في الأمر، الفاعل... هو ذاك الشخص
Dialogue: 0,0:08:55.12,0:08:58.10,CharCard,,0000,0000,0004,,{\fad(200,0)}مشفى إيزو الغربيّ
Dialogue: 0,0:08:56.02,0:08:58.03,On Top,,0000,0000,0000,,!ماساهيكو! جلبتها معي
Dialogue: 0,0:08:58.03,0:08:59.42,On Top,,0000,0000,0000,,!بطاقة تأمين كيواكو
Dialogue: 0,0:08:59.99,0:09:01.39,Default,,0000,0000,0000,,رفاق
Dialogue: 0,0:09:01.39,0:09:03.53,Default,,0000,0000,0000,,إذاً، كيف حالها؟
Dialogue: 0,0:09:03.53,0:09:05.27,Default,,0000,0000,0000,,كيف هي يا أخي؟
Dialogue: 0,0:09:05.27,0:09:09.96,Default,,0000,0000,0000,,لا أدري، لا تزال في غرفة العناية المركّزة
Dialogue: 0,0:09:10.39,0:09:13.09,Default,,0000,0000,0000,,أخبريني عن حالها بعدما تعرفين
Dialogue: 0,0:09:13.73,0:09:18.51,Default,,0000,0000,0000,,ستغادرين يا أمّي؟ لكن ألم يخبرك أبي\Nأنّه يريد الكلام معك؟
Dialogue: 0,0:09:19.10,0:09:24.39,Default,,0000,0000,0000,,الكلام؟ أتظنّين أنّي بحاجة للاستماع\Nلحديث زير النساء هذا؟
Dialogue: 0,0:09:24.39,0:09:28.10,Default,,0000,0000,0000,,حقّاً ذلك؟ أنتنّ معجبات لي؟
Dialogue: 0,0:09:28.10,0:09:29.85,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:09:29.85,0:09:34.52,Default,,0000,0000,0000,,لا أمل منه، ربما عليّ مساعدته
Dialogue: 0,0:09:35.02,0:09:36.37,Default,,0000,0000,0000,,حضرة الممرضة
Dialogue: 0,0:09:36.37,0:09:36.98,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:09:36.98,0:09:39.36,Default,,0000,0000,0000,,لديّ طلب صغير
Dialogue: 0,0:09:40.23,0:09:44.58,Default,,0000,0000,0000,,!انتظري يا أمّي! ليس الأمر بيده، فأبي مشهور
Dialogue: 0,0:09:44.89,0:09:50.41,Default,,0000,0000,0000,,سئمت من برودة ذلك الرجل\Nالذي يتبسّم في أوقات كهذه
Dialogue: 0,0:09:51.10,0:09:52.88,Default,,0000,0000,0000,,...لكنّ ذلك بسبب
Dialogue: 0,0:09:54.06,0:10:03.73,Default,,0000,0000,0000,,،نداء لـ كيساكي إيري-ساما المقيمة في فندق الملكة\Nولـ ماتسوزاكي هاروما-ساما المقيم في الفندق نفسه
Dialogue: 0,0:10:03.73,0:10:05.97,Default,,0000,0000,0000,,تعالا لمكتب مدير المشفى من فضلكما
Dialogue: 0,0:10:07.14,0:10:09.31,Default,,0000,0000,0000,,موري كوغورو-ساما بانتظاركما
Dialogue: 0,0:10:07.56,0:10:08.57,On Top,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:10:10.39,0:10:11.27,Default,,0000,0000,0000,,أنا؟
Dialogue: 0,0:10:18.48,0:10:19.80,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:10:22.02,0:10:22.91,Default,,0000,0000,0000,,!يا ولد
Dialogue: 0,0:10:23.35,0:10:25.74,Default,,0000,0000,0000,,!آسف! سأرجعه سريعاً
Dialogue: 0,0:10:28.45,0:10:32.17,On Top,,0000,0000,0000,,مكتب المدير
Dialogue: 0,0:10:28.81,0:10:32.17,Default,,0000,0000,0000,,!ما الذي تنويه باستدعائي هكذا؟
Dialogue: 0,0:10:32.56,0:10:35.93,Default,,0000,0000,0000,,!إذا لديك ما تخبرني به، فانطق فوراً
Dialogue: 0,0:10:35.93,0:10:37.48,Default,,0000,0000,0000,,...أمّي
Dialogue: 0,0:10:37.48,0:10:38.88,Default,,0000,0000,0000,,!مخيفة
Dialogue: 0,0:10:39.20,0:10:42.52,Default,,0000,0000,0000,,المعذرة، يمكنني العودة لاحقاً\Nإذا كنت أضايقكما
Dialogue: 0,0:10:42.52,0:10:44.77,Default,,0000,0000,0000,,أنا قلقة على كيواكو أيضاً
Dialogue: 0,0:10:44.77,0:10:47.23,Default,,0000,0000,0000,,أنتِ قلقة عليها بالفعل إذاً؟
Dialogue: 0,0:10:48.00,0:10:49.60,Default,,0000,0000,0000,,لا عجب
Dialogue: 0,0:10:49.60,0:10:54.27,Default,,0000,0000,0000,,،فالميزان يتأرجح بين كونها جريمة قتل\Nومحاولة الإقدام على جريمة قتل
Dialogue: 0,0:10:55.23,0:10:57.98,Default,,0000,0000,0000,,أجل، لم تكن حادثة
Dialogue: 0,0:10:58.31,0:11:02.77,Default,,0000,0000,0000,,كانت جريمةً بسابق الإصرار والترصّد للقتل
Dialogue: 0,0:11:02.77,0:11:07.99,Default,,0000,0000,0000,,تعرّضت كيواكو-سان للعضّ المتعمّد \Nمن الأفعى التي كان يحملها الفاعل
Dialogue: 0,0:11:08.35,0:11:10.95,Default,,0000,0000,0000,,!ماتسوزاكي هارومي-سان... كانت أنت
Dialogue: 0,0:11:13.27,0:11:14.33,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:11:14.33,0:11:15.88,Default,,0000,0000,0000,,آثار الأنياب
Dialogue: 0,0:11:15.88,0:11:17.39,Default,,0000,0000,0000,,آثار الأنياب؟
Dialogue: 0,0:11:17.39,0:11:20.31,Default,,0000,0000,0000,,رؤوس أفاعي البحر صغيرة
Dialogue: 0,0:11:20.31,0:11:24.76,Default,,0000,0000,0000,,إذا عضّت بشرياً، فستكون منطقة صغيرة\Nمثل أطراف الأصابع
Dialogue: 0,0:11:25.14,0:11:28.81,Default,,0000,0000,0000,,مع ذلك، آثار الأنياب على كيواكو-سان\Nكانت على كفّها
Dialogue: 0,0:11:28.81,0:11:31.72,Default,,0000,0000,0000,,حيث لا تستطيع أفعى البحر عضّها هناك
Dialogue: 0,0:11:31.72,0:11:37.89,Default,,0000,0000,0000,,عندما هرعت لنجدة كيواكو-سان، أمسكت برأس\Nأفعى البحر التي كانت تخفيها
Dialogue: 0,0:11:37.89,0:11:42.49,Default,,0000,0000,0000,,أجبرتها على فتح فمها، وجعلتها تعضّها\Nكما لو أنّها قامت بمهاجمتها
Dialogue: 0,0:11:42.49,0:11:45.07,Default,,0000,0000,0000,,ألستُ محقّاً يا هارومي-سان؟
Dialogue: 0,0:11:45.89,0:11:51.23,Default,,0000,0000,0000,,فهمت، تظاهرت بالسذاجة، لكنّك كشفت ما حصل
Dialogue: 0,0:11:51.23,0:11:54.10,Default,,0000,0000,0000,,فلتخبرنا حضرة المتحرّي إذاً
Dialogue: 0,0:11:54.10,0:11:57.04,Default,,0000,0000,0000,,ما هو أساس ادّعائك بأنّها الفاعلة؟
Dialogue: 0,0:11:57.56,0:12:01.09,Default,,0000,0000,0000,,ألم يكن بمقدور الآخرين\Nارتكاب الجريمة آنذاك أيضاً؟
Dialogue: 0,0:12:01.38,0:12:05.80,Default,,0000,0000,0000,,كما أنّ اندفاعهم لنجدتها حصل صدفةً بعدما غرقت
Dialogue: 0,0:12:06.06,0:12:09.97,Default,,0000,0000,0000,,وماذا إذا لم يكن ذلك صدفة؟
Dialogue: 0,0:12:09.97,0:12:13.43,Default,,0000,0000,0000,,ماذا لو غرقت كيواكو-سان عمداً؟
Dialogue: 0,0:12:13.73,0:12:16.68,Default,,0000,0000,0000,,عمداً؟ لمَ؟
Dialogue: 0,0:12:16.68,0:12:21.10,Default,,0000,0000,0000,,من الطبيعيّ للرجال والنساء أن يريدوا\Nمعرفة ما بأعماق البعض
Dialogue: 0,0:12:21.10,0:12:25.85,Default,,0000,0000,0000,,لإثارة الطرف الآخر، قد تتعمّد للتقرّب من شخص آخر
Dialogue: 0,0:12:25.85,0:12:29.16,Default,,0000,0000,0000,,أو تتعمّد نزع خاتم زواجك
Dialogue: 0,0:12:29.56,0:12:32.12,Default,,0000,0000,0000,,...أتقصد أنّ كيواكو-سان
Dialogue: 0,0:12:32.12,0:12:33.60,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:33.60,0:12:39.48,Default,,0000,0000,0000,,تظاهرت كيواكو-سان بالغرق\Nكي تختبر خطيبها ماساهيكو-سان
Dialogue: 0,0:12:39.48,0:12:44.21,Default,,0000,0000,0000,,لترى إذا ما سيهبّ من لا يجيد السباحة لنجدتها
Dialogue: 0,0:12:44.71,0:12:48.39,Default,,0000,0000,0000,,ودليلاً على ذلك، تمتمت كيواكو-سان بما يلي بعدما تأكّدت
Dialogue: 0,0:12:48.68,0:12:52.44,Default,,0000,0000,0000,,:من قدوم ماساهيكو-سان رفقة من أتوا لإنقاذها
Dialogue: 0,0:12:52.44,0:12:54.32,Default,,0000,0000,0000,,"حمداً لله"
Dialogue: 0,0:12:54.51,0:13:00.57,Default,,0000,0000,0000,,لكنّهما سيتزوّجان الأسبوع القادم، فلمَ تفعل ذلك الآن؟
Dialogue: 0,0:13:00.57,0:13:03.86,Default,,0000,0000,0000,,أرادت أن تتأكّد أكثر
Dialogue: 0,0:13:03.86,0:13:08.04,Default,,0000,0000,0000,,كانت ممتعضةً من خطيبها الذي\Nلم يبادر لتوبيخها
Dialogue: 0,0:13:08.36,0:13:10.50,Default,,0000,0000,0000,,رغم انفتانها بهذا الشخص المشهور
Dialogue: 0,0:13:11.03,0:13:16.71,Default,,0000,0000,0000,,وأقدمت على خطّة التظاهر بالغرق\Nالتي اتّفقتا عليها سلفاً
Dialogue: 0,0:13:17.11,0:13:18.65,Default,,0000,0000,0000,,ماذا؟ اتّفقتا؟
Dialogue: 0,0:13:18.65,0:13:20.17,Default,,0000,0000,0000,,أجل، الاثنتان
Dialogue: 0,0:13:20.94,0:13:27.60,Default,,0000,0000,0000,,لتنجح هذه الخطّة، يجب أن يكون هناك\Nمن يخبر ماساهيكو-سان بغرقها فوراً
Dialogue: 0,0:13:27.98,0:13:34.65,Default,,0000,0000,0000,,سيكون من المعيب لو أنقذها أحد\Nآخر على الشاطئ قبل أن ينتبه هو
Dialogue: 0,0:13:34.65,0:13:39.11,Default,,0000,0000,0000,,وذاك الشخص الآخر كان أنت يا هارومي-سان
Dialogue: 0,0:13:40.48,0:13:44.57,Default,,0000,0000,0000,,:إشارة بدء الخطّة كانت قولها لك
Dialogue: 0,0:13:44.57,0:13:47.99,Default,,0000,0000,0000,,أيمكنك جلب منشفة استحمام جديدة من غرفتنا؟
Dialogue: 0,0:13:48.90,0:13:51.12,Default,,0000,0000,0000,,...وفقما أظنّ، وبعدها
Dialogue: 0,0:13:51.41,0:13:53.79,Default,,0000,0000,0000,,!إلى اللقاء يا هارومي! أعتمد عليك
Dialogue: 0,0:13:54.69,0:13:58.67,Default,,0000,0000,0000,,،قالت كيواكو-سان ذلك\Nهذا ما حصل غالباً
Dialogue: 0,0:13:58.98,0:14:03.55,Default,,0000,0000,0000,,لكن حاولت هارومي-سان منعها\Nمن دخول البحر آنذاك
Dialogue: 0,0:14:04.11,0:14:08.51,Default,,0000,0000,0000,,كما كيف تقدم على ذلك أمام متحرٍّ شهير؟
Dialogue: 0,0:14:08.78,0:14:12.43,Default,,0000,0000,0000,,لذا حاولتْ منعها، فقد كنتُ أشاهد
Dialogue: 0,0:14:12.86,0:14:16.77,Default,,0000,0000,0000,,ليس عليكِ فعلها اليوم، ألا تؤجلينها للغد؟
Dialogue: 0,0:14:16.77,0:14:18.77,Default,,0000,0000,0000,,!سأكون بخير
Dialogue: 0,0:14:18.77,0:14:23.23,Default,,0000,0000,0000,,لكن مضت كيواكو-سان بالخطّة دون مراعاة
Dialogue: 0,0:14:23.23,0:14:28.98,Default,,0000,0000,0000,,في جهلها أنّ هيرومي-سان كانت تحيك\Nخطّة شرّيرة أخرى
Dialogue: 0,0:14:28.98,0:14:31.20,Default,,0000,0000,0000,,...لا-لا يمكن
Dialogue: 0,0:14:31.20,0:14:34.69,Default,,0000,0000,0000,,،بعد عودتها للغرفة لجلب منشفة الاستحمام
Dialogue: 0,0:14:34.69,0:14:38.03,Default,,0000,0000,0000,,وضعت أفعى البحر التي كانت\Nتخبّئها في حقيبة خصرها
Dialogue: 0,0:14:38.03,0:14:42.01,Default,,0000,0000,0000,,ورجعت للمطعم الشاطئيّ
Dialogue: 0,0:14:42.01,0:14:49.09,Default,,0000,0000,0000,,ثمّ، أرسلت الإشارة لـ كيواكو-سان بعدما\Nترقّبت الوقت المناسب لتتظاهر بالغرق
Dialogue: 0,0:14:49.09,0:14:51.69,Default,,0000,0000,0000,,وعندما هرعت إليها مع البقيّة
Dialogue: 0,0:14:51.69,0:14:57.12,Default,,0000,0000,0000,,أخرجت أفعى البحر التي كانت تخفيها\Nوجعلتها تعضّ كيواكو-سان
Dialogue: 0,0:14:58.61,0:15:01.69,Default,,0000,0000,0000,,لكن ما الذي تنوي فعله يا حضرة المتحرّي؟
Dialogue: 0,0:15:01.69,0:15:06.70,Default,,0000,0000,0000,,فلا بدّ أنّ سلاح الجريمة يسبح بحريّة\Nفي المحيط الهادئ الآن
Dialogue: 0,0:15:07.11,0:15:11.19,Default,,0000,0000,0000,,باختفاء السلاح، فلن تثبت التهمة في المحاكمة
Dialogue: 0,0:15:11.19,0:15:16.71,Default,,0000,0000,0000,,أخبرتكم، وضعت أفعى البحر في حقيبة خصرها
Dialogue: 0,0:15:16.71,0:15:21.40,Default,,0000,0000,0000,,،كما، سواءً كان الدافع هو الثقة، أم الارتباك
Dialogue: 0,0:15:21.40,0:15:24.40,Default,,0000,0000,0000,,فهي لم تفارقنا منذ الحادثة
Dialogue: 0,0:15:24.40,0:15:29.03,Default,,0000,0000,0000,,لا بدّ أنّه سيكون موجوداً في حقيبة خصرها
Dialogue: 0,0:15:29.03,0:15:33.18,Default,,0000,0000,0000,,الشريط اللاصق بحراشف أفعى البحر المخطّطة\Nالسوداء السامة
Dialogue: 0,0:15:33.61,0:15:34.40,Default,,0000,0000,0000,,الشريط؟
Dialogue: 0,0:15:34.40,0:15:35.44,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:15:35.44,0:15:40.36,Default,,0000,0000,0000,,مجرّد إقحام الأفعى سيجعل إخراجها\Nيستغرق وقتاً، وأمراً ملفتاً للأنظار
Dialogue: 0,0:15:40.86,0:15:43.32,Default,,0000,0000,0000,,وهناك احتمال عضّها لأصابعها\Nإذا لم تتوخّ الحذر
Dialogue: 0,0:15:43.86,0:15:50.11,Default,,0000,0000,0000,,فقامت بلصق أفعى البحر في عدّة\Nمواضع في حقيبة خصرها غالباً
Dialogue: 0,0:15:50.11,0:15:53.48,Default,,0000,0000,0000,,وتركت رأسها فحسب بارزاً للخارج
Dialogue: 0,0:15:53.48,0:15:58.25,Default,,0000,0000,0000,,هكذا يمكنها الإمساك به\Nوجعلها تعضّ فورياً
Dialogue: 0,0:15:58.69,0:16:02.96,Default,,0000,0000,0000,,إذاً... الشيء الشبيه بالأجنحة\N...الذي رأيتُه على أفعى البحر
Dialogue: 0,0:16:02.96,0:16:05.44,Default,,0000,0000,0000,,كان جزءاً من الشريط غالباً
Dialogue: 0,0:16:05.44,0:16:09.68,Default,,0000,0000,0000,,وبقيّة الشريط لا تزال في حقيبة\Nخصرها على الأرجح
Dialogue: 0,0:16:10.03,0:16:12.01,Default,,0000,0000,0000,,في حقيبتها؟
Dialogue: 0,0:16:12.01,0:16:16.07,Default,,0000,0000,0000,,لكن لا نستطيع الجزم بعد\N...بأنّها أدخلت الأفعى في حقيبة
Dialogue: 0,0:16:16.07,0:16:18.89,Default,,0000,0000,0000,,بل نستطيع، بسبب بطاقة مفتاحها
Dialogue: 0,0:16:20.15,0:16:23.86,Default,,0000,0000,0000,,عندما رأيتُ علبة تجميلها ومحفظتها
Dialogue: 0,0:16:23.86,0:16:27.53,Default,,0000,0000,0000,,فوق بطاقة المفتاح التي تركتها\Nفي الغرفة، أدركتُ شيئاً
Dialogue: 0,0:16:27.53,0:16:31.99,Default,,0000,0000,0000,,لعلّها فرّغت حقيبتها، ووضعت شيئاً آخر بالداخل
Dialogue: 0,0:16:32.53,0:16:37.45,Default,,0000,0000,0000,,لكن لمَ قد تقدم على أذيّة كيواكو-سان؟\Nإنّها خطيبة أخيها، فلمَ؟
Dialogue: 0,0:16:37.75,0:16:41.33,Default,,0000,0000,0000,,...هذا مجرّد تخمين
Dialogue: 0,0:16:41.33,0:16:46.72,Default,,0000,0000,0000,,لكن أتساءل لو كانت هارومي-سان\Nمعجبةً بـ ماساهيكو-سان؟
Dialogue: 0,0:16:48.06,0:16:51.52,Default,,0000,0000,0000,,كلا... بل أكثر من ذلك، واقعة في حبّه
Dialogue: 0,0:16:52.37,0:16:56.61,Default,,0000,0000,0000,,ما الذي تقوله يا أبي؟! هارومي-سان\N!وماساهيكو-سان شقيقان
Dialogue: 0,0:16:56.77,0:17:00.12,Default,,0000,0000,0000,,كلا، ليسا كذلك على الأرجح
Dialogue: 0,0:17:00.12,0:17:07.03,Default,,0000,0000,0000,,لو كان الأمر صحيحاً، فيُفترض أنّ مجموعة\Nأصدقاء الطفولة كانت من 4 أفراد
Dialogue: 0,0:17:07.66,0:17:11.04,Default,,0000,0000,0000,,وخصوصاً أنّها بنفس سنّ كيواكو-سان
Dialogue: 0,0:17:11.37,0:17:15.37,Default,,0000,0000,0000,,أي أيمكن أنّهما أخوان غير شقيقين\Nمن زواج والديهما الثاني؟
Dialogue: 0,0:17:15.37,0:17:17.21,Default,,0000,0000,0000,,نعم، غالباً
Dialogue: 0,0:17:17.45,0:17:22.17,Default,,0000,0000,0000,,من إضافة هيروشي-سان لـ "سان" عند مناداتها\Nرغم أنّها تصغره سنّاً
Dialogue: 0,0:17:22.83,0:17:26.28,Default,,0000,0000,0000,,فالأمر حصل عندما كانا في الجامعة على الأرجح
Dialogue: 0,0:17:26.28,0:17:29.26,Default,,0000,0000,0000,,ليس في الجامعة، بل سنتي الثانية في الثانويّة
Dialogue: 0,0:17:29.70,0:17:34.23,Default,,0000,0000,0000,,تزوّجت أمّي ثانيةً، والتقيتُ ماساهيكو-سان \Nوقتها لأوّل مرّة
Dialogue: 0,0:17:35.24,0:17:40.58,Default,,0000,0000,0000,,ليس أهلاً للمسؤولية نوعاً ما، لكنّه كان \Nلطيفاً جدّاً، وانجذبت له تدريجياً
Dialogue: 0,0:17:40.58,0:17:44.16,Default,,0000,0000,0000,,فلم يكن هناك أشخاص مثله حولي
Dialogue: 0,0:17:44.16,0:17:47.66,Default,,0000,0000,0000,,لكن كانت كيواكو-سان بجواره دوماً
Dialogue: 0,0:17:48.37,0:17:54.70,Default,,0000,0000,0000,,كلّما تكلّمتْ عن طفولته، شعرت بالحزن والغيض
Dialogue: 0,0:17:54.70,0:17:59.63,Default,,0000,0000,0000,,"بدت كأنّها تقول: "أنتِ لا تعرفين شيئاً عنه
Dialogue: 0,0:18:00.58,0:18:05.59,Default,,0000,0000,0000,,كان خياري الوحيد إخفاء مشاعري ومناداته بأخي
Dialogue: 0,0:18:06.78,0:18:11.60,Default,,0000,0000,0000,,كانت خطبتهما المفاجئة وزواجهما صدمةً كبيرة
Dialogue: 0,0:18:11.91,0:18:17.16,Default,,0000,0000,0000,,وفوق ذلك، اقترحت تلك الفكرة لي\Nوهي تعرف مشاعري
Dialogue: 0,0:18:17.16,0:18:19.52,Default,,0000,0000,0000,,كما لو كانت تسخر منّي
Dialogue: 0,0:18:20.24,0:18:21.66,Default,,0000,0000,0000,,تتظاهرين بالغرق؟
Dialogue: 0,0:18:21.66,0:18:24.24,Default,,0000,0000,0000,,من فضلك، ساعديني
Dialogue: 0,0:18:24.66,0:18:26.99,Default,,0000,0000,0000,,ثمّ فكّرتِ بخطّة أفعى البحر؟
Dialogue: 0,0:18:26.99,0:18:28.16,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:18:28.70,0:18:34.03,Default,,0000,0000,0000,,...لم أرد أن أسلّم ماساهيكو-سان لها! لذا
Dialogue: 0,0:18:34.03,0:18:35.04,Default,,0000,0000,0000,,...لذا
Dialogue: 0,0:18:36.49,0:18:43.01,Default,,0000,0000,0000,,.يا لحماقتي، إنّه حُب من طرف واحد\Nفعل ذلك سيُحزن ماساهيكو-سان لا أكثر
Dialogue: 0,0:18:44.49,0:18:47.28,Default,,0000,0000,0000,,أنا حمقاء بالفعل
Dialogue: 0,0:18:52.33,0:18:54.93,Default,,0000,0000,0000,,أنتم أصدقاء تودا كيواكو-سان، صحيح؟
Dialogue: 0,0:18:57.70,0:19:00.81,Default,,0000,0000,0000,,!تمكّنا من إعطائها الترياق في الوقت
Dialogue: 0,0:19:01.28,0:19:03.91,Default,,0000,0000,0000,,ستكون بخيرٍ بعد تنويمها هنا لبضعة أيام
Dialogue: 0,0:19:03.91,0:19:06.28,Default,,0000,0000,0000,,هذا بفضل إسعافكم الطارئ
Dialogue: 0,0:19:06.28,0:19:07.62,Default,,0000,0000,0000,,لم يكن شيئاً
Dialogue: 0,0:19:07.62,0:19:09.78,Default,,0000,0000,0000,,أليس هذا رائعاً يا كيواكو؟
Dialogue: 0,0:19:09.78,0:19:11.62,Default,,0000,0000,0000,,أ-أين هارومي؟
Dialogue: 0,0:19:11.62,0:19:13.41,Default,,0000,0000,0000,,!إنّها هنا، هارومي
Dialogue: 0,0:19:22.12,0:19:25.26,Default,,0000,0000,0000,,هيّا، لمَ الخجل؟
Dialogue: 0,0:19:26.83,0:19:27.80,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:19:29.53,0:19:35.08,Default,,0000,0000,0000,,لم أعرف مشاعرك
Dialogue: 0,0:19:35.08,0:19:41.77,Default,,0000,0000,0000,,لم تكن لديّ أيّ فكرة حتّى رأيت\Nملامحك الجادة عندما هرعتِ لي
Dialogue: 0,0:19:42.91,0:19:44.48,Default,,0000,0000,0000,,...كيواكو
Dialogue: 0,0:19:45.08,0:19:51.49,Default,,0000,0000,0000,,...مع ذلك، طلبتُ منكِ ذلك\Nأنا آسفة حقّاً، أنا نادمة
Dialogue: 0,0:19:51.49,0:19:54.99,Default,,0000,0000,0000,,...ما الذي تقولينه؟! كنتُ من
Dialogue: 0,0:19:54.99,0:19:56.67,Default,,0000,0000,0000,,...حاولت
Dialogue: 0,0:19:57.48,0:19:59.41,Default,,0000,0000,0000,,...حاولت
Dialogue: 0,0:19:59.66,0:20:02.37,Default,,0000,0000,0000,,ما-ما الأمر؟ أحصل شيءٌ ما؟
Dialogue: 0,0:20:04.08,0:20:06.55,Default,,0000,0000,0000,,لا شيء
Dialogue: 0,0:20:06.55,0:20:12.16,Default,,0000,0000,0000,,عُوقبت لمحاولتي اختبار قلب امرئ آخر
Dialogue: 0,0:20:12.16,0:20:15.03,Default,,0000,0000,0000,,لذا عضّتني أفعى البحر
Dialogue: 0,0:20:17.20,0:20:19.35,Default,,0000,0000,0000,,ذلك ما بالأمر
Dialogue: 0,0:21:49.96,0:21:52.82,Default,,0000,0000,0000,,كان استنتاجك مذهلاً كالعادة يا أبي
Dialogue: 0,0:21:53.85,0:21:57.12,Default,,0000,0000,0000,,لا أتذكّر شيئاً منه البتّة أحياناً
Dialogue: 0,0:21:57.75,0:22:01.34,Default,,0000,0000,0000,,كما يبدو أنّك لاحظت ما قامت به أمّي
Dialogue: 0,0:22:01.34,0:22:06.47,Default,,0000,0000,0000,,!ماذا؟ لاحظت، لكنّك تظاهرت بالجهل\Nهذا يزيد الطين بلّة
Dialogue: 0,0:22:06.47,0:22:07.97,Default,,0000,0000,0000,,!أمّي
Dialogue: 0,0:22:07.97,0:22:09.47,Default,,0000,0000,0000,,ما الذي تتكلّم عنه؟
Dialogue: 0,0:22:09.47,0:22:11.83,Default,,0000,0000,0000,,!تتظاهر بالحماقة مُجدداً
Dialogue: 0,0:22:11.85,0:22:13.67,Default,,0000,0000,0000,,!تقصد الخاتم
Dialogue: 0,0:22:13.67,0:22:14.68,Default,,0000,0000,0000,,الخاتم؟
Dialogue: 0,0:22:15.60,0:22:16.31,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:22:18.72,0:22:20.40,Default,,0000,0000,0000,,تقصدين هذا؟
Dialogue: 0,0:22:22.18,0:22:23.27,Default,,0000,0000,0000,,محال
Dialogue: 0,0:22:23.93,0:22:28.99,Default,,0000,0000,0000,,وجدته أسفل مظلّة الشاطئ\Nالتي كنتِ تجلسين تحتها
Dialogue: 0,0:22:29.43,0:22:33.95,Default,,0000,0000,0000,,كيف عرفت أنّي فقدت خاتمي هناك؟
Dialogue: 0,0:22:34.18,0:22:40.84,Default,,0000,0000,0000,,حمقاء، لا يجفّف أحد شعره وهو يرتدي نظّارات
Dialogue: 0,0:22:40.84,0:22:44.25,Default,,0000,0000,0000,,كان ذلك برهاناً على بحثك عن شيء
Dialogue: 0,0:22:44.68,0:22:50.47,Default,,0000,0000,0000,,ما يفقده الناس على الشاطئ هو العدسات\Nاللاصقة وأقراط الأذن والخواتم وما شابه
Dialogue: 0,0:22:51.71,0:22:56.01,Default,,0000,0000,0000,,الرمل على ركبتيك كان لأنّك\Nتبحث عن الخاتم إذاً؟
Dialogue: 0,0:22:56.01,0:22:59.44,Default,,0000,0000,0000,,فهمت، ما أردت الكلام عنه معها كان الخاتم
Dialogue: 0,0:22:59.74,0:23:02.80,Default,,0000,0000,0000,,لاحظ العمّ بالفعل إذاً
Dialogue: 0,0:23:02.80,0:23:06.40,Default,,0000,0000,0000,,يا إلهي، ليت حدّة ذهنه هذه تلازمه
Dialogue: 0,0:23:07.13,0:23:10.01,Default,,0000,0000,0000,,كما جعلتِ الأمر جليّاً جدّاً
Dialogue: 0,0:23:10.01,0:23:14.38,Default,,0000,0000,0000,,،تتعمّدين شرب الشاي بيدك اليسرى\Nتهزّين يدك بتوتر
Dialogue: 0,0:23:14.38,0:23:16.22,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:23:17.51,0:23:20.12,Default,,0000,0000,0000,,!إنّه موري كوغورو-سان
Dialogue: 0,0:23:20.12,0:23:21.37,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:23:29.35,0:23:32.22,Default,,0000,0000,0000,,!أبي! لحظة، أبي
Dialogue: 0,0:23:32.22,0:23:34.76,Default,,0000,0000,0000,,!أمّي! أمّي
Dialogue: 0,0:23:35.43,0:23:37.51,Default,,0000,0000,0000,,!أمّي
Dialogue: 0,0:23:38.09,0:23:41.31,Default,,0000,0000,0000,,!حسنٌ، المرة القادمة حتماً
Dialogue: 0,0:23:41.68,0:23:44.88,Default,,0000,0000,0000,,مستحيل، لن تنجحي أبداً
Dialogue: 0,0:24:02.58,0:24:03.82,Default,,0000,0000,0000,,إنّهما متطابقان
Dialogue: 0,0:24:04.16,0:24:09.53,Default,,0000,0000,0000,,توقيع الفصول من الأوّل حتّى السادس\Nمختلف قليلاً، فلمَ يا ترى؟
Dialogue: 0,0:24:10.12,0:24:13.16,Default,,0000,0000,0000,,من الجليّ أنّه نسخ توقيعاً سابقاً
Dialogue: 0,0:24:13.16,0:24:15.20,Default,,0000,0000,0000,,ولمَ قد يفعل ذلك؟
Dialogue: 0,0:24:15.20,0:24:19.20,Default,,0000,0000,0000,,...لأنّه لم يعد يريد الكتابة
Dialogue: 0,0:24:19.20,0:24:20.35,Default,,0000,0000,0000,,أو لم يعد يستطيع؟
Dialogue: 0,0:24:20.99,0:24:25.57,Default,,0000,0000,0000,,ألا يعني ذلك أنّ شينمي سينسي\Nقد يكون ميتاً بالفعل؟
Dialogue: 0,0:24:25.57,0:24:31.57,On Top,,0000,0000,0000,,جريمة اختفاء روائيّ الغموض\N(الجزء الأوّل)
Dialogue: 0,0:24:26.41,0:24:27.87,Default,,0000,0000,0000,,الحلقة القادمة من كونان
Dialogue: 0,0:24:27.87,0:24:31.25,Default,,0000,0000,0000,,جريمة اختفاء روائيّ الغموض\N(الجزء الأوّل)
Dialogue: 0,0:24:47.32,0:24:49.50,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.50,0:24:51.59,Default,,0000,0000,0000,,نصفان في القمّة
Dialogue: 0,0:24:51.59,0:24:53.59,Default,,0000,0000,0000,,الحلقة القادمة غامضةٌ\N!عن روائيّ غموض
Dialogue: 0,0:24:53.59,0:24:55.65,Default,,0000,0000,0000,,!أكبر غموض هو غموض
Dialogue: 0,0:24:55.65,0:24:57.65,Default,,0000,0000,0000,,وما تقول

