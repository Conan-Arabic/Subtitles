Dialogue: 0,0:00:01.64,0:00:04.22,Default,,0,0,0,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:05.05,0:00:06.60,Default,,0,0,0,,!مسرح اليوم هو كرة قاعدة مدارس ثانوية
Dialogue: 0,0:00:06.93,0:00:09.01,Default,,0,0,0,,!"خطّ رفيع يفصل بين "آمن" و"خارج
Dialogue: 0,0:00:09.01,0:00:10.86,Default,,0,0,0,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.86,0:00:13.14,Default,,0,0,0,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.14,0:00:15.48,Default,,0,0,0,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:46.89,0:01:49.72,Title,,0,0,0,,{\fad(300,0)}قضيّة علم البطولة المُمزق
Dialogue: 0,0:01:46.89,0:01:49.72,Default,,0,0,0,,قضيّة علم البطولة المُمزق
Dialogue: 0,0:01:58.31,0:02:00.27,On Top,,0,0,0,,ثانويّة بيكا\Nأكاديمية شوكو
Dialogue: 0,0:02:00.27,0:02:05.18,Default,,0,0,0,,!هيّا يا بيكا! أنتم لها يا بيكا
Dialogue: 0,0:02:07.14,0:02:09.43,Default,,0,0,0,,!صوتكم منخفض
Dialogue: 0,0:02:09.43,0:02:12.47,Default,,0,0,0,,!لن يفوزوا ما لم تهتفوا بصوتٍ أعلى
Dialogue: 0,0:02:12.47,0:02:15.51,Default,,0,0,0,,!أبي! هذا ليس ككرة قاعدة المحترفين
Dialogue: 0,0:02:15.51,0:02:18.22,Default,,0,0,0,,!اضربها! أرسل تلك الكرة في الهواء
Dialogue: 0,0:02:18.57,0:02:26.35,Default,,0,0,0,,كنتُ لأفهم لو كانت ثانويّة تيتان، لكن لمَ أتى\Nلتشجيع مدرسة ابن ساقي الحانة التي يرتادها؟
Dialogue: 0,0:02:26.35,0:02:30.17,Default,,0,0,0,,كما أنّها مباراة من طرف واحد، لا معنى للتشجيع
Dialogue: 0,0:02:32.63,0:02:35.46,Default,,0,0,0,,لكنّ رامي شوكو بارع حقّاً
Dialogue: 0,0:02:40.30,0:02:41.55,Default,,0,0,0,,!رمية ثانية
Dialogue: 0,0:02:45.96,0:02:48.23,Default,,0,0,0,,!رمية ثالثة! خرج حامل المضرب
Dialogue: 0,0:02:51.66,0:02:52.71,Default,,0,0,0,,!رمية
Dialogue: 0,0:02:54.42,0:02:55.33,Default,,0,0,0,,!رمية ثانية
Dialogue: 0,0:02:58.09,0:03:00.63,Default,,0,0,0,,!رمية ثالثة! خرج حامل المضرب
Dialogue: 0,0:03:04.59,0:03:07.81,Default,,0,0,0,,!أنتَ ظريف يا كاجي-كن
Dialogue: 0,0:03:07.81,0:03:11.35,Default,,0,0,0,,في أيّ جانب أنتِ يا سونوكو؟
Dialogue: 0,0:03:11.35,0:03:14.22,Default,,0,0,0,,لكنّه ظريفٌ جدّاً
Dialogue: 0,0:03:14.22,0:03:16.22,Default,,0,0,0,,حقّاً؟ دعيني أرى
Dialogue: 0,0:03:17.81,0:03:19.18,Default,,0,0,0,,قد تكون مباراةً جيّدة
Dialogue: 0,0:03:19.18,0:03:20.81,Default,,0,0,0,,...أنت
Dialogue: 0,0:03:20.81,0:03:25.18,Default,,0,0,0,,كما أنّ أباه طبيب وهو أكثر التلامذة\N!تفوّقاً في مدرسته
Dialogue: 0,0:03:25.18,0:03:26.76,Default,,0,0,0,,!لا يمكن تفويته
Dialogue: 0,0:03:26.76,0:03:32.05,Default,,0,0,0,,أخبريني، ألم تفز أكاديمية شوكو \Nحببطولة المحافظة العام الفائت؟
Dialogue: 0,0:03:32.30,0:03:35.68,Default,,0,0,0,,بلى، إنّهم المُفضّلون للفوز\Nهذا العام أيضاً
Dialogue: 0,0:03:35.68,0:03:38.01,Default,,0,0,0,,ألا تسمع هتافهم هناك؟
Dialogue: 0,0:03:40.85,0:03:43.63,Default,,0,0,0,,لكن متى كانت شوكو بهذه القوّة؟
Dialogue: 0,0:03:44.01,0:03:46.14,Default,,0,0,0,,هذا بفضل كاجي-كن
Dialogue: 0,0:03:46.14,0:03:50.98,Default,,0,0,0,,أسّسها رجل ثريّ رفيع المقام في الماضي\Nكمعهدٍ متحفّظ
Dialogue: 0,0:03:50.98,0:03:54.55,Default,,0,0,0,,ولا يزال رئيس مجلس إدارتها للآن
Dialogue: 0,0:03:54.68,0:03:59.10,Default,,0,0,0,,لكنّ صورتها تغيّرت تماماً عندما ظهر كاجي-كن
Dialogue: 0,0:04:00.31,0:04:01.97,Default,,0,0,0,,تعرفين الكثير
Dialogue: 0,0:04:01.97,0:04:04.05,Default,,0,0,0,,!تحقّقتُ من كلّ شيءٍ عن كاجي-كن
Dialogue: 0,0:04:12.01,0:04:13.88,Default,,0,0,0,,ماذا يفعل هذان؟
Dialogue: 0,0:04:19.18,0:04:20.39,Default,,0,0,0,,شكراً حضرة الناظر
Dialogue: 0,0:04:21.88,0:04:25.93,Default,,0,0,0,,حتّى الناظر موجود للتشجيع؟ \Nأكاديمية شوكو تحمل روحاً بحقّ
Dialogue: 0,0:04:27.47,0:04:28.43,Default,,0,0,0,,!آمن
Dialogue: 0,0:04:35.47,0:04:37.51,Default,,0,0,0,,ماذا؟ اختفيا
Dialogue: 0,0:04:47.81,0:04:50.06,Default,,0,0,0,,!مخالفة حركة! الكرة الأولى
Dialogue: 0,0:04:51.88,0:04:53.18,Default,,0,0,0,,!اهدأ يا كاجي
Dialogue: 0,0:04:53.18,0:04:54.89,Default,,0,0,0,,!لا بأس
Dialogue: 0,0:05:05.68,0:05:06.80,Default,,0,0,0,,!ضربة جيّدة
Dialogue: 0,0:05:26.30,0:05:28.01,Default,,0,0,0,,...كاجي-كن
Dialogue: 0,0:05:28.01,0:05:29.81,Default,,0,0,0,,ماذا حصل فجأةً؟
Dialogue: 0,0:05:34.51,0:05:37.93,Default,,0,0,0,,...كانت آنذاك، عندما حصل على مخالفة الحركة
Dialogue: 0,0:05:39.02,0:05:40.39,Default,,0,0,0,,بدا أنّه رأى شيئاً
Dialogue: 0,0:05:41.18,0:05:42.47,Default,,0,0,0,,ماذا بالضبط؟
Dialogue: 0,0:05:44.55,0:05:46.18,Default,,0,0,0,,ما خطبه برأيكم؟
Dialogue: 0,0:05:46.80,0:05:49.14,Default,,0,0,0,,ربما توجعه معدته؟
Dialogue: 0,0:06:01.43,0:06:02.59,Default,,0,0,0,,من كان ذاك؟
Dialogue: 0,0:06:02.59,0:06:06.47,Default,,0,0,0,,إيتو-كن، رامي شوكو الأعسر السابق
Dialogue: 0,0:06:06.47,0:06:09.47,Default,,0,0,0,,لكنّه فُصل بعد تسبيبه المتاعب
Dialogue: 0,0:06:09.47,0:06:11.35,Default,,0,0,0,,!بعدما خطف كاجي-كن الدور الأساسيّ منه
Dialogue: 0,0:06:14.09,0:06:17.51,Default,,0,0,0,,طلب أن يأخذ مكان الرامي غالباً
Dialogue: 0,0:06:17.51,0:06:19.27,Default,,0,0,0,,يبدو أنّه لم يحصل على الموافقة
Dialogue: 0,0:06:19.77,0:06:20.98,Default,,0,0,0,,بالطبع
Dialogue: 0,0:06:20.98,0:06:23.63,Default,,0,0,0,,فلا أحد يستطيع استبدال كاجي-كن
Dialogue: 0,0:06:23.63,0:06:25.60,On Top,,0,0,0,,مكتب الممرضة
Dialogue: 0,0:06:48.31,0:06:50.31,Default,,0,0,0,,!هكذا
Dialogue: 0,0:06:51.80,0:06:54.59,Default,,0,0,0,,!لذيذ
Dialogue: 0,0:06:54.59,0:06:56.05,Default,,0,0,0,,...لو كان كاجي-كن من يرمي
Dialogue: 0,0:06:56.05,0:06:57.26,Default,,0,0,0,,...سونوكو
Dialogue: 0,0:07:04.39,0:07:05.72,Default,,0,0,0,,أحقّاً ذلك؟
Dialogue: 0,0:07:09.27,0:07:11.14,Default,,0,0,0,,أحصل أمرٌ ما؟
Dialogue: 0,0:07:20.31,0:07:22.01,Default,,0,0,0,,...فظيع
Dialogue: 0,0:07:22.01,0:07:24.97,Default,,0,0,0,,أنت! لا يُسمح بدخول من لا\N!يملكون صلاحية
Dialogue: 0,0:07:25.55,0:07:27.43,Default,,0,0,0,,مُزّق علم البطولة؟
Dialogue: 0,0:07:27.64,0:07:33.59,Default,,0,0,0,,!قُطّع طرفاً لطرف! كان الجميع في هلع
Dialogue: 0,0:07:33.59,0:07:35.55,Default,,0,0,0,,لكن من قد يُقدم على ذلك؟
Dialogue: 0,0:07:35.55,0:07:36.89,Default,,0,0,0,,...في الواقع
Dialogue: 0,0:07:37.26,0:07:39.18,Default,,0,0,0,,،منذ فوزنا العام الفائت
Dialogue: 0,0:07:39.18,0:07:42.68,Default,,0,0,0,,مررنا بالعديد من المضايقات المشحونة بالغيرة
Dialogue: 0,0:07:42.68,0:07:45.97,Default,,0,0,0,,،إن كانت هذه الحادثة بفعل دخيل أيضاً
Dialogue: 0,0:07:45.97,0:07:49.85,Default,,0,0,0,,فنحن ضحايا، ويمكننا إنقاذ سمعة مدرستنا بالكاد
Dialogue: 0,0:07:49.85,0:07:54.09,Default,,0,0,0,,لكن لا يمكننا التهرّب من فشلنا\N في المحافظة على العلم المؤتمن لدينا
Dialogue: 0,0:07:54.09,0:07:56.80,Default,,0,0,0,,لا خيار أمامنا سوى الانسحاب من المسابقة
Dialogue: 0,0:08:00.14,0:08:01.63,Default,,0,0,0,,...هذا محزن
Dialogue: 0,0:08:01.63,0:08:04.09,Default,,0,0,0,,لمَ لم يتّصلوا بالشرطة؟
Dialogue: 0,0:08:04.30,0:08:05.97,Default,,0,0,0,,!لحفظ ماء الوجه
Dialogue: 0,0:08:05.97,0:08:08.35,Default,,0,0,0,,يريدون تحديد إذا ما كان المجرم
Dialogue: 0,0:08:08.35,0:08:12.68,Default,,0,0,0,,من الخارج أم الداخل أولاً على الأقل\N !وضبط وضع المدرسة
Dialogue: 0,0:08:12.68,0:08:14.09,Default,,0,0,0,,فهمت
Dialogue: 0,0:08:15.76,0:08:18.06,Default,,0,0,0,,!أفق يا أبي! لديك عمل
Dialogue: 0,0:08:19.47,0:08:22.51,Default,,0,0,0,,...ماذا؟ لم أعد أستطيع الشرب
Dialogue: 0,0:08:23.01,0:08:25.47,Default,,0,0,0,,...ران، أيمكن أنّك تقصدين
Dialogue: 0,0:08:31.67,0:08:33.34,Default,,0,0,0,,نافذتان
Dialogue: 0,0:08:34.26,0:08:36.47,Default,,0,0,0,,إحداهما تقابل الملعب
Dialogue: 0,0:08:38.47,0:08:42.80,Default,,0,0,0,,مُذهل! تستطيع المشاهدة كأنّك\N!في أفضل مقاعد الملعب
Dialogue: 0,0:08:42.80,0:08:45.93,Default,,0,0,0,,!أنت! لا يُصرّح الدخول لغير المعنيين
Dialogue: 0,0:08:45.93,0:08:48.35,Default,,0,0,0,,!أبي! بلا عنف
Dialogue: 0,0:08:48.35,0:08:49.43,Default,,0,0,0,,حسناً، حسناً
Dialogue: 0,0:08:49.05,0:08:51.42,Default,,0,0,0,,...والنافذة الأخرى
Dialogue: 0,0:08:51.42,0:08:51.84,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:08:52.80,0:08:54.22,Default,,0,0,0,,!النافذة محطّمة
Dialogue: 0,0:08:56.64,0:08:57.22,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:08:58.14,0:09:00.68,Default,,0,0,0,,يوجد سلّم يقود لها في الخارج
Dialogue: 0,0:09:01.97,0:09:04.51,Default,,0,0,0,,تسلّل الفاعل من الخارج
Dialogue: 0,0:09:04.80,0:09:07.64,Default,,0,0,0,,كما يُتوقع منك أيّها المتحرّي العظيم موري كوغورو-سان
Dialogue: 0,0:09:07.64,0:09:09.47,Default,,0,0,0,,يسرّني أني طلبت المساعدة منك
Dialogue: 0,0:09:13.34,0:09:16.14,Default,,0,0,0,,لكن لا يزال عليهم الانسحاب من البطولة
Dialogue: 0,0:09:16.14,0:09:19.35,Default,,0,0,0,,...الجميع مُحبطون، بينما الناظر
Dialogue: 0,0:09:24.55,0:09:26.18,Default,,0,0,0,,...لحظة، أهذا
Dialogue: 0,0:09:28.47,0:09:30.52,Default,,0,0,0,,لا فائدة منه
Dialogue: 0,0:09:32.22,0:09:36.64,Default,,0,0,0,,أخبرني يا عمّ، أين يكون ذاك السلّم عادةً؟
Dialogue: 0,0:09:36.64,0:09:41.14,Default,,0,0,0,,في المخزن، لا أعلم متى أُخرج
Dialogue: 0,0:09:41.14,0:09:42.88,Default,,0,0,0,,أكان المخزن مُقفلاً؟
Dialogue: 0,0:09:43.18,0:09:47.35,Default,,0,0,0,,في الواقع فقدنا المفتاح منذ الصباح
Dialogue: 0,0:09:47.68,0:09:49.35,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:09:53.55,0:09:56.05,Default,,0,0,0,,ماذا؟ مفتاح مكتب رئيس مجلس الإدارة أيضاً؟
Dialogue: 0,0:09:56.05,0:09:57.72,Default,,0,0,0,,أجل، اختفيا منذ الصباح
Dialogue: 0,0:09:58.01,0:09:59.18,Default,,0,0,0,,كما ظننت
Dialogue: 0,0:09:59.68,0:10:02.01,Default,,0,0,0,,كان الفاعل من الداخل
Dialogue: 0,0:10:02.38,0:10:03.97,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:10:04.18,0:10:08.93,Default,,0,0,0,,استعمل الفاعل المفتاح لدخول هذا المكتب
Dialogue: 0,0:10:12.30,0:10:14.05,Default,,0,0,0,,!ماذا عن السلّم؟
Dialogue: 0,0:10:14.30,0:10:17.14,Default,,0,0,0,,حيلة من تدبير المجرم
Dialogue: 0,0:10:17.14,0:10:20.39,Default,,0,0,0,,لتوهمنا بأنّ شخصاً تسلّل من الخارج
Dialogue: 0,0:10:20.68,0:10:23.09,Default,,0,0,0,,ألديك دليل على ذلك؟
Dialogue: 0,0:10:23.09,0:10:27.06,Default,,0,0,0,,!الأرض مليئة بشظايا الزجاج! لا أستطيع المشي
Dialogue: 0,0:10:26.91,0:10:28.31,Default,,0,0,0,,الأرض؟
Dialogue: 0,0:10:28.31,0:10:29.51,Default,,0,0,0,,فهمت
Dialogue: 0,0:10:30.02,0:10:33.80,Default,,0,0,0,,أجل، شظايا الزجاج مترامية قرب النافذة
Dialogue: 0,0:10:33.80,0:10:35.51,Default,,0,0,0,,،لو وطأها الفاعل
Dialogue: 0,0:10:35.51,0:10:38.85,Default,,0,0,0,,لعلِقت الشظايا بحذائه وانتقلت أثناء مشيه
Dialogue: 0,0:10:39.39,0:10:41.51,Default,,0,0,0,,لكن الأرض خالية من الشظايا هنا
Dialogue: 0,0:10:41.51,0:10:45.89,Default,,0,0,0,,أي أنّ الفاعل وضع السلّم\Nلكنه لم يدخل من النافذة
Dialogue: 0,0:10:45.89,0:10:47.89,Default,,0,0,0,,لم تكن هناك حاجة
Dialogue: 0,0:10:47.89,0:10:49.81,Default,,0,0,0,,فمعه مفتاح المكتب
Dialogue: 0,0:10:49.81,0:10:52.26,Default,,0,0,0,,أجل، هكذا
Dialogue: 0,0:10:54.01,0:10:57.72,Default,,0,0,0,,هل أردت أن تكون فعلةً خارجية لهذا الحد؟
Dialogue: 0,0:10:57.72,0:11:01.67,Default,,0,0,0,,ربما ذلك طبيعيّ بالنسبة لأيّ ناظر\N...يفكّر بسمعة المدرسة، لكن
Dialogue: 0,0:11:02.63,0:11:07.06,Default,,0,0,0,,بناءً على الظروف، فالأرجح أنّ الحادثة وقعت أثناء المباراة
Dialogue: 0,0:11:07.06,0:11:10.56,Default,,0,0,0,,أي من لم يتواجد في المباراة يحمل شبهة الفاعل؟
Dialogue: 0,0:11:10.56,0:11:11.42,Default,,0,0,0,,أجل
Dialogue: 0,0:11:11.92,0:11:16.89,Default,,0,0,0,,...المعذرة، رأيتُ إيتو-كن يدخل مبنى المدرسة
Dialogue: 0,0:11:16.89,0:11:18.85,Default,,0,0,0,,أجل، كذلك أنا
Dialogue: 0,0:11:20.43,0:11:22.30,Default,,0,0,0,,!يكفي مزاحاً
Dialogue: 0,0:11:22.30,0:11:25.39,Default,,0,0,0,,!دخلتُ المبنى بالفعل، لكنّي ذهبت لدورة المياه
Dialogue: 0,0:11:25.89,0:11:27.85,Default,,0,0,0,,أيمكنك إثبات ذلك؟
Dialogue: 0,0:11:28.31,0:11:32.55,Default,,0,0,0,,لا أستطيع... لكنّي لم أكن الوحيد في المبنى
Dialogue: 0,0:11:33.64,0:11:36.14,Default,,0,0,0,,...كان كاجي-كن يمسك بمعدته
Dialogue: 0,0:11:36.14,0:11:39.10,Default,,0,0,0,,صحيح، ذهب لمكتب الممرضة
Dialogue: 0,0:11:39.97,0:11:42.05,Default,,0,0,0,,!كان أنا! أنا الفاعل
Dialogue: 0,0:11:43.93,0:11:45.30,Default,,0,0,0,,!أهذه الحقيقة؟
Dialogue: 0,0:11:45.30,0:11:47.76,Default,,0,0,0,,!لا يمكن أنّك جاد يا كاجي! يستحيل أنّك فعلتها
Dialogue: 0,0:11:48.06,0:11:51.67,Default,,0,0,0,,لم أكن أرمي الكرة بمستوى عالٍ مؤخراً
Dialogue: 0,0:11:51.67,0:11:54.14,Default,,0,0,0,,ذلك جلّي لكم من مباراة اليوم
Dialogue: 0,0:11:54.14,0:11:56.35,Default,,0,0,0,,كنتُ أخشى المشاركة في البطولة
Dialogue: 0,0:11:56.68,0:11:59.27,Default,,0,0,0,,كان رميه سيّئاً حقّاً
Dialogue: 0,0:11:59.27,0:12:03.80,Default,,0,0,0,,لكنّه فقد تركيزه بعد مخالفة الشوط السابع فقط
Dialogue: 0,0:12:03.80,0:12:05.68,Default,,0,0,0,,،وإذا لم يرد المشاركة
Dialogue: 0,0:12:05.68,0:12:08.06,Default,,0,0,0,,كان بإمكانه التظاهر بمرض
Dialogue: 0,0:12:08.06,0:12:12.09,Default,,0,0,0,,هل سيمزّق العلم ويبتكر حيلة حقاً؟
Dialogue: 0,0:12:13.01,0:12:13.76,Default,,0,0,0,,!كينيا
Dialogue: 0,0:12:13.76,0:12:14.59,Default,,0,0,0,,أمّي
Dialogue: 0,0:12:15.47,0:12:16.76,Default,,0,0,0,,رأيتُها آنذاك
Dialogue: 0,0:12:20.35,0:12:22.26,Default,,0,0,0,,هناك أمرٌ غريب
Dialogue: 0,0:12:22.26,0:12:25.47,Default,,0,0,0,,لمَ يتفاديان نظرات بعضهما؟
Dialogue: 0,0:12:27.64,0:12:30.06,Default,,0,0,0,,!كنتُ أنا! أنا الفاعلة
Dialogue: 0,0:12:30.06,0:12:33.26,Default,,0,0,0,,!كلا! أنا الفاعل! لديّ دليل
Dialogue: 0,0:12:33.84,0:12:35.76,Default,,0,0,0,,!هذه! فعلتُها بهذه
Dialogue: 0,0:12:41.34,0:12:43.51,Default,,0,0,0,,إنّه نفس قماش العلم
Dialogue: 0,0:12:43.89,0:12:44.84,Default,,0,0,0,,!كينيا
Dialogue: 0,0:12:44.84,0:12:46.01,Default,,0,0,0,,!كاجي! أيّها الوغد
Dialogue: 0,0:12:46.01,0:12:47.47,Default,,0,0,0,,!كيف لك ذلك؟
Dialogue: 0,0:12:55.30,0:12:56.22,Default,,0,0,0,,ما الوضع؟
Dialogue: 0,0:12:56.22,0:12:59.14,Default,,0,0,0,,يتناقشون بشأن الاتّصال بالشرطة
Dialogue: 0,0:12:59.14,0:13:03.80,Default,,0,0,0,,يبدو أنّ عليهم استشارة رئيس مجلس الإدارة \Nطريح الفراش حالياً
Dialogue: 0,0:13:09.27,0:13:11.51,Default,,0,0,0,,لا أزال عاجزةً عن التصديق
Dialogue: 0,0:13:11.51,0:13:13.22,Default,,0,0,0,,أفعلها كاجي-كن حقاً؟
Dialogue: 0,0:13:20.85,0:13:22.05,Default,,0,0,0,,...آنذاك
Dialogue: 0,0:13:24.68,0:13:31.42,Default,,0,0,0,,لا شكّ في الأمر، رأى كاجي شخصاً في مكتب\Nرئيس مجلس الإدارة من النافذة وقتها
Dialogue: 0,0:13:31.42,0:13:35.22,Default,,0,0,0,,لذا رمى بضعف كي يتمّ إخراجه
Dialogue: 0,0:13:35.22,0:13:37.56,Default,,0,0,0,,ثمّ ذهب لمكتب الممرضة، ومكتب رئيس مجلس الإدارة
Dialogue: 0,0:13:40.18,0:13:43.47,Default,,0,0,0,,كونان-كن! ما الذي تنظر له؟
Dialogue: 0,0:13:52.59,0:13:55.09,Default,,0,0,0,,كونان-كن، لا يجدر بنا فعل هذا
Dialogue: 0,0:14:03.51,0:14:05.01,Default,,0,0,0,,...هذا
Dialogue: 0,0:14:05.01,0:14:09.31,Default,,0,0,0,,!فهمت الآن، كان هو الفاعل
Dialogue: 0,0:14:09.31,0:14:11.34,Default,,0,0,0,,...لكن لا أفهم دافعه
Dialogue: 0,0:14:11.34,0:14:14.30,Default,,0,0,0,,ما قد يجني من فعل هذا؟
Dialogue: 0,0:14:14.30,0:14:17.64,Default,,0,0,0,,هذا غريبٌ بحقّ
Dialogue: 0,0:14:17.64,0:14:21.42,Default,,0,0,0,,...أخبرتني صديقة تدرس هنا
Dialogue: 0,0:14:21.42,0:14:25.18,Default,,0,0,0,,كانوا المرشّحين المفضّلين للفوز بالبطولة\N،الوطنية هذا العام بفضل كاجي-كن
Dialogue: 0,0:14:25.18,0:14:28.52,Default,,0,0,0,,لكن كان هناك من يتذمّر رغم ذلك
Dialogue: 0,0:14:28.85,0:14:29.89,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:14:29.89,0:14:33.22,Default,,0,0,0,,فقد كانت هذه معهداً متحفّظاً
Dialogue: 0,0:14:33.22,0:14:36.22,Default,,0,0,0,,قالوا أنّ تفوّق الفريق أكثر سيجذب التلامذة للتشجيع
Dialogue: 0,0:14:36.22,0:14:38.93,Default,,0,0,0,,فيقصّرون في الدراسة
Dialogue: 0,0:14:38.93,0:14:41.10,Default,,0,0,0,,كانت هذه سياسة رئيس مجلس الإدارة
Dialogue: 0,0:14:41.42,0:14:44.30,Default,,0,0,0,,فهو يكره الرياضة
Dialogue: 0,0:14:45.80,0:14:48.10,Default,,0,0,0,,كان يقول أنّ هدف المعهد
Dialogue: 0,0:14:48.10,0:14:52.51,Default,,0,0,0,,هو تنشئة شخصيات مرموقة مثله، ولا داعي للمعان الرياضة
Dialogue: 0,0:14:52.51,0:14:55.05,Default,,0,0,0,,كان يُفترض به أن يأتي اليوم
Dialogue: 0,0:14:55.05,0:14:56.26,Default,,0,0,0,,ما الذي حصل؟
Dialogue: 0,0:14:56.26,0:14:59.35,Default,,0,0,0,,كان سيعلن انسحاب فريق كرة القاعدة
Dialogue: 0,0:14:59.35,0:15:04.47,Default,,0,0,0,,...من البطولة، لكن تدهورت صاحته
Dialogue: 0,0:15:05.18,0:15:09.18,Default,,0,0,0,,!فهمت! وجدتُ الدافع
Dialogue: 0,0:15:09.18,0:15:12.47,Default,,0,0,0,,الآن أحتاج مساعدة العمّ مُجدداً فقط
Dialogue: 0,0:15:17.26,0:15:19.43,Default,,0,0,0,,جلسة توقيع لمعجبيّ؟
Dialogue: 0,0:15:19.68,0:15:21.63,Default,,0,0,0,,أجل، اجلس هناك
Dialogue: 0,0:15:21.63,0:15:24.39,Default,,0,0,0,,!كلّ الفتيات في صفوفٍ ينتظرنك
Dialogue: 0,0:15:24.76,0:15:30.35,Default,,0,0,0,,لـ-لكن أيصحّ بي أن أقوم بهذا في مدرسة حقّاً؟
Dialogue: 0,0:15:31.80,0:15:34.22,Default,,0,0,0,,...بلا سابق إنذار مُجدداً
Dialogue: 0,0:15:35.72,0:15:39.10,Default,,0,0,0,,أنا موري كوغورو
Dialogue: 0,0:15:39.10,0:15:40.81,Default,,0,0,0,,هل تسمعونني؟
Dialogue: 0,0:15:41.26,0:15:42.26,Default,,0,0,0,,أبي؟
Dialogue: 0,0:15:42.84,0:15:46.75,Default,,0,0,0,,هلّا اجتمعتم في مكتب رئيس\Nمجلس الإدارة من فضلكم فوراً؟
Dialogue: 0,0:15:47.34,0:15:50.80,Default,,0,0,0,,سأكشف حقيقة هذه الحادثة
Dialogue: 0,0:15:57.04,0:15:59.87,Default,,0,0,0,,!موري-سان، انتهى عملك هنا
Dialogue: 0,0:15:59.87,0:16:01.61,Default,,0,0,0,,...إن كان بهذا بخصوص أجرك
Dialogue: 0,0:16:01.61,0:16:03.07,Default,,0,0,0,,كلا، لم ينته
Dialogue: 0,0:16:03.07,0:16:05.70,Default,,0,0,0,,فلم يُقبض على الفاعل الحقيقيّ بعد
Dialogue: 0,0:16:05.70,0:16:08.09,Default,,0,0,0,,الفاعل الحقيقيّ؟ لا يُعقل
Dialogue: 0,0:16:08.28,0:16:09.92,Default,,0,0,0,,!إنّه هنا
Dialogue: 0,0:16:10.16,0:16:12.88,Default,,0,0,0,,كلا، كاجي-كن ليس الفاعل
Dialogue: 0,0:16:12.47,0:16:15.56,Default,,0,0,0,,كما ترون، آثار القطع على العلم
Dialogue: 0,0:16:15.56,0:16:16.73,Default,,0,0,0,,...إذاً
Dialogue: 0,0:16:16.73,0:16:18.32,Default,,0,0,0,,ولا أمّه
Dialogue: 0,0:16:20.27,0:16:21.75,Default,,0,0,0,,من إذاً؟
Dialogue: 0,0:16:21.76,0:16:24.76,Default,,0,0,0,,،إذا قطعت علماً متعمّداً
Dialogue: 0,0:16:24.76,0:16:27.10,Default,,0,0,0,,ستقطع المقدّمة في العادة
Dialogue: 0,0:16:27.10,0:16:28.72,Default,,0,0,0,,ران، ارفعي العلم
Dialogue: 0,0:16:28.72,0:16:29.77,Default,,0,0,0,,حسناً
Dialogue: 0,0:16:34.67,0:16:37.29,Default,,0,0,0,,تمتدّ من أعلى الجانب الأيسر للأيمن السفليّ
Dialogue: 0,0:16:37.29,0:16:40.96,Default,,0,0,0,,...عامود العلم على اليسار مما يعني
Dialogue: 0,0:16:40.96,0:16:44.72,Default,,0,0,0,,ران، تظاهري بالقطع كما لو كنتِ الفاعلة
Dialogue: 0,0:16:46.86,0:16:48.72,Default,,0,0,0,,من الصعب قطعه
Dialogue: 0,0:16:49.11,0:16:52.18,Default,,0,0,0,,صحيح، صعبٌ لأنّك تستعملين يدك اليمنى
Dialogue: 0,0:16:53.02,0:16:56.52,Default,,0,0,0,,ران، جرّبي كما لو كنتِ عسراء
Dialogue: 0,0:16:56.52,0:16:57.51,Default,,0,0,0,,هكذا؟
Dialogue: 0,0:16:57.51,0:16:58.52,Default,,0,0,0,,أجل
Dialogue: 0,0:16:58.56,0:17:01.09,Default,,0,0,0,,،اقطعي للأسفل بيدك اليسرى كما لو تحملين الشفرة
Dialogue: 0,0:17:01.09,0:17:04.89,Default,,0,0,0,,بينما تمسكين بالعلم بيمينك
Dialogue: 0,0:17:04.89,0:17:07.18,Default,,0,0,0,,!سهل! والقطع يطابق الآثار
Dialogue: 0,0:17:07.18,0:17:10.14,Default,,0,0,0,,أنت ترمي بيدك اليمنى يا كاجي-كن، صحيح؟
Dialogue: 0,0:17:10.14,0:17:11.42,Default,,0,0,0,,أجل
Dialogue: 0,0:17:11.42,0:17:13.93,Default,,0,0,0,,ماذا عنك يا إيتو-كن؟
Dialogue: 0,0:17:15.43,0:17:16.64,Default,,0,0,0,,!إيتو؟
Dialogue: 0,0:17:16.64,0:17:18.26,Default,,0,0,0,,!أكان أنت إذاً؟
Dialogue: 0,0:17:18.26,0:17:22.09,Default,,0,0,0,,...لا-لا تكن أحمق! صحيحٌ أنّي أعسر، لكن
Dialogue: 0,0:17:22.09,0:17:25.68,Default,,0,0,0,,سمعتُ أنّك النجم السابق
Dialogue: 0,0:17:25.68,0:17:27.64,Default,,0,0,0,,لعلّك رأيت أنّ لا أهميّة
Dialogue: 0,0:17:27.64,0:17:32.55,Default,,0,0,0,,لمشاركة الفريق إذا لم تلعب معه، فلديك الدافع
Dialogue: 0,0:17:32.55,0:17:34.55,Default,,0,0,0,,!كـ-كلا! كلا
Dialogue: 0,0:17:34.55,0:17:35.64,Default,,0,0,0,,!إيتو، أيّها الوغد
Dialogue: 0,0:17:35.64,0:17:37.51,Default,,0,0,0,,معه حقّ
Dialogue: 0,0:17:38.01,0:17:40.14,Default,,0,0,0,,لم يكن إيتو-كن يا أبي؟
Dialogue: 0,0:17:40.14,0:17:43.43,Default,,0,0,0,,،انظري للعلم المقطّع مُجدداً
Dialogue: 0,0:17:43.43,0:17:44.47,Default,,0,0,0,,لموضع بدء التمزيق
Dialogue: 0,0:17:44.47,0:17:46.47,Default,,0,0,0,,موضع بدء التمزيق؟
Dialogue: 0,0:17:46.47,0:17:48.93,Default,,0,0,0,,ألا يبدو منخفضاً كثيراً؟
Dialogue: 0,0:17:48.93,0:17:53.76,Default,,0,0,0,,،لو كان الفاعل كاجي-كن بطول 180 سم أو إيتو-كن
Dialogue: 0,0:17:53.76,0:17:56.76,Default,,0,0,0,,لمزّقا من ارتفاعٍ أعلى
Dialogue: 0,0:17:56.76,0:17:59.64,Default,,0,0,0,,لكنّ الفاعل الحقيقيّ لم يستطع الوصول للأعلى
Dialogue: 0,0:17:59.64,0:18:03.89,Default,,0,0,0,,ما يعني أنّ طول الفاعل تحت 160 سم
Dialogue: 0,0:18:04.26,0:18:06.85,Default,,0,0,0,,كم طولك يا أمّ كاجي-كن؟
Dialogue: 0,0:18:06.85,0:18:09.47,Default,,0,0,0,,إنّه 157 سم
Dialogue: 0,0:18:09.47,0:18:12.13,Default,,0,0,0,,لكن سمعت أنّك تستعملين يدك اليمنى
Dialogue: 0,0:18:12.13,0:18:12.55,Default,,0,0,0,,أجل
Dialogue: 0,0:18:12.97,0:18:14.72,Default,,0,0,0,,مما يستبعدك
Dialogue: 0,0:18:14.72,0:18:17.51,Default,,0,0,0,,لمَ أتيتِ لمكتب رئيس مجلس الإدارة إذاً؟
Dialogue: 0,0:18:18.35,0:18:19.47,Default,,0,0,0,,...أنا
Dialogue: 0,0:18:19.85,0:18:21.42,Default,,0,0,0,,...أمّي
Dialogue: 0,0:18:21.76,0:18:25.35,Default,,0,0,0,,أردتِ الكلام مع رئيس مجلس الإدارة الذي\Nكان يُفترض به القدوم اليوم
Dialogue: 0,0:18:25.35,0:18:26.39,Default,,0,0,0,,ألستُ على حقّ؟
Dialogue: 0,0:18:27.81,0:18:29.77,Default,,0,0,0,,صحيح
Dialogue: 0,0:18:29.77,0:18:35.60,Default,,0,0,0,,أردتُ أن يكون ابني كينيا طبيباً\Nمثل زوجي الرّاحل
Dialogue: 0,0:18:35.60,0:18:37.97,Default,,0,0,0,,فأردتُه أن يترك كرة القاعدة
Dialogue: 0,0:18:37.97,0:18:42.84,Default,,0,0,0,,كنتُ سأخبر رئيس مجلس الإدارة أنّي \Nلم أرد مشاركته في البطولة
Dialogue: 0,0:18:42.84,0:18:44.85,Default,,0,0,0,,ليسحب الفريقَ منها
Dialogue: 0,0:18:45.22,0:18:49.06,Default,,0,0,0,,دون علمك أنّه كان سيأتي لإعلان الانسحاب بالأصل
Dialogue: 0,0:18:50.52,0:18:52.51,Default,,0,0,0,,يا للسخرية
Dialogue: 0,0:18:52.51,0:18:55.43,Default,,0,0,0,,لكنه لم يكن موجوداً، فغادرتِ المكتب
Dialogue: 0,0:18:55.76,0:18:58.47,Default,,0,0,0,,رآك إيتو-كن حينها
Dialogue: 0,0:18:58.47,0:19:02.43,Default,,0,0,0,,مزّق الفاعل الحقيقيّ المختبئ وقتها العلم
Dialogue: 0,0:19:02.43,0:19:06.01,Default,,0,0,0,,لكنّ كاجي-كن دخل بعدما رآك
Dialogue: 0,0:19:06.01,0:19:07.76,Default,,0,0,0,,عبر النافذة وهو في الملعب
Dialogue: 0,0:19:07.76,0:19:11.93,Default,,0,0,0,,أسقط الفاعل الشفرة في هربه هلعاً
Dialogue: 0,0:19:11.93,0:19:14.76,Default,,0,0,0,,فالتقطها كاجي-كن
Dialogue: 0,0:19:14.76,0:19:18.18,Default,,0,0,0,,معتقداً أنّ أمّه مزّقت علم البطولة
Dialogue: 0,0:19:18.60,0:19:22.47,Default,,0,0,0,,هكذا اندفعتما للتستّر على بعضكما
Dialogue: 0,0:19:24.93,0:19:27.56,Default,,0,0,0,,من الفاعل الحقيقيّ إذاً؟
Dialogue: 0,0:19:27.56,0:19:30.43,Default,,0,0,0,,يوجد هنا شخصٌ آخر قد أختفى
Dialogue: 0,0:19:30.43,0:19:33.68,Default,,0,0,0,,عندما دخلت الأمّ المدرسة
Dialogue: 0,0:19:33.68,0:19:36.22,Default,,0,0,0,,شخص أعسر وطوله يقلّ عن 160 سم
Dialogue: 0,0:19:40.52,0:19:42.34,Default,,0,0,0,,...أنا أشير لك
Dialogue: 0,0:19:48.72,0:19:49.68,Default,,0,0,0,,مُحال
Dialogue: 0,0:19:49.68,0:19:51.13,Default,,0,0,0,,...أيُعقل
Dialogue: 0,0:19:51.55,0:19:54.59,Default,,0,0,0,,أجل، الفاعل الحقيقيّ الذي مزّق علم البطولة
Dialogue: 0,0:19:54.97,0:19:57.06,Default,,0,0,0,,!هو أنت أيّها الناظر
Dialogue: 0,0:19:57.43,0:20:00.23,Default,,0,0,0,,انتظرت فرصتك في التسلّل إلى هنا
Dialogue: 0,0:20:00.60,0:20:04.26,Default,,0,0,0,,وذلك قبل قدوم رئيس مجلس الإدارة
Dialogue: 0,0:20:04.26,0:20:05.85,Default,,0,0,0,,تسلّلت بعدما أعطيت انطباعاً للجميع
Dialogue: 0,0:20:05.85,0:20:08.93,Default,,0,0,0,,بأنك موجود في الملعب، ثمّ مزّقت العلم
Dialogue: 0,0:20:08.93,0:20:12.34,Default,,0,0,0,,وزيّفت قدوم شخص عبر النافذة من الخارج
Dialogue: 0,0:20:12.34,0:20:14.64,Default,,0,0,0,,ثمّ رجعت للملعب
Dialogue: 0,0:20:14.64,0:20:17.22,Default,,0,0,0,,كانت هذه خطّتك
Dialogue: 0,0:20:18.47,0:20:21.05,Default,,0,0,0,,!مجرّد افتراضات! لا دليل لديك
Dialogue: 0,0:20:21.05,0:20:26.01,Default,,0,0,0,,الدليل هو مفتاح مكتب رئيس\Nمجلس الإدارة الموجود في جيبك
Dialogue: 0,0:20:27.60,0:20:29.60,Default,,0,0,0,,كنتَ تنوي إقفال الباب وإعادة المفتاح
Dialogue: 0,0:20:29.60,0:20:31.13,Default,,0,0,0,,،لإكمال حيلتك
Dialogue: 0,0:20:31.13,0:20:36.72,Default,,0,0,0,,لكنك لم تستطع مع دخول وخروج الجميع من المكتب
Dialogue: 0,0:20:36.72,0:20:40.14,Default,,0,0,0,,لم يرجع المفتاح للمخزن بعد
Dialogue: 0,0:20:40.14,0:20:43.55,Default,,0,0,0,,ما يعني أنّ من المنطقيّ افتراض
Dialogue: 0,0:20:43.55,0:20:45.18,Default,,0,0,0,,!أنّه بحوزة الفاعل
Dialogue: 0,0:20:45.93,0:20:47.14,Default,,0,0,0,,!أنباء سيّئة
Dialogue: 0,0:20:48.18,0:20:53.09,Default,,0,0,0,,تلقّينا اتصالاً للتوّ، يبدو أنّ رئيس\N!مجلس الإدارة قد تُوفيّ
Dialogue: 0,0:21:04.26,0:21:08.47,Default,,0,0,0,,لا يمكن... ما كان الهدف مما فعلتُه؟
Dialogue: 0,0:21:10.88,0:21:13.01,Default,,0,0,0,,أخبرني رئيس مجلس الإدارة
Dialogue: 0,0:21:13.01,0:21:17.43,Default,,0,0,0,,أن أمنع الفريق من المشاركة في البطولة
Dialogue: 0,0:21:17.43,0:21:21.88,Default,,0,0,0,,لكن لم يكن الأمر يسيراً مع أنظار الإعلام وأولياء الأمور
Dialogue: 0,0:21:22.88,0:21:27.43,Default,,0,0,0,,على هذا النحو، كان رئيس المجلس ليعلن \Nعن انسحاب الفريق بنفسه
Dialogue: 0,0:21:27.43,0:21:31.34,Default,,0,0,0,,فتتضرّر صورة المدرسة أمام المجتمع بشكلٍ مباشر
Dialogue: 0,0:21:31.34,0:21:35.55,Default,,0,0,0,,"أيّ مدرسة قد تسحق أحلام شبّان؟"
Dialogue: 0,0:21:35.55,0:21:40.39,Default,,0,0,0,,لذا حاولتُ حماية سمعة المدرسة\Nعلى الأقلّ حتّى مع الانسحاب
Dialogue: 0,0:21:40.39,0:21:43.30,Default,,0,0,0,,!فقد أحبّبتُ هذه المدرسة
Dialogue: 0,0:21:43.30,0:21:46.30,Default,,0,0,0,,!أكثر بكثير من رئيس المجلس ذاك
Dialogue: 0,0:21:46.30,0:21:50.02,Default,,0,0,0,,أنتما متشابهان في النهاية
Dialogue: 0,0:21:50.02,0:21:53.76,Default,,0,0,0,,سحقتما أحلام الشبّان بأيديكم
Dialogue: 0,0:21:54.30,0:21:57.22,Default,,0,0,0,,معك حقّ، كنتُ مغفلاً
Dialogue: 0,0:21:57.97,0:22:00.52,Default,,0,0,0,,!سـ-سامحوني
Dialogue: 0,0:23:34.39,0:23:36.89,Default,,0,0,0,,بدأت البطولة بعدها بنصف شهر
Dialogue: 0,0:23:36.89,0:23:39.77,Default,,0,0,0,,وشاركت أكاديمية شوكو
Dialogue: 0,0:23:39.77,0:23:43.97,Default,,0,0,0,,رأى مسؤولو المسابقة شغفهم لكرة القاعدة
Dialogue: 0,0:23:45.10,0:23:46.43,Default,,0,0,0,,!رمية
Dialogue: 0,0:23:48.52,0:23:52.84,Default,,0,0,0,,...رمي كاجي يقود أكايمية شوكو لانتصارات تدريجياً
Dialogue: 0,0:23:52.84,0:23:56.43,Default,,0,0,0,,نحو علم بطولة جديد
Dialogue: 0,0:24:03.09,0:24:04.43,Default,,0,0,0,,لا جدوى، إنّه ميت
Dialogue: 0,0:24:05.22,0:24:06.68,Default,,0,0,0,,مكيدة من؟
Dialogue: 0,0:24:07.68,0:24:11.34,Default,,0,0,0,,وأمام أنظاري، من يكون؟
Dialogue: 0,0:24:11.68,0:24:13.97,Default,,0,0,0,,شينتشي! أنت هنا، صحيح؟
Dialogue: 0,0:24:17.51,0:24:18.83,Default,,0,0,0,,...شينتشي
Dialogue: 0,0:24:20.10,0:24:23.26,Default,,0,0,0,,...رجعت... شينتشي
Dialogue: 0,0:24:24.68,0:24:26.05,Default,,0,0,0,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.05,0:24:28.89,Default,,0,0,0,,جريمة قتل حجرة الكاراوكي
Dialogue: 0,0:24:45.15,0:24:47.18,Default,,0,0,0,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.77,0:24:49.98,Default,,0,0,0,,حيوان رنّة أحمر الأنف

