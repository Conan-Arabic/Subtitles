Dialogue: 0,0:00:01.22,0:00:02.93,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.93,0:00:06.34,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:06.34,0:00:09.84,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:09.84,0:00:11.83,Default,,0000,0000,0000,,!تتضمن قضيّة اليوم جثّةً مفقودة
Dialogue: 0,0:00:11.83,0:00:15.37,Default,,0000,0000,0000,,!حتى لو خدعتَ الجميع، تبقى الحقيقة واحدة دوماً
Dialogue: 0,0:01:47.08,0:01:49.62,Default,,0000,0000,0000,,جريمة قتل الجثّة المفقودة
Dialogue: 0,0:01:59.94,0:02:03.47,Default,,0000,0000,0000,,الهدوء يعمّ هنا مؤخراً
Dialogue: 0,0:02:03.47,0:02:08.19,Default,,0000,0000,0000,,لا يمكن لفرقة فتيان التحرّي فعل شيء\Nدون تلقي طلب مساعدة
Dialogue: 0,0:02:09.39,0:02:10.84,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:02:10.84,0:02:14.56,Default,,0000,0000,0000,,،لو كان العُملاء يظهرون بهذه السهولة\Nلما عانينا نحن المحققون أيّ قلق
Dialogue: 0,0:02:14.96,0:02:18.59,Default,,0000,0000,0000,,...صنع لنا البروفسور آغاسا تلك الشارات أيضاً
Dialogue: 0,0:02:18.59,0:02:21.04,Default,,0000,0000,0000,,!تبدو رائعةً مهما نظرتُ لها
Dialogue: 0,0:02:21.04,0:02:25.14,Default,,0000,0000,0000,,فتيان التحرّي، تصميم فرقة فتيان التحرّي الحصري
Dialogue: 0,0:02:25.14,0:02:26.85,Default,,0000,0000,0000,,!تتمتّع بوظيفة إرسال واستقبال أيضاً
Dialogue: 0,0:02:26.85,0:02:30.33,Default,,0000,0000,0000,,!لا قيمة لهذه الشارات دون قضايا لنحلّها
Dialogue: 0,0:02:30.33,0:02:31.68,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:02:31.98,0:02:35.10,Default,,0000,0000,0000,,...لديّ طلبٌ صغير
Dialogue: 0,0:02:35.36,0:02:38.32,Default,,0000,0000,0000,,!أنت هيروكي من الفصل المجاور
Dialogue: 0,0:02:38.32,0:02:40.08,Default,,0000,0000,0000,,!ما الأمر؟ جريمة قتل؟
Dialogue: 0,0:02:40.08,0:02:40.97,Default,,0000,0000,0000,,!احتيال؟
Dialogue: 0,0:02:40.97,0:02:43.56,Default,,0000,0000,0000,,!خيانة زوجية بين والديك؟
Dialogue: 0,0:02:43.56,0:02:48.77,Default,,0000,0000,0000,,كـ-كلا، اختفى أكيرا ليلة البارحة
Dialogue: 0,0:02:49.02,0:02:51.72,Default,,0000,0000,0000,,!قضيّة شخص مفقود
Dialogue: 0,0:02:49.02,0:02:51.72,Default,,0000,0000,0000,,!قضيّة شخص مفقود
Dialogue: 0,0:02:53.11,0:02:55.77,Default,,0000,0000,0000,,الاختطاف ليس مستبعداً
Dialogue: 0,0:02:55.77,0:02:57.31,Default,,0000,0000,0000,,كيف مظهره إذاً؟
Dialogue: 0,0:02:57.31,0:03:00.48,Default,,0000,0000,0000,,لديّ صورة، هاكم
Dialogue: 0,0:03:02.51,0:03:03.51,Default,,0000,0000,0000,,!قطّة؟
Dialogue: 0,0:03:04.51,0:03:08.14,Default,,0000,0000,0000,,أتقصد أنّ هذه القطّة هي من فقدته؟
Dialogue: 0,0:03:08.14,0:03:08.77,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:09.43,0:03:11.97,Default,,0000,0000,0000,,!لم يكن اختطافاً للأسف
Dialogue: 0,0:03:12.21,0:03:14.86,Default,,0000,0000,0000,,يمكنني أن أدفع لكم 10 ينّ لكل فرد
Dialogue: 0,0:03:14.86,0:03:15.79,Default,,0000,0000,0000,,!عشرة ينّات؟
Dialogue: 0,0:03:15.79,0:03:20.09,Default,,0000,0000,0000,,كلا، نحن نستقبل القضايا رفيعة المستوى فقط
Dialogue: 0,0:03:20.09,0:03:22.78,Default,,0000,0000,0000,,ستعود القطّة إن انتظرت بالتأكيد
Dialogue: 0,0:03:22.78,0:03:24.45,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:03:24.45,0:03:26.62,Default,,0000,0000,0000,,إلى اللقاء
Dialogue: 0,0:03:28.28,0:03:32.89,Default,,0000,0000,0000,,كنتُ سأعطيكم بعض بطاقات\Nيايبا المقنّع إن وجدتموها
Dialogue: 0,0:03:34.27,0:03:37.27,Default,,0000,0000,0000,,انظروا، أنا أجمعها
Dialogue: 0,0:03:38.40,0:03:40.93,Default,,0000,0000,0000,,!بـ-بطاقات يايبا المقنّع؟
Dialogue: 0,0:03:40.93,0:03:43.56,Default,,0000,0000,0000,,...كما أنّها البطاقات شديدة الندرة
Dialogue: 0,0:03:43.56,0:03:46.15,Default,,0000,0000,0000,,!الذهبية الفائقة
Dialogue: 0,0:03:46.51,0:03:47.94,Default,,0000,0000,0000,,!نقبل القضيّة
Dialogue: 0,0:03:46.51,0:03:47.94,Default,,0000,0000,0000,,!نقبل القضيّة
Dialogue: 0,0:03:49.81,0:03:51.89,Default,,0000,0000,0000,,ما خطبكم؟
Dialogue: 0,0:04:08.79,0:04:11.10,Default,,0000,0000,0000,,تبّاً، لا نستطيع إيجادها في أيّ مكان
Dialogue: 0,0:04:11.65,0:04:17.81,Default,,0000,0000,0000,,غريب، اختفت بالأمس لذا يُفترض\Nأنّها لا تزال في القرب
Dialogue: 0,0:04:18.23,0:04:22.35,Default,,0000,0000,0000,,أنت، بذلنا جهداً كبيراً لذا يُفترض\Nأن تعطينا البطاقات الآن
Dialogue: 0,0:04:22.68,0:04:25.56,Default,,0000,0000,0000,,كلا، لم تجدوها
Dialogue: 0,0:04:25.56,0:04:29.52,Default,,0000,0000,0000,,أخبرني، ألتلك القطة عادات أو مميزات ما؟
Dialogue: 0,0:04:29.52,0:04:36.17,Default,,0000,0000,0000,,حسناً، مواء أكيرا مختلف عن بقية القطط
Dialogue: 0,0:04:36.17,0:04:39.42,Default,,0000,0000,0000,,...هكذا
Dialogue: 0,0:04:39.42,0:04:42.35,Default,,0000,0000,0000,,أجل، كذاك
Dialogue: 0,0:04:42.35,0:04:44.06,Default,,0000,0000,0000,,!من أين أتى؟
Dialogue: 0,0:04:44.06,0:04:45.68,Default,,0000,0000,0000,,!من ذاك المنزل
Dialogue: 0,0:04:46.91,0:04:49.52,Default,,0000,0000,0000,,!أكيرا! أكيرا
Dialogue: 0,0:04:52.40,0:04:53.28,Default,,0000,0000,0000,,!أكيرا
Dialogue: 0,0:04:53.28,0:04:54.23,Default,,0000,0000,0000,,!وجدناها
Dialogue: 0,0:04:53.28,0:04:54.23,Default,,0000,0000,0000,,!وجدناها
Dialogue: 0,0:05:03.81,0:05:05.33,Default,,0000,0000,0000,,!تغطيها الدماء
Dialogue: 0,0:05:05.33,0:05:06.56,Default,,0000,0000,0000,,!علينا مساعدتها فوراً
Dialogue: 0,0:05:08.06,0:05:11.17,Default,,0000,0000,0000,,كلا، لا جراح بهذه القطّة
Dialogue: 0,0:05:11.17,0:05:12.92,Default,,0000,0000,0000,,...مما يعني
Dialogue: 0,0:05:12.92,0:05:13.77,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:05:15.13,0:05:17.73,Default,,0000,0000,0000,,!انتظر يا كونان! ما الخطب؟
Dialogue: 0,0:05:21.50,0:05:23.29,Default,,0000,0000,0000,,أيوجد شيء هناك؟
Dialogue: 0,0:05:23.29,0:05:24.23,Default,,0000,0000,0000,,!دعني أرى أيضاً
Dialogue: 0,0:05:24.23,0:05:24.94,Default,,0000,0000,0000,,!وأنا
Dialogue: 0,0:05:42.02,0:05:44.46,Default,,0000,0000,0000,,!الشرطة... عليّ الاتصال بهم فوراً
Dialogue: 0,0:05:51.47,0:05:53.47,Default,,0000,0000,0000,,أأنتم من أجرى الاتصال؟
Dialogue: 0,0:05:53.47,0:05:54.76,Default,,0000,0000,0000,,أرأيتم جثّةً حقاً؟
Dialogue: 0,0:05:54.76,0:05:55.26,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:05:55.26,0:05:56.26,Default,,0000,0000,0000,,!صدقاً
Dialogue: 0,0:05:56.26,0:05:58.23,Default,,0000,0000,0000,,لا شكّ في الأمر سيّدي المفتش
Dialogue: 0,0:05:58.50,0:06:00.09,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:06:00.09,0:06:04.69,Default,,0000,0000,0000,,كما أنّه لم يغادر أحدٌ المنزل\Nمذ اكتشفنا الجثة
Dialogue: 0,0:06:07.04,0:06:10.07,Default,,0000,0000,0000,,مما يعني أنّ الجثة لا تزال داخله
Dialogue: 0,0:06:11.95,0:06:14.19,Default,,0000,0000,0000,,!نحن الشرطة! افتح الباب
Dialogue: 0,0:06:16.53,0:06:18.15,Default,,0000,0000,0000,,!ما هذه الجلبة؟
Dialogue: 0,0:06:18.86,0:06:23.40,Default,,0000,0000,0000,,يقول هؤلاء الصغار أنّهم\Nرأوا جثّةً في منزلك
Dialogue: 0,0:06:23.40,0:06:24.44,Default,,0000,0000,0000,,!جثّة؟
Dialogue: 0,0:06:24.44,0:06:26.44,Default,,0000,0000,0000,,!رأيناها بلا شك
Dialogue: 0,0:06:26.44,0:06:28.10,Default,,0000,0000,0000,,!رجل في الحمّام
Dialogue: 0,0:06:28.10,0:06:29.90,Default,,0000,0000,0000,,!كان ملقياً وتغطيه الدماء
Dialogue: 0,0:06:30.97,0:06:35.22,Default,,0000,0000,0000,,سخافة، كنتُ أستحم لتويّ
Dialogue: 0,0:06:35.22,0:06:37.60,Default,,0000,0000,0000,,إنّها تلك الغرفة أمامكم مباشرةً
Dialogue: 0,0:06:37.93,0:06:40.17,Default,,0000,0000,0000,,سألقي نظرة قليلاً
Dialogue: 0,0:06:40.17,0:06:41.06,Default,,0000,0000,0000,,!لـ-لحظة
Dialogue: 0,0:06:45.38,0:06:47.31,Default,,0000,0000,0000,,...ليست هنا! الجثّة
Dialogue: 0,0:06:47.58,0:06:48.98,Default,,0000,0000,0000,,اختفت
Dialogue: 0,0:06:48.98,0:06:50.27,Default,,0000,0000,0000,,مستحيل
Dialogue: 0,0:06:50.82,0:06:56.52,Default,,0000,0000,0000,,رأيتم؟ لا جثث هنا! كان مقلباً \N!من هؤلاء الأطفال بالتأكيد
Dialogue: 0,0:06:56.91,0:06:59.20,Default,,0000,0000,0000,,!لكننا رأيناها صدقاً
Dialogue: 0,0:06:59.20,0:07:01.89,Default,,0000,0000,0000,,!جثّة تغطيها الدماء طريحة في الحمّام
Dialogue: 0,0:07:02.40,0:07:03.52,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:07:03.52,0:07:05.73,Default,,0000,0000,0000,,!لا بد أنّ هذا الرجل أخفاها
Dialogue: 0,0:07:05.73,0:07:07.19,Default,,0000,0000,0000,,!ما-ما الذي تقوله؟
Dialogue: 0,0:07:09.19,0:07:13.76,Default,,0000,0000,0000,,مضت 15 دقيقة تقريباً مذ اتّصالكم بنا
Dialogue: 0,0:07:13.76,0:07:15.76,Default,,0000,0000,0000,,حتى وصولنا هنا
Dialogue: 0,0:07:15.76,0:07:18.19,Default,,0000,0000,0000,,إنّه وقتٌ كافٍ لإخفاء جثّة
Dialogue: 0,0:07:19.14,0:07:20.59,Default,,0000,0000,0000,,سخافة
Dialogue: 0,0:07:20.59,0:07:24.39,Default,,0000,0000,0000,,ابحثوا قدرما تشاؤون! سأصعد للأعلى لأنام
Dialogue: 0,0:07:24.39,0:07:27.71,Default,,0000,0000,0000,,لا تمانع إن بحثنا دون حضورك إذاً؟
Dialogue: 0,0:07:27.71,0:07:29.17,Default,,0000,0000,0000,,لا أهتم
Dialogue: 0,0:07:29.17,0:07:31.70,Default,,0000,0000,0000,,قلّبوا المكان إن شئتم، لن تجدوا شيئاً مريباً
Dialogue: 0,0:07:31.70,0:07:35.60,Default,,0000,0000,0000,,،إن كانت هناك مشاكل فأخبروا أخي\Nسيعود للمنزل قريباً
Dialogue: 0,0:07:36.83,0:07:39.33,Default,,0000,0000,0000,,لكن لا بدّ أنّ الشرطة غارقة في الضجر
Dialogue: 0,0:07:39.33,0:07:41.72,Default,,0000,0000,0000,,لتثير جلبةً حول مقالب أطفال مشاغبين
Dialogue: 0,0:07:47.48,0:07:49.23,Default,,0000,0000,0000,,تبّاً
Dialogue: 0,0:07:49.23,0:07:52.89,Default,,0000,0000,0000,,!ابحثوا! لا بدّ أن الجثة في مكانٍ ما
Dialogue: 0,0:07:52.89,0:07:54.31,Default,,0000,0000,0000,,!اقلبوا البيت رأساً على عقب
Dialogue: 0,0:07:54.76,0:07:57.18,Default,,0000,0000,0000,,!جدوا الجثّة مهما كلّف الأمر
Dialogue: 0,0:08:00.88,0:08:01.68,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:08:02.09,0:08:04.64,Default,,0000,0000,0000,,أحصل شيءٌ ما هنا؟
Dialogue: 0,0:08:05.09,0:08:06.46,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:08:06.46,0:08:08.75,Default,,0000,0000,0000,,رجع الأخ الأصغر
Dialogue: 0,0:08:08.75,0:08:12.87,Default,,0000,0000,0000,,!ما-ما هذا؟ ما الذي يجري؟
Dialogue: 0,0:08:12.87,0:08:16.77,Default,,0000,0000,0000,,قال هذا الفتى أنّه رأى جثةً في منزلكم
Dialogue: 0,0:08:17.08,0:08:18.89,Default,,0000,0000,0000,,جثّة؟
Dialogue: 0,0:08:23.53,0:08:24.69,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:08:24.69,0:08:26.61,Default,,0000,0000,0000,,!ما-ما الذي تفعله؟
Dialogue: 0,0:08:26.61,0:08:29.65,Default,,0000,0000,0000,,...لا مشكلة، لم تكن مرتفعة القيمة
Dialogue: 0,0:08:29.65,0:08:33.10,Default,,0000,0000,0000,,!أنتم! اخرسوا! ألا يمكنكم التزام الهدوء؟
Dialogue: 0,0:08:34.60,0:08:37.18,Default,,0000,0000,0000,,هل أخي كازيوشي في الأعلى؟
Dialogue: 0,0:08:37.18,0:08:40.07,Default,,0000,0000,0000,,أجل، يبدو أنّه غاضب أيضاً
Dialogue: 0,0:08:40.63,0:08:44.92,Default,,0000,0000,0000,,المعذرة، لكن ما عمل أخيك بالضبط؟
Dialogue: 0,0:08:44.92,0:08:47.26,Default,,0000,0000,0000,,إنّه كاتبٌ للوقت الراهن
Dialogue: 0,0:08:47.26,0:08:50.95,Default,,0000,0000,0000,,لكنّه في الواقع يمكث في البيت عادةً\N...ولا يقوم بشيء
Dialogue: 0,0:08:50.95,0:08:54.25,Default,,0000,0000,0000,,هذه بطاقتي
Dialogue: 0,0:08:54.25,0:08:57.04,Default,,0000,0000,0000,,تاناكا توموفومي
Dialogue: 0,0:08:57.04,0:08:59.58,Default,,0000,0000,0000,,تعمل في شركة أوراق مالية
Dialogue: 0,0:08:59.58,0:09:02.22,Default,,0000,0000,0000,,أأنت وأخوك وحدكما من يعيش هنا؟
Dialogue: 0,0:09:02.57,0:09:03.49,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:03.49,0:09:07.02,Default,,0000,0000,0000,,رغم أنّه منزلي فعلياً، يعيش أخي بلا مقابل
Dialogue: 0,0:09:09.40,0:09:10.76,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:09:11.56,0:09:12.50,Default,,0000,0000,0000,,ورقة؟
Dialogue: 0,0:09:15.85,0:09:18.31,Default,,0000,0000,0000,,...بحثنا في المنزل من سقفه لأسفله
Dialogue: 0,0:09:18.93,0:09:21.55,Default,,0000,0000,0000,,بقيت غرفة أخيك فقط
Dialogue: 0,0:09:21.55,0:09:25.02,Default,,0000,0000,0000,,حسناً، آمل ألا يغضب كثيراً
Dialogue: 0,0:09:26.01,0:09:28.22,Default,,0000,0000,0000,,أخي؟
Dialogue: 0,0:09:28.22,0:09:28.90,Default,,0000,0000,0000,,أخي؟
Dialogue: 0,0:09:28.90,0:09:35.75,On Top,,0000,0000,0000,,سيجلب النتوء الجبلي مرتفع الضغط\N...سماءً صافية لمعظم أرجاء اليابان
Dialogue: 0,0:09:35.75,0:09:38.04,Default,,0000,0000,0000,,لا بأس، يبدو أنّه نائم
Dialogue: 0,0:09:38.04,0:09:39.31,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:09:39.31,0:09:44.45,On Top,,0000,0000,0000,,تبدأ زخّات المطر قرابة الواحدة ظهراً
Dialogue: 0,0:09:44.45,0:09:46.95,On Top,,0000,0000,0000,,قد يستمر هطول المطر الغزير حتّى المساء
Dialogue: 0,0:09:47.97,0:09:49.86,Default,,0000,0000,0000,,توجد شجرةٌ كبيرة في الفناء الخلفي
Dialogue: 0,0:09:50.37,0:09:51.35,Default,,0000,0000,0000,,ما أمرها؟
Dialogue: 0,0:09:52.64,0:09:53.59,Default,,0000,0000,0000,,تاناكا-سان؟
Dialogue: 0,0:09:54.56,0:09:58.81,Default,,0000,0000,0000,,!يا إلهي، أطفئ التلفاز على الأقل إن كنت ستنام
Dialogue: 0,0:09:59.64,0:10:02.02,Default,,0000,0000,0000,,يبدو أنّه سمعني
Dialogue: 0,0:10:02.30,0:10:04.89,Default,,0000,0000,0000,,أعتقد أنّكم رأيتم كلّ شيء الآن
Dialogue: 0,0:10:05.88,0:10:08.63,Default,,0000,0000,0000,,ولا وجود لأيّ جثّة
Dialogue: 0,0:10:08.63,0:10:09.77,Default,,0000,0000,0000,,!أيّها الأشقياء
Dialogue: 0,0:10:09.77,0:10:12.83,Default,,0000,0000,0000,,!نحن لا نكذب
Dialogue: 0,0:10:12.83,0:10:17.31,Default,,0000,0000,0000,,يمكن أن الجثّة نُقلت للخارج سلفاً
Dialogue: 0,0:10:19.96,0:10:21.61,Default,,0000,0000,0000,,...لكن يا كونان-كن
Dialogue: 0,0:10:21.61,0:10:27.73,Default,,0000,0000,0000,,ألم تقل أنّه لم يغادر أحد \Nالمنزل قبل وصولنا؟
Dialogue: 0,0:10:29.11,0:10:30.90,Default,,0000,0000,0000,,قلتُ ذلك
Dialogue: 0,0:10:30.90,0:10:34.35,Default,,0000,0000,0000,,لكنّي كنت أراقب مقدمة المنزل من حجرة الهاتف فقط
Dialogue: 0,0:10:34.85,0:10:36.52,Default,,0000,0000,0000,,لم أرَ الفناء الخلفي
Dialogue: 0,0:10:36.52,0:10:40.51,Default,,0000,0000,0000,,لكن يوجد حائط مرتفع خلف هذا المنزل
Dialogue: 0,0:10:40.93,0:10:43.43,Default,,0000,0000,0000,,رأيت الشجرة الكبيرة مع ذلك، صحيح؟
Dialogue: 0,0:10:43.43,0:10:46.39,Default,,0000,0000,0000,,إن ربطت جثّةً بجسمك واستعملت تلك الشجرة
Dialogue: 0,0:10:46.39,0:10:47.40,Default,,0000,0000,0000,,سيمكنك تجاوز الحائط
Dialogue: 0,0:10:49.05,0:10:50.83,Default,,0000,0000,0000,,منزل تاناكا
Dialogue: 0,0:10:50.83,0:10:51.42,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:10:52.58,0:10:54.75,Default,,0000,0000,0000,,كلا، لا بد أنّه الرقم الخطأ
Dialogue: 0,0:10:54.75,0:10:56.83,Default,,0000,0000,0000,,لا مشكلة
Dialogue: 0,0:10:56.83,0:10:57.44,Default,,0000,0000,0000,,وداعاً
Dialogue: 0,0:10:59.83,0:11:03.24,Default,,0000,0000,0000,,كان اتصالاً خاطئاً، عمَّ كنا نتحدث؟
Dialogue: 0,0:11:03.74,0:11:05.45,Default,,0000,0000,0000,,الشجرة في الخلف
Dialogue: 0,0:11:05.45,0:11:09.02,Default,,0000,0000,0000,,كانت موجودةً عندما اشتريتُ المنزل
Dialogue: 0,0:11:09.66,0:11:12.01,Default,,0000,0000,0000,,هل كان رنين ذاك الهاتف لا يعمل؟
Dialogue: 0,0:11:13.40,0:11:15.36,Default,,0000,0000,0000,,أأنت بخيرٍ هناك؟
Dialogue: 0,0:11:15.36,0:11:16.44,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:11:16.44,0:11:18.40,Default,,0000,0000,0000,,أيمكن تسلّقها وشخص مربوطٌ بك؟
Dialogue: 0,0:11:19.44,0:11:20.64,Default,,0000,0000,0000,,...أظن بإمكاني
Dialogue: 0,0:11:24.18,0:11:25.43,Default,,0000,0000,0000,,لا جدوى حضرة المفتش
Dialogue: 0,0:11:25.43,0:11:27.98,Default,,0000,0000,0000,,لا يمكنني النزول، الجانب الخارجي للحائط سدٌّ مائي
Dialogue: 0,0:11:29.05,0:11:31.10,Default,,0000,0000,0000,,ألا يوجد موضع أقدام أو ما شابه؟
Dialogue: 0,0:11:31.50,0:11:33.77,Default,,0000,0000,0000,,هناك مسار بعرض 40 سنتيمتر تقريباً
Dialogue: 0,0:11:33.77,0:11:35.64,Default,,0000,0000,0000,,لكن من المستحيل سلوكه وأنا أحمل جثّة
Dialogue: 0,0:11:36.09,0:11:39.90,Default,,0000,0000,0000,,حتّى لو تمكنت من النزول، سأحتاج\Nكلّ جهدي لمجرد المشي
Dialogue: 0,0:11:41.16,0:11:43.41,Default,,0000,0000,0000,,،لا جثّة داخل المنزل
Dialogue: 0,0:11:43.41,0:11:45.37,Default,,0000,0000,0000,,ومن المستحيل نقل واحدة للخارج
Dialogue: 0,0:11:45.37,0:11:48.15,Default,,0000,0000,0000,,مما يعني أنّكم كذبتم
Dialogue: 0,0:11:48.70,0:11:49.81,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:11:50.03,0:11:51.60,Default,,0000,0000,0000,,!لنغادر جميعاً
Dialogue: 0,0:11:51.60,0:11:53.02,Default,,0000,0000,0000,,!انتظر سيّدي المفتش
Dialogue: 0,0:11:53.48,0:11:54.60,Default,,0000,0000,0000,,...رأينا حقاً
Dialogue: 0,0:11:56.11,0:11:58.69,Default,,0000,0000,0000,,،حتّى لو أمسكتم بعصابة اللّصوص الإيطالية تلك
Dialogue: 0,0:11:58.69,0:12:00.81,Default,,0000,0000,0000,,كانت حماقة منّي أن أثق بكم
Dialogue: 0,0:12:11.88,0:12:13.80,Default,,0000,0000,0000,,كيف؟
Dialogue: 0,0:12:13.80,0:12:15.89,Default,,0000,0000,0000,,كيف اختفت الجثّة؟
Dialogue: 0,0:12:16.84,0:12:22.08,Default,,0000,0000,0000,,كلّ ما يسعني التفكير به الآن\Nأنّ الأخ الأكبر غسل الدم
Dialogue: 0,0:12:22.08,0:12:25.89,Default,,0000,0000,0000,,بينما تكفل الأصغر بتجهيزات نقل الجثة للخارج
Dialogue: 0,0:12:33.69,0:12:37.11,Default,,0000,0000,0000,,إنّها كالورقة التي كانت على الأخ الأصغر
Dialogue: 0,0:12:37.11,0:12:41.08,Default,,0000,0000,0000,,أي أنّه استعمل هذه الشجرة\Nلنقل الجثة للخارج فعلاً
Dialogue: 0,0:12:45.81,0:12:46.74,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:12:46.74,0:12:48.22,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:12:48.22,0:12:50.18,Default,,0000,0000,0000,,!أغبياء! ما الذي تفعلونه؟
Dialogue: 0,0:12:50.18,0:12:51.21,Default,,0000,0000,0000,,!غبيّ
Dialogue: 0,0:12:51.21,0:12:54.52,Default,,0000,0000,0000,,لا يمكننا تركهم ينعتوننا نحن \N!فرقة فتيان التحرّي بالكاذبين
Dialogue: 0,0:12:54.96,0:12:56.88,Default,,0000,0000,0000,,...هؤلاء الفتيان
Dialogue: 0,0:12:58.05,0:13:00.16,Default,,0000,0000,0000,,!كلا! اختبئوا
Dialogue: 0,0:13:00.16,0:13:01.31,Default,,0000,0000,0000,,هل رأونا؟
Dialogue: 0,0:13:02.20,0:13:05.44,Default,,0000,0000,0000,,لا يزال ذاك الرجل المخيف نائماً هنا
Dialogue: 0,0:13:05.83,0:13:07.50,Default,,0000,0000,0000,,...مشكلة
Dialogue: 0,0:13:07.50,0:13:11.11,Default,,0000,0000,0000,,تباً، كان عليه إغلاق الستائر على الأقل
Dialogue: 0,0:13:11.11,0:13:15.10,Default,,0000,0000,0000,,وألا يشعر بالإرهاق وهو ينام بذاك الشكل؟
Dialogue: 0,0:13:15.53,0:13:16.69,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:13:16.69,0:13:20.85,Default,,0000,0000,0000,,!هل كنت أسيئ الفهم من البداية؟
Dialogue: 0,0:13:30.30,0:13:31.26,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:13:31.26,0:13:32.89,Default,,0000,0000,0000,,!ما-ما الخطب؟
Dialogue: 0,0:13:35.72,0:13:39.52,Default,,0000,0000,0000,,لعلّي اكتشفت الحيلة التي\Nاستعملها المجرم لإخفاء الجثة
Dialogue: 0,0:13:40.91,0:13:44.94,Default,,0000,0000,0000,,انتظروا، سأدخل للتحقق من ذلك
Dialogue: 0,0:13:44.94,0:13:47.06,Default,,0000,0000,0000,,!حسنٌ، سنساعدك أيضاً
Dialogue: 0,0:13:47.37,0:13:51.78,Default,,0000,0000,0000,,كلا!، قد يكون هناك قاتل في الداخل
Dialogue: 0,0:13:51.78,0:13:54.95,Default,,0000,0000,0000,,انتظروا عند حجرة الهاتف خارجاً
Dialogue: 0,0:13:54.95,0:13:57.06,Default,,0000,0000,0000,,سأتصل بكم إن وجدتُ الجثة
Dialogue: 0,0:13:57.06,0:13:58.74,Default,,0000,0000,0000,,واتّصلوا بالشرطة فوراً عندها
Dialogue: 0,0:14:01.60,0:14:03.52,Default,,0000,0000,0000,,!أقفلها
Dialogue: 0,0:14:05.69,0:14:08.48,Default,,0000,0000,0000,,!عليّ التوجه للغرفة في الأعلى
Dialogue: 0,0:14:10.93,0:14:14.01,Default,,0000,0000,0000,,تبّاً، لا يزال مستيقظاً
Dialogue: 0,0:14:14.01,0:14:15.39,Default,,0000,0000,0000,,ما الذي وضعه؟
Dialogue: 0,0:14:20.21,0:14:21.97,Default,,0000,0000,0000,,...هاتف خلوي
Dialogue: 0,0:14:22.58,0:14:26.07,Default,,0000,0000,0000,,!هكذا إذاً! ستنجح الحيلة إن استعملت هذا
Dialogue: 0,0:14:27.71,0:14:29.89,Default,,0000,0000,0000,,بدأت تتّضح لي هذه القضية
Dialogue: 0,0:14:30.95,0:14:32.97,Default,,0000,0000,0000,,تأخّر كونان
Dialogue: 0,0:14:32.97,0:14:33.60,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:14:34.41,0:14:38.20,Default,,0000,0000,0000,,قال أنّه سيتصل بنا عبر أجهزة\Nالإرسال المصغرة هذه
Dialogue: 0,0:14:38.20,0:14:39.56,Default,,0000,0000,0000,,...إن وجد الجثة
Dialogue: 0,0:14:40.10,0:14:42.98,Default,,0000,0000,0000,,أيمكن أنّه يحاول الاستحواذ على الثناء لنفسه؟
Dialogue: 0,0:14:42.98,0:14:44.85,Default,,0000,0000,0000,,!لن يفعل كونان-كن شيئاً كذاك أبداً
Dialogue: 0,0:14:52.76,0:14:53.97,Default,,0000,0000,0000,,!هذه هي
Dialogue: 0,0:14:57.93,0:15:00.26,Default,,0000,0000,0000,,!هكذا إذاً! كنتُ محقاً
Dialogue: 0,0:15:02.42,0:15:05.81,Default,,0000,0000,0000,,توجد آلة ردّ آلي وجهاز تسجيل فيديو في هذه الغرفة
Dialogue: 0,0:15:07.58,0:15:08.27,Default,,0000,0000,0000,,!تباً
Dialogue: 0,0:15:11.91,0:15:13.28,Default,,0000,0000,0000,,...غريب
Dialogue: 0,0:15:13.28,0:15:17.31,Default,,0000,0000,0000,,،ظننتُ أنّي سمعت شيئاً هنا\N...لكن لعلّها كانت مخيلتي
Dialogue: 0,0:15:18.41,0:15:20.93,Default,,0000,0000,0000,,!تأخرّت يا كونان! ما الذي تفعله؟
Dialogue: 0,0:15:21.27,0:15:22.89,Default,,0000,0000,0000,,!من هناك؟
Dialogue: 0,0:15:22.89,0:15:24.90,Default,,0000,0000,0000,,!من يوجد هناك؟
Dialogue: 0,0:15:24.90,0:15:26.14,Default,,0000,0000,0000,,!تـ-تباً
Dialogue: 0,0:15:26.14,0:15:27.56,Default,,0000,0000,0000,,!يبدو أنّه وجده
Dialogue: 0,0:15:27.56,0:15:28.86,Default,,0000,0000,0000,,!اهرب يا كونان-كن
Dialogue: 0,0:15:29.27,0:15:31.30,Default,,0000,0000,0000,,!لا جدوى من الاختباء
Dialogue: 0,0:15:31.30,0:15:33.60,Default,,0000,0000,0000,,!استسلم واخرج
Dialogue: 0,0:15:33.60,0:15:38.85,Default,,0000,0000,0000,,اللعنة، لا خيار لديّ الآن سوى\Nترك جهاز الإرسال يعمل
Dialogue: 0,0:15:38.85,0:15:41.47,Default,,0000,0000,0000,,أنت من عليه الاستسلام يا تاناكا-سان
Dialogue: 0,0:15:42.84,0:15:45.52,Default,,0000,0000,0000,,لم نجد لا نحن ولا الشرطة الجثّة
Dialogue: 0,0:15:45.79,0:15:50.10,Default,,0000,0000,0000,,لكنّها كانت في المنزل طوال الوقت وأمام أنظارنا
Dialogue: 0,0:15:50.33,0:15:51.24,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:15:51.24,0:15:55.02,Default,,0000,0000,0000,,الجثّة التي أشير لها هي هذا الرجل\Nالذي كان جالساً في هذه الغرفة
Dialogue: 0,0:15:55.37,0:15:56.58,Default,,0000,0000,0000,,...ويشاهد التلفاز
Dialogue: 0,0:15:56.58,0:15:58.02,Default,,0000,0000,0000,,!أخوك الأكبر
Dialogue: 0,0:15:59.16,0:16:00.14,Default,,0000,0000,0000,,!من أنت؟
Dialogue: 0,0:16:04.52,0:16:06.56,Default,,0000,0000,0000,,إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:16:07.02,0:16:08.69,Default,,0000,0000,0000,,مُتحرٍّ؟
Dialogue: 0,0:16:09.27,0:16:11.68,Default,,0000,0000,0000,,...هكذا كانت الحيلة التي وضعتها
Dialogue: 0,0:16:13.10,0:16:16.19,Default,,0000,0000,0000,,،بعدما ضبطتنا نكتشف جثّة أخيك
Dialogue: 0,0:16:16.47,0:16:18.89,Default,,0000,0000,0000,,غسلت الدمّ عنه في الحمام
Dialogue: 0,0:16:18.89,0:16:21.39,Default,,0000,0000,0000,,وألبسته ثوب استحمام وأجلسته منتصباً \Nعلى كرسيّ في الطابق العلوي
Dialogue: 0,0:16:22.09,0:16:25.27,Default,,0000,0000,0000,,ثمّ نزلت للتحدث مع الشرطة\Nالتي أتت تبحث عن الجثة
Dialogue: 0,0:16:25.75,0:16:29.27,Default,,0000,0000,0000,,تنكّرت بمنظر أخيك الذي قتلته بكلّ جرأة
Dialogue: 0,0:16:29.95,0:16:32.22,Default,,0000,0000,0000,,فأنتما شقيقان شبيها الملامح في الأصل
Dialogue: 0,0:16:32.74,0:16:34.35,Default,,0000,0000,0000,,،كان الأقارب ليميّزوا بينكما
Dialogue: 0,0:16:34.35,0:16:36.19,Default,,0000,0000,0000,,لكن يمكن خداع البقية بتنكر بسيط
Dialogue: 0,0:16:36.87,0:16:40.44,Default,,0000,0000,0000,,،بعدها، بينما أخذت الشرطة تبحث في المنزل
Dialogue: 0,0:16:40.44,0:16:43.89,Default,,0000,0000,0000,,،قفزت من نافذة الطابق الثاني للشجرة\Nثمّ فوق الحائط
Dialogue: 0,0:16:43.89,0:16:45.86,Default,,0000,0000,0000,,الجانب الخارجي يؤدي دور سدّ
Dialogue: 0,0:16:45.86,0:16:48.61,Default,,0000,0000,0000,,لكن كانت هناك مساحة كافية\Nليمشي شخص واحد
Dialogue: 0,0:16:50.10,0:16:52.60,Default,,0000,0000,0000,,...رجعت بعدها للباب الأمامي بصفة الأخ الأصغر
Dialogue: 0,0:16:52.85,0:16:56.56,Default,,0000,0000,0000,,!وتظاهرت بجهلك لما حصل
Dialogue: 0,0:16:58.72,0:17:00.81,Default,,0000,0000,0000,,ماذا؟ وجدتم الجثة؟
Dialogue: 0,0:17:00.81,0:17:02.26,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:17:02.26,0:17:03.71,Default,,0000,0000,0000,,كان الأخ الأصغر القاتل
Dialogue: 0,0:17:03.71,0:17:06.27,Default,,0000,0000,0000,,!والأخ الأكبر النائم كان الجثّة
Dialogue: 0,0:17:06.51,0:17:10.16,Default,,0000,0000,0000,,يا للسخافة، كان حيّاً
Dialogue: 0,0:17:10.16,0:17:13.25,Default,,0000,0000,0000,,أطفأ التلفاز عندما طلب منه شقيقه
Dialogue: 0,0:17:13.25,0:17:17.69,Default,,0000,0000,0000,,كما أنّه صرخ عندما حطمتم تلك الجرّة
Dialogue: 0,0:17:18.25,0:17:22.89,Default,,0000,0000,0000,,صحيح، حاولت جعل الأمر\Nكما لو كان أخوك حيّاً
Dialogue: 0,0:17:23.78,0:17:26.07,Default,,0000,0000,0000,,واستعملت جهاز تسجيل الفيديو وآلة الردّ الآلي
Dialogue: 0,0:17:26.07,0:17:29.11,Default,,0000,0000,0000,,وهاتفك الخلوي لتحقيق ذلك
Dialogue: 0,0:17:30.39,0:17:33.81,Default,,0000,0000,0000,,كان ذاك الصراخ تسجيلاً أرسلته\Nلآلة الردّ الآلي
Dialogue: 0,0:17:33.81,0:17:35.68,Default,,0000,0000,0000,,قبل وصول الشرطة
Dialogue: 0,0:17:35.68,0:17:38.27,Default,,0000,0000,0000,,شغلّته على آلة الرد باستعمال خاصية
Dialogue: 0,0:17:38.27,0:17:40.93,Default,,0000,0000,0000,,الاتصال السريع لهاتفك الخلوي\Nفي الوقت المناسب
Dialogue: 0,0:17:42.38,0:17:46.55,Default,,0000,0000,0000,,أطفأت رنين كلّ الهواتف سلفاً بالطبع
Dialogue: 0,0:17:46.55,0:17:50.26,Default,,0000,0000,0000,,لجعل الأمر كما لو أنّ أخاك يصرخ من الأعلى
Dialogue: 0,0:17:51.60,0:17:55.58,Default,,0000,0000,0000,,!أنتم! اخرسوا! ألا يمكنكم التزام الهدوء؟
Dialogue: 0,0:17:55.58,0:17:58.81,Default,,0000,0000,0000,,ودليلاً لذلك، أجبت على الهاتف\N،الذي لم يصدر رنيناً
Dialogue: 0,0:17:59.08,0:18:01.11,Default,,0000,0000,0000,,.عندما ورد اتّصال خاطئ بالصدفة
Dialogue: 0,0:18:01.11,0:18:05.06,Default,,0000,0000,0000,,رأيت وميض الهاتف عندما ورد الاتصال على الأرجح
Dialogue: 0,0:18:05.74,0:18:09.28,Default,,0000,0000,0000,,...لو لم تجب، كانت آلة الردّ الآلي لتستجيب
Dialogue: 0,0:18:09.28,0:18:13.02,Default,,0000,0000,0000,,...ونسمع ذاك الصراخ مجدداً
Dialogue: 0,0:18:13.48,0:18:15.26,Default,,0000,0000,0000,,أجل، هكذا
Dialogue: 0,0:18:18.77,0:18:22.68,Default,,0000,0000,0000,,!أنتم! اخرسوا! ألا يمكنكم التزام الهدوء؟
Dialogue: 0,0:18:22.68,0:18:27.43,Default,,0000,0000,0000,,أطفئ التلفاز لأنك ضبطت مؤقت\Nجهاز تسجيل الفيديو سلفاً
Dialogue: 0,0:18:27.43,0:18:29.40,Default,,0000,0000,0000,,ثم أكملت الأمر بتمثيلك
Dialogue: 0,0:18:29.76,0:18:32.35,Default,,0000,0000,0000,,أليس ذلك صحيحاً يا تاناكا توموفومي-سان؟
Dialogue: 0,0:18:34.31,0:18:37.50,Default,,0000,0000,0000,,!بسرعة! قد يحلّ مكروه بكونان-كن إلم تسرعوا
Dialogue: 0,0:18:37.50,0:18:40.28,Default,,0000,0000,0000,,يا إلهي، هلا توقفتم؟ سأغلق الهاتف
Dialogue: 0,0:18:40.28,0:18:42.56,Default,,0000,0000,0000,,يا لك من صبيّ حذق
Dialogue: 0,0:18:43.28,0:18:46.85,Default,,0000,0000,0000,,...صحيح، أنا، أنا
Dialogue: 0,0:18:46.85,0:18:50.35,Default,,0000,0000,0000,,!قتلتُ أخي
Dialogue: 0,0:18:53.15,0:18:56.27,Default,,0000,0000,0000,,!تباً! أين ذهب؟
Dialogue: 0,0:18:56.27,0:18:57.81,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:19:06.26,0:19:09.05,Default,,0000,0000,0000,,كان يستغلّني
Dialogue: 0,0:19:09.05,0:19:14.43,Default,,0000,0000,0000,,،يبقى في منزلي ويرفض العمل\N!ذاك الأخ عديم النفع
Dialogue: 0,0:19:15.67,0:19:20.12,Default,,0000,0000,0000,,...وجدتُ هذه الوثائق في غرفتك يا توموفومي
Dialogue: 0,0:19:20.12,0:19:23.41,Default,,0000,0000,0000,,إنّها أوراق مالية متداولة مخالفة للنظام، صحيح؟
Dialogue: 0,0:19:23.41,0:19:28.10,Default,,0000,0000,0000,,لا تقلق، نحن أخوان فلن أفضحك
Dialogue: 0,0:19:28.95,0:19:33.27,Default,,0000,0000,0000,,لكن في المقابل، ستعتني بي لبقيّة حياتي، صحيح؟
Dialogue: 0,0:19:35.02,0:19:37.52,Default,,0000,0000,0000,,...اعتنيتُ به مذ آنذاك
Dialogue: 0,0:19:37.52,0:19:40.81,Default,,0000,0000,0000,,!لكنه أصبح يطالب بمال أكثر مني
Dialogue: 0,0:19:41.72,0:19:45.89,Default,,0000,0000,0000,,!لذا سحقتُ رأس ذاك الطفيليّ
Dialogue: 0,0:19:47.43,0:19:52.22,Default,,0000,0000,0000,,أيّها الشقي الصغير! من المستحيل\N!أن تفهم مشاعري
Dialogue: 0,0:19:53.17,0:19:56.38,Default,,0000,0000,0000,,أحببتُ أخي أكثر من أيّ أحد
Dialogue: 0,0:19:56.38,0:20:02.10,Default,,0000,0000,0000,,أخي غزير الموهبة الذي كوفئ\N!كروائي صاعد جديد
Dialogue: 0,0:20:03.99,0:20:08.02,Default,,0000,0000,0000,,!تنكّر كأخيه الأكبر! إنه يفقد صوابه حقاً
Dialogue: 0,0:20:09.16,0:20:12.97,Default,,0000,0000,0000,,...كان أخي مثلي الأعلى
Dialogue: 0,0:20:14.15,0:20:18.86,Default,,0000,0000,0000,,...لطالما أردتُ أن أصبح مثله
Dialogue: 0,0:20:18.86,0:20:21.60,Default,,0000,0000,0000,,!لكنّه ضاعَ وتاه
Dialogue: 0,0:20:21.60,0:20:26.69,Default,,0000,0000,0000,,!الأخ الذي وضعته مثالاً لي أصبح مجرّد طفيليّ
Dialogue: 0,0:20:27.81,0:20:30.89,Default,,0000,0000,0000,,!سأستعيد الأخ الذي تطلّعت له
Dialogue: 0,0:20:33.09,0:20:37.02,Default,,0000,0000,0000,,...أتفهم؟ أنا... أنا
Dialogue: 0,0:20:38.21,0:20:40.68,Default,,0000,0000,0000,,!سأصبح أخي...
Dialogue: 0,0:20:44.33,0:20:45.48,Default,,0000,0000,0000,,!غضبتُ الآن
Dialogue: 0,0:20:46.20,0:20:49.59,Default,,0000,0000,0000,,!سأستعمل حذاء مضاعفة قوّة الركل هذا لحسم الأمر
Dialogue: 0,0:20:55.15,0:20:59.32,Default,,0000,0000,0000,,!كلا! ركلاتي قويّة جداً بحيث تفتت الخضروات
Dialogue: 0,0:20:59.32,0:21:00.76,Default,,0000,0000,0000,,ألا يوجد شيءٌ آخر؟
Dialogue: 0,0:21:02.72,0:21:06.60,Default,,0000,0000,0000,,لا يمكنني تركك حيّاً بعدما كشفت حيلتي
Dialogue: 0,0:21:06.60,0:21:09.31,Default,,0000,0000,0000,,!آسف يا فتى، لكنك ستموت
Dialogue: 0,0:23:04.17,0:23:06.69,Default,,0000,0000,0000,,وصلت الشرطة بعد ذلك بفترة قصيرة
Dialogue: 0,0:23:06.88,0:23:09.76,Default,,0000,0000,0000,,ورجعت ثقة المفتش بنا
Dialogue: 0,0:23:10.16,0:23:14.24,Default,,0000,0000,0000,,وحُلّت القضيّة التي بدأت بالبحث عن قطّة
Dialogue: 0,0:23:14.24,0:23:15.26,Default,,0000,0000,0000,,...ثمّ
Dialogue: 0,0:23:18.70,0:23:21.65,Default,,0000,0000,0000,,...لا عملاء كالمعتاد
Dialogue: 0,0:23:21.65,0:23:26.10,Default,,0000,0000,0000,,...تبّاً، حتى الإمساك بمجرم لم يساعد
Dialogue: 0,0:23:26.44,0:23:27.82,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:23:27.82,0:23:30.93,Default,,0000,0000,0000,,...اختفت قطّتي مجدداً
Dialogue: 0,0:23:33.89,0:23:37.27,Default,,0000,0000,0000,,قد يكون هذا مرتبطاً بحادثة أخرى
Dialogue: 0,0:23:37.27,0:23:39.55,Default,,0000,0000,0000,,أجل، فتلك ليست قطّةً عادية
Dialogue: 0,0:23:39.55,0:23:41.09,Default,,0000,0000,0000,,!لنقبل بها
Dialogue: 0,0:23:41.09,0:23:43.52,Default,,0000,0000,0000,,أجل، فلا شيء لدينا لنفعله
Dialogue: 0,0:23:43.80,0:23:47.34,Default,,0000,0000,0000,,،اتّضح لاحقاً أنّ قطّة هيروكي، أكيرا\Nلم تكن سوى مجرّد قطّة مشاغبة
Dialogue: 0,0:23:47.34,0:23:49.97,Default,,0000,0000,0000,,تحب التسلل لمختلف الأماكن
Dialogue: 0,0:23:50.50,0:23:54.24,Default,,0000,0000,0000,,ولم تقدنا لأيّ قضايا أخرى
Dialogue: 0,0:24:10.48,0:24:13.35,Default,,0000,0000,0000,,كان زوجك سيّافاً، أليس كذلك؟
Dialogue: 0,0:24:14.27,0:24:17.60,Default,,0000,0000,0000,,مما يعني أنّ القاتل كان \Nسيّافاً بارعاً بدوره
Dialogue: 0,0:24:17.60,0:24:20.81,Default,,0000,0000,0000,,لا يملك أيّ من الزوّار الثلاثة حجّة غياب
Dialogue: 0,0:24:20.81,0:24:23.77,Default,,0000,0000,0000,,!اعترفت بأنّك القاتل في رسالتك
Dialogue: 0,0:24:24.76,0:24:26.05,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.05,0:24:28.80,Default,,0000,0000,0000,,جريمة قتل جامع الآثار
Dialogue: 0,0:24:45.53,0:24:47.53,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.53,0:24:49.34,Default,,0000,0000,0000,,خدوش على خزانة
Dialogue: 0,0:24:49.34,0:24:51.33,Default,,0000,0000,0000,,

