Dialogue: 0,0:00:01.69,0:00:04.29,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:05.01,0:00:07.10,Default,,0000,0000,0000,,تقع قضيّة اليوم داخل منزل جبليّ\N!في عاصفة ثلجية
Dialogue: 0,0:00:07.10,0:00:09.00,Default,,0000,0000,0000,,!لا يبقى الضحيّة المقتول صامتاً
Dialogue: 0,0:00:09.00,0:00:11.34,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.34,0:00:13.25,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.25,0:00:15.58,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.98,0:01:52.08,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل منزل الجبل الثلجي
Dialogue: 0,0:01:47.05,0:01:49.83,Default,,0000,0000,0000,,جريمة قتل منزل الجبل الثلجي
Dialogue: 0,0:01:52.19,0:01:53.78,Default,,0000,0000,0000,,!مرحى
Dialogue: 0,0:01:56.66,0:01:59.16,Default,,0000,0000,0000,,ماذا؟ لن تتزلّج يا أبي؟
Dialogue: 0,0:01:59.16,0:02:00.37,Default,,0000,0000,0000,,حمقاء
Dialogue: 0,0:02:00.37,0:02:06.28,Default,,0000,0000,0000,,أنا آخذ وقتي في الاستمتاع\Nبمنظر هذه السماء الصافية أوّلاً
Dialogue: 0,0:02:06.90,0:02:11.25,Default,,0000,0000,0000,,كما هذا الكساء الثلجي الباهر ناصع البياض
Dialogue: 0,0:02:18.52,0:02:22.15,Default,,0000,0000,0000,,تبّاً، كنتُ أعرف أنّه لم يجدر بي القدوم
Dialogue: 0,0:02:23.63,0:02:26.84,Default,,0000,0000,0000,,ماذا؟ فقدت مفتاح المقصورة المستأجرة؟
Dialogue: 0,0:02:26.84,0:02:29.79,Default,,0000,0000,0000,,يا إلهي، هذا بسبب ما فعلتماه
Dialogue: 0,0:02:30.21,0:02:35.07,Default,,0000,0000,0000,,بأيّ حال، كلّ ما يمكننا فعله هو الاتّصال \Nبالمشرف وطلب مفتاح بديل
Dialogue: 0,0:02:35.07,0:02:37.83,Default,,0000,0000,0000,,لا توجد حُجر هواتف في هذه المنطقة
Dialogue: 0,0:02:37.83,0:02:39.66,Default,,0000,0000,0000,,والمقصورة مقابلنا لا تزال قيد البناء
Dialogue: 0,0:02:39.66,0:02:41.37,Default,,0000,0000,0000,,وحافلة التزلج غادرت بالفعل
Dialogue: 0,0:02:43.82,0:02:46.57,Default,,0000,0000,0000,,ما بقربنا هو ذاك المنزل فحسب
Dialogue: 0,0:02:46.84,0:02:52.53,Default,,0000,0000,0000,,!أطلب مساعدة وغد ثريّ يبني منزلاً هنا؟ مستحيل
Dialogue: 0,0:02:53.39,0:02:55.43,Default,,0000,0000,0000,,!لا خيار آخر، سنفتحه بالقوّة
Dialogue: 0,0:02:55.43,0:02:56.39,Default,,0000,0000,0000,,!لا تفعل يا عمّ
Dialogue: 0,0:02:55.43,0:02:56.39,Default,,0000,0000,0000,,!كلا يا أبي
Dialogue: 0,0:02:56.39,0:02:59.12,Default,,0000,0000,0000,,...ماذا؟ أيمكن أنّك
Dialogue: 0,0:03:00.10,0:03:03.86,On Top,,0000,0000,0000,,إنّه أنت بالفعل، المتحرّي موري كوغورو-سان
Dialogue: 0,0:03:02.94,0:03:08.41,CharCard,,0000,0000,0005,,{\fad(300,0)}(أوياما ماساشي (53\Nبروفسور في كليّة الطب لجامعة توتو، قسم الجراحة
Dialogue: 0,0:03:03.86,0:03:08.41,On Top,,0000,0000,0000,,!أقرأ دائماً عن تحريّاتك المذهلة في الصحف
Dialogue: 0,0:03:08.41,0:03:11.37,Default,,0000,0000,0000,,!يا للمنزل الجميل
Dialogue: 0,0:03:11.80,0:03:15.16,Default,,0000,0000,0000,,!تصميمٌ ولون خشبيّ يخطف الأنظار
Dialogue: 0,0:03:15.16,0:03:18.62,Default,,0000,0000,0000,,ألم تكن من ينعت الوغد الثريّ قبل قليل؟
Dialogue: 0,0:03:19.00,0:03:22.99,Default,,0000,0000,0000,,بالمناسبة، لم أتعرف على اسمك بعد
Dialogue: 0,0:03:22.99,0:03:24.99,Default,,0000,0000,0000,,أأنتِ ابنة موري-سان؟
Dialogue: 0,0:03:24.99,0:03:27.49,Default,,0000,0000,0000,,أجل، أُدعى ران
Dialogue: 0,0:03:27.49,0:03:31.70,Default,,0000,0000,0000,,هذا إيدوغاوا كونان-كن، ابن أحد الأصدقاء نعتني به
Dialogue: 0,0:03:33.10,0:03:37.41,Default,,0000,0000,0000,,!تصميم الأسد على الباب رائع أيضاً
Dialogue: 0,0:03:38.85,0:03:40.77,Default,,0000,0000,0000,,أردتُ حصاناً
Dialogue: 0,0:03:40.77,0:03:42.82,Default,,0000,0000,0000,,لكن ربما طلبتُ الكثير
Dialogue: 0,0:03:43.18,0:03:44.28,Default,,0000,0000,0000,,حصان؟
Dialogue: 0,0:03:44.28,0:03:47.74,Default,,0000,0000,0000,,صـ-صحيح، الحصان أفضل من الأسد
Dialogue: 0,0:03:47.74,0:03:50.34,Default,,0000,0000,0000,,...كلا، لم أقصد ذلك
Dialogue: 0,0:03:50.34,0:03:51.90,Default,,0000,0000,0000,,!دكتور أوياما
Dialogue: 0,0:03:52.31,0:03:53.36,Default,,0000,0000,0000,,ناكاهارا-كن؟
Dialogue: 0,0:03:53.54,0:03:57.78,CharCard,,0000,0000,0005,,{\fad(300,0)}(ناكاهارا كاوري (30\Nباحثة في كليّة الطب لجامعة توتو، قسم الجراحة
Dialogue: 0,0:03:53.75,0:03:55.08,On Top,,0000,0000,0000,,!تأخّرت
Dialogue: 0,0:03:55.08,0:03:57.42,On Top,,0000,0000,0000,,كان الجميع بانتظارك
Dialogue: 0,0:03:57.42,0:03:58.83,On Top,,0000,0000,0000,,من الأشخاص رفقتك؟
Dialogue: 0,0:03:59.78,0:04:03.28,Default,,0000,0000,0000,,أصدقاء قابلتهم للتوّ
Dialogue: 0,0:04:04.86,0:04:09.07,Default,,0000,0000,0000,,ماذا؟ أنتم أطّباء في نفس الجامعة إذاً
Dialogue: 0,0:04:09.07,0:04:13.70,Default,,0000,0000,0000,,أجل، جميعنا مساعدون للدكتور أوياما
Dialogue: 0,0:04:14.19,0:04:16.98,On Top,,0000,0000,0000,,فالأطبّاء يميلون للتجمّع تحت راية
Dialogue: 0,0:04:14.74,0:04:20.96,CharCard,,0000,0000,0005,,{\fad(300,0)}(كانازاوا توموياسو (48\N بروفسور مساعدة في كليّة الطب لجامعة توتو، قسم الجراحة
Dialogue: 0,0:04:16.98,0:04:21.62,On Top,,0000,0000,0000,,أنا أدرس تحت جناح الدكتور منذ عشرات الأعوام
Dialogue: 0,0:04:22.05,0:04:27.89,On Top,,0000,0000,0000,,انتقلتُ هنا قبل 3 أعوام من بروفسور أضعف مستقبلاً
Dialogue: 0,0:04:22.56,0:04:29.28,CharCard,,0000,0000,0005,,{\fad(300,0)}(توبيتا غينجي (31\Nباحث في كليّة الطب لجامعة توتو، قسم الجراحة
Dialogue: 0,0:04:27.89,0:04:30.08,On Top,,0000,0000,0000,,أشعر بالسرور لكوني حيث أنا الآن
Dialogue: 0,0:04:30.08,0:04:35.28,On Top,,0000,0000,0000,,البحث الذي نشره قبل بضعة أيّام كان مذهلاً
Dialogue: 0,0:04:30.23,0:04:35.28,CharCard,,0000,0000,0005,,{\fad(300,0)}(إيزومي كاهو (30\Nباحثة في كليّة الطب لجامعة توتو، قسم الجراحة
Dialogue: 0,0:04:35.28,0:04:41.87,Default,,0000,0000,0000,,تقصدين "المداواة الجينية كعلاج\Nلسرطان الأمعاء الغليظة"، صحيح؟
Dialogue: 0,0:04:41.87,0:04:45.24,Default,,0000,0000,0000,,كليّة الطب بأسرها تُطري على بحثه الآن
Dialogue: 0,0:04:45.24,0:04:49.45,Default,,0000,0000,0000,,كان أمراً يسيراً بعقلي
Dialogue: 0,0:04:52.90,0:04:54.24,Default,,0000,0000,0000,,شكراً على الطعام
Dialogue: 0,0:04:54.24,0:04:58.73,Default,,0000,0000,0000,,كلا! نسيتُ شراء أكلات خفيفة مع الساكي
Dialogue: 0,0:05:00.44,0:05:03.18,Default,,0000,0000,0000,,سأذهب لشراء بعضها من المتجر أسفل الجبل
Dialogue: 0,0:05:03.18,0:05:04.61,Default,,0000,0000,0000,,هلّا جلبتِ رقائق بطاطا؟
Dialogue: 0,0:05:04.61,0:05:05.68,Default,,0000,0000,0000,,!حبّار مجفف لي
Dialogue: 0,0:05:05.68,0:05:06.66,Default,,0000,0000,0000,,!أنا أريد سلطة
Dialogue: 0,0:05:07.01,0:05:10.39,Default,,0000,0000,0000,,حسناً، حسناً، اكتبوا كيلا أنسى طلباتكم
Dialogue: 0,0:05:10.39,0:05:11.16,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:05:14.34,0:05:17.84,Default,,0000,0000,0000,,!يغلق متجر البقّالة ذاك قبل العاشرة لذا أسرعي
Dialogue: 0,0:05:17.84,0:05:19.55,Default,,0000,0000,0000,,أجل، أعرف
Dialogue: 0,0:05:20.95,0:05:23.45,Default,,0000,0000,0000,,ما الوقت الآن؟
Dialogue: 0,0:05:23.45,0:05:25.32,Default,,0000,0000,0000,,...الثامنة وثمان وخمسون
Dialogue: 0,0:05:25.32,0:05:25.82,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:05:29.49,0:05:30.45,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:05:30.45,0:05:31.70,Default,,0000,0000,0000,,مسلسل تلفازي
Dialogue: 0,0:05:32.48,0:05:36.52,Default,,0000,0000,0000,,إنّه مدمن على ميلودراما \Nنسبة مشاهداتها 30% الآن
Dialogue: 0,0:05:36.52,0:05:38.94,Default,,0000,0000,0000,,!أشاهدها أيضاً
Dialogue: 0,0:05:38.94,0:05:41.62,Default,,0000,0000,0000,,ماذا؟ أين تذهب يا دكتور توبيتا؟
Dialogue: 0,0:05:42.81,0:05:44.06,Default,,0000,0000,0000,,تزلّج ليلي
Dialogue: 0,0:05:45.43,0:05:47.17,Default,,0000,0000,0000,,فلم أتزلّج بعد
Dialogue: 0,0:05:48.68,0:05:50.43,Default,,0000,0000,0000,,سأعود قبل الحادية عشرة
Dialogue: 0,0:05:55.30,0:05:57.96,Default,,0000,0000,0000,,سآخذ حماماً دافئاً باسترخاء
Dialogue: 0,0:05:57.96,0:06:01.45,Default,,0000,0000,0000,,حتى وصول الأكلات الخفيفة إذاً
Dialogue: 0,0:06:01.45,0:06:05.82,Default,,0000,0000,0000,,هل اتّصلتِ بمشرف المقصورة بشأن مفتاحنا؟
Dialogue: 0,0:06:07.04,0:06:08.74,Default,,0000,0000,0000,,!نسيتُ تماماً
Dialogue: 0,0:06:08.74,0:06:11.90,Default,,0000,0000,0000,,!لا بأس، يمكنكم المبيت هنا
Dialogue: 0,0:06:12.61,0:06:16.36,Default,,0000,0000,0000,,فلا تستطيعون العودة بحال أبيك
Dialogue: 0,0:06:19.90,0:06:21.86,Default,,0000,0000,0000,,سأرمي القمامة
Dialogue: 0,0:06:21.86,0:06:22.82,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:06:27.93,0:06:32.71,On Top,,0000,0000,0000,,!انتظر يا تسوتومو-سان\N!لا تذهب لأيّ مكان
Dialogue: 0,0:06:32.71,0:06:37.28,On Top,,0000,0000,0000,,عليّ ذلك يا ميتسوي-سان، فلا نستطيع البقاء سويّاً أبداً
Dialogue: 0,0:06:37.63,0:06:39.99,On Top,,0000,0000,0000,,!لذا أرجوك، انسي أمري
Dialogue: 0,0:06:39.99,0:06:43.57,On Top,,0000,0000,0000,,!لمَ؟ لمَ لا نستطيع البقاء سويّاً؟
Dialogue: 0,0:06:47.58,0:06:48.74,Default,,0000,0000,0000,,!رجعت
Dialogue: 0,0:06:49.08,0:06:50.25,Default,,0000,0000,0000,,مرحباً بعودتك يا كاوري
Dialogue: 0,0:06:50.25,0:06:54.20,Default,,0000,0000,0000,,لا بدّ أنّك عانيتِ مع العاصفة المفاجئة
Dialogue: 0,0:06:54.70,0:06:56.24,Default,,0000,0000,0000,,!دكتور توبيتا
Dialogue: 0,0:06:56.24,0:07:00.74,Default,,0000,0000,0000,,!يا إلهي، كيف لي أن أتزلّج بتلك العاصفة
Dialogue: 0,0:07:05.10,0:07:06.64,Default,,0000,0000,0000,,!يُدفئني
Dialogue: 0,0:07:06.64,0:07:08.06,Default,,0000,0000,0000,,أتشربون؟
Dialogue: 0,0:07:08.06,0:07:09.60,Default,,0000,0000,0000,,كيف كان حمّامك؟
Dialogue: 0,0:07:09.60,0:07:11.45,Default,,0000,0000,0000,,!رائعاً
Dialogue: 0,0:07:11.45,0:07:14.63,Default,,0000,0000,0000,,...ماذا؟ طلبتُ سلطة
Dialogue: 0,0:07:14.63,0:07:16.91,Default,,0000,0000,0000,,آسفة، نفدتْ
Dialogue: 0,0:07:17.67,0:07:20.05,Default,,0000,0000,0000,,كما لم تكن هناك مثلجات
Dialogue: 0,0:07:20.44,0:07:23.61,Default,,0000,0000,0000,,من طلب مثلجات في هذا الطقس البارد؟
Dialogue: 0,0:07:23.91,0:07:27.83,Default,,0000,0000,0000,,ربما كان الدكتور أوياما، فهو يحبّ المثلجات
Dialogue: 0,0:07:28.71,0:07:30.21,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:07:30.21,0:07:34.28,Default,,0000,0000,0000,,،يُفترض أنّ تلك الدراما تنتهي عند العاشرة\Nألا ترون أنّه تأخّر؟
Dialogue: 0,0:07:34.28,0:07:37.20,Default,,0000,0000,0000,,يسجلها الدكتور أوياما دوماً
Dialogue: 0,0:07:37.20,0:07:39.70,Default,,0000,0000,0000,,ويعيد أفضل المشاهد لاحقاً
Dialogue: 0,0:07:45.10,0:07:50.77,Default,,0000,0000,0000,,،تبّاً لك... كانت هذه نيّتك من البداية\N...قتلي في المنزل الجبلي
Dialogue: 0,0:07:50.77,0:07:54.01,Default,,0000,0000,0000,,!لكن لن تفلت
Dialogue: 0,0:07:54.01,0:07:57.84,Default,,0000,0000,0000,,!فالمتحرّي العظيم موري كوغورو هنا
Dialogue: 0,0:07:57.84,0:08:01.78,Default,,0000,0000,0000,,!سيلاحظ هذه الرسالة بلا شكّ
Dialogue: 0,0:08:02.71,0:08:04.74,Default,,0000,0000,0000,,ماذا؟ موري كوغورو؟
Dialogue: 0,0:08:05.17,0:08:07.09,Default,,0000,0000,0000,,الشخص المذكور دوماً في الصّحف؟
Dialogue: 0,0:08:07.09,0:08:09.20,Default,,0000,0000,0000,,أجل، أبي مُتحرٍّ
Dialogue: 0,0:08:09.67,0:08:11.65,Default,,0000,0000,0000,,تجاوزت الحادية عشرة
Dialogue: 0,0:08:11.65,0:08:14.70,Default,,0000,0000,0000,,أراه تأخّر كثيراً
Dialogue: 0,0:08:14.70,0:08:18.03,Default,,0000,0000,0000,,سأذهب لتفقّد أمره
Dialogue: 0,0:08:19.82,0:08:22.81,Default,,0000,0000,0000,,ماذا؟ إنّه ذاك المتحرّي الشهير؟
Dialogue: 0,0:08:22.81,0:08:24.85,Default,,0000,0000,0000,,المظاهر خدّاعة بالفعل
Dialogue: 0,0:08:26.27,0:08:26.98,Default,,0000,0000,0000,,!كاوري
Dialogue: 0,0:08:28.23,0:08:29.41,Default,,0000,0000,0000,,!ماذا حصل؟
Dialogue: 0,0:08:32.64,0:08:34.70,Default,,0000,0000,0000,,!دكتور أوياما
Dialogue: 0,0:08:38.55,0:08:40.22,Default,,0000,0000,0000,,فات الأوان، فارق الحياة
Dialogue: 0,0:08:40.22,0:08:42.29,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:08:42.29,0:08:44.29,Default,,0000,0000,0000,,لنفك رباط جثّته بأيّ حال
Dialogue: 0,0:08:44.29,0:08:46.78,Default,,0000,0000,0000,,!لا تلمسوه أكثر
Dialogue: 0,0:08:47.00,0:08:51.58,Default,,0000,0000,0000,,لا تخرّبوا مسرح جريمة قتل
Dialogue: 0,0:08:52.12,0:08:54.12,Default,,0000,0000,0000,,أبي! لا يمكن للشرطة أو الإسعاف
Dialogue: 0,0:08:54.12,0:08:56.53,Default,,0000,0000,0000,,!القدوم هنا مع العاصفة
Dialogue: 0,0:08:56.74,0:08:58.82,Default,,0000,0000,0000,,هكذا إذاً، لا خيار لديّ
Dialogue: 0,0:08:58.82,0:09:04.15,Default,,0000,0000,0000,,يبدو أنّ على المتحرّي... العظيم موري كوغورو\N!تولّي المسؤولية هنا
Dialogue: 0,0:09:04.52,0:09:06.37,Default,,0000,0000,0000,,لا تزال ثملاً
Dialogue: 0,0:09:08.23,0:09:10.30,Default,,0000,0000,0000,,سأسأل من باب الحيطة
Dialogue: 0,0:09:10.30,0:09:13.60,Default,,0000,0000,0000,,لم يلمس أحد شيئاً في غرفته، صحيح؟
Dialogue: 0,0:09:13.90,0:09:16.98,Default,,0000,0000,0000,,أجل، لا شيء غير جثّة الطبيب أوياما
Dialogue: 0,0:09:16.98,0:09:20.92,Default,,0000,0000,0000,,أفترض أنّ الأمر ينطبق عليك أيضاً\Nيا مكتشفة الجثّة، ناكاهارا-سان
Dialogue: 0,0:09:20.92,0:09:23.30,Default,,0000,0000,0000,,أجل، رأيته غارقاً في الدماء
Dialogue: 0,0:09:23.30,0:09:25.87,Default,,0000,0000,0000,,وسقطتُ عند الباب
Dialogue: 0,0:09:25.87,0:09:30.22,Default,,0000,0000,0000,,أكان هناك شيءٌ ذو قيمة\Nفي هذه الغرفة؟
Dialogue: 0,0:09:30.22,0:09:33.08,Default,,0000,0000,0000,,يملك خزنةً في الحجرة بجوار التلفاز
Dialogue: 0,0:09:34.13,0:09:35.42,Default,,0000,0000,0000,,هنا؟
Dialogue: 0,0:09:38.33,0:09:40.25,Default,,0000,0000,0000,,إنّها مخدوشة
Dialogue: 0,0:09:40.58,0:09:43.08,Default,,0000,0000,0000,,أتعرفون ما داخل هذه الخزنة؟
Dialogue: 0,0:09:43.74,0:09:45.53,Default,,0000,0000,0000,,مالٌ على الأغلب
Dialogue: 0,0:09:45.53,0:09:49.00,Default,,0000,0000,0000,,فقد كان يحمل مالاً كثيراً باستمرار معه
Dialogue: 0,0:09:50.07,0:09:52.45,Default,,0000,0000,0000,,كانت جريمةً هدفها المال إذاً
Dialogue: 0,0:09:52.77,0:09:54.73,Default,,0000,0000,0000,,ما خطب أثر الدم هذا؟
Dialogue: 0,0:09:54.73,0:09:56.87,Default,,0000,0000,0000,,كأنّه زحف للحائط
Dialogue: 0,0:09:57.40,0:09:59.96,Default,,0000,0000,0000,,ولمَ يجلس برسمية؟
Dialogue: 0,0:10:02.51,0:10:05.08,Default,,0000,0000,0000,,الدم على الطاولة متوقف عند خطّ بوضوح
Dialogue: 0,0:10:05.97,0:10:08.72,Default,,0000,0000,0000,,هكذا إذاً، سقط غطاء الطاولة
Dialogue: 0,0:10:10.35,0:10:12.16,Default,,0000,0000,0000,,علامات من الحبال الدامية؟
Dialogue: 0,0:10:12.42,0:10:17.12,Default,,0000,0000,0000,,أيمكن أنّها رسالة احتضار من أوياما-سان؟
Dialogue: 0,0:10:17.38,0:10:22.91,Default,,0000,0000,0000,,استعمل لاصقاً على النافذة\Nلكتم الصوت إذاً ثم تسلل
Dialogue: 0,0:10:25.28,0:10:29.17,Default,,0000,0000,0000,,كان لطيفاً بما يكفي لترك آثار أقدام خارج النافذة أيضاً
Dialogue: 0,0:10:30.87,0:10:32.73,Default,,0000,0000,0000,,أظنني فهمت الصورة العامة
Dialogue: 0,0:10:33.73,0:10:37.08,Default,,0000,0000,0000,,!بلا همهمة! اخرج
Dialogue: 0,0:10:39.94,0:10:43.60,Default,,0000,0000,0000,,اعذروني، لكن هلّا فحصتموه؟
Dialogue: 0,0:10:43.60,0:10:46.97,Default,,0000,0000,0000,,فأنتم الأطبّاء مؤهلون أكثر منّي
Dialogue: 0,0:10:46.97,0:10:48.00,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:52.05,0:10:53.63,Default,,0000,0000,0000,,فظيع
Dialogue: 0,0:10:53.63,0:10:57.17,Default,,0000,0000,0000,,حتّى ساعته الذهبية العزيزة عليه مغطاة بالدماء
Dialogue: 0,0:10:57.17,0:11:00.13,Default,,0000,0000,0000,,اترك التفاهات جانباً في وقت كهذا
Dialogue: 0,0:11:00.59,0:11:05.08,Default,,0000,0000,0000,,وقت الوفاة المقدّر هو بين\Nالتاسعة والنصف والعاشرة
Dialogue: 0,0:11:05.08,0:11:10.04,Default,,0000,0000,0000,,فهمت، أثناء مشاهدته للدراما التلفزية إذاً؟
Dialogue: 0,0:11:10.04,0:11:10.79,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:10.79,0:11:13.48,Default,,0000,0000,0000,,توجد ندوب قطع على سائر جسده
Dialogue: 0,0:11:13.48,0:11:16.78,Default,,0000,0000,0000,,لكن يبدو أنّه مات اختناقاً
Dialogue: 0,0:11:16.78,0:11:18.98,Default,,0000,0000,0000,,بعد تعرّض كلتا رئتيه للثقب
Dialogue: 0,0:11:18.98,0:11:20.25,Default,,0000,0000,0000,,اختناق؟
Dialogue: 0,0:11:20.94,0:11:22.60,Default,,0000,0000,0000,,بوجود ثقوب في رئتيه
Dialogue: 0,0:11:22.60,0:11:27.27,Default,,0000,0000,0000,,لا يمكنه الاحتفاظ بالهواء\Nللتنفّس بشكل رئيسي
Dialogue: 0,0:11:27.27,0:11:32.41,Default,,0000,0000,0000,,عانى كثيراً من عشر إلى خمس عشرة دقيقة غالباً
Dialogue: 0,0:11:32.41,0:11:33.09,Default,,0000,0000,0000,,!فظيع
Dialogue: 0,0:11:33.09,0:11:34.66,Default,,0000,0000,0000,,!من قد يُقدم على فعلة كهذه؟
Dialogue: 0,0:11:34.66,0:11:38.30,Default,,0000,0000,0000,,كانت جريمةً هدفها المال على الأرجح
Dialogue: 0,0:11:38.30,0:11:40.76,Default,,0000,0000,0000,,،بعد تسلّله عبر النافذة
Dialogue: 0,0:11:40.76,0:11:44.33,Default,,0000,0000,0000,,هاجم القاتل أوياما-سان الذي كان\Nيشاهد التلفاز وقام بتقييده
Dialogue: 0,0:11:44.33,0:11:48.83,Default,,0000,0000,0000,,ثمّ طلب منه توليفة الخزانة، لكنّه رفض البوح
Dialogue: 0,0:11:48.83,0:11:54.25,Default,,0000,0000,0000,,فطعن القاتلُ أوياما-سان غضباً\Nثمّ هرب من النافذة
Dialogue: 0,0:11:54.90,0:11:57.21,Default,,0000,0000,0000,,...لا أمل منه
Dialogue: 0,0:11:58.43,0:12:01.13,Default,,0000,0000,0000,,!لدى هذا الرجل ساعة مذهلة! إنّها لامعة
Dialogue: 0,0:12:01.52,0:12:02.39,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:12:02.39,0:12:04.96,Default,,0000,0000,0000,,كان الرجل مقيّداً، صحيح؟
Dialogue: 0,0:12:04.96,0:12:09.92,Default,,0000,0000,0000,,فهو محظوظ إذاً لأنّ القاتل\Nلم يأخذ ساعته الذهبية
Dialogue: 0,0:12:11.38,0:12:17.42,Default,,0000,0000,0000,,هذا غريب، كيف يتغاضى مجرم\Nهدفه المال عن ساعة كهذه؟
Dialogue: 0,0:12:17.42,0:12:20.25,Default,,0000,0000,0000,,...هذا يعني
Dialogue: 0,0:12:20.25,0:12:24.12,Default,,0000,0000,0000,,!أنّ القاتل غبيّ جداً
Dialogue: 0,0:12:24.83,0:12:28.58,Default,,0000,0000,0000,,لكن ألا تظنون أنّ القاتل جريء؟
Dialogue: 0,0:12:30.46,0:12:33.04,Default,,0000,0000,0000,,!انظروا لآثار الأقدام خارج النافذة
Dialogue: 0,0:12:33.24,0:12:36.62,Default,,0000,0000,0000,,أتى لهذه الغرفة مباشرةً
Dialogue: 0,0:12:37.57,0:12:39.03,Default,,0000,0000,0000,,وما في ذلك؟
Dialogue: 0,0:12:41.13,0:12:43.85,Default,,0000,0000,0000,,لو كنتُ مكانه، لخشيت تواجد\Nشخص آخر في الغرفة
Dialogue: 0,0:12:43.85,0:12:48.71,Default,,0000,0000,0000,,فتفقدت في الأرجاء واسترقت\Nالنظر قبل الدخول
Dialogue: 0,0:12:49.69,0:12:52.16,Default,,0000,0000,0000,,...أبي، أيعني هذا
Dialogue: 0,0:12:52.51,0:12:57.18,Default,,0000,0000,0000,,خدش الخزنة وتقييد أوياما-سان كان تضليلاً
Dialogue: 0,0:12:57.18,0:13:02.16,Default,,0000,0000,0000,,كي نعتقد أنّها جريمة للمال
Dialogue: 0,0:13:02.54,0:13:08.63,Default,,0000,0000,0000,,كان القاتل يعرف أنّ أوياما-سان سيكون\Nأمام التلفاز بمفرده آنذاك
Dialogue: 0,0:13:09.08,0:13:13.58,Default,,0000,0000,0000,,!ما يعني أنّ القاتل أحدكم الأربعة
Dialogue: 0,0:13:14.28,0:13:15.22,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:13:15.22,0:13:16.03,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:16.03,0:13:21.91,Default,,0000,0000,0000,,لنسمع حجج غيابكم من بين\Nالتاسعة والنصف للعاشرة إذاً
Dialogue: 0,0:13:22.27,0:13:25.15,Default,,0000,0000,0000,,كنتُ في المتجر
Dialogue: 0,0:13:25.15,0:13:29.19,Default,,0000,0000,0000,,غادرتُ عند التاسعة ورجعت\Nعند التاسعة والخمسين
Dialogue: 0,0:13:30.10,0:13:36.87,Default,,0000,0000,0000,,من بين الأكلات التي طلبها مني الجميع\Nكانت السلطة والمثلجات وحدهما ما نفدا
Dialogue: 0,0:13:36.87,0:13:39.80,Default,,0000,0000,0000,,لكن كان بإمكانك الانتهاء أبكر\Nإذا أسرعتِ بالقيادة
Dialogue: 0,0:13:39.80,0:13:42.08,Default,,0000,0000,0000,,!تحتاج الرحلة الكاملة ما يفوق 40 دقيقة
Dialogue: 0,0:13:42.63,0:13:45.62,Default,,0000,0000,0000,,!إذا ظننتني أكذب فجرّب بسيارتي
Dialogue: 0,0:13:46.08,0:13:51.09,Default,,0000,0000,0000,,كنتُ خارجاً لتزلّج ليلي، وتستغرق مسافة\Nمنحدر التزلّج 40 دقيقة أيضاً
Dialogue: 0,0:13:51.09,0:13:52.84,Default,,0000,0000,0000,,ألديك دليل لذلك؟
Dialogue: 0,0:13:52.84,0:13:54.20,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:54.62,0:13:57.32,Default,,0000,0000,0000,,تذكرة المصعد تحمل تاريخ اليوم
Dialogue: 0,0:13:57.32,0:13:59.13,Default,,0000,0000,0000,,انظر، بها الوقت حتّى
Dialogue: 0,0:13:59.13,0:14:04.83,Default,,0000,0000,0000,,قمتُ بالتنظيف والغسيل\Nرفقة ران-تشان وكونان-كن
Dialogue: 0,0:14:05.15,0:14:06.44,Default,,0000,0000,0000,,إنّها الحقيقة يا أبي
Dialogue: 0,0:14:06.44,0:14:09.79,Default,,0000,0000,0000,,غادرت بين دقيقتين لثلاث فقط لإخراج القمامة
Dialogue: 0,0:14:09.79,0:14:13.50,Default,,0000,0000,0000,,كنتُ أستحم من التاسعة والنصف\Nحتّى بُعَيد العاشرة
Dialogue: 0,0:14:13.72,0:14:18.01,Default,,0000,0000,0000,,يوجد شخص آخر مع كانازاوا-سان\Nبحجّة غياب ضعيفة
Dialogue: 0,0:14:22.04,0:14:23.25,Default,,0000,0000,0000,,!بـ-بقع دماء؟
Dialogue: 0,0:14:24.09,0:14:27.21,Default,,0000,0000,0000,,ماذا؟ لكن لمَ لا يوجد\Nأيّ منها على الأريكة؟
Dialogue: 0,0:14:27.88,0:14:30.67,Default,,0000,0000,0000,,أوضعها أحد هنا بعد جفاف الدم؟
Dialogue: 0,0:14:31.41,0:14:35.33,Default,,0000,0000,0000,,لحظة، غطاء الطاولة المليء بالدماء... أيمكن؟
Dialogue: 0,0:14:36.62,0:14:39.58,Default,,0000,0000,0000,,مُتطابق، كانت هذه القدّاحة هنا
Dialogue: 0,0:14:41.52,0:14:43.54,Default,,0000,0000,0000,,...أيمكن أنّ هذه
Dialogue: 0,0:14:43.94,0:14:46.19,Default,,0000,0000,0000,,...صحيح، قال أوياما-سان ظهيرة اليوم
Dialogue: 0,0:14:46.19,0:14:50.27,Default,,0000,0000,0000,,أردتُ حصاناً، لكن ربما طلبتُ الكثير
Dialogue: 0,0:14:50.27,0:14:53.54,Default,,0000,0000,0000,,كان ذلك عندما سألني وران عن اسمينا
Dialogue: 0,0:14:54.39,0:14:58.01,Default,,0000,0000,0000,,!فهمت! حصان! كان هذا ما قصده
Dialogue: 0,0:14:58.01,0:15:00.09,Default,,0000,0000,0000,,!هذه رسالة احتضار لأوياما-سان بالفعل
Dialogue: 0,0:15:00.81,0:15:02.42,Default,,0000,0000,0000,,يفسّر ذلك طريقة جلوسه
Dialogue: 0,0:15:02.42,0:15:06.54,Default,,0000,0000,0000,,!والقدّاحة الدامية على الأريكة
Dialogue: 0,0:15:06.88,0:15:10.96,Default,,0000,0000,0000,,...وكما تقول رسالة احتضاره
Dialogue: 0,0:15:10.96,0:15:12.63,Default,,0000,0000,0000,,!القاتل هو ذاك الشخص
Dialogue: 0,0:15:22.23,0:15:24.75,Default,,0000,0000,0000,,انظر يا عمّ، يوجد شيء غريب على الأريكة
Dialogue: 0,0:15:25.19,0:15:27.37,Default,,0000,0000,0000,,!يكفي أيّها الشقيّ
Dialogue: 0,0:15:30.69,0:15:32.17,Default,,0000,0000,0000,,ما الخطب يا أبي؟
Dialogue: 0,0:15:32.17,0:15:34.25,Default,,0000,0000,0000,,أظن أنّه ثمل
Dialogue: 0,0:15:34.97,0:15:37.18,Default,,0000,0000,0000,,!أحمق! لست ثملاً
Dialogue: 0,0:15:37.18,0:15:39.21,Default,,0000,0000,0000,,اكتشفتُ الأمر
Dialogue: 0,0:15:39.21,0:15:42.30,Default,,0000,0000,0000,,ماذا؟ ما الذي اكتشفته؟
Dialogue: 0,0:15:42.30,0:15:48.58,Default,,0000,0000,0000,,القاتل، اكتشفتُ هويّة القاتل\N!الذي طعن أوياما-سان
Dialogue: 0,0:15:50.13,0:15:54.33,Default,,0000,0000,0000,,نبدأ بتوبيتا-سان الذي ذهب لتزلّج ليلي
Dialogue: 0,0:15:54.33,0:15:57.25,Default,,0000,0000,0000,,لن يختلق قصّة كاذبة يمكن التحقق منها بسهولة
Dialogue: 0,0:15:57.91,0:15:59.66,Default,,0000,0000,0000,,التالية إيزومي-سان
Dialogue: 0,0:15:59.66,0:16:02.86,Default,,0000,0000,0000,,تركتِ ران وكونان بين دقيقتين لثلاث فقط
Dialogue: 0,0:16:02.86,0:16:06.25,Default,,0000,0000,0000,,ليس وقتاً كافياً لقتل أوياما-سان
Dialogue: 0,0:16:06.25,0:16:10.71,Default,,0000,0000,0000,,يترك هذا كانازاوا-سان وناكاهارا-سان\Nالاثنين بلا حجّة غياب
Dialogue: 0,0:16:10.71,0:16:15.04,Default,,0000,0000,0000,,...انتظر! اشتريتُ الأكلات كما طلب الجميع
Dialogue: 0,0:16:15.04,0:16:17.75,Default,,0000,0000,0000,,كم كلّفت إذاً؟
Dialogue: 0,0:16:17.75,0:16:20.39,Default,,0000,0000,0000,,!نسيت
Dialogue: 0,0:16:20.39,0:16:23.70,Default,,0000,0000,0000,,كلا، لم تنسي. بل لم تعرفي
Dialogue: 0,0:16:23.70,0:16:29.42,Default,,0000,0000,0000,,لأنّك اشتريتِ كمية كبيرة\Nمن مختلف الأكلات سلفاً
Dialogue: 0,0:16:30.05,0:16:34.46,Default,,0000,0000,0000,,اشتريتِها ظهيرة اليوم عندما ابتعتِ مكوّنات العشاء
Dialogue: 0,0:16:34.46,0:16:38.12,Default,,0000,0000,0000,,قبل الجريمة، أخذتِ طلبات الجميع
Dialogue: 0,0:16:38.12,0:16:41.49,Default,,0000,0000,0000,,وتظاهرتِ بالمغادرة في سيّارتك
Dialogue: 0,0:16:41.49,0:16:44.45,Default,,0000,0000,0000,,توقّفتِ في مكان بعدها
Dialogue: 0,0:16:44.45,0:16:48.61,Default,,0000,0000,0000,,وأخرجتِ الأكلات التي طلبوها
Dialogue: 0,0:16:48.61,0:16:53.33,Default,,0000,0000,0000,,أصبحت لديك حجّة غياب الآن، فقتلتِ أوياما-سان
Dialogue: 0,0:16:53.77,0:16:56.58,Default,,0000,0000,0000,,لا تكن أحمق، لا دليل لديك
Dialogue: 0,0:16:56.58,0:16:59.44,Default,,0000,0000,0000,,كلا، أنت تعرفين أنه يوجد دليل
Dialogue: 0,0:16:59.44,0:17:05.00,Default,,0000,0000,0000,,في هذه الغرفة يثبت أنّك القاتلة
Dialogue: 0,0:17:05.34,0:17:07.96,Default,,0000,0000,0000,,انظروا للطاولة
Dialogue: 0,0:17:07.96,0:17:09.34,Default,,0000,0000,0000,,يتوقف أثر الدماء بوضوح
Dialogue: 0,0:17:09.34,0:17:11.49,Default,,0000,0000,0000,,ألا يبدو كما لو كان هناك شيء عليها؟
Dialogue: 0,0:17:11.92,0:17:13.25,Default,,0000,0000,0000,,!غطاء الطاولة
Dialogue: 0,0:17:13.25,0:17:17.46,Default,,0000,0000,0000,,ضعوه على الطاولة بحيث\Nيطابق بقع الدم رجاءً
Dialogue: 0,0:17:22.36,0:17:26.83,Default,,0000,0000,0000,,إنّها رسالة احتضار أوياما-سان
Dialogue: 0,0:17:27.28,0:17:28.83,Default,,0000,0000,0000,,كيف لهذه أن تكون رسالة؟
Dialogue: 0,0:17:29.07,0:17:35.27,Default,,0000,0000,0000,,تذكّروا، مات أوياما-سان وهو جالس برسميّة
Dialogue: 0,0:17:35.27,0:17:37.94,Default,,0000,0000,0000,,يُفترض أن يتّضح لكم
Dialogue: 0,0:17:37.94,0:17:43.29,Default,,0000,0000,0000,,فبأسمائكم رموز تُستعمل في الشوغي
Dialogue: 0,0:17:43.29,0:17:44.83,Default,,0000,0000,0000,,الشوغي؟
Dialogue: 0,0:17:45.18,0:17:50.26,Default,,0000,0000,0000,,كان الدكتور أوياما يقول دائماً\Nأن حصاناً سيكمل المجموعة
Dialogue: 0,0:17:50.26,0:17:54.27,Default,,0000,0000,0000,,أجل، تشكّلون القطع كاملةً باستثناء الفارس
Dialogue: 0,0:17:55.63,0:18:00.42,Default,,0000,0000,0000,,ران، خذي القدّاحة على الأريكة\Nوضعيها على غطاء الطاولة
Dialogue: 0,0:18:00.42,0:18:01.17,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:18:03.62,0:18:07.87,Default,,0000,0000,0000,,يوجد موضع واحد يطابق فيه الدم\Nعلى القدّاحة الأثر بغطاء الطاولة
Dialogue: 0,0:18:08.57,0:18:09.25,Default,,0000,0000,0000,,هنا
Dialogue: 0,0:18:11.45,0:18:13.91,On Top,,0000,0000,0000,,كاوري
Dialogue: 0,0:18:12.11,0:18:13.91,Default,,0000,0000,0000,,!هذا رمح
Dialogue: 0,0:18:13.91,0:18:17.48,Default,,0000,0000,0000,,صحيح، إنّه موضع بداية الرمح
Dialogue: 0,0:18:17.48,0:18:23.83,Default,,0000,0000,0000,,أي أنّها رسالة احتضار\N!تكشف اسمك يا ناكاهارا كاوري-سان
Dialogue: 0,0:18:23.83,0:18:28.93,Default,,0000,0000,0000,,لكن كيف عرفت ذلك\Nقبل وضع غطاء الطاولة عليها؟
Dialogue: 0,0:18:28.93,0:18:30.54,Default,,0000,0000,0000,,أمعنوا النظر
Dialogue: 0,0:18:30.85,0:18:33.96,Default,,0000,0000,0000,,ذاك المربّع هو الوحيد بأثر دم طويل
Dialogue: 0,0:18:33.96,0:18:37.46,Default,,0000,0000,0000,,أي أنّه كان على حافة الطاولة
Dialogue: 0,0:18:38.71,0:18:39.71,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:18:39.71,0:18:42.49,Default,,0000,0000,0000,,!حصل هذا بمحض المصادفة
Dialogue: 0,0:18:42.49,0:18:45.71,Default,,0000,0000,0000,,لمَ حرّكتِه إذاً؟
Dialogue: 0,0:18:46.67,0:18:49.99,Default,,0000,0000,0000,,ألم تكوني من خلع غطاء الطاولة؟
Dialogue: 0,0:18:49.99,0:18:54.75,Default,,0000,0000,0000,,كلا! حصل ذلك عندما صارع\N!الدكتور أوياما القاتل حتماً
Dialogue: 0,0:18:55.07,0:18:59.82,Default,,0000,0000,0000,,كلا، الدم على الطاولة متوقف بوضوح
Dialogue: 0,0:18:59.82,0:19:04.75,Default,,0000,0000,0000,,ولم يكن هناك أيّ دم على الأريكة\Nالتي كانت القدّاحة عليها
Dialogue: 0,0:19:04.75,0:19:09.49,Default,,0000,0000,0000,,هذا دليل على تحريك أحد لها بعد جفاف الدم
Dialogue: 0,0:19:11.83,0:19:15.96,Default,,0000,0000,0000,,أي أنّ القاتل عاد لمسرح الجريمة
Dialogue: 0,0:19:15.96,0:19:20.23,Default,,0000,0000,0000,,ولاحظ الرسالة وأزاحها
Dialogue: 0,0:19:21.41,0:19:24.82,Default,,0000,0000,0000,,أأنا مخطئ يا ناكاهارا كاوري-سان؟
Dialogue: 0,0:19:24.82,0:19:25.87,Default,,0000,0000,0000,,...كاوري
Dialogue: 0,0:19:25.87,0:19:33.65,Default,,0000,0000,0000,,كان هلاكك في ملاحظتك الرسالة بعد صراخك
Dialogue: 0,0:19:33.65,0:19:35.28,Default,,0000,0000,0000,,...وشيء آخر
Dialogue: 0,0:19:35.28,0:19:39.28,Default,,0000,0000,0000,,قلتِ أنّ السلطة والمثلجات نفدت
Dialogue: 0,0:19:39.28,0:19:42.39,Default,,0000,0000,0000,,...لكن بتجاهل السلطة، يستحيل أن تنفد المثلـ
Dialogue: 0,0:19:42.39,0:19:43.72,Default,,0000,0000,0000,,!يكفي
Dialogue: 0,0:19:44.72,0:19:47.04,Default,,0000,0000,0000,,!صحيح، قتلتُه
Dialogue: 0,0:19:47.04,0:19:49.93,Default,,0000,0000,0000,,لم أقدمتِ على هذا يا كاوري؟
Dialogue: 0,0:19:49.93,0:19:52.34,Default,,0000,0000,0000,,!كنتما على وفاق
Dialogue: 0,0:19:52.34,0:19:55.26,Default,,0000,0000,0000,,أجل، كان كالأب لي
Dialogue: 0,0:19:55.26,0:19:57.04,Default,,0000,0000,0000,,لذا لم أستطع مسامحته
Dialogue: 0,0:19:57.92,0:20:00.91,Default,,0000,0000,0000,,!لم أستطع تصديق سرقته بحثي
Dialogue: 0,0:20:00.91,0:20:02.75,Default,,0000,0000,0000,,...بحثك؟ أتقصدين
Dialogue: 0,0:20:02.75,0:20:05.45,Default,,0000,0000,0000,,المداواة الجينية كعلاج لسرطان"\Nالأمعاء الغليظة" التي نشرها الدكتور؟
Dialogue: 0,0:20:05.69,0:20:08.79,Default,,0000,0000,0000,,!صحيح! سرقه مني
Dialogue: 0,0:20:08.79,0:20:14.09,Default,,0000,0000,0000,,بعدما قضيتُ 6 أعوام في كتابة\N!ذاك البحث بكلّ روحي
Dialogue: 0,0:20:14.94,0:20:20.09,Default,,0000,0000,0000,,...أجل، البحث الذي كتبته لأبي الراحل
Dialogue: 0,0:20:21.32,0:20:26.04,Default,,0000,0000,0000,,مات أبي في صغري من سرطان الأمعاء الغليظة
Dialogue: 0,0:20:26.04,0:20:30.43,Default,,0000,0000,0000,,أصبحتُ طبيبة متخصصة في سرطان الأمعاء الغليظة
Dialogue: 0,0:20:30.43,0:20:33.24,Default,,0000,0000,0000,,كيلا يكون هناك المزيد من الضحايا مثل أبي
Dialogue: 0,0:20:33.24,0:20:40.00,Default,,0000,0000,0000,,مع ذلك، سرق ذاك الرجل \N...البحث مني بعدما أتممته أخيراً
Dialogue: 0,0:20:40.00,0:20:41.21,Default,,0000,0000,0000,,لا جدوى
Dialogue: 0,0:20:41.21,0:20:46.54,Default,,0000,0000,0000,,لن يصغي أحد إن قلتِ أنّها من تأليفك
Dialogue: 0,0:20:46.54,0:20:51.49,Default,,0000,0000,0000,,لكن سينتبه المجتمع إذا نشرها بروفسور شهير
Dialogue: 0,0:20:51.49,0:20:56.25,Default,,0000,0000,0000,,سيكون والدك الراحل أسعد بهذا حتماً
Dialogue: 0,0:20:56.25,0:21:00.20,Default,,0000,0000,0000,,فكّرتُ بهذه الخطة آنذاك
Dialogue: 0,0:21:00.20,0:21:03.44,Default,,0000,0000,0000,,قرّرتُ قتل الرجل الذي داس على مشاعري تجاه أبي
Dialogue: 0,0:21:03.44,0:21:08.21,Default,,0000,0000,0000,,بإحدى أشدّ الطرق ألماً، الموت بثقب الرئتين
Dialogue: 0,0:21:10.64,0:21:13.68,Default,,0000,0000,0000,,لكن لم يخطر لي أن يترك رسالة احتضار
Dialogue: 0,0:21:13.68,0:21:17.62,Default,,0000,0000,0000,,في ربع ساعة المعاناة تلك
Dialogue: 0,0:21:18.26,0:21:19.47,Default,,0000,0000,0000,,لكن أيّها المتحرّي العظيم
Dialogue: 0,0:21:19.47,0:21:22.54,Default,,0000,0000,0000,,كان هناك خطأ في نظريّتك
Dialogue: 0,0:21:22.54,0:21:27.25,Default,,0000,0000,0000,,تكهّنتُ بالسلطة والمثلجات
Dialogue: 0,0:21:27.25,0:21:30.99,Default,,0000,0000,0000,,نفدت السلطة، لكنّي اشتريت المثلجات
Dialogue: 0,0:21:30.99,0:21:32.70,Default,,0000,0000,0000,,لمَ إذاً؟
Dialogue: 0,0:21:33.16,0:21:35.66,Default,,0000,0000,0000,,ذابت داخل السيّارة
Dialogue: 0,0:21:36.57,0:21:39.20,Default,,0000,0000,0000,,جهّزتُ أكلات الجميع
Dialogue: 0,0:21:39.20,0:21:42.10,Default,,0000,0000,0000,,"وأخبرتُ نفسي "حسناً، حان وقت قتله
Dialogue: 0,0:21:42.10,0:21:44.62,Default,,0000,0000,0000,,ثم عادت إليّ ذكريات أبي فجأةً
Dialogue: 0,0:21:45.22,0:21:48.58,Default,,0000,0000,0000,,وبعد شرود ذهني لبرهة، أذابت مدفأة السيّارة المثلجات
Dialogue: 0,0:21:50.84,0:21:54.25,Default,,0000,0000,0000,,...لم أتصوّر أن توقع بي مثلجات ذاك الرجل
Dialogue: 0,0:21:56.89,0:21:58.22,Default,,0000,0000,0000,,!يا للحماقة
Dialogue: 0,0:23:30.84,0:23:35.81,Default,,0000,0000,0000,,رسائل الاحتضار، يُعبّر عنها أحياناً\Nبطرق غير مألوفة
Dialogue: 0,0:23:36.15,0:23:38.34,Default,,0000,0000,0000,,!أطحت بملاكك
Dialogue: 0,0:23:38.34,0:23:40.27,Default,,0000,0000,0000,,!أهدرت قائدك الفضيّ
Dialogue: 0,0:23:40.64,0:23:43.88,Default,,0000,0000,0000,,!رائع! انتهيت الآن
Dialogue: 0,0:23:44.77,0:23:49.07,Default,,0000,0000,0000,,...عندما تغيّر منظورك عن شيء عاديّ أحياناً
Dialogue: 0,0:23:47.74,0:23:49.93,On Top,,0000,0000,0000,,انظر من الأعلى
Dialogue: 0,0:23:52.37,0:23:54.08,On Top,,0000,0000,0000,,أحمق
Dialogue: 0,0:23:53.53,0:23:54.08,Default,,0000,0000,0000,,أحمق؟
Dialogue: 0,0:23:55.07,0:23:56.80,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:24:02.65,0:24:05.35,Default,,0000,0000,0000,,مات في المسبح؟
Dialogue: 0,0:24:05.47,0:24:06.56,Default,,0000,0000,0000,,مات غرقاً
Dialogue: 0,0:24:06.81,0:24:09.81,Default,,0000,0000,0000,,مجرد دخولك الماء سابقاً
Dialogue: 0,0:24:09.81,0:24:11.30,Default,,0000,0000,0000,,!لا يجعلك خبيراً
Dialogue: 0,0:24:12.65,0:24:15.01,Default,,0000,0000,0000,,أرسمت هذه بناءً على ما رأيته من هنا؟
Dialogue: 0,0:24:15.36,0:24:20.56,Default,,0000,0000,0000,,!هذه... فهمت الآن! القاتل هو ذاك الشخص
Dialogue: 0,0:24:20.56,0:24:24.05,Default,,0000,0000,0000,,صحيح، كانت جريمة قتل زُيّفت لتبدو حادثة
Dialogue: 0,0:24:24.46,0:24:25.92,Default,,0000,0000,0000,,في الحلقة القادمة كونان
Dialogue: 0,0:24:25.92,0:24:29.13,Default,,0000,0000,0000,,جريمة قتل نادي الرياضة
Dialogue: 0,0:24:45.52,0:24:48.09,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.09,0:24:50.09,Default,,0000,0000,0000,,قبّعة
Dialogue: 0,0:24:50.29,0:24:52.34,Default,,0000,0000,0000,,تقع أحداث الحلقة القادمة\N!في نادي رياضات شعبيّ
Dialogue: 0,0:24:52.34,0:24:54.12,Default,,0000,0000,0000,,!هيّا يا غينتا، سنركض جولةً أخرى
Dialogue: 0,0:24:54.12,0:24:58.74,Default,,0000,0000,0000,,...لم أعد أستطيع

