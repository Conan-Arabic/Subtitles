Dialogue: 0,0:00:01.21,0:00:02.75,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.75,0:00:05.57,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.57,0:00:07.29,Default,,0000,0000,0000,,!لكن لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:07.29,0:00:09.08,Default,,0000,0000,0000,,باستعمال مهارات تحليلي الحادة
Dialogue: 0,0:00:09.08,0:00:10.74,Default,,0000,0000,0000,,!أحل أي نوع من القضايا
Dialogue: 0,0:00:10.74,0:00:12.52,Default,,0000,0000,0000,,تقع قضية اليوم أثناء مهرجان ربيعي
Dialogue: 0,0:00:12.52,0:00:13.78,Default,,0000,0000,0000,,حتّى لو كانت مخبأة وراء عدسات كاميرا
Dialogue: 0,0:00:13.78,0:00:15.44,Default,,0000,0000,0000,,!تبقى الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.18,0:01:52.19,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل في مهرجان تينكايتشي الليليّ
Dialogue: 0,0:01:47.27,0:01:50.55,Default,,0000,0000,0000,,جريمة قتل في مهرجان تينكايتشي الليليّ
Dialogue: 0,0:01:52.64,0:01:56.38,Default,,0000,0000,0000,,ننتقل الآن لبثّ مباشر لمهرجان\Nتينكايتشي الليلي لمحافظة سايتاما
Dialogue: 0,0:01:56.68,0:01:59.05,Default,,0000,0000,0000,,يشتهر مهرجان تينكايتشي الليلي بنيرانه التي تهجئ
Dialogue: 0,0:01:59.05,0:02:02.13,Default,,0000,0000,0000,,كلمة "تينكايتشي" على ثلاثة جبال متفرقة
Dialogue: 0,0:02:02.13,0:02:04.96,Default,,0000,0000,0000,,!إشعال الأحرف على وشك البدء
Dialogue: 0,0:02:04.96,0:02:08.30,Default,,0000,0000,0000,,!ألا يمكنك البحث بهدوء أكثر؟
Dialogue: 0,0:02:08.30,0:02:11.12,Default,,0000,0000,0000,,يا إلهي، ظننت أنّك ذهبت للمهرجان
Dialogue: 0,0:02:11.12,0:02:13.58,Default,,0000,0000,0000,,وها أنت عدت للبحث عن محفظتك
Dialogue: 0,0:02:13.58,0:02:16.16,Default,,0000,0000,0000,,لا يمكنني الاستحمام باسترخاء حتى
Dialogue: 0,0:02:16.16,0:02:19.27,Default,,0000,0000,0000,,!لم تنس وعدك لليلة، صحيح؟
Dialogue: 0,0:02:19.27,0:02:20.07,Default,,0000,0000,0000,,وعد؟
Dialogue: 0,0:02:20.07,0:02:24.67,Default,,0000,0000,0000,,أنت... أتيت معك لأنّك قلت\N...أنك ستحتفل معي
Dialogue: 0,0:02:25.57,0:02:27.63,Default,,0000,0000,0000,,ما خطب زيّك هذا؟
Dialogue: 0,0:02:27.90,0:02:30.25,Default,,0000,0000,0000,,وماذا حصل هنا؟
Dialogue: 0,0:02:30.64,0:02:33.22,Default,,0000,0000,0000,,آسف، لكن أُلغيت مخططات اليوم
Dialogue: 0,0:02:35.05,0:02:38.93,Default,,0000,0000,0000,,...فالشخص الذي سنحتفل به اليوم
Dialogue: 0,0:02:38.93,0:02:42.30,Default,,0000,0000,0000,,!مهرجان تينكايتشي الليلي لمحافظة سايتاما يُعقد الآن
Dialogue: 0,0:02:42.59,0:02:45.88,Default,,0000,0000,0000,,!انظروا! رُسم رمز "تين" بالنار على الجبل
Dialogue: 0,0:02:46.38,0:02:48.09,Default,,0000,0000,0000,,!ميت
Dialogue: 0,0:02:53.20,0:02:55.78,Default,,0000,0000,0000,,لا تكنّ ضغينةً لي يا إيماتاكي
Dialogue: 0,0:02:59.82,0:03:03.19,Default,,0000,0000,0000,,...بدا أنّه كانت هناك طلقة نارية
Dialogue: 0,0:03:03.19,0:03:05.01,Default,,0000,0000,0000,,!لـ-لـ-لحظة
Dialogue: 0,0:03:31.87,0:03:35.37,Default,,0000,0000,0000,,!اكتملت! أشعلوا رمز "إيتشي" الأخير
Dialogue: 0,0:03:36.95,0:03:38.41,Default,,0000,0000,0000,,أكنت تعرف يا كونان-كن؟
Dialogue: 0,0:03:38.41,0:03:42.99,Default,,0000,0000,0000,,"في هذا المهرجان تُشعل رموز "تينكايتشي
Dialogue: 0,0:03:42.99,0:03:48.09,Default,,0000,0000,0000,,على الجبال الثلاثة بأمل حصاد وفير هذا العام
Dialogue: 0,0:03:50.38,0:03:53.34,Default,,0000,0000,0000,,نسخة تقريباً من مهرجان دايمونجي لكيوتو
Dialogue: 0,0:03:54.23,0:03:58.64,Default,,0000,0000,0000,,من الجميل الإقامة في نُزل\Nوالذهاب لمهرجان من حين لآخر
Dialogue: 0,0:03:59.76,0:04:01.80,Default,,0000,0000,0000,,فعلاً، صحيح يا كونان-كن؟
Dialogue: 0,0:04:02.13,0:04:03.42,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:03.92,0:04:05.80,Default,,0000,0000,0000,,لو لم أكن أحمل هذه
Dialogue: 0,0:04:07.01,0:04:09.71,Default,,0000,0000,0000,,!تعاملني كطفل
Dialogue: 0,0:04:16.08,0:04:17.05,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:04:17.79,0:04:19.61,Default,,0000,0000,0000,,أيمكنك التقاط صورة لي؟
Dialogue: 0,0:04:19.61,0:04:20.96,Default,,0000,0000,0000,,أجل، بالتأكيد
Dialogue: 0,0:04:21.45,0:04:22.92,Default,,0000,0000,0000,,بهذه الكاميرا
Dialogue: 0,0:04:23.53,0:04:25.95,Default,,0000,0000,0000,,أيمكنك التقاطها برمز "إيتشي" ورائي؟
Dialogue: 0,0:04:28.49,0:04:30.34,Default,,0000,0000,0000,,!مستعد؟ سألتقطها
Dialogue: 0,0:04:30.69,0:04:31.68,Default,,0000,0000,0000,,ابدئي
Dialogue: 0,0:04:33.48,0:04:36.06,Default,,0000,0000,0000,,دخل بالون الصورة
Dialogue: 0,0:04:36.06,0:04:37.80,Default,,0000,0000,0000,,لا أمانع، شكراً لك
Dialogue: 0,0:04:38.56,0:04:42.59,Default,,0000,0000,0000,,أكتب حالياً عن مختلف مهرجانات هذه المنطقة
Dialogue: 0,0:04:42.59,0:04:44.76,Default,,0000,0000,0000,,وهذا الغرض من هذه الصور
Dialogue: 0,0:04:45.88,0:04:47.63,Default,,0000,0000,0000,,أنتَ كاتب؟
Dialogue: 0,0:04:47.63,0:04:51.25,Default,,0000,0000,0000,,بشرتك مُسمرة كثيراً فظننتك رياضياً أو ما شابه
Dialogue: 0,0:04:51.71,0:04:56.58,Default,,0000,0000,0000,,هذا بسبب عملي، فأنا أسافر خارج البلاد كثيراً
Dialogue: 0,0:04:56.58,0:04:57.79,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:04:59.03,0:05:01.09,Default,,0000,0000,0000,,يمكنك أخذ هذه
Dialogue: 0,0:05:02.45,0:05:03.61,Default,,0000,0000,0000,,حقاً؟
Dialogue: 0,0:05:04.66,0:05:06.05,Default,,0000,0000,0000,,ساساي نوريكازو
Dialogue: 0,0:05:06.86,0:05:11.00,Default,,0000,0000,0000,,كنتُ أكتب روايات تحت اسم "إيماي توموكازو" المستعار
Dialogue: 0,0:05:11.85,0:05:14.52,Default,,0000,0000,0000,,!سمعتُ به
Dialogue: 0,0:05:14.52,0:05:16.47,Default,,0000,0000,0000,,!قرأتُ الكثير من مؤلفاته في المتوسطة
Dialogue: 0,0:05:17.60,0:05:18.90,Default,,0000,0000,0000,,لكن هذا غريب
Dialogue: 0,0:05:18.90,0:05:23.38,Default,,0000,0000,0000,,ظننت أن إيماتاكي ساتورو استعمل\Nهذا الاسم لعمله الأوّل
Dialogue: 0,0:05:23.84,0:05:26.01,Default,,0000,0000,0000,,أنا وإيماتاكي صديقان قديمان
Dialogue: 0,0:05:26.01,0:05:28.30,Default,,0000,0000,0000,,كنّا نؤلف معاً
Dialogue: 0,0:05:28.87,0:05:30.67,Default,,0000,0000,0000,,مع إيماتاكي ساتورو-سان ذاك؟
Dialogue: 0,0:05:31.13,0:05:33.54,Default,,0000,0000,0000,,أتينا سويّاً اليوم
Dialogue: 0,0:05:33.54,0:05:35.83,Default,,0000,0000,0000,,خطر لنا أن نشرب طول الليل
Dialogue: 0,0:05:35.83,0:05:38.64,Default,,0000,0000,0000,,احتفالاً بفوزه بجائزة ناوموتو
Dialogue: 0,0:05:40.37,0:05:41.49,Default,,0000,0000,0000,,الجوّ حار
Dialogue: 0,0:05:41.49,0:05:43.48,Default,,0000,0000,0000,,اخلع معطفك إذاً إن كان الجوّ حاراً
Dialogue: 0,0:05:45.49,0:05:46.91,Default,,0000,0000,0000,,ستكون هذه صورةً جيّدة
Dialogue: 0,0:05:46.91,0:05:48.39,Default,,0000,0000,0000,,هلّا التقطتِ المزيد لي؟
Dialogue: 0,0:05:48.82,0:05:50.09,Default,,0000,0000,0000,,بالتأكيد
Dialogue: 0,0:05:57.73,0:05:59.80,Default,,0000,0000,0000,,ساساي نوريكازو-سان؟
Dialogue: 0,0:05:59.80,0:06:00.42,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:00.80,0:06:04.22,Default,,0000,0000,0000,,أنا المحقق يوكوميزو من قسم شرطة سايتاما
Dialogue: 0,0:06:04.22,0:06:07.38,Default,,0000,0000,0000,,أودّ سؤالك عن إيماتاكي ساتورو-سان
Dialogue: 0,0:06:08.18,0:06:09.84,Default,,0000,0000,0000,,هل حلّ أمرٌ به؟
Dialogue: 0,0:06:10.42,0:06:11.80,Default,,0000,0000,0000,,لقد قُتل
Dialogue: 0,0:06:12.88,0:06:15.26,Default,,0000,0000,0000,,في غرفة الفندق الذي كنتما تقطنان فيه
Dialogue: 0,0:06:18.38,0:06:19.99,Default,,0000,0000,0000,,كان سلاح الجريمة مسدّساً
Dialogue: 0,0:06:19.99,0:06:22.50,Default,,0000,0000,0000,,وقعت الجريمة بعد دقيقتين أو ثلاث\Nمن الثامنة مساءً
Dialogue: 0,0:06:23.49,0:06:24.91,Default,,0000,0000,0000,,كان المجرم شاباً
Dialogue: 0,0:06:24.91,0:06:28.05,Default,,0000,0000,0000,,هرب من الغرفة بعدها فوراً
Dialogue: 0,0:06:28.62,0:06:30.11,Default,,0000,0000,0000,,أأنتم متأكدون من ذلك؟
Dialogue: 0,0:06:30.11,0:06:35.01,Default,,0000,0000,0000,,أجل، كانت التغطية التلفزية للمهرجان قد بدأت لتوها
Dialogue: 0,0:06:35.98,0:06:39.06,Default,,0000,0000,0000,,أصابه بدقة في رأسه
Dialogue: 0,0:06:39.06,0:06:40.46,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:06:41.14,0:06:43.92,Default,,0000,0000,0000,,أنا... أنا مُتحرٍّ
Dialogue: 0,0:06:45.01,0:06:50.55,Default,,0000,0000,0000,,!أيمكن أنّك المتحرّي الشهير موري كوغورو-سان؟
Dialogue: 0,0:06:50.55,0:06:52.17,Default,,0000,0000,0000,,أجل، إنّه أنا
Dialogue: 0,0:06:53.50,0:07:00.16,Default,,0000,0000,0000,,!قرأتُ عن القضايا الصعبة التي تحلّها طوال الوقت
Dialogue: 0,0:07:00.16,0:07:01.55,Default,,0000,0000,0000,,يسرّني سماع ذلك
Dialogue: 0,0:07:02.12,0:07:05.01,Default,,0000,0000,0000,,كنتُ أنا من حلّها جميعها
Dialogue: 0,0:07:05.45,0:07:07.62,Default,,0000,0000,0000,,انظر كما تشاء من فضلك
Dialogue: 0,0:07:07.62,0:07:09.92,Default,,0000,0000,0000,,يشرفني أن تساعدني
Dialogue: 0,0:07:16.78,0:07:18.40,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:07:22.27,0:07:23.05,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:25.67,0:07:27.25,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:07:27.25,0:07:28.54,Default,,0000,0000,0000,,معجون أسنان
Dialogue: 0,0:07:35.03,0:07:38.61,Default,,0000,0000,0000,,فرشاة أسنان؟ أُطلق على الضحية وهو يفرش أسنانه؟
Dialogue: 0,0:07:39.10,0:07:41.35,Default,,0000,0000,0000,,!تتدخل دوماً
Dialogue: 0,0:07:41.35,0:07:43.90,Default,,0000,0000,0000,,أوجدت شيئاً أيُّها المُتحرِّي موري
Dialogue: 0,0:07:43.90,0:07:47.10,Default,,0000,0000,0000,,تبدو لي جريمة سرقة
Dialogue: 0,0:07:47.10,0:07:49.52,Default,,0000,0000,0000,,سرقة؟
Dialogue: 0,0:07:51.43,0:07:54.89,Default,,0000,0000,0000,,لم يؤخذ سوى المال من محفظة الضحية
Dialogue: 0,0:07:54.89,0:07:58.39,Default,,0000,0000,0000,,كما أنّ المجرم فتّش الغرفة وعبث بها
Dialogue: 0,0:07:58.39,0:08:01.53,Default,,0000,0000,0000,,كانت مجرد جريمة عادية دافعها المال
Dialogue: 0,0:08:02.86,0:08:06.83,Default,,0000,0000,0000,,،من سقوط الضحية أمام مدخل الباب
Dialogue: 0,0:08:06.83,0:08:09.57,Default,,0000,0000,0000,,طرق أحدهم على الباب غالباً
Dialogue: 0,0:08:09.57,0:08:12.70,Default,,0000,0000,0000,,وأطلق عليه حالما فتحه
Dialogue: 0,0:08:14.20,0:08:16.03,Default,,0000,0000,0000,,لكن يا مُتحرّي موري
Dialogue: 0,0:08:16.03,0:08:18.12,Default,,0000,0000,0000,,ما رأيك بهذا الرأي؟
Dialogue: 0,0:08:19.27,0:08:20.61,Default,,0000,0000,0000,,...كانت السرقة تمويهاً
Dialogue: 0,0:08:20.61,0:08:22.49,Default,,0000,0000,0000,,!والقاتل الحقيقي هو الساكن الآخر في الغرفة
Dialogue: 0,0:08:24.27,0:08:26.27,Default,,0000,0000,0000,,!لا يمكن أنّك جاد
Dialogue: 0,0:08:26.27,0:08:28.39,Default,,0000,0000,0000,,وقعت الجريمة قرابة الثامنة، صحيح؟
Dialogue: 0,0:08:28.39,0:08:30.80,Default,,0000,0000,0000,,!لديّ حجة غياب في تلك الحالة
Dialogue: 0,0:08:30.80,0:08:34.32,Default,,0000,0000,0000,,كنتُ في مهرجان تينكايتشي الليلي أثناء الحادثة
Dialogue: 0,0:08:35.97,0:08:38.10,Default,,0000,0000,0000,,التقيتُ هناك موري-سان والبقية
Dialogue: 0,0:08:38.10,0:08:39.23,Default,,0000,0000,0000,,أليس كذلك؟
Dialogue: 0,0:08:39.59,0:08:40.96,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:08:40.96,0:08:44.16,Default,,0000,0000,0000,,لكننا التقينا أثناء نصف المهرجان الثاني وفقما أظن
Dialogue: 0,0:08:44.59,0:08:47.42,Default,,0000,0000,0000,,!يا إلهي، كنت هناك من البداية
Dialogue: 0,0:08:47.42,0:08:49.91,Default,,0000,0000,0000,,...إن كنتم تعتقدون أني أكذب
Dialogue: 0,0:08:49.91,0:08:51.41,Default,,0000,0000,0000,,!فحمّضوا هذا الفيلم
Dialogue: 0,0:08:51.41,0:08:53.61,Default,,0000,0000,0000,,!ستجدون حجّة غيابي عليه
Dialogue: 0,0:08:54.24,0:08:56.74,Default,,0000,0000,0000,,حسناً، حمّضوا الفيلم فوراً
Dialogue: 0,0:08:56.74,0:08:57.33,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:09:00.82,0:09:02.69,Default,,0000,0000,0000,,المحقق يوكوميزو محق
Dialogue: 0,0:09:02.69,0:09:04.98,Default,,0000,0000,0000,,لم تكن هذه سرقة
Dialogue: 0,0:09:04.98,0:09:07.86,Default,,0000,0000,0000,,كان القاتل والضحية يعرفان بعضهما
Dialogue: 0,0:09:07.86,0:09:10.40,Default,,0000,0000,0000,,إنّه هو دون شك
Dialogue: 0,0:09:10.89,0:09:13.36,Default,,0000,0000,0000,,لكن ما خطب تلك الابتسامة العريضة؟
Dialogue: 0,0:09:13.93,0:09:17.26,Default,,0000,0000,0000,,أيّ حجة غياب في تلك الكاميرا؟
Dialogue: 0,0:09:19.50,0:09:21.61,Default,,0000,0000,0000,,مجموعها سبع صور
Dialogue: 0,0:09:23.55,0:09:26.09,Default,,0000,0000,0000,,لكن أين حجّة الغياب في هذه؟
Dialogue: 0,0:09:27.96,0:09:29.87,Default,,0000,0000,0000,,!التقطتُ هذه
Dialogue: 0,0:09:29.87,0:09:32.40,Default,,0000,0000,0000,,انظر، بها بالون كونان-كن
Dialogue: 0,0:09:32.87,0:09:37.24,Default,,0000,0000,0000,,صحيح، التقينا ساساي-سان مع \N"إشعال رمز "إيتشي
Dialogue: 0,0:09:37.45,0:09:42.19,Default,,0000,0000,0000,,لكن يُشعل رمز "إيتشي" بعد الثامنة وأربعين دقيقة
Dialogue: 0,0:09:42.19,0:09:44.28,Default,,0000,0000,0000,,وقعت الجريمة بين 8:02 و8:03
Dialogue: 0,0:09:44.28,0:09:47.24,Default,,0000,0000,0000,,أظن بإمكانك الوصول لأرض المهرجان في 40 دقيقة
Dialogue: 0,0:09:47.24,0:09:48.69,Default,,0000,0000,0000,,.إن أسرعت بالسيّارة
Dialogue: 0,0:09:50.06,0:09:51.77,Default,,0000,0000,0000,,محقق يوكوميزو
Dialogue: 0,0:09:51.77,0:09:55.39,Default,,0000,0000,0000,,بعد إشعال رمز "تين" الأوّل عند تمام الثامنة
Dialogue: 0,0:09:55.39,0:09:57.49,Default,,0000,0000,0000,,إلى متى سيظل مشتعلاً برأيك؟
Dialogue: 0,0:09:57.93,0:10:01.13,Default,,0000,0000,0000,,لقرابة 8:25 عادةً
Dialogue: 0,0:10:01.13,0:10:02.97,Default,,0000,0000,0000,,!انظر لهذه الصورة
Dialogue: 0,0:10:04.84,0:10:11.36,Default,,0000,0000,0000,,هذا دليلٌ على وجوده في أرض المهرجان\Nقبل 8:25 في أبعد توقيت
Dialogue: 0,0:10:12.16,0:10:13.75,Default,,0000,0000,0000,,وقعت الجريمة في تمام الثامنة
Dialogue: 0,0:10:13.75,0:10:15.91,Default,,0000,0000,0000,,،مهما قدت بسرعة
Dialogue: 0,0:10:15.91,0:10:20.24,Default,,0000,0000,0000,,من المستحيل أن تصل أرض المهرجان\Nمن الفندق في 25 دقيقة
Dialogue: 0,0:10:21.82,0:10:24.61,Default,,0000,0000,0000,,تهانينا، لا غبار على حجّتك
Dialogue: 0,0:10:25.03,0:10:26.28,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:10:26.61,0:10:29.23,Default,,0000,0000,0000,,كيف هذا؟ كيف توجد تلك الصورة؟
Dialogue: 0,0:10:29.60,0:10:34.60,Default,,0000,0000,0000,,لكن ألا يمكن أن هذه الصورة معدلة؟
Dialogue: 0,0:10:34.60,0:10:36.18,Default,,0000,0000,0000,,بالكشف المتعدد وما شابه؟
Dialogue: 0,0:10:36.18,0:10:38.20,Default,,0000,0000,0000,,...يمكن لشخص مُلم بالكاميرات أن
Dialogue: 0,0:10:38.67,0:10:42.13,Default,,0000,0000,0000,,لحظة، أعطيتك الكاميرا مباشرةً
Dialogue: 0,0:10:42.13,0:10:44.26,Default,,0000,0000,0000,,وطلبت منك تحميض الفيلم
Dialogue: 0,0:10:44.26,0:10:46.76,Default,,0000,0000,0000,,كما أنّها كانت كاميرا قابلة للتخلص
Dialogue: 0,0:10:46.76,0:10:48.90,Default,,0000,0000,0000,,لا يمكنني فعل شيء كذاك
Dialogue: 0,0:10:49.91,0:10:52.66,Default,,0000,0000,0000,,كنتَ من حمّض الفيلم، صحيح؟
Dialogue: 0,0:10:52.66,0:10:53.58,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:53.58,0:10:56.62,Default,,0000,0000,0000,,!لم تكن هناك علامات على تلاعب بالكاميرا أو الفيلم
Dialogue: 0,0:10:56.62,0:10:57.74,Default,,0000,0000,0000,,رأيت؟
Dialogue: 0,0:10:58.24,0:11:00.07,Default,,0000,0000,0000,,محقق يوكوميزو
Dialogue: 0,0:11:00.07,0:11:04.36,Default,,0000,0000,0000,,كنت تعرف بالفعل أنّه في المهرجان
Dialogue: 0,0:11:04.36,0:11:07.74,Default,,0000,0000,0000,,أجل، سمعتُ من استقبال الفندق أن \Nساساي-سان غادر عند السابعة والنصف
Dialogue: 0,0:11:07.74,0:11:14.61,Default,,0000,0000,0000,,تذكّروا لأنه كان يسألهم عن الوقت باستمرار
Dialogue: 0,0:11:15.02,0:11:19.63,Default,,0000,0000,0000,,ذلك لأني أردت التحقق من الوصول\N"في الوقت لإشعال رمز "تين
Dialogue: 0,0:11:19.63,0:11:22.57,Default,,0000,0000,0000,,فقد نسيت ساعة يدي اليوم كما ترون
Dialogue: 0,0:11:23.43,0:11:26.76,Default,,0000,0000,0000,,!هناك ما يضايقني في كلّ ما تفعله
Dialogue: 0,0:11:26.76,0:11:28.87,Default,,0000,0000,0000,,!وكأنّك تتعمد صنع حجّة غياب
Dialogue: 0,0:11:28.87,0:11:30.49,Default,,0000,0000,0000,,هلّا توقفت؟
Dialogue: 0,0:11:31.29,0:11:34.25,Default,,0000,0000,0000,,أتمنى أن تتوقف عن إهدار الوقت
Dialogue: 0,0:11:34.25,0:11:36.33,Default,,0000,0000,0000,,وتهتم بإنجاز عملك
Dialogue: 0,0:11:36.33,0:11:40.40,Default,,0000,0000,0000,,كإيجاد المجرم الذي قتل صديقي
Dialogue: 0,0:11:45.41,0:11:47.24,Default,,0000,0000,0000,,!إيماتاكي سينسي
Dialogue: 0,0:11:47.24,0:11:48.29,Default,,0000,0000,0000,,!سينسي
Dialogue: 0,0:11:49.40,0:11:50.03,Default,,0000,0000,0000,,أين هو؟
Dialogue: 0,0:11:51.27,0:11:52.85,Default,,0000,0000,0000,,إن كنت تبحث عن جثة إيماتاكي-سان
Dialogue: 0,0:11:52.85,0:11:54.58,Default,,0000,0000,0000,,فقد نُقلت للمحطة
Dialogue: 0,0:11:54.58,0:11:55.49,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:11:55.94,0:11:59.68,Default,,0000,0000,0000,,أنا يامادا من مجلة "عصر الأدب" الشهرية {\i1}{\i0}
Dialogue: 0,0:11:59.68,0:12:04.36,Default,,0000,0000,0000,,،أسرعتُ هنا فورما تلقيت اتصال الشرطة\N...يبدو أنّه فعلاً
Dialogue: 0,0:12:04.64,0:12:07.37,Default,,0000,0000,0000,,...عصر الأدب؟ ألم يكن إيماتاكي-سان
Dialogue: 0,0:12:07.97,0:12:10.63,Default,,0000,0000,0000,,بلى، نشرت سلسلة "أسطورة السيف البطولي" خاصته
Dialogue: 0,0:12:10.63,0:12:13.28,Default,,0000,0000,0000,,!أأنت ساساي سينسي؟
Dialogue: 0,0:12:13.67,0:12:14.42,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:12:14.42,0:12:17.00,Default,,0000,0000,0000,,ذكر إيماتاكي أن موعد التسليم قد اقترب
Dialogue: 0,0:12:17.00,0:12:18.91,Default,,0000,0000,0000,,لكنه لم ينته بعد
Dialogue: 0,0:12:18.91,0:12:22.70,Default,,0000,0000,0000,,!صحيح! كان موعد التسليم غداً
Dialogue: 0,0:12:23.37,0:12:24.87,Default,,0000,0000,0000,,!تباً
Dialogue: 0,0:12:24.87,0:12:27.20,Default,,0000,0000,0000,,حتى لو طلب من شخص آخر الكتابة، فلا وقت كافي
Dialogue: 0,0:12:27.20,0:12:30.65,Default,,0000,0000,0000,,!ولن يجاري عمل جودة عمله
Dialogue: 0,0:12:31.15,0:12:33.61,Default,,0000,0000,0000,,ليس بيدي خيار
Dialogue: 0,0:12:37.11,0:12:38.39,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:12:38.39,0:12:39.28,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:12:39.76,0:12:42.76,Default,,0000,0000,0000,,عملٌ كتبته في الماضي
Dialogue: 0,0:12:42.76,0:12:44.93,Default,,0000,0000,0000,,كان إيماتاكي يلحّ أن أريه إيّاه
Dialogue: 0,0:12:44.93,0:12:47.64,Default,,0000,0000,0000,,فجلبته معي اليوم
Dialogue: 0,0:12:47.64,0:12:50.92,Default,,0000,0000,0000,,مع أني أشك أنّه يجاري سلسلة إيماتاكي
Dialogue: 0,0:12:50.92,0:12:55.92,Default,,0000,0000,0000,,،كلا، بما أنّك كنت تعمل معه
Dialogue: 0,0:12:55.92,0:12:58.23,Default,,0000,0000,0000,,!فسيسعد المحرّرون بالتأكيد
Dialogue: 0,0:12:59.08,0:13:00.16,Default,,0000,0000,0000,,أأنت متأكد؟
Dialogue: 0,0:13:00.16,0:13:02.65,Default,,0000,0000,0000,,هذه المقدمة فقط لقصّة طويلة جداً
Dialogue: 0,0:13:03.33,0:13:04.70,Default,,0000,0000,0000,,سيسرنا لو يمكنك مواصلة
Dialogue: 0,0:13:04.70,0:13:07.70,Default,,0000,0000,0000,,...الكتابة لعصر الأدب
Dialogue: 0,0:13:07.70,0:13:11.32,Default,,0000,0000,0000,,...لا أدري، أنا مشغول بما في يديّ سلفاً
Dialogue: 0,0:13:11.32,0:13:12.34,Default,,0000,0000,0000,,هلّا وجدت طريقةً ما؟
Dialogue: 0,0:13:13.32,0:13:16.62,Default,,0000,0000,0000,,حسنٌ، سأكتب لأجل صديقي المتوفى
Dialogue: 0,0:13:18.60,0:13:22.26,Default,,0000,0000,0000,,شكراً جزيلاً! عليّ المغادرة الآن
Dialogue: 0,0:13:22.26,0:13:24.01,Default,,0000,0000,0000,,حضرة الشرطي
Dialogue: 0,0:13:24.01,0:13:25.31,Default,,0000,0000,0000,,سمعته، صحيح؟
Dialogue: 0,0:13:25.31,0:13:29.61,Default,,0000,0000,0000,,يبدو أنّ علي العودة سريعاً وبدء العمل
Dialogue: 0,0:13:30.34,0:13:34.57,Default,,0000,0000,0000,,لأجل إيماتاكي الذي قتله مغفل ما لأجل المال
Dialogue: 0,0:13:34.80,0:13:38.05,Default,,0000,0000,0000,,لا شكّ في الأمر، إنّه القاتل
Dialogue: 0,0:13:38.05,0:13:39.94,Default,,0000,0000,0000,,لكن لديه حجّة غياب
Dialogue: 0,0:13:40.24,0:13:43.79,Default,,0000,0000,0000,,كيف؟ كيف تمكن من التقاط تلك الصورة؟
Dialogue: 0,0:13:45.91,0:13:51.73,Default,,0000,0000,0000,,كما لم يُعبث بالكاميرا وجعل ران تستعملها
Dialogue: 0,0:13:51.73,0:13:55.11,Default,,0000,0000,0000,,لا يمكن أن تكون صورة في الثامنة\Nوخمسين دقيقة حجّة غياب
Dialogue: 0,0:13:57.44,0:13:59.97,Default,,0000,0000,0000,,تبّاً، لا بد من وجود شيء
Dialogue: 0,0:13:59.97,0:14:02.03,Default,,0000,0000,0000,,!شيء سيُطيح بحجّة غيابه
Dialogue: 0,0:14:02.64,0:14:05.56,Default,,0000,0000,0000,,!تذكّر! وقت لقائك به
Dialogue: 0,0:14:07.27,0:14:09.21,Default,,0000,0000,0000,,آسف، لكن عليّ المغادرة
Dialogue: 0,0:14:09.21,0:14:09.94,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:14:10.38,0:14:12.24,Default,,0000,0000,0000,,...صحيح! كان
Dialogue: 0,0:14:13.92,0:14:15.16,Default,,0000,0000,0000,,الجوّ حار
Dialogue: 0,0:14:15.59,0:14:17.63,Default,,0000,0000,0000,,لمَ لم يخلع معطفه؟
Dialogue: 0,0:14:17.63,0:14:19.20,Default,,0000,0000,0000,,!أو ربما لم يستطع
Dialogue: 0,0:14:19.20,0:14:20.07,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:14:20.58,0:14:22.13,Default,,0000,0000,0000,,أيمكنك التقاط صورة لي؟
Dialogue: 0,0:14:22.70,0:14:23.82,Default,,0000,0000,0000,,بهذه الكاميرا
Dialogue: 0,0:14:24.41,0:14:26.53,Default,,0000,0000,0000,,أيمكنك التقاطها برمز "إيتشي" ورائي؟
Dialogue: 0,0:14:30.57,0:14:33.57,Default,,0000,0000,0000,,!لحظة! لا أزال أريد الحديث معك
Dialogue: 0,0:14:34.11,0:14:37.53,Default,,0000,0000,0000,,!يا لعنادك! كفّ عن مضايقتي وإلّا سأقاضيك
Dialogue: 0,0:14:38.52,0:14:41.19,Default,,0000,0000,0000,,فهمت، هكذا كان الأمر
Dialogue: 0,0:14:41.85,0:14:43.40,Default,,0000,0000,0000,,!اكتشفت هذه الحيلة
Dialogue: 0,0:14:44.10,0:14:46.27,Default,,0000,0000,0000,,!إنّه القاتل كما ظننت
Dialogue: 0,0:14:46.27,0:14:49.72,Default,,0000,0000,0000,,!كما كانت جريمةً مع سبق الإصرار والترصد
Dialogue: 0,0:14:59.41,0:15:04.79,Default,,0000,0000,0000,,!اكتشفتُ حيلة حجّة غياب الصور هذه تماماً
Dialogue: 0,0:15:06.08,0:15:08.49,Default,,0000,0000,0000,,!عليّ إخبار المحقق سريعاً
Dialogue: 0,0:15:08.49,0:15:10.57,Default,,0000,0000,0000,,بأيّ حال، سأغادر الآن
Dialogue: 0,0:15:10.57,0:15:12.28,Default,,0000,0000,0000,,!ا-انتظر رجاءً
Dialogue: 0,0:15:12.82,0:15:14.07,Default,,0000,0000,0000,,!عليّ فعل شيء
Dialogue: 0,0:15:15.20,0:15:17.70,Default,,0000,0000,0000,,حسنٌ، حان وقت سلاحي السرّي
Dialogue: 0,0:15:33.93,0:15:35.99,Default,,0000,0000,0000,,...نثبّت وضعيته الآن
Dialogue: 0,0:15:35.99,0:15:38.08,Default,,0000,0000,0000,,ونرتب الصور على الطاولة
Dialogue: 0,0:15:41.21,0:15:45.12,Default,,0000,0000,0000,,ثم نستعمل ربطة العنق المعدلة\Nللصوت هذه لتقليد صوته
Dialogue: 0,0:15:53.07,0:15:53.91,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:15:53.91,0:15:55.49,Default,,0000,0000,0000,,!كم مرّةً أردد كلامي؟
Dialogue: 0,0:15:55.49,0:15:57.66,Default,,0000,0000,0000,,!لديّ صور تثبت براءتي
Dialogue: 0,0:15:58.27,0:16:04.40,Default,,0000,0000,0000,,هلّا أخبرته يا حضرة المتحري بانعدام كفاءته في عمله؟
Dialogue: 0,0:16:04.40,0:16:06.70,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:16:06.70,0:16:09.69,Default,,0000,0000,0000,,خيّبت أملي يا محقق يوكوميزو
Dialogue: 0,0:16:10.47,0:16:11.65,Default,,0000,0000,0000,,...موري-سان
Dialogue: 0,0:16:12.30,0:16:17.16,Default,,0000,0000,0000,,بقيتُ صامتاً كي تأخذ كلّ التقدير
Dialogue: 0,0:16:17.89,0:16:23.25,Default,,0000,0000,0000,,لكن انطلت عليك حيلة حجّة غياب المجرم بتلك الصور
Dialogue: 0,0:16:23.25,0:16:23.92,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:16:24.33,0:16:25.42,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:25.42,0:16:29.32,Default,,0000,0000,0000,,...من قتل إيماتاكي ساتورو في هذه الغرفة
Dialogue: 0,0:16:29.32,0:16:32.03,Default,,0000,0000,0000,,!كان الواقف جانبك، ساساي نوريكازو
Dialogue: 0,0:16:33.70,0:16:36.62,Default,,0000,0000,0000,,!انتظر قليلاً
Dialogue: 0,0:16:36.62,0:16:40.32,Default,,0000,0000,0000,,!ألم تكن من قال أنّها جريمة سرقة؟
Dialogue: 0,0:16:42.48,0:16:47.06,Default,,0000,0000,0000,,قلتُها كي تقلل حذرك
Dialogue: 0,0:16:47.06,0:16:49.80,Default,,0000,0000,0000,,كنتُ أعرف لحظة رؤيتي للضحية
Dialogue: 0,0:16:49.80,0:16:52.74,Default,,0000,0000,0000,,أن القاتل كان أحد معارفه
Dialogue: 0,0:16:54.55,0:16:55.70,Default,,0000,0000,0000,,على أيّ أساس؟
Dialogue: 0,0:16:56.22,0:16:59.59,Default,,0000,0000,0000,,معجون الأسنان في فم الضحية
Dialogue: 0,0:16:59.59,0:17:01.82,Default,,0000,0000,0000,,كانت فرشاته بقرب جثته
Dialogue: 0,0:17:02.34,0:17:05.17,Default,,0000,0000,0000,,أي أن الضحية كان يفرش أسنانه
Dialogue: 0,0:17:05.17,0:17:07.28,Default,,0000,0000,0000,,!قبل أن يُطلق عليه
Dialogue: 0,0:17:07.59,0:17:12.20,Default,,0000,0000,0000,,وما في ذلك؟ يفرش الجميع أسنانهم
Dialogue: 0,0:17:12.58,0:17:14.08,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:17:14.08,0:17:18.94,Default,,0000,0000,0000,,لكن ليس من الشائع أن تفتح الباب لغرباء
Dialogue: 0,0:17:18.94,0:17:24.16,Default,,0000,0000,0000,,وأنت تفرش أسنانك، أليس كذلك؟
Dialogue: 0,0:17:26.27,0:17:30.99,Default,,0000,0000,0000,,بالإضافة,,, حالة هذه الغرفة
Dialogue: 0,0:17:31.26,0:17:35.76,Default,,0000,0000,0000,,هرب القاتل فورما أطلق النار
Dialogue: 0,0:17:37.35,0:17:40.42,Default,,0000,0000,0000,,أيمكنه في ذاك الوقت الوجيز تفتيش الغرفة
Dialogue: 0,0:17:40.42,0:17:42.49,Default,,0000,0000,0000,,وإثارة الفوضى فيها برأيك؟
Dialogue: 0,0:17:44.74,0:17:48.62,Default,,0000,0000,0000,,حصل ذلك قبل وقوع الجريمة غالباً
Dialogue: 0,0:17:48.62,0:17:52.70,Default,,0000,0000,0000,,كي تجعلها تبدو سرقة
Dialogue: 0,0:17:54.45,0:17:55.41,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:17:55.41,0:18:00.11,Default,,0000,0000,0000,,كلّ دلائل مسرح الجريمة تشير إلي
Dialogue: 0,0:18:00.11,0:18:02.70,Default,,0000,0000,0000,,لكن لديّ حجة غياب
Dialogue: 0,0:18:03.28,0:18:06.66,Default,,0000,0000,0000,,!ما تفسيرك لتلك الصورة؟
Dialogue: 0,0:18:08.48,0:18:11.64,Default,,0000,0000,0000,,كانت صوراً التقطتها عندما
Dialogue: 0,0:18:11.64,0:18:14.45,Default,,0000,0000,0000,,أتيت لمهرجان سابق غالباً
Dialogue: 0,0:18:14.72,0:18:18.55,Default,,0000,0000,0000,,احتفظت بتلك الكاميرا حتى مهرجان اليوم
Dialogue: 0,0:18:18.55,0:18:23.30,Default,,0000,0000,0000,,حيث التقيت بران وجعلتها تلتقط المزيد من الصور
Dialogue: 0,0:18:24.49,0:18:27.38,Default,,0000,0000,0000,,مع أنّها كانت حيلةً بمنتهى البساطة
Dialogue: 0,0:18:27.38,0:18:29.12,Default,,0000,0000,0000,,ارتداؤك لنفس ثيابك السابقة
Dialogue: 0,0:18:29.12,0:18:32.82,Default,,0000,0000,0000,,جعل اعتقادها صوراً من اليوم أمراً معقولاً
Dialogue: 0,0:18:32.82,0:18:33.91,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:33.91,0:18:37.41,Default,,0000,0000,0000,,سبب احتمالك للحرارة وإبقاؤك على المعطف
Dialogue: 0,0:18:37.41,0:18:42.44,Default,,0000,0000,0000,,هو لأنك لم ترد تغيير مظهرك عن صورك السابقة
Dialogue: 0,0:18:42.44,0:18:43.74,Default,,0000,0000,0000,,ألستُ محقاً؟
Dialogue: 0,0:18:46.74,0:18:49.69,Default,,0000,0000,0000,,يا للمخيلة الواسعة أيّها المتحرّي موري
Dialogue: 0,0:18:50.52,0:18:56.41,Default,,0000,0000,0000,,!لكن كيف تثبت أنّي التقطت تلك الصور في مهرجان سابق؟
Dialogue: 0,0:18:56.93,0:18:59.32,Default,,0000,0000,0000,,الدليل موجود
Dialogue: 0,0:19:00.01,0:19:00.90,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:19:06.13,0:19:08.73,Default,,0000,0000,0000,,...انظر، إنّه موجود في هذه الصورة
Dialogue: 0,0:19:08.91,0:19:10.86,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:19:11.75,0:19:14.50,Default,,0000,0000,0000,,!لا تضايق أبي
Dialogue: 0,0:19:19.90,0:19:20.53,Default,,0000,0000,0000,,أبي؟
Dialogue: 0,0:19:20.86,0:19:21.97,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:19:26.82,0:19:30.03,Default,,0000,0000,0000,,أترك الباقي لك يا محقق يوكوميزو
Dialogue: 0,0:19:30.27,0:19:31.36,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:19:31.36,0:19:33.61,Default,,0000,0000,0000,,...معصمه؟ ماذا
Dialogue: 0,0:19:40.94,0:19:44.43,Default,,0000,0000,0000,,فقد نسيت ساعة يدي اليوم كما ترون
Dialogue: 0,0:19:57.08,0:19:57.86,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:20:00.86,0:20:02.61,Default,,0000,0000,0000,,ما تفسيرك لهذا؟
Dialogue: 0,0:20:02.61,0:20:08.40,Default,,0000,0000,0000,,!معصمك مُسمر تماماً في صورة حجّة غيابك
Dialogue: 0,0:20:08.69,0:20:11.52,Default,,0000,0000,0000,,!مع أن معصمك أبيض الآن
Dialogue: 0,0:20:12.69,0:20:15.82,Default,,0000,0000,0000,,!التقطت هذه الصورة قبل عام في الواقع
Dialogue: 0,0:20:16.44,0:20:19.80,Default,,0000,0000,0000,,!ألستُ محقاً يا ساساي-سان؟
Dialogue: 0,0:20:22.01,0:20:24.07,Default,,0000,0000,0000,,أعترف بخسارتي أيها المحقق
Dialogue: 0,0:20:26.96,0:20:31.21,Default,,0000,0000,0000,,!قررتُ التخلص من إيماتاكي قبل عام
Dialogue: 0,0:20:31.21,0:20:34.57,Default,,0000,0000,0000,,!أردتُ أخذ مكانه في قمة عالم الأدب
Dialogue: 0,0:20:36.03,0:20:39.74,Default,,0000,0000,0000,,أجل، قُرّر قبل عام أن يُنشر عملي
Dialogue: 0,0:20:39.74,0:20:42.70,Default,,0000,0000,0000,,"كسلسلة في "عصر الأدب{\i1}{\i0}
Dialogue: 0,0:20:42.70,0:20:47.77,Default,,0000,0000,0000,,!لكن قبل موعد التسليم، بدّل المحرّرون اختيارهم لإيماتاكي
Dialogue: 0,0:20:49.11,0:20:51.75,Default,,0000,0000,0000,,فقط لامتلاكه سمعةً أعلى مني
Dialogue: 0,0:20:52.77,0:20:59.76,Default,,0000,0000,0000,,كانت تلك السلسلة آخر فرصة لي كي أنجح ككاتب
Dialogue: 0,0:20:59.76,0:21:01.89,Default,,0000,0000,0000,,مع ذلك قرر خطفها
Dialogue: 0,0:21:01.89,0:21:04.41,Default,,0000,0000,0000,,!كما لو كان يسخر مني
Dialogue: 0,0:21:04.41,0:21:06.20,Default,,0000,0000,0000,,لذا قتلته؟
Dialogue: 0,0:21:07.22,0:21:10.65,Default,,0000,0000,0000,,أجل، قمتُ بقتله
Dialogue: 0,0:21:14.84,0:21:16.13,Default,,0000,0000,0000,,آنسة
Dialogue: 0,0:21:16.13,0:21:20.23,Default,,0000,0000,0000,,إنّ العمل الذي حاز إيماتاكي بفضله\Nعلى جائزة ناوموتو
Dialogue: 0,0:21:20.58,0:21:23.87,Default,,0000,0000,0000,,هو رواية ألّفناها أنا وإيّاه في الماضي
Dialogue: 0,0:21:23.87,0:21:26.66,Default,,0000,0000,0000,,عندما كنا نعمل معاً
Dialogue: 0,0:21:28.30,0:21:31.62,Default,,0000,0000,0000,,مع أنّ لا أحد سيصدقني الآن
Dialogue: 0,0:23:15.26,0:23:18.65,Default,,0000,0000,0000,,!استنتاج ممتاز حضرة المتحري موري
Dialogue: 0,0:23:19.16,0:23:22.29,Default,,0000,0000,0000,,تمكنا من حل هذه القضية واعتقال ساساي
Dialogue: 0,0:23:22.29,0:23:24.61,Default,,0000,0000,0000,,!بفضلك أنت
Dialogue: 0,0:23:25.08,0:23:27.90,Default,,0000,0000,0000,,اعتقال؟ ساساي؟ قضية؟
Dialogue: 0,0:23:27.90,0:23:29.65,Default,,0000,0000,0000,,تتظاهر بالجهل مجدداً
Dialogue: 0,0:23:29.65,0:23:30.73,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:23:30.90,0:23:33.05,Default,,0000,0000,0000,,...كنتُ أعرف أن ساساي القاتل
Dialogue: 0,0:23:33.38,0:23:35.51,Default,,0000,0000,0000,,!والقضية بسيطة! فهمتم؟
Dialogue: 0,0:23:33.38,0:23:35.61,Thoughts,,0000,0000,15,,ساساي: تعني باليابانية بسيط أيضاً
Dialogue: 0,0:23:49.59,0:23:50.87,Default,,0000,0000,0000,,!اضحكوا
Dialogue: 0,0:24:01.62,0:24:02.92,Default,,0000,0000,0000,,لمَ لا تدخلين؟
Dialogue: 0,0:24:02.92,0:24:04.42,Default,,0000,0000,0000,,تحتاجين مساعدة من وكالة التحري، صحيح؟
Dialogue: 0,0:24:08.74,0:24:10.19,Default,,0000,0000,0000,,!واعدتِ شينتشي؟
Dialogue: 0,0:24:12.03,0:24:14.20,Default,,0000,0000,0000,,...علامات تلاعب بالقفل
Dialogue: 0,0:24:14.49,0:24:15.88,Default,,0000,0000,0000,,إنّه خطف، صحيح؟
Dialogue: 0,0:24:16.36,0:24:18.02,Default,,0000,0000,0000,,...وجدتك أخيراً يا شينتشي
Dialogue: 0,0:24:19.56,0:24:21.98,Default,,0000,0000,0000,,!اخرج يا شينتشي
Dialogue: 0,0:24:21.98,0:24:23.88,Default,,0000,0000,0000,,!أعرف أنّك هنا
Dialogue: 0,0:24:24.03,0:24:25.39,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.60,0:24:28.14,Default,,0000,0000,0000,,ابتزاز لاعب كرة القدم المحترف
Dialogue: 0,0:24:45.74,0:24:47.77,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.77,0:24:49.45,Default,,0000,0000,0000,,لعبة فيديو
Dialogue: 0,0:24:50.76,0:24:53.64,Default,,0000,0000,0000,,!في الحلقة القادمة أيضاً، تبقى الحقيقة واحدة

