Dialogue: 0,0:00:01.55,0:00:03.01,Default,,0000,0000,0000,,اسمي كودو شينتشي
Dialogue: 0,0:00:03.01,0:00:04.57,Default,,0000,0000,0000,,كنتُ متحريّاً في الثانوية
Dialogue: 0,0:00:04.57,0:00:06.12,Default,,0000,0000,0000,,مشهوراً حول البلاد\N!حتّى وقت قصير
Dialogue: 0,0:00:06.12,0:00:07.95,Default,,0000,0000,0000,,لكن أجبرتني منظمة غامضة على تجرّع عقار ما
Dialogue: 0,0:00:07.95,0:00:09.40,Default,,0000,0000,0000,,!وأصبحت إيدوغاوا كونان
Dialogue: 0,0:00:09.40,0:00:10.50,Default,,0000,0000,0000,,لا يهمّ صغر بنيتي
Dialogue: 0,0:00:10.50,0:00:11.91,Default,,0000,0000,0000,,!فعقلي عقل متحرٍّ عظيم سابق
Dialogue: 0,0:00:11.91,0:00:13.29,Default,,0000,0000,0000,,...ومهما كان نوع القضيّة
Dialogue: 0,0:00:13.29,0:00:15.48,Default,,0000,0000,0000,,!الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.10,0:01:51.99,Title,,0000,0000,0000,,{\fad(300,0)}هدايا التهديد الشهرية
Dialogue: 0,0:01:47.23,0:01:50.56,Default,,0000,0000,0000,,هدايا التهديد الشهرية
Dialogue: 0,0:01:55.55,0:01:58.09,Default,,0000,0000,0000,,!تعرفين كودو شينتشي يا ران-نيتشان؟
Dialogue: 0,0:01:58.30,0:02:00.18,Default,,0000,0000,0000,,...ماذا؟ أ-أجل
Dialogue: 0,0:02:00.51,0:02:01.89,Default,,0000,0000,0000,,!مذهل
Dialogue: 0,0:02:01.89,0:02:05.63,Default,,0000,0000,0000,,!تعرفين متحرّي الثانوية الشهير جدّاً ذاك
Dialogue: 0,0:02:05.63,0:02:08.92,Default,,0000,0000,0000,,أيمكن أنّه حبيبك؟
Dialogue: 0,0:02:08.92,0:02:11.67,Default,,0000,0000,0000,,!كلا! لا شيء كهذا
Dialogue: 0,0:02:08.92,0:02:11.67,Default,,0000,0000,0000,,!كلا! لا شيء كهذا
Dialogue: 0,0:02:13.08,0:02:14.91,Default,,0000,0000,0000,,لمَ تردد نفس كلامي؟
Dialogue: 0,0:02:14.91,0:02:16.56,Default,,0000,0000,0000,,...كلا، كنت فقط
Dialogue: 0,0:02:16.62,0:02:18.18,Default,,0000,0000,0000,,!إنّه حبيبك، صحيح؟
Dialogue: 0,0:02:18.18,0:02:20.89,Default,,0000,0000,0000,,...حسناً، إنّه... أنا
Dialogue: 0,0:02:21.71,0:02:24.61,Default,,0000,0000,0000,,!لا يمكنني الإجابة على ذلك
Dialogue: 0,0:02:27.49,0:02:28.77,Default,,0000,0000,0000,,عدت
Dialogue: 0,0:02:31.61,0:02:33.78,Default,,0000,0000,0000,,بالمناسبة، ما الذي يفعله شينتشي؟
Dialogue: 0,0:02:33.78,0:02:36.01,Default,,0000,0000,0000,,مضت فترة مذ سمعت شيئاً منه
Dialogue: 0,0:02:36.27,0:02:39.48,Default,,0000,0000,0000,,!تعقّدت القضية التي يعمل عليها بالتأكيد
Dialogue: 0,0:02:40.35,0:02:43.91,Default,,0000,0000,0000,,لكنّه يحلّ كل القضايا بلا مشاكل عادةً
Dialogue: 0,0:02:44.97,0:02:46.43,Default,,0000,0000,0000,,...أيمكن أنّ
Dialogue: 0,0:02:47.80,0:02:49.68,Default,,0000,0000,0000,,مهاراته في التحليل تدهورت؟
Dialogue: 0,0:02:53.89,0:02:55.13,Default,,0000,0000,0000,,قادمة
Dialogue: 0,0:02:59.67,0:03:00.77,Default,,0000,0000,0000,,ماذا هناك؟
Dialogue: 0,0:03:04.75,0:03:06.62,Default,,0000,0000,0000,,آسف يا فتى
Dialogue: 0,0:03:10.66,0:03:12.12,Default,,0000,0000,0000,,أأنت بخير؟
Dialogue: 0,0:03:12.12,0:03:13.37,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:03:15.48,0:03:17.93,Default,,0000,0000,0000,,اسمي أوغاوا
Dialogue: 0,0:03:17.93,0:03:20.11,Default,,0000,0000,0000,,كان يرسل أحدهم لي شهرياً
Dialogue: 0,0:03:20.11,0:03:23.61,Default,,0000,0000,0000,,ألعاباً ونقوداً منذ عامين
Dialogue: 0,0:03:23.94,0:03:25.35,Default,,0000,0000,0000,,هذا مريب بما أنّ اسم المرسل
Dialogue: 0,0:03:25.35,0:03:28.23,Default,,0000,0000,0000,,وعنوانه مُختلقان دوماً
Dialogue: 0,0:03:29.64,0:03:31.18,Default,,0000,0000,0000,,ألعاب ونقود؟
Dialogue: 0,0:03:31.18,0:03:33.69,Default,,0000,0000,0000,,ألديك أطفال؟
Dialogue: 0,0:03:34.05,0:03:37.64,Default,,0000,0000,0000,,أجل، ابني يوتا ذو الخمسة أعوام
Dialogue: 0,0:03:39.29,0:03:41.60,Default,,0000,0000,0000,,ما مقدار المال الذي يُرسل لك إذاً؟
Dialogue: 0,0:03:41.92,0:03:43.63,Default,,0000,0000,0000,,مليون ين شهرياً
Dialogue: 0,0:03:43.63,0:03:46.06,Default,,0000,0000,0000,,سيكون المجموع خمسة وعشرين مليوناً هذا الشهر
Dialogue: 0,0:03:46.06,0:03:47.98,Default,,0000,0000,0000,,!حمسة وعشرين مليوناً؟
Dialogue: 0,0:03:46.06,0:03:47.98,Default,,0000,0000,0000,,!حمسة وعشرين مليوناً؟
Dialogue: 0,0:03:49.45,0:03:53.62,Default,,0000,0000,0000,,يحبّ يوتا تلقّيه لألعاب جديدة شهرياً
Dialogue: 0,0:03:53.62,0:03:57.27,Default,,0000,0000,0000,,لكن تلقّي المال أشعري بالريبة كثيراً، فلم أمسّه أبداً
Dialogue: 0,0:03:57.27,0:04:00.19,Default,,0000,0000,0000,,!لا أمانع الاحتفاظ بالمال لك إذاً
Dialogue: 0,0:04:00.19,0:04:01.23,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:04:01.23,0:04:03.77,Default,,0000,0000,0000,,!كنت أمزح
Dialogue: 0,0:04:03.77,0:04:06.47,Default,,0000,0000,0000,,ألديك فكرة عن المرسل إذاً؟
Dialogue: 0,0:04:06.76,0:04:08.01,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:04:08.01,0:04:10.94,Default,,0000,0000,0000,,ألا يمكن أنّه أحد مرضاك؟
Dialogue: 0,0:04:11.26,0:04:12.68,Default,,0000,0000,0000,,مرضاه؟
Dialogue: 0,0:04:12.68,0:04:15.39,Default,,0000,0000,0000,,فأنت جرّاح، صحيح؟
Dialogue: 0,0:04:15.92,0:04:17.13,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:17.13,0:04:19.59,Default,,0000,0000,0000,,لن يكون غريباً إذاً أن يرسل لك\Nأحد المرضى الذين أنقذتهم
Dialogue: 0,0:04:19.59,0:04:21.96,Default,,0000,0000,0000,,كلّ هذا تقديراً لخدمتك، صحيح؟
Dialogue: 0,0:04:21.96,0:04:23.30,Default,,0000,0000,0000,,...نعم
Dialogue: 0,0:04:24.71,0:04:28.98,Default,,0000,0000,0000,,ماذا؟ أذكرت لكم أنّي جرّاح؟
Dialogue: 0,0:04:30.66,0:04:33.02,Default,,0000,0000,0000,,كيف عرفت يا كونان-كن؟
Dialogue: 0,0:04:33.49,0:04:35.78,Default,,0000,0000,0000,,كانت سبّابته
Dialogue: 0,0:04:35.78,0:04:36.97,Default,,0000,0000,0000,,سبّابتي؟
Dialogue: 0,0:04:36.97,0:04:40.02,Default,,0000,0000,0000,,هناك علامات قطرية على أطراف أصابعك، صحيح؟
Dialogue: 0,0:04:40.02,0:04:41.28,Default,,0000,0000,0000,,عند إجرائهم العملية
Dialogue: 0,0:04:41.28,0:04:46.93,Default,,0000,0000,0000,,يستعمل الجرّاحون سبّاباتهم لخياطة الغرز الضيقة
Dialogue: 0,0:04:47.24,0:04:50.64,Default,,0000,0000,0000,,لذا تتشكل علامات قطرية على سبّاباتهم مع مرور الوقت
Dialogue: 0,0:04:50.93,0:04:53.18,Default,,0000,0000,0000,,أ-أهذا صحيح؟
Dialogue: 0,0:04:53.18,0:04:54.14,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:54.14,0:04:56.60,Default,,0000,0000,0000,,أجريت عمليةً صباح اليوم في الواقع
Dialogue: 0,0:04:57.13,0:04:59.38,Default,,0000,0000,0000,,!ملاحظة ذكيّة يا فتى
Dialogue: 0,0:05:00.88,0:05:03.92,Default,,0000,0000,0000,,إنّه يعرف مختلف الأشياء الغريبة
Dialogue: 0,0:05:03.92,0:05:05.56,Default,,0000,0000,0000,,!لكن كان ذلك مذهلاً يا كونان-كن
Dialogue: 0,0:05:05.56,0:05:08.08,Default,,0000,0000,0000,,...كنتُ مثل
Dialogue: 0,0:05:08.08,0:05:09.52,Default,,0000,0000,0000,,...مثل
Dialogue: 0,0:05:10.76,0:05:13.43,Default,,0000,0000,0000,,أنتِ في نادي الجمباز، صحيح؟
Dialogue: 0,0:05:13.43,0:05:19.00,Default,,0000,0000,0000,,وحدهن الفتيات اللواتي يتمرنّ على\Nالقضبان الأفقية يُصبن بهذه البثور
Dialogue: 0,0:05:19.00,0:05:20.64,Default,,0000,0000,0000,,شينتشي
Dialogue: 0,0:05:21.50,0:05:23.63,Default,,0000,0000,0000,,...أ-أيعقل
Dialogue: 0,0:05:27.58,0:05:28.70,Default,,0000,0000,0000,,لا يمكن
Dialogue: 0,0:05:30.16,0:05:32.51,Default,,0000,0000,0000,,استلمت هذه اليوم
Dialogue: 0,0:05:35.70,0:05:39.04,Default,,0000,0000,0000,,لا يبدو أنّها تحوي شيئاً غريباً باستثناء المال
Dialogue: 0,0:05:39.04,0:05:44.61,Default,,0000,0000,0000,,كلا، تكون حزمة أكبر عادةً تحوي الألعاب والمال معاً
Dialogue: 0,0:05:44.61,0:05:46.76,Default,,0000,0000,0000,,هذه أوّل مرة تختلف هكذا
Dialogue: 0,0:05:48.52,0:05:49.52,Default,,0000,0000,0000,,رسالة
Dialogue: 0,0:05:50.80,0:05:55.76,On Top,,0000,0000,0000,,أنهيتُ دفع الـ 25 مليون ينّ\Nسآتي لأخذ ما هو لي{\a6}
Dialogue: 0,0:05:56.27,0:05:58.46,Default,,0000,0000,0000,,ما معنى هذا؟
Dialogue: 0,0:05:58.46,0:06:00.67,Default,,0000,0000,0000,,لا أدري، لا فكرة لديّ أبداً
Dialogue: 0,0:06:08.20,0:06:10.92,Default,,0000,0000,0000,,لمَ لا توجد على هذه حزمة خيوط؟
Dialogue: 0,0:06:11.50,0:06:13.25,Default,,0000,0000,0000,,حزمة خيوط؟
Dialogue: 0,0:06:13.25,0:06:15.26,Default,,0000,0000,0000,,توجد على التي معك
Dialogue: 0,0:06:15.87,0:06:17.21,Default,,0000,0000,0000,,تقصد شفرة التعرف
Dialogue: 0,0:06:18.49,0:06:20.19,Default,,0000,0000,0000,,هذا غريب بالفعل
Dialogue: 0,0:06:20.19,0:06:22.36,Default,,0000,0000,0000,,!لا توجد على أيّ من الأشياء هنا
Dialogue: 0,0:06:23.49,0:06:26.49,Default,,0000,0000,0000,,لا تُباع هذه الألعاب في المتاجر الآن
Dialogue: 0,0:06:26.49,0:06:28.71,Default,,0000,0000,0000,,كما يبدو أنّ بعضها متضرر
Dialogue: 0,0:06:29.18,0:06:31.27,Default,,0000,0000,0000,,صحيح، مذ بدأت أستلم الألعاب
Dialogue: 0,0:06:31.27,0:06:34.17,Default,,0000,0000,0000,,كانت بعضها مهترئة، وأخرى محطمة تماماً
Dialogue: 0,0:06:34.68,0:06:37.34,Default,,0000,0000,0000,,أيّ أنه كان يرسل ألعاباً مستعملة
Dialogue: 0,0:06:37.34,0:06:40.42,Default,,0000,0000,0000,,أو ألعاباً اشتراها قبل فترة طويلة
Dialogue: 0,0:06:40.42,0:06:41.84,Default,,0000,0000,0000,,!مع مبلغ النقود الكبير
Dialogue: 0,0:06:42.30,0:06:44.30,Default,,0000,0000,0000,,لكن لمَ؟
Dialogue: 0,0:06:44.88,0:06:47.29,Default,,0000,0000,0000,,...على الأرجح أنّه
Dialogue: 0,0:06:47.29,0:06:48.84,Default,,0000,0000,0000,,!مجرد مقلب
Dialogue: 0,0:06:49.66,0:06:51.80,Default,,0000,0000,0000,,مقلب؟
Dialogue: 0,0:06:51.80,0:06:54.00,Default,,0000,0000,0000,,أجل، لا شكّ في ذلك
Dialogue: 0,0:06:54.00,0:06:57.10,Default,,0000,0000,0000,,كلا، هذا معقّد كثيراً بالنسبة لمجرد مقلب
Dialogue: 0,0:06:58.20,0:07:00.58,Default,,0000,0000,0000,,وإرسال تلك الأموال بلا سبب سيكون عديم المعنى
Dialogue: 0,0:07:01.24,0:07:03.01,Default,,0000,0000,0000,,...كما هناك تلك الرسالة
Dialogue: 0,0:07:03.32,0:07:06.57,Default,,0000,0000,0000,,تتمتع بقدرة استنتاج عالية حقّاً يا موري-سان
Dialogue: 0,0:07:06.57,0:07:08.29,Default,,0000,0000,0000,,لم يكن شيئاً يذكر
Dialogue: 0,0:07:10.19,0:07:14.51,Default,,0000,0000,0000,,كلا، لم يستنتج أبي أيّاً من هذه
Dialogue: 0,0:07:14.98,0:07:17.50,Default,,0000,0000,0000,,!كان كونان-كن وراءها كلّها
Dialogue: 0,0:07:18.43,0:07:19.46,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:07:20.84,0:07:22.92,Default,,0000,0000,0000,,...أيمكن أنّه
Dialogue: 0,0:07:23.84,0:07:27.00,Default,,0000,0000,0000,,هذه الرسالة هي خيطنا الوحيد لهويّة المرسل إذاً
Dialogue: 0,0:07:27.00,0:07:30.25,Default,,0000,0000,0000,,أيمكن أن المرسل يحاول شراء شيء
Dialogue: 0,0:07:30.25,0:07:31.84,Default,,0000,0000,0000,,من أوغاوا-سان؟
Dialogue: 0,0:07:32.25,0:07:35.30,Default,,0000,0000,0000,,يمكن أن يكون هذا المعنى بناءً على تفسيرك
Dialogue: 0,0:07:35.92,0:07:37.53,Default,,0000,0000,0000,,...بذكرك ذلك
Dialogue: 0,0:07:37.53,0:07:40.86,Default,,0000,0000,0000,,توجد لوحة فنّية في المشفى ورثتها من جدي
Dialogue: 0,0:07:40.86,0:07:44.26,Default,,0000,0000,0000,,قِيل أن قيمتها 20 مليون ين وفقما أذكر
Dialogue: 0,0:07:44.26,0:07:45.91,Default,,0000,0000,0000,,!هذه هي
Dialogue: 0,0:07:45.91,0:07:49.46,Default,,0000,0000,0000,,!يريد المرسل شراء تلك اللوحة منك غالباً
Dialogue: 0,0:07:49.46,0:07:52.42,Default,,0000,0000,0000,,!لنذهب للمشفى جميعاً ونتفقد اللوحة
Dialogue: 0,0:07:52.94,0:07:54.98,Default,,0000,0000,0000,,!قد نجد تفاصيل أكثر
Dialogue: 0,0:07:54.98,0:07:56.11,Default,,0000,0000,0000,,!حسناً! لنذهب
Dialogue: 0,0:07:56.89,0:07:59.84,On Top,,0000,0000,0000,,مشفى بيكا
Dialogue: 0,0:07:59.84,0:08:02.68,Default,,0000,0000,0000,,إنّه مشفى كبير بالفعل
Dialogue: 0,0:08:02.68,0:08:06.68,Default,,0000,0000,0000,,غلبتني الدهشة عندما أتيت أول مرة\Nقبل 3 أعوام أيضاً
Dialogue: 0,0:08:06.68,0:08:09.75,Default,,0000,0000,0000,,فقد انتقلت من مشفى ريفيّ صغير
Dialogue: 0,0:08:10.38,0:08:13.17,Default,,0000,0000,0000,,أوغاوا سينسي، استلمنا هذه مجدداً
Dialogue: 0,0:08:13.17,0:08:14.97,Default,,0000,0000,0000,,هذا العام أيضاً إذاً؟
Dialogue: 0,0:08:14.97,0:08:18.17,Default,,0000,0000,0000,,زهور مجد الصباح؟ مع برودة الجوّ هذه؟
Dialogue: 0,0:08:18.45,0:08:22.45,Default,,0000,0000,0000,,لعلّ المرسل كان يهتم بها داخل دفيئة
Dialogue: 0,0:08:22.45,0:08:24.62,Default,,0000,0000,0000,,أ-أتقصد أنّه نفس الشخص؟
Dialogue: 0,0:08:24.62,0:08:26.64,Default,,0000,0000,0000,,أجل، يرسل هذه أيضاً
Dialogue: 0,0:08:27.31,0:08:29.81,Default,,0000,0000,0000,,لكن الأزهار تأتي مرّةً في العام
Dialogue: 0,0:08:29.81,0:08:32.09,Default,,0000,0000,0000,,في تاريخ اليوم، التاسع عشر من فبراير
Dialogue: 0,0:08:32.61,0:08:36.19,Default,,0000,0000,0000,,...إرسال الأزهار يعني أنّ المرسل امرأة غالباً
Dialogue: 0,0:08:36.19,0:08:40.51,Default,,0000,0000,0000,,"مجد الصّباح تعني بلغة الزهور "حب قصير المدى
Dialogue: 0,0:08:40.51,0:08:44.05,Default,,0000,0000,0000,,...أيمكن أنك قبل عامين دخلت مع امرأة في
Dialogue: 0,0:08:44.05,0:08:46.51,Default,,0000,0000,0000,,!لا-لا شيء هكذا
Dialogue: 0,0:08:46.51,0:08:49.34,Default,,0000,0000,0000,,أيمكن أنّه عيد ميلاد ابنك إذاً؟
Dialogue: 0,0:08:49.34,0:08:51.46,Default,,0000,0000,0000,,عيد ميلاد يوتا في ديسمبر
Dialogue: 0,0:08:52.17,0:08:54.46,Default,,0000,0000,0000,,،إن كان أوغاوا سينسي لا يمانع
Dialogue: 0,0:08:54.46,0:08:56.64,Default,,0000,0000,0000,,أيمكننا تفقد سجلات مرضاه؟
Dialogue: 0,0:08:57.49,0:09:01.20,Default,,0000,0000,0000,,قد يكون هناك مريض بصلة بالتاسع عشر من فبراير
Dialogue: 0,0:09:01.20,0:09:02.58,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:09:02.58,0:09:04.09,Default,,0000,0000,0000,,أيمكننا ذلك؟
Dialogue: 0,0:09:04.95,0:09:07.04,Default,,0000,0000,0000,,لا يمكنني فتح السجلات لأشخاص آخرين
Dialogue: 0,0:09:07.40,0:09:09.36,Default,,0000,0000,0000,,أيمكن أن تتغاضى هذه المرة؟
Dialogue: 0,0:09:09.36,0:09:12.80,Default,,0000,0000,0000,,حسنٌ، يبدو أنّ لا خيار آخر لديّ
Dialogue: 0,0:09:12.80,0:09:14.01,Default,,0000,0000,0000,,نأسف على مضايقتك
Dialogue: 0,0:09:21.31,0:09:26.13,Default,,0000,0000,0000,,هذه سجلّات كافة مرضاي للثلاثة أعوام الفائتة
Dialogue: 0,0:09:29.17,0:09:33.71,Default,,0000,0000,0000,,ولا يوجد أحد هنا قد يريد اللوحة؟
Dialogue: 0,0:09:33.71,0:09:34.75,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:09:34.75,0:09:37.08,Default,,0000,0000,0000,,هل تريد أن تراها بنفسك؟
Dialogue: 0,0:09:37.08,0:09:38.54,Default,,0000,0000,0000,,أجل، بالتأكيد
Dialogue: 0,0:09:39.16,0:09:41.80,Default,,0000,0000,0000,,إنّها معلقة في غرفة انتظار المرضى
Dialogue: 0,0:09:42.87,0:09:44.30,Default,,0000,0000,0000,,لن تأتي يا كونان-كن؟
Dialogue: 0,0:09:44.91,0:09:46.72,Default,,0000,0000,0000,,سأنتظر هنا
Dialogue: 0,0:09:46.72,0:09:50.53,Default,,0000,0000,0000,,حسناً، كن مطيعاً وتصرف بتهذيب إذاً
Dialogue: 0,0:09:50.53,0:09:50.96,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:09:51.92,0:09:55.69,Default,,0000,0000,0000,,!اللوحة محبوبة من قبل مرضاي أيضاً
Dialogue: 0,0:10:08.13,0:10:10.67,Default,,0000,0000,0000,,!كونان-كن! هناك أمرٌ غريب
Dialogue: 0,0:10:10.67,0:10:13.42,Default,,0000,0000,0000,,يتصرف بشكل غريب بالنسبة لصبيّ في الابتدائية
Dialogue: 0,0:10:13.42,0:10:15.30,Default,,0000,0000,0000,,...أجل، آنذاك أيضاً
Dialogue: 0,0:10:16.42,0:10:20.13,Default,,0000,0000,0000,,يبدو أنّ هذا الكلب ينبح تّجاه كل الغرباء، صحيح؟
Dialogue: 0,0:10:20.13,0:10:21.83,Default,,0000,0000,0000,,...وتلك المرّة كذلك
Dialogue: 0,0:10:21.83,0:10:26.62,Default,,0000,0000,0000,,كيف عرفتِ أنّها قدّاحة مع أنّه\Nلم يسبق لك القدوم هنا؟
Dialogue: 0,0:10:26.62,0:10:28.84,Default,,0000,0000,0000,,!كأن شينتشي من كان يتكلّم
Dialogue: 0,0:10:30.13,0:10:30.84,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:10:32.07,0:10:34.17,Default,,0000,0000,0000,,...يوم اختفاء شينتشي
Dialogue: 0,0:10:36.19,0:10:38.41,Default,,0000,0000,0000,,ظهر كونان-كن كما لو كان مكانه
Dialogue: 0,0:10:40.43,0:10:46.19,Default,,0000,0000,0000,,...أيمكن... أيمكن أنّه\N!شينتشي حقّاً؟
Dialogue: 0,0:10:50.84,0:10:52.38,Default,,0000,0000,0000,,عليّ التحقق بأيّ حال
Dialogue: 0,0:10:53.59,0:10:54.55,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:10:57.83,0:10:59.00,Default,,0000,0000,0000,,ما الذي تفعله؟
Dialogue: 0,0:10:59.91,0:11:03.16,Default,,0000,0000,0000,,لا يجدر بك قراءة سجلات المرضى دون إذن
Dialogue: 0,0:11:03.16,0:11:04.67,Default,,0000,0000,0000,,!ران-نيتشان
Dialogue: 0,0:11:05.46,0:11:07.11,Default,,0000,0000,0000,,وجدت شيئاً؟
Dialogue: 0,0:11:07.11,0:11:08.86,Default,,0000,0000,0000,,أجل، نوعاً ما
Dialogue: 0,0:11:08.86,0:11:13.13,Default,,0000,0000,0000,,قال أنّ الأزهار تُرسل للمشفى\Nمرّة في العام، صحيح؟
Dialogue: 0,0:11:13.65,0:11:18.08,Default,,0000,0000,0000,,هذا يجعلني أعتقد أنّ المرسل\Nكان مريضاً سابقاً هنا
Dialogue: 0,0:11:18.69,0:11:22.60,Default,,0000,0000,0000,,بدأ بتلقّي الألعاب والمال والأزهار قبل عامين
Dialogue: 0,0:11:22.60,0:11:25.66,Default,,0000,0000,0000,,لذا هذا يضيّق النطاق لقائمة المرضى\Nالذين كانوا متواجدين
Dialogue: 0,0:11:25.66,0:11:27.05,Default,,0000,0000,0000,,في سنة أوغاوا-سان الأولى في المشفى
Dialogue: 0,0:11:27.09,0:11:28.63,Default,,0000,0000,0000,,من بينهم، هناك 8 أشخاص لهم صلة
Dialogue: 0,0:11:28.63,0:11:30.50,Default,,0000,0000,0000,,بتاريخ التاسع عشر من فبراير
Dialogue: 0,0:11:31.13,0:11:33.63,Default,,0000,0000,0000,,أشخاص نجحت عملياتهم في ذاك اليوم
Dialogue: 0,0:11:33.63,0:11:35.91,Default,,0000,0000,0000,,وآخرون تم تسريحهم أو تسجيل دخولهم يومها
Dialogue: 0,0:11:36.13,0:11:41.46,Default,,0000,0000,0000,,إرسال الأزهار يعني عادةً امتنان الشخص
Dialogue: 0,0:11:41.46,0:11:42.80,Default,,0000,0000,0000,,...لكن هناك أمر يضايقني
Dialogue: 0,0:11:43.67,0:11:47.00,Default,,0000,0000,0000,,مجد الصباح المزروعة بعناية في دفيئة\N...كما تلك الرسالة
Dialogue: 0,0:11:49.20,0:11:51.46,Default,,0000,0000,0000,,من المذهل استنتاجك هذا القدر
Dialogue: 0,0:11:52.82,0:11:55.93,Default,,0000,0000,0000,,كما... كما يُتوقع منك يا شينتشي
Dialogue: 0,0:11:57.19,0:11:58.59,Default,,0000,0000,0000,,...لم يكن شيئاً
Dialogue: 0,0:12:09.72,0:12:10.49,Default,,0000,0000,0000,,كنتُ أعرف
Dialogue: 0,0:12:11.47,0:12:13.21,Default,,0000,0000,0000,,!أنتَ شينتشي
Dialogue: 0,0:12:13.21,0:12:16.01,Default,,0000,0000,0000,,ما-ما الذي تقولينه يا ران-نيتشان؟
Dialogue: 0,0:12:16.01,0:12:18.21,Default,,0000,0000,0000,,!اسمي كونان! كونان
Dialogue: 0,0:12:19.67,0:12:21.71,Default,,0000,0000,0000,,!كفي عن المزاح
Dialogue: 0,0:12:23.83,0:12:25.97,Default,,0000,0000,0000,,!تبّاً! اكتشفت أمري
Dialogue: 0,0:12:26.74,0:12:29.41,Default,,0000,0000,0000,,،إن تسلل أمر كوني كودو شينتشي للعلن
Dialogue: 0,0:12:29.41,0:12:31.59,Default,,0000,0000,0000,,!سيأتون مجدداً للقضاء عليّ
Dialogue: 0,0:12:32.03,0:12:33.24,Default,,0000,0000,0000,,...عندها
Dialogue: 0,0:12:33.24,0:12:35.91,Default,,0000,0000,0000,,قد تكون ران والبقية في خطر أيضاً
Dialogue: 0,0:12:35.91,0:12:37.54,Default,,0000,0000,0000,,!عليّ خداعها بشكل ما
Dialogue: 0,0:12:39.31,0:12:43.09,Default,,0000,0000,0000,,!مذهل! "غيم مان"! ومغامرة يايبا الكبيرة
Dialogue: 0,0:12:44.05,0:12:48.18,Default,,0000,0000,0000,,!انطلق يا يايبا! اهزم أونيمارو
Dialogue: 0,0:12:48.18,0:12:49.88,Default,,0000,0000,0000,,!هذا مُسلٍّ
Dialogue: 0,0:12:50.26,0:12:53.68,Default,,0000,0000,0000,,!يتحايل! هذا مثير للريبة كثيراً
Dialogue: 0,0:12:53.68,0:12:55.63,Default,,0000,0000,0000,,...كونان-كن شينتشي حقّاً إذاً
Dialogue: 0,0:12:56.18,0:12:57.84,Default,,0000,0000,0000,,...لكن لا تحصل أمور كهذه
Dialogue: 0,0:12:57.84,0:13:00.00,Default,,0000,0000,0000,,...فلسنا في خيال علمي
Dialogue: 0,0:13:00.00,0:13:01.84,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:13:01.84,0:13:03.13,Default,,0000,0000,0000,,...إن كان هو حقاً، إذاً
Dialogue: 0,0:13:04.50,0:13:06.13,Default,,0000,0000,0000,,أخبرني يا كونان-كن
Dialogue: 0,0:13:06.13,0:13:07.00,Default,,0000,0000,0000,,أيوجد أحد تحبّه؟
Dialogue: 0,0:13:07.83,0:13:10.91,Default,,0000,0000,0000,,أنا أملك شخصاً يعجبني كثيراً
Dialogue: 0,0:13:10.91,0:13:15.26,Default,,0000,0000,0000,,أيمكن أنّه شينتشي-نيتشان الذي كنتِ\Nتبحثين عنه قبل قليل؟
Dialogue: 0,0:13:16.98,0:13:18.19,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:13:20.86,0:13:22.65,Default,,0000,0000,0000,,لطالما كان مزعجاً منذ صغره
Dialogue: 0,0:13:22.65,0:13:25.09,Default,,0000,0000,0000,,ومغترّاً كثيراً بنفسه ومهووس تحرٍّ
Dialogue: 0,0:13:25.90,0:13:29.54,Default,,0000,0000,0000,,ولكنه أهل للثقة متى استدعت الحاجة\Nكما رائعٌ وشجاع
Dialogue: 0,0:13:30.51,0:13:32.63,Default,,0000,0000,0000,,أنا أُحب شينتشي كثيراً
Dialogue: 0,0:13:36.56,0:13:39.55,Default,,0000,0000,0000,,!كلا! انتهت اللعبة
Dialogue: 0,0:13:39.55,0:13:41.71,Default,,0000,0000,0000,,تريدين التجربة يا ران-نيتشان؟
Dialogue: 0,0:13:42.34,0:13:43.92,Default,,0000,0000,0000,,تحبّين هذه الأشياء، صحيح؟
Dialogue: 0,0:13:44.30,0:13:45.88,Default,,0000,0000,0000,,...أ-أحب
Dialogue: 0,0:13:46.38,0:13:49.54,Default,,0000,0000,0000,,!لا أحب! لا تسئ الفهم
Dialogue: 0,0:13:50.16,0:13:53.41,Default,,0000,0000,0000,,...حـ-حقاً؟ سأواصل اللعب إذاً
Dialogue: 0,0:13:55.04,0:13:56.82,Default,,0000,0000,0000,,أوغينو تومويا؟
Dialogue: 0,0:13:56.82,0:14:00.29,Default,,0000,0000,0000,,ماذا؟ قال الطبيب أوغاوا أنّ ابنه يدعى يوتا
Dialogue: 0,0:14:01.07,0:14:04.51,Default,,0000,0000,0000,,تضع اسمك أو اسم شخصية تعجبك في العادة
Dialogue: 0,0:14:04.90,0:14:07.14,Default,,0000,0000,0000,,لحظة، أوغينو تومويا
Dialogue: 0,0:14:07.14,0:14:08.67,Default,,0000,0000,0000,,أين رأيت هذا الاسم قبلاً؟
Dialogue: 0,0:14:09.90,0:14:10.50,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:14:13.77,0:14:14.67,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:14:15.27,0:14:16.80,Default,,0000,0000,0000,,أوغينو تومويا، 5 أعوام
Dialogue: 0,0:14:16.80,0:14:19.13,Default,,0000,0000,0000,,مات بعدما أجرى الطبيب أوغاوا عمليةً عليه
Dialogue: 0,0:14:19.13,0:14:21.21,Default,,0000,0000,0000,,!قبل 3 أعوام في التاسع عشر من فبراير
Dialogue: 0,0:14:21.67,0:14:26.13,On Top,,0000,0000,0000,,أنهيتُ دفع الـ 25 مليون ينّ\Nسآتي لأخذ ما هو لي{\a6}
Dialogue: 0,0:14:26.83,0:14:28.59,Default,,0000,0000,0000,,...أيمكن أنّ معنى تلك الرسالة
Dialogue: 0,0:14:29.79,0:14:33.51,Default,,0000,0000,0000,,!ران! اجلبي الطبيب أوغاوا هنا فوراً
Dialogue: 0,0:14:34.12,0:14:36.18,Default,,0000,0000,0000,,!بسرعة! لا وقت لدينا
Dialogue: 0,0:14:38.49,0:14:39.57,Default,,0000,0000,0000,,!إنّه هو بالتأكيد
Dialogue: 0,0:14:39.57,0:14:42.11,Default,,0000,0000,0000,,...نبرة صوته، سلوكه، تحليله
Dialogue: 0,0:14:42.11,0:14:44.80,Default,,0000,0000,0000,,!كلها تطابق شينتشي! لا شكّ هناك
Dialogue: 0,0:14:45.49,0:14:48.93,Default,,0000,0000,0000,,!هل عرفت هوية المرسل حقاً؟
Dialogue: 0,0:14:48.93,0:14:51.71,Default,,0000,0000,0000,,قد يكون والد أوغينو تومويا-كن غالباً
Dialogue: 0,0:14:52.85,0:14:55.48,Default,,0000,0000,0000,,أوغينو تومويا؟
Dialogue: 0,0:14:55.48,0:14:57.67,Default,,0000,0000,0000,,الصبيّ الذي مات من التهاب الزائدة\N!قبل ثلاثة أعوام
Dialogue: 0,0:14:58.38,0:15:01.34,Default,,0000,0000,0000,,أيمكن الموت من التهاب زائدة؟
Dialogue: 0,0:15:01.34,0:15:04.13,Default,,0000,0000,0000,,أجل، إن لم يتم اكتشافه باكراً
Dialogue: 0,0:15:05.01,0:15:09.12,Default,,0000,0000,0000,,كان الأوان قد فات بالعمل عندما جلبوه للمشفى
Dialogue: 0,0:15:09.12,0:15:12.30,Default,,0000,0000,0000,,لكن رفض أبو الصبيّ الإصغاء لي
Dialogue: 0,0:15:13.00,0:15:18.29,Default,,0000,0000,0000,,لكن لمَ قد يرسل لك هدايا في حال فشل العملية؟
Dialogue: 0,0:15:19.07,0:15:21.95,Default,,0000,0000,0000,,ليست هدايا أو بضائع مستعملة
Dialogue: 0,0:15:21.95,0:15:25.11,Default,,0000,0000,0000,,!إنّها ألعاب أوغينو تومويا الذي مات قبل 3 أعوام
Dialogue: 0,0:15:29.39,0:15:34.35,Default,,0000,0000,0000,,!أي أنّه كان يرسل ممتلكات ابنه
Dialogue: 0,0:15:34.35,0:15:35.93,Default,,0000,0000,0000,,!بدافع الضغينة
Dialogue: 0,0:15:36.84,0:15:39.51,Default,,0000,0000,0000,,تُرسَل الزهور للمشفى كلّ تاسع عشر من فبراير
Dialogue: 0,0:15:39.51,0:15:41.46,Default,,0000,0000,0000,,لأنّها ذكرى موت ابنه السنوية
Dialogue: 0,0:15:42.05,0:15:46.01,Default,,0000,0000,0000,,وتعني تلك الرسالة أنّه سيأخذ حياة \Nابن أوغاوا-سان
Dialogue: 0,0:15:46.01,0:15:47.04,Default,,0000,0000,0000,,!في اليوم نفسه
Dialogue: 0,0:15:47.04,0:15:49.08,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:49.08,0:15:51.21,Default,,0000,0000,0000,,!أين ابنك الآن؟
Dialogue: 0,0:15:51.21,0:15:54.01,Default,,0000,0000,0000,,يُفترض أنّ زوجتي في طريقها لأخذه من المدرسة
Dialogue: 0,0:15:54.40,0:15:55.72,Default,,0000,0000,0000,,!اتّصل بها فوراً
Dialogue: 0,0:15:57.74,0:15:59.21,Default,,0000,0000,0000,,!أخذه أحدهم بالفعل؟
Dialogue: 0,0:15:59.53,0:16:02.36,Default,,0000,0000,0000,,!أخبروني أنّ أباه أخذه بالفعل قبل قليل
Dialogue: 0,0:16:02.36,0:16:04.74,Default,,0000,0000,0000,,!لم يكن أنت؟
Dialogue: 0,0:16:04.74,0:16:06.18,Default,,0000,0000,0000,,...لا-لا يعقل
Dialogue: 0,0:16:06.77,0:16:07.77,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:16:07.77,0:16:09.88,Default,,0000,0000,0000,,...إذا لم نجده بسرعة، سوف
Dialogue: 0,0:16:10.69,0:16:12.52,Default,,0000,0000,0000,,أين المدرسة؟
Dialogue: 0,0:16:12.52,0:16:14.81,Default,,0000,0000,0000,,ليست بعيدة من هنا
Dialogue: 0,0:16:14.81,0:16:15.93,Default,,0000,0000,0000,,!لا يزال بالقرب إذاً
Dialogue: 0,0:16:17.30,0:16:18.63,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:16:24.34,0:16:25.84,Default,,0000,0000,0000,,انظر يا فتى
Dialogue: 0,0:16:25.84,0:16:27.33,Default,,0000,0000,0000,,إنها هدية لك
Dialogue: 0,0:16:27.33,0:16:28.13,Default,,0000,0000,0000,,!مرحى
Dialogue: 0,0:16:28.67,0:16:30.36,Default,,0000,0000,0000,,!شكراً يا عمّ
Dialogue: 0,0:16:32.38,0:16:36.33,Default,,0000,0000,0000,,هل ستأخذني إلى مكان مسلٍّ بعد هذا حقاً؟
Dialogue: 0,0:16:36.33,0:16:38.96,Default,,0000,0000,0000,,أجل، سآخذك هناك قريباً
Dialogue: 0,0:16:39.70,0:16:41.88,Default,,0000,0000,0000,,إلى حيث يوجد تومويا
Dialogue: 0,0:16:44.20,0:16:45.88,Default,,0000,0000,0000,,!أين؟ أين هما؟
Dialogue: 0,0:16:48.61,0:16:49.61,Default,,0000,0000,0000,,تومويا
Dialogue: 0,0:16:51.02,0:16:53.06,Default,,0000,0000,0000,,لا بد أنّ الوحدة لازمتك
Dialogue: 0,0:16:53.06,0:16:55.32,Default,,0000,0000,0000,,سأرسل لك صديقاً قريباً
Dialogue: 0,0:16:56.12,0:16:57.86,Default,,0000,0000,0000,,!فوراً الآن
Dialogue: 0,0:17:02.89,0:17:04.92,Default,,0000,0000,0000,,!إنّه... يوتا
Dialogue: 0,0:17:05.39,0:17:06.37,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:08.67,0:17:09.46,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:17:13.34,0:17:14.92,Default,,0000,0000,0000,,!حسنٌ، انتظر هذه
Dialogue: 0,0:17:25.54,0:17:26.94,Default,,0000,0000,0000,,!انطلقي
Dialogue: 0,0:17:45.85,0:17:48.96,Default,,0000,0000,0000,,!هل قام كونان-كن بذلك؟
Dialogue: 0,0:17:49.71,0:17:51.34,Default,,0000,0000,0000,,!يوتا
Dialogue: 0,0:17:52.42,0:17:53.80,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:17:53.80,0:17:55.68,Default,,0000,0000,0000,,!يوتا
Dialogue: 0,0:17:57.66,0:17:59.79,Default,,0000,0000,0000,,!توقّفا
Dialogue: 0,0:18:00.16,0:18:02.99,Default,,0000,0000,0000,,!تحرّكا وتعرفان ما سيحصل
Dialogue: 0,0:18:03.49,0:18:05.26,Default,,0000,0000,0000,,!أوغينو-سان! كان أنت إذاً؟
Dialogue: 0,0:18:05.70,0:18:07.65,Default,,0000,0000,0000,,!أجل، كان أنا
Dialogue: 0,0:18:07.65,0:18:10.44,Default,,0000,0000,0000,,أبو أوغينو تومويا
Dialogue: 0,0:18:10.44,0:18:12.38,Default,,0000,0000,0000,,الذي قتلته قبل 3 أعوام\N!في عمليتك الفاشلة
Dialogue: 0,0:18:12.38,0:18:14.86,Default,,0000,0000,0000,,!لم يكن فشلاً مني
Dialogue: 0,0:18:15.14,0:18:16.84,Default,,0000,0000,0000,,...كان الأوان قد فات بموعد وصوله المشفى
Dialogue: 0,0:18:17.04,0:18:19.64,Default,,0000,0000,0000,,اخرس! كأنّك تفهم مشاعر أب قُتل ابنه
Dialogue: 0,0:18:19.64,0:18:22.00,Default,,0000,0000,0000,,!فورما بلغ الخامسة
Dialogue: 0,0:18:22.60,0:18:27.67,Default,,0000,0000,0000,,كلّ ما تبقى هو ممتلكاته والـ25\N!مليون من مبلغ التأمين
Dialogue: 0,0:18:27.67,0:18:29.92,Default,,0000,0000,0000,,...لذلك أرسلتَ كلّ ذلك المال
Dialogue: 0,0:18:30.26,0:18:31.55,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:31.55,0:18:35.30,Default,,0000,0000,0000,,المال والألعاب ومجد الصباح التي أحبها ابني
Dialogue: 0,0:18:35.30,0:18:37.67,Default,,0000,0000,0000,,!أرسلتها بكلّ بغضي لك
Dialogue: 0,0:18:37.67,0:18:42.25,Default,,0000,0000,0000,,!الآن دورك لتتجرّع حزن فقدان ابن
Dialogue: 0,0:18:42.25,0:18:45.59,Default,,0000,0000,0000,,!أ-أرجوك! لا تؤذ ابني
Dialogue: 0,0:18:46.28,0:18:48.00,Default,,0000,0000,0000,,!اقتلني بدلاً عنه
Dialogue: 0,0:18:48.69,0:18:52.40,Default,,0000,0000,0000,,!دع ابني يذهب فقط! ابني
Dialogue: 0,0:18:52.40,0:18:56.67,Default,,0000,0000,0000,,!هكذا إذاً! أنت من أرسل الألعاب
Dialogue: 0,0:18:57.55,0:18:59.04,Default,,0000,0000,0000,,!شكراً يا عمّ
Dialogue: 0,0:18:59.30,0:19:01.63,Default,,0000,0000,0000,,!أعتني بها دوماً
Dialogue: 0,0:19:02.31,0:19:03.55,Default,,0000,0000,0000,,تـ-تومويا
Dialogue: 0,0:19:10.59,0:19:13.17,Default,,0000,0000,0000,,...تـ-تومويا
Dialogue: 0,0:19:14.13,0:19:15.42,Default,,0000,0000,0000,,ما الخطب يا عمّ؟
Dialogue: 0,0:19:15.42,0:19:17.63,Default,,0000,0000,0000,,هل قال أبي والبقية شيئاً سيّئاً لك؟
Dialogue: 0,0:19:18.41,0:19:20.54,Default,,0000,0000,0000,,كلا يا فتى
Dialogue: 0,0:19:20.54,0:19:22.63,Default,,0000,0000,0000,,أنا من كان السيّئ
Dialogue: 0,0:19:23.36,0:19:24.75,Default,,0000,0000,0000,,كنت أعرف
Dialogue: 0,0:19:25.00,0:19:27.54,Default,,0000,0000,0000,,أعرف من البداية أنّه لم يكن خطأه
Dialogue: 0,0:19:28.15,0:19:33.86,Default,,0000,0000,0000,,...لكن لو لم أفكر بهذا الشكل، فكيف أستطيع
Dialogue: 0,0:19:35.36,0:19:37.92,Default,,0000,0000,0000,,!آسف يا فتى! آسف
Dialogue: 0,0:19:39.98,0:19:42.35,Default,,0000,0000,0000,,ران، اتّصلي بالشرطة
Dialogue: 0,0:19:43.98,0:19:46.72,Default,,0000,0000,0000,,!انتظر! لا داعي لتدخل الشرطة
Dialogue: 0,0:19:47.02,0:19:49.09,Default,,0000,0000,0000,,لكنه حاول قتل ابنك
Dialogue: 0,0:19:50.22,0:19:52.03,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:19:52.42,0:19:53.76,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,0:19:55.34,0:20:00.08,Default,,0000,0000,0000,,أوغينو-سان، أتفهّم شعورك تماماً
Dialogue: 0,0:20:00.08,0:20:04.08,Default,,0000,0000,0000,,فأنا أب مثلك قبل أن أكون طبيباً
Dialogue: 0,0:20:06.52,0:20:09.13,Default,,0000,0000,0000,,حمداً لله على أنها لم تنته بمكروه
Dialogue: 0,0:20:09.86,0:20:13.54,Default,,0000,0000,0000,,لكن لمَ أرسل المال والألعاب لعامين كاملين؟
Dialogue: 0,0:20:13.54,0:20:17.43,Default,,0000,0000,0000,,كان ينتظر بلوغ يوتا-كن 5 أعوام غالباً
Dialogue: 0,0:20:17.43,0:20:20.75,Default,,0000,0000,0000,,ليكون بنفس عمر تومويا-كن\Nالذي مات قبل 3 أعوام
Dialogue: 0,0:20:20.75,0:20:23.51,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:20:23.51,0:20:24.96,Default,,0000,0000,0000,,استنتاج بارع كالعادة
Dialogue: 0,0:20:28.21,0:20:30.87,Default,,0000,0000,0000,,!لكنّي مجرد طفل فلست متأكداً حقّاً
Dialogue: 0,0:20:31.54,0:20:33.25,Default,,0000,0000,0000,,!تذكرت أمراً عليّ فعله
Dialogue: 0,0:20:33.25,0:20:34.62,Default,,0000,0000,0000,,!اسبقاني إلى المنزل
Dialogue: 0,0:20:37.33,0:20:38.80,Default,,0000,0000,0000,,ما خطبه؟
Dialogue: 0,0:22:13.10,0:22:14.88,Default,,0000,0000,0000,,!عدت
Dialogue: 0,0:22:15.21,0:22:17.34,Default,,0000,0000,0000,,ماذا؟ أين العمّ؟
Dialogue: 0,0:22:17.34,0:22:19.85,Default,,0000,0000,0000,,خرج للشرب
Dialogue: 0,0:22:20.34,0:22:23.41,Default,,0000,0000,0000,,لا بد أنّك تشعر بالجوع، سأعد لك شيئاً
Dialogue: 0,0:22:23.77,0:22:25.08,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:22:25.08,0:22:26.28,Default,,0000,0000,0000,,بالمناسبة
Dialogue: 0,0:22:26.28,0:22:29.18,Default,,0000,0000,0000,,سمعتُ أن أستاذ التربية البدنية\Nكيشيدا سينسي سيتزوج
Dialogue: 0,0:22:30.49,0:22:32.05,Default,,0000,0000,0000,,ذاك الغوريلا؟
Dialogue: 0,0:22:35.48,0:22:39.30,Default,,0000,0000,0000,,كيف عرفت مدرّسي في الثانوية؟
Dialogue: 0,0:22:39.65,0:22:43.18,Default,,0000,0000,0000,,!كـ-كلا، أنت تتكلمين دائماً عن أنه غوريلا
Dialogue: 0,0:22:43.18,0:22:44.43,Default,,0000,0000,0000,,!كاذب
Dialogue: 0,0:22:44.43,0:22:48.89,Default,,0000,0000,0000,,!لم أستطع التصديق في البداية، لكنّك شينتشي حقاً
Dialogue: 0,0:22:48.89,0:22:50.30,Default,,0000,0000,0000,,...كلا، أنا
Dialogue: 0,0:22:50.68,0:22:53.30,Default,,0000,0000,0000,,!اعترف فقط! يا شينتشي
Dialogue: 0,0:22:58.30,0:22:59.71,Default,,0000,0000,0000,,...الـ-الهاتف
Dialogue: 0,0:22:59.71,0:23:00.60,Default,,0000,0000,0000,,!دعه يرنّ
Dialogue: 0,0:23:00.60,0:23:02.66,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:23:03.80,0:23:06.12,Default,,0000,0000,0000,,!حسناً، سأردّ
Dialogue: 0,0:23:10.49,0:23:12.12,Default,,0000,0000,0000,,...أجل، هذه وكالة موري للتحرّي
Dialogue: 0,0:23:12.12,0:23:13.47,Default,,0000,0000,0000,,!مرحباً يا ران
Dialogue: 0,0:23:13.47,0:23:14.90,Default,,0000,0000,0000,,!مضت فترة
Dialogue: 0,0:23:14.90,0:23:16.68,Default,,0000,0000,0000,,شـ-شينتشي؟
Dialogue: 0,0:23:17.15,0:23:18.77,Default,,0000,0000,0000,,...لا يمكن! فأنت
Dialogue: 0,0:23:19.19,0:23:22.89,Default,,0000,0000,0000,,ماذا؟ أنسيتِ صوتي بالفعل؟
Dialogue: 0,0:23:23.19,0:23:25.60,Default,,0000,0000,0000,,!يا لقسوتك
Dialogue: 0,0:23:25.60,0:23:27.65,Default,,0000,0000,0000,,تبّاً لك يا شينتشي
Dialogue: 0,0:23:28.77,0:23:31.93,Default,,0000,0000,0000,,!أرجوك يا بروفسور آغاسا! ران تشكّ بهويتي
Dialogue: 0,0:23:31.93,0:23:34.96,Default,,0000,0000,0000,,!اتّصل بها باستعمال صوتي
Dialogue: 0,0:23:34.96,0:23:38.59,Default,,0000,0000,0000,,كان عليه ألّا يجعلها تقلق هكذا
Dialogue: 0,0:23:38.59,0:23:39.55,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:23:39.55,0:23:41.51,Default,,0000,0000,0000,,أتسمعينني يا ران؟
Dialogue: 0,0:23:42.84,0:23:46.79,Default,,0000,0000,0000,,!يا لحماقتي! يبدو أنّي أسأت الفهم
Dialogue: 0,0:23:46.79,0:23:48.47,Default,,0000,0000,0000,,كلا، لا شيء
Dialogue: 0,0:23:48.83,0:23:52.41,Default,,0000,0000,0000,,أخبرني إذاً يا شينتشي، بدأت تتكلم كالمسنين؟
Dialogue: 0,0:23:52.41,0:23:53.83,Default,,0000,0000,0000,,حـ-حقاً؟
Dialogue: 0,0:23:56.57,0:23:58.15,Default,,0000,0000,0000,,نجوت
Dialogue: 0,0:24:01.69,0:24:03.27,Default,,0000,0000,0000,,!توجد لوحات جميلة كثيرة
Dialogue: 0,0:24:04.24,0:24:05.60,Default,,0000,0000,0000,,!أنا مسرورة لقدومنا
Dialogue: 0,0:24:05.60,0:24:07.36,Default,,0000,0000,0000,,!انظرا لهذه! ألوانها جميلة
Dialogue: 0,0:24:18.76,0:24:20.01,Default,,0000,0000,0000,,!ما خطب تلك التعابير؟
Dialogue: 0,0:24:21.97,0:24:23.97,Default,,0000,0000,0000,,!ما الذي صعقه على تلك البطاقة؟
Dialogue: 0,0:24:23.97,0:24:25.42,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.42,0:24:28.06,Default,,0000,0000,0000,,جريمة قتل مالك متحف الفنون
Dialogue: 0,0:24:45.19,0:24:47.23,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.23,0:24:49.56,Default,,0000,0000,0000,,ملاحظة بقلم مدبب
Dialogue: 0,0:24:50.68,0:24:53.01,Default,,0000,0000,0000,,!ستتخلّفون إذا فاتتكم حلقة الأسبوع القادم

