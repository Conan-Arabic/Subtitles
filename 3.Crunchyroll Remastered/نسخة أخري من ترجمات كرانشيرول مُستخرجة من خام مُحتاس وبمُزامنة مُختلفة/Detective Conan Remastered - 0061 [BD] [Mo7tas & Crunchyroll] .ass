Dialogue: 0,0:00:01.28,0:00:04.83,Default,,0000,0000,0000,,،عقرب دقائق مسرِع، مُذنّب ساقط\Nدمية آلية الخروج، وحشد ناس
Dialogue: 0,0:00:04.83,0:00:08.16,Default,,0000,0000,0000,,تبلل الاستنتاجات المفككة للغموض\Nأسوار القلوب الجافة
Dialogue: 0,0:00:08.16,0:00:11.31,Default,,0000,0000,0000,,قضيّة اليوم هي أوّل حلقة تلفزية أصلية بجزأين
Dialogue: 0,0:00:11.31,0:00:12.98,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.98,0:00:15.19,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:15.19,0:00:16.56,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:02:28.69,0:02:30.43,Default,,0000,0000,0000,,!حضرة العمدة! أسرع
Dialogue: 0,0:02:31.64,0:02:33.10,Default,,0000,0000,0000,,ما هذه؟
Dialogue: 0,0:02:33.10,0:02:35.43,Default,,0000,0000,0000,,أجرفتها عاصفة البارحة إلى هنا؟
Dialogue: 0,0:02:35.43,0:02:36.89,Default,,0000,0000,0000,,...تـ-تلك
Dialogue: 0,0:02:42.97,0:02:45.89,On Top,,0000,0000,0000,,ريوجين مارو
Dialogue: 0,0:02:46.30,0:02:50.33,Default,,0000,0000,0000,,أليس ذاك القارب الذي فُقد\Nفي العاصفة قبل 7 أعوام؟
Dialogue: 0,0:02:50.33,0:02:51.76,Default,,0000,0000,0000,,!جهّزوا القوارب
Dialogue: 0,0:02:51.76,0:02:52.51,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:02:57.52,0:03:03.03,Default,,0000,0000,0000,,كان يوجد ذهب يُعادل مليار ينّ\Nعلى متنه وفقما أذكر
Dialogue: 0,0:03:06.45,0:03:07.62,Default,,0000,0000,0000,,كيف الأمر؟
Dialogue: 0,0:03:07.62,0:03:09.81,Default,,0000,0000,0000,,لا يوجد شيء على متنه
Dialogue: 0,0:03:09.81,0:03:12.64,Default,,0000,0000,0000,,مُحال! أين اختفى الذهب؟
Dialogue: 0,0:03:13.06,0:03:17.56,Default,,0000,0000,0000,,لمَ ظهرت الآن بعد كلّ ذاك الوقت؟
Dialogue: 0,0:03:17.56,0:03:19.41,Default,,0000,0000,0000,,كأنّها سفينة أشباح
Dialogue: 0,0:03:19.41,0:03:20.59,Default,,0000,0000,0000,,أ-أشباح؟
Dialogue: 0,0:03:20.59,0:03:23.10,Default,,0000,0000,0000,,!أيمكن أنّها لعنة سويغون؟
Dialogue: 0,0:03:23.80,0:03:27.89,Default,,0000,0000,0000,,!أحمق! لا وجود للعنات\N!إنّها مجرد خرافات سخيفة
Dialogue: 0,0:03:35.23,0:03:41.14,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل سفينة الأشباح (الجزء الأوّل
Dialogue: 0,0:03:35.46,0:03:39.05,Default,,0000,0000,0000,,(جريمة قتل سفينة الأشباح (الجزء الأوّل
Dialogue: 0,0:03:45.36,0:03:48.82,On Top,,0000,0000,0000,,سنصل جزيرة شيكي في قرابة 3 ساعات
Dialogue: 0,0:03:47.83,0:03:51.03,CharCard,,0000,0000,0005,,{\fad(300,0)} (كينوشيتا غورو (53\Nنائب عمدة في بلدية جزيرة شيكي
Dialogue: 0,0:03:48.82,0:03:51.40,On Top,,0000,0000,0000,,نقدّر قطعك الطريق الطويل
Dialogue: 0,0:03:51.40,0:03:54.89,On Top,,0000,0000,0000,,لإقامة محاضرة لنا
Dialogue: 0,0:03:54.89,0:03:58.77,Default,,0000,0000,0000,,إنّه طريق طويل بالفعل
Dialogue: 0,0:04:00.26,0:04:01.80,Default,,0000,0000,0000,,أخبرني يا كينوشيتا-سان
Dialogue: 0,0:04:02.09,0:04:07.14,Default,,0000,0000,0000,,سمعتُ أنّ سفينةً فُقدت قبل 7 أعوام\Nوعلى متنها ما يعادل مليار ينّ ذهباً
Dialogue: 0,0:04:07.14,0:04:09.06,Default,,0000,0000,0000,,!قد ظهرت مؤخراً
Dialogue: 0,0:04:09.30,0:04:13.72,Default,,0000,0000,0000,,أجل! يظنّ أهل الجزيرة أنّها سفينة أشباح
Dialogue: 0,0:04:13.72,0:04:17.18,Default,,0000,0000,0000,,لكنّكم لم تجدوا الذهب؟
Dialogue: 0,0:04:17.75,0:04:22.51,Default,,0000,0000,0000,,كلا، لم نعد متأكدين إن كان موجوداً\Nعلى متنها بالأصل الآن
Dialogue: 0,0:04:23.10,0:04:28.70,Default,,0000,0000,0000,,العُمدة مسرور لمجرّد جذب البلدة\Nالكثير من الاهتمام بسبب السفينة
Dialogue: 0,0:04:28.70,0:04:31.61,Default,,0000,0000,0000,,سفينة أشباح تجذب الاهتمام؟
Dialogue: 0,0:04:31.61,0:04:34.31,Default,,0000,0000,0000,,بالطبع! وهذا ليس كلّ شيء
Dialogue: 0,0:04:34.31,0:04:39.69,Default,,0000,0000,0000,,دعوه شخص بمثل شهرتك هي\Nطريقة أخرى لكسب الاعتبار
Dialogue: 0,0:04:40.72,0:04:44.93,Default,,0000,0000,0000,,تصل سمعتي هذه الأرجاء؟
Dialogue: 0,0:04:44.93,0:04:46.30,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:04:46.30,0:04:51.09,Default,,0000,0000,0000,,...كلّ من في اليابان يعرف المتحرّي العظيم موري-سان
Dialogue: 0,0:05:00.03,0:05:01.93,Default,,0000,0000,0000,,من ذاك الشخص؟
Dialogue: 0,0:05:02.24,0:05:05.24,Default,,0000,0000,0000,,يعمل لوكالة سفر في طوكيو
Dialogue: 0,0:05:05.24,0:05:10.88,Default,,0000,0000,0000,,يريد إقامة جولة تتمحور حول سفينة الأشباح
Dialogue: 0,0:05:15.43,0:05:18.06,CharCard,,0000,0000,0010,,{\fad(300,0)}جزيرة شيكي
Dialogue: 0,0:05:28.22,0:05:29.67,Default,,0000,0000,0000,,!إنّه المتحرّي موري
Dialogue: 0,0:05:28.22,0:05:33.38,On Top,,0000,0000,0000,,!مرحباً بك يا موري كوغورو سينسي
Dialogue: 0,0:05:29.67,0:05:31.89,Default,,0000,0000,0000,,!هو حقّاً
Dialogue: 0,0:05:31.89,0:05:33.38,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:05:34.45,0:05:36.37,Default,,0000,0000,0000,,!يا للترحيب الحافل
Dialogue: 0,0:05:41.03,0:05:44.42,Default,,0000,0000,0000,,!موري سينسي! شكراً لقطعك كلّ الطريق الطويل
Dialogue: 0,0:05:44.50,0:05:47.56,CharCard,,0000,0000,0005,,{\fad(300,0)}(ميكامي تاكيو (50\Nعمدة جزيرة شيكي
Dialogue: 0,0:05:44.99,0:05:46.56,On Top,,0000,0000,0000,,أنا العمدة ميكامي
Dialogue: 0,0:05:46.56,0:05:49.63,On Top,,0000,0000,0000,,!نرحب بك بكلّ تقدير
Dialogue: 0,0:05:50.06,0:05:51.23,Default,,0000,0000,0000,,شكراً لكم
Dialogue: 0,0:05:51.23,0:05:54.06,Default,,0000,0000,0000,,أهذا المُسن السخيف مشهور حقّاً؟
Dialogue: 0,0:05:55.10,0:05:59.05,Default,,0000,0000,0000,,ظننتُك ستكون أكثر روعة\Nإن كنت متحرّياً معروفاً
Dialogue: 0,0:05:59.05,0:06:00.63,Default,,0000,0000,0000,,!ماذا قلتِ يا طفلة؟
Dialogue: 0,0:06:00.63,0:06:03.72,Default,,0000,0000,0000,,!سوزو! لا تتكلمي بفظاظة مع ضيف أبيك
Dialogue: 0,0:06:04.47,0:06:07.30,Default,,0000,0000,0000,,!يا للابنة الظريفة
Dialogue: 0,0:06:12.83,0:06:13.96,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:13.96,0:06:15.58,Default,,0000,0000,0000,,ما اسمك؟
Dialogue: 0,0:06:15.58,0:06:17.83,Default,,0000,0000,0000,,كونان، إيدوغاوا كونان
Dialogue: 0,0:06:17.83,0:06:21.59,Default,,0000,0000,0000,,اسمٌ غريب، أهو شعبيّ في طوكيو؟
Dialogue: 0,0:06:21.90,0:06:23.21,Default,,0000,0000,0000,,دعيني وشأني
Dialogue: 0,0:06:23.65,0:06:25.15,Default,,0000,0000,0000,,لا يهم
Dialogue: 0,0:06:25.15,0:06:28.28,CharCard,,0000,0000,0005,,{\fad(300,0)}(ميكامي سوزو (7\Nابنة العمدة ميكامي
Dialogue: 0,0:06:25.15,0:06:29.43,On Top,,0000,0000,0000,,اسمي ميكامي سوزو، يبدو أنّي أكبر منك قليلاً
Dialogue: 0,0:06:31.44,0:06:34.56,Default,,0000,0000,0000,,!مرافقة الأصغر سنّاً أمر شعبيّ مؤخراً
Dialogue: 0,0:06:35.39,0:06:36.05,Default,,0000,0000,0000,,ابتعد
Dialogue: 0,0:06:37.60,0:06:40.00,Default,,0000,0000,0000,,...هذا من وكالة
Dialogue: 0,0:06:40.10,0:06:43.08,CharCard,,0000,0000,0005,,{\fad(300,0)}(أويهارا ياسو (44\Nموظّف مبيعات في وكالة توتو للسفر
Dialogue: 0,0:06:40.10,0:06:43.56,On Top,,0000,0000,0000,,أنا أوريهارا من وكالة توتو للسفر، سررت بلقائك
Dialogue: 0,0:06:43.56,0:06:49.15,Default,,0000,0000,0000,,مرحباً! سنساعد بأيّ طريقة\Nلجلب السيّاح هنا
Dialogue: 0,0:06:49.15,0:06:50.87,Default,,0000,0000,0000,,أين سفينة الأشباح؟
Dialogue: 0,0:06:56.35,0:06:58.65,Default,,0000,0000,0000,,ها هي
Dialogue: 0,0:06:59.80,0:07:01.39,Default,,0000,0000,0000,,سأرشدك
Dialogue: 0,0:07:02.26,0:07:05.26,Default,,0000,0000,0000,,لا داعي، سأتفقدها بنفسي
Dialogue: 0,0:07:10.62,0:07:12.85,Default,,0000,0000,0000,,كانت هذه السفينة في قاع المحيط لأعوام
Dialogue: 0,0:07:13.41,0:07:16.31,Default,,0000,0000,0000,,لكن لا يوجد سوى قشريات بحرية أسفلها
Dialogue: 0,0:07:16.70,0:07:19.77,Default,,0000,0000,0000,,!أحمق! إنّها سفينة أشباح
Dialogue: 0,0:07:20.36,0:07:22.73,Default,,0000,0000,0000,,...ليس علميّاً أبداً
Dialogue: 0,0:07:27.48,0:07:29.91,CharCard,,0000,0000,0005,,{\fad(300,0)}(42) كوجي هامادا\Nحارس المنارة
Dialogue: 0,0:07:30.02,0:07:32.73,On Top,,0000,0000,0000,,محاضرة المتحرّي العظيم موري كوغورو
Dialogue: 0,0:07:32.73,0:07:38.77,Default,,0000,0000,0000,,تفضّل يا موري سينسي! لا يزال\Nأمامنا وقت قبل المحاضرة
Dialogue: 0,0:07:38.77,0:07:40.07,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:07:43.92,0:07:45.61,Default,,0000,0000,0000,,!لذيذ
Dialogue: 0,0:07:46.09,0:07:48.80,Default,,0000,0000,0000,,محّار العمامة المطهو هذا طيّب المذاق، صحيح؟
Dialogue: 0,0:07:48.80,0:07:49.61,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:50.25,0:07:55.31,Default,,0000,0000,0000,,بالمناسبة يا سينسي، أريد طلب مساعدتك \Nفي أمر بعد المحاضرة
Dialogue: 0,0:07:56.41,0:08:01.27,Default,,0000,0000,0000,,تريدني أن أجد موقع غرق ريوجين مارو... صحيح؟
Dialogue: 0,0:08:01.27,0:08:07.24,Default,,0000,0000,0000,,يا للفطنة! أظنّها غرقت بالقرب من الجزيرة
Dialogue: 0,0:08:07.24,0:08:11.23,Default,,0000,0000,0000,,إذا عرفنا المكان، يمكننا العثور على الذهب المفقود
Dialogue: 0,0:08:11.48,0:08:16.35,Default,,0000,0000,0000,,لكن إذا عثرتم عليه فلن يكون لكم
Dialogue: 0,0:08:16.35,0:08:18.94,Default,,0000,0000,0000,,ستأتي الحكومة وتأخذه
Dialogue: 0,0:08:18.94,0:08:23.55,Default,,0000,0000,0000,,لكن ألا يحقّ لنا 10% على الأقل؟
Dialogue: 0,0:08:23.55,0:08:26.02,Default,,0000,0000,0000,,...ر-ربما، لكن
Dialogue: 0,0:08:26.55,0:08:28.86,Default,,0000,0000,0000,,!أرجوك يا موري سينسي
Dialogue: 0,0:08:30.87,0:08:34.81,Default,,0000,0000,0000,,أرفض! لن يُنقص متحرٍّ عظيم من مقامه\N...للعب لعبة بحث عن كنز
Dialogue: 0,0:08:34.81,0:08:38.27,Default,,0000,0000,0000,,سنعطيك 10% من حصّة الجزيرة
Dialogue: 0,0:08:38.54,0:08:40.20,Default,,0000,0000,0000,,!موافق
Dialogue: 0,0:08:40.20,0:08:41.81,Default,,0000,0000,0000,,!شكراً جزيلاً
Dialogue: 0,0:08:43.77,0:08:46.47,Default,,0000,0000,0000,,كينوشيتا! أعطه التفاصيل
Dialogue: 0,0:08:46.47,0:08:47.48,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:08:47.86,0:08:51.06,Default,,0000,0000,0000,,وقع الأمر قبل 7 أعوام في ليلة عاصفة
Dialogue: 0,0:08:51.06,0:08:56.65,Default,,0000,0000,0000,,وصلنا نداء استغاثة من ريوجين مارو\Nعلى بعد كيلومتر واحد من الشاطئ
Dialogue: 0,0:08:56.65,0:09:00.43,Default,,0000,0000,0000,,لكنّ الإشارة اختفت فجأةً بعدما\Nتوجّه طاقم إنقاذ لها
Dialogue: 0,0:09:00.43,0:09:05.64,Default,,0000,0000,0000,,وفي اليوم التالي جرفت الأمواج\Nجثّة المالك للشاطئ فحسب
Dialogue: 0,0:09:05.64,0:09:10.98,Default,,0000,0000,0000,,لم نعثر على أيّ آثار حطام، دون ذكر الذهب
Dialogue: 0,0:09:11.29,0:09:13.94,Default,,0000,0000,0000,,من كان صاحب الذهب؟
Dialogue: 0,0:09:14.25,0:09:18.38,Default,,0000,0000,0000,,مالك السفينة، كان سيُعتقل للتهرّب من الضرائب
Dialogue: 0,0:09:18.38,0:09:21.24,Default,,0000,0000,0000,,فحوّل كل ثروته لذهب وكان في طريقه
Dialogue: 0,0:09:21.24,0:09:23.23,Default,,0000,0000,0000,,لمغادرة البلاد
Dialogue: 0,0:09:24.03,0:09:25.91,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:09:25.91,0:09:31.02,Default,,0000,0000,0000,,حسنٌ، سأقوم أنا موري كوغورو بالبحث\N!عن مكان الذهب لكم
Dialogue: 0,0:09:31.02,0:09:33.23,Default,,0000,0000,0000,,!شكراً جزيلاً
Dialogue: 0,0:09:38.27,0:09:40.72,Default,,0000,0000,0000,,هل سيمضي أمر المحاضرة هذا على ما يرام؟
Dialogue: 0,0:09:40.72,0:09:42.76,Default,,0000,0000,0000,,ألن يحرج نفسه وحسب؟
Dialogue: 0,0:09:46.77,0:09:49.23,Default,,0000,0000,0000,,متحف أثريات سويغون
Dialogue: 0,0:10:00.87,0:10:02.45,Default,,0000,0000,0000,,...درع القائد
Dialogue: 0,0:10:04.20,0:10:05.36,Default,,0000,0000,0000,,أتجده مثيراً للاهتمام؟
Dialogue: 0,0:10:05.70,0:10:08.58,Default,,0000,0000,0000,,!نعم! توجد أشياء نادرة كثيرة
Dialogue: 0,0:10:08.58,0:10:11.61,Default,,0000,0000,0000,,أجل، إنّه ميراث الجزيرة الثقافي
Dialogue: 0,0:10:12.31,0:10:16.02,Default,,0000,0000,0000,,قبل 400 عام، هرب سويغون إلى هنا
Dialogue: 0,0:10:16.02,0:10:18.73,Default,,0000,0000,0000,,بعد خسارته في معركة كبيرة
Dialogue: 0,0:10:19.17,0:10:24.29,Default,,0000,0000,0000,,لكنّ أهل الجزيرة أرادوا مال الجائزة على رأسه
Dialogue: 0,0:10:24.29,0:10:27.45,Default,,0000,0000,0000,,وهاجموا سويغون المُصاب
Dialogue: 0,0:10:27.45,0:10:34.25,Default,,0000,0000,0000,,دفعوه ورجاله لكهف معزول وقتلوهم جميعاً
Dialogue: 0,0:10:34.25,0:10:38.94,Default,,0000,0000,0000,,حدثت العديد من الأمور السيّئة مُذ آنذاك
Dialogue: 0,0:10:38.94,0:10:40.22,Default,,0000,0000,0000,,كاللعنة؟
Dialogue: 0,0:10:40.22,0:10:45.46,Default,,0000,0000,0000,,أجل، لذا بُني ضريح في الكهف\Nلتهدئة روح سويغون
Dialogue: 0,0:10:45.46,0:10:47.92,Default,,0000,0000,0000,,لكن أليست اللعنات مجرد خرافات؟
Dialogue: 0,0:10:48.68,0:10:51.16,Default,,0000,0000,0000,,كلا، ليس صحيحاً
Dialogue: 0,0:10:52.00,0:10:58.21,Default,,0000,0000,0000,,رأى العديد من الناس الذين يعيشون \Nقرب الكهف أشباحاً ترتدي درعاً
Dialogue: 0,0:10:58.21,0:11:04.03,Default,,0000,0000,0000,,ويمكنك سماع أنين مُخيف من أعماق الكهف
Dialogue: 0,0:11:06.12,0:11:09.37,Default,,0000,0000,0000,,أظنّ الحادثة كانت قبل 5 أعوام
Dialogue: 0,0:11:09.37,0:11:13.83,Default,,0000,0000,0000,,عندما أتى بروفسور جامعيّ هنا لدراسة سويغون
Dialogue: 0,0:11:14.19,0:11:19.53,Default,,0000,0000,0000,,تجاهل تحذيرات أهل الجزيرة وذهب لفحص الكهف
Dialogue: 0,0:11:19.53,0:11:22.65,Default,,0000,0000,0000,,...وبعد ليلتين إلى ثلاث
Dialogue: 0,0:11:35.67,0:11:37.08,Default,,0000,0000,0000,,وذاك البروفسور؟
Dialogue: 0,0:11:37.67,0:11:44.58,Default,,0000,0000,0000,,أجل، لم يُؤكد الأمر... لكنه أصبح مفقوداً مُذ آنذاك
Dialogue: 0,0:11:44.58,0:11:48.75,Default,,0000,0000,0000,,لم يعد هناك من يجرؤ على الاقتراب من الكهف الآن
Dialogue: 0,0:11:48.75,0:11:52.20,Default,,0000,0000,0000,,تصديق هذا الكلام في زماننا هو\Nما يجعل الآخرين يضحكون عليك
Dialogue: 0,0:11:52.52,0:11:53.46,Default,,0000,0000,0000,,سيّدتي الصغيرة
Dialogue: 0,0:11:53.46,0:11:57.25,Default,,0000,0000,0000,,قال أبي أنّ البروفسور فحص الكهف\Nلكنّه غادر غالباً
Dialogue: 0,0:11:57.25,0:12:01.20,Default,,0000,0000,0000,,لأنّه لم يجد شيئاً داخله
Dialogue: 0,0:12:04.45,0:12:07.24,Default,,0000,0000,0000,,!هيّا بنا يا كونان-كن! سأريك مكاناً رائعاً
Dialogue: 0,0:12:07.24,0:12:08.56,Default,,0000,0000,0000,,!ا-انتظري
Dialogue: 0,0:12:10.81,0:12:12.30,Default,,0000,0000,0000,,أين نذهب؟
Dialogue: 0,0:12:12.60,0:12:16.66,Default,,0000,0000,0000,,!يمكننا التسلل لوراء الكواليس من هنا\Nإنّها أفضل مقاعد
Dialogue: 0,0:12:21.59,0:12:22.78,Default,,0000,0000,0000,,ما خطبه؟
Dialogue: 0,0:12:22.78,0:12:23.93,Default,,0000,0000,0000,,من ذاك الشخص؟
Dialogue: 0,0:12:24.26,0:12:28.10,Default,,0000,0000,0000,,حارس المنارة هامادا، إنّه شخص غريب الأطوار
Dialogue: 0,0:12:28.10,0:12:29.59,Default,,0000,0000,0000,,غريب الأطوار؟
Dialogue: 0,0:12:29.88,0:12:36.51,Default,,0000,0000,0000,,لا يتسكّع مع أهل الجزيرة، ويذهب دائماً لكهف\Nسويغون الذي يتفاداه الجميع
Dialogue: 0,0:12:41.41,0:12:43.68,Default,,0000,0000,0000,,لم أرك منذ وقت طويل يا آوكي
Dialogue: 0,0:12:44.95,0:12:48.64,Default,,0000,0000,0000,,لا تتظاهر أنّك نسيت... وجهي هذا
Dialogue: 0,0:12:48.95,0:12:53.02,Default,,0000,0000,0000,,ما-ما الذي تتكلم عنه؟ أنا حارس المنارة هامادا
Dialogue: 0,0:12:53.02,0:12:53.80,Default,,0000,0000,0000,,!أيّها الوغد
Dialogue: 0,0:12:56.94,0:13:00.05,Default,,0000,0000,0000,,!لستُ من تظن! دعني
Dialogue: 0,0:13:02.93,0:13:06.31,Default,,0000,0000,0000,,سأخلع وجهك هذا يا آوكي
Dialogue: 0,0:13:09.30,0:13:14.22,Default,,0000,0000,0000,,!إذاً، ها هو المتحرّي العظيم موري كوغورو سينسي
Dialogue: 0,0:13:17.21,0:13:19.72,Default,,0000,0000,0000,,!شكراً، شكراً
Dialogue: 0,0:13:19.99,0:13:22.18,Default,,0000,0000,0000,,هل سيكون بخير وهو ثمل هكذا؟
Dialogue: 0,0:13:25.03,0:13:26.64,Default,,0000,0000,0000,,...بائس
Dialogue: 0,0:13:25.03,0:13:26.64,Default,,0000,0000,0000,,...بائس
Dialogue: 0,0:13:27.03,0:13:30.01,Default,,0000,0000,0000,,...يبدو أنّه متوتر قليلاً
Dialogue: 0,0:13:35.11,0:13:40.10,Default,,0000,0000,0000,,!لنجعله يفتح كرة الاحتفال شرفاً بقدومه
Dialogue: 0,0:13:40.10,0:13:41.89,Default,,0000,0000,0000,,!تفضّل يا سينسي
Dialogue: 0,0:13:50.13,0:13:50.63,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:54.46,0:13:55.05,Default,,0000,0000,0000,,...هذه الرائحة
Dialogue: 0,0:14:01.24,0:14:02.84,Default,,0000,0000,0000,,!إنّه... بنزين
Dialogue: 0,0:14:04.80,0:14:05.68,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:14:12.48,0:14:13.32,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:14:20.93,0:14:22.09,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:14:22.72,0:14:23.81,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:14:26.68,0:14:29.10,Default,,0000,0000,0000,,!نار! نار
Dialogue: 0,0:14:35.63,0:14:38.51,Default,,0000,0000,0000,,!إنّها اللعنة! لعنة سويغون-ساما
Dialogue: 0,0:14:40.62,0:14:42.01,Default,,0000,0000,0000,,!أ-أنتم
Dialogue: 0,0:14:46.25,0:14:51.93,Default,,0000,0000,0000,,فهمت، عُدّل الخيط بحيث يشعل البنزين\Nداخل الكرة عندما يُسحب
Dialogue: 0,0:14:51.93,0:14:55.07,Default,,0000,0000,0000,,والهدف... كان العمّ
Dialogue: 0,0:14:56.36,0:14:58.35,Default,,0000,0000,0000,,...ما يعني أنّ الأشخاص الأكثر شبهة
Dialogue: 0,0:14:58.82,0:15:01.34,Default,,0000,0000,0000,,هم هامادا-سان الذي خرج من الباب الخلفيّ
Dialogue: 0,0:15:01.77,0:15:05.10,Default,,0000,0000,0000,,وأويهارا-سان من وكالة السفر\Nالذي تشاجر معه
Dialogue: 0,0:15:06.14,0:15:09.22,Default,,0000,0000,0000,,أيمكن أنّ للأمر علاقة بسفينة الأشباح؟
Dialogue: 0,0:15:14.26,0:15:16.72,Default,,0000,0000,0000,,!حضرة العمدة! ما معنى هذا؟
Dialogue: 0,0:15:17.22,0:15:20.17,Default,,0000,0000,0000,,نجوتُ لأنّي مُدرّب بعناية فقط
Dialogue: 0,0:15:20.17,0:15:26.14,Default,,0000,0000,0000,,أقدّم خالص اعتذاري! توّرطك في هذه\N!الحادثة من شديد أسفي
Dialogue: 0,0:15:26.40,0:15:29.87,Default,,0000,0000,0000,,حادثة؟ كانت من تخطيط أحد بكلّ وضوح
Dialogue: 0,0:15:30.30,0:15:33.85,Default,,0000,0000,0000,,...كلا، أشعلت شرارات من دائرة قصر
Dialogue: 0,0:15:33.85,0:15:35.57,Default,,0000,0000,0000,,حاوية بنزين في الجوار
Dialogue: 0,0:15:35.58,0:15:36.33,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:15:36.33,0:15:39.04,Default,,0000,0000,0000,,كانت حادثة، لا شكّ في الأمر
Dialogue: 0,0:15:40.38,0:15:44.00,Default,,0000,0000,0000,,ألا تريد تفادي تدخل الشرطة وحسب؟
Dialogue: 0,0:15:45.71,0:15:48.96,Default,,0000,0000,0000,,أي لم تنو تسليم الذهب إذا وجدته، صحيح؟
Dialogue: 0,0:15:49.41,0:15:53.78,Default,,0000,0000,0000,,لكنك لن تمتلك خياراً إن أتت شرطة البرّ الرئيسي
Dialogue: 0,0:15:53.78,0:15:57.92,Default,,0000,0000,0000,,موري-سان! عليك البقاء صامتاً\Nوالعثور على الذهب وحسب
Dialogue: 0,0:15:57.92,0:15:59.32,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:16:00.52,0:16:05.29,Default,,0000,0000,0000,,عارضني ولا ضمان لأن تغادر هذه الجزيرة سليماً
Dialogue: 0,0:16:05.29,0:16:08.36,Default,,0000,0000,0000,,!لا يمكنك تهديدي
Dialogue: 0,0:16:08.36,0:16:12.10,Default,,0000,0000,0000,,لا تستطيع صعود العبّارة دون إذني
Dialogue: 0,0:16:13.10,0:16:16.72,Default,,0000,0000,0000,,حسناً، خذ وقتك بالتفكير الليلة
Dialogue: 0,0:16:17.71,0:16:19.50,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:16:19.50,0:16:22.16,Default,,0000,0000,0000,,يبدو أنّنا أتينا لجزيرة فظيعة
Dialogue: 0,0:16:23.63,0:16:24.84,Default,,0000,0000,0000,,كينوشيتا-سان
Dialogue: 0,0:16:24.84,0:16:28.84,Default,,0000,0000,0000,,آسف، يبدو أنّ العمدة مهتم\Nبالعثور على الذهب فقط
Dialogue: 0,0:16:28.84,0:16:31.87,Default,,0000,0000,0000,,وتحويل الجزيرة لنقطة سياحية
Dialogue: 0,0:16:32.29,0:16:34.24,Default,,0000,0000,0000,,!وغد أنانيّ
Dialogue: 0,0:16:34.24,0:16:36.29,Default,,0000,0000,0000,,لكن لا تقلقوا
Dialogue: 0,0:16:36.29,0:16:40.15,Default,,0000,0000,0000,,سآخذكم للبرّ الرئيسي بأيّ حال
Dialogue: 0,0:16:40.15,0:16:43.23,Default,,0000,0000,0000,,يمكنني تحضير قارب صيد\Nصغير لحسن الحظ
Dialogue: 0,0:16:43.23,0:16:44.55,Default,,0000,0000,0000,,!هذا رائع
Dialogue: 0,0:16:44.55,0:16:46.29,Default,,0000,0000,0000,,!كلا! أرفض التحرّك من هنا
Dialogue: 0,0:16:46.29,0:16:47.25,Default,,0000,0000,0000,,أبي؟
Dialogue: 0,0:16:47.25,0:16:48.82,Default,,0000,0000,0000,,!لا يمكنك
Dialogue: 0,0:16:48.82,0:16:51.20,Default,,0000,0000,0000,,!قد يصيبك الأذى إن بقيت
Dialogue: 0,0:16:51.85,0:16:56.92,Default,,0000,0000,0000,,لا مُتحرٍّ مرموق ذي احترام\N!قد يهرب بعد سماع كلام كهذا
Dialogue: 0,0:16:57.18,0:16:59.12,Default,,0000,0000,0000,,أحسنت القول يا عمّ
Dialogue: 0,0:17:04.17,0:17:05.76,Default,,0000,0000,0000,,كينوشيتا-سان
Dialogue: 0,0:17:05.76,0:17:08.46,Default,,0000,0000,0000,,كيف هو هامادا-سان بالضبط؟
Dialogue: 0,0:17:08.46,0:17:10.35,Default,,0000,0000,0000,,تقصد حارس المنارة؟
Dialogue: 0,0:17:10.35,0:17:11.28,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:17:11.28,0:17:15.87,Default,,0000,0000,0000,,لا أدري، ليس من أهل الجزيرة
Dialogue: 0,0:17:15.87,0:17:19.78,Default,,0000,0000,0000,,أتى بعد حادثة ريوجين مارو بفترة
Dialogue: 0,0:17:19.78,0:17:23.03,Default,,0000,0000,0000,,وقال أنّه يبحث عن عمل
Dialogue: 0,0:17:23.03,0:17:27.21,Default,,0000,0000,0000,,لم يكن هناك من يعمل في المنارة\Nفأخذ ذاك العمل
Dialogue: 0,0:17:28.90,0:17:30.98,Default,,0000,0000,0000,,هل قام هامادا بشيء؟
Dialogue: 0,0:17:30.98,0:17:34.10,Default,,0000,0000,0000,,لا! بدا لي غريباً قليلاً فقط
Dialogue: 0,0:17:34.10,0:17:35.50,Default,,0000,0000,0000,,!إلى اللقاء
Dialogue: 0,0:17:43.67,0:17:44.79,Default,,0000,0000,0000,,...يوكو-تشان
Dialogue: 0,0:17:57.33,0:17:58.57,Default,,0000,0000,0000,,أذاك هامادا-سان؟
Dialogue: 0,0:17:59.99,0:18:01.58,Default,,0000,0000,0000,,!إنّها أنا
Dialogue: 0,0:18:01.58,0:18:03.18,Default,,0000,0000,0000,,!لا تخيفيني
Dialogue: 0,0:18:04.04,0:18:09.16,Default,,0000,0000,0000,,ما خطبك؟! عليك أن تكون ممتناً للحاقي بك\N!وأنت طفل يمشي بمفرده آخر الليل
Dialogue: 0,0:18:12.44,0:18:13.56,Default,,0000,0000,0000,,مهلك
Dialogue: 0,0:18:17.56,0:18:21.13,Default,,0000,0000,0000,,...انتظر، لسنا مقرّبين لذاك الحدّ بعد
Dialogue: 0,0:18:25.37,0:18:27.01,Default,,0000,0000,0000,,أويهارا-سان؟
Dialogue: 0,0:18:27.01,0:18:29.32,Default,,0000,0000,0000,,كان هو الشخص في الأعلى إذاً؟
Dialogue: 0,0:18:34.83,0:18:36.33,Default,,0000,0000,0000,,ما-ما هذا؟
Dialogue: 0,0:18:40.28,0:18:42.46,Default,,0000,0000,0000,,كان ذاك الرجل يفتّش المكان
Dialogue: 0,0:18:44.36,0:18:45.21,Default,,0000,0000,0000,,!هذه الرائحة
Dialogue: 0,0:18:45.82,0:18:49.52,Default,,0000,0000,0000,,بنزين، رغم أنّ لا سيّارات أو درّاجات نارية هنا
Dialogue: 0,0:18:50.31,0:18:51.12,Default,,0000,0000,0000,,خفيف
Dialogue: 0,0:18:52.60,0:18:54.83,Default,,0000,0000,0000,,كان هامادا-سان من حاول قتل العمّ إذاً؟
Dialogue: 0,0:18:55.60,0:18:57.75,Default,,0000,0000,0000,,!كونان! لا تذهب بمفردك
Dialogue: 0,0:19:03.18,0:19:05.01,Default,,0000,0000,0000,,ماذا كان يفعل هنا؟
Dialogue: 0,0:19:08.37,0:19:09.62,Default,,0000,0000,0000,,منظار؟
Dialogue: 0,0:19:13.50,0:19:16.11,Default,,0000,0000,0000,,انسَ الأمر، لا شيء لتراه
Dialogue: 0,0:19:16.66,0:19:20.37,Default,,0000,0000,0000,,فهو موجّه نحو الجبال، من الممل النظر عبره
Dialogue: 0,0:19:20.70,0:19:24.29,Default,,0000,0000,0000,,غريب، من المُفترض أن يكون منظار\Nالمنارة موجّه نحو البحر
Dialogue: 0,0:19:24.99,0:19:28.16,Default,,0000,0000,0000,,لكن هذا مثبّت نحو الجبال
Dialogue: 0,0:19:30.61,0:19:31.79,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:19:32.36,0:19:33.50,Default,,0000,0000,0000,,ريوجين مارو؟
Dialogue: 0,0:19:34.19,0:19:37.52,Default,,0000,0000,0000,,!لا شكّ في الأمر، لهامادا-سان علاقة بريوجين مارو
Dialogue: 0,0:19:37.52,0:19:40.72,Default,,0000,0000,0000,,وهناك شيء لا يريده أن يُكشف بشأنه
Dialogue: 0,0:19:40.72,0:19:42.60,Default,,0000,0000,0000,,...لذا حاول قتل العمّ
Dialogue: 0,0:19:42.60,0:19:44.75,Default,,0000,0000,0000,,!كلا! العمّ وران
Dialogue: 0,0:19:47.18,0:19:49.41,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:20:00.33,0:20:02.08,Default,,0000,0000,0000,,حلّ الصباح بهذه السرعة؟
Dialogue: 0,0:20:08.98,0:20:10.41,Default,,0000,0000,0000,,!مـ-من أنت؟
Dialogue: 0,0:20:10.98,0:20:12.37,Default,,0000,0000,0000,,...ما الذي
Dialogue: 0,0:20:12.86,0:20:14.58,Default,,0000,0000,0000,,!ران! ابتعدي
Dialogue: 0,0:20:16.32,0:20:18.23,Default,,0000,0000,0000,,!انتظر أيّها الوغد
Dialogue: 0,0:20:18.23,0:20:19.99,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:20:21.18,0:20:22.20,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:20:24.18,0:20:27.96,Default,,0000,0000,0000,,!أيّها الوغد! مكانك
Dialogue: 0,0:20:33.17,0:20:35.41,Default,,0000,0000,0000,,!من الصعب الركض بألم مؤخرتي
Dialogue: 0,0:20:48.37,0:20:50.45,Default,,0000,0000,0000,,!حاصرتك الآن
Dialogue: 0,0:21:04.12,0:21:06.52,Default,,0000,0000,0000,,!أين كنت؟! شعرتُ بقلق شديد
Dialogue: 0,0:21:06.52,0:21:07.58,Default,,0000,0000,0000,,أحصل أمرٌ ما؟
Dialogue: 0,0:21:07.97,0:21:11.03,Default,,0000,0000,0000,,!تعرّض أبي للهجوم من قِبل شبح سويغون
Dialogue: 0,0:21:11.03,0:21:12.22,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:21:15.59,0:21:16.91,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:21:16.91,0:21:18.51,Default,,0000,0000,0000,,جرس تنبيه الميناء
Dialogue: 0,0:21:18.51,0:21:20.41,Default,,0000,0000,0000,,يقومون بطرقه عند وقوع أمرٍ ما
Dialogue: 0,0:21:20.41,0:21:21.62,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:21:21.62,0:21:22.91,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:23.33,0:21:24.45,Default,,0000,0000,0000,,!يا إلهي
Dialogue: 0,0:21:27.04,0:21:28.91,Default,,0000,0000,0000,,!أوقع أمرٌ ما؟
Dialogue: 0,0:21:30.69,0:21:32.36,Default,,0000,0000,0000,,!ساعدوني
Dialogue: 0,0:21:33.40,0:21:35.00,Default,,0000,0000,0000,,!هذا خطأٌ ما
Dialogue: 0,0:21:33.93,0:21:35.00,Default,,0000,0000,0000,,العمّ؟
Dialogue: 0,0:21:35.24,0:21:36.69,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:21:36.69,0:21:38.29,Default,,0000,0000,0000,,!ما الذي يجري؟
Dialogue: 0,0:21:38.53,0:21:42.18,Default,,0000,0000,0000,,قتل ذاك المتحرّي حارس المنارة هامادا
Dialogue: 0,0:21:42.18,0:21:42.70,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:21:43.77,0:21:45.00,Default,,0000,0000,0000,,!أبي؟
Dialogue: 0,0:21:45.00,0:21:47.54,Default,,0000,0000,0000,,!انظروا بأنفسكم إذا ظننتمونا نكذب
Dialogue: 0,0:22:00.62,0:22:04.37,Default,,0000,0000,0000,,عدما وصلنا للمكان كان هذا المتحرّي فاقداً للوعي
Dialogue: 0,0:22:04.37,0:22:05.75,Default,,0000,0000,0000,,والضحيّة بهذه الحالة
Dialogue: 0,0:22:05.75,0:22:08.82,Default,,0000,0000,0000,,!صدّقوني! لم أكن الفاعل
Dialogue: 0,0:22:08.82,0:22:10.15,Default,,0000,0000,0000,,!ستدفع الثمن
Dialogue: 0,0:22:10.15,0:22:13.70,Default,,0000,0000,0000,,غضب سويغون-ساما بسبب عبث\N!دخيل في الأرجاء
Dialogue: 0,0:22:14.45,0:22:17.53,Default,,0000,0000,0000,,لن يُقدم العمّ على شيء كهذا مُطلقاً
Dialogue: 0,0:22:17.53,0:22:20.64,Default,,0000,0000,0000,,...لكن... في هذه الظروف
Dialogue: 0,0:24:05.87,0:24:06.81,Default,,0000,0000,0000,,!كينوشيتا-سان
