Dialogue: 0,0:00:01.50,0:00:04.77,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.77,0:00:07.02,Default,,0000,0000,0000,,!رجل ضمادات مُريب للغاية
Dialogue: 0,0:00:07.02,0:00:09.15,Default,,0000,0000,0000,,!لن أدعه يمسّ ران
Dialogue: 0,0:00:09.15,0:00:11.24,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.24,0:00:13.61,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.61,0:00:15.98,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:46.48,0:01:49.72,Default,,0000,0000,0000,,ذهبتُ مع ران لمنزل سوزوكي سونوكو الجبليّ
Dialogue: 0,0:01:50.38,0:01:52.43,Default,,0000,0000,0000,,لمشاهدة أوراق الخريف
Dialogue: 0,0:01:52.43,0:01:55.79,Default,,0000,0000,0000,,والتقينا هناك أخت سونوكو، طالبة الدراسات العليا أياكو
Dialogue: 0,0:01:55.79,0:02:00.26,Default,,0000,0000,0000,,وصديق أياكو من أيام الدراسة \Nوسمسار السيّارات المستوردة أوتا ماسارو
Dialogue: 0,0:02:00.75,0:02:03.33,Default,,0000,0000,0000,,ومحرّر صحيفة الأفلام سوميا هيروكي
Dialogue: 0,0:02:04.01,0:02:06.55,Default,,0000,0000,0000,,وموظّف شركة الغذاء تاكاهاشي ريويتشي
Dialogue: 0,0:02:07.29,0:02:10.47,Default,,0000,0000,0000,,وكاتبة السيناريو إيكيدا تشيكاكو، كان مجموعنا 8 أشخاص
Dialogue: 0,0:02:10.75,0:02:14.29,Default,,0000,0000,0000,,بدأت الحوادث بمحاولة رجل مُريب ملفوف بالضماد
Dialogue: 0,0:02:14.29,0:02:16.78,Default,,0000,0000,0000,,قتل ران التائهة في الغابة
Dialogue: 0,0:02:18.36,0:02:22.55,Default,,0000,0000,0000,,،وفي تلك الليلة، بعدما قُطع الجسر الوحيد
Dialogue: 0,0:02:22.85,0:02:26.19,Default,,0000,0000,0000,,أخذ رجل الضماد إيكيدا تشيكاكو وقتلها
Dialogue: 0,0:02:26.88,0:02:31.10,Default,,0000,0000,0000,,ثمّ حاول قتل ران مُجدداً
Dialogue: 0,0:02:35.80,0:02:40.68,Default,,0000,0000,0000,,!لمَ؟ لمَ يستهدف رجل الضماد ران؟
Dialogue: 0,0:02:45.83,0:02:50.50,Default,,0000,0000,0000,,جريمة قتل رجل ضماد السكن الجبلي \N(الجزء الثاني)
Dialogue: 0,0:02:51.71,0:02:53.17,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:02:53.17,0:02:54.96,Default,,0000,0000,0000,,!هاجمها مُجدداً؟
Dialogue: 0,0:02:54.96,0:02:56.71,Default,,0000,0000,0000,,!رجل الضماد؟
Dialogue: 0,0:02:56.99,0:02:58.78,Default,,0000,0000,0000,,يبدو ذلك
Dialogue: 0,0:02:58.78,0:02:59.83,Default,,0000,0000,0000,,أأنت بخير؟
Dialogue: 0,0:02:59.83,0:03:00.78,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:00.78,0:03:02.22,Default,,0000,0000,0000,,لكن كيف دخل؟
Dialogue: 0,0:03:02.66,0:03:04.48,Default,,0000,0000,0000,,ألم تقفلي النافذة؟
Dialogue: 0,0:03:04.48,0:03:05.13,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:03:05.13,0:03:05.62,Default,,0000,0000,0000,,انظروا
Dialogue: 0,0:03:05.62,0:03:06.06,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:06.06,0:03:07.59,Default,,0000,0000,0000,,قُطِع زجاج النافذة
Dialogue: 0,0:03:07.59,0:03:08.69,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:03:08.69,0:03:10.55,Default,,0000,0000,0000,,!أدخل يده وفتح القفل
Dialogue: 0,0:03:11.10,0:03:15.22,Default,,0000,0000,0000,,لكنّنا في الطابق الثاني، كيف صعد هنا؟
Dialogue: 0,0:03:15.22,0:03:16.00,Default,,0000,0000,0000,,!أوتا! تلك
Dialogue: 0,0:03:17.22,0:03:19.97,Default,,0000,0000,0000,,لا بدّ أنّه استعمل الشجرة وتسلّق للشرفة
Dialogue: 0,0:03:20.22,0:03:22.07,Default,,0000,0000,0000,,يا للوغد
Dialogue: 0,0:03:22.07,0:03:23.00,Default,,0000,0000,0000,,...ثمّ
Dialogue: 0,0:03:23.00,0:03:25.96,Default,,0000,0000,0000,,غريب، المطر يهطل بغزارة خارجاً
Dialogue: 0,0:03:26.29,0:03:28.50,Default,,0000,0000,0000,,،إن تسلّل من الخارج
Dialogue: 0,0:03:28.50,0:03:30.63,Default,,0000,0000,0000,,فيُفترض أنّ تكون هناك آثار وحل في الداخل
Dialogue: 0,0:03:30.63,0:03:32.38,Default,,0000,0000,0000,,لكن لا شيء منها أبداً
Dialogue: 0,0:03:33.87,0:03:34.85,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:03:37.07,0:03:38.80,Default,,0000,0000,0000,,بأيّ حال، من الخطر أن نتفرّق
Dialogue: 0,0:03:39.28,0:03:41.66,Default,,0000,0000,0000,,لنجتمع في غرفة الطعام ونبقى للصباح
Dialogue: 0,0:03:41.66,0:03:42.76,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:03:44.11,0:03:47.11,Default,,0000,0000,0000,,!أكره صعود الظهر! هذا سخيف
Dialogue: 0,0:03:47.11,0:03:50.94,Default,,0000,0000,0000,,!ما الذي تقوله؟ لويتَ كاحلك
Dialogue: 0,0:03:50.94,0:03:53.14,Default,,0000,0000,0000,,...أياكو-سان، أليس هذا
Dialogue: 0,0:03:53.14,0:03:55.26,Default,,0000,0000,0000,,ما كانت تضعه تشيكاكو-سان على عنقها؟
Dialogue: 0,0:03:55.93,0:03:58.42,Default,,0000,0000,0000,,صحيح، إنّه شريط عنقها
Dialogue: 0,0:03:58.76,0:04:03.92,Default,,0000,0000,0000,,،بعدما لاحقتم جميعاً رجل الضماد
Dialogue: 0,0:04:03.92,0:04:06.38,Default,,0000,0000,0000,,وجدتُه عند الباب الأمامي
Dialogue: 0,0:04:11.71,0:04:14.28,Default,,0000,0000,0000,,!ما الذي يفكّر به رجل الضماد ذاك؟
Dialogue: 0,0:04:14.28,0:04:17.25,Default,,0000,0000,0000,,!هاجم ران-تشان مرّتين فوق قتل تشيكاكو؟
Dialogue: 0,0:04:17.25,0:04:20.09,Default,,0000,0000,0000,,ماذا لو كان يريد قتلنا جميعاً؟
Dialogue: 0,0:04:20.09,0:04:21.44,Default,,0000,0000,0000,,...مستحيل
Dialogue: 0,0:04:21.44,0:04:22.50,Default,,0000,0000,0000,,...لا يُعقل
Dialogue: 0,0:04:24.36,0:04:25.50,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:04:25.94,0:04:30.09,Default,,0000,0000,0000,,حمل تشيكاكو-سان للغابة معه بعدها
Dialogue: 0,0:04:30.57,0:04:33.60,Default,,0000,0000,0000,,لذا لو سرق شريط عنقها فيُفترض أن يكون هناك
Dialogue: 0,0:04:33.60,0:04:36.04,Default,,0000,0000,0000,,فلمَ كان عند الباب الأمامي؟
Dialogue: 0,0:04:36.43,0:04:41.35,Default,,0000,0000,0000,,لمَ لم تستعملي الكاراتيه وتبرحيه ضرباً عندما هاجمك؟
Dialogue: 0,0:04:41.35,0:04:42.92,Default,,0000,0000,0000,,!ليس من طباعك يا ران
Dialogue: 0,0:04:42.92,0:04:47.00,Default,,0000,0000,0000,,ليس بيدي حيلة، فأنا أخاف الأشباح والوحوش وما شابه
Dialogue: 0,0:04:49.00,0:04:51.72,Default,,0000,0000,0000,,لا حاجة للقلق
Dialogue: 0,0:04:52.34,0:04:55.58,Default,,0000,0000,0000,,نحن ستّة، وهو بمفرده
Dialogue: 0,0:04:55.58,0:04:58.13,Default,,0000,0000,0000,,...لن يكون قادراً على هزيمة
Dialogue: 0,0:04:59.79,0:05:00.84,Default,,0000,0000,0000,,أوتا-سان؟
Dialogue: 0,0:05:01.75,0:05:03.23,Default,,0000,0000,0000,,!تألمتُ أيضاً
Dialogue: 0,0:05:03.23,0:05:04.25,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:05:04.25,0:05:05.67,Default,,0000,0000,0000,,!ما الذي تفعله يا صبيّ؟
Dialogue: 0,0:05:06.03,0:05:08.13,Default,,0000,0000,0000,,!نحن سبعة ولسنا ستّة
Dialogue: 0,0:05:08.53,0:05:11.36,Default,,0000,0000,0000,,!لا يدخل الأطفال الحساب
Dialogue: 0,0:05:11.36,0:05:13.35,Default,,0000,0000,0000,,ليس صحيحاً
Dialogue: 0,0:05:14.35,0:05:17.64,Default,,0000,0000,0000,,فقد حماني عندما تعرّضتُ للهجوم
Dialogue: 0,0:05:17.64,0:05:18.55,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:05:21.10,0:05:22.05,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:05:23.67,0:05:27.80,Default,,0000,0000,0000,,ران، هل نظرتِ لوجه رجل الضماد عن قرب؟
Dialogue: 0,0:05:27.80,0:05:28.51,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:05:28.51,0:05:30.55,Default,,0000,0000,0000,,لكنّي أعرف بُنيته
Dialogue: 0,0:05:31.17,0:05:34.04,Default,,0000,0000,0000,,لم أتمكن من رؤية وجهه بوضوح\Nبما أنّه كان ملفوفاً بالضماد
Dialogue: 0,0:05:34.04,0:05:37.63,Default,,0000,0000,0000,,لكنّي أعرف بُنيته لأنّي تمسّكتُ به
Dialogue: 0,0:05:41.45,0:05:44.08,Default,,0000,0000,0000,,كان صدره بهذا الحجم تقريباً
Dialogue: 0,0:05:44.36,0:05:48.15,Default,,0000,0000,0000,,فلم يكن بديناً أو نحيلاً بالتحديد
Dialogue: 0,0:05:49.01,0:05:51.53,Default,,0000,0000,0000,,كأنّ بإمكاننا تصديق كلام طفل
Dialogue: 0,0:05:56.02,0:05:57.88,Default,,0000,0000,0000,,كاميرا تصوير سوميا-سان
Dialogue: 0,0:05:59.51,0:06:02.31,Default,,0000,0000,0000,,وفقما أذكر، كان رجل الضماد يصوّر عندما
Dialogue: 0,0:06:02.31,0:06:03.99,Default,,0000,0000,0000,,هرب ومعه تشيكاكو-سان
Dialogue: 0,0:06:07.38,0:06:08.55,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:06:09.34,0:06:13.13,Default,,0000,0000,0000,,كما ظننت، إنّها ترتدي شريط العنق
Dialogue: 0,0:06:13.58,0:06:16.50,Default,,0000,0000,0000,,ما يعني أنّ جثّتها التي كان يمسكها رجل الضماد
Dialogue: 0,0:06:16.50,0:06:19.42,Default,,0000,0000,0000,,عندما مرّ بالنافذة
Dialogue: 0,0:06:20.12,0:06:23.42,Default,,0000,0000,0000,,عبرت داخل السكن لسببٍ ما
Dialogue: 0,0:06:24.24,0:06:27.32,Default,,0000,0000,0000,,كان بإمكان أحدٍ داخل السكن حملها
Dialogue: 0,0:06:27.32,0:06:30.38,Default,,0000,0000,0000,,من البيت للغابة
Dialogue: 0,0:06:30.82,0:06:36.04,Default,,0000,0000,0000,,!لكن كان الجميع في هذه الغرفة عندما أُخذت
Dialogue: 0,0:06:41.44,0:06:43.13,Default,,0000,0000,0000,,هل أعدّ قهوة؟
Dialogue: 0,0:06:43.13,0:06:44.38,Default,,0000,0000,0000,,فكرة حسنة
Dialogue: 0,0:06:44.38,0:06:49.42,Default,,0000,0000,0000,,أخبريني، كنتِ آخر من رأى\N تشيكاكو-سان، صحيح يا أياكو-سان؟
Dialogue: 0,0:06:49.93,0:06:50.68,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:50.68,0:06:53.85,Default,,0000,0000,0000,,هل بدا عليها أمرٌ غريب وقتها؟
Dialogue: 0,0:06:55.50,0:06:57.67,Default,,0000,0000,0000,,...بذكرك ذلك
Dialogue: 0,0:06:57.67,0:07:00.72,Default,,0000,0000,0000,,قرأتْ رسالةً كانت تحت باب غرفتها
Dialogue: 0,0:07:01.54,0:07:04.33,Default,,0000,0000,0000,,شحب لون وجهها فجأةً
Dialogue: 0,0:07:04.99,0:07:09.30,Default,,0000,0000,0000,,!فهمت، استدرجتها الرسالة للخارج
Dialogue: 0,0:07:09.74,0:07:11.93,Default,,0000,0000,0000,,لهذا السّبب كان خُفّاها عند الباب الخلفي
Dialogue: 0,0:07:11.93,0:07:14.56,Default,,0000,0000,0000,,حيث يمكنها التسلل دون أن يراها أحد
Dialogue: 0,0:07:14.56,0:07:19.77,Default,,0000,0000,0000,,والوحيد الذي كان بمقدوره وضع الرسالة هناك\Nهو أحد المقيمين هنا
Dialogue: 0,0:07:19.77,0:07:23.63,Default,,0000,0000,0000,,!أكان قاتلها بيننا حقاً؟
Dialogue: 0,0:07:24.05,0:07:27.34,Default,,0000,0000,0000,,لكن لمَ حاول قتل ران مرّتين؟
Dialogue: 0,0:07:28.76,0:07:32.09,Default,,0000,0000,0000,,لا أعرف دافع قتله لتشيكاكو-سان
Dialogue: 0,0:07:32.09,0:07:36.13,Default,,0000,0000,0000,,لكن لمَ هاجم ران التي شاركت في آخر لحظة؟
Dialogue: 0,0:07:37.51,0:07:39.59,Default,,0000,0000,0000,,...لحظة! ماذا لو وقتها
Dialogue: 0,0:07:42.25,0:07:45.17,Default,,0000,0000,0000,,!آسفة! أخطأت
Dialogue: 0,0:07:45.70,0:07:47.28,Default,,0000,0000,0000,,أخبريني يا ران-نيتشان
Dialogue: 0,0:07:47.28,0:07:48.02,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:48.02,0:07:49.66,Default,,0000,0000,0000,,،عندما وصلنا هنا
Dialogue: 0,0:07:49.66,0:07:52.13,Default,,0000,0000,0000,,فتحتِ أبواب غرف الجميع بالخطأ، صحيح؟
Dialogue: 0,0:07:52.13,0:07:53.16,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:53.16,0:07:54.69,Default,,0000,0000,0000,,ألم تري شيئاً وقتها؟
Dialogue: 0,0:07:54.69,0:07:56.07,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:07:56.07,0:07:57.94,Default,,0000,0000,0000,,مثل معطف أو ضماد؟
Dialogue: 0,0:07:57.94,0:08:00.59,Default,,0000,0000,0000,,ما الذي يقوله هذا الطفل؟ أتشكّ بنا؟
Dialogue: 0,0:08:00.59,0:08:05.01,Default,,0000,0000,0000,,!لا-لا تهتموا له رجاءً! إنّه يحب لعب لعبة التحرّي
Dialogue: 0,0:08:05.01,0:08:07.20,Default,,0000,0000,0000,,لم تري شيئاً حقاً؟
Dialogue: 0,0:08:07.20,0:08:08.55,Default,,0000,0000,0000,,!بالطبع لا
Dialogue: 0,0:08:08.55,0:08:11.01,Default,,0000,0000,0000,,كانوا يغيّرون ملابسهم فأغلقت الباب فوراً
Dialogue: 0,0:08:11.01,0:08:15.34,Default,,0000,0000,0000,,...إن أعدتُ التفكير، هناك ما حيّر بالي
Dialogue: 0,0:08:15.34,0:08:17.96,Default,,0000,0000,0000,,مُذ ذاك الوقت
Dialogue: 0,0:08:18.79,0:08:21.63,Default,,0000,0000,0000,,لا أظنّه مُهماً جدّاً
Dialogue: 0,0:08:22.00,0:08:23.71,Default,,0000,0000,0000,,لكن لا أستطيع تذكره
Dialogue: 0,0:08:23.71,0:08:25.46,Default,,0000,0000,0000,,!تذكّري يا ران-نيتشان
Dialogue: 0,0:08:28.33,0:08:29.33,Default,,0000,0000,0000,,!انقطعت الكهرباء
Dialogue: 0,0:08:29.33,0:08:31.67,Default,,0000,0000,0000,,!أسقطت الصاعقة للتوّ برج طاقة
Dialogue: 0,0:08:31.99,0:08:33.57,Default,,0000,0000,0000,,!أشعر بالخوف
Dialogue: 0,0:08:33.57,0:08:35.63,Default,,0000,0000,0000,,سأجلب أعواد شمع من المطبخ
Dialogue: 0,0:08:36.19,0:08:38.19,Default,,0000,0000,0000,,أستكونين بخيرٍ بمفردك؟
Dialogue: 0,0:08:38.19,0:08:39.41,Default,,0000,0000,0000,,!سأرافقك
Dialogue: 0,0:08:39.41,0:08:39.96,Default,,0000,0000,0000,,!وأنا
Dialogue: 0,0:08:43.06,0:08:45.18,Default,,0000,0000,0000,,يُفترض أن تحلّ المشكلة لبرهة
Dialogue: 0,0:08:48.72,0:08:50.22,Default,,0000,0000,0000,,ما كان ذلك الصوت؟
Dialogue: 0,0:08:50.22,0:08:52.18,Default,,0000,0000,0000,,أتى من غرفة الطعام حيث الجميع
Dialogue: 0,0:08:52.18,0:08:54.71,Default,,0000,0000,0000,,!أيمكن أنّه رجل الضماد مُجدداً؟
Dialogue: 0,0:09:02.58,0:09:03.79,Default,,0000,0000,0000,,!أأنت بخيرٍ يا كونان-كن؟
Dialogue: 0,0:09:03.79,0:09:05.45,Default,,0000,0000,0000,,!كان ذلك قاسياً يا ران-نيتشان
Dialogue: 0,0:09:05.45,0:09:06.45,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:09:06.45,0:09:07.62,Default,,0000,0000,0000,,...ذاك
Dialogue: 0,0:09:10.08,0:09:12.13,Default,,0000,0000,0000,,لحظة، أليس فأساً؟
Dialogue: 0,0:09:12.13,0:09:14.08,Default,,0000,0000,0000,,...الشخص الذي كان هنا إذاً
Dialogue: 0,0:09:14.57,0:09:17.17,Default,,0000,0000,0000,,!رجل الضماد يلاحق ران فعلاً
Dialogue: 0,0:09:18.44,0:09:20.15,Default,,0000,0000,0000,,!لكن لمَ هي؟
Dialogue: 0,0:09:22.93,0:09:24.54,Default,,0000,0000,0000,,!كان ذلك صوت سونوكو
Dialogue: 0,0:09:24.54,0:09:26.38,Default,,0000,0000,0000,,!ران-نيتشان! لنسرع
Dialogue: 0,0:09:26.62,0:09:27.35,Default,,0000,0000,0000,,!بسرعة! بسرعة
Dialogue: 0,0:09:29.89,0:09:32.13,Default,,0000,0000,0000,,!النافذة العلوية مكسورة
Dialogue: 0,0:09:32.13,0:09:34.42,Default,,0000,0000,0000,,!ران-نيتشان، اذهبي للنافذة
Dialogue: 0,0:09:34.42,0:09:36.96,Default,,0000,0000,0000,,أياكو-سان، هلّا حملتِ هذه؟
Dialogue: 0,0:09:39.13,0:09:40.96,Default,,0000,0000,0000,,يا للفوضى
Dialogue: 0,0:09:40.96,0:09:43.50,Default,,0000,0000,0000,,الأرض مليئة بكسور الزجاج
Dialogue: 0,0:09:43.50,0:09:47.88,Default,,0000,0000,0000,,لا بدّ أنّ رجل الضماد دخل من هذه النافذة
Dialogue: 0,0:09:48.34,0:09:49.63,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:09:50.16,0:09:52.58,Default,,0000,0000,0000,,أحد القفلين مفتوح
Dialogue: 0,0:09:53.09,0:09:53.96,Default,,0000,0000,0000,,...لو
Dialogue: 0,0:09:54.75,0:10:00.35,Default,,0000,0000,0000,,لو حطّم زجاج النافذة من الخارج حقاً... ودخل
Dialogue: 0,0:10:01.88,0:10:04.29,Default,,0000,0000,0000,,فيُفترض أن تبقى الأقفال
Dialogue: 0,0:10:04.77,0:10:06.75,Default,,0000,0000,0000,,لكنّها ليست كذلك
Dialogue: 0,0:10:06.75,0:10:09.85,Default,,0000,0000,0000,,ما يعني أنّه فتحها من الداخل غالباً
Dialogue: 0,0:10:09.85,0:10:11.97,Default,,0000,0000,0000,,وخرج للشرفة وأغلق النافذة
Dialogue: 0,0:10:12.18,0:10:16.42,Default,,0000,0000,0000,,!ثمّ حطّم الزجاج ليخدعنا أنّه دخل من الخارج
Dialogue: 0,0:10:18.30,0:10:20.47,Default,,0000,0000,0000,,تسلّل من الطابق الثاني مُجدداً؟
Dialogue: 0,0:10:20.47,0:10:24.54,Default,,0000,0000,0000,,أجل، أتى للشرفة عبر تلك الشجرة مُجدداً على الأرجح
Dialogue: 0,0:10:24.54,0:10:26.12,Default,,0000,0000,0000,,لا شكّ
Dialogue: 0,0:10:26.12,0:10:27.79,Default,,0000,0000,0000,,المجرم المجنون الذي قتل تشيكاكو-سان
Dialogue: 0,0:10:27.79,0:10:30.51,Default,,0000,0000,0000,,!وهاجم ران ثلاث مرّات موجودٌ بيننا
Dialogue: 0,0:10:34.70,0:10:36.02,Default,,0000,0000,0000,,ما هذه الخطوط؟
Dialogue: 0,0:10:37.70,0:10:40.28,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:10:40.28,0:10:42.50,Default,,0000,0000,0000,,!كانت حيلة
Dialogue: 0,0:10:45.19,0:10:46.59,Default,,0000,0000,0000,,شكراً لك يا ران-نيتشان
Dialogue: 0,0:10:47.48,0:10:50.90,Default,,0000,0000,0000,,لكن لمَ رجل الضماد مصرٌّ على قتل ران؟
Dialogue: 0,0:10:52.06,0:10:54.48,Default,,0000,0000,0000,,ما الذي رأته بالضبط؟
Dialogue: 0,0:10:55.75,0:10:57.22,Default,,0000,0000,0000,,!بالطبع لا
Dialogue: 0,0:10:57.22,0:10:59.59,Default,,0000,0000,0000,,كانوا يغيّرون ملابسهم فأغلقت الباب فوراً
Dialogue: 0,0:11:00.72,0:11:02.33,Default,,0000,0000,0000,,...ماذا لو كان
Dialogue: 0,0:11:03.12,0:11:06.92,Default,,0000,0000,0000,,!رجل الضماد... هو إذاً
Dialogue: 0,0:11:06.92,0:11:08.30,Default,,0000,0000,0000,,...عندها، الألغاز الثلاثة
Dialogue: 0,0:11:08.30,0:11:11.29,Default,,0000,0000,0000,,سبب مرور رجل الضماد بالنافذة مع تشيكاكو-سان
Dialogue: 0,0:11:11.29,0:11:13.21,Default,,0000,0000,0000,,...كي نراه جميعاً
Dialogue: 0,0:11:14.03,0:11:17.05,Default,,0000,0000,0000,,...وحمله الجثّة للغابة دون أن يلاحظه أحد
Dialogue: 0,0:11:17.49,0:11:19.26,Default,,0000,0000,0000,,...وسبب مهاجمته لران
Dialogue: 0,0:11:19.78,0:11:21.61,Default,,0000,0000,0000,,!توضّحت الصُّورة
Dialogue: 0,0:11:21.61,0:11:22.22,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:11:22.81,0:11:24.63,Default,,0000,0000,0000,,!لا لديّ سوى ران لتؤدي دور المتحرّي
Dialogue: 0,0:11:25.56,0:11:27.92,Default,,0000,0000,0000,,المعذرة، أين أعواد الشمع التي أعطيتك يا أياكو-سان؟
Dialogue: 0,0:11:31.10,0:11:32.26,Default,,0000,0000,0000,,!أخطأت التصويب
Dialogue: 0,0:11:36.97,0:11:38.80,Default,,0000,0000,0000,,سونوكو؟
Dialogue: 0,0:11:38.80,0:11:40.22,Default,,0000,0000,0000,,!ما الخطب يا سونوكو؟
Dialogue: 0,0:11:40.22,0:11:44.13,Default,,0000,0000,0000,,!تبّاً! لا أمامي سوى استعمال سونوكو الآن
Dialogue: 0,0:11:44.13,0:11:45.58,Default,,0000,0000,0000,,!سونوكو
Dialogue: 0,0:11:45.58,0:11:49.05,Default,,0000,0000,0000,,...لـ-لقد اكتشفت
Dialogue: 0,0:11:49.46,0:11:52.62,Default,,0000,0000,0000,,!هويّة المجرم الذي قتل تشيكاكو-سان
Dialogue: 0,0:11:59.91,0:12:02.27,Default,,0000,0000,0000,,لقد اكتشفت
Dialogue: 0,0:12:02.27,0:12:05.13,Default,,0000,0000,0000,,!هويّة المجرم الذي قتل تشيكاكو-سان
Dialogue: 0,0:12:05.13,0:12:08.23,Default,,0000,0000,0000,,ما الذي تقولينه يا سونوكو-تشان؟
Dialogue: 0,0:12:08.23,0:12:11.36,Default,,0000,0000,0000,,المجرم رجل الضماد بالطبع
Dialogue: 0,0:12:11.36,0:12:13.89,Default,,0000,0000,0000,,صحيح، إنّه في الغابة الآن غالباً
Dialogue: 0,0:12:13.89,0:12:16.10,Default,,0000,0000,0000,,يخطّط للنيل منّا
Dialogue: 0,0:12:16.10,0:12:19.35,Default,,0000,0000,0000,,أتظنّون أنّ شخصاً مثله في الغابة حقاً؟
Dialogue: 0,0:12:20.35,0:12:26.38,Default,,0000,0000,0000,,أعيدوا التفكير بحالة غرفة ران عندما تعرّضت للهجوم
Dialogue: 0,0:12:26.38,0:12:29.97,Default,,0000,0000,0000,,دخل من الشرفة، صحيح؟
Dialogue: 0,0:12:30.13,0:12:34.42,Default,,0000,0000,0000,,أجل، صعد لشرفة الطابق الثاني عبر الشجرة
Dialogue: 0,0:12:34.74,0:12:38.38,Default,,0000,0000,0000,,لمَ لم تكن هناك آثار وحل في غرفة ران؟
Dialogue: 0,0:12:38.76,0:12:42.86,Default,,0000,0000,0000,,كان المطر يهطل عندما تسلّل رجل الضماد
Dialogue: 0,0:12:42.86,0:12:44.90,Default,,0000,0000,0000,,!صـ-صحيح
Dialogue: 0,0:12:44.90,0:12:46.34,Default,,0000,0000,0000,,السبب بسيط
Dialogue: 0,0:12:46.73,0:12:50.30,Default,,0000,0000,0000,,لأنّ رجل الضماد كان داخل السكن
Dialogue: 0,0:12:50.30,0:12:55.51,Default,,0000,0000,0000,,نقطة الدخول كانت غرفة تشيكاكو-سان\Nبجوار غرفة ران على الأرجح
Dialogue: 0,0:12:55.51,0:12:59.43,Default,,0000,0000,0000,,خرج القاتل للشرفة منها\Nودخل غرفة ران ثمّ هاجمها
Dialogue: 0,0:12:59.43,0:13:02.21,Default,,0000,0000,0000,,...لكنّ ران صرخت
Dialogue: 0,0:13:04.84,0:13:08.21,Default,,0000,0000,0000,,فهرب بعجلة لغرفة تشيكاكو-سان
Dialogue: 0,0:13:08.21,0:13:11.97,Default,,0000,0000,0000,,وغيّر ثيابه هناك بمنتهى السرعة
Dialogue: 0,0:13:12.70,0:13:17.62,Default,,0000,0000,0000,,والتمّ بالجميع في غرفة ران بقناع الجهل على وجهه
Dialogue: 0,0:13:17.62,0:13:22.33,Default,,0000,0000,0000,,أي أنّ القاتل المجنون الذي قتل تشيكاكو-سان وهاجم ران
Dialogue: 0,0:13:22.69,0:13:24.51,Default,,0000,0000,0000,,!هو بيننا
Dialogue: 0,0:13:25.82,0:13:28.73,Default,,0000,0000,0000,,سونوكو-تشان، لا بأس من لعب لعبة المتحرّي
Dialogue: 0,0:13:28.73,0:13:30.53,Default,,0000,0000,0000,,لكن أمعني التفكير
Dialogue: 0,0:13:30.53,0:13:33.21,Default,,0000,0000,0000,,،عندما مرّ رجل الضماد بالنافذة
Dialogue: 0,0:13:33.68,0:13:36.85,Default,,0000,0000,0000,,كنّا جميعاً داخل السكن
Dialogue: 0,0:13:38.72,0:13:42.42,Default,,0000,0000,0000,,يستحيل أن يكون أحدنا
Dialogue: 0,0:13:42.42,0:13:46.26,Default,,0000,0000,0000,,،لكن لو استعمل دميةً وأسلاك بيانو
Dialogue: 0,0:13:46.26,0:13:49.38,Default,,0000,0000,0000,,يمكنه خداع أنظارنا من الداخل
Dialogue: 0,0:13:49.63,0:13:50.84,Default,,0000,0000,0000,,د-دمية؟
Dialogue: 0,0:13:50.84,0:13:55.25,Default,,0000,0000,0000,,أجل، دمية قابلة للنفخ على الأرجح
Dialogue: 0,0:13:55.66,0:13:59.16,Default,,0000,0000,0000,,،ثبّت جثّة تشيكاكو-سان بالدمية
Dialogue: 0,0:13:59.16,0:14:02.75,Default,,0000,0000,0000,,وربط سلكي بيانو برأس الدمية
Dialogue: 0,0:14:03.11,0:14:07.82,Default,,0000,0000,0000,,مرّر أحد السلكين بحاجز الشرفة الوسطى
Dialogue: 0,0:14:07.82,0:14:13.14,Default,,0000,0000,0000,,وربط طرفَي السلكين بالحاجز فوق النافذة
Dialogue: 0,0:14:13.14,0:14:16.52,Default,,0000,0000,0000,,ثمّ قطع السلك الذي كان مربوطاً بالحاجز
Dialogue: 0,0:14:20.18,0:14:22.92,Default,,0000,0000,0000,,،وبعدما لوّح بهما أمام النافذة
Dialogue: 0,0:14:22.92,0:14:26.88,Default,,0000,0000,0000,,استرجع الدمية وتشيكاكو-سان سريعاً
Dialogue: 0,0:14:27.26,0:14:28.47,Default,,0000,0000,0000,,!تشيكاكو
Dialogue: 0,0:14:29.47,0:14:32.12,Default,,0000,0000,0000,,الوحيد القادر على ذلك
Dialogue: 0,0:14:32.12,0:14:35.09,Default,,0000,0000,0000,,كان الشخص على الشرفة الذي يصلح السقف وقتها
Dialogue: 0,0:14:35.46,0:14:38.00,Default,,0000,0000,0000,,!تاكاهاشي-سان! لا أحد غيرك
Dialogue: 0,0:14:40.21,0:14:42.05,Default,,0000,0000,0000,,أنتِ تمزحين يا سونوكو-تشان
Dialogue: 0,0:14:42.05,0:14:46.96,Default,,0000,0000,0000,,...آثار سلكَي البيانو الواضحة على حاجز الشرفة
Dialogue: 0,0:14:47.36,0:14:48.92,Default,,0000,0000,0000,,!هي الدليل
Dialogue: 0,0:14:49.20,0:14:51.61,Default,,0000,0000,0000,,وحده مدير مسرح نادي إنتاج الأفلام
Dialogue: 0,0:14:51.61,0:14:56.06,Default,,0000,0000,0000,,بإمكانه تجهيز شيء بهذه التفاصيل
Dialogue: 0,0:14:57.14,0:14:59.48,Default,,0000,0000,0000,,...عـ-على مهلك
Dialogue: 0,0:14:59.48,0:15:02.87,Default,,0000,0000,0000,,ماذا فعلتُ بالجثّة بعدما سحبتها إذاً؟
Dialogue: 0,0:15:04.38,0:15:08.26,Default,,0000,0000,0000,,بعد ذلك مباشرة، لحقنا به جميعاً إلى الغابة
Dialogue: 0,0:15:08.59,0:15:11.30,Default,,0000,0000,0000,,حيث وجدنا أجزاء جثّة تشيكاكو
Dialogue: 0,0:15:13.00,0:15:16.35,Default,,0000,0000,0000,,لم تروني أحمل جثّة وقتها، صحيح؟
Dialogue: 0,0:15:16.35,0:15:17.08,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:15:17.08,0:15:19.55,Default,,0000,0000,0000,,هناك دليل لحملك لها
Dialogue: 0,0:15:20.97,0:15:24.38,Default,,0000,0000,0000,,فقد وجدت أختي شريط عنق تشيكاكو-سان عند المدخل
Dialogue: 0,0:15:24.95,0:15:28.34,Default,,0000,0000,0000,,كانت ترتدي الشريط عندما اُختُطِفت
Dialogue: 0,0:15:28.61,0:15:32.25,Default,,0000,0000,0000,,وجوده عند المدخل بعد مغادرة الجميع
Dialogue: 0,0:15:32.25,0:15:37.21,Default,,0000,0000,0000,,دليلٌ على أنّ أحدهم عبر الباب وهو يحمل جثّتها
Dialogue: 0,0:15:37.60,0:15:41.44,Default,,0000,0000,0000,,!أخبرتك، لم أكن أحمل شيئاً
Dialogue: 0,0:15:41.44,0:15:45.92,Default,,0000,0000,0000,,كما، كيف يمكن لأحد حمل جثّة دون أن يلاحظه أحد؟
Dialogue: 0,0:15:45.92,0:15:47.84,Default,,0000,0000,0000,,بافتراض أنّها جثّة كاملة
Dialogue: 0,0:15:47.84,0:15:50.22,Default,,0000,0000,0000,,...لكن لو كان الرأس فقط
Dialogue: 0,0:15:50.93,0:15:52.83,Default,,0000,0000,0000,,!فيمكن حمله
Dialogue: 0,0:15:52.83,0:15:54.17,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:54.17,0:15:57.88,Default,,0000,0000,0000,,فما رأيناه من النافذة
Dialogue: 0,0:15:57.88,0:16:00.67,Default,,0000,0000,0000,,!كان رأسها والمعطف يغطيها
Dialogue: 0,0:16:00.67,0:16:04.71,Default,,0000,0000,0000,,كانت جثّتها متراميةً عندما وجدناها
Dialogue: 0,0:16:05.74,0:16:06.42,Default,,0000,0000,0000,,!سخافة
Dialogue: 0,0:16:06.87,0:16:11.53,Default,,0000,0000,0000,,!لمَ قد أقتل تشيكاكو؟! كما أهاجم ران-تشان؟
Dialogue: 0,0:16:11.53,0:16:15.34,Default,,0000,0000,0000,,...أ-أيضاً... أيضاً
Dialogue: 0,0:16:15.73,0:16:16.92,Default,,0000,0000,0000,,أيضاً؟
Dialogue: 0,0:16:18.77,0:16:20.30,Default,,0000,0000,0000,,لمَ لا تقولها؟
Dialogue: 0,0:16:21.48,0:16:23.71,Default,,0000,0000,0000,,أليس هناك دليل؟
Dialogue: 0,0:16:23.89,0:16:28.67,Default,,0000,0000,0000,,تمتلك ورجل الضماد بُنيتين مختلفتين تماماً
Dialogue: 0,0:16:30.80,0:16:32.21,Default,,0000,0000,0000,,!صحيح يا تاكاهاشي-كن
Dialogue: 0,0:16:32.21,0:16:34.54,Default,,0000,0000,0000,,!رجل الضماد ليس بديناً
Dialogue: 0,0:16:34.54,0:16:36.96,Default,,0000,0000,0000,,تاكاهاشي، لمَ لم تقل ذلك؟
Dialogue: 0,0:16:37.29,0:16:42.33,Default,,0000,0000,0000,,كان يخشى ما سأسأله ردّاً على كلامه
Dialogue: 0,0:16:42.33,0:16:45.84,Default,,0000,0000,0000,,"أأنت بدينٌ حقاً؟"
Dialogue: 0,0:16:47.99,0:16:50.76,Default,,0000,0000,0000,,صحيح، ليس بديناً البتّة
Dialogue: 0,0:16:51.20,0:16:54.71,Default,,0000,0000,0000,,...لذا كان بإمكانه وضع الرأس داخل قميصه وحمله
Dialogue: 0,0:16:54.71,0:16:58.96,Default,,0000,0000,0000,,استدرج تشيكاكو-سان للغابة أوّلاً وقطّع جسدها
Dialogue: 0,0:16:59.36,0:17:02.93,Default,,0000,0000,0000,,واستبدل البطانة تحت قميصه برأسها
Dialogue: 0,0:17:02.93,0:17:04.97,Default,,0000,0000,0000,,وأخذها للسكن
Dialogue: 0,0:17:04.97,0:17:08.47,Default,,0000,0000,0000,,بعدها، بعد تنفيذ حيلة الشرفة
Dialogue: 0,0:17:08.47,0:17:11.93,Default,,0000,0000,0000,,أعاد الدمية مفرغة الهواء والرأس تحت قميصه
Dialogue: 0,0:17:11.93,0:17:14.63,Default,,0000,0000,0000,,وتوجّه للغابة مع الجميع
Dialogue: 0,0:17:14.63,0:17:16.84,Default,,0000,0000,0000,,ثمّ رمى رأسها في الغابة
Dialogue: 0,0:17:16.84,0:17:18.96,Default,,0000,0000,0000,,مُتظاهراً بالبحث عنها
Dialogue: 0,0:17:19.46,0:17:23.74,Default,,0000,0000,0000,,أي أنّه زيّف بُنيته ليخدع الجميع
Dialogue: 0,0:17:23.74,0:17:30.30,Default,,0000,0000,0000,,!وينقل الجثّة بحريّة في حيلة بمُنتهى الجرأة والمكر
Dialogue: 0,0:17:32.11,0:17:35.65,Default,,0000,0000,0000,,باستعمال هذه الحيلة، تمكن من جعلنا نعتقد
Dialogue: 0,0:17:35.65,0:17:39.82,Default,,0000,0000,0000,,أنّ رجل الضماد أخذ تشيكاكو-سان للغابة وقتلها
Dialogue: 0,0:17:40.80,0:17:45.21,Default,,0000,0000,0000,,!وأنّه المسؤول عن كلّ ما حصل
Dialogue: 0,0:17:45.21,0:17:48.67,Default,,0000,0000,0000,,لكن خطّته المُتقنة ظاهرياً
Dialogue: 0,0:17:48.67,0:17:52.01,Default,,0000,0000,0000,,تفكّكت عندما فعلَتْ ران شيئاً
Dialogue: 0,0:17:52.92,0:17:56.71,Default,,0000,0000,0000,,أجل، عندما فتحت باب غرفته عن طريق الخطأ
Dialogue: 0,0:17:56.71,0:17:58.38,Default,,0000,0000,0000,,رأت
Dialogue: 0,0:18:01.21,0:18:03.96,Default,,0000,0000,0000,,!بُنيته الحقيقية
Dialogue: 0,0:18:04.33,0:18:07.92,Default,,0000,0000,0000,,لم تهتم ران بالأمر وقتها
Dialogue: 0,0:18:08.29,0:18:12.40,Default,,0000,0000,0000,,لكن إذا تذكّرَتْ، فخطّة قتله المدروسة
Dialogue: 0,0:18:12.40,0:18:14.83,Default,,0000,0000,0000,,!ستتبخّر
Dialogue: 0,0:18:14.83,0:18:18.10,Default,,0000,0000,0000,,لذا هاجمها في الغابة
Dialogue: 0,0:18:18.10,0:18:20.76,Default,,0000,0000,0000,,!لإسكاتها
Dialogue: 0,0:18:20.76,0:18:23.21,Default,,0000,0000,0000,,لكنّه فشل
Dialogue: 0,0:18:23.60,0:18:27.06,Default,,0000,0000,0000,,وفي قلقه من أن تغادر تشيكاكو-سان \Nالتي كانت هدفه الرئيسي
Dialogue: 0,0:18:27.06,0:18:29.17,Default,,0000,0000,0000,,،أثناء كلّ هذه الفوضى
Dialogue: 0,0:18:29.81,0:18:33.33,Default,,0000,0000,0000,,قطع خطّ الهاتف وأسقط الجسر
Dialogue: 0,0:18:33.59,0:18:36.42,Default,,0000,0000,0000,,واحتجز الجميع في السكن
Dialogue: 0,0:18:38.47,0:18:41.17,Default,,0000,0000,0000,,استدرج تشيكاكو-سان للغابة كما خطّط
Dialogue: 0,0:18:41.17,0:18:43.25,Default,,0000,0000,0000,,وقتلها
Dialogue: 0,0:18:43.46,0:18:45.37,Default,,0000,0000,0000,,استدرجها برسالة
Dialogue: 0,0:18:45.37,0:18:48.88,Default,,0000,0000,0000,,وضعها تحت بابها على الأرجح
Dialogue: 0,0:18:49.87,0:18:54.53,Default,,0000,0000,0000,,كان موضوعها غالباً أتسوكو-سان \Nزميلة أختي في النادي
Dialogue: 0,0:18:54.53,0:18:57.30,Default,,0000,0000,0000,,التي انتحرت قبل عامين
Dialogue: 0,0:18:57.30,0:19:00.36,Default,,0000,0000,0000,,!صحيح! فعلتُ كلّ هذا لأجل أتسوكو
Dialogue: 0,0:19:00.36,0:19:01.76,Default,,0000,0000,0000,,...تـ-تاكاهاشي
Dialogue: 0,0:19:03.19,0:19:07.98,Default,,0000,0000,0000,,أطلعتني سرّاً على قصّةٍ كتبتها
Dialogue: 0,0:19:07.98,0:19:11.67,Default,,0000,0000,0000,,ولمعت عيناها بينما تكلمت\Nعن حلمها في أن تصبح روائية
Dialogue: 0,0:19:12.72,0:19:15.51,Default,,0000,0000,0000,,لكن، شنقت نفسها فجأةً في غرفة اجتماعنا
Dialogue: 0,0:19:15.51,0:19:19.30,Default,,0000,0000,0000,,"عندما رأيتُ فيلم تشيكاكو الأخير، "المملكة الزرقاء
Dialogue: 0,0:19:19.30,0:19:22.08,Default,,0000,0000,0000,,!أدركتُ السبب بوضوح
Dialogue: 0,0:19:22.71,0:19:24.47,Default,,0000,0000,0000,,المملكة الزرقاء؟
Dialogue: 0,0:19:24.47,0:19:26.04,Default,,0000,0000,0000,,...أ-أيمكن
Dialogue: 0,0:19:26.04,0:19:29.08,Default,,0000,0000,0000,,أجل، قصّة عمل تشيكاكو الرسميّ الأوّل
Dialogue: 0,0:19:29.08,0:19:34.96,Default,,0000,0000,0000,,!كانت مُطابقة لـ "البلد الأزرق" الذي أرتني إيّاه أتسوكو
Dialogue: 0,0:19:35.45,0:19:36.77,Default,,0000,0000,0000,,...أتقصد أنّ تشيكاكو
Dialogue: 0,0:19:36.77,0:19:37.91,Default,,0000,0000,0000,,سرقته؟
Dialogue: 0,0:19:37.91,0:19:40.80,Default,,0000,0000,0000,,أجل، فازت تشيكاكو بجائزة\Nكاتب السيناريو الواعد بفضله
Dialogue: 0,0:19:41.32,0:19:45.13,Default,,0000,0000,0000,,بينما كانت لا تزال تدرس، وأصبحت شهيرةً الآن
Dialogue: 0,0:19:46.85,0:19:49.31,Default,,0000,0000,0000,,لكن كيف تجزم بأنّه سبب انتحار أتسوكو؟
Dialogue: 0,0:19:49.31,0:19:52.64,Default,,0000,0000,0000,,يوم فوز تشيكاكو بالجائزة، أي اليوم السابق لموت أتسوكو
Dialogue: 0,0:19:52.64,0:19:54.71,Default,,0000,0000,0000,,أخبرتني أتسوكو على الهاتف
Dialogue: 0,0:19:55.14,0:19:58.67,Default,,0000,0000,0000,,!أنّها لم تعد تستطيع الثقة بأحد
Dialogue: 0,0:19:58.67,0:20:03.17,Default,,0000,0000,0000,,لذا استدرجتُ تشيكاكو للغابة برسالة \N"تهديد لفضح سرقة "البلد الأزرق
Dialogue: 0,0:20:03.17,0:20:06.50,Default,,0000,0000,0000,,!وقطعتُ رأسها
Dialogue: 0,0:20:06.92,0:20:09.46,Default,,0000,0000,0000,,!هذا ما تستحقه لقطع حُلم أتسوكو
Dialogue: 0,0:20:12.82,0:20:14.38,Default,,0000,0000,0000,,...انتهى
Dialogue: 0,0:20:14.38,0:20:15.87,Default,,0000,0000,0000,,...كلّ شيءٍ الآن
Dialogue: 0,0:20:16.78,0:20:18.46,Default,,0000,0000,0000,,حان وقت ذهابي لأتسوكو
Dialogue: 0,0:20:18.46,0:20:20.05,Default,,0000,0000,0000,,!ا-انتظر يا تاكاهشي
Dialogue: 0,0:20:20.34,0:20:21.13,Default,,0000,0000,0000,,!ابتعدوا
Dialogue: 0,0:20:21.13,0:20:21.87,Default,,0000,0000,0000,,!تاكاهاشي-كن
Dialogue: 0,0:20:22.27,0:20:25.11,Default,,0000,0000,0000,,سأذهب للعيش معها في العالم الآخر
Dialogue: 0,0:20:25.11,0:20:27.23,Default,,0000,0000,0000,,!بصفتي رسول العدالة الذي أخذ بثأرها
Dialogue: 0,0:20:27.23,0:20:28.73,Default,,0000,0000,0000,,!يكفي هراءً
Dialogue: 0,0:20:29.34,0:20:32.64,Default,,0000,0000,0000,,!إذا أردت الموت فلتمت يا وغد
Dialogue: 0,0:20:33.30,0:20:35.29,Default,,0000,0000,0000,,...سـ-سونوكو
Dialogue: 0,0:20:35.29,0:20:40.26,Default,,0000,0000,0000,,ربما أقدمت على خطيئة لأجل أتسوكو-سان
Dialogue: 0,0:20:40.60,0:20:43.42,Default,,0000,0000,0000,,،لكن عندما هاجمت ران
Dialogue: 0,0:20:43.42,0:20:45.21,Default,,0000,0000,0000,,لم يكن لأجلها أبداً
Dialogue: 0,0:20:45.21,0:20:46.75,Default,,0000,0000,0000,,كنت خائفاً
Dialogue: 0,0:20:46.75,0:20:50.54,Default,,0000,0000,0000,,!خائفاً من أن تُضبط كمجرم فهاجمتها
Dialogue: 0,0:20:50.54,0:20:52.17,Default,,0000,0000,0000,,...أنتَ لست
Dialogue: 0,0:20:53.91,0:20:56.12,Default,,0000,0000,0000,,رسول عدالة
Dialogue: 0,0:20:56.12,0:20:59.09,Default,,0000,0000,0000,,!مجرّد قاتل بشع متعطّش للدماء
Dialogue: 0,0:21:13.10,0:21:17.06,Default,,0000,0000,0000,,قادت خيانة صديق لموت آخر
Dialogue: 0,0:21:17.06,0:21:20.22,Default,,0000,0000,0000,,مما أدّى لسواد قلب صديقٍ
Dialogue: 0,0:21:21.10,0:21:25.93,Default,,0000,0000,0000,,انقشع ظلام المأساة البارد عن السكن أخيراً
Dialogue: 0,0:21:26.67,0:21:28.55,Default,,0000,0000,0000,,لكن احذروا
Dialogue: 0,0:21:28.55,0:21:31.17,Default,,0000,0000,0000,,افتحوا له طريقاً وسيعاود الظهور
Dialogue: 0,0:21:31.17,0:21:34.29,Default,,0000,0000,0000,,داخل قلب إنسان
Dialogue: 0,0:21:34.29,0:21:37.70,Default,,0000,0000,0000,,القاتل المجنون المعروف بالانتقام
Dialogue: 0,0:23:09.90,0:23:13.12,Default,,0000,0000,0000,,أنا مسرورة لكون أختك في حالٍ أفضل الآن
Dialogue: 0,0:23:13.52,0:23:15.14,Default,,0000,0000,0000,,أنا أيضاً
Dialogue: 0,0:23:15.14,0:23:18.55,Default,,0000,0000,0000,,فقد لازمت الفراش لأسبوع بعد الحادثة
Dialogue: 0,0:23:18.94,0:23:22.26,Default,,0000,0000,0000,,لكن حُلّت القضية
Dialogue: 0,0:23:22.26,0:23:25.00,Default,,0000,0000,0000,,!بفضل استنتاجاتك البارعة
Dialogue: 0,0:23:25.34,0:23:25.84,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:23:26.55,0:23:27.59,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:23:28.13,0:23:31.58,Default,,0000,0000,0000,,!بدوتِ متحرّيةً رائعة
Dialogue: 0,0:23:31.58,0:23:33.08,Default,,0000,0000,0000,,!عليّ تغيير الموضوع
Dialogue: 0,0:23:33.08,0:23:34.25,Default,,0000,0000,0000,,...بالمناسبة
Dialogue: 0,0:23:34.25,0:23:38.67,Default,,0000,0000,0000,,أجل، فقضايا كتلك كشرب الماء بالنسبة لي
Dialogue: 0,0:23:39.12,0:23:42.62,Default,,0000,0000,0000,,زمن شينتشي-كن ووالدك قد ولّى
Dialogue: 0,0:23:43.58,0:23:47.55,Default,,0000,0000,0000,,!إنّه عصر المتحرية العظيمة سوزوكي سونوكو الآن
Dialogue: 0,0:23:51.03,0:23:55.40,Default,,0000,0000,0000,,جعلها متحرية كان غلطةً كبيرة بالفعل
Dialogue: 0,0:24:01.17,0:24:04.13,Default,,0000,0000,0000,,تملك الطبيبة يوكو دافعاً لقتل ناكاموتو-سان
Dialogue: 0,0:24:04.64,0:24:07.96,Default,,0000,0000,0000,,لكن لديها حجّة غياب قويّة
Dialogue: 0,0:24:07.96,0:24:10.42,Default,,0000,0000,0000,,...إذا كانت القاتلة
Dialogue: 0,0:24:10.76,0:24:13.37,Default,,0000,0000,0000,,لا يوجد مشغّل فيديو هنا
Dialogue: 0,0:24:14.17,0:24:17.00,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:24:18.04,0:24:23.41,Default,,0000,0000,0000,,كانت هذه حيلة حجّة غياب\N!باستعمال أيومي-تشان
Dialogue: 0,0:24:24.87,0:24:26.37,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.37,0:24:30.30,Default,,0000,0000,0000,,جريمة قتل يوم الإثنين، 7:30 مساءً
Dialogue: 0,0:24:46.30,0:24:48.65,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.65,0:24:50.26,Default,,0000,0000,0000,,ستائر
Dialogue: 0,0:24:50.26,0:24:52.25,Default,,0000,0000,0000,,

