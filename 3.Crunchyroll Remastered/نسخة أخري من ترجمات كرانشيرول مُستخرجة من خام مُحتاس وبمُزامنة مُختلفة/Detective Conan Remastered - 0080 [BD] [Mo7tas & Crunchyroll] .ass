Dialogue: 0,0:00:01.46,0:00:03.33,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب لامع
Dialogue: 0,0:00:03.33,0:00:06.75,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.24,0:00:10.49,Default,,0000,0000,0000,,!نقطة اليوم الأساسيّة هي البحث عن دليل\N!لا تغفلوا عن الأمر المهم
Dialogue: 0,0:00:10.49,0:00:11.90,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.14,0:00:14.15,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.57,0:00:16.87,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.20,0:01:57.00,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل الرسّام المتجوّل
Dialogue: 0,0:01:51.91,0:01:54.79,Default,,0000,0000,0000,,جريمة قتل الرسّام المتجوّل
Dialogue: 0,0:01:57.00,0:01:59.45,CharCard,,0000,0000,0004,,متحف بيكا للفنون
Dialogue: 0,0:01:59.45,0:02:03.91,On Top,,0000,0000,0000,,فنّ العالم التجريدي
Dialogue: 0,0:02:11.23,0:02:16.10,Default,,0000,0000,0000,,كانت تذاكر الدخول المجّانية التي أعطاني إيّاها\Nعميلي بعد حلّ قضيّته بادرة لطيفة
Dialogue: 0,0:02:16.10,0:02:17.75,Default,,0000,0000,0000,,!لكنّي لا أفهم شيئاً
Dialogue: 0,0:02:18.39,0:02:20.70,Default,,0000,0000,0000,,غير مفهومة، لكنّها جميلة نوعاً ما
Dialogue: 0,0:02:21.34,0:02:22.66,Default,,0000,0000,0000,,تظنّين ذلك؟
Dialogue: 0,0:02:22.97,0:02:25.45,Default,,0000,0000,0000,,أتّفق مع العمّ
Dialogue: 0,0:02:32.21,0:02:34.87,Default,,0000,0000,0000,,ما الذي يفعله ذاك الرجل؟
Dialogue: 0,0:02:35.00,0:02:41.32,Default,,0000,0000,0000,,!لا يمكنك سيّدي! لمس اللوحات ممنوع\N!كذلك، لا يمكنك التدخين
Dialogue: 0,0:02:42.45,0:02:43.91,Default,,0000,0000,0000,,...آسف
Dialogue: 0,0:02:51.35,0:02:52.91,Default,,0000,0000,0000,,يا للشخص الغريب
Dialogue: 0,0:02:53.58,0:02:57.20,Default,,0000,0000,0000,,!هيّا، سأبدأ! أمسكوا بها
Dialogue: 0,0:02:57.48,0:03:01.66,Default,,0000,0000,0000,,لمَ نلعب كرة القاعدة؟\Nلمَ ليس كرة القدم؟
Dialogue: 0,0:03:09.08,0:03:11.16,Default,,0000,0000,0000,,!كونان! إنّها نحوك
Dialogue: 0,0:03:11.16,0:03:13.70,Default,,0000,0000,0000,,!أين ضربتها؟
Dialogue: 0,0:03:15.66,0:03:18.99,Default,,0000,0000,0000,,!أأنت بخيرٍ؟! آسفون
Dialogue: 0,0:03:18.99,0:03:21.78,Default,,0000,0000,0000,,...ماذا؟ ألستَ ذاك الرجل
Dialogue: 0,0:03:24.99,0:03:27.09,Default,,0000,0000,0000,,كنتَ ترسم تخطيطات؟
Dialogue: 0,0:03:28.32,0:03:31.88,Default,,0000,0000,0000,,ماذا؟ كان يرسم هذه الآن؟
Dialogue: 0,0:03:34.65,0:03:37.04,Default,,0000,0000,0000,,لمَ ترسم نفس الصور باستمرار؟
Dialogue: 0,0:03:37.52,0:03:40.19,Default,,0000,0000,0000,,...لمَ... باستمرار
Dialogue: 0,0:03:41.47,0:03:42.74,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:03:42.74,0:03:46.80,Default,,0000,0000,0000,,كونان، هل تأذّى؟
Dialogue: 0,0:03:46.80,0:03:48.59,Default,,0000,0000,0000,,أنطلب الإسعاف؟
Dialogue: 0,0:03:48.59,0:03:50.32,Default,,0000,0000,0000,,!أأنت جاد؟
Dialogue: 0,0:03:50.88,0:03:53.70,Default,,0000,0000,0000,,من... من أنا؟
Dialogue: 0,0:03:54.88,0:03:57.50,Default,,0000,0000,0000,,!لا أستطيع تذكّر اسمي حتّى
Dialogue: 0,0:03:59.16,0:04:01.43,Default,,0000,0000,0000,,أيعاني من فقدان ذاكرة؟
Dialogue: 0,0:04:01.43,0:04:02.78,Default,,0000,0000,0000,,!بسببي أنا؟
Dialogue: 0,0:04:02.78,0:04:05.45,Default,,0000,0000,0000,,!كلا، أصابت الكرة ذراعه
Dialogue: 0,0:04:07.41,0:04:09.46,Default,,0000,0000,0000,,!رأسي يؤلمني
Dialogue: 0,0:04:10.61,0:04:12.49,Default,,0000,0000,0000,,أأنت بخير؟
Dialogue: 0,0:04:12.49,0:04:15.45,Default,,0000,0000,0000,,!رأسي... رأسي يؤلمني
Dialogue: 0,0:04:15.45,0:04:17.41,On Top,,0000,0000,0000,,مشفى يامادا العام
Dialogue: 0,0:04:19.53,0:04:21.91,Default,,0000,0000,0000,,يعاني من فقدان ذاكرة بالفعل إذاً؟
Dialogue: 0,0:04:21.91,0:04:27.50,Default,,0000,0000,0000,,أجل، يصيبه الصداع بينما\Nترجع ذاكرته تدريجياً
Dialogue: 0,0:04:28.60,0:04:30.22,Default,,0000,0000,0000,,يا للدهشة
Dialogue: 0,0:04:30.22,0:04:31.45,Default,,0000,0000,0000,,هذا مُفاجئ
Dialogue: 0,0:04:31.71,0:04:36.04,Default,,0000,0000,0000,,لا يزال يجهل من يكون\Nومن أين هو إذاً؟
Dialogue: 0,0:04:36.04,0:04:37.29,Default,,0000,0000,0000,,يا للمسكين
Dialogue: 0,0:04:37.59,0:04:42.66,Default,,0000,0000,0000,,لا تقلقوا، بلّغنا الشرطة لذا\Nسوف نعرف سريعاً
Dialogue: 0,0:04:53.61,0:04:57.08,Default,,0000,0000,0000,,!كلا! نسيتُ ترك دفتر رسمه
Dialogue: 0,0:04:57.48,0:04:59.71,Default,,0000,0000,0000,,هذا الدفتر له؟
Dialogue: 0,0:04:59.71,0:05:01.28,Default,,0000,0000,0000,,لنرجع إذاً
Dialogue: 0,0:05:04.43,0:05:07.19,Default,,0000,0000,0000,,!تفقّدا مخرج الطوارئ
Dialogue: 0,0:05:07.19,0:05:08.50,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:05:08.50,0:05:10.20,Default,,0000,0000,0000,,أحصل أمرٌ ما؟
Dialogue: 0,0:05:10.88,0:05:14.16,Default,,0000,0000,0000,,في الواقع، اختفى المريض الذي جلبتموه
Dialogue: 0,0:05:15.55,0:05:18.70,Default,,0000,0000,0000,,يبدو أنّه لم يغادر من المدخل\Nبناءً على ردّة فعلكم
Dialogue: 0,0:05:18.70,0:05:21.33,Default,,0000,0000,0000,,نعم، لم نره
Dialogue: 0,0:05:21.33,0:05:23.41,Default,,0000,0000,0000,,ماذا عن ثيابه وأمتعته؟
Dialogue: 0,0:05:23.87,0:05:28.86,Default,,0000,0000,0000,,يبدو أنّه غيّر ثيابه، كما أخذ كلّ أمتعته
Dialogue: 0,0:05:29.19,0:05:34.35,Default,,0000,0000,0000,,أرجعت ذاكرته؟ لكن لمَ قد يختفي عندها؟
Dialogue: 0,0:05:34.98,0:05:36.53,Default,,0000,0000,0000,,أين ذهب بالضبط؟
Dialogue: 0,0:05:38.32,0:05:41.78,Default,,0000,0000,0000,,!مستعدّون؟! سأبدأ
Dialogue: 0,0:05:42.18,0:05:45.37,Default,,0000,0000,0000,,يا إلهي، لمَ لا نلعب كرة القدم؟
Dialogue: 0,0:05:47.46,0:05:49.41,Default,,0000,0000,0000,,!غينتا-كن! إنّها نحوك
Dialogue: 0,0:05:49.41,0:05:52.26,Default,,0000,0000,0000,,أنا لها! سأمسكها
Dialogue: 0,0:05:56.80,0:05:58.16,Default,,0000,0000,0000,,أأنت بخيرٍ يا غينتا؟
Dialogue: 0,0:05:59.41,0:06:00.36,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:06:03.66,0:06:05.49,Default,,0000,0000,0000,,!إنّه الرجل المُسن من الأمس
Dialogue: 0,0:06:05.49,0:06:07.62,Default,,0000,0000,0000,,!هل أصابته الكرة مجدداً؟
Dialogue: 0,0:06:09.65,0:06:11.03,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:06:11.32,0:06:13.49,Default,,0000,0000,0000,,!خُنق بما يشبه الحبل
Dialogue: 0,0:06:13.49,0:06:14.54,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:06:14.54,0:06:16.86,Default,,0000,0000,0000,,!أكانت جريمة قتل؟
Dialogue: 0,0:06:22.81,0:06:28.10,Default,,0000,0000,0000,,،حضرة المفتّش، يبدو أنّ سبب الوفاة هو الخنق\Nقُتِل مساء الأمس غالباً
Dialogue: 0,0:06:28.10,0:06:29.63,Default,,0000,0000,0000,,جيوبه فارغة
Dialogue: 0,0:06:29.63,0:06:30.85,Default,,0000,0000,0000,,!أنت يا كونان
Dialogue: 0,0:06:31.24,0:06:36.02,Default,,0000,0000,0000,,ما الذي تفعله؟! أتسبّب للمفتّش\N!المتاعب مُجدداً؟
Dialogue: 0,0:06:36.13,0:06:41.24,Default,,0000,0000,0000,,كلا يا موري-كن، هؤلاء الأطفال هم من عثروا على الجثّة
Dialogue: 0,0:06:42.46,0:06:45.29,Default,,0000,0000,0000,,كان الضحيّة هنا بالأمس\Nبمفرده إذاً؟
Dialogue: 0,0:06:45.46,0:06:46.29,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:06:46.96,0:06:52.32,Default,,0000,0000,0000,,لعلّ القاتل لاحظه، وهاجمه عندما\Nكان بمفرده وسرق ماله
Dialogue: 0,0:06:52.32,0:06:53.70,Default,,0000,0000,0000,,عملية سرقة إذاً؟
Dialogue: 0,0:06:53.70,0:06:55.20,Default,,0000,0000,0000,,...مهلكما
Dialogue: 0,0:06:55.20,0:07:00.20,Default,,0000,0000,0000,,!حضرة المفتّش! اختفت أدوات الرسم للضحيّة
Dialogue: 0,0:07:00.52,0:07:01.85,Default,,0000,0000,0000,,أدوات الرسم؟
Dialogue: 0,0:07:01.85,0:07:04.46,Default,,0000,0000,0000,,اختفى لوح رسمه والحامل أيضاً
Dialogue: 0,0:07:04.46,0:07:05.98,Default,,0000,0000,0000,,!كذلك صندوق الألوان
Dialogue: 0,0:07:05.98,0:07:08.16,Default,,0000,0000,0000,,!حقيبته أيضاً
Dialogue: 0,0:07:09.18,0:07:11.01,Default,,0000,0000,0000,,كانت هذه مع الضحيّة؟
Dialogue: 0,0:07:11.01,0:07:13.37,Default,,0000,0000,0000,,لا بدّ أنّها سُرقت كذلك
Dialogue: 0,0:07:13.74,0:07:18.99,Default,,0000,0000,0000,,مستحيل، لن يسرق أحد تلك الأدوات\Nالرخيصة، ستُثقل عليه فحسب
Dialogue: 0,0:07:19.32,0:07:20.03,Default,,0000,0000,0000,,...وأيضاً
Dialogue: 0,0:07:20.84,0:07:24.73,Default,,0000,0000,0000,,عقدة إحدى فردتيّ حذاء الضحيّة\N...مربوطة بشكل رأسيّ
Dialogue: 0,0:07:25.11,0:07:27.08,Default,,0000,0000,0000,,ما يعني أنّه لم يربطها بنفسه
Dialogue: 0,0:07:28.25,0:07:30.96,Default,,0000,0000,0000,,ورقة الجنكة داخل حذائه\Nمثيرة للغرابة أيضاً
Dialogue: 0,0:07:31.41,0:07:33.71,Default,,0000,0000,0000,,لا توجد أشجار جنكة في هذه المنطقة
Dialogue: 0,0:07:34.45,0:07:38.07,Default,,0000,0000,0000,,بناءً على مكان الضحيّة، لا بدّ أنّه\Nقُتل في مكانٍ ما
Dialogue: 0,0:07:38.07,0:07:41.49,Default,,0000,0000,0000,,ثمّ أُلقي من على الجسر ليلاً
Dialogue: 0,0:07:41.90,0:07:44.94,Default,,0000,0000,0000,,لمَ اختفى من المشفى أيضاً؟
Dialogue: 0,0:07:46.35,0:07:50.11,Default,,0000,0000,0000,,لا تبدو هذه مجرّد\N!جريمة سرقة عادية أبداً
Dialogue: 0,0:07:50.11,0:07:54.26,Default,,0000,0000,0000,,بافتراض أنّها جريمة سرقة، علينا معرفة\Nهويّة الضحيّة أوّلاً
Dialogue: 0,0:07:54.26,0:07:57.14,Default,,0000,0000,0000,,...حضرة المفتّش، قد تكون هذه
Dialogue: 0,0:07:57.14,0:08:01.82,Default,,0000,0000,0000,,،أنت! يكفي تدخّلك في تحقيقاتي\N!والآن تتدخّل في تحقيق المفتّش؟
Dialogue: 0,0:08:02.38,0:08:03.42,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:08:04.79,0:08:06.71,Default,,0000,0000,0000,,!اذهب والعب بعيداً
Dialogue: 0,0:08:06.71,0:08:09.91,Default,,0000,0000,0000,,إذاً حضرة المفتّش، لنلق نظرة على الضحيّة
Dialogue: 0,0:08:09.91,0:08:11.65,Default,,0000,0000,0000,,!حسناً، لنبدأ
Dialogue: 0,0:08:12.49,0:08:14.04,Default,,0000,0000,0000,,ماذا تريدنا أن نفعل؟
Dialogue: 0,0:08:14.04,0:08:15.87,Default,,0000,0000,0000,,!نحن فرقة فتيان التحرّي
Dialogue: 0,0:08:16.32,0:08:18.82,Default,,0000,0000,0000,,!مُذهل، أهلٌ للمسؤولية
Dialogue: 0,0:08:18.82,0:08:21.07,CharCard,,0000,0000,0000,,مركز تسوّق
Dialogue: 0,0:08:24.65,0:08:30.66,Default,,0000,0000,0000,,،خلف المنزل يميناً عمود كهربائيّ إذاً\N...بينما يساراً يوجد مصنع
Dialogue: 0,0:08:30.66,0:08:32.02,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:08:32.02,0:08:33.97,Default,,0000,0000,0000,,!علينا إيجاد ذاك المنزل فحسب
Dialogue: 0,0:08:33.97,0:08:36.05,Default,,0000,0000,0000,,!حسنٌ، لنفعلها
Dialogue: 0,0:08:41.29,0:08:42.45,Default,,0000,0000,0000,,لا أراه
Dialogue: 0,0:08:42.76,0:08:43.91,Default,,0000,0000,0000,,ولا هنا
Dialogue: 0,0:08:44.38,0:08:48.38,Default,,0000,0000,0000,,!ولا هنا أيضاً، ماذا عنك يا أيومي-تشان
Dialogue: 0,0:08:48.62,0:08:50.57,Default,,0000,0000,0000,,!وجدتُه
Dialogue: 0,0:08:56.37,0:08:59.01,Default,,0000,0000,0000,,!ها هو، إنّه ذاك\N!توجد شجرة جنكة حتّى
Dialogue: 0,0:08:59.11,0:09:02.07,On Top,,0000,0000,0000,,خدمة أوكيتا للتنظيف
Dialogue: 0,0:09:03.07,0:09:04.61,Default,,0000,0000,0000,,..."هاياسي"
Dialogue: 0,0:09:04.61,0:09:06.62,Default,,0000,0000,0000,,هذه السيّارة جديدة
Dialogue: 0,0:09:07.11,0:09:12.57,Default,,0000,0000,0000,,لمَ تريد تنظيفها بحيث لا تبقى شعرة\Nرغم أنّها ليست متّسخة حتّى؟
Dialogue: 0,0:09:12.85,0:09:14.52,Default,,0000,0000,0000,,الأمر نفسه داخل المنزل
Dialogue: 0,0:09:15.06,0:09:19.28,Default,,0000,0000,0000,,تريد مسح كلّ شيء يُحتمل\Nأن يكون قد لمسه شخص
Dialogue: 0,0:09:19.55,0:09:22.21,Default,,0000,0000,0000,,...أيمكن أنّ هذا لإزالة البصمات
Dialogue: 0,0:09:24.59,0:09:27.47,Default,,0000,0000,0000,,!أنتم! ما الذي تفعلونه؟
Dialogue: 0,0:09:28.44,0:09:32.95,CharCard,,0000,0000,0004,,(37) هاياسي كيمي
Dialogue: 0,0:09:28.58,0:09:31.94,On Top,,0000,0000,0000,,...لا يزال متّسخاً، أعيدوا تنظيف الداخل
Dialogue: 0,0:09:32.50,0:09:32.99,On Top,,0000,0000,0000,,عجباً
Dialogue: 0,0:09:32.99,0:09:34.95,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:09:37.54,0:09:39.07,Default,,0000,0000,0000,,تفضّلوا
Dialogue: 0,0:09:39.57,0:09:43.61,Default,,0000,0000,0000,,!صحيح، لديّ بسكويت لذيذ\N!انتظروا قليلاً
Dialogue: 0,0:09:45.90,0:09:48.41,Default,,0000,0000,0000,,!عقدة مريلتها مربوطة رأسياً
Dialogue: 0,0:09:49.93,0:09:53.68,Default,,0000,0000,0000,,الأريكة والطاولة ليست نفسها، ولا يوجد تلفاز
Dialogue: 0,0:09:53.68,0:09:55.41,Default,,0000,0000,0000,,إنّها مختلفة تماماً عن الرسمة
Dialogue: 0,0:09:56.18,0:09:59.91,Default,,0000,0000,0000,,أخبريني يا عمّة، هل قمتِ بتحديث\Nالغرفة مؤخراً؟
Dialogue: 0,0:10:00.26,0:10:03.13,Default,,0000,0000,0000,,نعم، لمَ تسأل؟
Dialogue: 0,0:10:03.13,0:10:05.04,Default,,0000,0000,0000,,أين الأشياء السابقة؟
Dialogue: 0,0:10:05.04,0:10:06.76,Default,,0000,0000,0000,,رميتُها كلّها
Dialogue: 0,0:10:07.21,0:10:09.18,Default,,0000,0000,0000,,أتلك اللوحة جديدة أيضاً؟
Dialogue: 0,0:10:09.18,0:10:10.20,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:10:10.20,0:10:13.17,Default,,0000,0000,0000,,وصلت من معرض الفنون\Nقبل يومين فحسب
Dialogue: 0,0:10:13.91,0:10:15.23,Default,,0000,0000,0000,,أليست جميلة؟
Dialogue: 0,0:10:16.16,0:10:19.66,Default,,0000,0000,0000,,...هذا سيّئ، سيكون إثبات الأمر صعباً الآن
Dialogue: 0,0:10:20.65,0:10:24.07,Default,,0000,0000,0000,,بالمناسبة يا أولاد، ما الذي أردتم\Nالكلام معي بشأنه؟
Dialogue: 0,0:10:24.26,0:10:26.44,Default,,0000,0000,0000,,...حـ-حسناً، تكلّم يا ميتسوهيكو-كن
Dialogue: 0,0:10:26.44,0:10:27.75,Default,,0000,0000,0000,,ما كان يا ترى؟
Dialogue: 0,0:10:28.07,0:10:30.29,Default,,0000,0000,0000,,كونان-كن، انظر هناك
Dialogue: 0,0:10:33.49,0:10:35.23,On Top,,0000,0000,0000,,!إنّه ذاك الرجل
Dialogue: 0,0:10:33.49,0:10:38.95,CharCard,,0000,0000,0004,,(47) هاياسي تاتسو
Dialogue: 0,0:10:35.23,0:10:36.23,On Top,,0000,0000,0000,,ألا يشبهه تماماً؟
Dialogue: 0,0:10:36.23,0:10:38.95,On Top,,0000,0000,0000,,!حتّى أنفه المميّز مثله
Dialogue: 0,0:10:39.76,0:10:41.91,Default,,0000,0000,0000,,!ماذا؟ يرتدي نظّارات
Dialogue: 0,0:10:42.22,0:10:43.84,Default,,0000,0000,0000,,من ذاك الشخص؟
Dialogue: 0,0:10:43.84,0:10:44.97,Default,,0000,0000,0000,,زوجي
Dialogue: 0,0:10:44.97,0:10:46.49,Default,,0000,0000,0000,,متى تُوفي؟
Dialogue: 0,0:10:46.49,0:10:47.37,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:10:47.55,0:10:50.32,Default,,0000,0000,0000,,يشبه رجلاً وجدته الشرطة\Nمقتولاً صباح اليوم
Dialogue: 0,0:10:50.54,0:10:54.87,Default,,0000,0000,0000,,لا بدّ أنّه كان رجلاً آخر، فزوجي قد تُوفّي\Nقبل عام وفقما يُفترض
Dialogue: 0,0:10:55.16,0:10:56.21,Default,,0000,0000,0000,,وفقما يُفترض؟
Dialogue: 0,0:10:56.83,0:10:58.90,Default,,0000,0000,0000,,اختفاء في كارثة؟
Dialogue: 0,0:10:59.07,0:11:02.53,Default,,0000,0000,0000,,يُعدّ الشخص ميتاً إذا اختفى بشكل عاديّ\Nلسبع سنوات في العادة
Dialogue: 0,0:11:02.53,0:11:05.82,Default,,0000,0000,0000,,لكنّ الناس الذي يختفون أثناء كوارث طبيعية\Nأو حوادث غرق سفن
Dialogue: 0,0:11:05.82,0:11:09.86,Default,,0000,0000,0000,,يُعدّون موتى بعد مرور عامٍ فحسب
Dialogue: 0,0:11:10.44,0:11:15.58,Default,,0000,0000,0000,,على ذكر ذلك، كان هناك رجل\N...يعمل في مصرف يُدعى هاياسي
Dialogue: 0,0:11:15.98,0:11:19.99,Default,,0000,0000,0000,,علق في انهيار ثلجيّ واُعتبر مفقوداً قبل عام
Dialogue: 0,0:11:20.26,0:11:22.30,Default,,0000,0000,0000,,!أجل! ذاك هو
Dialogue: 0,0:11:22.30,0:11:24.45,Default,,0000,0000,0000,,!من المُبهر أنّك تذكرته يا أبي
Dialogue: 0,0:11:24.72,0:11:28.05,Default,,0000,0000,0000,,هذه من سمات المتحرّي العظيم
Dialogue: 0,0:11:28.05,0:11:32.78,Default,,0000,0000,0000,,آنذاك، انتشرت شائعات عن اختلاس\Nهاياسي هذا لأموال طائلة
Dialogue: 0,0:11:33.25,0:11:36.04,Default,,0000,0000,0000,,كانوا على وشك التحقيق معه
Dialogue: 0,0:11:36.37,0:11:40.24,Default,,0000,0000,0000,,لذا ظنّت السلطات أنّه اختفاء مُصطنع
Dialogue: 0,0:11:40.24,0:11:43.45,Default,,0000,0000,0000,,لم يستطيعوا تعقّب مكان الأموال المُختلسة
Dialogue: 0,0:11:43.45,0:11:46.70,Default,,0000,0000,0000,,فافترضوا أنّه اختفى معها
Dialogue: 0,0:11:47.36,0:11:51.07,Default,,0000,0000,0000,,لكن في النهاية اعتبروه اختفاءً في كارثة؟
Dialogue: 0,0:11:51.35,0:11:52.23,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:11:52.23,0:11:55.29,Default,,0000,0000,0000,,بأيّ حال يا كونان، هل أخبرت المفتّش ميغوري؟
Dialogue: 0,0:11:55.68,0:12:00.36,Default,,0000,0000,0000,,نعم! جعلها تتحقق من الجثّة
Dialogue: 0,0:12:00.86,0:12:05.33,CharCard,,0000,0000,0004,,مركز شرطة المنطقة - المشرحة
Dialogue: 0,0:12:01.64,0:12:05.33,On Top,,0000,0000,0000,,يشبهه، لكنّه ليس زوجي\Nبل شخصٌ مختلف
Dialogue: 0,0:12:05.33,0:12:09.42,Default,,0000,0000,0000,,هل كان لهاياسي-سان الراحل أيّ أقارب؟
Dialogue: 0,0:12:09.42,0:12:12.28,Default,,0000,0000,0000,,أب أو أمّ أو إخوة؟
Dialogue: 0,0:12:12.28,0:12:17.20,Default,,0000,0000,0000,,،كلا، لم يكن لديه أيّ أقارب\Nلمَ تسأل؟
Dialogue: 0,0:12:17.63,0:12:19.62,Default,,0000,0000,0000,,...لا سبب
Dialogue: 0,0:12:19.62,0:12:24.03,Default,,0000,0000,0000,,أي أنّكِ الوحيدة التي تستطيع\Nتأكيد هويّته؟
Dialogue: 0,0:12:24.41,0:12:26.62,Default,,0000,0000,0000,,يبدو ذلك
Dialogue: 0,0:12:26.62,0:12:28.61,Default,,0000,0000,0000,,!أنت! لا تدخّن
Dialogue: 0,0:12:28.61,0:12:30.11,Default,,0000,0000,0000,,...آ-آسف
Dialogue: 0,0:12:31.40,0:12:34.15,Default,,0000,0000,0000,,بالمناسبة، هل كان السيّد هاياسي يحبّ الرسم؟
Dialogue: 0,0:12:34.16,0:12:34.79,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:35.06,0:12:38.43,Default,,0000,0000,0000,,يمكننا التحقّق من البصمات\Nإذا حصلنا على أغراضه القديمة
Dialogue: 0,0:12:38.43,0:12:39.95,Default,,0000,0000,0000,,صحيح حضرة المفتّش؟
Dialogue: 0,0:12:39.95,0:12:40.99,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:41.43,0:12:44.07,Default,,0000,0000,0000,,كان زوجي يهوى الرسم حقّاً
Dialogue: 0,0:12:44.76,0:12:48.59,Default,,0000,0000,0000,,كان يرسم في الجبال عندما\Nوقع الانهيار الثلجيّ قبل عام
Dialogue: 0,0:12:48.59,0:12:51.41,Default,,0000,0000,0000,,لكنّي تخلّصتُ من كلّ أغراضه
Dialogue: 0,0:12:51.66,0:12:53.87,Default,,0000,0000,0000,,كلّها؟
Dialogue: 0,0:12:55.38,0:12:57.71,Default,,0000,0000,0000,,لامني الإعلام والمجتمع
Dialogue: 0,0:12:57.71,0:13:01.18,Default,,0000,0000,0000,,بسبب قضيّة الاختلاس أيضاً وضايقوني
Dialogue: 0,0:13:01.74,0:13:03.71,Default,,0000,0000,0000,,أردتُ نسيان زوجي أسرع ما يمكن
Dialogue: 0,0:13:05.62,0:13:09.86,Default,,0000,0000,0000,,في النهاية، كلّ ما يسعنا\Nهو تصديق ما قالته
Dialogue: 0,0:13:11.27,0:13:15.90,Default,,0000,0000,0000,,كلّا، لا شكّ أنّ ذاك الضحيّة\N!كان هاياسي تاتسو-سان
Dialogue: 0,0:13:15.90,0:13:19.06,Default,,0000,0000,0000,,ألا توجد طريقة لإثبات ذلك؟
Dialogue: 0,0:13:22.53,0:13:24.49,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:13:25.89,0:13:26.70,Default,,0000,0000,0000,,...عجباً
Dialogue: 0,0:13:27.06,0:13:30.41,Default,,0000,0000,0000,,المعذرة، نسينا شيئاً في اليوم السابق
Dialogue: 0,0:13:32.55,0:13:35.34,Default,,0000,0000,0000,,!كان البسكويت وقتها لذيذاً جدّاً
Dialogue: 0,0:13:35.34,0:13:37.56,Default,,0000,0000,0000,,!نريد أكله مجدداً
Dialogue: 0,0:13:37.71,0:13:39.91,Default,,0000,0000,0000,,هذا الشيء الذي نسيتموه هنا؟
Dialogue: 0,0:13:39.91,0:13:41.70,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:13:41.70,0:13:43.20,Default,,0000,0000,0000,,انتظروا قليلاً
Dialogue: 0,0:13:46.95,0:13:50.57,Default,,0000,0000,0000,,أبقيت أيّ آثار\Nعلى قدوم الضحيّة هنا؟
Dialogue: 0,0:13:50.57,0:13:52.78,Default,,0000,0000,0000,,ما الذي تفعله يا كونان؟
Dialogue: 0,0:13:53.94,0:13:55.70,Default,,0000,0000,0000,,...أثر احتراق
Dialogue: 0,0:13:56.90,0:13:58.45,Default,,0000,0000,0000,,...أوراق جنكة
Dialogue: 0,0:13:58.89,0:14:02.77,Default,,0000,0000,0000,,تجمّعها هنا يعني أنّها\Nستدخل إذا كانت النافذة مفتوحة
Dialogue: 0,0:14:04.01,0:14:06.87,Default,,0000,0000,0000,,...لحظة! الورقة والنافذة وأثر الحرق
Dialogue: 0,0:14:07.68,0:14:11.57,Default,,0000,0000,0000,,،الضحيّة الذي لم يضع نظّاراته\N!كما الرسمة على الحائط
Dialogue: 0,0:14:12.09,0:14:13.88,Default,,0000,0000,0000,,!وجدتُه أخيراً
Dialogue: 0,0:14:13.88,0:14:17.88,Default,,0000,0000,0000,,دليل عودة هاياسي-سان لهذا المنزل\N!بعدما رجعت ذاكرته
Dialogue: 0,0:14:23.25,0:14:28.82,Default,,0000,0000,0000,,مفتّش ميغوري! ذاك الضحيّة هو\N!هاياسي تاتسو-سان بلا شكّ
Dialogue: 0,0:14:28.82,0:14:31.78,Default,,0000,0000,0000,,!وجدتُ دليلاً على ذلك أخيراً
Dialogue: 0,0:14:31.78,0:14:34.49,Default,,0000,0000,0000,,!ماذا؟! حقّاً يا موري-كن؟
Dialogue: 0,0:14:36.15,0:14:38.86,Default,,0000,0000,0000,,!حقّاً سيّدي المفتّش؟
Dialogue: 0,0:14:38.86,0:14:42.32,Default,,0000,0000,0000,,نعم، تعال بأسرع ما يمكن يا موري-كن
Dialogue: 0,0:14:44.31,0:14:47.48,Default,,0000,0000,0000,,...ما الذي يعنيه هذا؟ حتّى لو كنتم الشرطة
Dialogue: 0,0:14:47.48,0:14:51.37,Default,,0000,0000,0000,,...أتفهّم مشاعرك، سيوضّح موري-كن
Dialogue: 0,0:14:51.37,0:14:52.38,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:52.38,0:14:54.82,Default,,0000,0000,0000,,...لكن ظننتَ أنّك من سيوضّح
Dialogue: 0,0:14:58.71,0:15:00.70,Default,,0000,0000,0000,,...قد لا يعجبك ذلك
Dialogue: 0,0:15:01.12,0:15:06.06,Default,,0000,0000,0000,,لكن سأسلّط أنا المتحرّي العظيم موري كوغورو\Nالنور على حقيقة هذه القضيّة
Dialogue: 0,0:15:06.50,0:15:10.45,Default,,0000,0000,0000,,قبل عام، ذهب السيّد هاياسي للجبال للرسم
Dialogue: 0,0:15:10.78,0:15:12.66,Default,,0000,0000,0000,,وعلق في انهيار ثلجيّ
Dialogue: 0,0:15:14.03,0:15:17.46,Default,,0000,0000,0000,,نجا لحسن الحظّ، لكن فقد ذاكرته
Dialogue: 0,0:15:17.90,0:15:22.35,Default,,0000,0000,0000,,أصبح يتجوّل بعدها في مختلف الأرجاء\Nكرسّام متجوّل
Dialogue: 0,0:15:22.35,0:15:25.74,Default,,0000,0000,0000,,ويرسم لوحات لمنزله طوال الوقت دون إدراكه
Dialogue: 0,0:15:26.74,0:15:34.79,Default,,0000,0000,0000,,مضى عام على الحادثة، وتمّ اعتبار السيّد هاياسي\Nميتاً في كارثة طبيعية
Dialogue: 0,0:15:34.79,0:15:39.24,Default,,0000,0000,0000,,أي أنّ الزوجة سترث ممتلكاته
Dialogue: 0,0:15:39.62,0:15:40.57,Default,,0000,0000,0000,,وما في ذلك؟
Dialogue: 0,0:15:40.87,0:15:44.00,Default,,0000,0000,0000,,!لذا سيكون ظهوره الآن مشكلةً لك
Dialogue: 0,0:15:44.00,0:15:46.04,Default,,0000,0000,0000,,ما قصدك يا موري-كن؟
Dialogue: 0,0:15:46.54,0:15:52.99,Default,,0000,0000,0000,,تضمّن ميراثه غالباً المال المفقود\Nالذي قام باختلاسه
Dialogue: 0,0:15:53.31,0:15:58.27,Default,,0000,0000,0000,,لذا، قامت بقتل السيّد هاياسي عندما\N...رجع بالأمس هنا
Dialogue: 0,0:15:58.51,0:15:59.80,Default,,0000,0000,0000,,!وذاكرته سليمة
Dialogue: 0,0:15:59.81,0:16:02.32,Default,,0000,0000,0000,,!كي تحتفظ بالمال لنفسها
Dialogue: 0,0:16:02.49,0:16:04.99,Default,,0000,0000,0000,,!ما الذي تقوله يا موري-كن؟
Dialogue: 0,0:16:07.73,0:16:10.47,Default,,0000,0000,0000,,تُوفي زوجي في الجبال قبل عام
Dialogue: 0,0:16:10.47,0:16:13.89,Default,,0000,0000,0000,,أم لديك دليلٌ على أنّه كان حيّاً؟
Dialogue: 0,0:16:14.40,0:16:20.36,Default,,0000,0000,0000,,صحيح، لا دليل لديّ، فأنتِ قد تخلّصتِ\Nمن كلّ أغراضه الشخصيّة
Dialogue: 0,0:16:21.63,0:16:26.96,Default,,0000,0000,0000,,أزلتِ كلّ البصمات وبقايا الشعر\Nالتي يُحتمل أنّها بقيت بالطبع
Dialogue: 0,0:16:26.96,0:16:31.16,Default,,0000,0000,0000,,عيّنتِ شركة تنظيف خاصّة\Nمن باب الحيطة حتّى
Dialogue: 0,0:16:31.70,0:16:35.74,Default,,0000,0000,0000,,ما يعني أنّك لا تستطيع إثبات شيء
Dialogue: 0,0:16:36.20,0:16:40.69,Default,,0000,0000,0000,,لكن، بقي مع الضحيّة ما يصله بك
Dialogue: 0,0:16:40.69,0:16:43.36,Default,,0000,0000,0000,,ورقة جنكة في فردة حذائه
Dialogue: 0,0:16:43.36,0:16:47.16,Default,,0000,0000,0000,,لم تكن هناك أشجار جنكة\Nفي المكان الذي وُجِد فيه
Dialogue: 0,0:16:47.52,0:16:53.62,Default,,0000,0000,0000,,...أجل، توجد شجرة جنكة في منزلي\Nكما في كلّ أرجاء طوكيو
Dialogue: 0,0:16:54.01,0:16:59.04,Default,,0000,0000,0000,,أمرٌ إضافيّ، لسببٍ ما كانت عقدة\N...إحدى فردتي حذاء الضحيّة
Dialogue: 0,0:16:59.04,0:17:01.73,Default,,0000,0000,0000,,مربوطة بشكل رأسي
Dialogue: 0,0:17:01.81,0:17:04.08,Default,,0000,0000,0000,,!مثل مريلتك يا سيّدة
Dialogue: 0,0:17:05.70,0:17:06.84,Default,,0000,0000,0000,,!إنّها الحقيقة
Dialogue: 0,0:17:06.84,0:17:08.15,Default,,0000,0000,0000,,...بذكرك ذلك، تبدو فعلاً
Dialogue: 0,0:17:08.45,0:17:12.41,Default,,0000,0000,0000,,،على الأرجح، عندما ألبستِه حذاءه عقب قتله
Dialogue: 0,0:17:12.41,0:17:15.12,Default,,0000,0000,0000,,!لاحظتِ انحلال ربطة فردة
Dialogue: 0,0:17:15.12,0:17:21.21,Default,,0000,0000,0000,,لم تريدي أن تثيري الشبهة\Nلأمرٍ تافه كهذا، فقرّرتِ ربطها
Dialogue: 0,0:17:21.57,0:17:25.54,Default,,0000,0000,0000,,تدّعي أنّي المجرمة بسبب عقدة رأسية؟\Nمثير للضحك
Dialogue: 0,0:17:26.32,0:17:30.99,Default,,0000,0000,0000,,!لن أسمح لك بإهانتي أكثر! سأقاضيك جديّاً
Dialogue: 0,0:17:31.31,0:17:32.64,Default,,0000,0000,0000,,...أ-أبي
Dialogue: 0,0:17:32.64,0:17:37.16,Default,,0000,0000,0000,,أأنت واثقٌ من هذا يا موري-كن؟\Nلديك دليل بالفعل، صحيح؟
Dialogue: 0,0:17:37.47,0:17:40.55,Default,,0000,0000,0000,,إذاً، لننتقل لصلب الموضوع
Dialogue: 0,0:17:40.55,0:17:42.49,Default,,0000,0000,0000,,!ران، قفي أمام اللوحة
Dialogue: 0,0:17:43.05,0:17:43.91,Default,,0000,0000,0000,,أنا؟
Dialogue: 0,0:17:43.91,0:17:44.96,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:17:44.96,0:17:45.56,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:17:47.95,0:17:49.72,Default,,0000,0000,0000,,هكذا جيّد؟
Dialogue: 0,0:17:49.72,0:17:50.74,Default,,0000,0000,0000,,أجل، يكفي
Dialogue: 0,0:17:51.41,0:17:56.08,Default,,0000,0000,0000,,الآن أخبريني يا سيّدة، أكان السيّد هاياسي\Nمدخناً شرهاً؟
Dialogue: 0,0:17:56.29,0:17:57.08,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:57.08,0:17:58.28,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:17:58.28,0:18:01.70,Default,,0000,0000,0000,,وأنتِ تكرهين التدخين، أليس كذلك؟
Dialogue: 0,0:18:02.65,0:18:04.83,Default,,0000,0000,0000,,!أنت! لا تدخّن
Dialogue: 0,0:18:04.83,0:18:06.12,Default,,0000,0000,0000,,...آ-آسف
Dialogue: 0,0:18:08.52,0:18:09.99,Default,,0000,0000,0000,,وما في ذلك؟
Dialogue: 0,0:18:10.31,0:18:14.45,Default,,0000,0000,0000,,...بعد رجوع ذاكرته ومغادرته المشفى
Dialogue: 0,0:18:14.85,0:18:17.64,Default,,0000,0000,0000,,وقف السيّد هاياسي أمام هذه الرسمة في المنزل
Dialogue: 0,0:18:18.15,0:18:20.73,Default,,0000,0000,0000,,بلفافة سجائر في فمه
Dialogue: 0,0:18:21.09,0:18:24.84,Default,,0000,0000,0000,,توجّهتِ لفتح نافذة بما أنّك\Nتكرهين التدخين بالطبع
Dialogue: 0,0:18:25.09,0:18:29.29,Default,,0000,0000,0000,,سقطت بضعة أوراق جنكة\Nداخل المنزل وقتها غالباً
Dialogue: 0,0:18:30.58,0:18:35.37,Default,,0000,0000,0000,,التصقت إحداها بقدم السيّد هاياسي\Nعندما كان داخل هذا المنزل
Dialogue: 0,0:18:35.58,0:18:40.32,Default,,0000,0000,0000,,لكن كيف عرفت أنّه كان يدخّن هناك؟
Dialogue: 0,0:18:40.74,0:18:44.62,Default,,0000,0000,0000,,بسبب أثر الحرق على المنضدة الخشبية
Dialogue: 0,0:18:45.44,0:18:50.32,Default,,0000,0000,0000,,،لم تكن هناك منفضة سجائر في المنزل\Nفأطفأها عليها
Dialogue: 0,0:18:51.27,0:18:56.66,Default,,0000,0000,0000,,لن تضحكني بادّعاء أنّ أثر الحرق ذاك \Nهو دليلك، صحيح؟
Dialogue: 0,0:18:57.14,0:19:01.12,Default,,0000,0000,0000,,سيّدتي، أكان السيّد هاياسي\Nيعاني من قصر نظر؟
Dialogue: 0,0:19:01.80,0:19:02.95,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:19:03.42,0:19:04.80,Default,,0000,0000,0000,,ران، تذكّري
Dialogue: 0,0:19:04.80,0:19:08.82,Default,,0000,0000,0000,,انظري للوحة مثلما فعل هو\Nفي متحف بيكا للفنون
Dialogue: 0,0:19:10.81,0:19:12.32,Default,,0000,0000,0000,,...آنذاك
Dialogue: 0,0:19:16.71,0:19:19.86,Default,,0000,0000,0000,,...أظنّه اقترب، ثمّ
Dialogue: 0,0:19:19.86,0:19:21.49,Default,,0000,0000,0000,,!توقّفي
Dialogue: 0,0:19:23.49,0:19:24.87,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:19:25.74,0:19:28.45,Default,,0000,0000,0000,,!فهمت! البصمات يا أبي
Dialogue: 0,0:19:28.94,0:19:33.02,Default,,0000,0000,0000,,البصمات؟ أتقصدين أنّه توجد\Nبصمات على تلك اللوحة؟
Dialogue: 0,0:19:33.02,0:19:38.40,Default,,0000,0000,0000,,لكنّك قلت أنّ الزوجة أزالت\N!كلّ البصمات والشعر من المنزل
Dialogue: 0,0:19:38.68,0:19:42.72,Default,,0000,0000,0000,,أجل، قامت بتعيين شركة تنظيف حتّى
Dialogue: 0,0:19:42.72,0:19:45.62,Default,,0000,0000,0000,,لكن حضرة المفتّش، أمعن التفكير
Dialogue: 0,0:19:45.62,0:19:49.82,Default,,0000,0000,0000,,لن يُقدم متخصصو تنظيف \Nعلى مسح لوحة فنّية
Dialogue: 0,0:19:50.08,0:19:52.21,Default,,0000,0000,0000,,...مـ-معك حق
Dialogue: 0,0:19:52.21,0:19:56.79,Default,,0000,0000,0000,,لكن إذا كان من عادة السيّد هاياسي\N!الإمساك باللوحات عند النظر لها، فستعرف السيّدة
Dialogue: 0,0:19:57.25,0:20:02.02,Default,,0000,0000,0000,,كلا، ظهرت عادته هذه بعدما فقد ذاكرته
Dialogue: 0,0:20:02.78,0:20:07.60,Default,,0000,0000,0000,,كان السيّد هاياسي يرتدّي نظارات\Nقصر نظر قبل إصابته بفقدان الذاكرة
Dialogue: 0,0:20:08.23,0:20:10.91,Default,,0000,0000,0000,,لكنّه فقدها في الانهيار الثلجيّ
Dialogue: 0,0:20:11.31,0:20:16.50,Default,,0000,0000,0000,,بعدها، أصبح يقترب من اللوحات\Nبسبب بصره الضعيف
Dialogue: 0,0:20:16.94,0:20:20.41,Default,,0000,0000,0000,,وتشكّلت عادة إمساكه بها ليمعن النظر
Dialogue: 0,0:20:21.51,0:20:25.05,Default,,0000,0000,0000,,،عندما رجع السيّد هاياسي لهذا المنزل ونظر للوحة
Dialogue: 0,0:20:25.05,0:20:29.57,Default,,0000,0000,0000,,توجّهت زوجته غالباً لفتح النافذة\Nلتهوية الغرفة من الدخان
Dialogue: 0,0:20:29.65,0:20:34.54,Default,,0000,0000,0000,,وبينما كانت تعطيه ظهرها، لم تنتبه للأمر على الأرجح
Dialogue: 0,0:20:34.83,0:20:37.50,Default,,0000,0000,0000,,لذا غفلت عن ذلك؟
Dialogue: 0,0:20:37.82,0:20:41.78,Default,,0000,0000,0000,,سيّدتي، هل يمكنك تفسير\N...وجود بصمات الضحيّة
Dialogue: 0,0:20:41.78,0:20:45.42,Default,,0000,0000,0000,,على لوحة وصلتك قبل مجرّد يومين؟
Dialogue: 0,0:20:45.96,0:20:49.11,Default,,0000,0000,0000,,!تاكاغي-كن! اطلب فريق التحليل\N!اجعلهم يراجعون البصمات
Dialogue: 0,0:20:49.32,0:20:49.75,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:20:50.52,0:20:51.91,Default,,0000,0000,0000,,أستسلم
Dialogue: 0,0:20:54.11,0:20:58.96,Default,,0000,0000,0000,,أتى هنا فعلاً، كان كلّ شيء كما قال المتحرّي
Dialogue: 0,0:21:00.10,0:21:02.04,Default,,0000,0000,0000,,قتلتُه
Dialogue: 0,0:21:02.41,0:21:06.53,Default,,0000,0000,0000,,قدّمت له قهوة بحبوب مخدّرة\Nثمّ خنقته بحبل
Dialogue: 0,0:21:07.49,0:21:11.62,Default,,0000,0000,0000,,لكن لمَ ألقيتِه في مكان مكشوف\Nبحيث يُعثر عليه فوراً؟
Dialogue: 0,0:21:12.01,0:21:14.32,Default,,0000,0000,0000,,!لم أرد الانتظار أطول
Dialogue: 0,0:21:14.67,0:21:19.00,Default,,0000,0000,0000,,تمّ اعتباره ميتاً أخيراً \N!وحصلتُ على ماله المُختلس
Dialogue: 0,0:21:19.49,0:21:23.62,Default,,0000,0000,0000,,إذا تسرّب أنّه كان حيّاً، سواءً عانى\Nمن فقدان ذاكرة أم لا
Dialogue: 0,0:21:23.62,0:21:25.95,Default,,0000,0000,0000,,!سيجرون تحقيقاً بالتأكيد، وقد يأخذون المال كلّه
Dialogue: 0,0:21:27.49,0:21:32.46,Default,,0000,0000,0000,,لا تعبثوا معي، ذقتُ أنواع الألم والمضايقات\N...بسبب عملية اختلاسه
Dialogue: 0,0:21:32.90,0:21:34.92,Default,,0000,0000,0000,,!كان ذلك المال لي
Dialogue: 0,0:21:35.82,0:21:41.53,Default,,0000,0000,0000,,!أردتُ استرجاع وقتي، استرجاع حياتي
Dialogue: 0,0:21:43.47,0:21:48.38,Default,,0000,0000,0000,,،ستنعمين بالكثير من الوقت\Nوراء القضبان
Dialogue: 0,0:23:24.90,0:23:26.37,Default,,0000,0000,0000,,!غفوة أخرى جميلة
Dialogue: 0,0:23:27.11,0:23:31.28,Default,,0000,0000,0000,,كما يُتوقع منك يا أبي! حللتَ لغز\Nقضيّة شخص مفقود حتّى
Dialogue: 0,0:23:31.94,0:23:33.54,Default,,0000,0000,0000,,...ربما عليّ توكيلك أيضاً
Dialogue: 0,0:23:33.54,0:23:36.04,Default,,0000,0000,0000,,ماذا؟ هل هناك أحد مفقود؟
Dialogue: 0,0:23:36.86,0:23:37.82,Default,,0000,0000,0000,,...يراودني شعور سيّئ
Dialogue: 0,0:23:38.69,0:23:40.31,Default,,0000,0000,0000,,!إنّه ذاك الشخص
Dialogue: 0,0:23:40.31,0:23:43.17,Default,,0000,0000,0000,,شينتشي الهارب لن يرجع أبداً\Nما لم نبحث عنه
Dialogue: 0,0:23:43.64,0:23:44.66,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:23:45.06,0:23:49.74,Default,,0000,0000,0000,,أرفض! سيغطّي على ضياء\N!سمعتي اللامعة إذا رجع
Dialogue: 0,0:23:49.74,0:23:51.93,Default,,0000,0000,0000,,!فليبق مفقوداً للأبد
Dialogue: 0,0:23:56.24,0:23:57.92,Default,,0000,0000,0000,,تدرك الوضع على الأقل
Dialogue: 0,0:24:00.66,0:24:04.24,Default,,0000,0000,0000,,ما الذي تفعله يا شينا-كن؟\Nما قصّة تلك السيّارة؟
Dialogue: 0,0:24:05.28,0:24:08.48,Default,,0000,0000,0000,,!شينا-كن، ما بك؟ أجبني على الأقل
Dialogue: 0,0:24:15.82,0:24:18.28,Default,,0000,0000,0000,,...مينامي-تشان، مينامي-تشان قد
Dialogue: 0,0:24:18.28,0:24:19.48,Default,,0000,0000,0000,,!اختُطِفت
Dialogue: 0,0:24:20.05,0:24:23.76,Default,,0000,0000,0000,,!تبّاً! اختطاف أمام ناظري
Dialogue: 0,0:24:23.99,0:24:29.98,On Top,,0000,0000,0000,,قضيّة اختطاف الفنّانين الشهيرين\N(الجزء الأوّل)
Dialogue: 0,0:24:24.76,0:24:26.43,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.43,0:24:29.81,Default,,0000,0000,0000,,قضيّة اختطاف الفنّانين الشهيرين\N(الجزء الأوّل)
Dialogue: 0,0:24:45.65,0:24:47.72,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.72,0:24:49.72,Default,,0000,0000,0000,,"تو-ميكس"
Dialogue: 0,0:24:50.20,0:24:52.34,Default,,0000,0000,0000,,ستظهر تلك الفرقة الشهيرة في الحلقة القادمة
Dialogue: 0,0:24:52.34,0:24:54.43,Default,,0000,0000,0000,,كونان، ما علاقتك بـ تو-ميكس؟

