Dialogue: 0,0:00:01.43,0:00:02.78,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.78,0:00:05.79,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.79,0:00:08.78,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل مُتحرٍّ عظيم
Dialogue: 0,0:00:08.78,0:00:12.00,Default,,0000,0000,0000,,!قضيّة اليوم عن فدية! لن يشتري لك المال الحُب
Dialogue: 0,0:00:12.00,0:00:15.33,Default,,0000,0000,0000,,!حتّى لو كان الدليل تحت الماء، الحقيقة واحدة دوماً
Dialogue: 0,0:01:47.11,0:01:50.52,Default,,0000,0000,0000,,قضيّة فدية الاختطاف الزائفة
Dialogue: 0,0:02:16.80,0:02:20.35,Default,,0000,0000,0000,,اقترب الوقت، إيّاكم أن تبالغوا
Dialogue: 0,0:02:20.66,0:02:23.31,Default,,0000,0000,0000,,الأولوية هي لسلامة الرهينة
Dialogue: 0,0:02:25.23,0:02:27.99,Default,,0000,0000,0000,,لا يمكنني تصديق أنّ ابنة \Nالسيّد تاكي قد اُختطفت
Dialogue: 0,0:02:32.48,0:02:33.32,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:02:33.32,0:02:35.10,Default,,0000,0000,0000,,هل المال معك؟
Dialogue: 0,0:02:35.10,0:02:36.56,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:37.02,0:02:38.56,Default,,0000,0000,0000,,!أطلق سراح ناوكو
Dialogue: 0,0:02:38.56,0:02:40.74,Default,,0000,0000,0000,,انتظر، سأريك إيّاها الآن
Dialogue: 0,0:02:47.26,0:02:49.85,Default,,0000,0000,0000,,!ظهر المُختطف سيّدي المفتش\Nسيّارته عربة فان مصغّرة
Dialogue: 0,0:02:50.21,0:02:51.81,Default,,0000,0000,0000,,توقفت بالقرب
Dialogue: 0,0:02:56.59,0:02:57.64,Default,,0000,0000,0000,,!ناوكو
Dialogue: 0,0:02:59.79,0:03:01.06,Default,,0000,0000,0000,,سأجلب المال الآن
Dialogue: 0,0:03:03.08,0:03:05.96,Default,,0000,0000,0000,,انتظر، هناك أفراد شرطة مختبئون
Dialogue: 0,0:03:07.72,0:03:09.68,Default,,0000,0000,0000,,الصفقة ملغية
Dialogue: 0,0:03:10.89,0:03:12.85,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:03:13.24,0:03:14.40,Default,,0000,0000,0000,,!إنّه يهرب
Dialogue: 0,0:03:16.32,0:03:17.22,Default,,0000,0000,0000,,!هيّا
Dialogue: 0,0:04:00.56,0:04:03.59,Default,,0000,0000,0000,,لم يضغط المكابح واندفع نحو الماء
Dialogue: 0,0:04:06.10,0:04:10.76,Default,,0000,0000,0000,,كنتِ زميلةً للمُختطفة تاكي ناوكو إذاً؟
Dialogue: 0,0:04:11.26,0:04:12.31,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:15.09,0:04:17.19,Default,,0000,0000,0000,,...تاكي ناوكو
Dialogue: 0,0:04:18.46,0:04:20.86,Default,,0000,0000,0000,,بدت وحيدة دوماً
Dialogue: 0,0:04:21.87,0:04:24.69,Default,,0000,0000,0000,,...لكن، يستحيل أنّها استطاعت النجاة
Dialogue: 0,0:04:34.74,0:04:35.86,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:04:35.86,0:04:38.85,Default,,0000,0000,0000,,لم نجد جثّتها في قاع النهر أيضاً
Dialogue: 0,0:04:39.06,0:04:43.10,Default,,0000,0000,0000,,تيّار النهر سريع في هذه المنطقة فربما جرفها
Dialogue: 0,0:04:43.10,0:04:44.31,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:04:44.31,0:04:46.27,Default,,0000,0000,0000,,!ما قصدك بجثّتها؟
Dialogue: 0,0:04:47.09,0:04:51.43,Default,,0000,0000,0000,,!تركتُ كلّ شيءٍ بأيديكم لأنّي وثقت بالشرطة
Dialogue: 0,0:04:51.43,0:04:53.34,Default,,0000,0000,0000,,!والآن حدث هذا
Dialogue: 0,0:04:53.34,0:04:56.36,Default,,0000,0000,0000,,!أرجعوها! أرجعوا ناوكو
Dialogue: 0,0:04:58.96,0:05:04.81,Default,,0000,0000,0000,,،إن سقطت العربة من مقدمتها أوّلاً\Nفلمَ النوافذ الجانبية وحدها المحطمة؟
Dialogue: 0,0:05:07.24,0:05:08.39,Default,,0000,0000,0000,,مطرقة
Dialogue: 0,0:05:08.66,0:05:11.21,Default,,0000,0000,0000,,!كونان! أنتَ مُجدداً
Dialogue: 0,0:05:10.70,0:05:12.49,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:05:12.49,0:05:14.14,Default,,0000,0000,0000,,...يا إلهي، هذا الصبيّ
Dialogue: 0,0:05:14.78,0:05:17.09,Default,,0000,0000,0000,,لم يعد بإمكاني الوثوق بالشرطة
Dialogue: 0,0:05:17.61,0:05:20.65,Default,,0000,0000,0000,,لذا أريدك أن تمسك بالمجرم
Dialogue: 0,0:05:20.65,0:05:22.06,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:05:22.73,0:05:25.73,Default,,0000,0000,0000,,ستخبرك سكرتيرتي هاناي-كن بالتفاصيل{\i1}{\i0}
Dialogue: 0,0:05:25.73,0:05:27.63,Default,,0000,0000,0000,,اسمي هاناي أكيكو
Dialogue: 0,0:05:28.43,0:05:32.31,Default,,0000,0000,0000,,هلّا شرحتِ ظروف الاختطاف لنا؟
Dialogue: 0,0:05:32.31,0:05:35.72,Default,,0000,0000,0000,,ظروف؟
Dialogue: 0,0:05:35.72,0:05:39.13,Default,,0000,0000,0000,,كان يُفترض أن أشاهد مع ناوكو-تشان\Nفيلماً ذاك اليوم{\i1}{\i0}
Dialogue: 0,0:05:39.13,0:05:41.22,Default,,0000,0000,0000,,فذهبت للقائها
Dialogue: 0,0:05:41.22,0:05:45.19,Default,,0000,0000,0000,,لكن مضت عدّة ساعات ولم تظهر
Dialogue: 0,0:05:45.75,0:05:49.03,Default,,0000,0000,0000,,فشعرتِ بالقلق وبلّغتِ الشرطة؟
Dialogue: 0,0:05:49.03,0:05:54.24,Default,,0000,0000,0000,,كلا، أدركتُ أنّه كان اختطافاً
Dialogue: 0,0:05:54.24,0:05:56.10,Default,,0000,0000,0000,,.عندما اتّصل الخاطف بهاتفي
Dialogue: 0,0:05:56.62,0:06:01.23,Default,,0000,0000,0000,,أفترض أنّ الخاطف حذّرك من الاتصال بالشرطة، صحيح؟
Dialogue: 0,0:06:01.23,0:06:04.10,Default,,0000,0000,0000,,...لذا أخبرتُ الرئيس فوراً
Dialogue: 0,0:06:04.40,0:06:10.06,Default,,0000,0000,0000,,...كانت غلطتي! لو لم أقترح أن نشاهد الفيلم
Dialogue: 0,0:06:10.06,0:06:11.89,Default,,0000,0000,0000,,ران
Dialogue: 0,0:06:11.89,0:06:14.81,Default,,0000,0000,0000,,أتملك فكرةً عن هويّة الخاطف إذاً؟
Dialogue: 0,0:06:14.81,0:06:17.47,Default,,0000,0000,0000,,لو كنتُ أملك ما عيّنتُك
Dialogue: 0,0:06:17.80,0:06:20.09,Default,,0000,0000,0000,,دعني أعد صياغة كلامي
Dialogue: 0,0:06:20.09,0:06:23.43,Default,,0000,0000,0000,,أتعرف شخصاً يكنّ ضغينة تجاهك؟
Dialogue: 0,0:06:24.13,0:06:27.39,Default,,0000,0000,0000,,اعذرني، لكنّك مُغير شركات مشهور
Dialogue: 0,0:06:27.66,0:06:30.18,Default,,0000,0000,0000,,ألم تكوّن الكثير من الأعداء؟
Dialogue: 0,0:06:30.18,0:06:32.64,Default,,0000,0000,0000,,أداء العمّ يتحسن
Dialogue: 0,0:06:32.64,0:06:35.10,Default,,0000,0000,0000,,لا أتذكّر كل تفصيل في حياتي
Dialogue: 0,0:06:35.10,0:06:37.78,Default,,0000,0000,0000,,!اسمع! مجال الأعمال حرب
Dialogue: 0,0:06:37.78,0:06:39.53,Default,,0000,0000,0000,,!الخاسر غلطته هو
Dialogue: 0,0:06:39.53,0:06:41.39,Default,,0000,0000,0000,,فهمت؟
Dialogue: 0,0:06:41.39,0:06:44.35,Default,,0000,0000,0000,,يا إلهي، لا يجيد الردّ
Dialogue: 0,0:06:44.35,0:06:48.30,Default,,0000,0000,0000,,كانت غرفة أكيكو-سان في الطابق الثاني، صحيح؟{\i1}{\i0}
Dialogue: 0,0:06:48.30,0:06:50.14,Default,,0000,0000,0000,,كيف هي أكيكو-سان؟{\i1}{\i0}
Dialogue: 0,0:06:50.14,0:06:51.14,Default,,0000,0000,0000,,أبي
Dialogue: 0,0:06:51.89,0:06:56.84,Default,,0000,0000,0000,,اعتبرت ناوكو أكيكو-سان أختاً كبيرة لها حقاً
Dialogue: 0,0:06:56.84,0:06:59.09,Default,,0000,0000,0000,,قالت أنّها كأمٍّ لها أيضاً
Dialogue: 0,0:06:59.09,0:07:01.81,Default,,0000,0000,0000,,بما أنّ والدتها تُوفيت شابة
Dialogue: 0,0:07:03.55,0:07:04.63,Default,,0000,0000,0000,,أكيكو-سان{\i1}{\i0}
Dialogue: 0,0:07:05.76,0:07:06.89,Default,,0000,0000,0000,,!أكيكو-سان{\i1}{\i0}
Dialogue: 0,0:07:09.85,0:07:11.31,Default,,0000,0000,0000,,...أختاه
Dialogue: 0,0:07:13.16,0:07:14.77,Default,,0000,0000,0000,,...إنهما أنتما
Dialogue: 0,0:07:15.29,0:07:18.72,Default,,0000,0000,0000,,أأنتِ بخير؟ نادينا عليك عدّة مرات
Dialogue: 0,0:07:18.72,0:07:22.06,Default,,0000,0000,0000,,آسفة، تضرّر سمعي قليلاً
Dialogue: 0,0:07:23.40,0:07:25.35,Default,,0000,0000,0000,,...ماذا؟ إنّها
Dialogue: 0,0:07:25.65,0:07:28.30,Default,,0000,0000,0000,,هل فقدتما الأمل بشأن ناوكو-تشان أيضاً؟{\i1}{\i0}
Dialogue: 0,0:07:28.64,0:07:32.27,Default,,0000,0000,0000,,إنّها حيّة بالتأكيد، أؤمن بذلك
Dialogue: 0,0:07:38.09,0:07:41.80,Default,,0000,0000,0000,,لكنّهم بحثوا بعناية ولم يجدوها بعد
Dialogue: 0,0:07:41.80,0:07:42.81,Default,,0000,0000,0000,,...لعلّها
Dialogue: 0,0:07:50.91,0:07:52.68,Default,,0000,0000,0000,,...المسكينة
Dialogue: 0,0:07:54.69,0:07:56.31,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:07:56.74,0:07:59.70,Default,,0000,0000,0000,,ران-نيتشان، لنذهب لذاك الجانب
Dialogue: 0,0:07:59.70,0:08:01.26,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:08:01.26,0:08:03.86,Default,,0000,0000,0000,,ربما رأى أحدهم
Dialogue: 0,0:08:06.49,0:08:07.68,Default,,0000,0000,0000,,ذاك اليوم؟
Dialogue: 0,0:08:07.68,0:08:10.27,Default,,0000,0000,0000,,أحصل أيّ أمر غير مألوف؟
Dialogue: 0,0:08:10.27,0:08:14.44,Default,,0000,0000,0000,,يمكنك قول ذلك، طلبت الشرطة مساعدتنا في البحث
Dialogue: 0,0:08:14.44,0:08:17.43,Default,,0000,0000,0000,,ساعدتهم كلّ السفن في هذه المنطقة
Dialogue: 0,0:08:17.43,0:08:18.64,Default,,0000,0000,0000,,كلّها؟
Dialogue: 0,0:08:18.64,0:08:24.26,Default,,0000,0000,0000,,أجل، فمن أصل البحّارين التعاون \Nعند حصول مكروه
Dialogue: 0,0:08:24.26,0:08:28.18,Default,,0000,0000,0000,,...لكن ليس قائد الزورق السريع ذاك
Dialogue: 0,0:08:28.42,0:08:29.67,Default,,0000,0000,0000,,الزورق السريع؟
Dialogue: 0,0:08:29.67,0:08:34.64,Default,,0000,0000,0000,,...أجل، كاد يصطدم بسفينتي مباشرةً هنا
Dialogue: 0,0:08:41.24,0:08:45.78,Default,,0000,0000,0000,,لعلّه ثريّ ما يبحر عبثاً مع أثرياء آخرين
Dialogue: 0,0:08:45.78,0:08:48.26,Default,,0000,0000,0000,,ما كان نوع ذاك الزورق يا عمّ؟
Dialogue: 0,0:08:51.31,0:08:54.81,Default,,0000,0000,0000,,أهذا هو الزورق الذي كان يتكلم عنه؟
Dialogue: 0,0:08:54.81,0:08:58.82,Default,,0000,0000,0000,,!كونان-كن! لا يصحّ أن تصعد بلا إذن{\i1}{\i0}
Dialogue: 0,0:09:00.10,0:09:01.74,Default,,0000,0000,0000,,عدّة غوص؟
Dialogue: 0,0:09:02.81,0:09:07.26,Default,,0000,0000,0000,,يمكن أنّ الخاطف وتاكي ناوكو\Nلا يزالان على قيد الحياة
Dialogue: 0,0:09:10.72,0:09:15.83,Default,,0000,0000,0000,,لم يكن ذلك حادثاً، بل تعمد الخاطف الغوص
Dialogue: 0,0:09:15.83,0:09:17.64,Default,,0000,0000,0000,,كوسيلة للهرب
Dialogue: 0,0:09:30.64,0:09:32.81,Default,,0000,0000,0000,,كسر الخاطف النافذة الجانبية بمطرقة
Dialogue: 0,0:09:32.81,0:09:35.44,Default,,0000,0000,0000,,كان قد وضعها في السيّارة سلفاً
Dialogue: 0,0:09:35.44,0:09:38.35,Default,,0000,0000,0000,,ثمّ سبح للضفّة المعاكسة تحت الماء
Dialogue: 0,0:09:38.76,0:09:41.07,Default,,0000,0000,0000,,وصعد زورقاً سريعاً بانتظاره
Dialogue: 0,0:09:45.31,0:09:46.75,Default,,0000,0000,0000,,ثمّ لاذ بالفرار
Dialogue: 0,0:09:46.75,0:09:49.22,Default,,0000,0000,0000,,بينما كانت الشرطة مشغولةً بالعربة
Dialogue: 0,0:09:52.42,0:09:54.59,Default,,0000,0000,0000,,لكن لمَ يفعل ذلك؟
Dialogue: 0,0:09:54.59,0:09:57.58,Default,,0000,0000,0000,,ربما لإرباك الشرطة والإخلال بالتحقيق
Dialogue: 0,0:09:57.58,0:10:03.45,Default,,0000,0000,0000,,أوهمهم أنّه مات هو والرهينة
Dialogue: 0,0:10:03.45,0:10:05.39,Default,,0000,0000,0000,,...قد تكون هناك أسباب أخرى أيضاً
Dialogue: 0,0:10:09.85,0:10:14.07,Default,,0000,0000,0000,,ما لا أستطيع فهمه هو موضوع الرهينة تاكي ناوكو
Dialogue: 0,0:10:14.07,0:10:16.14,Default,,0000,0000,0000,,لم تظهر جثّتها
Dialogue: 0,0:10:16.14,0:10:19.55,Default,,0000,0000,0000,,وكانت عدّة الغوص التي وجدناها لشخصٍ واحد فقط
Dialogue: 0,0:10:20.01,0:10:23.52,Default,,0000,0000,0000,,كيف أخرجها الخاطف من العربة الغارقة؟
Dialogue: 0,0:10:23.52,0:10:27.51,Default,,0000,0000,0000,,أو ربما لم تكن فيها من البداية
Dialogue: 0,0:10:29.42,0:10:33.59,Default,,0000,0000,0000,,كلا، تمّت رؤيتها في الداخل
Dialogue: 0,0:10:33.59,0:10:34.76,Default,,0000,0000,0000,,كونان-كن{\i1}{\i0}
Dialogue: 0,0:10:36.13,0:10:38.51,Default,,0000,0000,0000,,ران-نيتشان، أوجدتِ شيئاً
Dialogue: 0,0:10:39.08,0:10:40.91,Default,,0000,0000,0000,,وفقاً لكلام المدير هنا
Dialogue: 0,0:10:40.91,0:10:45.87,Default,,0000,0000,0000,,تخلّى مالك الزورق عنه\Nولم يُستعمل مذ آنذاك
Dialogue: 0,0:10:45.87,0:10:48.68,Default,,0000,0000,0000,,ربما التبس عليه مع زورق آخر
Dialogue: 0,0:10:48.98,0:10:50.98,Default,,0000,0000,0000,,لا يمكن ذلك
Dialogue: 0,0:10:50.98,0:10:53.78,Default,,0000,0000,0000,,لكن كيف أثبت هذا؟
Dialogue: 0,0:10:54.73,0:10:56.84,Default,,0000,0000,0000,,!أُلغي التحقيق؟
Dialogue: 0,0:10:56.84,0:10:59.10,Default,,0000,0000,0000,,!لمَ؟! ما الذي يجري؟
Dialogue: 0,0:10:59.10,0:11:03.18,Default,,0000,0000,0000,,كيف لي أن أعرف؟ هو من قرّر إلغاءه
Dialogue: 0,0:11:03.18,0:11:04.73,Default,,0000,0000,0000,,أودّ أن أعرف بدوري
Dialogue: 0,0:11:05.72,0:11:08.76,Default,,0000,0000,0000,,فالأثرياء شحيحون
Dialogue: 0,0:11:08.76,0:11:13.14,Default,,0000,0000,0000,,لعلّه نادمٌ على إهدار ماله\Nعلى ابنته الميتة الآن
Dialogue: 0,0:11:13.14,0:11:15.48,Default,,0000,0000,0000,,كلا، ليست ميتة
Dialogue: 0,0:11:16.34,0:11:19.12,Default,,0000,0000,0000,,وما أدراك بذلك؟
Dialogue: 0,0:11:19.12,0:11:20.31,Default,,0000,0000,0000,,...في الواقع
Dialogue: 0,0:11:20.75,0:11:22.33,Default,,0000,0000,0000,,!أوافقه
Dialogue: 0,0:11:22.33,0:11:26.76,Default,,0000,0000,0000,,لا أريد التصديق أنّ ناوكو ميتة
Dialogue: 0,0:11:26.76,0:11:31.10,Default,,0000,0000,0000,,يا إلهي، يا لدلع الأطفال
Dialogue: 0,0:11:31.40,0:11:35.65,Default,,0000,0000,0000,,اسمعا، الأمر واضح إنّ فكرت برجاحة
Dialogue: 0,0:11:35.65,0:11:37.23,Default,,0000,0000,0000,,،وفقاً للظروف
Dialogue: 0,0:11:37.23,0:11:41.51,Default,,0000,0000,0000,,لا يمكن أنّ الرهينة أو الخاطف قد نجيا
Dialogue: 0,0:11:41.51,0:11:43.18,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:11:43.18,0:11:44.39,Default,,0000,0000,0000,,لكن
Dialogue: 0,0:11:44.39,0:11:47.89,Default,,0000,0000,0000,,كأنّه يهين سمعتك كمتحرٍّ عظيم هكذا
Dialogue: 0,0:11:49.30,0:11:51.63,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:11:51.63,0:11:52.85,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:11:55.76,0:11:56.72,Default,,0000,0000,0000,,ارحل
Dialogue: 0,0:11:57.16,0:12:00.22,Default,,0000,0000,0000,,ابنتي ناوكو ميتة
Dialogue: 0,0:12:01.08,0:12:04.04,Default,,0000,0000,0000,,يستحيل أن ترجع الآن
Dialogue: 0,0:12:04.04,0:12:05.44,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:12:09.55,0:12:12.90,Default,,0000,0000,0000,,هذا ما تريده، صحيح؟ أجر الإلغاء
Dialogue: 0,0:12:12.90,0:12:16.47,Default,,0000,0000,0000,,خذه واخرج
Dialogue: 0,0:12:16.73,0:12:20.89,Default,,0000,0000,0000,,!لا تعبث معي! يمكنك الاحتفاظ بمالك الوضيع
Dialogue: 0,0:12:20.89,0:12:22.59,Default,,0000,0000,0000,,!ران، لنذهب
Dialogue: 0,0:12:26.34,0:12:32.09,Default,,0000,0000,0000,,!تبّاً! أغاظني ذاك المُسن العفن حقاً
Dialogue: 0,0:12:32.09,0:12:34.91,Default,,0000,0000,0000,,...تذكّرت
Dialogue: 0,0:12:34.91,0:12:35.60,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:36.09,0:12:39.01,Default,,0000,0000,0000,,...تواعدتُ مع أصدقائي أن نلتقي
Dialogue: 0,0:12:39.01,0:12:39.67,Default,,0000,0000,0000,,!إلى اللقاء
Dialogue: 0,0:12:39.67,0:12:42.97,Default,,0000,0000,0000,,يا إلهي، حياة الأطفال المدللين هانئة حقاً
Dialogue: 0,0:12:47.24,0:12:49.85,Default,,0000,0000,0000,,تغيّر سلوكه سريعاً
Dialogue: 0,0:12:50.53,0:12:51.43,Default,,0000,0000,0000,,ارحل
Dialogue: 0,0:12:54.02,0:12:58.02,Default,,0000,0000,0000,,!لا شكّ، تواصل الخاطف معه
Dialogue: 0,0:13:08.77,0:13:11.28,Default,,0000,0000,0000,,!أستترك ناوكو-تشان تموت؟{\i1}{\i0}
Dialogue: 0,0:13:13.69,0:13:15.11,Default,,0000,0000,0000,,!سيّدي الرئيس
Dialogue: 0,0:13:15.48,0:13:18.39,Default,,0000,0000,0000,,،لو لم تجهز المال كاملاً هذه المرة حقاً
Dialogue: 0,0:13:18.39,0:13:21.55,Default,,0000,0000,0000,,!قد تُقتل ناوكو-تشان
Dialogue: 0,0:13:21.55,0:13:24.68,Default,,0000,0000,0000,,...لكننا لسنا متيقنين إن كانت حية حقاً
Dialogue: 0,0:13:24.68,0:13:27.09,Default,,0000,0000,0000,,!سيّدي الرئيس! انظر
Dialogue: 0,0:13:28.71,0:13:31.34,Default,,0000,0000,0000,,حتّى في الصورة التي أرسلها الخاطف
Dialogue: 0,0:13:31.34,0:13:34.45,Default,,0000,0000,0000,,!تحمل الصحيفة تاريخ الأمس
Dialogue: 0,0:13:36.88,0:13:37.98,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:13:43.32,0:13:48.27,Default,,0000,0000,0000,,!تؤمن ناوكو-تشان أنّك ستنقذها وتنتظرك
Dialogue: 0,0:13:48.73,0:13:50.07,Default,,0000,0000,0000,,!رئيس
Dialogue: 0,0:13:50.07,0:13:53.52,Default,,0000,0000,0000,,لو جمعت 500 مليون الآن\N،ثم فقدته نتيجة خطأ سخيف آخر
Dialogue: 0,0:13:53.52,0:13:57.85,Default,,0000,0000,0000,,!ستتبخر آخر صفقة لي
Dialogue: 0,0:13:57.85,0:13:59.32,Default,,0000,0000,0000,,!أتفهمين؟
Dialogue: 0,0:14:01.31,0:14:04.91,Default,,0000,0000,0000,,!المال أم ناوكو-تشان؟! أيّهما الأكثر أهمية؟{\i1}{\i0}
Dialogue: 0,0:14:04.91,0:14:06.89,Default,,0000,0000,0000,,!ناوكو بالطبع
Dialogue: 0,0:14:06.89,0:14:10.96,Default,,0000,0000,0000,,...لكن إن فشلت هذه الصفقة فشركتي سوف
Dialogue: 0,0:14:10.96,0:14:14.84,Default,,0000,0000,0000,,تفلس، صحيح؟ لا شكّ في ذلك
Dialogue: 0,0:14:14.84,0:14:17.55,Default,,0000,0000,0000,,من يهتم للشركة؟
Dialogue: 0,0:14:17.55,0:14:19.86,Default,,0000,0000,0000,,!لا بديل لحياة ناوكو-تشان{\i1}{\i0}
Dialogue: 0,0:14:19.86,0:14:24.74,Default,,0000,0000,0000,,!لكنّي بنيتُ هذه الشركة بعرق جبيني
Dialogue: 0,0:14:24.74,0:14:27.24,Default,,0000,0000,0000,,والعرق الذي سرقته من الآخرين
Dialogue: 0,0:14:27.24,0:14:28.11,Default,,0000,0000,0000,,!اخرسي
Dialogue: 0,0:14:29.03,0:14:32.19,Default,,0000,0000,0000,,!إغارة الشركات عمل شرعيّ تماماً
Dialogue: 0,0:14:33.69,0:14:37.03,Default,,0000,0000,0000,,!الضعاف يخسرون! واللوم عليهم فقط
Dialogue: 0,0:14:39.27,0:14:40.98,Default,,0000,0000,0000,,!ذاك العجوز
Dialogue: 0,0:14:44.85,0:14:45.66,Default,,0000,0000,0000,,!من هناك؟
Dialogue: 0,0:14:46.89,0:14:48.69,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:14:48.69,0:14:49.82,Default,,0000,0000,0000,,كونان-كن؟{\i1}{\i0}
Dialogue: 0,0:14:51.46,0:14:53.49,Default,,0000,0000,0000,,...كنتُ أبحث عن الحمام
Dialogue: 0,0:14:53.84,0:14:55.92,Default,,0000,0000,0000,,!هذه ممتلكات خاصة يا فتى
Dialogue: 0,0:14:55.92,0:14:59.95,Default,,0000,0000,0000,,لا تبح بالأمر لأحد رجاءً يا كونان-كن{\i1}{\i0}
Dialogue: 0,0:14:59.95,0:15:03.95,Default,,0000,0000,0000,,لو عرفت الشرطة فستُقتل ناوكو-تشان\N!هذه المرة حقاً{\i1}{\i0}
Dialogue: 0,0:15:04.87,0:15:06.91,Default,,0000,0000,0000,,حسناً، فهمت
Dialogue: 0,0:15:08.19,0:15:10.86,Default,,0000,0000,0000,,لا يمكننا تركه يذهب لفترة
Dialogue: 0,0:15:10.86,0:15:13.32,Default,,0000,0000,0000,,احتجزيه في غرفتك
Dialogue: 0,0:15:18.56,0:15:20.68,Default,,0000,0000,0000,,آسفة يا كونان-كن{\i1}{\i0}
Dialogue: 0,0:15:20.68,0:15:23.02,Default,,0000,0000,0000,,تحمّل لفترة
Dialogue: 0,0:15:23.02,0:15:26.20,Default,,0000,0000,0000,,أعدك أن نخرجك حالما تتم الصفقة
Dialogue: 0,0:15:26.20,0:15:29.09,Default,,0000,0000,0000,,ما الذي أخبركم به الخاطف؟
Dialogue: 0,0:15:29.09,0:15:30.15,Default,,0000,0000,0000,,كما قال سابقاً
Dialogue: 0,0:15:30.15,0:15:33.51,Default,,0000,0000,0000,,"جهّزوا 500 مليون بحلول الغد"
Dialogue: 0,0:15:33.51,0:15:34.54,Default,,0000,0000,0000,,ستدفعون؟
Dialogue: 0,0:15:35.88,0:15:38.11,Default,,0000,0000,0000,,...رأيتَ طبيعة الرئيس
Dialogue: 0,0:15:38.66,0:15:42.07,Default,,0000,0000,0000,,سيجمع المال إن كانت\Nناوكو-سان مهمةً له، صحيح؟
Dialogue: 0,0:15:42.84,0:15:46.03,Default,,0000,0000,0000,,!المال هو الشيء الوحيد المهم لذاك الرجل
Dialogue: 0,0:15:51.61,0:15:52.40,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:15:53.49,0:15:56.49,Default,,0000,0000,0000,,كان لديّ شقيق صغير يُدعى ماساهيتو
Dialogue: 0,0:15:56.49,0:15:57.73,Default,,0000,0000,0000,,كان؟
Dialogue: 0,0:15:57.73,0:16:00.93,Default,,0000,0000,0000,,أجل، مات قبل 4 أعوام
Dialogue: 0,0:16:03.27,0:16:04.36,Default,,0000,0000,0000,,كلا، بل قُتل
Dialogue: 0,0:16:05.48,0:16:07.74,Default,,0000,0000,0000,,كان لا يزال في عمرك تقريباً
Dialogue: 0,0:16:10.05,0:16:13.24,Default,,0000,0000,0000,,آسفة، دعني أحضنك لفترة
Dialogue: 0,0:16:24.37,0:16:27.07,Default,,0000,0000,0000,,سأجلب لك العشاء لاحقاً
Dialogue: 0,0:16:45.56,0:16:48.05,Default,,0000,0000,0000,,أتظن بإمكانك خداع الخاطف
Dialogue: 0,0:16:48.05,0:16:50.28,Default,,0000,0000,0000,,برزم صحفية كهذه؟
Dialogue: 0,0:16:51.01,0:16:54.20,Default,,0000,0000,0000,,اصمتي، هذا الخيار الوحيد الباقي
Dialogue: 0,0:17:05.07,0:17:06.42,Default,,0000,0000,0000,,...كونان-كن{\i1}{\i0}
Dialogue: 0,0:17:06.42,0:17:08.68,Default,,0000,0000,0000,,!ما الذي تفعلينه؟ سنذهب
Dialogue: 0,0:17:32.18,0:17:34.22,Default,,0000,0000,0000,,،بالتفكير بإمعان في الأمر
Dialogue: 0,0:17:34.22,0:17:37.71,Default,,0000,0000,0000,,لم يرَ أحد وجه تاكي ناوكو حقاً
Dialogue: 0,0:17:37.71,0:17:39.71,Default,,0000,0000,0000,,كان فمها ملفوفاً بشريط\Nوعلى عينيها عُصابة
Dialogue: 0,0:17:39.71,0:17:42.50,Default,,0000,0000,0000,,!لم يمكن رؤية وجهها بوضوح
Dialogue: 0,0:17:42.50,0:17:46.00,Default,,0000,0000,0000,,!كان الخاطف وحده في العربة من البداية
Dialogue: 0,0:17:46.00,0:17:48.94,Default,,0000,0000,0000,,!أجل! شخص لعب دور اثنين
Dialogue: 0,0:17:51.35,0:17:53.81,Default,,0000,0000,0000,,لم يشكّ أحد بأنّها لم تكن ناوكو
Dialogue: 0,0:17:53.81,0:17:56.27,Default,,0000,0000,0000,,لا عجب، فقد كانت بعيدة
Dialogue: 0,0:17:56.27,0:17:58.74,Default,,0000,0000,0000,,وافترض الجميع أنّها ناوكو وحسب
Dialogue: 0,0:18:04.97,0:18:07.84,Default,,0000,0000,0000,,انتظر، هناك أفراد شرطة مختبئون
Dialogue: 0,0:18:07.84,0:18:09.39,Default,,0000,0000,0000,,الصفقة ملغية
Dialogue: 0,0:18:10.04,0:18:13.17,Default,,0000,0000,0000,,كان الخاطف يحيط علماً بتحركات الشرطة سلفاً
Dialogue: 0,0:18:13.17,0:18:14.75,Default,,0000,0000,0000,,لا عجب
Dialogue: 0,0:18:14.75,0:18:17.58,Default,,0000,0000,0000,,!فقد كان بقرب تاكي-سان دوماً{\i1}{\i0}
Dialogue: 0,0:18:24.24,0:18:26.71,Default,,0000,0000,0000,,آثار ساعة الغوص على معصمها
Dialogue: 0,0:18:27.78,0:18:29.90,Default,,0000,0000,0000,,وخطّ السُمرة من ارتداء بذلة الغوص
Dialogue: 0,0:18:29.90,0:18:33.44,Default,,0000,0000,0000,,كما ما فعلتْه آنذاك
Dialogue: 0,0:18:33.44,0:18:36.56,Default,,0000,0000,0000,,تقنية فتح انسداد أذن\N!يعرفها كلّ غوّاص
Dialogue: 0,0:18:36.56,0:18:41.68,Default,,0000,0000,0000,,لا بدّ أنها أصابت أذنيها\N!عندما قفزت للماء فجأةً
Dialogue: 0,0:18:42.80,0:18:46.72,Default,,0000,0000,0000,,!ما الذي يجري؟! مرّ الوقت المتفق عليه
Dialogue: 0,0:18:46.72,0:18:49.23,Default,,0000,0000,0000,,الخاطف هنا، منذ فترة
Dialogue: 0,0:18:52.75,0:18:55.42,Default,,0000,0000,0000,,!ما الذي تفعلينه يا حمقاء؟
Dialogue: 0,0:18:55.42,0:18:57.60,Default,,0000,0000,0000,,!كدتِ تلوين كاحلي
Dialogue: 0,0:18:57.92,0:19:00.20,Default,,0000,0000,0000,,ذاك لا شيء
Dialogue: 0,0:19:00.20,0:19:02.55,Default,,0000,0000,0000,,مقارنةً بالألم الذي ألحقتَه بعائلتي
Dialogue: 0,0:19:03.66,0:19:05.28,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:19:05.28,0:19:08.16,Default,,0000,0000,0000,,لا تذكر هذا المكان؟
Dialogue: 0,0:19:09.90,0:19:12.47,Default,,0000,0000,0000,,إنّها بقايا شركة استوليتَ عليها
Dialogue: 0,0:19:13.06,0:19:15.06,Default,,0000,0000,0000,,...ماذا؟ أتقصدين أنّك
Dialogue: 0,0:19:15.06,0:19:15.43,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:19:16.90,0:19:20.97,Default,,0000,0000,0000,,أنا ابنة رئيس الشركة الراحل
Dialogue: 0,0:19:20.97,0:19:26.55,Default,,0000,0000,0000,,انتحر أبي وأخذ أمّي وشقيقي معه
Dialogue: 0,0:19:26.55,0:19:29.31,Default,,0000,0000,0000,,تاركاً إيّاي
Dialogue: 0,0:19:29.31,0:19:31.25,Default,,0000,0000,0000,,كنتُ طالبةً جامعية آنذاك
Dialogue: 0,0:19:31.25,0:19:34.72,Default,,0000,0000,0000,,تبنّاني أقارب لي وغيّرتُ اسمي الأخير
Dialogue: 0,0:19:35.09,0:19:38.42,Default,,0000,0000,0000,,ثمّ انضممت لشركتك
Dialogue: 0,0:19:38.42,0:19:40.64,Default,,0000,0000,0000,,منتظرةً فرصة انتقام بالطبع
Dialogue: 0,0:19:42.74,0:19:46.62,Default,,0000,0000,0000,,لو كنتَ تحب ناوكو-تشان بما يكفي\Nلتجهيز المال فحسب
Dialogue: 0,0:19:46.62,0:19:48.27,Default,,0000,0000,0000,,كنتُ لتركتُك حيّاً
Dialogue: 0,0:19:52.94,0:19:55.02,Default,,0000,0000,0000,,ما-ما الذي تنوين فعله؟
Dialogue: 0,0:19:55.86,0:19:57.13,Default,,0000,0000,0000,,قتلك
Dialogue: 0,0:20:05.01,0:20:06.02,Default,,0000,0000,0000,,!بنزين؟
Dialogue: 0,0:20:06.68,0:20:07.39,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:20:11.26,0:20:14.09,Default,,0000,0000,0000,,!انتظري! أنا آسف! سأدفع لك ما تشائين
Dialogue: 0,0:20:14.09,0:20:14.97,Default,,0000,0000,0000,,!لا تفعليها فقط
Dialogue: 0,0:20:15.88,0:20:18.96,Default,,0000,0000,0000,,خُذ مالك معك للجحيم
Dialogue: 0,0:20:20.29,0:20:21.54,Default,,0000,0000,0000,,وداعاً
Dialogue: 0,0:20:21.54,0:20:22.80,Default,,0000,0000,0000,,!لا تفعلي
Dialogue: 0,0:20:26.29,0:20:27.52,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:20:27.87,0:20:29.97,Default,,0000,0000,0000,,!لا قيمة لقتل ذاك الرجل
Dialogue: 0,0:20:29.97,0:20:32.03,Default,,0000,0000,0000,,!لا قيمة لإبقائه حيّاً أيضاً
Dialogue: 0,0:20:32.03,0:20:33.43,Default,,0000,0000,0000,,!واجبي تخليص العالم منه
Dialogue: 0,0:20:33.43,0:20:36.89,Default,,0000,0000,0000,,أتريدين أن تجعلي ناوكو-سان\N!تمرّ بما مررتِ به؟{\i1}{\i0}
Dialogue: 0,0:20:38.32,0:20:42.43,Default,,0000,0000,0000,,!ذاك الرجل عائلتها الوحيدة
Dialogue: 0,0:20:46.47,0:20:48.77,Default,,0000,0000,0000,,يجب أن تعي أكثر من غيرك
Dialogue: 0,0:20:48.77,0:20:51.14,Default,,0000,0000,0000,,ألم فقدان العائلة
Dialogue: 0,0:20:54.42,0:20:58.56,Default,,0000,0000,0000,,حتّى لو أخذتِ بانتقامك، أشكّ أن شقيقك سيسعد
Dialogue: 0,0:21:13.36,0:21:14.60,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:21:18.78,0:21:19.84,Default,,0000,0000,0000,,...ماساهيتو
Dialogue: 0,0:23:06.54,0:23:10.89,Default,,0000,0000,0000,,كانت تاكي ناوكو مُحتجزةً\Nفي الطابق السفلي للمصنع القديم
Dialogue: 0,0:23:10.89,0:23:13.07,Default,,0000,0000,0000,,وتمّ إنقاذها بسلام
Dialogue: 0,0:23:13.07,0:23:16.07,Default,,0000,0000,0000,,يبدو أنّها كانت محيطةً علماً بالظروف
Dialogue: 0,0:23:16.07,0:23:18.74,Default,,0000,0000,0000,,مُذ اُحتجزت بدايةً
Dialogue: 0,0:23:19.73,0:23:22.43,Default,,0000,0000,0000,,!ناوكو! أنتِ بأمان
Dialogue: 0,0:23:22.81,0:23:24.81,Default,,0000,0000,0000,,!أكيكو-سان
Dialogue: 0,0:23:26.52,0:23:27.65,Default,,0000,0000,0000,,!أكيكو-سان
Dialogue: 0,0:23:31.26,0:23:34.80,Default,,0000,0000,0000,,آسفة على توريطك يا ناوكو-تشان
Dialogue: 0,0:23:38.55,0:23:39.46,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:24:07.67,0:24:09.42,Default,,0000,0000,0000,,لا يمكنني الجزم بعد
Dialogue: 0,0:24:09.42,0:24:11.58,Default,,0000,0000,0000,,لكن إن هاجم دون سبب حقاً
Dialogue: 0,0:24:11.58,0:24:13.66,Default,,0000,0000,0000,,كما قالت
Dialogue: 0,0:24:13.66,0:24:15.54,Default,,0000,0000,0000,,سيُقتل قتلاً رحيماً غالباً
Dialogue: 0,0:24:16.58,0:24:20.82,Default,,0000,0000,0000,,أرجوك يا شينتشي، ارجع
Dialogue: 0,0:24:20.82,0:24:24.08,Default,,0000,0000,0000,,أنتَ الوحيد القادر على إنقاذ جون
Dialogue: 0,0:24:25.32,0:24:26.78,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.78,0:24:29.28,Default,,0000,0000,0000,,جريمة قتل الكلب جون
Dialogue: 0,0:24:46.09,0:24:48.09,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.09,0:24:49.64,Default,,0000,0000,0000,,ردّة فعل لوضع
Dialogue: 0,0:24:49.64,0:24:51.64,Default,,0000,0000,0000,,

