Dialogue: 0,0:00:02.11,0:00:03.74,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مذنّب لامع
Dialogue: 0,0:00:03.74,0:00:06.81,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.24,0:00:08.82,Default,,0000,0000,0000,,!"قضيّة اليوم عن "تسلّق جبال
Dialogue: 0,0:00:08.82,0:00:10.77,Default,,0000,0000,0000,,!ارجع للقاموس وسترى صعود جبال متعرّج
Dialogue: 0,0:00:10.77,0:00:12.39,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.39,0:00:14.10,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.10,0:00:16.31,Default,,0000,0000,0000,,اسمه المتحرّي كونان
Dialogue: 0,0:02:15.87,0:02:23.01,On Top,,0000,0000,0000,,!حادث حافلة! موت طالبة روضة\N!مقتل رئيس شركة تنفيذي
Dialogue: 0,0:02:17.16,0:02:19.07,Default,,0000,0000,0000,,،قُتل الرئيس التنفيذي لشركة إقراض عاجل
Dialogue: 0,0:02:19.07,0:02:23.01,Default,,0000,0000,0000,,وتُوفيت طفلة عندما علقت\Nحافلة مدرسية في الحادث
Dialogue: 0,0:02:23.40,0:02:25.98,Default,,0000,0000,0000,,تمّ اعتقال الرجل الذي\N!طلب عملية القتل
Dialogue: 0,0:02:25.98,0:02:28.22,Default,,0000,0000,0000,,يبدو أنّه كان يكنّ ضغينةً بسبب الديون
Dialogue: 0,0:02:29.15,0:02:33.93,Default,,0000,0000,0000,,كان مُنفّذ الجريمة هو قاتل مأجور\Nمجهول الهويّة يُدعى الثعلب
Dialogue: 0,0:02:34.55,0:02:37.89,Default,,0000,0000,0000,,لم تثمر التحقيقات، ويبقى مكانه مجهولاً
Dialogue: 0,0:02:38.73,0:02:44.77,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل تسلّق الجبال المخيفة\N(الجزء الأوّل)
Dialogue: 0,0:02:39.72,0:02:43.34,Default,,0000,0000,0000,,جريمة قتل تسلّق الجبال المخيفة\N(الجزء الأوّل)
Dialogue: 0,0:02:48.25,0:02:51.83,Default,,0000,0000,0000,,أنا في موقع الحادث الذي تُوفيت\Nفيه طفلة الروضة قبل 6 أشهر
Dialogue: 0,0:02:51.83,0:02:55.30,Default,,0000,0000,0000,,...لا يزال الفاعل الثعلب طليقاً، والشرطة
Dialogue: 0,0:02:55.74,0:02:58.51,Default,,0000,0000,0000,,أبي، لديك عميل
Dialogue: 0,0:02:58.95,0:03:00.10,Default,,0000,0000,0000,,!عميل
Dialogue: 0,0:03:01.90,0:03:04.98,Default,,0000,0000,0000,,اصمتي... لا تصرخي
Dialogue: 0,0:03:04.98,0:03:07.10,Default,,0000,0000,0000,,لقد دخل بالفعل
Dialogue: 0,0:03:11.22,0:03:13.63,Default,,0000,0000,0000,,أعتذر على الظهور فجأةً
Dialogue: 0,0:03:13.63,0:03:16.18,Default,,0000,0000,0000,,...لا مشكلة
Dialogue: 0,0:03:18.60,0:03:22.30,Default,,0000,0000,0000,,أ-أجد القاتل المأجور\N!وأردعه عن القتل؟
Dialogue: 0,0:03:24.22,0:03:25.34,Default,,0000,0000,0000,,،قد لا يظهر ذلك عليّ
Dialogue: 0,0:03:25.34,0:03:30.18,Default,,0000,0000,0000,,لكنّي رئيس فرع وكالة عقارات في كانساي
Dialogue: 0,0:03:30.32,0:03:35.47,CharCard,,0000,0000,0003,,{\fad(300,200)} (أوشيو بونزو (40\Nرئيس فرع لوكالة عقارات
Dialogue: 0,0:03:30.70,0:03:32.29,On Top,,0000,0000,0000,,عندما خضتُ الفحص الطبّي
Dialogue: 0,0:03:32.29,0:03:33.58,On Top,,0000,0000,0000,,للشركة قبل خمسة أيام
Dialogue: 0,0:03:33.58,0:03:36.89,On Top,,0000,0000,0000,,أخطؤوا باعتقاد أنّ محض قرحة\N!كانت سرطان معدة
Dialogue: 0,0:03:37.24,0:03:41.11,Default,,0000,0000,0000,,سمعتُ كلام الطبيب والممرضة
Dialogue: 0,0:03:41.11,0:03:44.84,Default,,0000,0000,0000,,!وصُدمت كثيراً عندما قالا أنّه سرطان
Dialogue: 0,0:03:45.36,0:03:50.30,Default,,0000,0000,0000,,أيمكن أنّك عيّنت قاتلاً مأجوراً لقتلك؟
Dialogue: 0,0:03:50.85,0:03:52.26,Default,,0000,0000,0000,,أجل، الثعلب
Dialogue: 0,0:03:52.26,0:03:53.97,Default,,0000,0000,0000,,!الثعلب؟
Dialogue: 0,0:03:59.02,0:04:05.76,Default,,0000,0000,0000,,لكنّي أدركت الخطأ بعدما استعملت\Nعلاقاتي الواسعة في العمل
Dialogue: 0,0:04:05.76,0:04:08.47,Default,,0000,0000,0000,,للتواصل معه
Dialogue: 0,0:04:09.71,0:04:11.16,Default,,0000,0000,0000,,كان تحويل المال قد تمّ
Dialogue: 0,0:04:11.16,0:04:16.80,Default,,0000,0000,0000,,وعناوين الإنترنت التي يستعملها للتواصل قد أُغلقت
Dialogue: 0,0:04:17.41,0:04:21.07,Default,,0000,0000,0000,,حتّى لو استطعتُ التواصل معه، فسيكون ذلك بعد شهر
Dialogue: 0,0:04:21.07,0:04:25.26,Default,,0000,0000,0000,,أي لا أستطيع الوصول له\N!بينما يسعى لقتلي
Dialogue: 0,0:04:25.82,0:04:30.77,Default,,0000,0000,0000,,فهمت، لذا لجأتَ للمتحرّي العظيم موري كوغورو
Dialogue: 0,0:04:30.77,0:04:33.68,Default,,0000,0000,0000,,لكن أأنت جاد؟
Dialogue: 0,0:04:33.68,0:04:35.97,Default,,0000,0000,0000,,لا توجد كاميرا مخفيّة في الجوار، صحيح؟
Dialogue: 0,0:04:35.97,0:04:39.35,Default,,0000,0000,0000,,!أيّها المتحرّي! أتقصد أنّك لا تستطيع الوثوق بي؟
Dialogue: 0,0:04:39.35,0:04:40.55,Default,,0000,0000,0000,,!أجل... لا
Dialogue: 0,0:04:43.63,0:04:44.59,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,0:04:45.76,0:04:47.39,Default,,0000,0000,0000,,!رصاصات! انخفضوا
Dialogue: 0,0:04:53.16,0:04:55.16,Default,,0000,0000,0000,,...ذاك الثعلب الوغد
Dialogue: 0,0:05:04.34,0:05:06.26,Default,,0000,0000,0000,,تبّاً! هرب؟
Dialogue: 0,0:05:07.28,0:05:09.26,Default,,0000,0000,0000,,يبدو أنّ الوضع بخيرٍ الآن
Dialogue: 0,0:05:10.35,0:05:11.72,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:05:12.02,0:05:15.29,Default,,0000,0000,0000,,محفظة كبيرة! ما هذا؟
Dialogue: 0,0:05:16.81,0:05:18.10,Default,,0000,0000,0000,,!لا شيء
Dialogue: 0,0:05:19.97,0:05:21.01,Default,,0000,0000,0000,,ما كان ذلك؟
Dialogue: 0,0:05:22.43,0:05:26.18,Default,,0000,0000,0000,,هذا سيّئ، لنتّصل بالشرطة بأيّ حال
Dialogue: 0,0:05:26.18,0:05:27.22,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:05:27.63,0:05:32.01,Default,,0000,0000,0000,,!قد أكون الهدف، لكنّي من عيّن القاتل
Dialogue: 0,0:05:32.01,0:05:34.04,Default,,0000,0000,0000,,!لن يرضوا بذلك
Dialogue: 0,0:05:34.04,0:05:36.18,Default,,0000,0000,0000,,!لن نلجأ للشرطة
Dialogue: 0,0:05:36.83,0:05:41.09,Default,,0000,0000,0000,,!أرجوك! سأدفع تكاليف إصلاح النافذة
Dialogue: 0,0:05:41.86,0:05:43.80,Default,,0000,0000,0000,,لا بأس، سأقبل القضيّة
Dialogue: 0,0:05:44.49,0:05:46.01,Default,,0000,0000,0000,,!حقّاً أيّها المتحرّي؟
Dialogue: 0,0:05:46.57,0:05:49.69,Default,,0000,0000,0000,,سيمسك المتحرّي العظيم موري كوغورو بالثعلب المميت
Dialogue: 0,0:05:49.69,0:05:53.31,Default,,0000,0000,0000,,!الذي سبّب الكثير من العناء للشرطة
Dialogue: 0,0:05:53.31,0:05:54.47,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:05:54.56,0:05:57.06,Default,,0000,0000,0000,,هل سيكون هذا بخير؟
Dialogue: 0,0:05:57.06,0:05:59.56,Default,,0000,0000,0000,,لكن كيف ستمسك بالثعلب؟
Dialogue: 0,0:05:59.56,0:06:01.42,Default,,0000,0000,0000,,لا تعرف كيف يبدو، صحيح؟
Dialogue: 0,0:06:01.76,0:06:03.97,Default,,0000,0000,0000,,لا قلق حيال ذلك
Dialogue: 0,0:06:03.97,0:06:06.89,Default,,0000,0000,0000,,في الواقع، ألزمتُ الثعلب بشرط
Dialogue: 0,0:06:07.55,0:06:12.34,Default,,0000,0000,0000,,طلبت منه قتلي بينما أنا في إحدى\Nرحلات تسلّقي للجبال التي أهواها
Dialogue: 0,0:06:12.79,0:06:13.88,Default,,0000,0000,0000,,تسلّق الجبال؟
Dialogue: 0,0:06:13.88,0:06:16.05,Default,,0000,0000,0000,,أتقصد حيث تمشي على حافة الجبال؟
Dialogue: 0,0:06:18.07,0:06:21.77,Default,,0000,0000,0000,,،إذا كان قتله أثناء تسلّق الجبال شرطاً\Nفما كان هذا الهجوم؟
Dialogue: 0,0:06:23.27,0:06:28.72,Default,,0000,0000,0000,,المكان خطر قرب النافذة، لنتكلّم هنا
Dialogue: 0,0:06:28.72,0:06:29.37,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:06:30.10,0:06:33.07,Default,,0000,0000,0000,,...يخفي هذا الرجل شيئاً
Dialogue: 0,0:06:34.22,0:06:40.17,CharCard,,0000,0000,0010,,{\fad(300,100)} جبال تانبارا
Dialogue: 0,0:06:35.30,0:06:42.28,On Top,,0000,0000,0000,,في اليوم التالي، ذهبنا في رحلة تسلّق \Nلسلسلة جبال تانبارا
Dialogue: 0,0:06:44.00,0:06:45.66,Default,,0000,0000,0000,,!شعورٌ جميل
Dialogue: 0,0:06:45.66,0:06:47.83,Default,,0000,0000,0000,,!التقط صورةً يا كونان-كن
Dialogue: 0,0:06:47.83,0:06:51.49,Default,,0000,0000,0000,,سينفد الفيلم قبل أن \Nنصعد الجبل حتّى يا ران-نيتشان
Dialogue: 0,0:06:51.49,0:06:55.28,Default,,0000,0000,0000,,!لا تقلق، لنأخذ صورة معاً
Dialogue: 0,0:06:55.28,0:06:56.74,Default,,0000,0000,0000,,!التقط صورتنا يا أبي
Dialogue: 0,0:06:57.57,0:07:00.50,Default,,0000,0000,0000,,!يا إلهي! لم نأت هنا للهو
Dialogue: 0,0:07:01.69,0:07:03.36,Default,,0000,0000,0000,,هاك يا أبي
Dialogue: 0,0:07:04.23,0:07:06.70,Default,,0000,0000,0000,,أنتما! تفهمان ما نفعله، صحيح؟
Dialogue: 0,0:07:07.35,0:07:13.27,Default,,0000,0000,0000,,بالطبع! أتينا لجعلك تبدو\Nمتسلّق جبليّ عاديّ
Dialogue: 0,0:07:13.27,0:07:17.88,Default,,0000,0000,0000,,مما يعني أنّنا سنبدو مريبين إذا \Nلم نلتقط صوراً
Dialogue: 0,0:07:17.88,0:07:19.21,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:07:19.21,0:07:20.37,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:07:24.30,0:07:27.58,Default,,0000,0000,0000,,بعد ذلك، ملأنا استمارات التسلّق الجبلي
Dialogue: 0,0:07:27.58,0:07:30.20,Default,,0000,0000,0000,,في المكتب في سفح الجبل
Dialogue: 0,0:07:30.20,0:07:34.25,Default,,0000,0000,0000,,أرسلوا أرقام وأسماء المتنزهين\Nبالفاكس إلى كوخ جبليّ
Dialogue: 0,0:07:34.25,0:07:38.37,Default,,0000,0000,0000,,كي يحضّروا وجباتنا وما إلى ذلك\Nقبل أن نبيت هناك
Dialogue: 0,0:07:39.15,0:07:42.19,Default,,0000,0000,0000,,!إذاً... ها هو، الكوخ الجبليّ
Dialogue: 0,0:07:42.19,0:07:44.15,Default,,0000,0000,0000,,سنبيت هنا
Dialogue: 0,0:07:44.15,0:07:47.31,Default,,0000,0000,0000,,!إنّه مسار للخبراء، فعليك التحضّر
Dialogue: 0,0:07:47.31,0:07:48.73,Default,,0000,0000,0000,,أنتِ أيضاً يا ران-نيتشان
Dialogue: 0,0:07:48.73,0:07:50.85,Default,,0000,0000,0000,,ما نبرتك هذه؟
Dialogue: 0,0:07:50.85,0:07:53.00,Default,,0000,0000,0000,,مرحباً! أهذه أوّل مرة لكم؟
Dialogue: 0,0:07:53.48,0:07:56.76,On Top,,0000,0000,0000,,اسمي هيراي، أنا عضوٌ في نادي\Nصعود الجبال في جامعتي
Dialogue: 0,0:07:53.48,0:07:58.52,CharCard,,0000,0000,0004,,{\fad(300,200)} (22) هيراي كينيتشي \Nنادي صعود الجبال لجامعة توتو
Dialogue: 0,0:07:56.76,0:07:58.76,On Top,,0000,0000,0000,,آتي هنا كلّ عام
Dialogue: 0,0:07:58.76,0:08:00.21,On Top,,0000,0000,0000,,فيمكنكم الاعتماد عليّ
Dialogue: 0,0:08:00.55,0:08:02.92,Default,,0000,0000,0000,,!حسناً! شكراً جزيلاً
Dialogue: 0,0:08:02.92,0:08:06.12,Default,,0000,0000,0000,,...مهلك، قد يكون الثعلب
Dialogue: 0,0:08:06.46,0:08:10.91,Default,,0000,0000,0000,,!اسمي ران! وهذا أخي الصغير كونان
Dialogue: 0,0:08:10.91,0:08:11.58,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:08:12.12,0:08:14.46,Default,,0000,0000,0000,,وهذا أبي
Dialogue: 0,0:08:14.46,0:08:17.95,Default,,0000,0000,0000,,...أنا من طوكيو، اسمي موري
Dialogue: 0,0:08:17.95,0:08:19.07,Default,,0000,0000,0000,,!أقصد مورياما
Dialogue: 0,0:08:19.07,0:08:22.95,Default,,0000,0000,0000,,أنا أوشيو من كانساي! هلّا أضفتموني معكم؟
Dialogue: 0,0:08:22.95,0:08:23.92,Default,,0000,0000,0000,,!سُررنا بلقائك
Dialogue: 0,0:08:24.49,0:08:27.91,Default,,0000,0000,0000,,!لنكن على وفاق جميعاً إذاً
Dialogue: 0,0:08:28.48,0:08:31.83,Default,,0000,0000,0000,,أعمل لوكالة عقارات، ماذا عنك؟
Dialogue: 0,0:08:32.06,0:08:35.45,On Top,,0000,0000,0000,,ما-ما أهميّة ذلك؟
Dialogue: 0,0:08:32.09,0:08:35.38,CharCard,,0000,0000,0004,,{\fad(300,200)}  (50) تاكاناشي واتارو\Nإداريّ في شركة
Dialogue: 0,0:08:40.93,0:08:43.58,Default,,0000,0000,0000,,بالنظر لهذه الغيوم، قد يتغيّر الطقس
Dialogue: 0,0:08:44.43,0:08:47.41,Default,,0000,0000,0000,,سأتّصل بالكوخ الجبليّ
Dialogue: 0,0:08:47.87,0:08:50.92,Default,,0000,0000,0000,,أهو مهتمٌ بك؟
Dialogue: 0,0:08:53.29,0:08:55.91,Default,,0000,0000,0000,,الثعلب أعسر وفقما يبدو
Dialogue: 0,0:08:56.41,0:08:58.91,Default,,0000,0000,0000,,رمى كلّ سكاكينه بيده اليسرى
Dialogue: 0,0:08:59.57,0:09:01.66,Default,,0000,0000,0000,,انظر لذاك الرجل
Dialogue: 0,0:09:02.45,0:09:03.88,Default,,0000,0000,0000,,!إنّه أيسر
Dialogue: 0,0:09:03.88,0:09:04.63,Default,,0000,0000,0000,,!بالفعل
Dialogue: 0,0:09:05.23,0:09:09.33,Default,,0000,0000,0000,,الجدّ؟ أنا هيراي، سأبيت الليلة أيضاً
Dialogue: 0,0:09:09.90,0:09:15.12,Default,,0000,0000,0000,,المعذرة، كان اسمك مورياما-سان؟\Nهل التقينا قبلاً؟
Dialogue: 0,0:09:15.55,0:09:19.08,On Top,,0000,0000,0000,,أنا نوسي شينغو، روائيّ
Dialogue: 0,0:09:15.64,0:09:19.38,CharCard,,0000,0000,0004,,{\fad(300,0)}  (35) نوسي شينغو\Nروائيّ
Dialogue: 0,0:09:19.68,0:09:25.03,Default,,0000,0000,0000,,أيمكن أنّك نوسي شينغو-سان الذي\Nألّف "قضيّة لغز الحسناء فاقدة الذاكرة"؟
Dialogue: 0,0:09:25.58,0:09:29.38,Default,,0000,0000,0000,,!يسرّني لقاء أحد قرّائي المعدودين
Dialogue: 0,0:09:29.38,0:09:31.38,Default,,0000,0000,0000,,قرأتها أيضاً يا كونان-كن، صحيح؟
Dialogue: 0,0:09:31.38,0:09:32.25,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:32.92,0:09:36.74,Default,,0000,0000,0000,,كانت عن قاتلة فقدت ذاكرتها وفقما أذكر
Dialogue: 0,0:09:36.74,0:09:38.95,Default,,0000,0000,0000,,...كانت الحيلة سخيفة
Dialogue: 0,0:09:38.95,0:09:41.33,Default,,0000,0000,0000,,!لم يفتنا التسجيل بعد، صحيح؟
Dialogue: 0,0:09:41.33,0:09:43.39,Default,,0000,0000,0000,,!لتضفنا أيضاً رجاءً
Dialogue: 0,0:09:44.81,0:09:47.24,Default,,0000,0000,0000,,يبدو أنّها ستكون مجموعة كبيرة
Dialogue: 0,0:09:47.69,0:09:49.69,On Top,,0000,0000,0000,,لا نعرف الطريق
Dialogue: 0,0:09:47.79,0:09:52.01,CharCard,,0000,0000,0004,,{\fad(300,0)}(سايغوسا كيوكو (25\Nمتسلقة جبلية
Dialogue: 0,0:09:49.69,0:09:51.66,On Top,,0000,0000,0000,,فأرجو ألّا تمانعوا اصطحابنا
Dialogue: 0,0:09:51.94,0:09:54.00,Default,,0000,0000,0000,,أهلاً بكما
Dialogue: 0,0:09:54.00,0:09:58.26,Default,,0000,0000,0000,,بالمناسبة، لا نعرف جنس الثعلب
Dialogue: 0,0:09:58.26,0:09:59.95,Default,,0000,0000,0000,,قد يكون امرأة
Dialogue: 0,0:10:00.72,0:10:04.91,On Top,,0000,0000,0000,,!نعتذر على الإطالة، أنا كاوابي\Nيسرّنا لقاؤكما
Dialogue: 0,0:10:01.25,0:10:05.25,CharCard,,0000,0000,0004,,{\fad(300,0)}(كاوابي أكيرا (28\Nمتنزّه جبلي
Dialogue: 0,0:10:06.04,0:10:08.91,Default,,0000,0000,0000,,وهكذا بدأ تسلّق الجبال
Dialogue: 0,0:10:09.58,0:10:14.08,Default,,0000,0000,0000,,بافتراض أنّ الثعلب سيهاجم في هذا\Nالنطاق الزمنيّ والمكانيّ المحدودين
Dialogue: 0,0:10:14.86,0:10:18.03,Default,,0000,0000,0000,,فإمّا أنّه يختبئ في الجبال منتظراً فرصته \N،كرجل عصابة
Dialogue: 0,0:10:18.82,0:10:21.11,Default,,0000,0000,0000,,أو أنّه أحد المتسلّقين
Dialogue: 0,0:10:21.40,0:10:28.07,Default,,0000,0000,0000,,أي أنّ هناك احتمالاً كبيراً أن يكون\Nالثعلب أحد الخمسة الآخرين
Dialogue: 0,0:10:28.07,0:10:30.99,Default,,0000,0000,0000,,توخّوا الحذر، الصخور زلقة
Dialogue: 0,0:10:31.35,0:10:33.20,Default,,0000,0000,0000,,لا عليك، هيّا
Dialogue: 0,0:10:34.52,0:10:35.94,Default,,0000,0000,0000,,تمسّكوا بالحبل رجاءً
Dialogue: 0,0:10:42.01,0:10:42.71,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,0:10:44.44,0:10:46.07,Default,,0000,0000,0000,,أأنت بخير يا أوشيو-سان؟
Dialogue: 0,0:10:47.66,0:10:49.58,Default,,0000,0000,0000,,...كيف تجرؤ
Dialogue: 0,0:10:49.58,0:10:51.62,Default,,0000,0000,0000,,ما-ما الذي تفعله؟
Dialogue: 0,0:10:51.62,0:10:53.70,Default,,0000,0000,0000,,!أنت من فعل ذلك، صحيح؟
Dialogue: 0,0:10:53.95,0:10:57.28,Default,,0000,0000,0000,,كلا، انقطع من تلقاء نفسه! انظر
Dialogue: 0,0:10:57.65,0:11:00.03,Default,,0000,0000,0000,,كان قديماً وبالياً
Dialogue: 0,0:11:01.65,0:11:02.99,Default,,0000,0000,0000,,لا تخفني هكذا
Dialogue: 0,0:11:03.32,0:11:06.18,Default,,0000,0000,0000,,!هـ-هذه جملتي
Dialogue: 0,0:11:07.81,0:11:12.28,Default,,0000,0000,0000,,عندما أفكّر بكون الثعلب\N،أحد مجموعة المتسلّقين
Dialogue: 0,0:11:12.28,0:11:13.87,Default,,0000,0000,0000,,يصبح الجميع مثيرين للشبهة
Dialogue: 0,0:11:18.80,0:11:21.72,Default,,0000,0000,0000,,يبدوان مشبوهين
Dialogue: 0,0:11:21.72,0:11:23.37,Default,,0000,0000,0000,,وهو أيضاً
Dialogue: 0,0:11:23.72,0:11:26.88,Default,,0000,0000,0000,,كان يحدّق بشدة لفترة
Dialogue: 0,0:11:28.54,0:11:31.49,Default,,0000,0000,0000,,يبدو أنّه يكنّ ضغينةً ما لأوشيو-سان
Dialogue: 0,0:11:32.12,0:11:36.78,Default,,0000,0000,0000,,كما كان يسبقنا بكثير، لكنّه معنا الآن
Dialogue: 0,0:11:36.78,0:11:38.44,Default,,0000,0000,0000,,أنتما
Dialogue: 0,0:11:38.44,0:11:41.66,Default,,0000,0000,0000,,ما الذي تتكلمان عنه؟ أتقومان بمراقبة الآخرين؟
Dialogue: 0,0:11:41.66,0:11:43.62,Default,,0000,0000,0000,,...لـ-لا، كنّا فقط
Dialogue: 0,0:11:44.49,0:11:46.77,Default,,0000,0000,0000,,لم يحصل شيء بعدها
Dialogue: 0,0:11:46.77,0:11:51.62,Default,,0000,0000,0000,,بينما اقتربنا من نقطة الارتياح الأخيرة\Nقبل الوصول للكوخ الذي سنبيت فيه
Dialogue: 0,0:11:56.26,0:11:57.88,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:57.88,0:12:00.20,Default,,0000,0000,0000,,لا شيء... تبدين مفعمة بالحيويّة فحسب
Dialogue: 0,0:12:00.59,0:12:03.53,Default,,0000,0000,0000,,!بالطبع! فأنا أمرّن جسدي بالكاراتيه
Dialogue: 0,0:12:04.26,0:12:06.42,Default,,0000,0000,0000,,أتريد تلقّي إحدى تقنيات ساقي؟
Dialogue: 0,0:12:06.42,0:12:07.99,Default,,0000,0000,0000,,لا داعي
Dialogue: 0,0:12:09.21,0:12:11.70,Default,,0000,0000,0000,,أين ذاك الشاب الجامعيّ؟
Dialogue: 0,0:12:12.25,0:12:14.61,Default,,0000,0000,0000,,لعلّه يستريح في مكانٍ ما
Dialogue: 0,0:12:15.24,0:12:18.11,Default,,0000,0000,0000,,!أو هرب لأنّ حقيقته كُشفت
Dialogue: 0,0:12:18.11,0:12:20.49,Default,,0000,0000,0000,,!صه! أوشيو-سان
Dialogue: 0,0:12:20.86,0:12:23.57,Default,,0000,0000,0000,,!قالوا أنّ حقيقته كُشفت وهرب
Dialogue: 0,0:12:23.57,0:12:25.11,Default,,0000,0000,0000,,!اصمتي! هيّا بنا
Dialogue: 0,0:12:29.10,0:12:32.40,Default,,0000,0000,0000,,...هناك أمرٌ ما بهذين الاثنين
Dialogue: 0,0:12:44.15,0:12:47.04,Default,,0000,0000,0000,,!مـ-مشكلة! ليأت أحد
Dialogue: 0,0:12:47.71,0:12:50.13,Default,,0000,0000,0000,,!بسرعة! ليأت أحد
Dialogue: 0,0:12:51.35,0:12:52.52,Default,,0000,0000,0000,,!ما الخطب؟
Dialogue: 0,0:12:52.52,0:12:53.59,Default,,0000,0000,0000,,!ذ-ذاك
Dialogue: 0,0:12:54.39,0:12:55.37,Default,,0000,0000,0000,,...ذاك
Dialogue: 0,0:12:59.17,0:13:00.61,Default,,0000,0000,0000,,!هيراي-سان
Dialogue: 0,0:13:00.93,0:13:03.03,Default,,0000,0000,0000,,!لـ-لمَ؟
Dialogue: 0,0:13:10.34,0:13:13.81,Default,,0000,0000,0000,,...لمَ؟ لمَ هيراي-سان
Dialogue: 0,0:13:14.21,0:13:16.71,Default,,0000,0000,0000,,لم يكن هو إذاً؟
Dialogue: 0,0:13:16.71,0:13:18.13,Default,,0000,0000,0000,,!أنت من فعل هذا
Dialogue: 0,0:13:18.13,0:13:20.55,Default,,0000,0000,0000,,!قمت بدفعه، أليس كذلك؟
Dialogue: 0,0:13:20.55,0:13:23.64,Default,,0000,0000,0000,,!د-دعني! لا تلمسني
Dialogue: 0,0:13:24.41,0:13:26.66,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:13:29.65,0:13:33.23,Default,,0000,0000,0000,,ألا يجدر بنا الإسراع وتفقّد الجثّة؟
Dialogue: 0,0:13:33.23,0:13:34.47,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:13:36.40,0:13:37.72,Default,,0000,0000,0000,,الرجل المسكين
Dialogue: 0,0:13:39.56,0:13:41.39,Default,,0000,0000,0000,,لا بدّ أنّه مات فورياً
Dialogue: 0,0:13:46.85,0:13:49.90,Default,,0000,0000,0000,,!أنت، لا تتجوّل في المكان\N!هذا خطر
Dialogue: 0,0:13:51.42,0:13:54.68,Default,,0000,0000,0000,,!إنّها سكّين! عليها دم قليل
Dialogue: 0,0:13:54.92,0:13:58.59,Default,,0000,0000,0000,,...ماذا؟ سكّين؟ أيمكن أنّ الثعلب قد
Dialogue: 0,0:13:59.12,0:14:02.55,Default,,0000,0000,0000,,لكن لا آثار طعن عليه
Dialogue: 0,0:14:02.95,0:14:04.02,Default,,0000,0000,0000,,...هذا الجرح
Dialogue: 0,0:14:05.01,0:14:06.98,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:14:07.33,0:14:11.43,Default,,0000,0000,0000,,!انظر! يبدو أنّ هذا أثر خدشه بالسكّين
Dialogue: 0,0:14:11.90,0:14:15.22,Default,,0000,0000,0000,,...وكون السكّين ملقاة هنا
Dialogue: 0,0:14:15.90,0:14:18.42,Default,,0000,0000,0000,,...يعني أنّه تفادى السكّين التي رماها الفاعل
Dialogue: 0,0:14:18.89,0:14:20.26,Default,,0000,0000,0000,,...لكنه تعثر
Dialogue: 0,0:14:21.58,0:14:25.33,Default,,0000,0000,0000,,وسقط من الجرف
Dialogue: 0,0:14:26.52,0:14:28.80,Default,,0000,0000,0000,,نوى قتله إذاً؟
Dialogue: 0,0:14:29.13,0:14:31.67,Default,,0000,0000,0000,,!أنت! أين كنت؟
Dialogue: 0,0:14:31.67,0:14:32.90,Default,,0000,0000,0000,,في الأرجاء
Dialogue: 0,0:14:32.90,0:14:34.01,Default,,0000,0000,0000,,!كاذب
Dialogue: 0,0:14:34.38,0:14:39.08,Default,,0000,0000,0000,,كنتُ أمامكم، لكن رجعت بعدما سمعت صراخاً
Dialogue: 0,0:14:39.08,0:14:42.22,Default,,0000,0000,0000,,انظر، مع هذين الاثنين المريبين
Dialogue: 0,0:14:42.54,0:14:44.14,Default,,0000,0000,0000,,ماذا؟ هما؟
Dialogue: 0,0:14:44.62,0:14:48.99,Default,,0000,0000,0000,,لا تمازحونا! مرافقة هؤلاء الأشخاص\N!لن تجلب سوى المتاعب
Dialogue: 0,0:14:48.99,0:14:50.09,Default,,0000,0000,0000,,لنذهب بسرعة
Dialogue: 0,0:14:50.09,0:14:53.93,Default,,0000,0000,0000,,!لحظة! سننتظر جميعاً في الكوخ الجبليّ
Dialogue: 0,0:14:54.40,0:14:57.89,Default,,0000,0000,0000,,سأطلب منكما البقاء معنا\Nحتّى وصول الشرطة
Dialogue: 0,0:14:57.89,0:15:01.85,Default,,0000,0000,0000,,!لا تعبث معنا! أ-أيّ حق لديك لتطلب ذلك؟
Dialogue: 0,0:15:01.85,0:15:07.31,Default,,0000,0000,0000,,أيّ من يغادر مسرح جريمة قتل سيُشتبه به
Dialogue: 0,0:15:08.30,0:15:09.26,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:15:09.26,0:15:13.22,Default,,0000,0000,0000,,تبدو معتاداً كثيراً على هذا يا مورياما-سان، ما عملك؟
Dialogue: 0,0:15:13.22,0:15:15.34,Default,,0000,0000,0000,,...أنا
Dialogue: 0,0:15:15.34,0:15:17.80,Default,,0000,0000,0000,,موظّف شركة! صحيح يا أبي؟
Dialogue: 0,0:15:17.80,0:15:19.68,Default,,0000,0000,0000,,!نـ-نعم
Dialogue: 0,0:15:20.75,0:15:22.60,Default,,0000,0000,0000,,موظّف شركة إذاً؟
Dialogue: 0,0:15:22.60,0:15:25.12,Default,,0000,0000,0000,,لا يبدو عليه البتّة
Dialogue: 0,0:15:26.91,0:15:27.76,Default,,0000,0000,0000,,!مطر
Dialogue: 0,0:15:32.51,0:15:33.31,Default,,0000,0000,0000,,!لنسرع
Dialogue: 0,0:15:34.19,0:15:35.52,Default,,0000,0000,0000,,!الظلام يخيم
Dialogue: 0,0:15:53.43,0:15:56.72,On Top,,0000,0000,0000,,جفّفوا أنفسكم، ستلوّثون الكوخ
Dialogue: 0,0:15:53.54,0:15:56.72,CharCard,,0000,0000,0004,,{\fad(300,0)}(إيواتا جوكيتشي (60\Nمشرف الكوخ
Dialogue: 0,0:15:57.13,0:15:59.97,Default,,0000,0000,0000,,أأنت المشرف على هذا الكوخ يا جدّ؟
Dialogue: 0,0:16:00.58,0:16:03.93,Default,,0000,0000,0000,,!نعم، فلتدخلوا بسرعة! سيصيبكم الزكام
Dialogue: 0,0:16:05.42,0:16:06.89,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:16:10.78,0:16:12.74,Default,,0000,0000,0000,,أشعر بالإرهاق
Dialogue: 0,0:16:12.74,0:16:14.99,Default,,0000,0000,0000,,أبي، ألن تتّصل؟
Dialogue: 0,0:16:14.99,0:16:16.57,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:16:17.90,0:16:20.14,Default,,0000,0000,0000,,سأستعمل الهاتف يا جدّ
Dialogue: 0,0:16:22.56,0:16:25.35,Default,,0000,0000,0000,,...ما هذا؟ لا أسمع طنيناً، المعذرة
Dialogue: 0,0:16:25.73,0:16:29.55,Default,,0000,0000,0000,,قُطعت خطوط الهاتف مع الصاعقة\Nقبل قليل غالباً
Dialogue: 0,0:16:29.93,0:16:32.01,Default,,0000,0000,0000,,هذا شائع الحدوث
Dialogue: 0,0:16:32.01,0:16:35.47,Default,,0000,0000,0000,,...يا للمشكلة، إنّها تمطر وحلّ الليل
Dialogue: 0,0:16:35.97,0:16:39.93,Default,,0000,0000,0000,,!من الخطر النزول من الجبال ليلاً\N!أنصحكم ألّا تفعلوا
Dialogue: 0,0:16:39.93,0:16:45.46,Default,,0000,0000,0000,,كما أنّ هذه قمّة تانبارا، لا أكواخ أخرى بالقرب
Dialogue: 0,0:16:45.46,0:16:48.09,Default,,0000,0000,0000,,أي أنّنا معزولون تماماً
Dialogue: 0,0:16:48.53,0:16:49.53,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:16:49.53,0:16:54.56,Default,,0000,0000,0000,,لا تمازحونا! لا أصدّق أنّنا \N!عالقون هنا مع قاتل
Dialogue: 0,0:16:54.56,0:16:56.52,Default,,0000,0000,0000,,قاتل؟
Dialogue: 0,0:16:58.02,0:17:02.72,Default,,0000,0000,0000,,قُتل أحد أعضاء المجموعة \Nبشكل يوهم أنّه كان حادثاً
Dialogue: 0,0:17:03.73,0:17:05.68,Default,,0000,0000,0000,,يوهم أنّه حادث؟
Dialogue: 0,0:17:07.69,0:17:11.55,Default,,0000,0000,0000,,لكن، كيف يلطّخ الجبال بهذا الشكل؟ يا للخزي
Dialogue: 0,0:17:12.18,0:17:16.60,Default,,0000,0000,0000,,قد يكون القاتل أحدنا
Dialogue: 0,0:17:16.60,0:17:20.30,Default,,0000,0000,0000,,من يدري، لعلّه أنت يا أوشيو-سان
Dialogue: 0,0:17:20.30,0:17:22.18,Default,,0000,0000,0000,,!مـ-ماذا؟
Dialogue: 0,0:17:22.71,0:17:28.63,Default,,0000,0000,0000,,من المنطقي في روايات الغموض\Nأنّ القاتل هو الأقلّ شبهة
Dialogue: 0,0:17:28.63,0:17:31.85,Default,,0000,0000,0000,,!هراء! أنا أتضوّر جوعاً، الطعام
Dialogue: 0,0:17:34.81,0:17:36.77,On Top,,0000,0000,0000,,كاري\Nأرز
Dialogue: 0,0:17:37.12,0:17:39.22,Default,,0000,0000,0000,,هذا هو العشاء؟
Dialogue: 0,0:17:39.77,0:17:42.18,Default,,0000,0000,0000,,نحن في الجبال، ماذا تتوقّعون؟
Dialogue: 0,0:17:46.28,0:17:47.14,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:50.26,0:17:51.81,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:17:51.81,0:17:53.56,Default,,0000,0000,0000,,...لا شيء
Dialogue: 0,0:17:54.68,0:17:57.72,Default,,0000,0000,0000,,ما شعور الغرابة هذا؟
Dialogue: 0,0:17:57.72,0:17:59.01,Default,,0000,0000,0000,,!هناك أمرٌ ليس في محلّه
Dialogue: 0,0:18:00.21,0:18:01.97,Default,,0000,0000,0000,,ما هو؟
Dialogue: 0,0:18:07.95,0:18:09.84,Default,,0000,0000,0000,,ما خطب تاكاناشي-سان يا ترى؟
Dialogue: 0,0:18:10.33,0:18:11.76,Default,,0000,0000,0000,,لعلّ ضميره يؤنبه
Dialogue: 0,0:18:19.94,0:18:21.55,Default,,0000,0000,0000,,...كنتَ إذاً من
Dialogue: 0,0:18:22.14,0:18:23.45,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:18:24.18,0:18:25.50,Default,,0000,0000,0000,,!لا-لا تقتلنا
Dialogue: 0,0:18:26.38,0:18:30.46,Default,,0000,0000,0000,,سخافة! يحمل الجميع سكاكين \N!صيد عند صعود الجبال
Dialogue: 0,0:18:30.46,0:18:33.67,Default,,0000,0000,0000,,...ذ-ذلك صحيح، لكن
Dialogue: 0,0:18:35.29,0:18:37.62,Default,,0000,0000,0000,,...تذكّرت! مورياما-سان، أنت
Dialogue: 0,0:18:38.04,0:18:41.54,Default,,0000,0000,0000,,موري كوغورو-سان، صحيح؟ المتحرّي الشهير
Dialogue: 0,0:18:41.54,0:18:43.50,Default,,0000,0000,0000,,مـ-متحرّي؟
Dialogue: 0,0:18:44.00,0:18:45.95,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:18:47.99,0:18:50.96,Default,,0000,0000,0000,,لمَ زيّفت اسمك؟ أهناك قضيّة ما؟
Dialogue: 0,0:18:51.44,0:18:55.91,Default,,0000,0000,0000,,...أم أسباب خاصة؟ أم\Nللأمر علاقة بجريمة القتل هذه؟
Dialogue: 0,0:18:57.98,0:19:00.08,Default,,0000,0000,0000,,يا إلهي! إلى متى ستظلّ تمطر؟
Dialogue: 0,0:19:00.08,0:19:02.76,Default,,0000,0000,0000,,ما هي نشرة الطقس؟
Dialogue: 0,0:19:05.72,0:19:08.75,Default,,0000,0000,0000,,يمكنك إخباري سرّاً، هيّا
Dialogue: 0,0:19:08.75,0:19:10.88,Default,,0000,0000,0000,,ننتقل للأنباء التالية
Dialogue: 0,0:19:10.88,0:19:15.62,Default,,0000,0000,0000,,،طُعن هذا الصباح تاناكا يورو، 60 عاماً\Nبطعنة مميتة في قرية تانبارا
Dialogue: 0,0:19:15.62,0:19:18.58,Default,,0000,0000,0000,,وهناك احتمال بهروب المشتبه به لجبال تانبارا
Dialogue: 0,0:19:18.58,0:19:22.67,Default,,0000,0000,0000,,أرسلت الشرطة 50 رجلاً مع مركز الإطفاء لتفتيش المنطقة
Dialogue: 0,0:19:36.02,0:19:38.81,Default,,0000,0000,0000,,!لن يغمض لي جفن هكذا
Dialogue: 0,0:19:46.22,0:19:46.91,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,0:19:48.55,0:19:49.37,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:19:49.78,0:19:50.75,Default,,0000,0000,0000,,!أبي؟
Dialogue: 0,0:19:54.00,0:19:55.20,Default,,0000,0000,0000,,!غادر أحدهم
Dialogue: 0,0:19:56.42,0:19:57.92,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:19:58.66,0:20:01.00,Default,,0000,0000,0000,,!تاكاناشي-سان ليس موجوداً
Dialogue: 0,0:20:07.74,0:20:09.04,Default,,0000,0000,0000,,!كان هو بالفعل إذاً
Dialogue: 0,0:20:09.61,0:20:12.20,Default,,0000,0000,0000,,!الوغد! لن تهرب
Dialogue: 0,0:20:12.20,0:20:15.85,Default,,0000,0000,0000,,!توخَّ الحذر! فأنت هدفه
Dialogue: 0,0:20:15.85,0:20:17.39,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:20:23.69,0:20:24.71,Default,,0000,0000,0000,,تاكاناشي-سان؟
Dialogue: 0,0:20:24.84,0:20:25.69,Default,,0000,0000,0000,,ما كان ذلك؟
Dialogue: 0,0:20:29.26,0:20:33.66,Default,,0000,0000,0000,,!النجدة! النجدة
Dialogue: 0,0:20:38.75,0:20:40.63,Default,,0000,0000,0000,,!الـ-النجدة
Dialogue: 0,0:20:41.67,0:20:43.34,Default,,0000,0000,0000,,!النجدة
Dialogue: 0,0:20:43.88,0:20:45.25,Default,,0000,0000,0000,,!انتبه يا كونان
Dialogue: 0,0:20:45.25,0:20:46.41,Default,,0000,0000,0000,,!الثعلب
Dialogue: 0,0:20:47.20,0:20:49.87,Default,,0000,0000,0000,,!انتظر! حاله غريب
Dialogue: 0,0:20:50.12,0:20:53.23,Default,,0000,0000,0000,,!الـ-السقف يسقط
Dialogue: 0,0:20:54.20,0:20:58.75,Default,,0000,0000,0000,,!الـ-الحوائط تُطبِق عليّ! أشعر بالخوف! أشعر بالخوف
Dialogue: 0,0:20:59.69,0:21:02.11,Default,,0000,0000,0000,,!النجدة
Dialogue: 0,0:21:03.06,0:21:04.55,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:21:04.55,0:21:07.54,Default,,0000,0000,0000,,لعلّه يعاني رهاباً من الأماكن الضيّقة
Dialogue: 0,0:21:07.97,0:21:09.72,Default,,0000,0000,0000,,رهاب أماكن ضيّقة؟
Dialogue: 0,0:21:09.72,0:21:12.46,Default,,0000,0000,0000,,ولذلك هرب من الكوخ؟
Dialogue: 0,0:21:12.85,0:21:17.41,Default,,0000,0000,0000,,أجل، ثمّ دخل هنا للاحتماء من المطر\Nلكن رجعت حالته
Dialogue: 0,0:21:18.00,0:21:19.71,Default,,0000,0000,0000,,...أي أنّه
Dialogue: 0,0:21:19.71,0:21:21.88,Default,,0000,0000,0000,,لم يكن الثعلب
Dialogue: 0,0:21:35.15,0:21:38.79,Default,,0000,0000,0000,,احتجزني مشترو أراضٍ مرّةً
Dialogue: 0,0:21:40.15,0:21:43.65,Default,,0000,0000,0000,,أغضبتُهم بعدما رفضت بيع أرضي
Dialogue: 0,0:21:43.65,0:21:45.70,Default,,0000,0000,0000,,وأصبحتُ أخشى الأماكن الضيّقة مُذ آنذاك
Dialogue: 0,0:21:46.31,0:21:49.17,Default,,0000,0000,0000,,لذا كنت لا تطيق مسؤول العقارات
Dialogue: 0,0:21:49.17,0:21:51.13,Default,,0000,0000,0000,,تخمينٌ موفق يا فتى
Dialogue: 0,0:21:51.81,0:21:56.37,Default,,0000,0000,0000,,!لكن ذلك يعني أنّ الثعلب لا يزال طليقاً
Dialogue: 0,0:21:57.09,0:22:01.42,Default,,0000,0000,0000,,من بين الأربعة المتبقّين، من هو القاتل المأجور؟
Dialogue: 0,0:22:15.40,0:22:16.53,Default,,0000,0000,0000,,!صوت ران
Dialogue: 0,0:22:17.64,0:22:19.67,Default,,0000,0000,0000,,!أ-أيمكن أن أمراً حلّ بران؟
Dialogue: 0,0:24:00.21,0:24:05.65,Default,,0000,0000,0000,,الثعلب موجود هنا، وهو من يقف وراء\N!سلسلة جرائم القتل هذه
Dialogue: 0,0:24:05.65,0:24:07.35,Default,,0000,0000,0000,,!مـ-ماذا؟
Dialogue: 0,0:24:07.35,0:24:08.62,Default,,0000,0000,0000,,ذاك القاتل المأجور؟
Dialogue: 0,0:24:08.71,0:24:09.91,Default,,0000,0000,0000,,!الثعلب؟
Dialogue: 0,0:24:10.00,0:24:16.32,Default,,0000,0000,0000,,أجل! القاتل المأجور بلا نظير\N،والمسؤول عن هذه الجرائم، أي الثعلب
Dialogue: 0,0:24:16.65,0:24:20.11,Default,,0000,0000,0000,,!هو أنت أيّها الروائيّ، نوسي شينغو
Dialogue: 0,0:24:20.11,0:24:21.28,Default,,0000,0000,0000,,!حـ-حقّاً؟
Dialogue: 0,0:24:21.74,0:24:22.81,Default,,0000,0000,0000,,!أيّها الوغد
Dialogue: 0,0:24:22.81,0:24:23.91,Default,,0000,0000,0000,,!ما-ما الذي تفعله؟
Dialogue: 0,0:24:24.05,0:24:30.04,On Top,,0000,0000,0000,,جريمة قتل تسلّق الجبال المخيفة \N(الجزء الثاني)
Dialogue: 0,0:24:24.68,0:24:26.01,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.17,0:24:29.70,Default,,0000,0000,0000,,جريمة قتل تسلّق الجبال المخيفة \N(الجزء الثاني)
Dialogue: 0,0:24:45.54,0:24:47.93,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.93,0:24:49.93,Default,,0000,0000,0000,,سجّل كوخ جبلي
Dialogue: 0,0:24:50.22,0:24:53.38,Default,,0000,0000,0000,,
Dialogue: 0,0:24:53.38,0:24:54.38,Default,,0000,0000,0000,,
Dialogue: 0,0:24:54.38,0:24:56.37,Default,,0000,0000,0000,,

