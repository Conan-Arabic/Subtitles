Dialogue: 0,0:00:01.41,0:00:04.66,Default,,0000,0000,0000,,،طالما جرائم العصر الحديث تتضمّن بشراً
Dialogue: 0,0:00:04.66,0:00:06.11,Default,,0000,0000,0000,,!لا توجد ألغاز لا تُحلّ
Dialogue: 0,0:00:06.49,0:00:08.36,Default,,0000,0000,0000,,قضيّة اليوم عن أصل كونان
Dialogue: 0,0:00:08.36,0:00:10.40,Default,,0000,0000,0000,,!ويعاود متحرّيو الغرب الظهور
Dialogue: 0,0:00:10.40,0:00:12.40,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.40,0:00:14.61,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.61,0:00:16.35,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.15,0:01:57.02,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل مهووس هولمز (الجزء الأوّل
Dialogue: 0,0:01:51.83,0:01:55.29,Default,,0000,0000,0000,,(جريمة قتل مهووس هولمز (الجزء الأوّل
Dialogue: 0,0:02:00.09,0:02:02.46,On Top,,0000,0000,0000,,جولة استقبال مهووسي شارلوك هولمز
Dialogue: 0,0:02:01.08,0:02:02.46,Default,,0000,0000,0000,,دراسة في اللون القرمزي" إذاً"
Dialogue: 0,0:02:02.46,0:02:03.37,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:03.37,0:02:08.25,Default,,0000,0000,0000,,إنّه عمل مميّز كان فيه\N!الظهور الأوّل لهولمز
Dialogue: 0,0:02:08.25,0:02:11.09,Default,,0000,0000,0000,,!عصبة ذوي الشعر الأحمر" هو المفضّل لي"
Dialogue: 0,0:02:11.09,0:02:13.84,Default,,0000,0000,0000,,!"أنا! عملي المفضّل هو "علامة الأربعة
Dialogue: 0,0:02:13.84,0:02:17.41,Default,,0000,0000,0000,,!ذاك عمل لقي تقديراً عالمياً
Dialogue: 0,0:02:17.41,0:02:19.80,Default,,0000,0000,0000,,مذهل يا فتى، يمكنك قراءة الكانجي؟
Dialogue: 0,0:02:20.76,0:02:21.75,Default,,0000,0000,0000,,نوعاً ما
Dialogue: 0,0:02:21.75,0:02:23.46,Default,,0000,0000,0000,,...يا إلهي، هؤلاء
Dialogue: 0,0:02:23.94,0:02:27.43,Default,,0000,0000,0000,,لمَ عليّ المشاركة في هذه الجولة السخيفة؟
Dialogue: 0,0:02:27.77,0:02:32.09,Default,,0000,0000,0000,,لأنّ كونان-كن أرسل طلب المشاركة قبل السؤال
Dialogue: 0,0:02:32.09,0:02:35.22,Default,,0000,0000,0000,,...ثمّ كان حظّي سيئاً ما يكفي بحيث تمّ اختيارنا
Dialogue: 0,0:02:35.22,0:02:36.51,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:02:36.51,0:02:38.55,Default,,0000,0000,0000,,أيّ قصة هي المفضلة لديك؟
Dialogue: 0,0:02:38.55,0:02:41.21,Default,,0000,0000,0000,,ماذا؟ أ-أنا؟
Dialogue: 0,0:02:41.21,0:02:42.17,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:42.17,0:02:44.08,Default,,0000,0000,0000,,...حسناً، سؤال جيّد
Dialogue: 0,0:02:44.08,0:02:47.13,Default,,0000,0000,0000,,أرى "ثمّ كان هناك أحد" المفضّلة لي
Dialogue: 0,0:02:49.39,0:02:52.88,On Top,,0000,0000,0000,,"تقصد "ثمّ لم يكن هناك أحد
Dialogue: 0,0:02:50.22,0:02:52.88,CharCard,,0000,0000,0005,,{\fad(300,0)}(فوجيساوا توشياكي (47\Nموظّف محطّة قطار
Dialogue: 0,0:02:52.88,0:02:56.62,On Top,,0000,0000,0000,,وتلك رواية ألفّتها أغاثا كريستي
Dialogue: 0,0:02:53.58,0:03:00.30,CharCard,,0000,0000,0005,,{\fad(300,0)}(شيميزو ناناكو (24\Nأمينة مكتبة
Dialogue: 0,0:02:56.62,0:03:00.30,On Top,,0000,0000,0000,,وليس كونان دويل-ساما الذي أقدّره
Dialogue: 0,0:03:00.30,0:03:01.73,On Top,,0000,0000,0000,,عجباً
Dialogue: 0,0:03:01.00,0:03:04.76,CharCard,,0000,0000,0005,,{\fad(300,0)}(كاواتسو إيكو (25\Nأستاذ رياضة في الثانوية
Dialogue: 0,0:03:01.73,0:03:04.76,On Top,,0000,0000,0000,,لم أعلم أن بيننا هواة في هذه الجولة
Dialogue: 0,0:03:05.06,0:03:07.05,Default,,0000,0000,0000,,يا لمُفسد الجوّ
Dialogue: 0,0:03:07.52,0:03:11.22,Default,,0000,0000,0000,,عليّ البقاء مع هؤلاء لثلاثة أيام كاملة؟
Dialogue: 0,0:03:11.22,0:03:13.18,Default,,0000,0000,0000,,ليسوا الضيوف الوحيدين
Dialogue: 0,0:03:14.01,0:03:16.72,On Top,,0000,0000,0000,,يصطحب مُشرف الجولة بقيّة الضيوف
Dialogue: 0,0:03:14.56,0:03:18.97,CharCard,,0000,0000,0005,,{\fad(300,0)}(إيواي هيتومي (24\Nعاملة نُزل
Dialogue: 0,0:03:16.72,0:03:18.97,On Top,,0000,0000,0000,,في سيّارة أخرى للنُزل في هذه الأثناء
Dialogue: 0,0:03:18.97,0:03:20.10,Default,,0000,0000,0000,,...مهلك
Dialogue: 0,0:03:20.10,0:03:23.04,Default,,0000,0000,0000,,!ما المشكلة؟ زاد العدد زادت المتعة
Dialogue: 0,0:03:23.04,0:03:23.71,Default,,0000,0000,0000,,!كيف ذلك؟
Dialogue: 0,0:03:24.59,0:03:26.93,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:03:27.46,0:03:33.26,Default,,0000,0000,0000,,"مرحباً بكم يا سادة في نُزلي هذا، "ماي كروفت
Dialogue: 0,0:03:33.46,0:03:36.11,On Top,,0000,0000,0000,,أنا كانايا، مُشرف هذه الجولة
Dialogue: 0,0:03:33.81,0:03:38.22,CharCard,,0000,0000,0005,,{\fad(300,0)}(كانايا هيرويوكي (51\Nمالك النُزل
Dialogue: 0,0:03:36.11,0:03:38.42,On Top,,0000,0000,0000,,ومالك النُزل
Dialogue: 0,0:03:38.69,0:03:40.87,Default,,0000,0000,0000,,كلّ واحد بينكم اليوم
Dialogue: 0,0:03:40.87,0:03:45.13,Default,,0000,0000,0000,,معجب شارلوكيّ اخترته بعناية
Dialogue: 0,0:03:45.81,0:03:47.85,Default,,0000,0000,0000,,هل اخترت بعناية حقّاً؟
Dialogue: 0,0:03:47.85,0:03:50.10,Default,,0000,0000,0000,,يبدو أنّ بيننا مبتدئاً لا يفقه أيّ شيء
Dialogue: 0,0:03:50.10,0:03:51.87,Default,,0000,0000,0000,,عن هولمز
Dialogue: 0,0:03:51.87,0:03:54.42,On Top,,0000,0000,0000,,ماذا؟ حقّاً؟
Dialogue: 0,0:03:52.44,0:03:56.23,CharCard,,0000,0120,0005,,{\fad(300,0)}(تودا ماريا (43\Nقارئة طالع
Dialogue: 0,0:03:54.42,0:03:56.33,On Top,,0000,0000,0000,,انظري، ذاك الرجل المشورب
Dialogue: 0,0:03:56.33,0:03:57.26,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:03:57.92,0:04:00.09,Default,,0000,0000,0000,,اكتفيت، سأغادر
Dialogue: 0,0:04:00.55,0:04:03.25,Default,,0000,0000,0000,,!ا-انتظر رجاءً يا موري-سان
Dialogue: 0,0:04:03.25,0:04:07.21,Default,,0000,0000,0000,,يا سادة، الرجل الذي جلبتُه اليوم\Nهو العَلم عينه
Dialogue: 0,0:04:07.21,0:04:13.07,Default,,0000,0000,0000,,متحرّي العصر الحديث العظيم\Nالذي يُقارن بشخصيتنا المحبوبة هولمز
Dialogue: 0,0:04:13.07,0:04:14.92,Default,,0000,0000,0000,,موري كوغورو-سان، صحيح؟
Dialogue: 0,0:04:14.92,0:04:16.53,Default,,0000,0000,0000,,أعرفه
Dialogue: 0,0:04:16.53,0:04:19.88,Default,,0000,0000,0000,,فقد رأيتُه مرات عديدة في التلفاز والصحف
Dialogue: 0,0:04:21.16,0:04:24.81,On Top,,0000,0000,0000,,يبدو أنّه يملك ذكاءً حاداً بالفعل
Dialogue: 0,0:04:21.85,0:04:27.56,CharCard,,0000,0000,0005,,{\fad(300,0)}(توغانو كينتو (22\Nطالب جامعيّ، رئيس نادي التحرّي
Dialogue: 0,0:04:24.81,0:04:27.64,On Top,,0000,0000,0000,,لكن يستحيل أن يُقارن بشارلوك
Dialogue: 0,0:04:27.48,0:04:28.33,On Top,,0000,0000,0000,,صحيح
Dialogue: 0,0:04:28.33,0:04:29.83,On Top,,0000,0000,0000,,لن تبلغ موضع قدميه
Dialogue: 0,0:04:28.34,0:04:32.97,CharCard,,0000,0000,0005,,{\fad(300,0)}(أوكي أياكو (21\Nطالبة جامعية، عضو في نادي التحرّي
Dialogue: 0,0:04:29.83,0:04:32.97,On Top,,0000,0000,0000,,في منافسة حقيقية على الأرجح
Dialogue: 0,0:04:32.97,0:04:35.07,Default,,0000,0000,0000,,!لا يمكنني تركهم يقولون هذا
Dialogue: 0,0:04:35.07,0:04:35.98,Default,,0000,0000,0000,,هوّن عليك
Dialogue: 0,0:04:35.98,0:04:39.02,Default,,0000,0000,0000,,أنت تُقارن بهولمز فلا عجب
Dialogue: 0,0:04:39.02,0:04:39.73,Default,,0000,0000,0000,,!اخرس
Dialogue: 0,0:04:39.73,0:04:41.89,Default,,0000,0000,0000,,!أرفض الخسارة لشخصية كتب خيالية
Dialogue: 0,0:04:43.85,0:04:47.35,Default,,0000,0000,0000,,!كلّ هذا لأنّك سجّلتني في هذه الجولة
Dialogue: 0,0:04:47.35,0:04:48.35,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:04:48.35,0:04:49.81,Default,,0000,0000,0000,,كونان؟
Dialogue: 0,0:04:50.88,0:04:52.94,Default,,0000,0000,0000,,!اسمك كونان؟
Dialogue: 0,0:04:52.94,0:04:53.93,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:04:53.93,0:04:56.52,Default,,0000,0000,0000,,يعجبني أيضاً، أليس اسماً رائعاً؟
Dialogue: 0,0:04:56.52,0:04:57.98,Default,,0000,0000,0000,,!مُبهر
Dialogue: 0,0:04:58.55,0:05:00.90,Default,,0000,0000,0000,,يبدو أنّه لم تكن هناك حاجة للقلق
Dialogue: 0,0:05:02.16,0:05:07.17,Default,,0000,0000,0000,,فكونان-كن متّزن وغير طفوليّ في العادة بشكل غريب
Dialogue: 0,0:05:08.16,0:05:10.89,Default,,0000,0000,0000,,عندما أنظر لوجهه البريء هذا أشعر بالراحة
Dialogue: 0,0:05:11.19,0:05:14.77,Default,,0000,0000,0000,,لكن هوسه بهولمز يجعله يبدو مثله
Dialogue: 0,0:05:14.77,0:05:15.77,Default,,0000,0000,0000,,مثله؟
Dialogue: 0,0:05:15.77,0:05:17.77,Default,,0000,0000,0000,,!تعرف من أقصد
Dialogue: 0,0:05:18.19,0:05:20.15,Default,,0000,0000,0000,,مُتباهٍ ومغرور
Dialogue: 0,0:05:20.15,0:05:22.76,Default,,0000,0000,0000,,...ومُحب للتحرّي وأحد مهووسي هولمز، وأصمّ
Dialogue: 0,0:05:23.02,0:05:26.18,Default,,0000,0000,0000,,أصمّ النغم، لكن لاعب كرة قدم\Nبارع في المرحلة الثانويّة
Dialogue: 0,0:05:26.18,0:05:28.64,Default,,0000,0000,0000,,ومن هرب أثناء مواجهتنا في ذاك اليوم
Dialogue: 0,0:05:28.64,0:05:30.27,Default,,0000,0000,0000,,...قبل أن أستطيع ردّ اعتباري
Dialogue: 0,0:05:30.27,0:05:32.14,Default,,0000,0000,0000,,كودو شينتشي، صحيح؟
Dialogue: 0,0:05:32.42,0:05:33.60,Default,,0000,0000,0000,,!هاتّوري-كن
Dialogue: 0,0:05:34.92,0:05:36.92,Default,,0000,0000,0000,,أنت أحد معجبي هولمز أيضاً؟
Dialogue: 0,0:05:36.92,0:05:38.34,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:05:38.34,0:05:40.01,Default,,0000,0000,0000,,سبب تقديمي على هذه الجولة
Dialogue: 0,0:05:40.01,0:05:42.47,Default,,0000,0000,0000,,هو لأنّي ظننت أني قد ألتقي كودو
Dialogue: 0,0:05:42.83,0:05:46.18,Default,,0000,0000,0000,,كما أنّ إيليري كوين تروقني\Nأكثر من كونان دويل
Dialogue: 0,0:05:48.58,0:05:50.61,Default,,0000,0000,0000,,!لكن لعلّ لدويل الكعب الأعلى
Dialogue: 0,0:05:53.40,0:05:56.77,Default,,0000,0000,0000,,تأخّر الوقت يا سادة لذا لنخلد للراحة
Dialogue: 0,0:05:57.15,0:05:58.69,Default,,0000,0000,0000,,الإفطار غداً عند التاسعة صباحاً
Dialogue: 0,0:05:58.69,0:06:01.47,Default,,0000,0000,0000,,والغداء عند الواحدة والعشاء عند الثامنة
Dialogue: 0,0:06:01.47,0:06:07.52,Default,,0000,0000,0000,,وبعد العشاء ستُقام مسابقة\N!التحرّي المعقّدة السنوية
Dialogue: 0,0:06:07.52,0:06:12.47,Default,,0000,0000,0000,,ومن يحصلون على علامة كاملة في المسابقة
Dialogue: 0,0:06:12.88,0:06:14.88,Default,,0000,0000,0000,,سيتلقون أعظم أعمال كونان دويل
Dialogue: 0,0:06:14.88,0:06:17.01,Default,,0000,0000,0000,,الذي جلب شارلوك هولمز لهذا العالم
Dialogue: 0,0:06:17.01,0:06:20.65,Default,,0000,0000,0000,,"نسخة إصدار أوّل من "دراسة في اللون القرمزيّ
Dialogue: 0,0:06:22.50,0:06:23.54,Default,,0000,0000,0000,,لكن
Dialogue: 0,0:06:23.54,0:06:29.56,Default,,0000,0000,0000,,عليكم أن تروني دليل مدى إخلاصكم لهولمز أوّلاً
Dialogue: 0,0:06:29.56,0:06:30.52,Default,,0000,0000,0000,,دليل؟
Dialogue: 0,0:06:31.32,0:06:34.20,Default,,0000,0000,0000,,ما ستوزّعه الخادمة عليكم الآن
Dialogue: 0,0:06:34.20,0:06:36.28,Default,,0000,0000,0000,,هو اختبار طائفة هولمز ذو ألف سؤال
Dialogue: 0,0:06:36.28,0:06:37.49,Default,,0000,0000,0000,,!أ-ألف سؤال؟
Dialogue: 0,0:06:37.49,0:06:41.02,Default,,0000,0000,0000,,أمامكم حتّى العشاء غداً لتسليمه
Dialogue: 0,0:06:41.02,0:06:44.23,Default,,0000,0000,0000,,وحدهم من يجيبون بشكل صحيح\Nعلى ما يفوق 990 سؤال
Dialogue: 0,0:06:44.23,0:06:47.44,Default,,0000,0000,0000,,سيمكنهم المشاركة في مسابقة الغد
Dialogue: 0,0:06:47.44,0:06:49.94,Default,,0000,0000,0000,,للحيطة، إذا كانت معكم هواتف
Dialogue: 0,0:06:49.94,0:06:52.51,Default,,0000,0000,0000,,أو أيّ أعمال متعلّقة بهولمز
Dialogue: 0,0:06:52.51,0:06:54.84,Default,,0000,0000,0000,,عليكم تسليمها للخادمة الآن
Dialogue: 0,0:06:54.84,0:06:57.47,Default,,0000,0000,0000,,لا جدوى من محاولة إخفائها
Dialogue: 0,0:06:57.47,0:07:01.62,Default,,0000,0000,0000,,فيوجد في أرجاء النُزل كاميرات مراقبة
Dialogue: 0,0:07:01.62,0:07:04.50,Default,,0000,0000,0000,,!كما أجهزة تنصّت لمراقبتكم
Dialogue: 0,0:07:04.50,0:07:07.56,Default,,0000,0000,0000,,إذا تم ضبط غشّ أحدكم، سيُطلب منه المغادرة فوراً
Dialogue: 0,0:07:07.96,0:07:11.70,Default,,0000,0000,0000,,هل عليّ أخذ هذا الاختبار أيضاً؟
Dialogue: 0,0:07:11.70,0:07:14.24,Default,,0000,0000,0000,,كلا، أنت ضيف خاص
Dialogue: 0,0:07:14.24,0:07:16.77,Default,,0000,0000,0000,,نرجو أن تعطينا كلمةً فحسب لاحقاً
Dialogue: 0,0:07:16.77,0:07:21.43,Default,,0000,0000,0000,,،لو أجبتُ على ما يفوق 990 سؤالاً\Nأيمكنني المشاركة في المسابقة أيضاً؟
Dialogue: 0,0:07:21.43,0:07:22.89,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:07:25.35,0:07:26.90,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:07:26.90,0:07:28.81,Default,,0000,0000,0000,,ما كان تاريخ سقوط هولمز
Dialogue: 0,0:07:28.81,0:07:33.18,Default,,0000,0000,0000,,في قاع الوادي مع البروفسور موريارتي؟
Dialogue: 0,0:07:33.18,0:07:36.18,Default,,0000,0000,0000,,الرابع من مايو عام 1891
Dialogue: 0,0:07:36.18,0:07:38.27,Default,,0000,0000,0000,,!هذا سهل
Dialogue: 0,0:07:38.64,0:07:39.51,Default,,0000,0000,0000,,...التالي
Dialogue: 0,0:07:39.51,0:07:42.50,Default,,0000,0000,0000,,(اكتب الشفرة الكاملة من (مغامرة الرجال الراقصين"
Dialogue: 0,0:07:42.50,0:07:44.50,Default,,0000,0000,0000,,"كما ظهرت تماماً
Dialogue: 0,0:07:45.67,0:07:46.98,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:07:47.28,0:07:49.80,Default,,0000,0000,0000,,لا تزال مستيقظاً؟ إنّها الرابعة
Dialogue: 0,0:07:49.80,0:07:53.69,Default,,0000,0000,0000,,يا إلهي، لا تلفاز ولا هاتف ولا صحف
Dialogue: 0,0:07:53.69,0:07:56.33,Default,,0000,0000,0000,,وفوقها، لا يوجد أيّ جهاز تبريد
Dialogue: 0,0:07:56.33,0:07:57.67,Default,,0000,0000,0000,,!مع هذه الحرارة
Dialogue: 0,0:07:57.67,0:08:00.15,Default,,0000,0000,0000,,فقط كاميرا مراقبة واحدة
Dialogue: 0,0:08:00.15,0:08:01.78,Default,,0000,0000,0000,,!هذا رائع
Dialogue: 0,0:08:10.11,0:08:12.02,Default,,0000,0000,0000,,!أكلتُ كثيراً
Dialogue: 0,0:08:12.31,0:08:15.98,Default,,0000,0000,0000,,لم يظهر المالك أبداً
Dialogue: 0,0:08:16.40,0:08:20.23,Default,,0000,0000,0000,,!ناديه بسرعة وليبدأ تصحيح الاختبارات
Dialogue: 0,0:08:20.23,0:08:25.65,Default,,0000,0000,0000,,لـ-لكنه أخبرني أن أهتم بخدمتكم ريثما يصل
Dialogue: 0,0:08:27.30,0:08:31.27,Default,,0000,0000,0000,,كودو ليس موجوداً، كان عليّ ألا آتي لهذه الجولة
Dialogue: 0,0:08:33.44,0:08:36.08,Default,,0000,0000,0000,,!تبّاً! اكتفيت
Dialogue: 0,0:08:36.08,0:08:37.42,Default,,0000,0000,0000,,!سأذهب لأستريح في غرفتي
Dialogue: 0,0:08:37.42,0:08:38.08,Default,,0000,0000,0000,,!سيّدي
Dialogue: 0,0:08:38.08,0:08:40.85,Default,,0000,0000,0000,,يبدو أنّ الشائعات كانت صحيحة
Dialogue: 0,0:08:41.28,0:08:43.07,Default,,0000,0000,0000,,كان يكذب عندما قال أنّه سيقدّم
Dialogue: 0,0:08:43.07,0:08:44.62,Default,,0000,0000,0000,,نسخة إصدار أوّل للفائز بالمسابقة
Dialogue: 0,0:08:44.62,0:08:46.37,Default,,0000,0000,0000,,يتصنع عيوباً في إجابات المشاركين كلّ مرة
Dialogue: 0,0:08:46.37,0:08:48.03,Default,,0000,0000,0000,,ولا يجعل أحداً يفوز
Dialogue: 0,0:08:48.03,0:08:51.31,Default,,0000,0000,0000,,يقيم هذه الجولة للاستعراض بكتابه وحسب
Dialogue: 0,0:08:51.61,0:08:54.11,Default,,0000,0000,0000,,آسفة، لكنّي سأذهب للنوم أيضاً
Dialogue: 0,0:08:54.11,0:08:55.31,Default,,0000,0000,0000,,وأنا
Dialogue: 0,0:08:55.31,0:08:56.15,Default,,0000,0000,0000,,...عذراً
Dialogue: 0,0:08:56.15,0:08:59.31,Default,,0000,0000,0000,,سخافة، سأخلد للنوم بدوري
Dialogue: 0,0:08:59.31,0:09:00.75,Default,,0000,0000,0000,,ماذا ستفعل يا كونان-كن؟
Dialogue: 0,0:09:00.75,0:09:02.61,Default,,0000,0000,0000,,سأبقى هنا
Dialogue: 0,0:09:08.47,0:09:10.85,Default,,0000,0000,0000,,...وصلت حدّي أيضاً
Dialogue: 0,0:09:11.42,0:09:14.96,Default,,0000,0000,0000,,كينتو، لنعد إلى غرفتنا كذلك
Dialogue: 0,0:09:14.96,0:09:18.82,Default,,0000,0000,0000,,اصبري، الإقدام على حركة\Nفي وقت كهذا يعني الخسارة
Dialogue: 0,0:09:19.25,0:09:22.27,Default,,0000,0000,0000,,ماذا؟ أليست السيّارة التي أتينا بها؟
Dialogue: 0,0:09:22.27,0:09:25.36,Default,,0000,0000,0000,,!ذاك المالك! إنّه يقودها
Dialogue: 0,0:09:25.36,0:09:28.83,Default,,0000,0000,0000,,رأيتم؟ ستبدأ مسابقة التحرّي أخيراً
Dialogue: 0,0:09:28.83,0:09:30.32,Default,,0000,0000,0000,,كما يُتوقّع منك يا كينتو
Dialogue: 0,0:09:32.61,0:09:34.02,Default,,0000,0000,0000,,...لـ-لحظة
Dialogue: 0,0:09:34.02,0:09:35.07,Default,,0000,0000,0000,,أمامه جرف
Dialogue: 0,0:09:40.82,0:09:42.61,Default,,0000,0000,0000,,!كلا! ارتفعت السرعة
Dialogue: 0,0:09:43.43,0:09:45.56,Default,,0000,0000,0000,,أنت، يا سيّد! ما الذي تفعله؟
Dialogue: 0,0:09:45.56,0:09:46.98,Default,,0000,0000,0000,,!أوقف السيّارة قبل أن تسقط
Dialogue: 0,0:09:47.39,0:09:48.86,Default,,0000,0000,0000,,!توجد مُلاءة على مقصورة السيّارة
Dialogue: 0,0:09:49.22,0:09:52.06,Default,,0000,0000,0000,,وما هذا الصوت؟ ليس صوت المحرك
Dialogue: 0,0:09:52.06,0:09:55.30,Default,,0000,0000,0000,,!أنت! يا سيّد! أتسمعني؟
Dialogue: 0,0:10:12.19,0:10:14.48,Default,,0000,0000,0000,,ماذا؟ مات المالك؟
Dialogue: 0,0:10:15.03,0:10:16.40,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:10:16.40,0:10:20.36,Default,,0000,0000,0000,,قاد السيّارة حتى سقط من الجرف \Nأمام أنظارنا قبل قليل
Dialogue: 0,0:10:20.36,0:10:22.97,Default,,0000,0000,0000,,لا يُعقل! لمَ قد يفعل ذلك؟
Dialogue: 0,0:10:22.97,0:10:25.15,Default,,0000,0000,0000,,كان انتحاراً
Dialogue: 0,0:10:25.56,0:10:29.65,Default,,0000,0000,0000,,لم يرد مفارقة إصدار كتاب هولمز\Nالأوّل خاصته غالباً
Dialogue: 0,0:10:29.65,0:10:33.26,Default,,0000,0000,0000,,كلا، قد تكون جريمة قتل
Dialogue: 0,0:10:34.17,0:10:37.51,Default,,0000,0000,0000,,نوّم أحدهم المالك أو قتله سلفاً
Dialogue: 0,0:10:37.51,0:10:39.80,Default,,0000,0000,0000,,ثم أجلسه في مقعد السيّارة
Dialogue: 0,0:10:39.80,0:10:44.52,Default,,0000,0000,0000,,ووضع ناقل الحركة في وضعية القيادة\Nلتتحرك من نفسها تلقائياً
Dialogue: 0,0:10:44.52,0:10:48.49,Default,,0000,0000,0000,,قام القاتل بكلّ ذلك\Nداخل ذاك المرآب غالباً
Dialogue: 0,0:10:48.49,0:10:51.44,Default,,0000,0000,0000,,أيعني هذا أنّ القاتل أحدنا؟
Dialogue: 0,0:10:51.44,0:10:52.94,Default,,0000,0000,0000,,أجل، غالباً
Dialogue: 0,0:10:52.94,0:10:56.44,Default,,0000,0000,0000,,ربما، لكن ارتفعت سرعة السيّارة في مرحلة
Dialogue: 0,0:10:56.44,0:11:00.52,Default,,0000,0000,0000,,كما كان هناك صوت أشبه بهسيس بالرياح من داخلها
Dialogue: 0,0:11:00.52,0:11:02.10,Default,,0000,0000,0000,,لم يكن المحرك
Dialogue: 0,0:11:02.81,0:11:05.64,Default,,0000,0000,0000,,لا بد أنّه كان صوت جهاز التبريد
Dialogue: 0,0:11:05.64,0:11:08.77,Default,,0000,0000,0000,,،كان مفتاحه مضبوطاً على التشغيل\Nفعندما أدار المحرك
Dialogue: 0,0:11:08.77,0:11:10.36,Default,,0000,0000,0000,,اشتغل تلقائياً
Dialogue: 0,0:11:10.36,0:11:13.51,Default,,0000,0000,0000,,بأيّ حال، لا يمكننا استرجاع جثته
Dialogue: 0,0:11:13.51,0:11:16.80,Default,,0000,0000,0000,,خيارنا الوحيد هو الاتّصال بالشرطة والانتظار
Dialogue: 0,0:11:16.80,0:11:19.32,Default,,0000,0000,0000,,لكنّ المالك أخذ كلّ هواتفنا
Dialogue: 0,0:11:19.32,0:11:22.06,Default,,0000,0000,0000,,!لا بدّ أنّها في غرفته
Dialogue: 0,0:11:23.27,0:11:26.12,Default,,0000,0000,0000,,ماذا؟ لمَ تنظر لآثار الإطارات؟
Dialogue: 0,0:11:26.12,0:11:27.69,Default,,0000,0000,0000,,...أبحث عن شيء فحسب
Dialogue: 0,0:11:31.24,0:11:33.07,Default,,0000,0000,0000,,حتّى أنت يا هاتّوري-كن
Dialogue: 0,0:11:33.07,0:11:35.61,Default,,0000,0000,0000,,لا تنظري لي! كنتُ أتحقق ما إن كان
Dialogue: 0,0:11:35.61,0:11:37.90,Default,,0000,0000,0000,,!جهاز التبريد يعمل أم لا فحسب
Dialogue: 0,0:11:37.90,0:11:39.49,Default,,0000,0000,0000,,...ثمّ ارتطمتُ بهذا الصبيّ مُجدداً
Dialogue: 0,0:11:40.77,0:11:41.56,Default,,0000,0000,0000,,مُجدداً؟
Dialogue: 0,0:11:44.19,0:11:46.72,Default,,0000,0000,0000,,ارتطم بي عندما كنت\Nأبحث عن دليل
Dialogue: 0,0:11:46.72,0:11:48.90,Default,,0000,0000,0000,,في القضيّة السابقة أيضاً
Dialogue: 0,0:11:48.90,0:11:50.52,Default,,0000,0000,0000,,لا يمكن الرؤية في الظلام، صحيح؟
Dialogue: 0,0:11:50.52,0:11:52.27,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:11:53.98,0:11:56.94,Default,,0000,0000,0000,,ما رأيكما بهذا أيّها المتحرّيان الصغيران؟
Dialogue: 0,0:11:56.94,0:11:58.24,Default,,0000,0000,0000,,.شكراً
Dialogue: 0,0:11:58.24,0:11:59.36,Default,,0000,0000,0000,,نقدّر هذا
Dialogue: 0,0:11:59.84,0:12:01.31,Default,,0000,0000,0000,,!حُطّمت الهواتف
Dialogue: 0,0:12:01.31,0:12:03.44,Default,,0000,0000,0000,,مـ-من قد يفعل هذا؟
Dialogue: 0,0:12:03.44,0:12:05.36,Default,,0000,0000,0000,,!اختفت نسخة الإصدار الأوّل أيضاً
Dialogue: 0,0:12:07.32,0:12:09.21,Default,,0000,0000,0000,,!تبّاً! اكتفيت
Dialogue: 0,0:12:09.21,0:12:12.07,Default,,0000,0000,0000,,...لنستقلّ السيّارة الأخرى ونخرج من هذا المكان
Dialogue: 0,0:12:12.07,0:12:13.27,Default,,0000,0000,0000,,لا يمكن
Dialogue: 0,0:12:13.74,0:12:17.70,Default,,0000,0000,0000,,ثُقب خزان وقود السيّارة في المرآب
Dialogue: 0,0:12:17.70,0:12:20.56,Default,,0000,0000,0000,,وتسرّب كل البنزين
Dialogue: 0,0:12:20.56,0:12:22.56,Default,,0000,0000,0000,,فوق ذلك نُزعت البطّارية
Dialogue: 0,0:12:22.56,0:12:24.73,Default,,0000,0000,0000,,لن تتحرك تلك السيّارة أبداً
Dialogue: 0,0:12:24.73,0:12:27.35,Default,,0000,0000,0000,,لا-لا يُعقل
Dialogue: 0,0:12:27.35,0:12:31.15,Default,,0000,0000,0000,,يبدو أنّ المالك قُتل بيدي أحدهم حقّاً\Nيا حضرة المتحرّي
Dialogue: 0,0:12:31.89,0:12:37.26,Default,,0000,0000,0000,,تبقى الحيلة التي استعملها القاتل\Nلرفع سرعة السيّارة لغزاً
Dialogue: 0,0:12:37.26,0:12:40.01,Default,,0000,0000,0000,,...لكنّ احتجازنا هنا يعني
Dialogue: 0,0:12:41.04,0:12:44.94,Default,,0000,0000,0000,,!أنّه لا يزال ينوي إكمال مسرحية القتل هذه
Dialogue: 0,0:12:48.96,0:12:52.32,Default,,0000,0000,0000,,أيّاً يكن، القاتل بيننا
Dialogue: 0,0:12:52.32,0:12:54.77,Default,,0000,0000,0000,,سنستأصله إذا أجرينا تحقيقاً دقيقاً
Dialogue: 0,0:12:54.77,0:12:59.11,Default,,0000,0000,0000,,!صـ-صحيح! ربما التقطت كاميرات المراقبة شيئاً
Dialogue: 0,0:12:59.11,0:13:02.06,Default,,0000,0000,0000,,آ-آسفة، تلك مزيّفة
Dialogue: 0,0:13:03.11,0:13:05.44,Default,,0000,0000,0000,,يركّبها كل عام لهذه الجولة
Dialogue: 0,0:13:05.44,0:13:06.59,Default,,0000,0000,0000,,بدبابيس تثبيت
Dialogue: 0,0:13:06.59,0:13:07.53,Default,,0000,0000,0000,,دبابيس تثبيت؟
Dialogue: 0,0:13:07.53,0:13:09.81,Default,,0000,0000,0000,,مع ذلك، نعرف أنّ القاتل وضع المالك
Dialogue: 0,0:13:09.81,0:13:13.61,Default,,0000,0000,0000,,في السيّارة وحرّكهما عند قرابة الثالثة والنصف
Dialogue: 0,0:13:14.05,0:13:16.30,Default,,0000,0000,0000,,وأنّ فعل ذلك كان مستحيلاً لنا نحن الخمسة
Dialogue: 0,0:13:16.30,0:13:20.42,Default,,0000,0000,0000,,الذين كنا في غرفة المعيشة\Nلعدّة ساعات قبلها
Dialogue: 0,0:13:20.42,0:13:21.46,Default,,0000,0000,0000,,مهلك
Dialogue: 0,0:13:21.46,0:13:25.86,Default,,0000,0000,0000,,أتقصد أنّ القاتل كان أحدنا الخمسة\Nالذين لم يكونوا في غرفة المعيشة؟
Dialogue: 0,0:13:25.86,0:13:28.78,Default,,0000,0000,0000,,!لا تحسبني معهم رجاءً
Dialogue: 0,0:13:28.78,0:13:29.71,Default,,0000,0000,0000,,أخبرني
Dialogue: 0,0:13:29.71,0:13:32.03,Default,,0000,0000,0000,,أوجدتَ ما كنت تبحث عنه قبلاً؟
Dialogue: 0,0:13:32.03,0:13:33.45,Default,,0000,0000,0000,,كلا، البتّة
Dialogue: 0,0:13:33.45,0:13:34.20,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:13:37.74,0:13:39.03,Default,,0000,0000,0000,,أ-أياكو؟
Dialogue: 0,0:13:39.33,0:13:44.48,Default,,0000,0000,0000,,اكتشفتُ هويّة القاتل كما حيلته
Dialogue: 0,0:13:49.03,0:13:51.02,Default,,0000,0000,0000,,بالإضافة للدليل الدامغ
Dialogue: 0,0:13:51.98,0:13:52.94,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:53.14,0:13:54.97,Default,,0000,0000,0000,,سأعطيك 10 دقائق
Dialogue: 0,0:13:54.97,0:13:57.31,Default,,0000,0000,0000,,إذا لم ترد أن أنطق باسمك
Dialogue: 0,0:13:57.31,0:13:59.90,Default,,0000,0000,0000,,فعليك الاعتراف قبلها
Dialogue: 0,0:13:59.90,0:14:01.84,Default,,0000,0000,0000,,أياكو! أين تذهبين؟
Dialogue: 0,0:14:01.84,0:14:02.71,Default,,0000,0000,0000,,الحمّام
Dialogue: 0,0:14:02.71,0:14:05.73,Default,,0000,0000,0000,,أأنتِ حمقاء؟ قد يستهدفكِ القاتل\N!إن ذهبتِ بمفردك
Dialogue: 0,0:14:06.13,0:14:08.71,Default,,0000,0000,0000,,لكنّك ستحميني، أليس كذلك؟
Dialogue: 0,0:14:08.71,0:14:10.56,Default,,0000,0000,0000,,!انتظري
Dialogue: 0,0:14:10.91,0:14:12.87,Default,,0000,0000,0000,,سمعتك كمتحرٍّ عظيم على المحك
Dialogue: 0,0:14:13.37,0:14:14.86,Default,,0000,0000,0000,,إنّها تتحايل غالباً
Dialogue: 0,0:14:15.16,0:14:20.19,Default,,0000,0000,0000,,كلا، لا بدّ أنها وجدت دليلاً\Nلا نزال نجهله
Dialogue: 0,0:14:20.19,0:14:21.65,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:14:22.53,0:14:25.77,Default,,0000,0000,0000,,بالمناسبة، كانت أياكو-سان تتصرف بغرابة\Nنوعاً ما ظهيرة اليوم
Dialogue: 0,0:14:26.86,0:14:31.94,Default,,0000,0000,0000,,التقيتُ بها في طريق عودتي\Nللغرفة بعد الغداء
Dialogue: 0,0:14:32.22,0:14:37.40,Default,,0000,0000,0000,,عندما رأتني، أخفت أوراقاً بسرعة وراءها
Dialogue: 0,0:14:37.40,0:14:42.35,Default,,0000,0000,0000,,أظنّه كان اختبار هولمز\Nالذي وُزّع البارحة
Dialogue: 0,0:14:42.35,0:14:43.31,Default,,0000,0000,0000,,الاختبار؟
Dialogue: 0,0:14:43.31,0:14:44.23,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:14:44.23,0:14:45.27,Default,,0000,0000,0000,,كانت تغشّ؟
Dialogue: 0,0:14:45.27,0:14:47.13,Default,,0000,0000,0000,,يا للوضاعة
Dialogue: 0,0:14:49.07,0:14:51.08,Default,,0000,0000,0000,,أنت! من القاتل؟
Dialogue: 0,0:14:51.08,0:14:52.44,Default,,0000,0000,0000,,سألتها سرّاً، صحيح؟
Dialogue: 0,0:14:52.44,0:14:53.52,Default,,0000,0000,0000,,!أخبرنا رجاءً
Dialogue: 0,0:14:53.52,0:14:55.45,Default,,0000,0000,0000,,قالت أنّها لن تخبر أحداً حتّى أنا
Dialogue: 0,0:14:55.45,0:14:57.99,Default,,0000,0000,0000,,وأغلقت على نفسها في الحمام
Dialogue: 0,0:14:57.99,0:15:00.69,Default,,0000,0000,0000,,!تبّاً! تستفزنا
Dialogue: 0,0:15:01.44,0:15:02.44,Default,,0000,0000,0000,,...أخبريني أيّتها الخادمة
Dialogue: 0,0:15:02.65,0:15:04.90,Default,,0000,0000,0000,,كان هناك آخرون لم يحضروا الغداء
Dialogue: 0,0:15:04.90,0:15:06.90,Default,,0000,0000,0000,,مع أياكو-سان، صحيح؟
Dialogue: 0,0:15:06.90,0:15:12.10,Default,,0000,0000,0000,,أجل، توغانو كينتو-سان وشيميزو ناناكو-سان
Dialogue: 0,0:15:14.73,0:15:19.56,Default,,0000,0000,0000,,بأيّ حال، كونها مشبوهة بالغشّ الآن
Dialogue: 0,0:15:19.56,0:15:22.10,Default,,0000,0000,0000,,يعني أنّ أياكو-سان كانت تعرف منذ البداية
Dialogue: 0,0:15:22.47,0:15:25.22,Default,,0000,0000,0000,,أنّ كاميرات المراقبة تلك كانت نماذج مزيّفة
Dialogue: 0,0:15:25.22,0:15:26.84,Default,,0000,0000,0000,,أخبرني يا أوني-تشان
Dialogue: 0,0:15:27.28,0:15:30.83,Default,,0000,0000,0000,,هل أتت أياكو-سان لغرفتك ظهيرة اليوم؟
Dialogue: 0,0:15:30.83,0:15:34.50,Default,,0000,0000,0000,,كلا، حللتُ بقية الاختبار في غرفتي
Dialogue: 0,0:15:34.50,0:15:36.11,Default,,0000,0000,0000,,لكن لم يأت أحد
Dialogue: 0,0:15:38.62,0:15:42.45,Default,,0000,0000,0000,,ما يعني أنّها رأت في غرفة أحدهم
Dialogue: 0,0:15:42.45,0:15:44.98,Default,,0000,0000,0000,,شيئاً مهمّاً مرتبطاً بالقضيّة
Dialogue: 0,0:15:44.98,0:15:47.36,Default,,0000,0000,0000,,...شيء كان في غرفة أحد هؤلاء الأربعة
Dialogue: 0,0:15:47.36,0:15:48.74,Default,,0000,0000,0000,,الذين لا يملكون حجّة غياب
Dialogue: 0,0:15:49.45,0:15:51.85,Default,,0000,0000,0000,,ألم تتأخر أياكو-سان؟
Dialogue: 0,0:15:51.85,0:15:53.77,Default,,0000,0000,0000,,...صـ-صحيح
Dialogue: 0,0:15:53.77,0:15:56.32,Default,,0000,0000,0000,,مضت أكثر من 20 دقيقة
Dialogue: 0,0:15:56.32,0:15:57.99,Default,,0000,0000,0000,,...أ-أيمكن
Dialogue: 0,0:15:59.23,0:16:01.55,Default,,0000,0000,0000,,!أياكو-سان! أياكو-سان
Dialogue: 0,0:16:02.18,0:16:03.61,Default,,0000,0000,0000,,لمَ الجلبة؟
Dialogue: 0,0:16:04.80,0:16:07.63,Default,,0000,0000,0000,,من غير اللبق أن تجتمعوا عند الحمام
Dialogue: 0,0:16:07.63,0:16:10.81,Default,,0000,0000,0000,,...كلا، كنا قلقين عليك
Dialogue: 0,0:16:10.81,0:16:15.23,Default,,0000,0000,0000,,!كما نريدك أن تخبرينا عن هوية القاتل
Dialogue: 0,0:16:15.23,0:16:16.96,Default,,0000,0000,0000,,ذاك؟
Dialogue: 0,0:16:16.96,0:16:19.95,Default,,0000,0000,0000,,يبدو أنّي ارتكبت خطأً
Dialogue: 0,0:16:20.78,0:16:22.40,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:16:23.11,0:16:25.61,Default,,0000,0000,0000,,يا إلهي، كان تحايلاً بالفعل إذاً
Dialogue: 0,0:16:26.03,0:16:29.66,Default,,0000,0000,0000,,لمَ؟ لمَ تغيّر سلوكها فجأةً؟
Dialogue: 0,0:16:29.66,0:16:33.23,Default,,0000,0000,0000,,!تبّاً! وهناك أشياء كثيرة لا نعرفها
Dialogue: 0,0:16:37.02,0:16:38.90,Default,,0000,0000,0000,,ماذا؟ أين أياكو-سان؟
Dialogue: 0,0:16:39.15,0:16:42.55,Default,,0000,0000,0000,,ذهبت للتمشّي في الخارج
Dialogue: 0,0:16:42.55,0:16:43.76,Default,,0000,0000,0000,,حاولنا إيقافها
Dialogue: 0,0:16:43.76,0:16:45.73,Default,,0000,0000,0000,,لكنّها قالت أنّه لن تقع\Nالمزيد من الجرائم
Dialogue: 0,0:16:46.22,0:16:49.14,Default,,0000,0000,0000,,...حسناً، المشتبه بهم الأربعة جميعاً هنا، لذا
Dialogue: 0,0:16:49.14,0:16:51.25,Default,,0000,0000,0000,,لن يحصل شيء إن بقينا مكاننا
Dialogue: 0,0:16:53.94,0:16:55.27,Default,,0000,0000,0000,,!ما كان ذاك الصوت؟
Dialogue: 0,0:16:55.27,0:16:56.73,Default,,0000,0000,0000,,!أتى من المرآب
Dialogue: 0,0:16:56.73,0:16:57.96,Default,,0000,0000,0000,,!ماذا حصل بالضبط؟
Dialogue: 0,0:17:01.74,0:17:03.90,Default,,0000,0000,0000,,أيمكن أنّ أياكو-سان في الداخل؟
Dialogue: 0,0:17:03.90,0:17:06.23,Default,,0000,0000,0000,,!أياكو... أياكو
Dialogue: 0,0:17:06.23,0:17:09.70,Default,,0000,0000,0000,,!أحمق! إذا دخلت ستموت حرقاً وحسب
Dialogue: 0,0:17:09.70,0:17:11.34,Default,,0000,0000,0000,,!ليجلب أحد مطفأة حريق
Dialogue: 0,0:17:11.34,0:17:12.52,Default,,0000,0000,0000,,!توجد واحدة هناك
Dialogue: 0,0:17:12.52,0:17:15.19,Default,,0000,0000,0000,,!أرجوكم! ليخمدها أحد بسرعة
Dialogue: 0,0:17:15.19,0:17:16.86,Default,,0000,0000,0000,,...وإلّا الكتاب
Dialogue: 0,0:17:24.51,0:17:25.93,Default,,0000,0000,0000,,يبدو أنّنا أخمدناها
Dialogue: 0,0:17:25.93,0:17:27.94,Default,,0000,0000,0000,,!أياكو! أين أنت؟
Dialogue: 0,0:17:29.90,0:17:32.12,Default,,0000,0000,0000,,!أأنت هنا؟ أياكو
Dialogue: 0,0:17:37.59,0:17:38.54,Default,,0000,0000,0000,,!ما الخطب؟
Dialogue: 0,0:17:41.28,0:17:42.87,Default,,0000,0000,0000,,أياكو؟
Dialogue: 0,0:17:44.37,0:17:49.13,Default,,0000,0000,0000,,!أياكو! أياكو
Dialogue: 0,0:17:51.57,0:17:55.52,Default,,0000,0000,0000,,بناءً على الثياب والبنية، لا شكّ أنها كانت هي
Dialogue: 0,0:17:55.90,0:17:58.65,Default,,0000,0000,0000,,...كانت بخير تماماً قبل قليل
Dialogue: 0,0:17:58.65,0:18:02.02,Default,,0000,0000,0000,,...بالمناسبة، قالت أنّها عرفت من القاتل
Dialogue: 0,0:18:02.02,0:18:05.23,Default,,0000,0000,0000,,قتلها لإبقائها صامتة إذاً؟
Dialogue: 0,0:18:05.23,0:18:09.76,Default,,0000,0000,0000,,لكن أعتقد أنّ جميع المشتبه بهم\Nكانوا في نُزل المالك
Dialogue: 0,0:18:09.76,0:18:12.69,Default,,0000,0000,0000,,عندما شبّ الحريق في المرآب
Dialogue: 0,0:18:12.69,0:18:14.13,Default,,0000,0000,0000,,من أشعله إذاً؟
Dialogue: 0,0:18:14.13,0:18:15.80,Default,,0000,0000,0000,,لن يبدأ من تلقاء نفسه
Dialogue: 0,0:18:15.80,0:18:20.14,Default,,0000,0000,0000,,كلا، كان بإمكان شخص فعل ذلك
Dialogue: 0,0:18:20.26,0:18:21.66,Default,,0000,0000,0000,,!المالك
Dialogue: 0,0:18:21.66,0:18:25.49,Default,,0000,0000,0000,,،سقط من الجرف بالسيّارة\Nلكن ألن تتصل كل الخيوط
Dialogue: 0,0:18:25.49,0:18:28.07,Default,,0000,0000,0000,,إن كان حيّاً؟
Dialogue: 0,0:18:28.07,0:18:32.73,Default,,0000,0000,0000,,أ-أجل! إذا كان ما في السيّارة\N...دمية وما شابه، عندها
Dialogue: 0,0:18:32.73,0:18:34.78,Default,,0000,0000,0000,,...كانت هناك رواية كذلك
Dialogue: 0,0:18:34.78,0:18:39.65,Default,,0000,0000,0000,,كلا، كان المالك بشحمه ولحمه من في السيّارة
Dialogue: 0,0:18:39.65,0:18:42.23,Default,,0000,0000,0000,,!رأيتُه أيضاً! فلا شكّ برأيي
Dialogue: 0,0:18:42.23,0:18:45.27,Default,,0000,0000,0000,,!من فعل هذا إذاً؟
Dialogue: 0,0:18:45.27,0:18:47.77,Default,,0000,0000,0000,,!قتل أحدهم أياكو
Dialogue: 0,0:18:47.77,0:18:48.78,Default,,0000,0000,0000,,!اهدأ
Dialogue: 0,0:18:48.78,0:18:53.73,Default,,0000,0000,0000,,بأيّ حال، من الواضح أنّ القاتل\Nليس أحدنا العشرة
Dialogue: 0,0:18:54.09,0:18:57.92,Default,,0000,0000,0000,,لنرجع للمنزل حالياً وننتظر الصباح
Dialogue: 0,0:18:57.92,0:18:59.60,Default,,0000,0000,0000,,لنبق في غرفة المعيشة إذاً
Dialogue: 0,0:19:05.41,0:19:08.19,Default,,0000,0000,0000,,!كأنّي سأخلط بين دمية وبشريّ
Dialogue: 0,0:19:08.19,0:19:11.65,Default,,0000,0000,0000,,لكن كان كلّ المشتبه بهم في الغرفة
Dialogue: 0,0:19:11.65,0:19:15.40,Default,,0000,0000,0000,,أيمكن أن أحدهم وضع\Nجهاز تفجير مؤقت في المرآب؟
Dialogue: 0,0:19:15.40,0:19:17.11,Default,,0000,0000,0000,,كلا، لم يكن هناك شيئاً كهذا
Dialogue: 0,0:19:17.11,0:19:19.57,Default,,0000,0000,0000,,كيف أشعل القاتل الحريق إذاً؟
Dialogue: 0,0:19:19.57,0:19:22.52,Default,,0000,0000,0000,,...نجهل ذلك لذا نحن الآن
Dialogue: 0,0:19:22.52,0:19:24.99,Default,,0000,0000,0000,,ولمَ كانت أياكو-سان\Nفي المرآب بالأساس؟
Dialogue: 0,0:19:34.22,0:19:35.59,Default,,0000,0000,0000,,المطر يهطل بغزارة
Dialogue: 0,0:19:35.59,0:19:39.55,Default,,0000,0000,0000,,لن نستطيع الخروج حتّى الصباح\Nإن استمرّ هذا الهطول
Dialogue: 0,0:19:39.55,0:19:42.29,Default,,0000,0000,0000,,تعبتُ من السهر، كما أتضوّر جوعاً
Dialogue: 0,0:19:42.29,0:19:45.91,Default,,0000,0000,0000,,هل أعدّ قهوة وأكلاً بارداً معها إذاً؟
Dialogue: 0,0:19:45.91,0:19:47.44,Default,,0000,0000,0000,,!سأساعدك
Dialogue: 0,0:19:47.44,0:19:49.62,Default,,0000,0000,0000,,سأرافقكما إذاً
Dialogue: 0,0:19:49.62,0:19:51.95,Default,,0000,0000,0000,,فسنقلق عليكما إن كنتما بمفردكما
Dialogue: 0,0:19:51.95,0:19:53.40,Default,,0000,0000,0000,,سآتي أيضاً
Dialogue: 0,0:19:55.61,0:19:58.40,Default,,0000,0000,0000,,لكن إذا كان المالك هو الفاعل حقاً
Dialogue: 0,0:19:58.40,0:20:02.23,Default,,0000,0000,0000,,فلمَ تظاهر بالموت ثمّ قتل أياكو-سان؟
Dialogue: 0,0:20:04.14,0:20:07.15,Default,,0000,0000,0000,,!إنّه يستمتع بالقتل
Dialogue: 0,0:20:07.48,0:20:09.06,Default,,0000,0000,0000,,!انظروا لهذه البطاقة
Dialogue: 0,0:20:09.06,0:20:11.35,Default,,0000,0000,0000,,!كنتُ لألقى حتفي لو لم أتوخ الحذر
Dialogue: 0,0:20:13.63,0:20:17.18,Default,,0000,0000,0000,,إذا أردت الكتاب فتعال للمرآب"\Nالخامسة صباح الغد
Dialogue: 0,0:20:17.18,0:20:20.06,Default,,0000,0000,0000,,"سأضعه أسفل المقعد الخلفيّ
Dialogue: 0,0:20:20.06,0:20:24.62,Default,,0000,0000,0000,,نشب الحريق في المرآب\Nبعد الرابعة والنصف وفقما أظن
Dialogue: 0,0:20:24.62,0:20:28.49,Default,,0000,0000,0000,,المقعد الخلفيّ؟ كانت هناك جثّة أياكو-سان
Dialogue: 0,0:20:28.96,0:20:31.24,Default,,0000,0000,0000,,من أين أتتك البطاقة؟
Dialogue: 0,0:20:31.24,0:20:35.57,Default,,0000,0000,0000,,وجدتُها عالقةً في باب غرفتي\Nعندما رجعت من العشاء البارحة
Dialogue: 0,0:20:35.57,0:20:37.53,Default,,0000,0000,0000,,!هكذا إذاً! اكتشفت الأمر
Dialogue: 0,0:20:37.53,0:20:38.78,Default,,0000,0000,0000,,اسمع أيّها الرجل المُسن
Dialogue: 0,0:20:38.78,0:20:42.81,Default,,0000,0000,0000,,!كم مرّةً عليّ إخبارك؟! المالك ميت
Dialogue: 0,0:20:42.81,0:20:45.11,Default,,0000,0000,0000,,كأنّي سأثق بما رآه طفل
Dialogue: 0,0:20:45.11,0:20:45.98,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:46.44,0:20:48.73,Default,,0000,0000,0000,,بناءً على مكان موت أياكو-سان
Dialogue: 0,0:20:48.73,0:20:52.31,Default,,0000,0000,0000,,فيُحتمل أنّها ذهبت للمرآب\Nللحصول على الكتاب أيضاً
Dialogue: 0,0:20:52.31,0:20:55.59,Default,,0000,0000,0000,,ما يعني أنّ اللغز الوحيد\Nالمتبقي في الحادثة الثانية
Dialogue: 0,0:20:55.59,0:20:59.49,Default,,0000,0000,0000,,هو كيف أضرم القاتل النار\Nفي المرآب بينما هو في الغرفة
Dialogue: 0,0:21:00.09,0:21:02.13,Default,,0000,0000,0000,,...بسبب متحرّيين مثلك أصلاً
Dialogue: 0,0:21:02.33,0:21:03.99,Default,,0000,0000,0000,,...توجد قضايا كثيرة عالقة بلا حلّ
Dialogue: 0,0:21:03.99,0:21:05.14,Default,,0000,0000,0000,,!يا للفظاظة
Dialogue: 0,0:21:05.45,0:21:08.10,Default,,0000,0000,0000,,!يحلّ أبي قضاياه كلّ مرة
Dialogue: 0,0:21:08.62,0:21:11.44,Default,,0000,0000,0000,,يتّخذ وضعية نوم متى بدأ بالتحليل دوماً
Dialogue: 0,0:21:11.44,0:21:14.15,Default,,0000,0000,0000,,"فيخشاه الجميع بلقب "كوغورو النائم
Dialogue: 0,0:21:14.15,0:21:15.35,Default,,0000,0000,0000,,صحيح يا أبي؟
Dialogue: 0,0:21:16.07,0:21:17.10,Default,,0000,0000,0000,,النائم؟
Dialogue: 0,0:21:17.10,0:21:18.39,Default,,0000,0000,0000,,تعالي قليلاً
Dialogue: 0,0:21:18.39,0:21:19.06,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:21:20.56,0:21:23.39,Default,,0000,0000,0000,,أين يكون هو بينما يبدأ والدك التحليل؟
Dialogue: 0,0:21:23.39,0:21:24.10,Default,,0000,0000,0000,,هو؟
Dialogue: 0,0:21:24.10,0:21:27.02,Default,,0000,0000,0000,,...أقصد من يتطفل حولكما دوماً
Dialogue: 0,0:21:27.02,0:21:28.48,Default,,0000,0000,0000,,!هذا
Dialogue: 0,0:21:29.22,0:21:30.88,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:21:30.88,0:21:32.71,Default,,0000,0000,0000,,صحيح، لا يكون موجوداً في العادة
Dialogue: 0,0:21:32.71,0:21:33.84,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:21:33.84,0:21:37.30,Default,,0000,0000,0000,,لكنه يظهر من وراء أبي أحياناً
Dialogue: 0,0:21:37.30,0:21:38.84,Default,,0000,0000,0000,,ويساعد بشرح استنتاجاته
Dialogue: 0,0:21:38.84,0:21:39.93,Default,,0000,0000,0000,,من ورائه؟
Dialogue: 0,0:21:41.49,0:21:43.10,Default,,0000,0000,0000,,تساعده من ورائه؟
Dialogue: 0,0:21:43.10,0:21:45.31,Default,,0000,0000,0000,,!أحب لعب لعبة المتحرّي
Dialogue: 0,0:21:45.95,0:21:46.96,Default,,0000,0000,0000,,!انقطاع كهرباء
Dialogue: 0,0:21:46.96,0:21:48.37,Default,,0000,0000,0000,,أيمكن بسبب الصواعق؟
Dialogue: 0,0:21:48.37,0:21:50.53,Default,,0000,0000,0000,,!كلا، إنّه مجرد مِصهر محروق
Dialogue: 0,0:21:50.53,0:21:52.48,Default,,0000,0000,0000,,!أسرعي وأعيدي ضبط القواطع إذاً
Dialogue: 0,0:21:52.48,0:21:54.90,Default,,0000,0000,0000,,...تبّاً، في وقت كهذا
Dialogue: 0,0:21:56.53,0:21:58.89,Default,,0000,0000,0000,,...هنا يا آنسة، استعملي هذا الضوء
Dialogue: 0,0:22:00.02,0:22:00.80,Default,,0000,0000,0000,,!كسّارة ثلج
Dialogue: 0,0:22:05.10,0:22:07.02,Default,,0000,0000,0000,,!ماذا؟! ما الذي جرى؟
Dialogue: 0,0:22:07.02,0:22:08.72,Default,,0000,0000,0000,,!ما كان ذاك الصوت؟
Dialogue: 0,0:22:08.72,0:22:09.30,Default,,0000,0000,0000,,زجاج
Dialogue: 0,0:22:09.30,0:22:09.98,Default,,0000,0000,0000,,!الخادمة
Dialogue: 0,0:22:09.98,0:22:10.89,Default,,0000,0000,0000,,!أعيدوا الكهرباء بسرعة
Dialogue: 0,0:22:13.91,0:22:15.17,Default,,0000,0000,0000,,!فوجيساوا-سان
Dialogue: 0,0:22:15.17,0:22:16.41,Default,,0000,0000,0000,,كيف؟
Dialogue: 0,0:22:16.41,0:22:19.22,Default,,0000,0000,0000,,...أبي! زجاج النافذة
Dialogue: 0,0:22:19.22,0:22:21.67,Default,,0000,0000,0000,,!تبّاً! حطّم النافذة وهرب
Dialogue: 0,0:22:22.03,0:22:26.59,Default,,0000,0000,0000,,...كلا! لا يزال القاتل هنا، كما
Dialogue: 0,0:22:26.59,0:22:31.35,Default,,0000,0000,0000,,كما عرفتُ أخيراً كيف أضرم\Nالقاتل الحريق في المرآب
Dialogue: 0,0:22:31.35,0:22:33.19,Default,,0000,0000,0000,,!وهو في الغرفة
Dialogue: 0,0:23:59.84,0:24:05.67,Default,,0000,0000,0000,,لعلّ الحادثة الثالثة لم تكن\Nضمن حسابات القاتل؟
Dialogue: 0,0:24:05.67,0:24:07.72,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:24:07.72,0:24:11.17,Default,,0000,0000,0000,,لكنّي مجرد طفل، فما الذي أعرفه؟
Dialogue: 0,0:24:11.75,0:24:14.84,Default,,0000,0000,0000,,...لا يلعب لعبة المتحرّي
Dialogue: 0,0:24:14.84,0:24:16.46,Default,,0000,0000,0000,,!إنّه يحلل بدقّة
Dialogue: 0,0:24:16.46,0:24:19.70,Default,,0000,0000,0000,,!صوته وجسده مختلفان، لكنّه يشبه كودو شينتشي
Dialogue: 0,0:24:19.70,0:24:23.37,Default,,0000,0000,0000,,أ-أيمكن أنّه هو حقاً؟
Dialogue: 0,0:24:24.02,0:24:30.01,On Top,,0000,0000,15,,(جريمة قتل مهووس هولمز (الجزء الثاني
Dialogue: 0,0:24:24.20,0:24:25.70,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.70,0:24:28.91,Default,,0000,0000,0000,,(جريمة قتل مهووس هولمز (الجزء الثاني
Dialogue: 0,0:24:45.26,0:24:47.23,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.23,0:24:49.41,Default,,0000,0000,0000,,اختبار طائفة هولمز
Dialogue: 0,0:24:50.15,0:24:52.23,Default,,0000,0000,0000,,في الحلقة القادمة، هويّة كونان\N!الحقيقيّة في خطر
Dialogue: 0,0:24:52.55,0:24:54.23,Default,,0000,0000,0000,,هل اكتشفتُها؟

