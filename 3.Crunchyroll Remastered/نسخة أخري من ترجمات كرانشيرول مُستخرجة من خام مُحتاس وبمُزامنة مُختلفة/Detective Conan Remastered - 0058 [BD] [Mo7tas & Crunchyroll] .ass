Dialogue: 0,0:00:01.00,0:00:02.87,Default,,0000,0000,0000,,،عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:02.87,0:00:05.08,Default,,0000,0000,0000,,دمية آلية الخروج وخزف محطّم
Dialogue: 0,0:00:05.08,0:00:08.27,Default,,0000,0000,0000,,المنطق المفكّك للغموض مفيد\Nفي مواجهة قلوب الناس الجافّة
Dialogue: 0,0:00:08.36,0:00:11.52,Default,,0000,0000,0000,,هويّة كونان الحقيقية تحت خطر\N!اكتشاف هاتّوري هيجي لها
Dialogue: 0,0:00:11.52,0:00:13.02,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:13.36,0:00:14.82,Default,,0000,0000,0000,,!وباستنتاجات لا مُضاهٍ لها
Dialogue: 0,0:00:15.31,0:00:16.52,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:52.43,0:01:57.35,Default,,0000,0000,0000,,ذهبتُ مع العمّ وران في رحلة\Nلمُعجبي شارلوك هولمز
Dialogue: 0,0:01:57.65,0:02:00.64,Default,,0000,0000,0000,,...لكنّ سيّارة كانايا-سان
Dialogue: 0,0:02:00.64,0:02:03.97,Default,,0000,0000,0000,,"مُشرف الرحلة ومالك نُزل "ماي كروفت
Dialogue: 0,0:02:03.97,0:02:06.72,Default,,0000,0000,0000,,سقطت من جرف وانفجرت
Dialogue: 0,0:02:12.29,0:02:16.10,Default,,0000,0000,0000,,وأيضاً بعد عزلنا عن العالم الخارجي
Dialogue: 0,0:02:16.10,0:02:20.16,Default,,0000,0000,0000,,أغلقنا على أنفسنا في النُزل لمنع\Nوقوع المزيد من الضحايا
Dialogue: 0,0:02:20.16,0:02:22.93,Default,,0000,0000,0000,,لكنّ أياكو-سان التي ادّعت\Nاكتشافها لهويّة القاتل
Dialogue: 0,0:02:24.48,0:02:26.07,Default,,0000,0000,0000,,!ماتت في انفجار في المرآب
Dialogue: 0,0:02:27.44,0:02:29.56,Default,,0000,0000,0000,,أكان المالك هو الفاعل؟
Dialogue: 0,0:02:29.56,0:02:32.77,Default,,0000,0000,0000,,أم أحد الضيوف الخمسة الآخرين
Dialogue: 0,0:02:32.77,0:02:34.94,Default,,0000,0000,0000,,باستثنائنا الثلاثة وهاتّوري هيجي؟
Dialogue: 0,0:02:34.94,0:02:39.60,Default,,0000,0000,0000,,في خضّم الأحداث، تعرّض فوجيساوا-سان\Nللهجوم بكسّارة ثلج
Dialogue: 0,0:02:45.85,0:02:51.64,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل مهووس هولمز (الجزء الثاني
Dialogue: 0,0:02:46.43,0:02:50.08,Default,,0000,0000,0000,,(جريمة قتل مهووس هولمز (الجزء الثاني
Dialogue: 0,0:02:52.59,0:02:53.90,Default,,0000,0000,0000,,!من قد يفعل هذا؟
Dialogue: 0,0:02:53.90,0:02:55.10,Default,,0000,0000,0000,,كان المالك
Dialogue: 0,0:02:55.10,0:02:59.03,Default,,0000,0000,0000,,زيّف موته في الحادثة الأولى
Dialogue: 0,0:02:59.03,0:03:01.41,Default,,0000,0000,0000,,واختبأ في مكان ما في النزل
Dialogue: 0,0:03:01.41,0:03:03.77,Default,,0000,0000,0000,,حرق أياكو-سان في المرآب
Dialogue: 0,0:03:03.77,0:03:06.99,Default,,0000,0000,0000,,ثمّ هاجم فوجيساوا-سان بكسّارة ثلج
Dialogue: 0,0:03:06.99,0:03:09.72,Default,,0000,0000,0000,,وهرب بعد تحطيم تلك النافذة
Dialogue: 0,0:03:09.98,0:03:12.73,Default,,0000,0000,0000,,تبّاً! لمَ يريد المالك قتلي؟
Dialogue: 0,0:03:13.48,0:03:16.84,Default,,0000,0000,0000,,!ساعدتُه في الكتاب الذي نشره حتّى
Dialogue: 0,0:03:16.84,0:03:17.52,Default,,0000,0000,0000,,الكتاب؟
Dialogue: 0,0:03:18.35,0:03:21.72,Default,,0000,0000,0000,,كتاب عن هولمز نشره العام الفائت بأمواله
Dialogue: 0,0:03:21.72,0:03:25.02,Default,,0000,0000,0000,,"أظنّ العنوان كان "سخرية آيرين أدلر
Dialogue: 0,0:03:25.51,0:03:26.93,Default,,0000,0000,0000,,آيرين أدلر؟
Dialogue: 0,0:03:28.30,0:03:31.88,Default,,0000,0000,0000,,!حسناً يا ران، سنلاحق المالك
Dialogue: 0,0:03:31.88,0:03:32.68,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:33.09,0:03:34.52,Default,,0000,0000,0000,,لا جدوى، توقّف
Dialogue: 0,0:03:36.09,0:03:39.14,Default,,0000,0000,0000,,لن تجد القاتل بالبحث خارجاً أبداً
Dialogue: 0,0:03:39.62,0:03:40.87,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:40.87,0:03:43.08,Default,,0000,0000,0000,,أمعن النظر لهذا الكرسيّ
Dialogue: 0,0:03:43.08,0:03:45.35,Default,,0000,0000,0000,,ألا ترى أنّه موضوع بشكل\Nغير طبيعيّ في الطرف الضيّق؟
Dialogue: 0,0:03:45.95,0:03:48.07,Default,,0000,0000,0000,,إنّه دليل على أنّ القاتل أدخله في عجلة
Dialogue: 0,0:03:48.07,0:03:50.53,Default,,0000,0000,0000,,بعد تحطيمه النافذة
Dialogue: 0,0:03:50.53,0:03:53.19,Default,,0000,0000,0000,,!هذا صحيح! توجد شظايا زجاج به
Dialogue: 0,0:03:53.19,0:03:55.52,Default,,0000,0000,0000,,!لا بدّ أن الفاعل استعمل هذا الكرسيّ
Dialogue: 0,0:03:56.03,0:03:59.72,Default,,0000,0000,0000,,...لكنّ ذلك يثبت استعمال القاتل للكرسيّ وحسب
Dialogue: 0,0:03:59.72,0:04:02.22,Default,,0000,0000,0000,,أحمق! من قد يهتمّ بإعادة كرسيّ
Dialogue: 0,0:04:02.22,0:04:04.98,Default,,0000,0000,0000,,بعد تحطيمه نافذةً للهرب؟
Dialogue: 0,0:04:05.47,0:04:08.13,Default,,0000,0000,0000,,أمسك الفاعل الكرسيّ بيديه العاريتين غالباً
Dialogue: 0,0:04:08.13,0:04:10.01,Default,,0000,0000,0000,,عندما حطّم النافذة
Dialogue: 0,0:04:10.01,0:04:12.55,Default,,0000,0000,0000,,كان الظلام حالكاً فلا يستطيع مسح البصمات
Dialogue: 0,0:04:12.55,0:04:17.56,Default,,0000,0000,0000,,لذا أرجع الفاعل الكرسيّ تحت الطاولة كيلا نلاحظ
Dialogue: 0,0:04:17.96,0:04:22.67,Default,,0000,0000,0000,,وكي يستطيع مسح البصمات بعد عودة الكهرباء\Nمتوارياً عن الأنظار
Dialogue: 0,0:04:23.04,0:04:25.20,Default,,0000,0000,0000,,بعد عودة الكهرباء؟
Dialogue: 0,0:04:25.20,0:04:28.82,Default,,0000,0000,0000,,...لحظة، كنّا الوحيدين في الغرفة وقتها
Dialogue: 0,0:04:28.82,0:04:29.89,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:30.44,0:04:34.03,Default,,0000,0000,0000,,أفهمتم الآن أنّ المالك لم يكن الفاعل
Dialogue: 0,0:04:34.03,0:04:37.35,Default,,0000,0000,0000,,!وأنّ الفاعل في الغرفة بيننا؟
Dialogue: 0,0:04:40.64,0:04:44.14,Default,,0000,0000,0000,,أيّتها الخادمة، قلتِ أنّ مِصهراً قد احترق
Dialogue: 0,0:04:44.14,0:04:46.65,Default,,0000,0000,0000,,عندما انقطعت الكهرباء، أليس كذلك؟
Dialogue: 0,0:04:46.65,0:04:50.63,Default,,0000,0000,0000,,أجل، عندما حاولتُ إدخال\Nقابس صانعة القهوة
Dialogue: 0,0:04:50.63,0:04:51.97,Default,,0000,0000,0000,,!صدرت شرارة
Dialogue: 0,0:04:53.55,0:04:55.98,Default,,0000,0000,0000,,انظروا، كان هذا المقبس
Dialogue: 0,0:04:56.34,0:04:58.93,Default,,0000,0000,0000,,كان هناك سلك رفيع\Nمربوط حول القابس
Dialogue: 0,0:04:59.54,0:05:02.89,Default,,0000,0000,0000,,كي يحدث انقطاع إذا أدخله أحد
Dialogue: 0,0:05:03.16,0:05:06.96,Default,,0000,0000,0000,,لكن من أين حصل الفاعل على السلك؟
Dialogue: 0,0:05:06.96,0:05:08.10,Default,,0000,0000,0000,,من هذا غالباً
Dialogue: 0,0:05:08.61,0:05:12.06,Default,,0000,0000,0000,,السلك المربوط بأعلى حزمة القهوة هذه
Dialogue: 0,0:05:12.61,0:05:16.65,Default,,0000,0000,0000,,السماكة والطول متطابقان حقاً
Dialogue: 0,0:05:16.65,0:05:18.48,Default,,0000,0000,0000,,من فتح الحزمة؟
Dialogue: 0,0:05:18.48,0:05:20.97,Default,,0000,0000,0000,,كاواتسو-سان وتوغانو-سان
Dialogue: 0,0:05:22.98,0:05:25.06,Default,,0000,0000,0000,,اتّضح الأمر الآن
Dialogue: 0,0:05:25.06,0:05:28.64,Default,,0000,0000,0000,,!أنتَ الفاعل يا كاواتسو-سان
Dialogue: 0,0:05:29.01,0:05:31.76,Default,,0000,0000,0000,,!ا-انتظر قليلاً
Dialogue: 0,0:05:31.76,0:05:34.77,Default,,0000,0000,0000,,كان هناك ثلاثة أشخاص\N...غيري في المطبخ وقتها
Dialogue: 0,0:05:35.09,0:05:36.09,Default,,0000,0000,0000,,!أحمق
Dialogue: 0,0:05:36.09,0:05:41.35,Default,,0000,0000,0000,,!يمتلك أولئك الثلاثة حجج غياب للحادثة الأولى
Dialogue: 0,0:05:41.79,0:05:45.12,Default,,0000,0000,0000,,أخذت السلك من الحزمة عندما\Nلم ينتبه لك أحد غالباً
Dialogue: 0,0:05:45.12,0:05:48.61,Default,,0000,0000,0000,,وربطته حول القابس ثم عدت لغرفة المعيشة
Dialogue: 0,0:05:48.61,0:05:51.22,Default,,0000,0000,0000,,وانتظرت انقطاع الكهرباء
Dialogue: 0,0:05:51.66,0:05:53.57,Default,,0000,0000,0000,,وعندها، في الظلام
Dialogue: 0,0:05:53.57,0:05:56.11,Default,,0000,0000,0000,,هاجمت فوجيساوا-سان بكسّارة ثلج
Dialogue: 0,0:05:56.11,0:05:58.39,Default,,0000,0000,0000,,جلبتها هنا مع قطع ثلج
Dialogue: 0,0:05:58.39,0:06:01.02,Default,,0000,0000,0000,,واستعملت الشعلة من قدّاحته لتحديد موقعه
Dialogue: 0,0:06:01.56,0:06:05.10,Default,,0000,0000,0000,,لكن ظهرت عقبات غير متوقعة ففشلت
Dialogue: 0,0:06:05.10,0:06:06.40,Default,,0000,0000,0000,,أليس ذلك صحيحاً؟
Dialogue: 0,0:06:06.40,0:06:12.34,Default,,0000,0000,0000,,أجل، يبدو ذلك... لكن هنا أمرٌ ما ليس في محلّه
Dialogue: 0,0:06:12.34,0:06:13.06,Default,,0000,0000,0000,,صحيح يا فتى؟
Dialogue: 0,0:06:13.52,0:06:14.34,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:14.34,0:06:17.96,Default,,0000,0000,0000,,الحادثة الثالثة التي تعرّض فيها\Nفوجيساوا-سان للهجوم
Dialogue: 0,0:06:17.96,0:06:20.17,Default,,0000,0000,0000,,تختلف عن الحادثتين السابقتين
Dialogue: 0,0:06:20.17,0:06:22.52,Default,,0000,0000,0000,,من ناحية ترك الفاعل دليلاً وراءه
Dialogue: 0,0:06:23.04,0:06:27.87,Default,,0000,0000,0000,,لعلّ الحادثة الثالثة لم تكن\Nضمن حسابات القاتل؟
Dialogue: 0,0:06:29.07,0:06:30.44,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:06:31.70,0:06:34.73,Default,,0000,0000,0000,,لكنّي مجرد طفل، فما الذي أعرفه؟
Dialogue: 0,0:06:36.86,0:06:38.61,Default,,0000,0000,0000,,!لا تهتموا له
Dialogue: 0,0:06:38.61,0:06:41.73,Default,,0000,0000,0000,,!يحب لعب لعبة المتحرّي فقط
Dialogue: 0,0:06:42.68,0:06:43.56,Default,,0000,0000,0000,,تعال هنا
Dialogue: 0,0:06:44.27,0:06:46.98,Default,,0000,0000,0000,,هناك أمرٌ غريب بهذا الصبيّ
Dialogue: 0,0:06:47.77,0:06:51.43,Default,,0000,0000,0000,,لا يلعب لعبة المتحرّي، إنّه يحلل بدقّة
Dialogue: 0,0:06:52.10,0:06:55.98,Default,,0000,0000,0000,,صوته وجسده مختلفان، لكنّه يشبه كودو
Dialogue: 0,0:06:57.68,0:06:58.79,Default,,0000,0000,0000,,كودو؟
Dialogue: 0,0:06:58.79,0:07:02.04,Default,,0000,0000,0000,,صحيح، عندما ظهر كودو في القضيّة السابقة
Dialogue: 0,0:07:02.04,0:07:04.10,Default,,0000,0000,0000,,اختفى هذا الصبيّ
Dialogue: 0,0:07:04.50,0:07:08.14,Default,,0000,0000,0000,,وعندما اختفى كودو، ظهر مُجدداً
Dialogue: 0,0:07:09.33,0:07:12.40,Default,,0000,0000,0000,,أيمكن أنّه... هو؟
Dialogue: 0,0:07:17.28,0:07:19.47,Default,,0000,0000,0000,,لكن أليس الأمر غريباً حضرة المتحرّي؟
Dialogue: 0,0:07:20.65,0:07:22.73,Default,,0000,0000,0000,,إن كان كاواتسو-سان القاتل حقّاً
Dialogue: 0,0:07:22.73,0:07:26.48,Default,,0000,0000,0000,,كيف أضرم النار في المرآب\Nفي الحادثة الثانية؟
Dialogue: 0,0:07:26.98,0:07:29.18,Default,,0000,0000,0000,,،أيضاً في الحادثة الأولى
Dialogue: 0,0:07:29.18,0:07:34.06,Default,,0000,0000,0000,,ارتفعت سرعة سيّارة المالك\Nقبل سقوطها من الجرف
Dialogue: 0,0:07:34.06,0:07:35.44,Default,,0000,0000,0000,,!صـ-صحيح
Dialogue: 0,0:07:35.44,0:07:37.26,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:37.26,0:07:39.34,Default,,0000,0000,0000,,حللتُ معظم القضيّة الثانية
Dialogue: 0,0:07:39.34,0:07:41.14,Default,,0000,0000,0000,,لكنّ الحادثة الأولى غير مفهومة
Dialogue: 0,0:07:41.63,0:07:45.17,Default,,0000,0000,0000,,ماذا؟ عرفت كيف نشب الحريق في المرآب؟
Dialogue: 0,0:07:45.17,0:07:46.02,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:07:46.63,0:07:49.16,Default,,0000,0000,0000,,بأيّ حال، ما لا أفهمه في الحادثة الأولى
Dialogue: 0,0:07:49.16,0:07:50.26,Default,,0000,0000,0000,,:هو الأشياء الأربعة التالية
Dialogue: 0,0:07:50.87,0:07:54.10,Default,,0000,0000,0000,,لمَ لم نرَ المالك ليوم كامل تقريباً؟
Dialogue: 0,0:07:54.37,0:07:56.56,Default,,0000,0000,0000,,وارتفاع سرعة السيّارة المُفاجئ
Dialogue: 0,0:07:57.12,0:08:00.28,Default,,0000,0000,0000,,والصوت الغريب الصادر من داخلها
Dialogue: 0,0:08:00.28,0:08:02.11,Default,,0000,0000,0000,,بالإضافة للمُلاءة على مقصورتها
Dialogue: 0,0:08:02.94,0:08:06.19,Default,,0000,0000,0000,,واللغز الإضافيّ الذي ظهر\Nعندما أتينا هنا
Dialogue: 0,0:08:06.90,0:08:10.14,Default,,0000,0000,0000,,كان المالك ممسكاً بعجلة القيادة بإحكام
Dialogue: 0,0:08:10.60,0:08:13.10,Default,,0000,0000,0000,,كانت السيّارة على طريق وعر\Nلكن جسده لم يتزحزح أبداً
Dialogue: 0,0:08:14.43,0:08:17.72,Default,,0000,0000,0000,,هذا يعني أنّه عندما وُضع في السيّارة
Dialogue: 0,0:08:17.72,0:08:20.46,Default,,0000,0000,0000,,كان قد قُتل قبل فترة وتصلّبت جثته
Dialogue: 0,0:08:21.13,0:08:22.85,Default,,0000,0000,0000,,تـ-تصلّب الجثة؟
Dialogue: 0,0:08:23.26,0:08:28.33,Default,,0000,0000,0000,,يبدأ الجسد البشريّ بالتصلّب بعد نصف ساعة\Nإلى ساعتين بعد الموت غالباً
Dialogue: 0,0:08:28.33,0:08:31.70,Default,,0000,0000,0000,,وبعد 9 إلى 12 ساعة، يتصلّب الجسد كاملاً
Dialogue: 0,0:08:31.70,0:08:35.45,Default,,0000,0000,0000,,،ثلاثون ساعة بعدها، في أفضل الظروف
Dialogue: 0,0:08:35.45,0:08:38.03,Default,,0000,0000,0000,,تلين الجثّة مُجدداً، وبعد 70 ساعة تقريباً
Dialogue: 0,0:08:38.03,0:08:40.01,Default,,0000,0000,0000,,تعود لحالتها الطبيعية
Dialogue: 0,0:08:41.11,0:08:43.69,Default,,0000,0000,0000,,إذا افترضنا أنّ المالك كان متصلّباً تماماً
Dialogue: 0,0:08:43.69,0:08:46.36,Default,,0000,0000,0000,,عندما وُضع في السيّارة\Nعند الثالثة والنصف صباحاً
Dialogue: 0,0:08:46.36,0:08:50.01,Default,,0000,0000,0000,,فيعني أنّه قُتل بين الثالثة والنصف\Nإلى الخامسة والنصف مساء اليوم السابق
Dialogue: 0,0:08:50.73,0:08:54.23,Default,,0000,0000,0000,,...أي قبل العشاء، لكن
Dialogue: 0,0:08:54.23,0:08:56.64,Default,,0000,0000,0000,,ما لا أفهمه هو لمَ وُضِع المالك
Dialogue: 0,0:08:56.64,0:09:00.05,Default,,0000,0000,0000,,...في السيّارة باكراً هكذا
Dialogue: 0,0:09:00.05,0:09:02.02,Default,,0000,0000,0000,,ليوهم الآخرين أنه انتحر ربما
Dialogue: 0,0:09:02.76,0:09:04.88,Default,,0000,0000,0000,,لعلّ الفاعل قتل المالك قبل العشاء
Dialogue: 0,0:09:04.88,0:09:08.87,Default,,0000,0000,0000,,وأجلسه في السيّارة، ثبّت يديه على عجلة القيادة
Dialogue: 0,0:09:08.87,0:09:12.02,Default,,0000,0000,0000,,وانتظر تصلّبه، ثم ذهب للمرآب بعد العشاء
Dialogue: 0,0:09:12.02,0:09:14.16,Default,,0000,0000,0000,,وشغّل السيارة
Dialogue: 0,0:09:14.16,0:09:14.98,Default,,0000,0000,0000,,ما يعني
Dialogue: 0,0:09:15.54,0:09:19.53,Default,,0000,0000,0000,,أنّ القاتل أحد من غادروا بعد العشاء، بينكم أنتم
Dialogue: 0,0:09:19.53,0:09:22.40,Default,,0000,0000,0000,,لمَ ارتفعت سرعة السيّارة إذاً؟
Dialogue: 0,0:09:22.40,0:09:24.98,Default,,0000,0000,0000,,...لا يمكن أنّ ميتاً قام بذلك
Dialogue: 0,0:09:24.98,0:09:26.69,Default,,0000,0000,0000,,ميت؟
Dialogue: 0,0:09:27.32,0:09:30.10,Default,,0000,0000,0000,,...أيمكن أنّ حيلة الفاعل
Dialogue: 0,0:09:30.64,0:09:33.48,Default,,0000,0000,0000,,في تلك الحالة، لا يمكن أن يكون \Nسوى ذاك الشخص
Dialogue: 0,0:09:33.48,0:09:35.06,Default,,0000,0000,0000,,لكن لا يزال ينقصنا دليل
Dialogue: 0,0:09:35.59,0:09:36.72,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:09:36.72,0:09:40.67,Default,,0000,0000,0000,,قالتْ أن أياكو-سان كانت تتسكّع\Nعند الرواق ظهيرة اليوم
Dialogue: 0,0:09:41.29,0:09:45.68,Default,,0000,0000,0000,,...لو رأت شيئاً في غرفة ذاك الشخص وقتها
Dialogue: 0,0:09:48.53,0:09:49.46,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:09:49.87,0:09:50.63,Default,,0000,0000,0000,,!عرفت
Dialogue: 0,0:09:50.87,0:09:52.38,Default,,0000,0000,0000,,!هويّة المجرم
Dialogue: 0,0:09:54.87,0:09:57.37,Default,,0000,0000,0000,,!أجل، القاتل أنت
Dialogue: 0,0:09:57.37,0:09:59.00,Default,,0000,0000,0000,,!يا قارئة الطالع تودا ماريا-سان
Dialogue: 0,0:09:59.41,0:10:00.92,Default,,0000,0000,0000,,!مـ-ماذا؟
Dialogue: 0,0:10:01.40,0:10:05.81,Default,,0000,0000,0000,,لا بدّ أنّك استعملتِ التنويم المغناطيسيّ\N!لجعل المالك يقود السيّارة
Dialogue: 0,0:10:05.81,0:10:06.72,Default,,0000,0000,0000,,يا للحماقة
Dialogue: 0,0:10:07.06,0:10:10.51,Default,,0000,0000,0000,,...كم أتمنّى استعمال الإبرة المخدّرة
Dialogue: 0,0:10:10.51,0:10:14.12,Default,,0000,0000,0000,,لكن ستكون مشكلةً إن كشفني أثناء التحليل
Dialogue: 0,0:10:14.51,0:10:16.18,Default,,0000,0000,0000,,أخبرني، ماذا يحصل لتصلّب الجثة
Dialogue: 0,0:10:16.18,0:10:18.17,Default,,0000,0000,0000,,إذا ارتفعت الحرارة؟
Dialogue: 0,0:10:18.17,0:10:19.76,Default,,0000,0000,0000,,هل يبدأ بصورة أسرع؟
Dialogue: 0,0:10:20.34,0:10:22.34,Default,,0000,0000,0000,,في تلك الحالة، تعرف من الفاعل، صحيح؟
Dialogue: 0,0:10:24.09,0:10:27.05,Default,,0000,0000,0000,,لا أملك أدنى فكرة، فأنا مغفل
Dialogue: 0,0:10:28.58,0:10:29.87,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:10:29.87,0:10:33.28,Default,,0000,0000,0000,,!يعرف، لكنّه يحاول جعلي أشرح
Dialogue: 0,0:10:33.28,0:10:34.97,Default,,0000,0000,0000,,حسناً، في تلك الحالة
Dialogue: 0,0:10:35.62,0:10:37.45,Default,,0000,0000,0000,,سأذهب للحمّام
Dialogue: 0,0:10:38.34,0:10:39.55,Default,,0000,0000,0000,,...سأذهب أنا أيضاً
Dialogue: 0,0:10:40.36,0:10:42.05,Default,,0000,0000,0000,,ماذا؟ أين اختفى؟
Dialogue: 0,0:10:45.44,0:10:47.19,Default,,0000,0000,0000,,!هلّا توقفت؟
Dialogue: 0,0:10:47.19,0:10:49.92,Default,,0000,0000,0000,,!أنا قارئة طالع! لست ساحرة
Dialogue: 0,0:10:50.43,0:10:52.64,Default,,0000,0000,0000,,أوقف هذه المهزلة أيّها الرجل المُسن
Dialogue: 0,0:10:52.64,0:10:53.43,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:53.97,0:10:58.80,Default,,0000,0000,0000,,اكتشفتُ هويّة القاتل...قطعياً أيضاً
Dialogue: 0,0:10:59.13,0:11:00.13,Default,,0000,0000,0000,,قطعياً؟
Dialogue: 0,0:11:00.63,0:11:01.71,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:11:01.71,0:11:05.08,Default,,0000,0000,0000,,...الشخص وراء الحوادث الثلاث في هذا النُزل
Dialogue: 0,0:11:06.15,0:11:06.80,Default,,0000,0000,0000,,!كان أنت
Dialogue: 0,0:11:15.58,0:11:16.33,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:11:16.33,0:11:19.96,Default,,0000,0000,0000,,الشخص وراء الحوادث الثلاث\N...في هذا النُزل
Dialogue: 0,0:11:20.59,0:11:21.26,Default,,0000,0000,0000,,!كان أنت
Dialogue: 0,0:11:22.44,0:11:23.72,Default,,0000,0000,0000,,ماذا؟! أنا؟
Dialogue: 0,0:11:24.15,0:11:25.68,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:11:26.11,0:11:28.63,Default,,0000,0000,0000,,...الرجل الذي يتصبب عرقاً وراءك
Dialogue: 0,0:11:29.22,0:11:31.35,Default,,0000,0000,0000,,!توغانو-سان، أنت
Dialogue: 0,0:11:33.97,0:11:35.43,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:11:36.27,0:11:41.42,Default,,0000,0000,0000,,كنتُ في غرفة المعيشة لعدّة ساعات\N!قبل تحرّك سيارة المالك
Dialogue: 0,0:11:41.42,0:11:44.34,Default,,0000,0000,0000,,!وعندما قُتلت أياكو، كنت معكم
Dialogue: 0,0:11:46.13,0:11:48.08,Default,,0000,0000,0000,,!صحيح يا ساذج
Dialogue: 0,0:11:48.08,0:11:50.21,Default,,0000,0000,0000,,تبّاً! هل أفاق؟
Dialogue: 0,0:11:50.21,0:11:52.08,Default,,0000,0000,0000,,!توقف يا أبي
Dialogue: 0,0:11:52.08,0:11:55.55,Default,,0000,0000,0000,,!لا تسخر منّي بلكنة كانساي الغريبة هذه
Dialogue: 0,0:11:55.75,0:12:01.51,Default,,0000,0000,0000,,!في الأصل، كنتَ معنا عندما تحرّكت سيّارة المالك
Dialogue: 0,0:12:01.51,0:12:05.28,Default,,0000,0000,0000,,!كيف استطاع توغانو-سان تحريكها؟
Dialogue: 0,0:12:05.28,0:12:08.92,Default,,0000,0000,0000,,معك حق، يبدو ذلك مستحيلاً
Dialogue: 0,0:12:09.39,0:12:11.93,Default,,0000,0000,0000,,لكن إذا استغلّ تصلب الجثّة
Dialogue: 0,0:12:11.93,0:12:16.39,Default,,0000,0000,0000,,ووظيفة ما في السيّارة، سيصبح ذلك في نطاق المعقول
Dialogue: 0,0:12:17.10,0:12:18.76,Default,,0000,0000,0000,,هكذا نفّذ الحيلة
Dialogue: 0,0:12:18.76,0:12:21.42,Default,,0000,0000,0000,,قتل الفاعل المالك قبل يوم تماماً
Dialogue: 0,0:12:21.42,0:12:25.92,Default,,0000,0000,0000,,وأجلسه في مقعد السيّارة، ثم ثبّت قدمه \Nعلى دواسة المكابح
Dialogue: 0,0:12:25.92,0:12:28.12,Default,,0000,0000,0000,,سيقع تصلّب الجثّة نصف يوم بعدها
Dialogue: 0,0:12:28.12,0:12:30.79,Default,,0000,0000,0000,,ولم تكن المكابح لتسمح للسيّارة بالحركة
Dialogue: 0,0:12:30.79,0:12:33.97,Default,,0000,0000,0000,,حتّى لو كانت السيّارة تعمل\Nوناقل الحركة في وضعية القيادة
Dialogue: 0,0:12:34.41,0:12:37.74,Default,,0000,0000,0000,,قبل العشاء البارحة، فتح القاتل المرآب
Dialogue: 0,0:12:37.74,0:12:42.40,Default,,0000,0000,0000,,ثمّ انتظر في غرفة المعيشة ارتخاء \Nالقدم على دوّاسة المكابح
Dialogue: 0,0:12:42.40,0:12:43.93,Default,,0000,0000,0000,,...فتتحرّك السيارة
Dialogue: 0,0:12:44.20,0:12:45.74,Default,,0000,0000,0000,,!أحمق
Dialogue: 0,0:12:45.74,0:12:47.98,Default,,0000,0000,0000,,لا يزول تصلّب الجثّة
Dialogue: 0,0:12:47.98,0:12:51.34,Default,,0000,0000,0000,,!إلا بعد 40 ساعة بعد الموت على الأقل
Dialogue: 0,0:12:51.69,0:12:54.14,Default,,0000,0000,0000,,...قلتَ ذلك بنفسك
Dialogue: 0,0:12:54.14,0:12:56.35,Default,,0000,0000,0000,,ماذا لو ارتفعت الحرارة الخارجية؟
Dialogue: 0,0:12:57.47,0:13:00.34,Default,,0000,0000,0000,,إن كانت الحرارة حول الجثّة\Nتُقارب 35 درجة مئوية
Dialogue: 0,0:13:00.34,0:13:03.47,Default,,0000,0000,0000,,سترتفع سرعة التصلّب كما الارتخاء
Dialogue: 0,0:13:03.47,0:13:07.26,Default,,0000,0000,0000,,فيزول التصلّب بعد 24 إلى 30 ساعة فحسب
Dialogue: 0,0:13:08.12,0:13:12.37,Default,,0000,0000,0000,,اختفى المالك بعد العاشرة ليلاً قبل ليلتين
Dialogue: 0,0:13:12.37,0:13:15.05,Default,,0000,0000,0000,,...إذا كان قد قُتل بعدها فوراً
Dialogue: 0,0:13:15.05,0:13:18.03,Default,,0000,0000,0000,,بدأت السيّارة بالتحرّك بعد قرابة 29 ساعة
Dialogue: 0,0:13:18.03,0:13:20.49,Default,,0000,0000,0000,,قبل الثالثة والنصف صباح اليوم
Dialogue: 0,0:13:20.49,0:13:22.51,Default,,0000,0000,0000,,أي في التوقيت المناسب
Dialogue: 0,0:13:23.28,0:13:25.49,Default,,0000,0000,0000,,الصوت الشبيه بهسيس الرياح من السيّارة
Dialogue: 0,0:13:25.49,0:13:27.67,Default,,0000,0000,0000,,!لم يكن جهاز التبريد، بل المدفأة
Dialogue: 0,0:13:27.67,0:13:29.15,Default,,0000,0000,0000,,لو كان جهاز التبريد
Dialogue: 0,0:13:29.15,0:13:32.09,Default,,0000,0000,0000,,لسقطت قطرات ماء عند الإطارات الأمامية
Dialogue: 0,0:13:32.77,0:13:36.85,Default,,0000,0000,0000,,لذا كنت تتفقد أثرها؟
Dialogue: 0,0:13:36.85,0:13:37.68,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:37.68,0:13:41.05,Default,,0000,0000,0000,,لم تكن هناك أيّ آثار ماء بالطبع
Dialogue: 0,0:13:41.72,0:13:43.84,Default,,0000,0000,0000,,لكن يمكن كشف حيلة كهذه بسهولة
Dialogue: 0,0:13:43.84,0:13:45.39,Default,,0000,0000,0000,,عبر فحص الجثّة
Dialogue: 0,0:13:45.39,0:13:49.96,Default,,0000,0000,0000,,لذا أسقطها القاتل مع السيّارة من الجرف
Dialogue: 0,0:13:50.25,0:13:52.09,Default,,0000,0000,0000,,لجعل استرجاعها مستحيلاً
Dialogue: 0,0:13:52.09,0:13:54.93,Default,,0000,0000,0000,,!بحيث لا نستطيع التحقّق من حالة التصلّب
Dialogue: 0,0:13:55.29,0:13:58.62,Default,,0000,0000,0000,,كيف ارتفعت سرعة السيّارة إذاً؟
Dialogue: 0,0:13:58.62,0:14:02.49,Default,,0000,0000,0000,,كان ذلك بسبب انزلاق قدمه\Nعن دوّاسة المكابح غالباً
Dialogue: 0,0:14:02.49,0:14:04.49,Default,,0000,0000,0000,,بعدما دخلت السيّارة الطريق الوعر
Dialogue: 0,0:14:05.66,0:14:08.77,Default,,0000,0000,0000,,والهدف من المُلاءة على المقصورة
Dialogue: 0,0:14:08.77,0:14:11.27,Default,,0000,0000,0000,,كان إخفاء مؤشّر المدفأة
Dialogue: 0,0:14:11.27,0:14:14.44,Default,,0000,0000,0000,,عمن قد يقتربون من السيّارة
Dialogue: 0,0:14:15.40,0:14:16.90,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:14:16.90,0:14:22.26,Default,,0000,0000,0000,,لذا بمشاهدة حركة السيّارة\N...مع أشخاص آخرين في الغرفة
Dialogue: 0,0:14:22.26,0:14:24.89,Default,,0000,0000,0000,,!ستحصل على حجّة غياب متقنة
Dialogue: 0,0:14:25.43,0:14:31.13,Default,,0000,0000,0000,,سبب إبقاء توغانو-سان لأياكو-سان\Nفي غرفة المعيشة آنذاك
Dialogue: 0,0:14:31.13,0:14:35.09,Default,,0000,0000,0000,,كان لأنّه يريد أن يشاهد أحد السيّارة معه؟
Dialogue: 0,0:14:35.34,0:14:37.00,Default,,0000,0000,0000,,تماماً
Dialogue: 0,0:14:37.00,0:14:40.08,Default,,0000,0000,0000,,والشخص الوحيد الذي كان \Nبمقدوره فعل ذلك هو من اصطحبها هنا
Dialogue: 0,0:14:40.08,0:14:41.80,Default,,0000,0000,0000,,!أنت يا توغانو-سان
Dialogue: 0,0:14:43.70,0:14:44.95,Default,,0000,0000,0000,,مُسلٍّ
Dialogue: 0,0:14:44.95,0:14:48.25,Default,,0000,0000,0000,,تحليلك كما لو انبثق من رواية
Dialogue: 0,0:14:48.94,0:14:52.72,Default,,0000,0000,0000,,لكن من المؤسف أنّ لا دليل لديك لإثباته
Dialogue: 0,0:14:53.40,0:14:57.23,Default,,0000,0000,0000,,،قلتُ سابقاً أيضاً، عندما اشتعل الحريق في المرآب
Dialogue: 0,0:14:57.23,0:14:59.93,Default,,0000,0000,0000,,كنتُ في الغرفة معكم
Dialogue: 0,0:14:59.93,0:15:01.68,Default,,0000,0000,0000,,...مهما نظرتم للأمر
Dialogue: 0,0:15:01.68,0:15:05.89,Default,,0000,0000,0000,,من شبه المستحيل أن أضرم الحريق\Nلحظة دخول أياكو المرآب تحديداً
Dialogue: 0,0:15:05.89,0:15:08.13,Default,,0000,0000,0000,,صحيح، لكن توجد طريقة يسيرة
Dialogue: 0,0:15:08.67,0:15:11.38,Default,,0000,0000,0000,,كلّ ما كان عليك هو إخبارها
Dialogue: 0,0:15:11.38,0:15:15.42,Default,,0000,0000,0000,,أنّ نسخة الطبعة الأولى من رواية هولمز\Nمخبأة تحت المقعد الخلفيّ
Dialogue: 0,0:15:15.42,0:15:16.97,Default,,0000,0000,0000,,!للسيّارة في المرآب
Dialogue: 0,0:15:18.12,0:15:21.59,Default,,0000,0000,0000,,نسخة الطبعة الأولى؟ وما علاقة ذلك؟
Dialogue: 0,0:15:21.99,0:15:23.37,Default,,0000,0000,0000,,أنسيت؟
Dialogue: 0,0:15:23.37,0:15:26.70,Default,,0000,0000,0000,,كان البنزين يتسرّب من السيارة\Nفي المرآب آنذاك
Dialogue: 0,0:15:26.70,0:15:28.80,Default,,0000,0000,0000,,والبطارية نُزعت
Dialogue: 0,0:15:29.44,0:15:30.98,Default,,0000,0000,0000,,أرادت البحث عن الكتاب
Dialogue: 0,0:15:30.98,0:15:34.72,Default,,0000,0000,0000,,،لكن مع عدم عمل مصابيح السيّارة\Nكان المقعد الخلفيّ مظلماً تماماً
Dialogue: 0,0:15:35.23,0:15:36.90,Default,,0000,0000,0000,,ما كنتَ لتفعل؟
Dialogue: 0,0:15:36.90,0:15:40.67,Default,,0000,0000,0000,,لو كان المكان مظلماً، كنتُ لأستعمل\N...قدّاحة أو ما شابه
Dialogue: 0,0:15:41.02,0:15:42.63,Default,,0000,0000,0000,,!هكذا إذاً! قدّاحة
Dialogue: 0,0:15:43.39,0:15:47.29,Default,,0000,0000,0000,,استعملت أياكو-سان قدّاحة\Nللبحث عن الكتاب
Dialogue: 0,0:15:50.05,0:15:53.76,Default,,0000,0000,0000,,أشعلت نارها البنزين الذي تسرّب من السيارة
Dialogue: 0,0:15:53.76,0:15:56.01,Default,,0000,0000,0000,,كانت هي من أشعل الحريق إذاً؟
Dialogue: 0,0:15:56.55,0:16:00.71,Default,,0000,0000,0000,,!لكنّها شاهدة مهمة في الحادثة الأولى
Dialogue: 0,0:16:01.08,0:16:05.04,Default,,0000,0000,0000,,كان يوجد هناك أربعة شهود غيرها
Dialogue: 0,0:16:05.04,0:16:07.82,Default,,0000,0000,0000,,لم يكن بحاجةٍ لإبقائها حيّة
Dialogue: 0,0:16:07.82,0:16:11.99,Default,,0000,0000,0000,,لكن أليست أياكو--سان وتوغانو-سان على علاقة؟
Dialogue: 0,0:16:11.99,0:16:13.18,Default,,0000,0000,0000,,لمَ قد يفعل ذلك؟
Dialogue: 0,0:16:13.49,0:16:16.61,Default,,0000,0000,0000,,لأنّها اكتشفت حيلة تصلّب الجثّة
Dialogue: 0,0:16:16.61,0:16:19.47,Default,,0000,0000,0000,,ووجدت دليلاً يدينه
Dialogue: 0,0:16:19.85,0:16:21.09,Default,,0000,0000,0000,,جميعكم تذكرون
Dialogue: 0,0:16:22.18,0:16:25.18,Default,,0000,0000,0000,,أعلنت أياكو-سان أنّها عرفت القاتل
Dialogue: 0,0:16:25.98,0:16:27.88,Default,,0000,0000,0000,,هلع توغانو-سان بعد سماعه ذلك
Dialogue: 0,0:16:27.88,0:16:31.38,Default,,0000,0000,0000,,وتظاهر باللحاق بها للحمّام
Dialogue: 0,0:16:31.38,0:16:33.38,Default,,0000,0000,0000,,ثمّ أخبرها عن نسخة الطبعة الأولى
Dialogue: 0,0:16:33.38,0:16:35.26,Default,,0000,0000,0000,,واستدرجها لفخّ المرآب
Dialogue: 0,0:16:35.67,0:16:37.22,Default,,0000,0000,0000,,...بالمناسبة، كان توغانو-سان
Dialogue: 0,0:16:37.22,0:16:40.54,Default,,0000,0000,0000,,هو الوحيد معها آنذاك
Dialogue: 0,0:16:40.54,0:16:44.22,Default,,0000,0000,0000,,!لذا غيّرت سلوكها بعد مغادرة الحمّام فجأةً
Dialogue: 0,0:16:44.54,0:16:48.67,Default,,0000,0000,0000,,لكن من العجيب أنّ حيلة المرآب\Nخطرت له حينذاك
Dialogue: 0,0:16:48.95,0:16:54.34,Default,,0000,0000,0000,,كلا، كان قد جهّز تلك الحيلة\Nلشخص آخر سلفاً
Dialogue: 0,0:16:54.95,0:16:57.73,Default,,0000,0000,0000,,لم يحالف الحظّ القاتل لأنّ\Nأياكو-سان كانت تحمل قدّاحة
Dialogue: 0,0:16:57.73,0:17:01.17,Default,,0000,0000,0000,,مثلما كان يملك ذاك الشخص
Dialogue: 0,0:17:01.94,0:17:07.14,Default,,0000,0000,0000,,أجل، كان الهدف من فخّ المرآب\N!هو قتل فوجيساوا-سان في الأساس
Dialogue: 0,0:17:08.38,0:17:09.00,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:09.00,0:17:13.43,Default,,0000,0000,0000,,البطاقة التي كانت عالقة في بابك
Dialogue: 0,0:17:13.76,0:17:18.38,Default,,0000,0000,0000,,نوى القاتل أن يستدرجك للمرآب ويقتلك
Dialogue: 0,0:17:18.83,0:17:21.62,Default,,0000,0000,0000,,لكن لم تمض الأمور وفق خطّته
Dialogue: 0,0:17:21.62,0:17:24.50,Default,,0000,0000,0000,,وقتل فخّ المرآب أياكو-سان
Dialogue: 0,0:17:24.50,0:17:26.62,Default,,0000,0000,0000,,فكّر سريعاً بخطّة انقطاع كهرباء
Dialogue: 0,0:17:26.62,0:17:28.38,Default,,0000,0000,0000,,عبر العبث بمقبس
Dialogue: 0,0:17:28.38,0:17:30.84,Default,,0000,0000,0000,,ثمّ هاجم فوجيساوا-سان بكسّارة ثلج
Dialogue: 0,0:17:31.36,0:17:34.53,Default,,0000,0000,0000,,هكذا إذاً، لذا كانت هناك أدلّة كثيرة
Dialogue: 0,0:17:34.53,0:17:36.30,Default,,0000,0000,0000,,بعد الحادثة الثالثة
Dialogue: 0,0:17:36.78,0:17:39.35,Default,,0000,0000,0000,,كان توغانو-سان في المطبخ آنذاك
Dialogue: 0,0:17:39.35,0:17:42.26,Default,,0000,0000,0000,,فأمكنه تجهيز حيلته بكلّ سهولة
Dialogue: 0,0:17:42.56,0:17:44.77,Default,,0000,0000,0000,,أي أنّ الشخص الوحيد
Dialogue: 0,0:17:44.77,0:17:49.09,Default,,0000,0000,0000,,الذي كان بإمكانه ارتكاب كلّ الحوادث الثلاث
Dialogue: 0,0:17:49.09,0:17:50.72,Default,,0000,0000,0000,,كان أنت فحسب يا توغانو-سان
Dialogue: 0,0:17:50.72,0:17:53.43,Default,,0000,0000,0000,,!فلترني دليلاً إذاً
Dialogue: 0,0:17:54.05,0:17:57.50,Default,,0000,0000,0000,,إذا كنت سترميني بهذه الاتّهامات، فيجدر أنّ لديك دليل
Dialogue: 0,0:17:58.04,0:18:00.29,Default,,0000,0000,0000,,ماذا؟ لم تعرف؟
Dialogue: 0,0:18:00.29,0:18:04.58,Default,,0000,0000,0000,,رأت أياكو-سان شيئاً في غرفتك
Dialogue: 0,0:18:04.58,0:18:05.68,Default,,0000,0000,0000,,ظهيرة الأمس
Dialogue: 0,0:18:06.08,0:18:09.37,Default,,0000,0000,0000,,...لا يهم أيّ ما رأته، فلا تستطيع الكلام الآن
Dialogue: 0,0:18:09.37,0:18:10.67,Default,,0000,0000,0000,,السؤال 1
Dialogue: 0,0:18:11.15,0:18:12.96,Default,,0000,0000,0000,,"بأيّ يد يكتب هولمز؟"
Dialogue: 0,0:18:13.65,0:18:14.77,Default,,0000,0000,0000,,السؤال 2
Dialogue: 0,0:18:14.77,0:18:17.35,Default,,0000,0000,0000,,"ما اسم زوجة الدكتور واتسون؟"
Dialogue: 0,0:18:17.35,0:18:18.79,Default,,0000,0000,0000,,!ما هذا؟
Dialogue: 0,0:18:19.26,0:18:22.26,Default,,0000,0000,0000,,ماذا؟ أنسيت؟
Dialogue: 0,0:18:22.26,0:18:25.56,Default,,0000,0000,0000,,ألم تحلّ أسئلة اختبار طائفة هولمز الألف بدورك؟
Dialogue: 0,0:18:26.26,0:18:28.70,Default,,0000,0000,0000,,السؤال 241
Dialogue: 0,0:18:29.46,0:18:34.17,Default,,0000,0000,0000,,ما نصّت رسالة هولمز المكتوبة"\N"بشفرة (الرجال الراقصين) المرسلة للقاتل؟
Dialogue: 0,0:18:34.50,0:18:37.95,Default,,0000,0000,0000,,...أذكر ذاك السؤال جيّداً
Dialogue: 0,0:18:37.95,0:18:41.37,Default,,0000,0000,0000,,"كانت الإجابة "تعال هنا فوراً
Dialogue: 0,0:18:41.74,0:18:44.33,Default,,0000,0000,0000,,لم يكن ذاك السؤال ضمن الاختبار
Dialogue: 0,0:18:44.74,0:18:48.48,Default,,0000,0000,0000,,...السؤال الوحيد المتعلّق بالرجال الراقصين كان
Dialogue: 0,0:18:48.48,0:18:52.29,Default,,0000,0000,0000,,(اكتب الشفرة الكاملة من (مغامرة الرجال الراقصين"\N"كما ظهرت تماماً
Dialogue: 0,0:18:52.61,0:18:53.73,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:18:53.73,0:18:57.27,Default,,0000,0000,0000,,كان ذلك صعباً جدّاً بحيث يستحيل نسيانه
Dialogue: 0,0:18:57.27,0:19:01.00,Default,,0000,0000,0000,,أليس غريباً عدم تذكرك له؟
Dialogue: 0,0:19:01.00,0:19:02.46,Default,,0000,0000,0000,,...كـ-كنتُ فحسب
Dialogue: 0,0:19:02.93,0:19:05.22,Default,,0000,0000,0000,,سبب ذهاب أياكو-سان لغرفتك
Dialogue: 0,0:19:05.22,0:19:07.87,Default,,0000,0000,0000,,!هو نسخ إجابات الاختبار
Dialogue: 0,0:19:07.87,0:19:11.21,Default,,0000,0000,0000,,لكنّك لم تكن في غرفتك
Dialogue: 0,0:19:11.21,0:19:13.05,Default,,0000,0000,0000,,كنت قد ذهبت للمرآب للتحقق
Dialogue: 0,0:19:13.05,0:19:15.84,Default,,0000,0000,0000,,من حالة تصلّب جثّة المالك غالباً
Dialogue: 0,0:19:16.46,0:19:18.54,Default,,0000,0000,0000,,...ما رأته أياكو-سان إذاً
Dialogue: 0,0:19:18.54,0:19:23.50,Default,,0000,0000,0000,,أجل، أوراق اختبار فارغة بلا أيّ إجابة
Dialogue: 0,0:19:25.59,0:19:28.15,Default,,0000,0000,0000,,وسبب عدم حلّه لشيء
Dialogue: 0,0:19:28.15,0:19:30.21,Default,,0000,0000,0000,,هو لأنّه لم يكن هناك مغزى
Dialogue: 0,0:19:31.03,0:19:31.86,Default,,0000,0000,0000,,...ما يعني
Dialogue: 0,0:19:31.86,0:19:35.19,Default,,0000,0000,0000,,أنّك كنت تعرف أنّ المالك لن يصحح الاختبارات
Dialogue: 0,0:19:35.19,0:19:37.62,Default,,0000,0000,0000,,!بما أنّه لم يعد حيّاً
Dialogue: 0,0:19:38.73,0:19:40.52,Default,,0000,0000,0000,,إذا كنت ستدّعي أن هذا هراء
Dialogue: 0,0:19:40.52,0:19:42.98,Default,,0000,0000,0000,,فهلّا أريتنا أوراق اختبارك؟
Dialogue: 0,0:19:42.98,0:19:44.06,Default,,0000,0000,0000,,!فوراً
Dialogue: 0,0:19:46.10,0:19:48.51,Default,,0000,0000,0000,,!تـ-تبّاً
Dialogue: 0,0:19:48.51,0:19:50.39,Default,,0000,0000,0000,,...أيّها الوغد
Dialogue: 0,0:19:51.59,0:19:54.79,Default,,0000,0000,0000,,!تكلّم! لمَ أردت قتلي والمالك؟
Dialogue: 0,0:19:55.17,0:19:57.66,Default,,0000,0000,0000,,"سخرية آيرين أدلر"
Dialogue: 0,0:19:57.66,0:20:03.25,Default,,0000,0000,0000,,الدافع كان الكتاب الذي ساعدتَ\Nالمالك بنشره غالباً
Dialogue: 0,0:20:03.61,0:20:05.04,Default,,0000,0000,0000,,مـ-ماذا؟
Dialogue: 0,0:20:05.66,0:20:10.49,Default,,0000,0000,0000,,آيرين؟ الممثلة التي فاقت هولمز \Nذكاءً في إحدى قصصه؟
Dialogue: 0,0:20:10.49,0:20:13.61,Default,,0000,0000,0000,,...أجل، لكن كان معظم كتاب المالك
Dialogue: 0,0:20:13.61,0:20:15.50,Default,,0000,0000,0000,,عن عثرات هولمز كمتحرٍّ
Dialogue: 0,0:20:15.95,0:20:16.95,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:20:16.95,0:20:19.96,Default,,0000,0000,0000,,...شعر توغانو أن الكتاب أهان هولمز لذا قرر
Dialogue: 0,0:20:21.10,0:20:22.85,Default,,0000,0000,0000,,على النقيض
Dialogue: 0,0:20:22.85,0:20:26.64,Default,,0000,0000,0000,,كانت آيرين المرأة الوحيدة\Nالتي اعترف بها شارلوك
Dialogue: 0,0:20:26.64,0:20:30.87,Default,,0000,0000,0000,,يستحيل أن أتخيل سخرية مرأة مثلها منه
Dialogue: 0,0:20:34.59,0:20:36.22,Default,,0000,0000,0000,,...لم أستطع مسامحته
Dialogue: 0,0:20:36.22,0:20:38.58,Default,,0000,0000,0000,,!قطعاً
Dialogue: 0,0:20:48.45,0:20:50.28,Default,,0000,0000,0000,,!كنت مذهلاً يا هاتّوري-كن
Dialogue: 0,0:20:50.28,0:20:52.04,Default,,0000,0000,0000,,!كما يُتوقع من متحرّي الغرب العظيم
Dialogue: 0,0:20:53.24,0:20:54.36,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:20:54.36,0:20:55.91,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:20:55.91,0:20:59.73,Default,,0000,0000,0000,,!قضيّة كهذه لقمة سائغة لي
Dialogue: 0,0:21:01.23,0:21:03.90,Default,,0000,0000,0000,,...يبدو أنّني حللت هذا دون أن تُكتشف هويّتي
Dialogue: 0,0:21:03.90,0:21:05.31,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:06.40,0:21:07.76,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:08.89,0:21:11.37,Default,,0000,0000,0000,,!أنا هنا يا ران-نيتشان
Dialogue: 0,0:21:11.37,0:21:12.00,Default,,0000,0000,0000,,أنت
Dialogue: 0,0:21:13.18,0:21:14.50,Default,,0000,0000,0000,,إنّك كودو، صحيح؟
Dialogue: 0,0:21:15.76,0:21:19.45,Default,,0000,0000,0000,,!ما-ما الذي تقوله؟ أنا مجرد طفل! طفل
Dialogue: 0,0:21:20.17,0:21:23.71,Default,,0000,0000,0000,,لكنة كانساي الزائفة خاصتك كان بائسة
Dialogue: 0,0:21:23.71,0:21:27.16,Default,,0000,0000,0000,,هذه هي إذاً؟ الأداة التي استعملتها لتقليد صوتي
Dialogue: 0,0:21:28.28,0:21:31.12,Default,,0000,0000,0000,,رأيتك تستعملها بطرف عيني
Dialogue: 0,0:21:31.91,0:21:32.71,Default,,0000,0000,0000,,في أيّ مرحلة؟
Dialogue: 0,0:21:33.49,0:21:35.17,Default,,0000,0000,0000,,"سيصبح ذلك في نطاق المعقول"
Dialogue: 0,0:21:35.91,0:21:37.86,Default,,0000,0000,0000,,اختيارك للكلمات غريب نوعاً ما
Dialogue: 0,0:21:37.86,0:21:40.02,Default,,0000,0000,0000,,لكن من أسلوبك وشرح استنتاجاتك
Dialogue: 0,0:21:40.02,0:21:41.77,Default,,0000,0000,0000,,!أنت كودو شينتشي بلا شك
Dialogue: 0,0:21:41.77,0:21:44.48,Default,,0000,0000,0000,,!ما-ما قصدك؟ أنا مجرّد طفل
Dialogue: 0,0:21:44.48,0:21:45.63,Default,,0000,0000,0000,,حسناً، كما تشاء
Dialogue: 0,0:21:47.68,0:21:51.85,Default,,0000,0000,0000,,أعيرين مسامعك! لديّ قصة مسليّة
Dialogue: 0,0:21:51.85,0:21:54.25,Default,,0000,0000,0000,,...في الحقيقة ذاك الـ
Dialogue: 0,0:21:54.25,0:21:56.10,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:23:23.00,0:23:25.08,Default,,0000,0000,0000,,ماذا؟ قلّص عقارهم جسدك إذاً
Dialogue: 0,0:23:25.29,0:23:27.78,Default,,0000,0000,0000,,وتعيش مع الفتاة التي تحبّها \Nكي تستطيع إيجاد
Dialogue: 0,0:23:27.78,0:23:31.32,Default,,0000,0000,0000,,المزيد من المعلومات عن منظمتهم؟
Dialogue: 0,0:23:31.32,0:23:35.08,Default,,0000,0000,0000,,لا-لا أحبّها بالتحديد، تلك الفتاة المزعجة
Dialogue: 0,0:23:36.78,0:23:39.20,Default,,0000,0000,0000,,يبدو أنّكما على وفاق
Dialogue: 0,0:23:39.48,0:23:40.64,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:23:40.64,0:23:45.66,Default,,0000,0000,0000,,اسمعي، أتريدين معرفة ما قاله\Nكودو عنك قبلاً؟
Dialogue: 0,0:23:46.37,0:23:49.61,Default,,0000,0000,0000,,!قال أنّك مزعجة جدّاً ولا يطيقك
Dialogue: 0,0:23:50.05,0:23:51.59,Default,,0000,0000,0000,,مزعجة؟
Dialogue: 0,0:23:54.06,0:23:55.31,Default,,0000,0000,0000,,!يا وغد
Dialogue: 0,0:23:55.52,0:23:57.42,Default,,0000,0000,0000,,هذا جزاؤك لتنويمي
Dialogue: 0,0:24:10.12,0:24:13.52,Default,,0000,0000,0000,,!هذا... أثر قطع بشفرة
Dialogue: 0,0:24:19.51,0:24:24.05,Default,,0000,0000,0000,,حاول أحدهم قتل هيروشي-كن\N!بجعلها تبدو حوادث عرضيّة
Dialogue: 0,0:24:24.19,0:24:30.18,On Top,,0000,0000,15,,جريمة قتل الإرسالية الأولى
Dialogue: 0,0:24:24.69,0:24:26.02,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.02,0:24:29.10,Default,,0000,0000,0000,,جريمة قتل الإرسالية الأولى
Dialogue: 0,0:24:45.70,0:24:47.86,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.86,0:24:50.18,Default,,0000,0000,0000,,مرآة عبور
Dialogue: 0,0:24:50.43,0:24:52.30,Default,,0000,0000,0000,,!سلسلة ذات شعبيّة كبيرة في الحلقة القامة
Dialogue: 0,0:24:52.30,0:24:54.32,Default,,0000,0000,0000,,!دور كبير لفرقة فتيان التحرّي
Dialogue: 0,0:24:54.32,0:24:56.32,Default,,0000,0000,0000,,من جديد؟

