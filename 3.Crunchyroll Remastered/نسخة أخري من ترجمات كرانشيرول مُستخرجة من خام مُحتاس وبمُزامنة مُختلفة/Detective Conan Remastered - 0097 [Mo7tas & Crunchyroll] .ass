Dialogue: 0,0:00:00.95,0:00:04.45,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والقضايا تلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.45,0:00:05.98,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.45,0:00:08.28,Default,,0000,0000,0000,,كيف سيكون مذاق نبيذ اليوم؟
Dialogue: 0,0:00:08.28,0:00:09.95,Default,,0000,0000,0000,,!لا تحكم على شيءٍ من اسمه
Dialogue: 0,0:00:09.95,0:00:11.41,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.83,0:00:13.74,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.74,0:00:15.87,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.28,0:00:23.95,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:23.95,0:00:30.99,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.76,0:00:39.12,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.12,0:00:46.62,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.62,0:00:58.41,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.00,0:01:06.37,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.38,0:01:13.26,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.26,0:01:19.62,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.95,0:01:26.65,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.15,0:01:57.21,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل نبيذ الوداع
Dialogue: 0,0:01:52.05,0:01:55.07,Default,,0000,0000,0000,,جريمة قتل نبيذ الوداع
Dialogue: 0,0:01:57.83,0:01:59.84,Default,,0000,0000,0000,,لا أفهم
Dialogue: 0,0:02:00.21,0:02:02.75,Default,,0000,0000,0000,,لمَ تمّت دعوتنا نحن أيضاً؟
Dialogue: 0,0:02:02.75,0:02:03.83,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:02:03.83,0:02:04.83,Default,,0000,0000,0000,,لستَ مهتمّاً؟
Dialogue: 0,0:02:04.83,0:02:06.33,Default,,0000,0000,0000,,!بالطبع لا
Dialogue: 0,0:02:06.33,0:02:11.56,Default,,0000,0000,0000,,قد يكون إيتشيكاوا كوتارو رئيس\N،إيتشيكاوا للصناعات الآن
Dialogue: 0,0:02:11.56,0:02:14.52,On Top,,0000,0000,0000,,إيتشيكاوا للصناعات
Dialogue: 0,0:02:11.94,0:02:14.52,Default,,0000,0000,0000,,لكنّه وغدٌ مخادع أيضاً
Dialogue: 0,0:02:14.83,0:02:17.23,Default,,0000,0000,0000,,سيكون طلب عمل غير محترم بالتأكيد
Dialogue: 0,0:02:17.23,0:02:18.65,Default,,0000,0000,0000,,لمَ لا ترفضه إذاً؟
Dialogue: 0,0:02:19.41,0:02:22.36,Default,,0000,0000,0000,,!للبالغين ظروفهم
Dialogue: 0,0:02:22.58,0:02:24.46,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:02:24.46,0:02:27.82,Default,,0000,0000,0000,,لم يتلقَّ أيّ عمل لوقتٍ طويل
Dialogue: 0,0:02:34.75,0:02:36.75,Default,,0000,0000,0000,,موري-ساما، أليس كذلك؟
Dialogue: 0,0:02:37.09,0:02:37.97,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:38.66,0:02:40.37,Default,,0000,0000,0000,,كنّا بانتظارك
Dialogue: 0,0:02:40.37,0:02:41.66,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:02:45.66,0:02:48.34,Default,,0000,0000,0000,,أتوجد حفلةٌ الآن؟
Dialogue: 0,0:02:48.34,0:02:53.31,Default,,0000,0000,0000,,يقيم الرئيس اجتماعاً عائليّاً كلّ عام\Nعلى عيد ميلاده
Dialogue: 0,0:02:58.52,0:03:01.27,Default,,0000,0000,0000,,أتى موري-ساما لمقابلتك
Dialogue: 0,0:03:01.27,0:03:02.00,Default,,0000,0000,0000,,ادخل
Dialogue: 0,0:03:04.69,0:03:07.15,Default,,0000,0000,0000,,هذا إيتشيكاوا، سيّد المنزل
Dialogue: 0,0:03:08.08,0:03:09.87,Default,,0000,0000,0000,,شكراً على قدومك
Dialogue: 0,0:03:10.13,0:03:14.08,Default,,0000,0000,0000,,ليكن في علمك، لم أقرّر قبول طلبك بعد
Dialogue: 0,0:03:14.08,0:03:15.08,Default,,0000,0000,0000,,إيمامورا
Dialogue: 0,0:03:15.46,0:03:17.54,CharCard,,0000,0000,0004,,{\fad(300,0)}(إيمامورا توشياكي (55\Nكبير خدم عائلة إيتشيكاوا
Dialogue: 0,0:03:20.96,0:03:22.33,Default,,0000,0000,0000,,!مئة ألف ينّ؟
Dialogue: 0,0:03:22.33,0:03:26.59,Default,,0000,0000,0000,,لا تسترخص خدمات المتحرّي\N!العظيم موري كوغورو
Dialogue: 0,0:03:29.00,0:03:30.18,Default,,0000,0000,0000,,يا عمّ
Dialogue: 0,0:03:30.75,0:03:31.66,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:31.66,0:03:33.25,Default,,0000,0000,0000,,ليست مئة ألف
Dialogue: 0,0:03:34.10,0:03:34.75,Default,,0000,0000,0000,,انظر
Dialogue: 0,0:03:34.75,0:03:38.52,Default,,0000,0000,0000,,،آحاد، عشرات، مئات، آحاد ألوف\N...عشرات ألوف، مئات ألوف
Dialogue: 0,0:03:39.62,0:03:41.69,Default,,0000,0000,0000,,!مـ-مليون ينّ؟
Dialogue: 0,0:03:42.07,0:03:43.87,On Top,,0000,0000,0000,,حضّرت مليون ينّ أخرى
Dialogue: 0,0:03:42.07,0:03:45.61,CharCard,,0000,0000,0004,,{\fad(300,0)}(إيتشيكاوا كوتارو (65\Nرئيس إيتشيكاوا للصناعة
Dialogue: 0,0:03:43.87,0:03:45.61,On Top,,0000,0000,0000,,إذا أتممت عملك بنجاح
Dialogue: 0,0:03:47.62,0:03:50.07,Default,,0000,0000,0000,,إذاً، كيف أخدمك؟
Dialogue: 0,0:03:50.33,0:03:51.78,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:03:52.16,0:03:56.87,Default,,0000,0000,0000,,ستحضر ابنتاي اجتماع اليوم العائليّ
Dialogue: 0,0:03:58.54,0:04:03.75,Default,,0000,0000,0000,,أريدك أن تراقب ما الذي ستفعلانه\Nوما الذي ستحاولان فعله
Dialogue: 0,0:04:03.75,0:04:05.21,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:05.21,0:04:07.21,Default,,0000,0000,0000,,المعذرة، هل أغادر؟
Dialogue: 0,0:04:07.21,0:04:11.68,Default,,0000,0000,0000,,كلا، لا داعي، يمكنك شرح حالتي له
Dialogue: 0,0:04:11.68,0:04:12.65,On Top,,0000,0000,0000,,حاضر
Dialogue: 0,0:04:12.61,0:04:17.14,CharCard,,0000,0000,0004,,{\fad(300,0)}(أوكانو هيتوشي (30\Nطبيب كوتارو الخاص
Dialogue: 0,0:04:12.65,0:04:14.75,On Top,,0000,0000,0000,,،إذا واصل الضغط على نفسه
Dialogue: 0,0:04:14.75,0:04:17.14,On Top,,0000,0000,0000,,فلا ضمان لبقائه على قيد الحياة
Dialogue: 0,0:04:17.39,0:04:23.61,On Top,,0000,0000,0000,,لذا أفكّر بالتقاعد قريباً، لكن عليّ تحديد خليفة
Dialogue: 0,0:04:23.61,0:04:26.53,Default,,0000,0000,0000,,ستكون إحدى ابنتيك، صحيح؟
Dialogue: 0,0:04:27.12,0:04:28.79,Default,,0000,0000,0000,,ليس بالضرورة
Dialogue: 0,0:04:28.79,0:04:32.33,Default,,0000,0000,0000,,،لا نيّة لديّ بمشاركة ثروتي مع جشعين غير محترمين
Dialogue: 0,0:04:32.33,0:04:34.24,Default,,0000,0000,0000,,ولو كانوا أبنائي
Dialogue: 0,0:04:34.54,0:04:39.66,Default,,0000,0000,0000,,مع ذلك، هناك حصص مفروضة\Nقانونياً في الميراث
Dialogue: 0,0:04:39.66,0:04:43.71,Default,,0000,0000,0000,,ستتلقّى ابنتاك حصّتيهما مهما كان الأمر
Dialogue: 0,0:04:43.99,0:04:48.34,Default,,0000,0000,0000,,لكن ألا يختلف الموضوع إن كنت\Nأملك مشكلة مع من سينالها؟
Dialogue: 0,0:04:49.96,0:04:51.09,Default,,0000,0000,0000,,مشكلة؟
Dialogue: 0,0:04:53.12,0:04:58.35,Default,,0000,0000,0000,,هناك شيءٌ ما، بل أستشعر حصول شيءٍ بالتأكيد
Dialogue: 0,0:04:58.65,0:05:00.29,Default,,0000,0000,0000,,شيء؟
Dialogue: 0,0:05:00.29,0:05:04.16,Default,,0000,0000,0000,,أخبرتُ الجميع أنّك صديقي، ومن العائلة
Dialogue: 0,0:05:04.16,0:05:07.09,Default,,0000,0000,0000,,لكن حاذر ألا يكشفوك في عملك
Dialogue: 0,0:05:08.08,0:05:09.32,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:09.49,0:05:12.24,Default,,0000,0000,0000,,أي أنّي وران مجرّد غطاء تمويه؟
Dialogue: 0,0:05:12.50,0:05:16.20,Default,,0000,0000,0000,,مع ذلك، يا للمُسنّ البغيض
Dialogue: 0,0:05:25.79,0:05:27.38,Default,,0000,0000,0000,,!نخبك
Dialogue: 0,0:05:28.33,0:05:32.84,Default,,0000,0000,0000,,موري-ساما، تلك هي الابنة الكبرى، كازوي-سان
Dialogue: 0,0:05:33.15,0:05:36.04,Default,,0000,0000,0000,,تدير معرضاً فنّياً في الوقت الراهن
Dialogue: 0,0:05:38.66,0:05:40.75,Default,,0000,0000,0000,,إيمامورا، من هذا الشخص؟
Dialogue: 0,0:05:40.75,0:05:44.87,Default,,0000,0000,0000,,أجل، إنّه موري-ساما، أحد أصدقاء أبيك
Dialogue: 0,0:05:44.87,0:05:46.11,Default,,0000,0000,0000,,سُررت بلقائك
Dialogue: 0,0:05:46.11,0:05:48.50,On Top,,0000,0000,0000,,صديقٌ لأبي؟
Dialogue: 0,0:05:47.01,0:05:52.86,CharCard,,0000,0000,0004,,{\fad(300,0)}(إيتشيكاوا كازوي (30\Nالابنة الكبرى لعائلة إيتشيكاوا
Dialogue: 0,0:05:48.50,0:05:52.86,On Top,,0000,0000,0000,,ألا يُثقل عليك حضور مناسبات كهذه؟
Dialogue: 0,0:05:52.86,0:05:56.87,Default,,0000,0000,0000,,...البتّة! أتيتُ مع عائلتي
Dialogue: 0,0:05:56.87,0:05:58.50,Default,,0000,0000,0000,,ونحن نستمتع بوقتنا
Dialogue: 0,0:05:58.50,0:06:00.29,Default,,0000,0000,0000,,!عجباً، أختاه
Dialogue: 0,0:06:00.66,0:06:03.25,Default,,0000,0000,0000,,لم أتوقّع أنّك ستأتين حقّاً
Dialogue: 0,0:06:03.25,0:06:06.50,Default,,0000,0000,0000,,بالطبع سآتي
Dialogue: 0,0:06:06.50,0:06:09.21,Default,,0000,0000,0000,,فأنا التالية في الترتيب\Nفي عائلة إيتشيكاوا
Dialogue: 0,0:06:09.50,0:06:11.21,On Top,,0000,0000,0000,,أتساءل حول ذلك
Dialogue: 0,0:06:09.81,0:06:13.95,CharCard,,0000,0000,0004,,{\fad(300,200)} (27) إيتشيكاوا ميزوي\Nالابنة الثانية لعائلة إيتشيكاوا
Dialogue: 0,0:06:11.21,0:06:13.87,On Top,,0000,0000,0000,,فلا أظنّ أبي يوافقك الرأي
Dialogue: 0,0:06:13.87,0:06:19.22,On Top,,0000,0000,0000,,تصرّفتِ بأنانيّة، وتركتِ البيت بعدما تشاجرتِ معه
Dialogue: 0,0:06:19.22,0:06:20.50,Default,,0000,0000,0000,,لا يحقّ لكِ الكلام
Dialogue: 0,0:06:20.50,0:06:25.19,Default,,0000,0000,0000,,فألم تتزوّجي سريعاً لأنّك سئمتِ\Nمن رؤية وجهه؟
Dialogue: 0,0:06:25.66,0:06:30.00,Default,,0000,0000,0000,,بالمناسبة، سمعت أنّ معرضك الفنّي\Nيتعرض للمقاضاة
Dialogue: 0,0:06:30.00,0:06:33.00,Default,,0000,0000,0000,,لبيعك قطعاً مزيّفة وما شابه
Dialogue: 0,0:06:33.00,0:06:34.16,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:35.61,0:06:37.82,Default,,0000,0000,0000,,الواحدة أطلح من الأخرى
Dialogue: 0,0:06:37.96,0:06:41.72,Default,,0000,0000,0000,,"كلتا الابنتين تعانيان من شخصيّة سيّئة"
Dialogue: 0,0:07:00.60,0:07:03.07,CharCard,,0000,0000,0004,,{\fad(300,100)}(الكهف (مخزن نبيذ
Dialogue: 0,0:07:03.95,0:07:05.24,Default,,0000,0000,0000,,!إنّها كازوي-سان
Dialogue: 0,0:07:12.56,0:07:15.44,Default,,0000,0000,0000,,!إبرة حقن! ما الذي تنوي فعله؟
Dialogue: 0,0:07:18.86,0:07:19.94,Default,,0000,0000,0000,,!ما بداخلها؟
Dialogue: 0,0:07:23.61,0:07:24.50,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:07:25.32,0:07:27.11,Default,,0000,0000,0000,,...كلوروفورم
Dialogue: 0,0:07:31.74,0:07:34.45,Default,,0000,0000,0000,,أين ذهب كونان-كن يا ترى؟
Dialogue: 0,0:07:36.86,0:07:41.88,Default,,0000,0000,0000,,أقدّم لكم شكري لاجتماعكم\Nهنا في عيد ميلادي
Dialogue: 0,0:07:41.88,0:07:45.59,Default,,0000,0000,0000,,أنوي التنازل عن منصبي\Nكرئيس الشركة قريباً
Dialogue: 0,0:07:45.59,0:07:47.55,Default,,0000,0000,0000,,أي سأتقاعد
Dialogue: 0,0:07:49.70,0:07:55.32,Default,,0000,0000,0000,,لذا قرّرتُ بيع كلّ أسهمي وحقوقي في الملكيّة
Dialogue: 0,0:07:55.32,0:07:57.70,Default,,0000,0000,0000,,لنيتشيوري للصناعة
Dialogue: 0,0:07:57.70,0:07:59.52,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:07:59.94,0:08:03.65,Default,,0000,0000,0000,,!سـ-سيّدي الرئيس! ما الذي سيحلّ بنا إذاً؟
Dialogue: 0,0:08:04.74,0:08:07.03,Default,,0000,0000,0000,,...إذا أردتم البقاء مع الشركة، فعليكم إثبات
Dialogue: 0,0:08:07.03,0:08:10.24,Default,,0000,0000,0000,,كفاءتكم للإدارة الجديدة
Dialogue: 0,0:08:10.24,0:08:11.95,Default,,0000,0000,0000,,!لا-لا يُعقل
Dialogue: 0,0:08:11.95,0:08:15.20,Default,,0000,0000,0000,,ما الذي ستفعله بالأموال التي\N!ستجنيها من بيع الشركة؟
Dialogue: 0,0:08:15.86,0:08:18.36,Default,,0000,0000,0000,,كيفيّة استعمالها تعود لي
Dialogue: 0,0:08:18.36,0:08:21.57,Default,,0000,0000,0000,,لا نيّة لي بإعطائكم قرشاً
Dialogue: 0,0:08:21.57,0:08:23.34,Default,,0000,0000,0000,,حتّى ابنتيّ
Dialogue: 0,0:08:29.20,0:08:32.20,Default,,0000,0000,0000,,!تبّاً، أهملت! عليّ الإسراع
Dialogue: 0,0:08:33.86,0:08:37.11,Default,,0000,0000,0000,,!ما حقنت النبيذ به كان سمّاً على الأرجح
Dialogue: 0,0:08:37.11,0:08:39.20,Default,,0000,0000,0000,,!كيف تنوي استعماله؟
Dialogue: 0,0:08:40.86,0:08:44.48,Default,,0000,0000,0000,,لن أعترض على قرارك يا أبي
Dialogue: 0,0:08:44.48,0:08:46.16,Default,,0000,0000,0000,,ولا أنا
Dialogue: 0,0:08:46.16,0:08:51.95,Default,,0000,0000,0000,,أحضرتُ نبيذاً من سنة 57 للاحتفال\Nبهذه الصفحة الجديدة في حياتك
Dialogue: 0,0:08:52.24,0:08:56.54,Default,,0000,0000,0000,,يحمل قيمةً أكبر لهاوٍ للنبيذ مثلك
Dialogue: 0,0:08:57.11,0:09:02.29,Default,,0000,0000,0000,,سيكون من المؤسف للنبيذ أن يشربه\Nجاهلون بقيمته مثلنا
Dialogue: 0,0:09:04.24,0:09:04.92,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:09:07.13,0:09:09.53,Default,,0000,0000,0000,,إنّها صالحةٌ أكثر مما توقّعت
Dialogue: 0,0:09:09.53,0:09:12.20,Default,,0000,0000,0000,,لم أرَ كونان-كن لفترة
Dialogue: 0,0:09:12.20,0:09:13.10,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:17.58,0:09:19.03,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:09:19.78,0:09:20.94,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:09:22.20,0:09:23.19,Default,,0000,0000,0000,,!ممتاز
Dialogue: 0,0:09:28.86,0:09:30.07,Default,,0000,0000,0000,,!نجاح
Dialogue: 0,0:09:30.07,0:09:32.65,Default,,0000,0000,0000,,!لكن آخ
Dialogue: 0,0:09:46.49,0:09:47.56,Default,,0000,0000,0000,,!ران-نيتشان
Dialogue: 0,0:09:47.56,0:09:48.70,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:09:48.91,0:09:50.03,Default,,0000,0000,0000,,ماذا حدث لإيتشيكاوا-سان؟
Dialogue: 0,0:09:50.34,0:09:51.59,Default,,0000,0000,0000,,انهار فجأةً
Dialogue: 0,0:09:56.86,0:09:57.91,Default,,0000,0000,0000,,!سيّدي الرئيس
Dialogue: 0,0:10:01.27,0:10:02.73,Default,,0000,0000,0000,,ماذا إذاً؟
Dialogue: 0,0:10:09.77,0:10:11.20,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:10:09.77,0:10:11.20,Default,,0000,0000,0000,,!سيّدي
Dialogue: 0,0:10:12.15,0:10:13.78,Default,,0000,0000,0000,,!استدعوا الشرطة
Dialogue: 0,0:10:13.99,0:10:14.70,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:15.02,0:10:18.74,Default,,0000,0000,0000,,،هذا موت غير طبيعيّ حالياً\Nسنحتاج تحليل الشرطة
Dialogue: 0,0:10:28.36,0:10:29.58,Default,,0000,0000,0000,,كأس زجاجيّ؟
Dialogue: 0,0:10:29.58,0:10:34.15,Default,,0000,0000,0000,,انهار فور شربه للنبيذ إذاً؟
Dialogue: 0,0:10:34.15,0:10:34.92,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:35.15,0:10:37.38,Default,,0000,0000,0000,,!لقد قُتل
Dialogue: 0,0:10:37.58,0:10:42.23,Default,,0000,0000,0000,,مهما كان قلبه ضعيفاً، يستحيل أن يموت\N!بعد جرعة نبيذ واحدة
Dialogue: 0,0:10:42.23,0:10:44.30,Default,,0000,0000,0000,,!كان هناك سمٌّ في النبيذ
Dialogue: 0,0:10:44.30,0:10:48.27,Default,,0000,0000,0000,,ماذا؟! أتقصدين أنّني سمّمته؟
Dialogue: 0,0:10:48.73,0:10:50.58,Default,,0000,0000,0000,,!هذا الاحتمال الوحيد
Dialogue: 0,0:10:50.58,0:10:51.73,Default,,0000,0000,0000,,!يا للفظاعة
Dialogue: 0,0:10:51.73,0:10:53.81,Default,,0000,0000,0000,,ألديك أساس لادّعائك؟
Dialogue: 0,0:10:53.81,0:10:57.48,Default,,0000,0000,0000,,!يعرف الطبيب أوكانو حالة أبي
Dialogue: 0,0:10:57.73,0:11:01.52,Default,,0000,0000,0000,,،صحيحٌ أنّ قلبه كان ضعيفاً
Dialogue: 0,0:11:01.52,0:11:03.95,Default,,0000,0000,0000,,لكنّ حدثاً مفاجئاً كهذا غير مُحتمل
Dialogue: 0,0:11:03.95,0:11:05.44,Default,,0000,0000,0000,,!رأيتم؟
Dialogue: 0,0:11:05.44,0:11:07.11,Default,,0000,0000,0000,,!أتقصدين أنّها أنا؟
Dialogue: 0,0:11:07.96,0:11:12.36,Default,,0000,0000,0000,,اعذريني، لكن هل يمكننا تفقّد أغراضك؟
Dialogue: 0,0:11:21.40,0:11:25.11,Default,,0000,0000,0000,,طبيب أوكانو، هل يمكنك معرفة\Nما بهذه القنّينة؟
Dialogue: 0,0:11:26.77,0:11:29.10,Default,,0000,0000,0000,,يبدو أنّه مُرخي عضلات
Dialogue: 0,0:11:29.10,0:11:33.52,Default,,0000,0000,0000,,ماذا يحصل إذا تجرّعه السيّد إيتشيكاوا إذاً؟
Dialogue: 0,0:11:33.81,0:11:37.02,Default,,0000,0000,0000,,إنّه بغاية الخطورة حتّى للأصحّاء
Dialogue: 0,0:11:37.02,0:11:40.11,Default,,0000,0000,0000,,...وبما أنّه كان يعاني مرض قلبٍ عضال
Dialogue: 0,0:11:44.11,0:11:47.41,Default,,0000,0000,0000,,،لا شكّ أنّها هي من أضافت السمّ للنبيذ
Dialogue: 0,0:11:48.11,0:11:51.65,Default,,0000,0000,0000,,لكن من الذي هاجمني؟
Dialogue: 0,0:12:02.51,0:12:06.15,Default,,0000,0000,0000,,ألديكِ فكرة عن دافع كازوي-سان؟
Dialogue: 0,0:12:06.15,0:12:09.90,Default,,0000,0000,0000,,،كان معرضها الفنّي غارقاً في الديون
Dialogue: 0,0:12:09.90,0:12:12.02,Default,,0000,0000,0000,,فلعلّها كانت تسعى للميراث
Dialogue: 0,0:12:12.34,0:12:16.98,Default,,0000,0000,0000,,أعلن أنّه لن يسلّم ولو\Nقرشاً واحداً لابنتيه
Dialogue: 0,0:12:17.31,0:12:18.69,Default,,0000,0000,0000,,يا للحماقة
Dialogue: 0,0:12:18.69,0:12:22.02,Default,,0000,0000,0000,,سنتلقّى حصصنا القانونيّة مهما قال
Dialogue: 0,0:12:22.02,0:12:24.54,Default,,0000,0000,0000,,حتّى لو بقي صامتاً، سنأخذ نسبةً منه
Dialogue: 0,0:12:25.52,0:12:27.86,Default,,0000,0000,0000,,هل كانت هذه الأخت الصغيرة من هاجمتني؟
Dialogue: 0,0:12:28.44,0:12:30.11,Default,,0000,0000,0000,,،إذا اكتشفت خطّة أختها
Dialogue: 0,0:12:30.11,0:12:33.18,Default,,0000,0000,0000,,...واحتجزتني كيلا أعترضها
Dialogue: 0,0:12:36.81,0:12:39.06,Default,,0000,0000,0000,,،إذا تمّ ضبط جريمة الأخت الكبيرة
Dialogue: 0,0:12:39.06,0:12:41.59,Default,,0000,0000,0000,,!سيكون الميراث الكبير لها وحدها
Dialogue: 0,0:12:46.06,0:12:48.41,Default,,0000,0000,0000,,مفتاح واحد بلا سلسلة؟
Dialogue: 0,0:12:49.40,0:12:51.73,Default,,0000,0000,0000,,!المعذرة، المعذرة
Dialogue: 0,0:12:51.73,0:12:53.73,Default,,0000,0000,0000,,أخبرني ما هذا المفتاح؟
Dialogue: 0,0:12:54.69,0:12:56.85,Default,,0000,0000,0000,,أظنّه مفتاح القبو
Dialogue: 0,0:12:57.15,0:13:00.94,Default,,0000,0000,0000,,يا للغرابة، لم يذهب السيّد للقبو في عادته
Dialogue: 0,0:13:04.23,0:13:05.56,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:13:05.56,0:13:09.31,Default,,0000,0000,0000,,أكان من هاجمني واحتجزني في القبو\N!هو الضحيّة إيتشيكاوا-سان؟
Dialogue: 0,0:13:11.19,0:13:16.19,Default,,0000,0000,0000,,في تلك الحالة، فقد شرب النبيذ\N!مع علمه أنّه مسموم
Dialogue: 0,0:13:16.19,0:13:17.73,Default,,0000,0000,0000,,!غير معقول
Dialogue: 0,0:13:32.06,0:13:34.35,Default,,0000,0000,0000,,!عدسات كاميرا فيديو
Dialogue: 0,0:13:35.02,0:13:37.10,Default,,0000,0000,0000,,!السلك ممتدٌّ من السقف
Dialogue: 0,0:13:53.06,0:13:56.31,Default,,0000,0000,0000,,أكان هذا لتصوير الشخص الذي قتله؟
Dialogue: 0,0:14:22.56,0:14:26.69,Default,,0000,0000,0000,,!هذه الرائحة... لم يشرب إيتشيكاوا-سان النبيذ بالفعل
Dialogue: 0,0:14:28.06,0:14:32.28,Default,,0000,0000,0000,,،عرف أنّ الابنة الكبرى كازوي-سان عبثت بالنبيذ
Dialogue: 0,0:14:32.28,0:14:34.74,Default,,0000,0000,0000,,!فسكب النبيذ في هذا الأصيص
Dialogue: 0,0:14:34.98,0:14:38.56,Default,,0000,0000,0000,,!ثمّ تظاهر بشربه وسقوطه ألماً
Dialogue: 0,0:14:38.56,0:14:40.67,Default,,0000,0000,0000,,!لرؤية ردّة فعل الابنتين
Dialogue: 0,0:14:42.48,0:14:46.90,Default,,0000,0000,0000,,لكن لا شكّ بأنّه سُمّم فعلاً
Dialogue: 0,0:14:46.90,0:14:50.11,Default,,0000,0000,0000,,!لا أفهم! كيف تجرّع السمّ؟
Dialogue: 0,0:14:52.81,0:14:54.86,Default,,0000,0000,0000,,...يا إلهي، يتجوّل في المكان
Dialogue: 0,0:14:59.56,0:15:05.06,Default,,0000,0000,0000,,،ماذا لو تلقّى السمّ عبر كبسولة\Nوليس من النبيذ؟
Dialogue: 0,0:15:05.81,0:15:09.27,Default,,0000,0000,0000,,كلا، ذلك غير ممكن من ناحية الوقت
Dialogue: 0,0:15:10.48,0:15:11.61,Default,,0000,0000,0000,,لا جدوى
Dialogue: 0,0:15:11.61,0:15:14.81,Default,,0000,0000,0000,,يستحيل أنّ أحداً سمّمه\N!على مرأى من الجميع
Dialogue: 0,0:15:16.77,0:15:17.89,Default,,0000,0000,0000,,تلقّى؟
Dialogue: 0,0:15:19.77,0:15:24.29,Default,,0000,0000,0000,,وجدتُها! من كان قادراً على ذلك\N!كان ذاك الشخص فقط
Dialogue: 0,0:15:27.21,0:15:30.17,Default,,0000,0000,0000,,!أيّها الشقيّ! تتسلّل لمكانٍ كهذا؟
Dialogue: 0,0:15:31.01,0:15:32.27,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:40.23,0:15:41.35,Default,,0000,0000,0000,,حسناً إذاً
Dialogue: 0,0:15:41.35,0:15:45.73,Default,,0000,0000,0000,,...أنا طبيب شخصيّ فاشل، لم أستطع إنقاذه
Dialogue: 0,0:15:45.73,0:15:49.23,Default,,0000,0000,0000,,!لا تقل ذلك! لم تكن غلطتك
Dialogue: 0,0:15:49.23,0:15:52.36,Default,,0000,0000,0000,,أعتذر على الإطالة يا سادة
Dialogue: 0,0:15:52.36,0:15:55.73,Default,,0000,0000,0000,,اكتشفتُ حقيقة هذه القضيّة أخيراً
Dialogue: 0,0:15:55.73,0:15:58.52,Default,,0000,0000,0000,,فاجتمعوا في غرفة الأعمال من فضلكم
Dialogue: 0,0:16:03.79,0:16:06.62,Default,,0000,0000,0000,,ما قصدك بأنّك اكتشفت الحقيقة يا موري-كن؟
Dialogue: 0,0:16:06.62,0:16:12.01,Default,,0000,0000,0000,,من الصحيح أنّ كازوي-سان سمّمت النبيذ
Dialogue: 0,0:16:13.69,0:16:17.68,Default,,0000,0000,0000,,لكن لم يشربه إيتشيكاوا-سان قطّ
Dialogue: 0,0:16:18.06,0:16:20.18,Default,,0000,0000,0000,,ولا حتى رشفة واحدة
Dialogue: 0,0:16:20.42,0:16:21.48,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:16:21.64,0:16:26.10,Default,,0000,0000,0000,,تظاهر بشربه، وسكبه في الأصيص عند النافذة
Dialogue: 0,0:16:26.10,0:16:28.19,Default,,0000,0000,0000,,أكان السبب قلبه إذاً؟
Dialogue: 0,0:16:28.19,0:16:34.23,Default,,0000,0000,0000,,،كلا، مات من نوبة قلبيّة أثارها سمّ\Nلا شكّ في ذلك
Dialogue: 0,0:16:34.23,0:16:39.03,Default,,0000,0000,0000,,ما الهراء الذي تتفوّه به؟! كانت أختي\N!من قتلته بوضوح
Dialogue: 0,0:16:39.40,0:16:43.31,Default,,0000,0000,0000,,أعتقد أنّه لم يتقبّل الموت بشكلٍ طبيعيّ
Dialogue: 0,0:16:43.31,0:16:46.79,Default,,0000,0000,0000,,رغم أنّه وثق بكما حتّى النهاية
Dialogue: 0,0:16:46.79,0:16:49.79,Default,,0000,0000,0000,,لكن ألم يعيّنك للتحرّي\Nلأنّه لم يثق بهما؟
Dialogue: 0,0:16:49.79,0:16:54.52,Default,,0000,0000,0000,,أراد الوثوق بهما، لذا اختبرهما
Dialogue: 0,0:16:54.52,0:16:56.67,Default,,0000,0000,0000,,ران، شغّلي شريط التسجيل
Dialogue: 0,0:16:57.65,0:16:58.43,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:17:03.16,0:17:03.77,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:17:03.77,0:17:04.94,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:17:04.94,0:17:08.44,Default,,0000,0000,0000,,كلّ هذا من إعداد إيتشيكاوا-سان
Dialogue: 0,0:17:08.44,0:17:14.06,Default,,0000,0000,0000,,،نوى التظاهر بالانهيار من مرض قلبه غالباً
Dialogue: 0,0:17:14.06,0:17:19.41,Default,,0000,0000,0000,,ثمّ التحقّق لاحقاً من شريط التسجيل\Nلرؤية ردّة فعليكما
Dialogue: 0,0:17:19.41,0:17:22.27,Default,,0000,0000,0000,,لكن تغيّرت خطّته
Dialogue: 0,0:17:22.27,0:17:27.11,Default,,0000,0000,0000,,عندما علم أنّ ابنته الكبرى كازوي-سان\Nقد خطّطت لقتله
Dialogue: 0,0:17:27.11,0:17:28.12,Default,,0000,0000,0000,,...عندها
Dialogue: 0,0:17:29.19,0:17:34.27,Default,,0000,0000,0000,,عندها تظاهر بشرب النبيذ المسموم
Dialogue: 0,0:17:34.27,0:17:39.09,Default,,0000,0000,0000,,انتظر، انتظر قليلاً! ألم يكن السمّ سبب موته؟
Dialogue: 0,0:17:39.40,0:17:41.56,Default,,0000,0000,0000,,لا شكّ في ذلك
Dialogue: 0,0:17:41.56,0:17:45.31,Default,,0000,0000,0000,,لكنّه لم يُضف للنبيذ أو طعامه
Dialogue: 0,0:17:45.31,0:17:48.74,Default,,0000,0000,0000,,بل تلقّاه بطريقة مباشرة أكثر
Dialogue: 0,0:17:48.81,0:17:54.40,Default,,0000,0000,0000,,انتظر، لا أظنّ أنّ أحداً امتلك\Nوقتاً كافياً لفعل ذلك
Dialogue: 0,0:17:54.40,0:17:56.44,Default,,0000,0000,0000,,!صحيح! كان الجميع يشاهدون
Dialogue: 0,0:17:56.44,0:18:03.65,Default,,0000,0000,0000,,أجل، سمّم القاتل إيتشيكاوا-سان\Nأمام أنظار الجميع
Dialogue: 0,0:18:03.65,0:18:06.44,Default,,0000,0000,0000,,ران، أوقفي الشريط
Dialogue: 0,0:18:06.44,0:18:07.36,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:18:08.61,0:18:09.87,Default,,0000,0000,0000,,!أيمكن؟
Dialogue: 0,0:18:13.15,0:18:14.06,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:14.06,0:18:15.40,Default,,0000,0000,0000,,طبيب أوكانو
Dialogue: 0,0:18:15.40,0:18:21.88,Default,,0000,0000,0000,,كان بمقدورك حقنه بسمٍّ على أساس\Nأنّه محفز قلب
Dialogue: 0,0:18:21.88,0:18:26.90,Default,,0000,0000,0000,,كنت محيطاً بخطّة إيتشيكاوا-سان، أليس كذلك؟
Dialogue: 0,0:18:26.90,0:18:28.06,Default,,0000,0000,0000,,،بالتفكير في الأمر
Dialogue: 0,0:18:28.06,0:18:33.65,Default,,0000,0000,0000,,كان ليحتاج مساعدة طبيبه لإتمام تمثيله
Dialogue: 0,0:18:33.65,0:18:39.61,Default,,0000,0000,0000,,وإلّا كنتَ ستدرك أنّه يتظاهر فوراً
Dialogue: 0,0:18:40.65,0:18:46.62,Default,,0000,0000,0000,,ائتمنك إيتشيكاوا-سان على خطّته وحدك
Dialogue: 0,0:18:46.62,0:18:48.61,Default,,0000,0000,0000,,،لا أدري ما كانت الخطّة بالضبط
Dialogue: 0,0:18:48.61,0:18:55.50,Default,,0000,0000,0000,,لكنّك قرّرت استغلالها والإقدام على قتله
Dialogue: 0,0:18:55.75,0:18:59.87,Default,,0000,0000,0000,,كان الجميع يعرفون ضعف قلبه
Dialogue: 0,0:19:00.94,0:19:05.85,Default,,0000,0000,0000,,فلن يشكّ أحدٌ في طبيبه الشخصيّ
Dialogue: 0,0:19:05.85,0:19:10.31,Default,,0000,0000,0000,,لكن لمَ؟ لا علاقة له بالميراث، أليس كذلك؟
Dialogue: 0,0:19:10.73,0:19:14.10,Default,,0000,0000,0000,,الدافع الذي يتراءى لي هو الانتقام
Dialogue: 0,0:19:14.90,0:19:16.44,Default,,0000,0000,0000,,،بصفتك طبيبه الشخصيّ
Dialogue: 0,0:19:16.44,0:19:21.57,Default,,0000,0000,0000,,لم تكن هناك حاجة لتلويث يديك بقتله
Dialogue: 0,0:19:22.15,0:19:26.03,Default,,0000,0000,0000,,،إذا أخبرته أنّ حالته لم تكن خطرة، فبالنظر لشخصيّته
Dialogue: 0,0:19:26.03,0:19:33.00,Default,,0000,0000,0000,,كان سيضغط على نفسه ولن يتقاعد، مما سيعجّل وفاته
Dialogue: 0,0:19:33.27,0:19:36.96,Default,,0000,0000,0000,,...إقدامك على فعلةٍ مباشرة يعني أنّك
Dialogue: 0,0:19:36.96,0:19:39.19,Default,,0000,0000,0000,,أبغضتُه
Dialogue: 0,0:19:40.61,0:19:41.92,Default,,0000,0000,0000,,لذاك الحدّ
Dialogue: 0,0:19:43.02,0:19:49.56,Default,,0000,0000,0000,,قتل الرئيس، بل إيتشيكاوا كوتارو، أبي
Dialogue: 0,0:19:52.65,0:19:58.40,Default,,0000,0000,0000,,كان أبي وإيتشيكاوا شريكين\Nعندما تأسّست شركتُهما
Dialogue: 0,0:19:58.40,0:20:01.23,Default,,0000,0000,0000,,حدث ذلك قبل 30 عاماً
Dialogue: 0,0:20:01.23,0:20:04.98,Default,,0000,0000,0000,,حقّقت مجازفتهما التجارية نجاحاً كبيراً
Dialogue: 0,0:20:06.23,0:20:10.02,Default,,0000,0000,0000,,لكنّ هذا الرجل خان أبي وطرده
Dialogue: 0,0:20:10.02,0:20:12.37,Default,,0000,0000,0000,,دون إعطائه ينّاً واحداً
Dialogue: 0,0:20:13.52,0:20:15.83,Default,,0000,0000,0000,,كانت حياتي العائلية تعيسةً بعدها
Dialogue: 0,0:20:16.36,0:20:19.27,Default,,0000,0000,0000,,كان يتشكّى لي، ابنه الصغير، دوماً
Dialogue: 0,0:20:20.25,0:20:24.94,Default,,0000,0000,0000,,في النهاية، تُوفيت أمّي قبل دخولي المدرسة المتوسّطة
Dialogue: 0,0:20:24.94,0:20:29.38,Default,,0000,0000,0000,,وعجّل أبي موته
Dialogue: 0,0:20:30.56,0:20:35.89,Default,,0000,0000,0000,,عندها، ظهر هذا الرجل أمامي بعدما أصبحتُ طبيباً
Dialogue: 0,0:20:38.31,0:20:42.32,Default,,0000,0000,0000,,لم يدرك من كنت
Dialogue: 0,0:20:43.31,0:20:49.81,Default,,0000,0000,0000,,لكن عندما أخبرني بخطّته\N،في اختبار ولاء ابنتيه
Dialogue: 0,0:20:50.21,0:20:52.08,Default,,0000,0000,0000,,حسمتُ قراري
Dialogue: 0,0:20:52.98,0:20:58.04,Default,,0000,0000,0000,,كبير خونةٍ مثله يختبر ولاء الآخرين؟
Dialogue: 0,0:20:58.69,0:20:59.94,Default,,0000,0000,0000,,...لم أستطع مسامحته
Dialogue: 0,0:21:02.28,0:21:03.73,Default,,0000,0000,0000,,!لم أستطع مسامحته
Dialogue: 0,0:22:46.77,0:22:49.06,Default,,0000,0000,0000,,!حسناً، سأكون مشغولةً الآن
Dialogue: 0,0:22:49.06,0:22:51.81,Default,,0000,0000,0000,,!عليّ تنظيم الأشياء التي تركها أبي
Dialogue: 0,0:22:51.81,0:22:52.74,Default,,0000,0000,0000,,!سيّدتي
Dialogue: 0,0:22:54.02,0:22:56.44,Default,,0000,0000,0000,,...سيّدتي، بخصوص ذلك
Dialogue: 0,0:22:56.44,0:23:00.77,Default,,0000,0000,0000,,ذكر سيّدي في وصيّته أنّه\N،في حال أُصيب بمكروه
Dialogue: 0,0:23:00.77,0:23:03.44,Default,,0000,0000,0000,,فسيتمّ التبرّع بكلّ شيء
Dialogue: 0,0:23:03.44,0:23:06.21,Default,,0000,0000,0000,,!لا تعبث معي! لن أسمح بشيءٍ كهذا
Dialogue: 0,0:23:06.48,0:23:11.17,Default,,0000,0000,0000,,...لكنّه كتب الوصيّة في حضرة محامٍ
Dialogue: 0,0:23:11.56,0:23:14.65,Default,,0000,0000,0000,,اسمع، هناك ما يُسمّى بالحصص المفروضة قانونياً
Dialogue: 0,0:23:14.65,0:23:17.40,Default,,0000,0000,0000,,!سأحصل على ما هو من حقّي
Dialogue: 0,0:23:17.40,0:23:18.42,Default,,0000,0000,0000,,ميزوي-سان
Dialogue: 0,0:23:18.42,0:23:19.94,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:23:19.94,0:23:25.10,Default,,0000,0000,0000,,سمعتُ أنّك تخلّصتِ من شهادات\Nأسهم والدك بنفسك
Dialogue: 0,0:23:27.06,0:23:31.40,Default,,0000,0000,0000,,وصلني أنّ مجلس الإدارة سيقاضيك بالاختلاس
Dialogue: 0,0:23:31.40,0:23:34.32,Default,,0000,0000,0000,,!لا يمكن! لا يمكن! لا يمكن
Dialogue: 0,0:23:34.32,0:23:36.21,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:23:36.90,0:23:40.11,Default,,0000,0000,0000,,في النهاية، لم تحصل أيّ من ابنتي إيتشيكاوا-سان
Dialogue: 0,0:23:40.11,0:23:42.52,Default,,0000,0000,0000,,على ينٍّ من ميراثه حتّى
Dialogue: 0,0:23:42.52,0:23:46.06,Default,,0000,0000,0000,,انتظروا! ما الذي سيحلّ بهذا المنزل؟
Dialogue: 0,0:23:46.06,0:23:48.98,Default,,0000,0000,0000,,ما قصدك؟ سيتمّ التبرّع به لأحدٍ بالتأكيد
Dialogue: 0,0:23:48.98,0:23:52.06,Default,,0000,0000,0000,,!ماذا سيحلّ بأجري إذاً؟
Dialogue: 0,0:23:52.06,0:23:53.86,Default,,0000,0000,0000,,!حصلت على مليون ينٍّ سلفاً
Dialogue: 0,0:23:53.86,0:23:55.51,Default,,0000,0000,0000,,!ماذا عن المليون الأخرى؟
Dialogue: 0,0:23:55.51,0:23:56.55,Default,,0000,0000,0000,,انسَها
Dialogue: 0,0:23:56.55,0:23:59.02,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:24:09.77,0:24:11.23,Default,,0000,0000,0000,,!أ-أنت
Dialogue: 0,0:24:11.23,0:24:13.03,Default,,0000,0000,0000,,ما الذي تفعله؟
Dialogue: 0,0:24:13.61,0:24:17.87,Default,,0000,0000,0000,,...وهل صادف هذه المرّة أيضاً
Dialogue: 0,0:24:18.17,0:24:20.61,Default,,0000,0000,0000,,!أنّك هنا يا موري-كن؟
Dialogue: 0,0:24:20.61,0:24:25.47,Default,,0000,0000,0000,,!لا-لا تصرخ رجاءً حضرة المفتّش\N...أعاني آثار الثمل ورأسي يوجعني
Dialogue: 0,0:24:25.47,0:24:31.47,On Top,,0000,0000,0000,,جريمة قتل الفخّاري الشهير\N(الجزء الأوّل)
Dialogue: 0,0:24:26.49,0:24:28.11,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:28.11,0:24:31.55,Default,,0000,0000,0000,,جريمة قتل الفخّاري الشهير\N(الجزء الأوّل)
Dialogue: 0,0:24:47.27,0:24:49.43,Default,,0000,0000,0000,,تلميح الحلقة القادمة، معكم الضابط تاكاغي
Dialogue: 0,0:24:49.79,0:24:50.84,Default,,0000,0000,0000,,كور رخاميّة
Dialogue: 0,0:24:51.49,0:24:53.11,Default,,0000,0000,0000,,(قضيّة الحلقة القادمة عن الفخّار! (ياكيمونو
Dialogue: 0,0:24:53.11,0:24:54.31,Default,,0000,0000,0000,,أحبّ الشوي
Dialogue: 0,0:24:54.31,0:24:56.27,Default,,0000,0000,0000,,ذلك "ياكينيكو" يا تاكاغي-كن

