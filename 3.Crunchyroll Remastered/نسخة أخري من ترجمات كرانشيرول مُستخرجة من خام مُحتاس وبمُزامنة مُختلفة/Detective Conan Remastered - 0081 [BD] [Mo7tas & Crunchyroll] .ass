Dialogue: 0,0:00:01.66,0:00:03.31,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب لامع
Dialogue: 0,0:00:03.31,0:00:06.26,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:06.85,0:00:10.65,Default,,0000,0000,0000,,!قضيّة اليوم مرتبطة بالموسيقى! أوّل عرض لأداء الكاراوكي لي
Dialogue: 0,0:00:10.65,0:00:12.34,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.34,0:00:14.18,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.54,0:00:16.51,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:50.22,0:01:57.59,On Top,,0000,0000,0000,,صندوق كاراوكي
Dialogue: 0,0:01:53.76,0:01:59.56,Default,,0000,0000,0000,,♪ أوّل نهاية للقرن في مئة عام ♪
Dialogue: 0,0:01:59.56,0:02:05.68,Default,,0000,0000,0000,,♪ عندما يطلبون منّي أن أبكي، أضحك بدل ذلك ♪
Dialogue: 0,0:02:11.84,0:02:18.08,Default,,0000,0000,0000,,♪ أوّل نهاية للقرن منذ وقتٍ طويل ♪
Dialogue: 0,0:02:19.21,0:02:25.20,Title,,0000,0000,15,,{\fad(300,0)}قضيّة اختطاف الفنّانين الشهيرين\N(الجزء الأوّل)
Dialogue: 0,0:02:20.06,0:02:24.30,Default,,0000,0000,0000,,قضيّة اختطاف الفنّانين الشهيرين\N(الجزء الأوّل)
Dialogue: 0,0:02:25.20,0:02:26.72,Default,,0000,0000,0000,,!ها أنا ذا
Dialogue: 0,0:02:29.17,0:02:31.18,Default,,0000,0000,0000,,!حسناً، لنختبئ
Dialogue: 0,0:02:31.23,0:02:32.16,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:32.26,0:02:36.04,Default,,0000,0000,0000,,...غينتا هذا، ركلها بهذه القوّة
Dialogue: 0,0:02:38.33,0:02:40.91,Default,,0000,0000,0000,,طالب في الثانويّة يلعب\Nركل العلبة؟
Dialogue: 0,0:02:40.91,0:02:44.06,Default,,0000,0000,0000,,وفي هذا المكان؟
Dialogue: 0,0:02:44.78,0:02:46.90,Default,,0000,0000,0000,,ما خطب هذا الحشد بأيّ حال؟
Dialogue: 0,0:02:46.90,0:02:48.87,Default,,0000,0000,0000,,!ماذا؟ كونان-كن
Dialogue: 0,0:02:49.74,0:02:51.87,Default,,0000,0000,0000,,ما الذي تفعله هنا؟
Dialogue: 0,0:02:51.87,0:02:54.39,Default,,0000,0000,0000,,ماذا تفعلان أنتما؟
Dialogue: 0,0:02:54.39,0:02:56.31,Default,,0000,0000,0000,,!حفلة موسيقية
Dialogue: 0,0:02:56.31,0:02:59.10,Default,,0000,0000,0000,,!أتينا لحضور حفلة مباشرة في بودوكان
Dialogue: 0,0:02:59.64,0:03:00.83,Default,,0000,0000,0000,,وما هذه الأزهار؟
Dialogue: 0,0:03:01.31,0:03:02.63,Default,,0000,0000,0000,,هذه؟
Dialogue: 0,0:03:02.63,0:03:04.63,Default,,0000,0000,0000,,،تبدأ الحفلة عند السادسة
Dialogue: 0,0:03:04.63,0:03:07.51,Default,,0000,0000,0000,,لكن ظننا أنّنا قد نلتقيهما\Nإذا أتينا باكراً
Dialogue: 0,0:03:07.51,0:03:12.41,Default,,0000,0000,0000,,يأتي الموسيقيّون للمسرح قبل\Nستّ ساعات من بدء الحفلة عادةً
Dialogue: 0,0:03:13.12,0:03:14.12,Default,,0000,0000,0000,,تلتقيانهما؟
Dialogue: 0,0:03:14.34,0:03:17.87,Default,,0000,0000,0000,,!ما الذي تقوله؟ نقصد الاثنين من "تو-ميكس" بالطبع
Dialogue: 0,0:03:18.29,0:03:19.83,Default,,0000,0000,0000,,تو-ميكس؟
Dialogue: 0,0:03:20.96,0:03:22.40,Default,,0000,0000,0000,,!لا تعرفهما؟
Dialogue: 0,0:03:22.40,0:03:26.79,Default,,0000,0000,0000,,إنّهما الثنائيّ الشهير جدّاً الآن\N!من تاكاياما مينامي وناغانو شينا
Dialogue: 0,0:03:27.30,0:03:30.41,Default,,0000,0000,0000,,تقصدان ثنائيّ الغناء والرقص\Nالمُبهرج ذاك إذاً؟
Dialogue: 0,0:03:31.12,0:03:32.44,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:03:32.44,0:03:35.35,Default,,0000,0000,0000,,لا تتكلّم عنهما هكذا\N!وأنت لم تسمع لهما
Dialogue: 0,0:03:35.53,0:03:38.58,Default,,0000,0000,0000,,مهلك، لا يزال كونان-كن طفلاً
Dialogue: 0,0:03:39.10,0:03:43.01,Default,,0000,0000,0000,,كما تذكرين عندما أخذناه للكاراوكي؟
Dialogue: 0,0:03:43.14,0:03:44.64,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:03:44.93,0:03:47.99,Default,,0000,0000,0000,,كان صوت غنائه نشازاً حقاً
Dialogue: 0,0:03:49.13,0:03:50.22,Default,,0000,0000,0000,,أجل، أجل
Dialogue: 0,0:03:50.22,0:03:54.50,Default,,0000,0000,0000,,مثل شخصٍ ما لا يحمل\Nأيّ اهتمام بالموسيقى
Dialogue: 0,0:03:54.50,0:03:57.49,Default,,0000,0000,0000,,أي لا يستوعب مدى روعتهما؟
Dialogue: 0,0:03:59.00,0:04:00.21,Default,,0000,0000,0000,,اعذريني
Dialogue: 0,0:04:00.40,0:04:01.96,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:04:02.12,0:04:03.91,Default,,0000,0000,0000,,ما الذي تفعله؟
Dialogue: 0,0:04:03.91,0:04:05.91,Default,,0000,0000,0000,,!فلتلعب بجديّة
Dialogue: 0,0:04:05.98,0:04:06.74,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:04:06.74,0:04:07.77,Default,,0000,0000,0000,,أراكما لاحقاً
Dialogue: 0,0:04:07.77,0:04:08.30,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:08.91,0:04:10.78,Default,,0000,0000,0000,,!لا ترافقوا أي غرباء
Dialogue: 0,0:04:10.86,0:04:12.91,Default,,0000,0000,0000,,!أنا موجود فلا تقلقي
Dialogue: 0,0:04:12.22,0:04:12.91,On Top,,0000,0000,0000,,!لن نفعل
Dialogue: 0,0:04:12.91,0:04:15.33,Default,,0000,0000,0000,,أنت أكبر مصدر للقلق
Dialogue: 0,0:04:15.69,0:04:17.04,Default,,0000,0000,0000,,!إلى اللقاء
Dialogue: 0,0:04:17.20,0:04:19.98,Default,,0000,0000,0000,,يوجد حشدٌ كبير من الناس بالفعل
Dialogue: 0,0:04:19.98,0:04:22.05,Default,,0000,0000,0000,,أين تذهب ران وسونوكو؟
Dialogue: 0,0:04:22.05,0:04:27.04,Default,,0000,0000,0000,,لحفلة تو ميكس، قالتا أنّهما\N...ستعطيانهما باقة أزهار
Dialogue: 0,0:04:27.04,0:04:28.06,Default,,0000,0000,0000,,!حقّاً؟
Dialogue: 0,0:04:28.06,0:04:29.70,Default,,0000,0000,0000,,!فرقة تو-ميكس تلك؟
Dialogue: 0,0:04:29.70,0:04:32.20,Default,,0000,0000,0000,,!التي غنّت افتتاحية يايبا المقنّع قبلاً؟
Dialogue: 0,0:04:32.54,0:04:35.05,Default,,0000,0000,0000,,ماذا؟ حتى هؤلاء؟
Dialogue: 0,0:04:35.16,0:04:37.78,Default,,0000,0000,0000,,!اسمعوا، لنذهب بدورنا
Dialogue: 0,0:04:37.78,0:04:38.79,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:04:38.79,0:04:40.58,Default,,0000,0000,0000,,!قد نحصل على توقيعهما
Dialogue: 0,0:04:40.66,0:04:41.99,Default,,0000,0000,0000,,...يا ربّاه
Dialogue: 0,0:04:42.11,0:04:43.22,Default,,0000,0000,0000,,!لنسرع
Dialogue: 0,0:04:43.22,0:04:44.07,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:04:50.66,0:04:52.27,Default,,0000,0000,0000,,المعذرة يا صغار
Dialogue: 0,0:04:52.27,0:04:54.90,Default,,0000,0000,0000,,!انظر أمامك عندما تمشي يا أخّ
Dialogue: 0,0:04:56.52,0:04:57.83,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:04:58.15,0:05:01.34,Default,,0000,0000,0000,,!تاكاياما مينامي من تو-ميكس
Dialogue: 0,0:05:03.39,0:05:04.78,Default,,0000,0000,0000,,أقالت تاكاياما؟
Dialogue: 0,0:05:05.10,0:05:06.53,Default,,0000,0000,0000,,!تاكاياما مينامي؟
Dialogue: 0,0:05:06.53,0:05:07.24,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:05:15.84,0:05:21.29,Default,,0000,0000,0000,,أخبروني يا صغار، أتشعرون بالجوع؟\Nما رأيكم بأن يدعوكم أخوكم على حسابه؟
Dialogue: 0,0:05:21.67,0:05:23.98,Default,,0000,0000,0000,,!ممتاز، لنذهب
Dialogue: 0,0:05:25.12,0:05:26.29,Default,,0000,0000,0000,,!كلوا قدرما تشاؤون
Dialogue: 0,0:05:27.66,0:05:29.33,Default,,0000,0000,0000,,يبدو أنّها لم تكن هي
Dialogue: 0,0:05:29.33,0:05:30.50,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:05:32.45,0:05:34.15,Default,,0000,0000,0000,,!يبدو لذيذاً جدّاً
Dialogue: 0,0:05:34.15,0:05:36.29,Default,,0000,0000,0000,,!شكراً على الطعام
Dialogue: 0,0:05:43.29,0:05:43.88,Default,,0000,0000,0000,,!لذيذ
Dialogue: 0,0:05:43.88,0:05:44.53,Default,,0000,0000,0000,,!بالفعل
Dialogue: 0,0:05:44.81,0:05:48.62,Default,,0000,0000,0000,,ماذا عن عدم مرافقة الغرباء؟
Dialogue: 0,0:05:48.92,0:05:52.20,Default,,0000,0000,0000,,يا إلهي، طلبوا الأشياء الباهظة وحسب
Dialogue: 0,0:05:52.50,0:05:54.87,Default,,0000,0000,0000,,ماذا؟ لن تأكلي يا مينامي-تشان؟
Dialogue: 0,0:05:56.75,0:05:59.95,Default,,0000,0000,0000,,!لا داعي! لستُ جائعة
Dialogue: 0,0:06:00.59,0:06:03.07,Default,,0000,0000,0000,,كان عليّ جلب مالٍ أكثر
Dialogue: 0,0:06:03.33,0:06:08.04,Default,,0000,0000,0000,,لكن أيجدر بك التواجد هنا؟ ألا يُفترض \Nأن تولّفوا الآلات الموسيقية قبل الحفلة؟
Dialogue: 0,0:06:08.29,0:06:13.21,Default,,0000,0000,0000,,بلى، علينا فعل ذلك\Nلكن لم يأت زميلي شينا-كن بعد
Dialogue: 0,0:06:13.57,0:06:15.74,Default,,0000,0000,0000,,ولا أحصل على ردّ عندما\Nأتّصل بهاتفه الخلويّ
Dialogue: 0,0:06:16.07,0:06:21.36,Default,,0000,0000,0000,,فتسلّلتُ خارج القاعة للبحث عنه
Dialogue: 0,0:06:21.36,0:06:23.93,Default,,0000,0000,0000,,لمَ لا تجرّبين الاتّصال به\Nمجدداً من هنا؟
Dialogue: 0,0:06:23.93,0:06:27.90,Default,,0000,0000,0000,,أودّ ذلك، لكن نسيتُ هاتفي في المكتب
Dialogue: 0,0:06:28.22,0:06:31.87,Default,,0000,0000,0000,,وذاك الشخص يستعمل هاتف المطعم لفترة
Dialogue: 0,0:06:32.11,0:06:33.93,Default,,0000,0000,0000,,حظّك سيّئ
Dialogue: 0,0:06:33.93,0:06:34.86,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:06:36.71,0:06:40.26,Default,,0000,0000,0000,,أعاني من الحظّ السيّئ مؤخراً بشكل غريب
Dialogue: 0,0:06:40.26,0:06:41.08,Default,,0000,0000,0000,,غريب؟
Dialogue: 0,0:06:41.46,0:06:44.58,Default,,0000,0000,0000,,مثل فتح أحدهم خزانتي في المكتب عنوة
Dialogue: 0,0:06:44.58,0:06:48.54,Default,,0000,0000,0000,,وآثار عبث بقفل باب منزلي
Dialogue: 0,0:06:48.87,0:06:51.12,Default,,0000,0000,0000,,!واتّصالات عابثة يومياً
Dialogue: 0,0:06:51.12,0:06:53.81,Default,,0000,0000,0000,,:رجل غريب يقول شيئاً واحداً
Dialogue: 0,0:06:55.40,0:06:56.45,Default,,0000,0000,0000,,"لا تغنّي"
Dialogue: 0,0:06:59.97,0:07:01.85,Default,,0000,0000,0000,,أيمكن أنّه مُلاحق؟
Dialogue: 0,0:07:01.85,0:07:04.28,Default,,0000,0000,0000,,هذه قضيّة مضايقة
Dialogue: 0,0:07:04.28,0:07:05.56,Default,,0000,0000,0000,,...إذا كانت قضيّة
Dialogue: 0,0:07:05.56,0:07:08.00,Default,,0000,0000,0000,,!فاتركيها لفرقة فتيان التحرّي
Dialogue: 0,0:07:09.06,0:07:10.60,Default,,0000,0000,0000,,...شكراً
Dialogue: 0,0:07:10.60,0:07:13.70,Default,,0000,0000,0000,,اعتبروا هذا الطعام أجركم إذاً
Dialogue: 0,0:07:14.01,0:07:17.37,Default,,0000,0000,0000,,أخبريني، متى بدأت المضايقات؟
Dialogue: 0,0:07:17.80,0:07:21.51,Default,,0000,0000,0000,,حسناً... في الأحد الفائت وفقما أظنّ
Dialogue: 0,0:07:21.51,0:07:24.20,Default,,0000,0000,0000,,بعد انتهاء بثّنا الإذاعيّ المباشر
Dialogue: 0,0:07:24.20,0:07:26.28,Default,,0000,0000,0000,,!استمعتُ لذلك البثّ
Dialogue: 0,0:07:26.28,0:07:27.37,Default,,0000,0000,0000,,!وأنا كذلك
Dialogue: 0,0:07:27.37,0:07:31.37,Default,,0000,0000,0000,,أذعتم شريط استعراض لأغنيتكم الجديدة، أليس كذلك؟
Dialogue: 0,0:07:31.37,0:07:32.78,Default,,0000,0000,0000,,شريط استعراض؟
Dialogue: 0,0:07:32.78,0:07:35.61,Default,,0000,0000,0000,,يمكنكم الاستماع له كاملاً إن أردتم
Dialogue: 0,0:07:36.11,0:07:37.24,Default,,0000,0000,0000,,!حقّاً؟
Dialogue: 0,0:07:37.78,0:07:41.71,Default,,0000,0000,0000,,ها هو، الشريط الاستعراضيّ الفريد\N!من نوعه في العالم
Dialogue: 0,0:07:55.76,0:07:56.65,Default,,0000,0000,0000,,ما رأيكم؟
Dialogue: 0,0:07:56.65,0:07:59.50,Default,,0000,0000,0000,,!كانت الأغنية والموسيقى رائعة
Dialogue: 0,0:07:59.97,0:08:01.34,Default,,0000,0000,0000,,ماذا عنك؟
Dialogue: 0,0:08:01.34,0:08:04.00,Default,,0000,0000,0000,,...لا أسمع أصواتاً غريبة
Dialogue: 0,0:08:04.00,0:08:06.33,Default,,0000,0000,0000,,!يا للفظاظة! بالطبع لن تسمع
Dialogue: 0,0:08:06.62,0:08:09.79,Default,,0000,0000,0000,,لا يبدو أنّ هذا الشريط\Nكان سبب المضايقات
Dialogue: 0,0:08:10.04,0:08:12.45,Default,,0000,0000,0000,,ما رأيك بالأغنية إذاً؟
Dialogue: 0,0:08:12.45,0:08:14.52,Default,,0000,0000,0000,,حسناً، لا بأس بها
Dialogue: 0,0:08:14.52,0:08:17.29,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:08:18.32,0:08:20.82,Default,,0000,0000,0000,,حللتَ القضيّة بالفعل؟
Dialogue: 0,0:08:20.82,0:08:23.81,Default,,0000,0000,0000,,!كلا، إنّه الصوت
Dialogue: 0,0:08:23.81,0:08:26.24,Default,,0000,0000,0000,,كان هناك شيء عالق في ذهني لفترة
Dialogue: 0,0:08:26.60,0:08:29.71,Default,,0000,0000,0000,,!صوت مينامي-سان وكونان-كن متشابه
Dialogue: 0,0:08:31.86,0:08:33.66,Default,,0000,0000,0000,,...مستحيل
Dialogue: 0,0:08:31.86,0:08:33.66,Default,,0000,0000,0000,,...مستحيل
Dialogue: 0,0:08:33.66,0:08:35.09,Default,,0000,0000,0000,,!معك حق
Dialogue: 0,0:08:35.09,0:08:36.63,Default,,0000,0000,0000,,كقنفذي بحر
Dialogue: 0,0:08:36.63,0:08:39.31,Default,,0000,0000,0000,,!التشبيه الأصحّ هو كنصفيّ بطيخة
Dialogue: 0,0:08:40.26,0:08:44.02,Default,,0000,0000,0000,,ربما يمكنك أخذ دوري\Nمتى أصبتُ بزكام إذاً
Dialogue: 0,0:08:45.28,0:08:48.75,Default,,0000,0000,0000,,لا يمكن، فكونان-كن لديه عمه موسيقى
Dialogue: 0,0:08:51.42,0:08:53.45,Default,,0000,0000,0000,,هذا كلّ ما سأسمعه اليوم
Dialogue: 0,0:08:54.53,0:08:57.83,Default,,0000,0000,0000,,...لا يزال ذاك الرجل على الهاتف
Dialogue: 0,0:08:58.39,0:08:59.75,Default,,0000,0000,0000,,يمكنك استعمال هذه إذاً
Dialogue: 0,0:09:00.54,0:09:01.08,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:09:02.92,0:09:03.98,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:09:04.18,0:09:05.86,Default,,0000,0000,0000,,يا له من قرط عجيب
Dialogue: 0,0:09:06.18,0:09:08.60,Default,,0000,0000,0000,,إنّه هاتف خلويّ بشكل قرط
Dialogue: 0,0:09:08.60,0:09:11.57,Default,,0000,0000,0000,,صنعه لي صديقي البروفسور آغاسا
Dialogue: 0,0:09:13.13,0:09:15.48,Default,,0000,0000,0000,,أضعه على أذني إذاً، صحيح؟
Dialogue: 0,0:09:15.80,0:09:19.17,Default,,0000,0000,0000,,...لا، عليكِ طلب الرقم قبل
Dialogue: 0,0:09:19.17,0:09:20.70,Default,,0000,0000,0000,,!تاكاياما-ساما
Dialogue: 0,0:09:21.21,0:09:24.29,Default,,0000,0000,0000,,هل يوجد تاكاياما-ساما بين الزبائن؟
Dialogue: 0,0:09:24.29,0:09:25.65,Default,,0000,0000,0000,,!تلك أنا
Dialogue: 0,0:09:26.29,0:09:28.79,Default,,0000,0000,0000,,مكالمة من ناغانو شينا-ساما
Dialogue: 0,0:09:29.31,0:09:30.36,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:09:31.20,0:09:35.19,Default,,0000,0000,0000,,!أين أنت؟ بدؤوا بتوليف الآلات
Dialogue: 0,0:09:35.19,0:09:37.69,Default,,0000,0000,0000,,آسف، طرأ أمرٌ ما
Dialogue: 0,0:09:37.69,0:09:40.36,Default,,0000,0000,0000,,أنا في سيّارة أمام المحلّ الآن
Dialogue: 0,0:09:40.36,0:09:41.03,Default,,0000,0000,0000,,سيّارة؟
Dialogue: 0,0:09:42.93,0:09:44.91,Default,,0000,0000,0000,,ما قصّة تلك السيّارة؟
Dialogue: 0,0:09:45.78,0:09:49.70,Default,,0000,0000,0000,,لـ-لديّ ما أريد أن أريك إيّاه، هلّا أتيتِ؟
Dialogue: 0,0:09:49.70,0:09:51.05,Default,,0000,0000,0000,,إليك؟
Dialogue: 0,0:09:51.05,0:09:52.40,Default,,0000,0000,0000,,نـ-نعم
Dialogue: 0,0:09:55.46,0:09:57.32,Default,,0000,0000,0000,,!لا تأتي يا مينامي! إيّاك
Dialogue: 0,0:09:57.76,0:09:59.82,Default,,0000,0000,0000,,!ماذا؟ مرحباً؟
Dialogue: 0,0:10:01.91,0:10:04.05,Default,,0000,0000,0000,,ما خطبه؟
Dialogue: 0,0:10:06.41,0:10:08.16,Default,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:10:09.95,0:10:11.32,Default,,0000,0000,0000,,...لمَ ذاك الرجل
Dialogue: 0,0:10:14.44,0:10:17.95,Default,,0000,0000,0000,,!شينا-كن! ما بك؟ أجبني على الأقل
Dialogue: 0,0:10:18.74,0:10:19.91,Default,,0000,0000,0000,,لا تتحرّكي
Dialogue: 0,0:10:22.21,0:10:23.48,Default,,0000,0000,0000,,!شينا-كن
Dialogue: 0,0:10:23.77,0:10:25.69,Default,,0000,0000,0000,,هيّا، ادخلي
Dialogue: 0,0:10:28.52,0:10:30.23,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:10:30.23,0:10:31.20,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:10:36.34,0:10:38.67,Default,,0000,0000,0000,,...مينامي-تشان... مينامي-تشان قد
Dialogue: 0,0:10:38.67,0:10:39.86,Default,,0000,0000,0000,,!اُختطفت
Dialogue: 0,0:10:40.21,0:10:43.75,Default,,0000,0000,0000,,!تبّاً! اختطاف أمام ناظري؟
Dialogue: 0,0:10:55.40,0:10:57.58,Default,,0000,0000,0000,,مرحباً، هنا بودوكان
Dialogue: 0,0:10:58.62,0:11:00.49,Default,,0000,0000,0000,,آسف، هلّا أعدت كلامك؟
Dialogue: 0,0:11:00.49,0:11:02.73,Default,,0000,0000,0000,,عضوا تو-ميكس رهينتان عندي
Dialogue: 0,0:11:02.73,0:11:03.61,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:03.61,0:11:07.10,Default,,0000,0000,0000,,إذا أردتم إنقاذهما فاطلبا الشرطة فوراً
Dialogue: 0,0:11:07.10,0:11:09.67,Default,,0000,0000,0000,,!توقّف عن العبث
Dialogue: 0,0:11:10.39,0:11:11.67,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:11:11.67,0:11:14.27,Default,,0000,0000,0000,,يقول أنّه اختطف تو-ميكس
Dialogue: 0,0:11:14.40,0:11:15.57,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:11:15.57,0:11:20.11,Default,,0000,0000,0000,,يقول هؤلاء الأطفال أنّهم رأوا\Nتاكاياما مينامي-سان تُختطف
Dialogue: 0,0:11:20.83,0:11:21.81,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:11:21.81,0:11:22.96,Default,,0000,0000,0000,,!إنّها الحقيقة
Dialogue: 0,0:11:22.96,0:11:25.64,Default,,0000,0000,0000,,!رأينا رجلاً يدفعها لسيّارة
Dialogue: 0,0:11:25.64,0:11:27.15,Default,,0000,0000,0000,,!انقذوا مينامي-تشان
Dialogue: 0,0:11:27.15,0:11:29.17,Default,,0000,0000,0000,,...كان ذلك الاتّصال إذاً
Dialogue: 0,0:11:29.17,0:11:30.46,Default,,0000,0000,0000,,!إنّها مصيبة
Dialogue: 0,0:11:30.46,0:11:32.16,Default,,0000,0000,0000,,!اتّصلوا بالشرطة فوراً
Dialogue: 0,0:11:32.16,0:11:32.90,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:34.86,0:11:37.24,Default,,0000,0000,0000,,يبدو أنّها ستُمطر
Dialogue: 0,0:11:37.24,0:11:40.52,Default,,0000,0000,0000,,سنتبلل إذا لم يبدؤوا سريعاً
Dialogue: 0,0:11:42.46,0:11:43.82,Default,,0000,0000,0000,,!سيّارات شرطة
Dialogue: 0,0:11:44.27,0:11:45.90,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:11:52.80,0:11:54.37,Default,,0000,0000,0000,,!حضرة المفتّش! من هنا
Dialogue: 0,0:11:55.01,0:11:58.59,Default,,0000,0000,0000,,فلتتفرقوا وتستجوبوا الناس في المنطقة
Dialogue: 0,0:11:58.59,0:11:59.32,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:59.74,0:12:00.61,Default,,0000,0000,0000,,!حسناً، لنذهب
Dialogue: 0,0:12:00.61,0:12:01.19,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:12:04.04,0:12:09.49,Default,,0000,0000,0000,,إذاً أيّها المدير، غادرت تاكاياما مينامي-سان القاعة بمفردها؟
Dialogue: 0,0:12:09.79,0:12:15.44,Default,,0000,0000,0000,,نعم، لم نستطع الوصول لناغانو-كن\Nفذهبت للبحث عنه
Dialogue: 0,0:12:15.70,0:12:19.45,Default,,0000,0000,0000,,بعدها، بينما كانت تأكل مع كونان والأطفال
Dialogue: 0,0:12:19.45,0:12:21.90,Default,,0000,0000,0000,,استُدعيت للخارج بعد اتّصال واختُطفت؟
Dialogue: 0,0:12:21.90,0:12:25.44,Default,,0000,0000,0000,,أجل، بعدما تلقّت الاتّصال وخرجت
Dialogue: 0,0:12:25.44,0:12:29.11,Default,,0000,0000,0000,,!دفعها الرجل الذي كان يتبعها داخل السيّارة
Dialogue: 0,0:12:29.11,0:12:31.94,Default,,0000,0000,0000,,!ماذا؟! رأيتم الفاعل إذاً؟
Dialogue: 0,0:12:31.94,0:12:34.72,Default,,0000,0000,0000,,...أجل، كان بنفس طول العمّ موري تقريباً
Dialogue: 0,0:12:34.72,0:12:37.26,Default,,0000,0000,0000,,!ويرتدي قبّعة تزلج ووشاحاً
Dialogue: 0,0:12:37.26,0:12:39.51,Default,,0000,0000,0000,,!ونظّارات مستديرة
Dialogue: 0,0:12:39.51,0:12:42.71,Default,,0000,0000,0000,,!كان شعره طويلاً ومجعّداً، ولديه شارب
Dialogue: 0,0:12:42.71,0:12:47.40,Default,,0000,0000,0000,,!لكن قد يكون تنكّراً، كما عدد المختطفين اثنين على الأقل
Dialogue: 0,0:12:47.40,0:12:49.86,Default,,0000,0000,0000,,ماذا؟ كيف تعرف ذلك؟
Dialogue: 0,0:12:50.21,0:12:54.20,Default,,0000,0000,0000,,بعدما دفع الرجل مينامي-سان\Nلمقعد السيّارة الخلفي
Dialogue: 0,0:12:54.20,0:12:56.16,Default,,0000,0000,0000,,!جلس في مقاعد الركّاب
Dialogue: 0,0:12:56.16,0:12:59.45,Default,,0000,0000,0000,,!أي كان هناك شخص آخر يقود
Dialogue: 0,0:12:59.45,0:13:03.36,Default,,0000,0000,0000,,فهمت، ثمّ تلقيتم اتّصالاً هنا
Dialogue: 0,0:13:03.36,0:13:08.32,Default,,0000,0000,0000,,نعم، قال أنّه اختطف عضوي تو-ميكس\Nوعلينا طلب الشرطة
Dialogue: 0,0:13:09.44,0:13:12.43,Default,,0000,0000,0000,,ما الذي يخطّط له بالضبط؟
Dialogue: 0,0:13:12.43,0:13:15.18,Default,,0000,0000,0000,,...في العادة يطلبون عدم إخبار الشرطة
Dialogue: 0,0:13:15.18,0:13:17.33,Default,,0000,0000,0000,,لعلّه واثق جدّاً بنفسه
Dialogue: 0,0:13:17.33,0:13:18.28,Default,,0000,0000,0000,,...أو
Dialogue: 0,0:13:18.68,0:13:22.73,Default,,0000,0000,0000,,!لم ينو إطلاق سراح الرهينتين من البداية
Dialogue: 0,0:13:23.64,0:13:24.69,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:13:26.78,0:13:28.42,Default,,0000,0000,0000,,حضرة المفتّش، إنّه هو
Dialogue: 0,0:13:29.09,0:13:30.91,Default,,0000,0000,0000,,تجهّز لتعقّبه
Dialogue: 0,0:13:31.83,0:13:33.86,Default,,0000,0000,0000,,حسناً، نعتمد عليك
Dialogue: 0,0:13:33.86,0:13:35.03,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:36.20,0:13:38.30,Default,,0000,0000,0000,,لا تقلق، ابقَ هادئاً
Dialogue: 0,0:13:39.66,0:13:43.60,Default,,0000,0000,0000,,اسمعني، تجنّب استفزاز المختطف قدر المستطاع
Dialogue: 0,0:13:43.94,0:13:46.23,Default,,0000,0000,0000,,ووافق على كلّ طلباته
Dialogue: 0,0:13:46.23,0:13:48.86,Default,,0000,0000,0000,,أيضاً أطل في الحديث معه قدرما يمكن
Dialogue: 0,0:13:48.86,0:13:50.36,Default,,0000,0000,0000,,حـ-حاضر
Dialogue: 0,0:13:52.18,0:13:52.87,Default,,0000,0000,0000,,أجب
Dialogue: 0,0:13:55.31,0:13:56.74,Default,,0000,0000,0000,,مـ-مرحباً؟
Dialogue: 0,0:13:57.35,0:13:58.36,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:13:58.72,0:13:59.99,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:14:00.47,0:14:03.44,Default,,0000,0000,0000,,حضرة المفتّش، يقول أن أعطي السمّاعة للشرطّي المسؤول
Dialogue: 0,0:14:04.96,0:14:06.34,Default,,0000,0000,0000,,حسنٌ، ناولها
Dialogue: 0,0:14:07.63,0:14:08.78,Default,,0000,0000,0000,,أدر مكبّر الصوت
Dialogue: 0,0:14:11.87,0:14:15.00,Default,,0000,0000,0000,,مرحباً؟ معك المفتّش ميغوري من مركز الشرطة
Dialogue: 0,0:14:15.00,0:14:16.65,Default,,0000,0000,0000,,!يا للمفاجأة
Dialogue: 0,0:14:17.04,0:14:21.81,Default,,0000,0000,0000,,لنا الشرف بأن يستلم المفتّش من قسم\Nالتحقيق الأوّل القضيّة
Dialogue: 0,0:14:22.78,0:14:24.32,Default,,0000,0000,0000,,!كيف حالهما؟
Dialogue: 0,0:14:24.32,0:14:28.39,Default,,0000,0000,0000,,لا تقلق، إنّهما في غفوةٍ الآن
Dialogue: 0,0:14:28.76,0:14:31.32,Default,,0000,0000,0000,,...ما طلباتكم؟ مال؟! أم
Dialogue: 0,0:14:31.32,0:14:32.64,Default,,0000,0000,0000,,مال؟
Dialogue: 0,0:14:33.77,0:14:35.94,Default,,0000,0000,0000,,لا أحمل أيّ اهتمام بذلك
Dialogue: 0,0:14:35.94,0:14:39.10,Default,,0000,0000,0000,,أنا من أولئك الذين تدعونهم بالمُلاحقين
Dialogue: 0,0:14:39.10,0:14:42.42,Default,,0000,0000,0000,,أريد كلّ شيءٍ يخصّهما
Dialogue: 0,0:14:42.42,0:14:47.19,Default,,0000,0000,0000,,نعم، مثل الحقيبة التي نسيتْها في المطعم
Dialogue: 0,0:14:47.19,0:14:49.53,Default,,0000,0000,0000,,!الـ-الحقيبة؟
Dialogue: 0,0:14:49.88,0:14:51.12,Default,,0000,0000,0000,,هذه؟
Dialogue: 0,0:14:51.52,0:14:54.57,Default,,0000,0000,0000,,...حسناً! سأجعل أحد أتباعي يأخذها و
Dialogue: 0,0:14:55.33,0:14:57.57,Default,,0000,0000,0000,,لا تستخفّ بي رجاءً
Dialogue: 0,0:14:58.16,0:15:00.74,Default,,0000,0000,0000,,الأطفال، دعهم يجلبونها
Dialogue: 0,0:15:00.74,0:15:02.57,Default,,0000,0000,0000,,...الـ-الأطفال
Dialogue: 0,0:15:02.57,0:15:06.71,Default,,0000,0000,0000,,أقصد أولئك الأربعة الذين\Nكانوا يأكلون مع مينامي-سان
Dialogue: 0,0:15:07.24,0:15:08.96,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:15:09.02,0:15:10.74,Default,,0000,0000,0000,,لا وقت للتردد
Dialogue: 0,0:15:10.74,0:15:13.27,Default,,0000,0000,0000,,لديّ رهينتان هنا
Dialogue: 0,0:15:14.05,0:15:18.15,Default,,0000,0000,0000,,لا أهتم إذا رحلت إحداهما للعالم الآخر\Nوبقيت الثانية معي
Dialogue: 0,0:15:19.39,0:15:22.31,Default,,0000,0000,0000,,هيّا، فلترسلوا الحقيبة
Dialogue: 0,0:15:22.75,0:15:24.80,Default,,0000,0000,0000,,!مع أولئك الأطفال الأربعة
Dialogue: 0,0:15:28.84,0:15:33.42,Default,,0000,0000,0000,,!كلا! لا يمكنني تعريض أطفال لخطر كهذا
Dialogue: 0,0:15:33.42,0:15:35.92,Default,,0000,0000,0000,,!آسف، لكن لا أستطيع قبول هذا الطلب
Dialogue: 0,0:15:35.92,0:15:37.78,Default,,0000,0000,0000,,حقّاً ذلك؟
Dialogue: 0,0:15:38.42,0:15:39.92,Default,,0000,0000,0000,,لا خيار لديّ إذاً
Dialogue: 0,0:15:39.92,0:15:46.80,Default,,0000,0000,0000,,،سأحوّل ثنائيّ تو-ميكس إلى فرد ون-ميكس \Nثمّ أتّصل بك مُجدداً
Dialogue: 0,0:15:47.00,0:15:47.78,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:15:47.78,0:15:48.70,Default,,0000,0000,0000,,!نحن موافقون
Dialogue: 0,0:15:49.78,0:15:51.66,Default,,0000,0000,0000,,!سنجلب الحقيبة
Dialogue: 0,0:15:51.66,0:15:53.19,Default,,0000,0000,0000,,!كونان محق
Dialogue: 0,0:15:53.19,0:15:57.06,Default,,0000,0000,0000,,!لا يمكننا البقاء ساكنين وترك تو-ميكس في قبضتهم
Dialogue: 0,0:15:57.06,0:15:58.49,Default,,0000,0000,0000,,!سأبذل قصارى جهدي
Dialogue: 0,0:15:58.69,0:16:00.23,Default,,0000,0000,0000,,...مهلاً، أنتم
Dialogue: 0,0:16:00.41,0:16:02.27,Default,,0000,0000,0000,,حسنٌ، حُسم الأمر
Dialogue: 0,0:16:02.27,0:16:03.34,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:16:03.54,0:16:07.93,Default,,0000,0000,0000,,سأتّصل بهاتف في محطّة كودانشيتا بعد 15 دقيقة
Dialogue: 0,0:16:08.10,0:16:09.00,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:16:09.00,0:16:12.08,Default,,0000,0000,0000,,!إذا تأخّر ولو واحد، سأبدأ الإطلاق
Dialogue: 0,0:16:13.96,0:16:15.17,Default,,0000,0000,0000,,هل تعقبّته؟
Dialogue: 0,0:16:15.17,0:16:17.54,Default,,0000,0000,0000,,،أعرف أنّه في اتّجاه هايدو
Dialogue: 0,0:16:17.54,0:16:22.53,Default,,0000,0000,0000,,لكن بما أنّه كان في عربة متحركة\Nفلم أستطع تحديد موقعه الدقيق
Dialogue: 0,0:16:22.53,0:16:28.24,Default,,0000,0000,0000,,هكذا إذاً، اتّصلوا بمركز القيادة واطلبوا\Nلائحة بكلّ المشتبه بهم الطليقين
Dialogue: 0,0:16:28.24,0:16:30.11,Default,,0000,0000,0000,,!من قضاياي الأخيرة
Dialogue: 0,0:16:30.48,0:16:32.56,Default,,0000,0000,0000,,...حاضر! لكن لمَ
Dialogue: 0,0:16:33.15,0:16:35.48,Default,,0000,0000,0000,,كان المختطف يعرف اسمي
Dialogue: 0,0:16:35.48,0:16:39.45,Default,,0000,0000,0000,,وغيّر صوته بأداة وحاول إخفاء أسلوب كلامه
Dialogue: 0,0:16:39.65,0:16:42.10,Default,,0000,0000,0000,,من المُرجّح أنّي حقّقت معه قبلاً
Dialogue: 0,0:16:42.10,0:16:43.03,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:16:43.03,0:16:44.02,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:16:44.14,0:16:45.15,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:16:46.93,0:16:51.12,Default,,0000,0000,0000,,أريدك أن تعدني بألّا تُقدم\Nعلى أيّ أمرٍ خطير
Dialogue: 0,0:16:51.12,0:16:52.13,Default,,0000,0000,0000,,أعدك
Dialogue: 0,0:16:52.13,0:16:54.50,Default,,0000,0000,0000,,اهرب فورما ترى خطراً
Dialogue: 0,0:16:54.50,0:16:55.32,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:16:55.62,0:16:57.78,Default,,0000,0000,0000,,أفهمتم أيضاً؟
Dialogue: 0,0:16:58.00,0:17:01.23,Default,,0000,0000,0000,,المعذرة، ماذا نفعل بخصوص الحفلة؟
Dialogue: 0,0:17:01.23,0:17:02.85,Default,,0000,0000,0000,,!ألغوها
Dialogue: 0,0:17:02.85,0:17:04.13,Default,,0000,0000,0000,,!لا حاجة لذلك
Dialogue: 0,0:17:05.05,0:17:09.41,Default,,0000,0000,0000,,!سننقذهما قبل بدء الحفلة حتماً، لذا انتظروا فحسب
Dialogue: 0,0:17:24.26,0:17:25.10,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:17:25.10,0:17:28.14,Default,,0000,0000,0000,,جيّد، الآن اصعدوا على قطار توي شينجوكو
Dialogue: 0,0:17:28.14,0:17:32.80,Default,,0000,0000,0000,,وأجيبوا على الهاتف في الرصيف 13\Nعلى خطّ يامانوتي في 15 دقيقة
Dialogue: 0,0:17:33.07,0:17:35.78,Default,,0000,0000,0000,,...أسقطتُ الحقيبة في قناة تصريف قبل قليل
Dialogue: 0,0:17:36.13,0:17:37.60,Default,,0000,0000,0000,,أسقطتها في قناة تصريف؟
Dialogue: 0,0:17:37.60,0:17:39.17,Default,,0000,0000,0000,,!هل الشريط بخير؟
Dialogue: 0,0:17:39.17,0:17:43.48,Default,,0000,0000,0000,,أحمق! أنسيت أنّ تحطّم الشريط في مصلحتنا؟
Dialogue: 0,0:17:43.72,0:17:45.29,Default,,0000,0000,0000,,...معك حقّ
Dialogue: 0,0:17:45.29,0:17:48.16,Default,,0000,0000,0000,,!كان هدفه الشريط الاستعراضيّ إذاً
Dialogue: 0,0:17:48.70,0:17:51.97,Default,,0000,0000,0000,,!بأيّ حال، أمامكم 15 دقيقة! لا تتأخّروا
Dialogue: 0,0:17:52.19,0:17:56.61,Default,,0000,0000,0000,,لكن لمَ جعلت الأطفال يجلبونها؟\Nسيرافقهم مراقبون من الشرطة
Dialogue: 0,0:17:57.78,0:18:01.07,Default,,0000,0000,0000,,أخبر الشرطة بألّا تأتي وستزحف إليك
Dialogue: 0,0:18:01.07,0:18:05.57,Default,,0000,0000,0000,,كما بوجود أربعة أطفال، ستفترض الشرطة أنّها\Nلن تفقد أثرهم أبداً فتخفف انتباهها
Dialogue: 0,0:18:05.57,0:18:08.53,Default,,0000,0000,0000,,سنستغلّ ذاك لصالحنا
Dialogue: 0,0:18:13.07,0:18:14.78,Default,,0000,0000,0000,,ما الذي تفعله؟
Dialogue: 0,0:18:15.09,0:18:17.49,Default,,0000,0000,0000,,أكتب كلمات الأغنية على الشريط الاستعراضيّ
Dialogue: 0,0:18:18.05,0:18:20.26,Default,,0000,0000,0000,,هدف المختطفين هو هذا الشريط
Dialogue: 0,0:18:20.26,0:18:23.02,Default,,0000,0000,0000,,...لا أسمع أيّ أصوات غريبة مهما أعدت تشغيله
Dialogue: 0,0:18:23.37,0:18:26.75,Default,,0000,0000,0000,,مما يعني، لا بدّ من وجود كلمة\Nمفتاحية في هذه الأسطر
Dialogue: 0,0:18:26.75,0:18:29.49,Default,,0000,0000,0000,,!تشكّل مشكلةً لهم
Dialogue: 0,0:18:30.12,0:18:32.94,Default,,0000,0000,0000,,حضرة المفتّش، تلقّينا بلاغاً
Dialogue: 0,0:18:33.40,0:18:37.53,Default,,0000,0000,0000,,يبدو أنّ سيّارة المختطفين قد تُركت\Nعند نهر تيموزو
Dialogue: 0,0:18:37.53,0:18:40.53,Default,,0000,0000,0000,,!تبّاً! بدّلوا سيّارتهم
Dialogue: 0,0:18:40.53,0:18:46.07,Default,,0000,0000,0000,,ما يعني أنّ خيطنا الوحيد هو\Nهؤلاء الأطفال الأربعة
Dialogue: 0,0:19:01.33,0:19:02.98,Default,,0000,0000,0000,,أنا مُنهك
Dialogue: 0,0:19:02.98,0:19:06.58,Default,,0000,0000,0000,,كلّ ما كنّا نفعله هو\Nالدوران في خطّ يامانوتي
Dialogue: 0,0:19:06.58,0:19:08.90,Default,,0000,0000,0000,,أتتوقّعان أنّهم يعبثون بنا؟
Dialogue: 0,0:19:08.90,0:19:12.13,Default,,0000,0000,0000,,كلا، إنّهم ينتظرون فرصتهم فقط
Dialogue: 0,0:19:13.07,0:19:15.86,Default,,0000,0000,0000,,!لحظة غيابنا عن أنظار الشرطة
Dialogue: 0,0:19:19.57,0:19:22.82,Default,,0000,0000,0000,,ماذا؟ أعطي الشريط لغيري؟\Nلا يمكنني تسليمه أنا؟
Dialogue: 0,0:19:22.82,0:19:25.48,Default,,0000,0000,0000,,نعم، سأتّصل مُجدداً بعد ثلاث دقائق
Dialogue: 0,0:19:25.81,0:19:29.42,Default,,0000,0000,0000,,سلّمه في دورة المياه واحرص\Nعلى ألّا تكتشف الشرطة
Dialogue: 0,0:19:30.36,0:19:32.05,Default,,0000,0000,0000,,!أخبرنا
Dialogue: 0,0:19:32.05,0:19:35.01,Default,,0000,0000,0000,,من أخبرك المختطف\N!بأن تعطيه الشريط؟
Dialogue: 0,0:19:35.01,0:19:36.32,Default,,0000,0000,0000,,!أخبرنا يا كونان-كن
Dialogue: 0,0:19:36.84,0:19:40.30,Default,,0000,0000,0000,,...عندما بثّ تو-ميكس هذا الشريط عبر الإذاعة
Dialogue: 0,0:19:40.30,0:19:42.12,Default,,0000,0000,0000,,أذكروا شيئاً آخر؟
Dialogue: 0,0:19:42.12,0:19:42.85,Default,,0000,0000,0000,,ليس تماماً
Dialogue: 0,0:19:42.85,0:19:47.28,Default,,0000,0000,0000,,قالوا أنّ الكلمات خطرت لهما\N...عندما مرّوا بمعبد فحسب
Dialogue: 0,0:19:47.28,0:19:49.29,Default,,0000,0000,0000,,أظنّه كان معبد شوينجي
Dialogue: 0,0:19:49.29,0:19:50.49,Default,,0000,0000,0000,,!شوينجي؟
Dialogue: 0,0:19:50.79,0:19:56.90,Default,,0000,0000,0000,,لحظة، ألم يكن قرب مسرح جريمة القتل\Nالتي وقعت ليلة رأس السنة؟
Dialogue: 0,0:19:57.28,0:20:01.19,Default,,0000,0000,0000,,هاجم شخصٌ مريب بمسدّس رجلاً
Dialogue: 0,0:20:01.19,0:20:04.35,Default,,0000,0000,0000,,لكنّه قُتل بعدما انطلقت رصاصة أثناء الاشتباك
Dialogue: 0,0:20:04.90,0:20:09.57,Default,,0000,0000,0000,,اعتبروا أنّ ما قام به الرجل دفاع عن النفس فحسب\Nوأطلقوا سراحه وفقما أتذكر
Dialogue: 0,0:20:10.65,0:20:14.61,Default,,0000,0000,0000,,!فهمت! عرفتُ لمَ يريدون هذا الشريط
Dialogue: 0,0:20:14.82,0:20:16.64,Default,,0000,0000,0000,,!الوقت اقترب
Dialogue: 0,0:20:16.64,0:20:17.78,Default,,0000,0000,0000,,...علينا الإسراع
Dialogue: 0,0:20:17.97,0:20:20.24,Default,,0000,0000,0000,,!انتظروا! خطرت لي فكرة ممتازة
Dialogue: 0,0:20:25.95,0:20:29.69,Default,,0000,0000,0000,,الهاتف يرنّ، أتى الأطفال للإجابة
Dialogue: 0,0:20:29.69,0:20:33.69,Default,,0000,0000,0000,,هذه هي الخطّة، سنتخلّص من مراقبة الشرطة حتماً
Dialogue: 0,0:20:33.69,0:20:36.64,Default,,0000,0000,0000,,!إيّاكم أن تخفقوا
Dialogue: 0,0:20:36.64,0:20:41.10,Default,,0000,0000,0000,,الأبواب على وشك الإغلاق، توخّوا الحذر رجاءً
Dialogue: 0,0:20:43.97,0:20:45.86,Default,,0000,0000,0000,,!أ-أيومي
Dialogue: 0,0:20:47.14,0:20:49.34,Default,,0000,0000,0000,,أأنتِ بخير يا ابنتي؟
Dialogue: 0,0:20:49.34,0:20:50.03,Default,,0000,0000,0000,,...نعم
Dialogue: 0,0:20:50.03,0:20:52.64,Default,,0000,0000,0000,,هل تمكّن أحدكم من الصعود؟
Dialogue: 0,0:20:52.96,0:20:55.47,Default,,0000,0000,0000,,...نحن الاثنان فحسب
Dialogue: 0,0:20:55.47,0:20:56.85,Default,,0000,0000,0000,,ماذا عن الخاطفين؟
Dialogue: 0,0:20:57.05,0:20:58.34,Default,,0000,0000,0000,,...لا، لم يظهر أحد بعد
Dialogue: 0,0:21:00.30,0:21:02.18,Default,,0000,0000,0000,,!الأطفال يرمون الحقيبة خارج النافذة
Dialogue: 0,0:21:02.66,0:21:03.60,Default,,0000,0000,0000,,!هكذا
Dialogue: 0,0:21:05.79,0:21:07.66,Default,,0000,0000,0000,,!كانت هذه الخطّة إذاً
Dialogue: 0,0:21:07.66,0:21:12.14,Default,,0000,0000,0000,,حسنٌ، احرسا الأطفال! سنتّجه نحن\N!لمكان سقوط الحقيبة
Dialogue: 0,0:21:12.44,0:21:13.51,Default,,0000,0000,0000,,!هيّا بنا
Dialogue: 0,0:21:14.86,0:21:17.56,Default,,0000,0000,0000,,ماذا؟ أين تلك الفتاة؟
Dialogue: 0,0:21:19.82,0:21:22.46,Default,,0000,0000,0000,,!مهلكم، انتهى عملكم
Dialogue: 0,0:21:22.97,0:21:24.43,Default,,0000,0000,0000,,!ليس عليكم الهرب
Dialogue: 0,0:21:24.72,0:21:26.10,Default,,0000,0000,0000,,...توقّف يا فتى
Dialogue: 0,0:21:27.64,0:21:29.10,Default,,0000,0000,0000,,صرخة فتاة؟
Dialogue: 0,0:21:35.96,0:21:38.03,Default,,0000,0000,0000,,هل اقترب أحد من الحقيبة؟
Dialogue: 0,0:21:38.03,0:21:39.84,Default,,0000,0000,0000,,كلا، ليس بعد
Dialogue: 0,0:21:52.07,0:21:53.11,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:21:53.11,0:21:55.90,Default,,0000,0000,0000,,أحسنتِ يا صغيرتي
Dialogue: 0,0:21:55.90,0:21:58.87,Default,,0000,0000,0000,,لا يوجد أيّ رجال شرطة في الجوار، صحيح؟
Dialogue: 0,0:22:00.19,0:22:02.39,Default,,0000,0000,0000,,كلا، لا يبدو أنّ هناك أحد
Dialogue: 0,0:22:02.39,0:22:03.35,Default,,0000,0000,0000,,حسنٌ، ممتاز
Dialogue: 0,0:22:04.10,0:22:06.66,Default,,0000,0000,0000,,مستعدّة للقدوم الآن كما أخبرتك؟
Dialogue: 0,0:22:06.66,0:22:07.64,Default,,0000,0000,0000,,...نعم
Dialogue: 0,0:22:09.04,0:22:10.81,Default,,0000,0000,0000,,!سأبذل جهدي
Dialogue: 0,0:22:11.25,0:22:14.43,Default,,0000,0000,0000,,!ماذا؟! بادل كونان-كن وأيومي-كن مكانهما؟
Dialogue: 0,0:22:15.17,0:22:17.39,Default,,0000,0000,0000,,...يا للهول
Dialogue: 0,0:24:02.64,0:24:05.56,Default,,0000,0000,0000,,أنظّارات التعقّب التي تقصدها هي هذه؟
Dialogue: 0,0:24:05.56,0:24:06.86,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:24:06.86,0:24:08.02,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:24:08.44,0:24:09.52,Default,,0000,0000,0000,,لمَ أنتم هنا؟
Dialogue: 0,0:24:11.22,0:24:14.51,Default,,0000,0000,0000,,!حمقى! لمَ لم تعطوا النظّارات للشرطة؟
Dialogue: 0,0:24:14.51,0:24:15.68,Default,,0000,0000,0000,,...أردنا
Dialogue: 0,0:24:15.68,0:24:18.73,Default,,0000,0000,0000,,...سيكون لديكم وقت كثير للشجار
Dialogue: 0,0:24:18.88,0:24:20.40,Default,,0000,0000,0000,,!في العالم الآخر
Dialogue: 0,0:24:24.18,0:24:30.18,On Top,,0000,0000,0000,,قضيّة اختطاف الفنّانين الشهيرين\Nالجزء الثاني
Dialogue: 0,0:24:25.32,0:24:26.70,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.70,0:24:30.27,Default,,0000,0000,0000,,قضيّة اختطاف الفنّانين الشهيرين\Nالجزء الثاني
Dialogue: 0,0:24:45.83,0:24:48.17,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.17,0:24:50.17,Default,,0000,0000,0000,,جرس معبد
Dialogue: 0,0:24:50.44,0:24:52.16,Default,,0000,0000,0000,,الحلقة القادمة ستكون الظهور \N!المسرحيّ الأوّل لكونان
Dialogue: 0,0:24:52.16,0:24:54.37,Default,,0000,0000,0000,,!سنكون معك
Dialogue: 0,0:24:54.37,0:24:56.37,Default,,0000,0000,0000,,مهلكم

