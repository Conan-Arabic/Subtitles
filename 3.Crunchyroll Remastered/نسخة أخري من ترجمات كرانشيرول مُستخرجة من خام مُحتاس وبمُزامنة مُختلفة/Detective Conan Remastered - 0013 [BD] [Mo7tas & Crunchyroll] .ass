Dialogue: 0,0:00:00.64,0:00:02.29,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.29,0:00:05.17,Default,,0000,0000,0000,,أُجبر طالب الثانوية شينتشي على تجرّع\Nعقار قلّص جسده
Dialogue: 0,0:00:05.17,0:00:07.92,Default,,0000,0000,0000,,إذا عرفت المنظمة أنّ شينتشي وكونان\Nهما نفس الشخص
Dialogue: 0,0:00:07.92,0:00:09.83,Default,,0000,0000,0000,,!فسيقع جميع من حولي في خطر
Dialogue: 0,0:00:09.83,0:00:12.13,Default,,0000,0000,0000,,!البروفسور آغاسا وحده من يعرف الحقيقة
Dialogue: 0,0:00:12.13,0:00:15.34,Default,,0000,0000,0000,,أُخفي هويتي، والحقيقة واحدة دوماً\N!اليوم كذلك
Dialogue: 0,0:01:45.98,0:01:51.96,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل تقصّي رجل الغريبة
Dialogue: 0,0:01:47.12,0:01:49.66,Default,,0000,0000,0000,,جريمة قتل تقصّي رجل الغريبة
Dialogue: 0,0:01:52.11,0:01:55.61,Default,,0000,0000,0000,,...سطو، اختطاف، قتل
Dialogue: 0,0:01:55.99,0:01:58.44,Default,,0000,0000,0000,,لا نهاية لهذه الجرائم
Dialogue: 0,0:01:58.44,0:02:01.52,Default,,0000,0000,0000,,لذا مهاراتك في التحرّي ذات فائدة
Dialogue: 0,0:02:02.02,0:02:04.56,Default,,0000,0000,0000,,لكنّ العم كوغورو ينال كل الفضل
Dialogue: 0,0:02:04.56,0:02:09.47,Default,,0000,0000,0000,,انتهيت! إنّها نظارات ملاحقة المجرمين\Nالخاصة التي اخترعتُها
Dialogue: 0,0:02:09.47,0:02:11.26,Default,,0000,0000,0000,,كيف أستعملها؟
Dialogue: 0,0:02:11.26,0:02:12.97,Default,,0000,0000,0000,,اضغط الزرّ على الجانب
Dialogue: 0,0:02:15.80,0:02:17.14,Default,,0000,0000,0000,,!مُذهل
Dialogue: 0,0:02:17.14,0:02:23.11,Default,,0000,0000,0000,,ستعرض موقع جهاز الإرسال هذا داخل\Nنصف قطر 20 كيلومتراً
Dialogue: 0,0:02:23.11,0:02:26.09,Default,,0000,0000,0000,,يمكنك إبقاؤه هنا معظم الوقت
Dialogue: 0,0:02:26.09,0:02:27.52,Default,,0000,0000,0000,,إنّه كاللاصق
Dialogue: 0,0:02:27.74,0:02:29.99,Default,,0000,0000,0000,,!شكراً يا بروفسور آغاسا
Dialogue: 0,0:02:30.73,0:02:33.69,Default,,0000,0000,0000,,اسمي هيروتا ماسامي
Dialogue: 0,0:02:33.69,0:02:36.94,Default,,0000,0000,0000,,!أرجوك! اعثر على أبي
Dialogue: 0,0:02:36.94,0:02:37.69,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:02:37.98,0:02:43.52,Default,,0000,0000,0000,,ترك أبي الذي يعمل بعيداً عن منزله\Nفي طوكيو وظيفته كسائق سيّارة أجرة
Dialogue: 0,0:02:43.52,0:02:46.61,Default,,0000,0000,0000,,وفقدنا أثره لشهر كامل الآن
Dialogue: 0,0:02:46.61,0:02:49.08,Default,,0000,0000,0000,,لذا أتيتِني؟
Dialogue: 0,0:02:49.08,0:02:50.35,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:50.35,0:02:54.06,Default,,0000,0000,0000,,استأذنت بالغياب عن المدرسة في ياماغاتا\Nللبحث عنه هنا
Dialogue: 0,0:02:54.06,0:02:57.69,Default,,0000,0000,0000,,أنتَ الوحيد الذي يمكنني طلب \N!المساعدة منه سيّدي المتحري
Dialogue: 0,0:02:57.69,0:02:59.98,Default,,0000,0000,0000,,فهمت، سأقبل بقضيتك
Dialogue: 0,0:03:00.21,0:03:02.44,Default,,0000,0000,0000,,هذا هو أبي، هيروتا كينزو
Dialogue: 0,0:03:02.71,0:03:06.00,Default,,0000,0000,0000,,طوله 170 سنتيمتراً وعمره 48 عاماً
Dialogue: 0,0:03:07.37,0:03:08.56,Default,,0000,0000,0000,,ماذا عن هذه القطّة؟
Dialogue: 0,0:03:08.56,0:03:12.41,Default,,0000,0000,0000,,قطّة اشتراها أبي، اسمها كاي
Dialogue: 0,0:03:12.41,0:03:16.03,Default,,0000,0000,0000,,يملك بالإضافة لها ثلاث قطط، تي وغو وأو
Dialogue: 0,0:03:16.54,0:03:19.78,Default,,0000,0000,0000,,البحث عن الناس ليس تخصصي
Dialogue: 0,0:03:19.78,0:03:23.68,Default,,0000,0000,0000,,لكن لو كان يضع إحدى هذه، لتمكنت\Nمن إيجاده بلمح البصر
Dialogue: 0,0:03:26.03,0:03:29.44,Default,,0000,0000,0000,,حسنٌ، سألصقها على ران واختبرها
Dialogue: 0,0:03:30.14,0:03:31.06,Default,,0000,0000,0000,,تفضّلي
Dialogue: 0,0:03:33.64,0:03:36.72,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:03:36.72,0:03:37.31,Default,,0000,0000,0000,,...لا شيء
Dialogue: 0,0:03:38.46,0:03:39.77,Default,,0000,0000,0000,,!جهاز الإرسال
Dialogue: 0,0:03:39.77,0:03:41.88,Default,,0000,0000,0000,,!تبّاً! التصق هناك
Dialogue: 0,0:03:44.17,0:03:50.37,Default,,0000,0000,0000,,تُوفيت أمي في صغري، وأبي هو عائلتي الوحيدة
Dialogue: 0,0:03:50.37,0:03:53.11,Default,,0000,0000,0000,,...إذا أصابه مكروه
Dialogue: 0,0:04:01.69,0:04:04.78,Default,,0000,0000,0000,,...كلا، ليس بعد
Dialogue: 0,0:04:04.78,0:04:07.31,Default,,0000,0000,0000,,لم أجد أيّ دلائل
Dialogue: 0,0:04:07.31,0:04:08.52,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:04:09.35,0:04:11.56,Default,,0000,0000,0000,,ماسامي-سان مُجدداً؟
Dialogue: 0,0:04:11.56,0:04:12.98,Default,,0000,0000,0000,,هذه المرّة الثالثة اليوم
Dialogue: 0,0:04:13.56,0:04:16.10,Default,,0000,0000,0000,,يبدو أنّه لم يكن كثير الاختلاط بالناس
Dialogue: 0,0:04:16.10,0:04:19.86,Default,,0000,0000,0000,,وكان قلّما يتحدّث عن نفسه وفقاً لزملائه في العمل
Dialogue: 0,0:04:19.86,0:04:25.15,Default,,0000,0000,0000,,يتقدّم غوكاي تيو المجموعة ليربح\N!"فوزه الخامس المتتالي في "جي-1
Dialogue: 0,0:04:25.15,0:04:28.10,Default,,0000,0000,0000,,(غوكاي تيو؟ (الإمبراطور البطوليّ
Dialogue: 0,0:04:28.46,0:04:31.96,Default,,0000,0000,0000,,قطّة اشتراها أبي، اسمها كاي
Dialogue: 0,0:04:31.96,0:04:36.40,Default,,0000,0000,0000,,يملك بالإضافة لها ثلاث قطط، تي وغو وأو
Dialogue: 0,0:04:38.20,0:04:40.15,Default,,0000,0000,0000,,!كاي وتي وغو وأو
Dialogue: 0,0:04:40.15,0:04:41.82,Default,,0000,0000,0000,,...إن رتّبناها
Dialogue: 0,0:04:43.03,0:04:43.99,Default,,0000,0000,0000,,...هذه
Dialogue: 0,0:04:43.99,0:04:44.86,On Top,,0000,0000,0000,,غوكاي تيو
Dialogue: 0,0:04:46.03,0:04:47.98,Default,,0000,0000,0000,,لا شيء يستحق الذكر
Dialogue: 0,0:04:48.31,0:04:50.94,Default,,0000,0000,0000,,!غوكاي تيو لا يُقهر بحق
Dialogue: 0,0:04:51.56,0:04:53.69,Default,,0000,0000,0000,,!أجل، هذه هي بالتأكيد
Dialogue: 0,0:04:53.69,0:04:55.64,Default,,0000,0000,0000,,يُحب هيروتا-سان سباقات الخيول
Dialogue: 0,0:04:55.64,0:04:58.55,Default,,0000,0000,0000,,!لذا سمّى قططه بناءً على حصان شهير
Dialogue: 0,0:04:58.55,0:04:59.97,Default,,0000,0000,0000,,!انظر يا أبي
Dialogue: 0,0:04:59.97,0:05:00.77,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:05:01.34,0:05:03.72,Default,,0000,0000,0000,,!يمكنك إيجاده في مضمار السباق بالتأكيد
Dialogue: 0,0:05:03.72,0:05:04.74,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:05:11.57,0:05:14.58,Default,,0000,0000,0000,,!مُذهل! أول مرة آتي لمضمار سباق
Dialogue: 0,0:05:14.58,0:05:16.89,Default,,0000,0000,0000,,لنسرع ونجد والد ماسامي-سان
Dialogue: 0,0:05:16.89,0:05:20.23,Default,,0000,0000,0000,,حمقاء، كأن الأمر سيكون بتلك السهولة
Dialogue: 0,0:05:20.23,0:05:22.07,Default,,0000,0000,0000,,لا تستخفي بالتحرّي
Dialogue: 0,0:05:24.36,0:05:26.65,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:05:26.94,0:05:29.61,Default,,0000,0000,0000,,!رأيتما؟ أنا مُتحرية عظيمة
Dialogue: 0,0:05:29.66,0:05:31.06,Default,,0000,0000,0000,,!مُحال
Dialogue: 0,0:05:29.66,0:05:31.06,Default,,0000,0000,0000,,!مُحال
Dialogue: 0,0:05:31.73,0:05:33.06,Default,,0000,0000,0000,,!سأجلبه
Dialogue: 0,0:05:33.06,0:05:35.02,Default,,0000,0000,0000,,انظري! اختفى عمداً
Dialogue: 0,0:05:35.02,0:05:37.14,Default,,0000,0000,0000,,لا نريد إخافته ثم فقدان أثره
Dialogue: 0,0:05:37.14,0:05:38.73,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:05:38.73,0:05:41.65,Default,,0000,0000,0000,,سنتبعه لمنزله
Dialogue: 0,0:05:48.44,0:05:52.07,Default,,0000,0000,0000,,!كنتُ أبحث عنك لوقت طويل
Dialogue: 0,0:05:52.31,0:05:55.88,Default,,0000,0000,0000,,!أبي! أبي
Dialogue: 0,0:05:56.68,0:05:58.41,Default,,0000,0000,0000,,هذا حسن
Dialogue: 0,0:05:58.41,0:06:02.52,Default,,0000,0000,0000,,أليس هناك أمرٌ مختلف فيها؟
Dialogue: 0,0:06:02.52,0:06:04.44,Default,,0000,0000,0000,,ترتدي ثياباً ناضجة أكثر
Dialogue: 0,0:06:04.87,0:06:06.81,Default,,0000,0000,0000,,كما تضع مساحيق تجميل
Dialogue: 0,0:06:06.81,0:06:08.73,Default,,0000,0000,0000,,لم ترَ والدها لوقت طويل
Dialogue: 0,0:06:08.73,0:06:10.42,Default,,0000,0000,0000,,بالطبع ستتزين
Dialogue: 0,0:06:17.22,0:06:20.73,Default,,0000,0000,0000,,!كانت قضيّة يسيرة بين يدي موري كوغورو
Dialogue: 0,0:06:25.72,0:06:27.37,Default,,0000,0000,0000,,من ذاك؟
Dialogue: 0,0:06:45.53,0:06:46.28,Default,,0000,0000,0000,,!ميت؟
Dialogue: 0,0:06:46.28,0:06:49.86,Default,,0000,0000,0000,,وجدناه بعدما شنق نفسه البارحة
Dialogue: 0,0:06:49.86,0:06:51.69,Default,,0000,0000,0000,,يا للإزعاج
Dialogue: 0,0:06:51.69,0:06:54.21,Default,,0000,0000,0000,,!ماذا عن ابنته؟
Dialogue: 0,0:06:54.21,0:06:54.98,Default,,0000,0000,0000,,ابنته؟
Dialogue: 0,0:06:54.98,0:06:58.14,Default,,0000,0000,0000,,ابنة هيروتا-سان التي أتت للبحث عنه
Dialogue: 0,0:06:58.43,0:07:01.62,Default,,0000,0000,0000,,ماذا؟ كان هناك أمر ما يجري بالفعل؟
Dialogue: 0,0:07:02.35,0:07:04.43,Default,,0000,0000,0000,,كان هناك ما يثير الريبة به
Dialogue: 0,0:07:04.43,0:07:06.67,Default,,0000,0000,0000,,قال أنّه سيدفع إيجار عام كامل دفعة واحدة
Dialogue: 0,0:07:06.67,0:07:08.94,Default,,0000,0000,0000,,.إذا جعلته يقطن الشقّة بلا طرح أسئلة
Dialogue: 0,0:07:09.55,0:07:11.90,Default,,0000,0000,0000,,كما كانت العملات جديدةً لامعة
Dialogue: 0,0:07:12.25,0:07:15.96,Default,,0000,0000,0000,,إن أتت ابنته فلعلها ماتت أيضاً
Dialogue: 0,0:07:15.96,0:07:19.41,Default,,0000,0000,0000,,ما قصدك؟ ظننت هيروتا-سان قد انتحر
Dialogue: 0,0:07:19.41,0:07:22.44,Default,,0000,0000,0000,,قالت الشرطة أنّها جريمة قتل
Dialogue: 0,0:07:24.95,0:07:27.81,Default,,0000,0000,0000,,أجل، كانت جريمة قتل
Dialogue: 0,0:07:28.19,0:07:33.03,Default,,0000,0000,0000,,عُلِّق من السقف بعدما تمّ قتله
Dialogue: 0,0:07:33.03,0:07:36.19,Default,,0000,0000,0000,,،بناءً على علامات اليدين الكبيرة على عنق الضحية
Dialogue: 0,0:07:36.19,0:07:38.27,Default,,0000,0000,0000,,فالمجرم كان رجلاً ضخم البنية غالباً
Dialogue: 0,0:07:38.56,0:07:40.27,Default,,0000,0000,0000,,!ماذا عن ابنته؟
Dialogue: 0,0:07:41.89,0:07:43.98,Default,,0000,0000,0000,,كانت هذه على الأرض قرب مسرح الجريمة
Dialogue: 0,0:07:44.52,0:07:47.94,Default,,0000,0000,0000,,إنّها نظارات ماسامي-سان
Dialogue: 0,0:07:47.94,0:07:52.90,Default,,0000,0000,0000,,...لم نجد جثّتها بعد، لكنها غالباً
Dialogue: 0,0:07:52.90,0:07:55.71,Default,,0000,0000,0000,,هيّا، لا تكوني محبطةً هكذا
Dialogue: 0,0:07:55.71,0:07:58.85,Default,,0000,0000,0000,,لكن ربما قُتلت ماسامي-سان
Dialogue: 0,0:07:59.12,0:08:04.07,Default,,0000,0000,0000,,!بعدما وجدت أبيها أخيراً... يا للفظاعة
Dialogue: 0,0:08:04.37,0:08:06.65,Default,,0000,0000,0000,,لا-لا نزال نجهل إن قُتلت حقاً
Dialogue: 0,0:08:06.65,0:08:07.85,Default,,0000,0000,0000,,!لا يمكننا الاستسلام
Dialogue: 0,0:08:08.15,0:08:12.11,Default,,0000,0000,0000,,...لكن ما العمل؟ لو كان لدينا خيط ما
Dialogue: 0,0:08:12.11,0:08:14.82,Default,,0000,0000,0000,,!أجل! جهاز الإرسال الذي علق بها
Dialogue: 0,0:08:16.32,0:08:17.41,Default,,0000,0000,0000,,!هذه هي
Dialogue: 0,0:08:20.73,0:08:22.64,Default,,0000,0000,0000,,!أنت! أين تذهب يا فتى؟
Dialogue: 0,0:08:26.07,0:08:29.56,Default,,0000,0000,0000,,تحرّكه يعني أنّ ماسامي-سان قد لا تزال حيّة
Dialogue: 0,0:08:30.01,0:08:32.11,Default,,0000,0000,0000,,!بسرعة! لأصل في الوقت
Dialogue: 0,0:08:36.09,0:08:40.37,Default,,0000,0000,0000,,صالة باتشينكو؟! ماذا تفعل ماسامي-سان هنا؟
Dialogue: 0,0:08:40.37,0:08:42.52,Default,,0000,0000,0000,,!كلّا! البطارية تنفد
Dialogue: 0,0:08:42.52,0:08:44.04,Default,,0000,0000,0000,,!لأجدها بسرعة
Dialogue: 0,0:08:50.15,0:08:52.58,Default,,0000,0000,0000,,!ليس مسموحاً بالصبية هنا
Dialogue: 0,0:08:56.03,0:08:56.89,Default,,0000,0000,0000,,!اغرب
Dialogue: 0,0:09:00.60,0:09:01.86,Default,,0000,0000,0000,,نفدت البطارية
Dialogue: 0,0:09:02.44,0:09:06.47,Default,,0000,0000,0000,,!أنت! لمَ تأخرت هكذا؟
Dialogue: 0,0:09:06.47,0:09:08.69,Default,,0000,0000,0000,,...فـ-فقط
Dialogue: 0,0:09:09.13,0:09:10.65,Default,,0000,0000,0000,,ما خطب ران-نيتشان؟
Dialogue: 0,0:09:11.09,0:09:12.97,Default,,0000,0000,0000,,كانت هكذا لفترة
Dialogue: 0,0:09:12.97,0:09:16.05,Default,,0000,0000,0000,,القلق يلازمها حيال ماسامي-سان
Dialogue: 0,0:09:16.05,0:09:18.10,Default,,0000,0000,0000,,هناك أمرٌ غريب في ذاك الشخص
Dialogue: 0,0:09:18.71,0:09:20.56,Default,,0000,0000,0000,,ينظر نحونا منذ فترة
Dialogue: 0,0:09:23.21,0:09:27.31,Default,,0000,0000,0000,,إنّه الرجل الذي كان يتسكع\N!قرب شقّة هيروتا-سان
Dialogue: 0,0:09:27.31,0:09:30.49,Default,,0000,0000,0000,,صحيح، كان القاتل رجلاً ضخم البنية
Dialogue: 0,0:09:30.49,0:09:32.77,Default,,0000,0000,0000,,هو من قتل والد ماسامي-سان؟
Dialogue: 0,0:09:32.77,0:09:37.02,Default,,0000,0000,0000,,حسنٌ، انتظري يا ران! سأذهب للقبض عليه\N...وأعرف أين ماسامي-سان
Dialogue: 0,0:09:42.15,0:09:45.49,Default,,0000,0000,0000,,!أين ماسامي-سان؟ ماذا حلّ بها؟
Dialogue: 0,0:09:47.18,0:09:48.23,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:09:55.30,0:09:56.49,Default,,0000,0000,0000,,!أمسكته
Dialogue: 0,0:09:56.49,0:09:57.69,Default,,0000,0000,0000,,!أحسنتِ
Dialogue: 0,0:09:58.17,0:10:01.13,Default,,0000,0000,0000,,!يا لجرأة المجرم ليأتي بنفسه لنا
Dialogue: 0,0:10:01.13,0:10:03.21,Default,,0000,0000,0000,,!المجرم؟! أخطأت الفهم
Dialogue: 0,0:10:03.21,0:10:05.67,Default,,0000,0000,0000,,!اخرس! من أنت إذاً؟
Dialogue: 0,0:10:05.67,0:10:07.69,Default,,0000,0000,0000,,!أنا مثلك
Dialogue: 0,0:10:07.69,0:10:08.57,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:08.57,0:10:10.61,Default,,0000,0000,0000,,!أنا مُتحرٍّ أيضاً
Dialogue: 0,0:10:13.37,0:10:17.11,Default,,0000,0000,0000,,تلقيتُ طلب البحث عن هيروتا-سان بدوري
Dialogue: 0,0:10:17.11,0:10:18.31,Default,,0000,0000,0000,,من قِبل هذا الرجل
Dialogue: 0,0:10:19.65,0:10:21.65,Default,,0000,0000,0000,,...هـ-هذا الرجل
Dialogue: 0,0:10:22.11,0:10:24.15,Default,,0000,0000,0000,,!أنا مُتحرٍّ صدقاً
Dialogue: 0,0:10:24.15,0:10:26.68,Default,,0000,0000,0000,,!لمَ هربت إذاً؟
Dialogue: 0,0:10:26.68,0:10:29.72,Default,,0000,0000,0000,,...ركضت الفتاة نحوي، لذا هربت غريزياً
Dialogue: 0,0:10:29.72,0:10:32.39,Default,,0000,0000,0000,,لطالما كنتُ سريع الخوف
Dialogue: 0,0:10:32.39,0:10:35.11,Default,,0000,0000,0000,,أرتدي هذه النظارات كيلا يسخر الآخرون مني
Dialogue: 0,0:10:35.11,0:10:37.06,Default,,0000,0000,0000,,!يكفي أعذاراْ سخيفة
Dialogue: 0,0:10:42.42,0:10:46.39,Default,,0000,0000,0000,,!تصرّفا بجدية! حياة ماسامي-سان على المحك
Dialogue: 0,0:10:47.20,0:10:48.70,Default,,0000,0000,0000,,أعرف
Dialogue: 0,0:10:48.70,0:10:53.23,Default,,0000,0000,0000,,إذاً، تلقيت طلب عمل بالبحث \Nعن هيروتا كينزو-سان أيضاً؟
Dialogue: 0,0:10:53.70,0:10:59.82,Default,,0000,0000,0000,,أجل، لكن كان هناك أمرٌ غريب في عائلته
Dialogue: 0,0:10:59.82,0:11:03.32,Default,,0000,0000,0000,,هذا الرجل هو من وظّفني
Dialogue: 0,0:11:03.32,0:11:06.89,Default,,0000,0000,0000,,طلب مني البحث عن شقيقه الذي غادر كيوشو نحو طوكيو
Dialogue: 0,0:11:06.89,0:11:09.10,Default,,0000,0000,0000,,قال أنّه قريبه الوحيد
Dialogue: 0,0:11:09.85,0:11:12.39,Default,,0000,0000,0000,,قريبه الوحيد؟
Dialogue: 0,0:11:12.39,0:11:15.43,Default,,0000,0000,0000,,يُفترض أنّ ماسامي-سان هي قريبة هيروتا-سان الوحيدة
Dialogue: 0,0:11:15.43,0:11:20.06,Default,,0000,0000,0000,,!هذا غريب أيضاً! أتى والد ماسامي-سان هنا من ياماغاتا
Dialogue: 0,0:11:20.63,0:11:22.17,Default,,0000,0000,0000,,غريب بالفعل
Dialogue: 0,0:11:22.17,0:11:24.17,Default,,0000,0000,0000,,لا يمكن أن يكون هناك اثنين من هيروتا-سان
Dialogue: 0,0:11:24.17,0:11:26.95,Default,,0000,0000,0000,,هناك أمرٌ إضافيّ غريب
Dialogue: 0,0:11:26.95,0:11:30.02,Default,,0000,0000,0000,,سمعتُ من شركة سيارات الأجرة التي \Nكان يعمل فيها هيروتا-سان
Dialogue: 0,0:11:30.02,0:11:33.37,Default,,0000,0000,0000,,،أّنه يسلك نفس الطريق كلّ مساء
Dialogue: 0,0:11:33.37,0:11:36.44,Default,,0000,0000,0000,,دون الاهتمام بنقل ركّاب
Dialogue: 0,0:11:36.44,0:11:38.44,Default,,0000,0000,0000,,!كما يفعل ذلك بسرعة عالية
Dialogue: 0,0:11:38.44,0:11:41.23,Default,,0000,0000,0000,,كان ينفّس عن ضغوطه فقط
Dialogue: 0,0:11:41.23,0:11:43.90,Default,,0000,0000,0000,,أمرٌ شائع لدى الرجال الذين في مُنتصف العمر
Dialogue: 0,0:11:43.90,0:11:46.89,Default,,0000,0000,0000,,من عميلك هذا إذاً؟
Dialogue: 0,0:11:47.39,0:11:52.36,Default,,0000,0000,0000,,هيروتا أكيرا، 28 عاماً. إنّه رجل ضخم البنية\Nيفوق طوله 190 سنتيمتراً
Dialogue: 0,0:11:52.64,0:11:54.15,Default,,0000,0000,0000,,!ضخم البنية؟
Dialogue: 0,0:11:54.15,0:11:55.81,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:11:55.81,0:11:58.88,Default,,0000,0000,0000,,...أيمكن أنّه الرجل ضخم البنية الذي قصده المفتش
Dialogue: 0,0:11:58.88,0:12:02.30,Default,,0000,0000,0000,,!إذاً، هل أخبرت هذا الرجل شيئاً عن هيروتا-سان؟
Dialogue: 0,0:12:02.30,0:12:04.13,Default,,0000,0000,0000,,أجل، بالطبع
Dialogue: 0,0:12:04.13,0:12:08.04,Default,,0000,0000,0000,,ثمّ بعد ذلك قُتل هيروتا-سان
Dialogue: 0,0:12:08.04,0:12:10.02,Default,,0000,0000,0000,,لذا تساءلت إن ما كانت هناك صلة
Dialogue: 0,0:12:10.02,0:12:13.37,Default,,0000,0000,0000,,!أجل! قتل هذا الرجل هيروتا-سان
Dialogue: 0,0:12:13.37,0:12:15.99,Default,,0000,0000,0000,,!ثمّ أخذ ماسامي-سان معه
Dialogue: 0,0:12:16.65,0:12:19.28,Default,,0000,0000,0000,,!أخبرني! كيف أتصل به؟
Dialogue: 0,0:12:19.28,0:12:21.07,Default,,0000,0000,0000,,!هو من يتواصل معي
Dialogue: 0,0:12:21.07,0:12:22.95,Default,,0000,0000,0000,,لا خيوط لديك إذاً؟
Dialogue: 0,0:12:22.95,0:12:23.90,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:12:24.40,0:12:25.57,Default,,0000,0000,0000,,إنّه هو
Dialogue: 0,0:12:26.68,0:12:31.06,Default,,0000,0000,0000,,لا شكّ، إنّه الرجل الذي ارتطمت به في صالة الباتشينكو
Dialogue: 0,0:12:31.56,0:12:37.02,Default,,0000,0000,0000,,لكن لمَ أخذني جهاز الإرسال على ساعة\Nماسامي-سان إلى هناك؟
Dialogue: 0,0:12:37.76,0:12:42.98,Default,,0000,0000,0000,,...إن كان هو القاتل حقاً، ويرتدي ساعة ماسامي-سان
Dialogue: 0,0:12:42.98,0:12:44.28,Default,,0000,0000,0000,,...فهي قد
Dialogue: 0,0:12:45.42,0:12:46.69,Default,,0000,0000,0000,,قُتلت بالفعل
Dialogue: 0,0:12:52.04,0:12:54.48,Default,,0000,0000,0000,,!أسرع وأعد شحنها يا بروفسور
Dialogue: 0,0:12:54.87,0:12:58.49,Default,,0000,0000,0000,,لا تعجلني، التسرع لن يعطيك ثماراً
Dialogue: 0,0:12:58.49,0:12:59.94,Default,,0000,0000,0000,,...لكن إن لم نسرع
Dialogue: 0,0:13:00.53,0:13:02.53,Default,,0000,0000,0000,,أخبرني، أتذكر جريمة السطو
Dialogue: 0,0:13:02.53,0:13:05.40,Default,,0000,0000,0000,,التي سُرق فيها مليار ينّ ذاك اليوم؟
Dialogue: 0,0:13:05.40,0:13:06.85,Default,,0000,0000,0000,,التي نفذها ثلاثة لصوص؟
Dialogue: 0,0:13:07.23,0:13:12.10,Default,,0000,0000,0000,,قُتل حارس أمن حاول إيقافهم بتهوّر
Dialogue: 0,0:13:12.10,0:13:14.07,Default,,0000,0000,0000,,ذلك ما ناله جرّاء الاستهانة بهم
Dialogue: 0,0:13:14.39,0:13:17.18,Default,,0000,0000,0000,,هادئ ومتّزن ومربوط الجأش
Dialogue: 0,0:13:17.18,0:13:19.52,Default,,0000,0000,0000,,أليس ذلك أسلوب هولمز الذي تحبّه؟
Dialogue: 0,0:13:20.43,0:13:22.06,Default,,0000,0000,0000,,فـ-فهمت
Dialogue: 0,0:13:32.07,0:13:34.71,Default,,0000,0000,0000,,أهو في هذا الفندق حقاً؟
Dialogue: 0,0:13:34.71,0:13:38.02,Default,,0000,0000,0000,,!بلا شكّ! رأيته في طريق عودتي من المدرسة
Dialogue: 0,0:13:38.02,0:13:41.70,Default,,0000,0000,0000,,غريب، لم يتحرك جهاز الإرسال لفترة
Dialogue: 0,0:13:41.70,0:13:43.94,Default,,0000,0000,0000,,أيمكن أنّه خلع ساعته وهرب؟
Dialogue: 0,0:13:46.69,0:13:49.81,Default,,0000,0000,0000,,أجل، إنّه يقيم في غرفة 802
Dialogue: 0,0:13:54.82,0:13:56.77,Default,,0000,0000,0000,,!بسرعة، تعال
Dialogue: 0,0:13:57.09,0:13:59.52,Default,,0000,0000,0000,,من كان ليتصور أنّه هنا حقاً؟
Dialogue: 0,0:14:06.09,0:14:08.21,Default,,0000,0000,0000,,ونحن في عجلة
Dialogue: 0,0:14:08.21,0:14:09.46,Default,,0000,0000,0000,,شكراً لكم
Dialogue: 0,0:14:16.20,0:14:19.40,Default,,0000,0000,0000,,!افتح! نعرف أنّك هنا
Dialogue: 0,0:14:19.87,0:14:20.96,Default,,0000,0000,0000,,!إنّه مفتوح
Dialogue: 0,0:14:27.06,0:14:29.11,Default,,0000,0000,0000,,!إ-إنّه ميت
Dialogue: 0,0:14:38.01,0:14:40.55,Default,,0000,0000,0000,,هذه الرائحة الحلوة... سيانيد البوتاسيوم
Dialogue: 0,0:14:40.55,0:14:43.44,Default,,0000,0000,0000,,فهمت، لم يستطع العيش مع تأنيب \Nجريمته فأقدم على الانتحار
Dialogue: 0,0:14:43.97,0:14:45.90,Default,,0000,0000,0000,,علينا الاتصال بالشرطة
Dialogue: 0,0:14:48.35,0:14:50.42,Default,,0000,0000,0000,,إنّها ساعة ماسامي-سان
Dialogue: 0,0:14:50.42,0:14:52.37,Default,,0000,0000,0000,,أخذها منها بالفعل إذاً
Dialogue: 0,0:14:55.96,0:14:58.23,Default,,0000,0000,0000,,حقائب دوراليومين فارغة
Dialogue: 0,0:14:58.70,0:15:00.20,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:15:00.20,0:15:05.41,Default,,0000,0000,0000,,طلبان منفصلان متناقضان للبحث عن الشخص نفسه
Dialogue: 0,0:15:05.41,0:15:10.36,Default,,0000,0000,0000,,يتصرّف هيروتا كينزو-سان بغرابة ويقود\Nبسرعة عالية على نفس الطريق يومياً
Dialogue: 0,0:15:10.36,0:15:12.02,Default,,0000,0000,0000,,...وهذه الحقائب
Dialogue: 0,0:15:12.02,0:15:13.15,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:15:13.36,0:15:15.61,Default,,0000,0000,0000,,!ماذا؟ هيروتا-سان أعزب؟
Dialogue: 0,0:15:15.98,0:15:17.93,Default,,0000,0000,0000,,أجل، لم تكن لديه ابنة
Dialogue: 0,0:15:17.93,0:15:20.06,Default,,0000,0000,0000,,كما أنّه من أهل طوكيو مولداً ونُشأة
Dialogue: 0,0:15:20.39,0:15:22.02,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:15:22.52,0:15:25.49,Default,,0000,0000,0000,,!هكذا إذاً! فهمت هذه القضية
Dialogue: 0,0:15:25.93,0:15:29.44,Default,,0000,0000,0000,,تلك الحقائب الفارغة هي مفتاح حلّ لغز القضية
Dialogue: 0,0:15:30.21,0:15:33.25,Default,,0000,0000,0000,,ماسامي-سان، هيروتا كينزو، وهيروتا أكيرا
Dialogue: 0,0:15:33.25,0:15:35.21,Default,,0000,0000,0000,,بعدما عرفنا أنّهم ليسوا أقارباً الآن
Dialogue: 0,0:15:35.21,0:15:36.70,Default,,0000,0000,0000,,فلا صلة بينهم أبداً
Dialogue: 0,0:15:36.70,0:15:40.41,Default,,0000,0000,0000,,،لكن في نصّ الحادثة الأخيرة قبل أيام
Dialogue: 0,0:15:40.41,0:15:42.40,Default,,0000,0000,0000,,!يُحلّ اللغز بأسره
Dialogue: 0,0:15:42.87,0:15:46.35,Default,,0000,0000,0000,,!إنّهم اللصوص الثلاثة الذين سرقوا المليار ينّ
Dialogue: 0,0:15:47.28,0:15:48.90,Default,,0000,0000,0000,,،بناءً على عدد الحقائب هنا
Dialogue: 0,0:15:48.90,0:15:51.07,Default,,0000,0000,0000,,فقد ملأوها بالمال المسروق غالباً
Dialogue: 0,0:15:51.07,0:15:55.28,Default,,0000,0000,0000,,في تلك الحالة، فسبب إسراع هيروتا-سان\Nبالسيّارة على نفس الطريق يومياً
Dialogue: 0,0:15:55.28,0:15:57.97,Default,,0000,0000,0000,,!كان للتمرن على هروبهم
Dialogue: 0,0:15:57.97,0:16:02.39,Default,,0000,0000,0000,,نجحت خطتهم، لكنه أخذ المال لنفسه وهرب
Dialogue: 0,0:16:02.39,0:16:03.77,Default,,0000,0000,0000,,خانهما
Dialogue: 0,0:16:04.31,0:16:07.05,Default,,0000,0000,0000,,سعياً للإمساك بهيروتا-سان، اختلق الاثنان قصّة كاذبة
Dialogue: 0,0:16:07.05,0:16:09.23,Default,,0000,0000,0000,,وأرسلا مُتحريّين منفصلين للبحث عنه
Dialogue: 0,0:16:09.59,0:16:13.59,Default,,0000,0000,0000,,وعندما وجداه، قُتل
Dialogue: 0,0:16:13.59,0:16:18.85,Default,,0000,0000,0000,,من قِبل الرجل ضخم البنية، ثمّ لقي هو\Nحتفه في هذه الغرفة
Dialogue: 0,0:16:18.85,0:16:22.32,Default,,0000,0000,0000,,قتلته المرأة التي ادّعت أنها ابنة هيروتا-سان
Dialogue: 0,0:16:23.37,0:16:29.44,Default,,0000,0000,0000,,لعلّها كانت المدبرة الرئيسية لهذه القضيّة
Dialogue: 0,0:16:30.03,0:16:30.90,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:16:31.44,0:16:33.36,Default,,0000,0000,0000,,...تسريحة شعرها وملبسها مختلف
Dialogue: 0,0:16:33.36,0:16:35.24,Default,,0000,0000,0000,,!لكن بنيتها وعدد الحقائب لم يكونا كذلك
Dialogue: 0,0:16:40.18,0:16:41.35,Default,,0000,0000,0000,,!أين تذهب يا كونان-كن؟
Dialogue: 0,0:16:41.35,0:16:43.07,Default,,0000,0000,0000,,!وجدت ماسامي-سان
Dialogue: 0,0:16:52.76,0:16:54.28,Default,,0000,0000,0000,,!ران-نيتشان! بسرعة
Dialogue: 0,0:16:54.28,0:16:56.73,Default,,0000,0000,0000,,!أنت يا صبي! لا تقطع الصف
Dialogue: 0,0:16:56.73,0:16:59.71,Default,,0000,0000,0000,,سيُقطع أبي أشلاءً ويُدفن حيّاً في الجبال
Dialogue: 0,0:16:59.71,0:17:01.19,Default,,0000,0000,0000,,!إلم نسرع وننقذه
Dialogue: 0,0:17:01.79,0:17:03.15,Default,,0000,0000,0000,,...تـ-تفضلا
Dialogue: 0,0:17:04.12,0:17:06.24,Default,,0000,0000,0000,,!اتبع سيارة الأجرة السابقة
Dialogue: 0,0:17:06.24,0:17:08.60,Default,,0000,0000,0000,,ماذا عن الجبال؟
Dialogue: 0,0:17:11.74,0:17:14.95,Default,,0000,0000,0000,,سبب اختلاف مظهرها عندما رأيناها المرة الثانية
Dialogue: 0,0:17:14.95,0:17:16.23,Default,,0000,0000,0000,,هو لأنّه عند عثورنا على هيروتا-سان
Dialogue: 0,0:17:16.23,0:17:19.39,Default,,0000,0000,0000,,كانت في عجلة ولم تكمل تنكرها
Dialogue: 0,0:17:19.39,0:17:22.94,Default,,0000,0000,0000,,وردّة فعل هيروتا-سان عندما رآها
Dialogue: 0,0:17:22.94,0:17:25.52,Default,,0000,0000,0000,,لم تكن دهشة رؤية ابنته
Dialogue: 0,0:17:25.52,0:17:27.55,Default,,0000,0000,0000,,بل رعب انتقام الرفيقين
Dialogue: 0,0:17:27.55,0:17:28.29,Default,,0000,0000,0000,,!اللذين خانهما
Dialogue: 0,0:17:28.98,0:17:32.55,Default,,0000,0000,0000,,!تبّاً! لمَ لم أدرك مسبقاً؟
Dialogue: 0,0:17:37.42,0:17:39.10,Default,,0000,0000,0000,,!ما العمل؟ فقدنا أثرها
Dialogue: 0,0:17:39.10,0:17:41.33,Default,,0000,0000,0000,,!أنا واثق أنّها دخلت هذا المرفأ
Dialogue: 0,0:17:41.33,0:17:43.02,Default,,0000,0000,0000,,!لا بدّ أنّها قريبة
Dialogue: 0,0:17:44.54,0:17:45.59,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:17:53.49,0:17:56.48,Default,,0000,0000,0000,,أين المال يا هيروتا ماسامي؟
Dialogue: 0,0:17:56.48,0:17:57.91,Default,,0000,0000,0000,,أقصد، ميانو أكيمي-كن
Dialogue: 0,0:17:58.48,0:18:00.35,Default,,0000,0000,0000,,أوكيتا-سان، ما الذي يجري؟
Dialogue: 0,0:18:00.35,0:18:04.06,Default,,0000,0000,0000,,...العقار المنوم الذي أعطيتني إيّاه لأنومه
Dialogue: 0,0:18:04.06,0:18:07.09,Default,,0000,0000,0000,,فورما شربه، سقط على الأرض وتوقف عن الحركة
Dialogue: 0,0:18:07.09,0:18:08.10,Default,,0000,0000,0000,,!اشرح
Dialogue: 0,0:18:09.89,0:18:13.05,Default,,0000,0000,0000,,كان وفير القوة البدنية، لكن فقير الفكر
Dialogue: 0,0:18:13.05,0:18:15.92,Default,,0000,0000,0000,,لا شكّ أنّه كان سيلفت انتباه السلطات
Dialogue: 0,0:18:15.92,0:18:19.06,Default,,0000,0000,0000,,بإنفاق كلّ نقوده يميناً ويساراً فورما يأخذها
Dialogue: 0,0:18:19.88,0:18:22.00,Default,,0000,0000,0000,,ببقاء شخص مثير للمخاطر مثله على قيد الحياة
Dialogue: 0,0:18:22.00,0:18:24.03,Default,,0000,0000,0000,,كانت خطّتي لتفسد
Dialogue: 0,0:18:24.38,0:18:27.24,Default,,0000,0000,0000,,كنت تنوي قتل الجميع من البداية إذاً؟
Dialogue: 0,0:18:34.66,0:18:36.87,Default,,0000,0000,0000,,سلّمي المال الآن
Dialogue: 0,0:18:37.48,0:18:40.33,Default,,0000,0000,0000,,ليس هنا، حفظته في مكان ما
Dialogue: 0,0:18:42.02,0:18:45.93,Default,,0000,0000,0000,,!سئمت من استغلالك لي
Dialogue: 0,0:18:45.93,0:18:47.47,Default,,0000,0000,0000,,!سأنسحب
Dialogue: 0,0:18:47.48,0:18:49.74,Default,,0000,0000,0000,,أتظنين بإمكانك ذلك؟
Dialogue: 0,0:18:49.74,0:18:50.60,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:50.60,0:18:54.12,Default,,0000,0000,0000,,سأخبرك بموقع النقود بعدما أغادر البلاد
Dialogue: 0,0:18:54.12,0:18:59.76,Default,,0000,0000,0000,,لا يمكن ذلك، ستكون خطتي في خطر طالما تبقين حيّة
Dialogue: 0,0:18:59.76,0:19:04.08,Default,,0000,0000,0000,,بموتك، ستختفي كلّ الخيوط التي تقود لي
Dialogue: 0,0:19:04.89,0:19:09.13,Default,,0000,0000,0000,,يمكنني إيجاد بدلاء لك ولهما بكلّ سهولة
Dialogue: 0,0:19:09.13,0:19:11.42,Default,,0000,0000,0000,,تلطيخ يديّ يعارض مبادئي
Dialogue: 0,0:19:11.42,0:19:12.99,Default,,0000,0000,0000,,لكنها ستكون اللمسة الأخيرة
Dialogue: 0,0:19:14.92,0:19:16.12,Default,,0000,0000,0000,,يا للسذاجة
Dialogue: 0,0:19:16.12,0:19:19.40,Default,,0000,0000,0000,,إن قتلتني لن تعرف أين المال أبداً
Dialogue: 0,0:19:19.87,0:19:21.66,Default,,0000,0000,0000,,لديّ فكرة عن مكانه
Dialogue: 0,0:19:23.66,0:19:28.57,Default,,0000,0000,0000,,أبليتِ حسناً، لذا دعيني أعبّر عن امتناني بقتلك
Dialogue: 0,0:19:28.84,0:19:29.71,Default,,0000,0000,0000,,!ماسامي-سان
Dialogue: 0,0:19:33.95,0:19:35.90,Default,,0000,0000,0000,,!خُذ
Dialogue: 0,0:19:43.05,0:19:44.05,Default,,0000,0000,0000,,أأنتِ بخير؟
Dialogue: 0,0:19:44.05,0:19:46.75,Default,,0000,0000,0000,,مجرد خدش
Dialogue: 0,0:19:46.75,0:19:50.17,Default,,0000,0000,0000,,!أنت الصبيّ من وكالة التحرّي
Dialogue: 0,0:19:50.17,0:19:51.75,Default,,0000,0000,0000,,كيف عرفت أنّي هنا؟
Dialogue: 0,0:19:51.75,0:19:52.80,Default,,0000,0000,0000,,!جهاز الإرسال
Dialogue: 0,0:19:52.80,0:19:53.74,Default,,0000,0000,0000,,جهاز الإرسال؟
Dialogue: 0,0:19:54.38,0:19:59.70,Default,,0000,0000,0000,,عندما أتيتِ في البداية للوكالة، التصق الجهاز\Nبلا قصد على ساعتك
Dialogue: 0,0:19:59.70,0:20:03.74,Default,,0000,0000,0000,,تبعت الإشارة ووصلت الفندق حيث التقيتك
Dialogue: 0,0:20:04.33,0:20:06.52,Default,,0000,0000,0000,,،بعد رؤيتك بتلك الحقائب الكبيرة
Dialogue: 0,0:20:06.52,0:20:09.65,Default,,0000,0000,0000,,أدركت أنّك كنتِ تغادرين بالمليار ينّ التي سرقتها
Dialogue: 0,0:20:10.11,0:20:12.12,Default,,0000,0000,0000,,مـ-من أنت بالضبط؟
Dialogue: 0,0:20:12.65,0:20:15.08,Default,,0000,0000,0000,,إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:20:15.48,0:20:19.18,Default,,0000,0000,0000,,لم أكن أعرف أنّ هناك شيء عالق بالساعة
Dialogue: 0,0:20:19.18,0:20:22.53,Default,,0000,0000,0000,,لكن كانت تلك الساعة تخصّ ذاك الرجل العملاق، صحيح؟
Dialogue: 0,0:20:22.53,0:20:29.17,Default,,0000,0000,0000,,كلا، كسر ساعته عندما فقد أعصابه\N،وقتل هيروتا-سان
Dialogue: 0,0:20:29.17,0:20:30.49,Default,,0000,0000,0000,,فأعطيته ساعتي
Dialogue: 0,0:20:31.21,0:20:34.95,Default,,0000,0000,0000,,نوى هذا الرجل قتل الجميع من البداية، صحيح؟
Dialogue: 0,0:20:35.50,0:20:36.45,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:36.45,0:20:37.99,Default,,0000,0000,0000,,أدرك هيروتا-سان ذلك
Dialogue: 0,0:20:37.99,0:20:40.61,Default,,0000,0000,0000,,لذا خاننا قبل أن نعلم ما يحصل
Dialogue: 0,0:20:41.10,0:20:44.58,Default,,0000,0000,0000,,أيعني ذلك أنّ هذا الرجل هو العقل المدبر\Nلجريمة سطو المليار ينّ؟
Dialogue: 0,0:20:44.91,0:20:49.82,Default,,0000,0000,0000,,أجل، بحث أوكيتا عن الأشخاص الضروريين لتنفيذ خطته
Dialogue: 0,0:20:49.82,0:20:57.39,Default,,0000,0000,0000,,يقوم بجمع أولئك الأشخاص في فرق\Nويرسلهم لارتكاب عمليات السطو
Dialogue: 0,0:20:57.39,0:21:01.02,Default,,0000,0000,0000,,كانت هناك شائعات بتخلّصه من أتباعه لكتم أفواههم
Dialogue: 0,0:21:01.02,0:21:02.68,Default,,0000,0000,0000,,،بعد إنهائهم عملهم
Dialogue: 0,0:21:02.68,0:21:04.53,Default,,0000,0000,0000,,!لكن لم أتوقع أنّها الحقيقة
Dialogue: 0,0:21:09.13,0:21:09.99,Default,,0000,0000,0000,,لن تهربي؟
Dialogue: 0,0:21:12.17,0:21:13.67,Default,,0000,0000,0000,,أنا مُرهقة
Dialogue: 0,0:21:13.67,0:21:17.90,Default,,0000,0000,0000,,!سأخبرك أين هي الحقائب بالمليار ينّ
Dialogue: 0,0:21:18.29,0:21:19.95,Default,,0000,0000,0000,,مكتب استقبال الفندق، صحيح؟
Dialogue: 0,0:21:19.95,0:21:21.24,Default,,0000,0000,0000,,كيف عرفت؟
Dialogue: 0,0:21:21.66,0:21:26.07,Default,,0000,0000,0000,,لم تكن الحقائب معك عندما صعدتِ سيّارة الأجرة
Dialogue: 0,0:21:26.07,0:21:27.03,Default,,0000,0000,0000,,...فتوقعت
Dialogue: 0,0:21:27.40,0:21:28.82,Default,,0000,0000,0000,,أنت مُبهر حقاً
Dialogue: 0,0:21:29.04,0:21:30.28,Default,,0000,0000,0000,,!مكانك
Dialogue: 0,0:21:32.11,0:21:33.70,Default,,0000,0000,0000,,!أنتِ ثرثارة يا امرأة
Dialogue: 0,0:21:46.26,0:21:47.92,Default,,0000,0000,0000,,!ماسامي-سان
Dialogue: 0,0:21:47.92,0:21:49.24,Default,,0000,0000,0000,,!مـ-من هذا؟
Dialogue: 0,0:21:53.05,0:21:55.45,Default,,0000,0000,0000,,زعيم عملية سطو المليار ينّ
Dialogue: 0,0:22:00.90,0:22:04.80,Default,,0000,0000,0000,,كما قالت، كانت المليار ينّ محفوظة في الفندق
Dialogue: 0,0:22:06.26,0:22:08.78,Default,,0000,0000,0000,,طابقت أرقام العملات المال المسروق
Dialogue: 0,0:22:09.15,0:22:11.86,Default,,0000,0000,0000,,فأُغلقت قضية سطو المليار ينّ
Dialogue: 0,0:22:19.94,0:22:21.78,Default,,0000,0000,0000,,شكراً لك أيّها المتحري الصغير
Dialogue: 0,0:24:00.09,0:24:01.21,On Top,,0000,0000,0000,,!هناك
Dialogue: 0,0:24:01.21,0:24:03.53,Default,,0000,0000,0000,,يوجد أشخاص فوق البناء على\N!الجانب الآخر للنهر{\a6}
Dialogue: 0,0:24:07.22,0:24:09.40,Default,,0000,0000,0000,,ما معنى رسالة الأرقام المشفرة هذه؟
Dialogue: 0,0:24:09.78,0:24:12.87,Default,,0000,0000,0000,,قد تكون أرقام طريق
Dialogue: 0,0:24:12.87,0:24:15.37,Default,,0000,0000,0000,,مثل الطريق 162
Dialogue: 0,0:24:16.01,0:24:17.99,Default,,0000,0000,0000,,!سيّدي المفتش! بسرعة! المروحية
Dialogue: 0,0:24:24.44,0:24:25.85,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.85,0:24:28.31,Default,,0000,0000,0000,,قضيّة رسالة القناص الغامضة
Dialogue: 0,0:24:45.34,0:24:47.45,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.45,0:24:49.75,Default,,0000,0000,0000,,!حاسبة الكترونية عادية، أمعنوا النظر لها
Dialogue: 0,0:24:50.93,0:24:53.45,Default,,0000,0000,0000,,!جرّبوا النظر بالمقلوب في الحلقة القادمة

