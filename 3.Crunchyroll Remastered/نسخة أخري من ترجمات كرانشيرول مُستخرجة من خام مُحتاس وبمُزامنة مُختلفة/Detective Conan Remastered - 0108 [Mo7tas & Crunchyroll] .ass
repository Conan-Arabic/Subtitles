Dialogue: 0,0:00:00.88,0:00:04.21,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والقضايا تلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.21,0:00:06.24,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.24,0:00:09.99,Default,,0000,0000,0000,,!اليوم ختام قضيّة الخلد! مشاعر الناس مرتبطة تحت الأرض
Dialogue: 0,0:00:10.12,0:00:11.50,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.50,0:00:13.63,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.63,0:00:16.12,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.79,0:00:24.21,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.21,0:00:31.25,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:33.02,0:00:39.38,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.38,0:00:46.88,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.88,0:00:59.33,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.25,0:01:06.63,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.63,0:01:13.51,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.51,0:01:19.88,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.88,0:01:26.90,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:52.45,0:01:56.00,Default,,0000,0000,0000,,كنتُ ألعب مع غينتا وميتسوهيكو\Nوأيومي كرة القاعدة
Dialogue: 0,0:01:56.00,0:01:59.17,Default,,0000,0000,0000,,في ساحة مواقف سيّارات\Nلبناية شقق غير مكتملة
Dialogue: 0,0:01:59.42,0:02:03.67,Default,,0000,0000,0000,,ذهبنا لجلب الكرة بعدما سقطت\Nفي فناء منزل مجاور
Dialogue: 0,0:02:03.67,0:02:07.64,Default,,0000,0000,0000,,لكن طردنا مالك المنزل، واتانوكي يوشيكازو
Dialogue: 0,0:02:09.88,0:02:13.29,Default,,0000,0000,0000,,وعندما رجعنا لوكالة التحرّي، كان بانتظارنا
Dialogue: 0,0:02:13.29,0:02:16.81,Default,,0000,0000,0000,,كودا ماساو الذي بدا كفضائيّ الخلد في يايبا المقنّع
Dialogue: 0,0:02:18.98,0:02:23.08,Default,,0000,0000,0000,,قال أنّ شقيقته التي فُقدت قبل شهر\Nقد قُتلت على يدَي واتانوكي
Dialogue: 0,0:02:23.08,0:02:27.28,Default,,0000,0000,0000,,،ودُفنت في مكانٍ ما في فنائه\Nوطلب المساعدة في إيجادها
Dialogue: 0,0:02:27.28,0:02:32.50,Default,,0000,0000,0000,,لكنّ التسلّل لمنازل الآخرين والحفر\Nفي فنائهم أمرٌ مخالف للقانون
Dialogue: 0,0:02:34.12,0:02:37.59,Default,,0000,0000,0000,,بعدما رفض العمّ طلبه، غادر كودا ماساو غاضباً
Dialogue: 0,0:02:40.04,0:02:43.51,Default,,0000,0000,0000,,لكن، بعد اقتناعنا بأنّه سيحفر في الفناء
Dialogue: 0,0:02:43.51,0:02:47.93,Default,,0000,0000,0000,,!أثناء غياب واتانوكي في المشفى، واصلنا المراقبة
Dialogue: 0,0:02:47.93,0:02:51.08,Default,,0000,0000,0000,,!آنذاك، وقعت جريمة سطو على محلّ مجوهرات
Dialogue: 0,0:02:51.76,0:02:54.68,Default,,0000,0000,0000,,!والسارق كان كودا ماساو نفسه
Dialogue: 0,0:02:55.67,0:02:58.92,Default,,0000,0000,0000,,ما هو دافعه الحقيقيّ؟
Dialogue: 0,0:03:03.23,0:03:09.04,Title,,0000,0000,15,,{\fad(300,0)}قضيّة لغز فضائيّ الخلد\N(الجزء الثاني)
Dialogue: 0,0:03:03.67,0:03:07.75,Default,,0000,0000,0000,,قضيّة لغز فضائيّ الخلد\N(الجزء الثاني)
Dialogue: 0,0:03:09.04,0:03:11.50,CharCard,,0000,0090,0005,,السبت
Dialogue: 0,0:03:11.70,0:03:13.64,Default,,0000,0000,0000,,تأخّر فضائيّ الخلد
Dialogue: 0,0:03:13.64,0:03:17.18,Default,,0000,0000,0000,,توقّف عن مناداته بذلك
Dialogue: 0,0:03:17.18,0:03:18.98,Default,,0000,0000,0000,,فهو يبدو مثله لا أكثر
Dialogue: 0,0:03:18.98,0:03:23.52,Default,,0000,0000,0000,,!ماذا؟ أنتِ من أطلق ذلك عليه
Dialogue: 0,0:03:27.02,0:03:28.10,Default,,0000,0000,0000,,!إنّه هو
Dialogue: 0,0:03:28.10,0:03:30.32,Default,,0000,0000,0000,,!كان فضائيّ الخلد بالفعل
Dialogue: 0,0:03:38.28,0:03:39.83,Default,,0000,0000,0000,,ماذا نفعل يا غينتا-كن؟
Dialogue: 0,0:03:39.83,0:03:41.62,Default,,0000,0000,0000,,!بأيّ حال، لنذهب وننظر
Dialogue: 0,0:03:48.16,0:03:49.42,Default,,0000,0000,0000,,ما الذي يفعله؟
Dialogue: 0,0:03:49.66,0:03:51.87,Default,,0000,0000,0000,,ألم يكن سيحفر في الفناء؟
Dialogue: 0,0:03:51.87,0:03:54.49,Default,,0000,0000,0000,,!سأعيره مجرفتي إذاً
Dialogue: 0,0:03:54.49,0:03:57.64,Default,,0000,0000,0000,,انتظر، لنراقب أكثر
Dialogue: 0,0:04:05.24,0:04:08.48,Default,,0000,0000,0000,,...إذا أصاب تحليلي، فكودا-سان
Dialogue: 0,0:04:10.49,0:04:12.57,CharCard,,0000,0070,0004,,{\fad(250,0)}مشفى بيكا المركزيّ
Dialogue: 0,0:04:17.70,0:04:20.16,Default,,0000,0000,0000,,ماذا؟ لم يتّصل بي أحد؟
Dialogue: 0,0:04:20.16,0:04:26.28,Default,,0000,0000,0000,,أجل، لا نتّصل بالمرضى لأمور كهذه
Dialogue: 0,0:04:26.28,0:04:29.63,Default,,0000,0000,0000,,من كان المتّصل إذاً؟
Dialogue: 0,0:04:40.66,0:04:42.62,Default,,0000,0000,0000,,!خذني لشارع بيكا الأوّل! أسرع رجاءً
Dialogue: 0,0:04:42.62,0:04:43.52,Default,,0000,0000,0000,,!حـ-حاضر
Dialogue: 0,0:04:48.74,0:04:51.61,Default,,0000,0000,0000,,غينتا-كن! معك ميتسوهيكو! أتسمعني؟
Dialogue: 0,0:04:51.61,0:04:54.12,Default,,0000,0000,0000,,معك القائد! ما الذي يجري يا ميتسوهيكو؟
Dialogue: 0,0:04:54.12,0:04:57.45,Default,,0000,0000,0000,,مشكلة، غادر العجوز بسيّارة أجرة\N!وهو متّجه لكم
Dialogue: 0,0:04:57.45,0:04:58.99,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:04:58.99,0:05:00.62,Default,,0000,0000,0000,,ماذا نفعل يا أيومي؟
Dialogue: 0,0:05:01.62,0:05:03.87,Default,,0000,0000,0000,,ربما حريّ بنا إخباره
Dialogue: 0,0:05:05.21,0:05:08.92,Default,,0000,0000,0000,,!يا عمّ! واتانوكي-سان سيرجع قريباً
Dialogue: 0,0:05:10.04,0:05:13.00,Default,,0000,0000,0000,,!سيراك إذا لم تسرع وتهرب
Dialogue: 0,0:05:16.37,0:05:18.01,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:05:18.01,0:05:19.51,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:05:20.53,0:05:22.93,Default,,0000,0000,0000,,ما قصدك يا كونان؟
Dialogue: 0,0:05:23.41,0:05:25.39,Default,,0000,0000,0000,,...كودا-سان
Dialogue: 0,0:05:35.91,0:05:39.28,Default,,0000,0000,0000,,!أنت! ما الذي تظنّ أنّك تفعله؟
Dialogue: 0,0:05:39.28,0:05:42.03,Default,,0000,0000,0000,,!أثبت ما قمتَ بارتكابه
Dialogue: 0,0:05:42.45,0:05:43.74,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:54.08,0:05:56.30,Default,,0000,0000,0000,,!ضرب فضائيّ الخلد
Dialogue: 0,0:05:56.74,0:06:00.89,Default,,0000,0000,0000,,!ارحل! فلتخرج من هنا فوراً! وأنتم كذلك
Dialogue: 0,0:06:01.24,0:06:02.99,Default,,0000,0000,0000,,...مخيف
Dialogue: 0,0:06:02.99,0:06:04.60,Default,,0000,0000,0000,,ما ذلك؟
Dialogue: 0,0:06:05.33,0:06:07.25,Default,,0000,0000,0000,,هناك شيءٌ يلمع
Dialogue: 0,0:06:10.20,0:06:11.62,Default,,0000,0000,0000,,!قرط ساناي
Dialogue: 0,0:06:19.78,0:06:21.11,Default,,0000,0000,0000,,...شظيّة زجاج
Dialogue: 0,0:06:22.99,0:06:23.95,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:06:31.37,0:06:34.09,Default,,0000,0000,0000,,سأجري أنا الاتّصال يا عمّ
Dialogue: 0,0:06:36.53,0:06:41.01,Default,,0000,0000,0000,,ستسلّم نفسك للشرطة، صحيح؟ \Nأعرف مفتّشاً هناك
Dialogue: 0,0:06:44.83,0:06:47.52,Default,,0000,0000,0000,,مفتّش ميغوري، صحيح؟ كنتُ بانتظارك
Dialogue: 0,0:06:48.08,0:06:51.98,Default,,0000,0000,0000,,ما معنى هذا يا كودا-سان؟\Nأسطوت على محلّ مجوهرات حقّاً؟
Dialogue: 0,0:06:52.35,0:06:58.08,Default,,0000,0000,0000,,أجل، المجوهرات التي سرقتُها\Nمدفونة في فناء واتانوكي
Dialogue: 0,0:06:58.08,0:07:01.24,Default,,0000,0000,0000,,،لا أتذكّر أين دفنتها بالضبط
Dialogue: 0,0:07:01.24,0:07:03.45,Default,,0000,0000,0000,,فعليكم حفر الفناء والبحث عنها
Dialogue: 0,0:07:03.74,0:07:05.33,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:07:06.95,0:07:08.91,Default,,0000,0000,0000,,!ما هذه الحفر؟
Dialogue: 0,0:07:08.91,0:07:14.24,Default,,0000,0000,0000,,من صنع كودا-سان، المجوهرات مدفونةٌ في بعضٍ منها
Dialogue: 0,0:07:14.24,0:07:19.51,Default,,0000,0000,0000,,لذا عليكم حفر الفناء بأكمله\Nلمعرفة أيّها تحوي المجوهرات
Dialogue: 0,0:07:19.95,0:07:21.08,Default,,0000,0000,0000,,!كودا-سان
Dialogue: 0,0:07:21.08,0:07:26.12,Default,,0000,0000,0000,,أيمكن أنّك أقدمت على عمليّة السطو تلك\Nكي تدفع الشرطة للتنقيب في الفناء؟
Dialogue: 0,0:07:26.12,0:07:29.22,Default,,0000,0000,0000,,لم تنو الهرب من البداية إذاً؟
Dialogue: 0,0:07:29.58,0:07:33.90,Default,,0000,0000,0000,,أراد كودا-سان وقتاً كافياً\Nلحفر الحفر لا أكثر
Dialogue: 0,0:07:34.53,0:07:38.41,Default,,0000,0000,0000,,لذا تعمّد ترك جوهرة\N،على أدراج المحطّة
Dialogue: 0,0:07:38.41,0:07:40.40,Default,,0000,0000,0000,,وأوهمنا أنّه هرب بالقطار
Dialogue: 0,0:07:41.08,0:07:43.95,Default,,0000,0000,0000,,هذا المسدّس المقلّد الذي\Nاستعملته في السطو
Dialogue: 0,0:07:48.28,0:07:51.33,Default,,0000,0000,0000,,أنت واتانوكي يوشيكازو-سان، صحيح؟
Dialogue: 0,0:07:51.33,0:07:52.41,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:52.41,0:07:56.41,Default,,0000,0000,0000,,أخبرني موري-كن هنا عن قضيّتك مع كودا-سان
Dialogue: 0,0:07:56.41,0:07:58.96,Default,,0000,0000,0000,,هل تمانع حفرنا في الفناء؟
Dialogue: 0,0:07:59.24,0:08:02.17,Default,,0000,0000,0000,,لا-لا تمازحني! أيّ حقّ لديكم؟
Dialogue: 0,0:08:02.17,0:08:06.41,Default,,0000,0000,0000,,هذا ضروريّ لإتمام تحقيقات عملية سطو
Dialogue: 0,0:08:06.41,0:08:11.60,Default,,0000,0000,0000,,أم قد يخرج ما يضرّك\Nإن حفرنا الفناء؟
Dialogue: 0,0:08:11.60,0:08:14.60,Default,,0000,0000,0000,,!بـ-بالطبع لا
Dialogue: 0,0:08:15.03,0:08:18.41,Default,,0000,0000,0000,,!في تلك الحالة، تاكاغي-كن، اتّصل بالمركز
Dialogue: 0,0:08:18.41,0:08:19.27,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:08:19.58,0:08:20.91,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:08:20.91,0:08:22.24,Default,,0000,0000,0000,,هذا حسنٌ لك يا عمّ
Dialogue: 0,0:08:22.24,0:08:23.24,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:27.08,0:08:31.05,Default,,0000,0000,0000,,...لمَ هذه الابتسامة؟ أيمكن
Dialogue: 0,0:08:34.33,0:08:38.79,Default,,0000,0000,0000,,!المجوهرات صغيرة! فلتحفروا المكان كليّاً
Dialogue: 0,0:08:49.43,0:08:50.70,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:08:51.38,0:08:53.72,Default,,0000,0000,0000,,لم نجد سوى المجوهرات
Dialogue: 0,0:08:53.72,0:08:56.34,Default,,0000,0000,0000,,لا أظنّ أنّه توجد أيّ جثث هنا
Dialogue: 0,0:08:56.34,0:08:57.87,Default,,0000,0000,0000,,!يستحيل ذلك
Dialogue: 0,0:08:58.18,0:09:00.34,Default,,0000,0000,0000,,!أمعنوا البحث
Dialogue: 0,0:09:00.34,0:09:05.38,Default,,0000,0000,0000,,أمعنّا البحث! أين يُفترض بنا الحفر في غير هذا؟
Dialogue: 0,0:09:06.90,0:09:08.84,Default,,0000,0000,0000,,أخرجتم كلّ شيءٍ فعلاً
Dialogue: 0,0:09:09.34,0:09:12.89,Default,,0000,0000,0000,,ربما سأستغلّ هذه الفرصة\Nفي زراعة حديقة خضروات
Dialogue: 0,0:09:13.17,0:09:15.26,Default,,0000,0000,0000,,صحيح، حضرة المفتّش؟
Dialogue: 0,0:09:15.26,0:09:16.35,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:09:16.68,0:09:18.38,Default,,0000,0000,0000,,!كودا-سان
Dialogue: 0,0:09:31.34,0:09:32.61,Default,,0000,0000,0000,,...كودا-سان
Dialogue: 0,0:09:33.01,0:09:38.80,Default,,0000,0000,0000,,اخرس! ساناي هنا! إنّها مدفونة\N!في مكانٍ ما في هذا الفناء حتماً
Dialogue: 0,0:09:38.80,0:09:43.75,Default,,0000,0000,0000,,أتفهّم شعورك، لكن لا جدوى من مواصلة هذا
Dialogue: 0,0:09:45.38,0:09:46.98,Default,,0000,0000,0000,,...ساناي
Dialogue: 0,0:09:48.10,0:09:49.80,Default,,0000,0000,0000,,!ساناي
Dialogue: 0,0:09:56.90,0:09:58.72,Default,,0000,0000,0000,,اعتقلت الشرطة كودا-سان؟
Dialogue: 0,0:09:59.72,0:10:05.01,Default,,0000,0000,0000,,أجل، فقد ارتكب عمليّة سطو\Nعلى محلّ مجوهرات مهما كانت دوافعه
Dialogue: 0,0:10:05.01,0:10:08.01,Default,,0000,0000,0000,,لكن لمَ لم يجدوا الجثّة؟
Dialogue: 0,0:10:08.64,0:10:11.95,Default,,0000,0000,0000,,لأنّها لم تكن موجودةً من البداية
Dialogue: 0,0:10:13.92,0:10:16.34,Default,,0000,0000,0000,,أخطأ كودا-سان الظنّ
Dialogue: 0,0:10:16.34,0:10:22.33,Default,,0000,0000,0000,,لم يقتلها واتانوكي-سان، بل اختفت لسببٍ آخر
Dialogue: 0,0:10:22.33,0:10:26.71,Default,,0000,0000,0000,,!كلا، قتلها واتانوكي-سان
Dialogue: 0,0:10:27.97,0:10:30.17,Default,,0000,0000,0000,,...ابتسامته آنذاك
Dialogue: 0,0:10:31.01,0:10:33.22,Default,,0000,0000,0000,,!كانت أكبر دليل
Dialogue: 0,0:10:33.22,0:10:38.43,Default,,0000,0000,0000,,لكنّها قالت أنّها ستزور\Nمنزل واتانوكي-سان
Dialogue: 0,0:10:38.43,0:10:42.72,Default,,0000,0000,0000,,قبل الرجوع للبيت في ليلة\Nالثامن من مايو بلا شكّ، صحيح؟
Dialogue: 0,0:10:42.72,0:10:45.94,Default,,0000,0000,0000,,أجل، هذا ما قاله زميلها في العمل
Dialogue: 0,0:10:46.18,0:10:50.78,Default,,0000,0000,0000,,ماذا؟ ذهبت لشركتها يا عمّ؟\Nهل اكتشفت شيئاً؟
Dialogue: 0,0:10:50.78,0:10:53.34,Default,,0000,0000,0000,,الشيء الوحيد الإضافيّ الذي اكتشفته
Dialogue: 0,0:10:53.34,0:11:00.20,Default,,0000,0000,0000,,هو أنّ زميلها أعطاها بذور\Nقسموس في استراحة الغداء
Dialogue: 0,0:11:00.63,0:11:02.20,Default,,0000,0000,0000,,بذور قسموس؟
Dialogue: 0,0:11:02.20,0:11:08.88,Default,,0000,0000,0000,,ألا تذكرين؟ قال أنّ أخته\Nتحبّ أزهار القسموس
Dialogue: 0,0:11:09.51,0:11:12.84,Default,,0000,0000,0000,,بأيّ حال، أكبر احتمالٍ الآن
Dialogue: 0,0:11:12.84,0:11:16.88,Default,,0000,0000,0000,,هو أنّ حادثاً ما وقع لها فاختفت
Dialogue: 0,0:11:16.88,0:11:20.35,Default,,0000,0000,0000,,في طريقها لمنزل واتانوكي-سان\Nبعد مغادرتها للشركة
Dialogue: 0,0:11:20.76,0:11:23.99,Default,,0000,0000,0000,,يبدو أنّ الشرطة ستعتمد تحقيقها\Nعلى ذلك الأساس أيضاً
Dialogue: 0,0:11:25.16,0:11:30.13,CharCard,,0000,0100,0004,,(اليوم التالي (الأحد
Dialogue: 0,0:11:25.47,0:11:29.77,On Top,,0000,0000,0000,,تعتقد أنّ ذاك العجوز قد قتلها إذاً\Nيا كونان-كن؟
Dialogue: 0,0:11:30.17,0:11:32.23,Default,,0000,0000,0000,,أجل، أنا متأكّد من الأمر تقريباً
Dialogue: 0,0:11:32.81,0:11:35.52,Default,,0000,0000,0000,,لكنّهم لم يجدوا جثّتها
Dialogue: 0,0:11:35.52,0:11:41.50,Default,,0000,0000,0000,,أجل، ربما دُفنت تحت لوح أرضيّة\Nفي المنزل وليس الحديقة؟
Dialogue: 0,0:11:41.81,0:11:46.71,Default,,0000,0000,0000,,كلا، لن يُسمع صوت حفر\Nفي الزقاق الخلفيّ في تلك الحالة
Dialogue: 0,0:11:46.98,0:11:49.13,Default,,0000,0000,0000,,هل نذهب للمكتبة؟
Dialogue: 0,0:11:49.13,0:11:50.85,Default,,0000,0000,0000,,الـ-المكتبة؟
Dialogue: 0,0:11:50.85,0:11:51.64,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:51.64,0:11:55.60,Default,,0000,0000,0000,,،إذا تفقّدنا صحف الثامن من مايو\N!قد نكتشف شيئاً
Dialogue: 0,0:11:55.81,0:12:00.06,Default,,0000,0000,0000,,معكِ حقّ، لكن ما علينا تفقّده\Nليست صحف الثامن من مايو
Dialogue: 0,0:12:01.18,0:12:05.18,Default,,0000,0000,0000,,لأنّ أنباء تلك الليلة لن تظهر\Nفي صحيفة اليوم نفسه
Dialogue: 0,0:12:11.35,0:12:16.27,Default,,0000,0000,0000,,يوجد عرض ليايبا المقنّع في مركز تسوّق توتو\N!يوما الثالث والعشرين والرابع والعشرين
Dialogue: 0,0:12:16.27,0:12:17.24,Default,,0000,0000,0000,,!علينا الذهاب لمشاهدته
Dialogue: 0,0:12:17.24,0:12:21.67,Default,,0000,0000,0000,,غينتا-كن، أنت تقرأ صحف الشهر الفائت
Dialogue: 0,0:12:21.67,0:12:24.93,Default,,0000,0000,0000,,كما أنّنا ذهبنا جميعاً لمشاهدة ذاك العرض
Dialogue: 0,0:12:25.56,0:12:26.39,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:12:26.39,0:12:28.67,Default,,0000,0000,0000,,!أجل، حقّاً
Dialogue: 0,0:12:30.73,0:12:33.31,Default,,0000,0000,0000,,لا أرى أيّ مقالات ذات صلة
Dialogue: 0,0:12:33.31,0:12:34.18,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:12:34.81,0:12:40.14,Default,,0000,0000,0000,,كانت هناك ريح شرقيّة قويّة\Nمن ليلة اليوم الثامن إلى التاسع وفقما يبدو
Dialogue: 0,0:12:40.39,0:12:43.68,Default,,0000,0000,0000,,ما علاقة ذلك بالقضيّة؟
Dialogue: 0,0:12:43.68,0:12:44.81,Default,,0000,0000,0000,,...حسناً، لستُ متأكداً
Dialogue: 0,0:12:44.81,0:12:47.93,Default,,0000,0000,0000,,،يبدو أنّه لا توجد أيّ دلائل قد تفيدنا
Dialogue: 0,0:12:47.93,0:12:53.02,Default,,0000,0000,0000,,فلمَ لا نذهب للقاء موتشيدا-سان \Nالذي سمع صوت الحفر؟
Dialogue: 0,0:12:54.14,0:12:57.89,On Top,,0000,0000,0000,,كان ذلك قبل شهر، وكنتُ ثملاً
Dialogue: 0,0:12:54.68,0:12:59.72,CharCard,,0000,0060,0004,,{\fad(200,0)}(موتشيدا شينتشي (35
Dialogue: 0,0:12:57.89,0:12:59.58,On Top,,0000,0000,0000,,فلا أتذكّر بوضوح
Dialogue: 0,0:12:59.88,0:13:04.59,Default,,0000,0000,0000,,دخلت الزقاق من هذا الطريق، صحيح؟
Dialogue: 0,0:13:04.92,0:13:09.94,Default,,0000,0000,0000,,أجل، كان صوت عمليات البناء\Nعلى هذا الطريق مزعجاً تلك الليلة
Dialogue: 0,0:13:09.94,0:13:15.08,Default,,0000,0000,0000,,فأسرعتُ لهذا الزقاق، وأشعلت سيجارة\Nبعدما مشيت فيه قليلاً
Dialogue: 0,0:13:15.08,0:13:20.52,Default,,0000,0000,0000,,عندها سمعت صوت مجرفة من المنزل يساراً
Dialogue: 0,0:13:20.98,0:13:24.86,Default,,0000,0000,0000,,أأنت متأكّد أنّه كان هذا المنزل؟
Dialogue: 0,0:13:24.86,0:13:27.07,Default,,0000,0000,0000,,...حسناً، كنت ثملاً
Dialogue: 0,0:13:32.61,0:13:36.33,Default,,0000,0000,0000,,أجل، أنا متأكّد، سمعتُه من يساري
Dialogue: 0,0:13:37.69,0:13:40.98,Default,,0000,0000,0000,,هلّا قلّدتَ ما فعلته ليلتها؟
Dialogue: 0,0:13:40.98,0:13:42.05,Default,,0000,0000,0000,,لا أمانع
Dialogue: 0,0:13:42.65,0:13:47.11,Default,,0000,0000,0000,,كانت هناك شاحنة تابعة لعمليات\Nالبناء مركونةً هناك
Dialogue: 0,0:13:47.11,0:13:50.10,Default,,0000,0000,0000,,فدخلتُ الزقاق وأنا أتذمّر من إزعاجها
Dialogue: 0,0:13:50.61,0:13:54.81,Default,,0000,0000,0000,,أجل، أشعلتُ سيجارتي في هذه النقطة تقريباً
Dialogue: 0,0:13:54.99,0:13:57.77,Default,,0000,0000,0000,,!انتظر، هذا الشرق
Dialogue: 0,0:13:58.07,0:14:01.73,Default,,0000,0000,0000,,أخبرني، ألم تهبّ عليك\Nرياح قويّة مباشرةً وقتها؟
Dialogue: 0,0:14:03.44,0:14:05.03,Default,,0000,0000,0000,,...بذكرك ذلك
Dialogue: 0,0:14:09.03,0:14:12.44,Default,,0000,0000,0000,,كانت الرياح قويّة، فانطفأت شعلة القدّاحة من فورها
Dialogue: 0,0:14:10.23,0:14:16.21,On Top,,0000,0000,0000,,{\fs22\pos(158.25,155)}بناية الشقق
Dialogue: 0,0:14:10.23,0:14:16.21,On Top,,0000,0000,0000,,{\fs22\pos(351,235)}منزل واتانوكي
Dialogue: 0,0:14:10.23,0:14:16.21,On Top,,0000,0000,0000,,{\fs22\pos(336.75,41)}واجهة الشارع
Dialogue: 0,0:14:10.23,0:14:16.21,On Top,,0000,0000,0000,,{\fs22\pos(367.5,149)}غرب
Dialogue: 0,0:14:10.23,0:14:16.21,On Top,,0000,0000,0000,,{\fs22\pos(186.75,272)}شرق
Dialogue: 0,0:14:12.44,0:14:14.77,Default,,0000,0000,0000,,فاستدرتُ لإشعالها
Dialogue: 0,0:14:16.94,0:14:18.75,Default,,0000,0000,0000,,...لحظة، أيعني ذلك
Dialogue: 0,0:14:19.40,0:14:22.61,Default,,0000,0000,0000,,كان اليسار يميناً، واليمين يساراً؟
Dialogue: 0,0:14:22.61,0:14:23.75,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:14:23.75,0:14:26.13,Default,,0000,0000,0000,,...فهمت! لذا آنذاك
Dialogue: 0,0:14:33.23,0:14:36.77,Default,,0000,0000,0000,,حسنٌ، ستكون فتحة الصرف هذه\N!هي القاعدة الرئيسيّة
Dialogue: 0,0:14:41.07,0:14:43.65,Default,,0000,0000,0000,,!حسناً! وجدتها
Dialogue: 0,0:14:48.03,0:14:50.70,Default,,0000,0000,0000,,ماذا؟ عرفتم مكان الجثّة؟
Dialogue: 0,0:14:51.03,0:14:54.41,Default,,0000,0000,0000,,!أجل! وجدناها نحن، فرقة فتيان التحرّي
Dialogue: 0,0:14:54.41,0:14:56.57,Default,,0000,0000,0000,,أخبروني أين إذاً؟
Dialogue: 0,0:14:56.57,0:15:00.29,Default,,0000,0000,0000,,دعيكِ منهم، ما يقوله هؤلاء الأطفال\Nهراءٌ بلا شكّ
Dialogue: 0,0:15:01.11,0:15:04.38,Default,,0000,0000,0000,,لكن قال شينتشي-نيتشان أنّ لا شكّ في الأمر أيضاً
Dialogue: 0,0:15:04.38,0:15:05.44,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:05.44,0:15:07.84,Default,,0000,0000,0000,,!التقيت شينتشي يا كونان-كن؟
Dialogue: 0,0:15:07.84,0:15:11.23,Default,,0000,0000,0000,,كلا، كلّمته على الهاتف قبل قليل
Dialogue: 0,0:15:11.23,0:15:15.61,Default,,0000,0000,0000,,وقال أنّه سيتّصل بالمفتّش ميغوري
Dialogue: 0,0:15:15.61,0:15:18.56,Default,,0000,0000,0000,,!لذا عليكما القدوم أيضاً
Dialogue: 0,0:15:19.28,0:15:21.30,Default,,0000,0000,0000,,إلى أين؟
Dialogue: 0,0:15:25.36,0:15:30.45,Default,,0000,0000,0000,,ما الذي يجري يا حضرة المفتّش؟ هلّا شرحت لي؟
Dialogue: 0,0:15:30.45,0:15:32.15,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:15:32.15,0:15:34.94,Default,,0000,0000,0000,,أأنتم متأكدون مما تفعلونه؟
Dialogue: 0,0:15:34.94,0:15:39.62,Default,,0000,0000,0000,,لم أكن لأوافق على فعل هذا\N...لو لم يتّصل بي شينتشي-كن البتّة
Dialogue: 0,0:15:41.48,0:15:43.65,Default,,0000,0000,0000,,دع الأمر لنا حضرة المفتّش
Dialogue: 0,0:15:43.65,0:15:45.38,Default,,0000,0000,0000,,!حسناً، لنبدأ
Dialogue: 0,0:15:47.11,0:15:50.98,Default,,0000,0000,0000,,،في ليلة الثامن من مايو، مرّت ساناي-سان
Dialogue: 0,0:15:50.98,0:15:54.34,Default,,0000,0000,0000,,أخت كودا-سان، بهذا المنزل بعد\Nمغادرتها الشركة كما قالت
Dialogue: 0,0:15:54.82,0:15:57.51,Default,,0000,0000,0000,,،وكما استنتج كودا-سان
Dialogue: 0,0:15:57.82,0:16:00.48,Default,,0000,0000,0000,,فقد قتلها واتانوكي-سان
Dialogue: 0,0:16:01.86,0:16:07.44,Default,,0000,0000,0000,,سخافة! أيّ هراء تقوله؟\N!حفروا الفناء بأكمله بالأمس
Dialogue: 0,0:16:07.86,0:16:12.86,Default,,0000,0000,0000,,!لكنّك لم تدفن الجثّة في فنائك، بل مكان آخر
Dialogue: 0,0:16:14.11,0:16:17.49,Default,,0000,0000,0000,,!أخبرني! أين دُفنت أختي؟
Dialogue: 0,0:16:17.78,0:16:20.36,Default,,0000,0000,0000,,!ستعرفون إذا ذهبتم للطابق العلويّ
Dialogue: 0,0:16:20.36,0:16:22.33,Default,,0000,0000,0000,,اتبعوني
Dialogue: 0,0:16:22.33,0:16:23.98,Default,,0000,0000,0000,,!لحظة، انتظروا
Dialogue: 0,0:16:44.78,0:16:49.44,Default,,0000,0000,0000,,كونان، أين دُفنت في هذه الغرفة؟
Dialogue: 0,0:16:49.82,0:16:51.40,Default,,0000,0000,0000,,ليس هنا
Dialogue: 0,0:16:53.44,0:16:54.74,Default,,0000,0000,0000,,بل هنا
Dialogue: 0,0:16:59.28,0:17:00.32,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:17:04.07,0:17:06.50,Default,,0000,0000,0000,,بناية شقق غير مكتملة
Dialogue: 0,0:17:06.78,0:17:10.36,Default,,0000,0000,0000,,جثّة أختك مدفونة هناك
Dialogue: 0,0:17:11.78,0:17:17.18,Default,,0000,0000,0000,,وقت الحادثة، كانت عمليات البناء\Nتجري وفق المخطط
Dialogue: 0,0:17:17.53,0:17:22.44,Default,,0000,0000,0000,,لذا دفن جثّةٍ هناك يعني\Nأنّها لن تُستخرج لعقود
Dialogue: 0,0:17:22.44,0:17:24.64,Default,,0000,0000,0000,,أشعره ذلك بالارتياح
Dialogue: 0,0:17:24.94,0:17:29.61,Default,,0000,0000,0000,,لكن وقع أمرٌ خارج التوقعات\Nبعد نصف شهر
Dialogue: 0,0:17:29.98,0:17:33.40,Default,,0000,0000,0000,,أُلغيت عمليات البناء فجأةً
Dialogue: 0,0:17:33.40,0:17:37.57,Default,,0000,0000,0000,,ماذا؟! أي سيهدمونه؟
Dialogue: 0,0:17:37.57,0:17:41.94,Default,,0000,0000,0000,,ذلك مُحتمل، وستُكتشف الجثّة فوراً
Dialogue: 0,0:17:41.94,0:17:44.82,Default,,0000,0000,0000,,!أنا أشعر بالقلق فلا أستطيع النوم ليلاً
Dialogue: 0,0:17:44.82,0:17:46.79,Default,,0000,0000,0000,,!لأراقب المكان بالمنظار
Dialogue: 0,0:17:47.44,0:17:50.98,Default,,0000,0000,0000,,لذا توقّف واتانوكي-سان عن مغادرة المنزل
Dialogue: 0,0:17:50.98,0:17:53.28,Default,,0000,0000,0000,,باستثناء مواعيده في المشفى
Dialogue: 0,0:17:53.28,0:17:57.76,Default,,0000,0000,0000,,وكان يراقب محيط البناية بهذا المنظار
Dialogue: 0,0:17:59.55,0:18:04.03,Default,,0000,0000,0000,,!لكنّي لا أستطيع دخول محيطها
Dialogue: 0,0:18:04.03,0:18:09.56,Default,,0000,0000,0000,,يحيطها السياج، وكانت البوابة مقفلة تلك الليلة
Dialogue: 0,0:18:09.56,0:18:12.11,Default,,0000,0000,0000,,تتكلّم كما لو أنّك\Nتحرّيت ذلك سلفاً
Dialogue: 0,0:18:13.69,0:18:15.61,Default,,0000,0000,0000,,!لكن توجد فتحة في الخلف
Dialogue: 0,0:18:15.61,0:18:18.36,Default,,0000,0000,0000,,كلا، نشأت تلك مؤخراً
Dialogue: 0,0:18:18.36,0:18:20.95,Default,,0000,0000,0000,,كونان، كيف دخل هناك؟
Dialogue: 0,0:18:21.32,0:18:24.28,Default,,0000,0000,0000,,يعرف كودا-سان إجابة ذلك
Dialogue: 0,0:18:24.28,0:18:28.17,Default,,0000,0000,0000,,كان الأمر محض مصادفة، لكنّه استعمل الطريقة نفسها
Dialogue: 0,0:18:29.78,0:18:30.88,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:18:30.88,0:18:32.15,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:18:32.15,0:18:32.98,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:18:32.98,0:18:34.21,Default,,0000,0000,0000,,!شبكة التصريف
Dialogue: 0,0:18:36.11,0:18:40.73,Default,,0000,0000,0000,,كانت هناك شاحنة تابعة لعمليات البناء\Nمركونة في الزقاق تلك الليلة
Dialogue: 0,0:18:40.73,0:18:44.64,Default,,0000,0000,0000,,فلم يكن ممكناً رؤية مدخل هذا المنزل\Nالخلفيّ من الشارع الرئيسيّ
Dialogue: 0,0:19:23.86,0:19:27.60,Default,,0000,0000,0000,,!فهمت! شبكة التصريف مرتبطة هنا
Dialogue: 0,0:19:27.90,0:19:32.78,Default,,0000,0000,0000,,ليلة الثامن من مايو، كانت هناك عمليات\Nبناء كبيرة على الشارع الرئيسيّ
Dialogue: 0,0:19:32.78,0:19:37.91,Default,,0000,0000,0000,,فصوت حفر بمجرفة لن يثير غرابة أيّ أحد
Dialogue: 0,0:19:37.91,0:19:39.87,Default,,0000,0000,0000,,باستثناء موتشيدا-سان بالطبع
Dialogue: 0,0:19:40.58,0:19:42.58,Default,,0000,0000,0000,,ألستُ محقّاً يا واتانوكي-سان؟
Dialogue: 0,0:19:45.33,0:19:47.16,Default,,0000,0000,0000,,!أيّها الوغد
Dialogue: 0,0:19:47.16,0:19:49.08,Default,,0000,0000,0000,,!لمَ قتلتَ ساناي؟
Dialogue: 0,0:19:49.08,0:19:49.84,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:19:50.28,0:19:52.09,Default,,0000,0000,0000,,!أ-ألديكم دليل؟
Dialogue: 0,0:19:53.70,0:19:57.68,Default,,0000,0000,0000,,!كلّ هذا مجرّد افتراضات لذاك الصبيّ
Dialogue: 0,0:19:58.08,0:20:01.64,Default,,0000,0000,0000,,وماذا إذا استطعت دخول\N!ساحة المواقف هذه؟
Dialogue: 0,0:20:01.91,0:20:06.10,Default,,0000,0000,0000,,كان بإمكان أيّ أحد الدخول هنا\N!باستعمال تلك الطريقة
Dialogue: 0,0:20:06.10,0:20:09.53,Default,,0000,0000,0000,,كما أين الجثّة بالأصل؟
Dialogue: 0,0:20:09.53,0:20:11.07,Default,,0000,0000,0000,,هنا
Dialogue: 0,0:20:11.28,0:20:15.78,Default,,0000,0000,0000,,جثّة أخت كودا-سان هي أسفل هذه الزهرة
Dialogue: 0,0:20:15.99,0:20:17.41,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:19.53,0:20:22.91,Default,,0000,0000,0000,,لكن يا كونان-كن، كيف تعرف أنّها هنا؟
Dialogue: 0,0:20:22.91,0:20:23.91,Default,,0000,0000,0000,,انظروا
Dialogue: 0,0:20:26.62,0:20:27.78,Default,,0000,0000,0000,,...قسموس
Dialogue: 0,0:20:27.78,0:20:33.59,Default,,0000,0000,0000,,فهمت! تلقّت أختك بذور قسموس\N!من أحد زملائها ذاك اليوم
Dialogue: 0,0:20:33.95,0:20:37.93,Default,,0000,0000,0000,,أي سقطت تلك البذور وتبرعمت\N...بعدما دُفنت إذاً
Dialogue: 0,0:20:46.49,0:20:49.19,Default,,0000,0000,0000,,لم أنو قتلها
Dialogue: 0,0:20:49.74,0:20:54.00,Default,,0000,0000,0000,,...فقدتُ أعصابي تلك الليلة عندما رفضت تعويضي
Dialogue: 0,0:20:56.65,0:20:59.49,Default,,0000,0000,0000,,!صفقتنا ملغيّة إذاً
Dialogue: 0,0:21:00.62,0:21:01.87,Default,,0000,0000,0000,,ارحلي
Dialogue: 0,0:21:01.87,0:21:05.12,Default,,0000,0000,0000,,!ا-انتظر رجاءً! واتانوكي-سان
Dialogue: 0,0:21:08.78,0:21:09.87,Default,,0000,0000,0000,,!واتانوكي-سان
Dialogue: 0,0:21:09.87,0:21:11.21,Default,,0000,0000,0000,,!اخرسي
Dialogue: 0,0:21:27.37,0:21:28.29,Default,,0000,0000,0000,,...ساناي
Dialogue: 0,0:21:33.87,0:21:40.91,Default,,0000,0000,0000,,في تلك الليلة، وُجدت جثّة الأخت\Nأسفل شتلة القسموس
Dialogue: 0,0:23:10.96,0:23:17.59,Default,,0000,0000,0000,,لاحقاً، تمّ إيقاف تنفيذ حكم جريمة\Nالسطو لكودا-سان، وأُطلق سراحه
Dialogue: 0,0:23:18.56,0:23:23.81,Default,,0000,0000,0000,,قرّر العودة إلى بلدته الأمّ مع شتلة القسموس
Dialogue: 0,0:23:23.81,0:23:26.14,Default,,0000,0000,0000,,،لن ترجع أخته
Dialogue: 0,0:23:26.14,0:23:29.85,Default,,0000,0000,0000,,لكنّه قال أنّه سيعتني بهذه الشتلة\Nكما لو كانت هي
Dialogue: 0,0:23:31.18,0:23:34.96,Default,,0000,0000,0000,,!وهكذا حُلّ لغز قضيّة فضائيّ الخلد
Dialogue: 0,0:23:36.83,0:23:38.81,Default,,0000,0000,0000,,...بالمناسبة يا كونان-كن
Dialogue: 0,0:23:38.81,0:23:41.60,Default,,0000,0000,0000,,ماذا يا ران-نيتشان؟
Dialogue: 0,0:23:41.86,0:23:44.74,Default,,0000,0000,0000,,قلتَ أنّك كلمّت شينتشي على الهاتف، صحيح؟
Dialogue: 0,0:23:45.21,0:23:46.52,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:23:46.52,0:23:47.20,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:23:47.81,0:23:50.60,Default,,0000,0000,0000,,أخبرني، أين هو؟
Dialogue: 0,0:23:50.87,0:23:52.73,Default,,0000,0000,0000,,...أ-أنا، ذلك
Dialogue: 0,0:23:52.73,0:23:54.71,Default,,0000,0000,0000,,!أجبني يا كونان-كن
Dialogue: 0,0:23:56.20,0:23:58.52,Default,,0000,0000,0000,,!إنّها مخيفة أكثر من فضائيّ الخلد
Dialogue: 0,0:24:06.03,0:24:07.69,Default,,0000,0000,0000,,انتبهي، هناك سيّارة قادمة
Dialogue: 0,0:24:10.37,0:24:12.31,Default,,0000,0000,0000,,...أيومي! تبّاً
Dialogue: 0,0:24:18.88,0:24:23.61,Default,,0000,0000,0000,,!من قتل إيشيكورا-سان كانت أنت يا شيشيدو-سان
Dialogue: 0,0:24:25.57,0:24:31.57,On Top,,0000,0000,0000,,قضيّة ملاحقة فرقة التحرّي الكبيرة
Dialogue: 0,0:24:27.14,0:24:28.89,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:28.89,0:24:31.70,Default,,0000,0000,0000,,قضيّة ملاحقة فرقة التحرّي الكبيرة
Dialogue: 0,0:24:47.50,0:24:50.35,Default,,0000,0000,0000,,سويّاً، تلميح الحلقة القادمة
Dialogue: 0,0:24:50.35,0:24:51.59,Default,,0000,0000,0000,,وحل
Dialogue: 0,0:24:51.59,0:24:52.50,Default,,0000,0000,0000,,...الحلقة القادمة
Dialogue: 0,0:24:52.50,0:24:54.54,Default,,0000,0000,0000,,!إنّها غلطة غينتا-كن\N!فلتتحمّل المسؤولية
Dialogue: 0,0:24:54.54,0:24:55.48,Default,,0000,0000,0000,,!ما الذي فعلتَه؟
Dialogue: 0,0:24:55.48,0:24:57.48,Default,,0000,0000,0000,,!غينتا-كن في مأزق

