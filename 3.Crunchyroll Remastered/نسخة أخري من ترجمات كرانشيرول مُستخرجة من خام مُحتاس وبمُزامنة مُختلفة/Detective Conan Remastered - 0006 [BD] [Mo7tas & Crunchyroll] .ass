Dialogue: 0,0:00:00.59,0:00:02.13,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.13,0:00:05.00,Default,,0000,0000,0000,,أُجبر الطالب في الثانوية كودو شينتشي\Nعلى تجرّع عقار قلّص جسده
Dialogue: 0,0:00:05.10,0:00:06.37,Default,,0000,0000,0000,,لا يهمّ صغر بنيتي
Dialogue: 0,0:00:06.65,0:00:08.01,Default,,0000,0000,0000,,،فعقلي عقل مُتحرٍّ سابق عظيم
Dialogue: 0,0:00:08.01,0:00:09.38,Default,,0000,0000,0000,,ومهاراتي في الاستنتاج دقيقة
Dialogue: 0,0:00:09.38,0:00:11.01,Default,,0000,0000,0000,,!عندما يتعلق الأمر بالقضايا المستعصية
Dialogue: 0,0:00:11.46,0:00:13.01,Default,,0000,0000,0000,,لدينا قضيّة حُب في يوم الفالنتاين
Dialogue: 0,0:00:13.37,0:00:15.51,Default,,0000,0000,0000,,قد يكون هناك سُم في الشوكولاتة الحلوة
Dialogue: 0,0:01:46.17,0:01:52.01,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل الفالنتاين
Dialogue: 0,0:01:47.05,0:01:49.57,Default,,0000,0000,0000,,جريمة قتل الفالنتاين
Dialogue: 0,0:01:52.87,0:01:54.46,Default,,0000,0000,0000,,ماذا ستفعلين إذاً يا ران؟
Dialogue: 0,0:01:54.36,0:01:55.56,Default,,0000,0000,0000,,بخصوص ماذا؟
Dialogue: 0,0:01:55.56,0:01:58.31,Default,,0000,0000,0000,,!الشوكولاتة! ليوم الفالنتاين
Dialogue: 0,0:01:58.31,0:02:01.01,Default,,0000,0000,0000,,!الحدث الكبير الذي يأتي مرّةً في العام
Dialogue: 0,0:02:01.01,0:02:05.73,Default,,0000,0000,0000,,!علينا استعمال الشوكولاتة لأسر قلوب الرجال
Dialogue: 0,0:02:06.26,0:02:08.18,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:02:09.88,0:02:11.72,Default,,0000,0000,0000,,كأنّك شاردة الذهن
Dialogue: 0,0:02:12.13,0:02:14.63,Default,,0000,0000,0000,,ماذا؟ حقّاً؟
Dialogue: 0,0:02:14.63,0:02:17.46,Default,,0000,0000,0000,,صحيح! ماذا عنه؟
Dialogue: 0,0:02:17.46,0:02:18.33,Default,,0000,0000,0000,,عنه؟
Dialogue: 0,0:02:18.33,0:02:19.33,Default,,0000,0000,0000,,تعرفين
Dialogue: 0,0:02:19.33,0:02:24.20,Default,,0000,0000,0000,,!الاثنان اللذان تقرّبا منا في المقهى يوم الأحد
Dialogue: 0,0:02:24.20,0:02:25.12,Default,,0000,0000,0000,,ألا تذكرين؟
Dialogue: 0,0:02:25.12,0:02:28.23,Default,,0000,0000,0000,,!قالا أنّهما طالبان في كليّة الطب في جامعة بيكا
Dialogue: 0,0:02:28.23,0:02:31.94,Default,,0000,0000,0000,,!ميناغاوا-سان تحديداً! إنّه رائع جدّاً
Dialogue: 0,0:02:31.94,0:02:34.73,Default,,0000,0000,0000,,الآخر كان واكاماتسو-سان، صحيح؟
Dialogue: 0,0:02:35.40,0:02:37.65,Default,,0000,0000,0000,,!إنّه مثالي لك يا ران
Dialogue: 0,0:02:37.65,0:02:40.43,Default,,0000,0000,0000,,فكان مهتماً بك وفقما بدا
Dialogue: 0,0:02:47.10,0:02:50.13,Default,,0000,0000,0000,,!مرحباً يا ران-سان! كنت أبحث عنك
Dialogue: 0,0:02:50.13,0:02:52.01,Default,,0000,0000,0000,,!توقيت ممتاز
Dialogue: 0,0:02:52.01,0:02:53.52,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:02:53.52,0:02:56.73,Default,,0000,0000,0000,,!سنحلّ أيّ قضية مهما كانت صعوبتها
Dialogue: 0,0:02:57.17,0:03:01.08,Default,,0000,0000,0000,,!إن كانت لديكم أيّ مشاكل، فاتركوها لنا
Dialogue: 0,0:03:03.45,0:03:06.77,Default,,0000,0000,0000,,!كونان! توقف عن الكسل وساعدنا
Dialogue: 0,0:03:07.99,0:03:11.28,Default,,0000,0000,0000,,أنا مُتحرّي الثانوية كودو شينتشي
Dialogue: 0,0:03:11.28,0:03:13.21,Default,,0000,0000,0000,,لا وقت لديّ لألعب مع أطفال
Dialogue: 0,0:03:17.49,0:03:18.47,Default,,0000,0000,0000,,ران
Dialogue: 0,0:03:18.73,0:03:23.18,Default,,0000,0000,0000,,ران-سان، أتيتُ اليوم لأطلب منك شيئاً مهماً
Dialogue: 0,0:03:24.18,0:03:25.52,Default,,0000,0000,0000,,!ران-سان
Dialogue: 0,0:03:25.93,0:03:28.10,Default,,0000,0000,0000,,أتيتُ لدعوتك في موعد
Dialogue: 0,0:03:28.10,0:03:29.89,Default,,0000,0000,0000,,!مـ-موعد؟
Dialogue: 0,0:03:30.59,0:03:34.26,Default,,0000,0000,0000,,هلّا رافقتني لحفلة فالنتاين الغد؟
Dialogue: 0,0:03:34.26,0:03:36.17,Default,,0000,0000,0000,,حفلة فالنتاين؟
Dialogue: 0,0:03:36.17,0:03:39.89,Default,,0000,0000,0000,,أجل، يُفترض للفتاة أن تعطي شوكولاتة\Nللفتى الذي يعجبها
Dialogue: 0,0:03:39.89,0:03:42.79,Default,,0000,0000,0000,,،وإن كان يبادلها الشعور
Dialogue: 0,0:03:42.79,0:03:44.83,Default,,0000,0000,0000,,يأكل الشوكولاتة في لحظتها
Dialogue: 0,0:03:44.83,0:03:47.81,Default,,0000,0000,0000,,إذاً، هل سيأتي ميناغاوا-سان أيضاً؟
Dialogue: 0,0:03:48.49,0:03:51.27,Default,,0000,0000,0000,,بالطبع، فالحفلة في منزله
Dialogue: 0,0:03:51.95,0:03:55.78,Default,,0000,0000,0000,,!سنذهب! سأذهب وران معاً حتماً
Dialogue: 0,0:03:55.78,0:03:56.73,Default,,0000,0000,0000,,!سونوكو
Dialogue: 0,0:03:57.03,0:03:58.68,Default,,0000,0000,0000,,!حـ-حقاً؟
Dialogue: 0,0:03:58.68,0:04:02.43,Default,,0000,0000,0000,,!رائع! شكراً لكما
Dialogue: 0,0:04:02.77,0:04:06.77,Default,,0000,0000,0000,,حفلة فالنتاين؟ يا للهراء
Dialogue: 0,0:04:07.19,0:04:09.80,Default,,0000,0000,0000,,سآتي لأخذكما غداً إذاً
Dialogue: 0,0:04:11.55,0:04:13.09,Default,,0000,0000,0000,,!وداعاً
Dialogue: 0,0:04:13.84,0:04:16.59,Default,,0000,0000,0000,,!لمَ قلتِ ذلك دون استشارتي؟
Dialogue: 0,0:04:16.59,0:04:19.17,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:04:19.17,0:04:22.00,Default,,0000,0000,0000,,أنتِ تحبين شينتشي-كن، صحيح؟
Dialogue: 0,0:04:22.00,0:04:23.21,Default,,0000,0000,0000,,تخلصين له
Dialogue: 0,0:04:23.21,0:04:25.71,Default,,0000,0000,0000,,"وتعطين بقية الشبّان معاملة "كلا، شكراً لك
Dialogue: 0,0:04:25.71,0:04:28.68,Default,,0000,0000,0000,,لا تكوني حمقاء! من قد يُحب\N!مهووس التحرّي ذاك؟
Dialogue: 0,0:04:30.99,0:04:32.14,Default,,0000,0000,0000,,أعتذر لذلك
Dialogue: 0,0:04:32.41,0:04:35.41,Default,,0000,0000,0000,,ستذهبين إذاً لحفلة الفالنتاين، صحيح؟
Dialogue: 0,0:04:35.41,0:04:36.78,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:04:36.78,0:04:38.10,Default,,0000,0000,0000,,!رائع! حُسم الأمر
Dialogue: 0,0:04:39.90,0:04:42.06,Default,,0000,0000,0000,,!شاهد فقط يا ميناغاوا كاتسوهيكو
Dialogue: 0,0:04:42.06,0:04:47.56,Default,,0000,0000,0000,,سأستعمل الشوكولاتة خاصتي لأذيب\N!حتّى نخاع عظامك
Dialogue: 0,0:04:47.94,0:04:50.51,Default,,0000,0000,0000,,...سـ-سونوكو تشتعل
Dialogue: 0,0:04:52.98,0:04:57.73,Default,,0000,0000,0000,,...أنا المتحرّي العظيم موري كوغورو
Dialogue: 0,0:05:00.79,0:05:02.92,Default,,0000,0000,0000,,ما الذي تفعلينه يا ران-نيتشان؟
Dialogue: 0,0:05:02.92,0:05:04.17,Default,,0000,0000,0000,,لا شيء مهم
Dialogue: 0,0:05:04.17,0:05:06.46,Default,,0000,0000,0000,,!هذه رائحة شوكولاتة
Dialogue: 0,0:05:06.46,0:05:08.60,Default,,0000,0000,0000,,غداً يوم الفالنتاين
Dialogue: 0,0:05:09.16,0:05:12.56,Default,,0000,0000,0000,,هناك من تعطينه الشوكولاتة إذاً؟
Dialogue: 0,0:05:13.15,0:05:14.57,Default,,0000,0000,0000,,!يا للفظاظة
Dialogue: 0,0:05:14.57,0:05:17.40,Default,,0000,0000,0000,,لم أكن لأعدّ شوكولاتة إن لم\Nيكن هناك من أعطيه
Dialogue: 0,0:05:17.85,0:05:22.60,Default,,0000,0000,0000,,صحيح، قد يعود شينتشي-نيتشان
Dialogue: 0,0:05:22.97,0:05:24.47,Default,,0000,0000,0000,,شينتشي؟
Dialogue: 0,0:05:24.47,0:05:26.72,Default,,0000,0000,0000,,صحيح كان هناك شخص بهذا الاسم
Dialogue: 0,0:05:29.17,0:05:30.72,Default,,0000,0000,0000,,لحظة، لحظة
Dialogue: 0,0:05:35.59,0:05:37.15,Default,,0000,0000,0000,,سأغادر الآن
Dialogue: 0,0:05:37.74,0:05:40.93,Default,,0000,0000,0000,,اذهبي واصطادي رجلاً ثرياً
Dialogue: 0,0:05:41.41,0:05:44.69,Default,,0000,0000,0000,,هذا غريب، كونان-كن ليس هنا أيضاً
Dialogue: 0,0:05:44.69,0:05:47.04,Default,,0000,0000,0000,,ما الذي تفعلينه يا ران؟
Dialogue: 0,0:05:47.04,0:05:48.39,Default,,0000,0000,0000,,!سنغادر دونك
Dialogue: 0,0:05:49.48,0:05:53.07,Default,,0000,0000,0000,,!لا خيار أمامي سوى معرفة مقصد تلك الشوكولاتة
Dialogue: 0,0:05:54.73,0:05:57.35,Default,,0000,0000,0000,,!آسفة على التأخير
Dialogue: 0,0:05:57.35,0:05:58.81,Default,,0000,0000,0000,,!انطلاق
Dialogue: 0,0:06:04.47,0:06:05.94,Default,,0000,0000,0000,,!نخبكم
Dialogue: 0,0:06:11.46,0:06:15.13,Default,,0000,0000,0000,,لنبدأ إذاً بتقديم أعضاء نادينا للتنس بجامعة بيكا
Dialogue: 0,0:06:15.13,0:06:18.58,Default,,0000,0000,0000,,لضيفتينا، موري ران-سان وسوزوكي سونوكو-سان
Dialogue: 0,0:06:18.58,0:06:20.60,Default,,0000,0000,0000,,أنت أولاً يا ميناغاوا
Dialogue: 0,0:06:20.87,0:06:24.20,Default,,0000,0000,0000,,حسناً، أنا الكابتن ميناغاوا كاتسوهيكو
Dialogue: 0,0:06:24.20,0:06:26.04,Default,,0000,0000,0000,,يسرّني لقاؤكما
Dialogue: 0,0:06:26.04,0:06:27.50,Default,,0000,0000,0000,,!حقّاً؟
Dialogue: 0,0:06:27.50,0:06:29.01,Default,,0000,0000,0000,,!يسرني ذلك أيضاً
Dialogue: 0,0:06:29.40,0:06:31.32,Default,,0000,0000,0000,,حسناً، حسناً، لنهدأ
Dialogue: 0,0:06:31.32,0:06:33.19,Default,,0000,0000,0000,,أنا سيكيا كاوري
Dialogue: 0,0:06:33.19,0:06:36.23,Default,,0000,0000,0000,,أنتِ صغيرة يا سونوكو-سان لذا لا تندفعي هكذا
Dialogue: 0,0:06:36.56,0:06:38.81,Default,,0000,0000,0000,,إنّها تغار مني
Dialogue: 0,0:06:38.81,0:06:43.48,Default,,0000,0000,0000,,تتمتع بالجمال لكن غيورة جدّاً مع ذلك
Dialogue: 0,0:06:44.48,0:06:46.98,Default,,0000,0000,0000,,دورك تالياً يا ناوميتشي
Dialogue: 0,0:06:48.63,0:06:51.39,Default,,0000,0000,0000,,يا إلهي، أنت عبوس حقّاً
Dialogue: 0,0:06:54.01,0:06:56.81,Default,,0000,0000,0000,,أنا واتانابي يوشيمي، سررت بلقائكما
Dialogue: 0,0:06:57.13,0:06:58.30,Default,,0000,0000,0000,,وأنا أخيراً
Dialogue: 0,0:06:59.16,0:07:05.35,Default,,0000,0000,0000,,،القويّ، لكن المرهف ولطيف الإحساس\N!واكاماتسو توشيهيدي
Dialogue: 0,0:07:08.61,0:07:10.65,Default,,0000,0000,0000,,ما خطب ران؟
Dialogue: 0,0:07:10.65,0:07:12.72,Default,,0000,0000,0000,,إنها تتسلى حقّاً
Dialogue: 0,0:07:13.74,0:07:15.28,Default,,0000,0000,0000,,أعتذر على الإطالة
Dialogue: 0,0:07:17.03,0:07:19.64,Default,,0000,0000,0000,,ها هو طبق اليوم الرئيسي
Dialogue: 0,0:07:20.23,0:07:23.52,Default,,0000,0000,0000,,!شكراً لك يا عمّة
Dialogue: 0,0:07:23.52,0:07:25.60,Default,,0000,0000,0000,,!أنتِ أم ميناغاوا-سان؟
Dialogue: 0,0:07:25.60,0:07:26.60,Default,,0000,0000,0000,,!شابة
Dialogue: 0,0:07:27.10,0:07:29.93,Default,,0000,0000,0000,,!تجيدين اختيار الكلمات
Dialogue: 0,0:07:30.68,0:07:33.93,Default,,0000,0000,0000,,!آنسة! لنلعب معاً
Dialogue: 0,0:07:34.22,0:07:37.35,Default,,0000,0000,0000,,!سوسومو! اذهب لغرفتك! أنت تفسد الحفلة
Dialogue: 0,0:07:37.96,0:07:40.79,Default,,0000,0000,0000,,أنت أخو ميناغاوا-سان الصغير؟
Dialogue: 0,0:07:40.79,0:07:41.39,Default,,0000,0000,0000,,!ظريف
Dialogue: 0,0:07:41.87,0:07:44.92,Default,,0000,0000,0000,,لكنه لا يشبهك حقاً، صحيح؟
Dialogue: 0,0:07:47.25,0:07:51.57,Default,,0000,0000,0000,,!إلى متى ستتركني ران هنا؟
Dialogue: 0,0:07:51.57,0:07:53.32,Default,,0000,0000,0000,,!أشعر بالبرد والجوع
Dialogue: 0,0:07:56.95,0:07:58.55,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:07:58.90,0:08:01.52,Default,,0000,0000,0000,,!كونان-كن! ماذا تفعل هنا؟
Dialogue: 0,0:08:04.90,0:08:09.05,Default,,0000,0000,0000,,!كنتُ في طريقي لمنزل صديق، لكن تهت
Dialogue: 0,0:08:09.68,0:08:11.72,Default,,0000,0000,0000,,أتعرفين ذاك الفتى؟
Dialogue: 0,0:08:11.72,0:08:16.68,Default,,0000,0000,0000,,أ-أجل، يسكن في منزلنا مؤخراً لظروف ما
Dialogue: 0,0:08:16.68,0:08:19.26,Default,,0000,0000,0000,,الجوّ بارد خارجاً، ادخل
Dialogue: 0,0:08:19.83,0:08:21.72,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:08:23.83,0:08:27.38,Default,,0000,0000,0000,,حسناً، أظن على أحد تقديم عرض الآن
Dialogue: 0,0:08:27.38,0:08:29.01,Default,,0000,0000,0000,,ناوميتشي، ابدأ أنت
Dialogue: 0,0:08:31.41,0:08:35.03,Default,,0000,0000,0000,,!ألم تسمعني يا ناوميتشي؟! ارفع إيقاع هذه الحفلة
Dialogue: 0,0:08:35.03,0:08:37.44,Default,,0000,0000,0000,,لستُ بارعاً في هذه الأشياء
Dialogue: 0,0:08:37.77,0:08:40.81,Default,,0000,0000,0000,,!ماذا؟ أترفض الإصغاء لكلامي؟
Dialogue: 0,0:08:43.52,0:08:46.06,Default,,0000,0000,0000,,مجرّد النظر لوجهك يشعرني بالغثيان
Dialogue: 0,0:08:47.85,0:08:50.93,Default,,0000,0000,0000,,ألا يعاني ميناغاوا-سان من مشكلة في سلوكه؟
Dialogue: 0,0:08:50.93,0:08:53.35,Default,,0000,0000,0000,,يليق بالفتيان أن يكونوا هكذا قليلاً
Dialogue: 0,0:08:53.35,0:08:55.22,Default,,0000,0000,0000,,على أي حال، هل أحضرتِ الشوكولاتة؟
Dialogue: 0,0:08:55.22,0:08:56.68,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:56.68,0:09:00.72,Default,,0000,0000,0000,,انظروا فقط! سيسقط ميناغاوا-سان\N!بمجرد أكله للشوكولاتة خاصتي
Dialogue: 0,0:09:01.54,0:09:03.98,Default,,0000,0000,0000,,أوضعتِ بها سمّاً؟
Dialogue: 0,0:09:04.84,0:09:07.25,Default,,0000,0000,0000,,...سأقدّم أنا سوزوكي سونوكو
Dialogue: 0,0:09:09.66,0:09:12.33,Default,,0000,0000,0000,,إذاً، لا بدّ أن الفتيات الجميلات مثلك يا ران-سان
Dialogue: 0,0:09:12.33,0:09:14.49,Default,,0000,0000,0000,,يمتلكن هوايات مثل مراسم الشاي وترتيب الأزهار، صحيح؟
Dialogue: 0,0:09:14.49,0:09:16.03,Default,,0000,0000,0000,,الكاراتيه
Dialogue: 0,0:09:16.03,0:09:19.18,Default,,0000,0000,0000,,كيف تمارس ران-سان شيئاً همجياً كهذا؟
Dialogue: 0,0:09:19.18,0:09:20.35,Default,,0000,0000,0000,,الكاراتيه
Dialogue: 0,0:09:20.57,0:09:23.82,Default,,0000,0000,0000,,!مُحال لامرأة جميلة وفاتنة أن تهوى الكاراتيه
Dialogue: 0,0:09:30.14,0:09:30.93,Default,,0000,0000,0000,,كاوري
Dialogue: 0,0:09:31.31,0:09:34.77,Default,,0000,0000,0000,,كفّ عن معاملة ناوميتشي بذاك الأسلوب
Dialogue: 0,0:09:35.64,0:09:39.92,Default,,0000,0000,0000,,يغيظني عندما تأسفين عليه أكثر مني
Dialogue: 0,0:09:39.92,0:09:42.88,Default,,0000,0000,0000,,أتقصد أنّك أسوأ حالاً؟
Dialogue: 0,0:09:42.88,0:09:43.56,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:43.84,0:09:45.80,Default,,0000,0000,0000,,لقد تغيّرت
Dialogue: 0,0:09:45.80,0:09:47.76,Default,,0000,0000,0000,,أصبحت متهوراً مذ آنذاك
Dialogue: 0,0:09:48.12,0:09:49.30,Default,,0000,0000,0000,,!ما الذي تعرفينه؟
Dialogue: 0,0:09:49.30,0:09:51.83,Default,,0000,0000,0000,,!أعرف! فقد كبرنا معاً
Dialogue: 0,0:09:51.83,0:09:53.43,Default,,0000,0000,0000,,!تمالك نفسك
Dialogue: 0,0:09:56.24,0:09:58.57,Default,,0000,0000,0000,,هل ستقبل هذه؟
Dialogue: 0,0:10:00.73,0:10:03.48,Default,,0000,0000,0000,,توقفي، أريد أن نبقى أصدقاءً فقط
Dialogue: 0,0:10:04.44,0:10:05.73,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:10:05.73,0:10:07.52,Default,,0000,0000,0000,,...يوشيمي إذاً هي من
Dialogue: 0,0:10:13.02,0:10:14.27,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:10:21.71,0:10:25.59,Default,,0000,0000,0000,,...لا بأس، صحيح؟ فهي يدها فقط
Dialogue: 0,0:10:25.59,0:10:26.65,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:10:26.65,0:10:28.43,Default,,0000,0000,0000,,!عليّ القيام بالخطوة الأولى
Dialogue: 0,0:10:35.29,0:10:39.18,Default,,0000,0000,0000,,...يا لليدين الجميلتين
Dialogue: 0,0:10:39.18,0:10:40.39,Default,,0000,0000,0000,,!ران-سان
Dialogue: 0,0:10:45.03,0:10:46.94,Default,,0000,0000,0000,,!ابتعد
Dialogue: 0,0:10:46.94,0:10:48.05,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:10:48.05,0:10:49.64,Default,,0000,0000,0000,,!ران-سان
Dialogue: 0,0:10:50.09,0:10:50.73,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:10:50.73,0:10:52.06,Default,,0000,0000,0000,,!ابتعد عنها
Dialogue: 0,0:10:53.73,0:10:55.19,Default,,0000,0000,0000,,!أيّها الوغد
Dialogue: 0,0:10:55.19,0:10:56.90,Default,,0000,0000,0000,,!لا تقترب من ران-نيتشان
Dialogue: 0,0:10:58.22,0:10:59.60,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:10:59.92,0:11:02.72,Default,,0000,0000,0000,,سوسومو! كم مرّة عليّ إخبارك؟
Dialogue: 0,0:11:02.72,0:11:06.69,Default,,0000,0000,0000,,!لا حلويات! لم يُشف تسوسك بعد
Dialogue: 0,0:11:07.13,0:11:10.71,Default,,0000,0000,0000,,لكنّ كاوري-نيتشان أعطتني إياها
Dialogue: 0,0:11:18.61,0:11:19.85,Default,,0000,0000,0000,,كاوري
Dialogue: 0,0:11:22.37,0:11:23.89,Default,,0000,0000,0000,,كان كاتسوهيكو، صحيح؟
Dialogue: 0,0:11:23.89,0:11:25.44,Default,,0000,0000,0000,,أساء لك بشيء ما، صحيح؟
Dialogue: 0,0:11:25.44,0:11:27.02,Default,,0000,0000,0000,,!الأمر لا يخصك
Dialogue: 0,0:11:27.02,0:11:29.10,Default,,0000,0000,0000,,!كاتسوهيكو مجرد حثالة
Dialogue: 0,0:11:29.10,0:11:32.91,Default,,0000,0000,0000,,لا سبب ليؤذيك هكذا مهما كان الأمر
Dialogue: 0,0:11:32.91,0:11:34.56,Default,,0000,0000,0000,,!دعني وشأني فقط
Dialogue: 0,0:11:36.45,0:11:38.59,Default,,0000,0000,0000,,!كاتسوهيكو الوغد
Dialogue: 0,0:11:42.06,0:11:44.25,Default,,0000,0000,0000,,!أنتَ لها يا ميناغاوا-سان
Dialogue: 0,0:11:46.79,0:11:50.14,Default,,0000,0000,0000,,تنقصك 10 سنين لتتحداني يا كاتسوهيكو
Dialogue: 0,0:11:51.77,0:11:54.79,Default,,0000,0000,0000,,للجميع شيء واحد يبرعون فيه على الأقل
Dialogue: 0,0:11:54.79,0:11:59.47,Default,,0000,0000,0000,,لا بد أنّ مرافقة كتلة عضلات فارغة العقل\Nمثله تضنيك يا ران-سان
Dialogue: 0,0:11:59.98,0:12:01.89,Default,,0000,0000,0000,,!ميناغاوا! أتريد الشجار؟
Dialogue: 0,0:12:02.94,0:12:04.81,Default,,0000,0000,0000,,أقول الواقع فقط
Dialogue: 0,0:12:05.16,0:12:06.02,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:12:07.20,0:12:08.81,Default,,0000,0000,0000,,!أنت هكذا دائماً
Dialogue: 0,0:12:08.81,0:12:11.56,Default,,0000,0000,0000,,!لمَ لا تراعي مشاعر الآخرين قليلاً؟
Dialogue: 0,0:12:11.56,0:12:14.19,Default,,0000,0000,0000,,أي أن لديك مشاعر؟
Dialogue: 0,0:12:14.19,0:12:15.31,Default,,0000,0000,0000,,!أيّها الوغد
Dialogue: 0,0:12:15.31,0:12:17.06,Default,,0000,0000,0000,,حسناً، حسناً، يكفي شجاراً
Dialogue: 0,0:12:17.74,0:12:19.47,Default,,0000,0000,0000,,ما رأيكم بتهدئة آثار الشراب قليلاً؟
Dialogue: 0,0:12:20.51,0:12:21.76,Default,,0000,0000,0000,,!دعني
Dialogue: 0,0:12:23.09,0:12:24.80,Default,,0000,0000,0000,,...كاتسوهيكو
Dialogue: 0,0:12:24.80,0:12:26.90,Default,,0000,0000,0000,,!ماذا؟! هل ستعظينني أيضاً؟
Dialogue: 0,0:12:28.62,0:12:30.35,Default,,0000,0000,0000,,...لا أنوي أن
Dialogue: 0,0:12:30.91,0:12:34.15,Default,,0000,0000,0000,,!حسناً، لنتناول التحلية جميعاً
Dialogue: 0,0:12:34.15,0:12:37.91,Default,,0000,0000,0000,,!كنتُ بانتظاره! كعك أم ميناغاوا المنزلي
Dialogue: 0,0:12:37.91,0:12:39.41,Default,,0000,0000,0000,,آمل أن ينال إعجابكم
Dialogue: 0,0:12:39.41,0:12:41.45,Default,,0000,0000,0000,,!بالطبع! شكراً جزيلاً
Dialogue: 0,0:12:49.15,0:12:51.94,Default,,0000,0000,0000,,هل تلك الكعكة لذيذة يا آنسة؟
Dialogue: 0,0:12:51.94,0:12:54.18,Default,,0000,0000,0000,,أجل، الكعكة والقهوة لذيذة أيضاً
Dialogue: 0,0:13:00.68,0:13:01.31,Default,,0000,0000,0000,,!مُرّة
Dialogue: 0,0:13:02.35,0:13:04.81,Default,,0000,0000,0000,,لا تشرب كأسها
Dialogue: 0,0:13:04.81,0:13:06.69,Default,,0000,0000,0000,,هاك، تناول كعكاً
Dialogue: 0,0:13:10.27,0:13:13.13,Default,,0000,0000,0000,,لن تأكل كعكتك يا كاتسوهيكو؟
Dialogue: 0,0:13:13.13,0:13:15.69,Default,,0000,0000,0000,,كلا، أكره الحلويات
Dialogue: 0,0:13:17.66,0:13:19.75,Default,,0000,0000,0000,,ألا ترى أنك تدخن بإسراف؟
Dialogue: 0,0:13:19.75,0:13:20.97,Default,,0000,0000,0000,,عليك التخفيف
Dialogue: 0,0:13:21.74,0:13:23.66,Default,,0000,0000,0000,,!اخرسي! لا تنفكين تزعجينني
Dialogue: 0,0:13:26.14,0:13:28.40,Default,,0000,0000,0000,,يبدو أنّي ثملت قليلاً
Dialogue: 0,0:13:28.40,0:13:29.72,Default,,0000,0000,0000,,سأذهب لتنشق هواء طلق
Dialogue: 0,0:13:31.32,0:13:32.56,Default,,0000,0000,0000,,فارغة
Dialogue: 0,0:13:37.46,0:13:39.89,Default,,0000,0000,0000,,يمكنك أخذ سجائري
Dialogue: 0,0:13:49.88,0:13:52.84,Default,,0000,0000,0000,,يوشيمي معجبة به حقّاً
Dialogue: 0,0:13:52.84,0:13:55.21,Default,,0000,0000,0000,,ما الجذّاب في رجل مثله؟
Dialogue: 0,0:13:55.21,0:13:58.76,Default,,0000,0000,0000,,بالمناسبة، ألديك أيّ شوكولاتة لي يا ران-سان؟
Dialogue: 0,0:14:01.95,0:14:03.52,Default,,0000,0000,0000,,...كاتسوهيكو! إنّه
Dialogue: 0,0:14:09.44,0:14:11.69,Default,,0000,0000,0000,,!كاتسوهيكو! كاتسوهيكو
Dialogue: 0,0:14:11.69,0:14:13.28,Default,,0000,0000,0000,,!كاتسوهيكو
Dialogue: 0,0:14:15.03,0:14:16.30,Default,,0000,0000,0000,,!اتصلي بالشرطة والإسعاف
Dialogue: 0,0:14:16.30,0:14:16.90,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:14:16.90,0:14:19.60,Default,,0000,0000,0000,,!كاتسوهيكو
Dialogue: 0,0:14:22.06,0:14:23.35,Default,,0000,0000,0000,,...عمّة
Dialogue: 0,0:14:37.01,0:14:40.50,Default,,0000,0000,0000,,فارق كاتسوهيكو-سان الحياة قبل قليل
Dialogue: 0,0:14:40.50,0:14:43.13,Default,,0000,0000,0000,,سبب الوفاة مواد كيميائية زراعية\Nاُستعملت كسمّ طعام كما يبدو
Dialogue: 0,0:14:43.50,0:14:45.04,Default,,0000,0000,0000,,واتانابي يوشيمي-سان
Dialogue: 0,0:14:45.04,0:14:47.72,Default,,0000,0000,0000,,سقط بعدما أكل الشوكولاتة خاصتك بلحظات، صحيح؟
Dialogue: 0,0:14:48.57,0:14:49.31,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:14:53.36,0:14:57.43,Default,,0000,0000,0000,,إنّها قضية سهلة كما يبدو
Dialogue: 0,0:14:57.43,0:14:59.73,Default,,0000,0000,0000,,!ماذا تفعل هنا؟
Dialogue: 0,0:14:59.73,0:15:02.52,Default,,0000,0000,0000,,أجل! تلقّيت اتصالاً من ابنتي
Dialogue: 0,0:15:02.52,0:15:05.93,Default,,0000,0000,0000,,!وسارعت، المتحري العظيم موري كوغورو، لمسرح الجريمة
Dialogue: 0,0:15:05.93,0:15:09.64,Default,,0000,0000,0000,,!الفاعل... هو أنت
Dialogue: 0,0:15:09.97,0:15:13.67,Default,,0000,0000,0000,,!وضعتِ سمّاً في الشوكولاتة لقتل الضحية
Dialogue: 0,0:15:13.67,0:15:15.59,Default,,0000,0000,0000,,!الدافع كان عاطفياً
Dialogue: 0,0:15:15.59,0:15:18.43,Default,,0000,0000,0000,,!كلّ ما علينا هو التحقق من بقايا الشوكولاتة للإثبات
Dialogue: 0,0:15:19.25,0:15:22.25,Default,,0000,0000,0000,,!كلا! لم تكن أنا! لم تكن أنا
Dialogue: 0,0:15:24.04,0:15:25.40,Default,,0000,0000,0000,,!يوشيمي
Dialogue: 0,0:15:25.96,0:15:29.94,Default,,0000,0000,0000,,لا يُعقل أن تكون جريمةً بسيطة بحيث تكون هي القاتلة
Dialogue: 0,0:15:31.07,0:15:35.61,Default,,0000,0000,0000,,أكل الجميع نفس الطعام مع الضحية
Dialogue: 0,0:15:35.61,0:15:36.95,Default,,0000,0000,0000,,حتّى لو كان السوشي مسمماً
Dialogue: 0,0:15:36.95,0:15:39.06,Default,,0000,0000,0000,,يستحيل معرفة أيّ ما سيأكله الضحية بالضبط
Dialogue: 0,0:15:39.69,0:15:43.02,Default,,0000,0000,0000,,شرب الجميع القهوة من نفس الإبريق
Dialogue: 0,0:15:43.44,0:15:45.40,Default,,0000,0000,0000,,مما يترك... الكعكة؟
Dialogue: 0,0:15:45.94,0:15:48.27,Default,,0000,0000,0000,,كلا، لم يأكلها الضحية
Dialogue: 0,0:15:49.09,0:15:51.81,Default,,0000,0000,0000,,كلا، أكره الحلويات
Dialogue: 0,0:15:52.68,0:15:54.51,Default,,0000,0000,0000,,ما معنى هذا؟
Dialogue: 0,0:15:54.51,0:15:57.10,Default,,0000,0000,0000,,أكانت يوشيمي-سان القاتلة بالفعل؟
Dialogue: 0,0:16:02.08,0:16:03.65,Default,,0000,0000,0000,,!هـ-ها هي
Dialogue: 0,0:16:04.12,0:16:05.73,Default,,0000,0000,0000,,!عمّ
Dialogue: 0,0:16:06.25,0:16:07.36,Default,,0000,0000,0000,,كان هناك عقاب سجائر
Dialogue: 0,0:16:07.36,0:16:09.69,Default,,0000,0000,0000,,في مسرح الجريمة، صحيح؟
Dialogue: 0,0:16:10.20,0:16:11.45,Default,,0000,0000,0000,,سجائر؟
Dialogue: 0,0:16:11.45,0:16:14.40,Default,,0000,0000,0000,,!صحيح! ذلك احتمال أيضاً
Dialogue: 0,0:16:16.70,0:16:19.60,Default,,0000,0000,0000,,هذا عقب لفافة التدخين المتروكة في مسرح الجريمة إذاً
Dialogue: 0,0:16:19.60,0:16:22.30,Default,,0000,0000,0000,,صحيح، هناك طرق لتسميم السجائر
Dialogue: 0,0:16:22.90,0:16:26.06,Default,,0000,0000,0000,,شهدتُ الأمر! عندما خرج ميناغاوا-سان
Dialogue: 0,0:16:26.06,0:16:27.81,Default,,0000,0000,0000,,!أعطاه ناوميتشي-سان سجائره
Dialogue: 0,0:16:33.05,0:16:35.86,Default,,0000,0000,0000,,...نا-ناوميتشي؟ أيمكن أنّك
Dialogue: 0,0:16:36.30,0:16:37.54,Default,,0000,0000,0000,,!أجب
Dialogue: 0,0:16:37.54,0:16:39.81,Default,,0000,0000,0000,,!يمكننا المعرفة إن حلّلنا عقب اللفافة
Dialogue: 0,0:16:42.75,0:16:44.77,Default,,0000,0000,0000,,!صـ-صحيح! أنا فعلتها
Dialogue: 0,0:16:45.29,0:16:47.74,Default,,0000,0000,0000,,!كنتُ أبغضه لوقت طويل
Dialogue: 0,0:16:47.74,0:16:50.37,Default,,0000,0000,0000,,!كاتسوهيكو اللعين كان يسخر مني دائماً
Dialogue: 0,0:16:50.37,0:16:53.24,Default,,0000,0000,0000,,!آذى كاوري فوق ذلك
Dialogue: 0,0:16:54.53,0:16:58.69,Default,,0000,0000,0000,,لذا سمّمتُ مُرشِّح السجائر
Dialogue: 0,0:16:58.69,0:16:59.77,Default,,0000,0000,0000,,مُرشِّح؟
Dialogue: 0,0:17:02.36,0:17:06.40,Default,,0000,0000,0000,,كلا، ليس هو المجرم
Dialogue: 0,0:17:06.40,0:17:10.02,Default,,0000,0000,0000,,!أمّي! ضرسي يؤلمني
Dialogue: 0,0:17:13.01,0:17:14.97,Default,,0000,0000,0000,,تغسل أكواب القهوة
Dialogue: 0,0:17:14.97,0:17:17.34,Default,,0000,0000,0000,,في وقت كهذا؟
Dialogue: 0,0:17:17.34,0:17:19.17,Default,,0000,0000,0000,,!هكذا إذاً، وجدتُها
Dialogue: 0,0:17:19.17,0:17:19.60,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:17:21.50,0:17:24.27,Default,,0000,0000,0000,,أسمّيه مسدس ساعة التخدير
Dialogue: 0,0:17:24.27,0:17:28.49,Default,,0000,0000,0000,,يمكنك تنويم أيّ شخص في مدى قريب فورياً
Dialogue: 0,0:17:39.15,0:17:42.15,Default,,0000,0000,0000,,...كان صوته رقم 59 كما أتذكر
Dialogue: 0,0:17:42.82,0:17:45.19,Default,,0000,0000,0000,,لحظة من فضلك حضرة المفتّش
Dialogue: 0,0:17:46.65,0:17:48.85,Default,,0000,0000,0000,,ليس القاتل
Dialogue: 0,0:17:49.26,0:17:53.06,Default,,0000,0000,0000,,!ما الذي تقوله؟ اعترف بنفسه
Dialogue: 0,0:17:53.29,0:17:58.00,Default,,0000,0000,0000,,نوى ارتكاب الجريمة حقّاً، لكنه فشل
Dialogue: 0,0:17:58.00,0:18:00.23,Default,,0000,0000,0000,,انظر لعقب اللفافة
Dialogue: 0,0:18:00.96,0:18:07.18,Default,,0000,0000,0000,,كانت كلّ سجائر الضحية الأخرى في المنزل بلا مُرشّح
Dialogue: 0,0:18:07.18,0:18:09.83,Default,,0000,0000,0000,,بعد أخذه السجائر من ناوميتشي
Dialogue: 0,0:18:09.83,0:18:12.99,Default,,0000,0000,0000,,أزال الضحية المُرشِّح قبل إشعالها كالمعتاد
Dialogue: 0,0:18:12.99,0:18:16.19,Default,,0000,0000,0000,,أي أنّه لم يدخن الجزء المسموم
Dialogue: 0,0:18:17.19,0:18:19.64,Default,,0000,0000,0000,,من كان الفاعل إذاً يا أبي؟
Dialogue: 0,0:18:20.11,0:18:22.27,Default,,0000,0000,0000,,...الفاعل الحقيقي
Dialogue: 0,0:18:25.94,0:18:28.14,Default,,0000,0000,0000,,كان أمّ كاتسوهيكو-كن
Dialogue: 0,0:18:28.88,0:18:29.81,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:18:29.81,0:18:32.27,Default,,0000,0000,0000,,!ما-ما الذي تقوله؟
Dialogue: 0,0:18:32.27,0:18:35.64,Default,,0000,0000,0000,,!كيف قتلته بالضبط؟
Dialogue: 0,0:18:35.64,0:18:37.51,Default,,0000,0000,0000,,بتسميم الطعام
Dialogue: 0,0:18:37.51,0:18:39.73,Default,,0000,0000,0000,,!أكل الجميع الطعام نفسه
Dialogue: 0,0:18:39.73,0:18:43.09,Default,,0000,0000,0000,,صحيح، لكن كاتسوهيكو فقط مات
Dialogue: 0,0:18:43.09,0:18:46.09,Default,,0000,0000,0000,,مات لأنّه لم يأكل
Dialogue: 0,0:18:46.09,0:18:48.43,Default,,0000,0000,0000,,ما قصدك لأنّه لم يأكل؟
Dialogue: 0,0:18:48.43,0:18:49.66,Default,,0000,0000,0000,,أيّتها العمة
Dialogue: 0,0:18:49.66,0:18:52.12,Default,,0000,0000,0000,,سمعت أنّك استشطتِ غضباً
Dialogue: 0,0:18:52.12,0:18:55.07,Default,,0000,0000,0000,,.عندما أكل سوسومو-كن شوكولاتة
Dialogue: 0,0:18:55.07,0:18:57.99,Default,,0000,0000,0000,,مع ذلك تركته يأكل كعكاً
Dialogue: 0,0:18:59.28,0:19:00.82,Default,,0000,0000,0000,,لمَ ذلك؟
Dialogue: 0,0:19:00.82,0:19:02.61,Default,,0000,0000,0000,,لأنّك وضعتِ سمّاً في القهوة
Dialogue: 0,0:19:02.61,0:19:05.48,Default,,0000,0000,0000,,وترياقاً في الكعك
Dialogue: 0,0:19:05.99,0:19:08.68,Default,,0000,0000,0000,,بعد رؤية سوسومو-كن يشرب القهوة
Dialogue: 0,0:19:08.68,0:19:13.19,Default,,0000,0000,0000,,هرعتِ لإعطائه كعكاً، أيّ الترياق
Dialogue: 0,0:19:13.19,0:19:17.84,Default,,0000,0000,0000,,كنتِ تعرفين أنّ كاتسوهيكو لن يأكل الكعك
Dialogue: 0,0:19:17.84,0:19:19.60,Default,,0000,0000,0000,,لأنّه يكره الحلويات
Dialogue: 0,0:19:20.09,0:19:22.65,Default,,0000,0000,0000,,وبعد تفكيرك بالخطّة
Dialogue: 0,0:19:22.65,0:19:27.06,Default,,0000,0000,0000,,قررتِ استغلال حبّه ليوشيمي-سان لصالحك
Dialogue: 0,0:19:27.06,0:19:32.06,Default,,0000,0000,0000,,عرفتِ أنّه سيأكل الشوكولاتة منها حتماً
Dialogue: 0,0:19:32.06,0:19:34.77,Default,,0000,0000,0000,,كنتِ أوّل من وصل للجثة
Dialogue: 0,0:19:34.77,0:19:38.14,Default,,0000,0000,0000,,وأخذتِ الشوكولاتة التي قضم منها
Dialogue: 0,0:19:38.14,0:19:41.48,Default,,0000,0000,0000,,واستبدلتها بالمسمومة
Dialogue: 0,0:19:41.48,0:19:45.23,Default,,0000,0000,0000,,بمحاولة إلقاء التهمة على يوشيمي-سان بالطبع
Dialogue: 0,0:19:46.20,0:19:48.35,Default,,0000,0000,0000,,!مجرد خيال! لا دليل لديك
Dialogue: 0,0:19:48.35,0:19:51.64,Default,,0000,0000,0000,,الدليل موجود، في أكواب القهوة
Dialogue: 0,0:19:51.64,0:19:55.77,Default,,0000,0000,0000,,غسلتِ الأكواب قبل قدوم الشرطة بأسرع ما يمكنك
Dialogue: 0,0:19:56.48,0:19:58.09,Default,,0000,0000,0000,,مهما غسلتِها من مرّات
Dialogue: 0,0:19:58.09,0:20:00.39,Default,,0000,0000,0000,,سيجد الفحص الدقيق آثار السم
Dialogue: 0,0:20:01.22,0:20:03.18,Default,,0000,0000,0000,,حتى لو لم يبق منه في الأكواب
Dialogue: 0,0:20:03.18,0:20:05.51,Default,,0000,0000,0000,,سنجدها في أنابيب التصريف
Dialogue: 0,0:20:05.76,0:20:06.76,Default,,0000,0000,0000,,عمّة
Dialogue: 0,0:20:06.76,0:20:09.12,Default,,0000,0000,0000,,يبدو أنّها بدأت تذوب
Dialogue: 0,0:20:09.12,0:20:14.69,Default,,0000,0000,0000,,شوكولاتة يوشيمي-سان الحقيقية التي\Nخبّأتها في ثوب الكيمونو
Dialogue: 0,0:20:16.71,0:20:18.07,Default,,0000,0000,0000,,!هراء
Dialogue: 0,0:20:18.07,0:20:21.18,Default,,0000,0000,0000,,!كيف لي أن أعرف أنّه سيأكل شوكولاتة يوشيمي-سان؟
Dialogue: 0,0:20:21.18,0:20:23.65,Default,,0000,0000,0000,,!لمَ قد أقتل ابني؟
Dialogue: 0,0:20:24.23,0:20:29.68,Default,,0000,0000,0000,,كلا! مات والدا كاتسوهيكو الحقيقيان\Nقبل 7 أعوام في حادث
Dialogue: 0,0:20:29.68,0:20:33.65,Default,,0000,0000,0000,,ثم تبنيته أنت، أخت أبيه
Dialogue: 0,0:20:33.65,0:20:39.39,Default,,0000,0000,0000,,كان كاتسوهيكو معجباً بيوشيمي لأنّها بدت كأمه الحقيقية
Dialogue: 0,0:20:40.34,0:20:45.59,Default,,0000,0000,0000,,!لذا كنتِ على يقين أنه سيأكل الشوكولاتة خاصتها
Dialogue: 0,0:20:48.70,0:20:50.87,Default,,0000,0000,0000,,!آسفة يا يوشيمي-سان
Dialogue: 0,0:20:50.87,0:20:53.45,Default,,0000,0000,0000,,رأيتك صدفةً تشترين شوكولاتة في أحد الأيام
Dialogue: 0,0:20:53.45,0:20:55.19,Default,,0000,0000,0000,,!فخطرت لي الفكرة
Dialogue: 0,0:20:56.03,0:20:57.90,Default,,0000,0000,0000,,لم يكن لديّ خيار
Dialogue: 0,0:20:57.90,0:20:59.98,Default,,0000,0000,0000,,كنّا بحاجة ماسة لإرث كاتسوهيكو-كن
Dialogue: 0,0:20:59.98,0:21:02.90,Default,,0000,0000,0000,,!لفشل تجارة زوجي
Dialogue: 0,0:21:04.07,0:21:09.01,Default,,0000,0000,0000,,!أردتُ حماية هذا المنزل وسعادة سوسومو
Dialogue: 0,0:22:51.81,0:22:53.90,Default,,0000,0000,0000,,كان يوماً حافلاً
Dialogue: 0,0:22:54.93,0:22:56.56,Default,,0000,0000,0000,,ماذا أفعل بهذه الشوكولاتة الآن؟
Dialogue: 0,0:22:56.56,0:22:59.38,Default,,0000,0000,0000,,!ران-سان! كنتِ هنا
Dialogue: 0,0:22:59.38,0:23:01.30,Default,,0000,0000,0000,,يمكنني أن أقلّك للبيت إن طلبتِ
Dialogue: 0,0:23:01.30,0:23:03.30,Default,,0000,0000,0000,,كلا، لا داعي
Dialogue: 0,0:23:03.30,0:23:06.42,Default,,0000,0000,0000,,!أهذه الشوكولاتة لي؟
Dialogue: 0,0:23:06.42,0:23:07.45,Default,,0000,0000,0000,,...كلا
Dialogue: 0,0:23:07.45,0:23:09.85,Default,,0000,0000,0000,,!شكراً جزيلاً! أشعر بالسرور
Dialogue: 0,0:23:10.12,0:23:10.73,Default,,0000,0000,0000,,!يكفي
Dialogue: 0,0:23:15.20,0:23:18.11,Default,,0000,0000,0000,,!دعني وشأني
Dialogue: 0,0:23:18.11,0:23:20.58,Default,,0000,0000,0000,,!المعذرة
Dialogue: 0,0:23:24.63,0:23:26.05,On Top,,0000,0000,0000,,لشينتشي-كن
Dialogue: 0,0:23:26.93,0:23:27.85,Default,,0000,0000,0000,,ران
Dialogue: 0,0:23:27.85,0:23:29.43,Default,,0000,0000,0000,,يمكنك أكلها إن أردت
Dialogue: 0,0:23:30.68,0:23:34.43,Default,,0000,0000,0000,,فلن يمانع شينتشي حتماً
Dialogue: 0,0:23:34.43,0:23:37.59,Default,,0000,0000,0000,,تبعتني لحمايتي، صحيح؟
Dialogue: 0,0:23:37.59,0:23:38.27,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:24:01.91,0:24:07.31,Default,,0000,0000,0000,,إرسال 25 مليون ين مع ألعاب \Nيبدو كثيراً بالنسبة لمقلب
Dialogue: 0,0:24:08.06,0:24:12.27,Default,,0000,0000,0000,,كما تلك الرسالة... ما المقصود بأنه قادم لأجله؟
Dialogue: 0,0:24:17.82,0:24:19.35,Default,,0000,0000,0000,,كما يُتوقع منك يا شينتشي
Dialogue: 0,0:24:20.42,0:24:21.23,Default,,0000,0000,0000,,...لم يكن
Dialogue: 0,0:24:24.38,0:24:25.78,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.78,0:24:28.74,Default,,0000,0000,0000,,هدايا التهديد الشهرية
Dialogue: 0,0:24:45.65,0:24:47.89,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.89,0:24:49.59,Default,,0000,0000,0000,,شفرة تعرّف
Dialogue: 0,0:24:49.59,0:24:51.59,Default,,0000,0000,0000,,قضيّة الحلقة القادمة صعبة قليلاً

