Dialogue: 0,0:00:00.85,0:00:04.18,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والقضايا تلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.18,0:00:06.08,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.33,0:00:09.63,Default,,0000,0000,0000,,!قضيّة اليوم تتمحور حول سيارة مشبوهة! احذر من حوادث الطريق
Dialogue: 0,0:00:09.63,0:00:11.30,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.30,0:00:13.55,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.55,0:00:16.01,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.68,0:00:24.18,On Top,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.18,0:00:31.22,On Top,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.90,0:00:39.35,On Top,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.35,0:00:46.85,On Top,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.85,0:00:59.30,On Top,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.14,0:01:06.60,On Top,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.51,0:01:13.40,On Top,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.40,0:01:19.85,On Top,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.85,0:01:26.79,On Top,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:50.97,0:01:57.19,Title,,0000,0000,0000,,{\fad(300,0)}قضيّة ملاحقة فرقة التحرّي الكبيرة
Dialogue: 0,0:01:51.96,0:01:55.36,Default,,0000,0000,0000,,قضيّة ملاحقة فرقة التحرّي الكبيرة
Dialogue: 0,0:02:02.18,0:02:04.81,Default,,0000,0000,0000,,!أيومي-تشان، ميتسوهيكو، غينتا! ها نحن
Dialogue: 0,0:02:04.81,0:02:06.64,Default,,0000,0000,0000,,!عُلم يا كونان-كن
Dialogue: 0,0:02:06.64,0:02:08.07,Default,,0000,0000,0000,,!دع الأمر لنا
Dialogue: 0,0:02:08.07,0:02:09.94,Default,,0000,0000,0000,,!نحن مستعدّون
Dialogue: 0,0:02:20.35,0:02:21.37,Default,,0000,0000,0000,,!خُذ
Dialogue: 0,0:02:24.46,0:02:25.50,Default,,0000,0000,0000,,!هيّا
Dialogue: 0,0:02:26.75,0:02:27.63,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:02:27.96,0:02:30.42,Default,,0000,0000,0000,,!أنزلوني! أنزلوني الآن
Dialogue: 0,0:02:30.42,0:02:32.21,Default,,0000,0000,0000,,...نصر كبير لفرقة
Dialogue: 0,0:02:32.31,0:02:34.22,Default,,0000,0000,0000,,!فتيان التحرّي
Dialogue: 0,0:02:38.91,0:02:40.80,Default,,0000,0000,0000,,!سنقبل بأيّ قضيّة
Dialogue: 0,0:02:40.80,0:02:42.12,Default,,0000,0000,0000,,!ونحقّق فيها
Dialogue: 0,0:02:42.12,0:02:43.43,Default,,0000,0000,0000,,!ونحلّها
Dialogue: 0,0:02:43.83,0:02:47.19,Default,,0000,0000,0000,,مهلكم... تبجّحكم كبير
Dialogue: 0,0:02:47.19,0:02:50.27,Default,,0000,0000,0000,,!يمكنكم الاعتماد على فرقة فتيان التحرّي
Dialogue: 0,0:02:51.27,0:02:54.90,On Top,,0000,0000,0000,,أربعة طلّاب في الابتدائية يقبضون على لصّ مجوهرات
Dialogue: 0,0:03:07.26,0:03:09.46,Default,,0000,0000,0000,,!شكراً على الطعام
Dialogue: 0,0:03:09.70,0:03:15.92,Default,,0000,0000,0000,,!يا إلهي، أنتم تأكلون بشراهة\Nألا تعرفون ضبط النفس؟
Dialogue: 0,0:03:16.47,0:03:21.22,Default,,0000,0000,0000,,فلتعزم الصغار على وجبة أو ما شابه\N!مكافأةً لهم يا موري-كن
Dialogue: 0,0:03:22.30,0:03:23.99,Default,,0000,0000,0000,,!أنا؟
Dialogue: 0,0:03:24.93,0:03:29.10,Default,,0000,0000,0000,,تبّاً، تبخّر مصروف هذا الشهر تماماً
Dialogue: 0,0:03:30.10,0:03:33.61,Default,,0000,0000,0000,,كان ذلك مُبهراً، فاللصّ قد كان مطلوباً\N!لخمسين جريمة سطو
Dialogue: 0,0:03:34.35,0:03:38.75,Default,,0000,0000,0000,,وجده كونان-كن، فقد بدا مثيراً للشبهة\Nفي محلّ المجوهرات
Dialogue: 0,0:03:39.10,0:03:41.71,Default,,0000,0000,0000,,كان ذلك بمحض المصادفة مع ذلك
Dialogue: 0,0:03:41.71,0:03:43.81,Default,,0000,0000,0000,,!سنحصل على المزيد من العملاء هكذا
Dialogue: 0,0:03:43.81,0:03:46.38,Default,,0000,0000,0000,,!أجل! علينا تجهيز مكتبنا الخاص
Dialogue: 0,0:03:57.81,0:03:59.69,Default,,0000,0000,0000,,انتبهي، هناك سيّارة قادمة
Dialogue: 0,0:04:02.23,0:04:03.31,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:04:03.31,0:04:04.19,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:04:04.19,0:04:07.15,Default,,0000,0000,0000,,!شينجوكو 33، نا 33-96
Dialogue: 0,0:04:07.48,0:04:09.36,Default,,0000,0000,0000,,!اصطدام وهروب
Dialogue: 0,0:04:09.36,0:04:13.91,Default,,0000,0000,0000,,!ران، ابقي هنا! سأذهب للاتّصال بالإسعاف والشرطة
Dialogue: 0,0:04:13.91,0:04:15.41,Default,,0000,0000,0000,,!اعتني بها يا ران-نيتشان
Dialogue: 0,0:04:18.77,0:04:20.48,Default,,0000,0000,0000,,!لا تقل شيئاً يا كونان
Dialogue: 0,0:04:20.48,0:04:22.87,Default,,0000,0000,0000,,!لا يمكننا ترك هذا الأمر للشرطة فحسب
Dialogue: 0,0:04:23.35,0:04:26.13,Default,,0000,0000,0000,,!حسناً، تشبّثوا جيّداً
Dialogue: 0,0:04:35.94,0:04:37.10,Default,,0000,0000,0000,,!انعطفت
Dialogue: 0,0:04:37.10,0:04:39.18,Default,,0000,0000,0000,,!سنفقد أثرها إذا لم نسرع
Dialogue: 0,0:04:39.18,0:04:40.69,Default,,0000,0000,0000,,!أعرف ذلك
Dialogue: 0,0:04:45.90,0:04:47.44,Default,,0000,0000,0000,,!إنّها سيّارة الفاعل
Dialogue: 0,0:04:47.44,0:04:50.03,Default,,0000,0000,0000,,!ظننتنا فقدنا أثرها! يا لحظّنا
Dialogue: 0,0:05:02.85,0:05:04.37,Default,,0000,0000,0000,,!توقّفت مجدداً
Dialogue: 0,0:05:04.37,0:05:07.29,Default,,0000,0000,0000,,!لا بدّ أنّها مشكلة بالمحرك
Dialogue: 0,0:05:07.52,0:05:09.40,Default,,0000,0000,0000,,!يا لحظّنا
Dialogue: 0,0:05:09.40,0:05:14.26,Default,,0000,0000,0000,,...يتوقّف عند كلّ منعطف\N!كما لو أنّه ينتظر لحاقنا به
Dialogue: 0,0:05:17.27,0:05:18.48,Default,,0000,0000,0000,,!إنّه يهرب
Dialogue: 0,0:05:18.48,0:05:21.60,Default,,0000,0000,0000,,!ما الذي تفعله يا كونان؟ أسرع أكثر
Dialogue: 0,0:05:34.70,0:05:36.85,Default,,0000,0000,0000,,...لا أرى السيّارة
Dialogue: 0,0:05:36.85,0:05:38.56,Default,,0000,0000,0000,,هل فقدنا أثرها أخيراً؟
Dialogue: 0,0:05:38.56,0:05:39.52,Default,,0000,0000,0000,,!لنبحث عنها
Dialogue: 0,0:05:39.52,0:05:40.24,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:05:40.24,0:05:40.87,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:05:43.40,0:05:45.79,Default,,0000,0000,0000,,لحظة، أيمكن أنّها مخبّأة هنا؟
Dialogue: 0,0:05:46.94,0:05:49.54,Default,,0000,0000,0000,,كلا، لا مكان لها
Dialogue: 0,0:05:49.54,0:05:52.65,Default,,0000,0000,0000,,كما يبدو أنّ هذا المصنع مغلقٌ اليوم
Dialogue: 0,0:05:49.54,0:05:55.05,On Top,,0000,0000,0000,,إيشيكورا للصناعات
Dialogue: 0,0:05:52.65,0:05:54.13,Default,,0000,0000,0000,,!لنتفقّد في الخلف
Dialogue: 0,0:05:54.13,0:05:55.05,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:05:58.60,0:06:02.27,Default,,0000,0000,0000,,!يا للطريق السيّئّ! لا ترصيف هنا
Dialogue: 0,0:06:06.90,0:06:10.19,Default,,0000,0000,0000,,...توجد أدراج في هذا الاتّجاه، مما يعني
Dialogue: 0,0:06:10.44,0:06:11.90,Default,,0000,0000,0000,,ليست موجودة
Dialogue: 0,0:06:11.90,0:06:14.82,Default,,0000,0000,0000,,!يوجد محلّ سجائر هناك! لنسألهم
Dialogue: 0,0:06:19.37,0:06:22.04,Default,,0000,0000,0000,,يا جدّة، أمرّت سيّارة حمراء قبل قليل؟
Dialogue: 0,0:06:22.33,0:06:26.58,Default,,0000,0000,0000,,لا أدري، مرّت سيّارتان إلى ثلاثة\Nلكنّي لست واثقة
Dialogue: 0,0:06:26.87,0:06:28.20,Default,,0000,0000,0000,,!إنّها ثنائيّة الباب
Dialogue: 0,0:06:28.20,0:06:30.00,Default,,0000,0000,0000,,!سيّارة رياضية
Dialogue: 0,0:06:30.00,0:06:33.12,Default,,0000,0000,0000,,لا أفقه في السيّارات كثيراً
Dialogue: 0,0:06:34.83,0:06:36.24,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:06:36.93,0:06:40.26,Default,,0000,0000,0000,,أنت إذاً! كيف حالك؟
Dialogue: 0,0:06:40.83,0:06:43.50,Default,,0000,0000,0000,,مرّت ثلاث دقائق مذ أتينا هنا
Dialogue: 0,0:06:43.50,0:06:45.41,Default,,0000,0000,0000,,لعلّه هرب الآن على الأرجح
Dialogue: 0,0:06:45.41,0:06:47.45,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:06:48.58,0:06:50.23,Default,,0000,0000,0000,,!انظروا هناك
Dialogue: 0,0:06:50.23,0:06:52.06,Default,,0000,0000,0000,,!سيّارة حمراء! تلك هي
Dialogue: 0,0:06:52.84,0:06:55.12,Default,,0000,0000,0000,,!محرّكها توقّف مُجدداً! الحظّ معنا
Dialogue: 0,0:06:55.75,0:07:00.75,Default,,0000,0000,0000,,،كلا، هذا مختلف عن السابق\N!فلم تكن توجد سيّارة هناك قبل قليل
Dialogue: 0,0:07:00.75,0:07:03.45,Default,,0000,0000,0000,,هل رجع؟ لمَ؟
Dialogue: 0,0:07:06.95,0:07:08.84,Default,,0000,0000,0000,,!سنمسك به هذه المرّة
Dialogue: 0,0:07:08.84,0:07:10.17,Default,,0000,0000,0000,,!لن تهرب
Dialogue: 0,0:07:21.22,0:07:22.64,Default,,0000,0000,0000,,!حسنٌ، ممتاز! بقي القليل فقط
Dialogue: 0,0:07:27.59,0:07:28.45,Default,,0000,0000,0000,,...مؤلم
Dialogue: 0,0:07:30.73,0:07:32.69,On Top,,0000,0000,0000,,مركز شرطة بيكا المحليّ
Dialogue: 0,0:07:33.04,0:07:34.79,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:07:34.79,0:07:36.07,Default,,0000,0000,0000,,مركز شرطة؟
Dialogue: 0,0:07:39.91,0:07:44.24,Default,,0000,0000,0000,,!حضرة الضابط، فلتعتقلني رجاءً\Nفقد أقدمت على جريمة اصطدام وهرب
Dialogue: 0,0:07:45.04,0:07:46.95,Default,,0000,0000,0000,,يـ-يسلّم نفسه؟
Dialogue: 0,0:07:47.93,0:07:50.25,CharCard,,0000,0000,0003,,{\fad(300,0)} مشفى بيكا المركزيّ
Dialogue: 0,0:07:50.46,0:07:54.33,Default,,0000,0000,0000,,،حاول الهرب بعد اصطدامه بك
Dialogue: 0,0:07:54.33,0:07:57.59,Default,,0000,0000,0000,,لكنّه قرّر تسليم نفسه بعدما أنّبه ضميره
Dialogue: 0,0:07:57.87,0:07:59.87,Default,,0000,0000,0000,,!يا إلهي، يا للنهاية المُثبطة
Dialogue: 0,0:07:59.87,0:08:03.83,Default,,0000,0000,0000,,أردتُ أن تستعمل فرقة فتيان\N!التحرّي قوّتها أكثر
Dialogue: 0,0:08:03.83,0:08:05.31,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:08:06.08,0:08:07.58,Default,,0000,0000,0000,,لا شيء
Dialogue: 0,0:08:07.58,0:08:09.68,Default,,0000,0000,0000,,بأيّ حال، كيف هي أيومي؟
Dialogue: 0,0:08:10.16,0:08:12.91,Default,,0000,0000,0000,,كانت إصاباتها خفيفة لحسن الحظّ
Dialogue: 0,0:08:12.91,0:08:15.02,Default,,0000,0000,0000,,قالوا أنّ لا حاجة لتنويمها هنا
Dialogue: 0,0:08:15.37,0:08:17.80,Default,,0000,0000,0000,,!أي يمكنك العودة اليوم
Dialogue: 0,0:08:17.80,0:08:18.99,Default,,0000,0000,0000,,!هذا رائع
Dialogue: 0,0:08:19.58,0:08:26.20,Default,,0000,0000,0000,,ليس رائعاً، فقدت شارة فرقة فتيان\Nالتحرّي التي أعطاني إيّاها كونان-كن
Dialogue: 0,0:08:26.79,0:08:29.45,Default,,0000,0000,0000,,سقطت منك عندما اصطدم بك؟
Dialogue: 0,0:08:29.45,0:08:32.58,Default,,0000,0000,0000,,سألت أحد رجال الشرطة، وقال أنّهم لم يروها
Dialogue: 0,0:08:32.58,0:08:35.88,Default,,0000,0000,0000,,لا تقلقي، سأطلب من البروفسور صنع بديلة
Dialogue: 0,0:08:36.58,0:08:40.34,Default,,0000,0000,0000,,!حقّاً؟ هذا يسعدني! لذا أحبّك يا كونان-كن
Dialogue: 0,0:08:41.41,0:08:43.25,Default,,0000,0000,0000,,هذا دنيءٌ يا كونان
Dialogue: 0,0:08:43.25,0:08:45.68,Default,,0000,0000,0000,,!تشتري حبّها بماديّات... أيّها الجبان
Dialogue: 0,0:08:46.04,0:08:48.01,Default,,0000,0000,0000,,...أنتما
Dialogue: 0,0:08:48.66,0:08:53.41,Default,,0000,0000,0000,,اسمعوا، عليكم مرافقتي للمصنع\Nفي الشارع الرابع فوراً
Dialogue: 0,0:08:53.41,0:08:54.98,Default,,0000,0000,0000,,فالمفتّش في انتظارنا
Dialogue: 0,0:08:55.33,0:08:58.79,Default,,0000,0000,0000,,المصنع في الشارع الرابع؟ إنّه المكان\Nالذي مررنا به قبل قليل
Dialogue: 0,0:08:58.79,0:09:00.44,Default,,0000,0000,0000,,أحصل شيءٌ يا عمّ؟
Dialogue: 0,0:09:00.75,0:09:05.28,Default,,0000,0000,0000,,،مات أحدهم في ذاك المصنع\Nويبدو أنّها جريمة قتل
Dialogue: 0,0:09:12.33,0:09:14.88,Default,,0000,0000,0000,,اسمعوا، عليكم البقاء هنا
Dialogue: 0,0:09:16.79,0:09:17.82,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:09:17.82,0:09:19.79,Default,,0000,0000,0000,,أتيت إذاً؟
Dialogue: 0,0:09:19.79,0:09:22.17,Default,,0000,0000,0000,,سأدخل في صلب الموضوع، هذا هو الوضع
Dialogue: 0,0:09:22.59,0:09:27.89,CharCard,,0000,0000,0004,,{\fad(200,0)}رئيس إيشيكورا للصناعات\N(إيشيكورا هيساشي (50
Dialogue: 0,0:09:23.08,0:09:25.41,On Top,,0000,0000,0000,,،كان الضحيّة هو رئيس هذا المصنع
Dialogue: 0,0:09:25.41,0:09:27.64,On Top,,0000,0000,0000,,إيشيكورا هيساشي-سان، 50 عاماً
Dialogue: 0,0:09:28.25,0:09:30.60,Default,,0000,0000,0000,,هذه جريمة سطو
Dialogue: 0,0:09:31.12,0:09:36.31,Default,,0000,0000,0000,,أجل، نحن نحقّق على أساس كونها\Nجريمة سطو وقتل
Dialogue: 0,0:09:36.62,0:09:39.16,Default,,0000,0000,0000,,المصنع مغلقٌ اليوم
Dialogue: 0,0:09:39.16,0:09:42.74,Default,,0000,0000,0000,,لكن أتى إيشيكورا-سان بمفرده\Nلتفقّد المنتجات وفقما يبدو
Dialogue: 0,0:09:43.12,0:09:47.24,Default,,0000,0000,0000,,توجد آثار شريط لاصق على فمه ومعصمه
Dialogue: 0,0:09:47.66,0:09:50.25,Default,,0000,0000,0000,,مما يعني أنّه كان مقيّداً
Dialogue: 0,0:09:50.25,0:09:55.04,Default,,0000,0000,0000,,...لكن لمَ نُزع الشريط؟ ما الذي أراده القاتل
Dialogue: 0,0:09:56.66,0:09:58.58,Default,,0000,0000,0000,,!لا تتجوّل في مسرح الجريمة
Dialogue: 0,0:09:58.58,0:09:59.92,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:10:03.50,0:10:08.14,Default,,0000,0000,0000,,الباب الخلفيّ يقابل متجر\N...السجائر للجدّة بشكل قطري
Dialogue: 0,0:10:08.58,0:10:11.79,Default,,0000,0000,0000,,،علينا انتظار نتائج التشريح للتفاصيل
Dialogue: 0,0:10:11.79,0:10:15.10,Default,,0000,0000,0000,,لكن وقت الوفاة المقدّر هو قبل قرابة ساعة
Dialogue: 0,0:10:15.70,0:10:19.08,Default,,0000,0000,0000,,!كنّا قد مررنا هنا قبل ساعة
Dialogue: 0,0:10:19.38,0:10:20.61,Default,,0000,0000,0000,,!لا شكّ في الأمر
Dialogue: 0,0:10:20.88,0:10:22.25,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:10:22.25,0:10:25.21,Default,,0000,0000,0000,,هل رأيتم شخصاً مثيراً للشبهة وقتها؟
Dialogue: 0,0:10:25.21,0:10:27.58,Default,,0000,0000,0000,,...بصراحة، في ذاك الوقت
Dialogue: 0,0:10:27.92,0:10:31.21,Default,,0000,0000,0000,,كنّا منشغلين بملاحقة السائق\N...الذي اصطدم وهرب
Dialogue: 0,0:10:31.21,0:10:33.54,Default,,0000,0000,0000,,!أ-أليس هذا هو؟
Dialogue: 0,0:10:33.78,0:10:37.07,Default,,0000,0000,0000,,!انظر! الشخص الذي يقف في المنتصف خلفاً
Dialogue: 0,0:10:38.96,0:10:41.72,Default,,0000,0000,0000,,!إنّه الرجل الذي اصطدم بأيومي-تشان
Dialogue: 0,0:10:42.05,0:10:43.34,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:43.34,0:10:44.36,Default,,0000,0000,0000,,أأنتم متأكّدون؟
Dialogue: 0,0:10:44.36,0:10:45.56,Default,,0000,0000,0000,,!لا شكّ بالأمر
Dialogue: 0,0:10:45.80,0:10:48.34,Default,,0000,0000,0000,,!لعلّه من ارتكب جريمة القتل أيضاً
Dialogue: 0,0:10:48.34,0:10:51.02,Default,,0000,0000,0000,,!مستحيل، كانت مصادفة
Dialogue: 0,0:10:51.38,0:10:52.63,Default,,0000,0000,0000,,!بالتأكيد
Dialogue: 0,0:10:52.63,0:10:56.19,Default,,0000,0000,0000,,فمن يقدم على سطو وقتل\N!وهو يهرب من حادثة اصطدام مروري؟
Dialogue: 0,0:10:56.23,0:10:58.65,CharCard,,0000,0000,0004,,{\fad(300,0)}مركز شرطة بيكا
Dialogue: 0,0:10:58.81,0:11:05.62,CharCard,,0000,0000,0004,,{\fad(300,0)}موظّف سابق في إيشيكورا للصناعات\N(شيشيدو كينيتشي (35
Dialogue: 0,0:10:59.21,0:11:01.84,On Top,,0000,0000,0000,,بدأ الأطفال بملاحقتي
Dialogue: 0,0:11:01.84,0:11:05.62,On Top,,0000,0000,0000,,وتوقّفت سيّارتي عند المنعطف وراء المصنع بقليل
Dialogue: 0,0:11:06.00,0:11:10.08,Default,,0000,0000,0000,,لم أوقف السيّارة وراءه
Dialogue: 0,0:11:11.03,0:11:13.67,Default,,0000,0000,0000,,ولم أقتل أحداً
Dialogue: 0,0:11:13.67,0:11:15.04,Default,,0000,0000,0000,,...كانت محض مصادفة
Dialogue: 0,0:11:15.84,0:11:21.88,Default,,0000,0000,0000,,،إنّه موظّف سابق في ذاك المصنع\Nوتمّ فصله لسوء سلوكه الشهر الفائت
Dialogue: 0,0:11:21.88,0:11:23.72,Default,,0000,0000,0000,,...أ-أيمكن يا سيّدي المفتّش أنّه
Dialogue: 0,0:11:24.30,0:11:25.80,Default,,0000,0000,0000,,!كان الفاعل حقّاً؟
Dialogue: 0,0:11:25.80,0:11:28.25,Default,,0000,0000,0000,,ذلك مستحيل يا غينتا-كن
Dialogue: 0,0:11:28.25,0:11:29.34,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:11:29.34,0:11:32.56,Default,,0000,0000,0000,,كنّا أمام المصنع في ذاك الوقت
Dialogue: 0,0:11:32.88,0:11:34.63,Default,,0000,0000,0000,,،لكن سيّدي المفتّش
Dialogue: 0,0:11:34.63,0:11:38.78,Default,,0000,0000,0000,,كان بإمكانه الدخول من الباب الخلفيّ\N!بعدما توارى عن أنظار الأطفال
Dialogue: 0,0:11:39.21,0:11:45.18,Default,,0000,0000,0000,,لكنّنا سألنا جدّة متجر السجائر \Nأمام الباب الخلفيّ للمصنع
Dialogue: 0,0:11:45.18,0:11:51.22,Default,,0000,0000,0000,,،لم تتوقّف أيّ سيّارة بالقرب من هنا\Nلا وراء المصنع ولا على الشارع
Dialogue: 0,0:11:51.71,0:11:55.96,Default,,0000,0000,0000,,متجرها يقابل باب المصنع الخلفيّ
Dialogue: 0,0:11:51.71,0:11:58.00,On Top,,0000,0000,0000,,{\fs(22)\pos(374.545,247.273)}محلّ السجائر
Dialogue: 0,0:11:51.71,0:11:58.00,On Top,,0000,0000,0000,,{\fs(18)\pos(158.182,336.364)}كونان وجماعته
Dialogue: 0,0:11:51.71,0:11:58.21,OS,,0000,0000,0000,,{\fs22\pos(357,59)}موقع السيّارة
Dialogue: 0,0:11:51.71,0:11:58.21,On Top,,0000,0000,0000,,{\fs22\pos(200.25,176)}إيشيكورا للصناعات
Dialogue: 0,0:11:55.96,0:11:58.21,Default,,0000,0000,0000,,فيمكننا الوثوق بشهادتها
Dialogue: 0,0:12:00.21,0:12:03.63,Default,,0000,0000,0000,,...مما يعني أنّها كانت محض مصادفة بالفعل
Dialogue: 0,0:12:04.00,0:12:08.63,Default,,0000,0000,0000,,!كلا، يوجد جانب آخر لهاتين القضيّتين
Dialogue: 0,0:12:08.63,0:12:12.56,Default,,0000,0000,0000,,!شيء كبير لم نلحظه بعد
Dialogue: 0,0:12:15.42,0:12:17.73,Default,,0000,0000,0000,,لا يزال هناك شيءٌ يا كونان؟
Dialogue: 0,0:12:18.13,0:12:21.74,Default,,0000,0000,0000,,!لنذهب لزيارة أيومي-تشان
Dialogue: 0,0:12:22.34,0:12:23.99,Default,,0000,0000,0000,,فلتسبقاني
Dialogue: 0,0:12:24.34,0:12:30.13,Default,,0000,0000,0000,,كلا! على فرقة فتيان التحرّي أن\N!تلتزم بالعمل الجماعيّ دوماً
Dialogue: 0,0:12:30.13,0:12:34.00,Default,,0000,0000,0000,,لكنّي أريد عصيراً قبل ذلك، فأشعر بالعطش
Dialogue: 0,0:12:34.55,0:12:38.92,Default,,0000,0000,0000,,!يوجد عصير هناك، بجوار محلّ السجائر
Dialogue: 0,0:12:44.05,0:12:48.60,Default,,0000,0000,0000,,...حقّاً؟ فعل واتارو ذلك؟ مع أنّه كان صبيّاً مجتهداً
Dialogue: 0,0:12:50.13,0:12:51.02,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:12:51.88,0:12:53.71,Default,,0000,0000,0000,,أخبريني يا جدّة
Dialogue: 0,0:12:53.71,0:12:56.98,Default,,0000,0000,0000,,هل أتاكِ اتّصال خاطئ عندما\Nوقعت الحادثة في المصنع؟
Dialogue: 0,0:12:58.85,0:13:02.65,Default,,0000,0000,0000,,...بذكرك ذلك، وردني اتّصالان خاطئان وقتها
Dialogue: 0,0:13:03.25,0:13:07.36,Default,,0000,0000,0000,,...كما ظننت! وفقما أذكر، فقد كان في الزقاق
Dialogue: 0,0:13:07.71,0:13:10.08,Default,,0000,0000,0000,,!شكراً لك يا جدّة! إلى اللقاء
Dialogue: 0,0:13:14.75,0:13:16.00,Default,,0000,0000,0000,,ما الخطب يا كونان؟
Dialogue: 0,0:13:16.34,0:13:18.46,Default,,0000,0000,0000,,!غينتا! ارفعني على كتفيك
Dialogue: 0,0:13:18.46,0:13:19.75,Default,,0000,0000,0000,,يرفعك؟
Dialogue: 0,0:13:22.67,0:13:24.51,Default,,0000,0000,0000,,أيوجد شيءٌ هناك؟
Dialogue: 0,0:13:24.96,0:13:26.22,Default,,0000,0000,0000,,!بالفعل
Dialogue: 0,0:13:27.38,0:13:29.01,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:13:31.56,0:13:32.32,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:13:33.55,0:13:36.65,Default,,0000,0000,0000,,!فهمت! كان هنا
Dialogue: 0,0:13:43.88,0:13:47.84,Default,,0000,0000,0000,,ماذا؟! شيشيدو كينيتشي، مُرتكب الاصطدام والهرب نفسه؟
Dialogue: 0,0:13:47.84,0:13:49.62,Default,,0000,0000,0000,,!أجل، فهمت يا موري-كن
Dialogue: 0,0:13:49.92,0:13:51.25,Default,,0000,0000,0000,,حسناً، دور العمّ
Dialogue: 0,0:13:54.63,0:13:57.21,Default,,0000,0000,0000,,موري-كن؟ أنا ميغوري
Dialogue: 0,0:13:57.21,0:14:00.42,Default,,0000,0000,0000,,هلّا أتيت للمصنع على الشارع الرابع بشكلٍ عاجل؟
Dialogue: 0,0:14:03.63,0:14:05.09,Default,,0000,0000,0000,,بُوركت جهودكما
Dialogue: 0,0:14:08.38,0:14:10.05,Default,,0000,0000,0000,,حضرة المفتّش، أين أنت؟
Dialogue: 0,0:14:10.71,0:14:12.05,Default,,0000,0000,0000,,!كنّا بانتظارك
Dialogue: 0,0:14:12.05,0:14:16.30,Default,,0000,0000,0000,,!أ-أنتما! ما الذي تفعلانه هنا؟
Dialogue: 0,0:14:16.30,0:14:18.71,Default,,0000,0000,0000,,سيأتي المفتّش ميغوري قريباً
Dialogue: 0,0:14:18.71,0:14:21.25,Default,,0000,0000,0000,,انتظر هنا من فضلك
Dialogue: 0,0:14:22.21,0:14:25.07,Default,,0000,0000,0000,,تتحلّيان بالأخلاق، لا أمانع فعل ذلك إذاً
Dialogue: 0,0:14:28.34,0:14:34.13,Default,,0000,0000,0000,,أتمنّى لو أني استطعت ارتشاف\N...رشفة واحدة على الأقل قبلها
Dialogue: 0,0:14:36.59,0:14:38.71,Default,,0000,0000,0000,,كما قال كونان
Dialogue: 0,0:14:38.71,0:14:42.54,Default,,0000,0000,0000,,!يصبح كوغورو النائم عندما يدخل مسرح جريمة
Dialogue: 0,0:14:42.80,0:14:46.21,Default,,0000,0000,0000,,!لم ينتبه لأنّنا ملأنا العلبة الفارغة بماء حتّى
Dialogue: 0,0:14:47.38,0:14:49.38,Default,,0000,0000,0000,,كونان! أين أنت؟
Dialogue: 0,0:14:49.38,0:14:51.47,Default,,0000,0000,0000,,ماذا نفعل تالياً؟
Dialogue: 0,0:14:52.51,0:14:56.23,Default,,0000,0000,0000,,أخبرني كونان بكلّ شيء، سأتولّى الموضوع من هنا
Dialogue: 0,0:14:57.51,0:14:58.93,Default,,0000,0000,0000,,!لا يصحّ ذلك يا عمّ
Dialogue: 0,0:14:58.93,0:15:03.68,Default,,0000,0000,0000,,لا تقلقا، جهّزتُ دوراً لكما
Dialogue: 0,0:15:03.68,0:15:05.05,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:15:05.05,0:15:06.95,Default,,0000,0000,0000,,!حسناً إذاً
Dialogue: 0,0:15:05.05,0:15:06.95,Default,,0000,0000,0000,,!حسناً إذاً
Dialogue: 0,0:15:09.01,0:15:10.79,Default,,0000,0000,0000,,موري-كن، جلبته معي
Dialogue: 0,0:15:11.43,0:15:12.80,Default,,0000,0000,0000,,ما الأمر بالضبط؟
Dialogue: 0,0:15:12.80,0:15:16.00,Default,,0000,0000,0000,,يعرف شيشيدو-سان تفاصيل ذلك تماماً
Dialogue: 0,0:15:17.35,0:15:18.67,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:15:18.97,0:15:23.51,Default,,0000,0000,0000,,اصطدمت بفتاةٍ صغيرة اليوم وهربت
Dialogue: 0,0:15:23.51,0:15:28.43,Default,,0000,0000,0000,,ثمّ واصلت القيادة ومجموعة الأطفال تلاحقك
Dialogue: 0,0:15:28.43,0:15:30.30,Default,,0000,0000,0000,,ومررت بهذا المكان
Dialogue: 0,0:15:30.30,0:15:35.90,Default,,0000,0000,0000,,المصنع الذي يخصّ إيشيكورا-سان\Nالذي تعرفه، بل تكنّ الضغينة له
Dialogue: 0,0:15:36.43,0:15:38.36,Default,,0000,0000,0000,,كما قلت، ما الأمر بالضبط؟
Dialogue: 0,0:15:38.68,0:15:42.82,Default,,0000,0000,0000,,ماذا؟ تريدني أن أبوح أنا إذاً؟
Dialogue: 0,0:15:43.39,0:15:48.33,Default,,0000,0000,0000,,!قاتل إيشيكورا-سان كان أنت يا شيشيدو-سان
Dialogue: 0,0:15:50.22,0:15:52.89,Default,,0000,0000,0000,,!مهلك! ما الذي تقوله؟
Dialogue: 0,0:15:52.89,0:15:58.46,Default,,0000,0000,0000,,!تمّت تبرئته، من جريمة القتل على الأقل
Dialogue: 0,0:15:58.72,0:15:59.93,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:15:59.93,0:16:03.35,Default,,0000,0000,0000,,ظُنّ أنّ ارتكاب الجريمة\Nبينما يلوذ بالفرار أمرٌ مستحيل
Dialogue: 0,0:16:03.35,0:16:05.18,Default,,0000,0000,0000,,فزالت الشبهات المحيطة به
Dialogue: 0,0:16:05.51,0:16:08.89,Default,,0000,0000,0000,,!صحيح! لديكم شهود حتّى
Dialogue: 0,0:16:09.18,0:16:11.39,Default,,0000,0000,0000,,!الصغار الذين لاحقوني
Dialogue: 0,0:16:12.68,0:16:15.22,Default,,0000,0000,0000,,لكن ماذا لو كان ذلك سابق التدبير؟
Dialogue: 0,0:16:15.22,0:16:19.01,Default,,0000,0000,0000,,،ماذا لو نويت أن يشهد لك هؤلاء الصغار
Dialogue: 0,0:16:19.01,0:16:21.32,Default,,0000,0000,0000,,فرقة فتيان التحرّي؟
Dialogue: 0,0:16:22.32,0:16:25.78,Default,,0000,0000,0000,,ما-ماذا؟! ما قصدك؟
Dialogue: 0,0:16:26.14,0:16:29.85,Default,,0000,0000,0000,,أي ماذا لو كانت حادثة الاصطدام والهرب المتعلّقة بأيومي-كن
Dialogue: 0,0:16:29.85,0:16:33.75,Default,,0000,0000,0000,,تمويهاً لإخفاء الجريمة؟
Dialogue: 0,0:16:35.21,0:16:39.17,Default,,0000,0000,0000,,لا-لا يُعقل! أكان بإمكانه ذلك؟
Dialogue: 0,0:16:39.60,0:16:45.51,Default,,0000,0000,0000,,وفقاً لكونان، فقد كانت السيّارة تتوقّف\Nعند كلّ منعطف بشكلٍ غريب
Dialogue: 0,0:16:45.51,0:16:47.34,Default,,0000,0000,0000,,فلم يفقدوا أثرها
Dialogue: 0,0:16:48.01,0:16:51.81,Default,,0000,0000,0000,,لو كان يتعمّد ذلك كي يستطيعوا\Nاللحاق به، فسيتوضّح كلّ شيء
Dialogue: 0,0:16:52.35,0:16:54.52,Default,,0000,0000,0000,,!كانت السيّارة بحالة سيّئة حقّاً
Dialogue: 0,0:16:55.01,0:16:56.80,Default,,0000,0000,0000,,صحيح يا موري-كن
Dialogue: 0,0:16:56.80,0:17:01.48,Default,,0000,0000,0000,,،فقد كانت شمعة الاحتراق للسيّارة مهترئة\Nومحرّكها في حالة متردّية
Dialogue: 0,0:17:01.84,0:17:06.95,Default,,0000,0000,0000,,يمكن حتّى لمجّرد هاوٍ تدبير ذلك حضرة المفتّش
Dialogue: 0,0:17:08.10,0:17:15.16,Default,,0000,0000,0000,,لا بأس، إذا كان الأمر كذلك فلديّ\Nحجّة غياب، حجّة لا تشوبها شائبة
Dialogue: 0,0:17:15.47,0:17:21.08,Default,,0000,0000,0000,,أجل، باستثناء الثلاث دقائق التي\Nفقد الصغار أثرك فيها
Dialogue: 0,0:17:22.47,0:17:24.55,Default,,0000,0000,0000,,لا يمكنك فعل شيء في ثلاث دقائق
Dialogue: 0,0:17:24.85,0:17:29.01,Default,,0000,0000,0000,,كلا، بل هي كافية للدخول هنا
Dialogue: 0,0:17:30.18,0:17:31.55,Default,,0000,0000,0000,,!سخافة
Dialogue: 0,0:17:31.55,0:17:35.76,Default,,0000,0000,0000,,كانت جدّة محلّ السجائر لتنتبه لسيّارتي\N!لو أوقفتها عند الباب الخلفيّ
Dialogue: 0,0:17:35.76,0:17:39.02,Default,,0000,0000,0000,,عجباً، تعرف ذلك أيضاً
Dialogue: 0,0:17:39.02,0:17:42.98,Default,,0000,0000,0000,,كنتُ أعمل هنا، فمن الطبيعيّ أن أعرف
Dialogue: 0,0:17:43.60,0:17:48.53,Default,,0000,0000,0000,,لا بدّ أنّ من الطبيعيّ معرفتك\Nبرقم هاتف ذاك المحلّ أيضاً إذاً
Dialogue: 0,0:17:50.39,0:17:52.99,Default,,0000,0000,0000,,لا-لا أفهم ما الذي تلمّح له
Dialogue: 0,0:17:53.60,0:17:58.83,Default,,0000,0000,0000,,لم توقف السيّارة عند الباب الخلفيّ، بل أتيت مشياً
Dialogue: 0,0:18:00.39,0:18:03.79,Default,,0000,0000,0000,,ماذا عن السيّارة إذاً؟ أين وضعها؟
Dialogue: 0,0:18:04.14,0:18:05.14,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:18:05.14,0:18:06.34,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:18:07.23,0:18:08.31,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:18:08.31,0:18:10.63,Default,,0000,0000,0000,,!أين كنت؟
Dialogue: 0,0:18:10.93,0:18:12.43,Default,,0000,0000,0000,,،لا تهتموا لذلك
Dialogue: 0,0:18:12.43,0:18:16.35,Default,,0000,0000,0000,,فلترشدوا المفتّش ومن معه للمخزن\N!الذي اختلست النظر له
Dialogue: 0,0:18:17.05,0:18:18.39,Default,,0000,0000,0000,,لذاك المخزن؟
Dialogue: 0,0:18:24.01,0:18:25.90,Default,,0000,0000,0000,,!هـ-هذه السيّارة
Dialogue: 0,0:18:26.60,0:18:28.60,Default,,0000,0000,0000,,!إنّها نفس سيّارة الاصطدام والهرب
Dialogue: 0,0:18:28.60,0:18:30.36,Default,,0000,0000,0000,,!رقم اللوحة مطابق أيضاً
Dialogue: 0,0:18:36.01,0:18:37.51,Default,,0000,0000,0000,,،شيشيدو-سان
Dialogue: 0,0:18:37.51,0:18:41.97,Default,,0000,0000,0000,,لمَ توجد سيّارة مطابقة للسيّارة\Nفي حادثة الاصطدام والهرب؟
Dialogue: 0,0:18:41.97,0:18:43.00,Default,,0000,0000,0000,,!لا أعرف
Dialogue: 0,0:18:43.51,0:18:47.55,Default,,0000,0000,0000,,لعلّه قام بتعديل سيّارة مسروقة على الأرجح
Dialogue: 0,0:18:47.55,0:18:51.01,Default,,0000,0000,0000,,كنت تعمل في مصنع صفائح معدنية \Nوطلاء يا شيشيدو-سان
Dialogue: 0,0:18:51.35,0:18:53.43,Default,,0000,0000,0000,,يُفترض أنّ الأمر كان بسيطاً عليك
Dialogue: 0,0:18:54.18,0:19:00.01,Default,,0000,0000,0000,,أفقدتَ إيشيكورا-سان وعيه أوّلاً\Nبمنوّم أو ما شابه في مكتب المصنع
Dialogue: 0,0:19:00.01,0:19:03.06,Default,,0000,0000,0000,,ثمّ قيّدته بشريط لاصق وتركته
Dialogue: 0,0:19:03.30,0:19:07.85,Default,,0000,0000,0000,,وأخذت السيّارة المعدّلة وارتكبت\Nحادثة الاصطدام والهرب
Dialogue: 0,0:19:08.78,0:19:14.45,Default,,0000,0000,0000,,أوقفت السيّارة على فترات متقطّعة\Nكي يستطيع الصغار اللحاق بك
Dialogue: 0,0:19:15.01,0:19:19.91,Default,,0000,0000,0000,,وقدتهم لمقدمة المصنع بنهاية المطاف
Dialogue: 0,0:19:20.87,0:19:23.83,Default,,0000,0000,0000,,وأخفيت السيّارة في المخزن
Dialogue: 0,0:19:21.11,0:19:24.07,OS,,0000,0000,0000,,{\fs(18)\pos(261.818,79.091)}المصنع
Dialogue: 0,0:19:21.11,0:19:24.07,OS,,0000,0000,0000,,{\fs18\pos(333.636,208.182)}مكتب المصنع
Dialogue: 0,0:19:24.35,0:19:28.30,Default,,0000,0000,0000,,تالياً، اتّصلت بجدّة محلّ السجائر بهاتفك الخلويّ
Dialogue: 0,0:19:28.30,0:19:32.51,Default,,0000,0000,0000,,ومررت أمامها بينما كان ظهرها للشارع
Dialogue: 0,0:19:32.51,0:19:35.43,Default,,0000,0000,0000,,ودخلت المكتب من الباب الخلفيّ
Dialogue: 0,0:19:35.43,0:19:39.72,Default,,0000,0000,0000,,قتلت إيشيكورا-سان سريعاً واسترجعتَ الشريط اللاصق
Dialogue: 0,0:19:39.72,0:19:43.10,Default,,0000,0000,0000,,وجعلتها تبدو جريمة سطو وقتل
Dialogue: 0,0:19:43.10,0:19:46.57,Default,,0000,0000,0000,,أثرتَ الفوضى في الخزنة سلفاً على الأرجح
Dialogue: 0,0:19:47.61,0:19:53.26,Default,,0000,0000,0000,,عند مغادرتك للمكتب، اتّصلت بجدّة محلّ السجائر مُجدداً
Dialogue: 0,0:19:53.26,0:19:59.26,Default,,0000,0000,0000,,وأسرعت للسيّارة المخبّأة الأخرى، وأخرجتها
Dialogue: 0,0:19:59.16,0:20:02.80,OS,,0000,0000,0000,,{\fs18\pos(165.455,31.818)}السيّارة المخبّأة
Dialogue: 0,0:19:59.26,0:20:01.86,Default,,0000,0000,0000,,وانتظرت الصغار عند المنعطف
Dialogue: 0,0:20:03.30,0:20:09.60,Default,,0000,0000,0000,,كانت تلك سيّارتك الحقيقيّة  \Nبلوحة الأرقام الأصليّة بالطبع
Dialogue: 0,0:20:09.60,0:20:12.84,Default,,0000,0000,0000,,والتي قد تلاعبت بها كي تكون في حالٍ سيّئة سلفاً
Dialogue: 0,0:20:13.18,0:20:15.18,Default,,0000,0000,0000,,!حـ-حقّاً ذلك؟
Dialogue: 0,0:20:15.18,0:20:16.51,Default,,0000,0000,0000,,!يا للصدمة
Dialogue: 0,0:20:17.10,0:20:21.35,Default,,0000,0000,0000,,لا تعبث معي! السيّارة التي اصطدمت بها\N!هي نفسها التي اُحتجزت
Dialogue: 0,0:20:21.35,0:20:23.52,Default,,0000,0000,0000,,!ما دليلك على خلاف ذلك؟
Dialogue: 0,0:20:24.51,0:20:30.19,Default,,0000,0000,0000,,أيّها الضابط تاكاغي، أكان هناك وحل\Nعلى السيّارة المحتجزة؟
Dialogue: 0,0:20:31.02,0:20:31.97,Default,,0000,0000,0000,,وحل؟
Dialogue: 0,0:20:31.97,0:20:34.90,Default,,0000,0000,0000,,كلا، كانت نظيفةً كسيّارة جديدة
Dialogue: 0,0:20:36.10,0:20:38.62,Default,,0000,0000,0000,,كانت هناك بركة وحل بجوار المصنع
Dialogue: 0,0:20:39.18,0:20:45.12,Default,,0000,0000,0000,,لو عبرت سيّارة هناك، فيُفترض أنّه تناثر عليها
Dialogue: 0,0:20:45.55,0:20:49.43,Default,,0000,0000,0000,,أنت! أيوجد أيّ وحل على تلك السيّارة؟
Dialogue: 0,0:20:51.34,0:20:53.63,Default,,0000,0000,0000,,!أجل! يوجد! أسفل الهيكل
Dialogue: 0,0:20:54.01,0:20:58.80,Default,,0000,0000,0000,,كأنّي أعرف علاقة ذلك! زال الوحل\N!من سيّارتي أثناء القيادة
Dialogue: 0,0:20:59.69,0:21:05.02,Default,,0000,0000,0000,,أيّها المتحرّي! إذا كنتَ تدّعي أنّ هذه هي\Nالسيّارة المستعملة في حادثة الاصطدام، فلتثبت ذلك
Dialogue: 0,0:21:05.02,0:21:06.68,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:21:06.68,0:21:07.73,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:21:08.68,0:21:12.19,Default,,0000,0000,0000,,!ميتسوهيكو! فلتتّصل على أيومي-تشان بشارتك
Dialogue: 0,0:21:13.06,0:21:16.97,Default,,0000,0000,0000,,بالشارة؟ لكنّها فقدت شارتها
Dialogue: 0,0:21:16.97,0:21:18.51,Default,,0000,0000,0000,,لا يهمّ، اتّصل بها فحسب
Dialogue: 0,0:21:18.51,0:21:19.66,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:21:21.78,0:21:23.79,Default,,0000,0000,0000,,مرحباً؟ أيومي-تشان؟ أتستطيعين سماعي؟
Dialogue: 0,0:21:24.22,0:21:29.08,Default,,0000,0000,0000,,أجيبي إن كنتِ كذلك، أنا ميتسوهيكو! كيف حالك؟
Dialogue: 0,0:21:29.08,0:21:30.58,Default,,0000,0000,0000,,سنأتي لزيارتك لاحقاً
Dialogue: 0,0:21:31.23,0:21:34.12,Default,,0000,0000,0000,,!سيّدي المفتّش! وجدتُ هذه الشارة على السيّارة
Dialogue: 0,0:21:34.12,0:21:34.50,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:21:37.06,0:21:38.76,Default,,0000,0000,0000,,...تـ-تلك
Dialogue: 0,0:21:39.38,0:21:41.43,Default,,0000,0000,0000,,!إنّها شارة أيومي
Dialogue: 0,0:21:41.43,0:21:45.18,Default,,0000,0000,0000,,سقطت من جيبها وعلقت بالسيّارة\N!بعد حادثة الاصطدام
Dialogue: 0,0:21:45.51,0:21:49.35,Default,,0000,0000,0000,,،نويت استغلالنا لبناء حجّة غيابك
Dialogue: 0,0:21:49.35,0:21:52.72,Default,,0000,0000,0000,,لكنّها هُدمت وكشفت عن ذنبك بالمقابل
Dialogue: 0,0:21:56.44,0:22:00.16,Default,,0000,0000,0000,,!مـ-مستحيل! لا يُعقل هذا
Dialogue: 0,0:23:40.21,0:23:42.81,Default,,0000,0000,0000,,هاك يا أيومي-تشان، وجدنا شارتك
Dialogue: 0,0:23:45.55,0:23:47.25,Default,,0000,0000,0000,,!شكراً لك يا كونان-كن
Dialogue: 0,0:23:49.21,0:23:50.88,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:23:50.88,0:23:52.40,Default,,0000,0000,0000,,كيف لك هذا؟
Dialogue: 0,0:23:53.83,0:23:55.84,Default,,0000,0000,0000,,!أنت! كونان! أين قبّلتك؟
Dialogue: 0,0:23:55.84,0:23:57.54,Default,,0000,0000,0000,,!دعنا نقبّلك هناك
Dialogue: 0,0:24:02.75,0:24:04.78,Default,,0000,0000,0000,,ماذا؟ إنّه غير مقفل
Dialogue: 0,0:24:05.45,0:24:07.79,Default,,0000,0000,0000,,...يا للمنزل المهمل
Dialogue: 0,0:24:08.41,0:24:09.95,Default,,0000,0000,0000,,انقطاع تيّار؟
Dialogue: 0,0:24:22.75,0:24:24.51,Default,,0000,0000,0000,,!أثر طعن على ظهرها
Dialogue: 0,0:24:25.54,0:24:31.54,On Top,,0000,0000,0000,,جريمة قتل فصل الطهو الدراسيّ\N(الجزء الأوّل)
Dialogue: 0,0:24:26.45,0:24:27.87,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.87,0:24:31.18,Default,,0000,0000,0000,,جريمة قتل فصل الطهو الدراسيّ\N(الجزء الأوّل)
Dialogue: 0,0:24:47.73,0:24:49.94,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.94,0:24:51.56,Default,,0000,0000,0000,,جليد
Dialogue: 0,0:24:51.56,0:24:52.81,Default,,0000,0000,0000,,قضيّة الحلقة القادمة في\N!فصل طهو دراسيّ
Dialogue: 0,0:24:52.81,0:24:54.81,Default,,0000,0000,0000,,...ثم نضيف رشّة فلفل

