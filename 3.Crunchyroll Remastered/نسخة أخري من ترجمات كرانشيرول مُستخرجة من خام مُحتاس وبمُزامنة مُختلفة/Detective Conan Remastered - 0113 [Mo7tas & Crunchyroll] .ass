Dialogue: 0,0:00:01.14,0:00:04.39,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.39,0:00:06.51,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.51,0:00:10.26,Default,,0000,0000,0000,,!إنّه الصيف! المحيط! الشاطئ\N!حاذروا الحوادث المائيّة
Dialogue: 0,0:00:10.26,0:00:12.10,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.10,0:00:14.06,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.06,0:00:16.19,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.64,0:00:24.31,On Top,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.31,0:00:31.35,On Top,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:33.08,0:00:39.48,On Top,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.48,0:00:46.98,On Top,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.98,0:00:59.44,On Top,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.31,0:01:06.73,On Top,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.70,0:01:13.58,On Top,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.58,0:01:19.98,On Top,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.98,0:01:26.97,On Top,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.27,0:01:57.27,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل شاطئ الرمل الأبيض
Dialogue: 0,0:01:52.14,0:01:55.19,Default,,0000,0000,0000,,جريمة قتل شاطئ الرمل الأبيض
Dialogue: 0,0:02:05.34,0:02:07.22,Default,,0000,0000,0000,,يا لجمالها
Dialogue: 0,0:02:07.22,0:02:08.34,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:08.34,0:02:09.87,Default,,0000,0000,0000,,وعدد الناس قليلٌ هنا
Dialogue: 0,0:02:11.01,0:02:13.58,Default,,0000,0000,0000,,وجدنا مكاناً جميلاً بفضل أبي
Dialogue: 0,0:02:15.34,0:02:16.33,Default,,0000,0000,0000,,معكِ حقّ
Dialogue: 0,0:02:17.05,0:02:20.21,Default,,0000,0000,0000,,بالأحرى لسلوكه الطريق الخطأ
Dialogue: 0,0:02:27.59,0:02:29.51,Default,,0000,0000,0000,,!شعورٌ منعش
Dialogue: 0,0:02:29.51,0:02:34.30,Default,,0000,0000,0000,,...إذاً، القضيّة التي حلّيتُها ثانياً كانت
Dialogue: 0,0:02:34.30,0:02:35.06,Default,,0000,0000,0000,,...يا آنسة
Dialogue: 0,0:02:35.84,0:02:40.01,Default,,0000,0000,0000,,ماذا؟ أيّها الساقي، أين الآنسة\Nالتي كانت تشرب هنا؟
Dialogue: 0,0:02:40.01,0:02:42.18,Default,,0000,0000,0000,,غادرت منذ فترة
Dialogue: 0,0:02:42.18,0:02:43.65,Default,,0000,0000,0000,,حقّاً ذلك؟
Dialogue: 0,0:02:44.01,0:02:46.61,Default,,0000,0000,0000,,أبي! كنتُ أعرف أنّك ستكون هنا
Dialogue: 0,0:02:48.26,0:02:53.51,Default,,0000,0000,0000,,!ران وكونان! توقيتٌ ممتاز\N!تعالا واجلسا هنا
Dialogue: 0,0:02:53.51,0:02:56.58,Default,,0000,0000,0000,,!أيّها الساقي! كأس جعّة آخر، وكأسا عصير
Dialogue: 0,0:02:57.51,0:03:00.09,Default,,0000,0000,0000,,!لا داعي، سنأخذه ونغادر الآن
Dialogue: 0,0:03:00.09,0:03:03.22,Default,,0000,0000,0000,,لمَ؟ لم أشرب كفايتي بعد
Dialogue: 0,0:03:03.22,0:03:06.01,Default,,0000,0000,0000,,!ما الذي تتكلّم عنه؟ تجاوزت الساعة العاشرة
Dialogue: 0,0:03:06.34,0:03:09.34,Default,,0000,0000,0000,,أيّها العمّ، لن يليق بالعظيم موري كوغورو
Dialogue: 0,0:03:09.34,0:03:11.76,Default,,0000,0000,0000,,أن يثمل في مكانٍ كهذا، أليس كذلك؟
Dialogue: 0,0:03:13.55,0:03:16.18,Default,,0000,0000,0000,,أجل، معك حقّ
Dialogue: 0,0:03:17.64,0:03:19.61,Default,,0000,0000,0000,,يسهل التلاعب به
Dialogue: 0,0:03:20.68,0:03:24.57,Default,,0000,0000,0000,,المعذرة، أأنت ذاك المتحرّي\Nالشهير موري كوغورو-سان؟
Dialogue: 0,0:03:25.59,0:03:26.78,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:27.43,0:03:29.51,Default,,0000,0000,0000,,!مذهل
Dialogue: 0,0:03:29.51,0:03:33.43,Default,,0000,0000,0000,,هلّا جلست معنا وحكيت لنا\Nعن قضاياك التي حللتها؟
Dialogue: 0,0:03:33.43,0:03:34.24,Default,,0000,0000,0000,,!سندعوك على حسابنا
Dialogue: 0,0:03:35.39,0:03:37.64,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:03:37.64,0:03:39.51,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:03:39.51,0:03:40.60,Default,,0000,0000,0000,,!اصمت
Dialogue: 0,0:03:41.72,0:03:44.64,Default,,0000,0000,0000,,!كنّا نشرب كصديقين هنا
Dialogue: 0,0:03:44.64,0:03:48.26,Default,,0000,0000,0000,,سواء كنتَ متحرّياً شهيراً أم لا، ستشّل\Nإزعاجاً لا أكثر بصراحة
Dialogue: 0,0:03:49.18,0:03:50.22,Default,,0000,0000,0000,,!أنت! تاناكا
Dialogue: 0,0:03:50.84,0:03:53.01,Default,,0000,0000,0000,,أبي، لنرجع
Dialogue: 0,0:03:53.01,0:03:54.76,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:03:54.76,0:03:57.68,Default,,0000,0000,0000,,آسف، يبدو أنّه ثمل
Dialogue: 0,0:03:58.14,0:03:59.39,Default,,0000,0000,0000,,شخص بغيض
Dialogue: 0,0:04:04.09,0:04:05.68,Default,,0000,0000,0000,,!تاناكا-سان
Dialogue: 0,0:04:05.68,0:04:08.70,Default,,0000,0000,0000,,تاناكا-سان! هل رأيت ميتسوكو؟
Dialogue: 0,0:04:09.09,0:04:10.80,On Top,,0000,0000,0000,,اتّفقنا على اللقاء في محلّ
Dialogue: 0,0:04:09.09,0:04:14.04,CharCard,,0000,0000,0004,,{\fad(300,0)}يامادا توموكو\Nصديقة سيكيني ميتسوكو المقرّبة
Dialogue: 0,0:04:10.80,0:04:12.72,On Top,,0000,0000,0000,,قبل ساعة ولم تأتي
Dialogue: 0,0:04:12.72,0:04:13.91,On Top,,0000,0000,0000,,!ليست في المنزل أيضاً
Dialogue: 0,0:04:14.34,0:04:16.68,Default,,0000,0000,0000,,لا أدري، لم أرها
Dialogue: 0,0:04:16.68,0:04:19.87,Default,,0000,0000,0000,,كما لا علاقة تربطني بتلك المرأة
Dialogue: 0,0:04:20.68,0:04:22.17,Default,,0000,0000,0000,,هلّا غادرتِ؟
Dialogue: 0,0:04:34.01,0:04:35.26,Default,,0000,0000,0000,,...أشعر بتوعّك
Dialogue: 0,0:04:36.18,0:04:38.47,Default,,0000,0000,0000,,هذا أثر ثمالة بلا شكّ
Dialogue: 0,0:04:38.47,0:04:40.73,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:04:40.73,0:04:42.81,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:04:43.14,0:04:45.27,Default,,0000,0000,0000,,!الماء رائع! فلتأت للسباحة
Dialogue: 0,0:04:45.68,0:04:48.61,Default,,0000,0000,0000,,!لا أشعر بأيّ روعة! اسبحا كما تشاءان
Dialogue: 0,0:04:50.18,0:04:53.34,Default,,0000,0000,0000,,سمعتَه، لنسبح بمفردنا إذاً
Dialogue: 0,0:04:53.34,0:04:54.43,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:54.43,0:04:59.51,Default,,0000,0000,0000,,بالمناسبة، سمعتُ أنّ قاع الماء ينحدر \Nبسرعة أمامنا، لذا توخّ الحذر
Dialogue: 0,0:04:59.51,0:05:01.05,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:05:55.84,0:05:58.97,Default,,0000,0000,0000,,إذاً، أكنتَ من وجد الجثّة؟
Dialogue: 0,0:05:58.97,0:06:02.89,Default,,0000,0000,0000,,كلّا، كانا من اكتشفاها
Dialogue: 0,0:06:05.84,0:06:07.81,Default,,0000,0000,0000,,...هذا الحبل
Dialogue: 0,0:06:08.18,0:06:09.64,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:06:09.64,0:06:12.53,Default,,0000,0000,0000,,أنت! لا تتجوّل في المكان\N!وتعترض عمل الشرطة
Dialogue: 0,0:06:13.64,0:06:19.45,Default,,0000,0000,0000,,،أعتذر على التأخّر في التعريف بنفسي\Nأنا موري كوغورو، مُتحرٍّ خاص
Dialogue: 0,0:06:20.01,0:06:24.00,Default,,0000,0000,0000,,موري... أتقصد ذاك المتحرّي الشهير؟
Dialogue: 0,0:06:24.34,0:06:29.38,Default,,0000,0000,0000,,أجل! لم أعلم أنّ اسمي معروف\N!حتّى في بلدة بعيدة كهذه
Dialogue: 0,0:06:29.53,0:06:32.01,Default,,0000,0000,0000,,!إنّي مغلوب حقّاً
Dialogue: 0,0:06:32.39,0:06:35.22,Default,,0000,0000,0000,,يا إلهي، لست مغلوباً البتّة
Dialogue: 0,0:06:35.22,0:06:36.51,Default,,0000,0000,0000,,!ميتسوكو
Dialogue: 0,0:06:36.51,0:06:38.64,Default,,0000,0000,0000,,!ميتسوكو
Dialogue: 0,0:06:39.09,0:06:39.89,Default,,0000,0000,0000,,ميتسوكو؟
Dialogue: 0,0:06:42.05,0:06:45.56,Default,,0000,0000,0000,,أتعرفين الضحيّة يا آنسة؟
Dialogue: 0,0:06:46.76,0:06:51.02,Default,,0000,0000,0000,,أجل، إنّها سيكيني ميتسوكو، صديقتي المقرّبة
Dialogue: 0,0:06:51.84,0:06:53.31,Default,,0000,0000,0000,,...لم أتصوّر أن يحصل هذا لها
Dialogue: 0,0:06:54.51,0:06:56.36,Default,,0000,0000,0000,,المعذرة سيّدي المحقّق
Dialogue: 0,0:06:56.84,0:06:58.26,Default,,0000,0000,0000,,وصلت
Dialogue: 0,0:06:59.01,0:06:59.83,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:07:00.39,0:07:02.76,Default,,0000,0000,0000,,التقينا مُجدداً
Dialogue: 0,0:07:02.76,0:07:05.09,Default,,0000,0000,0000,,ماذا؟ أتعرفان بعضكما؟
Dialogue: 0,0:07:05.09,0:07:07.76,Default,,0000,0000,0000,,كلا، التقينا مصادفةً مرّةً لا أكثر
Dialogue: 0,0:07:07.76,0:07:09.47,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:07:09.47,0:07:15.01,Default,,0000,0000,0000,,في تلك الحالة، هذا الطبيب تاناكا\Nالذي طلبتُ منه فحص الجثّة
Dialogue: 0,0:07:15.01,0:07:17.05,Default,,0000,0000,0000,,!إنّه أبرع طبيب في هذه البلدة
Dialogue: 0,0:07:17.43,0:07:19.59,Default,,0000,0000,0000,,...يا للمقام
Dialogue: 0,0:07:19.59,0:07:24.47,Default,,0000,0000,0000,,!وهذا المتحرّي المعروف، موري كوغورو-سان
Dialogue: 0,0:07:24.47,0:07:25.98,Default,,0000,0000,0000,,سمعتك تسبقك
Dialogue: 0,0:07:26.68,0:07:31.57,Default,,0000,0000,0000,,إذا لم تمانع، فأتمنّى مساعدتك لنا في هذه القضيّة
Dialogue: 0,0:07:33.55,0:07:36.76,Default,,0000,0000,0000,,لا أمانع إطلاقاً
Dialogue: 0,0:07:36.76,0:07:40.72,Default,,0000,0000,0000,,!شكراً! فهذه بلدة هادئة صغيرة
Dialogue: 0,0:07:40.72,0:07:43.72,Default,,0000,0000,0000,,لسنا معتادين على حوادث كهذه البتّة
Dialogue: 0,0:07:43.72,0:07:45.50,Default,,0000,0000,0000,,المعذرة، ألا يُفترض بي بدء الفحص؟
Dialogue: 0,0:07:46.48,0:07:48.71,Default,,0000,0000,0000,,!صحيح! نسيت
Dialogue: 0,0:07:49.39,0:07:50.73,Default,,0000,0000,0000,,سأبدأ إذاً
Dialogue: 0,0:07:55.30,0:07:56.72,Default,,0000,0000,0000,,اعذريني
Dialogue: 0,0:08:05.55,0:08:07.43,Default,,0000,0000,0000,,إذاً حضرة الطبيب؟
Dialogue: 0,0:08:07.43,0:08:12.36,Default,,0000,0000,0000,,حسناً... لا أستطيع قول شيءٍ حتّى\Nنفحصها في المشفى
Dialogue: 0,0:08:13.30,0:08:15.32,Default,,0000,0000,0000,,لكن لعلّه كان انتحاراً
Dialogue: 0,0:08:16.09,0:08:17.03,Default,,0000,0000,0000,,انتحار؟
Dialogue: 0,0:08:17.59,0:08:21.84,Default,,0000,0000,0000,,انظر، لا توجد إصابات خارجيّة\Nأو آثار مقاومة البتّة
Dialogue: 0,0:08:21.84,0:08:24.84,Default,,0000,0000,0000,,لو كانت جريمة قتل، لوقع اشتباك بينما
Dialogue: 0,0:08:24.84,0:08:28.00,Default,,0000,0000,0000,,يحاول القاتل إغراقها في المحيط
Dialogue: 0,0:08:28.68,0:08:31.71,Default,,0000,0000,0000,,مع ذلك، لا توجد عليها أيّة ندب
Dialogue: 0,0:08:32.18,0:08:35.67,Default,,0000,0000,0000,,فهمت، فهمت، أنت محقّ تماماً
Dialogue: 0,0:08:36.18,0:08:40.14,Default,,0000,0000,0000,,لعلّها جدّفت في البحر بطوف أو ما شابه
Dialogue: 0,0:08:40.14,0:08:44.60,Default,,0000,0000,0000,,وربطت صخرةً بقدميها، وأغرقت نفسها
Dialogue: 0,0:08:45.18,0:08:47.18,Default,,0000,0000,0000,,ما خطب هذا الشخص؟
Dialogue: 0,0:08:47.18,0:08:49.93,Default,,0000,0000,0000,,يقول أنّه لا يستطيع أن يعرف\N،حتّى يفحص في المشفى
Dialogue: 0,0:08:49.93,0:08:52.56,Default,,0000,0000,0000,,لكن كأنّه يحاول فرض فكرة الانتحار
Dialogue: 0,0:08:52.97,0:08:56.72,Default,,0000,0000,0000,,رغم أنّ ذلك يبقى تخميني لا أكثر
Dialogue: 0,0:08:56.72,0:08:59.28,Default,,0000,0000,0000,,حسناً، هلّا نقلتم الجثّة للمشفى رجاءً؟
Dialogue: 0,0:08:59.76,0:09:01.39,Default,,0000,0000,0000,,سأرافقك في تلك الحالة
Dialogue: 0,0:09:04.09,0:09:05.29,Default,,0000,0000,0000,,...قاتل
Dialogue: 0,0:09:06.73,0:09:10.37,Default,,0000,0000,0000,,!لن تقدم ميتسوكو على الانتحار! قتلها ذاك الشخص
Dialogue: 0,0:09:14.52,0:09:18.31,Default,,0000,0000,0000,,أتقصدين بالقاتل ذاك الطبيب؟
Dialogue: 0,0:09:18.31,0:09:19.35,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:09:19.35,0:09:22.02,Default,,0000,0000,0000,,ألديكِ دليلٌ ما؟
Dialogue: 0,0:09:22.02,0:09:24.56,Default,,0000,0000,0000,,...لا دليل لديّ، لكن
Dialogue: 0,0:09:25.06,0:09:27.56,Default,,0000,0000,0000,,!كان ذلك الرجل يواعد ميتسوكو
Dialogue: 0,0:09:32.19,0:09:35.35,Default,,0000,0000,0000,,...لكن لم يبد عليه ذلك
Dialogue: 0,0:09:35.35,0:09:39.19,Default,,0000,0000,0000,,،وعد بأن يتزوّجها حتّى
Dialogue: 0,0:09:39.19,0:09:42.21,Default,,0000,0000,0000,,!لكنّه خطب ابنة مدير مشفى كبير
Dialogue: 0,0:09:42.21,0:09:44.58,Default,,0000,0000,0000,,...لذا كانت ميتسوكو عقبةً في طريقه
Dialogue: 0,0:09:45.48,0:09:47.35,Default,,0000,0000,0000,,!حتّى الآن، تظاهر بأنّه لا يعرفها
Dialogue: 0,0:09:47.35,0:09:52.30,Default,,0000,0000,0000,,أليس من الغريب أنّ لا تأثّر ظهر عليه\N!بعد موت حبيبته التي واعدها؟
Dialogue: 0,0:09:52.94,0:09:54.76,Default,,0000,0000,0000,,ذلك مُريب بالفعل
Dialogue: 0,0:09:55.39,0:09:56.98,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:09:56.98,0:10:01.39,Default,,0000,0000,0000,,حاول فرض فكرة الانتحار في تحليله قبل قليل
Dialogue: 0,0:10:01.81,0:10:07.60,Default,,0000,0000,0000,,وبناءً على حالة الجثّة، فهناك احتمالٌ عالٍ\N!بأنّه كان القاتل
Dialogue: 0,0:10:08.31,0:10:11.94,Default,,0000,0000,0000,,لكن في تلك الحالة، لمَ يقوم بشيءٍ بتلك الجرأة؟
Dialogue: 0,0:10:11.94,0:10:15.07,Default,,0000,0000,0000,,يقتلها بنفسه، ثم يفحص جثّتها؟
Dialogue: 0,0:10:15.85,0:10:22.23,Default,,0000,0000,0000,,حسناً يا آنسة، سأكشف أنا، المتحرّي العظيم\Nموري كوغورو، عن وجهه الحقيقيّ
Dialogue: 0,0:10:22.23,0:10:25.04,Default,,0000,0000,0000,,!وآخذ بثأر ميتسوكو-سان
Dialogue: 0,0:10:25.69,0:10:27.87,Default,,0000,0000,0000,,!حقّاً؟! من فضلك
Dialogue: 0,0:10:28.39,0:10:31.84,Default,,0000,0000,0000,,أستستطيع فعل هذا حقّاً يا عمّ؟
Dialogue: 0,0:10:32.44,0:10:34.80,CharCard,,0000,0000,0010,,مركز الشرطة
Dialogue: 0,0:10:35.13,0:10:39.19,Default,,0000,0000,0000,,بعد الفحص، تيقّنا بأنّها ماتت غرقاً
Dialogue: 0,0:10:39.19,0:10:41.72,Default,,0000,0000,0000,,تمّ استبعاد كلّ المسبّبات الأخرى
Dialogue: 0,0:10:42.48,0:10:46.56,Default,,0000,0000,0000,,وقت وفاتها المقدّر هو بعد العاشرة\Nبقليل من ليلة البارحة
Dialogue: 0,0:10:46.56,0:10:48.05,Default,,0000,0000,0000,,الطبيب تاناكا
Dialogue: 0,0:10:48.05,0:10:48.69,Default,,0000,0000,0000,,نعم؟
Dialogue: 0,0:10:48.69,0:10:53.65,Default,,0000,0000,0000,,سمعتُ شيئاً من صديقة الضحيّة\Nعلى الشاطئ قبل قليل
Dialogue: 0,0:10:54.31,0:10:59.61,Default,,0000,0000,0000,,أمن الصحيح أنّك كنتَ والضحيّة\Nميتسوكو-سان تتواعدان؟
Dialogue: 0,0:11:00.64,0:11:04.56,Default,,0000,0000,0000,,ماذا؟ أهذا صحيح يا طبيب تاناكا؟
Dialogue: 0,0:11:04.56,0:11:08.33,Default,,0000,0000,0000,,أعتذر، كان عليّ ذكر الأمر في البداية
Dialogue: 0,0:11:09.14,0:11:15.05,Default,,0000,0000,0000,,سمعت أنّك ستتزوّج ابنة\Nمدير مشفى كبير
Dialogue: 0,0:11:15.48,0:11:17.01,Default,,0000,0000,0000,,وما في ذلك؟
Dialogue: 0,0:11:17.64,0:11:20.93,Default,,0000,0000,0000,,ألم تكن ميتسوكو-سان\Nعقبةً في طريقك؟
Dialogue: 0,0:11:21.81,0:11:24.14,Default,,0000,0000,0000,,!ما الذي تلمّح له؟
Dialogue: 0,0:11:24.14,0:11:27.98,Default,,0000,0000,0000,,بدا غريباً لي لا أكثر أنّ شخصاً يملك دافعاً
Dialogue: 0,0:11:27.98,0:11:32.35,Default,,0000,0000,0000,,يقوم بإجراء تشريح بينما لم يتبين\Nما إن كانت الحادثة جريمة قتل أم انتحاراً
Dialogue: 0,0:11:32.35,0:11:33.85,Default,,0000,0000,0000,,كان انتحاراً بكلّ وضوح
Dialogue: 0,0:11:34.15,0:11:38.20,Default,,0000,0000,0000,,،كلا، لا يكفي عدم وجود إصابات خارجيّة\Nولم تكن هناك وصيّة حتّى
Dialogue: 0,0:11:38.99,0:11:45.67,Default,,0000,0000,0000,,أيمكنك إخبارنا أين كنت وما الذي\Nكنت تفعله وقت وفاتها المقدّر؟
Dialogue: 0,0:11:48.44,0:11:53.74,Default,,0000,0000,0000,,كنت أشرب في حانة رفقة صديق البارحة\Nمن الثامنة حتّى منتصف الليل
Dialogue: 0,0:11:53.74,0:11:56.93,Default,,0000,0000,0000,,صحيح، تلك الحانة التي التقيتك فيها
Dialogue: 0,0:11:57.49,0:11:58.39,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:58.61,0:12:05.03,Default,,0000,0000,0000,,سيستغرق ذهابك من تلك الحانة للشاطئ\Nالذي كانت عليه الجثّة 10 دقائق بالسيّارة، دون العودة
Dialogue: 0,0:12:05.03,0:12:10.24,Default,,0000,0000,0000,,يمكنك مراجعة الساقي وصديقي إذا أردت
Dialogue: 0,0:12:10.24,0:12:14.32,Default,,0000,0000,0000,,والتأكّد ما إن تركت مقعدي لتلك الفترة
Dialogue: 0,0:12:16.28,0:12:22.57,Default,,0000,0000,0000,,بالمناسبة، أتيت مع كونان لجلبك\Nبعد العاشرة بقليل يا أبي
Dialogue: 0,0:12:22.57,0:12:23.29,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:12:23.78,0:12:28.50,Default,,0000,0000,0000,,أي أنّ بإمكانك أن تشهد\Nبحجّة غيابي يا موري-سان
Dialogue: 0,0:12:30.86,0:12:36.14,Default,,0000,0000,0000,,إنّها حجّة غياب مطبقة... أهذا مصدر ثقته؟
Dialogue: 0,0:12:36.32,0:12:43.10,Default,,0000,0000,0000,,!لـ-لكنّك من أعطى وقت الوفاة المقدّر\N!سنحتاج لرأي شخصٍ آخر
Dialogue: 0,0:12:43.78,0:12:45.94,Default,,0000,0000,0000,,تفضّلوا
Dialogue: 0,0:12:45.94,0:12:51.03,Default,,0000,0000,0000,,لكنك ستتحمّل المسؤولية\Nإذا ثبتت براءتي
Dialogue: 0,0:12:51.03,0:12:51.78,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:12:52.44,0:12:55.28,Default,,0000,0000,0000,,!حضرة المحقّق، قم بالتجهيزات فوراً
Dialogue: 0,0:12:55.28,0:12:55.74,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:12:56.19,0:13:01.20,Default,,0000,0000,0000,,حضرة المحقّق، قد يستغرق هذا وقتاً\Nفهل يمكنني المغادرة؟
Dialogue: 0,0:13:01.49,0:13:03.94,Default,,0000,0000,0000,,لا أمانع ذلك
Dialogue: 0,0:13:03.94,0:13:09.69,Default,,0000,0000,0000,,أيوجد مكان حيث أستطيع استعارة\Nدرّاجة إذاً؟ أريد استكشاف المنطقة
Dialogue: 0,0:13:10.50,0:13:11.21,Default,,0000,0000,0000,,...في تلك الحالة
Dialogue: 0,0:13:14.51,0:13:16.36,Default,,0000,0000,0000,,،بناءً على ثقته المفرطة
Dialogue: 0,0:13:16.36,0:13:21.40,Default,,0000,0000,0000,,ستعطي إعادة التقدير النتيجة نفسها
Dialogue: 0,0:13:21.40,0:13:24.52,Default,,0000,0000,0000,,...لا بد من وجود حيلة! شيء ما
Dialogue: 0,0:13:25.11,0:13:26.82,Default,,0000,0000,0000,,...لا بدّ أن أطيح
Dialogue: 0,0:13:28.20,0:13:30.82,Default,,0000,0000,0000,,!بحجّة غيابه
Dialogue: 0,0:13:40.11,0:13:43.24,Default,,0000,0000,0000,,أتجلس وتراقب البحر\Nهنا عادةً يا عمّ؟
Dialogue: 0,0:13:43.24,0:13:44.28,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:44.28,0:13:45.44,Default,,0000,0000,0000,,وبالأمس؟
Dialogue: 0,0:13:45.44,0:13:46.61,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:46.61,0:13:48.64,Default,,0000,0000,0000,,هل لاحظت أمراً غريباً؟
Dialogue: 0,0:13:48.64,0:13:50.88,Default,,0000,0000,0000,,لا شيء
Dialogue: 0,0:13:51.44,0:13:53.11,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:13:53.11,0:13:59.11,Default,,0000,0000,0000,,الشيء الغريب الوحيد هنا هو القمامة\Nالتي تحملها الأمواج للمكان كلّ يوم
Dialogue: 0,0:13:59.11,0:13:59.84,Default,,0000,0000,0000,,القمامة؟
Dialogue: 0,0:14:00.28,0:14:07.52,Default,,0000,0000,0000,,أجل، كلّ قمامة هذه المياه تُحمل\Nإلى هنا بسبب المد
Dialogue: 0,0:14:08.19,0:14:09.48,Default,,0000,0000,0000,,...القمامة إذاً
Dialogue: 0,0:14:10.07,0:14:12.44,Default,,0000,0000,0000,,أين تلك القمامة؟
Dialogue: 0,0:14:12.44,0:14:14.44,Default,,0000,0000,0000,,جمعتها في الخلف
Dialogue: 0,0:14:16.44,0:14:20.87,Default,,0000,0000,0000,,!يا إلهي، المحيط ليس مكبّ قمامة
Dialogue: 0,0:14:22.32,0:14:26.54,Default,,0000,0000,0000,,،إطار هوائيّ... لا يزال جديداً\Nفهل هو ممزق في مكان؟
Dialogue: 0,0:14:27.61,0:14:30.50,Default,,0000,0000,0000,,هنا إذاً؟ توجد فتحة صغيرة
Dialogue: 0,0:14:31.40,0:14:34.57,Default,,0000,0000,0000,,فتحة؟ صغيرة؟
Dialogue: 0,0:14:34.57,0:14:37.42,Default,,0000,0000,0000,,...فهمت! أيمكن
Dialogue: 0,0:14:38.19,0:14:40.19,Default,,0000,0000,0000,,أخبرني يا عمّ
Dialogue: 0,0:14:41.15,0:14:43.43,Default,,0000,0000,0000,,هل جُرف هذا الإطار الهوائيّ اليوم؟
Dialogue: 0,0:14:43.82,0:14:45.28,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:14:45.28,0:14:47.11,Default,,0000,0000,0000,,أيمكنني أخذه؟
Dialogue: 0,0:14:47.11,0:14:48.35,Default,,0000,0000,0000,,لا مشكلة
Dialogue: 0,0:14:48.82,0:14:53.11,Default,,0000,0000,0000,,وأيمكنني أخذ القليل من هذه\Nالقنّينات البلاستيكية الفارغة أيضاً؟
Dialogue: 0,0:14:53.49,0:14:58.32,Default,,0000,0000,0000,,أجل، لا أدري فيمَ ستستعملها\Nلكن خذ ما تشاء
Dialogue: 0,0:15:01.36,0:15:04.62,Default,,0000,0000,0000,,تيّار المد والإطار الهوائيّ المثقوب
Dialogue: 0,0:15:05.36,0:15:09.37,Default,,0000,0000,0000,,إذا أصاب استنتاجي، فسيتوضّح كلّ شيء\Nبهذه القنّينات البلاستيكية
Dialogue: 0,0:15:28.11,0:15:31.02,Default,,0000,0000,0000,,حسناً، عليّ الانتظار عند الشاطئ الآن فقط
Dialogue: 0,0:15:40.11,0:15:40.95,Default,,0000,0000,0000,,!ها هي
Dialogue: 0,0:15:49.19,0:15:53.75,Default,,0000,0000,0000,,كما ظننت! ما تبقّى هو المتجر الذي\N!باع ذاك الإطار الهوائيّ
Dialogue: 0,0:15:56.86,0:16:01.67,Default,,0000,0000,0000,,طابقتْ نتيجة إعادة التقدير\Nنتيجتي يا موري-سان
Dialogue: 0,0:16:04.32,0:16:07.90,Default,,0000,0000,0000,,حسناً، كيف ستبرّر نفسك يا موري-سان؟
Dialogue: 0,0:16:07.90,0:16:11.94,Default,,0000,0000,0000,,تشتبه بأناس بريئين، أهذا ما يفعله المتحرّون العظماء؟
Dialogue: 0,0:16:11.94,0:16:15.14,Default,,0000,0000,0000,,حسناً، في الواقع... اعذرني قليلاً
Dialogue: 0,0:16:16.24,0:16:18.07,Default,,0000,0000,0000,,ماذا؟ تهرب؟
Dialogue: 0,0:16:18.53,0:16:21.28,Default,,0000,0000,0000,,كلا، سأذهب لدورة المياه، فأنا على وشك تبليل نفسي
Dialogue: 0,0:16:24.44,0:16:29.08,Default,,0000,0000,0000,,تبّاً، كنت متأكداً أنّه كان مريباً
Dialogue: 0,0:16:33.11,0:16:35.42,Default,,0000,0000,0000,,!ها هي، أتت
Dialogue: 0,0:16:35.82,0:16:38.32,Default,,0000,0000,0000,,ما كان ذلك الصوت؟
Dialogue: 0,0:16:38.32,0:16:39.13,Default,,0000,0000,0000,,أبي؟
Dialogue: 0,0:16:39.61,0:16:44.09,Default,,0000,0000,0000,,أعتذر على الإطالة جميعاً، تعالوا للغرفة المجاورة رجاءً
Dialogue: 0,0:16:44.61,0:16:46.05,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:16:47.57,0:16:49.01,Default,,0000,0000,0000,,ما الأمر يا موري-سان؟
Dialogue: 0,0:16:50.69,0:16:52.78,Default,,0000,0000,0000,,تغيّر الغرفة لإعادة ضبط موقفك؟
Dialogue: 0,0:16:52.78,0:16:53.93,Default,,0000,0000,0000,,نوعاً ما
Dialogue: 0,0:16:54.57,0:16:58.90,Default,,0000,0000,0000,,إذاً يا جماعة، دعوني أكشف حقيقة هذه الحادثة
Dialogue: 0,0:17:00.86,0:17:07.82,Default,,0000,0000,0000,,كانت جريمة قتل! والقاتل هو أنت\N!أيّها الطبيب تاناكا
Dialogue: 0,0:17:10.28,0:17:16.25,Default,,0000,0000,0000,,لكن يا موري-سان، ألم نتحقّق من امتلاك\Nالطبيب تاناكا لحجّة غياب؟
Dialogue: 0,0:17:16.65,0:17:22.21,Default,,0000,0000,0000,,أجل، كان في الحانة أثناء\Nوقت وفاة الضحيّة المقدّر
Dialogue: 0,0:17:22.82,0:17:26.18,Default,,0000,0000,0000,,قتلها وهو يشرب
Dialogue: 0,0:17:26.61,0:17:28.84,Default,,0000,0000,0000,,أ-أذلك ممكن؟
Dialogue: 0,0:17:29.61,0:17:35.31,Default,,0000,0000,0000,,لا شكّ أنّها لقيت حتفها في المكان\Nالذي اكتشفها كونان وران فيه
Dialogue: 0,0:17:35.69,0:17:40.27,Default,,0000,0000,0000,,لكن وقعت الجريمة الحقيقيّة في مكانٍ مختلف
Dialogue: 0,0:17:41.28,0:17:45.24,Default,,0000,0000,0000,,استدعاها تاناكا-سان لمكان مختلف أوّلاً
Dialogue: 0,0:17:46.44,0:17:49.70,Default,,0000,0000,0000,,وأفقدها وعيها بكلوروفورم أو وما شابه
Dialogue: 0,0:17:50.65,0:17:55.66,Default,,0000,0000,0000,,لن يكون صعباً الحصول على تلك\Nالعقارات على طبيب مثلك
Dialogue: 0,0:17:56.11,0:18:00.58,Default,,0000,0000,0000,,ثمّ استُخدِم حبل لربط صخرة كبيرة بقدميها
Dialogue: 0,0:18:01.07,0:18:03.94,Default,,0000,0000,0000,,ووضعتها في إطار هوائيّ\Nبه ثقب صغير
Dialogue: 0,0:18:03.94,0:18:06.61,Default,,0000,0000,0000,,وتركتها تعوم في المحيط
Dialogue: 0,0:18:06.61,0:18:12.28,Default,,0000,0000,0000,,بعد ذلك، توجّهت للحانة مع رفيقك للشراب
Dialogue: 0,0:18:12.28,0:18:13.81,Default,,0000,0000,0000,,لبناء حجّة غيابك
Dialogue: 0,0:18:14.65,0:18:21.11,Default,,0000,0000,0000,,أثناء ذلك، كان التيّار يتلاعب بميتسوكو-سان\Nوهي لا تزال حيّة
Dialogue: 0,0:18:22.19,0:18:28.57,Default,,0000,0000,0000,,يوجد تيّار مد وجزر هنا يتدفق\Nنحو منطقة السباحة
Dialogue: 0,0:18:29.15,0:18:34.04,Default,,0000,0000,0000,,فجُرفت للشاطئ وهي حيّة
Dialogue: 0,0:18:34.65,0:18:40.13,Default,,0000,0000,0000,,...واصل الهواء التسرّب من الإطار، وبنهاية المطاف
Dialogue: 0,0:18:41.94,0:18:45.44,Default,,0000,0000,0000,,لم يعد الإطار قادراً على رفع وزنها
Dialogue: 0,0:18:45.44,0:18:49.13,Default,,0000,0000,0000,,فغرقت ميتسوكو-سان في البحر
Dialogue: 0,0:18:49.78,0:18:53.80,Default,,0000,0000,0000,,بينما كنت تشرب في الحانة
Dialogue: 0,0:18:56.78,0:19:00.53,Default,,0000,0000,0000,,،بناءً على سرعة تفرغ هواء الإطار
Dialogue: 0,0:19:00.53,0:19:04.36,Default,,0000,0000,0000,,فقد رميتها في البحر عند قرابة السابعة غالباً
Dialogue: 0,0:19:05.36,0:19:08.74,Default,,0000,0000,0000,,وصلت عند الحانة في الثامنة البارحة
Dialogue: 0,0:19:08.74,0:19:11.78,Default,,0000,0000,0000,,أيمكنك إثبات حجّة غيابك للسابعة؟
Dialogue: 0,0:19:12.11,0:19:15.32,Default,,0000,0000,0000,,!سخافة! هذا مجرّد تخمين
Dialogue: 0,0:19:15.32,0:19:19.25,Default,,0000,0000,0000,,كان بإمكانها استعمال الإطار\N!الهوائيّ للانتحار أيضاً
Dialogue: 0,0:19:19.74,0:19:22.21,Default,,0000,0000,0000,,ذلك ليس محتملاً
Dialogue: 0,0:19:22.57,0:19:23.49,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:19:23.49,0:19:27.86,Default,,0000,0000,0000,,حضرة المحقّق، فلتره الصورة التي \Nاُلتقطت لقدمَي الضحيّة
Dialogue: 0,0:19:31.82,0:19:33.53,Default,,0000,0000,0000,,هذه هي
Dialogue: 0,0:19:33.53,0:19:34.43,Default,,0000,0000,0000,,حسناً، ران
Dialogue: 0,0:19:35.03,0:19:39.19,Default,,0000,0000,0000,,اربطي قدميك مثلما في الصورة
Dialogue: 0,0:19:39.19,0:19:39.85,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:19:43.24,0:19:44.90,Default,,0000,0000,0000,,انتهيت يا أبي
Dialogue: 0,0:19:44.90,0:19:50.28,Default,,0000,0000,0000,,حضرة المحقّق، قارن الصورة بقدمَي ران من فضلك
Dialogue: 0,0:19:51.15,0:19:53.94,Default,,0000,0000,0000,,العُقدة معكوسة
Dialogue: 0,0:19:54.24,0:20:00.25,Default,,0000,0000,0000,,في العادة، ستنتج عقدة مثل التي ربطتها\Nران عندما تربط قدميك بنفسك
Dialogue: 0,0:20:00.47,0:20:04.26,Default,,0000,0000,0000,,فلمَ العقدة في الصورة مقلوبة؟
Dialogue: 0,0:20:04.74,0:20:08.60,Default,,0000,0000,0000,,لأنّ القاتل ربط قدميها مقابلاً لها
Dialogue: 0,0:20:09.24,0:20:11.89,Default,,0000,0000,0000,,!لا يعني ذلك أنّي القاتل
Dialogue: 0,0:20:12.24,0:20:17.60,Default,,0000,0000,0000,,وجد كونان إطاراً هوائياً جديداً\Nبثقب صغير على الشاطئ
Dialogue: 0,0:20:20.41,0:20:22.07,Default,,0000,0000,0000,,ها هو حضرة المحقّق
Dialogue: 0,0:20:23.87,0:20:26.78,Default,,0000,0000,0000,,هذا هو الإطار الذي استعملته\Nفي الجريمة، أليس كذلك؟
Dialogue: 0,0:20:27.08,0:20:29.74,Default,,0000,0000,0000,,!لـ-لم أره قبلاً
Dialogue: 0,0:20:30.24,0:20:34.54,Default,,0000,0000,0000,,كان إيجاد المتجر الذي اشتريته منه سهلاً
Dialogue: 0,0:20:35.20,0:20:38.12,Default,,0000,0000,0000,,فهي بلدة صغيرة
Dialogue: 0,0:20:38.62,0:20:43.09,Default,,0000,0000,0000,,هذا هو الإطار الهوائيّ الذي اشتراه\Nالطبيب تاناكا الأسبوع الفائت
Dialogue: 0,0:20:43.33,0:20:47.97,Default,,0000,0000,0000,,لكنّه قال أنّه سيعطيه لابنة\Nأحد معارفه، هذا غريب
Dialogue: 0,0:20:48.45,0:20:53.56,Default,,0000,0000,0000,,تذكّرت مالكة المحلّ شراءك له بوضوح
Dialogue: 0,0:20:54.24,0:20:57.79,Default,,0000,0000,0000,,ولا بدّ أنّك كنت واثقاً\Nجدّاً بهذه الحيلة
Dialogue: 0,0:20:57.79,0:21:01.31,Default,,0000,0000,0000,,بحيث لم تمح بصماتك من على الإطار
Dialogue: 0,0:21:02.54,0:21:07.12,Default,,0000,0000,0000,,حسناً، لمَ توجد بصماتك على الإطار الذي
Dialogue: 0,0:21:07.12,0:21:10.49,Default,,0000,0000,0000,,قلت أنّك لم تره قبلاً؟
Dialogue: 0,0:21:10.99,0:21:12.99,Default,,0000,0000,0000,,...طبيب تاناكا! أأنت
Dialogue: 0,0:22:54.94,0:22:57.50,Default,,0000,0000,0000,,ليتنا استطعنا البقاء يوماً آخر
Dialogue: 0,0:22:58.40,0:23:01.71,Default,,0000,0000,0000,,إذاً يا أبي، لا نمانع إذا\Nسلكت الطريق الخطأ مُجدداً
Dialogue: 0,0:23:02.03,0:23:06.74,Default,,0000,0000,0000,,!يا-يا حمقاء! لم أخطئ في الطريق بالأمس
Dialogue: 0,0:23:06.74,0:23:10.82,Default,,0000,0000,0000,,!بل استدعت قضيّةٌ المتحرّي العظيم موري كوغورو
Dialogue: 0,0:23:10.82,0:23:13.35,Default,,0000,0000,0000,,وإلّا يستحيل أن أسلك الطريق الخطأ
Dialogue: 0,0:23:14.36,0:23:16.68,Default,,0000,0000,0000,,لكنّك أخطأت في النهاية
Dialogue: 0,0:23:19.74,0:23:22.19,Default,,0000,0000,0000,,ما الذي حصل يا أبي؟
Dialogue: 0,0:23:22.65,0:23:25.32,Default,,0000,0000,0000,,هذا الشاطئ الذي غادرناه قبل لقليل
Dialogue: 0,0:23:25.32,0:23:26.90,Default,,0000,0000,0000,,...هذا غريب
Dialogue: 0,0:23:27.19,0:23:32.62,Default,,0000,0000,0000,,!فهمت، استدعانا البحر لنبيت ليلةً أخرى
Dialogue: 0,0:23:33.03,0:23:35.58,Default,,0000,0000,0000,,أحمق، يستحيل ذلك
Dialogue: 0,0:23:35.95,0:23:40.11,Default,,0000,0000,0000,,لكنّك قلت أنّك لن تخطئ\Nفي الطريق بخلاف ذلك، صحيح؟
Dialogue: 0,0:23:40.11,0:23:44.29,Default,,0000,0000,0000,,!أجل! لم يكن الأمر باليد، فالبحر استدعانا
Dialogue: 0,0:23:45.57,0:23:46.49,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:23:46.49,0:23:47.78,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:23:47.78,0:23:52.01,Default,,0000,0000,0000,,صحيح، وإلّا يستحيل أن أسلك الطريق الخطأ
Dialogue: 0,0:23:52.44,0:23:55.49,Default,,0000,0000,0000,,!حسنٌ! لنبت ليلة أخرى
Dialogue: 0,0:23:56.69,0:23:59.32,Default,,0000,0000,0000,,يسهل التلاعب به حقّاً
Dialogue: 0,0:24:05.44,0:24:06.69,Default,,0000,0000,0000,,هنالك أمرٌ غريب
Dialogue: 0,0:24:09.81,0:24:11.19,Default,,0000,0000,0000,,!إنّها تغرق
Dialogue: 0,0:24:11.60,0:24:13.30,Default,,0000,0000,0000,,ما-ما كان ذلك؟
Dialogue: 0,0:24:16.11,0:24:17.82,Default,,0000,0000,0000,,...تـ-تلك
Dialogue: 0,0:24:17.82,0:24:19.28,Default,,0000,0000,0000,,!لا تحرّكوها
Dialogue: 0,0:24:20.00,0:24:23.17,Default,,0000,0000,0000,,!ربما عضّت أفعى بحرية كيواكو-سان
Dialogue: 0,0:24:23.42,0:24:25.63,Default,,0000,0000,0000,,!ها هي! آثار عضّ
Dialogue: 0,0:24:25.63,0:24:31.63,On Top,,0000,0000,0000,,جريمة قتل غوص السكوبا \N(الجزء الأوّل)
Dialogue: 0,0:24:26.73,0:24:28.14,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:28.14,0:24:31.83,Default,,0000,0000,0000,,جريمة قتل غوص السكوبا \N(الجزء الأوّل)
Dialogue: 0,0:24:47.39,0:24:49.80,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:50.05,0:24:51.38,Default,,0000,0000,0000,,ريش
Dialogue: 0,0:24:51.86,0:24:54.73,Default,,0000,0000,0000,,!سنذهب لغوص السكوبا في الحلقة القادمة
Dialogue: 0,0:24:54.73,0:24:56.73,Default,,0000,0000,0000,,!ترقّبوها

