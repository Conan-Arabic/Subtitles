Dialogue: 0,0:00:00.89,0:00:02.25,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.25,0:00:05.12,Default,,0000,0000,0000,,تعرّض جسم طالب الثانوية كودو شينتشي\Nللتقلّص بفعل منظمة غامضة
Dialogue: 0,0:00:05.38,0:00:07.47,Default,,0000,0000,0000,,إن وجدوا أنّ شينتشي وكونان هما الشخص نفسه
Dialogue: 0,0:00:07.47,0:00:09.37,Default,,0000,0000,0000,,!سيقع جميع من حولي في خطر
Dialogue: 0,0:00:09.37,0:00:11.00,Default,,0000,0000,0000,,لا يمكنني إخبار صديقة طفولتي ران
Dialogue: 0,0:00:11.00,0:00:13.54,Default,,0000,0000,0000,,!أو والدها المتحرّي، العمّ كوغورو، فأخفي هويّتي
Dialogue: 0,0:00:13.54,0:00:15.29,Default,,0000,0000,0000,,!واليوم تبقى الحقيقة واحدة دوماً
Dialogue: 0,0:01:47.12,0:01:50.20,Default,,0000,0000,0000,,جريمة قتل جامع الآثار
Dialogue: 0,0:01:53.03,0:01:54.93,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:01:56.02,0:01:58.18,Default,,0000,0000,0000,,زوجتك تخونك
Dialogue: 0,0:01:58.18,0:01:59.02,Default,,0000,0000,0000,,!كنتُ أعرف
Dialogue: 0,0:01:59.36,0:02:01.69,Default,,0000,0000,0000,,انظر للشامة تحت عينها
Dialogue: 0,0:02:01.69,0:02:06.52,Default,,0000,0000,0000,,تلك المرأة ليست سوى زوجتك نفسها، مارو إينيكو-سان
Dialogue: 0,0:02:12.43,0:02:13.57,Default,,0000,0000,0000,,!قفزت مجدداً
Dialogue: 0,0:02:13.57,0:02:17.50,Default,,0000,0000,0000,,يا إلهي، إلى متى سيجعلنا العم كوغورو ننتظر؟
Dialogue: 0,0:02:17.50,0:02:19.90,Default,,0000,0000,0000,,قال أنّه سيدعونا للأكل من باب التغيير
Dialogue: 0,0:02:20.13,0:02:22.23,Default,,0000,0000,0000,,لكن كان عليه المرور بهذا المكان أوّلاً
Dialogue: 0,0:02:22.71,0:02:25.62,Default,,0000,0000,0000,,أيّ مُتحرٍّ في عقله سيصطحب صبياً
Dialogue: 0,0:02:25.62,0:02:28.16,Default,,0000,0000,0000,,عند إخبار عميل بعلاقة زوجته العاطفية؟
Dialogue: 0,0:02:28.16,0:02:29.56,Default,,0000,0000,0000,,زائر؟
Dialogue: 0,0:02:29.56,0:02:32.02,Default,,0000,0000,0000,,!من هذا الرجل؟
Dialogue: 0,0:02:32.70,0:02:34.49,Default,,0000,0000,0000,,...لا أعرف بعد
Dialogue: 0,0:02:35.48,0:02:37.36,Default,,0000,0000,0000,,زائر؟
Dialogue: 0,0:02:37.36,0:02:40.69,Default,,0000,0000,0000,,!ردّوا على الباب! ألا يوجد أحد؟
Dialogue: 0,0:02:40.69,0:02:41.82,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:02:42.36,0:02:47.77,Default,,0000,0000,0000,,طلبت من مُدبّرات المنزل إهدار\Nبعض الوقت خارجاً بما أنّك كنت قادماً
Dialogue: 0,0:02:48.22,0:02:51.39,Default,,0000,0000,0000,,اعذرني بينما أصطحب ضيفي للكوخ
Dialogue: 0,0:02:51.39,0:02:52.56,Default,,0000,0000,0000,,سأعود سريعاً
Dialogue: 0,0:02:52.56,0:02:54.33,Default,,0000,0000,0000,,خذ وقتك
Dialogue: 0,0:03:02.00,0:03:05.74,Default,,0000,0000,0000,,أعتذر على الإطالة، لنذهب للكوخ
Dialogue: 0,0:03:20.15,0:03:23.07,Default,,0000,0000,0000,,!يا للإزعاج! ما الذي يفعله ذلك الرجل؟
Dialogue: 0,0:03:23.07,0:03:26.60,Default,,0000,0000,0000,,لا يمكنه السماع لأنّه في الكوخ غالباً
Dialogue: 0,0:03:30.93,0:03:32.57,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:03:41.09,0:03:42.55,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:03:42.55,0:03:44.28,Default,,0000,0000,0000,,ألم تسمعي صوتاً غريباً؟
Dialogue: 0,0:03:44.71,0:03:46.85,Default,,0000,0000,0000,,كلا، لم أسمع شيئاً
Dialogue: 0,0:03:52.41,0:03:54.81,Default,,0000,0000,0000,,ألم يتأخر ذاك الرجل؟
Dialogue: 0,0:03:54.81,0:03:56.28,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:03:56.28,0:03:58.19,Default,,0000,0000,0000,,ما الذي يفعله يا ترى؟
Dialogue: 0,0:04:01.32,0:04:03.19,Default,,0000,0000,0000,,ماذا؟ أغلق الخطّ؟
Dialogue: 0,0:04:03.61,0:04:05.89,Default,,0000,0000,0000,,أغلقه بعد رنّة واحدة؟
Dialogue: 0,0:04:06.14,0:04:10.43,Default,,0000,0000,0000,,!ما الذي يفعله ذاك الرجل؟ مضت ساعتان
Dialogue: 0,0:04:13.18,0:04:16.06,Default,,0000,0000,0000,,رنّة واحدة مُجدداً، ما الذي يجري؟
Dialogue: 0,0:04:16.38,0:04:19.56,Default,,0000,0000,0000,,!اكتفيت! سأذهب للكوخ
Dialogue: 0,0:04:24.63,0:04:27.25,Default,,0000,0000,0000,,...أشعر بالجوع
Dialogue: 0,0:04:27.25,0:04:28.27,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:04:30.75,0:04:32.21,Default,,0000,0000,0000,,!ماذا هناك؟
Dialogue: 0,0:04:32.21,0:04:35.20,Default,,0000,0000,0000,,!من أنتم؟
Dialogue: 0,0:04:35.20,0:04:37.24,Default,,0000,0000,0000,,!بل من أنتما؟
Dialogue: 0,0:04:37.24,0:04:39.53,Default,,0000,0000,0000,,!نحن مدبّرتا هذا المنزل
Dialogue: 0,0:04:39.53,0:04:42.32,Default,,0000,0000,0000,,لمَ هذه الجلبة؟
Dialogue: 0,0:04:42.32,0:04:43.32,Default,,0000,0000,0000,,!سيّدتي
Dialogue: 0,0:04:43.32,0:04:45.27,Default,,0000,0000,0000,,ما الذي يجري بالضبط؟
Dialogue: 0,0:04:45.64,0:04:48.60,Default,,0000,0000,0000,,!وجدتُ هذا الرجل يتطفل في البيت
Dialogue: 0,0:04:48.98,0:04:50.52,Default,,0000,0000,0000,,!لصّ؟
Dialogue: 0,0:04:50.81,0:04:54.49,Default,,0000,0000,0000,,!كـ-كلا! أنا مُتحرٍّ عيّنه مالك هذا البيت
Dialogue: 0,0:04:54.93,0:04:55.98,Default,,0000,0000,0000,,مُتحرٍّ؟
Dialogue: 0,0:04:57.47,0:04:59.55,Default,,0000,0000,0000,,وما لدى المتحرّي هنا؟
Dialogue: 0,0:04:59.55,0:05:01.69,Default,,0000,0000,0000,,...عليك سؤال زوجك شخصياً
Dialogue: 0,0:05:01.69,0:05:03.26,Default,,0000,0000,0000,,أين زوجي؟
Dialogue: 0,0:05:03.26,0:05:06.71,Default,,0000,0000,0000,,ذهب للكوخ ولم يعد بعد
Dialogue: 0,0:05:06.71,0:05:09.19,Default,,0000,0000,0000,,ناديا على زوجي
Dialogue: 0,0:05:09.19,0:05:10.54,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:05:13.00,0:05:14.98,Default,,0000,0000,0000,,إذاً، كم عرفت؟
Dialogue: 0,0:05:15.81,0:05:20.36,Default,,0000,0000,0000,,!سأدفع لك ضعف ما سيعطيك\N!فقط ابق أمر علاقتي سرّاً
Dialogue: 0,0:05:20.36,0:05:22.02,Default,,0000,0000,0000,,...لـ-لحظة، سيّدتي
Dialogue: 0,0:05:29.06,0:05:30.01,Default,,0000,0000,0000,,!ما الخطب؟
Dialogue: 0,0:05:44.92,0:05:45.85,Default,,0000,0000,0000,,!عزيزي
Dialogue: 0,0:05:46.17,0:05:48.31,Default,,0000,0000,0000,,!ران! اتّصلي بالشرطة
Dialogue: 0,0:05:48.83,0:05:50.21,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:05:53.08,0:05:56.28,Default,,0000,0000,0000,,الضحيّة مارو دينجيرو، 51 عاماً
Dialogue: 0,0:05:56.28,0:05:58.57,Default,,0000,0000,0000,,...مالك هذا المنزل
Dialogue: 0,0:05:58.57,0:06:01.20,Default,,0000,0000,0000,,كان زوجك سيّاف أسلوب إياي، أليس كذلك؟
Dialogue: 0,0:06:01.20,0:06:04.37,Default,,0000,0000,0000,,بلى، كان أستاذاً في الدرجة الثالثة
Dialogue: 0,0:06:04.37,0:06:06.69,Default,,0000,0000,0000,,لا بدّ أنّه كان بارعاً إذاً
Dialogue: 0,0:06:07.44,0:06:09.80,Default,,0000,0000,0000,,أكان هذا سيفه حقاً؟
Dialogue: 0,0:06:09.96,0:06:12.65,Default,,0000,0000,0000,,أجل، احتفظ به كزينة في القبّة
Dialogue: 0,0:06:12.98,0:06:15.10,Default,,0000,0000,0000,,،نظراً لحالة هذه الغرفة
Dialogue: 0,0:06:15.10,0:06:17.52,Default,,0000,0000,0000,,يبدو أنّه خاض مبارزةً حادّة مع القاتل
Dialogue: 0,0:06:18.05,0:06:21.63,Default,,0000,0000,0000,,مما يعني أنّ القاتل كان \Nسيّافاً بارعاً بدوره
Dialogue: 0,0:06:23.10,0:06:25.14,Default,,0000,0000,0000,,أهذا دفتر تنظيم الضحية؟
Dialogue: 0,0:06:27.54,0:06:29.10,Default,,0000,0000,0000,,إنّه مليء بالمواعيد
Dialogue: 0,0:06:29.88,0:06:33.21,Default,,0000,0000,0000,,كونان-كن، أنت متيقن أنّك رأيت الزائر، صحيح؟
Dialogue: 0,0:06:33.21,0:06:35.12,Default,,0000,0000,0000,,أجل، لكن ساقيه فقط
Dialogue: 0,0:06:35.12,0:06:38.87,Default,,0000,0000,0000,,...حسنٌ، كان يُفترض أن يلتقي اليوم
Dialogue: 0,0:06:38.87,0:06:43.53,Default,,0000,0000,0000,,موري كوغورو وسوا يوجي \Nوهاتانو إيكويا وأكوتسو ماكوتو
Dialogue: 0,0:06:43.74,0:06:45.52,Default,,0000,0000,0000,,هؤلاء الأربعة
Dialogue: 0,0:06:45.52,0:06:48.02,Default,,0000,0000,0000,,!سيّدي المفتش! وجدنا رجلاً مريباً
Dialogue: 0,0:06:48.02,0:06:49.06,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:49.44,0:06:51.77,Default,,0000,0000,0000,,!كان هذا الرجل يتلصص أمام المنزل
Dialogue: 0,0:06:52.19,0:06:53.98,Default,,0000,0000,0000,,!لستُ مريباً
Dialogue: 0,0:06:53.98,0:06:56.06,Default,,0000,0000,0000,,!هاتانو سينسي
Dialogue: 0,0:06:56.06,0:06:59.60,Default,,0000,0000,0000,,هاتانو؟ نفسه هاتانو إيكويا-سان؟
Dialogue: 0,0:06:59.60,0:07:01.69,Default,,0000,0000,0000,,أجل، إنّه طبيب زوجي
Dialogue: 0,0:07:02.01,0:07:04.36,Default,,0000,0000,0000,,يجري فحوصاً أسبوعية عليه
Dialogue: 0,0:07:04.36,0:07:05.21,Default,,0000,0000,0000,,...طبيبه
Dialogue: 0,0:07:05.21,0:07:09.19,Default,,0000,0000,0000,,!دعوني! دعوني! أخبرتكم أن تدعوني
Dialogue: 0,0:07:09.19,0:07:11.52,Default,,0000,0000,0000,,!أتعرفون من أكون؟
Dialogue: 0,0:07:11.52,0:07:14.23,Default,,0000,0000,0000,,!أنا أكوتسو سينسي، النحّات العظيم
Dialogue: 0,0:07:14.66,0:07:17.70,Default,,0000,0000,0000,,أكوتسو؟ أكوتسو ماكوتو؟
Dialogue: 0,0:07:17.70,0:07:21.54,Default,,0000,0000,0000,,هكذا ظهر 3 من الأربعة في الدفتر
Dialogue: 0,0:07:21.54,0:07:23.16,Default,,0000,0000,0000,,!وجدتُها
Dialogue: 0,0:07:23.16,0:07:26.48,Default,,0000,0000,0000,,القاتل هو الرجل الذي أتى لرؤية الضحية سلفاً
Dialogue: 0,0:07:26.48,0:07:28.85,Default,,0000,0000,0000,,!ولم يظهر بعد، إنه سوا يوجي
Dialogue: 0,0:07:29.07,0:07:31.06,Default,,0000,0000,0000,,ماذا عني؟
Dialogue: 0,0:07:31.53,0:07:36.44,Default,,0000,0000,0000,,أنا سوا، ما سبب كلّ هذه الجلبة؟
Dialogue: 0,0:07:36.97,0:07:38.27,Default,,0000,0000,0000,,ما خطب هذا الصبيّ؟
Dialogue: 0,0:07:38.27,0:07:39.65,Default,,0000,0000,0000,,!أنت تشاغب مُجدداً؟
Dialogue: 0,0:07:40.27,0:07:42.86,Default,,0000,0000,0000,,أنت سيّاف يا عم، صحيح؟
Dialogue: 0,0:07:45.59,0:07:47.96,Default,,0000,0000,0000,,كيف عرفت يا فتى؟
Dialogue: 0,0:07:47.96,0:07:49.54,Default,,0000,0000,0000,,يدك اليسرى
Dialogue: 0,0:07:49.54,0:07:50.31,Default,,0000,0000,0000,,يدي اليسرى؟
Dialogue: 0,0:07:50.31,0:07:54.73,Default,,0000,0000,0000,,توجد ندبة صغيرة بين إبهامك وسبّابتك، صحيح؟
Dialogue: 0,0:07:54.73,0:07:58.54,Default,,0000,0000,0000,,يصاب بها المتمرّنون على فنّ السيف عادةً عندما يعيدونه
Dialogue: 0,0:07:58.54,0:08:00.98,Default,,0000,0000,0000,,إلى غمده
Dialogue: 0,0:08:01.37,0:08:04.53,Default,,0000,0000,0000,,لذا ظننت أنّك سيّاف
Dialogue: 0,0:08:04.53,0:08:06.03,Default,,0000,0000,0000,,أهو مُحق؟
Dialogue: 0,0:08:06.03,0:08:08.44,Default,,0000,0000,0000,,أجل، رغم أنّي أصبت بهذه الندبة\Nعندما كنت لا أزال صغير الخبرة
Dialogue: 0,0:08:08.44,0:08:10.65,Default,,0000,0000,0000,,!أنت المجرم إذاً
Dialogue: 0,0:08:10.99,0:08:13.57,Default,,0000,0000,0000,,المجرم؟! ما الذي تقوله؟
Dialogue: 0,0:08:15.98,0:08:18.31,Default,,0000,0000,0000,,!لـ-لمَ حصل هذا؟
Dialogue: 0,0:08:18.81,0:08:21.40,Default,,0000,0000,0000,,!أتقصد أنّي من فعل هذا؟
Dialogue: 0,0:08:21.85,0:08:24.31,Default,,0000,0000,0000,,الأمر جليّ بالنظر لأرجاء المكان
Dialogue: 0,0:08:24.31,0:08:26.13,Default,,0000,0000,0000,,كان القاتل سيّافاً بارعاً
Dialogue: 0,0:08:26.13,0:08:28.52,Default,,0000,0000,0000,,!مما يعني أنّه أنت
Dialogue: 0,0:08:28.52,0:08:30.26,Default,,0000,0000,0000,,!أ-أخطأت
Dialogue: 0,0:08:30.26,0:08:33.92,Default,,0000,0000,0000,,أتيتُ لإعادة الخمسة ملايين ينّ\Nالتي استعرتُها من مارو-سان فقط
Dialogue: 0,0:08:33.92,0:08:35.58,Default,,0000,0000,0000,,أتيت لردّ دين؟
Dialogue: 0,0:08:35.58,0:08:37.60,Default,,0000,0000,0000,,ها هو المال كما ترون
Dialogue: 0,0:08:39.50,0:08:41.87,Default,,0000,0000,0000,,وقعت الجريمة بين الساعة الثالثة والخامسة
Dialogue: 0,0:08:41.87,0:08:43.32,Default,,0000,0000,0000,,أين كنت حينذاك؟
Dialogue: 0,0:08:44.04,0:08:47.28,Default,,0000,0000,0000,,أظنني كنت أتأمل بمفردي في الدوجو
Dialogue: 0,0:08:47.28,0:08:49.27,Default,,0000,0000,0000,,أهناك من يشهد على ذلك؟
Dialogue: 0,0:08:49.82,0:08:51.48,Default,,0000,0000,0000,,كـ-كلا
Dialogue: 0,0:08:52.03,0:08:53.70,Default,,0000,0000,0000,,...مُريب
Dialogue: 0,0:08:53.70,0:08:55.70,Default,,0000,0000,0000,,هناك أمرٌ غريب
Dialogue: 0,0:08:55.70,0:08:56.35,Default,,0000,0000,0000,,غريب؟
Dialogue: 0,0:08:56.69,0:08:59.48,Default,,0000,0000,0000,,إمساكه للسيف... إنّه مقلوب
Dialogue: 0,0:09:01.69,0:09:03.73,Default,,0000,0000,0000,,!صحيح! انظروا لتلك الصورة
Dialogue: 0,0:09:04.39,0:09:06.43,Default,,0000,0000,0000,,!يد الجثة تمسكه بالشكل الخطأ
Dialogue: 0,0:09:06.43,0:09:10.65,Default,,0000,0000,0000,,مما يعني أنّ أحدهم وضع السيف بيده لاحقاً؟
Dialogue: 0,0:09:11.05,0:09:14.54,Default,,0000,0000,0000,,،كما أنّه مهما كان القتال حاداً
Dialogue: 0,0:09:14.54,0:09:17.85,Default,,0000,0000,0000,,من غير الطبيعي أن يتضرر السقف والحوائط لهذا الحد
Dialogue: 0,0:09:17.85,0:09:22.50,Default,,0000,0000,0000,,هكذا إذاً، حاول القاتل إلفاق التهمة بسوا-سان
Dialogue: 0,0:09:22.50,0:09:25.31,Default,,0000,0000,0000,,بتقطيع كلّ شيء في الغرفة بما أنّه كان سيّافاً؟
Dialogue: 0,0:09:25.99,0:09:26.99,Default,,0000,0000,0000,,لكن أخطأ القاتل
Dialogue: 0,0:09:26.99,0:09:29.27,Default,,0000,0000,0000,,بوضعه المعكوس للسيف في قبضة الضحيّة
Dialogue: 0,0:09:29.82,0:09:31.53,Default,,0000,0000,0000,,أكوتسو-سان، ماذا عنك؟
Dialogue: 0,0:09:31.53,0:09:35.94,Default,,0000,0000,0000,,استعرتُ مالاً من مارو-سان أيضاً، 10 ملايين ينّ
Dialogue: 0,0:09:35.94,0:09:37.23,Default,,0000,0000,0000,,وأتيت لإعادتها؟
Dialogue: 0,0:09:37.73,0:09:42.06,Default,,0000,0000,0000,,كلا، احتجتُ وقتاً إضافياً لذا أتيت لطلب مهلة
Dialogue: 0,0:09:42.06,0:09:44.19,Default,,0000,0000,0000,,أين كنت بين الثالثة والخامسة؟
Dialogue: 0,0:09:44.19,0:09:46.43,Default,,0000,0000,0000,,كنتُ بمفردي في غرفتي
Dialogue: 0,0:09:46.43,0:09:48.93,Default,,0000,0000,0000,,لا تملك حجّة غياب إذاً، صحيح؟
Dialogue: 0,0:09:48.93,0:09:51.55,Default,,0000,0000,0000,,ما الذي جلبك أنت هنا؟
Dialogue: 0,0:09:51.55,0:09:52.77,Default,,0000,0000,0000,,أ-أنا؟
Dialogue: 0,0:09:53.09,0:09:57.44,Default,,0000,0000,0000,,بالطبع، خطّط الضحية لرؤيتك أيضاً
Dialogue: 0,0:09:57.88,0:09:59.13,Default,,0000,0000,0000,,!بربّك
Dialogue: 0,0:09:59.13,0:10:02.77,Default,,0000,0000,0000,,أتيتُ لتقديم تقريري عمَّ كلفني به فقط
Dialogue: 0,0:10:02.77,0:10:04.81,Default,,0000,0000,0000,,بشأن خيانة زوجته
Dialogue: 0,0:10:06.20,0:10:07.64,Default,,0000,0000,0000,,!خيانة الزوجة؟
Dialogue: 0,0:10:08.85,0:10:13.57,Default,,0000,0000,0000,,يا إلهي، يُفترض ألا يبوح المتحرّيين\Nبأسرار القضايا للغير
Dialogue: 0,0:10:14.03,0:10:16.36,Default,,0000,0000,0000,,أين كنت عندما وقعت الجريمة؟
Dialogue: 0,0:10:16.36,0:10:17.52,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:10:18.02,0:10:21.19,Default,,0000,0000,0000,,ماذا؟ رائحة هذا الرجل غريبة
Dialogue: 0,0:10:18.44,0:10:21.19,On Top,,0000,0000,0000,,...رأيتُ فيلماً في غينزا عند الثالثة
Dialogue: 0,0:10:21.61,0:10:23.94,Default,,0000,0000,0000,,إنّه عطر امرأة
Dialogue: 0,0:10:21.61,0:10:23.94,On Top,,0000,0000,0000,,عادةً ما أشاهد الأفلام هناك
Dialogue: 0,0:10:23.94,0:10:26.85,Default,,0000,0000,0000,,لحظة، شممتُ هذه الرائحة قبل قليل
Dialogue: 0,0:10:30.85,0:10:31.82,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:10:32.51,0:10:35.27,Default,,0000,0000,0000,,من الفظّ تنشّق الآخرين هكذا
Dialogue: 0,0:10:35.88,0:10:37.50,Default,,0000,0000,0000,,!لم أكن أفعل شيئاً
Dialogue: 0,0:10:40.79,0:10:41.61,Default,,0000,0000,0000,,!إنّها رائحتها
Dialogue: 0,0:10:42.38,0:10:45.06,Default,,0000,0000,0000,,..مما يعني
Dialogue: 0,0:10:45.49,0:10:48.52,Default,,0000,0000,0000,,رائحتك كرائحة الطبيب يا عمّة
Dialogue: 0,0:10:51.45,0:10:53.82,Default,,0000,0000,0000,,معه حق، نفس العطر
Dialogue: 0,0:10:54.36,0:10:57.52,Default,,0000,0000,0000,,أتضع عطر نساء؟
Dialogue: 0,0:10:57.52,0:10:58.77,Default,,0000,0000,0000,,...كلا، أنا
Dialogue: 0,0:10:58.77,0:11:04.02,Default,,0000,0000,0000,,!فهمت! أيمكن أنك الطرف الآخر في الخيانة؟
Dialogue: 0,0:11:04.02,0:11:04.72,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:11:05.18,0:11:07.89,Default,,0000,0000,0000,,سأعترف بما أنّه لا جدوى من إخفاء الأمر الآن
Dialogue: 0,0:11:07.89,0:11:10.73,Default,,0000,0000,0000,,!كنتُ في علاقة سرّية مع الطبيب هاتانو
Dialogue: 0,0:11:10.73,0:11:11.69,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:11:12.22,0:11:14.22,Default,,0000,0000,0000,,!لكنّنا بريئان
Dialogue: 0,0:11:14.22,0:11:17.60,Default,,0000,0000,0000,,!كنّا في فندق بيكا من الظهيرة للمساء
Dialogue: 0,0:11:18.55,0:11:21.00,Default,,0000,0000,0000,,ألم تتفقا على القصة نفسها وحسب؟
Dialogue: 0,0:11:21.00,0:11:22.07,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:11:22.63,0:11:24.99,Default,,0000,0000,0000,,،أيّاً يكن، باستثناء العمّ كوغورو
Dialogue: 0,0:11:24.99,0:11:29.33,Default,,0000,0000,0000,,لا يملك أيّ من الزوّار الثلاثة حجّة غياب
Dialogue: 0,0:11:29.33,0:11:31.29,Default,,0000,0000,0000,,من كان القاتل؟
Dialogue: 0,0:11:40.07,0:11:42.23,Default,,0000,0000,0000,,!أنت! تشاغب مجدداً
Dialogue: 0,0:11:42.23,0:11:44.43,Default,,0000,0000,0000,,أنا هاتانو، أأنت هنا يا مارو-سان؟
Dialogue: 0,0:11:44.77,0:11:48.93,Default,,0000,0000,0000,,حسناً، بأيّ حال سأصل عند الخامسة كالمتّفق
Dialogue: 0,0:11:50.31,0:11:53.07,Default,,0000,0000,0000,,جرى الاتّصال عند 4:38
Dialogue: 0,0:11:53.93,0:11:54.92,Default,,0000,0000,0000,,أنا سوا
Dialogue: 0,0:11:54.92,0:11:59.48,Default,,0000,0000,0000,,،كنتُ أخطط للوصول عند السادسة\Nلكن قد أصل باكراً
Dialogue: 0,0:12:00.02,0:12:03.71,Default,,0000,0000,0000,,رتّبتُ لاختبارات مستوى الشهر القادم
Dialogue: 0,0:12:03.71,0:12:05.93,Default,,0000,0000,0000,,سأعطيك التفاصيل في وقت لاحق
Dialogue: 0,0:12:06.91,0:12:09.85,Default,,0000,0000,0000,,جرى الاتّصال عند 4:41
Dialogue: 0,0:12:10.50,0:12:13.58,Default,,0000,0000,0000,,فهمت، كان موعد الطبيب هاتانو عند الخامسة
Dialogue: 0,0:12:13.58,0:12:18.15,Default,,0000,0000,0000,,وموعد سوا-سان عند السادسة، لكنّك اتّصلت\Nوقدّمت الموعد للخامسة، صحيح؟
Dialogue: 0,0:12:18.15,0:12:19.15,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:19.15,0:12:21.78,Default,,0000,0000,0000,,!تركتُ رسالةً على آلة الردّ بدوري
Dialogue: 0,0:12:21.78,0:12:22.57,Default,,0000,0000,0000,,أأنت متأكد؟
Dialogue: 0,0:12:22.57,0:12:23.82,Default,,0000,0000,0000,,!لا أكذب
Dialogue: 0,0:12:23.82,0:12:26.14,Default,,0000,0000,0000,,قلتُ أنّي سأتأخر قليلاً لكني \N!سأعيد المال حتماً
Dialogue: 0,0:12:26.52,0:12:30.48,Default,,0000,0000,0000,,!أخبرتهُ أيضاً أنّي سأقتله إن باعه
Dialogue: 0,0:12:30.48,0:12:31.86,Default,,0000,0000,0000,,ستقتله؟
Dialogue: 0,0:12:32.39,0:12:34.47,Default,,0000,0000,0000,,أجل، فقد هدّدني
Dialogue: 0,0:12:34.47,0:12:38.88,Default,,0000,0000,0000,,!أنّه سيبيع النحت الذي أعرته إيّاه إلم أردّ ماله
Dialogue: 0,0:12:38.88,0:12:40.31,Default,,0000,0000,0000,,أيّ نحت؟
Dialogue: 0,0:12:41.26,0:12:42.27,Default,,0000,0000,0000,,ذاك التنين
Dialogue: 0,0:12:43.80,0:12:46.00,Default,,0000,0000,0000,,هناك أمرٌ بذاك النحت
Dialogue: 0,0:12:47.21,0:12:50.37,Default,,0000,0000,0000,,!حمداً لله! لم تصب بأيّ خدش
Dialogue: 0,0:12:50.37,0:12:52.61,Default,,0000,0000,0000,,هذا رائع يا عمّ، حالفك الحظّ
Dialogue: 0,0:12:53.66,0:12:56.56,Default,,0000,0000,0000,,نجاة ذاك النحت وحده من الخدوش معجزة
Dialogue: 0,0:12:57.99,0:13:01.45,Default,,0000,0000,0000,,فهمت، توضّح الأمر لي الآن
Dialogue: 0,0:13:01.45,0:13:03.86,Default,,0000,0000,0000,,أكوتسو-سان، أنت القاتل
Dialogue: 0,0:13:03.86,0:13:05.39,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:05.39,0:13:09.52,Default,,0000,0000,0000,,قتلت مارو-سان وحاولت إلقاء اللوم على سوا-سان
Dialogue: 0,0:13:09.52,0:13:11.31,Default,,0000,0000,0000,,لكنك اقترفت أخطاءً
Dialogue: 0,0:13:12.23,0:13:15.52,Default,,0000,0000,0000,,الأوّل كان وضعك للسيف في قبضة الضحيّة مقلوباً
Dialogue: 0,0:13:16.34,0:13:19.48,Default,,0000,0000,0000,,والثاني عجزك عن إضرار نحت التنين
Dialogue: 0,0:13:19.48,0:13:21.76,Default,,0000,0000,0000,,،يبدو أنّك لم تمانع قتل نفس
Dialogue: 0,0:13:21.76,0:13:25.71,Default,,0000,0000,0000,,لكنك لم تستطع أذيّة نحتك العزيز
Dialogue: 0,0:13:25.71,0:13:26.89,Default,,0000,0000,0000,,!إنّها مصادفة فقط
Dialogue: 0,0:13:27.29,0:13:30.96,Default,,0000,0000,0000,,لمَ كذبت بشأن ترك رسالة\Nعلى آلة الردّ إذاً؟
Dialogue: 0,0:13:30.96,0:13:33.23,Default,,0000,0000,0000,,!لم أكذب! تركتُ رسالةً حقاً
Dialogue: 0,0:13:33.54,0:13:36.20,Default,,0000,0000,0000,,صحيح، رنّ الهاتف 3 مرّات
Dialogue: 0,0:13:36.20,0:13:39.03,Default,,0000,0000,0000,,في المرّة الثانية والثالثة، توقّف عن الرنين فوراً
Dialogue: 0,0:13:39.03,0:13:40.06,Default,,0000,0000,0000,,...لكن في الأولى
Dialogue: 0,0:13:40.06,0:13:41.64,Default,,0000,0000,0000,,رنّ مراراً...
Dialogue: 0,0:13:43.82,0:13:47.69,Default,,0000,0000,0000,,أخبرني يا عمّ، أكان هناك أمر غريب أثناء اتّصالك؟
Dialogue: 0,0:13:47.69,0:13:49.52,Default,,0000,0000,0000,,مثل عدم ردّ أحد؟
Dialogue: 0,0:13:49.94,0:13:52.98,Default,,0000,0000,0000,,بذكرك لذلك، رنّ الهاتف لوقت طويل
Dialogue: 0,0:13:52.98,0:13:55.43,Default,,0000,0000,0000,,،وعندما ظننت أن اتّصالي سيُجاب أخيراً\Nأجابتني آلة الردّ الآلي
Dialogue: 0,0:13:55.43,0:14:01.40,Default,,0000,0000,0000,,آلة الردّ خاصتنا مضبوطة على تسجيل\Nالرسائل بعد 10 رنّات
Dialogue: 0,0:14:02.05,0:14:03.72,Default,,0000,0000,0000,,رأيت؟ أخبرتكم
Dialogue: 0,0:14:03.72,0:14:06.83,Default,,0000,0000,0000,,متى اتّصلت بالضبط؟
Dialogue: 0,0:14:06.83,0:14:09.60,Default,,0000,0000,0000,,قليلاً قبل موعدنا، لذا قبل الرابعة
Dialogue: 0,0:14:11.13,0:14:16.03,Default,,0000,0000,0000,,سمعتَ الهاتف يرنّ وأنت تقتل مارو-سان غالباً
Dialogue: 0,0:14:16.03,0:14:17.81,Default,,0000,0000,0000,,لذا تتفوه بهذا الهراء
Dialogue: 0,0:14:18.12,0:14:20.11,Default,,0000,0000,0000,,!كلا! تركتُ رسالةً حقاً
Dialogue: 0,0:14:20.49,0:14:21.82,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:14:21.82,0:14:23.24,Default,,0000,0000,0000,,،إن كان القاتل
Dialogue: 0,0:14:23.24,0:14:25.56,Default,,0000,0000,0000,,فلمَ سيختلق كذبةً سريعة الكشف كهذه؟
Dialogue: 0,0:14:25.90,0:14:29.48,Default,,0000,0000,0000,,لكن لا رسالة منه على آلة الردّ
Dialogue: 0,0:14:30.15,0:14:31.23,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:14:31.23,0:14:35.01,Default,,0000,0000,0000,,!هناك من ترك رسالةً غريبة بالتدقيق في الأمر
Dialogue: 0,0:14:35.01,0:14:37.22,Default,,0000,0000,0000,,...رسالة لا يتركها أحد في العادة
Dialogue: 0,0:14:37.22,0:14:39.48,Default,,0000,0000,0000,,...مما يعني أنّ القاتل
Dialogue: 0,0:14:40.01,0:14:42.77,Default,,0000,0000,0000,,أهناك ما يحمل قيمةً في هذه الغرفة يا سيّدة؟
Dialogue: 0,0:14:43.10,0:14:46.06,Default,,0000,0000,0000,,أجل، يوجد مفتاح خزنة في أحد الأدراج
Dialogue: 0,0:14:48.88,0:14:51.73,Default,,0000,0000,0000,,!اختفى! مفتاح الخزنة ليس موجوداً
Dialogue: 0,0:14:52.09,0:14:53.04,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:53.04,0:14:54.43,Default,,0000,0000,0000,,!كان أنت بالفعل
Dialogue: 0,0:14:55.41,0:14:57.24,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:57.24,0:14:59.65,Default,,0000,0000,0000,,ها هو، إنّه في درج آخر
Dialogue: 0,0:14:59.65,0:15:01.86,Default,,0000,0000,0000,,...سـ-سيّدتي
Dialogue: 0,0:15:02.41,0:15:06.39,Default,,0000,0000,0000,,لكن هذا غريب، يحتفظ به زوجي في هذا دوماً
Dialogue: 0,0:15:09.86,0:15:11.52,Default,,0000,0000,0000,,!هذه الأدراج
Dialogue: 0,0:15:11.98,0:15:14.47,Default,,0000,0000,0000,,!لا أحد من آثار السيف الكبيرة متّصل
Dialogue: 0,0:15:15.18,0:15:18.43,Default,,0000,0000,0000,,أتوجد كاميرا فورية في هذا المنزل؟
Dialogue: 0,0:15:18.43,0:15:19.81,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:15:20.35,0:15:22.48,Default,,0000,0000,0000,,يقول المفتّش أنه يريد استعارتها
Dialogue: 0,0:15:23.06,0:15:25.14,Default,,0000,0000,0000,,سأذهب لجلبها إذاً
Dialogue: 0,0:15:35.62,0:15:38.40,Default,,0000,0000,0000,,!أيّ جزء من "اغرب من هنا" لا تفهمه؟
Dialogue: 0,0:15:39.24,0:15:40.77,Default,,0000,0000,0000,,!تباً
Dialogue: 0,0:15:40.77,0:15:43.86,Default,,0000,0000,0000,,لا يهمّ، حصلت على الصورة على الأقل
Dialogue: 0,0:15:45.03,0:15:46.81,Default,,0000,0000,0000,,!إنها تظهر
Dialogue: 0,0:15:47.28,0:15:48.60,Default,,0000,0000,0000,,...الباقي
Dialogue: 0,0:15:52.82,0:15:56.23,Default,,0000,0000,0000,,استخراج الأدراج بآثار السيف الكبيرة غير المرتبطة
Dialogue: 0,0:16:10.38,0:16:13.38,Default,,0000,0000,0000,,!هكذا إذاً! كنتُ محقاً
Dialogue: 0,0:16:13.38,0:16:14.85,Default,,0000,0000,0000,,!حللتُ اللغز
Dialogue: 0,0:16:15.37,0:16:17.91,Default,,0000,0000,0000,,عليك مرافقتنا للمركز بأيّ حال
Dialogue: 0,0:16:17.91,0:16:18.69,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:16:19.12,0:16:21.40,Default,,0000,0000,0000,,أنت، لا جدوى من إنكارك
Dialogue: 0,0:16:21.40,0:16:24.06,Default,,0000,0000,0000,,!اخرس! لم أكن الفاعل
Dialogue: 0,0:16:27.57,0:16:30.44,Default,,0000,0000,0000,,ما الذي يفعله؟
Dialogue: 0,0:16:30.44,0:16:31.94,Default,,0000,0000,0000,,حسنٌ، هيّا بنا
Dialogue: 0,0:16:32.24,0:16:33.90,Default,,0000,0000,0000,,انتظروا لحظة
Dialogue: 0,0:16:34.35,0:16:35.60,Default,,0000,0000,0000,,موري-كن
Dialogue: 0,0:16:36.10,0:16:39.31,Default,,0000,0000,0000,,اكتشفتُ الأمر هذه المرّة سيّدي المفتش
Dialogue: 0,0:16:39.31,0:16:41.23,Default,,0000,0000,0000,,اكتشفتُ هويّة المجرم
Dialogue: 0,0:16:41.23,0:16:43.11,Default,,0000,0000,0000,,!مـ-من هو؟
Dialogue: 0,0:16:43.31,0:16:44.77,Default,,0000,0000,0000,,...المجرم
Dialogue: 0,0:16:46.05,0:16:48.23,Default,,0000,0000,0000,,!هو أنت يا سوا-سان
Dialogue: 0,0:16:49.26,0:16:52.13,Default,,0000,0000,0000,,لكن سوا-سان يمارس المبارزة
Dialogue: 0,0:16:52.13,0:16:54.18,Default,,0000,0000,0000,,فلا يمكن أنّه من أخطأ في\Nوضع السيف في قبضة الضحيّة
Dialogue: 0,0:16:54.18,0:16:57.91,Default,,0000,0000,0000,,...هكذا خُدعنا بسهولة
Dialogue: 0,0:16:57.91,0:17:00.15,Default,,0000,0000,0000,,وفق حساباته تماماً
Dialogue: 0,0:17:00.15,0:17:01.36,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:01.71,0:17:05.11,Default,,0000,0000,0000,,لإثارة الشبهة حول نفسه، ملأ الغرفة بآثار السيف
Dialogue: 0,0:17:05.11,0:17:07.24,Default,,0000,0000,0000,,ثمّ وضع السيف في قبضة الضحيّة
Dialogue: 0,0:17:07.24,0:17:09.61,Default,,0000,0000,0000,,لكنه فتح لنفسه مهرباً
Dialogue: 0,0:17:09.61,0:17:11.81,Default,,0000,0000,0000,,بجعل الضحيّة تمسك السيف بشكل غير صحيح
Dialogue: 0,0:17:12.11,0:17:16.77,Default,,0000,0000,0000,,وهكذا جعل الأمر كما لو أن أحدهم\Nيحاول إلقاء التهمة عليه
Dialogue: 0,0:17:17.02,0:17:20.48,Default,,0000,0000,0000,,وأزال الشبهات عن نفسه تماماً
Dialogue: 0,0:17:21.89,0:17:22.81,Default,,0000,0000,0000,,موري-سان
Dialogue: 0,0:17:22.81,0:17:26.43,Default,,0000,0000,0000,,أتنوي اتّهامي بهذا الاستنتاج الضعيف حقاً؟
Dialogue: 0,0:17:26.43,0:17:28.51,Default,,0000,0000,0000,,!معه حقّ يا موري-كن
Dialogue: 0,0:17:28.51,0:17:31.47,Default,,0000,0000,0000,,وكيف تفسّر مسألة نحت التنين؟
Dialogue: 0,0:17:31.47,0:17:34.39,Default,,0000,0000,0000,,!كنتَ من اتّهم أكوتسو-سان بأنّه القاتل
Dialogue: 0,0:17:36.00,0:17:37.87,Default,,0000,0000,0000,,...كـ-كنتُ أكذب
Dialogue: 0,0:17:37.87,0:17:38.90,Default,,0000,0000,0000,,!تكذب؟
Dialogue: 0,0:17:40.87,0:17:43.87,Default,,0000,0000,0000,,تعمّد سوا-سان تركه سليماً
Dialogue: 0,0:17:43.87,0:17:45.60,Default,,0000,0000,0000,,!لإثارة الشبهة حول أكوتسو-سان
Dialogue: 0,0:17:45.60,0:17:48.78,Default,,0000,0000,0000,,مُحال، هذه أوّل مرة نلتقي فيها
Dialogue: 0,0:17:48.78,0:17:52.53,Default,,0000,0000,0000,,كيف لي أن أعرف أنّ التنين يخصّه؟
Dialogue: 0,0:17:52.53,0:17:54.81,Default,,0000,0000,0000,,آلة الردّ الآلي
Dialogue: 0,0:17:55.10,0:17:58.40,Default,,0000,0000,0000,,الاتصال الذي يصرّ أكوتسو-سان أنّه أجراه
Dialogue: 0,0:17:58.40,0:18:01.27,Default,,0000,0000,0000,,سمعتَه أثناء ارتكابك للجريمة غالباً
Dialogue: 0,0:18:01.77,0:18:06.27,Default,,0000,0000,0000,,!إن بعت نحت التنين الذي تركته عندك سأقتلك
Dialogue: 0,0:18:06.55,0:18:10.69,Default,,0000,0000,0000,,فخطرت لك فكرة إلفاق التهمة\Nبأكوتسو-سان تلك اللحظة غالباً
Dialogue: 0,0:18:10.69,0:18:14.54,Default,,0000,0000,0000,,!لكنّ رسالة أكوتسو-سان لم تكن مسجلة
Dialogue: 0,0:18:14.54,0:18:16.50,Default,,0000,0000,0000,,هذا لأنّ سوا-سان أعاد الشريط للوراء
Dialogue: 0,0:18:16.50,0:18:19.40,Default,,0000,0000,0000,,وسجّل رسالته فوق الأولى
Dialogue: 0,0:18:19.88,0:18:22.96,Default,,0000,0000,0000,,لكن كان يمكن للطبيب هاتانو فعل ذلك أيضاً
Dialogue: 0,0:18:22.96,0:18:23.97,Default,,0000,0000,0000,,كلّا
Dialogue: 0,0:18:24.41,0:18:29.27,Default,,0000,0000,0000,,!اعترفت بأنّك القاتل في رسالتك
Dialogue: 0,0:18:29.27,0:18:30.31,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:18:30.62,0:18:34.94,Default,,0000,0000,0000,,تركت رسالةً تفيد أنّك ستصل\Nقبل الموعد المتّفق عليه
Dialogue: 0,0:18:34.94,0:18:36.69,Default,,0000,0000,0000,,أليس ذلك غريباً؟
Dialogue: 0,0:18:36.69,0:18:40.31,Default,,0000,0000,0000,,ذهابك لمنزل أحدهم باكراً \Nرغم علمك أنّه ليس موجوداً؟
Dialogue: 0,0:18:40.77,0:18:44.89,Default,,0000,0000,0000,,قلت ذلك لأنّك كنت تعرف\Nأنّ مارو-سان في الكوخ
Dialogue: 0,0:18:44.89,0:18:46.48,Default,,0000,0000,0000,,!كجثّة
Dialogue: 0,0:18:48.93,0:18:53.72,Default,,0000,0000,0000,,قال مارو-سان أنّه سيلتقي شخصاً بين الرابعة والخامسة
Dialogue: 0,0:18:53.72,0:18:56.02,Default,,0000,0000,0000,,لذا طلب مني القدوم في أيّ وقت بخلاف ذلك
Dialogue: 0,0:18:56.54,0:19:00.23,Default,,0000,0000,0000,,فظننتُ أن القدوم قبل السادسة المتّفق عليها أمراً مقبولاً
Dialogue: 0,0:19:00.23,0:19:03.69,Default,,0000,0000,0000,,لا تزال تشكّ بي؟
Dialogue: 0,0:19:04.33,0:19:07.06,Default,,0000,0000,0000,,لا أشكّ بقتلك له
Dialogue: 0,0:19:07.06,0:19:10.81,Default,,0000,0000,0000,,!بل أنا متيقن... من أنك القاتل
Dialogue: 0,0:19:10.81,0:19:12.02,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:19:12.02,0:19:17.15,Default,,0000,0000,0000,,!يوجد دليل دامغ يدينك في هذه الغرفة
Dialogue: 0,0:19:17.15,0:19:18.98,Default,,0000,0000,0000,,!أ-أين؟
Dialogue: 0,0:19:18.98,0:19:24.68,Default,,0000,0000,0000,,سبب تقطيع الغرفة الحقيقي كان لإخفاء شيء
Dialogue: 0,0:19:24.68,0:19:26.72,Default,,0000,0000,0000,,إخفاء شيء؟
Dialogue: 0,0:19:26.72,0:19:28.42,Default,,0000,0000,0000,,الآثار على الأدراج
Dialogue: 0,0:19:30.06,0:19:32.39,Default,,0000,0000,0000,,أمعنوا النظر في الآثار
Dialogue: 0,0:19:32.39,0:19:34.55,Default,,0000,0000,0000,,بعضها غير متصل
Dialogue: 0,0:19:34.55,0:19:35.98,Default,,0000,0000,0000,,!مـ-معك حق
Dialogue: 0,0:19:35.98,0:19:39.84,Default,,0000,0000,0000,,بدّل القاتل الأدراج عمداً
Dialogue: 0,0:19:39.84,0:19:41.55,Default,,0000,0000,0000,,لإعادتها لترتيبها الأصلي
Dialogue: 0,0:19:41.55,0:19:44.95,Default,,0000,0000,0000,,ابدأ بأخذ الدرج في الصف العلوي، الثاني من اليسار
Dialogue: 0,0:19:44.95,0:19:48.62,Default,,0000,0000,0000,,وبدّله مع الدرج في أقصى اليمين\Nفي الصف نفسه
Dialogue: 0,0:19:52.77,0:19:56.19,Default,,0000,0000,0000,,ثمّ خذ الدرج في أقصى اليسار من الصفّ أسفله
Dialogue: 0,0:19:56.19,0:19:58.07,Default,,0000,0000,0000,,وبدّله مع الدرج أقصى اليسار في الصفّ الخامس
Dialogue: 0,0:19:58.07,0:20:01.69,Default,,0000,0000,0000,,درج العمود الثاني من الصف الثاني\Nمع الدرج في أقصى اليمين للصفّ نفسه
Dialogue: 0,0:20:01.69,0:20:04.64,Default,,0000,0000,0000,,ودرج العمود الثاني في الصفّ الثالث\Nمع الدرج أقصى اليمين في الصفّ الرابع
Dialogue: 0,0:20:05.18,0:20:10.65,Default,,0000,0000,0000,,وأخيراً، درج العمود الثاني في الصفّ الخامس\Nمع درج العمود الثالث من اليسار في الصفّ الرابع
Dialogue: 0,0:20:11.93,0:20:13.97,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:20:14.38,0:20:15.68,Default,,0000,0000,0000,,!سوا؟
Dialogue: 0,0:20:16.21,0:20:20.71,Default,,0000,0000,0000,,بينما كان سوا-سان مشغولاً بحذف\Nرسالة أكوتسو-سان غالباً
Dialogue: 0,0:20:20.71,0:20:23.42,Default,,0000,0000,0000,,كتبها الضحيّة بسيفه
Dialogue: 0,0:20:23.42,0:20:25.68,Default,,0000,0000,0000,,بعد إدراكك لذلك، بدّلت الأدراج
Dialogue: 0,0:20:26.16,0:20:30.33,Default,,0000,0000,0000,,وأضفت علاماتك الخاصة لتشويه الأحرف
Dialogue: 0,0:20:30.33,0:20:34.24,Default,,0000,0000,0000,,لكن ستبرز الأدراج إن كانت وحدها المتضررة
Dialogue: 0,0:20:34.24,0:20:37.19,Default,,0000,0000,0000,,فكان عليك تقطيع كلّ شيء في أرجاء الغرفة
Dialogue: 0,0:20:37.19,0:20:40.19,Default,,0000,0000,0000,,كلّها لإخفاء رسالة احتضار الضحيّة لنا
Dialogue: 0,0:20:40.19,0:20:41.81,Default,,0000,0000,0000,,!التي كتبها على الأدراج
Dialogue: 0,0:20:41.81,0:20:46.02,Default,,0000,0000,0000,,!لكن لمَ؟ كان يحمل المال لدفع الدَّين
Dialogue: 0,0:20:46.02,0:20:47.73,Default,,0000,0000,0000,,بسبب سيف
Dialogue: 0,0:20:48.14,0:20:51.51,Default,,0000,0000,0000,,سيف؟ الذي كان يحمله الضحيّة؟
Dialogue: 0,0:20:53.39,0:20:55.27,Default,,0000,0000,0000,,ليس ذاك السيف الكليل
Dialogue: 0,0:20:55.55,0:20:57.63,Default,,0000,0000,0000,,...بل السيف الذي تركتهُ معه ضمان دَين
Dialogue: 0,0:20:57.63,0:21:00.05,Default,,0000,0000,0000,,...الذي توارثته عائلتي لأجيال
Dialogue: 0,0:21:00.05,0:21:01.38,Default,,0000,0000,0000,,الكيكوتشيو
Dialogue: 0,0:21:01.38,0:21:03.57,Default,,0000,0000,0000,,...قام ذاك الرجل بـ
Dialogue: 0,0:21:04.91,0:21:08.73,Default,,0000,0000,0000,,ذاك السيف؟ بعته بالفعل
Dialogue: 0,0:21:09.83,0:21:11.44,Default,,0000,0000,0000,,لم يجن لي مالاً كثيراً
Dialogue: 0,0:21:12.50,0:21:18.23,Default,,0000,0000,0000,,حسناً، لنعتبر ذاك المال الذي استلمتُه\Nفائدة على قرضك
Dialogue: 0,0:21:19.20,0:21:22.73,Default,,0000,0000,0000,,وفي غياب وعي، ضربتهُ بالسيف
Dialogue: 0,0:21:23.20,0:21:26.48,Default,,0000,0000,0000,,!صحيح، هكذا
Dialogue: 0,0:21:39.38,0:21:42.88,Default,,0000,0000,0000,,والتالي جرى كما قلت
Dialogue: 0,0:21:42.88,0:21:46.02,Default,,0000,0000,0000,,...مع ذلك، عدم تزحزحك عندما هاجمت
Dialogue: 0,0:21:46.79,0:21:49.23,Default,,0000,0000,0000,,يظهر أنك مُتحرٍّ عظيم حقاً يا موري كوغورو-دونو
Dialogue: 0,0:21:49.71,0:21:53.08,Default,,0000,0000,0000,,يبدو أنّ أكبر أخطائي
Dialogue: 0,0:21:53.08,0:21:56.44,Default,,0000,0000,0000,,كان عدم إدراكي لكونك هنا
Dialogue: 0,0:23:30.52,0:23:32.36,Default,,0000,0000,0000,,!كان ذلك مذهلاً يا أبي
Dialogue: 0,0:23:32.36,0:23:34.47,Default,,0000,0000,0000,,!غيرت نظرتي عنك مجدداً
Dialogue: 0,0:23:37.51,0:23:40.72,Default,,0000,0000,0000,,ماذا؟ هناك شيءٌ على رأسك
Dialogue: 0,0:23:47.05,0:23:52.05,Default,,0000,0000,0000,,!دم! إنّه دم! أنا أنزف
Dialogue: 0,0:23:52.05,0:23:57.20,Default,,0000,0000,0000,,بالمناسبة، اتّضح أن جرح العمّ لم يتجاوز\Nكونه خدشاً بعمق 3 ميليمترات
Dialogue: 0,0:23:59.99,0:24:02.48,Default,,0000,0000,0000,,ظننتُ كونان والبقية في مركز التسوّق
Dialogue: 0,0:24:03.68,0:24:05.22,Default,,0000,0000,0000,,!إنّها عصابة لصوص
Dialogue: 0,0:24:05.22,0:24:07.39,Default,,0000,0000,0000,,لم يعد غينتا-كن بعد أيضاً
Dialogue: 0,0:24:07.94,0:24:11.28,Default,,0000,0000,0000,,!جهّزي طعامي فقط
Dialogue: 0,0:24:11.28,0:24:12.98,Default,,0000,0000,0000,,أهذا قسم التحرّي؟
Dialogue: 0,0:24:12.98,0:24:15.27,Default,,0000,0000,0000,,أيمكنكم إيصالي بالمفتش ميغوري؟
Dialogue: 0,0:24:17.35,0:24:19.02,Default,,0000,0000,0000,,!نحن محاصرون
Dialogue: 0,0:24:19.39,0:24:21.72,Default,,0000,0000,0000,,عصابة لصوص في مركز التسوق؟
Dialogue: 0,0:24:21.72,0:24:23.64,Default,,0000,0000,0000,,...أيمكن أنهم
Dialogue: 0,0:24:24.42,0:24:25.92,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.92,0:24:27.89,Default,,0000,0000,0000,,سرقة مركز التسوق
Dialogue: 0,0:24:45.82,0:24:47.82,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.82,0:24:49.71,Default,,0000,0000,0000,,مضيفة مصعد
Dialogue: 0,0:24:49.71,0:24:51.71,Default,,0000,0000,0000,,

