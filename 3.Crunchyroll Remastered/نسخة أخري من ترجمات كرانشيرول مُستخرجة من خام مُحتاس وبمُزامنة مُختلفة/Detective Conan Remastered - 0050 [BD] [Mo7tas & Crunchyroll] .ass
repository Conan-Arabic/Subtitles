Dialogue: 0,0:00:02.00,0:00:04.36,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:05.21,0:00:07.34,Default,,0000,0000,0000,,!مسرح اليوم هو مكتبة في الليل
Dialogue: 0,0:00:07.34,0:00:09.24,Default,,0000,0000,0000,,!تفوح من كتبها رائحة جريمة
Dialogue: 0,0:00:09.24,0:00:11.08,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.08,0:00:13.24,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.24,0:00:15.57,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.90,0:01:50.01,Default,,0000,0000,0000,,...ظهر هاتّوري هيجي، وشربتُ الساكي الذي جلبه
Dialogue: 0,0:01:52.52,0:01:53.73,Default,,0000,0000,0000,,!لا شكّ في الأمر
Dialogue: 0,0:01:53.73,0:01:57.35,Default,,0000,0000,0000,,!رجعتُ لطبيعتي بشربي لذاك الساكي
Dialogue: 0,0:01:57.68,0:02:01.05,Default,,0000,0000,0000,,!إذا شربتُ هذا كلّه سأعود لطبيعتي كليّاً
Dialogue: 0,0:02:01.05,0:02:01.93,Default,,0000,0000,0000,,!ولد
Dialogue: 0,0:02:02.80,0:02:05.02,Default,,0000,0000,0000,,لا يمكن للصغار شرب ساكي، تعرف ذلك
Dialogue: 0,0:02:05.34,0:02:06.98,Default,,0000,0000,0000,,أتى أصدقاؤك
Dialogue: 0,0:02:08.87,0:02:12.58,Default,,0000,0000,0000,,بعدما أشرب ذاك الساكي وأرجع\N،طالباً في المدرسة الثانوية
Dialogue: 0,0:02:12.58,0:02:16.61,Default,,0000,0000,0000,,قد لن أستطيع التسكّع معهم هكذا مُجدداً
Dialogue: 0,0:02:20.03,0:02:26.07,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل المكتبة
Dialogue: 0,0:02:20.70,0:02:22.93,Default,,0000,0000,0000,,جريمة قتل المكتبة
Dialogue: 0,0:02:26.40,0:02:29.01,CharCard,,0000,0040,0010,,{\fad(300,0)}مكتبة بيكا
Dialogue: 0,0:02:32.35,0:02:36.06,Default,,0000,0000,0000,,...يا إلهي، كلّها كتب سخيفة
Dialogue: 0,0:02:36.64,0:02:40.26,Default,,0000,0000,0000,,يُفترض بي كتابة تقرير لهذه؟
Dialogue: 0,0:02:40.26,0:02:44.05,Default,,0000,0000,0000,,وما خطب هذا الترتيب الغريب؟
Dialogue: 0,0:02:45.60,0:02:48.83,Default,,0000,0000,0000,,ليس باليد حيلة، فهذا ركن الأطفال
Dialogue: 0,0:02:48.83,0:02:51.54,Default,,0000,0000,0000,,لا بد أنّهم يعبثون به
Dialogue: 0,0:02:57.12,0:02:59.36,Default,,0000,0000,0000,,...كتاب مستورد أجنبيّ
Dialogue: 0,0:02:59.36,0:03:03.51,Default,,0000,0000,0000,,...ماذا؟ إنّه مغلف في غطائه عكسياً
Dialogue: 0,0:03:06.38,0:03:10.55,CharCard,,0000,0000,0005,,{\fad(300,0)}مدير مكتبة بيكا\N(تسوغاوا شوجي (57
Dialogue: 0,0:03:06.91,0:03:10.55,On Top,,0000,0000,0000,,هذا ليس كتاباً صالحاً للأطفال
Dialogue: 0,0:03:11.33,0:03:12.55,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:03:20.76,0:03:23.30,Default,,0000,0000,0000,,!كونان-كن، انظر! سيّارات شرطة
Dialogue: 0,0:03:23.30,0:03:23.97,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:23.97,0:03:25.97,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:03:25.97,0:03:27.92,Default,,0000,0000,0000,,!ربما هناك قضيّة
Dialogue: 0,0:03:27.92,0:03:29.71,On Top,,0000,0000,0000,,كتب مستعملة
Dialogue: 0,0:03:29.71,0:03:32.17,Default,,0000,0000,0000,,سيّدي، يوجد رجال شرطة في الأسفل
Dialogue: 0,0:03:32.17,0:03:35.29,Default,,0000,0000,0000,,ماذا؟ حسناً، سآتي فوراً
Dialogue: 0,0:03:37.25,0:03:38.50,Default,,0000,0000,0000,,!سأذهب للتفقد
Dialogue: 0,0:03:40.47,0:03:42.64,Default,,0000,0000,0000,,!ا-انتظر يا كونان
Dialogue: 0,0:03:42.64,0:03:44.82,Default,,0000,0000,0000,,!أوقفوا المصعد قليلاً
Dialogue: 0,0:03:48.02,0:03:53.89,On Top,,0000,0000,0000,,السعة القصوى: 7 أشخاص، 450 كغ
Dialogue: 0,0:03:48.86,0:03:51.48,Default,,0000,0000,0000,,تجاوزنا حدّ الصاعدين
Dialogue: 0,0:03:51.48,0:03:53.15,Default,,0000,0000,0000,,السعة القصوى 7 أشخاص
Dialogue: 0,0:03:53.15,0:03:53.89,Default,,0000,0000,0000,,!واحد
Dialogue: 0,0:03:54.19,0:03:58.63,Default,,0000,0000,0000,,!اثنان! ثلاثة! أربعة\N!خمسة! ستة! سبعة
Dialogue: 0,0:03:58.97,0:04:01.05,Default,,0000,0000,0000,,!يوجد سبعة فحسب هنا
Dialogue: 0,0:04:01.05,0:04:04.22,Default,,0000,0000,0000,,!لم تحسب نفسك
Dialogue: 0,0:04:04.22,0:04:07.30,Default,,0000,0000,0000,,...أخبرتكم! لن يُصاب غينتا-كن بالزكام
Dialogue: 0,0:04:07.30,0:04:08.05,Default,,0000,0000,0000,,!اسكت
Dialogue: 0,0:04:08.05,0:04:09.89,Default,,0000,0000,0000,,!ليس أمامنا خيار، لننزل من الأدراج
Dialogue: 0,0:04:14.47,0:04:17.59,Default,,0000,0000,0000,,أنت مدير هذه المكتبة، صحيح؟
Dialogue: 0,0:04:17.59,0:04:19.93,Default,,0000,0000,0000,,أجل، أُدعى تسوغاوا
Dialogue: 0,0:04:19.93,0:04:22.41,Default,,0000,0000,0000,,أتيتُ بخصوص هذا الرجل
Dialogue: 0,0:04:22.41,0:04:25.77,Default,,0000,0000,0000,,أمين مكتبة يُدعى تامادا كازو-سان
Dialogue: 0,0:04:25.77,0:04:29.22,Default,,0000,0000,0000,,أجل، أخذ إجازةً غير مصرحة منذ الأمس
Dialogue: 0,0:04:29.48,0:04:32.40,Default,,0000,0000,0000,,حضرة المفتّش! أحدث أمرٌ ما؟
Dialogue: 0,0:04:32.40,0:04:34.43,Default,,0000,0000,0000,,أحلّ أمرٌ به؟
Dialogue: 0,0:04:34.43,0:04:40.39,Default,,0000,0000,0000,,في الواقع، تامادا-سان مفقود منذ ليلتين
Dialogue: 0,0:04:40.39,0:04:42.97,Default,,0000,0000,0000,,...ماذا؟ لا-لا يمكن
Dialogue: 0,0:04:42.97,0:04:47.43,Default,,0000,0000,0000,,سمعت أنّه عمل معك بدوام إضافيّ قبل ليلتين
Dialogue: 0,0:04:47.43,0:04:48.72,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:04:48.72,0:04:52.21,Default,,0000,0000,0000,,لكنّي غادرت قبله
Dialogue: 0,0:04:52.21,0:04:54.38,Default,,0000,0000,0000,,فلا أدري ما حصل بعدها
Dialogue: 0,0:04:54.38,0:04:58.17,Default,,0000,0000,0000,,لمَ تتفقدون مخزن المكتبة إذاً؟
Dialogue: 0,0:04:58.17,0:05:01.70,Default,,0000,0000,0000,,ربما اُختطف في طريق عودته
Dialogue: 0,0:05:01.70,0:05:04.04,Default,,0000,0000,0000,,هذا من باب الحيطة
Dialogue: 0,0:05:04.04,0:05:06.45,Default,,0000,0000,0000,,فتامادا-سان شخص دقيق جداً
Dialogue: 0,0:05:06.45,0:05:08.65,Default,,0000,0000,0000,,يتّصل بزوجته من المكتبة
Dialogue: 0,0:05:08.65,0:05:11.01,Default,,0000,0000,0000,,قبل رجوعه دوماً
Dialogue: 0,0:05:11.01,0:05:14.19,Default,,0000,0000,0000,,لكنه لم يفعل ذلك قبل ليلتين
Dialogue: 0,0:05:14.19,0:05:18.68,Default,,0000,0000,0000,,ما يعني أنّ أحداً أخذه من هنا
Dialogue: 0,0:05:18.68,0:05:21.43,Default,,0000,0000,0000,,أو لا يزال في المكتبة
Dialogue: 0,0:05:22.02,0:05:23.68,Default,,0000,0000,0000,,لكن إذا كان هنا
Dialogue: 0,0:05:23.68,0:05:26.27,Default,,0000,0000,0000,,!فيُحتمل جدّاً أنّه قُتل بالفعل
Dialogue: 0,0:05:27.92,0:05:31.51,Default,,0000,0000,0000,,،سيّدي المفتش، فتّشنا في كلّ الأماكن الخفية
Dialogue: 0,0:05:31.51,0:05:33.46,Default,,0000,0000,0000,,لكن لم نجد شيئاً
Dialogue: 0,0:05:33.46,0:05:36.35,Default,,0000,0000,0000,,...لعلّه غادر بالفعل إذاً
Dialogue: 0,0:05:36.84,0:05:39.25,Default,,0000,0000,0000,,!حسناً، سنرحل
Dialogue: 0,0:05:39.25,0:05:41.25,Default,,0000,0000,0000,,نعتذر على الإزعاج
Dialogue: 0,0:05:41.25,0:05:42.56,Default,,0000,0000,0000,,...لا-لا مشكلة
Dialogue: 0,0:06:00.27,0:06:03.18,Default,,0000,0000,0000,,!حسناً، ذهب الجميع
Dialogue: 0,0:06:05.78,0:06:09.31,Default,,0000,0000,0000,,!يا إلهي، أخبرتكم بالعودة
Dialogue: 0,0:06:09.31,0:06:11.85,Default,,0000,0000,0000,,ماذا سنفعل الآن يا كونان-كن؟
Dialogue: 0,0:06:11.85,0:06:13.49,Default,,0000,0000,0000,,نجد الجثّة
Dialogue: 0,0:06:13.49,0:06:16.57,Default,,0000,0000,0000,,...ماذا؟ لكنّ الشرطة قالت
Dialogue: 0,0:06:17.10,0:06:19.85,Default,,0000,0000,0000,,هناك أمرٌ نتن بشأن هذه المكتبة
Dialogue: 0,0:06:21.01,0:06:22.33,Default,,0000,0000,0000,,نتن؟
Dialogue: 0,0:06:25.30,0:06:27.85,Default,,0000,0000,0000,,!المصعد! أحدهم يصعد
Dialogue: 0,0:06:27.85,0:06:29.85,Default,,0000,0000,0000,,!اختبئوا
Dialogue: 0,0:06:34.87,0:06:37.28,Default,,0000,0000,0000,,!إنّه... مدير المكتبة تسوغاوا-سان
Dialogue: 0,0:06:38.53,0:06:40.42,Default,,0000,0000,0000,,ماذا يفعل في هذا الوقت؟
Dialogue: 0,0:06:45.99,0:06:48.85,Default,,0000,0000,0000,,...هناك حيث كان الكتاب الأجنبيّ الغريب
Dialogue: 0,0:06:50.02,0:06:52.06,Default,,0000,0000,0000,,كان تامادا ساذجاً بحقّ
Dialogue: 0,0:06:52.06,0:06:53.56,Default,,0000,0000,0000,,لم يكن ليمت
Dialogue: 0,0:06:53.56,0:06:55.69,Default,,0000,0000,0000,,لو لم ينظر داخل هذا
Dialogue: 0,0:06:58.38,0:07:00.22,Default,,0000,0000,0000,,والشرطة تبقى الشرطة
Dialogue: 0,0:07:00.22,0:07:02.77,Default,,0000,0000,0000,,غادروا بكلّ سهولة
Dialogue: 0,0:07:02.77,0:07:08.08,Default,,0000,0000,0000,,لم يعلموا أنّ تامادا راقد في هذه المكتبة
Dialogue: 0,0:07:12.50,0:07:13.81,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:07:13.81,0:07:18.02,Default,,0000,0000,0000,,جثّة تامادا-سان موجودة\N!في هذه المكتبة بالفعل
Dialogue: 0,0:07:18.61,0:07:20.48,Default,,0000,0000,0000,,!ومن قتله هو المدير تسوغاوا
Dialogue: 0,0:07:21.45,0:07:23.48,Default,,0000,0000,0000,,لكن أين الجثّة؟
Dialogue: 0,0:07:26.07,0:07:31.89,Default,,0000,0000,0000,,...ذاك الكتاب الغريب الذي كان مغلّفاً عكسياً
Dialogue: 0,0:07:33.27,0:07:35.73,Default,,0000,0000,0000,,...لا أرى شيئاً من الظلام
Dialogue: 0,0:07:36.52,0:07:37.32,Default,,0000,0000,0000,,!من هناك؟
Dialogue: 0,0:07:38.34,0:07:39.69,Default,,0000,0000,0000,,!أيوجد أحد؟
Dialogue: 0,0:08:03.32,0:08:04.44,Default,,0000,0000,0000,,!هنا؟
Dialogue: 0,0:08:13.56,0:08:17.07,Default,,0000,0000,0000,,...لا أظنّ أن علينا المغادرة من هنا لفترة
Dialogue: 0,0:08:18.93,0:08:21.92,Default,,0000,0000,0000,,...أشعر بالجوع يا كونان، أريد أكل غداء أنقليس معلّب
Dialogue: 0,0:08:30.50,0:08:32.48,Default,,0000,0000,0000,,حسناً، غادر
Dialogue: 0,0:08:33.58,0:08:37.06,Default,,0000,0000,0000,,سأبدأ بالكتب الغريبة في ذاك الصندوق
Dialogue: 0,0:08:43.07,0:08:45.19,Default,,0000,0000,0000,,!ماذا؟ إنّها فارغة
Dialogue: 0,0:08:45.53,0:08:48.94,Default,,0000,0000,0000,,لعلّه وضع المحتويات في حقيبته قبل مغادرته
Dialogue: 0,0:08:48.94,0:08:50.61,Default,,0000,0000,0000,,يستحيل ذلك
Dialogue: 0,0:08:50.61,0:08:52.94,Default,,0000,0000,0000,,انظر لكلّ هذه الأغطية
Dialogue: 0,0:08:52.94,0:08:55.19,Default,,0000,0000,0000,,لا يمكن أن تتسع حقيبته لكلّ هذا
Dialogue: 0,0:08:55.19,0:08:56.90,Default,,0000,0000,0000,,لا بدّ أنّه خبأ
Dialogue: 0,0:08:57.29,0:09:00.56,Default,,0000,0000,0000,,ما لم يستطع أخذه في مكان ما بهذه الغرفة
Dialogue: 0,0:09:01.93,0:09:06.02,Default,,0000,0000,0000,,يبدو أنّ علينا البحث عن تلك الكتب قبل الجثّة
Dialogue: 0,0:09:06.51,0:09:10.10,Default,,0000,0000,0000,,!حان وقت فرقة فتيان التحرّي أخيراً إذاً؟
Dialogue: 0,0:09:10.42,0:09:12.54,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:09:12.54,0:09:14.25,Default,,0000,0000,0000,,لنبدأ بهذه الخزانة أوّلاً
Dialogue: 0,0:09:14.25,0:09:18.31,Default,,0000,0000,0000,,لننفصل ونتفقد كلا الجانبين
Dialogue: 0,0:09:18.31,0:09:19.98,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:09:27.41,0:09:29.18,Default,,0000,0000,0000,,!حـ-حمقى! لا تضيئوا الأنوار
Dialogue: 0,0:09:29.57,0:09:31.85,Default,,0000,0000,0000,,...لكنّ المكان مظلم
Dialogue: 0,0:09:33.82,0:09:35.90,Default,,0000,0000,0000,,!ماذا لو رآنا؟
Dialogue: 0,0:09:35.90,0:09:37.32,Default,,0000,0000,0000,,لا تقلق
Dialogue: 0,0:09:37.89,0:09:40.73,Default,,0000,0000,0000,,!لا بدّ أنّه غادر بالفعل
Dialogue: 0,0:09:41.22,0:09:45.01,Default,,0000,0000,0000,,...آمل ذلك
Dialogue: 0,0:09:45.01,0:09:47.23,Default,,0000,0000,0000,,...يبدو أنّه غادر حقاً
Dialogue: 0,0:09:49.92,0:09:52.05,Default,,0000,0000,0000,,وجدت أيّ كتب غريبة؟
Dialogue: 0,0:09:52.05,0:09:53.77,Default,,0000,0000,0000,,كلا، مطلقاً
Dialogue: 0,0:09:54.46,0:09:57.54,Default,,0000,0000,0000,,يبدو أنّها ليست في هذه الخزانة
Dialogue: 0,0:09:57.54,0:10:00.69,Default,,0000,0000,0000,,فقد أخرجنا معظم الكتب
Dialogue: 0,0:10:00.69,0:10:04.31,Default,,0000,0000,0000,,!ماذا؟ لم يخرجا أيّاً من كتبهما
Dialogue: 0,0:10:05.16,0:10:06.11,Default,,0000,0000,0000,,!أنت! غينتا
Dialogue: 0,0:10:06.45,0:10:08.11,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:10:08.11,0:10:10.18,Default,,0000,0000,0000,,ما الذي تفعلانه؟
Dialogue: 0,0:10:10.18,0:10:12.90,Default,,0000,0000,0000,,!أخرجنا كلّ كتبنا
Dialogue: 0,0:10:14.65,0:10:15.53,Default,,0000,0000,0000,,!هذا غريب
Dialogue: 0,0:10:15.53,0:10:18.35,Default,,0000,0000,0000,,!أخرجنا كلّ كتبنا أيضاً
Dialogue: 0,0:10:18.35,0:10:19.98,Default,,0000,0000,0000,,ما-ما خطب هذا الكتاب؟
Dialogue: 0,0:10:20.35,0:10:21.77,Default,,0000,0000,0000,,!لا ظهر له
Dialogue: 0,0:10:22.81,0:10:23.94,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:10:25.39,0:10:29.14,Default,,0000,0000,0000,,ا-انظروا، كلّ الكتب هنا كذلك
Dialogue: 0,0:10:29.51,0:10:34.01,Default,,0000,0000,0000,,فهمت، لم تكن هذه الكتب مقلوبةً في أغطيتها
Dialogue: 0,0:10:34.01,0:10:36.30,Default,,0000,0000,0000,,!لم تكن لها أظهر من البداية
Dialogue: 0,0:10:36.30,0:10:38.33,Default,,0000,0000,0000,,ماذا؟ ما قصدك؟
Dialogue: 0,0:10:38.33,0:10:42.16,Default,,0000,0000,0000,,أي أنّ المدير وضع هذه الكتب
Dialogue: 0,0:10:42.16,0:10:44.12,Default,,0000,0000,0000,,بين الكتب على الرّفوف
Dialogue: 0,0:10:44.12,0:10:46.87,Default,,0000,0000,0000,,لصنع ثلاثة صفوف
Dialogue: 0,0:10:46.87,0:10:49.52,Default,,0000,0000,0000,,،لذا إن أخذ أحد كتاباً
Dialogue: 0,0:10:49.99,0:10:52.99,Default,,0000,0000,0000,,سيرى صفحات مفتوحة وراءه
Dialogue: 0,0:10:52.99,0:10:56.68,Default,,0000,0000,0000,,سيظنّها كتاباً على الجانب الآخر، ولن يدرك الحقيقة
Dialogue: 0,0:10:57.63,0:11:03.10,Default,,0000,0000,0000,,هذا ركن الأطفال، مما يجعل الأمر أسهل تصديقاً
Dialogue: 0,0:11:03.10,0:11:11.06,Default,,0000,0000,0000,,كانت الكتب غير مرتبة لأنّ الكتب في المنتصف\Nدفعتها عند إعادة أحد لكتاب
Dialogue: 0,0:11:12.30,0:11:14.72,Default,,0000,0000,0000,,لكن لمَ قد يفعل ذلك؟
Dialogue: 0,0:11:14.72,0:11:18.91,Default,,0000,0000,0000,,...كون هذه الكتب الغريبة مستوردة من خارج البلاد
Dialogue: 0,0:11:18.91,0:11:21.94,Default,,0000,0000,0000,,...يعني أنّ محتواها غالباً مسدّسات، أو
Dialogue: 0,0:11:22.50,0:11:23.94,Default,,0000,0000,0000,,!مخدّرات
Dialogue: 0,0:11:24.79,0:11:26.88,Default,,0000,0000,0000,,!يـ-يوجد هنا أيضاً
Dialogue: 0,0:11:28.15,0:11:29.23,Default,,0000,0000,0000,,!وهنا
Dialogue: 0,0:11:29.57,0:11:34.11,Default,,0000,0000,0000,,أي أنّ ذاك المدير يهرّب المخدّرات؟
Dialogue: 0,0:11:34.11,0:11:36.95,Default,,0000,0000,0000,,أجل، يخزّنها هنا
Dialogue: 0,0:11:36.95,0:11:39.48,Default,,0000,0000,0000,,ثم يبيعها ببطء
Dialogue: 0,0:11:40.06,0:11:43.27,Default,,0000,0000,0000,,تامادا-سان اكتشف ذلك صدفةً غالباً
Dialogue: 0,0:11:43.27,0:11:45.64,Default,,0000,0000,0000,,وقُتل كيلا يفضح الأمر
Dialogue: 0,0:11:46.48,0:11:48.97,Default,,0000,0000,0000,,على يد المدير تسوغاوا
Dialogue: 0,0:11:52.80,0:11:55.82,Default,,0000,0000,0000,,ماذا؟ هذا غريب، لا يتّصل الخط
Dialogue: 0,0:11:56.22,0:11:57.75,Default,,0000,0000,0000,,أهو معطل؟
Dialogue: 0,0:11:57.75,0:12:01.31,Default,,0000,0000,0000,,أجل، خيارنا الوحيد هو الخروج\Nوإخبار الشرطة مباشرةً
Dialogue: 0,0:12:01.31,0:12:04.31,Default,,0000,0000,0000,,!لنجد الجثّة بينما نفعل ذلك إذاً
Dialogue: 0,0:12:04.75,0:12:08.36,Default,,0000,0000,0000,,!أجل! فكرة حسنة، هكذا سيتضاعف إنجازنا
Dialogue: 0,0:12:08.36,0:12:09.60,Default,,0000,0000,0000,,!أتّفق
Dialogue: 0,0:12:09.91,0:12:11.48,Default,,0000,0000,0000,,...أنتم
Dialogue: 0,0:12:12.61,0:12:15.07,Default,,0000,0000,0000,,سينتشر اسمنا مجدداً بعدما نجد الجثّة
Dialogue: 0,0:12:15.07,0:12:16.82,Default,,0000,0000,0000,,!هذا مُثير
Dialogue: 0,0:12:22.73,0:12:24.61,Default,,0000,0000,0000,,...انفك رباط حذائي
Dialogue: 0,0:12:25.10,0:12:27.56,Default,,0000,0000,0000,,...من الصعب ربطه في الظلام
Dialogue: 0,0:12:29.93,0:12:30.89,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:12:31.18,0:12:32.87,Default,,0000,0000,0000,,ما الذي تفعلينه؟
Dialogue: 0,0:12:32.87,0:12:34.06,Default,,0000,0000,0000,,...حذائي
Dialogue: 0,0:12:34.30,0:12:37.03,Default,,0000,0000,0000,,هذا ما يحصل لارتداءك حذاءً مزعجاً
Dialogue: 0,0:12:37.30,0:12:38.54,Default,,0000,0000,0000,,!يا لقسوتك
Dialogue: 0,0:12:38.54,0:12:40.55,Default,,0000,0000,0000,,!هذا حذائي المفضل
Dialogue: 0,0:12:47.21,0:12:51.99,Default,,0000,0000,0000,,لن يخبّئ أحد جثّةً في خزانة كتب في العادة، صحيح؟
Dialogue: 0,0:12:51.99,0:12:57.64,Default,,0000,0000,0000,,!لكنّ الشرطة قالت أنّها فتّشت كل الأماكن الخفية
Dialogue: 0,0:12:57.64,0:13:01.36,Default,,0000,0000,0000,,لم تبق أماكن نبحث فيها
Dialogue: 0,0:13:01.36,0:13:04.86,Default,,0000,0000,0000,,!اسمعوا، توجد خزانات كتب غريبة في الخلف
Dialogue: 0,0:13:05.31,0:13:07.77,Default,,0000,0000,0000,,!انظروا! لديها مقابض غريبة
Dialogue: 0,0:13:07.77,0:13:10.76,Default,,0000,0000,0000,,هذه خزانات كتب متنقلة
Dialogue: 0,0:13:10.76,0:13:11.90,Default,,0000,0000,0000,,متنقلة؟
Dialogue: 0,0:13:11.90,0:13:12.65,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:15.47,0:13:19.27,Default,,0000,0000,0000,,تدير المقبض هكذا و... انظروا
Dialogue: 0,0:13:19.27,0:13:21.77,Default,,0000,0000,0000,,!مُذهل
Dialogue: 0,0:13:22.09,0:13:27.64,Default,,0000,0000,0000,,لا يُعقل... سيكون سهلاً أن يكتشف\Nأحد الجثة إنّ خبأها هنا
Dialogue: 0,0:13:28.99,0:13:30.37,Default,,0000,0000,0000,,!هذا مُسلٍّ
Dialogue: 0,0:13:31.49,0:13:32.90,Default,,0000,0000,0000,,ما الخطب يا غينتا؟
Dialogue: 0,0:13:31.49,0:13:32.90,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:13:32.90,0:13:36.36,Default,,0000,0000,0000,,!المقبض متصلّب ولا أستطيع تحريكه
Dialogue: 0,0:13:36.78,0:13:37.55,Default,,0000,0000,0000,,!أيمكن؟
Dialogue: 0,0:13:40.65,0:13:43.86,Default,,0000,0000,0000,,!ميتسوهيكو! أيومي-تشان! ساعداني بتحريك هذه
Dialogue: 0,0:13:43.86,0:13:45.06,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:13:45.65,0:13:48.01,Default,,0000,0000,0000,,...استعداد
Dialogue: 0,0:13:56.51,0:13:58.52,Default,,0000,0000,0000,,...ماذا؟ لا شيء هنا
Dialogue: 0,0:14:00.17,0:14:04.22,Default,,0000,0000,0000,,ولا شيء غريب بالتحديد
Dialogue: 0,0:14:04.22,0:14:09.58,Default,,0000,0000,0000,,...ما يعني أنّ سبب صعوبة تحريكها
Dialogue: 0,0:14:09.58,0:14:12.62,Default,,0000,0000,0000,,!هو ثقلك أنت يا غينتا
Dialogue: 0,0:14:12.62,0:14:13.98,Default,,0000,0000,0000,,!غـ-غلطتي أنا
Dialogue: 0,0:14:14.58,0:14:16.62,Default,,0000,0000,0000,,!أنت بدين جدّاً يا غينتا-كن
Dialogue: 0,0:14:16.62,0:14:17.61,Default,,0000,0000,0000,,كم وزنك؟
Dialogue: 0,0:14:17.61,0:14:19.43,Default,,0000,0000,0000,,!أ-أربعون كيلو
Dialogue: 0,0:14:19.43,0:14:20.98,Default,,0000,0000,0000,,!هذا ضعف وزني
Dialogue: 0,0:14:21.28,0:14:23.78,Default,,0000,0000,0000,,...يا إلهي، لا أستطيع تحمل هذا
Dialogue: 0,0:14:23.78,0:14:28.06,Default,,0000,0000,0000,,اصبر! هذا آخر يوم سأتسكع فيه\N!مع هؤلاء الأطفال
Dialogue: 0,0:14:28.06,0:14:31.42,Default,,0000,0000,0000,,بعدما أشرب ذاك الساكي وأرجع\N...لكوني طالباً في الثانوية
Dialogue: 0,0:14:31.42,0:14:32.81,Default,,0000,0000,0000,,أرجع؟
Dialogue: 0,0:14:32.81,0:14:36.60,Default,,0000,0000,0000,,!وزني 15 كيلو، عليك القيام بحمية
Dialogue: 0,0:14:36.60,0:14:37.93,Default,,0000,0000,0000,,!ا-اصمتي
Dialogue: 0,0:14:38.67,0:14:42.85,Default,,0000,0000,0000,,!صحيح، نسيت! أنا طفل الآن
Dialogue: 0,0:14:42.85,0:14:47.11,Default,,0000,0000,0000,,لحظة، كان وزني 18 كغ عندما قسته آخر مرة
Dialogue: 0,0:14:47.11,0:14:48.93,Default,,0000,0000,0000,,!أوقفوا المصعد قليلاً
Dialogue: 0,0:14:51.81,0:14:54.11,Default,,0000,0000,0000,,!عرفت أين خبّأ الجثة
Dialogue: 0,0:14:57.74,0:15:00.64,Default,,0000,0000,0000,,!كونان! انتظرنا
Dialogue: 0,0:15:10.93,0:15:14.02,Default,,0000,0000,0000,,كونان، أين أنت؟
Dialogue: 0,0:15:14.02,0:15:17.37,Default,,0000,0000,0000,,!كونان-كن، قل شيئاً
Dialogue: 0,0:15:21.22,0:15:22.94,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:15:23.34,0:15:25.13,Default,,0000,0000,0000,,أين كنت؟
Dialogue: 0,0:15:25.13,0:15:27.22,Default,,0000,0000,0000,,في غرفة المكائن في الأعلى
Dialogue: 0,0:15:27.22,0:15:29.50,Default,,0000,0000,0000,,أكانت الجثّة هناك؟
Dialogue: 0,0:15:29.50,0:15:34.48,Default,,0000,0000,0000,,كلا، ذهبتُ لتبديل تحكّم باب المصعد\Nللوضع اليدوي لا أكثر
Dialogue: 0,0:15:35.04,0:15:37.99,Default,,0000,0000,0000,,!الجثّة غالباً... هنا
Dialogue: 0,0:15:40.03,0:15:41.59,Default,,0000,0000,0000,,أأنت متأكد أنّها هنا؟
Dialogue: 0,0:15:41.59,0:15:42.69,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:15:43.49,0:15:46.32,Default,,0000,0000,0000,,والدليل هو إنذار الطنّان
Dialogue: 0,0:15:46.32,0:15:49.85,Default,,0000,0000,0000,,عندما دخلنا المصعد ظهيرة اليوم
Dialogue: 0,0:15:49.85,0:15:50.85,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:50.85,0:15:53.35,Default,,0000,0000,0000,,لكنّه تفعّل لأنّ عددنا
Dialogue: 0,0:15:53.35,0:15:55.15,Default,,0000,0000,0000,,كان أكثر من 8 في المصعد
Dialogue: 0,0:15:55.15,0:15:57.55,Default,,0000,0000,0000,,!أحمق، نحن أطفال
Dialogue: 0,0:15:57.55,0:15:59.84,Default,,0000,0000,0000,,!نزن مجتمعين 100 كغ على الأكثر
Dialogue: 0,0:15:59.84,0:16:01.18,Default,,0000,0000,0000,,!بالغ ونصف
Dialogue: 0,0:16:01.18,0:16:05.15,Default,,0000,0000,0000,,،حتّى مع وزن البالغين والصندوق
Dialogue: 0,0:16:05.55,0:16:09.10,Default,,0000,0000,0000,,!كان هناك شخص ناقص ليتم تفعيل الإنذار
Dialogue: 0,0:16:09.10,0:16:14.00,Default,,0000,0000,0000,,أجل، كان هناك شخص على المصعد من البداية
Dialogue: 0,0:16:14.00,0:16:16.05,Default,,0000,0000,0000,,...في مكان لا يمكن أن يراه فيه أحد
Dialogue: 0,0:16:17.32,0:16:18.44,Default,,0000,0000,0000,,!فوق المصعد
Dialogue: 0,0:16:21.41,0:16:27.56,Default,,0000,0000,0000,,يبدو أنّه رُمي من الأعلى فوق المصعد\Nبعدما خُنق بالنظر لحالته
Dialogue: 0,0:16:28.23,0:16:30.98,Default,,0000,0000,0000,,كان كلّ ذلك من فعل المدير تسوغاوا
Dialogue: 0,0:16:30.98,0:16:32.90,Default,,0000,0000,0000,,!حسناً، لنذهب لإخبار الشرطة
Dialogue: 0,0:16:34.65,0:16:35.65,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:16:36.81,0:16:37.97,Default,,0000,0000,0000,,...تسو-تسو
Dialogue: 0,0:16:37.97,0:16:39.01,Default,,0000,0000,0000,,...مد-مد
Dialogue: 0,0:16:39.01,0:16:40.68,Default,,0000,0000,0000,,تسومد؟
Dialogue: 0,0:16:45.69,0:16:48.10,Default,,0000,0000,0000,,!المدير تسوغاوا
Dialogue: 0,0:16:48.83,0:16:53.35,Default,,0000,0000,0000,,ماذا تفعلون في هذا الوقت يا صغار؟
Dialogue: 0,0:16:54.44,0:16:56.46,Default,,0000,0000,0000,,هيّا، تعالوا
Dialogue: 0,0:16:56.46,0:16:58.77,Default,,0000,0000,0000,,سنرجع معاً
Dialogue: 0,0:16:59.28,0:17:00.10,Default,,0000,0000,0000,,...هيّا
Dialogue: 0,0:17:00.49,0:17:04.11,Default,,0000,0000,0000,,اسمعوا، افعلوا ما سأقوله لكم
Dialogue: 0,0:17:05.57,0:17:07.77,Default,,0000,0000,0000,,ما الذي تتكلمون فيه؟
Dialogue: 0,0:17:07.77,0:17:09.48,Default,,0000,0000,0000,,لنرجع معاً
Dialogue: 0,0:17:10.61,0:17:14.23,Default,,0000,0000,0000,,لا تستهن بنا لأنّنا أطفال فحسب أيّها المدير
Dialogue: 0,0:17:14.23,0:17:15.73,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:15.73,0:17:17.93,Default,,0000,0000,0000,,لدينا الدليل
Dialogue: 0,0:17:17.93,0:17:21.69,Default,,0000,0000,0000,,،حيلة خزانة الكتب، المخدرات المخبأة
Dialogue: 0,0:17:22.18,0:17:26.86,Default,,0000,0000,0000,,!وقتلك تامادا-سان بعدما اكتشف أمرك
Dialogue: 0,0:17:28.25,0:17:31.44,Default,,0000,0000,0000,,!من... من أنت؟
Dialogue: 0,0:17:31.44,0:17:34.77,Default,,0000,0000,0000,,!إيدوغاوا كونان! مُتحرٍّ
Dialogue: 0,0:17:34.77,0:17:36.39,Default,,0000,0000,0000,,!مـ-متحرٍّ؟
Dialogue: 0,0:17:41.19,0:17:43.02,Default,,0000,0000,0000,,!لن أدعك
Dialogue: 0,0:17:46.40,0:17:48.30,Default,,0000,0000,0000,,!انزلاق آمن
Dialogue: 0,0:17:48.30,0:17:49.85,Default,,0000,0000,0000,,!فعلناها
Dialogue: 0,0:17:51.31,0:17:55.27,Default,,0000,0000,0000,,!أيّها الأوغاد، لن تهربوا أيّها الأطفال اللعينون
Dialogue: 0,0:18:01.89,0:18:03.43,Default,,0000,0000,0000,,وصلتُ في الوقت
Dialogue: 0,0:18:04.93,0:18:06.18,Default,,0000,0000,0000,,...استعدوا
Dialogue: 0,0:18:07.89,0:18:09.33,Default,,0000,0000,0000,,...أيّها الأطفال
Dialogue: 0,0:18:10.42,0:18:14.19,Default,,0000,0000,0000,,اختفوا؟ هل نزلوا في منتصف الطريق؟
Dialogue: 0,0:18:15.71,0:18:19.66,Default,,0000,0000,0000,,،حسناً، لا يهم. بعدما أوقفت المصعد
Dialogue: 0,0:18:19.66,0:18:21.27,Default,,0000,0000,0000,,سيصبحون محتجزين كالجرذان
Dialogue: 0,0:18:23.20,0:18:25.54,Default,,0000,0000,0000,,انتظري أيّتها الجرذان الصغيرة
Dialogue: 0,0:18:25.54,0:18:28.52,Default,,0000,0000,0000,,!سأقتلكم واحداً تلو الآخر
Dialogue: 0,0:18:30.03,0:18:33.69,Default,,0000,0000,0000,,!أين أنتم يا صغار؟
Dialogue: 0,0:18:34.07,0:18:36.78,Default,,0000,0000,0000,,!أعتذر على ما فعلتُه قبل قليل
Dialogue: 0,0:18:36.78,0:18:40.72,Default,,0000,0000,0000,,!لن أحاول أذيّتكم مُجدداً! اخرجوا فحسب
Dialogue: 0,0:18:48.01,0:18:49.81,Default,,0000,0000,0000,,هنا؟
Dialogue: 0,0:18:53.71,0:18:56.97,Default,,0000,0000,0000,,أظنّوا أن هذا حاجز حقاً؟
Dialogue: 0,0:19:04.37,0:19:05.65,Default,,0000,0000,0000,,...إنّه مائل
Dialogue: 0,0:19:06.16,0:19:09.60,Default,,0000,0000,0000,,فهمت، وضعوا كتباً تحته
Dialogue: 0,0:19:11.31,0:19:12.36,Default,,0000,0000,0000,,!الآن
Dialogue: 0,0:19:22.64,0:19:25.32,Default,,0000,0000,0000,,للأطفال حيل سطحية
Dialogue: 0,0:19:25.32,0:19:29.35,Default,,0000,0000,0000,,لا تقلقوا، لن تشعروا بالوحدة
Dialogue: 0,0:19:29.35,0:19:34.83,Default,,0000,0000,0000,,!لأنّي سأرسلكم الأربعة للعالم الآخر معاً
Dialogue: 0,0:19:42.44,0:19:44.02,Default,,0000,0000,0000,,!نجحنا
Dialogue: 0,0:19:44.54,0:19:47.32,Default,,0000,0000,0000,,!عملت بإتقان
Dialogue: 0,0:19:49.90,0:19:55.40,Default,,0000,0000,0000,,بعد بلاغنا، أسرعت الشرطة للمكان واعتقلت المدير تسوغاوا
Dialogue: 0,0:19:55.40,0:20:00.40,Default,,0000,0000,0000,,استرجعوا أيضاً جثّة تامادا-سان وكلّ المخدرات
Dialogue: 0,0:20:01.77,0:20:07.31,Default,,0000,0000,0000,,وهكذا أُقفلت آخر قضيّة لإيدوغاوا كونان
Dialogue: 0,0:20:07.31,0:20:09.18,Default,,0000,0000,0000,,!كان ذلك مخيفاً
Dialogue: 0,0:20:09.18,0:20:11.30,Default,,0000,0000,0000,,!ظننتنا هالكين
Dialogue: 0,0:20:11.30,0:20:14.15,Default,,0000,0000,0000,,!أحمق! الخير ينتصر دوماً
Dialogue: 0,0:20:14.59,0:20:17.10,Default,,0000,0000,0000,,...يمكنني توديع هذا الجسد الآن
Dialogue: 0,0:20:17.58,0:20:19.68,Default,,0000,0000,0000,,!لنعاود الكرّة في وقت ما يا كونان-كن
Dialogue: 0,0:20:21.24,0:20:23.04,Default,,0000,0000,0000,,!فرقة فتيان التحرّي
Dialogue: 0,0:20:23.51,0:20:26.75,Default,,0000,0000,0000,,!يمكننا الأربعة معاً حلّ أيّ قضية بسهولة
Dialogue: 0,0:20:27.29,0:20:29.07,Default,,0000,0000,0000,,!حسناً! لنجتهد المرة القادمة أيضاً
Dialogue: 0,0:20:29.57,0:20:30.48,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:20:31.66,0:20:35.12,Default,,0000,0000,0000,,و... توديعهم أيضاً
Dialogue: 0,0:20:37.73,0:20:39.60,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:20:40.19,0:20:41.31,Default,,0000,0000,0000,,!وداعاً
Dialogue: 0,0:20:45.81,0:20:48.68,Default,,0000,0000,0000,,...أشعر أنّه يرحل بشكلٍ ما
Dialogue: 0,0:20:48.68,0:20:50.35,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:50.72,0:20:54.02,Default,,0000,0000,0000,,!صحيح، سأرجع لجسدي الطبيعيّ
Dialogue: 0,0:20:54.59,0:20:56.89,Default,,0000,0000,0000,,!لطالب المرحلة الثانوية، كودو شينتشي
Dialogue: 0,0:20:58.25,0:21:01.91,Default,,0000,0000,0000,,!يمكنني العودة أخيراً... بهذا الساكي
Dialogue: 0,0:21:04.00,0:21:06.21,Default,,0000,0000,0000,,كونان-كن؟ أرجعت الآن؟
Dialogue: 0,0:21:06.21,0:21:09.39,Default,,0000,0000,0000,,...ماذا كنت تفعل حتّى هذا الوقت
Dialogue: 0,0:21:10.12,0:21:11.44,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:21:14.98,0:21:18.10,Default,,0000,0000,0000,,!ماذا؟! رجع جسدك لطبيعته؟
Dialogue: 0,0:21:18.57,0:21:21.40,Default,,0000,0000,0000,,!أجل، بعد جرعة واحدة من هذا الساكي
Dialogue: 0,0:21:21.40,0:21:23.74,Default,,0000,0000,0000,,...لا يُعقل
Dialogue: 0,0:21:23.74,0:21:26.85,Default,,0000,0000,0000,,!إذا ظننتني أكذب فراقب
Dialogue: 0,0:21:26.85,0:21:27.82,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:21:29.77,0:21:34.63,Default,,0000,0000,0000,,!ها هو! أشعر بجسدي يسخن
Dialogue: 0,0:23:09.09,0:23:14.13,Default,,0000,0000,0000,,!بروفسور! لم أرجع البتّة
Dialogue: 0,0:23:15.03,0:23:17.87,Default,,0000,0000,0000,,كوّنت مناعةً على الأرجح
Dialogue: 0,0:23:17.87,0:23:18.94,Default,,0000,0000,0000,,مناعة؟
Dialogue: 0,0:23:20.02,0:23:24.61,Default,,0000,0000,0000,,أي أنّ الساكي أعاد جسدك لطبيعته\N...بدايةً بشكلٍ ما
Dialogue: 0,0:23:25.10,0:23:29.36,Default,,0000,0000,0000,,،لكنّ كوّن جسدك بعدها مادةً لمقاومة الساكي
Dialogue: 0,0:23:29.36,0:23:31.65,Default,,0000,0000,0000,,فمنع فعاليته
Dialogue: 0,0:23:31.94,0:23:35.28,Default,,0000,0000,0000,,!لا تمازحني! لم أشرب ما يكفي فحسب حتماً
Dialogue: 0,0:23:35.98,0:23:37.72,Default,,0000,0000,0000,,!انتظر! توقف يا شينتشي
Dialogue: 0,0:23:38.09,0:23:39.46,Default,,0000,0000,0000,,!مزيداً مزيداً
Dialogue: 0,0:23:39.46,0:23:40.72,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:23:47.51,0:23:49.47,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:23:49.47,0:23:51.64,Default,,0000,0000,0000,,...تبدو شاحباً
Dialogue: 0,0:23:51.64,0:23:53.25,Default,,0000,0000,0000,,أهو الزكام مجدداً؟
Dialogue: 0,0:23:53.72,0:23:58.67,Default,,0000,0000,0000,,...يا حمقى، إنّه مجرد أثر شراب
Dialogue: 0,0:24:02.39,0:24:03.83,Default,,0000,0000,0000,,إخفاق آخر؟
Dialogue: 0,0:24:03.83,0:24:06.30,Default,,0000,0000,0000,,...عشرون توالياً
Dialogue: 0,0:24:06.30,0:24:08.18,Default,,0000,0000,0000,,إنّه سيّئ في الغولف حقاً
Dialogue: 0,0:24:08.18,0:24:12.29,Default,,0000,0000,0000,,أجل، قال أنّه لا يجيد\Nأيّ رياضة بها أدوات
Dialogue: 0,0:24:14.98,0:24:17.84,Default,,0000,0000,0000,,ما كان ذاك الصوت المعدني إذاً؟
Dialogue: 0,0:24:18.64,0:24:19.87,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:24:19.87,0:24:22.20,Default,,0000,0000,0000,,!هذه حيلة وضعها القاتل
Dialogue: 0,0:24:22.20,0:24:24.00,Default,,0000,0000,0000,,!إنّه ذاك الشخص بلا شك
Dialogue: 0,0:24:24.37,0:24:26.01,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.01,0:24:28.94,Default,,0000,0000,0000,,جريمة قتل ساحة تمرين الغولف
Dialogue: 0,0:24:45.15,0:24:47.56,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.56,0:24:50.06,Default,,0000,0000,0000,,مجموعة غولف
Dialogue: 0,0:24:50.06,0:24:51.81,Default,,0000,0000,0000,,،الحلقة القادمة لا يمكن تفويتها\N!حتّى للآباء
Dialogue: 0,0:24:51.81,0:24:53.63,Default,,0000,0000,0000,,!استنتاج غينتا أشبه بضربة جميلة
Dialogue: 0,0:24:53.63,0:24:55.63,Default,,0000,0000,0000,,خارج الملعب

