Dialogue: 0,0:00:01.45,0:00:03.05,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:03.18,0:00:06.35,Default,,0000,0000,0000,,أُجبر مُتحرّي الثانوية كودو شينتشي\Nعلى تجرّع عقار قلّص جسده
Dialogue: 0,0:00:06.45,0:00:07.70,Default,,0000,0000,0000,,لا يهم صغر بنيتي
Dialogue: 0,0:00:07.70,0:00:09.47,Default,,0000,0000,0000,,!فعقلي هو عقل مُتحرٍّ عظيم سابق
Dialogue: 0,0:00:09.47,0:00:10.92,Default,,0000,0000,0000,,!قضيّة اليوم تقع أحداثها في متحف فنون
Dialogue: 0,0:00:10.92,0:00:12.63,Default,,0000,0000,0000,,!خلف اللوحات الفنّية موت أحمر مروع
Dialogue: 0,0:00:12.63,0:00:15.63,Default,,0000,0000,0000,,!مهما كان نوع القضيّة، الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.15,0:01:52.13,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل مالك متحف الفنون
Dialogue: 0,0:01:47.21,0:01:50.29,Default,,0000,0000,0000,,جريمة قتل مالك متحف الفنون
Dialogue: 0,0:01:52.15,0:01:55.92,On Top,,0000,0000,0000,,معرض فنّ القرون الوسطى
Dialogue: 0,0:01:59.04,0:02:02.86,Default,,0000,0000,0000,,حراسة معرض فنون ليلاً هي\N!آخر ما أردته
Dialogue: 0,0:02:02.86,0:02:05.73,Default,,0000,0000,0000,,لن تصبح حارس أمن جيد بتفكير كهذا
Dialogue: 0,0:02:07.07,0:02:09.40,Default,,0000,0000,0000,,ألم تسمع شيئاً؟
Dialogue: 0,0:02:09.40,0:02:11.53,Default,,0000,0000,0000,,أ-أوقف هذا رجاءً يا سينباي
Dialogue: 0,0:02:12.81,0:02:15.60,Default,,0000,0000,0000,,أ-أتى من هذه الغرفة
Dialogue: 0,0:02:15.60,0:02:16.74,Default,,0000,0000,0000,,!مـ-من هناك؟
Dialogue: 0,0:02:17.43,0:02:19.81,Default,,0000,0000,0000,,أيوجد أحد؟
Dialogue: 0,0:02:34.45,0:02:36.82,Default,,0000,0000,0000,,درع قرون متوسطة؟ بنفسه؟
Dialogue: 0,0:02:37.20,0:02:39.41,Default,,0000,0000,0000,,رآه حارسان
Dialogue: 0,0:02:39.41,0:02:41.53,Default,,0000,0000,0000,,!الجميع يتكلم عن الأمر
Dialogue: 0,0:02:41.53,0:02:45.49,Default,,0000,0000,0000,,لمَ لا نذهب نحن الثلاثة الآن؟\N!يبدو الأمر مثيراً
Dialogue: 0,0:02:51.73,0:02:56.28,Default,,0000,0000,0000,,اختلق المتحف تلك القصة\Nلجذب مزيد من الزوّار حتماً
Dialogue: 0,0:02:56.28,0:03:00.11,Default,,0000,0000,0000,,صحيح يا ران، سينطلي ذلك على الأطفال فقط
Dialogue: 0,0:03:01.13,0:03:02.99,Default,,0000,0000,0000,,!كلام من طفل
Dialogue: 0,0:03:02.99,0:03:05.05,Default,,0000,0000,0000,,حسنٌ، وقت العمل
Dialogue: 0,0:03:05.05,0:03:06.82,Default,,0000,0000,0000,,سأنجز فرضي المدرسي
Dialogue: 0,0:03:07.13,0:03:08.41,Default,,0000,0000,0000,,!توقّفا
Dialogue: 0,0:03:12.82,0:03:13.96,Default,,0000,0000,0000,,سنذهب، صحيح؟
Dialogue: 0,0:03:13.96,0:03:14.91,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:03:16.21,0:03:19.37,Default,,0000,0000,0000,,تفعل ران هذا دوماً عندما تغضب
Dialogue: 0,0:03:19.37,0:03:22.07,Default,,0000,0000,0000,,كان علي ألّا أدعها تتعلم الكاراتيه
Dialogue: 0,0:03:37.35,0:03:39.12,Default,,0000,0000,0000,,!انظروا لكلّ هذه اللوحات الجميلة
Dialogue: 0,0:03:39.85,0:03:41.22,Default,,0000,0000,0000,,!أنا مسرورة لقدومنا
Dialogue: 0,0:03:41.22,0:03:43.57,Default,,0000,0000,0000,,!انظرا لهذه! ألوانها جميلة
Dialogue: 0,0:03:44.47,0:03:47.47,Default,,0000,0000,0000,,أعجبتك اللوحة يا آنسة؟
Dialogue: 0,0:03:47.47,0:03:49.28,Default,,0000,0000,0000,,أنا أحب هذه اللوحة كثيراً أيضاً
Dialogue: 0,0:03:49.84,0:03:54.71,Default,,0000,0000,0000,,بالأحرى أحب كلّ اللوحات هنا
Dialogue: 0,0:03:54.71,0:03:56.71,Default,,0000,0000,0000,,كما لو كانت صغاري
Dialogue: 0,0:03:56.71,0:03:58.74,Default,,0000,0000,0000,,عذراً، من أنت؟
Dialogue: 0,0:03:59.29,0:04:01.24,Default,,0000,0000,0000,,يا لفظاظتي
Dialogue: 0,0:04:01.24,0:04:04.40,Default,,0000,0000,0000,,أنا مدير هذا المعرض الفنّي، اسمي أوتشياي
Dialogue: 0,0:04:05.57,0:04:07.87,Default,,0000,0000,0000,,!المدير! كان عليّ أن أعرف
Dialogue: 0,0:04:08.36,0:04:12.07,Default,,0000,0000,0000,,استمتعي بزيارتك رجاءً
Dialogue: 0,0:04:16.06,0:04:18.40,Default,,0000,0000,0000,,!كوبوتا! ما الذي تفعله؟
Dialogue: 0,0:04:18.40,0:04:23.45,Default,,0000,0000,0000,,!أخبرك دوماً أن ترتدي قفازات عند لمس المعروضات
Dialogue: 0,0:04:23.81,0:04:25.66,Default,,0000,0000,0000,,!آ-آسف
Dialogue: 0,0:04:26.18,0:04:27.89,Default,,0000,0000,0000,,يمكنك الذهاب
Dialogue: 0,0:04:27.89,0:04:29.68,Default,,0000,0000,0000,,إيجيما-كن، اعتن بهذه نيابة عنه
Dialogue: 0,0:04:29.68,0:04:30.23,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:04:34.50,0:04:36.42,Default,,0000,0000,0000,,فارغ وهادئ كالعادة
Dialogue: 0,0:04:36.42,0:04:37.75,Default,,0000,0000,0000,,...المالك ماناكا
Dialogue: 0,0:04:37.75,0:04:40.37,Default,,0000,0000,0000,,تبقت 10 أيام حتى إغلاق هذا المكان
Dialogue: 0,0:04:40.37,0:04:45.91,Default,,0000,0000,0000,,اعتن بهذه القمامة القديمة العفنة حتّى حينها
Dialogue: 0,0:04:47.28,0:04:49.87,Default,,0000,0000,0000,,حسناً أيّها المعماري، أحضر المخططات
Dialogue: 0,0:04:49.87,0:04:50.73,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:04:53.90,0:04:56.07,Default,,0000,0000,0000,,سيُغلق هذا المعرض؟
Dialogue: 0,0:04:56.77,0:05:00.22,Default,,0000,0000,0000,,أجل، أفلست شركة المالك السابق
Dialogue: 0,0:05:00.22,0:05:02.53,Default,,0000,0000,0000,,فباع المعرض للمالك الجديد ماناكا
Dialogue: 0,0:05:02.85,0:05:06.60,Default,,0000,0000,0000,,باعه باتّفاق أن يحافظ ماناكا على المكان
Dialogue: 0,0:05:06.60,0:05:09.22,Default,,0000,0000,0000,,...لكن فورما اشتراه
Dialogue: 0,0:05:09.22,0:05:11.86,Default,,0000,0000,0000,,!قال أنّه سيحول هذا المكان إلى فندق
Dialogue: 0,0:05:15.24,0:05:18.20,Default,,0000,0000,0000,,يعامل المعروضات بإهمال مُجدداً
Dialogue: 0,0:05:18.84,0:05:21.53,Default,,0000,0000,0000,,أنتَ كوبوتا-كن، صحيح؟
Dialogue: 0,0:05:21.53,0:05:23.15,Default,,0000,0000,0000,,سمعت عنك
Dialogue: 0,0:05:23.53,0:05:26.41,Default,,0000,0000,0000,,أقترح أن تسرع بجمع أكبر ما يمكنك من المال
Dialogue: 0,0:05:29.74,0:05:30.94,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:05:31.44,0:05:32.82,Default,,0000,0000,0000,,!مُجدداً؟
Dialogue: 0,0:05:32.82,0:05:35.28,Default,,0000,0000,0000,,حسناً، استمتعوا بزيارتكم رجاءً
Dialogue: 0,0:05:38.40,0:05:40.88,Default,,0000,0000,0000,,لماذا لم يغضب هذه المرّة؟
Dialogue: 0,0:05:42.22,0:05:46.18,On Top,,0000,0000,0000,,معرض الأرض
Dialogue: 0,0:05:46.16,0:05:50.11,On Top,,0000,0000,0000,,معرض السماء
Dialogue: 0,0:05:50.11,0:05:54.07,On Top,,0000,0000,0000,,معرض البحر
Dialogue: 0,0:05:56.30,0:05:57.53,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:58.21,0:05:59.98,Default,,0000,0000,0000,,الدخول ممنوع
Dialogue: 0,0:06:00.54,0:06:04.54,Default,,0000,0000,0000,,غريب، يُفترض أن هناك حجرة أخرى أمامنا
Dialogue: 0,0:06:04.54,0:06:08.04,Default,,0000,0000,0000,,تجاهليها، لننته سريعاً ونخرج من هنا
Dialogue: 0,0:06:15.11,0:06:16.44,Default,,0000,0000,0000,,أشعر بالإرهاق
Dialogue: 0,0:06:16.44,0:06:18.53,Default,,0000,0000,0000,,لنرجع يا ران-نيتشان
Dialogue: 0,0:06:18.53,0:06:19.74,Default,,0000,0000,0000,,أتضوّر جوعاً
Dialogue: 0,0:06:19.74,0:06:25.22,Default,,0000,0000,0000,,!أنتما مثيران للشفقة! تتعبان بهذه السهولة
Dialogue: 0,0:06:25.22,0:06:25.70,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:27.06,0:06:30.88,Default,,0000,0000,0000,,اختفت لافتة المنع
Dialogue: 0,0:06:30.88,0:06:34.66,Default,,0000,0000,0000,,اسمعا، لمَ لا نذهب لرؤية الغرفة الأخيرة\Nبما أننا هنا؟
Dialogue: 0,0:06:37.21,0:06:38.88,Default,,0000,0000,0000,,يمكنكما العودة إن أردتما
Dialogue: 0,0:06:38.88,0:06:41.29,Default,,0000,0000,0000,,لكنكما ستحضّران العشاء بمفردكما
Dialogue: 0,0:06:43.25,0:06:45.49,Default,,0000,0000,0000,,!ليس منصفاً
Dialogue: 0,0:06:43.25,0:06:45.49,Default,,0000,0000,0000,,!ليس منصفاً
Dialogue: 0,0:06:48.70,0:06:50.98,On Top,,0000,0000,0000,,معرض الجحيم
Dialogue: 0,0:06:52.65,0:06:55.89,Default,,0000,0000,0000,,هذه الغرفة حالكة الظلام
Dialogue: 0,0:06:55.89,0:06:57.93,Default,,0000,0000,0000,,لهذا هو معرض الجحيم
Dialogue: 0,0:07:03.68,0:07:05.18,Default,,0000,0000,0000,,!لوحة عملاقة
Dialogue: 0,0:07:05.18,0:07:07.48,Default,,0000,0000,0000,,كأنّها لوحة من الجحيم فعلاً
Dialogue: 0,0:07:08.34,0:07:10.94,Default,,0000,0000,0000,,"حسناً، العنوان هو "عقوبة سماوية
Dialogue: 0,0:07:11.88,0:07:16.90,Default,,0000,0000,0000,,مكتوب أنّها لوحة قام فيها فارس عدالة\Nبالختم على شيطان
Dialogue: 0,0:07:25.16,0:07:26.69,Default,,0000,0000,0000,,!المالك ماناكا
Dialogue: 0,0:07:36.14,0:07:37.60,Default,,0000,0000,0000,,أنت مجدداً؟
Dialogue: 0,0:07:37.60,0:07:38.73,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:07:38.73,0:07:42.48,Default,,0000,0000,0000,,!لم أسمح لأحد بلمس الجثة بالطبع سيّدي المفتش
Dialogue: 0,0:07:45.51,0:07:47.52,Default,,0000,0000,0000,,أرأى أحدكم المجرم إذاً؟
Dialogue: 0,0:07:48.05,0:07:52.97,Default,,0000,0000,0000,,كلا، سألتُ الجميع لكن لا أحد
Dialogue: 0,0:07:52.97,0:07:55.98,Default,,0000,0000,0000,,!لعلّ كاميرات المراقبة التقطت شيئاً
Dialogue: 0,0:08:01.08,0:08:03.03,Default,,0000,0000,0000,,حسناً، ها هي
Dialogue: 0,0:08:03.50,0:08:06.98,Default,,0000,0000,0000,,يا للمجرم الأحمق، يتم تصويره دون أن يدري
Dialogue: 0,0:08:07.65,0:08:09.53,Default,,0000,0000,0000,,!إنّه المالك
Dialogue: 0,0:08:09.53,0:08:11.78,Default,,0000,0000,0000,,!فلتخرج أيّها القاتل
Dialogue: 0,0:08:13.20,0:08:16.35,Default,,0000,0000,0000,,...دعنا نرى وجهك جيّداً
Dialogue: 0,0:08:42.42,0:08:43.71,Default,,0000,0000,0000,,...تمهل
Dialogue: 0,0:08:43.71,0:08:45.34,Default,,0000,0000,0000,,رأيتُ هذا المشهد من قبل
Dialogue: 0,0:08:50.32,0:08:51.90,Default,,0000,0000,0000,,!كتلك اللوحة تماماً
Dialogue: 0,0:08:52.24,0:08:53.36,Default,,0000,0000,0000,,تلك اللوحة؟
Dialogue: 0,0:08:53.36,0:08:56.15,Default,,0000,0000,0000,,المعلقة مقابل الضحية
Dialogue: 0,0:08:56.15,0:08:58.65,Default,,0000,0000,0000,,"عنوانها كان "العقوبة السماوية
Dialogue: 0,0:08:58.65,0:09:00.65,Default,,0000,0000,0000,,تعمد المجرم قتله بذاك الشكل
Dialogue: 0,0:09:00.65,0:09:02.77,Default,,0000,0000,0000,,كي يطابق اللوحة بالتأكيد
Dialogue: 0,0:09:02.77,0:09:05.89,Default,,0000,0000,0000,,لكن يا له من قاتل جريء
Dialogue: 0,0:09:05.89,0:09:08.89,Default,,0000,0000,0000,,كان أمره سينتهي لو رآه أحد يرتدي ذاك الدرع
Dialogue: 0,0:09:08.89,0:09:14.03,Default,,0000,0000,0000,,صحيح، كانت هناك لافتة منع دخول\Nأمام تلك الغرفة
Dialogue: 0,0:09:14.47,0:09:15.18,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:15.18,0:09:17.40,Default,,0000,0000,0000,,ران، كان ذلك عند قرابة الرابعة، صحيح؟
Dialogue: 0,0:09:18.67,0:09:21.86,Default,,0000,0000,0000,,لكن عندما ذهبنا هناك بعد الخامسة\Nكانت قد اختفت
Dialogue: 0,0:09:24.50,0:09:26.99,Default,,0000,0000,0000,,وقعت الجريمة قرابة الرابعة والنصف
Dialogue: 0,0:09:26.99,0:09:30.52,Default,,0000,0000,0000,,يبدو أنّ المجرم هو من وضع تلك اللافتة
Dialogue: 0,0:09:30.91,0:09:33.41,Default,,0000,0000,0000,,،بعد فعل ذلك لإبعاد الناس
Dialogue: 0,0:09:33.41,0:09:35.73,Default,,0000,0000,0000,,ارتدى المجرم الدرع واختبأ في تلك الغرفة
Dialogue: 0,0:09:35.73,0:09:39.44,Default,,0000,0000,0000,,ثمّ قتل ماناكا
Dialogue: 0,0:09:39.69,0:09:44.15,Default,,0000,0000,0000,,مما يعني أنّ القاتل شخص مُلم بالمتحف
Dialogue: 0,0:09:44.15,0:09:45.39,Default,,0000,0000,0000,,...أي
Dialogue: 0,0:09:46.01,0:09:49.86,Default,,0000,0000,0000,,القاتل أحدكم
Dialogue: 0,0:09:50.43,0:09:53.57,Default,,0000,0000,0000,,!انظروا! المالك يفعل شيئاً
Dialogue: 0,0:09:54.01,0:09:57.21,Default,,0000,0000,0000,,!أ-أنت! لا تعبث بالتصوير بلا إذن
Dialogue: 0,0:09:57.21,0:10:02.03,Default,,0000,0000,0000,,!انظروا، إنّه يقوم بشيء قبل انقضاض القاتل عليه
Dialogue: 0,0:10:03.00,0:10:05.28,Default,,0000,0000,0000,,!صحيح، أدرك شيئاً وأخذ تلك البطاقة
Dialogue: 0,0:10:05.74,0:10:07.73,Default,,0000,0000,0000,,!ثم القلم فوق الطاولة
Dialogue: 0,0:10:09.66,0:10:10.90,Default,,0000,0000,0000,,!إنّه يكتب شيئاً
Dialogue: 0,0:10:11.66,0:10:12.83,Default,,0000,0000,0000,,!رمى القلم
Dialogue: 0,0:10:12.83,0:10:13.64,Default,,0000,0000,0000,,ماذا عن البطاقة؟
Dialogue: 0,0:10:13.64,0:10:14.74,Default,,0000,0000,0000,,!مطوية في يديه
Dialogue: 0,0:10:21.65,0:10:23.23,Default,,0000,0000,0000,,...أيمكن أنّ تلك البطاقة
Dialogue: 0,0:10:23.23,0:10:24.95,Default,,0000,0000,0000,,لا تزال في يده؟
Dialogue: 0,0:10:28.82,0:10:30.32,Default,,0000,0000,0000,,وجدتُ هذه الورقة بيد الضحية
Dialogue: 0,0:10:32.76,0:10:33.78,Default,,0000,0000,0000,,!ما هذا؟
Dialogue: 0,0:10:34.14,0:10:35.73,Default,,0000,0000,0000,,!كـ-كوبوتا
Dialogue: 0,0:10:35.73,0:10:38.19,Default,,0000,0000,0000,,!لـ-لمَ اسمي مكتوب؟
Dialogue: 0,0:10:38.55,0:10:42.63,Default,,0000,0000,0000,,ارتديت الدرع لإخفاء هويتك\Nعلى كاميرات المراقبة
Dialogue: 0,0:10:42.63,0:10:45.64,Default,,0000,0000,0000,,لكن يبدو أنّ الضحية لم يكن سهل الخداع
Dialogue: 0,0:10:46.12,0:10:48.36,Default,,0000,0000,0000,,!كـ-كلا! لم يكن أنا
Dialogue: 0,0:10:48.95,0:10:53.32,Default,,0000,0000,0000,,أخبرنا بحجّة غيابك إذاً، أين كنت عند الرابعة والنصف؟
Dialogue: 0,0:10:53.87,0:10:59.11,Default,,0000,0000,0000,,كـ-كنتُ بمفردي في المكتب أنجز\Nالعمل الذي كلفني به المدير
Dialogue: 0,0:10:59.11,0:11:01.48,Default,,0000,0000,0000,,أجل، طلبتُ منه إنجاز عمل
Dialogue: 0,0:11:02.32,0:11:05.94,Default,,0000,0000,0000,,هذا يعني لم يرك أحد إذاً؟
Dialogue: 0,0:11:06.52,0:11:10.27,Default,,0000,0000,0000,,!ا-انتظر رجاءً! ما دافعي لقتل المالك؟
Dialogue: 0,0:11:10.68,0:11:13.02,Default,,0000,0000,0000,,لا جدوى من التحايل يا كوبوتا-سان
Dialogue: 0,0:11:13.02,0:11:15.92,Default,,0000,0000,0000,,هدّد المالك بمقاضاتك للأضرار
Dialogue: 0,0:11:15.92,0:11:19.76,Default,,0000,0000,0000,,!لأنّك كنت تبيع معروضات هذا المتحف سرّاً
Dialogue: 0,0:11:19.76,0:11:20.69,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:11:21.17,0:11:22.67,Default,,0000,0000,0000,,أهي الحقيقة؟
Dialogue: 0,0:11:22.67,0:11:26.16,Default,,0000,0000,0000,,!لـ-لكن... لا علاقة للأمر
Dialogue: 0,0:11:26.16,0:11:27.60,Default,,0000,0000,0000,,!لم أكن من قتله
Dialogue: 0,0:11:27.91,0:11:28.87,Default,,0000,0000,0000,,لا يهم
Dialogue: 0,0:11:28.87,0:11:35.11,Default,,0000,0000,0000,,سنكتشف الحقيقة حال عثور أتباعي على الدرع
Dialogue: 0,0:11:37.86,0:11:41.32,Default,,0000,0000,0000,,!مفتّش ميغوري! يوجد قلم برأس مدبب هنا
Dialogue: 0,0:11:41.32,0:11:42.69,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:43.49,0:11:45.24,Default,,0000,0000,0000,,أحسنتَ يا فتى
Dialogue: 0,0:11:47.39,0:11:51.11,Default,,0000,0000,0000,,يا له من قلم جميل
Dialogue: 0,0:11:51.60,0:11:53.60,Default,,0000,0000,0000,,صُنع القلم هذا العام للاحتفال
Dialogue: 0,0:11:53.60,0:11:56.97,Default,,0000,0000,0000,,احتفالاً بالذكرى السنوية الخمسين لمعرض بيكا للفنون
Dialogue: 0,0:11:56.97,0:11:59.52,Default,,0000,0000,0000,,يحمله جميع العاملون هنا
Dialogue: 0,0:11:59.52,0:12:02.84,Default,,0000,0000,0000,,نساه أحد هنا إذاً؟
Dialogue: 0,0:12:11.91,0:12:13.96,Default,,0000,0000,0000,,اللون والعرض متطابقان
Dialogue: 0,0:12:13.96,0:12:16.31,Default,,0000,0000,0000,,إنّه القلم الذي استعمله الضحية على الأرجح
Dialogue: 0,0:12:16.61,0:12:18.20,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:12:18.20,0:12:22.23,Default,,0000,0000,0000,,يُفترض أن كوبوتا-سان يعرف أمر كاميرات المراقبة
Dialogue: 0,0:12:22.40,0:12:24.40,Default,,0000,0000,0000,,فلمَ اختار هذه الغرفة إن كان يتوجب عليه
Dialogue: 0,0:12:24.40,0:12:28.15,Default,,0000,0000,0000,,ارتداء درع لإخفاء هويته؟
Dialogue: 0,0:12:28.77,0:12:31.48,Default,,0000,0000,0000,,لجعل الجريمة مطابقة لتلك اللوحة؟
Dialogue: 0,0:12:31.48,0:12:35.40,Default,,0000,0000,0000,,كلا، لا يبدو مهتماً كثيراً بالفنون
Dialogue: 0,0:12:36.63,0:12:40.18,Default,,0000,0000,0000,,هل يُقدم شخص مثله على شيء كهذا؟
Dialogue: 0,0:12:42.26,0:12:43.68,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:12:43.68,0:12:45.69,Default,,0000,0000,0000,,كأنّه مشهد من فيلم رعب
Dialogue: 0,0:12:47.46,0:12:48.65,Default,,0000,0000,0000,,!يا عمّاه
Dialogue: 0,0:12:49.33,0:12:52.36,Default,,0000,0000,0000,,!أيّها الفتى! لا يمكنك الدخول هكذا
Dialogue: 0,0:12:52.65,0:12:56.31,Default,,0000,0000,0000,,قال المفتش ميغوري أنّه يريد\Nمساعدتكما في شيء آخر
Dialogue: 0,0:12:57.49,0:13:00.45,Default,,0000,0000,0000,,لا بد أنّه اكتشف أننا مهتمان برؤية التصوير
Dialogue: 0,0:13:00.45,0:13:02.44,Default,,0000,0000,0000,,لـ-لنذهب بأيّ حال
Dialogue: 0,0:13:02.78,0:13:03.28,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:14.60,0:13:15.52,Default,,0000,0000,0000,,هذه البداية
Dialogue: 0,0:13:18.34,0:13:20.27,Default,,0000,0000,0000,,ما خطب هذه التعابير؟
Dialogue: 0,0:13:22.39,0:13:24.69,Default,,0000,0000,0000,,!ما الذي صعقه في تلك البطاقة؟
Dialogue: 0,0:13:28.50,0:13:31.29,Default,,0000,0000,0000,,لمَ رمى القلم بعدما أنهى الكتابة؟
Dialogue: 0,0:13:31.29,0:13:34.07,Default,,0000,0000,0000,,كان القاتل ليسمع الصّوت
Dialogue: 0,0:13:35.08,0:13:38.31,Default,,0000,0000,0000,,...لحظة، عندما وجدت القلم
Dialogue: 0,0:13:42.28,0:13:44.24,Default,,0000,0000,0000,,!كان الرأس في الداخل...
Dialogue: 0,0:13:44.99,0:13:46.31,Default,,0000,0000,0000,,!غريب
Dialogue: 0,0:13:46.31,0:13:48.81,Default,,0000,0000,0000,,ليس من الطبيعي أن يعيد شخص
Dialogue: 0,0:13:48.81,0:13:53.51,Default,,0000,0000,0000,,!على وشك الموت رأسَ قلم حبر جافّ
Dialogue: 0,0:13:54.52,0:13:55.76,Default,,0000,0000,0000,,...ربما
Dialogue: 0,0:14:06.81,0:14:09.21,Default,,0000,0000,0000,,اعتنوا بالباقي إذاً
Dialogue: 0,0:14:09.21,0:14:09.92,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:14:12.02,0:14:14.17,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:14:14.17,0:14:15.62,Default,,0000,0000,0000,,أنت
Dialogue: 0,0:14:15.62,0:14:16.77,Default,,0000,0000,0000,,!هناك علامة على الورقة
Dialogue: 0,0:14:17.16,0:14:19.16,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:14:19.16,0:14:20.74,Default,,0000,0000,0000,,اكتشفتُ هذه الحيلة
Dialogue: 0,0:14:20.74,0:14:21.78,Default,,0000,0000,0000,,!أيّها الشقي
Dialogue: 0,0:14:21.78,0:14:23.53,Default,,0000,0000,0000,,!ما الذي تظن أنك تفعله؟
Dialogue: 0,0:14:23.53,0:14:24.69,Default,,0000,0000,0000,,!وجدناه حضرة المفتش
Dialogue: 0,0:14:25.36,0:14:27.15,Default,,0000,0000,0000,,!الدرع في خزانة كوبوتا-سان
Dialogue: 0,0:14:27.15,0:14:28.60,Default,,0000,0000,0000,,!وجدتماه؟
Dialogue: 0,0:14:31.27,0:14:34.03,Default,,0000,0000,0000,,!لا-لا يعقل! لا أعرف شيئاً عن هذا
Dialogue: 0,0:14:34.61,0:14:37.14,Default,,0000,0000,0000,,يدينك دليلان الآن
Dialogue: 0,0:14:37.14,0:14:41.77,Default,,0000,0000,0000,,!هذا الدرع الملطخ بالدماء ورسالة احتضار الضحية
Dialogue: 0,0:14:42.26,0:14:46.63,Default,,0000,0000,0000,,!كلا، لم تكن رسالة احتضار
Dialogue: 0,0:14:46.63,0:14:50.59,Default,,0000,0000,0000,,إنّها حيلة استعملها القاتل لتوجيه\Nاللوم نحو كوبوتا-سان
Dialogue: 0,0:14:52.09,0:14:54.71,Default,,0000,0000,0000,,هجوم دمويّ بحق
Dialogue: 0,0:14:54.71,0:14:57.20,Default,,0000,0000,0000,,من المؤسف أنّ هذه القطعة الفنية أُفسدت
Dialogue: 0,0:14:57.20,0:15:00.33,Default,,0000,0000,0000,,كلا، إنّه تقليد طبق الأصل لتزيين المكان في الواقع
Dialogue: 0,0:15:00.33,0:15:03.66,Default,,0000,0000,0000,,كان نفس الذي نقله كوبوتا-سان ظهيرة اليوم
Dialogue: 0,0:15:03.66,0:15:05.10,Default,,0000,0000,0000,,ذاك؟
Dialogue: 0,0:15:05.44,0:15:09.07,Default,,0000,0000,0000,,هكذا إذاً، كانت نسخة طبق الأصل
Dialogue: 0,0:15:09.07,0:15:11.28,Default,,0000,0000,0000,,لهذا لم يقل المدير شيئاً
Dialogue: 0,0:15:11.28,0:15:14.44,Default,,0000,0000,0000,,.عندما عاملها كوبوتا-سان بقسوة
Dialogue: 0,0:15:14.98,0:15:19.68,Default,,0000,0000,0000,,استُعمِلت النسخة في الجريمة، لذلك\Nلم يُفسد الدرع الحقيقي
Dialogue: 0,0:15:19.68,0:15:22.40,Default,,0000,0000,0000,,يبدو أنّ بقية المعروضات لم تُمس أيضاً
Dialogue: 0,0:15:23.27,0:15:26.35,Default,,0000,0000,0000,,...بالتفكير بالأمر، حائط الجريمة
Dialogue: 0,0:15:29.55,0:15:31.73,Default,,0000,0000,0000,,به بطاقات، لكن لا لوحات
Dialogue: 0,0:15:32.73,0:15:35.91,Default,,0000,0000,0000,,أزالها القاتل مسبقاً
Dialogue: 0,0:15:35.91,0:15:38.69,Default,,0000,0000,0000,,لحمايتها من الهجوم الدموي
Dialogue: 0,0:15:39.54,0:15:42.63,Default,,0000,0000,0000,,كان القاتل أحد عاملي المتحف بالفعل إذاً
Dialogue: 0,0:15:44.08,0:15:45.82,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:15:45.82,0:15:51.15,Default,,0000,0000,0000,,هذه حيلة لا تعمل دون إلغاء\Nحجّة غياب كوبوتا-سان
Dialogue: 0,0:15:51.15,0:15:53.65,Default,,0000,0000,0000,,...مما يعني أنّ الفاعل
Dialogue: 0,0:15:55.39,0:15:56.79,Default,,0000,0000,0000,,!المدير بالتأكيد
Dialogue: 0,0:15:58.35,0:16:00.68,Default,,0000,0000,0000,,إن أصاب استنتاجي
Dialogue: 0,0:16:00.68,0:16:03.99,Default,,0000,0000,0000,,فمن المحتمل أنّ القاتل لا يزال يحمله
Dialogue: 0,0:16:04.27,0:16:05.88,Default,,0000,0000,0000,,إذاً يا كوبوتا-سان
Dialogue: 0,0:16:05.88,0:16:07.97,Default,,0000,0000,0000,,لترافقنا للمركز حالياً
Dialogue: 0,0:16:07.97,0:16:09.44,Default,,0000,0000,0000,,!لـ-لكن
Dialogue: 0,0:16:15.04,0:16:16.48,Default,,0000,0000,0000,,!عليّ الذهاب بشدّة
Dialogue: 0,0:16:18.40,0:16:20.82,Default,,0000,0000,0000,,!الحمّام! الحمّام
Dialogue: 0,0:16:21.50,0:16:23.16,Default,,0000,0000,0000,,!أيّها العم! أين الحمّام؟
Dialogue: 0,0:16:23.16,0:16:27.86,Default,,0000,0000,0000,,الحمّام؟ اخرج من هذه الغرفة ثم انزل\Nمن الدرج على يمينك
Dialogue: 0,0:16:27.86,0:16:28.77,Default,,0000,0000,0000,,...وبعدها
Dialogue: 0,0:16:28.77,0:16:31.03,Default,,0000,0000,0000,,!هذا معقّد كثير عليّ
Dialogue: 0,0:16:31.03,0:16:32.48,Default,,0000,0000,0000,,!ارسم على هذه
Dialogue: 0,0:16:34.53,0:16:36.64,Default,,0000,0000,0000,,!بسرعة! بسرعة
Dialogue: 0,0:16:36.64,0:16:39.11,Default,,0000,0000,0000,,...أخبرتك، اخرج من هذه الغرفة
Dialogue: 0,0:16:46.80,0:16:48.51,Default,,0000,0000,0000,,ما الخطب يا عمّ؟
Dialogue: 0,0:16:48.51,0:16:49.65,Default,,0000,0000,0000,,لمَ لا تكتب؟
Dialogue: 0,0:16:50.01,0:16:54.86,Default,,0000,0000,0000,,!فهمت! عرفت أنّ ذاك القلم لا يعمل قبل كتابة شيء
Dialogue: 0,0:16:55.50,0:16:59.83,Default,,0000,0000,0000,,لكن هذا غريب، لمَ تحمل قلمَ \Nحبرٍ جافّ تعرف أنّه لا يكتب؟
Dialogue: 0,0:17:01.54,0:17:03.21,Default,,0000,0000,0000,,قلم حبر جافّ لا يكتب؟
Dialogue: 0,0:17:03.21,0:17:04.92,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:17:04.92,0:17:08.99,Default,,0000,0000,0000,,إن كان المالك ماناكا يستعمل\Nقلماً لا يكتب أيضاً
Dialogue: 0,0:17:08.99,0:17:10.73,Default,,0000,0000,0000,,...فرسالة الاحتضار هذه يفترض أن تكون
Dialogue: 0,0:17:12.32,0:17:14.24,Default,,0000,0000,0000,,!فارغة
Dialogue: 0,0:17:15.94,0:17:18.35,Default,,0000,0000,0000,,!انظر! توجد علامة باقية غريبة
Dialogue: 0,0:17:19.73,0:17:23.69,Default,,0000,0000,0000,,كأن أحدهم خربش فوق الحروف\Nبقلم لا يكتب
Dialogue: 0,0:17:26.01,0:17:27.68,Default,,0000,0000,0000,,ماذا لو كانت علامات تُركت
Dialogue: 0,0:17:27.68,0:17:30.22,Default,,0000,0000,0000,,،لأن أحداً حاول مسح الأحرف خلفها
Dialogue: 0,0:17:30.22,0:17:32.07,Default,,0000,0000,0000,,لكن لم يعمل القلم؟
Dialogue: 0,0:17:32.89,0:17:35.52,Default,,0000,0000,0000,,!مـ-من هذا الصبيّ؟
Dialogue: 0,0:17:35.52,0:17:39.56,Default,,0000,0000,0000,,!هكذا إذاً! لم يكن المالك ماناكا من كتب هذه
Dialogue: 0,0:17:39.56,0:17:43.11,Default,,0000,0000,0000,,!بل جهزها القاتل بنفسه سلفاً
Dialogue: 0,0:17:44.46,0:17:47.56,Default,,0000,0000,0000,,لكن لمَ أخذ المالك البطاقة من الأساس؟
Dialogue: 0,0:17:49.49,0:17:50.99,Default,,0000,0000,0000,,ذلك بسيط
Dialogue: 0,0:17:50.99,0:17:53.07,Default,,0000,0000,0000,,:أخبر القاتل المالك بالتالي
Dialogue: 0,0:17:53.07,0:17:57.98,Default,,0000,0000,0000,,"!انظر للبطاقة خلفك! اسم قاتلك عليها"
Dialogue: 0,0:17:57.98,0:18:02.94,Default,,0000,0000,0000,,!لكن كان اسم كوبوتا على البطاقة، وليس القاتل
Dialogue: 0,0:18:03.40,0:18:10.76,Default,,0000,0000,0000,,حاول المالك المصدوم مسح الاسم\Nواستبداله باسم الفاعل الحقيقي
Dialogue: 0,0:18:10.76,0:18:12.36,Default,,0000,0000,0000,,باستعمال قلم الحبر الجافّ على الطاولة
Dialogue: 0,0:18:12.76,0:18:14.47,Default,,0000,0000,0000,,لكنه لم ينجح
Dialogue: 0,0:18:14.47,0:18:17.50,Default,,0000,0000,0000,,فذاك القلم وُضع هناك سلفاً من قِبل القاتل
Dialogue: 0,0:18:17.50,0:18:19.52,Default,,0000,0000,0000,,!ولا يكتب
Dialogue: 0,0:18:19.52,0:18:25.52,Default,,0000,0000,0000,,!لذا رمى القلم وحاول سحق الورقة؟
Dialogue: 0,0:18:26.16,0:18:29.83,Default,,0000,0000,0000,,أي أنها كانت حيلة لخداعنا من تدبير القاتل
Dialogue: 0,0:18:29.83,0:18:35.52,Default,,0000,0000,0000,,!باستعمال قلم بلا حبر وتصوير بلا صوت
Dialogue: 0,0:18:39.27,0:18:42.78,Default,,0000,0000,0000,,لكن القلم الذي وجدناه يكتب بلا مشاكل
Dialogue: 0,0:18:43.27,0:18:47.48,Default,,0000,0000,0000,,ألم يكن رأس القلم مسحوباً للداخل عندما وجدناه؟
Dialogue: 0,0:18:48.01,0:18:50.01,Default,,0000,0000,0000,,...صحيح، معك حق
Dialogue: 0,0:18:50.01,0:18:53.51,Default,,0000,0000,0000,,غريب، لمَ قد يرجع شخص على وشك الموت
Dialogue: 0,0:18:53.51,0:18:55.94,Default,,0000,0000,0000,,رأس قلم حبر جافّ للداخل؟
Dialogue: 0,0:18:56.25,0:19:00.55,Default,,0000,0000,0000,,بدّل القاتل هذا القلم بالآخر بعد الجريمة إذاً
Dialogue: 0,0:19:00.55,0:19:04.24,Default,,0000,0000,0000,,لكن نسي إخراج الرأس إهمالاً؟
Dialogue: 0,0:19:04.63,0:19:09.37,Default,,0000,0000,0000,,مما يعني أن من بحوزته قلم لا يكتب حالياً
Dialogue: 0,0:19:09.37,0:19:10.73,Default,,0000,0000,0000,,!هو الفاعل
Dialogue: 0,0:19:11.49,0:19:12.99,Default,,0000,0000,0000,,...أي
Dialogue: 0,0:19:12.99,0:19:17.15,Default,,0000,0000,0000,,!أنت أيّها المدير أوتشياي
Dialogue: 0,0:19:18.07,0:19:20.36,Default,,0000,0000,0000,,هلّا أسمعتنا حجّة غيابك؟
Dialogue: 0,0:19:20.36,0:19:23.11,Default,,0000,0000,0000,,أين كنت في الرابعة والنصف أثناء وقوع الجريمة؟
Dialogue: 0,0:19:24.97,0:19:27.02,Default,,0000,0000,0000,,حـ-حضرة المدير؟
Dialogue: 0,0:19:27.52,0:19:33.35,Default,,0000,0000,0000,,كنتُ أنتظر لقاء أحدهم عند الرابعة والنصف
Dialogue: 0,0:19:33.35,0:19:37.02,Default,,0000,0000,0000,,أنتظر ذاك الشيطان مظلم القلب
Dialogue: 0,0:19:37.38,0:19:39.27,Default,,0000,0000,0000,,داخل ذاك الدرع...
Dialogue: 0,0:19:40.55,0:19:44.65,Default,,0000,0000,0000,,ما حدث تالياً كان كما وصفت أيّها المتحري
Dialogue: 0,0:19:46.00,0:19:49.56,Default,,0000,0000,0000,,من الجيد أنّ الكاميرات صورت كلّ شيء
Dialogue: 0,0:19:51.87,0:19:53.57,Default,,0000,0000,0000,,لم تكن صدفة
Dialogue: 0,0:19:54.20,0:19:57.52,Default,,0000,0000,0000,,،وقوف المالك حيث فعل، التوقيت
Dialogue: 0,0:19:57.52,0:20:01.44,Default,,0000,0000,0000,,...موقع البطاقة ومكان القلم
Dialogue: 0,0:20:01.82,0:20:04.15,Default,,0000,0000,0000,,كلها كانت وفق خطتي
Dialogue: 0,0:20:04.15,0:20:06.89,Default,,0000,0000,0000,,فقد تدربت على هذا هنا عدة مرات
Dialogue: 0,0:20:07.93,0:20:09.98,Default,,0000,0000,0000,,الشائعة عن رؤية الحرس
Dialogue: 0,0:20:09.98,0:20:12.36,Default,,0000,0000,0000,,!لدرع يمشي ليلاً كانت حقيقية إذاً؟
Dialogue: 0,0:20:14.52,0:20:17.09,Default,,0000,0000,0000,,شعرتُ أنّها فعلة ساذجة
Dialogue: 0,0:20:17.09,0:20:20.52,Default,,0000,0000,0000,,لكني أقدمت عليها للتخلص من المالك ماناكا
Dialogue: 0,0:20:21.34,0:20:25.21,Default,,0000,0000,0000,,الشيطان الذي كان سيغلق هذا المتحف المقدّس
Dialogue: 0,0:20:25.21,0:20:30.48,Default,,0000,0000,0000,,ويأخذ مني هذه المعروضات التي بمثابة أطفالي
Dialogue: 0,0:20:31.04,0:20:34.44,Default,,0000,0000,0000,,وهناك كوبوتا-كن الذي باع مجموعةً من معروضاتي
Dialogue: 0,0:20:35.15,0:20:37.40,Default,,0000,0000,0000,,أردتُ معاقبتك أيضاً
Dialogue: 0,0:20:38.15,0:20:40.57,Default,,0000,0000,0000,,يبدو أنّ الأمر مختلف عن اللوحة يا مدير أوتشياي
Dialogue: 0,0:20:40.57,0:20:43.36,Default,,0000,0000,0000,,أُنزلت عليك عقوبة سماوية أيضاً
Dialogue: 0,0:20:43.86,0:20:46.81,Default,,0000,0000,0000,,كلا، كما في اللوحة تماماً
Dialogue: 0,0:20:47.27,0:20:51.39,Default,,0000,0000,0000,,،رغم أنّ فارس العدالة قتل الشيطان
Dialogue: 0,0:20:51.39,0:20:54.19,Default,,0000,0000,0000,,غطّته دماؤه الشريرة أيضاً
Dialogue: 0,0:20:54.19,0:20:58.27,Default,,0000,0000,0000,,مما أغرقه في الشرّ وأفسده
Dialogue: 0,0:21:00.05,0:21:03.34,Default,,0000,0000,0000,,مهما نظرت للأمر، أنا قاتل
Dialogue: 0,0:21:03.34,0:21:06.67,Default,,0000,0000,0000,,أصبحت شيطاناً بدوري
Dialogue: 0,0:21:06.67,0:21:09.67,Default,,0000,0000,0000,,عجزي عن خداع فارس العدالة الصغير
Dialogue: 0,0:21:09.67,0:21:11.23,Default,,0000,0000,0000,,!هو برهان على ذلك
Dialogue: 0,0:21:11.92,0:21:13.61,Default,,0000,0000,0000,,فارس العدالة الصغير؟
Dialogue: 0,0:21:14.67,0:21:17.31,Default,,0000,0000,0000,,لم تعد بحاجة للذهاب للحمام يا فتى؟
Dialogue: 0,0:23:10.00,0:23:12.96,Default,,0000,0000,0000,,ماذا؟ لن يُغلق متحف الفنون ذاك؟
Dialogue: 0,0:23:13.59,0:23:16.99,Default,,0000,0000,0000,,كلا، تكاتف المواطنون بعدما سمعوا بالحادثة
Dialogue: 0,0:23:16.99,0:23:21.52,Default,,0000,0000,0000,,هذا رائع، فلا نملك الكثير من المراكز الثقافية هنا
Dialogue: 0,0:23:21.52,0:23:24.33,Default,,0000,0000,0000,,لكني سئمت
Dialogue: 0,0:23:24.33,0:23:27.15,Default,,0000,0000,0000,,سئمت مماذا يا غينتا-كن؟
Dialogue: 0,0:23:27.15,0:23:29.98,Default,,0000,0000,0000,,!إنّهما العمّ موري وكونان دوماً
Dialogue: 0,0:23:30.36,0:23:33.15,Default,,0000,0000,0000,,!لا دور لنا أبداً
Dialogue: 0,0:23:33.15,0:23:34.34,Default,,0000,0000,0000,,...ذ-ذلك
Dialogue: 0,0:23:34.72,0:23:35.60,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:23:35.60,0:23:37.02,Default,,0000,0000,0000,,هل سمعتم بقصة هيكل
Dialogue: 0,0:23:37.02,0:23:39.65,Default,,0000,0000,0000,,غرفة الأحياء العظمي الذي يُبعث للحياة\Nفي منتصف الليل؟
Dialogue: 0,0:23:40.06,0:23:41.85,Default,,0000,0000,0000,,!أجل، سمعت عنها
Dialogue: 0,0:23:41.85,0:23:43.64,Default,,0000,0000,0000,,!رآه أحد المعلمين
Dialogue: 0,0:23:43.64,0:23:44.60,Default,,0000,0000,0000,,...لكن كان القلب لا يزال
Dialogue: 0,0:23:44.88,0:23:48.13,Default,,0000,0000,0000,,!حسنٌ، إنّها قضية تطلب حضور فرقة فتيان التحرّي
Dialogue: 0,0:23:48.13,0:23:51.01,Default,,0000,0000,0000,,!لنتسلل للمدرسة هذه الليلة
Dialogue: 0,0:23:51.01,0:23:52.15,Default,,0000,0000,0000,,!لحظة، رفاق
Dialogue: 0,0:23:52.88,0:23:55.12,Default,,0000,0000,0000,,!كونان! عليك القدوم أيضاً
Dialogue: 0,0:23:55.12,0:23:57.45,Default,,0000,0000,0000,,!ارفقوا بي
Dialogue: 0,0:24:11.53,0:24:13.65,Default,,0000,0000,0000,,!لا شك! إنّه القاتل
Dialogue: 0,0:24:14.11,0:24:16.60,Default,,0000,0000,0000,,لكن ما خطب تلك الابتسامة العريضة؟
Dialogue: 0,0:24:17.31,0:24:21.07,Default,,0000,0000,0000,,أيّ حجة غياب في تلك الكاميرا بالضبط؟
Dialogue: 0,0:24:21.77,0:24:24.35,Default,,0000,0000,0000,,انظر، التقطتُ هذه
Dialogue: 0,0:24:24.35,0:24:25.72,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.72,0:24:27.97,Default,,0000,0000,0000,,جريمة قتل مهرجان تينكايتشي الليليّ
Dialogue: 0,0:24:45.63,0:24:47.67,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.67,0:24:49.91,Default,,0000,0000,0000,,كاميرا قابلة للتخلص
Dialogue: 0,0:24:50.36,0:24:52.36,Default,,0000,0000,0000,,!تحوي قضيّة الحلقة القادمة حيلة صادمة

