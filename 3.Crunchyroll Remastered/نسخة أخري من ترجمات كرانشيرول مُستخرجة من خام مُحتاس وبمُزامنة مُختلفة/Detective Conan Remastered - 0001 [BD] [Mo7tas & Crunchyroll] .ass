Dialogue: 0,0:01:45.56,0:01:48.56,Default,,0000,0000,0000,,هلّا راعيتنا قليلاً يا حضرة المفتش ميغوري؟
Dialogue: 0,0:01:48.56,0:01:52.10,Default,,0000,0000,0000,,إلى متى تنوي احتجاز حفد ضيوفي؟
Dialogue: 0,0:01:52.10,0:01:56.32,Default,,0000,0000,0000,,!لا نملك وقتاً أكثر للخوض في تحقيقكم العقيم
Dialogue: 0,0:01:56.63,0:01:58.72,Default,,0000,0000,0000,,رويدك سيّدي
Dialogue: 0,0:01:58.72,0:02:01.73,Default,,0000,0000,0000,,...كان الضحيّة أحد الضيوف المدعويّن لحفلتك
Dialogue: 0,0:02:01.73,0:02:05.71,Default,,0000,0000,0000,,رئيس مصرف ياتسوبيشي، يامازاكي
Dialogue: 0,0:02:05.71,0:02:07.65,Default,,0000,0000,0000,,تحلّوا ببعض الصبر من فضلكم
Dialogue: 0,0:02:08.00,0:02:10.61,Default,,0000,0000,0000,,أتقصد أنّ الفاعل أحدنا؟
Dialogue: 0,0:02:10.61,0:02:12.10,Default,,0000,0000,0000,,تماماً
Dialogue: 0,0:02:12.41,0:02:14.65,Default,,0000,0000,0000,,كانت الغرفة مغلقةً من الداخل
Dialogue: 0,0:02:15.69,0:02:18.81,Default,,0000,0000,0000,,دخل القاتل من النافذة المجاورة\Nعلى الطابق الثالث
Dialogue: 0,0:02:18.81,0:02:21.01,Default,,0000,0000,0000,,ثمّ غادر بالطريقة نفسها
Dialogue: 0,0:02:21.01,0:02:23.01,Default,,0000,0000,0000,,لم تكن هناك آثار أقدام أسفل النافذة
Dialogue: 0,0:02:23.01,0:02:26.61,Default,,0000,0000,0000,,مما يعني أنّها كانت جريمة داخلية
Dialogue: 0,0:02:26.61,0:02:30.22,Default,,0000,0000,0000,,!هراء! المسافة 10 أمتار للنافذة المجاورة
Dialogue: 0,0:02:30.22,0:02:31.77,Default,,0000,0000,0000,,!القفز بينهما مستحيل
Dialogue: 0,0:02:32.29,0:02:35.50,Default,,0000,0000,0000,,إن استعمل القاتل حافّة السطح\Nللانتقال للنافذة التالية
Dialogue: 0,0:02:35.50,0:02:37.96,Default,,0000,0000,0000,,فسيبقى أقلّ من مترين لشرفة الغرفة
Dialogue: 0,0:02:37.96,0:02:39.99,Default,,0000,0000,0000,,التي كان فيها يامازاكي-سان
Dialogue: 0,0:02:40.79,0:02:43.07,Default,,0000,0000,0000,,منطق طفوليّ
Dialogue: 0,0:02:43.07,0:02:44.49,Default,,0000,0000,0000,,كيف غادر القاتل إذاً؟
Dialogue: 0,0:02:44.49,0:02:47.78,Default,,0000,0000,0000,,من المستحيل أن يكون قد قفز مترين\Nإلى حافّة السقف
Dialogue: 0,0:02:47.78,0:02:49.69,Default,,0000,0000,0000,,!التي تبرز لـ10 سنتيمترات فقط
Dialogue: 0,0:02:50.78,0:02:55.12,Default,,0000,0000,0000,,أحضر القاتل حبلاً عند مغادرته الغرفة المجاورة
Dialogue: 0,0:02:55.98,0:02:59.61,Default,,0000,0000,0000,,وربطه بالشرفة ثمّ استعمله للعودة فيما بعد
Dialogue: 0,0:02:59.61,0:03:04.34,Default,,0000,0000,0000,,لكن كيف أزال الحبل من الشرفة لاحقاً؟
Dialogue: 0,0:03:04.34,0:03:06.27,Default,,0000,0000,0000,,الأمر بسيط حضرة المفتّش ميغوري
Dialogue: 0,0:03:07.26,0:03:10.64,Default,,0000,0000,0000,,رُبطت عصا بطرف الحبل ثم ثُبتّت بالشرفة
Dialogue: 0,0:03:10.64,0:03:12.73,Default,,0000,0000,0000,,فخرجت بسهولة عند سحبها
Dialogue: 0,0:03:13.46,0:03:15.83,Default,,0000,0000,0000,,تفقّدوا الشرفة
Dialogue: 0,0:03:15.83,0:03:18.57,Default,,0000,0000,0000,,!يُفترض أن تجدوا علامات ربط الحبل بها
Dialogue: 0,0:03:18.57,0:03:22.52,Default,,0000,0000,0000,,لكن ماذا كان يفعل الرئيس يامازاكي\Nداخل غرفة مغلقة؟
Dialogue: 0,0:03:23.03,0:03:26.62,Default,,0000,0000,0000,,أخبره القاتل على الأرجح بأن ينتظر\Nهناك والباب مقفل
Dialogue: 0,0:03:26.62,0:03:30.65,Default,,0000,0000,0000,,لأن لديه موضوعاً مهماً وسرّاً يريد إخباره به
Dialogue: 0,0:03:31.02,0:03:32.69,Default,,0000,0000,0000,,!سئمت من كلامكم
Dialogue: 0,0:03:32.69,0:03:35.77,Default,,0000,0000,0000,,!من الذي دخل وقتل صديقي العزيز يامازاكي؟
Dialogue: 0,0:03:36.13,0:03:38.36,Default,,0000,0000,0000,,هناك شخص واحد فقط مُلم بتفاصيل البيت
Dialogue: 0,0:03:38.36,0:03:43.98,Default,,0000,0000,0000,,ويمكنه المشي فيه دون إثارة شكوك
Dialogue: 0,0:03:44.72,0:03:45.67,Default,,0000,0000,0000,,...وهو
Dialogue: 0,0:03:48.18,0:03:49.28,Default,,0000,0000,0000,,وهو؟
Dialogue: 0,0:03:54.71,0:03:56.63,Default,,0000,0000,0000,,!أنت أيّها السيّد
Dialogue: 0,0:03:59.79,0:04:03.48,Default,,0000,0000,0000,,!تـ-تمزح حتماً! لم تُشفَ ساقي بعد حتّى
Dialogue: 0,0:04:03.95,0:04:05.83,Default,,0000,0000,0000,,!الحقيقة واحدة دوماً
Dialogue: 0,0:04:07.82,0:04:09.74,Default,,0000,0000,0000,,!سـ-سيّدي! ساقك
Dialogue: 0,0:04:09.74,0:04:11.02,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:04:11.61,0:04:15.02,Default,,0000,0000,0000,,شُفيت ساقك قبل 3 أشهر
Dialogue: 0,0:04:15.02,0:04:16.82,Default,,0000,0000,0000,,صحيح حضرة المفتّش؟
Dialogue: 0,0:04:16.82,0:04:18.15,Default,,0000,0000,0000,,استسلم
Dialogue: 0,0:04:18.15,0:04:19.99,Default,,0000,0000,0000,,أخبرنا طبيبك عن كلّ شيء
Dialogue: 0,0:04:20.89,0:04:23.14,Default,,0000,0000,0000,,كما تحقّقنا من أنّ بينك وصديقك العزيز يامازاكي
Dialogue: 0,0:04:23.14,0:04:26.15,Default,,0000,0000,0000,,تعاملات ماليّة غير شرعية
Dialogue: 0,0:04:27.14,0:04:27.90,Default,,0000,0000,0000,,!لن تهرب
Dialogue: 0,0:04:30.92,0:04:32.13,Default,,0000,0000,0000,,!هدف
Dialogue: 0,0:04:36.07,0:04:40.55,Default,,0000,0000,0000,,!أعنتنا مُجدّداً يا كودو-كن
Dialogue: 0,0:04:40.55,0:04:42.23,Default,,0000,0000,0000,,أنا مُمتن لك
Dialogue: 0,0:04:43.16,0:04:44.74,Default,,0000,0000,0000,,لا مشكلة
Dialogue: 0,0:04:44.74,0:04:46.62,Default,,0000,0000,0000,,إن واجهتك أيّ قضايا صعبة أخرى
Dialogue: 0,0:04:46.62,0:04:49.69,Default,,0000,0000,0000,,!فلا تتردد في طلبي، المتحرّي كودو شينتشي
Dialogue: 0,0:04:50.74,0:04:56.81,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل الأفعوانية
Dialogue: 0,0:04:51.65,0:04:54.65,Default,,0000,0000,0000,,جريمة قتل الأفعوانية
Dialogue: 0,0:05:07.27,0:05:07.86,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:05:11.13,0:05:13.43,Default,,0000,0000,0000,,هلّا رفقت بي يا بروفسور آغاسي؟
Dialogue: 0,0:05:13.77,0:05:16.76,Default,,0000,0000,0000,,!خطر لي أن أوقظك
Dialogue: 0,0:05:16.76,0:05:19.61,Default,,0000,0000,0000,,مفعول هذا أفضل من ساعة التنبيه، صحيح؟
Dialogue: 0,0:05:22.41,0:05:25.41,Default,,0000,0000,0000,,!عدد الكتب لديك لا ينفك يذهلني
Dialogue: 0,0:05:25.41,0:05:31.02,Default,,0000,0000,0000,,نجح والدك في أن يصبح مؤلف روايات غموض عالميّ\N بسبب هذه المجموعة
Dialogue: 0,0:05:31.36,0:05:33.19,Default,,0000,0000,0000,,كفَّ عن التحرّك يا بروفسور
Dialogue: 0,0:05:33.19,0:05:34.69,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:05:34.69,0:05:36.48,Default,,0000,0000,0000,,ما كانت تجربتك هذه المرّة؟
Dialogue: 0,0:05:36.48,0:05:40.93,Default,,0000,0000,0000,,!اسمع، لا تخبر أحداً بهذا! إنّه سرّ بيننا فقط
Dialogue: 0,0:05:41.60,0:05:44.14,Default,,0000,0000,0000,,!إنّه صاروخ تنقّل شخصيّ
Dialogue: 0,0:05:44.14,0:05:46.93,Default,,0000,0000,0000,,بعدما أكمله سيصبح الازدحام المروري\Nحكايةً من الماضي
Dialogue: 0,0:05:46.93,0:05:49.60,Default,,0000,0000,0000,,!وسأصبح فاحش الثراء
Dialogue: 0,0:05:55.55,0:05:56.54,Default,,0000,0000,0000,,ما هذه؟
Dialogue: 0,0:05:56.54,0:05:57.32,Default,,0000,0000,0000,,...كتُب
Dialogue: 0,0:06:01.04,0:06:02.35,Default,,0000,0000,0000,,لا فائدة
Dialogue: 0,0:06:04.31,0:06:09.08,Default,,0000,0000,0000,,!تبّاَ! هذا الوغد! هذا الوغد! تبّاً لك
Dialogue: 0,0:06:09.08,0:06:11.36,Default,,0000,0000,0000,,يكفي يا أبي
Dialogue: 0,0:06:11.36,0:06:14.11,Default,,0000,0000,0000,,لا أحصل على أيّ عملاء لأنّ طالباً في الثانويّة
Dialogue: 0,0:06:14.11,0:06:15.48,Default,,0000,0000,0000,,!يهوى لعب دور المتحرّي
Dialogue: 0,0:06:15.74,0:06:18.94,Default,,0000,0000,0000,,ليس باليد حيلة، شينتشي بارع في عمله
Dialogue: 0,0:06:19.36,0:06:21.44,Default,,0000,0000,0000,,!قوت يومي يعتمد على هذا
Dialogue: 0,0:06:22.73,0:06:24.14,Default,,0000,0000,0000,,أنا خارجة
Dialogue: 0,0:06:24.14,0:06:25.60,Default,,0000,0000,0000,,!اذهبي أينما تريدين
Dialogue: 0,0:06:26.60,0:06:28.48,Default,,0000,0000,0000,,المتحرّي الشهير كودو شينتشي
Dialogue: 0,0:06:28.48,0:06:30.35,Default,,0000,0000,0000,,شارلوك هولمز يابان العصر الحديث
Dialogue: 0,0:06:30.35,0:06:34.06,Default,,0000,0000,0000,,!ويراه الكثيرون المُنقذ للشرطة اليابانية
Dialogue: 0,0:06:34.06,0:06:36.86,Default,,0000,0000,0000,,!كودو شينتشي رائعٌ جدّاً
Dialogue: 0,0:06:36.86,0:06:39.34,Default,,0000,0000,0000,,!قد أكتب له رسالة حُب
Dialogue: 0,0:06:44.73,0:06:47.52,CharCard,,0000,0000,0000,,{\fad(300,0)}موري ران - طالبة سنة ثانية في ثانويّة تيتان
Dialogue: 0,0:06:44.81,0:06:46.18,On Top,,0000,0000,0000,,تبدو كالأحمق
Dialogue: 0,0:06:46.18,0:06:47.38,On Top,,0000,0000,0000,,تتبتسم يميناً ويساراً
Dialogue: 0,0:06:47.97,0:06:50.02,Default,,0000,0000,0000,,ما الذي يغضبك يا ران؟
Dialogue: 0,0:06:50.02,0:06:51.38,Default,,0000,0000,0000,,لا شيء
Dialogue: 0,0:06:51.38,0:06:57.38,Default,,0000,0000,0000,,لستُ غاضبة لأنّ أبي عاجز عن الحصول\Nعلى أيّ عمل بسببك
Dialogue: 0,0:06:59.01,0:07:03.70,Default,,0000,0000,0000,,قلّة عمل أبيك ليست غلطتي، ليس بارعاً بما يكفي فقط
Dialogue: 0,0:07:06.08,0:07:10.63,Default,,0000,0000,0000,,أخبرتك، لستُ غاضبة أبداً
Dialogue: 0,0:07:12.28,0:07:14.58,Default,,0000,0000,0000,,كما تتوقع من رئيسة نادي الكاراتيه
Dialogue: 0,0:07:27.98,0:07:32.62,Default,,0000,0000,0000,,لو لم تترك نادي كرة القدم، لأصبحتَ بطلاً كبيراً هنا
Dialogue: 0,0:07:33.97,0:07:38.80,Default,,0000,0000,0000,,مارستُ كرة القدم لتطوير البنية التي يحتاجها المتحري فقط
Dialogue: 0,0:07:38.80,0:07:41.33,Default,,0000,0000,0000,,كان يمارس هولمز المبارزة الأولمبية بدوره
Dialogue: 0,0:07:41.87,0:07:43.96,Default,,0000,0000,0000,,لكنها روايات فقط
Dialogue: 0,0:07:43.96,0:07:46.29,Default,,0000,0000,0000,,لكنّه متحرٍّ يعرفه الجميع
Dialogue: 0,0:07:47.08,0:07:48.87,Default,,0000,0000,0000,,إنّه مذهل
Dialogue: 0,0:07:48.87,0:07:51.86,Default,,0000,0000,0000,,هادئ ومتّزن مهما كانت الظروف حوله
Dialogue: 0,0:07:51.86,0:07:54.28,Default,,0000,0000,0000,,!ويشعّ ذكاءً وأناقة
Dialogue: 0,0:07:54.28,0:07:57.53,Default,,0000,0000,0000,,!وحدّة ملاحظته واستنتاجاته الدقيقة منقطعة النظير
Dialogue: 0,0:07:58.36,0:08:00.82,Default,,0000,0000,0000,,!كما مستوى عزفه للكمان لا يقلّ عن المحترفين
Dialogue: 0,0:08:01.89,0:08:08.71,Default,,0000,0000,0000,,،وليد أفكار المؤلف كونان دويل، شارلوك هولمز\N!هو أعظم متحرٍّ في العالم
Dialogue: 0,0:08:09.02,0:08:13.00,Default,,0000,0000,0000,,إن كنت تحبّه لهذا الحد، فلمَ لا تصبح روائيّاً كأبيك؟
Dialogue: 0,0:08:13.59,0:08:17.21,Default,,0000,0000,0000,,!لا أريد الكتابة عن المتحرّيين، بل أن أصبح واحداً
Dialogue: 0,0:08:18.55,0:08:20.66,Default,,0000,0000,0000,,شارلوك هولمز قترة هيسي
Dialogue: 0,0:08:21.50,0:08:25.12,Default,,0000,0000,0000,,!إثارة القبض على الأشرار تفوق الوصف
Dialogue: 0,0:08:26.00,0:08:29.33,Default,,0000,0000,0000,,لا عودة بعدما تسلك طريق المتحرّي
Dialogue: 0,0:08:29.33,0:08:32.45,Default,,0000,0000,0000,,!وانظري لرسائل المعجبين هذه! المتحرّيون ذوو شعبية كبيرة
Dialogue: 0,0:08:32.74,0:08:37.50,Default,,0000,0000,0000,,،لا بأس من لهوك مع الفتيات دوماً\Nلكن اختر واحدة مفضّلة على الأقل
Dialogue: 0,0:08:39.74,0:08:41.21,Default,,0000,0000,0000,,...مفضّلة
Dialogue: 0,0:08:43.90,0:08:46.78,Default,,0000,0000,0000,,ما الذي تحدّق به؟
Dialogue: 0,0:08:47.77,0:08:51.14,Default,,0000,0000,0000,,!لا-لا شيء! لنسرع وإلّا سيفوتنا الدرس
Dialogue: 0,0:08:51.14,0:08:51.74,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:08:53.89,0:08:56.72,Default,,0000,0000,0000,,لم تنسَ وعدك عن الغد، صحيح؟
Dialogue: 0,0:08:56.72,0:08:57.54,Default,,0000,0000,0000,,وعدي؟
Dialogue: 0,0:08:58.01,0:08:59.72,Default,,0000,0000,0000,,!وعدتَني
Dialogue: 0,0:08:59.72,0:09:05.25,Default,,0000,0000,0000,,!إذا فزتُ بمسابقة الكاراتيه فستصطحبني لتروبيكال لاند
Dialogue: 0,0:09:06.83,0:09:07.75,Default,,0000,0000,0000,,!منحرف
Dialogue: 0,0:09:09.04,0:09:11.41,Default,,0000,0000,0000,,...أ-أتذكر
Dialogue: 0,0:09:40.43,0:09:43.38,On Top - Copy,,0000,0000,0000,,{\pos(235.227,293.636)}يوشيدا آيومي
Dialogue: 0,0:09:41.80,0:09:43.38,On Top,,0000,0000,0000,,!كان ذلك مُسليّاً جدّاً
Dialogue: 0,0:09:43.38,0:09:45.55,On Top,,0000,0000,0000,,!كلا، كان ذلك مضرّاً بالقلب
Dialogue: 0,0:09:43.38,0:09:46.84,On Top - Copy,,0000,0000,0000,,{\pos(237.233,297.273)}  تسوبورايا ميتسوهيكو                        كوجيما غينتا               \N
Dialogue: 0,0:09:45.55,0:09:46.84,On Top,,0000,0000,0000,,لنرجع للبيت
Dialogue: 0,0:09:47.18,0:09:50.79,Default,,0000,0000,0000,,أنتَ سريع الخوف بالنسبة لفتى ضخم البنية يا غينتا-كن
Dialogue: 0,0:09:50.79,0:09:53.30,Default,,0000,0000,0000,,لكن لن تواجها مشكلةً مع سكّة الغموض، صحيح؟
Dialogue: 0,0:09:53.67,0:09:57.72,Default,,0000,0000,0000,,نملك مالاً يكفي فقط للعودة بالقطار يا آيومي-تشان
Dialogue: 0,0:09:58.29,0:10:01.67,Default,,0000,0000,0000,,لا بأس! اتركا الأمر لي
Dialogue: 0,0:10:08.62,0:10:12.19,Default,,0000,0000,0000,,!انظر يا شينتشي! هناك شاغر في سكّة الغموض! لنذهب
Dialogue: 0,0:10:15.86,0:10:18.86,Default,,0000,0000,0000,,يحاولان التسلّل بلا مقابل؟
Dialogue: 0,0:10:18.86,0:10:21.50,Default,,0000,0000,0000,,...يا إلهي، صغار هذه الأيام
Dialogue: 0,0:10:25.01,0:10:30.26,Default,,0000,0000,0000,,المذهل في هولمز هو عند لقائه الأوّل بمساعده واتسون
Dialogue: 0,0:10:30.26,0:10:35.71,Default,,0000,0000,0000,,!عرف أنّه ذهب لأفغانستان كطبيب عسكري بمجرّد مصافحته
Dialogue: 0,0:10:36.50,0:10:37.59,Default,,0000,0000,0000,,هكذا
Dialogue: 0,0:10:39.71,0:10:42.16,Default,,0000,0000,0000,,أنتِ في نادي الجمباز، صحيح؟
Dialogue: 0,0:10:42.16,0:10:43.70,Default,,0000,0000,0000,,!كـ-كيف عرفت؟
Dialogue: 0,0:10:43.70,0:10:45.46,Default,,0000,0000,0000,,تعرفينه يا هيتومي؟
Dialogue: 0,0:10:47.87,0:10:50.08,Default,,0000,0000,0000,,كانت البثور على يدها
Dialogue: 0,0:10:50.08,0:10:55.02,Default,,0000,0000,0000,,وحدهن الفتيات اللّواتي يتمرنّ على\Nالقضبان الأفقية يُصبن بهذا العدد
Dialogue: 0,0:10:55.02,0:10:57.68,Default,,0000,0000,0000,,لكن يمكن أن تُصاب بالبثور من التنس أيضاً
Dialogue: 0,0:10:58.23,0:11:04.01,Default,,0000,0000,0000,,رأيتُ عندما رفعت الرياح تنورتها قبل قليل في الواقع
Dialogue: 0,0:11:04.01,0:11:06.01,Default,,0000,0000,0000,,ذوات الخبرة على القضبان الأفقية
Dialogue: 0,0:11:06.01,0:11:08.88,Default,,0000,0000,0000,,وحدهن من يُصبن بعلامات كتلك على أفخاذهن
Dialogue: 0,0:11:08.88,0:11:11.58,Default,,0000,0000,0000,,ليس مُنصفاً إن كنت تعرف منذ البداية
Dialogue: 0,0:11:12.67,0:11:14.26,Default,,0000,0000,0000,,إلى متى ستظل مُمسكاً بيدها؟
Dialogue: 0,0:11:15.71,0:11:16.80,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:11:16.80,0:11:20.05,Default,,0000,0000,0000,,!أنت! كفّ عن مضايقة صديقتي
Dialogue: 0,0:11:20.05,0:11:23.71,Default,,0000,0000,0000,,صديقك؟ في تلك الحالة لمَ لا نتبادل الأماكن؟
Dialogue: 0,0:11:23.85,0:11:25.95,Default,,0000,0000,0000,,كـ-كلا، لا بأس
Dialogue: 0,0:11:25.95,0:11:29.54,Default,,0000,0000,0000,,كما ليس مُهذباً أن نضايق آيكو وكيشيدا-كن
Dialogue: 0,0:11:35.94,0:11:37.03,Default,,0000,0000,0000,,ران
Dialogue: 0,0:11:37.03,0:11:38.94,Default,,0000,0000,0000,,...لطالما كنتُ معجباً بك
Dialogue: 0,0:11:38.94,0:11:40.19,Default,,0000,0000,0000,,شينتشي
Dialogue: 0,0:11:40.19,0:11:41.39,Default,,0000,0000,0000,,أنا أيضاً
Dialogue: 0,0:11:41.39,0:11:42.17,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:11:42.68,0:11:43.85,Default,,0000,0000,0000,,!هيّا! يمكننا الصعود
Dialogue: 0,0:11:44.67,0:11:45.17,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:11:45.72,0:11:47.93,Default,,0000,0000,0000,,ماذا سنفعل الآن؟
Dialogue: 0,0:11:47.93,0:11:50.42,Default,,0000,0000,0000,,ندخل طابور الركوب فقط
Dialogue: 0,0:11:50.42,0:11:52.46,Default,,0000,0000,0000,,أين الطريق للطابور؟
Dialogue: 0,0:11:52.46,0:11:54.13,Default,,0000,0000,0000,,!هذا ما نحاول إيجاده
Dialogue: 0,0:11:55.92,0:11:58.01,Default,,0000,0000,0000,,...عندها قام هولمز
Dialogue: 0,0:11:58.01,0:12:00.66,Default,,0000,0000,0000,,!ابتعدوا! نحن أوّلاً
Dialogue: 0,0:12:02.37,0:12:07.68,Default,,0000,0000,0000,,!رأيتِ إذاً؟ أراد كونان دويل أن يصبح كهولمز حتماً
Dialogue: 0,0:12:08.00,0:12:13.09,Default,,0000,0000,0000,,!يكفي من هولمز ودويل يا مهووس التحرّي
Dialogue: 0,0:12:15.78,0:12:20.24,Default,,0000,0000,0000,,كنتُ متشوّقة للقدوم معك هنا يا شينتشي
Dialogue: 0,0:12:21.02,0:12:23.88,Default,,0000,0000,0000,,لمَ لا تفهم مشاعري تجاهك؟
Dialogue: 0,0:12:25.18,0:12:27.09,Default,,0000,0000,0000,,...ر-ران
Dialogue: 0,0:12:27.56,0:12:29.68,Default,,0000,0000,0000,,...فـ-في الواقع، أنا أيضاً
Dialogue: 0,0:12:29.68,0:12:31.92,Default,,0000,0000,0000,,أحمق! لمَ توترتَ هكذا؟
Dialogue: 0,0:12:31.92,0:12:33.92,Default,,0000,0000,0000,,!كنتُ أمزح بوضوح
Dialogue: 0,0:12:33.92,0:12:37.26,Default,,0000,0000,0000,,!لن تصبح متحرّياً بارعاً لو خُدعت بهذه السهولة
Dialogue: 0,0:12:37.26,0:12:38.05,Default,,0000,0000,0000,,تبّاً
Dialogue: 0,0:12:42.37,0:12:43.36,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:12:44.66,0:12:46.92,Default,,0000,0000,0000,,كنتُ متشوّقة لهذا حقّاً
Dialogue: 0,0:13:05.14,0:13:05.92,Default,,0000,0000,0000,,ماء؟
Dialogue: 0,0:13:11.01,0:13:13.05,Default,,0000,0000,0000,,!ما كان ذلك؟
Dialogue: 0,0:13:13.05,0:13:14.88,Default,,0000,0000,0000,,!لنخرج بسرعة
Dialogue: 0,0:13:18.68,0:13:20.26,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:13:32.82,0:13:34.70,Default,,0000,0000,0000,,!صوت سيّارات شرطة
Dialogue: 0,0:13:34.70,0:13:35.59,Default,,0000,0000,0000,,أنتم
Dialogue: 0,0:13:36.03,0:13:38.45,Default,,0000,0000,0000,,!لم نتسلل بلا مقابل
Dialogue: 0,0:13:39.32,0:13:42.63,Default,,0000,0000,0000,,!ألستَ مُتحري الثانوية ذاك؟
Dialogue: 0,0:13:44.06,0:13:45.76,Default,,0000,0000,0000,,اسمي كودو شينتشي
Dialogue: 0,0:13:52.47,0:13:54.84,Default,,0000,0000,0000,,لمَ كيشيدا-كن؟
Dialogue: 0,0:13:54.84,0:13:55.67,Default,,0000,0000,0000,,...فظيع
Dialogue: 0,0:13:56.18,0:13:58.47,Default,,0000,0000,0000,,!لا وقت لدينا للتسكع هنا بسبب حادثة عاديّة
Dialogue: 0,0:13:58.47,0:13:59.72,Default,,0000,0000,0000,,دعنا نغادر
Dialogue: 0,0:13:59.72,0:14:01.88,Default,,0000,0000,0000,,!كلا! إنّها جريمة قتل
Dialogue: 0,0:14:02.38,0:14:07.67,Default,,0000,0000,0000,,!والقاتل كان أحد السبعة الآخرين على الأفعوانية
Dialogue: 0,0:14:07.67,0:14:09.80,Default,,0000,0000,0000,,!شينتشي! أين ذهبت؟
Dialogue: 0,0:14:10.13,0:14:12.17,Default,,0000,0000,0000,,!أهذه الحقيقة يا كودو-كن؟
Dialogue: 0,0:14:12.57,0:14:13.67,Default,,0000,0000,0000,,!ماذا؟ كودو؟
Dialogue: 0,0:14:16.07,0:14:19.28,Default,,0000,0000,0000,,ذاك المتحرّي الشهير في المدرسة الثانوية\N!كودو شينتشي؟
Dialogue: 0,0:14:19.28,0:14:21.00,Default,,0000,0000,0000,,!إنّه منقذ شرطة اليابان
Dialogue: 0,0:14:22.61,0:14:24.21,Default,,0000,0000,0000,,هو كودو إذاً؟
Dialogue: 0,0:14:24.69,0:14:28.74,Default,,0000,0000,0000,,أي بإزاحتك وران-كن مؤقتاً من الاعتبار
Dialogue: 0,0:14:28.74,0:14:29.93,Default,,0000,0000,0000,,فالركّاب خمسة
Dialogue: 0,0:14:30.80,0:14:35.39,Default,,0000,0000,0000,,الراكبتان أ و ب في الصفّ الأوّل\Nكانتا صديقتين للضحيّة
Dialogue: 0,0:14:35.39,0:14:41.46,Default,,0000,0000,0000,,،بينما كانت ج، صديقة كما حبيبة الضحية\Nفي الصفّ الثالث
Dialogue: 0,0:14:41.46,0:14:45.63,Default,,0000,0000,0000,,بينما د و هـ كانا الرجلين بالرداء الأسود خلف الضحيّة
Dialogue: 0,0:14:46.29,0:14:50.24,Default,,0000,0000,0000,,لكن أقفل الجميع حاجز الحماية خاصتهم
Dialogue: 0,0:14:50.24,0:14:55.09,Default,,0000,0000,0000,,فلم يكن بإمكان أحدهم ارتكاب الجريمة\Nسوى المرأة بجواره
Dialogue: 0,0:14:55.62,0:14:57.45,Default,,0000,0000,0000,,هلّا أسرعتم؟
Dialogue: 0,0:14:57.45,0:15:00.75,Default,,0000,0000,0000,,!لا وقت لدينا للعبة التحرّي
Dialogue: 0,0:15:01.82,0:15:04.51,Default,,0000,0000,0000,,ما خطب نظرات هذا الرجل الثلجية؟
Dialogue: 0,0:15:05.12,0:15:07.72,Default,,0000,0000,0000,,كأنّها أعين شخص قتل العشرات دون تردد
Dialogue: 0,0:15:08.78,0:15:10.80,Default,,0000,0000,0000,,من هو؟
Dialogue: 0,0:15:11.31,0:15:14.06,Default,,0000,0000,0000,,!حضرة المفتش! توجد سكّين في حقيبة هذه المرأة
Dialogue: 0,0:15:14.06,0:15:16.47,Default,,0000,0000,0000,,!مُحال! لم يسبق ورأيتها قبل
Dialogue: 0,0:15:17.27,0:15:21.43,Default,,0000,0000,0000,,...آيكو! ظننتك على وفاق مع كيشيدا-كن
Dialogue: 0,0:15:21.43,0:15:22.27,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:15:22.27,0:15:24.05,Default,,0000,0000,0000,,!كـ-كلا! لم تكن أنا
Dialogue: 0,0:15:24.68,0:15:28.48,Default,,0000,0000,0000,,من الجليّ أن الفتاة هي الفاعلة! سنغادر الآن
Dialogue: 0,0:15:28.48,0:15:31.68,Default,,0000,0000,0000,,!حسنٌ، اعتقلوها كالمشتبه به الرئيسي
Dialogue: 0,0:15:32.09,0:15:34.13,Default,,0000,0000,0000,,!انتظر حضرة المفتّش
Dialogue: 0,0:15:34.13,0:15:35.64,Default,,0000,0000,0000,,ليست القاتلة
Dialogue: 0,0:15:35.96,0:15:38.52,Default,,0000,0000,0000,,ماذا؟! من إذاً؟
Dialogue: 0,0:15:42.12,0:15:44.49,Default,,0000,0000,0000,,الحقيقة واحدة دوماً
Dialogue: 0,0:15:47.12,0:15:48.10,Default,,0000,0000,0000,,...المجرم
Dialogue: 0,0:15:49.45,0:15:50.16,Default,,0000,0000,0000,,!هو أنت
Dialogue: 0,0:16:04.52,0:16:06.68,Default,,0000,0000,0000,,!ما-ما الذي تقوله؟
Dialogue: 0,0:16:06.68,0:16:08.10,Default,,0000,0000,0000,,!كانت السكّين في حقيبة آيكو
Dialogue: 0,0:16:08.64,0:16:12.17,Default,,0000,0000,0000,,يستحيل قطع رأس إنسان بسكّين كتلك
Dialogue: 0,0:16:12.17,0:16:14.06,Default,,0000,0000,0000,,ولا سيّما بالنسبة لفتاة
Dialogue: 0,0:16:14.63,0:16:20.26,Default,,0000,0000,0000,,وضعتِ السكّين في حقيبة آيكو-سان قبلاً\Nلتوجيه اللوم نحوها
Dialogue: 0,0:16:20.75,0:16:24.50,Default,,0000,0000,0000,,!لكنها كانت تجلس في الصفّ الأوّل
Dialogue: 0,0:16:24.50,0:16:26.08,Default,,0000,0000,0000,,!ألن يكون مستحيلاً عليها؟
Dialogue: 0,0:16:26.08,0:16:28.33,Default,,0000,0000,0000,,كلا، ذلك ممكن إن استغلّت سرعة الأفعوانية
Dialogue: 0,0:16:28.33,0:16:30.93,Default,,0000,0000,0000,,مع سلك بيانو أو حبل وما شابه
Dialogue: 0,0:16:33.53,0:16:35.19,Default,,0000,0000,0000,,أأنتم مستعدون؟
Dialogue: 0,0:16:35.19,0:16:38.65,Default,,0000,0000,0000,,أنا القاتل والمفتّش ميغوري هو الضحيّة
Dialogue: 0,0:16:38.65,0:16:40.72,Default,,0000,0000,0000,,،قبل أن أنزل حاجز الأمان أوّلاً
Dialogue: 0,0:16:41.27,0:16:43.68,Default,,0000,0000,0000,,أضع شيئاً شبيهاً بالحقيبة وراء ظهري
Dialogue: 0,0:16:44.77,0:16:46.68,Default,,0000,0000,0000,,ثم أُنزل الحاجز... وهكذا
Dialogue: 0,0:16:47.10,0:16:48.89,Default,,0000,0000,0000,,من السهل الخروج بالمساحة الزائدة
Dialogue: 0,0:16:50.26,0:16:55.72,Default,,0000,0000,0000,,تالياً، أُخرج حبلاً بخطّاف في طرفه مجهّز سلفاً
Dialogue: 0,0:16:56.55,0:17:00.58,Default,,0000,0000,0000,,ثمّ أضع ساقيّ على الحاجز، أمتد، وألفّ الحلقة
Dialogue: 0,0:17:00.58,0:17:01.89,Default,,0000,0000,0000,,حول عنق الضحيّة
Dialogue: 0,0:17:02.50,0:17:04.89,Default,,0000,0000,0000,,كلّ ذلك داخل النفق المظلم بالطبع
Dialogue: 0,0:17:05.96,0:17:07.56,Default,,0000,0000,0000,,ثمّ أربط الخطّاف بالسكّة
Dialogue: 0,0:17:08.16,0:17:12.64,Default,,0000,0000,0000,,بعدها ستقتلع سرعة الأفعوانية وقوّتها الرأس فوراً
Dialogue: 0,0:17:13.57,0:17:18.10,Default,,0000,0000,0000,,فعل كلّ ذلك على متن أفعوانية ممكن\Nبالنسبة للاعبة جمباز مثلك
Dialogue: 0,0:17:18.45,0:17:20.51,Default,,0000,0000,0000,,هذا هراء! أيّ دليل بحوزتك؟
Dialogue: 0,0:17:21.52,0:17:22.97,Default,,0000,0000,0000,,ماذا حلّ بقلادتك؟
Dialogue: 0,0:17:24.14,0:17:27.56,Default,,0000,0000,0000,,قلادة اللآلئ حول عنقك قبل صعودك العربة
Dialogue: 0,0:17:29.44,0:17:30.51,Default,,0000,0000,0000,,أليست هذه هي؟
Dialogue: 0,0:17:36.63,0:17:40.50,Default,,0000,0000,0000,,كانت دموعك دليلاً إضافياً
Dialogue: 0,0:17:40.50,0:17:43.58,Default,,0000,0000,0000,,كنتِ تعرفين أنّ الضحيّة سيلقى حتفه
Dialogue: 0,0:17:43.58,0:17:45.63,Default,,0000,0000,0000,,لذا ذرفتِ دموعاً قبل الإقدام على قتله
Dialogue: 0,0:17:47.08,0:17:50.59,Default,,0000,0000,0000,,.أثر الدموع الأفقي على وجهك
Dialogue: 0,0:17:51.28,0:17:53.10,Default,,0000,0000,0000,,...يمكن أن تتدفق الدموع أفقياً
Dialogue: 0,0:17:53.82,0:17:55.80,Default,,0000,0000,0000,,فقط إن كنتِ تبكين على العربة
Dialogue: 0,0:18:02.48,0:18:04.48,Default,,0000,0000,0000,,!كانت غلطته
Dialogue: 0,0:18:04.48,0:18:05.93,Default,,0000,0000,0000,,!تخلّى عني
Dialogue: 0,0:18:06.65,0:18:09.93,Default,,0000,0000,0000,,أكنتِ تواعدين كيشيدا-كن يا هيتومي؟
Dialogue: 0,0:18:09.93,0:18:13.26,Default,,0000,0000,0000,,!أجل! قبل أن ألتقيكما في الجامعة بفترة طويلة
Dialogue: 0,0:18:13.84,0:18:17.42,Default,,0000,0000,0000,,...لذا قرّرتُ قتله
Dialogue: 0,0:18:19.64,0:18:27.19,Default,,0000,0000,0000,,في مكان موعدنا الأوّل، وباستعمال القلادة\Nالتي أعطاني إيّاها
Dialogue: 0,0:19:03.59,0:19:05.79,Default,,0000,0000,0000,,أنت، لا تبكي
Dialogue: 0,0:19:05.79,0:19:08.21,Default,,0000,0000,0000,,!كيف لك أن تبقى متّزناً؟
Dialogue: 0,0:19:08.21,0:19:12.20,Default,,0000,0000,0000,,،أنا معتاد على مسارح الجريمة الآن\Nالجثث الممزقة وما إلى ذلك
Dialogue: 0,0:19:12.20,0:19:13.10,Default,,0000,0000,0000,,!فظيع
Dialogue: 0,0:19:13.91,0:19:15.72,Default,,0000,0000,0000,,يُستحسن بك أن تنسي سريعاً
Dialogue: 0,0:19:15.72,0:19:17.37,Default,,0000,0000,0000,,هذه الأشياء تحصل طوال الوقت
Dialogue: 0,0:19:17.37,0:19:18.77,Default,,0000,0000,0000,,!كلا، لا تحصل
Dialogue: 0,0:19:24.86,0:19:29.02,Default,,0000,0000,0000,,إنّه... أحد الرجلين بالرداء الأسود\Nاللذين كانا على الأفعوانية
Dialogue: 0,0:19:29.52,0:19:32.01,Default,,0000,0000,0000,,!آسف يا ران! ارجعي قبلي
Dialogue: 0,0:19:32.01,0:19:32.51,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:19:36.18,0:19:37.73,Default,,0000,0000,0000,,!سألحق بك
Dialogue: 0,0:19:38.68,0:19:39.68,Default,,0000,0000,0000,,!إنّه يغادر
Dialogue: 0,0:19:49.87,0:19:53.92,Default,,0000,0000,0000,,...لا أدري لمَ، لكن لسبب ما في تلك اللحظة
Dialogue: 0,0:19:55.33,0:20:00.94,Default,,0000,0000,0000,,راودني شعور فظيع بأنّي لن أرى شينتشي مُجدداً
Dialogue: 0,0:20:11.93,0:20:14.56,Default,,0000,0000,0000,,آسف على الإطالة يا رئيس الشركة
Dialogue: 0,0:20:15.27,0:20:17.93,Default,,0000,0000,0000,,!تأخّرت! كنتُ بانتظارك لساعتين
Dialogue: 0,0:20:17.93,0:20:19.60,Default,,0000,0000,0000,,!أتيت بمفردي كما اتّفقنا
Dialogue: 0,0:20:19.60,0:20:24.30,Default,,0000,0000,0000,,أعرف، صعدتُ الأفعوانية وتحققت من الأعلى
Dialogue: 0,0:20:24.30,0:20:25.35,Default,,0000,0000,0000,,!أسرع وأعطني ذاك الشيء
Dialogue: 0,0:20:25.67,0:20:28.06,Default,,0000,0000,0000,,لا تستعجل، المال أوّلاً
Dialogue: 0,0:20:28.09,0:20:30.20,Default,,0000,0000,0000,,هاك، لا اعتراضات الآن، صحيح؟
Dialogue: 0,0:20:31.31,0:20:33.16,Default,,0000,0000,0000,,!مُذهل! هناك ما يفوق 100 مليون
Dialogue: 0,0:20:33.65,0:20:35.52,Default,,0000,0000,0000,,انتهت صفقتنا هكذا
Dialogue: 0,0:20:35.52,0:20:36.98,Default,,0000,0000,0000,,!أسرع وأعطني الفيلم
Dialogue: 0,0:20:36.98,0:20:40.39,Default,,0000,0000,0000,,الفيلم الذي يدين شركتك بتهريب الأسلحة؟
Dialogue: 0,0:20:40.39,0:20:41.43,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:20:43.39,0:20:45.43,Default,,0000,0000,0000,,!هذا الفيلم هو كلّ شيء، صحيح؟
Dialogue: 0,0:20:45.43,0:20:46.49,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:20:48.76,0:20:50.59,Default,,0000,0000,0000,,من يكونون بالضبط يا ترى؟
Dialogue: 0,0:20:52.33,0:20:54.21,Default,,0000,0000,0000,,هذه نهاية لعبة المُتحرّي
Dialogue: 0,0:20:58.90,0:21:00.83,Default,,0000,0000,0000,,...لقد لحق بنا هذا الفتى
Dialogue: 0,0:21:01.41,0:21:04.29,Default,,0000,0000,0000,,!أليس هو المتحرّي يا زعيم؟ تريدني أن أتخلص منه؟
Dialogue: 0,0:21:04.29,0:21:07.95,Default,,0000,0000,0000,,كلا، لا تزال الشرطة في المكان
Dialogue: 0,0:21:07.95,0:21:11.70,Default,,0000,0000,0000,,سنستعمل هذا، آخر سمّ طوّرته منظمتنا
Dialogue: 0,0:21:12.61,0:21:15.71,Default,,0000,0000,0000,,لن يظهر عند تشريح الجثة حتّى
Dialogue: 0,0:21:16.56,0:21:20.35,Default,,0000,0000,0000,,لم يُختبر على البشر بعد، لكن لنعتبر هذه تجربة
Dialogue: 0,0:21:23.10,0:21:25.12,Default,,0000,0000,0000,,وداعاً أيّها المتحرّي
Dialogue: 0,0:21:36.29,0:21:40.03,Default,,0000,0000,0000,,!جـ-جسمي ساخن
Dialogue: 0,0:21:43.41,0:21:47.74,Default,,0000,0000,0000,,!كأنّ... عظامي تذوب
Dialogue: 0,0:21:47.74,0:21:49.66,Default,,0000,0000,0000,,!لا-لا أستطيع
Dialogue: 0,0:23:23.36,0:23:25.11,Default,,0000,0000,0000,,!أنتم! توجد جثّة هنا
Dialogue: 0,0:23:25.11,0:23:26.36,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:23:27.78,0:23:30.79,Default,,0000,0000,0000,,لعلّي مت حقّاً
Dialogue: 0,0:23:30.79,0:23:32.77,Default,,0000,0000,0000,,!كلا، لا يزال يتنفس
Dialogue: 0,0:23:32.77,0:23:34.79,Default,,0000,0000,0000,,!الإسعاف! اطلبوا الإسعاف
Dialogue: 0,0:23:35.31,0:23:37.06,Default,,0000,0000,0000,,أنا حيّ؟
Dialogue: 0,0:23:37.06,0:23:40.63,Default,,0000,0000,0000,,هكذا إذاً، لا يعمل ذاك السمّ على البشر
Dialogue: 0,0:23:40.63,0:23:42.20,Default,,0000,0000,0000,,تماسك
Dialogue: 0,0:23:42.20,0:23:44.09,Default,,0000,0000,0000,,أيمكنك الوقوف أيّها الصبي الصغير؟
Dialogue: 0,0:23:44.09,0:23:45.51,Default,,0000,0000,0000,,!صبيّ صغير؟
Dialogue: 0,0:24:04.33,0:24:05.88,Default,,0000,0000,0000,,!تقلّص جسدي؟
Dialogue: 0,0:24:07.20,0:24:08.05,Default,,0000,0000,0000,,!كيف؟
Dialogue: 0,0:24:08.70,0:24:10.23,Default,,0000,0000,0000,,...ا-اسمي شينـ
Dialogue: 0,0:24:10.23,0:24:11.14,Default,,0000,0000,0000,,...أقصد
Dialogue: 0,0:24:12.15,0:24:14.61,Default,,0000,0000,0000,,!حسناً، حسناً... كونان
Dialogue: 0,0:24:14.61,0:24:16.47,Default,,0000,0000,0000,,!اسمي إيدوغاوا كونان
Dialogue: 0,0:24:16.47,0:24:17.76,Default,,0000,0000,0000,,!أين تذهب يا كونان-كن؟
Dialogue: 0,0:24:19.56,0:24:20.25,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:24:24.22,0:24:25.89,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.89,0:24:28.51,Default,,0000,0000,0000,,اختطاف ابنة رئيس الشركة
Dialogue: 0,0:24:45.51,0:24:47.63,Default,,0000,0000,0000,,:تلميح الحلقة القادمة
Dialogue: 0,0:24:47.63,0:24:48.98,Default,,0000,0000,0000,,ناطحة سحاب
Dialogue: 0,0:24:50.72,0:24:53.21,Default,,0000,0000,0000,,!تحدّوني الحلقة القادمة

