Dialogue: 0,0:00:01.58,0:00:03.25,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.25,0:00:07.07,Default,,0000,0000,0000,,تُعالج استنتاجات كونان القلوب\Nالمُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.07,0:00:10.49,Default,,0000,0000,0000,,!تقع قضيّة اليوم في ليلة في منتصف الصيف\N!سأسحق أنا حُلم المجرم
Dialogue: 0,0:00:10.82,0:00:12.36,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.36,0:00:14.49,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.49,0:00:16.37,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.01,0:01:57.03,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل منزل عطلات التوائم الثلاثة
Dialogue: 0,0:01:52.55,0:01:55.35,Default,,0000,0000,0000,,جريمة قتل منزل عطلات التوائم الثلاثة
Dialogue: 0,0:01:57.03,0:01:59.49,CharCard,,0000,0000,0000,,\N{\fad(300,0)}إيزو
Dialogue: 0,0:01:57.49,0:02:01.87,On Top,,0000,0000,0000,,الصيف! لا شيء أفضل من البحر\N!عندما تشتدّ الشمس
Dialogue: 0,0:02:04.16,0:02:08.15,Default,,0000,0000,0000,,مع ذلك، لا يُعقل أنّ كونان-كن\Nهو الفتى الوحيد على الشاطئ
Dialogue: 0,0:02:08.15,0:02:12.46,Default,,0000,0000,0000,,!رغم وجود فتاتين فاتنتين! يا للأسى
Dialogue: 0,0:02:12.75,0:02:14.27,Default,,0000,0000,0000,,آسف على ذلك
Dialogue: 0,0:02:14.59,0:02:19.04,Default,,0000,0000,0000,,بالطبع، فهذا شاطئ منزلك الخاصّ
Dialogue: 0,0:02:19.31,0:02:20.47,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:20.47,0:02:25.17,Default,,0000,0000,0000,,!أتينا هنا للتسمّر وصيد الشباب في العطلة الصيفية
Dialogue: 0,0:02:26.01,0:02:29.84,Default,,0000,0000,0000,,دائماً ما تتكلمين عن الشباب فحسب يا سونوكو
Dialogue: 0,0:02:29.84,0:02:33.76,Default,,0000,0000,0000,,من الجميل امتلاكك لزوج مُحدّد سلفاً
Dialogue: 0,0:02:33.76,0:02:38.19,Default,,0000,0000,0000,,اشتريتِ زيّ السباحة هذا لتريه لشينتشي-كن، أليس كذلك؟
Dialogue: 0,0:02:41.45,0:02:44.05,Default,,0000,0000,0000,,ذاك... لأجلي؟
Dialogue: 0,0:02:44.05,0:02:46.17,Default,,0000,0000,0000,,بـ-بما أنّي هنا، سألقي نظرةً عن قرب
Dialogue: 0,0:02:50.04,0:02:51.42,Default,,0000,0000,0000,,!يوزو-سان
Dialogue: 0,0:02:51.42,0:02:52.80,Default,,0000,0000,0000,,يا لجمال الفتيات الشابات
Dialogue: 0,0:02:53.11,0:02:55.91,On Top,,0000,0000,0000,,لعلّي تسرّعت في خطبتي
Dialogue: 0,0:02:53.32,0:02:56.83,CharCard,,0000,0000,0005,,(توميزاوا يوزو (28\Nخطيب أياكو
Dialogue: 0,0:02:57.27,0:03:00.37,Default,,0000,0000,0000,,!أيّ كلام هذا! أنت واقع في حُب أختي
Dialogue: 0,0:03:00.44,0:03:01.92,Default,,0000,0000,0000,,...ماذا؟ أهو إذاً
Dialogue: 0,0:03:01.92,0:03:02.93,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:02.93,0:03:08.38,Default,,0000,0000,0000,,توميزاوا يوزو، الابن الثالث لرئيس\Nشركة توميزاوا للصناعات
Dialogue: 0,0:03:08.38,0:03:10.71,Default,,0000,0000,0000,,سيتزوّج أختي في الخريف المُقبل
Dialogue: 0,0:03:11.17,0:03:14.92,Default,,0000,0000,0000,,بين شركات عائلتينا علاقة وطيدة
Dialogue: 0,0:03:14.24,0:03:16.79,CharCard,,0000,0000,15,,{\fs(25)}منزل عطلات عائلة سوزوكي                            منزل عطلات عائلة توميزاوا
Dialogue: 0,0:03:14.92,0:03:17.91,Default,,0000,0000,0000,,انظري! حتّى منزلَي عطلاتنا متجاوران
Dialogue: 0,0:03:17.91,0:03:22.79,Default,,0000,0000,0000,,رأى يوزو-سان أختي في حفلة\Nووقع في حبّها من أوّل نظرة
Dialogue: 0,0:03:23.75,0:03:25.87,Default,,0000,0000,0000,,قلتِ ما يكفي يا سونوكو-تشان
Dialogue: 0,0:03:25.87,0:03:29.38,Default,,0000,0000,0000,,،إذا أردت لقاء أختي فهي في منزلنا\Nما رأيك بالذهاب؟
Dialogue: 0,0:03:29.90,0:03:34.67,Default,,0000,0000,0000,,!لا، أتيتُ اليوم لتقديمها لأبي وإخوتي
Dialogue: 0,0:03:35.53,0:03:36.38,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:03:36.38,0:03:37.62,Default,,0000,0000,0000,,سيأتون هنا؟
Dialogue: 0,0:03:38.06,0:03:40.94,Default,,0000,0000,0000,,أجل، سيأتي إخوتي غداً
Dialogue: 0,0:03:40.94,0:03:43.09,Default,,0000,0000,0000,,لكن يُفترض أنّ أبي وصل للمنزل
Dialogue: 0,0:03:43.94,0:03:45.60,Default,,0000,0000,0000,,سأتّصل به
Dialogue: 0,0:03:48.72,0:03:52.01,Default,,0000,0000,0000,,هذا منزل توميزاوا، لسنا متواجدين حالياً
Dialogue: 0,0:03:52.01,0:03:56.07,Default,,0000,0000,0000,,...فاترك رسالةً بعد سماع الصافرة رجاءً
Dialogue: 0,0:03:54.76,0:03:57.21,On Top,,0000,0000,0000,,ماذا؟ إنّها آلة الردّ
Dialogue: 0,0:03:57.21,0:03:59.06,Default,,0000,0000,0000,,أتعرفين ما الساعة الآن؟
Dialogue: 0,0:03:59.06,0:04:00.87,Default,,0000,0000,0000,,الثالثة وعشر دقائق
Dialogue: 0,0:04:00.87,0:04:04.46,Default,,0000,0000,0000,,هذا غريب، يُفترض أنّه وصل في الثالثة
Dialogue: 0,0:04:05.55,0:04:06.86,Default,,0000,0000,0000,,ما الخطب يا سونوكو؟
Dialogue: 0,0:04:06.86,0:04:10.82,Default,,0000,0000,0000,,العمّ تيتسوهارا سيأتي! لا وقت لدينا\N!للهو على الشاطئ
Dialogue: 0,0:04:10.82,0:04:12.32,Default,,0000,0000,0000,,!عليّ الذهاب لإلقاء التحيّة
Dialogue: 0,0:04:12.32,0:04:13.63,Default,,0000,0000,0000,,!انتظري، سونوكو
Dialogue: 0,0:04:19.52,0:04:20.25,Default,,0000,0000,0000,,عجباً
Dialogue: 0,0:04:20.65,0:04:22.40,Default,,0000,0000,0000,,!أ-أبي
Dialogue: 0,0:04:22.40,0:04:24.96,Default,,0000,0000,0000,,يوزو! لقد أتيت
Dialogue: 0,0:04:25.60,0:04:31.42,Default,,0000,0000,0000,,يا إلهي، أخبرتك أن تنتظر في منزلنا\Nوسأجلب خطيبتي هناك
Dialogue: 0,0:04:31.42,0:04:33.48,CharCard,,0000,0000,0002,,{\fs(25)} (60)  توميزاوا تيتسوهارا\Nرئيس شركة توميزاوا للصناعات
Dialogue: 0,0:04:31.76,0:04:34.68,On Top,,0000,0000,0000,,لا تقل ذلك، أردتُ أن أتذوّق طهو
Dialogue: 0,0:04:34.68,0:04:36.68,On Top,,0000,0000,0000,,زوجتك المستقبلية الليلة
Dialogue: 0,0:04:34.92,0:04:37.32,CharCard,,0000,0000,0004,,{\fs(25)}   سوزوكي أياكو\Nأخت سونوكو الكبرى
Dialogue: 0,0:04:37.96,0:04:39.33,On Top,,0000,0000,0000,,!ضربها بقوّة
Dialogue: 0,0:04:39.45,0:04:41.70,On Top,,0000,0000,0000,,!طارت! ثلاث نقاط
Dialogue: 0,0:04:41.79,0:04:46.17,On Top,,0000,0000,0000,,أرسل لاعب فريق فالكونز رقم 4 كوغوري \N!الكرة إلى المدرّجات اليمنى تحت المطر الغزير
Dialogue: 0,0:04:46.17,0:04:47.49,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:04:47.49,0:04:50.25,Default,,0000,0000,0000,,أبي، أنت مُعجب بكوغوري
Dialogue: 0,0:04:50.82,0:04:52.28,Default,,0000,0000,0000,,أجل، بالطبع
Dialogue: 0,0:04:52.28,0:04:54.59,Default,,0000,0000,0000,,لكن لمَ تشاهد المباراة ونحن هنا؟
Dialogue: 0,0:04:55.16,0:04:59.13,Default,,0000,0000,0000,,لم يكن بيدي خيار، فالاستقبال في منزلنا سيّئ
Dialogue: 0,0:05:00.19,0:05:05.39,Default,,0000,0000,0000,,ضربة ترسل الكرة أمام المنتصف! نحن في النصف الثاني\N!من الشوط السادس ولا يزال هجوم فالكونز مستمراً
Dialogue: 0,0:05:07.49,0:05:12.21,Default,,0000,0000,0000,,أصبحت الساعة التاسعة، سنضطر لقطع البثّ مؤقتاً\Nوالانتقال لنشرة أنباء بخمس دقائق
Dialogue: 0,0:05:12.47,0:05:17.42,Default,,0000,0000,0000,,اشتدّت قوّة الإعصار الاستوائيّ 11\Nوهو يتّجه شمالاً من أوكيناوا
Dialogue: 0,0:05:17.42,0:05:21.21,Default,,0000,0000,0000,,أدّى ذلك لتأخير في رحلات\Nالكثير من الطائرات والسفن
Dialogue: 0,0:05:21.46,0:05:23.87,Default,,0000,0000,0000,,الساعة التاسعة رغم أنّه الشوط السادس فحسب؟
Dialogue: 0,0:05:23.87,0:05:26.50,Default,,0000,0000,0000,,أخّر المطر المباراة
Dialogue: 0,0:05:27.49,0:05:29.92,Default,,0000,0000,0000,,أياكو-سان، هل لديكِ مذياع؟
Dialogue: 0,0:05:30.49,0:05:33.55,Default,,0000,0000,0000,,لا يبدو أنّ هذه المباراة تُبثّ\Nعلى المذياع يا عمّ
Dialogue: 0,0:05:34.62,0:05:40.54,Default,,0000,0000,0000,,!لا تقلق يا عمّ، ستبدأ سريعاً\Nما رأيك بشرب القهوة؟
Dialogue: 0,0:05:40.94,0:05:44.61,Default,,0000,0000,0000,,فتيات عائلة سوزوكي حسنات التربية حقّاً
Dialogue: 0,0:05:44.61,0:05:47.29,Default,,0000,0000,0000,,!يوزو، أنت شاب محظوظ
Dialogue: 0,0:05:47.76,0:05:51.10,Default,,0000,0000,0000,,...مقارنةً بذلك، ابناي الآخران
Dialogue: 0,0:05:52.43,0:05:57.29,Default,,0000,0000,0000,,تايتشي الأكبر سنّاً رفض خلافتي في الشركة\Nوأصبح روائيّاً بدل ذلك
Dialogue: 0,0:05:57.29,0:05:59.34,Default,,0000,0000,0000,,ولا يزال أعزب بسبب ذلك
Dialogue: 0,0:05:59.34,0:06:02.13,Default,,0000,0000,0000,,...بينما ابني الأوسط تاتسوجي قد التحق بالشركة
Dialogue: 0,0:06:02.13,0:06:06.01,Default,,0000,0000,0000,,لكنّه خطب فتاةً مجهولة الأصل\N!ولم يأخذ موافقتي حتّى
Dialogue: 0,0:06:06.30,0:06:08.96,Default,,0000,0000,0000,,توقّف عن نميمة إخوتي
Dialogue: 0,0:06:09.20,0:06:12.96,Default,,0000,0000,0000,,كلامي موجّه لك أيضاً يا يوزو! تقضي وقتك\Nعلى الرسومات السخيفة باستمرار
Dialogue: 0,0:06:14.29,0:06:15.17,Default,,0000,0000,0000,,!يوزو-سان
Dialogue: 0,0:06:15.66,0:06:21.07,Default,,0000,0000,0000,,سأذهب لورشتي، لديّ رسمة عليّ إنهاؤها
Dialogue: 0,0:06:21.07,0:06:21.96,Default,,0000,0000,0000,,!يوزو-سان
Dialogue: 0,0:06:22.94,0:06:25.78,Default,,0000,0000,0000,,لو ترك عناده والتحق بالشركة
Dialogue: 0,0:06:25.78,0:06:27.42,Default,,0000,0000,0000,,كنتُ لأعطيه منصباً ممتازاً
Dialogue: 0,0:06:31.96,0:06:37.33,Default,,0000,0000,0000,,انتهت! فاز فالكونز بنتيجة 9 مقابل 8\N!في النصف الثاني للشوط الحادي عشر
Dialogue: 0,0:06:37.33,0:06:39.71,Default,,0000,0000,0000,,!رائع! رائع! مرحى
Dialogue: 0,0:06:39.71,0:06:41.80,Default,,0000,0000,0000,,!هذا جوهر كرة قاعدة الصقور
Dialogue: 0,0:06:44.38,0:06:48.21,Default,,0000,0000,0000,,تأخّر الوقت، ربما عليّ العودة للمنزل
Dialogue: 0,0:06:50.65,0:06:54.58,Default,,0000,0000,0000,,إذًا يا أياكو-سان، سأصطحب أبنائي معي غداً
Dialogue: 0,0:06:54.58,0:06:56.05,Default,,0000,0000,0000,,أهذا ممكن؟
Dialogue: 0,0:06:56.05,0:06:57.74,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:07:00.53,0:07:04.09,Default,,0000,0000,0000,,يا إلهي! أينوي مشاهدة مباراة أخرى غداً؟
Dialogue: 0,0:07:06.11,0:07:08.98,Default,,0000,0000,0000,,...أصبحت الحادية عشر والنصف، علينا
Dialogue: 0,0:07:09.81,0:07:10.84,Default,,0000,0000,0000,,انقطاع تيّار؟
Dialogue: 0,0:07:11.37,0:07:12.42,Default,,0000,0000,0000,,يبدو ذلك
Dialogue: 0,0:07:12.81,0:07:17.33,Default,,0000,0000,0000,,انظري، أنوار منزل العمّ تيتسوهارا مقطوعة أيضاً
Dialogue: 0,0:07:18.01,0:07:19.21,Default,,0000,0000,0000,,لا بدّ أنّها الصاعقة
Dialogue: 0,0:07:21.63,0:07:23.13,Default,,0000,0000,0000,,ما ذلك؟
Dialogue: 0,0:07:23.88,0:07:25.08,Default,,0000,0000,0000,,!يوجد أحد
Dialogue: 0,0:07:25.08,0:07:26.13,Default,,0000,0000,0000,,من هو؟
Dialogue: 0,0:07:26.13,0:07:27.87,Default,,0000,0000,0000,,ما الذي يفعله؟
Dialogue: 0,0:07:33.46,0:07:34.92,Default,,0000,0000,0000,,!يوزو-سان
Dialogue: 0,0:07:37.99,0:07:38.75,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:07:39.78,0:07:40.96,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:07:43.59,0:07:45.34,Default,,0000,0000,0000,,!كونان-كن! انتظر
Dialogue: 0,0:07:50.94,0:07:53.52,Default,,0000,0000,0000,,!تبّاً! فقدتُ أثره
Dialogue: 0,0:07:57.13,0:07:58.21,Default,,0000,0000,0000,,!عمّي
Dialogue: 0,0:07:58.55,0:08:00.71,Default,,0000,0000,0000,,!عمّي! عمّي
Dialogue: 0,0:08:06.79,0:08:08.69,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:08:13.12,0:08:14.13,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:08:14.75,0:08:20.78,Default,,0000,0000,0000,,شاهدتم قتل السيّد توميزاوا ليلة البارحة\Nعند الحادية عشرة والنصف
Dialogue: 0,0:08:20.78,0:08:22.18,Default,,0000,0000,0000,,على يديّ ابنه يوزو، صحيح؟
Dialogue: 0,0:08:22.61,0:08:23.38,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:08:25.66,0:08:28.73,Default,,0000,0000,0000,,أياكو-سان، ما الخطب هنا؟
Dialogue: 0,0:08:28.73,0:08:30.09,Default,,0000,0000,0000,,!يوزو-سان
Dialogue: 0,0:08:31.15,0:08:32.57,Default,,0000,0000,0000,,!أأنت توميزاوا يوزو؟
Dialogue: 0,0:08:32.57,0:08:33.81,Default,,0000,0000,0000,,...نـ-نعم
Dialogue: 0,0:08:33.81,0:08:34.88,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:08:35.35,0:08:38.93,Default,,0000,0000,0000,,!تعرف ما فعلت، قتلت والدك توميزاوا تيتسوهارا
Dialogue: 0,0:08:38.93,0:08:41.62,Default,,0000,0000,0000,,!ماذا؟ قتلت أبي؟! هذا هراء
Dialogue: 0,0:08:42.82,0:08:46.14,Default,,0000,0000,0000,,!دعوني! لم أقتله
Dialogue: 0,0:08:46.14,0:08:47.92,Default,,0000,0000,0000,,ما الخطب يا يوزو؟
Dialogue: 0,0:08:49.08,0:08:50.54,On Top,,0000,0000,0000,,!أخي تاتسوجي
Dialogue: 0,0:08:49.24,0:08:52.33,CharCard,,0000,0000,0004,,(28) توميزاوا تاتسوجي\Nموظف مكتبيّ
Dialogue: 0,0:08:50.54,0:08:52.13,On Top,,0000,0000,0000,,لمَ هذه الجلبة؟
Dialogue: 0,0:08:53.96,0:08:56.33,On Top,,0000,0000,0000,,أخي تايتشي، يبدو أنّ حادثةً وقعت
Dialogue: 0,0:08:56.74,0:08:58.20,On Top,,0000,0000,0000,,توقيت ممتاز
Dialogue: 0,0:08:56.95,0:09:00.74,CharCard,,0000,0000,0004,,\N{\fad(300,0)} (28) توميزاوا تايتشي\Nروائيّ
Dialogue: 0,0:08:58.20,0:09:00.54,On Top,,0000,0000,0000,,كنتُ محتاراً بشأن موضوع لروايتي الجديدة
Dialogue: 0,0:09:00.86,0:09:04.30,Default,,0000,0000,0000,,!ثـ-ثلاثة توائم؟
Dialogue: 0,0:09:04.68,0:09:08.70,Default,,0000,0000,0000,,توميزاوا يوزو! أنت رهن الاعتقال\N!بتهمة قتل توميزاوا تيتسوهارا
Dialogue: 0,0:09:08.70,0:09:11.35,Default,,0000,0000,0000,,!حضرة المحقّق! انتظر رجاءً
Dialogue: 0,0:09:12.22,0:09:15.00,Default,,0000,0000,0000,,...صحيحٌ أنّنا رأينا وجه القاتل، لكن
Dialogue: 0,0:09:15.56,0:09:18.63,Default,,0000,0000,0000,,رأينا عيناه وأنفه فحسب
Dialogue: 0,0:09:18.63,0:09:24.16,Default,,0000,0000,0000,,!لم نعرف أنّ ليوزو-سان توأمان مطابقان له
Dialogue: 0,0:09:24.75,0:09:29.12,Default,,0000,0000,0000,,أي أنّ أحدكم الثلاثة كان الفاعل؟
Dialogue: 0,0:09:30.15,0:09:34.12,Default,,0000,0000,0000,,كنتُ في أوكيناوا البارحة في رحلة عمل للشركة
Dialogue: 0,0:09:34.12,0:09:37.86,Default,,0000,0000,0000,,استقللتُ الرحلة الأولى صباحاً وهبطت\Nفي هانيدا قبل 3 ساعات فحسب
Dialogue: 0,0:09:37.86,0:09:42.19,Default,,0000,0000,0000,,آخر رحلة لأوكيناوا غادرت عند الثامنة مساء
Dialogue: 0,0:09:42.19,0:09:45.29,Default,,0000,0000,0000,,كان مستحيلاً عليّ التواجد\Nفي المنزل وقت وقوع الجريمة
Dialogue: 0,0:09:45.29,0:09:47.29,Default,,0000,0000,0000,,تحقّق من ذلك
Dialogue: 0,0:09:47.29,0:09:47.99,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:09:49.02,0:09:50.95,Default,,0000,0000,0000,,...لكنّ أوكيناوا بالأمس
Dialogue: 0,0:09:51.47,0:09:56.17,Default,,0000,0000,0000,,حضرة المحقّق، لا أدري إذا كنت أستطيع\N...اعتبارها حجّة غياب أم لا، لكن
Dialogue: 0,0:09:56.80,0:09:59.16,Default,,0000,0000,0000,,لديك رسالتان
Dialogue: 0,0:09:59.88,0:10:01.77,Default,,0000,0000,0000,,أتعرفين ما الساعة الآن؟
Dialogue: 0,0:10:01.77,0:10:03.55,Default,,0000,0000,0000,,الثالثة وعشر دقائق
Dialogue: 0,0:10:03.55,0:10:08.33,Default,,0000,0000,0000,,هذا غريب، يُفترض أنّه وصل في الثالثة
Dialogue: 0,0:10:08.33,0:10:09.58,Default,,0000,0000,0000,,الثالثة وعشر دقائق مساءً
Dialogue: 0,0:10:10.25,0:10:14.04,Default,,0000,0000,0000,,!هذا أنا! اتّصلتُ من الشاطئ بهاتفي الخلويّ
Dialogue: 0,0:10:14.04,0:10:15.85,Default,,0000,0000,0000,,مرحباً، أنا تايتشي
Dialogue: 0,0:10:15.85,0:10:17.53,Default,,0000,0000,0000,,هذا أنا
Dialogue: 0,0:10:17.84,0:10:20.44,Default,,0000,0000,0000,,مُبارك على فوز فالكونز يا أبي
Dialogue: 0,0:10:20.99,0:10:25.69,Default,,0000,0000,0000,,الهوم رن الذي أحرزه كوغوري بضربة مباشرة في النصف الثاني\N!للشوط السادس كان له تأثير كبير
Dialogue: 0,0:10:25.69,0:10:29.14,Default,,0000,0000,0000,,كوغوري ضارب كرات مُبهر! أراك في الغد
Dialogue: 0,0:10:30.31,0:10:32.89,Default,,0000,0000,0000,,الحادية عشرة وأربع وثلاثون دقيقة مساءً
Dialogue: 0,0:10:33.52,0:10:37.45,Default,,0000,0000,0000,,...الحادية عشرة وأربع وثلاثون دقيقة مساءً\Nوقت وقوع الجريمة
Dialogue: 0,0:10:38.92,0:10:42.87,Default,,0000,0000,0000,,أأنتم متأكدون أنّها وقعت في الحادية عشرة والنصف؟
Dialogue: 0,0:10:43.79,0:10:47.82,Default,,0000,0000,0000,,نعم! فقد نظرنا للساعة قبيل رؤيتنا للقاتل
Dialogue: 0,0:10:48.33,0:10:53.96,Default,,0000,0000,0000,,لم يكن أخي القاتل أبداً! فقد بُثّت تلك المباراة\Nعبر الأقمار الصناعية فحسب
Dialogue: 0,0:10:53.96,0:10:57.03,Default,,0000,0000,0000,,وانتهت بعد 11:25 بقليل
Dialogue: 0,0:10:57.03,0:10:59.78,Default,,0000,0000,0000,,لم يكن يستطيع معرفة النتيجة\Nإلّا إذا شاهدها
Dialogue: 0,0:11:00.32,0:11:03.70,Default,,0000,0000,0000,,!تحقّقوا من بثّ محطّات التلفاز والإذاعة! بسرعة
Dialogue: 0,0:11:03.70,0:11:04.25,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:04.82,0:11:08.10,Default,,0000,0000,0000,,...إذا لم يكن القاتل أحدنا نحن الاثنين
Dialogue: 0,0:11:08.10,0:11:10.31,Default,,0000,0000,0000,,لا يبقى سوى يوزو
Dialogue: 0,0:11:10.31,0:11:11.45,Default,,0000,0000,0000,,!أ-أخي
Dialogue: 0,0:11:11.81,0:11:14.31,Default,,0000,0000,0000,,!كلا! يستحيل أن أقتل أحداً
Dialogue: 0,0:11:14.31,0:11:16.41,Default,,0000,0000,0000,,ما حجّة غيابك البارحة إذاً؟
Dialogue: 0,0:11:17.02,0:11:19.18,Default,,0000,0000,0000,,كنتُ في ورشتي طوال الوقت
Dialogue: 0,0:11:19.18,0:11:24.87,Default,,0000,0000,0000,,!صحيح، اتّصل بي صديق رسّام وأيقظني\Nكان ذلك بعد الحادية عشرة والنصف
Dialogue: 0,0:11:25.30,0:11:26.97,Default,,0000,0000,0000,,أيقظك؟
Dialogue: 0,0:11:26.97,0:11:27.75,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:11:27.75,0:11:32.08,Default,,0000,0000,0000,,غفوت! كان عليّ السهر طوال الليل لإنهاء العمل
Dialogue: 0,0:11:32.33,0:11:34.46,Default,,0000,0000,0000,,سنتأكد معه إذاً
Dialogue: 0,0:11:34.46,0:11:38.18,Default,,0000,0000,0000,,...محقّق يوكوميزو! بشأن لائحة المسافرين
Dialogue: 0,0:11:42.70,0:11:45.91,Default,,0000,0000,0000,,ماذا؟ وجدتم اسمي، أليس كذلك؟
Dialogue: 0,0:11:45.91,0:11:47.61,Default,,0000,0000,0000,,وجدناه بالفعل
Dialogue: 0,0:11:48.44,0:11:51.58,Default,,0000,0000,0000,,المشكلة هي وقت هبوط الطائرة
Dialogue: 0,0:11:52.02,0:11:58.43,Default,,0000,0000,0000,,وصلت الطائرة التي ادّعيت أنّك كنت\N!على متنها مطار هانيدا قبل 30 دقيقة
Dialogue: 0,0:11:58.43,0:11:59.70,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:12:00.09,0:12:04.30,Default,,0000,0000,0000,,لعلّ الإعصار أخّرها، فقد ذكروا ذلك في الأنباء البارحة
Dialogue: 0,0:12:04.30,0:12:05.67,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:12:06.09,0:12:10.62,Default,,0000,0000,0000,,هيّا، هلّا أخبرتنا أين كنت حقّاً البارحة؟
Dialogue: 0,0:12:10.62,0:12:16.62,Default,,0000,0000,0000,,!طـ-طوكيو! صحيح، رجعتُ لطوكيو البارحة
Dialogue: 0,0:12:16.62,0:12:18.32,Default,,0000,0000,0000,,!لمنزل هيرومي هناك
Dialogue: 0,0:12:18.63,0:12:19.57,Default,,0000,0000,0000,,هيرومي؟
Dialogue: 0,0:12:19.57,0:12:24.04,Default,,0000,0000,0000,,خطيبتي، سمعت أنّها سقطت مغشيّاً عليها\N فشعرتُ بالقلق وذهبت
Dialogue: 0,0:12:24.57,0:12:28.52,Default,,0000,0000,0000,,اعتقدتُ أنّي سأقع في ورطة إذا\Nعرف أبي أنّي تركتُ العمل لأجلها
Dialogue: 0,0:12:28.52,0:12:30.16,Default,,0000,0000,0000,,!فطلبتُ من زميل التغطية عليّ
Dialogue: 0,0:12:30.69,0:12:32.62,Default,,0000,0000,0000,,!إنّها الحقيقة! صدّقني رجاءً
Dialogue: 0,0:12:32.62,0:12:34.36,Default,,0000,0000,0000,,أهناك من يشهد لك؟
Dialogue: 0,0:12:34.36,0:12:35.37,Default,,0000,0000,0000,,هـ-هيرومي
Dialogue: 0,0:12:35.61,0:12:39.10,Default,,0000,0000,0000,,صحيح! ذكرتُ كيف انتهت المباراة قبل قليل
Dialogue: 0,0:12:39.10,0:12:43.35,Default,,0000,0000,0000,,لم تظهر نتيجتها في أيّ نشرة أنباء بعد\Nعند الحادية عشرة والنصف
Dialogue: 0,0:12:43.35,0:12:48.07,Default,,0000,0000,0000,,أعرف ذلك لأنّي تنقّلت بين القنوات\N!لمشاهدة هوم رن كوغوري مُجدداً
Dialogue: 0,0:12:48.07,0:12:51.50,Default,,0000,0000,0000,,محقّق يوكوميزو، إنّه يقول الحقيقة
Dialogue: 0,0:12:51.50,0:12:56.57,Default,,0000,0000,0000,,عرضت محطّات التلفاز والإذاعة\Nأحداث المباراة بعد منتصف الليل
Dialogue: 0,0:12:56.87,0:13:00.20,Default,,0000,0000,0000,,أأنت مُعجب بكوغوري أيضاً؟
Dialogue: 0,0:13:00.78,0:13:03.79,Default,,0000,0000,0000,,فقد كنت تطري عليه على الهاتف
Dialogue: 0,0:13:04.16,0:13:09.47,Default,,0000,0000,0000,,إنّه مُذهل! وحده كوغوري يستطيع إحراز هوم رن\N!بتوجيه كرة كتلك نحو المدرجات اليمنى
Dialogue: 0,0:13:10.86,0:13:14.32,Default,,0000,0000,0000,,!توجيه؟! ما معنى هذا يا تايتشي-سان؟
Dialogue: 0,0:13:14.32,0:13:17.43,Default,,0000,0000,0000,,!قلت أنّها كانت ضربة مباشرة على الهاتف
Dialogue: 0,0:13:17.43,0:13:19.95,Default,,0000,0000,0000,,!أكنت تشاهد تلك المباراة حقّاً؟
Dialogue: 0,0:13:21.01,0:13:22.41,Default,,0000,0000,0000,,يبدو أنّي انكشفت
Dialogue: 0,0:13:22.86,0:13:25.12,Default,,0000,0000,0000,,!أي أنّك قتلت أباك؟
Dialogue: 0,0:13:25.68,0:13:32.30,Default,,0000,0000,0000,,قطعاً لا! قصدت أن أمر عدم مشاهدتي\Nللمباراة على التلفاز قد كُشف
Dialogue: 0,0:13:32.30,0:13:36.99,Default,,0000,0000,0000,,كنتُ أستمع لها على المذياع\Nبينما ألعب الباتشينكو
Dialogue: 0,0:13:37.58,0:13:40.45,Default,,0000,0000,0000,,كنتُ أستريح من ضغط الكتابة
Dialogue: 0,0:13:41.12,0:13:45.16,Default,,0000,0000,0000,,أعتقد أنّ البثّ الإذاعيّ الوحيد كان\Nفي أوساكا حيث أعيش
Dialogue: 0,0:13:45.66,0:13:49.62,Default,,0000,0000,0000,,إنّه محقّ، عرضت محطّة إذاعية واحدة فحسب\Nفي أوساكا المباراة
Dialogue: 0,0:13:49.98,0:13:54.71,Default,,0000,0000,0000,,كما أنّي تركت رسالةً على آلة الرد وقت وقوع الجريمة
Dialogue: 0,0:13:54.98,0:13:57.16,Default,,0000,0000,0000,,...ذلك صحيح
Dialogue: 0,0:13:57.60,0:14:02.25,Default,,0000,0000,0000,,!من هو؟ أحد هؤلاء الثلاثة يكذب
Dialogue: 0,0:14:02.68,0:14:06.96,Default,,0000,0000,0000,,وساعة معصم الضحيّة المفقودة تحيّرني
Dialogue: 0,0:14:06.96,0:14:08.68,Default,,0000,0000,0000,,لمَ أخذها القاتل؟
Dialogue: 0,0:14:09.30,0:14:12.20,Default,,0000,0000,0000,,...لإخفاء الزمن؟ أم
Dialogue: 0,0:14:12.46,0:14:15.21,Default,,0000,0000,0000,,ماذا؟ جهاز الفيديو هذا يُومض
Dialogue: 0,0:14:15.21,0:14:19.91,Default,,0000,0000,0000,,أجل، كان هناك انقطاع تيّار استمرّ\Nعشر دقائق عند الحادية عشرة والنصف البارحة
Dialogue: 0,0:14:19.91,0:14:23.57,Default,,0000,0000,0000,,صحيح، كان هناك انقطاع تيّار قبيل الجريمة
Dialogue: 0,0:14:24.25,0:14:25.12,Default,,0000,0000,0000,,انقطاع تيّار؟
Dialogue: 0,0:14:25.83,0:14:29.65,Default,,0000,0000,0000,,!لحظة، هذا غريب! ما قاله ذاك الشخص مستحيل
Dialogue: 0,0:14:29.65,0:14:31.39,Default,,0000,0000,0000,,...كما في ذلك الوقت، كان
Dialogue: 0,0:14:32.24,0:14:35.12,Default,,0000,0000,0000,,...إذاً ساعة المعصم المنزوعة من يد الضحيّة
Dialogue: 0,0:14:36.43,0:14:37.28,Default,,0000,0000,0000,,أيمكن؟
Dialogue: 0,0:14:37.77,0:14:43.73,Default,,0000,0000,0000,,!فهمت، لا شكّ في الأمر\N!القاتل هو صاحب الكذبتين
Dialogue: 0,0:14:50.47,0:14:53.33,Default,,0000,0000,0000,,سأطلب من ثلاثتكم مرافقتي للمركز
Dialogue: 0,0:14:53.33,0:14:55.13,Default,,0000,0000,0000,,!لا-لا يمكن
Dialogue: 0,0:14:55.13,0:14:56.87,Default,,0000,0000,0000,,!هذا ليس طريفاً
Dialogue: 0,0:14:56.87,0:14:58.54,Default,,0000,0000,0000,,لمَ أنا؟
Dialogue: 0,0:14:58.54,0:15:00.24,Default,,0000,0000,0000,,لا خيار بيدنا
Dialogue: 0,0:15:00.66,0:15:06.28,Default,,0000,0000,0000,,رأى هؤلاء الأشخاص وجه القاتل\Nأثناء وقوع الجريمة
Dialogue: 0,0:15:06.28,0:15:09.08,Default,,0000,0000,0000,,!وهو يبدو مماثلاُ لأحدكم الثلاثة
Dialogue: 0,0:15:09.70,0:15:14.54,Default,,0000,0000,0000,,!أي أنّ المجرم الذي قتل أبيكم موجود بينكم
Dialogue: 0,0:15:15.24,0:15:20.49,Default,,0000,0000,0000,,أعرف المجرم، إنّه صاحب حجّة الغياب الغريبة
Dialogue: 0,0:15:21.02,0:15:24.91,Default,,0000,0000,0000,,حسنٌ، سأنوّم سونوكو وأجعلها\Nتؤدي دور المتحرّي
Dialogue: 0,0:15:25.58,0:15:27.47,Default,,0000,0000,0000,,ما الذي تفعله يا كونان-كن؟
Dialogue: 0,0:15:28.72,0:15:30.53,Default,,0000,0000,0000,,!ما هذه الساعة؟
Dialogue: 0,0:15:30.53,0:15:31.29,Default,,0000,0000,0000,,...إنّها
Dialogue: 0,0:15:32.01,0:15:33.68,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:15:33.68,0:15:36.39,Default,,0000,0000,0000,,كان كونان-كن يصوّب\Nبساعة غريبة نحوك
Dialogue: 0,0:15:37.83,0:15:41.58,Default,,0000,0000,0000,,إنّها لعبة! أعطاني إيّاها البروفسور آغاسا
Dialogue: 0,0:15:41.58,0:15:44.20,Default,,0000,0000,0000,,تُطلق كرات معدنية عندما تضغط الزرّ
Dialogue: 0,0:15:44.20,0:15:46.31,Default,,0000,0000,0000,,!يا لك من مشاغب
Dialogue: 0,0:15:46.95,0:15:48.58,Default,,0000,0000,0000,,!عليّ الذهاب للحمّام
Dialogue: 0,0:15:57.56,0:15:59.96,Default,,0000,0000,0000,,سونوكو؟ ما الخطب؟
Dialogue: 0,0:16:00.90,0:16:06.89,Default,,0000,0000,0000,,اكتشفتُ هويّته، أعرف المجرم \N!الذي قتل العمّ تيتسوهارا
Dialogue: 0,0:16:08.14,0:16:12.93,Default,,0000,0000,0000,,لا أحد من الثلاثة يملك حجّة غياب واضحة
Dialogue: 0,0:16:12.93,0:16:17.25,Default,,0000,0000,0000,,لكن هناك من يكذب بوضوح
Dialogue: 0,0:16:17.25,0:16:19.74,Default,,0000,0000,0000,,!القاتل هو تايتشي-سان بلا شكّ
Dialogue: 0,0:16:19.74,0:16:21.42,Default,,0000,0000,0000,,!تايتشي-سان؟
Dialogue: 0,0:16:21.42,0:16:22.68,Default,,0000,0000,0000,,!ما الذي تقولينه يا صبيّة؟
Dialogue: 0,0:16:23.21,0:16:24.36,Default,,0000,0000,0000,,هذا مثير
Dialogue: 0,0:16:25.36,0:16:27.99,Default,,0000,0000,0000,,لكنّي كنت في صالة باتشينكو في أوساكا
Dialogue: 0,0:16:27.99,0:16:31.20,Default,,0000,0000,0000,,لا أظنّ أن تواجدي هنا وقت\Nوقوع الجريمة كان ممكناً
Dialogue: 0,0:16:31.20,0:16:33.83,Default,,0000,0000,0000,,أكنت في صالة باتشينكو عند\Nالحادية عشرة والنصف حقّاً؟
Dialogue: 0,0:16:34.41,0:16:35.79,Default,,0000,0000,0000,,نعم، صحيح
Dialogue: 0,0:16:36.86,0:16:41.23,Default,,0000,0000,0000,,...ألا تعرف؟ صالات الباتشينكو تغلق أبوابها عند الساعة
Dialogue: 0,0:16:41.23,0:16:44.21,Default,,0000,0000,0000,,الحادية عشرة مساءً بأبعد الحدود
Dialogue: 0,0:16:45.15,0:16:51.37,Default,,0000,0000,0000,,بالفعل، يُحظر على صالات الباتشينكو\Nالبقاء مفتوحة بعد الحادية عشرة مساءً
Dialogue: 0,0:16:51.76,0:16:53.64,Default,,0000,0000,0000,,!حتّى في أوساكا
Dialogue: 0,0:16:53.64,0:16:56.23,Default,,0000,0000,0000,,!هذا يعني أنّك تكذب
Dialogue: 0,0:16:57.00,0:16:58.46,Default,,0000,0000,0000,,!التبس الأمر عليّ
Dialogue: 0,0:16:58.46,0:17:02.33,Default,,0000,0000,0000,,سمعتُ البثّ داخل سيّارة أجرة\Nفي طريق عودتي للبيت
Dialogue: 0,0:17:02.33,0:17:03.88,Default,,0000,0000,0000,,!حقّاً؟
Dialogue: 0,0:17:03.88,0:17:06.78,Default,,0000,0000,0000,,لا تكن هكذا حضرة المحقّق! كانت غلطةً بسيطة
Dialogue: 0,0:17:07.24,0:17:12.12,Default,,0000,0000,0000,,كما أنّي تركت رسالةً على آلة الردّ\Nوقت وقوع الجريمة
Dialogue: 0,0:17:12.12,0:17:14.16,Default,,0000,0000,0000,,كيف تفسّرون ذلك؟
Dialogue: 0,0:17:14.16,0:17:15.12,Default,,0000,0000,0000,,إنّه مُمكن
Dialogue: 0,0:17:16.23,0:17:20.45,Default,,0000,0000,0000,,كما هناك هفوة كبيرة وقعت بها\Nأثناء ارتكابك الجريمة
Dialogue: 0,0:17:20.82,0:17:22.04,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:22.77,0:17:25.82,Default,,0000,0000,0000,,يُفترض أنّك تعرف بما أنّك\Nكنت موجوداً في مسرح الجريمة
Dialogue: 0,0:17:25.82,0:17:29.08,Default,,0000,0000,0000,,أنّ التيّار انقطع لعشر دقائق\Nعند الحادية عشرة والنصف ليلاً
Dialogue: 0,0:17:30.43,0:17:34.26,Default,,0000,0000,0000,,!أجل! لن تعمل آلة الردّ دون كهرباء
Dialogue: 0,0:17:34.26,0:17:38.45,Default,,0000,0000,0000,,،تحافظ بطّاريتها الداخلية على عمل الساعة\Nلكن لا يمكنها تسجيل الرسائل
Dialogue: 0,0:17:39.05,0:17:43.91,Default,,0000,0000,0000,,مع ذلك، كيف وصلت رسالتك عند 11:34؟
Dialogue: 0,0:17:44.63,0:17:47.91,Default,,0000,0000,0000,,!لكن يمكنكم قول ذلك عن يوزو أيضاً
Dialogue: 0,0:17:47.91,0:17:51.62,Default,,0000,0000,0000,,فقد قال أنّه تلقّى اتصالاً\Nبعد الحادية عشرة والنصف
Dialogue: 0,0:17:52.04,0:17:54.04,Default,,0000,0000,0000,,أنت لا تعرف شيئاً حقّاً
Dialogue: 0,0:17:54.04,0:17:57.32,Default,,0000,0000,0000,,يمكنك إجراء مكالمات حتّى \Nأثناء انقطاع التيّار
Dialogue: 0,0:17:57.78,0:17:59.28,Default,,0000,0000,0000,,!مـ-ماذا؟
Dialogue: 0,0:17:59.28,0:18:04.79,Default,,0000,0000,0000,,هذا صحيح، تعمل سمّاعة الهاتف\Nعبر خطوط الهاتف
Dialogue: 0,0:18:05.15,0:18:09.47,Default,,0000,0000,0000,,!لا بدّ أنّ أحداً عبث بالزمن للإيقاع بي
Dialogue: 0,0:18:09.47,0:18:11.20,Default,,0000,0000,0000,,لا يمكن معرفة متى ستتصل
Dialogue: 0,0:18:11.56,0:18:16.16,Default,,0000,0000,0000,,يستحيل أن يُطابق أحد وقت اتّصالك\Nمع وقت وقوع الجريمة
Dialogue: 0,0:18:16.16,0:18:19.05,Default,,0000,0000,0000,,...أي أنّه بعد نهاية المباراة، تركت رسالةً
Dialogue: 0,0:18:19.05,0:18:23.41,Default,,0000,0000,0000,,على آلة الردّ التي قدّمت ساعتها سلفاً
Dialogue: 0,0:18:23.55,0:18:26.16,Default,,0000,0000,0000,,مُبارك على فوز فالكونز يا أبي
Dialogue: 0,0:18:26.66,0:18:30.37,Default,,0000,0000,0000,,وزيّفت إرسالها كما لو وصلت لحظة وقوع الجريمة
Dialogue: 0,0:18:30.70,0:18:35.58,Default,,0000,0000,0000,,،أرجعت الساعة للوقت الصحيح بعدها\Nوانتظرت عودة أبيك هنا
Dialogue: 0,0:18:36.19,0:18:39.98,Default,,0000,0000,0000,,فقد كان في طريقه من منزلنا\Nبعدما أتى لمشاهدة المباراة
Dialogue: 0,0:18:40.29,0:18:43.75,Default,,0000,0000,0000,,!وعندها قتلتَه
Dialogue: 0,0:18:43.85,0:18:48.52,Default,,0000,0000,0000,,لكن كيف لي أن أعرف متى\Nسيرجع بالضبط إذا كنت مختبئاً هنا؟
Dialogue: 0,0:18:48.52,0:18:53.02,Default,,0000,0000,0000,,كلا، كنتَ تعرف، فقد استعملت أداة تنصّت للاستماع
Dialogue: 0,0:18:53.02,0:18:54.12,Default,,0000,0000,0000,,!أ-أداة تنصّت؟
Dialogue: 0,0:18:56.01,0:19:01.91,Default,,0000,0000,0000,,دسستُ أدوات تنصّت في بيتكم؟\N!فلتفتشوه الآن إذاً، لن تجدوا شيئاً كذاك
Dialogue: 0,0:19:02.38,0:19:05.51,Default,,0000,0000,0000,,لم أقل أنّك دسستها في البيت
Dialogue: 0,0:19:05.51,0:19:09.62,Default,,0000,0000,0000,,أليس هناك شيئاً مفقوداً\Nبشكل غريب من الضحيّة؟
Dialogue: 0,0:19:09.62,0:19:11.33,Default,,0000,0000,0000,,!ساعة يده
Dialogue: 0,0:19:11.62,0:19:14.62,Default,,0000,0000,0000,,،فهمت! إذا زرع أداة تنصّت في الساعة
Dialogue: 0,0:19:14.62,0:19:18.07,Default,,0000,0000,0000,,!يمكنه تفقّد وضع الضحيّة كما المباراة
Dialogue: 0,0:19:18.82,0:19:22.61,Default,,0000,0000,0000,,خُلعت الساعة لإخفاء الدليل إذاً؟
Dialogue: 0,0:19:22.61,0:19:23.79,Default,,0000,0000,0000,,نعم، صحيح
Dialogue: 0,0:19:24.28,0:19:26.98,Default,,0000,0000,0000,,دسّ أداة التنصّت بالساعة
Dialogue: 0,0:19:26.98,0:19:33.00,Default,,0000,0000,0000,,ودمّر جهاز الاستقبال في منزلهم\Nكي يرغم الضحيّة على القدوم لمنزلنا لمشاهدة المباراة
Dialogue: 0,0:19:33.69,0:19:37.30,Default,,0000,0000,0000,,!هذه أشياء يمكنك فعلها بصفتك ابن الضحيّة
Dialogue: 0,0:19:38.47,0:19:42.66,Default,,0000,0000,0000,,استنتاج مُبهر، أكاد أرغب باستعماله في روايتي
Dialogue: 0,0:19:43.13,0:19:45.55,Default,,0000,0000,0000,,لكنّها ستكون رواية من الطراز الثالث
Dialogue: 0,0:19:45.55,0:19:50.37,Default,,0000,0000,0000,,ألديك دليل؟ دليل يثبت أنّي\Nعبثت بساعة آلة الردّ؟
Dialogue: 0,0:19:50.71,0:19:56.99,Default,,0000,0000,0000,,توقيتها مُطابق للحادثة، والرسالة من يوزو ظهيرة الأمس\Nتثبت أن الزمن سليم
Dialogue: 0,0:19:57.57,0:20:00.12,Default,,0000,0000,0000,,...تتفوّهين بادّعاءات كهذه دون دليل
Dialogue: 0,0:20:00.12,0:20:01.45,Default,,0000,0000,0000,,!لا تعبث معي
Dialogue: 0,0:20:01.82,0:20:06.52,Default,,0000,0000,0000,,الرسالة التي زيّفت وقتها على آلة الردّ\Nلصنع حجّة غياب
Dialogue: 0,0:20:06.52,0:20:10.37,Default,,0000,0000,0000,,!تنقلب لتثبت أنّك القاتل
Dialogue: 0,0:20:12.27,0:20:13.76,Default,,0000,0000,0000,,...أ-أخي
Dialogue: 0,0:20:13.76,0:20:14.46,Default,,0000,0000,0000,,!هذه كذبة
Dialogue: 0,0:20:14.46,0:20:17.34,Default,,0000,0000,0000,,!صحيح! لا بدّ من خطأ ما
Dialogue: 0,0:20:17.34,0:20:19.91,Default,,0000,0000,0000,,!فلا دافع ليقتل أخي تايتشي أبي
Dialogue: 0,0:20:20.22,0:20:25.62,Default,,0000,0000,0000,,توقّف يا يوزو، لستُ الأخ الصالح الذي تعتقدني
Dialogue: 0,0:20:25.92,0:20:29.33,Default,,0000,0000,0000,,المال، أردتُ إرث أبي
Dialogue: 0,0:20:29.33,0:20:31.08,Default,,0000,0000,0000,,كي أستطيع مواصلة الكتابة
Dialogue: 0,0:20:31.51,0:20:32.37,Default,,0000,0000,0000,,!أخي
Dialogue: 0,0:20:32.92,0:20:37.66,Default,,0000,0000,0000,,تدهورت أحوالي مؤخراً، قلّت كميّة عملي\N...وبدأ مالي ينفد
Dialogue: 0,0:20:37.66,0:20:41.94,Default,,0000,0000,0000,,...عندما ذهبتُ وقتها لأبي لأطلب مساعدته، أدركت
Dialogue: 0,0:20:42.60,0:20:47.82,Default,,0000,0000,0000,,أنّه كان يضغط على الناشر\N!ليمنع كلّ عمل يأتي لي
Dialogue: 0,0:20:48.90,0:20:54.15,Default,,0000,0000,0000,,يبدو أنّه أرادني أن أترك الكتابة\Nوأخلفه في عمله
Dialogue: 0,0:20:54.15,0:20:55.67,Default,,0000,0000,0000,,...لذا قتلته
Dialogue: 0,0:20:55.93,0:21:00.73,Default,,0000,0000,0000,,نعم، استغللتُ قدومه لمنزل العطلات هذا وقتلته
Dialogue: 0,0:21:01.30,0:21:07.57,Default,,0000,0000,0000,,لذلك أرسلتُ له ساعة اليد بأداة التنصّت\Nوحطّمت جهاز استقباله التلفزي سلفاً
Dialogue: 0,0:21:08.09,0:21:12.95,Default,,0000,0000,0000,,يوزو، كنتُ أنوي توجيه التهمة نحوك
Dialogue: 0,0:21:13.96,0:21:16.28,Default,,0000,0000,0000,,فذلك سيرفع حصّتي من الإرث
Dialogue: 0,0:21:17.45,0:21:21.03,Default,,0000,0000,0000,,كلّ ذلك كي أستطيع مواصلة\Nكتابة رواياتي التي أحبّها
Dialogue: 0,0:21:21.03,0:21:24.75,Default,,0000,0000,0000,,لكن يبدو أنّي كتبت رواية غموض \Nرديئة في نهاية المطاف
Dialogue: 0,0:21:25.66,0:21:28.03,Default,,0000,0000,0000,,لم يخطر ببالي أن ينقطع التيّار في تلك اللحظة
Dialogue: 0,0:21:29.94,0:21:33.01,Default,,0000,0000,0000,,يبدو أنّ الواقع يفوق خيال الروايات أحياناً
Dialogue: 0,0:21:34.86,0:21:38.60,Default,,0000,0000,0000,,لعلّي لم أكن أمتلك موهبة الروائيّ
Dialogue: 0,0:23:11.98,0:23:15.16,Default,,0000,0000,0000,,ما خطب سونوكو؟ إنّها شاردة الذهن
Dialogue: 0,0:23:15.16,0:23:18.93,Default,,0000,0000,0000,,أنا متأكد أنّه الارتياح من عدم \N!كون القاتل يوزو-سان فحسب
Dialogue: 0,0:23:21.27,0:23:23.90,Default,,0000,0000,0000,,تبّاً، إنّها تحدّق بذراعها
Dialogue: 0,0:23:23.90,0:23:26.85,Default,,0000,0000,0000,,لم تنتبه أنّي أصبتها بإبرة مخدّرة، صحيح؟
Dialogue: 0,0:23:27.80,0:23:29.06,Default,,0000,0000,0000,,...فشلت
Dialogue: 0,0:23:29.85,0:23:32.64,Default,,0000,0000,0000,,ما الذي تقولينه؟ كان استنتاجك مُذهلاً
Dialogue: 0,0:23:32.64,0:23:33.48,Default,,0000,0000,0000,,استنتاجي؟
Dialogue: 0,0:23:33.97,0:23:35.93,Default,,0000,0000,0000,,!انظري لذراعي
Dialogue: 0,0:23:35.93,0:23:37.31,Default,,0000,0000,0000,,!إنّها بيضاء تماماً
Dialogue: 0,0:23:38.55,0:23:43.10,Default,,0000,0000,0000,,كنتُ أنوي التسمّر وصيد الشباب\N!لكن خطّتي فشلت بالكامل
Dialogue: 0,0:23:44.96,0:23:48.09,Default,,0000,0000,0000,,!وجدتُها يا ران! لنذهب لصالون تسمير الآن
Dialogue: 0,0:23:48.53,0:23:52.66,Default,,0000,0000,0000,,لا يمكنكما، فعلينا الإدلاء بتصريحنا\Nفي مركز الشرطة الآن
Dialogue: 0,0:23:52.66,0:23:54.28,Default,,0000,0000,0000,,!لمَ ذلك؟
Dialogue: 0,0:23:55.45,0:23:57.28,Default,,0000,0000,0000,,يا للفتاة البسيطة
Dialogue: 0,0:24:02.44,0:24:03.50,Default,,0000,0000,0000,,...هـ-هذه
Dialogue: 0,0:24:04.00,0:24:05.29,Default,,0000,0000,0000,,!رسالة استغاثة
Dialogue: 0,0:24:10.13,0:24:13.60,Default,,0000,0000,0000,,!اخرجوا من القارب جميعاً! المدّ يرتفع
Dialogue: 0,0:24:14.37,0:24:17.28,Default,,0000,0000,0000,,!الموجات عالية جدّاً فلا نستطيع الخروج سباحةً
Dialogue: 0,0:24:18.05,0:24:20.83,Default,,0000,0000,0000,,!تبّاً، إنّها أشبه بالمتاهة
Dialogue: 0,0:24:21.20,0:24:24.04,Default,,0000,0000,0000,,!أيّها؟ أيّ طريق نسلكه؟
Dialogue: 0,0:24:24.04,0:24:30.03,On Top,,0000,0000,0000,,قضيّة كارثة فرقة فتيان التحرّي
Dialogue: 0,0:24:25.21,0:24:26.70,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.70,0:24:29.29,Default,,0000,0000,0000,,قضيّة كارثة فرقة فتيان التحرّي
Dialogue: 0,0:24:45.64,0:24:47.37,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.65,0:24:49.51,Default,,0000,0000,0000,,أمواج مدّ وجزر
Dialogue: 0,0:24:50.03,0:24:52.13,Default,,0000,0000,0000,,!الحلقة القادمة ظهور لفرقة فتيان التحرّي
Dialogue: 0,0:24:52.13,0:24:52.57,Default,,0000,0000,0000,,!أنا آيومي
Dialogue: 0,0:24:52.57,0:24:53.11,Default,,0000,0000,0000,,!أنا غينتا
Dialogue: 0,0:24:53.11,0:24:53.80,Default,,0000,0000,0000,,!أنا ميتسوهيكو
Dialogue: 0,0:24:53.80,0:24:55.79,Default,,0000,0000,0000,,كلا، كلا

