Dialogue: 0,0:00:00.86,0:00:02.51,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.51,0:00:05.63,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.63,0:00:08.43,Default,,0000,0000,0000,,إن عرفت المنظمة أنّ شينتشي وكونان\Nهما الشخص نفسه
Dialogue: 0,0:00:08.43,0:00:10.39,Default,,0000,0000,0000,,!سيقع جميع من حولي في خطر
Dialogue: 0,0:00:10.39,0:00:12.60,Default,,0000,0000,0000,,البروفسور آغاسا وحده من يعرف الحقيقة
Dialogue: 0,0:00:12.60,0:00:15.51,Default,,0000,0000,0000,,!هويّتي مخفية، وهناك حقيقة واحدة دوماً
Dialogue: 0,0:01:47.00,0:01:50.86,Default,,0000,0000,0000,,جريمة قتل الحاسوب
Dialogue: 0,0:01:57.62,0:01:59.79,Default,,0000,0000,0000,,كان فيلماً ممتعاً، صحيح يا كونان-كن؟
Dialogue: 0,0:01:59.79,0:02:00.28,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:00.99,0:02:03.57,Default,,0000,0000,0000,,أشعر بالجوع يا أبي
Dialogue: 0,0:02:03.57,0:02:05.86,Default,,0000,0000,0000,,تأخّر الوقت بالفعل
Dialogue: 0,0:02:05.86,0:02:07.74,Default,,0000,0000,0000,,لنأكل في مكانٍ ما
Dialogue: 0,0:02:08.19,0:02:09.99,Default,,0000,0000,0000,,!لنذهب هناك إذاً
Dialogue: 0,0:02:11.45,0:02:13.26,Default,,0000,0000,0000,,!أأنت أحمق؟
Dialogue: 0,0:02:13.26,0:02:18.51,Default,,0000,0000,0000,,!سأضطر للدفع بأعضائي لآكل سوشي في غينزا
Dialogue: 0,0:02:18.51,0:02:21.03,Default,,0000,0000,0000,,!شكراً جزيلاً! عاودوا الزيارة
Dialogue: 0,0:02:22.75,0:02:25.46,Default,,0000,0000,0000,,كان الساكي لذيذاً الليلة
Dialogue: 0,0:02:25.46,0:02:27.63,Default,,0000,0000,0000,,تناول دواءك رجاءً سيّدي
Dialogue: 0,0:02:27.63,0:02:29.20,Default,,0000,0000,0000,,وإلّا قد يتدهور قلبك مُجدداً
Dialogue: 0,0:02:29.59,0:02:32.70,Default,,0000,0000,0000,,!أعرف! لا تتكلم كزوجتي
Dialogue: 0,0:02:42.66,0:02:44.53,Default,,0000,0000,0000,,يبدو أنّه رئيس شركةٍ ما
Dialogue: 0,0:02:44.53,0:02:47.32,Default,,0000,0000,0000,,أجل، رأيتُه قبلاً في مجلة
Dialogue: 0,0:02:48.07,0:02:51.03,Default,,0000,0000,0000,,!صحيح! إنّه رئيس بيغوود، أوكيدا
Dialogue: 0,0:02:51.36,0:02:54.49,Default,,0000,0000,0000,,بيغوود؟ شركة برامج الحاسوب؟
Dialogue: 0,0:02:54.89,0:02:57.16,Default,,0000,0000,0000,,كان عقد اليوم كبيراً
Dialogue: 0,0:02:57.52,0:03:03.11,Default,,0000,0000,0000,,وهذا بفضل البرنامج الذي أعطيتني\Nإيّاه قبل عام
Dialogue: 0,0:03:03.11,0:03:04.94,Default,,0000,0000,0000,,عليّ شكرك حقاً
Dialogue: 0,0:03:11.71,0:03:12.61,Default,,0000,0000,0000,,!انتظروا
Dialogue: 0,0:03:15.83,0:03:17.54,Default,,0000,0000,0000,,أسقطت هذا
Dialogue: 0,0:03:17.54,0:03:19.31,Default,,0000,0000,0000,,شكراً لك يا فتى
Dialogue: 0,0:03:21.20,0:03:24.19,Default,,0000,0000,0000,,!توكيتو! لمَ لم تنتبه؟
Dialogue: 0,0:03:24.78,0:03:27.53,Default,,0000,0000,0000,,!آسف! أعتذر سيّدي
Dialogue: 0,0:03:30.49,0:03:34.14,Default,,0000,0000,0000,,عليّ شكرك بشكلٍ ما، ما الذي تريده يا فتى؟
Dialogue: 0,0:03:34.14,0:03:37.89,Default,,0000,0000,0000,,المعذرة، أنت السيّد أوكيدا رئيس بيغوود، صحيح؟
Dialogue: 0,0:03:37.89,0:03:39.74,Default,,0000,0000,0000,,!هذا أنا
Dialogue: 0,0:03:41.48,0:03:43.44,Default,,0000,0000,0000,,...المتحرّي الخاص موري كوغورو
Dialogue: 0,0:03:45.49,0:03:47.84,Default,,0000,0000,0000,,أجل! لا نحتاج شيئاً بالمقابل
Dialogue: 0,0:03:47.84,0:03:50.45,Default,,0000,0000,0000,,فقط تواصل معي إن كنت بحاجة لأيّ خدمات
Dialogue: 0,0:03:51.72,0:03:53.58,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:03:53.58,0:03:55.61,Default,,0000,0000,0000,,سأغادر الآن
Dialogue: 0,0:03:56.96,0:03:58.32,Default,,0000,0000,0000,,!رافقتكم السلامة
Dialogue: 0,0:03:59.33,0:04:01.79,Default,,0000,0000,0000,,مُتحرٍّ خاص؟
Dialogue: 0,0:04:02.33,0:04:05.24,Default,,0000,0000,0000,,!حسنٌ، سأشرب حتى الثمالة الليلة
Dialogue: 0,0:04:13.11,0:04:14.57,On Top,,0000,0000,0000,,أوكيدا
Dialogue: 0,0:04:51.28,0:04:53.82,Default,,0000,0000,0000,,أجل، وكالة موري للتحرّي
Dialogue: 0,0:04:54.19,0:04:58.27,Default,,0000,0000,0000,,مفتّش ميغوري! صباح الخير
Dialogue: 0,0:04:58.27,0:04:59.87,Default,,0000,0000,0000,,!مات الرئيس أوكيدا؟
Dialogue: 0,0:05:03.59,0:05:07.59,Default,,0000,0000,0000,,رأى المفتّش ميغوري بطاقتك في جيب
Dialogue: 0,0:05:07.59,0:05:09.53,Default,,0000,0000,0000,,...معطف السيّد أوكيدا إذاً
Dialogue: 0,0:05:09.97,0:05:12.99,Default,,0000,0000,0000,,أجل، واتّصل بي من باب الحيطة
Dialogue: 0,0:05:13.38,0:05:15.63,Default,,0000,0000,0000,,إن كان المفتّش هناك
Dialogue: 0,0:05:15.63,0:05:17.45,Default,,0000,0000,0000,,أيعني ذلك أنّ أحدهم قُتل؟
Dialogue: 0,0:05:17.45,0:05:22.13,Default,,0000,0000,0000,,تحقق الشرطة أحياناً في حالات الموت غير الطبيعية
Dialogue: 0,0:05:22.13,0:05:24.36,Default,,0000,0000,0000,,فقد كان السيّد أوكيدا شخصاً رفيع المقام
Dialogue: 0,0:05:36.02,0:05:38.87,Default,,0000,0000,0000,,...لحظة، كنتَ مع السيّد أوكيدا البارحة
Dialogue: 0,0:05:39.81,0:05:41.24,Default,,0000,0000,0000,,أنا سكرتيره ميورا
Dialogue: 0,0:05:41.24,0:05:41.83,Default,,0000,0000,0000,,!سيّدي
Dialogue: 0,0:05:46.67,0:05:47.95,Default,,0000,0000,0000,,!فُتح من تلقاء نفسه
Dialogue: 0,0:05:48.45,0:05:51.70,Default,,0000,0000,0000,,!كيف فعلتَ ذلك؟ كان مذهلاً
Dialogue: 0,0:05:52.29,0:05:55.90,Default,,0000,0000,0000,,تحقّق الحاسوب من بصماتي ثمّ فتح الباب
Dialogue: 0,0:05:55.90,0:05:57.61,Default,,0000,0000,0000,,الحاسوب؟
Dialogue: 0,0:05:58.14,0:06:01.14,Default,,0000,0000,0000,,هذا منزلٌ حديث التقنية
Dialogue: 0,0:06:01.14,0:06:05.42,Default,,0000,0000,0000,,كلّ ما فيه تقريباً تحت تحكم الحاسوب
Dialogue: 0,0:06:15.37,0:06:17.20,Default,,0000,0000,0000,,المكان بارد هنا
Dialogue: 0,0:06:17.20,0:06:21.28,Default,,0000,0000,0000,,التبريد مُبرمج بحيث تبقى درجة حرارة المكان مريحة
Dialogue: 0,0:06:21.28,0:06:24.36,Default,,0000,0000,0000,,على مدى 24 ساعة
Dialogue: 0,0:06:25.06,0:06:27.66,Default,,0000,0000,0000,,موري-كن! شكراً على قدومك
Dialogue: 0,0:06:27.66,0:06:28.23,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:28.23,0:06:29.48,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:06:29.48,0:06:32.86,Default,,0000,0000,0000,,...آسف، أخبرتهما بالبقاء في البيت لكن
Dialogue: 0,0:06:33.14,0:06:35.82,Default,,0000,0000,0000,,رأينا أوكيدا-سان البارحة أيضاً
Dialogue: 0,0:06:36.05,0:06:40.22,Default,,0000,0000,0000,,مفتّش ميغوري، هذا سكرتيره ميورا-سان
Dialogue: 0,0:06:40.22,0:06:41.79,Default,,0000,0000,0000,,شكراً على قدومك
Dialogue: 0,0:06:42.22,0:06:45.54,Default,,0000,0000,0000,,كان السيّد توكيتو من اكتشف الجثّة
Dialogue: 0,0:06:45.54,0:06:48.46,Default,,0000,0000,0000,,أتى ليقلّ السيّد أوكيدا عند الثامنة
Dialogue: 0,0:06:48.46,0:06:53.83,Default,,0000,0000,0000,,لكنّه لم يخرج، فشكّ بحصول شيء ودخل
Dialogue: 0,0:06:53.83,0:06:57.82,Default,,0000,0000,0000,,ووجد جثّته الباردة على السرير بلباس النوم
Dialogue: 0,0:06:57.82,0:07:00.91,Default,,0000,0000,0000,,ما كان سبب الموت؟
Dialogue: 0,0:07:00.91,0:07:04.52,Default,,0000,0000,0000,,لا يمكننا الجزم دون تشريحٍ كامل
Dialogue: 0,0:07:04.52,0:07:06.82,Default,,0000,0000,0000,,لكنّه كان موتاً فجائياً لنوبة قلبية غالباً
Dialogue: 0,0:07:06.82,0:07:08.28,Default,,0000,0000,0000,,!موت فجائي؟
Dialogue: 0,0:07:08.28,0:07:13.39,Default,,0000,0000,0000,,كانت مشاكله القلبية تلازمه وفقاً لطبيبه
Dialogue: 0,0:07:13.39,0:07:16.49,Default,,0000,0000,0000,,وشرب كميةً كبيرة من الساكي البارحة علاوةً على ذلك
Dialogue: 0,0:07:16.49,0:07:20.93,Default,,0000,0000,0000,,كان يوم الأمس مهماً بما أنّه\Nحصل على عقدٍ مهم
Dialogue: 0,0:07:20.93,0:07:24.96,Default,,0000,0000,0000,,...أوصته زوجته بألّا يشرب خمراً، لكن
Dialogue: 0,0:07:24.96,0:07:27.20,Default,,0000,0000,0000,,أين زوجته بالمناسبة؟
Dialogue: 0,0:07:27.20,0:07:31.79,Default,,0000,0000,0000,,غادرت مع ابنتهما في رحلة خارج البلد مساء الأمس
Dialogue: 0,0:07:31.79,0:07:35.95,Default,,0000,0000,0000,,ذهب لعددٍ من أندية المُشترين البارحة
Dialogue: 0,0:07:35.95,0:07:41.08,Default,,0000,0000,0000,,وعندما عاد للبيت كان ثملاً\Nبحيث لم يستطع المشي
Dialogue: 0,0:07:41.08,0:07:45.45,Default,,0000,0000,0000,,فاصطحبته لغرفة النوم ووضعته على الفراش
Dialogue: 0,0:07:46.15,0:07:49.98,Default,,0000,0000,0000,,وقت الوفاة المقدّر كان قرابة الثانية\Nبعد منتصف الليل
Dialogue: 0,0:07:49.98,0:07:53.61,Default,,0000,0000,0000,,سأسأل من باب الحيطة، أين كنت في ذاك الوقت؟
Dialogue: 0,0:07:54.18,0:07:57.30,Default,,0000,0000,0000,,عُدت لشقّتي بعد الواحدة
Dialogue: 0,0:07:57.30,0:08:01.72,Default,,0000,0000,0000,,واشتريتُ عشاءً عند الثانية من متجرٍ قريب
Dialogue: 0,0:08:01.72,0:08:07.57,Default,,0000,0000,0000,,أسقطتُ البيض عند المُحاسب، لذا لعلّه يمكن أن يشهد لي
Dialogue: 0,0:08:13.83,0:08:17.16,Default,,0000,0000,0000,,يا لظرافته! إنّه هيمالاني
Dialogue: 0,0:08:17.16,0:08:21.66,Default,,0000,0000,0000,,يُدعى أسلان، إنّه قطّ الابنة
Dialogue: 0,0:08:25.48,0:08:28.36,Default,,0000,0000,0000,,يبدو جائعاً، سأذهب لإطعامه
Dialogue: 0,0:08:33.18,0:08:35.97,Default,,0000,0000,0000,,حضرة المفتش، أريد تفقد الجثّة بنفسي
Dialogue: 0,0:08:35.97,0:08:38.70,Default,,0000,0000,0000,,لا أمانع، لكن لا يمكنكما الدخول
Dialogue: 0,0:08:39.18,0:08:41.16,Default,,0000,0000,0000,,سأمتنع حتى لو طلبت مني النظر
Dialogue: 0,0:08:43.50,0:08:44.82,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:08:45.71,0:08:50.63,Default,,0000,0000,0000,,لا إصابات خارجية، أو أيّ آثار لعقاقير
Dialogue: 0,0:08:50.63,0:08:54.27,Default,,0000,0000,0000,,لكن لمَ تعرّق لهذا الحد؟
Dialogue: 0,0:08:54.70,0:08:56.95,Default,,0000,0000,0000,,انظروا لهذا البلل
Dialogue: 0,0:08:56.95,0:08:58.49,Default,,0000,0000,0000,,الغطاء أيضاً
Dialogue: 0,0:08:58.49,0:09:01.91,Default,,0000,0000,0000,,يوجد عرقٌ كثير بالنسبة لشخصٍ مات بنوبة
Dialogue: 0,0:09:01.91,0:09:03.65,Default,,0000,0000,0000,,!متى دخلت؟
Dialogue: 0,0:09:04.65,0:09:07.32,Default,,0000,0000,0000,,جهاز التبريد تحت تحكم الحاسوب\Nفي هذا المنزل
Dialogue: 0,0:09:07.32,0:09:10.73,Default,,0000,0000,0000,,فتُعدّل الحرارة لتكون مناسبة دوماً، صحيح؟
Dialogue: 0,0:09:10.73,0:09:12.86,Default,,0000,0000,0000,,فلمَ إذاً؟
Dialogue: 0,0:09:13.56,0:09:15.86,Default,,0000,0000,0000,,!أخبرناك ألّا تقترب
Dialogue: 0,0:09:16.60,0:09:17.61,Default,,0000,0000,0000,,!اخرج
Dialogue: 0,0:09:25.77,0:09:26.36,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:28.74,0:09:30.47,Default,,0000,0000,0000,,الأزهار ذبلت
Dialogue: 0,0:09:38.82,0:09:40.60,Default,,0000,0000,0000,,إيصال متجر الأزهار
Dialogue: 0,0:09:42.17,0:09:44.02,Default,,0000,0000,0000,,من الأمس
Dialogue: 0,0:09:44.02,0:09:46.32,Default,,0000,0000,0000,,اشترتها زوجته قبل سفرها غالباً
Dialogue: 0,0:09:47.35,0:09:51.54,Default,,0000,0000,0000,,مضى أقلّ من يوم، فلمَ ذبلت لهذا الحد؟
Dialogue: 0,0:09:56.01,0:09:58.59,Default,,0000,0000,0000,,...ذابت الشوكولاته وتكتّلت
Dialogue: 0,0:10:04.50,0:10:07.00,Default,,0000,0000,0000,,أتحب القطط يا فتى؟
Dialogue: 0,0:10:07.00,0:10:07.61,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:10:08.07,0:10:11.78,Default,,0000,0000,0000,,أخبرني، كان السيّد أوكيدا معجباً بـ توكيتو-سان، صحيح؟
Dialogue: 0,0:10:11.78,0:10:13.69,Default,,0000,0000,0000,,فقد جعله سائقه الشخصيّ مع صغر سنّه
Dialogue: 0,0:10:14.90,0:10:17.78,Default,,0000,0000,0000,,كلا، إنّه مُبرمج في الواقع
Dialogue: 0,0:10:19.11,0:10:22.68,Default,,0000,0000,0000,,كان يعمل مُبرمجاً في الأصل في شركتنا
Dialogue: 0,0:10:22.68,0:10:26.80,Default,,0000,0000,0000,,،فتح مع صديقٍ له شركة برمجيات قبل عامين
Dialogue: 0,0:10:26.80,0:10:28.65,Default,,0000,0000,0000,,...لكنها لم تنجح
Dialogue: 0,0:10:29.14,0:10:32.79,Default,,0000,0000,0000,,وأفلس بعد عام كما هو مُتوقع
Dialogue: 0,0:10:32.79,0:10:36.71,Default,,0000,0000,0000,,عاد على ركبتيه مُعتذراً للرئيس قبل 6 أشهر
Dialogue: 0,0:10:36.71,0:10:40.57,Default,,0000,0000,0000,,وتوسّل طالباً عملاً آخر، ولو مجرّد سائق
Dialogue: 0,0:10:41.17,0:10:44.02,Default,,0000,0000,0000,,عندها جعله الرئيس سائقه الشخصيّ؟
Dialogue: 0,0:10:44.45,0:10:48.49,Default,,0000,0000,0000,,أجل، فقد كان رجلاً عطوفاً
Dialogue: 0,0:10:48.91,0:10:50.58,Default,,0000,0000,0000,,!صحيح! يُفترض ألّا أكون هنا
Dialogue: 0,0:10:50.58,0:10:53.94,Default,,0000,0000,0000,,!عليّ العودة للشركة وإعلام المسؤولين
Dialogue: 0,0:10:54.40,0:10:59.02,Default,,0000,0000,0000,,كلا، لم يعيّن السيّد أوكيدا توكيتو-سان سائقاً له
Dialogue: 0,0:10:59.02,0:11:01.23,Default,,0000,0000,0000,,من خير قلبه أبداً
Dialogue: 0,0:11:01.23,0:11:03.94,Default,,0000,0000,0000,,بل كان يجعله مثالاً لبقية الموظّفين
Dialogue: 0,0:11:03.94,0:11:06.85,Default,,0000,0000,0000,,...إن كان عطوفاً حقاً
Dialogue: 0,0:11:06.85,0:11:10.60,Default,,0000,0000,0000,,!توكيتو! لمَ لم تكن تنتبه؟
Dialogue: 0,0:11:10.60,0:11:13.48,Default,,0000,0000,0000,,لم يكن ليصرخ عليه في العامة هكذا
Dialogue: 0,0:11:14.25,0:11:15.63,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:11:15.63,0:11:18.21,Default,,0000,0000,0000,,أخبرني، ما الذي تحدثتِ بشأنه مع توكيتو-سان؟
Dialogue: 0,0:11:18.21,0:11:20.03,Default,,0000,0000,0000,,بدوتما مُستمتعين
Dialogue: 0,0:11:20.96,0:11:22.54,Default,,0000,0000,0000,,عن أسلان
Dialogue: 0,0:11:22.54,0:11:25.08,Default,,0000,0000,0000,,قال أنّ القطط كثيرة الشعر لا تطيق الحرارة
Dialogue: 0,0:11:25.08,0:11:28.49,Default,,0000,0000,0000,,فتحتاج غرفاً مُبردة للعيش
Dialogue: 0,0:11:30.08,0:11:31.87,Default,,0000,0000,0000,,ذلك شاق
Dialogue: 0,0:11:31.87,0:11:35.40,Default,,0000,0000,0000,,مما يعني إن كانت الحرارة شديدةً\N،بحيث ذابت الشوكولاته
Dialogue: 0,0:11:35.40,0:11:38.49,Default,,0000,0000,0000,,فلا بدّ أن ذاك القط تأثر أيضاً
Dialogue: 0,0:11:38.49,0:11:41.94,Default,,0000,0000,0000,,لكن مما رأيتُه لم يكن هناك أي آثار عليه
Dialogue: 0,0:11:45.10,0:11:47.61,Default,,0000,0000,0000,,!سأذهب للكلام مع توكيتو-سان
Dialogue: 0,0:11:48.97,0:11:52.28,Default,,0000,0000,0000,,سمعتُ أنّك مبرمج في الواقع يا توكيتو-سان
Dialogue: 0,0:11:52.76,0:11:54.80,Default,,0000,0000,0000,,سمعت أنك استقلت قبل عامين
Dialogue: 0,0:11:54.80,0:11:58.63,Default,,0000,0000,0000,,وفتحت شركة برمجيات مع صديقٍ لك
Dialogue: 0,0:11:58.63,0:12:03.23,Default,,0000,0000,0000,,!أريد برمجة ألعاب حاسوب عندما أكبر أيضاً
Dialogue: 0,0:12:03.62,0:12:05.45,Default,,0000,0000,0000,,هكذا إذاً؟
Dialogue: 0,0:12:05.45,0:12:09.20,Default,,0000,0000,0000,,لكنّي أصنع برامج أعمال وليس ألعاب
Dialogue: 0,0:12:10.91,0:12:12.78,Default,,0000,0000,0000,,لا بدّ أن إدارة شركة أمرٌ صعب
Dialogue: 0,0:12:12.78,0:12:14.65,Default,,0000,0000,0000,,فقد أفلست بعد عام، صحيح؟
Dialogue: 0,0:12:15.19,0:12:18.11,Default,,0000,0000,0000,,كانت الأمور على خير ما يرام بدايةً
Dialogue: 0,0:12:18.11,0:12:21.61,Default,,0000,0000,0000,,...لكن اعترض شخصٌ ما طريقنا
Dialogue: 0,0:12:21.61,0:12:26.57,Default,,0000,0000,0000,,!ثمّ... دفع صديقي للانتحار
Dialogue: 0,0:12:27.10,0:12:30.28,Default,,0000,0000,0000,,أيمكن أنّ ذاك الشخص هو الرئيس أوكيدا؟
Dialogue: 0,0:12:34.13,0:12:36.47,Default,,0000,0000,0000,,تحصل مختلف الأمور في عالم البالغين
Dialogue: 0,0:12:36.47,0:12:38.53,Default,,0000,0000,0000,,انسَ ما قلتُه
Dialogue: 0,0:12:40.22,0:12:45.54,Default,,0000,0000,0000,,لا شكّ أن توكيتو-سان كان حاقداً\Nعلى الرئيس أوكيدا ما يكفي لقتله
Dialogue: 0,0:12:45.54,0:12:49.86,Default,,0000,0000,0000,,ربما توسّل للعودة للشركة كي يأخذ بثأره
Dialogue: 0,0:12:53.28,0:12:59.07,Default,,0000,0000,0000,,إن كانت نوبة الرئيس أوكيدا القلبية\N،من تأثير شخص عمداً
Dialogue: 0,0:12:59.07,0:13:01.99,Default,,0000,0000,0000,,فالمتّهم الأوّل هو توكيتو-سان
Dialogue: 0,0:13:01.99,0:13:05.25,Default,,0000,0000,0000,,لكن كيف نفّذ جريمته بالضبط؟
Dialogue: 0,0:13:10.92,0:13:12.94,Default,,0000,0000,0000,,اختراق حاسوب؟
Dialogue: 0,0:13:12.94,0:13:13.59,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:13.59,0:13:17.49,Default,,0000,0000,0000,,من الممكن لحاسوب منزليّ مربوط بخطّ هاتفي
Dialogue: 0,0:13:17.49,0:13:20.24,Default,,0000,0000,0000,,أن يخترق نظام حاسوب منزليّ آخر
Dialogue: 0,0:13:20.24,0:13:23.99,Default,,0000,0000,0000,,ويغير برمجة جهاز التبريد، صحيح؟
Dialogue: 0,0:13:23.99,0:13:25.49,Default,,0000,0000,0000,,هذا ممكن
Dialogue: 0,0:13:25.49,0:13:27.90,Default,,0000,0000,0000,,لشخصٍ مُلم بالمجال تحديداً
Dialogue: 0,0:13:35.07,0:13:39.57,Default,,0000,0000,0000,,توكيتو-سان مُبرمج من الطراز الأوّل\Nفلا نقص في معرفته بالتأكيد
Dialogue: 0,0:13:39.57,0:13:44.03,Default,,0000,0000,0000,,...لكن مجرد رفع درجة الحرارة لا يكفي لقتله
Dialogue: 0,0:13:44.72,0:13:46.89,Default,,0000,0000,0000,,!ما هذا؟
Dialogue: 0,0:13:46.89,0:13:50.77,Default,,0000,0000,0000,,كنتُ آكل مثلجات قبل قليل، ربما سقطت مني
Dialogue: 0,0:13:51.09,0:13:55.55,Default,,0000,0000,0000,,يا إلهي، يا لإهمالك! عليّ تغيير جواربي
Dialogue: 0,0:13:58.12,0:14:01.26,Default,,0000,0000,0000,,أليست هذه الغرفة حارة قليلاً؟
Dialogue: 0,0:14:01.26,0:14:02.73,Default,,0000,0000,0000,,ارفع درجة التبريد
Dialogue: 0,0:14:03.06,0:14:05.42,Default,,0000,0000,0000,,كلا، هذه مناسبة
Dialogue: 0,0:14:05.42,0:14:07.90,Default,,0000,0000,0000,,أنت صغير السنّ فقد لا تتأثر
Dialogue: 0,0:14:07.90,0:14:11.40,Default,,0000,0000,0000,,لكن يُفضّل ألا تبرد الغرف نسبةً بالحرارة الخارجية
Dialogue: 0,0:14:11.40,0:14:14.40,Default,,0000,0000,0000,,قرأتُ في مقالة عن إصابة شخص بنوبة قلبية
Dialogue: 0,0:14:14.40,0:14:18.77,Default,,0000,0000,0000,,عندما دخل مقهى بدرجة تبريد عالية
Dialogue: 0,0:14:19.35,0:14:20.73,Default,,0000,0000,0000,,!نوبة قلبية؟
Dialogue: 0,0:14:20.73,0:14:25.20,Default,,0000,0000,0000,,ربما بسبب الانخفاض المفاجئ في الحرارة
Dialogue: 0,0:14:25.62,0:14:27.22,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:14:27.22,0:14:29.38,Default,,0000,0000,0000,,رفع توكيتو-سان درجة حرارة الغرفة
Dialogue: 0,0:14:29.38,0:14:32.61,Default,,0000,0000,0000,,!ثمّ خفّضها فجأةً فسبّب نوبة قلبية
Dialogue: 0,0:14:33.81,0:14:36.66,Default,,0000,0000,0000,,لكن سيصعب إثبات ذلك
Dialogue: 0,0:14:36.66,0:14:39.86,Default,,0000,0000,0000,,ربما إن كان البرنامج في منزل ذاك الشخص
Dialogue: 0,0:14:39.86,0:14:42.57,Default,,0000,0000,0000,,لكن أشكّ أنه يحتفظ به
Dialogue: 0,0:14:43.06,0:14:46.61,Default,,0000,0000,0000,,أجل، عليّ التحقق بنفسي
Dialogue: 0,0:14:46.61,0:14:50.35,Default,,0000,0000,0000,,هناك ما أريد أن تصنعه لي يا بروفسور
Dialogue: 0,0:14:50.35,0:14:51.53,Default,,0000,0000,0000,,لديك فكرة؟
Dialogue: 0,0:14:54.79,0:14:55.61,Default,,0000,0000,0000,,هاك عصيراً
Dialogue: 0,0:14:55.61,0:14:57.25,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:14:57.25,0:14:58.92,Default,,0000,0000,0000,,فاجأتني فعلاً
Dialogue: 0,0:14:58.92,0:15:01.79,Default,,0000,0000,0000,,لم يطلب أحد رؤية حاسوبي من قبل
Dialogue: 0,0:15:01.79,0:15:02.78,Default,,0000,0000,0000,,أيمكنني رؤيته قليلاً؟
Dialogue: 0,0:15:03.40,0:15:05.99,Default,,0000,0000,0000,,ماذا؟ ما هذا؟
Dialogue: 0,0:15:06.67,0:15:09.94,Default,,0000,0000,0000,,ما هذه الرقاقة؟
Dialogue: 0,0:15:10.45,0:15:11.65,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:15:11.65,0:15:14.12,Default,,0000,0000,0000,,كلا، لا شيء
Dialogue: 0,0:15:14.12,0:15:17.98,Default,,0000,0000,0000,,هذا الحاسوب رائعٌ جدّاً! أتمنى لو امتلكتُ واحداً
Dialogue: 0,0:15:18.57,0:15:21.48,Default,,0000,0000,0000,,لا يزال باكراً عليك قليلاً
Dialogue: 0,0:15:21.48,0:15:24.90,Default,,0000,0000,0000,,أتريد لعب بعض ألعاب الحاسوب بما أنّك هنا؟
Dialogue: 0,0:15:28.97,0:15:31.68,Default,,0000,0000,0000,,أليست هذه سيّارتك؟
Dialogue: 0,0:15:31.68,0:15:35.39,Default,,0000,0000,0000,,إنّها تخصّ الشركة، لكن جهاز إنذارها أُطلق
Dialogue: 0,0:15:35.39,0:15:36.70,Default,,0000,0000,0000,,سأذهب للتفقد
Dialogue: 0,0:15:48.19,0:15:50.90,Default,,0000,0000,0000,,افتح! افتح! كلا؟
Dialogue: 0,0:15:56.37,0:15:58.45,Default,,0000,0000,0000,,من وضع هذا هنا؟
Dialogue: 0,0:15:59.79,0:16:01.40,Default,,0000,0000,0000,,!أكان ذاك الفتى؟
Dialogue: 0,0:16:08.11,0:16:11.32,Default,,0000,0000,0000,,لا فائدة، لا بيانات هنا
Dialogue: 0,0:16:25.74,0:16:28.42,Default,,0000,0000,0000,,كنتُ ألعب البوكر مع الحاسوب
Dialogue: 0,0:16:28.42,0:16:30.27,Default,,0000,0000,0000,,!فزتُ بزوجٍ واحد فحسب
Dialogue: 0,0:16:30.76,0:16:32.58,Default,,0000,0000,0000,,أنتَ بارع يا كونان-كن
Dialogue: 0,0:16:33.56,0:16:35.62,Default,,0000,0000,0000,,ربما أفرطتُ في التفكير
Dialogue: 0,0:16:35.62,0:16:37.69,Default,,0000,0000,0000,,كان مقلباً من أحدهم وحسب
Dialogue: 0,0:16:40.61,0:16:43.34,Default,,0000,0000,0000,,كيف جرى الأمر يا شينتشي؟
Dialogue: 0,0:16:43.34,0:16:46.45,Default,,0000,0000,0000,,أفترض أنّك لم تجد البرنامج من ملامحك
Dialogue: 0,0:16:46.45,0:16:48.30,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:16:48.30,0:16:52.70,Default,,0000,0000,0000,,كلّ ما عرفته هو كيف أغلب الحاسوب في البوكر
Dialogue: 0,0:16:52.70,0:16:53.97,Default,,0000,0000,0000,,...لا أدري ما العمل الآن
Dialogue: 0,0:16:56.98,0:16:58.78,Default,,0000,0000,0000,,شعرة قطّ
Dialogue: 0,0:16:58.78,0:17:03.47,Default,,0000,0000,0000,,لعلّها علقت بي من أسلان\Nفي منزل الرئيس أوكيدا هذا الصباح
Dialogue: 0,0:17:03.47,0:17:06.98,Default,,0000,0000,0000,,صحيح، نسيتُ أمره
Dialogue: 0,0:17:06.98,0:17:12.15,Default,,0000,0000,0000,,أسلان قطّ كثيف الشعر، فسيتأثر إن ارتفعت درجة حرارة الغرفة
Dialogue: 0,0:17:12.84,0:17:16.07,Default,,0000,0000,0000,,لن أستطيع التفكير بنظرية حتى أحلّ هذا اللغز
Dialogue: 0,0:17:16.59,0:17:21.21,Default,,0000,0000,0000,,!لحظة، غيّرتُ جواربي قبلاً
Dialogue: 0,0:17:21.21,0:17:25.67,Default,,0000,0000,0000,,...ما يعني أنّ هذه الشعرة من شقّة توكيتو-سان
Dialogue: 0,0:17:25.67,0:17:27.15,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:17:27.15,0:17:29.52,Default,,0000,0000,0000,,...مما يعني أنّ تلك الرقاقة كانت
Dialogue: 0,0:17:31.15,0:17:33.06,Default,,0000,0000,0000,,ميغوري معك
Dialogue: 0,0:17:33.06,0:17:35.04,Default,,0000,0000,0000,,يسرّني سماع صوتك مجدّداً سيّدي المفتش
Dialogue: 0,0:17:35.04,0:17:36.26,Default,,0000,0000,0000,,أنا كودو شينتشي
Dialogue: 0,0:17:36.26,0:17:38.10,Default,,0000,0000,0000,,!كودو-كن
Dialogue: 0,0:17:38.10,0:17:40.94,Default,,0000,0000,0000,,هناك أمرٌ عاجل أريدك أن تتحرى فيه
Dialogue: 0,0:17:40.94,0:17:43.82,Default,,0000,0000,0000,,بشأن موت الرئيس أوكيدا المُفاجئ
Dialogue: 0,0:17:46.41,0:17:49.73,Default,,0000,0000,0000,,السائق السيّد توكيتو؟ فهمت
Dialogue: 0,0:17:50.11,0:17:52.58,Default,,0000,0000,0000,,اصطحب كونان-كن وران معك رجاءً
Dialogue: 0,0:17:52.58,0:17:55.20,Default,,0000,0000,0000,,سيفيدانك حتماً
Dialogue: 0,0:17:55.20,0:17:56.45,Default,,0000,0000,0000,,إلى اللقاء
Dialogue: 0,0:17:58.12,0:18:02.97,Default,,0000,0000,0000,,لمَ عليّ استعمال مغيّر الصوت\Nلتزييف صوتي الحقيقي؟
Dialogue: 0,0:18:02.97,0:18:04.40,Default,,0000,0000,0000,,...بائس
Dialogue: 0,0:18:08.06,0:18:10.85,Default,,0000,0000,0000,,صباح الخير! نعتذر على إزعاجك في هذا الوقت الباكر
Dialogue: 0,0:18:10.85,0:18:12.40,Default,,0000,0000,0000,,أيمكننا الدخول؟
Dialogue: 0,0:18:13.45,0:18:14.40,Default,,0000,0000,0000,,تفضّلوا
Dialogue: 0,0:18:14.81,0:18:16.80,Default,,0000,0000,0000,,اختراق حاسوب؟
Dialogue: 0,0:18:16.80,0:18:19.86,Default,,0000,0000,0000,,لذاك الشاب كودو مخيلة واسعة حقاً
Dialogue: 0,0:18:20.55,0:18:22.82,Default,,0000,0000,0000,,لكنّي لست المجرم
Dialogue: 0,0:18:23.22,0:18:26.66,Default,,0000,0000,0000,,...أريد سؤالك مُجدداً عن يوم ما قبل الأمس
Dialogue: 0,0:18:27.90,0:18:33.96,Default,,0000,0000,0000,,قبل ليلتين، وضعت السيّد أوكيدا في الفراش\Nوغادرت من فورك، صحيح؟
Dialogue: 0,0:18:33.96,0:18:35.13,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:35.13,0:18:38.81,Default,,0000,0000,0000,,أأنت متأكد أنّك لم تفعل شيئاً غريباً وقتها؟
Dialogue: 0,0:18:39.20,0:18:40.95,Default,,0000,0000,0000,,شيء غريب؟
Dialogue: 0,0:18:40.95,0:18:42.78,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:18:42.78,0:18:44.91,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:18:44.91,0:18:48.73,Default,,0000,0000,0000,,فأنا أكاد أكون متأكداً أنّك أخذت \Nقطّه قبل يومين
Dialogue: 0,0:18:49.94,0:18:51.89,Default,,0000,0000,0000,,...اسمه كان
Dialogue: 0,0:18:51.89,0:18:52.98,Default,,0000,0000,0000,,أسلان
Dialogue: 0,0:18:52.98,0:18:54.81,Default,,0000,0000,0000,,صحيح، أسلان
Dialogue: 0,0:18:54.81,0:18:59.94,Default,,0000,0000,0000,,ثم أعدت أسلان بالأمس لمنزل أوكيدا
Dialogue: 0,0:18:59.94,0:19:04.15,Default,,0000,0000,0000,,علقت شعرة قطّ بقدم كونان-كن عندما أتى هنا البارحة
Dialogue: 0,0:19:04.15,0:19:08.46,Default,,0000,0000,0000,,لعلّها وصلت هنا عندما حملت أسلان\Nفي منزل الرئيس أوكيدا
Dialogue: 0,0:19:08.46,0:19:10.11,Default,,0000,0000,0000,,وعلقت بملابسي وقتها
Dialogue: 0,0:19:10.46,0:19:14.07,Default,,0000,0000,0000,,لكن توجد رقاقات سلّة فضلات قطط هنا يا توكيتو-سان
Dialogue: 0,0:19:15.38,0:19:19.44,Default,,0000,0000,0000,,تُستعمل هذه الرقاقات في سلال الفضلات، صحيح يا ران-نيتشان؟
Dialogue: 0,0:19:19.44,0:19:25.08,Default,,0000,0000,0000,,،أجل، تلتصق بالقطط كثيفة الشعر تحديداً
Dialogue: 0,0:19:25.08,0:19:27.90,Default,,0000,0000,0000,,فتتساقط في كلّ مكان عندما تتجول
Dialogue: 0,0:19:29.90,0:19:31.73,Default,,0000,0000,0000,,انظروا! توجد واحدة أخرى
Dialogue: 0,0:19:31.73,0:19:33.82,Default,,0000,0000,0000,,لا تملك قطّاً يا توكيتو-سان، صحيح؟
Dialogue: 0,0:19:34.19,0:19:37.27,Default,,0000,0000,0000,,لا شكّ بأنك أخذت أسلان الآن
Dialogue: 0,0:19:38.44,0:19:40.90,Default,,0000,0000,0000,,!لمَ أخذت أسلان؟
Dialogue: 0,0:19:40.90,0:19:42.86,Default,,0000,0000,0000,,...السبب
Dialogue: 0,0:19:42.86,0:19:46.10,Default,,0000,0000,0000,,لأنّك كنت تعرف أنّ شيئاً سيحصل
Dialogue: 0,0:19:46.10,0:19:48.63,Default,,0000,0000,0000,,!في منزل أوكيدا تلك الليلة
Dialogue: 0,0:19:48.63,0:19:50.75,Default,,0000,0000,0000,,سيحترّ المنزل بأكمله بشكل غير طبيعي
Dialogue: 0,0:19:50.75,0:19:52.86,Default,,0000,0000,0000,,ثمّ يبرد فجأةً
Dialogue: 0,0:19:52.86,0:19:55.50,Default,,0000,0000,0000,,أخذت أسلان معك لكونك مُحباً للحيوانات
Dialogue: 0,0:19:55.50,0:19:59.81,Default,,0000,0000,0000,,وخشيت أن يتأثر أو يموت حتّى
Dialogue: 0,0:20:00.29,0:20:01.51,Default,,0000,0000,0000,,ألستُ محقاً؟
Dialogue: 0,0:20:07.40,0:20:11.90,Default,,0000,0000,0000,,أنت شخص لطيف وصالح في الواقع\Nيا توكيتو-سان، صحيح؟
Dialogue: 0,0:20:13.82,0:20:16.81,Default,,0000,0000,0000,,!لكنّ ما فعلته كان خطأً
Dialogue: 0,0:20:16.81,0:20:20.14,Default,,0000,0000,0000,,اُبتكرت الحواسيب لتسهيل حياة الناس
Dialogue: 0,0:20:20.14,0:20:23.19,Default,,0000,0000,0000,,وإعطائهم السعادة، أليس كذلك؟
Dialogue: 0,0:20:23.47,0:20:26.65,Default,,0000,0000,0000,,!مع ذلك استعملته لقتل شخص
Dialogue: 0,0:20:27.05,0:20:29.61,Default,,0000,0000,0000,,!أليس ذلك الحاسوب صديقك؟
Dialogue: 0,0:20:30.30,0:20:33.40,Default,,0000,0000,0000,,!ما يعني أنّك خنت صديقك
Dialogue: 0,0:20:37.58,0:20:40.45,Default,,0000,0000,0000,,أصبت يا كونان-كن
Dialogue: 0,0:20:40.45,0:20:43.45,Default,,0000,0000,0000,,كدتُ أفقد شخصاً عزيزاً
Dialogue: 0,0:20:43.45,0:20:46.32,Default,,0000,0000,0000,,كما فخري كمُبرمج
Dialogue: 0,0:20:55.28,0:20:59.10,Default,,0000,0000,0000,,برنامجي على هذا القرص
Dialogue: 0,0:20:59.10,0:21:02.85,Default,,0000,0000,0000,,لم أتصوّر أن هذا سيقتله في الواقع
Dialogue: 0,0:21:02.85,0:21:05.28,Default,,0000,0000,0000,,كنتُ سأفكر بطريقة أخرى لو فشل
Dialogue: 0,0:21:05.28,0:21:08.73,Default,,0000,0000,0000,,!لمَ احتفظت بدليل مُدين كهذا؟
Dialogue: 0,0:21:09.13,0:21:13.09,Default,,0000,0000,0000,,كلّ برنامج أكتبه بمثابة ابن لي
Dialogue: 0,0:21:13.09,0:21:15.70,Default,,0000,0000,0000,,...لم أستطع دفع نفسي على التخلّص منه
Dialogue: 0,0:21:21.21,0:21:24.36,Default,,0000,0000,0000,,كونان-كن، هلّا أوصلت شيئاً لشينتشي ذاك؟
Dialogue: 0,0:21:24.79,0:21:30.70,Default,,0000,0000,0000,,لا أعرف بعد كم من الأعوام، لكن عندما\N،أفتتح شركتي البرمجية التالية
Dialogue: 0,0:21:30.70,0:21:33.32,Default,,0000,0000,0000,,أريده أن يعمل لي
Dialogue: 0,0:21:33.32,0:21:34.36,Default,,0000,0000,0000,,وأنت بالطبع
Dialogue: 0,0:21:35.07,0:21:36.84,Default,,0000,0000,0000,,أجل، سأخبره
Dialogue: 0,0:23:10.82,0:23:14.67,Default,,0000,0000,0000,,غلبني شينتشي هذه المرّة
Dialogue: 0,0:23:14.67,0:23:17.27,Default,,0000,0000,0000,,إنّه متطفل حقاً بالنسبة لتلميذي
Dialogue: 0,0:23:17.27,0:23:20.23,Default,,0000,0000,0000,,متى أصبحت تلميذك؟
Dialogue: 0,0:23:20.83,0:23:22.04,Default,,0000,0000,0000,,أخبرني يا كونان-كن
Dialogue: 0,0:23:22.04,0:23:26.37,Default,,0000,0000,0000,,قلتَ أنّك التقيت شينتشي بالأمس\Nفي منزل البروفسور آغاسا، صحيح؟
Dialogue: 0,0:23:26.37,0:23:31.36,Default,,0000,0000,0000,,أجل، وعندما أخبرته بحادثة الرئيس أوكيدا\Nعرف أنّها جريمة قتل فوراً
Dialogue: 0,0:23:31.36,0:23:34.07,Default,,0000,0000,0000,,!شينتشي-نيتشان مذهل حقاً
Dialogue: 0,0:23:34.07,0:23:35.95,Default,,0000,0000,0000,,!لم أسألك ذلك
Dialogue: 0,0:23:37.52,0:23:40.39,Default,,0000,0000,0000,,!لمَ لم تخبرني فوراً؟
Dialogue: 0,0:23:40.39,0:23:44.06,Default,,0000,0000,0000,,!تعرف أنّي قلقةٌ عليه
Dialogue: 0,0:23:44.06,0:23:45.24,Default,,0000,0000,0000,,...أ-أنا
Dialogue: 0,0:23:45.24,0:23:49.01,Default,,0000,0000,0000,,أين هو الآن؟ تعرف، صحيح؟
Dialogue: 0,0:23:49.01,0:23:50.61,Default,,0000,0000,0000,,...كـ-كلا، أنا
Dialogue: 0,0:23:51.05,0:23:52.94,Default,,0000,0000,0000,,!اعترف
Dialogue: 0,0:23:55.67,0:23:58.16,Default,,0000,0000,0000,,!ارجع يا كونان-كن
Dialogue: 0,0:24:00.27,0:24:03.23,Default,,0000,0000,0000,,صحيح، رنّ الهاتف وقتها
Dialogue: 0,0:24:04.26,0:24:06.83,Default,,0000,0000,0000,,نعم، أجاب كونان-كن
Dialogue: 0,0:24:06.83,0:24:10.83,Default,,0000,0000,0000,,"أجل، قالت "أنا زوجة تاتسومي بالطبع
Dialogue: 0,0:24:10.83,0:24:14.19,Default,,0000,0000,0000,,ما يعني أنّها كانت حيّةً آنذاك
Dialogue: 0,0:24:14.52,0:24:18.49,Default,,0000,0000,0000,,كان تاتسومي سينسي معي فحجّة غيابه كاملة
Dialogue: 0,0:24:18.49,0:24:22.10,Default,,0000,0000,0000,,كما يبعد الفندق 10 كيلومترات عن منزله
Dialogue: 0,0:24:24.02,0:24:25.38,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.38,0:24:29.30,Default,,0000,0000,0000,,جريمة قتل شهادة حجّة الغياب
Dialogue: 0,0:24:45.80,0:24:47.97,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.97,0:24:49.92,Default,,0000,0000,0000,,شريط كاسيت
Dialogue: 0,0:24:49.92,0:24:51.92,Default,,0000,0000,0000,,

