Dialogue: 0,0:00:02.34,0:00:04.16,Default,,0000,0000,0000,,عقرب دقائق مسرِع، قمر صناعيّ عائد
Dialogue: 0,0:00:04.16,0:00:07.24,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.37,0:00:10.74,Default,,0000,0000,0000,,!ترجع اليوم فرقة فتيان التحرّي المفعمة بالحيوية\N!كونان هذا العام مختلف قليلاً
Dialogue: 0,0:00:10.74,0:00:12.51,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.51,0:00:14.28,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.28,0:00:16.09,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:50.79,0:01:56.76,Title,,0000,0000,0000,,{\fad(300,0)}قضيّة تحديد مكان الاختطاف
Dialogue: 0,0:01:52.16,0:01:55.20,Default,,0000,0000,0000,,قضيّة تحديد مكان الاختطاف
Dialogue: 0,0:01:57.40,0:02:00.07,Default,,0000,0000,0000,,إذا استهدف خصمي الجانب\N...العلويّ من جسدي
Dialogue: 0,0:02:02.74,0:02:06.69,Default,,0000,0000,0000,,سأسحقه بركلة من جانبه الأوسط للعلويّ
Dialogue: 0,0:02:08.85,0:02:10.57,Default,,0000,0000,0000,,!مخيف
Dialogue: 0,0:02:10.97,0:02:14.83,Default,,0000,0000,0000,,ران حادّةٌ أيّام مباريات الكاراتيه دوماً
Dialogue: 0,0:02:21.25,0:02:23.91,Default,,0000,0000,0000,,!كونان-كن، عليك أن تأتي لتشجيعي قطعاً
Dialogue: 0,0:02:24.21,0:02:27.57,Default,,0000,0000,0000,,!نعم، سآتي بعد المدرسة فوراً
Dialogue: 0,0:02:27.79,0:02:32.45,Default,,0000,0000,0000,,يجب ذلك! لا يجوز أن أخسر أمام\N!خصمي اليوم مهما كلّف الأمر
Dialogue: 0,0:02:32.45,0:02:34.41,Default,,0000,0000,0000,,!لذا لتأت لتشجيعي
Dialogue: 0,0:02:34.95,0:02:37.07,Default,,0000,0000,0000,,...إذا لم تفعل
Dialogue: 0,0:02:48.89,0:02:51.48,Default,,0000,0000,0000,,...ران متحمّسة كثيراً
Dialogue: 0,0:02:59.15,0:03:02.05,Default,,0000,0000,0000,,...مجرّد أعمال بناء
Dialogue: 0,0:03:03.05,0:03:04.28,Default,,0000,0000,0000,,إلى اللقاء يا كونان-كن
Dialogue: 0,0:03:06.20,0:03:09.24,Default,,0000,0000,0000,,!أنا في عجلة، لذا سأذهب. إنّها السّاعة الرابعة
Dialogue: 0,0:03:18.19,0:03:19.94,Default,,0000,0000,0000,,!عليّ الإسراع لقاعة الكاراتيه
Dialogue: 0,0:03:20.36,0:03:22.28,Default,,0000,0000,0000,,!وإلّا سألقى تلك الركلة الاستدارية مجدداً
Dialogue: 0,0:03:22.28,0:03:24.19,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:03:24.74,0:03:26.56,Default,,0000,0000,0000,,...سمعتُ صوتاً لا أريد سماعه
Dialogue: 0,0:03:26.56,0:03:27.79,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:28.18,0:03:29.79,Default,,0000,0000,0000,,!تبّاً! ضبطوني
Dialogue: 0,0:03:30.07,0:03:34.31,Default,,0000,0000,0000,,!انظر لهذا! إنّه لاقط وسيع النطق
Dialogue: 0,0:03:34.31,0:03:38.97,Default,,0000,0000,0000,,!كلا يا غينتا-كن! يُدعى باللاقط واسع النطاق
Dialogue: 0,0:03:38.97,0:03:41.13,Default,,0000,0000,0000,,إنّهما الشيء نفسه
Dialogue: 0,0:03:41.13,0:03:42.78,Default,,0000,0000,0000,,ما وظيفته إذاً؟
Dialogue: 0,0:03:42.90,0:03:45.38,Default,,0000,0000,0000,,يشبه مذياعاً فائقاً
Dialogue: 0,0:03:45.38,0:03:50.74,Default,,0000,0000,0000,,يمكنه التقاط إرسال سيّارات الأجرة\N!والمكالمات الهاتفية اللاسلكية حتّى
Dialogue: 0,0:03:52.37,0:03:54.37,Default,,0000,0000,0000,,يبدو كلعبة لي
Dialogue: 0,0:03:54.37,0:03:56.57,Default,,0000,0000,0000,,!أرسلوا عربة إطفاء فوراً
Dialogue: 0,0:03:56.57,0:04:00.07,Default,,0000,0000,0000,,...مطعم رايرايكن؟ أريد 3 أطباق رامن و2 غيوزا
Dialogue: 0,0:04:00.07,0:04:01.65,Default,,0000,0000,0000,,!هذا مذهل
Dialogue: 0,0:04:01.65,0:04:06.52,Default,,0000,0000,0000,,لكن أليس من السيّئ استراق السمع\Nعلى محادثات الآخرين؟
Dialogue: 0,0:04:06.52,0:04:08.61,Default,,0000,0000,0000,,يُسمّى ذلك بالتنصّت
Dialogue: 0,0:04:08.61,0:04:11.89,Default,,0000,0000,0000,,لن نسبّب متاعب لأحد إذا كنّا\N!سنستمع فحسب
Dialogue: 0,0:04:11.89,0:04:13.48,Default,,0000,0000,0000,,يبقى سلوكاً مُريباً
Dialogue: 0,0:04:13.60,0:04:18.24,Default,,0000,0000,0000,,بصرف النظر، عليّ الإسراع لقاعة الكاراتيه\N...التي فيها ران وإلّا سأقع في ورطة
Dialogue: 0,0:04:18.57,0:04:22.28,Default,,0000,0000,0000,,!حسنٌ، لنستمع لمكالمات المُغنّية نامورو آمي
Dialogue: 0,0:04:22.51,0:04:23.19,Default,,0000,0000,0000,,ما رأيكم؟
Dialogue: 0,0:04:23.19,0:04:26.96,Default,,0000,0000,0000,,!ماذا؟ تعيش في هذه المنطقة؟
Dialogue: 0,0:04:26.96,0:04:28.42,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:04:28.42,0:04:30.03,Default,,0000,0000,0000,,لا يمكننا إذاً
Dialogue: 0,0:04:30.50,0:04:36.49,Default,,0000,0000,0000,,يلتقط هذا اللاقط الإشارات العشوائية\Nداخل دائرة نصف قطرها 1 كيلومتر فحسب
Dialogue: 0,0:04:36.49,0:04:39.44,Default,,0000,0000,0000,,عشوائية؟ هذا ليس مسليّاً
Dialogue: 0,0:04:39.44,0:04:42.07,Default,,0000,0000,0000,,لذا لا يمكننا اختيار من نستمع له
Dialogue: 0,0:04:42.07,0:04:45.41,Default,,0000,0000,0000,,...انظر، تدير المفتاح هكذا
Dialogue: 0,0:04:45.94,0:04:49.20,Default,,0000,0000,0000,,حتّى تلتقط محادثةً عشوائية، مثل السابق
Dialogue: 0,0:04:50.06,0:04:51.56,Default,,0000,0000,0000,,!انظر، هذه واحدة
Dialogue: 0,0:04:51.56,0:04:53.58,Default,,0000,0000,0000,,ابنتك معي
Dialogue: 0,0:04:53.58,0:04:54.58,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:04:55.97,0:04:57.57,Default,,0000,0000,0000,,ما الذي قاله؟
Dialogue: 0,0:04:57.93,0:05:01.53,Default,,0000,0000,0000,,قلتُ أنّي اختطفت ابنتك
Dialogue: 0,0:05:01.73,0:05:04.49,Default,,0000,0000,0000,,!إذا أخبرت الشرطة سأقتلها
Dialogue: 0,0:05:05.14,0:05:06.69,Default,,0000,0000,0000,,!مكالمة تهديد
Dialogue: 0,0:05:08.15,0:05:11.67,Default,,0000,0000,0000,,!أهذا معقول؟! من أين يتكلّم؟
Dialogue: 0,0:05:11.67,0:05:14.67,Default,,0000,0000,0000,,!اللاقط ينقل صوتاً فحسب، فلا أعرف
Dialogue: 0,0:05:14.67,0:05:17.61,Default,,0000,0000,0000,,!قال أنّه اختطف ابنته يا كونان-كن
Dialogue: 0,0:05:17.78,0:05:19.69,Default,,0000,0000,0000,,...إخباري بذلك لن
Dialogue: 0,0:05:19.69,0:05:22.20,Default,,0000,0000,0000,,!ماذا لو كان اختطافاً حقيقياً؟
Dialogue: 0,0:05:22.20,0:05:25.52,Default,,0000,0000,0000,,،ولو كان اختطافاً حقيقياً
Dialogue: 0,0:05:25.52,0:05:32.92,Default,,0000,0000,0000,,كلّ ما نعرفه من المحادثة أنّ الاختطاف وقع ضمن \N!نصف قطر 1 كيلومتر بحيث التقط اللاقط الإشارة
Dialogue: 0,0:05:33.99,0:05:36.11,Default,,0000,0000,0000,,إنّه كيلومتر واحد فحسب
Dialogue: 0,0:05:36.11,0:05:38.43,Default,,0000,0000,0000,,!قد يعاود الاتّصال
Dialogue: 0,0:05:38.43,0:05:41.20,Default,,0000,0000,0000,,لننتظر ونرى، حسناً يا كونان-كن؟
Dialogue: 0,0:05:44.30,0:05:45.69,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:05:45.83,0:05:49.60,Default,,0000,0000,0000,,!فرقة فتيان التحرّي ترجع لتحقيقاتها بعد انقطاع
Dialogue: 0,0:05:49.60,0:05:50.65,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:05:50.65,0:05:52.79,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:05:54.25,0:05:56.47,On Top,,0000,0000,0000,,قاعة بيكا للفنون القتالية\Nبطولة غيوكوشينكاي للكاراتيه
Dialogue: 0,0:05:56.47,0:05:58.51,On Top,,0000,0000,0000,,قاعة بيكا للفنون القتالية
Dialogue: 0,0:05:58.51,0:06:03.48,On Top,,0000,0000,0000,,بطولة غيوكوشينكاي للكاراتيه
Dialogue: 0,0:06:04.08,0:06:06.61,Default,,0000,0000,0000,,في الناحية الزرقاء، موري ران
Dialogue: 0,0:06:10.19,0:06:11.43,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:06:11.53,0:06:15.97,Default,,0000,0000,0000,,تبّاً، سيدخلونني معهم مجدداً\Nعلى هذا النحو
Dialogue: 0,0:06:19.56,0:06:21.12,Default,,0000,0000,0000,,أين تذهب يا كونان-كن؟
Dialogue: 0,0:06:21.12,0:06:22.20,Default,,0000,0000,0000,,لا شيء
Dialogue: 0,0:06:22.81,0:06:25.71,Default,,0000,0000,0000,,يبدو أنّك لم تتصل بالشرطة
Dialogue: 0,0:06:25.71,0:06:26.93,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:06:26.93,0:06:27.71,Default,,0000,0000,0000,,!جونكو
Dialogue: 0,0:06:28.00,0:06:32.53,Default,,0000,0000,0000,,!ماذا ستفعل لها؟! سألبي أيّ من طلباتك قدر استطاعتي
Dialogue: 0,0:06:32.96,0:06:34.49,Default,,0000,0000,0000,,!لا تؤذها فقط
Dialogue: 0,0:06:35.30,0:06:40.44,Default,,0000,0000,0000,,لتخرج للشرفة للوقت الحالي\Nومعك الهاتف المحمول
Dialogue: 0,0:06:42.20,0:06:44.70,Default,,0000,0000,0000,,جيّد، قف هناك
Dialogue: 0,0:06:44.70,0:06:47.53,Default,,0000,0000,0000,,!طبق استقبالك الفضائيّ يشكّل حاجباً! أزله
Dialogue: 0,0:06:48.53,0:06:50.31,Default,,0000,0000,0000,,!افعل ما أقول وحسب
Dialogue: 0,0:06:50.98,0:06:52.36,Default,,0000,0000,0000,,ماذا يطلب منه أن يفعل؟
Dialogue: 0,0:06:52.65,0:06:55.42,Default,,0000,0000,0000,,المُختطِف يراقب هذا الشخص من مكانٍ ما
Dialogue: 0,0:06:55.64,0:07:00.07,Default,,0000,0000,0000,,جعله يخرج للشرفة كي يراه بوضوح على الأرجح
Dialogue: 0,0:07:01.81,0:07:06.52,Default,,0000,0000,0000,,لن أفكّر في الاتّصال بالشرطة\Nلو كنت مكانك
Dialogue: 0,0:07:07.09,0:07:10.46,Default,,0000,0000,0000,,يمكنني رؤيتك بكلّ وضوح
Dialogue: 0,0:07:10.46,0:07:15.19,Default,,0000,0000,0000,,!قم بأيّ حركة غريبة... وسأقتل ابنتك فوراً
Dialogue: 0,0:07:16.33,0:07:17.83,Default,,0000,0000,0000,,سـ-سيقتلها
Dialogue: 0,0:07:17.83,0:07:20.90,Default,,0000,0000,0000,,!ماذا نفعل؟! هل نتّصل بالشرطة؟
Dialogue: 0,0:07:20.90,0:07:24.83,Default,,0000,0000,0000,,!فـ-فهمت! سأفعل أيّ ما تريد
Dialogue: 0,0:07:24.83,0:07:28.86,Default,,0000,0000,0000,,ما هي رغبتك؟ المال؟ تريد المال؟
Dialogue: 0,0:07:30.07,0:07:31.32,Default,,0000,0000,0000,,...هذا الصوت
Dialogue: 0,0:07:33.74,0:07:38.16,Default,,0000,0000,0000,,لا تعجل، انتظر مكانك لفترة
Dialogue: 0,0:07:43.65,0:07:45.13,Default,,0000,0000,0000,,!أغلق الهاتف
Dialogue: 0,0:07:45.13,0:07:46.98,Default,,0000,0000,0000,,ماذا نفعل؟
Dialogue: 0,0:07:46.98,0:07:48.90,Default,,0000,0000,0000,,هل نخبر الشرطة؟
Dialogue: 0,0:07:48.90,0:07:52.10,Default,,0000,0000,0000,,لكن هل سيصدقوننا؟
Dialogue: 0,0:07:52.10,0:07:57.04,Default,,0000,0000,0000,,صحيح، كلّ ما نعرفه أنّ هناك فتاة صغيرة\Nتُدعى جونكو-تشان قد اُختطفت
Dialogue: 0,0:07:57.47,0:07:59.63,Default,,0000,0000,0000,,...كما أنّه أغلق الهاتف
Dialogue: 0,0:07:59.63,0:08:00.87,Default,,0000,0000,0000,,!لنفعلها بأنفسنا
Dialogue: 0,0:08:01.74,0:08:04.96,Default,,0000,0000,0000,,!لا وقت لدينا للذهاب للشرطة
Dialogue: 0,0:08:05.13,0:08:08.29,Default,,0000,0000,0000,,!حسنٌ، سنجد المُختطِف جميعاً
Dialogue: 0,0:08:08.29,0:08:09.39,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:08:10.08,0:08:12.83,Default,,0000,0000,0000,,لكن كيف؟ لا نملك أيّ خيوط
Dialogue: 0,0:08:12.83,0:08:13.87,Default,,0000,0000,0000,,...معك حق
Dialogue: 0,0:08:14.41,0:08:16.58,Default,,0000,0000,0000,,عرفتُ شيئاً من تلك المكالمة
Dialogue: 0,0:08:18.03,0:08:19.53,Default,,0000,0000,0000,,ما الذي عرفته؟
Dialogue: 0,0:08:20.53,0:08:23.61,Default,,0000,0000,0000,,!ماذا؟! لمَ تخرج دفتر الرياضيات؟
Dialogue: 0,0:08:23.61,0:08:24.75,Default,,0000,0000,0000,,!ليس كذلك
Dialogue: 0,0:08:25.28,0:08:28.70,Default,,0000,0000,0000,,إنّها خريطة إلكترونية بشكل دفتر\Nاخترعها البروفسور آغاسا
Dialogue: 0,0:08:29.56,0:08:32.41,Default,,0000,0000,0000,,تقصد قريبك المُخترع ذاك؟
Dialogue: 0,0:08:32.85,0:08:36.76,Default,,0000,0000,0000,,حسناً، انظروا، مدرستنا هنا
Dialogue: 0,0:08:36.85,0:08:41.12,Default,,0000,0000,0000,,نصف قطر مدى التقاط\Nاللاقط للإشارات هو 1 كيلومتر
Dialogue: 0,0:08:41.76,0:08:45.87,Default,,0000,0000,0000,,في هذه الدائرة، يوجد منزل الضحيّة بها
Dialogue: 0,0:08:46.09,0:08:48.64,Default,,0000,0000,0000,,...والصوت الخافت الذي سمعته في الخلفية
Dialogue: 0,0:08:50.58,0:08:54.83,Default,,0000,0000,0000,,كان قطاراً. يعيش الضحيّة بقرب سكّة قطار غالباً
Dialogue: 0,0:08:55.33,0:08:58.37,Default,,0000,0000,0000,,!توجد سكّة حديدية واحدة فحسب تمرّ بهذه المنطقة
Dialogue: 0,0:09:02.57,0:09:04.33,Default,,0000,0000,0000,,!خطّ بيكا
Dialogue: 0,0:09:04.33,0:09:05.40,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:09:05.40,0:09:07.70,Default,,0000,0000,0000,,!حسناً، لنذهب لخطّ بيكا
Dialogue: 0,0:09:14.31,0:09:16.06,Default,,0000,0000,0000,,...وصلنا سكّة القطار
Dialogue: 0,0:09:16.06,0:09:18.17,Default,,0000,0000,0000,,ماذا نفعل الآن؟
Dialogue: 0,0:09:18.17,0:09:22.70,Default,,0000,0000,0000,,هذه السكّة الوحيدة في مدى اللاقط
Dialogue: 0,0:09:22.70,0:09:27.21,Default,,0000,0000,0000,,أي أنّ الضحية على امتداد\N!هذه السكّة ذات الستّمئة متر
Dialogue: 0,0:09:27.71,0:09:29.79,Default,,0000,0000,0000,,!حسنٌ، 600 متر فحسب
Dialogue: 0,0:09:30.74,0:09:34.91,Default,,0000,0000,0000,,لكن، ألا توجد طريقة أخرى يا كونان؟
Dialogue: 0,0:09:35.91,0:09:38.11,Default,,0000,0000,0000,,...لديّ تلميح آخر، لكن
Dialogue: 0,0:09:38.11,0:09:39.12,Default,,0000,0000,0000,,!ما هو؟
Dialogue: 0,0:09:40.70,0:09:45.20,Default,,0000,0000,0000,,أخبر المُختطف الضحيّة بإزالة\Nطبق الاستقبال الفضائيّ، أليس كذلك؟
Dialogue: 0,0:09:45.20,0:09:46.08,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:09:46.08,0:09:50.27,Default,,0000,0000,0000,,أطباق الاستقبال تُوجّه للجنوب الغربيّ
Dialogue: 0,0:09:50.27,0:09:54.54,Default,,0000,0000,0000,,ما يعني أنّ شرفة الضحيّة تُطلّ \N...على الجنوب الغربي، لكن
Dialogue: 0,0:09:54.54,0:09:57.95,Default,,0000,0000,0000,,...حسناً، منزل الضحيّة هو الذي
Dialogue: 0,0:09:57.95,0:09:59.80,Default,,0000,0000,0000,,!تطلّ شرفته جنوباً أو غرباً
Dialogue: 0,0:09:59.80,0:10:00.62,Default,,0000,0000,0000,,!لنذهب
Dialogue: 0,0:10:04.26,0:10:07.09,Default,,0000,0000,0000,,طبق استقبال فضائيّ؟
Dialogue: 0,0:10:07.28,0:10:09.57,Default,,0000,0000,0000,,!لا شكّ في الأمر، ذاك هو
Dialogue: 0,0:10:09.92,0:10:11.60,Default,,0000,0000,0000,,...ظننت ذلك
Dialogue: 0,0:10:12.92,0:10:15.32,Default,,0000,0000,0000,,!لكن يوجد الكثير منها
Dialogue: 0,0:10:15.32,0:10:17.50,Default,,0000,0000,0000,,!على المباني المقابلة أيضاً
Dialogue: 0,0:10:17.74,0:10:20.66,Default,,0000,0000,0000,,صحيح، لا نملك خيوط كافية
Dialogue: 0,0:10:20.66,0:10:22.45,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:10:27.36,0:10:28.87,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:10:29.69,0:10:32.20,Default,,0000,0000,0000,,!اتّصل المُختطف مُجدداً
Dialogue: 0,0:10:32.44,0:10:36.08,Default,,0000,0000,0000,,!حسنٌ، بح بتلميحٍ ما
Dialogue: 0,0:10:36.08,0:10:38.24,Default,,0000,0000,0000,,!سأجد أنا الخيط هذه المرة
Dialogue: 0,0:10:38.24,0:10:38.97,Default,,0000,0000,0000,,!بل أنا
Dialogue: 0,0:10:38.97,0:10:40.03,Default,,0000,0000,0000,,!صمتاً
Dialogue: 0,0:10:40.11,0:10:43.01,Default,,0000,0000,0000,,يبدو أنّك لم تتصل بالشرطة
Dialogue: 0,0:10:43.01,0:10:45.00,Default,,0000,0000,0000,,!أجونكو بخير؟
Dialogue: 0,0:10:46.76,0:10:49.63,Default,,0000,0000,0000,,يعتمد ذلك عليك
Dialogue: 0,0:10:49.63,0:10:52.04,Default,,0000,0000,0000,,قلتَ أنك ستفعل أيّ شيء، صحيح؟
Dialogue: 0,0:10:52.04,0:10:55.34,Default,,0000,0000,0000,,فلنبدأ بتعرّيك إذاً
Dialogue: 0,0:10:56.39,0:10:58.91,Default,,0000,0000,0000,,!تعرَّ! اخلع ثيابك
Dialogue: 0,0:10:58.91,0:11:00.57,Default,,0000,0000,0000,,يـ-يتعرّى؟
Dialogue: 0,0:11:00.57,0:11:04.45,Default,,0000,0000,0000,,فهمت، يجعله يذهب إلى حمّام عام في الحيّ
Dialogue: 0,0:11:04.45,0:11:05.87,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:11:07.77,0:11:11.77,Default,,0000,0000,0000,,جيّد، ستمرّ طالبات في الثانويّة\Nأسفل شقّتك قريباً
Dialogue: 0,0:11:11.77,0:11:13.66,Default,,0000,0000,0000,,!لوّح لهن
Dialogue: 0,0:11:14.11,0:11:16.12,Default,,0000,0000,0000,,أم لا تهتمّ لمَ يحلّ بابنتك؟
Dialogue: 0,0:11:20.51,0:11:23.26,Default,,0000,0000,0000,,!قُل "مرحباً!" ولوّح لهن
Dialogue: 0,0:11:23.26,0:11:24.76,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:11:25.33,0:11:28.74,Default,,0000,0000,0000,,!مرحباً! مرحباً
Dialogue: 0,0:11:28.74,0:11:31.38,Default,,0000,0000,0000,,!ا-انظري لذاك
Dialogue: 0,0:11:31.38,0:11:32.95,Default,,0000,0000,0000,,!فظيع جدّاً
Dialogue: 0,0:11:32.95,0:11:35.41,Default,,0000,0000,0000,,!مرحباً! مرحباً
Dialogue: 0,0:11:37.87,0:11:42.33,Default,,0000,0000,0000,,كيف هو شعور سخرية فتيات برداء بحّارة منك؟
Dialogue: 0,0:11:42.33,0:11:44.22,Default,,0000,0000,0000,,ابقَ على حالك لفترة
Dialogue: 0,0:11:45.70,0:11:47.07,Default,,0000,0000,0000,,رداء بحّارة؟
Dialogue: 0,0:11:47.94,0:11:53.51,Default,,0000,0000,0000,,سمعتُ صوت عددٍ من طالبات الثانويّة\N...عبر اللاقط واسع النطاق
Dialogue: 0,0:11:53.90,0:11:58.70,Default,,0000,0000,0000,,مجمع الشقق ذاك في طريق\Nيؤدي لثانويّة فتيات غالباً
Dialogue: 0,0:11:59.51,0:12:02.18,Default,,0000,0000,0000,,...مدارس الفتيات الوحيدة في نطاق الستمئة متر
Dialogue: 0,0:12:02.18,0:12:05.16,Default,,0000,0000,0000,,هي أكاديمية سيجون للفتيات\Nومدرسة بيكا الثانويّة للفتيات
Dialogue: 0,0:12:05.34,0:12:09.38,Default,,0000,0000,0000,,لا بدّ أنّ المُختطف كان يتعرّض\Nللسخرية من طالبات الثانوية باستمرار
Dialogue: 0,0:12:09.38,0:12:11.46,Default,,0000,0000,0000,,أجل، معلّم مدرسة فتيات
Dialogue: 0,0:12:11.46,0:12:14.67,Default,,0000,0000,0000,,!لن يُقدم معلّم مدرسة على شيءٍ كهذا
Dialogue: 0,0:12:14.67,0:12:18.08,Default,,0000,0000,0000,,...عرفتُ المدارس، لكن ليس الرداء بعد
Dialogue: 0,0:12:18.08,0:12:21.12,Default,,0000,0000,0000,,،تعتمد أكاديمية سيجون السترات\Nبينما ثانويّة بيكا رداء البحّارة
Dialogue: 0,0:12:21.65,0:12:22.66,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:22.95,0:12:28.03,Default,,0000,0000,0000,,كنتُ أحلم بارتداء زيّ بحّارة\Nعندما أدخل المدرسة الثانويّة
Dialogue: 0,0:12:28.03,0:12:33.62,Default,,0000,0000,0000,,لكنّي أصبحت أميل للسترات والجوارب \Nالفضفاضة مؤخراً، ولا أدري أيّهما أختار
Dialogue: 0,0:12:33.98,0:12:36.00,Default,,0000,0000,0000,,أيّهما تعجبك أكثر يا كونان-كن؟
Dialogue: 0,0:12:36.00,0:12:37.85,Default,,0000,0000,0000,,كلتاهما جيّدتان
Dialogue: 0,0:12:37.85,0:12:39.77,Default,,0000,0000,0000,,!أعتقد أنّ السترة ستلائمك أكثر
Dialogue: 0,0:12:39.77,0:12:41.33,Default,,0000,0000,0000,,!بل زيّ البحّارة
Dialogue: 0,0:12:43.10,0:12:44.77,Default,,0000,0000,0000,,!ثانويّة بيكا للفتيات
Dialogue: 0,0:12:48.05,0:12:51.24,Default,,0000,0000,0000,,تقلّص نطاق بحثنا لدائرة\N!بنصف قطر 300 متر
Dialogue: 0,0:12:51.63,0:12:52.53,Default,,0000,0000,0000,,!من هناك
Dialogue: 0,0:12:53.42,0:12:54.66,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:12:57.95,0:13:00.52,Default,,0000,0000,0000,,رجل يلوّح من شرفة؟
Dialogue: 0,0:13:00.52,0:13:02.16,Default,,0000,0000,0000,,...لا أراه
Dialogue: 0,0:13:02.16,0:13:05.04,Default,,0000,0000,0000,,هل نسأل طالبات الثانويّة؟
Dialogue: 0,0:13:05.04,0:13:06.12,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:13:06.75,0:13:11.57,Default,,0000,0000,0000,,،يمكنك التوقّف عن التلويح \N!فلتغنِّ الآن! غنِّ
Dialogue: 0,0:13:11.57,0:13:15.69,Default,,0000,0000,0000,,بصوت مرتفع بحيث يسمعك\N!الحيّ بأكمله! هيّا
Dialogue: 0,0:13:20.14,0:13:21.37,Default,,0000,0000,0000,,...لا أسمعه
Dialogue: 0,0:13:21.89,0:13:24.37,Default,,0000,0000,0000,,يبدو أنّه ليس في هذا الحيّ
Dialogue: 0,0:13:28.76,0:13:30.34,Default,,0000,0000,0000,,هناك صوتٌ ما
Dialogue: 0,0:13:30.34,0:13:32.72,Default,,0000,0000,0000,,يبدو كجرس معبد
Dialogue: 0,0:13:32.72,0:13:36.13,Default,,0000,0000,0000,,!فهمت! منزل الضحيّة وراء معبد
Dialogue: 0,0:13:36.13,0:13:40.83,Default,,0000,0000,0000,,قد يكون طبل تايكو، لا بدّ أنّ المُختطف يشارك معه
Dialogue: 0,0:13:41.32,0:13:43.24,Default,,0000,0000,0000,,...كلا! هذا الصوت
Dialogue: 0,0:13:49.48,0:13:51.63,Default,,0000,0000,0000,,!مثل ذاك الصوت
Dialogue: 0,0:13:56.31,0:13:58.02,Default,,0000,0000,0000,,!إنّها دقّاقة ركام
Dialogue: 0,0:13:58.42,0:14:00.22,Default,,0000,0000,0000,,دقّاقة ركام؟
Dialogue: 0,0:14:00.59,0:14:03.82,Default,,0000,0000,0000,,تلك الآلة التي تسحق الركام\Nفي مواقع البناء، صحيح؟
Dialogue: 0,0:14:04.03,0:14:06.55,Default,,0000,0000,0000,,لكنّ العثور على موقع بناء\N...في هذه المنطقة
Dialogue: 0,0:14:06.82,0:14:08.06,Default,,0000,0000,0000,,!وجدتُها
Dialogue: 0,0:14:20.72,0:14:24.51,Default,,0000,0000,0000,,!إذا تبعناها، ستقودنا لموقع البناء
Dialogue: 0,0:14:33.21,0:14:35.80,Default,,0000,0000,0000,,!تقلّص النطاق لمئة وخمسين متراً الآن
Dialogue: 0,0:14:36.54,0:14:38.11,Default,,0000,0000,0000,,لا أسمعه
Dialogue: 0,0:14:38.11,0:14:42.76,Default,,0000,0000,0000,,حتّى مع اقترابنا، لا تزال 150 متراً كثيرة
Dialogue: 0,0:14:43.95,0:14:46.74,Default,,0000,0000,0000,,...بدون خيطٍ جلّي
Dialogue: 0,0:14:48.48,0:14:51.27,Default,,0000,0000,0000,,الآباء بائسون حقّاً
Dialogue: 0,0:14:51.27,0:14:54.53,Default,,0000,0000,0000,,!يفعلون أيّ شيء لأجل أطفالهم
Dialogue: 0,0:14:54.94,0:14:58.54,Default,,0000,0000,0000,,أعرف ذاك الشعور، فقد كنتُ أباً بدوري
Dialogue: 0,0:14:59.01,0:15:00.50,Default,,0000,0000,0000,,كنتُ أباً"؟"
Dialogue: 0,0:15:00.50,0:15:04.42,Default,,0000,0000,0000,,الفتاة التي سقطت من السطح\N...ولقيت حتفها قبل عام
Dialogue: 0,0:15:04.68,0:15:09.38,Default,,0000,0000,0000,,لا بدّ أنّك تتذكر، فقد كان المبنى\Nالذي كنتَ مشرفاً عليه
Dialogue: 0,0:15:09.79,0:15:12.33,Default,,0000,0000,0000,,!الفتاة التي ماتت كانت ابنتي
Dialogue: 0,0:15:12.33,0:15:14.34,On Top,,0000,0000,0000,,فتاة صغيرة تسقط لحتفها
Dialogue: 0,0:15:15.83,0:15:20.03,Default,,0000,0000,0000,,!توميدوكورو-سان؟ أأنت توميدوكورو-سان؟
Dialogue: 0,0:15:20.03,0:15:24.26,Default,,0000,0000,0000,,نعم، أنا من قتلتَ ابنته
Dialogue: 0,0:15:24.33,0:15:26.51,Default,,0000,0000,0000,,!لـ-ليس صحيحاً! كان حادثاً
Dialogue: 0,0:15:26.56,0:15:31.56,Default,,0000,0000,0000,,اخرس! سطح ذاك المبنى كان مكاناً\N!محظوراً، ويُفترض أنّه مقفل دائماً
Dialogue: 0,0:15:31.56,0:15:34.56,Default,,0000,0000,0000,,!فلمَ كان مفتوحاً وقتها؟
Dialogue: 0,0:15:35.49,0:15:39.75,Default,,0000,0000,0000,,!عبث أحدهم بالقفل، أو تحطّم في حادثة ما
Dialogue: 0,0:15:39.75,0:15:43.97,Default,,0000,0000,0000,,!قبل أسبوع كامل! فلمَ لم تقم بشيء حياله؟
Dialogue: 0,0:15:44.10,0:15:46.43,Default,,0000,0000,0000,,لم أتوقع أن يصعد أحد هناك
Dialogue: 0,0:15:46.43,0:15:49.48,Default,,0000,0000,0000,,!لم تكن غلطة أحد إذاً؟! لا تعبث معي
Dialogue: 0,0:15:49.78,0:15:53.83,Default,,0000,0000,0000,,سأجعلك تتجرّع نفس الألم\Nالذي تذوّقتُه
Dialogue: 0,0:15:54.29,0:15:57.10,Default,,0000,0000,0000,,!نفسه تماماً
Dialogue: 0,0:15:57.24,0:15:59.73,Default,,0000,0000,0000,,!ما الذي ستفعله لجونكو؟
Dialogue: 0,0:16:00.34,0:16:01.77,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:16:01.77,0:16:03.34,Default,,0000,0000,0000,,...علينا فعل شيء سريعاً
Dialogue: 0,0:16:05.70,0:16:09.27,Default,,0000,0000,0000,,!صوت عبور القطار المزعج! لا نسمع شيئاً
Dialogue: 0,0:16:09.27,0:16:10.15,Default,,0000,0000,0000,,!وجدتُها
Dialogue: 0,0:16:10.15,0:16:11.21,Default,,0000,0000,0000,,!أعطني اللاقط
Dialogue: 0,0:16:11.21,0:16:12.24,Default,,0000,0000,0000,,...ذاك
Dialogue: 0,0:16:12.24,0:16:12.98,Default,,0000,0000,0000,,!لا تهتم
Dialogue: 0,0:16:26.60,0:16:28.29,Default,,0000,0000,0000,,واحد، اثنان
Dialogue: 0,0:16:28.55,0:16:30.21,Default,,0000,0000,0000,,ثلاثة، أربعة
Dialogue: 0,0:16:30.95,0:16:32.17,Default,,0000,0000,0000,,خمسة، ستّة
Dialogue: 0,0:16:32.98,0:16:35.13,Default,,0000,0000,0000,,سبعة، ثمانية
Dialogue: 0,0:16:35.78,0:16:37.29,Default,,0000,0000,0000,,!ها هو، 8.2 ثانية
Dialogue: 0,0:16:37.49,0:16:38.65,Default,,0000,0000,0000,,!من هنا
Dialogue: 0,0:16:40.50,0:16:42.91,Default,,0000,0000,0000,,كيف تعرف أنّ هذا هو الطريق؟
Dialogue: 0,0:16:43.19,0:16:44.82,Default,,0000,0000,0000,,!صوت القطار
Dialogue: 0,0:16:44.82,0:16:48.87,Default,,0000,0000,0000,,!استغرق 8.2 ثانية قبل أن أسمعه على اللاقط
Dialogue: 0,0:16:48.87,0:16:55.83,On Top,,0000,0000,0000,,{\pos(115.5,77)}خطّ بيكا
Dialogue: 0,0:16:48.87,0:16:55.83,On Top,,0000,0000,0000,,{\pos(313.5,195)}السرعة
Dialogue: 0,0:16:49.39,0:16:52.47,Default,,0000,0000,0000,,سرعة القطار على خطّ بيكا\Nتبلغ 100 كم في الساعة
Dialogue: 0,0:16:52.47,0:16:55.83,Default,,0000,0000,0000,,أي قرابة 27.8 متر في الثانية
Dialogue: 0,0:16:56.52,0:17:01.04,Default,,0000,0000,0000,,سمعتُ صوت القطار على اللاقط\Nبعد 8.2 ثانية من تجاوزه التقاطع
Dialogue: 0,0:17:01.46,0:17:06.83,Default,,0000,0000,0000,,أي أنّ منزل الضحيّة يبعد 27.8 متراً\N!ضرب 8.2 ثانية
Dialogue: 0,0:17:07.20,0:17:08.80,Default,,0000,0000,0000,,...وذلك
Dialogue: 0,0:17:09.75,0:17:11.00,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:17:11.00,0:17:14.70,Default,,0000,0000,0000,,!مبنى في هذه الأرجاء بشرفة مطلّة غرباً أو جنوباً
Dialogue: 0,0:17:14.70,0:17:18.44,Default,,0000,0000,0000,,...وبشرفة يتواجد فيها رجلٌ عارٍ
Dialogue: 0,0:17:20.49,0:17:21.54,Default,,0000,0000,0000,,!ذاك هو
Dialogue: 0,0:17:21.99,0:17:24.50,Default,,0000,0000,0000,,!إنّه الضحيّة الذي اُختطفت ابنته
Dialogue: 0,0:17:24.90,0:17:26.46,Default,,0000,0000,0000,,...تبقّى مكان المُختطِف فقط
Dialogue: 0,0:17:27.35,0:17:30.03,Default,,0000,0000,0000,,سحقاً! أين هو؟
Dialogue: 0,0:17:32.41,0:17:36.83,Default,,0000,0000,0000,,!سأفعل أيّ شيء! اصفح عن حياة ابنتي فحسب
Dialogue: 0,0:17:36.96,0:17:38.10,Default,,0000,0000,0000,,أيّ شيء؟
Dialogue: 0,0:17:39.05,0:17:40.11,Default,,0000,0000,0000,,!أيّ شيء
Dialogue: 0,0:17:40.11,0:17:42.88,Default,,0000,0000,0000,,جيّد، كنتُ بانتظار هذه الكلمات
Dialogue: 0,0:17:42.88,0:17:44.83,Default,,0000,0000,0000,,اذهب للمطبخ واجلب سكّيناً
Dialogue: 0,0:17:45.47,0:17:47.88,Default,,0000,0000,0000,,...سكّين؟ فهمت
Dialogue: 0,0:17:50.12,0:17:54.08,Default,,0000,0000,0000,,هكذا إذاً، سيجعله المُختطف يقتل نفسه
Dialogue: 0,0:17:54.08,0:17:56.79,Default,,0000,0000,0000,,!كي ينتقم منه دون تلويث يديه
Dialogue: 0,0:17:56.79,0:17:58.37,Default,,0000,0000,0000,,أحضرتُها
Dialogue: 0,0:17:58.37,0:18:01.33,Default,,0000,0000,0000,,حسناً، سيكون هذا طلبي الأخير
Dialogue: 0,0:18:02.32,0:18:07.19,Default,,0000,0000,0000,,ادفع السكّين في حلقك، وسأطلق سراح ابنتك
Dialogue: 0,0:18:07.19,0:18:10.19,Default,,0000,0000,0000,,!لا-لا يمكنني فعل ذلك
Dialogue: 0,0:18:11.79,0:18:14.75,Default,,0000,0000,0000,,لا تهتم لمَ سيحلّ بابنتك إذاً؟
Dialogue: 0,0:18:15.02,0:18:17.30,Default,,0000,0000,0000,,!تبّاً! عليّ الإسراع
Dialogue: 0,0:18:17.30,0:18:19.31,Default,,0000,0000,0000,,!أين المُختطف؟
Dialogue: 0,0:18:24.18,0:18:26.42,Default,,0000,0000,0000,,!حسناً! سأفعل ما تقول
Dialogue: 0,0:18:26.80,0:18:30.38,Default,,0000,0000,0000,,!لكن قبل ذلك، دعني أكلّم جونكو لآخر مرّة
Dialogue: 0,0:18:30.58,0:18:31.83,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:18:31.83,0:18:33.13,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:18:33.13,0:18:35.25,Default,,0000,0000,0000,,جونكو! أأنتِ بخير؟
Dialogue: 0,0:18:35.25,0:18:36.90,Default,,0000,0000,0000,,اصمدي قليلاً فحسب
Dialogue: 0,0:18:36.90,0:18:38.95,Default,,0000,0000,0000,,!أبي! أريد الرجوع للبيت
Dialogue: 0,0:18:38.95,0:18:42.75,Default,,0000,0000,0000,,!هناك رائحة غريبة! رائحة المطّاط التي أكرهها
Dialogue: 0,0:18:43.24,0:18:44.37,Default,,0000,0000,0000,,!رائحة المطّاط؟
Dialogue: 0,0:18:47.85,0:18:48.91,Default,,0000,0000,0000,,!مصنع إطارات
Dialogue: 0,0:18:49.85,0:18:50.81,Default,,0000,0000,0000,,!هناك
Dialogue: 0,0:18:54.78,0:18:56.46,Default,,0000,0000,0000,,!لا أرى المبنى
Dialogue: 0,0:18:57.18,0:18:59.97,Default,,0000,0000,0000,,تبّاً، ليس مصنع الإطارات؟
Dialogue: 0,0:18:59.97,0:19:00.93,Default,,0000,0000,0000,,اهدأ
Dialogue: 0,0:19:00.93,0:19:04.44,Default,,0000,0000,0000,,ما هي المباني قرب المصنع\Nبإطلالة على شرفة الضحيّة؟
Dialogue: 0,0:19:04.80,0:19:06.33,Default,,0000,0000,0000,,!توجد ثلاثة
Dialogue: 0,0:19:06.93,0:19:09.91,Default,,0000,0000,0000,,!أيّها؟! أيّ مجمع شقق؟
Dialogue: 0,0:19:15.00,0:19:18.57,Default,,0000,0000,0000,,!الوحيد في اتّجاه الرياح... هو ذاك المبنى فحسب
Dialogue: 0,0:19:18.57,0:19:20.16,Default,,0000,0000,0000,,!لا بدّ أنّه هو
Dialogue: 0,0:19:20.62,0:19:23.62,Default,,0000,0000,0000,,!المُختطف وجونكو-تشان في مكانٍ ما داخله
Dialogue: 0,0:19:23.62,0:19:28.77,Default,,0000,0000,0000,,!كونان! تصرّف بسرعة\N!سيقتل ذاك الشخص نفسه حقّاً
Dialogue: 0,0:19:28.77,0:19:31.12,Default,,0000,0000,0000,,!حياة جونكو-تشان في خطر أيضاً
Dialogue: 0,0:19:31.12,0:19:35.40,Default,,0000,0000,0000,,سأجعلك تتجرّع نفس الألم\Nالذي تذوّقتُه
Dialogue: 0,0:19:35.40,0:19:37.87,Default,,0000,0000,0000,,!نفسه تماماً
Dialogue: 0,0:19:38.22,0:19:40.03,Default,,0000,0000,0000,,...نفسه تماماً
Dialogue: 0,0:19:40.51,0:19:41.58,Default,,0000,0000,0000,,!السطح
Dialogue: 0,0:19:41.93,0:19:44.01,Default,,0000,0000,0000,,!المُختطف على سطح المبنى
Dialogue: 0,0:19:45.16,0:19:45.96,Default,,0000,0000,0000,,!إنّه ذاك المبنى
Dialogue: 0,0:19:48.56,0:19:50.69,Default,,0000,0000,0000,,!اتّصلا بالشرطة يا ميتسوهيكو وأيومي
Dialogue: 0,0:19:50.69,0:19:51.46,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:19:51.46,0:19:53.04,Default,,0000,0000,0000,,!لحظة، انتظر يا كونان
Dialogue: 0,0:19:53.42,0:19:56.00,Default,,0000,0000,0000,,نعم، اغرزها
Dialogue: 0,0:19:58.95,0:20:00.19,Default,,0000,0000,0000,,!لا تستعجل
Dialogue: 0,0:20:00.68,0:20:02.75,Default,,0000,0000,0000,,!نعم، اغرزها هكذا
Dialogue: 0,0:20:03.10,0:20:04.46,Default,,0000,0000,0000,,!اغرزها! فلتفعل
Dialogue: 0,0:20:07.40,0:20:08.41,Default,,0000,0000,0000,,!جونكو
Dialogue: 0,0:20:10.12,0:20:13.08,Default,,0000,0000,0000,,!لمَ تتردد؟! افعلها! اغرزها
Dialogue: 0,0:20:13.28,0:20:14.99,Default,,0000,0000,0000,,!جونكو
Dialogue: 0,0:20:16.33,0:20:17.73,Default,,0000,0000,0000,,!مـ-من هنا؟
Dialogue: 0,0:20:17.91,0:20:19.49,Default,,0000,0000,0000,,!من أنت؟
Dialogue: 0,0:20:20.05,0:20:22.20,Default,,0000,0000,0000,,إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:20:26.26,0:20:27.36,Default,,0000,0000,0000,,!خُذ
Dialogue: 0,0:20:33.16,0:20:34.41,Default,,0000,0000,0000,,أبليتِ حسناً
Dialogue: 0,0:20:34.41,0:20:37.25,Default,,0000,0000,0000,,!جونكو... سامحيني
Dialogue: 0,0:20:39.74,0:20:42.36,Default,,0000,0000,0000,,!يا أبا جونكو-تشان! إنّها بخير
Dialogue: 0,0:20:42.50,0:20:44.73,Default,,0000,0000,0000,,!أوقفتُ المُختطف
Dialogue: 0,0:20:45.28,0:20:48.23,Default,,0000,0000,0000,,!أبي! أنا بخيرٍ الآن
Dialogue: 0,0:20:48.23,0:20:50.30,Default,,0000,0000,0000,,!لقد أنقذني
Dialogue: 0,0:20:50.30,0:20:51.20,Default,,0000,0000,0000,,...جونكو
Dialogue: 0,0:20:52.23,0:20:54.77,Default,,0000,0000,0000,,أأنتِ بأمان حقّاً؟
Dialogue: 0,0:20:56.06,0:20:59.15,Default,,0000,0000,0000,,...حمداً لله، حمداً لله
Dialogue: 0,0:21:03.59,0:21:05.12,Default,,0000,0000,0000,,...انتظر أيّها المجرم
Dialogue: 0,0:21:06.51,0:21:08.04,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:21:08.04,0:21:10.50,Default,,0000,0000,0000,,غلبته بمفردك؟
Dialogue: 0,0:21:10.50,0:21:14.03,Default,,0000,0000,0000,,كلا، في الواقع... لقد تفاجأ عندما رآني
Dialogue: 0,0:21:14.26,0:21:16.63,Default,,0000,0000,0000,,!وتعثر وأصاب رأسه
Dialogue: 0,0:21:18.28,0:21:20.07,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:22:55.64,0:22:56.98,Default,,0000,0000,0000,,...لقد تحطّم
Dialogue: 0,0:22:57.40,0:22:59.44,Default,,0000,0000,0000,,...آسف، آسف صدقاً
Dialogue: 0,0:22:59.81,0:23:01.72,Default,,0000,0000,0000,,يعني أنّه لا حاجة لهذا الشيء
Dialogue: 0,0:23:01.72,0:23:05.78,Default,,0000,0000,0000,,لكن كان مفيداً قبل تحطّمه\Nعلى الأقل يا ميتسوهيكو-كن
Dialogue: 0,0:23:07.14,0:23:08.23,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:23:08.83,0:23:10.19,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:23:10.97,0:23:13.16,Default,,0000,0000,0000,,!تبّاً! نسيت
Dialogue: 0,0:23:16.07,0:23:17.57,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:23:17.99,0:23:19.53,Default,,0000,0000,0000,,انتهت بالفعل؟
Dialogue: 0,0:23:20.83,0:23:25.49,Default,,0000,0000,0000,,كانت ركلة طالبة الثانويّة الفائزة \N!الاستدارية مُبهرة بحقّ
Dialogue: 0,0:23:25.56,0:23:29.49,Default,,0000,0000,0000,,أجل، تقصد موري ران، صحيح؟\N!كانت مذهلة
Dialogue: 0,0:23:30.45,0:23:33.57,Default,,0000,0000,0000,,فازت ران بركلتها الاستدارية الخاصة إذاً؟
Dialogue: 0,0:23:33.81,0:23:35.02,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:23:36.11,0:23:37.65,Default,,0000,0000,0000,,هل شاهدتني؟
Dialogue: 0,0:23:37.82,0:23:42.61,Default,,0000,0000,0000,,بـ-بالطبع! ركلتكِ الاستدارية التي حسمتِ\N !بها النهائيّ كانت مدهشة
Dialogue: 0,0:23:43.39,0:23:46.56,Default,,0000,0000,0000,,فزتُ بالركلة الاستدارية\Nفي نصف النهائيّ
Dialogue: 0,0:23:46.56,0:23:48.96,Default,,0000,0000,0000,,في النهائي فزتُ بعد انسحاب الخصم بسبب إصابته
Dialogue: 0,0:23:48.96,0:23:50.57,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:23:51.40,0:23:53.87,Default,,0000,0000,0000,,!أخلفتَ بوعدك، صحيح؟
Dialogue: 0,0:23:54.38,0:23:56.75,Default,,0000,0000,0000,,!آ-آسف
Dialogue: 0,0:24:05.09,0:24:07.96,Default,,0000,0000,0000,,أُطلق السهم من هذه النافذة إذاً؟
Dialogue: 0,0:24:10.08,0:24:11.50,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:24:11.96,0:24:15.13,Default,,0000,0000,0000,,...شظايا الزجاج متراصّة
Dialogue: 0,0:24:17.53,0:24:19.38,Default,,0000,0000,0000,,هناك جزءٌ زائل من السخام
Dialogue: 0,0:24:22.45,0:24:24.22,Default,,0000,0000,0000,,...قطعة خشبية لم تحترق
Dialogue: 0,0:24:24.11,0:24:30.10,On Top,,0000,0000,0000,,جريمة قتل ردّ جميل طائر الكركي
Dialogue: 0,0:24:24.78,0:24:26.24,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.24,0:24:28.98,Default,,0000,0000,0000,,جريمة قتل ردّ جميل طائر الكركي
Dialogue: 0,0:24:45.95,0:24:48.50,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.50,0:24:50.10,Default,,0000,0000,0000,,عشّ طيور
Dialogue: 0,0:24:50.10,0:24:51.79,Default,,0000,0000,0000,,!سيظهر حيوانٌ الحلقة القادمة
Dialogue: 0,0:24:51.79,0:24:53.62,Default,,0000,0000,0000,,!نمر! نمر! نمور
Dialogue: 0,0:24:53.62,0:24:54.53,Default,,0000,0000,0000,,!بل كركي
Dialogue: 0,0:24:54.53,0:24:57.61,Default,,0000,0000,0000,,كركي؟

