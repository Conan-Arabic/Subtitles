Dialogue: 0,0:00:01.45,0:00:02.79,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.79,0:00:05.98,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.98,0:00:08.60,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.90,0:00:11.85,Default,,0000,0000,0000,,!وقت قضيّة أخرى من حلقتين! لمّ شمل نادي العمّ
Dialogue: 0,0:00:11.85,0:00:15.60,Default,,0000,0000,0000,,!حتّى لو تفككت روابط صداقات الماضي، الحقيقة واحدة دوماً
Dialogue: 0,0:01:47.09,0:01:52.25,Default,,0000,0000,0000,,جريمة قتل مناسبة لمّ شمل كوغورو\N(الجزء الأوّل)
Dialogue: 0,0:01:52.47,0:01:55.66,Default,,0000,0000,0000,,لمَ لا تصطحبنا معك لمناسبة لمّ الشمل؟
Dialogue: 0,0:01:55.66,0:01:59.29,Default,,0000,0000,0000,,...ما قصدك؟ إنّه لمّ شمل خاصّ بي
Dialogue: 0,0:01:59.29,0:02:01.54,Default,,0000,0000,0000,,لكنك اصطحبتني للمناسبة قبل 5 أعوام
Dialogue: 0,0:02:01.54,0:02:04.29,Default,,0000,0000,0000,,لا يمكننا إغلاق المكتب
Dialogue: 0,0:02:04.29,0:02:06.95,Default,,0000,0000,0000,,ماذا لو تلقّينا قضيّةً كبيرة؟
Dialogue: 0,0:02:07.57,0:02:11.25,Default,,0000,0000,0000,,لن تكون موجوداً لقبولها وأنت في عطلة
Dialogue: 0,0:02:11.82,0:02:14.61,Default,,0000,0000,0000,,،نريد الذهاب للينبوع الساخن أيضاً\Nصحيح يا كونان-كن؟
Dialogue: 0,0:02:14.61,0:02:15.87,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:02:16.44,0:02:21.00,Default,,0000,0000,0000,,كنتُ سأعزمكما على عشاءٍ فاخر\N!في الواقع بدل اصطحابكما
Dialogue: 0,0:02:21.00,0:02:23.84,Default,,0000,0000,0000,,سنمتنع عن العشاء ونذهب في\Nرحلة الينبوع الساخن إذاً
Dialogue: 0,0:02:23.84,0:02:25.09,Default,,0000,0000,0000,,!لا تكوني حمقاء
Dialogue: 0,0:02:25.09,0:02:28.51,Default,,0000,0000,0000,,!أسعار الرحلات الداخلية أبهظ من الدولية مؤخراً
Dialogue: 0,0:02:28.51,0:02:31.75,Default,,0000,0000,0000,,!لا أريد دفع تذاكر 3 أشخاص\N!ضعي نفسك في موقفي
Dialogue: 0,0:02:32.43,0:02:33.88,Default,,0000,0000,0000,,هذا السبب الحقيقي؟
Dialogue: 0,0:02:34.67,0:02:36.50,Default,,0000,0000,0000,,!لصّ! سرق البنك
Dialogue: 0,0:02:37.70,0:02:39.17,Default,,0000,0000,0000,,...أيّها
Dialogue: 0,0:02:39.17,0:02:40.92,Default,,0000,0000,0000,,!انتظرا
Dialogue: 0,0:02:40.92,0:02:43.67,Default,,0000,0000,0000,,!توقف! لن تهرب منّي
Dialogue: 0,0:02:44.29,0:02:46.04,Default,,0000,0000,0000,,!تبّاً! لا تقترب وإلّا سأطلق
Dialogue: 0,0:02:53.63,0:02:54.38,Default,,0000,0000,0000,,!تبّاً لك
Dialogue: 0,0:03:03.27,0:03:06.76,Default,,0000,0000,0000,,!مُذهل! أمسكت بلصّ البنك يا أبي
Dialogue: 0,0:03:07.76,0:03:10.01,Default,,0000,0000,0000,,الأمر ببساطة أخذ حلوى\Nمن يد طفل
Dialogue: 0,0:03:10.01,0:03:13.09,Default,,0000,0000,0000,,!عندما يتدخل المتحرّي العظيم موري كوغورو
Dialogue: 0,0:03:14.14,0:03:15.42,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:03:15.42,0:03:18.79,Default,,0000,0000,0000,,ولد! كيف ركلت ذاك القرميد بتلك القوّة؟
Dialogue: 0,0:03:18.79,0:03:20.13,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:03:20.13,0:03:23.79,Default,,0000,0000,0000,,خـ-خلتُه سيُطلق عليك لذا ركلته بلا تفكير
Dialogue: 0,0:03:23.79,0:03:26.50,Default,,0000,0000,0000,,صادف أن أصاب مسدّس اللصّ وحسب
Dialogue: 0,0:03:26.50,0:03:30.74,Default,,0000,0000,0000,,أنقذتَ حياته إذاً؟
Dialogue: 0,0:03:30.74,0:03:32.21,Default,,0000,0000,0000,,...ر-ربما
Dialogue: 0,0:03:32.70,0:03:35.73,Default,,0000,0000,0000,,أنت تدين لمن أنقذ حياتك
Dialogue: 0,0:03:35.73,0:03:39.44,Default,,0000,0000,0000,,بأن تأخذه للينبوع الساخن إذاً يا أبي
Dialogue: 0,0:03:39.44,0:03:42.54,Default,,0000,0000,0000,,وسآتي بصفتي حارسة كونان-كن
Dialogue: 0,0:03:42.98,0:03:46.22,Default,,0000,0000,0000,,!لا علاقة هذا بذاك
Dialogue: 0,0:03:46.22,0:03:47.66,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:03:47.66,0:03:50.37,Default,,0000,0000,0000,,ماذا تفعل هنا؟
Dialogue: 0,0:03:50.64,0:03:51.97,Default,,0000,0000,0000,,!يومي
Dialogue: 0,0:03:51.97,0:03:53.64,Default,,0000,0000,0000,,ماذا تفعلين أنت هنا؟
Dialogue: 0,0:03:53.64,0:03:57.34,Default,,0000,0000,0000,,شركتي بالقرب فأتيتُ لتناول الغداء
Dialogue: 0,0:03:57.34,0:03:59.58,Default,,0000,0000,0000,,أنتِ هوريكوشي-سان، صحيح؟
Dialogue: 0,0:03:59.58,0:04:02.18,Default,,0000,0000,0000,,عجباً، أهذه أنت يا ران-تشان؟
Dialogue: 0,0:04:02.18,0:04:02.80,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:02.80,0:04:04.46,Default,,0000,0000,0000,,!مضى وقتٌ طويل
Dialogue: 0,0:04:04.46,0:04:06.75,Default,,0000,0000,0000,,ستأتين لمناسبة لمّ الشمل\Nعند الينبوع الساخن مُجدداً، صحيح؟
Dialogue: 0,0:04:06.75,0:04:08.91,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:04:08.91,0:04:10.58,Default,,0000,0000,0000,,...أنت، من قال
Dialogue: 0,0:04:10.58,0:04:11.79,Default,,0000,0000,0000,,!أتطلّع لرؤيتكما هناك
Dialogue: 0,0:04:11.79,0:04:14.42,Default,,0000,0000,0000,,...لحظة يا يومي! ران ليست
Dialogue: 0,0:04:16.44,0:04:18.96,Default,,0000,0000,0000,,...أنتما
Dialogue: 0,0:04:19.23,0:04:23.11,Default,,0000,0000,0000,,!عملٌ رائع يا موري كوغورو-دونو
Dialogue: 0,0:04:23.11,0:04:25.35,Default,,0000,0000,0000,,!شكراً على مساعدتك
Dialogue: 0,0:04:26.35,0:04:29.25,Default,,0000,0000,0000,,لم يكن شيئاً يُذكر
Dialogue: 0,0:04:29.60,0:04:34.71,Default,,0000,0000,0000,,لن تأخذ المسدّس الذي كان\Nبحوزة اللصّ يا عمّ؟
Dialogue: 0,0:04:34.71,0:04:36.95,Default,,0000,0000,0000,,معك حق، إنّه هناك
Dialogue: 0,0:04:39.59,0:04:44.17,Default,,0000,0000,0000,,غريب، أنا متأكد أنّ مسدّسه سقط هنا
Dialogue: 0,0:04:44.17,0:04:45.62,Default,,0000,0000,0000,,!اختفى؟
Dialogue: 0,0:04:45.62,0:04:49.00,Default,,0000,0000,0000,,أيمكن أنّ أحداً من الشارع أخذه وهرب
Dialogue: 0,0:04:49.00,0:04:50.75,Default,,0000,0000,0000,,!أثناء الجلبة؟
Dialogue: 0,0:04:50.75,0:04:52.66,Default,,0000,0000,0000,,!ماذا؟! هذا سيّئ
Dialogue: 0,0:04:52.66,0:04:54.70,Default,,0000,0000,0000,,!علينا إخبار المقرّ الرئيسي واستعادته فوراً
Dialogue: 0,0:04:54.70,0:04:56.49,Default,,0000,0000,0000,,كيف هذا؟
Dialogue: 0,0:04:56.49,0:04:58.78,Default,,0000,0000,0000,,!شاح نظرنا قليلاً فقط
Dialogue: 0,0:04:58.78,0:05:00.06,Default,,0000,0000,0000,,من عساه يأخذه؟
Dialogue: 0,0:05:11.43,0:05:13.92,Default,,0000,0000,0000,,الأكل أثناء رحلة رائعٌ جدّاً، صحيح؟
Dialogue: 0,0:05:13.92,0:05:15.09,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:05:15.09,0:05:18.87,Default,,0000,0000,0000,,لمَ عليّ أخذ ذاك الصبيّ للمّ الشمل معي؟
Dialogue: 0,0:05:19.88,0:05:23.79,Default,,0000,0000,0000,,أين المشكلة؟ فقد اصطحبتني للمناسبة قبل 5 أعوام
Dialogue: 0,0:05:24.34,0:05:29.66,Default,,0000,0000,0000,,كنتِ صغيرةً آنذاك فلم أستطع تركك \Nفي البيت بمفردك
Dialogue: 0,0:05:29.66,0:05:32.41,Default,,0000,0000,0000,,لم تكن لتتمكن من حضور لمّ الشمل هذا
Dialogue: 0,0:05:32.41,0:05:35.24,Default,,0000,0000,0000,,!لو لم ينقذ كونان-كن حياتك
Dialogue: 0,0:05:36.49,0:05:41.17,Default,,0000,0000,0000,,كنتُ سأقبض على ذاك التافه بسهولة\N!دون مساعدة الصبيّ
Dialogue: 0,0:05:42.31,0:05:45.95,Default,,0000,0000,0000,,أخبرني يا عمّ، هل وجدوا المسدّس المفقود؟
Dialogue: 0,0:05:46.31,0:05:49.94,Default,,0000,0000,0000,,...صحيح، ما القصّة؟ لم تعلن الشرطة شيئاً بعد
Dialogue: 0,0:05:49.94,0:05:54.14,Default,,0000,0000,0000,,يبدو أنّ الشرطة تتحرّى بعناية
Dialogue: 0,0:05:54.14,0:05:56.72,Default,,0000,0000,0000,,لكنه لم يُستخدم في جرائم أخرى
Dialogue: 0,0:05:56.72,0:05:59.05,Default,,0000,0000,0000,,ولا بحوزتهم أيّ خيوط وفقما يبدو
Dialogue: 0,0:05:59.05,0:06:03.05,Default,,0000,0000,0000,,كان ذاك المسدّس من صنف\Nسميث آند ويسّون إم439
Dialogue: 0,0:06:03.05,0:06:06.25,Default,,0000,0000,0000,,ذاك السارق لم يكن مُلماً بالمسدّسات
Dialogue: 0,0:06:06.25,0:06:08.12,Default,,0000,0000,0000,,دفع مالاً باهظاً مقابله
Dialogue: 0,0:06:08.12,0:06:11.25,Default,,0000,0000,0000,,لكنه لم يعرف الفرق بين المسدّس الحقيقيّ والنموذج
Dialogue: 0,0:06:12.58,0:06:14.66,Default,,0000,0000,0000,,...آمل أنّه كان مجرّد نموذج
Dialogue: 0,0:06:14.66,0:06:18.54,Default,,0000,0000,0000,,كلا، لم يتحطم ذاك المسدّس عندما أصبته
Dialogue: 0,0:06:21.46,0:06:24.03,Default,,0000,0000,0000,,،لذا إن دفع مقابله
Dialogue: 0,0:06:24.03,0:06:25.79,Default,,0000,0000,0000,,فكان حقيقياً على الأرجح
Dialogue: 0,0:06:29.25,0:06:32.21,On Top,,0000,0000,0000,,منتجع ينابيع ساخنة\Nبينكي
Dialogue: 0,0:06:51.58,0:06:53.75,Default,,0000,0000,0000,,مضى وقتٌ طويل
Dialogue: 0,0:06:53.75,0:06:54.91,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:06:54.91,0:06:58.12,Default,,0000,0000,0000,,هذه أوّل مرة نلتقي مُذ\Nلمّ الشمل قبل 5 أعوام
Dialogue: 0,0:06:58.12,0:07:03.04,Default,,0000,0000,0000,,أجل، نحن أعضاء نادي الجودو لجامعة بيكا
Dialogue: 0,0:07:03.45,0:07:07.25,Default,,0000,0000,0000,,...ذكريات أيام التمرين الشاق تعود لي
Dialogue: 0,0:07:07.51,0:07:11.46,Default,,0000,0000,0000,,!ما الذي تقوله؟ بالكاد أتيت للتمارين
Dialogue: 0,0:07:11.46,0:07:14.44,Default,,0000,0000,0000,,معه حق! تغيّبت عن التمارين باستمرار
Dialogue: 0,0:07:14.44,0:07:18.60,Default,,0000,0000,0000,,،لقولك أنّ العباقرة لا يحتاجون للتمرين\Nصحيح يا موري-كن؟
Dialogue: 0,0:07:18.60,0:07:22.67,Default,,0000,0000,0000,,كنتَ الوحيد الذي لم يفز\Nبأيّ مباراة في النهاية
Dialogue: 0,0:07:23.01,0:07:24.96,Default,,0000,0000,0000,,...كان ذلك بسبب
Dialogue: 0,0:07:24.96,0:07:26.02,Default,,0000,0000,0000,,كنتُ أعرف
Dialogue: 0,0:07:26.02,0:07:27.79,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:07:27.79,0:07:30.54,Default,,0000,0000,0000,,كنتَ تكذب وأنت تقول أنّ لا أحد استطاع قهرك
Dialogue: 0,0:07:30.54,0:07:32.63,Default,,0000,0000,0000,,أيام الجامعة، صحيح يا أبي؟
Dialogue: 0,0:07:32.63,0:07:35.12,Default,,0000,0000,0000,,!ران-تشان! تسرني رؤيتك مُجدداً
Dialogue: 0,0:07:35.12,0:07:39.25,Default,,0000,0000,0000,,!التقيتُها سابقاً اليوم، كبرت حقاً
Dialogue: 0,0:07:40.08,0:07:41.49,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:07:41.49,0:07:44.24,Default,,0000,0000,0000,,أين كنتِ طوال هذا الوقت؟
Dialogue: 0,0:07:44.24,0:07:45.52,Default,,0000,0000,0000,,في حمّام الهواء الطلق
Dialogue: 0,0:07:45.52,0:07:46.86,Default,,0000,0000,0000,,!حمّام الهواء الطلق؟
Dialogue: 0,0:07:46.86,0:07:49.25,Default,,0000,0000,0000,,!ذاك حمّام مُختلط
Dialogue: 0,0:07:49.25,0:07:51.92,Default,,0000,0000,0000,,لا بأس، لم يكن هناك أحد
Dialogue: 0,0:07:52.19,0:07:53.59,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:07:54.76,0:07:55.37,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:07:55.68,0:07:59.51,Default,,0000,0000,0000,,!هـ-هل استحممتما معاً؟
Dialogue: 0,0:07:59.51,0:08:00.43,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:00.43,0:08:03.84,Default,,0000,0000,0000,,،كان من الصعب أخذ كونان-كن معي\Nفالإحراج غلب عليه
Dialogue: 0,0:08:05.05,0:08:09.38,Default,,0000,0000,0000,,!لكن كان ذلك مُسلياً، مسحنا أظهر بعضنا حتّى
Dialogue: 0,0:08:09.38,0:08:10.92,Default,,0000,0000,0000,,نزيف أنف؟
Dialogue: 0,0:08:10.92,0:08:12.79,Default,,0000,0000,0000,,ربما دفع الاستحمام دمك لرأسك
Dialogue: 0,0:08:13.00,0:08:16.62,Default,,0000,0000,0000,,أليست ردّة فعله المفرطة\Nمن رؤيتك عارية وحسب؟
Dialogue: 0,0:08:16.62,0:08:20.58,Default,,0000,0000,0000,,بالطبع لا، فهو لا يزال صبيّاً
Dialogue: 0,0:08:21.33,0:08:24.79,Default,,0000,0000,0000,,ستقتلني لو اكتشفت هويّتي حتماً
Dialogue: 0,0:08:24.79,0:08:28.78,Default,,0000,0000,0000,,!هذا الصبيّ الذي كان يعتني به موري-كن
Dialogue: 0,0:08:28.78,0:08:30.40,Default,,0000,0000,0000,,يا للفتى الظريف
Dialogue: 0,0:08:30.40,0:08:31.67,Default,,0000,0000,0000,,سُررت بلقائكم
Dialogue: 0,0:08:32.57,0:08:36.27,On Top,,0000,0000,0000,,أنا نجم جودو بيكا، أياشيرو
Dialogue: 0,0:08:32.67,0:08:37.60,CharCard,,0000,0000,0000,,مدرس تربية بدنية في الثانوية\N(أياشيرو يوكيو (38
Dialogue: 0,0:08:36.27,0:08:37.62,On Top,,0000,0000,0000,,سُررت بلقائك يا فتى
Dialogue: 0,0:08:38.14,0:08:41.72,On Top,,0000,0000,0000,,أنا أومورا جون، حامل راية المخاطرة لنادي الجودو
Dialogue: 0,0:08:38.32,0:08:44.09,CharCard,,0000,0000,0000,,مدير متجر نماذج\N(أومورا جون (37
Dialogue: 0,0:08:41.72,0:08:44.09,On Top,,0000,0000,0000,,!كنتُ معروفاً بـ جامع النقاط
Dialogue: 0,0:08:44.63,0:08:48.54,On Top,,0000,0000,0000,,!أنا مديرة نادي الجودو الجميلة، هوريكوشي يومي
Dialogue: 0,0:08:44.89,0:08:48.54,CharCard,,0000,0000,0000,,موظفة في شركة مستحضرات تجميل\N(هوريكوشي يومي (37
Dialogue: 0,0:08:49.09,0:08:50.46,On Top,,0000,0000,0000,,...اسمي قبل الزواج كان
Dialogue: 0,0:08:49.64,0:08:57.00,CharCard,,0000,0250,0010,,ربّة بيت\Nأياشيرو نوريكو
Dialogue: 0,0:08:50.46,0:08:53.88,On Top,,0000,0000,0000,,كيموتو نوريكو، وكنتُ مديرةً أيضاً\N !ونجمة نادي الجودو الفنّانة
Dialogue: 0,0:08:53.88,0:08:57.00,On Top,,0000,0000,0000,,زوجة هذا الرجل الآن
Dialogue: 0,0:08:57.37,0:09:01.29,On Top,,0000,0000,0000,,أنا كنتُ القائد والعمود الفقري للفريق، ناكاميتشي كازوشي
Dialogue: 0,0:08:57.83,0:09:03.46,CharCard,,0000,0000,0000,,محقّق في شرطة تشيبا\N(ناكاميتشي كازوشي (38
Dialogue: 0,0:09:01.29,0:09:03.46,On Top,,0000,0000,0000,,أعمل محققاً الآن في محافظة تشيبا
Dialogue: 0,0:09:04.00,0:09:08.07,Default,,0000,0000,0000,,ولم أترك عملي في منتصف الطريق\Nمثل هذا الشخص بالطبع
Dialogue: 0,0:09:08.07,0:09:08.91,Default,,0000,0000,0000,,!اخرس
Dialogue: 0,0:09:12.19,0:09:15.24,Default,,0000,0000,0000,,...كلّهم نجوم جودو أو فنّ
Dialogue: 0,0:09:16.98,0:09:22.27,Default,,0000,0000,0000,,والغنيّ عن التعريف، أقوى أستاذ جودو\N...في بيكا والمتحرّي العظيم
Dialogue: 0,0:09:22.27,0:09:23.21,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:09:23.73,0:09:26.09,Default,,0000,0000,0000,,أهو ألبوم صور من أيام الجامعة؟
Dialogue: 0,0:09:26.09,0:09:28.58,Default,,0000,0000,0000,,صحيح، أحضرته كي نتصفحه جميعاً
Dialogue: 0,0:09:29.09,0:09:32.88,Default,,0000,0000,0000,,!أنتم! أصغوا عندما يتكلّم الآخرون
Dialogue: 0,0:09:32.88,0:09:34.40,Default,,0000,0000,0000,,أيمكنني أن أرى؟
Dialogue: 0,0:09:34.40,0:09:36.00,Default,,0000,0000,0000,,بالطبع، تفضّلي
Dialogue: 0,0:09:38.50,0:09:42.00,Default,,0000,0000,0000,,!هذه وقت فوزنا بالمركز الثاني في بطولة المدينة
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0000,0000,0000,,!أتذكر ذلك
Dialogue: 0,0:09:44.33,0:09:46.49,Default,,0000,0000,0000,,كلّنا يافعون
Dialogue: 0,0:09:46.49,0:09:47.41,Default,,0000,0000,0000,,...تذكّرت
Dialogue: 0,0:09:47.86,0:09:52.38,Default,,0000,0000,0000,,كنتما تتواعدان يا ناكاميتشي ويومي وقتها، صحيح؟
Dialogue: 0,0:09:52.86,0:09:57.02,Default,,0000,0000,0000,,أجل، بكينا سويّاً وقتها، صحيح يا أومورا؟
Dialogue: 0,0:09:57.02,0:09:57.75,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:58.39,0:10:02.13,Default,,0000,0000,0000,,كنتِ حسناء نادي الجودو بحقّ
Dialogue: 0,0:10:03.02,0:10:06.22,Default,,0000,0000,0000,,!يكفي، أنت زوجي الآن
Dialogue: 0,0:10:06.22,0:10:07.12,Default,,0000,0000,0000,,أجل، أجل
Dialogue: 0,0:10:07.68,0:10:10.38,Default,,0000,0000,0000,,...أيمكن أنّكما لا تزالان
Dialogue: 0,0:10:10.38,0:10:14.09,Default,,0000,0000,0000,,لا تكن سخيفاً! هجرتُ هذا الأحمق\Nقبل وقتٍ طويل
Dialogue: 0,0:10:14.09,0:10:17.12,Default,,0000,0000,0000,,...كما أنّه اختار من سيتزوّجها بالفعل
Dialogue: 0,0:10:17.50,0:10:18.75,Default,,0000,0000,0000,,
Dialogue: 0,0:10:18.75,0:10:19.71,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:10:20.21,0:10:22.42,Default,,0000,0000,0000,,!ستتزوّج يا ناكاميتشي-كن؟
Dialogue: 0,0:10:22.42,0:10:23.67,Default,,0000,0000,0000,,!صدقاً؟
Dialogue: 0,0:10:24.04,0:10:28.11,Default,,0000,0000,0000,,أجل، كنتُ أتمنى أن أعلن بشكلٍ لائق أكثر
Dialogue: 0,0:10:28.11,0:10:29.92,Default,,0000,0000,0000,,سيُعقد الزفاف في وقتٍ ما هذا العام
Dialogue: 0,0:10:29.92,0:10:31.29,Default,,0000,0000,0000,,!ومن هي؟
Dialogue: 0,0:10:32.03,0:10:33.66,Default,,0000,0000,0000,,...ابنة مديري
Dialogue: 0,0:10:33.66,0:10:36.10,Default,,0000,0000,0000,,التقينا قبل 6 أشهر
Dialogue: 0,0:10:36.10,0:10:38.08,Default,,0000,0000,0000,,سأعرّفكم عليها يوماً ما
Dialogue: 0,0:10:39.19,0:10:43.52,Default,,0000,0000,0000,,وفي الجانب الآخر حسناء الماضي\N...لا تزال امرأة عزباء
Dialogue: 0,0:10:43.52,0:10:47.96,Default,,0000,0000,0000,,...وقد أفقد عملي فوقها نظراً للاقتصاد المتدهور
Dialogue: 0,0:10:48.26,0:10:50.91,Default,,0000,0000,0000,,...أتمنّى لو كنت ميتة حقاً
Dialogue: 0,0:10:54.01,0:10:57.58,Default,,0000,0000,0000,,!أمزح فقط! أردت رؤية ردّة فعلكم فقط
Dialogue: 0,0:10:57.58,0:11:00.42,Default,,0000,0000,0000,,!لا تخيفينا هكذا يا يومي
Dialogue: 0,0:11:00.92,0:11:05.82,Default,,0000,0000,0000,,لكن هذا يعني أنّي وأومورا\Nآخر من لم يتزوّج
Dialogue: 0,0:11:06.70,0:11:09.45,Default,,0000,0000,0000,,!ربما علينا الزواج
Dialogue: 0,0:11:09.45,0:11:11.57,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:11:11.57,0:11:14.83,Default,,0000,0000,0000,,!كانت مزحة يا أحمق! لا تأخذها بجديّة
Dialogue: 0,0:11:19.23,0:11:24.35,Default,,0000,0000,0000,,ماذا؟ أليست هذه الصورة\Nمن قدومنا هنا قبل 5 أعوام؟
Dialogue: 0,0:11:24.35,0:11:26.41,Default,,0000,0000,0000,,انظري، أنا فيها أيضاً
Dialogue: 0,0:11:26.41,0:11:27.93,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:11:27.93,0:11:30.55,Default,,0000,0000,0000,,التقطناها في غرفة كرة الطاولة
Dialogue: 0,0:11:30.55,0:11:31.88,Default,,0000,0000,0000,,أضفتها للألبوم
Dialogue: 0,0:11:32.22,0:11:36.09,Default,,0000,0000,0000,,وجدتُها، لمَ لا نلعب كرة طاولة الآن جميعاً؟
Dialogue: 0,0:11:36.09,0:11:37.08,Default,,0000,0000,0000,,!فكرة حسنة
Dialogue: 0,0:11:37.08,0:11:38.54,Default,,0000,0000,0000,,!لنلعب
Dialogue: 0,0:11:38.54,0:11:42.50,Default,,0000,0000,0000,,لكن يُفترض أن نشاهد\Nالألعاب النارية مساءً
Dialogue: 0,0:11:42.50,0:11:45.83,Default,,0000,0000,0000,,لا تقلقي، تبدأ الألعاب النارية عند السادسة والنصف
Dialogue: 0,0:11:45.83,0:11:47.45,Default,,0000,0000,0000,,لا تزال أمامنا أكثر من 3 ساعات
Dialogue: 0,0:11:47.45,0:11:49.37,Default,,0000,0000,0000,,سنلحق إذا انتهينا قبل السادسة
Dialogue: 0,0:11:50.33,0:11:51.88,Default,,0000,0000,0000,,سأمتنع
Dialogue: 0,0:11:51.88,0:11:55.16,Default,,0000,0000,0000,,أشعر بإرهاق لسببٍ ما لذا سأستريح في غرفتي
Dialogue: 0,0:11:55.61,0:11:57.52,Default,,0000,0000,0000,,...إنّها لا تتغيّر
Dialogue: 0,0:11:57.52,0:11:59.86,Default,,0000,0000,0000,,...لا تقوم بشيءٍ إلا على هواها
Dialogue: 0,0:11:59.86,0:12:03.08,Default,,0000,0000,0000,,لا تريد أن يسحبها الآخرون لأيّ شيء وحسب
Dialogue: 0,0:12:03.40,0:12:05.60,Default,,0000,0000,0000,,!لنلعب كرة الطاولة بأيّ حال
Dialogue: 0,0:12:05.60,0:12:08.43,Default,,0000,0000,0000,,!كرة الطاولة والينابيع الساخنة يتماشيان معاً حقاً
Dialogue: 0,0:12:08.43,0:12:10.81,Default,,0000,0000,0000,,!لم أشعر بهذا الحماس منذ وقت طويل
Dialogue: 0,0:12:10.81,0:12:14.01,Default,,0000,0000,0000,,لا يمكنني أن أخسر أمامكم وأنا أستاذ رياضة
Dialogue: 0,0:12:14.01,0:12:15.99,On Top,,0000,0000,0000,,غرفة كرة الطاولة
Dialogue: 0,0:12:20.12,0:12:22.46,Default,,0000,0000,0000,,!رائع! استعدّ لواحدة أخرى
Dialogue: 0,0:12:22.46,0:12:23.90,Default,,0000,0000,0000,,!هات ما لديك
Dialogue: 0,0:12:23.90,0:12:24.60,Default,,0000,0000,0000,,أين تذهب؟
Dialogue: 0,0:12:24.60,0:12:25.58,Default,,0000,0000,0000,,دورة المياه
Dialogue: 0,0:12:25.58,0:12:28.20,Default,,0000,0000,0000,,دورك التالي لذا أسرع قليلاً
Dialogue: 0,0:12:28.20,0:12:29.33,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:12:29.33,0:12:30.83,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:12:30.83,0:12:35.08,Default,,0000,0000,0000,,ألم تفز بجائزة فردية في مسابقة\Nوطنية قبلاً يا ناكاميتشي-سان؟
Dialogue: 0,0:12:35.08,0:12:38.50,Default,,0000,0000,0000,,بلى، مرّةً فقط في سنتي الثالثة في الجامعة
Dialogue: 0,0:12:39.11,0:12:43.36,Default,,0000,0000,0000,,كنتَ أقوى عضوٍ في النادي بالفعل إذاً
Dialogue: 0,0:12:43.36,0:12:46.47,Default,,0000,0000,0000,,كلا، كان هناك شاب أقوى منّي
Dialogue: 0,0:12:46.47,0:12:50.10,Default,,0000,0000,0000,,لم أستطع هزيمته ولا لمرّة
Dialogue: 0,0:12:50.10,0:12:51.75,Default,,0000,0000,0000,,كان هناك شخص بتلك القوّة؟
Dialogue: 0,0:12:52.22,0:12:55.66,Default,,0000,0000,0000,,تعرفينه جيّداً يا ران-تشان، فهو يقيم في هذا النُزل
Dialogue: 0,0:12:55.66,0:12:57.87,Default,,0000,0000,0000,,!مـ-من هو؟
Dialogue: 0,0:13:00.92,0:13:03.08,Default,,0000,0000,0000,,!الكُرات المنحرفة ليست عادلة
Dialogue: 0,0:13:04.33,0:13:05.85,Default,,0000,0000,0000,,...إنّه
Dialogue: 0,0:13:06.96,0:13:09.50,Default,,0000,0000,0000,,ما-ماذا حصل؟ كان ذلك سريعاً
Dialogue: 0,0:13:09.50,0:13:11.04,Default,,0000,0000,0000,,...كلا، لا شيء
Dialogue: 0,0:13:20.68,0:13:21.70,Default,,0000,0000,0000,,!هاك يا يوكيو-سان
Dialogue: 0,0:13:21.70,0:13:22.35,Default,,0000,0000,0000,,لك يا نوريكو
Dialogue: 0,0:13:22.35,0:13:24.14,Default,,0000,0000,0000,,!يا لسخافتك
Dialogue: 0,0:13:24.14,0:13:27.94,Default,,0000,0000,0000,,إلى متى ستلعبان بهذه الحماقة؟
Dialogue: 0,0:13:29.21,0:13:30.90,Default,,0000,0000,0000,,ألم يحن الوقت؟
Dialogue: 0,0:13:31.86,0:13:33.82,Default,,0000,0000,0000,,!تبّاً! تجاوزت السادسة
Dialogue: 0,0:13:34.01,0:13:38.78,Default,,0000,0000,0000,,!كلا! علينا الإسراع وإلا سيكتظّ المكان
Dialogue: 0,0:13:38.78,0:13:40.32,Default,,0000,0000,0000,,!لنسرع
Dialogue: 0,0:13:41.49,0:13:45.83,Default,,0000,0000,0000,,سأعيد المضارب والشبكة لذا اسبقوني\Nواحجزوا مكاناً
Dialogue: 0,0:13:45.83,0:13:47.49,Default,,0000,0000,0000,,!حسناً، فهمت
Dialogue: 0,0:13:50.90,0:13:52.86,Default,,0000,0000,0000,,!نسينا إيقاظ يومي-سان
Dialogue: 0,0:13:53.15,0:13:55.82,Default,,0000,0000,0000,,دعيها، ستبدأ الألعاب النارية الآن
Dialogue: 0,0:13:55.82,0:13:57.93,Default,,0000,0000,0000,,أوقظها أحد بالتأكيد
Dialogue: 0,0:13:57.93,0:13:59.60,Default,,0000,0000,0000,,لكن ماذا لو نسينا جميعاً؟
Dialogue: 0,0:13:59.60,0:14:01.13,Default,,0000,0000,0000,,سأذهب للتأكد
Dialogue: 0,0:14:01.13,0:14:02.52,Default,,0000,0000,0000,,!سأرافقك
Dialogue: 0,0:14:02.52,0:14:03.39,Default,,0000,0000,0000,,!انتظرا
Dialogue: 0,0:14:04.73,0:14:07.19,Default,,0000,0000,0000,,يا إلهي، كان عليهما تركها وشأنها
Dialogue: 0,0:14:14.92,0:14:17.33,Default,,0000,0000,0000,,!كلا! بدأت
Dialogue: 0,0:14:19.21,0:14:20.83,Default,,0000,0000,0000,,!علينا إيقاظها سريعاً
Dialogue: 0,0:14:31.45,0:14:33.78,Default,,0000,0000,0000,,الغرفة 201، هذه غرفتها
Dialogue: 0,0:14:35.99,0:14:37.31,Default,,0000,0000,0000,,يومي-سان؟
Dialogue: 0,0:14:37.31,0:14:38.64,Default,,0000,0000,0000,,يومي-سان؟
Dialogue: 0,0:14:38.64,0:14:40.98,Default,,0000,0000,0000,,بدأت الألعاب النارية
Dialogue: 0,0:14:40.98,0:14:42.85,Default,,0000,0000,0000,,سأدخل يا يومي-سان
Dialogue: 0,0:14:42.85,0:14:46.35,Default,,0000,0000,0000,,ماذا؟ إنّهما أنتما يا ران-تشان وكونان-كن
Dialogue: 0,0:14:46.35,0:14:47.68,Default,,0000,0000,0000,,ناكاميتشي-سان
Dialogue: 0,0:14:47.68,0:14:49.88,Default,,0000,0000,0000,,لم تسبقانا؟
Dialogue: 0,0:14:49.88,0:14:52.32,Default,,0000,0000,0000,,أتينا لإيقاظ يومي-سان
Dialogue: 0,0:14:53.09,0:14:54.93,Default,,0000,0000,0000,,لا يُستحسن بكما ذلك
Dialogue: 0,0:14:54.93,0:14:57.90,Default,,0000,0000,0000,,فمزاجها يتعكّر عندما يوقظها أحد
Dialogue: 0,0:14:58.12,0:15:00.32,Default,,0000,0000,0000,,ماذا تفعل أنت هنا يا ناكاميتشي-سان؟
Dialogue: 0,0:15:00.32,0:15:03.17,Default,,0000,0000,0000,,دخلتُ الحمّام بما أنّي تعرّقت كثيراً في اللعب
Dialogue: 0,0:15:03.17,0:15:05.87,Default,,0000,0000,0000,,ثمّ سمعتكما تركضان
Dialogue: 0,0:15:06.17,0:15:11.15,Default,,0000,0000,0000,,ظننتُ الأمر غريباً بما أنّنا الوحيدون المقيمون \Nفي هذا النُزل
Dialogue: 0,0:15:12.24,0:15:14.49,Default,,0000,0000,0000,,ماذا؟ كنتما لا تزالان هنا؟
Dialogue: 0,0:15:14.49,0:15:16.94,Default,,0000,0000,0000,,...أنت أيضاً
Dialogue: 0,0:15:16.94,0:15:20.45,Default,,0000,0000,0000,,كنت تغسل عرقك إذاً؟
Dialogue: 0,0:15:20.98,0:15:24.95,Default,,0000,0000,0000,,أجل، لكنّي كنت في الحمّام العام بخلافكما
Dialogue: 0,0:15:24.95,0:15:28.93,Default,,0000,0000,0000,,لكن يا ران-تشان، كان عدم إيقاظك\Nليومي الخيار الصحيح
Dialogue: 0,0:15:28.93,0:15:31.30,Default,,0000,0000,0000,,فمزاجها مريع عندما تستيقظ
Dialogue: 0,0:15:31.30,0:15:31.95,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:15:31.95,0:15:36.47,Default,,0000,0000,0000,,لكنها ستغضب بأيّ حال بما أنّنا لم نوقظها
Dialogue: 0,0:15:36.47,0:15:37.86,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:15:43.13,0:15:46.03,Default,,0000,0000,0000,,المكان مزدحم حقاً، لا تفلت يدي يا كونان-كن
Dialogue: 0,0:15:46.03,0:15:46.64,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:15:47.12,0:15:49.24,Default,,0000,0000,0000,,!هنا يا ران
Dialogue: 0,0:15:50.03,0:15:51.99,Default,,0000,0000,0000,,أنتما فقط؟
Dialogue: 0,0:15:51.99,0:15:54.74,Default,,0000,0000,0000,,...ماذا؟ كان الجميع رفقتنا
Dialogue: 0,0:15:54.74,0:15:57.44,Default,,0000,0000,0000,,انفصلوا عنّا في الازدحام
Dialogue: 0,0:15:58.15,0:16:00.65,Default,,0000,0000,0000,,سأذهب للبحث عنهما
Dialogue: 0,0:16:00.65,0:16:02.69,Default,,0000,0000,0000,,!انتظر، أومورا
Dialogue: 0,0:16:03.36,0:16:05.69,Default,,0000,0000,0000,,يبدو شخصاً كثير القلق، صحيح؟
Dialogue: 0,0:16:05.69,0:16:07.35,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:16:08.22,0:16:09.57,Default,,0000,0000,0000,,!أنتم لا تُعقلون
Dialogue: 0,0:16:09.57,0:16:12.72,Default,,0000,0000,0000,,عانيتُ وأومورا في إيجاد مكان
Dialogue: 0,0:16:12.72,0:16:14.39,Default,,0000,0000,0000,,!لكن لم يأت أحدكم
Dialogue: 0,0:16:14.39,0:16:15.62,Default,,0000,0000,0000,,!نحن آسفون
Dialogue: 0,0:16:15.97,0:16:18.79,Default,,0000,0000,0000,,كما لم يعد أومورا بعد ذهابه للبحث
Dialogue: 0,0:16:18.79,0:16:20.46,Default,,0000,0000,0000,,كما هي العادة
Dialogue: 0,0:16:20.46,0:16:23.50,Default,,0000,0000,0000,,آسف، نسيتُ أين مكاننا
Dialogue: 0,0:16:23.50,0:16:25.33,Default,,0000,0000,0000,,!اشرب وانس فقط
Dialogue: 0,0:16:25.75,0:16:28.74,Default,,0000,0000,0000,,!تقومون بالأمور وفق هواكم كثيراً
Dialogue: 0,0:16:28.74,0:16:31.28,Default,,0000,0000,0000,,لم تستيقظ يومي-سان بعد؟
Dialogue: 0,0:16:31.28,0:16:33.24,Default,,0000,0000,0000,,...ماذا؟ صحيح، معك حق
Dialogue: 0,0:16:33.24,0:16:36.08,Default,,0000,0000,0000,,يُفترض أنّها استيقظت
Dialogue: 0,0:16:36.37,0:16:41.48,Default,,0000,0000,0000,,لا بدّ أنّها منزعجة\Nلأنّ الألعاب النارية فاتتها
Dialogue: 0,0:16:41.48,0:16:43.98,Default,,0000,0000,0000,,...يا إلهي، أنتم جميعاً
Dialogue: 0,0:16:43.98,0:16:45.49,Default,,0000,0000,0000,,لا خيار لدينا
Dialogue: 0,0:16:46.19,0:16:50.03,Default,,0000,0000,0000,,ما رأيكم أن نذهب جميعاً\Nونوقظ حسناء نادي الجودو؟
Dialogue: 0,0:16:50.31,0:16:52.22,Default,,0000,0000,0000,,!حسناً، هيّا بنا
Dialogue: 0,0:16:52.22,0:16:55.47,Default,,0000,0000,0000,,لن تخافوا إن أوقظتم المرأة المزاجية معاً؟
Dialogue: 0,0:16:55.47,0:16:57.99,Default,,0000,0000,0000,,!احذر، لا تقل ذلك أمام يومي
Dialogue: 0,0:17:00.30,0:17:02.34,Default,,0000,0000,0000,,!يومي، وقت العشاء
Dialogue: 0,0:17:02.34,0:17:04.00,Default,,0000,0000,0000,,!يومي
Dialogue: 0,0:17:04.00,0:17:04.99,Default,,0000,0000,0000,,...غريب
Dialogue: 0,0:17:05.63,0:17:08.44,Default,,0000,0000,0000,,...لا تزالين نائمة؟ سأشغّل الإنارة
Dialogue: 0,0:17:23.28,0:17:24.16,Default,,0000,0000,0000,,!يومي
Dialogue: 0,0:17:24.16,0:17:25.12,Default,,0000,0000,0000,,!لا تلمسيها
Dialogue: 0,0:17:25.12,0:17:29.47,Default,,0000,0000,0000,,!لا يدخل أحد هذه الغرفة سوى المحققين، أنا وموري
Dialogue: 0,0:17:29.47,0:17:31.03,Default,,0000,0000,0000,,!ران-كن، اتّصلي بالشرطة بسرعة
Dialogue: 0,0:17:32.47,0:17:33.29,Default,,0000,0000,0000,,!بسرعة
Dialogue: 0,0:17:33.29,0:17:34.20,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:17:35.91,0:17:37.26,Default,,0000,0000,0000,,...يومي
Dialogue: 0,0:17:40.05,0:17:41.11,Default,,0000,0000,0000,,إنّها ميتة
Dialogue: 0,0:17:41.76,0:17:43.57,Default,,0000,0000,0000,,ثقب رصاصة في صدغها
Dialogue: 0,0:17:43.57,0:17:45.28,Default,,0000,0000,0000,,...ومسدّس في يدها اليُمنى
Dialogue: 0,0:17:46.58,0:17:51.49,Default,,0000,0000,0000,,!عمّ! أيمكن أنّه مسدّس سارق البنك؟
Dialogue: 0,0:17:51.49,0:17:52.86,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:52.86,0:17:56.82,Default,,0000,0000,0000,,!إنّه سميث آند ويسّون إم439 حقاً
Dialogue: 0,0:17:57.44,0:18:00.36,Default,,0000,0000,0000,,!وهناك آثار ضرب شيء للأسطوانة
Dialogue: 0,0:18:00.36,0:18:03.95,Default,,0000,0000,0000,,...كما أنّ يومي كانت في المكان
Dialogue: 0,0:18:04.15,0:18:06.65,Default,,0000,0000,0000,,ماذا تفعل هنا؟
Dialogue: 0,0:18:06.98,0:18:08.31,Default,,0000,0000,0000,,!يومي
Dialogue: 0,0:18:08.31,0:18:09.98,Default,,0000,0000,0000,,ماذا تفعلين أنت هنا؟
Dialogue: 0,0:18:09.98,0:18:13.62,Default,,0000,0000,0000,,شركتي بالقرب فأتيتُ لتناول الغداء
Dialogue: 0,0:18:15.06,0:18:19.32,Default,,0000,0000,0000,,أخذت يومي المسدّس لأنّها\Nنوت استعماله من البداية إذاً
Dialogue: 0,0:18:20.05,0:18:24.47,Default,,0000,0000,0000,,مما يعني أنّها خططت سلفاً\Nللإقدام على الانتحار في لمّ شملنا
Dialogue: 0,0:18:24.47,0:18:25.60,Default,,0000,0000,0000,,!لا-لا يُعقل
Dialogue: 0,0:18:25.60,0:18:26.96,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:18:26.96,0:18:29.37,Default,,0000,0000,0000,,كلا، من المبكر الوصول لاستنتاجات
Dialogue: 0,0:18:29.37,0:18:31.07,Default,,0000,0000,0000,,لننتظر وصول الشرطة
Dialogue: 0,0:18:31.62,0:18:33.49,Default,,0000,0000,0000,,...مـ-معك حق
Dialogue: 0,0:18:33.75,0:18:38.40,Default,,0000,0000,0000,,!لمَ يا يومي؟ لمَ مُتِ؟
Dialogue: 0,0:18:51.70,0:18:55.66,Default,,0000,0000,0000,,ماذا؟ ساعتان حتّى تصل الشرطة؟
Dialogue: 0,0:18:55.66,0:18:56.88,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:56.88,0:19:00.36,Default,,0000,0000,0000,,قالوا أنّ الشوارع مزدحمة الليلة\Nبسبب المهرجان
Dialogue: 0,0:19:00.63,0:19:03.30,Default,,0000,0000,0000,,تبّاً، لا يمكننا الانتظار لساعتين
Dialogue: 0,0:19:03.30,0:19:06.18,Default,,0000,0000,0000,,لا خيار آخر، علينا إجراء التشريح بأنفسنا
Dialogue: 0,0:19:06.18,0:19:06.96,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:19:06.96,0:19:09.32,Default,,0000,0000,0000,,ألدى أحد كاميرا؟
Dialogue: 0,0:19:09.32,0:19:10.99,Default,,0000,0000,0000,,معي واحدة
Dialogue: 0,0:19:10.99,0:19:12.46,Default,,0000,0000,0000,,أعرنا إيّاها قليلاً
Dialogue: 0,0:19:12.46,0:19:14.16,Default,,0000,0000,0000,,سأذهب لجلبها من غرفتي
Dialogue: 0,0:19:14.71,0:19:18.78,Default,,0000,0000,0000,,...لم أتصوّر يوماً أن نشرّح جثّة يومي
Dialogue: 0,0:19:18.78,0:19:20.11,Default,,0000,0000,0000,,صدقت
Dialogue: 0,0:19:26.94,0:19:28.02,Default,,0000,0000,0000,,انتهيت يا موري
Dialogue: 0,0:19:28.02,0:19:29.40,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:19:34.24,0:19:36.80,Default,,0000,0000,0000,,بدأت أصابع قدميها تتصلّب أيضاً
Dialogue: 0,0:19:36.80,0:19:39.51,Default,,0000,0000,0000,,أي مضت فترة مُذ ماتت
Dialogue: 0,0:19:39.51,0:19:41.80,Default,,0000,0000,0000,,ما رأيك بأن نتفقد الازرقاق\Nفي بقيّة جسدها؟
Dialogue: 0,0:19:41.80,0:19:42.59,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:19:42.59,0:19:45.95,Default,,0000,0000,0000,,لكن لا أعتقد أننا سنجده\N...مع كمية الدم التي فقدتها
Dialogue: 0,0:19:46.79,0:19:49.92,Default,,0000,0000,0000,,!لا ترتدي شيئاً تحت ثوبها
Dialogue: 0,0:19:49.92,0:19:51.29,Default,,0000,0000,0000,,ما معنى هذا؟
Dialogue: 0,0:19:51.29,0:19:52.50,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:19:52.50,0:19:55.50,Default,,0000,0000,0000,,ليس هذا الغريب فقط
Dialogue: 0,0:19:55.50,0:19:58.74,Default,,0000,0000,0000,,انظرا، إنّها ترتدي يوكاتا كبير المقاس
Dialogue: 0,0:19:58.74,0:20:01.36,Default,,0000,0000,0000,,كانت ترتدي مقاساً أصغر عندما كانت في الأسفل
Dialogue: 0,0:20:01.36,0:20:04.57,Default,,0000,0000,0000,,كما سبّابة يدها التي تمسك بالمسدّس
Dialogue: 0,0:20:04.57,0:20:06.82,Default,,0000,0000,0000,,ليست على الزناد
Dialogue: 0,0:20:07.15,0:20:09.98,Default,,0000,0000,0000,,...والأشدّ غرابة هو ثقب الرصاصة
Dialogue: 0,0:20:12.90,0:20:14.15,Default,,0000,0000,0000,,!أيّها الشقيّ
Dialogue: 0,0:20:14.15,0:20:17.28,Default,,0000,0000,0000,,!أخبرك ألّا تتدخل في التحقيقات دوماً
Dialogue: 0,0:20:17.28,0:20:18.28,Default,,0000,0000,0000,,!يا إلهي
Dialogue: 0,0:20:18.28,0:20:20.32,Default,,0000,0000,0000,,أوجدتما شيئاً يا أبي؟
Dialogue: 0,0:20:20.32,0:20:21.47,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:21.47,0:20:23.35,Default,,0000,0000,0000,,،بناءً على تصلّب جثّتها
Dialogue: 0,0:20:23.35,0:20:26.28,Default,,0000,0000,0000,,فقد ماتت قبل ما يفوق 7 ساعات
Dialogue: 0,0:20:26.59,0:20:30.38,Default,,0000,0000,0000,,قبل 7 ساعات... أي عند قرابة الثالثة بعد الظهر؟
Dialogue: 0,0:20:30.38,0:20:33.74,Default,,0000,0000,0000,,كان ذلك عند ذهابنا لغرفة كرة الطاولة بعد أن غادرتنا هي
Dialogue: 0,0:20:34.04,0:20:37.70,Default,,0000,0000,0000,,أجل، عادت وقتها إلى غرفتها غالباً
Dialogue: 0,0:20:37.70,0:20:40.74,Default,,0000,0000,0000,,وأطلقت على رأسها بمسدّس أخفته
Dialogue: 0,0:20:40.74,0:20:43.28,Default,,0000,0000,0000,,...أي لا شكّ أنّه كان انتحاراً
Dialogue: 0,0:20:43.28,0:20:46.44,Default,,0000,0000,0000,,!لكن لمَ قد تنتحر يومي؟
Dialogue: 0,0:20:46.44,0:20:48.90,Default,,0000,0000,0000,,...سبق أن قالت
Dialogue: 0,0:20:48.90,0:20:51.95,Default,,0000,0000,0000,,...أتمنّى لو كنت ميتة حقاً
Dialogue: 0,0:20:52.36,0:20:55.08,Default,,0000,0000,0000,,!لا بدّ أنّ الفكرة كانت تراودها
Dialogue: 0,0:20:55.08,0:20:56.97,Default,,0000,0000,0000,,...ثمّ أقدمت
Dialogue: 0,0:22:31.51,0:22:35.30,Default,,0000,0000,0000,,كيف أطلقت يومي-سان النار على رأسها؟
Dialogue: 0,0:22:35.30,0:22:36.91,Default,,0000,0000,0000,,ما الذي تقوله يا كونان-كن؟
Dialogue: 0,0:22:36.91,0:22:38.12,Default,,0000,0000,0000,,!لا تطرح أسئلة غريبة
Dialogue: 0,0:22:38.12,0:22:38.82,Default,,0000,0000,0000,,!كيف؟
Dialogue: 0,0:22:39.46,0:22:40.79,Default,,0000,0000,0000,,ذلك واضح
Dialogue: 0,0:22:40.79,0:22:43.96,Default,,0000,0000,0000,,...صوّبت على رأسها هكذا و
Dialogue: 0,0:22:46.11,0:22:48.99,Default,,0000,0000,0000,,!موري! ما الخطب؟! ماذا هناك؟
Dialogue: 0,0:22:50.45,0:22:51.61,Default,,0000,0000,0000,,!موري
Dialogue: 0,0:22:51.61,0:22:52.86,Default,,0000,0000,0000,,ناكاميتشي
Dialogue: 0,0:22:52.86,0:22:54.82,Default,,0000,0000,0000,,عندما ينتحر أحدهم بمسدّس عادةً
Dialogue: 0,0:22:54.82,0:22:57.48,Default,,0000,0000,0000,,يلصق الفوهة برأسه، صحيح؟
Dialogue: 0,0:22:57.48,0:22:58.19,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:22:58.48,0:23:01.81,Default,,0000,0000,0000,,هناك أمرٌ ناقص في جرحها إذاً
Dialogue: 0,0:23:05.02,0:23:07.65,Default,,0000,0000,0000,,!معك حق! علامات الحرق
Dialogue: 0,0:23:07.88,0:23:09.43,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:23:09.43,0:23:14.38,Default,,0000,0000,0000,,عندما تطلق من مسدّس، سيصاحب\Nالرصاصة تيّار هواء ساخن
Dialogue: 0,0:23:14.38,0:23:16.62,Default,,0000,0000,0000,,،إن أطلقت بالمسدّس بينما يلامس رأسك مباشرة
Dialogue: 0,0:23:16.62,0:23:19.11,Default,,0000,0000,0000,,ستبقى آثار احتراق بلا شك
Dialogue: 0,0:23:19.11,0:23:21.37,Default,,0000,0000,0000,,...لكن عدم وجود أيٍّ منها
Dialogue: 0,0:23:21.37,0:23:24.53,Default,,0000,0000,0000,,تقصد أنّ شخصاً آخر أطلق عليها؟
Dialogue: 0,0:23:25.04,0:23:29.66,Default,,0000,0000,0000,,أجل، قتل أحدهم يومي\Nوزيّف الأمر ليبدو انتحاراً
Dialogue: 0,0:23:29.66,0:23:32.49,Default,,0000,0000,0000,,أحد في هذا النُزل
Dialogue: 0,0:23:59.90,0:24:02.42,Default,,0000,0000,0000,,!أخبرني! ما الذي تخفيه؟
Dialogue: 0,0:24:02.42,0:24:04.53,Default,,0000,0000,0000,,...ر-رأيت
Dialogue: 0,0:24:04.53,0:24:06.52,Default,,0000,0000,0000,,!رأيت من؟ القاتل؟
Dialogue: 0,0:24:06.52,0:24:11.15,Default,,0000,0000,0000,,رأيتُ يومي التي يُفترض\Nأنّها ميتة عبر نافذة في الطابق الثاني
Dialogue: 0,0:24:13.32,0:24:16.27,Default,,0000,0000,0000,,!سأعتقل أيّاً كان من قتلها
Dialogue: 0,0:24:16.27,0:24:19.74,Default,,0000,0000,0000,,!فهمت الحيلة التي استعملها القاتل أخيراً
Dialogue: 0,0:24:19.74,0:24:21.95,Default,,0000,0000,0000,,!قاتل يومي كان أنت
Dialogue: 0,0:24:24.56,0:24:26.01,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.01,0:24:29.44,Default,,0000,0000,0000,,جريمة قتل مناسبة لمّ شمل كوغورو\N(الجزء الثاني)
Dialogue: 0,0:24:45.00,0:24:47.66,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.66,0:24:49.08,Default,,0000,0000,0000,,بينكي
Dialogue: 0,0:24:49.08,0:24:51.08,Default,,0000,0000,0000,,

