Dialogue: 0,0:00:01.59,0:00:03.38,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.38,0:00:06.54,Default,,0000,0000,0000,,يمكن لاستنتاجات كونان علاج القلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.01,0:00:08.79,Default,,0000,0000,0000,,!مسرحنا هذه المرّة فندق استجمام
Dialogue: 0,0:00:08.79,0:00:10.32,Default,,0000,0000,0000,,!تتألّف القضيّة من ثلاثة أجزاء
Dialogue: 0,0:00:10.32,0:00:12.37,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.37,0:00:14.83,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:01:50.96,0:01:57.05,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل بارون الليل (القضيّة
Dialogue: 0,0:01:51.81,0:01:55.51,Default,,0000,0000,0000,,(جريمة قتل بارون الليل (القضيّة
Dialogue: 0,0:01:58.18,0:02:00.51,Default,,0000,0000,0000,,يا للعناء
Dialogue: 0,0:02:01.34,0:02:03.98,CharCard,,0100,0000,0010,,{\fad(300,0)}فندق الأميرة إيزو\Nشاطئ خاص
Dialogue: 0,0:02:01.47,0:02:03.47,On Top,,0000,0000,0000,,لمَ أنا في مكان بهذه الحرارة
Dialogue: 0,0:02:03.47,0:02:06.68,On Top,,0000,0000,0000,,في هذا الوقت الحارّ من العام؟
Dialogue: 0,0:02:08.21,0:02:11.85,Default,,0000,0000,0000,,كلّه بسبب اتّصال البروفسور
Dialogue: 0,0:02:12.60,0:02:14.08,Default,,0000,0000,0000,,ماذا؟ إيزو؟
Dialogue: 0,0:02:14.08,0:02:17.49,Default,,0000,0000,0000,,نعم، ثلاثة أيام وليلتان في فندق في إيزو
Dialogue: 0,0:02:17.49,0:02:19.56,Default,,0000,0000,0000,,!وبالمجّان أيضاً
Dialogue: 0,0:02:20.37,0:02:22.37,Default,,0000,0000,0000,,!لنذهب
Dialogue: 0,0:02:22.37,0:02:24.02,Default,,0000,0000,0000,,يروقني جزء المجّاني
Dialogue: 0,0:02:24.37,0:02:28.73,Default,,0000,0000,0000,,يا إلهي... ما الذي أفعله هنا؟
Dialogue: 0,0:02:28.73,0:02:34.48,Default,,0000,0000,0000,,حريّ بي أن أبحث عن الرجال\Nبالرداء الأسود الذين قلّصوا جسدي
Dialogue: 0,0:02:40.26,0:02:43.14,Default,,0000,0000,0000,,لكن، ربما لا بأس في هذا أحياناً
Dialogue: 0,0:02:43.39,0:02:46.39,Default,,0000,0000,0000,,!ما الخطب؟ عليك السباحة أيضاً يا كونان-كن
Dialogue: 0,0:02:46.39,0:02:47.55,Default,,0000,0000,0000,,هيّا، تعال
Dialogue: 0,0:02:50.88,0:02:52.30,Default,,0000,0000,0000,,ربما سأفعل
Dialogue: 0,0:02:55.88,0:02:57.93,Default,,0000,0000,0000,,!دُفع النصف فقط؟
Dialogue: 0,0:02:57.93,0:03:02.33,Default,,0000,0000,0000,,أجل. آغاسا-ساما، مجموعة ثلاثة أشخاص، صحيح؟\Nلا خطأ في الأمر
Dialogue: 0,0:03:02.33,0:03:05.53,Default,,0000,0000,0000,,!مستحيل! راجع مُجدداً
Dialogue: 0,0:03:05.53,0:03:07.39,Default,,0000,0000,0000,,ما الخطب يا أبي؟
Dialogue: 0,0:03:07.94,0:03:12.35,Default,,0000,0000,0000,,!أنت يا ولد! دُفعت نصف تكلفة الإقامة فقط
Dialogue: 0,0:03:12.65,0:03:15.31,Default,,0000,0000,0000,,ما المشكلة في دفع نصف؟
Dialogue: 0,0:03:15.52,0:03:18.26,Default,,0000,0000,0000,,لم أجلب ذاك القدر من المال معي
Dialogue: 0,0:03:18.51,0:03:21.35,Default,,0000,0000,0000,,...بالمناسبة، قال البروفسور
Dialogue: 0,0:03:21.35,0:03:23.43,Default,,0000,0000,0000,,أهو بالمجّان حقّاً؟
Dialogue: 0,0:03:23.43,0:03:26.18,Default,,0000,0000,0000,,أجل، سيكون بالمجّان تقريباً في حالتك
Dialogue: 0,0:03:26.18,0:03:28.26,Default,,0000,0000,0000,,في حالتي؟ ما معنى هذا؟
Dialogue: 0,0:03:28.26,0:03:29.22,Default,,0000,0000,0000,,اسمعني فحسب
Dialogue: 0,0:03:29.63,0:03:34.19,Default,,0000,0000,0000,,أميل للتواصل مع أصدقائي العلماء\Nعبر الحاسوب مؤخراً
Dialogue: 0,0:03:34.71,0:03:40.66,Default,,0000,0000,0000,,وجد أحدهم جولة مثيرة للاهتمام\Nفي منتدى على الإنترنت
Dialogue: 0,0:03:40.66,0:03:43.58,Default,,0000,0000,0000,,ودعاني للتقديم عليها
Dialogue: 0,0:03:43.58,0:03:46.10,Default,,0000,0000,0000,,"تُدعى "جولة غموض إيزو
Dialogue: 0,0:03:46.49,0:03:47.82,Default,,0000,0000,0000,,جولة غموض؟
Dialogue: 0,0:03:47.82,0:03:53.65,Default,,0000,0000,0000,,!لحسن الحظّ، تمّ اختياري مع صديقي وحفيدته
Dialogue: 0,0:03:53.65,0:03:58.52,Default,,0000,0000,0000,,لكنّ حفيدته أُصيبت بزكام
Dialogue: 0,0:03:58.52,0:04:01.02,Default,,0000,0000,0000,,لذا أعرض عليكم أماكننا
Dialogue: 0,0:04:01.64,0:04:05.22,Default,,0000,0000,0000,,سيحضر ستّة أشخاص، المجموع عشرة بإضافتكم
Dialogue: 0,0:04:05.22,0:04:06.69,Default,,0000,0000,0000,,يحصل الجميع على خصم 50% للفندق
Dialogue: 0,0:04:07.17,0:04:10.17,Default,,0000,0000,0000,,لكنّ مُنظّم الجولة أحد السبعة الآخرين
Dialogue: 0,0:04:10.17,0:04:14.51,Default,,0000,0000,0000,,ويخفي هويّته، فمن يكتشف من هو\Nسيمكنه الإقامة بالمجّان
Dialogue: 0,0:04:14.51,0:04:19.14,Default,,0000,0000,0000,,كما سيفوز بأقراص مرنة تحوي برنامجاً معيناً
Dialogue: 0,0:04:19.37,0:04:22.39,Default,,0000,0000,0000,,...رغم أنّه ليس برنامجاً تحتاجه
Dialogue: 0,0:04:22.39,0:04:26.19,Default,,0000,0000,0000,,كيف أجد مُنظّم هذه الجولة الغامض إذاً؟
Dialogue: 0,0:04:26.19,0:04:27.53,Default,,0000,0000,0000,,لا تقلق
Dialogue: 0,0:04:27.53,0:04:32.14,Default,,0000,0000,0000,,تلقّينا أسماء وأرقام غرف كلّ المشاركين
Dialogue: 0,0:04:32.14,0:04:35.44,Default,,0000,0000,0000,,كما يُفترض أنّ المُنظّم سيلعب دور شخصيّة ما
Dialogue: 0,0:04:35.44,0:04:38.14,Default,,0000,0000,0000,,ويسبّب حادثة أثناء الجولة
Dialogue: 0,0:04:38.81,0:04:39.97,Default,,0000,0000,0000,,شخصيّة ما؟
Dialogue: 0,0:04:40.35,0:04:44.73,Default,,0000,0000,0000,,أجل، شخصيّة تعرفها جيّداً من الروايات
Dialogue: 0,0:04:44.73,0:04:45.94,Default,,0000,0000,0000,,...اسمه
Dialogue: 0,0:04:46.27,0:04:47.89,Default,,0000,0000,0000,,السيّد بارون الليل
Dialogue: 0,0:04:47.89,0:04:49.35,Default,,0000,0000,0000,,ذلك أنت، صحيح؟
Dialogue: 0,0:04:55.60,0:04:57.75,Default,,0000,0000,0000,,ثلاثة ثوانٍ وأربعة أجزاء من مئة
Dialogue: 0,0:04:58.91,0:05:02.52,Default,,0000,0000,0000,,هذا ما استغرقتَه للاجابة عن سؤالي
Dialogue: 0,0:05:03.33,0:05:05.62,Default,,0000,0000,0000,,كانت معلومةً مفيدة
Dialogue: 0,0:05:05.62,0:05:08.57,On Top,,0000,0000,0000,,أُدعى كونّو شيرو، غرفة رقم 2002
Dialogue: 0,0:05:06.45,0:05:09.97,CharCard,,0000,0000,0000,,{\fad(300,0)}(كونّو شيرو (28\Nموظّف مصرفيّ
Dialogue: 0,0:05:08.57,0:05:09.97,On Top,,0000,0000,0000,,سُررت بلقائك
Dialogue: 0,0:05:10.86,0:05:14.44,Default,,0000,0000,0000,,لن تكتشف هويّة البارون هكذا أبداً
Dialogue: 0,0:05:16.53,0:05:20.77,Default,,0000,0000,0000,,...أنت من أجاب في 2.86 ثانية
Dialogue: 0,0:05:20.77,0:05:22.52,On Top,,0000,0000,0000,,إيبارا-سان، غرفة 2101
Dialogue: 0,0:05:20.77,0:05:24.50,CharCard,,0000,0000,0004,,{\fad(300,0)}(إيبارا توكيو (32\Nمُبرمج حاسوب
Dialogue: 0,0:05:22.52,0:05:24.31,On Top,,0000,0000,0000,,!هلّا صمتّ؟
Dialogue: 0,0:05:26.84,0:05:29.51,On Top,,0000,0000,0000,,الكشف عن هويّتك عند مباغتتك
Dialogue: 0,0:05:26.84,0:05:31.91,CharCard,,0000,0000,0004,,{\fad(300,0)}(كانيشيرو غينتشيرو (74\Nمالك شركة حاسوب
Dialogue: 0,0:05:29.51,0:05:31.72,On Top,,0000,0000,0000,,من عثرات البشر
Dialogue: 0,0:05:32.80,0:05:34.30,On Top,,0000,0000,0000,,أليس ذلك صحيحاً يا شيزوي-سان؟
Dialogue: 0,0:05:33.92,0:05:36.82,CharCard,,0000,0140,0004,,{\fad(300,0)}(هاياشي شيزوي (56\Nخادمة كانيشيرو
Dialogue: 0,0:05:34.30,0:05:35.71,On Top,,0000,0000,0000,,نعم سيّدي
Dialogue: 0,0:05:36.63,0:05:39.05,Default,,0000,0000,0000,,كانيشيرو-سان، غرفة 2001
Dialogue: 0,0:05:39.83,0:05:43.71,Default,,0000,0000,0000,,استغرقتَ 6.29 ثانية للإجابة عليّ
Dialogue: 0,0:05:43.71,0:05:46.50,Default,,0000,0000,0000,,أنا ضريرٌ كما ترى
Dialogue: 0,0:05:46.50,0:05:50.51,Default,,0000,0000,0000,,لم أتوقّع أنّك توجّه السؤال لي
Dialogue: 0,0:05:50.51,0:05:54.85,Default,,0000,0000,0000,,لا بأس، سأعرف الحقيقة بعدما أحلّل هذه البيانات
Dialogue: 0,0:05:54.85,0:05:57.30,Default,,0000,0000,0000,,لكنّ بياناتك ناقصة
Dialogue: 0,0:05:57.69,0:06:02.19,On Top,,0000,0000,0000,,فلا تزال تفتقر لبيانات أحدهم
Dialogue: 0,0:06:02.19,0:06:04.23,On Top,,0000,0000,0000,,أليس ذلك صحيحاً يا بارون الليل؟
Dialogue: 0,0:06:02.19,0:06:04.46,CharCard,,0000,0000,0004,,{\fad(300,0)}(كاميجو هيديكو (29\Nرئيسة شركة برمجيات حاسوب
Dialogue: 0,0:06:04.68,0:06:08.43,Default,,0000,0000,0000,,!ما-ما الذي تقولينه يا كاميجو-سان من غرفة رقم 2102؟
Dialogue: 0,0:06:09.66,0:06:11.71,Default,,0000,0000,0000,,استغرقتَ 0.97 ثانية
Dialogue: 0,0:06:11.71,0:06:16.71,Default,,0000,0000,0000,,أضفها بعد الـ 1.48 ثانية خاصّتي يا كونّو-سان
Dialogue: 0,0:06:16.95,0:06:17.74,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:06:17.74,0:06:18.36,Default,,0000,0000,0000,,نعم؟
Dialogue: 0,0:06:18.36,0:06:21.20,Default,,0000,0000,0000,,من هذا البارون الذي تتكلّمون عنه؟
Dialogue: 0,0:06:21.20,0:06:23.49,Default,,0000,0000,0000,,ماذا؟ لا تعرفه؟
Dialogue: 0,0:06:23.49,0:06:26.46,Default,,0000,0000,0000,,كأنّنا سنصدّقك. يتظاهر بالجهل
Dialogue: 0,0:06:26.85,0:06:30.42,Default,,0000,0000,0000,,يظهر في روايات والد شينتشي كثيراً
Dialogue: 0,0:06:30.89,0:06:32.23,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:32.23,0:06:37.34,Default,,0000,0000,0000,,بارون الليل هو شخصيّة غامضة\Nومتملّصة من ابتكار أبي، كودو يوساكو
Dialogue: 0,0:06:41.13,0:06:45.66,Default,,0000,0000,0000,,إنّه لصّ يسبح في الظلام، وينقلب لقاتل وحشيّ أحياناً
Dialogue: 0,0:06:47.21,0:06:51.17,Default,,0000,0000,0000,,لم يكشف أبي هويّته للآن
Dialogue: 0,0:06:52.54,0:06:58.33,Default,,0000,0000,0000,,...لكن أيّ من يستعمل اسمه موجود بينهم
Dialogue: 0,0:06:58.33,0:07:02.29,Default,,0000,0000,0000,,لا أفهم شيئاً، سأرجع للغرفة
Dialogue: 0,0:07:02.29,0:07:05.71,Default,,0000,0000,0000,,!أبي! ماذا عن مال الفندق؟
Dialogue: 0,0:07:08.48,0:07:11.85,Default,,0000,0000,0000,,لحظة، كان يُفترض أنّهم 10 أشخاص
Dialogue: 0,0:07:11.85,0:07:16.18,Default,,0000,0000,0000,,يوجد ثمانية فحسب هنا بحسابي\Nأنا وران والعمّ
Dialogue: 0,0:07:16.18,0:07:17.84,Default,,0000,0000,0000,,بقي اثنان
Dialogue: 0,0:07:19.01,0:07:20.38,Default,,0000,0000,0000,,ما الذي تفعله؟
Dialogue: 0,0:07:20.38,0:07:22.89,Default,,0000,0000,0000,,...أين المشكلة؟ إنّها مؤخرتك فحسب
Dialogue: 0,0:07:22.89,0:07:24.54,Default,,0000,0000,0000,,لا داعي للانفعال
Dialogue: 0,0:07:24.54,0:07:27.33,Default,,0000,0000,0000,,تعالي معي واملئي شرابي
Dialogue: 0,0:07:27.33,0:07:28.50,Default,,0000,0000,0000,,!الوغد
Dialogue: 0,0:07:28.50,0:07:29.79,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:07:30.75,0:07:31.75,Default,,0000,0000,0000,,ما-ما الذي تفعله؟
Dialogue: 0,0:07:32.29,0:07:33.99,On Top,,0000,0000,0000,,!هذه جملتي أنا
Dialogue: 0,0:07:32.92,0:07:36.02,CharCard,,0130,0000,0004,,{\fad(300,0)}{\fs(23)}(مايدا ساتورو (30\N{\fs(23)}مساعد في قسم الهندسة الإلكترونية\Nجامعة جونان
Dialogue: 0,0:07:33.99,0:07:35.70,On Top,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:07:36.33,0:07:38.67,Default,,0000,0000,0000,,!أأنت مايدا ساتورو-سان؟
Dialogue: 0,0:07:39.03,0:07:40.21,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:40.70,0:07:42.70,Default,,0000,0000,0000,,أتعرفينه يا ران-نيتشان؟
Dialogue: 0,0:07:42.70,0:07:46.62,Default,,0000,0000,0000,,بالطبع! كان بطل الكاراتيه الوطنيّ\N!قبل ستّة أعوام
Dialogue: 0,0:07:46.94,0:07:50.27,Default,,0000,0000,0000,,!كان إعجابي به سبب ممارستي للكاراتيه
Dialogue: 0,0:07:51.94,0:07:56.29,Default,,0000,0000,0000,,!أُدعى موري ران، فزتُ بمسابقة المدينة الأخيرة
Dialogue: 0,0:07:56.29,0:08:00.21,Default,,0000,0000,0000,,بطل كاراتيه وفائزة بمسابقة مدينة؟
Dialogue: 0,0:08:00.21,0:08:03.96,Default,,0000,0000,0000,,!لم يخطر لي أن ألتقيك هنا! إنّه يوم سعدي
Dialogue: 0,0:08:03.96,0:08:05.71,Default,,0000,0000,0000,,أين السعد؟
Dialogue: 0,0:08:05.71,0:08:07.50,Default,,0000,0000,0000,,من هذه الفتاة؟
Dialogue: 0,0:08:07.50,0:08:08.21,Default,,0000,0000,0000,,أكيكو
Dialogue: 0,0:08:09.00,0:08:12.17,On Top,,0000,0000,0000,,دعيني أعرّفك عليها، هذه خطيبتي ساياما أكيكو-سان
Dialogue: 0,0:08:09.47,0:08:12.52,CharCard,,0200,0000,0004,,{\fad(300,0)}{\fs(23)}(24) ساياما أكيكو\N{\fs(23)}أستاذة رياضيات في مدرسة ثانويّة
Dialogue: 0,0:08:13.16,0:08:14.50,Default,,0000,0000,0000,,!ستتزوّجان؟
Dialogue: 0,0:08:15.91,0:08:16.71,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:08:17.53,0:08:21.13,Default,,0000,0000,0000,,لا تهتمي للأمر، أكيكو سريعة الغيرة بطبعها
Dialogue: 0,0:08:21.62,0:08:24.62,Default,,0000,0000,0000,,أنت بارون الليل، صحيح؟
Dialogue: 0,0:08:25.77,0:08:29.65,Default,,0000,0000,0000,,مايدا سان من غرفة 1901، 0.75 ثانية
Dialogue: 0,0:08:29.65,0:08:30.54,Default,,0000,0000,0000,,...بينما ساياما-سان
Dialogue: 0,0:08:30.77,0:08:32.50,Default,,0000,0000,0000,,لا زال على حاله؟
Dialogue: 0,0:08:33.01,0:08:37.96,Default,,0000,0000,0000,,هذا غريب، يُفترض أنّكما بروفسوران مع فتاة صغيرة
Dialogue: 0,0:08:38.35,0:08:42.51,Default,,0000,0000,0000,,لم يستطيعوا القدوم، فأتينا مكانهم
Dialogue: 0,0:08:42.51,0:08:46.87,Default,,0000,0000,0000,,كان ذلك أبي، وهو مُتحرٍّ وليس بروفسوراً
Dialogue: 0,0:08:50.00,0:08:51.04,Default,,0000,0000,0000,,!مُتحرٍّ؟
Dialogue: 0,0:08:51.04,0:08:53.66,Default,,0000,0000,0000,,أجل، يُدعى موري كوغورو
Dialogue: 0,0:08:54.16,0:08:56.41,Default,,0000,0000,0000,,مـ-موري كوغورو؟
Dialogue: 0,0:08:56.66,0:08:58.98,Default,,0000,0000,0000,,رأيته في الصحف
Dialogue: 0,0:08:58.98,0:09:01.38,Default,,0000,0000,0000,,أجل، يدعونه بالمتحرّي العظيم
Dialogue: 0,0:09:02.04,0:09:05.69,Default,,0000,0000,0000,,يا للدنيء، يرسل متحرّياً مكانه
Dialogue: 0,0:09:05.69,0:09:08.79,Default,,0000,0000,0000,,أين المشكلة؟ قلّ عدد المشتبه بأنّهم البارون
Dialogue: 0,0:09:08.79,0:09:14.44,Default,,0000,0000,0000,,لكن بوجود موري كوغورو، لا يمكننا ترك أنفسنا عرضة للأخطاء
Dialogue: 0,0:09:15.72,0:09:18.00,Default,,0000,0000,0000,,يبدو أنّ أبي مشهور
Dialogue: 0,0:09:18.97,0:09:21.31,Default,,0000,0000,0000,,كلّ ذلك بفضلي أنا
Dialogue: 0,0:09:23.41,0:09:24.30,Default,,0000,0000,0000,,!من كان ذلك؟
Dialogue: 0,0:09:28.63,0:09:29.82,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:09:29.82,0:09:31.17,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:09:31.63,0:09:33.52,Default,,0000,0000,0000,,فلنرجع لغرفتنا
Dialogue: 0,0:09:33.52,0:09:34.66,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:36.50,0:09:38.08,Default,,0000,0000,0000,,هكذا الوضع إذاً؟
Dialogue: 0,0:09:38.50,0:09:42.04,Default,,0000,0000,0000,,لذا صُدموا عندما قلتُ أن أبي مُتحرٍّ
Dialogue: 0,0:09:42.04,0:09:43.03,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:44.19,0:09:45.50,Default,,0000,0000,0000,,أي باختصار
Dialogue: 0,0:09:45.86,0:09:50.74,Default,,0000,0000,0000,,إذا وجدتُ بارون الليل بين أولئك السبعة
Dialogue: 0,0:09:50.74,0:09:53.95,Default,,0000,0000,0000,,يمكنني الاستمتاع بشاطئ إيزو بالمجّان
Dialogue: 0,0:09:54.35,0:09:58.73,Default,,0000,0000,0000,,فهمت، لذا قال البروفسور لكونان-كن\Nأنّه سيكون بالمجّان
Dialogue: 0,0:09:58.73,0:09:59.96,Default,,0000,0000,0000,,...ر-ربما
Dialogue: 0,0:10:00.48,0:10:04.95,Default,,0000,0000,0000,,بالطبع! لا يوجد لغز يستعصي\N!على موري كوغورو العظيم
Dialogue: 0,0:10:06.97,0:10:08.26,Default,,0000,0000,0000,,يا لتقلّب الحال
Dialogue: 0,0:10:08.26,0:10:12.34,Default,,0000,0000,0000,,كنتَ تصرخ بأن نغادر لعدم امتلاكك المال قبل قليل
Dialogue: 0,0:10:12.34,0:10:16.54,Default,,0000,0000,0000,,!حسناً! يجدر بي إجراء استطلاعي الأوّلي
Dialogue: 0,0:10:18.16,0:10:20.50,Default,,0000,0000,0000,,إنّه مُتحمّس
Dialogue: 0,0:10:20.50,0:10:23.11,Default,,0000,0000,0000,,ما رأيك بأن نتجوّل في الفندق؟
Dialogue: 0,0:10:23.11,0:10:23.99,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:10:25.28,0:10:27.96,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟ لنذهب للمكان التالي
Dialogue: 0,0:10:28.32,0:10:30.42,Default,,0000,0000,0000,,سأبقى هنا لفترة أطول
Dialogue: 0,0:10:30.57,0:10:34.48,Default,,0000,0000,0000,,حقّاً؟ سأكون عند متجر الهدايا\Nفي الطابق السفلي إذاً
Dialogue: 0,0:10:34.48,0:10:35.95,Default,,0000,0000,0000,,!فهمت! سألحق بك
Dialogue: 0,0:10:37.69,0:10:38.87,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:10:39.19,0:10:42.87,Default,,0000,0000,0000,,لمَ صُدموا عندما سمعوا أنّه مُتحرٍّ
Dialogue: 0,0:10:43.34,0:10:45.18,Default,,0000,0000,0000,,إنّها مجرّد لعبة
Dialogue: 0,0:10:45.18,0:10:48.33,Default,,0000,0000,0000,,وكلّ ما ستفوز به هو إقامة مجّانية، فلمَ ردّة الفعل تلك؟
Dialogue: 0,0:10:48.59,0:10:51.46,Default,,0000,0000,0000,,كما تلك النظرة الدموية
Dialogue: 0,0:10:52.43,0:10:54.79,Default,,0000,0000,0000,,...هناك ما قاله البروفسور أيضاً
Dialogue: 0,0:10:55.21,0:10:59.63,Default,,0000,0000,0000,,كما سيفوز بأقراص مرنة تحوي برنامجاً معيناً
Dialogue: 0,0:10:59.63,0:11:02.79,Default,,0000,0000,0000,,رغم أنّه ليس برنامجاً تحتاجه
Dialogue: 0,0:11:03.45,0:11:04.87,Default,,0000,0000,0000,,...يراودني
Dialogue: 0,0:11:06.08,0:11:08.04,Default,,0000,0000,0000,,شعور سيّئ حيال هذا
Dialogue: 0,0:11:12.36,0:11:15.95,Default,,0000,0000,0000,,لعلّي سأتّصل به بعد العشاء وآخذ التفاصيل
Dialogue: 0,0:11:21.29,0:11:22.50,Default,,0000,0000,0000,,!بارون الليل
Dialogue: 0,0:11:44.31,0:11:45.81,Default,,0000,0000,0000,,ما ذاك؟
Dialogue: 0,0:11:48.64,0:11:49.56,Default,,0000,0000,0000,,!مسبح
Dialogue: 0,0:11:51.42,0:11:52.82,Default,,0000,0000,0000,,أأنت بخير يا فتى؟
Dialogue: 0,0:11:52.82,0:11:53.96,Default,,0000,0000,0000,,!الوغد
Dialogue: 0,0:12:06.99,0:12:08.23,Default,,0000,0000,0000,,!اختفى
Dialogue: 0,0:12:13.27,0:12:17.27,Default,,0000,0000,0000,,لا بدّ أنّه بدّل ثيابه في دورة المياه\Nثم هرب من الأدراج
Dialogue: 0,0:12:18.32,0:12:20.61,Default,,0000,0000,0000,,لكن من كان ذاك الذي تقمّص هويّة بارون الليل؟
Dialogue: 0,0:12:21.56,0:12:25.72,Default,,0000,0000,0000,,المشاركون في الجولة سبعة أشخاص\Nباستثنائي وران والعمّ
Dialogue: 0,0:12:25.72,0:12:31.47,Default,,0000,0000,0000,,الهدف منها هو إيجاد مُنظّم الجولة الموجود بين المشاركين
Dialogue: 0,0:12:32.52,0:12:36.84,Default,,0000,0000,0000,,!المُنظّم الذي سيسبّب حادثة برداء بارون الليل
Dialogue: 0,0:12:38.42,0:12:41.91,Default,,0000,0000,0000,,لكنّها مجرد لعبة بسيطة مقابل إقامة مجّانية
Dialogue: 0,0:12:42.58,0:12:46.41,Default,,0000,0000,0000,,هل يُسقِط الناس بعضهم الآخر من أجل لعبة؟
Dialogue: 0,0:12:47.08,0:12:49.86,On Top,,0000,0000,0000,,تقصد ذاك البرنامج؟
Dialogue: 0,0:12:47.72,0:12:49.86,CharCard,,0000,0000,0000,,منزل آغاسا
Dialogue: 0,0:12:49.86,0:12:52.15,Default,,0000,0000,0000,,ما طبيعته بالضبط؟
Dialogue: 0,0:12:52.15,0:12:58.73,Default,,0000,0000,0000,,لا أدري، كلّ ما ذُكر في الإعلان\Nأنّه برنامج بغاية السرّية
Dialogue: 0,0:12:58.73,0:13:03.97,Default,,0000,0000,0000,,...تذكّرت! قال صديقي البروفسور الذي كان سيشارك
Dialogue: 0,0:13:04.47,0:13:06.94,Default,,0000,0000,0000,,أنّه فيروس أو ما شابه
Dialogue: 0,0:13:06.94,0:13:08.90,Default,,0000,0000,0000,,فـ-فيروس؟
Dialogue: 0,0:13:08.90,0:13:13.93,Default,,0000,0000,0000,,لكن هذا غريب، يُفترض أنّه لا يعرف\Nغير كونه برنامجاً سرّياً مثلي
Dialogue: 0,0:13:14.26,0:13:17.73,Default,,0000,0000,0000,,...يا بروفسور، أيمكن أنّ ذاك الفيروس
Dialogue: 0,0:13:16.45,0:13:17.73,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:13:18.76,0:13:20.42,Default,,0000,0000,0000,,...ران-نيتشان
Dialogue: 0,0:13:20.42,0:13:25.79,Default,,0000,0000,0000,,ما الذي تفعله؟ كنتُ أنتظر\N!في متجر الهدايا طوال الوقت
Dialogue: 0,0:13:25.79,0:13:26.48,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:26.95,0:13:29.37,Default,,0000,0000,0000,,!ما الذي حصل؟! أنت مبلّل بالكامل
Dialogue: 0,0:13:29.37,0:13:34.19,Default,,0000,0000,0000,,ا-انزلقتُ وسقطت في المسبح قبل قليل
Dialogue: 0,0:13:36.11,0:13:40.86,Default,,0000,0000,0000,,لا شيء يدعو للضحك! ماذا كنت تفعل؟
Dialogue: 0,0:13:40.86,0:13:45.60,Default,,0000,0000,0000,,لكن يبدو أنّك لم تصب بأذى، غيّر ثيابك ولنذهب لأكل العشاء
Dialogue: 0,0:13:45.60,0:13:46.52,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:13:49.60,0:13:51.10,Default,,0000,0000,0000,,!المكان مكتظّ
Dialogue: 0,0:13:52.22,0:13:53.50,Default,,0000,0000,0000,,ماذا نفعل؟
Dialogue: 0,0:13:53.50,0:13:55.51,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:13:56.55,0:13:59.15,Default,,0000,0000,0000,,!ران! هنا هنا
Dialogue: 0,0:13:59.15,0:14:02.91,Default,,0000,0000,0000,,!أبي... كما مايدا-سان وساياما-سان
Dialogue: 0,0:14:02.91,0:14:04.87,Default,,0000,0000,0000,,ما الذي جمعكم؟
Dialogue: 0,0:14:04.87,0:14:08.52,Default,,0000,0000,0000,,...أنهى والدك استجوابنا للتوّ
Dialogue: 0,0:14:08.87,0:14:11.99,Default,,0000,0000,0000,,أنت بارون الليل في الواقع، أليس كذلك؟" وما شابه"
Dialogue: 0,0:14:13.24,0:14:14.89,Default,,0000,0000,0000,,...أبي، أنت لا تتوقّف
Dialogue: 0,0:14:15.74,0:14:17.78,Default,,0000,0000,0000,,!أكيكو-سان! فستانك جميلٌ جدّاً
Dialogue: 0,0:14:18.70,0:14:20.40,Default,,0000,0000,0000,,شـ-شكراً
Dialogue: 0,0:14:20.40,0:14:26.23,Default,,0000,0000,0000,,لكن توخّي الحذر، قد يكون هناك\Nذئب منحرف يستهدفك
Dialogue: 0,0:14:28.19,0:14:31.64,Default,,0000,0000,0000,,لا يتّعظ ذاك الرجل المنحرف أبداً
Dialogue: 0,0:14:33.26,0:14:36.60,Default,,0000,0000,0000,,سجّلتك أكيكو-سان في رحلة الغموض هذه؟
Dialogue: 0,0:14:37.01,0:14:41.09,Default,,0000,0000,0000,,أجل، فهي مُعجبة كبيرة بروايات كودو يوساكو
Dialogue: 0,0:14:41.09,0:14:43.89,Default,,0000,0000,0000,,تحديداً روايات بارون الليل
Dialogue: 0,0:14:45.12,0:14:48.33,Default,,0000,0000,0000,,لا يعرف أحد عن بارون الليل أكثر منّي
Dialogue: 0,0:14:48.33,0:14:51.31,Default,,0000,0000,0000,,حتّى قصّة شعري تحاكي قصّته
Dialogue: 0,0:14:52.78,0:14:56.89,Default,,0000,0000,0000,,...لستِ الوحيدة المُلمّة ببارون الليل
Dialogue: 0,0:14:58.86,0:14:59.86,Default,,0000,0000,0000,,يا آنسة
Dialogue: 0,0:15:01.69,0:15:04.68,Default,,0000,0000,0000,,...آمل أن تتذكري ذلك، المعذرة
Dialogue: 0,0:15:08.35,0:15:10.52,Default,,0000,0000,0000,,...يا للفستان
Dialogue: 0,0:15:11.11,0:15:13.56,Default,,0000,0000,0000,,!لذا هربت أمّي منك
Dialogue: 0,0:15:13.72,0:15:16.02,Default,,0000,0000,0000,,!إلى متى ستحدّق يا ساتورو؟
Dialogue: 0,0:15:16.43,0:15:18.76,Default,,0000,0000,0000,,هذا فستان مُذهل بالفعل
Dialogue: 0,0:15:19.80,0:15:21.56,Default,,0000,0000,0000,,!توقّف رجاءً سيّدي
Dialogue: 0,0:15:21.86,0:15:25.82,Default,,0000,0000,0000,,ماذا؟ لم ينظر ذاك الرجل المنحرف لها حتّى
Dialogue: 0,0:15:25.82,0:15:27.78,Default,,0000,0000,0000,,ربما ليست من صنفه المفضّل؟
Dialogue: 0,0:15:30.63,0:15:34.79,Default,,0000,0000,0000,,ذاك العجوز كانيشيرو-سان من غرفة 2001 وفقما أذكر
Dialogue: 0,0:15:34.79,0:15:37.53,Default,,0000,0000,0000,,يبدو أنّ هاياشي شيزوي-سان ليست معه
Dialogue: 0,0:15:37.53,0:15:40.71,Default,,0000,0000,0000,,!حسناً، وقت استغلال الفرصة والتحرّي
Dialogue: 0,0:15:40.71,0:15:42.78,Default,,0000,0000,0000,,أين تذهب يا كونان-كن؟
Dialogue: 0,0:15:42.78,0:15:44.49,Default,,0000,0000,0000,,...د-دورة المياه
Dialogue: 0,0:15:45.78,0:15:47.82,Default,,0000,0000,0000,,!أبي! أكثرت من الشراب
Dialogue: 0,0:15:47.82,0:15:51.77,Default,,0000,0000,0000,,أخبرني يا جدّ، أتسعى لفيروس الحاسوب أيضاً؟
Dialogue: 0,0:15:51.94,0:15:57.06,Default,,0000,0000,0000,,أنا إيدوغاوا كونان من غرفة 1902، أتذكرني؟
Dialogue: 0,0:15:58.98,0:16:01.73,Default,,0000,0000,0000,,من أخبرك بما قلت؟
Dialogue: 0,0:16:01.93,0:16:06.40,Default,,0000,0000,0000,,يتكلّم جميع المشاركين في الجولة عن فيروس
Dialogue: 0,0:16:06.80,0:16:09.80,Default,,0000,0000,0000,,لكن لا أدري من أين لهم قول ذلك
Dialogue: 0,0:16:09.80,0:16:13.25,Default,,0000,0000,0000,,فيُفترض أنّ كلّ ما نعرفه\Nأنّه برنامج سريّ
Dialogue: 0,0:16:13.49,0:16:15.11,Default,,0000,0000,0000,,الاسم
Dialogue: 0,0:16:15.42,0:16:19.00,Default,,0000,0000,0000,,ذات يوم ظهر فيروس حاسوبيّ غامض\N...اقتحم أنظمة
Dialogue: 0,0:16:19.00,0:16:24.07,Default,,0000,0000,0000,,حواسيب شركات كبيرة وعبث ببياناتها
Dialogue: 0,0:16:24.37,0:16:29.53,Default,,0000,0000,0000,,.إنّه غير قابل للكشف، ولا يمكنك إيقافه بالطبع\N"البرنامج الكامل"
Dialogue: 0,0:16:30.07,0:16:35.81,Default,,0000,0000,0000,,...كان مراوغاً جدّاً فأطلق عليه الناس اسم
Dialogue: 0,0:16:35.81,0:16:37.32,Default,,0000,0000,0000,,بارون الليل
Dialogue: 0,0:16:37.56,0:16:39.40,Default,,0000,0000,0000,,!بـ-بارون الليل؟
Dialogue: 0,0:16:39.40,0:16:44.32,Default,,0000,0000,0000,,يعرف كلّ المطّلعين على عالم الحواسيب اسمه
Dialogue: 0,0:16:44.32,0:16:48.39,Default,,0000,0000,0000,,فهمت، اسم مُنظّم الجولة بارون الليل أيضاً
Dialogue: 0,0:16:48.39,0:16:52.19,Default,,0000,0000,0000,,فيعطيك ذلك فكرةً عن محتوى البرنامج
Dialogue: 0,0:16:52.19,0:16:54.65,Default,,0000,0000,0000,,سماع ذلك الاسم يرجع لي الذكريات
Dialogue: 0,0:16:55.79,0:16:58.86,Default,,0000,0000,0000,,ذكريات ابني الذي مات قبل 4 أعوام
Dialogue: 0,0:16:59.46,0:17:00.54,Default,,0000,0000,0000,,ابنه؟
Dialogue: 0,0:17:00.54,0:17:02.87,Default,,0000,0000,0000,,ما الخطب يا ولد؟
Dialogue: 0,0:17:05.20,0:17:08.24,Default,,0000,0000,0000,,!لا شيء، إلى اللقاء يا جدّ
Dialogue: 0,0:17:08.24,0:17:13.69,Default,,0000,0000,0000,,توخّي الحذر يا شيزوي-سان، ذاك الصبيّ مثير للريبة
Dialogue: 0,0:17:13.69,0:17:15.19,Default,,0000,0000,0000,,حاضر سيّدي
Dialogue: 0,0:17:18.11,0:17:20.65,Default,,0000,0000,0000,,إنّه كونّو-سان من غرفة 2002
Dialogue: 0,0:17:20.65,0:17:22.15,Default,,0000,0000,0000,,يبدو أنّه يكلّم أحدهم على الهاتف
Dialogue: 0,0:17:22.51,0:17:24.11,Default,,0000,0000,0000,,عمَّ يتكلمان يا ترى؟
Dialogue: 0,0:17:25.56,0:17:29.28,Default,,0000,0000,0000,,كان إيبارا توكيو بالفعل إذاً؟
Dialogue: 0,0:17:29.56,0:17:32.44,Default,,0000,0000,0000,,إيبارا توكيو؟ ذاك الرجل المنحرف؟
Dialogue: 0,0:17:32.84,0:17:35.90,Default,,0000,0000,0000,,كان هو المُخترق؟
Dialogue: 0,0:17:36.55,0:17:41.05,Default,,0000,0000,0000,,المُخترق؟ الشخص الذي يسرق بيانات\Nمن الحواسيب؟
Dialogue: 0,0:17:41.40,0:17:44.20,Default,,0000,0000,0000,,أجل، نعم. ثمّ؟
Dialogue: 0,0:17:48.49,0:17:50.78,Default,,0000,0000,0000,,!أريد أحد هذه يوماً ما
Dialogue: 0,0:17:51.61,0:17:53.23,Default,,0000,0000,0000,,!لا تلمس ساتومي
Dialogue: 0,0:17:55.36,0:17:56.59,Default,,0000,0000,0000,,ساتومي؟
Dialogue: 0,0:17:57.48,0:18:00.40,Default,,0000,0000,0000,,!إنّه اسم أمّي التي تُوفيت العام الفائت
Dialogue: 0,0:18:00.40,0:18:02.64,Default,,0000,0000,0000,,أأنت على ما يرام يا ساتومي؟
Dialogue: 0,0:18:05.12,0:18:06.06,Default,,0000,0000,0000,,...أنت بخير
Dialogue: 0,0:18:06.06,0:18:09.77,Default,,0000,0000,0000,,!سمّى هذا الشخص حاسوبه باسم أمّه الميتة
Dialogue: 0,0:18:10.16,0:18:13.01,Default,,0000,0000,0000,,!ماذا؟ اختفى الرجل المنحرف
Dialogue: 0,0:18:14.13,0:18:17.38,Default,,0000,0000,0000,,المعذرة يا آنسة، أتعرفين أين\Nذهب الرجل الجالس هنا؟
Dialogue: 0,0:18:17.38,0:18:19.70,Default,,0000,0000,0000,,رجع لغرفته للاهتمام بأمرٍ ما وفقما قال
Dialogue: 0,0:18:20.13,0:18:25.40,Default,,0000,0000,0000,,إذا كنت تعرفه يا فتى فهلّا أعدت\Nهذه له؟ نسيها هنا
Dialogue: 0,0:18:26.70,0:18:30.70,Default,,0000,0000,0000,,صحيح، كان يربط ربطة العنق هذه حول رأسه
Dialogue: 0,0:18:30.70,0:18:31.11,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:18:31.53,0:18:32.90,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:18:32.90,0:18:34.11,Default,,0000,0000,0000,,...ران-نيتشان
Dialogue: 0,0:18:34.11,0:18:38.28,Default,,0000,0000,0000,,!لا تكلّمني هكذا! تتسلّل وتتجول دوماً
Dialogue: 0,0:18:38.28,0:18:40.07,Default,,0000,0000,0000,,ماذا؟ أين الآخرون؟
Dialogue: 0,0:18:40.07,0:18:44.02,Default,,0000,0000,0000,,رجعوا جميعاً لغرفهم منذ مدّة طويلة
Dialogue: 0,0:18:45.52,0:18:48.74,Default,,0000,0000,0000,,ماذا؟ لم يرجع أبي بعد
Dialogue: 0,0:18:48.74,0:18:50.16,Default,,0000,0000,0000,,!أكيكو
Dialogue: 0,0:18:50.39,0:18:52.61,Default,,0000,0000,0000,,!يكفي وأدخليني
Dialogue: 0,0:18:52.61,0:18:54.51,Default,,0000,0000,0000,,!مستحيل أيّها المخادع
Dialogue: 0,0:18:54.51,0:18:57.05,Default,,0000,0000,0000,,أسرفتِ في الشرب
Dialogue: 0,0:18:57.05,0:18:58.82,Default,,0000,0000,0000,,أحصل أمرٌ ما؟
Dialogue: 0,0:19:00.08,0:19:03.20,Default,,0000,0000,0000,,قالت أنّ عيناي زاغت للنادلة
Dialogue: 0,0:19:03.20,0:19:04.27,Default,,0000,0000,0000,,!زاغت بالفعل
Dialogue: 0,0:19:04.27,0:19:06.04,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:19:06.04,0:19:11.03,Default,,0000,0000,0000,,لعلّي سأصعد للصالة العلوية حتّى تهدأ
Dialogue: 0,0:19:11.03,0:19:13.73,Default,,0000,0000,0000,,ما رأيك يا ران-سان؟ هل ترافقينني؟
Dialogue: 0,0:19:17.20,0:19:19.61,Default,,0000,0000,0000,,!لا عليكِ منها
Dialogue: 0,0:19:19.61,0:19:20.92,Default,,0000,0000,0000,,هيّا، لنذهب
Dialogue: 0,0:19:20.92,0:19:21.90,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:19:22.73,0:19:23.86,Default,,0000,0000,0000,,صدقاً؟
Dialogue: 0,0:19:24.63,0:19:26.82,CharCard,,0000,0000,0000,,صالة المراقبة
Dialogue: 0,0:19:27.98,0:19:29.39,Default,,0000,0000,0000,,!السماء المليئة بالنجوم جميلة
Dialogue: 0,0:19:29.39,0:19:32.18,Default,,0000,0000,0000,,أجل، لكنّها ليست بجمالك
Dialogue: 0,0:19:34.13,0:19:35.55,Default,,0000,0000,0000,,أعبث فقط
Dialogue: 0,0:19:37.55,0:19:39.40,Default,,0000,0000,0000,,أفسحا قليلاً
Dialogue: 0,0:19:39.63,0:19:41.87,Default,,0000,0000,0000,,عجيب، البحر مُظلم تماماً
Dialogue: 0,0:19:41.87,0:19:44.67,Default,,0000,0000,0000,,!يبدو مخيفاً في الليل حقّاً
Dialogue: 0,0:19:44.67,0:19:45.86,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:19:46.25,0:19:49.82,Default,,0000,0000,0000,,متى تعرّفت على أكيكو-سان يا مايدا-سان؟
Dialogue: 0,0:19:50.25,0:19:55.78,Default,,0000,0000,0000,,أعرفها مُذ صغري، كان أخوها صديقي المقرّب
Dialogue: 0,0:19:55.78,0:19:58.03,Default,,0000,0000,0000,,لكنّه مات قبل 3 أعوام
Dialogue: 0,0:19:58.36,0:20:01.77,Default,,0000,0000,0000,,تُوفي أخو أكيكو-سان؟
Dialogue: 0,0:20:01.77,0:20:03.98,Default,,0000,0000,0000,,يبدو أنّ هذا الغالب عليهم
Dialogue: 0,0:20:04.40,0:20:08.65,Default,,0000,0000,0000,,ران-نيتشان، أين ذهب العمّ؟
Dialogue: 0,0:20:08.65,0:20:11.64,Default,,0000,0000,0000,,رأيتُه قبل قليل رفقة امرأة
Dialogue: 0,0:20:11.64,0:20:14.90,Default,,0000,0000,0000,,كاميجو-سان من غرفة 2102 وفقما أظنّ
Dialogue: 0,0:20:14.90,0:20:16.09,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:20:16.09,0:20:18.86,Default,,0000,0000,0000,,نسيتُ أمر المُنحرف الآخر
Dialogue: 0,0:20:21.50,0:20:22.46,On Top,,0000,0000,0000,,المعذرة
Dialogue: 0,0:20:21.50,0:20:24.82,CharCard,,0000,0000,0000,,الطابق الثاني لفندق الأميرة\N(حانة (الزمّرد
Dialogue: 0,0:20:22.46,0:20:24.82,On Top,,0000,0000,0000,,هكذا إذاً، كنتما متزوّجين
Dialogue: 0,0:20:25.13,0:20:27.78,Default,,0000,0000,0000,,أجل، تطلّقنا قبل 3 أعوام
Dialogue: 0,0:20:28.67,0:20:31.41,Default,,0000,0000,0000,,لمَ قد يطلّق أحد مرأة بجمالك؟
Dialogue: 0,0:20:31.41,0:20:35.16,Default,,0000,0000,0000,,دعك من ذلك، هلّا أخبرتني؟
Dialogue: 0,0:20:35.16,0:20:38.45,Default,,0000,0000,0000,,لا بدّ أنّك عرفت من هو\Nبارون الليل الآن
Dialogue: 0,0:20:38.45,0:20:43.02,Default,,0000,0000,0000,,!لا يمكنني! أجر الفندق على المحكّ
Dialogue: 0,0:20:43.02,0:20:48.45,Default,,0000,0000,0000,,!هيّا، مجرد تلميح\N!أرجوك أيّها المتحرّي العظيم
Dialogue: 0,0:20:50.44,0:20:51.90,Default,,0000,0000,0000,,...صدرها
Dialogue: 0,0:20:55.93,0:20:58.10,Default,,0000,0000,0000,,!يا لعنادك
Dialogue: 0,0:20:58.10,0:21:01.65,Default,,0000,0000,0000,,!قد تكون هذه ليلة مسلّية
Dialogue: 0,0:21:06.38,0:21:09.17,Default,,0000,0000,0000,,حسناً، ربما عليّ الرجوع للغرفة الآن
Dialogue: 0,0:21:09.28,0:21:10.92,Default,,0000,0000,0000,,أجل، انقلع
Dialogue: 0,0:21:11.49,0:21:13.87,Default,,0000,0000,0000,,يُفترض أنّ أكيكو قد هدأت
Dialogue: 0,0:21:13.87,0:21:17.71,Default,,0000,0000,0000,,كما قد أتعرّض للعضّ إن بقيتُ معك أكثر
Dialogue: 0,0:21:18.28,0:21:21.48,Default,,0000,0000,0000,,مِن حارسك الشخصيّ الصغير
Dialogue: 0,0:21:21.48,0:21:22.35,Default,,0000,0000,0000,,إلى اللقاء
Dialogue: 0,0:21:23.61,0:21:26.73,Default,,0000,0000,0000,,المعذرة، أتعرف ما هو الفيروس؟
Dialogue: 0,0:21:27.57,0:21:30.11,Default,,0000,0000,0000,,فيروس؟ تقصد كالزكام؟
Dialogue: 0,0:21:31.72,0:21:33.07,Default,,0000,0000,0000,,لا شيء، لا تهتم
Dialogue: 0,0:21:33.39,0:21:35.28,Default,,0000,0000,0000,,ما هذا السؤال الغريب؟
Dialogue: 0,0:21:39.64,0:21:43.67,Default,,0000,0000,0000,,فيروس الحاسوب الكامل، بارون الليل
Dialogue: 0,0:21:43.67,0:21:46.92,Default,,0000,0000,0000,,باستعمالك له، يمكنك الاستحواذ
Dialogue: 0,0:21:46.92,0:21:49.20,Default,,0000,0000,0000,,على أموال طائلة من البنوك أو الشركات
Dialogue: 0,0:21:50.42,0:21:53.15,Default,,0000,0000,0000,,يرغب الكثير من الناس الحصول عليه
Dialogue: 0,0:21:53.83,0:21:58.91,Default,,0000,0000,0000,,لكن ما الذي ينوي مُنظّم هذه الجولة عليه\Nبجمعه لهؤلاء الأشخاص؟
Dialogue: 0,0:21:59.25,0:22:01.90,Default,,0000,0000,0000,,...أهي مجرّد لعبة؟ أم
Dialogue: 0,0:23:33.49,0:23:34.37,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:23:36.33,0:23:37.85,Default,,0000,0000,0000,,!انظروا
Dialogue: 0,0:23:38.16,0:23:38.80,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:24:00.92,0:24:05.04,Default,,0000,0000,0000,,موت بارون الليل المنيع\Nنهاية بائسة بحقّ
Dialogue: 0,0:24:05.92,0:24:08.00,Default,,0000,0000,0000,,لكن لمَ سقط بارون الليل؟
Dialogue: 0,0:24:09.42,0:24:10.95,Default,,0000,0000,0000,,كانت حادثة فحسب
Dialogue: 0,0:24:11.37,0:24:12.83,Default,,0000,0000,0000,,حادثة؟
Dialogue: 0,0:24:12.60,0:24:14.37,Default,,0000,0000,0000,,هذه العقدة غريبة
Dialogue: 0,0:24:21.57,0:24:23.44,Default,,0000,0000,0000,,!بـ-بارون الليل
Dialogue: 0,0:24:24.08,0:24:30.08,On Top,,0000,0000,0000,,(جريمة قتل بارون الليل (جزء الاشتباه
Dialogue: 0,0:24:24.65,0:24:26.44,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.44,0:24:29.66,Default,,0000,0000,0000,,(جريمة قتل بارون الليل (جزء الاشتباه
Dialogue: 0,0:24:45.84,0:24:48.34,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.67,0:24:50.08,Default,,0000,0000,0000,,كاراتيه
Dialogue: 0,0:24:50.34,0:24:52.02,Default,,0000,0000,0000,,!أداء بارع لران-نيتشان في الحلقة القادمة
Dialogue: 0,0:24:52.02,0:24:53.25,Default,,0000,0000,0000,,...ران-تشان والعمّ

