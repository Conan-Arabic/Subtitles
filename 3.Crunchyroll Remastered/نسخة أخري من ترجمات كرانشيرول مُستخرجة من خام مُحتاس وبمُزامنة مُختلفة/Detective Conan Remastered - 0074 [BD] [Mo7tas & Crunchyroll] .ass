Dialogue: 0,0:00:00.37,0:00:02.29,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:02.29,0:00:06.07,Default,,0000,0000,0000,,تُعالج استنتاجات كونان القلوب\Nالمُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:06.07,0:00:09.81,Default,,0000,0000,0000,,!قضيّة اليوم عن ملك الموت جينّاي وجريمته الشبحية
Dialogue: 0,0:00:10.11,0:00:12.02,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.02,0:00:13.60,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.60,0:00:15.68,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:50.56,0:01:56.52,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل ملك الموت جينّاي
Dialogue: 0,0:01:51.63,0:01:54.78,Default,,0000,0000,0000,,جريمة قتل ملك الموت جينّاي
Dialogue: 0,0:02:02.72,0:02:05.47,On Top,,0000,0000,0000,,سآتي لأخذ حياة المُحامي الفاسد كورودا كينزو\Nملك الموت جينّاي-
Dialogue: 0,0:02:26.93,0:02:29.35,Default,,0000,0000,0000,,!المحامي الفاسد كورودا كينزو
Dialogue: 0,0:02:29.94,0:02:32.30,Default,,0000,0000,0000,,!أتيتُ لاصطحابك، للجحيم
Dialogue: 0,0:02:32.85,0:02:34.77,Default,,0000,0000,0000,,!الـ-النجدة
Dialogue: 0,0:02:34.77,0:02:35.98,Default,,0000,0000,0000,,حان الوقت
Dialogue: 0,0:02:43.72,0:02:47.56,On Top,,0000,0000,0000,,ملك الموت جينّاي\Nتحدٍّ جديد
Dialogue: 0,0:02:55.75,0:02:59.35,Default,,0000,0000,0000,,أينام المرء بعد خمس دقائق\Nمن بدء عرض الفيلم؟
Dialogue: 0,0:02:59.70,0:03:01.80,Default,,0000,0000,0000,,ما هذا يا أبي؟
Dialogue: 0,0:03:01.80,0:03:05.27,Default,,0000,0000,0000,,حالفنا الحظّ برؤية العرض الباكر\N!وأنت نمت طوال الوقت
Dialogue: 0,0:03:05.27,0:03:10.19,Default,,0000,0000,0000,,لم يكن الأمر بيدي، فقد سهرتُ البارحة أعمل
Dialogue: 0,0:03:10.19,0:03:11.72,Default,,0000,0000,0000,,تقصد أنّك سهرت تشرب
Dialogue: 0,0:03:11.72,0:03:14.66,Default,,0000,0000,0000,,لكن لم يكن الفيلم بتلك الروعة
Dialogue: 0,0:03:14.73,0:03:17.64,Default,,0000,0000,0000,,تظنّ ذلك؟ نال إعجابي
Dialogue: 0,0:03:17.85,0:03:21.80,Default,,0000,0000,0000,,ربما بدأت هذه السلسلة تصبح مُبتذلة
Dialogue: 0,0:03:23.69,0:03:26.21,Default,,0000,0000,0000,,!إنّه ممثل ملك الموت جينّاي، نانجو هاياتو
Dialogue: 0,0:03:28.82,0:03:30.77,CharCard,,0000,0000,0004,,{\fad(300,0)} (42) نانجو هاياتو\Nممثل أفلام
Dialogue: 0,0:03:32.25,0:03:33.99,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:03:34.77,0:03:38.10,Default,,0000,0000,0000,,أأنت المتحرّي الشهير موري كوغورو-سان؟
Dialogue: 0,0:03:39.53,0:03:43.28,Default,,0000,0000,0000,,نعم، أنا المتحرّي موري كوغورو\Nبدمه ولحمه
Dialogue: 0,0:03:44.35,0:03:47.15,CharCard,,0000,0000,0004,,{\fad(300,0)} (37) نانجو ميوكي\Nزوجة نانجو
Dialogue: 0,0:03:44.37,0:03:47.69,On Top,,0000,0000,0000,,أنا زوجة نانجو هاياتو
Dialogue: 0,0:03:48.78,0:03:52.10,Default,,0000,0000,0000,,!سُررت بلقائك! كان الفيلم مُذهلاً
Dialogue: 0,0:03:52.10,0:03:53.47,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:03:53.47,0:03:57.69,Default,,0000,0000,0000,,هناك ما أريد مناقشته معك
Dialogue: 0,0:04:00.97,0:04:03.81,Default,,0000,0000,0000,,تفضّل، هنا يا متحرّي موري
Dialogue: 0,0:04:03.81,0:04:06.52,Default,,0000,0000,0000,,يا له من مكتبٍ جميل
Dialogue: 0,0:04:06.64,0:04:11.42,Default,,0000,0000,0000,,لا، لم نستطع إيجاد مكانٍ جديد
Dialogue: 0,0:04:11.42,0:04:12.16,Default,,0000,0000,0000,,تفضّلوا
Dialogue: 0,0:04:12.16,0:04:13.00,Default,,0000,0000,0000,,ساتومي-سان
Dialogue: 0,0:04:13.00,0:04:15.98,Default,,0000,0000,0000,,هذا المتحرّي الشهير موري كوغورو-سان
Dialogue: 0,0:04:16.28,0:04:19.72,CharCard,,0000,0000,0004,,{\fad(300,0)}(يوشينو ساتومي (28\Nمديرة أعمال نانجو
Dialogue: 0,0:04:17.04,0:04:18.54,On Top,,0000,0000,0000,,أنا مديرة أعمال نانجو هاياتو
Dialogue: 0,0:04:18.54,0:04:19.72,On Top,,0000,0000,0000,,أُدعى يوشينو ساتومي
Dialogue: 0,0:04:20.45,0:04:22.93,Default,,0000,0000,0000,,ساتومي-سان، هلّا أريتِ موري-سان تلك؟
Dialogue: 0,0:04:22.93,0:04:24.28,Default,,0000,0000,0000,,...لكن سيّدتي
Dialogue: 0,0:04:24.28,0:04:26.18,Default,,0000,0000,0000,,لا يهمّ، أعطه إيّاها
Dialogue: 0,0:04:27.03,0:04:28.20,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:04:30.98,0:04:32.30,Default,,0000,0000,0000,,...هـ-هذه
Dialogue: 0,0:04:32.98,0:04:38.60,Default,,0000,0000,0000,,.سآتي لأخذ حياة نانجو هاياتو الليلة"\N"ملك الموت جينّاي-
Dialogue: 0,0:04:38.60,0:04:41.05,Default,,0000,0000,0000,,تحذير من ملك الموت جينّاي؟
Dialogue: 0,0:04:41.05,0:04:43.98,Default,,0000,0000,0000,,كان في صندوق بريد المكتب هذا الصباح
Dialogue: 0,0:04:43.98,0:04:46.01,Default,,0000,0000,0000,,هل أريتموها للشرطة؟
Dialogue: 0,0:04:46.01,0:04:47.18,Default,,0000,0000,0000,,...كلا
Dialogue: 0,0:04:47.18,0:04:48.48,Default,,0000,0000,0000,,لا حاجة لذلك
Dialogue: 0,0:04:48.81,0:04:50.93,Default,,0000,0000,0000,,إنّه مقلب بكلّ وضوح
Dialogue: 0,0:04:50.93,0:04:52.14,Default,,0000,0000,0000,,...لكن يا عزيزي
Dialogue: 0,0:04:52.57,0:04:55.42,Default,,0000,0000,0000,,!أخبرتك ألّا تتصرّفي من تلقاء نفسك
Dialogue: 0,0:04:55.42,0:04:58.10,Default,,0000,0000,0000,,المعذرة، لكن سأطلب منك المغادرة
Dialogue: 0,0:04:58.10,0:05:03.06,Default,,0000,0000,0000,,لكن يا نانجو-سان، زوجتك قلقةٌ عليك
Dialogue: 0,0:05:03.91,0:05:09.28,Default,,0000,0000,0000,,!حتّى لو كانت الرسالة حقيقية، سأحمي نفسي بنفسي
Dialogue: 0,0:05:09.28,0:05:10.76,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:05:11.65,0:05:15.53,Default,,0000,0000,0000,,!بأيّ حال، أنا مشغول لذا غادروا
Dialogue: 0,0:05:15.53,0:05:18.60,Default,,0000,0000,0000,,يوشينو-كن، يمكنك الانصراف أيضاً
Dialogue: 0,0:05:23.14,0:05:25.93,Default,,0000,0000,0000,,ورائي مكتب المُمثل نانجو هاياتو-سان
Dialogue: 0,0:05:25.93,0:05:30.88,Default,,0000,0000,0000,,الذي تلقّى رسالة تهديد بالقتل من ملك الموت جينّاي
Dialogue: 0,0:05:31.64,0:05:34.46,Default,,0000,0000,0000,,تجاوزت الساعة التاسعة للتوّ
Dialogue: 0,0:05:34.46,0:05:38.60,Default,,0000,0000,0000,,هل سيظهر ملك الموت جينّاي كما قال في تحذيره؟
Dialogue: 0,0:05:39.09,0:05:43.25,Default,,0000,0000,0000,,يوجد في المسرح المتحرّي الشهير\Nموري كوغورو-سان أيضاً
Dialogue: 0,0:05:43.25,0:05:45.06,Default,,0000,0000,0000,,!فالتوتّر مرتفع
Dialogue: 0,0:05:45.41,0:05:49.06,Default,,0000,0000,0000,,مرحباً، أنا المتحرّي الشهير موري كوغورو
Dialogue: 0,0:05:49.33,0:05:51.01,Default,,0000,0000,0000,,ما الذي تفعله؟
Dialogue: 0,0:05:51.86,0:05:55.43,Default,,0000,0000,0000,,انتهينا! لنأخذ استراحةً قصيرة
Dialogue: 0,0:05:57.57,0:05:59.85,Default,,0000,0000,0000,,ستكون الأمور بخيرٍ سيّدتي
Dialogue: 0,0:05:59.85,0:06:05.35,Default,,0000,0000,0000,,لن يستطيع المُجرم الإقدام على شيء\Nبوجودنا هنا وتأهّبنا
Dialogue: 0,0:06:05.35,0:06:06.98,Default,,0000,0000,0000,,على رويدك يا موري-سان
Dialogue: 0,0:06:06.98,0:06:09.06,On Top,,0000,0000,0000,,لا حاجة للتحمّس
Dialogue: 0,0:06:07.28,0:06:11.02,CharCard,,0000,0000,0004,,{\fad(300,0)}(أونو تاداو (45\Nمخرج تلفازيّ
Dialogue: 0,0:06:09.06,0:06:11.39,On Top,,0000,0000,0000,,فلن يظهر ملك الموت جينّاي
Dialogue: 0,0:06:11.71,0:06:13.27,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:06:14.26,0:06:18.60,Default,,0000,0000,0000,,هذه مجرد مسرحية من تدبير نانجو\Nللترويج لفيلمه بكلّ وضوح
Dialogue: 0,0:06:18.92,0:06:20.80,Default,,0000,0000,0000,,!كيف تجرؤ على قول هذا؟
Dialogue: 0,0:06:20.80,0:06:23.10,Default,,0000,0000,0000,,!على رسلك سيّدتي، اهدئي
Dialogue: 0,0:06:23.29,0:06:26.21,Default,,0000,0000,0000,,!سأذهب لشراء شراب
Dialogue: 0,0:06:26.21,0:06:27.35,Default,,0000,0000,0000,,لنذهب يا كونان-كن
Dialogue: 0,0:06:33.70,0:06:37.63,Default,,0000,0000,0000,,ماذا؟ أليست تلك مديرته ساتومي-سان؟
Dialogue: 0,0:06:37.78,0:06:40.51,Default,,0000,0000,0000,,معك حق، لم ترجع لمنزلها بعد إذاً
Dialogue: 0,0:06:40.69,0:06:42.61,Default,,0000,0000,0000,,ما الذي تفعله برأيك؟
Dialogue: 0,0:06:42.61,0:06:45.19,Default,,0000,0000,0000,,يمكنها مشاهدة المكتب من هناك
Dialogue: 0,0:06:45.19,0:06:47.23,Default,,0000,0000,0000,,لعلّها تشعر بالقلق
Dialogue: 0,0:06:48.38,0:06:50.21,Default,,0000,0000,0000,,هيّا بنا يا كونان-كن
Dialogue: 0,0:06:54.53,0:06:58.32,Default,,0000,0000,0000,,نانجو-سان وحده هو المتبقّي\Nفي هذا الوقت إذاً
Dialogue: 0,0:06:58.32,0:07:00.29,Default,,0000,0000,0000,,أين أونو-سان؟
Dialogue: 0,0:07:00.57,0:07:02.76,Default,,0000,0000,0000,,قال أنّه ذاهبٌ للحمّام
Dialogue: 0,0:07:02.76,0:07:04.25,Default,,0000,0000,0000,,ماذا نفعل تالياً؟
Dialogue: 0,0:07:04.77,0:07:06.81,Default,,0000,0000,0000,,سأذهب للبحث عنه
Dialogue: 0,0:07:08.81,0:07:09.78,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:07:09.78,0:07:11.02,Default,,0000,0000,0000,,!ذ-ذاك
Dialogue: 0,0:07:15.47,0:07:16.92,Default,,0000,0000,0000,,!ملك الموت جينّاي
Dialogue: 0,0:07:16.92,0:07:19.25,Default,,0000,0000,0000,,!الكاميرا! هاتوا الكاميرا
Dialogue: 0,0:07:19.25,0:07:20.67,Default,,0000,0000,0000,,!سلّم نفسك
Dialogue: 0,0:07:31.67,0:07:33.83,Default,,0000,0000,0000,,!سحقاً! فقدت أثره
Dialogue: 0,0:07:34.08,0:07:35.79,Default,,0000,0000,0000,,!يا عمّ! نانجو-سان في خطر
Dialogue: 0,0:07:35.79,0:07:36.79,Default,,0000,0000,0000,,!تـ-تبّاً
Dialogue: 0,0:07:42.40,0:07:44.29,Default,,0000,0000,0000,,ساتومي-سان! لمَ أنت هنا؟
Dialogue: 0,0:07:44.52,0:07:47.73,Default,,0000,0000,0000,,كنتُ في مطعم الهامبرغر ورأيتُ ملك الموت جينّاي
Dialogue: 0,0:07:47.73,0:07:50.00,Default,,0000,0000,0000,,!يدخل المبنى
Dialogue: 0,0:07:50.00,0:07:51.61,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:07:53.66,0:07:54.36,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:07:55.47,0:07:57.04,Default,,0000,0000,0000,,!لا يمكنك يا كونان-كن
Dialogue: 0,0:07:57.04,0:07:58.04,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:08:05.00,0:08:06.88,Default,,0000,0000,0000,,...كونان-كن، أكان ذلك
Dialogue: 0,0:08:09.25,0:08:13.33,Default,,0000,0000,0000,,!لا يزال المجرم في الطابق السابع يا عمّ\N!رأيتُ ظلّه للتو
Dialogue: 0,0:08:13.62,0:08:15.29,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:08:30.28,0:08:32.75,Default,,0000,0000,0000,,!تبّاً! لمَ هذا الشريط هنا؟
Dialogue: 0,0:08:33.14,0:08:34.77,Default,,0000,0000,0000,,شريط لاصق؟
Dialogue: 0,0:08:52.01,0:08:55.79,Default,,0000,0000,0000,,اختفى القاتل من المسرح إذاً يا موري-كن؟
Dialogue: 0,0:08:55.79,0:08:57.79,Default,,0000,0000,0000,,أجل حضرة المفتّش
Dialogue: 0,0:08:58.25,0:09:02.57,Default,,0000,0000,0000,,كلّ النوافذ هنا مُقفلة من الداخل، فلم يفتحها
Dialogue: 0,0:09:02.57,0:09:07.69,Default,,0000,0000,0000,,والمصعد والأدراج هما السبيلان الوحيدان\Nللخروج من الطابق السابع
Dialogue: 0,0:09:07.69,0:09:12.17,Default,,0000,0000,0000,,لكننا لم نجد له أثراً بعدما أسرعنا إلى هنا
Dialogue: 0,0:09:12.17,0:09:16.21,Default,,0000,0000,0000,,وأنت متأكد أنّ لا أحد غادر المبنى؟
Dialogue: 0,0:09:16.48,0:09:20.92,Default,,0000,0000,0000,,نعم، كنتُ مع المراسلين أمام المبنى طوال الوقت
Dialogue: 0,0:09:20.92,0:09:23.33,Default,,0000,0000,0000,,لكن ماذا عن أدراج الطوارئ؟
Dialogue: 0,0:09:23.33,0:09:24.50,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:09:24.92,0:09:30.72,Default,,0000,0000,0000,,أدراج طوارئ هذا المبنى تتّصل بالطريق\Nالمؤدي للمصعد في الطابق الأوّل
Dialogue: 0,0:09:30.72,0:09:33.91,Default,,0000,0000,0000,,وتنتهي لنفس المخرج
Dialogue: 0,0:09:33.91,0:09:38.38,Default,,0000,0000,0000,,كنتُ أراقب أدراج الطوارئ ولم يستعملها أحد
Dialogue: 0,0:09:39.75,0:09:43.29,Default,,0000,0000,0000,,أي أنّ القاتل اختفى كالدخان؟
Dialogue: 0,0:09:45.40,0:09:47.20,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:09:47.20,0:09:49.65,Default,,0000,0000,0000,,ألا تظنّين الأمر غريباً؟
Dialogue: 0,0:09:49.65,0:09:54.77,Default,,0000,0000,0000,,رأينا القاتل يقف عند النافذة\Nعندما أُضيئت المصابيح
Dialogue: 0,0:09:54.77,0:09:58.00,Default,,0000,0000,0000,,لكنّ مفتاحها بجوار الباب
Dialogue: 0,0:09:58.39,0:10:02.23,Default,,0000,0000,0000,,كيف أضاء القاتل مصابيح الغرفة؟
Dialogue: 0,0:10:02.23,0:10:03.83,Default,,0000,0000,0000,,ذلك غريبٌ بالفعل
Dialogue: 0,0:10:04.51,0:10:09.76,Default,,0000,0000,0000,,لمَ أضاء القاتل المصابيح\Nبعد قتله نانجو-سان؟
Dialogue: 0,0:10:09.76,0:10:10.79,Default,,0000,0000,0000,,...كما
Dialogue: 0,0:10:14.75,0:10:18.83,Default,,0000,0000,0000,,لمَ ترك القاتل الشريط اللاصق بهذا الشكل؟
Dialogue: 0,0:10:19.00,0:10:23.16,Default,,0000,0000,0000,,لعلّه فعل ذلك كي يعرقلنا بعدما لاحقناه
Dialogue: 0,0:10:23.16,0:10:25.99,Default,,0000,0000,0000,,فيستطيع استغلاله للهرب
Dialogue: 0,0:10:25.99,0:10:28.83,Default,,0000,0000,0000,,!لكنّك كنت الوحيد الذي تعرقل
Dialogue: 0,0:10:32.45,0:10:34.82,Default,,0000,0000,0000,,...طلب مراجعة نصّ
Dialogue: 0,0:10:32.45,0:10:36.42,On Top,,0000,0000,0000,,:إلى نانجو-ساما\Nراجع النصّ من فضلك
Dialogue: 0,0:10:36.42,0:10:40.48,Default,,0000,0000,0000,,العاشرة وثلاث دقائق مساءً، أي قُبيل قتل نانجو-سان
Dialogue: 0,0:10:40.48,0:10:43.80,Default,,0000,0000,0000,,ظهر ملك الموت جينّاي في الحديقة\Nقرابة ذاك الوقت
Dialogue: 0,0:10:43.80,0:10:44.87,Default,,0000,0000,0000,,...لكن أليس
Dialogue: 0,0:10:44.87,0:10:45.87,Default,,0000,0000,0000,,!يا شقيّ
Dialogue: 0,0:10:46.26,0:10:48.33,Default,,0000,0000,0000,,!لا تلمس هذا
Dialogue: 0,0:10:48.76,0:10:52.75,Default,,0000,0000,0000,,هذا طلب مراجعة نصّ مقالة\Nستُنشر في مجلّة الأسبوع القادم
Dialogue: 0,0:10:53.00,0:10:56.25,Default,,0000,0000,0000,,كان نانجو-سان ينتظر وصولها الليلة
Dialogue: 0,0:10:56.25,0:10:57.63,Default,,0000,0000,0000,,!دعوني
Dialogue: 0,0:10:58.83,0:11:01.67,Default,,0000,0000,0000,,حضرة المفتّش، كان هذا الرجل المُريب\Nيتسكّع في الجوار
Dialogue: 0,0:11:01.67,0:11:04.91,Default,,0000,0000,0000,,!يا للفظاظة! لستُ شخصاً مريباً
Dialogue: 0,0:11:05.23,0:11:07.37,Default,,0000,0000,0000,,أونو-سان! أين كنت؟
Dialogue: 0,0:11:07.66,0:11:10.12,Default,,0000,0000,0000,,لم أجد أحداً بعدما رجعت من الحمّام
Dialogue: 0,0:11:10.12,0:11:12.16,Default,,0000,0000,0000,,فبحثتُ في أرجاء الحديقة
Dialogue: 0,0:11:12.16,0:11:15.29,Default,,0000,0000,0000,,!كان أنت! أنت من قتل زوجي
Dialogue: 0,0:11:15.52,0:11:17.44,Default,,0000,0000,0000,,لحظة! ما الذي تقولينه؟
Dialogue: 0,0:11:17.44,0:11:22.75,Default,,0000,0000,0000,,صحيح... أنت الوحيد بلا حجّة غياب\Nبين المتواجدين في مسرح الجريمة
Dialogue: 0,0:11:22.75,0:11:26.05,Default,,0000,0000,0000,,كنت لا تزال حاقداً عليه\N...بعد الحادثة قبل ثلاثة أعوام
Dialogue: 0,0:11:26.05,0:11:27.21,Default,,0000,0000,0000,,!لذا قتلته
Dialogue: 0,0:11:27.39,0:11:28.81,Default,,0000,0000,0000,,!سـ-سخافة
Dialogue: 0,0:11:28.81,0:11:32.50,Default,,0000,0000,0000,,ما هذه الحادثة التي وقعت قبل ثلاثة أعوام؟
Dialogue: 0,0:11:34.92,0:11:37.96,Default,,0000,0000,0000,,أعمل في برنامج ترفيهيّ الآن
Dialogue: 0,0:11:37.96,0:11:41.25,Default,,0000,0000,0000,,لكنّي كنت مخرج أفلام
Dialogue: 0,0:11:41.25,0:11:47.24,Default,,0000,0000,0000,,حتّى حادثة وقعت أثناء تصوير\Nفيلم لملك الموت جينّاي قبل ثلاثة أعوام
Dialogue: 0,0:11:47.57,0:11:52.58,Default,,0000,0000,0000,,لم يظهر بديل أدوار المجازفة\Nذاك اليوم مهما انتظرنا
Dialogue: 0,0:11:52.90,0:11:55.04,Default,,0000,0000,0000,,ليس باليد حيلة، سنمثّل المشهد دونه
Dialogue: 0,0:11:55.23,0:11:58.48,Default,,0000,0000,0000,,!لا يصحّ ذلك يا نانجو! المشهد خطر جداً
Dialogue: 0,0:11:58.48,0:12:00.00,Default,,0000,0000,0000,,يمكنك تنفيذه، صحيح يا كيتانو؟
Dialogue: 0,0:12:00.58,0:12:05.45,CharCard,,0000,0150,0004,,{\fad(300,300)}(28) كيتانو هيرويوكي\Nممثل أفلام
Dialogue: 0,0:12:01.02,0:12:03.18,On Top,,0000,0000,0000,,على الممثلين الصاعدين التمكّن
Dialogue: 0,0:12:03.18,0:12:04.72,On Top,,0000,0000,0000,,من تنفيذ هذا القدر على الأقل
Dialogue: 0,0:12:04.72,0:12:06.26,On Top,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:12:06.26,0:12:07.96,Default,,0000,0000,0000,,سأفعلها حضرة المخرج
Dialogue: 0,0:12:08.48,0:12:09.43,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:12:10.47,0:12:18.71,Default,,0000,0000,0000,,وافق الممثل المعنيّ كيتانو-كن، فبدأ التصوير بعد إلحاح نانجو
Dialogue: 0,0:12:19.21,0:12:22.54,Default,,0000,0000,0000,,لكنّ السيّارة انقلبت وانفجرت
Dialogue: 0,0:12:22.54,0:12:25.79,Default,,0000,0000,0000,,ومات كيتانو-كن
Dialogue: 0,0:12:26.87,0:12:31.42,Default,,0000,0000,0000,,تحمّلتُ المسؤولية كاملةً وتركتُ منصب المُخرج
Dialogue: 0,0:12:31.95,0:12:34.44,Default,,0000,0000,0000,,أبغضت نانجو حقّاً
Dialogue: 0,0:12:34.44,0:12:39.55,Default,,0000,0000,0000,,لكن يوجد هنا من يبغض\Nنانجو أكثر منّي بكثير
Dialogue: 0,0:12:40.25,0:12:43.85,Default,,0000,0000,0000,,فقد كانت هي حبيبة كيتانو-كن
Dialogue: 0,0:12:45.60,0:12:47.37,Default,,0000,0000,0000,,أهذا صحيح؟
Dialogue: 0,0:12:47.85,0:12:52.17,Default,,0000,0000,0000,,نعم، كان كيتانو هيرويوكي حبيبي بالفعل
Dialogue: 0,0:12:52.17,0:12:56.87,Default,,0000,0000,0000,,كنتُ أعمل لنفس الوكالة كممثلة\Nأفلام إثارة وتشويق من الدرجة الثانية
Dialogue: 0,0:12:57.46,0:13:02.77,Default,,0000,0000,0000,,!كانت حادثة مؤسفة بالفعل، لكنّي لا ألوم نانجو-سان عليها
Dialogue: 0,0:13:03.41,0:13:09.79,Default,,0000,0000,0000,,كانت ساتومي-سان معنا\Nأمام المبنى وقت مقتل نانجو-سان
Dialogue: 0,0:13:11.99,0:13:16.83,Default,,0000,0000,0000,,!صحيح! صوّرتُ ملك الموت جينّاي في الحديقة
Dialogue: 0,0:13:16.83,0:13:19.17,Default,,0000,0000,0000,,...ماذا؟! إن شاهدناه إذاً
Dialogue: 0,0:13:19.49,0:13:22.02,Default,,0000,0000,0000,,!يوجد مشغّل فيديو في الطابق السادس
Dialogue: 0,0:13:22.02,0:13:24.39,Default,,0000,0000,0000,,سأذهب لتجهيزه
Dialogue: 0,0:13:25.46,0:13:29.73,Default,,0000,0000,0000,,بالمناسبة، لمَ أظهر القاتل نفسه في الحديقة؟
Dialogue: 0,0:13:29.73,0:13:33.05,Default,,0000,0000,0000,,الأمر ينطبق على ظلّ النافذة، لا بدّ من وجود سبب
Dialogue: 0,0:13:34.34,0:13:35.91,Default,,0000,0000,0000,,!أتى من الطابق السفليّ
Dialogue: 0,0:13:38.13,0:13:38.92,Default,,0000,0000,0000,,!تعال بسرعة
Dialogue: 0,0:13:39.20,0:13:40.92,Default,,0000,0000,0000,,!الأدراج أسرع
Dialogue: 0,0:13:49.29,0:13:50.79,Default,,0000,0000,0000,,...ملك الموت جينّاي قد
Dialogue: 0,0:13:51.63,0:13:53.07,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:01.78,0:14:06.23,Default,,0000,0000,0000,,بعدما غادرتِ المصعد إذاً وجدتِ باب\Nمخرج الطوارئ مفتوحاً
Dialogue: 0,0:14:06.23,0:14:10.32,Default,,0000,0000,0000,,وأطلق ملك الموت جينّاي عليكِ النار فجأةً \Nبعدما خرج من المكتب
Dialogue: 0,0:14:10.89,0:14:12.98,Default,,0000,0000,0000,,ثم لاذ بالفرار، صحيح؟
Dialogue: 0,0:14:13.76,0:14:15.16,Default,,0000,0000,0000,,نـ-نعم
Dialogue: 0,0:14:15.16,0:14:19.59,Default,,0000,0000,0000,,هذا غريب، مضت ساعة تماماً مُذ قُتل نانجو-سان
Dialogue: 0,0:14:19.59,0:14:24.62,Default,,0000,0000,0000,,هل اختبأ المجرم طوال ذاك الوقت\Nفي المبنى متوارياً عن أنظار الشرطة؟
Dialogue: 0,0:14:25.42,0:14:28.00,Default,,0000,0000,0000,,ولمَ أطلق عليها النار؟
Dialogue: 0,0:14:28.00,0:14:31.91,Default,,0000,0000,0000,,...فقد كانت ساتومي-سان بمفردها، الهرب دون الإطلاق
Dialogue: 0,0:14:31.91,0:14:33.91,Default,,0000,0000,0000,,وتجنّب لفت الانتباه كان ليفيده أكثر
Dialogue: 0,0:14:33.91,0:14:34.62,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:14:36.03,0:14:37.95,Default,,0000,0000,0000,,أنهينا تحليل ساحة الجريمة
Dialogue: 0,0:14:37.95,0:14:41.07,Default,,0000,0000,0000,,شكراً، هل وجدتم الرصاصة؟
Dialogue: 0,0:14:41.07,0:14:45.66,Default,,0000,0000,0000,,كلا، خرجت عبر مخرج الطوارئ غالباً
Dialogue: 0,0:14:46.66,0:14:49.63,Default,,0000,0000,0000,,سيكون العثور عليها صعباً في تلك الحالة
Dialogue: 0,0:14:50.35,0:14:53.08,Default,,0000,0000,0000,,حضرة المفتش، أنهينا تجهيز التصوير
Dialogue: 0,0:14:53.89,0:14:55.26,Default,,0000,0000,0000,,فلنشاهد إذاً
Dialogue: 0,0:15:01.39,0:15:03.04,Default,,0000,0000,0000,,لمَ هذا بمفرده؟
Dialogue: 0,0:15:03.83,0:15:05.50,Default,,0000,0000,0000,,لا يزال دافئاً
Dialogue: 0,0:15:05.96,0:15:08.46,Default,,0000,0000,0000,,!كما لم يُرجع شريطه
Dialogue: 0,0:15:08.96,0:15:10.21,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:15:11.25,0:15:13.66,Default,,0000,0000,0000,,لا يصحّ بك لمس أغراض الآخرين
Dialogue: 0,0:15:14.70,0:15:15.87,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:15:19.08,0:15:23.36,Default,,0000,0000,0000,,!هكذا إذاً! فهمت حيلة القاتل
Dialogue: 0,0:15:23.36,0:15:25.36,Default,,0000,0000,0000,,لكن لا زلتُ بحاجة لدليل
Dialogue: 0,0:15:25.36,0:15:27.42,Default,,0000,0000,0000,,!صحيح! رسالة الفاكس تلك
Dialogue: 0,0:15:29.44,0:15:31.30,Default,,0000,0000,0000,,كونان! أين تذهب؟
Dialogue: 0,0:15:34.35,0:15:36.14,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:15:36.14,0:15:38.76,Default,,0000,0000,0000,,!لا شكّ في الأمر! القاتل هو ذاك الشخص
Dialogue: 0,0:15:38.76,0:15:42.16,Default,,0000,0000,0000,,!كونان! كفّ عن التجوّل
Dialogue: 0,0:15:42.46,0:15:44.46,Default,,0000,0000,0000,,!انظر لهذه يا عمّ
Dialogue: 0,0:15:45.67,0:15:49.67,Default,,0000,0000,0000,,...ماذا؟ إنّها رسالة الفاكس تلك
Dialogue: 0,0:15:49.67,0:15:50.88,Default,,0000,0000,0000,,ما المهمّ فيها؟
Dialogue: 0,0:15:54.83,0:15:55.99,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:15:55.99,0:15:57.33,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:15:57.33,0:15:58.78,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:15:58.78,0:16:00.10,Default,,0000,0000,0000,,إنّه موري-سان
Dialogue: 0,0:16:00.10,0:16:01.13,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:16:01.62,0:16:03.44,Default,,0000,0000,0000,,مرحباً؟ موري-كن؟
Dialogue: 0,0:16:04.11,0:16:06.08,Default,,0000,0000,0000,,!ماذا؟ حللت اللغز؟
Dialogue: 0,0:16:06.08,0:16:09.36,Default,,0000,0000,0000,,نعم، لم يختف القاتل من مسرح الجريمة
Dialogue: 0,0:16:09.36,0:16:11.79,Default,,0000,0000,0000,,بل لم يكن موجوداً من البداية
Dialogue: 0,0:16:11.79,0:16:14.81,Default,,0000,0000,0000,,ماذا؟! ما قصدك؟
Dialogue: 0,0:16:14.81,0:16:21.35,Default,,0000,0000,0000,,أي أنّ نانجو-سان كان مقتولاً سلفاً\Nعندما وصلنا أمام المبنى
Dialogue: 0,0:16:21.35,0:16:25.88,Default,,0000,0000,0000,,لكنّ كونان-كن والبقيّة رأوا\Nالقاتل عبر النافذة
Dialogue: 0,0:16:25.88,0:16:29.07,Default,,0000,0000,0000,,تلك كانت حيلة من إعداد القاتل
Dialogue: 0,0:16:29.07,0:16:30.17,Default,,0000,0000,0000,,!حيلة؟
Dialogue: 0,0:16:30.17,0:16:35.50,Default,,0000,0000,0000,,سأوضّح الأمر لكم، لذا فليصعد الجميع\Nللطابق السابع من فضلكم
Dialogue: 0,0:16:35.50,0:16:39.49,Default,,0000,0000,0000,,أحضروا معكم شريطاً لاصقاً وخيط صيد سمك أيضاً
Dialogue: 0,0:16:39.49,0:16:41.78,Default,,0000,0000,0000,,شريط لاصق وخيط صيد؟
Dialogue: 0,0:16:42.69,0:16:45.79,Default,,0000,0000,0000,,أتى الجميع، لذا سأبدأ
Dialogue: 0,0:16:46.19,0:16:49.61,Default,,0000,0000,0000,,،أوّلاً، بعدما قتل المجرمُ نانجو-سان
Dialogue: 0,0:16:49.61,0:16:52.27,Default,,0000,0000,0000,,أطفأ مصابيح الغرفة وألصق الشريط بالنافذة
Dialogue: 0,0:16:52.27,0:16:56.75,Default,,0000,0000,0000,,بخطوط متعرّجة لرسم شكل إنسان
Dialogue: 0,0:17:00.43,0:17:05.21,Default,,0000,0000,0000,,...تالياً، ربط طرف خيط الصيد بالفجوة
Dialogue: 0,0:17:05.21,0:17:08.52,Default,,0000,0000,0000,,بين المصعد والباب الخارجيّ
Dialogue: 0,0:17:08.80,0:17:15.62,Default,,0000,0000,0000,,ثمّ لفّ الخيط ووضعه حول مفتاح\Nالمصابيح في المكتب وسحبه
Dialogue: 0,0:17:15.72,0:17:20.04,Default,,0000,0000,0000,,وربط الطرف الآخر بالشريط اللاصق على النافذة
Dialogue: 0,0:17:20.04,0:17:25.96,Default,,0000,0000,0000,,ما تبقّى هو انتظار أن يضغط أحد ممن\Nهلعوا للمبنى زرّ استدعاء المصعد للأسفل
Dialogue: 0,0:17:29.55,0:17:37.58,Default,,0000,0000,0000,,هكذا إذا نظرت من الخارج، سيبدو لك أنّ الهيئة\Nبالشريط اللاصق إنسان بتأثير الأنوار
Dialogue: 0,0:17:37.84,0:17:40.77,Default,,0000,0000,0000,,سيُنزع الشريط مع سحب الخيط
Dialogue: 0,0:17:40.77,0:17:43.50,Default,,0000,0000,0000,,فيبدو كما لو أنّ الشخص قد سقط
Dialogue: 0,0:17:43.88,0:17:48.76,Default,,0000,0000,0000,,مع سحب الشريط المستمر، وصلت لفافته باب المصعد
Dialogue: 0,0:17:48.76,0:17:53.29,Default,,0000,0000,0000,,ثمّ انقطع خيط الصيد، فتبقّى الشريط اللاصق
Dialogue: 0,0:17:53.66,0:17:55.75,Default,,0000,0000,0000,,لكن ماذا عن تلك الطلقة النارية؟
Dialogue: 0,0:17:55.75,0:18:00.21,Default,,0000,0000,0000,,كانت صوتاً على شريط كاسيت
Dialogue: 0,0:18:00.50,0:18:01.70,Default,,0000,0000,0000,,شريط كاسيت؟
Dialogue: 0,0:18:01.70,0:18:06.12,Default,,0000,0000,0000,,أجل، أردى الفاعلُ نانجو-سان قتيلاً\Nبمسدّس مزوّد بكاتم للصوت
Dialogue: 0,0:18:06.53,0:18:10.95,Default,,0000,0000,0000,,نصب حيلة المصعد، ثمّ نزل للطابق السادس\Nمن أدراج الطوارئ
Dialogue: 0,0:18:10.95,0:18:15.08,Default,,0000,0000,0000,,وأدخل شريط صوت عيار ناريّ مسجل\Nفي آلة التشغيل
Dialogue: 0,0:18:15.94,0:18:20.67,Default,,0000,0000,0000,,لا يمكنك معرفة الطابق الذي أُطلق فيه\Nالعيار الناريّ من أسفل المبنى بالفعل
Dialogue: 0,0:18:20.67,0:18:25.26,Default,,0000,0000,0000,,أضاف القاتل 15 دقيقة فارغة لبداية الشريط
Dialogue: 0,0:18:25.26,0:18:30.26,Default,,0000,0000,0000,,واستغلّ ذاك الوقت للظهور\Nبهيئة ملك الموت جينّاي في الحديقة
Dialogue: 0,0:18:30.26,0:18:33.17,Default,,0000,0000,0000,,واستدراجنا للمبنى
Dialogue: 0,0:18:34.29,0:18:40.17,Default,,0000,0000,0000,,التقى القاتل بنا بعدها واستمع للعيار الناريّ\Nكي يخلق حجّة غياب لنفسه
Dialogue: 0,0:18:40.17,0:18:44.08,Default,,0000,0000,0000,,...ا-انتظر! أتقصد أنّ القاتل
Dialogue: 0,0:18:44.08,0:18:47.86,Default,,0000,0000,0000,,...نعم، الوحيد القادر على تنفيذ هذه الحيلة
Dialogue: 0,0:18:47.86,0:18:51.30,Default,,0000,0000,0000,,!هي أنت يا يوشينو ساتومي-سان
Dialogue: 0,0:18:51.62,0:18:54.83,Default,,0000,0000,0000,,لكن ما سبب الطلقة الثانية إذاً؟
Dialogue: 0,0:18:54.83,0:18:57.94,Default,,0000,0000,0000,,لم يكن يُفترض أن تحصل
Dialogue: 0,0:18:57.94,0:19:03.79,Default,,0000,0000,0000,,لم تدرك يوشينو-سان أنّ خيار إعادة إعادة\Nالتشغيل تلقائياً في جهاز التسجيل كان مُداراً
Dialogue: 0,0:19:03.79,0:19:11.66,Default,,0000,0000,0000,,،بما أنّ الشريط الذي استعملته كان من 60 دقيقة\Nسمعنا الطلقة نفسها بعد مرور ساعة
Dialogue: 0,0:19:11.98,0:19:16.04,Default,,0000,0000,0000,,عندما نزلتِ للطابق السفليّ\N...لتجهيز جهاز التسجيل
Dialogue: 0,0:19:16.04,0:19:18.21,Default,,0000,0000,0000,,استرجعتِ خيط الصيد غالباً
Dialogue: 0,0:19:18.21,0:19:20.46,Default,,0000,0000,0000,,وعندها سمعتِ صوت الطلقة فجأةً
Dialogue: 0,0:19:22.41,0:19:28.16,Default,,0000,0000,0000,,في دهشتك، أخفيتِ الشريط سريعاً\Nواختلقتِ كذبة تخبريننا بها
Dialogue: 0,0:19:28.16,0:19:29.84,Default,,0000,0000,0000,,!لا يوجد لديك دليل
Dialogue: 0,0:19:30.03,0:19:32.27,Default,,0000,0000,0000,,الدليل موجود
Dialogue: 0,0:19:32.27,0:19:35.29,Default,,0000,0000,0000,,حضرة المفتّش، انظر لرسائل الفاكس من فضلك
Dialogue: 0,0:19:35.73,0:19:36.45,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:19:37.21,0:19:41.38,Default,,0000,0000,0000,,ستجد بقع دماء على إحدى الأوراق
Dialogue: 0,0:19:41.60,0:19:46.64,Default,,0000,0000,0000,,فقد وصل فاكس لحظة وقوع الجريمة
Dialogue: 0,0:19:46.64,0:19:47.83,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:19:47.83,0:19:51.63,Default,,0000,0000,0000,,أي أنّ الوقت المذكور على الورقة ببقع الدماء
Dialogue: 0,0:19:51.63,0:19:55.29,Default,,0000,0000,0000,,هو زمن قتل نانجو-سان الحقيقيّ
Dialogue: 0,0:19:55.75,0:19:57.25,Default,,0000,0000,0000,,التاسعة وتسع وخمسون مساءً
Dialogue: 0,0:19:57.25,0:20:01.09,Default,,0000,0000,0000,,سمعنا الطلقة أمام المبنى\Nعند قرابة العاشرة والربع
Dialogue: 0,0:20:01.09,0:20:04.72,Default,,0000,0000,0000,,أي بعد 15 دقيقة
Dialogue: 0,0:20:05.33,0:20:12.12,Default,,0000,0000,0000,,يُفترض أن يكون صوت الطلقة موجوداً\Nعلى الشريط الذي أخذتِه من كونان قبل قليل
Dialogue: 0,0:20:12.29,0:20:16.19,Default,,0000,0000,0000,,كما أنّ حركة ملك الموت جينّاي المرنة في الحديقة
Dialogue: 0,0:20:16.19,0:20:20.40,Default,,0000,0000,0000,,كانت لأنّك ممثلة أفلام إثارة سابقة
Dialogue: 0,0:20:21.07,0:20:25.14,Default,,0000,0000,0000,,معك حقّ، قتلتُ نانجو
Dialogue: 0,0:20:25.14,0:20:29.50,Default,,0000,0000,0000,,!للانتقام من قتله هيرويوكي قبل 3 أعوام
Dialogue: 0,0:20:29.50,0:20:31.95,Default,,0000,0000,0000,,...لكن كان ذلك حادثاً
Dialogue: 0,0:20:32.21,0:20:34.59,Default,,0000,0000,0000,,ذلك ما ظننتُه بدايةً
Dialogue: 0,0:20:34.59,0:20:38.05,Default,,0000,0000,0000,,لكنّي وجدتُ مذكّرة هيريوكي
Dialogue: 0,0:20:38.05,0:20:39.63,Default,,0000,0000,0000,,،قبل الحادث بأسبوع
Dialogue: 0,0:20:39.63,0:20:44.91,Default,,0000,0000,0000,,ذُكر فيها أخذه لمكان نانجو\Nفي دور ملك الموت جينّاي
Dialogue: 0,0:20:45.41,0:20:51.38,Default,,0000,0000,0000,,التحقتُ بوكالة نانجو وأصبحت\Nمديرة أعماله لأكتشف حقيقة موته
Dialogue: 0,0:20:51.84,0:20:57.15,Default,,0000,0000,0000,,!ثمّ قبل شهر، باح نانجو الثمل بكلّ شيء
Dialogue: 0,0:20:58.19,0:21:03.10,Default,,0000,0000,0000,,يوشينو، أتذكرين الشاب الذي\Nمات قبل ثلاثة أعوام
Dialogue: 0,0:21:03.10,0:21:05.29,Default,,0000,0000,0000,,أثناء تصوير ملك الموت جينّاي؟
Dialogue: 0,0:21:05.68,0:21:10.00,Default,,0000,0000,0000,,نـ-نعم، ألم يكن حادثاً أثناء تمثيله لمشهد\Nخطر دون بديل؟
Dialogue: 0,0:21:10.77,0:21:12.05,Default,,0000,0000,0000,,حادث؟
Dialogue: 0,0:21:13.17,0:21:14.36,Default,,0000,0000,0000,,...حادث إذاً
Dialogue: 0,0:21:15.01,0:21:17.01,Default,,0000,0000,0000,,سأخبركِ بأمر مثير
Dialogue: 0,0:21:17.01,0:21:22.72,Default,,0000,0000,0000,,كذبتُ على بديل الأدوار الخطرة\Nكيلا يأتي ذاك اليوم
Dialogue: 0,0:21:23.30,0:21:28.67,Default,,0000,0000,0000,,،كان ذاك الفتى مجرّد مبتدئ\N!لكنّه ظنّ بإمكانه سرقة دوري
Dialogue: 0,0:21:30.79,0:21:32.58,Default,,0000,0000,0000,,أتعرفين ما هذا؟
Dialogue: 0,0:21:32.82,0:21:34.74,Default,,0000,0000,0000,,لا، ما هو؟
Dialogue: 0,0:21:35.99,0:21:37.54,Default,,0000,0000,0000,,تميمة حظّي الحسن
Dialogue: 0,0:21:37.86,0:21:41.25,Default,,0000,0000,0000,,مسمار ملولب يثبّت إطارات السيّارة الأمامية
Dialogue: 0,0:21:41.48,0:21:43.95,Default,,0000,0000,0000,,...مـ-ماذا؟! إذاً
Dialogue: 0,0:21:43.95,0:21:48.09,Default,,0000,0000,0000,,!صحيح! لم ينتظر وقوع الحادثة
Dialogue: 0,0:21:48.27,0:21:50.67,Default,,0000,0000,0000,,!بل قتل هيرويوكي بيديه
Dialogue: 0,0:21:52.22,0:21:55.71,Default,,0000,0000,0000,,أرسلتُ التهديد لأستغلّ مراسلي الإعلام\Nلصنع حجّة غياب
Dialogue: 0,0:21:56.30,0:22:00.72,Default,,0000,0000,0000,,عندما اقترحتُ الأمر على نانجو\Nللترويج للفيلم، وافق من فوره
Dialogue: 0,0:22:01.09,0:22:03.71,Default,,0000,0000,0000,,الباقي كما قلت
Dialogue: 0,0:23:40.78,0:23:43.82,Default,,0000,0000,0000,,ملك الموت جينّاي ضدّ المتحرّي موري كوغورو
Dialogue: 0,0:23:44.52,0:23:47.21,Default,,0000,0000,0000,,يبدو أنّ ملك الموت جينّاي غُلب تماماً
Dialogue: 0,0:23:48.85,0:23:50.23,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:23:50.23,0:23:53.66,Default,,0000,0000,0000,,فكلمة "مستعصٍ" لا تتواجد\N!في قاموس موري كوغورو
Dialogue: 0,0:23:55.57,0:23:57.68,Default,,0000,0000,0000,,وذلك بفضل من؟
Dialogue: 0,0:24:00.09,0:24:03.32,Default,,0000,0000,0000,,تبّاً! لا أمامنا سوى فتحه بالقوّة
Dialogue: 0,0:24:08.20,0:24:11.50,Default,,0000,0000,0000,,!لم تظهر آثار على أيّ من أغراضهم؟
Dialogue: 0,0:24:08.20,0:24:11.50,Default,,0000,0000,0000,,!لم تظهر آثار على أيّ من أغراضهم؟
Dialogue: 0,0:24:12.90,0:24:19.40,Default,,0000,0000,0000,,تلاعب المجرم بالضحيّة في المكتب الذي\Nلم يكن فيه أحد سواه
Dialogue: 0,0:24:19.40,0:24:20.59,Default,,0000,0000,0000,,!وسمّمه
Dialogue: 0,0:24:22.06,0:24:23.86,Default,,0000,0000,0000,,كما لو كان سحراً
Dialogue: 0,0:24:23.86,0:24:29.83,On Top,,0000,0000,0000,,جريمة قتل رئيس الشركة المالية
Dialogue: 0,0:24:24.24,0:24:25.89,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.89,0:24:29.10,Default,,0000,0000,0000,,جريمة قتل رئيس الشركة المالية
Dialogue: 0,0:24:45.33,0:24:48.04,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.04,0:24:49.44,Default,,0000,0000,0000,,مرحاض
Dialogue: 0,0:24:50.72,0:24:52.69,Default,,0000,0000,0000,,!الحلقة القادمة معقّدة حقّاً
Dialogue: 0,0:24:52.74,0:24:53.66,Default,,0000,0000,0000,,!(إنّه مشبوه (نتن
Dialogue: 0,0:24:53.66,0:24:54.74,Default,,0000,0000,0000,,آسف

