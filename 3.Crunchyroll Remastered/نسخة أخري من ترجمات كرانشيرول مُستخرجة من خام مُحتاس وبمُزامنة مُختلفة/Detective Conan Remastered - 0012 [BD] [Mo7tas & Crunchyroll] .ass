Dialogue: 0,0:00:01.31,0:00:02.77,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.77,0:00:05.63,Default,,0000,0000,0000,,أُجبر طالب الثانوية شينتشي على تجرّع\Nعقار قلّص جسده
Dialogue: 0,0:00:05.63,0:00:08.34,Default,,0000,0000,0000,,إن عرفت المنظمة أنّ شينتشي وكونان\N،هما نفس الشخص
Dialogue: 0,0:00:08.34,0:00:10.30,Default,,0000,0000,0000,,!فسيقع جميع من حولي في خطر
Dialogue: 0,0:00:10.30,0:00:12.55,Default,,0000,0000,0000,,!البروفسور آغاسا وحده من يعرف الحقيقة
Dialogue: 0,0:00:12.55,0:00:15.41,Default,,0000,0000,0000,,أُخفي هويتي، والحقيقة واحدة دوماً\N!اليوم كذلك
Dialogue: 0,0:01:45.84,0:01:52.00,Title,,0000,0000,0000,,{\fad(300,0)}اختطاف أيومي-تشان
Dialogue: 0,0:01:47.28,0:01:49.53,Default,,0000,0000,0000,,اختطاف أيومي-تشان
Dialogue: 0,0:01:53.11,0:01:56.90,Default,,0000,0000,0000,,لا وجود للجريمة الكاملة
Dialogue: 0,0:01:57.44,0:02:00.31,Default,,0000,0000,0000,,يؤسفني قول هذا، لكن جريمتك بوضوح الشمس
Dialogue: 0,0:02:00.31,0:02:03.23,Default,,0000,0000,0000,,ارتكبت ثلاثة أخطاء أساسية
Dialogue: 0,0:02:03.23,0:02:06.97,Default,,0000,0000,0000,,الأوّل: العلب المبعثرة حول حاوية\Nالنفايات بشكل لا طبيعي
Dialogue: 0,0:02:06.97,0:02:10.82,Default,,0000,0000,0000,,عددها كفيلٌ بإثبات أنّ هناك شيء داخل الحاوية
Dialogue: 0,0:02:11.09,0:02:14.80,Default,,0000,0000,0000,,الثاني: الآيس كريم الذي كنت تأكله\Nقبل قليل مرميّ في الخارج
Dialogue: 0,0:02:14.80,0:02:17.13,Default,,0000,0000,0000,,،أجل، اختبأت في عجلة من أمرك
Dialogue: 0,0:02:17.13,0:02:19.73,Default,,0000,0000,0000,,لذا أسقطته على الأرض، نصف مأكول
Dialogue: 0,0:02:20.00,0:02:23.19,Default,,0000,0000,0000,,...الثالث: أكثر الأدلّة إدانة
Dialogue: 0,0:02:23.19,0:02:27.81,Default,,0000,0000,0000,,هو أنّ بإمكاني رؤية مؤخرتك الكبيرة\N!بين العلب في الحاوية يا غينتا-كن
Dialogue: 0,0:02:28.62,0:02:30.40,Default,,0000,0000,0000,,!أنتَ كثير الكلام
Dialogue: 0,0:02:30.40,0:02:35.94,Italics,,0000,0330,15,,مُعتقل
Dialogue: 0,0:02:31.87,0:02:35.94,Default,,0000,0000,0000,,!أيومي-تشان، وجدتُ غينتا أيضاً! ارجعي
Dialogue: 0,0:02:36.61,0:02:37.69,Default,,0000,0000,0000,,بهذه السرعة؟
Dialogue: 0,0:02:37.69,0:02:42.65,Default,,0000,0000,0000,,...اللعبة ليست مسليّة عندما تكون الملاحق\N!أقصد، المتحرّي. دائماً ما تنتهي بسرعة
Dialogue: 0,0:02:42.90,0:02:44.86,Default,,0000,0000,0000,,الأمر ليس مسلياً لي أيضاً
Dialogue: 0,0:02:44.86,0:02:49.05,Default,,0000,0000,0000,,طالب في الثانوية يلعب لعبة المتحرّيين في الحديقة
Dialogue: 0,0:02:49.05,0:02:51.28,Default,,0000,0000,0000,,!هذه الشارات رائعة
Dialogue: 0,0:02:51.64,0:02:54.98,Default,,0000,0000,0000,,!مكتوب عليها "ديتيكتف بويز"، أي فتيان التحرّي
Dialogue: 0,0:02:55.29,0:02:59.92,Default,,0000,0000,0000,,نحن طلّاب الابتدائية الوحيدون في العالم\N!الذين يملكون شارات كهذه
Dialogue: 0,0:02:59.92,0:03:01.44,Default,,0000,0000,0000,,صـ-صحيح
Dialogue: 0,0:03:01.92,0:03:04.91,Default,,0000,0000,0000,,توجد قطع إرسال واستقبال صغيرة داخلها
Dialogue: 0,0:03:04.91,0:03:07.62,Default,,0000,0000,0000,,يمكنكم التواصل على مسافات بعيدة
Dialogue: 0,0:03:07.62,0:03:09.70,Default,,0000,0000,0000,,باستعمال القرص في الخلف لتغيير التردد
Dialogue: 0,0:03:09.70,0:03:13.15,Default,,0000,0000,0000,,إنّها جيدة لألعاب الأطفال، لكنّي أفضّل ألّا يقحموني
Dialogue: 0,0:03:13.78,0:03:15.32,Default,,0000,0000,0000,,،لو لم يأتوا لدعوتي للعب
Dialogue: 0,0:03:15.32,0:03:18.61,Default,,0000,0000,0000,,لذهبت مع ران لمهرجان جامعة تيتان
Dialogue: 0,0:03:18.77,0:03:25.64,Default,,0000,0000,0000,,!لا تقلق! سأستمتع كثيراً مع فتيات الجامعة بدلاً عنك
Dialogue: 0,0:03:25.64,0:03:29.98,Default,,0000,0000,0000,,!حسنٌ! سأكون المتحرّي هذه المرة وأنتم المجرمون
Dialogue: 0,0:03:30.43,0:03:32.86,Default,,0000,0000,0000,,عليّ أن أكون المجرم مجدداً؟
Dialogue: 0,0:03:32.86,0:03:36.46,Default,,0000,0000,0000,,!يكفي مُتحرٍّ واحد! اذهبا
Dialogue: 0,0:03:36.46,0:03:37.73,Default,,0000,0000,0000,,تبّاً
Dialogue: 0,0:03:38.00,0:03:39.63,Default,,0000,0000,0000,,...واحد، اثنان، ثلاثة
Dialogue: 0,0:03:39.63,0:03:41.67,Default,,0000,0000,0000,,!أُحب الغميّضة كثيراً
Dialogue: 0,0:03:41.67,0:03:42.96,Default,,0000,0000,0000,,!أسرع يا كونان
Dialogue: 0,0:03:42.96,0:03:43.78,Default,,0000,0000,0000,,!أ-أجل
Dialogue: 0,0:03:44.13,0:03:46.95,Default,,0000,0000,0000,,يجرّونني معهم باستمرار
Dialogue: 0,0:03:46.95,0:03:49.73,Default,,0000,0000,0000,,ماذا لو تحوّلت لأحمق هكذا؟
Dialogue: 0,0:03:55.23,0:03:57.15,Default,,0000,0000,0000,,سأصعد، المعذرة
Dialogue: 0,0:03:57.15,0:03:59.57,Default,,0000,0000,0000,,!تسع وتسعون، مئة
Dialogue: 0,0:03:59.57,0:04:02.23,Default,,0000,0000,0000,,...حسنٌ، سأريكم مهارة قائد فرقة فتيان التحرّي
Dialogue: 0,0:04:02.23,0:04:05.14,Default,,0000,0000,0000,,!كوجيما غينتا-ساما
Dialogue: 0,0:04:12.47,0:04:14.61,Default,,0000,0000,0000,,يبحث غينتا بجد
Dialogue: 0,0:04:18.42,0:04:21.07,Default,,0000,0000,0000,,"سلسلة جرائم اختطاف وقتل فتيات"
Dialogue: 0,0:04:21.51,0:04:24.21,Default,,0000,0000,0000,,لم يمسكوا بالمجرم بعد؟
Dialogue: 0,0:04:24.21,0:04:26.90,Default,,0000,0000,0000,,مخيف، صحيح؟
Dialogue: 0,0:04:27.16,0:04:28.62,Default,,0000,0000,0000,,...أيومي-تشان
Dialogue: 0,0:04:28.62,0:04:32.16,Default,,0000,0000,0000,,يستهدفون الفتيات الظريفات فقط، صحيح؟
Dialogue: 0,0:04:32.16,0:04:35.65,Default,,0000,0000,0000,,هذا يعني أنّي في خطر كبير
Dialogue: 0,0:04:37.19,0:04:40.38,Default,,0000,0000,0000,,لكنّي لا أشعر بالقلق
Dialogue: 0,0:04:40.38,0:04:41.61,Default,,0000,0000,0000,,...إن حصل مكروه
Dialogue: 0,0:04:41.61,0:04:43.98,Default,,0000,0000,0000,,فستكون موجوداً لحمايتي، صحيح يا كونان-كن؟
Dialogue: 0,0:04:47.77,0:04:52.19,Default,,0000,0000,0000,,!فقدرنا أن نكون معاً
Dialogue: 0,0:04:53.64,0:04:55.60,Default,,0000,0000,0000,,...أيومي-تشان، رويدك
Dialogue: 0,0:04:57.13,0:04:59.38,Default,,0000,0000,0000,,!وجدتك يا كونان
Dialogue: 0,0:04:59.38,0:05:03.03,Default,,0000,0000,0000,,قد تجيد إيجاد الآخرين، لكنك فاشل في الاختباء
Dialogue: 0,0:05:04.47,0:05:06.60,Default,,0000,0000,0000,,أنا أكره الهرب والاختباء
Dialogue: 0,0:05:06.60,0:05:09.65,Default,,0000,0000,0000,,هذا غريب، سمعتُ صوت أيومي
Dialogue: 0,0:05:10.96,0:05:12.86,Default,,0000,0000,0000,,!حمقاء! اختبئي بسرعة
Dialogue: 0,0:05:13.96,0:05:15.50,Default,,0000,0000,0000,,أكان شيء هناك؟
Dialogue: 0,0:05:15.50,0:05:16.69,Default,,0000,0000,0000,,!قطّة فقط! قطّة
Dialogue: 0,0:05:17.24,0:05:20.11,Default,,0000,0000,0000,,...حسناً، مكان للاختباء
Dialogue: 0,0:05:23.07,0:05:25.94,Default,,0000,0000,0000,,!ما الذي يؤخر ذاك الأحمق؟
Dialogue: 0,0:05:32.48,0:05:33.69,Default,,0000,0000,0000,,!يا لحظّي
Dialogue: 0,0:05:38.55,0:05:40.88,Default,,0000,0000,0000,,!وجدت ميتسوهيكو
Dialogue: 0,0:05:42.59,0:05:45.85,Default,,0000,0000,0000,,هذا غريب، كان يُفترض ألّا يجدني علمياً
Dialogue: 0,0:05:46.42,0:05:48.81,Default,,0000,0000,0000,,أين العلميّ في هذا؟
Dialogue: 0,0:05:48.81,0:05:51.53,Default,,0000,0000,0000,,!حسنٌ! بقيت أيومي فقط
Dialogue: 0,0:05:54.33,0:05:56.60,Default,,0000,0000,0000,,...غينتا الأحمق
Dialogue: 0,0:05:56.60,0:06:00.57,Default,,0000,0000,0000,,كيف له أن يتأخر هكذا في إيجاد \N!فتاة صغيرة عادية؟
Dialogue: 0,0:06:01.41,0:06:03.49,Default,,0000,0000,0000,,ليست فتاةً صغيرة عادية
Dialogue: 0,0:06:04.53,0:06:06.47,Default,,0000,0000,0000,,...لا-لا تهتم
Dialogue: 0,0:06:08.48,0:06:11.29,Default,,0000,0000,0000,,سأضبط لوح التزلج الذي أعطاني إيّاه البروفسور
Dialogue: 0,0:06:14.35,0:06:18.72,Default,,0000,0000,0000,,أتمانع إن سألتك شيئاً؟
Dialogue: 0,0:06:18.72,0:06:23.44,Default,,0000,0000,0000,,ما... ما شعورك تجاه أيومي-تشان؟
Dialogue: 0,0:06:23.44,0:06:26.96,Default,,0000,0000,0000,,!أسألك عن شعورك تجاهها كفتاة؟
Dialogue: 0,0:06:26.96,0:06:28.81,Default,,0000,0000,0000,,!مـ-مجرد صديقة
Dialogue: 0,0:06:29.42,0:06:31.78,Default,,0000,0000,0000,,هكذا إذاً؟
Dialogue: 0,0:06:32.21,0:06:35.48,Default,,0000,0000,0000,,...ميتسوهيكو، أيمكن أنّك معجب
Dialogue: 0,0:06:37.34,0:06:41.49,Default,,0000,0000,0000,,كلا! سألتك عن رأيك لمساعدتي\N!في تحديد خطّة حياتي فقط
Dialogue: 0,0:06:41.49,0:06:45.16,Default,,0000,0000,0000,,خطّة حياتك؟ أتقصد الزواج؟
Dialogue: 0,0:06:46.37,0:06:49.58,Default,,0000,0000,0000,,!يا لحظّك! يصنع لك البروفسور أشياء كثيرة
Dialogue: 0,0:06:50.41,0:06:53.19,Default,,0000,0000,0000,,...يا إلهي، أطفال هذه الأيام
Dialogue: 0,0:06:53.19,0:06:55.13,Default,,0000,0000,0000,,!ما الذي أخّرك هكذا؟
Dialogue: 0,0:06:57.65,0:07:00.44,Default,,0000,0000,0000,,!يكفي! اعتذرت بالفعل
Dialogue: 0,0:07:00.44,0:07:02.27,Default,,0000,0000,0000,,!سنكون في مشكلة إلم نتحرك
Dialogue: 0,0:07:02.27,0:07:03.52,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:10.22,0:07:12.74,Default,,0000,0000,0000,,لم تجد أيومي-تشان بعد؟
Dialogue: 0,0:07:12.96,0:07:15.46,Default,,0000,0000,0000,,استسلم واطلب منها الخروج إذاً
Dialogue: 0,0:07:15.46,0:07:16.37,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:07:16.76,0:07:21.07,Default,,0000,0000,0000,,!مُحال أن أقول شيئاً سخيفاً كهذا أمامها
Dialogue: 0,0:07:21.45,0:07:24.28,Default,,0000,0000,0000,,هكذا إذاً، غينتا معجب بأيومي-تشان أيضاً
Dialogue: 0,0:07:24.95,0:07:28.87,Default,,0000,0000,0000,,!فقدرنا أن نكون معاً
Dialogue: 0,0:07:30.16,0:07:32.32,Default,,0000,0000,0000,,...يا للوضع الذي وقعتُ فيه
Dialogue: 0,0:07:34.78,0:07:36.49,Default,,0000,0000,0000,,أيومي-تشان! أتسمعينني؟
Dialogue: 0,0:07:36.49,0:07:38.91,Default,,0000,0000,0000,,لننه اللعبة، يمكنك الخروج
Dialogue: 0,0:07:41.52,0:07:42.64,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:07:42.64,0:07:44.82,Default,,0000,0000,0000,,أرجعت للبيت قبلنا؟
Dialogue: 0,0:07:45.27,0:07:47.87,Default,,0000,0000,0000,,!أيمكن أن أمراً حلّ بها؟
Dialogue: 0,0:07:48.39,0:07:50.33,Default,,0000,0000,0000,,...حسناً، سأرفع الصوت
Dialogue: 0,0:07:50.80,0:07:52.85,Default,,0000,0000,0000,,!أيومي-تشان! أيومي-تشان
Dialogue: 0,0:07:54.05,0:07:55.54,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:07:57.47,0:07:58.62,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:08:01.29,0:08:02.62,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:08:02.62,0:08:03.59,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:08:03.59,0:08:04.57,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:08:04.96,0:08:06.49,Default,,0000,0000,0000,,!أين أنت الآن؟
Dialogue: 0,0:08:07.12,0:08:10.41,Default,,0000,0000,0000,,لا أدري، مكان مظلم وضيّق
Dialogue: 0,0:08:10.99,0:08:12.92,Default,,0000,0000,0000,,كيف وصلت هنا؟
Dialogue: 0,0:08:13.57,0:08:14.91,Default,,0000,0000,0000,,...هذا الصوت
Dialogue: 0,0:08:15.28,0:08:16.65,Default,,0000,0000,0000,,!إنّها سيّارة
Dialogue: 0,0:08:16.65,0:08:17.61,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:08:17.61,0:08:21.40,Default,,0000,0000,0000,,صعدت صندوق سيّارة كانت\Nمركونة أمام الحديقة
Dialogue: 0,0:08:21.81,0:08:24.48,Default,,0000,0000,0000,,...ثمّ شعرت بالنعاس
Dialogue: 0,0:08:24.48,0:08:25.70,Default,,0000,0000,0000,,أمام الحديقة؟
Dialogue: 0,0:08:26.60,0:08:27.74,Default,,0000,0000,0000,,!تلك السيّارة؟
Dialogue: 0,0:08:30.14,0:08:33.11,Default,,0000,0000,0000,,!ما هذا؟! مذهل
Dialogue: 0,0:08:33.59,0:08:36.63,Default,,0000,0000,0000,,!إنّه مال! مال! الكثير منه في كيس ورقي
Dialogue: 0,0:08:36.63,0:08:38.58,Default,,0000,0000,0000,,!قرابة مليون ينّ ضرب مئة
Dialogue: 0,0:08:38.80,0:08:40.30,Default,,0000,0000,0000,,!مئة مليون؟
Dialogue: 0,0:08:40.30,0:08:41.75,Default,,0000,0000,0000,,!مذهل
Dialogue: 0,0:08:41.75,0:08:44.03,Default,,0000,0000,0000,,لا بدّ أنّها سيارة رجل ثري
Dialogue: 0,0:08:44.50,0:08:47.74,Default,,0000,0000,0000,,لمَ قد يكون هناك مبلغ كهذا في كيس ورقي؟
Dialogue: 0,0:08:48.08,0:08:49.83,Default,,0000,0000,0000,,أيوجد شيء آخر؟
Dialogue: 0,0:08:49.83,0:08:51.78,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:08:52.61,0:08:55.20,Default,,0000,0000,0000,,يوجد، يبدو كأنّه كيس بلاستيكي
Dialogue: 0,0:08:55.53,0:08:57.16,Default,,0000,0000,0000,,!أهو مملوء بأنقليس مشوي؟
Dialogue: 0,0:08:57.16,0:08:59.32,Default,,0000,0000,0000,,هذا... إنّه منشار
Dialogue: 0,0:08:59.32,0:09:00.25,Default,,0000,0000,0000,,منشار؟
Dialogue: 0,0:09:00.66,0:09:03.45,Default,,0000,0000,0000,,لكن ما هذا الشيء؟ إنّه زلق
Dialogue: 0,0:09:05.48,0:09:08.54,Default,,0000,0000,0000,,أسمعت صوت طفلة من الخلف؟
Dialogue: 0,0:09:08.90,0:09:11.74,Default,,0000,0000,0000,,أوقف هذا، من المحال أن يتكلم ذاك الشيء
Dialogue: 0,0:09:12.89,0:09:13.95,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:09:14.51,0:09:16.49,Default,,0000,0000,0000,,هل المنشار وحده داخل الكيس؟
Dialogue: 0,0:09:17.18,0:09:20.33,Default,,0000,0000,0000,,...يوجد شيء آخر ملفوف بورق
Dialogue: 0,0:09:21.83,0:09:23.88,Default,,0000,0000,0000,,...دعوني أرى ما بداخله
Dialogue: 0,0:09:23.88,0:09:25.99,Default,,0000,0000,0000,,!توقفي! لا تفتحيه يا أيومي-تشان
Dialogue: 0,0:09:32.45,0:09:35.53,Default,,0000,0000,0000,,!رأس! إنّه رأس فتاة
Dialogue: 0,0:09:35.53,0:09:37.74,Default,,0000,0000,0000,,!رأس فتاة؟
Dialogue: 0,0:09:38.37,0:09:41.45,Default,,0000,0000,0000,,...أيمكن أنّ السيارة التي صعدتها أيومي
Dialogue: 0,0:09:41.77,0:09:44.62,Default,,0000,0000,0000,,!هي لمجرمي اختطاف الفتيات وقتلهن؟
Dialogue: 0,0:09:46.86,0:09:48.86,Default,,0000,0000,0000,,!هناك شيءٌ غريب
Dialogue: 0,0:09:48.86,0:09:50.61,Default,,0000,0000,0000,,!أجل! سمعتها أيضاً
Dialogue: 0,0:09:51.14,0:09:53.18,Default,,0000,0000,0000,,دعني أتفقد الصندوق
Dialogue: 0,0:09:57.47,0:09:58.68,Default,,0000,0000,0000,,!افتح القفل
Dialogue: 0,0:09:58.68,0:09:59.54,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:10:05.79,0:10:09.04,Default,,0000,0000,0000,,هكذا إذاً، ذاك ما سمعناه
Dialogue: 0,0:10:09.46,0:10:11.83,Default,,0000,0000,0000,,أفزعني حقاً
Dialogue: 0,0:10:17.95,0:10:19.08,Default,,0000,0000,0000,,!لا تبكي
Dialogue: 0,0:10:19.33,0:10:22.78,Default,,0000,0000,0000,,!لا تبكي يا أيومي-تشان! سيسمعونك إن فعلتِ
Dialogue: 0,0:10:23.23,0:10:26.15,Default,,0000,0000,0000,,!وجدتها! فكّري بشيءٍ مُسلٍّ
Dialogue: 0,0:10:26.15,0:10:27.99,Default,,0000,0000,0000,,شيء مُسلٍّ؟
Dialogue: 0,0:10:33.64,0:10:34.66,Default,,0000,0000,0000,,أيومي-تشان؟
Dialogue: 0,0:10:34.66,0:10:38.10,Default,,0000,0000,0000,,تذكرتُ كيف بدا غينتا-كن كدبّ
Dialogue: 0,0:10:38.10,0:10:41.36,Default,,0000,0000,0000,,عندما سقط من الأدراج ذاك اليوم\N!وأصبح برأسه نتوئين
Dialogue: 0,0:10:41.36,0:10:47.33,On Top,,0000,0000,0000,,الفتيات لسن منطقيات حتّى في أوقات كهذه
Dialogue: 0,0:10:45.00,0:10:47.33,Default,,0000,0000,0000,,يمكنك التوقف الآن يا أيومي-تشان
Dialogue: 0,0:10:48.30,0:10:50.06,Default,,0000,0000,0000,,!ابقي هادئة ولا تتحركي
Dialogue: 0,0:10:51.62,0:10:52.36,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:52.99,0:10:54.91,Default,,0000,0000,0000,,!سآتي لإنقاذك سريعاً
Dialogue: 0,0:10:56.49,0:10:57.45,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:11:00.57,0:11:02.90,Default,,0000,0000,0000,,لكن كيف ستلحق بهم؟
Dialogue: 0,0:11:02.90,0:11:05.99,Default,,0000,0000,0000,,!إنّهم في سيارة، لن تستطيع بلوح تزلج
Dialogue: 0,0:11:06.61,0:11:09.66,Default,,0000,0000,0000,,!صنعه لي البروفسور، ليس لوح تزلج عاديّ
Dialogue: 0,0:11:14.35,0:11:17.06,Default,,0000,0000,0000,,!إنّه مزود بمحرك نفّاث الأداء
Dialogue: 0,0:11:17.06,0:11:21.61,Default,,0000,0000,0000,,لكنّه يعمل بالطاقة الشمسية، لذا لا يمكنك\Nاستعماله سوى تحت ضوء الشمس
Dialogue: 0,0:11:22.55,0:11:24.52,Default,,0000,0000,0000,,ساعة حتى الغروب
Dialogue: 0,0:11:26.01,0:11:29.21,Default,,0000,0000,0000,,!أأنتما أحمقان؟! انتظرا هنا
Dialogue: 0,0:11:29.21,0:11:31.03,Default,,0000,0000,0000,,!تلك سيّارة قتلة
Dialogue: 0,0:11:31.20,0:11:33.08,Default,,0000,0000,0000,,!تبّاً للقتلة
Dialogue: 0,0:11:33.08,0:11:35.95,Default,,0000,0000,0000,,!لا يمكنني البقاء ساكناً وأيومي-تشان في خطر
Dialogue: 0,0:11:35.95,0:11:38.45,Default,,0000,0000,0000,,!واجب الرجل حماية الفتاة
Dialogue: 0,0:11:38.83,0:11:40.26,Default,,0000,0000,0000,,...أنتما
Dialogue: 0,0:11:41.53,0:11:42.70,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:11:43.53,0:11:45.57,Default,,0000,0000,0000,,أيومي-تشان! أين السيارة الآن؟
Dialogue: 0,0:11:45.78,0:11:47.74,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:11:47.74,0:11:51.64,Default,,0000,0000,0000,,هذه السيّارة غريبة، تتوقف وتتحرك باستمرار
Dialogue: 0,0:11:51.64,0:11:54.28,Default,,0000,0000,0000,,كما أسمع أصوات غريبة في الخارج
Dialogue: 0,0:11:54.56,0:11:57.43,Default,,0000,0000,0000,,!ارفعي صوت شارتك
Dialogue: 0,0:11:57.43,0:11:57.95,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:11:59.48,0:12:01.05,Default,,0000,0000,0000,,...هذا الصوت
Dialogue: 0,0:12:01.05,0:12:05.09,Default,,0000,0000,0000,,فهمت! إنّهم عالقون في زحام مروري\Nبسبب أعمال إنشاء على الطريق
Dialogue: 0,0:12:05.09,0:12:07.26,Default,,0000,0000,0000,,المكان الوحيد بأعمال إنشاء في هذه المنطقة
Dialogue: 0,0:12:07.26,0:12:09.05,Default,,0000,0000,0000,,!هو التقاطع على الشارع الثاني
Dialogue: 0,0:12:09.05,0:12:10.25,Default,,0000,0000,0000,,!لا يزال بإمكاننا اللحاق بهم
Dialogue: 0,0:12:10.50,0:12:12.42,Default,,0000,0000,0000,,!سننطلق! تشبّثا جيداً
Dialogue: 0,0:12:12.42,0:12:12.99,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:12:19.79,0:12:21.03,Default,,0000,0000,0000,,!أيومي
Dialogue: 0,0:12:21.03,0:12:23.59,Default,,0000,0000,0000,,لكن ليس هناك داعٍ لقتلها
Dialogue: 0,0:12:24.74,0:12:29.65,Default,,0000,0000,0000,,دفع والداها الفدية، كما أنّها مجرد طفلة
Dialogue: 0,0:12:29.65,0:12:32.78,Default,,0000,0000,0000,,!أحمق! رأت وجهينا
Dialogue: 0,0:12:32.78,0:12:36.12,Default,,0000,0000,0000,,!لا يمكننا تركها حيّة! حتى لو كانت طفلة
Dialogue: 0,0:12:36.12,0:12:37.94,Default,,0000,0000,0000,,!الوغدان
Dialogue: 0,0:12:37.94,0:12:40.65,Default,,0000,0000,0000,,!انتظري يا أيومي! سنأتيك فوراً
Dialogue: 0,0:12:50.13,0:12:51.65,Default,,0000,0000,0000,,أين سيّارتهم؟
Dialogue: 0,0:12:52.00,0:12:54.78,Default,,0000,0000,0000,,أيومي! هل لا تزال السيارة تتوقف وتتحرك؟
Dialogue: 0,0:12:55.12,0:12:58.12,Default,,0000,0000,0000,,أجل، لكنه ليس المكان السابق نفسه
Dialogue: 0,0:12:58.12,0:13:00.49,Default,,0000,0000,0000,,لم أعد أسمع الأصوات الغريبة
Dialogue: 0,0:13:00.49,0:13:03.57,Default,,0000,0000,0000,,كما أنّ السيارة قطعت خطّاً طويلاً للتو
Dialogue: 0,0:13:03.57,0:13:07.36,Default,,0000,0000,0000,,...لحظة، إن كانوا في زحام مروري أمامنا
Dialogue: 0,0:13:07.36,0:13:09.95,Default,,0000,0000,0000,,!وجدته! الطريق السريع
Dialogue: 0,0:13:10.24,0:13:13.60,Default,,0000,0000,0000,,هذا سيّئ! لن نستطيع اللحاق بهم\Nإن دخلوا الطريق السريع
Dialogue: 0,0:13:13.60,0:13:15.03,Default,,0000,0000,0000,,!تبّاً! ماذا أفعل؟
Dialogue: 0,0:13:16.98,0:13:19.31,Default,,0000,0000,0000,,مرّت الكثير من سيارات الشرطة
Dialogue: 0,0:13:19.31,0:13:22.32,Default,,0000,0000,0000,,أجل، هذه الرابعة
Dialogue: 0,0:13:24.22,0:13:25.17,Default,,0000,0000,0000,,المفتّش ميغوري؟
Dialogue: 0,0:13:27.47,0:13:29.64,Default,,0000,0000,0000,,أهناك أمرٌ يجري؟
Dialogue: 0,0:13:29.64,0:13:32.79,Default,,0000,0000,0000,,يبدو أنّ المختطفين فرّوا لمدينة بيكا
Dialogue: 0,0:13:32.79,0:13:34.29,Default,,0000,0000,0000,,شكّلت الشرطة حاجزاً
Dialogue: 0,0:13:34.29,0:13:36.75,Default,,0000,0000,0000,,ويبذلون قصارى جهدهم لاعتقالهم
Dialogue: 0,0:13:36.75,0:13:39.37,Default,,0000,0000,0000,,!أيومي-تشان! ألم تسمعي صوت سيارات شرطة؟
Dialogue: 0,0:13:39.63,0:13:43.15,Default,,0000,0000,0000,,!سمعت! مرّت 3 منها عندما كنا متوقفين
Dialogue: 0,0:13:43.78,0:13:47.37,Default,,0000,0000,0000,,!لا شكّ إذاً! وضعوا نقطة تفتيش
Dialogue: 0,0:13:47.74,0:13:51.94,Default,,0000,0000,0000,,...عند التقاء الطرق قبل الخطّ السريع غالباً
Dialogue: 0,0:13:51.94,0:13:52.82,Default,,0000,0000,0000,,!على جسر بيكا
Dialogue: 0,0:13:53.52,0:13:55.66,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:13:55.66,0:13:58.99,Default,,0000,0000,0000,,!جسر بيكا من الشارع السابق مباشرةً
Dialogue: 0,0:13:59.31,0:14:02.28,Default,,0000,0000,0000,,!أحمق! لن يمروا بنقطة التفتيش
Dialogue: 0,0:14:03.51,0:14:05.85,Default,,0000,0000,0000,,سلكوا طريقاً جانبياً للخروج من بيكا
Dialogue: 0,0:14:05.85,0:14:07.62,Default,,0000,0000,0000,,!دون قطع الجسر بالتأكيد
Dialogue: 0,0:14:13.29,0:14:16.17,Default,,0000,0000,0000,,سيمرون بهذا الشارع حتماً
Dialogue: 0,0:14:16.17,0:14:18.28,Default,,0000,0000,0000,,!نحن نتحرك! السيارة تتحرك
Dialogue: 0,0:14:18.79,0:14:21.78,Default,,0000,0000,0000,,!حسنٌ، تعالوا! سنمسك بكم
Dialogue: 0,0:14:24.11,0:14:27.53,Default,,0000,0000,0000,,لم يأتوا بعد، مرّت 5 دقائق
Dialogue: 0,0:14:27.53,0:14:29.87,Default,,0000,0000,0000,,!ما الذي يحدث يا كونان؟
Dialogue: 0,0:14:29.87,0:14:31.36,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:14:31.36,0:14:34.66,Default,,0000,0000,0000,,أيومي-تشان، هل السيارة متوقفة الآن أم تتحرك؟
Dialogue: 0,0:14:36.70,0:14:38.44,Default,,0000,0000,0000,,!ما الخطب يا أيومي-تشان؟
Dialogue: 0,0:14:38.44,0:14:39.74,Default,,0000,0000,0000,,!أجيبي يا أيومي
Dialogue: 0,0:14:40.32,0:14:43.22,Default,,0000,0000,0000,,!هل خرجت عن النطاق؟
Dialogue: 0,0:14:43.22,0:14:46.60,Default,,0000,0000,0000,,كلا، لهذه الأدوات مدى إرسال بعشرين كيلومتراً
Dialogue: 0,0:14:46.60,0:14:48.58,Default,,0000,0000,0000,,!من المحال أن يقطعوا ذاك القدر في 5 دقائق
Dialogue: 0,0:14:48.93,0:14:51.34,Default,,0000,0000,0000,,ربما دخلوا نفقاً؟
Dialogue: 0,0:14:51.34,0:14:53.66,Default,,0000,0000,0000,,!نفق بيكا! ذلك هو حتماً
Dialogue: 0,0:14:53.96,0:14:56.67,Default,,0000,0000,0000,,كلا، عليهم المرور بنقطة التفتيش وعبور الجسر
Dialogue: 0,0:14:56.67,0:14:58.80,Default,,0000,0000,0000,,!لدخول نفق بيكا
Dialogue: 0,0:14:58.80,0:15:01.86,Default,,0000,0000,0000,,مما يعني أنّهم داخل بناء يعيق الإشارة
Dialogue: 0,0:15:01.86,0:15:04.70,Default,,0000,0000,0000,,أتقصد أنّهم في مخبئهم وما شابه؟
Dialogue: 0,0:15:04.70,0:15:06.79,Default,,0000,0000,0000,,!إنّهم محاصرون في تلك الحالة
Dialogue: 0,0:15:06.79,0:15:08.41,Default,,0000,0000,0000,,!ستجدهم الشرطة بنهاية المطاف
Dialogue: 0,0:15:08.41,0:15:09.79,Default,,0000,0000,0000,,!أحمق
Dialogue: 0,0:15:09.79,0:15:12.61,Default,,0000,0000,0000,,!سيجدون أيومي-تشان قبل أن يُقبض عليهم
Dialogue: 0,0:15:12.98,0:15:16.61,Default,,0000,0000,0000,,!رأت وجهينا! !لا يمكننا تركها حيّة
Dialogue: 0,0:15:16.61,0:15:19.11,Default,,0000,0000,0000,,!حتّى لو كانت طفلة
Dialogue: 0,0:15:19.11,0:15:20.23,Default,,0000,0000,0000,,إن حصل مكروه
Dialogue: 0,0:15:20.23,0:15:22.61,Default,,0000,0000,0000,,فستكون موجوداً لحمايتي، صحيح يا كونان-كن؟
Dialogue: 0,0:15:23.52,0:15:25.22,Default,,0000,0000,0000,,!أيومي
Dialogue: 0,0:15:25.22,0:15:27.08,Default,,0000,0000,0000,,نان-كن...
Dialogue: 0,0:15:28.16,0:15:30.28,Default,,0000,0000,0000,,!كونان-كن! أين أنت؟
Dialogue: 0,0:15:30.28,0:15:31.78,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:15:32.09,0:15:35.76,Default,,0000,0000,0000,,!لمَ لم تجب يا أحمق؟
Dialogue: 0,0:15:35.76,0:15:37.01,Default,,0000,0000,0000,,!اهدئي يا أيومي-تشان
Dialogue: 0,0:15:37.01,0:15:39.49,Default,,0000,0000,0000,,!سيسمعانك إن صرختِ
Dialogue: 0,0:15:39.49,0:15:41.29,Default,,0000,0000,0000,,!من المستحيل أن يسمعاني
Dialogue: 0,0:15:41.29,0:15:45.20,Default,,0000,0000,0000,,صوت السيّارة مرتفع جداً بحيث\Nلا أستطيع سماع صوتهما
Dialogue: 0,0:15:45.20,0:15:46.28,Default,,0000,0000,0000,,!أتعرفين أين أنتم الآن؟
Dialogue: 0,0:15:46.28,0:15:52.03,Default,,0000,0000,0000,,!كلا، كان هناك صوت هادر ثمّ توقفت عن الإجابة عليّ
Dialogue: 0,0:15:52.49,0:15:55.07,Default,,0000,0000,0000,,!صوت هادر؟ أيمكن أنّه صوت نفق؟
Dialogue: 0,0:15:55.07,0:15:58.28,Default,,0000,0000,0000,,!هل تجاوزا نقطة التفتيش؟ كيف؟
Dialogue: 0,0:15:58.28,0:16:00.27,Default,,0000,0000,0000,,!سنلحق بك سريعاً
Dialogue: 0,0:16:00.27,0:16:01.44,Default,,0000,0000,0000,,!ابقي هادئة وانتظرينا
Dialogue: 0,0:16:16.28,0:16:17.99,Default,,0000,0000,0000,,!بسرعة! بسرعة
Dialogue: 0,0:16:18.47,0:16:20.49,Default,,0000,0000,0000,,!سيتوقف اللوح قريباً إلم نسرع
Dialogue: 0,0:16:23.16,0:16:27.16,Default,,0000,0000,0000,,!كونان-كن! يبدو أنّ السيارة دخلت محلّاً الآن
Dialogue: 0,0:16:27.16,0:16:27.99,Default,,0000,0000,0000,,محلّ؟
Dialogue: 0,0:16:28.46,0:16:31.99,Default,,0000,0000,0000,,سمعت أحدهم يقول "مرحباً"، كما أنّ\Nصوتاً غريباً قد بدأ
Dialogue: 0,0:16:31.99,0:16:33.45,Default,,0000,0000,0000,,صوت؟
Dialogue: 0,0:16:35.28,0:16:37.66,Default,,0000,0000,0000,,!محطّة وقود! أيّ واحدة؟
Dialogue: 0,0:16:37.90,0:16:39.95,Default,,0000,0000,0000,,!أيومي-تشان! دعيني أسمع ما يجري في الخارج
Dialogue: 0,0:16:39.95,0:16:40.74,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:16:42.48,0:16:46.23,Default,,0000,0000,0000,,نوزع الآن مناشف وقمصان يايبا المقنع
Dialogue: 0,0:16:46.23,0:16:48.56,Default,,0000,0000,0000,,!لا نحتاجها! نحن في عجلة
Dialogue: 0,0:16:48.56,0:16:50.74,Default,,0000,0000,0000,,محطّة الوقود الوحيدة التي توفر بضائع يايبا المقنع
Dialogue: 0,0:16:50.74,0:16:52.40,Default,,0000,0000,0000,,!هي محطّة يوتسوبيشي التي تجاوزناها للتو
Dialogue: 0,0:17:05.29,0:17:07.29,Default,,0000,0000,0000,,!وجدتكم أخيراً
Dialogue: 0,0:17:14.45,0:17:16.62,Default,,0000,0000,0000,,!ما كان ذاك الصوت يا كونان-كن؟
Dialogue: 0,0:17:17.20,0:17:20.27,Default,,0000,0000,0000,,!أيومي-تشان داخل صندوق تلك السيارة بالفعل
Dialogue: 0,0:17:20.27,0:17:22.03,Default,,0000,0000,0000,,!كما رأس الفتاة والمال
Dialogue: 0,0:17:22.60,0:17:25.99,Default,,0000,0000,0000,,!إنّهما مرتكبا جرائم اختطاف وقتل الفتيات الصغيرات
Dialogue: 0,0:17:25.99,0:17:29.41,Default,,0000,0000,0000,,ألم تسمع صوتاً غريباً؟
Dialogue: 0,0:17:29.65,0:17:31.86,Default,,0000,0000,0000,,!إنّهم أطفال، عبث أطفال فقط
Dialogue: 0,0:17:35.76,0:17:38.22,Default,,0000,0000,0000,,ما الذي يجري؟
Dialogue: 0,0:17:40.96,0:17:42.11,Default,,0000,0000,0000,,!ماذا هناك يا أيومي-تشان؟
Dialogue: 0,0:17:46.63,0:17:49.41,Default,,0000,0000,0000,,!أيومي-تشان! أجيبي! أيومي-تشان
Dialogue: 0,0:17:49.96,0:17:52.28,Default,,0000,0000,0000,,!هناك أمرٌ غريب حتماً
Dialogue: 0,0:17:52.28,0:17:54.82,Default,,0000,0000,0000,,قطّة ضالة لا أكثر غالباً، لا داعي للقلق
Dialogue: 0,0:17:56.28,0:17:58.45,Default,,0000,0000,0000,,!أوغاد! لن تهربوا الآن
Dialogue: 0,0:18:01.36,0:18:02.32,Default,,0000,0000,0000,,!لـ-لحظة
Dialogue: 0,0:18:02.69,0:18:04.12,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:18:04.12,0:18:05.69,Default,,0000,0000,0000,,!إنهم يبتعدون
Dialogue: 0,0:18:05.69,0:18:08.81,Default,,0000,0000,0000,,!كلا! لا طاقة شمسية كافية
Dialogue: 0,0:18:08.81,0:18:12.11,Default,,0000,0000,0000,,!علينا فعل شيء قبل أن نتوقف
Dialogue: 0,0:18:12.60,0:18:13.57,Default,,0000,0000,0000,,!ذاك
Dialogue: 0,0:18:17.37,0:18:19.54,Default,,0000,0000,0000,,!أنتم! توقفوا يا أطفال
Dialogue: 0,0:18:26.04,0:18:29.88,Default,,0000,0000,0000,,!أوقف السيّارة! وإلّا سأفعل هذا
Dialogue: 0,0:18:33.12,0:18:34.28,Default,,0000,0000,0000,,!الصبيّ اللعين
Dialogue: 0,0:18:37.28,0:18:38.93,Default,,0000,0000,0000,,!من كان أولئك الصغار؟
Dialogue: 0,0:18:38.93,0:18:39.58,Default,,0000,0000,0000,,!لا أعرف
Dialogue: 0,0:18:39.58,0:18:41.95,Default,,0000,0000,0000,,!لنسرع بأيّ حال! لا وقت لدينا
Dialogue: 0,0:19:00.96,0:19:03.20,Default,,0000,0000,0000,,...تبّاً، يداي تتخدران
Dialogue: 0,0:19:03.80,0:19:06.53,Default,,0000,0000,0000,,...لا يمكنني الصمود
Dialogue: 0,0:19:07.81,0:19:08.30,Default,,0000,0000,0000,,غينتا
Dialogue: 0,0:19:08.30,0:19:10.95,Default,,0000,0000,0000,,!أيومي! أيومي! أيومي
Dialogue: 0,0:19:18.62,0:19:20.40,Default,,0000,0000,0000,,!إنّهم أولئك الأطفال
Dialogue: 0,0:19:20.40,0:19:22.94,Default,,0000,0000,0000,,!لا تهتم لهم! لنخرجها فقط وننفصل
Dialogue: 0,0:19:22.94,0:19:23.66,Default,,0000,0000,0000,,!أ-أجل
Dialogue: 0,0:19:26.78,0:19:28.28,Default,,0000,0000,0000,,!من أنت؟
Dialogue: 0,0:19:30.43,0:19:32.97,Default,,0000,0000,0000,,!من هذه الطفلة؟
Dialogue: 0,0:19:32.32,0:19:34.82,On Top,,0000,0000,0000,,!لا تقتلني! كلا
Dialogue: 0,0:19:34.00,0:19:34.82,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:19:35.64,0:19:36.24,Default,,0000,0000,0000,,!أيومي
Dialogue: 0,0:19:36.81,0:19:38.16,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:19:38.84,0:19:40.15,Default,,0000,0000,0000,,!ا-اصمتي
Dialogue: 0,0:19:40.37,0:19:41.86,Default,,0000,0000,0000,,!اهربي يا أيومي
Dialogue: 0,0:19:42.30,0:19:43.49,Default,,0000,0000,0000,,!خُذ
Dialogue: 0,0:19:53.38,0:19:54.78,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:19:56.45,0:19:57.66,Default,,0000,0000,0000,,!رفاق
Dialogue: 0,0:19:58.30,0:19:59.34,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:19:59.34,0:20:00.90,Default,,0000,0000,0000,,!حمداً لله لكونك بخير
Dialogue: 0,0:20:00.90,0:20:02.84,Default,,0000,0000,0000,,!جعلتنا نقلق
Dialogue: 0,0:20:04.44,0:20:06.03,Default,,0000,0000,0000,,انتهى أمركم
Dialogue: 0,0:20:06.03,0:20:08.12,Default,,0000,0000,0000,,!يا مختطفا وقاتلا الفتيات
Dialogue: 0,0:20:08.12,0:20:09.91,Default,,0000,0000,0000,,!قاتلا؟
Dialogue: 0,0:20:10.31,0:20:12.06,Default,,0000,0000,0000,,!لا فائدة من التحامق
Dialogue: 0,0:20:12.06,0:20:15.27,Default,,0000,0000,0000,,!سمعنا محادثتكم في السيّارة
Dialogue: 0,0:20:15.27,0:20:18.74,Default,,0000,0000,0000,,!صحيح! قلت أنّ لا مشكلة لديك في قتل الأطفال
Dialogue: 0,0:20:19.14,0:20:21.42,Default,,0000,0000,0000,,كما هناك الجثّة والمال في صندوق سيارتكما
Dialogue: 0,0:20:21.42,0:20:22.99,Default,,0000,0000,0000,,لا مهرب لكما
Dialogue: 0,0:20:23.33,0:20:25.73,Default,,0000,0000,0000,,!حـ-حمقى
Dialogue: 0,0:20:26.91,0:20:27.70,Default,,0000,0000,0000,,!أمعنوا النظر
Dialogue: 0,0:20:29.39,0:20:31.96,Default,,0000,0000,0000,,!كلّها معدات مصنوعة
Dialogue: 0,0:20:31.96,0:20:33.70,Default,,0000,0000,0000,,معدات؟
Dialogue: 0,0:20:34.15,0:20:36.91,Default,,0000,0000,0000,,محادثتنا في السيارة كانت تدريباً\N!على حوارنا للمرّة الأخيرة
Dialogue: 0,0:20:37.25,0:20:39.12,Default,,0000,0000,0000,,تدريباً على حواركم؟
Dialogue: 0,0:20:39.56,0:20:44.07,Default,,0000,0000,0000,,!نحن نؤدي مسرحيةً هنا
Dialogue: 0,0:20:45.45,0:20:46.45,Default,,0000,0000,0000,,...تذكرت
Dialogue: 0,0:20:46.86,0:20:48.82,Default,,0000,0000,0000,,لنذهب لمهرجان جامعة تيتان يا كونان-كن
Dialogue: 0,0:20:48.82,0:20:53.20,Default,,0000,0000,0000,,!سمعت أنّهم سيؤدون مسرحية تحرٍّ مثيرة
Dialogue: 0,0:20:53.89,0:20:58.87,Default,,0000,0000,0000,,!كما قالوا على الراديو أنّهم أمسكوا بالمجرمين
Dialogue: 0,0:21:02.80,0:21:04.11,Default,,0000,0000,0000,,مفتّش ميغوري؟
Dialogue: 0,0:21:04.47,0:21:09.43,Default,,0000,0000,0000,,...كان ذاك القاتل الحقيقي إذاً
Dialogue: 0,0:21:09.43,0:21:12.33,Default,,0000,0000,0000,,!انظروا لما فعلتم
Dialogue: 0,0:21:12.33,0:21:16.79,Default,,0000,0000,0000,,...به نتوء كبير وعنقه مكسور
Dialogue: 0,0:21:16.79,0:21:17.92,Default,,0000,0000,0000,,...سنغادر إذاً
Dialogue: 0,0:21:17.92,0:21:18.99,Default,,0000,0000,0000,,!توقفوا
Dialogue: 0,0:21:19.25,0:21:21.19,Default,,0000,0000,0000,,أ-أجل؟
Dialogue: 0,0:21:21.19,0:21:25.16,Default,,0000,0000,0000,,!ستتحملون المسؤولية
Dialogue: 0,0:23:00.04,0:23:04.85,Italics,,0000,0000,15,,{\fad(0,100)}لن نعيش لنرى الغد
Dialogue: 0,0:23:00.42,0:23:06.18,Default,,0000,0000,0000,,دفع والداها... الـ-الفدية
Dialogue: 0,0:23:06.18,0:23:08.38,Default,,0000,0000,0000,,كما أنّها مجرد طفلة
Dialogue: 0,0:23:08.38,0:23:10.88,Default,,0000,0000,0000,,!أحمق! رأت وجهينا
Dialogue: 0,0:23:10.88,0:23:11.86,Default,,0000,0000,0000,,!لا يمكننا تركها حيّة
Dialogue: 0,0:23:12.25,0:23:14.46,Default,,0000,0000,0000,,هناك خطبٌ ما بذاك الممثل
Dialogue: 0,0:23:14.46,0:23:15.84,Default,,0000,0000,0000,,تظنين ذلك؟
Dialogue: 0,0:23:15.84,0:23:19.80,Default,,0000,0000,0000,,لا يمكنه الوقوف منتظماً، ويخفق في ترديد كلمات حواره
Dialogue: 0,0:23:20.94,0:23:24.70,Default,,0000,0000,0000,,!يا لك من فتاة جميلة! ما رأيك بدعوة شاي؟
Dialogue: 0,0:23:24.70,0:23:26.53,Default,,0000,0000,0000,,...كـ-كلا، شكراً
Dialogue: 0,0:23:26.96,0:23:31.28,Default,,0000,0000,0000,,لا تقولي هذا! ألا تريدين رؤية مهارات\N...التحرّي الشهيرة لي
Dialogue: 0,0:23:33.44,0:23:35.49,Default,,0000,0000,0000,,!يكفي
Dialogue: 0,0:23:37.82,0:23:39.58,Default,,0000,0000,0000,,!غينتا! قُل الجملة التالية
Dialogue: 0,0:23:40.02,0:23:43.06,On Top,,0000,0000,0000,,لا أعرف كيف أقرأ هذه الكلمة
Dialogue: 0,0:23:40.63,0:23:43.06,Default,,0000,0000,0000,,صحيح، لعبنا دور شخصية رئيسية
Dialogue: 0,0:23:43.06,0:23:45.03,On Top,,0000,0000,0000,,"تُنطق "قاسٍ
Dialogue: 0,0:23:43.06,0:23:45.03,Default,,0000,0000,0000,,على المسرح
Dialogue: 0,0:23:45.97,0:23:49.62,On Top,,0000,0000,0000,,!هذا قاسٍ
Dialogue: 0,0:23:45.97,0:23:49.62,Default,,0000,0000,0000,,...كما أنّ دور الرأس المقطوع
Dialogue: 0,0:23:50.09,0:23:52.63,Default,,0000,0000,0000,,كان لأيومي-تشان نفسها
Dialogue: 0,0:23:52.63,0:23:55.29,Default,,0000,0000,0000,,!أكره الغميضة
Dialogue: 0,0:24:04.08,0:24:04.61,Default,,0000,0000,0000,,إنّه ميت؟
Dialogue: 0,0:24:05.08,0:24:09.82,Default,,0000,0000,0000,,!بعدما وجدت أباها أخيراً... يا للفظاعة
Dialogue: 0,0:24:10.28,0:24:12.94,Default,,0000,0000,0000,,لا يمكننا الجزم بأنه قُتل بعد
Dialogue: 0,0:24:12.94,0:24:13.78,Default,,0000,0000,0000,,!لا يصحّ الاستسلام
Dialogue: 0,0:24:14.25,0:24:16.03,Default,,0000,0000,0000,,!بسرعة! لأصل في الوقت
Dialogue: 0,0:24:20.93,0:24:23.95,Default,,0000,0000,0000,,!أين ماسامي-سان؟ ماذا حلّ بها؟
Dialogue: 0,0:24:24.35,0:24:25.81,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.81,0:24:28.60,Default,,0000,0000,0000,,جريمة قتل تقصّي رجل الغريبة
Dialogue: 0,0:24:45.91,0:24:48.87,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.87,0:24:50.05,Default,,0000,0000,0000,,مئة مليون ين
Dialogue: 0,0:24:50.05,0:24:52.05,Default,,0000,0000,0000,,!لغز الحلقة القادمة كبير

