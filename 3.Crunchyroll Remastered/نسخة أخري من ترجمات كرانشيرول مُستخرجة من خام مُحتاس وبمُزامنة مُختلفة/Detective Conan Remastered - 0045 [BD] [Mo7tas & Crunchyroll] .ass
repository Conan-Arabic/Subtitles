Dialogue: 0,0:00:01.47,0:00:04.19,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.79,0:00:08.20,Default,,0000,0000,0000,,قضيّة اليوم عن قناع وجه! أيمكن لمساحيق التجميل إخفاء الدليل؟
Dialogue: 0,0:00:08.79,0:00:10.70,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.70,0:00:12.95,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:12.95,0:00:15.40,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.73,0:01:51.87,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل قناع الوجه
Dialogue: 0,0:01:47.03,0:01:49.59,Default,,0000,0000,0000,,جريمة قتل قناع الوجه
Dialogue: 0,0:01:58.68,0:02:00.22,Default,,0000,0000,0000,,!كوجيما-سان! نحن أمن بيكا
Dialogue: 0,0:02:00.22,0:02:02.93,Default,,0000,0000,0000,,!أهناك خطبٌ ما، كوجيما-سان؟
Dialogue: 0,0:02:02.93,0:02:03.55,Default,,0000,0000,0000,,!هيّا بنا
Dialogue: 0,0:02:03.55,0:02:04.51,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:11.68,0:02:13.91,Default,,0000,0000,0000,,!كوجيما-سان! سنفتح الباب
Dialogue: 0,0:02:13.91,0:02:14.71,Default,,0000,0000,0000,,افتحه
Dialogue: 0,0:02:14.71,0:02:15.39,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:17.25,0:02:18.14,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:02:21.04,0:02:23.47,Default,,0000,0000,0000,,آسفة، هل أخفتكما؟
Dialogue: 0,0:02:23.94,0:02:24.94,Default,,0000,0000,0000,,...كلا
Dialogue: 0,0:02:24.94,0:02:27.99,Default,,0000,0000,0000,,كنتُ أضع قناع الوجه فلم أستطع الإجابة فوراً
Dialogue: 0,0:02:27.99,0:02:31.31,Default,,0000,0000,0000,,فُعّل جهاز إنذارك الأمني، أحصل أمرٌ ما؟
Dialogue: 0,0:02:31.82,0:02:33.76,Default,,0000,0000,0000,,كلا، لا شيء أبداً
Dialogue: 0,0:02:34.18,0:02:35.52,Default,,0000,0000,0000,,لعلّه كان خللاً
Dialogue: 0,0:02:36.77,0:02:38.35,Default,,0000,0000,0000,,تشيبا-سان
Dialogue: 0,0:02:41.73,0:02:43.30,Default,,0000,0000,0000,,يبدو أنّه الفاعل
Dialogue: 0,0:02:43.30,0:02:46.47,Default,,0000,0000,0000,,لا بدّ أنّه عبر المستشعرات تحت الحمراء
Dialogue: 0,0:02:46.47,0:02:49.76,Default,,0000,0000,0000,,إنّها حسّاسة بحيث تقع\Nأمور كهذه من فترة لفترة
Dialogue: 0,0:02:49.76,0:02:50.81,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:02:50.81,0:02:53.12,Default,,0000,0000,0000,,احرصي على إقفال الباب من فضلك
Dialogue: 0,0:02:53.12,0:02:54.41,Default,,0000,0000,0000,,شكراً لقدومكم
Dialogue: 0,0:03:09.31,0:03:11.45,Default,,0000,0000,0000,,أكلتُ للتخمة
Dialogue: 0,0:03:11.45,0:03:17.97,Default,,0000,0000,0000,,الصين نفسها لا تستطيع منافسة\Nالطبخ الصينيّ لهذا المطعم، صحيح؟
Dialogue: 0,0:03:18.23,0:03:21.43,Default,,0000,0000,0000,,الرامن نفسه أينما ذهبت في الواقع
Dialogue: 0,0:03:21.43,0:03:23.88,Default,,0000,0000,0000,,تأخّر الوقت لهذا الحدّ؟
Dialogue: 0,0:03:24.18,0:03:27.35,Default,,0000,0000,0000,,!لا يصحّ! ستُعرض دراما يوكو-تشان الليلة
Dialogue: 0,0:03:27.35,0:03:29.97,Default,,0000,0000,0000,,!يوكو-تشان! أنا عائد للبيت الآن
Dialogue: 0,0:03:30.22,0:03:31.56,Default,,0000,0000,0000,,!لحظة، أبي
Dialogue: 0,0:03:36.37,0:03:37.60,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:03:38.08,0:03:39.92,Default,,0000,0000,0000,,أ-أأنت بخير؟
Dialogue: 0,0:03:39.92,0:03:41.39,Default,,0000,0000,0000,,!أحمق! احترس
Dialogue: 0,0:03:41.39,0:03:44.22,On Top,,0000,0000,0000,,...آ-آسف، كنت
Dialogue: 0,0:03:41.79,0:03:44.22,CharCard,,0000,0000,0005,,{\fad(300,0)} (25) إيزومي تاكيو\Nموظّف شركة تي إم الأمنية
Dialogue: 0,0:03:44.74,0:03:47.57,Default,,0000,0000,0000,,!انتبه وأنت تقود
Dialogue: 0,0:03:47.57,0:03:50.57,Default,,0000,0000,0000,,أليست غلطتك لعبور الشارع قبل النظر؟
Dialogue: 0,0:03:50.57,0:03:51.14,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:03:51.53,0:03:55.27,Default,,0000,0000,0000,,ما-ما مشكلتكما؟
Dialogue: 0,0:03:55.27,0:03:56.10,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:03:56.56,0:03:59.06,Default,,0000,0000,0000,,أجل، ميغوري-سان؟
Dialogue: 0,0:03:59.44,0:04:02.02,Default,,0000,0000,0000,,!ماذا؟ القسم 1 لتحقيقات الشرطة؟
Dialogue: 0,0:04:02.89,0:04:05.55,Default,,0000,0000,0000,,!مرحباً! أنا موري
Dialogue: 0,0:04:05.55,0:04:09.39,Default,,0000,0000,0000,,لمَ أنا هنا؟ لا يهمّ ذلك
Dialogue: 0,0:04:09.39,0:04:11.27,Default,,0000,0000,0000,,ما القضية التي تعمل عليها؟
Dialogue: 0,0:04:11.80,0:04:14.97,Default,,0000,0000,0000,,ماذا؟ ذو صلة في جريمة قتل؟
Dialogue: 0,0:04:17.08,0:04:19.96,Default,,0000,0000,0000,,!فهمت! يمكنك الاعتماد عليّ
Dialogue: 0,0:04:19.96,0:04:21.23,Default,,0000,0000,0000,,...لحظة، موري
Dialogue: 0,0:04:24.62,0:04:25.97,Default,,0000,0000,0000,,!لن تهرب
Dialogue: 0,0:04:27.74,0:04:29.20,Default,,0000,0000,0000,,!استسلم
Dialogue: 0,0:04:29.20,0:04:35.56,Default,,0000,0000,0000,,قادتك الأقدار ليديّ المتحرّي\N!الأعظم على الأرض، موري كوغورو-ساما
Dialogue: 0,0:04:35.56,0:04:38.90,Default,,0000,0000,0000,,!ا-انتظر! لا أدري ما الذي يجري أبداً
Dialogue: 0,0:04:38.90,0:04:42.63,Default,,0000,0000,0000,,!لا تتظاهر بالجهل! يمكنك قول أعذارك عندما نصل
Dialogue: 0,0:04:43.51,0:04:47.18,Default,,0000,0000,0000,,هل تستدعي الشرطة مشتبهاً به عبر الهاتف؟
Dialogue: 0,0:04:47.18,0:04:49.10,Default,,0000,0000,0000,,...لكن، هذا الشخص
Dialogue: 0,0:04:58.46,0:04:59.96,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:04:59.96,0:05:01.29,Default,,0000,0000,0000,,تعال
Dialogue: 0,0:05:03.49,0:05:05.33,Default,,0000,0000,0000,,شكراً لقدومك
Dialogue: 0,0:05:05.33,0:05:09.10,Default,,0000,0000,0000,,!جلبتُ المشتبه به كما طلبت
Dialogue: 0,0:05:09.10,0:05:11.68,Default,,0000,0000,0000,,ماذا؟ ما الذي تقوله؟
Dialogue: 0,0:05:12.94,0:05:14.82,Default,,0000,0000,0000,,فكّر بالأمر
Dialogue: 0,0:05:14.82,0:05:20.44,Default,,0000,0000,0000,,لو كان إيزومي تاكيو-سان مُشتبهاً به\Nلما اتّصلنا به على الهاتف
Dialogue: 0,0:05:20.44,0:05:22.52,Default,,0000,0000,0000,,...بذكرك للأمر
Dialogue: 0,0:05:22.52,0:05:24.93,Default,,0000,0000,0000,,أجل، كما ظننت
Dialogue: 0,0:05:26.47,0:05:29.22,Default,,0000,0000,0000,,شركة تي إم الأمنية، فرع بيكا
Dialogue: 0,0:05:29.22,0:05:33.63,Default,,0000,0000,0000,,إيزومي تاكيو-سان، أتيت لهذا المنزل الليلة، صحيح؟
Dialogue: 0,0:05:33.63,0:05:35.97,Default,,0000,0000,0000,,كـ-كلا... أقصد أجل
Dialogue: 0,0:05:36.55,0:05:43.33,Default,,0000,0000,0000,,أتيتَ هنا تمام الثامنة\Nوغادرت عند الثامنة والأربعين، صحيح؟
Dialogue: 0,0:05:43.33,0:05:44.64,Default,,0000,0000,0000,,لا أعرف الوقت بالضبط
Dialogue: 0,0:05:44.95,0:05:47.35,Default,,0000,0000,0000,,كيف حددتم الوقت؟
Dialogue: 0,0:05:48.04,0:05:52.06,Default,,0000,0000,0000,,إنّه على شريط كاميرات المراقبة
Dialogue: 0,0:05:52.37,0:05:55.19,Default,,0000,0000,0000,,!ارتكب الجريمة إذاً؟
Dialogue: 0,0:05:55.19,0:05:56.47,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:05:56.98,0:06:03.27,Default,,0000,0000,0000,,،بعد مغادرة إيزومي-سان... أجل\Nأي عند الثامنة والخمسين، أتت الابنة
Dialogue: 0,0:06:03.27,0:06:05.89,Default,,0000,0000,0000,,كانت الضحيّة لا تزال على قيد الحياة
Dialogue: 0,0:06:06.31,0:06:10.81,Default,,0000,0000,0000,,كما أنّ أحد أفراد الأمن\Nرآها عند التاسعة
Dialogue: 0,0:06:10.81,0:06:11.89,Default,,0000,0000,0000,,أفراد الأمن؟
Dialogue: 0,0:06:12.35,0:06:16.80,Default,,0000,0000,0000,,تسلّل قطّ للفناء وأطلق إنذار الأمن
Dialogue: 0,0:06:17.42,0:06:22.26,Default,,0000,0000,0000,,اتّصلتُ بإيزومي-سان لمعرفة المزيد عن الضحيّة
Dialogue: 0,0:06:22.26,0:06:23.13,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:06:25.12,0:06:27.60,Default,,0000,0000,0000,,من الضحيّة بأيّ حال؟
Dialogue: 0,0:06:28.37,0:06:34.11,On Top,,0000,0000,0000,,كوجيما إيكوكو، كانت تدير سلسلة \Nمتاجر إلكترونيات مخفّضة
Dialogue: 0,0:06:31.95,0:06:35.26,CharCard,,0000,0000,0005,,{\fad(300,0)}(كوجيما إيكوكو (50\Nامرأة أعمال
Dialogue: 0,0:06:34.11,0:06:35.26,On Top,,0000,0000,0000,,ماتت خنقاً
Dialogue: 0,0:06:37.93,0:06:42.03,Default,,0000,0000,0000,,لنبدأ مع وجود الجميع هنا
Dialogue: 0,0:06:42.03,0:06:42.88,Default,,0000,0000,0000,,موري-كن
Dialogue: 0,0:06:43.39,0:06:46.35,On Top,,0000,0000,0000,,هذه ابنة الضحيّة، تشيهيرو-سان
Dialogue: 0,0:06:43.82,0:06:46.35,CharCard,,0000,0000,0005,,{\fad(300,0)}(كوجيما تشيهيرو (28\Nابنة الضحيّة الوحيدة
Dialogue: 0,0:06:46.73,0:06:50.39,On Top,,0000,0000,0000,,ومن اكتشف الجثّة، يوشيوكا-سان
Dialogue: 0,0:06:47.08,0:06:50.20,CharCard,,0000,0000,0005,,{\fad(300,0)}(يوشيوكا جورو (48\Nمُكتشف الجثّة
Dialogue: 0,0:06:50.39,0:06:52.51,On Top,,0000,0000,0000,,من هذا الرجل؟
Dialogue: 0,0:06:55.63,0:06:58.26,Default,,0000,0000,0000,,المتحرّي العظيم موري كوغورو
Dialogue: 0,0:06:58.84,0:07:01.72,Default,,0000,0000,0000,,!موري كوغورو؟ ذاك المتحرّي الشهير؟
Dialogue: 0,0:07:02.01,0:07:05.18,Default,,0000,0000,0000,,...حسناً، وفقاً لكاميرات المراقبة
Dialogue: 0,0:07:05.66,0:07:11.45,Default,,0000,0000,0000,,وصل إيزومي-سان عند الثامنة، وغادر عند 8:40
Dialogue: 0,0:07:11.45,0:07:16.86,Default,,0000,0000,0000,,،وصلت تشيهيرو-سان عند 8:50\Nثمّ غادرت عند 9:10
Dialogue: 0,0:07:16.86,0:07:21.15,Default,,0000,0000,0000,,،وأخيراً وصل يوشيوكا-سان عند 9:20 واكتشف الجثّة
Dialogue: 0,0:07:21.15,0:07:23.84,Default,,0000,0000,0000,,واتّصل بالشرطة عند 9:31
Dialogue: 0,0:07:24.31,0:07:26.43,Default,,0000,0000,0000,,أتوقع أنّ لا مشاكل في هذا؟
Dialogue: 0,0:07:26.43,0:07:28.89,Default,,0000,0000,0000,,إن كان على التسجيل فبالطبع
Dialogue: 0,0:07:29.10,0:07:33.34,Default,,0000,0000,0000,,...قُتِلت أمّها للتوّ، لكنّها لا تُبدي
Dialogue: 0,0:07:33.34,0:07:38.18,Default,,0000,0000,0000,,أفترض أنّ أمّك كانت لا تزال\Nعلى قيد الحياة عندما غادرتِ
Dialogue: 0,0:07:38.18,0:07:39.88,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:07:39.88,0:07:43.34,Default,,0000,0000,0000,,أو ماذا؟ تقصد أنّي قتلت أمّي؟
Dialogue: 0,0:07:43.34,0:07:46.46,Default,,0000,0000,0000,,...كلا، لم ألمّح لشيء كهذا
Dialogue: 0,0:07:46.46,0:07:52.31,Default,,0000,0000,0000,,بشكلٍ عام، وقت الوفاة المرجّح\Nهو بين 9:10 و 9:20
Dialogue: 0,0:07:52.54,0:07:54.26,Default,,0000,0000,0000,,أكان المنزل مقفلاً؟
Dialogue: 0,0:07:55.61,0:07:59.86,Default,,0000,0000,0000,,كان الباب الأمامي مفتوحاً عندما\Nأتى السيّد يوشيوكا وفقما يبدو
Dialogue: 0,0:07:59.86,0:08:02.94,Default,,0000,0000,0000,,كانت بقيّة الأبواب مقفلة من الداخل
Dialogue: 0,0:08:02.94,0:08:08.18,Default,,0000,0000,0000,,ما يعني أنّ القاتل كان أحد هؤلاء الثلاثة \Nالذين دخلوا من الباب الأمامي
Dialogue: 0,0:08:09.81,0:08:14.38,Default,,0000,0000,0000,,حسناً، يمكننا استبعاد إيزومي-سان بالنظر للوقت
Dialogue: 0,0:08:14.68,0:08:17.84,Default,,0000,0000,0000,,!انتظر! لديه دافع لقتل أمي
Dialogue: 0,0:08:19.30,0:08:22.83,Default,,0000,0000,0000,,!كانت على وشك أن تقاضيه
Dialogue: 0,0:08:22.83,0:08:26.59,Default,,0000,0000,0000,,أهدر 300 مليون من أموالها على استثمار فاشل
Dialogue: 0,0:08:26.87,0:08:28.25,Default,,0000,0000,0000,,...كـ-كان ذلك
Dialogue: 0,0:08:28.25,0:08:29.85,Default,,0000,0000,0000,,!كان أنت بالفعل إذاً
Dialogue: 0,0:08:29.85,0:08:31.04,Default,,0000,0000,0000,,...كـ-كلا
Dialogue: 0,0:08:31.04,0:08:36.05,Default,,0000,0000,0000,,!تظاهرت بالمغادرة ثمّ تسللت والطريق مفتوح
Dialogue: 0,0:08:36.05,0:08:38.51,Default,,0000,0000,0000,,لا أظنّه القاتل
Dialogue: 0,0:08:39.07,0:08:39.95,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:08:39.95,0:08:44.27,Default,,0000,0000,0000,,إذا كان وقت الوفاة المقدّر بين 9:10 و9:20
Dialogue: 0,0:08:44.27,0:08:46.93,Default,,0000,0000,0000,,فيستحيل أن يكون القاتل إيزومي-سان
Dialogue: 0,0:08:47.35,0:08:48.27,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:08:48.27,0:08:51.44,Default,,0000,0000,0000,,....ألا تذكر، عند التاسعة والأربعين
Dialogue: 0,0:08:51.44,0:08:53.01,Default,,0000,0000,0000,,التاسعة والأربعين؟
Dialogue: 0,0:08:55.14,0:08:55.93,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:08:55.93,0:08:57.22,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:08:57.22,0:09:02.55,Default,,0000,0000,0000,,صحيح، كان معنا في بيكا عند التاسعة والأربعين
Dialogue: 0,0:09:02.55,0:09:09.39,Default,,0000,0000,0000,,فهمت، يستغرق الذهاب هناك\Nخمسين إلى ستّين دقيقة بالسيّارة
Dialogue: 0,0:09:09.92,0:09:11.72,Default,,0000,0000,0000,,إنّه بريء بالفعل
Dialogue: 0,0:09:11.72,0:09:14.70,Default,,0000,0000,0000,,!لكن كان يمكنه فعلها بشكلٍ ما
Dialogue: 0,0:09:14.70,0:09:16.93,Default,,0000,0000,0000,,!الآنسة محقّة
Dialogue: 0,0:09:17.62,0:09:23.84,Default,,0000,0000,0000,,لكن يا آنسة، أليس لديك دافع بدورك؟ لقتل الرئيسة؟
Dialogue: 0,0:09:23.84,0:09:24.97,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:09:25.61,0:09:27.18,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:09:28.11,0:09:32.11,Default,,0000,0000,0000,,قطعت أمّها كلّ الروابط بها بسبب خطيبها في السابق
Dialogue: 0,0:09:32.11,0:09:35.13,Default,,0000,0000,0000,,...زوجها مسجون الآن وفقما يبدو
Dialogue: 0,0:09:35.13,0:09:36.85,Default,,0000,0000,0000,,!لا تتدخل فيما لا يخصّك
Dialogue: 0,0:09:36.85,0:09:40.85,Default,,0000,0000,0000,,ولو كان ذلك صحيحاً، لمَ قد أقتل أمّي؟
Dialogue: 0,0:09:41.22,0:09:45.92,Default,,0000,0000,0000,,سمعتُ أنّك طلبتِ منها قرضاً، ورفضتك زجراً
Dialogue: 0,0:09:45.92,0:09:49.81,Default,,0000,0000,0000,,وأدّى ذلك لشجار عائليّ حاد
Dialogue: 0,0:09:50.54,0:09:56.22,Default,,0000,0000,0000,,أنت من تشاجر معها في العمل\N!وقلت أنّك ستقتلها يوماً
Dialogue: 0,0:09:56.22,0:09:57.83,Default,,0000,0000,0000,,!هـ-هراء
Dialogue: 0,0:09:57.83,0:10:04.32,Default,,0000,0000,0000,,بأيّ حال، يبدو أنّ القاتل أحدكما
Dialogue: 0,0:10:04.32,0:10:06.97,Default,,0000,0000,0000,,إذاً، ما الذي جلبك هنا الليلة يا تشيهيرو-سان؟
Dialogue: 0,0:10:07.48,0:10:10.93,Default,,0000,0000,0000,,استدعتني لتعظني
Dialogue: 0,0:10:10.93,0:10:14.47,Default,,0000,0000,0000,,وفقدتِ السيطرة على أعصابك وقتلتِها
Dialogue: 0,0:10:14.47,0:10:16.13,Default,,0000,0000,0000,,!يكفي هذا أيّها المتحرّي الفاشل
Dialogue: 0,0:10:16.13,0:10:18.14,Default,,0000,0000,0000,,!فـ-فاشل؟
Dialogue: 0,0:10:18.14,0:10:19.81,Default,,0000,0000,0000,,!على رسلك يا موري-كن
Dialogue: 0,0:10:19.81,0:10:22.76,Default,,0000,0000,0000,,إذاً، ما الذي جلبك هنا يا يوشيوكا-سان؟
Dialogue: 0,0:10:23.05,0:10:25.97,Default,,0000,0000,0000,,لقاء عمل
Dialogue: 0,0:10:26.30,0:10:31.39,Default,,0000,0000,0000,,تشير الظروف لكون القاتل أحدهما بالفعل
Dialogue: 0,0:10:37.58,0:10:44.87,Default,,0000,0000,0000,,سنطلب منكم مشاهدة تسجيل كاميرات المراقبة\Nمن باب الحيطة، أخبرونا إذا ما لاحظتم شيئاً
Dialogue: 0,0:10:48.28,0:10:52.31,Default,,0000,0000,0000,,وصل إيزومي-سان بدايةً عند تمام الثامنة ودخل
Dialogue: 0,0:10:54.56,0:10:57.39,Default,,0000,0000,0000,,ثمّ غادر عند 8:40
Dialogue: 0,0:11:00.10,0:11:05.34,Default,,0000,0000,0000,,التالية تشيهيرو-سان، الوقت هو 8:50
Dialogue: 0,0:11:05.34,0:11:10.05,Default,,0000,0000,0000,,ثمّ بعد 10 دقائق، خرجت السيّدة إيكوكو\Nللكلام مع الحرّاس
Dialogue: 0,0:11:11.59,0:11:15.55,Default,,0000,0000,0000,,فهمت، كانت لا تزال الضحيّة\Nعلى قيد الحياة حينها
Dialogue: 0,0:11:15.87,0:11:16.89,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:17.37,0:11:19.88,Default,,0000,0000,0000,,ما الأمر؟ هناك شيءٌ مختلف
Dialogue: 0,0:11:21.50,0:11:24.10,Default,,0000,0000,0000,,غادرت تشيهيرو-سان عند 9:10
Dialogue: 0,0:11:27.86,0:11:32.89,Default,,0000,0000,0000,,بعدها وصل يوشيوكا-سان عند 9:20
Dialogue: 0,0:11:32.89,0:11:36.39,Default,,0000,0000,0000,,لكنّه دخل لعدم سماعه ردّاً
Dialogue: 0,0:11:36.39,0:11:39.93,Default,,0000,0000,0000,,ووجد جثّة السيّدة إيكوكو
Dialogue: 0,0:11:41.89,0:11:42.51,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:11:43.55,0:11:44.90,Default,,0000,0000,0000,,!أعد التسجيل
Dialogue: 0,0:11:47.26,0:11:48.43,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:11:48.84,0:11:51.17,Default,,0000,0000,0000,,أخبرني، لمَ خرجت؟
Dialogue: 0,0:11:51.17,0:11:55.88,Default,,0000,0000,0000,,لـ-للاتصال بالشرطة بالطبع
Dialogue: 0,0:11:55.88,0:11:59.83,Default,,0000,0000,0000,,لمَ قد تخرج بينما يوجد هاتف هنا؟
Dialogue: 0,0:11:59.83,0:12:01.62,Default,,0000,0000,0000,,ذلك محيّر بالفعل
Dialogue: 0,0:12:01.62,0:12:06.20,Default,,0000,0000,0000,,كـ-كنتُ مصدوماً، لذا ذهبت لسيّارتي\Nلجلب الهاتف الخلوي
Dialogue: 0,0:12:06.20,0:12:09.81,Default,,0000,0000,0000,,ليس مستغرباً، فقد وجد جثّةً أمامه
Dialogue: 0,0:12:09.81,0:12:12.69,Default,,0000,0000,0000,,،بالنسبة لشخص خرج في صدمة
Dialogue: 0,0:12:12.69,0:12:14.30,Default,,0000,0000,0000,,أمضى 10 دقائق كاملة في الداخل
Dialogue: 0,0:12:16.02,0:12:17.35,Default,,0000,0000,0000,,ذلك غريب بالفعل
Dialogue: 0,0:12:17.35,0:12:20.22,Default,,0000,0000,0000,,ماذا فعلت في العشر دقائق؟
Dialogue: 0,0:12:23.14,0:12:26.59,Default,,0000,0000,0000,,كما انظروا، إنّه يحمل شيئاً
Dialogue: 0,0:12:27.18,0:12:30.31,Default,,0000,0000,0000,,هلّا شرحت يا يوشيوكا-سان؟
Dialogue: 0,0:12:32.83,0:12:34.17,Default,,0000,0000,0000,,...أنا
Dialogue: 0,0:12:35.24,0:12:38.61,On Top,,0000,0000,0000,,تقرير\Nوكالة أوزاوا للتحرّي
Dialogue: 0,0:12:38.72,0:12:45.40,Default,,0000,0000,0000,,فهمت، يظهر هذا اختلاسك أموالاً من الشركة
Dialogue: 0,0:12:45.40,0:12:48.83,Default,,0000,0000,0000,,كنتُ سألقى هلاكي لو خرج الأمر للعلن
Dialogue: 0,0:12:48.83,0:12:50.82,Default,,0000,0000,0000,,...لذا أتيتُ للكلام معها هنا
Dialogue: 0,0:12:51.17,0:12:55.78,Default,,0000,0000,0000,,لكن قادك ذاك الكلام لقتلها
Dialogue: 0,0:12:55.78,0:12:59.61,Default,,0000,0000,0000,,!كلا! كانت ميتةً عندما وصلت
Dialogue: 0,0:12:59.61,0:13:01.73,Default,,0000,0000,0000,,كأنّنا سنصدّق ذلك
Dialogue: 0,0:13:01.73,0:13:03.53,Default,,0000,0000,0000,,...إنّها الحقيقة! لكن
Dialogue: 0,0:13:03.91,0:13:05.49,Default,,0000,0000,0000,,...ظننتُني سأكون الأكثر شبهة
Dialogue: 0,0:13:05.49,0:13:07.94,Default,,0000,0000,0000,,!إن اُكتشف الملف
Dialogue: 0,0:13:13.35,0:13:17.51,Default,,0000,0000,0000,,لذا اتّصلت بالشرطة بعدما أخفيته في سيّارتك؟
Dialogue: 0,0:13:17.51,0:13:18.40,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:13:18.40,0:13:22.39,Default,,0000,0000,0000,,أعطنا أعذارك في مركز الشرطة
Dialogue: 0,0:13:25.47,0:13:27.94,Default,,0000,0000,0000,,!لم أكن الفاعل! كانت ميتة حقاً
Dialogue: 0,0:13:28.29,0:13:30.85,Default,,0000,0000,0000,,!صدّقوني! لم أقتلها
Dialogue: 0,0:13:38.91,0:13:42.69,Default,,0000,0000,0000,,ما الأمر؟ هناك ما ليس في محلّه\Nبشأن هذه الجثّة
Dialogue: 0,0:13:43.32,0:13:45.28,Default,,0000,0000,0000,,كانت ترتدي ثياب نوم
Dialogue: 0,0:13:45.28,0:13:47.86,Default,,0000,0000,0000,,مع أنّها ستستقبل زوّاراً
Dialogue: 0,0:13:47.86,0:13:49.08,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:13:50.36,0:13:52.73,Default,,0000,0000,0000,,ما قصدك يا ران-نيتشان؟
Dialogue: 0,0:13:52.73,0:13:57.10,Default,,0000,0000,0000,,فمها مفتوح بالكامل، لكن لا توجد أيّ تجعّدات
Dialogue: 0,0:14:01.35,0:14:07.28,Default,,0000,0000,0000,,!فهمت! كان هذا قناع موت حقيقيّ
Dialogue: 0,0:14:14.34,0:14:16.58,Default,,0000,0000,0000,,نحن مستعدون لنقلها حضرة المفتّش
Dialogue: 0,0:14:16.58,0:14:18.15,Default,,0000,0000,0000,,افعلوا إذاً
Dialogue: 0,0:14:18.33,0:14:21.28,Default,,0000,0000,0000,,!كلا! سيفوت الأوان إذا أخذوا الجثّة
Dialogue: 0,0:14:22.28,0:14:24.36,Default,,0000,0000,0000,,!هذه الجثّة غريبة حقاً
Dialogue: 0,0:14:24.83,0:14:26.31,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:14:26.86,0:14:29.77,Default,,0000,0000,0000,,إنّها ترتدي ثوب نوم وقناع وجه
Dialogue: 0,0:14:29.77,0:14:31.65,Default,,0000,0000,0000,,لا غريب في ذلك
Dialogue: 0,0:14:31.65,0:14:33.19,Default,,0000,0000,0000,,،كأنّها على وشك النوم
Dialogue: 0,0:14:33.19,0:14:34.74,Default,,0000,0000,0000,,رغم أنّها ستستقبل زوّاراً
Dialogue: 0,0:14:35.02,0:14:37.93,Default,,0000,0000,0000,,ليس هكذا ترتدي لاستقبال زوّار حقاً
Dialogue: 0,0:14:37.93,0:14:40.69,Default,,0000,0000,0000,,...لكن كانت ابنتها من ستأتي
Dialogue: 0,0:14:41.01,0:14:45.56,Default,,0000,0000,0000,,لكنّ يوشيوكا-سان كان سيأتي\Nبعد زيارة تشيهيرو-سان، أليس كذلك؟
Dialogue: 0,0:14:45.56,0:14:48.69,Default,,0000,0000,0000,,كما خُنقت للموت، صحيح؟
Dialogue: 0,0:14:48.69,0:14:49.80,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:14:49.80,0:14:52.30,Default,,0000,0000,0000,,لكن أشارت ران-نيتشان لغرابة عدم وجود
Dialogue: 0,0:14:52.30,0:14:54.61,Default,,0000,0000,0000,,أيّ تجعدات على قناع وجهها
Dialogue: 0,0:14:54.61,0:14:56.70,Default,,0000,0000,0000,,ماذا؟ أ-أجل
Dialogue: 0,0:14:56.70,0:15:01.07,Default,,0000,0000,0000,,يُفترض أن تكون عليه تجعّدات\Nلو عانت وهي ترتديه
Dialogue: 0,0:15:02.62,0:15:03.61,Default,,0000,0000,0000,,تفقّدوا الأمر
Dialogue: 0,0:15:03.61,0:15:04.58,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:15:10.94,0:15:12.69,Default,,0000,0000,0000,,...ما يعني
Dialogue: 0,0:15:12.90,0:15:17.22,Default,,0000,0000,0000,,!وضع القاتل قناع الوجه بعد قتل الضحيّة
Dialogue: 0,0:15:17.22,0:15:19.52,Default,,0000,0000,0000,,وألبسها ثوب الاستحمام
Dialogue: 0,0:15:19.52,0:15:21.15,Default,,0000,0000,0000,,لكن لمَ؟
Dialogue: 0,0:15:21.68,0:15:24.61,Default,,0000,0000,0000,,كانت ترتدي هذا الثوب عندما أتيتِ، صحيح يا تشيهيرو-سان؟
Dialogue: 0,0:15:24.61,0:15:26.31,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:15:27.71,0:15:29.02,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:15:29.59,0:15:31.01,Default,,0000,0000,0000,,!لم أكن الوحيدة
Dialogue: 0,0:15:31.01,0:15:33.17,Default,,0000,0000,0000,,!رآها الحارسان أيضاً
Dialogue: 0,0:15:33.17,0:15:37.50,Default,,0000,0000,0000,,،أ-أجل، عندما أتيتُ بعد الإنذار الخاطئ
Dialogue: 0,0:15:37.50,0:15:40.23,Default,,0000,0000,0000,,كانت كوجيما-سان ترتدي هذا الثوب حقّاً
Dialogue: 0,0:15:40.23,0:15:44.66,Default,,0000,0000,0000,,في تلك الحالة، لمَ أعاد القاتل\Nوضع قناع الوجه عليها؟
Dialogue: 0,0:15:44.66,0:15:46.44,Default,,0000,0000,0000,,لم تريا شيئاً غريباً؟
Dialogue: 0,0:15:46.44,0:15:48.20,Default,,0000,0000,0000,,...لا أدري تماماً
Dialogue: 0,0:15:48.20,0:15:49.90,Default,,0000,0000,0000,,أأنتما متأكدتان أنّها كانت هي؟
Dialogue: 0,0:15:49.90,0:15:53.07,Default,,0000,0000,0000,,ماذا عن عينيها وأذنيها، وشفتيها على سبيل المثال؟
Dialogue: 0,0:15:53.44,0:15:54.65,Default,,0000,0000,0000,,لا تكن سخيفاً
Dialogue: 0,0:15:54.65,0:15:56.85,Default,,0000,0000,0000,,...كان القناع يغطي وجهها
Dialogue: 0,0:15:57.27,0:15:58.45,Default,,0000,0000,0000,,بالمناسبة
Dialogue: 0,0:15:58.45,0:16:01.98,Default,,0000,0000,0000,,أذكر دهشتي من شفتيها البنفسجيتين اللامعتين
Dialogue: 0,0:16:01.98,0:16:03.74,Default,,0000,0000,0000,,مقابل وجهها الأبيض
Dialogue: 0,0:16:05.39,0:16:07.15,Default,,0000,0000,0000,,!لا ترتدي أحمر شفاه
Dialogue: 0,0:16:08.26,0:16:10.11,Default,,0000,0000,0000,,تقصد كلون تشيهيرو-سان؟
Dialogue: 0,0:16:14.22,0:16:16.23,Default,,0000,0000,0000,,!أجل! كان ذاك اللون
Dialogue: 0,0:16:16.23,0:16:22.15,Default,,0000,0000,0000,,!فهمت! وضعتِ قناع الوجه وقابلتِ الحارسين إذاً
Dialogue: 0,0:16:22.87,0:16:29.95,Default,,0000,0000,0000,,قتلتِ أمّك بيديك لرفضها إقراضك
Dialogue: 0,0:16:29.95,0:16:34.11,Default,,0000,0000,0000,,كانت غلطتك الأولى هو انطلاق الإنذار المعطوب
Dialogue: 0,0:16:34.90,0:16:36.52,Default,,0000,0000,0000,,،لو لم يكن هناك ردّ
Dialogue: 0,0:16:36.52,0:16:38.51,Default,,0000,0000,0000,,كان الحارسان ليدخلا
Dialogue: 0,0:16:39.69,0:16:44.71,Default,,0000,0000,0000,,قررتِ لعب دور أمّك سريعاً عندما فُوجئتِ
Dialogue: 0,0:16:45.89,0:16:49.09,Default,,0000,0000,0000,,كان بإمكانك خداعهما بقناع وجه وثوب نوم
Dialogue: 0,0:16:49.09,0:16:51.86,Default,,0000,0000,0000,,فأنتما أم وابنتها
Dialogue: 0,0:16:51.86,0:16:56.81,Default,,0000,0000,0000,,لكنك قابلتِهما وأنت تضعين أحمر شفاهك في عجلتك
Dialogue: 0,0:16:57.33,0:17:01.22,Default,,0000,0000,0000,,لكن كان عليك مسح أحمر شفاه أمّك
Dialogue: 0,0:17:02.04,0:17:04.58,Default,,0000,0000,0000,,بما أنّ قناع الوجه
Dialogue: 0,0:17:04.58,0:17:07.77,Default,,0000,0000,0000,,يُوضع بعد غسل الوجه وإزالة مساحيق التجميل
Dialogue: 0,0:17:07.77,0:17:12.78,Default,,0000,0000,0000,,قابلتُ الحارسين ووضعت\N!قناع الوجه على أمّي بالفعل
Dialogue: 0,0:17:12.78,0:17:16.48,Default,,0000,0000,0000,,!لكن كانت ميتةً بوقت وصولي
Dialogue: 0,0:17:16.48,0:17:19.98,Default,,0000,0000,0000,,يعرف الجميع شجارنا الدائم
Dialogue: 0,0:17:19.98,0:17:24.19,Default,,0000,0000,0000,,...ظننتُ أنّي سأقع تحت شبهة قتلها، لذا
Dialogue: 0,0:17:25.56,0:17:27.65,Default,,0000,0000,0000,,!صدّقوني! لم أكن الفاعلة
Dialogue: 0,0:17:28.59,0:17:31.61,Default,,0000,0000,0000,,لا شكّ أنّها حاولت تغطية الأمر
Dialogue: 0,0:17:31.61,0:17:35.01,Default,,0000,0000,0000,,لكن ذلك لا ينفع كحجّة غياب
Dialogue: 0,0:17:35.01,0:17:38.33,Default,,0000,0000,0000,,...كلّ ما يفعله هو تغيير وقت الوفاة
Dialogue: 0,0:17:38.33,0:17:39.06,Default,,0000,0000,0000,,تغيير؟
Dialogue: 0,0:17:39.71,0:17:42.03,Default,,0000,0000,0000,,...إذا تغيّر وقت الوفاة
Dialogue: 0,0:17:45.17,0:17:46.19,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:17:46.87,0:17:49.08,Default,,0000,0000,0000,,...العمّ موري يقول
Dialogue: 0,0:17:49.08,0:17:50.24,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:55.03,0:17:56.10,Default,,0000,0000,0000,,كلا، أبداً
Dialogue: 0,0:17:56.52,0:17:59.73,Default,,0000,0000,0000,,غريب، لمَ لم يجدوها؟
Dialogue: 0,0:17:59.73,0:18:00.57,Default,,0000,0000,0000,,!أيمكن؟
Dialogue: 0,0:18:03.86,0:18:06.52,Default,,0000,0000,0000,,أيمكنني المغادرة الآن؟
Dialogue: 0,0:18:07.01,0:18:08.97,Default,,0000,0000,0000,,أجل، شكراً على مساعدتك
Dialogue: 0,0:18:08.97,0:18:13.24,Default,,0000,0000,0000,,قد نحتاج للكلام معك لاحقاً
Dialogue: 0,0:18:13.47,0:18:15.69,Default,,0000,0000,0000,,أجل، أفهم
Dialogue: 0,0:18:21.86,0:18:23.04,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:18:23.04,0:18:25.77,Default,,0000,0000,0000,,يا إلهي، أخبرتك أن تتوقف عن التجوّل
Dialogue: 0,0:18:26.41,0:18:28.02,Default,,0000,0000,0000,,آ-آسف
Dialogue: 0,0:18:29.41,0:18:31.61,Default,,0000,0000,0000,,لا تهتم
Dialogue: 0,0:18:34.24,0:18:35.28,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:18:35.65,0:18:37.12,Default,,0000,0000,0000,,أعتذر منكم إذاً
Dialogue: 0,0:18:38.32,0:18:39.86,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:18:42.99,0:18:44.11,Default,,0000,0000,0000,,...مُجدداً، مُجدداً
Dialogue: 0,0:18:44.61,0:18:45.68,Default,,0000,0000,0000,,أبي؟
Dialogue: 0,0:18:48.47,0:18:50.39,Default,,0000,0000,0000,,لا يصحّ هذا يا إيزومي-سان
Dialogue: 0,0:18:51.69,0:18:56.65,Default,,0000,0000,0000,,كيف نسدل الختام على المسرحية\Nإذا غادرت الشخصية الرئيسية؟
Dialogue: 0,0:18:56.67,0:18:59.61,Default,,0000,0000,0000,,ما-ما قصدك يا موري-سان؟
Dialogue: 0,0:18:59.61,0:19:03.07,Default,,0000,0000,0000,,اكتشفتُ القاتل الحقيقيّ أخيراً
Dialogue: 0,0:19:03.63,0:19:04.46,Default,,0000,0000,0000,,...أبي
Dialogue: 0,0:19:04.46,0:19:07.48,Default,,0000,0000,0000,,لكنّك قلتَ أنّ تشيهيرو-سان هي القاتلة قبل قليل
Dialogue: 0,0:19:07.48,0:19:09.29,Default,,0000,0000,0000,,لم أقل ذلك
Dialogue: 0,0:19:09.29,0:19:13.28,Default,,0000,0000,0000,,كشفتُ حيلتها في تغطية الأمر فحسب
Dialogue: 0,0:19:14.54,0:19:18.48,Default,,0000,0000,0000,,عبثها غير المرغوب عدّل وقت الوفاة المقدّر
Dialogue: 0,0:19:18.86,0:19:23.40,Default,,0000,0000,0000,,مما صنع حجّة غياب للقاتل الحقيقيّ بشكل ساخر
Dialogue: 0,0:19:23.86,0:19:24.90,Default,,0000,0000,0000,,القاتل الحقيقيّ؟
Dialogue: 0,0:19:24.90,0:19:25.85,Default,,0000,0000,0000,,...أتقصد
Dialogue: 0,0:19:25.85,0:19:28.06,Default,,0000,0000,0000,,!تـ-تمزح بالتأكيد
Dialogue: 0,0:19:28.06,0:19:33.32,Default,,0000,0000,0000,,!شهدتَ بأّنّي كنت في بيكا أثناء وقوع الجريمة
Dialogue: 0,0:19:33.60,0:19:37.09,Default,,0000,0000,0000,,لكن إن ثبتت شهادتُها
Dialogue: 0,0:19:37.09,0:19:41.27,Default,,0000,0000,0000,,فوقعت الجريمة قبل 8:50
Dialogue: 0,0:19:41.27,0:19:44.34,Default,,0000,0000,0000,,أي كان بمقدورك تنفيذها
Dialogue: 0,0:19:44.34,0:19:47.73,Default,,0000,0000,0000,,!سخافة! أتقصد أنّك تصدّقها؟
Dialogue: 0,0:19:48.16,0:19:52.44,Default,,0000,0000,0000,,!كما ما الدليل لديك بأنّي قتلتها؟
Dialogue: 0,0:19:52.91,0:19:56.69,Default,,0000,0000,0000,,تشيهيرو-سان، أكان نظر أمّك ضعيفاً؟
Dialogue: 0,0:19:56.69,0:20:03.61,Default,,0000,0000,0000,,ماذا؟ أ-أجل. لكنّها كانت ترتدي \Nعدسات لاصقة لأنّها تكره النظارات
Dialogue: 0,0:20:03.61,0:20:06.77,Default,,0000,0000,0000,,هلّا أعدتم تفقّد جثّة الضحيّة
Dialogue: 0,0:20:06.77,0:20:09.77,Default,,0000,0000,0000,,ستجدون عدسة لاصقة في عينها اليسرى فقط
Dialogue: 0,0:20:11.85,0:20:13.53,Default,,0000,0000,0000,,!توجد عدسة لاصقة في اليسرى فحسب
Dialogue: 0,0:20:14.02,0:20:16.98,Default,,0000,0000,0000,,لم تكن هناك عدسات لاصقة في أغراضها
Dialogue: 0,0:20:16.98,0:20:19.22,Default,,0000,0000,0000,,لا جدوى من بحثكم
Dialogue: 0,0:20:19.22,0:20:20.94,Default,,0000,0000,0000,,لأنّها بحوزة القاتل
Dialogue: 0,0:20:22.13,0:20:29.15,Default,,0000,0000,0000,,أجل، العدسة اللاصقة المفقودة \N!هي في طيّة سروالك يا إيزومي-سان
Dialogue: 0,0:20:32.37,0:20:34.07,Default,,0000,0000,0000,,...اعذرني
Dialogue: 0,0:20:38.45,0:20:39.36,Default,,0000,0000,0000,,!ها هي
Dialogue: 0,0:20:41.49,0:20:42.94,Default,,0000,0000,0000,,!مـ-مستحيل
Dialogue: 0,0:20:43.24,0:20:46.40,Default,,0000,0000,0000,,لا يمكن أن تسقط هناك بشكلٍ عابر
Dialogue: 0,0:20:46.40,0:20:51.02,Default,,0000,0000,0000,,يمكن أن يحصل ذلك فقط\N...إذا احتكت الضحيّة بأحدهم
Dialogue: 0,0:20:51.02,0:20:54.36,Default,,0000,0000,0000,,!أي القاتل
Dialogue: 0,0:21:00.68,0:21:05.43,Default,,0000,0000,0000,,قالت أنّها ستقاضيني على كلّ ما أملكه
Dialogue: 0,0:21:05.43,0:21:09.19,Default,,0000,0000,0000,,مع أنّي استثمرتُ كما أخبرتني فحسب
Dialogue: 0,0:21:09.19,0:21:14.54,Default,,0000,0000,0000,,لكن لحظة خسارتنا للمال، ألقت كامل اللوم عليّ
Dialogue: 0,0:21:14.54,0:21:19.99,Default,,0000,0000,0000,,!أرجوك! أيّ شيء إلّا المحاكم\N...سأعيد كلّ مالك مهما طال
Dialogue: 0,0:21:19.99,0:21:23.36,Default,,0000,0000,0000,,تفقّدتُ الأرض التي يعيش عليها والداك
Dialogue: 0,0:21:25.07,0:21:28.02,Default,,0000,0000,0000,,يمكنني تأجيل المدّة إن باعاها
Dialogue: 0,0:21:28.02,0:21:29.48,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:21:29.98,0:21:32.06,Default,,0000,0000,0000,,تكلّمتُ معهما بالفعل
Dialogue: 0,0:21:32.06,0:21:34.44,Default,,0000,0000,0000,,وافقا على فعل أيّ شيء لتعويضي
Dialogue: 0,0:21:35.68,0:21:39.34,Default,,0000,0000,0000,,حبّ الأبوين شيء جميل حقّاً
Dialogue: 0,0:21:41.72,0:21:47.35,Default,,0000,0000,0000,,لم أستطع مسامحتها... على توريط والديّ في هذا
Dialogue: 0,0:23:22.87,0:23:26.14,Default,,0000,0000,0000,,عملٌ موفق، أنقذتنا مجدداً
Dialogue: 0,0:23:26.40,0:23:27.78,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:23:27.78,0:23:32.19,Default,,0000,0000,0000,,كانت مغادرتك الشرطة خسارةً كبيرة لنا
Dialogue: 0,0:23:32.19,0:23:33.70,Default,,0000,0000,0000,,سنعتمد عليك لاحقاً إذاً
Dialogue: 0,0:23:33.70,0:23:34.82,Default,,0000,0000,0000,,!أ-أجل
Dialogue: 0,0:23:35.15,0:23:36.60,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:23:36.60,0:23:39.18,Default,,0000,0000,0000,,!ران! كونان! وقت الاحتفال
Dialogue: 0,0:23:39.18,0:23:40.52,Default,,0000,0000,0000,,!لنأكل في طريق عودتنا
Dialogue: 0,0:23:40.52,0:23:42.48,Default,,0000,0000,0000,,المزيد من الرامن فحسب، صحيح؟
Dialogue: 0,0:23:43.77,0:23:47.02,Default,,0000,0000,0000,,!حمقاء! لم أقصد طعاماً رخيصاً
Dialogue: 0,0:23:47.20,0:23:48.31,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:23:47.20,0:23:48.31,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:23:48.76,0:23:51.88,Default,,0000,0000,0000,,!سنحتفل برامن اللحم
Dialogue: 0,0:23:54.70,0:23:57.64,Default,,0000,0000,0000,,...ظننتُ ذلك
Dialogue: 0,0:24:00.70,0:24:01.58,Default,,0000,0000,0000,,...ذاك الصوت
Dialogue: 0,0:24:05.25,0:24:07.81,Default,,0000,0000,0000,,لمَ يجلس أوياما-سان بشكل رسميّ؟
Dialogue: 0,0:24:08.34,0:24:12.19,Default,,0000,0000,0000,,ما يعني أنّ القاتل بينكم
Dialogue: 0,0:24:13.72,0:24:17.31,Default,,0000,0000,0000,,...الدماء على الطاولة... وعلى غطائها
Dialogue: 0,0:24:17.81,0:24:20.77,Default,,0000,0000,0000,,،كما أشارت رسالة الانتحار
Dialogue: 0,0:24:21.66,0:24:23.24,Default,,0000,0000,0000,,!القاتل هو ذاك الشخص بلا شكّ
Dialogue: 0,0:24:24.39,0:24:25.51,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.51,0:24:28.38,Default,,0000,0000,0000,,جريمة قتل منزل الجبل الثلجي
Dialogue: 0,0:24:44.94,0:24:47.61,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.61,0:24:49.66,Default,,0000,0000,0000,,شوغي
Dialogue: 0,0:24:49.89,0:24:52.87,Default,,0000,0000,0000,,في الحلقة القادمة، في الجبال الثلجيّة\N!أمسك بالصخر ومات الشاه
Dialogue: 0,0:24:52.87,0:24:54.63,Default,,0000,0000,0000,,!لا تحرّكها بعد

