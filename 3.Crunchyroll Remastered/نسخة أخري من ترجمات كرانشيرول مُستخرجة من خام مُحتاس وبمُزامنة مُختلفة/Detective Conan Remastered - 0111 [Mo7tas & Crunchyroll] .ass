Dialogue: 0,0:00:01.32,0:00:04.65,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.65,0:00:06.35,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.82,0:00:10.31,Default,,0000,0000,0000,,!عمل تحرٍّ بارع على قائمة اليوم! كُل وحلّ القضيّة
Dialogue: 0,0:00:10.31,0:00:11.69,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.69,0:00:13.44,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.44,0:00:15.78,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.44,0:00:23.82,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:23.82,0:00:30.86,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.67,0:00:38.99,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:38.99,0:00:46.49,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.49,0:00:58.94,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:00:59.90,0:01:06.24,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.28,0:01:13.17,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.17,0:01:19.49,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.49,0:01:26.55,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:52.60,0:01:57.32,Default,,0000,0000,0000,,،أثناء انقطاع تيّار مفاجئ في فصل طهو ران
Dialogue: 0,0:01:57.78,0:02:02.25,Default,,0000,0000,0000,,طُعنت المعلّمة، أويموري ميتشي، في ظهرها\Nمن قِبل شخصٍ ما وقُتلت
Dialogue: 0,0:02:05.04,0:02:10.17,Default,,0000,0000,0000,,استعمل الفاعل خيطاً وقالباً جليدياً\Nلإنزال القاطع في غرفة المفاتيح
Dialogue: 0,0:02:11.99,0:02:17.27,Default,,0000,0000,0000,,وبعد التحرّي، زالت احتماليّة\N!كون القاتل من الخارج
Dialogue: 0,0:02:19.59,0:02:25.87,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل فصل الطهو الدراسيّ\N(الجزء الثاني)
Dialogue: 0,0:02:20.15,0:02:23.69,Default,,0000,0000,0000,,جريمة قتل فصل الطهو الدراسيّ\N(الجزء الثاني)
Dialogue: 0,0:02:26.54,0:02:32.61,Default,,0000,0000,0000,,كان بإمكان أيٍّ منكم أنتم الأربعة\Nإعداد حيلة القالب الجليديّ في غرفة المفاتيح
Dialogue: 0,0:02:32.95,0:02:35.32,Default,,0000,0000,0000,,توجد ثلّاجة هنا
Dialogue: 0,0:02:35.62,0:02:38.24,Default,,0000,0000,0000,,وكان بإمكانكم جلب الجليد من منازلكم
Dialogue: 0,0:02:38.62,0:02:41.35,Default,,0000,0000,0000,,ما يعني أنّ سلاح الجريمة هو المشكلة هنا
Dialogue: 0,0:02:41.35,0:02:42.08,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:42.08,0:02:45.71,Default,,0000,0000,0000,,يوكو-سان، أتوجد كسّارات ثلج في هذا الفصل؟
Dialogue: 0,0:02:46.08,0:02:49.92,Default,,0000,0000,0000,,أجل، في الدرج السفليّ بجوار المايكرويف
Dialogue: 0,0:02:56.62,0:03:00.79,Default,,0000,0000,0000,,حضرة المفتّش، لهذه الأسياخ الحديديّة رؤوس حادّة
Dialogue: 0,0:03:00.79,0:03:03.73,Default,,0000,0000,0000,,يوكو-سان، أتقومين بعدّها دوماً؟
Dialogue: 0,0:03:03.73,0:03:06.15,Default,,0000,0000,0000,,أجل، يُفترض أنّها عشرة
Dialogue: 0,0:03:06.45,0:03:09.02,Default,,0000,0000,0000,,توجد تسعة فقط
Dialogue: 0,0:03:09.24,0:03:13.49,Default,,0000,0000,0000,,!مستحيل! كانت عشرةً عندما عددتُ البارحة
Dialogue: 0,0:03:13.82,0:03:16.12,Default,,0000,0000,0000,,!حضرة المفتّش! هذا هو سلاح الجريمة
Dialogue: 0,0:03:16.12,0:03:20.16,Default,,0000,0000,0000,,سرق المجرم سيخاً من الدرج سلفاً
Dialogue: 0,0:03:20.16,0:03:21.95,Default,,0000,0000,0000,,!وطعن به أويموري-سان
Dialogue: 0,0:03:21.95,0:03:26.83,Default,,0000,0000,0000,,لكن أيمكنك طعن شخص بهذا؟\Nلا ممسك له
Dialogue: 0,0:03:26.83,0:03:29.63,Default,,0000,0000,0000,,كنتُ لأختار أداةً بمقبض لو كنت مكانه
Dialogue: 0,0:03:30.06,0:03:36.64,Default,,0000,0000,0000,,كما أنّ الأثر على ظهرها بدا\Nأصغر من رؤوس هذه السياخ
Dialogue: 0,0:03:38.12,0:03:41.91,Default,,0000,0000,0000,,حضرة المفتّش، علينا تفقّد ممتلكاتهم الشخصيّة
Dialogue: 0,0:03:41.91,0:03:42.81,Default,,0000,0000,0000,,معك حقّ
Dialogue: 0,0:03:43.41,0:03:47.66,Default,,0000,0000,0000,,إذاً يا سادة، ضعوا كلّ ممتلكاتكم\Nالشخصيّة على الطاولة رجاءً
Dialogue: 0,0:03:50.37,0:03:55.78,Default,,0000,0000,0000,,...يملك الجميع مرايلاً وأقلام حبر ومحارماً ووصفات
Dialogue: 0,0:03:56.12,0:03:58.45,Default,,0000,0000,0000,,لا يبدو أنّ السيخ موجود
Dialogue: 0,0:03:58.45,0:04:03.66,Default,,0000,0000,0000,,ماذا؟ أنتِ وحدك يا كازوي-سان\Nمن لديها مذكّرة سلكيّة وفرشاة
Dialogue: 0,0:04:04.08,0:04:07.12,Default,,0000,0000,0000,,!ماذا؟ لا تروقني نبرتك
Dialogue: 0,0:04:07.58,0:04:12.37,Default,,0000,0000,0000,,يوكو-سان، هل غادرتِ الفصل\Nبعد وصول كازوي-سان؟
Dialogue: 0,0:04:12.37,0:04:14.59,Default,,0000,0000,0000,,أجل، ذهبتُ لدورة المياه
Dialogue: 0,0:04:17.21,0:04:18.40,Default,,0000,0000,0000,,اكتشفتُ الأمر
Dialogue: 0,0:04:18.75,0:04:21.23,Default,,0000,0000,0000,,!المجرم هو أنت يا كازوي-سان
Dialogue: 0,0:04:22.31,0:04:23.02,Default,,0000,0000,0000,,...ما
Dialogue: 0,0:04:23.21,0:04:24.38,Default,,0000,0000,0000,,!كازوي-سان؟
Dialogue: 0,0:04:24.38,0:04:25.11,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:04:25.54,0:04:30.96,Default,,0000,0000,0000,,سرقتِ السيخ بينما كانت\N!يوكو-سان في دورة المياه
Dialogue: 0,0:04:30.96,0:04:36.58,Default,,0000,0000,0000,,تمكّنتِ من معرفة موقع أويموري-سان\Nوطعنها في الظلام
Dialogue: 0,0:04:37.11,0:04:43.34,Default,,0000,0000,0000,,لأنّ عينيك معتادتان على الظلام بسبب\N!نظّاراتك المُظلمة هذه
Dialogue: 0,0:04:43.59,0:04:44.79,Default,,0000,0000,0000,,!أأنا مُخطئ؟
Dialogue: 0,0:04:45.21,0:04:51.00,Default,,0000,0000,0000,,لا تمزح معي! أنا أعاني حساسيةً\N!من الضوء بسبب سنّي
Dialogue: 0,0:04:51.00,0:04:53.01,Default,,0000,0000,0000,,!لذا أرتدي هذه النظّارات
Dialogue: 0,0:04:54.88,0:04:57.22,Default,,0000,0000,0000,,،كازوي-سان، أثناء الدرس
Dialogue: 0,0:04:57.63,0:05:02.69,Default,,0000,0000,0000,,تركتِ حقيبتك عند قدميك\Nبدل غرفة الطعام
Dialogue: 0,0:05:03.22,0:05:04.50,Default,,0000,0000,0000,,لمَ ذلك؟
Dialogue: 0,0:05:05.17,0:05:08.00,Default,,0000,0000,0000,,!لأنّ ذلك أريح لي
Dialogue: 0,0:05:08.00,0:05:10.70,Default,,0000,0000,0000,,!أريح في إخراج السيخ بسرعة
Dialogue: 0,0:05:11.75,0:05:14.13,Default,,0000,0000,0000,,!السيخ ليس معي
Dialogue: 0,0:05:14.13,0:05:17.45,Default,,0000,0000,0000,,كما قد لا أستطيع الطعن به\N!بما أنّه لا يحمل مقبضاً
Dialogue: 0,0:05:17.96,0:05:20.41,Default,,0000,0000,0000,,لكن يمكنك صنعه
Dialogue: 0,0:05:22.09,0:05:25.63,Default,,0000,0000,0000,,!باستعمال فرشاتك هذه
Dialogue: 0,0:05:29.04,0:05:31.97,Default,,0000,0000,0000,,هكذا يصبح لديك مقبض
Dialogue: 0,0:05:33.04,0:05:33.93,Default,,0000,0000,0000,,!معك حقّ
Dialogue: 0,0:05:34.50,0:05:38.84,Default,,0000,0000,0000,,!والسيخ مخبّأٌ هنا
Dialogue: 0,0:05:38.84,0:05:40.89,Default,,0000,0000,0000,,!في هذه المذكّرة السلكيّة
Dialogue: 0,0:05:43.35,0:05:46.00,Default,,0000,0000,0000,,!لـ-ليس هنا؟! مستحيل
Dialogue: 0,0:05:46.00,0:05:49.15,Default,,0000,0000,0000,,!يُفترض أنّ السيخ داخل السلك
Dialogue: 0,0:05:50.63,0:05:54.11,Default,,0000,0000,0000,,انظر، أليس هذا السيخ المفقود؟
Dialogue: 0,0:05:58.42,0:05:59.54,Default,,0000,0000,0000,,تقويم؟
Dialogue: 0,0:05:59.54,0:06:02.46,Default,,0000,0000,0000,,صحيح، قامت حماتي بذلك
Dialogue: 0,0:06:02.46,0:06:06.50,Default,,0000,0000,0000,,سألت إذا ما كان هناك شيء\Nتستطيع استعماله للتقويم البارحة
Dialogue: 0,0:06:07.79,0:06:11.09,Default,,0000,0000,0000,,يبدو أنّ سلاح الجريمة لم يكن السيخ
Dialogue: 0,0:06:11.09,0:06:12.47,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:13.14,0:06:16.21,Default,,0000,0000,0000,,!يا إلهي! ارفقوا بي
Dialogue: 0,0:06:21.39,0:06:23.59,Default,,0000,0000,0000,,مرحباً؟ معك ميغوري
Dialogue: 0,0:06:26.22,0:06:27.24,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:06:28.16,0:06:30.01,Default,,0000,0000,0000,,كان المشفى
Dialogue: 0,0:06:30.01,0:06:36.26,Default,,0000,0000,0000,,كان جرح أويموري-سان بعمق 5 سم\Nويقلّ عن 1 مم في قطره
Dialogue: 0,0:06:36.26,0:06:40.08,Default,,0000,0000,0000,,...أقلّ من 1 مم؟! أيعني ذلك
Dialogue: 0,0:06:40.08,0:06:45.84,Default,,0000,0000,0000,,لم يكن سلاح الجريمة سيخاً أو كسّارة\Nثلج، بل شيئاً أشبه بالإبرة
Dialogue: 0,0:06:45.84,0:06:48.18,Default,,0000,0000,0000,,...أشبه بالإبرة
Dialogue: 0,0:06:48.18,0:06:51.01,Default,,0000,0000,0000,,!فهمت! كان أنت
Dialogue: 0,0:06:53.12,0:06:56.72,Default,,0000,0000,0000,,كنتِ ممرضةً وفقما أذكر يا كاورو-سان
Dialogue: 0,0:06:56.72,0:07:00.10,Default,,0000,0000,0000,,الممرضات معتادات على استعمال المحاقن
Dialogue: 0,0:07:00.39,0:07:06.07,Default,,0000,0000,0000,,لا بدّ من وجود محقنة يقلّ قطرها\N!عن 1 مم، ويزيد طولها على 5 سم
Dialogue: 0,0:07:06.43,0:07:08.03,Default,,0000,0000,0000,,!وما في ذلك؟
Dialogue: 0,0:07:08.03,0:07:09.97,Default,,0000,0000,0000,,!اكتشفتُ هذه المرّة
Dialogue: 0,0:07:09.97,0:07:12.37,Default,,0000,0000,0000,,!المجرم هو أنت يا كاورو-سان
Dialogue: 0,0:07:13.97,0:07:17.62,Default,,0000,0000,0000,,!لا-لا تكن أحمق! لمَ أنا القاتلة؟
Dialogue: 0,0:07:18.22,0:07:21.68,Default,,0000,0000,0000,,،ضمادة عينك هذه ليست لشحاذ
Dialogue: 0,0:07:21.68,0:07:24.84,Default,,0000,0000,0000,,!بل لكي تعتاد عينك على الظلام
Dialogue: 0,0:07:25.39,0:07:29.22,Default,,0000,0000,0000,,عندما انطفأت الأنوار، خلعتِ هذه الضمادة
Dialogue: 0,0:07:29.22,0:07:32.30,Default,,0000,0000,0000,,!ونظرتِ بعينك اليسرى وحدها لارتكاب الجريمة
Dialogue: 0,0:07:32.84,0:07:37.18,Default,,0000,0000,0000,,!كان الدافع نزاعاً بين الحماة وزوجة الابن غالباً
Dialogue: 0,0:07:37.18,0:07:39.43,Default,,0000,0000,0000,,!لا تختلق هذه الأشياء
Dialogue: 0,0:07:39.43,0:07:42.31,Default,,0000,0000,0000,,فلتخلعي ضمادة عينك لنا إذاً
Dialogue: 0,0:07:43.84,0:07:47.19,Default,,0000,0000,0000,,يُفترض أنّه لا مشكلة\Nإن كان مجرّد شحاذ حقّاً
Dialogue: 0,0:07:50.43,0:07:51.77,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:07:57.08,0:07:59.54,Default,,0000,0000,0000,,!كاورو-سان! كيف أصابتك هذه الكدمة؟
Dialogue: 0,0:08:00.72,0:08:03.00,Default,,0000,0000,0000,,ضربني زوجي
Dialogue: 0,0:08:03.36,0:08:07.46,Default,,0000,0000,0000,,استعملتِ هذه الضمادة لإخفاء الكدمة إذاً؟
Dialogue: 0,0:08:08.05,0:08:10.72,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:08:10.72,0:08:13.09,Default,,0000,0000,0000,,،الجميع هنا يعرفون
Dialogue: 0,0:08:13.09,0:08:17.89,Default,,0000,0000,0000,,لكن حماتي كانت تدلّل ابنها، زوجي تاتسوهيكو
Dialogue: 0,0:08:18.39,0:08:21.68,Default,,0000,0000,0000,,كان ذكر اسمه على لسانها دوماً
Dialogue: 0,0:08:21.68,0:08:25.86,Default,,0000,0000,0000,,ضربني البارحة لأنّي تفوّهت بسوءٍ عنها
Dialogue: 0,0:08:26.14,0:08:28.57,Default,,0000,0000,0000,,أين تاتسوهيكو-سان الآن؟
Dialogue: 0,0:08:29.05,0:08:32.34,Default,,0000,0000,0000,,غادر إلى هاواي في رحلة عمل صباح اليوم
Dialogue: 0,0:08:32.34,0:08:36.30,Default,,0000,0000,0000,,أتساءل كيف ستكون ردّة فعله\Nعندما يكتشف أنّ أمّه ماتت؟
Dialogue: 0,0:08:36.30,0:08:37.54,Default,,0000,0000,0000,,أتمنّى رؤيتها
Dialogue: 0,0:08:37.90,0:08:43.00,Default,,0000,0000,0000,,لـ-لم تزل الشبهات حولك بعد! يمكنك الرؤية\N!بعينك اليسرى تلك
Dialogue: 0,0:08:43.22,0:08:46.04,Default,,0000,0000,0000,,لكن لم يكن السلاح إبرة محقنة
Dialogue: 0,0:08:46.55,0:08:50.34,Default,,0000,0000,0000,,فبالكاد كان هناك أيّ دم\Nعلى ظهر أويموري سينسي
Dialogue: 0,0:08:51.18,0:08:55.39,Default,,0000,0000,0000,,كان الدم ليتبع إبرة المحقنة لسطح البشرة
Dialogue: 0,0:08:55.39,0:08:58.64,Default,,0000,0000,0000,,!بعد تجاوزه للشعيرات الدمويّة
Dialogue: 0,0:08:59.93,0:09:04.22,Default,,0000,0000,0000,,لمَ تصرّ على جعلي القاتلة؟
Dialogue: 0,0:09:04.22,0:09:08.55,Default,,0000,0000,0000,,ليكن في علمك، لستُ الوحيدة التي\Nتمتلك دافعاً لقتلها
Dialogue: 0,0:09:08.55,0:09:11.40,Default,,0000,0000,0000,,يملك الثلاثة الآخرون دوافعَ قويّة بدورهم
Dialogue: 0,0:09:11.70,0:09:12.57,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:09:13.89,0:09:16.99,Default,,0000,0000,0000,,!كاوري-سان! لا تتفوّهي بالهراء
Dialogue: 0,0:09:17.22,0:09:19.09,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:09:19.09,0:09:23.18,Default,,0000,0000,0000,,،كنتِ صديقةً لها لما يفوق ثلاثين عاماً
Dialogue: 0,0:09:23.18,0:09:25.96,Default,,0000,0000,0000,,لكن لا بدّ أنّك كنتِ تبغضينها
Dialogue: 0,0:09:27.01,0:09:34.68,Default,,0000,0000,0000,,فقد سرقت حبيبك قبل 27 عاماً، وتزوّجته
Dialogue: 0,0:09:35.43,0:09:38.55,Default,,0000,0000,0000,,بقيتِ عازبةً مُذ آنذاك، وكنتِ تأتين هنا
Dialogue: 0,0:09:38.55,0:09:45.22,Default,,0000,0000,0000,,فقط كي تري حبيبك القديم، زوجها وحماي
Dialogue: 0,0:09:46.72,0:09:50.22,Default,,0000,0000,0000,,لكنّه مات العام الفائت من مرض
Dialogue: 0,0:09:50.22,0:09:56.35,Default,,0000,0000,0000,,لا بدّ أنّكِ أحببتِه بشدّة بما أنّك\Nلا تزالين تأتين لهذا البيت
Dialogue: 0,0:09:58.30,0:10:01.19,Default,,0000,0000,0000,,...فهمت! لذا قالت آنذاك
Dialogue: 0,0:10:01.97,0:10:04.59,Default,,0000,0000,0000,,كان رجلاً لطيفاً وصالحاً
Dialogue: 0,0:10:05.80,0:10:12.17,Default,,0000,0000,0000,,نيشيتاني-كن، سمعت أنّ حماتي\Nقرّرت قطع دعمها الماليّ لك
Dialogue: 0,0:10:13.48,0:10:17.59,Default,,0000,0000,0000,,فقد وجدت شخصاً موهوباً أكثر منك
Dialogue: 0,0:10:17.59,0:10:23.10,Default,,0000,0000,0000,,لذا تحتّم عليك نسيان حلمك\Nبفتح مطعمك الخاصّ
Dialogue: 0,0:10:23.72,0:10:26.02,Default,,0000,0000,0000,,أذلك صحيح يا نيشيتاني-كن؟
Dialogue: 0,0:10:26.02,0:10:31.23,Default,,0000,0000,0000,,يوكو-سان، كنتِ حاقدةً عليها\Nبدورك لسرقتها وصفاتك
Dialogue: 0,0:10:31.23,0:10:34.26,Default,,0000,0000,0000,,!البتّة! لم أحقد عليها
Dialogue: 0,0:10:34.26,0:10:36.68,Default,,0000,0000,0000,,رأيتُك
Dialogue: 0,0:10:36.68,0:10:39.95,Default,,0000,0000,0000,,رأيتُك تبكين وأنتِ تتجادلين معها
Dialogue: 0,0:10:40.80,0:10:46.91,Default,,0000,0000,0000,,ردّت عليكِ ببرودة آنذاك: "إذا كان الأمر\N"يغيظك، فعليكِ التفوّق عليّ
Dialogue: 0,0:10:49.89,0:10:55.59,Default,,0000,0000,0000,,أي أنّكم الأربعة كنتم تمتلكون\Nدوافعَ لقتل أويموري-سان
Dialogue: 0,0:10:56.30,0:10:57.89,Default,,0000,0000,0000,,...بالمناسبة
Dialogue: 0,0:10:57.89,0:11:02.51,Default,,0000,0000,0000,,قمتَ بتدليك كتفَي أويموري سينسي\Nيا نيشيتاني-سان، أليس كذلك؟
Dialogue: 0,0:11:03.26,0:11:04.52,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:11:04.84,0:11:08.44,Default,,0000,0000,0000,,مما يعني أنّك تعرف المواضع العلاجيّة على الظهر
Dialogue: 0,0:11:08.88,0:11:13.17,Default,,0000,0000,0000,,قطر الإبر المستعملة في العلاج\Nيقلّ عن 1 مم وفقما أذكر
Dialogue: 0,0:11:14.64,0:11:16.26,Default,,0000,0000,0000,,،لكن يا موري-سان
Dialogue: 0,0:11:16.26,0:11:20.68,Default,,0000,0000,0000,,لم أستطع ويوكو-سان إيجادها في الظلام
Dialogue: 0,0:11:20.68,0:11:23.87,Default,,0000,0000,0000,,ولم يسبق لي أن لمست\Nإبرة علاج في حياتي
Dialogue: 0,0:11:24.35,0:11:27.72,Default,,0000,0000,0000,,موري-كن، خضتُ علاج إبر بدوري
Dialogue: 0,0:11:27.72,0:11:30.01,Default,,0000,0000,0000,,وتلك الإبر رفيعةٌ جدّاً، فلا تنفع
Dialogue: 0,0:11:30.01,0:11:34.46,Default,,0000,0000,0000,,إنّها رفيعةٌ وضعيفة بحيث يستحيل\Nأن تطعن بعمق 5 سم
Dialogue: 0,0:11:35.34,0:11:36.92,Default,,0000,0000,0000,,رفيعة جدّاً إذاً؟
Dialogue: 0,0:11:38.01,0:11:38.97,Default,,0000,0000,0000,,تمهل
Dialogue: 0,0:11:39.40,0:11:42.97,Default,,0000,0000,0000,,هذه البلوزة التي طلبتِ منّي إصلاحها
Dialogue: 0,0:11:46.22,0:11:51.56,Default,,0000,0000,0000,,عدّة خياطة، أنتِ الوحيدة التي تحمل\Nواحدةً بين الأربعة، صحيح؟
Dialogue: 0,0:11:52.03,0:11:54.09,Default,,0000,0000,0000,,وما في ذلك؟
Dialogue: 0,0:11:56.55,0:12:00.39,Default,,0000,0000,0000,,الطول 5 سم، والقطر يقلّ عن 1 مم
Dialogue: 0,0:12:00.39,0:12:02.49,Default,,0000,0000,0000,,!يطابق سلاح الجريمة تماماً
Dialogue: 0,0:12:02.49,0:12:06.70,Default,,0000,0000,0000,,كفّ عن هذا! كيف تُخرجها إذا\N!طعنت بها بالكامل؟
Dialogue: 0,0:12:07.22,0:12:08.39,Default,,0000,0000,0000,,معكِ حقّ
Dialogue: 0,0:12:08.39,0:12:09.84,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:12:09.84,0:12:14.17,Default,,0000,0000,0000,,بالأصل، الناس قُساة البشرة بخلاف ما تتوقّعه
Dialogue: 0,0:12:14.17,0:12:17.59,Default,,0000,0000,0000,,فيستحيل أن تستطيع الطعن\Nبإبرة بلا ممسك
Dialogue: 0,0:12:18.72,0:12:20.55,Default,,0000,0000,0000,,ذلك مستحيل بالفعل إذاً؟
Dialogue: 0,0:12:21.05,0:12:25.47,Default,,0000,0000,0000,,من الصحيح أنّ إبرة الخياطة\Nأكثر ما يلائم سلاح الجريمة
Dialogue: 0,0:12:26.01,0:12:28.72,Default,,0000,0000,0000,,لكن الطعن بعمق 5 سم أمرٌ مستحيل
Dialogue: 0,0:12:29.22,0:12:31.76,Default,,0000,0000,0000,,انتظر! إبرة خياطة؟
Dialogue: 0,0:12:32.06,0:12:35.45,Default,,0000,0000,0000,,!أجل! يمكنك الطعن باستعمال تلك
Dialogue: 0,0:12:35.85,0:12:40.56,Default,,0000,0000,0000,,...ولإيجاد أويموري سينسي في الظلام
Dialogue: 0,0:12:40.56,0:12:44.90,Default,,0000,0000,0000,,!سيكون الأمر سهلاً باستعمال ذلك، ولن يبدو جليّاً
Dialogue: 0,0:12:45.54,0:12:49.17,Default,,0000,0000,0000,,...لذا ارتكب ذلك الشخص ذاك الخطأ آنذاك
Dialogue: 0,0:13:03.31,0:13:06.48,Default,,0000,0000,0000,,،هذه نافذة حمّام الفتيان
Dialogue: 0,0:13:06.48,0:13:09.48,Default,,0000,0000,0000,,فيُفترض أنّها في هذه الأرجاء
Dialogue: 0,0:13:11.69,0:13:14.81,Default,,0000,0000,0000,,...ها هي! مما يعني أنّ محتواها
Dialogue: 0,0:13:15.86,0:13:17.10,Default,,0000,0000,0000,,كازوي-سان
Dialogue: 0,0:13:17.10,0:13:19.98,Default,,0000,0000,0000,,هنالك احتمال بأنّ إبرة\Nالخياطة كانت سلاح الجريمة
Dialogue: 0,0:13:19.98,0:13:22.70,Default,,0000,0000,0000,,لذا علينا إجراء فحص دمّ لها
Dialogue: 0,0:13:23.10,0:13:26.62,Default,,0000,0000,0000,,افعل ما يحلو لك، فلا جدوى من الأمر
Dialogue: 0,0:13:26.94,0:13:30.27,Default,,0000,0000,0000,,وهنالك احتمال بإخفاء أحدكم\Nللإبرة في ثيابه
Dialogue: 0,0:13:30.27,0:13:32.84,Default,,0000,0000,0000,,لذا علينا إجراء تفتيش بدنيّ لكم
Dialogue: 0,0:13:32.84,0:13:34.96,Default,,0000,0000,0000,,!ماذا؟ ستفعلون ذلك حتّى؟
Dialogue: 0,0:13:34.96,0:13:36.55,Default,,0000,0000,0000,,!لدينا حقوقنا
Dialogue: 0,0:13:39.81,0:13:42.18,Default,,0000,0000,0000,,!وجدتُها! ها هي
Dialogue: 0,0:13:43.35,0:13:47.23,Default,,0000,0000,0000,,!المجرم كان ذاك الشخص بالفعل إذاً
Dialogue: 0,0:13:55.39,0:13:59.23,Default,,0000,0000,0000,,عرفتُ هويّة الفاعل، بقي سلاح الجريمة
Dialogue: 0,0:14:03.24,0:14:06.23,Default,,0000,0000,0000,,...لو كنتُ سأخفيه
Dialogue: 0,0:14:11.10,0:14:14.31,Default,,0000,0000,0000,,!فهمت، في داخله
Dialogue: 0,0:14:14.31,0:14:17.13,Default,,0000,0000,0000,,!يا للمخبأ الماكر
Dialogue: 0,0:14:17.56,0:14:19.02,Default,,0000,0000,0000,,مفتّش ميغوري
Dialogue: 0,0:14:19.02,0:14:20.48,Default,,0000,0000,0000,,ما النتيجة؟
Dialogue: 0,0:14:20.48,0:14:25.10,Default,,0000,0000,0000,,لم نجد أيّ دم على الأدوات\Nفي عدّة الخياطة
Dialogue: 0,0:14:25.52,0:14:28.35,Default,,0000,0000,0000,,فهمت، شكراً لكم
Dialogue: 0,0:14:29.19,0:14:30.77,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:14:31.01,0:14:34.02,Default,,0000,0000,0000,,كيف مضى التفتيش البدنيّ يا تاكاغي-كن؟
Dialogue: 0,0:14:34.02,0:14:36.52,Default,,0000,0000,0000,,لم يكن بحوزة نيشيتاني-سان أيّة إبر
Dialogue: 0,0:14:36.52,0:14:37.86,Default,,0000,0000,0000,,والنساء؟
Dialogue: 0,0:14:38.19,0:14:39.82,Default,,0000,0000,0000,,لم أجد شيئاً
Dialogue: 0,0:14:41.10,0:14:42.66,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:14:43.10,0:14:46.62,Default,,0000,0000,0000,,هلّا سمحتِ لي ويوكو-سان بالمغادرة؟
Dialogue: 0,0:14:46.94,0:14:53.84,Default,,0000,0000,0000,,كما ذكرتُ سابقاً، لم نكن نستطيع إيجاد المعلّمة في الظلام
Dialogue: 0,0:14:55.19,0:14:56.30,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:14:59.63,0:15:03.35,Default,,0000,0000,0000,,حضرة المفتّش، لا يمكنك السماح\Nلهما بعد بالمغادرة
Dialogue: 0,0:15:04.60,0:15:07.22,Default,,0000,0000,0000,,ماذا؟ لمَ ذلك يا موري-كن؟
Dialogue: 0,0:15:07.60,0:15:10.19,Default,,0000,0000,0000,,لأنّي عرفت هويّة القاتل
Dialogue: 0,0:15:10.54,0:15:11.74,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:11.74,0:15:13.31,Default,,0000,0000,0000,,!حقّاً يا أبي؟
Dialogue: 0,0:15:13.31,0:15:15.32,Default,,0000,0000,0000,,!مـ-من هو القاتل؟
Dialogue: 0,0:15:16.19,0:15:20.06,Default,,0000,0000,0000,,...من قتل أويموري ميتشي-سان
Dialogue: 0,0:15:20.06,0:15:22.28,Default,,0000,0000,0000,,!كان أنت يا نيشيتاني-سان
Dialogue: 0,0:15:25.12,0:15:26.49,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:29.89,0:15:34.02,Default,,0000,0000,0000,,موري-سان، ألم تكن تسمع كلامي؟
Dialogue: 0,0:15:34.02,0:15:35.46,Default,,0000,0000,0000,,...لم أستطع ويوكو-سان
Dialogue: 0,0:15:35.89,0:15:39.42,Default,,0000,0000,0000,,توجد طريقة لإيجاد أويموري-سان\Nحتّى بالظلام
Dialogue: 0,0:15:40.02,0:15:43.14,Default,,0000,0000,0000,,وذلك بارتداء عدسات لاصقة خاصّة سلفاً
Dialogue: 0,0:15:44.85,0:15:46.31,Default,,0000,0000,0000,,عدسات لاصقة؟
Dialogue: 0,0:15:46.60,0:15:53.23,Default,,0000,0000,0000,,أجل، ارتدى عدسات لاصقة سوداء\Nشبيهة بالنظّارات الشمسيّة
Dialogue: 0,0:15:53.69,0:15:57.69,Default,,0000,0000,0000,,عندما دخل هذا الفصل بدايةً، لم يكن يضعها
Dialogue: 0,0:15:58.19,0:16:02.19,Default,,0000,0000,0000,,ولا عندما تسلّل عبر\Nالباب الخلفيّ قبلها
Dialogue: 0,0:16:02.19,0:16:05.41,Default,,0000,0000,0000,,هذا لأنّها كانت ستعيقه عندما
Dialogue: 0,0:16:05.41,0:16:08.27,Default,,0000,0000,0000,,ينصب حيلة القالب الجليديّ\Nفي غرفة المفاتيح
Dialogue: 0,0:16:09.42,0:16:13.73,Default,,0000,0000,0000,,ارتدى العدسات قبل 10 دقائق\Nتقريباً من بدء الدرس
Dialogue: 0,0:16:13.73,0:16:15.54,Default,,0000,0000,0000,,في دورة المياه
Dialogue: 0,0:16:15.54,0:16:17.75,Default,,0000,0000,0000,,...ماذا؟ لذا وقتها
Dialogue: 0,0:16:17.75,0:16:21.63,Default,,0000,0000,0000,,...أجل، لذا عندما التقاكِ في الرواق
Dialogue: 0,0:16:22.31,0:16:25.77,Default,,0000,0000,0000,,!ران-سان! آسف! تبدوان متشابهتين فخلطت بينكما
Dialogue: 0,0:16:26.85,0:16:30.39,Default,,0000,0000,0000,,،الرواق هنا خافت الإضاءة
Dialogue: 0,0:16:30.39,0:16:33.44,Default,,0000,0000,0000,,فلم يستطع التمييز بينك ويوكو-سان
Dialogue: 0,0:16:33.74,0:16:37.90,Default,,0000,0000,0000,,لكن لم تختلف مهاراته بيديه عن المعتاد
Dialogue: 0,0:16:38.23,0:16:44.19,Default,,0000,0000,0000,,،هذا لأنّه كان بارعاً بالأصل\Nوغرفة الفصل مُنارة بما يكفي
Dialogue: 0,0:16:45.01,0:16:49.58,Default,,0000,0000,0000,,لكن أتوجد عدسات لاصقة بتلك الأريحيّة حقّاً؟
Dialogue: 0,0:16:49.97,0:16:51.69,Default,,0000,0000,0000,,كلا، ليس عادةً
Dialogue: 0,0:16:51.69,0:16:55.19,Default,,0000,0000,0000,,في اليابان، العدسات اللاصقة منتجات صيدليّة
Dialogue: 0,0:16:55.19,0:17:00.60,CharCard,,0000,0000,0000,,{\fad(250,200)}نقل الضوء المرئيّ
Dialogue: 0,0:16:55.19,0:17:00.60,On Top,,0000,0000,0000,,،"فيُفرض عليها "نسبة نقل الضوء المرئيّ\Nأي معيار محدّد لمرور الضوء
Dialogue: 0,0:17:00.60,0:17:04.97,On Top,,0000,0000,0000,,فلا يمكن بيع العدسات اللاصقة المُظلمة\Nمثل النظّارات الشمسية
Dialogue: 0,0:17:06.39,0:17:09.60,Default,,0000,0000,0000,,العدسات اللاصقة الملوّنة التي\N\Nدخلت السوق مؤخراً
Dialogue: 0,0:17:09.60,0:17:15.14,Default,,0000,0000,0000,,،تحمل اللون حول العدسات فقط\Nويبقى المنتصف شفّافاً
Dialogue: 0,0:17:15.14,0:17:19.19,Default,,0000,0000,0000,,لكن يمكن طلب عدسات ملوّنة\Nفي أيّ موضع بشكلٍ خاص
Dialogue: 0,0:17:19.19,0:17:22.39,Default,,0000,0000,0000,,للاستعمال في الدراما التلفزيّة والإعلانات
Dialogue: 0,0:17:22.39,0:17:25.99,Default,,0000,0000,0000,,لذا الحصول عليها ليس مستحيلاً
Dialogue: 0,0:17:26.60,0:17:30.95,Default,,0000,0000,0000,,أيّاً يكن، عوّد نيشيتاني-سان\N،عينيه بتلك العدسات
Dialogue: 0,0:17:31.60,0:17:35.85,Default,,0000,0000,0000,,ولحظة انقطاع التيّار، خلعها فوراً
Dialogue: 0,0:17:35.85,0:17:39.31,Default,,0000,0000,0000,,وفتح الباب المزلاجيّ واقترب من أويموري-سان
Dialogue: 0,0:17:39.31,0:17:41.77,Default,,0000,0000,0000,,!وطعن ظهرها
Dialogue: 0,0:17:44.35,0:17:46.93,Default,,0000,0000,0000,,!موري-كن! ما كان سلاح الجريمة؟
Dialogue: 0,0:17:47.23,0:17:50.39,Default,,0000,0000,0000,,أعتقد أنّ سلاح الجريمة\Nكان إبرة خياطة
Dialogue: 0,0:17:50.64,0:17:52.02,Default,,0000,0000,0000,,إبرة خياطة؟
Dialogue: 0,0:17:52.02,0:17:56.77,Default,,0000,0000,0000,,لكنّك قلت قبل قليل أنّ الطعن\N،بعمق 5 سم بها ليس سهلاً
Dialogue: 0,0:17:56.77,0:17:58.81,Default,,0000,0000,0000,,!وقد تعلق إذا لم تتوخَّ الحذر
Dialogue: 0,0:17:59.31,0:18:03.03,Default,,0000,0000,0000,,يمكن حلّ تلك المشاكل بكشتبان وخيط
Dialogue: 0,0:18:03.56,0:18:05.56,Default,,0000,0000,0000,,كشتبان وخيط؟
Dialogue: 0,0:18:06.56,0:18:11.95,Default,,0000,0000,0000,,كشتبان؟ أتقصد الخاتم الذي\Nيُرتدى عند الخياط اليدويّة؟
Dialogue: 0,0:18:12.31,0:18:16.91,Default,,0000,0000,0000,,صحيح، فلتنظروا لسبّابة نيشيتاني-سان اليمنى من فضلكم
Dialogue: 0,0:18:21.60,0:18:24.25,Default,,0000,0000,0000,,!استعمل الخاتم كشتباناً؟
Dialogue: 0,0:18:24.52,0:18:28.69,Default,,0000,0000,0000,,...صحيح، مرّر خيطاً بالإبرة، ثمّ
Dialogue: 0,0:18:31.89,0:18:39.39,Default,,0000,0000,0000,,لكنّي أظنّه حرق الخيط الذي استعمله\Nآنذاك بموقد الفرن غالباً
Dialogue: 0,0:18:39.64,0:18:41.98,Default,,0000,0000,0000,,...مهلك، هذا يعني أنّ الدليل
Dialogue: 0,0:18:41.98,0:18:44.56,Default,,0000,0000,0000,,لا تقلق حضرة المفتّش
Dialogue: 0,0:18:44.56,0:18:45.36,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:18:46.81,0:18:49.07,Default,,0000,0000,0000,,وجدتُ هذه في الجانب الخلفيّ لدورة المياه
Dialogue: 0,0:18:50.73,0:18:52.89,Default,,0000,0000,0000,,حافظة عدسات لاصقة؟
Dialogue: 0,0:18:52.89,0:18:54.02,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:54.02,0:18:58.83,Default,,0000,0000,0000,,ألقاها نيشيتاني-سان من نافذة \Nالحمّام بعدما ارتداها
Dialogue: 0,0:18:59.24,0:19:04.89,Default,,0000,0000,0000,,كما وجدتُ هذا الفرد داخل\N!وعاء طهو نيشيتاني-سان
Dialogue: 0,0:19:05.77,0:19:07.73,Default,,0000,0000,0000,,عدسة لاصقة؟
Dialogue: 0,0:19:07.73,0:19:08.74,Default,,0000,0000,0000,,!تاكاغي-كن
Dialogue: 0,0:19:08.74,0:19:09.55,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:19:16.52,0:19:19.56,Default,,0000,0000,0000,,!حضرة المفتّش! وجدتُ العدسة الأخرى
Dialogue: 0,0:19:19.56,0:19:23.31,Default,,0000,0000,0000,,نيشيتاني-سان، هلّا شرحت لنا ما يعنيه هذا؟
Dialogue: 0,0:19:23.64,0:19:28.81,Default,,0000,0000,0000,,أهناك خطبٌ ما بارتداء عدسات\Nلاصقة شبيهة بالنظّارات الشمسيّة؟
Dialogue: 0,0:19:28.81,0:19:33.41,Default,,0000,0000,0000,,فلتجدوا سلاح الجريمة قبل توجيه\N!تهمة القتل لشخص
Dialogue: 0,0:19:33.64,0:19:37.41,Default,,0000,0000,0000,,لكنّ سلاح الجريمة بين ممتلكاتك
Dialogue: 0,0:19:40.35,0:19:42.50,Default,,0000,0000,0000,,داخل قلم حبرك
Dialogue: 0,0:19:50.31,0:19:51.13,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:19:51.69,0:19:55.10,Default,,0000,0000,0000,,!نيشيتاني-سان! لا تزال تنوي التهرّب؟
Dialogue: 0,0:19:56.77,0:19:58.98,Default,,0000,0000,0000,,...ظننتُه كان مخبأً رائعاً
Dialogue: 0,0:20:00.60,0:20:03.56,Default,,0000,0000,0000,,،أعترف بخسارتي يا موري-سان\Nكما يُتوقع من المتحرّي العظيم
Dialogue: 0,0:20:04.69,0:20:09.89,Default,,0000,0000,0000,,حصلتُ على العدسات اللاصقة عندما\Nذهبتُ لأوروبا الشهر الفائت للتمرين
Dialogue: 0,0:20:10.18,0:20:12.18,Default,,0000,0000,0000,,دفعتُ لأحد العاملين في شركة صانعة ليصنعها لي
Dialogue: 0,0:20:13.73,0:20:16.15,Default,,0000,0000,0000,,فقد ارتأيتُ أنّ العدسات اللاصقة\Nاليابانيّة ستكون سهلة التعقّب
Dialogue: 0,0:20:16.15,0:20:17.44,Default,,0000,0000,0000,,ودافعك؟
Dialogue: 0,0:20:17.44,0:20:21.50,Default,,0000,0000,0000,,ألأنّها قطعت دعمها الماليّ لك حقّاً؟
Dialogue: 0,0:20:22.02,0:20:27.34,Default,,0000,0000,0000,,ذلك جزء، لكنّي شعرتُ بالأسف على يوكو-سان\Nبعدما سُرقت وصفاتها
Dialogue: 0,0:20:29.15,0:20:35.93,Default,,0000,0000,0000,,لذا أردتُ تنفيذ خطّتي الليلة السابقة\Nلحفلة كتابها الأكثر مبيعاً
Dialogue: 0,0:20:37.02,0:20:43.44,Default,,0000,0000,0000,,...يوكو-سان، ربما لم تلحظي، لكنّي لطالما كنت
Dialogue: 0,0:20:43.92,0:20:45.94,Default,,0000,0000,0000,,عرفتُ مشاعرك
Dialogue: 0,0:20:46.98,0:20:51.85,Default,,0000,0000,0000,,لكنّي لم أردك أن تُقدم على هذا البتّة
Dialogue: 0,0:20:51.85,0:20:54.85,Default,,0000,0000,0000,,كان هدفي هو تطوير نفسي
Dialogue: 0,0:20:54.85,0:21:00.70,Default,,0000,0000,0000,,وصنع وصفات مثالية لا تستطيع\Nالمعلّمة المساعدة فيها
Dialogue: 0,0:21:02.77,0:21:08.13,Default,,0000,0000,0000,,نيشيتاني-سان، لم يكن الحُب المحرّض لأفعالك
Dialogue: 0,0:21:08.85,0:21:14.76,Default,,0000,0000,0000,,كانت مجرّد فعلة إجراميّة نبعت من أنانيّتك البحتة
Dialogue: 0,0:23:02.26,0:23:04.95,Default,,0000,0000,0000,,ماذا؟ فصل طهو آخر؟
Dialogue: 0,0:23:05.25,0:23:06.65,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:23:06.65,0:23:09.32,Default,,0000,0000,0000,,،بعدما حلّ بأويموري سينسي
Dialogue: 0,0:23:09.32,0:23:12.07,Default,,0000,0000,0000,,قرّرت سونوكو الذهاب لفصل\Nطهو دراسيّ آخر
Dialogue: 0,0:23:12.07,0:23:14.43,Default,,0000,0000,0000,,!وسألتني إذا ما كنت أريد مرافقتها
Dialogue: 0,0:23:14.94,0:23:16.39,Default,,0000,0000,0000,,طهو فرنسيّ مُجدداً؟
Dialogue: 0,0:23:16.39,0:23:18.07,Default,,0000,0000,0000,,!أجل، صحيح
Dialogue: 0,0:23:18.07,0:23:23.85,Default,,0000,0000,0000,,يمكنني الذهاب يا أبي، صحيح؟\Nفتكلفته نفس تكلفة فصل أويموري سينسي
Dialogue: 0,0:23:24.24,0:23:26.57,Default,,0000,0000,0000,,نفسها؟ كم بالضبط؟
Dialogue: 0,0:23:26.57,0:23:28.32,Default,,0000,0000,0000,,عشرة آلاف ينّ للفصل الواحد شهرياً
Dialogue: 0,0:23:28.74,0:23:30.78,Default,,0000,0000,0000,,!عشرة آلاف ينّ لفصلٍ واحد؟
Dialogue: 0,0:23:37.49,0:23:42.37,Default,,0000,0000,0000,,هذا السردين لذيذٌ حقّاً! لا غنى لليابانيّين\N!عن الأكل اليابانيّ حقّاً
Dialogue: 0,0:23:42.74,0:23:46.53,Default,,0000,0000,0000,,يبدو أنّك عليكِ نسيان فكرة فصل الطهو
Dialogue: 0,0:23:46.53,0:23:48.21,Default,,0000,0000,0000,,ذلك ما يبدو
Dialogue: 0,0:23:48.59,0:23:49.98,Default,,0000,0000,0000,,!أجل، أجل
Dialogue: 0,0:23:51.00,0:23:52.92,Default,,0000,0000,0000,,!عـ-عظمة
Dialogue: 0,0:23:54.79,0:23:58.28,Default,,0000,0000,0000,,لن نأكل طهو ران الفرنسيّ\Nلفترة وفقما يبدو
Dialogue: 0,0:24:02.81,0:24:04.09,Default,,0000,0000,0000,,نموذج التشريح؟
Dialogue: 0,0:24:04.35,0:24:10.88,Default,,0000,0000,0000,,!كان يركض قبل أربع ليال في الرواق! وبسرعةٍ فائقة
Dialogue: 0,0:24:11.35,0:24:14.35,Default,,0000,0000,0000,,انظري! هذه البقعة الضبابيّة\N!البيضاء على الزجاج
Dialogue: 0,0:24:14.64,0:24:18.64,Default,,0000,0000,0000,,!إنّها دليلٌ على التصاق أحدهم بالنافذة، واستراقه النظر
Dialogue: 0,0:24:22.27,0:24:23.02,Default,,0000,0000,0000,,!دم
Dialogue: 0,0:24:25.48,0:24:31.48,On Top,,0000,0000,0000,,قضيّة ألغاز ابتدائيّة تيتان السبعة
Dialogue: 0,0:24:26.48,0:24:27.98,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.98,0:24:31.12,Default,,0000,0000,0000,,قضيّة ألغاز ابتدائيّة تيتان السبعة
Dialogue: 0,0:24:47.13,0:24:49.26,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.26,0:24:51.03,Default,,0000,0000,0000,,غرفة تشريح
Dialogue: 0,0:24:51.68,0:24:53.56,Default,,0000,0000,0000,,مسرح الحلقة القادمة\N!هو مدرسة ليلاً
Dialogue: 0,0:24:53.56,0:24:55.05,Default,,0000,0000,0000,,ما الذي تعلّمه تلك المدرسة؟
Dialogue: 0,0:24:55.05,0:24:57.05,Default,,0000,0000,0000,,ليس بذاك المعنى

