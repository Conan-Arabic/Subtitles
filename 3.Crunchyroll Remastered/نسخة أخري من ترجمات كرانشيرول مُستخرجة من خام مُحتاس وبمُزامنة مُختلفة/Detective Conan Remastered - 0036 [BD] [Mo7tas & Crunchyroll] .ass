Dialogue: 0,0:00:01.00,0:00:04.24,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.59,0:00:08.41,Default,,0000,0000,0000,,!الوقت الآن السابعة والنصف! هناك شيءٌ سيحصل قرب أيومي
Dialogue: 0,0:00:08.78,0:00:10.19,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.19,0:00:12.45,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:12.45,0:00:14.94,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.85,0:01:51.96,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل يوم الإثنين، 7:30 مساءً
Dialogue: 0,0:01:46.88,0:01:50.17,Default,,0000,0000,0000,,جريمة قتل يوم الإثنين، 7:30 مساءً
Dialogue: 0,0:01:54.24,0:01:57.52,Default,,0000,0000,0000,,يجب ألّا تفوتنا حلقة\N!يايبا المقنّع اليوم قطعاً
Dialogue: 0,0:01:57.52,0:02:01.44,Default,,0000,0000,0000,,!إنّها المعركة الحاسمة ضدّ مُحارب ميدوري، باتلر
Dialogue: 0,0:02:01.44,0:02:03.86,Default,,0000,0000,0000,,!أشعر بحماسٍ من الآن
Dialogue: 0,0:02:03.86,0:02:06.85,Default,,0000,0000,0000,,ما الخطب يا أيومي-تشان؟\Nلا تبدين على خير
Dialogue: 0,0:02:07.43,0:02:11.79,Default,,0000,0000,0000,,عليّ الذهاب للعيادة وخلع سنٍّ اليوم
Dialogue: 0,0:02:12.77,0:02:14.23,Default,,0000,0000,0000,,تعانين من تسوّس؟
Dialogue: 0,0:02:14.28,0:02:18.88,Default,,0000,0000,0000,,كلا، هذا سنٌّ لبنيّ يرفض السقوط
Dialogue: 0,0:02:18.88,0:02:22.68,Default,,0000,0000,0000,,قالت الطبيبة أنّه سيعترض نمو سنّي الدائم
Dialogue: 0,0:02:22.91,0:02:26.29,Default,,0000,0000,0000,,!تؤلمني أسناني من مجرد سماع ذلك
Dialogue: 0,0:02:26.29,0:02:28.01,Default,,0000,0000,0000,,من هي طبيبتك؟
Dialogue: 0,0:02:28.28,0:02:31.14,Default,,0000,0000,0000,,عيادة ساواكي قرب حديقة بيكا
Dialogue: 0,0:02:31.14,0:02:33.99,Default,,0000,0000,0000,,!ذهبتُ هناك قبلاً
Dialogue: 0,0:02:33.99,0:02:37.10,Default,,0000,0000,0000,,!الطبيبة هناك جميلةٌ جدّاً ولطيفة
Dialogue: 0,0:02:37.10,0:02:41.68,Default,,0000,0000,0000,,أجل، كان جدول الطبيبة يوكو مشغولاً لأسبوع من الآن
Dialogue: 0,0:02:41.68,0:02:45.52,Default,,0000,0000,0000,,لكنّها قالت أنّ من الأفضل الإبكار
Dialogue: 0,0:02:45.52,0:02:49.01,Default,,0000,0000,0000,,فستقابلني بعد ساعات عملها الاعتيادية استثناءً
Dialogue: 0,0:02:49.01,0:02:50.79,Default,,0000,0000,0000,,في أيّ وقت؟
Dialogue: 0,0:02:50.79,0:02:51.84,Default,,0000,0000,0000,,السادسة والنصف
Dialogue: 0,0:02:51.84,0:02:56.30,Default,,0000,0000,0000,,يبدأ يايبا المقنّع عند السابعة والنصف\Nلذا يُفترض أن تصلي في الوقت
Dialogue: 0,0:02:56.96,0:03:00.04,Default,,0000,0000,0000,,...يايبا المقنّع والأسنان اللبنية
Dialogue: 0,0:03:00.04,0:03:03.90,Default,,0000,0000,0000,,أصبحت أعيش حياة طالب ابتدائية بحذافيرها
Dialogue: 0,0:03:09.24,0:03:10.64,Default,,0000,0000,0000,,هذا هو المكان
Dialogue: 0,0:03:10.64,0:03:12.45,On Top,,0000,0000,0000,,عيادة ساواكي للأسنان
Dialogue: 0,0:03:12.45,0:03:14.60,On Top,,0000,0000,0000,,مُغلقة لليوم
Dialogue: 0,0:03:14.60,0:03:17.48,Default,,0000,0000,0000,,أخبرتني أن أدخل من الخلف
Dialogue: 0,0:03:17.48,0:03:18.50,Default,,0000,0000,0000,,من هنا
Dialogue: 0,0:03:29.47,0:03:31.93,On Top,,0000,0000,0000,,باب عيادة ساواكي للأسنان الجانبيّ
Dialogue: 0,0:03:35.73,0:03:38.18,On Top,,0000,0000,0000,,ساواكي ساما
Dialogue: 0,0:03:40.75,0:03:42.03,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:03:42.03,0:03:43.14,Default,,0000,0000,0000,,!أنا أيومي
Dialogue: 0,0:03:44.37,0:03:45.80,Default,,0000,0000,0000,,أهلاً
Dialogue: 0,0:03:45.80,0:03:46.11,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:46.87,0:03:49.75,Default,,0000,0000,0000,,سأقدّمه لك، إنّه إيدوغاوا كونان-كن
Dialogue: 0,0:03:49.75,0:03:51.83,Default,,0000,0000,0000,,رافقني لأنّه شعر بالقلق عليّ
Dialogue: 0,0:03:51.83,0:03:52.86,Default,,0000,0000,0000,,مساء الخير
Dialogue: 0,0:03:52.86,0:03:53.83,Default,,0000,0000,0000,,مساء الخير
Dialogue: 0,0:03:53.83,0:03:58.20,Default,,0000,0000,0000,,،أخبرتني أيومي-تشان الكثير عنك\Nوعن الرجل الذي تعيش معه
Dialogue: 0,0:03:58.20,0:04:02.11,Default,,0000,0000,0000,,!سمعتُ أنّه مُتحرٍّ شهير يحلّ مختلف القضايا
Dialogue: 0,0:04:02.11,0:04:03.82,Default,,0000,0000,0000,,...أجل، نوعاً ما
Dialogue: 0,0:04:03.82,0:04:06.74,Default,,0000,0000,0000,,سمعتُ أنّك مُتحرٍّ بارع بدورك يا كونان-كن
Dialogue: 0,0:04:06.74,0:04:08.69,Default,,0000,0000,0000,,...لستُ بذاك
Dialogue: 0,0:04:08.69,0:04:11.15,Default,,0000,0000,0000,,احترس في طريق عودتك إذاً
Dialogue: 0,0:04:11.15,0:04:14.11,Default,,0000,0000,0000,,سأنتظر حتّى تنتهي أيومي-تشان
Dialogue: 0,0:04:14.69,0:04:17.38,Default,,0000,0000,0000,,لا تقلق، سآخذها معي للبيت
Dialogue: 0,0:04:17.38,0:04:20.44,Default,,0000,0000,0000,,عليك العودة بما أنّ الظلام سيخيم
Dialogue: 0,0:04:21.13,0:04:23.59,Default,,0000,0000,0000,,هيّا، لندخل يا أيومي-تشان
Dialogue: 0,0:04:26.92,0:04:29.04,Default,,0000,0000,0000,,دعيها تقلّك للمنزل إذاً
Dialogue: 0,0:04:29.04,0:04:30.44,Default,,0000,0000,0000,,سأرجع الآن
Dialogue: 0,0:04:30.44,0:04:33.40,Default,,0000,0000,0000,,!أجل، شكراً لك يا كونان-كن
Dialogue: 0,0:04:38.49,0:04:41.45,Default,,0000,0000,0000,,سأجهز في لحظات، لذا انتظري هنا
Dialogue: 0,0:04:41.45,0:04:41.94,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:04:56.24,0:04:58.30,Default,,0000,0000,0000,,!بطاقات لعب يايبا المقنّع
Dialogue: 0,0:05:07.83,0:05:09.25,Default,,0000,0000,0000,,أرجوك يا يايبا المقنّع
Dialogue: 0,0:05:09.25,0:05:11.79,Default,,0000,0000,0000,,احمني من الألم
Dialogue: 0,0:05:15.17,0:05:17.32,Default,,0000,0000,0000,,!ما الذي تقوله أيّها الأحمق؟
Dialogue: 0,0:05:17.32,0:05:19.12,Default,,0000,0000,0000,,لا أهتم إذا كان المبنى معيوباً أم لا
Dialogue: 0,0:05:19.12,0:05:23.01,Default,,0000,0000,0000,,!أنا من يقرّر بيعه! اكفني من ثرثرتك
Dialogue: 0,0:05:24.20,0:05:25.87,Default,,0000,0000,0000,,من هذا؟
Dialogue: 0,0:05:25.87,0:05:26.71,Default,,0000,0000,0000,,!سأغلق الهاتف
Dialogue: 0,0:05:29.48,0:05:31.73,Default,,0000,0000,0000,,أجل، من هناك؟
Dialogue: 0,0:05:40.22,0:05:42.35,Default,,0000,0000,0000,,لـ-لمَ؟
Dialogue: 0,0:05:50.82,0:05:52.40,On Top,,0000,0000,0000,,ابتدائية بيكا
Dialogue: 0,0:05:52.40,0:05:54.63,Default,,0000,0000,0000,,أسمعتم؟
Dialogue: 0,0:05:54.63,0:05:57.35,Default,,0000,0000,0000,,!وقعت جريمة قتل في هايدو البارحة
Dialogue: 0,0:05:57.62,0:05:59.45,Default,,0000,0000,0000,,أجل، قرأتُ عنها في الصحف
Dialogue: 0,0:05:59.45,0:06:02.19,Default,,0000,0000,0000,,كان الضحيّة رئيس وكالة عقارات
Dialogue: 0,0:06:02.19,0:06:06.45,Default,,0000,0000,0000,,ومن عثر على جثّته كانت جارته ومدير المبنى
Dialogue: 0,0:06:07.42,0:06:11.93,Default,,0000,0000,0000,,!وخمّنوا من كانت تلك المرأة؟ طبيبة أسنان أيومي-تشان
Dialogue: 0,0:06:13.65,0:06:16.72,Default,,0000,0000,0000,,أتى شرطيّ لمنزلي البارحة في وقتٍ متأخّر
Dialogue: 0,0:06:16.72,0:06:18.94,Default,,0000,0000,0000,,وسألني ما الذي كانت تفعله عند السابعة والنصف
Dialogue: 0,0:06:18.94,0:06:20.36,Default,,0000,0000,0000,,السابعة والنصف؟
Dialogue: 0,0:06:20.36,0:06:24.72,Default,,0000,0000,0000,,أخبرته أنّ الطبيبة يوكو\Nكانت تخلع سنّي وقتها
Dialogue: 0,0:06:24.72,0:06:28.93,Default,,0000,0000,0000,,وشاهدنا يايبا المقنّع بعدها معاً\Nفي غرفة الانتظار في العيادة
Dialogue: 0,0:06:30.07,0:06:33.24,Default,,0000,0000,0000,,!لمَ قد تسأل الشرطة عن شيء كهذا؟
Dialogue: 0,0:06:33.24,0:06:38.54,Default,,0000,0000,0000,,يتحققون من حجّة غيابها\Nبما أنّها أول من وجد الجثّة غالباً
Dialogue: 0,0:06:38.54,0:06:41.19,Default,,0000,0000,0000,,وقعت الجريمة عند السابعة والنصف بالتأكيد
Dialogue: 0,0:06:41.45,0:06:43.87,Default,,0000,0000,0000,,هذا ما قاله الشرطيّ
Dialogue: 0,0:06:43.87,0:06:47.12,Default,,0000,0000,0000,,!يعني أنّ الطبيبة يوكو بريئة إذاً! حُسِم الأمر
Dialogue: 0,0:06:47.69,0:06:48.69,Default,,0000,0000,0000,,ميتسوهيكو
Dialogue: 0,0:06:48.69,0:06:51.61,Default,,0000,0000,0000,,ألم تكن حلقة يايبا المقنّع البارحة\Nمثيرةً جدّاً؟
Dialogue: 0,0:06:51.90,0:06:57.22,Default,,0000,0000,0000,,،بلى! في الذروة عند قتاله مع باتلر تحديداً\N!شعرتُ بحماسٍ شديد حتّى تعرّقت يداي
Dialogue: 0,0:06:57.22,0:06:58.89,Default,,0000,0000,0000,,أليس كذلك يا أيومي-تشان؟
Dialogue: 0,0:07:02.14,0:07:03.82,Default,,0000,0000,0000,,!أشعر بالغيظ
Dialogue: 0,0:07:04.37,0:07:06.76,Default,,0000,0000,0000,,!لم أشاهد شيئاً تقريباً
Dialogue: 0,0:07:07.55,0:07:09.69,Default,,0000,0000,0000,,لكنّك قلتِ أنّك رأيته مع الطبيبة
Dialogue: 0,0:07:09.69,0:07:11.38,Default,,0000,0000,0000,,شاهدتُ البداية فقط
Dialogue: 0,0:07:11.38,0:07:13.65,Default,,0000,0000,0000,,ونمتُ خلال الباقي
Dialogue: 0,0:07:13.65,0:07:15.07,Default,,0000,0000,0000,,!نمتِ؟
Dialogue: 0,0:07:15.07,0:07:17.76,Default,,0000,0000,0000,,!ما قصدك؟ أعطنا التفاصيل
Dialogue: 0,0:07:18.12,0:07:19.50,Default,,0000,0000,0000,,...حسناً، بالأمس
Dialogue: 0,0:07:20.79,0:07:23.66,Default,,0000,0000,0000,,خلعته! لم تشعري بألم، صحيح؟
Dialogue: 0,0:07:23.66,0:07:25.00,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:26.82,0:07:29.77,Default,,0000,0000,0000,,...أشعر بالنعاس لسببٍ ما
Dialogue: 0,0:07:30.15,0:07:32.82,Default,,0000,0000,0000,,لا بدّ أنّك مرهقة من القلق
Dialogue: 0,0:07:32.82,0:07:35.69,Default,,0000,0000,0000,,يمكنك الاستراحة قليلاً في غرفة الانتظار
Dialogue: 0,0:07:35.94,0:07:39.02,Default,,0000,0000,0000,,لكن يبدأ يايبا المقنّع عند السابعة والنصف
Dialogue: 0,0:07:40.61,0:07:43.81,Default,,0000,0000,0000,,لا تقلقي، سأوقظك قبلها
Dialogue: 0,0:07:43.81,0:07:46.28,Default,,0000,0000,0000,,فيمكنك مشاهدته هناك، اتّفقنا؟
Dialogue: 0,0:07:46.59,0:07:47.46,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:07:50.30,0:07:52.53,Default,,0000,0000,0000,,!أيومي-تشان، أيومي-تشان
Dialogue: 0,0:07:52.97,0:07:54.04,Default,,0000,0000,0000,,!استيقظي
Dialogue: 0,0:07:54.53,0:07:56.03,Default,,0000,0000,0000,,سيبدأ يايبا المقنّع
Dialogue: 0,0:08:05.83,0:08:07.23,Default,,0000,0000,0000,,!يايبا
Dialogue: 0,0:08:08.49,0:08:10.65,Default,,0000,0000,0000,,خذي هذه يا أيومي-تشان
Dialogue: 0,0:08:11.03,0:08:15.40,Default,,0000,0000,0000,,إنّه دواء للألم، فقد تشعرين بالجوع\Nبعدما يزول تأثير المخدّر
Dialogue: 0,0:08:15.40,0:08:16.28,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:08:20.35,0:08:21.39,Default,,0000,0000,0000,,فتاة مطيعة
Dialogue: 0,0:08:32.66,0:08:33.73,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:08:34.87,0:08:37.36,Default,,0000,0000,0000,,!يايبا المقنع، شكراً لك على حمايتي
Dialogue: 0,0:08:37.36,0:08:39.55,Default,,0000,0000,0000,,بالكاد شعرتُ بألم بفضلك
Dialogue: 0,0:08:43.23,0:08:46.01,Default,,0000,0000,0000,,شكرتُه ثم أعدت البطاقة
Dialogue: 0,0:08:47.39,0:08:50.72,Default,,0000,0000,0000,,استعملتِ بطاقة يايبا المقنّع\Nكتميمة حظّ حسن إذاً؟
Dialogue: 0,0:08:50.72,0:08:51.81,Default,,0000,0000,0000,,وبعدها؟
Dialogue: 0,0:08:51.81,0:08:55.18,Default,,0000,0000,0000,,كنتُ أشاهد بتركيز في البداية
Dialogue: 0,0:08:55.18,0:08:58.42,Default,,0000,0000,0000,,...لكن غلبني النعاس مُجدداً
Dialogue: 0,0:09:01.71,0:09:04.80,Default,,0000,0000,0000,,أيومي-تشان، استيقظي يا أيومي-تشان
Dialogue: 0,0:09:08.04,0:09:09.00,On Top,,0000,0000,0000,,في الحلقة القادمة
Dialogue: 0,0:09:09.83,0:09:11.47,Default,,0000,0000,0000,,!انتهى
Dialogue: 0,0:09:11.47,0:09:15.54,Default,,0000,0000,0000,,آسفة، حاولت إيقاظك لكنّك\Nكنتِ مُستغرقة في النوم
Dialogue: 0,0:09:15.54,0:09:17.42,Default,,0000,0000,0000,,هيّا، لنرجع للبيت
Dialogue: 0,0:09:17.42,0:09:18.72,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:09:21.53,0:09:24.14,Default,,0000,0000,0000,,فلم أشاهد كاملاً
Dialogue: 0,0:09:24.14,0:09:28.22,Default,,0000,0000,0000,,!لا تكتئبي هكذا! لا بدّ أنّ أحداً ما سجّله
Dialogue: 0,0:09:28.22,0:09:30.51,Default,,0000,0000,0000,,أجل، لنسأل الجميع لاحقاً
Dialogue: 0,0:09:35.14,0:09:36.39,Default,,0000,0000,0000,,...لقد عُدت
Dialogue: 0,0:09:36.39,0:09:37.21,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:09:37.21,0:09:39.29,Default,,0000,0000,0000,,!مرحباً يا كونان-كن! كنتُ أنتظرك
Dialogue: 0,0:09:39.96,0:09:43.17,Default,,0000,0000,0000,,أتيتُ للتحقق من شيءٍ معك بخصوص البارحة
Dialogue: 0,0:09:43.17,0:09:44.57,Default,,0000,0000,0000,,اجلس
Dialogue: 0,0:09:44.57,0:09:45.30,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:09:45.30,0:09:46.51,Default,,0000,0000,0000,,إذاً حضرة المفتش
Dialogue: 0,0:09:46.51,0:09:48.87,Default,,0000,0000,0000,,لمَ أخذت ساواكي يوكو مدير المبنى
Dialogue: 0,0:09:48.87,0:09:50.72,Default,,0000,0000,0000,,لشقّة الضحيّة؟
Dialogue: 0,0:09:51.16,0:09:53.75,Default,,0000,0000,0000,,،وفقاً للمدير
Dialogue: 0,0:09:53.75,0:09:57.75,Default,,0000,0000,0000,,فقد تضايقت من ارتفاع صوت تلفاز ناكاموتو
Dialogue: 0,0:09:57.75,0:10:02.32,Default,,0000,0000,0000,,،بعدما عادت من العيادة عند الثامنة والنصف\Nفذهبت للمدير وتوجّها لشقّته معاً
Dialogue: 0,0:10:02.32,0:10:05.90,Default,,0000,0000,0000,,لكنّه لم يسمع شيئاً، وعندما فتح الباب
Dialogue: 0,0:10:05.90,0:10:09.67,Default,,0000,0000,0000,,وجد جثّة الضحية أمامه
Dialogue: 0,0:10:09.67,0:10:14.10,Default,,0000,0000,0000,,،إذا تكبّدت عناء القدوم هنا ومراجعتي في أمر
Dialogue: 0,0:10:14.10,0:10:16.47,Default,,0000,0000,0000,,فلا بدّ أنّ الطبيبة يوكو تملك دافعاً
Dialogue: 0,0:10:16.47,0:10:18.74,Default,,0000,0000,0000,,أ-أهذا صحيح حضرة المفتّش؟
Dialogue: 0,0:10:18.92,0:10:22.76,Default,,0000,0000,0000,,قبل 26 عاماً، اُعتقل الضحيّة ناكاموتو كاتسوهيكو
Dialogue: 0,0:10:22.76,0:10:25.84,Default,,0000,0000,0000,,بشبهة اختطاف وقتل طفل
Dialogue: 0,0:10:25.84,0:10:27.94,Default,,0000,0000,0000,,من محافظة ياماناشي
Dialogue: 0,0:10:28.29,0:10:29.42,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:30.83,0:10:33.80,Default,,0000,0000,0000,,كان الضحيّة وقتها صبيّاً في التاسعة
Dialogue: 0,0:10:33.80,0:10:38.71,Default,,0000,0000,0000,,لكن تمّ إطلاق سراح ناكاموتو لضعف الدلائل
Dialogue: 0,0:10:39.34,0:10:43.43,Default,,0000,0000,0000,,كان لذاك الصبيّ أخت في السابعة
Dialogue: 0,0:10:43.43,0:10:44.96,Default,,0000,0000,0000,,...وهي نفسها
Dialogue: 0,0:10:45.47,0:10:47.90,Default,,0000,0000,0000,,!ساواكي يوكو
Dialogue: 0,0:10:48.81,0:10:52.77,Default,,0000,0000,0000,,أي أنّ لها دافعاً قويّاً لقتله
Dialogue: 0,0:10:52.77,0:10:55.81,Default,,0000,0000,0000,,صحيح، لكنّها تقول أنّها لم تعلم
Dialogue: 0,0:10:55.81,0:10:59.92,Default,,0000,0000,0000,,أنّ ناكاموتو كان المشتبه به الرئيسيّ\Nفي جريمة الاختطاف والقتل قبل 26 عاماً
Dialogue: 0,0:10:59.92,0:11:03.39,Default,,0000,0000,0000,,تبدو أكثر من مصادفة
Dialogue: 0,0:11:03.39,0:11:08.54,Default,,0000,0000,0000,,أيمكن أنّك أتيت لسماع وجهة نظر\Nعمّي المتحرّي العظيم في الواقع؟
Dialogue: 0,0:11:08.54,0:11:12.80,Default,,0000,0000,0000,,...كلا... حسناً، على الشرطة عدم إقحام المدنيّين
Dialogue: 0,0:11:13.93,0:11:18.76,Default,,0000,0000,0000,,هكذا إذاً؟ لا أمانع المساعدة في تلك الحالة حضرة المفتّش
Dialogue: 0,0:11:18.76,0:11:22.51,Default,,0000,0000,0000,,المشكلة هي حجّة الغياب التي شهدت بها أيومي-كن
Dialogue: 0,0:11:22.99,0:11:25.61,Default,,0000,0000,0000,,تستغرق المسافة 15 دقيقة من عيادة ساواكي يوكو
Dialogue: 0,0:11:25.61,0:11:27.80,Default,,0000,0000,0000,,إلى منزلها في هايدو بالسيّارة
Dialogue: 0,0:11:28.40,0:11:31.40,Default,,0000,0000,0000,,،إذا تركت أيومي-كن تنام في العيادة
Dialogue: 0,0:11:31.40,0:11:34.90,Default,,0000,0000,0000,,،وذهبت بالسيّارة وحدها للمنزل وقتلت ناكاموتو
Dialogue: 0,0:11:34.90,0:11:38.76,Default,,0000,0000,0000,,ثم عادت قيادةً مجدداً فستستغرق قرابة 50 دقيقة
Dialogue: 0,0:11:39.09,0:11:42.39,Default,,0000,0000,0000,,أي، بدون شهادة أيومي-كن\Nأنّ ساواكي يوكو
Dialogue: 0,0:11:42.39,0:11:46.05,Default,,0000,0000,0000,,أيقظتها عند السابعة والنصف وشاهدت يايبا المقنّع معها
Dialogue: 0,0:11:46.05,0:11:49.43,Default,,0000,0000,0000,,فكانت لتملك وقتاً كافياً لارتكاب الجريمة
Dialogue: 0,0:11:52.09,0:11:56.55,Default,,0000,0000,0000,,أخبرني حضرة المفتّش، أأنتم متأكدون\Nمن وقوع الجريمة في السابعة والنصف؟
Dialogue: 0,0:11:56.55,0:12:01.03,Default,,0000,0000,0000,,أجل، فأحد موظفيّ ناكاموتو كان معه\Nعلى الهاتف قبل الحادثة
Dialogue: 0,0:12:01.03,0:12:06.55,Default,,0000,0000,0000,,سمع صوت الجرس عند السابعة وتسع وعشرون دقيقة
Dialogue: 0,0:12:06.98,0:12:11.47,Default,,0000,0000,0000,,أكّد التشريح الجنائي أنّه مات قرابة \Nالسابعة والنصف أيضاً
Dialogue: 0,0:12:11.47,0:12:15.43,Default,,0000,0000,0000,,أي أنّ حجّة غياب ساواكي يوكو مطبقة
Dialogue: 0,0:12:16.27,0:12:19.35,Default,,0000,0000,0000,,!فهمت! حللتُ الأمر حضرة المفتّش
Dialogue: 0,0:12:19.72,0:12:22.26,Default,,0000,0000,0000,,لنذهب لعيادة ساواكي للأسنان الآن
Dialogue: 0,0:12:22.26,0:12:25.39,Default,,0000,0000,0000,,سأكسر أنا المتحرّي العظيم موري كوغورو
Dialogue: 0,0:12:25.39,0:12:27.34,Default,,0000,0000,0000,,!حجّة غيابها أمام عينيها
Dialogue: 0,0:12:29.79,0:12:31.97,Default,,0000,0000,0000,,!حـ-حقاً يا موري-كن؟
Dialogue: 0,0:12:35.59,0:12:36.80,Default,,0000,0000,0000,,تفضّلوا
Dialogue: 0,0:12:40.12,0:12:42.78,Default,,0000,0000,0000,,نعتذر على مضايقتك فجأةً هكذا
Dialogue: 0,0:12:42.78,0:12:45.01,Default,,0000,0000,0000,,لا مشكلة، اجلسوا رجاءً
Dialogue: 0,0:12:49.42,0:12:52.38,Default,,0000,0000,0000,,هذه البطاقات التي تكلّمت عنها أيومي-تشان؟
Dialogue: 0,0:12:52.38,0:12:53.73,Default,,0000,0000,0000,,...سأجلب قهوة
Dialogue: 0,0:12:53.73,0:12:55.18,Default,,0000,0000,0000,,انتظري قليلاً
Dialogue: 0,0:12:55.51,0:12:59.93,Default,,0000,0000,0000,,لا داعي للقهوة، أصغي لنظريتيّ فقط
Dialogue: 0,0:12:59.93,0:13:04.43,Default,,0000,0000,0000,,!قاتل السيّد ناكاموتو كان أنت
Dialogue: 0,0:13:04.43,0:13:05.14,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:05.14,0:13:08.26,Default,,0000,0000,0000,,...لكن يا موري-كن، لديها حجّة غياب
Dialogue: 0,0:13:08.26,0:13:13.00,Default,,0000,0000,0000,,حضرة المفتّش، يايبا المقنّع الذي\Nأوقظت أيومي-كن لتشاهده
Dialogue: 0,0:13:13.00,0:13:15.34,Default,,0000,0000,0000,,كان تسجيلاً في الواقع
Dialogue: 0,0:13:15.34,0:13:18.94,Default,,0000,0000,0000,,!ولم تشغّله عند السابعة والنصف، بل الثامنة
Dialogue: 0,0:13:18.95,0:13:20.22,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:26.04,0:13:27.30,Default,,0000,0000,0000,,أكمل رجاءً
Dialogue: 0,0:13:27.86,0:13:31.73,Default,,0000,0000,0000,,أي أنّك قتلتِ السيّد ناكاموتو
Dialogue: 0,0:13:31.73,0:13:34.81,Default,,0000,0000,0000,,،ورجعتِ هنا عند السابعة وخمسٍ وخمسين تقريباً
Dialogue: 0,0:13:35.53,0:13:37.30,Default,,0000,0000,0000,,أيقظتِ أيومي-كن عند الثامنة
Dialogue: 0,0:13:37.97,0:13:42.23,Default,,0000,0000,0000,,وشغّلتِ حلقة يايبا المقنّع\Nالتي اكتمل تسجيلها على شريط للتوّ
Dialogue: 0,0:13:42.97,0:13:46.59,Default,,0000,0000,0000,,،ثمّ خدعتها لتناول حبّة منوّمة بداعي تخفيف الألم
Dialogue: 0,0:13:46.59,0:13:48.30,Default,,0000,0000,0000,,فنامت مُجدداً
Dialogue: 0,0:13:48.30,0:13:51.98,Default,,0000,0000,0000,,وأيقظتِها مُجدداً بعد 10 دقائق\Nوأريتِها عرض الحلقة القادمة
Dialogue: 0,0:13:52.88,0:13:59.81,Default,,0000,0000,0000,,عدّلتِ الساعة بالطبع فتلاعبتِ\Nبحسّ أيومي-كن بالوقت
Dialogue: 0,0:14:00.75,0:14:03.04,Default,,0000,0000,0000,,!كما يُتوقع منك يا موري-كن
Dialogue: 0,0:14:03.04,0:14:04.80,Default,,0000,0000,0000,,لكن يا أبي
Dialogue: 0,0:14:05.04,0:14:06.74,Default,,0000,0000,0000,,لا يوجد مشغّل فيديو هنا
Dialogue: 0,0:14:08.60,0:14:10.82,Default,,0000,0000,0000,,!حسناً، تخلّصتْ منه
Dialogue: 0,0:14:10.82,0:14:13.45,Default,,0000,0000,0000,,كيلا يكتشف أحدٌ الحيلة
Dialogue: 0,0:14:13.74,0:14:17.52,Default,,0000,0000,0000,,يؤسفني قول هذا، لكنّ نظريتك ليس صحيحاً
Dialogue: 0,0:14:17.52,0:14:20.18,Default,,0000,0000,0000,,فقد كانت الساعة الثامنة تماماً
Dialogue: 0,0:14:20.18,0:14:23.37,Default,,0000,0000,0000,,عندما أخذتُ أيومي-تشان للمنزل من العيادة
Dialogue: 0,0:14:24.66,0:14:28.84,Default,,0000,0000,0000,,ووصلنا لمنزلها بعد الثامنة وخمس دقائق بقليل
Dialogue: 0,0:14:28.84,0:14:31.71,Default,,0000,0000,0000,,أنا متأكدة بإمكانك التحقق من ذلك
Dialogue: 0,0:14:31.76,0:14:33.65,Default,,0000,0000,0000,,!لا-لا يمكن
Dialogue: 0,0:14:38.66,0:14:39.76,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:14:39.80,0:14:42.26,Default,,0000,0000,0000,,...لم تُصب نظرية العمّ
Dialogue: 0,0:14:43.46,0:14:45.96,Default,,0000,0000,0000,,لا تقلق، سآخذها معي للبيت
Dialogue: 0,0:14:45.96,0:14:49.17,Default,,0000,0000,0000,,عليك العودة بما أنّ الظلام سيخيم
Dialogue: 0,0:14:49.99,0:14:53.18,Default,,0000,0000,0000,,لكنّها أصرّت على أن أغادر وقتها
Dialogue: 0,0:14:54.15,0:14:58.09,Default,,0000,0000,0000,,أكان ذلك لأنّ وجودي سيمنعها من تزييف حجّة غيابها؟
Dialogue: 0,0:14:59.02,0:15:02.69,Default,,0000,0000,0000,,إذا تعمّدت أن تكون أول من يكتشف\Nالجثّة بعد وصولها البيت
Dialogue: 0,0:15:02.69,0:15:06.67,Default,,0000,0000,0000,,...كي تُعطي الشرطة وقت وفاة دقيق
Dialogue: 0,0:15:07.30,0:15:09.97,Default,,0000,0000,0000,,!فإذاً كلّ شيء كان لتركيب حجّة غيابها
Dialogue: 0,0:15:10.76,0:15:12.88,Default,,0000,0000,0000,,إذا كانت المجرمة
Dialogue: 0,0:15:12.88,0:15:16.42,Default,,0000,0000,0000,,!فلا بدّ من وجود حيلة في جزءٍ من حجّة غيابها
Dialogue: 0,0:15:16.90,0:15:18.13,Default,,0000,0000,0000,,...في جزءٍ ما
Dialogue: 0,0:15:27.67,0:15:32.58,Default,,0000,0000,0000,,يمكن تنفيذ حيل حُجج الغياب\Nباستعمال الناس والأماكن والزمن
Dialogue: 0,0:15:33.28,0:15:37.06,Default,,0000,0000,0000,,من ناحية الناس، لا أظنّ أنّ شهادة أيومي-تشان خاطئة
Dialogue: 0,0:15:37.81,0:15:41.49,Default,,0000,0000,0000,,الوفاة وموعد العيادة ثابتا الوقت
Dialogue: 0,0:15:42.40,0:15:44.12,Default,,0000,0000,0000,,...مما يترك
Dialogue: 0,0:15:45.85,0:15:47.24,Default,,0000,0000,0000,,حيلة مكان
Dialogue: 0,0:16:03.17,0:16:05.20,Default,,0000,0000,0000,,مجمع شقق قيد الإنشاء؟
Dialogue: 0,0:16:11.95,0:16:14.15,Default,,0000,0000,0000,,هل أوقفوا البناء قبل اكتماله؟
Dialogue: 0,0:16:19.36,0:16:21.38,Default,,0000,0000,0000,,آثار الإطارات هذه حديثة
Dialogue: 0,0:16:22.06,0:16:23.79,Default,,0000,0000,0000,,...إذا أوقفتَ سيّارةً هنا
Dialogue: 0,0:16:24.44,0:16:28.38,Default,,0000,0000,0000,,يمكنك الدخول لمجمع الشقق\Nعبر أدراج الطوارئ دون أن يراك أحد
Dialogue: 0,0:16:31.68,0:16:33.71,Default,,0000,0000,0000,,لا بدّ أنّ هذه شقّة الطبيبة
Dialogue: 0,0:16:34.22,0:16:37.07,Default,,0000,0000,0000,,فالستائر في عيادتها تحمل التصميم نفسه
Dialogue: 0,0:16:44.72,0:16:47.25,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:16:47.87,0:16:50.71,Default,,0000,0000,0000,,!كانت هذه حيلة مكان بالفعل
Dialogue: 0,0:16:50.71,0:16:55.09,Default,,0000,0000,0000,,ما يعني أنّ ذاك الشيء\N!لا يزال في شقّتها حتماً
Dialogue: 0,0:17:00.36,0:17:01.13,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:03.61,0:17:04.84,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:17:04.84,0:17:06.03,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:17:06.97,0:17:09.13,Default,,0000,0000,0000,,أريد مناقشة موضوعٍ معك
Dialogue: 0,0:17:09.38,0:17:12.76,Default,,0000,0000,0000,,موضوع؟ ما هو بالضبط؟
Dialogue: 0,0:17:17.34,0:17:18.93,Default,,0000,0000,0000,,هيّا، تفضّل
Dialogue: 0,0:17:26.16,0:17:28.70,Default,,0000,0000,0000,,هل تريد عصيراً يا كونان-كن؟
Dialogue: 0,0:17:28.70,0:17:29.76,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:17:30.04,0:17:32.10,Default,,0000,0000,0000,,هل تخلّصتِ من ثلّاجتك؟
Dialogue: 0,0:17:32.41,0:17:33.26,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:33.38,0:17:36.02,Default,,0000,0000,0000,,أرى أنّك غيّرتِ الساعة والتقويم
Dialogue: 0,0:17:36.69,0:17:40.73,Default,,0000,0000,0000,,لكن أعتقد أنّ التلفاز وجهاز التكييف\Nكانا كبيرين جدّاً فلم تغيريهما فوراً
Dialogue: 0,0:17:41.03,0:17:42.16,Default,,0000,0000,0000,,ما الذي تتكلم عنه؟
Dialogue: 0,0:17:42.22,0:17:46.18,Default,,0000,0000,0000,,ستُثيرين الشبهة إذا تخلّصتِ من أريكتك وطاولتك بهذه السرعة
Dialogue: 0,0:17:46.18,0:17:47.89,Default,,0000,0000,0000,,،وأفهم وضع ورق الحائط
Dialogue: 0,0:17:47.89,0:17:50.62,Default,,0000,0000,0000,,لكن ألم يكن عليك تغيير ستائر النافذة؟
Dialogue: 0,0:17:51.14,0:17:52.61,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:17:52.63,0:17:55.75,Default,,0000,0000,0000,,اكتشفتُ حيلتك
Dialogue: 0,0:17:56.59,0:18:01.13,Default,,0000,0000,0000,,جعلتِ هذه الغرفة مُشابهةً للغرفة في عيادتك
Dialogue: 0,0:18:01.13,0:18:03.71,Default,,0000,0000,0000,,كي تخدعي حسّ أيومي-تشان بالموقع
Dialogue: 0,0:18:04.26,0:18:06.25,Default,,0000,0000,0000,,تقول كلاماً مُثيراً
Dialogue: 0,0:18:06.25,0:18:08.83,Default,,0000,0000,0000,,أريد الاستماع لنظريتك أيّها المتحرّي
Dialogue: 0,0:18:09.16,0:18:13.04,Default,,0000,0000,0000,,جعلتِ أيومي-تشان تنام بالمخدّر أوّلاً
Dialogue: 0,0:18:13.04,0:18:16.73,Default,,0000,0000,0000,,ووضعتِها في السيّارة وذهبتِ لهايدو \Nعند السابعة وخمس دقائق
Dialogue: 0,0:18:17.69,0:18:21.99,Default,,0000,0000,0000,,وعند قرابة السابعة والثلث، أوقفتِ السيّارة\N عند موقع البناء في الخلف
Dialogue: 0,0:18:21.99,0:18:24.75,Default,,0000,0000,0000,,وحملتِ أيومي-تشان عبر أدراج الطوارئ ودخلتِ المبنى
Dialogue: 0,0:18:25.78,0:18:29.76,Default,,0000,0000,0000,,ووضعتِها في هذه الغرفة المحاكية لغرفة عيادتك
Dialogue: 0,0:18:29.80,0:18:32.59,Default,,0000,0000,0000,,ذهبتِ بعدها للشقّة المجاورة عند السابعة والنصف
Dialogue: 0,0:18:33.14,0:18:34.10,Default,,0000,0000,0000,,وقتلتِ ناكاموتو-سان
Dialogue: 0,0:18:35.60,0:18:39.13,Default,,0000,0000,0000,,ثمّ دخلتِ شقّته ورفعتِ صوت التلفاز
Dialogue: 0,0:18:39.55,0:18:43.22,Default,,0000,0000,0000,,بأمل أن يكتشف أحد جثّته سريعاً
Dialogue: 0,0:18:43.22,0:18:47.33,Default,,0000,0000,0000,,،فإذا لم يُحدّد وقت الوفاة بأكبر دقّة ممكنة
Dialogue: 0,0:18:47.33,0:18:49.52,Default,,0000,0000,0000,,ستصبح حجّة غيابك تحت الشبهة
Dialogue: 0,0:18:50.00,0:18:53.01,Default,,0000,0000,0000,,عدتِ لشقّتك فوراً وأيقظتِ أيومي-تشان
Dialogue: 0,0:18:53.01,0:18:55.97,Default,,0000,0000,0000,,وأريتِها يايبا المقنّع الذي بدأ لتوّه
Dialogue: 0,0:18:56.20,0:18:58.33,Default,,0000,0000,0000,,وأعطيتِها حبّةً منومة بعدها بعشر دقائق
Dialogue: 0,0:18:58.42,0:19:04.96,Default,,0000,0000,0000,,وأخذتِها للعيادة بعدما نامت مجدداً لتصلا\N عند قرابة السابعة وأربع وخمسون دقيقة
Dialogue: 0,0:19:05.89,0:19:09.93,Default,,0000,0000,0000,,ثمّ أيقظتِها مُجدداً وأريتِها عرض\Nالحلقة القادمة ليايبا المقنّع
Dialogue: 0,0:19:10.64,0:19:12.89,Default,,0000,0000,0000,,يُفترض أنّ كلّ شيءٍ جرى بسلاسة
Dialogue: 0,0:19:12.89,0:19:16.29,Default,,0000,0000,0000,,لكن عندما رجعتِ، كانت جثّة ناكاموتو-سان لم تُكتشف بعد
Dialogue: 0,0:19:17.09,0:19:22.80,Default,,0000,0000,0000,,لم يكن أمامك خيار سوى استدعاء\Nمدير المبنى والعثور على الجثّة معه
Dialogue: 0,0:19:22.80,0:19:24.77,Default,,0000,0000,0000,,مدركةً للشبهة التي ستحيطك
Dialogue: 0,0:19:25.43,0:19:27.24,Default,,0000,0000,0000,,هذه نظريةٌ مُثيرة
Dialogue: 0,0:19:28.25,0:19:31.46,Default,,0000,0000,0000,,لكن لا دليل لديك لتدعمها
Dialogue: 0,0:19:31.87,0:19:33.62,Default,,0000,0000,0000,,الدليل موجود
Dialogue: 0,0:19:33.62,0:19:35.56,Default,,0000,0000,0000,,!في مجموعة البطاقات هذه
Dialogue: 0,0:19:38.82,0:19:41.07,Default,,0000,0000,0000,,ربما لم تعرفي
Dialogue: 0,0:19:41.07,0:19:45.28,Default,,0000,0000,0000,,لكنّ أيومي-تشان وضعت إحدى هذه البطاقات في جيبها
Dialogue: 0,0:19:45.28,0:19:47.70,Default,,0000,0000,0000,,ليحالفها الحظّ قبل خلع سنّها
Dialogue: 0,0:19:48.23,0:19:50.02,Default,,0000,0000,0000,,آص القلوب
Dialogue: 0,0:19:50.02,0:19:53.69,Default,,0000,0000,0000,,أعادت البطاقة بعد خلع سنّها
Dialogue: 0,0:19:55.60,0:20:00.47,Default,,0000,0000,0000,,،إذا فعلَتْ ذلك في هذه الغرفة وليس العيادة
Dialogue: 0,0:20:00.93,0:20:04.01,Default,,0000,0000,0000,,فيُفترض أن توجد بطاقتَي آص القلوب في هذه المجموعة
Dialogue: 0,0:20:07.88,0:20:09.13,Default,,0000,0000,0000,,الأولى
Dialogue: 0,0:20:23.18,0:20:27.42,Default,,0000,0000,0000,,بإحدى هذين البطاقتين بصمات أيومي-تشان
Dialogue: 0,0:20:27.95,0:20:31.54,Default,,0000,0000,0000,,كونان-كن، هل أخبرتَ أحداً عن هذا؟
Dialogue: 0,0:20:31.60,0:20:33.36,Default,,0000,0000,0000,,كلا، لا أحد
Dialogue: 0,0:20:34.20,0:20:37.81,Default,,0000,0000,0000,,لا يعرف أحدٌ أنّي أتيت هنا اليوم حتّى
Dialogue: 0,0:20:54.97,0:20:58.56,Default,,0000,0000,0000,,خسرتُ يا كونان-كن، كما استنتجتَ تماماً
Dialogue: 0,0:20:58.82,0:21:02.69,Default,,0000,0000,0000,,تذكّرتِ ناكاموتو-سان، أليس كذلك؟
Dialogue: 0,0:21:03.63,0:21:06.45,Default,,0000,0000,0000,,!كيف لي أن أنسى وجهه؟
Dialogue: 0,0:21:06.45,0:21:11.50,Default,,0000,0000,0000,,!رأيتُ ناكاموتو يأخذ أخي للسيّارة قبل 26 عاماً
Dialogue: 0,0:21:12.03,0:21:16.37,Default,,0000,0000,0000,,من الصعب أن تدخل شهادتي المحاكمة\Nوأنا في السابعة وقتها
Dialogue: 0,0:21:17.19,0:21:19.21,Default,,0000,0000,0000,,ذلك ما اعتقدته الشرطة
Dialogue: 0,0:21:19.51,0:21:21.18,Default,,0000,0000,0000,,فاستسلموا وحسب
Dialogue: 0,0:21:21.61,0:21:28.22,Default,,0000,0000,0000,,أتمنّى لو كان يوجد شخصٌ مثلك\Nفي الشرطة أو القضاء آنذاك
Dialogue: 0,0:21:28.93,0:21:34.26,Default,,0000,0000,0000,,كان ليجد دليلاً آخراً ويُحاكم ناكاموتو
Dialogue: 0,0:21:38.54,0:21:41.59,Default,,0000,0000,0000,,...بدا من وجه الطبيبة يوكو حينها
Dialogue: 0,0:21:41.59,0:21:43.69,Default,,0000,0000,0000,,أنّ نزعتها الشرّيرة قد غادرتها
Dialogue: 0,0:23:18.82,0:23:22.98,Default,,0000,0000,0000,,لا أزال عاجزاً عن الفهم، لمَ سلّمت نفسها؟
Dialogue: 0,0:23:22.98,0:23:27.10,Default,,0000,0000,0000,,لم تجد الشرطة أيّ دليل البتّة
Dialogue: 0,0:23:27.10,0:23:30.77,Default,,0000,0000,0000,,ليس ذلك فقط، لم يكتشفوا حيلتها حتّى
Dialogue: 0,0:23:30.77,0:23:36.18,Default,,0000,0000,0000,,ربما أرادت أن يُقبض عليها \Nلنسبةٍ ما من البداية
Dialogue: 0,0:23:36.47,0:23:40.76,Default,,0000,0000,0000,,لذا استعملت أيومي-تشان لتشهد بحجّة غيابها
Dialogue: 0,0:23:40.76,0:23:43.02,Default,,0000,0000,0000,,فقد سمعت عنك من أيومي-تشان
Dialogue: 0,0:23:43.42,0:23:47.72,Default,,0000,0000,0000,,تقصد أنّها أرادتني أن أجد دليلاً؟
Dialogue: 0,0:23:48.54,0:23:53.16,Default,,0000,0000,0000,,أو ربما ساواكي يوكو-سان من قبل 26 عاماً
Dialogue: 0,0:23:53.62,0:23:54.87,Default,,0000,0000,0000,,أرادت مني ذلك
Dialogue: 0,0:24:01.86,0:24:05.29,Default,,0000,0000,0000,,أأنت متأكد أنّها تبحث عنه لأنّها تحبّه؟
Dialogue: 0,0:24:05.76,0:24:08.69,Default,,0000,0000,0000,,...كونان-كن، عليك ألّا تتدخل
Dialogue: 0,0:24:09.50,0:24:12.07,Default,,0000,0000,0000,,...حسناً، أوكايا-سان تعيش في
Dialogue: 0,0:24:12.61,0:24:14.49,Default,,0000,0000,0000,,في عمل أبي
Dialogue: 0,0:24:14.49,0:24:15.04,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:24:15.80,0:24:17.71,Default,,0000,0000,0000,,!أعطني العنوان أيضاً
Dialogue: 0,0:24:17.71,0:24:19.54,Default,,0000,0000,0000,,ماذا؟ لمَ أعطيك؟
Dialogue: 0,0:24:19.54,0:24:22.16,Default,,0000,0000,0000,,!علينا الذهاب سريعاً وإلّا قد يُقتل أحد
Dialogue: 0,0:24:24.71,0:24:26.02,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.15,0:24:28.83,Default,,0000,0000,0000,,جريمة قتل زهرة الصبّار
Dialogue: 0,0:24:45.55,0:24:47.93,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.93,0:24:49.93,Default,,0000,0000,0000,,رسمة شخصيّة
Dialogue: 0,0:24:50.37,0:24:52.61,Default,,0000,0000,0000,,تحوي قضيّة الحلقة القادمة قصّةً\Nحزينة نوعاً ما

