Dialogue: 0,0:00:02.00,0:00:03.74,Default,,0000,0000,0000,,عقرب دقائق مسرِع، شهب ساقطة
Dialogue: 0,0:00:03.74,0:00:07.56,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.56,0:00:10.94,Default,,0000,0000,0000,,!قضيّة اليوم عن أسطورة غربيّة! لا تترك ندماً في استنتاجاتك
Dialogue: 0,0:00:10.94,0:00:12.48,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.48,0:00:14.40,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.40,0:00:16.39,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:59.08,0:02:00.54,Default,,0000,0000,0000,,قصر دراكولا؟
Dialogue: 0,0:02:00.97,0:02:07.40,Default,,0000,0000,0000,,أجل، تتضمّن معظم روايات السيّد دوراكورا\N،مصّاصي الدماء كشخصيات رئيسية
Dialogue: 0,0:02:07.40,0:02:10.46,Default,,0000,0000,0000,,لذا يُلقّب بالسيّد دراكولا
Dialogue: 0,0:02:10.46,0:02:12.44,Default,,0000,0000,0000,,ولذا اسمه قصر دراكولا؟
Dialogue: 0,0:02:12.44,0:02:15.41,Default,,0000,0000,0000,,هل دوراكورا دايسكي روائيّ مشهور؟
Dialogue: 0,0:02:15.72,0:02:19.76,Default,,0000,0000,0000,,إنّه الأكثر شعبيّة في رابطة\Nروايات الرعب اليابانيّة
Dialogue: 0,0:02:19.76,0:02:24.46,Default,,0000,0000,0000,,بدأ يتفرّع لكتابة روايات \Nالخيال البطولية أيضاً
Dialogue: 0,0:02:24.46,0:02:27.09,Default,,0000,0000,0000,,وعدد مُعجباته يرتفع
Dialogue: 0,0:02:27.09,0:02:28.67,Default,,0000,0000,0000,,!أنتَ تعرف الكثير عنه يا أبي
Dialogue: 0,0:02:28.96,0:02:33.28,Default,,0000,0000,0000,,!بالطبع، فأنا متحرٍّ عظيم
Dialogue: 0,0:02:34.74,0:02:35.99,Default,,0000,0000,0000,,ران-نيتشان
Dialogue: 0,0:02:37.58,0:02:40.90,Default,,0000,0000,0000,,"هورور تايمز الشهريّة - إصدار دوراكورا دايسكي الخاصّ"
Dialogue: 0,0:02:42.93,0:02:44.77,Default,,0000,0000,0000,,غششتَ إذاً
Dialogue: 0,0:02:44.77,0:02:45.69,Default,,0000,0000,0000,,!اصمتي
Dialogue: 0,0:02:49.73,0:02:51.67,Default,,0000,0000,0000,,إنّه يظهر، ذاك هو
Dialogue: 0,0:02:53.76,0:02:56.48,Default,,0000,0000,0000,,ذاك قصر دراكولا؟
Dialogue: 0,0:02:58.55,0:03:04.62,Title,,0000,0000,15,,{\fad(300,0)} جريمة قتل قصر دراكولا\N(الجزء الأوّل)
Dialogue: 0,0:02:59.76,0:03:03.17,Default,,0000,0000,0000,,جريمة قتل قصر دراكولا\N(الجزء الأوّل)
Dialogue: 0,0:03:27.03,0:03:28.50,Default,,0000,0000,0000,,أنتَ المتحرّي موري-سان، صحيح؟
Dialogue: 0,0:03:28.50,0:03:28.98,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:28.98,0:03:30.90,Default,,0000,0000,0000,,شكراً لك على قطعك\Nكلّ هذا الطريق
Dialogue: 0,0:03:30.90,0:03:31.88,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:03:32.12,0:03:36.08,CharCard,,0000,0000,0004,,{\fad(300,0)}(تادوكورو توشيا (26\Nطالب لدى دوراكورا دايسكي
Dialogue: 0,0:03:32.43,0:03:36.08,On Top,,0000,0000,0000,,أنا تادوكورو، أدرس تحت جناح دوراكورا سينسي
Dialogue: 0,0:03:36.89,0:03:39.71,Default,,0000,0000,0000,,إنّه بانتظارك، تفضّل من هنا
Dialogue: 0,0:03:45.76,0:03:47.17,Default,,0000,0000,0000,,من تلك المرأة؟
Dialogue: 0,0:03:47.41,0:03:51.13,CharCard,,0000,0000,0004,,{\fad(300,0)}(دوراكورا إيتسوكو (30\Nزوجة دوراكورا دايسكي
Dialogue: 0,0:03:47.55,0:03:51.13,On Top,,0000,0000,0000,,إنّها زوجته
Dialogue: 0,0:03:51.13,0:03:54.95,Default,,0000,0000,0000,,!يا لجمالها! أشعر بالغيرة
Dialogue: 0,0:03:54.95,0:03:56.33,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:03:56.33,0:03:58.25,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:04:02.49,0:04:06.04,Default,,0000,0000,0000,,للقصور القديمة انطباع فريد حقّاً
Dialogue: 0,0:04:06.65,0:04:08.92,Default,,0000,0000,0000,,أشعر بقشعريرة لسببٍ ما
Dialogue: 0,0:04:10.38,0:04:12.48,Default,,0000,0000,0000,,...لذا
Dialogue: 0,0:04:15.81,0:04:17.85,Default,,0000,0000,0000,,...عجباً؟ أهو
Dialogue: 0,0:04:19.31,0:04:22.54,Default,,0000,0000,0000,,أأنت المتحرّي موري كوغورو-سان؟
Dialogue: 0,0:04:22.76,0:04:25.01,Default,,0000,0000,0000,,أجل... صحيح
Dialogue: 0,0:04:25.01,0:04:28.00,Default,,0000,0000,0000,,!كنتُ أعرف! يشرّفني لقاؤك
Dialogue: 0,0:04:28.10,0:04:35.27,CharCard,,0000,0000,0004,,{\fad(300,0)}دوي فوميو\Nرئيس تحرير هورور تايمز الشهريّة
Dialogue: 0,0:04:28.22,0:04:35.16,On Top,,0000,0000,0000,,أنا دوي، رئيس تحرير هورور تايمز \Nالشهرية التابعة لدايغاكّان
Dialogue: 0,0:04:35.54,0:04:37.37,Default,,0000,0000,0000,,...تقصد تلك المجلّة
Dialogue: 0,0:04:38.08,0:04:41.34,Default,,0000,0000,0000,,هكذا إذاً، أنتَ ذاك المتحرّي الشهير؟
Dialogue: 0,0:04:41.63,0:04:47.90,CharCard,,0000,0000,0003,,{\fad(300,0)}(هامورا شويتشي (33\Nباحث في الأدب الشعبيّ لجامعة كانتو الشمالية
Dialogue: 0,0:04:41.79,0:04:43.99,On Top,,0000,0000,0000,,اسمي هامورا شويتشي
Dialogue: 0,0:04:43.99,0:04:47.79,On Top,,0000,0000,0000,,أعمل باحثاً في الأدب الشعبيّ\Nلجامعة كانتو الشمالية
Dialogue: 0,0:04:48.11,0:04:51.25,Default,,0000,0000,0000,,أيّ بحث تقوم به؟
Dialogue: 0,0:04:51.78,0:04:56.21,Default,,0000,0000,0000,,بشكلٍ عام... عن مصّاصي الدماء
Dialogue: 0,0:04:56.52,0:04:59.94,Default,,0000,0000,0000,,...هـ-هذا بحثٌ فريد
Dialogue: 0,0:04:59.94,0:05:02.22,Default,,0000,0000,0000,,بالمناسبة، أين السيّد دوراكورا؟
Dialogue: 0,0:05:02.22,0:05:04.41,Default,,0000,0000,0000,,إنّه في مكتبه يقوم بالكتابة
Dialogue: 0,0:05:07.22,0:05:10.34,Default,,0000,0000,0000,,ذاك... مكتبه؟
Dialogue: 0,0:05:16.46,0:05:18.58,Default,,0000,0000,0000,,إنّه هنا
Dialogue: 0,0:05:23.03,0:05:24.91,Default,,0000,0000,0000,,...ستارة قاتمة
Dialogue: 0,0:05:40.90,0:05:42.83,Default,,0000,0000,0000,,...مجرّد فيلم
Dialogue: 0,0:05:43.39,0:05:45.58,Default,,0000,0000,0000,,أنتَ موري كوغورو-سان؟
Dialogue: 0,0:05:47.84,0:05:50.26,On Top,,0000,0000,0000,,مرحباً بك في قصر دراكولا
Dialogue: 0,0:05:50.02,0:05:53.64,CharCard,,0000,0000,0004,,{\fad(300,0)} (50) دوراكورا دايسكي\Nمؤلف روايات رعب
Dialogue: 0,0:05:50.26,0:05:53.50,On Top,,0000,0000,0000,,أنا دوراكورا دايسكي
Dialogue: 0,0:06:03.16,0:06:06.70,Default,,0000,0000,0000,,الغرف ثمانيّة الأوجه نادرة حقّاً
Dialogue: 0,0:06:06.70,0:06:10.63,Default,,0000,0000,0000,,أترتدي زيّ دراكولا هكذا دائماً؟
Dialogue: 0,0:06:12.21,0:06:18.10,Default,,0000,0000,0000,,بكتابتي وأنا أرتدي ملابس دراكولا\N،وأشغّل أفلام دراكولا
Dialogue: 0,0:06:18.58,0:06:22.56,Default,,0000,0000,0000,,أخرجتُ الكثير من التحف الفنّية لهذا العالم
Dialogue: 0,0:06:24.07,0:06:25.76,Default,,0000,0000,0000,,إذاً، لمَ طلبتني؟
Dialogue: 0,0:06:26.53,0:06:31.10,Default,,0000,0000,0000,,استدعيتُك للتحقيق في سلوك زوجتي إيتسوكو
Dialogue: 0,0:06:32.57,0:06:35.43,Default,,0000,0000,0000,,سلوكها؟ أي تقصد خيانة؟
Dialogue: 0,0:06:35.72,0:06:36.97,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:36.97,0:06:42.06,Default,,0000,0000,0000,,،أريد إيجاد دليل قاطع بخيانتها\Nوهويّة الرجل معها
Dialogue: 0,0:06:43.26,0:06:47.26,Default,,0000,0000,0000,,استدعيتني لهذه الجبال لأحقّق\Nفي خيانة زوجية فحسب؟
Dialogue: 0,0:06:47.71,0:06:52.13,Default,,0000,0000,0000,,سأدفع لك مليون ينّ، وسأغطّي أيّ\Nمصاريف إضافية بالطبع
Dialogue: 0,0:06:52.13,0:06:54.68,Default,,0000,0000,0000,,!بالتأكيد! سأقبل العمل بكلّ سرور
Dialogue: 0,0:06:57.75,0:07:01.31,Default,,0000,0000,0000,,يا للأسف، لم أجلب سلاسلَ للسيّارة
Dialogue: 0,0:07:01.66,0:07:06.51,Default,,0000,0000,0000,,لا تقلق، يمكنك المبيت في قصر دراكولا الليلة
Dialogue: 0,0:07:08.19,0:07:10.47,Default,,0000,0000,0000,,سأقبل دعوتك إذاً
Dialogue: 0,0:07:26.01,0:07:27.22,Default,,0000,0000,0000,,!يا للرائحة الطيّبة
Dialogue: 0,0:07:27.67,0:07:29.56,Default,,0000,0000,0000,,إنّه شاي إكليل جبل منزليّ
Dialogue: 0,0:07:30.13,0:07:34.76,Default,,0000,0000,0000,,!كان العشاء لذيذاً، أنت طاهٍ بارع يا تادوكورو-سان
Dialogue: 0,0:07:35.37,0:07:40.04,Default,,0000,0000,0000,,تستطيع الزوجة التمتّع بحياة هائنة رغيدة بفضله
Dialogue: 0,0:07:40.04,0:07:40.97,Default,,0000,0000,0000,,...هامورا-سان
Dialogue: 0,0:07:41.62,0:07:48.43,Default,,0000,0000,0000,,،لا، أنا أدرس تأليف الروايات عند سينسي\Nفمن الطبيعيّ أن أساعد قدر الاستطاعة
Dialogue: 0,0:07:48.95,0:07:53.73,Default,,0000,0000,0000,,إذاً يا سينسي، أتطلّع لسلسلتك الجديدة\Nالتي ستبدأ الشهر القادم
Dialogue: 0,0:07:53.73,0:07:57.73,Default,,0000,0000,0000,,عليّ إنهاء مخطوطة هذا الشهر قبلها
Dialogue: 0,0:07:57.73,0:08:01.31,Default,,0000,0000,0000,,تادوكورو، اجلب لي نبيذاً وفيلماً لمكتبي
Dialogue: 0,0:08:01.89,0:08:05.01,Default,,0000,0000,0000,,حاضر، أيّ فيلم تريد؟
Dialogue: 0,0:08:06.43,0:08:07.98,Default,,0000,0000,0000,,سأترك ذلك لك
Dialogue: 0,0:08:14.46,0:08:18.12,Default,,0000,0000,0000,,صحيح، ما رأيكما يا ران-سان وكونان-كن بمرافقتي؟
Dialogue: 0,0:08:18.12,0:08:20.17,Default,,0000,0000,0000,,توجد الكثير من الأشياء النادرة لرؤيتها
Dialogue: 0,0:08:20.17,0:08:21.22,Default,,0000,0000,0000,,أشياء نادرة؟
Dialogue: 0,0:08:22.00,0:08:25.32,Default,,0000,0000,0000,,،يقصد "مقتنيات دراكولا" القيّمة لدوراكورا سينسي
Dialogue: 0,0:08:25.32,0:08:28.18,Default,,0000,0000,0000,,المليئة بأدوات وأزياء من أفلام مصّاصي الدماء
Dialogue: 0,0:08:28.91,0:08:30.91,Default,,0000,0000,0000,,!لنذهب يا ران-نيتشان
Dialogue: 0,0:08:30.91,0:08:32.77,Default,,0000,0000,0000,,...أنا سأمتنع
Dialogue: 0,0:08:32.77,0:08:33.72,Default,,0000,0000,0000,,!تعالي
Dialogue: 0,0:08:42.73,0:08:47.72,Default,,0000,0000,0000,,توجد هنا مجموعته الواسعة\Nمن الأدوات والأفلام
Dialogue: 0,0:08:51.84,0:08:53.38,Default,,0000,0000,0000,,أخبرني، أين تؤدي هذه الأدراج؟
Dialogue: 0,0:08:53.71,0:08:56.17,Default,,0000,0000,0000,,توجد مكتبة في القبو
Dialogue: 0,0:08:56.17,0:09:00.35,Default,,0000,0000,0000,,إنّها تعجّ بكتب عن مصّاصي دماء\Nونصوص قديمة من أرجاء العالم
Dialogue: 0,0:09:01.13,0:09:03.30,Default,,0000,0000,0000,,يمكنك تسميتها بمكتبة دراكولا
Dialogue: 0,0:09:08.28,0:09:10.56,Default,,0000,0000,0000,,!قناع دراكولا
Dialogue: 0,0:09:10.56,0:09:12.52,Default,,0000,0000,0000,,!يد دراكولا
Dialogue: 0,0:09:13.94,0:09:15.47,Default,,0000,0000,0000,,!سيف متقاطع
Dialogue: 0,0:09:16.44,0:09:18.18,Default,,0000,0000,0000,,حسناً، سأختار هذا
Dialogue: 0,0:09:19.02,0:09:20.64,Default,,0000,0000,0000,,هل حدّدتَ فيلماً؟
Dialogue: 0,0:09:21.02,0:09:25.51,Default,,0000,0000,0000,,أجل، فيلم بريطانيّ قديم يُدعى\Nبمأدبة الدم الطازج
Dialogue: 0,0:09:25.51,0:09:27.89,Default,,0000,0000,0000,,يحبّه سينسي كثيراً
Dialogue: 0,0:09:27.89,0:09:29.81,Default,,0000,0000,0000,,أترين الوتد الخشبيّ هناك؟
Dialogue: 0,0:09:30.64,0:09:34.82,Default,,0000,0000,0000,,تمّ غرسه في قلب مصّاص الدماء\Nفي المشهد الأخير لهذا الفيلم
Dialogue: 0,0:09:36.34,0:09:41.22,Default,,0000,0000,0000,,لديه في مكتبه الصليب الذي\Nكان مصّاص الدماء مثبّتاً عليه أيضاً
Dialogue: 0,0:09:41.71,0:09:45.24,Default,,0000,0000,0000,,...ماذا؟ أشتمّ رائحة طلاء زيتيّ
Dialogue: 0,0:09:45.24,0:09:47.93,Default,,0000,0000,0000,,غريب، لا توجد لوحات زيتية
Dialogue: 0,0:09:48.58,0:09:50.16,Default,,0000,0000,0000,,هيّا، لنرجع
Dialogue: 0,0:09:50.16,0:09:51.33,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:09:51.33,0:09:52.76,Default,,0000,0000,0000,,ران-سان
Dialogue: 0,0:09:53.44,0:09:56.72,Default,,0000,0000,0000,,المعذرة، لكن هلّا تحقّقتِ من أقفال النوافذ؟
Dialogue: 0,0:09:57.19,0:09:58.71,Default,,0000,0000,0000,,أجل، لا مشكلة
Dialogue: 0,0:10:09.31,0:10:10.35,Default,,0000,0000,0000,,إنّها مقفلة
Dialogue: 0,0:10:11.14,0:10:12.06,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:10:20.21,0:10:22.95,Default,,0000,0000,0000,,ما كان رأيك بمقتنيات دراكولا؟
Dialogue: 0,0:10:22.95,0:10:24.68,Default,,0000,0000,0000,,كانت تبعث على الاشمئزاز نوعاً ما
Dialogue: 0,0:10:32.45,0:10:35.80,Default,,0000,0000,0000,,هامورا-سان، دراكولا مجرّد خيال، صحيح؟
Dialogue: 0,0:10:36.44,0:10:39.36,Default,,0000,0000,0000,,من الصحيح أنّ الدوق دراكولا الذي نعرفه
Dialogue: 0,0:10:39.36,0:10:47.68,Default,,0000,0000,0000,,كان وحشاً من تأليف الروائيّ البريطانيّ\Nبرام ستوكر في روايته عام 1897 المسمّاة دراكولا
Dialogue: 0,0:10:48.18,0:10:52.60,Default,,0000,0000,0000,,لكن كانت هناك مجموعة من النبلاء\Nفي أوروبا العصور الوسطى
Dialogue: 0,0:10:52.60,0:10:56.74,Default,,0000,0000,0000,,خافهم الناس كمصّاصي دماء بسبب\Nالأفعال الشنيعة التي أقدموا عليها
Dialogue: 0,0:10:59.01,0:11:03.79,Default,,0000,0000,0000,,جمع دوراكورا سينسي الكثير من الوثائق \N،القديمة المتعلّقة بذلك
Dialogue: 0,0:11:03.79,0:11:07.89,Default,,0000,0000,0000,,لذا آتي هنا للزيارة والاطّلاع عليها
Dialogue: 0,0:11:23.10,0:11:25.39,Default,,0000,0000,0000,,كونان-كن، أتريد لعب البطاقات؟
Dialogue: 0,0:11:25.39,0:11:26.18,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:11:26.60,0:11:31.14,Default,,0000,0000,0000,,انتظر قليلاً إذاً، سأتأكّد من جميع أقفال البيت
Dialogue: 0,0:11:36.55,0:11:41.89,Default,,0000,0000,0000,,،يبدو تادوكورو-سان لطيفاً جدّاً\Nأيحبّ روايات الرعب بدوره؟
Dialogue: 0,0:11:42.42,0:11:45.84,Default,,0000,0000,0000,,أرجّح أنّه يميل للخيال أكثر
Dialogue: 0,0:11:46.83,0:11:50.37,Default,,0000,0000,0000,,كنتُ أنا من قدّمه لدوراكورا سينسي
Dialogue: 0,0:11:50.37,0:11:52.80,Default,,0000,0000,0000,,فقد بدت موهبته لامعة
Dialogue: 0,0:11:57.49,0:11:59.06,Default,,0000,0000,0000,,لا يزال الثلج يتساقط؟
Dialogue: 0,0:11:59.65,0:12:01.52,Default,,0000,0000,0000,,كلّا، توقّف
Dialogue: 0,0:12:04.98,0:12:08.39,Default,,0000,0000,0000,,هل تريدان لعب البطاقات معنا أيضاً؟
Dialogue: 0,0:12:08.98,0:12:14.55,Default,,0000,0000,0000,,آسفة، أشعر ببعض الصداع\Nلذا سأخلد للنوم
Dialogue: 0,0:12:14.55,0:12:18.39,Default,,0000,0000,0000,,وأريد تصفّح المكتبة أكثر، لذا اعذروني
Dialogue: 0,0:12:28.67,0:12:31.42,Default,,0000,0000,0000,,كونان-كن، لا تماطل والعب ستّة القلوب
Dialogue: 0,0:12:31.42,0:12:32.49,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:12:33.78,0:12:37.20,Default,,0000,0000,0000,,!وكان استنتاجي في محلّه
Dialogue: 0,0:12:40.28,0:12:42.11,Default,,0000,0000,0000,,هل تنضم لنا يا هامورا-سان؟
Dialogue: 0,0:12:42.11,0:12:45.68,Default,,0000,0000,0000,,يحكي موري-سان إنجازاته الكثيرة
Dialogue: 0,0:12:47.58,0:12:48.74,Default,,0000,0000,0000,,يبدو ذلك مثيراً للاهتمام
Dialogue: 0,0:12:50.36,0:12:54.60,Default,,0000,0000,0000,,عليّ الذهاب للحمّام قليلاً، أشعر بتوعّك\Nفي معدتي منذ الصباح
Dialogue: 0,0:12:54.60,0:12:56.60,Default,,0000,0000,0000,,تفضّل
Dialogue: 0,0:12:58.39,0:12:59.77,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:13:10.34,0:13:12.83,Default,,0000,0000,0000,,أبي، سنخلد للنوم الآن
Dialogue: 0,0:13:12.83,0:13:16.92,Default,,0000,0000,0000,,لتناما، هذا وقت البالغين
Dialogue: 0,0:13:16.92,0:13:18.77,Default,,0000,0000,0000,,ماذا؟ غريب
Dialogue: 0,0:13:19.58,0:13:20.44,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:13:21.25,0:13:23.18,Default,,0000,0000,0000,,لا يجيب سينسي على الهاتف
Dialogue: 0,0:13:23.57,0:13:25.91,Default,,0000,0000,0000,,لعلّه غفى
Dialogue: 0,0:13:25.91,0:13:31.40,Default,,0000,0000,0000,,،ذلك غير معقول بالنسبة لسينسي\Nفقد كان السهر والشراب لا يأثّران عليه
Dialogue: 0,0:13:31.91,0:13:33.65,Default,,0000,0000,0000,,سأذهب لتفقّده
Dialogue: 0,0:13:34.74,0:13:36.90,Default,,0000,0000,0000,,سأرافقه إذاً
Dialogue: 0,0:13:37.66,0:13:39.75,Default,,0000,0000,0000,,!سينسي! أجب رجاءً
Dialogue: 0,0:13:39.75,0:13:40.89,Default,,0000,0000,0000,,!دوراكورا سينسي
Dialogue: 0,0:13:40.89,0:13:42.13,Default,,0000,0000,0000,,!سينسي
Dialogue: 0,0:13:43.99,0:13:45.33,Default,,0000,0000,0000,,إنّه مقفل
Dialogue: 0,0:13:46.15,0:13:48.28,Default,,0000,0000,0000,,لمَ هذه الجلبة؟
Dialogue: 0,0:13:48.28,0:13:51.29,Default,,0000,0000,0000,,!سيّدتي! زوجك لا يجيب مهما طرقنا
Dialogue: 0,0:13:51.74,0:13:53.24,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:13:55.64,0:13:57.08,Default,,0000,0000,0000,,أسمع صوت جهاز العرض
Dialogue: 0,0:13:57.56,0:14:01.04,Default,,0000,0000,0000,,لا يمكن! ألا يُفترض أنّ الفيلم\Nقد انتهى بهذا الوقت؟
Dialogue: 0,0:14:01.64,0:14:04.47,Default,,0000,0000,0000,,لنخرج وننادي عليه من النافذة
Dialogue: 0,0:14:04.47,0:14:05.24,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:14:07.42,0:14:08.16,Default,,0000,0000,0000,,!الجوّ بارد
Dialogue: 0,0:14:13.87,0:14:14.95,Default,,0000,0000,0000,,النافذة مفتوحة
Dialogue: 0,0:14:15.29,0:14:17.89,Default,,0000,0000,0000,,!وحده الثلج أمام النافذة به آثار أقدام
Dialogue: 0,0:14:19.33,0:14:20.41,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:14:22.25,0:14:25.11,Default,,0000,0000,0000,,دوراكورا-سان، أأنت هنا؟
Dialogue: 0,0:14:26.53,0:14:28.00,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:14:30.75,0:14:32.28,Default,,0000,0000,0000,,!ما-ما الأمر؟
Dialogue: 0,0:14:32.28,0:14:33.58,Default,,0000,0000,0000,,!ما الذي يجري؟
Dialogue: 0,0:15:01.62,0:15:06.24,Default,,0000,0000,0000,,كلّ النوافذ موصدة باستثناء\Nالتي دخلنا منها
Dialogue: 0,0:15:06.24,0:15:07.37,Default,,0000,0000,0000,,...و
Dialogue: 0,0:15:14.73,0:15:18.54,Default,,0000,0000,0000,,الباب الوحيد مقفل من الداخل
Dialogue: 0,0:15:24.47,0:15:26.83,Default,,0000,0000,0000,,...حاجز مطّاطي
Dialogue: 0,0:15:27.55,0:15:30.79,Default,,0000,0000,0000,,سيكون من المستحيل استعمال \Nخيط لقفله من الخارج
Dialogue: 0,0:15:32.34,0:15:36.24,Default,,0000,0000,0000,,يبدو أنّ القاتل دخل من تلك النافذة
Dialogue: 0,0:15:36.92,0:15:40.71,Default,,0000,0000,0000,,لكن يا موري-سان، كيف وصل القاتل هنا؟
Dialogue: 0,0:15:41.54,0:15:44.57,Default,,0000,0000,0000,,آثار المشي كانت على\Nالثلج أمام النافذة فقط
Dialogue: 0,0:15:44.57,0:15:46.37,Default,,0000,0000,0000,,لم تكن هناك آثار أقدام أخرى
Dialogue: 0,0:15:47.41,0:15:50.37,Default,,0000,0000,0000,,صعود هذا الجرف سيكون مستحيلاً
Dialogue: 0,0:15:50.37,0:15:54.83,Default,,0000,0000,0000,,كما أنّ الأمواج الهائجة في البحيرة\Nستقلب أيّ قارب فوراً
Dialogue: 0,0:15:55.19,0:15:58.19,Default,,0000,0000,0000,,...ما يعني أنّ هذا المكتب
Dialogue: 0,0:15:58.19,0:16:01.62,Default,,0000,0000,0000,,كان بحكم المقفول، حتّى والنافذة مفتوحة
Dialogue: 0,0:16:02.27,0:16:03.12,Default,,0000,0000,0000,,ماذا عن الشرطة؟
Dialogue: 0,0:16:03.12,0:16:04.53,Default,,0000,0000,0000,,لا جدوى
Dialogue: 0,0:16:04.93,0:16:09.43,Default,,0000,0000,0000,,سبّبت العاصفة الثلجية انهياراً مساء اليوم\Nسدّ الطريق المؤدي هنا
Dialogue: 0,0:16:09.43,0:16:12.25,Default,,0000,0000,0000,,قالوا أنّهم لا يستطيعون فتح الطريق حتّى الصباح
Dialogue: 0,0:16:12.92,0:16:16.95,Default,,0000,0000,0000,,يا إلهي... يبدو أنّ عليّ فحص الجثّة بنفسي
Dialogue: 0,0:16:17.71,0:16:20.34,Default,,0000,0000,0000,,يا للمجرم الشنيع
Dialogue: 0,0:16:20.34,0:16:23.32,Default,,0000,0000,0000,,قتله بوتدٍ خشبيّ كما لو كان دراكولا
Dialogue: 0,0:16:25.49,0:16:29.12,Default,,0000,0000,0000,,وثبّت جثّته على صليب فوق ذلك
Dialogue: 0,0:16:29.74,0:16:31.24,Default,,0000,0000,0000,,...تمهل
Dialogue: 0,0:16:31.24,0:16:35.08,Default,,0000,0000,0000,,لمَ حرّك القاتل جهاز العرض\Nوسلّط النور على الجثّة؟
Dialogue: 0,0:16:35.94,0:16:37.60,Default,,0000,0000,0000,,أهناك معنى لهذا؟
Dialogue: 0,0:16:38.90,0:16:41.82,Default,,0000,0000,0000,,كأنّه المشهد الأخير من مأدبة الدم الطازج
Dialogue: 0,0:16:41.82,0:16:43.45,Default,,0000,0000,0000,,مأدبة الدم الطازج؟
Dialogue: 0,0:16:43.97,0:16:46.41,Default,,0000,0000,0000,,!ذاك الفيلم الذي جلبه تادوكورو-سان
Dialogue: 0,0:16:46.81,0:16:48.14,Default,,0000,0000,0000,,!صـ-صحيح
Dialogue: 0,0:16:48.14,0:16:52.37,Default,,0000,0000,0000,,كان فيلم مصّاص دماء\Nالأقرب لقلب دوراكورا سينسي
Dialogue: 0,0:16:52.80,0:16:57.29,Default,,0000,0000,0000,,أي جعل القاتل جريمته تشبه\Nالمشهد الأخير من الفيلم؟
Dialogue: 0,0:17:00.13,0:17:02.28,Default,,0000,0000,0000,,بدأ تصلّب الجثّة
Dialogue: 0,0:17:02.28,0:17:06.49,Default,,0000,0000,0000,,هذا يعني أنّه مضت ساعة\Nعلى موته على الأقل
Dialogue: 0,0:17:06.99,0:17:14.12,Default,,0000,0000,0000,,ما يعني أنّ وقت الجريمة كان بين\Nالتاسعة والحادية عشرة ليلاً عندما كان في مكتبه
Dialogue: 0,0:17:16.53,0:17:18.33,Default,,0000,0000,0000,,يوجد جرح على مؤخرة رأسه
Dialogue: 0,0:17:18.94,0:17:22.32,Default,,0000,0000,0000,,لا بدّ أنّه ضُرب بهذه، يوجد دم عليها
Dialogue: 0,0:17:22.72,0:17:23.97,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:17:23.97,0:17:28.16,Default,,0000,0000,0000,,تم تثبيته بعدما أُفقد وعيه، ثمّ طُعن بالوتد
Dialogue: 0,0:17:28.77,0:17:32.42,Default,,0000,0000,0000,,موري-سان، كان هذا الوتد\N!في غرفة المقتنيات
Dialogue: 0,0:17:32.42,0:17:33.87,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:37.17,0:17:41.42,Default,,0000,0000,0000,,أي أنّ القاتل تسلّل هنا وسرق الوتد
Dialogue: 0,0:17:41.42,0:17:43.28,Default,,0000,0000,0000,,بعدما أتى تادوكورو-سان لأخذ الفيلم
Dialogue: 0,0:17:44.00,0:17:47.16,Default,,0000,0000,0000,,،وبعد تسليم تادوكورو-سان الفيلم في المكتب
Dialogue: 0,0:17:47.16,0:17:49.41,Default,,0000,0000,0000,,قتل المجرم السيّد دوراكورا
Dialogue: 0,0:17:49.41,0:17:50.75,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:51.66,0:17:53.28,Default,,0000,0000,0000,,زالت رائحة الطلاء الزيتيّ
Dialogue: 0,0:17:54.36,0:17:58.33,Default,,0000,0000,0000,,لكن كانت كلّ النوافذ\Nمقفلة من الداخل
Dialogue: 0,0:18:02.03,0:18:04.91,Default,,0000,0000,0000,,لا يوجد ولا أثر أقدام\Nواحد خارج النافذة
Dialogue: 0,0:18:06.14,0:18:09.66,Default,,0000,0000,0000,,!ما يعني أنّ القاتل من الداخل
Dialogue: 0,0:18:17.88,0:18:19.05,Default,,0000,0000,0000,,!انظر يا عمّ
Dialogue: 0,0:18:20.22,0:18:22.17,Default,,0000,0000,0000,,...طرف غصين
Dialogue: 0,0:18:22.83,0:18:25.66,Default,,0000,0000,0000,,!لا علاقة له بالقضيّة
Dialogue: 0,0:18:25.66,0:18:26.37,Default,,0000,0000,0000,,!هامورا-سان
Dialogue: 0,0:18:27.37,0:18:30.37,Default,,0000,0000,0000,,الوحيد الذي كان قادراً على سرقة الوتد
Dialogue: 0,0:18:30.37,0:18:33.78,Default,,0000,0000,0000,,كان أنت بما أنّك كنت\Nتتصفّح في المكتبة
Dialogue: 0,0:18:34.70,0:18:36.79,Default,,0000,0000,0000,,معك حقّ
Dialogue: 0,0:18:37.65,0:18:42.74,Default,,0000,0000,0000,,لكن يا موري-سان، كيف أخذت الوتد للمكتب؟
Dialogue: 0,0:18:43.60,0:18:48.45,Default,,0000,0000,0000,,كان عليّ المرور بغرفة المعيشة حيث كنتم
Dialogue: 0,0:18:48.45,0:18:50.64,Default,,0000,0000,0000,,...ذ-ذلك
Dialogue: 0,0:18:50.64,0:18:52.19,Default,,0000,0000,0000,,!توجد طريقة
Dialogue: 0,0:18:52.19,0:18:52.78,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:18:53.22,0:18:56.38,Default,,0000,0000,0000,,عبر الصعود للطابق العلويّ والمشي\Nعلى سطح الممرّ
Dialogue: 0,0:18:56.38,0:18:58.25,Default,,0000,0000,0000,,يمكنك الذهاب للمكتب هكذا
Dialogue: 0,0:19:00.01,0:19:01.58,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:19:02.01,0:19:05.29,Default,,0000,0000,0000,,!أعرف ذلك دون أن تقول
Dialogue: 0,0:19:06.00,0:19:11.17,Default,,0000,0000,0000,,إذا أردتُ المغادرة فعليّ العبور\Nبغرفة المعيشة مهما حصل
Dialogue: 0,0:19:11.17,0:19:13.24,Default,,0000,0000,0000,,الأمر مستحيلٌ عليّ بأيّ شكل
Dialogue: 0,0:19:13.24,0:19:14.20,Default,,0000,0000,0000,,سيّدتي
Dialogue: 0,0:19:14.95,0:19:15.66,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:19:16.16,0:19:19.35,Default,,0000,0000,0000,,غرفتك فوق غرفة المقتنيات، صحيح؟
Dialogue: 0,0:19:22.27,0:19:25.54,Default,,0000,0000,0000,,سيّدتي، أنتِ شريكة لهامورا-سان، أليس كذلك؟
Dialogue: 0,0:19:25.54,0:19:28.25,Default,,0000,0000,0000,,!ما-ما الذي تقوله يا موري-سان؟
Dialogue: 0,0:19:28.65,0:19:33.20,Default,,0000,0000,0000,,يمكنك إدلاء حبل لنافذة غرفة\Nالمقتنيات من هنا
Dialogue: 0,0:19:33.64,0:19:37.14,Default,,0000,0000,0000,,استعمله هامورا-سان للتسلّق لغرفتك
Dialogue: 0,0:19:37.14,0:19:40.39,Default,,0000,0000,0000,,ثمّ عبر سطح الممرّ للوصول إلى المكتب
Dialogue: 0,0:19:40.39,0:19:44.78,Default,,0000,0000,0000,,صعد سطح المكتب بعدها\Nونزل أمام تلك النافذة
Dialogue: 0,0:19:45.03,0:19:48.37,Default,,0000,0000,0000,,،ثمّ نادى على السيّد دوراكورا ليُدخله
Dialogue: 0,0:19:48.37,0:19:50.58,Default,,0000,0000,0000,,وانتظر فرصته وقتله
Dialogue: 0,0:19:50.92,0:19:54.32,Default,,0000,0000,0000,,استعمل نفس المسار للعودة
Dialogue: 0,0:19:54.95,0:19:56.24,Default,,0000,0000,0000,,أأنا مخطئ؟
Dialogue: 0,0:19:56.95,0:19:58.70,Default,,0000,0000,0000,,!يا للسخافة
Dialogue: 0,0:19:58.70,0:20:02.95,Default,,0000,0000,0000,,لمَ أتواطأ مع هامورا-سان لقتل زوجي؟
Dialogue: 0,0:20:03.23,0:20:06.91,Default,,0000,0000,0000,,كان السيّد دوراكورا يشتبه بخيانتك
Dialogue: 0,0:20:07.36,0:20:11.62,Default,,0000,0000,0000,,سيّدتي، هل شريكك العاطفيّ هامورا-سان؟
Dialogue: 0,0:20:11.62,0:20:14.10,Default,,0000,0000,0000,,...أ-أيّ دليل لديك
Dialogue: 0,0:20:14.10,0:20:16.68,Default,,0000,0000,0000,,إيتسوكو، لنتجنّب التستّر على الحقيقة
Dialogue: 0,0:20:16.68,0:20:18.14,Default,,0000,0000,0000,,هامورا-سان
Dialogue: 0,0:20:18.14,0:20:21.33,Default,,0000,0000,0000,,ستكتشف الشرطة فورما تبدأ التحقيق بأيّ حال
Dialogue: 0,0:20:21.33,0:20:23.78,Default,,0000,0000,0000,,تعترف إذاً؟
Dialogue: 0,0:20:24.42,0:20:28.91,Default,,0000,0000,0000,,أجل، لكنّنا نحبّ بعضنا صدقاً
Dialogue: 0,0:20:29.25,0:20:32.58,Default,,0000,0000,0000,,أجل! هامورا-سان هو الوحيد\N!الذي أحبّه
Dialogue: 0,0:20:32.58,0:20:35.12,Default,,0000,0000,0000,,!لم يسبق وأن أحببتُ دوراكورا
Dialogue: 0,0:20:35.49,0:20:37.54,Default,,0000,0000,0000,,لمَ تزوّجتِه إذاً؟
Dialogue: 0,0:20:42.36,0:20:46.69,Default,,0000,0000,0000,,قبل ثمانية أعوام، انهارت شركة أبي
Dialogue: 0,0:20:46.69,0:20:49.08,Default,,0000,0000,0000,,وكانت على وشك الإفلاس
Dialogue: 0,0:20:50.07,0:20:52.72,Default,,0000,0000,0000,,كان دوراكورا أحد معارف أبي القدماء
Dialogue: 0,0:20:52.72,0:20:55.56,Default,,0000,0000,0000,,،ومقابل تمويل الشركة
Dialogue: 0,0:20:55.56,0:21:00.56,Default,,0000,0000,0000,,طلب يدي للزواج فورما\Nتخرّجتُ من الجامعة
Dialogue: 0,0:21:00.56,0:21:02.21,Default,,0000,0000,0000,,،إذا أفلست الشركة
Dialogue: 0,0:21:02.21,0:21:04.74,Default,,0000,0000,0000,,!سيعاني الكثير من الموظّفين وعائلاتهم
Dialogue: 0,0:21:05.13,0:21:08.20,Default,,0000,0000,0000,,...لذا لم يكن بيدي خيار
Dialogue: 0,0:21:08.71,0:21:12.70,Default,,0000,0000,0000,,أدركنا لاحقاً أنّ انهيار الشركة
Dialogue: 0,0:21:12.70,0:21:16.54,Default,,0000,0000,0000,,بسبب مكر دوراكورا وراء الكواليس
Dialogue: 0,0:21:16.54,0:21:21.74,Default,,0000,0000,0000,,لكن عند اكتشافنا ذلك، كانت الشركة باسمه بالفعل
Dialogue: 0,0:21:21.74,0:21:24.62,Default,,0000,0000,0000,,...وهدّد بإسقاطها إذا تطلّقنا
Dialogue: 0,0:21:24.62,0:21:26.58,Default,,0000,0000,0000,,...لا يُعقل
Dialogue: 0,0:21:27.15,0:21:28.69,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:21:28.69,0:21:34.35,Default,,0000,0000,0000,,إذا مات السيّد دوراكورا، سترث زوجته الشركة
Dialogue: 0,0:21:34.35,0:21:35.33,Default,,0000,0000,0000,,...لذا
Dialogue: 0,0:21:35.33,0:21:38.04,Default,,0000,0000,0000,,!كلا! لم يكن نحن
Dialogue: 0,0:21:39.18,0:21:43.49,Default,,0000,0000,0000,,ألديك دليلٌ على أنّنا قتلناه؟
Dialogue: 0,0:21:44.13,0:21:47.95,Default,,0000,0000,0000,,حسنٌ، إذا كنتما تنكران لهذا الحدّ فسأريكما
Dialogue: 0,0:21:49.76,0:21:55.33,Default,,0000,0000,0000,,غادرت غرفة السيّدة ونزلت لسطح\Nالممرّ من نافذة الرواق هذه
Dialogue: 0,0:21:55.33,0:21:56.62,Default,,0000,0000,0000,,وذهبتَ للمكتب
Dialogue: 0,0:21:57.08,0:21:59.58,Default,,0000,0000,0000,,!العمّ حادٌ اليوم
Dialogue: 0,0:21:59.83,0:22:03.87,Default,,0000,0000,0000,,لذا لا تزال آثار أقدام هامورا-سان\N!على السطح هنا
Dialogue: 0,0:22:06.83,0:22:09.25,Default,,0000,0000,0000,,!لـ-ليست هنا! لا آثار
Dialogue: 0,0:22:09.57,0:22:11.00,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:22:13.31,0:22:15.16,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:22:15.98,0:22:17.89,Default,,0000,0000,0000,,!لا يوجد أيّ أثر أقدام
Dialogue: 0,0:22:17.89,0:22:23.62,Default,,0000,0000,0000,,مع عدم إمكانيّة استعمال الممرّ\N!كان هذا السطح هو الطريق الوحيد للمكتب
Dialogue: 0,0:22:24.47,0:22:29.08,Default,,0000,0000,0000,,...أيمكن أنّ القاتل طار في السماء حقّاً
Dialogue: 0,0:22:30.24,0:22:32.01,Default,,0000,0000,0000,,مثل مصّاص دماء
Dialogue: 0,0:24:00.75,0:24:03.65,Default,,0000,0000,0000,,دع الباقي لي يا عمّ
Dialogue: 0,0:24:06.61,0:24:11.98,Default,,0000,0000,0000,,بدايةً، ظننتُ أنّ هامورا-سان هو\N،الوحيد القادر على أخذ الوتد
Dialogue: 0,0:24:11.98,0:24:16.19,Default,,0000,0000,0000,,لكن كان يمكن لأيّ أحد سرقته\Nمن الخارج في الواقع
Dialogue: 0,0:24:16.48,0:24:17.86,Default,,0000,0000,0000,,لأيّ أحد؟
Dialogue: 0,0:24:17.86,0:24:22.32,Default,,0000,0000,0000,,لم تكن هناك آثار أقدام\Nلأنّ القاتل مشى على الهواء
Dialogue: 0,0:24:22.51,0:24:24.23,Default,,0000,0000,0000,,مشى على الهواء؟
Dialogue: 0,0:24:24.24,0:24:30.24,On Top,,0000,0000,0000,,جريمة قتل قصر دراكولا\N(الجزء الثاني)
Dialogue: 0,0:24:24.97,0:24:26.45,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.46,0:24:30.12,Default,,0000,0000,0000,,جريمة قتل قصر دراكولا\N(الجزء الثاني)
Dialogue: 0,0:24:46.06,0:24:48.34,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.34,0:24:50.24,Default,,0000,0000,0000,,طلاء تلوين
Dialogue: 0,0:24:50.24,0:24:52.49,Default,,0000,0000,0000,,!في الحلقة القادمة سيبرع أبي باستنتاجاته
Dialogue: 0,0:24:52.49,0:24:54.49,Default,,0000,0000,0000,,ألا تقصدين يبرع بنومه؟

