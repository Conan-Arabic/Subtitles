Dialogue: 0,0:00:00.87,0:00:02.58,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.58,0:00:05.43,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.43,0:00:08.72,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل مُتحرٍّ عظيم
Dialogue: 0,0:00:08.72,0:00:11.67,Default,,0000,0000,0000,,!قضيّة اليوم شفرة! معنى عميق وراء أرقام عادية
Dialogue: 0,0:00:11.88,0:00:13.63,Default,,0000,0000,0000,,سيكون عليّ تغيير منظوري للأشياء
Dialogue: 0,0:00:13.63,0:00:15.80,Default,,0000,0000,0000,,!والحقيقة واحدة دوماً
Dialogue: 0,0:01:47.00,0:01:50.03,Default,,0000,0000,0000,,قضيّة رسالة القناص الغامضة
Dialogue: 0,0:02:04.11,0:02:05.65,Default,,0000,0000,0000,,!هناك سمك! الآن
Dialogue: 0,0:02:07.56,0:02:08.73,Default,,0000,0000,0000,,!فعلتُها
Dialogue: 0,0:02:08.73,0:02:10.73,Default,,0000,0000,0000,,...هربت مجدداً
Dialogue: 0,0:02:13.69,0:02:15.37,Default,,0000,0000,0000,,اصطدنا الكثير
Dialogue: 0,0:02:15.37,0:02:16.01,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:16.01,0:02:18.65,Default,,0000,0000,0000,,كان غينتا-كن محقاً، هذا موقع مثاليّ للصيد
Dialogue: 0,0:02:20.54,0:02:23.42,Default,,0000,0000,0000,,أشعر بالجوع، ما الوقت الآن؟
Dialogue: 0,0:02:23.42,0:02:26.79,Default,,0000,0000,0000,,إنّها تمام الواحدة ظهراً، هل نتناول الغداء؟
Dialogue: 0,0:02:26.79,0:02:28.35,Default,,0000,0000,0000,,ما ذاك؟
Dialogue: 0,0:02:37.90,0:02:39.57,Default,,0000,0000,0000,,يبدو قارباً بالتحكم عن بعد
Dialogue: 0,0:02:39.57,0:02:41.11,Default,,0000,0000,0000,,من أين يُتحكم به؟
Dialogue: 0,0:02:54.72,0:02:55.93,Default,,0000,0000,0000,,!بندقية
Dialogue: 0,0:02:58.18,0:03:01.77,Default,,0000,0000,0000,,في الأعلى! يوجد أشخاص فوق البناء على\N!الجانب الآخر للنهر
Dialogue: 0,0:03:09.70,0:03:11.86,Default,,0000,0000,0000,,!دعني أرى يا كونان
Dialogue: 0,0:03:13.49,0:03:14.99,Default,,0000,0000,0000,,لا يوجد أحد
Dialogue: 0,0:03:18.27,0:03:21.78,Default,,0000,0000,0000,,!هل أطلق ذاك الرجل ببندقية حقاً؟
Dialogue: 0,0:03:31.31,0:03:34.39,Default,,0000,0000,0000,,مُذهل، أصاب البالون من هذا المكان؟
Dialogue: 0,0:03:34.39,0:03:36.65,Default,,0000,0000,0000,,سيكون بارعاً جاداً إن فعل
Dialogue: 0,0:03:41.71,0:03:44.67,Default,,0000,0000,0000,,ربما كان يتمرن على القنص
Dialogue: 0,0:03:44.67,0:03:46.71,Default,,0000,0000,0000,,...أو يُختبر
Dialogue: 0,0:03:46.71,0:03:47.71,Default,,0000,0000,0000,,يُختبر؟
Dialogue: 0,0:03:47.71,0:03:49.23,Default,,0000,0000,0000,,بخلاف إرادته
Dialogue: 0,0:03:49.50,0:03:50.70,Default,,0000,0000,0000,,بخلاف إرادته؟
Dialogue: 0,0:03:50.70,0:03:54.03,Default,,0000,0000,0000,,كان هناك اثنان آخران يصوبان مسدّسات نحوه
Dialogue: 0,0:03:54.54,0:03:55.53,Default,,0000,0000,0000,,صدقاً؟
Dialogue: 0,0:04:00.99,0:04:02.11,Default,,0000,0000,0000,,ما الذي تفعله؟
Dialogue: 0,0:04:02.11,0:04:04.53,Default,,0000,0000,0000,,أبحث عن ما قد يكون دليلاً
Dialogue: 0,0:04:19.92,0:04:22.52,Default,,0000,0000,0000,,ما خطب هذه الأرقام؟
Dialogue: 0,0:04:22.93,0:04:27.87,Default,,0000,0000,0000,,إنّها رسالة تركها صاحب البندقية لي غالباً
Dialogue: 0,0:04:27.87,0:04:29.48,Default,,0000,0000,0000,,رسالة؟
Dialogue: 0,0:04:29.99,0:04:34.57,Default,,0000,0000,0000,,أجل، بدا أنّه لاحظني عندما رأيتُه بالمنظار المبكر
Dialogue: 0,0:04:36.91,0:04:40.23,Default,,0000,0000,0000,,لكن ما يمكن أن تعنيه هذه الأرقام؟
Dialogue: 0,0:04:45.48,0:04:48.23,Default,,0000,0000,0000,,!علينا إخبار المفتش ميغوري بأيّ حال
Dialogue: 0,0:05:01.42,0:05:04.25,Default,,0000,0000,0000,,أأنت واثق أنّه أصاب الهدف من هنا؟
Dialogue: 0,0:05:04.25,0:05:08.74,Default,,0000,0000,0000,,أجل، لم أره يطلق، لكن رأيته يحمل البندقية
Dialogue: 0,0:05:08.74,0:05:11.27,Default,,0000,0000,0000,,ثمّ وجدت الآلة الحاسبة التي تركها؟
Dialogue: 0,0:05:11.57,0:05:13.53,Default,,0000,0000,0000,,...حضرة المفتش، أيمكن
Dialogue: 0,0:05:13.53,0:05:18.02,Default,,0000,0000,0000,,أنّه اُختطف وُجرّ إلى هنا؟
Dialogue: 0,0:05:18.02,0:05:20.19,Default,,0000,0000,0000,,بدا أنّه يطلق رغماً عنه
Dialogue: 0,0:05:21.90,0:05:26.44,Default,,0000,0000,0000,,لكن لم نتلق أيّ تقارير مشابهة
Dialogue: 0,0:05:26.44,0:05:28.15,Default,,0000,0000,0000,,...ولا أرى أيّ علامات على وجوده هنا أيضاً
Dialogue: 0,0:05:28.51,0:05:33.60,Default,,0000,0000,0000,,!ماذا؟! ابحث بإمعان أكثر إذاً\Nمقابل النهر أو داخله
Dialogue: 0,0:05:33.60,0:05:35.43,Default,,0000,0000,0000,,!ستجد الرصاصة في مكان حتماً
Dialogue: 0,0:05:35.43,0:05:38.60,Default,,0000,0000,0000,,...أجل! قد يكون قارب التحكم عن بعد ذاك أيضاً
Dialogue: 0,0:05:39.09,0:05:41.92,Default,,0000,0000,0000,,نحن في الأسبوع الذهبيّ للأسف
Dialogue: 0,0:05:41.92,0:05:44.75,Default,,0000,0000,0000,,الكثير من محققينا في إجازة
Dialogue: 0,0:05:44.75,0:05:49.56,Default,,0000,0000,0000,,ما رأيكم بهذا، سأفحص تلك الآلة \Nالحاسبة على الأقل، ما قولك؟
Dialogue: 0,0:05:54.24,0:05:57.73,Default,,0000,0000,0000,,أراكم لاحقاً إذاً، أوصلوا تحيّتي لموري-كن
Dialogue: 0,0:05:59.69,0:06:02.44,Default,,0000,0000,0000,,!لا يصدقنا ذاك المُسن أبداً
Dialogue: 0,0:06:15.43,0:06:18.30,Default,,0000,0000,0000,,رحلة أحلام عاطفية على متن قطار" \Nهيسي السريع"، يا للهراء
Dialogue: 0,0:06:18.30,0:06:20.21,Default,,0000,0000,0000,,كلّ ما فعلوه هو سرقة صورة قديمة
Dialogue: 0,0:06:22.67,0:06:24.32,Default,,0000,0000,0000,,!لا جدوى، لا يمكنني حلّها
Dialogue: 0,0:06:24.84,0:06:27.74,Default,,0000,0000,0000,,بالطبع، لا رسالة هناك
Dialogue: 0,0:06:27.74,0:06:29.95,Default,,0000,0000,0000,,نسي أحدهم آلته الحاسبة فقط
Dialogue: 0,0:06:31.41,0:06:34.32,Default,,0000,0000,0000,,يا إلهي، لا أصدّق أنك استدعيت المفتش ميغوري
Dialogue: 0,0:06:34.32,0:06:35.24,Default,,0000,0000,0000,,!في الأسبوع الذهبي
Dialogue: 0,0:06:35.74,0:06:36.57,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:06:37.29,0:06:41.28,Default,,0000,0000,0000,,...إن كان ذاك الرجل مُجبراً على تمرين قنص حقاً
Dialogue: 0,0:06:41.28,0:06:43.86,Default,,0000,0000,0000,,،وترك لك رسالة
Dialogue: 0,0:06:43.86,0:06:45.57,Default,,0000,0000,0000,,...فما يمكنني التفكير به
Dialogue: 0,0:06:45.57,0:06:47.89,Default,,0000,0000,0000,,،الزمان والمكان اللّذان سيجري فيهما القنص الحقيقيّ
Dialogue: 0,0:06:47.89,0:06:49.48,Default,,0000,0000,0000,,...أو اسم الضحيّة
Dialogue: 0,0:06:50.27,0:06:53.72,Default,,0000,0000,0000,,أو ربما تلميح لمكان احتجازه
Dialogue: 0,0:06:53.72,0:06:56.95,Default,,0000,0000,0000,,يلعب الناس ألعاب شفرات على\N!أجهزة إشعارهم طوال الوقت! ألعاب أرقام
Dialogue: 0,0:06:57.43,0:07:02.76,Default,,0000,0000,0000,,بما أنّ 3135134 يمكن أن تُقرأ\Nكأسماء يابانية
Dialogue: 0,0:07:02.76,0:07:06.32,Default,,0000,0000,0000,,فالضحيّتان سيكونان 31-سان و51-سان؟
Dialogue: 0,0:07:08.58,0:07:10.25,Default,,0000,0000,0000,,أجل، أيّاً يكن
Dialogue: 0,0:07:10.25,0:07:14.36,Default,,0000,0000,0000,,اسمع، قد تكون 162 رقم شقّة أو غرفة فندق
Dialogue: 0,0:07:14.83,0:07:17.61,Default,,0000,0000,0000,,أو ربما طريق
Dialogue: 0,0:07:17.61,0:07:20.15,Default,,0000,0000,0000,,مثل الطريق 162
Dialogue: 0,0:07:25.36,0:07:30.06,Default,,0000,0000,0000,,ما الذي ترمز له 3135134 إذاً؟
Dialogue: 0,0:07:30.06,0:07:34.90,Default,,0000,0000,0000,,ربما كانت تغطيةً على 162
Dialogue: 0,0:07:34.90,0:07:36.74,Default,,0000,0000,0000,,.في حال وجد المختطفون الآلة الحاسبة
Dialogue: 0,0:07:37.27,0:07:41.67,Default,,0000,0000,0000,,...فهمت، كان شكل النهر كشكل طريق بالتفكير في الأمر
Dialogue: 0,0:07:41.67,0:07:44.69,Default,,0000,0000,0000,,وسيله يشبه سيل السيّارات
Dialogue: 0,0:07:49.41,0:07:51.75,Default,,0000,0000,0000,,...الطريق 162
Dialogue: 0,0:07:52.66,0:07:53.44,Default,,0000,0000,0000,,!كيوتو
Dialogue: 0,0:07:53.87,0:07:57.53,Default,,0000,0000,0000,,بعيد جدّاً، يجب أن يكون في منطقة طوكيو على الأقل
Dialogue: 0,0:07:57.53,0:07:59.40,Default,,0000,0000,0000,,سيكون خطّاً محلياً سريعاً رئيسياً
Dialogue: 0,0:08:00.20,0:08:03.19,Default,,0000,0000,0000,,!ها هو! طريق محافظة سايتاما 162
Dialogue: 0,0:08:03.99,0:08:06.32,Default,,0000,0000,0000,,!وجدته يا كونان-كن
Dialogue: 0,0:08:06.32,0:08:08.15,Default,,0000,0000,0000,,!ها هو يا أبي! يمكنك أخذنا غداً
Dialogue: 0,0:08:08.73,0:08:10.54,Default,,0000,0000,0000,,آخذكما؟ ماذا؟
Dialogue: 0,0:08:18.01,0:08:22.43,Default,,0000,0000,0000,,يا إلهي، لمَ كان عليّ استئجار سيّارة وإيصالكما؟
Dialogue: 0,0:08:22.43,0:08:24.40,Default,,0000,0000,0000,,لأنّنا لا نملك رخص قيادة
Dialogue: 0,0:08:24.80,0:08:29.29,Default,,0000,0000,0000,,إنّه مُتحرٍّ، صحيح؟ فلمَ لا يملك سيارته الخاصة؟
Dialogue: 0,0:08:29.29,0:08:30.87,Default,,0000,0000,0000,,لا يمكنه شراء واحدة
Dialogue: 0,0:08:30.87,0:08:33.42,Default,,0000,0000,0000,,يبدو أنّه لا يقود كثيراً في العادة
Dialogue: 0,0:08:33.42,0:08:35.43,Default,,0000,0000,0000,,!علينا ربط أحزمة الأمان
Dialogue: 0,0:08:35.43,0:08:36.24,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:08:37.04,0:08:38.77,Default,,0000,0000,0000,,...أنتم! اسمعوا
Dialogue: 0,0:08:38.77,0:08:40.31,Default,,0000,0000,0000,,عينيك على الطريق
Dialogue: 0,0:08:47.94,0:08:49.69,Default,,0000,0000,0000,,الالتفاف مختلف الشكل
Dialogue: 0,0:08:50.65,0:08:51.61,Default,,0000,0000,0000,,ليس هذا المكان
Dialogue: 0,0:08:54.06,0:08:54.94,Default,,0000,0000,0000,,ولا هذا
Dialogue: 0,0:08:56.56,0:08:58.10,Default,,0000,0000,0000,,ليس هذا أيضاً
Dialogue: 0,0:08:58.60,0:09:00.27,Default,,0000,0000,0000,,لا يبدو أنّه هذا أيضاً
Dialogue: 0,0:09:01.09,0:09:02.73,Default,,0000,0000,0000,,ليس هذا
Dialogue: 0,0:09:03.26,0:09:05.59,Default,,0000,0000,0000,,استسلموا فقط
Dialogue: 0,0:09:05.59,0:09:09.56,Default,,0000,0000,0000,,ليس من العقل أن تعتقدوا أن يطابق\Nشكل نهرٍ شارعاً
Dialogue: 0,0:09:09.79,0:09:14.92,Default,,0000,0000,0000,,ماذا؟ كنتَ من قال أنّ سيل النهر\N!يشبه سيل السيّارات
Dialogue: 0,0:09:14.92,0:09:15.99,Default,,0000,0000,0000,,أفعلت؟
Dialogue: 0,0:09:22.91,0:09:26.07,Default,,0000,0000,0000,,لم تبق أيّ التفافات لتفقدها، صحيح؟
Dialogue: 0,0:09:26.07,0:09:29.40,Default,,0000,0000,0000,,...سأنعطف هنا و
Dialogue: 0,0:09:30.56,0:09:32.15,Default,,0000,0000,0000,,قيد الإنشاء
Dialogue: 0,0:09:40.35,0:09:41.36,Default,,0000,0000,0000,,!توقف! توقف
Dialogue: 0,0:09:45.76,0:09:46.40,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:09:57.09,0:09:57.98,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:09:58.53,0:10:01.94,Default,,0000,0000,0000,,!هذا البناء على الطريق 162 أيضاً
Dialogue: 0,0:10:17.56,0:10:18.43,Default,,0000,0000,0000,,!هذا هو المكان
Dialogue: 0,0:10:18.43,0:10:19.67,Default,,0000,0000,0000,,!معك حق
Dialogue: 0,0:10:19.67,0:10:20.72,Default,,0000,0000,0000,,!هو حتماً
Dialogue: 0,0:10:20.72,0:10:21.61,Default,,0000,0000,0000,,!أحسنت يا كونان
Dialogue: 0,0:10:22.10,0:10:23.57,Default,,0000,0000,0000,,!ما الخطب؟ وجدتموه؟
Dialogue: 0,0:10:24.47,0:10:27.46,Default,,0000,0000,0000,,يريد منك كونان-كن أن تخبر المفتش ميغوري
Dialogue: 0,0:10:27.46,0:10:28.52,Default,,0000,0000,0000,,لمَ أنا؟
Dialogue: 0,0:10:28.88,0:10:33.98,Default,,0000,0000,0000,,!لأنّ لديك سجّل إنجازات، كما يثق بك
Dialogue: 0,0:10:34.50,0:10:39.58,Default,,0000,0000,0000,,!سجّل إنجازات؟ تعرف الأشياء معقدة الفهم حقاً
Dialogue: 0,0:10:39.58,0:10:41.94,Default,,0000,0000,0000,,!حسناً، لعلّي سأعطيه اتصالاً
Dialogue: 0,0:10:44.12,0:10:45.49,Default,,0000,0000,0000,,أجل، معك ميغوري
Dialogue: 0,0:10:45.49,0:10:47.98,Default,,0000,0000,0000,,!موري-كن! توقيت ممتاز
Dialogue: 0,0:10:47.98,0:10:49.53,Default,,0000,0000,0000,,!تعال لمركز الشرطة فوراً
Dialogue: 0,0:10:49.53,0:10:50.56,Default,,0000,0000,0000,,!كما اجلب كونان-كن معك
Dialogue: 0,0:10:54.73,0:10:57.43,Default,,0000,0000,0000,,هناك سبب واحد لدعوتي لكم هنا
Dialogue: 0,0:10:57.43,0:11:02.14,Default,,0000,0000,0000,,عرفنا أنّ أحد ضبّاطنا الخارجين في عطلة وحبيبته
Dialogue: 0,0:11:02.14,0:11:03.53,Default,,0000,0000,0000,,قد اختفيا
Dialogue: 0,0:11:03.53,0:11:04.63,Default,,0000,0000,0000,,إنّه هذا الرجل
Dialogue: 0,0:11:09.26,0:11:10.23,Default,,0000,0000,0000,,!إنّه هو سيّدي المفتش
Dialogue: 0,0:11:11.09,0:11:12.38,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:11:12.38,0:11:16.92,Default,,0000,0000,0000,,تطابقت بصماته مع التي على الآلة\Nالحاسبة عندما أجرينا فحصاً
Dialogue: 0,0:11:16.92,0:11:19.08,Default,,0000,0000,0000,,اسمه يامابي كويتشي
Dialogue: 0,0:11:19.08,0:11:21.69,Default,,0000,0000,0000,,كان قنّاصاً أولمبياً في السابق
Dialogue: 0,0:11:22.08,0:11:23.57,Default,,0000,0000,0000,,قنّاص؟
Dialogue: 0,0:11:23.91,0:11:28.94,Default,,0000,0000,0000,,اختطفه المجرمون مع حبيبته إيري-سان غالباً
Dialogue: 0,0:11:28.94,0:11:34.78,Default,,0000,0000,0000,,ويهددونه بقتلها إلم يقنص أحداً لهم
Dialogue: 0,0:11:35.40,0:11:38.77,Default,,0000,0000,0000,,ما رآه كونان-كن والبقية كان تمريناً لذلك؟
Dialogue: 0,0:11:39.06,0:11:42.39,Default,,0000,0000,0000,,يبدو أنّ تحليلك أصاب عين الحقيقة
Dialogue: 0,0:11:42.39,0:11:45.73,Default,,0000,0000,0000,,لكن لا تزال أيدينا مقيدة بما \Nأننا نجهل أهم حقيقة
Dialogue: 0,0:11:45.73,0:11:47.69,Default,,0000,0000,0000,,ألا وهي موعد ومكان القنص
Dialogue: 0,0:11:47.69,0:11:50.65,Default,,0000,0000,0000,,!نحن... نعرف المكان
Dialogue: 0,0:11:51.63,0:11:52.48,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:11:57.71,0:11:59.91,Default,,0000,0000,0000,,أجل، إنّه يشبهه فعلاً
Dialogue: 0,0:11:59.91,0:12:02.91,Default,,0000,0000,0000,,يبدو أنّه المكان، بلاء حسن يا صغار
Dialogue: 0,0:12:02.91,0:12:07.16,Default,,0000,0000,0000,,!لا تنس أنّي من قادهم إلى هنا
Dialogue: 0,0:12:07.16,0:12:10.28,Default,,0000,0000,0000,,...لكن لا نزال نجهل موعد الهجوم
Dialogue: 0,0:12:10.28,0:12:11.40,Default,,0000,0000,0000,,...أجل، هذا مؤسف
Dialogue: 0,0:12:13.90,0:12:16.57,Default,,0000,0000,0000,,انفجر البالون عند الواحدة ظهراً تقريباً، صحيح؟
Dialogue: 0,0:12:17.03,0:12:19.89,Default,,0000,0000,0000,,هكذا إذاً، سيكون الواحدة ظهراً\N!موعد الهجوم إذاً
Dialogue: 0,0:12:19.89,0:12:20.98,Default,,0000,0000,0000,,لكن أيّ يوم؟
Dialogue: 0,0:12:20.98,0:12:25.31,Default,,0000,0000,0000,,إنّهم يحتجزون شخصين، لا وقت لهم ليهدروه
Dialogue: 0,0:12:25.31,0:12:26.89,Default,,0000,0000,0000,,!ستجري عمليّة القنص غداً غالباً
Dialogue: 0,0:12:26.89,0:12:28.34,Default,,0000,0000,0000,,!تفكير ممتاز يا موري-كن
Dialogue: 0,0:12:28.34,0:12:30.31,Default,,0000,0000,0000,,!لنقم بالتجهيزات فوراً
Dialogue: 0,0:12:30.68,0:12:32.76,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:12:32.76,0:12:34.19,Default,,0000,0000,0000,,لا شيء
Dialogue: 0,0:12:41.58,0:12:47.53,Default,,0000,0000,0000,,هل ترمز 162 هذه للطريق 162 حقاً؟
Dialogue: 0,0:12:47.53,0:12:50.98,Default,,0000,0000,0000,,لو كنت محله، لأضفت المكان والموعد\Nفي الرسالة بلا شك
Dialogue: 0,0:12:51.32,0:12:52.91,Default,,0000,0000,0000,,...مما يعني
Dialogue: 0,0:12:52.91,0:12:54.20,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:12:54.20,0:12:58.88,Default,,0000,0000,0000,,كيفما نظرت لها، تبقى 3135134 مستعصية الفهم
Dialogue: 0,0:13:06.44,0:13:10.94,Default,,0000,0000,0000,,حسناً، لا تقوموا بأيّ حركة حتى أعطي الأمر
Dialogue: 0,0:13:11.34,0:13:12.02,Default,,0000,0000,0000,,!عُلِم
Dialogue: 0,0:13:12.41,0:13:13.23,Default,,0000,0000,0000,,!عُلِم
Dialogue: 0,0:13:13.84,0:13:17.96,Default,,0000,0000,0000,,لدينا قنّاصو شرطة ومروحية على استعداد عند النهر
Dialogue: 0,0:13:17.96,0:13:19.54,Default,,0000,0000,0000,,التجهيزات مكتملة
Dialogue: 0,0:13:19.54,0:13:21.29,Default,,0000,0000,0000,,،إن كان القنص سيقع عند الواحدة
Dialogue: 0,0:13:21.29,0:13:24.69,Default,,0000,0000,0000,,فسيأتي المجرمون عند 12:00 بأبعد الاحتمالات
Dialogue: 0,0:13:25.29,0:13:27.00,Default,,0000,0000,0000,,...تبقت ساعة
Dialogue: 0,0:13:27.00,0:13:28.56,Default,,0000,0000,0000,,...لكن هلّا وضحت
Dialogue: 0,0:13:31.20,0:13:34.20,Default,,0000,0000,0000,,!أصرّوا على القدوم
Dialogue: 0,0:13:34.20,0:13:38.52,Default,,0000,0000,0000,,!أنتم! إيّاكم ومغادرة السيارة
Dialogue: 0,0:13:38.52,0:13:39.90,Default,,0000,0000,0000,,!ردّكم؟
Dialogue: 0,0:13:40.11,0:13:41.65,Default,,0000,0000,0000,,!نعرف
Dialogue: 0,0:13:40.11,0:13:41.65,Default,,0000,0000,0000,,!نعرف
Dialogue: 0,0:13:42.81,0:13:44.61,Default,,0000,0000,0000,,...أ-أذناي
Dialogue: 0,0:13:51.93,0:13:53.53,Default,,0000,0000,0000,,تبقت 30 دقيقة
Dialogue: 0,0:14:12.74,0:14:15.28,Default,,0000,0000,0000,,هناك خطبٌ ما، لمَ لا يظهرون؟
Dialogue: 0,0:14:17.57,0:14:20.73,Default,,0000,0000,0000,,لعلّ استنتاج كونان-كن كان خاطئاً
Dialogue: 0,0:14:20.73,0:14:21.72,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:21.72,0:14:22.90,Default,,0000,0000,0000,,!بالطبع لا
Dialogue: 0,0:14:22.90,0:14:24.44,Default,,0000,0000,0000,,!بل معه حق
Dialogue: 0,0:14:24.44,0:14:28.19,Default,,0000,0000,0000,,!كان الاستماع لكلام طفل غلطة بالأصل
Dialogue: 0,0:14:28.56,0:14:29.65,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:14:33.22,0:14:34.31,Default,,0000,0000,0000,,...لنرَ
Dialogue: 0,0:14:34.31,0:14:39.52,Default,,0000,0000,0000,,كانت 3135134162، صحيح؟
Dialogue: 0,0:14:39.75,0:14:45.15,Default,,0000,0000,0000,,...ثلاثة، واحد، ثلاثة، خمسة، واحد، ثلاثة، أربعة
Dialogue: 0,0:14:46.75,0:14:48.60,Default,,0000,0000,0000,,!ميتسوهيكو! أعطني إيّاها
Dialogue: 0,0:14:48.60,0:14:49.77,Default,,0000,0000,0000,,حسناَ
Dialogue: 0,0:14:53.20,0:14:55.69,Default,,0000,0000,0000,,!فهمت! هكذا إذاَ
Dialogue: 0,0:14:57.98,0:15:00.44,Default,,0000,0000,0000,,أنت تقلبها يا كونان-كن
Dialogue: 0,0:15:01.94,0:15:03.40,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:15:03.40,0:15:06.15,Default,,0000,0000,0000,,يمكنك قراءة الأرقام حتى عندما\N!تقلب الآلة الحاسبة! غريب
Dialogue: 0,0:15:06.57,0:15:07.97,Default,,0000,0000,0000,,ما الهراء الذي تقوله؟
Dialogue: 0,0:15:07.97,0:15:10.35,Default,,0000,0000,0000,,!انظر! 162 تصبح 291
Dialogue: 0,0:15:10.35,0:15:13.11,Default,,0000,0000,0000,,والبقية كأنّها أحرف إنجليزية
Dialogue: 0,0:15:13.11,0:15:15.07,Default,,0000,0000,0000,,دعني أرى
Dialogue: 0,0:15:15.47,0:15:19.71,Default,,0000,0000,0000,,‏291، هيسي إي
Dialogue: 0,0:15:19.71,0:15:20.52,Default,,0000,0000,0000,,إنّها تُقرأ حقاً
Dialogue: 0,0:15:25.42,0:15:28.65,Default,,0000,0000,0000,,...هيسي إي؟ لحظة، رأيتُ ذلك قبلاً
Dialogue: 0,0:15:29.04,0:15:31.65,Default,,0000,0000,0000,,كان في المجلة التي كنت تنظر لها بالأمس
Dialogue: 0,0:15:35.95,0:15:37.94,Default,,0000,0000,0000,,!قطار هيسي السريع
Dialogue: 0,0:15:37.94,0:15:42.49,Default,,0000,0000,0000,,لحظة، إن كان يُفترض أن تُقرأ هذه الرسالة\Nمقلوبة من البداية
Dialogue: 0,0:15:42.49,0:15:46.69,Default,,0000,0000,0000,,فـ 162 تعني التاسع والعشرين عند 1:00
Dialogue: 0,0:15:46.69,0:15:47.52,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:48.02,0:15:51.06,Default,,0000,0000,0000,,أدرك يامابي-سان حيلة القلب هذه
Dialogue: 0,0:15:51.06,0:15:52.64,Default,,0000,0000,0000,,...وهو معتقل غالباً وحاول ترك
Dialogue: 0,0:15:52.64,0:15:54.99,Default,,0000,0000,0000,,!هذه الرسالة عندما سنحت له هذه الفرصة
Dialogue: 0,0:15:57.42,0:16:00.17,Default,,0000,0000,0000,,!سيّدي المفتش! بسرعة! المروحية
Dialogue: 0,0:16:00.17,0:16:02.30,Default,,0000,0000,0000,,!أجل، صحيح
Dialogue: 0,0:16:07.46,0:16:14.21,Default,,0000,0000,0000,,سيغادر قطار هيسي السريع الرصيف الثاني قريباً
Dialogue: 0,0:16:24.74,0:16:26.11,Default,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:16:26.11,0:16:27.85,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:16:27.85,0:16:28.59,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:16:31.02,0:16:34.48,Default,,0000,0000,0000,,!اجلس قبل تحرك القطار يا أبي
Dialogue: 0,0:16:34.48,0:16:35.28,Default,,0000,0000,0000,,حسناً، سأفعل
Dialogue: 0,0:16:36.31,0:16:38.38,Default,,0000,0000,0000,,الأمور تجري وفق الخطة
Dialogue: 0,0:16:38.38,0:16:40.23,Default,,0000,0000,0000,,إنّه جالس في مقدمة العربة الأمامية
Dialogue: 0,0:17:11.73,0:17:13.32,Default,,0000,0000,0000,,حان الوقت
Dialogue: 0,0:17:21.72,0:17:22.52,Default,,0000,0000,0000,,!أين كونان-كن؟
Dialogue: 0,0:17:22.85,0:17:25.49,Default,,0000,0000,0000,,...ماذا؟! أيمكن أنه
Dialogue: 0,0:17:26.47,0:17:29.00,Default,,0000,0000,0000,,!ماذا؟! متى دخلت؟
Dialogue: 0,0:17:29.00,0:17:32.11,Default,,0000,0000,0000,,!لا يهم! لن نصل في الوقت إلم نسرع
Dialogue: 0,0:17:32.42,0:17:34.94,Default,,0000,0000,0000,,!ليس باليد حيلة، ارتد هذه
Dialogue: 0,0:17:35.42,0:17:37.16,Default,,0000,0000,0000,,!كبيرة
Dialogue: 0,0:17:42.66,0:17:44.53,Default,,0000,0000,0000,,!إنّه خطّ كانيتسو
Dialogue: 0,0:17:44.78,0:17:47.48,Default,,0000,0000,0000,,!حسنٌ، اتبع السكّة شمالاً
Dialogue: 0,0:18:23.49,0:18:24.46,Default,,0000,0000,0000,,...تبقت 3 دقائق
Dialogue: 0,0:18:24.46,0:18:26.24,Default,,0000,0000,0000,,لم نجد التفافاً شبيهاً بالنهر بعد
Dialogue: 0,0:18:32.44,0:18:33.57,Default,,0000,0000,0000,,أتى
Dialogue: 0,0:18:39.39,0:18:43.07,Default,,0000,0000,0000,,تفهم، صحيح؟ إن أقدمت على أمر غريب\Nفستفقد الفتاة حياتها
Dialogue: 0,0:18:59.08,0:19:00.45,Default,,0000,0000,0000,,تبقت دقيقة
Dialogue: 0,0:19:00.45,0:19:01.86,Default,,0000,0000,0000,,!سيّدي المفتش! هناك
Dialogue: 0,0:19:14.73,0:19:16.74,Default,,0000,0000,0000,,!ها هم! اهبط أكثر
Dialogue: 0,0:19:24.64,0:19:26.24,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:19:26.64,0:19:28.30,Default,,0000,0000,0000,,!لا تهتم! أطلق عليهم
Dialogue: 0,0:19:31.09,0:19:32.17,Default,,0000,0000,0000,,!وغد
Dialogue: 0,0:19:35.21,0:19:38.20,Default,,0000,0000,0000,,!توقف وإلّا ستلقى حتفها
Dialogue: 0,0:19:42.29,0:19:44.56,Default,,0000,0000,0000,,!لا تطلق! قد تصيب يامابي
Dialogue: 0,0:19:44.56,0:19:45.07,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:19:51.07,0:19:54.23,Default,,0000,0000,0000,,لا رياح، سرعة المروحية 5 أمتار في الثانية
Dialogue: 0,0:19:54.82,0:19:57.39,Default,,0000,0000,0000,,الضبط المتوسط سيفي بالغرض
Dialogue: 0,0:19:58.98,0:20:01.15,Default,,0000,0000,0000,,المسافة: 30 متراً
Dialogue: 0,0:20:03.40,0:20:04.98,Default,,0000,0000,0000,,!انطلقي
Dialogue: 0,0:20:12.84,0:20:13.80,Default,,0000,0000,0000,,!أصبته
Dialogue: 0,0:20:13.80,0:20:15.61,Default,,0000,0000,0000,,!ما الذي تفعله؟! هذا خطر
Dialogue: 0,0:20:16.17,0:20:17.27,Default,,0000,0000,0000,,!اللعنة
Dialogue: 0,0:20:23.16,0:20:24.94,Default,,0000,0000,0000,,!تبّاً لك
Dialogue: 0,0:20:28.11,0:20:29.52,Default,,0000,0000,0000,,!انتهى الأمر! استسلم
Dialogue: 0,0:20:38.73,0:20:40.06,Default,,0000,0000,0000,,!كويتشي-سان
Dialogue: 0,0:20:40.06,0:20:40.99,Default,,0000,0000,0000,,إيري
Dialogue: 0,0:20:44.89,0:20:50.48,Default,,0000,0000,0000,,إصابة الخوذة له كانت ضربة حظّ حقاً
Dialogue: 0,0:20:51.09,0:20:53.07,Default,,0000,0000,0000,,!خذ، لا تسقطها ثانيةً في طريق العودة
Dialogue: 0,0:20:53.59,0:20:55.68,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:20:55.68,0:20:58.02,Default,,0000,0000,0000,,...يا إلهي، كان ذلك وشيكاً
Dialogue: 0,0:21:06.58,0:21:08.91,Default,,0000,0000,0000,,!أنت بخير! حمداً لله
Dialogue: 0,0:21:08.91,0:21:11.53,Default,,0000,0000,0000,,!كونان! لم يكن ذلك منصفاً\N!أخذت كلّ المتعة
Dialogue: 0,0:21:11.53,0:21:13.36,Default,,0000,0000,0000,,ليس لطيفاً أن تستحوذ على كلّ المجد
Dialogue: 0,0:21:13.36,0:21:14.19,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:15.07,0:21:16.69,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:21:19.27,0:21:20.28,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:21:21.27,0:21:25.78,Default,,0000,0000,0000,,!كونان! يكفي تسللاً دون إذن
Dialogue: 0,0:21:28.39,0:21:30.19,Default,,0000,0000,0000,,!أصابك هذه المرة
Dialogue: 0,0:21:30.64,0:21:33.02,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:23:09.66,0:23:15.24,Default,,0000,0000,0000,,الرجال الذين اُعتقلوا كانوا أعضاء\Nسابقين في حلقة أوني تورا الإجرامية
Dialogue: 0,0:23:15.24,0:23:17.69,Default,,0000,0000,0000,,سجنَ مدّعٍ عام بارع العام الماضي
Dialogue: 0,0:23:18.32,0:23:22.03,Default,,0000,0000,0000,,القائدَ وعدّة مسؤولين رفيعي المستوى في حلقتهم
Dialogue: 0,0:23:22.03,0:23:23.90,Default,,0000,0000,0000,,أُجبر بقية الأعضاء على الانفصال
Dialogue: 0,0:23:23.90,0:23:25.65,Default,,0000,0000,0000,,كانوا يستهدفون ذاك المدّعي إذاً؟
Dialogue: 0,0:23:26.28,0:23:28.89,Default,,0000,0000,0000,,كان في عودته من رحلة مع عائلته
Dialogue: 0,0:23:28.89,0:23:31.18,Default,,0000,0000,0000,,الانتقام كان دافعهم
Dialogue: 0,0:23:31.18,0:23:33.57,Default,,0000,0000,0000,,!لكن كان بلاؤك مذهلاً يا موري-كن
Dialogue: 0,0:23:35.72,0:23:38.01,Default,,0000,0000,0000,,...حسناً، لا أظن أنّي
Dialogue: 0,0:23:38.01,0:23:39.56,Default,,0000,0000,0000,,!قصّرت في عملي
Dialogue: 0,0:23:40.92,0:23:43.63,Default,,0000,0000,0000,,يتصرف كأنّه حلّ القضية بنفسه
Dialogue: 0,0:23:43.63,0:23:47.58,Default,,0000,0000,0000,,لكن سيأخذنا الآن في عطلة\N!لمكان ما حتماً
Dialogue: 0,0:23:47.58,0:23:48.91,Default,,0000,0000,0000,,أين تريد الذهاب يا كونان-كن؟
Dialogue: 0,0:23:48.91,0:23:51.48,Default,,0000,0000,0000,,!ذلك سهل! حديقة الملاهي
Dialogue: 0,0:23:53.54,0:23:57.57,Default,,0000,0000,0000,,...يا إلهي، من العسير التصرف كطفل دوماً
Dialogue: 0,0:24:03.36,0:24:05.44,Default,,0000,0000,0000,,!إنها جثّة
Dialogue: 0,0:24:07.68,0:24:09.65,Default,,0000,0000,0000,,!اختفت! اختفت الجثة
Dialogue: 0,0:24:10.18,0:24:11.68,Default,,0000,0000,0000,,!ليست هنا
Dialogue: 0,0:24:11.68,0:24:12.61,Default,,0000,0000,0000,,مستحيل
Dialogue: 0,0:24:12.98,0:24:14.57,Default,,0000,0000,0000,,لنغادر جميعاً
Dialogue: 0,0:24:14.57,0:24:18.80,Default,,0000,0000,0000,,...انتظر سيّدي المفتش! رأينا حقاً
Dialogue: 0,0:24:18.80,0:24:20.90,Default,,0000,0000,0000,,كنتُ أحمق للوثوق بكم
Dialogue: 0,0:24:21.59,0:24:23.73,Default,,0000,0000,0000,,كلا، الجثّة هنا
Dialogue: 0,0:24:24.72,0:24:25.92,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.92,0:24:28.08,Default,,0000,0000,0000,,جريمة قتل الجثّة المفقودة
Dialogue: 0,0:24:46.15,0:24:48.31,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.31,0:24:49.76,Default,,0000,0000,0000,,هاتف جهاز ردّ آلي
Dialogue: 0,0:24:49.76,0:24:51.76,Default,,0000,0000,0000,,

