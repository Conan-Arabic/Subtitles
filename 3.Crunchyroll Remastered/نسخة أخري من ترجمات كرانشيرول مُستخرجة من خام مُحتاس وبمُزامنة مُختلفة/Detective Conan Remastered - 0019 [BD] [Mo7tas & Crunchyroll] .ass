Dialogue: 0,0:00:01.08,0:00:02.67,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.67,0:00:05.82,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.82,0:00:08.75,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.75,0:00:10.39,Default,,0000,0000,0000,,تجري أحداث قضيّة اليوم\Nفي مبنى شاهق
Dialogue: 0,0:00:10.41,0:00:12.27,Default,,0000,0000,0000,,!تحمل هذه المصاعد جريمة
Dialogue: 0,0:00:12.27,0:00:15.31,Default,,0000,0000,0000,,،حتّى وراء حجاب الأبواب المزدوجة\N!الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.97,0:01:49.56,Default,,0000,0000,0000,,جريمة قتل المصعد
Dialogue: 0,0:02:01.59,0:02:02.59,On Top,,0000,0000,0000,,مخرج طوارئ
Dialogue: 0,0:02:10.17,0:02:12.63,On Top,,0000,0000,0000,,غرفة تبديل الثياب
Dialogue: 0,0:02:29.52,0:02:35.00,Default,,0000,0000,0000,,يا إلهي، لمَ يوجد هذا\Nالاكتظاظ المروري مع أنّ اليوم عطلة؟
Dialogue: 0,0:02:35.67,0:02:38.96,Default,,0000,0000,0000,,ألم يكن من الأسرع استقلال القطار؟
Dialogue: 0,0:02:39.42,0:02:44.59,Default,,0000,0000,0000,,!العمل عارضةً لثياب أشيا-سان... أشبه بالحُلم
Dialogue: 0,0:02:44.59,0:02:48.25,Default,,0000,0000,0000,,أنتِ متأكدة أنّها كانت أشيا إيكو، صحيح؟
Dialogue: 0,0:02:48.25,0:02:49.91,Default,,0000,0000,0000,,...فهي إحدى
Dialogue: 0,0:02:49.91,0:02:53.42,Default,,0000,0000,0000,,أشهر مصممات الأزياء في اليابان
Dialogue: 0,0:02:53.42,0:02:54.98,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:02:55.36,0:03:00.96,Default,,0000,0000,0000,,أليست أشيا إيكو هي\Nمن أُلغي عرض الأزياء خاصتها مؤخراً؟
Dialogue: 0,0:03:01.36,0:03:07.48,Default,,0000,0000,0000,,أجل، يبدو أنّ شركةً منافسة\Nأعلنت عن خطّ أزياء شتوية
Dialogue: 0,0:03:07.48,0:03:10.96,Default,,0000,0000,0000,,يشبه بنسبةٍ كبيرة آخر خطّ\Nكانت ستصدره في عرضها
Dialogue: 0,0:03:10.96,0:03:12.92,Default,,0000,0000,0000,,فلم يكن أمامها خيار سوى إلغاؤه
Dialogue: 0,0:03:13.39,0:03:16.30,Default,,0000,0000,0000,,أنتَ تعرف الكثير عنها يا عمّ
Dialogue: 0,0:03:16.30,0:03:19.29,Default,,0000,0000,0000,,أيمكن أنّك أحد مُعجبي أشيا إيكو؟
Dialogue: 0,0:03:20.13,0:03:22.26,Default,,0000,0000,0000,,أهذا صحيح يا أبي؟
Dialogue: 0,0:03:22.26,0:03:25.21,Default,,0000,0000,0000,,لا تكوني حمقاء! على المتحرّي \Nتوسيع آفاقه دوماً
Dialogue: 0,0:03:25.21,0:03:29.21,Default,,0000,0000,0000,,ليحيط بمختلف جوانب المجتمع
Dialogue: 0,0:03:29.63,0:03:31.88,Default,,0000,0000,0000,,...المجتمع، أجل
Dialogue: 0,0:03:32.66,0:03:34.62,Default,,0000,0000,0000,,ها هو
Dialogue: 0,0:03:37.36,0:03:39.09,Default,,0000,0000,0000,,يا له من مبنى كبير
Dialogue: 0,0:03:41.96,0:03:45.02,Default,,0000,0000,0000,,لن تكون أنت العارض يا عمّ
Dialogue: 0,0:03:45.02,0:03:47.96,Default,,0000,0000,0000,,!أعرف! لا داعي لتثرثر في كلّ ثانية
Dialogue: 0,0:03:50.25,0:03:53.63,Default,,0000,0000,0000,,المعذرة، اسمي موري ران
Dialogue: 0,0:03:53.63,0:03:55.45,Default,,0000,0000,0000,,كنّا بانتظارك
Dialogue: 0,0:03:55.45,0:03:58.87,Default,,0000,0000,0000,,ستعود الرئيسة سريعاً\Nلذا انتظروا هناك من فضلكم
Dialogue: 0,0:03:58.87,0:03:59.88,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:04:02.33,0:04:03.84,Default,,0000,0000,0000,,المكان يعمّه الهدوء
Dialogue: 0,0:04:04.20,0:04:08.92,Default,,0000,0000,0000,,أجل، لا يوجد أشخاص آخرون\Nبما أنّ اليوم عطلة
Dialogue: 0,0:04:10.40,0:04:12.82,Default,,0000,0000,0000,,آسفة يا ران-سان! هل انتظرتِ طويلاً؟
Dialogue: 0,0:04:12.82,0:04:13.77,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:04:15.14,0:04:16.60,Default,,0000,0000,0000,,أخبريني
Dialogue: 0,0:04:16.60,0:04:17.60,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:17.60,0:04:20.38,Default,,0000,0000,0000,,هل حقائب اليد الكبيرة\Nهي الموضة الآن؟
Dialogue: 0,0:04:24.56,0:04:27.34,Default,,0000,0000,0000,,تتمحور حياتها حول ابتكار أحدث الصيحات
Dialogue: 0,0:04:27.34,0:04:28.79,Default,,0000,0000,0000,,ستصبح الموضة بالتأكيد
Dialogue: 0,0:04:31.63,0:04:33.42,Default,,0000,0000,0000,,أعتذر حقاً
Dialogue: 0,0:04:34.00,0:04:36.79,Default,,0000,0000,0000,,هذا أبي وإيدوغاوا كونان-كن
Dialogue: 0,0:04:36.79,0:04:38.75,Default,,0000,0000,0000,,أصرّا على مرافقتي
Dialogue: 0,0:04:40.20,0:04:41.62,Default,,0000,0000,0000,,موري كوغورو معك
Dialogue: 0,0:04:41.62,0:04:43.49,Default,,0000,0000,0000,,...شكراً على منحك ابنتي هذه الفرصة
Dialogue: 0,0:04:43.49,0:04:46.04,Default,,0000,0000,0000,,!موري كوغورو؟! ذاك المتحرّي الشهير؟
Dialogue: 0,0:04:46.44,0:04:49.44,Default,,0000,0000,0000,,!شرف لي أن تعرفني
Dialogue: 0,0:04:49.44,0:04:51.96,Default,,0000,0000,0000,,هذا تعبيرٌ عن تقديري، اقبليه رجاءً
Dialogue: 0,0:04:53.03,0:04:54.53,Default,,0000,0000,0000,,أشيا سينسي؟
Dialogue: 0,0:04:54.53,0:04:56.92,Default,,0000,0000,0000,,آسفة، شكراً لك
Dialogue: 0,0:04:59.52,0:05:00.92,Default,,0000,0000,0000,,صباح الخير
Dialogue: 0,0:05:00.92,0:05:02.35,Default,,0000,0000,0000,,صباح الخير
Dialogue: 0,0:05:02.35,0:05:04.71,Default,,0000,0000,0000,,إنّها سكرتيرتي تانيغوتشي ميكا-سان
Dialogue: 0,0:05:05.17,0:05:06.71,Default,,0000,0000,0000,,أنا تانيغوتشي
Dialogue: 0,0:05:07.55,0:05:11.09,Default,,0000,0000,0000,,هذه موري ران-سان وأبوها كوغورو-سان
Dialogue: 0,0:05:11.09,0:05:11.63,Default,,0000,0000,0000,,...وهذا
Dialogue: 0,0:05:11.96,0:05:13.47,Default,,0000,0000,0000,,إيدوغاوا كونان
Dialogue: 0,0:05:14.30,0:05:16.20,Default,,0000,0000,0000,,أجل، كونان-كن
Dialogue: 0,0:05:16.20,0:05:18.92,Default,,0000,0000,0000,,أعتذر على استدعائك في يوم أحد
Dialogue: 0,0:05:19.70,0:05:24.22,Default,,0000,0000,0000,,لا بأس، سأستقيل في أقرب فرصة
Dialogue: 0,0:05:24.78,0:05:29.67,Default,,0000,0000,0000,,فأصبحتُ مُرغمة على العمل\Nفي عطل نهاية الأسبوع الآن
Dialogue: 0,0:05:30.65,0:05:33.74,Default,,0000,0000,0000,,لا بأس، كما تحبّين
Dialogue: 0,0:05:33.74,0:05:39.50,Default,,0000,0000,0000,,سأذهب لوضع هذه الأزهار\Nفي مكتبي وأرجع بالأوراق
Dialogue: 0,0:05:40.31,0:05:45.38,Default,,0000,0000,0000,,هلّا جلستِ هناك مع أبيك\Nوكونان-كن حتىّ أعود؟
Dialogue: 0,0:05:45.38,0:05:46.33,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:47.38,0:05:51.80,Default,,0000,0000,0000,,ميكا-سان، اذهبي لغرفة تبديل الثياب\Nفي الطابق الثامن وتجهّزي
Dialogue: 0,0:05:52.47,0:05:54.04,Default,,0000,0000,0000,,نراكم قريباً
Dialogue: 0,0:05:56.25,0:06:01.12,Default,,0000,0000,0000,,المعذرة، هل ستستقيل تلك السكرتيرة؟
Dialogue: 0,0:06:01.12,0:06:04.51,Default,,0000,0000,0000,,أجل، يبدو أنّها سلمت رسالة الاستقالة
Dialogue: 0,0:06:06.24,0:06:09.96,Default,,0000,0000,0000,,،تبدوان أنّهما متخاصمتان\Nومع ذلك ضغطت الزرّ عنها
Dialogue: 0,0:06:15.24,0:06:16.42,On Top,,0000,0000,0000,,مصعد مباشر للطابق 15
Dialogue: 0,0:06:21.72,0:06:23.09,On Top,,0000,0000,0000,,مصعد مباشر للطابق 8\N(يتوقف عند كلّ طابق نزولاً)
Dialogue: 0,0:06:23.64,0:06:25.30,Default,,0000,0000,0000,,لننتظر هنا
Dialogue: 0,0:06:25.30,0:06:27.40,Default,,0000,0000,0000,,!لكن عليّ الذهاب للحمام أوّلاً
Dialogue: 0,0:06:27.40,0:06:28.80,Default,,0000,0000,0000,,!أنا أيضاً
Dialogue: 0,0:06:28.80,0:06:30.55,Default,,0000,0000,0000,,!يا إلهي، اذهبا بسرعة
Dialogue: 0,0:06:31.93,0:06:33.51,Default,,0000,0000,0000,,!أشعر بارتياح
Dialogue: 0,0:06:34.01,0:06:35.96,Default,,0000,0000,0000,,هل غسلتما أيديكما كما يجب؟
Dialogue: 0,0:06:40.67,0:06:42.55,Default,,0000,0000,0000,,!إيدا-سان، هناك مشكلة
Dialogue: 0,0:06:43.83,0:06:44.70,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:06:44.70,0:06:49.74,Default,,0000,0000,0000,,اتّصلت بهاتف ميكا-سان الخلوي\Nمن مكتبي لكنها لم تجب
Dialogue: 0,0:06:49.74,0:06:51.16,Default,,0000,0000,0000,,هلّا أتيت للبحث عنها معي؟
Dialogue: 0,0:06:51.16,0:06:51.84,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:06:52.36,0:06:55.79,Default,,0000,0000,0000,,لمَ تنفعل هكذا من مجرّد\Nعدم إجابة أحدهم على هاتفه؟
Dialogue: 0,0:06:56.60,0:06:58.15,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:06:58.15,0:07:01.76,Default,,0000,0000,0000,,المصعد الذي دخلته تانيغوتشي-سان\Nعالق في الطابق الثامن
Dialogue: 0,0:07:03.26,0:07:04.67,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:07:05.22,0:07:10.25,Default,,0000,0000,0000,,لنأخذ هذا المصعد بأيّ حال\Nونتفقد الأمر في الأعلى
Dialogue: 0,0:07:29.61,0:07:30.96,Default,,0000,0000,0000,,ما الخطب يا إيكو-سان؟
Dialogue: 0,0:07:37.04,0:07:38.96,Default,,0000,0000,0000,,...السكرتيرة تانيغوتشي ميكا-سان
Dialogue: 0,0:07:40.56,0:07:43.63,Default,,0000,0000,0000,,!انتظر، توجد آثار أقدام على الأرض
Dialogue: 0,0:07:43.94,0:07:44.92,Default,,0000,0000,0000,,...آثار أقدام
Dialogue: 0,0:07:49.30,0:07:53.01,Default,,0000,0000,0000,,يبدو أنها آثار غبار\Nمن سلالم الطوارئ
Dialogue: 0,0:07:53.01,0:07:54.14,Default,,0000,0000,0000,,!لا بد أنّه لصّ
Dialogue: 0,0:07:54.14,0:07:57.29,Default,,0000,0000,0000,,!تسلل هنا ووجد ميكا-سان وطعنها
Dialogue: 0,0:07:57.96,0:08:02.89,Default,,0000,0000,0000,,كأنّها كانت تعرف بحصول هذا لتانيغوتشي-سان
Dialogue: 0,0:08:04.66,0:08:07.04,Default,,0000,0000,0000,,إيدا-سان، هلّا أوقفتَ الباب؟
Dialogue: 0,0:08:07.04,0:08:07.84,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:18.11,0:08:19.58,Default,,0000,0000,0000,,...لا يُعقل
Dialogue: 0,0:08:26.47,0:08:28.16,Default,,0000,0000,0000,,...آثار الأقدام هذه
Dialogue: 0,0:08:35.59,0:08:38.46,Default,,0000,0000,0000,,طعنة في القلب، ماتت فوراً تقريباً
Dialogue: 0,0:08:38.46,0:08:40.46,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:08:40.46,0:08:43.38,Default,,0000,0000,0000,,طول آثار الأٌقدام هذه 26 سنتيمتر
Dialogue: 0,0:08:43.38,0:08:45.12,Default,,0000,0000,0000,,...ستّة وعشرون سنتيمتر
Dialogue: 0,0:08:45.12,0:08:46.50,Default,,0000,0000,0000,,لا بدّ أنه كان رجلاً
Dialogue: 0,0:08:51.37,0:08:53.24,Default,,0000,0000,0000,,يوجد أثر دم على كتفها
Dialogue: 0,0:08:53.24,0:08:57.96,Default,,0000,0000,0000,,ولم يوجد هذا التجعد على كتف معطفها؟
Dialogue: 0,0:08:58.40,0:09:01.65,Default,,0000,0000,0000,,هل يمكن أن يرتدي عاملٌ\Nفي مجال الموضة شديد الاهتمام بالمظهر
Dialogue: 0,0:09:01.65,0:09:05.37,Default,,0000,0000,0000,,زيّاً بتجعد كهذا؟
Dialogue: 0,0:09:05.89,0:09:09.27,Default,,0000,0000,0000,,والأكثر غرابة هو سقوطها على الأرض
Dialogue: 0,0:09:09.27,0:09:11.84,Default,,0000,0000,0000,,وهي تواجه المصعد
Dialogue: 0,0:09:12.43,0:09:15.67,Default,,0000,0000,0000,,لو طعنها المجرم وهي تغادره
Dialogue: 0,0:09:15.67,0:09:18.76,Default,,0000,0000,0000,,كانت لتسقط داخله
Dialogue: 0,0:09:18.76,0:09:27.25,Default,,0000,0000,0000,,مما يعني أنّ القاتل تعمّد\Nجرّها خارجاً للرواق
Dialogue: 0,0:09:27.25,0:09:30.59,Default,,0000,0000,0000,,لكن لمَ قد يفعل ذلك؟
Dialogue: 0,0:09:35.15,0:09:39.03,Default,,0000,0000,0000,,كنتِ وتانيغوتشي-سان في\Nمصعدين مختلفين، صحيح؟
Dialogue: 0,0:09:39.03,0:09:42.07,Default,,0000,0000,0000,,أجل، صعدتُ ذاك المصعد
Dialogue: 0,0:09:44.98,0:09:47.14,Default,,0000,0000,0000,,الطابق 15؟
Dialogue: 0,0:09:47.14,0:09:49.13,Default,,0000,0000,0000,,يصعد هذا للطابق 15 بلا توقف؟
Dialogue: 0,0:09:49.81,0:09:51.09,Default,,0000,0000,0000,,أجل، صحيح؟
Dialogue: 0,0:09:51.43,0:09:55.83,Default,,0000,0000,0000,,وهذا المصعد في المنتصف\Nهو الذي استقلّته تانيغوتشي ميكا-سان؟
Dialogue: 0,0:09:56.26,0:09:58.47,Default,,0000,0000,0000,,إنّه يصعد دون توقف للطابق الثامن
Dialogue: 0,0:09:58.47,0:10:01.38,Default,,0000,0000,0000,,ثم يمكنه التوقف عند كلّ طابق\Nحتى الطابق 15
Dialogue: 0,0:10:01.97,0:10:04.37,Default,,0000,0000,0000,,والذي صعدناه يتوقف في الطابق الثامن
Dialogue: 0,0:10:04.37,0:10:07.04,Default,,0000,0000,0000,,ثم ينزل مع إمكانية الوقوف عند كلّ طابق
Dialogue: 0,0:10:07.29,0:10:08.46,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:10:08.46,0:10:11.50,Default,,0000,0000,0000,,مصعدان فقط يمكنهما الصعود للطابق 15
Dialogue: 0,0:10:12.12,0:10:16.70,Default,,0000,0000,0000,,كم مضى من الوقت مذ دخلت\Nأشيا-سان المصعد
Dialogue: 0,0:10:16.70,0:10:18.21,Default,,0000,0000,0000,,حتّى رجعت هنا؟
Dialogue: 0,0:10:18.74,0:10:20.03,Default,,0000,0000,0000,,دقيقتان
Dialogue: 0,0:10:20.03,0:10:22.55,Default,,0000,0000,0000,,كلا، أكثر من دقيقة بقليل كما أظن
Dialogue: 0,0:10:23.15,0:10:24.81,Default,,0000,0000,0000,,أقلّ من دقيقتين
Dialogue: 0,0:10:24.81,0:10:25.50,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:10:25.81,0:10:34.02,Default,,0000,0000,0000,,كان مخرج سلالم الطوارئ في\Nالطابق الأوّل غير مقفل
Dialogue: 0,0:10:34.02,0:10:35.29,Default,,0000,0000,0000,,متى قمتم بآخر جولة؟
Dialogue: 0,0:10:35.51,0:10:37.84,Default,,0000,0000,0000,,قبل ساعتين من الحادثة
Dialogue: 0,0:10:37.84,0:10:40.13,Default,,0000,0000,0000,,أنا متأكد أن الباب كان مقفلاً آنذاك
Dialogue: 0,0:10:40.68,0:10:43.68,Default,,0000,0000,0000,,أدخل أو غادر أحدٌ المبنى بعدها؟
Dialogue: 0,0:10:43.68,0:10:47.08,Default,,0000,0000,0000,,لا أحد باستثناء الرئيسة
Dialogue: 0,0:10:47.46,0:10:50.33,Default,,0000,0000,0000,,أجل، كان عليّ تفقد شيءٍ ما
Dialogue: 0,0:10:50.33,0:10:54.23,Default,,0000,0000,0000,,وصلتُ قبل قرابة ساعة \Nوجلست في مكتبي لنصف ساعة
Dialogue: 0,0:10:54.32,0:10:57.53,Default,,0000,0000,0000,,ثمّ غادرت لشرب القهوة
Dialogue: 0,0:10:57.53,0:10:59.45,Default,,0000,0000,0000,,عبر المدخل الرئيسي بالطبع
Dialogue: 0,0:10:59.45,0:11:02.50,Default,,0000,0000,0000,,...حضرة المفتش، كما قالت إيكو-سان
Dialogue: 0,0:11:02.50,0:11:04.50,Default,,0000,0000,0000,,أظنّه عمل سارقٍ تسلل للمبنى
Dialogue: 0,0:11:04.94,0:11:08.69,Default,,0000,0000,0000,,فتح القاتل قفل مخرج طوارئ\Nالطابق الأوّل من الخارج
Dialogue: 0,0:11:08.69,0:11:10.21,Default,,0000,0000,0000,,ثم صعد الأدراج للطابق الثامن
Dialogue: 0,0:11:11.31,0:11:14.17,Default,,0000,0000,0000,,...وعندها بينما كان يمرّ أمام المصاعد
Dialogue: 0,0:11:14.76,0:11:16.33,Default,,0000,0000,0000,,واجه تانيغوتشي-سان
Dialogue: 0,0:11:21.64,0:11:25.79,Default,,0000,0000,0000,,قتلها ثم هرب من الأدراج مجدداً
Dialogue: 0,0:11:28.08,0:11:30.30,Default,,0000,0000,0000,,!حسنٌ، فتّشوا المنطقة المجاورة فوراً
Dialogue: 0,0:11:30.71,0:11:33.84,Default,,0000,0000,0000,,ونحتاج بصماتك أيضاً يا أشيا-سان
Dialogue: 0,0:11:34.17,0:11:36.79,Default,,0000,0000,0000,,!أتقصد أنّي القاتلة أيّها المفتش؟
Dialogue: 0,0:11:37.53,0:11:38.74,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:11:38.74,0:11:41.62,Default,,0000,0000,0000,,هذا للتمييز بين بصماتك وبصمات القاتل
Dialogue: 0,0:11:41.62,0:11:44.75,Default,,0000,0000,0000,,كما يستحيل أن تكوني القاتلة
Dialogue: 0,0:11:46.15,0:11:48.21,Default,,0000,0000,0000,,لمَ يستحيل ذلك؟
Dialogue: 0,0:11:49.06,0:11:50.71,Default,,0000,0000,0000,,!أأنت معتوه؟
Dialogue: 0,0:11:51.56,0:11:52.44,Default,,0000,0000,0000,,اسمع
Dialogue: 0,0:11:52.44,0:11:57.39,Default,,0000,0000,0000,,صعدت إيكو-سان وتانيغوتشي-سان\Nمصعدين مختلفين في الآن ذاته
Dialogue: 0,0:11:57.39,0:11:59.64,Default,,0000,0000,0000,,وصلت تانيغوتشي-سان للطابق الثامن
Dialogue: 0,0:11:59.64,0:12:02.35,Default,,0000,0000,0000,,وقُتلت لحظة فتح الباب
Dialogue: 0,0:12:02.35,0:12:04.71,Default,,0000,0000,0000,,بينما كانت إيكو-سان في\Nالطابق 15 في تلك الأثناء
Dialogue: 0,0:12:04.71,0:12:06.83,Default,,0000,0000,0000,,!ولا مصعد يأخذها للطابق الثامن
Dialogue: 0,0:12:07.17,0:12:09.79,Default,,0000,0000,0000,,فكيف يمكنها قتل تانيغوتشي-سان؟
Dialogue: 0,0:12:09.79,0:12:12.55,Default,,0000,0000,0000,,...لكن لا يزيلها ذلك تماماً من قائمة
Dialogue: 0,0:12:13.63,0:12:16.20,Default,,0000,0000,0000,,أنت مجرد صبي! لا تُملي على المحترفين\N!كيف يقومون بعملهم
Dialogue: 0,0:12:16.20,0:12:18.33,Default,,0000,0000,0000,,!ليس عذراً لتضربه يا أبي
Dialogue: 0,0:12:18.33,0:12:20.25,Default,,0000,0000,0000,,!هذا الولد لا يفهم مهما قلت
Dialogue: 0,0:12:21.28,0:12:23.67,Default,,0000,0000,0000,,،لا جدوى من هذا الرجل\Nلا أستطيع الاعتماد عليه أبداً
Dialogue: 0,0:12:23.67,0:12:24.21,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:12:24.77,0:12:26.54,Default,,0000,0000,0000,,أين تذهب يا كونان-كن؟
Dialogue: 0,0:12:26.54,0:12:27.04,Default,,0000,0000,0000,,اتركيه فقط
Dialogue: 0,0:12:36.33,0:12:41.47,Default,,0000,0000,0000,,إن أصاب استنتاجي، فمفتاح حلّ\Nهذه القضية سيكون في الطابق 15
Dialogue: 0,0:12:44.55,0:12:47.92,Default,,0000,0000,0000,,عجباً، كما تتوقع من طابق رئيسة الشركة
Dialogue: 0,0:12:47.92,0:12:50.17,Default,,0000,0000,0000,,!يا للسجّاد الفاخر
Dialogue: 0,0:12:55.95,0:12:56.88,Default,,0000,0000,0000,,بتلة ورد؟
Dialogue: 0,0:13:03.12,0:13:04.71,Default,,0000,0000,0000,,...غبار طلع
Dialogue: 0,0:13:10.86,0:13:12.73,Default,,0000,0000,0000,,ما هذه؟
Dialogue: 0,0:13:12.73,0:13:14.05,Default,,0000,0000,0000,,!آثار شريط
Dialogue: 0,0:13:17.13,0:13:18.25,On Top,,0000,0000,0000,,مكتب الرئيس
Dialogue: 0,0:13:31.80,0:13:33.08,Default,,0000,0000,0000,,غبار الطلع نفسه
Dialogue: 0,0:13:34.70,0:13:36.45,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:13:36.45,0:13:39.91,Default,,0000,0000,0000,,لمَ كانت هنا بتلة ورد وغبار طلع؟
Dialogue: 0,0:13:39.91,0:13:43.09,Default,,0000,0000,0000,,لم تكن لتمرّ بهذا المكان\Nلو اتّجهت مباشرةً لمكتبها
Dialogue: 0,0:13:44.40,0:13:47.58,Default,,0000,0000,0000,,قُتلت تانيغوتشي-سان داخل\Nهذا المصعد في الطابق الثامن
Dialogue: 0,0:13:49.11,0:13:51.55,Default,,0000,0000,0000,,كانت أشيا إيكو بمفردها\Nلما يفوق دقيقة فقط
Dialogue: 0,0:13:52.44,0:13:58.73,Default,,0000,0000,0000,,النزول من السلالم للطابق الثامن\Nوقتلها ثمّ العودة
Dialogue: 0,0:13:58.73,0:14:00.71,Default,,0000,0000,0000,,سيستغرق 4 إلى 5 دقائق على الأقل
Dialogue: 0,0:14:01.18,0:14:04.62,Default,,0000,0000,0000,,مما يعني أنّ السؤال أين قُتلت بالضبط؟
Dialogue: 0,0:14:08.17,0:14:10.59,Default,,0000,0000,0000,,...موضع جثّة تانيغوتشي-سان على الأرض
Dialogue: 0,0:14:11.13,0:14:14.08,Default,,0000,0000,0000,,أثر الدم والجزء المجعد\Nالغريب في معطفها
Dialogue: 0,0:14:14.91,0:14:16.32,Default,,0000,0000,0000,,...بتلة الورد على الأرض
Dialogue: 0,0:14:17.37,0:14:20.79,Default,,0000,0000,0000,,وآثار الشريط على زرّ استدعاء المصعد
Dialogue: 0,0:14:20.79,0:14:22.84,Default,,0000,0000,0000,,الذي كانت تانيغوتشي-سان فيه
Dialogue: 0,0:14:23.96,0:14:25.99,Default,,0000,0000,0000,,!هكذا إذاً، فهمت
Dialogue: 0,0:14:25.99,0:14:29.32,Default,,0000,0000,0000,,!إنّها حيلة حجّة غياب باستعمال المصعد
Dialogue: 0,0:14:29.32,0:14:33.49,Default,,0000,0000,0000,,قاتل تانيغوتشي-سان كان\N!أشيا إيكو بالفعل
Dialogue: 0,0:14:39.02,0:14:41.38,Default,,0000,0000,0000,,لم تجدوا أيّ بصمات؟
Dialogue: 0,0:14:41.69,0:14:46.79,Default,,0000,0000,0000,,أجل، لا على السكّين أو باب\Nمخرج الطوارئ في الطابق الأوّل
Dialogue: 0,0:14:47.47,0:14:51.25,Default,,0000,0000,0000,,حضرة المفتش، أيمكنني الذهاب للبيت؟
Dialogue: 0,0:14:52.01,0:14:55.46,Default,,0000,0000,0000,,...أ-أجل، سنكتفي بهذا القدر اليوم
Dialogue: 0,0:14:56.00,0:15:00.33,Default,,0000,0000,0000,,!كلا! ستتخلص من الدليل على هذا النحو
Dialogue: 0,0:15:00.33,0:15:04.50,Default,,0000,0000,0000,,لا خيار أمامي، سأضطر لاستعمال العمّ مُجدداً
Dialogue: 0,0:15:05.07,0:15:06.12,Default,,0000,0000,0000,,ران-سان
Dialogue: 0,0:15:06.12,0:15:07.03,Default,,0000,0000,0000,,نعم؟
Dialogue: 0,0:15:07.03,0:15:08.83,Default,,0000,0000,0000,,آسفة، لكن أيمكننا تأجيل موضوعنا ليوم آخر؟
Dialogue: 0,0:15:08.83,0:15:09.84,Default,,0000,0000,0000,,لا مشكلة
Dialogue: 0,0:15:10.49,0:15:12.36,Default,,0000,0000,0000,,سأغادر الآن إذاً
Dialogue: 0,0:15:12.36,0:15:13.80,Default,,0000,0000,0000,,سأرافقك للباب
Dialogue: 0,0:15:17.65,0:15:19.09,Default,,0000,0000,0000,,...ليس مٌجدداً
Dialogue: 0,0:15:20.85,0:15:25.76,Default,,0000,0000,0000,,ذلك ما وددت قوله، لكن لا يمكنك المغادرة
Dialogue: 0,0:15:26.63,0:15:28.83,Default,,0000,0000,0000,,...فالسبب
Dialogue: 0,0:15:28.83,0:15:32.34,Default,,0000,0000,0000,,!أنّك قاتلة تانيغوتشي ميكا-سان
Dialogue: 0,0:15:38.04,0:15:39.04,Default,,0000,0000,0000,,أبي
Dialogue: 0,0:15:39.04,0:15:40.80,Default,,0000,0000,0000,,ما الذي تقوله يا موري-كن؟
Dialogue: 0,0:15:41.25,0:15:46.00,Default,,0000,0000,0000,,أنتَ من وضّح أن ليس بإمكانها\N!أن تكون الفاعلة
Dialogue: 0,0:15:46.00,0:15:47.91,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:15:47.91,0:15:49.96,Default,,0000,0000,0000,,لكن كانت تلك خدعة
Dialogue: 0,0:15:50.37,0:15:51.42,Default,,0000,0000,0000,,خدعة؟
Dialogue: 0,0:15:51.91,0:15:56.88,Default,,0000,0000,0000,,قبل ذلك، دعوني أوضّح أمر\Nآثار الأقدام في رواق الطابق الثامن
Dialogue: 0,0:15:57.56,0:15:59.34,Default,,0000,0000,0000,,اجلسي من فضلك
Dialogue: 0,0:15:59.81,0:16:05.30,Default,,0000,0000,0000,,كانت حيلةً نسجتها كي تجعل\Nمقتل تانيغوتشي-سان
Dialogue: 0,0:16:05.30,0:16:07.71,Default,,0000,0000,0000,,يبدو كنتيجة تسلّل لص
Dialogue: 0,0:16:09.05,0:16:12.14,Default,,0000,0000,0000,,تذكّروا كيف كان شكل آثار الأقدام تلك
Dialogue: 0,0:16:12.14,0:16:15.67,Default,,0000,0000,0000,,في العادة يميل المرء للهروب\Nبعد قتله لأحدهم، أليس كذلك؟
Dialogue: 0,0:16:15.67,0:16:18.46,Default,,0000,0000,0000,,مما يعني أنّ آثار الأقدام ستكون متفرقة
Dialogue: 0,0:16:18.46,0:16:21.92,Default,,0000,0000,0000,,مع ذلك، كانت تلك آثار أقدام شخص يمشي
Dialogue: 0,0:16:21.92,0:16:23.80,Default,,0000,0000,0000,,داخلاً وخارجاً من المبنى
Dialogue: 0,0:16:24.20,0:16:26.88,Default,,0000,0000,0000,,...فهمت، بذكرك لذلك فالأمر منطقي
Dialogue: 0,0:16:26.88,0:16:28.58,Default,,0000,0000,0000,,إيكو-سان
Dialogue: 0,0:16:28.58,0:16:31.62,Default,,0000,0000,0000,,دخلتِ المبنى قبل ساعة من الجريمة
Dialogue: 0,0:16:31.62,0:16:33.53,Default,,0000,0000,0000,,زيّفتِ آثار الأقدام
Dialogue: 0,0:16:33.53,0:16:37.67,Default,,0000,0000,0000,,وفتحتِ باب مخرج طوارئ\Nالطابق الأوّل من الداخل
Dialogue: 0,0:16:39.19,0:16:44.29,Default,,0000,0000,0000,,خبّأتِ الأحذية الرياضية التي لا تلائمك \Nفي حقيبة يدك الكبيرة بعدها
Dialogue: 0,0:16:44.29,0:16:45.59,Default,,0000,0000,0000,,وغادرتِ المبنى
Dialogue: 0,0:16:46.64,0:16:51.35,Default,,0000,0000,0000,,رجعتِ بعد 30 دقيقة عقب تخلّصك من الأحذية
Dialogue: 0,0:16:51.35,0:16:54.09,Default,,0000,0000,0000,,،ثمّ أمام أنظارنا
Dialogue: 0,0:16:54.09,0:16:58.13,Default,,0000,0000,0000,,توّجهتِ لردهة المصاعد مع تانيغوتشي ميكا-سان
Dialogue: 0,0:16:58.13,0:17:01.42,Default,,0000,0000,0000,,كنتِ من ضغط زرّ الاستدعاء
Dialogue: 0,0:17:01.42,0:17:06.83,Default,,0000,0000,0000,,فأردتِها أن تستعمل المصعد في المنتصف
Dialogue: 0,0:17:06.83,0:17:11.00,Default,,0000,0000,0000,,بدل الأقرب لها بأيّ شكل
Dialogue: 0,0:17:13.20,0:17:18.44,Default,,0000,0000,0000,,وبدأتِ بإدخال رقمها في هاتفك الخلوي داخل المصعد
Dialogue: 0,0:17:18.44,0:17:22.28,Default,,0000,0000,0000,,وضغطتِ زرّ الاتصال بعد نزولك\Nفي الطابق الخامس عشر
Dialogue: 0,0:17:22.28,0:17:26.75,Default,,0000,0000,0000,,فمن الصعب أن تعمل الشبكة داخل المصعد
Dialogue: 0,0:17:29.81,0:17:34.12,Default,,0000,0000,0000,,أخبرتِ تانيغوتشي-سان أن تأتي\Nللطابق الخامس عشر فوراً
Dialogue: 0,0:17:36.30,0:17:42.13,Default,,0000,0000,0000,,وألصقتِ عملةً بزرّ استدعاء\Nالمصعد في الطابق فوق
Dialogue: 0,0:17:42.92,0:17:47.13,Default,,0000,0000,0000,,فعلتِ ذلك كيلا يُغلق باب المصعد
Dialogue: 0,0:17:47.13,0:17:48.92,Default,,0000,0000,0000,,بينما تقتلينها
Dialogue: 0,0:17:51.20,0:17:53.38,Default,,0000,0000,0000,,!تـ-تمهل
Dialogue: 0,0:17:53.70,0:17:57.00,Default,,0000,0000,0000,,!موري-كن! كانت الضحية ميتة في الطابق الثامن
Dialogue: 0,0:17:57.32,0:18:01.53,Default,,0000,0000,0000,,نصل الآن لعقدة الحيلة
Dialogue: 0,0:18:01.53,0:18:05.46,Default,,0000,0000,0000,,ألم تجدوا اتّجاه سقوط تانيغوتشي-سان غريباً؟
Dialogue: 0,0:18:06.23,0:18:10.35,Default,,0000,0000,0000,,،لو طُعنت بينما تغادر المصعد
Dialogue: 0,0:18:10.35,0:18:12.71,Default,,0000,0000,0000,,فكانت لتسقط داخله
Dialogue: 0,0:18:12.71,0:18:16.67,Default,,0000,0000,0000,,لكنّها كانت مستلقيةً خارج المصعد\Nوهي تواجهه
Dialogue: 0,0:18:17.05,0:18:19.63,Default,,0000,0000,0000,,...إن-إن ذكرت ذلك
Dialogue: 0,0:18:20.34,0:18:23.01,Default,,0000,0000,0000,,طعنت إيكو-سان تانيغوتشي-سان في الطابق 15
Dialogue: 0,0:18:23.42,0:18:28.87,Default,,0000,0000,0000,,توجهت خلفها وأدارت جسدها في اتّجاه الرواق
Dialogue: 0,0:18:28.87,0:18:30.79,Default,,0000,0000,0000,,ثمّ ضغطت زرّ الطابق الثامن
Dialogue: 0,0:18:30.79,0:18:33.83,Default,,0000,0000,0000,,وأزالت الشريط عن زرّ الاستدعاء
Dialogue: 0,0:18:33.83,0:18:38.54,Default,,0000,0000,0000,,ثمّ سندت تانيغوتشي-سان لتكون\Nفي وضعية جلوس
Dialogue: 0,0:18:38.54,0:18:42.34,Default,,0000,0000,0000,,وخرجت وأنزلتها للطابق الثامن
Dialogue: 0,0:18:48.98,0:18:50.94,Default,,0000,0000,0000,,...لا يُعقل أن تقوم
Dialogue: 0,0:18:52.27,0:18:57.34,Default,,0000,0000,0000,,كان هناك مفتاحان لحلّ لغز\Nحجّة غياب المصعد هذه
Dialogue: 0,0:18:57.34,0:19:01.88,Default,,0000,0000,0000,,الأوّل هو التجعّد على كتف\Nمعطف تانيغوتشي-سان
Dialogue: 0,0:19:01.88,0:19:07.29,Default,,0000,0000,0000,,كان سببه انغلاق باب المصعد عليه \Nبعدما تركتِها
Dialogue: 0,0:19:07.29,0:19:11.71,Default,,0000,0000,0000,,والثاني هو بتلة الورد وغبار الطلع على السجّاد
Dialogue: 0,0:19:12.17,0:19:14.16,Default,,0000,0000,0000,,عندما وضعت إيكو-سان الباقة على الأرض
Dialogue: 0,0:19:14.16,0:19:16.71,Default,,0000,0000,0000,,كيلا تعيقها في قتل تانيغوتشي-سان
Dialogue: 0,0:19:17.45,0:19:19.61,Default,,0000,0000,0000,,قصّة مثيرة
Dialogue: 0,0:19:19.61,0:19:22.17,Default,,0000,0000,0000,,لكنها تبقى مجرد افتراضات
Dialogue: 0,0:19:23.11,0:19:27.94,Default,,0000,0000,0000,,وأيضاً لو صعدت تانيغوتشي-سان\Nمصعد الطابق الثامن مُجدداً
Dialogue: 0,0:19:27.94,0:19:32.17,Default,,0000,0000,0000,,كانت لتبقى بصماتها على زرّ استدعاء الطابق الثامن
Dialogue: 0,0:19:32.17,0:19:33.80,Default,,0000,0000,0000,,حسناً يا مفتّش؟
Dialogue: 0,0:19:34.30,0:19:36.15,Default,,0000,0000,0000,,أيّ بصمات على زرّ الاستدعاء؟
Dialogue: 0,0:19:36.15,0:19:38.58,Default,,0000,0000,0000,,كلا، لم نجد عليه شيئاً
Dialogue: 0,0:19:40.09,0:19:44.29,Default,,0000,0000,0000,,للأسف يا موري-سان، لم تذهب\Nميكا-سان للطابق الخامس عشر
Dialogue: 0,0:19:44.29,0:19:46.00,Default,,0000,0000,0000,,نُقضت نظريتك
Dialogue: 0,0:19:46.54,0:19:49.84,Default,,0000,0000,0000,,صحيح، فأنتِ من أزال بصماتها
Dialogue: 0,0:19:49.84,0:19:52.29,Default,,0000,0000,0000,,كان عملاً متقناً
Dialogue: 0,0:19:52.29,0:19:56.33,Default,,0000,0000,0000,,ضغطتِ على زرّ الاستدعاء\Nلإيقاف إغلاق باب المصعد
Dialogue: 0,0:19:56.62,0:19:58.67,Default,,0000,0000,0000,,ثمّ محوتِ بصماتها بإصبعك
Dialogue: 0,0:19:58.95,0:20:02.59,Default,,0000,0000,0000,,لحظة، أيعني هذا أنّ لا دليل هناك؟
Dialogue: 0,0:20:02.82,0:20:05.02,Default,,0000,0000,0000,,بل الدليل موجود
Dialogue: 0,0:20:05.02,0:20:06.96,Default,,0000,0000,0000,,داخل حقيبة إيكو-سان
Dialogue: 0,0:20:09.48,0:20:11.05,Default,,0000,0000,0000,,أيّ دليل بالضبط؟
Dialogue: 0,0:20:11.48,0:20:14.75,Default,,0000,0000,0000,,القفاز الملطخ بالدماء الذي ارتدته وقت الجريمة
Dialogue: 0,0:20:14.75,0:20:18.72,Default,,0000,0000,0000,,يُفترض أنّها لم تستطع التخلص منه\Nداخل الإطار الزمني القصير
Dialogue: 0,0:20:18.72,0:20:22.18,Default,,0000,0000,0000,,ولن تجرؤ على إخفائه داخل المبنى
Dialogue: 0,0:20:22.18,0:20:26.25,Default,,0000,0000,0000,,فثقتكِ كانت عاليةً في حيلة\Nحجّة غياب المصعد
Dialogue: 0,0:20:26.25,0:20:30.00,Default,,0000,0000,0000,,أيّ أن القفاز الملطخ بالدماء\Nلا يمكن أن يكون
Dialogue: 0,0:20:30.00,0:20:31.87,Default,,0000,0000,0000,,!سوى في حوزتك
Dialogue: 0,0:20:33.04,0:20:37.45,Default,,0000,0000,0000,,...من سرقت تصميمك وباعته للشركة المنافسة
Dialogue: 0,0:20:37.45,0:20:39.34,Default,,0000,0000,0000,,كانت تانيغوتشي ميكا-سان، صحيح؟
Dialogue: 0,0:20:41.87,0:20:45.29,Default,,0000,0000,0000,,أجل، الدليل هنا أيضاً
Dialogue: 0,0:20:46.86,0:20:48.75,Default,,0000,0000,0000,,لكنّي فعلتُها لأنّها خانتني
Dialogue: 0,0:20:49.65,0:20:51.57,Default,,0000,0000,0000,,قالت أنّها لا تهتم لو بلّغتُ الشرطة
Dialogue: 0,0:20:51.57,0:20:53.89,Default,,0000,0000,0000,,،فبعد إلغاء عرض أزيائي
Dialogue: 0,0:20:53.89,0:20:57.67,Default,,0000,0000,0000,,فعل ذلك سيدنّس سمعة علامة\Nأشيا إيكو التجارية أكثر فقط
Dialogue: 0,0:20:57.67,0:21:01.13,On Top,,0000,0000,0000,,رسالة استقالة
Dialogue: 0,0:20:57.67,0:21:01.13,Default,,0000,0000,0000,,ثمّ حاولت الاستقالة من الشركة
Dialogue: 0,0:21:01.47,0:21:05.58,Default,,0000,0000,0000,,قرّرتُ قتلها بينما لا تزال في الشركة
Dialogue: 0,0:21:06.00,0:21:07.42,Default,,0000,0000,0000,,...وكان ذلك اليوم
Dialogue: 0,0:21:08.46,0:21:14.62,Default,,0000,0000,0000,,عندما عرفتُ أنّ أباك كان\Nالمتحرّي الشهير موري كوغورو-سان
Dialogue: 0,0:21:14.62,0:21:16.37,Default,,0000,0000,0000,,احترتُ فيما أفعل
Dialogue: 0,0:21:17.12,0:21:19.38,Default,,0000,0000,0000,,لكن في النهاية لم تنقلب عزيمتي
Dialogue: 0,0:23:04.43,0:23:05.53,Default,,0000,0000,0000,,ران-سان
Dialogue: 0,0:23:05.53,0:23:09.11,Default,,0000,0000,0000,,قد لا تصدقينني
Dialogue: 0,0:23:09.11,0:23:12.76,Default,,0000,0000,0000,,لكني أردتك أن تعملي معي عارضةً حقاً
Dialogue: 0,0:23:13.70,0:23:16.81,Default,,0000,0000,0000,,أردتُ أن ترتدي فتاة بصفاء قلبك وبدنك
Dialogue: 0,0:23:16.81,0:23:19.55,Default,,0000,0000,0000,,أزياء أشيا إيكو
Dialogue: 0,0:23:25.14,0:23:27.17,Default,,0000,0000,0000,,...هذا مؤسف يا ران-نيتشان
Dialogue: 0,0:23:27.17,0:23:29.59,Default,,0000,0000,0000,,كانت فرصتك في أن تصبحي عارضة
Dialogue: 0,0:23:29.87,0:23:32.63,Default,,0000,0000,0000,,كلا، لا مشكلة
Dialogue: 0,0:23:32.63,0:23:35.04,Default,,0000,0000,0000,,ماذا؟ أين أبي بالمناسبة؟
Dialogue: 0,0:23:35.04,0:23:38.46,Default,,0000,0000,0000,,!تباً! تركته نائماً
Dialogue: 0,0:23:43.25,0:23:45.61,Default,,0000,0000,0000,,يبدو أنّ هذه القضية ألقت بظلالها عليه
Dialogue: 0,0:23:45.61,0:23:49.74,Default,,0000,0000,0000,,فكان من معجبي أشيا وإيكو، واضطرّ لكشف جريمتها
Dialogue: 0,0:23:51.99,0:23:57.02,Default,,0000,0000,0000,,لو اكتشف أني من كشفت جريمتها سيقتلني حتماً
Dialogue: 0,0:24:09.13,0:24:10.09,Default,,0000,0000,0000,,!ميتسوهيكو
Dialogue: 0,0:24:20.50,0:24:23.83,Default,,0000,0000,0000,,!اكتشفتُ الأمر! أنت الشبح
Dialogue: 0,0:24:24.82,0:24:26.15,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.15,0:24:28.95,Default,,0000,0000,0000,,جريمة قتل المنزل المسكون
Dialogue: 0,0:24:45.97,0:24:48.22,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.22,0:24:49.82,Default,,0000,0000,0000,,قبو مُخيف
Dialogue: 0,0:24:49.82,0:24:51.82,Default,,0000,0000,0000,,

