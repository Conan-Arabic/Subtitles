Dialogue: 0,0:00:00.85,0:00:04.47,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والقضايا\Nتلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.47,0:00:06.46,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.46,0:00:08.18,Default,,0000,0000,0000,,!اليوم ختام فطيرة الليمون
Dialogue: 0,0:00:08.18,0:00:09.75,Default,,0000,0000,0000,,!ذكريات فوّاحة وحب أوّل رقيق
Dialogue: 0,0:00:10.22,0:00:11.97,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.97,0:00:13.63,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.63,0:00:16.09,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.76,0:00:24.18,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.18,0:00:31.22,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.99,0:00:39.35,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.35,0:00:46.85,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.85,0:00:59.30,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.22,0:01:06.60,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.60,0:01:13.48,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.48,0:01:19.85,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.85,0:01:26.87,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.85,0:01:54.30,Default,,0000,0000,0000,,،تمّت دعوتنا لحفلة عيد ميلاد أوتشيدا أسامي
Dialogue: 0,0:01:54.30,0:01:57.35,Default,,0000,0000,0000,,التي يُشاع أنّها الحُب الأوّل لشينتشي
Dialogue: 0,0:01:57.35,0:02:02.81,Default,,0000,0000,0000,,غطّت في النوم، فتركناها وتوجّهنا\Nلغرفة الكاراوكي في المدينة
Dialogue: 0,0:02:03.39,0:02:06.65,Default,,0000,0000,0000,,!لاحظ أحد رفاقها آنذاك نشوب حريق في النزل
Dialogue: 0,0:02:08.93,0:02:11.18,Default,,0000,0000,0000,,!كانت أوتشيدا أسامي نائمةً في النزل
Dialogue: 0,0:02:13.76,0:02:18.07,Default,,0000,0000,0000,,لحسن الحظّ، حطّمت ران الباب\Nوتمكّنت من إنقاذها
Dialogue: 0,0:02:19.83,0:02:25.62,Title,,0000,0000,15,,{\fad(300,0)}قضيّة ذكريات الحُب الأوّل\N(الجزء الثاني)
Dialogue: 0,0:02:20.22,0:02:24.05,Default,,0000,0000,0000,,قضيّة ذكريات الحُب الأوّل\N(الجزء الثاني)
Dialogue: 0,0:02:25.97,0:02:29.09,Default,,0000,0000,0000,,!ماذا؟ قالت أسامي سينباي ذلك في نومها؟
Dialogue: 0,0:02:30.30,0:02:33.80,Default,,0000,0000,0000,,!صوتك مرتفع! ستوقظينها
Dialogue: 0,0:02:37.72,0:02:43.73,Default,,0000,0000,0000,,كما قلت، كانت تتمتم في نومها\Nعندما نقلوها إلى هنا
Dialogue: 0,0:02:44.80,0:02:49.19,Default,,0000,0000,0000,,"!آسفة! آسفة يا كودو-كن! أنا آسفة"
Dialogue: 0,0:02:49.60,0:02:51.65,Default,,0000,0000,0000,,لكن لمَ قد تقول ذلك؟
Dialogue: 0,0:02:51.97,0:02:55.21,Default,,0000,0000,0000,,لا أدري! ذلك ما سمعتُه فحسب
Dialogue: 0,0:03:00.60,0:03:02.51,Default,,0000,0000,0000,,بأيّ حال، أتشعرين بعطش؟
Dialogue: 0,0:03:02.51,0:03:05.21,Default,,0000,0000,0000,,يمكنني أن أشتري لك شيئاً\Nمن آلة البيع في الأسفل
Dialogue: 0,0:03:05.21,0:03:07.03,Default,,0000,0000,0000,,سأرافقك إذاً
Dialogue: 0,0:03:08.55,0:03:10.79,Default,,0000,0000,0000,,بالمناسبة، هل كونان-كن بخير؟
Dialogue: 0,0:03:11.10,0:03:14.26,Default,,0000,0000,0000,,!أجل، إنّه بخير تماماً! مُتعافٍ
Dialogue: 0,0:03:14.26,0:03:17.63,Default,,0000,0000,0000,,لا بدّ أنّه مع أبيك\Nيتجوّلان في مسرح الحريق
Dialogue: 0,0:03:32.14,0:03:37.24,Default,,0000,0000,0000,,أكان حادثاً حقّاً؟ أنسوا إطفاء الشموع فقط؟
Dialogue: 0,0:03:37.85,0:03:41.24,Default,,0000,0000,0000,,في تلك الحالة، لمَ كانت أسامي-سان\Nالتي نامت على الأريكة
Dialogue: 0,0:03:41.24,0:03:44.62,Default,,0000,0000,0000,,مستلقيةً على الأرض بين النيران؟
Dialogue: 0,0:03:44.62,0:03:46.66,Default,,0000,0000,0000,,...وهذه الغرفة
Dialogue: 0,0:03:47.22,0:03:51.85,Default,,0000,0000,0000,,بدا الأثاث مختلفاً بشكل ما\Nمن قبل الحريق عن بعده
Dialogue: 0,0:03:51.85,0:03:53.67,Default,,0000,0000,0000,,!كما لو أنّ أحداً حرّكه
Dialogue: 0,0:03:54.01,0:03:57.80,Default,,0000,0000,0000,,أيمكن أنّ أحداً رجع هنا لإضرام النار؟
Dialogue: 0,0:03:58.18,0:04:02.18,Default,,0000,0000,0000,,في تلك الحالة، سيكون موريموتو-سان الأكثر\Nشبهة بما أنّه كان يملك المفتاح
Dialogue: 0,0:04:02.85,0:04:04.51,Default,,0000,0000,0000,,...كلا، انتظر
Dialogue: 0,0:04:04.51,0:04:09.80,Default,,0000,0000,0000,,كان بإمكان أيّ أحد الدخول بسهولة\Nعبر نافذة مفتوحة القفل سلفاً
Dialogue: 0,0:04:09.80,0:04:12.19,Default,,0000,0000,0000,,!فكّر! فكّر
Dialogue: 0,0:04:12.72,0:04:16.07,Default,,0000,0000,0000,,وفقاً لشهود عيان، بدأ الحريق عند قرابة \Nالثانية وخمسين دقيقة
Dialogue: 0,0:04:16.64,0:04:20.63,Default,,0000,0000,0000,,كنّا جميعاً في حجرة الكاراوكي عند الثالثة
Dialogue: 0,0:04:21.57,0:04:27.51,Default,,0000,0000,0000,,ستستغرق 5 دقائق للوصول إلى هناك بالسيّارة\Nمن هنا، و15 دقيقة ركضاً
Dialogue: 0,0:04:27.51,0:04:30.14,Default,,0000,0000,0000,,،لم يغب أحد لثلاثين دقيقة
Dialogue: 0,0:04:30.14,0:04:33.22,Default,,0000,0000,0000,,فكان نوغوتشي-سان هو الوحيد القادر\Nعلى الذهاب هناك وإضرام النار والعودة
Dialogue: 0,0:04:33.22,0:04:35.35,Default,,0000,0000,0000,,بما أنّ مفتاح السيّارة معه
Dialogue: 0,0:04:36.47,0:04:39.30,Default,,0000,0000,0000,,،كانت السيّارة مركونةً أمام محلّ الكاراوكي
Dialogue: 0,0:04:39.30,0:04:42.47,Default,,0000,0000,0000,,وغادر الجميع قبل 30 دقيقة\Nلاستعمال دورة مياه المحطّة
Dialogue: 0,0:04:42.47,0:04:45.51,Default,,0000,0000,0000,,وشراء أغراض من متجر التموينات بالجوار
Dialogue: 0,0:04:45.51,0:04:48.35,Default,,0000,0000,0000,,فكان ليلاحظ أحد اختفاء السيّارة
Dialogue: 0,0:04:49.80,0:04:53.39,Default,,0000,0000,0000,,إذا لم تكن بالسيّارة، فربما درّاجة تشيكا-سان الناريّة؟
Dialogue: 0,0:04:53.39,0:04:58.85,Default,,0000,0000,0000,,كلا، كانت مركونةً أمام النزل\Nعندما وصلنا هنا
Dialogue: 0,0:04:58.85,0:05:00.30,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:05:00.30,0:05:04.49,Default,,0000,0000,0000,,لم يستطع أحد المتواجدين في حجرة\N!الكاراوكي آنذاك ارتكاب الجريمة
Dialogue: 0,0:05:05.60,0:05:09.55,Default,,0000,0000,0000,,سيكون الموضوع مختلفاً لو كان هنا\N،جهاز توقيت ما
Dialogue: 0,0:05:09.55,0:05:13.46,Default,,0000,0000,0000,,لكن كان ليجده رجال الإطفاء لو كان ذلك صحيحاً
Dialogue: 0,0:05:13.85,0:05:18.92,Default,,0000,0000,0000,,...مما يترك ما قاله العمّ فقط... كانت أسامي-سان بنفسها من
Dialogue: 0,0:05:18.92,0:05:20.26,Default,,0000,0000,0000,,انتبه يا فتى
Dialogue: 0,0:05:21.35,0:05:23.97,Default,,0000,0000,0000,,لا يجدر بك الدخول هنا
Dialogue: 0,0:05:23.97,0:05:25.26,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:05:25.60,0:05:29.85,Default,,0000,0000,0000,,بالمناسبة، سمعت أنّ اليوم كان عيد\Nميلاد الفتاة التي كانت نائمة هنا
Dialogue: 0,0:05:29.85,0:05:34.18,Default,,0000,0000,0000,,احترقت الهدايا والكعكة، لكن نجت هذه
Dialogue: 0,0:05:34.18,0:05:34.73,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:05:35.47,0:05:37.61,Default,,0000,0000,0000,,إنّها رسالة عيد ميلاد لها، صحيح؟
Dialogue: 0,0:05:37.61,0:05:39.51,Default,,0000,0000,0000,,أعطها إيّاها في المشفى
Dialogue: 0,0:05:39.51,0:05:41.32,Default,,0000,0000,0000,,!ماذا؟ لا تتوافق
Dialogue: 0,0:05:42.51,0:05:44.85,Default,,0000,0000,0000,,...انتظر، بالنظر مُجدداً
Dialogue: 0,0:05:46.05,0:05:49.98,Default,,0000,0000,0000,,بالنظر مُجدداً، قال ذاك الشخص\Nشيئاً غريباً وقتها
Dialogue: 0,0:05:51.46,0:05:54.45,Default,,0000,0000,0000,,!يا إلهي، لا عجب أنّ حريقاً قد نشب
Dialogue: 0,0:05:54.80,0:05:58.50,Default,,0000,0000,0000,,!كانت الكعكة بالشموع المشتعلة فوق كرسيّ
Dialogue: 0,0:05:59.59,0:06:03.33,Default,,0000,0000,0000,,أخبرني يا عمّ، أكانت الكعكة على كرسيّ حقّاً؟
Dialogue: 0,0:06:03.33,0:06:07.00,Default,,0000,0000,0000,,أجل، كان الكرسيّ محترقاً، والكعكة مفتّتة
Dialogue: 0,0:06:07.00,0:06:09.00,Default,,0000,0000,0000,,أين كان ذاك الكرسيّ؟
Dialogue: 0,0:06:09.00,0:06:10.76,Default,,0000,0000,0000,,هناك
Dialogue: 0,0:06:11.05,0:06:15.18,Default,,0000,0000,0000,,أمام الخزانة الصغيرة المحترقة في الزاوية
Dialogue: 0,0:06:23.55,0:06:26.34,Default,,0000,0000,0000,,لكن ألا يبدو ذلك غريباً يا ران؟
Dialogue: 0,0:06:26.34,0:06:27.15,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:27.67,0:06:31.34,Default,,0000,0000,0000,,سمعت أنّ أسامي-سان كانت في نادي\Nكرة المضرب حتّى سنتها الثانية في المتوسّطة
Dialogue: 0,0:06:31.34,0:06:33.61,Default,,0000,0000,0000,,!وكانت البطلة الوطنيّة ذاك العام
Dialogue: 0,0:06:34.00,0:06:36.30,Default,,0000,0000,0000,,لا بدّ أنّها كانت مذهلة
Dialogue: 0,0:06:36.30,0:06:39.75,Default,,0000,0000,0000,,ماذا؟ لكن ألم تكن مديرة نادي\Nكرة القدم في سنتها الثالثة؟
Dialogue: 0,0:06:39.75,0:06:43.62,Default,,0000,0000,0000,,أجل! وقد تغيّرت تماماً بعد\N!العطلة الصيفية وفقما يبدو
Dialogue: 0,0:06:44.05,0:06:45.58,Default,,0000,0000,0000,,لمَ يا ترى؟
Dialogue: 0,0:06:45.58,0:06:48.71,Default,,0000,0000,0000,,لعلّها أرادت التركيز على الدراسة لا أكثر
Dialogue: 0,0:06:48.71,0:06:50.78,Default,,0000,0000,0000,,لكن سيكون ذلك أكثر غرابة
Dialogue: 0,0:06:50.78,0:06:51.51,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:06:51.51,0:06:56.55,Default,,0000,0000,0000,,لأنّ الطلّاب يتركون أنديتهم في الفصل\N!الثاني من سنتهم الثالثة عادةً
Dialogue: 0,0:06:56.55,0:06:58.17,Default,,0000,0000,0000,,بذكركِ لذلك، الأمر غريب فعلاً
Dialogue: 0,0:06:58.17,0:07:01.52,Default,,0000,0000,0000,,لعلّها بدّلت لأنّه لم يكن هناك\Nشبّان وسيمين في نادي كرة المضرب
Dialogue: 0,0:07:01.52,0:07:03.67,Default,,0000,0000,0000,,لا يُعقل، فهي ليست أنت
Dialogue: 0,0:07:03.67,0:07:04.73,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:07:04.73,0:07:07.78,Default,,0000,0000,0000,,أيّاً يكن، لا بدّ أنّها كانت تملك دوافعها الخاصّة
Dialogue: 0,0:07:08.59,0:07:11.13,Default,,0000,0000,0000,,من الأفضل ألّا نتطفّل كثيراً
Dialogue: 0,0:07:11.13,0:07:12.69,Default,,0000,0000,0000,,!لكنّي أريد أن أعرف
Dialogue: 0,0:07:13.63,0:07:17.38,Default,,0000,0000,0000,,!صوتك مرتفع! ستوقظينها
Dialogue: 0,0:07:17.38,0:07:17.94,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:17.94,0:07:19.37,Default,,0000,0000,0000,,ماذا هناك؟ ما الأمر؟
Dialogue: 0,0:07:22.42,0:07:24.54,Default,,0000,0000,0000,,سـ-سينباي؟
Dialogue: 0,0:07:25.88,0:07:28.00,Default,,0000,0000,0000,,ماذا؟ الزبائن الذين أتوا هنا عند الثالثة؟
Dialogue: 0,0:07:28.25,0:07:30.88,Default,,0000,0000,0000,,أجل، أتذكر من أتاك؟
Dialogue: 0,0:07:30.88,0:07:36.75,Default,,0000,0000,0000,,حسناً، كانوا شبّاناً يغنّون الكاراوكي\Nفي المحلّ المجاور وفقما أظنّ
Dialogue: 0,0:07:36.75,0:07:39.55,Default,,0000,0000,0000,,اشتروا سجائراً وعصير طماطم وأشياء كهذه
Dialogue: 0,0:07:39.55,0:07:40.72,Default,,0000,0000,0000,,كيف كانوا؟
Dialogue: 0,0:07:41.05,0:07:45.59,Default,,0000,0000,0000,,،شاب بنيّ الشعر بنظّارات، وفتاة في فستان أسود
Dialogue: 0,0:07:45.59,0:07:47.56,Default,,0000,0000,0000,,وشاب بقصّة شعر رياضيّة قصيرة
Dialogue: 0,0:07:47.88,0:07:50.77,Default,,0000,0000,0000,,!إنّهم ساواي-سان وهاياساكا-سان ونوغوتشي-سان
Dialogue: 0,0:07:51.13,0:07:55.38,Default,,0000,0000,0000,,!يا إلهي، تقيّأ صاحب قصّة الشعر الرياضيّة أمام المتجر
Dialogue: 0,0:07:55.38,0:07:57.63,Default,,0000,0000,0000,,!كان التنظيف متعباً
Dialogue: 0,0:07:57.63,0:07:59.74,Default,,0000,0000,0000,,...أخبرني يا عمّ، أيمكن أنّ
Dialogue: 0,0:08:03.71,0:08:05.41,Default,,0000,0000,0000,,سونوكو، أوجدتِها؟
Dialogue: 0,0:08:05.65,0:08:09.34,Default,,0000,0000,0000,,.كلا، لم تكن في دورة المياه\Nماذا عنك؟
Dialogue: 0,0:08:09.34,0:08:11.10,Default,,0000,0000,0000,,لم أجدها هنا أيضاً
Dialogue: 0,0:08:12.12,0:08:14.63,Default,,0000,0000,0000,,أين ذهبت أسامي سينباي يا ترى؟
Dialogue: 0,0:08:14.92,0:08:19.59,Default,,0000,0000,0000,,بأيّ حال، أنتِ اتّصلي بأبيك\Nوأنا سأذهب لجلب ممرضة
Dialogue: 0,0:08:19.59,0:08:21.43,Default,,0000,0000,0000,,حسناً، فهمت
Dialogue: 0,0:08:23.17,0:08:27.52,Default,,0000,0000,0000,,!أجل، كما قلت يا صبيّ\Nكيف عرفت ذلك؟
Dialogue: 0,0:08:27.52,0:08:29.05,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:08:29.05,0:08:33.88,Default,,0000,0000,0000,,أخبرتُه أنّها مقلوبة، لكنّه لم يستمع ليّ
Dialogue: 0,0:08:33.88,0:08:38.49,Default,,0000,0000,0000,,،وكانت عليها أشياء دبقة أيضاً\Nكان زبوناً عابثاً بحقّ
Dialogue: 0,0:08:38.80,0:08:42.25,Default,,0000,0000,0000,,!لا شكّ في الأمر، من أضرم الحريق كان ذاك الشخص
Dialogue: 0,0:08:42.25,0:08:48.50,Default,,0000,0000,0000,,!وإن أصاب استنتاجي، فلا يزال الدليل معه
Dialogue: 0,0:08:49.42,0:08:52.38,Default,,0000,0000,0000,,!ماذا؟ اختفت أسامي-سان؟
Dialogue: 0,0:08:52.63,0:08:54.05,Default,,0000,0000,0000,,أحقّاً هذا يا ران؟
Dialogue: 0,0:08:54.05,0:08:56.34,Default,,0000,0000,0000,,أجل، كانت نائمةً على السرير قبل قليل
Dialogue: 0,0:08:56.67,0:09:00.21,Default,,0000,0000,0000,,لا بدّ أنّها غادرت بينما\N!ذهبنا لجلب شراب
Dialogue: 0,0:09:00.21,0:09:01.63,Default,,0000,0000,0000,,ماذا نفعل يا أبي؟
Dialogue: 0,0:09:01.63,0:09:06.35,Default,,0000,0000,0000,,!ابحثوا بجوار المشفى بأيّ حال\N!قد لا تزال بالقرب
Dialogue: 0,0:09:06.35,0:09:07.81,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:09:09.09,0:09:12.09,Default,,0000,0000,0000,,أين ذهبت أسامي؟
Dialogue: 0,0:09:12.09,0:09:14.92,Default,,0000,0000,0000,,لعلّها تنوي الانتحار
Dialogue: 0,0:09:14.92,0:09:15.78,Default,,0000,0000,0000,,!الانتحار؟
Dialogue: 0,0:09:15.78,0:09:22.21,Default,,0000,0000,0000,,أجل، إن كانت أسامي-سان هي\N...من أضرم هذا الحريق حقّاً
Dialogue: 0,0:09:27.21,0:09:28.79,Default,,0000,0000,0000,,أو ما قد يخاله البعض
Dialogue: 0,0:09:28.79,0:09:30.59,Default,,0000,0000,0000,,موري-سان؟
Dialogue: 0,0:09:30.59,0:09:33.25,Default,,0000,0000,0000,,لكنّ الحقيقة ليست كذلك
Dialogue: 0,0:09:33.25,0:09:37.00,Default,,0000,0000,0000,,!لم تكن أسامي-سان المجرمة، بل الضحيّة
Dialogue: 0,0:09:37.00,0:09:38.00,Default,,0000,0000,0000,,الضحيّة؟
Dialogue: 0,0:09:38.00,0:09:42.46,Default,,0000,0000,0000,,كادت أسامي-سان تحترق موتاً
Dialogue: 0,0:09:42.46,0:09:46.21,Default,,0000,0000,0000,,!من فِعل أحدكم هنا
Dialogue: 0,0:09:54.88,0:09:56.59,Default,,0000,0000,0000,,!لا-لا يُعقل ذلك
Dialogue: 0,0:09:56.59,0:10:01.09,Default,,0000,0000,0000,,فقد بدأ الحريق عندما كنّا\Nفي حجرة الكاراوكي، أليس كذلك؟
Dialogue: 0,0:10:01.09,0:10:04.41,Default,,0000,0000,0000,,ستحتاج 15 دقيقة للذهاب إلى هناك\Nمن هنا ركضاً
Dialogue: 0,0:10:04.41,0:10:07.30,Default,,0000,0000,0000,,وقرابة 5 دقائق بالسيّارة أو الدرّاجة النارية
Dialogue: 0,0:10:07.30,0:10:11.09,Default,,0000,0000,0000,,لكن لم يبد أنّ أحداً حرّك السيّارة
Dialogue: 0,0:10:11.09,0:10:13.12,Default,,0000,0000,0000,,وكانت الدرّاجة مركونةً أمام النزل
Dialogue: 0,0:10:13.38,0:10:19.13,Default,,0000,0000,0000,,يستحيل أن أحدنا استطاع\Nالقدوم هنا لإضرام الحريق
Dialogue: 0,0:10:19.13,0:10:22.88,Default,,0000,0000,0000,,رغم أنّ الموضوع سيختلف لو اُستعمل\Nجهاز توقيت ما
Dialogue: 0,0:10:22.88,0:10:25.38,Default,,0000,0000,0000,,لكن كان رجال الإطفاء ليعثروا عليه
Dialogue: 0,0:10:25.38,0:10:26.76,Default,,0000,0000,0000,,...جهاز توقيت
Dialogue: 0,0:10:27.21,0:10:31.23,Default,,0000,0000,0000,,ماذا لو كان شيئاً مألوفاً؟
Dialogue: 0,0:10:32.00,0:10:35.46,Default,,0000,0000,0000,,ماذا لو كان شيئاً من الطبيعيّ تواجده هنا
Dialogue: 0,0:10:35.46,0:10:40.23,Default,,0000,0000,0000,,ويمكن التحكّم به عن بعد؟
Dialogue: 0,0:10:40.55,0:10:46.63,Default,,0000,0000,0000,,أجل، أضرم الفاعل الحريق\N!من على بعد عدّة كيلومترات
Dialogue: 0,0:10:46.63,0:10:51.33,Default,,0000,0000,0000,,عبر استعمال شيء معيّن في مكان\N!مجاور لمحلّ الكاراوكي
Dialogue: 0,0:10:54.50,0:10:57.05,Default,,0000,0000,0000,,!يا فتى! أنهينا التجهيزات
Dialogue: 0,0:10:57.05,0:10:59.25,Default,,0000,0000,0000,,!حـ-حسناً! سنأتي الآن
Dialogue: 0,0:10:59.25,0:11:01.42,Default,,0000,0000,0000,,أيّ تجهيزات؟
Dialogue: 0,0:11:01.42,0:11:05.21,Default,,0000,0000,0000,,طلب العمّ منّي أن أجعل رجال الإطفاء\Nيعدّون حيلةً ما
Dialogue: 0,0:11:05.21,0:11:07.71,Default,,0000,0000,0000,,!مشابهة للتي استعملها الفاعل
Dialogue: 0,0:11:10.63,0:11:11.72,Default,,0000,0000,0000,,ما المضحك؟
Dialogue: 0,0:11:12.13,0:11:15.46,Default,,0000,0000,0000,,!إنّها حيلة بسيطة لحدّ الدهشة
Dialogue: 0,0:11:15.46,0:11:17.19,Default,,0000,0000,0000,,لا بدّ أنّكم ستضحكون أيضاً
Dialogue: 0,0:11:22.13,0:11:26.30,Default,,0000,0000,0000,,فهمت، إنّها كغرفة المعيشة قبل الحريق
Dialogue: 0,0:11:26.30,0:11:27.94,Default,,0000,0000,0000,,توجد آلة فاكس حتّى
Dialogue: 0,0:11:27.94,0:11:29.09,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:11:29.09,0:11:31.21,Default,,0000,0000,0000,,لكن كيف سيفيد هذا؟
Dialogue: 0,0:11:31.21,0:11:33.12,Default,,0000,0000,0000,,اعذروني
Dialogue: 0,0:11:34.79,0:11:35.74,Default,,0000,0000,0000,,كعكة؟
Dialogue: 0,0:11:35.74,0:11:37.25,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:11:37.25,0:11:41.21,Default,,0000,0000,0000,,طلبتُ من كونان شراء واحدة
Dialogue: 0,0:11:41.21,0:11:46.63,Default,,0000,0000,0000,,وإذا وضعناها على الكرسيّ\Nأمام آلة الفاكس، ستكتمل التحضيرات
Dialogue: 0,0:11:47.21,0:11:51.85,Default,,0000,0000,0000,,ما بقي الآن هو أن ننتظر\Nنشوب الحريق عند حلول الوقت
Dialogue: 0,0:12:01.09,0:12:02.67,Default,,0000,0000,0000,,المعذرة، موري-سان؟
Dialogue: 0,0:12:02.67,0:12:06.95,Default,,0000,0000,0000,,لا يمكن أنّك تطلب منّا انتظار\Nسقوط الشمعة على الأرض صدفةً، صحيح؟
Dialogue: 0,0:12:07.38,0:12:09.38,Default,,0000,0000,0000,,،كما حتّى لو حصل ذلك
Dialogue: 0,0:12:09.38,0:12:11.96,Default,,0000,0000,0000,,فسيكون مجرّد حادث من الإهمال
Dialogue: 0,0:12:11.96,0:12:13.16,Default,,0000,0000,0000,,...لا يمكن اعتباره حيلة
Dialogue: 0,0:12:18.05,0:12:19.46,Default,,0000,0000,0000,,ا-اتّصال؟
Dialogue: 0,0:12:22.55,0:12:24.38,Default,,0000,0000,0000,,!لا، إنّه فاكس
Dialogue: 0,0:12:27.59,0:12:28.80,Default,,0000,0000,0000,,...لـ-لحظة
Dialogue: 0,0:12:30.80,0:12:31.80,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:12:41.65,0:12:48.61,Default,,0000,0000,0000,,الفاكس الذي وصل الآن قد أرسله\Nمالك متجر التموينات بطلبي
Dialogue: 0,0:12:48.61,0:12:51.07,Default,,0000,0000,0000,,كما أرسله الفاعل قبله
Dialogue: 0,0:12:52.09,0:12:53.45,Default,,0000,0000,0000,,...لا يُعقل
Dialogue: 0,0:12:53.45,0:12:56.04,Default,,0000,0000,0000,,...هذه حيلة بسيطة للغاية... لا يمكن أنّها
Dialogue: 0,0:12:56.04,0:12:58.59,Default,,0000,0000,0000,,كان ذلك هدف الفاعل
Dialogue: 0,0:12:59.50,0:13:03.88,Default,,0000,0000,0000,,كلّما تعقّدت الحيلة، ارتفع احتمال\Nبقاء دليل في مسرح الجريمة
Dialogue: 0,0:13:03.88,0:13:05.71,Default,,0000,0000,0000,,،لذا كانت الفكرة هي تبسيط الحيلة
Dialogue: 0,0:13:05.71,0:13:09.05,Default,,0000,0000,0000,,والتأكّد من عدم بقاء\Nأيّ آثار غير طبيعيّة
Dialogue: 0,0:13:09.05,0:13:12.93,Default,,0000,0000,0000,,فتبدو حريقاً غير مفتعل
Dialogue: 0,0:13:13.63,0:13:14.89,Default,,0000,0000,0000,,ألستُ محقّاً؟
Dialogue: 0,0:13:15.55,0:13:21.15,Default,,0000,0000,0000,,يا من ذهب لمتجر التموينات بجوار\N...محلّ الكاراوكي لشراء السجائر آنذاك
Dialogue: 0,0:13:22.75,0:13:24.86,Default,,0000,0000,0000,,ساواي مانابو-سان؟
Dialogue: 0,0:13:26.05,0:13:28.07,Default,,0000,0000,0000,,أ-أنت يا ساواي-كن؟
Dialogue: 0,0:13:28.07,0:13:31.03,Default,,0000,0000,0000,,لـ-ليس صحيحاً، أليس كذلك يا رئيس؟
Dialogue: 0,0:13:31.03,0:13:36.59,Default,,0000,0000,0000,,!لـ-لكنّه اندفع داخل الحريق لإنقاذ أسامي
Dialogue: 0,0:13:36.59,0:13:39.46,Default,,0000,0000,0000,,أكان سيفعل ذلك لو كان\Nينوي قتلها حقّاً؟
Dialogue: 0,0:13:39.46,0:13:43.09,Default,,0000,0000,0000,,!كما أنّه كان أوّل من لاحظ الحريق
Dialogue: 0,0:13:43.09,0:13:45.96,Default,,0000,0000,0000,,ماذا لو لم يكن ينوي قتلها؟
Dialogue: 0,0:13:46.96,0:13:53.89,Default,,0000,0000,0000,,ماذا لو أضرم هذا الحريق\Nبهدف إنقاذ أسامي-سان منذ البداية؟
Dialogue: 0,0:13:53.89,0:13:57.81,Default,,0000,0000,0000,,...قام ساواي-سان بالتالي غالباً
Dialogue: 0,0:13:58.55,0:14:02.40,Default,,0000,0000,0000,,...وضع حبوب منوّمة في شرابها، وجعلها تنام
Dialogue: 0,0:14:02.71,0:14:07.71,Default,,0000,0000,0000,,وجهّز الحيلة الآنفة الذكر بينما\Nكان الجميع يتجهّزون للذهاب لمحلّ الكاراوكي
Dialogue: 0,0:14:07.71,0:14:09.86,Default,,0000,0000,0000,,ثمّ غادر النزل
Dialogue: 0,0:14:10.55,0:14:13.71,Default,,0000,0000,0000,,وضع أسامي-سان على الأرض\Nبعيداً عن أيّ قطع أثاث
Dialogue: 0,0:14:13.71,0:14:16.33,Default,,0000,0000,0000,,كي يحميها من الاحتراق حتى الموت
Dialogue: 0,0:14:16.33,0:14:21.29,Default,,0000,0000,0000,,،ثمّ ووفق خطّته، بينما كان الجميع يلهون بالكاراوكي
Dialogue: 0,0:14:21.29,0:14:25.71,Default,,0000,0000,0000,,أرسل فاكساً للنزل وأضرم الحريق
Dialogue: 0,0:14:25.88,0:14:33.38,Default,,0000,0000,0000,,ودليلاً على ذلك، فقد رآه مالك متجر التموينات\Nيرسل الفاكس قبل بدء الحريق
Dialogue: 0,0:14:33.38,0:14:37.72,Default,,0000,0000,0000,,وتمّ العثور على بقايا الفاكس المحترقة\Nالذي أرسله أيضاً
Dialogue: 0,0:14:37.72,0:14:38.92,Default,,0000,0000,0000,,بقايا محترقة؟
Dialogue: 0,0:14:38.92,0:14:42.19,Default,,0000,0000,0000,,!هذه! أعطاني إيّاها رجل إطفاء قبل قليل
Dialogue: 0,0:14:42.19,0:14:46.75,Default,,0000,0000,0000,,،انظروا، الشكل لا ينطبق\Nفلا بدّ أنّها كانت صفحتين
Dialogue: 0,0:14:46.75,0:14:51.92,Default,,0000,0000,0000,,،أُرسلت صفحة واحد فحسب قبل الحريق\Nفبدا ذلك غريباً
Dialogue: 0,0:14:51.92,0:14:53.15,Default,,0000,0000,0000,,أليس كذلك يا عمّ؟
Dialogue: 0,0:14:53.15,0:14:58.45,Default,,0000,0000,0000,,ا-انتظر قليلاً! صحيحٌ أنّي استعملت\Nآلة فاكس في متجر التموينات
Dialogue: 0,0:14:58.75,0:15:01.92,Default,,0000,0000,0000,,!لكنّي قد أرسلت الرسالة لأحد أصدقائي
Dialogue: 0,0:15:01.92,0:15:06.25,Default,,0000,0000,0000,,فقد طلب منّي التفكير\Nبعنوان مناسب لروايته
Dialogue: 0,0:15:06.25,0:15:09.42,Default,,0000,0000,0000,,حقّاً؟ صديق؟
Dialogue: 0,0:15:09.42,0:15:12.22,Default,,0000,0000,0000,,كيف تفسّر إيصال الإرسال إذاً؟
Dialogue: 0,0:15:13.34,0:15:19.18,Default,,0000,0000,0000,,أعطيت إيصال الإرسال لمالك المتجر\Nبعدما استعملت آلة الفاكس، أليس كذلك؟
Dialogue: 0,0:15:19.80,0:15:26.65,Default,,0000,0000,0000,,عليه التاريخ والوقت ورقم الهاتف المُرسل إليه، كما بصماتك حتّى
Dialogue: 0,0:15:26.92,0:15:31.25,Default,,0000,0000,0000,,ماذا؟ هذا غريب... أنا متأكّد أنّي أرسلته له
Dialogue: 0,0:15:31.25,0:15:33.00,Default,,0000,0000,0000,,انتظر قليلاً
Dialogue: 0,0:15:34.67,0:15:37.32,Default,,0000,0000,0000,,!فهمت، لا بدّ أنّي طلبت الرقم الخطأ
Dialogue: 0,0:15:37.88,0:15:43.09,Default,,0000,0000,0000,,انظر، رقم هاتف صديقي ورقم هاتف\Nهذا النزل بجوار بعضهما
Dialogue: 0,0:15:43.80,0:15:48.21,Default,,0000,0000,0000,,كما أنّي رئيس نادي دراسة تحرّي جامعة توتو
Dialogue: 0,0:15:48.21,0:15:51.67,Default,,0000,0000,0000,,لن أستعمل حيلةً لا تستطيع التيقّن منها كهذه أبداً
Dialogue: 0,0:15:51.67,0:15:54.72,Default,,0000,0000,0000,,لذا اختبرتها بنسخة
Dialogue: 0,0:15:56.25,0:15:59.88,Default,,0000,0000,0000,,،عندما جهّزت هذه الحيلة في غرفة المعيشة
Dialogue: 0,0:15:59.88,0:16:02.13,Default,,0000,0000,0000,,استعملت خاصيّة النسخ لآلة الفاكس
Dialogue: 0,0:16:02.13,0:16:05.18,Default,,0000,0000,0000,,لرؤية ما إن كانت ستسبّب الحريق حقّاً
Dialogue: 0,0:16:05.55,0:16:11.05,Default,,0000,0000,0000,,كما تعون، تحتاج للورقة الأصليّة لطباعة نسخة لها
Dialogue: 0,0:16:11.05,0:16:17.38,Default,,0000,0000,0000,,فنسخت رسالة التهنئة بعيد الميلاد بالقرب\Nالتي كان البروفسور تاكامورا
Dialogue: 0,0:16:17.38,0:16:18.95,Default,,0000,0000,0000,,قد أرسلها لتوّه
Dialogue: 0,0:16:19.21,0:16:24.91,Default,,0000,0000,0000,,إضافةً لذلك، أرسلت تلك النسخة بالفاكس\Nمن متجر التموينات إلى هنا لاحقاً
Dialogue: 0,0:16:25.30,0:16:30.92,Default,,0000,0000,0000,,النسخة التي احتوت آثار الكعكة والقشدة
Dialogue: 0,0:16:31.46,0:16:37.09,Default,,0000,0000,0000,,اشتكى مالك المتجر من وضعك\Nلورقة دبقة في الآلة
Dialogue: 0,0:16:37.09,0:16:41.05,Default,,0000,0000,0000,,كما ذكر أنّه نبهّك على كونها مقلوبة مراراً
Dialogue: 0,0:16:42.17,0:16:46.48,Default,,0000,0000,0000,,لكن لا عجب، فقد أرسلت الجانب الفارغ من النسخة
Dialogue: 0,0:16:47.13,0:16:51.84,Default,,0000,0000,0000,,لأنّه في حال وجود رسالتَي فاكس بنفس \N،النصّ في مسرح الحريق
Dialogue: 0,0:16:51.84,0:16:54.19,Default,,0000,0000,0000,,سيثير ذلك الشبهة
Dialogue: 0,0:16:54.55,0:16:58.90,Default,,0000,0000,0000,,!يكفي! سئمتُ من هذه الاتّهامات الواهية
Dialogue: 0,0:16:59.07,0:17:01.38,Default,,0000,0000,0000,,!إذا كنت ستواصل ادّعاءاتك، فأرني الدليل
Dialogue: 0,0:17:01.38,0:17:03.37,Default,,0000,0000,0000,,لا تزال تتظاهر بالبراءة؟
Dialogue: 0,0:17:04.09,0:17:08.83,Default,,0000,0000,0000,,لا تزال تملك الفاكس المقصود معك
Dialogue: 0,0:17:09.55,0:17:12.09,Default,,0000,0000,0000,,البشر غريبون بحقّ
Dialogue: 0,0:17:12.09,0:17:16.84,Default,,0000,0000,0000,,لا يمكنهم إلقاء شيءٍ قد يعرّضهم للخطر بسهولة
Dialogue: 0,0:17:17.25,0:17:21.34,Default,,0000,0000,0000,,يصارعون قلقهم من أخذ أحد له
Dialogue: 0,0:17:22.55,0:17:24.50,Default,,0000,0000,0000,,أنت خير مثال
Dialogue: 0,0:17:24.50,0:17:27.21,Default,,0000,0000,0000,,جلبتَه معك من متجر التموينات حتّى
Dialogue: 0,0:17:27.21,0:17:28.23,Default,,0000,0000,0000,,أيمكن إذاً؟
Dialogue: 0,0:17:28.59,0:17:33.15,Default,,0000,0000,0000,,...أجل، لا يزال يحمله معه في مكانٍ ما
Dialogue: 0,0:17:33.75,0:17:39.80,Default,,0000,0000,0000,,الفاكس برسالة البروفسور تاكامورا\N!وآثار القشدة
Dialogue: 0,0:17:40.50,0:17:41.63,Default,,0000,0000,0000,,...اعذرنا
Dialogue: 0,0:17:41.63,0:17:42.66,Default,,0000,0000,0000,,!لا تلمسوني
Dialogue: 0,0:17:45.59,0:17:50.08,Default,,0000,0000,0000,,!يا للسخافة! كان عليّ التخلّص منه
Dialogue: 0,0:17:52.59,0:17:55.55,Default,,0000,0000,0000,,أ-أكان أنت حقّاً إذاً؟
Dialogue: 0,0:17:55.55,0:18:01.34,Default,,0000,0000,0000,,أجل، أضرمتُ الحريق، بنفس الطريقة\Nالتي شرحها المتحرّي
Dialogue: 0,0:18:01.34,0:18:06.71,Default,,0000,0000,0000,,لكن كيف عرفت أنّه كان أنا؟\Nكان بإمكان أيّ أحد استعمال هذه الطريقة
Dialogue: 0,0:18:06.71,0:18:10.68,Default,,0000,0000,0000,,استرجع ما حصل عندما هرعنا إلى هنا
Dialogue: 0,0:18:11.88,0:18:14.81,Default,,0000,0000,0000,,هل نتّصل بالهاتف ونوقظها؟ فقد كانت\N!نائمة في غرفة المعيشة
Dialogue: 0,0:18:14.81,0:18:17.58,Default,,0000,0000,0000,,!لا جدوى، لقد احترق بالفعل
Dialogue: 0,0:18:19.59,0:18:24.88,Default,,0000,0000,0000,,فهمت، شيء لا يقوله إلّا من \Nعرف أين كان الحريق
Dialogue: 0,0:18:24.88,0:18:27.92,Default,,0000,0000,0000,,لكن لمَ قد تفعل ذلك لأسامي؟
Dialogue: 0,0:18:27.92,0:18:30.38,Default,,0000,0000,0000,,أردتُها أن تحبّني
Dialogue: 0,0:18:31.09,0:18:35.75,Default,,0000,0000,0000,,كالرجل الشجاع الذي خاطر بحياته\Nلإنقاذها من ألسنة اللهب
Dialogue: 0,0:18:36.50,0:18:40.71,Default,,0000,0000,0000,,رفضت طلبي بمواعدتها الشهر الفائت
Dialogue: 0,0:18:40.71,0:18:44.50,Default,,0000,0000,0000,,لم يحصل ذلك لي قطّ قبلاً، فلم أستطع تحمّل الأمر
Dialogue: 0,0:18:44.50,0:18:49.18,Default,,0000,0000,0000,,،كنت أنوي إضرام حريق صغير فحسب\Nلكنّه انتشر أكثر مما ظننت
Dialogue: 0,0:18:49.18,0:18:50.10,Default,,0000,0000,0000,,!يا أحمق
Dialogue: 0,0:18:51.05,0:18:54.56,Default,,0000,0000,0000,,!حريق صغير؟! انتشر أكثر مما ظننت؟
Dialogue: 0,0:18:54.88,0:18:58.77,Default,,0000,0000,0000,,!أتظنّ هذه أعذاراً؟! لا تعبث معي
Dialogue: 0,0:18:59.17,0:19:03.71,Default,,0000,0000,0000,,لمَ لم تحسب لموت أسامي-سان حرقاً؟
Dialogue: 0,0:19:03.71,0:19:08.05,Default,,0000,0000,0000,,!لربّما واجهت السيّارة المتوجّهة لها حادثاً\N!أو ثُقبت إحدى إطاراتها
Dialogue: 0,0:19:08.05,0:19:09.58,Default,,0000,0000,0000,,!أو كان هناك ازدحام
Dialogue: 0,0:19:10.05,0:19:14.50,Default,,0000,0000,0000,,!كانت أسامي-سان لتفارقنا في أيٍّ من هذه الحالات
Dialogue: 0,0:19:14.80,0:19:16.96,Default,,0000,0000,0000,,،إذا أردت إثارة إعجابها
Dialogue: 0,0:19:16.96,0:19:20.59,Default,,0000,0000,0000,,فلمَ لم تفكّر بأن تصبح\N!إنساناً يعجبها بطبيعته؟
Dialogue: 0,0:19:20.59,0:19:25.36,Default,,0000,0000,0000,,!لمَ لم تفكّر بتحسين صفاتك؟
Dialogue: 0,0:19:26.70,0:19:28.17,Default,,0000,0000,0000,,...بالفعل
Dialogue: 0,0:19:28.50,0:19:30.05,Default,,0000,0000,0000,,كنتَ أحمقاً يا رئيس
Dialogue: 0,0:19:31.05,0:19:32.18,Default,,0000,0000,0000,,أسامي؟
Dialogue: 0,0:19:32.71,0:19:33.92,Default,,0000,0000,0000,,اقترفتُ أمراً فظيعاً
Dialogue: 0,0:19:34.27,0:19:36.92,Default,,0000,0000,0000,,...لا أصدّق أنّك فعلت هذا لأجلي
Dialogue: 0,0:19:37.14,0:19:40.21,Default,,0000,0000,0000,,هيّا، يمكنك تأجيل الكلام\Nلحين وصولنا مركز الشرطة
Dialogue: 0,0:19:40.58,0:19:41.25,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:19:48.58,0:19:49.53,Default,,0000,0000,0000,,يا رئيس
Dialogue: 0,0:19:52.16,0:19:56.95,Default,,0000,0000,0000,,لا يمكنك فتح أبواب قلوب الناس بالقوّة
Dialogue: 0,0:19:57.79,0:19:59.45,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:19:59.45,0:20:03.91,Default,,0000,0000,0000,,رغم أنّي أرجّح أنّك قادرة \Nعلى خطف أيّ رجل بمجرّد نَفس لك
Dialogue: 0,0:20:08.12,0:20:09.84,Default,,0000,0000,0000,,ليس صحيحاً
Dialogue: 0,0:20:10.37,0:20:12.95,Default,,0000,0000,0000,,فأنت لا تعرفني
Dialogue: 0,0:20:12.95,0:20:14.80,Default,,0000,0000,0000,,...حتّى أنا، في الماضي
Dialogue: 0,0:20:15.95,0:20:17.05,Default,,0000,0000,0000,,...في الماضي
Dialogue: 0,0:21:45.53,0:21:48.09,Default,,0000,0000,0000,,!ماذا؟ اعترفتِ لشينتشي-كن؟
Dialogue: 0,0:21:48.30,0:21:51.11,Default,,0000,0000,0000,,أجل، كنتُ أنا من اعترفت
Dialogue: 0,0:21:51.41,0:21:53.28,Default,,0000,0000,0000,,لكنّه رفضني تماماً
Dialogue: 0,0:21:53.63,0:21:55.11,Default,,0000,0000,0000,,...لـ-لكن وفق الشائعة
Dialogue: 0,0:21:55.11,0:21:58.56,Default,,0000,0000,0000,,كنتُ أنا من نشرها
Dialogue: 0,0:21:59.20,0:22:03.15,Default,,0000,0000,0000,,أردت أن أجذبه لي بأيّ شكل، فقد كان حبّي الأوّل
Dialogue: 0,0:22:03.15,0:22:07.03,Default,,0000,0000,0000,,لكن لم يظهر عليه أنّه\Nمهتمّ بها البتّة
Dialogue: 0,0:22:08.82,0:22:11.78,Default,,0000,0000,0000,,...عذراً، هناك ما أودّ السؤال عنه
Dialogue: 0,0:22:11.78,0:22:15.00,Default,,0000,0000,0000,,ما الذي أعجبك فيه بالضبط؟
Dialogue: 0,0:22:15.74,0:22:19.99,Default,,0000,0000,0000,,حسناً، لم يخطف انتباهي حقّاً بدايةً
Dialogue: 0,0:22:20.25,0:22:23.78,Default,,0000,0000,0000,,في سنته الأولى، كان لاعب وسط\Nأساسيّ في فريق كرة القدم
Dialogue: 0,0:22:23.78,0:22:27.22,Default,,0000,0000,0000,,ظننتُه مبتدئاً مُبهراً، لا أكثر من ذلك
Dialogue: 0,0:22:27.34,0:22:32.57,Default,,0000,0000,0000,,لكن في أحد الأيام، وزّعتُ فطيرة ليمون\Nعلى أعضاء فريق كرة القدم
Dialogue: 0,0:22:32.57,0:22:36.68,Default,,0000,0000,0000,,...أخبرني الجميع أنّها لذيذة، باستثنائه عندما قال
Dialogue: 0,0:22:38.11,0:22:41.15,Default,,0000,0000,0000,,ماذا؟ هذه سيّئة نوعاً ما
Dialogue: 0,0:22:41.52,0:22:43.86,Default,,0000,0000,0000,,!حسّ تذوّق شينتشي غريب
Dialogue: 0,0:22:44.11,0:22:47.74,Default,,0000,0000,0000,,كلا، أتوقّع أنّها لم تكن\Nلذيذةً بالفعل آنذاك
Dialogue: 0,0:22:48.02,0:22:51.20,Default,,0000,0000,0000,,عندما سألتُ الجميع بعد فترة، أخبروني أنّهم\Nتظاهروا بإعجابهم بمذاقها
Dialogue: 0,0:22:51.48,0:22:56.74,Default,,0000,0000,0000,,أغاظني ذلك، فصرتُ أخبز فطيرةً كلّ يوم\Nلمدّة ثلاثة أشهر
Dialogue: 0,0:22:56.74,0:22:58.82,Default,,0000,0000,0000,,حتّى قال أنّها لذيذة
Dialogue: 0,0:22:58.82,0:23:02.40,Default,,0000,0000,0000,,ودون أن أدرك، كنت قد أصبحت\Nمديرة نادي كرق القدم
Dialogue: 0,0:23:02.40,0:23:04.61,Default,,0000,0000,0000,,وأُغرمت به
Dialogue: 0,0:23:04.79,0:23:07.80,Default,,0000,0000,0000,,هناك من نجحت في محاولتها الأولى مع ذلك
Dialogue: 0,0:23:08.79,0:23:13.81,Default,,0000,0000,0000,,أكنتِ تعرفين؟ تلاعبت بك وعلّمتك\N!طريقة غريبة لصنعها
Dialogue: 0,0:23:14.01,0:23:15.96,Default,,0000,0000,0000,,ماذا؟ لمَ؟
Dialogue: 0,0:23:15.96,0:23:22.43,Default,,0000,0000,0000,,يا إلهي، هل أخبرك بما قاله\Nبعدما اعترفت له إذاً؟
Dialogue: 0,0:23:22.43,0:23:24.10,Default,,0000,0000,0000,,...ا-اسمعي
Dialogue: 0,0:23:24.65,0:23:28.39,Default,,0000,0000,0000,,!اصمت! الموضوع يصبح مثيراً الآن، فاسكت
Dialogue: 0,0:23:28.65,0:23:31.72,Default,,0000,0000,0000,,...قال هذا والإحراج مرسومٌ على وجهه
Dialogue: 0,0:23:34.81,0:23:36.56,Default,,0000,0000,0000,,آسفٌ يا سينباي
Dialogue: 0,0:23:36.56,0:23:40.48,Default,,0000,0000,0000,,هناك من أنا مهتمٌّ بها مُذ صغري
Dialogue: 0,0:23:40.48,0:23:44.48,Default,,0000,0000,0000,,إنّها قويّة الإرادة وعنيدة، لكن تنزل دموعها سريعاً
Dialogue: 0,0:23:44.48,0:23:46.50,Default,,0000,0000,0000,,...غرابتها هذه هي التي
Dialogue: 0,0:23:47.65,0:23:48.83,Default,,0000,0000,0000,,وهذا ما حصل
Dialogue: 0,0:23:49.91,0:23:52.57,Default,,0000,0000,0000,,ا-انتظري يا ران! أيمكن أنّ تلك...؟
Dialogue: 0,0:23:53.70,0:23:55.48,Default,,0000,0000,0000,,أتذكرين فتاةً كهذه؟
Dialogue: 0,0:23:55.48,0:23:56.47,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:23:58.44,0:23:59.83,Default,,0000,0000,0000,,...لا يهمّ
Dialogue: 0,0:24:07.05,0:24:08.89,Default,,0000,0000,0000,,!لا تتظاهر بالحماقة يا أوكيتا
Dialogue: 0,0:24:08.89,0:24:13.10,Default,,0000,0000,0000,,رأينا إيسامي-سان تنهار\N!على الفرشة في غرفتك
Dialogue: 0,0:24:13.85,0:24:17.48,Default,,0000,0000,0000,,يبدو أنّ الفاعل هو أكيتا-سان حقّاً
Dialogue: 0,0:24:21.89,0:24:25.69,Default,,0000,0000,0000,,...انتظر، أيمكن أنّ هذه القضيّة
Dialogue: 0,0:24:25.54,0:24:31.54,On Top,,0000,0000,0000,,جريمة قتل مُمثل الدراما التاريخيّة\N(الجزء الأوّل)
Dialogue: 0,0:24:26.47,0:24:27.93,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.93,0:24:31.39,Default,,0000,0000,0000,,جريمة قتل مُمثل الدراما التاريخيّة\N(الجزء الأوّل)
Dialogue: 0,0:24:46.97,0:24:49.41,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.41,0:24:51.41,Default,,0000,0000,0000,,هاتف

