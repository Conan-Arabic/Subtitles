Dialogue: 0,0:00:01.17,0:00:02.27,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.67,0:00:05.44,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.82,0:00:08.44,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.44,0:00:11.69,Default,,0000,0000,0000,,قضية اليوم تتمة لجريمة قتل\N!مناسبة لمّ الشمل
Dialogue: 0,0:00:11.69,0:00:15.49,Default,,0000,0000,0000,,"لنستمع لـ "موني وا دوكي دوكي\N!بينما نراجع الحلقة الماضية
Dialogue: 0,0:01:46.47,0:01:51.55,Default,,0000,0000,0000,,أتى العمّ لمناسبة لمّ شمل مع زملائه من الجامعة\N"في منتجع الينابيع الساخنة "بينكي
Dialogue: 0,0:01:51.55,0:01:54.55,Default,,0000,0000,0000,,وكان الحاضرون مديرة النادي، هوريكوشي يومي
Dialogue: 0,0:01:54.55,0:01:57.55,Default,,0000,0000,0000,,ومالك متجر النماذج، أومورا جون
Dialogue: 0,0:01:57.84,0:02:00.55,Default,,0000,0000,0000,,،ومدرّس التربية البدنية في الثانوية، أياشيرو يوكيو
Dialogue: 0,0:02:00.55,0:02:03.05,Default,,0000,0000,0000,,وزوجته أياشيرو نوريكو
Dialogue: 0,0:02:03.34,0:02:06.04,Default,,0000,0000,0000,,كما المحقّق في شرطة محافظة تشيبا، ناكاميتشي كازوشي
Dialogue: 0,0:02:06.04,0:02:08.59,Default,,0000,0000,0000,,وأخيرًا، أنا وران مع العمّ
Dialogue: 0,0:02:09.37,0:02:11.72,Default,,0000,0000,0000,,ذهبنا لإيقاظ هوريكوشي يومي
Dialogue: 0,0:02:11.72,0:02:15.12,Default,,0000,0000,0000,,التي كانت لا تزال نائمة في غرفتها\Nبعد نهاية عرض الألعاب النارية
Dialogue: 0,0:02:15.12,0:02:17.13,Default,,0000,0000,0000,,ووجدناها ميتةً بعد إطلاقها النار
Dialogue: 0,0:02:17.13,0:02:18.61,Default,,0000,0000,0000,,على رأسها مُنتحرة
Dialogue: 0,0:02:20.42,0:02:24.86,Default,,0000,0000,0000,,أظهرت نتائج التشريح السريع أنّها\Nماتت قبل 7 ساعات
Dialogue: 0,0:02:24.86,0:02:28.31,Default,,0000,0000,0000,,عند الثالثة مساءً أثناء لعب الجميع لكرة الطاولة
Dialogue: 0,0:02:28.31,0:02:29.98,Default,,0000,0000,0000,,قبل المغادرة لعرض الألعاب النارية
Dialogue: 0,0:02:33.43,0:02:37.94,Default,,0000,0000,0000,,جريمة قتل مناسبة لمّ شمل كوغورو\N(الجزء الثاني)
Dialogue: 0,0:02:39.05,0:02:41.38,Default,,0000,0000,0000,,...سبق أن قالت يومي
Dialogue: 0,0:02:41.38,0:02:44.80,Default,,0000,0000,0000,,أتمنّى لو كنت ميتة حقاً
Dialogue: 0,0:02:44.80,0:02:47.46,Default,,0000,0000,0000,,لا بدّ أنّها كانت تعاني
Dialogue: 0,0:02:48.00,0:02:51.79,Default,,0000,0000,0000,,كيف أطلقت يومي-سان النار على رأسها؟
Dialogue: 0,0:02:51.79,0:02:53.25,Default,,0000,0000,0000,,ما الذي تقوله يا كونان-كن؟
Dialogue: 0,0:02:53.25,0:02:54.50,Default,,0000,0000,0000,,!لا تطرح أسئلة غريبة
Dialogue: 0,0:02:54.50,0:02:55.43,Default,,0000,0000,0000,,!كيف؟
Dialogue: 0,0:02:55.65,0:02:57.24,Default,,0000,0000,0000,,ذلك واضح
Dialogue: 0,0:02:57.24,0:03:00.36,Default,,0000,0000,0000,,...صوّبت على رأسها هكذا و
Dialogue: 0,0:03:02.57,0:03:05.52,Default,,0000,0000,0000,,!موري! ما الخطب؟! ماذا هناك؟
Dialogue: 0,0:03:06.98,0:03:08.02,Default,,0000,0000,0000,,!موري
Dialogue: 0,0:03:08.02,0:03:09.31,Default,,0000,0000,0000,,ناكاميتشي
Dialogue: 0,0:03:09.31,0:03:11.31,Default,,0000,0000,0000,,عندما ينتحر أحدهم بمسدّس عادةً
Dialogue: 0,0:03:11.31,0:03:13.98,Default,,0000,0000,0000,,يلصق الفوهة برأسه، صحيح؟
Dialogue: 0,0:03:13.98,0:03:14.76,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:14.76,0:03:18.38,Default,,0000,0000,0000,,هناك أمرٌ ناقص في جرحها إذاً
Dialogue: 0,0:03:21.47,0:03:24.22,Default,,0000,0000,0000,,!معك حق! علامات الحرق
Dialogue: 0,0:03:24.22,0:03:25.66,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:25.66,0:03:30.79,Default,,0000,0000,0000,,عندما تطلق من مسدّس، سيصاحب\Nالرصاصة تيّار هواء ساخن
Dialogue: 0,0:03:30.79,0:03:33.00,Default,,0000,0000,0000,,إن أطلقت بالمسدّس بينما يلامس رأسك مباشرةً
Dialogue: 0,0:03:33.00,0:03:35.63,Default,,0000,0000,0000,,ستبقى آثار احتراق بلا شك
Dialogue: 0,0:03:35.63,0:03:37.86,Default,,0000,0000,0000,,...لكن عدم وجود أيٍّ منها
Dialogue: 0,0:03:37.86,0:03:41.09,Default,,0000,0000,0000,,تقصد أنّ شخصاً آخر أطلق عليها؟
Dialogue: 0,0:03:41.57,0:03:42.57,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:42.57,0:03:46.10,Default,,0000,0000,0000,,قتل أحدهم يومي\Nوزيّف الأمر ليبدو انتحاراً
Dialogue: 0,0:03:46.10,0:03:49.05,Default,,0000,0000,0000,,...أحد في هذا النُزل
Dialogue: 0,0:03:58.76,0:04:02.72,Default,,0000,0000,0000,,لا تعتقدا أنّ أحداً بيننا فعلها، صحيح؟
Dialogue: 0,0:04:02.97,0:04:05.13,Default,,0000,0000,0000,,لا تستبق الأحداث
Dialogue: 0,0:04:05.13,0:04:08.92,Default,,0000,0000,0000,,قلنا أنّ الجريمة وقعت عند قرابة الثالثة مساءً
Dialogue: 0,0:04:08.92,0:04:11.33,Default,,0000,0000,0000,,أي بعد تركها لنا مباشرةً
Dialogue: 0,0:04:11.33,0:04:15.00,Default,,0000,0000,0000,,كنّا جميعاً في غرفة كرة الطاولة\Nمن الثالثة حتّى السادسة
Dialogue: 0,0:04:15.00,0:04:16.67,Default,,0000,0000,0000,,فيستحيل أنّ أحدنا ارتكبها
Dialogue: 0,0:04:17.07,0:04:19.61,Default,,0000,0000,0000,,الوحيد الذي غادر
Dialogue: 0,0:04:19.61,0:04:21.38,Default,,0000,0000,0000,,كان أومورا عند ذهابه لدورة المياه
Dialogue: 0,0:04:21.99,0:04:24.32,Default,,0000,0000,0000,,لكن كان ذلك بعد الخامسة
Dialogue: 0,0:04:24.32,0:04:26.38,Default,,0000,0000,0000,,كما عاد في أقلّ من دقيقة
Dialogue: 0,0:04:26.38,0:04:28.71,Default,,0000,0000,0000,,يستحيل أنّ أومورا ارتكبها أيضاً
Dialogue: 0,0:04:28.98,0:04:31.17,Default,,0000,0000,0000,,كانت جريمةً خارجية إذاً؟
Dialogue: 0,0:04:31.17,0:04:33.84,Default,,0000,0000,0000,,أجل، ربما
Dialogue: 0,0:04:37.47,0:04:38.97,Default,,0000,0000,0000,,كما ترون
Dialogue: 0,0:04:38.97,0:04:41.14,Default,,0000,0000,0000,,كان بمقدرة القاتل الذهاب لأيّ مكان على السقف
Dialogue: 0,0:04:41.14,0:04:43.89,Default,,0000,0000,0000,,كما أنّ الباب لم يكن مقفلاً
Dialogue: 0,0:04:44.09,0:04:47.57,Default,,0000,0000,0000,,من المحتمل جدّاً تسلل أحدهم من الخارج
Dialogue: 0,0:04:48.59,0:04:51.01,Default,,0000,0000,0000,,لنستجوب موظّفي النُزل بأيّ حال
Dialogue: 0,0:04:51.38,0:04:54.96,Default,,0000,0000,0000,,ربما رأى أحدهم شخصاً مشبوهاً
Dialogue: 0,0:05:05.98,0:05:08.23,Default,,0000,0000,0000,,شخص مشبوه؟
Dialogue: 0,0:05:08.23,0:05:13.09,Default,,0000,0000,0000,,خرجنا جميعاً لتناول الغداء عند الثالثة
Dialogue: 0,0:05:13.09,0:05:17.39,Default,,0000,0000,0000,,...ولم نجد شخصاً مشبوهاً لذاك الحد بعد عودتنا
Dialogue: 0,0:05:17.39,0:05:20.04,Default,,0000,0000,0000,,!لحظة، كان هناك واحد
Dialogue: 0,0:05:21.14,0:05:22.38,Default,,0000,0000,0000,,كيف كان؟
Dialogue: 0,0:05:22.38,0:05:24.39,Default,,0000,0000,0000,,كانت شابةً مع صبيّ
Dialogue: 0,0:05:24.39,0:05:29.34,Default,,0000,0000,0000,,بدت متوترةً جداً وهرعت للطابق العلوي
Dialogue: 0,0:05:29.34,0:05:31.29,Default,,0000,0000,0000,,أيمكنك وصف تلك الفتاة؟
Dialogue: 0,0:05:31.29,0:05:34.34,Default,,0000,0000,0000,,إنّها وراءكما
Dialogue: 0,0:05:34.34,0:05:36.28,Default,,0000,0000,0000,,إنّها تلك الفتاة والصبيّ
Dialogue: 0,0:05:38.16,0:05:42.51,Default,,0000,0000,0000,,أظنّ ذلك كان عند السادسة والنصف\Nمع بدء الألعاب النارية
Dialogue: 0,0:05:42.51,0:05:44.83,Default,,0000,0000,0000,,تقصد عندما ذهبنا لإيقاظ يومي-سان
Dialogue: 0,0:05:44.83,0:05:47.02,Default,,0000,0000,0000,,كيلا تفوتها الألعاب النارية
Dialogue: 0,0:05:47.02,0:05:48.65,Default,,0000,0000,0000,,...حينذاك إذاً
Dialogue: 0,0:05:48.65,0:05:52.47,Default,,0000,0000,0000,,...ذهبنا لغرفتها وكنّا على وشك الدخول
Dialogue: 0,0:05:52.86,0:05:54.69,Default,,0000,0000,0000,,لكنّي أوقفتهما
Dialogue: 0,0:05:54.69,0:05:56.47,Default,,0000,0000,0000,,مزاج يومي يتعكر عند استيقاظها
Dialogue: 0,0:05:56.47,0:05:58.64,Default,,0000,0000,0000,,لذا حذّرتهما من إيقاظها
Dialogue: 0,0:05:58.64,0:06:02.86,Default,,0000,0000,0000,,ناكاميتشي؟ كنت لا تزال في النُزل؟
Dialogue: 0,0:06:02.86,0:06:05.75,Default,,0000,0000,0000,,أجل، تعرّقتُ كثيراً بعد لعب كرة الطاولة
Dialogue: 0,0:06:05.75,0:06:08.17,Default,,0000,0000,0000,,فاستحممت في الحمام العام
Dialogue: 0,0:06:08.17,0:06:13.09,Default,,0000,0000,0000,,أنّبني ضميري لتركك وأومورا تذهبان قبلنا لحجز موقع
Dialogue: 0,0:06:13.46,0:06:16.83,Default,,0000,0000,0000,,لكنّكما كنتما تستحمان أيضاً، صحيح؟
Dialogue: 0,0:06:16.83,0:06:20.05,Default,,0000,0000,0000,,أجل، لكنّنا كنا في الحمام المفتوح
Dialogue: 0,0:06:20.33,0:06:26.15,Default,,0000,0000,0000,,...لو ذهبنا لإيقاظها آنذاك، لربما
Dialogue: 0,0:06:26.15,0:06:27.98,Default,,0000,0000,0000,,ما الذي تقولينه؟
Dialogue: 0,0:06:27.98,0:06:31.57,Default,,0000,0000,0000,,ماتت يومي بينما كنّا نلعب كرة الطاولة
Dialogue: 0,0:06:31.57,0:06:33.26,Default,,0000,0000,0000,,لم نكن لنصل في الوقت بأيّ حال
Dialogue: 0,0:06:33.26,0:06:35.71,Default,,0000,0000,0000,,أيمكنني سؤالك عن شيء؟
Dialogue: 0,0:06:36.93,0:06:37.97,Default,,0000,0000,0000,,حسناً يا أومورا
Dialogue: 0,0:06:37.97,0:06:40.64,Default,,0000,0000,0000,,أنت تخفي شيئاً، صحيح؟
Dialogue: 0,0:06:40.64,0:06:43.14,Default,,0000,0000,0000,,كنتَ تتصرف بغرابة هذا المساء
Dialogue: 0,0:06:44.26,0:06:46.80,Default,,0000,0000,0000,,!اعترف! ما الذي تخفيه؟
Dialogue: 0,0:06:46.80,0:06:48.84,Default,,0000,0000,0000,,...لا شيء
Dialogue: 0,0:06:48.84,0:06:50.52,Default,,0000,0000,0000,,...أيمكن أنّك
Dialogue: 0,0:06:50.52,0:06:51.92,Default,,0000,0000,0000,,!لقد رأيت
Dialogue: 0,0:06:51.92,0:06:54.59,Default,,0000,0000,0000,,!عندما ذهبت لدورة المياه
Dialogue: 0,0:06:54.59,0:06:55.84,Default,,0000,0000,0000,,رأيت القاتل؟
Dialogue: 0,0:06:56.08,0:06:58.79,Default,,0000,0000,0000,,كلا، رأيتُ يومي
Dialogue: 0,0:06:58.79,0:07:00.54,Default,,0000,0000,0000,,ما الذي تتكلم عنه؟
Dialogue: 0,0:07:00.54,0:07:03.16,Default,,0000,0000,0000,,ذهبت لدورة المياه بعد الخامسة
Dialogue: 0,0:07:03.16,0:07:05.54,Default,,0000,0000,0000,,كانت يوري ميتةً في ذاك الوقت
Dialogue: 0,0:07:05.54,0:07:07.40,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:07:07.40,0:07:10.03,Default,,0000,0000,0000,,!رأيتُها بينما يُفترض أنها ميتة
Dialogue: 0,0:07:10.24,0:07:14.18,Default,,0000,0000,0000,,كانت تحدّق بنظرات مخيفة نحو غرفة كرة الطاولة\N!من نافذة الطابق العلوي
Dialogue: 0,0:07:14.18,0:07:17.07,Default,,0000,0000,0000,,...لا يمكن! كيف ويُفترض أنها ماتت
Dialogue: 0,0:07:17.07,0:07:19.34,Default,,0000,0000,0000,,!لا تكن أحمق! هذا مستحيل
Dialogue: 0,0:07:19.77,0:07:25.14,Default,,0000,0000,0000,,...ماذا لو ما رأيته كان... كان
Dialogue: 0,0:07:27.35,0:07:31.05,Default,,0000,0000,0000,,!ارجع لصوابك! لا وجود للأشباح
Dialogue: 0,0:07:31.97,0:07:34.88,Default,,0000,0000,0000,,كان دماغك مشوّشاً من الإرهاق فقط
Dialogue: 0,0:07:34.88,0:07:37.10,Default,,0000,0000,0000,,لذا كنتَ تتخيّل أشياء كتلك
Dialogue: 0,0:07:37.10,0:07:38.54,Default,,0000,0000,0000,,...ر-ربما
Dialogue: 0,0:07:40.54,0:07:44.42,Default,,0000,0000,0000,,أحصل شيءٌ ما في نُزلنا؟
Dialogue: 0,0:07:44.42,0:07:46.33,Default,,0000,0000,0000,,ما هذا الكلام عن الأشباح والموت؟
Dialogue: 0,0:07:46.33,0:07:50.70,Default,,0000,0000,0000,,أُرديت صديقتنا بالنار
Dialogue: 0,0:07:50.70,0:07:53.09,Default,,0000,0000,0000,,!علينا علاجها فوراً إذاً
Dialogue: 0,0:07:53.32,0:07:55.16,Default,,0000,0000,0000,,فات الأوان
Dialogue: 0,0:07:55.16,0:07:57.52,Default,,0000,0000,0000,,الشرطة في طريقها بينما نتكلم
Dialogue: 0,0:07:58.60,0:08:01.19,Default,,0000,0000,0000,,لحظة، هذا غريب
Dialogue: 0,0:08:01.19,0:08:04.05,Default,,0000,0000,0000,,لمَ قال الشخص هذا في ذاك الوقت؟
Dialogue: 0,0:08:04.31,0:08:09.51,Default,,0000,0000,0000,,أيمكن أنّ المجرم بينكم؟
Dialogue: 0,0:08:09.51,0:08:11.34,Default,,0000,0000,0000,,!بالطبع لا
Dialogue: 0,0:08:11.34,0:08:14.51,Default,,0000,0000,0000,,كان المجرم شخصاً من الخارج! لا حاجة للقلق
Dialogue: 0,0:08:14.51,0:08:15.89,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:08:15.89,0:08:17.92,Default,,0000,0000,0000,,ناكاميتشي، أترك الباقي لك
Dialogue: 0,0:08:17.92,0:08:19.42,Default,,0000,0000,0000,,سأذهب لدورة المياه
Dialogue: 0,0:08:20.04,0:08:21.05,Default,,0000,0000,0000,,!أنت، موري
Dialogue: 0,0:08:22.80,0:08:27.91,Default,,0000,0000,0000,,أليس الجزم بأنّها جريمة خارجية أمراً مبكراً يا عمّ؟
Dialogue: 0,0:08:27.91,0:08:30.12,Default,,0000,0000,0000,,...فالطريقة التي قُتلت فيها يومي-سان
Dialogue: 0,0:08:30.12,0:08:31.76,Default,,0000,0000,0000,,أتسمعني يا عمّ؟
Dialogue: 0,0:08:33.68,0:08:37.10,Default,,0000,0000,0000,,!اخرس! لا أحتاج ثرثرتك
Dialogue: 0,0:08:38.27,0:08:40.23,Default,,0000,0000,0000,,لم تكن جريمة خارجية
Dialogue: 0,0:08:40.23,0:08:42.69,Default,,0000,0000,0000,,هل يُقدم شخص تسلّل من الخارج
Dialogue: 0,0:08:42.69,0:08:45.06,Default,,0000,0000,0000,,على قتل أحدهم ثمّ تكبّد جعله انتحاراً؟
Dialogue: 0,0:08:45.40,0:08:47.51,Default,,0000,0000,0000,,!كان المجرم من الداخل
Dialogue: 0,0:08:47.51,0:08:50.47,Default,,0000,0000,0000,,!أي أحد أصدقائي المقرّبين
Dialogue: 0,0:08:51.01,0:08:54.89,Default,,0000,0000,0000,,لا أعرف دافعه أو أيّ حيلة استعمل
Dialogue: 0,0:08:54.89,0:08:58.42,Default,,0000,0000,0000,,!لكنّه لن يفلت أبداً
Dialogue: 0,0:08:58.42,0:09:01.30,Default,,0000,0000,0000,,!سأسحبه للعلن بالتأكيد! أقسم بذلك
Dialogue: 0,0:09:04.50,0:09:05.81,Default,,0000,0000,0000,,...عمّ
Dialogue: 0,0:09:08.87,0:09:10.70,Default,,0000,0000,0000,,معه حقّ
Dialogue: 0,0:09:10.70,0:09:13.49,Default,,0000,0000,0000,,المجرم أحد أولئك الأربعة
Dialogue: 0,0:09:13.49,0:09:16.53,Default,,0000,0000,0000,,كلا، لديّ فكرة عمّن يكون
Dialogue: 0,0:09:16.53,0:09:19.97,Default,,0000,0000,0000,,إنّه ذاك الذي تفوّه بالكلام الغريب آنذاك
Dialogue: 0,0:09:20.19,0:09:22.55,Default,,0000,0000,0000,,لكنه يملك حجّة غياب قويّة
Dialogue: 0,0:09:22.55,0:09:26.14,Default,,0000,0000,0000,,فقد كان في غرفة كرة الطاولة مع الجميع
Dialogue: 0,0:09:26.77,0:09:29.56,Default,,0000,0000,0000,,تحققتُ من زمن وفاة يومي-سان بنفسي
Dialogue: 0,0:09:29.56,0:09:31.26,Default,,0000,0000,0000,,فلا خطأ فيه
Dialogue: 0,0:09:31.26,0:09:34.97,Default,,0000,0000,0000,,إذاً كيف فعلها ذاك الشخص؟
Dialogue: 0,0:09:34.97,0:09:36.26,Default,,0000,0000,0000,,ما يضايقني
Dialogue: 0,0:09:36.26,0:09:38.67,Default,,0000,0000,0000,,هو عدم وجود إصبع يومي-سان على زناد المسدّس
Dialogue: 0,0:09:38.67,0:09:40.84,Default,,0000,0000,0000,,الذي كان في يدها
Dialogue: 0,0:09:41.30,0:09:43.30,Default,,0000,0000,0000,,...يُفترض أنّ القاتل سيضعه عادةً
Dialogue: 0,0:09:43.30,0:09:44.55,Default,,0000,0000,0000,,لتزييف الانتحار
Dialogue: 0,0:09:44.88,0:09:48.04,Default,,0000,0000,0000,,كما يحيّرني عدم وجود ملابس داخلية عليها
Dialogue: 0,0:09:48.04,0:09:50.84,Default,,0000,0000,0000,,وتغيير ثوبها ليوكاتا كبير المقاس
Dialogue: 0,0:09:51.91,0:09:54.70,Default,,0000,0000,0000,,أيمكن أنّ القاتل بدّل ثوبها؟
Dialogue: 0,0:09:54.70,0:09:55.81,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:10:05.28,0:10:07.32,Default,,0000,0000,0000,,...بينكي
Dialogue: 0,0:10:08.55,0:10:11.72,Default,,0000,0000,0000,,...اسم هذا النُزل بينكي أيضاً
Dialogue: 0,0:10:12.18,0:10:14.31,Default,,0000,0000,0000,,وجود كلّ هذه الأسهم عليه
Dialogue: 0,0:10:14.31,0:10:16.60,Default,,0000,0000,0000,,يعني أنّه تمثال موت بينكي واقفاً
Dialogue: 0,0:10:19.71,0:10:21.05,Default,,0000,0000,0000,,موته واقفاً؟
Dialogue: 0,0:10:25.60,0:10:27.75,Default,,0000,0000,0000,,!هكذا إذاً! بينكي
Dialogue: 0,0:10:27.75,0:10:29.30,Default,,0000,0000,0000,,!استعمل القاتل هذا
Dialogue: 0,0:10:29.30,0:10:32.76,Default,,0000,0000,0000,,!اكتشفتُ الحيلة التي استعملها القاتل أخيراً
Dialogue: 0,0:10:41.49,0:10:42.78,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:10:42.78,0:10:46.56,Default,,0000,0000,0000,,...سأنوّم العمّ بمسدّس ساعة التخدير كالعادة
Dialogue: 0,0:10:59.05,0:11:01.05,Default,,0000,0000,0000,,!كان المجرم من الداخل
Dialogue: 0,0:11:01.05,0:11:03.97,Default,,0000,0000,0000,,!أي أحد أصدقائي المقرّبين
Dialogue: 0,0:11:04.55,0:11:08.42,Default,,0000,0000,0000,,!لكنّه لن يفلت أبداً
Dialogue: 0,0:11:08.42,0:11:11.30,Default,,0000,0000,0000,,!سأسحبه للعلن بالتأكيد! أقسم بذلك
Dialogue: 0,0:11:16.21,0:11:18.88,Default,,0000,0000,0000,,أفهم يا عمّ
Dialogue: 0,0:11:18.88,0:11:22.40,Default,,0000,0000,0000,,لكن لمَ أطلق القاتل عليها؟
Dialogue: 0,0:11:22.40,0:11:25.03,Default,,0000,0000,0000,,لعلّه أتى لسرقة أمتعتها
Dialogue: 0,0:11:25.03,0:11:26.85,Default,,0000,0000,0000,,لكنّه أطلق عليها عندما رأته
Dialogue: 0,0:11:26.85,0:11:28.69,Default,,0000,0000,0000,,لكن أليس ذلك غريباً؟
Dialogue: 0,0:11:28.69,0:11:32.30,Default,,0000,0000,0000,,لمَ لم نسمع صوت الطلقة عندما\Nكنّا نلعب كرة الطاولة؟
Dialogue: 0,0:11:32.77,0:11:34.10,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:11:34.10,0:11:38.76,Default,,0000,0000,0000,,يُفترض أنّ القاتل هنا، فلمَ يملكون جميعهم حجّة غياب؟
Dialogue: 0,0:11:39.34,0:11:41.51,Default,,0000,0000,0000,,،بناءً على حالة تصلّب جثّتها
Dialogue: 0,0:11:41.51,0:11:44.26,Default,,0000,0000,0000,,فزمن وفاة يومي المقدّر كان \Nعند قرابة الثالثة مساءً
Dialogue: 0,0:11:44.68,0:11:48.58,Default,,0000,0000,0000,,مما يعني أنّ يومي قُتلت فورما تركتنا
Dialogue: 0,0:11:48.58,0:11:49.97,Default,,0000,0000,0000,,وذهبت لغرفتها
Dialogue: 0,0:11:50.54,0:11:54.22,Default,,0000,0000,0000,,كان بقيّتنا في غرفة كرة الطاولة من الثالثة حتّى السادسة
Dialogue: 0,0:11:54.58,0:11:56.58,Default,,0000,0000,0000,,لم يمتلك أحد فرصة لقتلها
Dialogue: 0,0:11:56.58,0:12:00.13,Default,,0000,0000,0000,,...ما يحّيرني هو ما قاله أومورا
Dialogue: 0,0:12:00.13,0:12:02.03,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:12:02.03,0:12:04.70,Default,,0000,0000,0000,,!رأيتُها بينما يُفترض أنها ميتة
Dialogue: 0,0:12:04.70,0:12:08.59,Default,,0000,0000,0000,,كانت تحدّق بنظرات مخيفة نحو غرفة كرة الطاولة\N!من نافذة الطابق العلوي
Dialogue: 0,0:12:08.91,0:12:11.60,Default,,0000,0000,0000,,ذهب أومورا لدورة المياه بعد الخامسة
Dialogue: 0,0:12:11.60,0:12:13.55,Default,,0000,0000,0000,,يستحيل أنّ يومي كانت حيّة
Dialogue: 0,0:12:13.81,0:12:16.51,Default,,0000,0000,0000,,فكيف قال أومورا ذاك إذاً؟
Dialogue: 0,0:12:16.98,0:12:19.05,Default,,0000,0000,0000,,...يا عمّ
Dialogue: 0,0:12:19.05,0:12:21.84,Default,,0000,0000,0000,,!لنلعب كرة الطاولة! هيّا
Dialogue: 0,0:12:21.84,0:12:23.51,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:12:23.51,0:12:26.29,Default,,0000,0000,0000,,كونان-كن! ما الذي تقوله في وقتٍ كهذا؟
Dialogue: 0,0:12:26.29,0:12:27.71,Default,,0000,0000,0000,,لا يمكنني اللعب؟
Dialogue: 0,0:12:28.04,0:12:30.54,Default,,0000,0000,0000,,!مسكة المصافحة خاصتي ممتازة
Dialogue: 0,0:12:30.54,0:12:33.18,Default,,0000,0000,0000,,تذكرت، كانت يومي-سان تستعمل مسكة المصافحة أيضاً، صحيح؟
Dialogue: 0,0:12:34.89,0:12:41.03,Default,,0000,0000,0000,,أتذكرين؟ كانت تحمل مضرباً بأسلوب\Nمسكة المصافحة في الصورة
Dialogue: 0,0:12:41.03,0:12:47.02,Default,,0000,0000,0000,,أجل... لكن لا يمكنك اللعب الآن! فهمت؟
Dialogue: 0,0:12:47.02,0:12:48.15,Default,,0000,0000,0000,,معكِ حق
Dialogue: 0,0:12:48.15,0:12:50.47,Default,,0000,0000,0000,,سيكون عليّ تغيير ثيابي إن تعرّقت
Dialogue: 0,0:12:51.90,0:12:54.23,Default,,0000,0000,0000,,عرق؟ تغيير ثياب؟
Dialogue: 0,0:12:54.23,0:12:56.31,Default,,0000,0000,0000,,مسكة مصافحة؟
Dialogue: 0,0:12:56.31,0:13:01.01,Default,,0000,0000,0000,,...أجل، بدّلت يومي اليوكاتا خاصتها لمقاسٍ أكبر
Dialogue: 0,0:13:01.01,0:13:02.89,Default,,0000,0000,0000,,ولم تكن ترتدي ملابس داخلية
Dialogue: 0,0:13:02.89,0:13:06.47,Default,,0000,0000,0000,,كما امتد إصبع سبّابتها الأيمن متصلّباً
Dialogue: 0,0:13:06.47,0:13:09.84,Default,,0000,0000,0000,,بدل أن يكون على الزناد
Dialogue: 0,0:13:09.84,0:13:11.04,Default,,0000,0000,0000,,في مسكة المصافحة
Dialogue: 0,0:13:11.04,0:13:13.80,Default,,0000,0000,0000,,تمسك بالمضرب وسبّابتك عليه
Dialogue: 0,0:13:13.80,0:13:17.04,Default,,0000,0000,0000,,أيمكن أنّ يومي كانت تلعب كرة الطاولة
Dialogue: 0,0:13:17.04,0:13:19.26,Default,,0000,0000,0000,,مع القاتل قبل أن يقتلها؟
Dialogue: 0,0:13:19.26,0:13:23.12,Default,,0000,0000,0000,,مستحيل، ما المعنى في ذلك؟
Dialogue: 0,0:13:23.12,0:13:24.45,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:13:24.45,0:13:27.66,Default,,0000,0000,0000,,...قالوا سابقاً في أكاديمية الشرطة
Dialogue: 0,0:13:29.52,0:13:33.68,Default,,0000,0000,0000,,أخبريني يا جدّة، مات بينكي وهو واقف، صحيح؟
Dialogue: 0,0:13:33.94,0:13:35.61,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:35.61,0:13:39.01,Default,,0000,0000,0000,,قاتل بينكي أفواجاً من الأعداء بمفرده
Dialogue: 0,0:13:39.01,0:13:42.59,Default,,0000,0000,0000,,ثمّ مات واقفاً ووابل الأسهم يتساقط عليه
Dialogue: 0,0:13:42.59,0:13:45.31,Default,,0000,0000,0000,,!هـ-هكذا إذاً! فهمت
Dialogue: 0,0:13:46.51,0:13:50.18,Default,,0000,0000,0000,,موري، لمَ تصرخ؟
Dialogue: 0,0:13:51.71,0:13:56.14,Default,,0000,0000,0000,,اكتشفتُ قاتل يومي أخيراً
Dialogue: 0,0:13:56.14,0:13:56.93,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:57.76,0:13:59.59,Default,,0000,0000,0000,,مـ-من هو يا أبي؟
Dialogue: 0,0:14:00.24,0:14:02.55,Default,,0000,0000,0000,,!قاتل يومي كان أنت
Dialogue: 0,0:14:09.98,0:14:13.05,Default,,0000,0000,0000,,!قاتل يومي كان أنت
Dialogue: 0,0:14:13.05,0:14:15.01,Default,,0000,0000,0000,,!ماذا؟ قتلها ناكاميتشي؟
Dialogue: 0,0:14:16.14,0:14:18.22,Default,,0000,0000,0000,,...يكفي مزاحاً
Dialogue: 0,0:14:18.22,0:14:20.68,Default,,0000,0000,0000,,كنتُ في غرفة كرة الطاولة مع الجميع
Dialogue: 0,0:14:20.68,0:14:22.76,Default,,0000,0000,0000,,أثناء زمن وفاتها المقدّر
Dialogue: 0,0:14:23.02,0:14:25.72,Default,,0000,0000,0000,,أجل، حجّة غيابك متقنة
Dialogue: 0,0:14:25.72,0:14:29.22,Default,,0000,0000,0000,,بافتراض أنّها قُتلت في الثالثة حقاً
Dialogue: 0,0:14:29.22,0:14:34.80,Default,,0000,0000,0000,,ما-ما الذي تقوله؟ تحققنا من زمن الوفاة معاً
Dialogue: 0,0:14:34.80,0:14:39.70,Default,,0000,0000,0000,,كانت أصابع أقدام يومي\Nقد بدأت بالتصلّب فعلاً
Dialogue: 0,0:14:39.70,0:14:44.37,Default,,0000,0000,0000,,لذا قدّرتُ أنها ماتت قبل ما يفوق السبع ساعات
Dialogue: 0,0:14:44.37,0:14:45.72,Default,,0000,0000,0000,,لكن توجد استثناءات
Dialogue: 0,0:14:45.72,0:14:49.67,Default,,0000,0000,0000,,كموت مُباغت أثناء نشاط بدني مُضنٍ
Dialogue: 0,0:14:50.82,0:14:54.90,Default,,0000,0000,0000,,في تلك الحالات، تتصلّب بروتينات العضلات بيسر
Dialogue: 0,0:14:54.90,0:14:58.51,Default,,0000,0000,0000,,مما يسرّع تصلّب الجثّة
Dialogue: 0,0:14:58.51,0:15:03.68,Default,,0000,0000,0000,,!أجل، كما مع البطل موساشيبو بينكي
Dialogue: 0,0:15:05.39,0:15:07.55,Default,,0000,0000,0000,,...موت بينكي وهو واقف إذاً
Dialogue: 0,0:15:07.55,0:15:09.67,Default,,0000,0000,0000,,أجل، أُثبت طبياً
Dialogue: 0,0:15:09.67,0:15:12.93,Default,,0000,0000,0000,,أنّ الموت واقفاً ممكن
Dialogue: 0,0:15:12.93,0:15:16.97,Default,,0000,0000,0000,,بحقّك، كانت جثّة يومي في غرفتها
Dialogue: 0,0:15:16.97,0:15:20.63,Default,,0000,0000,0000,,أيّ نشاط بدني جعلتها تمارسه؟
Dialogue: 0,0:15:20.63,0:15:25.21,Default,,0000,0000,0000,,كلا، لم تُجبر على بذل جهد بدنيّ في غرفتها
Dialogue: 0,0:15:25.21,0:15:26.62,Default,,0000,0000,0000,,!بل في غرفة كرة الطاولة
Dialogue: 0,0:15:26.62,0:15:30.38,Default,,0000,0000,0000,,!جعلتها تلعب كرة الطاولة حتّى قتلتها
Dialogue: 0,0:15:31.22,0:15:34.24,Default,,0000,0000,0000,,كان يُفترض أن تلتقي بها بمفردك
Dialogue: 0,0:15:34.24,0:15:36.07,Default,,0000,0000,0000,,في غرفة كرة الطاولة غالباً
Dialogue: 0,0:15:36.07,0:15:40.43,Default,,0000,0000,0000,,!لكنّك دعوتنا جميعاً للغرفة
Dialogue: 0,0:15:40.60,0:15:43.76,Default,,0000,0000,0000,,وجدتُها، لمَ لا نلعب كرة طاولة الآن جميعاً؟
Dialogue: 0,0:15:43.76,0:15:45.22,Default,,0000,0000,0000,,!فكرة حسنة
Dialogue: 0,0:15:45.22,0:15:46.97,Default,,0000,0000,0000,,سأمتنع
Dialogue: 0,0:15:46.97,0:15:50.22,Default,,0000,0000,0000,,غضبت يومي بالطبع ورجعت لغرفتها
Dialogue: 0,0:15:50.47,0:15:52.97,Default,,0000,0000,0000,,بعد السادسة كان الجميع قد غادروا
Dialogue: 0,0:15:53.38,0:15:57.01,Default,,0000,0000,0000,,وذهبت يومي لغرفة كرة الطاولة بمفردها\Nحيث كنت تنتظر
Dialogue: 0,0:15:57.01,0:15:59.34,Default,,0000,0000,0000,,لا بدّ أنّه كان لقاءً بغاية السرّية
Dialogue: 0,0:15:59.79,0:16:02.97,Default,,0000,0000,0000,,دعوتها وقتها للعبة كرة طاولة
Dialogue: 0,0:16:03.71,0:16:06.04,Default,,0000,0000,0000,,وبعد جعلها تبذل جهداً بدنياً لفترة
Dialogue: 0,0:16:06.04,0:16:09.01,Default,,0000,0000,0000,,أرجعتها لغرفتها
Dialogue: 0,0:16:16.99,0:16:20.52,Default,,0000,0000,0000,,وأطلقت عليها النار في رأسها
Dialogue: 0,0:16:20.52,0:16:25.97,Default,,0000,0000,0000,,كلّ ذلك للعبث بوقت الوفاة المقدّر\Nوبناء حجّة الغياب المثالية
Dialogue: 0,0:16:26.19,0:16:29.34,Default,,0000,0000,0000,,استعملت غالباً سرعة انفعال يومي لمصلحتك
Dialogue: 0,0:16:29.34,0:16:32.93,Default,,0000,0000,0000,,لجعلها ترجع لغرفتها
Dialogue: 0,0:16:32.93,0:16:34.26,Default,,0000,0000,0000,,،ودليلاً على ذلك
Dialogue: 0,0:16:34.26,0:16:38.13,Default,,0000,0000,0000,,أسرعت يومي عائدةً للغرفة والمضرب في يدها
Dialogue: 0,0:16:38.42,0:16:41.21,Default,,0000,0000,0000,,لذا كانت يدها اليمنى التي تمسك بالمسدّس
Dialogue: 0,0:16:41.21,0:16:44.10,Default,,0000,0000,0000,,!متصلّبةً في مسكة مصافحة
Dialogue: 0,0:16:44.10,0:16:46.81,Default,,0000,0000,0000,,...يومي التي رأيتُها بعد الخامسة إذاً
Dialogue: 0,0:16:46.81,0:16:48.78,Default,,0000,0000,0000,,كانت يومي الحقيقية
Dialogue: 0,0:16:48.78,0:16:50.87,Default,,0000,0000,0000,,فقد كانت لا تزال حيّة
Dialogue: 0,0:16:50.87,0:16:52.87,Default,,0000,0000,0000,,كانت تراقب غرفة كرة الطاولة
Dialogue: 0,0:16:52.87,0:16:55.72,Default,,0000,0000,0000,,من الطابق الثاني وتنتظر خلوة ناكاميتشي
Dialogue: 0,0:16:55.99,0:16:58.40,Default,,0000,0000,0000,,قُتلت يومي على الأرجح عند السادسة والنصف
Dialogue: 0,0:16:58.40,0:17:01.19,Default,,0000,0000,0000,,مع انطلاق الألعاب النارية
Dialogue: 0,0:17:01.19,0:17:04.93,Default,,0000,0000,0000,,!فصوت الطلقة ستحجبه أصوات المفرقعات
Dialogue: 0,0:17:08.09,0:17:10.05,Default,,0000,0000,0000,,لكن لا يزال أمام ناكاميتشي
Dialogue: 0,0:17:10.05,0:17:14.55,Default,,0000,0000,0000,,مهمة مسح عرق الجثّة وتغيير ثيابها
Dialogue: 0,0:17:14.55,0:17:16.68,Default,,0000,0000,0000,,كان هناك احتمال باكتشاف الحيلة
Dialogue: 0,0:17:16.68,0:17:19.01,Default,,0000,0000,0000,,إن عرفنا تعرّقها
Dialogue: 0,0:17:19.46,0:17:22.21,Default,,0000,0000,0000,,لم يكن أمامه خيار سوى نزع ملابسها الداخلية
Dialogue: 0,0:17:22.21,0:17:23.97,Default,,0000,0000,0000,,لكنّه غيّر اليوكاتا
Dialogue: 0,0:17:23.97,0:17:26.89,Default,,0000,0000,0000,,بآخر بديل
Dialogue: 0,0:17:26.89,0:17:31.22,Default,,0000,0000,0000,,لكن ظهرت عقبة غير متوقعة في منتصف عمله
Dialogue: 0,0:17:31.22,0:17:35.31,Default,,0000,0000,0000,,فران وكونان كانا قد أتيا لإيقاظ يومي
Dialogue: 0,0:17:35.31,0:17:37.34,Default,,0000,0000,0000,,أوقفت عملك غير مكتملاً
Dialogue: 0,0:17:37.69,0:17:40.86,Default,,0000,0000,0000,,وخرجت للسقف من النافذة
Dialogue: 0,0:17:40.86,0:17:43.82,Default,,0000,0000,0000,,ومنعت ران من دخول الغرفة
Dialogue: 0,0:17:46.48,0:17:49.76,Default,,0000,0000,0000,,،ثمّ ذهبت رفقة الجميع للألعاب النارية
Dialogue: 0,0:17:49.76,0:17:51.81,Default,,0000,0000,0000,,،وتظاهرت بانفصالك
Dialogue: 0,0:17:51.81,0:17:55.43,Default,,0000,0000,0000,,لتذهب وتنهي بقيّة العمل
Dialogue: 0,0:17:55.43,0:18:00.13,Default,,0000,0000,0000,,عندها وضعت المسدّس في يدها\Nلتجعله يبدو انتحاراً
Dialogue: 0,0:18:00.63,0:18:03.13,Default,,0000,0000,0000,,مع أنّ يدها كانت قد تصلّبت
Dialogue: 0,0:18:03.13,0:18:05.88,Default,,0000,0000,0000,,بتلك المسكة سلفاً
Dialogue: 0,0:18:05.88,0:18:09.09,Default,,0000,0000,0000,,فاستحال وضع إصبعها على الزناد
Dialogue: 0,0:18:10.54,0:18:13.16,Default,,0000,0000,0000,,استنتاجك مُثير حقاً
Dialogue: 0,0:18:13.16,0:18:16.89,Default,,0000,0000,0000,,لكن ألديك أيّ دليل؟ دليل أنّي المجرم؟
Dialogue: 0,0:18:16.89,0:18:18.19,Default,,0000,0000,0000,,!لا تكن أحمق
Dialogue: 0,0:18:18.19,0:18:20.65,Default,,0000,0000,0000,,الوحيد الذي سيفكّر بحيلة كتلك
Dialogue: 0,0:18:20.65,0:18:22.64,Default,,0000,0000,0000,,!هو أنت أو أنا، الشرطّيين
Dialogue: 0,0:18:22.64,0:18:25.94,Default,,0000,0000,0000,,رأيت؟ كان يمكن أنّك الفاعل أيضاً
Dialogue: 0,0:18:25.94,0:18:30.59,Default,,0000,0000,0000,,كما يمكن لأيّ حد الاطّلاع على تلك المعلومة في كتاب
Dialogue: 0,0:18:30.59,0:18:32.55,Default,,0000,0000,0000,,!تـ-تبّاً لك
Dialogue: 0,0:18:35.97,0:18:37.63,Default,,0000,0000,0000,,يا لسذاجتك يا عمّ
Dialogue: 0,0:18:37.63,0:18:40.43,Default,,0000,0000,0000,,يستحيل أن يكون هذا الشرطيّ العظيم القاتل
Dialogue: 0,0:18:40.43,0:18:42.05,Default,,0000,0000,0000,,الشرطيّ العظيم؟
Dialogue: 0,0:18:42.05,0:18:43.38,Default,,0000,0000,0000,,ألا تتفق؟
Dialogue: 0,0:18:43.38,0:18:47.83,Default,,0000,0000,0000,,فقد عرف أنّ يومي-سان ميتة\Nبمجرد النظر لها في الدماء
Dialogue: 0,0:18:50.20,0:18:53.89,Default,,0000,0000,0000,,...قلتَ وقتها قبل لمس يومي حتّى
Dialogue: 0,0:18:53.89,0:18:54.80,Default,,0000,0000,0000,,!يومي
Dialogue: 0,0:18:54.80,0:18:55.76,Default,,0000,0000,0000,,!لا تلمسيها
Dialogue: 0,0:18:55.76,0:18:59.84,Default,,0000,0000,0000,,!لا يدخل أحد هذه الغرفة سوى المحققين، أنا وموري
Dialogue: 0,0:19:00.03,0:19:03.19,Default,,0000,0000,0000,,،لسببٍ ما، لم تطلب الإسعاف
Dialogue: 0,0:19:03.19,0:19:05.31,Default,,0000,0000,0000,,بل الشرطة
Dialogue: 0,0:19:05.31,0:19:08.80,Default,,0000,0000,0000,,كنتَ تعرف أنّ الأوان قد فات
Dialogue: 0,0:19:09.35,0:19:11.26,Default,,0000,0000,0000,,!لأنّك قتلتها
Dialogue: 0,0:19:12.18,0:19:14.18,Default,,0000,0000,0000,,!كيف يمكنك؟! كيف يمكنك؟
Dialogue: 0,0:19:14.18,0:19:15.01,Default,,0000,0000,0000,,!اخرس
Dialogue: 0,0:19:15.43,0:19:17.34,Default,,0000,0000,0000,,!لم أرد قتلها
Dialogue: 0,0:19:17.34,0:19:19.67,Default,,0000,0000,0000,,!فقد تواعدنا لثمانية عشر عاماً
Dialogue: 0,0:19:20.01,0:19:21.55,Default,,0000,0000,0000,,ثمانية عشر عاماً؟
Dialogue: 0,0:19:21.92,0:19:22.92,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:19:22.92,0:19:25.47,Default,,0000,0000,0000,,حتّى التقيت فتاةً أخرى قبل نصف سنة
Dialogue: 0,0:19:25.47,0:19:28.88,Default,,0000,0000,0000,,قـ-قتلتها لأنها ستعيق زواجك؟
Dialogue: 0,0:19:29.63,0:19:32.51,Default,,0000,0000,0000,,!لمَ؟! لمَ لم تتزوّجها؟
Dialogue: 0,0:19:32.51,0:19:33.14,Default,,0000,0000,0000,,!دعني
Dialogue: 0,0:19:35.83,0:19:38.03,Default,,0000,0000,0000,,لطالما تقدّمتُ لها
Dialogue: 0,0:19:38.03,0:19:40.49,Default,,0000,0000,0000,,!لكن رفضها كان ثابتاً
Dialogue: 0,0:19:40.49,0:19:42.97,Default,,0000,0000,0000,,!لثمانية عشر عاماً
Dialogue: 0,0:19:42.97,0:19:47.19,Default,,0000,0000,0000,,وعندما كنتُ على وشك الزواج بفتاة أخرى
Dialogue: 0,0:19:47.19,0:19:49.44,Default,,0000,0000,0000,,:أخبرتني يومي بالتالي
Dialogue: 0,0:19:50.44,0:19:52.14,Default,,0000,0000,0000,,لن أسمح لك
Dialogue: 0,0:19:52.14,0:19:54.44,Default,,0000,0000,0000,,لن أسمح لك بالسعادة
Dialogue: 0,0:19:54.44,0:19:58.80,Default,,0000,0000,0000,,وعندها أغرقتْ خطيبتي برسائل التهديد
Dialogue: 0,0:19:58.80,0:20:01.47,Default,,0000,0000,0000,,والمكالمات
Dialogue: 0,0:20:01.47,0:20:06.09,Default,,0000,0000,0000,,قالت في النهاية أنّها سترسل صوراً\N!لنا نحن الاثنين معاً
Dialogue: 0,0:20:06.09,0:20:08.58,Default,,0000,0000,0000,,أخبرتُها إن أحضرتها كلّها للمّ الشمل
Dialogue: 0,0:20:08.58,0:20:11.34,Default,,0000,0000,0000,,فسأشتري الصور
Dialogue: 0,0:20:11.92,0:20:15.79,Default,,0000,0000,0000,,كان ذلك في يوم قبضك على سارق البنك
Dialogue: 0,0:20:15.79,0:20:18.76,Default,,0000,0000,0000,,كنتُ قد التقيت يومي للتوّ
Dialogue: 0,0:20:19.24,0:20:23.22,Default,,0000,0000,0000,,...كنتُ حائراً فيما أفعل حيالها
Dialogue: 0,0:20:24.36,0:20:27.67,Default,,0000,0000,0000,,عندما طار مسدّس اللص بالقرب...
Dialogue: 0,0:20:28.17,0:20:31.96,Default,,0000,0000,0000,,خطرت لي الخطّة آنذاك
Dialogue: 0,0:20:33.10,0:20:35.77,Default,,0000,0000,0000,,كان يُفترض أن تتم الصفقة في غرفة كرة الطاولة
Dialogue: 0,0:20:35.77,0:20:38.34,Default,,0000,0000,0000,,:لكنّي أخبرتها بالتالي
Dialogue: 0,0:20:38.34,0:20:41.68,Default,,0000,0000,0000,,"اختفت الصور من أمتعتك"
Dialogue: 0,0:20:41.68,0:20:43.09,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:20:43.09,0:20:46.09,Default,,0000,0000,0000,,،لذا أسرعتْ للغرفة
Dialogue: 0,0:20:46.09,0:20:48.38,Default,,0000,0000,0000,,والمضرب في يدها
Dialogue: 0,0:20:48.38,0:20:51.38,Default,,0000,0000,0000,,ثمّ تبعتها وأطلقت عليها
Dialogue: 0,0:20:51.38,0:20:52.33,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:20:52.33,0:20:55.35,Default,,0000,0000,0000,,!أطلقتُ على الشيطانة التي أفسدت حياتي
Dialogue: 0,0:20:56.42,0:20:57.78,Default,,0000,0000,0000,,أيّكما الشيطان؟
Dialogue: 0,0:20:57.78,0:20:58.70,Default,,0000,0000,0000,,!اخرس
Dialogue: 0,0:20:58.70,0:21:01.47,Default,,0000,0000,0000,,!ما الذي تعرفه؟! ماذا تعرف؟
Dialogue: 0,0:21:02.70,0:21:04.32,Default,,0000,0000,0000,,...لن أعرف أبداً
Dialogue: 0,0:21:05.70,0:21:07.71,Default,,0000,0000,0000,,...شعور القاتل
Dialogue: 0,0:21:07.71,0:21:09.67,Default,,0000,0000,0000,,مهما كان الدافع
Dialogue: 0,0:21:13.40,0:21:15.17,Default,,0000,0000,0000,,لا أريد أن أعرف
Dialogue: 0,0:21:16.11,0:21:18.30,Default,,0000,0000,0000,,أ-أبي
Dialogue: 0,0:21:18.30,0:21:21.26,Default,,0000,0000,0000,,لا تزال قويّاً كعادتك
Dialogue: 0,0:21:21.76,0:21:25.35,Default,,0000,0000,0000,,أحمق، أنت ضعفت فقط
Dialogue: 0,0:21:25.35,0:21:27.21,Default,,0000,0000,0000,,في جسدك وعقلك
Dialogue: 0,0:21:27.79,0:21:29.17,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:23:18.10,0:23:20.42,Default,,0000,0000,0000,,...إنّه مُحبط مؤخراً
Dialogue: 0,0:23:20.85,0:23:24.85,Default,,0000,0000,0000,,ليس باليد حيلة، فقد كانوا أصدقاءً
Dialogue: 0,0:23:25.27,0:23:27.51,Default,,0000,0000,0000,,،تذكرت، إن كان العمّ بتلك القوّة
Dialogue: 0,0:23:27.51,0:23:29.30,Default,,0000,0000,0000,,فلمَ لم يفز بأيّ مباريات؟
Dialogue: 0,0:23:29.30,0:23:32.92,Default,,0000,0000,0000,,يبدو أنّ الحماس يتملّكه وقت المبارايات
Dialogue: 0,0:23:32.92,0:23:35.18,Default,,0000,0000,0000,,فلا يستطيع تركيز قوّته
Dialogue: 0,0:23:36.13,0:23:38.30,Default,,0000,0000,0000,,كان ضعيفاً في المواجهات إذاً
Dialogue: 0,0:23:38.30,0:23:41.29,Default,,0000,0000,0000,,سأحاول إبهاجه في تلك الحالة
Dialogue: 0,0:23:41.29,0:23:42.75,Default,,0000,0000,0000,,انتظر
Dialogue: 0,0:23:42.75,0:23:44.91,Default,,0000,0000,0000,,لنتركه وحده لفترة
Dialogue: 0,0:23:44.91,0:23:46.43,Default,,0000,0000,0000,,سيعود لطبيعته في نهاية المطاف
Dialogue: 0,0:23:56.24,0:23:58.14,Default,,0000,0000,0000,,!ورديّ هذه المرة
Dialogue: 0,0:24:03.47,0:24:07.93,Default,,0000,0000,0000,,!مفتّش ميغوري! صباح الخير
Dialogue: 0,0:24:07.93,0:24:09.84,Default,,0000,0000,0000,,!مات الرئيس أوكيدا؟
Dialogue: 0,0:24:10.09,0:24:11.55,Default,,0000,0000,0000,,بلل
Dialogue: 0,0:24:11.55,0:24:14.26,Default,,0000,0000,0000,,هذا عرقٌ كثيرٌ بالنسبة لشخصٍ مات بنوبة
Dialogue: 0,0:24:14.76,0:24:17.83,Default,,0000,0000,0000,,إن كانت نوبة الرئيس أوكيدا القلبية\N،من تأثير شخص عمداً
Dialogue: 0,0:24:17.83,0:24:20.25,Default,,0000,0000,0000,,فالمتّهم الأوّل هو توكيتو-سان
Dialogue: 0,0:24:20.25,0:24:23.67,Default,,0000,0000,0000,,لكن كيف فعلها بالضبط؟
Dialogue: 0,0:24:24.92,0:24:26.21,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.21,0:24:29.92,Default,,0000,0000,0000,,جريمة قتل الحاسوب
Dialogue: 0,0:24:45.41,0:24:48.27,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.27,0:24:49.11,Default,,0000,0000,0000,,قطّ

