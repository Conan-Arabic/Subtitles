Dialogue: 0,0:00:01.33,0:00:04.11,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.63,0:00:06.94,Default,,0000,0000,0000,,!يظهر خصم شينتشي فجأةً
Dialogue: 0,0:00:06.94,0:00:09.07,Default,,0000,0000,0000,,!هل سأستطيع قتاله وأنا كونان؟
Dialogue: 0,0:00:09.07,0:00:10.77,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.77,0:00:13.28,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.28,0:00:15.35,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.80,0:01:51.86,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل الدبلوماسيّ (الجزء الأوّل
Dialogue: 0,0:01:46.87,0:01:50.32,Default,,0000,0000,0000,,(جريمة قتل الدبلوماسيّ (الجزء الأوّل
Dialogue: 0,0:01:55.48,0:02:00.61,Default,,0000,0000,0000,,يا إلهي! تتّصل بي أخيراً\N!لكنّك مُصاب بزكام
Dialogue: 0,0:02:00.61,0:02:03.15,Default,,0000,0000,0000,,!ارجع بسرعة وحسب يا شينتشي
Dialogue: 0,0:02:03.40,0:02:05.30,Default,,0000,0000,0000,,ليس بيدي حيلة
Dialogue: 0,0:02:05.30,0:02:08.60,Default,,0000,0000,0000,,فأنا في منتصف قضيّة صعبة
Dialogue: 0,0:02:09.14,0:02:11.10,Default,,0000,0000,0000,,عميل
Dialogue: 0,0:02:11.10,0:02:14.22,Default,,0000,0000,0000,,يبدو أنّ لدينا عميلاً لذا سأكلّمك لاحقاً
Dialogue: 0,0:02:14.22,0:02:16.06,Default,,0000,0000,0000,,احرص على معالجة زكامك
Dialogue: 0,0:02:17.59,0:02:18.71,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:02:20.63,0:02:23.96,Default,,0000,0000,0000,,تقلق عندما لا أتّصل
Dialogue: 0,0:02:23.96,0:02:26.37,Default,,0000,0000,0000,,وتصرخ عليّ عندما أتّصل
Dialogue: 0,0:02:26.37,0:02:28.65,Default,,0000,0000,0000,,!كلّ ما تفعله هو التذمّر
Dialogue: 0,0:02:31.74,0:02:34.90,Default,,0000,0000,0000,,!لا أفهم الفتيات أبداً
Dialogue: 0,0:02:35.94,0:02:40.81,Default,,0000,0000,0000,,،لا جدوى من الكذب يا آنسة\N!أعرف أنّه هنا
Dialogue: 0,0:02:41.07,0:02:43.73,Default,,0000,0000,0000,,!أخرجوا كودو شينتشي حالاً
Dialogue: 0,0:02:43.98,0:02:45.35,Default,,0000,0000,0000,,ماذا؟ أنا؟
Dialogue: 0,0:02:45.35,0:02:46.68,Default,,0000,0000,0000,,!فلتخرج
Dialogue: 0,0:02:47.81,0:02:48.40,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:02:49.22,0:02:50.77,Default,,0000,0000,0000,,تعاني من زكام أيضاً؟
Dialogue: 0,0:02:50.77,0:02:51.42,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:02:53.51,0:02:55.59,Default,,0000,0000,0000,,...لا تتحرك
Dialogue: 0,0:02:55.59,0:02:58.42,Default,,0000,0000,0000,,...يا إلهي، أنت وشينتشي
Dialogue: 0,0:02:58.42,0:03:00.48,Default,,0000,0000,0000,,هل الزكام منتشر؟
Dialogue: 0,0:03:00.71,0:03:02.25,Default,,0000,0000,0000,,يعاني كودو من زكام؟
Dialogue: 0,0:03:02.25,0:03:06.46,Default,,0000,0000,0000,,كيف تعرفين ذلك مع أنّك\Nتجهلين مكانه؟
Dialogue: 0,0:03:09.24,0:03:10.91,Default,,0000,0000,0000,,الهاتف
Dialogue: 0,0:03:10.91,0:03:13.90,Default,,0000,0000,0000,,اتّصل شينتشي بي قبل قليل\Nوصوته من أنفه
Dialogue: 0,0:03:14.33,0:03:15.73,Default,,0000,0000,0000,,اتّصل كودو بهذا المكان؟
Dialogue: 0,0:03:15.73,0:03:17.90,Default,,0000,0000,0000,,يفعل من حينٍ لآخر
Dialogue: 0,0:03:17.90,0:03:18.85,Default,,0000,0000,0000,,أبهذا مشكلة؟
Dialogue: 0,0:03:19.44,0:03:23.73,Default,,0000,0000,0000,,شائعة كونك امرأة كودو صحيحة إذاً
Dialogue: 0,0:03:24.53,0:03:25.27,Default,,0000,0000,0000,,!امرأة؟
Dialogue: 0,0:03:26.52,0:03:28.22,Default,,0000,0000,0000,,!من قال ذلك؟
Dialogue: 0,0:03:26.52,0:03:28.22,Default,,0000,0000,0000,,!من قال ذلك؟
Dialogue: 0,0:03:28.22,0:03:31.43,Default,,0000,0000,0000,,صديقة لك تُدعى سوزوكي
Dialogue: 0,0:03:31.43,0:03:33.22,Default,,0000,0000,0000,,قالت أنّ كودو لا يذهب للمدرسة
Dialogue: 0,0:03:33.22,0:03:36.46,Default,,0000,0000,0000,,وأنّ لك علاقة في الغالب
Dialogue: 0,0:03:36.46,0:03:37.77,Default,,0000,0000,0000,,...سونوكو
Dialogue: 0,0:03:37.77,0:03:39.06,Default,,0000,0000,0000,,...تبّاً لها
Dialogue: 0,0:03:39.55,0:03:42.34,Default,,0000,0000,0000,,إذاً، عمَّ تكلّمتِ مع كودو؟
Dialogue: 0,0:03:42.34,0:03:43.88,Default,,0000,0000,0000,,لا شيء
Dialogue: 0,0:03:43.88,0:03:48.08,Default,,0000,0000,0000,,أخبرني عن راوية غموض جيّدة قرأها مؤخراً
Dialogue: 0,0:03:48.08,0:03:52.69,Default,,0000,0000,0000,,ودوري كرة القدم للمحترفين\Nوعن حال الأصدقاء في المدرسة
Dialogue: 0,0:03:53.16,0:03:54.49,Default,,0000,0000,0000,,هل سأل عنك؟
Dialogue: 0,0:03:54.95,0:03:56.57,Default,,0000,0000,0000,,ماذا؟ عنّي؟
Dialogue: 0,0:03:57.74,0:03:59.36,Default,,0000,0000,0000,,...صحيح، بالتفكير في ذلك
Dialogue: 0,0:03:59.36,0:04:03.48,Default,,0000,0000,0000,,يتكلّم شينتشي عن نفسه دوماً\Nولا يتكلّم عنّي أبداً
Dialogue: 0,0:04:06.14,0:04:07.98,Default,,0000,0000,0000,,ما-ماذا هناك؟
Dialogue: 0,0:04:07.98,0:04:10.18,Default,,0000,0000,0000,,لحظة! ما الذي تفعله؟
Dialogue: 0,0:04:10.18,0:04:11.73,Default,,0000,0000,0000,,ألا تجدين الأمر غريباً؟
Dialogue: 0,0:04:13.35,0:04:20.01,Default,,0000,0000,0000,,اتّصاله المتردد يعني أنّه مهتم بك
Dialogue: 0,0:04:20.01,0:04:24.57,Default,,0000,0000,0000,,ألن يسألك شخص كذاك عن حالك؟
Dialogue: 0,0:04:24.57,0:04:27.52,Default,,0000,0000,0000,,يوجد سبب واحد فحسب لعدم فعله ذلك
Dialogue: 0,0:04:27.96,0:04:31.13,Default,,0000,0000,0000,,يراقبك كودو من مكان
Dialogue: 0,0:04:32.98,0:04:34.61,Default,,0000,0000,0000,,وبالقرب من هنا غالباً
Dialogue: 0,0:04:34.61,0:04:38.81,Default,,0000,0000,0000,,شينتشي... يراقبني؟
Dialogue: 0,0:04:39.15,0:04:42.15,Default,,0000,0000,0000,,أرجّح أنّه يتجسس من مكانٍ ما
Dialogue: 0,0:04:42.15,0:04:43.78,Default,,0000,0000,0000,,يا للشخص المُريب
Dialogue: 0,0:04:44.45,0:04:46.23,Default,,0000,0000,0000,,!من هذا الشاب؟
Dialogue: 0,0:04:46.89,0:04:49.35,Default,,0000,0000,0000,,بالمناسبة، من تكون؟
Dialogue: 0,0:04:49.35,0:04:52.36,Default,,0000,0000,0000,,صحيح، نسيت
Dialogue: 0,0:04:52.81,0:04:54.97,On Top,,0000,0000,0000,,اسمي هاتّوري هيجي
Dialogue: 0,0:04:54.48,0:04:57.77,CharCard,,0000,0000,0005,,{\fad(300,0)}هاتّوري هيجي\Nمتحرٍّ في المدرسة الثانوية من كانساي
Dialogue: 0,0:04:54.97,0:04:57.77,On Top,,0000,0000,0000,,مُتحرٍّ في المدرسة الثانوية مثل كودو
Dialogue: 0,0:04:58.59,0:04:59.65,Default,,0000,0000,0000,,...مُتحرٍّ
Dialogue: 0,0:04:59.65,0:05:01.19,Default,,0000,0000,0000,,في المدرسة الثانوية؟
Dialogue: 0,0:05:01.68,0:05:04.48,Default,,0000,0000,0000,,ماذا؟ مجرّد مُتحرٍّ
Dialogue: 0,0:05:05.67,0:05:10.86,Default,,0000,0000,0000,,،يبدو أنّك تعاني الزكام يا صبيّ\Nلديّ العلاج المناسب لك
Dialogue: 0,0:05:10.86,0:05:13.99,Default,,0000,0000,0000,,...سمعتُ عن الأمر من قبل
Dialogue: 0,0:05:13.99,0:05:17.49,Default,,0000,0000,0000,,...يوجد مُتحرٍّ بارع في كانساي
Dialogue: 0,0:05:17.49,0:05:25.19,Default,,0000,0000,0000,,"أجل، يدعوننا بـ "هاتّوري الغرب\Nو"كودو الشرق"، وهناك مقارنات بيننا دوماً
Dialogue: 0,0:05:25.65,0:05:26.42,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:05:26.42,0:05:27.67,Default,,0000,0000,0000,,...شكراً
Dialogue: 0,0:05:29.31,0:05:32.73,Default,,0000,0000,0000,,لكني لم أسمع شيئاً عن كودو مؤخراً
Dialogue: 0,0:05:33.40,0:05:35.97,Default,,0000,0000,0000,,لم يعد وجهه يظهر في الصحف
Dialogue: 0,0:05:35.97,0:05:38.44,Default,,0000,0000,0000,,...ووفق الشائعات فقد اختفى
Dialogue: 0,0:05:38.85,0:05:41.93,Default,,0000,0000,0000,,...لذا الآن يملك الشرق موري كوغو
Dialogue: 0,0:05:41.93,0:05:44.27,Default,,0000,0000,0000,,وما الذي تريده من شينتشي؟
Dialogue: 0,0:05:44.27,0:05:48.36,Default,,0000,0000,0000,,لا شيء معيّن، أريد التحقّق بنفسي فحسب
Dialogue: 0,0:05:49.38,0:05:51.07,Default,,0000,0000,0000,,...يملك الشرق موري
Dialogue: 0,0:05:52.00,0:05:53.46,Default,,0000,0000,0000,,أريد رؤية إن كان كودو شينتشي
Dialogue: 0,0:05:53.46,0:05:57.02,Default,,0000,0000,0000,,جديراً بأن يُقارن بي حقاً
Dialogue: 0,0:05:57.99,0:05:59.06,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:00.62,0:06:02.90,Default,,0000,0000,0000,,كونان-كن! ما الخطب؟
Dialogue: 0,0:06:04.94,0:06:07.57,Default,,0000,0000,0000,,...ران-نيتشان
Dialogue: 0,0:06:07.57,0:06:10.86,Default,,0000,0000,0000,,كونان-كن... أنت! ماذا جعلته يشرب؟
Dialogue: 0,0:06:11.27,0:06:13.52,Default,,0000,0000,0000,,كحول صينية تُسمى بايغار
Dialogue: 0,0:06:13.52,0:06:16.26,Default,,0000,0000,0000,,سأبقى هنا حتّى ألتقي كودو
Dialogue: 0,0:06:16.26,0:06:18.31,Default,,0000,0000,0000,,!لذا هذه هديّة
Dialogue: 0,0:06:18.31,0:06:20.27,Default,,0000,0000,0000,,كيف لك أن تقول هذا وحسب؟
Dialogue: 0,0:06:22.89,0:06:25.19,Default,,0000,0000,0000,,كم مرّةً عليّ قرع الجرس؟
Dialogue: 0,0:06:25.55,0:06:28.69,Default,,0000,0000,0000,,أرى أنّ هذه الوكالة ليست مجهزة\N!لضيافة العملاء أيضاً
Dialogue: 0,0:06:29.05,0:06:33.20,On Top,,0000,0000,0000,,أنا في عجلة لذا هلّا أنهينا الأمر سريعاً؟
Dialogue: 0,0:06:29.05,0:06:33.20,CharCard,,0000,0000,0005,,{\fad(300,0)}(تسوجيمورا كيمي (50\Nزوجة الدبلوماسيّ تسوجيمورا إيساو
Dialogue: 0,0:06:34.20,0:06:37.49,Default,,0000,0000,0000,,تحرّي عن خلفيّة حبيبة ابنك؟
Dialogue: 0,0:06:37.49,0:06:40.86,Default,,0000,0000,0000,,هذه صورة لها وسجّل بماضيها
Dialogue: 0,0:06:41.99,0:06:44.78,Default,,0000,0000,0000,,كاتسوراغي يوكيكو-سان، 24 عاماً
Dialogue: 0,0:06:44.78,0:06:49.65,Default,,0000,0000,0000,,تخرّجت من متوسطة وثانويّة ميتوسبا\Nالأولى على صفّها
Dialogue: 0,0:06:49.94,0:06:52.40,Default,,0000,0000,0000,,ترتاد جامعة توتو للطب حالياً
Dialogue: 0,0:06:52.40,0:06:54.47,Default,,0000,0000,0000,,ماضية في طريقها لتصبح طبيبة
Dialogue: 0,0:06:54.47,0:06:56.52,Default,,0000,0000,0000,,أهناك مشكلة في هذا؟
Dialogue: 0,0:06:56.52,0:06:58.61,Default,,0000,0000,0000,,...كلا، ما في الأمر
Dialogue: 0,0:06:58.89,0:07:01.07,Default,,0000,0000,0000,,أنّها مثالية جدّاً فلا تروقك
Dialogue: 0,0:07:01.60,0:07:05.17,Default,,0000,0000,0000,,...البشر مخلوقات فضوليّة وغيورة
Dialogue: 0,0:07:05.17,0:07:06.71,Default,,0000,0000,0000,,عندما يرون شيئاً مثالياً
Dialogue: 0,0:07:06.71,0:07:08.73,Default,,0000,0000,0000,,لا يسعهم سوى البحث عن عيوب
Dialogue: 0,0:07:09.88,0:07:11.88,Default,,0000,0000,0000,,أليس كذلك يا سيّدة؟
Dialogue: 0,0:07:11.88,0:07:13.63,Default,,0000,0000,0000,,من ذاك الشاب؟
Dialogue: 0,0:07:13.63,0:07:16.83,Default,,0000,0000,0000,,...مجرّد صديق لابنتي
Dialogue: 0,0:07:16.83,0:07:22.15,Default,,0000,0000,0000,,بأيّ حال، يمكننا الكلام بتفصيل\Nفي منزلي مع زوجي
Dialogue: 0,0:07:22.15,0:07:25.60,Default,,0000,0000,0000,,أي... سنذهب الآن؟
Dialogue: 0,0:07:26.03,0:07:29.28,Default,,0000,0000,0000,,ألم يكن بإمكانكما القدوم هنا؟
Dialogue: 0,0:07:29.28,0:07:32.57,Default,,0000,0000,0000,,أخبرتك، زوجي دبلوماسيّ
Dialogue: 0,0:07:32.57,0:07:35.02,Default,,0000,0000,0000,,...إذا اكتشف الناس أنّه دخل مكاناً كهذا
Dialogue: 0,0:07:35.02,0:07:37.18,Default,,0000,0000,0000,,ستصبح فضيحة
Dialogue: 0,0:07:37.18,0:07:39.36,Default,,0000,0000,0000,,!حسناً! سآتي أيضاً
Dialogue: 0,0:07:39.80,0:07:40.73,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:41.06,0:07:47.15,Default,,0000,0000,0000,,سيكون الأمر أقلّ شبهة\Nإن ذهبنا كعائلة، أليس كذلك؟
Dialogue: 0,0:07:47.80,0:07:50.13,Default,,0000,0000,0000,,صحيح، سيكون ذلك حسناً
Dialogue: 0,0:07:50.13,0:07:52.15,Default,,0000,0000,0000,,!ماذا؟ سـ-سيّدتي
Dialogue: 0,0:07:52.67,0:07:54.31,Default,,0000,0000,0000,,ما رأيكِ بمرافقتنا؟
Dialogue: 0,0:07:54.65,0:07:56.12,Default,,0000,0000,0000,,لمَ عليّ؟
Dialogue: 0,0:07:56.12,0:07:58.27,Default,,0000,0000,0000,,كلما زاد العدد زادت التسلية
Dialogue: 0,0:07:58.83,0:08:02.98,Default,,0000,0000,0000,,كما قد يكشف كودو عن نفسه
Dialogue: 0,0:08:04.61,0:08:07.94,Default,,0000,0000,0000,,!ران-نيتشان، ران-نيتشان
Dialogue: 0,0:08:08.24,0:08:10.24,Default,,0000,0000,0000,,!علينا الذهاب معهم
Dialogue: 0,0:08:10.24,0:08:12.11,Default,,0000,0000,0000,,لكن هل تعافيت من زكامك؟
Dialogue: 0,0:08:12.32,0:08:15.77,Default,,0000,0000,0000,,!أجل، شُفيت بعدما شربت دواءه
Dialogue: 0,0:08:16.10,0:08:17.39,Default,,0000,0000,0000,,!أخبرتك
Dialogue: 0,0:08:17.39,0:08:20.98,Default,,0000,0000,0000,,أحمق! زادني سوءًا وحسب
Dialogue: 0,0:08:20.98,0:08:22.64,Default,,0000,0000,0000,,،لا أريد الذهاب
Dialogue: 0,0:08:22.64,0:08:25.77,Default,,0000,0000,0000,,لكن لا أعلم ما قد يقول إن تركته
Dialogue: 0,0:08:26.68,0:08:28.80,Default,,0000,0000,0000,,مرحباً بعودتك سيّدتي
Dialogue: 0,0:08:28.80,0:08:29.69,Default,,0000,0000,0000,,أين زوجي؟
Dialogue: 0,0:08:30.09,0:08:33.64,On Top,,0000,0000,0000,,أظنّه لا يزال في مكتبه
Dialogue: 0,0:08:31.02,0:08:33.64,CharCard,,0000,0000,0005,,{\fad(300,0)} (48) كويكي فوميو\Nخادم عائلة تسوجيمورا
Dialogue: 0,0:08:33.92,0:08:36.12,Default,,0000,0000,0000,,من هؤلاء؟
Dialogue: 0,0:08:36.12,0:08:38.79,Default,,0000,0000,0000,,إنّه موري-سان، صديق قديم
Dialogue: 0,0:08:38.79,0:08:41.36,Default,,0000,0000,0000,,!أمّاه، مرحباً
Dialogue: 0,0:08:41.58,0:08:43.42,Default,,0000,0000,0000,,...إنّها تلك من الصور
Dialogue: 0,0:08:43.92,0:08:45.27,Default,,0000,0000,0000,,لمَ أنتِ هنا؟
Dialogue: 0,0:08:45.74,0:08:47.28,On Top,,0000,0000,0000,,أنا استدعيتها
Dialogue: 0,0:08:46.56,0:08:52.21,CharCard,,0000,0300,0005,,{\fs(22)}(كاتسوراغي يوكيكو (24\Nطالبة في جامعة توتو الطبيّة
Dialogue: 0,0:08:46.56,0:08:52.21,CharCard,,0250,0000,0005,,{\fs(22)}(تسوجيمورا تاكايوشي (27\Nابن تسوجيمورا إيساو الوحيد، تلميذ قانون
Dialogue: 0,0:08:47.28,0:08:52.20,On Top,,0000,0000,0000,,لا يراها أبي، فسأجبره على ذلك
Dialogue: 0,0:08:52.20,0:08:55.57,On Top,,0000,0000,0000,,لا يزال يرفض ترك مكتبه مع ذلك
Dialogue: 0,0:08:55.57,0:08:59.27,Default,,0000,0000,0000,,المعذرة، هل أولئك الأشخاص\Nمن معارفك يا أمّاه؟
Dialogue: 0,0:08:59.56,0:09:01.65,Default,,0000,0000,0000,,!لا علاقة لك
Dialogue: 0,0:09:03.02,0:09:07.73,Default,,0000,0000,0000,,!كما لا تملكين حقّ مناداتي بالأم
Dialogue: 0,0:09:07.73,0:09:09.65,Default,,0000,0000,0000,,...آ-آسفة
Dialogue: 0,0:09:10.43,0:09:11.49,Default,,0000,0000,0000,,من هنا
Dialogue: 0,0:09:13.67,0:09:16.10,Default,,0000,0000,0000,,...تتعالى بالنسبة لزوجة ثانية
Dialogue: 0,0:09:17.91,0:09:19.00,Default,,0000,0000,0000,,أبتاه
Dialogue: 0,0:09:19.00,0:09:20.27,Default,,0000,0000,0000,,لم أعرف أنّك في المنزل
Dialogue: 0,0:09:20.54,0:09:26.23,On Top,,0000,0000,0000,,ما الذي تقولينه؟ أخبرتِني أنّك تريدين\N!سماع قصّة السمكة التي اصطدتُها
Dialogue: 0,0:09:20.79,0:09:26.23,CharCard,,0000,0000,0005,,{\fad(300,0)}(تسوجيمورا توشيميتسو (78\Nجدّ إيساو، بروفسور جامعة متقاعد
Dialogue: 0,0:09:27.49,0:09:28.62,Default,,0000,0000,0000,,ما رأيك؟
Dialogue: 0,0:09:28.62,0:09:30.19,Default,,0000,0000,0000,,أليست بالصيد الكبير؟
Dialogue: 0,0:09:30.74,0:09:33.85,Default,,0000,0000,0000,,صحيح... سآتي فوراً
Dialogue: 0,0:09:33.85,0:09:35.86,Default,,0000,0000,0000,,انتظر في غرفة الضيافة يابانية الطراز رجاءً
Dialogue: 0,0:09:35.86,0:09:36.81,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:09:42.81,0:09:46.10,Default,,0000,0000,0000,,!عزيزي، لقد أتى! عزيزي
Dialogue: 0,0:09:47.25,0:09:48.78,Default,,0000,0000,0000,,ليس موجوداً في الداخل؟
Dialogue: 0,0:09:52.80,0:09:55.35,Default,,0000,0000,0000,,كنت هنا إذاً
Dialogue: 0,0:09:55.35,0:10:00.32,Default,,0000,0000,0000,,يا إلهي، تترك الاستيريو يعمل \Nوتنام في مكان كهذا
Dialogue: 0,0:10:01.46,0:10:02.92,Default,,0000,0000,0000,,أوبرا؟
Dialogue: 0,0:10:02.92,0:10:06.31,Default,,0000,0000,0000,,!عزيزي! استيقظ! عزيزي
Dialogue: 0,0:10:06.60,0:10:07.39,Default,,0000,0000,0000,,...عزيز
Dialogue: 0,0:10:15.16,0:10:17.49,Default,,0000,0000,0000,,!عزيزي! تماسك! عزيزي
Dialogue: 0,0:10:17.99,0:10:20.41,Default,,0000,0000,0000,,لا فائدة، إنّه ميت
Dialogue: 0,0:10:20.95,0:10:23.28,Default,,0000,0000,0000,,!ران! اتّصلي بالشرطة
Dialogue: 0,0:10:23.28,0:10:23.98,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:10:23.98,0:10:25.40,Default,,0000,0000,0000,,!عزيزي
Dialogue: 0,0:10:26.98,0:10:29.24,Default,,0000,0000,0000,,لا يزال جسده دافئاً
Dialogue: 0,0:10:29.24,0:10:33.80,Default,,0000,0000,0000,,وبدأت شفتاه بالتحوّل للون البنفسجي
Dialogue: 0,0:10:33.80,0:10:36.70,Default,,0000,0000,0000,,...توجد نقطة حمراء صغيرة بجانب خطّ شعره
Dialogue: 0,0:10:37.26,0:10:38.39,Default,,0000,0000,0000,,أيمكن؟
Dialogue: 0,0:10:46.17,0:10:48.65,Default,,0000,0000,0000,,!أيّها الصبيّ! تعترض طريقي هكذا
Dialogue: 0,0:10:48.65,0:10:49.63,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:10:49.63,0:10:52.24,Default,,0000,0000,0000,,!أليس واجبك مراقبته؟
Dialogue: 0,0:10:52.24,0:10:55.19,Default,,0000,0000,0000,,!كما يُفترض ألّا تُري الصغار جثثاً
Dialogue: 0,0:10:55.49,0:10:56.33,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:10:59.61,0:11:04.32,Default,,0000,0000,0000,,،المُتوفى هو تسوجيمورا إيساو-سان\Nأربع وخمسون عاماً، دبلوماسيّ
Dialogue: 0,0:11:04.69,0:11:09.78,Default,,0000,0000,0000,,والمتحرّي الذي صادف أنّه هنا\N...عندما عُثر على الجثّة
Dialogue: 0,0:11:09.78,0:11:13.27,Default,,0000,0000,0000,,!كان أنا، موري كوغورو، يا حضرة المفتّش ميغوري
Dialogue: 0,0:11:13.27,0:11:17.14,Default,,0000,0000,0000,,إذاً، أهي جريمة قتل أخرى اليوم\Nأيّها المتحرّي العظيم؟
Dialogue: 0,0:11:17.14,0:11:20.60,Default,,0000,0000,0000,,...حسناً، لا توجد علامات على ارتكاب جريمة، فربما
Dialogue: 0,0:11:20.60,0:11:23.20,Default,,0000,0000,0000,,!أمعنوا النظر للجثّة
Dialogue: 0,0:11:23.59,0:11:24.94,Default,,0000,0000,0000,,...لقد
Dialogue: 0,0:11:24.94,0:11:25.81,Default,,0000,0000,0000,,سُمّم
Dialogue: 0,0:11:25.81,0:11:27.65,Default,,0000,0000,0000,,...أجل، سُمّم
Dialogue: 0,0:11:27.92,0:11:31.23,Default,,0000,0000,0000,,سمّمه أحدهم وقتله
Dialogue: 0,0:11:31.88,0:11:35.41,Default,,0000,0000,0000,,توجد نقطة حمراء صغيرة بالقرب من خطّ شعره
Dialogue: 0,0:11:35.41,0:11:38.32,Default,,0000,0000,0000,,وهناك إبرة بجوار الجثّة
Dialogue: 0,0:11:38.58,0:11:41.70,Default,,0000,0000,0000,,مات هذا الرجل مُستنداً
Dialogue: 0,0:11:41.70,0:11:45.78,Default,,0000,0000,0000,,لكنّه أُجلس بتلك الوضعية\Nبعدما سمّمه أحدهم غالباً
Dialogue: 0,0:11:45.78,0:11:48.40,Default,,0000,0000,0000,,...لكن من الممكن أنّه كان انتحاراً
Dialogue: 0,0:11:48.40,0:11:51.99,Default,,0000,0000,0000,,ماذا؟ لم تستوعب؟ انظر للجثّة
Dialogue: 0,0:11:52.36,0:11:56.39,Default,,0000,0000,0000,,شفتاه وأطراف أصابعه\Nبدأت تتحوّل للون البنفسجي
Dialogue: 0,0:11:56.39,0:11:58.41,Default,,0000,0000,0000,,وبعينيه دم متجمّع
Dialogue: 0,0:11:58.77,0:12:00.85,Default,,0000,0000,0000,,هذا دليل اختناقه
Dialogue: 0,0:12:00.85,0:12:06.36,Default,,0000,0000,0000,,مع ذلك لا توجد أيّ علامات\Nعلى الخنق أو الغرق أو المعاناة
Dialogue: 0,0:12:06.88,0:12:08.55,Default,,0000,0000,0000,,الاحتمالية الوحيدة المتبقية
Dialogue: 0,0:12:08.55,0:12:12.67,Default,,0000,0000,0000,,هي أنّه شُلّ ثم اختنق
Dialogue: 0,0:12:12.67,0:12:15.32,Default,,0000,0000,0000,,بسمّ قوي يقتل فورياً
Dialogue: 0,0:12:15.66,0:12:22.45,Default,,0000,0000,0000,,...كما دفء الجثة وعدم بدء تصلّبها يعني
Dialogue: 0,0:12:23.40,0:12:26.53,Default,,0000,0000,0000,,أنّه قُتل قبل نصف ساعة
Dialogue: 0,0:12:26.53,0:12:28.66,Default,,0000,0000,0000,,من دخولنا الغرفة
Dialogue: 0,0:12:29.15,0:12:32.37,Default,,0000,0000,0000,,بفعل شخص دخل هذه الغرفة
Dialogue: 0,0:12:32.65,0:12:35.81,Default,,0000,0000,0000,,موري-كن، من هذا الشاب؟
Dialogue: 0,0:12:35.81,0:12:39.43,Default,,0000,0000,0000,,هاتّوري هيجي، صبي مُتحرٍّ مغرور
Dialogue: 0,0:12:39.43,0:12:41.41,Default,,0000,0000,0000,,هاتّوري... هيجي؟
Dialogue: 0,0:12:42.14,0:12:44.22,Default,,0000,0000,0000,,!أنت هو إذاً
Dialogue: 0,0:12:44.43,0:12:46.51,Default,,0000,0000,0000,,ابن هاتّوري هيزو-سان
Dialogue: 0,0:12:46.51,0:12:49.28,Default,,0000,0000,0000,,!رئيس شرطة أوساكا
Dialogue: 0,0:12:49.69,0:12:51.70,Default,,0000,0000,0000,,رئيس شرطة أوساكا؟
Dialogue: 0,0:12:52.47,0:12:58.83,Default,,0000,0000,0000,,...هذا غريب، يُذكّرني هاتّوري-كن بشينتشي نوعاً ما
Dialogue: 0,0:13:01.79,0:13:04.15,Default,,0000,0000,0000,,أأنت بخير يا كونان-كن؟
Dialogue: 0,0:13:04.15,0:13:07.45,Default,,0000,0000,0000,,تبّاً، أصبح الزكام أسوأ
Dialogue: 0,0:13:08.86,0:13:12.74,Default,,0000,0000,0000,,كلّ النوافذ مقفلة من الداخل
Dialogue: 0,0:13:12.74,0:13:14.90,Default,,0000,0000,0000,,الدخول من الخارج مستحيل
Dialogue: 0,0:13:15.31,0:13:24.63,Default,,0000,0000,0000,,ما يعني أنّ أحدكم دخل عبر الباب بمفتاح احتياطيّ
Dialogue: 0,0:13:24.63,0:13:28.47,Default,,0000,0000,0000,,سيّدتي، أفترض أنّ لهذا المكتب\Nعدّة مفاتيح احتياطية، صحيح؟
Dialogue: 0,0:13:28.47,0:13:31.13,Default,,0000,0000,0000,,كلا، اثنان فحسب
Dialogue: 0,0:13:31.13,0:13:35.17,Default,,0000,0000,0000,,،أحدهما هذا الذي أحمله\Nوالآخر بحوزة زوجي
Dialogue: 0,0:13:35.17,0:13:36.82,Default,,0000,0000,0000,,ز-زوجك؟
Dialogue: 0,0:13:37.21,0:13:40.92,Default,,0000,0000,0000,,أجل، كان يبقيه في جيب بنطاله دوماً
Dialogue: 0,0:13:40.92,0:13:42.53,Default,,0000,0000,0000,,سنلقي نظرة
Dialogue: 0,0:13:44.95,0:13:46.90,Default,,0000,0000,0000,,تبّاً، بنطاله ضيّق
Dialogue: 0,0:13:54.94,0:13:56.24,Default,,0000,0000,0000,,!مـ-محال
Dialogue: 0,0:13:57.19,0:13:57.81,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:57.81,0:13:59.60,Default,,0000,0000,0000,,لم تفهم؟
Dialogue: 0,0:13:59.60,0:14:03.26,Default,,0000,0000,0000,,كان الباب مقفلاً عندما وصلنا
Dialogue: 0,0:14:03.26,0:14:07.20,Default,,0000,0000,0000,,!ما يعني أنّ القاتل أقفل الباب وغادر
Dialogue: 0,0:14:07.43,0:14:10.93,Default,,0000,0000,0000,,أحد المفتاحين مع زوجته\Nالتي دخلت الغرفة معنا
Dialogue: 0,0:14:10.93,0:14:16.15,Default,,0000,0000,0000,,والآخر في جيب بنطال الضحيّة المزدوج
Dialogue: 0,0:14:16.15,0:14:18.49,Default,,0000,0000,0000,,...ما يجعلها جريمة مستحيلة تماماً
Dialogue: 0,0:14:19.13,0:14:21.20,Default,,0000,0000,0000,,!جريمة قتل غرفة مغلقة
Dialogue: 0,0:14:21.67,0:14:24.07,Default,,0000,0000,0000,,جريمة قتل غرفة مغلقة؟
Dialogue: 0,0:14:24.70,0:14:26.03,Default,,0000,0000,0000,,...لا يُمكن
Dialogue: 0,0:14:27.32,0:14:28.66,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:14:28.66,0:14:32.70,Default,,0000,0000,0000,,،يظهر هذا الرجل في الصحف باستمرار\Nلكنّه لم يحلّ القضايا
Dialogue: 0,0:14:32.70,0:14:35.99,Default,,0000,0000,0000,,بل كودو شينتشي، هو من كان وراءها
Dialogue: 0,0:14:36.81,0:14:41.41,Default,,0000,0000,0000,,يتّصل هذا الرجل سرّاً بكودو طلباً للمساعدة
Dialogue: 0,0:14:41.98,0:14:43.97,Default,,0000,0000,0000,,وسيفعل ذلك هذه المرة أيضاً غالباً
Dialogue: 0,0:14:43.97,0:14:44.93,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:14:44.93,0:14:49.83,Default,,0000,0000,0000,,لنرَ من يحلّ جريمة قتل الغرفة المغلقة\N!هذه أوّلاً يا كودو شينتشي
Dialogue: 0,0:14:51.51,0:14:53.18,Default,,0000,0000,0000,,...أشعر بتوعّك شديد
Dialogue: 0,0:14:53.18,0:14:54.86,Default,,0000,0000,0000,,هناك رنين في أذنيّ حتّى
Dialogue: 0,0:14:55.21,0:14:57.88,Default,,0000,0000,0000,,يبدو أن عليّ حلّ هذه القضيّة سريعاً
Dialogue: 0,0:14:57.88,0:15:00.04,Default,,0000,0000,0000,,والعودة للبيت كي أستريح
Dialogue: 0,0:15:00.04,0:15:02.03,Default,,0000,0000,0000,,ما الذي تفعلونه؟
Dialogue: 0,0:15:02.80,0:15:05.75,Default,,0000,0000,0000,,وقعت الجريمة بين الثالثة والنصف والرابعة
Dialogue: 0,0:15:05.75,0:15:10.17,Default,,0000,0000,0000,,أليس عليكم البدء بالتحقق\Nمن حجج غياب المشتبه بهم؟
Dialogue: 0,0:15:10.17,0:15:12.50,Default,,0000,0000,0000,,!صـ-صحيح
Dialogue: 0,0:15:12.50,0:15:14.34,Default,,0000,0000,0000,,!أنت، لا تدعه يغلبك
Dialogue: 0,0:15:14.34,0:15:15.03,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:15.03,0:15:18.49,Default,,0000,0000,0000,,أتريد لصبيّ دخيل أن يخطف الأضواء منك؟
Dialogue: 0,0:15:18.49,0:15:21.78,Default,,0000,0000,0000,,!أعتمد عليك كالعادة أيّها المتحرّي العظيم
Dialogue: 0,0:15:21.78,0:15:23.36,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:15:24.44,0:15:32.23,Default,,0000,0000,0000,,كنتَ تتكلّم مع الجيران عند المدخل\Nبين الثالثة والرابعة طوال الوقت إذاً؟
Dialogue: 0,0:15:32.23,0:15:32.96,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:15:32.96,0:15:36.14,Default,,0000,0000,0000,,...أصحيحٌ أنّ تاكايوشي-سان ويوكيكو-سان
Dialogue: 0,0:15:36.14,0:15:39.12,Default,,0000,0000,0000,,وصلا قُبيل زوجته؟
Dialogue: 0,0:15:39.12,0:15:41.33,Default,,0000,0000,0000,,أجل، لا شكّ في ذلك
Dialogue: 0,0:15:42.05,0:15:47.13,Default,,0000,0000,0000,,أين كنتما إذاً بينما كان يستقبلها عند الباب؟
Dialogue: 0,0:15:47.13,0:15:48.96,Default,,0000,0000,0000,,مكتب أبي
Dialogue: 0,0:15:48.96,0:15:51.79,Default,,0000,0000,0000,,لكنّ الباب كان مقفلاً ولم يجب
Dialogue: 0,0:15:51.79,0:15:53.62,Default,,0000,0000,0000,,فنزلنا فوراً
Dialogue: 0,0:15:53.62,0:15:57.04,Default,,0000,0000,0000,,رأينا الأمّ عندها عند المدخل
Dialogue: 0,0:15:57.45,0:16:01.00,Default,,0000,0000,0000,,وصلت يا توشيميتسو-سان بعد الثانية بقليل، صحيح؟
Dialogue: 0,0:16:01.28,0:16:02.62,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:02.62,0:16:05.94,Default,,0000,0000,0000,,،قطعتُ كلّ الطريق إلى هنا\Nلكنّ إيساو كان منعزلاً في مكتبه
Dialogue: 0,0:16:05.94,0:16:07.77,Default,,0000,0000,0000,,وكيمي-سان قد غادرت
Dialogue: 0,0:16:07.77,0:16:09.27,Default,,0000,0000,0000,,لم يكن لديّ شيء أفعله
Dialogue: 0,0:16:09.27,0:16:11.92,Default,,0000,0000,0000,,فجلستُ أشاهد التلفاز في الغرفة المجاورة
Dialogue: 0,0:16:12.23,0:16:14.37,Default,,0000,0000,0000,,متى غادرتِ سيّدتي؟
Dialogue: 0,0:16:14.37,0:16:15.91,Default,,0000,0000,0000,,قبل ساعة تقريباً
Dialogue: 0,0:16:16.26,0:16:21.60,Default,,0000,0000,0000,,ما يعني أنّ هؤلاء الثلاثة كانوا الوحيدين\Nالقادرين على الاقتراب من الضحيّة
Dialogue: 0,0:16:21.60,0:16:23.83,Default,,0000,0000,0000,,وقت وقوع الجريمة
Dialogue: 0,0:16:24.21,0:16:27.25,Default,,0000,0000,0000,,!يا لعدد الأقراص المدمجة المذهل
Dialogue: 0,0:16:27.25,0:16:30.75,Default,,0000,0000,0000,,أجل، كان السيّد يحب الموسيقى الكلاسيكية
Dialogue: 0,0:16:31.05,0:16:36.58,Default,,0000,0000,0000,,الكلاسيكية؟ صحيح، كانت هناك أوبرا\N...تُعزف عندما وجدناه
Dialogue: 0,0:16:38.45,0:16:41.50,Default,,0000,0000,0000,,ماذا؟ ما هذه الصورة سيّدتي؟
Dialogue: 0,0:16:42.08,0:16:43.70,Default,,0000,0000,0000,,...ماذا؟ تبّاً
Dialogue: 0,0:16:44.11,0:16:47.57,Default,,0000,0000,0000,,مضى على هذه الصّورة 20 عاماً! ما المهمّ فيها؟
Dialogue: 0,0:16:47.57,0:16:49.53,Default,,0000,0000,0000,,...نظري يتشوّش
Dialogue: 0,0:16:49.53,0:16:52.28,Default,,0000,0000,0000,,حضرة المفتّش، ماذا نفعل بالكتب فوق المكتب؟
Dialogue: 0,0:16:52.28,0:16:53.41,Default,,0000,0000,0000,,دعوها وحسب
Dialogue: 0,0:16:54.02,0:16:55.02,Default,,0000,0000,0000,,كتب؟
Dialogue: 0,0:16:55.02,0:16:59.12,Default,,0000,0000,0000,,صحيح، كانت هناك كتب متراكمة\Nبلا علاقة أمام الجثّة
Dialogue: 0,0:16:59.35,0:17:02.58,Default,,0000,0000,0000,,كما لو أُخرجت من الرفّ مباشرة
Dialogue: 0,0:17:03.02,0:17:06.34,Default,,0000,0000,0000,,حضرة المفتّش، وجدنا شيئاً غريباً في مفتاح الضحيّة
Dialogue: 0,0:17:06.34,0:17:07.33,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:07.80,0:17:10.32,Default,,0000,0000,0000,,...عندما تفتح حمّالة المفتاح تجد
Dialogue: 0,0:17:10.32,0:17:11.50,Default,,0000,0000,0000,,شريط لاصق؟
Dialogue: 0,0:17:12.84,0:17:16.62,Default,,0000,0000,0000,,ما هذه الثنية الرفيعة في المنتصف؟
Dialogue: 0,0:17:16.62,0:17:18.83,Default,,0000,0000,0000,,...د-دعاني أرى أيضاً
Dialogue: 0,0:17:21.85,0:17:23.69,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:17:23.69,0:17:25.72,Default,,0000,0000,0000,,...صدري هذه المرّة
Dialogue: 0,0:17:25.74,0:17:28.12,Default,,0000,0000,0000,,!عليّ حلّ هذه القضية سريعاً
Dialogue: 0,0:17:28.65,0:17:31.53,Default,,0000,0000,0000,,هل وصلت لاستنتاج أيّها المتحرّي العظيم؟
Dialogue: 0,0:17:31.53,0:17:33.31,Default,,0000,0000,0000,,كلا، لا شيء
Dialogue: 0,0:17:33.31,0:17:35.33,Default,,0000,0000,0000,,لحظة، أيمكن؟
Dialogue: 0,0:17:37.60,0:17:40.60,Default,,0000,0000,0000,,الكتب المتراكمة بشكل غير طبيعيّ أمام الجثّة
Dialogue: 0,0:17:40.60,0:17:43.70,Default,,0000,0000,0000,,!والأوبرا التي كانت تُعزف في مسرح الجريمة
Dialogue: 0,0:17:43.70,0:17:45.79,Default,,0000,0000,0000,,!الشريط اللاصق على المفتاح
Dialogue: 0,0:17:46.51,0:17:48.75,Default,,0000,0000,0000,,والثنية الغريبة في منتصفه
Dialogue: 0,0:17:48.75,0:17:52.04,Default,,0000,0000,0000,,!كما الفجوة أسفل هذا الباب
Dialogue: 0,0:17:52.59,0:17:53.57,Default,,0000,0000,0000,,!الأوبرا
Dialogue: 0,0:17:55.03,0:17:57.33,Default,,0000,0000,0000,,!هكذا إذاً! حللتُها
Dialogue: 0,0:17:57.33,0:17:59.29,Default,,0000,0000,0000,,!حيلة هذه الغرفة المقفلة
Dialogue: 0,0:17:59.29,0:18:00.56,Default,,0000,0000,0000,,...كما
Dialogue: 0,0:18:03.57,0:18:05.87,Default,,0000,0000,0000,,...الفاعل
Dialogue: 0,0:18:07.78,0:18:09.11,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:18:09.11,0:18:11.42,Default,,0000,0000,0000,,كونان-كن! ما الخطب؟
Dialogue: 0,0:18:16.05,0:18:18.28,Default,,0000,0000,0000,,استدع طبيباً
Dialogue: 0,0:18:18.28,0:18:19.73,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:18:20.75,0:18:22.69,Default,,0000,0000,0000,,حرارته مرتفعة جدّاً
Dialogue: 0,0:18:22.69,0:18:25.46,Default,,0000,0000,0000,,...ماذا؟ اختفى هاتّوري-كن
Dialogue: 0,0:18:25.46,0:18:29.06,Default,,0000,0000,0000,,سأل عن مكان الغرفة يابانية الطراز وغادر
Dialogue: 0,0:18:29.06,0:18:30.40,Default,,0000,0000,0000,,الغرفة يابانية الطراز؟
Dialogue: 0,0:18:33.16,0:18:36.45,Default,,0000,0000,0000,,...يُفترض أن يكون هنا! إن أصاب استنتاجي
Dialogue: 0,0:18:36.45,0:18:40.86,Default,,0000,0000,0000,,لا بدّ أن يكون في مكانٍ ما\N!من هذه الغرفة
Dialogue: 0,0:18:44.69,0:18:48.06,Default,,0000,0000,0000,,!ها هو! وجدته
Dialogue: 0,0:18:49.56,0:18:52.49,Default,,0000,0000,0000,,!الفوز لي يا كودو
Dialogue: 0,0:18:54.10,0:18:57.71,Default,,0000,0000,0000,,المعذرة، أيوجد مكان يمكنه أن يستلقي فيه؟
Dialogue: 0,0:18:57.71,0:19:00.42,Default,,0000,0000,0000,,يمكنك وضعه على سرير غرفتي
Dialogue: 0,0:19:00.42,0:19:02.17,Default,,0000,0000,0000,,إنّها في آخر الرواق
Dialogue: 0,0:19:02.17,0:19:06.25,Default,,0000,0000,0000,,شكراً، أقدّر ذلك
Dialogue: 0,0:19:06.25,0:19:07.62,Default,,0000,0000,0000,,...هاتّوري-كن
Dialogue: 0,0:19:07.62,0:19:08.77,Default,,0000,0000,0000,,اكتشفتها
Dialogue: 0,0:19:09.08,0:19:12.22,Default,,0000,0000,0000,,حيلة الغرفة المقفلة، وهويّة الفاعل
Dialogue: 0,0:19:13.36,0:19:14.65,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:19:15.61,0:19:17.16,Default,,0000,0000,0000,,حللتها بهذه السرعة؟
Dialogue: 0,0:19:17.16,0:19:19.36,Default,,0000,0000,0000,,!هذا ما تناله لبطئك
Dialogue: 0,0:19:19.98,0:19:22.03,Default,,0000,0000,0000,,سأريكم الدليل الآن
Dialogue: 0,0:19:25.69,0:19:27.16,Default,,0000,0000,0000,,خيط صيد؟
Dialogue: 0,0:19:27.48,0:19:28.89,Default,,0000,0000,0000,,مفتّش ميغوري
Dialogue: 0,0:19:28.89,0:19:31.35,Default,,0000,0000,0000,,اعذرني، لكن هلّا لعبت دور الجثّة؟
Dialogue: 0,0:19:31.35,0:19:33.18,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:19:33.18,0:19:36.72,Default,,0000,0000,0000,,...أ-أيمكن أنّه يظن
Dialogue: 0,0:19:37.90,0:19:39.71,Default,,0000,0000,0000,,وقت وقوع الجريمة
Dialogue: 0,0:19:39.71,0:19:43.01,Default,,0000,0000,0000,,كانت كلّ نوافذ المكتب مُقفلة من الداخل
Dialogue: 0,0:19:43.01,0:19:46.71,Default,,0000,0000,0000,,كما أُقفل المدخل الوحيد الآخر
Dialogue: 0,0:19:47.70,0:19:51.40,Default,,0000,0000,0000,,يجعلها هذا جريمة غرفة مقفلة\Nيستحيل الهروب منها بكلّ وضوح
Dialogue: 0,0:19:51.79,0:19:57.07,Default,,0000,0000,0000,,،لكن حتّى عندما تبدو هذه الغرفة مقفلة\Nلا تزال توجد فجوة
Dialogue: 0,0:19:57.37,0:19:58.40,Default,,0000,0000,0000,,فجوة؟
Dialogue: 0,0:19:59.15,0:20:03.03,Default,,0000,0000,0000,,!أجل، الفجوة تحت الباب
Dialogue: 0,0:20:03.03,0:20:07.64,Default,,0000,0000,0000,,أنت، لا تقترح أنّ المفتاح \Nرُمي من تلك الفجوة
Dialogue: 0,0:20:07.64,0:20:11.69,Default,,0000,0000,0000,,إلى جيب بنطال الضحيّة، صحيح؟
Dialogue: 0,0:20:12.18,0:20:14.68,Default,,0000,0000,0000,,يمكنك ذلك
Dialogue: 0,0:20:14.68,0:20:20.16,Default,,0000,0000,0000,,بشريط لاصق وخيط صيد\Nمربوط بإبرة وجدتُه للتوّ
Dialogue: 0,0:20:21.47,0:20:22.53,Default,,0000,0000,0000,,خيط صيد؟
Dialogue: 0,0:20:24.30,0:20:26.49,Default,,0000,0000,0000,,لا تقلق يا كونان-كن
Dialogue: 0,0:20:26.49,0:20:29.02,Default,,0000,0000,0000,,!سيصل طبيب قريباً
Dialogue: 0,0:20:29.46,0:20:32.66,Default,,0000,0000,0000,,!تبّاً! هذا ليس طريفاً
Dialogue: 0,0:20:32.66,0:20:35.75,Default,,0000,0000,0000,,!أنهار من زكام في وقت كهذا
Dialogue: 0,0:20:38.86,0:20:40.07,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:20:40.36,0:20:46.49,Default,,0000,0000,0000,,،بعد وخز القاتل عنق الضحيّة بالإبرة هكذا وقتله
Dialogue: 0,0:20:46.82,0:20:49.44,Default,,0000,0000,0000,,سرق المفتاح الذي بحوزةِ الضحيّة
Dialogue: 0,0:20:49.44,0:20:53.19,Default,,0000,0000,0000,,ثمّ أخرج خيط الصيد المربوط بإبرة
Dialogue: 0,0:20:53.19,0:20:57.69,Default,,0000,0000,0000,,وألصق الطرف الخالي بحمّالة المفتاح
Dialogue: 0,0:20:57.69,0:21:00.63,Default,,0000,0000,0000,,ثمّ أدخل طرف الإبرة في جيب الضحيّة
Dialogue: 0,0:21:00.63,0:21:02.65,Default,,0000,0000,0000,,وسحب الخيط خلاله
Dialogue: 0,0:21:02.65,0:21:05.80,Default,,0000,0000,0000,,ثمّ أجلسه على الكرسيّ
Dialogue: 0,0:21:05.80,0:21:09.86,Default,,0000,0000,0000,,ووضعه في نفس الوضعيّة\Nالتي وجدناه عليها
Dialogue: 0,0:21:09.86,0:21:16.54,Default,,0000,0000,0000,,،أخذ القاتل بعدها الطرفين وخرج من الباب\Nثم مرر الخيطين أسفل الفجوة
Dialogue: 0,0:21:16.54,0:21:20.09,Default,,0000,0000,0000,,وأغلق الباب ثمّ أقفله
Dialogue: 0,0:21:20.53,0:21:24.86,Default,,0000,0000,0000,,ما تبقّى هو وضع المفتاح على الأرض\Nوسحب طرف الإبرة فحسب
Dialogue: 0,0:21:25.41,0:21:28.90,Default,,0000,0000,0000,,مرّ المفتاح أسفل الباب وصعد المكتب
Dialogue: 0,0:21:28.90,0:21:33.44,Default,,0000,0000,0000,,ثمّ دخل جيب الضحيّة من تلقاء نفسه
Dialogue: 0,0:21:33.90,0:21:35.56,Default,,0000,0000,0000,,!د-دخل
Dialogue: 0,0:21:35.56,0:21:38.59,Default,,0000,0000,0000,,...بعدها، بسحبة أخيرة قويّة
Dialogue: 0,0:21:39.21,0:21:40.86,Default,,0000,0000,0000,,نزع الخيط من الشريط اللاصق
Dialogue: 0,0:21:41.09,0:21:44.61,Default,,0000,0000,0000,,وبربطه ببساطة، يختفي الدليل
Dialogue: 0,0:21:45.26,0:21:48.31,Default,,0000,0000,0000,,وتكتمل جريمة قتل الغرفة المقفلة
Dialogue: 0,0:21:49.21,0:21:50.73,Default,,0000,0000,0000,,...بـ-بالفعل
Dialogue: 0,0:21:51.08,0:21:54.08,Default,,0000,0000,0000,,!تماسك يا كونان-كن! كونان-كن
Dialogue: 0,0:21:54.08,0:21:57.24,Default,,0000,0000,0000,,...أشعر بسخونة شديدة... كأنّ قلبي على وشك الانفجار
Dialogue: 0,0:21:59.24,0:22:01.19,Default,,0000,0000,0000,,!لا بدّ أنّه الطبيب
Dialogue: 0,0:22:01.70,0:22:04.49,Default,,0000,0000,0000,,!انتظر! سأجلبه فوراً
Dialogue: 0,0:22:05.78,0:22:09.40,Default,,0000,0000,0000,,هـ-هل سأموت؟
Dialogue: 0,0:22:09.40,0:22:13.69,Default,,0000,0000,0000,,!هل سأموت هكذا؟
Dialogue: 0,0:22:18.05,0:22:19.51,Default,,0000,0000,0000,,إذاً يا كودو؟
Dialogue: 0,0:22:19.51,0:22:22.47,Default,,0000,0000,0000,,إذا كانت لديك مشكلة مع استنتاجي، فأظهِر نفسك
Dialogue: 0,0:22:22.47,0:22:26.06,Default,,0000,0000,0000,,!عليك الإسراع وإلّا سأحلّ كل شيء
Dialogue: 0,0:24:00.00,0:24:02.57,Default,,0000,0000,0000,,كلا، ليس صحيحاً
Dialogue: 0,0:24:06.16,0:24:07.73,Default,,0000,0000,0000,,ليس صحيحاً البتّة
Dialogue: 0,0:24:08.24,0:24:08.90,Default,,0000,0000,0000,,!كودو
Dialogue: 0,0:24:09.65,0:24:11.03,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:24:12.11,0:24:14.86,Default,,0000,0000,0000,,!ما الخطأ في استنتاجي يا كودو؟
Dialogue: 0,0:24:16.86,0:24:19.27,Default,,0000,0000,0000,,!لا... يمكن
Dialogue: 0,0:24:19.76,0:24:23.61,Default,,0000,0000,0000,,!أجل، القاتل... هو أنت
Dialogue: 0,0:24:23.72,0:24:25.64,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.64,0:24:28.73,Default,,0000,0000,0000,,(جريمة قتل الدبلوماسيّ (الجزء الثاني
Dialogue: 0,0:24:45.12,0:24:47.31,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.31,0:24:49.71,Default,,0000,0000,0000,,قرص أوبرا مدمج وكتب
Dialogue: 0,0:24:50.01,0:24:51.00,Default,,0000,0000,0000,,...في الحلقة القادمة
Dialogue: 0,0:24:51.00,0:24:54.54,Default,,0000,0000,0000,,!رجعت! ها أنا بعد 14 شهراً، شينتشي

