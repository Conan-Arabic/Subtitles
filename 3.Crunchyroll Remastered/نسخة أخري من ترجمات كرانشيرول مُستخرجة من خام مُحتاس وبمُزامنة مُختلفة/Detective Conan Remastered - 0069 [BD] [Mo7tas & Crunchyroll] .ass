Dialogue: 0,0:00:01.70,0:00:03.58,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.58,0:00:06.78,Default,,0000,0000,0000,,لنعالج باستنتاجات كونان القلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.16,0:00:10.32,Default,,0000,0000,0000,,!تتمحور قضيّة اليوم حول ران-نيتشان\N!حركتها وهمومها ولمعانها
Dialogue: 0,0:00:10.83,0:00:12.49,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.49,0:00:14.57,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.57,0:00:17.11,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:52.51,0:01:55.39,Default,,0000,0000,0000,,ذهبتُ مع ران والعمّ في جولة غموض إيزو
Dialogue: 0,0:01:55.39,0:02:01.21,Default,,0000,0000,0000,,مكان البروفسور آغاسا وصديقه وحفيدته\Nالذين لم يستطيعوا الحضور
Dialogue: 0,0:02:01.21,0:02:06.64,Default,,0000,0000,0000,,مُنظّم هذه الجولة مختبئ\Nبين المشاركين ويلعب دور بارون الليل
Dialogue: 0,0:02:06.64,0:02:09.10,Default,,0000,0000,0000,,ويسبّب حادثة أثناء الجولة
Dialogue: 0,0:02:09.10,0:02:14.87,Default,,0000,0000,0000,,من يكتشف هويّته سيمكنه الإقامة بالمجّان
Dialogue: 0,0:02:14.87,0:02:18.66,Default,,0000,0000,0000,,ويحصل على أقراص مرنة تحوي برنامجاً ما
Dialogue: 0,0:02:19.70,0:02:22.46,Default,,0000,0000,0000,,يراقب المشاركون بعضهم
Dialogue: 0,0:02:22.46,0:02:26.19,Default,,0000,0000,0000,,دفعني بارون الليل من شرفةٍ\Nعندما كنتُ بمفردي
Dialogue: 0,0:02:27.56,0:02:29.24,Default,,0000,0000,0000,,سقطتُ في المسبح
Dialogue: 0,0:02:30.19,0:02:33.68,Default,,0000,0000,0000,,أكان هذا تحذيراً؟ أم مجرّد جزء من اللعبة؟
Dialogue: 0,0:02:35.01,0:02:37.02,Default,,0000,0000,0000,,...ثمّ وقعت الحادثة
Dialogue: 0,0:02:38.01,0:02:41.21,Default,,0000,0000,0000,,!سقط بارون الليل على تمثال برونزيّ
Dialogue: 0,0:02:42.45,0:02:48.48,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل بارون الليل (جزء الاشتباه
Dialogue: 0,0:02:43.20,0:02:47.03,Default,,0000,0000,0000,,(جريمة قتل بارون الليل (جزء الاشتباه
Dialogue: 0,0:02:48.48,0:02:51.10,CharCard,,0000,0000,0000,,فندق الأميرة إيزو
Dialogue: 0,0:02:51.36,0:02:52.92,Default,,0000,0000,0000,,شخص يرتدي قناعاً؟
Dialogue: 0,0:03:01.39,0:03:04.67,Default,,0000,0000,0000,,!كان من سقط بارون الليل بالفعل إذاً
Dialogue: 0,0:03:08.30,0:03:09.21,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:03:10.89,0:03:12.62,Default,,0000,0000,0000,,!أنت! يا ولد
Dialogue: 0,0:03:12.62,0:03:14.08,Default,,0000,0000,0000,,!آسفة
Dialogue: 0,0:03:16.80,0:03:20.09,Default,,0000,0000,0000,,ماذا؟ ألستَ من يعيش مع المتحرّي موري؟
Dialogue: 0,0:03:20.09,0:03:22.37,Default,,0000,0000,0000,,!كونان-كن! لا يصحّ أن تفعل هذا
Dialogue: 0,0:03:22.37,0:03:25.00,Default,,0000,0000,0000,,أعتذر بشدّة
Dialogue: 0,0:03:25.00,0:03:26.34,Default,,0000,0000,0000,,!أنت يا ران-سان
Dialogue: 0,0:03:28.45,0:03:31.99,Default,,0000,0000,0000,,أأنت... يوكوميزو-سان من قسم شرطة سايتاما؟
Dialogue: 0,0:03:31.99,0:03:33.19,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:03:33.19,0:03:34.85,Default,,0000,0000,0000,,لكن لمَ أنت هنا؟
Dialogue: 0,0:03:34.85,0:03:38.58,CharCard,,0000,0000,0004,,{\fad(00,300)}المحقّق يوكوميزو\Nنُقل من محافظة سايتاما إلى محافظة شيزوكا
Dialogue: 0,0:03:35.11,0:03:39.03,On Top,,0000,0000,0000,,نُقلت إلى شيزوكا الشهر الفائت
Dialogue: 0,0:03:39.03,0:03:40.21,On Top,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:03:40.99,0:03:42.46,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:03:44.89,0:03:46.26,Default,,0000,0000,0000,,!إيبارا-سان
Dialogue: 0,0:03:46.26,0:03:48.81,Default,,0000,0000,0000,,!أتعرفينه يا ران-سان؟
Dialogue: 0,0:03:48.81,0:03:49.67,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:49.67,0:03:53.12,Default,,0000,0000,0000,,كان مشاركاً معنا في جولة الغموض
Dialogue: 0,0:03:53.12,0:03:54.79,Default,,0000,0000,0000,,!جولة الغموض؟
Dialogue: 0,0:03:54.79,0:03:57.98,Default,,0000,0000,0000,,يرتدي قفّازاً واحداً فحسب
Dialogue: 0,0:04:03.37,0:04:04.46,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:04:04.91,0:04:09.33,Default,,0000,0000,0000,,الهدف منها هو اكتشاف هويّة\Nالمُنظّم بارون الليل إذاً
Dialogue: 0,0:04:09.33,0:04:13.37,Default,,0000,0000,0000,,ما يعني أنّ المُنظّم كان إيبارا-سان هنا
Dialogue: 0,0:04:16.99,0:04:20.45,Default,,0000,0000,0000,,...انتحار؟ حادث؟ أم
Dialogue: 0,0:04:21.06,0:04:23.67,Default,,0000,0000,0000,,بالمناسبة، أين المتحرّي موري؟
Dialogue: 0,0:04:23.67,0:04:25.09,Default,,0000,0000,0000,,...إنّه
Dialogue: 0,0:04:25.09,0:04:27.27,Default,,0000,0000,0000,,في حانة الطابق الثاني
Dialogue: 0,0:04:27.27,0:04:28.23,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:04:29.48,0:04:30.92,Default,,0000,0000,0000,,!كاميجو-سان
Dialogue: 0,0:04:31.68,0:04:33.93,Default,,0000,0000,0000,,!لنتكلّم في الموضوع معه بأيّ حال
Dialogue: 0,0:04:33.93,0:04:35.56,Default,,0000,0000,0000,,حسناً، تعال يا كونان-كن
Dialogue: 0,0:04:35.56,0:04:36.34,Default,,0000,0000,0000,,!من هنا
Dialogue: 0,0:04:36.34,0:04:37.38,Default,,0000,0000,0000,,!انتظراني
Dialogue: 0,0:04:40.76,0:04:41.75,Default,,0000,0000,0000,,دموع؟
Dialogue: 0,0:04:45.67,0:04:48.09,CharCard,,0000,0000,0001,,الطابق الثاني لفندق الأميرة\N(حانة (الزمّرد
Dialogue: 0,0:04:48.09,0:04:52.04,Default,,0000,0000,0000,,!نام ثملاً في مكان كهذا
Dialogue: 0,0:04:53.41,0:04:55.86,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:04:57.28,0:05:00.87,Default,,0000,0000,0000,,ماذا؟! سقط إيبارا-سان ولقي حتفه\N!وهو يرتدي رداء بارون الليل؟
Dialogue: 0,0:05:01.77,0:05:06.88,Default,,0000,0000,0000,,أجل، وفقاً للشهود فقد سقط\Nعند تمام العاشرة
Dialogue: 0,0:05:06.88,0:05:09.19,Default,,0000,0000,0000,,لمَ تفعل هذا بيديك؟
Dialogue: 0,0:05:09.19,0:05:10.86,Default,,0000,0000,0000,,...حسناً... الرائحة
Dialogue: 0,0:05:11.55,0:05:13.18,Default,,0000,0000,0000,,العاشرة إذاً؟
Dialogue: 0,0:05:14.59,0:05:15.30,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:05:15.30,0:05:17.80,Default,,0000,0000,0000,,!عجباً! تأخّر الوقت لهذا الحد؟
Dialogue: 0,0:05:18.55,0:05:22.75,Default,,0000,0000,0000,,إذاً، أتفقدتم الغرفة 2101 التي\Nكان يقيم فيها؟
Dialogue: 0,0:05:23.67,0:05:27.21,Default,,0000,0000,0000,,كنّا نحاول ذلك، لكن لم نستطع الدخول
Dialogue: 0,0:05:30.92,0:05:34.12,Default,,0000,0000,0000,,قفل أمان مربوط في الداخل
Dialogue: 0,0:05:35.32,0:05:36.04,Default,,0000,0000,0000,,اكسروه فوراً
Dialogue: 0,0:05:47.81,0:05:48.42,Default,,0000,0000,0000,,!حسناً، فُتح
Dialogue: 0,0:05:52.18,0:05:53.85,Default,,0000,0000,0000,,توجد ثياب هنا
Dialogue: 0,0:05:53.85,0:05:57.00,Default,,0000,0000,0000,,هذه التي كان يرتديها إيبارا-سان اليوم
Dialogue: 0,0:05:57.93,0:06:00.35,Default,,0000,0000,0000,,ترك مفتاح غرفته هنا حتّى
Dialogue: 0,0:06:00.35,0:06:04.71,Default,,0000,0000,0000,,بالمناسبة، كان ثملاً جدّاً
Dialogue: 0,0:06:07.50,0:06:09.03,Default,,0000,0000,0000,,النافذة مفتوحة
Dialogue: 0,0:06:09.03,0:06:10.91,Default,,0000,0000,0000,,وتوجد شرفة في الخارج
Dialogue: 0,0:06:15.70,0:06:19.02,Default,,0000,0000,0000,,يبدو أنّه سقط من هنا
Dialogue: 0,0:06:20.83,0:06:22.44,Default,,0000,0000,0000,,انتبه يا مُتحرّي موري
Dialogue: 0,0:06:22.44,0:06:26.04,Default,,0000,0000,0000,,هذا... مجرّد حادث
Dialogue: 0,0:06:26.52,0:06:27.38,Default,,0000,0000,0000,,!حادث؟
Dialogue: 0,0:06:28.15,0:06:31.58,Default,,0000,0000,0000,,لا شكّ في الأمر، يوجد قفّاز عالق بالسور
Dialogue: 0,0:06:31.58,0:06:32.81,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:06:36.10,0:06:38.85,Default,,0000,0000,0000,,حاول النزول غالباً من الشرفة في ردائه ذاك
Dialogue: 0,0:06:38.85,0:06:42.42,Default,,0000,0000,0000,,لإخافة المشاركين في الغرفة أسفلها
Dialogue: 0,0:06:42.72,0:06:45.72,Default,,0000,0000,0000,,لكنّه تعثّر ولقي حتفه
Dialogue: 0,0:06:45.72,0:06:47.93,Default,,0000,0000,0000,,...أتساءل عن ذلك
Dialogue: 0,0:06:48.22,0:06:50.22,Default,,0000,0000,0000,,هذا الطابق 21
Dialogue: 0,0:06:50.22,0:06:52.88,Default,,0000,0000,0000,,هل يحاول النزول دون حبل حقّاً؟
Dialogue: 0,0:06:53.50,0:06:55.84,Default,,0000,0000,0000,,كما كان مفتاح الغرفة في الداخل
Dialogue: 0,0:06:56.25,0:07:00.92,Default,,0000,0000,0000,,إذا نجح في النزول للغرفة السفليّة\Nثمّ خرج منها
Dialogue: 0,0:07:01.41,0:07:04.88,Default,,0000,0000,0000,,فسيحتاج المفتاح للعودة هنا
Dialogue: 0,0:07:04.88,0:07:06.05,Default,,0000,0000,0000,,!اخرس
Dialogue: 0,0:07:12.15,0:07:13.55,Default,,0000,0000,0000,,!قلم الحبر خاصتي
Dialogue: 0,0:07:13.82,0:07:17.44,Default,,0000,0000,0000,,بأيّ حال، دعني أتفقد الجثّة
Dialogue: 0,0:07:17.44,0:07:18.35,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:07:18.86,0:07:21.55,Default,,0000,0000,0000,,رغم أنّ رؤيتها لن تغيّر شيئاً غالباً
Dialogue: 0,0:07:28.06,0:07:29.89,Default,,0000,0000,0000,,...يا للفظاعة
Dialogue: 0,0:07:29.89,0:07:34.59,Default,,0000,0000,0000,,...سقط من 21 طابقاً إذاً على ذاك التمثال
Dialogue: 0,0:07:35.21,0:07:37.25,Default,,0000,0000,0000,,هل اقترب أحد من الجثّة؟
Dialogue: 0,0:07:37.25,0:07:42.04,Default,,0000,0000,0000,,كلا يا محقّق يوكوميزو، لم يلمس أحدٌ الجثّة\Nسوانا نحن الشرطة وشخص واحد
Dialogue: 0,0:07:42.04,0:07:43.17,Default,,0000,0000,0000,,ذاك الصبيّ
Dialogue: 0,0:07:44.87,0:07:46.47,Default,,0000,0000,0000,,ذاك الولد مُجدداً؟
Dialogue: 0,0:07:50.82,0:07:52.38,Default,,0000,0000,0000,,ما الذي تفعله يا كونان-كن؟
Dialogue: 0,0:07:52.82,0:07:56.47,Default,,0000,0000,0000,,لا أجد قلم البحر الذي سقط منّي
Dialogue: 0,0:07:56.90,0:08:01.81,Default,,0000,0000,0000,,أصحيحٌ أنّ إيبارا-سان سقط لحتفه\Nيا موري-سان؟
Dialogue: 0,0:08:01.81,0:08:05.13,Default,,0000,0000,0000,,لا شكّ في الأمر، كان إيبارا توكيو
Dialogue: 0,0:08:05.64,0:08:07.55,Default,,0000,0000,0000,,وكان يرتدي قناعاً
Dialogue: 0,0:08:07.89,0:08:09.26,Default,,0000,0000,0000,,قـ-قناع؟
Dialogue: 0,0:08:10.06,0:08:15.59,Default,,0000,0000,0000,,فهمت، كان هو مُنظّم الجولة\Nوبارون الليل إذاً
Dialogue: 0,0:08:16.71,0:08:20.83,Default,,0000,0000,0000,,عرفت، بدا لي مثيراً للشبهة
Dialogue: 0,0:08:20.83,0:08:22.42,Default,,0000,0000,0000,,توقّفي، ليس هذا وقته
Dialogue: 0,0:08:22.83,0:08:28.60,Default,,0000,0000,0000,,موت بارون الليل المنيع\Nنهاية بائسة بحقّ
Dialogue: 0,0:08:29.29,0:08:31.42,Default,,0000,0000,0000,,من هؤلاء الأشخاص؟
Dialogue: 0,0:08:31.42,0:08:34.05,Default,,0000,0000,0000,,أعضاء في نفس الجولة معي
Dialogue: 0,0:08:34.36,0:08:36.26,Default,,0000,0000,0000,,...لكن لمَ إيبارا-سان
Dialogue: 0,0:08:36.26,0:08:38.72,Default,,0000,0000,0000,,كانت حادثة فحسب
Dialogue: 0,0:08:39.28,0:08:40.01,Default,,0000,0000,0000,,حادثة؟
Dialogue: 0,0:08:40.32,0:08:43.97,Default,,0000,0000,0000,,أجل، سقط من الشرفة وهو\Nيحاول النزول لإخافتكم
Dialogue: 0,0:08:45.85,0:08:49.68,Default,,0000,0000,0000,,بأيّ حال، مات بارون الليل
Dialogue: 0,0:08:49.68,0:08:51.80,Default,,0000,0000,0000,,انتهت الجولة الآن
Dialogue: 0,0:08:55.47,0:08:56.97,Default,,0000,0000,0000,,!عجباً
Dialogue: 0,0:08:57.72,0:09:00.75,Default,,0000,0000,0000,,غريب، ما خطب ربطة العنق هذه؟
Dialogue: 0,0:09:01.25,0:09:04.00,Default,,0000,0000,0000,,انظروا لهذه العقدة
Dialogue: 0,0:09:04.00,0:09:04.93,Default,,0000,0000,0000,,العقدة؟
Dialogue: 0,0:09:06.71,0:09:09.22,Default,,0000,0000,0000,,!إنّها مقلوبة! مقلوبة
Dialogue: 0,0:09:09.22,0:09:11.67,Default,,0000,0000,0000,,لكن قد تكون هذه عادته
Dialogue: 0,0:09:12.11,0:09:14.12,Default,,0000,0000,0000,,ربطة عنقه معي
Dialogue: 0,0:09:14.95,0:09:15.50,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:09:17.32,0:09:19.32,Default,,0000,0000,0000,,كيف حصلت عليها؟
Dialogue: 0,0:09:19.32,0:09:21.98,Default,,0000,0000,0000,,أعطتني إيّاها نادلة
Dialogue: 0,0:09:21.98,0:09:23.84,Default,,0000,0000,0000,,قالت أنّه نسيها
Dialogue: 0,0:09:24.39,0:09:27.48,Default,,0000,0000,0000,,!بالفعل، عقدة ربطة العنق هذه طبيعية
Dialogue: 0,0:09:27.48,0:09:28.42,Default,,0000,0000,0000,,!عجباً
Dialogue: 0,0:09:28.42,0:09:29.76,Default,,0000,0000,0000,,!ماذا؟! أهناك شيء آخر؟
Dialogue: 0,0:09:30.44,0:09:32.88,Default,,0000,0000,0000,,حزامه في وضع غريب أيضاً
Dialogue: 0,0:09:32.88,0:09:35.13,Default,,0000,0000,0000,,انظروا، إنّه مقلوب
Dialogue: 0,0:09:35.13,0:09:37.18,Default,,0000,0000,0000,,هذا الشخص لا يجيد ارتداء الكماليّات
Dialogue: 0,0:09:37.80,0:09:40.80,Default,,0000,0000,0000,,هذا غريبٌ فوق المعتاد يا موري-سان
Dialogue: 0,0:09:40.80,0:09:43.71,Default,,0000,0000,0000,,أجل، لم يرتد الملابس بنفسه
Dialogue: 0,0:09:43.71,0:09:45.13,Default,,0000,0000,0000,,هناك من ألبسه
Dialogue: 0,0:09:45.58,0:09:50.50,Default,,0000,0000,0000,,ما يعني أنّ إيبارا-سان دُفع\Nمن غرفة الطابق الواحد والعشرين
Dialogue: 0,0:09:50.50,0:09:52.38,Default,,0000,0000,0000,,من قِبل بارون الليل الحقيقيّ
Dialogue: 0,0:09:52.78,0:09:57.84,Default,,0000,0000,0000,,!أي أنّ بارون الليل القاتل لا يزال بيننا
Dialogue: 0,0:10:02.05,0:10:07.01,Default,,0000,0000,0000,,يبدو أنّ علينا استجوابكم عن حجج غيابكم
Dialogue: 0,0:10:07.01,0:10:09.97,Default,,0000,0000,0000,,وقت سقوط إيبارا-سان عند العاشرة
Dialogue: 0,0:10:10.52,0:10:14.59,Default,,0000,0000,0000,,اذهب لمكتب الاستقبال واطلب منهم\Nتجهيز غرفة للاستجواب
Dialogue: 0,0:10:14.59,0:10:15.34,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:10:15.34,0:10:17.59,Default,,0000,0000,0000,,ماذا نفعل بالجثّة والزيّ؟
Dialogue: 0,0:10:17.59,0:10:18.72,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:10:19.47,0:10:23.80,Default,,0000,0000,0000,,فلنبقه في مكتب الفندق\Nحتى ننهي الاستجواب
Dialogue: 0,0:10:23.80,0:10:24.88,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:25.76,0:10:27.72,On Top,,0000,0000,0000,,غرفة استجواب\Nللأشخاص المعنيّين فقط
Dialogue: 0,0:10:26.88,0:10:27.72,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:10:27.72,0:10:32.17,Default,,0000,0000,0000,,كنت في صالة المراقبة رفقة\Nران وكونان عند العاشرة إذاً؟
Dialogue: 0,0:10:32.41,0:10:35.03,Default,,0000,0000,0000,,أجل، انفصلتُ عنهما
Dialogue: 0,0:10:35.03,0:10:37.14,Default,,0000,0000,0000,,بعد العاشرة بقليل
Dialogue: 0,0:10:37.62,0:10:39.10,Default,,0000,0000,0000,,!هذه الحقيقة يا أبي
Dialogue: 0,0:10:39.95,0:10:43.05,Default,,0000,0000,0000,,لكنّك كنت من نظر للساعة، صحيح يا مايدا-سان؟
Dialogue: 0,0:10:44.56,0:10:45.51,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:10:45.51,0:10:49.02,Default,,0000,0000,0000,,حسناً، لا بأس. استدعوا الشخص التالي
Dialogue: 0,0:10:49.02,0:10:51.68,Default,,0000,0000,0000,,حجّة غيابي مُحكمة
Dialogue: 0,0:10:51.68,0:10:56.76,Default,,0000,0000,0000,,!فقد كنتُ في الحانة مع هذا الرجل وقت الحادثة
Dialogue: 0,0:10:56.76,0:10:58.76,Default,,0000,0000,0000,,صحيح حضرة المتحرّي؟
Dialogue: 0,0:10:58.76,0:11:00.56,Default,,0000,0000,0000,,نـ-نعم
Dialogue: 0,0:11:02.71,0:11:05.47,Default,,0000,0000,0000,,لكن ألم يغلبه الثمل؟
Dialogue: 0,0:11:06.50,0:11:08.09,Default,,0000,0000,0000,,...صـ-صحيح، لكن
Dialogue: 0,0:11:08.09,0:11:09.84,Default,,0000,0000,0000,,حسناً، التالي
Dialogue: 0,0:11:09.84,0:11:13.12,Default,,0000,0000,0000,,كنّا في المطعم المفتوح
Dialogue: 0,0:11:13.12,0:11:14.83,Default,,0000,0000,0000,,حيث سقط إيبارا-سان
Dialogue: 0,0:11:14.83,0:11:16.29,Default,,0000,0000,0000,,أليس كذلك يا شيزوي-سان؟
Dialogue: 0,0:11:16.29,0:11:17.80,Default,,0000,0000,0000,,بلى سيّدي
Dialogue: 0,0:11:17.80,0:11:20.01,Default,,0000,0000,0000,,أهناك من يشهد بذلك؟
Dialogue: 0,0:11:20.01,0:11:26.93,Default,,0000,0000,0000,,حسناً... كانت الجلبة كبيرة فلا أدري\Nإن كان هناك من يتذكّرنا
Dialogue: 0,0:11:27.57,0:11:32.34,Default,,0000,0000,0000,,لكن بطريقة موته، الأمر ليس مُستغرباً
Dialogue: 0,0:11:34.64,0:11:36.34,Default,,0000,0000,0000,,!استدعوا التالي
Dialogue: 0,0:11:36.68,0:11:39.68,Default,,0000,0000,0000,,كنتُ في غرفتي أقرأ رسائل بريد إلكترونية
Dialogue: 0,0:11:39.68,0:11:43.97,Default,,0000,0000,0000,,على الحاسوب من التاسعة وخمس وأربعون إلى بعد العاشرة
Dialogue: 0,0:11:44.92,0:11:48.00,Default,,0000,0000,0000,,يُفترض أنّ سجلّات الفندق ستثبت ذلك
Dialogue: 0,0:11:48.00,0:11:50.92,Default,,0000,0000,0000,,لكنك لم تتكلم مع أحد، صحيح؟
Dialogue: 0,0:11:50.92,0:11:54.64,Default,,0000,0000,0000,,بلى، مع حاسوبي
Dialogue: 0,0:11:55.34,0:11:56.58,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:57.33,0:11:59.74,Default,,0000,0000,0000,,استدعوا التالي
Dialogue: 0,0:11:59.74,0:12:02.11,Default,,0000,0000,0000,,كنتِ بمفردك في غرفتك طوال الوقت، صحيح؟
Dialogue: 0,0:12:02.11,0:12:03.40,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:03.40,0:12:05.63,Default,,0000,0000,0000,,كنتُ أشاهد التلفاز وحدي
Dialogue: 0,0:12:05.63,0:12:08.07,Default,,0000,0000,0000,,حتّى رجع ساتورو بعد العاشرة
Dialogue: 0,0:12:08.07,0:12:11.59,Default,,0000,0000,0000,,يعني أنّ لا أحد يشهد لك بذلك؟
Dialogue: 0,0:12:12.02,0:12:15.27,Default,,0000,0000,0000,,يـ-يمكنني وصف الفيلم الذي كنتُ أشاهده مع ذلك
Dialogue: 0,0:12:15.27,0:12:17.16,Default,,0000,0000,0000,,...كانت هناك قنبلة في ناطحة سحاب
Dialogue: 0,0:12:17.16,0:12:20.47,Default,,0000,0000,0000,,كلا، لن يكفي ذلك كدليل
Dialogue: 0,0:12:25.30,0:12:29.60,Default,,0000,0000,0000,,!هذا قاسٍ! يجعلونني أحرسه بمفردي
Dialogue: 0,0:12:30.46,0:12:32.88,Default,,0000,0000,0000,,!آمل أن ينهوا الاستجواب سريعاً
Dialogue: 0,0:12:33.87,0:12:37.91,Default,,0000,0000,0000,,!أثار والدك وذاك المحقق أعصابي حقّاً
Dialogue: 0,0:12:37.91,0:12:40.25,Default,,0000,0000,0000,,لا بدّ أنّهما يعتقدانني المجرمة
Dialogue: 0,0:12:40.25,0:12:41.34,Default,,0000,0000,0000,,!هذا ليس صحيحاً
Dialogue: 0,0:12:42.36,0:12:44.93,Default,,0000,0000,0000,,هناك الكثير من الأشخاص المشبوهين غيري
Dialogue: 0,0:12:44.93,0:12:46.15,Default,,0000,0000,0000,,...بالفعل
Dialogue: 0,0:12:49.03,0:12:50.31,Default,,0000,0000,0000,,هل انتهت مناوبتي؟
Dialogue: 0,0:12:50.79,0:12:51.74,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:12:52.64,0:12:53.54,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:56.23,0:12:59.55,Default,,0000,0000,0000,,حجج غياب جميع المشاركين في الجولة ضعيفة
Dialogue: 0,0:12:59.89,0:13:04.42,Default,,0000,0000,0000,,هل طلبتِ من خدمة الغرف شيئاً\Nعندما كنتِ في غرفتك؟
Dialogue: 0,0:13:04.42,0:13:06.89,Default,,0000,0000,0000,,لو فعلت لقلتُ ذلك
Dialogue: 0,0:13:06.89,0:13:12.80,Default,,0000,0000,0000,,كيف غادر القاتل بعدما\Nدفع إيبارا-سان من شرفة الغرفة؟
Dialogue: 0,0:13:13.46,0:13:17.25,Default,,0000,0000,0000,,كان قفل الأمان مربوطاً، فكيف؟
Dialogue: 0,0:13:18.08,0:13:22.82,Default,,0000,0000,0000,,كلّ ما نعرفه هو أنّ القاتل\Nلا يزال في هذا الفندق فحسب
Dialogue: 0,0:13:24.82,0:13:26.18,Default,,0000,0000,0000,,اتّصلتِ بمكتب الاستقبال؟
Dialogue: 0,0:13:26.85,0:13:29.14,Default,,0000,0000,0000,,أجل، طلبتُ اتّصال إيقاظ صباحيّ
Dialogue: 0,0:13:29.14,0:13:30.10,Default,,0000,0000,0000,,متى كان ذلك؟
Dialogue: 0,0:13:30.75,0:13:32.42,Default,,0000,0000,0000,,...عند العاشرة وفقما أظنّ
Dialogue: 0,0:13:32.81,0:13:36.64,Default,,0000,0000,0000,,!يحتفظ الفندق بسجلّات مكالمات الغرف ووقتها
Dialogue: 0,0:13:38.19,0:13:40.31,Default,,0000,0000,0000,,...أي أنّ حجّة غيابك
Dialogue: 0,0:13:41.26,0:13:43.38,Default,,0000,0000,0000,,!هذا رائع يا أكيكو-سان
Dialogue: 0,0:13:50.67,0:13:51.86,Default,,0000,0000,0000,,!بارون الليل
Dialogue: 0,0:13:58.83,0:14:00.06,Default,,0000,0000,0000,,!بارون الليل
Dialogue: 0,0:14:02.16,0:14:02.80,Default,,0000,0000,0000,,!مُحال
Dialogue: 0,0:14:04.16,0:14:04.88,Default,,0000,0000,0000,,!تراجعي
Dialogue: 0,0:14:18.94,0:14:19.51,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:14:19.94,0:14:22.92,Default,,0000,0000,0000,,ما الذي تفعلينه يا ران-نيتشان؟\N!إنّه يهرب! ران-نيتشان
Dialogue: 0,0:14:23.26,0:14:24.59,Default,,0000,0000,0000,,!ران-نيتشان
Dialogue: 0,0:14:24.59,0:14:26.55,Default,,0000,0000,0000,,!ماذا؟ ظهر؟
Dialogue: 0,0:14:26.97,0:14:29.93,Default,,0000,0000,0000,,!حمقاء! لمَ لم تمسكي به؟
Dialogue: 0,0:14:29.93,0:14:32.31,Default,,0000,0000,0000,,آسفة، كنتُ مصدومة
Dialogue: 0,0:14:32.31,0:14:33.93,Default,,0000,0000,0000,,!محقّق يوكوميزو
Dialogue: 0,0:14:34.46,0:14:35.29,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:14:35.29,0:14:37.63,Default,,0000,0000,0000,,كان فاقداً للوعي في غرفة حراسة الجثّة
Dialogue: 0,0:14:37.63,0:14:39.64,Default,,0000,0000,0000,,!يبدو أنّ أحداً ضربه
Dialogue: 0,0:14:39.64,0:14:41.63,Default,,0000,0000,0000,,ماذا؟ ما حلّ بالجثّة؟
Dialogue: 0,0:14:42.03,0:14:45.59,Default,,0000,0000,0000,,!إنّها بخير، لكنّ زيّ بارون الليل اختفى
Dialogue: 0,0:14:45.59,0:14:47.63,Default,,0000,0000,0000,,زيّ بارون الليل؟
Dialogue: 0,0:14:47.63,0:14:48.39,Default,,0000,0000,0000,,...موري-سان
Dialogue: 0,0:14:48.39,0:14:49.35,Default,,0000,0000,0000,,!محقّق يوكوميزو
Dialogue: 0,0:14:49.65,0:14:50.31,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:14:50.31,0:14:52.26,Default,,0000,0000,0000,,!بارون الليل في المسبح
Dialogue: 0,0:14:52.26,0:14:53.01,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:56.36,0:14:59.31,Default,,0000,0000,0000,,!القناع والقبعة، والشعر المستعار والمعطف
Dialogue: 0,0:14:59.31,0:15:02.23,Default,,0000,0000,0000,,ماذا عن مرتديه؟
Dialogue: 0,0:15:02.23,0:15:03.76,Default,,0000,0000,0000,,أ-أين يمكن أن يكون؟
Dialogue: 0,0:15:04.60,0:15:08.18,Default,,0000,0000,0000,,في الأعلى غالباً، رماه من تلك الشرفة
Dialogue: 0,0:15:08.76,0:15:11.63,Default,,0000,0000,0000,,لمَ ظهر القاتل أمام المصعد بذاك الزيّ؟
Dialogue: 0,0:15:12.09,0:15:16.09,Default,,0000,0000,0000,,إذا أراد الصعود للأعلى، كان يمكنه\Nاستعمال الأدراج دون أن يراه أحد
Dialogue: 0,0:15:16.09,0:15:19.37,Default,,0000,0000,0000,,ولمَ كان عليه ارتداء الزيّ؟
Dialogue: 0,0:15:19.88,0:15:22.55,Default,,0000,0000,0000,,فضلاً عن مُخاطرته بنفسه لسرقته
Dialogue: 0,0:15:23.08,0:15:24.78,Default,,0000,0000,0000,,أسلوبه طائش جدّاً
Dialogue: 0,0:15:24.78,0:15:28.08,Default,,0000,0000,0000,,أيمكن أنّ هذه الحادثة لم تكن ضمن مخططاته؟
Dialogue: 0,0:15:28.08,0:15:30.73,Default,,0000,0000,0000,,!حسناً، سنعيد الاستجواب
Dialogue: 0,0:15:30.73,0:15:32.55,Default,,0000,0000,0000,,!اجمعوا المشتبه بهم
Dialogue: 0,0:15:32.55,0:15:33.26,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:15:34.19,0:15:38.22,Default,,0000,0000,0000,,كنتم كلّكم في غرفكم، ولا أحد يشهد لكم
Dialogue: 0,0:15:38.57,0:15:40.89,Default,,0000,0000,0000,,ما يعني أنّ لا أحد منكم
Dialogue: 0,0:15:40.89,0:15:44.53,Default,,0000,0000,0000,,يملك حجّة غياب عندما تعرضت\Nساياما-سان والبقيّة للهجوم! صحيح؟
Dialogue: 0,0:15:44.53,0:15:46.55,Default,,0000,0000,0000,,تمهّل حضرة المحقق
Dialogue: 0,0:15:47.01,0:15:52.38,Default,,0000,0000,0000,,،أخبرتنا ألّا نغادر غرفنا حتّى تصلنا تعليمات\Nوذلك ما اتّبعناه
Dialogue: 0,0:15:52.38,0:15:55.42,Default,,0000,0000,0000,,أجل، أصغينا لما أُمرنا به فحسب
Dialogue: 0,0:15:55.42,0:15:58.88,Default,,0000,0000,0000,,لسنا أغبياء بحيث نتجاهل الشرطة
Dialogue: 0,0:15:58.88,0:16:00.06,Default,,0000,0000,0000,,تماماً
Dialogue: 0,0:16:00.70,0:16:03.41,Default,,0000,0000,0000,,تتشارك أكيكو-سان الغرفة مع مايدا-سان
Dialogue: 0,0:16:03.41,0:16:05.51,Default,,0000,0000,0000,,لم تتفقّدوا إن كان هناك؟
Dialogue: 0,0:16:05.51,0:16:07.41,Default,,0000,0000,0000,,!لم يكن لدينا وقت
Dialogue: 0,0:16:07.41,0:16:11.69,Default,,0000,0000,0000,,!أتينا للتبليغ عن حادثة بارون الليل فوراً
Dialogue: 0,0:16:11.69,0:16:12.01,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:16:12.83,0:16:14.22,Default,,0000,0000,0000,,بـ-بلى
Dialogue: 0,0:16:14.61,0:16:18.32,Default,,0000,0000,0000,,بأيّ حال، علينا تفقد كلّ غرفكم
Dialogue: 0,0:16:18.32,0:16:20.33,Default,,0000,0000,0000,,سنبدأ بك يا مايدا-سان، أتمانع؟
Dialogue: 0,0:16:20.33,0:16:20.96,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:16:24.88,0:16:28.35,Default,,0000,0000,0000,,!لا شيء مثير للريبة بالتحديد... ماذا؟
Dialogue: 0,0:16:28.89,0:16:30.32,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:16:30.32,0:16:31.51,Default,,0000,0000,0000,,!أقوم بتهوية الغرفة فحسب
Dialogue: 0,0:16:32.88,0:16:35.51,Default,,0000,0000,0000,,!تبّاً، ذاك الشقيّ
Dialogue: 0,0:16:35.88,0:16:38.43,Default,,0000,0000,0000,,أفرغوا ما بجيوبكم من باب الحيطة
Dialogue: 0,0:16:38.43,0:16:41.26,Default,,0000,0000,0000,,فهمتُ تصميم هذه الغرفة
Dialogue: 0,0:16:41.87,0:16:44.72,Default,,0000,0000,0000,,سقط إيبارا-سان من تلك الشرفة
Dialogue: 0,0:16:44.72,0:16:49.66,Default,,0000,0000,0000,,أجل، ألبسه القاتل رداء بارون الليل
Dialogue: 0,0:16:49.66,0:16:51.88,Default,,0000,0000,0000,,ودفعه بحيث يبدو حادثاً
Dialogue: 0,0:16:53.28,0:16:57.14,Default,,0000,0000,0000,,لكنّ قفل الأمان كان مربوطاً في غرفة إيبارا-سان
Dialogue: 0,0:16:57.69,0:17:02.09,Default,,0000,0000,0000,,ما يعني أنّ القاتل لم يغادر من الباب\Nبعد دفعه لإيبارا-سان
Dialogue: 0,0:17:02.48,0:17:05.09,Default,,0000,0000,0000,,!أي أنّ هذه كانت جريمة قتل غرفة مقفلة
Dialogue: 0,0:17:05.56,0:17:10.02,Default,,0000,0000,0000,,الشرفة كانت المخرج الوحيد للقاتل\Nإن استطاع الهرب
Dialogue: 0,0:17:10.02,0:17:13.05,Default,,0000,0000,0000,,لكن النزول من هناك والقدوم\Nلهذه الغرفة أشبه بالمستحيل
Dialogue: 0,0:17:13.05,0:17:15.48,Default,,0000,0000,0000,,ماذا؟ ما هذا الدواء؟
Dialogue: 0,0:17:15.48,0:17:17.67,Default,,0000,0000,0000,,مجرد حبوب تنويم
Dialogue: 0,0:17:17.67,0:17:21.16,Default,,0000,0000,0000,,أعاني أرقاً فأحملها معي دوماً، أهي مشكلة؟
Dialogue: 0,0:17:21.16,0:17:22.97,Default,,0000,0000,0000,,أيمكنني أن أرى؟
Dialogue: 0,0:17:22.97,0:17:25.43,Default,,0000,0000,0000,,حسناً، لنذهب للغرفة التالية
Dialogue: 0,0:17:28.00,0:17:31.36,Default,,0000,0000,0000,,لن تجد شيئاً مهما بحثتم حضرة المحقّق
Dialogue: 0,0:17:31.36,0:17:33.26,Default,,0000,0000,0000,,علينا اتّخاذ كلّ الإجراءات
Dialogue: 0,0:17:34.95,0:17:36.30,Default,,0000,0000,0000,,!ذاك الشقيّ مُجدداً
Dialogue: 0,0:17:36.99,0:17:40.52,Default,,0000,0000,0000,,الشرفة التي سقط منها إيبارا-سان\Nفوق هذه تماماً
Dialogue: 0,0:17:40.52,0:17:42.26,Default,,0000,0000,0000,,...ربما من الممكن النزول هنا
Dialogue: 0,0:17:42.26,0:17:44.89,Default,,0000,0000,0000,,!لمَ تتبعني باستمرار؟
Dialogue: 0,0:17:44.89,0:17:48.81,Default,,0000,0000,0000,,!أردتُ رؤية تحرياتك العظيمة بعينيّ
Dialogue: 0,0:17:48.81,0:17:52.76,Default,,0000,0000,0000,,!هكذا إذاً، افتح عينيك وراقب جيّداً في تلك الحالة
Dialogue: 0,0:17:53.18,0:17:55.63,Default,,0000,0000,0000,,لا علامات على تحطّم النافذة
Dialogue: 0,0:17:55.63,0:17:58.09,Default,,0000,0000,0000,,ربما به بعض الظرافة
Dialogue: 0,0:17:58.09,0:18:01.51,Default,,0000,0000,0000,,أكانت هذه النافذة مقفلة دوماً يا جدّ؟
Dialogue: 0,0:18:02.96,0:18:06.62,Default,,0000,0000,0000,,لا أستطيع الرؤية، أيمكنك الإجابة يا شيزوي-سان؟
Dialogue: 0,0:18:06.62,0:18:10.01,Default,,0000,0000,0000,,بالطبع، كنتُ أتحقق من قفلها كلّما غادرنا
Dialogue: 0,0:18:10.01,0:18:12.54,Default,,0000,0000,0000,,غرفة كونّو-سان هي التالية
Dialogue: 0,0:18:14.16,0:18:19.24,Default,,0000,0000,0000,,سمعتُ أنّه تحت شبهة استعمال\Nحواسيب مصرفه دون إذن
Dialogue: 0,0:18:19.24,0:18:21.67,Default,,0000,0000,0000,,فتمّ خفض منصبه
Dialogue: 0,0:18:22.27,0:18:26.35,Default,,0000,0000,0000,,لعلّه أكثر من أراد لقاء البارون
Dialogue: 0,0:18:26.35,0:18:27.35,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:18:27.35,0:18:29.64,Default,,0000,0000,0000,,لكنّها مجرّد شائعة
Dialogue: 0,0:18:29.64,0:18:32.09,Default,,0000,0000,0000,,أخبركم ذاك العجوز بذلك إذاً؟
Dialogue: 0,0:18:32.09,0:18:33.37,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:33.76,0:18:39.14,Default,,0000,0000,0000,,كيف له الكلام؟ فهو أكثر من يكره بارون الليل
Dialogue: 0,0:18:39.14,0:18:40.01,Default,,0000,0000,0000,,!ما قصدك؟
Dialogue: 0,0:18:40.01,0:18:46.79,Default,,0000,0000,0000,,هذه الحقيقة، فالابن الذي شاقى في تربيته قُتل بالفيروس
Dialogue: 0,0:18:48.04,0:18:50.49,Default,,0000,0000,0000,,...صحيح، قال ذاك العجوز
Dialogue: 0,0:18:50.49,0:18:54.12,Default,,0000,0000,0000,,بارون الليل، سماع ذاك الاسم يرجع لي الذكريات
Dialogue: 0,0:18:54.12,0:18:56.72,Default,,0000,0000,0000,,ذكريات ابني الذي مات قبل 4 أعوام
Dialogue: 0,0:18:57.12,0:18:59.91,Default,,0000,0000,0000,,فيروس؟ مات ابنه من مرض؟
Dialogue: 0,0:18:59.91,0:19:02.48,Default,,0000,0000,0000,,!ما علاقة ذلك ببارون الليل؟
Dialogue: 0,0:19:02.48,0:19:04.26,Default,,0000,0000,0000,,...لا أعرف تلك التفاصيل
Dialogue: 0,0:19:04.26,0:19:06.11,Default,,0000,0000,0000,,!أتتحامق معي؟
Dialogue: 0,0:19:06.11,0:19:07.13,Default,,0000,0000,0000,,...موري-سان
Dialogue: 0,0:19:07.13,0:19:10.88,Default,,0000,0000,0000,,!توقّف رجاءً! سأخبرك بمعلومة خاصّة
Dialogue: 0,0:19:10.88,0:19:15.84,Default,,0000,0000,0000,,هذه أقرب نافذة للشرفة، لكن القفز لها مستحيل
Dialogue: 0,0:19:15.84,0:19:17.64,Default,,0000,0000,0000,,!كاميجو-سان؟
Dialogue: 0,0:19:17.64,0:19:20.10,Default,,0000,0000,0000,,كانا متزوّجين
Dialogue: 0,0:19:20.50,0:19:23.51,Default,,0000,0000,0000,,رغم أنّي سمعت أنّهما تطلّقا\Nقبل ثلاثة أعوام
Dialogue: 0,0:19:24.75,0:19:28.96,Default,,0000,0000,0000,,صحيح، إيبارا توكيو الراحل كان زوجي
Dialogue: 0,0:19:28.96,0:19:33.78,Default,,0000,0000,0000,,،لكن كان ذلك قبل ثلاثة أعوام\Nعندما عرفت أنّه كان مخترقاً
Dialogue: 0,0:19:33.78,0:19:34.38,Default,,0000,0000,0000,,مخترق؟
Dialogue: 0,0:19:35.12,0:19:38.35,Default,,0000,0000,0000,,!مجرم يسرق بيانات الحاسوب
Dialogue: 0,0:19:38.78,0:19:42.86,Default,,0000,0000,0000,,!كلّ من يستعملون الحواسيب يكرهون المخترقين
Dialogue: 0,0:19:44.73,0:19:46.64,Default,,0000,0000,0000,,أشعر بالارتياح لموته
Dialogue: 0,0:19:47.15,0:19:48.48,Default,,0000,0000,0000,,بالمناسبة
Dialogue: 0,0:19:48.48,0:19:53.97,Default,,0000,0000,0000,,أظنّ أخا ساياما أكيكو-سان كان يدير\Nشركة برمجيات حاسوب صغيرة
Dialogue: 0,0:19:53.97,0:19:57.39,Default,,0000,0000,0000,,ما يعني أنّها ليست خارج الشبهة
Dialogue: 0,0:19:57.76,0:20:02.09,Default,,0000,0000,0000,,أي أنّ جميع المشاركين في الجولة\Nكانوا يملكون دافعاً لقتله
Dialogue: 0,0:20:03.00,0:20:04.05,Default,,0000,0000,0000,,حضرة المحقق
Dialogue: 0,0:20:05.88,0:20:09.96,Default,,0000,0000,0000,,...ماذا؟ هذه نفس الحبوب التي كانت مع أكيكو-سان
Dialogue: 0,0:20:09.96,0:20:11.92,Default,,0000,0000,0000,,...أهذه أيضاً
Dialogue: 0,0:20:12.29,0:20:14.33,Default,,0000,0000,0000,,أخبريني، ما هذه الحبوب؟
Dialogue: 0,0:20:14.33,0:20:17.70,Default,,0000,0000,0000,,!لـ-لحظة! لا تلمس أغراضي
Dialogue: 0,0:20:17.70,0:20:19.08,Default,,0000,0000,0000,,أهو دواء زكام؟
Dialogue: 0,0:20:19.08,0:20:20.13,Default,,0000,0000,0000,,...أجل، صحيح
Dialogue: 0,0:20:20.13,0:20:23.09,Default,,0000,0000,0000,,ظننتُها حبوب منوّمة، ربما اشتبهت عليّ
Dialogue: 0,0:20:24.80,0:20:25.76,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:20:26.03,0:20:30.67,Default,,0000,0000,0000,,!ما الذي تثرثر به؟! ارجع لغرفتك يا طفل ونم
Dialogue: 0,0:20:32.27,0:20:34.34,Default,,0000,0000,0000,,!لم أتفقد تصميم الغرفة بعد
Dialogue: 0,0:20:37.68,0:20:41.14,Default,,0000,0000,0000,,حسناً، لا يهم. فهي غالباً بنفس\Nتخطيط غرفة كونّو-سان بالأسفل
Dialogue: 0,0:20:41.89,0:20:45.09,Default,,0000,0000,0000,,...بالنظر لغرف الجميع
Dialogue: 0,0:20:45.98,0:20:46.73,On Top,,0000,0000,0000,,إيبارا- غرفة 2101
Dialogue: 0,0:20:46.73,0:20:47.73,On Top,,0000,0000,0000,,إيبارا - غرفة 2101\Nكاميجو - غرفة 2102
Dialogue: 0,0:20:47.73,0:20:48.73,On Top,,0000,0000,0000,,كانيشيرو وهاياشي - غرفة 2001
Dialogue: 0,0:20:48.73,0:20:49.73,On Top,,0000,0000,0000,,كانيشيرو وهاياشي - غرفة 2001\Nكونّو - غرفة 2002
Dialogue: 0,0:20:49.73,0:20:50.72,On Top,,0000,0000,0000,,مايدا وساياما - غرفة 1901
Dialogue: 0,0:20:50.58,0:20:52.05,Default,,0000,0000,0000,,هذا ما نجده
Dialogue: 0,0:20:50.72,0:20:52.52,On Top,,0000,0000,0000,,مايدا وساياما - غرفة 1901\Nالجثّة
Dialogue: 0,0:20:52.05,0:20:55.75,Default,,0000,0000,0000,,أي أنّ المخرج الوحيد من شرفة إيبارا-سان
Dialogue: 0,0:20:55.75,0:20:58.20,Default,,0000,0000,0000,,كان عبر غرفة كانيشيرو-سان وهاياشي-سان
Dialogue: 0,0:20:58.20,0:20:59.89,Default,,0000,0000,0000,,ما نفعل بهذه؟
Dialogue: 0,0:20:59.89,0:21:03.34,Default,,0000,0000,0000,,لا أدري، إنّها قطعة من قفل الأمان
Dialogue: 0,0:21:03.34,0:21:06.09,Default,,0000,0000,0000,,صحيح، غرفة إيبارا-سان بهذا الطابق أيضاً
Dialogue: 0,0:21:06.09,0:21:08.55,Default,,0000,0000,0000,,هناك شيء على الطرف
Dialogue: 0,0:21:09.19,0:21:10.25,Default,,0000,0000,0000,,!شريط لاصق شفّاف
Dialogue: 0,0:21:11.55,0:21:14.52,Default,,0000,0000,0000,,...لحظة! أيمكن أن
Dialogue: 0,0:22:41.48,0:22:45.93,Default,,0000,0000,0000,,تفادى كلّ ركلاتي بمرونة\Nودون أيّ جهد إضافي
Dialogue: 0,0:22:46.93,0:22:52.91,Default,,0000,0000,0000,,الوحيد بين المُشتبه بهم القادر\Nعلى ذلك... هو دون سواه
Dialogue: 0,0:22:54.22,0:22:55.60,Default,,0000,0000,0000,,ماذا عليّ أن أفعل؟
Dialogue: 0,0:22:56.51,0:22:58.43,Default,,0000,0000,0000,,!أخبرني يا شينتشي
Dialogue: 0,0:22:59.09,0:23:00.55,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:23:02.83,0:23:05.08,Default,,0000,0000,0000,,!افتحي يا ران-نيتشان
Dialogue: 0,0:23:05.52,0:23:06.43,Default,,0000,0000,0000,,كونان-كن، ما الخطب؟
Dialogue: 0,0:23:07.71,0:23:09.75,Default,,0000,0000,0000,,كان قفل الأمان مربوطاً
Dialogue: 0,0:23:09.75,0:23:12.17,Default,,0000,0000,0000,,غريب، لا أتذكر ربطه
Dialogue: 0,0:23:13.38,0:23:14.49,Default,,0000,0000,0000,,!نجحت التجربة
Dialogue: 0,0:23:14.49,0:23:15.85,Default,,0000,0000,0000,,ماذا؟ أتبكين؟
Dialogue: 0,0:23:16.36,0:23:18.81,Default,,0000,0000,0000,,كلا! دموع من التثاؤب فقط
Dialogue: 0,0:23:20.56,0:23:22.18,Default,,0000,0000,0000,,!سأغادر قليلاً
Dialogue: 0,0:23:22.29,0:23:23.22,Default,,0000,0000,0000,,في هذا الوقت المتأخّر؟
Dialogue: 0,0:23:23.64,0:23:24.60,Default,,0000,0000,0000,,!سأرجع سريعاً
Dialogue: 0,0:23:26.27,0:23:27.35,Default,,0000,0000,0000,,إنّه ذاك الصبيّ
Dialogue: 0,0:23:27.89,0:23:29.81,Default,,0000,0000,0000,,عليك النوم الآن يا فتى
Dialogue: 0,0:23:30.63,0:23:31.64,Default,,0000,0000,0000,,لا تهتمّ
Dialogue: 0,0:23:32.63,0:23:35.59,Default,,0000,0000,0000,,كان بمقدور أيّ أحد ارتكاب الجريمة\Nباستعمال تلك الحيلة
Dialogue: 0,0:23:35.59,0:23:38.05,Default,,0000,0000,0000,,عليّ مراجعة كلّ حجج غيابهم
Dialogue: 0,0:23:38.76,0:23:40.67,Default,,0000,0000,0000,,بالمناسبة، أسمعت ما حصل مع ميساوا-سان؟
Dialogue: 0,0:23:41.05,0:23:43.43,Default,,0000,0000,0000,,ضربه القاتل في غرفة حراسة الجثّة، صحيح؟
Dialogue: 0,0:23:43.71,0:23:46.86,Default,,0000,0000,0000,,لكن أليس ميساوا-سان خبيراً في الكاراتيه؟
Dialogue: 0,0:23:47.08,0:23:48.90,Default,,0000,0000,0000,,بلى، الأقوى في قسمنا
Dialogue: 0,0:23:49.71,0:23:52.99,Default,,0000,0000,0000,,...مهما باغته الفاعل
Dialogue: 0,0:23:52.99,0:23:54.31,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:23:54.91,0:23:56.94,Default,,0000,0000,0000,,...أيمكن أنّ القاتل
Dialogue: 0,0:24:02.26,0:24:04.13,Default,,0000,0000,0000,,ماذا؟ كونان-كن؟
Dialogue: 0,0:24:04.93,0:24:07.01,Default,,0000,0000,0000,,من ربط قفل الأمان؟
Dialogue: 0,0:24:07.01,0:24:09.05,Default,,0000,0000,0000,,ربطتُه من الخارج
Dialogue: 0,0:24:11.30,0:24:12.30,Default,,0000,0000,0000,,!رُبط
Dialogue: 0,0:24:12.96,0:24:16.76,Default,,0000,0000,0000,,!هكذا تكون الغرفة مقفلة، ويمكن جعله يبدو حادثاً
Dialogue: 0,0:24:16.76,0:24:19.96,Default,,0000,0000,0000,,!وجدتُ حجّة غياب له
Dialogue: 0,0:24:20.54,0:24:21.38,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:24:22.12,0:24:24.34,Default,,0000,0000,0000,,...كان هناك مكان واحد حيث الريح
Dialogue: 0,0:24:24.34,0:24:30.21,On Top,,0000,0000,0000,,(جريمة قتل بارون الليل (جزء الحلّ
Dialogue: 0,0:24:24.79,0:24:26.23,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.23,0:24:29.79,Default,,0000,0000,0000,,(جريمة قتل بارون الليل (جزء الحلّ
Dialogue: 0,0:24:46.18,0:24:48.56,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.56,0:24:49.75,Default,,0000,0000,0000,,رياح عبر المباني
Dialogue: 0,0:24:50.77,0:24:52.46,Default,,0000,0000,0000,,!الحلقة القادمة جزء الحلّ أخيراً
Dialogue: 0,0:24:52.46,0:24:53.72,Default,,0000,0000,0000,,!أنت هو القاتل
Dialogue: 0,0:24:53.72,0:24:55.72,Default,,0000,0000,0000,,أنا مُجدّداً؟

