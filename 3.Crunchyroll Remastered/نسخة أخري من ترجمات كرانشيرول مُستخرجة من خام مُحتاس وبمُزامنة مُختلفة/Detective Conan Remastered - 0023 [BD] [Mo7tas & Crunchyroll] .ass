Dialogue: 0,0:00:01.21,0:00:02.71,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.71,0:00:05.70,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.70,0:00:08.70,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.70,0:00:11.86,Default,,0000,0000,0000,,ستتبع الشارة الغنائية مراجعة للحلقة السابقة
Dialogue: 0,0:00:12.24,0:00:15.61,Default,,0000,0000,0000,,!إنّها سفينة كبيرة، لكن الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.43,0:01:48.23,Default,,0000,0000,0000,,كدنا نعلق في جزيرة
Dialogue: 0,0:01:48.23,0:01:51.52,Default,,0000,0000,0000,,قبل أن تقلّنا سفينة حجزتها عائلة هاتاموتو
Dialogue: 0,0:01:52.02,0:01:55.93,Default,,0000,0000,0000,,،بمن فيهم نحن الثلاثة وخادم العائلة\Nكان هناك عشرة أشخاص فقط
Dialogue: 0,0:01:56.42,0:01:58.14,Default,,0000,0000,0000,,في طريق عودتنا للبرّ، قُتل كبير عائلة هاتاموتو
Dialogue: 0,0:01:58.51,0:02:01.10,Default,,0000,0000,0000,,هاتاموتو غوزو في غرفته
Dialogue: 0,0:02:01.67,0:02:03.51,Default,,0000,0000,0000,,المشتبه الرئيسي كان هاتاموتو تاكيشي
Dialogue: 0,0:02:03.51,0:02:05.34,Default,,0000,0000,0000,,الذي دخل العائلة بزواجه من هاتاموتو ناتسوي
Dialogue: 0,0:02:06.00,0:02:08.54,Default,,0000,0000,0000,,اتّضح أنّه ابن زايكي إيساو
Dialogue: 0,0:02:08.54,0:02:13.16,Default,,0000,0000,0000,,الذي انتحر بعدما استولى غوزو\Nعلى شركته قبل 10 أعوام
Dialogue: 0,0:02:13.16,0:02:17.32,Default,,0000,0000,0000,,كان لديه دافعٌ كبير، فقرر الجميع احتجاز\Nتاكيشي في مخزن
Dialogue: 0,0:02:17.32,0:02:21.31,Default,,0000,0000,0000,,وبدا أنّ القضيّة حُلت، لكن كان هناك المزيد
Dialogue: 0,0:02:21.65,0:02:25.14,Default,,0000,0000,0000,,وُجد زوج أكي، هاتاموتو تاتسو، مقتولاً
Dialogue: 0,0:02:25.14,0:02:27.74,Default,,0000,0000,0000,,وهرب تاكيشي من المخزن
Dialogue: 0,0:02:32.27,0:02:35.70,Default,,0000,0000,0000,,سلسلة جرائم قتل السفينة السياحية الفاخرة\N(الجزء الثاني)
Dialogue: 0,0:02:43.72,0:02:45.42,Default,,0000,0000,0000,,...تاتسو
Dialogue: 0,0:02:45.42,0:02:46.18,Default,,0000,0000,0000,,...أختي
Dialogue: 0,0:02:46.80,0:02:48.08,Default,,0000,0000,0000,,!إنّها غلطتك
Dialogue: 0,0:02:49.37,0:02:50.42,Default,,0000,0000,0000,,لم يكن هذا ليحصل
Dialogue: 0,0:02:50.42,0:02:53.12,Default,,0000,0000,0000,,!لو لم تُدخلي تاكيشي في العائلة
Dialogue: 0,0:02:54.14,0:02:55.38,Default,,0000,0000,0000,,!كيف ستبررين موقفك؟
Dialogue: 0,0:02:55.38,0:02:57.74,Default,,0000,0000,0000,,يا لحظّك
Dialogue: 0,0:02:57.74,0:03:00.32,Default,,0000,0000,0000,,بعدما قتل زوجك تاكيشي أبي
Dialogue: 0,0:03:00.32,0:03:04.05,Default,,0000,0000,0000,,!أصبحت كلّ ثروته لك
Dialogue: 0,0:03:04.48,0:03:07.89,Default,,0000,0000,0000,,!لا-لا يُعقل! لا أهتم للثروة
Dialogue: 0,0:03:09.38,0:03:12.14,Default,,0000,0000,0000,,لم نتأكد بعد أنّ تاكيشي-سان هو القاتل
Dialogue: 0,0:03:14.06,0:03:15.97,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:03:15.97,0:03:19.84,Default,,0000,0000,0000,,كان قفل المخزن مفتوحاً عندما تفقدناه، صحيح؟
Dialogue: 0,0:03:19.84,0:03:22.18,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:03:22.51,0:03:24.88,Default,,0000,0000,0000,,لم يكن بإمكانه الخروج
Dialogue: 0,0:03:24.88,0:03:26.01,Default,,0000,0000,0000,,دون أن يفتحه أحد من الخارج
Dialogue: 0,0:03:26.46,0:03:28.42,Default,,0000,0000,0000,,...معك حق
Dialogue: 0,0:03:28.42,0:03:30.54,Default,,0000,0000,0000,,لم تكن هناك آثار تخريب للقفل أيضاً
Dialogue: 0,0:03:30.54,0:03:33.00,Default,,0000,0000,0000,,...إن فتحه أحدهم له
Dialogue: 0,0:03:33.00,0:03:35.13,Default,,0000,0000,0000,,!فيعني أنّ بينكم متواطئ
Dialogue: 0,0:03:50.65,0:03:52.94,Default,,0000,0000,0000,,دعوني أستوضح
Dialogue: 0,0:03:52.94,0:03:55.80,Default,,0000,0000,0000,,،أثناء مقتل تاتسو-سان
Dialogue: 0,0:03:56.26,0:03:59.26,Default,,0000,0000,0000,,كنتم الثلاثة بمفردكم تستريحون في غرفكم
Dialogue: 0,0:03:59.93,0:04:03.27,Default,,0000,0000,0000,,بينما كنتما الزوجين في غرفتكما المشتركة
Dialogue: 0,0:04:03.27,0:04:07.34,Default,,0000,0000,0000,,أ-أجل، لم أستطع النوم فذهبت للتمشّي
Dialogue: 0,0:04:07.34,0:04:10.29,Default,,0000,0000,0000,,،ما يعني أنّ مثل ظروف الجريمة الأولى
Dialogue: 0,0:04:10.29,0:04:13.29,Default,,0000,0000,0000,,،باستثناء من كان مع كونان وناتسوي-سان
Dialogue: 0,0:04:13.29,0:04:15.28,Default,,0000,0000,0000,,!لا يملك أحد حجّة غياب
Dialogue: 0,0:04:15.28,0:04:19.24,Default,,0000,0000,0000,,!لا تمازحني! مات زوجي
Dialogue: 0,0:04:19.24,0:04:21.26,Default,,0000,0000,0000,,!لمَ قد يُشتبه بي؟
Dialogue: 0,0:04:22.49,0:04:26.72,Default,,0000,0000,0000,,أنت الأكثر سروراً برؤيته ميتاً
Dialogue: 0,0:04:27.02,0:04:32.31,Default,,0000,0000,0000,,!أعرف أنّ هناك رجالاً آخرين في حياتك
Dialogue: 0,0:04:32.77,0:04:36.51,Default,,0000,0000,0000,,!كان لديكِ دافع كبير لقتل جدّي أيضاً
Dialogue: 0,0:04:36.51,0:04:39.81,Default,,0000,0000,0000,,!فأنتِ أكثر من أراد إرثه
Dialogue: 0,0:04:40.22,0:04:43.27,Default,,0000,0000,0000,,!توقفا! رجاءً
Dialogue: 0,0:04:47.59,0:04:50.25,Default,,0000,0000,0000,,أرسمتِ هذه يا إيتشيرو-سان؟
Dialogue: 0,0:04:50.25,0:04:52.06,Default,,0000,0000,0000,,إنّها ناتسوي-سان، صحيح؟
Dialogue: 0,0:04:52.92,0:04:55.91,Default,,0000,0000,0000,,وابنك إيتشيرو ليس مستثنى أيضاً
Dialogue: 0,0:04:55.91,0:04:56.89,Default,,0000,0000,0000,,ألستُ محقة؟
Dialogue: 0,0:04:57.79,0:04:59.54,Default,,0000,0000,0000,,فأنا واثقة أنّ الغضب اعتراك
Dialogue: 0,0:04:59.54,0:05:02.35,Default,,0000,0000,0000,,!بعدما مزّق جدّي رسمتك المتوّجة بجائزة
Dialogue: 0,0:05:02.99,0:05:06.76,Default,,0000,0000,0000,,تلك كانت غلطة أبي! لم يعترف\N!بموهبة ابني أبداً
Dialogue: 0,0:05:07.40,0:05:10.32,Default,,0000,0000,0000,,كان تاتسو يسخر منك دوماً، صحيح؟
Dialogue: 0,0:05:10.32,0:05:12.10,Default,,0000,0000,0000,,يقول أنّك مُنغلق بائس وما شابه
Dialogue: 0,0:05:12.65,0:05:15.93,Default,,0000,0000,0000,,!كلا! لم أقتله
Dialogue: 0,0:05:15.93,0:05:19.47,Default,,0000,0000,0000,,...وأكثر من أراد التحرّر من جدّي
Dialogue: 0,0:05:20.02,0:05:22.72,Default,,0000,0000,0000,,كان أنت يا عمّ كيتارو، أليس كذلك؟
Dialogue: 0,0:05:22.72,0:05:24.46,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:24.46,0:05:25.88,Default,,0000,0000,0000,,إيتشيرو، أين تذهب؟
Dialogue: 0,0:05:26.38,0:05:27.46,Default,,0000,0000,0000,,دورة المياه
Dialogue: 0,0:05:27.46,0:05:29.26,Default,,0000,0000,0000,,أستكون بخيرٍ بمفردك؟
Dialogue: 0,0:05:29.26,0:05:34.08,Default,,0000,0000,0000,,سأكون بخير، فلستُ ضعيفاً مثلك يا أبي
Dialogue: 0,0:05:34.08,0:05:35.01,Default,,0000,0000,0000,,...إيتشيرو
Dialogue: 0,0:05:35.45,0:05:37.87,Default,,0000,0000,0000,,...سيّدي الخادم
Dialogue: 0,0:05:37.87,0:05:41.12,Default,,0000,0000,0000,,أجرى أمرٌ ما بين كيتارو-سان والجدّ؟
Dialogue: 0,0:05:41.12,0:05:45.34,Default,,0000,0000,0000,,لطالما أراد كيتارو-ساما مغادرة عائلة هاتاموتو
Dialogue: 0,0:05:45.86,0:05:49.65,Default,,0000,0000,0000,,قال أنّه لا يملك طموح إدارة شركة العائلة
Dialogue: 0,0:05:49.65,0:05:52.77,Default,,0000,0000,0000,,كان الجدّ يعارض ذلك بشدّة
Dialogue: 0,0:05:53.28,0:05:55.52,Default,,0000,0000,0000,,،لكن حتّى لو لم يعارض
Dialogue: 0,0:05:55.52,0:05:58.88,Default,,0000,0000,0000,,لا أظنّ أن زوجته ماريكو-ساما كانت ستسمح له
Dialogue: 0,0:06:02.60,0:06:04.38,Default,,0000,0000,0000,,المعذرة حضرة المتحري
Dialogue: 0,0:06:04.38,0:06:07.72,Default,,0000,0000,0000,,مضت 20 دقيقة ولم يعد إيتشيرو\Nمن دورة المياه بعد
Dialogue: 0,0:06:08.38,0:06:09.68,Default,,0000,0000,0000,,...أيمكن أنّ تاكيشي قد
Dialogue: 0,0:06:15.08,0:06:17.25,Default,,0000,0000,0000,,!اهدؤوا! ابقوا حيث أنتم
Dialogue: 0,0:06:17.25,0:06:20.66,Default,,0000,0000,0000,,!ماذا؟! لكن لم يعد إيتشيرو بعد
Dialogue: 0,0:06:20.66,0:06:21.66,Default,,0000,0000,0000,,!إيتشيرو
Dialogue: 0,0:06:21.66,0:06:23.60,Default,,0000,0000,0000,,!لا يمكنك مغادرة الغرفة يا عمّة
Dialogue: 0,0:06:24.23,0:06:25.97,Default,,0000,0000,0000,,!ران وكونان! أأنتما هنا؟
Dialogue: 0,0:06:26.29,0:06:27.54,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:06:27.54,0:06:28.64,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:06:28.95,0:06:30.79,Default,,0000,0000,0000,,سأذهب لغرفة المفاتيح
Dialogue: 0,0:06:30.79,0:06:33.06,Default,,0000,0000,0000,,توجّها لدورة المياه
Dialogue: 0,0:06:33.37,0:06:35.95,Default,,0000,0000,0000,,كانت دورة المياه من هذا الاتجاه، صحيح؟
Dialogue: 0,0:06:35.95,0:06:37.07,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:38.53,0:06:40.51,Default,,0000,0000,0000,,كان ذلك صوت إيتشيرو-سان، صحيح؟
Dialogue: 0,0:06:40.51,0:06:42.03,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:06:48.10,0:06:49.18,Default,,0000,0000,0000,,!إيتشيرو
Dialogue: 0,0:06:49.73,0:06:50.93,Default,,0000,0000,0000,,!ساقي
Dialogue: 0,0:06:51.52,0:06:53.52,Default,,0000,0000,0000,,!تماسك يا إيتشيرو
Dialogue: 0,0:06:53.52,0:06:55.17,Default,,0000,0000,0000,,إنّه بخير، الجرح سطحيّ
Dialogue: 0,0:06:55.17,0:06:56.80,Default,,0000,0000,0000,,علينا تضميده فوراً
Dialogue: 0,0:06:56.80,0:06:58.64,Default,,0000,0000,0000,,سأجلب عدّة الإسعافات الأولية
Dialogue: 0,0:06:59.63,0:07:01.67,Default,,0000,0000,0000,,من هاجمك؟
Dialogue: 0,0:07:01.67,0:07:02.88,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:07:02.88,0:07:07.46,Default,,0000,0000,0000,,...انطفأت الأضواء فجأةً وشعرت بدخول أحدهم
Dialogue: 0,0:07:07.46,0:07:09.41,Default,,0000,0000,0000,,!ثم طعنني
Dialogue: 0,0:07:12.41,0:07:13.10,Default,,0000,0000,0000,,...تلك
Dialogue: 0,0:07:15.61,0:07:17.01,Default,,0000,0000,0000,,سكّيني
Dialogue: 0,0:07:17.53,0:07:19.53,Default,,0000,0000,0000,,...أيمكن أنّك يا جوجي
Dialogue: 0,0:07:19.53,0:07:21.65,Default,,0000,0000,0000,,!تمهلي
Dialogue: 0,0:07:21.65,0:07:24.44,Default,,0000,0000,0000,,كنت معكم في غرفة الطعام\Nعندما انقطعت الكهرباء
Dialogue: 0,0:07:24.44,0:07:25.72,Default,,0000,0000,0000,,!يستحيل أن فعلتُ هذا
Dialogue: 0,0:07:26.06,0:07:27.64,Default,,0000,0000,0000,,صـ-صحيح
Dialogue: 0,0:07:27.64,0:07:29.93,Default,,0000,0000,0000,,شخصٌ واحد كان بإمكانه فعل هذا
Dialogue: 0,0:07:31.23,0:07:32.89,Default,,0000,0000,0000,,تاكيشي-كن فقط
Dialogue: 0,0:07:32.89,0:07:36.13,Default,,0000,0000,0000,,كلا، ليس بالضرورة
Dialogue: 0,0:07:36.13,0:07:39.47,Default,,0000,0000,0000,,لنترك تضميد إيتشيرو-كن لران وناتسوي-سان
Dialogue: 0,0:07:39.47,0:07:42.81,Default,,0000,0000,0000,,أريدكم أن ترافقوني جميعاً لغرفة المفاتيح
Dialogue: 0,0:07:45.25,0:07:47.46,Default,,0000,0000,0000,,أيوجد شيءٌ هنا؟
Dialogue: 0,0:07:47.46,0:07:49.72,Default,,0000,0000,0000,,حسنٌ، انظروا
Dialogue: 0,0:07:50.71,0:07:52.68,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:07:53.25,0:07:55.28,Default,,0000,0000,0000,,عدّة مؤقته
Dialogue: 0,0:07:55.28,0:07:57.64,Default,,0000,0000,0000,,بسيطة بما يكفي ليصنعها أيّ أحد
Dialogue: 0,0:07:58.20,0:08:01.70,Default,,0000,0000,0000,,،تربط وزناً ثقيلاً بالقاطع ولوحة ارتكاز
Dialogue: 0,0:08:01.70,0:08:04.63,Default,,0000,0000,0000,,ثمّ تضع شمعةً بينهما
Dialogue: 0,0:08:04.63,0:08:08.43,Default,,0000,0000,0000,,بعد مضيّ وقتٍ كافٍ سيحترق الحبل
Dialogue: 0,0:08:08.76,0:08:10.97,Default,,0000,0000,0000,,فيسقط الوزن ويسحب القاطع
Dialogue: 0,0:08:11.44,0:08:13.72,Default,,0000,0000,0000,,،بالنظر إلى الكمية الذائبة من الشمعة
Dialogue: 0,0:08:13.72,0:08:16.05,Default,,0000,0000,0000,,يمكن القول أنها وُضعت قبل فترة
Dialogue: 0,0:08:16.05,0:08:20.76,Default,,0000,0000,0000,,مما يعني يمكن أن أيّ منكم\Nقد يكون مسؤولاً عن قطع الكهرباء
Dialogue: 0,0:08:21.51,0:08:25.50,Default,,0000,0000,0000,,بأيّ حال، سأتحمل مسؤولية إيجاد تاكيشي-سان
Dialogue: 0,0:08:25.50,0:08:29.85,Default,,0000,0000,0000,,لا أريدكم أن تخرجوا من غرفة الطعام أبداً حتى أفعل
Dialogue: 0,0:08:43.98,0:08:45.59,Default,,0000,0000,0000,,أتشعر بألم يا إيتشيرو؟
Dialogue: 0,0:08:47.19,0:08:48.19,Default,,0000,0000,0000,,تباً
Dialogue: 0,0:08:48.19,0:08:50.77,Default,,0000,0000,0000,,بحثنا في كلّ مكان ولم نجده
Dialogue: 0,0:08:50.77,0:08:53.19,Default,,0000,0000,0000,,لعلّه ليس على متن السفينة
Dialogue: 0,0:08:53.19,0:08:56.18,Default,,0000,0000,0000,,لا أظننا بحثنا في كلّ مكان
Dialogue: 0,0:08:56.75,0:08:59.39,Default,,0000,0000,0000,,كغرف أفراد العائلة
Dialogue: 0,0:09:06.36,0:09:08.64,Default,,0000,0000,0000,,ليس في غرفة الزوجين كيتارو
Dialogue: 0,0:09:10.90,0:09:14.56,Default,,0000,0000,0000,,يبدو أنّ شخصية هذين الاثنين متناقضة
Dialogue: 0,0:09:14.56,0:09:15.93,Default,,0000,0000,0000,,هل زواجهما على ما يرام؟
Dialogue: 0,0:09:16.52,0:09:20.39,Default,,0000,0000,0000,,،أجل، إنّهما قريبان. وبخلاف ما يبدو عليهما
Dialogue: 0,0:09:20.39,0:09:23.27,Default,,0000,0000,0000,,فهما صديقان مقرّبان مذ صغرهما
Dialogue: 0,0:09:23.53,0:09:25.97,Default,,0000,0000,0000,,!قريبان ومتزوّجان؟
Dialogue: 0,0:09:25.97,0:09:28.74,Default,,0000,0000,0000,,صحيح، وفقما أذكر
Dialogue: 0,0:09:28.74,0:09:31.43,Default,,0000,0000,0000,,كان السيّد غوزو معارضاً بشدة أيضاً
Dialogue: 0,0:09:31.91,0:09:33.88,Default,,0000,0000,0000,,أيضاً"؟"
Dialogue: 0,0:09:39.06,0:09:42.52,Default,,0000,0000,0000,,يبدو أنّه ليس في غرفة جوجي-سان أيضاً
Dialogue: 0,0:09:43.31,0:09:46.51,Default,,0000,0000,0000,,أهذه حقيبة السكاكين خاصته؟
Dialogue: 0,0:09:46.51,0:09:47.47,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:09:50.76,0:09:53.02,Default,,0000,0000,0000,,!سـ-سكّينتان مفقودتان
Dialogue: 0,0:09:53.63,0:09:54.75,Default,,0000,0000,0000,,ما معنى هذا؟
Dialogue: 0,0:09:54.75,0:09:58.75,Default,,0000,0000,0000,,وجدنا واحدة بعدما طُعن إيتشيرو-كن
Dialogue: 0,0:09:58.75,0:09:59.97,Default,,0000,0000,0000,,لكن أين الأخرى؟
Dialogue: 0,0:10:03.21,0:10:05.20,Default,,0000,0000,0000,,لا بدّ أنّها غرفة إيتشيرو-سان
Dialogue: 0,0:10:05.20,0:10:07.45,Default,,0000,0000,0000,,!فهذه رسماته
Dialogue: 0,0:10:07.45,0:10:09.99,Default,,0000,0000,0000,,لا يعني هذا أن تدخلي غرفته بلا حذر
Dialogue: 0,0:10:09.99,0:10:13.14,Default,,0000,0000,0000,,قد يكون تاكيشي-كن مختبئاً هنا بسلاح
Dialogue: 0,0:10:13.52,0:10:15.98,Default,,0000,0000,0000,,رسمه متقنٌ حقاً
Dialogue: 0,0:10:15.98,0:10:19.44,Default,,0000,0000,0000,,قد نجد رسمةً لمسرح الجريمة
Dialogue: 0,0:10:20.98,0:10:22.27,Default,,0000,0000,0000,,كأنّ ذلك سيحصل
Dialogue: 0,0:10:26.26,0:10:29.23,Default,,0000,0000,0000,,لا تعبثي بها
Dialogue: 0,0:10:29.23,0:10:30.14,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:33.75,0:10:35.71,Default,,0000,0000,0000,,ليس هنا إذاً
Dialogue: 0,0:10:35.71,0:10:37.22,Default,,0000,0000,0000,,يبدو ذلك
Dialogue: 0,0:10:37.75,0:10:39.59,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:10:39.59,0:10:41.93,Default,,0000,0000,0000,,فحم، تستعمله للرسم المبدئي
Dialogue: 0,0:10:42.42,0:10:43.39,Default,,0000,0000,0000,,ما هذا إذاً؟
Dialogue: 0,0:10:44.24,0:10:46.72,Default,,0000,0000,0000,,يكفي مماطلة، سنغادر
Dialogue: 0,0:10:47.45,0:10:48.99,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:48.99,0:10:51.06,Default,,0000,0000,0000,,إنّها مسّاحة عادية
Dialogue: 0,0:10:51.79,0:10:54.01,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:10:55.40,0:10:59.73,Default,,0000,0000,0000,,لم يكن في غرفتنا أو غرفة ناتسوي-سان
Dialogue: 0,0:10:59.73,0:11:02.68,Default,,0000,0000,0000,,تبقّت غرفة أكي-سان هنا فقط
Dialogue: 0,0:11:05.14,0:11:07.39,Default,,0000,0000,0000,,لعلّه لم يعد على متن السفينة بعد
Dialogue: 0,0:11:10.17,0:11:11.99,Default,,0000,0000,0000,,أوجدت شيئاً؟
Dialogue: 0,0:11:11.99,0:11:14.05,Default,,0000,0000,0000,,!كلا! لا شيء
Dialogue: 0,0:11:14.05,0:11:15.61,Default,,0000,0000,0000,,حسنٌ، فعلنا ما باستطاعتنا
Dialogue: 0,0:11:15.61,0:11:18.01,Default,,0000,0000,0000,,لنرجع لغرفة الطعام
Dialogue: 0,0:11:21.70,0:11:24.72,Default,,0000,0000,0000,,أخبرني، سيّدي الخادم
Dialogue: 0,0:11:24.72,0:11:26.11,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:11:29.35,0:11:30.64,Default,,0000,0000,0000,,أحصل ذلك قبلاً؟
Dialogue: 0,0:11:30.98,0:11:35.88,Default,,0000,0000,0000,,!كيف عرفت؟! فقط غوزو-ساما وأنا نعرف
Dialogue: 0,0:11:35.88,0:11:38.55,Default,,0000,0000,0000,,أنا محقٌ إذاً
Dialogue: 0,0:11:38.55,0:11:41.30,Default,,0000,0000,0000,,الحادثة الأولى التي قُتل فيها السيّد غوزو
Dialogue: 0,0:11:41.30,0:11:45.63,Default,,0000,0000,0000,,،كانت هناك كسرة الخبز قرب الجثّة\Nكما موقع سلاح الجريمة
Dialogue: 0,0:11:46.08,0:11:48.63,Default,,0000,0000,0000,,...والحادثة الثانية التي قُتل فيها تاتسو-سان
Dialogue: 0,0:11:48.63,0:11:52.42,Default,,0000,0000,0000,,كان هناك صوت السقوط في الماء والارتطام\Nالذي سمعته وقت الجريمة
Dialogue: 0,0:11:52.42,0:11:55.34,Default,,0000,0000,0000,,...والشخص الذي فتح قفل المخزن
Dialogue: 0,0:11:55.34,0:11:59.47,Default,,0000,0000,0000,,ثمّ الحادثة الثالثة حيث طُعن\Nإيتشيرو-سان في الظلام
Dialogue: 0,0:12:00.57,0:12:03.52,Default,,0000,0000,0000,,!كلّ هذه الألغاز مربوطة بخيط
Dialogue: 0,0:12:12.06,0:12:13.97,Default,,0000,0000,0000,,!عمّي! تعال قليلاً
Dialogue: 0,0:12:15.64,0:12:17.43,Default,,0000,0000,0000,,ماذا هناك؟
Dialogue: 0,0:12:18.05,0:12:19.72,Default,,0000,0000,0000,,أوجدت شيئاً؟
Dialogue: 0,0:12:26.13,0:12:27.80,Default,,0000,0000,0000,,آسف يا عمّ
Dialogue: 0,0:12:30.92,0:12:32.71,Default,,0000,0000,0000,,ماذا؟ وأبي؟
Dialogue: 0,0:12:32.71,0:12:34.41,Default,,0000,0000,0000,,لديه كلامٌ مهم ليقوله
Dialogue: 0,0:12:34.41,0:12:38.14,Default,,0000,0000,0000,,يطلب من الجميع القدوم لغرفة\Nأكي-سان في غضون 10 دقائق
Dialogue: 0,0:12:38.53,0:12:39.68,Default,,0000,0000,0000,,كلام مهم
Dialogue: 0,0:12:39.68,0:12:40.65,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:40.97,0:12:42.43,Default,,0000,0000,0000,,!نعتمد عليك
Dialogue: 0,0:12:46.19,0:12:48.85,Default,,0000,0000,0000,,!بسرعة! بسرعة! بسرعة
Dialogue: 0,0:12:48.85,0:12:51.85,Default,,0000,0000,0000,,...صوت العمّ رقم 59
Dialogue: 0,0:12:53.02,0:12:54.80,Default,,0000,0000,0000,,!عرفت هويّة المجرم؟
Dialogue: 0,0:12:54.80,0:13:00.26,Default,,0000,0000,0000,,أجل، الشخص المسؤول عن الحوادث الثلاث\Nعلى متن السفينة
Dialogue: 0,0:13:00.26,0:13:02.89,Default,,0000,0000,0000,,!مـ-من كان؟
Dialogue: 0,0:13:02.89,0:13:04.65,Default,,0000,0000,0000,,!هو حتماً
Dialogue: 0,0:13:04.65,0:13:06.22,Default,,0000,0000,0000,,!كان فعل تاكيشي
Dialogue: 0,0:13:06.22,0:13:08.30,Default,,0000,0000,0000,,...لا تعجلوا
Dialogue: 0,0:13:08.30,0:13:12.68,Default,,0000,0000,0000,,لنراجع الحوادث قبل أن أكشف اسم القاتل
Dialogue: 0,0:13:12.68,0:13:15.95,Default,,0000,0000,0000,,الحادثة الأولى هي حيث قُتل السيّد غوزو في غرفته
Dialogue: 0,0:13:15.95,0:13:18.60,Default,,0000,0000,0000,,المقفلة من الداخل
Dialogue: 0,0:13:19.16,0:13:21.56,Default,,0000,0000,0000,,وجود دماء على إطار مدخل الباب
Dialogue: 0,0:13:21.56,0:13:25.28,Default,,0000,0000,0000,,يعني أنّ السيّد غوزو هرب لغرفته\Nبعدما طُعن في الخارج
Dialogue: 0,0:13:25.28,0:13:30.10,Default,,0000,0000,0000,,ثمّ أقفل الباب ولفظ آخر أنفاسه
Dialogue: 0,0:13:30.10,0:13:33.55,Default,,0000,0000,0000,,ووجدنا لاحقاً زهرةً أمام باب الغرفة
Dialogue: 0,0:13:33.55,0:13:37.31,Default,,0000,0000,0000,,!أجل، كان تاكيشي يضعها
Dialogue: 0,0:13:37.31,0:13:38.76,Default,,0000,0000,0000,,!مما يعني أنّه الفاعل
Dialogue: 0,0:13:38.76,0:13:41.97,Default,,0000,0000,0000,,لكن هناك أمرٌ محير
Dialogue: 0,0:13:41.97,0:13:45.21,Default,,0000,0000,0000,,،رغم أنّ السيد غوزو طُعن خارج غرفته
Dialogue: 0,0:13:45.21,0:13:47.51,Default,,0000,0000,0000,,لم تكن هناك آثار دماء في الردهة
Dialogue: 0,0:13:47.51,0:13:49.84,Default,,0000,0000,0000,,لأنّ القاتل مسحها كي يؤخر
Dialogue: 0,0:13:49.84,0:13:52.47,Default,,0000,0000,0000,,اكتشاف الجثّة غالباً
Dialogue: 0,0:13:52.47,0:13:54.25,Default,,0000,0000,0000,,لا أدحض تلك الحقيقة
Dialogue: 0,0:13:54.25,0:13:58.47,Default,,0000,0000,0000,,ما أقصده هو أنّ الزهرة سقطت\Nبعدما مُسح الدم
Dialogue: 0,0:13:58.47,0:14:00.41,Default,,0000,0000,0000,,يمكن فهم سقوطها من القاتل دون أن ينتبه
Dialogue: 0,0:14:00.41,0:14:02.95,Default,,0000,0000,0000,,أثناء طعنه للضحية وهربه
Dialogue: 0,0:14:02.95,0:14:05.22,Default,,0000,0000,0000,,لكنّ القاتل مسح الدم بعناية
Dialogue: 0,0:14:05.69,0:14:09.36,Default,,0000,0000,0000,,كان يُفترض أن ينتبه للزهرة \Nلو كانت على الأرض وقتها
Dialogue: 0,0:14:09.36,0:14:12.14,Default,,0000,0000,0000,,خصوصاً لو سقطت وهو يمسح
Dialogue: 0,0:14:12.43,0:14:16.13,Default,,0000,0000,0000,,مما يعني أنّ القاتل تعمد رمي الزهرة على الأرض
Dialogue: 0,0:14:16.13,0:14:18.76,Default,,0000,0000,0000,,كي يُلفق التهمة بتاكيشي-سان
Dialogue: 0,0:14:19.21,0:14:23.45,Default,,0000,0000,0000,,وفي الحادثة الثانية، تاتسو-سان الذي قُتل\Nعلى سطح السفينة
Dialogue: 0,0:14:23.45,0:14:26.03,Default,,0000,0000,0000,,بخلاف الحادثة الأولى بالزهرة
Dialogue: 0,0:14:26.03,0:14:28.76,Default,,0000,0000,0000,,والحادثة الثالثة بعدّة القاطع
Dialogue: 0,0:14:28.76,0:14:31.33,Default,,0000,0000,0000,,لم يكن هناك أيّ تكلّف فيها
Dialogue: 0,0:14:32.22,0:14:35.06,Default,,0000,0000,0000,,،لو كان مرتكبها الشخص نفسه حقاً
Dialogue: 0,0:14:35.06,0:14:42.14,Default,,0000,0000,0000,,فأرجّح أنّ الجريمة الثانية وقعت بلا تخطيط سابق
Dialogue: 0,0:14:42.14,0:14:45.59,Default,,0000,0000,0000,,إذاً، نسأل لمَ قُتل تاتسو-سان؟
Dialogue: 0,0:14:45.59,0:14:49.05,Default,,0000,0000,0000,,الإجابة نجدها في هذه الحقيبة
Dialogue: 0,0:14:49.05,0:14:52.02,Default,,0000,0000,0000,,!إ-إنها حقيبة سكاكيني
Dialogue: 0,0:14:52.02,0:14:55.29,Default,,0000,0000,0000,,أمعنوا النظر، هناك سكّينتان ناقصتان
Dialogue: 0,0:14:55.29,0:14:58.25,Default,,0000,0000,0000,,وجدنا إحداهما مكان الحادثة الثالثة
Dialogue: 0,0:14:58.25,0:14:59.89,Default,,0000,0000,0000,,لكن أين ذهبت الأخرى؟
Dialogue: 0,0:14:59.89,0:15:04.70,Default,,0000,0000,0000,,المحور هنا هما الصوتان اللذان سمعهما كونان
Dialogue: 0,0:15:04.70,0:15:08.58,Default,,0000,0000,0000,,كان الارتطام صوت ضرب القاتل لتاتسو-سان
Dialogue: 0,0:15:08.58,0:15:11.10,Default,,0000,0000,0000,,لكن ما كانت قصّة صوت السقوط\Nفي الماء بعده؟
Dialogue: 0,0:15:11.91,0:15:13.73,Default,,0000,0000,0000,,...إليكم رأيي
Dialogue: 0,0:15:13.73,0:15:18.64,Default,,0000,0000,0000,,كان ذلك صوت رمي السكّين الأخرى\Nالناقصة من الحقيبة
Dialogue: 0,0:15:18.64,0:15:21.52,Default,,0000,0000,0000,,،لو صادف أن رأى تاتسو-سان ذلك
Dialogue: 0,0:15:21.52,0:15:24.68,Default,,0000,0000,0000,,وقتله الفاعل كي يكتم سرّه
Dialogue: 0,0:15:24.68,0:15:26.51,Default,,0000,0000,0000,,ستتصل النقاط
Dialogue: 0,0:15:26.89,0:15:31.68,Default,,0000,0000,0000,,لكنّ تاكيشي اختفى من المخزن\N!بعد الحادثة الثانية
Dialogue: 0,0:15:31.68,0:15:33.92,Default,,0000,0000,0000,,!صحيح! تاكيشي هو الأكثر إثارةً للشبهة
Dialogue: 0,0:15:34.55,0:15:38.96,Default,,0000,0000,0000,,كلا، كان ذاك المخزن مقفلاً من الخارج
Dialogue: 0,0:15:38.96,0:15:41.13,Default,,0000,0000,0000,,يستحيل الخروج دون أن يفتح أحدٌ لك
Dialogue: 0,0:15:41.13,0:15:41.93,Default,,0000,0000,0000,,من الخارج
Dialogue: 0,0:15:42.26,0:15:43.91,Default,,0000,0000,0000,,من كان إذاً؟
Dialogue: 0,0:15:43.91,0:15:45.30,Default,,0000,0000,0000,,من فتحه؟
Dialogue: 0,0:15:45.67,0:15:47.06,Default,,0000,0000,0000,,القاتل
Dialogue: 0,0:15:48.59,0:15:51.13,Default,,0000,0000,0000,,كان قتل تاتسو-سان خارج خطّته الأصلية
Dialogue: 0,0:15:51.13,0:15:54.74,Default,,0000,0000,0000,,ووقع ذلك أثناء احتجاز تاكيشي-سان
Dialogue: 0,0:15:54.74,0:15:57.62,Default,,0000,0000,0000,,عانى القاتل كي يُلفق التهمة بتاكيشي-سان
Dialogue: 0,0:15:57.62,0:16:01.26,Default,,0000,0000,0000,,وكانت هذه الجريمة الثانية لتعكس \Nالأمور وتثبت براءته
Dialogue: 0,0:16:01.26,0:16:04.30,Default,,0000,0000,0000,,لذا فتح القاتل قفل الباب
Dialogue: 0,0:16:05.40,0:16:07.86,Default,,0000,0000,0000,,فعلها كي يوهم أنّ تاكيشي-سان
Dialogue: 0,0:16:07.86,0:16:10.51,Default,,0000,0000,0000,,قادر على ارتكاب الجريمة الثانية
Dialogue: 0,0:16:10.51,0:16:13.85,Default,,0000,0000,0000,,!لمَ هرب تاكيشي إذاً؟
Dialogue: 0,0:16:13.85,0:16:16.01,Default,,0000,0000,0000,,!صحيح! لم نجده بعد
Dialogue: 0,0:16:16.01,0:16:18.93,Default,,0000,0000,0000,,لنوجّه ذلك له
Dialogue: 0,0:16:19.31,0:16:24.13,Default,,0000,0000,0000,,تاكيشي-سان، لمَ لا تتوقف عن الاختباء وتخرج؟
Dialogue: 0,0:16:24.13,0:16:26.26,Default,,0000,0000,0000,,!إنّه في هذه الغرفة؟
Dialogue: 0,0:16:28.38,0:16:29.68,Default,,0000,0000,0000,,!تاكيشي-سان
Dialogue: 0,0:16:37.24,0:16:38.91,Default,,0000,0000,0000,,!تاكيشي-سان
Dialogue: 0,0:16:38.91,0:16:43.38,Default,,0000,0000,0000,,هيّا، أخبرنا بما حصل عندما غادرت المخزن
Dialogue: 0,0:16:43.38,0:16:47.40,Default,,0000,0000,0000,,ظننتُ أنّ أمراً ما حلّ بناتسوي
Dialogue: 0,0:16:47.40,0:16:48.85,Default,,0000,0000,0000,,،لم أستطع البقاء ساكناً
Dialogue: 0,0:16:48.85,0:16:52.40,Default,,0000,0000,0000,,،وعندما نهضتُ للضرب على الباب\Nوجدتُ القفل مفتوحاً
Dialogue: 0,0:16:52.40,0:16:53.84,Default,,0000,0000,0000,,فهربت
Dialogue: 0,0:16:53.84,0:16:56.26,Default,,0000,0000,0000,,...وعندما خرجت لسطح السفينة
Dialogue: 0,0:16:56.26,0:16:58.97,Default,,0000,0000,0000,,!إنّه تاكيشي! فعلها مجدداً
Dialogue: 0,0:16:58.97,0:17:01.27,Default,,0000,0000,0000,,!تاتسو
Dialogue: 0,0:17:01.27,0:17:03.38,Default,,0000,0000,0000,,أدركتُ أن التهمة ستُوجه لي مجدداً
Dialogue: 0,0:17:03.84,0:17:06.17,Default,,0000,0000,0000,,فدخلت غرفة أكي-سان التي كان بابها مفتوحاً
Dialogue: 0,0:17:07.13,0:17:09.85,Default,,0000,0000,0000,,وبقيت مختبئاً داخل الخزانة
Dialogue: 0,0:17:10.13,0:17:13.20,Default,,0000,0000,0000,,أي أنّ الشخص الذي طعن\Nإيتشيرو-كن في الحادثة الثالثة
Dialogue: 0,0:17:13.20,0:17:14.63,Default,,0000,0000,0000,,...لم يكن أنت أيضاً
Dialogue: 0,0:17:15.12,0:17:16.70,Default,,0000,0000,0000,,!من كان؟
Dialogue: 0,0:17:16.70,0:17:18.76,Default,,0000,0000,0000,,!لمَ قد يؤذي إيتشيرو بهذه الفظاعة؟
Dialogue: 0,0:17:19.29,0:17:23.44,Default,,0000,0000,0000,,لأنّ القاتل ارتكب خطأً فادحاً
Dialogue: 0,0:17:23.44,0:17:24.22,Default,,0000,0000,0000,,خطأ؟
Dialogue: 0,0:17:24.22,0:17:27.64,Default,,0000,0000,0000,,أجل، فتح قفل باب المخزن
Dialogue: 0,0:17:28.49,0:17:31.49,Default,,0000,0000,0000,,تمكن القاتل من إلفاق التهمة بتاكيشي-سان بإتقان
Dialogue: 0,0:17:31.49,0:17:35.80,Default,,0000,0000,0000,,لكن بدا الآن أنّ هناك متعاوناً أخرجه
Dialogue: 0,0:17:35.80,0:17:39.68,Default,,0000,0000,0000,,لم يشكّ أحد بهوية القاتل الحقيقي حتى حينها
Dialogue: 0,0:17:39.68,0:17:43.26,Default,,0000,0000,0000,,وفي هلعه فكّر القاتل بخطة عاجلة
Dialogue: 0,0:17:43.26,0:17:45.42,Default,,0000,0000,0000,,لإزالة أيّ شبهات تحيطه
Dialogue: 0,0:17:45.42,0:17:49.68,Default,,0000,0000,0000,,وكانت الحادثة الثالثة حيث طُعن\Nإيتشيرو-سان في دورة المياه
Dialogue: 0,0:17:51.42,0:17:56.09,Default,,0000,0000,0000,,لكنها كانت الحادثة التي أوقعت \Nالقاتل في قبره
Dialogue: 0,0:17:56.83,0:18:01.54,Default,,0000,0000,0000,,يُفترض أنّ القاتل لم يستطع رؤية\Nإيتشيرو-كن في الظلام
Dialogue: 0,0:18:01.54,0:18:05.55,Default,,0000,0000,0000,,مع ذلك تمكن من تحديده بدقة وطعنه
Dialogue: 0,0:18:05.55,0:18:07.55,Default,,0000,0000,0000,,كيف يُعقل ذلك؟
Dialogue: 0,0:18:07.55,0:18:10.51,Default,,0000,0000,0000,,بالإضافة، هناك السلاح الذي وجدناه في مسرح الحادثة
Dialogue: 0,0:18:11.15,0:18:17.02,Default,,0000,0000,0000,,بخلاف أوّل جريمتين، لم يترك الفاعل السلاح
Dialogue: 0,0:18:17.02,0:18:20.27,Default,,0000,0000,0000,,كلا، لم يستطع إلّا أن يتركه
Dialogue: 0,0:18:20.27,0:18:24.93,Default,,0000,0000,0000,,فساقه كانت مصابة ولا يمكنه الحركة
Dialogue: 0,0:18:26.51,0:18:28.10,Default,,0000,0000,0000,,...إ-إذاً
Dialogue: 0,0:18:28.10,0:18:29.47,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:18:29.47,0:18:32.60,Default,,0000,0000,0000,,!إيتشيرو-كن طعن نفسه بنفسه
Dialogue: 0,0:18:32.60,0:18:37.42,Default,,0000,0000,0000,,ومن قتل السيّد غوزو وتاتسو-سان
Dialogue: 0,0:18:37.42,0:18:41.77,Default,,0000,0000,0000,,كان أنت... يا إيتشيرو-كن
Dialogue: 0,0:18:44.22,0:18:45.38,Default,,0000,0000,0000,,...إيتشيرو
Dialogue: 0,0:18:45.68,0:18:47.81,Default,,0000,0000,0000,,سبب إطفائك للأضواء
Dialogue: 0,0:18:47.81,0:18:51.31,Default,,0000,0000,0000,,هو لأنّك لم ترد أن ترد تحديد هويّة مُهاجمك
Dialogue: 0,0:18:51.31,0:18:57.00,Default,,0000,0000,0000,,لو قلتَ أنّه تاكيشي-سان ثمّ ثبتت براءته
Dialogue: 0,0:18:57.00,0:18:59.72,Default,,0000,0000,0000,,فستتحول الشبهة نحوك
Dialogue: 0,0:19:00.22,0:19:02.81,Default,,0000,0000,0000,,!كلها افتراضات
Dialogue: 0,0:19:03.24,0:19:05.93,Default,,0000,0000,0000,,!ألديك دليل أنّ إيتشيرو كان القاتل؟
Dialogue: 0,0:19:05.93,0:19:08.12,Default,,0000,0000,0000,,هذا هو الدليل
Dialogue: 0,0:19:08.12,0:19:13.38,Default,,0000,0000,0000,,كسرة الخبز التي وجدناها\Nقرب جثّة السيد غوزو
Dialogue: 0,0:19:13.38,0:19:15.47,Default,,0000,0000,0000,,كسرة خبز؟
Dialogue: 0,0:19:16.07,0:19:18.07,Default,,0000,0000,0000,,إيتشيرو-كن طالب فنون
Dialogue: 0,0:19:18.07,0:19:21.11,Default,,0000,0000,0000,,،وقبل قتل السيّد غوزو
Dialogue: 0,0:19:21.11,0:19:22.93,Default,,0000,0000,0000,,كان يرسم على سطح السفينة
Dialogue: 0,0:19:22.93,0:19:26.93,Default,,0000,0000,0000,,تُستعمل كسرات الخبز لمسح\Nرسمات الفحم أحياناً
Dialogue: 0,0:19:26.93,0:19:29.51,Default,,0000,0000,0000,,وسمعتُ أنّها تدخل فتحات أكمام الرسامين عادةً
Dialogue: 0,0:19:30.14,0:19:34.47,Default,,0000,0000,0000,,عندما طعن السيّد غوزو، سقطت كسرة الخبز\Nمن كمّ إيتشيرو-كن
Dialogue: 0,0:19:35.17,0:19:37.93,Default,,0000,0000,0000,,وعلى دمّ السيد غوزو
Dialogue: 0,0:19:38.38,0:19:42.46,Default,,0000,0000,0000,,كما أنّ كسرة الخبز هذه تحوي نسبة صغيرة من الفحم
Dialogue: 0,0:19:42.46,0:19:45.84,Default,,0000,0000,0000,,لا ريب أنّها سقطت من إيتشيرو-كن
Dialogue: 0,0:19:45.84,0:19:48.22,Default,,0000,0000,0000,,!لكن لا دافع لديه
Dialogue: 0,0:19:48.22,0:19:50.91,Default,,0000,0000,0000,,!لا سبب ليقتل إيتشيرو أبي
Dialogue: 0,0:19:50.91,0:19:55.28,Default,,0000,0000,0000,,لم أستطع معرفة دافعه حتى النهاية
Dialogue: 0,0:19:55.28,0:19:58.18,Default,,0000,0000,0000,,إلى أن رأيتُ شيئاً في غرفة إيتشيرو-كن
Dialogue: 0,0:19:59.19,0:20:00.39,Default,,0000,0000,0000,,شيء في غرفته؟
Dialogue: 0,0:20:00.86,0:20:02.28,Default,,0000,0000,0000,,هذا
Dialogue: 0,0:20:02.28,0:20:06.39,Default,,0000,0000,0000,,هذا دافع إيتشيرو-كن لقتل السيّد غوزو
Dialogue: 0,0:20:08.14,0:20:09.93,Default,,0000,0000,0000,,لمَ الرسمة هي دافعه؟
Dialogue: 0,0:20:09.93,0:20:11.76,Default,,0000,0000,0000,,الإجابة في الرسمة نفسها
Dialogue: 0,0:20:12.81,0:20:14.25,Default,,0000,0000,0000,,...لا أفهم
Dialogue: 0,0:20:15.47,0:20:16.47,Default,,0000,0000,0000,,...توقفي
Dialogue: 0,0:20:17.63,0:20:18.64,Default,,0000,0000,0000,,!توقفي
Dialogue: 0,0:20:19.47,0:20:22.88,Default,,0000,0000,0000,,!لحظة، هذه كلّها رسمات لناتسوي
Dialogue: 0,0:20:23.76,0:20:24.88,Default,,0000,0000,0000,,!توقفي
Dialogue: 0,0:20:28.91,0:20:31.85,Default,,0000,0000,0000,,...إ-إيتشيرو، أيمكن أنّك
Dialogue: 0,0:20:32.25,0:20:33.49,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:20:33.49,0:20:37.79,Default,,0000,0000,0000,,كان إيتشيرو-كن واقعاً في حُب ناتسوي-سان
Dialogue: 0,0:20:40.49,0:20:41.81,Default,,0000,0000,0000,,...إيتشيرو-سان
Dialogue: 0,0:20:42.32,0:20:45.10,Default,,0000,0000,0000,,سمعتُ من الخادم سوزوكي-سان
Dialogue: 0,0:20:45.10,0:20:48.44,Default,,0000,0000,0000,,،عاجزاً عن البوح بمشاعرك لناتسوي-سان
Dialogue: 0,0:20:48.44,0:20:49.51,Default,,0000,0000,0000,,...ذهبت للسيّد غوزو و
Dialogue: 0,0:20:49.51,0:20:53.91,Default,,0000,0000,0000,,!صحيح! طلبتُ منه الزواج بناتسوي-سان
Dialogue: 0,0:20:55.38,0:20:57.76,Default,,0000,0000,0000,,لكنه رفض الإصغاء لي
Dialogue: 0,0:20:58.26,0:21:01.55,Default,,0000,0000,0000,,قال أنّه لن يرمي ناتسوي الغالية\Nبين أحضان شخصٍ مثلي
Dialogue: 0,0:21:01.55,0:21:04.37,Default,,0000,0000,0000,,وبفترة وجيزة بعدها كما لو كانت نكايةً بي
Dialogue: 0,0:21:04.37,0:21:07.68,Default,,0000,0000,0000,,!أعلن أن ناتسوي-سان ستتزوج من تاكيشي-سان
Dialogue: 0,0:21:08.62,0:21:12.25,Default,,0000,0000,0000,,ثمّ صرخ بي بالأمس عندما
Dialogue: 0,0:21:12.25,0:21:14.55,Default,,0000,0000,0000,,كنتُ على سطح السفينة أرسم ناتسوي-سان
Dialogue: 0,0:21:15.16,0:21:18.26,Default,,0000,0000,0000,,!أخبره أن ييأس من حلمه المستحيل
Dialogue: 0,0:21:18.26,0:21:20.95,Default,,0000,0000,0000,,لم أستطع مسامحتهما
Dialogue: 0,0:21:20.95,0:21:24.42,Default,,0000,0000,0000,,جدّي الذي رفض تزويجي بناتسوي-سان
Dialogue: 0,0:21:24.76,0:21:31.41,Default,,0000,0000,0000,,وتاكيشي-سان الذي سرق\N!ناتسوي-سان مني! لم أستطع
Dialogue: 0,0:23:11.14,0:23:12.13,Default,,0000,0000,0000,,تاكيشي-سان
Dialogue: 0,0:23:12.13,0:23:17.05,Default,,0000,0000,0000,,لا تزال تكنّ الضغينة نحو عائلتنا وجدّي؟
Dialogue: 0,0:23:17.54,0:23:20.64,Default,,0000,0000,0000,,أنا ابن زايكي إيساو الذي انتحر
Dialogue: 0,0:23:20.64,0:23:24.86,Default,,0000,0000,0000,,بعدما استولت مجموعة هاتاموتو\Nعلى شركته بالفعل
Dialogue: 0,0:23:24.86,0:23:28.98,Default,,0000,0000,0000,,تقرّبتُ منك لأنّي أبغضت جدّك صدقاً
Dialogue: 0,0:23:28.98,0:23:31.68,Default,,0000,0000,0000,,...لكن مُذ التقيتك
Dialogue: 0,0:23:36.10,0:23:39.14,Default,,0000,0000,0000,,المأساة سبّبها شابٌ خجول
Dialogue: 0,0:23:39.14,0:23:42.01,Default,,0000,0000,0000,,عجز عن التعبير عن مشاعره الخفية بكلمات
Dialogue: 0,0:23:43.89,0:23:47.04,Default,,0000,0000,0000,,...تقترب السفينة من طوكيو
Dialogue: 0,0:23:47.04,0:23:51.36,Default,,0000,0000,0000,,ويكسوها غروب الشمس الأحمر \Nالذي يمثّل حزن ويأس
Dialogue: 0,0:23:51.36,0:23:53.26,Default,,0000,0000,0000,,إيتشيرو-سان وعائلة هاتاموتو
Dialogue: 0,0:24:09.47,0:24:10.55,Default,,0000,0000,0000,,...تعاني
Dialogue: 0,0:24:10.55,0:24:11.81,Default,,0000,0000,0000,,فقدان ذاكرة؟
Dialogue: 0,0:24:13.46,0:24:14.51,Default,,0000,0000,0000,,...ذاك الرجل
Dialogue: 0,0:24:20.67,0:24:22.29,Default,,0000,0000,0000,,لمَ يستهدف ذاك الرجل من مضمار السباق
Dialogue: 0,0:24:22.29,0:24:23.84,Default,,0000,0000,0000,,!مايا-سان؟
Dialogue: 0,0:24:25.03,0:24:26.45,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.45,0:24:29.03,Default,,0000,0000,0000,,قضيّة المرأة فاقدة الذاكرة الغامضة
Dialogue: 0,0:24:46.22,0:24:48.39,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.39,0:24:49.93,Default,,0000,0000,0000,,دبّوس زينة

