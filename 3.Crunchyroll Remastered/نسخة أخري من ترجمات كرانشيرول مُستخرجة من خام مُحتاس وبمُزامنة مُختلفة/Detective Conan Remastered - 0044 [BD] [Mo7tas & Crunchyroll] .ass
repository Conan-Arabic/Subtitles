Dialogue: 0,0:00:01.77,0:00:04.55,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.98,0:00:08.88,Default,,0000,0000,0000,,!تتضمن قضيّة اليوم ثلاثة أشقّاء! ألغاز تلفّها ألغاز
Dialogue: 0,0:00:08.88,0:00:10.76,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.76,0:00:13.22,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله لبالغ
Dialogue: 0,0:00:13.22,0:00:15.59,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.98,0:01:52.09,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل الأشقّاء هوتّا الثلاثة
Dialogue: 0,0:01:46.61,0:01:49.62,Default,,0000,0000,0000,,جريمة قتل الأشقّاء هوتّا الثلاثة
Dialogue: 0,0:01:55.94,0:02:01.65,Default,,0000,0000,0000,,يا إلهي، قطعتُ الطريق لهذا المكان\N...لأنّه قال أنّها حادثة كبيرة
Dialogue: 0,0:02:01.81,0:02:03.94,Default,,0000,0000,0000,,كان عليك قبول القضيّة
Dialogue: 0,0:02:03.94,0:02:08.14,Default,,0000,0000,0000,,!حمقاء! لن أبحث عن حيوانٍ زاحف
Dialogue: 0,0:02:08.34,0:02:10.56,Default,,0000,0000,0000,,...أراه عملاً ملائماً لك
Dialogue: 0,0:02:15.97,0:02:17.77,Default,,0000,0000,0000,,أهناك مشكلة؟
Dialogue: 0,0:02:17.77,0:02:24.27,Default,,0000,0000,0000,,تعطّلت سيّارتي، هلّا أخذتني لمنزلي الجبلي\Nفي الطريق أمامنا من فضلك؟
Dialogue: 0,0:02:24.96,0:02:27.95,Default,,0000,0000,0000,,سأجازيك بالطبع
Dialogue: 0,0:02:27.95,0:02:30.19,Default,,0000,0000,0000,,!سأقلّك بكلّ سرور
Dialogue: 0,0:02:30.19,0:02:33.91,Default,,0000,0000,0000,,شكراً لك، اسمي هوتّا
Dialogue: 0,0:02:33.90,0:02:35.91,Default,,0000,0000,0000,,سُررت بلقائك
Dialogue: 0,0:02:37.98,0:02:40.28,Default,,0000,0000,0000,,!شـ-شركة هوتّا للصناعات
Dialogue: 0,0:02:40.56,0:02:43.35,On Top,,0000,0000,0000,,!أنت رئيس تلك الشركة الكبيرة؟
Dialogue: 0,0:02:40.68,0:02:43.99,CharCard,,0000,0000,0005,,{\fad(300,0)}(هوتّا كوساكو (58\Nرئيس هوتّا للصناعات
Dialogue: 0,0:03:01.88,0:03:03.36,Default,,0000,0000,0000,,!ياماوتشي
Dialogue: 0,0:03:03.36,0:03:04.90,Default,,0000,0000,0000,,!سـ-سيّدي
Dialogue: 0,0:03:07.20,0:03:08.70,Default,,0000,0000,0000,,ماذا حصل؟
Dialogue: 0,0:03:08.70,0:03:12.65,Default,,0000,0000,0000,,تعطّلت سيّارتي، فأقلّني هذا السيّد
Dialogue: 0,0:03:12.65,0:03:18.65,On Top,,0000,0000,0000,,هكذا إذاً، أنا مُدبّر هذا المنزل الجبلي، أُدعى ياماوتشي
Dialogue: 0,0:03:12.78,0:03:18.11,CharCard,,0000,0000,0005,,{\fad(300,300)}(ياماوتشي ماساهيرو (55\Nمدبّر المنزل الجبلي
Dialogue: 0,0:03:18.65,0:03:21.10,Default,,0000,0000,0000,,شكراً لمساعدتك الرئيس
Dialogue: 0,0:03:21.10,0:03:25.07,Default,,0000,0000,0000,,لم يكن شيئاً يُذكر، علينا مساعدة بعضنا عند الحاجة
Dialogue: 0,0:03:25.07,0:03:27.89,Default,,0000,0000,0000,,هل وصل كويتشي والبقيّة؟
Dialogue: 0,0:03:27.89,0:03:33.02,Default,,0000,0000,0000,,أجل، الجميع قلقون من تأخّرك
Dialogue: 0,0:03:33.60,0:03:38.93,Default,,0000,0000,0000,,أشكّ في ذلك، إنّهم يتمنّون\Nموتي في حادثٍ بالتأكيد
Dialogue: 0,0:03:40.25,0:03:45.13,Default,,0000,0000,0000,,بالمناسبة يا موري-سان، اليوم موعد حفلة عيد ميلادي
Dialogue: 0,0:03:45.13,0:03:47.70,Default,,0000,0000,0000,,أودّ دعوتك تعبيراً عن امتناني
Dialogue: 0,0:03:47.70,0:03:49.65,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:03:49.65,0:03:51.15,Default,,0000,0000,0000,,لا تمانع، صحيح؟
Dialogue: 0,0:03:51.15,0:03:53.74,Default,,0000,0000,0000,,!سأقبل عرضك
Dialogue: 0,0:04:00.07,0:04:03.01,Default,,0000,0000,0000,,...لم تصل في الوقت يا أبي فشعرنا بالقلق
Dialogue: 0,0:04:03.17,0:04:06.59,CharCard,,0000,0000,0005,,{\fad(300,0)}(هوتّا كويتشي (39\Nالابن الأكبر
Dialogue: 0,0:04:03.65,0:04:07.39,On Top,,0000,0000,0000,,من تعرّضك لحادثٍ في الطريق
Dialogue: 0,0:04:07.39,0:04:10.98,On Top,,0000,0000,0000,,أجل، فلا تساوي شركة هوتّا للصناعات شيئاً دونك
Dialogue: 0,0:04:07.76,0:04:10.98,CharCard,,0000,0000,0005,,{\fad(300,0)}(هوتّا هارومي (36\Nزوجة كويتشي
Dialogue: 0,0:04:10.98,0:04:15.69,On Top,,0000,0000,0000,,بالفعل، لا زالت الشركة بحاجة لك لوقتٍ طويل
Dialogue: 0,0:04:11.05,0:04:15.69,CharCard,,0000,0000,0005,,{\fad(300,0)}(هوتّا ريوجي (28\Nالابن الثاني
Dialogue: 0,0:04:19.21,0:04:26.60,Default,,0000,0000,0000,,شاتو بيتروس، 1979. هديّة من كويتشي-ساما
Dialogue: 0,0:04:27.12,0:04:29.39,Default,,0000,0000,0000,,أذاك نبيذ باهظ؟
Dialogue: 0,0:04:29.39,0:04:33.83,Default,,0000,0000,0000,,أجل، لحدٍّ يخرج عينيك
Dialogue: 0,0:04:33.83,0:04:37.05,Default,,0000,0000,0000,,يدعونه بملك النبيذ الأحمر
Dialogue: 0,0:04:49.22,0:04:53.52,Default,,0000,0000,0000,,لنشرب إذاً نخب عيد ميلاد أبينا الثامن والخمسين
Dialogue: 0,0:04:53.52,0:04:54.82,Default,,0000,0000,0000,,!انتظروا
Dialogue: 0,0:04:56.71,0:04:59.31,Default,,0000,0000,0000,,لمَ لا تشرب أنت أوّلاً يا أخي؟
Dialogue: 0,0:05:00.01,0:05:01.56,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:05:01.84,0:05:05.48,Default,,0000,0000,0000,,خطر لي أنّه لن يكون مسليّاً وجود سمٍّ فيه
Dialogue: 0,0:05:07.29,0:05:09.22,Default,,0000,0000,0000,,!يا للفظاظة يا ريوجي-سان
Dialogue: 0,0:05:09.22,0:05:11.77,Default,,0000,0000,0000,,وصلتني الشائعات
Dialogue: 0,0:05:11.77,0:05:17.07,Default,,0000,0000,0000,,تلقّى الفرع خارج البلاد أضرار كبيرة بسبب توقّعاتك الخاطئة
Dialogue: 0,0:05:17.07,0:05:23.19,Default,,0000,0000,0000,,وسمعتُ أنّك ستُصرف وتُنقل لشركة فرعية
Dialogue: 0,0:05:23.61,0:05:26.14,Default,,0000,0000,0000,,!تظنني سأقتل أبي لهذا؟
Dialogue: 0,0:05:26.39,0:05:31.10,Default,,0000,0000,0000,,!أنت من شاع أنّه دخل قمارات كبيرة وغرق في الديون
Dialogue: 0,0:05:31.10,0:05:33.06,Default,,0000,0000,0000,,!لا-لا تتدخل فيما لا يخصّك
Dialogue: 0,0:05:34.56,0:05:35.78,Default,,0000,0000,0000,,!يكفي
Dialogue: 0,0:05:37.63,0:05:39.27,Default,,0000,0000,0000,,...عشائي
Dialogue: 0,0:05:39.55,0:05:41.77,Default,,0000,0000,0000,,!ضقتُ ذرعاً بهذا
Dialogue: 0,0:05:44.30,0:05:47.56,Default,,0000,0000,0000,,لا يزال شقيقاي مقرّبين كعادتهما
Dialogue: 0,0:05:48.04,0:05:49.04,On Top,,0000,0000,0000,,!أختي
Dialogue: 0,0:05:48.16,0:05:51.02,CharCard,,0000,0000,0005,,{\fad(300,0)} (30) هوتّا فوميكو\Nالابنة الكبرى
Dialogue: 0,0:05:49.04,0:05:50.21,On Top,,0000,0000,0000,,!فوميكو
Dialogue: 0,0:05:52.04,0:05:53.73,Default,,0000,0000,0000,,لمَ أنتِ هنا؟
Dialogue: 0,0:05:53.73,0:05:58.43,Default,,0000,0000,0000,,يا للتحيّة القاسية، بعدما أرسلت الدعوة بنفسك
Dialogue: 0,0:05:58.70,0:06:03.15,Default,,0000,0000,0000,,!قطعت العلاقة بك قبل 5 أعوام\N!يستحيل أن أرسل لك دعوة
Dialogue: 0,0:06:04.03,0:06:06.97,Default,,0000,0000,0000,,!لا أريد رؤية وجهك! اخرجي
Dialogue: 0,0:06:06.97,0:06:09.94,Default,,0000,0000,0000,,أنت من استدعاني وقال أنّ لديه\N!موضوعاً يريد الكلام فيه معي
Dialogue: 0,0:06:09.94,0:06:11.90,Default,,0000,0000,0000,,!لا أريد الكلام معك بشيء
Dialogue: 0,0:06:15.93,0:06:18.97,Default,,0000,0000,0000,,كان يُفترض أن نأكل وليمةً اليوم
Dialogue: 0,0:06:18.97,0:06:20.81,Default,,0000,0000,0000,,...أبي
Dialogue: 0,0:06:21.18,0:06:25.13,Default,,0000,0000,0000,,ماذا حصل بين هوتّا-سان وفوميكو-سان في الماضي؟
Dialogue: 0,0:06:25.13,0:06:29.83,Default,,0000,0000,0000,,لا أدري، مضى عامان فقط على كوني مدبّر المنزل
Dialogue: 0,0:06:29.83,0:06:32.40,Default,,0000,0000,0000,,فلا أعرف الماضي
Dialogue: 0,0:06:43.24,0:06:46.89,Default,,0000,0000,0000,,ويسكي؟ هدية من؟
Dialogue: 0,0:06:50.77,0:06:52.40,Default,,0000,0000,0000,,!ما-ماذا حصل؟
Dialogue: 0,0:06:57.97,0:06:59.80,Default,,0000,0000,0000,,!سـ-سيّدي
Dialogue: 0,0:07:00.80,0:07:03.39,Default,,0000,0000,0000,,...قنبلة
Dialogue: 0,0:07:03.39,0:07:04.80,Default,,0000,0000,0000,,...ما-ما هذا
Dialogue: 0,0:07:04.80,0:07:05.96,Default,,0000,0000,0000,,!اتّصل بالشرطة
Dialogue: 0,0:07:05.96,0:07:07.01,Default,,0000,0000,0000,,!حـ-حاضر
Dialogue: 0,0:07:10.33,0:07:14.71,Default,,0000,0000,0000,,يبدو أنّ قنبلةً زُرعت في هذه الغرفة
Dialogue: 0,0:07:14.71,0:07:16.02,Default,,0000,0000,0000,,!هذه سخافة
Dialogue: 0,0:07:16.28,0:07:21.10,Default,,0000,0000,0000,,لا تدخلوا! انتظروا خارجاً حتّى وصول الشرطة رجاءً
Dialogue: 0,0:07:21.10,0:07:24.11,Default,,0000,0000,0000,,!من أنت لتتصرف بهذا التعالي؟
Dialogue: 0,0:07:25.24,0:07:29.31,Default,,0000,0000,0000,,!أعظم متحرٍّ على الأرض، موري كوغورو
Dialogue: 0,0:07:29.31,0:07:31.54,Default,,0000,0000,0000,,!موري كوغورو؟
Dialogue: 0,0:07:31.54,0:07:33.40,Default,,0000,0000,0000,,ذاك المتحرّي الشهير؟
Dialogue: 0,0:07:38.60,0:07:41.47,Default,,0000,0000,0000,,كان ديناميت
Dialogue: 0,0:07:41.47,0:07:44.80,Default,,0000,0000,0000,,رائحته لا تبدو رائحة ديناميت لي
Dialogue: 0,0:07:44.80,0:07:47.04,Default,,0000,0000,0000,,!تقحم أنفك مُجدداً؟
Dialogue: 0,0:07:48.50,0:07:50.69,Default,,0000,0000,0000,,به شظايا خشب وزجاج
Dialogue: 0,0:07:50.69,0:07:53.61,Default,,0000,0000,0000,,!أيّها الشقيّ! مؤلم
Dialogue: 0,0:07:53.92,0:07:56.91,Default,,0000,0000,0000,,!هذا... صندوق تقديم ويسكي
Dialogue: 0,0:07:56.91,0:08:00.85,Default,,0000,0000,0000,,فهمت، الزجاج العالق به كان من قنّينة
Dialogue: 0,0:08:01.58,0:08:02.91,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:08:02.91,0:08:06.07,Default,,0000,0000,0000,,!كانت القنبلة داخل صندوق ويسكي
Dialogue: 0,0:08:06.07,0:08:08.93,Default,,0000,0000,0000,,!لذا تملأ الشظايا جثّة هوتّا-سان
Dialogue: 0,0:08:09.44,0:08:10.94,Default,,0000,0000,0000,,...فهمت
Dialogue: 0,0:08:11.19,0:08:16.47,Default,,0000,0000,0000,,أدركتُ هذا قبل وقت طويل\N!دون أن أحتاجك لتخبرني
Dialogue: 0,0:08:18.56,0:08:20.06,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:08:21.89,0:08:25.02,Default,,0000,0000,0000,,تراب؟ لمَ موجود في الغرفة؟
Dialogue: 0,0:08:26.05,0:08:27.92,Default,,0000,0000,0000,,أبي
Dialogue: 0,0:08:27.92,0:08:29.31,Default,,0000,0000,0000,,أين ياماوتشي-تشان؟
Dialogue: 0,0:08:29.31,0:08:32.35,Default,,0000,0000,0000,,قال أنّ الهاتف مقطوع
Dialogue: 0,0:08:32.35,0:08:34.06,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:08:36.22,0:08:41.85,Default,,0000,0000,0000,,إذا كان هناك شخصٌ بيننا\Nيكنّ ضغينةً لأبي... فهي أنت يا فوميكو
Dialogue: 0,0:08:42.20,0:08:45.97,Default,,0000,0000,0000,,!صحيح! لم تتكلّما لخمسة أعوام
Dialogue: 0,0:08:45.97,0:08:52.15,Default,,0000,0000,0000,,!ظهورك المُفاجئ بلا دعوة غريبٌ قطعاً
Dialogue: 0,0:08:53.03,0:08:59.52,Default,,0000,0000,0000,,!أجل، كنتُ أبغضه بالفعل... بما يكفي لقتله
Dialogue: 0,0:09:00.31,0:09:07.02,Default,,0000,0000,0000,,لكني لم أفعل، رغم أنّي أريد شكر من فعل
Dialogue: 0,0:09:07.34,0:09:10.31,Default,,0000,0000,0000,,أظنّكما تشاركانني مشاعري
Dialogue: 0,0:09:10.31,0:09:12.80,Default,,0000,0000,0000,,يا للأشقّاء الفظيعين
Dialogue: 0,0:09:13.92,0:09:15.76,Default,,0000,0000,0000,,كيف كانت خطوط الهاتف؟
Dialogue: 0,0:09:15.76,0:09:19.43,Default,,0000,0000,0000,,بدا أنّها قُطعت بسكّين
Dialogue: 0,0:09:19.43,0:09:20.60,Default,,0000,0000,0000,,بسكّين؟
Dialogue: 0,0:09:21.12,0:09:23.25,Default,,0000,0000,0000,,ما العمل يا موري-سان؟
Dialogue: 0,0:09:25.08,0:09:26.01,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:09:26.01,0:09:29.52,Default,,0000,0000,0000,,زُرِعت القنبلة داخل صندوق ويسكي
Dialogue: 0,0:09:30.95,0:09:32.77,Default,,0000,0000,0000,,...صـ-صندوق التقديم هذا
Dialogue: 0,0:09:32.77,0:09:34.55,Default,,0000,0000,0000,,!أتعرفه؟
Dialogue: 0,0:09:34.55,0:09:35.73,Default,,0000,0000,0000,,...في الواقع
Dialogue: 0,0:09:35.73,0:09:37.60,Default,,0000,0000,0000,,!أخبرنا
Dialogue: 0,0:09:37.85,0:09:42.06,Default,,0000,0000,0000,,أظنّه كان هديّةً من ريوجي-ساما للسيّد
Dialogue: 0,0:09:42.06,0:09:46.77,Default,,0000,0000,0000,,أتذكّر لأنّي أخذته لغرفته
Dialogue: 0,0:09:46.77,0:09:48.79,Default,,0000,0000,0000,,ر-ريوجي كان الفاعل؟
Dialogue: 0,0:09:48.79,0:09:50.73,Default,,0000,0000,0000,,أين ريوجي-سان بالمناسبة؟
Dialogue: 0,0:09:57.71,0:09:59.35,Default,,0000,0000,0000,,...هرب
Dialogue: 0,0:09:59.35,0:10:00.69,Default,,0000,0000,0000,,لا يمكن
Dialogue: 0,0:10:04.58,0:10:05.97,Default,,0000,0000,0000,,!سكّين
Dialogue: 0,0:10:08.99,0:10:11.56,Default,,0000,0000,0000,,هذه سيّارة ريوجي-ساما
Dialogue: 0,0:10:12.74,0:10:16.44,Default,,0000,0000,0000,,لا يمكن أنّه ابتعد بتركه لسيّارته
Dialogue: 0,0:10:16.44,0:10:20.02,Default,,0000,0000,0000,,أيعني هذا أنّه لا يزال في الأرجاء؟
Dialogue: 0,0:10:22.89,0:10:26.10,Default,,0000,0000,0000,,!هذا... مُزّق الإطار
Dialogue: 0,0:10:26.59,0:10:29.09,Default,,0000,0000,0000,,موري-سان، ماذا نفعل الآن؟
Dialogue: 0,0:10:29.09,0:10:32.13,Default,,0000,0000,0000,,يجدر بنا المغادرة في سيّاراتنا
Dialogue: 0,0:10:32.13,0:10:33.53,Default,,0000,0000,0000,,ذلك ليس ممكناً
Dialogue: 0,0:10:33.53,0:10:34.44,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:34.44,0:10:38.39,Default,,0000,0000,0000,,مُزّقت إطارات السيّارات، الأربع كلّها
Dialogue: 0,0:10:38.87,0:10:43.36,Default,,0000,0000,0000,,!لا يُعقل! لا يمكننا مغادرة المنزل إذاً؟
Dialogue: 0,0:10:43.36,0:10:48.35,Default,,0000,0000,0000,,كانت فعلة ريوجي، يوجد مطّاط عالق بالسكّين
Dialogue: 0,0:10:49.07,0:10:51.36,Default,,0000,0000,0000,,كيف وصلتما هنا؟
Dialogue: 0,0:10:51.36,0:10:54.15,Default,,0000,0000,0000,,لا يمكننا القيادة فاستقللنا سيّارة خاصّة
Dialogue: 0,0:10:54.57,0:10:56.27,Default,,0000,0000,0000,,أتوجد سيّارات أخرى؟
Dialogue: 0,0:10:56.27,0:11:02.06,Default,,0000,0000,0000,,توجد سيّارتي، لكنّها معطّلة وليست صالحة للقيادة
Dialogue: 0,0:11:02.06,0:11:07.52,Default,,0000,0000,0000,,إذا كان ريوجي-سان الفاعل فلمَ مزّق\Nإطارات سيّارته أيضاً؟
Dialogue: 0,0:11:07.52,0:11:11.55,Default,,0000,0000,0000,,،أليس واضحاً؟ إن كانت إطاراته الوحيدة السليمة
Dialogue: 0,0:11:11.55,0:11:16.22,Default,,0000,0000,0000,,ستشتبه به الشرطة فوراً
Dialogue: 0,0:11:16.50,0:11:21.50,Default,,0000,0000,0000,,هذا غريب، سيظلّ المشبوه به الأول \Nإذا انفجر الويسكي الذي أرسله
Dialogue: 0,0:11:21.50,0:11:26.06,Default,,0000,0000,0000,,ثم اختفى فجأةً بعدها، حتّى بعد هذه الحيلة
Dialogue: 0,0:11:26.53,0:11:28.78,Default,,0000,0000,0000,,لم يكن ريوجي-سان الفاعل
Dialogue: 0,0:11:28.78,0:11:33.41,Default,,0000,0000,0000,,...لكن إذا كان هدف القاتل احتجاز الجميع في المنزل
Dialogue: 0,0:11:33.41,0:11:35.27,Default,,0000,0000,0000,,!قد يحصل شيءٌ آخر
Dialogue: 0,0:11:35.86,0:11:39.52,Default,,0000,0000,0000,,بأيّ حال، لا يزال ريوجي في الأرجاء
Dialogue: 0,0:11:39.52,0:11:42.73,Default,,0000,0000,0000,,احرصوا على البقاء مُتقاربين وعدم التصرّف وحدكم
Dialogue: 0,0:11:42.73,0:11:46.18,Default,,0000,0000,0000,,!لا تمازحني! سأذهب لغرفتي
Dialogue: 0,0:11:47.72,0:11:50.39,Default,,0000,0000,0000,,يا إلهي، بعدما حذرتها فوراً
Dialogue: 0,0:11:50.76,0:11:53.01,Default,,0000,0000,0000,,حسناً، لنرجع للداخل يا سادة
Dialogue: 0,0:11:53.01,0:11:54.27,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:54.72,0:11:58.34,Default,,0000,0000,0000,,موري-سان، سأحاول إصلاح سيّارتي
Dialogue: 0,0:11:58.34,0:12:00.67,Default,,0000,0000,0000,,توخّ أشدّ الحذر
Dialogue: 0,0:12:00.67,0:12:02.56,Default,,0000,0000,0000,,!ولد! سنرجع
Dialogue: 0,0:12:03.46,0:12:04.69,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:12:10.03,0:12:11.85,Default,,0000,0000,0000,,قلادة فوميكو-سان
Dialogue: 0,0:12:19.44,0:12:20.64,Default,,0000,0000,0000,,فوميكو-سان
Dialogue: 0,0:12:20.98,0:12:23.61,Default,,0000,0000,0000,,!اصمت! أنا مشغولة الآن
Dialogue: 0,0:12:23.86,0:12:25.57,Default,,0000,0000,0000,,أتبحثين عن هذه؟
Dialogue: 0,0:12:28.26,0:12:29.23,Default,,0000,0000,0000,,!أعدها
Dialogue: 0,0:12:39.46,0:12:44.61,Default,,0000,0000,0000,,شكراً لك يا فتى، هذه أغلى شيءٍ عليّ
Dialogue: 0,0:12:45.17,0:12:46.32,Default,,0000,0000,0000,,حبيبك؟
Dialogue: 0,0:12:47.45,0:12:54.61,Default,,0000,0000,0000,,...مات قبل خمسة أعوام، انتحار\Nكلا، كان كأنّه تعرّض للقتل
Dialogue: 0,0:12:55.61,0:12:59.23,Default,,0000,0000,0000,,!من قِبل أبي، هوتّا كوساكو
Dialogue: 0,0:13:00.82,0:13:04.60,Default,,0000,0000,0000,,لذا غادرتُ البيت، لم أستطع مسامحة أبي
Dialogue: 0,0:13:05.64,0:13:12.50,Default,,0000,0000,0000,,آسفة، لا جدوى من إخبار هذا لفتى صغير
Dialogue: 0,0:13:18.13,0:13:21.05,Default,,0000,0000,0000,,كانت فوميكو-سان تكنّ ضغينةً لهوتّا-سان
Dialogue: 0,0:13:21.05,0:13:26.51,Default,,0000,0000,0000,,لكن هل كان لديها فرصة\Nزرع القنبلة بصندوق الويسكي؟
Dialogue: 0,0:13:30.91,0:13:31.81,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:13:31.81,0:13:34.02,On Top,,0000,0000,0000,,سماد كيميائي
Dialogue: 0,0:13:32.58,0:13:36.59,Default,,0000,0000,0000,,...سماد كيميائي؟ أيمكن أنّ القنبلة كانت
Dialogue: 0,0:13:41.36,0:13:42.27,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:13:42.27,0:13:46.47,On Top,,0000,0000,0000,,كبريت
Dialogue: 0,0:13:43.03,0:13:46.47,Default,,0000,0000,0000,,كبريت ومواد كيميائية، كما ذاك السماد الكيميائي
Dialogue: 0,0:13:47.14,0:13:49.89,Default,,0000,0000,0000,,!لا شكّ في الأمر، القاتل هو ذاك الشخص
Dialogue: 0,0:13:55.23,0:13:56.19,Default,,0000,0000,0000,,...هذا الشخص
Dialogue: 0,0:14:05.33,0:14:06.93,Default,,0000,0000,0000,,هل أصلحتها؟
Dialogue: 0,0:14:08.44,0:14:09.83,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:14:09.83,0:14:12.79,Default,,0000,0000,0000,,إنّها سيّارة قديمة بالفعل
Dialogue: 0,0:14:12.79,0:14:15.39,Default,,0000,0000,0000,,كانت أوّل سيّارة صممتُها
Dialogue: 0,0:14:15.39,0:14:17.52,Default,,0000,0000,0000,,كنت مصمّم سيّارات؟
Dialogue: 0,0:14:17.88,0:14:20.65,Default,,0000,0000,0000,,أجل، حتّى قبل خمسة أعوام
Dialogue: 0,0:14:20.65,0:14:22.85,Default,,0000,0000,0000,,استقلتُ بعد حادثة
Dialogue: 0,0:14:22.85,0:14:25.56,Default,,0000,0000,0000,,!أوّل مرّة أرى سيّارة كهذه
Dialogue: 0,0:14:27.78,0:14:31.98,Default,,0000,0000,0000,,...ماذا؟ إنّها سيّارة قديمة الطراز لكن بها كيس هوائي
Dialogue: 0,0:14:32.60,0:14:36.13,Default,,0000,0000,0000,,كونان-كن، هلّا ناديت فوميكو-سان؟
Dialogue: 0,0:14:36.13,0:14:37.18,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:14:37.68,0:14:43.15,Default,,0000,0000,0000,,لاستدعاء الشرطة، الجميع يشعرون بالقلق \Nبوجود موري-سان وحده، صحيح؟
Dialogue: 0,0:14:44.18,0:14:45.35,Default,,0000,0000,0000,,ماذا عنك؟
Dialogue: 0,0:14:46.42,0:14:50.33,Default,,0000,0000,0000,,أنا المدبّر، أحمل مسؤولية البقاء هنا
Dialogue: 0,0:14:50.33,0:14:51.65,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:14:55.28,0:14:57.77,Default,,0000,0000,0000,,!وقت الطعام
Dialogue: 0,0:14:59.32,0:15:00.66,Default,,0000,0000,0000,,أين كونان-كن؟
Dialogue: 0,0:15:00.66,0:15:03.11,Default,,0000,0000,0000,,يلعب في مكانٍ ما غالباً
Dialogue: 0,0:15:03.11,0:15:06.68,Default,,0000,0000,0000,,لا مفرّ، سأذهب للبحث عنه
Dialogue: 0,0:15:08.15,0:15:09.18,Default,,0000,0000,0000,,...طعامي
Dialogue: 0,0:15:12.65,0:15:18.02,Default,,0000,0000,0000,,لا حاجة لأن تُصدم، فقد كانت الصورة في غرفتك
Dialogue: 0,0:15:18.84,0:15:22.23,Default,,0000,0000,0000,,أدخلت غرفتي بلا إذن؟
Dialogue: 0,0:15:22.23,0:15:25.51,Default,,0000,0000,0000,,وجدتُ أشياء مثيرة للاهتمام هناك
Dialogue: 0,0:15:25.96,0:15:30.44,Default,,0000,0000,0000,,كبريت ومواد كيميائية أخرى مخبّأة في خزانة
Dialogue: 0,0:15:30.67,0:15:35.62,Default,,0000,0000,0000,,لم يكن الانفجار بفعل ديناميت، بل قنبلة معدّة يدوياً
Dialogue: 0,0:15:35.62,0:15:39.81,Default,,0000,0000,0000,,!من سماد كيميائي وكبريت ومواد كيميائية أخرى
Dialogue: 0,0:15:40.28,0:15:42.04,Default,,0000,0000,0000,,يمكنك صنع قنبلة من أشياء كهذه؟
Dialogue: 0,0:15:42.04,0:15:43.52,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:15:43.52,0:15:50.48,Default,,0000,0000,0000,,إن مزجتها بطريقة ما، يمكنها إنتاج انفجار\Nلا يقلّ قوّةً عن الديناميت
Dialogue: 0,0:15:50.94,0:15:56.18,Default,,0000,0000,0000,,!سخافة! لمَ قد أقتل سيّد المنزل؟
Dialogue: 0,0:15:56.18,0:16:01.69,Default,,0000,0000,0000,,كانت هذه الحادثة انتقاماً للشخص في الصورة
Dialogue: 0,0:16:02.10,0:16:06.35,Default,,0000,0000,0000,,دفعه هوتّا-سان للإقدام على الانتحار قبل 5 أعوام
Dialogue: 0,0:16:07.31,0:16:12.02,Default,,0000,0000,0000,,وكان ابنك يا ياماوتشي-سان
Dialogue: 0,0:16:13.42,0:16:16.37,Default,,0000,0000,0000,,كنتَ من أخذ الويسكي الذي جلبه ريوجي-سان
Dialogue: 0,0:16:16.37,0:16:19.64,Default,,0000,0000,0000,,وأوصله لغرفة هوتّا-سان
Dialogue: 0,0:16:20.08,0:16:27.65,Default,,0000,0000,0000,,وضعت آنذاك القنبلة يدوية الصنع داخل الصندوق
Dialogue: 0,0:16:27.65,0:16:29.68,Default,,0000,0000,0000,,أضفت مُشعِلاً تحت الغطاء
Dialogue: 0,0:16:29.68,0:16:33.94,Default,,0000,0000,0000,,كما فسفوراً سريع الاشتعال في القنبلة
Dialogue: 0,0:16:33.94,0:16:37.97,Default,,0000,0000,0000,,كان الأمر أشبه بإشعال عود ثقاب
Dialogue: 0,0:16:38.31,0:16:42.40,Default,,0000,0000,0000,,لكن لم يُفترض أن تكون جريمةً مثالية
Dialogue: 0,0:16:42.40,0:16:46.21,Default,,0000,0000,0000,,فقد كنتَ بحاجة لإبعاد نفسك عن الشبهة
Dialogue: 0,0:16:46.21,0:16:48.35,Default,,0000,0000,0000,,حتّى جريمتك التالية
Dialogue: 0,0:16:48.59,0:16:50.35,Default,,0000,0000,0000,,جريمته التالية؟
Dialogue: 0,0:16:52.85,0:16:54.27,Default,,0000,0000,0000,,فوميكو-سان؟
Dialogue: 0,0:16:58.20,0:17:01.98,Default,,0000,0000,0000,,كما يُتوقع منك يا موري-سان، الأمر كما استنتجته
Dialogue: 0,0:17:05.86,0:17:10.52,Default,,0000,0000,0000,,كان ابني كينتارو عازف بيانو موهوب بمستقبل لامع
Dialogue: 0,0:17:11.36,0:17:15.56,Default,,0000,0000,0000,,واعد فتاةً أحبّها لوقت طويل، لكن لم يستطع التقدّم لخطبتها
Dialogue: 0,0:17:15.56,0:17:18.23,Default,,0000,0000,0000,,بسبب دخله الماليّ الضئيل
Dialogue: 0,0:17:19.27,0:17:25.68,Default,,0000,0000,0000,,لكنّه فاز بإحدى المسابقات قبل 5 أعوام\Nونال الاعتراف بموهبته أخيراً
Dialogue: 0,0:17:26.59,0:17:31.90,Default,,0000,0000,0000,,...ثمّ تقدّم كينتارو لخطبة تلك الفتاة، لكن
Dialogue: 0,0:17:32.40,0:17:37.85,Default,,0000,0000,0000,,عارض والد الفتاة الزواج، أي هوتّا-سان
Dialogue: 0,0:17:38.25,0:17:42.12,Default,,0000,0000,0000,,كـ-كانت تلك الفتاة فوميكو-سان إذاً؟
Dialogue: 0,0:17:42.12,0:17:46.56,Default,,0000,0000,0000,,ذهب كينتارو لمقابلة هوتّا لأخذ قبوله بالزواج
Dialogue: 0,0:17:46.56,0:17:52.48,Default,,0000,0000,0000,,لكن لم يرفض هوتّا فحسب، بل سحق أصابعه أيضاً
Dialogue: 0,0:17:55.68,0:18:00.60,Default,,0000,0000,0000,,!كان البيانو حياة كينتارو! وسرقها للأبد
Dialogue: 0,0:18:00.60,0:18:04.82,Default,,0000,0000,0000,,!كما رحلت تلك المرأة وتركته مكسوراً
Dialogue: 0,0:18:05.51,0:18:07.76,Default,,0000,0000,0000,,...لذا المسكين
Dialogue: 0,0:18:20.62,0:18:25.97,Default,,0000,0000,0000,,بعدما عرفت كلّ هذا في جنازته، تملّكتني الصدمة
Dialogue: 0,0:18:26.95,0:18:32.48,Default,,0000,0000,0000,,فقد جهلت حياة ابني تماماً وأنا موظّف شركة
Dialogue: 0,0:18:32.48,0:18:35.97,Default,,0000,0000,0000,,لذا قرّرت الأخذ بثأره
Dialogue: 0,0:18:36.44,0:18:41.10,Default,,0000,0000,0000,,أجل، تحرّيتُ أمر هوتّا بعد الاستقالة
Dialogue: 0,0:18:41.10,0:18:45.97,Default,,0000,0000,0000,,وأصبحت مدبّر منزله الجبلي لأحصل على فرصة الانتقام
Dialogue: 0,0:18:46.51,0:18:52.90,Default,,0000,0000,0000,,،لكنّ فوميكو كانت قد تركت العائلة\Nفاحتجت عامين لتحديد مكانها
Dialogue: 0,0:18:53.22,0:18:58.42,Default,,0000,0000,0000,,ثمّ اخترت حفلة عيد ميلاد هوتّا-سان مسرحاً للانتقام
Dialogue: 0,0:18:58.42,0:19:01.35,Default,,0000,0000,0000,,وأرسلت الدعوة لفوميكو-سان
Dialogue: 0,0:19:01.83,0:19:07.31,Default,,0000,0000,0000,,أجل، لا ندم في حياتي الآن
Dialogue: 0,0:19:07.61,0:19:10.77,Default,,0000,0000,0000,,لكنّ فوميكو-سان بأمان في السيّارة
Dialogue: 0,0:19:11.86,0:19:17.44,Default,,0000,0000,0000,,تحقّق انتقامي حال دخولها السيّارة
Dialogue: 0,0:19:17.44,0:19:20.73,Default,,0000,0000,0000,,فهناك فخّ بها
Dialogue: 0,0:19:20.98,0:19:25.64,Default,,0000,0000,0000,,كيس الهواء معدّ بحيث يخرج\Nعندما تضغط بقوّة على المكابح
Dialogue: 0,0:19:32.89,0:19:34.89,Default,,0000,0000,0000,,...إنّها غالباً الآن
Dialogue: 0,0:19:34.89,0:19:38.21,Default,,0000,0000,0000,,أنتَ جاهل حقاً
Dialogue: 0,0:19:39.10,0:19:42.95,Default,,0000,0000,0000,,لمَ لا تزال فوميكو-سان عزباء للآن برأيك؟
Dialogue: 0,0:19:43.42,0:19:46.68,Default,,0000,0000,0000,,!لأنّها لا تزال تُحب كينتارو-سان
Dialogue: 0,0:19:47.87,0:19:53.44,Default,,0000,0000,0000,,سخافة! امرأة وقحة تبرّأ منها أباها\N!لن تقوم بذلك أبداً
Dialogue: 0,0:19:53.74,0:19:57.90,Default,,0000,0000,0000,,!لم يتبرّأ منها! غادرت البيت من تلقاء نفسها
Dialogue: 0,0:19:57.90,0:20:01.39,Default,,0000,0000,0000,,لم تستطع مسامحة أبيها على ما فعله بكينتارو-سان
Dialogue: 0,0:20:02.77,0:20:05.18,Default,,0000,0000,0000,,!هذه كذبة! هراء
Dialogue: 0,0:20:05.80,0:20:07.89,Default,,0000,0000,0000,,!لقد تخلّت عن كينتارو
Dialogue: 0,0:20:11.30,0:20:12.52,Default,,0000,0000,0000,,ما هذه؟
Dialogue: 0,0:20:14.89,0:20:18.68,Default,,0000,0000,0000,,إنّها كنز فوميكو-سان
Dialogue: 0,0:20:19.38,0:20:22.96,Default,,0000,0000,0000,,كنز مليء بذكرياتها عن كينتارو-سان
Dialogue: 0,0:20:22.96,0:20:26.03,Default,,0000,0000,0000,,ومشاعرها له
Dialogue: 0,0:20:26.03,0:20:30.60,Default,,0000,0000,0000,,كانت فوميكو-سان ترتديه طوال الوقت
Dialogue: 0,0:20:30.60,0:20:36.74,Default,,0000,0000,0000,,!لا تزال ترى كينتارو-سان أغلى شخص لديها يا ياماوتشي-سان
Dialogue: 0,0:20:38.27,0:20:42.32,Default,,0000,0000,0000,,ما... ما الذي فعلتُه؟
Dialogue: 0,0:20:43.57,0:20:47.68,Default,,0000,0000,0000,,...قتلتُ الشخص الذي أحبّ ابني لهذه الدرجة
Dialogue: 0,0:20:56.75,0:21:00.55,Default,,0000,0000,0000,,فوميكو-سان؟ لم يخرج كيس الهواء؟
Dialogue: 0,0:21:00.55,0:21:09.37,Default,,0000,0000,0000,,كلا، طلب موري-سان من كونان-كن\Nأن يخبرني بالعودة فوراً
Dialogue: 0,0:21:09.37,0:21:11.98,Default,,0000,0000,0000,,...فوميكو-سان، أنا
Dialogue: 0,0:21:12.95,0:21:16.93,Default,,0000,0000,0000,,كنتُ أبغض أبي، لحدّ رغبتي بقتله
Dialogue: 0,0:21:18.28,0:21:21.65,Default,,0000,0000,0000,,لكنّي لا أستطيع مسامحة كينتارو-سان أيضاً
Dialogue: 0,0:21:27.35,0:21:33.12,Default,,0000,0000,0000,,...فقد تركني بمفردي، ودفع أبيه لفعل هذا
Dialogue: 0,0:21:34.92,0:21:38.02,Default,,0000,0000,0000,,...إنّه آثم حقاً
Dialogue: 0,0:23:24.57,0:23:27.93,Default,,0000,0000,0000,,كان ريوجي-سان محبوساً في القبو
Dialogue: 0,0:23:32.08,0:23:33.44,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:23:35.09,0:23:38.02,Default,,0000,0000,0000,,ماذا؟ أين ذهب الجميع؟
Dialogue: 0,0:23:38.80,0:23:41.46,Default,,0000,0000,0000,,...أشعر بالجوع
Dialogue: 0,0:23:41.46,0:23:44.97,Default,,0000,0000,0000,,!صحيح! كنا على وشك تناول الإفطار
Dialogue: 0,0:23:45.71,0:23:48.93,Default,,0000,0000,0000,,!ياماوتشي-سان! الإفطار من فضلك
Dialogue: 0,0:23:50.01,0:23:55.12,Default,,0000,0000,0000,,!الجوع يقتلني! لا أمانع أيّ شيء، أسرع وحسب رجاءً
Dialogue: 0,0:23:55.50,0:23:57.24,Default,,0000,0000,0000,,!ياماوتشي-سان
Dialogue: 0,0:24:05.39,0:24:06.63,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:24:10.35,0:24:13.22,Default,,0000,0000,0000,,غريب، هناك أمرٌ ليس في محلّه
Dialogue: 0,0:24:13.22,0:24:14.32,Default,,0000,0000,0000,,يا للغرابة
Dialogue: 0,0:24:15.30,0:24:19.59,Default,,0000,0000,0000,,تغسل مساحيق التجميل قبل وضع قناع الوجه عادةً
Dialogue: 0,0:24:20.00,0:24:24.10,Default,,0000,0000,0000,,فـ-فهمت! ذاك الشخص هو القاتل بالفعل إذاً
Dialogue: 0,0:24:24.70,0:24:26.37,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.37,0:24:29.10,Default,,0000,0000,0000,,جريمة قتل قناع الوجه
Dialogue: 0,0:24:45.66,0:24:48.41,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.41,0:24:50.08,Default,,0000,0000,0000,,أحمر شفاه
Dialogue: 0,0:24:50.28,0:24:52.39,Default,,0000,0000,0000,,!قضيّة الحلقة القادمة فريدة
Dialogue: 0,0:24:52.39,0:24:54.17,Default,,0000,0000,0000,,أأنا جميل؟

