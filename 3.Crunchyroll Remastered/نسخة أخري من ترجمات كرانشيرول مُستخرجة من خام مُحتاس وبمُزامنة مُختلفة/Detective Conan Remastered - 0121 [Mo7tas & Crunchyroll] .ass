Dialogue: 0,0:00:01.48,0:00:04.73,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.73,0:00:06.43,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.81,0:00:07.89,Default,,0000,0000,0000,,!حلقة اليوم عن شقيقتين جميلتين
Dialogue: 0,0:00:08.48,0:00:09.89,Default,,0000,0000,0000,,!تقع قضيّة وراء رسالة احتضار
Dialogue: 0,0:00:10.18,0:00:12.02,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.02,0:00:14.02,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ دماغه لبالغ
Dialogue: 0,0:00:14.02,0:00:16.40,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.81,0:00:24.48,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.48,0:00:31.52,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:33.25,0:00:39.65,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.65,0:00:47.15,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:47.15,0:00:59.61,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.48,0:01:06.90,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.87,0:01:13.75,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.75,0:01:20.15,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:20.15,0:01:27.14,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.30,0:01:57.25,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل الحمّام المغلق\N(الجزء الأوّل)
Dialogue: 0,0:01:51.66,0:01:55.77,Default,,0000,0000,0000,,جريمة قتل الحمّام المغلق\N(الجزء الأوّل)
Dialogue: 0,0:02:18.60,0:02:21.90,On Top,,0000,0000,0000,,آوشيما
Dialogue: 0,0:02:20.23,0:02:21.20,Default,,0000,0000,0000,,!رجعت
Dialogue: 0,0:02:22.26,0:02:25.29,Default,,0000,0000,0000,,ما الذي كنتِ تفعلينه؟ تأخّرتِ
Dialogue: 0,0:02:25.29,0:02:27.53,Default,,0000,0000,0000,,أطلت في متجر التموينات
Dialogue: 0,0:02:27.87,0:02:34.87,CharCard,,0000,0000,0004,,{\fad(300,0)} (آوشيما مينا (24\Nمحاسبة في مركز تسوّق هايدو
Dialogue: 0,0:02:28.33,0:02:32.08,On Top,,0000,0000,0000,,اشتريتُ كلّ الأشياء التي\Nطلبتِها منّي يا أختي
Dialogue: 0,0:02:32.08,0:02:34.87,On Top,,0000,0000,0000,,مطهّر حوض الاستحمام وشريط \Nلاصق وجعّة
Dialogue: 0,0:02:35.12,0:02:41.17,CharCard,,0000,0000,0004,,{\fad(300,0)} (26) آوشيما ماسايو\Nموظّفة في مصرف بيكا
Dialogue: 0,0:02:35.23,0:02:39.36,On Top,,0000,0000,0000,,آسفة، نشيت شراء مطهّر\Nحوض الاستحمام
Dialogue: 0,0:02:39.36,0:02:42.96,On Top,,0000,0000,0000,,ومتجر التموينات بقرب شقّتي\Nقيد التجديد
Dialogue: 0,0:02:43.15,0:02:48.14,Default,,0000,0000,0000,,لكن هل ستأخذينها معكِ حقّاً؟ أشرطة الفيديو\Nلبرنامج الفنّانات الذي كنتِ تسجّلينه
Dialogue: 0,0:02:49.60,0:02:55.60,Default,,0000,0000,0000,,تعايشي مع ذلك، فقد انتقلتُ\Nمن هنا لأجلك
Dialogue: 0,0:02:59.94,0:03:03.48,Default,,0000,0000,0000,,يبدو أنّ هذا يتطلّب جهداً، هل أساعدك؟
Dialogue: 0,0:03:03.48,0:03:10.07,Default,,0000,0000,0000,,هلّا قصصتِ الشريط اللاصق لأجزاء بطول\Nملائم ورتّبتِها على طرف الطاولة إذاً؟
Dialogue: 0,0:03:10.81,0:03:13.65,Default,,0000,0000,0000,,أعتذر على القدوم فجأةً هكذا
Dialogue: 0,0:03:13.65,0:03:15.95,Default,,0000,0000,0000,,وجعلك تساعديني بالتسوّق وحزم الأمتعة
Dialogue: 0,0:03:16.36,0:03:18.76,Default,,0000,0000,0000,,ما الذي تقولينه؟ هذا لا يُستحقّ الذكر
Dialogue: 0,0:03:20.44,0:03:25.23,Default,,0000,0000,0000,,بالمناسبة، عليّ شكرك! قال كينجي-سان\Nأنّه يتطلّع لحفلة الغد
Dialogue: 0,0:03:25.23,0:03:27.31,Default,,0000,0000,0000,,!صحيح، نسيت
Dialogue: 0,0:03:30.31,0:03:32.55,Default,,0000,0000,0000,,...قبل أن نحزم
Dialogue: 0,0:03:32.98,0:03:37.18,Default,,0000,0000,0000,,علينا شرب نخب لأختي الصغيرة\N!الممتلئة سعادةً
Dialogue: 0,0:03:37.28,0:03:40.11,Default,,0000,0000,0000,,لا داعي لتفعلي ذلك
Dialogue: 0,0:03:40.41,0:03:41.91,Default,,0000,0000,0000,,!كلا، كلا
Dialogue: 0,0:03:42.25,0:03:46.41,Default,,0000,0000,0000,,فقد كنتُ مشغولةً مُذ حُدّد زواجكما
Dialogue: 0,0:03:46.41,0:03:49.12,Default,,0000,0000,0000,,فلم أحتفل كما يجب، أليس كذلك؟
Dialogue: 0,0:03:49.12,0:03:52.76,Default,,0000,0000,0000,,لذا هذا أبسط ما يمكن\Nأن تفعله أختك للاحتفال
Dialogue: 0,0:03:55.75,0:03:57.18,Default,,0000,0000,0000,,فلتقبليه رجاءً
Dialogue: 0,0:04:15.67,0:04:17.82,Default,,0000,0000,0000,,!عزيزتي الحسناء يوكو
Dialogue: 0,0:04:18.41,0:04:21.41,Default,,0000,0000,0000,,جمالك جريمةٌ بحدّ ذاته
Dialogue: 0,0:04:21.41,0:04:25.08,Default,,0000,0000,0000,,أمعني النظر في هذه\Nالورود التي سأهديك إيّاها
Dialogue: 0,0:04:25.08,0:04:30.98,Default,,0000,0000,0000,,!كلّها واقعة تحت تأثيرك، ومصبوغة بأحمر فاقع
Dialogue: 0,0:04:33.12,0:04:34.62,Default,,0000,0000,0000,,!أو ما شابه
Dialogue: 0,0:04:36.79,0:04:40.00,Default,,0000,0000,0000,,أرى أنّ النظرة الحمقاء على وجهه\Nهي الأقرب للجريمة
Dialogue: 0,0:04:40.00,0:04:40.81,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:47.75,0:04:52.57,Default,,0000,0000,0000,,لا يفهم الأطفال كلام البالغين\N!المنمّق هذا، صحيح؟
Dialogue: 0,0:04:52.57,0:04:56.45,Default,,0000,0000,0000,,...كلام منمّق
Dialogue: 0,0:05:00.25,0:05:02.91,Default,,0000,0000,0000,,يبدو العمّ في مزاجٍ حسن
Dialogue: 0,0:05:02.91,0:05:06.75,Default,,0000,0000,0000,,أجل، فهنالك حفلة الليلة\Nلأوكينو يوكو-تشان
Dialogue: 0,0:05:07.75,0:05:12.42,Default,,0000,0000,0000,,أليس علينا الذهاب يا أبي؟ إذا لم ندخل\Nفي الصفّ سريعاً، ستكتظّ القاعة
Dialogue: 0,0:05:12.42,0:05:15.58,Default,,0000,0000,0000,,لا داعي للقلق
Dialogue: 0,0:05:15.58,0:05:20.85,Default,,0000,0000,0000,,إذا أرينا موظّف التذاكر هذه التذاكر الموقّعة\N،التي أعطتنا إيّاها يوكو-تشان
Dialogue: 0,0:05:20.85,0:05:24.41,Default,,0000,0000,0000,,...فسنستطيع الدخول من الباب الخلفـ
Dialogue: 0,0:05:26.00,0:05:26.81,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:33.41,0:05:34.78,Default,,0000,0000,0000,,!ما الخطب يا أبي؟
Dialogue: 0,0:05:35.66,0:05:39.70,Default,,0000,0000,0000,,!يوجد ثقب
Dialogue: 0,0:05:41.95,0:05:44.33,Default,,0000,0000,0000,,!أيمكن أنّك أسقطتها؟
Dialogue: 0,0:05:44.33,0:05:46.55,Default,,0000,0000,0000,,!ليست هنا! ليست هنا! ليست هنا
Dialogue: 0,0:05:46.55,0:05:47.26,Default,,0000,0000,0000,,!ليست موجودة
Dialogue: 0,0:05:47.26,0:05:49.92,Default,,0000,0000,0000,,!أين ذهبت؟ عزيزتي يوكو-تشان
Dialogue: 0,0:05:50.07,0:05:55.21,Default,,0000,0000,0000,,أليست في دورة المياه؟\Nفقد دخلتها فور وصولك هنا
Dialogue: 0,0:05:57.15,0:05:58.72,Default,,0000,0000,0000,,لا بدّ أنّها هناك
Dialogue: 0,0:05:58.90,0:06:01.56,Default,,0000,0000,0000,,دورة المياه! دورة المياه! لا بدّ\N!أنّها هناك! دورة المياه
Dialogue: 0,0:06:10.29,0:06:12.62,Default,,0000,0000,0000,,إذاً؟ هل وجدتها؟
Dialogue: 0,0:06:12.62,0:06:14.04,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:06:14.04,0:06:15.46,Default,,0000,0000,0000,,...البتّة
Dialogue: 0,0:06:16.46,0:06:20.41,Default,,0000,0000,0000,,لا تقلق، أنا متأكّدة أنّهم سيدخلوننا\Nإذا شرحنا الوضع
Dialogue: 0,0:06:20.79,0:06:22.12,Default,,0000,0000,0000,,!يا حمقاء
Dialogue: 0,0:06:22.12,0:06:25.97,Default,,0000,0000,0000,,كيف أستطيع جعل نفسي أبدو بذاك\N!المنظر الساذج وأنا أحمل باقة ورود؟
Dialogue: 0,0:06:26.75,0:06:27.87,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:06:28.66,0:06:33.12,Default,,0000,0000,0000,,وفقما أذكر، فقد قلتِ أنّ لديكِ\Nاختبارات نصفيّة الأسبوع القادم، صحيح؟
Dialogue: 0,0:06:33.12,0:06:34.41,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:34.41,0:06:40.08,Default,,0000,0000,0000,,!فلتعطني تذكرتكِ إذاً، وارجعي للبيت وادرسي
Dialogue: 0,0:06:40.08,0:06:41.09,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:06:41.58,0:06:44.80,Default,,0000,0000,0000,,..وجدتُها! لنقل أنّ من أسقط التذكرة
Dialogue: 0,0:06:45.21,0:06:47.31,Default,,0000,0000,0000,,مهلك، أبي
Dialogue: 0,0:06:47.62,0:06:51.83,Default,,0000,0000,0000,,أجل، أجل، لنقل أنّ كونان كان\N...من أسقط التذكرة
Dialogue: 0,0:06:51.83,0:06:53.44,Default,,0000,0000,0000,,!يكفي هذا
Dialogue: 0,0:06:53.44,0:06:55.37,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:06:55.37,0:06:58.66,Default,,0000,0000,0000,,ما قصدك بأنّك لن تستطيع\N!القدوم يا كينجي؟
Dialogue: 0,0:06:58.66,0:07:01.99,Default,,0000,0000,0000,,!زكام؟! سيزول إذا شاهدت الحفلة
Dialogue: 0,0:07:02.41,0:07:04.91,Default,,0000,0000,0000,,أنت تعرف كم عانيت
Dialogue: 0,0:07:04.91,0:07:07.70,Default,,0000,0000,0000,,لأجل الحصول على تذاكر\N!حفلة لأوكينو يوكو
Dialogue: 0,0:07:08.21,0:07:13.58,Default,,0000,0000,0000,,تعال فوراً بأيّ حال! فقد اتّفقت مع أختي\N!بأن نذهب للقاعة بسيّارتك
Dialogue: 0,0:07:14.79,0:07:16.61,Default,,0000,0000,0000,,ماذا؟ لا تستطيع؟
Dialogue: 0,0:07:17.70,0:07:19.38,Default,,0000,0000,0000,,لحظة، كينجي؟
Dialogue: 0,0:07:19.38,0:07:20.45,Default,,0000,0000,0000,,كينجي؟
Dialogue: 0,0:07:21.29,0:07:24.00,Default,,0000,0000,0000,,!يا إلهي، عديم الفائدة هذا
Dialogue: 0,0:07:25.83,0:07:26.72,Default,,0000,0000,0000,,...المعذرة
Dialogue: 0,0:07:26.72,0:07:28.21,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:07:28.21,0:07:31.94,Default,,0000,0000,0000,,ألديكِ تذكرة إضافيّة لحفلة الليلة؟
Dialogue: 0,0:07:32.72,0:07:35.00,Default,,0000,0000,0000,,حفلة أوكينو يوكو-تشان
Dialogue: 0,0:07:35.00,0:07:36.11,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:07:36.58,0:07:41.37,Default,,0000,0000,0000,,في تلك الحالة، أيمكنك بيعها لي بثمنٍ منخفض؟
Dialogue: 0,0:07:41.37,0:07:43.21,Default,,0000,0000,0000,,!لحظة يا أبي
Dialogue: 0,0:07:43.21,0:07:47.25,Default,,0000,0000,0000,,،يمكن أن يدخلونك إذا شرحت الوضع\Nلا داعي لأن تشتري تذكرة
Dialogue: 0,0:07:47.25,0:07:52.96,Default,,0000,0000,0000,,اخرسي! لا يمكن مقايضة\N!فخر الرجل بالمال
Dialogue: 0,0:07:52.96,0:07:54.41,Default,,0000,0000,0000,,...يا لتفاخرك
Dialogue: 0,0:07:54.41,0:07:55.58,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:07:56.54,0:08:00.63,Default,,0000,0000,0000,,لم تسقط تذكرتك في السيّارة أيضاً
Dialogue: 0,0:08:00.93,0:08:02.76,Default,,0000,0000,0000,,فـ-فهمت
Dialogue: 0,0:08:04.25,0:08:08.91,Default,,0000,0000,0000,,إذاً، بكم ستبيعينها لي؟
Dialogue: 0,0:08:08.91,0:08:11.93,Default,,0000,0000,0000,,لا، لا، تبدو في مشكلة\Nفسأمنحك إيّاها بالمجّان
Dialogue: 0,0:08:12.33,0:08:14.54,Default,,0000,0000,0000,,بالمجّان؟
Dialogue: 0,0:08:14.54,0:08:17.27,Default,,0000,0000,0000,,بالمجّان؟! حقّاً؟
Dialogue: 0,0:08:17.40,0:08:24.12,Default,,0000,0000,0000,,أجل، لكن بالمقابل، أيمكنني طلب\Nمعروف واحد منك؟
Dialogue: 0,0:08:24.24,0:08:26.20,Default,,0000,0000,0000,,!أجل! أيّ شيء
Dialogue: 0,0:08:26.83,0:08:29.00,Default,,0000,0000,0000,,ما خطب العمّ؟
Dialogue: 0,0:08:29.00,0:08:32.91,Default,,0000,0000,0000,,ظننتُ أنّ فخره الرجوليّ كان يحكم\Nسلوكه، لكن يبدو أنّ الأمر لم يهم
Dialogue: 0,0:08:36.00,0:08:38.29,Default,,0000,0000,0000,,أعتذر على طلبي هذا
Dialogue: 0,0:08:38.62,0:08:44.00,Default,,0000,0000,0000,,البتّة، سنذهب لاصطحاب شقيقتك\Nمعنا بالسيّارة لا أكثر
Dialogue: 0,0:08:44.00,0:08:46.50,Default,,0000,0000,0000,,!من الحسن أنّنا استأجرنا سيّارة
Dialogue: 0,0:08:46.50,0:08:51.87,Default,,0000,0000,0000,,أجل، كان لديّ عمل في مكان\Nبعيد هذا الصباح، فحالفنا الحظّ
Dialogue: 0,0:08:51.87,0:08:54.64,Default,,0000,0000,0000,,لكن ما خطب مينا يا ترى؟
Dialogue: 0,0:08:55.12,0:09:00.98,Default,,0000,0000,0000,,،كانت تتطلّع لحفلة الليلة كثيراً\Nلكن لم تأتي لمكاننا المتّفق حتّى
Dialogue: 0,0:09:01.33,0:09:03.41,Default,,0000,0000,0000,,أجرّبتِ الاتّصال بها؟
Dialogue: 0,0:09:03.41,0:09:06.42,Default,,0000,0000,0000,,أجل، لكنّها لم تجب
Dialogue: 0,0:09:06.42,0:09:09.08,Default,,0000,0000,0000,,ولم تعمل آلة الردّ
Dialogue: 0,0:09:09.08,0:09:11.91,Default,,0000,0000,0000,,آمل أنّ أمراً غريباً لم يحصل لها
Dialogue: 0,0:09:11.91,0:09:13.16,Default,,0000,0000,0000,,أمر غريب؟
Dialogue: 0,0:09:13.16,0:09:17.62,Default,,0000,0000,0000,,كانت أختي غريبة نوعاً ما مؤخراً
Dialogue: 0,0:09:17.62,0:09:20.79,Default,,0000,0000,0000,,تشعر بإحباط مُذ حُدّد زواجها
Dialogue: 0,0:09:20.79,0:09:23.17,Default,,0000,0000,0000,,وتبكي أحياناً بلا سبب
Dialogue: 0,0:09:23.17,0:09:27.63,Default,,0000,0000,0000,,لذا دعوتها لحفلة الليلة\Nللترويح عن نفسها
Dialogue: 0,0:09:29.54,0:09:32.10,Default,,0000,0000,0000,,...بالمناسبة، كنتُ أتساءل لفترة
Dialogue: 0,0:09:32.62,0:09:36.43,Default,,0000,0000,0000,,...أيمكن أنّ العصابة على رأسك
Dialogue: 0,0:09:38.37,0:09:40.08,Default,,0000,0000,0000,,إنّها العصابة التي تأتي
Dialogue: 0,0:09:40.08,0:09:43.79,Default,,0000,0000,0000,,مع الإصدار الأوّل الخاص لألبوم\Nيوكو-تشان الذي صدر بالأمس
Dialogue: 0,0:09:43.79,0:09:45.94,Default,,0000,0000,0000,,!كانت يوكو-تشان بالفعل إذاً
Dialogue: 0,0:09:46.66,0:09:49.25,Default,,0000,0000,0000,,...من المذهل حصولك على شيءٍ كهذا
Dialogue: 0,0:09:49.25,0:09:50.41,Default,,0000,0000,0000,,!يا لحظّك
Dialogue: 0,0:09:50.51,0:09:54.10,Default,,0000,0000,0000,,ماذا؟ أنتم معجبون، لكن لم تشتروه؟
Dialogue: 0,0:09:54.10,0:09:57.29,Default,,0000,0000,0000,,!تأتي معها حاملة مفاتيح أيضاً
Dialogue: 0,0:09:58.68,0:10:04.10,Default,,0000,0000,0000,,،تعطينا أقراصها كلّها بنفسها\Nفلا نحصل على إضافات
Dialogue: 0,0:10:04.23,0:10:08.57,Default,,0000,0000,0000,,!ماذا؟! بنفسها؟! تعرفون يوكو-تشان؟
Dialogue: 0,0:10:09.14,0:10:12.15,Default,,0000,0000,0000,,أجل، التقينا في قضيّةٍ ما
Dialogue: 0,0:10:12.15,0:10:13.86,Default,,0000,0000,0000,,قـ-قضيّة؟
Dialogue: 0,0:10:14.13,0:10:19.83,Default,,0000,0000,0000,,أجل، فاسمي موري كوغورو\Nوأعمل متحرّياً
Dialogue: 0,0:10:24.31,0:10:25.92,Default,,0000,0000,0000,,أهنالك خطبٌ ما؟
Dialogue: 0,0:10:27.28,0:10:33.01,Default,,0000,0000,0000,,!لا، أعرف اسمك فحسب \N...أنت شخصيّة ذائعة الصيت، لذا
Dialogue: 0,0:10:34.06,0:10:37.18,Default,,0000,0000,0000,,لا، ليس بذاك الحدّ
Dialogue: 0,0:10:48.88,0:10:51.03,Default,,0000,0000,0000,,منزل مستقلّ؟
Dialogue: 0,0:10:52.18,0:10:55.01,Default,,0000,0000,0000,,أتعيش أختك الصغيرة هنا بمفردها؟
Dialogue: 0,0:10:55.01,0:10:59.97,Default,,0000,0000,0000,,كلّا، كنّا نعيش سويّاً\Nحتّى الأسبوع الفائت
Dialogue: 0,0:10:59.97,0:11:05.21,Default,,0000,0000,0000,,ستعيش مع خطيبها هنا ابتداءً\Nمن الشهر القادم، فانتقلت
Dialogue: 0,0:11:07.56,0:11:09.63,Default,,0000,0000,0000,,يبدو أنّ حذاءها هنا
Dialogue: 0,0:11:10.60,0:11:12.59,Default,,0000,0000,0000,,لا بدّ أنّها لا تزال نائمة
Dialogue: 0,0:11:12.85,0:11:19.76,Default,,0000,0000,0000,,،سأذهب لاستدعائها إذاً\Nيمكنكم الاسترخاء في غرفة المعيشة
Dialogue: 0,0:11:20.78,0:11:22.10,Default,,0000,0000,0000,,...لكن الوقت
Dialogue: 0,0:11:22.43,0:11:23.70,Default,,0000,0000,0000,,!لن أطيل
Dialogue: 0,0:11:24.68,0:11:27.02,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:11:28.01,0:11:32.51,Default,,0000,0000,0000,,مهلكم، تبقّت ساعة على فتح القاعة
Dialogue: 0,0:11:32.51,0:11:35.57,Default,,0000,0000,0000,,هوّن عليك، لا داعي للعجلة
Dialogue: 0,0:11:37.29,0:11:38.68,Default,,0000,0000,0000,,!ما هذا؟
Dialogue: 0,0:11:38.68,0:11:41.78,Default,,0000,0000,0000,,!الغرفة مليئة بملصقات الفنّانين
Dialogue: 0,0:11:42.14,0:11:47.35,Default,,0000,0000,0000,,يوكو-تشان وأنزاي أسوكا\N...وتو-ميكس وهوشينو تيرومي
Dialogue: 0,0:11:47.35,0:11:51.79,Default,,0000,0000,0000,,!مذهل! توجد ليكس قبل انفصالها حتّى
Dialogue: 0,0:11:52.18,0:11:54.71,Default,,0000,0000,0000,,أنت المذهل بمعرفتك لهذا القدر منهم
Dialogue: 0,0:11:55.51,0:11:59.47,Default,,0000,0000,0000,,يبدو أنّ ماسايو-سان تحبّ الفنّانين حقّاً
Dialogue: 0,0:11:59.98,0:12:04.21,Default,,0000,0000,0000,,لا بدّ أنّ أختها عانت بالعيش معها
Dialogue: 0,0:12:04.21,0:12:06.59,Default,,0000,0000,0000,,يبدو أنّهما كانتا معجبتين الاثنتين
Dialogue: 0,0:12:07.09,0:12:11.42,Default,,0000,0000,0000,,انظر، توجد نسختان من كلّ شيء\Nحتّى الكتب المصوّرة والأقراص المدمجة
Dialogue: 0,0:12:11.42,0:12:13.64,Default,,0000,0000,0000,,كما عليها اسماهما
Dialogue: 0,0:12:13.64,0:12:18.30,Default,,0000,0000,0000,,لكن لمَ لم تأخذها ماسايو-سان\Nمعها عندما انتقلت؟
Dialogue: 0,0:12:18.30,0:12:22.38,Default,,0000,0000,0000,,لا بدّ أنّ العدد كبيرٌ جدّاً\Nفلم تستطع حملها سويّاً
Dialogue: 0,0:12:22.38,0:12:27.03,Default,,0000,0000,0000,,انظري، لا يزال يوجد هذا العدد\Nمن صناديق الانتقال
Dialogue: 0,0:12:28.09,0:12:29.88,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:12:31.55,0:12:33.02,Default,,0000,0000,0000,,ما-ما هذا؟
Dialogue: 0,0:12:32.89,0:12:34.41,On Top,,0000,0000,0000,,!مينا! مينا
Dialogue: 0,0:12:35.26,0:12:35.97,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:12:35.97,0:12:37.05,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:37.05,0:12:38.42,On Top,,0000,0000,0000,,!أعرف أنّك هنا
Dialogue: 0,0:12:38.71,0:12:39.67,Default,,0000,0000,0000,,!أهناك خطبٌ ما؟
Dialogue: 0,0:12:40.59,0:12:41.34,Default,,0000,0000,0000,,هنا
Dialogue: 0,0:12:40.76,0:12:41.34,On Top,,0000,0000,0000,,!مينا
Dialogue: 0,0:12:43.86,0:12:47.82,On Top,,0000,0000,0000,,"وداعاً"
Dialogue: 0,0:12:43.96,0:12:45.84,Default,,0000,0000,0000,,!مينا! مينا
Dialogue: 0,0:12:47.63,0:12:49.34,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:12:55.43,0:12:58.09,Default,,0000,0000,0000,,!أيمكن أنّها مقفلة من الداخل؟
Dialogue: 0,0:12:58.09,0:13:01.11,Default,,0000,0000,0000,,كلا، لا قفل على هذا الباب
Dialogue: 0,0:13:01.55,0:13:04.57,Default,,0000,0000,0000,,!يبدو أنّه مغلق بشريط لاصق من الداخل
Dialogue: 0,0:13:07.61,0:13:10.07,Default,,0000,0000,0000,,!حسناً! لندفعه جميعاً
Dialogue: 0,0:13:10.63,0:13:12.03,Default,,0000,0000,0000,,...استعداد
Dialogue: 0,0:13:17.80,0:13:19.08,Default,,0000,0000,0000,,...مينا
Dialogue: 0,0:13:32.80,0:13:35.22,Default,,0000,0000,0000,,ا-انتحار؟
Dialogue: 0,0:13:37.25,0:13:40.16,Default,,0000,0000,0000,,!ران! الشرطة! اتّصلي بالشرطة
Dialogue: 0,0:13:40.16,0:13:41.54,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:13:41.54,0:13:45.62,Default,,0000,0000,0000,,أ-أختي... أيمكن إنقاذها؟
Dialogue: 0,0:13:45.62,0:13:48.12,Default,,0000,0000,0000,,...للأسف، توقّف تنفسها
Dialogue: 0,0:13:48.12,0:13:49.44,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:13:50.33,0:13:55.23,Default,,0000,0000,0000,,باب الحمّام والنافذة موصدان بالشريط اللاصق
Dialogue: 0,0:13:55.75,0:14:01.58,Default,,0000,0000,0000,,وعلى الأرض علبتيّ مطهّر حوض استحمام\Nمفتوحتين مختلفتيّ الصنف
Dialogue: 0,0:14:01.58,0:14:03.41,Default,,0000,0000,0000,,أهو انتحار حقّاً؟
Dialogue: 0,0:14:04.16,0:14:08.04,Default,,0000,0000,0000,,...لكنّها تحيّرني، آثار القطع هذه على معصمها
Dialogue: 0,0:14:12.25,0:14:14.38,Default,,0000,0000,0000,,!كلا، ليس صحيحاً
Dialogue: 0,0:14:14.38,0:14:17.92,Default,,0000,0000,0000,,!هذا ليس انتحاراً، بل جريمة قتل
Dialogue: 0,0:14:18.91,0:14:22.89,Default,,0000,0000,0000,,...لكن لا أفهم، كيف استطاع
Dialogue: 0,0:14:23.75,0:14:27.71,Default,,0000,0000,0000,,كيف استطاع القاتل مغادرة الحمّام؟
Dialogue: 0,0:14:27.71,0:14:32.90,Default,,0000,0000,0000,,مغادرة هذا الحيّز الموصد بالشريط اللاصق؟
Dialogue: 0,0:14:39.24,0:14:43.23,Default,,0000,0000,0000,,المُتوفاة هي آوشيما مينا-سان، 24 عاماً
Dialogue: 0,0:14:43.23,0:14:46.95,Default,,0000,0000,0000,,كان سبب الوفاة هو فقدان الدم \Nالناتج من قطع
Dialogue: 0,0:14:46.95,0:14:49.74,Default,,0000,0000,0000,,الشريان الزنديّ على معصمها الأيسر
Dialogue: 0,0:14:49.74,0:14:54.70,Default,,0000,0000,0000,,،ومن اكتشفت جثّتها كانت أختها\Nأنت يا ماسايو-سان، صحيح؟
Dialogue: 0,0:14:54.99,0:14:56.12,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:14:56.61,0:15:01.03,Default,,0000,0000,0000,,...ومن صادف وجوده هنا مُجدداً، كالمعتاد
Dialogue: 0,0:15:01.38,0:15:04.11,Default,,0000,0000,0000,,!أنا، موري كوغورو
Dialogue: 0,0:15:04.11,0:15:06.28,Default,,0000,0000,0000,,حضرة المفتّش ميغوري
Dialogue: 0,0:15:06.28,0:15:11.22,Default,,0000,0000,0000,,في الواقع، طلبت منّي ماسايو-سان\Nالقدوم لاصطحاب مينا-سان بالسيّارة
Dialogue: 0,0:15:11.53,0:15:14.33,Default,,0000,0000,0000,,لاحظنا أمراً غريباً في غرفة\Nحوض الاستحمام، فدخلنا
Dialogue: 0,0:15:15.41,0:15:20.60,Default,,0000,0000,0000,,بالغريب، تقصد هذا الشريط اللاصق\Nعلى الباب والنافذة، صحيح؟
Dialogue: 0,0:15:20.60,0:15:26.78,Default,,0000,0000,0000,,أجل، كان المكان موصداً بعناية بالشريط\Nاللاصق من الداخل، فكانت غرفة مغلقة
Dialogue: 0,0:15:26.78,0:15:29.57,Default,,0000,0000,0000,,لا شكّ بأنّه انتحار
Dialogue: 0,0:15:29.57,0:15:33.99,Default,,0000,0000,0000,,لكن، لمَ يُقدم شخص على وشك\Nقطع معصمه والانتحار
Dialogue: 0,0:15:33.99,0:15:36.49,Default,,0000,0000,0000,,بإغلاق المكان بإحكام هكذا؟
Dialogue: 0,0:15:36.49,0:15:41.95,Default,,0000,0000,0000,,لا بدّ أنّ السبب هو صدور\Nغاز كلوريّ سام
Dialogue: 0,0:15:41.95,0:15:45.20,Default,,0000,0000,0000,,عند خلط مطهّر كلور ومطّهر حمضي
Dialogue: 0,0:15:45.20,0:15:48.01,Default,,0000,0000,0000,,فأحكمت إغلاق المكان\Nكيلا يتسرّب الغاز
Dialogue: 0,0:15:48.61,0:15:52.74,Default,,0000,0000,0000,,لكن يا موري-كن، كلاهما كلوريّان
Dialogue: 0,0:15:52.74,0:15:58.14,Default,,0000,0000,0000,,كما أنّ غاز الكلور ليس بتلك الخطورة\Nبحيث تحكم إغلاق الحجرة
Dialogue: 0,0:15:58.45,0:16:04.07,Default,,0000,0000,0000,,حضرة المفتّش، لم تكن مينا-سان\Nالمتوفّاة محترفة مثلنا
Dialogue: 0,0:16:04.07,0:16:07.07,Default,,0000,0000,0000,,لا بدّ أنّها كانت تجهل\Nقوّة غاز الكلور
Dialogue: 0,0:16:07.07,0:16:08.95,Default,,0000,0000,0000,,...مع ذلك
Dialogue: 0,0:16:08.95,0:16:14.24,Default,,0000,0000,0000,,كما أنّي أعتقد أنّ مينا-سان كانت\N!في حالة ارتباك قبل إقدامها على الانتحار
Dialogue: 0,0:16:15.03,0:16:17.61,Default,,0000,0000,0000,,أي هذا ما حصل
Dialogue: 0,0:16:17.61,0:16:22.20,Default,,0000,0000,0000,,حضّرت صنفي مطهّر حوض استحمام للانتحار
Dialogue: 0,0:16:22.20,0:16:24.74,Default,,0000,0000,0000,,وأغلقت حجرة حوض الاستحمام هذه
Dialogue: 0,0:16:24.74,0:16:28.95,Default,,0000,0000,0000,,لكن عندما حاولت إطلاق الغاز، أدركت أنّها
Dialogue: 0,0:16:28.95,0:16:33.16,Default,,0000,0000,0000,,أخطأت في اختيار المطهّر
Dialogue: 0,0:16:33.16,0:16:37.78,Default,,0000,0000,0000,,لم يكن لديها خيارٌ آخر، فقطعت معصمها\Nبالشفرة عند الحوض
Dialogue: 0,0:16:37.78,0:16:41.12,Default,,0000,0000,0000,,وتركت جرحها في ماءٍ دافئ\Nحتّى لا يتوقّف النزيف
Dialogue: 0,0:16:42.49,0:16:44.99,Default,,0000,0000,0000,,حضرة المفتّش، انظر لهذا
Dialogue: 0,0:16:44.99,0:16:47.95,Default,,0000,0000,0000,,وجدتُ هذا الإيصال في غرفة المعيشة
Dialogue: 0,0:16:47.95,0:16:51.53,Default,,0000,0000,0000,,اشترت مينا-سان مطهريّ الحوض والشريط اللاصق
Dialogue: 0,0:16:51.53,0:16:54.66,Default,,0000,0000,0000,,من متجر التموينات البارحة
Dialogue: 0,0:16:55.66,0:16:59.33,Default,,0000,0000,0000,,إنّه دليلٌ على تحضيرها في عجلة من أمرها\Nبعدما قرّرت الانتحار
Dialogue: 0,0:16:59.66,0:17:01.24,Default,,0000,0000,0000,,!تاكاغي-كن، تعال
Dialogue: 0,0:17:01.24,0:17:01.56,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:17:02.11,0:17:04.45,Default,,0000,0000,0000,,اذهب لمتجر التموينات وتحقّق من هذا
Dialogue: 0,0:17:04.45,0:17:05.82,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:17:08.57,0:17:12.57,Default,,0000,0000,0000,,وجدنا لفافة الشريط اللاصق أسفل الحوض
Dialogue: 0,0:17:13.28,0:17:19.45,Default,,0000,0000,0000,,لذا فالوضع معقول إذا كانت\Nمينا-سان تتصرّف بعجالة
Dialogue: 0,0:17:19.45,0:17:21.89,Default,,0000,0000,0000,,لكنّها تعجّلت كثيراً
Dialogue: 0,0:17:22.99,0:17:24.74,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:17:24.74,0:17:29.27,Default,,0000,0000,0000,,الآثار على معصم هذه الآنسة\Nهي لخطوط متعرّجة شُكّلت بعجلة
Dialogue: 0,0:17:32.16,0:17:33.89,Default,,0000,0000,0000,,!بـ-بالفعل
Dialogue: 0,0:17:35.78,0:17:42.49,Default,,0000,0000,0000,,في العادة، تكون الآثار من تردّد الشخص المُقدم\Nعلى الانتحار موازيةً للجرح القاتل
Dialogue: 0,0:17:42.49,0:17:44.90,Default,,0000,0000,0000,,من الغريب أن تتداخل بهذا الشكل
Dialogue: 0,0:17:45.82,0:17:47.49,Default,,0000,0000,0000,,...أيمكن أنّه
Dialogue: 0,0:17:47.49,0:17:49.79,Default,,0000,0000,0000,,مجرّد مصادفة
Dialogue: 0,0:17:50.11,0:17:54.22,Default,,0000,0000,0000,,هذا يُظهر حالة الارتباك\Nالتي كانت فيها
Dialogue: 0,0:17:54.82,0:17:56.82,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:17:56.82,0:18:00.32,Default,,0000,0000,0000,,لكن هل سيقوم شخص مثلها بالتنظيف؟
Dialogue: 0,0:18:00.32,0:18:01.06,Default,,0000,0000,0000,,التنظيف؟
Dialogue: 0,0:18:02.78,0:18:06.85,Default,,0000,0000,0000,,انظروا لهذا الدمّ، إنّه متوقّف بانتظام عند الطرف
Dialogue: 0,0:18:07.82,0:18:12.86,Default,,0000,0000,0000,,هذا يعني أنّها مسحته بعدما\Nتطاير الدم، أليس كذلك؟
Dialogue: 0,0:18:12.86,0:18:17.41,Default,,0000,0000,0000,,أحمق! لن يقوم شخص مُقدم\N!على الانتحار بذلك
Dialogue: 0,0:18:17.41,0:18:19.57,Default,,0000,0000,0000,,لمَ توقّف الأثر فجأةً إذاً؟
Dialogue: 0,0:18:19.57,0:18:21.78,Default,,0000,0000,0000,,...السبب... حسناً
Dialogue: 0,0:18:22.28,0:18:27.71,Default,,0000,0000,0000,,...عندما تطاير الدم، كان يوجد شيءٌ هنا، أو
Dialogue: 0,0:18:28.41,0:18:33.55,Default,,0000,0000,0000,,كان أحدٌ بجوارها عندما قطعت معصمها
Dialogue: 0,0:18:34.03,0:18:35.55,Default,,0000,0000,0000,,أليس كذلك؟
Dialogue: 0,0:18:37.70,0:18:40.70,Default,,0000,0000,0000,,...حضرة المفتّش، أيمكن أنّ هذا
Dialogue: 0,0:18:40.70,0:18:42.78,Default,,0000,0000,0000,,أجل، قد تكون جريمة قتل
Dialogue: 0,0:18:42.78,0:18:44.76,Default,,0000,0000,0000,,ربما كان الشريط اللاصق
Dialogue: 0,0:18:46.11,0:18:49.94,Default,,0000,0000,0000,,فقد كانت اللفافة في أسفل الحوض، أليس كذلك؟
Dialogue: 0,0:18:50.28,0:18:54.70,Default,,0000,0000,0000,,صحيح! إذا كانت اللفافة على طرف الحوض
Dialogue: 0,0:18:54.70,0:18:58.90,Default,,0000,0000,0000,,...وسقطت عندما قطعت معصمها
Dialogue: 0,0:18:59.61,0:19:02.20,Default,,0000,0000,0000,,!ستكتمل الصورة
Dialogue: 0,0:19:02.20,0:19:04.36,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:19:04.36,0:19:06.62,Default,,0000,0000,0000,,!حللنا اللغز بفضلك
Dialogue: 0,0:19:08.28,0:19:09.48,Default,,0000,0000,0000,,...لا
Dialogue: 0,0:19:12.11,0:19:13.95,Default,,0000,0000,0000,,مفتّش ميغوري
Dialogue: 0,0:19:13.95,0:19:18.22,Default,,0000,0000,0000,,يبدو أنّ البصمات على الشريط اللاصق\Nهي لمينا-سان فحسب
Dialogue: 0,0:19:18.86,0:19:24.68,Default,,0000,0000,0000,,آثار سبّابتها ومعصمها تظهر بوضوح على الشرائط
Dialogue: 0,0:19:25.20,0:19:26.45,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:19:26.45,0:19:32.66,Default,,0000,0000,0000,,مما يعني أنّنا نستطيع افتراض \Nأنّ "وداعاً" هذه بمثابة وصيّتها
Dialogue: 0,0:19:32.66,0:19:34.73,Default,,0000,0000,0000,,لعلّه كان انتحاراً بالفعل
Dialogue: 0,0:19:35.61,0:19:40.36,Default,,0000,0000,0000,,بالطبع، فقد كان هذا الحمّام مغلقاً بالكامل
Dialogue: 0,0:19:43.11,0:19:44.85,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:19:44.85,0:19:46.49,Default,,0000,0000,0000,,!نسيت تماماً
Dialogue: 0,0:19:46.84,0:19:49.61,Default,,0000,0000,0000,,نـ-نسيت ماذا يا موري-كن؟
Dialogue: 0,0:19:49.61,0:19:50.37,Default,,0000,0000,0000,,ماسايو-سان
Dialogue: 0,0:19:50.74,0:19:51.71,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:19:52.32,0:19:56.82,Default,,0000,0000,0000,,...وفقما أذكر، فقد قلتِ آنذاك
Dialogue: 0,0:19:56.82,0:19:58.45,Default,,0000,0000,0000,,آ-آنذاك؟
Dialogue: 0,0:19:59.45,0:20:04.35,Default,,0000,0000,0000,,!ستعطينني تذكرة لحفلة يوكو-تشان الليلة
Dialogue: 0,0:20:04.35,0:20:05.01,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:20:05.19,0:20:08.45,Default,,0000,0000,0000,,مهلك، أبي! هذا ليس وقتاً مناسباً
Dialogue: 0,0:20:08.45,0:20:14.48,Default,,0000,0000,0000,,أين المشكلة؟ يمكننا مشاهدة ختام الحفلة\Nعلى الأقل إذا ذهبنا الآن
Dialogue: 0,0:20:15.32,0:20:20.66,Default,,0000,0000,0000,,سأذهب لجلبها إذاً، أظنّ أختي تركتها في غرفة المعيشة
Dialogue: 0,0:20:20.66,0:20:22.52,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:20:36.24,0:20:37.52,Default,,0000,0000,0000,,أخبريني
Dialogue: 0,0:20:38.61,0:20:42.82,Default,,0000,0000,0000,,بهذه الصناديق آثار ثني، هل فتحتِها قبلاً؟
Dialogue: 0,0:20:42.82,0:20:49.72,Default,,0000,0000,0000,,أ-أجل، فقد كانت لديّ أمتعة كثيرة\N...فقرّت تأجيلها
Dialogue: 0,0:20:50.53,0:20:54.94,Default,,0000,0000,0000,,فهمت، لذا طلبتِ من أختك مساعدتك وقتها؟
Dialogue: 0,0:20:56.16,0:20:59.48,Default,,0000,0000,0000,,فكلّ أطراف تلك الطاولة دبقة
Dialogue: 0,0:21:00.78,0:21:04.32,Default,,0000,0000,0000,,تعني أنّ شريطاً لاصقاً كان ملصقاً عليها، أليس كذلك؟
Dialogue: 0,0:21:05.41,0:21:11.29,Default,,0000,0000,0000,,جعل أحدهم يقطع الشريط اللاصق\Nلأجزاء يجعل حزم الأمتعة سهلاً، صحيح؟
Dialogue: 0,0:21:12.96,0:21:15.11,Default,,0000,0000,0000,,كونان-كن، أين أنت؟
Dialogue: 0,0:21:15.11,0:21:18.32,Default,,0000,0000,0000,,يا إلهي، ذاك الصبيّ الشقيّ... كلّ مرّة
Dialogue: 0,0:21:18.32,0:21:19.67,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:19.85,0:21:22.95,Default,,0000,0000,0000,,!يا-يا فتى، أختك تناديك
Dialogue: 0,0:21:22.95,0:21:24.28,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:24.28,0:21:26.30,Default,,0000,0000,0000,,معكِ حقّ، عليّ الذهاب
Dialogue: 0,0:21:42.99,0:21:45.90,Default,,0000,0000,0000,,لا فائدة من محي آثار الشريط اللاصق
Dialogue: 0,0:21:47.07,0:21:52.20,Default,,0000,0000,0000,,فقد لمسها المُحلّل قبل قليل\Nوالتقط صوراً عندما أخبرته
Dialogue: 0,0:21:53.20,0:21:54.86,Default,,0000,0000,0000,,!كنتَ هنا
Dialogue: 0,0:21:54.86,0:21:56.33,Default,,0000,0000,0000,,أعتذر على الإزعاج
Dialogue: 0,0:21:56.70,0:21:58.41,Default,,0000,0000,0000,,!مع السلامة يا آنسة
Dialogue: 0,0:21:58.41,0:22:00.03,Default,,0000,0000,0000,,مع السلامة
Dialogue: 0,0:22:00.03,0:22:03.01,Default,,0000,0000,0000,,!كونان-كن، تعرف أنّه لا يصحّ بك التجوّل
Dialogue: 0,0:22:10.03,0:22:11.32,Default,,0000,0000,0000,,لا شكّ في الأمر
Dialogue: 0,0:22:11.32,0:22:12.35,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:22:12.61,0:22:17.95,Default,,0000,0000,0000,,!أجل، المجرم الذي قتل مينا-سان هي ماسايو-سان
Dialogue: 0,0:22:17.95,0:22:20.05,Default,,0000,0000,0000,,لكن لا أفهم
Dialogue: 0,0:22:20.05,0:22:23.78,Default,,0000,0000,0000,,كيف هربت من الحجرة المغلقة بالشريط اللاصق؟
Dialogue: 0,0:22:24.49,0:22:31.50,Default,,0000,0000,0000,,وما ذاك الشعور الغريب العالق في رأسي لفترة؟
Dialogue: 0,0:24:04.80,0:24:07.38,Default,,0000,0000,0000,,انظر، ما ذاك؟
Dialogue: 0,0:24:07.63,0:24:10.30,Default,,0000,0000,0000,,...أ-أيمكن أنّه
Dialogue: 0,0:24:10.30,0:24:16.89,Default,,0000,0000,0000,,أجل، لم تنتحر مينا-سان، بل قُتلت
Dialogue: 0,0:24:17.70,0:24:22.01,Default,,0000,0000,0000,,!بأيدي أختها، أنت يا ماسايو-سان
Dialogue: 0,0:24:25.30,0:24:31.30,On Top,,0000,0000,0000,,جريمة قتل الحمّام المغلق\N(الجزء الثاني)
Dialogue: 0,0:24:25.46,0:24:26.92,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.92,0:24:30.59,Default,,0000,0000,0000,,جريمة قتل الحمّام المغلق\N(الجزء الثاني)
Dialogue: 0,0:24:47.10,0:24:49.47,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.47,0:24:51.32,Default,,0000,0000,0000,,عصابة رأس
Dialogue: 0,0:24:51.32,0:24:52.33,Default,,0000,0000,0000,,!الحلقة القادمة هي الجزء الثاني
Dialogue: 0,0:24:52.33,0:24:54.33,Default,,0000,0000,0000,,!أنت القاتل أيّها الخطيب
Dialogue: 0,0:24:54.33,0:24:56.33,Default,,0000,0000,0000,,كلا، كان ماسايو-سان

