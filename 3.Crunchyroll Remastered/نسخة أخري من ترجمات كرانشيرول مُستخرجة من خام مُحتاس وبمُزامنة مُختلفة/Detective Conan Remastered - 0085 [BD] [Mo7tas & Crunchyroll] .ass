Dialogue: 0,0:00:02.38,0:00:04.08,Default,,0000,0000,0000,,عقرب دقائق مسرِع، قمر صناعيّ محطّم
Dialogue: 0,0:00:04.08,0:00:07.46,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.46,0:00:10.86,Default,,0000,0000,0000,,!اليوم ختام مليء بالدموع! يُعتمد عليه في القضايا والمشاعر
Dialogue: 0,0:00:11.12,0:00:12.44,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.44,0:00:14.40,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.40,0:00:17.04,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:52.02,0:01:56.68,Default,,0000,0000,0000,,ذهبتُ مع ران وسونوكو للتزلّج\Nفي يوم عطلتنا
Dialogue: 0,0:01:56.68,0:02:02.13,Default,,0000,0000,0000,,التقينا هناك معلّمتهما في المدرسة\N،الابتدائيّة، يونيهارا سينسي
Dialogue: 0,0:02:02.13,0:02:05.05,Default,,0000,0000,0000,,وقبلنا دعوتها للمكوث في النزل الذي استأجرته
Dialogue: 0,0:02:06.80,0:02:10.26,Default,,0000,0000,0000,,في تلك الليلة، هاجم أحدهم\Nسونوكو ويونيهارا سينسي
Dialogue: 0,0:02:10.26,0:02:14.90,Default,,0000,0000,0000,,ووجدنا سوغياما سينسي الذي تأخّر\Nفي وصوله مشنوقاً حتّى الموت
Dialogue: 0,0:02:17.41,0:02:22.94,Default,,0000,0000,0000,,،"كان مكتوباً على أيديهم "مي\N..."نا"، و"كو"
Dialogue: 0,0:02:24.74,0:02:27.97,Default,,0000,0000,0000,,بعد رؤيته ذلك، أغلق شيمودا سينسي\Nعلى نفسه في غرفته
Dialogue: 0,0:02:28.93,0:02:30.22,Default,,0000,0000,0000,,تواصلتُ مع البروفسور آغاسا
Dialogue: 0,0:02:30.52,0:02:33.68,Default,,0000,0000,0000,,وعرفت أنّه وقع انتحار\Nفي ابتدائيّة هايدو قبل 3 أعوام
Dialogue: 0,0:02:33.68,0:02:37.64,Default,,0000,0000,0000,,واسم الطالبة المتوفاة كان موتشيزوكي ميناكو
Dialogue: 0,0:02:37.64,0:02:38.74,Default,,0000,0000,0000,,...عندها
Dialogue: 0,0:02:42.04,0:02:47.95,Title,,0000,0000,0003,,\N{\fad(300,0)}جريمة قتل نزل التزلّج\N(الجزء الثاني)
Dialogue: 0,0:02:42.59,0:02:45.98,Default,,0000,0000,0000,,جريمة قتل نزل التزلّج\Nالجزء الثاني
Dialogue: 0,0:02:50.79,0:02:53.05,Default,,0000,0000,0000,,!الـ-الطابق الثاني! تبّاً
Dialogue: 0,0:02:53.50,0:02:54.64,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:02:54.64,0:02:57.06,Default,,0000,0000,0000,,!ابقي مكانك يا ران-نيتشان
Dialogue: 0,0:02:57.06,0:02:58.76,Default,,0000,0000,0000,,...تمهل
Dialogue: 0,0:02:59.07,0:02:59.74,Default,,0000,0000,0000,,!ما الأمر؟
Dialogue: 0,0:02:59.74,0:03:00.72,Default,,0000,0000,0000,,!ماذا هناك؟
Dialogue: 0,0:03:00.72,0:03:02.30,Default,,0000,0000,0000,,...شيمادا سينسي قد
Dialogue: 0,0:03:05.20,0:03:07.68,Default,,0000,0000,0000,,!آ-آثار حبل على عنقه
Dialogue: 0,0:03:09.13,0:03:11.94,Default,,0000,0000,0000,,ليس موجوداً، سلاح الجريمة ليس موجوداً
Dialogue: 0,0:03:11.94,0:03:15.27,Default,,0000,0000,0000,,،نوافذ الطابق الثاني لا تُفتح\Nولا توجد أيّة مخارج
Dialogue: 0,0:03:15.27,0:03:16.68,Default,,0000,0000,0000,,...ما يعني أنّه في غرفة أحدهم
Dialogue: 0,0:03:17.73,0:03:19.17,Default,,0000,0000,0000,,انتظر
Dialogue: 0,0:03:20.43,0:03:21.54,Default,,0000,0000,0000,,ليس هنا
Dialogue: 0,0:03:22.21,0:03:23.46,Default,,0000,0000,0000,,ليس هنا
Dialogue: 0,0:03:24.06,0:03:25.05,Default,,0000,0000,0000,,ليس هنا
Dialogue: 0,0:03:26.05,0:03:27.76,Default,,0000,0000,0000,,ليس موجوداً في أيّ مكان
Dialogue: 0,0:03:27.76,0:03:30.05,Default,,0000,0000,0000,,...ما يعني أنّ الحبل لا يزال
Dialogue: 0,0:03:30.67,0:03:33.01,Default,,0000,0000,0000,,في حوزة القاتل
Dialogue: 0,0:03:33.46,0:03:35.15,Default,,0000,0000,0000,,مع أحدهم
Dialogue: 0,0:03:39.03,0:03:41.91,Default,,0000,0000,0000,,أأنت متأكّد أنّ سلاح الجريمة \Nليس موجوداً يا فتى؟
Dialogue: 0,0:03:41.91,0:03:42.76,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:03:43.03,0:03:46.74,Default,,0000,0000,0000,,انظروا لعنق شيمودا سينسي
Dialogue: 0,0:03:46.74,0:03:51.64,Default,,0000,0000,0000,,توجد آثار حبل مثل التي كانت\Nعلى جثّة سوغياما سينسي، أليس كذلك؟
Dialogue: 0,0:03:51.90,0:03:54.93,Default,,0000,0000,0000,,لكن لا أرى أيّ حبل في الغرفة
Dialogue: 0,0:03:55.31,0:03:59.34,On Top,,0000,0000,0000,,أتقصد أنّ القاتل هرب لمكانٍ ما مع الحبل؟
Dialogue: 0,0:03:59.61,0:04:02.32,Default,,0000,0000,0000,,لا أظنّ ذلك بعد
Dialogue: 0,0:04:02.32,0:04:05.91,Default,,0000,0000,0000,,فقد كنتُ أسفل الأدراج طوال الوقت
Dialogue: 0,0:04:06.36,0:04:08.44,Default,,0000,0000,0000,,قد لا يزال في الطابق الثاني؟
Dialogue: 0,0:04:09.31,0:04:11.02,Default,,0000,0000,0000,,لكن هذا غريب
Dialogue: 0,0:04:11.02,0:04:14.31,Default,,0000,0000,0000,,تفقّدتُ كلّ غرف الطابق الثاني قبل قليل
Dialogue: 0,0:04:14.31,0:04:16.62,Default,,0000,0000,0000,,لكن لم أجد أيّ شخص مريب أو حبل
Dialogue: 0,0:04:17.06,0:04:20.05,On Top,,0000,0000,0000,,!هل بحثت في أمتعتنا؟
Dialogue: 0,0:04:20.05,0:04:20.90,On Top,,0000,0000,0000,,آسف
Dialogue: 0,0:04:21.06,0:04:25.07,On Top,,0000,0000,0000,,...فهمت، إذا كان ما يقوله الصبيّ صحيحاً
Dialogue: 0,0:04:25.34,0:04:32.43,Default,,0000,0000,0000,,،فيعني ذلك أنّ القاتل أحدكم الثلاثة\Nكما لا يزال يحمل سلاح الجريمة
Dialogue: 0,0:04:32.96,0:04:35.49,Default,,0000,0000,0000,,!لستَ مشتبهاً به بدورك؟
Dialogue: 0,0:04:36.04,0:04:40.95,Default,,0000,0000,0000,,كن منطقياً، هذه أوّل مرة\Nأصعد فيها الأدراج
Dialogue: 0,0:04:40.95,0:04:46.53,Default,,0000,0000,0000,,وأيضاً لو كنتُ الفاعل، لرآني هذا الصغير أنزل للأسفل
Dialogue: 0,0:04:46.86,0:04:50.06,Default,,0000,0000,0000,,بأيّ حال، من يحمل الحبل هو القاتل
Dialogue: 0,0:04:50.06,0:04:52.99,Default,,0000,0000,0000,,لنجر تفتيشاً جسدياً
Dialogue: 0,0:04:57.64,0:04:59.42,Default,,0000,0000,0000,,إ-إذاً؟
Dialogue: 0,0:04:59.69,0:05:02.88,Default,,0000,0000,0000,,!يا لحمقاتك! لم يكن هناك أيّ حبل
Dialogue: 0,0:05:02.88,0:05:06.97,Default,,0000,0000,0000,,لم يخطر لي أن أخلع ثيابي في هذه البرودة
Dialogue: 0,0:05:08.42,0:05:12.11,Default,,0000,0000,0000,,لكن أصحيحٌ أنّ شيمودا سينسي قد قُتل؟
Dialogue: 0,0:05:12.46,0:05:19.07,Default,,0000,0000,0000,,أجل، سمعت رنين هاتف خلويّ في غرفته\Nولم يتوقّف لفترة
Dialogue: 0,0:05:19.78,0:05:23.26,Default,,0000,0000,0000,,...عندما فتحتُ الباب لأتفقد الأمر، وجدتُه قد
Dialogue: 0,0:05:24.07,0:05:27.98,Default,,0000,0000,0000,,تبيّن أن الصوت كان من ساعة تنبيه هاتفه
Dialogue: 0,0:05:28.56,0:05:32.02,Default,,0000,0000,0000,,سمعتُه من غرفتي في الجانب المقابل أيضاً
Dialogue: 0,0:05:32.02,0:05:35.56,Default,,0000,0000,0000,,ماذا؟ ظننتُ غرفتك في الطابق السفليّ\Nيا يونيهارا سينسي
Dialogue: 0,0:05:35.56,0:05:39.72,Default,,0000,0000,0000,,نعم، لكنّي انتقلت للطابق الثاني\Nبعدما حطّمتِ بابي
Dialogue: 0,0:05:39.72,0:05:40.94,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:05:41.22,0:05:45.91,Default,,0000,0000,0000,,...لكن إذا لم يكن القاتل إحدانا الاثنتين
Dialogue: 0,0:05:46.22,0:05:48.92,Default,,0000,0000,0000,,يبقى ساكاي سينسي فحسب
Dialogue: 0,0:05:51.38,0:05:55.11,Default,,0000,0000,0000,,ماذا؟ انتهيتما من التفتيش الجسديّ؟
Dialogue: 0,0:05:55.33,0:05:56.88,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:05:56.88,0:05:58.07,Default,,0000,0000,0000,,هل وجد الحبل؟
Dialogue: 0,0:05:58.37,0:06:02.45,Default,,0000,0000,0000,,بالطبع لا! صحيح؟
Dialogue: 0,0:06:02.45,0:06:05.03,Default,,0000,0000,0000,,نعم، ماذا عنكما؟
Dialogue: 0,0:06:05.56,0:06:07.14,Default,,0000,0000,0000,,!بالطبع لا
Dialogue: 0,0:06:07.14,0:06:09.48,Default,,0000,0000,0000,,هذا يترك احتمالاً واحداً
Dialogue: 0,0:06:09.88,0:06:12.44,Default,,0000,0000,0000,,!هذا الصبيّ يكذب
Dialogue: 0,0:06:14.01,0:06:17.59,Default,,0000,0000,0000,,!أي أنّ القاتل قد لا يزال داخل النزل؟
Dialogue: 0,0:06:17.59,0:06:21.29,Default,,0000,0000,0000,,كلا! سونوكو نائمة بمفردها \N!في الطابق السفليّ
Dialogue: 0,0:06:21.29,0:06:23.82,Default,,0000,0000,0000,,لنسرع لغرفتها بأيّ حال
Dialogue: 0,0:06:29.86,0:06:32.69,Default,,0000,0000,0000,,لم أترك الأدراج البتّة
Dialogue: 0,0:06:32.69,0:06:36.16,Default,,0000,0000,0000,,المجرم أحد أولئك الثلاثة بلا شكّ
Dialogue: 0,0:06:37.19,0:06:40.36,Default,,0000,0000,0000,,لكن لمَ؟ لمَ لم يظهر سلاح الجريمة؟
Dialogue: 0,0:06:42.39,0:06:44.56,Default,,0000,0000,0000,,لا بأس، إنّها نائمة فحسب
Dialogue: 0,0:06:44.56,0:06:45.28,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:06:50.38,0:06:51.28,Default,,0000,0000,0000,,!سونوكو
Dialogue: 0,0:06:51.76,0:06:55.80,Default,,0000,0000,0000,,ران! الأمر فظيع! وجدت يونيهارا سينسي\N!مقتولةً في غرفتها
Dialogue: 0,0:06:55.80,0:06:59.92,Default,,0000,0000,0000,,...بعدها خنقني المجرم بحبل هكذا
Dialogue: 0,0:07:02.29,0:07:05.00,Default,,0000,0000,0000,,ماذا؟ أنتِ على قيد الحياة؟
Dialogue: 0,0:07:05.00,0:07:08.53,Default,,0000,0000,0000,,بشكلٍ ما، أأنتِ بخير؟
Dialogue: 0,0:07:08.53,0:07:11.03,Default,,0000,0000,0000,,لا زلتُ أشعر بدوار
Dialogue: 0,0:07:11.57,0:07:13.98,Default,,0000,0000,0000,,ارتاحي مزيداً إذاً
Dialogue: 0,0:07:14.32,0:07:17.28,Default,,0000,0000,0000,,لم يخنقك؟
Dialogue: 0,0:07:17.28,0:07:21.19,Default,,0000,0000,0000,,كلا، لكنّه ضرب جبهتي بالحائط عدّة مرات
Dialogue: 0,0:07:21.56,0:07:28.15,Default,,0000,0000,0000,,،لكنّي مسرورة لأنّك بخير\Nفلطالما كنتُ أتطلّع لك
Dialogue: 0,0:07:29.55,0:07:35.41,Default,,0000,0000,0000,,ليست سونوكو فحسب، كلّ الفتيات في الفصل\Nبالإضافة لي كُنّ يتطلّعن لك
Dialogue: 0,0:07:36.80,0:07:38.61,Default,,0000,0000,0000,,لا تبالغا في تقديري
Dialogue: 0,0:07:39.04,0:07:43.53,Default,,0000,0000,0000,,أنا مجرّد امرأة لا تستطيع فعل\Nشيء لأجل تلامذتها
Dialogue: 0,0:07:44.58,0:07:48.52,Default,,0000,0000,0000,,لم أستطع مساعدتك اليوم\Nعندما تعرّضتِ للهجوم أيضاً
Dialogue: 0,0:07:49.20,0:07:50.86,Default,,0000,0000,0000,,!لم تكن غلطتك
Dialogue: 0,0:07:50.86,0:07:52.24,Default,,0000,0000,0000,,!بل القاتل
Dialogue: 0,0:07:52.24,0:07:56.70,Default,,0000,0000,0000,,هكذا حماك التلامذة قبل ثلاثة أعوام كذلك
Dialogue: 0,0:07:57.89,0:08:01.85,Default,,0000,0000,0000,,كنتِ معلّمة فصل الفتاة التي\Nأقدمت على الانتحار، موتشيزوكي ميناكو
Dialogue: 0,0:08:02.22,0:08:07.10,Default,,0000,0000,0000,,،إذا كان هدف القاتل الأخذ بثأرها
Dialogue: 0,0:08:07.10,0:08:10.18,Default,,0000,0000,0000,,فليس مُستغرباً أنّك كنتِ\Nأوّل من هُوجم
Dialogue: 0,0:08:10.71,0:08:12.29,Default,,0000,0000,0000,,!ما الذي تقوله؟
Dialogue: 0,0:08:12.29,0:08:14.38,Default,,0000,0000,0000,,أنت في نفس الدائرة
Dialogue: 0,0:08:14.38,0:08:19.28,Default,,0000,0000,0000,,فقد كنتَ المسؤول عن نادي كرة الطائرة\Nالذي كانت فيه موتشيزوكي ميناكو
Dialogue: 0,0:08:19.28,0:08:20.18,Default,,0000,0000,0000,,صحيح، صحيح
Dialogue: 0,0:08:20.18,0:08:25.48,Default,,0000,0000,0000,,وكانت المفضّلة لدى ناكامورا سينسي\Nفي اللجنة الصحّية
Dialogue: 0,0:08:26.03,0:08:29.43,Default,,0000,0000,0000,,كان بإمكانك إيقافها من ارتكاب الانتحار أيضاً
Dialogue: 0,0:08:29.69,0:08:34.27,Default,,0000,0000,0000,,يبدو أنّ سلسلة جرائم القتل هذه ستستمرّ
Dialogue: 0,0:08:35.90,0:08:38.81,Default,,0000,0000,0000,,جرائم القتل؟ أقُتل أحدهم؟
Dialogue: 0,0:08:39.47,0:08:41.18,Default,,0000,0000,0000,,لنؤجل الكلام
Dialogue: 0,0:08:41.18,0:08:43.77,Default,,0000,0000,0000,,البقاء متفرقين أمر خطر
Dialogue: 0,0:08:44.31,0:08:47.10,Default,,0000,0000,0000,,لنجتمع في غرفة المعيشة وننتظر وصول الشرطة
Dialogue: 0,0:08:49.39,0:08:52.85,Default,,0000,0000,0000,,!تبّاً! ما الذي يجري؟
Dialogue: 0,0:08:53.34,0:08:57.32,Default,,0000,0000,0000,,فكّر، لا بدّ من وجود مفتاح\Nلحلّ لغز هذه القضيّة
Dialogue: 0,0:08:57.95,0:09:00.27,Default,,0000,0000,0000,,في مكان ما في نزل الجبل الثلجيّ هذا
Dialogue: 0,0:09:04.33,0:09:05.44,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:09:07.37,0:09:08.39,Default,,0000,0000,0000,,خيط؟
Dialogue: 0,0:09:09.90,0:09:11.52,Default,,0000,0000,0000,,إنّه خيط طائرة ورقية طويل
Dialogue: 0,0:09:12.48,0:09:14.60,Default,,0000,0000,0000,,يوجد رباط مطّاطي مقطوع في طرفه
Dialogue: 0,0:09:15.27,0:09:16.49,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:09:16.49,0:09:18.22,Default,,0000,0000,0000,,...أيمكن أنّ هذا
Dialogue: 0,0:09:19.02,0:09:22.85,Default,,0000,0000,0000,,حسناً، فهمت حيلة قرع جرس الباب
Dialogue: 0,0:09:22.85,0:09:24.90,Default,,0000,0000,0000,,تبقّى إيجاد سلاح الجريمة فحسب
Dialogue: 0,0:09:25.85,0:09:27.28,Default,,0000,0000,0000,,...إذا وجدته سوف
Dialogue: 0,0:09:30.13,0:09:31.31,Default,,0000,0000,0000,,شعرة؟
Dialogue: 0,0:09:32.55,0:09:36.52,Default,,0000,0000,0000,,هكذا إذاً! فهمت حيلة اختفاء\N!سلاح الجريمة
Dialogue: 0,0:09:36.79,0:09:39.37,Default,,0000,0000,0000,,في تلك الحالة، القاتل هو ذاك الشخص
Dialogue: 0,0:09:39.78,0:09:41.48,Default,,0000,0000,0000,,لكن كيف أخبر الجميع؟
Dialogue: 0,0:09:42.36,0:09:46.45,Default,,0000,0000,0000,,لا يمكنني استعمال سونوكو كمتحرّية\Nبما أنّها تجهل معظم القضيّة
Dialogue: 0,0:09:47.15,0:09:51.44,Default,,0000,0000,0000,,ومن الصعب استعمال ران، لا أستطيع\Nالتحايل عليها لاحقاً مثل سونوكو
Dialogue: 0,0:09:52.10,0:09:54.98,Default,,0000,0000,0000,,أفضل خيار هو التظاهر أنّي\Nسمعت كلّ شيء من كونان
Dialogue: 0,0:09:55.48,0:09:58.42,Default,,0000,0000,0000,,وأتكلّم بصوتي الحقيقيّ على الهاتف\Nلشرح الجريمة
Dialogue: 0,0:09:59.93,0:10:03.98,Default,,0000,0000,0000,,كلا! إذا فعلتُ هذا بوجوده\N!سينشر الأمر على الصحف
Dialogue: 0,0:10:04.51,0:10:09.43,Default,,0000,0000,0000,,!إذا وصل اسمي الجرائد، سيكتشفون أنّي حيّ
Dialogue: 0,0:10:09.87,0:10:14.27,Default,,0000,0000,0000,,أولئك الرجال ذوو الرداء الأسود\N!الذين قلّصوا جسدي
Dialogue: 0,0:10:14.27,0:10:17.02,Default,,0000,0000,0000,,!أنت! لا تتسكّع
Dialogue: 0,0:10:18.24,0:10:21.53,Default,,0000,0000,0000,,الهاتف الغريب الذي اخترعه البروفسور؟
Dialogue: 0,0:10:22.48,0:10:29.06,Default,,0000,0000,0000,,لحظة، قال البروفسور أنّ بإمكان ربطة العنق\Nالمغيّرة للصوت أن تتصل به
Dialogue: 0,0:10:29.06,0:10:29.92,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:34.98,0:10:37.37,Default,,0000,0000,0000,,!كونان-كن، هاتفك يرنّ
Dialogue: 0,0:10:38.84,0:10:39.89,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:10:40.34,0:10:42.22,Default,,0000,0000,0000,,إنّه أنا يا ران، شينتشي
Dialogue: 0,0:10:42.22,0:10:43.35,Default,,0000,0000,0000,,شينتشي؟
Dialogue: 0,0:10:43.97,0:10:48.06,Default,,0000,0000,0000,,اكتشفتُ هويّة الفاعل الذي\Nقتل المعلّمين في النزل
Dialogue: 0,0:10:48.42,0:10:49.89,Default,,0000,0000,0000,,!ماذا؟ كيف؟
Dialogue: 0,0:10:50.38,0:10:53.85,Default,,0000,0000,0000,,أخبرني كونان-كن، أحتاج لطلب شيء منك
Dialogue: 0,0:10:54.13,0:10:55.11,Default,,0000,0000,0000,,طلب؟
Dialogue: 0,0:10:55.11,0:10:58.49,Default,,0000,0000,0000,,اكشفي الحقيقة للجميع مكاني
Dialogue: 0,0:10:58.49,0:10:59.81,Default,,0000,0000,0000,,ماذا؟ أنا؟
Dialogue: 0,0:10:59.81,0:11:04.61,Default,,0000,0000,0000,,أجل، سأخبرك بها على الهاتف\N...وعليك ترديد كلامي فحسب
Dialogue: 0,0:11:04.61,0:11:08.56,Default,,0000,0000,0000,,!كلا! يمكنك إخبار الجميع بصوتك
Dialogue: 0,0:11:09.27,0:11:11.19,Default,,0000,0000,0000,,حسناً، لا بأس إذا لم تريدي
Dialogue: 0,0:11:11.19,0:11:13.02,Default,,0000,0000,0000,,سأخبر الشرطة عند وصولهم
Dialogue: 0,0:11:16.31,0:11:18.43,Default,,0000,0000,0000,,فهمت، سأجرّب
Dialogue: 0,0:11:20.05,0:11:23.81,Default,,0000,0000,0000,,أربط هذه بأذني وأردد كلامك فحسب، صحيح؟
Dialogue: 0,0:11:24.51,0:11:27.22,Default,,0000,0000,0000,,كونان-كن، هيّا بنا! سنذهب لمكان الجميع
Dialogue: 0,0:11:27.22,0:11:28.27,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:11:28.63,0:11:32.23,Default,,0000,0000,0000,,سنأخذ بثأر سونوكو ويونيهارا سينسي\Nاللتين تعرّضتا للهجوم
Dialogue: 0,0:11:32.54,0:11:34.61,Default,,0000,0000,0000,,كما المعلّمين اللذين قُتلا
Dialogue: 0,0:11:36.00,0:11:38.16,Default,,0000,0000,0000,,شكراً يا ران
Dialogue: 0,0:11:46.37,0:11:48.52,Default,,0000,0000,0000,,!ماذا؟ اكتشفتِ هويّة الفاعل؟
Dialogue: 0,0:11:50.32,0:11:51.64,Default,,0000,0000,0000,,نعم، كلّ شيء
Dialogue: 0,0:11:52.52,0:11:57.11,Default,,0000,0000,0000,,الحادثة الأولى حيث هُوجمت يونيهارا سينسي وسونوكو\N...في الغرفة في الطابق الأوّل
Dialogue: 0,0:11:57.51,0:12:00.43,Default,,0000,0000,0000,,والحادثة الثانية حيث وُضِع سوغياما سينسي \N...المقتول شنقاً
Dialogue: 0,0:12:00.43,0:12:03.06,Default,,0000,0000,0000,,بجوار الباب لقرع الجرس
Dialogue: 0,0:12:03.60,0:12:06.26,Default,,0000,0000,0000,,والحادثة الثالثة عندما قتل الفاعل شيمودا سينسي\Nفي غرفته في الطابق الثاني
Dialogue: 0,0:12:06.26,0:12:09.27,Default,,0000,0000,0000,,واختفى مع سلاح الجريمة
Dialogue: 0,0:12:10.63,0:12:14.98,Default,,0000,0000,0000,,عرفتُ هويّة الفاعل وراء هذه الحوادث الثلاث
Dialogue: 0,0:12:15.30,0:12:16.87,Default,,0000,0000,0000,,...وذاك الفاعل هو
Dialogue: 0,0:12:17.10,0:12:18.43,Default,,0000,0000,0000,,...وذاك الفاعل هو
Dialogue: 0,0:12:18.79,0:12:20.79,Default,,0000,0000,0000,,أحدكم
Dialogue: 0,0:12:21.55,0:12:23.40,Default,,0000,0000,0000,,!أحدكم
Dialogue: 0,0:12:23.95,0:12:26.23,Default,,0000,0000,0000,,الـ-القاتل أحدنا؟
Dialogue: 0,0:12:27.65,0:12:30.43,Default,,0000,0000,0000,,طالبة ثانوية تلعب لعبة المتحرّي
Dialogue: 0,0:12:30.78,0:12:32.98,Default,,0000,0000,0000,,حسناً، أسمعينا
Dialogue: 0,0:12:32.98,0:12:37.40,Default,,0000,0000,0000,,لكن أأنتِ متحضّرة في حال ثبوت خطئك؟
Dialogue: 0,0:12:38.64,0:12:42.31,Default,,0000,0000,0000,,ستُقاضين بتهمة الاتّهام الكاذب
Dialogue: 0,0:12:42.31,0:12:46.02,Default,,0000,0000,0000,,!وإذا نشرتُ الأمر في الصحيفة، ستُفصلين من المدرسة
Dialogue: 0,0:12:46.02,0:12:47.47,Default,,0000,0000,0000,,أُفصل؟
Dialogue: 0,0:12:47.92,0:12:50.63,Default,,0000,0000,0000,,أفترض أنّكِ متأهبة لذلك
Dialogue: 0,0:12:50.63,0:12:51.94,Default,,0000,0000,0000,,...ر-ران
Dialogue: 0,0:12:52.26,0:12:55.10,Default,,0000,0000,0000,,لا تقلقي يا ران، أنا معك
Dialogue: 0,0:12:55.80,0:12:57.79,Default,,0000,0000,0000,,دعي الأمر لي فحسب
Dialogue: 0,0:12:57.79,0:12:59.06,Default,,0000,0000,0000,,...شينتشي
Dialogue: 0,0:13:00.12,0:13:04.23,Default,,0000,0000,0000,,،لا بأس، إذا وثقتِ بي ورددتِ ما أقول
Dialogue: 0,0:13:04.58,0:13:06.77,Default,,0000,0000,0000,,ستُكشف الحقيقة
Dialogue: 0,0:13:07.19,0:13:09.77,Default,,0000,0000,0000,,إذاً يا آنسة؟
Dialogue: 0,0:13:10.74,0:13:12.48,Default,,0000,0000,0000,,اكتب إذا أردت
Dialogue: 0,0:13:13.24,0:13:19.43,Default,,0000,0000,0000,,ابنة المتحرّي الشهير موري كوغورو تحلّ"\N"!جريمة قتل في نزل على جبل ثلجيّ ببراعة
Dialogue: 0,0:13:19.51,0:13:20.60,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:20.60,0:13:21.89,Default,,0000,0000,0000,,...لكن يا موري-سان
Dialogue: 0,0:13:22.39,0:13:25.02,Default,,0000,0000,0000,,عندما قُرع الجرس في الحادثة الثانية
Dialogue: 0,0:13:25.02,0:13:29.76,Default,,0000,0000,0000,,كان الجميع في غرفة المعيشة هنا\Nباستثنائك وسوزوكي-سان وكونان-كن
Dialogue: 0,0:13:29.76,0:13:33.31,Default,,0000,0000,0000,,كيف يستطيع أحدنا فعل ذلك؟
Dialogue: 0,0:13:33.31,0:13:36.77,Default,,0000,0000,0000,,...الأمر يبدو مستحيلاً من الوهلة الأولى بالفعل، لكن
Dialogue: 0,0:13:37.37,0:13:41.37,Default,,0000,0000,0000,,...بخيط الطائرة الورقية هذا والرباط المطّاطي في طرفه
Dialogue: 0,0:13:41.37,0:13:43.77,Default,,0000,0000,0000,,يمكن تجاوز تلك المشكلة بسهولة
Dialogue: 0,0:13:44.33,0:13:45.73,Default,,0000,0000,0000,,خيط طائرة ورقية ورباط مطّاطي؟
Dialogue: 0,0:13:45.92,0:13:47.53,Default,,0000,0000,0000,,الحيلة بسيطة
Dialogue: 0,0:13:47.53,0:13:50.18,Default,,0000,0000,0000,,تربط الرباط المطّاطي بطرف خيط الطائرة الورقية
Dialogue: 0,0:13:50.61,0:13:53.36,Default,,0000,0000,0000,,وتلفّه حول العامودين أمام الباب
Dialogue: 0,0:13:53.36,0:13:58.93,Default,,0000,0000,0000,,ثم تربط الطرف الآخر للخيط بالرباط المطّاطي\Nبينما تشكّل حلقة صغيرة
Dialogue: 0,0:13:59.48,0:14:03.52,Default,,0000,0000,0000,,بعدها تلصق الرباط المطّاطي\Nبعنق سوغياما سينسي المُتصلّب
Dialogue: 0,0:14:03.52,0:14:07.89,Default,,0000,0000,0000,,وتميله نحو الباب مع تثبيت أقدامه بالثلج
Dialogue: 0,0:14:08.59,0:14:13.85,Default,,0000,0000,0000,,تقيس طول الخيط بحيث تتوقّف\Nالجثة قبل جرس الباب بالطبع
Dialogue: 0,0:14:14.26,0:14:18.67,Default,,0000,0000,0000,,مع مرور الوقت، سينقطع الرباط المطّاطي مع البرودة
Dialogue: 0,0:14:18.67,0:14:21.19,Default,,0000,0000,0000,,وستسقط الجثّة وتقرع الجرس
Dialogue: 0,0:14:21.62,0:14:26.40,Default,,0000,0000,0000,,ثمّ تقذف الرياح الخيط، فيختفي الدليل من المكان
Dialogue: 0,0:14:26.87,0:14:34.61,Default,,0000,0000,0000,,أي أنّ الفاعل قتل سوغياما سينسي قبل ساعات\Nمن إعداد حيلته كي يصلّب جثته؟
Dialogue: 0,0:14:35.11,0:14:36.28,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:14:36.28,0:14:41.73,Default,,0000,0000,0000,,استدعاه القاتل هنا قبل وصولنا غالباً
Dialogue: 0,0:14:41.73,0:14:42.90,Default,,0000,0000,0000,,وقتله
Dialogue: 0,0:14:43.48,0:14:47.68,Default,,0000,0000,0000,,فقد رأى كونان أعواد ثلجية عندما وصلنا
Dialogue: 0,0:14:48.14,0:14:49.47,Default,,0000,0000,0000,,أعواد ثلجية؟
Dialogue: 0,0:14:49.47,0:14:53.73,Default,,0000,0000,0000,,لا تتشكّل الأعواد الثلجية إلا عند استخدام\Nأحد لجهاز التدفئة
Dialogue: 0,0:14:54.93,0:15:00.17,Default,,0000,0000,0000,,،هذه حيلة مثيرة للاهتمام فعلاً\Nلكن أيمكن تطبيقها حقّاً؟
Dialogue: 0,0:15:04.54,0:15:08.04,Default,,0000,0000,0000,,اقطع الشكّ باليقين، انظر بنفسك
Dialogue: 0,0:15:13.45,0:15:15.27,Default,,0000,0000,0000,,هـ-هذا؟
Dialogue: 0,0:15:15.82,0:15:21.23,Default,,0000,0000,0000,,عدّة تزلّج نصبتها هناك، بنفس الحيلة\Nالتي شرحتُها سلفاً
Dialogue: 0,0:15:22.90,0:15:26.90,Default,,0000,0000,0000,,لكن لم يُحلّ لغز الحادثة الثالثة بعد
Dialogue: 0,0:15:27.23,0:15:30.64,Default,,0000,0000,0000,,سأوضّحه في غرفة المعيشة
Dialogue: 0,0:15:31.43,0:15:33.85,Default,,0000,0000,0000,,!مذهل! أنتِ رائعة يا ران
Dialogue: 0,0:15:34.26,0:15:37.81,Default,,0000,0000,0000,,!راقبي فحسب! سأفضح هويّة الفاعل الذي هاجمك
Dialogue: 0,0:15:41.75,0:15:45.90,Default,,0000,0000,0000,,إذاً يا آنسة، إذا كان القاتل بيننا فأخبرينا
Dialogue: 0,0:15:46.46,0:15:53.06,Default,,0000,0000,0000,,ما هي الحيلة الغامضة التي استعملها\Nالفاعل لجعل الحبل يختفي من الطابق الثاني؟
Dialogue: 0,0:15:53.41,0:15:55.24,Default,,0000,0000,0000,,الغامضة؟
Dialogue: 0,0:15:55.24,0:16:00.07,Default,,0000,0000,0000,,لم ينو الفاعل إخفاءه وإخافتنا في الأصل
Dialogue: 0,0:16:00.07,0:16:00.77,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:16:01.15,0:16:06.23,Default,,0000,0000,0000,,بدا الأمر كذلك لأنّ كونان-كن كان\Nبجوار الأدراج
Dialogue: 0,0:16:06.23,0:16:08.19,Default,,0000,0000,0000,,عندما وقعت الجريمة فحسب
Dialogue: 0,0:16:09.22,0:16:11.39,Default,,0000,0000,0000,,لو لم يكن هناك
Dialogue: 0,0:16:11.39,0:16:15.23,Default,,0000,0000,0000,,لاعتقدنا أنّ القاتل هرب مع السلاح\Nنزولاً من الطابق الثاني
Dialogue: 0,0:16:15.23,0:16:20.60,Default,,0000,0000,0000,,فتبرأ ساحته من دائرة الاهتمام\Nبما أنّه كان في الأعلى
Dialogue: 0,0:16:21.34,0:16:26.44,Default,,0000,0000,0000,,لذلك ضبط ساعة تنبيه الهاتف\Nوجعلنا نكتشف الجثّة فوراً
Dialogue: 0,0:16:28.33,0:16:30.29,Default,,0000,0000,0000,,،إذا تأخّر اكتشافه
Dialogue: 0,0:16:30.29,0:16:34.02,Default,,0000,0000,0000,,سيضيع الهدف من حيلته الماكرة\Nللتخلّص من سلاح الجريمة
Dialogue: 0,0:16:34.49,0:16:38.78,Default,,0000,0000,0000,,القاتل أحدنا الثلاثة الذين\Nكانوا في الطابق الثاني إذاً؟
Dialogue: 0,0:16:39.73,0:16:44.69,Default,,0000,0000,0000,,أخبرينا بحيلة إخفائه للسلاح \Nفي تلك الحالة
Dialogue: 0,0:16:44.94,0:16:48.80,Default,,0000,0000,0000,,لم يكن الحبل موجوداً في أيٍّ\Nمن غرف الطابق الثاني
Dialogue: 0,0:16:49.06,0:16:51.60,Default,,0000,0000,0000,,بالطبع لم يكن موجوداً
Dialogue: 0,0:16:52.39,0:16:55.31,Default,,0000,0000,0000,,فهو لا يزال في حوزة القاتل
Dialogue: 0,0:16:55.72,0:16:57.02,Default,,0000,0000,0000,,!مـ-ماذا؟
Dialogue: 0,0:16:57.34,0:17:01.17,Default,,0000,0000,0000,,!مستحيل! فتّشنا كلّ أولئك الثلاثة
Dialogue: 0,0:17:01.17,0:17:03.44,Default,,0000,0000,0000,,نعم، بحثاً عن شيء معيّن
Dialogue: 0,0:17:03.44,0:17:04.15,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:04.15,0:17:06.38,Default,,0000,0000,0000,,!أيّ شيء؟
Dialogue: 0,0:17:06.38,0:17:08.60,Default,,0000,0000,0000,,!من الفاعل الذي يحمله؟
Dialogue: 0,0:17:08.89,0:17:13.06,Default,,0000,0000,0000,,...نعم، من قتل سوغياما سينسي وشيمودا سينسي
Dialogue: 0,0:17:13.30,0:17:14.37,Default,,0000,0000,0000,,...و
Dialogue: 0,0:17:14.37,0:17:18.57,Default,,0000,0000,0000,,...وهاجم يونيهارا سينسي وسونوكو
Dialogue: 0,0:17:20.15,0:17:21.02,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:17:21.49,0:17:23.20,Default,,0000,0000,0000,,ما-ما الأمر؟
Dialogue: 0,0:17:23.20,0:17:23.98,Default,,0000,0000,0000,,من الفاعل؟
Dialogue: 0,0:17:27.81,0:17:29.31,Default,,0000,0000,0000,,...مستحيل
Dialogue: 0,0:17:29.64,0:17:31.27,Default,,0000,0000,0000,,!أفصحي
Dialogue: 0,0:17:32.64,0:17:34.23,Default,,0000,0000,0000,,...الفاعل
Dialogue: 0,0:17:34.89,0:17:37.32,Default,,0000,0000,0000,,!هو أنت يا يونيهارا سينسي
Dialogue: 0,0:17:40.55,0:17:42.43,Default,,0000,0000,0000,,يـ-يونيهارا سينسي؟
Dialogue: 0,0:17:42.43,0:17:43.19,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:17:43.80,0:17:49.67,Default,,0000,0000,0000,,...لفّت شعرها كالحبل وخنقت شيمودا سينسي
Dialogue: 0,0:17:50.00,0:17:52.35,Default,,0000,0000,0000,,بحيث بدا أنّه شُنق بحبل
Dialogue: 0,0:17:53.37,0:18:00.10,Default,,0000,0000,0000,,لـ-لكن، مهما كان شعرها طويلاً\N!فلا يمكنها خنق الآخرين به
Dialogue: 0,0:18:00.10,0:18:02.49,Default,,0000,0000,0000,,ماذا لو كان شعراً مستعاراً؟
Dialogue: 0,0:18:02.49,0:18:03.85,Default,,0000,0000,0000,,!شـ-شعر مستعار؟
Dialogue: 0,0:18:04.24,0:18:07.56,Default,,0000,0000,0000,,كانت هذه ملفوفةً حول عنق شيمودا سينسي
Dialogue: 0,0:18:07.94,0:18:10.94,Default,,0000,0000,0000,,إنّها شعرة من شعر مستعار
Dialogue: 0,0:18:10.94,0:18:14.02,Default,,0000,0000,0000,,نُزعت طبقاتها الخارجية لتسهيل المعالجة
Dialogue: 0,0:18:14.02,0:18:15.73,Default,,0000,0000,0000,,فيمكنك المعرفة من اللمس
Dialogue: 0,0:18:16.56,0:18:21.81,Default,,0000,0000,0000,,وأيضاً، الوحيدة القادرة على تنفيذ هذه الحيلة\Nهي يونيهارا سينسي ذات الشعر الطويل
Dialogue: 0,0:18:22.18,0:18:29.27,Default,,0000,0000,0000,,لا يُعقل! فقد كانت على الأرض أمامي\N!عندما خنقني المجرم
Dialogue: 0,0:18:30.04,0:18:34.79,Default,,0000,0000,0000,,كانت تلك جثّة سوغياما سينسي\N...التي اُكتشفت لاحقاً على الأرجح
Dialogue: 0,0:18:34.79,0:18:37.47,Default,,0000,0000,0000,,...نعم، في الحادثة الأولى
Dialogue: 0,0:18:38.36,0:18:45.12,Default,,0000,0000,0000,,ألبسته نفس ثيابها ليبدو مطابقاً لها، فقد كانت\Nتحتفظ بالجثّة تحت سريرها في الطابق الأوّل
Dialogue: 0,0:18:47.56,0:18:50.34,Default,,0000,0000,0000,,بعد استدراجها لسونوكو من الغرفة المجاورة
Dialogue: 0,0:18:50.85,0:18:54.02,Default,,0000,0000,0000,,هاجمتها من الخلف وأفقدتها وعيها
Dialogue: 0,0:18:54.44,0:18:56.98,Default,,0000,0000,0000,,ثمّ أخفت الجثّة تحت السرير مُجدداً
Dialogue: 0,0:18:57.26,0:18:59.93,Default,,0000,0000,0000,,واستلقت في المكان نفسه
Dialogue: 0,0:19:00.22,0:19:02.84,Default,,0000,0000,0000,,ذلك بعد ترك آثار أقدام في الثلج
Dialogue: 0,0:19:02.84,0:19:05.55,Default,,0000,0000,0000,,كي يبدو أنّ الفاعل هرب\Nمن النافذة بالطبع
Dialogue: 0,0:19:06.89,0:19:11.73,Default,,0000,0000,0000,,هكذا، ستبدو ضحيّةً هاجمها الفاعل
Dialogue: 0,0:19:12.58,0:19:16.27,Default,,0000,0000,0000,,...فيسهل اقترابها من شيمودا سينسي، هدفها التالي
Dialogue: 0,0:19:17.49,0:19:23.82,Default,,0000,0000,0000,,اتّصلت به يونيهارا سينسي عندما كان\N:مقفلاً على نفسه، وأخبرته بالتالي غالباً
Dialogue: 0,0:19:24.91,0:19:28.97,Default,,0000,0000,0000,,"أعرف هويّة الفاعل، أدخلني وسأخبرك"
Dialogue: 0,0:19:33.35,0:19:35.56,Default,,0000,0000,0000,,كما تتوقّع من ابنة المتحرّي الشهير
Dialogue: 0,0:19:36.62,0:19:38.99,Default,,0000,0000,0000,,أصبتِ، هذا شعر مستعار
Dialogue: 0,0:19:39.90,0:19:44.99,Default,,0000,0000,0000,,لكنّي ارتديته لإخفاء شعري\Nالذي قصّرته فوق اللازم فحسب
Dialogue: 0,0:19:44.99,0:19:46.71,Default,,0000,0000,0000,,لا يثبت شيئاً
Dialogue: 0,0:19:47.56,0:19:49.44,Default,,0000,0000,0000,,لا فائدة يا سينسي
Dialogue: 0,0:19:49.44,0:19:54.16,Default,,0000,0000,0000,,يوجد دليل في الشعر المستعار\Nيثبت أنّك القاتلة
Dialogue: 0,0:19:55.77,0:20:01.52,Default,,0000,0000,0000,,ألا تذكرين؟ كانت هناك آثار خدوش\Nعلى رقبة شيمودا سينسي
Dialogue: 0,0:20:03.05,0:20:06.87,Default,,0000,0000,0000,,...لذا لا بدّ من وجوده في الشعر المستعار
Dialogue: 0,0:20:07.25,0:20:10.78,Default,,0000,0000,0000,,!دم يطابق تلك الآثار تماماً
Dialogue: 0,0:20:12.21,0:20:17.03,Default,,0000,0000,0000,,كان دافعك هي "ميناكو" التي\Nكانت مكتوبة على أيدي الضحايا غالباً
Dialogue: 0,0:20:17.53,0:20:18.70,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:20:19.07,0:20:21.24,Default,,0000,0000,0000,,فعلتُ هذا لأجلها
Dialogue: 0,0:20:21.24,0:20:26.42,Default,,0000,0000,0000,,للأخذ بثأر تلميذتي التي قُتلت قبل \Nثلاثة أعوام، موتشيزوكي ميناكو
Dialogue: 0,0:20:26.95,0:20:28.24,Default,,0000,0000,0000,,قُـ-قُتلت؟
Dialogue: 0,0:20:29.06,0:20:32.95,Default,,0000,0000,0000,,أتتني قبل ثلاثة أعوام، قرابة هذا الوقت
Dialogue: 0,0:20:33.60,0:20:37.44,Default,,0000,0000,0000,,قالت أنّ هناك مُعلّمين يساعدون\Nعلى الغشّ في اختبارات القبول
Dialogue: 0,0:20:38.68,0:20:43.61,Default,,0000,0000,0000,,،أخبرتني أنّ أحدهما سوغياما سينسي\Nلكن لم تذكر الآخر
Dialogue: 0,0:20:44.94,0:20:47.39,Default,,0000,0000,0000,,قالت أنّها مصدومة بما أنّها تقدّر المعلّمين
Dialogue: 0,0:20:47.39,0:20:49.24,Default,,0000,0000,0000,,فطلبت مني التحقق منهم
Dialogue: 0,0:20:50.31,0:20:54.85,Default,,0000,0000,0000,,في اليوم التالي، وجدناها مشنوقة\Nفي غرفة نادي كرة الطائرة
Dialogue: 0,0:20:55.98,0:20:59.63,Default,,0000,0000,0000,,لكنّي كنت أعرف أنّ سوغياما سينسي وآخر معه
Dialogue: 0,0:20:59.63,0:21:02.31,Default,,0000,0000,0000,,قتلاها لإبقائها صامتة
Dialogue: 0,0:21:03.63,0:21:09.26,Default,,0000,0000,0000,,لذا جمعتُ المعلّمين الذين كانت تقدّرهم\Nوخططت لرحلة التزلّج هذه
Dialogue: 0,0:21:09.75,0:21:13.83,Default,,0000,0000,0000,,تعرفون النتيجة، اكتشفتُ أنّه كان شيمودا سينسي فوراً
Dialogue: 0,0:21:13.83,0:21:16.31,Default,,0000,0000,0000,,!لـ-لكن، لم يكن عليك قتلهما
Dialogue: 0,0:21:16.31,0:21:21.15,Default,,0000,0000,0000,,لم أستطع مسامحتهما! خانا تلميذةً\N!كانت تقدّرهما وقتلاها
Dialogue: 0,0:21:21.15,0:21:23.47,Default,,0000,0000,0000,,!لم أسامحهما كمعلّمة
Dialogue: 0,0:21:25.03,0:21:28.44,Default,,0000,0000,0000,,لكن لا حقّ لي بالكلام
Dialogue: 0,0:21:28.44,0:21:33.05,Default,,0000,0000,0000,,فقد هاجمتُ سوزوكي-سان لأجل حيلتي
Dialogue: 0,0:21:33.69,0:21:36.82,Default,,0000,0000,0000,,آسفة على كوني معلّمة مروّعة
Dialogue: 0,0:23:04.68,0:23:05.74,Default,,0000,0000,0000,,تمهلي
Dialogue: 0,0:23:06.79,0:23:11.03,Default,,0000,0000,0000,,كما اتّفقنا، سأكتب مقالةً عن استنتاجاتك المبهرة
Dialogue: 0,0:23:11.03,0:23:12.67,Default,,0000,0000,0000,,يا متحرّية المدرسة الثانوية
Dialogue: 0,0:23:13.24,0:23:14.52,Default,,0000,0000,0000,,افعل ما تشاء
Dialogue: 0,0:23:25.56,0:23:27.07,Default,,0000,0000,0000,,...ران، أنا
Dialogue: 0,0:23:27.76,0:23:28.97,Default,,0000,0000,0000,,...شينتشي
Dialogue: 0,0:23:30.24,0:23:31.10,Default,,0000,0000,0000,,...شينتشي
Dialogue: 0,0:23:35.16,0:23:39.89,Default,,0000,0000,0000,,بعد ساعتين، توقفت العاصفة\Nووصلت الشرطة أخيراً
Dialogue: 0,0:23:41.11,0:23:43.82,Default,,0000,0000,0000,,استطعتُ إيقاف المجرم من الهرب بفعلته
Dialogue: 0,0:23:44.31,0:23:47.15,Default,,0000,0000,0000,,...لكنّي لم أستطع أبداً إيقاف
Dialogue: 0,0:23:48.09,0:23:53.99,Default,,0000,0000,0000,,سيل الدموع المنهمرة من أعين\N المتحرّية طيبة القلب
Dialogue: 0,0:24:01.55,0:24:07.00,Default,,0000,0000,0000,,التقط اللاقط الخاص بميتسوهيكو\N!مكالمة مُختطف
Dialogue: 0,0:24:07.79,0:24:11.50,Default,,0000,0000,0000,,إذا لم نجد موقع الأب الذي يتعرض للتهديد\N...والمختطف سريعاً
Dialogue: 0,0:24:11.50,0:24:12.71,Default,,0000,0000,0000,,!ستقع كارثة
Dialogue: 0,0:24:13.58,0:24:15.67,Default,,0000,0000,0000,,!سنمسك بالفاعل
Dialogue: 0,0:24:16.87,0:24:20.00,Default,,0000,0000,0000,,!ذاك الشخص هو الأب المُهدد بلا شكّ
Dialogue: 0,0:24:20.53,0:24:22.17,Default,,0000,0000,0000,,...والمختطِف
Dialogue: 0,0:24:22.82,0:24:24.16,Default,,0000,0000,0000,,!في تلك الشقق
Dialogue: 0,0:24:24.16,0:24:30.15,On Top,,0000,0000,0000,,قضيّة تحديد مكان الاختطاف
Dialogue: 0,0:24:25.24,0:24:26.64,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.58,0:24:29.36,Default,,0000,0000,0000,,قضيّة تحديد مكان الاختطاف
Dialogue: 0,0:24:46.04,0:24:48.27,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.27,0:24:49.95,Default,,0000,0000,0000,,قطار
Dialogue: 0,0:24:50.34,0:24:52.47,Default,,0000,0000,0000,,سندخل العام الجديد في الحلقة\N!القادمة، فلتشاهدوا الفيلم
Dialogue: 0,0:24:52.47,0:24:55.02,Default,,0000,0000,0000,,نتمنّى لكم عيد ميلادٍ مجيد، وعاماً سعيداً

