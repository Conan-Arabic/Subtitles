Dialogue: 0,0:00:01.77,0:00:03.59,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب لامع
Dialogue: 0,0:00:03.59,0:00:07.30,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.30,0:00:10.71,Default,,0000,0000,0000,,!مسرح اليوم قصر فسيح! يلعب خصمي هيجي دوراً كبيراً
Dialogue: 0,0:00:10.71,0:00:12.04,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.04,0:00:14.16,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.16,0:00:16.37,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.40,0:01:57.14,Title,,0000,0000,0000,,{\fad(300,0)} قضيّة سلسلة حوادث الموت الغريبة للعائلة المرموقة\N(الجزء الأوّل)
Dialogue: 0,0:01:52.20,0:01:55.26,Default,,0000,0000,0000,,قضيّة سلسلة حوادث الموت الغريبة للعائلة المرموقة\Nالجزء الأوّل
Dialogue: 0,0:01:58.14,0:02:00.78,Default,,0000,0000,0000,,!يا للقصر الأنيق
Dialogue: 0,0:02:01.15,0:02:04.23,Default,,0000,0000,0000,,كما يُتوقع من قصر رئيس\Nمجموعة شركات ناغاتو
Dialogue: 0,0:02:04.23,0:02:06.24,Default,,0000,0000,0000,,!التي تُكافئ عائلة سونوكو
Dialogue: 0,0:02:06.89,0:02:09.73,Default,,0000,0000,0000,,تعرفين الآنسة سونوكو؟
Dialogue: 0,0:02:09.73,0:02:13.65,Default,,0000,0000,0000,,زارتنا بضعة مرّات في صغرها
Dialogue: 0,0:02:14.05,0:02:16.61,Default,,0000,0000,0000,,رغم أنّ لقب "الآنسة" لا يلائمها
Dialogue: 0,0:02:17.17,0:02:20.51,Default,,0000,0000,0000,,ما الذي يريده شخص بهذا المقام منك؟
Dialogue: 0,0:02:20.51,0:02:25.00,Default,,0000,0000,0000,,!طلب حضور المتحرّي العظيم كوغورو موري شخصياً
Dialogue: 0,0:02:25.00,0:02:27.24,Default,,0000,0000,0000,,!يريد منّي حلّ قضيّة كبيرة
Dialogue: 0,0:02:27.24,0:02:29.63,Default,,0000,0000,0000,,قد يكون مجرّد تحرّي خيانة زوجيّة
Dialogue: 0,0:02:30.16,0:02:31.74,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:02:33.07,0:02:34.65,Default,,0000,0000,0000,,!أأنت بخير؟
Dialogue: 0,0:02:34.90,0:02:37.99,Default,,0000,0000,0000,,ما خطب هذه الحفر حول البركة؟
Dialogue: 0,0:02:37.99,0:02:42.07,Default,,0000,0000,0000,,ننوي زرع أشجار جديدة هنا\Nبنهاية الأسبوع
Dialogue: 0,0:02:42.90,0:02:45.27,On Top,,0000,0000,0000,,أعتذر على التأخر في تقديم نفسي
Dialogue: 0,0:02:45.27,0:02:50.03,On Top,,0000,0000,0000,,أنا تاكي كورانوسكي، كبير خدم العائلة للجيلين السابقين
Dialogue: 0,0:02:46.18,0:02:49.72,CharCard,,0000,0000,0004,,{\fad(300,200)}(تاكي كورانوسكي (72\Nكبير خدم عائلة ناغاتو
Dialogue: 0,0:02:52.49,0:02:54.44,Default,,0000,0000,0000,,!المحيط الداخلي مذهل أيضاً
Dialogue: 0,0:02:54.84,0:02:57.58,Default,,0000,0000,0000,,ينتظركم السيّد في الطابق الثالث
Dialogue: 0,0:03:00.43,0:03:02.57,Default,,0000,0000,0000,,يوجد الكثير من الحرس
Dialogue: 0,0:03:02.74,0:03:05.87,Default,,0000,0000,0000,,بالطبع، فهذه قضيّة كبيرة
Dialogue: 0,0:03:07.00,0:03:09.53,Default,,0000,0000,0000,,ماذا؟ هل رأيتُه قبلاً؟
Dialogue: 0,0:03:13.98,0:03:16.90,Default,,0000,0000,0000,,!ماذا؟! أجد محبوبتك الأولى؟
Dialogue: 0,0:03:17.28,0:03:19.99,Default,,0000,0000,0000,,أنا؟ المتحرّي العظيم موري كوغورو؟
Dialogue: 0,0:03:19.99,0:03:20.87,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:03:20.87,0:03:24.56,On Top,,0000,0000,0000,,...أكّد لي صديقٌ قديم أنّك تستطيع
Dialogue: 0,0:03:20.87,0:03:24.64,CharCard,,0000,0000,0004,,{\fad(3,200)} (60) ناغاتو دوسان\Nرئيس مجموعة شركات ناغاتو
Dialogue: 0,0:03:26.06,0:03:28.68,On Top,,0000,0000,0000,,إيجادها بلمح البصر
Dialogue: 0,0:03:28.82,0:03:33.11,Default,,0000,0000,0000,,لكن لم يكن هناك داعٍ لاستدعائي\Nإذا كانت قضيّة بحث عن شخص فحسب
Dialogue: 0,0:03:33.47,0:03:36.01,Default,,0000,0000,0000,,!يا للأسف، لم تكن قضيّة كبيرة
Dialogue: 0,0:03:38.78,0:03:41.59,Default,,0000,0000,0000,,ألديك صورة لهذه المرأة؟
Dialogue: 0,0:03:41.72,0:03:45.05,Default,,0000,0000,0000,,التقيتُها في المدرسة الابتدائية، فكلّا
Dialogue: 0,0:03:45.58,0:03:47.70,Default,,0000,0000,0000,,لا أتذكر وجهها حتّى
Dialogue: 0,0:03:48.13,0:03:51.94,Default,,0000,0000,0000,,...لكنّي أفكّر بها لسببٍ ما مؤخراً
Dialogue: 0,0:03:52.22,0:03:54.16,Default,,0000,0000,0000,,وأستذكر حُسنها
Dialogue: 0,0:03:55.91,0:03:59.16,Default,,0000,0000,0000,,...قد تحقد عليّ زوجتي الراحلة بكلامي هذا، لكن
Dialogue: 0,0:03:59.78,0:04:01.49,Default,,0000,0000,0000,,لا صور لديّ
Dialogue: 0,0:04:01.49,0:04:05.44,Default,,0000,0000,0000,,لكنّي أعرف اسمها ومكان عيشها التقريبيّ
Dialogue: 0,0:04:05.44,0:04:06.61,Default,,0000,0000,0000,,هيوغا-كن، أخبريه رجاءً
Dialogue: 0,0:04:06.61,0:04:07.62,On Top,,0000,0000,0000,,حسناً
Dialogue: 0,0:04:06.61,0:04:10.31,CharCard,,0000,0000,0004,,{\fad(3,200)} (26) هيوغا ميوكي\Nسكرتيرة الرئيسة ناغاتو
Dialogue: 0,0:04:09.52,0:04:12.53,On Top,,0000,0000,0000,,اسمها أكاغي كوتومي، من محافظة كانيغاوا
Dialogue: 0,0:04:12.73,0:04:15.72,Default,,0000,0000,0000,,بعد التخرّج، تزوّجت في سنّ التاسعة والعشرين
Dialogue: 0,0:04:15.72,0:04:18.55,Default,,0000,0000,0000,,أنجبت وزوجها ياماتو كوهي طفلاً واحداً
Dialogue: 0,0:04:18.55,0:04:21.72,Default,,0000,0000,0000,,لكن اختفى ثلاثتهم فجأةً بعد خمسة أعوام
Dialogue: 0,0:04:21.72,0:04:23.78,Default,,0000,0000,0000,,ألم يهربوا ليلاً فحسب؟
Dialogue: 0,0:04:23.78,0:04:24.48,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:04:24.84,0:04:28.75,Default,,0000,0000,0000,,كما من هو صديقك القديم\N!الذي أوصى بي لك؟
Dialogue: 0,0:04:28.75,0:04:30.28,Default,,0000,0000,0000,,كان أنا
Dialogue: 0,0:04:30.71,0:04:31.98,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:04:31.98,0:04:34.23,Default,,0000,0000,0000,,إنّه الصديق القديم الذي ذكرتُه
Dialogue: 0,0:04:34.70,0:04:37.79,CharCard,,0000,0000,0004,,{\fad(3,200)} هاتّوري هيزو\N الرئيس العام لشرطة أوساكا
Dialogue: 0,0:04:34.70,0:04:38.20,On Top,,0000,0000,0000,,الرئيس العام لشرطة أوساكا، هاتّوري هيزو-كن
Dialogue: 0,0:04:38.39,0:04:40.87,Default,,0000,0000,0000,,!الرئيس العام لشرطة أوساكا؟
Dialogue: 0,0:04:40.99,0:04:44.57,Default,,0000,0000,0000,,الذي يظهر على التلفاز دائماً عندما\Nتقع قضيّة كبيرة في أوساكا؟
Dialogue: 0,0:04:44.57,0:04:47.37,Default,,0000,0000,0000,,...لا عجب أنّه بدا مألوفاً
Dialogue: 0,0:04:47.65,0:04:49.90,Default,,0000,0000,0000,,...لحظة، أيعني ذلك
Dialogue: 0,0:04:50.23,0:04:52.90,Default,,0000,0000,0000,,مرحباً يا كودو! كيف حالك؟
Dialogue: 0,0:04:52.92,0:04:54.59,Default,,0000,0000,0000,,!هاتّوري هيجي
Dialogue: 0,0:04:54.59,0:04:55.61,Default,,0000,0000,0000,,كودو؟
Dialogue: 0,0:04:59.35,0:05:00.99,Default,,0000,0000,0000,,ماذا؟ لم تخبرهما بعد؟
Dialogue: 0,0:05:00.99,0:05:02.86,Default,,0000,0000,0000,,!بالطبع لا يا أحمق
Dialogue: 0,0:05:02.86,0:05:05.32,Default,,0000,0000,0000,,...أتقصد بكودو
Dialogue: 0,0:05:06.09,0:05:10.28,Default,,0000,0000,0000,,!قلتُ "كورو"! أي بُوركت جهودك
Dialogue: 0,0:05:12.59,0:05:15.02,Default,,0000,0000,0000,,لديك ضيوف يا أبي؟
Dialogue: 0,0:05:15.29,0:05:19.29,CharCard,,0000,0190,0004,,{\fad(300,0)} (39) ناغاتو نوبوكو \Nالابنة الكبرى لعائلة ناغاتو
Dialogue: 0,0:05:15.29,0:05:19.29,CharCard,,0240,0000,0004,,{\fad(300,0)}(32) ناغاتو ياسوي\Nالابنة الثانية لعائلة ناغاتو
Dialogue: 0,0:05:16.66,0:05:19.20,On Top,,0000,0000,0000,,عجباً، ليس ضيوفاً فحسب
Dialogue: 0,0:05:19.70,0:05:22.16,On Top,,0000,0000,0000,,بينهم ثعلبة أيضاً
Dialogue: 0,0:05:22.86,0:05:26.23,Default,,0000,0000,0000,,سمعتُ أنّك كنتِ تبيتين هنا
Dialogue: 0,0:05:26.23,0:05:28.23,Default,,0000,0000,0000,,ما الذي تخططين له؟
Dialogue: 0,0:05:28.23,0:05:29.61,Default,,0000,0000,0000,,...على رسلك يا أختي
Dialogue: 0,0:05:29.90,0:05:33.18,Default,,0000,0000,0000,,مهلك يا نوبوكو، أنا غير قادر على الحركة كما ترين
Dialogue: 0,0:05:33.18,0:05:35.39,Default,,0000,0000,0000,,أحتاجها لإرسال ملاحظات للشركة
Dialogue: 0,0:05:35.39,0:05:38.18,Default,,0000,0000,0000,,يمكنك فعل ذلك بآلة فاكس
Dialogue: 0,0:05:38.18,0:05:40.07,Default,,0000,0000,0000,,الأمر ليس بتلك البساطة
Dialogue: 0,0:05:41.06,0:05:42.96,Default,,0000,0000,0000,,ومن أولئك الأشخاص؟
Dialogue: 0,0:05:42.96,0:05:43.98,Default,,0000,0000,0000,,متحرّون
Dialogue: 0,0:05:44.21,0:05:45.54,Default,,0000,0000,0000,,متحرّون؟
Dialogue: 0,0:05:45.54,0:05:47.10,Default,,0000,0000,0000,,لمَ أتوا هنا؟
Dialogue: 0,0:05:47.46,0:05:51.45,Default,,0000,0000,0000,,استدعاهم الرئيس لطلب البحث\N...عن محبوبته الأولى
Dialogue: 0,0:05:53.12,0:05:54.42,Default,,0000,0000,0000,,!لم يسألك أحد
Dialogue: 0,0:05:54.42,0:05:56.28,Default,,0000,0000,0000,,...مهلك
Dialogue: 0,0:05:59.66,0:06:02.29,Default,,0000,0000,0000,,لا يزال معك هذا القلم القذر؟
Dialogue: 0,0:06:02.70,0:06:06.07,Default,,0000,0000,0000,,!لا أهتمّ إذا كان تذكاراً من أبيك، إنّه مقرف
Dialogue: 0,0:06:06.69,0:06:11.32,Default,,0000,0000,0000,,عليكِ الاحتراس يا ياسوي-سان\Nوإلّا ستسرق ميتسواكي-سان منك أيضاً
Dialogue: 0,0:06:12.69,0:06:13.36,Default,,0000,0000,0000,,!أختي
Dialogue: 0,0:06:16.06,0:06:17.52,Default,,0000,0000,0000,,يا للوقاحة
Dialogue: 0,0:06:17.52,0:06:19.23,Default,,0000,0000,0000,,آسف يا هيوغا-كن
Dialogue: 0,0:06:19.23,0:06:23.33,Default,,0000,0000,0000,,إنّها متضايقة لأنّها لم ترتبط برجل\Nفي هذا العمر فحسب
Dialogue: 0,0:06:23.76,0:06:25.65,Default,,0000,0000,0000,,نعم، أعي ذلك
Dialogue: 0,0:06:25.80,0:06:28.35,Default,,0000,0000,0000,,لا أظنّها سترتبط لبقيّة حياتها
Dialogue: 0,0:06:29.53,0:06:32.12,Default,,0000,0000,0000,,سأرجع للمكتب إذاً
Dialogue: 0,0:06:32.12,0:06:36.15,Default,,0000,0000,0000,,هيوغا-كن! أودّ الإعلان عن الأمر الليلة
Dialogue: 0,0:06:36.15,0:06:38.68,Default,,0000,0000,0000,,...لذا إن كنتِ تشفقين على ابني
Dialogue: 0,0:06:39.27,0:06:43.63,Default,,0000,0000,0000,,لا أشفق عليه البتّة، فهذا قدرنا
Dialogue: 0,0:06:44.22,0:06:48.10,Default,,0000,0000,0000,,جمعتنا رابطة لهب لوقتٍ طويل
Dialogue: 0,0:06:48.64,0:06:50.56,Default,,0000,0000,0000,,رابطة لهب؟
Dialogue: 0,0:06:55.38,0:06:59.26,Default,,0000,0000,0000,,كنتما في نفس نادي الكيندو؟
Dialogue: 0,0:06:59.26,0:07:03.72,Default,,0000,0000,0000,,نعم، كان ناغاتو يسحقني كالشيطان دوماً
Dialogue: 0,0:07:04.28,0:07:06.95,Default,,0000,0000,0000,,...بالمناسبة يا هيزو، بخصوص ذاك الموضوع
Dialogue: 0,0:07:06.95,0:07:10.64,Default,,0000,0000,0000,,...نعم، طلبتُ من الحرّاس التحقّق، لكن
Dialogue: 0,0:07:14.57,0:07:15.60,Default,,0000,0000,0000,,!مـ-من أنت؟
Dialogue: 0,0:07:15.60,0:07:17.26,Default,,0000,0000,0000,,ابني هيدومي
Dialogue: 0,0:07:18.39,0:07:20.36,On Top,,0000,0000,0000,,احترق وجهه في حادثة
Dialogue: 0,0:07:20.36,0:07:22.32,On Top,,0000,0000,0000,,عندما كان في المدرسة الثانويّة
Dialogue: 0,0:07:20.51,0:07:24.12,CharCard,,0000,0000,0004,,{\fad(40,300)} (36) ناغاتو هيدومي\Nالابن الأكبر لناغاتو، روائيّ
Dialogue: 0,0:07:22.32,0:07:24.34,On Top,,0000,0000,0000,,...وهو على حاله هذا مُذ آنذاك
Dialogue: 0,0:07:24.68,0:07:28.64,Default,,0000,0000,0000,,أظنّ أنّ العمليات التجميلية الحديثة\Nتستطيع إصلاح معظم الأضرار الآن
Dialogue: 0,0:07:28.64,0:07:30.81,Default,,0000,0000,0000,,لكنّه يعارض الفكرة
Dialogue: 0,0:07:30.88,0:07:34.89,CharCard,,0000,0000,0004,,{\fad(00,400)}(ناغاتو ميتسواكي (36\Nزوج ياسوي (أخذ اسم عائلة ناغاتو)، رئيس ناغاتو للمقاولات
Dialogue: 0,0:07:30.98,0:07:36.80,On Top,,0000,0000,0000,,نعم، حصلنا على نهاية سعيدة الآن\Nبفضل تلك الحادثة
Dialogue: 0,0:07:36.80,0:07:38.23,On Top,,0000,0000,0000,,صحيح يا هيدومي؟
Dialogue: 0,0:07:40.09,0:07:44.18,Default,,0000,0000,0000,,هيدومي، انتظر! ما الذي أغضبك؟
Dialogue: 0,0:07:48.66,0:07:52.30,Default,,0000,0000,0000,,!عيد ميلاد سعيد أيّها الأب
Dialogue: 0,0:07:52.94,0:07:53.59,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:07:54.28,0:07:59.92,Default,,0000,0000,0000,,سأكون مُمتناً لو منحتني\N...منصب الرئيس في المقابل
Dialogue: 0,0:08:01.63,0:08:04.02,Default,,0000,0000,0000,,!أمزح فحسب
Dialogue: 0,0:08:05.25,0:08:07.05,Default,,0000,0000,0000,,عليّ الرجوع لأوساكا
Dialogue: 0,0:08:07.46,0:08:12.42,Default,,0000,0000,0000,,ماذا؟ لن تبقى للاحتفال معنا الليلة؟
Dialogue: 0,0:08:12.42,0:08:14.01,Default,,0000,0000,0000,,فلا يزال هناك ذاك الموضوع
Dialogue: 0,0:08:14.01,0:08:18.32,Default,,0000,0000,0000,,لا تقلق، سأتركه مكاني
Dialogue: 0,0:08:18.81,0:08:22.45,Default,,0000,0000,0000,,لا يزال قليل الخبرة، لكنّ حدسه حاد
Dialogue: 0,0:08:22.45,0:08:25.93,Default,,0000,0000,0000,,سيكون ذا فائدة للمتحرّي موري بلا شك
Dialogue: 0,0:08:25.93,0:08:27.48,Default,,0000,0000,0000,,ذا فائدة؟
Dialogue: 0,0:08:35.26,0:08:36.51,Default,,0000,0000,0000,,!عيد ميلاد سعيد يا أبي
Dialogue: 0,0:08:36.53,0:08:38.37,Default,,0000,0000,0000,,!عيد ميلاد سعيد سيّدي
Dialogue: 0,0:08:39.01,0:08:42.71,Default,,0000,0000,0000,,هناك ما أودّ الإعلان عنه في هذه المناسبة
Dialogue: 0,0:08:42.71,0:08:47.68,Default,,0000,0000,0000,,!سيتزوّج ابني هيدومي وهيوغا ميوكي-سان
Dialogue: 0,0:08:48.83,0:08:51.04,Default,,0000,0000,0000,,أهذا صحيح سيّدي؟
Dialogue: 0,0:08:51.04,0:08:57.64,Default,,0000,0000,0000,,نعم، طلبتُ منها الإقامة هنا\Nكي تعتاد على العيش في المنزل
Dialogue: 0,0:08:57.64,0:08:59.70,Default,,0000,0000,0000,,!هذا السبب إذاً
Dialogue: 0,0:09:01.37,0:09:03.94,Default,,0000,0000,0000,,ماذا؟ أين تذهبين سيّدتي نوبوكو؟
Dialogue: 0,0:09:04.09,0:09:06.05,Default,,0000,0000,0000,,دعها وشأنها
Dialogue: 0,0:09:06.05,0:09:10.01,Default,,0000,0000,0000,,إنّها الفتاة الوحيدة العزباء الآن
Dialogue: 0,0:09:11.55,0:09:14.04,Default,,0000,0000,0000,,...بالمناسبة، لا أرى هيدومي
Dialogue: 0,0:09:14.04,0:09:17.47,Default,,0000,0000,0000,,لا بدّ أنّه يشعر بالإحراج، سأذهب لجلبه
Dialogue: 0,0:09:25.58,0:09:27.98,Default,,0000,0000,0000,,!هاتّوري! تكلّم
Dialogue: 0,0:09:27.98,0:09:28.80,Default,,0000,0000,0000,,أتكلّم بماذا؟
Dialogue: 0,0:09:28.80,0:09:33.32,Default,,0000,0000,0000,,!الدافع الحقيقيّ لجلبك لنا هنا
Dialogue: 0,0:09:33.32,0:09:37.24,Default,,0000,0000,0000,,ليس الأمر هكذا، أردتُ لقاءك فحسب
Dialogue: 0,0:09:37.48,0:09:38.92,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:09:40.23,0:09:42.59,Default,,0000,0000,0000,,...أمزح! في الحقيقة
Dialogue: 0,0:09:45.22,0:09:46.16,Default,,0000,0000,0000,,مرحباً؟
Dialogue: 0,0:09:46.47,0:09:49.37,Default,,0000,0000,0000,,أنا ميتسواكي، هلّا أعطيت الهاتف لأبي؟
Dialogue: 0,0:09:49.67,0:09:55.78,Default,,0000,0000,0000,,،يبدو أنّ سيّدي... نائمٌ الآن\Nكنّا على وشك المغادرة
Dialogue: 0,0:09:56.04,0:09:58.31,Default,,0000,0000,0000,,!لا أجد هيدومي في أيّ مكان
Dialogue: 0,0:09:58.87,0:10:00.27,Default,,0000,0000,0000,,...أين ذهب
Dialogue: 0,0:10:03.65,0:10:04.86,Default,,0000,0000,0000,,!ميتسواكي-ساما
Dialogue: 0,0:10:04.86,0:10:07.00,Default,,0000,0000,0000,,!ما الخطب؟! أين أنت الآن؟
Dialogue: 0,0:10:07.32,0:10:08.90,Default,,0000,0000,0000,,في الغرفة أسفلكم
Dialogue: 0,0:10:08.90,0:10:11.32,Default,,0000,0000,0000,,أطفأ أحدهم الأنوار وهاجمني \N...بشيء حادٍ من الخلف
Dialogue: 0,0:10:16.16,0:10:18.41,Default,,0000,0000,0000,,!أأنت بخير؟
Dialogue: 0,0:10:18.78,0:10:22.59,Default,,0000,0000,0000,,ميتسواكي-سان! ما الذي يجري؟\N!ميتسواكي-سان
Dialogue: 0,0:10:24.68,0:10:25.53,Default,,0000,0000,0000,,!هيدومي-سان
Dialogue: 0,0:10:28.00,0:10:30.04,Default,,0000,0000,0000,,!علينا إيقافه
Dialogue: 0,0:10:33.04,0:10:35.75,Default,,0000,0000,0000,,...لا يمكن... لمَ قد يقوم هيدومي-سان
Dialogue: 0,0:10:37.50,0:10:40.87,Default,,0000,0000,0000,,!تبّاً! لا أستطيع فتحه\N!إنّه مقفل من الداخل
Dialogue: 0,0:10:40.87,0:10:42.57,Default,,0000,0000,0000,,سأذهب لجلب المفتاح البديل
Dialogue: 0,0:10:42.57,0:10:43.32,Default,,0000,0000,0000,,!بسرعة
Dialogue: 0,0:10:43.32,0:10:43.78,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:10:44.36,0:10:46.36,Default,,0000,0000,0000,,!سأكون في الخارج مع الحرّاس
Dialogue: 0,0:10:51.36,0:10:54.24,Default,,0000,0000,0000,,!ميتسواكي-سان! ما الخطب؟\N!ميتسواكي-سان
Dialogue: 0,0:10:55.12,0:10:56.95,Default,,0000,0000,0000,,!حضرة المتحرّي! ها هو المفتاح
Dialogue: 0,0:11:00.37,0:11:01.33,Default,,0000,0000,0000,,!لا أحد
Dialogue: 0,0:11:01.33,0:11:02.33,Default,,0000,0000,0000,,!ذهب خارجاً
Dialogue: 0,0:11:03.18,0:11:06.22,Default,,0000,0000,0000,,!تبّاً! استعمل حبلاً وهرب
Dialogue: 0,0:11:06.22,0:11:08.29,Default,,0000,0000,0000,,!لكن أين ميتسواكي-سان؟
Dialogue: 0,0:11:09.89,0:11:11.25,Default,,0000,0000,0000,,إنّه موجود، أسفلنا
Dialogue: 0,0:11:22.57,0:11:25.24,Default,,0000,0000,0000,,سقط على السياج إذاً؟
Dialogue: 0,0:11:25.24,0:11:30.37,Default,,0000,0000,0000,,أصحيحٌ أنّ الفاعل كان ابن\Nالسيّد ناغاتو، هيدومي-سان؟
Dialogue: 0,0:11:30.37,0:11:31.83,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:11:32.20,0:11:37.79,Default,,0000,0000,0000,,...لم يكن هيدومي-سان! لا بدّ من وجود سببٍ ما
Dialogue: 0,0:11:37.79,0:11:41.31,Default,,0000,0000,0000,,!مهما كان السبب، يبقى قاتلاً
Dialogue: 0,0:11:41.31,0:11:44.58,Default,,0000,0000,0000,,...أرجعوا ميتسواكي-سان لي
Dialogue: 0,0:11:44.89,0:11:48.39,Default,,0000,0000,0000,,لكنّ هيدومي-سان ليس شخصاً\Nيُقدم على أشياء كهذه
Dialogue: 0,0:11:48.39,0:11:51.79,Default,,0000,0000,0000,,كما لا نستطيع الجزم أنّ\N!من رأيناه كان هيدومي-سان
Dialogue: 0,0:11:52.83,0:11:54.09,Default,,0000,0000,0000,,معها حق
Dialogue: 0,0:11:54.09,0:11:57.24,Default,,0000,0000,0000,,ما رأيناه هو شخص بضمادات\Nتلفّ وجهه فحسب
Dialogue: 0,0:11:57.54,0:11:58.56,Default,,0000,0000,0000,,ضمادات؟
Dialogue: 0,0:11:58.56,0:11:59.71,Default,,0000,0000,0000,,...نعم
Dialogue: 0,0:11:59.71,0:12:02.34,Default,,0000,0000,0000,,يعاني هيدومي-سان من حروق على وجهه
Dialogue: 0,0:12:02.91,0:12:05.37,Default,,0000,0000,0000,,رأينا القاتل بعد العاشرة ليلاً بقليل
Dialogue: 0,0:12:05.37,0:12:10.00,Default,,0000,0000,0000,,عندما كان الجميع في غرفة نوم\Nالرئيس في الطابق الثالث
Dialogue: 0,0:12:10.20,0:12:11.62,Default,,0000,0000,0000,,الجميع؟
Dialogue: 0,0:12:11.62,0:12:20.18,Default,,0000,0000,0000,,كان المتواجدون في غرفة النوم هم أنا وهيجي-كن \Nوران وكونان، كما كبير الخدم وياسوي-سان أي 6 أشخاص
Dialogue: 0,0:12:20.69,0:12:23.45,Default,,0000,0000,0000,,ماذا فعلتِ بعدما غادر الجميع؟
Dialogue: 0,0:12:23.45,0:12:25.91,Default,,0000,0000,0000,,بقيتُ في الغرفة جوار الرئيس
Dialogue: 0,0:12:26.51,0:12:32.71,Default,,0000,0000,0000,,أحضّر القاتل ذاك الحبّل بالخطّاف سلفاً\Nللهرب من الشرفة؟
Dialogue: 0,0:12:34.00,0:12:37.56,Default,,0000,0000,0000,,لا شكّ في أنّ القاتل استعمله
Dialogue: 0,0:12:38.17,0:12:41.64,Default,,0000,0000,0000,,فقد كان لا يزال يتأرجح\Nعندما وصلتُ مع الحرس هنا
Dialogue: 0,0:12:42.21,0:12:44.70,Default,,0000,0000,0000,,أين هيدومي-سان إذاً؟
Dialogue: 0,0:12:44.70,0:12:47.79,Default,,0000,0000,0000,,لم نجده في أيّ مكان
Dialogue: 0,0:12:47.79,0:12:51.67,Default,,0000,0000,0000,,بحثنا عنه جميعاً قبل وصول الشرطة
Dialogue: 0,0:12:51.67,0:12:54.57,Default,,0000,0000,0000,,من الجليّ أنّ المجرم\Nهو هيدومي-سان
Dialogue: 0,0:12:54.57,0:12:56.12,Default,,0000,0000,0000,,!لـ-لا يمكن
Dialogue: 0,0:12:56.12,0:13:02.11,Default,,0000,0000,0000,,بأيّ حال، وجدنا سلاح الجريمة\Nوالقبّعة والضمادات الخاصة بالمجرم
Dialogue: 0,0:13:02.11,0:13:03.54,Default,,0000,0000,0000,,...بالتحليل سوف
Dialogue: 0,0:13:03.54,0:13:04.43,Default,,0000,0000,0000,,انظروا
Dialogue: 0,0:13:05.08,0:13:11.00,Default,,0000,0000,0000,,ما هذا الجرح على يد الضحيّة اليمنى؟\Nيبدو أنّه طُعن بشيء
Dialogue: 0,0:13:13.42,0:13:19.67,Default,,0000,0000,0000,,لعلّه من مهاجمة القاتل له بالسكّين\N!أو احتكاك يده بشيء أثناء سقوطه
Dialogue: 0,0:13:20.05,0:13:21.19,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:13:21.29,0:13:22.93,Default,,0000,0000,0000,,ما الخطب يا تاكاغي-كن؟
Dialogue: 0,0:13:23.16,0:13:30.21,Default,,0000,0000,0000,,لم تُظهر كاميرات مراقبة القصر الخارجية\Nمغادرة أيّ أحد بعد الجريمة
Dialogue: 0,0:13:30.33,0:13:32.02,Default,,0000,0000,0000,,...إذاً، القاتل
Dialogue: 0,0:13:32.49,0:13:34.11,Default,,0000,0000,0000,,!لا يزال في القصر
Dialogue: 0,0:13:35.19,0:13:36.41,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:13:35.71,0:13:36.41,Default,,0000,0000,0000,,...انتظر
Dialogue: 0,0:13:36.41,0:13:37.83,Default,,0000,0000,0000,,...الرئيس الآن
Dialogue: 0,0:13:37.83,0:13:39.49,Default,,0000,0000,0000,,...ماذا؟! الرئيس
Dialogue: 0,0:13:45.49,0:13:47.27,Default,,0000,0000,0000,,!تبّاً، إنّه مُقفل
Dialogue: 0,0:13:47.27,0:13:49.46,Default,,0000,0000,0000,,!أيوجد أحد في الداخل؟
Dialogue: 0,0:13:50.06,0:13:51.87,Default,,0000,0000,0000,,لمَ هذه الجلبة؟
Dialogue: 0,0:13:52.23,0:13:54.37,Default,,0000,0000,0000,,ما الذي جمعكم؟
Dialogue: 0,0:13:54.76,0:13:57.13,Default,,0000,0000,0000,,ما الذي تفعلينه هنا؟
Dialogue: 0,0:13:57.13,0:14:00.79,Default,,0000,0000,0000,,أتيتُ بعدما سمعت الضوضاء
Dialogue: 0,0:14:00.79,0:14:03.24,Default,,0000,0000,0000,,أين كنتِ قبل قدومك؟
Dialogue: 0,0:14:04.08,0:14:08.33,Default,,0000,0000,0000,,كنتُ منفعلة، فجلستُ أشرب في غرفتي
Dialogue: 0,0:14:08.33,0:14:09.50,Default,,0000,0000,0000,,بمفردك؟
Dialogue: 0,0:14:09.77,0:14:12.93,Default,,0000,0000,0000,,أجل، بينما أتذمر لصديق لي على الهاتف
Dialogue: 0,0:14:13.78,0:14:16.93,Default,,0000,0000,0000,,رغم أنّي لا أذكر من كان بسبب الشراب
Dialogue: 0,0:14:17.40,0:14:21.40,Default,,0000,0000,0000,,بغضّ النظر عن ذلك، أصحيحٌ أنّ هيدومي\Nقتل ميتسواكي-سان؟
Dialogue: 0,0:14:21.40,0:14:23.23,Default,,0000,0000,0000,,...نعم، على الأرجح
Dialogue: 0,0:14:23.23,0:14:26.54,Default,,0000,0000,0000,,كما ظننت، توقّعت حصول ذلك يوماً ما
Dialogue: 0,0:14:28.69,0:14:32.57,Default,,0000,0000,0000,,فقد كانا يتشاجران كلّما تقابلا
Dialogue: 0,0:14:33.38,0:14:37.43,Default,,0000,0000,0000,,يبدو أنّهما كانا على وفاق في الماضي\Nبما أنّهما صديقا طفولة
Dialogue: 0,0:14:37.43,0:14:40.41,Default,,0000,0000,0000,,لكن أصبحا كثيري الشجار\Nبعد تلك الحادثة
Dialogue: 0,0:14:40.41,0:14:41.87,Default,,0000,0000,0000,,تلك الحادثة؟
Dialogue: 0,0:14:42.09,0:14:46.83,Default,,0000,0000,0000,,نعم، نشب حريق كبير في نُزل مجاور\Nقبل عشرين عاماً
Dialogue: 0,0:14:47.25,0:14:52.20,Default,,0000,0000,0000,,مرّ به هيدومي وميتسواكي-سان\Nاللذين كانا طالبين في الثانويّة وقتها
Dialogue: 0,0:14:52.37,0:14:58.01,Default,,0000,0000,0000,,،حاول ميتسواكي-سان إيقاف هيدومي\Nلكنّ الأخير اندفع للنيران
Dialogue: 0,0:14:58.36,0:15:00.86,Default,,0000,0000,0000,,وأنقذ فتاةً صغيرة
Dialogue: 0,0:15:02.31,0:15:05.20,Default,,0000,0000,0000,,!كانت تلك هيوغا ميوكي هذه
Dialogue: 0,0:15:05.20,0:15:09.12,Default,,0000,0000,0000,,فهمت، هذه رابطة اللهب إذاً؟
Dialogue: 0,0:15:09.60,0:15:12.08,Default,,0000,0000,0000,,احترق وجه هيدومي جرّاء ذلك
Dialogue: 0,0:15:12.79,0:15:16.22,Default,,0000,0000,0000,,بعد الحادثة، ترك الدراسة وأغلق على نفسه في غرفته
Dialogue: 0,0:15:16.22,0:15:18.51,Default,,0000,0000,0000,,وتظاهر بتأليف الروايات
Dialogue: 0,0:15:18.89,0:15:21.22,Default,,0000,0000,0000,,لم تقترب منه أيّ فتاة بالطبع
Dialogue: 0,0:15:22.54,0:15:25.38,Default,,0000,0000,0000,,استغلّت ذلك للاقتراب منه
Dialogue: 0,0:15:25.38,0:15:28.33,Default,,0000,0000,0000,,،حصلت على توصية لتكون سكرتيرة أبي
Dialogue: 0,0:15:28.33,0:15:30.62,Default,,0000,0000,0000,,!وفوق ذلك تزوّجت من العائلة
Dialogue: 0,0:15:30.88,0:15:32.82,Default,,0000,0000,0000,,يكفي يا نوبوكو
Dialogue: 0,0:15:33.62,0:15:37.03,Default,,0000,0000,0000,,أبي... كنتَ مستيقظاً؟
Dialogue: 0,0:15:37.03,0:15:40.95,Default,,0000,0000,0000,,نعم، مُذ غادر الجميع الغرفة في هلع
Dialogue: 0,0:15:40.95,0:15:43.28,Default,,0000,0000,0000,,رغم أنّ ذهني مشوّش
Dialogue: 0,0:15:43.28,0:15:45.74,Default,,0000,0000,0000,,هل حصل أمرٌ غريب بعد ذلك؟
Dialogue: 0,0:15:46.19,0:15:52.66,Default,,0000,0000,0000,,لم يحصل شيء، بقيت هيوغا-كن رفقتي\Nطوال الوقت حتّى وصلت ران-سان
Dialogue: 0,0:15:52.85,0:15:57.46,Default,,0000,0000,0000,,لكن لم يعد هذا وقتاً مناسباً\N...للبحث عن محبوبتك الأولى
Dialogue: 0,0:15:58.51,0:16:02.57,Default,,0000,0000,0000,,لا، فلتنسَ الموضوع رجاءً
Dialogue: 0,0:16:07.34,0:16:11.54,Default,,0000,0000,0000,,يكفي مماطلةً وأخبرني\Nلمَ جلبتني هنا؟
Dialogue: 0,0:16:11.54,0:16:13.12,Default,,0000,0000,0000,,ذاك؟
Dialogue: 0,0:16:13.12,0:16:18.00,Default,,0000,0000,0000,,في الواقع، قال الرئيس أنّه سمع\Nأصوات غريبة البارحة
Dialogue: 0,0:16:18.00,0:16:19.46,Default,,0000,0000,0000,,أصوات غريبة؟
Dialogue: 0,0:16:19.46,0:16:20.41,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:16:20.41,0:16:24.02,Default,,0000,0000,0000,,صوت ركض أحدهم في الرواق\Nفي منتصف الليل
Dialogue: 0,0:16:24.02,0:16:28.07,Default,,0000,0000,0000,,وصوت اصطدام شيء بشيءٍ آخر، عدّة مرات
Dialogue: 0,0:16:28.07,0:16:29.67,Default,,0000,0000,0000,,...أيمكن أنّ ذلك
Dialogue: 0,0:16:29.91,0:16:32.10,Default,,0000,0000,0000,,نعم، كان أحد سكّان هذا المنزل
Dialogue: 0,0:16:32.10,0:16:36.41,Default,,0000,0000,0000,,!يقوم بشيءٍ لأجل جريمة الليلة
Dialogue: 0,0:16:37.14,0:16:41.89,Default,,0000,0000,0000,,ظننتُ وأبي أنّه مجرّد لصّ يستكشف المكان
Dialogue: 0,0:16:41.89,0:16:44.33,Default,,0000,0000,0000,,فاستدعينا الحرّاس واتّصلنا بكم
Dialogue: 0,0:16:44.33,0:16:47.09,Default,,0000,0000,0000,,اعتقدنا أنّه سيظهر مُجدداً\Nالليلة بلا شكّ
Dialogue: 0,0:16:47.09,0:16:50.79,Default,,0000,0000,0000,,لكنّ ما سُلب كانت حياة شخص
Dialogue: 0,0:16:51.63,0:16:53.24,Default,,0000,0000,0000,,جريمة متعمّدة
Dialogue: 0,0:16:53.54,0:16:55.95,Default,,0000,0000,0000,,لكن ألا ترى الأمر غريباً؟
Dialogue: 0,0:16:56.70,0:17:00.87,Default,,0000,0000,0000,,موري كوغورو الذي أصبح\Nمشهوراً بسببك موجود هنا
Dialogue: 0,0:17:01.24,0:17:05.37,Default,,0000,0000,0000,,لا بدّ أنّ القاتل كان شديد الثقة بخطّته
Dialogue: 0,0:17:05.69,0:17:09.33,Default,,0000,0000,0000,,أو لم يستطع تبديل خطّته
Dialogue: 0,0:17:09.33,0:17:14.60,Default,,0000,0000,0000,,ما يحيّرني هي أدوات القاتل\Nالتي كانت بجوار الجثّة
Dialogue: 0,0:17:14.60,0:17:20.96,Default,,0000,0000,0000,,بعيداً عن السلاح، لم يكن عليه تضييع وقته\Nبخلع القبعة والضمادات وهو يهرب
Dialogue: 0,0:17:21.23,0:17:25.88,Default,,0000,0000,0000,,...وإظهار القاتل لوجهه عمداً لنا
Dialogue: 0,0:17:26.21,0:17:29.20,Default,,0000,0000,0000,,كما لو كان يحاول إلفاق التهمة بهيدومي-سان
Dialogue: 0,0:17:29.46,0:17:35.12,Default,,0000,0000,0000,,الوحيدة القادرة على ذلك هي نوبوكو-سان\Nالتي غادرت غرفة النوم مسبقاً
Dialogue: 0,0:17:37.66,0:17:42.41,Default,,0000,0000,0000,,بعدها، فتّشنا القصر زاوية لزاوية
Dialogue: 0,0:17:42.94,0:17:45.12,Default,,0000,0000,0000,,لكنّنا لم نجد هيدومي-سان أبداً
Dialogue: 0,0:17:45.90,0:17:50.36,Default,,0000,0000,0000,,كنّا والشرطة على وشك الاستسلام\N...بعد ليلتين من وقوع الجريمة
Dialogue: 0,0:17:52.03,0:17:53.89,Default,,0000,0000,0000,,لم أجده في أيّ مكان سيّدي المفتّش
Dialogue: 0,0:17:53.89,0:17:55.03,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:55.18,0:17:58.29,Default,,0000,0000,0000,,!عدم زواج هيدومي كانت غلطتي؟
Dialogue: 0,0:17:58.55,0:18:02.55,Default,,0000,0000,0000,,ماذا إذاً؟ أتقصدين أنّ هيدومي\Nكان يمتنع لأجلي؟
Dialogue: 0,0:18:02.55,0:18:06.67,Default,,0000,0000,0000,,...كلا، قصدتُ أنّه كان يراعيك بلطف
Dialogue: 0,0:18:10.05,0:18:12.28,Default,,0000,0000,0000,,...ميوكي-سان! ا-انتـ
Dialogue: 0,0:18:12.28,0:18:15.24,Default,,0000,0000,0000,,!توقّفي رجاءً! هذه البركة عميقة
Dialogue: 0,0:18:15.24,0:18:20.08,Default,,0000,0000,0000,,!لكنّ ذاك القلم تذكارٌ من أبي\N...دونه، لا أستطيع
Dialogue: 0,0:18:20.62,0:18:22.44,Default,,0000,0000,0000,,!صرّفوا الماء فوراً
Dialogue: 0,0:18:22.44,0:18:23.74,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:18:26.99,0:18:29.70,Default,,0000,0000,0000,,...يا لها من بركة متّسخة
Dialogue: 0,0:18:29.70,0:18:34.07,Default,,0000,0000,0000,,،كانت سيّدة المنزل تربّي أسماك شبوط هنا\N...لكن بعدما فارقت الحياة
Dialogue: 0,0:18:48.37,0:18:51.79,Default,,0000,0000,0000,,!لمَ؟! لمَ حصل هذا؟
Dialogue: 0,0:18:52.10,0:18:54.92,Default,,0000,0000,0000,,!أخي! أخي هيدومي
Dialogue: 0,0:18:54.92,0:18:57.79,Default,,0000,0000,0000,,ما وقت الوفاة المقدّر لهيدومي-سان؟
Dialogue: 0,0:18:57.79,0:19:02.24,Default,,0000,0000,0000,,كان ميتاً لقرابة يوم ونصف إلى يومين غالباً
Dialogue: 0,0:19:02.91,0:19:06.03,Default,,0000,0000,0000,,دُفِع ميتسواكي-سان من الشرفة
Dialogue: 0,0:19:06.03,0:19:09.71,Default,,0000,0000,0000,,عند العاشرة قبل ليلتين، أي قبل 44 ساعة
Dialogue: 0,0:19:10.02,0:19:13.94,Default,,0000,0000,0000,,إذا دخل هيدومي-سان هذه البركة قبل وصولنا
Dialogue: 0,0:19:13.94,0:19:18.13,Default,,0000,0000,0000,,وانتحر غرقاً، ستتصل جميع الخيوط
Dialogue: 0,0:19:18.65,0:19:21.36,Default,,0000,0000,0000,,لكنّ سبب الموت لم يكن الغرق
Dialogue: 0,0:19:21.85,0:19:24.39,Default,,0000,0000,0000,,لا يمكننا الجزم حتّى نجري التشريح
Dialogue: 0,0:19:24.39,0:19:27.51,Default,,0000,0000,0000,,لكنّه تجرّع سمّاً قبل دخوله البركة غالباً
Dialogue: 0,0:19:31.01,0:19:35.45,Default,,0000,0000,0000,,سبب عدم طفو الجثّة هو\Nهذه الصخور في ثيابه
Dialogue: 0,0:19:35.67,0:19:40.75,Default,,0000,0000,0000,,أتقصد أنّ هيدومي-سان دخل البركة\Nوالصخور معه وسمّم نفسه؟
Dialogue: 0,0:19:40.75,0:19:44.41,Default,,0000,0000,0000,,لعلّه لم يرد أن يراه أحد ميتاً
Dialogue: 0,0:19:44.41,0:19:48.70,Default,,0000,0000,0000,,لكن، مهما كانت العداوة\N...بين هيدومي-سان وميتسواكي-سان
Dialogue: 0,0:19:48.70,0:19:50.87,Default,,0000,0000,0000,,...لا يزال القتل أمراً
Dialogue: 0,0:19:50.87,0:19:57.33,Default,,0000,0000,0000,,ذاك مُحتمل، فهيدومي-ساما\Nوالآنسة ياسوي كانا مقرّبين كثيراً
Dialogue: 0,0:19:57.86,0:20:04.73,Default,,0000,0000,0000,,كان يعارض زواجها من ميتسواكي-سان\Nبحدّة حتّى النهاية
Dialogue: 0,0:20:05.03,0:20:09.55,Default,,0000,0000,0000,,...لم يستطع تحمّل فقد أخته الغالية
Dialogue: 0,0:20:09.55,0:20:10.87,Default,,0000,0000,0000,,...لصديقه السيّئ إذاً
Dialogue: 0,0:20:11.60,0:20:12.69,Default,,0000,0000,0000,,يا للفتى المغفل
Dialogue: 0,0:20:12.95,0:20:16.21,Default,,0000,0000,0000,,!مفتّش ميغوري! وصلت نتائج التحليل
Dialogue: 0,0:20:16.21,0:20:17.09,Default,,0000,0000,0000,,اقرأها
Dialogue: 0,0:20:17.09,0:20:17.79,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:20:17.79,0:20:22.49,Default,,0000,0000,0000,,تمّت مطابقة السكّين في مسرح الجريمة مع الجروح"\Nعلى ذراع ميتسواكي-سان
Dialogue: 0,0:20:22.49,0:20:26.24,Default,,0000,0000,0000,,كما تطابق دمّ السكّين مع دم ميتسواكي-سان
Dialogue: 0,0:20:26.70,0:20:33.20,Default,,0000,0000,0000,,أيضاً، الشعيرات في القبعة والضمادات\N"تخصّ هيدومي-سان
Dialogue: 0,0:20:33.48,0:20:36.48,Default,,0000,0000,0000,,...بالمناسبة، كان هناك خيط رفيع بطول متر
Dialogue: 0,0:20:36.48,0:20:38.66,Default,,0000,0000,0000,,في جيب معطف ميتسواكي-سان
Dialogue: 0,0:20:38.86,0:20:40.36,Default,,0000,0000,0000,,خيط رفيع؟
Dialogue: 0,0:20:40.63,0:20:43.49,Default,,0000,0000,0000,,أكان الجرح على كفّه اليمنى\Nمن السكّين أيضاً؟
Dialogue: 0,0:20:43.81,0:20:45.41,Default,,0000,0000,0000,,...كلا، كان مختلفاً لسببٍ ما
Dialogue: 0,0:20:45.54,0:20:49.41,Default,,0000,0000,0000,,ماذا عن فصيلة الدم لصاحب اللعاب على السكّين؟
Dialogue: 0,0:20:49.53,0:20:52.87,Default,,0000,0000,0000,,لم نجد شيئاً، يبدو أنّ السكّين مُسحت
Dialogue: 0,0:20:56.05,0:20:58.62,Default,,0000,0000,0000,,حضرة المفتّش! وجدتُ هذه الورقة\N!في جيب الضحيّة
Dialogue: 0,0:21:00.30,0:21:03.37,Default,,0000,0000,0000,,،لستُ مؤهلاً للزواج بك"
Dialogue: 0,0:21:03.37,0:21:07.83,Default,,0000,0000,0000,,"اخترتُ الموت للتكفير عن الذنوب التي ارتكبتُها
Dialogue: 0,0:21:08.14,0:21:09.95,Default,,0000,0000,0000,,!هـ-هذه وصيّة
Dialogue: 0,0:21:10.28,0:21:12.28,Default,,0000,0000,0000,,!إنّها موجهة لك يا ميوكي-سان
Dialogue: 0,0:21:13.03,0:21:14.94,Default,,0000,0000,0000,,أهذا خطّ كتابة هيدومي-سان؟
Dialogue: 0,0:21:14.94,0:21:16.50,Default,,0000,0000,0000,,أجل، يبدو كذلك
Dialogue: 0,0:21:17.11,0:21:21.93,Default,,0000,0000,0000,,سأجلب بعض كتاباته من غرفته
Dialogue: 0,0:21:23.66,0:21:26.74,Default,,0000,0000,0000,,...ميوكي-سان، هذا القلم الذي أسقطتِه
Dialogue: 0,0:21:29.08,0:21:29.90,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:21:29.90,0:21:31.60,Default,,0000,0000,0000,,دعيها وشأنها
Dialogue: 0,0:21:31.60,0:21:34.95,Default,,0000,0000,0000,,سأعطيها القلم بنفسي لاحقاً
Dialogue: 0,0:21:39.63,0:21:41.86,Default,,0000,0000,0000,,...هيدومي-سان
Dialogue: 0,0:21:42.15,0:21:46.02,Default,,0000,0000,0000,,...قلم الحبر هذا مُحترق جدّاً
Dialogue: 0,0:21:46.58,0:21:47.79,Default,,0000,0000,0000,,...غريب
Dialogue: 0,0:21:47.79,0:21:50.87,Default,,0000,0000,0000,,فعلاً، هذه القضيّة غريبة كثيراً
Dialogue: 0,0:21:50.87,0:21:53.24,Default,,0000,0000,0000,,أكثر الأشياء غرابة هي تلك الوصيّة
Dialogue: 0,0:21:53.63,0:21:57.32,Default,,0000,0000,0000,,"ذكر فيها "الذنوب التي ارتكبتُها
Dialogue: 0,0:21:57.32,0:22:01.21,Default,,0000,0000,0000,,أي أنّه كتبها بعد الجريمة
Dialogue: 0,0:22:01.44,0:22:04.52,Default,,0000,0000,0000,,!لم يكن لديه وقت لكتابة وصيّة آنذاك
Dialogue: 0,0:22:04.52,0:22:09.16,Default,,0000,0000,0000,,،ما يعني أنّ أحدهم زيّفها\N...أو أرغمه على كتابتها
Dialogue: 0,0:22:09.16,0:22:12.76,Default,,0000,0000,0000,,...بأيّ حال، يبدو أنّ لا شكّ في إغراق أحدهم لهيدومي-سان
Dialogue: 0,0:22:12.76,0:22:16.08,Default,,0000,0000,0000,,بعد تسميمه، ووضع الوصيّة معه
Dialogue: 0,0:22:16.08,0:22:19.55,Default,,0000,0000,0000,,لكن الوقت الوحيد الذي\Nاقترب فيه أحد من البركة
Dialogue: 0,0:22:19.55,0:22:22.57,Default,,0000,0000,0000,,كان عندما ذهبنا للبحث عنه\Nبعد وقوع الجريمة فقط
Dialogue: 0,0:22:22.80,0:22:27.96,Default,,0000,0000,0000,,مما يعني أنّ هيدومي-سان\N!قُتل قبل وقوع الجريمة
Dialogue: 0,0:24:01.02,0:24:03.50,Default,,0000,0000,0000,,...أيمكن أنّ هيدومي-سان
Dialogue: 0,0:24:04.03,0:24:07.58,Default,,0000,0000,0000,,...مستحيل! فوقت وفاته المقدّر
Dialogue: 0,0:24:09.75,0:24:11.95,Default,,0000,0000,0000,,!كانت هناك طريقة إذاً
Dialogue: 0,0:24:12.92,0:24:14.08,Default,,0000,0000,0000,,أخبرني يا هاتّوري
Dialogue: 0,0:24:14.66,0:24:19.04,Default,,0000,0000,0000,,أسبق وقتلتَ أحدهم؟
Dialogue: 0,0:24:22.83,0:24:24.04,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:24:24.04,0:24:30.04,On Top,,0000,0000,0000,,قضيّة سلسلة حوادث الموت الغريبة للعائلة المرموقة\Nالجزء الثاني
Dialogue: 0,0:24:24.48,0:24:26.23,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.23,0:24:30.10,Default,,0000,0000,0000,,قضيّة سلسلة حوادث الموت الغريبة للعائلة المرموقة\Nالجزء الثاني
Dialogue: 0,0:24:45.57,0:24:47.91,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.91,0:24:49.91,Default,,0000,0000,0000,,قلم حبر
Dialogue: 0,0:24:50.14,0:24:51.01,Default,,0000,0000,0000,,...الحلقة القادمة
Dialogue: 0,0:24:51.01,0:24:52.74,Default,,0000,0000,0000,,"الحلّ، الحلّ، الحلّ"
Dialogue: 0,0:24:52.74,0:24:54.74,Default,,0000,0000,0000,,"جزء الحلّ"

