Dialogue: 0,0:00:01.65,0:00:03.27,Default,,0000,0000,0000,,،عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.27,0:00:05.31,Default,,0000,0000,0000,,دمية آلية الخروج وخزف محطّم
Dialogue: 0,0:00:05.31,0:00:08.93,Default,,0000,0000,0000,,المنطق المفكّك للغموض مفيد\Nفي مواجهة القلوب الجافّة
Dialogue: 0,0:00:08.93,0:00:12.46,Default,,0000,0000,0000,,!قضية اليوم إرساليّة أولى مثيرة! البهجة تنقلب لرعب
Dialogue: 0,0:00:12.85,0:00:14.81,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:14.81,0:00:16.42,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.16,0:01:57.09,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل الإرسالية الأولى
Dialogue: 0,0:01:52.21,0:01:55.35,Default,,0000,0000,0000,,جريمة قتل الإرسالية الأولى
Dialogue: 0,0:02:22.26,0:02:26.22,On Top,,0000,0000,0000,,مسابقة الإرسالية الأولى\Nلشارع تسوّق بيكا
Dialogue: 0,0:02:28.68,0:02:32.18,Default,,0000,0000,0000,,هذا جميل، من الرائع أن الطقس صحو
Dialogue: 0,0:02:33.47,0:02:34.22,Default,,0000,0000,0000,,يا إلهي
Dialogue: 0,0:02:34.51,0:02:36.01,Default,,0000,0000,0000,,!بالتوفيق
Dialogue: 0,0:02:38.03,0:02:39.30,Default,,0000,0000,0000,,!اجتهدوا
Dialogue: 0,0:02:48.66,0:02:52.62,Default,,0000,0000,0000,,غادرت المجموعة الأولى حديقة بيكا للتوّ
Dialogue: 0,0:02:52.62,0:02:58.21,Default,,0000,0000,0000,,أيّ مركز سيحققه واتارو-كن تحت أنظار\Nفرقة فتيان التحرّي يا ترى؟
Dialogue: 0,0:02:58.40,0:03:00.26,Default,,0000,0000,0000,,!بالتوفيق يا رفاق
Dialogue: 0,0:03:01.09,0:03:02.21,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:03:02.57,0:03:04.21,Default,,0000,0000,0000,,صوّر جيّداً يا ميتسوهيكو
Dialogue: 0,0:03:04.21,0:03:05.80,Default,,0000,0000,0000,,!أنت أيضاً
Dialogue: 0,0:03:07.28,0:03:09.67,Default,,0000,0000,0000,,!كونان-كن! لا تتأخّر
Dialogue: 0,0:03:09.67,0:03:11.39,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:11.39,0:03:14.64,Default,,0000,0000,0000,,لمَ عليّ فعل هذا أيضاً؟
Dialogue: 0,0:03:17.52,0:03:20.46,Default,,0000,0000,0000,,يبقى الأطفال أطفالاً، انطلق
Dialogue: 0,0:03:21.55,0:03:23.55,Default,,0000,0000,0000,,!أبي، أظهر حماساً أكبر
Dialogue: 0,0:03:23.55,0:03:26.47,Default,,0000,0000,0000,,يحوي شارع التسوّق عدداً\Nمن أكبر عملائك
Dialogue: 0,0:03:27.71,0:03:28.91,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:03:41.34,0:03:44.80,Default,,0000,0000,0000,,لمَ قبلنا هذا العمل؟
Dialogue: 0,0:03:44.80,0:03:47.26,Default,,0000,0000,0000,,أليس واضحاً؟
Dialogue: 0,0:03:47.26,0:03:52.72,Default,,0000,0000,0000,,كي ننال حُب العامة! ألححنا عليهم\Nأن يعطونا العمل
Dialogue: 0,0:03:52.72,0:03:56.27,Default,,0000,0000,0000,,!ماذا؟ أي أننا من طلب؟
Dialogue: 0,0:03:56.27,0:03:58.17,Default,,0000,0000,0000,,لديك مشكلة في ذلك يا كونان؟
Dialogue: 0,0:03:59.63,0:04:03.26,Default,,0000,0000,0000,,...لم أسمع بفرقة تحرٍّ كهذه قبلاً
Dialogue: 0,0:04:09.83,0:04:13.50,Default,,0000,0000,0000,,!عبر واتارو-كن محلّ الخضروات للتوّ! كلا
Dialogue: 0,0:04:13.50,0:04:16.93,Default,,0000,0000,0000,,!لن يستطيع شراء دايكون هكذا\Nما الذي سيؤول له الأمر؟
Dialogue: 0,0:04:19.65,0:04:24.90,Default,,0000,0000,0000,,كُلّفت فرقة فتيان التحرّي \Nبتسجيل هذا الحدث
Dialogue: 0,0:04:24.90,0:04:28.44,Default,,0000,0000,0000,,سيُبثّ لاحقاً على محطّة تلفازية محلّية\Nويحصل الأطفال على جوائز
Dialogue: 0,0:04:28.44,0:04:30.38,Default,,0000,0000,0000,,بناءً على مراكزهم
Dialogue: 0,0:04:30.77,0:04:33.84,Default,,0000,0000,0000,,القواعد بسيطة، اذهب بمفردك من حديقة بيكا
Dialogue: 0,0:04:33.84,0:04:37.30,Default,,0000,0000,0000,,لشارع تسوّق بيكا الذي يبعد خمسمئة متر
Dialogue: 0,0:04:37.30,0:04:40.68,Default,,0000,0000,0000,,اشتر الأغراض في قائمة التسوّق وارجع
Dialogue: 0,0:04:40.68,0:04:45.26,Default,,0000,0000,0000,,لا يُسمح للآباء أو المتفرجين الكلام معهم أو مساعدتهم
Dialogue: 0,0:04:45.26,0:04:47.60,Default,,0000,0000,0000,,يمكنهم المراقبة وحسب
Dialogue: 0,0:04:47.60,0:04:49.92,Default,,0000,0000,0000,,لكنّ هذا شاق في الواقع
Dialogue: 0,0:04:49.92,0:04:54.18,Default,,0000,0000,0000,,يرجع بعض الأطفال لطلب المساعدة من أمهاتهم
Dialogue: 0,0:04:54.62,0:04:56.25,Default,,0000,0000,0000,,ويتوه بعضهم
Dialogue: 0,0:04:57.33,0:05:02.09,Default,,0000,0000,0000,,وهناك من يشتري ألعاب وحلويات\Nويرمي قائمة الشراء
Dialogue: 0,0:05:02.70,0:05:06.10,Default,,0000,0000,0000,,ومن يقضي وقته في مركز الألعاب
Dialogue: 0,0:05:06.49,0:05:08.55,Default,,0000,0000,0000,,...يا إلهي، أطفال هذه الأيام
Dialogue: 0,0:05:08.55,0:05:09.81,Default,,0000,0000,0000,,لا أستطيع المشاهدة
Dialogue: 0,0:05:09.81,0:05:10.51,Default,,0000,0000,0000,,فعلاً
Dialogue: 0,0:05:10.81,0:05:13.47,Default,,0000,0000,0000,,أنتم أطفال أيضاً
Dialogue: 0,0:05:19.76,0:05:21.14,Default,,0000,0000,0000,,دور مجموعته الآن
Dialogue: 0,0:05:21.14,0:05:23.68,Default,,0000,0000,0000,,إنّه يُدعى هيروشي-كن، يعيش في حيّنا
Dialogue: 0,0:05:23.68,0:05:25.43,Default,,0000,0000,0000,,...لم يبدأ بعد
Dialogue: 0,0:05:25.76,0:05:28.38,Default,,0000,0000,0000,,!حسناً! لننل منهم
Dialogue: 0,0:05:28.79,0:05:30.34,Default,,0000,0000,0000,,يلعب بمفرده؟
Dialogue: 0,0:05:30.34,0:05:33.21,Default,,0000,0000,0000,,!ما الذي تفعله؟ أسرع
Dialogue: 0,0:05:33.21,0:05:37.95,Default,,0000,0000,0000,,أغراض هيروشي-كن هي فرشاة أسنان\Nوتوفو مقلي وشوغي بوكورو
Dialogue: 0,0:05:37.95,0:05:40.34,Default,,0000,0000,0000,,ما هو الشوغي بوكورو؟
Dialogue: 0,0:05:40.34,0:05:41.59,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:05:41.59,0:05:45.53,Default,,0000,0000,0000,,أليس كيساً للملوك والفيل والبيادق؟
Dialogue: 0,0:05:41.59,0:05:45.53,Thoughts,,0000,0000,15,,(معنى حرفيّ)
Dialogue: 0,0:05:45.53,0:05:46.49,Default,,0000,0000,0000,,!هذه هي
Dialogue: 0,0:05:47.68,0:05:49.27,Default,,0000,0000,0000,,!تلك الشوغي
Dialogue: 0,0:05:49.27,0:05:53.22,Default,,0000,0000,0000,,!يا إلهي، ربما عليكم المشاركة\Nستكون مباراة جيّدة
Dialogue: 0,0:05:54.77,0:05:56.09,Default,,0000,0000,0000,,!انطلق
Dialogue: 0,0:05:56.09,0:05:56.90,Default,,0000,0000,0000,,!لنلحق به
Dialogue: 0,0:06:08.17,0:06:09.60,Default,,0000,0000,0000,,أين ذهب هيروشي-كن؟
Dialogue: 0,0:06:09.60,0:06:11.02,Default,,0000,0000,0000,,لا أجده بأيّ مكان
Dialogue: 0,0:06:11.02,0:06:13.09,Default,,0000,0000,0000,,لا يمكن أنّه ابتعد
Dialogue: 0,0:06:13.59,0:06:16.31,Default,,0000,0000,0000,,هذه المنطقة بقرب منزلك، أليس كذلك؟
Dialogue: 0,0:06:16.31,0:06:17.59,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:06:17.59,0:06:21.05,Default,,0000,0000,0000,,مما يعني أنّ منزله بالقرب كذلك
Dialogue: 0,0:06:21.05,0:06:22.39,Default,,0000,0000,0000,,...أتقصد
Dialogue: 0,0:06:22.39,0:06:24.26,Default,,0000,0000,0000,,ربما عاد للمنزل؟
Dialogue: 0,0:06:24.53,0:06:28.46,Default,,0000,0000,0000,,ليس ذلك، هيروشي-كن طفل وحيد لأبويه، صحيح؟
Dialogue: 0,0:06:28.77,0:06:31.36,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:06:31.36,0:06:36.43,Default,,0000,0000,0000,,كذلك أنا، كنتُ ألعب بمفردي كثيراً مثله
Dialogue: 0,0:06:36.43,0:06:38.89,Default,,0000,0000,0000,,في منزلي، أو بالقرب
Dialogue: 0,0:06:39.64,0:06:41.39,Default,,0000,0000,0000,,!أنت الفاعل
Dialogue: 0,0:06:43.06,0:06:44.89,Default,,0000,0000,0000,,!مُبهر
Dialogue: 0,0:06:45.22,0:06:49.84,Default,,0000,0000,0000,,أيومي-تشان، أيلعب بمفرده في مكان قريب هنا عادةً؟
Dialogue: 0,0:06:49.84,0:06:54.30,Default,,0000,0000,0000,,في الأرض الفارغة، يلعب بمفرده هناك دوماً
Dialogue: 0,0:06:54.30,0:06:55.42,Default,,0000,0000,0000,,لنذهب لها
Dialogue: 0,0:07:00.49,0:07:01.72,Default,,0000,0000,0000,,!ذاك هو! هيروشي-كن
Dialogue: 0,0:07:02.70,0:07:04.14,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:07:07.01,0:07:08.96,Default,,0000,0000,0000,,يا إلهي، مُجدداً؟
Dialogue: 0,0:07:16.19,0:07:18.42,Default,,0000,0000,0000,,...اختفى مرّةً أخرى
Dialogue: 0,0:07:20.27,0:07:22.18,Default,,0000,0000,0000,,...أثر عجلة درّاجة
Dialogue: 0,0:07:22.18,0:07:26.85,Default,,0000,0000,0000,,.إنّه حديث، كما يعمق بعد مسافة\Nربما أصبح أثقل
Dialogue: 0,0:07:26.85,0:07:30.30,Default,,0000,0000,0000,,ما يعني أنّ هيروشي-كن صعد على مؤخرتها
Dialogue: 0,0:07:32.09,0:07:33.32,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:07:33.32,0:07:34.88,Default,,0000,0000,0000,,أين تذهب؟
Dialogue: 0,0:07:34.88,0:07:36.10,Default,,0000,0000,0000,,!انتظرنا
Dialogue: 0,0:07:39.20,0:07:41.17,Default,,0000,0000,0000,,أين تريد الذهاب يا هيروشي-كن؟
Dialogue: 0,0:07:41.17,0:07:43.00,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:07:51.39,0:07:52.44,Default,,0000,0000,0000,,!مع السلامة
Dialogue: 0,0:07:52.44,0:07:53.29,Default,,0000,0000,0000,,مع السلامة
Dialogue: 0,0:08:04.72,0:08:05.67,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:08:13.04,0:08:13.73,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:08:13.73,0:08:14.92,Default,,0000,0000,0000,,!هيروشي-كن
Dialogue: 0,0:08:17.38,0:08:21.03,Default,,0000,0000,0000,,...لوّح بيده ورحل
Dialogue: 0,0:08:21.03,0:08:23.21,Default,,0000,0000,0000,,أيتلاعب بنا؟
Dialogue: 0,0:08:23.21,0:08:25.70,Default,,0000,0000,0000,,...لا أظنّه كذلك
Dialogue: 0,0:08:28.25,0:08:32.56,Default,,0000,0000,0000,,مبنى مهجور؟ ماذا كان يفعل هنا؟
Dialogue: 0,0:08:32.56,0:08:34.21,Default,,0000,0000,0000,,يلعب بمفرده مجدداً؟
Dialogue: 0,0:08:36.67,0:08:38.72,Default,,0000,0000,0000,,وصل أخيراً
Dialogue: 0,0:08:38.72,0:08:40.62,Default,,0000,0000,0000,,إنّه مُتعب حقاً
Dialogue: 0,0:08:41.01,0:08:46.51,Default,,0000,0000,0000,,وصل شارع التسوق أخيراً! هل سيتمكن\Nمن إتمام إرساليته يا ترى؟
Dialogue: 0,0:08:46.51,0:08:48.08,Default,,0000,0000,0000,,!فرشاة الأسنان أوّلاً
Dialogue: 0,0:08:50.79,0:08:53.83,Default,,0000,0000,0000,,!كلا! عليه شراء الفرشاة هنا
Dialogue: 0,0:08:53.83,0:08:56.80,Default,,0000,0000,0000,,ربما ينوي شراء التوفو المقلي أوّلاً
Dialogue: 0,0:09:05.20,0:09:06.68,Default,,0000,0000,0000,,لا أمل في هذا
Dialogue: 0,0:09:06.68,0:09:08.37,Default,,0000,0000,0000,,...هيروشي-كن
Dialogue: 0,0:09:24.85,0:09:28.16,Default,,0000,0000,0000,,!هذا... أثر قطع بشفرة
Dialogue: 0,0:09:28.16,0:09:31.50,Default,,0000,0000,0000,,!ما الذي تفعله يا كونان؟! لنذهب
Dialogue: 0,0:09:31.50,0:09:32.42,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:09:36.71,0:09:38.44,Default,,0000,0000,0000,,قرطاسية؟
Dialogue: 0,0:09:38.44,0:09:40.83,Default,,0000,0000,0000,,ماذا سيشتري هنا؟
Dialogue: 0,0:09:41.20,0:09:43.75,Default,,0000,0000,0000,,!شوغي بوكورو من فضلك
Dialogue: 0,0:09:43.75,0:09:45.67,Default,,0000,0000,0000,,حسناً، شوغي بوكورو
Dialogue: 0,0:09:47.03,0:09:50.04,Default,,0000,0000,0000,,ها هو، الثمن 200 ين
Dialogue: 0,0:09:50.04,0:09:52.69,Default,,0000,0000,0000,,!ذاك هو الشوغي بوكورو؟
Dialogue: 0,0:09:52.69,0:09:54.23,Default,,0000,0000,0000,,!مذهل يا هيروشي-كن
Dialogue: 0,0:09:54.23,0:09:55.52,Default,,0000,0000,0000,,حظّ مُطلق
Dialogue: 0,0:09:55.52,0:09:58.50,Default,,0000,0000,0000,,تبقى اثنان فحسب! ما الذي سيفعله؟
Dialogue: 0,0:09:58.93,0:09:59.62,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:09:59.62,0:10:00.35,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:10:16.38,0:10:17.77,Default,,0000,0000,0000,,!هيروشي-كن! انتبه
Dialogue: 0,0:10:21.33,0:10:22.62,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,0:10:22.62,0:10:24.29,Default,,0000,0000,0000,,!لن نصل في الوقت
Dialogue: 0,0:10:24.29,0:10:25.54,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:27.49,0:10:28.29,Default,,0000,0000,0000,,!انطلقي
Dialogue: 0,0:10:36.36,0:10:38.37,Default,,0000,0000,0000,,...كان ذلك وشيكاً
Dialogue: 0,0:10:40.49,0:10:43.33,Default,,0000,0000,0000,,!لا يمكن! رفعت المكبح الجانبيّ
Dialogue: 0,0:10:43.90,0:10:47.30,Default,,0000,0000,0000,,سابقاً الحبل، والسيّارة الآن! ما الذي يجري؟
Dialogue: 0,0:10:47.67,0:10:48.97,Default,,0000,0000,0000,,ماذا؟ أين هيروشي-كن؟
Dialogue: 0,0:10:48.97,0:10:50.32,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:10:50.32,0:10:52.30,Default,,0000,0000,0000,,هل فقدناه مجدداً؟
Dialogue: 0,0:10:52.30,0:10:55.39,Default,,0000,0000,0000,,!هذا لأنّك لم تكن تصوّر يا ميتسوهيكو
Dialogue: 0,0:10:55.39,0:10:56.46,Default,,0000,0000,0000,,!أنت أيضاً
Dialogue: 0,0:10:56.46,0:10:57.25,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:57.54,0:11:00.71,Default,,0000,0000,0000,,أيمكن أن أحدهم يستهدف هيروشي-كن؟
Dialogue: 0,0:11:01.16,0:11:02.07,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:11:02.07,0:11:03.00,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:11:03.00,0:11:04.85,Default,,0000,0000,0000,,!لنجد هيروشي-كن
Dialogue: 0,0:11:19.43,0:11:21.96,Default,,0000,0000,0000,,!هذه دمية يايبا الخاصة بهيروشي
Dialogue: 0,0:11:21.96,0:11:23.18,Default,,0000,0000,0000,,لكن أين هو؟
Dialogue: 0,0:11:23.18,0:11:25.60,Default,,0000,0000,0000,,!بدأ تنفيذ إرساليته أخيراً
Dialogue: 0,0:11:25.60,0:11:26.31,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:11:26.31,0:11:31.42,Default,,0000,0000,0000,,،هذه لعبة هيروشي-كن الغالية\Nمن الغريب أن يتركها في مكان كهذا
Dialogue: 0,0:11:31.42,0:11:34.00,Default,,0000,0000,0000,,أين ذهب إذاً؟
Dialogue: 0,0:11:34.00,0:11:35.42,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:11:35.42,0:11:39.00,Default,,0000,0000,0000,,لكنه لم يذهب بإرادته، أخذه أحدهم
Dialogue: 0,0:11:39.00,0:11:40.71,Default,,0000,0000,0000,,!اختطفه من هنا
Dialogue: 0,0:11:41.41,0:11:42.56,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:11:42.56,0:11:43.33,Default,,0000,0000,0000,,!من؟
Dialogue: 0,0:11:43.58,0:11:48.79,Default,,0000,0000,0000,,لا أدري، لكن حاول أحدهم قتله\N!بجعلها تبدو حوادث عرضيّة
Dialogue: 0,0:11:48.79,0:11:52.29,Default,,0000,0000,0000,,...فشل مرّتين، ثمّ
Dialogue: 0,0:11:52.29,0:11:54.66,Default,,0000,0000,0000,,!هـ-هـ-هذا سيّئ
Dialogue: 0,0:11:54.66,0:11:56.15,Default,,0000,0000,0000,,!سيُقتل هيروشي-كن
Dialogue: 0,0:11:56.15,0:11:58.25,Default,,0000,0000,0000,,!علينا الاتّصال بالشرطة
Dialogue: 0,0:11:58.70,0:12:01.02,Default,,0000,0000,0000,,لكن هذه مجرد نظرية
Dialogue: 0,0:12:01.02,0:12:03.21,Default,,0000,0000,0000,,لا يقين بأنّ الشرطة ستصدقنا
Dialogue: 0,0:12:03.48,0:12:05.17,Default,,0000,0000,0000,,ماذا نفعل إذاً؟
Dialogue: 0,0:12:05.63,0:12:07.72,Default,,0000,0000,0000,,!لنجد هيروشي-كن بأيّ حال
Dialogue: 0,0:12:07.72,0:12:11.86,Default,,0000,0000,0000,,.يمكننا الاتّصال بالشرطة بعدها\N...آمل أنّي أبالغ بالتفكير
Dialogue: 0,0:12:34.61,0:12:36.11,Default,,0000,0000,0000,,لا جدوى
Dialogue: 0,0:12:36.11,0:12:37.40,Default,,0000,0000,0000,,لم نجده هناك أيضاً
Dialogue: 0,0:12:37.40,0:12:40.00,Default,,0000,0000,0000,,...ربما علينا مخاطبة الشرطة
Dialogue: 0,0:12:40.00,0:12:44.60,Default,,0000,0000,0000,,لحظة! إذا كان يُستهدف، فما سبب ذلك؟
Dialogue: 0,0:12:44.60,0:12:46.96,Default,,0000,0000,0000,,!ربما سيقودنا ذلك إلى مكانه
Dialogue: 0,0:12:48.84,0:12:53.79,Default,,0000,0000,0000,,غينتا، ميتسوهيكو، أعيدا تشغيل\Nتسجيل هيروشي-كن للآن
Dialogue: 0,0:12:57.09,0:13:00.08,Default,,0000,0000,0000,,ماذا؟ أيوجد بالتسجيل شيء غريب؟
Dialogue: 0,0:13:00.08,0:13:02.64,Default,,0000,0000,0000,,لم ألحظ شيئاً
Dialogue: 0,0:13:02.64,0:13:03.71,Default,,0000,0000,0000,,ولا أنا
Dialogue: 0,0:13:06.21,0:13:08.08,Default,,0000,0000,0000,,!كلا! ارجعا أكثر
Dialogue: 0,0:13:09.82,0:13:11.92,Default,,0000,0000,0000,,!أكثر، أكثر
Dialogue: 0,0:13:22.23,0:13:24.69,Default,,0000,0000,0000,,!أعيدا ذاك الجزء وأوقفاه
Dialogue: 0,0:13:29.80,0:13:30.63,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:13:30.63,0:13:31.72,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:31.72,0:13:33.92,Default,,0000,0000,0000,,ما الذي وجدته؟
Dialogue: 0,0:13:34.14,0:13:39.13,Default,,0000,0000,0000,,انظرا بإمعان، يبدو أنّ هيروشي-كن\Nيلوّح لنا في كاميرا غينتا
Dialogue: 0,0:13:40.67,0:13:42.33,Default,,0000,0000,0000,,...لكن في كاميرا ميتسوهيكو
Dialogue: 0,0:13:42.33,0:13:43.82,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:13:43.82,0:13:45.17,Default,,0000,0000,0000,,مرآة عبور؟
Dialogue: 0,0:13:45.17,0:13:48.96,Default,,0000,0000,0000,,كان هيروشي-كن يلوّح لها إذاً؟
Dialogue: 0,0:13:48.96,0:13:50.20,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:50.20,0:13:53.99,Default,,0000,0000,0000,,بشكل أدقّ، يلوّح لانعكاس ما عليها
Dialogue: 0,0:14:05.67,0:14:06.42,Default,,0000,0000,0000,,!النافذة
Dialogue: 0,0:14:06.42,0:14:09.17,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:14:09.17,0:14:12.68,Default,,0000,0000,0000,,!كان يلوّح لأحد في تلك النافذة
Dialogue: 0,0:14:12.68,0:14:16.76,Default,,0000,0000,0000,,صحيح، لم يأت هنا للهو فحسب
Dialogue: 0,0:14:16.76,0:14:20.50,Default,,0000,0000,0000,,...كان لديه دافع! دافع ما
Dialogue: 0,0:14:20.50,0:14:24.96,Default,,0000,0000,0000,,لكن ما علاقة ذلك باختطافه؟
Dialogue: 0,0:14:25.50,0:14:27.70,Default,,0000,0000,0000,,هذا ما سنتحقق منه
Dialogue: 0,0:14:31.95,0:14:33.54,Default,,0000,0000,0000,,يبدو أنّي أصبت
Dialogue: 0,0:14:34.83,0:14:36.30,Default,,0000,0000,0000,,!قبعة هيروشي-كن
Dialogue: 0,0:14:36.30,0:14:38.32,Default,,0000,0000,0000,,أي أنّه في الداخل؟
Dialogue: 0,0:14:40.00,0:14:41.96,On Top,,0000,0000,0000,,خطر \Nهدم مبنى
Dialogue: 0,0:14:41.96,0:14:45.41,Default,,0000,0000,0000,,!موعد الهدم اليوم! لا وقت أمامنا
Dialogue: 0,0:14:46.28,0:14:48.91,Default,,0000,0000,0000,,...حسناً، سأدخل بمفردي و
Dialogue: 0,0:14:48.91,0:14:51.47,Default,,0000,0000,0000,,!هيّا بنا، فرقة فتيان التحرّي
Dialogue: 0,0:15:04.09,0:15:06.59,Default,,0000,0000,0000,,توخّوا الحذر، الأرض واهنة
Dialogue: 0,0:15:12.25,0:15:14.66,Default,,0000,0000,0000,,لا يبدو أنّه هنا
Dialogue: 0,0:15:15.33,0:15:17.17,Default,,0000,0000,0000,,لنصعد الأدراج ونرى
Dialogue: 0,0:15:17.17,0:15:19.87,On Top,,0000,0000,0000,,الدخول ممنوع
Dialogue: 0,0:15:20.65,0:15:22.36,Default,,0000,0000,0000,,لا يمكننا الصعود أكثر
Dialogue: 0,0:15:22.36,0:15:25.21,Default,,0000,0000,0000,,هذا يعني أنّ لا أحد في الأعلى
Dialogue: 0,0:15:25.21,0:15:27.54,Default,,0000,0000,0000,,!يمكننا النزول
Dialogue: 0,0:15:27.95,0:15:29.06,Default,,0000,0000,0000,,قبو؟
Dialogue: 0,0:15:34.73,0:15:36.64,Default,,0000,0000,0000,,أتظنّونه هنا؟
Dialogue: 0,0:15:36.64,0:15:38.54,Default,,0000,0000,0000,,هيروشي-كن! أأنت هنا؟
Dialogue: 0,0:15:38.54,0:15:41.72,Default,,0000,0000,0000,,...لا أرى شيئاً من الظلام
Dialogue: 0,0:15:44.67,0:15:46.22,Default,,0000,0000,0000,,!هيروشي-كن
Dialogue: 0,0:15:51.87,0:15:53.31,Default,,0000,0000,0000,,!جـ-جثّة
Dialogue: 0,0:15:53.31,0:15:54.59,Default,,0000,0000,0000,,!أيمكن أنّ هيروشي-كن ميت أيضاً؟
Dialogue: 0,0:15:57.78,0:15:59.57,Default,,0000,0000,0000,,لا تقلقوا، إنّه حيّ
Dialogue: 0,0:16:01.24,0:16:03.53,Default,,0000,0000,0000,,!رائحة مخدّر
Dialogue: 0,0:16:03.53,0:16:06.92,Default,,0000,0000,0000,,!أي أنّه اُختطف وجلِب هنا... من قِبل القاتل
Dialogue: 0,0:16:06.92,0:16:09.98,Default,,0000,0000,0000,,لكن لمَ توجد جثّة هنا؟
Dialogue: 0,0:16:09.98,0:16:11.82,Default,,0000,0000,0000,,ولمَ هيروشي-كن أيضاً؟
Dialogue: 0,0:16:13.81,0:16:19.59,Default,,0000,0000,0000,,نوى القاتل جعل هذه الجريمة تبدو\Nحادثة وقعت أثناء الهدم
Dialogue: 0,0:16:20.68,0:16:27.50,Default,,0000,0000,0000,,كان الطابق الأوّل مُضعضعاً، إذا سقط أيّ حطام أثناء الهدم
Dialogue: 0,0:16:27.50,0:16:31.83,Default,,0000,0000,0000,,سيُسحق القبو، كانت تلك خطّته
Dialogue: 0,0:16:31.83,0:16:35.62,Default,,0000,0000,0000,,لكنّ هيروشي-كن ظهر
Dialogue: 0,0:16:36.50,0:16:37.79,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:16:39.41,0:16:45.74,Default,,0000,0000,0000,,أشك أنّه شهد الجريمة \Nمن سلوكه فيما بعد
Dialogue: 0,0:16:45.74,0:16:49.41,Default,,0000,0000,0000,,لكنّ القاتل لم يعرف كم رأى بالضبط
Dialogue: 0,0:16:49.94,0:16:52.52,Default,,0000,0000,0000,,...لذا سبقه لشارع التسوق و
Dialogue: 0,0:16:58.58,0:17:00.00,Default,,0000,0000,0000,,لكنّه فشل
Dialogue: 0,0:17:00.51,0:17:05.42,Default,,0000,0000,0000,,قرّر القاتل في النهاية جعله يموت\Nهنا في ما يبدو حادثة هدم
Dialogue: 0,0:17:06.22,0:17:07.37,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:17:08.33,0:17:12.21,Default,,0000,0000,0000,,أنتم أذكياء بالنسبة لأطفال
Dialogue: 0,0:17:12.21,0:17:14.13,Default,,0000,0000,0000,,لكن هذه النهاية
Dialogue: 0,0:17:15.29,0:17:16.21,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:17:26.41,0:17:28.32,Default,,0000,0000,0000,,!سيقتلنا أيضاً
Dialogue: 0,0:17:28.32,0:17:29.94,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:17:29.94,0:17:31.57,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:17:31.57,0:17:32.92,Default,,0000,0000,0000,,!لا
Dialogue: 0,0:17:35.38,0:17:38.01,Default,,0000,0000,0000,,تأخّر كونان-كن والبقية
Dialogue: 0,0:17:38.01,0:17:42.22,Default,,0000,0000,0000,,لم يرجع هيروشي-كن بعد، ماذا حصل يا ترى؟
Dialogue: 0,0:17:42.22,0:17:46.34,Default,,0000,0000,0000,,يعبثون في مكان غالباً، فيبقى الأطفال أطفالاً
Dialogue: 0,0:17:47.92,0:17:50.29,Default,,0000,0000,0000,,لننته من هذا سريعاً
Dialogue: 0,0:17:58.95,0:18:00.66,Default,,0000,0000,0000,,لا جدوى، لا يتزحزح البتّة
Dialogue: 0,0:18:00.66,0:18:03.99,Default,,0000,0000,0000,,!كلا! لا أريد الموت هنا
Dialogue: 0,0:18:03.99,0:18:05.91,Default,,0000,0000,0000,,!أمي
Dialogue: 0,0:18:05.91,0:18:07.58,Default,,0000,0000,0000,,!أيومي-تشان! اهدئي
Dialogue: 0,0:18:07.58,0:18:11.69,Default,,0000,0000,0000,,كلّ هذا لأنّك رفضت الاتّصال\N!بالشرطة يا كونان
Dialogue: 0,0:18:11.69,0:18:15.73,Default,,0000,0000,0000,,!لكنّك من أراد الدخول هنا
Dialogue: 0,0:18:15.73,0:18:17.58,Default,,0000,0000,0000,,...أ-أجل، لكن
Dialogue: 0,0:18:20.39,0:18:21.78,Default,,0000,0000,0000,,زلزال؟
Dialogue: 0,0:18:21.78,0:18:25.26,Default,,0000,0000,0000,,!كلا، بدأ الهدم
Dialogue: 0,0:18:38.37,0:18:39.63,Default,,0000,0000,0000,,!إنّها النهاية
Dialogue: 0,0:18:39.63,0:18:40.95,Default,,0000,0000,0000,,!لا أمل
Dialogue: 0,0:18:40.95,0:18:41.87,Default,,0000,0000,0000,,!أمّي
Dialogue: 0,0:18:51.07,0:18:53.88,Default,,0000,0000,0000,,ماء جارٍ؟ معقول؟
Dialogue: 0,0:18:54.61,0:18:56.73,Default,,0000,0000,0000,,!قد ننجو يا رفاق
Dialogue: 0,0:19:05.97,0:19:10.54,Default,,0000,0000,0000,,!لا تقلقي، سيرجعون! فالأطفال يبقون أطفالاً
Dialogue: 0,0:19:10.54,0:19:13.71,Default,,0000,0000,0000,,!لكن ماذا لو حلّ مكروه بهم؟
Dialogue: 0,0:19:13.71,0:19:15.79,Default,,0000,0000,0000,,!لنبحث عنهم
Dialogue: 0,0:19:16.13,0:19:18.66,Default,,0000,0000,0000,,!لا تشدّي بهذه القوّة
Dialogue: 0,0:19:20.66,0:19:22.21,Default,,0000,0000,0000,,ما هذا الصوت؟
Dialogue: 0,0:19:37.98,0:19:39.37,Default,,0000,0000,0000,,...أنتم
Dialogue: 0,0:19:40.31,0:19:41.41,Default,,0000,0000,0000,,تفاجأت؟
Dialogue: 0,0:19:41.41,0:19:43.10,Default,,0000,0000,0000,,!عليك ألّا تستهين بنا
Dialogue: 0,0:19:43.10,0:19:45.41,Default,,0000,0000,0000,,!نحن فرقة فتيان التحرّي
Dialogue: 0,0:19:45.41,0:19:47.05,Default,,0000,0000,0000,,للأسف يا سيّد
Dialogue: 0,0:19:47.05,0:19:51.33,Default,,0000,0000,0000,,كان يُفترض أن نُسحق مع الجثّة
Dialogue: 0,0:19:51.33,0:19:55.63,Default,,0000,0000,0000,,لكن انهار حائط القبو بسبب الدعائم الضعيفة
Dialogue: 0,0:19:55.63,0:19:58.50,Default,,0000,0000,0000,,وصادف أنّه يقود لنفق تحت الأرض لحسن الحظ
Dialogue: 0,0:20:18.31,0:20:21.77,Default,,0000,0000,0000,,أيّها السيّد، لديك متجر آخر، صحيح؟
Dialogue: 0,0:20:21.77,0:20:23.14,Default,,0000,0000,0000,,!حمداً لله
Dialogue: 0,0:20:26.23,0:20:29.12,Default,,0000,0000,0000,,توفو مقلي واحد وفرشاة أسنان من فضلك
Dialogue: 0,0:20:43.62,0:20:45.00,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:20:45.00,0:20:47.11,Default,,0000,0000,0000,,ما الذي يجري؟
Dialogue: 0,0:20:47.11,0:20:51.42,Default,,0000,0000,0000,,صحيح! كان متجر تمويناتك هنا، أليس كذلك؟
Dialogue: 0,0:20:51.42,0:20:52.68,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:20:53.86,0:20:57.98,Default,,0000,0000,0000,,خدعني سمسار محتال، وتراكمت ديوني
Dialogue: 0,0:20:57.98,0:21:02.33,Default,,0000,0000,0000,,بحيث لا أستطيع دفعها مهما عملت، وهربت عائلتي
Dialogue: 0,0:21:02.65,0:21:04.81,Default,,0000,0000,0000,,من قتلتُه كان ذاك السمسار
Dialogue: 0,0:21:08.51,0:21:12.18,Default,,0000,0000,0000,,اُستولي على متجري بسبب الديون وأُغلق
Dialogue: 0,0:21:13.68,0:21:16.92,Default,,0000,0000,0000,,لم يكن يرتاده زبائن كثُر كالمتاجر في شارع التسوّق
Dialogue: 0,0:21:16.92,0:21:19.75,Default,,0000,0000,0000,,كان ليُنسى سريعاً
Dialogue: 0,0:21:20.00,0:21:22.38,Default,,0000,0000,0000,,!لكنّ هيروشي-كن تذكّره
Dialogue: 0,0:21:22.38,0:21:26.17,Default,,0000,0000,0000,,!أتى للشراء من متجرك في إرساليته الأولى
Dialogue: 0,0:21:28.57,0:21:30.08,Default,,0000,0000,0000,,!مرحباً
Dialogue: 0,0:21:30.08,0:21:32.54,Default,,0000,0000,0000,,...هـ-هكذا إذاً
Dialogue: 0,0:21:32.54,0:21:36.00,Default,,0000,0000,0000,,وحاولتَ أنت قتله
Dialogue: 0,0:21:36.24,0:21:39.40,Default,,0000,0000,0000,,!آ-آسف يا ولد! سامحني
Dialogue: 0,0:21:40.69,0:21:41.69,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:41.69,0:21:43.42,Default,,0000,0000,0000,,ما الذي تفعلونه؟
Dialogue: 0,0:21:44.23,0:21:48.53,Default,,0000,0000,0000,,!نصر كبير لفرقة فتيان التحرّي
Dialogue: 0,0:23:15.85,0:23:20.62,Default,,0000,0000,0000,,مُدهش، هذا ما حصل؟\Nأحسنتم العمل
Dialogue: 0,0:23:21.42,0:23:26.09,Default,,0000,0000,0000,,يبقى الأطفال أطفالاً حقاً، مُمل تماماً
Dialogue: 0,0:23:26.09,0:23:29.20,Default,,0000,0000,0000,,سأرجع وأستحمّ وأغرق في الشراب
Dialogue: 0,0:23:29.91,0:23:30.96,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:23:32.91,0:23:34.95,Default,,0000,0000,0000,,ماذا؟ أين هيروشي-كن؟
Dialogue: 0,0:23:34.95,0:23:36.82,Default,,0000,0000,0000,,هل اختفى مجدداً؟
Dialogue: 0,0:23:36.82,0:23:38.04,Default,,0000,0000,0000,,!ذاك هو
Dialogue: 0,0:23:42.28,0:23:44.36,Default,,0000,0000,0000,,ما كان الشيئان المتبقيان؟
Dialogue: 0,0:23:44.36,0:23:46.04,Default,,0000,0000,0000,,...حسناً، توفو مقلي
Dialogue: 0,0:23:46.04,0:23:47.35,Default,,0000,0000,0000,,!وفرشاة أسنان
Dialogue: 0,0:23:47.35,0:23:49.79,Default,,0000,0000,0000,,!حسناً! هيّا بنا يا فرقة فتيان التحرّي
Dialogue: 0,0:23:53.89,0:23:58.70,Default,,0000,0000,0000,,ما الذي أفعله؟ أعيش الدور تماماً
Dialogue: 0,0:24:00.12,0:24:02.33,Default,,0000,0000,0000,,ما الذي تنظر له يا كونان-كن؟
Dialogue: 0,0:24:03.13,0:24:05.55,Default,,0000,0000,0000,,كنتُ أشاهد شرفة تلك الشقّة
Dialogue: 0,0:24:08.95,0:24:10.96,Default,,0000,0000,0000,,!قـ-قفزت
Dialogue: 0,0:24:12.54,0:24:16.29,Default,,0000,0000,0000,,...هذه جريمة قتل! ما يعني أنّ الأكثر شبهة
Dialogue: 0,0:24:17.32,0:24:19.96,Default,,0000,0000,0000,,هو هذا الشخص الذي حاول منعها \Nمن القفز على الهاتف
Dialogue: 0,0:24:21.03,0:24:24.08,Default,,0000,0000,0000,,لكن كيف استطاع فعلها من تلك المسافة؟
Dialogue: 0,0:24:24.08,0:24:25.74,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:24.08,0:24:30.08,On Top,,0000,0000,15,,جريمة قتل الرسّامة التوضيحية
Dialogue: 0,0:24:25.74,0:24:29.26,Default,,0000,0000,0000,,جريمة قتل الرسّامة التوضيحية
Dialogue: 0,0:24:45.43,0:24:47.59,Default,,0000,0000,0000,,تلميح الحلقة القادمة
