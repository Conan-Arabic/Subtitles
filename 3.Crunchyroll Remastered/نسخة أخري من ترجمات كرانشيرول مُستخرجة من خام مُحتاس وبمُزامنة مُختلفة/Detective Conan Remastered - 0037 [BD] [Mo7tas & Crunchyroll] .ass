Dialogue: 0,0:00:01.17,0:00:04.23,Default,,0,0,0,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.67,0:00:06.24,Default,,0,0,0,,قضيّة اليوم هي بحث عن شخص
Dialogue: 0,0:00:06.58,0:00:08.24,Default,,0,0,0,,!لا تخمد شعلة الحُب
Dialogue: 0,0:00:08.58,0:00:10.49,Default,,0,0,0,,،يرى الحقيقة في قلوب الناس
Dialogue: 0,0:00:10.49,0:00:12.99,Default,,0,0,0,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:12.99,0:00:15.48,Default,,0,0,0,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:46.60,0:01:50.09,Title,,0,0,0,,{\fad(300,0)}جريمة قتل زهرة الصبّار
Dialogue: 0,0:01:46.60,0:01:50.09,Default,,0,0,0,,جريمة قتل زهرة الصبّار
Dialogue: 0,0:01:59.22,0:02:02.68,Default,,0,0,0,,اسمي أوكايا نوريكو
Dialogue: 0,0:02:02.68,0:02:06.39,Default,,0,0,0,,أتيتُ اليوم لطلب أن تبحث عن عنوان
Dialogue: 0,0:02:06.39,0:02:09.35,Default,,0,0,0,,رجل يُدعى كيتاغاوا تسويوشي-سان
Dialogue: 0,0:02:09.68,0:02:13.59,Default,,0,0,0,,اعذريني على السؤال، لكن ما العلاقة بينكما؟
Dialogue: 0,0:02:13.59,0:02:18.85,Default,,0,0,0,,حسناً، التقيتُه في بداية يونيو في رحلتي لشينشو
Dialogue: 0,0:02:21.59,0:02:25.68,Default,,0,0,0,,لم أفكّر به كثيراً آنذاك
Dialogue: 0,0:02:25.68,0:02:30.30,Default,,0,0,0,,لكنّي شعرت برغبة في رؤيته مؤخراً
Dialogue: 0,0:02:30.59,0:02:36.51,Default,,0,0,0,,!فهمت! أي أنّك وقعتِ في حُبه
Dialogue: 0,0:02:36.89,0:02:39.52,Default,,0,0,0,,أجل... ربما
Dialogue: 0,0:02:40.05,0:02:42.13,Default,,0,0,0,,لا تخجلها
Dialogue: 0,0:02:42.13,0:02:45.72,Default,,0,0,0,,قضيّة بحث بسيطة، لا حاجة لي هنا
Dialogue: 0,0:02:47.14,0:02:48.76,Default,,0,0,0,,هاكِ شاياً
Dialogue: 0,0:02:48.76,0:02:49.77,Default,,0,0,0,,شكراً لك
Dialogue: 0,0:02:50.21,0:02:52.72,Default,,0,0,0,,لمَ هي متوترة لهذا الحد؟
Dialogue: 0,0:02:52.72,0:02:56.01,Default,,0,0,0,,ألديك أيّ دلائل قد تُفيد؟
Dialogue: 0,0:02:56.01,0:02:59.10,Default,,0,0,0,,أجل، رقم لوحة سيّارته
Dialogue: 0,0:02:59.56,0:03:02.01,Default,,0,0,0,,ورسمة لوجهه
Dialogue: 0,0:03:02.01,0:03:05.05,Default,,0,0,0,,إنّه شخصٌ مميّز بالفعل
Dialogue: 0,0:03:06.93,0:03:08.97,Default,,0,0,0,,فهمت، دعي الأمر لي
Dialogue: 0,0:03:09.56,0:03:11.42,Default,,0,0,0,,...رسمة الوجه هذه
Dialogue: 0,0:03:11.97,0:03:13.72,Default,,0,0,0,,شكراً جزيلاً لمساعدتك
Dialogue: 0,0:03:19.35,0:03:22.93,Default,,0,0,0,,ستكون قضيّةً سهلة! بإمكاني استعمال رقم لوحة سيّارته
Dialogue: 0,0:03:22.93,0:03:25.85,Default,,0,0,0,,!لإيجاد عنوانه من إدارة النقل فوراً
Dialogue: 0,0:03:27.39,0:03:32.05,Default,,0,0,0,,أأنت متأكد أنّها تبحث عنه لأنّها تحبّه؟
Dialogue: 0,0:03:32.34,0:03:34.18,Default,,0,0,0,,ما الذي تلمح له؟
Dialogue: 0,0:03:34.47,0:03:37.30,Default,,0,0,0,,...يُقال أن مشاعرك تجاه شخص تظهر بشكل طبيعي
Dialogue: 0,0:03:37.30,0:03:41.67,Default,,0,0,0,,عندما ترسم صورةً له
Dialogue: 0,0:03:41.67,0:03:43.38,Default,,0,0,0,,...لا توحي تلك الرسمة بأيّ
Dialogue: 0,0:03:44.47,0:03:46.05,Default,,0,0,0,,!لا تتفلسف
Dialogue: 0,0:03:46.05,0:03:49.35,Default,,0,0,0,,!إذا كان لديك وقت للتطفّل فأنجز فروضك
Dialogue: 0,0:03:49.96,0:03:51.42,Default,,0,0,0,,أنا ذاهب
Dialogue: 0,0:03:51.42,0:03:52.80,Default,,0,0,0,,!رافقتك السلامة
Dialogue: 0,0:03:53.22,0:03:56.76,Default,,0,0,0,,...كونان-كن، عليك ألّا تتدخل
Dialogue: 0,0:03:56.76,0:03:59.76,Default,,0,0,0,,...حسناً، أوكايا نوريكو-سان، تعيش في
Dialogue: 0,0:04:00.09,0:04:02.13,Default,,0,0,0,,!في عمل أبي
Dialogue: 0,0:04:02.13,0:04:02.72,Default,,0,0,0,,!حسناً
Dialogue: 0,0:04:04.09,0:04:06.18,Default,,0,0,0,,!رأيتُ ما أحتاجه بالفعل
Dialogue: 0,0:04:07.14,0:04:09.22,Default,,0,0,0,,منديل؟ أهو لها؟
Dialogue: 0,0:04:10.72,0:04:12.43,Default,,0,0,0,,!سأغادر قليلاً
Dialogue: 0,0:04:12.43,0:04:13.47,Default,,0,0,0,,!كونان-كن! يا إلهي
Dialogue: 0,0:04:20.05,0:04:25.34,Default,,0,0,0,,حسناً، 3-9-8... منزل سوميري
Dialogue: 0,0:04:26.05,0:04:26.80,Default,,0,0,0,,!ها هو
Dialogue: 0,0:04:28.06,0:04:32.38,Default,,0,0,0,,!شكراً لك على إعادة منديلي
Dialogue: 0,0:04:32.38,0:04:34.05,Default,,0,0,0,,كونان-كن، أتريد شرب كاكاو؟
Dialogue: 0,0:04:34.05,0:04:34.72,Default,,0,0,0,,!أجل
Dialogue: 0,0:04:34.72,0:04:36.35,Default,,0,0,0,,انتظر قليلاً إذاً
Dialogue: 0,0:04:40.63,0:04:42.22,Default,,0,0,0,,لديكِ غرفة جميلة
Dialogue: 0,0:04:42.22,0:04:43.38,Default,,0,0,0,,!شكراً
Dialogue: 0,0:04:43.38,0:04:46.22,Default,,0,0,0,,أخبريني، ما عملك؟
Dialogue: 0,0:04:46.55,0:04:48.06,Default,,0,0,0,,عملي؟
Dialogue: 0,0:04:48.72,0:04:51.38,Default,,0,0,0,,كنتُ موظّفةً في شركة تجارية
Dialogue: 0,0:04:51.38,0:04:52.47,Default,,0,0,0,,لكنّي في فترة راحة الآن
Dialogue: 0,0:04:52.47,0:04:53.68,Default,,0,0,0,,ماذا؟ لمَ؟
Dialogue: 0,0:04:54.22,0:04:57.64,Default,,0,0,0,,أصابني مرض، أنا أتعافى الآن
Dialogue: 0,0:05:00.67,0:05:02.01,Default,,0,0,0,,كيروسين؟
Dialogue: 0,0:05:03.22,0:05:04.80,Default,,0,0,0,,هذا غريب
Dialogue: 0,0:05:04.80,0:05:07.10,Default,,0,0,0,,لم أرَ أيّ موقد غازيّ
Dialogue: 0,0:05:08.56,0:05:11.26,Default,,0,0,0,,بخاخ دفاع عن النفس
Dialogue: 0,0:05:11.26,0:05:13.18,Default,,0,0,0,,ماذا؟ ما هذه الصورة؟
Dialogue: 0,0:05:14.30,0:05:17.18,Default,,0,0,0,,...التاريخ عليها التاسع عشر من مايو
Dialogue: 0,0:05:18.14,0:05:22.84,Default,,0,0,0,,ولد، هل تجد غرفة فتاة أمراً نادراً لهذا الحد؟
Dialogue: 0,0:05:23.84,0:05:25.64,Default,,0,0,0,,...رأيتَ شيئاً محرجاً لي
Dialogue: 0,0:05:26.22,0:05:29.47,Default,,0,0,0,,كان هذا الشاب حبيبي
Dialogue: 0,0:05:29.47,0:05:31.55,Default,,0,0,0,,لكنّه هجرني قبل فترة
Dialogue: 0,0:05:32.09,0:05:35.80,Default,,0,0,0,,لذا أبحث الآن عن حبيبٍ جديد
Dialogue: 0,0:05:35.80,0:05:41.09,Default,,0,0,0,,لكنّ الرجل في الرسمة يبدو مختلفاً كثيراً عنه
Dialogue: 0,0:05:42.55,0:05:48.10,Default,,0,0,0,,ظننتُ ربما لو جرّبتُ صنفاً آخراً\Nقد تجري الأمور على ما يرام
Dialogue: 0,0:05:48.56,0:05:52.55,Default,,0,0,0,,يكفي كلاماً عنّي، أخبرني عن نفسك
Dialogue: 0,0:05:52.55,0:05:54.18,Default,,0,0,0,,!لديك حبيبة بالتأكيد
Dialogue: 0,0:05:54.18,0:05:55.68,Default,,0,0,0,,...كلا
Dialogue: 0,0:05:58.72,0:06:02.55,Default,,0,0,0,,...لم أكتشف الكثير عنها في النهاية
Dialogue: 0,0:06:02.55,0:06:06.72,Default,,0,0,0,,لا يهم، سأنتظر عودة العمّ وحسب
Dialogue: 0,0:06:07.39,0:06:11.09,Default,,0,0,0,,لكن هل سيجده بتلك السهولة حقّاً؟
Dialogue: 0,0:06:15.34,0:06:17.68,Title,,0,0,15,,{\fad(300,0)}بعد أسبوع
Dialogue: 0,0:06:17.68,0:06:20.42,Default,,0,0,0,,!لم أذهب للمربى المائي منذ فترة طويلة
Dialogue: 0,0:06:20.42,0:06:23.63,Default,,0,0,0,,!وأنا أيضاً! أتمنى أن أستطيع لمس دلافين
Dialogue: 0,0:06:24.68,0:06:27.14,Default,,0,0,0,,لكنّ الطقس سيّئ للأسف
Dialogue: 0,0:06:27.14,0:06:29.10,Default,,0,0,0,,رغم أنّها لن تُمطر غالباً
Dialogue: 0,0:06:29.56,0:06:31.72,Default,,0,0,0,,العمّ يعمل مجدداً اليوم
Dialogue: 0,0:06:35.55,0:06:38.81,Default,,0,0,0,,انتقل كيتاغاوا هذا
Dialogue: 0,0:06:38.81,0:06:42.80,Default,,0,0,0,,دون إعطاء عنوانه الجديد لمكتب النقل
Dialogue: 0,0:06:42.80,0:06:45.01,Default,,0,0,0,,قد يستغرق هذا فترة
Dialogue: 0,0:06:47.14,0:06:49.27,Default,,0,0,0,,ظننتُ من الغريب أن تعيّن مُتحريّاً خاصاً
Dialogue: 0,0:06:49.27,0:06:52.97,Default,,0,0,0,,بينما لديها رقم لوحة السيّارة
Dialogue: 0,0:06:52.97,0:06:55.18,Default,,0,0,0,,...هكذا الأمر إذاً
Dialogue: 0,0:07:01.09,0:07:02.55,Default,,0,0,0,,إنّها نوريكو-سان
Dialogue: 0,0:07:03.13,0:07:05.55,Default,,0,0,0,,لكن لمَ تبدو بهذا الحزن
Dialogue: 0,0:07:06.89,0:07:09.31,Default,,0,0,0,,!آسف! تذكّرت أن لديّ ما عليّ فعله فجأةً
Dialogue: 0,0:07:09.88,0:07:11.42,Default,,0,0,0,,!انتظر يا كونان
Dialogue: 0,0:07:11.42,0:07:12.63,Default,,0,0,0,,!كونان-كن
Dialogue: 0,0:07:16.14,0:07:18.06,Default,,0,0,0,,...أزهار وثوب حِداد
Dialogue: 0,0:07:18.06,0:07:19.22,Default,,0,0,0,,ذاهبة لزيارة قبر؟
Dialogue: 0,0:07:40.84,0:07:44.64,Default,,0,0,0,,أتساءل قبر من يكون؟ لا يزال شاهده يبدو حديثاً
Dialogue: 0,0:07:45.18,0:07:46.80,Default,,0,0,0,,نوريكو-سان
Dialogue: 0,0:07:46.80,0:07:48.31,Default,,0,0,0,,سايكي-سان
Dialogue: 0,0:07:49.52,0:07:53.34,Default,,0,0,0,,الوقت يمرّ سريعاً، مضت 6 أشهر مُذ ذاك الوقت
Dialogue: 0,0:07:53.34,0:07:54.18,Default,,0,0,0,,أجل
Dialogue: 0,0:07:54.39,0:07:55.97,Default,,0,0,0,,كيف حال جسدك؟
Dialogue: 0,0:07:55.97,0:07:57.18,Default,,0,0,0,,أفضل بكثير
Dialogue: 0,0:07:57.18,0:07:59.67,Default,,0,0,0,,شكراً على كلّ ما قدّمته
Dialogue: 0,0:07:59.67,0:08:03.34,Default,,0,0,0,,كلا، كلّ ما فعلته هو مساعدتك في إعادة التأهيل
Dialogue: 0,0:08:03.34,0:08:05.60,Default,,0,0,0,,أنتِ من اجتهدت
Dialogue: 0,0:08:05.60,0:08:09.63,Default,,0,0,0,,ما رأيك بأن نحتسي قهوة في مكانٍ ما؟
Dialogue: 0,0:08:09.88,0:08:13.38,Default,,0,0,0,,آسفة، عليّ العودة سريعاً
Dialogue: 0,0:08:13.38,0:08:16.18,Default,,0,0,0,,هكذا إذاً، دعيني أقلّك بسيارتي
Dialogue: 0,0:08:17.22,0:08:20.30,Default,,0,0,0,,لا بأس، شكراً لك
Dialogue: 0,0:08:23.22,0:08:24.93,Default,,0,0,0,,نوريكو-سان
Dialogue: 0,0:08:24.93,0:08:26.22,Default,,0,0,0,,مرحباً
Dialogue: 0,0:08:27.39,0:08:29.39,Default,,0,0,0,,مرحباً
Dialogue: 0,0:08:29.39,0:08:31.05,Default,,0,0,0,,هذا قبر من؟
Dialogue: 0,0:08:31.05,0:08:34.05,Default,,0,0,0,,إنّه قبر صديقي
Dialogue: 0,0:08:34.68,0:08:39.67,Default,,0,0,0,,ظننتُ أنّه قبر حبيب تلك الآنسة
Dialogue: 0,0:08:39.92,0:08:45.14,Default,,0,0,0,,أجل، كان صديقي وخطيبها
Dialogue: 0,0:08:45.47,0:08:48.10,Default,,0,0,0,,خطيبها؟ متى مات؟
Dialogue: 0,0:08:48.10,0:08:51.05,On Top,,0,0,0,,ياماغوتشي تاتسو
Dialogue: 0,0:08:48.60,0:08:51.05,Default,,0,0,0,,أوّل يونيو هذا العام
Dialogue: 0,0:08:51.51,0:08:52.76,Default,,0,0,0,,يونيو؟
Dialogue: 0,0:08:52.76,0:08:55.26,Default,,0,0,0,,!لا شكّ في الأمر، كان الشخص في تلك الصورة
Dialogue: 0,0:08:55.60,0:08:58.85,Default,,0,0,0,,كان هذا الشاب حبيبي
Dialogue: 0,0:08:58.85,0:09:01.26,Default,,0,0,0,,لكنّه هجرني قبل فترة
Dialogue: 0,0:09:02.09,0:09:05.18,Default,,0,0,0,,كذبت نوريكو-سان آنذاك بشأن تعرضها للهجر
Dialogue: 0,0:09:05.89,0:09:08.39,Default,,0,0,0,,كان حبيبها ميتاً في الحقيقة
Dialogue: 0,0:09:08.39,0:09:09.59,Default,,0,0,0,,لمَ؟
Dialogue: 0,0:09:09.59,0:09:12.13,Default,,0,0,0,,أخبرني، كيف مات؟
Dialogue: 0,0:09:12.47,0:09:14.22,Default,,0,0,0,,حادث مروري
Dialogue: 0,0:09:14.22,0:09:17.89,Default,,0,0,0,,كانا يقودان خلال مناطق طبيعية جميلة لشينشو
Dialogue: 0,0:09:17.89,0:09:19.76,Default,,0,0,0,,واصطدما بجرف صخريّ
Dialogue: 0,0:09:22.59,0:09:26.39,Default,,0,0,0,,اعذريني على السؤال، لكن ما العلاقة بينكما؟
Dialogue: 0,0:09:26.39,0:09:31.34,Default,,0,0,0,,التقيتُه في بداية يونيو في رحلتي لشينشو
Dialogue: 0,0:09:33.89,0:09:35.47,Default,,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:09:35.47,0:09:39.10,Default,,0,0,0,,هل التقت به عندما تسبّب خطيبها بالحادث؟
Dialogue: 0,0:09:39.10,0:09:41.76,Default,,0,0,0,,هل سمعتَ باسم كيتاغاوا تسويوشي؟
Dialogue: 0,0:09:42.22,0:09:43.38,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:43.38,0:09:46.14,Default,,0,0,0,,يقود سيّارة رياضية حمراء
Dialogue: 0,0:09:46.14,0:09:47.76,Default,,0,0,0,,سيّارة رياضية حمراء؟
Dialogue: 0,0:09:47.76,0:09:49.06,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,0:09:49.06,0:09:50.76,Default,,0,0,0,,لا، لا شيء
Dialogue: 0,0:09:51.34,0:09:54.43,Default,,0,0,0,,!أخبرني! للأمر علاقة بتلك الآنسة
Dialogue: 0,0:09:54.93,0:09:57.93,Default,,0,0,0,,بنوريكو-سان؟ مـ-من أنت بالضبط؟
Dialogue: 0,0:09:58.22,0:10:00.88,Default,,0,0,0,,أنا إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:10:01.30,0:10:02.63,Default,,0,0,0,,مُتحرٍّ؟
Dialogue: 0,0:10:06.43,0:10:08.68,Default,,0,0,0,,يا للمفاجأة
Dialogue: 0,0:10:08.68,0:10:12.93,Default,,0,0,0,,يمتلك المتحرّي الشهير موري مساعداً مثلك
Dialogue: 0,0:10:13.38,0:10:17.14,Default,,0,0,0,,لا يبدو أنّي سأقنعك بالكلام معي إلّا هكذا
Dialogue: 0,0:10:17.14,0:10:20.01,Default,,0,0,0,,ما الذي تتحرّى عنه إذاً؟
Dialogue: 0,0:10:20.01,0:10:22.97,Default,,0,0,0,,لا أستطيع إعطاءك التفاصيل، لكن هلّا بدأت
Dialogue: 0,0:10:22.97,0:10:26.93,Default,,0,0,0,,بإعطائي اسم خطيب نوريكو-سان الراحل؟
Dialogue: 0,0:10:28.01,0:10:30.55,Default,,0,0,0,,كان اسمه ياماغوتشي تاتسو
Dialogue: 0,0:10:30.55,0:10:32.84,Default,,0,0,0,,عمل في نفس الشركة معها
Dialogue: 0,0:10:33.05,0:10:37.31,Default,,0,0,0,,بدت عليك الدهشة عندما ذكرتُ أمر\N السيّارة الرياضية الحمراء قبل قليل
Dialogue: 0,0:10:38.35,0:10:44.09,Default,,0,0,0,,سمعتُها تتكلم مع الشرطة بعد الحادث في الواقع
Dialogue: 0,0:10:45.14,0:10:47.14,Default,,0,0,0,,سيّارة رياضية حمراء؟
Dialogue: 0,0:10:47.14,0:10:51.88,Default,,0,0,0,,أجل، كان يقودها شاب وفتاة يلاحقاننا
Dialogue: 0,0:10:51.88,0:10:53.47,Default,,0,0,0,,...حاولنا الإفلات منهما ثمّ وقع الحادث
Dialogue: 0,0:10:53.97,0:10:57.81,Default,,0,0,0,,وجدنا أثرين مُختلفين لإطارات في موقع الحادث بالفعل
Dialogue: 0,0:10:57.81,0:10:59.42,Default,,0,0,0,,لكن لمَ قد يقومان بذلك؟
Dialogue: 0,0:10:59.80,0:11:01.80,Default,,0,0,0,,كانا يضايقاننا فقط
Dialogue: 0,0:11:01.80,0:11:06.14,Default,,0,0,0,,كانا مُلتصقين بنا من الوراء بدايةً\Nويضغطان المنبّه باستمرار
Dialogue: 0,0:11:06.14,0:11:09.42,Default,,0,0,0,,وعندما تركناهما يتجاوزاننا، أبطآ وتراجعا
Dialogue: 0,0:11:09.80,0:11:12.38,Default,,0,0,0,,كان الحادث غلطتهما
Dialogue: 0,0:11:12.38,0:11:15.39,Default,,0,0,0,,...حاول تاتسو-سان تفاديهما، لكن
Dialogue: 0,0:11:15.93,0:11:16.97,Default,,0,0,0,,نوريكو-سان
Dialogue: 0,0:11:16.97,0:11:20.88,Default,,0,0,0,,فهمت، نحن نحقق في الحادث
Dialogue: 0,0:11:20.88,0:11:24.34,Default,,0,0,0,,لكن حتّى لو اعتقلناهما، فستكون تهمتها خفيفةً غالباً
Dialogue: 0,0:11:25.05,0:11:26.10,Default,,0,0,0,,!لمَ؟
Dialogue: 0,0:11:26.60,0:11:30.67,Default,,0,0,0,,ربما اختلفت الأمور لو اصطدمتما
Dialogue: 0,0:11:30.67,0:11:35.18,Default,,0,0,0,,لكنّ الحادث الآن يبدو خطأ قيادة من ياماغوتشي-سان وحده
Dialogue: 0,0:11:35.18,0:11:37.35,Default,,0,0,0,,فقد كان مُسرعاً
Dialogue: 0,0:11:39.38,0:11:43.13,Default,,0,0,0,,أتذكرين تصميم تلك السيّارة أو رقم اللوحة؟
Dialogue: 0,0:11:47.43,0:11:48.47,Default,,0,0,0,,أوكايا-سان؟
Dialogue: 0,0:11:49.96,0:11:55.55,Default,,0,0,0,,"أجابت آنذاك بوضوح... بـ "لا أذكر
Dialogue: 0,0:11:55.72,0:11:58.51,Default,,0,0,0,,!قالت أنّها لا تذكر؟
Dialogue: 0,0:11:58.51,0:12:02.13,Default,,0,0,0,,أجل، بدا أنّ هناك ما يُثقل عليها
Dialogue: 0,0:12:02.13,0:12:05.60,Default,,0,0,0,,لم تستطع وصف الاثنين بدقّة أيضاً
Dialogue: 0,0:12:05.60,0:12:11.47,Default,,0,0,0,,وأنهت الشرطة التحقيق بعد شهر\Nلعدم وجود دلائل أخرى
Dialogue: 0,0:12:11.93,0:12:14.43,Default,,0,0,0,,...تلك الدلائل إذاً
Dialogue: 0,0:12:14.93,0:12:17.60,Default,,0,0,0,,أجل، رقم لوحة سيّارته
Dialogue: 0,0:12:18.18,0:12:20.38,Default,,0,0,0,,ورسمة لوجهه
Dialogue: 0,0:12:20.38,0:12:23.51,Default,,0,0,0,,إنّه شخصٌ مميّز بالفعل
Dialogue: 0,0:12:24.05,0:12:28.18,Default,,0,0,0,,!تذكّرت نوريكو-سان رقم لوحة السيّارة ووجهه
Dialogue: 0,0:12:28.18,0:12:30.97,Default,,0,0,0,,...هل إخفاؤها لهذا عن الشرطة
Dialogue: 0,0:12:31.63,0:12:35.22,Default,,0,0,0,,!يعني أنّها تنوي أخذ ثأرها بيديها؟
Dialogue: 0,0:12:40.44,0:12:44.69,Default,,0,0,0,,سايكي-سان! ما كانت إعادة التأهيل\Nالتي تكلمت بشأنها مع نوريكو-سان؟
Dialogue: 0,0:12:45.07,0:12:49.69,Default,,0,0,0,,أنا طبيب، وكنتُ مسؤولاً عن إعادة تأهيلها
Dialogue: 0,0:12:49.69,0:12:52.15,Default,,0,0,0,,كيف كانت في ذاك الوقت؟
Dialogue: 0,0:12:52.73,0:12:56.07,Default,,0,0,0,,اجتهدت بشدّة
Dialogue: 0,0:12:56.49,0:13:01.90,Default,,0,0,0,,أنجزت في 3 أشهر ما يستغرق الآخرين \Nنصف سنة عادةً وغادرت المشفى
Dialogue: 0,0:13:02.69,0:13:04.57,Default,,0,0,0,,أدهشتنا
Dialogue: 0,0:13:04.57,0:13:06.15,Default,,0,0,0,,لا شكّ في الأمر
Dialogue: 0,0:13:06.15,0:13:10.48,Default,,0,0,0,,رغبتها الشديدة في الانتقام\N!هي ما أدّت لتعافيها السريع
Dialogue: 0,0:13:10.73,0:13:14.48,Default,,0,0,0,,!سايكي-سان، لنذهب لمنزل نوريكو-سان الآن
Dialogue: 0,0:13:14.48,0:13:15.82,Default,,0,0,0,,!هيّا! بسرعة
Dialogue: 0,0:13:15.82,0:13:16.90,Default,,0,0,0,,!كونان-كن
Dialogue: 0,0:13:19.31,0:13:22.86,Default,,0,0,0,,عليّ تغيير مشاعر نوريكو-سان بطريقةٍ ما
Dialogue: 0,0:13:22.86,0:13:26.03,Default,,0,0,0,,قبل أن يجد العمّ كيتاغاوا ذاك
Dialogue: 0,0:13:26.03,0:13:28.11,Default,,0,0,0,,...لكن كيف
Dialogue: 0,0:13:28.11,0:13:28.99,Default,,0,0,0,,!مؤلم
Dialogue: 0,0:13:30.35,0:13:34.11,Default,,0,0,0,,آسف، إنّها شوكة صبّار شاكوبا
Dialogue: 0,0:13:34.11,0:13:37.19,Default,,0,0,0,,لا بدّ أنّها سقطت عندما أخذت واحدة
Dialogue: 0,0:13:37.19,0:13:39.52,Default,,0,0,0,,لمنزل صديق مؤخراً
Dialogue: 0,0:13:39.94,0:13:44.15,Default,,0,0,0,,صبّار شاكوبا؟ أكان لياماغوتشي-سان؟
Dialogue: 0,0:13:46.32,0:13:50.15,Default,,0,0,0,,كان يهوى الاعتناء بالصبّار مُذ صغره
Dialogue: 0,0:13:50.15,0:13:53.98,Default,,0,0,0,,أخذتُه كلّه بعد الحادث
Dialogue: 0,0:13:54.40,0:13:57.86,Default,,0,0,0,,لكن طلب أحدهم واحداً
Dialogue: 0,0:13:58.49,0:14:01.73,Default,,0,0,0,,أريد مشاركته مع نوريكو-سان في الواقع
Dialogue: 0,0:14:01.73,0:14:06.07,Default,,0,0,0,,لكن سيذكرها ذلك بياماغوتشي وحسب
Dialogue: 0,0:14:06.07,0:14:08.82,Default,,0,0,0,,لذا لم أخبرها أنّ الصبّار بحوزتي
Dialogue: 0,0:14:09.48,0:14:14.11,Default,,0,0,0,,لحظة! يُعرف صبّار شاكوبا بصبّار الكريسماس أيضاً
Dialogue: 0,0:14:14.11,0:14:15.32,Default,,0,0,0,,...ماذا لو
Dialogue: 0,0:14:15.32,0:14:17.49,Default,,0,0,0,,أخبرني، هل منزلك بعيد من هنا؟
Dialogue: 0,0:14:17.99,0:14:21.44,Default,,0,0,0,,كلا، إنّه في الطريق لمنزل نوريكو-سان
Dialogue: 0,0:14:21.44,0:14:23.27,Default,,0,0,0,,!لنتوقف عنده إذاً
Dialogue: 0,0:14:23.27,0:14:24.15,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:14:26.53,0:14:28.90,Default,,0,0,0,,يبدو أنّ نوريكو-سان لم ترجع بعد
Dialogue: 0,0:14:28.90,0:14:30.06,Default,,0,0,0,,أجل
Dialogue: 0,0:14:30.48,0:14:34.23,Default,,0,0,0,,هذا غريب، لا تعرف متى قد يتّصل بها العمّ
Dialogue: 0,0:14:34.23,0:14:36.69,Default,,0,0,0,,لذا يُفترض أنّها في المنزل
Dialogue: 0,0:14:36.69,0:14:39.52,Default,,0,0,0,,!أيمكن أنّها وجدت عنوان الرجل بالفعل؟
Dialogue: 0,0:14:41.98,0:14:43.98,Default,,0,0,0,,أجل، وكالة موري للتحرّي؟
Dialogue: 0,0:14:43.98,0:14:46.65,Default,,0,0,0,,رجعتَ يا عمّ؟
Dialogue: 0,0:14:46.65,0:14:49.44,Default,,0,0,0,,هل وجدتَ عنوان كيتاغاوا ذاك؟
Dialogue: 0,0:14:49.44,0:14:52.31,Default,,0,0,0,,!أجل، وجدتُه! لم يكن سهلاً
Dialogue: 0,0:14:52.31,0:14:55.03,Default,,0,0,0,,أبليتُ حذائي من العمل
Dialogue: 0,0:14:55.03,0:14:56.78,Default,,0,0,0,,من؟ أهو كونان-كن؟
Dialogue: 0,0:14:56.78,0:15:00.23,Default,,0,0,0,,أنهيتُ اتّصالي بها قبل قليل
Dialogue: 0,0:15:00.23,0:15:01.65,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:15:01.65,0:15:05.48,Default,,0,0,0,,لكنّ ذاك الشاب يعيش مع فتاةٍ شابة سلفاً
Dialogue: 0,0:15:05.48,0:15:07.86,Default,,0,0,0,,...فلا أظنّ مشاعرها سـ
Dialogue: 0,0:15:07.86,0:15:10.27,Default,,0,0,0,,!أعطني العنوان أيضاً
Dialogue: 0,0:15:10.27,0:15:11.52,Default,,0,0,0,,ماذا؟ لمَ أعطيك؟
Dialogue: 0,0:15:11.52,0:15:15.23,Default,,0,0,0,,!علينا الذهاب سريعاً وإلّا قد يُقتل هذان الاثنان
Dialogue: 0,0:15:15.23,0:15:16.86,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:16:47.15,0:16:48.40,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:16:54.90,0:16:56.32,Default,,0,0,0,,!تاتسو-سان
Dialogue: 0,0:17:08.65,0:17:12.23,Default,,0,0,0,,ذهبت نوريكو-سان لإدارة النقل بنفسها غالباً
Dialogue: 0,0:17:12.23,0:17:15.03,Default,,0,0,0,,لإيجاد عنوان كيتاغاوا
Dialogue: 0,0:17:15.03,0:17:19.14,Default,,0,0,0,,لكنها لم تعرف أين انتقل فعيّنت العم
Dialogue: 0,0:17:19.85,0:17:22.65,Default,,0,0,0,,إن كانت بذاك التصميم على إعادة التأهيل
Dialogue: 0,0:17:22.65,0:17:26.90,Default,,0,0,0,,فلا يمكن ردع رغبتها في الثأر على الأرجح
Dialogue: 0,0:17:28.86,0:17:32.56,Default,,0,0,0,,كيف تنوي الانتقام بأيّ حال؟
Dialogue: 0,0:17:33.27,0:17:35.90,Default,,0,0,0,,أخبرني، هل مات ياماغوتشي-سان فورياً؟
Dialogue: 0,0:17:35.90,0:17:41.02,Default,,0,0,0,,كلا، كان لا يزال على قيد الحياة عندما\Nاصطدم بالجرف وفقما يبدو
Dialogue: 0,0:17:41.02,0:17:43.36,Default,,0,0,0,,مات حرقاً
Dialogue: 0,0:17:43.36,0:17:44.27,Default,,0,0,0,,!حرقاً؟
Dialogue: 0,0:17:44.98,0:17:48.98,Default,,0,0,0,,اشتعل بنزين السيّارة قبل أن يتمكن أحد من إخراجه
Dialogue: 0,0:17:50.48,0:17:53.98,Default,,0,0,0,,!هكذا إذاً! لم يكن ذلك كيروسيناً
Dialogue: 0,0:17:54.32,0:17:56.28,Default,,0,0,0,,!بل بنزين غالباً
Dialogue: 0,0:18:35.32,0:18:37.61,Default,,0,0,0,,!أنت... تلك المرأة
Dialogue: 0,0:18:38.03,0:18:40.40,Default,,0,0,0,,يبدو أنّك تتذكرني
Dialogue: 0,0:18:40.40,0:18:42.40,Default,,0,0,0,,!ما الذي تريدينه الآن؟
Dialogue: 0,0:18:42.40,0:18:44.57,Default,,0,0,0,,!لم يكن ذاك الحادث غلطتنا
Dialogue: 0,0:18:44.86,0:18:48.53,Default,,0,0,0,,لا أحتاج أعذارك، ستموتان كلاكما الآن
Dialogue: 0,0:18:48.53,0:18:49.44,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:18:56.94,0:18:58.36,Default,,0,0,0,,!ما الذي تفعلينه؟! هذا فظيع
Dialogue: 0,0:18:58.98,0:19:01.98,Default,,0,0,0,,!أنتما حثالتان بشرّيتان! استعدّا للموت
Dialogue: 0,0:19:01.98,0:19:05.23,Default,,0,0,0,,!ستذوقان نفس معاناة حبيبي الراحل
Dialogue: 0,0:19:05.53,0:19:09.02,Default,,0,0,0,,!أنتِ من فقدت صوابها
Dialogue: 0,0:19:12.65,0:19:13.98,Default,,0,0,0,,!كونان-كن
Dialogue: 0,0:19:14.98,0:19:15.94,Default,,0,0,0,,!السطح
Dialogue: 0,0:19:21.98,0:19:26.03,Default,,0,0,0,,!هناك طريقة واحدة فحسب لإخماد مشاعرها غالباً
Dialogue: 0,0:19:39.69,0:19:41.81,Default,,0,0,0,,!أنت! ما الذي تفعلينه؟
Dialogue: 0,0:19:43.15,0:19:44.78,Default,,0,0,0,,!انتظري
Dialogue: 0,0:19:47.15,0:19:48.98,Default,,0,0,0,,!نوريكو-سان! أوقفي هذه الحماقة
Dialogue: 0,0:19:49.48,0:19:51.52,Default,,0,0,0,,!ابتعدوا! أرجوكم
Dialogue: 0,0:19:51.52,0:19:55.32,Default,,0,0,0,,!فعل هذا لن يعيد ياماغوتشي-سان للحياة
Dialogue: 0,0:19:55.32,0:19:59.23,Default,,0,0,0,,!أعرف! أعرف لكن هذا كلّ ما يسعني فعله
Dialogue: 0,0:19:59.52,0:20:04.23,Default,,0,0,0,,!توقفي! إن أضرمتِ النار ستُصابين بدورك
Dialogue: 0,0:20:04.23,0:20:05.86,Default,,0,0,0,,!لا أهتم
Dialogue: 0,0:20:05.86,0:20:10.44,Default,,0,0,0,,!لا معنى لأيّ مستقبل لي الآن دون تاتسو-سان
Dialogue: 0,0:20:10.44,0:20:13.19,Default,,0,0,0,,...أقل ما يمكنني هو الأخذ بثأرنا من هذين
Dialogue: 0,0:20:25.57,0:20:27.44,Default,,0,0,0,,...أشعر بالإرهاق
Dialogue: 0,0:20:28.11,0:20:29.14,Default,,0,0,0,,كونان-كن
Dialogue: 0,0:20:31.15,0:20:33.98,Default,,0,0,0,,يا لجمال أزهار صبّار شاكوبا هذه
Dialogue: 0,0:20:33.98,0:20:36.36,Default,,0,0,0,,...تتفتح في الشتاء في البلدان الخارجية
Dialogue: 0,0:20:36.36,0:20:38.81,Default,,0,0,0,,فتُقدّم كهدية كريسماس
Dialogue: 0,0:20:38.81,0:20:41.40,Default,,0,0,0,,كما تُسمى بصبّار الكريسماس
Dialogue: 0,0:20:49.81,0:20:53.52,Default,,0,0,0,,صبّار شاكوبا... أهذا لتاتسو-سان؟
Dialogue: 0,0:20:54.82,0:20:59.35,Default,,0,0,0,,أجل، أخذتُ كلّ صبّاراته كتذكار
Dialogue: 0,0:21:17.49,0:21:18.85,Default,,0,0,0,,نوريكو-سان
Dialogue: 0,0:21:18.85,0:21:21.27,Default,,0,0,0,,لعلّ ياماغوتشي فارقنا
Dialogue: 0,0:21:21.27,0:21:25.28,Default,,0,0,0,,لكنّه يعيش في كلّ واحدة من هذه الأزهار
Dialogue: 0,0:21:40.31,0:21:41.81,Default,,0,0,0,,!تاتسو-سان
Dialogue: 0,0:23:28.36,0:23:33.02,Default,,0,0,0,,!كان عليك القدوم! كان المربى المائي رائعاً
Dialogue: 0,0:23:33.02,0:23:35.82,Default,,0,0,0,,!أطعمنا نحن الثلاثة الدلافين
Dialogue: 0,0:23:35.82,0:23:38.36,Default,,0,0,0,,لكنّ غينتا-كن انزلق وسقط
Dialogue: 0,0:23:40.06,0:23:44.86,Default,,0,0,0,,التقط عامل المربى المائي\N!صورةً لتلك اللحظة أيضاً
Dialogue: 0,0:23:44.86,0:23:46.28,Default,,0,0,0,,!انظر
Dialogue: 0,0:23:50.02,0:23:52.73,Default,,0,0,0,,فعلاً، يبدو هذا مُسلياً
Dialogue: 0,0:23:54.61,0:23:56.65,Default,,0,0,0,,يسرّني أنّي لم أذهب
Dialogue: 0,0:24:02.44,0:24:09.84,Default,,0,0,0,,أخذ آبي الوغد وثيقة تأمين تُقدّر بخمس مئة مليون ين عن نيغيشي-سان
