Dialogue: 0,0:00:01.84,0:00:03.55,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.55,0:00:06.86,Default,,0000,0000,0000,,استنتاجات كونان هي دواء القلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.24,0:00:10.58,Default,,0000,0000,0000,,!اليوم حلقة خاصة لكايتو كيد\N!مواجهة بين المتحرّي واللصّ
Dialogue: 0,0:00:10.94,0:00:12.28,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.28,0:00:14.24,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.24,0:00:16.40,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:47.40,0:01:50.32,Default,,0000,0000,0000,,أنا المتحرّي في المدرسة الثانويّة، كودو شينتشي
Dialogue: 0,0:01:50.32,0:01:52.53,Default,,0000,0000,0000,,ذهبتُ مع صديقة طفولتي وزميلتي ران
Dialogue: 0,0:01:52.53,0:01:54.15,Default,,0000,0000,0000,,لحديقة الملاهي
Dialogue: 0,0:01:54.15,0:01:57.44,Default,,0000,0000,0000,,وشاهدتُ هناك رجلاً برداء أسود\Nيعقد صفقة مشبوهة
Dialogue: 0,0:01:57.73,0:02:02.19,Default,,0000,0000,0000,,بينما كنتُ منشغلاً بالمشاهدة، لم أنتبه\N!لرفيقه الذي تسلّل ورائي
Dialogue: 0,0:02:02.60,0:02:05.89,Default,,0000,0000,0000,,أفقدني وعيي، وجعلني أتجرّع سمّاً
Dialogue: 0,0:02:05.89,0:02:09.02,Default,,0000,0000,0000,,!وبعدما أفقت، وجدتُ جسدي متقلّصاً
Dialogue: 0,0:02:09.55,0:02:12.01,Default,,0000,0000,0000,,إذا اكتشفوا أنّ كودو شينتشي\Nلا يزال على قيد الحياة
Dialogue: 0,0:02:12.01,0:02:14.22,Default,,0000,0000,0000,,سيتعرّض جميع من حولي للخطر
Dialogue: 0,0:02:14.22,0:02:17.31,Default,,0000,0000,0000,,أخذت بنصيحة البروفسور آغاسا وأخفيتُ هويّتي
Dialogue: 0,0:02:17.31,0:02:18.80,Default,,0000,0000,0000,,...وعندما سألتني ران عن اسمي، أجبت
Dialogue: 0,0:02:20.66,0:02:21.65,Default,,0000,0000,0000,,"!إيدوغاوا كونان"
Dialogue: 0,0:02:22.21,0:02:25.08,Default,,0000,0000,0000,,بعدها، كي أحصل على معلومات عنهم
Dialogue: 0,0:02:25.08,0:02:28.70,Default,,0000,0000,0000,,انتقلت للعيش مع ران وأبيها\Nالذي يعمل متحرّياً
Dialogue: 0,0:02:30.20,0:02:36.19,Title,,0000,0000,0000,,{\fad(300,0)}كونان ضدّ كايتو كيد
Dialogue: 0,0:02:31.11,0:02:34.15,Default,,0000,0000,0000,,كونان ضدّ كايتو كيد
Dialogue: 0,0:02:41.52,0:02:43.57,Default,,0000,0000,0000,,كايتو 1412؟
Dialogue: 0,0:02:43.57,0:02:48.23,Default,,0000,0000,0000,,نعم! إنّه لصٌّ في منتصف العمر\N!يأسر قلوب كلّ الفتيات الآن
Dialogue: 0,0:02:49.18,0:02:50.47,Default,,0000,0000,0000,,منتصف العمر؟
Dialogue: 0,0:02:50.47,0:02:52.97,Default,,0000,0000,0000,,والدك متحرٍّ ولم تسمعي به؟
Dialogue: 0,0:02:52.97,0:02:56.46,Default,,0000,0000,0000,,لا يعني ذلك أنّي أحبّ متابعة الجرائم
Dialogue: 0,0:02:57.71,0:02:59.68,Default,,0000,0000,0000,,!اسمعيني
Dialogue: 0,0:03:01.29,0:03:05.16,Default,,0000,0000,0000,,تريدين أن يقبض أبي \Nعلى ذاك اللصّ إذاً؟
Dialogue: 0,0:03:05.50,0:03:07.32,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:03:07.32,0:03:13.20,Default,,0000,0000,0000,,تعرفين أنّ متحف بيكا للفنون يعرض مجموعة\Nمن المجوهرات الشهيرة عالمياً الآن، صحيح؟
Dialogue: 0,0:03:13.53,0:03:19.02,Default,,0000,0000,0000,,بينها لؤلؤة النجم الأسود الجالبة\Nللحظّ الحسن التي قدّمها أبي
Dialogue: 0,0:03:19.02,0:03:23.31,Default,,0000,0000,0000,,!وأريد حمايتها من قبضة كايتو 1412 الشرّيرة
Dialogue: 0,0:03:19.70,0:03:23.99,CharCard,,0000,0000,15,,النجم الأسود
Dialogue: 0,0:03:24.48,0:03:29.05,Default,,0000,0000,0000,,لكن لمَ لا تطلبين من الشرطة\Nبدلاً من أبي؟
Dialogue: 0,0:03:29.22,0:03:33.78,Default,,0000,0000,0000,,لا ينفع! ستأخذه الشرطة فوراً إذا اعتقلته
Dialogue: 0,0:03:34.34,0:03:39.75,Default,,0000,0000,0000,,لكن إذا أمسك به والدك، قد نستطيع\N!رؤية وجهه مباشرةً
Dialogue: 0,0:03:39.75,0:03:40.42,Default,,0000,0000,0000,,وجهه؟
Dialogue: 0,0:03:40.42,0:03:43.24,Default,,0000,0000,0000,,أجل! ألا يراودك الفضول حول ملامحه؟
Dialogue: 0,0:03:43.71,0:03:47.87,Default,,0000,0000,0000,,!إنّه 1412، اللصّ الذي أثار الفوضى في العالم بأسره
Dialogue: 0,0:03:47.94,0:03:50.45,Default,,0000,0000,0000,,!لا بدّ أنّه رجل بغاية الوسامة
Dialogue: 0,0:03:50.45,0:03:53.15,Default,,0000,0000,0000,,...مثل هاريسون فورد أو جون لينون
Dialogue: 0,0:03:53.45,0:03:55.61,Default,,0000,0000,0000,,يا لبساطتك
Dialogue: 0,0:03:56.94,0:03:58.54,Default,,0000,0000,0000,,الإشارة خضراء يا سونوكو
Dialogue: 0,0:03:58.54,0:03:59.15,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:03:59.77,0:04:02.24,Default,,0000,0000,0000,,سيكون من الرائع لو كان مثل براد بيت
Dialogue: 0,0:04:18.38,0:04:19.36,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:04:19.36,0:04:20.29,Default,,0000,0000,0000,,!مهلك
Dialogue: 0,0:04:21.32,0:04:22.40,Default,,0000,0000,0000,,!الإشارة حمراء
Dialogue: 0,0:04:22.75,0:04:25.13,Default,,0000,0000,0000,,!لكن كان ذلك شينتشي
Dialogue: 0,0:04:25.84,0:04:27.69,Default,,0000,0000,0000,,...كان هناك
Dialogue: 0,0:04:28.24,0:04:30.15,Default,,0000,0000,0000,,ألم يكن شخصاً يشبهه فحسب؟
Dialogue: 0,0:04:32.94,0:04:35.53,Default,,0000,0000,0000,,!مررتِ بشينتشي-نيتشان في شيبويا؟
Dialogue: 0,0:04:35.78,0:04:36.48,Default,,0000,0000,0000,,...مستحيل
Dialogue: 0,0:04:38.07,0:04:39.40,Default,,0000,0000,0000,,!إنّها الحقيقة
Dialogue: 0,0:04:39.90,0:04:42.90,Default,,0000,0000,0000,,لكنّه لم يكلّمني! أليس هذا فظيعاً؟
Dialogue: 0,0:04:43.07,0:04:45.83,Default,,0000,0000,0000,,!مهلك، لم أذهب لشيبويا
Dialogue: 0,0:04:46.22,0:04:49.32,Default,,0000,0000,0000,,كما لم يرجع جسمي لطبيعته حتّى
Dialogue: 0,0:04:49.61,0:04:54.92,Default,,0000,0000,0000,,،لعلّه شعر بالملل منك فحسب\Nانسي أمر مهووس التحرّي ذاك
Dialogue: 0,0:04:56.38,0:04:59.08,Default,,0000,0000,0000,,صحيح... كانت رفقته فتاة أيضاً
Dialogue: 0,0:04:59.89,0:05:03.35,Default,,0000,0000,0000,,!كان شخصاً آخر بالتأكيد! لا تقلقي
Dialogue: 0,0:05:04.09,0:05:05.11,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:06.91,0:05:09.53,Default,,0000,0000,0000,,بأيّ حال، هل ما قلتِه قبلاً صحيح؟
Dialogue: 0,0:05:09.54,0:05:12.95,Default,,0000,0000,0000,,يريدون منّي القبض على ذلك \Nالمدعوّ بكايتو وما شابه؟
Dialogue: 0,0:05:12.95,0:05:15.36,Default,,0000,0000,0000,,!كايتو 1412
Dialogue: 0,0:05:15.36,0:05:17.77,Default,,0000,0000,0000,,ما خطب رقم 1412؟
Dialogue: 0,0:05:18.15,0:05:21.15,Default,,0000,0000,0000,,لا أحد يعرف أساس ذلك
Dialogue: 0,0:05:21.48,0:05:27.56,Default,,0000,0000,0000,,وفقاً لسونوكو، فهو لصٌّ شهير يسرق\Nالقطع الفنّية والمجوهرات حول العالم
Dialogue: 0,0:05:27.85,0:05:30.77,Default,,0000,0000,0000,,واجتمعت المباحث الفيدرالية ومنظمة\Nالاستخبارات الأمريكية
Dialogue: 0,0:05:30.77,0:05:35.95,Default,,0000,0000,0000,,والشرطة العالمية على ترميزه بالرقم السرّي 1412
Dialogue: 0,0:05:33.19,0:05:36.52,Narration,,0000,0200,15,,{\fad(500,0)}الرقم الإجراميّ العالمي
Dialogue: 0,0:05:36.96,0:05:41.82,Default,,0000,0000,0000,,يُقال أنّ ذاك الرقم تسرّب للناس\Nوأصبحوا يطلقونه عليه
Dialogue: 0,0:05:41.82,0:05:43.78,Default,,0000,0000,0000,,رائحة كذب كبير
Dialogue: 0,0:05:44.21,0:05:47.34,Default,,0000,0000,0000,,لكن يبدو أنّ له لقباً مختلفاً في اليابان
Dialogue: 0,0:05:48.20,0:05:50.73,Default,,0000,0000,0000,,مجرّد تلاعب لفظيّ حتماً
Dialogue: 0,0:05:51.08,0:05:56.77,Default,,0000,0000,0000,,مثل "اللصّ المخبول"، فـ 412 يمكن أن تُقرأ "لصّ" بالإنجليزية\Nبينما تشتق "المخبول" من 1
Dialogue: 0,0:05:58.86,0:06:01.69,Default,,0000,0000,0000,,لا أظنّه كان لقباً يصدر\Nمن رجال مُسنّين هكذا
Dialogue: 0,0:06:02.44,0:06:05.69,Default,,0000,0000,0000,,يا للسخافة، لستُ مهتماً بلصّ
Dialogue: 0,0:06:07.18,0:06:08.90,Default,,0000,0000,0000,,سأخلد للنوم
Dialogue: 0,0:06:08.90,0:06:13.56,Default,,0000,0000,0000,,صحيح، أعطتني سونوكو نسخةً\Nمن رسالة إخطار غريبة
Dialogue: 0,0:06:13.56,0:06:16.94,Default,,0000,0000,0000,,أرسلها كايتو 1412 لمنزلها
Dialogue: 0,0:06:16.94,0:06:18.90,Default,,0000,0000,0000,,رسالة إخطار غريبة؟
Dialogue: 0,0:06:18.90,0:06:22.11,Default,,0000,0000,0000,,لا يمكن فهمها أبداً، إنّها أشبه بالشفرة
Dialogue: 0,0:06:24.42,0:06:26.29,Default,,0000,0000,0000,,،كذبة إبريل"
Dialogue: 0,0:06:26.29,0:06:30.12,Default,,0000,0000,0000,,عندما يقسم القمر الشيئين، سآتي على الأمواج
Dialogue: 0,0:06:30.12,0:06:32.62,Default,,0000,0000,0000,,باسم النجم الأسود
Dialogue: 0,0:06:32.62,0:06:33.86,Default,,0000,0000,0000,,"...كايتو
Dialogue: 0,0:06:34.29,0:06:36.25,Default,,0000,0000,0000,,الباقي مُمزق
Dialogue: 0,0:06:36.49,0:06:41.28,Default,,0000,0000,0000,,ليس باليد حيلة، قام والد سونوكو بتمزيقها\Nفي غضبه عندما وصلته
Dialogue: 0,0:06:41.28,0:06:43.07,Default,,0000,0000,0000,,فلم يكن أمامه سوى لصقها معاً
Dialogue: 0,0:06:43.28,0:06:46.19,Default,,0000,0000,0000,,إنّها رسالة غريبة بحق
Dialogue: 0,0:06:46.19,0:06:52.67,Default,,0000,0000,0000,,ما فهمته هو "كذبة إبريل"، أي أنّه سيأتي\Nفي اليوم الأوّل من إبريل
Dialogue: 0,0:06:53.07,0:06:55.53,Default,,0000,0000,0000,,أنت! ألم تكن ستنام؟
Dialogue: 0,0:06:54.95,0:06:55.53,Default,,0000,0000,0000,,...دعني أرى
Dialogue: 0,0:06:55.53,0:06:57.19,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:07:09.58,0:07:13.07,CharCard,,0020,0000,0005,,{\fad(500,0)} مارس 31، متحف بيكا للفنون\Nالساعة 1:42 ظهراً
Dialogue: 0,0:07:13.60,0:07:15.08,Default,,0000,0000,0000,,مُذهل
Dialogue: 0,0:07:15.08,0:07:18.07,Default,,0000,0000,0000,,كأنّ قوّات شرطة طوكيو\Nكلّها قد نُشرت
Dialogue: 0,0:07:18.07,0:07:20.48,Default,,0000,0000,0000,,يبدو أنّه لصّ من طراز عالميّ حقّاً
Dialogue: 0,0:07:23.86,0:07:26.70,Default,,0000,0000,0000,,لم أستطع حلّ هذه الرموز\Nأبداً في النهاية
Dialogue: 0,0:07:27.06,0:07:29.19,Default,,0000,0000,0000,,!متحرّي موري
Dialogue: 0,0:07:29.19,0:07:31.44,Default,,0000,0000,0000,,!شكراً على قدومك
Dialogue: 0,0:07:31.44,0:07:35.49,Default,,0000,0000,0000,,!أقدّر كثيراً إصغاءك لابنتي
Dialogue: 0,0:07:35.89,0:07:37.39,On Top,,0000,0000,0000,,وجود متحرّ مثلك هنا كامتلاك
Dialogue: 0,0:07:35.89,0:07:41.32,CharCard,,0000,0000,0003,,{\fad(300,300)} (51) سوزوكي شيرو\Nرئيس مجموعة سوزوكي المالية
Dialogue: 0,0:07:37.39,0:07:39.55,On Top,,0000,0000,0000,,!قوّة مئة رجل
Dialogue: 0,0:07:39.55,0:07:41.82,On Top,,0000,0000,0000,,!أتطلّع للكثير منك يا متحرّي موري
Dialogue: 0,0:07:42.05,0:07:48.16,Default,,0000,0000,0000,,إنّه مجرّد لصٍّ بسيط، سأقبض عليه دون أيّ عناء
Dialogue: 0,0:07:50.04,0:07:53.91,Default,,0000,0000,0000,,كلامٌ كبير وأنت لم تفكّك رموز الرسالة حتّى
Dialogue: 0,0:07:55.70,0:07:59.78,Default,,0000,0000,0000,,هذه أكبر لؤلؤة سوداء\Nفي العالم إذاً، النجم الأسود؟
Dialogue: 0,0:07:59.78,0:08:03.74,Default,,0000,0000,0000,,أجل، نعمت عائلة سوزوكي بالازدهار
Dialogue: 0,0:08:03.74,0:08:07.27,Default,,0000,0000,0000,,مُذ اقتناها جدّي
Dialogue: 0,0:08:07.27,0:08:10.48,Default,,0000,0000,0000,,إنّها أشبه بملاك العائلة الحارس
Dialogue: 0,0:08:10.86,0:08:15.94,Default,,0000,0000,0000,,الحراسة مُشدّدة مع أنّنا في اليوم\Nالذي يسبق عمليّة السرقة
Dialogue: 0,0:08:16.60,0:08:19.90,Default,,0000,0000,0000,,نعم، بما أنّنا لم نستطع\Nحلّ شيء من الرموز
Dialogue: 0,0:08:20.26,0:08:24.11,Default,,0000,0000,0000,,ستشدّد الشرطة تأهّبها بدءاً \N من مساء اليوم وفقما أخبروني
Dialogue: 0,0:08:24.11,0:08:28.64,Default,,0000,0000,0000,,فلا نعلم متى ومن أين\Nسيأتي كايتو 1412
Dialogue: 0,0:08:29.34,0:08:31.15,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:08:31.59,0:08:36.77,Default,,0000,0000,0000,,أخبرتكم! النهر! انشروا رجالاً\N!على ضفّة النهر، مفهوم؟
Dialogue: 0,0:08:36.98,0:08:39.99,On Top,,0000,0000,0000,,ينوي كايتو 1412 التسلّل للمتحف
Dialogue: 0,0:08:37.10,0:08:42.43,CharCard,,0000,0000,0004,,{\fad(300,300)} (49) تشاكي شينتارو\Nرئيس فرقة التحقيق الثانية بمركز الشرطة
Dialogue: 0,0:08:39.99,0:08:43.38,On Top,,0000,0000,0000,,!عبر نهر تيموزو المجاور
Dialogue: 0,0:08:44.24,0:08:46.14,Default,,0000,0000,0000,,حللت الرموز؟
Dialogue: 0,0:08:46.14,0:08:47.07,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:08:47.07,0:08:52.53,Default,,0000,0000,0000,,سآتي على الأمواج" في الرسالة تعني"\N!أنّه سيسلك نهر تيموزو
Dialogue: 0,0:08:52.73,0:08:57.36,Default,,0000,0000,0000,,نهر تيموزو هو المكان الوحيد\N!في الجوار بأمواج
Dialogue: 0,0:09:02.30,0:09:04.81,Default,,0000,0000,0000,,ألستَ موري من الفرقة الأولى سابقاً؟
Dialogue: 0,0:09:04.81,0:09:06.72,Default,,0000,0000,0000,,هذا ساذج سيّدي الرئيس
Dialogue: 0,0:09:06.72,0:09:07.67,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:07.67,0:09:11.99,Default,,0000,0000,0000,,ألا تفهم؟ الأمواج تعني المحيط\N(والذي من مرادفاته "أوكي" (ساحل
Dialogue: 0,0:09:12.23,0:09:14.63,Default,,0000,0000,0000,,!بينما النجم يعني النجم الفنّان
Dialogue: 0,0:09:14.63,0:09:19.29,Default,,0000,0000,0000,,أي أنّ هذا يشير للنجمة الفنّانة\Nالتي ستؤدي في حفلٍ غداً
Dialogue: 0,0:09:19.29,0:09:22.44,Default,,0000,0000,0000,,!في قاعة بيكا العامة، أوكينو يوكو-تشان
Dialogue: 0,0:09:24.20,0:09:28.36,Default,,0000,0000,0000,,إضافةً لذلك، الأغنية التي تختم بها\N"ستكون "سيّدة القمر
Dialogue: 0,0:09:28.36,0:09:31.36,Default,,0000,0000,0000,,...عندما يقسم القمر الشيئين" تعني"
Dialogue: 0,0:09:31.73,0:09:36.47,Default,,0000,0000,0000,,أنّ كايتو 1412 سيأتي من قاعة بيكا
Dialogue: 0,0:09:36.47,0:09:40.46,Default,,0000,0000,0000,,!عندما ينتهي العرض في التاسعة مساءً
Dialogue: 0,0:09:40.82,0:09:42.58,Default,,0000,0000,0000,,...يا للسخافة
Dialogue: 0,0:09:42.96,0:09:45.09,Default,,0000,0000,0000,,نعم، كلامك منطقيّ
Dialogue: 0,0:09:45.59,0:09:48.09,Default,,0000,0000,0000,,!مُبهر أيّها المتحرّي موري
Dialogue: 0,0:09:48.09,0:09:48.98,Default,,0000,0000,0000,,...مهلكم
Dialogue: 0,0:09:49.26,0:09:53.92,Default,,0000,0000,0000,,حسنٌ، لتجتمع الفرق من ج إلى هـ\N!عند مسرح بيكا العام فوراً
Dialogue: 0,0:09:53.92,0:09:54.55,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:09:54.70,0:09:55.75,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:09:56.87,0:10:01.28,Default,,0000,0000,0000,,مع ذلك، لم أستطع حلّ الرموز بعد
Dialogue: 0,0:10:01.38,0:10:05.99,Default,,0000,0000,0000,,أتتم، أين ذهب ذاك الرجل\Nالذي انتقل لنا الشهر الفائت؟
Dialogue: 0,0:10:06.13,0:10:09.69,Default,,0000,0000,0000,,إذا تقصد المفتّش فقد أخذ أتباعه\Nلمكان ما هذا الصباح
Dialogue: 0,0:10:09.69,0:10:11.69,Default,,0000,0000,0000,,!ما الذي يفكّر به؟ في هذا الوقت الحرج
Dialogue: 0,0:10:11.69,0:10:16.19,Default,,0000,0000,0000,,.بأيّ حال سيّدي الرئيس، أصبحت الساعة الثانية\Nفما رأيك بأكل الغداء في الجوار؟
Dialogue: 0,0:10:16.77,0:10:18.35,Default,,0000,0000,0000,,هل تريدون أكل الغداء يا ران؟
Dialogue: 0,0:10:18.72,0:10:20.65,Default,,0000,0000,0000,,أكلنا في طريقنا
Dialogue: 0,0:10:20.65,0:10:21.65,Default,,0000,0000,0000,,أكل؟
Dialogue: 0,0:10:22.52,0:10:24.56,Default,,0000,0000,0000,,!لحظة، أيمكن؟
Dialogue: 0,0:10:25.39,0:10:26.86,Default,,0000,0000,0000,,كونان-كن، أين تذهب؟
Dialogue: 0,0:10:30.22,0:10:32.42,Default,,0000,0000,0000,,ما الذي تفعله يا كونان-كن؟
Dialogue: 0,0:10:33.05,0:10:35.36,Default,,0000,0000,0000,,أتفقّد الاتجاه بساعتي
Dialogue: 0,0:10:35.71,0:10:36.96,Default,,0000,0000,0000,,الاتّجاه؟
Dialogue: 0,0:10:36.96,0:10:41.26,Default,,0000,0000,0000,,نعم، أوجّه عقرب الساعات نحو الشمس أوّلاً
Dialogue: 0,0:10:41.62,0:10:43.54,Default,,0000,0000,0000,,تقع اليابان في النصف الشمالي للكرة الأرضيّة
Dialogue: 0,0:10:43.54,0:10:48.86,Default,,0000,0000,0000,,فيكون الجنوب في المنتصف بين عقرب الساعات\N!والرقم 12 على الساعة
Dialogue: 0,0:10:50.10,0:10:54.65,Default,,0000,0000,0000,,هـ-هذا شيءٌ سمعته من شينتشي-نيتشان\N!وأردت تجربته لا أكثر بالطبع
Dialogue: 0,0:10:56.06,0:11:01.74,Default,,0000,0000,0000,,،ما يعني أنّ الجنوب عند اتّجاه الساعة الواحدة\Nوالجنوب الشرقيّ عند الثانية والنصف
Dialogue: 0,0:11:06.69,0:11:10.87,Default,,0000,0000,0000,,!فهمت، حللتُ لغزك يا كايتو 1412
Dialogue: 0,0:11:11.75,0:11:16.15,CharCard,,0000,0000,0004,,{\fad(300,0)}مارس 31\Nالساعة 11:04 ليلاً
Dialogue: 0,0:11:19.97,0:11:21.62,Default,,0000,0000,0000,,تغطّ في النوم
Dialogue: 0,0:11:33.54,0:11:34.83,Default,,0000,0000,0000,,أجل، معك آغاسا
Dialogue: 0,0:11:35.61,0:11:36.82,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:11:37.19,0:11:38.54,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:39.32,0:11:43.20,Default,,0000,0000,0000,,تريد منّي التحرّي عن كايتو 1412؟
Dialogue: 0,0:11:43.53,0:11:47.41,Default,,0000,0000,0000,,أرجوك يا بروفسور، يُفترض أنّه موجود\Nفي ملفّ الجرائم الذي يملكه أبي
Dialogue: 0,0:11:47.86,0:11:50.62,Default,,0000,0000,0000,,لكن لمَ تحتاج ذلك؟
Dialogue: 0,0:11:50.84,0:11:54.27,Default,,0000,0000,0000,,!أريد التعرّف عليه قبل أن أذهب للقائه
Dialogue: 0,0:11:54.27,0:11:57.26,Default,,0000,0000,0000,,!للقائه؟ تعرف أين هو؟
Dialogue: 0,0:11:57.49,0:12:01.50,Default,,0000,0000,0000,,نعم، اكتشفتُ الطريق الذي سيسلكه للداخل
Dialogue: 0,0:12:01.50,0:12:03.69,Default,,0000,0000,0000,,لمَ لم تخبر الشرطة إذاً؟
Dialogue: 0,0:12:04.03,0:12:06.57,Default,,0000,0000,0000,,أصبحتُ أريد لقاءه وجهاً لوجه بدوري
Dialogue: 0,0:12:06.57,0:12:11.79,Default,,0000,0000,0000,,وأرى وجه اللصّ قديم الطراز الذي يرسل\N!إخطارات قبل جريمته في هذا العصر
Dialogue: 0,0:12:16.95,0:12:19.52,Default,,0000,0000,0000,,...الشيئان اللذان سيقسمهما القمر
Dialogue: 0,0:12:19.52,0:12:21.20,Default,,0000,0000,0000,,!هما القمر الاصطناعي والشمس
Dialogue: 0,0:12:21.20,0:12:27.91,Default,,0000,0000,0000,,وإذا كان المقصود بالقسم هو دخول القمر\N...بين الشمس والقمر الصناعي، فالكسوف
Dialogue: 0,0:12:28.31,0:12:33.11,Default,,0000,0000,0000,,عندها سيأتي بين 12:30 و4:00 صباحاً\N"عندما ينتهي بثّ قناة "بي إس
Dialogue: 0,0:12:33.87,0:12:38.81,Default,,0000,0000,0000,,أجل، الحرفان الأوليّان لعبارة النجم الأسود\N(في الإنجليزية هما "بي" و"إس" (قمر البثّ
Dialogue: 0,0:12:40.05,0:12:43.37,Default,,0000,0000,0000,,إذا كان المقصود بالأمواج هي الموجات\N...الكهرومغناطيسية للقمر الصناعي
Dialogue: 0,0:12:43.89,0:12:47.07,Default,,0000,0000,0000,,!"إذاً سيأتي من اتّجاه إشارة "بي إس
Dialogue: 0,0:12:48.13,0:12:51.42,Default,,0000,0000,0000,,تُرسل إشارة "بي إس" من الجنوب\Nللغرب بزاوية 45 درجة
Dialogue: 0,0:12:51.42,0:12:55.81,Default,,0000,0000,0000,,وبـ 42.3 درجة فوق مستوى سطح البجر
Dialogue: 0,0:12:56.54,0:13:00.12,Default,,0000,0000,0000,,المكان الوحيد الذي يطابق المواصفات \N...ويطلّ على متحف بيكا
Dialogue: 0,0:13:00.34,0:13:02.51,Default,,0000,0000,0000,,!هو سطح فندق مدينة هايدو فحسب
Dialogue: 0,0:13:10.13,0:13:14.69,Default,,0000,0000,0000,,حضرة المفتّش، إنّه صبيّ! يتوجّه صبيّ غريب \Nنحو الفندق، ماذا نفعل؟
Dialogue: 0,0:13:14.69,0:13:17.74,Default,,0000,0000,0000,,دعوه وشأنه، هدفنا شخص واحد فحسب
Dialogue: 0,0:13:18.89,0:13:22.95,Default,,0000,0000,0000,,وحتّى هو لا يستطيع التنكّر كطفل
Dialogue: 0,0:13:34.85,0:13:39.06,On Top,,0000,0000,0000,,للموظفين فقط
Dialogue: 0,0:13:52.30,0:13:55.40,Default,,0000,0000,0000,,...متحف بيكا
Dialogue: 0,0:13:55.41,0:13:56.48,Default,,0000,0000,0000,,هناك
Dialogue: 0,0:13:58.71,0:14:00.79,Default,,0000,0000,0000,,الثانية عشرة وثمان وعشرون دقيقة
Dialogue: 0,0:14:00.79,0:14:03.33,Default,,0000,0000,0000,,ما تبقّى هو انتظار قدومه هنا فحسب
Dialogue: 0,0:14:06.49,0:14:08.21,Default,,0000,0000,0000,,مرحباً؟ بروفسور؟
Dialogue: 0,0:14:08.21,0:14:09.68,Default,,0000,0000,0000,,شينتشي
Dialogue: 0,0:14:09.95,0:14:14.15,Default,,0000,0000,0000,,طابقتُ ملفات والدك مع المقالات\Nفي الصحف مؤخراً
Dialogue: 0,0:14:14.15,0:14:19.10,Default,,0000,0000,0000,,كايتو 1412 هو شخص مغلّف بالغموض
Dialogue: 0,0:14:19.56,0:14:23.56,Default,,0000,0000,0000,,ظهر لأوّل مرّة في باريس قبل 18 عاماً
Dialogue: 0,0:14:23.56,0:14:27.81,Default,,0000,0000,0000,,اختفى بعد مرور 10 أعوام فجأةً، وشاع أنّه مات
Dialogue: 0,0:14:28.18,0:14:34.61,Default,,0000,0000,0000,,لكنّه رجع بعد ثمانية أعوام الآن\Nويركّز نشاطه في اليابان
Dialogue: 0,0:14:34.76,0:14:39.27,Default,,0000,0000,0000,,قبل 18 عاماً؟ لا بدّ أنّه كبير في السنّ إذاً
Dialogue: 0,0:14:39.58,0:14:42.25,Default,,0000,0000,0000,,...ألقابه كثيرة
Dialogue: 0,0:14:42.25,0:14:44.98,Default,,0000,0000,0000,,..."لوبان العصر الحديث"، "ساحر ضوء القمر"
Dialogue: 0,0:14:45.49,0:14:49.75,Default,,0000,0000,0000,,لكن هناك لقب شعبيّ يتداوله الناس\Nأكثر من غيره
Dialogue: 0,0:14:50.07,0:14:51.18,Default,,0000,0000,0000,,لقب شعبيّ؟
Dialogue: 0,0:14:51.57,0:14:55.10,Default,,0000,0000,0000,,أثار تلاعب كايتو 1412 بأفراد الشرطة كما لو كان
Dialogue: 0,0:14:55.10,0:15:00.01,Default,,0000,0000,0000,,طفلاً عابثاً اهتمام روائيّ شاب ما
Dialogue: 0,0:15:00.30,0:15:03.93,Default,,0000,0000,0000,,...فتلاعب برقم 1412 ليُقرأ هكذا
Dialogue: 0,0:15:04.15,0:15:05.57,Default,,0000,0000,0000,,"كي آي دي"
Dialogue: 0,0:15:06.34,0:15:08.24,Default,,0000,0000,0000,,كي آي دي"؟"
Dialogue: 0,0:15:08.85,0:15:13.23,Default,,0000,0000,0000,,نعم، ما يطلقه الناس\N...على كايتو 1412 هو
Dialogue: 0,0:15:20.63,0:15:22.27,Default,,0000,0000,0000,,!كايتو كيد
Dialogue: 0,0:15:28.73,0:15:30.82,Default,,0000,0000,0000,,،كيلا يعكّر سكون الليل
Dialogue: 0,0:15:31.20,0:15:34.07,Default,,0000,0000,0000,,هبط بجناحَي الصمت أمامي
Dialogue: 0,0:15:36.02,0:15:38.19,Default,,0000,0000,0000,,،مُبدياً ابتسامةً جريئة
Dialogue: 0,0:15:39.27,0:15:41.09,Default,,0000,0000,0000,,كما لو أنّها تنبّأت بكلّ شيء
Dialogue: 0,0:16:07.31,0:16:09.06,Default,,0000,0000,0000,,ما الخطب يا شينشي؟
Dialogue: 0,0:16:09.06,0:16:09.50,Default,,0000,0000,0000,,...شينـ
Dialogue: 0,0:16:18.22,0:16:19.73,Default,,0000,0000,0000,,حرملة وقبّعة حريرية
Dialogue: 0,0:16:20.30,0:16:22.08,Default,,0000,0000,0000,,...وضعيّة بلا فجوات
Dialogue: 0,0:16:22.80,0:16:26.64,Default,,0000,0000,0000,,لا أستطيع رؤية ملامحه بوضوح من العدسة\Nوالإنارة الضعيفة، لكنّه يافع لحدٍّ مُفاجئ
Dialogue: 0,0:16:27.56,0:16:30.52,Default,,0000,0000,0000,,في ثلاثينياته؟ عشرينياته؟
Dialogue: 0,0:16:30.69,0:16:31.81,Default,,0000,0000,0000,,لا، أصغر حتّى
Dialogue: 0,0:16:33.29,0:16:35.00,Default,,0000,0000,0000,,مرحباً يا فتى
Dialogue: 0,0:16:35.77,0:16:37.76,Default,,0000,0000,0000,,ماذا تفعل في هذا المكان؟
Dialogue: 0,0:16:43.81,0:16:45.06,Default,,0000,0000,0000,,!ألعاب نارية
Dialogue: 0,0:16:46.89,0:16:48.01,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:16:48.22,0:16:50.72,Default,,0000,0000,0000,,!وميض غريب وصوت؟
Dialogue: 0,0:16:50.72,0:16:55.68,Default,,0000,0000,0000,,نعم، فوق فندق مدينة هايدو\Nجنوب غرب المتحف
Dialogue: 0,0:16:55.68,0:16:57.99,Default,,0000,0000,0000,,هل أذهب للتفقّد سيّدي الرئيس؟
Dialogue: 0,0:16:58.39,0:17:00.05,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:17:00.42,0:17:04.27,Default,,0000,0000,0000,,!انظر! مروحيّة! يبدو أنّهم انتبهوا لنا
Dialogue: 0,0:17:06.24,0:17:08.93,Default,,0000,0000,0000,,يبدو أنّك لست صبيّاً عادياً يا فتى
Dialogue: 0,0:17:10.28,0:17:12.56,Default,,0000,0000,0000,,أنا إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:17:14.28,0:17:16.99,Default,,0000,0000,0000,,أليس عليك التصرّف\Nيا كايتو كيد-سان؟
Dialogue: 0,0:17:17.23,0:17:19.73,Default,,0000,0000,0000,,اهرب بسرعة وإلّا ستصل المروحيّة
Dialogue: 0,0:17:21.74,0:17:24.90,Default,,0000,0000,0000,,لدي فرصة واحدة فقط\Nلإصابته بالإبرة المخدّرة
Dialogue: 0,0:17:25.08,0:17:27.85,Default,,0000,0000,0000,,!حالما يلتفت للهرب
Dialogue: 0,0:17:29.81,0:17:30.65,Default,,0000,0000,0000,,إذاعة؟
Dialogue: 0,0:17:32.81,0:17:38.21,Default,,0000,0000,0000,,هذا تشاكي، شُوهد كايتو كيد فوق\N!سطح فندق مدينة هايدو
Dialogue: 0,0:17:39.35,0:17:43.27,Default,,0000,0000,0000,,نداء لكلّ عربات الحراسة في بيكا وهايدو
Dialogue: 0,0:17:43.68,0:17:47.01,Default,,0000,0000,0000,,وللمروحيّات المحلّقة فوق بيكا
Dialogue: 0,0:17:47.23,0:17:51.08,Default,,0000,0000,0000,,!توجّهوا للساحة فوراً واقبضوا على كايتو كيد
Dialogue: 0,0:17:51.46,0:17:54.08,Default,,0000,0000,0000,,!إ-إنّه يستعمل صوتي
Dialogue: 0,0:17:54.08,0:17:56.43,Default,,0000,0000,0000,,!انتظروا! ذلك ليس أنا
Dialogue: 0,0:17:56.78,0:18:00.36,Default,,0000,0000,0000,,!هذا فخّه! لكلّ الوحدات، ارجعوا فوراً
Dialogue: 0,0:18:00.78,0:18:03.37,Default,,0000,0000,0000,,هنا المروحيّة رقم 1، وصلتُ فندق مدينة هايدو
Dialogue: 0,0:18:03.37,0:18:05.13,Default,,0000,0000,0000,,!أرى شبيهاً لكيد
Dialogue: 0,0:18:05.31,0:18:06.57,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:18:06.60,0:18:09.40,Default,,0000,0000,0000,,يبدو أنّه من أرسل الأوامر
Dialogue: 0,0:18:10.61,0:18:12.86,Default,,0000,0000,0000,,هذا أنا، ناكاموري
Dialogue: 0,0:18:13.19,0:18:16.31,Default,,0000,0000,0000,,نداء لكلّ الضبّاط في فندق مدينة هايدو
Dialogue: 0,0:18:16.31,0:18:21.12,Default,,0000,0000,0000,,!كيد على السطح! أسرعوا للمكان فوراً واعتقلوه
Dialogue: 0,0:18:21.37,0:18:23.30,Default,,0000,0000,0000,,...إ-إنّه مذهل
Dialogue: 0,0:18:23.30,0:18:26.23,Default,,0000,0000,0000,,!يقلّد عدّة أصوات دون استعمال أداة حتّى
Dialogue: 0,0:18:26.23,0:18:27.69,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:18:27.92,0:18:30.15,Default,,0000,0000,0000,,!صـ-صوتك على الإذاعة سيّدي المفتّش
Dialogue: 0,0:18:30.15,0:18:32.96,On Top,,0000,0000,0000,,إنّه كيد! يستعمل صوتي
Dialogue: 0,0:18:30.54,0:18:35.32,CharCard,,0000,0000,0003,,{\fad(300,0)} (41) ناكاموري غينزو\Nمفتّش في فرقة التحقيق الثانية بمركز الشرطة
Dialogue: 0,0:18:32.96,0:18:35.22,On Top,,0000,0000,0000,,!كي يستدرجنا له
Dialogue: 0,0:18:35.83,0:18:39.21,Default,,0000,0000,0000,,!سـ-سخافة! ماذا سيجني من فعله هذا؟
Dialogue: 0,0:18:39.67,0:18:41.29,Default,,0000,0000,0000,,!ما الذي يفعله؟
Dialogue: 0,0:18:47.02,0:18:49.71,Default,,0000,0000,0000,,رضيت الآن أيّها المتحرّي الصغير؟
Dialogue: 0,0:18:52.73,0:18:54.07,Default,,0000,0000,0000,,!مكانك يا كيد
Dialogue: 0,0:18:54.40,0:18:57.96,Default,,0000,0000,0000,,عجباً، مفتّش ناكاموري! وصلتَ سريعاً
Dialogue: 0,0:18:59.31,0:19:04.69,Default,,0000,0000,0000,,ما الذي تقوله؟ تعرف أنّي حللت رموز رسالتك\Nوكنتُ أراقب هذا المكان
Dialogue: 0,0:19:05.13,0:19:10.15,Default,,0000,0000,0000,,،توقّعتُ أن تغادر من هنا بطائرتك الشراعية\Nففتّشت الجميع في الفندق
Dialogue: 0,0:19:10.46,0:19:12.63,Default,,0000,0000,0000,,وشدّدت حراسة المدخل الأمامي
Dialogue: 0,0:19:12.63,0:19:17.35,Default,,0000,0000,0000,,لكن لم يخطر لي أنّك ستستدير\Nمن برج توتو وتهبط هنا
Dialogue: 0,0:19:17.83,0:19:21.81,Default,,0000,0000,0000,,!انسَ أمر اللؤلؤة! لا مهرب لك
Dialogue: 0,0:19:22.37,0:19:27.27,Default,,0000,0000,0000,,أتيتُ الليلة لمراقبتكم فحسب، لا أنوي سرقة شيء
Dialogue: 0,0:19:27.40,0:19:28.24,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:19:28.30,0:19:32.29,Default,,0000,0000,0000,,توقّعتُ أنّي ذكرت الأمر في بداية الرسالة
Dialogue: 0,0:19:33.51,0:19:35.98,Default,,0000,0000,0000,,كذبة أبريل"، أي كانت كذبة"
Dialogue: 0,0:19:36.39,0:19:38.69,Default,,0000,0000,0000,,!لا-لا تدعوه يهرب! حاصروه
Dialogue: 0,0:19:42.23,0:19:43.21,Default,,0000,0000,0000,,!قنبلة ضوئية
Dialogue: 0,0:19:44.09,0:19:45.85,Default,,0000,0000,0000,,أتعرف يا فتى؟
Dialogue: 0,0:19:46.62,0:19:50.69,Default,,0000,0000,0000,,اللصّ هو فنّان مُبدع يسرق فريسته بحرفيّة
Dialogue: 0,0:19:51.13,0:19:53.84,Default,,0000,0000,0000,,لكنّ المتحري ليس أكثر من ناقد
Dialogue: 0,0:19:53.84,0:19:56.22,Default,,0000,0000,0000,,يتفحّص البقايا ويبحث عن عيوب
Dialogue: 0,0:19:56.63,0:19:57.29,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:02.10,0:20:02.90,Default,,0000,0000,0000,,!اختفى
Dialogue: 0,0:20:04.33,0:20:05.44,Default,,0000,0000,0000,,!اختفى
Dialogue: 0,0:20:05.44,0:20:06.82,Default,,0000,0000,0000,,!لقد اختفى
Dialogue: 0,0:20:07.99,0:20:10.73,Default,,0000,0000,0000,,!يا قائدي المروحيّات، استعملوا الرادار! لاحقوه به
Dialogue: 0,0:20:10.99,0:20:15.87,Default,,0000,0000,0000,,!لا يُظهر سوى مروحيّاتنا الثلاث في المنطقة
Dialogue: 0,0:20:17.35,0:20:19.30,Default,,0000,0000,0000,,أهرب مُجدداً؟
Dialogue: 0,0:20:19.40,0:20:23.57,Default,,0000,0000,0000,,لا يُعقل! لا يمكن أن يختفي\N!إنسان بهذه السهولة
Dialogue: 0,0:20:28.13,0:20:29.31,Default,,0000,0000,0000,,...هـ-هذه
Dialogue: 0,0:20:29.88,0:20:33.84,Default,,0000,0000,0000,,في التاسع عشر من أبريل، سأظهر على"\Nمتن الملكة سيليزابيث
Dialogue: 0,0:20:33.84,0:20:38.96,Default,,0000,0000,0000,,التي ستُبحر من ميناء يوكوهاما\Nلسرقة النجم الأسود الحقيقيّ
Dialogue: 0,0:20:38.96,0:20:40.62,Default,,0000,0000,0000,,"كايتو كيد-
Dialogue: 0,0:20:43.28,0:20:47.68,CharCard,,0000,0000,0003,,{\fad(300,0)}أبريل 19\Nالملكة سيليزابيث، ميناء يوكوهاما
Dialogue: 0,0:20:44.90,0:20:47.68,On Top,,0000,0000,0000,,!ألغها رجاءً سيّدي الرئيس
Dialogue: 0,0:20:47.94,0:20:49.65,Default,,0000,0000,0000,,!نحن نتعامل مع كايتو كيد
Dialogue: 0,0:20:49.65,0:20:54.15,Default,,0000,0000,0000,,لا يمكننا تركه يقترب من الجوهرة\N!مع حراسة ضعيفة كهذه
Dialogue: 0,0:20:54.15,0:20:56.80,Default,,0000,0000,0000,,هوّن عليك يا ناكاموري-كن
Dialogue: 0,0:20:56.80,0:21:00.14,Default,,0000,0000,0000,,قائمة حضور حفلة اليوم\Nتعجّ بالشخصيات المرموقة
Dialogue: 0,0:21:00.14,0:21:02.59,Default,,0000,0000,0000,,لا يمكننا التعامل بخشونة
Dialogue: 0,0:21:02.59,0:21:09.14,Default,,0000,0000,0000,,كما أنّ سمعتنا ستتلطخ إذا\Nألغينا الحفلة خوفاً من كايتو كيد
Dialogue: 0,0:21:09.39,0:21:13.50,Default,,0000,0000,0000,,لا تقلق، ستستغرق السفينة 3 ساعات\Nللوصول لطوكيو من يوكوهاما
Dialogue: 0,0:21:13.50,0:21:19.14,Default,,0000,0000,0000,,إنّها سجن عائم، حتّى لو تسلّل على متنها\N!سيكون مُحاصراً
Dialogue: 0,0:21:22.35,0:21:26.05,Default,,0000,0000,0000,,دخلنا الذكرى الستّين لتأسّس\Nشركة سوزوكي هذا العام
Dialogue: 0,0:21:26.31,0:21:30.51,Default,,0000,0000,0000,,ذلك بفضل دعمكم جميعاً
Dialogue: 0,0:21:30.77,0:21:33.47,Default,,0000,0000,0000,,انسوا أمر اللصّ الدنيء الليلة رجاءً
Dialogue: 0,0:21:33.69,0:21:40.93,Default,,0000,0000,0000,,واستمتعوا بهذه الحفلة الراقية والفخمة\Nالتي تحتضن 500 مدعوّاً
Dialogue: 0,0:21:42.22,0:21:43.68,Default,,0000,0000,0000,,...قبل ذلك
Dialogue: 0,0:21:44.80,0:21:47.56,On Top,,0000,0000,0000,,جهّزتُ خطّةً خاصة لليلة
Dialogue: 0,0:21:44.94,0:21:50.41,CharCard,,0000,0000,0004,,{\fad(300,100)}  (43) سوزوكي توموكو\Nأمّ سونوكو
Dialogue: 0,0:21:48.13,0:21:53.60,On Top,,0000,0000,0000,,فلتفتحوا الصناديق الصغيرة التي \Nوُزّعت عليكم قبل صعودكم من فضلكم
Dialogue: 0,0:21:53.84,0:21:58.30,Default,,0000,0000,0000,,إنّها رسالة تحدٍّ منّي للصّ الساذج
Dialogue: 0,0:21:58.30,0:21:59.94,Default,,0000,0000,0000,,...هـ-هذه
Dialogue: 0,0:22:00.33,0:22:03.41,Default,,0000,0000,0000,,أجل! رمز عائلتنا
Dialogue: 0,0:22:03.41,0:22:07.83,Default,,0000,0000,0000,,!وهدف كايتو كيد الليلة، النجم الأسود
Dialogue: 0,0:22:08.40,0:22:13.52,Default,,0000,0000,0000,,الحقيقيّة واحدة بالطبع، وأنا وحدي تعرف من أخذها
Dialogue: 0,0:22:13.85,0:22:17.56,Default,,0000,0000,0000,,البقيّة مجرّد لآلئ مقلّدة
Dialogue: 0,0:22:18.35,0:22:21.56,Default,,0000,0000,0000,,حسناً يا سادة، علّقوها على صدوركم رجاءً
Dialogue: 0,0:22:21.56,0:22:26.43,Default,,0000,0000,0000,,"ودعوا كيد يفهم، "تعال وخذها إذا استطعت
Dialogue: 0,0:22:26.88,0:22:31.34,Default,,0000,0000,0000,,ذلك بافتراض أنّه سيستطيع \Nتحديد الحقيقية بالطبع
Dialogue: 0,0:22:31.34,0:22:33.87,Default,,0000,0000,0000,,!خلال الثلاث ساعات من إبحارنا
Dialogue: 0,0:22:35.33,0:22:37.61,Default,,0000,0000,0000,,!أمّك مُبهرة
Dialogue: 0,0:22:38.12,0:22:39.63,Default,,0000,0000,0000,,ما الخطب يا سونوكو؟
Dialogue: 0,0:22:39.81,0:22:42.54,Default,,0000,0000,0000,,...لا أرى أختي
Dialogue: 0,0:22:42.54,0:22:44.51,Default,,0000,0000,0000,,أيمكن أنّها لا تزال في المنزل؟
Dialogue: 0,0:22:44.65,0:22:46.30,Default,,0000,0000,0000,,مستحيل
Dialogue: 0,0:22:46.62,0:22:49.11,On Top,,0000,0000,0000,,ماذا؟ أبحرت السفينة؟
Dialogue: 0,0:22:46.68,0:22:50.41,CharCard,,0000,0000,0000,,{\fad(300,0)}منزل سوزوكي
Dialogue: 0,0:22:49.11,0:22:50.26,On Top,,0000,0000,0000,,كيف؟
Dialogue: 0,0:22:50.65,0:22:53.98,Default,,0000,0000,0000,,!هذا كلامي! ما الساعة الآن برأيك؟
Dialogue: 0,0:22:54.31,0:22:59.02,Default,,0000,0000,0000,,لكنّ الضابط اتّصل بنا وقال\Nأنّ الإبحار سيتأخّر ساعتين
Dialogue: 0,0:22:59.02,0:23:00.56,Default,,0000,0000,0000,,أليس كذلك يا أبي؟
Dialogue: 0,0:23:01.10,0:23:02.67,Default,,0000,0000,0000,,أبي عندك؟
Dialogue: 0,0:23:03.37,0:23:04.08,Default,,0000,0000,0000,,!الوغد
Dialogue: 0,0:23:06.88,0:23:10.02,Default,,0000,0000,0000,,أين ذهب رئيس الشركة\Nالذي كان هنا؟
Dialogue: 0,0:23:10.02,0:23:11.63,Default,,0000,0000,0000,,لدورة المياه
Dialogue: 0,0:23:17.33,0:23:21.83,Default,,0000,0000,0000,,فهمت، صعد متنكراً بهيئة الرئيس
Dialogue: 0,0:23:23.33,0:23:25.22,Default,,0000,0000,0000,,شكراً يا كايتو كيد
Dialogue: 0,0:23:26.32,0:23:31.53,Default,,0000,0000,0000,,أعطيتني فرصةً قيّمة لانتزاع\N!قناعك الجريء ذاك
Dialogue: 0,0:23:40.78,0:23:46.35,Default,,0000,0000,0000,,ماذا؟ تنكّر كايتو 1412 بهيئة أبي\N!وصعد على متن السفينة؟
Dialogue: 0,0:23:47.06,0:23:52.81,Default,,0000,0000,0000,,وجدتُ في الحمّام ثياب والدك التي استعملها\N!بالإضافة لأدوات التنكّر
Dialogue: 0,0:23:52.81,0:23:54.76,Default,,0000,0000,0000,,!رجال الشرطة يفحصونها الآن
Dialogue: 0,0:23:56.67,0:24:01.13,Default,,0000,0000,0000,,لكن بما أنّ هذا هو، فلن يجدوا أيّ دليل غالباً
Dialogue: 0,0:24:01.96,0:24:04.05,Default,,0000,0000,0000,,ماذا؟ أين ران-نيتشان؟
Dialogue: 0,0:24:04.05,0:24:07.91,Default,,0000,0000,0000,,ذهبت للبحث عنك بما أنّك لم ترجع
Dialogue: 0,0:24:07.91,0:24:12.87,Default,,0000,0000,0000,,كانت قلقةً من إمساك كايتو 1412 بك
Dialogue: 0,0:24:13.29,0:24:15.43,Default,,0000,0000,0000,,"ليس "1412
Dialogue: 0,0:24:16.90,0:24:21.20,Default,,0000,0000,0000,,!اسمه كايتو كيد! ذلك مُربك فلا تخطئه رجاءً
Dialogue: 0,0:24:21.35,0:24:22.86,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:24:25.27,0:24:27.39,Default,,0000,0000,0000,,من ذاك الشخص؟
Dialogue: 0,0:24:27.39,0:24:32.38,Default,,0000,0000,0000,,،المفتّش ناكاموري من مركز الشرطة\Nيتمحور عمله حول ملاحقة كايتو كيد
Dialogue: 0,0:24:32.77,0:24:39.09,Default,,0000,0000,0000,,إنّه فارس أهلٌ للثقّة عيّنته عائلتنا\Nلحماية النجم الأسود، مثلك تماماً
Dialogue: 0,0:24:39.09,0:24:40.77,Default,,0000,0000,0000,,...لكن سيّدتي
Dialogue: 0,0:24:41.59,0:24:47.92,Default,,0000,0000,0000,,كلّ الضيوف الخمسمئة الليلة\Nيعلّقون اللؤلؤة السوداء على صدورهم
Dialogue: 0,0:24:48.25,0:24:53.52,Default,,0000,0000,0000,,!كما كلّها مقلّدة باستثناء الواحدة الحقيقية
Dialogue: 0,0:24:54.04,0:24:57.64,Default,,0000,0000,0000,,...لا يمكنني حراستها دون أن تخبريني من يحملها
Dialogue: 0,0:24:58.53,0:25:02.07,Default,,0000,0000,0000,,حتّى لو كانت النُسخ متقنة الصنع، تبقى تقليداً
Dialogue: 0,0:25:02.07,0:25:05.69,Default,,0000,0000,0000,,إذا أمعنتَ التدقيق ستقلّص الاحتمالات
Dialogue: 0,0:25:05.69,0:25:10.31,Default,,0000,0000,0000,,بعضها باهتة وغير لامعة مثل التي معي
Dialogue: 0,0:25:11.02,0:25:16.65,Default,,0000,0000,0000,,والبعض الآخر مُفرطة اللمعان لحدٍّ\Nيكشف رخصها مثل التي معك
Dialogue: 0,0:25:17.06,0:25:20.90,Default,,0000,0000,0000,,...لكن تفقّد كل فرد من الضيوف سيكون
Dialogue: 0,0:25:21.68,0:25:24.34,Default,,0000,0000,0000,,سأعطيك تلميحاً خاصاً إذاً
Dialogue: 0,0:25:24.55,0:25:25.79,Default,,0000,0000,0000,,...النجم الأسود
Dialogue: 0,0:25:26.33,0:25:29.17,Default,,0000,0000,0000,,اللؤلؤة السوداء بلمعان الطاووس الأخضر
Dialogue: 0,0:25:29.17,0:25:32.78,Default,,0000,0000,0000,,الذي أسر جدّي قبل 60 عاماً
Dialogue: 0,0:25:33.29,0:25:36.82,Default,,0000,0000,0000,,هي بحوزة أكثر شخص موافق لها
Dialogue: 0,0:25:36.82,0:25:38.10,Default,,0000,0000,0000,,موافق؟
Dialogue: 0,0:25:39.20,0:25:43.73,Default,,0000,0000,0000,,يُصادف أنّ ذاك الذي يطابق المواصفات\Nواحد بين خمسمئة
Dialogue: 0,0:25:44.37,0:25:47.19,Default,,0000,0000,0000,,لا بدّ أن تكون امرأة\Nإذا كانت الجوهرة تلائمها
Dialogue: 0,0:25:47.87,0:25:50.78,Default,,0000,0000,0000,,!لكنّها تلائمك أيضاً يا موري-سان
Dialogue: 0,0:25:51.02,0:25:52.90,Default,,0000,0000,0000,,!كان أنت بالفعل يا موري-سان
Dialogue: 0,0:25:53.31,0:25:55.36,On Top,,0000,0000,0000,,!مضى وقتٌ طويل
Dialogue: 0,0:25:53.49,0:25:57.92,CharCard,,0000,0000,0004,,{\fad(300,0}(41) هاتاموتو جوجي\Nطاهٍ في مطعم وجبات فرنسية
Dialogue: 0,0:25:55.36,0:25:57.61,On Top,,0000,0000,0000,,!شكراً على مساعدتك في السابق
Dialogue: 0,0:25:58.31,0:26:00.52,Default,,0000,0000,0000,,ألستَ من مجموعة هاتاموتو؟
Dialogue: 0,0:26:00.89,0:26:04.30,Default,,0000,0000,0000,,بلى، تمكنتُ من فتح المزيد من المطاعم
Dialogue: 0,0:26:04.30,0:26:06.05,Default,,0000,0000,0000,,!بفضل سيّدتي هنا والرئيس
Dialogue: 0,0:26:06.05,0:26:08.65,Default,,0000,0000,0000,,...في الواقع، وجبة الليلة من إعدادي
Dialogue: 0,0:26:08.65,0:26:10.98,Default,,0000,0000,0000,,يا للأسف يا جوجي-سان
Dialogue: 0,0:26:11.38,0:26:13.34,On Top,,0000,0000,0000,,يبدو أنّ الرئيس سوزوكي
Dialogue: 0,0:26:11.70,0:26:17.04,CharCard,,0000,0000,0004,,{\fad(300,0)}(26) ميفوني تاكويا\Nرئيس شركة ميفوني للإلكترونيات
Dialogue: 0,0:26:13.34,0:26:15.42,On Top,,0000,0000,0000,,ليس موجوداً بسبب كايتو كيد
Dialogue: 0,0:26:15.42,0:26:17.69,On Top,,0000,0000,0000,,مائدة التملّق التي أعددتَها ستُهدر
Dialogue: 0,0:26:18.38,0:26:20.65,Default,,0000,0000,0000,,!تحبّ المشاحنة كعادتك
Dialogue: 0,0:26:20.91,0:26:21.48,Default,,0000,0000,0000,,البتّة
Dialogue: 0,0:26:21.99,0:26:26.19,Default,,0000,0000,0000,,الشاب من حفلة عيد ميلاد \N...الآنسة الثريّة يوتسوي
Dialogue: 0,0:26:26.49,0:26:28.87,Default,,0000,0000,0000,,ماذا؟ لا ترتدي لؤلؤتك؟
Dialogue: 0,0:26:29.09,0:26:32.15,Default,,0000,0000,0000,,أكره هذه الألعاب الطفوليّة
Dialogue: 0,0:26:32.73,0:26:35.30,Default,,0000,0000,0000,,لكن ستكون تحت الشُبهة إذا لم ترتدها
Dialogue: 0,0:26:35.52,0:26:36.65,Default,,0000,0000,0000,,ليس بيدي حيلة
Dialogue: 0,0:26:40.47,0:26:42.90,Default,,0000,0000,0000,,ماذا؟ لم تأت أياكو-سان؟
Dialogue: 0,0:26:43.35,0:26:45.57,On Top,,0000,0000,0000,,...كلا، وقع التباسٌ ما
Dialogue: 0,0:26:43.75,0:26:48.67,CharCard,,0200,0000,0004,,{\fad(300,0)}(28) توميزاوا يوزو\Nخطيب أخت سونوكو
Dialogue: 0,0:26:45.85,0:26:48.36,On Top,,0000,0000,0000,,فهمت، هذا مؤسف
Dialogue: 0,0:26:48.75,0:26:51.48,Default,,0000,0000,0000,,كما تتوقّع من حفلة لشركة سوزوكي
Dialogue: 0,0:26:51.80,0:26:54.45,Default,,0000,0000,0000,,تعجّ بالأبناء الأثرياء ورؤساء الشركات
Dialogue: 0,0:26:54.77,0:26:57.80,Default,,0000,0000,0000,,...تأخّرت ران تلك
Dialogue: 0,0:26:57.80,0:27:01.98,Default,,0000,0000,0000,,لعلّها ضلّت في مكانٍ ما، فلا حسّ بالاتجاه لديها
Dialogue: 0,0:27:02.45,0:27:04.44,Default,,0000,0000,0000,,!لا حسّ اتّجاه لديّ؟
Dialogue: 0,0:27:04.95,0:27:07.04,Default,,0000,0000,0000,,ماذا؟ كنتِ هنا؟
Dialogue: 0,0:27:07.29,0:27:08.89,Default,,0000,0000,0000,,أنا رئيس الشرطة تشاكي
Dialogue: 0,0:27:09.94,0:27:12.69,Default,,0000,0000,0000,,لعلّ بينكم من سمع بالأمر سلفاً
Dialogue: 0,0:27:12.69,0:27:16.86,Default,,0000,0000,0000,,لكن يبدو أنّ ذاك المجرم المزعج\Nقد تسلّل لمتن السفينة
Dialogue: 0,0:27:17.32,0:27:19.81,Default,,0000,0000,0000,,كما تعلمون، إنّه أستاذ في التنكّر
Dialogue: 0,0:27:20.14,0:27:23.14,Default,,0000,0000,0000,,يمتلك موهبةً شريرة لا حدود لها
Dialogue: 0,0:27:23.14,0:27:27.39,Default,,0000,0000,0000,,يستعملها في دراسة هدفه\Nوتعلّم محاكاته تماماً
Dialogue: 0,0:27:27.39,0:27:30.44,Default,,0000,0000,0000,,!بما في ذلك وجهه وصوته وشخصيّته
Dialogue: 0,0:27:30.92,0:27:35.65,Default,,0000,0000,0000,,!قد يكون بينكم بالفعل
Dialogue: 0,0:27:36.30,0:27:39.85,Default,,0000,0000,0000,,،كنّا لنفتّش كل شخص في العادة
Dialogue: 0,0:27:40.41,0:27:43.31,Default,,0000,0000,0000,,لكن سنمتنع من هذه المضايقة لأجواء الحفلة
Dialogue: 0,0:27:43.95,0:27:45.08,Default,,0000,0000,0000,,!كلمات سرّ
Dialogue: 0,0:27:45.08,0:27:49.27,Default,,0000,0000,0000,,شكّل ثنائياً مع الشخص بجوارك\N!واتّفق معه على كلمة سرّ رجاءً
Dialogue: 0,0:27:49.65,0:27:55.07,Default,,0000,0000,0000,,فهمت! لا يمكنه تغيير تنكّره باستمرار هكذا
Dialogue: 0,0:27:55.07,0:27:58.73,Default,,0000,0000,0000,,!فتستطيع الشرطة تحديده
Dialogue: 0,0:28:00.39,0:28:02.60,Default,,0000,0000,0000,,أيّ كلمة سرّ سنختار؟
Dialogue: 0,0:28:03.93,0:28:07.43,Default,,0000,0000,0000,,..."حسناً، عندما أقول "هولمز
Dialogue: 0,0:28:07.43,0:28:08.85,Default,,0000,0000,0000,,!أقول "لوبان" إذاً
Dialogue: 0,0:28:12.63,0:28:14.88,Default,,0000,0000,0000,,!ما الذي تفعلونه يا غرفة الطاقة؟
Dialogue: 0,0:28:14.95,0:28:17.38,Default,,0000,0000,0000,,...كلا سيّدي المفتّش، هذا
Dialogue: 0,0:28:19.71,0:28:20.85,Default,,0000,0000,0000,,!كايتو كيد
Dialogue: 0,0:28:23.04,0:28:24.82,Default,,0000,0000,0000,,لا فائدة من كلمات السرّ
Dialogue: 0,0:28:24.82,0:28:25.57,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:28:26.08,0:28:29.02,Default,,0000,0000,0000,,النجم الأسود بيدي سلفاً
Dialogue: 0,0:28:29.02,0:28:30.48,Default,,0000,0000,0000,,!مـ-مستحيل
Dialogue: 0,0:28:32.15,0:28:34.82,Default,,0000,0000,0000,,عجباً، يا للصّ المزعج
Dialogue: 0,0:28:35.24,0:28:39.10,Default,,0000,0000,0000,,لا بدّ من مُعاقبة هذا المشاغب المُحبّ للألعاب
Dialogue: 0,0:28:46.29,0:28:47.11,Default,,0000,0000,0000,,!أمّي
Dialogue: 0,0:28:51.55,0:28:53.55,Default,,0000,0000,0000,,ما الذي فعلتِه؟
Dialogue: 0,0:28:53.55,0:28:57.19,Default,,0000,0000,0000,,...لا تقلق حضرة المفتّش، فهو
Dialogue: 0,0:28:58.22,0:28:59.64,Default,,0000,0000,0000,,لا يزال حيّاً
Dialogue: 0,0:29:03.08,0:29:06.68,Default,,0000,0000,0000,,أمسكه حرّاسنا بغطاء المائدة
Dialogue: 0,0:29:07.25,0:29:10.19,Default,,0000,0000,0000,,بعدما تظاهرتُ بالإطلاق عليه \Nمن هذا المسدّس المُقلّد
Dialogue: 0,0:29:11.32,0:29:16.15,Default,,0000,0000,0000,,نعم، إنّه ساحر عبقريّ عيّنته الليلة للترفيه
Dialogue: 0,0:29:16.66,0:29:18.54,On Top,,0000,0000,0000,,!سانادا كازومي-كن
Dialogue: 0,0:29:17.44,0:29:20.08,CharCard,,0000,0000,0007,,{\fad(300,0)}(سانادا كازومي (27\Nساحر
Dialogue: 0,0:29:20.21,0:29:23.31,Default,,0000,0000,0000,,يا سادة، هلّا صفّقنا له بحرارة
Dialogue: 0,0:29:23.31,0:29:25.77,Default,,0000,0000,0000,,لتمثيله المُتقن لنهاية كايتو كيد البائسة؟
Dialogue: 0,0:29:28.68,0:29:33.52,Default,,0000,0000,0000,,.فهمت، كايتو كيد ساحر بارع\Nفهذا دور مثاليّ لك
Dialogue: 0,0:29:34.59,0:29:39.23,Default,,0000,0000,0000,,...صحيحٌ أنّنا فنّانان متخصصان في خداع الأعين
Dialogue: 0,0:29:39.23,0:29:40.65,Default,,0000,0000,0000,,فنّانان؟
Dialogue: 0,0:29:40.96,0:29:45.61,Default,,0000,0000,0000,,لكنّي ساحر بأصلي، لن أخسر أمام \Nمن يمتهن اللصوصية
Dialogue: 0,0:29:46.29,0:29:48.87,Default,,0000,0000,0000,,إذاً يا سادة، تعالوا قرب المسرح رجاءً
Dialogue: 0,0:29:48.87,0:29:50.62,Default,,0000,0000,0000,,!سأريكم بعضاً من سحري
Dialogue: 0,0:29:51.49,0:29:55.57,Default,,0000,0000,0000,,اللصّ هو فنّان مُبدع يسرق فريسته بحرفيّة
Dialogue: 0,0:29:55.99,0:29:58.24,Default,,0000,0000,0000,,لكنّ المتحري ليس أكثر من ناقد
Dialogue: 0,0:29:58.73,0:30:01.52,Default,,0000,0000,0000,,يتفحّص البقايا ويبحث عن عيوب
Dialogue: 0,0:30:03.11,0:30:04.78,Default,,0000,0000,0000,,!هـ-هذا الإحساس
Dialogue: 0,0:30:06.11,0:30:09.09,Default,,0000,0000,0000,,!إنّه هو! إنّه موجود هنا
Dialogue: 0,0:30:10.01,0:30:12.69,Default,,0000,0000,0000,,سأبدأ بحيلة بطاقات بسيطة
Dialogue: 0,0:30:13.43,0:30:16.61,Default,,0000,0000,0000,,تمهل! أنا كثير الشكّ بطبعي
Dialogue: 0,0:30:17.89,0:30:19.87,Default,,0000,0000,0000,,هل تتركني أخلط البطاقات؟
Dialogue: 0,0:30:20.59,0:30:24.11,Default,,0000,0000,0000,,بالطبع، لا أمانع. هل هناك آخرون\Nيريدون ذلك أيضاً؟
Dialogue: 0,0:30:24.46,0:30:27.07,Default,,0000,0000,0000,,!من؟ من هو كايتو كيد؟
Dialogue: 0,0:30:27.92,0:30:28.62,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:30:29.94,0:30:31.63,Default,,0000,0000,0000,,!كلّهم أصبحوا يبدون مثيرين للريبة
Dialogue: 0,0:30:33.01,0:30:34.74,Default,,0000,0000,0000,,...ما قالته أمّ سونوكو
Dialogue: 0,0:30:35.97,0:30:39.58,Default,,0000,0000,0000,,اللؤلؤة السوداء بحوزة\Nأكثر شخص لائق بها
Dialogue: 0,0:30:40.81,0:30:42.70,Default,,0000,0000,0000,,...إذا فهمتُ ما قصدتَه على الأقل
Dialogue: 0,0:30:46.97,0:30:48.63,Default,,0000,0000,0000,,!آ-آسف
Dialogue: 0,0:30:48.73,0:30:52.74,Default,,0000,0000,0000,,لا بأس، سقوط البطاقات لن يعني\Nسقوط القمر الذي يشعّ بحظّي
Dialogue: 0,0:30:54.06,0:30:54.71,Default,,0000,0000,0000,,القمر(تسكي)؟
Dialogue: 0,0:30:56.19,0:31:00.46,Default,,0000,0000,0000,,أليست معك لائحة حضور\Nهذه الحفلة يا عمّ؟
Dialogue: 0,0:31:00.68,0:31:01.47,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:31:01.47,0:31:02.78,Default,,0000,0000,0000,,هلّا أريتني إيّاها؟
Dialogue: 0,0:31:03.01,0:31:05.20,Default,,0000,0000,0000,,هذه؟ هاك
Dialogue: 0,0:31:08.22,0:31:09.09,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:31:09.09,0:31:11.21,Default,,0000,0000,0000,,شكراً يا آنستيّ
Dialogue: 0,0:31:11.21,0:31:13.62,Default,,0000,0000,0000,,سأعطيكما بطاقةً في المقابل
Dialogue: 0,0:31:14.13,0:31:15.22,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:31:16.13,0:31:21.20,Default,,0000,0000,0000,,مهلك! دعيني أستعمل أشعّتي السينية لقراءة أفكاركما
Dialogue: 0,0:31:21.20,0:31:23.45,Default,,0000,0000,0000,,!والتنبّؤ بالبطاقة
Dialogue: 0,0:31:25.78,0:31:27.12,Default,,0000,0000,0000,,!أشعر بإثارة
Dialogue: 0,0:31:27.12,0:31:27.70,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:31:28.65,0:31:30.11,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:31:30.69,0:31:34.52,Default,,0000,0000,0000,,لذا قال ذلك في رسالته الثانية
Dialogue: 0,0:31:34.52,0:31:36.08,Default,,0000,0000,0000,,فهمت يا كايتو كيد
Dialogue: 0,0:31:36.90,0:31:38.98,Default,,0000,0000,0000,,!أعرف مكان فريستك التي تستهدفها
Dialogue: 0,0:31:43.97,0:31:46.31,Default,,0000,0000,0000,,حمامة؟ هاتو؟ قلب؟
Dialogue: 0,0:31:46.31,0:31:48.33,Default,,0000,0000,0000,,!ستكون آص القلوب إذاً
Dialogue: 0,0:31:50.80,0:31:53.49,Default,,0000,0000,0000,,هيّا، اسحبا أيّ بطاقة تريدان من فضلكما
Dialogue: 0,0:31:54.30,0:31:57.13,Default,,0000,0000,0000,,!ران! اليُمنى! اختاري اليُمنى
Dialogue: 0,0:31:59.62,0:32:04.41,Default,,0000,0000,0000,,،كما كان قيصر مولعاً بكليوباترا"\Nأنا بجانبك بالفعل
Dialogue: 0,0:32:04.41,0:32:05.53,Default,,0000,0000,0000,,"كايتو كيد-
Dialogue: 0,0:32:06.20,0:32:06.97,Default,,0000,0000,0000,,!كيد
Dialogue: 0,0:32:06.97,0:32:07.99,Default,,0000,0000,0000,,!لقد ظهر
Dialogue: 0,0:32:08.18,0:32:11.45,Default,,0000,0000,0000,,!اهدؤوا جميعاً! تحقّقوا من كلمات السرّ رجاءً
Dialogue: 0,0:32:12.15,0:32:16.01,Default,,0000,0000,0000,,ناكاموري-كن! لا تخبرني\N!أنّ اللؤلؤة سُرقت بالفعل
Dialogue: 0,0:32:16.40,0:32:19.90,Default,,0000,0000,0000,,لم يأخذها بعد، ولم يهرب أيضاً
Dialogue: 0,0:32:20.39,0:32:24.32,Default,,0000,0000,0000,,!يحاول إرباكنا كي يتلاعب بنا
Dialogue: 0,0:32:24.46,0:32:28.76,Default,,0000,0000,0000,,لا تقلقوا، يمكننا القبض عليه! فهو ليس ساحراً
Dialogue: 0,0:32:28.76,0:32:31.48,Default,,0000,0000,0000,,إنّه بشريّ يعتمد على الحيل فحسب
Dialogue: 0,0:32:40.50,0:32:43.04,Default,,0000,0000,0000,,رسالة من كايتو كيد حقّاً؟
Dialogue: 0,0:32:43.04,0:32:46.62,Default,,0000,0000,0000,,نعم! كانت على البطاقة\N!التي اختارتها ران
Dialogue: 0,0:32:47.45,0:32:51.07,Default,,0000,0000,0000,,لكن كيف ومتى أضافها؟
Dialogue: 0,0:32:51.07,0:32:55.01,Default,,0000,0000,0000,,كيد مراوغ، كلّ ما يتعلّق به غامض
Dialogue: 0,0:32:55.19,0:33:00.34,Default,,0000,0000,0000,,ما نعلمه يقيناً هو أنّه بيننا بالفعل
Dialogue: 0,0:33:00.73,0:33:03.27,Default,,0000,0000,0000,,!الزموا الهدوء جميعاً
Dialogue: 0,0:33:03.27,0:33:07.49,Default,,0000,0000,0000,,أيمكن أنّه يعرف أين اللؤلؤة الحقيقية؟
Dialogue: 0,0:33:08.48,0:33:12.41,Default,,0000,0000,0000,,حتّى لو عرف، هذا سجنٌ عائم
Dialogue: 0,0:33:13.34,0:33:16.92,Default,,0000,0000,0000,,أيمكنه سرقة النجم الأسود والهرب
Dialogue: 0,0:33:16.92,0:33:19.94,Default,,0000,0000,0000,,مع تواجد الشرطة المكثّف حقّاً؟
Dialogue: 0,0:33:34.36,0:33:38.19,Default,,0000,0000,0000,,حضرة المفتّش، سنصل مرفأ طوكيو\N!بعد 30 دقيقة
Dialogue: 0,0:33:38.31,0:33:43.20,Default,,0000,0000,0000,,!حسنٌ، أقفلوا كلّ مخارج القاعة\N!لا تسمحوا لأحد بالخروج
Dialogue: 0,0:33:43.46,0:33:46.03,Default,,0000,0000,0000,,أظهر حركتك يا كايتو كيد
Dialogue: 0,0:33:46.52,0:33:50.77,Default,,0000,0000,0000,,إذا كنتَ ستقوم بشيء، فهذه فرصتك\N!مع توتّر الضيوف
Dialogue: 0,0:33:51.80,0:33:54.95,Default,,0000,0000,0000,,ر-ران! أين ذهبت لؤلؤتك؟
Dialogue: 0,0:33:55.18,0:33:56.12,Default,,0000,0000,0000,,!ماذا؟ مُحال
Dialogue: 0,0:33:58.67,0:34:01.15,Default,,0000,0000,0000,,المعذرة! أيمكن لأحد حمل تلك اللؤلؤة؟
Dialogue: 0,0:34:05.50,0:34:06.16,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:34:06.16,0:34:07.28,Default,,0000,0000,0000,,!ما كان ذاك الصوت؟
Dialogue: 0,0:34:07.28,0:34:10.99,Default,,0000,0000,0000,,!اللؤلؤة! اللؤلؤة انفجرت
Dialogue: 0,0:34:11.49,0:34:14.20,Default,,0000,0000,0000,,...أ-أيمكن أنّ كيد فخّخها
Dialogue: 0,0:34:19.23,0:34:20.96,Default,,0000,0000,0000,,!لا تعبثوا معي
Dialogue: 0,0:34:21.12,0:34:22.32,Default,,0000,0000,0000,,!لن أرتدي هذه
Dialogue: 0,0:34:27.98,0:34:30.53,Default,,0000,0000,0000,,!اهدؤوا جميعاً! اهدؤوا رجاءً
Dialogue: 0,0:34:33.97,0:34:34.66,Default,,0000,0000,0000,,!أمّي
Dialogue: 0,0:34:35.18,0:34:36.31,Default,,0000,0000,0000,,أأنتِ بخير؟
Dialogue: 0,0:34:36.31,0:34:38.12,Default,,0000,0000,0000,,نعم، شكراً لك يا ران-تشان
Dialogue: 0,0:34:39.50,0:34:41.65,Default,,0000,0000,0000,,!افتح الباب بسرعة
Dialogue: 0,0:34:41.65,0:34:42.91,Default,,0000,0000,0000,,!لا يمكنني ذلك
Dialogue: 0,0:34:43.50,0:34:46.96,Default,,0000,0000,0000,,!ماذا؟ اختفت لؤلؤتك أيضاً يا أمّي
Dialogue: 0,0:34:52.53,0:34:55.66,Default,,0000,0000,0000,,!كان كيد! سرق كيد النجم الأسود
Dialogue: 0,0:34:56.16,0:35:00.76,Default,,0000,0000,0000,,ماذا؟! كانت الحقيقية خاصتك إذاً؟
Dialogue: 0,0:35:01.04,0:35:03.98,Default,,0000,0000,0000,,!حـ-حضرة المفتّش! لا نستطيع صدّهم أكثر
Dialogue: 0,0:35:08.47,0:35:10.99,Default,,0000,0000,0000,,!حضرة المفتّش! خرجت مجموعة كبيرة
Dialogue: 0,0:35:11.53,0:35:14.08,Default,,0000,0000,0000,,!كيد بينهم! أمسكوا به
Dialogue: 0,0:35:14.45,0:35:15.25,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:35:15.20,0:35:17.43,Default,,0000,0000,0000,,!ران-نيتشان! لنذهب للإمساك به بدورنا
Dialogue: 0,0:35:17.43,0:35:19.13,Default,,0000,0000,0000,,!ا-انتظر يا كونان-كن
Dialogue: 0,0:35:19.69,0:35:22.34,Default,,0000,0000,0000,,!عرفتُ هويّة كايتو كيد
Dialogue: 0,0:35:44.30,0:35:48.37,Default,,0000,0000,0000,,وصلت رسالة إخطار بسرقة مُقبلة \N،للنجم الأسود، جوهرة عائلة سوزوكي
Dialogue: 0,0:35:48.37,0:35:49.66,Default,,0000,0000,0000,,لمنزل سونوكو
Dialogue: 0,0:35:50.29,0:35:52.37,Default,,0000,0000,0000,,كان المُرسل كايتو كيد
Dialogue: 0,0:35:53.41,0:35:58.11,Default,,0000,0000,0000,,بعد حلّي لألغاز الرسالة، انتظرتُه وحدي\Nعلى سطح فندق مدينة هايدو
Dialogue: 0,0:35:59.22,0:36:01.33,Default,,0000,0000,0000,,هبط بصمتٍ أمامي
Dialogue: 0,0:36:01.33,0:36:03.68,Default,,0000,0000,0000,,كيلا يعكّر سكون الليل
Dialogue: 0,0:36:04.90,0:36:07.34,Default,,0000,0000,0000,,كانت لديّ فرصة واحدة فحسب\N!لاستعمال الإبرة المخدّرة
Dialogue: 0,0:36:07.34,0:36:10.29,Default,,0000,0000,0000,,!لحظة استدارته والهرب
Dialogue: 0,0:36:11.06,0:36:16.06,Default,,0000,0000,0000,,لكن بدل الهرب، قلّد أصوات عدّة أشخاص\Nدون استعمال أداة
Dialogue: 0,0:36:16.06,0:36:20.33,Default,,0000,0000,0000,,!واستدرج الشرطة، ثمّ اختفى أمامنا كالدخان
Dialogue: 0,0:36:20.72,0:36:23.71,Default,,0000,0000,0000,,كلّ ما تبقّى هي رسالة إخطار أخرى
Dialogue: 0,0:36:24.18,0:36:26.26,Default,,0000,0000,0000,,،رغم معارضة المفتّش ناكاموري
Dialogue: 0,0:36:26.26,0:36:30.62,Default,,0000,0000,0000,,أقامت شركة سوزوكي حفلة\Nالذكرى الستّين على السفينة وفق المُخطط
Dialogue: 0,0:36:31.42,0:36:34.92,Default,,0000,0000,0000,,،ابتكرت أمّ سونوكو، سوزوكي توموكو
Dialogue: 0,0:36:34.92,0:36:37.41,Default,,0000,0000,0000,,خطّةً بدا أنّها ستفسد سعي كايتو كيد
Dialogue: 0,0:36:38.05,0:36:42.54,Default,,0000,0000,0000,,لكنّه فجّر اللآلئ وسرق النجم الأسود\N!ببراعة أثناء الفوضى
Dialogue: 0,0:36:42.86,0:36:46.92,Default,,0000,0000,0000,,!اكتشفتُ هويّتك يا كايتو كيد
Dialogue: 0,0:36:51.65,0:36:53.67,Default,,0000,0000,0000,,!ماذا؟! لم تجدوا كيد؟
Dialogue: 0,0:36:54.10,0:36:58.62,Default,,0000,0000,0000,,كلا، فتّشنا كلّ الركّاب الذين\N...خرجوا من القاعة قبل قليل، لكن
Dialogue: 0,0:36:59.09,0:37:05.01,Default,,0000,0000,0000,,!لا يزال على متن السفينة بلا شكّ\N!فلتفتّشوا كلّ الخمسمئة راكب فرداً فرداً
Dialogue: 0,0:37:05.01,0:37:06.01,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:37:07.55,0:37:13.77,Default,,0000,0000,0000,,لكن كيف عرف كيد أنّ النجم الأسود\Nالحقيقيّ هو الذي ترتديه السيّدة؟
Dialogue: 0,0:37:15.54,0:37:18.74,Default,,0000,0000,0000,,!نحن في غرفة المحرّكات يا كونان-كن
Dialogue: 0,0:37:18.74,0:37:21.08,Default,,0000,0000,0000,,هل يوجد كايتو كيد هنا حقّاً؟
Dialogue: 0,0:37:27.57,0:37:30.88,Default,,0000,0000,0000,,أخبريني يا ران-نيتشان، هل تعرفين لغة الجواهر؟
Dialogue: 0,0:37:30.94,0:37:32.24,Default,,0000,0000,0000,,لغة الجواهر؟
Dialogue: 0,0:37:32.62,0:37:35.73,Default,,0000,0000,0000,,"اللؤلؤة تعني "القمر"، أو "امرأة
Dialogue: 0,0:37:35.73,0:37:40.35,Default,,0000,0000,0000,,بين ركّاب السفينة، المرأة الوحيدة التي\Nكان رمز القمر في اسمها
Dialogue: 0,0:37:40.35,0:37:41.94,Default,,0000,0000,0000,,هي سوزوكي توموكو-سان فحسب
Dialogue: 0,0:37:42.43,0:37:45.83,Default,,0000,0000,0000,,أي كانت اللؤلؤة الحقيقية معها
Dialogue: 0,0:37:48.79,0:37:51.79,Default,,0000,0000,0000,,لكن كيف عرفت هويّة كيد من ذلك؟
Dialogue: 0,0:37:52.42,0:37:53.75,Default,,0000,0000,0000,,!البطاقات
Dialogue: 0,0:37:53.75,0:37:58.62,Default,,0000,0000,0000,,ألم تكن رسالة كيد على البطاقة التي اخترتِها؟
Dialogue: 0,0:37:58.62,0:37:59.64,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:38:00.70,0:38:05.58,Default,,0000,0000,0000,,سرّ تلك الحيلة يكمن في لفت انتباه\Nالمشاهدين للحمامة في يده اليمنى
Dialogue: 0,0:38:05.58,0:38:08.74,Default,,0000,0000,0000,,بينما يبدّل مجموعة البطاقات بيده اليسرى
Dialogue: 0,0:38:09.61,0:38:15.63,Default,,0000,0000,0000,,لذا ستكون الورقة التي ستختارونها ثابتةً\Nمهما خلطتم الأوراق
Dialogue: 0,0:38:16.40,0:38:19.75,Default,,0000,0000,0000,,...وجود الرسالة على تلك البطاقة يعني إذاً
Dialogue: 0,0:38:20.22,0:38:23.75,Default,,0000,0000,0000,,!أنّ كايتو كيد كان ذاك الساحر سانادا؟
Dialogue: 0,0:38:24.24,0:38:29.30,Default,,0000,0000,0000,,كلا، كنتُ أراقبه طوال الوقت\Nلكنّه لم يقترب من السيّدة
Dialogue: 0,0:38:29.90,0:38:31.75,Default,,0000,0000,0000,,من هو إذاً؟
Dialogue: 0,0:38:31.75,0:38:34.77,Default,,0000,0000,0000,,يوجد شخص آخر كان بمقدوره تبديل البطاقات
Dialogue: 0,0:38:35.23,0:38:39.59,Default,,0000,0000,0000,,نعم، تظاهر بالمساعدة في جمع البطاقات\Nالمترامية على الأرض
Dialogue: 0,0:38:39.59,0:38:42.64,Default,,0000,0000,0000,,!وأخذ بطاقةً وألصق الرسالة عليها
Dialogue: 0,0:38:43.59,0:38:49.45,Default,,0000,0000,0000,,أخفاها في راحة يده، وتظاهر بسحبه\Nلبطاقة من المجموعة
Dialogue: 0,0:38:51.79,0:38:53.27,Default,,0000,0000,0000,,أليس كذلك يا ران-نيتشان؟
Dialogue: 0,0:38:53.93,0:38:55.93,Default,,0000,0000,0000,,بل يا كايتو كيد-سان؟
Dialogue: 0,0:39:03.41,0:39:06.48,Default,,0000,0000,0000,,!هنا المروحيّة رقم 1! لم يحاول أحد الهروب من السفينة
Dialogue: 0,0:39:07.03,0:39:10.43,Default,,0000,0000,0000,,هنا المروحيّة رقم 2! لا أشخاص مشبوهين \N!على سطح السفينة
Dialogue: 0,0:39:10.86,0:39:14.20,Default,,0000,0000,0000,,!هنا قسم المراقبة! لا يُظهر السونار والرادار شيئاً
Dialogue: 0,0:39:14.69,0:39:16.89,Default,,0000,0000,0000,,!حسنٌ، أكملوا المراقبة
Dialogue: 0,0:39:17.52,0:39:20.64,Default,,0000,0000,0000,,على كلّ الضبّاط على متن السفينة\Nالانتشار في الطوابق
Dialogue: 0,0:39:20.64,0:39:22.31,Default,,0000,0000,0000,,!والقبض على كيد حال رؤيته
Dialogue: 0,0:39:22.85,0:39:27.23,Default,,0000,0000,0000,,!لا ترخوا حذركم لرؤية أشخاص مألوفين\N!فهو متخصّص في التنكّر
Dialogue: 0,0:39:31.59,0:39:37.98,Default,,0000,0000,0000,,أجل، أخذتَ مكان ران بعدما\Nغادرت القاعة للبحث عنّي
Dialogue: 0,0:39:38.41,0:39:41.22,Default,,0000,0000,0000,,مُبهر، لم أنتبه البتّة
Dialogue: 0,0:39:42.67,0:39:48.26,Default,,0000,0000,0000,,بعدما تنكّرت بهيئتها، أثرت الهلع\Nبين الضيوف برسالتك
Dialogue: 0,0:39:48.26,0:39:51.15,Default,,0000,0000,0000,,ونشرتَ اللآلئ المتفجّرة لإحداث الفزع
Dialogue: 0,0:39:53.27,0:39:57.89,Default,,0000,0000,0000,,ثمّ مستغّلاً الفوضى، سرقتَ النجم الأسود الحقيقيّ
Dialogue: 0,0:39:59.35,0:40:02.10,Default,,0000,0000,0000,,بتظاهرك بمساعدة السيّدة
Dialogue: 0,0:40:02.68,0:40:06.00,Default,,0000,0000,0000,,!ماذا؟ اختفت لؤلؤتك أيضاً يا أمّي
Dialogue: 0,0:40:09.50,0:40:12.57,Default,,0000,0000,0000,,!كان كيد! سرق كيد النجم الأسود
Dialogue: 0,0:40:13.67,0:40:17.61,Default,,0000,0000,0000,,تحضيرك لتلك الألعاب النارية\Nيعني أنّك كنت تعرف
Dialogue: 0,0:40:17.84,0:40:21.30,Default,,0000,0000,0000,,أنّها طلبت صنع كميّة كبيرة من النسخ
Dialogue: 0,0:40:21.87,0:40:24.95,Default,,0000,0000,0000,,!كفّ عن المزاح يا كونان-كن
Dialogue: 0,0:40:25.12,0:40:29.65,Default,,0000,0000,0000,,!لم أعرف أيّ واحدة هي الحقيقية\N!ولم يكن لدي أيّ تلميح حتّى
Dialogue: 0,0:40:30.69,0:40:34.52,Default,,0000,0000,0000,,عرفتَ اللؤلؤة الحقيقية دون الحاجة لتلميحات
Dialogue: 0,0:40:35.23,0:40:39.51,Default,,0000,0000,0000,,بعدما أخرجت السيّدة لؤلؤتها السوداء\Nمن الصندوق بقفّاز
Dialogue: 0,0:40:40.10,0:40:44.47,Default,,0000,0000,0000,,تتكوّن اللآلئ من كربونات الكالسيوم\Nمما يجعلها سريعة التفاعل مع الأحماض
Dialogue: 0,0:40:45.02,0:40:50.47,Default,,0000,0000,0000,,إذا مسّها الزيت على الأصابع\Nسيتأكسد السطح فتفقد بريقها
Dialogue: 0,0:40:51.59,0:40:54.70,Default,,0000,0000,0000,,رغم أنّ بعض الحضور كانوا ملمّين بذلك
Dialogue: 0,0:40:59.29,0:41:04.02,Default,,0000,0000,0000,,أدركتَ أنّه يستحيل أن تعطي\Nجوهرةً رقيقة كهذه لأيّ أحد آخر
Dialogue: 0,0:41:04.66,0:41:06.38,Default,,0000,0000,0000,,...لكنّ ذلك لا يكفي
Dialogue: 0,0:41:06.42,0:41:08.72,Default,,0000,0000,0000,,...بالفعل لا يكفي، لكن
Dialogue: 0,0:41:09.74,0:41:15.99,Default,,0000,0000,0000,,،إذا أضفتَ لمعان لؤلؤتها الخافت في الاعتبار\Nسيتحوّل الظنّ ليقين
Dialogue: 0,0:41:17.24,0:41:24.49,Default,,0000,0000,0000,,نعم، مثلما يبهت لون اللآلئ القديمة\N،المعروضة في المتاحف الشهيرة بمرور الوقت
Dialogue: 0,0:41:25.02,0:41:28.05,Default,,0000,0000,0000,,يبقى بريق اللؤلؤة لبضعة عقود على الأكثر
Dialogue: 0,0:41:29.01,0:41:32.38,Default,,0000,0000,0000,,لا يمكن أنّ النجم الأسود\Nالذي اُقتني قبل 60 عاماً
Dialogue: 0,0:41:32.38,0:41:35.76,Default,,0000,0000,0000,,محتفظ بجماله اللامع الآن
Dialogue: 0,0:41:36.18,0:41:37.99,Default,,0000,0000,0000,,لذا كان الأمر جليّاً
Dialogue: 0,0:41:38.00,0:41:43.10,Default,,0000,0000,0000,,عندما رأيت تعاملها الحذر\N!مع لؤلؤتها الباهتة بالقفّاز
Dialogue: 0,0:41:46.43,0:41:48.06,Default,,0000,0000,0000,,...مُثير للشفقة
Dialogue: 0,0:41:48.38,0:41:51.99,Default,,0000,0000,0000,,أشغلتَ انتباهي فنسيتُ هذه الحقيقة تماماً
Dialogue: 0,0:41:52.75,0:41:57.60,Default,,0000,0000,0000,,لكن ألم يكن النجم الأسود\Nفي متحف بيكا شديد اللمعان؟
Dialogue: 0,0:41:57.90,0:42:02.11,Default,,0000,0000,0000,,لذا لم تأخذه، عرفتَ أنّه مزيّف
Dialogue: 0,0:42:04.41,0:42:07.83,Default,,0000,0000,0000,,ثمّ تحدّيت السيّدة برسالتك الثانية
Dialogue: 0,0:42:07.94,0:42:10.40,Default,,0000,0000,0000,,وأخبرتها أن تحضر الحقيقيّ
Dialogue: 0,0:42:11.19,0:42:14.20,Default,,0000,0000,0000,,حرصتَ على كتابة "الحقيقيّ" حتّى
Dialogue: 0,0:42:15.53,0:42:19.57,Default,,0000,0000,0000,,حسناً، إذا كنت تشكّ بي لهذا الحدّ\N...فسأتّصل بشرطيّ من هنا و
Dialogue: 0,0:42:28.05,0:42:31.24,Default,,0000,0000,0000,,لن أسمح لك بالاختفاء بنفس طريقتك على السطح
Dialogue: 0,0:42:32.59,0:42:36.41,Default,,0000,0000,0000,,لم تستدرج الشرطة آنذاك للعبث معي
Dialogue: 0,0:42:37.71,0:42:40.80,Default,,0000,0000,0000,,أوهمتنا أنّك ستطير بطائرتك الشراعية
Dialogue: 0,0:42:41.73,0:42:44.03,Default,,0000,0000,0000,,ثمّ تنكّرت بهيئة شرطيّ سريعاً\Nفي وميض القنبلة
Dialogue: 0,0:42:44.58,0:42:47.20,Default,,0000,0000,0000,,واختبأت بينهم وأخفيت نفسك
Dialogue: 0,0:42:49.59,0:42:53.19,Default,,0000,0000,0000,,كما ليس من اللائق استدعاء أحد هنا
Dialogue: 0,0:42:54.28,0:42:57.40,Default,,0000,0000,0000,,فقد أبديتُ احتراماً وأعددتُ مواجهة فردية
Dialogue: 0,0:42:57.40,0:43:02.50,Default,,0000,0000,0000,,مع اللص الفنّان الذي تسلّل رغم الحراسة المُشدّدة
Dialogue: 0,0:43:02.69,0:43:08.03,Default,,0000,0000,0000,,نعم، يشتهر مُعظم الفنّانين البارعين بعد موتهم
Dialogue: 0,0:43:09.16,0:43:11.65,Default,,0000,0000,0000,,سأجعلك أستاذاً عظيماً يا كايتو كيد
Dialogue: 0,0:43:12.98,0:43:15.25,Default,,0000,0000,0000,,بإرسالك للمقبرة المعروفة بالسجن
Dialogue: 0,0:43:22.97,0:43:26.01,Default,,0000,0000,0000,,أستسلم، سأترك لك هذه اللؤلؤة
Dialogue: 0,0:43:26.64,0:43:30.84,Default,,0000,0000,0000,,انقل اعتذاري للسيّدة\N!على إفسادي حفلتها
Dialogue: 0,0:43:33.27,0:43:34.75,Default,,0000,0000,0000,,ماذا تقول الآن؟
Dialogue: 0,0:43:34.75,0:43:40.30,Default,,0000,0000,0000,,بالمناسبة، الفتاة التي أفقدتها وعيها\N...لأخذ هذه الملابس
Dialogue: 0,0:43:40.86,0:43:43.41,Default,,0000,0000,0000,,!عليك الإسراع وإلّا سيصيبها الزكام
Dialogue: 0,0:43:44.19,0:43:46.37,Default,,0000,0000,0000,,!فأنا أقوم بعملي على أكمل وجه
Dialogue: 0,0:43:51.43,0:43:52.37,Default,,0000,0000,0000,,!قنبلة ضوئية أخرى
Dialogue: 0,0:43:53.34,0:43:54.21,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:43:54.83,0:43:56.76,Default,,0000,0000,0000,,!سحقاً! لن أتركك تهرب
Dialogue: 0,0:44:03.44,0:44:04.12,Default,,0000,0000,0000,,!الوغد
Dialogue: 0,0:44:04.87,0:44:05.83,Default,,0000,0000,0000,,!سأنال منك لهذا
Dialogue: 0,0:44:19.86,0:44:22.64,Default,,0000,0000,0000,,!توجد فتاة نائمة في القارب هنا
Dialogue: 0,0:44:22.93,0:44:23.64,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:44:26.07,0:44:29.08,Default,,0000,0000,0000,,لمَ هي هنا؟ بأيّ حال، لنضعها على الأرض
Dialogue: 0,0:44:29.60,0:44:31.21,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:44:31.74,0:44:34.55,Default,,0000,0000,0000,,!كلا! لا تخرجها! انتظر
Dialogue: 0,0:44:35.66,0:44:36.28,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:44:41.28,0:44:45.79,Default,,0000,0000,0000,,الفستان القرمزيّ الذي أعطيتِني إيّاه"\Nذاك اليوم يلائمك كثيراً
Dialogue: 0,0:44:46.59,0:44:49.74,Default,,0000,0000,0000,,"من عامل مغسلة الملابس في أحيان، كايتو كيد-
Dialogue: 0,0:44:50.94,0:44:52.01,Default,,0000,0000,0000,,...الوغد
Dialogue: 0,0:45:08.62,0:45:14.68,Default,,0000,0000,0000,,وجدوا لاحقاً الطائرة الشراعية\Nالتي نوى كايتو كيد الهرب عبرها غالباً
Dialogue: 0,0:45:15.79,0:45:21.05,Default,,0000,0000,0000,,لكنّه اختفى تماماً من السفينة بلا أثر
Dialogue: 0,0:46:55.93,0:47:02.84,Radio,,0000,0000,15,,!طالب مميّز في الابتدائية حمى النجم الأسود بمفرده\N!!اعترض كايتو كيد
Dialogue: 0,0:46:56.68,0:47:02.69,Default,,0000,0000,0000,,ها أنت! "طالب مميّز في الابتدائية حمى\N"!النجم الأسود بمفرده
Dialogue: 0,0:47:03.21,0:47:05.30,Default,,0000,0000,0000,,!أنت بطلٌ كبير يا كونان-كن
Dialogue: 0,0:47:05.92,0:47:08.25,Default,,0000,0000,0000,,كانت محض مصادفة
Dialogue: 0,0:47:08.83,0:47:13.12,Default,,0000,0000,0000,,لكن يا لحسن حظّكما، رأيتما كيد مباشرةً
Dialogue: 0,0:47:13.12,0:47:14.22,Default,,0000,0000,0000,,لا حسن في ذلك
Dialogue: 0,0:47:14.62,0:47:16.78,Default,,0000,0000,0000,,أخبريني، كيف كانت ملامحه؟
Dialogue: 0,0:47:17.61,0:47:18.72,Default,,0000,0000,0000,,ران؟
Dialogue: 0,0:47:19.11,0:47:19.90,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:47:19.90,0:47:21.42,Default,,0000,0000,0000,,!أسألك عن ملامح كيد
Dialogue: 0,0:47:21.77,0:47:24.88,Default,,0000,0000,0000,,...آسفة، أفقدني وعيي بغتةً
Dialogue: 0,0:47:25.07,0:47:26.98,Default,,0000,0000,0000,,رأيتُ وجهه قليلاً
Dialogue: 0,0:47:27.22,0:47:29.64,Default,,0000,0000,0000,,!أيّ رجلٍ كان؟
Dialogue: 0,0:47:29.64,0:47:34.55,Default,,0000,0000,0000,,،كان يافعاً لحدٍّ مُفاجئ، في عشرينياته\N...أو ربما
Dialogue: 0,0:47:37.39,0:47:39.46,Default,,0000,0000,0000,,!لا تنقل زكامك لي
Dialogue: 0,0:47:40.13,0:47:44.42,Default,,0000,0000,0000,,يا إلهي، تسقط في البحر بعدما \N!تجوّلت على متن سيليزابيث! يا للحماقة
Dialogue: 0,0:47:44.75,0:47:46.27,Default,,0000,0000,0000,,!اصمتي
Dialogue: 0,0:47:47.17,0:47:51.20,Default,,0000,0000,0000,,!إنّها غلطة ذاك الصبيّ، كان الهرب سباحةً خياري الوحيد
Dialogue: 0,0:47:51.99,0:47:54.30,Default,,0000,0000,0000,,...لحظة، ألا يشبه طالب الثانويّة ذاك
Dialogue: 0,0:47:54.83,0:47:56.67,Default,,0000,0000,0000,,شينتشي-كن نوعاً ما؟
Dialogue: 0,0:47:57.16,0:47:58.44,Default,,0000,0000,0000,,تظنّين ذلك؟
Dialogue: 0,0:47:58.44,0:48:01.64,Default,,0000,0000,0000,,قد يكون الشخص الذي\N...رأيتِه في شيبويا يا ران
Dialogue: 0,0:48:07.11,0:48:08.12,Default,,0000,0000,0000,,!حمداً لله
Dialogue: 0,0:48:08.77,0:48:10.00,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:48:15.61,0:48:17.12,Default,,0000,0000,0000,,!أأنت بخير؟
Dialogue: 0,0:48:17.12,0:48:20.22,Default,,0000,0000,0000,,ميتسواكي-سان! ما الذي يجري؟\N!ميتسواكي-سان
Dialogue: 0,0:48:31.53,0:48:32.87,Default,,0000,0000,0000,,!أين ميتسواكي-سان؟
Dialogue: 0,0:48:34.26,0:48:35.83,Default,,0000,0000,0000,,إنّه موجود، أسفلنا
Dialogue: 0,0:48:39.28,0:48:45.29,On Top,,0000,0000,0000,,قضيّة سلسلة حوادث الموت الغريبة للعائلة المرموقة\N(الجزء الأوّل)
Dialogue: 0,0:48:40.12,0:48:41.62,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:48:41.62,0:48:44.65,Default,,0000,0000,0000,,قضيّة سلسلة حوادث الموت الغريبة للعائلة المرموقة\Nا(لجزء الأوّل)
Dialogue: 0,0:48:45.96,0:48:47.94,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:48:48.12,0:48:50.28,Default,,0000,0000,0000,,متحرّي الغرب
Dialogue: 0,0:48:50.60,0:48:52.41,Default,,0000,0000,0000,,ستبثّ الحلقة القادمة 8/5
Dialogue: 0,0:48:52.41,0:48:54.92,Default,,0000,0000,0000,,!ريوكو هازوكي-تشان الجميلة، انتظريني

