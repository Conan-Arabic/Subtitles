Dialogue: 0,0:00:00.85,0:00:02.68,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:02.68,0:00:06.49,Default,,0000,0000,0000,,تعالج استنتاجات كونان القلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:06.49,0:00:08.38,Default,,0000,0000,0000,,تقبع قضيّة اليوم تحت غطاء الليل
Dialogue: 0,0:00:08.38,0:00:09.99,Default,,0000,0000,0000,,!الألغاز المُظلمة ينيرها ضوء الاستنتاج
Dialogue: 0,0:00:10.34,0:00:12.04,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.04,0:00:14.28,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.28,0:00:14.95,Default,,0000,0000,0000,,اسمه؟
Dialogue: 0,0:00:14.28,0:00:16.79,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.32,0:01:57.14,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل الطريق المُظلم
Dialogue: 0,0:01:52.11,0:01:55.24,Default,,0000,0000,0000,,جريمة قتل الطريق المُظلم
Dialogue: 0,0:01:59.98,0:02:02.85,Default,,0000,0000,0000,,كان ذلك لذيذاً جدّاً، صحيح يا كونان-كن؟
Dialogue: 0,0:02:02.85,0:02:03.59,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:03.59,0:02:07.09,Default,,0000,0000,0000,,!يا إلهي، لم تطلبا إلّا الأكل الباهظ
Dialogue: 0,0:02:07.09,0:02:09.31,Default,,0000,0000,0000,,!عجباً، إنّه أنت يا موري
Dialogue: 0,0:02:09.31,0:02:12.09,On Top,,0000,0000,0000,,!أومورا! مضى وقتٌ طويل
Dialogue: 0,0:02:09.78,0:02:14.10,CharCard,,0000,0000,0003,,{\fad(300,0)}(أومورا جون (37\Nزميل قديم لموري، مدير متجر نماذج
Dialogue: 0,0:02:12.09,0:02:14.10,On Top,,0000,0000,0000,,تبدو مفعماً بالحياة كالمُعتاد
Dialogue: 0,0:02:14.58,0:02:17.16,Default,,0000,0000,0000,,أتذكر أومورا-سان يا كونان-كن؟
Dialogue: 0,0:02:17.16,0:02:21.52,Default,,0000,0000,0000,,أجل، إنّه صديق العمّ من أيام الجامعة\N!الذي التقيناه في الينبوع الساخن
Dialogue: 0,0:02:21.83,0:02:26.45,Default,,0000,0000,0000,,.بالمناسبة يا موري، هذه فرصة ممتازة\Nهناك ما أريد الكلام معك بشأنه
Dialogue: 0,0:02:26.45,0:02:27.70,Default,,0000,0000,0000,,ما هو؟
Dialogue: 0,0:02:27.70,0:02:31.73,Default,,0000,0000,0000,,أسمع صوتاً غريباً خارج شقّتي\Nفي الليل مؤخراً
Dialogue: 0,0:02:32.07,0:02:33.18,Default,,0000,0000,0000,,صوت غريب؟
Dialogue: 0,0:02:34.89,0:02:38.52,Default,,0000,0000,0000,,إنّه ارتطام، كما لو أصاب شيء الحائط الخارجي
Dialogue: 0,0:02:38.52,0:02:41.52,Default,,0000,0000,0000,,لعلّها مشاغبة أطفال الحيّ
Dialogue: 0,0:02:42.19,0:02:47.01,Default,,0000,0000,0000,,ذلك ما ظننته بدايةً، لكنّي لم أجد\Nأحداً عندما خرجتُ للتفقّد
Dialogue: 0,0:02:47.01,0:02:49.73,Default,,0000,0000,0000,,وهذا مستمرّ لأسبوع الآن
Dialogue: 0,0:02:50.63,0:02:52.30,Default,,0000,0000,0000,,أسبوع؟
Dialogue: 0,0:02:52.30,0:02:54.68,Default,,0000,0000,0000,,لمَ لا نذهب ونتفقد الأمر؟
Dialogue: 0,0:02:55.08,0:02:56.83,Default,,0000,0000,0000,,من فضلك يا موري
Dialogue: 0,0:02:58.42,0:03:02.65,Default,,0000,0000,0000,,!حسناً، دع الأمر للمتحرّي العظيم موري كوغورو
Dialogue: 0,0:03:03.41,0:03:04.56,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:03:11.74,0:03:12.73,Default,,0000,0000,0000,,!لذيذ
Dialogue: 0,0:03:13.10,0:03:16.43,Default,,0000,0000,0000,,!ما أروع الشرب مع صديق بعد غياب
Dialogue: 0,0:03:16.73,0:03:19.94,Default,,0000,0000,0000,,ظننتُك أتيت لتحرّي الصوت الغريب
Dialogue: 0,0:03:20.52,0:03:23.01,Default,,0000,0000,0000,,يبدو أنّ الجعّة نفدت
Dialogue: 0,0:03:23.01,0:03:23.93,Default,,0000,0000,0000,,سأذهب لشرائها
Dialogue: 0,0:03:23.93,0:03:25.89,Default,,0000,0000,0000,,!سأذهب أنا
Dialogue: 0,0:03:26.34,0:03:27.80,Default,,0000,0000,0000,,!شكراً جزيلاً
Dialogue: 0,0:03:49.16,0:03:50.65,Default,,0000,0000,0000,,!أنتَ تزعج الجيران
Dialogue: 0,0:03:53.15,0:03:54.77,Default,,0000,0000,0000,,!عدنا
Dialogue: 0,0:03:55.94,0:03:57.65,Default,,0000,0000,0000,,!كنّا بانتظارك
Dialogue: 0,0:04:03.85,0:04:04.68,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:04:09.89,0:04:11.80,Default,,0000,0000,0000,,...ما الذي
Dialogue: 0,0:04:11.80,0:04:13.89,Default,,0000,0000,0000,,إيكوتا، ما الخطب؟
Dialogue: 0,0:04:13.89,0:04:16.73,Default,,0000,0000,0000,,!إيكوتا، أجب عليّ! إيكوتا
Dialogue: 0,0:04:17.17,0:04:19.17,Default,,0000,0000,0000,,!يكفي عبثاً
Dialogue: 0,0:04:19.17,0:04:20.73,Default,,0000,0000,0000,,...إيكوتا! إيكوتا
Dialogue: 0,0:04:23.08,0:04:24.68,Default,,0000,0000,0000,,!إ-إنّه ميت
Dialogue: 0,0:04:24.68,0:04:25.84,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:32.83,0:04:34.44,Default,,0000,0000,0000,,!ران! اتّصلي بالشرطة
Dialogue: 0,0:04:34.44,0:04:35.11,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:04:36.27,0:04:38.48,Default,,0000,0000,0000,,ضربة للرأس بأداة صُلبة
Dialogue: 0,0:04:40.90,0:04:43.13,Default,,0000,0000,0000,,الكثير من أعقاب السجائر
Dialogue: 0,0:04:48.31,0:04:51.26,On Top,,0000,0000,0000,,الضحيّة هو إيكوتا يوشيرو-سان، 20 عاماً
Dialogue: 0,0:04:48.51,0:04:53.58,CharCard,,0000,0000,0003,,{\fad(300,0)}(إيكوتا يوشيرو (20 \Nطالب سنة ثانية، جامعة بيكا
Dialogue: 0,0:04:51.26,0:04:53.43,On Top,,0000,0000,0000,,طالب في السنة الثانية\Nفي جامعة بيكا
Dialogue: 0,0:04:53.75,0:04:56.39,Default,,0000,0000,0000,,...وأنت من كان بجانب الضحيّة
Dialogue: 0,0:04:56.84,0:05:01.08,CharCard,,0000,0000,0004,,{\fad(300,0)}(كوساكا ماسامي (20 \Nطالب سنة ثانية، جامعة بيكا
Dialogue: 0,0:04:56.92,0:05:02.05,On Top,,0000,0000,0000,,أُدعى كوساكا، زميل إيكوتا في الجامعة
Dialogue: 0,0:05:02.05,0:05:05.49,Default,,0000,0000,0000,,هلّا وضّحت ظروف عثورك عليه؟
Dialogue: 0,0:05:05.49,0:05:06.39,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:05:06.39,0:05:09.85,Default,,0000,0000,0000,,كان يُفترض أن ألتقي بإيكوتا هنا\Nفي تمام العاشرة الليلة
Dialogue: 0,0:05:10.29,0:05:14.39,Default,,0000,0000,0000,,...لكن بينما كنتُ أنادي عليه، انهار فجأةً
Dialogue: 0,0:05:14.39,0:05:17.15,Default,,0000,0000,0000,,أشاهدت شخصاً آخر وقتها؟
Dialogue: 0,0:05:17.15,0:05:17.60,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:05:18.07,0:05:21.15,Default,,0000,0000,0000,,لكن كان الظلام حالكاً، فلم أستطع الرؤية
Dialogue: 0,0:05:22.53,0:05:26.89,Default,,0000,0000,0000,,بالكاد استطعتُ رؤية إيكوتا بالأصل \Nمع تحطّم مصباح الشارع
Dialogue: 0,0:05:28.27,0:05:30.72,Default,,0000,0000,0000,,ألم تكن من قتله؟
Dialogue: 0,0:05:30.72,0:05:32.22,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:05:32.22,0:05:34.47,Default,,0000,0000,0000,,!د-دعوني أمرّ رجاءً
Dialogue: 0,0:05:34.47,0:05:35.68,Default,,0000,0000,0000,,!أنت! انتظر
Dialogue: 0,0:05:36.63,0:05:37.76,Default,,0000,0000,0000,,!شيميزو
Dialogue: 0,0:05:37.76,0:05:40.09,Default,,0000,0000,0000,,كوساكا! كيف مات إيكوتا؟
Dialogue: 0,0:05:40.09,0:05:41.81,Default,,0000,0000,0000,,المعذرة، من تكون؟
Dialogue: 0,0:05:42.30,0:05:43.62,On Top,,0000,0000,0000,,اسمي شيميزو
Dialogue: 0,0:05:42.30,0:05:46.75,CharCard,,0000,0000,0004,,{\fad(300,0)}(20) شيميزو يويتشي \Nطالب سنة ثانية، جامعة بيكا
Dialogue: 0,0:05:43.62,0:05:46.56,On Top,,0000,0000,0000,,كنتُ أشرب مع إيكوتا قبل قليل \Nفي شقّة صديقنا
Dialogue: 0,0:05:46.87,0:05:48.39,Default,,0000,0000,0000,,أين تلك الشقّة؟
Dialogue: 0,0:05:48.87,0:05:50.06,Default,,0000,0000,0000,,في الطابق الخامس هناك
Dialogue: 0,0:05:53.57,0:05:54.49,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:54.49,0:05:56.69,Default,,0000,0000,0000,,!قُتل إيكوتا؟
Dialogue: 0,0:05:56.69,0:05:58.02,Default,,0000,0000,0000,,لمن هذه الشقّة؟
Dialogue: 0,0:05:58.40,0:05:59.69,On Top,,0000,0000,0000,,لي أنا
Dialogue: 0,0:05:58.53,0:06:03.01,CharCard,,0000,0000,0004,,{\fad(300,0)}(20) تاكينو كوجي\Nطالب سنة ثانية، جامعة بيكا
Dialogue: 0,0:05:59.69,0:06:03.89,On Top,,0000,0000,0000,,أُدعى تاكينو، طالب سنة ثانية\Nفي جامعة بيكا مع إيكوتا
Dialogue: 0,0:06:03.89,0:06:05.56,On Top,,0000,0000,0000,,ومن أنت؟
Dialogue: 0,0:06:05.56,0:06:09.98,On Top,,0000,0000,0000,,ناكامورا، كلّنا أعضاء في نادي\Nتسلّق الجبال في جامعة بيكا
Dialogue: 0,0:06:05.68,0:06:10.21,CharCard,,0000,0000,0004,,{\fad(300,0)}(ناكامورا هيدينوري (21\Nطالب سنة ثانية، جامعة بيكا
Dialogue: 0,0:06:10.85,0:06:14.38,Default,,0000,0000,0000,,كان إيكوتا-سان يشرب معكم هنا؟
Dialogue: 0,0:06:14.38,0:06:18.80,Default,,0000,0000,0000,,أجل، دعوتُ الجميع الليلة، وكنّا هنا منذ السابعة
Dialogue: 0,0:06:18.80,0:06:21.40,Default,,0000,0000,0000,,متى غادر إيكوتا-سان الغرفة تقريباً؟
Dialogue: 0,0:06:22.05,0:06:25.79,Default,,0000,0000,0000,,قبل العاشرة بقليل، فكوساكا قد اتّصل عند التاسعة
Dialogue: 0,0:06:25.79,0:06:29.71,Default,,0000,0000,0000,,!انتظر! لم أتّصل بأحد
Dialogue: 0,0:06:29.71,0:06:31.61,Default,,0000,0000,0000,,لا يمكن ذلك، صحيح يا تاكينو؟
Dialogue: 0,0:06:32.00,0:06:35.81,Default,,0000,0000,0000,,أجل، لم يكن إيكوتا موجوداً\Nفأجبتُ مكانه
Dialogue: 0,0:06:36.36,0:06:38.27,Default,,0000,0000,0000,,أين كان وقتها؟
Dialogue: 0,0:06:38.70,0:06:42.57,Default,,0000,0000,0000,,طلب تاكينو منه الذهاب لشراء\Nأكلات مع الشراب من المتجر
Dialogue: 0,0:06:42.57,0:06:45.35,Default,,0000,0000,0000,,أأنت متأكد أنّ صوت كوساكا-سان\Nكان على الهاتف؟
Dialogue: 0,0:06:45.35,0:06:46.68,Default,,0000,0000,0000,,أجل، لا شكّ في ذلك
Dialogue: 0,0:06:47.44,0:06:48.89,Default,,0000,0000,0000,,!لم أتّصل
Dialogue: 0,0:06:48.89,0:06:51.89,Default,,0000,0000,0000,,كيف رتّبت لمكان لقائكما إذاً؟
Dialogue: 0,0:06:51.89,0:06:55.72,Default,,0000,0000,0000,,استدعاني إيكوتا، وضع ملاحظةً \Nفي خزانتي في الجامعة
Dialogue: 0,0:06:55.72,0:06:57.93,Default,,0000,0000,0000,,ولمَ استدعاك؟
Dialogue: 0,0:06:57.93,0:06:59.14,Default,,0000,0000,0000,,...ذ-ذلك
Dialogue: 0,0:06:59.80,0:07:03.10,Default,,0000,0000,0000,,ألم تقل أنّ إيكوتا أخذ مالك؟
Dialogue: 0,0:07:04.46,0:07:05.81,Default,,0000,0000,0000,,ما الموضوع؟
Dialogue: 0,0:07:06.37,0:07:09.62,Default,,0000,0000,0000,,أخذ إيكوتا مال رسوم الدراسة\N...الذي جلبتُه للجامعة
Dialogue: 0,0:07:09.62,0:07:12.33,Default,,0000,0000,0000,,لا تزال ملاحظة الاستدعاء معك؟
Dialogue: 0,0:07:12.33,0:07:14.22,Default,,0000,0000,0000,,كلا، ألقيتُها
Dialogue: 0,0:07:14.66,0:07:17.94,Default,,0000,0000,0000,,ربما لم تكن موجودةً من البداية
Dialogue: 0,0:07:19.45,0:07:25.44,Default,,0000,0000,0000,,سرق إيكوتا-سان مال رسوم دراستك \Nورفض إعادته مهما ألححت عليه
Dialogue: 0,0:07:25.44,0:07:29.48,Default,,0000,0000,0000,,فاتّصلت به واستدعيته وأنت\Nتستشيط غضباً وضربته حتى الموت
Dialogue: 0,0:07:29.48,0:07:34.26,Default,,0000,0000,0000,,!كـ-كلا! كما لم أكن الوحيد الذي يمقت إيكوتا
Dialogue: 0,0:07:34.26,0:07:36.39,Default,,0000,0000,0000,,!كذلك ناكامورا وتاكينو هناك
Dialogue: 0,0:07:37.91,0:07:38.96,Default,,0000,0000,0000,,لمَ قد أمقته؟
Dialogue: 0,0:07:39.30,0:07:41.92,Default,,0000,0000,0000,,!كنتَ تدين له بالكثير من المال وفقما يبدو
Dialogue: 0,0:07:42.05,0:07:45.10,Default,,0000,0000,0000,,كنتُ هنا طوال الوقت! صحيح يا شيميزو؟
Dialogue: 0,0:07:45.10,0:07:50.31,Default,,0000,0000,0000,,أجل، لكنّك خرجت قليلاً لتستنشق الهواء
Dialogue: 0,0:07:50.67,0:07:52.27,Default,,0000,0000,0000,,ومتى كان ذلك؟
Dialogue: 0,0:07:52.87,0:07:55.22,Default,,0000,0000,0000,,قُرابة العاشرة، عندما غادر إيكوتا
Dialogue: 0,0:07:55.57,0:07:57.95,Default,,0000,0000,0000,,وقت وقوع الجريمة
Dialogue: 0,0:07:57.95,0:07:59.69,Default,,0000,0000,0000,,!لكن كان ذلك لبضعة دقائق فحسب
Dialogue: 0,0:08:00.12,0:08:03.44,Default,,0000,0000,0000,,ولمَ مقتّ إيكوتا-سان يا تاكينو-سان؟
Dialogue: 0,0:08:04.65,0:08:10.02,Default,,0000,0000,0000,,قبل 6 أشهر، تاه إيكوتا وتوغاوا كيكو التي كانت\Nفي النادي معنا في الجبال
Dialogue: 0,0:08:10.98,0:08:16.11,Default,,0000,0000,0000,,ترك إيكوتا كيكو المصابة ونجا بحياته
Dialogue: 0,0:08:16.93,0:08:20.02,Default,,0000,0000,0000,,كانت كيكو مُتجمدةً للموت عندما وجدناها
Dialogue: 0,0:08:20.76,0:08:23.42,Default,,0000,0000,0000,,كانت على علاقة عاطفية مع تاكينو
Dialogue: 0,0:08:24.84,0:08:26.51,Default,,0000,0000,0000,,أهذا صحيح؟
Dialogue: 0,0:08:28.04,0:08:29.21,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:08:29.21,0:08:33.76,Default,,0000,0000,0000,,في حوادث الجبال، عليك مسح الدموع\Nوترك أصدقائك للنجاة بنفسك أحياناً
Dialogue: 0,0:08:34.45,0:08:38.78,Default,,0000,0000,0000,,أتحسّر على كيكو، لكنّي لا ألوم إيكوتا على ما حصل
Dialogue: 0,0:08:38.78,0:08:42.68,Default,,0000,0000,0000,,كما أنّي لم أخرج من هذه الشقّة البتّة
Dialogue: 0,0:08:43.40,0:08:46.02,Default,,0000,0000,0000,,صحيح، كان هنا طوال الوقت
Dialogue: 0,0:08:46.02,0:08:51.15,Default,,0000,0000,0000,,عند العاشرة، ذهب للغرفة المجاورة بمفرده\Nلإنهاء تقرير جامعيّ
Dialogue: 0,0:08:52.52,0:08:55.76,Default,,0000,0000,0000,,كم أمضى بمفرده؟
Dialogue: 0,0:08:55.76,0:08:57.85,Default,,0000,0000,0000,,من عشرين إلى ثلاثين دقيقة
Dialogue: 0,0:08:57.85,0:09:00.85,Default,,0000,0000,0000,,لكن لا يمكنك الخروج دون المرور بهذه الغرفة
Dialogue: 0,0:09:00.85,0:09:03.84,Default,,0000,0000,0000,,فلا أستطيع تخيّل كيف له أن يخرج
Dialogue: 0,0:09:03.84,0:09:06.05,Default,,0000,0000,0000,,لكن يمكن لمتسلّق جبال النزول بسهولة
Dialogue: 0,0:09:06.05,0:09:08.56,Default,,0000,0000,0000,,عبر حبل من النافذة وما شابه
Dialogue: 0,0:09:09.21,0:09:11.56,Default,,0000,0000,0000,,ليس من تلك النافذة، تفقّد بنفسك
Dialogue: 0,0:09:21.79,0:09:23.22,Default,,0000,0000,0000,,...رأيت؟ هذه النافذة
Dialogue: 0,0:09:26.86,0:09:29.19,Default,,0000,0000,0000,,هذا أقصى حد؟
Dialogue: 0,0:09:30.36,0:09:32.93,Default,,0000,0000,0000,,يستحيل أن يخرج أحد من هنا
Dialogue: 0,0:09:33.52,0:09:38.35,Default,,0000,0000,0000,,أخبرني، لمَ تركت الأنوار مُطفأة\Nإذا كنت ستكتب تقريراً؟
Dialogue: 0,0:09:38.35,0:09:40.52,Default,,0000,0000,0000,,رأيتُ في طريق عودتي من المتجر
Dialogue: 0,0:09:41.14,0:09:44.35,Default,,0000,0000,0000,,لم تكن مصابيح هذه الغرفة مضاءة وقتها
Dialogue: 0,0:09:44.80,0:09:46.80,Default,,0000,0000,0000,,...ذ-ذلك
Dialogue: 0,0:09:46.80,0:09:49.46,Default,,0000,0000,0000,,!من يهتمّ؟
Dialogue: 0,0:09:49.46,0:09:53.95,Default,,0000,0000,0000,,،بما أنّ الخروج من هذه النافذة مستحيل\Nتاكينو-سان بريء
Dialogue: 0,0:10:01.17,0:10:02.49,Default,,0000,0000,0000,,نقَّافة؟
Dialogue: 0,0:10:03.95,0:10:06.62,Default,,0000,0000,0000,,الهاتف الوحيد في هذه الغرفة؟
Dialogue: 0,0:10:10.41,0:10:12.11,Default,,0000,0000,0000,,...خيط أحمر
Dialogue: 0,0:10:16.28,0:10:18.61,Default,,0000,0000,0000,,هذه نفس السجائر التي كانت في مسرح الجريمة
Dialogue: 0,0:10:18.61,0:10:22.53,Default,,0000,0000,0000,,أي أنّ إيكوتا-سان كان مدّخناً شرهاً
Dialogue: 0,0:10:23.14,0:10:23.94,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:10:26.22,0:10:27.40,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:10:30.89,0:10:34.05,Default,,0000,0000,0000,,شقّة أومورا-سان أسفل شقّة تاكينو-سان تماماً
Dialogue: 0,0:10:34.05,0:10:37.42,Default,,0000,0000,0000,,صحيح... لمَ تحطّمت النافذة وقتها؟
Dialogue: 0,0:10:40.87,0:10:42.69,On Top,,0000,0000,15,,شقّة أومورا
Dialogue: 0,0:10:42.69,0:10:46.40,Default,,0000,0000,0000,,غريب، ما حطّم النافذة ليس موجوداً هنا
Dialogue: 0,0:10:48.16,0:10:49.45,Default,,0000,0000,0000,,!دم
Dialogue: 0,0:10:50.54,0:10:54.02,Default,,0000,0000,0000,,أهو للضحيّة؟ لكن لمَ يوجد على هذه الشظية؟
Dialogue: 0,0:10:54.36,0:10:56.11,Default,,0000,0000,0000,,أليست هذه بقعة دم؟
Dialogue: 0,0:10:56.11,0:10:57.32,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:58.78,0:11:00.44,Default,,0000,0000,0000,,!لا شكّ في الأمر
Dialogue: 0,0:11:00.44,0:11:02.93,Default,,0000,0000,0000,,!حسناً، سأُعلم المفتّش ميغوري
Dialogue: 0,0:11:08.27,0:11:10.27,Default,,0000,0000,0000,,لمَ توجد بقعة دم هنا؟
Dialogue: 0,0:11:11.60,0:11:14.69,Default,,0000,0000,0000,,كان إيكوتا-سان يقف هنا في الظلام
Dialogue: 0,0:11:18.51,0:11:19.86,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:11:20.51,0:11:24.15,Default,,0000,0000,0000,,،بقعة الدم على الحائط، مكان وقوف إيكوتا-سان
Dialogue: 0,0:11:24.54,0:11:28.07,Default,,0000,0000,0000,,!ونافذة أومورا-سان المحطّمة كلّهم بنفس الخطّ
Dialogue: 0,0:11:28.07,0:11:29.91,Default,,0000,0000,0000,,...ما يعني
Dialogue: 0,0:11:29.91,0:11:31.74,Default,,0000,0000,0000,,...يوجد على سطح هذا المبنى
Dialogue: 0,0:11:39.65,0:11:41.33,Default,,0000,0000,0000,,!ها هي! بقعة دم
Dialogue: 0,0:11:41.70,0:11:44.65,Default,,0000,0000,0000,,وتلك شقّة تاكينو-سان
Dialogue: 0,0:11:45.12,0:11:49.65,Default,,0000,0000,0000,,!عرفتُ هويّة القاتل الآن وكيف ارتكب جريمته
Dialogue: 0,0:11:54.80,0:11:57.34,Default,,0000,0000,0000,,كونان-كن! أين ذهبت؟
Dialogue: 0,0:11:57.34,0:11:58.72,Default,,0000,0000,0000,,خرجتُ قليلاً فحسب
Dialogue: 0,0:12:08.75,0:12:09.95,Default,,0000,0000,0000,,...أشعر بدوار
Dialogue: 0,0:12:13.61,0:12:17.07,Default,,0000,0000,0000,,أيمكنكم مرافقتي للمركز حالياً؟
Dialogue: 0,0:12:17.07,0:12:19.32,Default,,0000,0000,0000,,انتظر حضرة المفتّش ميغوري
Dialogue: 0,0:12:20.32,0:12:24.48,Default,,0000,0000,0000,,سأكشف الآن حقيقة هذه القضيّة
Dialogue: 0,0:12:25.40,0:12:26.52,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:26.52,0:12:30.02,Default,,0000,0000,0000,,مفتاح هذه القضيّة هو مكان سلاح الجريمة
Dialogue: 0,0:12:30.02,0:12:33.44,Default,,0000,0000,0000,,صحيح، لم نجده في مسرح الجريمة
Dialogue: 0,0:12:33.44,0:12:38.90,Default,,0000,0000,0000,,كانت هناك بقعة دم على المبنى المجاور المهجور
Dialogue: 0,0:12:39.59,0:12:43.36,Default,,0000,0000,0000,,لكن يوجد مكان آخر ببقعة دم
Dialogue: 0,0:12:43.36,0:12:45.19,Default,,0000,0000,0000,,ماذا؟! أين؟
Dialogue: 0,0:12:45.63,0:12:49.92,Default,,0000,0000,0000,,كنتُ في شقّة أومورا وقت وقوع الجريمة
Dialogue: 0,0:12:49.92,0:12:52.25,Default,,0000,0000,0000,,وحدث أمرٌ غريب
Dialogue: 0,0:12:52.25,0:12:53.78,Default,,0000,0000,0000,,أمر غريب؟
Dialogue: 0,0:12:53.78,0:12:58.40,Default,,0000,0000,0000,,بعد وقوع الجريمة بلحظات، تحطّمت نافذة أومورا
Dialogue: 0,0:12:58.57,0:13:01.32,Default,,0000,0000,0000,,ما علاقة ذلك؟
Dialogue: 0,0:13:01.74,0:13:05.82,Default,,0000,0000,0000,,كان هناك دم على شظيّة من الزجاج المكسور
Dialogue: 0,0:13:06.19,0:13:07.28,Default,,0000,0000,0000,,ما معنى ذلك؟
Dialogue: 0,0:13:07.69,0:13:11.82,Default,,0000,0000,0000,,قبل أن أشرح، أريدكم أن تتفقدوا شيئاً
Dialogue: 0,0:13:12.36,0:13:14.55,Default,,0000,0000,0000,,سطح المبنى المهجور
Dialogue: 0,0:13:14.55,0:13:17.60,Default,,0000,0000,0000,,...إن أصبت، ستجدون بقعة دم
Dialogue: 0,0:13:17.60,0:13:20.24,Default,,0000,0000,0000,,على السور فوق بقعة الدم على الحائط مباشرةً
Dialogue: 0,0:13:20.60,0:13:21.89,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:21.89,0:13:24.09,Default,,0000,0000,0000,,محقق تاكاغي، تأكّد فوراً
Dialogue: 0,0:13:24.09,0:13:24.50,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:13:24.50,0:13:27.92,Default,,0000,0000,0000,,أعطه جهاز إرسال لاسلكيّ
Dialogue: 0,0:13:27.92,0:13:28.94,Default,,0000,0000,0000,,جهاز إرسال لاسلكيّ؟
Dialogue: 0,0:13:29.59,0:13:32.90,Default,,0000,0000,0000,,أريده أن يساهم بشيء لاحقاً
Dialogue: 0,0:13:37.41,0:13:38.37,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:13:39.33,0:13:42.69,Default,,0000,0000,0000,,حضرة المفتّش! وجدتها! هناك بقعة دم على السور
Dialogue: 0,0:13:43.23,0:13:45.07,Default,,0000,0000,0000,,!ماذا؟! دم على السور؟
Dialogue: 0,0:13:45.07,0:13:47.40,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:13:47.40,0:13:48.74,Default,,0000,0000,0000,,ما معنى هذا؟
Dialogue: 0,0:13:49.52,0:13:55.69,Default,,0000,0000,0000,,،حائط المبنى المهجور، السور على السطح\Nوشظيّة الزجاج في شقّة أومورا-سان
Dialogue: 0,0:13:56.22,0:13:59.24,Default,,0000,0000,0000,,لمَ يوجد دم في هذه المواقع الثلاثة؟
Dialogue: 0,0:13:59.24,0:14:04.38,Default,,0000,0000,0000,,مرّ السلاح الذي قتل إيكوتا-سان\Nبهذه المناطق الثلاث
Dialogue: 0,0:14:04.38,0:14:08.75,Default,,0000,0000,0000,,ما يعني أنّ القاتل ارتكب جريمته \Nدون الاقتراب من مسرحها
Dialogue: 0,0:14:08.75,0:14:12.44,Default,,0000,0000,0000,,...أجل، كان القاتل في هذه الغرفة
Dialogue: 0,0:14:12.44,0:14:15.02,Default,,0000,0000,0000,,!أنت يا تاكينو-سان
Dialogue: 0,0:14:15.02,0:14:15.86,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:16.99,0:14:18.07,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:14:18.41,0:14:20.87,Default,,0000,0000,0000,,ما الذي تقوله يا موري-سان؟
Dialogue: 0,0:14:20.87,0:14:23.48,Default,,0000,0000,0000,,!يستحيل أن أقتل إيكوتا من هنا
Dialogue: 0,0:14:23.94,0:14:26.48,Default,,0000,0000,0000,,أيحمل أحد خيط صيد؟
Dialogue: 0,0:14:26.82,0:14:28.15,Default,,0000,0000,0000,,خيط صيد؟
Dialogue: 0,0:14:28.15,0:14:30.03,Default,,0000,0000,0000,,لديّ واحد
Dialogue: 0,0:14:30.03,0:14:32.64,Default,,0000,0000,0000,,أستعمله لتعليق نماذجي البلاستيكية
Dialogue: 0,0:14:32.64,0:14:33.69,Default,,0000,0000,0000,,اجلبه لي
Dialogue: 0,0:14:33.69,0:14:35.35,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:14:36.43,0:14:42.40,Default,,0000,0000,0000,,ران، ضعي صخوراً في الكيس البلاستيكي\Nالذي كانت به الجعّة التي اشتريتِها
Dialogue: 0,0:14:42.80,0:14:43.61,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:14:45.92,0:14:47.28,Default,,0000,0000,0000,,ها هو يا موري
Dialogue: 0,0:14:47.28,0:14:49.24,Default,,0000,0000,0000,,ما ستفعل بهذه؟
Dialogue: 0,0:14:49.67,0:14:50.88,Default,,0000,0000,0000,,إذاً حضرة المفتّش
Dialogue: 0,0:14:50.88,0:14:55.19,Default,,0000,0000,0000,,اربط خيطي صيد بصخرة
Dialogue: 0,0:14:55.45,0:14:57.33,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:14:57.33,0:14:59.29,Default,,0000,0000,0000,,هاك حضرة المفتّش
Dialogue: 0,0:15:01.04,0:15:05.69,Default,,0000,0000,0000,,بعدما تنتهي، استعمل نقّافة تاكينو-سان
Dialogue: 0,0:15:05.69,0:15:09.07,Default,,0000,0000,0000,,في هذه الغرفة لقذف الصخرة\Nنحو سطح المبنى الآخر
Dialogue: 0,0:15:10.69,0:15:14.27,Default,,0000,0000,0000,,المسافة عدّة مترات فحسب، بطول سيّارتي أجرة تقريباً
Dialogue: 0,0:15:15.06,0:15:17.57,Default,,0000,0000,0000,,يمكن لأيّ أحد قذفها
Dialogue: 0,0:15:20.68,0:15:21.99,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:15:21.99,0:15:24.26,Default,,0000,0000,0000,,اطلب من المحقّق تاكاغي فكّ الخيطين
Dialogue: 0,0:15:24.26,0:15:29.76,Default,,0000,0000,0000,,وتمريرهما حول السور، ثم ربطهما مُجدداً
Dialogue: 0,0:15:31.72,0:15:33.77,Default,,0000,0000,0000,,تالياً، الحبل على ذاك الرفّ
Dialogue: 0,0:15:34.37,0:15:36.48,Default,,0000,0000,0000,,حبل؟ ذاك؟
Dialogue: 0,0:15:37.94,0:15:42.56,Default,,0000,0000,0000,,اربط خيطاً بطرفه
Dialogue: 0,0:15:43.45,0:15:44.48,Default,,0000,0000,0000,,هكذا؟
Dialogue: 0,0:15:44.99,0:15:49.53,Default,,0000,0000,0000,,اسحب خيط الصيد الآخر الآن
Dialogue: 0,0:16:00.94,0:16:03.77,Default,,0000,0000,0000,,موري-كن، ماذا أفعل بهذا الحبل؟
Dialogue: 0,0:16:04.18,0:16:08.74,Default,,0000,0000,0000,,ران، اربطي الكيس بطرف الحبل الآخر
Dialogue: 0,0:16:08.74,0:16:09.82,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:16:13.61,0:16:16.57,Default,,0000,0000,0000,,اربطيه بشدّة بحيث لا يسقط شيء من المحتوى
Dialogue: 0,0:16:17.75,0:16:19.03,Default,,0000,0000,0000,,انتهيت يا أبي
Dialogue: 0,0:16:19.03,0:16:21.97,Default,,0000,0000,0000,,...موري-كن! أيمكن أنّ هذا
Dialogue: 0,0:16:23.03,0:16:25.19,Default,,0000,0000,0000,,...يبدو أنّك عرفت حضرة المفتّش
Dialogue: 0,0:16:30.24,0:16:32.23,Default,,0000,0000,0000,,حضرة المفتّش، وصلتُ للمكان
Dialogue: 0,0:16:32.23,0:16:33.02,Default,,0000,0000,0000,,!حسناً! سنبدأ
Dialogue: 0,0:16:34.14,0:16:35.73,Default,,0000,0000,0000,,نبدأ ماذا؟
Dialogue: 0,0:16:41.73,0:16:43.56,Default,,0000,0000,0000,,إذاً يا محقّق تاكاغي؟
Dialogue: 0,0:16:43.93,0:16:48.28,Default,,0000,0000,0000,,مرّ الكيس فوق مكان وقوع الجثّة\N!وحدود الطباشير وارتطم بالحائط
Dialogue: 0,0:16:48.28,0:16:50.24,Default,,0000,0000,0000,,!إنّه بجوار بقعة الدم
Dialogue: 0,0:16:50.24,0:16:54.21,Default,,0000,0000,0000,,هكذا قتل تاكينو-سان إيكوتا-سان
Dialogue: 0,0:16:54.21,0:16:57.69,Default,,0000,0000,0000,,ثمّ سحب الحبل لاسترجاع السلاح فوراً
Dialogue: 0,0:16:58.54,0:17:01.11,Default,,0000,0000,0000,,هكذا لن يبقى سلاح في مسرح الجريمة
Dialogue: 0,0:17:06.20,0:17:11.32,Default,,0000,0000,0000,,حضرة المفتّش! ارتطم الكيس بالحائط\N!أسفل نافذة أومورا-سان المحطّمة تماماً
Dialogue: 0,0:17:11.66,0:17:16.28,Default,,0000,0000,0000,,موري، أيمكن أنّ صوت الارتطام الذي\N...كنتُ أسمعه كلّ ليلة
Dialogue: 0,0:17:16.73,0:17:20.31,Default,,0000,0000,0000,,أجل، كان تاكينو-سان يتدرّب
Dialogue: 0,0:17:20.31,0:17:23.35,Default,,0000,0000,0000,,لكن وقع أمرٌ خارج الحسبان الليلة
Dialogue: 0,0:17:23.35,0:17:25.48,Default,,0000,0000,0000,,أصاب السلاح النافذة
Dialogue: 0,0:17:26.01,0:17:28.15,Default,,0000,0000,0000,,...ذاك ما حطّمها إذاً
Dialogue: 0,0:17:28.85,0:17:29.61,Default,,0000,0000,0000,,تاكينو
Dialogue: 0,0:17:30.85,0:17:32.17,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:17:32.17,0:17:36.57,Default,,0000,0000,0000,,ذهب إيكوتا للشارع بذاك المكان\N!لأنّ كوساكا طلب منه على الهاتف
Dialogue: 0,0:17:37.42,0:17:41.71,Default,,0000,0000,0000,,!لو لم يتّصل، لما استطعتُ تنفيذ تلك الحيلة
Dialogue: 0,0:17:41.71,0:17:46.28,Default,,0000,0000,0000,,لم يتّصل كوساكا-سان بأحد، كانت مسرحيةً أنت بطلها وحدك
Dialogue: 0,0:17:46.83,0:17:50.24,Default,,0000,0000,0000,,!لكننا سمعنا رنين الهاتف
Dialogue: 0,0:17:50.83,0:17:53.65,Default,,0000,0000,0000,,يمكنه جعله يرنّ في أيّ وقت
Dialogue: 0,0:17:53.65,0:17:58.05,Default,,0000,0000,0000,,عبر تسجيل الصوت وضبط مؤقت ببساطة
Dialogue: 0,0:17:58.65,0:18:00.24,Default,,0000,0000,0000,,ما تبقّى هو رفع السمّاعة
Dialogue: 0,0:18:00.24,0:18:04.65,Default,,0000,0000,0000,,والتظاهر بأنّه يكلّم كوساكا-سان فقط
Dialogue: 0,0:18:04.93,0:18:10.01,Default,,0000,0000,0000,,كان تاكينو-سان من وضع الملاحظة\Nفي خزانة كوساكا-سان أيضاً بالطبع
Dialogue: 0,0:18:10.01,0:18:13.06,Default,,0000,0000,0000,,!لإلفاق تهمة قتل إيكوتا-سان به
Dialogue: 0,0:18:13.81,0:18:17.99,Default,,0000,0000,0000,,لكن كيف عرف مكان وقوف\Nإيكوتا-سان يا موري-سان؟
Dialogue: 0,0:18:18.71,0:18:22.79,Default,,0000,0000,0000,,فالظلام كان حالكاً بسبب تحطّم مصباح الإنارة
Dialogue: 0,0:18:22.79,0:18:27.03,Default,,0000,0000,0000,,حطّمه تاكينو-سان مسبقاً\Nلجعلنا نفكّر باستحالة ذلك
Dialogue: 0,0:18:27.37,0:18:30.49,Default,,0000,0000,0000,,ألن يصعب عليه تحديد مكانه هكذا؟
Dialogue: 0,0:18:31.08,0:18:35.90,Default,,0000,0000,0000,,كلا، كان يعرف أين إيكوتا-سان\Nحتى في الظلام
Dialogue: 0,0:18:36.40,0:18:39.28,Default,,0000,0000,0000,,سخافة، لستُ خفّاشاً
Dialogue: 0,0:18:39.28,0:18:40.36,Default,,0000,0000,0000,,ران
Dialogue: 0,0:18:40.36,0:18:44.10,Default,,0000,0000,0000,,ماذا كان يفعل إيكوتا-سان\Nفي طريق عودتك من المتجر؟
Dialogue: 0,0:18:44.10,0:18:47.77,Default,,0000,0000,0000,,ماذا كان يفعل؟ كان يقف أسفل مصباح الإنارة المحطّم
Dialogue: 0,0:18:47.77,0:18:50.39,Default,,0000,0000,0000,,صحيح... كان يدخّن
Dialogue: 0,0:18:50.39,0:18:55.21,Default,,0000,0000,0000,,أسقط إيكوتا-سان الكثير من أعقاب السجائر\Nلكونه مدّخناً شرهاً
Dialogue: 0,0:18:55.21,0:19:00.21,Default,,0000,0000,0000,,استهدفت نور السيجارة في الظلام يا تاكينو-سان
Dialogue: 0,0:19:00.21,0:19:02.25,Default,,0000,0000,0000,,وأصبته بالسلاح
Dialogue: 0,0:19:03.79,0:19:09.15,Default,,0000,0000,0000,,أطفأت أنوار غرفتك كيلا يرى أيّ عابرٍ السلاح
Dialogue: 0,0:19:09.45,0:19:16.53,Default,,0000,0000,0000,,أي أنّ الكيس البلاستيكي المليء بالصخور \N!الذي سحبته لا يزال في هذه الشقّة
Dialogue: 0,0:19:16.53,0:19:20.78,Default,,0000,0000,0000,,!تفقّدوا الشقّة إذاً! لا كيس بلاستيكي لديّ
Dialogue: 0,0:19:21.07,0:19:22.52,Default,,0000,0000,0000,,تاكينو-سان
Dialogue: 0,0:19:22.52,0:19:26.19,Default,,0000,0000,0000,,ترتدي جوارب كثيفة بالنسبة لهذا الوقت من العام
Dialogue: 0,0:19:27.85,0:19:30.24,Default,,0000,0000,0000,,هذه جوارب تسلّق جبال
Dialogue: 0,0:19:30.73,0:19:35.72,Default,,0000,0000,0000,,قلبتَها وملأتها بالصخور لتجعلها سلاحاً
Dialogue: 0,0:19:35.72,0:19:40.24,Default,,0000,0000,0000,,بعد الجريمة، ألقيت الصخور في حوض السمك\Nوأعدت جواربك لوضعها
Dialogue: 0,0:19:40.24,0:19:45.21,Default,,0000,0000,0000,,!والدليل على ذلك هو الخيط العالق بالنبتة المائية
Dialogue: 0,0:19:45.21,0:19:48.65,Default,,0000,0000,0000,,بنفس لون جواربك الحمراء
Dialogue: 0,0:19:50.58,0:19:54.86,Default,,0000,0000,0000,,هذه متماسكة بما يكفي بحيث\Nتستعملها سلاحاً ولا تتمزق
Dialogue: 0,0:19:55.70,0:19:59.90,Default,,0000,0000,0000,,يُفترض أن يوجد دم داخل هذه الجوارب
Dialogue: 0,0:19:59.90,0:20:01.70,Default,,0000,0000,0000,,!دم إيكوتا-سان
Dialogue: 0,0:20:02.14,0:20:06.40,Default,,0000,0000,0000,,هل يمكنني النظر يا تاكينو-سان؟
Dialogue: 0,0:20:07.27,0:20:09.11,Default,,0000,0000,0000,,لا داعي
Dialogue: 0,0:20:09.11,0:20:10.11,Default,,0000,0000,0000,,!تاكينو
Dialogue: 0,0:20:10.56,0:20:14.02,Default,,0000,0000,0000,,أكان دافعك موت توغاوا كيكو-سان؟
Dialogue: 0,0:20:14.59,0:20:15.80,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:15.80,0:20:21.98,Default,,0000,0000,0000,,كما قلتُ قبلاً، في حوادث الجبال عليك مسح الدموع\Nوترك أصدقائك للنجاة بنفسك أحياناً
Dialogue: 0,0:20:22.50,0:20:27.46,Default,,0000,0000,0000,,أقنعتُ نفسي باستمرار أنّي لا يجوز أن ألوم إيكوتا
Dialogue: 0,0:20:27.46,0:20:30.54,Default,,0000,0000,0000,,لكن عندما أفكّر بعدم رؤيتي لها مُجدداً
Dialogue: 0,0:20:30.54,0:20:33.78,Default,,0000,0000,0000,,أشعر كما لو أنّي تُركت وحيداً في العالم
Dialogue: 0,0:20:33.78,0:20:37.49,Default,,0000,0000,0000,,غلبتني الوحدة حتّى كدت أفقد صوابي
Dialogue: 0,0:20:37.49,0:20:41.20,Default,,0000,0000,0000,,...عندها، عندما دخلت حانةً في أحد الأيام
Dialogue: 0,0:20:42.40,0:20:44.27,Default,,0000,0000,0000,,نعم، صحيح
Dialogue: 0,0:20:45.18,0:20:50.35,Default,,0000,0000,0000,,!هجرتني كيكو، لذا تركتها لتلقى حتفها
Dialogue: 0,0:20:51.43,0:20:53.19,Default,,0000,0000,0000,,!يا لفظاعتك
Dialogue: 0,0:21:01.48,0:21:07.51,Default,,0000,0000,0000,,لم أستطع مسامحته! ترك عزيزتي كيكو تموت\N!بسبب سخيف كهذا
Dialogue: 0,0:21:08.56,0:21:11.11,Default,,0000,0000,0000,,!وكذلك كوساكا الذي ضحك على قصّته
Dialogue: 0,0:21:15.49,0:21:19.65,Default,,0000,0000,0000,,...الباقي كما قلتَ يا موري-سان
Dialogue: 0,0:22:55.57,0:22:58.63,Default,,0000,0000,0000,,!ما أروع الجعّة بعد حلّ جريمة
Dialogue: 0,0:22:58.92,0:22:59.82,Default,,0000,0000,0000,,!أفضل شيء على الإطلاق
Dialogue: 0,0:23:01.07,0:23:05.67,Default,,0000,0000,0000,,...تأخّر الوقت يا موري، ما رأيك أن نتوقف
Dialogue: 0,0:23:05.67,0:23:10.06,Default,,0000,0000,0000,,!لا تقل ذلك! لنحتفل حتّى الصباح
Dialogue: 0,0:23:10.06,0:23:11.87,Default,,0000,0000,0000,,لكن ألا تشعر بالإرهاق؟
Dialogue: 0,0:23:12.63,0:23:16.04,Default,,0000,0000,0000,,!أشعر بارتياح كما لو أنّي أخذت غفوة
Dialogue: 0,0:23:16.76,0:23:21.00,Default,,0000,0000,0000,,بالطبع، ذلك لأنّك غفوت فعلاً
Dialogue: 0,0:23:27.17,0:23:29.29,Default,,0000,0000,0000,,ما الخطب يا ران-نيتشان؟
Dialogue: 0,0:23:29.29,0:23:35.49,Default,,0000,0000,0000,,كان اليوم التاناباتا، اليوم الوحيد في العام\Nالذي يلتقي فيه الأحباب
Dialogue: 0,0:23:35.49,0:23:38.08,Default,,0000,0000,0000,,ما الذي يفعله شينتشي يا ترى؟
Dialogue: 0,0:23:39.16,0:23:40.00,Default,,0000,0000,0000,,...ران
Dialogue: 0,0:23:42.48,0:23:46.90,Default,,0000,0000,0000,,!لا بدّ أنّه ينظر لنفس السماء المرصّعة بالنجوم
Dialogue: 0,0:23:46.90,0:23:47.71,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:24:01.33,0:24:03.94,Default,,0000,0000,0000,,أأنت شيوتا هيهاتشيرو-سان يا جدّ؟
Dialogue: 0,0:24:04.36,0:24:06.40,Default,,0000,0000,0000,,شيوتا هيهاتشيرو؟
Dialogue: 0,0:24:06.99,0:24:09.99,Default,,0000,0000,0000,,!هذا العجوز هو ذاك المتحرّي الأسطوري؟
Dialogue: 0,0:24:16.85,0:24:18.44,Default,,0000,0000,0000,,!كانت هذه جريمة قتل
Dialogue: 0,0:24:19.19,0:24:21.16,Default,,0000,0000,0000,,!ابقوا أماكنكم جميعاً
Dialogue: 0,0:24:21.72,0:24:24.06,Default,,0000,0000,0000,,!تبّاً! أمام ناظريّ
Dialogue: 0,0:24:24.12,0:24:30.12,On Top,,0000,0000,0000,,جريمة قتل ممثلة المسرح
Dialogue: 0,0:24:24.63,0:24:26.30,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.30,0:24:28.68,Default,,0000,0000,0000,,جريمة قتل ممثلة المسرح
Dialogue: 0,0:24:45.32,0:24:47.70,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.70,0:24:49.64,Default,,0000,0000,0000,,شريط فينيل
Dialogue: 0,0:24:50.44,0:24:52.52,Default,,0000,0000,0000,,يظهر في الحلقة القادمة\N!متحرّ عجوز غريب الأطوار
Dialogue: 0,0:24:52.52,0:24:54.52,Default,,0000,0000,0000,,!يبدو أنّه معلّم كوغورو

