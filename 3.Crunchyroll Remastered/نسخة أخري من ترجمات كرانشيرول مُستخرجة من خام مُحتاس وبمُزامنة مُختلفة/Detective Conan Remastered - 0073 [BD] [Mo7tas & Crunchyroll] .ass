Dialogue: 0,0:00:00.72,0:00:02.68,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:02.68,0:00:06.56,Default,,0000,0000,0000,,تُعالج استنتاجات كونان القلوب\Nالمُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:06.92,0:00:10.49,Default,,0000,0000,0000,,!فرقة فتيان التحرّي في ورطة اليوم\N!الحكمة والشجاعة وعمل الفريق
Dialogue: 0,0:00:10.49,0:00:12.30,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.30,0:00:14.33,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.33,0:00:16.50,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.35,0:01:57.17,Title,,0000,0000,0000,,{\fad(300,0)}قضيّة كارثة فرقة فتيان التحرّي
Dialogue: 0,0:01:51.91,0:01:55.48,Default,,0000,0000,0000,,قضيّة كارثة فرقة فتيان التحرّي
Dialogue: 0,0:02:48.55,0:02:52.60,Default,,0000,0000,0000,,آسف! أأنتم بخير؟ كنت شارد الذهن\N!ولم أنتبه لكم
Dialogue: 0,0:02:55.79,0:02:57.54,Default,,0000,0000,0000,,!مرحى! هذا رائع
Dialogue: 0,0:02:57.54,0:02:59.67,Default,,0000,0000,0000,,!إنّها أفضل عطلة صيفية
Dialogue: 0,0:02:59.67,0:03:02.51,Default,,0000,0000,0000,,من الجيّد أنّنا أتينا للمحيط متحضّرين
Dialogue: 0,0:03:02.95,0:03:05.49,Default,,0000,0000,0000,,كاسودا-سان؟ من شركة صناعات كاسودا؟
Dialogue: 0,0:03:05.49,0:03:11.10,Default,,0000,0000,0000,,أجل، أنا فتى ثريّ! شاب طائش لا يزال\Nلا يلقي لأبيه اهتماماً
Dialogue: 0,0:03:13.48,0:03:17.98,Default,,0000,0000,0000,,لكن ألم نسبب لك ضيقاً؟\Nفقد أخذتنا جميعاً في عودتك
Dialogue: 0,0:03:18.19,0:03:21.39,Default,,0000,0000,0000,,كلما زاد العدد زادت المتعة! صحيح يا شينوبو؟
Dialogue: 0,0:03:22.39,0:03:23.21,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:03:24.09,0:03:28.77,Default,,0000,0000,0000,,أغبطكما حقّاً، تغوصان بأجهزة تنفّس معاً كحبيبين
Dialogue: 0,0:03:29.09,0:03:30.54,Default,,0000,0000,0000,,حبيبين؟
Dialogue: 0,0:03:30.54,0:03:37.13,Default,,0000,0000,0000,,،حسناً، لو لم أكن فتىً ثريّاً\Nلما صاحبتني شينوبو غالباً
Dialogue: 0,0:03:37.13,0:03:39.92,Default,,0000,0000,0000,,...تيروهيكو-سان! لستُ كذلك
Dialogue: 0,0:03:39.92,0:03:41.68,Default,,0000,0000,0000,,لا بأس من الصراحة يا شينوبو
Dialogue: 0,0:03:44.32,0:03:47.98,Default,,0000,0000,0000,,ما خطبه؟ يتشاجر مع حبيبته فجأةً
Dialogue: 0,0:03:53.93,0:03:58.06,Default,,0000,0000,0000,,ران-نيتشان، أين يصيد العمّ؟
Dialogue: 0,0:03:58.06,0:04:03.14,Default,,0000,0000,0000,,قال أنّه يوجد موقع صيد ممتاز في هذه المنطقة\Nوغادر قبل طلوع الشمس
Dialogue: 0,0:04:03.76,0:04:07.40,Default,,0000,0000,0000,,أعتقد أنّه ليس في المحيط، قال أنها بحيرة
Dialogue: 0,0:04:08.85,0:04:10.51,Default,,0000,0000,0000,,موقع صيد ليس في المحيط؟
Dialogue: 0,0:04:12.47,0:04:17.18,Default,,0000,0000,0000,,!ها هي! أمسكت بواحدة أخرى\N!يا للصيد الوفير
Dialogue: 0,0:04:20.24,0:04:20.84,Default,,0000,0000,0000,,!هيّا
Dialogue: 0,0:04:22.08,0:04:25.81,On Top,,0000,0000,0000,,ممنوع الدخول
Dialogue: 0,0:04:26.74,0:04:28.77,Default,,0000,0000,0000,,غادرت شينوبو-سان؟
Dialogue: 0,0:04:29.03,0:04:32.72,Default,,0000,0000,0000,,كانت في مزاج سيّئ، هذا شائع الحدوث فلا تقلقي
Dialogue: 0,0:04:33.15,0:04:37.57,Default,,0000,0000,0000,,ألم تكن أنت السبب؟ ما أغربك
Dialogue: 0,0:04:37.57,0:04:39.27,Default,,0000,0000,0000,,!صيد وفير
Dialogue: 0,0:04:41.39,0:04:43.23,Default,,0000,0000,0000,,!مذهل
Dialogue: 0,0:04:43.23,0:04:45.81,Default,,0000,0000,0000,,مُبهر يا أبي
Dialogue: 0,0:04:46.47,0:04:49.14,Default,,0000,0000,0000,,أين كان موقع الصيد ذاك؟
Dialogue: 0,0:04:49.14,0:04:51.05,Default,,0000,0000,0000,,!أريد الصيد أيضاً
Dialogue: 0,0:04:51.05,0:04:53.02,Default,,0000,0000,0000,,لا، لا يمكنني إخباركم
Dialogue: 0,0:04:53.02,0:04:54.06,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:04:54.06,0:04:59.31,Default,,0000,0000,0000,,إنّه مكان سرّي أخبرني عنه\N!زملائي في الصيد
Dialogue: 0,0:05:02.99,0:05:04.80,Default,,0000,0000,0000,,هذا ليس مسليّاً
Dialogue: 0,0:05:05.83,0:05:07.72,Default,,0000,0000,0000,,!لنلعب كرة طائرة الشاطئ
Dialogue: 0,0:05:07.72,0:05:08.85,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:05:08.85,0:05:09.85,Default,,0000,0000,0000,,!هناك
Dialogue: 0,0:05:09.85,0:05:11.28,Default,,0000,0000,0000,,!مرحى
Dialogue: 0,0:05:11.90,0:05:13.81,Default,,0000,0000,0000,,!كونان-كن! تعال معنا
Dialogue: 0,0:05:13.81,0:05:15.15,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:05:17.03,0:05:17.52,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:05:18.19,0:05:19.65,Default,,0000,0000,0000,,أليست هذه سمكة ببغائية؟
Dialogue: 0,0:05:20.97,0:05:22.32,Default,,0000,0000,0000,,وما في ذلك؟
Dialogue: 0,0:05:22.32,0:05:23.95,Default,,0000,0000,0000,,!لا شيء
Dialogue: 0,0:05:24.52,0:05:27.64,Default,,0000,0000,0000,,كيف تصطاد سمكة محيط\Nفي موقع صيد خارج المحيط؟
Dialogue: 0,0:05:28.31,0:05:30.68,Default,,0000,0000,0000,,لعلّه اشتراها من مكان ما
Dialogue: 0,0:05:33.30,0:05:37.52,Default,,0000,0000,0000,,موري كوغورو! مواهبه الغزيرة\N!لا تتوقف عند التحرّي فحسب
Dialogue: 0,0:05:38.30,0:05:39.97,Default,,0000,0000,0000,,موري كوغورو؟
Dialogue: 0,0:05:41.29,0:05:43.37,Default,,0000,0000,0000,,ماذا؟ من أنت؟
Dialogue: 0,0:05:47.83,0:05:49.35,Default,,0000,0000,0000,,إنّها غلطتي
Dialogue: 0,0:05:58.11,0:05:59.30,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:06:00.64,0:06:02.26,Default,,0000,0000,0000,,توجد ورقة
Dialogue: 0,0:06:06.14,0:06:08.30,Default,,0000,0000,0000,,ما المكتوب بها يا ترى؟
Dialogue: 0,0:06:08.30,0:06:10.47,Default,,0000,0000,0000,,ماذا لو كانت خريطة كنز؟
Dialogue: 0,0:06:10.47,0:06:12.72,Default,,0000,0000,0000,,!كأنّه فيلم أو رواية
Dialogue: 0,0:06:15.60,0:06:16.98,Default,,0000,0000,0000,,!خرجت
Dialogue: 0,0:06:15.60,0:06:16.98,Default,,0000,0000,0000,,!خرجت
Dialogue: 0,0:06:19.13,0:06:20.43,Default,,0000,0000,0000,,...هـ-هذه
Dialogue: 0,0:06:21.00,0:06:22.64,Default,,0000,0000,0000,,رسالة استغاثة، شينوبو"؟"
Dialogue: 0,0:06:23.04,0:06:24.53,Default,,0000,0000,0000,,...أ-أيمكن
Dialogue: 0,0:06:24.53,0:06:27.28,Default,,0000,0000,0000,,...شينوبو-سان تحتاج المساعدة
Dialogue: 0,0:06:27.71,0:06:30.14,Default,,0000,0000,0000,,وأرسلت تلك الرسالة؟
Dialogue: 0,0:06:31.36,0:06:34.56,Default,,0000,0000,0000,,ظننتها غادرت، لكن ها هي تفعل هذا مُجدداً
Dialogue: 0,0:06:34.56,0:06:35.61,Default,,0000,0000,0000,,مُجدداً؟
Dialogue: 0,0:06:35.61,0:06:39.57,Default,,0000,0000,0000,,أجل، تفعل هذا كثيراً. أروني
Dialogue: 0,0:06:39.57,0:06:43.22,Default,,0000,0000,0000,,تحاول جعلي أقلق عليها، يا لإزعاجها أحياناً
Dialogue: 0,0:06:43.69,0:06:46.25,Default,,0000,0000,0000,,يا للإزعاج حقّاً
Dialogue: 0,0:06:47.39,0:06:51.05,Default,,0000,0000,0000,,سيرتفع المدّ قريباً، ربما عليّ الذهاب مرّة أخرى
Dialogue: 0,0:06:51.05,0:06:53.97,Default,,0000,0000,0000,,!يا رفاق! لا تذهبوا للمحيط، سيكون خطيراً
Dialogue: 0,0:06:53.97,0:06:55.56,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:06:53.97,0:06:55.56,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:06:56.26,0:07:00.42,Default,,0000,0000,0000,,لكن ستكون مشكلةً كبيرة\Nإذا أرسلت شينوبو-سان طلب استغاثة حقّاً
Dialogue: 0,0:07:00.42,0:07:02.80,Default,,0000,0000,0000,,علينا التحقّق من الأمر بأنفسنا
Dialogue: 0,0:07:02.80,0:07:04.35,Default,,0000,0000,0000,,لكن أين نبدأ؟
Dialogue: 0,0:07:04.52,0:07:07.29,Default,,0000,0000,0000,,...إذا كانت على جزيرة مهجورة، فلن نستطيع
Dialogue: 0,0:07:08.46,0:07:13.11,Default,,0000,0000,0000,,.كلا، ذلك مستحيل من ناحية الوقت\Nكما أنّ الورقة لم تجفّ بعد
Dialogue: 0,0:07:13.11,0:07:15.02,Default,,0000,0000,0000,,لم ترسلها من مكان بعيد
Dialogue: 0,0:07:18.70,0:07:20.11,Default,,0000,0000,0000,,!ران-نيتشان
Dialogue: 0,0:07:20.81,0:07:24.02,Default,,0000,0000,0000,,لا تتركي كاسودا-سان يغيب عن ناظريك أبداً
Dialogue: 0,0:07:24.02,0:07:25.02,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:07:25.19,0:07:27.46,Default,,0000,0000,0000,,!نعتمد عليك
Dialogue: 0,0:07:25.19,0:07:27.90,Default,,0000,0000,0000,,!نعتمد عليك
Dialogue: 0,0:07:28.24,0:07:30.22,Default,,0000,0000,0000,,!لحظة! أين تذهبون؟
Dialogue: 0,0:07:30.22,0:07:33.08,Default,,0000,0000,0000,,!حسناً! سأصطاد مُجدداً
Dialogue: 0,0:07:34.18,0:07:36.81,Default,,0000,0000,0000,,!سأرافقك يا موري-سان
Dialogue: 0,0:07:37.72,0:07:43.33,Default,,0000,0000,0000,,،أعرف موقع الصيد الذي تذهب له\Nفشركتنا تتوسع في هذه المنطقة
Dialogue: 0,0:07:43.33,0:07:44.14,Default,,0000,0000,0000,,!لنذهب
Dialogue: 0,0:07:45.43,0:07:48.71,Default,,0000,0000,0000,,!أبي! علينا البدء بتوضيب أغراضنا
Dialogue: 0,0:07:49.29,0:07:51.76,Default,,0000,0000,0000,,!يا إلهي! جميعكم أنانيّون
Dialogue: 0,0:07:54.72,0:07:57.82,Default,,0000,0000,0000,,...الناس هذه الأيام
Dialogue: 0,0:07:57.82,0:07:59.99,Default,,0000,0000,0000,,!المعذرة يا جدّ
Dialogue: 0,0:08:00.40,0:08:01.43,Default,,0000,0000,0000,,من جديد؟
Dialogue: 0,0:08:03.40,0:08:04.26,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:08:05.11,0:08:07.69,Default,,0000,0000,0000,,!أيّ سباحة وغوص تقومون بهما؟
Dialogue: 0,0:08:07.69,0:08:08.23,Default,,0000,0000,0000,,...المعذرة
Dialogue: 0,0:08:08.23,0:08:10.64,Default,,0000,0000,0000,,!كيف تجرؤون على توسيخ محيطنا؟
Dialogue: 0,0:08:10.64,0:08:11.85,Default,,0000,0000,0000,,!المعذرة
Dialogue: 0,0:08:10.64,0:08:11.85,Default,,0000,0000,0000,,!المعذرة
Dialogue: 0,0:08:12.85,0:08:13.56,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:08:13.85,0:08:18.01,Default,,0000,0000,0000,,أتعرف من أين جُرفت\Nهذه القنّينة؟
Dialogue: 0,0:08:18.01,0:08:19.02,Default,,0000,0000,0000,,هذه؟
Dialogue: 0,0:08:19.47,0:08:20.79,Default,,0000,0000,0000,,!من هنا يا رفاق
Dialogue: 0,0:08:20.79,0:08:21.63,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:08:20.79,0:08:21.63,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:08:28.50,0:08:29.27,Default,,0000,0000,0000,,غينتا-كن
Dialogue: 0,0:08:30.16,0:08:32.87,Default,,0000,0000,0000,,لمَ معك هذه؟ لم نأت لصيد المحّار
Dialogue: 0,0:08:32.87,0:08:38.66,Default,,0000,0000,0000,,اصمت! لا يمكنني الرجوع دون صيد\N!المحّار والأنقليس بعدما أتيت للمحيط
Dialogue: 0,0:08:38.66,0:08:41.05,Default,,0000,0000,0000,,!كلّ ما يشغلك هو الطعام يا غينتا-كن
Dialogue: 0,0:08:41.05,0:08:42.77,Default,,0000,0000,0000,,!لنجمع نهيد بحر أيضاً
Dialogue: 0,0:08:42.77,0:08:45.57,Default,,0000,0000,0000,,لا تريدون إلّا الصيد الآن جميعاً
Dialogue: 0,0:08:46.98,0:08:49.01,Default,,0000,0000,0000,,أأنتِ بخير يا أيومي؟
Dialogue: 0,0:08:49.51,0:08:51.14,Default,,0000,0000,0000,,نوعاً ما
Dialogue: 0,0:08:51.14,0:08:53.18,Default,,0000,0000,0000,,ذروة المدّ قريبة، توخّي الحذر
Dialogue: 0,0:08:55.85,0:08:56.43,Default,,0000,0000,0000,,!انظروا
Dialogue: 0,0:09:00.30,0:09:01.67,Default,,0000,0000,0000,,شينوبو-سان؟
Dialogue: 0,0:09:01.67,0:09:02.72,Default,,0000,0000,0000,,لا بدّ أنّها هي
Dialogue: 0,0:09:04.63,0:09:07.39,Default,,0000,0000,0000,,!بسرعة! الماء يدخل الكهف
Dialogue: 0,0:09:19.69,0:09:21.97,Default,,0000,0000,0000,,شينوبو-سان! أأنتِ بخير؟
Dialogue: 0,0:09:23.43,0:09:24.76,Default,,0000,0000,0000,,!تماسكي
Dialogue: 0,0:09:24.76,0:09:25.64,Default,,0000,0000,0000,,!شينوبو-سان
Dialogue: 0,0:09:30.52,0:09:31.68,Default,,0000,0000,0000,,!حمداً لله
Dialogue: 0,0:09:33.68,0:09:35.10,Default,,0000,0000,0000,,إنّهم أنتم
Dialogue: 0,0:09:35.39,0:09:36.82,Default,,0000,0000,0000,,ماذا حصل؟
Dialogue: 0,0:09:36.82,0:09:38.60,Default,,0000,0000,0000,,ما حلّ بك يا شينوبو-سان؟
Dialogue: 0,0:09:39.53,0:09:43.93,Default,,0000,0000,0000,,قال أنّه سيأخذني لموقع غوصه الخاص
Dialogue: 0,0:09:44.88,0:09:48.85,Default,,0000,0000,0000,,كهف يختفي بماء المحيط عند ذروة المدّ
Dialogue: 0,0:09:50.41,0:09:54.08,Default,,0000,0000,0000,,...لكن بعدما شربتُ العصير الذي جلبه
Dialogue: 0,0:09:54.08,0:09:55.06,Default,,0000,0000,0000,,غلبني النعاس فجأةً
Dialogue: 0,0:10:20.76,0:10:23.76,Default,,0000,0000,0000,,كان هناك مُنوّم داخل العصير غالباً
Dialogue: 0,0:10:23.76,0:10:26.29,Default,,0000,0000,0000,,أراد قتلك وجعل الأمر يبدو حادثة
Dialogue: 0,0:10:27.05,0:10:30.89,Default,,0000,0000,0000,,يصنع حجّة غياب بينما تغرقين هنا
Dialogue: 0,0:10:31.87,0:10:36.47,Default,,0000,0000,0000,,اصطدامه الوشيك بنا، وتعرّفه علينا\Nوافتعاله الشجار معك
Dialogue: 0,0:10:36.47,0:10:38.94,Default,,0000,0000,0000,,كان كلّه جزءاً من خطّته
Dialogue: 0,0:10:38.94,0:10:40.90,Default,,0000,0000,0000,,لكن لمَ؟
Dialogue: 0,0:10:40.90,0:10:44.70,Default,,0000,0000,0000,,ذلك عمل الشرطة، لنخرج من هنا ونتّصل بهم
Dialogue: 0,0:10:44.70,0:10:46.35,Default,,0000,0000,0000,,!كونان-كن! انظر
Dialogue: 0,0:10:47.45,0:10:49.10,Default,,0000,0000,0000,,!المدّ يدخل
Dialogue: 0,0:10:49.10,0:10:50.77,Default,,0000,0000,0000,,!مُحال
Dialogue: 0,0:10:50.77,0:10:52.27,Default,,0000,0000,0000,,!لنرجع بسرعة
Dialogue: 0,0:11:01.01,0:11:03.55,Default,,0000,0000,0000,,!اخرجوا من القارب! المدّ يرتفع
Dialogue: 0,0:11:03.55,0:11:04.93,Default,,0000,0000,0000,,!بسرعة
Dialogue: 0,0:11:05.68,0:11:07.33,Default,,0000,0000,0000,,لا-لا يُعقل
Dialogue: 0,0:11:07.33,0:11:09.35,Default,,0000,0000,0000,,كيف سنرجع الآن؟
Dialogue: 0,0:11:09.67,0:11:12.72,Default,,0000,0000,0000,,!الموجات عالية جدّاً فلا نستطيع الخروج سباحةً
Dialogue: 0,0:11:12.72,0:11:16.40,Default,,0000,0000,0000,,كما أنّ شينوبو-سان لم تستعد وعيها تماماً
Dialogue: 0,0:11:17.04,0:11:18.14,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:11:18.14,0:11:19.46,Default,,0000,0000,0000,,!النجدة
Dialogue: 0,0:11:19.46,0:11:20.93,Default,,0000,0000,0000,,!لا أريد الموت
Dialogue: 0,0:11:20.93,0:11:23.66,Default,,0000,0000,0000,,!اهدؤوا جميعاً، لا تهلعوا
Dialogue: 0,0:11:23.66,0:11:25.33,Default,,0000,0000,0000,,!يسهل عليك قول هذا
Dialogue: 0,0:11:25.33,0:11:27.66,Default,,0000,0000,0000,,...إذا ملأ الماء الكهف
Dialogue: 0,0:11:27.66,0:11:29.39,Default,,0000,0000,0000,,!سنغرق جميعاً
Dialogue: 0,0:11:29.39,0:11:32.60,Default,,0000,0000,0000,,ما العمل؟ ما العمل الآن؟
Dialogue: 0,0:11:38.15,0:11:38.98,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:11:40.18,0:11:41.26,Default,,0000,0000,0000,,ما هذه؟
Dialogue: 0,0:11:43.47,0:11:44.97,Default,,0000,0000,0000,,!يراعة
Dialogue: 0,0:11:45.47,0:11:46.33,Default,,0000,0000,0000,,يراعات؟
Dialogue: 0,0:11:46.33,0:11:48.01,Default,,0000,0000,0000,,في مكان كهذا؟
Dialogue: 0,0:11:48.01,0:11:49.22,Default,,0000,0000,0000,,هذا غريب بالفعل
Dialogue: 0,0:11:49.67,0:11:53.43,Default,,0000,0000,0000,,ماذا تفعل في كهف يمتلئ\Nبأسره بالماء مرّتين يومياً؟
Dialogue: 0,0:11:54.29,0:11:55.39,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:11:55.39,0:11:56.85,Default,,0000,0000,0000,,أيمكن؟
Dialogue: 0,0:11:55.39,0:11:56.85,Default,,0000,0000,0000,,أيمكن؟
Dialogue: 0,0:11:57.46,0:12:01.85,Default,,0000,0000,0000,,!ربما للكهف مخرج آخر، ودخلت منه
Dialogue: 0,0:12:01.85,0:12:03.67,Default,,0000,0000,0000,,!مـ-ماذا؟
Dialogue: 0,0:12:03.67,0:12:05.31,Default,,0000,0000,0000,,!مخرج آخر؟
Dialogue: 0,0:12:05.31,0:12:07.95,Default,,0000,0000,0000,,!هذا مهربنا الوحيد الآن
Dialogue: 0,0:12:07.95,0:12:11.07,Default,,0000,0000,0000,,لكن ماذا لو كان لا يتّسع للبشر؟
Dialogue: 0,0:12:11.48,0:12:12.92,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:12:12.92,0:12:16.22,Default,,0000,0000,0000,,!لسنا يراعات يا كونان
Dialogue: 0,0:12:16.81,0:12:21.89,Default,,0000,0000,0000,,السمكة الببغائية التي اصطادها العمّ\Nكانت كبيرة لكن بلا أيّ ندبات
Dialogue: 0,0:12:21.89,0:12:23.72,Default,,0000,0000,0000,,!ليس مخرجاً صغيراً
Dialogue: 0,0:12:25.55,0:12:30.75,Default,,0000,0000,0000,,دخلت الكهف أثناء ذروة المدّ قبل الفجر
Dialogue: 0,0:12:31.59,0:12:36.60,Default,,0000,0000,0000,,جُرفت داخله ووصلت للبحيرة \N...حيث كان العمّ
Dialogue: 0,0:12:38.17,0:12:40.00,Default,,0000,0000,0000,,!يصطاد غالباً
Dialogue: 0,0:12:41.49,0:12:45.53,Default,,0000,0000,0000,,موقع صيد تصطاد فيه أسماك المحيط\N!رغم أنّه ليس محيطاً
Dialogue: 0,0:12:46.41,0:12:47.58,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:12:46.41,0:12:47.58,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:12:47.58,0:12:48.98,Default,,0000,0000,0000,,!كما يُتوقع من كونان-كن
Dialogue: 0,0:12:48.98,0:12:52.35,Default,,0000,0000,0000,,آسف يا عمّ، يبدو أنّك لم تشترها فعلاً
Dialogue: 0,0:12:53.81,0:12:55.75,Default,,0000,0000,0000,,!سنغرق إذا بقينا هنا
Dialogue: 0,0:12:55.75,0:12:57.36,Default,,0000,0000,0000,,!أنا أثق بكونان-كن
Dialogue: 0,0:12:57.36,0:12:59.07,Default,,0000,0000,0000,,!حسنٌ، لنذهب
Dialogue: 0,0:13:07.56,0:13:09.16,Default,,0000,0000,0000,,!ما الخطب يا أيومي-تشان؟
Dialogue: 0,0:13:09.16,0:13:11.14,Default,,0000,0000,0000,,تساقط ماء من السقف
Dialogue: 0,0:13:11.75,0:13:13.33,Default,,0000,0000,0000,,هـ-هذا إذاً؟
Dialogue: 0,0:13:13.33,0:13:15.00,Default,,0000,0000,0000,,!لا تخيفينا
Dialogue: 0,0:13:15.00,0:13:16.10,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:13:17.63,0:13:19.40,Default,,0000,0000,0000,,إنّها أشبه بالمتاهة
Dialogue: 0,0:13:19.40,0:13:21.54,Default,,0000,0000,0000,,من أين نخرج؟
Dialogue: 0,0:13:21.54,0:13:23.62,Default,,0000,0000,0000,,إذا سلكنا الطريق الخطأ سنتوه وحسب
Dialogue: 0,0:13:24.54,0:13:28.02,Default,,0000,0000,0000,,!لكن إذا لم نسرع، سيصلنا ماء المد
Dialogue: 0,0:13:31.11,0:13:33.62,Default,,0000,0000,0000,,!حسناً، لنذهب من هنا بأيّ حال
Dialogue: 0,0:13:33.62,0:13:34.75,Default,,0000,0000,0000,,!انتظر يا غينتا
Dialogue: 0,0:13:36.28,0:13:38.82,Default,,0000,0000,0000,,ماذا؟ ما هذا؟ طريق مسدود
Dialogue: 0,0:13:38.82,0:13:40.59,Default,,0000,0000,0000,,!أخبرتك
Dialogue: 0,0:13:41.14,0:13:42.90,Default,,0000,0000,0000,,سنسلك الطريق الذي تأخذه اليراعات
Dialogue: 0,0:13:42.90,0:13:43.85,Default,,0000,0000,0000,,!تفكير سليم
Dialogue: 0,0:13:43.85,0:13:47.31,Default,,0000,0000,0000,,!سيقودنا للمخرج بلا شكّ
Dialogue: 0,0:13:47.31,0:13:49.31,Default,,0000,0000,0000,,!لننفصل ونبحث عن اليراعات
Dialogue: 0,0:13:49.31,0:13:50.34,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:13:49.31,0:13:50.34,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:13:50.34,0:13:53.17,Default,,0000,0000,0000,,سأساعد بدوري! فقد تحسّن حالي
Dialogue: 0,0:13:55.71,0:13:57.44,Default,,0000,0000,0000,,!ليست هنا
Dialogue: 0,0:13:57.67,0:13:59.27,Default,,0000,0000,0000,,!ولا هنا
Dialogue: 0,0:13:59.66,0:14:00.58,Default,,0000,0000,0000,,ولا هنا
Dialogue: 0,0:14:01.00,0:14:04.70,Default,,0000,0000,0000,,!وجدتها! إنّها هنا
Dialogue: 0,0:14:04.70,0:14:07.12,Default,,0000,0000,0000,,!حسناً! لننطلق
Dialogue: 0,0:14:15.07,0:14:18.03,Default,,0000,0000,0000,,يميناً أم يساراً؟ إمّا نسلك أحدهما أو الآخر
Dialogue: 0,0:14:18.03,0:14:20.77,Default,,0000,0000,0000,,!حسناً، لنبحث عن اليراعات مُجدداً
Dialogue: 0,0:14:27.10,0:14:29.42,Default,,0000,0000,0000,,لا جدوى، الاثنان فارغان
Dialogue: 0,0:14:29.42,0:14:31.34,Default,,0000,0000,0000,,وصلنا النهاية أخيراً
Dialogue: 0,0:14:31.34,0:14:33.26,Default,,0000,0000,0000,,!لا تقل ذلك
Dialogue: 0,0:14:33.26,0:14:34.76,Default,,0000,0000,0000,,ما العمل يا كونان-كن؟
Dialogue: 0,0:14:37.05,0:14:38.14,Default,,0000,0000,0000,,لا تزال هناك طريقة
Dialogue: 0,0:14:53.36,0:14:54.45,Default,,0000,0000,0000,,!من هنا
Dialogue: 0,0:14:54.45,0:14:57.96,Default,,0000,0000,0000,,!فهمت! استمعت لاختلاف الصدى
Dialogue: 0,0:14:57.96,0:14:58.61,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:14:58.61,0:15:02.85,Default,,0000,0000,0000,,،الصدى المرتفع كان طريقاً مسدوداً\Nبينما المنخفض يؤدي لطريق
Dialogue: 0,0:15:03.19,0:15:05.09,Default,,0000,0000,0000,,!مُذهل يا كونان-كن
Dialogue: 0,0:15:05.09,0:15:06.73,Default,,0000,0000,0000,,!حسناً، هيّا بنا
Dialogue: 0,0:15:18.88,0:15:20.47,Default,,0000,0000,0000,,!ادفعني
Dialogue: 0,0:15:20.47,0:15:21.68,Default,,0000,0000,0000,,!اسحبوا أقوى
Dialogue: 0,0:15:30.74,0:15:34.20,Default,,0000,0000,0000,,مـ-ماذا؟ ما هذا الصوت؟
Dialogue: 0,0:15:35.78,0:15:36.43,Default,,0000,0000,0000,,!طيور
Dialogue: 0,0:15:36.70,0:15:37.73,Default,,0000,0000,0000,,طيور؟
Dialogue: 0,0:15:36.70,0:15:37.73,Default,,0000,0000,0000,,طيور؟
Dialogue: 0,0:15:38.36,0:15:41.40,Default,,0000,0000,0000,,!دخلت تبحث عن طعام وما شابه غالباً
Dialogue: 0,0:15:47.35,0:15:49.77,Default,,0000,0000,0000,,!إنّها تتّجه نحو المخرج
Dialogue: 0,0:15:51.26,0:15:52.55,Default,,0000,0000,0000,,!حسنٌ، لنلحق بها
Dialogue: 0,0:16:01.21,0:16:02.30,Default,,0000,0000,0000,,أأنت بخير؟
Dialogue: 0,0:16:02.67,0:16:04.83,Default,,0000,0000,0000,,!تحمّل! لنواصل الركض
Dialogue: 0,0:16:04.83,0:16:06.58,Default,,0000,0000,0000,,!هيّا يا رفاق، بسرعة
Dialogue: 0,0:16:06.58,0:16:08.14,Default,,0000,0000,0000,,!أنا بخير
Dialogue: 0,0:16:14.07,0:16:16.49,Default,,0000,0000,0000,,لم أعد أستطيع سماعها
Dialogue: 0,0:16:16.49,0:16:17.57,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:16:17.57,0:16:19.03,Default,,0000,0000,0000,,خرجت بالفعل؟
Dialogue: 0,0:16:19.03,0:16:21.51,Default,,0000,0000,0000,,أجل، تأخّرنا
Dialogue: 0,0:16:26.98,0:16:30.85,Default,,0000,0000,0000,,طـ-طيور؟ أخافتني
Dialogue: 0,0:16:33.35,0:16:35.68,Default,,0000,0000,0000,,ما-ما الخطب؟
Dialogue: 0,0:16:35.68,0:16:38.39,Default,,0000,0000,0000,,كنتُ أتساءل ما إن وصل\Nالمدّ ذروته بالفعل
Dialogue: 0,0:16:38.97,0:16:41.34,Default,,0000,0000,0000,,يا إلهي، أين ذهبوا؟
Dialogue: 0,0:16:42.50,0:16:43.54,Default,,0000,0000,0000,,ران-نيتشان
Dialogue: 0,0:16:43.54,0:16:46.14,Default,,0000,0000,0000,,لا تتركي كاسودا-سان يغيب عن ناظريك
Dialogue: 0,0:16:46.14,0:16:47.69,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:16:48.25,0:16:51.12,Default,,0000,0000,0000,,لا تنسي أخذ قمامتكم عند مغادرتكم
Dialogue: 0,0:16:51.12,0:16:56.33,Default,,0000,0000,0000,,يا جدّ! أتعرف أين أفضل\Nموقع صيد في هذه المنطقة؟
Dialogue: 0,0:16:57.49,0:16:59.37,Default,,0000,0000,0000,,أين نذهب الآن يا كونان؟
Dialogue: 0,0:16:59.37,0:17:00.36,Default,,0000,0000,0000,,أيّهم؟
Dialogue: 0,0:17:00.36,0:17:01.98,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:17:07.23,0:17:08.11,Default,,0000,0000,0000,,لا أدري
Dialogue: 0,0:17:08.25,0:17:09.37,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:17:08.25,0:17:09.37,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:17:12.76,0:17:13.72,Default,,0000,0000,0000,,!إنّه المدّ
Dialogue: 0,0:17:24.59,0:17:25.95,Default,,0000,0000,0000,,!الـ-النجدة
Dialogue: 0,0:17:25.95,0:17:28.09,Default,,0000,0000,0000,,!تمسّكي بي يا شينوبو-سان
Dialogue: 0,0:17:29.41,0:17:30.62,Default,,0000,0000,0000,,!النجدة
Dialogue: 0,0:17:30.62,0:17:31.95,Default,,0000,0000,0000,,!أنقذوني
Dialogue: 0,0:17:34.45,0:17:38.10,Default,,0000,0000,0000,,تبّاً! أدخلنا طريقاً بنهاية مسدودة؟
Dialogue: 0,0:17:42.40,0:17:43.59,Default,,0000,0000,0000,,!المصباح
Dialogue: 0,0:17:43.59,0:17:45.44,Default,,0000,0000,0000,,!الظلام حالك
Dialogue: 0,0:17:57.97,0:17:59.18,Default,,0000,0000,0000,,!ما هذا؟
Dialogue: 0,0:18:00.21,0:18:05.71,Default,,0000,0000,0000,,!فهمت! كنّا في أعلى الكهف
Dialogue: 0,0:18:05.71,0:18:09.47,Default,,0000,0000,0000,,!الماء يجري نحو المخرج الآخر الآن
Dialogue: 0,0:18:09.47,0:18:10.71,Default,,0000,0000,0000,,!أين نحن؟
Dialogue: 0,0:18:11.58,0:18:15.25,Default,,0000,0000,0000,,لا أستطيع تمييز اليمين من اليسار\N!ولا الأعلى من الأسفل هكذا
Dialogue: 0,0:18:15.25,0:18:16.25,Default,,0000,0000,0000,,...أين نحن
Dialogue: 0,0:18:17.29,0:18:19.24,Default,,0000,0000,0000,,!إنّه المخرج
Dialogue: 0,0:18:24.07,0:18:25.68,Default,,0000,0000,0000,,!ها هي
Dialogue: 0,0:18:30.68,0:18:31.64,Default,,0000,0000,0000,,ماذا حصل؟
Dialogue: 0,0:18:35.85,0:18:37.02,Default,,0000,0000,0000,,!أنا عالق
Dialogue: 0,0:18:39.51,0:18:41.93,Default,,0000,0000,0000,,!تبّاً! الفتحة ضيقة على غينتا
Dialogue: 0,0:18:44.13,0:18:46.64,Default,,0000,0000,0000,,...سترة نجاته! إذا استطعتُ خلعها
Dialogue: 0,0:18:49.01,0:18:50.47,Default,,0000,0000,0000,,...لا جدوى! عليّ تمزيقها
Dialogue: 0,0:18:53.25,0:18:56.71,Default,,0000,0000,0000,,!تبّاً، لا تتمزق! أليس هناك ما يمكنني استعماله؟
Dialogue: 0,0:18:57.65,0:18:59.60,Default,,0000,0000,0000,,!هذه أداة صيده
Dialogue: 0,0:19:01.00,0:19:03.48,Default,,0000,0000,0000,,!حسناً! خذ
Dialogue: 0,0:19:07.00,0:19:09.03,Default,,0000,0000,0000,,!لا أستطيع كتم نفسي أكثر
Dialogue: 0,0:19:23.48,0:19:25.59,Default,,0000,0000,0000,,!ظننتني سأموت
Dialogue: 0,0:19:25.59,0:19:26.58,Default,,0000,0000,0000,,!نجونا
Dialogue: 0,0:19:32.42,0:19:35.61,Default,,0000,0000,0000,,!ما-ما هذا؟ لمَ أنتم هنا؟
Dialogue: 0,0:19:35.61,0:19:37.89,Default,,0000,0000,0000,,!كما ظننت تماماً
Dialogue: 0,0:19:38.47,0:19:41.87,Default,,0000,0000,0000,,!الماء من ذروة المدّ يصبّ في هذه البحيرة
Dialogue: 0,0:19:43.46,0:19:47.58,Default,,0000,0000,0000,,سبب عدم ارتفاع منسوب مائها\Nهو أنّه لا يجري من اتّجاه واحد فحسب
Dialogue: 0,0:19:47.58,0:19:50.98,Default,,0000,0000,0000,,!بل يخرج أثناء تدنّي الجزر عبر مخرج آخر سفليّ
Dialogue: 0,0:19:51.90,0:19:56.90,Default,,0000,0000,0000,,لكنّ ذاك المخرج ضيّق، فتقلّ كميّة الماء\Nالداخلة أثناء ذروة المدّ
Dialogue: 0,0:19:58.40,0:20:01.27,Default,,0000,0000,0000,,!كيف وصلتم هنا؟
Dialogue: 0,0:20:02.56,0:20:07.28,Default,,0000,0000,0000,,توقّعتُ حدوث هذا، من الجيّد أنّي\Nجلبت هذا معي تحسّباً
Dialogue: 0,0:20:07.28,0:20:08.23,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:08.23,0:20:09.63,Default,,0000,0000,0000,,!أيومي
Dialogue: 0,0:20:09.63,0:20:10.47,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:20:10.47,0:20:11.40,Default,,0000,0000,0000,,!لا تتحركوا
Dialogue: 0,0:20:11.97,0:20:14.43,Default,,0000,0000,0000,,!تيروهيكو-سان! توقّف
Dialogue: 0,0:20:14.43,0:20:15.69,Default,,0000,0000,0000,,...ما الذي
Dialogue: 0,0:20:15.69,0:20:16.54,Default,,0000,0000,0000,,!اخرس
Dialogue: 0,0:20:17.01,0:20:22.27,Default,,0000,0000,0000,,أوني-سان، إذا استعملت هذا فلن يكون\Nهناك معنى لخطّة الحادثة المزيّفة التي ابتكرتها
Dialogue: 0,0:20:22.79,0:20:27.23,Default,,0000,0000,0000,,تظنّني لن أطلق يا فتى؟ لديّ رصاصات تكفي لكم جميعاً
Dialogue: 0,0:20:28.36,0:20:29.43,Default,,0000,0000,0000,,!النجدة
Dialogue: 0,0:20:29.43,0:20:30.52,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:20:30.82,0:20:35.82,Default,,0000,0000,0000,,توقّف يا تيروهيكو-سان! أنا من تريد قتلها، صحيح؟
Dialogue: 0,0:20:35.82,0:20:37.53,Default,,0000,0000,0000,,!لا علاقة لهذه الطفلة
Dialogue: 0,0:20:37.53,0:20:41.73,Default,,0000,0000,0000,,!أجل، إنّها غلطتك! عليك الموت
Dialogue: 0,0:20:42.23,0:20:45.27,Default,,0000,0000,0000,,!لمَ؟ لمَ تفعل هذا؟
Dialogue: 0,0:20:45.69,0:20:48.90,Default,,0000,0000,0000,,أمرني أبي أن أتزوّج فتاةً\Nأشبه بالقرد مثلك
Dialogue: 0,0:20:49.68,0:20:52.06,Default,,0000,0000,0000,,لا نيّة لديّ بترك المنزل والعيش فقيراً معك
Dialogue: 0,0:20:52.55,0:20:56.15,Default,,0000,0000,0000,,!أريد البقاء شاباً ثرياً للأبد
Dialogue: 0,0:20:56.15,0:20:57.48,Default,,0000,0000,0000,,!فـ-فظيع
Dialogue: 0,0:20:57.80,0:20:59.83,Default,,0000,0000,0000,,!يا للحقير
Dialogue: 0,0:20:59.83,0:21:02.58,Default,,0000,0000,0000,,!لكن كلّ ما لديّ هي أداة صيد
Dialogue: 0,0:21:02.58,0:21:05.71,Default,,0000,0000,0000,,!حذاء تقوية الركل وبقيّة أسلحتي ليست معي
Dialogue: 0,0:21:05.71,0:21:07.44,Default,,0000,0000,0000,,أهذه النهاية هذه المرّة حقّاً؟
Dialogue: 0,0:21:07.83,0:21:12.41,Default,,0000,0000,0000,,لا يمكنني ترككم أحياء بعدما عرفتم الحقيقة
Dialogue: 0,0:21:12.41,0:21:15.41,Default,,0000,0000,0000,,سأجعلكم جميعاً طعاماً للسمك
Dialogue: 0,0:21:15.41,0:21:18.93,Default,,0000,0000,0000,,!أحمق! ممنوعٌ دخول هذا المكان
Dialogue: 0,0:21:20.06,0:21:21.56,Default,,0000,0000,0000,,!ستدفع ثمن أذية الفتيات
Dialogue: 0,0:21:39.17,0:21:43.25,Default,,0000,0000,0000,,!نصر كبير لفرقة فتيان التحرّي
Dialogue: 0,0:23:24.69,0:23:27.78,Default,,0000,0000,0000,,كانت حادثةً مليئة بالإثارة\Nوالتشويق والمغامرة
Dialogue: 0,0:23:27.78,0:23:29.13,Default,,0000,0000,0000,,وبعض المرارة
Dialogue: 0,0:23:30.60,0:23:33.89,Default,,0000,0000,0000,,...وبالنسبة لأحدهم، كانت
Dialogue: 0,0:23:33.89,0:23:37.23,Default,,0000,0000,0000,,!أحمق! سأخذ هذه معي
Dialogue: 0,0:23:37.23,0:23:38.54,Default,,0000,0000,0000,,...إنّها
Dialogue: 0,0:23:38.54,0:23:40.60,Default,,0000,0000,0000,,!لا تزال لا تفهم؟
Dialogue: 0,0:23:41.38,0:23:45.27,Default,,0000,0000,0000,,تلقّى العمّ بعدها توبيخاً من الجدّ لساعة كاملة
Dialogue: 0,0:23:46.89,0:23:51.61,Default,,0000,0000,0000,,كان يصطاد في منطقة محظورة\Nخطرة بسبب ذروة المدّ
Dialogue: 0,0:23:52.12,0:23:54.79,Default,,0000,0000,0000,,يستحقّ ما حلّ به
Dialogue: 0,0:24:02.49,0:24:03.94,Default,,0000,0000,0000,,!شينيغامي جينّاي
Dialogue: 0,0:24:03.94,0:24:06.15,Default,,0000,0000,0000,,!سلّم نفسك
Dialogue: 0,0:24:11.85,0:24:15.82,Default,,0000,0000,0000,,!لا يزال المجرم في الطابق السابع يا عمّ\N!رأيتُ ظلّه للتو
Dialogue: 0,0:24:17.52,0:24:20.09,Default,,0000,0000,0000,,لمَ أطلق النار؟
Dialogue: 0,0:24:20.09,0:24:24.34,Default,,0000,0000,0000,,وأين اختبأ في هذا المبنى\Nمتوارياً عن أنظار الشرطة؟
Dialogue: 0,0:24:24.71,0:24:30.16,On Top,,0000,0000,0000,,جريمة قتل ملك الموت جينّاي
Dialogue: 0,0:24:25.84,0:24:27.09,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.09,0:24:29.62,Default,,0000,0000,0000,,جريمة قتل ملك الموت جينّاي
Dialogue: 0,0:24:45.70,0:24:48.11,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.11,0:24:50.04,Default,,0000,0000,0000,,مصعد
Dialogue: 0,0:24:50.16,0:24:51.98,Default,,0000,0000,0000,,!ظهور قاتل غامض في الحلقة القادمة
Dialogue: 0,0:24:51.98,0:24:52.81,Default,,0000,0000,0000,,أنا القاتل الغامض
Dialogue: 0,0:24:52.81,0:24:54.14,Default,,0000,0000,0000,,بل أنا القاتلة الغامضة
Dialogue: 0,0:24:54.14,0:24:56.14,Default,,0000,0000,0000,,!بل أنا

