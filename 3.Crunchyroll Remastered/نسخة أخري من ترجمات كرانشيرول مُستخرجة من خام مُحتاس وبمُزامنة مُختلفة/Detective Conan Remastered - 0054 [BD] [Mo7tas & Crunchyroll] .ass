Dialogue: 0,0:00:00.96,0:00:03.66,Default,,0000,0000,0000,,طالما جرائم العصر الحديث تتضمّن بشراً
Dialogue: 0,0:00:03.66,0:00:05.77,Default,,0000,0000,0000,,!لا توجد ألغاز لا تُحلّ
Dialogue: 0,0:00:05.77,0:00:07.31,Default,,0000,0000,0000,,مسرح اليوم أحد الفنادق الراقية
Dialogue: 0,0:00:07.31,0:00:08.90,Default,,0000,0000,0000,,!وجدتُ المنظمة الغامضة
Dialogue: 0,0:00:08.90,0:00:10.66,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.66,0:00:12.73,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ دماغه لبالغ
Dialogue: 0,0:00:12.73,0:00:15.18,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.21,0:01:57.06,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل شركة الألعاب
Dialogue: 0,0:01:51.81,0:01:54.52,Default,,0000,0000,0000,,جريمة قتل شركة الألعاب
Dialogue: 0,0:01:57.22,0:01:59.48,On Top,,0000,0000,0000,,أشرف العمّ على لعبة؟
Dialogue: 0,0:01:57.33,0:01:59.48,CharCard,,0000,0000,0010,,{\fad(300,0)}فندق بيكا
Dialogue: 0,0:01:59.93,0:02:00.68,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:02:00.68,0:02:03.68,Default,,0000,0000,0000,,تُسمى "منزل استنتاج المتحرّي\N"العظيم موري كوغورو
Dialogue: 0,0:02:04.21,0:02:07.34,Default,,0000,0000,0000,,يجد اللاعب جثّة في قصر غامض
Dialogue: 0,0:02:07.34,0:02:10.84,Default,,0000,0000,0000,,ويتلقى تلميحات من المتحرّي موري \Nالذي يلتقيه صدفةً
Dialogue: 0,0:02:10.84,0:02:13.51,Default,,0000,0000,0000,,ويحلّ القضيّة
Dialogue: 0,0:02:15.50,0:02:18.43,Default,,0000,0000,0000,,...هذا السيناريو معي كلّ مرة تقريباً
Dialogue: 0,0:02:19.16,0:02:24.00,Default,,0000,0000,0000,,لكن هل سيجري الأمر على ما يرام\Nوضيف شرفهم بهذا الحال؟
Dialogue: 0,0:02:26.03,0:02:28.49,Default,,0000,0000,0000,,هذا ما تناله لإفراطك في الشرب البارحة
Dialogue: 0,0:02:28.49,0:02:30.44,Default,,0000,0000,0000,,!"في حفلتك "السابقة للحفلة
Dialogue: 0,0:02:30.44,0:02:33.13,Default,,0000,0000,0000,,...شربت 5 أو 6 كؤوس فحسب
Dialogue: 0,0:02:33.13,0:02:35.60,Default,,0000,0000,0000,,...جين، فودكا، بوربون
Dialogue: 0,0:02:36.73,0:02:37.56,Default,,0000,0000,0000,,...جين وفودكا
Dialogue: 0,0:02:38.64,0:02:41.12,Default,,0000,0000,0000,,إنّهما الاسمان الرمزيّان\Nللرجلان بالرداء الأسود
Dialogue: 0,0:02:41.12,0:02:43.47,Default,,0000,0000,0000,,!اللذان قلّصا جسدي
Dialogue: 0,0:02:43.88,0:02:46.51,Default,,0000,0000,0000,,!يا للطابور الطويل
Dialogue: 0,0:02:46.51,0:02:47.97,Default,,0000,0000,0000,,لا عجب
Dialogue: 0,0:02:47.97,0:02:51.22,Default,,0000,0000,0000,,مُعظم العاملين في مجال\Nصناعة الألعاب متواجدون هنا
Dialogue: 0,0:02:52.37,0:02:53.89,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:02:54.29,0:02:57.75,On Top,,0000,0000,0000,,إنّه أنا، ناكاجيما من مانتيندو
Dialogue: 0,0:02:54.65,0:03:00.22,CharCard,,0000,0000,0005,,{\fad(300,0)}(ناكاجيما هيدياكي (27\Nمطوّر في شركة ألعاب مانتيندو
Dialogue: 0,0:02:57.75,0:03:01.09,On Top,,0000,0000,0000,,خطّطتُ لعبة "منزل استنتاج المتحرّي\N"العظيم موري كوغورو
Dialogue: 0,0:03:01.61,0:03:05.26,Default,,0000,0000,0000,,!أنتجنا لعبةً مذهلة بفضلك
Dialogue: 0,0:03:05.78,0:03:08.24,Default,,0000,0000,0000,,أنت تجيد عملك حقاً يا ناكاجيما
Dialogue: 0,0:03:08.24,0:03:10.81,Default,,0000,0000,0000,,بافتراض أنّك خططت لتلك اللعبة حقاً
Dialogue: 0,0:03:11.73,0:03:12.55,Default,,0000,0000,0000,,!أويدا
Dialogue: 0,0:03:13.10,0:03:16.10,On Top,,0000,0000,0000,,كان عليّ ألّا أخبرك\Nأنّ اللعبة ستلقى نجاحاً
Dialogue: 0,0:03:13.31,0:03:18.02,CharCard,,0000,0000,0005,,{\fad(300,0)}(أويدا كوجي (27\Nمطوّر في شركة ألعاب مانتيندو
Dialogue: 0,0:03:16.10,0:03:18.02,On Top,,0000,0000,0000,,إذا استعملنا المتحرّي موري
Dialogue: 0,0:03:18.60,0:03:22.43,Default,,0000,0000,0000,,بعد ثلاثة أيام ترأسّت الفكرة عرضك التقديمي
Dialogue: 0,0:03:22.43,0:03:23.76,Default,,0000,0000,0000,,ومرت الأحداث وها نحن في إعلان اللعبة
Dialogue: 0,0:03:24.76,0:03:27.01,Default,,0000,0000,0000,,أنت عبقريّ في سرقة حاجات الآخرين
Dialogue: 0,0:03:27.01,0:03:28.64,Default,,0000,0000,0000,,...العمل، والنساء
Dialogue: 0,0:03:29.09,0:03:30.39,Default,,0000,0000,0000,,صحيح يا تاكيشيتا؟
Dialogue: 0,0:03:30.76,0:03:32.42,On Top,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:03:31.15,0:03:36.26,CharCard,,0000,0000,0005,,{\fad(300,0)}(تاكيشيتا هيرونوبو (27\Nمطوّر في شركة ألعاب مانتيندو
Dialogue: 0,0:03:32.42,0:03:36.27,On Top,,0000,0000,0000,,لكن كان ذلك أيام الجامعة، فنسيتُ الأمر
Dialogue: 0,0:03:36.84,0:03:40.08,Default,,0000,0000,0000,,حسناً، سأتغاضى عن الأمر هذه المرّة
Dialogue: 0,0:03:40.08,0:03:43.68,Default,,0000,0000,0000,,فيبدو أنّك في مشكلة\Nمع محصّلي الديون وما شابه
Dialogue: 0,0:03:46.03,0:03:49.45,Default,,0000,0000,0000,,هذه بطاقة رقم أمتعتك
Dialogue: 0,0:03:49.45,0:03:50.69,Default,,0000,0000,0000,,ستّ وتسعون
Dialogue: 0,0:03:51.90,0:03:54.38,Default,,0000,0000,0000,,!تأخّر بنا الوقت
Dialogue: 0,0:03:54.38,0:03:55.48,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:03:55.48,0:03:58.43,Default,,0000,0000,0000,,!علينا الإسراع لطابق العرض والتجهّز
Dialogue: 0,0:03:59.31,0:04:00.09,Default,,0000,0000,0000,,!سجّلوا هذه عندكم أوّلاً
Dialogue: 0,0:04:00.09,0:04:01.30,Default,,0000,0000,0000,,!وحقيبتي
Dialogue: 0,0:04:01.72,0:04:03.55,Default,,0000,0000,0000,,!لا تقطعا الصفّ
Dialogue: 0,0:04:03.55,0:04:05.76,Default,,0000,0000,0000,,!يجدر بك الإسراع أيضاً
Dialogue: 0,0:04:05.76,0:04:08.18,Default,,0000,0000,0000,,!سيوبّخك الرئيس إن تأخرت
Dialogue: 0,0:04:08.18,0:04:09.52,Default,,0000,0000,0000,,...مـ-معك حق
Dialogue: 0,0:04:10.01,0:04:12.00,Default,,0000,0000,0000,,لا تخلطوا بينها من فضلكم
Dialogue: 0,0:04:12.00,0:04:15.38,Default,,0000,0000,0000,,تحملون جميعاً نفس الحقيبة
Dialogue: 0,0:04:15.38,0:04:17.21,Default,,0000,0000,0000,,...أجل، ليس حقائبنا فحسب
Dialogue: 0,0:04:17.21,0:04:19.29,Default,,0000,0000,0000,,ينطبق الأمر على دبابيس ربطات عنقنا\Nوساعات أيدينا
Dialogue: 0,0:04:19.29,0:04:21.28,Default,,0000,0000,0000,,كانت فكرة رئيس الشركة
Dialogue: 0,0:04:21.28,0:04:23.68,Default,,0000,0000,0000,,بأن نعطي عامة الناس انطباعاً عن شركتنا
Dialogue: 0,0:04:24.37,0:04:28.37,Default,,0000,0000,0000,,لكنّ الحقائب كبيرة وثقيلة في الواقع
Dialogue: 0,0:04:28.37,0:04:30.03,Default,,0000,0000,0000,,أحضرناها معنا اليوم
Dialogue: 0,0:04:30.03,0:04:32.60,Default,,0000,0000,0000,,لكنّ معظم موظّفي الشركة أودعوها هنا
Dialogue: 0,0:04:32.60,0:04:36.67,Default,,0000,0000,0000,,الرئيس وحده من يمشي\Nبحقيبته الآن غالباً
Dialogue: 0,0:04:39.65,0:04:40.93,Default,,0000,0000,0000,,اعذروني على ذلك
Dialogue: 0,0:04:40.93,0:04:42.18,Default,,0000,0000,0000,,!حـ-حضرة الرئيس
Dialogue: 0,0:04:42.18,0:04:44.26,Default,,0000,0000,0000,,!إلى أماكنكم فوراً
Dialogue: 0,0:04:44.26,0:04:45.49,Default,,0000,0000,0000,,!حـ-حاضر
Dialogue: 0,0:04:48.85,0:04:49.69,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:04:50.22,0:04:51.79,Default,,0000,0000,0000,,هذه بطاقتكم
Dialogue: 0,0:04:51.79,0:04:52.36,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:04:53.34,0:04:54.96,Default,,0000,0000,0000,,!يا لحظّي
Dialogue: 0,0:04:54.96,0:04:59.34,Default,,0000,0000,0000,,!انظر يا كونان-كن، الرقم على بطاقتنا 100
Dialogue: 0,0:04:59.34,0:05:01.55,Default,,0000,0000,0000,,!ربما سيحصل أمرٌ حسن اليوم
Dialogue: 0,0:05:02.16,0:05:03.51,Default,,0000,0000,0000,,...إنها تتحمّس بسرعة
Dialogue: 0,0:05:09.02,0:05:11.05,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:05:11.48,0:05:12.85,Default,,0000,0000,0000,,!كيف هذه؟
Dialogue: 0,0:05:16.07,0:05:18.98,Default,,0000,0000,0000,,!فعلتُها! قلبت الطاولة
Dialogue: 0,0:05:18.98,0:05:20.48,Default,,0000,0000,0000,,!مذهل يا ران-تشان
Dialogue: 0,0:05:20.48,0:05:22.93,Default,,0000,0000,0000,,قلّ من يستطيع تنفيذ تلك الضربة
Dialogue: 0,0:05:22.93,0:05:24.39,Default,,0000,0000,0000,,ماذا؟ حقّاً؟
Dialogue: 0,0:05:24.89,0:05:27.35,Default,,0000,0000,0000,,...ربما الحظّ يحالفها بالفعل
Dialogue: 0,0:05:29.89,0:05:33.51,Default,,0000,0000,0000,,كنت قريباً! يصدر ضوء لامع\N...عندما تتجاوز 250
Dialogue: 0,0:05:34.13,0:05:35.88,Default,,0000,0000,0000,,!ناكاجيما
Dialogue: 0,0:05:35.88,0:05:37.84,Default,,0000,0000,0000,,هلّا جربتِ هذه؟
Dialogue: 0,0:05:37.84,0:05:38.75,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:05:41.54,0:05:43.80,Default,,0000,0000,0000,,يبدو أنّ ناكاجيما-سان سيجرّب
Dialogue: 0,0:05:48.06,0:05:52.23,Default,,0000,0000,0000,,مُذهل! أكنت تتمرّن على شيء في الماضي؟
Dialogue: 0,0:05:52.23,0:05:54.47,Default,,0000,0000,0000,,مارست القليل من الملاكمة في أيام الجامعة
Dialogue: 0,0:05:55.23,0:05:57.28,Default,,0000,0000,0000,,ما رأيك بأن تجرّبي يا ران-سان؟
Dialogue: 0,0:05:57.28,0:05:58.98,Default,,0000,0000,0000,,...كلا، لا داعي
Dialogue: 0,0:05:58.98,0:06:00.93,Default,,0000,0000,0000,,هذا مُفيد في التخلّص من التوتر
Dialogue: 0,0:06:01.56,0:06:02.45,Default,,0000,0000,0000,,التوتر؟
Dialogue: 0,0:06:05.39,0:06:08.64,Default,,0000,0000,0000,,!ارجع بسرعة يا شينتشي
Dialogue: 0,0:06:13.21,0:06:14.77,Default,,0000,0000,0000,,تريد أن تجرّب يا كونان-كن؟
Dialogue: 0,0:06:14.77,0:06:16.92,Default,,0000,0000,0000,,!عليّ الذهاب لدورة المياه
Dialogue: 0,0:06:16.92,0:06:18.60,Default,,0000,0000,0000,,لنذهب معاً إذاً يا فتى
Dialogue: 0,0:06:18.60,0:06:20.17,Default,,0000,0000,0000,,...أظنّ دورة المياه كانت
Dialogue: 0,0:06:25.37,0:06:27.31,Default,,0000,0000,0000,,!رجل عملاق
Dialogue: 0,0:06:31.24,0:06:33.57,Default,,0000,0000,0000,,أيعمل في شركة ألعاب أيضاً؟
Dialogue: 0,0:06:33.57,0:06:35.26,Default,,0000,0000,0000,,لا أدري، لم يسبق ورأيته
Dialogue: 0,0:06:36.15,0:06:40.40,Default,,0000,0000,0000,,كنتم الثلاثة في نفس \Nنادي الملاكمة في الجامعة؟
Dialogue: 0,0:06:40.40,0:06:41.02,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:41.02,0:06:43.32,Default,,0000,0000,0000,,حتّى انسحب في منتصف الطريق بالطبع
Dialogue: 0,0:06:44.56,0:06:45.31,Default,,0000,0000,0000,,...أويدا
Dialogue: 0,0:06:45.73,0:06:49.02,Default,,0000,0000,0000,,من كان ليخطر له أنّنا\Nسنعمل جميعاً في نفس الشركة
Dialogue: 0,0:06:51.05,0:06:53.09,Default,,0000,0000,0000,,رقم 98
Dialogue: 0,0:06:54.97,0:06:58.22,Default,,0000,0000,0000,,هذا شعار شركة ناكاجيما-سان
Dialogue: 0,0:06:59.38,0:07:00.79,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:07:02.21,0:07:03.42,Default,,0000,0000,0000,,لكن هذا غريب
Dialogue: 0,0:07:03.42,0:07:07.55,Default,,0000,0000,0000,,يُفترض أن يرتدي دبّوس\Nربطة العنق إن كان أحد الموظّفين
Dialogue: 0,0:07:11.54,0:07:13.15,Default,,0000,0000,0000,,...بعيداً عن ذلك، عليّ أن أشتري
Dialogue: 0,0:07:13.15,0:07:17.20,Default,,0000,0000,0000,,عصير طماطم للعمّ كي يتجاوز أثر الشراب
Dialogue: 0,0:07:18.62,0:07:21.10,Default,,0000,0000,0000,,إنّها أنا، تيكيلا
Dialogue: 0,0:07:22.45,0:07:24.15,Default,,0000,0000,0000,,تمّت الصفقة
Dialogue: 0,0:07:24.15,0:07:25.52,Default,,0000,0000,0000,,لا تقلق يا فودكا
Dialogue: 0,0:07:27.28,0:07:29.19,Default,,0000,0000,0000,,انقل الأمر لجين
Dialogue: 0,0:07:31.48,0:07:34.86,Default,,0000,0000,0000,,!إنّه... أحد أفراد منظمة الرداء الأسود
Dialogue: 0,0:07:35.68,0:07:38.57,Default,,0000,0000,0000,,مجرّد صبيّ، أسقط عملاته
Dialogue: 0,0:07:38.98,0:07:40.44,Default,,0000,0000,0000,,!وجدتكم أخيراً
Dialogue: 0,0:07:41.76,0:07:44.63,Default,,0000,0000,0000,,هلّا حرّكت رجلك يا عمّ؟
Dialogue: 0,0:07:44.63,0:07:46.98,Default,,0000,0000,0000,,...لا أستطيع أخذ عملة العشر ينّات خاصتي
Dialogue: 0,0:07:47.47,0:07:49.12,Default,,0000,0000,0000,,!لا تلمسني أيّها الصبيّ العفن
Dialogue: 0,0:07:52.87,0:07:54.08,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:07:54.08,0:07:56.48,Default,,0000,0000,0000,,!ألصقتُ لاقطاً وقطعة إرسال تحت حذائه
Dialogue: 0,0:07:57.12,0:07:59.15,Default,,0000,0000,0000,,...سيقودني الآن
Dialogue: 0,0:07:59.91,0:08:01.14,Default,,0000,0000,0000,,...إليهما
Dialogue: 0,0:08:01.65,0:08:03.94,Default,,0000,0000,0000,,!جين وفودكا
Dialogue: 0,0:08:04.61,0:08:06.72,Default,,0000,0000,0000,,...ماذا؟ لا يفتح
Dialogue: 0,0:08:06.72,0:08:07.72,Default,,0000,0000,0000,,باب؟
Dialogue: 0,0:08:08.66,0:08:09.90,Default,,0000,0000,0000,,لحظة، مفتوحة بالفعل؟
Dialogue: 0,0:08:09.90,0:08:11.69,Default,,0000,0000,0000,,حجرة حمّام؟
Dialogue: 0,0:08:19.37,0:08:20.77,Default,,0000,0000,0000,,!انتظر! أيّها الفتى
Dialogue: 0,0:08:23.59,0:08:27.30,Default,,0000,0000,0000,,إنّه... الحذاء الذي كان\N!يرتديه الرجل العملاق
Dialogue: 0,0:08:27.30,0:08:29.15,Default,,0000,0000,0000,,!أصابه الانفجار
Dialogue: 0,0:08:29.76,0:08:31.29,Default,,0000,0000,0000,,!المكان خطر هنا يا فتى
Dialogue: 0,0:08:31.29,0:08:32.23,Default,,0000,0000,0000,,!اخرج بسرعة
Dialogue: 0,0:08:33.33,0:08:37.08,Default,,0000,0000,0000,,بعدما... بعدما أمسكتُ بخيط\N!يقودني لهما أخيراً
Dialogue: 0,0:08:37.08,0:08:38.62,Default,,0000,0000,0000,,!لمَ حصل هذا؟
Dialogue: 0,0:08:39.87,0:08:40.60,Default,,0000,0000,0000,,هجوم إرهابيّ؟
Dialogue: 0,0:08:41.20,0:08:44.41,Default,,0000,0000,0000,,أظنّ أنّه كانت هناك متفجرات مزروعة
Dialogue: 0,0:08:44.41,0:08:46.06,Default,,0000,0000,0000,,في الحمّام أو ما شابه
Dialogue: 0,0:08:47.11,0:08:48.91,Default,,0000,0000,0000,,جريمة قتل عشوائية إذاً؟
Dialogue: 0,0:08:48.91,0:08:50.45,Default,,0000,0000,0000,,الضحيّة شخص واحد فحسب
Dialogue: 0,0:08:50.45,0:08:52.31,Default,,0000,0000,0000,,أتعرفون من يكون؟
Dialogue: 0,0:08:52.31,0:08:54.02,Default,,0000,0000,0000,,...تبقّت أشلاء فحسب
Dialogue: 0,0:08:54.69,0:08:58.44,Default,,0000,0000,0000,,إذاً، أرأى أحدكم شخصاً مثيراً للشبهة؟
Dialogue: 0,0:08:58.69,0:08:59.96,Default,,0000,0000,0000,,...كـ-كلا
Dialogue: 0,0:08:59.96,0:09:01.39,Default,,0000,0000,0000,,لا أحد بالتحديد
Dialogue: 0,0:09:01.39,0:09:03.48,Default,,0000,0000,0000,,!أنا رأيت
Dialogue: 0,0:09:03.48,0:09:05.69,Default,,0000,0000,0000,,رأيت الشخص الذي مات
Dialogue: 0,0:09:05.69,0:09:07.73,Default,,0000,0000,0000,,!حـ-حقاً يا كونان-كن؟
Dialogue: 0,0:09:08.01,0:09:09.72,Default,,0000,0000,0000,,!كان رجلاً عملاقاً
Dialogue: 0,0:09:09.72,0:09:11.89,Default,,0000,0000,0000,,...ربما من منطقة كانساي
Dialogue: 0,0:09:12.38,0:09:15.38,Default,,0000,0000,0000,,!رأيته أيضاً يا ناكاجيما-سان
Dialogue: 0,0:09:15.38,0:09:18.48,Default,,0000,0000,0000,,الشخص العملاق بالرداء الأسود الذي\N!ارتطمنا به في الردهة
Dialogue: 0,0:09:20.56,0:09:21.44,Default,,0000,0000,0000,,...تقصد ذاك
Dialogue: 0,0:09:21.70,0:09:23.57,Default,,0000,0000,0000,,كيف عرفت أنّه من كانساي؟
Dialogue: 0,0:09:23.57,0:09:27.73,Default,,0000,0000,0000,,سمعتُ لكنته في الحمّام قبيل موته
Dialogue: 0,0:09:28.12,0:09:32.15,Default,,0000,0000,0000,,"ماذا؟ لا يفتح. لحظة، مفتوحة بالفعل؟"
Dialogue: 0,0:09:32.15,0:09:34.69,Default,,0000,0000,0000,,!كان يقصد حجرة حمّام بالتأكيد
Dialogue: 0,0:09:35.61,0:09:40.32,Default,,0000,0000,0000,,في تلك الحالة، لا بدّ أنّ المتفجرات\Nكانت قرب باب الحجرة
Dialogue: 0,0:09:40.51,0:09:42.89,Default,,0000,0000,0000,,المعذرة، أيمكنني الكلام؟
Dialogue: 0,0:09:42.89,0:09:44.46,Default,,0000,0000,0000,,!حـ-حضرة الرئيس
Dialogue: 0,0:09:44.46,0:09:45.01,Default,,0000,0000,0000,,الرئيس؟
Dialogue: 0,0:09:45.67,0:09:49.21,Default,,0000,0000,0000,,أجل، أنا رئيس مانتيندو، إيشيكاوا
Dialogue: 0,0:09:49.21,0:09:53.85,Default,,0000,0000,0000,,تلقّيتُ رسالةً غريبة قبل 3 أيام
Dialogue: 0,0:09:53.85,0:09:56.20,Default,,0000,0000,0000,,رسالة غريبة؟
Dialogue: 0,0:09:57.16,0:09:59.14,Default,,0000,0000,0000,,!إ-إنّها رسالة تهديد
Dialogue: 0,0:09:57.16,0:09:59.14,On Top,,0000,0000,0000,,قم بإلغاء العرض"\N"وإلّا ستلقى الجزاء
Dialogue: 0,0:09:59.83,0:10:03.36,Default,,0000,0000,0000,,!لمَ لم تتصل بالشرطة عند تلقيك لها؟
Dialogue: 0,0:10:03.36,0:10:07.31,Default,,0000,0000,0000,,آسف، ظننتُها مجرّد مضايقة عاديّة
Dialogue: 0,0:10:07.82,0:10:10.93,Default,,0000,0000,0000,,حضرة المفتّش، وجدنا هذه في الحطام
Dialogue: 0,0:10:11.81,0:10:15.22,Default,,0000,0000,0000,,أفهم المفتاح، لكن ما هذا الشيء المستدير؟
Dialogue: 0,0:10:15.22,0:10:18.02,Default,,0000,0000,0000,,إنّه شعار شركتي
Dialogue: 0,0:10:18.81,0:10:22.51,Default,,0000,0000,0000,,بالمناسبة، كان يحمل ذاك الرجل العملاق حقيبة كهذه
Dialogue: 0,0:10:23.13,0:10:26.13,Default,,0000,0000,0000,,لكن لمَ ذلك؟
Dialogue: 0,0:10:26.13,0:10:27.97,Default,,0000,0000,0000,,...أخذها من مكتب إيداع الحقائب، لكن
Dialogue: 0,0:10:28.34,0:10:32.43,Default,,0000,0000,0000,,!يا للقوّة الهائلة، ثنت قطعة حديدة كهذه
Dialogue: 0,0:10:32.75,0:10:34.12,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:34.12,0:10:35.95,Default,,0000,0000,0000,,!هناك أمرٌ غريب بهذا الشعار
Dialogue: 0,0:10:35.95,0:10:38.66,Default,,0000,0000,0000,,لمَ مثنيّ باتّجاه معاكس للحقيبة؟
Dialogue: 0,0:10:38.66,0:10:40.99,Default,,0000,0000,0000,,...إذا وقع الانفجار خارج الحقيبة
Dialogue: 0,0:10:40.99,0:10:42.59,Default,,0000,0000,0000,,!يُفترض أنّه ثُني للداخل
Dialogue: 0,0:10:43.15,0:10:45.86,Default,,0000,0000,0000,,!لم يكن هذا هجوماً إرهابياً! بل جريمة قتل
Dialogue: 0,0:10:45.86,0:10:47.97,Default,,0000,0000,0000,,كان هناك من يستهدف\N!موت ذاك الرجل
Dialogue: 0,0:10:48.32,0:10:51.84,Default,,0000,0000,0000,,أجل، المُفجّر هو الشخص\Nالذي أعطاه تلك الحقيبة
Dialogue: 0,0:10:52.43,0:10:54.89,Default,,0000,0000,0000,,...يُفترض أنّ الصفقة جرت هناك
Dialogue: 0,0:10:54.89,0:10:57.68,Default,,0000,0000,0000,,أفضل مكان للمقايضة دون إثارة الشبهة
Dialogue: 0,0:10:57.68,0:10:59.48,Default,,0000,0000,0000,,!بتبديل بطاقات الأرقام
Dialogue: 0,0:10:59.48,0:11:00.39,Default,,0000,0000,0000,,!مكتب الإيداع
Dialogue: 0,0:11:01.80,0:11:07.47,Default,,0000,0000,0000,,كلا، لم يطلب أحد أمتعته\Nباستثناء ذاك الرجل العملاق
Dialogue: 0,0:11:08.01,0:11:12.08,Default,,0000,0000,0000,,ما يعني أنّ الشخص الآخر\N!لم يأت لأخذ حقيبته بعد
Dialogue: 0,0:11:12.08,0:11:12.59,Default,,0000,0000,0000,,حسنٌ
Dialogue: 0,0:11:13.33,0:11:18.97,Default,,0000,0000,0000,,لم تختف تماماً... الدلائل التي\N!تقودني لجين وفودكا، الرجلان بالرداء الأسود
Dialogue: 0,0:11:20.08,0:11:22.07,Default,,0000,0000,0000,,أين تذهب؟
Dialogue: 0,0:11:22.07,0:11:23.85,Default,,0000,0000,0000,,!عليّ رؤية المفتّش
Dialogue: 0,0:11:24.16,0:11:26.47,Default,,0000,0000,0000,,لا يمكن، إنّه مشغول الآن
Dialogue: 0,0:11:26.47,0:11:29.27,Default,,0000,0000,0000,,!دعني! علينا الإسراع وإلّا سيفلت الفاعل
Dialogue: 0,0:11:29.78,0:11:30.88,Default,,0000,0000,0000,,...عندها سيتحقق
Dialogue: 0,0:11:31.60,0:11:33.27,Default,,0000,0000,0000,,...ران-نيتشان
Dialogue: 0,0:11:33.27,0:11:35.94,Default,,0000,0000,0000,,!أين كنت؟
Dialogue: 0,0:11:35.94,0:11:37.60,Default,,0000,0000,0000,,...أنت مصاب
Dialogue: 0,0:11:37.60,0:11:39.27,Default,,0000,0000,0000,,ماذا حصل؟
Dialogue: 0,0:11:42.59,0:11:44.63,Default,,0000,0000,0000,,...مئة وستّ وتسعون
Dialogue: 0,0:11:44.63,0:11:47.97,Default,,0000,0000,0000,,إنّها بطاقات أرقام حقائبنا
Dialogue: 0,0:11:47.97,0:11:51.26,Default,,0000,0000,0000,,مئة لي، وستّ وتسعون لأبي
Dialogue: 0,0:11:51.71,0:11:54.85,Default,,0000,0000,0000,,لا يزال متوعكاً، لذا أحتفظ ببطاقته
Dialogue: 0,0:11:56.21,0:11:58.82,Default,,0000,0000,0000,,...وفقما أذكر، كان رقم بطاقة ذاك الرجل
Dialogue: 0,0:12:00.04,0:12:02.72,Default,,0000,0000,0000,,رقم 98
Dialogue: 0,0:12:02.99,0:12:05.36,Default,,0000,0000,0000,,ما يعني أنّ طرف الصفقة الآخر
Dialogue: 0,0:12:05.36,0:12:07.70,Default,,0000,0000,0000,,دخل بين العمّ وران
Dialogue: 0,0:12:07.70,0:12:09.23,Default,,0000,0000,0000,,!أحد أولئك الثلاثة
Dialogue: 0,0:12:09.74,0:12:13.68,Default,,0000,0000,0000,,بادل ذاك الرجل العملاق البطاقة، وتمّت الصفقة
Dialogue: 0,0:12:13.68,0:12:17.85,Default,,0000,0000,0000,,...وعندما فتح الحقيبة لتفقّد محتواها
Dialogue: 0,0:12:20.02,0:12:21.18,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:12:21.18,0:12:23.72,Default,,0000,0000,0000,,إن كان هدفه قتل الرجل العملاق من البداية
Dialogue: 0,0:12:23.72,0:12:27.31,Default,,0000,0000,0000,,لمَ اختار القاتل أن يعقد\Nالصفقة في مكان كهذا؟
Dialogue: 0,0:12:27.89,0:12:30.54,Default,,0000,0000,0000,,...إذا وقعت حادثة في معرض إعلان شركتك
Dialogue: 0,0:12:30.54,0:12:33.50,Default,,0000,0000,0000,,قد تقع في الشبهة إلم تكون حذراً
Dialogue: 0,0:12:33.50,0:12:37.31,Default,,0000,0000,0000,,...كان يعلم أنّ الرجل العملاق سيتفقد الحقيبة
Dialogue: 0,0:12:37.71,0:12:41.51,Default,,0000,0000,0000,,كما عدم مطابقة المفتاح للحقيبة تحيّرني
Dialogue: 0,0:12:42.70,0:12:46.47,Default,,0000,0000,0000,,!لحظة... أيمكن أنّي ارتكبتُ خطأً كبيراً؟
Dialogue: 0,0:12:46.99,0:12:48.87,Default,,0000,0000,0000,,رقم 38
Dialogue: 0,0:12:48.87,0:12:50.98,Default,,0000,0000,0000,,رقم 56
Dialogue: 0,0:12:52.40,0:12:55.86,Default,,0000,0000,0000,,يبدو أنّ لا أحد يعرف\Nمن كان الرجل العملاق
Dialogue: 0,0:12:55.86,0:12:59.64,Default,,0000,0000,0000,,أجل، ولم ير أحد شخصاً\Nمثيراً للشبهة أيضاً
Dialogue: 0,0:13:00.31,0:13:02.97,Default,,0000,0000,0000,,رقم 99، صحيح؟
Dialogue: 0,0:13:02.97,0:13:03.60,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:13:04.05,0:13:06.17,Default,,0000,0000,0000,,رقم 97
Dialogue: 0,0:13:06.17,0:13:06.97,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:13:07.39,0:13:09.60,Default,,0000,0000,0000,,رقم 124
Dialogue: 0,0:13:09.60,0:13:10.92,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:13:12.17,0:13:13.13,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:13:13.13,0:13:14.93,Default,,0000,0000,0000,,كلا، لا شيء
Dialogue: 0,0:13:15.38,0:13:18.34,Default,,0000,0000,0000,,يجدر بكما التحقّق من حقيبتيكما أيضاً
Dialogue: 0,0:13:18.34,0:13:20.59,Default,,0000,0000,0000,,فجميعها تبدو متشابهة
Dialogue: 0,0:13:20.99,0:13:22.58,Default,,0000,0000,0000,,كلا، لا داعي
Dialogue: 0,0:13:22.58,0:13:24.30,Default,,0000,0000,0000,,فلا شيء مهم في الداخل
Dialogue: 0,0:13:24.62,0:13:27.88,Default,,0000,0000,0000,,...لحظة! أيمكن، أيمكن
Dialogue: 0,0:13:28.17,0:13:31.09,Default,,0000,0000,0000,,!فهمت! هكذا كان الأمر
Dialogue: 0,0:13:31.61,0:13:35.23,Default,,0000,0000,0000,,!كانت هذه جريمة غير متوقّعة بالنسبة للقاتل
Dialogue: 0,0:13:40.53,0:13:41.98,Default,,0000,0000,0000,,حسناً يا جماعة
Dialogue: 0,0:13:42.28,0:13:44.81,Default,,0000,0000,0000,,يمكنكم الرجوع لليوم
Dialogue: 0,0:13:44.81,0:13:46.27,Default,,0000,0000,0000,,لكن إذا تذكّر أحدكم رؤية
Dialogue: 0,0:13:46.27,0:13:48.85,Default,,0000,0000,0000,,شخص مثير للشبهة\Nيمكن أنّه كان المُفجّر
Dialogue: 0,0:13:48.85,0:13:51.40,Default,,0000,0000,0000,,اتّصلوا بي في مركز الشرطة رجاءً
Dialogue: 0,0:13:51.40,0:13:52.60,Default,,0000,0000,0000,,هذا سيّئ
Dialogue: 0,0:13:52.60,0:13:56.44,Default,,0000,0000,0000,,إذا غادر الجميع الآن فلن نعرف\N!من كان الفاعل أبداً
Dialogue: 0,0:13:57.26,0:13:58.63,Default,,0000,0000,0000,,...تبّاً
Dialogue: 0,0:13:58.63,0:14:00.97,Default,,0000,0000,0000,,...لديّ فكرة عن المُفجّر
Dialogue: 0,0:14:00.97,0:14:02.76,Default,,0000,0000,0000,,!لكنّي لست متيقناً بعد
Dialogue: 0,0:14:02.76,0:14:03.76,Default,,0000,0000,0000,,لا خيار أمامي
Dialogue: 0,0:14:03.76,0:14:05.39,Default,,0000,0000,0000,,عليّ استعمال صوت وجسد العمّ
Dialogue: 0,0:14:05.75,0:14:07.35,Default,,0000,0000,0000,,!ونصب فخّ للفاعل
Dialogue: 0,0:14:09.54,0:14:10.69,Default,,0000,0000,0000,,!أصبت مؤخرة ران
Dialogue: 0,0:14:11.42,0:14:13.42,Default,,0000,0000,0000,,أأنت بخير يا أبي؟
Dialogue: 0,0:14:13.42,0:14:17.65,Default,,0000,0000,0000,,لا تزالين تملكين بطاقة رقمي؟
Dialogue: 0,0:14:18.45,0:14:20.98,Default,,0000,0000,0000,,لمَ لم يصب ران النعاس؟
Dialogue: 0,0:14:21.57,0:14:24.65,Default,,0000,0000,0000,,لا تقلق، إنّها هنا في جيبي
Dialogue: 0,0:14:24.65,0:14:27.23,Default,,0000,0000,0000,,...أصبت البطاقة إذاً
Dialogue: 0,0:14:27.73,0:14:30.19,Default,,0000,0000,0000,,!لكن لديّ سهم واحد منوّم الآن
Dialogue: 0,0:14:30.52,0:14:32.75,Default,,0000,0000,0000,,لنأخذ أغراضنا ونرجع بسرعة
Dialogue: 0,0:14:33.40,0:14:34.39,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:14:36.06,0:14:36.90,Default,,0000,0000,0000,,!ماذا تفعل أيّها المنحرف
Dialogue: 0,0:14:40.05,0:14:41.55,Default,,0000,0000,0000,,أكان ذلك أنت يا كونان-كن؟
Dialogue: 0,0:14:41.55,0:14:45.38,Default,,0000,0000,0000,,...كـ-كانت قمامة! التصق بعضها بمؤخرتك
Dialogue: 0,0:14:45.38,0:14:48.52,Default,,0000,0000,0000,,...عليك إنزال ساقك الآن
Dialogue: 0,0:14:49.50,0:14:50.73,Default,,0000,0000,0000,,!أ-أبي
Dialogue: 0,0:14:51.92,0:14:53.58,Default,,0000,0000,0000,,أأنت بخير يا أبي؟
Dialogue: 0,0:14:53.58,0:14:54.98,Default,,0000,0000,0000,,أنا بخير يا ران
Dialogue: 0,0:14:55.41,0:14:57.41,Default,,0000,0000,0000,,ساعدتِني في إدراك شيء
Dialogue: 0,0:14:57.41,0:14:58.65,Default,,0000,0000,0000,,إدراك شيء؟
Dialogue: 0,0:14:58.65,0:15:01.24,Default,,0000,0000,0000,,مفتّش ميغوري
Dialogue: 0,0:15:01.24,0:15:04.35,Default,,0000,0000,0000,,لا يمكنك ترك الزوّار يغادرون بعد
Dialogue: 0,0:15:04.81,0:15:06.27,Default,,0000,0000,0000,,!لا تكن سخيفاً
Dialogue: 0,0:15:06.27,0:15:08.52,Default,,0000,0000,0000,,!نحن نتعامل مع مُفجّر عشوائي
Dialogue: 0,0:15:08.52,0:15:11.07,Default,,0000,0000,0000,,!هناك احتمال بوجود المزيد من القنابل
Dialogue: 0,0:15:11.07,0:15:13.27,Default,,0000,0000,0000,,مُفجّر عشوائي؟
Dialogue: 0,0:15:13.27,0:15:17.52,Default,,0000,0000,0000,,لم تكن هناك أيّ قنابل مزروعة\Nفي هذا الفندق من البداية
Dialogue: 0,0:15:17.52,0:15:21.01,Default,,0000,0000,0000,,وُضعت تلك القنبلة في أمتعة ذاك الرجل
Dialogue: 0,0:15:21.01,0:15:23.44,Default,,0000,0000,0000,,لقتله تحديداً
Dialogue: 0,0:15:23.84,0:15:26.17,Default,,0000,0000,0000,,أتنوي حقّاً السماح لهم بالمغادرة
Dialogue: 0,0:15:26.17,0:15:29.96,Default,,0000,0000,0000,,مع أنّ القاتل بينهم؟
Dialogue: 0,0:15:29.96,0:15:32.65,Default,,0000,0000,0000,,!ماذا؟ عرفت هويّته؟
Dialogue: 0,0:15:33.29,0:15:37.16,Default,,0000,0000,0000,,إذا تفقدنا محتويات شيءٍ ما
Dialogue: 0,0:15:37.16,0:15:39.86,Default,,0000,0000,0000,,سيعترف الفاعل بارتكابه للجريمة
Dialogue: 0,0:15:40.41,0:15:41.74,Default,,0000,0000,0000,,محتويات شيء ما؟
Dialogue: 0,0:15:41.74,0:15:42.86,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:15:43.24,0:15:44.36,Default,,0000,0000,0000,,ناكاجيما-سان
Dialogue: 0,0:15:44.36,0:15:50.07,Default,,0000,0000,0000,,محتويات الحقيبة التي تتمسك بها\Nبكلّ اهتمام لفترة
Dialogue: 0,0:15:50.77,0:15:52.94,Default,,0000,0000,0000,,دعنا نتفقّد ما داخلها
Dialogue: 0,0:15:52.94,0:15:54.27,Default,,0000,0000,0000,,!لا-لا يمكنكم
Dialogue: 0,0:15:54.85,0:15:57.51,Default,,0000,0000,0000,,!أحمق! أتريد أن تبدو القاتل؟
Dialogue: 0,0:15:57.51,0:15:58.34,Default,,0000,0000,0000,,!أرهم
Dialogue: 0,0:15:58.34,0:15:59.11,Default,,0000,0000,0000,,!د-دعني
Dialogue: 0,0:15:59.60,0:16:00.52,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:16:02.64,0:16:04.31,Default,,0000,0000,0000,,!تـ-تاكيشيتا
Dialogue: 0,0:16:07.75,0:16:09.88,Default,,0000,0000,0000,,لا شكّ الآن
Dialogue: 0,0:16:09.88,0:16:12.90,Default,,0000,0000,0000,,تاكيشيتا-سان، أنت المُفجّر
Dialogue: 0,0:16:13.42,0:16:15.35,Default,,0000,0000,0000,,كيف ذلك يا موري-كن؟
Dialogue: 0,0:16:16.12,0:16:20.58,Default,,0000,0000,0000,,لأنّه ظنّ أن القنبلة التي\Nوضعها في الحقيبة ستنفجر
Dialogue: 0,0:16:20.58,0:16:22.32,Default,,0000,0000,0000,,قـ-قنبلة داخل الحقيبة؟
Dialogue: 0,0:16:22.70,0:16:23.78,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:23.78,0:16:27.11,Default,,0000,0000,0000,,شعار الحقيبة التي وجدناه\Nفي مسرح الجريمة
Dialogue: 0,0:16:27.11,0:16:30.28,Default,,0000,0000,0000,,كان مثنياً للخارج
Dialogue: 0,0:16:30.28,0:16:34.31,Default,,0000,0000,0000,,أي أنّه تلقى صدمة من الداخل
Dialogue: 0,0:16:34.31,0:16:37.52,Default,,0000,0000,0000,,فالقنبلة كانت داخل الحقيبة
Dialogue: 0,0:16:38.06,0:16:41.31,Default,,0000,0000,0000,,...لحظة، عندما قال الرجل العملاق إذاً
Dialogue: 0,0:16:41.31,0:16:45.56,Default,,0000,0000,0000,,..."ماذا؟ لا يفتح. لحظة، مفتوحة بالفعل؟"
Dialogue: 0,0:16:45.88,0:16:47.59,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:47.59,0:16:50.26,Default,,0000,0000,0000,,ما كان المفتاح ليفتح الحقيبة
Dialogue: 0,0:16:50.26,0:16:52.78,Default,,0000,0000,0000,,وقد كان غطاء الحقيبة ما كان مفتوحاً
Dialogue: 0,0:16:53.05,0:16:56.85,Default,,0000,0000,0000,,أي أنّه أعطى الحقيبة المفخّخة للرجل العملاق؟
Dialogue: 0,0:16:57.20,0:16:59.08,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:16:59.08,0:17:03.04,Default,,0000,0000,0000,,الشخص الذي أعطى الرجل العملاق الحقيبة\N...ومن عقد صفقةً معه
Dialogue: 0,0:17:03.04,0:17:04.77,Default,,0000,0000,0000,,!كانت أنت يا ناكاجيما-سان
Dialogue: 0,0:17:06.94,0:17:11.19,Default,,0000,0000,0000,,تمّت الصفقة بإيداع الحقيبتين مؤقتاً\Nفي مكتب الإيداع
Dialogue: 0,0:17:11.19,0:17:14.56,Default,,0000,0000,0000,,ثمّ تبادل بطاقات الأرقام لاحقاً
Dialogue: 0,0:17:14.56,0:17:15.85,Default,,0000,0000,0000,,ودليلاً على ذلك
Dialogue: 0,0:17:15.85,0:17:19.23,Default,,0000,0000,0000,,كان رقم بطاقتي 96، وبطاقة ابنتي ران 100
Dialogue: 0,0:17:19.23,0:17:23.23,Default,,0000,0000,0000,,دخل أويدا-سان وناكاجيما-سان وتاكيشيتا-سان
Dialogue: 0,0:17:23.23,0:17:25.05,Default,,0000,0000,0000,,الثلاثة بيننا
Dialogue: 0,0:17:25.05,0:17:31.82,Default,,0000,0000,0000,,فمن الطبيعيّ أن تكون أرقام بطاقاتهم\Nهي 97 و98 و99
Dialogue: 0,0:17:31.82,0:17:32.88,Default,,0000,0000,0000,,لكن لسببٍ ما
Dialogue: 0,0:17:32.88,0:17:34.82,Default,,0000,0000,0000,,عندما ذهب ناكاجيما-سان لاستلام حقيبته
Dialogue: 0,0:17:34.82,0:17:36.21,Default,,0000,0000,0000,,...كان رقم بطاقته
Dialogue: 0,0:17:36.21,0:17:38.27,Default,,0000,0000,0000,,هو 124
Dialogue: 0,0:17:38.27,0:17:41.83,Default,,0000,0000,0000,,ثمّ رقم بطاقة الرجل العملاق\N...الذي سمعه كونان
Dialogue: 0,0:17:41.83,0:17:43.73,Default,,0000,0000,0000,,هو 98
Dialogue: 0,0:17:44.24,0:17:46.53,Default,,0000,0000,0000,,تمّ تبادل البطاقتين
Dialogue: 0,0:17:46.53,0:17:50.19,Default,,0000,0000,0000,,عندما ارتطم ناكاجيما-سان مع كونان\Nبالرجل العملاق لاحقاً
Dialogue: 0,0:17:50.78,0:17:53.69,Default,,0000,0000,0000,,أخذ الرجل حقيبة ناكاجيما-سان من مكتب الإيداع
Dialogue: 0,0:17:53.69,0:17:56.23,Default,,0000,0000,0000,,...وذهب لتفقّد محتواها في دورة المياه، وعندها
Dialogue: 0,0:17:58.69,0:18:02.11,Default,,0000,0000,0000,,لـ-لكن لمَ لم يدخل المفتاح؟
Dialogue: 0,0:18:02.89,0:18:04.68,Default,,0000,0000,0000,,لا عجب
Dialogue: 0,0:18:04.68,0:18:09.88,Default,,0000,0000,0000,,فتاكيشيتا-سان قد بدّل الحقيبتين سلفاً
Dialogue: 0,0:18:09.88,0:18:11.17,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:11.17,0:18:15.21,Default,,0000,0000,0000,,لأنّ تاكيشيتا-سان خطّط بالحقيبة المفخّخة
Dialogue: 0,0:18:15.21,0:18:16.57,Default,,0000,0000,0000,,أن يقتل ناكاجيما-سان
Dialogue: 0,0:18:17.21,0:18:17.98,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:18:18.63,0:18:20.95,Default,,0000,0000,0000,,استبدلت البطاقتين عندما جعلت
Dialogue: 0,0:18:20.95,0:18:25.37,Default,,0000,0000,0000,,ناكاجيما-سان يلعب لعبة الملاكمة غالباً
Dialogue: 0,0:18:25.37,0:18:30.03,Default,,0000,0000,0000,,،لكن عندما أراد تاكيشيتا-سان إيداع الحقيبة المفخخة
Dialogue: 0,0:18:30.03,0:18:32.78,Default,,0000,0000,0000,,ظهرت مشكلة مزعجة
Dialogue: 0,0:18:32.78,0:18:35.69,Default,,0000,0000,0000,,كان رقم بطاقتي 96
Dialogue: 0,0:18:35.69,0:18:37.19,Default,,0000,0000,0000,,كان ناكاجيما-سان قريباً ورائي
Dialogue: 0,0:18:37.19,0:18:39.93,Default,,0000,0000,0000,,فكان مؤكداً أنّ رقمه\Nسيكون في التسعينات أيضاً
Dialogue: 0,0:18:39.93,0:18:43.93,Default,,0000,0000,0000,,لكنّ تاكيشيتا-سان لم يدخل الصفّ بعدها وقتها
Dialogue: 0,0:18:43.93,0:18:45.89,Default,,0000,0000,0000,,فكان رقمه سيكون في المئات
Dialogue: 0,0:18:45.89,0:18:49.17,Default,,0000,0000,0000,,كان الاحتمال كبيراً أن يلاحظ ناكاجيما-سان لاحقاً
Dialogue: 0,0:18:49.17,0:18:51.10,Default,,0000,0000,0000,,إذا بدّل رقميهما لاحقاً
Dialogue: 0,0:18:51.10,0:18:55.48,Default,,0000,0000,0000,,لذا قطع تاكيشيتا-سان\N...الصفّ بيني وران
Dialogue: 0,0:18:55.88,0:18:59.45,Default,,0000,0000,0000,,كي يكون رقم بطاقته في التسعينات
Dialogue: 0,0:18:59.45,0:19:01.19,Default,,0000,0000,0000,,مثل ناكاجيما-سان
Dialogue: 0,0:19:01.54,0:19:03.83,Default,,0000,0000,0000,,لكن أهناك دليل؟
Dialogue: 0,0:19:03.83,0:19:05.04,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:19:05.04,0:19:07.29,Default,,0000,0000,0000,,الحقيبة التي يحملها تاكيشيتا-سان الآن
Dialogue: 0,0:19:07.29,0:19:10.89,Default,,0000,0000,0000,,هي التي كان يُفترض أن يسلّمها\N ناكاجيما-سان للرجل العملاق
Dialogue: 0,0:19:11.69,0:19:14.44,Default,,0000,0000,0000,,المفتاح الذي وجدناه في مسرح الانفجار
Dialogue: 0,0:19:14.44,0:19:16.86,Default,,0000,0000,0000,,سيدخل بلا مشاكل
Dialogue: 0,0:19:17.49,0:19:22.14,Default,,0000,0000,0000,,كما ما انفجر كانت حقيبة أصلية\Nتابعة لشركة مانتيندو
Dialogue: 0,0:19:22.14,0:19:25.31,Default,,0000,0000,0000,,يُفترض أن يكون الأمر جليّاً\Nبعد تفتيش كلّ الحقائب
Dialogue: 0,0:19:25.31,0:19:27.77,Default,,0000,0000,0000,,التي تخصّ موظّفي مانتيندو هنا اليوم
Dialogue: 0,0:19:27.77,0:19:30.85,Default,,0000,0000,0000,,سيتّضح أن حقيبة تاكيشيتا-سان\Nهي الوحيدة المفقودة
Dialogue: 0,0:19:31.63,0:19:36.82,Default,,0000,0000,0000,,فقد تفجّرت لأشلاء سلفاً
Dialogue: 0,0:19:38.09,0:19:44.12,Default,,0000,0000,0000,,من كان ليتصوّر أن الانفجار\Nمن القنبلة التي جهّزتُها أنا
Dialogue: 0,0:19:44.12,0:19:45.79,Default,,0000,0000,0000,,أرسلتُ رسالة تهديد حتّى
Dialogue: 0,0:19:45.79,0:19:47.87,Default,,0000,0000,0000,,كي أجعله يبدو عملاً إرهابياً
Dialogue: 0,0:19:47.87,0:19:49.28,Default,,0000,0000,0000,,...لكن كيف انقلبت الأمور
Dialogue: 0,0:19:49.28,0:19:50.48,Default,,0000,0000,0000,,!تاكيشيتا
Dialogue: 0,0:19:50.95,0:19:54.86,Default,,0000,0000,0000,,!صحيح! كان يُفترض أن تكون أنت من يموت
Dialogue: 0,0:19:54.86,0:19:57.11,Default,,0000,0000,0000,,!قتلتَ يوشيمي
Dialogue: 0,0:19:57.78,0:19:59.23,Default,,0000,0000,0000,,يوشيمي؟
Dialogue: 0,0:19:59.23,0:20:04.06,Default,,0000,0000,0000,,مديرة فريق الملاكمة\Nمن أيامنا في الجامعة
Dialogue: 0,0:20:04.06,0:20:06.52,Default,,0000,0000,0000,,أقدمت على الانتحار بعدما هجرها ناكاجيما
Dialogue: 0,0:20:06.52,0:20:07.32,Default,,0000,0000,0000,,الانتحار؟
Dialogue: 0,0:20:07.77,0:20:09.88,Default,,0000,0000,0000,,كانت يوشيمي تواعد تاكيشيتا
Dialogue: 0,0:20:09.88,0:20:11.88,Default,,0000,0000,0000,,منذ المرحلة الإعدادية
Dialogue: 0,0:20:11.88,0:20:13.11,Default,,0000,0000,0000,,...لذا قام غالباً
Dialogue: 0,0:20:13.11,0:20:16.19,Default,,0000,0000,0000,,!دعوني! أنا بريء! هو الفاعل
Dialogue: 0,0:20:14.13,0:20:15.10,Default,,0000,0000,0000,,...بما فعل
Dialogue: 0,0:20:16.55,0:20:20.48,Default,,0000,0000,0000,,بالكاد تفاديت مقتلك يا ناكاجيما-سان
Dialogue: 0,0:20:21.62,0:20:24.40,Default,,0000,0000,0000,,هلّا انتقلنا للمشكلة الرئيسية؟
Dialogue: 0,0:20:25.42,0:20:29.20,Default,,0000,0000,0000,,الرجل بالرداء الأسود الذي\Nعقدت صفقة معه
Dialogue: 0,0:20:29.20,0:20:31.85,Default,,0000,0000,0000,,من كان بالضبط؟
Dialogue: 0,0:20:32.16,0:20:33.56,Default,,0000,0000,0000,,...فـ-في الواقع
Dialogue: 0,0:20:33.99,0:20:36.45,Default,,0000,0000,0000,,...أفسدتَ الصفقة
Dialogue: 0,0:20:36.45,0:20:38.98,Default,,0000,0000,0000,,فستلاحقك منظمتهم بنهاية المطاف
Dialogue: 0,0:20:38.98,0:20:40.06,Default,,0000,0000,0000,,منظمتهم؟
Dialogue: 0,0:20:40.06,0:20:43.86,Default,,0000,0000,0000,,الخيار الحكيم هو الإفصاح لنا عن كلّ شيء
Dialogue: 0,0:20:43.86,0:20:46.40,Default,,0000,0000,0000,,وطلب حماية الشرطة
Dialogue: 0,0:20:46.40,0:20:48.65,Default,,0000,0000,0000,,!لا-لا أعرف شيئاً حقاً
Dialogue: 0,0:20:49.22,0:20:52.93,Default,,0000,0000,0000,,فقط أنّ المكان الذي ألتقيهم فيه\Nكان نفسه دوماً
Dialogue: 0,0:20:52.93,0:20:57.40,Default,,0000,0000,0000,,...حانة تُدعى "كوكتيل" في الطابق الأعلى لبناية دايكوكو
Dialogue: 0,0:20:57.97,0:20:59.48,Default,,0000,0000,0000,,كوكتيل" في بناية دايكوكو؟"
Dialogue: 0,0:21:00.42,0:21:03.54,Default,,0000,0000,0000,,!موري-كن! أيّ منظمة تقصد؟
Dialogue: 0,0:21:03.54,0:21:04.30,Default,,0000,0000,0000,,!أخبرني
Dialogue: 0,0:21:07.73,0:21:12.32,CharCard,,0000,0000,0010,,{\fad(300,0)}بناية دايكوكو
Dialogue: 0,0:21:18.37,0:21:19.89,Default,,0000,0000,0000,,!هذا المكان إذاً
Dialogue: 0,0:21:20.23,0:21:20.97,Default,,0000,0000,0000,,!وصلت
Dialogue: 0,0:21:21.91,0:21:23.31,Default,,0000,0000,0000,,!وصلت! وصلت
Dialogue: 0,0:21:24.19,0:21:25.57,Default,,0000,0000,0000,,وجدتهم أخيراً
Dialogue: 0,0:21:26.62,0:21:28.07,Default,,0000,0000,0000,,!وصلت هنا
Dialogue: 0,0:21:36.01,0:21:36.82,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:21:39.59,0:21:40.88,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:21:40.88,0:21:41.77,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:21:43.29,0:21:45.19,Default,,0000,0000,0000,,!كلا يا صبيّ! ابتعد من هنا
Dialogue: 0,0:21:45.19,0:21:47.65,Default,,0000,0000,0000,,!دعني! لستُ صبيّاً
Dialogue: 0,0:21:47.65,0:21:48.79,Default,,0000,0000,0000,,...أنا... أنا
Dialogue: 0,0:21:48.79,0:21:49.99,Default,,0000,0000,0000,,!دعني
Dialogue: 0,0:23:17.65,0:23:20.06,Default,,0000,0000,0000,,وفق تحقيقات الشرطة لاحقاً
Dialogue: 0,0:23:20.06,0:23:22.14,Default,,0000,0000,0000,,كانت كميّة المتفجرات المستعملة هائلة
Dialogue: 0,0:23:22.14,0:23:24.60,Default,,0000,0000,0000,,ونُسفت الحانة بالكامل
Dialogue: 0,0:23:24.60,0:23:27.73,Default,,0000,0000,0000,,لم تكن هناك طريقة لمعرفة\Nما إن كان هناك أحد في الداخل
Dialogue: 0,0:23:29.38,0:23:30.89,Default,,0000,0000,0000,,كلّ ما اكتشفتُه هذه المرّة
Dialogue: 0,0:23:30.89,0:23:33.68,Default,,0000,0000,0000,,أنّ الرجال بالرداء الأسود كانوا يحاولون شراء
Dialogue: 0,0:23:33.68,0:23:37.05,Default,,0000,0000,0000,,لائحة لنخبة مُبرمجي العالم
Dialogue: 0,0:23:37.05,0:23:40.26,Default,,0000,0000,0000,,قام بتسريبها ناكاجيما-سان من الشركة
Dialogue: 0,0:23:42.92,0:23:44.92,Default,,0000,0000,0000,,هل مات جين وفودكا؟
Dialogue: 0,0:23:44.92,0:23:47.64,Default,,0000,0000,0000,,أم اختفيا بنفسيهما؟
Dialogue: 0,0:23:48.46,0:23:50.28,Default,,0000,0000,0000,,يبقى كلّ شيء لغزاً
Dialogue: 0,0:23:50.28,0:23:52.49,Default,,0000,0000,0000,,كما غطّى الدخان السماء
Dialogue: 0,0:23:52.49,0:23:54.78,Default,,0000,0000,0000,,غطّى الظلام القضيّة
Dialogue: 0,0:24:04.60,0:24:07.15,Default,,0000,0000,0000,,انتبه يا عمّ، يكاد زرّك أن يسقط
Dialogue: 0,0:24:09.22,0:24:10.89,Default,,0000,0000,0000,,!لم تكن حادثة أو انتحاراً
Dialogue: 0,0:24:10.89,0:24:14.05,Default,,0000,0000,0000,,!بل جريمة! جريمة قتل
Dialogue: 0,0:24:14.05,0:24:14.68,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:24:15.22,0:24:17.23,Default,,0000,0000,0000,,!إنّك عقبة! اخرج
Dialogue: 0,0:24:17.89,0:24:23.71,Default,,0000,0000,0000,,!فهمتها الآن! حيلة القطار للطبيب داتي
Dialogue: 0,0:24:24.03,0:24:30.02,On Top,,0000,0000,15,,جريمة قتل حيلة القطار
Dialogue: 0,0:24:24.96,0:24:26.17,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.17,0:24:28.53,Default,,0000,0000,0000,,جريمة قتل حيلة القطار
Dialogue: 0,0:24:45.25,0:24:47.59,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.59,0:24:50.06,Default,,0000,0000,0000,,مبيعات عربة طعام
Dialogue: 0,0:24:50.27,0:24:52.08,Default,,0000,0000,0000,,الحلقة القادمة تحوي\N!استنتاجات جادة مجدّداً
Dialogue: 0,0:24:52.08,0:24:55.00,Default,,0000,0000,0000,,أيريد أحد علبة طعام أم شاي أم ساندوتش؟

