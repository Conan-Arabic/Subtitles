Dialogue: 0,0:00:01.79,0:00:04.64,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:05.07,0:00:07.28,Default,,0000,0000,0000,,!مسرح اليوم هو نادي رياضة
Dialogue: 0,0:00:07.28,0:00:08.89,Default,,0000,0000,0000,,!لنمرّن أجسادنا وأذهاننا
Dialogue: 0,0:00:09.37,0:00:10.95,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.95,0:00:13.07,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.27,0:00:15.68,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:46.10,0:01:52.19,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل نادي الرياضة
Dialogue: 0,0:01:46.96,0:01:49.52,Default,,0000,0000,0000,,جريمة قتل نادي الرياضة
Dialogue: 0,0:01:56.74,0:02:00.12,Default,,0000,0000,0000,,بعد فوزنا في إحدى السحوبات، تمّت دعوتنا
Dialogue: 0,0:02:00.62,0:02:04.78,Default,,0000,0000,0000,,لصالة رياضية في اليوم السابق\Nلإعادة افتتاحها العظيم
Dialogue: 0,0:02:07.86,0:02:09.36,Default,,0000,0000,0000,,...لا-لا أستطيع الاستمرار
Dialogue: 0,0:02:09.36,0:02:11.33,Default,,0000,0000,0000,,أنا مُرهق... التحرّك مستحيل
Dialogue: 0,0:02:11.33,0:02:12.98,Default,,0000,0000,0000,,هذا بائس
Dialogue: 0,0:02:12.98,0:02:16.22,Default,,0000,0000,0000,,نال منك الخمر وقلّة التمرين يا أبي
Dialogue: 0,0:02:16.22,0:02:17.18,Default,,0000,0000,0000,,!حمقاء
Dialogue: 0,0:02:17.18,0:02:20.08,Default,,0000,0000,0000,,!يقاتل المتحرّيون من أعناقهم فأعلى
Dialogue: 0,0:02:20.52,0:02:23.09,Default,,0000,0000,0000,,من العنق فأسفل في حالتك
Dialogue: 0,0:02:26.09,0:02:29.84,On Top,,0000,0000,0000,,كانت التجديدات جلّ أمل نادينا الرياضي
Dialogue: 0,0:02:26.81,0:02:35.45,CharCard,,0000,0000,0005,,{\fad(300,0)}سايكي ريكو\Nمالكة النادي الرياضي
Dialogue: 0,0:02:29.84,0:02:32.38,On Top,,0000,0000,0000,,بصفتي غطّاسة ارتفاعات سابقة
Dialogue: 0,0:02:32.38,0:02:35.45,On Top,,0000,0000,0000,,أعي عظمة الرياضات جيّداً
Dialogue: 0,0:02:35.70,0:02:41.12,On Top,,0000,0000,0000,,لذا تمنّيتُ مساعدة الآخرين\Nفي اكتساب اللياقة وتحسين صحّتهم
Dialogue: 0,0:02:41.83,0:02:43.78,Default,,0000,0000,0000,,اسمع يا كونان-كن
Dialogue: 0,0:02:43.78,0:02:46.57,Default,,0000,0000,0000,,لنترك أبي ونذهب لرؤية المسبح
Dialogue: 0,0:02:46.90,0:02:47.66,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:55.93,0:02:58.43,Default,,0000,0000,0000,,الحائط الزجاجي جميل جدّاً
Dialogue: 0,0:02:58.43,0:03:00.54,Default,,0000,0000,0000,,!يقومون بغوص مرتفع هناك
Dialogue: 0,0:03:10.42,0:03:14.33,Default,,0000,0000,0000,,إنّه غطّاس ارتفاعات من هذا النادي
Dialogue: 0,0:03:14.33,0:03:17.16,Default,,0000,0000,0000,,أظنّ اسمه كان سايجو-سان
Dialogue: 0,0:03:19.62,0:03:22.50,CharCard,,0000,0000,0005,,{\fad(300,0)}سايجو ناويا\Nغطّاس ارتفاع
Dialogue: 0,0:03:22.96,0:03:25.45,Default,,0000,0000,0000,,!دورك يا ناروسي! لا تخفق
Dialogue: 0,0:03:31.32,0:03:32.49,Default,,0000,0000,0000,,!ما كان ذلك؟
Dialogue: 0,0:03:32.49,0:03:36.56,Default,,0000,0000,0000,,!وتريد أن تكون قائداً يا ناروسي؟
Dialogue: 0,0:03:38.60,0:03:41.66,CharCard,,0000,0000,0005,,{\fad(300,0)}غطّاس ارتفاع\Nناروسي كييتشي
Dialogue: 0,0:03:39.35,0:03:43.45,On Top,,0000,0000,0000,,لم أتمّرن بما يكفي مع تحضيرات الافتتاح مؤخراً
Dialogue: 0,0:03:43.76,0:03:46.55,Default,,0000,0000,0000,,أهذا السبب الوحيد لعدم تمرّنك حقاً؟
Dialogue: 0,0:03:46.55,0:03:47.91,Default,,0000,0000,0000,,!ما قصدك؟
Dialogue: 0,0:03:48.26,0:03:51.13,Default,,0000,0000,0000,,...أيّاً يكن، بقفزك ذاك
Dialogue: 0,0:03:51.13,0:03:53.61,Default,,0000,0000,0000,,نتيجة المسابقة واضحة لي
Dialogue: 0,0:03:53.61,0:03:55.45,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:03:55.71,0:03:56.96,Default,,0000,0000,0000,,توقّفا
Dialogue: 0,0:03:56.96,0:03:59.58,Default,,0000,0000,0000,,!يوجد ناس! الإعلام أيضاً
Dialogue: 0,0:04:00.04,0:04:03.28,Default,,0000,0000,0000,,أيجدر بك التصرّف بتعالٍ حقّاً يا كيجيما؟
Dialogue: 0,0:04:03.39,0:04:06.57,On Top,,0000,0000,0000,,لا-لا أحاول التصرّف بتعالٍ
Dialogue: 0,0:04:04.21,0:04:06.68,CharCard,,0000,0000,0005,,{\fad(300,0)}سبّاح\Nكيجيما هيساشي
Dialogue: 0,0:04:07.45,0:04:09.11,Default,,0000,0000,0000,,...مع أقراطك السخيفة هذه
Dialogue: 0,0:04:09.11,0:04:13.90,Default,,0000,0000,0000,,أتظن أنّك ملائم لتأمر الآخرين حقّاً؟
Dialogue: 0,0:04:13.90,0:04:16.23,Default,,0000,0000,0000,,!ناروسي! لنرجع للتمرين
Dialogue: 0,0:04:19.90,0:04:24.15,Default,,0000,0000,0000,,،أظنّ ذاك الشخص كيجيما-سان\Nخصم سايجو-سان السابق
Dialogue: 0,0:04:24.93,0:04:27.55,Default,,0000,0000,0000,,أخذ سايجو-سان مكانه قائداً للفريق
Dialogue: 0,0:04:27.55,0:04:29.95,Default,,0000,0000,0000,,فانتقل للسباحة التنافسية
Dialogue: 0,0:04:30.43,0:04:36.25,Default,,0000,0000,0000,,هذا مسبح الغوص المرتفع\Nوالسباحة التنافسية الذي نفخر به
Dialogue: 0,0:04:36.25,0:04:39.37,Default,,0000,0000,0000,,لاعبونا يتمرنون بينما نتكلم
Dialogue: 0,0:04:45.57,0:04:46.66,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,0:04:59.40,0:05:02.66,Default,,0000,0000,0000,,!أعرف أنّ المسابقة تقترب، لكن لا تبالغ يا سايجو-كن
Dialogue: 0,0:05:03.01,0:05:04.89,Default,,0000,0000,0000,,!فأنت نجمنا
Dialogue: 0,0:05:04.89,0:05:06.45,Default,,0000,0000,0000,,أشكّ في ذلك
Dialogue: 0,0:05:06.93,0:05:10.37,Default,,0000,0000,0000,,فملامحك تقول "من المؤسف أنّه نجا" يا سيّدتي المالكة
Dialogue: 0,0:05:11.89,0:05:15.84,Default,,0000,0000,0000,,تحبّ المزاح حقاً يا سايجو-كن
Dialogue: 0,0:05:15.84,0:05:17.57,Default,,0000,0000,0000,,ليس بقدرك
Dialogue: 0,0:05:28.74,0:05:30.87,Default,,0000,0000,0000,,!أنت وضيع
Dialogue: 0,0:05:31.70,0:05:33.44,Default,,0000,0000,0000,,...أعرف أنّك تريد قول
Dialogue: 0,0:05:33.44,0:05:36.52,Default,,0000,0000,0000,,أنّ إعادة الافتتاح ستفشل لو تسرّبت مجرد إشاعة
Dialogue: 0,0:05:36.52,0:05:39.79,Default,,0000,0000,0000,,!للإعلام أو مكتب الضرائب
Dialogue: 0,0:05:39.79,0:05:40.95,Default,,0000,0000,0000,,مكتب الضرائب؟
Dialogue: 0,0:05:41.27,0:05:42.35,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:05:44.60,0:05:46.41,Default,,0000,0000,0000,,ماذا تفعل هنا؟
Dialogue: 0,0:05:46.76,0:05:48.87,Default,,0000,0000,0000,,...أنا
Dialogue: 0,0:05:49.93,0:05:51.51,Default,,0000,0000,0000,,سايجو-كن
Dialogue: 0,0:05:51.51,0:05:54.17,Default,,0000,0000,0000,,سنُقيم حفلة إتمام العمل\Nفي مكتبي عند الثامنة
Dialogue: 0,0:05:54.17,0:05:55.07,Default,,0000,0000,0000,,لا تنسَ
Dialogue: 0,0:06:02.41,0:06:05.41,Default,,0000,0000,0000,,حسناً، لعلّي سأتمرن مزيداً
Dialogue: 0,0:06:12.20,0:06:16.66,Default,,0000,0000,0000,,...صورة كاميرا خفيّة؟ الرجل هو ناروسي ذاك
Dialogue: 0,0:06:16.94,0:06:18.74,Default,,0000,0000,0000,,!أسقطت شيئاً
Dialogue: 0,0:06:19.23,0:06:20.90,Default,,0000,0000,0000,,سقطت هذه
Dialogue: 0,0:06:20.90,0:06:24.72,Default,,0000,0000,0000,,آسف، أرتدي سدّادات أُذن عند التمرين دوماً
Dialogue: 0,0:06:25.81,0:06:27.43,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:06:27.43,0:06:28.89,Default,,0000,0000,0000,,هذه تذكرتي المالية
Dialogue: 0,0:06:30.89,0:06:32.26,Default,,0000,0000,0000,,تذكرته المالية؟
Dialogue: 0,0:06:58.79,0:06:59.33,Default,,0000,0000,0000,,!هاك
Dialogue: 0,0:07:00.94,0:07:02.79,Default,,0000,0000,0000,,...مؤلم
Dialogue: 0,0:07:03.52,0:07:05.89,Default,,0000,0000,0000,,أنت جلبت ذلك على نفسك
Dialogue: 0,0:07:05.89,0:07:09.20,Default,,0000,0000,0000,,عليك اكتساب لياقة بدل التدخين والشرب دوماً
Dialogue: 0,0:07:09.56,0:07:12.95,Default,,0000,0000,0000,,صحيح، فهي وحدها ما تتميّز به
Dialogue: 0,0:07:14.30,0:07:16.42,Default,,0000,0000,0000,,لكن كان ذاك النادي رائعاً
Dialogue: 0,0:07:16.42,0:07:19.16,Default,,0000,0000,0000,,علينا الانضمام، صحيح يا كونان-كن؟
Dialogue: 0,0:07:19.16,0:07:21.17,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:21.17,0:07:22.50,Default,,0000,0000,0000,,أبي
Dialogue: 0,0:07:26.05,0:07:28.12,Default,,0000,0000,0000,,!يوجد اتّصال على آلة الرد
Dialogue: 0,0:07:28.12,0:07:29.87,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:07:29.87,0:07:32.75,Default,,0000,0000,0000,,لنرَ، أهو متعلّق بالعمل؟
Dialogue: 0,0:07:33.36,0:07:34.70,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:07:35.61,0:07:38.61,Default,,0000,0000,0000,,موري-كن، إنّه أنا ميغوري
Dialogue: 0,0:07:38.61,0:07:39.66,Default,,0000,0000,0000,,حضرة المفتش؟
Dialogue: 0,0:07:39.95,0:07:43.07,Default,,0000,0000,0000,,اعذرني، لكن هلّا أتيت لنادي سايكي للرياضة فوراً؟
Dialogue: 0,0:07:43.52,0:07:45.35,Default,,0000,0000,0000,,مع ران-كن وكونان-كن
Dialogue: 0,0:07:45.35,0:07:48.20,Default,,0000,0000,0000,,،وجدنا جثّة أحد المعلّمين، سايجو ناويا-سان
Dialogue: 0,0:07:48.20,0:07:49.66,Default,,0000,0000,0000,,في المسبح
Dialogue: 0,0:07:51.39,0:07:52.58,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:08:00.09,0:08:01.54,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:08:02.90,0:08:04.49,Default,,0000,0000,0000,,!أتيت يا موري-كن
Dialogue: 0,0:08:04.79,0:08:08.45,Default,,0000,0000,0000,,نعتذر على التأخير، ما الوضع إذاً؟
Dialogue: 0,0:08:08.83,0:08:11.46,Default,,0000,0000,0000,,كما ترى
Dialogue: 0,0:08:11.46,0:08:13.36,Default,,0000,0000,0000,,علينا انتظار نتائج التشريح
Dialogue: 0,0:08:13.36,0:08:15.20,Default,,0000,0000,0000,,لكن وقت الوفاة المقدّر
Dialogue: 0,0:08:15.20,0:08:18.45,Default,,0000,0000,0000,,هو بين الثامنة والتاسعة مساءً
Dialogue: 0,0:08:18.45,0:08:19.45,Default,,0000,0000,0000,,...سبب الوفاة
Dialogue: 0,0:08:19.45,0:08:20.91,Default,,0000,0000,0000,,الغرق، صحيح؟
Dialogue: 0,0:08:20.91,0:08:23.92,Default,,0000,0000,0000,,مجرد دخولك الماء سابقاً
Dialogue: 0,0:08:23.92,0:08:25.45,Default,,0000,0000,0000,,لا يجعلك خبيراً
Dialogue: 0,0:08:25.45,0:08:28.12,Default,,0000,0000,0000,,معه كلّ الحقّ
Dialogue: 0,0:08:28.48,0:08:32.62,Default,,0000,0000,0000,,فحالة الجثّة تشير لموتها غرقاً
Dialogue: 0,0:08:33.05,0:08:36.12,Default,,0000,0000,0000,,أترون الرغوة من أنفه وفمه؟
Dialogue: 0,0:08:36.12,0:08:39.03,Default,,0000,0000,0000,,كما دم قليل من أذنيه
Dialogue: 0,0:08:39.55,0:08:41.18,Default,,0000,0000,0000,,سبّب الماء في فمه وأنفه
Dialogue: 0,0:08:41.18,0:08:44.29,Default,,0000,0000,0000,,ضغطاً على أذنيه الداخليتين
Dialogue: 0,0:08:44.29,0:08:46.46,Default,,0000,0000,0000,,هذه من خصائص الغرق، صحيح؟
Dialogue: 0,0:08:46.46,0:08:48.74,Default,,0000,0000,0000,,أ-أجل، لكن كيف عرفت؟
Dialogue: 0,0:08:48.74,0:08:54.91,Default,,0000,0000,0000,,ماذا؟ أظنّ رأيتُ ذلك على برنامج\Nإثارة في التلفزيون سابقاً
Dialogue: 0,0:08:56.57,0:09:02.16,Default,,0000,0000,0000,,...لكنه كان سبّاحاً محترفاً، حتّى لو قفز من ارتفاع
Dialogue: 0,0:09:02.16,0:09:03.78,Default,,0000,0000,0000,,يصعب اعتقاد أنّه غرق
Dialogue: 0,0:09:03.98,0:09:06.70,Default,,0000,0000,0000,,ماذا؟ هل ارتطمت جبهته بشيء؟
Dialogue: 0,0:09:06.98,0:09:09.16,Default,,0000,0000,0000,,!انظروا، يوجد أُثر على غطاء رأسه
Dialogue: 0,0:09:14.80,0:09:20.27,Default,,0000,0000,0000,,تماماً، يبدو أنّه ارتكب خطأً\Nأثناء تمرينه في الغوص المرتفع
Dialogue: 0,0:09:24.09,0:09:27.04,Default,,0000,0000,0000,,سمعتُ أنّه كان تمريناً خطيراً
Dialogue: 0,0:09:27.04,0:09:31.42,Default,,0000,0000,0000,,طلبتُ قدومكم لأنّكم رأيتموه\Nيتمرن ظهيرة اليوم
Dialogue: 0,0:09:31.42,0:09:33.08,Default,,0000,0000,0000,,وأردت شهادتكم
Dialogue: 0,0:09:33.08,0:09:37.08,Default,,0000,0000,0000,,نجا بأعجوبة في تلك المرّة
Dialogue: 0,0:09:37.08,0:09:39.83,Default,,0000,0000,0000,,لكن يبدو أنّه أخفق تماماً هذه المرة
Dialogue: 0,0:09:40.83,0:09:43.41,Default,,0000,0000,0000,,ألم يكن هناك أحد معه؟
Dialogue: 0,0:09:43.41,0:09:46.16,Default,,0000,0000,0000,,أكان سايجو-سان يتمرّن بمفرده؟
Dialogue: 0,0:09:46.16,0:09:48.87,Default,,0000,0000,0000,,!أنت! اخرس للحظة
Dialogue: 0,0:09:48.87,0:09:49.58,Default,,0000,0000,0000,,إذاً؟
Dialogue: 0,0:09:49.91,0:09:50.91,Default,,0000,0000,0000,,أنا متأكدة
Dialogue: 0,0:09:50.91,0:09:53.40,Default,,0000,0000,0000,,أنهى البقيّة تحضيراتهم للغد
Dialogue: 0,0:09:53.40,0:09:55.77,Default,,0000,0000,0000,,وكانوا في المكتب الخلفي
Dialogue: 0,0:09:55.77,0:09:58.52,Default,,0000,0000,0000,,في حفلة إتمام عمل عند الثامنة
Dialogue: 0,0:09:58.52,0:10:00.56,Default,,0000,0000,0000,,هناك مسابقة تقترب
Dialogue: 0,0:10:00.56,0:10:03.76,Default,,0000,0000,0000,,لذا تمرّن سايجو-سان متى استطاع
Dialogue: 0,0:10:03.76,0:10:05.00,Default,,0000,0000,0000,,الليلة أيضاً غالباً
Dialogue: 0,0:10:05.30,0:10:08.46,Default,,0000,0000,0000,,لدينا شاهد أيضاً، فلا شكّ بالأمر
Dialogue: 0,0:10:08.46,0:10:09.75,Default,,0000,0000,0000,,شاهد؟
Dialogue: 0,0:10:11.01,0:10:15.16,Default,,0000,0000,0000,,أجل، قال رجل مُسنّ يعيش\Nعلى الطابق الثاني في الشقة المقابلة
Dialogue: 0,0:10:15.46,0:10:20.13,Default,,0000,0000,0000,,أنّه رأى شخصاً يتمرن على غوص مرتفع بمفرده
Dialogue: 0,0:10:20.13,0:10:22.46,Default,,0000,0000,0000,,لكنّه لم يرَ الحادثة نفسها، صحيح؟
Dialogue: 0,0:10:22.74,0:10:25.62,Default,,0000,0000,0000,,...حـ-حسناً، كلا، لكن
Dialogue: 0,0:10:25.62,0:10:26.29,Default,,0000,0000,0000,,!اخرس
Dialogue: 0,0:10:28.95,0:10:34.20,Default,,0000,0000,0000,,بالمناسبة، أظنّ سايجو-سان كان يرتدي\Nسدّادات أذن دوماً عند تمرينه
Dialogue: 0,0:10:34.20,0:10:38.19,Default,,0000,0000,0000,,أجل، خلعها المحللون قبل قليل
Dialogue: 0,0:10:41.77,0:10:42.99,Default,,0000,0000,0000,,ها هي
Dialogue: 0,0:10:43.31,0:10:45.41,Default,,0000,0000,0000,,كان يرتدي سدّادات مختلفة ظهيرة اليوم
Dialogue: 0,0:10:47.68,0:10:49.35,Default,,0000,0000,0000,,بدّلها غالباً
Dialogue: 0,0:10:49.35,0:10:52.56,Default,,0000,0000,0000,,لا غريب في هذا
Dialogue: 0,0:10:52.56,0:10:53.95,Default,,0000,0000,0000,,ماذا عن غطاء رأسه إذاً؟
Dialogue: 0,0:10:54.21,0:10:56.38,Default,,0000,0000,0000,,ما بشأنه يا كونان-كن؟
Dialogue: 0,0:10:56.38,0:10:59.92,Default,,0000,0000,0000,,لا يرتدي غطّاسو الارتفاع\Nأغطية رأس عادةً، أليس كذلك؟
Dialogue: 0,0:10:59.92,0:11:03.20,Default,,0000,0000,0000,,وما في ذلك؟ التغيير بين الحين والآخر طبيعي
Dialogue: 0,0:11:03.20,0:11:05.41,Default,,0000,0000,0000,,!كفّ عن التدقيق على كلّ شيء
Dialogue: 0,0:11:08.16,0:11:09.48,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:11:09.48,0:11:10.79,Default,,0000,0000,0000,,دعيه
Dialogue: 0,0:11:15.44,0:11:18.67,Default,,0000,0000,0000,,أكانت خزانة سايجو-سان مقفلة؟
Dialogue: 0,0:11:19.28,0:11:23.14,Default,,0000,0000,0000,,...ماذا؟ كلا، كانت مفتوحة\Nلكن من أنت يا صبيّ؟
Dialogue: 0,0:11:23.14,0:11:25.93,Default,,0000,0000,0000,,إنّه الفتى الذي يقيم مع المتحرّي موري
Dialogue: 0,0:11:25.93,0:11:27.93,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:11:27.93,0:11:29.17,Default,,0000,0000,0000,,ما هذه الرائحة؟
Dialogue: 0,0:11:32.47,0:11:35.01,Default,,0000,0000,0000,,!هذا كلوروفورم
Dialogue: 0,0:11:35.01,0:11:38.21,Default,,0000,0000,0000,,!لا شكّ في الأمر! كانت هذه جريمة قتل
Dialogue: 0,0:11:39.33,0:11:41.80,Default,,0000,0000,0000,,هناك بضعة تفاصيل مشوشة
Dialogue: 0,0:11:41.80,0:11:46.00,Default,,0000,0000,0000,,لكن يبدو أنّها كانت حادثة
Dialogue: 0,0:11:46.25,0:11:48.29,Default,,0000,0000,0000,,!ماذا؟! لا تمازحني
Dialogue: 0,0:11:48.29,0:11:50.88,Default,,0000,0000,0000,,!هذه جريمة قتل بكلّ وضوح
Dialogue: 0,0:11:51.29,0:11:53.44,Default,,0000,0000,0000,,شكراً لقدومك يا موري-كن
Dialogue: 0,0:11:53.44,0:11:56.54,Default,,0000,0000,0000,,أبداً، يسرّني المساعدة حضرة المفتش
Dialogue: 0,0:11:56.99,0:11:58.28,Default,,0000,0000,0000,,مهلاً
Dialogue: 0,0:11:58.28,0:12:00.79,Default,,0000,0000,0000,,هل سنغادر هكذا؟
Dialogue: 0,0:12:01.19,0:12:06.21,Default,,0000,0000,0000,,المعذرة، لن يؤثر هذا\Nعلى إعادة افتتاحنا غداً، صحيح؟
Dialogue: 0,0:12:06.21,0:12:11.10,Default,,0000,0000,0000,,حسناً... يُفترض أن تنتهي إجراءات الشرطة الليلة
Dialogue: 0,0:12:11.10,0:12:12.17,Default,,0000,0000,0000,,فلا مشكلة غالباً
Dialogue: 0,0:12:14.92,0:12:16.67,Default,,0000,0000,0000,,أسمعتم جميعاً؟
Dialogue: 0,0:12:16.67,0:12:18.42,Default,,0000,0000,0000,,ما حلّ بسايجو-كن كان فظيعاً
Dialogue: 0,0:12:18.42,0:12:20.29,Default,,0000,0000,0000,,لكنّها كانت حادثة مؤسفة
Dialogue: 0,0:12:21.09,0:12:23.21,Default,,0000,0000,0000,,سنُعيد الافتتاح غداً كما المُخطط
Dialogue: 0,0:12:23.21,0:12:25.16,Default,,0000,0000,0000,,...أجروا تفقّداتكم الأخيرة من باب الحيطة
Dialogue: 0,0:12:25.16,0:12:27.00,Default,,0000,0000,0000,,!تبّاً! عليّ الإسراع
Dialogue: 0,0:12:29.54,0:12:33.90,Default,,0000,0000,0000,,وقعت الحادثة بعدما غادرنا
Dialogue: 0,0:12:33.90,0:12:36.37,Default,,0000,0000,0000,,سيكون من الصعب تسلّل دخيل
Dialogue: 0,0:12:36.70,0:12:41.80,Default,,0000,0000,0000,,لذا يُرجّح أن القاتل من الداخل
Dialogue: 0,0:12:46.64,0:12:47.83,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:12:49.14,0:12:50.17,Default,,0000,0000,0000,,ماذا يا فتى؟
Dialogue: 0,0:12:50.60,0:12:53.55,Default,,0000,0000,0000,,كانت حفلة إتمام العمل هنا، صحيح؟
Dialogue: 0,0:12:53.55,0:12:56.62,Default,,0000,0000,0000,,هل غادر أحد أثناءها؟
Dialogue: 0,0:12:56.84,0:12:57.93,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:12:57.93,0:12:59.88,Default,,0000,0000,0000,,لم ألحظ لو حصل ذلك
Dialogue: 0,0:12:59.88,0:13:02.09,Default,,0000,0000,0000,,فقد كانت حفلة حيوية
Dialogue: 0,0:13:02.46,0:13:03.79,Default,,0000,0000,0000,,!شكراً لكما
Dialogue: 0,0:13:04.71,0:13:08.54,Default,,0000,0000,0000,,أي أنّ التسلل خارجاً لم يكن مستحيلاً
Dialogue: 0,0:13:08.96,0:13:12.00,Default,,0000,0000,0000,,...الثلاثة الذين خاصموا سايجو-سان
Dialogue: 0,0:13:12.49,0:13:15.50,Default,,0000,0000,0000,,سايكي ريكو المُبتزة بتهربها من الضرائب
Dialogue: 0,0:13:16.11,0:13:18.96,Default,,0000,0000,0000,,وكيجيما هيساشي الذي فقد منصب القائد
Dialogue: 0,0:13:19.45,0:13:22.45,Default,,0000,0000,0000,,وناروسي كييتشي المُبتز بصورة العلاقة
Dialogue: 0,0:13:23.40,0:13:26.27,Default,,0000,0000,0000,,القاتل أحدهم بلا شكّ
Dialogue: 0,0:13:27.48,0:13:32.10,Default,,0000,0000,0000,,...المشكلة هي شهادة المُسن هناك
Dialogue: 0,0:13:32.10,0:13:34.93,Default,,0000,0000,0000,,...إنّها تعيق نظريتي لحدٍّ كبير
Dialogue: 0,0:13:37.14,0:13:39.09,Default,,0000,0000,0000,,لا أمامي سوى الذهاب له بنفسي
Dialogue: 0,0:13:46.96,0:13:48.92,Default,,0000,0000,0000,,ماذا يا فتى؟
Dialogue: 0,0:13:48.92,0:13:52.04,Default,,0000,0000,0000,,مرحباً، اسمي إيدوغاوا كونان
Dialogue: 0,0:13:52.04,0:13:56.29,Default,,0000,0000,0000,,أخبرني مُتحرٍّ بالذهاب لسماع قصتك
Dialogue: 0,0:13:57.24,0:13:59.24,Default,,0000,0000,0000,,قصتي؟
Dialogue: 0,0:14:05.15,0:14:07.12,Default,,0000,0000,0000,,!أنت رسّام
Dialogue: 0,0:14:08.27,0:14:10.46,Default,,0000,0000,0000,,مجرد هواية مُسن
Dialogue: 0,0:14:17.51,0:14:20.42,Default,,0000,0000,0000,,أرسمت هذه بناءً على ما رأيته من هنا؟
Dialogue: 0,0:14:21.30,0:14:22.75,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:14:22.75,0:14:27.37,Default,,0000,0000,0000,,الرسم في وقت محدّد يومياً هي الهواية\Nالتي تثير حماس المُسن يومياً
Dialogue: 0,0:14:28.04,0:14:29.21,Default,,0000,0000,0000,,وقت محدّد؟
Dialogue: 0,0:14:29.79,0:14:32.74,Default,,0000,0000,0000,,أجل، رسمتُ تلك اللوحة الليلة أيضاً
Dialogue: 0,0:14:32.74,0:14:34.45,Default,,0000,0000,0000,,كان اسمه سايجو-كن؟
Dialogue: 0,0:14:34.45,0:14:36.42,Default,,0000,0000,0000,,...يا للأسف
Dialogue: 0,0:14:37.12,0:14:38.78,Default,,0000,0000,0000,,،إطفاء الأنوار
Dialogue: 0,0:14:38.78,0:14:41.34,Default,,0000,0000,0000,,والتمرّن بتهوّر... هو من جلب ذلك على نفسه
Dialogue: 0,0:14:42.03,0:14:43.12,Default,,0000,0000,0000,,!أطفأ الأنوار؟
Dialogue: 0,0:14:43.40,0:14:48.11,Default,,0000,0000,0000,,أجل، شكّلت هيئة غوصه صورة ظلّية\Nمع القمر المكتمل وراءه
Dialogue: 0,0:14:48.11,0:14:51.80,Default,,0000,0000,0000,,لم ترَ وجه سايجو-سان بالتحديد الليلة إذاً؟
Dialogue: 0,0:14:52.35,0:14:55.26,Default,,0000,0000,0000,,...كلا، كان مشهداً بغاية الجمال
Dialogue: 0,0:14:55.26,0:14:58.85,Default,,0000,0000,0000,,تلألأ بشكل آخّاذ
Dialogue: 0,0:14:58.85,0:15:02.05,Default,,0000,0000,0000,,تراءت الصورة لي فرسمتُها فوراً
Dialogue: 0,0:15:02.05,0:15:05.00,Default,,0000,0000,0000,,"أطلق عليها "الغوص تحت ضوء القمر
Dialogue: 0,0:15:05.59,0:15:09.91,Default,,0000,0000,0000,,،جميل؟ لو ارتطم رأسه
Dialogue: 0,0:15:09.91,0:15:11.88,Default,,0000,0000,0000,,!كان ليفقد توازنه ويسقط
Dialogue: 0,0:15:15.91,0:15:21.50,Default,,0000,0000,0000,,!هذه... فهمت الآن! القاتل هو ذاك الشخص
Dialogue: 0,0:15:29.23,0:15:31.81,Default,,0000,0000,0000,,!أنت! أين كنت؟
Dialogue: 0,0:15:31.81,0:15:33.66,Default,,0000,0000,0000,,أقلقتنا يا كونان-كن
Dialogue: 0,0:15:34.10,0:15:35.08,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:15:35.08,0:15:37.54,Default,,0000,0000,0000,,!سأعاقبك! تعال
Dialogue: 0,0:15:38.04,0:15:39.81,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:15:40.85,0:15:42.78,Default,,0000,0000,0000,,!أنت! توقف
Dialogue: 0,0:15:42.78,0:15:44.41,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:16:00.16,0:16:01.38,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:16:01.66,0:16:02.95,Default,,0000,0000,0000,,!استسلم
Dialogue: 0,0:16:03.53,0:16:04.66,Default,,0000,0000,0000,,!آسف يا عمّ
Dialogue: 0,0:16:05.90,0:16:08.59,Default,,0000,0000,0000,,...إنّها مؤخرتي اليوم
Dialogue: 0,0:16:10.67,0:16:11.34,Default,,0000,0000,0000,,!هذا خطر
Dialogue: 0,0:16:14.25,0:16:17.75,Default,,0000,0000,0000,,!أأنتما بخير؟ أبي! كونان-كن
Dialogue: 0,0:16:17.75,0:16:20.92,Default,,0000,0000,0000,,ران، استدعي الجميع هنا فوراً
Dialogue: 0,0:16:25.92,0:16:28.08,Default,,0000,0000,0000,,ما الخطب يا موري-كن؟
Dialogue: 0,0:16:28.59,0:16:31.55,Default,,0000,0000,0000,,اكتشفت المسؤول عن هذه القضيّة
Dialogue: 0,0:16:31.97,0:16:32.97,Default,,0000,0000,0000,,المسؤول؟
Dialogue: 0,0:16:32.97,0:16:34.58,Default,,0000,0000,0000,,لم تكن حادثةً إذاً؟
Dialogue: 0,0:16:34.58,0:16:38.50,Default,,0000,0000,0000,,صحيح، كانت جريمة قتل زُيّفت لتبدو حادثة
Dialogue: 0,0:16:38.50,0:16:39.75,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:16:41.46,0:16:44.65,Default,,0000,0000,0000,,كانت سدّادات الأذن التي أشار لها\Nكونان-كن هي ما أثار شبهتي بدايةً
Dialogue: 0,0:16:44.65,0:16:47.12,Default,,0000,0000,0000,,كانت غلطةً من القاتل
Dialogue: 0,0:16:48.11,0:16:51.82,Default,,0000,0000,0000,,...بعد تنويمه سايجو-سان بمنديل مبتلّ بالكلوروفورم
Dialogue: 0,0:16:51.82,0:16:53.66,Default,,0000,0000,0000,,سدّ القاتل أُذنيه
Dialogue: 0,0:16:53.66,0:16:58.54,Default,,0000,0000,0000,,بسدّادات مختلفة عن سدّاداته المعتادة
Dialogue: 0,0:16:58.54,0:17:00.48,Default,,0000,0000,0000,,...كما غطاء الرأس
Dialogue: 0,0:17:00.48,0:17:01.69,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:17:01.69,0:17:04.30,Default,,0000,0000,0000,,...أكانت هناك آثار دم أو شعر
Dialogue: 0,0:17:04.30,0:17:05.87,Default,,0000,0000,0000,,أو علامة ارتطام على منصّة الغوص؟
Dialogue: 0,0:17:05.87,0:17:08.30,Default,,0000,0000,0000,,كلا، لا شيء من هذا
Dialogue: 0,0:17:08.30,0:17:11.88,Default,,0000,0000,0000,,!لحظة، أكان غطاء الرأس لخداعنا؟
Dialogue: 0,0:17:11.88,0:17:13.33,Default,,0000,0000,0000,,تماماً
Dialogue: 0,0:17:13.33,0:17:21.21,Default,,0000,0000,0000,,رُتّب كلّ هذا ليجعل الجريمة تبدو\Nحادثةً وقعت أثناء تمرين الغوص
Dialogue: 0,0:17:21.21,0:17:22.24,Default,,0000,0000,0000,,!يـ-يا للهول
Dialogue: 0,0:17:22.24,0:17:27.20,Default,,0000,0000,0000,,رمى القاتل بعدها ثياب سايجو-سان\Nالمخلوعة في خزانته
Dialogue: 0,0:17:27.20,0:17:29.71,Default,,0000,0000,0000,,!وغادر، دون قفلها
Dialogue: 0,0:17:30.16,0:17:34.85,Default,,0000,0000,0000,,!لكنّ ذلك مجرد دليل ظرفيّ يا موري-كن
Dialogue: 0,0:17:34.85,0:17:37.17,Default,,0000,0000,0000,,كما ماذا عن الشاهد؟
Dialogue: 0,0:17:37.60,0:17:41.69,Default,,0000,0000,0000,,في الواقع، لو كان ذاك الشاهد\Nينظر من الشرفة دوماً
Dialogue: 0,0:17:41.69,0:17:46.08,Default,,0000,0000,0000,,في وقت محدّد يومياً، فهذا يقلب الوضع
Dialogue: 0,0:17:46.39,0:17:49.19,Default,,0000,0000,0000,,ماذا؟ من الشرفة في وقت محدّد؟
Dialogue: 0,0:17:49.19,0:17:50.38,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:17:50.59,0:17:53.75,Default,,0000,0000,0000,,أي أنّ الشاهد لم يرَ بمحض الصدفة
Dialogue: 0,0:17:53.75,0:17:55.58,Default,,0000,0000,0000,,!بل جُهّز له أن يرى
Dialogue: 0,0:17:56.00,0:18:00.08,Default,,0000,0000,0000,,!ما-ماذا؟! جعله يرى موته؟
Dialogue: 0,0:18:00.08,0:18:01.67,Default,,0000,0000,0000,,!أتقصد أنّه انتحار؟
Dialogue: 0,0:18:01.67,0:18:07.04,Default,,0000,0000,0000,,لم تكن هناك حاجة لإطفاء الأنوار\Nوصنع صورة ظلّية في تلك الحالة
Dialogue: 0,0:18:07.70,0:18:08.91,Default,,0000,0000,0000,,أطفأ الأنوار؟
Dialogue: 0,0:18:08.91,0:18:10.00,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:18:10.99,0:18:13.48,Default,,0000,0000,0000,,...لم يرد أن يُكشف وجهه
Dialogue: 0,0:18:13.48,0:18:17.46,Default,,0000,0000,0000,,!فهمت! رأى الشاهد شخصاً مختلفاً
Dialogue: 0,0:18:17.69,0:18:23.87,Default,,0000,0000,0000,,!صحيح، وذاك الشخص كان قاتل سايجو-سان
Dialogue: 0,0:18:27.14,0:18:28.72,Default,,0000,0000,0000,,كيجيما هيساشي-سان
Dialogue: 0,0:18:28.72,0:18:34.33,Default,,0000,0000,0000,,كنت غطّاس ارتفاع، لكنك انتقلت للسباحة
Dialogue: 0,0:18:35.13,0:18:40.29,Default,,0000,0000,0000,,ربما حملت ضغينةً تّجاه سايجو-سان \Nلأخذه دور القائد منك؟
Dialogue: 0,0:18:40.84,0:18:43.91,Default,,0000,0000,0000,,السبّاحون التنافسيّون لا يسبحون\Nدون غطاء رأس، أليس كذلك؟
Dialogue: 0,0:18:43.91,0:18:50.25,Default,,0000,0000,0000,,وضع غطاء رأس لتفادي الشبهة حتى\N...لو لم تكن هناك آيّ آثار
Dialogue: 0,0:18:51.45,0:18:53.95,Default,,0000,0000,0000,,هذا أمرٌ لا يفكّر به سوى سبّاح تنافسيّ
Dialogue: 0,0:18:54.32,0:18:55.75,Default,,0000,0000,0000,,كان هو إذاً؟
Dialogue: 0,0:18:56.23,0:18:57.02,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:18:57.02,0:19:00.75,Default,,0000,0000,0000,,!قتل سايجو-سان وجعلها تبدو حادثة
Dialogue: 0,0:19:01.15,0:19:02.68,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:19:02.68,0:19:06.50,Default,,0000,0000,0000,,!ستتهمني بناءً على مجرد تخمين؟
Dialogue: 0,0:19:07.22,0:19:09.76,Default,,0000,0000,0000,,ما الدليل لديك؟
Dialogue: 0,0:19:09.76,0:19:10.96,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:19:11.18,0:19:16.92,Default,,0000,0000,0000,,توجد لوحة رسمها الشاهد\Nأسفل أدراج منصّة الغوص
Dialogue: 0,0:19:18.59,0:19:20.70,Default,,0000,0000,0000,,افتح الغطاء وتفقدها رجاءً
Dialogue: 0,0:19:26.62,0:19:28.00,Default,,0000,0000,0000,,...هـ-هذه اللوحة
Dialogue: 0,0:19:28.00,0:19:29.04,Default,,0000,0000,0000,,...سايجو-كن
Dialogue: 0,0:19:29.58,0:19:35.00,Default,,0000,0000,0000,,رُسمت أثناء مشاهدته تمرين\Nالغوص المرتفع الليلة
Dialogue: 0,0:19:35.28,0:19:37.46,Default,,0000,0000,0000,,أي... هذا هو القاتل؟
Dialogue: 0,0:19:37.94,0:19:39.48,Default,,0000,0000,0000,,أمعنوا النظر
Dialogue: 0,0:19:39.48,0:19:43.41,Default,,0000,0000,0000,,...بغض النظر عن إطفائه الأنوار للتباهي بغوصه
Dialogue: 0,0:19:43.85,0:19:48.06,Default,,0000,0000,0000,,كان هناك دليل دامغ تلألأ بضوء القمر
Dialogue: 0,0:19:48.06,0:19:51.71,Default,,0000,0000,0000,,رسم المُسن ذاك بإخلاص كما رآه تماماً
Dialogue: 0,0:19:52.05,0:19:53.31,Default,,0000,0000,0000,,...بإخلاص
Dialogue: 0,0:20:03.95,0:20:05.01,Default,,0000,0000,0000,,!أقراط أذن
Dialogue: 0,0:20:05.01,0:20:05.96,Default,,0000,0000,0000,,!لا-لا يمكن
Dialogue: 0,0:20:05.96,0:20:07.29,Default,,0000,0000,0000,,...شيءٌ آخر
Dialogue: 0,0:20:07.29,0:20:11.80,Default,,0000,0000,0000,,إذا كان القاتل من الداخل، فلم يغادر بعد
Dialogue: 0,0:20:12.94,0:20:19.69,Default,,0000,0000,0000,,ما يعني أنّ سلاح الجريمة مخفيّ \Nفي مكانٍ ما من المبنى حتماً
Dialogue: 0,0:20:22.85,0:20:27.71,Default,,0000,0000,0000,,لكن لمَ قد يقتله لأخذه منصب القائد فقط؟
Dialogue: 0,0:20:28.14,0:20:31.93,Default,,0000,0000,0000,,لم يكن الأمر حول المهارة غالباً
Dialogue: 0,0:20:31.93,0:20:34.33,Default,,0000,0000,0000,,قام بابتزازك، أليس كذلك؟
Dialogue: 0,0:20:35.22,0:20:38.26,Default,,0000,0000,0000,,...صـ-صحيح
Dialogue: 0,0:20:38.26,0:20:41.88,Default,,0000,0000,0000,,قبل نصف عام، تسبّبتُ بحادث مروري بدرّاجتي
Dialogue: 0,0:20:41.88,0:20:45.34,Default,,0000,0000,0000,,وعرّضتُ حبيبتي التي كانت ورائي لإصابات بليغة
Dialogue: 0,0:20:46.83,0:20:50.66,Default,,0000,0000,0000,,...لا أدري كيف اكتشف ذلك
Dialogue: 0,0:20:50.66,0:20:53.40,Default,,0000,0000,0000,,لكنّه هددني بإخبار المالكة ولجنة المسابقة
Dialogue: 0,0:20:53.40,0:20:58.29,Default,,0000,0000,0000,,فاستعملتُ حالتي الصحيّة عذراً\Nلإعطائه منصب القائد
Dialogue: 0,0:20:59.03,0:21:00.90,Default,,0000,0000,0000,,!لكنّي لم أستطع مسامحته
Dialogue: 0,0:21:00.90,0:21:03.98,Default,,0000,0000,0000,,!لم يكن رياضياً بحقّ
Dialogue: 0,0:21:03.98,0:21:05.46,Default,,0000,0000,0000,,...لم أسامحه
Dialogue: 0,0:21:08.31,0:21:13.16,Default,,0000,0000,0000,,يبدو أنّ غلطتك كانت الغوص المثاليّ فوق الحاجة
Dialogue: 0,0:21:13.80,0:21:17.80,Default,,0000,0000,0000,,كان عرضاً لا يتكرر في العمر لي
Dialogue: 0,0:21:17.80,0:21:19.05,Default,,0000,0000,0000,,أعرف أنّه كان عليّ السقوط
Dialogue: 0,0:21:19.05,0:21:23.16,Default,,0000,0000,0000,,لكن لم أستطع إخلال توازني عمداً
Dialogue: 0,0:21:23.16,0:21:25.87,Default,,0000,0000,0000,,...منعني كبريائي
Dialogue: 0,0:23:04.91,0:23:10.76,Default,,0000,0000,0000,,عُثر على قالب إسمنتيّ في حاوية قمامة المكتب لاحقاً
Dialogue: 0,0:23:10.76,0:23:15.40,Default,,0000,0000,0000,,طابقَ إصابة جبهة سايجو-سان بعد التحليل
Dialogue: 0,0:23:15.40,0:23:18.31,Default,,0000,0000,0000,,وُوجدت بصمات أصابع كيجيما عليه
Dialogue: 0,0:23:19.56,0:23:23.09,Default,,0000,0000,0000,,!أبي! أتسمعني يا أبي؟
Dialogue: 0,0:23:23.55,0:23:26.84,Default,,0000,0000,0000,,!تبّاً! نسيت أمره
Dialogue: 0,0:23:27.63,0:23:30.59,Default,,0000,0000,0000,,!أبي! علينا الرجوع
Dialogue: 0,0:23:34.17,0:23:38.01,Default,,0000,0000,0000,,!نمت جيّداً، وقوف
Dialogue: 0,0:23:45.16,0:23:48.26,Default,,0000,0000,0000,,!ما-ماذا أفعل هنا؟
Dialogue: 0,0:23:48.70,0:23:49.84,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:24:07.16,0:24:10.10,Default,,0000,0000,0000,,أنت ابن هاتّوري هيزو-سان إذاً
Dialogue: 0,0:24:10.10,0:24:13.38,Default,,0000,0000,0000,,!قائد شرطة أوساكا
Dialogue: 0,0:24:13.38,0:24:18.22,Default,,0000,0000,0000,,...فهمت, اكتشفتُ حيلة الغرفة المقفلة! كما
Dialogue: 0,0:24:21.42,0:24:23.92,Default,,0000,0000,0000,,كونان-كن! كونان-كن، ما الخطب؟
Dialogue: 0,0:24:24.18,0:24:25.91,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.91,0:24:29.16,Default,,0000,0000,0000,,(جريمة قتل الدبلوماسيّ (الجزء الأوّل
Dialogue: 0,0:24:45.75,0:24:47.67,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.67,0:24:50.02,Default,,0000,0000,0000,,إبرة وخيط وفتحة قفل
Dialogue: 0,0:24:50.57,0:24:52.39,Default,,0000,0000,0000,,!في الحلقة القادمة، يظهر مُنافس كونان
Dialogue: 0,0:24:52.39,0:24:53.90,Default,,0000,0000,0000,,!واسمه كوجيما غينتا
Dialogue: 0,0:24:53.90,0:24:55.90,Default,,0000,0000,0000,,كلا

