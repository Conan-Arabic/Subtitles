Dialogue: 0,0:00:00.89,0:00:02.39,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.39,0:00:05.13,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.47,0:00:07.87,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل مُتحرٍّ عظيم
Dialogue: 0,0:00:08.25,0:00:11.42,Default,,0000,0000,0000,,قضيّة اليوم من جزأين على متن سفينة\N!سياحية فاخرة
Dialogue: 0,0:00:11.42,0:00:13.38,Default,,0000,0000,0000,,أيمكنكم معرفة المجرم من الجزء الأوّل يا ترى؟
Dialogue: 0,0:00:13.38,0:00:15.34,Default,,0000,0000,0000,,!الحقيقة واحدة دوماً
Dialogue: 0,0:01:46.82,0:01:50.49,Default,,0000,0000,0000,,سلسلة جرائم قتل السفينة السياحية الفاخرة\N(الجزء الأوّل)
Dialogue: 0,0:02:00.10,0:02:01.69,Default,,0000,0000,0000,,!يا للمنظر البديع
Dialogue: 0,0:02:02.23,0:02:05.80,Default,,0000,0000,0000,,حصل وأن شعرتُ بالقلق للحظات، لكن حالفنا الحظّ
Dialogue: 0,0:02:05.80,0:02:06.64,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:06.93,0:02:10.72,Default,,0000,0000,0000,,فقد نسي موعد مغادرة سفينة عودتنا
Dialogue: 0,0:02:10.72,0:02:13.48,Default,,0000,0000,0000,,وصعدنا على هذه السفينة الكبيرة مكانها
Dialogue: 0,0:02:13.93,0:02:18.46,Default,,0000,0000,0000,,من الحسن أن صادفَ وتوقّفتْ\Nهذه السفينة عند الجزيرة
Dialogue: 0,0:02:18.46,0:02:22.53,Default,,0000,0000,0000,,كنّا لنُعزل في ذاك المكان النائي لثلاثة أيام
Dialogue: 0,0:02:22.53,0:02:27.57,Default,,0000,0000,0000,,لكن أيّ نوع من الأشخاص\Nقد يحجزون سفينةً كهذه؟
Dialogue: 0,0:02:34.24,0:02:36.06,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:02:38.10,0:02:39.69,Default,,0000,0000,0000,,لا، لا شيء
Dialogue: 0,0:02:40.31,0:02:45.10,Default,,0000,0000,0000,,كنتُ أفكر بوالديّ اللذين ماتا\Nفي حادث العام الفائت
Dialogue: 0,0:02:45.10,0:02:48.15,Default,,0000,0000,0000,,ليتهما يرياني بزينتي اليوم
Dialogue: 0,0:02:48.39,0:02:50.30,Default,,0000,0000,0000,,بزينتك؟
Dialogue: 0,0:02:50.30,0:02:51.57,Default,,0000,0000,0000,,أهناك خطبٌ ما يا ناتسوي؟
Dialogue: 0,0:02:52.22,0:02:53.97,Default,,0000,0000,0000,,!تاكيشي-سان
Dialogue: 0,0:02:53.97,0:02:57.25,Default,,0000,0000,0000,,!تزوّجنا اليوم في الواقع
Dialogue: 0,0:02:57.25,0:02:58.40,Default,,0000,0000,0000,,تزوّجتما؟
Dialogue: 0,0:02:58.79,0:03:01.75,On Top,,0000,0000,0000,,أقمنا الحفل في جزيرة هاتاموتو هذا الصباح
Dialogue: 0,0:02:59.25,0:03:04.61,CharCard,,0000,0290,0000,,ابنة شويتشي الثانية\N(هاتاموتو ناتسوي (22
Dialogue: 0,0:02:59.25,0:03:04.61,CharCard,,0240,0000,0000,,زوج ناتسوي\N(هاتاموتو تاكيشي (24
Dialogue: 0,0:03:01.75,0:03:04.61,On Top,,0000,0000,0000,,نفس الجزيرة التي كنتم عليها
Dialogue: 0,0:03:05.50,0:03:07.45,Default,,0000,0000,0000,,!مُبارك
Dialogue: 0,0:03:07.45,0:03:09.81,Default,,0000,0000,0000,,لكن لمَ أقمتماه على تلك الجزيرة بالذات؟
Dialogue: 0,0:03:11.12,0:03:14.99,Default,,0000,0000,0000,,تخصّ معظم الجزيرة عائلة هاتاموتو
Dialogue: 0,0:03:14.99,0:03:17.73,Default,,0000,0000,0000,,نقدّم الاحترام لأجيال من أسلافنا هناك
Dialogue: 0,0:03:17.73,0:03:22.78,Default,,0000,0000,0000,,من تقاليد عائلة هاتاموتو إقامة\Nحفلات الزواج على الجزيرة
Dialogue: 0,0:03:23.43,0:03:25.49,Default,,0000,0000,0000,,!أحمق
Dialogue: 0,0:03:25.49,0:03:31.30,Default,,0000,0000,0000,,حجزنا هذه السفينة بأكملها، فلمَ يوجد\N!غرباء على متنها؟
Dialogue: 0,0:03:31.30,0:03:33.30,Default,,0000,0000,0000,,!آ-آسف
Dialogue: 0,0:03:33.30,0:03:36.23,Default,,0000,0000,0000,,...بدوا أنّهم في مأزق فـ
Dialogue: 0,0:03:37.37,0:03:39.94,Default,,0000,0000,0000,,تفعل دون استشارتي
Dialogue: 0,0:03:40.24,0:03:42.74,On Top,,0000,0000,0000,,أصبحتَ رفيع المقام إن كنت تأخذ
Dialogue: 0,0:03:40.69,0:03:46.73,CharCard,,0000,0270,15,,زوج ماريكو والصهر\N(هاتاموتو كيتارو (47
Dialogue: 0,0:03:40.69,0:03:46.73,CharCard,,0250,0000,15,,كبير عائلة هاتاموتو\N(هاتاموتو غوزو (72
Dialogue: 0,0:03:42.74,0:03:45.24,On Top,,0000,0000,0000,,قرارات دون الرجوع لي
Dialogue: 0,0:03:45.24,0:03:46.73,On Top,,0000,0000,0000,,!كلا، أبداً
Dialogue: 0,0:03:47.48,0:03:49.11,Default,,0000,0000,0000,,لا تقلقي حيال ذلك
Dialogue: 0,0:03:49.11,0:03:52.73,Default,,0000,0000,0000,,كان جدّي في مزاج سيّئ مُذ الحفل اليوم
Dialogue: 0,0:03:53.11,0:03:55.93,Default,,0000,0000,0000,,صحيح، بعدما أكل طعامي
Dialogue: 0,0:03:55.93,0:03:57.18,Default,,0000,0000,0000,,!عمّي جوجي
Dialogue: 0,0:03:57.18,0:04:01.85,Default,,0000,0000,0000,,،كنتُ أعرف أنّه يكره الطعام الغربي\Nلكن لم أعلم أنّه سيغضب لهذا الحد
Dialogue: 0,0:04:01.85,0:04:04.32,Default,,0000,0000,0000,,!تعتبر هذا طعاماً؟
Dialogue: 0,0:04:04.72,0:04:07.84,On Top,,0000,0000,0000,,يبدو أنّ مهاراتي لا تزال ناقصة
Dialogue: 0,0:04:04.72,0:04:10.71,CharCard,,0250,0000,0000,,ابن عائلة هاتاموتو الثاني\N(هاتاموتو جوجي (41
Dialogue: 0,0:04:07.84,0:04:09.55,On Top,,0000,0000,0000,,ليس صحيحاً
Dialogue: 0,0:04:09.55,0:04:11.26,On Top,,0000,0000,0000,,!كان لذيذاً جداً
Dialogue: 0,0:04:11.26,0:04:14.61,On Top,,0000,0000,0000,,أخبرني يا خاطف القلوب، ما حكاية هذه الزهرة؟
Dialogue: 0,0:04:15.26,0:04:19.54,Default,,0000,0000,0000,,وضعتها ناتسوي عليّ في عودتنا من الحفل
Dialogue: 0,0:04:19.54,0:04:22.79,Default,,0000,0000,0000,,كان حُلمي منذ صغري
Dialogue: 0,0:04:22.79,0:04:27.02,Default,,0000,0000,0000,,أن أعطي هذه الزهرة التي تنمو\Nعلى تلك الجزيرة فقط لأعزّ الناس عليّ
Dialogue: 0,0:04:27.40,0:04:29.53,On Top,,0000,0000,0000,,...راحت عليّ
Dialogue: 0,0:04:27.67,0:04:31.77,CharCard,,0000,0000,0000,,ابن كيتارو الوحيد\N(هاتاموتو إيتشيرو (21
Dialogue: 0,0:04:32.40,0:04:35.11,Default,,0000,0000,0000,,ذاك الابن من ذاك الأب
Dialogue: 0,0:04:35.11,0:04:38.19,Default,,0000,0000,0000,,إلى متى ستدعه يواصل التّظاهر أنّه رسّام؟
Dialogue: 0,0:04:38.52,0:04:41.06,Default,,0000,0000,0000,,!أنتَ أبوه فاعقله
Dialogue: 0,0:04:41.06,0:04:43.57,Default,,0000,0000,0000,,!أخبره أن ييأس من حلمه المستحيل
Dialogue: 0,0:04:43.57,0:04:45.18,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:04:45.18,0:04:46.14,Default,,0000,0000,0000,,!تاكيشي-كن
Dialogue: 0,0:04:46.67,0:04:47.92,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:04:47.92,0:04:51.30,Default,,0000,0000,0000,,أريد مكالمتك، تعال إلى غرفتي لاحقاً
Dialogue: 0,0:04:51.30,0:04:52.11,Default,,0000,0000,0000,,حـ-حاضر
Dialogue: 0,0:04:55.30,0:04:58.25,Default,,0000,0000,0000,,تحلّ بالصبر الآن يا عزيزي
Dialogue: 0,0:04:58.25,0:05:02.57,Default,,0000,0000,0000,,لم يبق لأبي وقتٌ طويل، ساعة عمره تنفد
Dialogue: 0,0:05:03.12,0:05:09.74,CharCard,,0000,0000,0010,,ابنة هاتاموتو البكر وزوجة كيتارو\N(هاتاموتو ماريكو (43
Dialogue: 0,0:05:03.12,0:05:09.74,On Top,,0000,0000,0000,,وعندها ستصبح مجموعة هاتاموتو وثروتها\N!كلّها من نصيبك تقريباً
Dialogue: 0,0:05:09.74,0:05:13.48,On Top,,0000,0000,0000,,لا أظنّ ذلك يا عمّة
Dialogue: 0,0:05:14.45,0:05:16.02,On Top,,0000,0000,0000,,!ما قصدك؟
Dialogue: 0,0:05:16.02,0:05:18.94,On Top,,0000,0000,0000,,!أكي-سان! أتعرفين شيئاً أجهله؟
Dialogue: 0,0:05:18.53,0:05:21.73,CharCard,,0230,0000,0000,,ابنة شويتشي وأخت ناتسوي\N(هاتاموتو أكي (26
Dialogue: 0,0:05:20.35,0:05:21.73,On Top,,0000,0000,0000,,لا تسقطي من الصدمة بعدما تسمعين
Dialogue: 0,0:05:26.18,0:05:29.18,Default,,0000,0000,0000,,!مـ-محال! لا يمكن ذلك
Dialogue: 0,0:05:29.18,0:05:31.73,Default,,0000,0000,0000,,يبدو أنّ جدّي سيعلن الأمر
Dialogue: 0,0:05:31.73,0:05:33.44,Default,,0000,0000,0000,,بعدما نرجع لطوكيو
Dialogue: 0,0:05:34.65,0:05:36.97,On Top,,0000,0000,0000,,لا تمازحني
Dialogue: 0,0:05:34.65,0:05:39.49,CharCard,,0000,0000,0000,,زوج أكي\N(هاتاموتو تاتسو (26
Dialogue: 0,0:05:36.97,0:05:39.49,On Top,,0000,0000,0000,,أيعرف أنّنا غارقون في الديون؟
Dialogue: 0,0:05:41.39,0:05:44.46,Default,,0000,0000,0000,,أمامنا 24 ساعة حتى تصل السفينة طوكيو
Dialogue: 0,0:05:45.17,0:05:48.41,Default,,0000,0000,0000,,علينا فعل شيءٍ قبل ذاك
Dialogue: 0,0:05:58.28,0:05:59.09,Default,,0000,0000,0000,,أنا تاكيشي
Dialogue: 0,0:05:59.09,0:06:00.11,Default,,0000,0000,0000,,ادخل
Dialogue: 0,0:06:03.62,0:06:04.53,Default,,0000,0000,0000,,أعتذر على التطفل
Dialogue: 0,0:06:05.65,0:06:09.31,Default,,0000,0000,0000,,كانت كلمتك محترمةً في الزفاف
Dialogue: 0,0:06:09.31,0:06:11.56,Default,,0000,0000,0000,,لا عجب من الرجل الذي اختارته ناتسوي
Dialogue: 0,0:06:13.11,0:06:14.04,Default,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:06:16.39,0:06:18.68,Default,,0000,0000,0000,,...حكّك لخدّك عند الإحراج
Dialogue: 0,0:06:18.68,0:06:19.74,Default,,0000,0000,0000,,أنتَ مثله
Dialogue: 0,0:06:20.93,0:06:23.58,Default,,0000,0000,0000,,!أقصد أباك، زايكي إيساو
Dialogue: 0,0:06:25.50,0:06:28.92,Default,,0000,0000,0000,,،يمكنك تزييف سجلاتك العائلية\N!لكنك لن تخدعني
Dialogue: 0,0:06:28.92,0:06:32.50,Default,,0000,0000,0000,,أعرف أنّك دخلت شركتي وتقرّبت من ناتسوي
Dialogue: 0,0:06:32.50,0:06:36.33,Default,,0000,0000,0000,,!كي تأخذ بانتقام والدك
Dialogue: 0,0:06:37.99,0:06:39.91,Default,,0000,0000,0000,,ما الذي تسعى وراءه؟
Dialogue: 0,0:06:40.28,0:06:41.37,Default,,0000,0000,0000,,المال؟
Dialogue: 0,0:06:42.03,0:06:44.60,Default,,0000,0000,0000,,أم حياتي ربما؟
Dialogue: 0,0:06:45.98,0:06:48.65,Default,,0000,0000,0000,,!ما الخطب؟ لمَ لا تنطق؟
Dialogue: 0,0:06:48.65,0:06:50.41,Default,,0000,0000,0000,,!أجب
Dialogue: 0,0:06:53.44,0:06:57.01,Default,,0000,0000,0000,,هذه شجرة عائلة هاتاموتو الرئيسية
Dialogue: 0,0:06:57.01,0:06:59.78,Default,,0000,0000,0000,,حضر كلّ هؤلاء زفافك إذاً؟
Dialogue: 0,0:07:00.35,0:07:03.14,Default,,0000,0000,0000,,أجل، التسعة منهم باستثناء والديّ المتوفيّين
Dialogue: 0,0:07:03.14,0:07:05.24,Default,,0000,0000,0000,,وشويتشي وميوكي
Dialogue: 0,0:07:06.05,0:07:09.05,Default,,0000,0000,0000,,...لكن، تأخّر تاكيشي-سان بالفعل
Dialogue: 0,0:07:09.05,0:07:12.34,Default,,0000,0000,0000,,أجل، لم يعد مذ ذهب لغرفة جدّي
Dialogue: 0,0:07:12.34,0:07:13.45,Default,,0000,0000,0000,,ماذا حصل يا ترى؟
Dialogue: 0,0:07:14.00,0:07:17.66,Default,,0000,0000,0000,,لعلّهما يناقشان أعمال لا شرعية
Dialogue: 0,0:07:17.66,0:07:18.87,Default,,0000,0000,0000,,أختي
Dialogue: 0,0:07:24.49,0:07:26.18,Default,,0000,0000,0000,,تأخّرت
Dialogue: 0,0:07:26.18,0:07:27.32,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:07:29.11,0:07:30.53,Default,,0000,0000,0000,,لم يأت أبي بعد؟
Dialogue: 0,0:07:31.11,0:07:34.50,On Top,,0000,0000,0000,,كلا، لكني أعتقد أنّه سيأتي قريباً
Dialogue: 0,0:07:31.19,0:07:34.50,CharCard,,0000,0000,0000,,كبير خدم عائلة هاتاموتو\N(سوزوكي كينجي (64
Dialogue: 0,0:07:34.81,0:07:36.77,Default,,0000,0000,0000,,تأخّرت يا إيتشيرو-سان
Dialogue: 0,0:07:36.77,0:07:38.21,Default,,0000,0000,0000,,هل غسلت يديك كما يجب؟
Dialogue: 0,0:07:38.21,0:07:38.78,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:39.22,0:07:42.12,Default,,0000,0000,0000,,أخبريني يا ران-سان، ألديك حبيب وما شابه؟
Dialogue: 0,0:07:43.77,0:07:47.46,Default,,0000,0000,0000,,بالطبع لا، لا تزال طفلة
Dialogue: 0,0:07:47.46,0:07:48.96,Default,,0000,0000,0000,,هذه فظاظة
Dialogue: 0,0:07:48.96,0:07:51.51,Default,,0000,0000,0000,,حتّى أنا لديّ شخص أحبه
Dialogue: 0,0:07:51.51,0:07:52.66,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:07:53.59,0:07:55.50,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:07:55.50,0:07:57.36,Default,,0000,0000,0000,,كيف هو؟
Dialogue: 0,0:07:58.33,0:08:04.12,Default,,0000,0000,0000,,حسناً، إنّه لامع الذكاء وبارع في كرة القدم\N!وأهلٌ للمسؤولية وقت الحاجة، إنّه رائعٌ جداً
Dialogue: 0,0:08:06.15,0:08:07.95,Default,,0000,0000,0000,,لمَ تحمّر أنت خجلاً؟
Dialogue: 0,0:08:08.57,0:08:12.36,Default,,0000,0000,0000,,!وهو متحرٍّ أفضل حتّى من أبي
Dialogue: 0,0:08:12.36,0:08:13.91,Default,,0000,0000,0000,,...تقصدين أنّ أباكِ
Dialogue: 0,0:08:14.36,0:08:16.23,Default,,0000,0000,0000,,ماذا؟ لم أخبركم؟
Dialogue: 0,0:08:16.23,0:08:18.37,Default,,0000,0000,0000,,أنّ أبي مُتحرٍّ؟
Dialogue: 0,0:08:26.22,0:08:28.07,Default,,0000,0000,0000,,أ-أهناك خطبٌ ما؟
Dialogue: 0,0:08:28.88,0:08:32.22,Default,,0000,0000,0000,,اكتموا الأمر عن جدّي، فهو يكره المتحرّيين
Dialogue: 0,0:08:32.22,0:08:35.32,Default,,0000,0000,0000,,يقول أنّ الناس الذين يدسّون أنوفهم\Nفي أمور الناس بغيضو الطبع
Dialogue: 0,0:08:36.91,0:08:39.28,Default,,0000,0000,0000,,إنّه صادق في حالة العمّ كوغورو على الأقل
Dialogue: 0,0:08:41.75,0:08:44.17,Default,,0000,0000,0000,,سيّدي، مقعدك بانتظارك
Dialogue: 0,0:08:46.45,0:08:47.36,Default,,0000,0000,0000,,زهرة؟
Dialogue: 0,0:08:51.82,0:08:54.20,Default,,0000,0000,0000,,!تاكيشي-سان! تأخّرت كثيراً
Dialogue: 0,0:08:55.14,0:08:58.41,Default,,0000,0000,0000,,آسف، كنتُ غارقاً في التفكير في غرفتي
Dialogue: 0,0:08:59.31,0:09:01.77,Default,,0000,0000,0000,,أأنت بخير؟ تبدو شاحباً
Dialogue: 0,0:09:03.23,0:09:06.01,Default,,0000,0000,0000,,ماذا؟ أين الزهرة التي أعطيتك؟
Dialogue: 0,0:09:06.01,0:09:08.24,Default,,0000,0000,0000,,غريب، أين فقدتها؟
Dialogue: 0,0:09:10.80,0:09:13.22,Default,,0000,0000,0000,,أعتذر على مضايقتك سيّدي
Dialogue: 0,0:09:13.22,0:09:14.33,Default,,0000,0000,0000,,...الجميع بانتظار
Dialogue: 0,0:09:17.00,0:09:18.40,Default,,0000,0000,0000,,!ما كان ذاك الصوت؟
Dialogue: 0,0:09:18.40,0:09:19.24,Default,,0000,0000,0000,,!الخادم سوزوكي
Dialogue: 0,0:09:19.87,0:09:20.87,Default,,0000,0000,0000,,!أتى من غرفة أبي
Dialogue: 0,0:09:23.83,0:09:24.90,Default,,0000,0000,0000,,!ما الخطب يا سوزوكي-سان؟
Dialogue: 0,0:09:36.15,0:09:38.19,Default,,0000,0000,0000,,فات الأوان، فارق الحياة
Dialogue: 0,0:09:38.19,0:09:38.95,Default,,0000,0000,0000,,لا يمكن
Dialogue: 0,0:09:39.27,0:09:40.53,Default,,0000,0000,0000,,!جدّي
Dialogue: 0,0:09:39.73,0:09:40.53,Default,,0000,0000,0000,,!توقفي
Dialogue: 0,0:09:40.94,0:09:41.99,Default,,0000,0000,0000,,!لا يدخل أحد
Dialogue: 0,0:09:42.69,0:09:46.48,Default,,0000,0000,0000,,لا يمكن لأحد دخول هذه الغرفة حتى أسمح
Dialogue: 0,0:09:50.55,0:09:54.78,Default,,0000,0000,0000,,يبدو أنّ 40 أو 50 دقيقة مضت\Nمنذ موت غوزو
Dialogue: 0,0:09:55.42,0:09:59.33,Default,,0000,0000,0000,,كنتَ من وجده، صحيح يا سوزوكي-سان؟
Dialogue: 0,0:09:59.33,0:10:01.00,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:01.00,0:10:05.99,Default,,0000,0000,0000,,،أين كنت قبل 40 إلى 50 دقيقة\Nأي عند قرابة الثامنة؟
Dialogue: 0,0:10:06.32,0:10:10.12,Default,,0000,0000,0000,,كنتُ أجهّز للعشاء عند الثامنة
Dialogue: 0,0:10:10.12,0:10:11.78,Default,,0000,0000,0000,,فكنتُ في غرفة الطعام طوال الوقت
Dialogue: 0,0:10:11.78,0:10:16.95,Default,,0000,0000,0000,,رأينا سوزوكي-سان في عمله متعجلاً\Nبين الطاولات بالفعل
Dialogue: 0,0:10:17.31,0:10:22.02,Default,,0000,0000,0000,,كان باب هذه الغرفة مقفل\Nعندما وجدث الجثة، صحيح؟
Dialogue: 0,0:10:22.02,0:10:22.90,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:22.90,0:10:25.18,Default,,0000,0000,0000,,وأيّ طرق لقفل الباب؟
Dialogue: 0,0:10:25.18,0:10:26.45,Default,,0000,0000,0000,,،يمكن قفله من الداخل
Dialogue: 0,0:10:26.45,0:10:28.91,Default,,0000,0000,0000,,لكن تحتاج لهذا المفتاح لقفله من الخارج
Dialogue: 0,0:10:29.30,0:10:34.65,Default,,0000,0000,0000,,والنافذة هنا لا تُفتح، فيستحيل التسلل لها من الخارج
Dialogue: 0,0:10:34.65,0:10:38.45,Default,,0000,0000,0000,,مما يعني أنّها كانت غرفةً مغلقة تماماً
Dialogue: 0,0:10:38.92,0:10:40.42,Default,,0000,0000,0000,,غرفة مغلقة؟
Dialogue: 0,0:10:40.42,0:10:43.41,Default,,0000,0000,0000,,أتقصد أنّ جدّي قد انتحر؟
Dialogue: 0,0:10:43.79,0:10:45.53,Default,,0000,0000,0000,,لكن هذا غريب
Dialogue: 0,0:10:45.53,0:10:50.45,Default,,0000,0000,0000,,لو كان انتحاراً فهناك شيء مفقود
Dialogue: 0,0:10:51.58,0:10:52.91,Default,,0000,0000,0000,,السلاح
Dialogue: 0,0:10:53.33,0:10:56.98,Default,,0000,0000,0000,,مات من النزيف بعدما طُعن في المعدة
Dialogue: 0,0:10:56.98,0:10:59.87,Default,,0000,0000,0000,,لكن لا أثر للسكّين التي اُستعملت
Dialogue: 0,0:11:00.32,0:11:03.19,Default,,0000,0000,0000,,لعلّه كان خنجراً من جليد وما شابه
Dialogue: 0,0:11:03.19,0:11:06.57,Default,,0000,0000,0000,,فروايات التحرّي مليئة بالأشياء\Nالتي تذوب ويزول أثرها
Dialogue: 0,0:11:07.01,0:11:09.99,Default,,0000,0000,0000,,هل سيفكّر شخص ينتحر بشيءٍ كهذا؟
Dialogue: 0,0:11:10.76,0:11:13.43,Default,,0000,0000,0000,,إنها مضايقة من جدّي حتماً
Dialogue: 0,0:11:13.43,0:11:18.13,Default,,0000,0000,0000,,أراد أن يعاني جميع أفراد هاتاموتو هنا\Nبرميهم في دائرة الشبهة
Dialogue: 0,0:11:18.13,0:11:21.84,Default,,0000,0000,0000,,فقد كان يكرههم جميعاً
Dialogue: 0,0:11:21.84,0:11:24.74,Default,,0000,0000,0000,,صحيح، باستثناء ناتسوي
Dialogue: 0,0:11:25.24,0:11:26.70,Default,,0000,0000,0000,,!أ-أختي
Dialogue: 0,0:11:26.99,0:11:29.41,Default,,0000,0000,0000,,...لا أستبعد الفعلة عنه
Dialogue: 0,0:11:29.41,0:11:32.24,Default,,0000,0000,0000,,!كان انتحاراً إذاً! حُسِم الأمر
Dialogue: 0,0:11:32.24,0:11:33.33,Default,,0000,0000,0000,,هذه جريمة قتل
Dialogue: 0,0:11:33.33,0:11:34.00,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:11:34.00,0:11:36.45,Default,,0000,0000,0000,,وواحدة بغاية البساطة
Dialogue: 0,0:11:36.45,0:11:38.65,Default,,0000,0000,0000,,!أنت مجدداً؟
Dialogue: 0,0:11:38.65,0:11:42.33,Default,,0000,0000,0000,,هنا، أمعن النظر لإطار المدخل
Dialogue: 0,0:11:42.86,0:11:44.04,Default,,0000,0000,0000,,أترى الدم؟
Dialogue: 0,0:11:44.56,0:11:48.18,Default,,0000,0000,0000,,لو كان الباب مغلقاً عندما أقدم على الانتحار
Dialogue: 0,0:11:48.18,0:11:50.85,Default,,0000,0000,0000,,ما كنّا لنجد دماً هنا، صحيح؟
Dialogue: 0,0:11:50.85,0:11:55.80,Default,,0000,0000,0000,,إذا فكّرنا منطقيّاً فقد طُعِن بينما الباب مفتوح
Dialogue: 0,0:11:55.80,0:12:01.84,Default,,0000,0000,0000,,!صحيح! طعن أحدهم غوزو لحظة مغادرته الغرفة
Dialogue: 0,0:12:01.84,0:12:05.12,Default,,0000,0000,0000,,من أقفل الغرفة إذاً؟
Dialogue: 0,0:12:05.12,0:12:06.95,Default,,0000,0000,0000,,من يا ترى؟
Dialogue: 0,0:12:06.95,0:12:08.70,Default,,0000,0000,0000,,أتعرف عملك حقاً؟
Dialogue: 0,0:12:17.40,0:12:21.33,Default,,0000,0000,0000,,!فهمت! كان غوزو نفسه من أقفل الباب
Dialogue: 0,0:12:22.69,0:12:28.02,Default,,0000,0000,0000,,طعنه أحدهم خارج الغرفة ثمّ واصل هجومه
Dialogue: 0,0:12:28.02,0:12:30.43,Default,,0000,0000,0000,,ففرّ غوزو للغرفة وأقفل الباب
Dialogue: 0,0:12:30.43,0:12:32.45,Default,,0000,0000,0000,,لكن خارتْ قِواه ومات
Dialogue: 0,0:12:33.18,0:12:35.65,Default,,0000,0000,0000,,فهمت، هذا منطقيّ
Dialogue: 0,0:12:36.17,0:12:39.34,Default,,0000,0000,0000,,!كما يُتوقع منك يا عمّي، استنتاج عظيم
Dialogue: 0,0:12:41.51,0:12:46.16,Default,,0000,0000,0000,,لحظة، هذا يعني كان للجميع فرصة لقتله
Dialogue: 0,0:12:46.16,0:12:48.29,Default,,0000,0000,0000,,وقعت الجريمة قرابة الثامنة
Dialogue: 0,0:12:48.29,0:12:52.66,Default,,0000,0000,0000,,كنتُ وران وكونان وناتسوي-سان\Nعند طاولتنا منذ السابعة والنصف
Dialogue: 0,0:12:52.66,0:12:54.16,Default,,0000,0000,0000,,فيستحيل أن يكون أحدنا
Dialogue: 0,0:12:54.16,0:12:59.24,Default,,0000,0000,0000,,ينطبق الأمر على سوزوكي-سان \Nالذي كان قرب طاولتنا
Dialogue: 0,0:12:59.24,0:13:02.70,Default,,0000,0000,0000,,بعبارة أخرى، بما أن القاتل لم يكن\N...في غرفة الطعام آنذاك
Dialogue: 0,0:13:03.57,0:13:07.48,Default,,0000,0000,0000,,!كان أحدكم أنتم السبعة
Dialogue: 0,0:13:13.81,0:13:15.01,Default,,0000,0000,0000,,سوزوكي-سان
Dialogue: 0,0:13:15.01,0:13:19.01,Default,,0000,0000,0000,,هل لاحظت شيئاً غريباً عند دخولك الغرفة؟
Dialogue: 0,0:13:19.01,0:13:21.26,Default,,0000,0000,0000,,كلا، لا شيء تحديداً
Dialogue: 0,0:13:21.26,0:13:24.82,Default,,0000,0000,0000,,تذكرت، وجدتُ هذه الزهرة أمام الباب
Dialogue: 0,0:13:25.37,0:13:26.67,Default,,0000,0000,0000,,زهرة؟
Dialogue: 0,0:13:26.67,0:13:31.87,Default,,0000,0000,0000,,إ-إنّها الزهرة التي علّقتها على معطف تاكيشي-سان
Dialogue: 0,0:13:34.17,0:13:38.32,Default,,0000,0000,0000,,صحيح، تأخّرت في القدوم لغرفة الطعام
Dialogue: 0,0:13:39.11,0:13:42.41,Default,,0000,0000,0000,,بربك، كنتُ جالساً أفكر في غرفتي فقط
Dialogue: 0,0:13:42.41,0:13:45.53,Default,,0000,0000,0000,,لا تحاول الإنكار يا تاكيشي-سان
Dialogue: 0,0:13:45.94,0:13:52.20,Default,,0000,0000,0000,,سمعتُ الصراخ بينك وأبي \Nعندما كنتُ أمرّ أمام الغرفة
Dialogue: 0,0:13:54.15,0:13:57.89,Default,,0000,0000,0000,,ظننتُ أنّي سأسقط من الدهشة
Dialogue: 0,0:13:57.89,0:14:02.54,Default,,0000,0000,0000,,!عندما سمعتُ أنّك ابن زايكي إيساو
Dialogue: 0,0:14:07.00,0:14:09.24,Default,,0000,0000,0000,,من زايكي إيساو ذاك؟
Dialogue: 0,0:14:10.50,0:14:17.70,Default,,0000,0000,0000,,شخص أقدم على الانتحار عندما\Nاستحوذ غوزو على شركته قبل 10 أعوام
Dialogue: 0,0:14:18.32,0:14:22.45,Default,,0000,0000,0000,,ولحقت زوجته به بعد عام من مرض
Dialogue: 0,0:14:22.45,0:14:27.41,Default,,0000,0000,0000,,فُوضع ابنهما الوحيد في مركز رعاية ما
Dialogue: 0,0:14:28.02,0:14:30.48,Default,,0000,0000,0000,,من كان ليتصور أنّه تاكيشي-كن
Dialogue: 0,0:14:30.48,0:14:33.27,Default,,0000,0000,0000,,أهذا صحيح يا تاكيشي-سان؟
Dialogue: 0,0:14:33.27,0:14:34.36,Default,,0000,0000,0000,,!تاكيشي-سان
Dialogue: 0,0:14:36.01,0:14:40.53,Default,,0000,0000,0000,,!أجل، أنا ابن زايكي إيساو، زايكي تاكيشي
Dialogue: 0,0:14:42.89,0:14:46.04,Default,,0000,0000,0000,,...لـ-لكني
Dialogue: 0,0:14:46.04,0:14:50.59,Default,,0000,0000,0000,,تقرّبت من ناتسوي-سان كي تأخذ بثأر أبيك؟
Dialogue: 0,0:14:50.59,0:14:52.92,Default,,0000,0000,0000,,قرّرت دخول عائلة هاتاموتو
Dialogue: 0,0:14:52.92,0:14:55.95,Default,,0000,0000,0000,,وانتظار فرصة قتل غوزو
Dialogue: 0,0:14:56.41,0:15:00.33,Default,,0000,0000,0000,,!وذلك ما ارتكبته الليلة
Dialogue: 0,0:15:01.24,0:15:03.12,Default,,0000,0000,0000,,!كلا! لم أقتله
Dialogue: 0,0:15:06.57,0:15:07.77,Default,,0000,0000,0000,,!ناتسوي! انتظري
Dialogue: 0,0:15:09.77,0:15:12.52,Default,,0000,0000,0000,,،ظننتُ أنّك شاب قويم
Dialogue: 0,0:15:12.52,0:15:14.81,Default,,0000,0000,0000,,لكن يبدو أنّي أخطأت
Dialogue: 0,0:15:14.81,0:15:16.51,Default,,0000,0000,0000,,جوجي-سان
Dialogue: 0,0:15:16.51,0:15:19.41,Default,,0000,0000,0000,,يا لحماقتك لإسقاطك الزهرة عند موقع الجريمة
Dialogue: 0,0:15:20.01,0:15:22.16,Default,,0000,0000,0000,,!لم أفعل، فقدتها في مكانٍ ما
Dialogue: 0,0:15:22.89,0:15:25.57,Default,,0000,0000,0000,,توجد آثار دم ممحوّة على السجاد خارجاً
Dialogue: 0,0:15:26.00,0:15:29.21,Default,,0000,0000,0000,,أكانت الزهرة ساقطة هنا حقاً؟
Dialogue: 0,0:15:29.21,0:15:31.44,Default,,0000,0000,0000,,أجل يا بنيّ
Dialogue: 0,0:15:34.66,0:15:36.20,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:15:37.79,0:15:39.16,Default,,0000,0000,0000,,!كسرة خبز
Dialogue: 0,0:15:39.66,0:15:42.41,Default,,0000,0000,0000,,كسرة خبز في بركة الدماء؟
Dialogue: 0,0:15:42.41,0:15:43.62,Default,,0000,0000,0000,,ما معنى هذا؟
Dialogue: 0,0:15:44.32,0:15:47.28,Default,,0000,0000,0000,,أخبرني سيّدي
Dialogue: 0,0:15:47.28,0:15:51.83,Default,,0000,0000,0000,,أكان هناك خبزٌ في مأدبة الزفاف هذه الظهيرة؟
Dialogue: 0,0:15:52.40,0:15:56.81,Default,,0000,0000,0000,,بالطبع، فقد كان طعاماً فرنسياً فاخراً
Dialogue: 0,0:15:56.81,0:16:02.18,Default,,0000,0000,0000,,طهاه جوجي-ساما الذي يدير مطعماً فرنسياً
Dialogue: 0,0:16:02.18,0:16:03.59,Default,,0000,0000,0000,,هل أكله الجميع؟
Dialogue: 0,0:16:03.59,0:16:06.03,Default,,0000,0000,0000,,أجل، باستثناء غوزو-ساما
Dialogue: 0,0:16:06.67,0:16:08.88,Default,,0000,0000,0000,,فقد كان يكره الطعام الغربي
Dialogue: 0,0:16:08.88,0:16:13.34,Default,,0000,0000,0000,,قال أنّ مجرد النظر للخبز يشعره بالغثيان
Dialogue: 0,0:16:13.34,0:16:17.29,Default,,0000,0000,0000,,لو كان جوجي-سان طاهياً، فلديه مجموعة\Nسكاكينه المطبخية الخاصة، صحيح؟
Dialogue: 0,0:16:17.29,0:16:21.83,Default,,0000,0000,0000,,بالطبع، فللطهاة مثله مجموعاتهم دوماً
Dialogue: 0,0:16:21.83,0:16:26.03,Default,,0000,0000,0000,,اسمع، لا يصحّ بالأطفال التطفل على شؤون الآخرين
Dialogue: 0,0:16:29.03,0:16:29.49,Default,,0000,0000,0000,,ادخل
Dialogue: 0,0:16:29.99,0:16:33.33,Default,,0000,0000,0000,,هدّئ أعصابك في المخزن لفترة
Dialogue: 0,0:16:34.14,0:16:37.45,Default,,0000,0000,0000,,!افتح! أرجوك! لم أكن القاتل
Dialogue: 0,0:16:37.77,0:16:39.81,Default,,0000,0000,0000,,لا تعبث معي يا مجرم
Dialogue: 0,0:16:39.81,0:16:42.81,Default,,0000,0000,0000,,سنسلمك للشرطة لحظة وصولنا لطوكيو غداً
Dialogue: 0,0:16:42.81,0:16:43.91,Default,,0000,0000,0000,,حضّر نفسك
Dialogue: 0,0:16:44.67,0:16:49.05,Default,,0000,0000,0000,,الدافع والدليل كافيان، صحيح حضرة المتحرّي؟
Dialogue: 0,0:16:49.05,0:16:50.92,Default,,0000,0000,0000,,لديه دافعٌ كافٍ
Dialogue: 0,0:16:50.92,0:16:55.74,Default,,0000,0000,0000,,وستكتمل القضية إن وجدنا بصماته\Nعلى سلاح الجريمة
Dialogue: 0,0:16:56.29,0:16:57.35,Default,,0000,0000,0000,,تفضّلي
Dialogue: 0,0:16:57.35,0:16:58.70,Default,,0000,0000,0000,,شكراً لك
Dialogue: 0,0:16:59.33,0:17:00.84,Default,,0000,0000,0000,,هاك يا فتى
Dialogue: 0,0:17:00.84,0:17:02.16,Default,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:17:02.79,0:17:05.49,Default,,0000,0000,0000,,يا لحظّك يا عمّة ماريكو
Dialogue: 0,0:17:05.49,0:17:08.45,Default,,0000,0000,0000,,،بعد أن قتل تاكيشي-سان جدّي
Dialogue: 0,0:17:08.45,0:17:12.16,Default,,0000,0000,0000,,لن يقوم بذاك الإعلان الساذج عن إرثه
Dialogue: 0,0:17:13.57,0:17:14.89,Default,,0000,0000,0000,,معكِ حق
Dialogue: 0,0:17:14.89,0:17:16.36,Default,,0000,0000,0000,,أصبحت مجموعة هاتاموتو لك الآن
Dialogue: 0,0:17:16.85,0:17:19.82,Default,,0000,0000,0000,,يا زوج الابنة البكر
Dialogue: 0,0:17:20.48,0:17:22.48,Default,,0000,0000,0000,,ويمكنك الرسم كما تحبّ يا إيتشيرو-سان
Dialogue: 0,0:17:22.48,0:17:24.19,Default,,0000,0000,0000,,!بعد وفاة جدّك
Dialogue: 0,0:17:24.68,0:17:27.93,Default,,0000,0000,0000,,...وبنهاية المطاف، ستصبح أنت رئيس مجموعة هاتاموتو
Dialogue: 0,0:17:27.93,0:17:30.37,Default,,0000,0000,0000,,...لا-لا أنوي ذلك حقاً
Dialogue: 0,0:17:30.88,0:17:34.82,Default,,0000,0000,0000,,لا تخططين للاستحواذ على إرث العجوز وحدك، صحيح؟
Dialogue: 0,0:17:35.33,0:17:38.25,Default,,0000,0000,0000,,...لا تقلق، ستحصلون الأحفاد جميعاً
Dialogue: 0,0:17:38.25,0:17:42.74,Default,,0000,0000,0000,,هلا توقفتِ عن الحديث حول المال\Nيا أختي في ليلة وفاة أبي؟
Dialogue: 0,0:17:43.99,0:17:48.57,Default,,0000,0000,0000,,لا حقّ لك بالكلام بعدما تركت العائلة لتصبح طاهياً
Dialogue: 0,0:17:48.57,0:17:51.03,Default,,0000,0000,0000,,أنا أعرف
Dialogue: 0,0:17:51.03,0:17:54.10,Default,,0000,0000,0000,,رفض أبي طلبك باقتراض المال
Dialogue: 0,0:17:54.10,0:17:56.24,Default,,0000,0000,0000,,!لأجل مطعمك
Dialogue: 0,0:17:58.15,0:18:02.27,Default,,0000,0000,0000,,أردت حصّةً من ماله أيضاً، فلتُسرّ
Dialogue: 0,0:18:02.27,0:18:03.12,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:18:03.73,0:18:06.68,Default,,0000,0000,0000,,...يؤسفني قول هذا
Dialogue: 0,0:18:06.68,0:18:09.07,Default,,0000,0000,0000,,لكن كتب أبوك وصيّةً
Dialogue: 0,0:18:09.68,0:18:13.64,Default,,0000,0000,0000,,في حال حصل مكروهٌ له
Dialogue: 0,0:18:13.64,0:18:14.96,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:18:14.96,0:18:19.03,Default,,0000,0000,0000,,أظن أنّها ستُقرأ في المكتب الرئيسي\Nبعد بضعة أيام
Dialogue: 0,0:18:19.50,0:18:21.05,Default,,0000,0000,0000,,...أ-أيعني هذا
Dialogue: 0,0:18:21.05,0:18:22.12,Default,,0000,0000,0000,,...كلّ ثروته ستكون من نصيب
Dialogue: 0,0:18:23.42,0:18:25.07,Default,,0000,0000,0000,,!ناتسوي؟
Dialogue: 0,0:18:23.42,0:18:25.07,Default,,0000,0000,0000,,!ناتسوي؟
Dialogue: 0,0:18:25.49,0:18:26.37,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:18:26.37,0:18:29.78,Default,,0000,0000,0000,,ورئاسة مجموعة هاتاموتو ستُعطى للرجل للذي اختارته
Dialogue: 0,0:18:29.78,0:18:30.78,Default,,0000,0000,0000,,ناتسوي-ساما
Dialogue: 0,0:18:31.66,0:18:32.95,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:18:33.57,0:18:38.41,Default,,0000,0000,0000,,!يا للهول! ما فائدة زواجي من أكي إذاً؟
Dialogue: 0,0:18:38.98,0:18:42.90,Default,,0000,0000,0000,,أتقصد أنّك تزوجتني لمال جدّي من البداية؟
Dialogue: 0,0:18:42.90,0:18:47.86,Default,,0000,0000,0000,,أجل، صحيح! وإلّا لمَ أريد الارتباط\N!بشحيحةٍ بائسة مثلك؟
Dialogue: 0,0:18:48.39,0:18:51.26,Default,,0000,0000,0000,,!ماذا؟! تقول هذا وأنت مجرد موسيقيّ عديم الموهبة
Dialogue: 0,0:18:51.26,0:18:52.70,Default,,0000,0000,0000,,!اعمل كبقية الناس
Dialogue: 0,0:19:00.59,0:19:02.34,Default,,0000,0000,0000,,ناتسوي-سان؟
Dialogue: 0,0:19:02.34,0:19:05.83,Default,,0000,0000,0000,,ماذا تفعلين هنا؟
Dialogue: 0,0:19:05.83,0:19:09.07,Default,,0000,0000,0000,,لا شيء، أفكّر قليلاً فقط
Dialogue: 0,0:19:11.66,0:19:12.93,Default,,0000,0000,0000,,في تاكيشي-سان؟
Dialogue: 0,0:19:16.19,0:19:21.52,Default,,0000,0000,0000,,...وثقتُ به، كنت مؤمنة
Dialogue: 0,0:19:23.44,0:19:28.32,Default,,0000,0000,0000,,!لكنّه تزوجني كي يقتل جدّي فقط
Dialogue: 0,0:19:28.68,0:19:32.43,Default,,0000,0000,0000,,!لن أثق بأحد مُجدداً
Dialogue: 0,0:19:38.46,0:19:40.38,Default,,0000,0000,0000,,أنا أثق به
Dialogue: 0,0:19:43.30,0:19:48.08,Default,,0000,0000,0000,,يخبرني حدسي بشكلٍ ما أنّه ليس شخصاً سيّئاً
Dialogue: 0,0:19:48.08,0:19:50.12,Default,,0000,0000,0000,,فهو من اخترتِه، صحيح؟
Dialogue: 0,0:19:50.83,0:19:52.58,Default,,0000,0000,0000,,يستحيل أن يكون رجلاً سيّئاً
Dialogue: 0,0:19:54.07,0:19:55.03,Default,,0000,0000,0000,,...ران-سان
Dialogue: 0,0:19:58.40,0:19:59.53,Default,,0000,0000,0000,,...ماذا
Dialogue: 0,0:20:00.73,0:20:05.02,Default,,0000,0000,0000,,ألم تسمعا صوتاً غريباً؟
Dialogue: 0,0:20:05.02,0:20:06.49,Default,,0000,0000,0000,,أسمعتِ شيئاً يا ناتسوي-سان؟
Dialogue: 0,0:20:06.49,0:20:07.91,Default,,0000,0000,0000,,لا، لا شيء
Dialogue: 0,0:20:08.43,0:20:10.60,Default,,0000,0000,0000,,كلا، سمعتُ بالفعل
Dialogue: 0,0:20:10.60,0:20:12.39,Default,,0000,0000,0000,,صوت شيءٍ يسقط في الماء
Dialogue: 0,0:20:12.39,0:20:15.82,Default,,0000,0000,0000,,ثمّ ارتطام غريب من السطح السفلي
Dialogue: 0,0:20:17.01,0:20:18.71,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:20:18.71,0:20:21.13,Default,,0000,0000,0000,,!انتظر يا كونان-كن! ماذا يجري؟
Dialogue: 0,0:20:25.54,0:20:27.83,Default,,0000,0000,0000,,...ما خطبكما
Dialogue: 0,0:20:37.24,0:20:39.82,Default,,0000,0000,0000,,سبب الموت كان إصابة دماغية غالباً
Dialogue: 0,0:20:39.82,0:20:41.07,Default,,0000,0000,0000,,جرّاء ضربة للرأس
Dialogue: 0,0:20:41.07,0:20:42.32,Default,,0000,0000,0000,,،بناءً على الجرح
Dialogue: 0,0:20:42.32,0:20:44.86,Default,,0000,0000,0000,,كان سلاح الجريمة أنبوباً حديدياً وما شابه
Dialogue: 0,0:20:45.43,0:20:48.31,Default,,0000,0000,0000,,من قد يفعل شيئاً فظيعاً كهذا؟
Dialogue: 0,0:20:48.31,0:20:50.48,Default,,0000,0000,0000,,...أيمكن أنّ تاكيشي مُجدداً
Dialogue: 0,0:20:50.48,0:20:52.68,Default,,0000,0000,0000,,مستحيل، الباب مقفل
Dialogue: 0,0:20:53.80,0:20:54.65,Default,,0000,0000,0000,,!انتظر، كونان
Dialogue: 0,0:20:59.17,0:21:00.12,Default,,0000,0000,0000,,!القفل مفتوح
Dialogue: 0,0:21:00.12,0:21:01.87,Default,,0000,0000,0000,,ابتعد
Dialogue: 0,0:21:04.87,0:21:05.82,Default,,0000,0000,0000,,!ليس موجوداً
Dialogue: 0,0:22:41.96,0:22:43.41,Default,,0000,0000,0000,,!لم يكن في المخزن؟
Dialogue: 0,0:22:43.74,0:22:47.86,Default,,0000,0000,0000,,أقفلنا عليه حتماً، لكن لم نجده بأيّ مكان
Dialogue: 0,0:22:48.11,0:22:55.07,Default,,0000,0000,0000,,!كان تاكيشي من قتل أبي وتاتسو-سان إذاً
Dialogue: 0,0:22:55.90,0:22:57.85,Default,,0000,0000,0000,,صوت الارتطام الذي سمعه كونان
Dialogue: 0,0:22:57.85,0:23:00.99,Default,,0000,0000,0000,,كان صوت ضربة القاتل لتاتسو-سان غالباً
Dialogue: 0,0:23:01.52,0:23:02.65,Default,,0000,0000,0000,,وصوت الارتطام بالماء
Dialogue: 0,0:23:02.65,0:23:06.82,Default,,0000,0000,0000,,كان صوت رمي القاتل للسلاح\N...الذي استعمله، أو
Dialogue: 0,0:23:07.84,0:23:10.80,Default,,0000,0000,0000,,صوت قفزه في المحيط
Dialogue: 0,0:23:10.80,0:23:12.58,Default,,0000,0000,0000,,بعدما لم يعد له مفرّ
Dialogue: 0,0:23:13.71,0:23:15.03,Default,,0000,0000,0000,,تاكيشي-سان
Dialogue: 0,0:23:15.29,0:23:17.96,Default,,0000,0000,0000,,بأيّ حال، لا يزال هناك احتمال كبير
Dialogue: 0,0:23:17.96,0:23:20.21,Default,,0000,0000,0000,,بوجود القاتل على متن السفينة
Dialogue: 0,0:23:20.21,0:23:23.49,Default,,0000,0000,0000,,لنتراجع جميعاً لغرفة الطعام حالياً
Dialogue: 0,0:23:23.74,0:23:26.95,Default,,0000,0000,0000,,!أتقصد أنّه قد يحاول قتلي؟
Dialogue: 0,0:23:27.57,0:23:29.12,Default,,0000,0000,0000,,أنسيتِ؟
Dialogue: 0,0:23:29.12,0:23:32.95,Default,,0000,0000,0000,,كان دافعه للجريمة الأخذ بثأر أبيه\Nمن هاتاموتو غوزو
Dialogue: 0,0:23:32.95,0:23:35.69,Default,,0000,0000,0000,,الذي دفعه للانتحار قبل 10 أعوام
Dialogue: 0,0:23:35.69,0:23:37.86,Default,,0000,0000,0000,,...لا نستطيع استبعاد
Dialogue: 0,0:23:38.15,0:23:42.83,Default,,0000,0000,0000,,!أنه قد يحاول إبادة كلّ عائلة هاتاموتو
Dialogue: 0,0:24:00.38,0:24:04.99,Default,,0000,0000,0000,,!أعرف أنّ هناك رجالاً آخرين في حياتك
Dialogue: 0,0:24:04.99,0:24:08.36,Default,,0000,0000,0000,,!أنتِ أكثر من أراد إرثه
Dialogue: 0,0:24:08.95,0:24:11.28,Default,,0000,0000,0000,,حتى إيتشيرو اعتراه الغضب
Dialogue: 0,0:24:11.28,0:24:14.07,Default,,0000,0000,0000,,!بعدما مزّق جدّي رسمته المتوّجة بجائزة
Dialogue: 0,0:24:14.94,0:24:16.03,Default,,0000,0000,0000,,!إيتشيرو
Dialogue: 0,0:24:17.23,0:24:17.99,Default,,0000,0000,0000,,!ساقي
Dialogue: 0,0:24:18.23,0:24:19.87,Default,,0000,0000,0000,,...هذه سكّيني
Dialogue: 0,0:24:20.94,0:24:23.99,Default,,0000,0000,0000,,كلّ هذه الألغاز مربوطة بخيط
Dialogue: 0,0:24:24.93,0:24:26.22,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.22,0:24:29.35,Default,,0000,0000,0000,,سلسلة جرائم قتل السفينة السياحية الفاخرة\Nالجزء الثاني
Dialogue: 0,0:24:46.08,0:24:48.37,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.37,0:24:49.81,Default,,0000,0000,0000,,دفتر رسم
Dialogue: 0,0:24:49.81,0:24:51.81,Default,,0000,0000,0000,,

