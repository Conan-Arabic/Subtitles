Dialogue: 0,0:00:01.61,0:00:03.95,Default,,0000,0000,0000,,أجبرت منظمة ما المُتحري الشهير\N،في الثانوية، كودو شينتشي
Dialogue: 0,0:00:03.95,0:00:05.77,Default,,0000,0000,0000,,على تجرّع سم غريب
Dialogue: 0,0:00:05.77,0:00:08.28,Default,,0000,0000,0000,,!فتقلّص جسده وأصبح إيدوغاوا كونان
Dialogue: 0,0:00:08.28,0:00:09.48,Default,,0000,0000,0000,,!لا يهم صغر بنيتي
Dialogue: 0,0:00:09.48,0:00:11.48,Default,,0000,0000,0000,,!فدماغي ذاك لمُتحرٍّ في السابعة عشر
Dialogue: 0,0:00:11.48,0:00:14.52,Default,,0000,0000,0000,,سأحلّ قضيّة أخرى تستعصي\N!على البالغين اليوم
Dialogue: 0,0:01:46.92,0:01:52.78,Title,,0000,0000,0000,,{\fad(300,0)}قضيّة خريطة المدينة المشفرة
Dialogue: 0,0:01:47.97,0:01:51.25,Default,,0000,0000,0000,,قضيّة خريطة المدينة المشفرة
Dialogue: 0,0:01:53.16,0:01:58.32,On Top,,0000,0000,0000,,معرض كنوز العالم السرّية
Dialogue: 0,0:01:59.83,0:02:01.16,Default,,0000,0000,0000,,!جميل
Dialogue: 0,0:02:01.16,0:02:03.24,Default,,0000,0000,0000,,!هذا مُذهل
Dialogue: 0,0:02:03.62,0:02:05.70,Default,,0000,0000,0000,,!مبهر
Dialogue: 0,0:02:06.58,0:02:09.03,Default,,0000,0000,0000,,خريطة كنز مدفون؟
Dialogue: 0,0:02:09.03,0:02:10.48,Default,,0000,0000,0000,,كان ذلك مُسلياً
Dialogue: 0,0:02:10.48,0:02:13.24,Default,,0000,0000,0000,,أعجبني ذاك القناع الذهبي كثيراً
Dialogue: 0,0:02:13.24,0:02:15.57,Default,,0000,0000,0000,,لا تزال هناك كنوز كثيرة حول العالم
Dialogue: 0,0:02:15.57,0:02:18.21,Default,,0000,0000,0000,,لم تُكتشف بعد
Dialogue: 0,0:02:18.21,0:02:21.62,Default,,0000,0000,0000,,!صدقاً؟ أريد البحث عن واحد
Dialogue: 0,0:02:25.87,0:02:27.50,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:02:27.50,0:02:28.81,Default,,0000,0000,0000,,ماذا هناك؟
Dialogue: 0,0:02:29.33,0:02:30.83,Default,,0000,0000,0000,,ما خطب هذه الورقة؟
Dialogue: 0,0:02:30.83,0:02:33.27,Default,,0000,0000,0000,,بها عدّة رموز غريبة
Dialogue: 0,0:02:33.27,0:02:35.98,Default,,0000,0000,0000,,!لعلّها خريطة كنز
Dialogue: 0,0:02:37.00,0:02:38.99,Default,,0000,0000,0000,,خريطة كنز؟
Dialogue: 0,0:02:38.99,0:02:40.32,Default,,0000,0000,0000,,غير معقول
Dialogue: 0,0:02:41.49,0:02:44.99,Default,,0000,0000,0000,,!ماذا؟! لا تصدّق كلام أيومي؟
Dialogue: 0,0:02:44.99,0:02:46.11,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:02:46.11,0:02:48.36,Default,,0000,0000,0000,,لكن ماذا؟
Dialogue: 0,0:02:48.36,0:02:50.06,Default,,0000,0000,0000,,ما الذي يغضبكم هكذا؟
Dialogue: 0,0:02:50.06,0:02:51.68,Default,,0000,0000,0000,,!لكن ماذا؟
Dialogue: 0,0:02:51.68,0:02:52.98,Default,,0000,0000,0000,,!لنذهب لتفقد الأمر
Dialogue: 0,0:02:52.98,0:02:53.68,Default,,0000,0000,0000,,!أتفق
Dialogue: 0,0:02:53.68,0:02:55.06,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:55.06,0:02:58.23,Default,,0000,0000,0000,,!أيومي محقّة بلا شك
Dialogue: 0,0:02:58.23,0:02:59.84,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:02:59.84,0:03:02.84,Default,,0000,0000,0000,,ماذا لو كانت خريطة كنز حقيقية؟
Dialogue: 0,0:03:02.84,0:03:04.48,Default,,0000,0000,0000,,!بالفعل! ماذا لو كانت كذلك؟
Dialogue: 0,0:03:05.30,0:03:06.19,Default,,0000,0000,0000,,!لنذهب ونرى
Dialogue: 0,0:03:06.19,0:03:08.15,Default,,0000,0000,0000,,!تماماً
Dialogue: 0,0:03:08.15,0:03:11.14,Default,,0000,0000,0000,,!حسنٌ، لنذهب في رحلة بحث عن كنز
Dialogue: 0,0:03:11.14,0:03:13.98,Default,,0000,0000,0000,,!نحن المتحرّيون الصغار من اليوم فصاعداً
Dialogue: 0,0:03:14.37,0:03:16.46,Default,,0000,0000,0000,,ماذا؟ المتحرّيون الصغار؟
Dialogue: 0,0:03:16.46,0:03:17.94,Default,,0000,0000,0000,,!يبدو رائعاً
Dialogue: 0,0:03:18.33,0:03:21.03,Default,,0000,0000,0000,,!سأكون أنا، كوجيما غينتا، رئيس النادي
Dialogue: 0,0:03:21.03,0:03:22.20,Default,,0000,0000,0000,,أيّ اعتراضات؟
Dialogue: 0,0:03:22.20,0:03:23.56,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:03:23.56,0:03:26.15,Default,,0000,0000,0000,,...بدأ رأسي يؤلمني
Dialogue: 0,0:03:26.15,0:03:27.40,Default,,0000,0000,0000,,!لنذهب
Dialogue: 0,0:03:27.40,0:03:28.94,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:03:32.27,0:03:33.27,Default,,0000,0000,0000,,نذهب أين؟
Dialogue: 0,0:03:33.27,0:03:34.94,Default,,0000,0000,0000,,...لا-لا أدري
Dialogue: 0,0:03:36.11,0:03:38.40,Default,,0000,0000,0000,,أروني تلك الورقة قليلاً
Dialogue: 0,0:03:42.97,0:03:45.51,Default,,0000,0000,0000,,انظروا للرمز العلوي
Dialogue: 0,0:03:45.51,0:03:47.15,Default,,0000,0000,0000,,ألم يسبق ورأيتموه في مكان؟
Dialogue: 0,0:03:52.77,0:03:53.96,Default,,0000,0000,0000,,!بسرعة
Dialogue: 0,0:03:53.96,0:03:54.83,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:03:56.08,0:03:57.83,Default,,0000,0000,0000,,!هيّا
Dialogue: 0,0:04:02.11,0:04:05.53,Default,,0000,0000,0000,,اُعتقل زعيم الجريمة الإيطالي دينو كافاني
Dialogue: 0,0:04:05.53,0:04:11.06,Default,,0000,0000,0000,,،في مجمع شقق ليلة الأمس قرب برج طوكيو\Nويرفض الإدلاء بأقوال حتى الآن
Dialogue: 0,0:04:11.81,0:04:15.94,Default,,0000,0000,0000,,تلاحق الشرطة الآن رفاق كافاني
Dialogue: 0,0:04:15.94,0:04:18.11,Default,,0000,0000,0000,,لكنهم لم يجدوا دلائل تقودهم لمكانهم بعد
Dialogue: 0,0:04:18.11,0:04:21.39,Default,,0000,0000,0000,,موقع الخمسة عشر ألف عملة \Nميبل ليف" ذهبية التي سرقوها"
Dialogue: 0,0:04:21.39,0:04:23.23,Default,,0000,0000,0000,,مجهول أيضاً
Dialogue: 0,0:04:23.23,0:04:25.19,On Top,,0000,0000,0000,,إلى برج طوكيو
Dialogue: 0,0:04:28.39,0:04:31.63,Default,,0000,0000,0000,,!اشتبهتُ ببرج طوكيو منذ البداية
Dialogue: 0,0:04:31.63,0:04:34.19,Default,,0000,0000,0000,,!الكنز يكاد يكون لنا الآن
Dialogue: 0,0:04:36.46,0:04:38.38,Default,,0000,0000,0000,,لكن ما معنى هذه الأحرف برأيكم؟
Dialogue: 0,0:04:38.38,0:04:40.77,Default,,0000,0000,0000,,..."مكتوبٌ "أو آر أو
Dialogue: 0,0:04:41.07,0:04:43.61,Default,,0000,0000,0000,,(أورو؟ أوروتشي؟ (أفعى عملاقة
Dialogue: 0,0:04:43.73,0:04:45.66,Default,,0000,0000,0000,,!لا بدّ أنه اختصار
Dialogue: 0,0:04:45.66,0:04:48.03,Default,,0000,0000,0000,,!أوّل "أو" هي اختصار لـ "أووكي" والتي تعني كبير
Dialogue: 0,0:04:48.03,0:04:50.81,Default,,0000,0000,0000,,!و"آر" تعني غنيّ من الإنجليزيّة
Dialogue: 0,0:04:50.81,0:04:53.44,Default,,0000,0000,0000,,!بينما "أو" الأخيرة اختصار "أوتاكارا"، أي كنز
Dialogue: 0,0:04:53.44,0:04:58.56,Default,,0000,0000,0000,,!فذلك يعني كنزاً كبيراً سيجعلك ثريّاً
Dialogue: 0,0:04:58.97,0:05:02.27,Default,,0000,0000,0000,,مُذهل! لم أعلم أنك تجيد\N!قراءة الإنجليزية يا ميتسوهيكو
Dialogue: 0,0:05:03.39,0:05:04.80,Default,,0000,0000,0000,,حسناً، نوعاً ما
Dialogue: 0,0:05:08.92,0:05:10.92,Default,,0000,0000,0000,,!لا شكّ بأنه كنزٌ كبير
Dialogue: 0,0:05:10.92,0:05:12.14,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:05:12.14,0:05:16.11,Default,,0000,0000,0000,,حسنٌ! سأستعمل ذاك الكنز لأكل \N!أفضل أطباق الأنقليس في العالم
Dialogue: 0,0:05:16.11,0:05:18.70,Default,,0000,0000,0000,,!سأذهب في جولة حول العالم مئة مرّة
Dialogue: 0,0:05:18.70,0:05:22.06,Default,,0000,0000,0000,,سأشتري أنا مكوكاً فضائياً من "ناسا" وأذهب للفضاء
Dialogue: 0,0:05:22.33,0:05:23.83,Default,,0000,0000,0000,,ماذا عنك يا كونان-كن؟
Dialogue: 0,0:05:23.83,0:05:25.77,Default,,0000,0000,0000,,...أ-أظنني سأدّخره
Dialogue: 0,0:05:25.77,0:05:27.98,Default,,0000,0000,0000,,لا تعرف كيف تمرح
Dialogue: 0,0:05:28.45,0:05:29.86,Default,,0000,0000,0000,,أعتذر لذلك
Dialogue: 0,0:05:41.52,0:05:44.18,Default,,0000,0000,0000,,!حسنٌ، ها نحن
Dialogue: 0,0:05:44.18,0:05:46.48,Default,,0000,0000,0000,,!تبقى حلّ الشفرات فقط
Dialogue: 0,0:05:46.97,0:05:50.97,Default,,0000,0000,0000,,لكن جميع الرموز المتبقية\N...لا تشبه شيئاً
Dialogue: 0,0:05:50.97,0:05:52.18,Default,,0000,0000,0000,,باستثناء الشبيه بمظلّة
Dialogue: 0,0:05:55.71,0:05:58.93,Default,,0000,0000,0000,,!وجدتُها! إنّه القمر
Dialogue: 0,0:06:00.14,0:06:04.60,Default,,0000,0000,0000,,الكنز موجود حيث يكون القمر وبرج طوكيو\N!في نفس الخط بالتأكيد
Dialogue: 0,0:06:05.41,0:06:07.41,Default,,0000,0000,0000,,ذلك غير ممكن
Dialogue: 0,0:06:07.41,0:06:09.69,Default,,0000,0000,0000,,فموضع القمر يتغير يومياً
Dialogue: 0,0:06:09.69,0:06:13.57,Default,,0000,0000,0000,,كما أشك بإمكانك تحديد مواقع دقيقة\Nبرسومات بسيطة كهذه
Dialogue: 0,0:06:13.57,0:06:15.77,Default,,0000,0000,0000,,!أين هو إذاً؟
Dialogue: 0,0:06:15.98,0:06:19.02,Default,,0000,0000,0000,,هل اكتشفت شيئاً يا كونان-كن؟
Dialogue: 0,0:06:19.97,0:06:24.94,Default,,0000,0000,0000,,كنتُ أتساءل إن ما كانت الرموز الأخرى اختصارات لأشياء
Dialogue: 0,0:06:24.94,0:06:28.06,Default,,0000,0000,0000,,الرمز تحت البرج مثلاً قد يكون قبعة
Dialogue: 0,0:06:28.06,0:06:29.92,Default,,0000,0000,0000,,وما تحته قد يكون سروالاً داخلياً
Dialogue: 0,0:06:29.92,0:06:33.09,Default,,0000,0000,0000,,بينما المظلة أسفلهما قد تكون شعاراً \Nعلى سترة وما شابه
Dialogue: 0,0:06:33.60,0:06:36.56,Default,,0000,0000,0000,,...والشيء الذي يربطهم
Dialogue: 0,0:06:36.56,0:06:38.11,Default,,0000,0000,0000,,!متجر ثياب
Dialogue: 0,0:06:38.11,0:06:40.41,Default,,0000,0000,0000,,...لكن لا يكفي هذا لـ
Dialogue: 0,0:06:41.31,0:06:42.39,Default,,0000,0000,0000,,!أسرعوا
Dialogue: 0,0:06:42.66,0:06:44.08,Default,,0000,0000,0000,,!ا-انتظروا
Dialogue: 0,0:06:53.86,0:06:56.03,Default,,0000,0000,0000,,!ابحثوا عنه
Dialogue: 0,0:06:56.03,0:06:59.10,Default,,0000,0000,0000,,!لا بدّ من وجود دليل في مكان هنا
Dialogue: 0,0:06:59.10,0:07:02.64,Default,,0000,0000,0000,,!هيّا! أسرع
Dialogue: 0,0:07:03.77,0:07:06.19,Default,,0000,0000,0000,,!توقفوا أنتم الثلاثة
Dialogue: 0,0:07:09.27,0:07:11.27,Default,,0000,0000,0000,,!اخرجوا
Dialogue: 0,0:07:11.27,0:07:13.73,Default,,0000,0000,0000,,!أيّها المشاغبون
Dialogue: 0,0:07:13.73,0:07:15.67,Default,,0000,0000,0000,,!لا أريد رؤيتكم مُجدداً
Dialogue: 0,0:07:16.62,0:07:19.08,Default,,0000,0000,0000,,يبدو أنّها لم تكن مرتبطة بمحلّ ملابس
Dialogue: 0,0:07:19.08,0:07:19.86,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:19.86,0:07:21.10,Default,,0000,0000,0000,,أشعر بالجوع
Dialogue: 0,0:07:21.54,0:07:23.06,Default,,0000,0000,0000,,تريدون أكل شيء؟
Dialogue: 0,0:07:23.06,0:07:23.82,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:23.82,0:07:25.68,Default,,0000,0000,0000,,ما رأيكم أن نمرّ بمتجر كتب؟
Dialogue: 0,0:07:25.99,0:07:28.93,Default,,0000,0000,0000,,أحمق، لا يمكنك أكل شيء في متجر كتب
Dialogue: 0,0:07:29.36,0:07:31.11,Default,,0000,0000,0000,,قليلاً فقط، حسناً؟
Dialogue: 0,0:07:32.69,0:07:34.11,Default,,0000,0000,0000,,!مُذهل
Dialogue: 0,0:07:34.11,0:07:36.76,Default,,0000,0000,0000,,!انظروا لهذا! إنّه مضحك
Dialogue: 0,0:07:35.62,0:07:37.47,Default,,0000,0000,0000,,!معك حق
Dialogue: 0,0:07:37.47,0:07:40.18,Default,,0000,0000,0000,,أو آر أو"، أو-آر-أو"
Dialogue: 0,0:07:40.18,0:07:42.72,Default,,0000,0000,0000,,أكانت هناك كلمة كهذه في الإنجليزية؟
Dialogue: 0,0:07:44.26,0:07:46.18,Default,,0000,0000,0000,,لا فائدة، ليست هنا
Dialogue: 0,0:07:46.71,0:07:48.39,Default,,0000,0000,0000,,...مما يعني
Dialogue: 0,0:07:51.96,0:07:53.32,Default,,0000,0000,0000,,...الإيطالية
Dialogue: 0,0:07:57.62,0:07:59.03,Default,,0000,0000,0000,,أشكّ في ذلك
Dialogue: 0,0:08:01.52,0:08:02.95,Default,,0000,0000,0000,,!ها هي
Dialogue: 0,0:08:02.95,0:08:06.47,Default,,0000,0000,0000,,!أو آر أو" تعني الذهب في الإيطالية"
Dialogue: 0,0:08:06.86,0:08:11.86,Default,,0000,0000,0000,,مما يعني أن هذا الرمز\N!يدلّ لمكان الكنز حقاً
Dialogue: 0,0:08:12.82,0:08:15.22,Default,,0000,0000,0000,,...رفاق زعيم الجريمة الإيطالي دينو كافاني
Dialogue: 0,0:08:15.22,0:08:19.85,Default,,0000,0000,0000,,الذي اُعتقل بالأمس متواجدون\Nفي اليابان حالياً
Dialogue: 0,0:08:19.85,0:08:23.31,Default,,0000,0000,0000,,موقع الخمسة عشر ألف عملة \N...ورق القيقب" ذهبية التي سرقوها"
Dialogue: 0,0:08:23.31,0:08:25.26,Default,,0000,0000,0000,,لا يزال مجهولاً
Dialogue: 0,0:08:25.26,0:08:29.25,Default,,0000,0000,0000,,العملات التي تتجاوز قيمتها ستمئة\N...مليون ينّ ياباني كانت قد
Dialogue: 0,0:08:29.25,0:08:32.75,Default,,0000,0000,0000,,ستّمئة مليون؟ يعرفون ما يفعلون
Dialogue: 0,0:08:32.75,0:08:35.72,Default,,0000,0000,0000,,!ترمي القمامة في المكان مجدداً؟
Dialogue: 0,0:08:35.99,0:08:38.60,Default,,0000,0000,0000,,!لا أمل منك
Dialogue: 0,0:08:41.98,0:08:45.07,Default,,0000,0000,0000,,بالمناسبة، أين ذاك الفتى؟
Dialogue: 0,0:08:45.07,0:08:47.07,Default,,0000,0000,0000,,إن كنتَ تقصد كونان-كن\Nفقد غادر في الصباح الباكر
Dialogue: 0,0:08:47.07,0:08:49.23,Default,,0000,0000,0000,,للذهاب لمعرض الفنون مع أصدقائه
Dialogue: 0,0:08:50.36,0:08:53.77,Default,,0000,0000,0000,,الأطفال في نعيم حقّاً
Dialogue: 0,0:08:54.28,0:08:57.97,Default,,0000,0000,0000,,!أبي! ساعدني بالتنظيف على الأقل
Dialogue: 0,0:08:59.72,0:09:00.93,Default,,0000,0000,0000,,حسناً، حسناً
Dialogue: 0,0:09:00.93,0:09:02.94,Default,,0000,0000,0000,,،وفقاً للشرطة الإيطالية
Dialogue: 0,0:09:03.27,0:09:10.02,Default,,0000,0000,0000,,ثلاثة من رفاق كافاني طليقون حالياً، وأحدهم يابانيّ
Dialogue: 0,0:09:18.08,0:09:19.79,Default,,0000,0000,0000,,ما خطب كونان-كن؟
Dialogue: 0,0:09:19.79,0:09:23.41,Default,,0000,0000,0000,,كيف لي أن أعرف؟ كان ذلك \Nكلّ ما يفعله مذ وصلنا
Dialogue: 0,0:09:23.41,0:09:25.30,Default,,0000,0000,0000,,لعلّه اكتشف شيئاً
Dialogue: 0,0:09:25.65,0:09:28.27,Default,,0000,0000,0000,,لا فائدة، لا أستطيع حلّها
Dialogue: 0,0:09:28.78,0:09:31.28,Default,,0000,0000,0000,,ما هذه الشفرة؟
Dialogue: 0,0:09:31.28,0:09:34.97,Default,,0000,0000,0000,,أهي خريطة؟ أم رسالة ما؟
Dialogue: 0,0:09:36.14,0:09:37.68,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:09:39.89,0:09:41.19,Default,,0000,0000,0000,,!انظروا
Dialogue: 0,0:09:41.39,0:09:43.40,Default,,0000,0000,0000,,أيمكن أنها تلك؟
Dialogue: 0,0:09:43.40,0:09:47.22,Default,,0000,0000,0000,,!تلك اللافتة! تشبه الرمز الثاني تماماً
Dialogue: 0,0:09:47.22,0:09:49.38,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:09:49.38,0:09:50.10,Default,,0000,0000,0000,,...مما يعني
Dialogue: 0,0:09:50.97,0:09:52.88,Default,,0000,0000,0000,,...هذه الرموز لعلها تمثل
Dialogue: 0,0:09:54.79,0:09:58.93,Default,,0000,0000,0000,,لا بد أنّها هي! هذا المتجر\Nأمام برج طوكيو تماماً
Dialogue: 0,0:09:59.37,0:10:03.48,Default,,0000,0000,0000,,!ويحمل الرمز التالي شكل هذه اللافتة
Dialogue: 0,0:10:03.48,0:10:08.07,Default,,0000,0000,0000,,!إن اتبعنا ترتيب لافتات المتاجر هذا إذاً، سنصل الكنز
Dialogue: 0,0:10:08.07,0:10:11.14,Default,,0000,0000,0000,,لكن أين نذهب من هنا؟
Dialogue: 0,0:10:17.85,0:10:20.23,Default,,0000,0000,0000,,!شارع منظر القمر
Dialogue: 0,0:10:20.23,0:10:24.68,Default,,0000,0000,0000,,أيمكن أن رمز القمر بقرب البرج\Nيمثل شارع منظر القمر؟
Dialogue: 0,0:10:24.68,0:10:26.81,Default,,0000,0000,0000,,!بالتأكيد كذلك! هيّا بنا
Dialogue: 0,0:10:26.81,0:10:27.64,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:10:30.26,0:10:31.77,Default,,0000,0000,0000,,!انظروا! ها هي
Dialogue: 0,0:10:31.77,0:10:33.77,Default,,0000,0000,0000,,!لافتة مثلّث مقلوب
Dialogue: 0,0:10:33.77,0:10:37.10,Default,,0000,0000,0000,,!بالفعل! كالرمز الثالث تماماً
Dialogue: 0,0:10:37.58,0:10:40.85,Default,,0000,0000,0000,,...هذه الرموز تمثل بالفعل إذاً
Dialogue: 0,0:10:41.33,0:10:43.33,Default,,0000,0000,0000,,!معرض مائي
Dialogue: 0,0:10:43.33,0:10:45.66,Default,,0000,0000,0000,,!ها هي! وجدتُها
Dialogue: 0,0:10:45.66,0:10:49.28,Default,,0000,0000,0000,,هذه الشفرة خريطة من برج\Nطوكيو إلى معرض نانبو المائي
Dialogue: 0,0:10:49.28,0:10:53.77,Default,,0000,0000,0000,,رسموا شعارات ولافتات المتاجر\N!على شارع منظر القمر
Dialogue: 0,0:10:55.31,0:10:57.72,Default,,0000,0000,0000,,...والوجهة الأخيرة
Dialogue: 0,0:10:57.72,0:10:59.56,Default,,0000,0000,0000,,!جبل كنز
Dialogue: 0,0:10:59.98,0:11:01.48,Default,,0000,0000,0000,,!حسنٌ! لننطلق
Dialogue: 0,0:11:01.48,0:11:02.81,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:11:16.79,0:11:20.00,Default,,0000,0000,0000,,لم أرَ رمز النجمة الخامس في أيّ مكان
Dialogue: 0,0:11:20.00,0:11:24.13,Default,,0000,0000,0000,,!تبّاً! كنا قريبين جدّاً للكنز
Dialogue: 0,0:11:24.13,0:11:25.10,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:25.60,0:11:27.56,Default,,0000,0000,0000,,!وصلنا المعرض المائي
Dialogue: 0,0:11:28.07,0:11:29.91,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:11:29.91,0:11:31.91,Default,,0000,0000,0000,,كيف هذا؟
Dialogue: 0,0:11:31.91,0:11:35.44,Default,,0000,0000,0000,,لم نجد الرمز الخامس على شارع منظر القمر
Dialogue: 0,0:11:35.44,0:11:38.52,Default,,0000,0000,0000,,بين برج طوكيو ومعرض نانبو المائي
Dialogue: 0,0:11:38.52,0:11:40.81,Default,,0000,0000,0000,,أم هناك خلل في استنتاجي؟
Dialogue: 0,0:11:41.44,0:11:45.51,Default,,0000,0000,0000,,لحظة، لمَ كُتب "الذهب" باللغة الإيطالية؟
Dialogue: 0,0:11:45.51,0:11:48.64,Default,,0000,0000,0000,,...إن كان من كتب هذه شخص إيطالي، فرمز القمر
Dialogue: 0,0:11:50.51,0:11:51.48,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:11:53.73,0:11:56.30,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:11:58.12,0:12:00.31,Default,,0000,0000,0000,,!لنرجع لمكان بدايتنا
Dialogue: 0,0:12:00.73,0:12:02.79,Default,,0000,0000,0000,,!انتظر! كونان
Dialogue: 0,0:12:12.74,0:12:15.76,Default,,0000,0000,0000,,من الصعب اعتقاد أنّ شخصاً كتب "ذهب" بالإيطالية
Dialogue: 0,0:12:15.76,0:12:18.27,Default,,0000,0000,0000,,سيستعمل رمز القمر لتمثيل شارع منظر القمر
Dialogue: 0,0:12:18.27,0:12:19.18,Default,,0000,0000,0000,,!المُسمى باليابانية
Dialogue: 0,0:12:19.18,0:12:22.77,Default,,0000,0000,0000,,القمر يمثل الليل والأشياء التي لا تراها سوى ليلاً
Dialogue: 0,0:12:23.40,0:12:25.47,Default,,0000,0000,0000,,!لافتات النيون
Dialogue: 0,0:12:25.89,0:12:28.68,Default,,0000,0000,0000,,كونان! ما الذي اكتشفته؟
Dialogue: 0,0:12:29.46,0:12:33.40,Default,,0000,0000,0000,,إنّها خريطة كنز من أشكال\Nلافتات نيون مختلفة
Dialogue: 0,0:12:34.26,0:12:37.24,Default,,0000,0000,0000,,!لافتة نيون في الرمز الثاني هي تلك
Dialogue: 0,0:12:43.91,0:12:45.14,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:12:45.14,0:12:47.10,Default,,0000,0000,0000,,!معك حق
Dialogue: 0,0:12:47.10,0:12:49.57,Default,,0000,0000,0000,,!سنذهب لذاك الملعب تالياً إذاً
Dialogue: 0,0:12:49.57,0:12:52.31,Default,,0000,0000,0000,,!علينا إيجاد لافتة بشكل مظلة فقط
Dialogue: 0,0:12:53.02,0:12:56.14,Default,,0000,0000,0000,,لا أرى أيّ لافتة نيون بشكل مظلة
Dialogue: 0,0:12:56.14,0:12:58.56,Default,,0000,0000,0000,,أأنت متأكد من استنتاجك؟
Dialogue: 0,0:12:58.56,0:13:00.73,Default,,0000,0000,0000,,وجدتُها بالفعل
Dialogue: 0,0:13:01.43,0:13:02.35,On Top,,0000,0000,0000,,طقس الغد
Dialogue: 0,0:13:01.73,0:13:02.71,Default,,0000,0000,0000,,هناك
Dialogue: 0,0:13:04.59,0:13:07.18,Default,,0000,0000,0000,,ما الذي تقوله؟ إنّها الشمس
Dialogue: 0,0:13:08.22,0:13:10.42,Default,,0000,0000,0000,,!فهمت! رمز المطر
Dialogue: 0,0:13:10.42,0:13:14.23,Default,,0000,0000,0000,,كان توقع الطقس مطراً لليوم\N!الذي يعقب كتابتهم للشفرة
Dialogue: 0,0:13:15.41,0:13:17.43,Default,,0000,0000,0000,,!التالي هو لافتة نيون بشكل نجم
Dialogue: 0,0:13:20.87,0:13:22.60,Default,,0000,0000,0000,,!وجدتُها
Dialogue: 0,0:13:22.60,0:13:24.49,Default,,0000,0000,0000,,!هذه هي بالتأكيد
Dialogue: 0,0:13:24.49,0:13:26.36,Default,,0000,0000,0000,,!عجلة فيريس
Dialogue: 0,0:13:26.36,0:13:29.31,Default,,0000,0000,0000,,!لا شكّ هناك! إنّه الرمز الخامس
Dialogue: 0,0:13:29.49,0:13:32.19,Default,,0000,0000,0000,,يُفترض أن نرى اللافتة السادسة من هنا إذاً
Dialogue: 0,0:13:32.19,0:13:34.64,Default,,0000,0000,0000,,!أين هي؟ أين؟
Dialogue: 0,0:13:46.59,0:13:49.43,Default,,0000,0000,0000,,!تلك! لافتة النيون السادسة
Dialogue: 0,0:13:55.54,0:13:59.33,Default,,0000,0000,0000,,كونان، يوجد كنز هنا حقاً، صحيح؟
Dialogue: 0,0:13:59.33,0:14:04.57,Default,,0000,0000,0000,,أجل، فـ"أو آر أو" مكتوبة بجوار هذا الرمز
Dialogue: 0,0:14:04.57,0:14:07.85,Default,,0000,0000,0000,,كنتُ أبحث عن اللافتة بشكل السمكة الأخيرة
Dialogue: 0,0:14:08.46,0:14:11.81,Default,,0000,0000,0000,,لكن لم أجدها بعد
Dialogue: 0,0:14:12.17,0:14:13.56,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:14:13.56,0:14:16.29,Default,,0000,0000,0000,,فهذا شارع سكني، لا شيء به
Dialogue: 0,0:14:16.29,0:14:19.08,Default,,0000,0000,0000,,السمك الذي ستجده قد يكون \Nفي نهر قريب فقط
Dialogue: 0,0:14:19.08,0:14:20.93,Default,,0000,0000,0000,,!ها هو! النهر
Dialogue: 0,0:14:20.93,0:14:23.39,Default,,0000,0000,0000,,!المقصود حتماً هو نهر يحتوي على سمك
Dialogue: 0,0:14:23.39,0:14:24.05,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:24.05,0:14:26.67,Default,,0000,0000,0000,,!حسناً! لنذهب لتفقد النهر
Dialogue: 0,0:14:28.21,0:14:29.56,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:14:30.84,0:14:34.70,Default,,0000,0000,0000,,يكفي يا غينتا-كن، توقف
Dialogue: 0,0:14:35.97,0:14:37.99,Default,,0000,0000,0000,,!هذا خطر
Dialogue: 0,0:14:37.99,0:14:41.87,Default,,0000,0000,0000,,!اصمتي! الكنز في قاع هذا النهر حتماً
Dialogue: 0,0:14:42.87,0:14:43.94,Default,,0000,0000,0000,,!بارد
Dialogue: 0,0:14:44.33,0:14:49.89,Default,,0000,0000,0000,,كلا! شفرة هذه الخريطة تحوي رموز\Nأشياء تراها ليلاً فقط
Dialogue: 0,0:14:50.19,0:14:53.98,Default,,0000,0000,0000,,فلا يمكن أن يمثل رمز السمكة الأخير النهر
Dialogue: 0,0:14:54.97,0:14:59.14,Default,,0000,0000,0000,,إن كان استنتاجي صحيحاً، فلا بد\Nمن وجودها بالقرب
Dialogue: 0,0:14:59.14,0:15:01.06,Default,,0000,0000,0000,,ضوء نيون بشكل سمكة
Dialogue: 0,0:15:15.79,0:15:17.10,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:15:20.04,0:15:21.75,Default,,0000,0000,0000,,وجدتُها أخيراً
Dialogue: 0,0:15:22.70,0:15:24.29,Default,,0000,0000,0000,,السمكة المضيئة
Dialogue: 0,0:15:26.36,0:15:28.47,Default,,0000,0000,0000,,سمكة مضيئة؟
Dialogue: 0,0:15:28.47,0:15:30.98,Default,,0000,0000,0000,,أين يوجد شيء كذاك؟
Dialogue: 0,0:15:31.90,0:15:33.44,Default,,0000,0000,0000,,اتبعوني فقط
Dialogue: 0,0:15:33.44,0:15:34.93,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:15:35.85,0:15:39.64,Default,,0000,0000,0000,,أتوجد سمكة مضيئة هنا حقاً؟
Dialogue: 0,0:15:40.89,0:15:44.59,Default,,0000,0000,0000,,!أنت! لا تستطيع رؤية شيء في الظلام، فكيف بالسمك
Dialogue: 0,0:15:45.09,0:15:47.31,Default,,0000,0000,0000,,انظروا للخارج من هنا
Dialogue: 0,0:15:47.67,0:15:48.84,Default,,0000,0000,0000,,نحو ذاك النهر
Dialogue: 0,0:15:48.84,0:15:49.98,Default,,0000,0000,0000,,النهر؟
Dialogue: 0,0:15:50.38,0:15:51.81,Default,,0000,0000,0000,,!أترون؟ هناك
Dialogue: 0,0:15:52.09,0:15:54.27,Default,,0000,0000,0000,,!تلك هي السمكة المضيئة
Dialogue: 0,0:15:57.13,0:16:00.25,Default,,0000,0000,0000,,!الأنوار المعكوسة على الماء تشكّل منظر سمكة
Dialogue: 0,0:16:00.25,0:16:03.31,Default,,0000,0000,0000,,!وعين السمكة هي ضوء المبنى أمامنا
Dialogue: 0,0:16:03.31,0:16:05.86,Default,,0000,0000,0000,,!أي أن الكنز هنا؟
Dialogue: 0,0:16:05.86,0:16:06.82,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:16:06.82,0:16:09.36,Default,,0000,0000,0000,,...موقعه غالباً
Dialogue: 0,0:16:17.27,0:16:18.10,Default,,0000,0000,0000,,هنا
Dialogue: 0,0:16:22.52,0:16:23.60,Default,,0000,0000,0000,,عملة ذهبية؟
Dialogue: 0,0:16:27.30,0:16:30.09,Default,,0000,0000,0000,,ما ذاك الظلّ الأسود؟
Dialogue: 0,0:16:30.09,0:16:31.73,Default,,0000,0000,0000,,يبدو أنّه مربوط بحبل
Dialogue: 0,0:16:32.67,0:16:33.97,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:16:33.97,0:16:36.13,Default,,0000,0000,0000,,رفعوا أكياس العملات الذهبية
Dialogue: 0,0:16:36.13,0:16:38.37,Default,,0000,0000,0000,,!بربط الحبل حول جزء بارز من السقف
Dialogue: 0,0:16:45.93,0:16:48.14,Default,,0000,0000,0000,,!الكنز! إنّه الكنز
Dialogue: 0,0:16:53.40,0:16:55.89,Default,,0000,0000,0000,,شكراً على المساعدة يا صغار
Dialogue: 0,0:16:55.89,0:16:58.56,Default,,0000,0000,0000,,مـ-من أنتم؟
Dialogue: 0,0:16:58.89,0:17:01.52,Default,,0000,0000,0000,,ألم يكونوا الأشخاص أمام برج طوكيو؟
Dialogue: 0,0:17:02.85,0:17:04.47,Default,,0000,0000,0000,,...أيمكن أنهم
Dialogue: 0,0:17:04.47,0:17:07.72,Default,,0000,0000,0000,,!أعده! نحن من وجدناه أولاً
Dialogue: 0,0:17:07.72,0:17:09.06,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:17:10.55,0:17:12.48,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:17:12.48,0:17:14.94,Default,,0000,0000,0000,,أأنت بخير يا غينتا-كن؟
Dialogue: 0,0:17:16.70,0:17:20.95,Default,,0000,0000,0000,,هكذا إذاً، لا يزالون يجهلون مكان العملات
Dialogue: 0,0:17:20.95,0:17:23.82,Default,,0000,0000,0000,,من هؤلاء الأشخاص؟
Dialogue: 0,0:17:23.82,0:17:26.22,Default,,0000,0000,0000,,أفراد عصابة إيطالية غالباً
Dialogue: 0,0:17:26.22,0:17:28.40,Default,,0000,0000,0000,,!أفراد عصابة؟
Dialogue: 0,0:17:28.40,0:17:31.52,Default,,0000,0000,0000,,!صحيح، سمعت عنهم في أخبار التلفاز
Dialogue: 0,0:17:31.52,0:17:34.35,Default,,0000,0000,0000,,...هذا يعني أنّ تلك العملات
Dialogue: 0,0:17:34.35,0:17:36.14,Default,,0000,0000,0000,,بالضبط
Dialogue: 0,0:17:36.85,0:17:41.93,Default,,0000,0000,0000,,سرقنا تلك العملات من مصرف إيطالي قبل عام
Dialogue: 0,0:17:41.93,0:17:44.34,Default,,0000,0000,0000,,كما أمرنا زعيمنا كافاني
Dialogue: 0,0:17:44.85,0:17:48.84,Default,,0000,0000,0000,,لكنّه خاننا وهرب لليابان
Dialogue: 0,0:17:48.84,0:17:53.75,Default,,0000,0000,0000,,ومعه الخمسة عشر ألف عملة "ورق القيقب" بالطبع
Dialogue: 0,0:17:53.75,0:17:57.66,Default,,0000,0000,0000,,!تعقّبناه لليابان وزرناه
Dialogue: 0,0:17:57.66,0:18:00.87,Default,,0000,0000,0000,,!لكن كان قد أخبأ العملات في مكانٍ ما سلفاً
Dialogue: 0,0:18:01.99,0:18:05.60,Default,,0000,0000,0000,,رفض إخبارنا بالموقع رغم استجوابنا له عدّة مرّات
Dialogue: 0,0:18:06.02,0:18:09.82,Default,,0000,0000,0000,,كلّ ما وجدناه في غرفته هي هذه الشفرة
Dialogue: 0,0:18:09.82,0:18:13.32,Default,,0000,0000,0000,,رفض مساعدتنا فأخبرنا الشرطة بمكانه
Dialogue: 0,0:18:13.32,0:18:17.89,Default,,0000,0000,0000,,وخرجنا للبحث عن العملات بأنفسنا\Nبالاعتماد على هذه الشفرة
Dialogue: 0,0:18:18.76,0:18:22.64,Default,,0000,0000,0000,,قذفت الرّيح الورقةَ بعيداً عندما توقّفنا عند معرض الفنون
Dialogue: 0,0:18:23.48,0:18:26.38,Default,,0000,0000,0000,,لكنّنا رأيناكم تحلّون الشفرة رويداً رويداً
Dialogue: 0,0:18:26.38,0:18:28.60,Default,,0000,0000,0000,,فقرّرنا السماح لكم بالمواصلة
Dialogue: 0,0:18:28.84,0:18:32.71,Default,,0000,0000,0000,,!لكن لم يخطر لنا أن تجدوه حقّاً
Dialogue: 0,0:18:35.01,0:18:36.95,Default,,0000,0000,0000,,!مـ-مسدس
Dialogue: 0,0:18:40.98,0:18:42.94,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:18:43.28,0:18:46.39,Default,,0000,0000,0000,,!أخبرني! أين العملات؟! أين؟
Dialogue: 0,0:18:47.07,0:18:48.35,Default,,0000,0000,0000,,!تكلّم فوراً
Dialogue: 0,0:18:51.10,0:18:52.77,Default,,0000,0000,0000,,السمكة
Dialogue: 0,0:18:52.77,0:18:53.51,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:18:53.73,0:18:56.55,Default,,0000,0000,0000,,العملات مخبأة حيث يتطابق رمز السمكة
Dialogue: 0,0:18:56.55,0:19:00.80,Default,,0000,0000,0000,,مع المنظر الليلي للجسر خارجاً
Dialogue: 0,0:19:01.47,0:19:03.13,Default,,0000,0000,0000,,فـ-فهمت
Dialogue: 0,0:19:07.92,0:19:10.62,Default,,0000,0000,0000,,كونان! لمَ أخبرتهم؟
Dialogue: 0,0:19:10.62,0:19:14.24,Default,,0000,0000,0000,,سيتخلصون منا حتماً حالما يجدون الكنز
Dialogue: 0,0:19:14.24,0:19:17.09,Default,,0000,0000,0000,,سيتخلّصون منا أيّاً يكن
Dialogue: 0,0:19:17.36,0:19:22.05,Default,,0000,0000,0000,,هل سيردوننا قتلى يا ترى؟
Dialogue: 0,0:19:22.05,0:19:26.50,Default,,0000,0000,0000,,سيغرقوننا بالإسمنت ويرموننا في المحيط بالتأكيد
Dialogue: 0,0:19:26.81,0:19:30.97,Default,,0000,0000,0000,,كلا، سيحرقوننا حتى الموت كيلا يبقى أثر
Dialogue: 0,0:19:31.07,0:19:33.12,Default,,0000,0000,0000,,...أمّي
Dialogue: 0,0:19:33.12,0:19:34.90,Default,,0000,0000,0000,,...أبي
Dialogue: 0,0:19:34.90,0:19:36.53,Default,,0000,0000,0000,,...ماما
Dialogue: 0,0:19:39.61,0:19:41.73,Default,,0000,0000,0000,,من المبكر الاستسلام
Dialogue: 0,0:19:42.86,0:19:45.35,Default,,0000,0000,0000,,لا تزال لدينا فرصة
Dialogue: 0,0:19:45.35,0:19:47.52,Default,,0000,0000,0000,,!إن تكاتفنا بالطبع
Dialogue: 0,0:19:47.52,0:19:50.06,Default,,0000,0000,0000,,ما يسعنا فعله؟
Dialogue: 0,0:19:50.06,0:19:52.24,Default,,0000,0000,0000,,!نحن مجرد أطفال
Dialogue: 0,0:19:52.52,0:19:54.77,Default,,0000,0000,0000,,!ألسنا المتحريين الصغار؟
Dialogue: 0,0:19:57.15,0:19:59.23,Default,,0000,0000,0000,,حسناً! ماذا علينا أن نفعل؟
Dialogue: 0,0:19:59.63,0:20:01.92,Default,,0000,0000,0000,,انهضوا، انتبهوا من أن يلاحظوكم
Dialogue: 0,0:20:07.87,0:20:09.54,Default,,0000,0000,0000,,لدينا فرصة واحدة
Dialogue: 0,0:20:15.36,0:20:20.08,Default,,0000,0000,0000,,...حالما يجدون العملات ويتشتّت انتباههم
Dialogue: 0,0:20:23.28,0:20:24.14,Default,,0000,0000,0000,,!الآن
Dialogue: 0,0:20:24.14,0:20:25.60,Default,,0000,0000,0000,,!اركضوا
Dialogue: 0,0:20:53.29,0:20:56.06,Default,,0000,0000,0000,,!نجحنا
Dialogue: 0,0:20:57.84,0:21:00.82,Default,,0000,0000,0000,,توجّهنا لمركز شرطة قريب بعدها
Dialogue: 0,0:21:00.82,0:21:02.90,Default,,0000,0000,0000,,وشرحنا كلّ ما حدث
Dialogue: 0,0:21:03.24,0:21:07.48,Default,,0000,0000,0000,,اُعتقل أفراد العصابة وأُقفلت القضية
Dialogue: 0,0:21:07.48,0:21:11.27,Default,,0000,0000,0000,,!وكان إنجازنا الأول لنا نحن، المتحرّيون الصغار
Dialogue: 0,0:22:58.64,0:23:00.50,Default,,0000,0000,0000,,أنتم مذهلون
Dialogue: 0,0:23:00.50,0:23:02.49,Default,,0000,0000,0000,,!حللتم تلك الشفرة
Dialogue: 0,0:23:03.10,0:23:04.84,Default,,0000,0000,0000,,!كما قبضتم على لصوص
Dialogue: 0,0:23:04.84,0:23:07.80,Default,,0000,0000,0000,,!كان أنا! أنا قبضت عليهم
Dialogue: 0,0:23:07.80,0:23:11.09,Default,,0000,0000,0000,,!وحللتُ الشفرة باستنتاجي
Dialogue: 0,0:23:12.76,0:23:14.41,Default,,0000,0000,0000,,لا تصغي لهما
Dialogue: 0,0:23:14.41,0:23:20.78,Default,,0000,0000,0000,,!كان كونان-كن من حلّ الشفرة وغلب العصابة
Dialogue: 0,0:23:22.54,0:23:25.27,Default,,0000,0000,0000,,!كان رائعاً جدّاً
Dialogue: 0,0:23:30.82,0:23:32.24,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:23:32.57,0:23:33.07,On Top,,0000,0000,0000,,قُبلة
Dialogue: 0,0:23:33.45,0:23:34.81,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:23:38.40,0:23:43.61,Default,,0000,0000,0000,,!سررتُ لأجلك يا كونان-كن! حصلت على حبيبة ظريفة
Dialogue: 0,0:23:43.61,0:23:46.05,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:23:46.05,0:23:48.26,Default,,0000,0000,0000,,!تحمر خجلاً! يا للظرافة
Dialogue: 0,0:23:48.26,0:23:51.43,Default,,0000,0000,0000,,!أخبرتك، كلا
Dialogue: 0,0:23:53.65,0:23:54.91,Default,,0000,0000,0000,,كونان الوغد
Dialogue: 0,0:23:56.15,0:23:57.57,Default,,0000,0000,0000,,كونان الوغد
Dialogue: 0,0:24:02.85,0:24:05.32,Default,,0000,0000,0000,,!تبّاً! لا يزال هناك ما أريد سؤالكما عنه
Dialogue: 0,0:24:06.00,0:24:07.77,Default,,0000,0000,0000,,من يحمل القنبلة؟
Dialogue: 0,0:24:07.96,0:24:10.00,Default,,0000,0000,0000,,...ماذا؟ أين هي؟ لا أستطيع
Dialogue: 0,0:24:17.54,0:24:20.25,Default,,0000,0000,0000,,هناك طريقة واحدة لجعلها تصدقني
Dialogue: 0,0:24:20.25,0:24:22.91,Default,,0000,0000,0000,,!وهي أن أخبرها أنّي كودو سينتشي الحقيقي
Dialogue: 0,0:24:24.53,0:24:26.19,Default,,0000,0000,0000,,ما هويّتك بالضبط؟
Dialogue: 0,0:24:26.74,0:24:27.99,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.99,0:24:30.10,Default,,0000,0000,0000,,انفجار قطار الطلقة الكبير
Dialogue: 0,0:24:49.07,0:24:50.63,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:51.01,0:24:53.01,Default,,0000,0000,0000,,هاتف خلوي
Dialogue: 0,0:24:54.21,0:24:56.29,Default,,0000,0000,0000,,الحلقة القادمة ستكون مثيرةً وحماسية أيضاً
Dialogue: 0,0:24:56.29,0:24:57.66,Default,,0000,0000,0000,,!عليكم مشاهدتها حتماً

