Dialogue: 0,0:00:02.06,0:00:03.85,Default,,0000,0000,0000,,عقرب دقائق مسرِع، سديمٌ لامع
Dialogue: 0,0:00:03.85,0:00:07.35,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.58,0:00:09.55,Default,,0000,0000,0000,,!مسرح اليوم على جبل مجدداً
Dialogue: 0,0:00:09.55,0:00:11.43,Default,,0000,0000,0000,,!القضيّة تُحلّ ببراعة في الهواء الطلق
Dialogue: 0,0:00:11.43,0:00:13.12,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:13.12,0:00:14.13,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.13,0:00:16.54,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:52.99,0:01:55.74,Default,,0000,0000,0000,,قبل 6 أشهر، نفّذ القاتل المستأجر المعروف بالثعلب
Dialogue: 0,0:01:55.74,0:01:58.42,Default,,0000,0000,0000,,عملية قتل ببراعة واختفى بلا آثار
Dialogue: 0,0:01:59.08,0:02:02.78,Default,,0000,0000,0000,,عيّن رئيس إحدى الوكالات العقارية\Nويُدعى أوشيو بونزو
Dialogue: 0,0:02:02.78,0:02:06.28,Default,,0000,0000,0000,,الثعلب لقتله، بغرابة الأمر
Dialogue: 0,0:02:06.28,0:02:08.78,Default,,0000,0000,0000,,،رافقتُه مع ران والعمّ
Dialogue: 0,0:02:08.78,0:02:12.43,Default,,0000,0000,0000,,الذي عُيّن ليكون حارسه الشخصيّ، لتسلّق الجبال
Dialogue: 0,0:02:14.43,0:02:19.50,Default,,0000,0000,0000,,المتسلّقون الخمسة الآخرون كانوا \Nتاكاناشي واتارو، إداريّ شركة
Dialogue: 0,0:02:19.93,0:02:22.48,Default,,0000,0000,0000,,هيراي كينيتشي، عضو في نادي تسلّق جبال جامعي
Dialogue: 0,0:02:23.59,0:02:25.59,Default,,0000,0000,0000,,نوسي شينغو، روائيّ
Dialogue: 0,0:02:26.92,0:02:32.12,Default,,0000,0000,0000,,والمتسلّقان سايغوسا كيوكو وكوابي أكيرا
Dialogue: 0,0:02:32.12,0:02:36.16,Default,,0000,0000,0000,,هناك احتمالٌ عالٍ بكون الثعلب\Nأحد هؤلاء الخمسة
Dialogue: 0,0:02:36.16,0:02:42.00,Default,,0000,0000,0000,,بما أنّ أوشيو-سان طلب من الثعلب\Nأن يقتله أثناء تسلّقه الجبال
Dialogue: 0,0:02:43.37,0:02:45.33,Default,,0000,0000,0000,,وقعت جريمة القتل الأولى
Dialogue: 0,0:02:45.33,0:02:48.06,Default,,0000,0000,0000,,وتراكمت الشكوك حول هويّة الفاعل
Dialogue: 0,0:02:49.36,0:02:51.89,Default,,0000,0000,0000,,...ثمّ الآن مجدداً
Dialogue: 0,0:02:58.04,0:03:04.24,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل تسلّق الجبال المخيفة\N(الجزء الثاني)
Dialogue: 0,0:02:59.02,0:03:03.05,Default,,0000,0000,0000,,جريمة قتل تسلّق الجبال المخيفة\N(الجزء الثاني)
Dialogue: 0,0:03:04.78,0:03:07.08,Default,,0000,0000,0000,,!ران! أنا قادم! انتظريني
Dialogue: 0,0:03:07.08,0:03:10.12,Default,,0000,0000,0000,,!تبّاً! ما الذي يجري؟
Dialogue: 0,0:03:12.79,0:03:15.95,Default,,0000,0000,0000,,!كونان-كن، أبي... الأمر فظيع
Dialogue: 0,0:03:17.00,0:03:18.21,Default,,0000,0000,0000,,...ران-نيتشان
Dialogue: 0,0:03:18.21,0:03:20.41,Default,,0000,0000,0000,,...ر-ران... أنتِ
Dialogue: 0,0:03:21.14,0:03:23.03,Default,,0000,0000,0000,,بخير
Dialogue: 0,0:03:23.03,0:03:24.37,Default,,0000,0000,0000,,...ظننتُك قد قُتلتِ
Dialogue: 0,0:03:25.03,0:03:28.00,Default,,0000,0000,0000,,!من قُتل كانت هي، سايغوسا كيوكو-سان
Dialogue: 0,0:03:28.49,0:03:29.53,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:03:29.53,0:03:34.58,Default,,0000,0000,0000,,!ما-ما هذا؟ لمَ قُتلت؟
Dialogue: 0,0:03:35.06,0:03:37.60,Default,,0000,0000,0000,,...جريمة بسكّين
Dialogue: 0,0:03:37.60,0:03:40.54,Default,,0000,0000,0000,,أيمكن أنّها جريمة قتل الثعلب الثانية؟
Dialogue: 0,0:03:40.98,0:03:45.49,Default,,0000,0000,0000,,!كـ-كيوكو! من؟! من قتلك؟
Dialogue: 0,0:03:46.01,0:03:49.41,Default,,0000,0000,0000,,انظروا، هذه السكّين مغروسة قطرياً من اليسار
Dialogue: 0,0:03:51.01,0:03:53.35,Default,,0000,0000,0000,,!ما يعني أنّ القاتل كان أعسر
Dialogue: 0,0:03:53.35,0:03:55.21,Default,,0000,0000,0000,,...كما ظننت
Dialogue: 0,0:03:55.21,0:03:58.16,Default,,0000,0000,0000,,لكن لمَ قُتلت؟
Dialogue: 0,0:03:58.79,0:04:02.07,Default,,0000,0000,0000,,ران-نيتشان! أكانت هذه الآنسة\Nبمفردها في الكوخ طوال الوقت؟
Dialogue: 0,0:04:02.36,0:04:05.53,Default,,0000,0000,0000,,حسناً... لا أدري
Dialogue: 0,0:04:05.82,0:04:10.00,Default,,0000,0000,0000,,!ما قصدك لا تدرين؟ ألم تكوني هنا؟
Dialogue: 0,0:04:10.32,0:04:16.20,Default,,0000,0000,0000,,لكنّكم تفرّقتم جميعاً وخرجتم للبحث\Nمع طلوع الشمس
Dialogue: 0,0:04:16.60,0:04:21.89,Default,,0000,0000,0000,,معها حقّ، سلك الجميع اتّجاهات مختلفة
Dialogue: 0,0:04:21.89,0:04:25.30,Default,,0000,0000,0000,,لا يمكن معرفة أين كان الآخرون
Dialogue: 0,0:04:25.30,0:04:27.34,Default,,0000,0000,0000,,لا يملك أحد حجّة غياب
Dialogue: 0,0:04:29.47,0:04:30.97,Default,,0000,0000,0000,,أعسر؟
Dialogue: 0,0:04:30.97,0:04:33.62,Default,,0000,0000,0000,,ألم يكن نوسي-سان أيمن؟
Dialogue: 0,0:04:34.38,0:04:38.54,Default,,0000,0000,0000,,ما الذي يجري بالضبط؟ من فعل هذا ولمَ؟
Dialogue: 0,0:04:41.62,0:04:45.37,Default,,0000,0000,0000,,حسنٌ، سأخبركم بكلّ شيء
Dialogue: 0,0:04:45.37,0:04:49.45,Default,,0000,0000,0000,,في الواقع، يوجد بيننا قاتل مأجور يُدعى بالثعلب
Dialogue: 0,0:04:49.45,0:04:52.53,Default,,0000,0000,0000,,وهو من وراء سلسلة جرائم القتل هذه
Dialogue: 0,0:04:52.94,0:04:54.48,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:04:54.48,0:04:55.49,Default,,0000,0000,0000,,...ذاك القاتل المأجور
Dialogue: 0,0:04:55.49,0:04:56.79,Default,,0000,0000,0000,,!الثعلب؟
Dialogue: 0,0:04:57.31,0:04:58.56,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:04:58.56,0:05:00.11,Default,,0000,0000,0000,,أيّها المتحرّي! أأنت واثق من هذا؟
Dialogue: 0,0:05:00.11,0:05:03.99,Default,,0000,0000,0000,,قُتل شخصان، لا أستطيع إخفاء الأمر أكثر
Dialogue: 0,0:05:04.39,0:05:06.89,Default,,0000,0000,0000,,...بالفعل، هذا الحدّ
Dialogue: 0,0:05:06.89,0:05:10.21,Default,,0000,0000,0000,,لكن لا يزال الوقت باكراً على\Nافتراض أنّ مرتكب الجريمتين واحد
Dialogue: 0,0:05:10.21,0:05:12.46,Default,,0000,0000,0000,,...لكن يا متحرّي
Dialogue: 0,0:05:12.46,0:05:13.84,Default,,0000,0000,0000,,لا تقلق
Dialogue: 0,0:05:13.84,0:05:18.59,Default,,0000,0000,0000,,اكتشفتُ أنا المتحرّي العظيم\Nموري كوغورو هويّة الثعلب
Dialogue: 0,0:05:18.59,0:05:19.54,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:05:19.92,0:05:21.33,Default,,0000,0000,0000,,!حقّاً يا أبي؟
Dialogue: 0,0:05:21.33,0:05:25.66,Default,,0000,0000,0000,,ذاك مذهل، كما يُتوقع من المتحرّي\Nالعظيم موري كوغورو-سان
Dialogue: 0,0:05:25.66,0:05:29.91,Default,,0000,0000,0000,,إذاً، من هو القاتل المأجور المعروف بالثعلب؟
Dialogue: 0,0:05:30.41,0:05:32.57,Default,,0000,0000,0000,,الثعلب أعسر
Dialogue: 0,0:05:32.57,0:05:34.90,Default,,0000,0000,0000,,،وبناءً على زاوية طعنة السكّين في جسدها
Dialogue: 0,0:05:34.90,0:05:37.91,Default,,0000,0000,0000,,كان قاتل سايغوسا-سان أعسر أيضاً
Dialogue: 0,0:05:38.23,0:05:41.32,Default,,0000,0000,0000,,ويوجد بيننا شخص واحد أعسر
Dialogue: 0,0:05:41.76,0:05:45.81,Default,,0000,0000,0000,,لكن أعتقد أنّ الأعسر الوحيد بيننا كان هيراي-سان
Dialogue: 0,0:05:45.81,0:05:49.00,Default,,0000,0000,0000,,الذي قُتل بالأمس يا موري-سان
Dialogue: 0,0:05:49.56,0:05:53.99,Default,,0000,0000,0000,,يبدو أنّ لديك قوّة ملاحظة حادة يا نوسي-سان
Dialogue: 0,0:05:57.21,0:06:02.74,Default,,0000,0000,0000,,أنا مؤلّف، قوّة الملاحظة والفضول\Nمن أدوات مهنتي الهامة
Dialogue: 0,0:06:03.37,0:06:09.66,Default,,0000,0000,0000,,ولعلّ أداةً معهما هي يدك العسراء\Nالتي تخفي اعتمادك عليها، صحيح؟
Dialogue: 0,0:06:10.16,0:06:11.53,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:11.53,0:06:13.86,Default,,0000,0000,0000,,لا جدوى من الإخفاء
Dialogue: 0,0:06:13.86,0:06:19.16,Default,,0000,0000,0000,,أنت على الأرجح شخصٌ أعسر تعلّم\Nكيفية استعمال يده اليمنى، صحيح؟
Dialogue: 0,0:06:19.61,0:06:24.12,Default,,0000,0000,0000,,أي أنّك تستطيع الاعتماد على الاثنتين، أنت ضارب\Nمُبدِّل كما في كرة القاعدة
Dialogue: 0,0:06:26.02,0:06:28.15,Default,,0000,0000,0000,,لا شكّ أنّ هذه حقيقة نوسي-سان
Dialogue: 0,0:06:28.93,0:06:29.91,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:06:30.35,0:06:36.37,Default,,0000,0000,0000,,أجل! القاتل المأجور بلا مضاهٍ\N،والمسؤول عن هذه الجرائم، أي الثعلب
Dialogue: 0,0:06:36.76,0:06:40.46,Default,,0000,0000,0000,,!هو أنت أيّها الروائيّ نوسي شينغو
Dialogue: 0,0:06:40.46,0:06:41.53,Default,,0000,0000,0000,,!حـ-حقّاً؟
Dialogue: 0,0:06:45.45,0:06:49.87,Default,,0000,0000,0000,,يا للصدمة! أنا الثعلب القاتل؟
Dialogue: 0,0:06:51.44,0:06:55.24,Default,,0000,0000,0000,,موري-سان، ستكون روائياً أفضل من متحرٍّ
Dialogue: 0,0:06:55.65,0:06:56.69,Default,,0000,0000,0000,,!لا تتحامق
Dialogue: 0,0:06:56.69,0:07:01.48,Default,,0000,0000,0000,,!تكتب روايات عن القتلة المأجورين\N!وهي مقتبسة من أحداث حقيقية
Dialogue: 0,0:07:01.48,0:07:05.67,Default,,0000,0000,0000,,!حقّاً؟ أهذا هو الثعلب حقّاً يا متحرّي؟
Dialogue: 0,0:07:07.14,0:07:07.98,Default,,0000,0000,0000,,!تبّاً لك
Dialogue: 0,0:07:07.98,0:07:09.98,Default,,0000,0000,0000,,!ما الذي تفعله؟! لا-لا أستطيع التنفس
Dialogue: 0,0:07:09.98,0:07:13.12,Default,,0000,0000,0000,,!أوشيو-سان! مهلك! لا يصحّ العنف
Dialogue: 0,0:07:13.34,0:07:15.05,Default,,0000,0000,0000,,!اصمت
Dialogue: 0,0:07:15.05,0:07:17.80,Default,,0000,0000,0000,,!لديّ... لديّ شأن مع هذا الشخص
Dialogue: 0,0:07:17.80,0:07:19.30,Default,,0000,0000,0000,,!الـ-النجدة
Dialogue: 0,0:07:19.30,0:07:23.00,Default,,0000,0000,0000,,!هذا سيّئ! فقد أوشيو-سان أعصابه وقد يقتله
Dialogue: 0,0:07:23.00,0:07:23.95,Default,,0000,0000,0000,,!عليّ إيقافه
Dialogue: 0,0:07:25.12,0:07:25.87,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:26.58,0:07:28.83,Default,,0000,0000,0000,,!بقايا صوف... هذا اللون
Dialogue: 0,0:07:29.75,0:07:31.78,Default,,0000,0000,0000,,ران-نيتشان
Dialogue: 0,0:07:31.78,0:07:33.11,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:07:33.11,0:07:36.79,Default,,0000,0000,0000,,أتظنّين أنّ الثعلب هو من قتلها حقّاً؟
Dialogue: 0,0:07:36.79,0:07:40.25,Default,,0000,0000,0000,,!لا تتفوه بالهراء في وقتٍ كهذا
Dialogue: 0,0:07:40.53,0:07:44.60,Default,,0000,0000,0000,,أبي! لا حاجة لتوبّخه هكذا
Dialogue: 0,0:07:44.60,0:07:46.54,Default,,0000,0000,0000,,إذاً، ما قصدك يا كونان-كن؟
Dialogue: 0,0:07:46.54,0:07:50.83,Default,,0000,0000,0000,,،لعلها طُعنت من الخلف بيد يسرى
Dialogue: 0,0:07:51.59,0:07:55.66,Default,,0000,0000,0000,,لكن ألا يمكن أنّها طُعنت من المقدّمة أيضاً؟
Dialogue: 0,0:07:56.43,0:07:58.30,Default,,0000,0000,0000,,ما الذي تقوله؟
Dialogue: 0,0:07:58.30,0:08:00.08,Default,,0000,0000,0000,,أي هكذا؟
Dialogue: 0,0:08:00.28,0:08:02.37,Default,,0000,0000,0000,,لتمثّل دورها قليلاً يا كونان-كن
Dialogue: 0,0:08:02.37,0:08:03.87,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,0:08:05.95,0:08:09.24,Default,,0000,0000,0000,,أخذ السكّين وطعنها من الخلف هكذا
Dialogue: 0,0:08:09.24,0:08:11.77,Default,,0000,0000,0000,,ما رأيكم؟ كان يمكن أن تكون\Nجريمة باليد اليمنى هكذا
Dialogue: 0,0:08:11.77,0:08:14.36,Default,,0000,0000,0000,,!ما-ماذا؟ لا يُعقل
Dialogue: 0,0:08:15.44,0:08:19.15,Default,,0000,0000,0000,,...لكن لن يكون طعنها بهذا الشكل سهلاً
Dialogue: 0,0:08:19.77,0:08:24.86,Default,,0000,0000,0000,,أي أنّ القاتل هو من لم يكن\Nإمساكه للضحيّة بتلك الطريقة غريباً
Dialogue: 0,0:08:25.60,0:08:28.57,Default,,0000,0000,0000,,!انظروا، توجد بقايا صوف على أظافرها
Dialogue: 0,0:08:29.89,0:08:30.83,Default,,0000,0000,0000,,...هذا اللون الصوفيّ
Dialogue: 0,0:08:30.83,0:08:31.52,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:08:32.27,0:08:38.38,Default,,0000,0000,0000,,فهمت! يوجد شخص واحد فقط يرتدي\Nسترةً صوفية بهذا اللون ويستطيع طعنها
Dialogue: 0,0:08:38.38,0:08:39.95,Default,,0000,0000,0000,,...دون إثارة حذرها
Dialogue: 0,0:08:41.33,0:08:42.48,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:08:42.91,0:08:44.44,Default,,0000,0000,0000,,!ليس موجوداً
Dialogue: 0,0:08:44.44,0:08:48.40,Default,,0000,0000,0000,,!كـ-كاوابي؟ هو الثعلب؟
Dialogue: 0,0:08:48.83,0:08:50.58,Default,,0000,0000,0000,,كلا، سيكون ذلك غريباً
Dialogue: 0,0:08:50.58,0:08:54.77,Default,,0000,0000,0000,,يُفترض أنّ الثعلب أعسر، لكنّ كاوابي-سان أيمن
Dialogue: 0,0:08:54.77,0:08:58.40,Default,,0000,0000,0000,,كما لمَ ارتكب هذه الجريمة؟
Dialogue: 0,0:09:02.56,0:09:05.73,Default,,0000,0000,0000,,انظروا هنا! توجد الكثير من أوراق \N!عشرة آلاف ينّ في حقيبة الظهر هذه
Dialogue: 0,0:09:06.76,0:09:07.78,Default,,0000,0000,0000,,!وعليها دم
Dialogue: 0,0:09:07.78,0:09:09.51,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:09:09.51,0:09:13.86,Default,,0000,0000,0000,,لم تنزف كثيراً، فلا بدّ أنّ هذا \N!دم شخصٍ آخر
Dialogue: 0,0:09:14.50,0:09:18.20,Default,,0000,0000,0000,,لكنّه ليس قديماً... فدم من؟
Dialogue: 0,0:09:19.71,0:09:22.87,Default,,0000,0000,0000,,...اللغز يعمق أكثر فأكثر
Dialogue: 0,0:09:22.87,0:09:24.61,Default,,0000,0000,0000,,قد أستطيع كتابة رواية ممتازة
Dialogue: 0,0:09:26.37,0:09:28.45,Default,,0000,0000,0000,,بالمناسبة، أين ذهب أوشيو-سان؟
Dialogue: 0,0:09:28.45,0:09:30.57,Default,,0000,0000,0000,,ماذا؟ كان هنا حتّى الآن
Dialogue: 0,0:09:31.15,0:09:34.32,Default,,0000,0000,0000,,!هرع خارجاً قبل قليل
Dialogue: 0,0:09:34.32,0:09:37.15,Default,,0000,0000,0000,,لا تعتقدون أنّه ينوي\Nالإمساك بكاوابي-سان، صحيح؟
Dialogue: 0,0:09:37.44,0:09:41.94,Default,,0000,0000,0000,,!هذا سيّئ! أوشيو-سان هو هدف الثعلب\N!لا يمكننا تركه يغادر بمفرده
Dialogue: 0,0:09:43.35,0:09:44.73,Default,,0000,0000,0000,,اختفى الجدّ المشرف على الكوخ أيضاً
Dialogue: 0,0:09:45.42,0:09:46.19,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:09:46.19,0:09:49.15,Default,,0000,0000,0000,,أيمكن أنّ كاوابي-سان أخذه رهينة؟
Dialogue: 0,0:09:49.15,0:09:53.08,Default,,0000,0000,0000,,ذلك محتمل، فهو ملمٌّ بطرق هذه المنطقة
Dialogue: 0,0:09:53.95,0:09:56.61,Default,,0000,0000,0000,,!فلتبقيا هنا
Dialogue: 0,0:09:56.61,0:10:00.57,Default,,0000,0000,0000,,إذا كان سيرشده، فلن يستعمل نفس\Nالطريق الذي سلكناه، صحيح؟
Dialogue: 0,0:10:00.81,0:10:03.81,Default,,0000,0000,0000,,!مما يعني أنّه سيأخذ الطريق للمحافظة
Dialogue: 0,0:10:03.81,0:10:06.31,Default,,0000,0000,0000,,!تبّاً لذاك الثعلب
Dialogue: 0,0:10:04.28,0:10:06.74,OS,,0000,0310,15,,محافظة ياماناشي
Dialogue: 0,0:10:10.60,0:10:13.61,Default,,0000,0000,0000,,!أتريد الموت يا عجوز؟! امش! هيّا
Dialogue: 0,0:10:17.05,0:10:18.53,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:10:22.13,0:10:23.86,Default,,0000,0000,0000,,هـ-هزّة أرضيّة؟
Dialogue: 0,0:10:26.82,0:10:29.61,Default,,0000,0000,0000,,!النجدة! ليأت أحد
Dialogue: 0,0:10:30.38,0:10:32.06,Default,,0000,0000,0000,,!الثعلب
Dialogue: 0,0:10:33.12,0:10:35.28,Default,,0000,0000,0000,,!إنّها كارثة! تلك الصخرة على وشك السقوط
Dialogue: 0,0:10:35.28,0:10:37.16,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:10:37.16,0:10:38.74,Default,,0000,0000,0000,,!الـ-النجدة
Dialogue: 0,0:10:38.74,0:10:40.22,Default,,0000,0000,0000,,!يا عمّ! هذه
Dialogue: 0,0:10:40.22,0:10:41.69,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:10:41.95,0:10:44.45,Default,,0000,0000,0000,,!حسنٌ، بسرعة
Dialogue: 0,0:10:45.08,0:10:46.36,Default,,0000,0000,0000,,!اصعد
Dialogue: 0,0:10:48.17,0:10:50.49,Default,,0000,0000,0000,,!أسرع! ستسقط الصخرة
Dialogue: 0,0:11:03.34,0:11:04.25,Default,,0000,0000,0000,,...كان ذلك وشيكاً
Dialogue: 0,0:11:04.25,0:11:06.38,Default,,0000,0000,0000,,...نجونا
Dialogue: 0,0:11:06.38,0:11:08.54,Default,,0000,0000,0000,,ماذا عن أوشيو-سان ومن معه؟
Dialogue: 0,0:11:08.54,0:11:10.46,Default,,0000,0000,0000,,!أنت! أين الآخران؟
Dialogue: 0,0:11:10.46,0:11:14.45,Default,,0000,0000,0000,,لـ-لا أدري! دفعني العجوز المشرف\N!على الكوخ وهرب
Dialogue: 0,0:11:14.45,0:11:15.44,Default,,0000,0000,0000,,أهذه الحقيقة؟
Dialogue: 0,0:11:16.16,0:11:18.90,Default,,0000,0000,0000,,آمل أنّهما عادا للكوخ
Dialogue: 0,0:11:19.20,0:11:21.40,Default,,0000,0000,0000,,انهار الطريق الجبليّ
Dialogue: 0,0:11:21.40,0:11:24.70,Default,,0000,0000,0000,,سنبحث عنهما، علينا العودة بأيّ حال
Dialogue: 0,0:11:27.98,0:11:32.81,Default,,0000,0000,0000,,أُغلقت القضيّة! هذا هو المتحرّي\N!العظيم موري كوغورو-ساما
Dialogue: 0,0:11:32.81,0:11:34.26,Default,,0000,0000,0000,,ما رأيك يا ثعلب؟
Dialogue: 0,0:11:34.26,0:11:36.53,Default,,0000,0000,0000,,!كـ-كلا! لستُ قاتلاً مأجوراً
Dialogue: 0,0:11:37.14,0:11:42.84,Default,,0000,0000,0000,,هذا القاتل المأجور الذي سبّب المتاعب للشرطة؟ لا يمكن
Dialogue: 0,0:11:42.84,0:11:44.44,Default,,0000,0000,0000,,مما يعني، من يكون؟
Dialogue: 0,0:11:44.67,0:11:47.80,Default,,0000,0000,0000,,بأيّ حال، أين ذهب أوشيو-سان؟
Dialogue: 0,0:11:47.80,0:11:51.12,Default,,0000,0000,0000,,أمسكتُ بالثعلب، ومن الآمن له أن يخرج الآن
Dialogue: 0,0:11:51.12,0:11:53.79,Default,,0000,0000,0000,,هذا غريب، اختفى العجوز كذلك
Dialogue: 0,0:11:53.79,0:11:55.65,Default,,0000,0000,0000,,أين ذهبا؟
Dialogue: 0,0:11:56.04,0:11:58.41,Default,,0000,0000,0000,,!أنت! أين هما؟! أين ذهبا؟
Dialogue: 0,0:11:58.41,0:12:00.04,Default,,0000,0000,0000,,!أيمكن أنّك قتلتهما؟
Dialogue: 0,0:12:00.04,0:12:03.11,Default,,0000,0000,0000,,!لـ-لا أدري! ولستُ الثعلب
Dialogue: 0,0:12:03.11,0:12:07.57,Default,,0000,0000,0000,,!التحامق لن ينفعك الآن! استسلم وأفصح عن كلّ شيء
Dialogue: 0,0:12:11.60,0:12:15.65,Default,,0000,0000,0000,,!عمّ موري! انظر لهذه\N!داخل حقيبة كاوابي-سان
Dialogue: 0,0:12:16.06,0:12:18.09,Default,,0000,0000,0000,,!مالٌ كثير
Dialogue: 0,0:12:18.09,0:12:19.89,Default,,0000,0000,0000,,!دم! يوجد دم عليه
Dialogue: 0,0:12:19.89,0:12:20.69,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:21.26,0:12:25.65,Default,,0000,0000,0000,,يبدو مثل الدمّ على أوراق العشرة\Nآلاف ينّ التي كانت في حقيبة سايغوسا-سان
Dialogue: 0,0:12:25.84,0:12:28.36,Default,,0000,0000,0000,,!أنت! ما معنى هذا؟
Dialogue: 0,0:12:28.88,0:12:30.83,Default,,0000,0000,0000,,موري-سان، استمع
Dialogue: 0,0:12:30.83,0:12:31.81,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:31.81,0:12:36.04,Default,,0000,0000,0000,,بما أنّ تاناكا-سان المقتول\N،كان زعيم عصابات سابق
Dialogue: 0,0:12:36.04,0:12:39.66,Default,,0000,0000,0000,,هناك احتمال بأنّ هذا كان\Nنتيجةً لصراع بين عصابتين
Dialogue: 0,0:12:39.66,0:12:42.49,Default,,0000,0000,0000,,لكن بما أنّ الرجل والمرأة أجبرا تاناكا-سان
Dialogue: 0,0:12:42.49,0:12:46.44,Default,,0000,0000,0000,,على فتح خزنته كي يستطيعا\Nسرقة المئة مليون ينّ داخلها
Dialogue: 0,0:12:46.44,0:12:49.33,Default,,0000,0000,0000,,فيبدو أنّها كانت مجرّد جريمة سرقة
Dialogue: 0,0:12:52.73,0:12:59.15,Default,,0000,0000,0000,,فهمت! المشتبه بهما الاثنان \Nهما أنت وسايغوسا-سان إذاً؟
Dialogue: 0,0:12:59.52,0:13:04.05,Default,,0000,0000,0000,,،بما أنّهما قتلا زعيم عصابات\Nقد يلحق بهما أشخاص
Dialogue: 0,0:13:04.05,0:13:06.57,Default,,0000,0000,0000,,لذا كانا خائفين
Dialogue: 0,0:13:06.97,0:13:09.26,Default,,0000,0000,0000,,...الدمّ على الأوراق إذاً
Dialogue: 0,0:13:09.26,0:13:12.54,Default,,0000,0000,0000,,أجل، دم الشخص الذي سرقاه
Dialogue: 0,0:13:12.54,0:13:16.53,Default,,0000,0000,0000,,كما كان هو من قتل شريكته سايغوسا-سان
Dialogue: 0,0:13:17.00,0:13:20.61,Default,,0000,0000,0000,,!أجل، صحيح! قتلتُ كيوكو
Dialogue: 0,0:13:20.61,0:13:24.48,Default,,0000,0000,0000,,!لأنّنا اعتقدنا أنّك تلاحقنا! إنّها غلطتك
Dialogue: 0,0:13:24.48,0:13:26.19,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:26.53,0:13:31.65,Default,,0000,0000,0000,,لعلّه ظنّ العصابة عيّنتك\Nكي تتبعه وتمسك به
Dialogue: 0,0:13:32.30,0:13:35.81,Default,,0000,0000,0000,,لذا هلع وتشاجر معها؟
Dialogue: 0,0:13:36.05,0:13:38.30,Default,,0000,0000,0000,,!أهذه الحقيقة؟ أجب
Dialogue: 0,0:13:38.30,0:13:39.22,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:13:39.22,0:13:41.85,Default,,0000,0000,0000,,كنتَ من حاول قتلي أيضاً إذاً؟
Dialogue: 0,0:13:42.24,0:13:44.33,Default,,0000,0000,0000,,!أجل! صحيح
Dialogue: 0,0:13:46.13,0:13:48.56,Default,,0000,0000,0000,,!لا جدوى، لا أمامنا سوى أن نسلّم أنفسنا
Dialogue: 0,0:13:49.53,0:13:52.70,Default,,0000,0000,0000,,لا تكوني حمقاء، سأتكفّل بهذا الذي يلاحقنا
Dialogue: 0,0:13:52.70,0:13:53.47,Default,,0000,0000,0000,,دعي الأمر لي
Dialogue: 0,0:13:53.74,0:13:55.87,Default,,0000,0000,0000,,!لا أريد القتل مجدداً
Dialogue: 0,0:13:55.87,0:13:59.46,Default,,0000,0000,0000,,!إذا فعلتَ ذلك فسأذهب للشرطة
Dialogue: 0,0:14:01.69,0:14:05.43,Default,,0000,0000,0000,,آسف على انفعالي قبلاً يا كيوكو، لنهرب معاً
Dialogue: 0,0:14:11.43,0:14:15.01,Default,,0000,0000,0000,,!كنتُ سأكون في خطر لو لم أقتلها أوّلاً
Dialogue: 0,0:14:15.42,0:14:18.85,Default,,0000,0000,0000,,يا إلهي! كان علينا ألّا نحاول\N!الاختباء في هذه الجبال
Dialogue: 0,0:14:19.39,0:14:22.17,Default,,0000,0000,0000,,لذا لا أدري من قتل ذاك الشاب الجامعيّ
Dialogue: 0,0:14:22.17,0:14:24.27,Default,,0000,0000,0000,,!ولا علاقة لي بذاك الثعلب
Dialogue: 0,0:14:24.96,0:14:28.48,Default,,0000,0000,0000,,انتظر، ماذا عن الثعلب إذاً؟
Dialogue: 0,0:14:28.79,0:14:31.95,Default,,0000,0000,0000,,هذا أهمّ سؤال
Dialogue: 0,0:14:32.30,0:14:35.66,Default,,0000,0000,0000,,لا يمكنني تصوّر الثعلب\Nيترك هذه الفرصة تفلت
Dialogue: 0,0:14:36.91,0:14:38.03,Default,,0000,0000,0000,,...تفلت
Dialogue: 0,0:14:38.03,0:14:39.44,Default,,0000,0000,0000,,!انتظر! آلة الفاكس
Dialogue: 0,0:14:40.03,0:14:42.65,Default,,0000,0000,0000,,توجد آلة فاكس في هذا الكوخ، صحيح؟
Dialogue: 0,0:14:42.65,0:14:43.47,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:44.02,0:14:47.80,Default,,0000,0000,0000,,!أجل! التي أرسل لها المكتب
Dialogue: 0,0:14:47.80,0:14:49.97,Default,,0000,0000,0000,,يُفترض أنّها على خطّ\N!مختلف عن الهاتف العموميّ
Dialogue: 0,0:14:49.97,0:14:53.72,Default,,0000,0000,0000,,...أجل! إذا لم تصبه الصاعقة
Dialogue: 0,0:14:54.05,0:14:56.18,Default,,0000,0000,0000,,!سنستطيع الاتّصال بالشرطة
Dialogue: 0,0:14:58.17,0:14:59.64,Default,,0000,0000,0000,,إذاً؟
Dialogue: 0,0:15:00.83,0:15:02.55,Default,,0000,0000,0000,,!لا جدوى، لا جدوى، لا جدوى
Dialogue: 0,0:15:02.83,0:15:05.41,Default,,0000,0000,0000,,لا أمامنا سوى النزول من الجبل في النهاية؟
Dialogue: 0,0:15:07.91,0:15:08.97,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:15:09.83,0:15:11.78,Default,,0000,0000,0000,,!قُطع خطّ الهاتف
Dialogue: 0,0:15:13.44,0:15:16.36,Default,,0000,0000,0000,,خطّ الهاتف الذي ظننا أنّ الصاعقة أصابته
Dialogue: 0,0:15:16.36,0:15:19.40,Default,,0000,0000,0000,,!كان قد قُطع داخل الكوخ
Dialogue: 0,0:15:19.40,0:15:22.38,Default,,0000,0000,0000,,!لمَ؟ لمَ؟
Dialogue: 0,0:15:26.94,0:15:29.21,Default,,0000,0000,0000,,!ماذا؟! ما معنى هذا؟
Dialogue: 0,0:15:29.83,0:15:31.80,Default,,0000,0000,0000,,قطع أحدهم خطّ الهاتف
Dialogue: 0,0:15:35.21,0:15:39.53,Default,,0000,0000,0000,,الجدّ؟ أنا هيراي، سأبيت الليلة أيضاً
Dialogue: 0,0:15:40.20,0:15:41.05,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:15:43.45,0:15:44.21,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:15:44.21,0:15:46.66,On Top,,0000,0000,0000,,سجّل نزلاء الكوخ الجبلي
Dialogue: 0,0:15:46.66,0:15:49.13,Default,,0000,0000,0000,,ها هو، يُفترض أن أجد الخيط داخله
Dialogue: 0,0:15:49.40,0:15:50.71,On Top,,0000,0000,0000,,هيراي كينيتشي
Dialogue: 0,0:15:49.77,0:15:50.71,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:15:52.13,0:15:53.17,Default,,0000,0000,0000,,!هنا أيضاً
Dialogue: 0,0:15:54.03,0:15:56.69,Default,,0000,0000,0000,,كان هيراي-سان يتردّد على الكوخ بالفعل
Dialogue: 0,0:15:56.69,0:15:59.97,Default,,0000,0000,0000,,كان في نادي تسلّق الجبال\Nفي جامعته، فلا عجب
Dialogue: 0,0:16:00.52,0:16:03.68,Default,,0000,0000,0000,,...إذا كان هذا سبب مقتل هيراي-سان، فـ
Dialogue: 0,0:16:03.68,0:16:08.88,Default,,0000,0000,0000,,حسناً، لنتفرّق ونبحث عن أوشيو-سان\Nكما نتصّل بالشرطة
Dialogue: 0,0:16:09.18,0:16:12.35,Default,,0000,0000,0000,,سأبقى هنا وأحرسه
Dialogue: 0,0:16:12.35,0:16:16.09,Default,,0000,0000,0000,,!ليس أنت! سترافقني
Dialogue: 0,0:16:16.09,0:16:19.71,Default,,0000,0000,0000,,...لا تزال تشتبه بي؟ يا إلهي
Dialogue: 0,0:16:19.71,0:16:21.71,Default,,0000,0000,0000,,لا أريد أن أُصاب بحرق شمس فحسب
Dialogue: 0,0:16:21.71,0:16:24.97,Default,,0000,0000,0000,,فالشمس لاسعةٌ اليوم بعد يومٍ عاصف
Dialogue: 0,0:16:24.97,0:16:27.04,Default,,0000,0000,0000,,!لا تتكلّم كفتاة
Dialogue: 0,0:16:27.04,0:16:29.76,Default,,0000,0000,0000,,!من الطبيعيّ أن تصاب بحرق شمس في الجبال
Dialogue: 0,0:16:30.04,0:16:31.41,Default,,0000,0000,0000,,حرق شمس؟
Dialogue: 0,0:16:31.41,0:16:33.01,Default,,0000,0000,0000,,!فهمت! هذا هو
Dialogue: 0,0:16:33.79,0:16:36.09,Default,,0000,0000,0000,,!الشيء الذي لم يبد في محلّه
Dialogue: 0,0:16:36.86,0:16:39.03,Default,,0000,0000,0000,,،رغم أنّه يدير كوخاً جبلياً
Dialogue: 0,0:16:39.03,0:16:40.51,Default,,0000,0000,0000,,!لم يكن ذاك العجوز متسمّراً البتّة
Dialogue: 0,0:16:41.15,0:16:44.28,Default,,0000,0000,0000,,!ما يعني أنّ أحدهم تنكّر بهيئته
Dialogue: 0,0:16:44.28,0:16:46.60,Default,,0000,0000,0000,,!وذلك الثعلب
Dialogue: 0,0:16:46.60,0:16:50.51,Default,,0000,0000,0000,,ماذا؟ لم يكن ذاك العجوز مشرف الكوخ؟
Dialogue: 0,0:16:51.02,0:16:52.72,Default,,0000,0000,0000,,كيف عرفت ذلك؟
Dialogue: 0,0:16:52.93,0:16:58.38,Default,,0000,0000,0000,,يُفترض أن تكون بشرة مشرف الكوخ متسمّرة\Nبما أنّه يتعرّض للشمس باستمرار
Dialogue: 0,0:16:59.17,0:17:03.39,Default,,0000,0000,0000,,معكّ حق، بذكرك ذلك... كانت بشرة العجوزة بيضاء شاحبة
Dialogue: 0,0:17:03.67,0:17:07.16,Default,,0000,0000,0000,,مما يعني أنّه كان الثعلب؟
Dialogue: 0,0:17:07.16,0:17:09.30,Default,,0000,0000,0000,,أي أنّه قتل هيراي-سان أيضاً؟
Dialogue: 0,0:17:09.30,0:17:13.75,Default,,0000,0000,0000,,أجل، كان هيراي-سان يعرف \Nمشرف الكوخ الحقيقيّ
Dialogue: 0,0:17:13.75,0:17:18.99,Default,,0000,0000,0000,,لو أتى للكوخ، كان ليعرف أنّ الثعلب تنكّر بهيئته
Dialogue: 0,0:17:18.99,0:17:21.82,Default,,0000,0000,0000,,!لذا قتل الثعلب هيراي-سان
Dialogue: 0,0:17:22.94,0:17:28.53,Default,,0000,0000,0000,,لا بدّ أنّه سمع مكالمة هيراي-سان\Nمع الكوخ بينما يملؤ الاستمارات
Dialogue: 0,0:17:30.31,0:17:33.06,Default,,0000,0000,0000,,أسقط هيراي-سان من الجرف\Nفي طريقه إلى هنا
Dialogue: 0,0:17:33.06,0:17:35.31,Default,,0000,0000,0000,,ثمّ أسرع للكوخ وقطع خطوط الهاتف
Dialogue: 0,0:17:36.05,0:17:38.96,Default,,0000,0000,0000,,وانتظر وصول هدفه
Dialogue: 0,0:17:40.80,0:17:42.17,Default,,0000,0000,0000,,متنكّراً بهيئة مشرف الكوخ
Dialogue: 0,0:17:42.17,0:17:45.68,Default,,0000,0000,0000,,شخص معتاد على الجبال أكثر من الضيوف
Dialogue: 0,0:17:45.93,0:17:49.59,Default,,0000,0000,0000,,!تبّاً له! تظاهر بأنّه المشرف
Dialogue: 0,0:17:49.96,0:17:54.08,Default,,0000,0000,0000,,حتّى لو اكتشفنا هويّة الثعلب، لا نزال نجهل مكانه
Dialogue: 0,0:17:55.58,0:17:56.61,Default,,0000,0000,0000,,!طلقة نارية
Dialogue: 0,0:17:56.61,0:17:57.55,Default,,0000,0000,0000,,أيمكن أنّه الثعلب؟
Dialogue: 0,0:18:01.32,0:18:02.47,Default,,0000,0000,0000,,!انتظر يا كونان-كن
Dialogue: 0,0:18:04.28,0:18:06.19,Default,,0000,0000,0000,,!الثعلب قاتل مأجور محترف
Dialogue: 0,0:18:06.19,0:18:10.86,Default,,0000,0000,0000,,يُفترض أنّه خطّط لطريق هروب\N!للأمان قبل أيّ أحد
Dialogue: 0,0:18:11.47,0:18:14.37,Default,,0000,0000,0000,,!أي أسرع طريق أسفل الجبل
Dialogue: 0,0:18:16.01,0:18:16.85,Default,,0000,0000,0000,,!في هذه المنطقة
Dialogue: 0,0:18:18.80,0:18:19.79,Default,,0000,0000,0000,,محفظة؟
Dialogue: 0,0:18:22.72,0:18:23.56,Default,,0000,0000,0000,,...أهذه
Dialogue: 0,0:18:24.30,0:18:25.50,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:18:26.75,0:18:28.05,Default,,0000,0000,0000,,!لا شيء
Dialogue: 0,0:18:28.42,0:18:30.47,Default,,0000,0000,0000,,!إنّها محفظة أوشيو-سان
Dialogue: 0,0:18:30.92,0:18:33.15,Default,,0000,0000,0000,,أهذه صورة ابنته؟
Dialogue: 0,0:18:33.93,0:18:36.13,On Top,,0000,0000,0000,,روضة تاكاغي
Dialogue: 0,0:18:34.58,0:18:36.26,Default,,0000,0000,0000,,روضة تاكاغي؟
Dialogue: 0,0:18:36.99,0:18:38.05,Default,,0000,0000,0000,,...ألم تكن
Dialogue: 0,0:18:40.09,0:18:41.96,On Top,,0000,0000,0000,,!موت طالبة روضة في حادث مروري\N(أوشيو تشيساتو-تشان (5
Dialogue: 0,0:18:42.49,0:18:44.18,Default,,0000,0000,0000,,...ذاك الثعلب الوغد
Dialogue: 0,0:18:44.49,0:18:46.97,Default,,0000,0000,0000,,!فهمت! هكذا إذاً
Dialogue: 0,0:18:49.85,0:18:54.89,Default,,0000,0000,0000,,لم يخطر لك أنّ هدفك الذي \Nأراد الانتحار سيردّ الهجوم، صحيح؟
Dialogue: 0,0:18:54.89,0:18:57.09,Default,,0000,0000,0000,,ما-ما معنى هذا؟
Dialogue: 0,0:18:57.84,0:19:01.05,Default,,0000,0000,0000,,!يريد الانتقام لموت ابنته
Dialogue: 0,0:19:01.05,0:19:04.55,Default,,0000,0000,0000,,تذكر رئيس شركة الإقراض العاجل\Nالذي قتلته قبل 6 أشهر؟
Dialogue: 0,0:19:04.55,0:19:09.01,Default,,0000,0000,0000,,علقت حافلة مدرسية في الحادث \N!آنذاك وماتت طفلة في الروضة
Dialogue: 0,0:19:09.67,0:19:10.97,Default,,0000,0000,0000,,طفلة في الروضة؟
Dialogue: 0,0:19:10.97,0:19:12.96,Default,,0000,0000,0000,,!لا تتظاهر أنّك نسيت
Dialogue: 0,0:19:12.96,0:19:15.35,Default,,0000,0000,0000,,...ابنتي الوحيدة تشيساتو
Dialogue: 0,0:19:15.83,0:19:17.04,Default,,0000,0000,0000,,!أنت قتلتها
Dialogue: 0,0:19:18.95,0:19:22.55,Default,,0000,0000,0000,,لكنّك لم تعرف وجه الثعلب ولا هويّته
Dialogue: 0,0:19:23.28,0:19:27.01,Default,,0000,0000,0000,,...لذا لم يكن أمامك خيار سوى جعل نفسك هدفاً
Dialogue: 0,0:19:27.01,0:19:29.51,Default,,0000,0000,0000,,ثمّ عيّنت العمّ موري لاستدراجه، صحيح؟
Dialogue: 0,0:19:30.27,0:19:31.35,Default,,0000,0000,0000,,...حتّى ذلك القناص أيضاً كان غالباً
Dialogue: 0,0:19:31.98,0:19:37.64,Default,,0000,0000,0000,,!أجل، طلبتُ من زميلٍ لي! لجلب المتحرّي هنا
Dialogue: 0,0:19:37.64,0:19:41.35,Default,,0000,0000,0000,,!الشخص الذي لاحقتُه كان ذاك الفتى كاوابي
Dialogue: 0,0:19:41.35,0:19:46.70,Default,,0000,0000,0000,,لكن لدهشتي، دفعه العجوز الذي\N!كان رهينةً عنده وهرب
Dialogue: 0,0:19:47.92,0:19:52.72,Default,,0000,0000,0000,,!توضّح من هو القاتل المحترف فجأة
Dialogue: 0,0:19:55.29,0:19:57.47,Default,,0000,0000,0000,,...التقينا أخيراً
Dialogue: 0,0:19:57.87,0:19:58.93,Default,,0000,0000,0000,,!لتمت أيّها الثعلب
Dialogue: 0,0:19:58.93,0:19:59.75,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:20:07.86,0:20:12.48,Default,,0000,0000,0000,,هذا الجرح لا يُذكر\N!مقارنةً بمعاناة تشيساتو
Dialogue: 0,0:20:12.48,0:20:17.13,Default,,0000,0000,0000,,!وقت الموت أيّها الثعلب! سأقتلك ببطء وألم
Dialogue: 0,0:20:17.13,0:20:21.47,Default,,0000,0000,0000,,!لا تطلق! فعل ذلك لن يعيد تشيساتو-تشان للحياة
Dialogue: 0,0:20:23.14,0:20:26.76,Default,,0000,0000,0000,,!إذا قتلته، ستصبح قاتلاً مثله لا أكثر
Dialogue: 0,0:20:27.46,0:20:29.76,Default,,0000,0000,0000,,أتظنّ تشيساتو-تشان ستسعد بذلك؟
Dialogue: 0,0:20:41.83,0:20:43.11,Default,,0000,0000,0000,,...تشيساتو
Dialogue: 0,0:20:52.32,0:20:53.56,Default,,0000,0000,0000,,!تشيساتو
Dialogue: 0,0:21:00.09,0:21:01.97,Default,,0000,0000,0000,,!لا تعرف الاستسلام
Dialogue: 0,0:21:03.31,0:21:06.46,Default,,0000,0000,0000,,!الثعلب! ها أنت
Dialogue: 0,0:21:09.30,0:21:12.76,Default,,0000,0000,0000,,مرحباً أيّها المدير الزائف، أنت الثعلب إذاً؟
Dialogue: 0,0:21:12.76,0:21:15.46,Default,,0000,0000,0000,,!إنّه الثعلب بلا شكّ
Dialogue: 0,0:21:16.58,0:21:17.35,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:21:21.54,0:21:24.20,Default,,0000,0000,0000,,...كيف ذلك؟ إنّها رمية موري كوغورو-ساما
Dialogue: 0,0:21:24.20,0:21:26.51,Default,,0000,0000,0000,,!ماذا؟ ما هذا؟
Dialogue: 0,0:21:26.51,0:21:27.42,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:21:28.86,0:21:32.93,Default,,0000,0000,0000,,!كان الثعلب لا يزال رجلاً شاباً
Dialogue: 0,0:23:00.08,0:23:04.26,Default,,0000,0000,0000,,كان مدير الكوخ الحقيقيّ محتجزاً في كهف مجاور
Dialogue: 0,0:23:05.08,0:23:07.36,Default,,0000,0000,0000,,...بنهاية المطاف، وصلت الشرطة
Dialogue: 0,0:23:07.36,0:23:12.01,Default,,0000,0000,0000,,واُعتقل القاتل المأجور الثعلب \Nومرتكب جريمة القتل كاوابي
Dialogue: 0,0:23:12.01,0:23:14.81,Default,,0000,0000,0000,,كما أوشيو-سان
Dialogue: 0,0:23:18.31,0:23:20.76,Default,,0000,0000,0000,,أيّها الولد، لست صبيّاً عادياً
Dialogue: 0,0:23:22.06,0:23:24.47,Default,,0000,0000,0000,,إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:23:30.67,0:23:32.88,Default,,0000,0000,0000,,!أُغلقت القضيّة هذه المرّة
Dialogue: 0,0:23:32.88,0:23:35.88,Default,,0000,0000,0000,,وقت العودة للبيت والاستحمام \N!وتناول حساء لحم خنزير بريّ وجعّة
Dialogue: 0,0:23:36.37,0:23:38.34,Default,,0000,0000,0000,,...أبي
Dialogue: 0,0:23:39.63,0:23:42.92,Default,,0000,0000,0000,,...أعتقد أنّه ليس شخصاً عادياً بدوره
Dialogue: 0,0:23:45.65,0:23:48.01,Default,,0000,0000,0000,,!الحساء فكرة حسنة
Dialogue: 0,0:24:09.93,0:24:10.72,Default,,0000,0000,0000,,ظهرت؟
Dialogue: 0,0:24:11.34,0:24:13.93,Default,,0000,0000,0000,,!رايتها! امرأة الثلج في كيمونو أبيض
Dialogue: 0,0:24:14.93,0:24:20.89,Default,,0000,0000,0000,,ماذا؟ وُجدت ماكيكو-سان ميتةً\Nفي زيّ مرأة الثلج خاصتها؟
Dialogue: 0,0:24:21.33,0:24:23.76,Default,,0000,0000,0000,,!عليكم ألّا تأخذوا الجثّة
Dialogue: 0,0:24:23.76,0:24:29.75,On Top,,0000,0000,0000,,جريمة قتل أسطورة امرأة الثلج
Dialogue: 0,0:24:24.50,0:24:26.07,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.07,0:24:28.93,Default,,0000,0000,0000,,جريمة قتل أسطورة امرأة الثلج
Dialogue: 0,0:24:45.56,0:24:47.60,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.89,0:24:49.75,Default,,0000,0000,0000,,كريم أساس واقٍ شمسي
Dialogue: 0,0:24:49.75,0:24:51.75,Default,,0000,0000,0000,,تظهر في الحلقة القادمة\N!امرأة ثلجيّة مخيفة
Dialogue: 0,0:24:51.75,0:24:53.78,Default,,0000,0000,0000,,إذا لم تحلّ القضيّة، ستتجمّد
Dialogue: 0,0:24:53.78,0:24:55.77,Default,,0000,0000,0000,,!مخيف

