Dialogue: 0,0:00:02.05,0:00:03.88,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.88,0:00:06.74,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.34,0:00:10.40,Default,,0000,0000,0000,,!قضيّة اليوم عن رعاية الحيوانات! للحكايا الشعبية معانٍ عميقة
Dialogue: 0,0:00:10.79,0:00:12.20,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.20,0:00:14.34,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.34,0:00:16.41,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.08,0:01:57.10,Title,,0000,0000,15,,{\fad(300,0)} جريمة قتل ردّ جميل طائر الكركي
Dialogue: 0,0:01:51.94,0:01:55.48,Default,,0000,0000,0000,,جريمة قتل ردّ جميل طائر الكركي
Dialogue: 0,0:01:59.88,0:02:03.01,Default,,0000,0000,0000,,أأنتِ متأكّدة أنّ هذا هو الطريق؟
Dialogue: 0,0:02:03.01,0:02:06.02,Default,,0000,0000,0000,,أجل، يُفترض أن تكون في البركة أمامنا
Dialogue: 0,0:02:06.76,0:02:13.37,Default,,0000,0000,0000,,يا إلهي، أتينا لهوكّايدو لكن لم نذهب\Nلأكل سرطان البحر أو نزر الينابيع الساخنة
Dialogue: 0,0:02:13.37,0:02:16.43,Default,,0000,0000,0000,,يمكنك رؤية طائر الكركي في حدائق الحيوانات\N!في أيّ وقت
Dialogue: 0,0:02:16.43,0:02:22.45,Default,,0000,0000,0000,,طيور كركي التانتشو فصيلة محميّة\Nولا يمكنك رؤيتها إلّا في هوكّايدو الآن
Dialogue: 0,0:02:22.45,0:02:23.43,Default,,0000,0000,0000,,وما في ذلك؟
Dialogue: 0,0:02:27.78,0:02:31.15,CharCard,,0000,0000,0000,,{\fad(300,100)}  أرض الإطعام
Dialogue: 0,0:02:40.64,0:02:42.76,Default,,0000,0000,0000,,!طار واحدٌ آخر! يا للروعة
Dialogue: 0,0:02:43.01,0:02:46.23,Default,,0000,0000,0000,,ألم تكتفيا؟ علينا إيجاد مكان للمبيت
Dialogue: 0,0:02:46.76,0:02:48.76,Default,,0000,0000,0000,,وإلّا سننام في السيّارة الليلة
Dialogue: 0,0:02:48.76,0:02:49.68,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:02:53.04,0:02:55.31,Default,,0000,0000,0000,,من أذن لكم بالدخول هنا؟
Dialogue: 0,0:02:55.31,0:02:58.35,Default,,0000,0000,0000,,من؟ أهذا ممتلك خاص؟
Dialogue: 0,0:02:58.35,0:02:59.74,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:02:59.74,0:03:01.03,Default,,0000,0000,0000,,!آسفون
Dialogue: 0,0:03:01.03,0:03:05.31,Default,,0000,0000,0000,,سمعنا أنّ التانتشو لا تحبّ الناس\Nفأتينا لمشاهدتها من هنا
Dialogue: 0,0:03:05.31,0:03:07.48,Default,,0000,0000,0000,,آمل أنّكم لستم لصوص كركي
Dialogue: 0,0:03:07.70,0:03:09.69,Default,,0000,0000,0000,,أأبدو لك شخصاً كذاك؟
Dialogue: 0,0:03:09.69,0:03:10.93,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:03:11.15,0:03:14.36,Default,,0000,0000,0000,,أخبرني، لمَ زجاج هذه النافذة\Nمن الصنف المقوّى؟
Dialogue: 0,0:03:14.36,0:03:16.89,Default,,0000,0000,0000,,إنّه مثل المستعمل في الطائرات، أليس كذلك؟
Dialogue: 0,0:03:17.48,0:03:20.85,Default,,0000,0000,0000,,يوجد أشخاص يهوون كسر النوافذ للعبث
Dialogue: 0,0:03:20.85,0:03:22.01,Default,,0000,0000,0000,,أتحبّان التانتشو؟
Dialogue: 0,0:03:22.01,0:03:22.90,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:03:28.68,0:03:31.50,Default,,0000,0000,0000,,ما المسليّ في الاعتناء بالكركيّ؟
Dialogue: 0,0:03:31.50,0:03:34.18,Default,,0000,0000,0000,,لا أفهم تفكير المُسنّين
Dialogue: 0,0:03:34.42,0:03:37.88,Default,,0000,0000,0000,,!أبي! عرض علينا العمّ المبيت هنا الليلة
Dialogue: 0,0:03:37.88,0:03:40.14,Default,,0000,0000,0000,,!يوجد حمّام مفتوح بالجوار حتّى
Dialogue: 0,0:03:40.78,0:03:46.37,Default,,0000,0000,0000,,،ساعدتني ران-كن وكونان-كن\Nوالتانتشو تشعر بالسرور
Dialogue: 0,0:03:46.37,0:03:47.81,Default,,0000,0000,0000,,هذا تعبيرٌ عن امتناني
Dialogue: 0,0:03:48.28,0:03:50.43,Default,,0000,0000,0000,,أيعني ذلك... بالمجّان؟
Dialogue: 0,0:03:50.65,0:03:52.01,Default,,0000,0000,0000,,غادر إذا لم يعجبك الأمر
Dialogue: 0,0:03:52.82,0:03:54.98,Default,,0000,0000,0000,,!البتّة! نشكرك كثيراً
Dialogue: 0,0:03:55.48,0:03:57.02,Default,,0000,0000,0000,,إنّه ردّ جميل الكركي
Dialogue: 0,0:03:57.02,0:03:57.86,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:03:57.86,0:03:59.68,Default,,0000,0000,0000,,منزلي هناك
Dialogue: 0,0:04:00.31,0:04:02.35,Default,,0000,0000,0000,,أعيش بمفردي الآن
Dialogue: 0,0:04:07.31,0:04:10.39,Default,,0000,0000,0000,,تُوفيّت زوجتك قبل خمسة أعوام
Dialogue: 0,0:04:10.59,0:04:13.50,Default,,0000,0000,0000,,عشتُ بمفردي مذ آنذاك
Dialogue: 0,0:04:13.50,0:04:15.85,Default,,0000,0000,0000,,يبدو هذا الشيء حيّاً
Dialogue: 0,0:04:16.75,0:04:19.91,Default,,0000,0000,0000,,أقوم بحشو التانتشو التي تنفق\Nمن الإصابات أو المرض
Dialogue: 0,0:04:19.91,0:04:22.31,Default,,0000,0000,0000,,وأتبرّع بها للمدارس والمتاحف
Dialogue: 0,0:04:23.33,0:04:24.98,Default,,0000,0000,0000,,!مرحباً، أهلاً بكم
Dialogue: 0,0:04:25.54,0:04:29.65,Default,,0000,0000,0000,,هذا أخي تاموتسو، بدأ الإقامة المجّانية\Nهنا قبل 10 أيّام
Dialogue: 0,0:04:29.65,0:04:30.93,Default,,0000,0000,0000,,إنّه رسّام غير ناجح
Dialogue: 0,0:04:31.23,0:04:33.35,Default,,0000,0000,0000,,لا داعي لإضافة "غير ناجح" يا أخي
Dialogue: 0,0:04:33.78,0:04:37.56,Default,,0000,0000,0000,,قلتُ الحقيقة فقط، تفتقر لمهارة الملاحظة
Dialogue: 0,0:04:37.94,0:04:39.68,Default,,0000,0000,0000,,إنّه عيبك القاتل
Dialogue: 0,0:04:40.35,0:04:43.14,Default,,0000,0000,0000,,هذا موري-سان من طوكيو
Dialogue: 0,0:04:43.14,0:04:44.60,Default,,0000,0000,0000,,أنا مُتحرٍّ
Dialogue: 0,0:04:45.02,0:04:46.02,On Top,,0000,0000,0000,,مُتحرٍّ؟
Dialogue: 0,0:04:45.26,0:04:49.53,CharCard,,0000,0000,0004,,{\fad(300,0)}(ماتشيدا تاموتسو (53\Nرسّام
Dialogue: 0,0:04:46.02,0:04:49.39,On Top,,0000,0000,0000,,أأنت المتحرّي الشهير موري\Nكوغورو-سان نفسه؟
Dialogue: 0,0:04:49.80,0:04:54.43,Default,,0000,0000,0000,,وصلت أصداء سمعتي هوكّايدو حتّى إذاً؟
Dialogue: 0,0:04:54.43,0:04:55.47,Default,,0000,0000,0000,,لم تصل
Dialogue: 0,0:04:56.13,0:04:58.47,Default,,0000,0000,0000,,تاموتسو من أهل طوكيو
Dialogue: 0,0:04:58.47,0:04:59.64,Default,,0000,0000,0000,,...هكذا إذاً
Dialogue: 0,0:04:59.64,0:05:02.60,Default,,0000,0000,0000,,فيما ستستعمل هذا الزجاج\Nالمقوّى يا عمّ؟
Dialogue: 0,0:05:02.91,0:05:10.03,Default,,0000,0000,0000,,سأركّبه مكان زجاج تلك النافذة\Nكي أستطيع مشاهدة التانتشو منه
Dialogue: 0,0:05:16.36,0:05:17.34,Default,,0000,0000,0000,,!أبتاه
Dialogue: 0,0:05:17.34,0:05:18.78,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:05:18.78,0:05:20.43,Default,,0000,0000,0000,,ما الذي جلبكما؟
Dialogue: 0,0:05:20.68,0:05:23.06,Default,,0000,0000,0000,,!هل ستتبرّع بكلّ ثروتك للقريّة حقّاً؟
Dialogue: 0,0:05:23.06,0:05:24.43,Default,,0000,0000,0000,,هذا ليس صحيحاً، أليس كذلك يا أبي؟
Dialogue: 0,0:05:24.73,0:05:25.85,Default,,0000,0000,0000,,إنّها الحقيقة
Dialogue: 0,0:05:25.85,0:05:30.85,Default,,0000,0000,0000,,أنوي الاعتناء عبر ذلك بالتانتشو وبقيّة\Nالطيور المهاجرة للأبد
Dialogue: 0,0:05:31.22,0:05:34.88,On Top,,0000,0000,0000,,!لا يُعقل! اعتني بي بدل تلك الطيور
Dialogue: 0,0:05:31.22,0:05:37.97,CharCard,,0000,0200,0005,,{\fad(300,100)}(ماتشيدا نوريكو (29\Nمديرة متجر زينة
Dialogue: 0,0:05:31.22,0:05:37.97,CharCard,,0200,0000,0005,,{\fad(300,100)}(ماتشيدا هيروشي (27\Nموظّف شركة
Dialogue: 0,0:05:34.88,0:05:38.80,On Top,,0000,0000,0000,,أبي! ساعدني! سأفقد ملكيّة\N!متجر الزينة خاصّتي
Dialogue: 0,0:05:38.99,0:05:41.71,Default,,0000,0000,0000,,!يكفي! لدينا ضيوف
Dialogue: 0,0:05:41.71,0:05:44.43,Default,,0000,0000,0000,,!يا إلهي، كلّ ما تريدونه جميعاً هو المال
Dialogue: 0,0:05:46.46,0:05:48.86,Default,,0000,0000,0000,,!أين المشكلة؟ نحن عائلة
Dialogue: 0,0:05:48.86,0:05:51.50,Default,,0000,0000,0000,,ما هذا؟ لا توجد نار في موقد الحطب؟
Dialogue: 0,0:05:51.50,0:05:52.68,Default,,0000,0000,0000,,!كلا يا هيروشي-كن
Dialogue: 0,0:05:53.26,0:05:53.93,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:05:55.53,0:05:56.73,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:05:57.24,0:06:01.44,Default,,0000,0000,0000,,بنت حمامة قُمرية عشّها\Nفوق المدخنة في الربيع الفائت
Dialogue: 0,0:06:01.44,0:06:03.18,Default,,0000,0000,0000,,مع أنّها تركته
Dialogue: 0,0:06:03.56,0:06:06.19,Default,,0000,0000,0000,,!قد ترجع في الربيع القادم
Dialogue: 0,0:06:06.19,0:06:11.14,Default,,0000,0000,0000,,اسمع، لا يحقّ لك لمس شيء \N!في هذا المنزل، ليس الموقد فحسب
Dialogue: 0,0:06:11.51,0:06:16.38,Default,,0000,0000,0000,,طيور طيور طيور! هل الطيور أهمّ\Nعندك من ابنيك؟
Dialogue: 0,0:06:16.38,0:06:17.60,Default,,0000,0000,0000,,!يا للأب الرائع
Dialogue: 0,0:06:18.18,0:06:20.80,Default,,0000,0000,0000,,تاموتسو، هل أنت من استدعاهما؟
Dialogue: 0,0:06:21.25,0:06:24.83,Default,,0000,0000,0000,,،أجل، عرفتُ أنّ الأمر لن يروقك
Dialogue: 0,0:06:24.83,0:06:29.51,Default,,0000,0000,0000,,لكن ارتأيتُ أنّ مناقشة الأمر بصراحة\Nأفضل الآن من لاحقاً
Dialogue: 0,0:06:29.95,0:06:31.95,Default,,0000,0000,0000,,لم يكن عليك ذلك
Dialogue: 0,0:06:31.95,0:06:34.95,Default,,0000,0000,0000,,،سمعتَ من عمّك تاموتسو غالباً
Dialogue: 0,0:06:34.95,0:06:38.49,Default,,0000,0000,0000,,لكن سيجلب مُحامٍ الوثيقة هنا\Nفي الخامسة اليوم
Dialogue: 0,0:06:38.49,0:06:43.93,Default,,0000,0000,0000,,لحظة ختمي عليه، ستنتقل كلّ\N!الثلاثمئة مليون ينّ للقرية عند وفاتي
Dialogue: 0,0:06:44.16,0:06:45.64,Default,,0000,0000,0000,,!ثلاثمئة مليون؟
Dialogue: 0,0:06:46.02,0:06:48.19,Default,,0000,0000,0000,,!سأقابل ذاك المُحامي
Dialogue: 0,0:06:48.19,0:06:51.22,Default,,0000,0000,0000,,!ثلاثمئة مليون للتانتشو؟! هذه سخافة
Dialogue: 0,0:06:51.53,0:06:53.19,Default,,0000,0000,0000,,لا فائدة من مقابلتكِ له
Dialogue: 0,0:06:53.19,0:06:57.29,Default,,0000,0000,0000,,أعطيتكما النسبة المفروضة\N!من الميراث بالقانون سلفاً
Dialogue: 0,0:06:58.38,0:07:00.10,Default,,0000,0000,0000,,تشرّفتما بالقدوم بعد فترة طويلة
Dialogue: 0,0:07:00.10,0:07:03.45,Default,,0000,0000,0000,,لن تضرّكما زيارة قبر أمّكما
Dialogue: 0,0:07:04.68,0:07:07.93,Default,,0000,0000,0000,,الأب الكريه! ماذا نفعل يا أختي؟
Dialogue: 0,0:07:07.93,0:07:11.11,Default,,0000,0000,0000,,!سنقابل المحامي! سنردعه عن هذا بلا شكّ
Dialogue: 0,0:07:11.30,0:07:15.41,Default,,0000,0000,0000,,...يا إلهي، أيّ بيت سنبيت فيه
Dialogue: 0,0:07:18.51,0:07:21.78,Default,,0000,0000,0000,,!ستُشفى قريباً، تماسك
Dialogue: 0,0:07:21.78,0:07:23.91,Default,,0000,0000,0000,,كان رئيساً في السابق؟
Dialogue: 0,0:07:24.33,0:07:28.33,Default,,0000,0000,0000,,أجل، كان يملك معرض سيّارات في طوكيو
Dialogue: 0,0:07:28.33,0:07:34.12,Default,,0000,0000,0000,,،أُصيبت أختي بمرضٍ قبل ثمانية أعوام\Nوانتقلت هنا معه للتعافي منه
Dialogue: 0,0:07:35.03,0:07:38.58,Default,,0000,0000,0000,,اثنانهما فحسب؟ ماذا عن ابنيهما؟
Dialogue: 0,0:07:39.14,0:07:42.60,Default,,0000,0000,0000,,قالت نوريكو وهيروشي أنّهما\N،لم يريدا مغادرة طوكيو
Dialogue: 0,0:07:42.60,0:07:45.91,Default,,0000,0000,0000,,فأعطاهما أخي ميراثهما باكراً
Dialogue: 0,0:07:47.19,0:07:51.20,Default,,0000,0000,0000,,...واستنفداه؟ أشعر بالغيرة
Dialogue: 0,0:08:00.74,0:08:02.03,Default,,0000,0000,0000,,...أنت! ما الذي
Dialogue: 0,0:08:03.83,0:08:08.08,Default,,0000,0000,0000,,!اصمت! لا سهم به\Nألا ترى؟
Dialogue: 0,0:08:09.61,0:08:11.20,Default,,0000,0000,0000,,ابتعد
Dialogue: 0,0:08:15.24,0:08:17.12,Default,,0000,0000,0000,,يا للابن السيّئ
Dialogue: 0,0:08:21.44,0:08:23.07,Default,,0000,0000,0000,,...عادت الحياة لي
Dialogue: 0,0:08:23.81,0:08:26.93,Default,,0000,0000,0000,,...لكن هناك شيءٌ ما مفقود
Dialogue: 0,0:08:30.64,0:08:31.70,Default,,0000,0000,0000,,...يراودني شعورٌ سيّئ
Dialogue: 0,0:08:35.20,0:08:39.36,Default,,0000,0000,0000,,يا إلهي، اجلب الساكي الخاص بك بنفسك
Dialogue: 0,0:08:41.58,0:08:42.32,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:08:49.95,0:08:51.45,Default,,0000,0000,0000,,!لذيذ
Dialogue: 0,0:08:52.16,0:08:55.74,Default,,0000,0000,0000,,ما رأيك يا موري-سان؟ أليس الينبوع الساخن رائعاً؟
Dialogue: 0,0:08:55.74,0:08:58.41,Default,,0000,0000,0000,,!إنّه الأفضل! لا تذمّر البتّة
Dialogue: 0,0:08:58.41,0:08:59.92,Default,,0000,0000,0000,,يسرّني سماع ذلك
Dialogue: 0,0:08:59.92,0:09:00.92,Default,,0000,0000,0000,,أين تتّجه؟
Dialogue: 0,0:09:01.24,0:09:07.02,Default,,0000,0000,0000,,في الواقع، مضت عشرة أيام مذ أتيت هنا\Nلكن لا يزال دفتر الرسم فارغاً
Dialogue: 0,0:09:07.02,0:09:10.14,Default,,0000,0000,0000,,خطر لي أن أتجّه لموقع الإطعام لرسم التانتشو
Dialogue: 0,0:09:10.14,0:09:11.49,Default,,0000,0000,0000,,...فلتستمتعوا بوقتكم
Dialogue: 0,0:09:13.30,0:09:14.09,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:09:14.09,0:09:15.47,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:09:15.47,0:09:19.46,Default,,0000,0000,0000,,بالمناسبة، سأعود عند الخامسة\Nعندما يصل المحامي
Dialogue: 0,0:09:19.46,0:09:21.49,Default,,0000,0000,0000,,لذا استمتعوا بوقتكم حتّى حينها
Dialogue: 0,0:09:21.92,0:09:24.79,Default,,0000,0000,0000,,!أجل! سنحرص على ذلك
Dialogue: 0,0:09:28.04,0:09:32.11,Default,,0000,0000,0000,,!أبي! عليك الخروج قبل أن يصل
Dialogue: 0,0:09:32.70,0:09:37.68,Default,,0000,0000,0000,,ليس بعد! لا أعرف متى قد أدخل\N!ينبوعاً ساخناً بعد هذه المرّة
Dialogue: 0,0:09:39.19,0:09:41.93,Default,,0000,0000,0000,,!ستكون غلطتك إذا أُغمي عليك
Dialogue: 0,0:09:45.61,0:09:48.94,Default,,0000,0000,0000,,هيروشي-سان... أيرجع لطوكيو؟
Dialogue: 0,0:09:52.93,0:09:54.16,Default,,0000,0000,0000,,...أشعر بالدوار
Dialogue: 0,0:09:54.39,0:09:57.60,Default,,0000,0000,0000,,ألا تعرف الالتزام بالحدود؟
Dialogue: 0,0:09:57.60,0:09:59.11,Default,,0000,0000,0000,,...أشعر بتوعّك
Dialogue: 0,0:09:59.42,0:10:00.71,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:10:00.71,0:10:04.09,Default,,0000,0000,0000,,فقد بقيت في الماء لساعتين\N!وسبحت بعد الشرب
Dialogue: 0,0:10:04.09,0:10:06.08,Default,,0000,0000,0000,,أهو بخير؟
Dialogue: 0,0:10:06.99,0:10:11.89,Default,,0000,0000,0000,,،يشعر بدوار فحسب. بأيّ حال\Nهل أنهيت رسم التانتشو؟
Dialogue: 0,0:10:11.89,0:10:13.60,Default,,0000,0000,0000,,أجل، كما ترين
Dialogue: 0,0:10:14.94,0:10:17.63,Default,,0000,0000,0000,,!مذهل! أنت بارع
Dialogue: 0,0:10:20.55,0:10:24.10,Default,,0000,0000,0000,,،حسناً، سأرجع الآن\Nفلتأخذوا وقتكم
Dialogue: 0,0:10:25.43,0:10:26.56,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:10:32.80,0:10:36.10,CharCard,,0000,0000,0003,,{\fad(300,0)}(ياماغامي تاتسو (58\Nمحامي
Dialogue: 0,0:10:33.12,0:10:36.10,On Top,,0000,0000,0000,,،مساء الخير يا تاموتسو-سان\Nهل شوزو-سان في البيت؟
Dialogue: 0,0:10:36.10,0:10:40.35,Default,,0000,0000,0000,,أجل، يُفترض أنّه بانتظارك. تفضّل
Dialogue: 0,0:10:50.26,0:10:51.66,Default,,0000,0000,0000,,!زجاج النافذة محطّم
Dialogue: 0,0:10:56.44,0:10:58.14,Default,,0000,0000,0000,,!أخي
Dialogue: 0,0:10:58.14,0:10:59.89,Default,,0000,0000,0000,,!مصيبة
Dialogue: 0,0:11:03.85,0:11:07.14,Default,,0000,0000,0000,,!لا جدوى! إنّها مقفلة من الداخل
Dialogue: 0,0:11:07.76,0:11:09.09,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:11:09.09,0:11:11.43,Default,,0000,0000,0000,,!قُتل أخي بسهم
Dialogue: 0,0:11:13.33,0:11:15.89,Default,,0000,0000,0000,,...لا يُعقل
Dialogue: 0,0:11:22.49,0:11:23.38,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:11:23.38,0:11:24.41,Default,,0000,0000,0000,,!كلا! لا يمكنك الدخول
Dialogue: 0,0:11:24.41,0:11:27.10,Default,,0000,0000,0000,,...هـ-هيروشي! يا عمّي، هيروشي قد
Dialogue: 0,0:11:27.82,0:11:29.27,Default,,0000,0000,0000,,!اهدئي يا نوري-تشان
Dialogue: 0,0:11:29.27,0:11:34.15,Default,,0000,0000,0000,,فلتبحثي عن هيروشي-كن! سأخبر أنا\Nالمتحرّي موري في الينبوع الساخن
Dialogue: 0,0:11:34.15,0:11:36.86,Default,,0000,0000,0000,,لتتّصل أنت يا ياماغامي سينسي بالشرطة\N!من الهاتف عند المدخل
Dialogue: 0,0:11:36.86,0:11:38.24,Default,,0000,0000,0000,,!حـ-حسناً
Dialogue: 0,0:11:43.85,0:11:46.68,Default,,0000,0000,0000,,يبدو أنّ القوس أُطلق من الخارج
Dialogue: 0,0:11:46.68,0:11:51.72,Default,,0000,0000,0000,,كانت النافذة مقفلة، وكان باب الغرفة\Nمقفلاً من الداخل، صحيح؟
Dialogue: 0,0:11:52.00,0:11:56.43,Default,,0000,0000,0000,,أجل، يقفلها عند الرابعة يومياً لمشاهدة أشرطة فيديو
Dialogue: 0,0:11:57.04,0:12:00.70,Default,,0000,0000,0000,,يشاهد أشرطة لأختي المُتوفّاة يومياً
Dialogue: 0,0:12:00.70,0:12:06.79,Default,,0000,0000,0000,,لم يرد أن يراه أحد وهو يجلس لرؤيتها غالباً
Dialogue: 0,0:12:07.66,0:12:11.23,Default,,0000,0000,0000,,لذا كان زجاج النافذة زجاجاً مصنفراً؟
Dialogue: 0,0:12:11.23,0:12:14.44,Default,,0000,0000,0000,,كان سيستبدله بزجاج مقوّى\Nكي يستطيع أخيراً تجاوز حزنه
Dialogue: 0,0:12:14.44,0:12:18.47,Default,,0000,0000,0000,,ومشاهدة التانتشو متى يحلو له
Dialogue: 0,0:12:18.81,0:12:21.32,Default,,0000,0000,0000,,وقُتِل قبل أن يستطيع
Dialogue: 0,0:12:22.72,0:12:24.22,Default,,0000,0000,0000,,يوجد أثر
Dialogue: 0,0:12:24.85,0:12:27.52,Default,,0000,0000,0000,,أُطلق السهم عبر هذه النافذة؟
Dialogue: 0,0:12:30.09,0:12:31.22,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:12:31.84,0:12:34.92,Default,,0000,0000,0000,,لمَ شظايا الزجاج متراصّة؟
Dialogue: 0,0:12:34.92,0:12:37.14,Default,,0000,0000,0000,,ويوجد أثر آخر على الأرض
Dialogue: 0,0:12:37.75,0:12:38.79,Default,,0000,0000,0000,,!عمّي تاموتسو
Dialogue: 0,0:12:38.79,0:12:39.72,Default,,0000,0000,0000,,!أين هيروشي-كن؟
Dialogue: 0,0:12:39.72,0:12:40.91,Default,,0000,0000,0000,,!لم أجده في أيّ مكان
Dialogue: 0,0:12:40.91,0:12:42.72,Default,,0000,0000,0000,,!واختفت السيّارة
Dialogue: 0,0:12:42.72,0:12:46.79,Default,,0000,0000,0000,,رأينا هيروشي-سان يغادر بالسيّارة بعد الخامسة مباشرة
Dialogue: 0,0:12:46.79,0:12:47.69,Default,,0000,0000,0000,,كيف كان؟
Dialogue: 0,0:12:47.99,0:12:51.11,Default,,0000,0000,0000,,...بدا أنّه في عجلة
Dialogue: 0,0:12:51.11,0:12:52.31,Default,,0000,0000,0000,,...مثير للشبهة
Dialogue: 0,0:12:54.98,0:12:56.18,Default,,0000,0000,0000,,سخام؟
Dialogue: 0,0:12:59.93,0:13:02.77,Default,,0000,0000,0000,,!السخام مُزاح في عدّة مواضع
Dialogue: 0,0:13:05.10,0:13:06.68,Default,,0000,0000,0000,,قطعة خشبية غير محترقة؟
Dialogue: 0,0:13:06.68,0:13:07.85,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:13:07.85,0:13:10.60,Default,,0000,0000,0000,,!لا تتطفّل في مسرح الجريمة
Dialogue: 0,0:13:19.91,0:13:20.64,Default,,0000,0000,0000,,!هيروشي
Dialogue: 0,0:13:20.64,0:13:21.51,Default,,0000,0000,0000,,!هيروشي-كن
Dialogue: 0,0:13:21.79,0:13:23.91,On Top,,0000,0000,0000,,أنا إيزوماتسو من قسم شرطة هوكّاي
Dialogue: 0,0:13:21.98,0:13:26.26,CharCard,,0000,0000,0004,,{\fad(300,200)}الشرطيّ إيزوماتسو\Nقسم شرطة هوكّاي
Dialogue: 0,0:13:23.91,0:13:29.05,On Top,,0000,0000,0000,,اعترف هذا الابن بقتله أبيه\Nباستعمال هذا القوس
Dialogue: 0,0:13:29.28,0:13:30.11,Default,,0000,0000,0000,,اعترف؟
Dialogue: 0,0:13:30.11,0:13:31.32,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:13:31.32,0:13:35.77,Default,,0000,0000,0000,,أنا المتحرّي الشهير في طوكيو، موري كوغورو
Dialogue: 0,0:13:36.03,0:13:39.22,Default,,0000,0000,0000,,المتحرّي الشهير؟ موري ماذا؟
Dialogue: 0,0:13:39.60,0:13:41.31,Default,,0000,0000,0000,,...كوغورو
Dialogue: 0,0:13:41.31,0:13:44.68,Default,,0000,0000,0000,,يبدو أنّ اسمي لم يصل\Nهوكّايدو بالفعل إذاً
Dialogue: 0,0:13:44.68,0:13:46.27,Default,,0000,0000,0000,,...غريب
Dialogue: 0,0:13:46.47,0:13:49.34,Default,,0000,0000,0000,,!ما الأمر؟ هناك شيء يضايقني
Dialogue: 0,0:13:51.54,0:13:55.17,Default,,0000,0000,0000,,!لم أنو قتله، بل إخافته فقط
Dialogue: 0,0:13:56.58,0:14:00.63,Default,,0000,0000,0000,,صوّبتُ نحو ذاك التانتشو المحشوّ
Dialogue: 0,0:14:00.95,0:14:04.95,Default,,0000,0000,0000,,ظننتُ أنّه لن يتبرّع بثروته إذا أخفته
Dialogue: 0,0:14:04.95,0:14:08.33,Default,,0000,0000,0000,,لذا أخذت القوس من الورشة؟
Dialogue: 0,0:14:08.94,0:14:11.00,Default,,0000,0000,0000,,،عندما استرقتُ النظر خارجاً
Dialogue: 0,0:14:11.31,0:14:14.40,Default,,0000,0000,0000,,رأيتُه على الأريكة يشاهد\Nأشرطة فيديو لأمّي
Dialogue: 0,0:14:14.40,0:14:20.04,Default,,0000,0000,0000,,صوّبتُ نحو ذاك التانتشو\Nوتراجعتُ خطوتين، وأطلقت
Dialogue: 0,0:14:20.55,0:14:24.05,Default,,0000,0000,0000,,...هل أفزعك ذلك؟! لن يكون الطائر المرّة القادمة
Dialogue: 0,0:14:27.55,0:14:29.50,Default,,0000,0000,0000,,!لـ-لم أرغب بفعل ذلك
Dialogue: 0,0:14:29.50,0:14:32.21,Default,,0000,0000,0000,,!لكن أختي أصرّت عليّ
Dialogue: 0,0:14:32.63,0:14:35.92,Default,,0000,0000,0000,,!ما الذي تتفوّه به؟! لم أخبرك أن تقتل أحداً
Dialogue: 0,0:14:35.92,0:14:38.32,Default,,0000,0000,0000,,كما اقترحتُ ذلك لأنّ عمّي تاموتسو قال
Dialogue: 0,0:14:38.32,0:14:41.05,Default,,0000,0000,0000,,أن أبي قد يغيّر رأيه إذا أخفناه حقّاً
Dialogue: 0,0:14:41.49,0:14:45.82,Default,,0000,0000,0000,,!مهلك يا نوري-تشان! يستحيل أن أقول شيئاً كذلك
Dialogue: 0,0:14:45.82,0:14:48.01,Default,,0000,0000,0000,,لا بدّ أنّك أسأتِ الفهم
Dialogue: 0,0:14:49.86,0:14:53.38,Default,,0000,0000,0000,,،هناك ريشة في جيب بنطاله الخلفيّ\Nأهي ريشة تانتشو؟
Dialogue: 0,0:14:53.81,0:14:54.84,Default,,0000,0000,0000,,!ريشة؟
Dialogue: 0,0:15:00.22,0:15:03.87,Default,,0000,0000,0000,,...كما ظننت! لكن لا يكفي هذا
Dialogue: 0,0:15:04.80,0:15:06.97,Default,,0000,0000,0000,,!لحظة! النافذة العلوية
Dialogue: 0,0:15:15.51,0:15:17.67,Default,,0000,0000,0000,,!حسنٌ، وجدته
Dialogue: 0,0:15:18.04,0:15:20.09,Default,,0000,0000,0000,,،رسمات التانتشو الغريبة
Dialogue: 0,0:15:20.09,0:15:21.55,Default,,0000,0000,0000,,،والأثر على الزجاج المقوىّ
Dialogue: 0,0:15:22.16,0:15:25.01,Default,,0000,0000,0000,,وشظايا الزجاج المتراصّة\N!والأثر على الأرض
Dialogue: 0,0:15:25.41,0:15:27.47,Default,,0000,0000,0000,,!كما قطعة الخشب في الموقد
Dialogue: 0,0:15:27.47,0:15:30.02,Default,,0000,0000,0000,,!ارتبط جميعها بخيط
Dialogue: 0,0:15:30.02,0:15:31.93,Default,,0000,0000,0000,,!هيروشي-سان ليس القاتل
Dialogue: 0,0:15:37.25,0:15:40.65,Default,,0000,0000,0000,,!صدّقني رجاءً! لم أنو قتله حقّاً
Dialogue: 0,0:15:40.95,0:15:45.07,Default,,0000,0000,0000,,حسناً، حسناً، سنسمع كلّ ما لديك\Nبعدما نصل المركز
Dialogue: 0,0:15:45.61,0:15:51.02,Default,,0000,0000,0000,,،وسأطلب منكِ مرافقتنا أيضاً\Nفأنتِ تحت شبهة تحريضه
Dialogue: 0,0:15:51.65,0:15:52.73,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:15:53.23,0:15:55.48,Default,,0000,0000,0000,,أيناسبك ذلك أيّها المتحرّي الشهير؟
Dialogue: 0,0:15:55.48,0:16:01.06,Default,,0000,0000,0000,,بالطبع! فقد اعترف الفاعل\N...بارتكابه الجريمة بنفسه
Dialogue: 0,0:16:02.31,0:16:04.53,Default,,0000,0000,0000,,...بعوضة في خارج موسمها
Dialogue: 0,0:16:05.76,0:16:08.50,Default,,0000,0000,0000,,انتظر أيّها المحقق إيزوماتسو
Dialogue: 0,0:16:08.50,0:16:11.86,Default,,0000,0000,0000,,لم يقتل هيروشي-سان شوزو-سان
Dialogue: 0,0:16:13.13,0:16:17.32,Default,,0000,0000,0000,,ما هذا الهراء؟ اعترف بنفسه
Dialogue: 0,0:16:17.32,0:16:23.27,Default,,0000,0000,0000,,كيف تفسّر شظايا الزجاج التي تناثرت\Nبعدما أطلق هيروشي-سان السهم إذاً؟
Dialogue: 0,0:16:23.74,0:16:26.32,Default,,0000,0000,0000,,شظايا الزجاج؟
Dialogue: 0,0:16:26.32,0:16:28.07,Default,,0000,0000,0000,,هذه؟ وما فيها؟
Dialogue: 0,0:16:28.52,0:16:30.52,Default,,0000,0000,0000,,ألا تجد الأمر غريباً؟
Dialogue: 0,0:16:30.52,0:16:32.31,Default,,0000,0000,0000,,،أُطلق السهم من الخارج
Dialogue: 0,0:16:32.31,0:16:35.98,Default,,0000,0000,0000,,وشظايا الزجاج المكسور متراصّة في خطّ
Dialogue: 0,0:16:36.73,0:16:41.35,Default,,0000,0000,0000,,لهذا يُتعبنا الهواة، يعبثون بمسرح الجريمة
Dialogue: 0,0:16:41.35,0:16:43.69,Default,,0000,0000,0000,,كان يوجد شيء هنا
Dialogue: 0,0:16:43.93,0:16:47.65,Default,,0000,0000,0000,,!صحيح، كان الزجاج المقوّى في ذاك المكان
Dialogue: 0,0:16:47.65,0:16:50.17,Default,,0000,0000,0000,,الزجاج المقوّى؟
Dialogue: 0,0:16:50.17,0:16:51.34,Default,,0000,0000,0000,,هذا؟
Dialogue: 0,0:16:56.11,0:17:00.90,Default,,0000,0000,0000,,وبذاك الوضع، أطلق هيروشي-سان\Nبالقوس من الخارج
Dialogue: 0,0:17:01.16,0:17:04.86,Default,,0000,0000,0000,,...ثمّ تناثرت شظايا الزجاج على الأرض
Dialogue: 0,0:17:04.86,0:17:05.78,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:06.28,0:17:09.77,Default,,0000,0000,0000,,تمهّل! ألا يُفترض أنّ السهم\N!أصاب الزجاج المقوّى أيضاً؟
Dialogue: 0,0:17:09.77,0:17:14.65,Default,,0000,0000,0000,,صحيح، أصاب السهم الزجاج المقوّى وعلق بالأرض
Dialogue: 0,0:17:19.85,0:17:25.19,Default,,0000,0000,0000,,الزجاج المقوّى شفّاف، فلم يلحظ هيروشي-سان \Nعند نظره من الخارج
Dialogue: 0,0:17:25.81,0:17:30.00,Default,,0000,0000,0000,,من أين أتى السهم الذي\N!اخترق صدر الضحيّة إذاً؟
Dialogue: 0,0:17:30.00,0:17:31.65,Default,,0000,0000,0000,,داخل موقد الحطب
Dialogue: 0,0:17:32.34,0:17:35.61,Default,,0000,0000,0000,,به أجزاء أُزيح منها السخام
Dialogue: 0,0:17:35.88,0:17:39.62,Default,,0000,0000,0000,,ذلك لأنّ قوساً قد نُصّب هناك
Dialogue: 0,0:17:39.62,0:17:42.06,Default,,0000,0000,0000,,لكن كيف أطلقه من الداخل؟
Dialogue: 0,0:17:42.06,0:17:43.27,Default,,0000,0000,0000,,بهذه
Dialogue: 0,0:17:43.74,0:17:45.91,Default,,0000,0000,0000,,كانت داخل الموقد
Dialogue: 0,0:17:45.91,0:17:48.69,Default,,0000,0000,0000,,بما ستفيد قطعة خشبية كهذه؟
Dialogue: 0,0:17:49.23,0:17:52.90,Default,,0000,0000,0000,,أوّلاً، تحشر قطعة خشبية مربوطة بخيط
Dialogue: 0,0:17:52.90,0:17:55.82,Default,,0000,0000,0000,,خلف زناد القوس المثبّت في الموقد
Dialogue: 0,0:17:55.82,0:17:59.85,Default,,0000,0000,0000,,تربط شريطاً مطاطياً حول الزناد تالياً
Dialogue: 0,0:17:59.85,0:18:04.90,Default,,0000,0000,0000,,الخيط المربوط بالقطعة الخشبية\Nيمتدّ للمدخنة حتّى الخارج
Dialogue: 0,0:18:04.90,0:18:08.84,Default,,0000,0000,0000,,نظر الشخص الذي كان مُمسكاً به\Nمن النافذة العلوية
Dialogue: 0,0:18:08.84,0:18:13.52,Default,,0000,0000,0000,,وتحقّق أنّ شوزو-سان كان\Nجالساً في مكانه المعتاد
Dialogue: 0,0:18:13.52,0:18:19.06,Default,,0000,0000,0000,,بعدها سحب الخيط مزامناً لإطلاق\Nهيروشي-سان للقوس
Dialogue: 0,0:18:19.41,0:18:22.02,Default,,0000,0000,0000,,أصاب ذاك السهم شوزو-سان في صدره
Dialogue: 0,0:18:22.02,0:18:26.19,Default,,0000,0000,0000,,ترك الخيط آثاراً واضحة داخل المدخنة
Dialogue: 0,0:18:26.75,0:18:32.65,Default,,0000,0000,0000,,،كان على السهم سخام من الموقد\Nفسيؤكد التحليل الأمر
Dialogue: 0,0:18:33.19,0:18:35.46,Default,,0000,0000,0000,,أي كانت جريمةً بسابق الإصرار والترصّد؟
Dialogue: 0,0:18:35.46,0:18:38.43,Default,,0000,0000,0000,,صحيح، بتمام الإصرار والترصّد
Dialogue: 0,0:18:38.43,0:18:43.15,Default,,0000,0000,0000,,أي كان القاتل من اهتمّ بأمر الزجاج المقوّى\N!والقوس بعد الجريمة؟
Dialogue: 0,0:18:43.56,0:18:46.23,Default,,0000,0000,0000,,كان ذلك مستحيلاً على هيروشي-سان الذي فرّ
Dialogue: 0,0:18:46.23,0:18:48.60,Default,,0000,0000,0000,,ما يعني أنّه ليس القاتل
Dialogue: 0,0:18:49.09,0:18:51.17,Default,,0000,0000,0000,,،من قتل شوزو-سان
Dialogue: 0,0:18:51.17,0:18:56.53,Default,,0000,0000,0000,,وتلاعب بالزجاج المقوّى والقوس\N...في هذه الغرفة المقفلة
Dialogue: 0,0:18:56.92,0:18:59.52,Default,,0000,0000,0000,,!كان أنت يا ماتشيدا تاموتسو-سان
Dialogue: 0,0:18:59.52,0:19:03.37,Default,,0000,0000,0000,,!لكن كان هناك ثلاثة أشخاص في مسرح الجريمة
Dialogue: 0,0:19:03.37,0:19:06.48,Default,,0000,0000,0000,,!كانوا ليلاحظوا تغيّر مكان الزجاج المقوّى
Dialogue: 0,0:19:06.71,0:19:07.91,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:19:07.91,0:19:11.40,Default,,0000,0000,0000,,أوّل ما تتوجّه له أنظار من\Nيدخل مسرح جريمة قتل
Dialogue: 0,0:19:11.90,0:19:14.36,Default,,0000,0000,0000,,هو الضحيّة
Dialogue: 0,0:19:14.36,0:19:17.44,Default,,0000,0000,0000,,،بمنعهم من الدخول سريعاً
Dialogue: 0,0:19:17.44,0:19:20.02,Default,,0000,0000,0000,,لن يستطيعوا تذكّر حال الغرفة
Dialogue: 0,0:19:20.02,0:19:23.88,Default,,0000,0000,0000,,إضافةً لذلك، أعطيت تعليمات للاثنين\Nلإبعادهم عن المكان
Dialogue: 0,0:19:24.86,0:19:29.73,Default,,0000,0000,0000,,بعدها، اهتممت بأمر الزجاج المقوّى والقوس
Dialogue: 0,0:19:30.34,0:19:32.68,Default,,0000,0000,0000,,دافعك لقتل شوزو-سان
Dialogue: 0,0:19:32.68,0:19:35.69,Default,,0000,0000,0000,,هو رفضه إقراضك غالباً
Dialogue: 0,0:19:36.13,0:19:38.94,Default,,0000,0000,0000,,!يا إلهي، كلّ ما تريدونه جميعاً هو المال
Dialogue: 0,0:19:39.50,0:19:45.29,Default,,0000,0000,0000,,!لم يخصّهما بالذكر فحسب، بل شملك
Dialogue: 0,0:19:45.29,0:19:49.48,Default,,0000,0000,0000,,لذا استدعيتَ هيروشي-سان وشقيقته\Nونصبتَ لهما فخّاً
Dialogue: 0,0:19:50.32,0:19:56.44,Default,,0000,0000,0000,,فلن تحصل على نصيب من الميراث\Nإذا قتلتَه بنفسك
Dialogue: 0,0:19:57.03,0:20:01.65,Default,,0000,0000,0000,,...للأسف يا موري-سان، عندما قُتل أخي
Dialogue: 0,0:20:01.65,0:20:04.86,Default,,0000,0000,0000,,كنتُ في أرض الإطعام أرسم، كما ترى
Dialogue: 0,0:20:05.81,0:20:10.56,Default,,0000,0000,0000,,!اشتبهتُ بك بسبب تلك الرسمات تحديداً
Dialogue: 0,0:20:11.70,0:20:15.07,Default,,0000,0000,0000,,فذيل طائر التانتشو ليس أسود
Dialogue: 0,0:20:15.43,0:20:18.52,Default,,0000,0000,0000,,ريش جناحه هو الأسود، بينما ذيله أبيض
Dialogue: 0,0:20:19.73,0:20:24.83,Default,,0000,0000,0000,,إضافةً لذلك، تواجه التانتشو الرياح عند نومها
Dialogue: 0,0:20:24.83,0:20:28.07,Default,,0000,0000,0000,,لكنّها نائمة عكس الرياح في رسمتك
Dialogue: 0,0:20:28.07,0:20:31.82,Default,,0000,0000,0000,,،هذا لأنّك لم ترسمها في أرض الإطعام
Dialogue: 0,0:20:31.82,0:20:34.16,Default,,0000,0000,0000,,!بل رسمت المحشوّ هنا
Dialogue: 0,0:20:34.16,0:20:37.15,Default,,0000,0000,0000,,وليس اليوم، بل قبل عدّة أيام غالباً
Dialogue: 0,0:20:38.31,0:20:41.86,Default,,0000,0000,0000,,،لتوهمنا أنّك رسمتها اليوم
Dialogue: 0,0:20:41.86,0:20:45.78,Default,,0000,0000,0000,,أريتنا دفتر رسمٍ فارغ
Dialogue: 0,0:20:46.27,0:20:47.57,Default,,0000,0000,0000,,أأنا مخطئ؟
Dialogue: 0,0:20:48.39,0:20:53.26,Default,,0000,0000,0000,,معك حقّ، لعلّي ارتكبتُ خطأً\N،في رسم ريش التانتشو
Dialogue: 0,0:20:53.26,0:20:58.27,Default,,0000,0000,0000,,!لكنّك لم تثبت أنّي لم أرسمها هناك كذلك
Dialogue: 0,0:20:58.59,0:21:03.82,Default,,0000,0000,0000,,أتتذكر إسقاطك لدفتر الرسم\Nعند الينبوع الساخن؟
Dialogue: 0,0:21:04.42,0:21:08.89,Default,,0000,0000,0000,,أمسك به كونان وقتها وأعاده لك
Dialogue: 0,0:21:09.61,0:21:14.18,Default,,0000,0000,0000,,أجل، يُفترض أن نجد بصمات\Nكونان على دفتر الرسم ذاك
Dialogue: 0,0:21:14.48,0:21:18.14,Default,,0000,0000,0000,,هذا إذا افترضنا أنّه الذي معك
Dialogue: 0,0:21:18.14,0:21:21.39,Default,,0000,0000,0000,,!مسحتُه لاحقاً لأنّه اتّسخ
Dialogue: 0,0:21:21.39,0:21:26.31,Default,,0000,0000,0000,,لا بأس، الدليل هي الريشة\Nفي جيب بنطالك الخلفيّ
Dialogue: 0,0:21:26.72,0:21:28.64,Default,,0000,0000,0000,,ر-ريشة تانتشو؟
Dialogue: 0,0:21:28.64,0:21:32.06,Default,,0000,0000,0000,,كلا، ليست ريشة تانتشو
Dialogue: 0,0:21:33.09,0:21:37.19,Default,,0000,0000,0000,,إنّها ريشة حمامة القُمرية التي\Nبنت عشّاً أعلى المدخنة
Dialogue: 0,0:21:37.80,0:21:43.06,Default,,0000,0000,0000,,علقت بجيبك عندما وضعت الخيط داخله غالباً
Dialogue: 0,0:21:44.83,0:21:49.05,Default,,0000,0000,0000,,لذا يُفترض أنّنا سنجد\Nسخاماً فيه كذلك
Dialogue: 0,0:21:50.32,0:21:55.60,Default,,0000,0000,0000,,...عجباً، وقعتُ في الشبهة بسبب رسماتي
Dialogue: 0,0:21:56.65,0:22:00.30,Default,,0000,0000,0000,,يبدو أنّي لم أكن أتحلّى\Nبموهبة في الرسم حقّاً
Dialogue: 0,0:22:01.06,0:22:05.23,Default,,0000,0000,0000,,كما قال أخي، أفتقر لمهارة الملاحظة
Dialogue: 0,0:22:05.23,0:22:07.23,Default,,0000,0000,0000,,استوعبتُ الأمر أخيراً
Dialogue: 0,0:23:35.56,0:23:40.48,Default,,0000,0000,0000,,!تبرّع بكامل ثروته! تأسيس مؤسسة الطيور المهاجرة
Dialogue: 0,0:23:40.91,0:23:44.97,Default,,0000,0000,0000,,لكن من الرائع أنّ الابنين قرّرا\Nاتّباع وصيّة ماتشيدا-سان
Dialogue: 0,0:23:44.97,0:23:47.19,Default,,0000,0000,0000,,والاعتناء بالتانتشو
Dialogue: 0,0:23:47.19,0:23:49.83,Default,,0000,0000,0000,,لكن ثلاثمئة مليون؟
Dialogue: 0,0:23:49.83,0:23:53.15,Default,,0000,0000,0000,,أريد أن أصبح تانتشو ويُعتنى بي أيضاً
Dialogue: 0,0:23:55.29,0:23:59.45,Default,,0000,0000,0000,,لن يتعدّل هذا المُسن مهما حصل
Dialogue: 0,0:24:01.31,0:24:06.79,Default,,0000,0000,0000,,معظم روايات السيّد دوراكورا تتضمّن\N،مصّاصي الدماء كشخصيات رئيسية
Dialogue: 0,0:24:06.93,0:24:09.74,Default,,0000,0000,0000,,لذا يُلقّب بالسيّد دراكولا
Dialogue: 0,0:24:16.25,0:24:19.62,Default,,0000,0000,0000,,كانت كلّ النوافذ مُقفلة من الداخل
Dialogue: 0,0:24:19.75,0:24:22.04,Default,,0000,0000,0000,,...ما يعني أنّ القاتل
Dialogue: 0,0:24:22.37,0:24:24.08,Default,,0000,0000,0000,,!من الدّاخل
Dialogue: 0,0:24:24.08,0:24:30.07,On Top,,0000,0000,0000,,جريمة قتل قصر دراكولا\N(الجزء الأوّل)
Dialogue: 0,0:24:24.79,0:24:26.51,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.51,0:24:30.00,Default,,0000,0000,0000,,جريمة قتل قصر دراكولا\N(الجزء الأوّل)
Dialogue: 0,0:24:45.96,0:24:48.35,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.35,0:24:50.07,Default,,0000,0000,0000,,آلة عرض أفلام
Dialogue: 0,0:24:50.07,0:24:51.74,Default,,0000,0000,0000,,...ما يتبادر لذهنك عند التفكير بدراكولا
Dialogue: 0,0:24:51.74,0:24:52.46,Default,,0000,0000,0000,,!منتصف الليل
Dialogue: 0,0:24:52.46,0:24:53.13,Default,,0000,0000,0000,,!لحم بشريّ
Dialogue: 0,0:24:53.13,0:24:53.98,Default,,0000,0000,0000,,!لحم مشويّ
Dialogue: 0,0:24:53.98,0:24:55.98,Default,,0000,0000,0000,,ذلك لا ينطبق

