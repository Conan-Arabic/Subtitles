Dialogue: 0,0:00:01.13,0:00:04.46,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.46,0:00:06.33,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.63,0:00:09.83,Default,,0000,0000,0000,,!اليوم شفرة مبتكرة! إذا لم ينفع الجمع، فجرّب الطرح
Dialogue: 0,0:00:09.83,0:00:11.59,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.59,0:00:13.83,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.83,0:00:15.96,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.46,0:00:24.13,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.13,0:00:31.17,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.85,0:00:39.30,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.30,0:00:46.80,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.80,0:00:59.25,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.09,0:01:06.55,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.46,0:01:13.35,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.35,0:01:19.80,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.80,0:01:26.74,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:53.00,0:01:57.80,Default,,0000,0000,0000,,،أتت كاوري، ابنة الروائيّ شينمي نينتارو
Dialogue: 0,0:01:57.80,0:02:02.18,Default,,0000,0000,0000,,لتطلب من العمّ البحث\Nعن والديها المفقودين
Dialogue: 0,0:02:02.92,0:02:06.13,Default,,0000,0000,0000,,اختفيا مذ شهرين
Dialogue: 0,0:02:06.13,0:02:10.59,Default,,0000,0000,0000,,لكن لا يزال الناشر يتلقّى\Nنصوص سلسلته الجديدة
Dialogue: 0,0:02:11.80,0:02:14.25,Default,,0000,0000,0000,,توجّهنا لشركة النشر فوراً
Dialogue: 0,0:02:15.67,0:02:21.13,Default,,0000,0000,0000,,ورأينا هناك عدّة أشياء مبهمة في نصوصه
Dialogue: 0,0:02:21.13,0:02:25.07,Default,,0000,0000,0000,,!وتبيّن أنّها شفرة تطلب النجدة
Dialogue: 0,0:02:25.71,0:02:27.53,Default,,0000,0000,0000,,!هـ-هذا
Dialogue: 0,0:02:28.25,0:02:29.84,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:02:29.84,0:02:33.50,Default,,0000,0000,0000,,توجد رسالة مخفية من شينمي سينسي\N!بين هذه الأسطر
Dialogue: 0,0:02:34.50,0:02:40.13,Default,,0000,0000,0000,,في تلك الحالة، رسالة الإهداء الاستفزازية تلك\Nوظهور المؤلّف في العمل
Dialogue: 0,0:02:40.13,0:02:43.71,Default,,0000,0000,0000,,!والحوار الغريب، كلّها متوافقة
Dialogue: 0,0:02:45.47,0:02:51.89,Default,,0000,0000,0000,,لكن ما هدف الفاعل الذي يحتجز\N!شينمي سينسي وزوجته؟
Dialogue: 0,0:02:57.13,0:03:03.21,Title,,0000,0000,15,,{\fad(300,0)}جريمة اختفاء مؤلف روايات الغموض\N(الجزء الثاني)
Dialogue: 0,0:02:57.34,0:03:01.25,Default,,0000,0000,0000,,جريمة اختفاء مؤلف روايات الغموض\N(الجزء الثاني)
Dialogue: 0,0:03:05.00,0:03:07.67,Default,,0000,0000,0000,,ما الأمر؟ هل أدركت شيئاً مُجدداً؟
Dialogue: 0,0:03:07.80,0:03:10.49,Default,,0000,0000,0000,,...ليس بالأمر الكبير، لكن
Dialogue: 0,0:03:13.80,0:03:16.42,Default,,0000,0000,0000,,"أجل، دائرة التحرير في "عصر الأدب
Dialogue: 0,0:03:17.22,0:03:21.26,Default,,0000,0000,0000,,...كلّ الأحرف الأولى من الحوار تشكّل نصف
Dialogue: 0,0:03:21.26,0:03:23.85,Default,,0000,0000,0000,,ماذا؟ حللت الشفرة؟
Dialogue: 0,0:03:23.85,0:03:25.06,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:03:25.43,0:03:27.14,Default,,0000,0000,0000,,أهنالك خطبٌ ما؟
Dialogue: 0,0:03:27.14,0:03:30.55,Default,,0000,0000,0000,,يقول شاب بلكنة كانساي\Nأنّه حلّ الشفرة
Dialogue: 0,0:03:30.55,0:03:31.98,Default,,0000,0000,0000,,لذا عليّ استدعاء الشرطة هنا
Dialogue: 0,0:03:32.55,0:03:34.44,Default,,0000,0000,0000,,شاب بلكنة كانساي؟
Dialogue: 0,0:03:36.14,0:03:37.51,Default,,0000,0000,0000,,أجل، مرحباً؟
Dialogue: 0,0:03:37.51,0:03:42.53,Default,,0000,0000,0000,,!اسمع! لا تجعلني أكرّر كلامي يا أحمق\N!اتّصل بالشرطة فوراً
Dialogue: 0,0:03:43.70,0:03:46.25,Default,,0000,0000,0000,,أنت يا هاتّوري-كن؟ معك ميغوري
Dialogue: 0,0:03:46.25,0:03:50.21,Default,,0000,0000,0000,,حضرة المفتّش، أنت موجودٌ هناك؟\Nمضى وقتٌ طويل
Dialogue: 0,0:03:50.55,0:03:52.17,Default,,0000,0000,0000,,وما قصّتك بالضبط؟
Dialogue: 0,0:03:52.47,0:03:57.88,Default,,0000,0000,0000,,الشفرة، حللت الشفرة المخفيّة\Nفي ثنايا رواية "نصفان في القمّة" هذه
Dialogue: 0,0:03:58.85,0:04:03.43,Default,,0000,0000,0000,,عندما قرأتُ صفحة الإهداء\Nلأوّل مرّة، ظننته عجوزاً مزعجاً
Dialogue: 0,0:04:03.43,0:04:05.35,Default,,0000,0000,0000,,لكن تكوّنت لديّ الصورة بينما أقرأ
Dialogue: 0,0:04:05.93,0:04:11.93,Default,,0000,0000,0000,,حوار المؤلف شينمي الذي ظهر\Nفي الرواية عبارة عن شفرة
Dialogue: 0,0:04:11.93,0:04:13.55,Default,,0000,0000,0000,,حواره شفرة؟
Dialogue: 0,0:04:13.55,0:04:19.78,Default,,0000,0000,0000,,أجل، أي أنّ الهدف من الإهداء\Nلم يكن استفزاز القرّاء
Dialogue: 0,0:04:20.43,0:04:27.45,Default,,0000,0000,0000,,بل كان يطلب من أحدهم قراءة الرسالة\Nالحقيقيّة التي أخفاها في الرواية
Dialogue: 0,0:04:27.70,0:04:31.60,Default,,0000,0000,0000,,و-وأفترض أنّك حللت الرسالة المشفّرة إذاً؟
Dialogue: 0,0:04:31.60,0:04:35.64,Default,,0000,0000,0000,,أجل، شفرة الجزء الأوّل مركّبة بسلاسة
Dialogue: 0,0:04:36.42,0:04:41.72,Default,,0000,0000,0000,,"كان المفتاح هو عنوان الرواية، "نصفان في القمّة
Dialogue: 0,0:04:41.72,0:04:44.97,Default,,0000,0000,0000,,يعني هذا أنّ الرمز في أعلى\N كلّ سطر يمثل نصف حرف
Dialogue: 0,0:04:44.97,0:04:47.39,Default,,0000,0000,0000,,أي بدمج رمزين تحصل على حرف كامل
Dialogue: 0,0:04:47.89,0:04:49.35,Default,,0000,0000,0000,,بدمج رمزين تحصل على حرف كامل؟
Dialogue: 0,0:04:50.18,0:04:53.02,Default,,0000,0000,0000,,إذا قرأت من البداية\N...واضعاً ذلك في الاعتبار
Dialogue: 0,0:04:53.43,0:04:55.51,Default,,0000,0000,0000,,،"دمج "تشيكارا" و"مي" يعطيك "سوكي
Dialogue: 0,0:04:55.51,0:04:57.43,Default,,0000,0000,0000,,،"و"جو" و"إيتشي" يعطيانك "كي
Dialogue: 0,0:04:57.43,0:04:59.30,Default,,0000,0000,0000,,،"و"سي" و"إيتشي" يعطيان "تي
Dialogue: 0,0:04:59.30,0:05:02.74,Default,,0000,0000,0000,,"وفي النهاية تحصل على "ري\N"من "نو" و"إيتشي
Dialogue: 0,0:05:03.10,0:05:06.20,Default,,0000,0000,0000,,،كو" و"هوكا" قبل ذلك تحيراني"
Dialogue: 0,0:05:06.76,0:05:11.67,Default,,0000,0000,0000,,لكن إذا كان المقصود برمز "هوكا" هو\Nاتركه في مكانٍ آخر"، فنضيف "كو" كما هي"
Dialogue: 0,0:05:12.26,0:05:14.13,Default,,0000,0000,0000,,...وإذا قرأتها سويّةً
Dialogue: 0,0:05:15.01,0:05:22.55,Default,,0000,0000,0000,,..."تا-تا سو كي تي كو ري"
Dialogue: 0,0:05:22.99,0:05:24.85,On Top,,0000,0000,0000,,(النجدة)
Dialogue: 0,0:05:25.10,0:05:27.72,Default,,0000,0000,0000,,!النجدة؟! إنّه نداء استغاثة؟
Dialogue: 0,0:05:27.72,0:05:33.98,Default,,0000,0000,0000,,أجل، أرجّح أنّ هذا الرجل محتجز في مكانٍ\Nومجبورٌ على الكتابة
Dialogue: 0,0:05:34.43,0:05:38.10,Default,,0000,0000,0000,,فهمت، لذا استعمل هذه الطريقة
Dialogue: 0,0:05:38.10,0:05:42.40,Default,,0000,0000,0000,,يمكنه إيصال رسالة لقرّائه دون\Nأن يلاحظ الفاعل
Dialogue: 0,0:05:42.76,0:05:47.30,Default,,0000,0000,0000,,كانت أمّي مسرورةً لأنّها أوّل\N،قصّة جديدة لعشرة أعوام
Dialogue: 0,0:05:47.30,0:05:53.37,Default,,0000,0000,0000,,فلا بدّ أنّ الفاعل معجب مجنون أو شخص \Nينوي سرقة أجور نصوص روائيّ شهير
Dialogue: 0,0:05:54.10,0:05:56.43,Default,,0000,0000,0000,,هل دُفع أجر هذه النصوص؟
Dialogue: 0,0:05:56.43,0:05:57.55,Default,,0000,0000,0000,,ليس بعد
Dialogue: 0,0:05:57.55,0:06:03.34,Default,,0000,0000,0000,,قال أنّه سيخبرنا بالمكان الذي سيرسل\Nالمال له عندما ينهي القصّة
Dialogue: 0,0:06:03.68,0:06:06.26,Default,,0000,0000,0000,,!حسناً، تفقّدوا كلّ رسائل المعجبين المشبوهة
Dialogue: 0,0:06:06.26,0:06:06.80,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:06:07.10,0:06:10.26,Default,,0000,0000,0000,,!لكنّي لم أحلّ الشفرة بأسرها بعد
Dialogue: 0,0:06:11.05,0:06:13.23,Default,,0000,0000,0000,,!لحظة! حضرة المفتّش؟! حضرة المفتّش؟
Dialogue: 0,0:06:13.93,0:06:15.09,Default,,0000,0000,0000,,!حضرة المفتّش؟
Dialogue: 0,0:06:15.09,0:06:19.20,Default,,0000,0000,0000,,أنت! أين ذهبت؟\N!لا تقلّل من الآخرين هكذا
Dialogue: 0,0:06:20.55,0:06:25.66,Default,,0000,0000,0000,,...لكن يا هاتّوري، بشأن بقيّة أسطر شينمي سينسي
Dialogue: 0,0:06:25.66,0:06:26.24,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:26.68,0:06:29.60,Default,,0000,0000,0000,,!أنت يا كودو! ما الذي تفعله هناك؟
Dialogue: 0,0:06:29.60,0:06:31.95,Default,,0000,0000,0000,,لا شيء، صادف أنّي أتيت
Dialogue: 0,0:06:31.95,0:06:35.47,Default,,0000,0000,0000,,لا عجب، فنحن متشابهان كثيراً
Dialogue: 0,0:06:35.47,0:06:37.92,Default,,0000,0000,0000,,تتقاطع طرقنا دون أن ننوي
Dialogue: 0,0:06:38.48,0:06:40.09,Default,,0000,0000,0000,,لنرجع لموضوع الشفرة
Dialogue: 0,0:06:40.60,0:06:45.69,Default,,0000,0000,0000,,اسمع، ما رأيك بالقدوم لأوساكا؟\N!سأدعوك لأكل أودون لذيذ قدرما تشاء
Dialogue: 0,0:06:45.69,0:06:48.52,Default,,0000,0000,0000,,لا أستطيع تحمّل نكهة طوكيو الثقيلة
Dialogue: 0,0:06:49.02,0:06:50.02,Default,,0000,0000,0000,,سأقفل الخطّ
Dialogue: 0,0:06:50.02,0:06:51.90,Default,,0000,0000,0000,,آسف! آسف! نرجع للشفرة، صحيح؟
Dialogue: 0,0:06:52.90,0:06:55.23,Default,,0000,0000,0000,,تمكّنتُ من فكّ شفرة السطر الأوّل
Dialogue: 0,0:06:55.23,0:07:00.73,Default,,0000,0000,0000,,لكن "نصفان في القمّة" لا توافق بقيّة الأسطر
Dialogue: 0,0:07:00.73,0:07:02.49,Default,,0000,0000,0000,,...بترتيبها، ستحصل على
Dialogue: 0,0:07:02.81,0:07:12.42,Default,,0000,0000,0000,,واتاشي هوكا كا إي هي إيما إي"\N"هاكو ري نو توكورو هان هيتو وا
Dialogue: 0,0:07:12.77,0:07:17.42,Default,,0000,0000,0000,,"حتّى لو أزلت "هوكا" الثانية، تبقى "واتاشي\Nوحدها مفهومة القراءة
Dialogue: 0,0:07:17.42,0:07:21.34,Default,,0000,0000,0000,,"ولم أستطع تشكيل كلمة بـ "هي" و"إما\Nمهما حاولت من مرّات
Dialogue: 0,0:07:21.60,0:07:26.52,Default,,0000,0000,0000,,يبدو أنّه لا تزال تنقصنا قطع\Nلحلّ هذه الشفرة
Dialogue: 0,0:07:26.52,0:07:32.31,Default,,0000,0000,0000,,أجل، لا بدّ من وجود قطعة مهمّة\Nمتوارية في مكان عن أنظارنا
Dialogue: 0,0:07:35.52,0:07:36.73,Default,,0000,0000,0000,,هاتّوري؟ ما الخطب؟
Dialogue: 0,0:07:36.73,0:07:38.98,Default,,0000,0000,0000,,حماقة
Dialogue: 0,0:07:38.98,0:07:43.99,Default,,0000,0000,0000,,إذا كنتَ هناك، فلمَ أكبّد نفسي عناء \Nالتفكير من مكاني البعيد؟
Dialogue: 0,0:07:44.90,0:07:47.06,Default,,0000,0000,0000,,لذا أترك الباقي لك يا كودو
Dialogue: 0,0:07:47.06,0:07:50.40,Default,,0000,0000,0000,,!اتّصل بي إذا وجدتَ شيئاً، بالتوفيق
Dialogue: 0,0:07:50.40,0:07:52.63,Default,,0000,0000,0000,,!أ-أنت! انتظر
Dialogue: 0,0:07:52.63,0:07:56.09,Default,,0000,0000,0000,,!صحيح! لا بدّ أنّ هاتّوري-كن يعرف بقيّة الشفرة
Dialogue: 0,0:07:56.09,0:07:57.09,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:08:01.56,0:08:04.51,Default,,0000,0000,0000,,...لم يكن أنا! كان هاتّوري-نيتشان من أقفل
Dialogue: 0,0:08:07.44,0:08:09.43,Default,,0000,0000,0000,,حضرة المفتّش، هذه طوكيو
Dialogue: 0,0:08:10.77,0:08:14.90,Default,,0000,0000,0000,,!لنترك شاب أوساكا ذاك ونحلّ القضيّة بأنفسنا
Dialogue: 0,0:08:15.06,0:08:17.40,Default,,0000,0000,0000,,!معك حقّ
Dialogue: 0,0:08:17.40,0:08:19.61,Default,,0000,0000,0000,,إذاً، أبدأ النعاس يراودك؟
Dialogue: 0,0:08:19.90,0:08:22.82,Default,,0000,0000,0000,,ماذا؟ كيف يراودني النعاس؟
Dialogue: 0,0:08:23.23,0:08:27.48,Default,,0000,0000,0000,,أقصد عندما تصدر أصوات\Nفونيا" و"هوهي" تلك"
Dialogue: 0,0:08:27.48,0:08:29.45,Default,,0000,0000,0000,,...كلا، ليس بعد
Dialogue: 0,0:08:29.90,0:08:32.37,Default,,0000,0000,0000,,هكذا إذاً، هذا مؤسف
Dialogue: 0,0:08:33.06,0:08:36.56,Default,,0000,0000,0000,,!النجدة! النجدة
Dialogue: 0,0:08:36.56,0:08:38.60,Default,,0000,0000,0000,,!النجدة
Dialogue: 0,0:08:38.60,0:08:41.34,Default,,0000,0000,0000,,...أبي... أمّي
Dialogue: 0,0:08:41.85,0:08:47.06,Default,,0000,0000,0000,,لا تقلقي، أنا متأكّدة أنّنا\Nسنجد أباك وأمّك
Dialogue: 0,0:08:47.06,0:08:48.26,Default,,0000,0000,0000,,لا تستسلمي
Dialogue: 0,0:08:49.15,0:08:51.44,Default,,0000,0000,0000,,لذا علينا التفكير بدورنا
Dialogue: 0,0:08:51.44,0:08:52.23,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:53.01,0:08:58.32,Default,,0000,0000,0000,,تبّاً، لا يتشكّل أيّ معنى من إضافة\Nوإزالة الأحرف المجاورة
Dialogue: 0,0:08:58.32,0:09:00.73,Default,,0000,0000,0000,,ما هذه الشفرة؟
Dialogue: 0,0:09:00.73,0:09:04.74,Default,,0000,0000,0000,,كما ما أجهله هو هويّة الفاعل الذي اختطفه
Dialogue: 0,0:09:05.44,0:09:09.20,Default,,0000,0000,0000,,من البديهيات أن تنتبه لكتابات أسيرك
Dialogue: 0,0:09:09.70,0:09:11.35,Default,,0000,0000,0000,,،إذا كان الفاعل أحد معجبيه
Dialogue: 0,0:09:11.35,0:09:16.08,Default,,0000,0000,0000,,فلا بدّ أن تثير رسالة الإهداء وظهور\Nالمؤلّف في العمل ريبته
Dialogue: 0,0:09:17.35,0:09:21.40,Default,,0000,0000,0000,,"يُفترض أنّه حلّ شفرة "النجدة\Nالأولى منذ فترة على الأقل
Dialogue: 0,0:09:22.73,0:09:24.90,Default,,0000,0000,0000,,في تلك الحالة، سيكون هدفه\Nهو أجر النصوص
Dialogue: 0,0:09:24.90,0:09:27.48,Default,,0000,0000,0000,,كلا، لا يمكن ذلك
Dialogue: 0,0:09:27.48,0:09:31.31,Default,,0000,0000,0000,,لن تحتجز أسيراً لشهرين كاملين مقابل ذلك
Dialogue: 0,0:09:31.31,0:09:36.65,Default,,0000,0000,0000,,!لا أستطيع فهم هدف الفاعل، أو الشفرة البتّة
Dialogue: 0,0:09:37.44,0:09:38.35,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:09:38.35,0:09:41.11,Default,,0000,0000,0000,,!هذا خطأ
Dialogue: 0,0:09:42.15,0:09:46.85,Default,,0000,0000,0000,,،لا بأس باستعمال اللغة الفرنسية للتأنّق\Nلكن لا تخطئ في التهجئة
Dialogue: 0,0:09:46.85,0:09:47.57,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:09:47.98,0:09:49.45,Default,,0000,0000,0000,,اللغة الفرنسيّة؟
Dialogue: 0,0:09:49.58,0:09:55.87,Default,,0000,0000,0000,,،"تهجئة "هيومر" هي "إتش يو إم أو يو آر\N"تنقصك الـ "إتش
Dialogue: 0,0:09:56.90,0:10:01.46,Default,,0000,0000,0000,,رغم أنّها لا تُنطق هكذا، فأتفهّم الخطأ
Dialogue: 0,0:10:04.73,0:10:06.04,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:10:06.64,0:10:08.18,Default,,0000,0000,0000,,!هكذا كان الأمر
Dialogue: 0,0:10:11.90,0:10:14.23,Default,,0000,0000,0000,,...في تلك الحالة، الشفرة
Dialogue: 0,0:10:14.23,0:10:16.44,Default,,0000,0000,0000,,!أستطيع قراءتها! أستطيع
Dialogue: 0,0:10:16.44,0:10:19.40,Default,,0000,0000,0000,,!قراءة كلّ حرف
Dialogue: 0,0:10:19.69,0:10:25.32,Default,,0000,0000,0000,,ذاك هو! لا بدّ أنّ المكان الذي يُحتجز\N!فيه شينمي سينسي هو هناك
Dialogue: 0,0:10:26.02,0:10:26.98,Default,,0000,0000,0000,,حضرة لمفتّش
Dialogue: 0,0:10:26.98,0:10:31.03,Default,,0000,0000,0000,,لدى شينمي سينسي حوار في الفصل\Nالثامن الذي وصلنا للتوّ
Dialogue: 0,0:10:31.35,0:10:32.33,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:32.33,0:10:35.19,Default,,0000,0000,0000,,هذا هو المشهد
Dialogue: 0,0:10:41.19,0:10:43.25,Default,,0000,0000,0000,,!كلا! الوقت ينفد
Dialogue: 0,0:10:43.60,0:10:48.18,Default,,0000,0000,0000,,...علينا... علينا الإسراع وإلّا سيلقى شينمي سينسي وزوجته
Dialogue: 0,0:10:48.69,0:10:51.39,Default,,0000,0000,0000,,...حسناً، سأقوم بالمعتاد في تلك الحالة
Dialogue: 0,0:10:51.81,0:10:55.43,Default,,0000,0000,0000,,وأستعمل مسدّس تخدير الساعة لتنويم العمّ
Dialogue: 0,0:10:55.73,0:11:00.15,Default,,0000,0000,0000,,...موري-سان، دعني أعرّفك، هذا رئيس دائرة التحرير
Dialogue: 0,0:11:04.69,0:11:06.65,Default,,0000,0000,0000,,!أ-أخطأت
Dialogue: 0,0:11:11.57,0:11:15.33,Default,,0000,0000,0000,,!كلا! لا خيار أمامي هكذا
Dialogue: 0,0:11:15.74,0:11:18.25,Default,,0000,0000,0000,,رئيس! رئيس! ما الخطب؟
Dialogue: 0,0:11:20.94,0:11:24.13,Default,,0000,0000,0000,,عليّ جعله يلعب دور المتحرّي
Dialogue: 0,0:11:24.13,0:11:28.31,Default,,0000,0000,0000,,حسناً، سأضبط ربطة العنق المبدّلة\N...للصوت لتوافق صوته
Dialogue: 0,0:11:28.31,0:11:29.98,Default,,0000,0000,0000,,...لتوافق
Dialogue: 0,0:11:29.98,0:11:33.15,Default,,0000,0000,0000,,!لحظة! لا أعرف صوته حتّى
Dialogue: 0,0:11:33.15,0:11:35.01,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:11:35.56,0:11:37.48,Default,,0000,0000,0000,,ما الذي تفعله عندك؟
Dialogue: 0,0:11:39.37,0:11:41.44,Default,,0000,0000,0000,,ألعب لعبة الاختباء
Dialogue: 0,0:11:43.73,0:11:47.44,Default,,0000,0000,0000,,!هذا سيّئ! تبقّت إبرة تخدير واحدة
Dialogue: 0,0:11:47.94,0:11:51.67,Default,,0000,0000,0000,,عليّ انتظار أن يحلّ العمّ\Nوالبقيّة الشفرة هكذا
Dialogue: 0,0:11:51.67,0:11:52.57,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:11:54.85,0:11:57.16,Default,,0000,0000,0000,,...إذا لم نسرع، شينمي سينسي سوف
Dialogue: 0,0:11:58.25,0:12:02.46,Default,,0000,0000,0000,,!ما الخطب؟ استيقظ رجاءً يا رئيس! رئيس
Dialogue: 0,0:12:03.06,0:12:07.06,Default,,0000,0000,0000,,إنّه يشخر، كما لو كان كوغورو النائم
Dialogue: 0,0:12:07.06,0:12:07.92,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:10.98,0:12:12.98,Default,,0000,0000,0000,,ما الذي يضحكك؟
Dialogue: 0,0:12:12.98,0:12:16.85,Default,,0000,0000,0000,,!يقلّدك رئيس التحرير عند نومك
Dialogue: 0,0:12:17.93,0:12:19.81,Default,,0000,0000,0000,,(خطر لي أنّه شخص طريف (هيومر
Dialogue: 0,0:12:20.40,0:12:25.77,Default,,0000,0000,0000,,هيومر؟ تعرف كلمات غريبة\Nبالنسبة لصبيّ كالعادة
Dialogue: 0,0:12:26.56,0:12:29.74,Default,,0000,0000,0000,,لكن قالها هذان الرجلان قبل قليل
Dialogue: 0,0:12:30.32,0:12:33.48,Default,,0000,0000,0000,,ذكرا شيئاً عن "هيومر"، أليس كذلك؟
Dialogue: 0,0:12:33.48,0:12:34.20,Default,,0000,0000,0000,,...بلى
Dialogue: 0,0:12:34.85,0:12:40.19,Default,,0000,0000,0000,,أخطأ في تهجئة كلمة فرنسية، فأصلحتها له
Dialogue: 0,0:12:40.19,0:12:42.37,Default,,0000,0000,0000,,"نسيتُ إضافة "إتش
Dialogue: 0,0:12:43.31,0:12:44.33,Default,,0000,0000,0000,,سخافة
Dialogue: 0,0:12:45.02,0:12:47.73,Default,,0000,0000,0000,,لكنّ أهل فرنسا غريبون حقّاً
Dialogue: 0,0:12:47.97,0:12:51.30,Default,,0000,0000,0000,,لا يقرؤون "إتش" في بداية الكلمات
Dialogue: 0,0:12:51.69,0:12:55.26,Default,,0000,0000,0000,,إذا لن يقرؤوها، فعليهم إزالتها من البداية
Dialogue: 0,0:12:55.52,0:12:57.72,Default,,0000,0000,0000,,...إ-إزالتها
Dialogue: 0,0:12:58.07,0:12:59.18,Default,,0000,0000,0000,,من البداية؟
Dialogue: 0,0:13:00.26,0:13:04.85,Default,,0000,0000,0000,,بالمناسبة، تعيش شخصيّة شينمي سينسي الظاهرة\Nفي الراوية في فرنسا، أليس كذلك؟
Dialogue: 0,0:13:04.85,0:13:05.90,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:13:06.35,0:13:09.35,Default,,0000,0000,0000,,...موري-كن، أيمكن أنّ هذا
Dialogue: 0,0:13:09.64,0:13:13.35,Default,,0000,0000,0000,,أجل، لعلّ الكلمة المفتاحية\Nالأخرى لهذه الشفرة
Dialogue: 0,0:13:13.35,0:13:17.83,Default,,0000,0000,0000,,هي خاصيّة اللغة الفرنسيّة بعدم\Nنطق حرف "إتش" في بداية الكلمات
Dialogue: 0,0:13:18.31,0:13:19.62,Default,,0000,0000,0000,,إتش" الصامتة"
Dialogue: 0,0:13:20.19,0:13:23.08,Default,,0000,0000,0000,,"الكلمات التي تبدأ بـ "إتش
Dialogue: 0,0:13:23.52,0:13:29.84,Default,,0000,0000,0000,,أي ربما علينا إزالة الكلمات في مجموعة\N"ها-هِي-هو-هْي"
Dialogue: 0,0:13:30.23,0:13:31.56,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:13:31.56,0:13:38.65,Default,,0000,0000,0000,,إذا يُفترض بنا إزالة أحرف مجموعة الهاء\N"المتشكّلة من "نصفان في القمّة
Dialogue: 0,0:13:39.09,0:13:41.77,Default,,0000,0000,0000,,فسيكون من المنطقيّ إزالة\Nهوكا" من الجزء الأوّل"
Dialogue: 0,0:13:42.56,0:13:50.73,Default,,0000,0000,0000,,باعتماد قاعدتَي "نصفان في القمّة" و"إتش" الصامتة\N...لحلّ شفرة مشهد السيّد شينمي الثاني
Dialogue: 0,0:13:51.45,0:13:53.49,Default,,0000,0000,0000,,،"واتاشي" و"هوكا" تصبح "واتاشي"
Dialogue: 0,0:13:53.49,0:13:55.03,Default,,0000,0000,0000,,،"إي" و"كا" تصبح "غا"
Dialogue: 0,0:13:55.03,0:13:56.74,Default,,0000,0000,0000,,،"هي" و"إيما" تصبح "إيما"
Dialogue: 0,0:13:56.74,0:13:58.49,Default,,0000,0000,0000,,"إي" و"هاكو" تصبح "إي"
Dialogue: 0,0:13:58.49,0:14:00.11,Default,,0000,0000,0000,,"ري" و"نو" تصبح "رو"
Dialogue: 0,0:14:00.11,0:14:02.15,Default,,0000,0000,0000,,"توكورو" و"هان" تصبح "توكورو"
Dialogue: 0,0:14:02.15,0:14:04.00,Default,,0000,0000,0000,,"هيتو" و"وا" تصبح "وا"
Dialogue: 0,0:14:04.40,0:14:12.32,Default,,0000,0000,0000,,بترتيبها، تصبح "واتاشي غا إيما\N"إي رو توكورو وا
Dialogue: 0,0:14:12.32,0:14:14.93,Default,,0000,0000,0000,,!"المكان الذي أنا فيه الآن"
Dialogue: 0,0:14:15.32,0:14:17.27,Default,,0000,0000,0000,,!مذهل، أصبحت جملة
Dialogue: 0,0:14:17.99,0:14:22.98,Default,,0000,0000,0000,,"فهمت، استعمل "وا" بدل "ها\Nبسبب قاعدة الهاء
Dialogue: 0,0:14:23.49,0:14:29.20,Default,,0000,0000,0000,,حسنٌ، إذا حللنا شفرة حوار المشهد\N...الثالث للسيّد شينمي بهذا النحو
Dialogue: 0,0:14:29.82,0:14:35.54,Default,,0000,0000,0000,,"كي تو شي تي إي هو تي رو"
Dialogue: 0,0:14:36.20,0:14:40.49,Default,,0000,0000,0000,,فندق مدينة كيدو! أيّ فندق هذا؟\Nلم أسمع به قبلاً
Dialogue: 0,0:14:40.49,0:14:44.00,Default,,0000,0000,0000,,لعلّه يستعمل نظام تمثيل هيبورن بالأحرف اللاتينيّة
Dialogue: 0,0:14:44.61,0:14:50.03,Default,,0000,0000,0000,,"في تلك الحالة، لا تكون "فوا \N"إتش يو"، بل "إف يو"
Dialogue: 0,0:14:50.03,0:14:53.93,Default,,0000,0000,0000,,"أي لا تزيل "فوا" الأولى، "وفو" و"موكو" يعطيانك "هاي
Dialogue: 0,0:14:54.53,0:14:57.39,Default,,0000,0000,0000,,!فـ-فندق مدينة هايدو؟
Dialogue: 0,0:14:58.11,0:15:01.60,Default,,0000,0000,0000,,مما يعني أنّ الجملة الرابعة تحمل\Nرقم الغرفة غالباً
Dialogue: 0,0:15:02.28,0:15:03.70,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:15:03.70,0:15:10.57,Default,,0000,0000,0000,,"اثنان أربعة صفر سبعة غو شيتسو"
Dialogue: 0,0:15:10.87,0:15:13.03,Default,,0000,0000,0000,,!غرفة 2407
Dialogue: 0,0:15:13.74,0:15:17.95,Default,,0000,0000,0000,,حسناً! توجّهوا مباشرةً للغرفة 2407\N!في فندق مدينة هايدو
Dialogue: 0,0:15:17.95,0:15:18.41,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:15:18.78,0:15:19.75,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:15:19.75,0:15:21.57,Default,,0000,0000,0000,,ما الخطب يا تاكاغي-كن؟
Dialogue: 0,0:15:21.57,0:15:24.42,Default,,0000,0000,0000,,انظر لهذا النصّ رجاءً، لا تزال هنالك تتمة
Dialogue: 0,0:15:26.28,0:15:30.38,Default,,0000,0000,0000,,هذا الفصل الثامن الذي وصل قبل قليل
Dialogue: 0,0:15:30.86,0:15:32.53,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:15:32.53,0:15:34.09,Default,,0000,0000,0000,,(هاياكو..." (أسرعوا"
Dialogue: 0,0:15:34.86,0:15:40.89,Default,,0000,0000,0000,,(جي كان غا ناي" (الوقت ينفد"
Dialogue: 0,0:15:41.20,0:15:43.67,Default,,0000,0000,0000,,"أسرعوا، الوقت ينفد"
Dialogue: 0,0:15:51.65,0:15:53.45,Default,,0000,0000,0000,,!أنتم! أسرعوا
Dialogue: 0,0:16:02.74,0:16:06.53,Default,,0000,0000,0000,,فندق مدينة هايدو، اتبع سيّارات الشرطة تلك
Dialogue: 0,0:16:06.53,0:16:07.05,Default,,0000,0000,0000,,!أسرع
Dialogue: 0,0:16:07.05,0:16:08.03,Default,,0000,0000,0000,,!حـ-حاضر
Dialogue: 0,0:16:12.61,0:16:15.32,Default,,0000,0000,0000,,...أبي... أمّي
Dialogue: 0,0:16:15.32,0:16:19.57,Default,,0000,0000,0000,,!أبي... أمّي... عسى أن تكونا بخير
Dialogue: 0,0:16:19.57,0:16:21.35,Default,,0000,0000,0000,,إنّهما على قيد الحياة
Dialogue: 0,0:16:22.32,0:16:24.86,Default,,0000,0000,0000,,"يمكن أن تعني "الوقت ينفد
Dialogue: 0,0:16:24.86,0:16:27.69,Default,,0000,0000,0000,,أنّ الخطر يقترب، لكن الأوان لم يفت
Dialogue: 0,0:16:28.36,0:16:33.41,Default,,0000,0000,0000,,بالكاد مضت ساعة مُذ وصل ذاك النصّ بالفاكس
Dialogue: 0,0:16:33.41,0:16:35.76,Default,,0000,0000,0000,,ولا تزال الرواية في منتصفها
Dialogue: 0,0:16:35.89,0:16:37.98,Default,,0000,0000,0000,,احتمال كونهما على قيد الحياة مرتفع
Dialogue: 0,0:16:38.60,0:16:39.40,Default,,0000,0000,0000,,أليس كذلك؟
Dialogue: 0,0:16:45.47,0:16:48.86,Default,,0000,0000,0000,,لكن لا أفهم هدف الفاعل
Dialogue: 0,0:16:50.10,0:16:55.51,Default,,0000,0000,0000,,أهي فعلة معجب مجنون أراد عملاً جديداً \Nلسلسلة المتحرّي شيمونجي بشدّة؟
Dialogue: 0,0:16:55.51,0:16:56.74,Default,,0000,0000,0000,,كلا، ليس ذلك
Dialogue: 0,0:16:57.43,0:16:59.75,Default,,0000,0000,0000,,أكان اختطافاً لسرقة أجر نصوص روائيّ شهير؟
Dialogue: 0,0:17:00.30,0:17:05.39,Default,,0000,0000,0000,,كلا، الغرفة 2407 في هذا الفندق\Nهي جناح، لا توافق المبدأ
Dialogue: 0,0:17:05.39,0:17:08.38,Default,,0000,0000,0000,,ما هدف الفاعل بالضبط إذاً؟
Dialogue: 0,0:17:10.93,0:17:14.72,Default,,0000,0000,0000,,ما خطّته بإجبار شينمشي سينسي على كتابة الرواية
Dialogue: 0,0:17:14.72,0:17:16.97,Default,,0000,0000,0000,,بينما لم يعد قادراً على التوقيع حتّى؟
Dialogue: 0,0:17:17.68,0:17:20.73,Default,,0000,0000,0000,,...انتظر، إذا لم يستطع التوقيع
Dialogue: 0,0:17:21.60,0:17:25.36,Default,,0000,0000,0000,,فهذا يعني أنّه ينقل الكلمات\Nشفوياً لأحدهم ويجعله يكتب مكانه
Dialogue: 0,0:17:25.72,0:17:28.36,Default,,0000,0000,0000,,هذا يعني أنّه ترك شخصاً آخر يكتب النصّ
Dialogue: 0,0:17:28.72,0:17:32.49,Default,,0000,0000,0000,,حيث الإخلال برمز واحد قد يفسد الشفرة؟
Dialogue: 0,0:17:33.89,0:17:35.51,Default,,0000,0000,0000,,هذا محال
Dialogue: 0,0:17:35.51,0:17:40.53,Default,,0000,0000,0000,,إضافة الرموز وإزالتها بلا معنى\Nسيثير شبهة أيّ أحد
Dialogue: 0,0:17:42.05,0:17:46.58,Default,,0000,0000,0000,,حتّى لو جعل زوجته تكتب، سيلاحظ الشخص الذي يراقبها
Dialogue: 0,0:17:50.97,0:17:52.86,Default,,0000,0000,0000,,...انتظر
Dialogue: 0,0:17:52.86,0:17:55.65,Default,,0000,0000,0000,,...انتظر، أيمكن أنّ هذه القضيّة
Dialogue: 0,0:18:03.97,0:18:06.31,Default,,0000,0000,0000,,...الغرفة 2407
Dialogue: 0,0:18:06.41,0:18:08.52,Default,,0000,0000,0000,,حسناً، هذه هي بلا شكّ
Dialogue: 0,0:18:09.05,0:18:13.74,Default,,0000,0000,0000,,!هنالك احتمال بامتلاك الفاعل لأسلحة، كونوا يقظين جميعاً
Dialogue: 0,0:18:25.79,0:18:27.82,Default,,0000,0000,0000,,المعذرة، أهنالك أمرٌ ما؟
Dialogue: 0,0:18:28.41,0:18:29.83,Default,,0000,0000,0000,,!أمّي
Dialogue: 0,0:18:29.83,0:18:31.78,Default,,0000,0000,0000,,كاوري! لمَ أنتِ هنا؟
Dialogue: 0,0:18:32.29,0:18:34.02,Default,,0000,0000,0000,,!تراجعي يا سيّدة
Dialogue: 0,0:18:35.62,0:18:37.62,Default,,0000,0000,0000,,!لا تتحرّك! نحن الشرطة
Dialogue: 0,0:18:48.66,0:18:51.34,Default,,0000,0000,0000,,!أبي! أبي
Dialogue: 0,0:18:53.54,0:18:55.26,Default,,0000,0000,0000,,!أبي! أبي
Dialogue: 0,0:18:55.91,0:18:59.77,Default,,0000,0000,0000,,لفظ والدك أنفاسه الأخيرة قبل لحظات
Dialogue: 0,0:19:00.50,0:19:01.58,Default,,0000,0000,0000,,كاوري-سان
Dialogue: 0,0:19:01.58,0:19:06.19,Default,,0000,0000,0000,,اتّصلت بمنزلك عدّة مرّات، لكن لم يرد أحد
Dialogue: 0,0:19:10.75,0:19:14.12,Default,,0000,0000,0000,,أنت الفاعل الذي اختطف\Nالسيّد شينمي إذاً؟
Dialogue: 0,0:19:14.12,0:19:15.74,Default,,0000,0000,0000,,...كـ-كلا، أنا
Dialogue: 0,0:19:16.08,0:19:19.45,Default,,0000,0000,0000,,إنّه طبيب زوجي الشخصيّ
Dialogue: 0,0:19:20.66,0:19:22.41,Default,,0000,0000,0000,,أين المختطف إذاً؟
Dialogue: 0,0:19:22.95,0:19:26.13,Default,,0000,0000,0000,,...لا مختطف هناك، وإذا كان موجوداً
Dialogue: 0,0:19:26.50,0:19:30.34,Default,,0000,0000,0000,,فسيكون شينمي نفسه المستلقي هناك
Dialogue: 0,0:19:30.70,0:19:32.79,Default,,0000,0000,0000,,...أكانت تلك الشفرة إذاً
Dialogue: 0,0:19:32.79,0:19:33.68,Default,,0000,0000,0000,,أيمكن؟
Dialogue: 0,0:19:34.04,0:19:37.64,Default,,0000,0000,0000,,كلّها تلفيق من صنع زوجي
Dialogue: 0,0:19:38.00,0:19:40.60,Default,,0000,0000,0000,,لـ-لكن لمَ؟
Dialogue: 0,0:19:41.66,0:19:44.67,Default,,0000,0000,0000,,...كان يردد دوماً
Dialogue: 0,0:19:45.33,0:19:52.79,Default,,0000,0000,0000,,أشعر بالسعادة عندما أتلقّى\N،إطراءً على عملي بالطبع
Dialogue: 0,0:19:52.79,0:19:58.33,Default,,0000,0000,0000,,لكن هنالك سعادة لم أختبرها بعد\Nفي أعوام تأليفي الأربعين
Dialogue: 0,0:19:58.33,0:20:01.79,Default,,0000,0000,0000,,أريد رؤيتها عياناً ولو لمرّة واحدة
Dialogue: 0,0:20:02.58,0:20:09.48,Default,,0000,0000,0000,,وجه القارئ المشعّ فخراً الذي يحلّ اللغز\Nقبل أن أقدّم الحلّ
Dialogue: 0,0:20:10.45,0:20:15.01,Default,,0000,0000,0000,,قال أنّه يريد تحقيق\Nتلك الأمنية قبل موته
Dialogue: 0,0:20:15.54,0:20:21.41,Default,,0000,0000,0000,,لذا ساعدتُه مع الطبيب في الكتابة هنا
Dialogue: 0,0:20:21.41,0:20:22.98,Default,,0000,0000,0000,,قبل موته؟
Dialogue: 0,0:20:23.54,0:20:28.54,Default,,0000,0000,0000,,فقد القدرة على تحريك ذراعيه\Nقبل أسبوعين بسبب سرطان الأطراف
Dialogue: 0,0:20:28.54,0:20:31.90,Default,,0000,0000,0000,,لذا كان التوقيع على النصّ منسوخاً؟
Dialogue: 0,0:20:32.66,0:20:35.61,Default,,0000,0000,0000,,آسفة على ترككِ تقلقين يا كاوري
Dialogue: 0,0:20:36.33,0:20:42.54,Default,,0000,0000,0000,,أمرني والدك بألّا أخبرك لإعطاء\Nشفرته واقعيّةً أكبر
Dialogue: 0,0:20:43.22,0:20:49.55,Default,,0000,0000,0000,,اعتبريها آخر رغباته الأنانيّة، وسامحيه يا كاوري
Dialogue: 0,0:22:25.90,0:22:29.32,Default,,0000,0000,0000,,كانت حادثةً فارغة مثيرة للجلبة بحقّ
Dialogue: 0,0:22:29.92,0:22:35.80,Default,,0000,0000,0000,,يُفترض أنّه عرف أنّ كتابة شفرة كتلك\Nستستدعي تدخل الشرطة
Dialogue: 0,0:22:35.80,0:22:40.84,Default,,0000,0000,0000,,لكنّه كتب في ختام رواياته دوماً
Dialogue: 0,0:22:40.84,0:22:44.58,Default,,0000,0000,0000,,أنّه يريد رؤية وجه القارئ المشعّ فخراً
Dialogue: 0,0:22:44.88,0:22:48.84,Default,,0000,0000,0000,,فلعلّه كان بانتظار قدوم قارئ \Nاكتشف كلّ شيء
Dialogue: 0,0:22:48.84,0:22:51.30,Default,,0000,0000,0000,,"ويأتيه ليقول "حللتُها يا سينسي
Dialogue: 0,0:22:51.67,0:22:55.30,Default,,0000,0000,0000,,لكن لم يأت أحد في النهاية
Dialogue: 0,0:22:55.68,0:23:00.22,Default,,0000,0000,0000,,وستبقى الرواية بلا نهاية\Nبعدما رحل الآن
Dialogue: 0,0:23:00.80,0:23:02.18,Default,,0000,0000,0000,,لن أسمح بذلك
Dialogue: 0,0:23:03.21,0:23:05.52,Default,,0000,0000,0000,,سأكتب تتمتها
Dialogue: 0,0:23:05.92,0:23:08.52,Default,,0000,0000,0000,,سأحرص على ألّا يتدنّس اسم شينمي نينتارو
Dialogue: 0,0:23:14.63,0:23:17.16,Default,,0000,0000,0000,,،شهران بعد الحادثة
Dialogue: 0,0:23:17.49,0:23:21.49,Default,,0000,0000,0000,,أتمّت كاوري-سان رواية أبيها ببراعة
Dialogue: 0,0:23:21.93,0:23:26.46,Default,,0000,0000,0000,,"وأصبح مجلّد "نصفان في القمّة\Nمن الروايات الأعلى مبيعاً
Dialogue: 0,0:23:27.29,0:23:31.80,Default,,0000,0000,0000,,اُقتبست منها دراما تلفزيّة بالطبع، ولقت الاستحسان
Dialogue: 0,0:23:31.80,0:23:35.84,Default,,0000,0000,0000,,مما فتح لها باب عالم الكتابة
Dialogue: 0,0:23:36.13,0:23:41.01,Default,,0000,0000,0000,,،رغم أنّ لارتقاء موهبتها على موهبة أبيها تأثير
Dialogue: 0,0:23:41.46,0:23:46.46,Default,,0000,0000,0000,,إلّا أنّ ما لفت الانتباه كانوا مساعدي سامونجي\Nالذين أضيفوا في النصف الثاني للقصّة
Dialogue: 0,0:23:46.60,0:23:52.40,Default,,0000,0000,0000,,المتحرّي الفاشل والفتاة الصبيانيّة" \N"والصغير المتبجّح ذو النظّارات
Dialogue: 0,0:23:53.13,0:23:55.73,Default,,0000,0000,0000,,...لن أقول ممن اُستوحوا
Dialogue: 0,0:23:56.25,0:23:59.20,Default,,0000,0000,0000,,"لكن لم تكن هنالك حاجة لتضيف "المتبجّح
Dialogue: 0,0:24:02.37,0:24:04.40,Default,,0000,0000,0000,,...أنا مجرّد زائرة عاديّة من طوكيو
Dialogue: 0,0:24:08.24,0:24:09.35,Default,,0000,0000,0000,,!آسفان
Dialogue: 0,0:24:10.42,0:24:13.81,Default,,0000,0000,0000,,يراودني شعورٌ سيّئ بتلاعب القاتل بنا
Dialogue: 0,0:24:15.04,0:24:16.06,Default,,0000,0000,0000,,شعور سيّئ؟
Dialogue: 0,0:24:18.61,0:24:19.86,Default,,0000,0000,0000,,!كودو
Dialogue: 0,0:24:25.49,0:24:31.49,On Top,,0000,0000,0000,,قضيّة جرائم قتل نانيوا التسلسلية
Dialogue: 0,0:24:26.41,0:24:28.37,Default,,0000,0000,0000,,في الحلقة القادمة الخاصّة من كونان
Dialogue: 0,0:24:28.37,0:24:30.97,Default,,0000,0000,0000,,قضيّة جرائم قتل نانيوا التسلسلية
Dialogue: 0,0:24:46.97,0:24:50.08,Default,,0000,0000,0000,,تلميح الحلقة القادمة الخاصّة من كونان
Dialogue: 0,0:24:50.08,0:24:51.51,Default,,0000,0000,0000,,مرآة خلفيّة
Dialogue: 0,0:24:51.51,0:24:53.51,Default,,0000,0000,0000,,الحلقة القادمة حلقة خاصّة \Nمن ساعة كاملة
Dialogue: 0,0:24:53.51,0:24:55.92,Default,,0000,0000,0000,,سيذهب كونان إلى أوساكا

