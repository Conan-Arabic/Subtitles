Dialogue: 0,0:00:00.69,0:00:02.03,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.03,0:00:04.83,Default,,0000,0000,0000,,أُجبر طالب الثانوية شينتشي على تجرّع\Nعقار قلّص جسده
Dialogue: 0,0:00:05.26,0:00:06.72,Default,,0000,0000,0000,,رغم صغر بنيتي، لا يزال عقلي كما هو
Dialogue: 0,0:00:06.72,0:00:08.59,Default,,0000,0000,0000,,!أحلّ قضايا تستعصي حتى على البالغين
Dialogue: 0,0:00:08.59,0:00:11.47,Default,,0000,0000,0000,,!نعتذر على التأخير! حلقة اليوم هي حلقة خاصة بساعة كاملة
Dialogue: 0,0:00:11.47,0:00:13.17,Default,,0000,0000,0000,,قضية جرائم قتل تسلسلية في جزيرة جنوبية
Dialogue: 0,0:00:13.17,0:00:15.37,Default,,0000,0000,0000,,!وحقيقة سوناتا البيانو الحزينة
Dialogue: 0,0:01:45.84,0:01:51.91,Title,,0000,0000,0000,,{\fad(300,0)}جرائم قتل سوناتا بيانو ضوء القمر
Dialogue: 0,0:01:47.03,0:01:50.16,Default,,0000,0000,0000,,جرائم قتل سوناتا بيانو ضوء القمر
Dialogue: 0,0:02:00.54,0:02:04.60,Default,,0000,0000,0000,,يا إلهي، لمَ على المتحري الشهير\Nموري كوغورو الذهاب لجزيرة سخيفة
Dialogue: 0,0:02:04.60,0:02:10.02,Default,,0000,0000,0000,,بينما يمكنه قضاء وقته في حفلة مشاهدة أزهار؟
Dialogue: 0,0:02:10.51,0:02:14.18,Default,,0000,0000,0000,,كلّ هذا بسبب الرسالة التي وصلتني قبل أسبوع
Dialogue: 0,0:02:14.18,0:02:15.71,Default,,0000,0000,0000,,،في ليلة البدر التالي
Dialogue: 0,0:02:15.71,0:02:18.67,Default,,0000,0000,0000,,ستبدأ الظلال بالاختفاء مُجدداً من جزيرة تسوكيكاغي
Dialogue: 0,0:02:18.67,0:02:21.46,Default,,0000,0000,0000,,تحرَّ. أسو كيجي
Dialogue: 0,0:02:23.12,0:02:24.99,Default,,0000,0000,0000,,أجل، وكالة موري للتحري
Dialogue: 0,0:02:24.99,0:02:27.45,Default,,0000,0000,0000,,تبقى يومان حتّى البدر التالي
Dialogue: 0,0:02:27.45,0:02:30.70,Default,,0000,0000,0000,,حوّلتُ نصف مليون لحسابك البنكي
Dialogue: 0,0:02:30.70,0:02:31.70,Default,,0000,0000,0000,,عليك أن تأتي
Dialogue: 0,0:02:31.70,0:02:34.57,Default,,0000,0000,0000,,!لـ-لحظة! من أنت؟
Dialogue: 0,0:02:34.57,0:02:38.65,Default,,0000,0000,0000,,أسو كيجي من جزيرة تسوكيكاغي
Dialogue: 0,0:02:38.65,0:02:41.57,Default,,0000,0000,0000,,!أنت! انتظر! أتسمعني؟ مرحباً؟
Dialogue: 0,0:02:41.57,0:02:44.73,Default,,0000,0000,0000,,يا إلهي، لم يهتم لقبولي طلبه من عدمه حتى
Dialogue: 0,0:02:45.14,0:02:46.39,Default,,0000,0000,0000,,أين المشكلة؟
Dialogue: 0,0:02:46.39,0:02:49.18,Default,,0000,0000,0000,,يمكننا الاسترخاء في جزيرة صغيرة قرب إيزو
Dialogue: 0,0:02:49.18,0:02:50.94,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:02:51.52,0:02:54.89,On Top,,0000,0000,0000,,جزيرة تسوكيكاغي
Dialogue: 0,0:02:55.34,0:02:57.86,Default,,0000,0000,0000,,...أسو كيجي
Dialogue: 0,0:02:58.13,0:03:00.76,Default,,0000,0000,0000,,لا أرى شخصاً بهذا الاسم هنا
Dialogue: 0,0:03:00.76,0:03:03.33,Default,,0000,0000,0000,,هلّا بحثت جيّداً؟
Dialogue: 0,0:03:03.33,0:03:05.52,Default,,0000,0000,0000,,فقد استلمتُ رسالةً منه
Dialogue: 0,0:03:05.95,0:03:08.95,Default,,0000,0000,0000,,لكنه ليس في لائحة السكان
Dialogue: 0,0:03:08.95,0:03:12.11,Default,,0000,0000,0000,,وأنا انتقلتُ لهذه الجزيرة مؤخراً، فلا أعرف الكثير
Dialogue: 0,0:03:12.11,0:03:13.49,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:03:13.49,0:03:18.86,Default,,0000,0000,0000,,رئيس، يبدو أنّ ساكناً هنا عيّن هؤلاء الأشخاص في عمل
Dialogue: 0,0:03:19.19,0:03:19.99,Default,,0000,0000,0000,,عيّن؟
Dialogue: 0,0:03:19.99,0:03:23.35,Default,,0000,0000,0000,,أجل، اسمه أسو كيجي
Dialogue: 0,0:03:23.35,0:03:27.35,Default,,0000,0000,0000,,!ماذا؟ أقلت أسو كيجي؟
Dialogue: 0,0:03:32.51,0:03:39.02,Default,,0000,0000,0000,,!ذلك مُحال! فهو ميت منذ أكثر من 10 سنوات
Dialogue: 0,0:03:44.91,0:03:50.16,Default,,0000,0000,0000,,كان عازف بيانو مشهور وُلد وترعرع في هذه الجزيرة
Dialogue: 0,0:03:51.16,0:03:53.31,Default,,0000,0000,0000,,وقعت الحادثة في ليلة بدر قبل 12 عاماً
Dialogue: 0,0:03:54.32,0:03:56.36,Default,,0000,0000,0000,,كانت أول مرة يعود لموطنه منذ وقت طويل
Dialogue: 0,0:03:56.36,0:04:00.15,Default,,0000,0000,0000,,فأقام حفلةً في مركز البلدة الاجتماعي
Dialogue: 0,0:04:00.15,0:04:03.93,Default,,0000,0000,0000,,لكن بعدها، أقفل على نفسه وعائلته في منزلهم فجأةً
Dialogue: 0,0:04:03.93,0:04:04.87,Default,,0000,0000,0000,,!وأحرق المكان
Dialogue: 0,0:04:06.35,0:04:09.69,Default,,0000,0000,0000,,قِيل أنّه طعن زوجته وابنته حتى الموت
Dialogue: 0,0:04:09.69,0:04:13.02,Default,,0000,0000,0000,,ثمّ واصل العزف بالبيانو وألسنة اللهب تحيطه
Dialogue: 0,0:04:13.55,0:04:16.27,Default,,0000,0000,0000,,كما لو كان هناك شيء يتلبسه
Dialogue: 0,0:04:16.80,0:04:21.43,Default,,0000,0000,0000,,"سوناتا البيانو لبيتهوفين... "ضوء القمر
Dialogue: 0,0:04:26.21,0:04:28.04,Default,,0000,0000,0000,,...رسالة من رجل ميت
Dialogue: 0,0:04:28.04,0:04:30.04,Default,,0000,0000,0000,,يا للمقلب الفظيع
Dialogue: 0,0:04:30.04,0:04:31.70,Default,,0000,0000,0000,,قد لا يكون كذلك
Dialogue: 0,0:04:31.70,0:04:36.90,Default,,0000,0000,0000,,فأجرك قد دُفع، كما أنّ الرسالة حملت\Nخاتم بريد هذه الجزيرة
Dialogue: 0,0:04:37.16,0:04:42.81,Default,,0000,0000,0000,,يريد أحد أهل الجزيرة منك التحري\Nفي أمر أسو كيجي حتماً
Dialogue: 0,0:04:43.25,0:04:44.22,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:04:44.44,0:04:48.56,Default,,0000,0000,0000,,كان العمدة هنا صديقاً مقرّباً منه
Dialogue: 0,0:04:48.56,0:04:50.65,Default,,0000,0000,0000,,فربما يمكنه إخبارنا بشيء
Dialogue: 0,0:04:50.65,0:04:51.80,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:04:51.80,0:04:55.27,Default,,0000,0000,0000,,قالوا أنّ العمدة في المركز الاجتماعي، أليس كذلك؟
Dialogue: 0,0:04:55.68,0:04:59.18,Default,,0000,0000,0000,,اسمع يا كينتا-كن، احرص على أن تنام بدفء
Dialogue: 0,0:04:59.18,0:05:00.89,Default,,0000,0000,0000,,!أجل، فهمت! إلى اللقاء
Dialogue: 0,0:05:00.89,0:05:01.79,Default,,0000,0000,0000,,مع السلامة
Dialogue: 0,0:05:02.92,0:05:04.44,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:05:04.83,0:05:06.75,Default,,0000,0000,0000,,أين المركز الاجتماعي؟
Dialogue: 0,0:05:06.75,0:05:11.57,Default,,0000,0000,0000,,أجل، اسلكوا ذاك المنعطف ثمّ واصلوا المشي
Dialogue: 0,0:05:11.82,0:05:14.32,Default,,0000,0000,0000,,لحظة، هل أنتم الجماعة من طوكيو؟
Dialogue: 0,0:05:14.32,0:05:15.98,Default,,0000,0000,0000,,أجل، وصلنا من السفينة للتو
Dialogue: 0,0:05:17.28,0:05:19.62,Default,,0000,0000,0000,,!أنا من طوكيو أيضاً
Dialogue: 0,0:05:19.62,0:05:22.69,Default,,0000,0000,0000,,لكن هذه الجزيرة أروع بكثير، ألا تتفقون؟
Dialogue: 0,0:05:22.69,0:05:26.02,Default,,0000,0000,0000,,!الهواء منعش، وهي هادئة جداً
Dialogue: 0,0:05:26.02,0:05:30.11,Default,,0000,0000,0000,,!احموا تجارة الصيد للجزيرة! صوّتوا لشيميزو ماساتو
Dialogue: 0,0:05:30.52,0:05:32.01,Default,,0000,0000,0000,,ربما ليس كثيراً
Dialogue: 0,0:05:32.01,0:05:34.35,Default,,0000,0000,0000,,فانتخابات العمدة تقترب
Dialogue: 0,0:05:34.35,0:05:36.31,Default,,0000,0000,0000,,انتخابات العمدة؟
Dialogue: 0,0:05:36.31,0:05:40.39,Default,,0000,0000,0000,,المرشّحون هم شيميزو-سان الذي يمثل صيّادي السمك
Dialogue: 0,0:05:40.39,0:05:44.21,Default,,0000,0000,0000,,والعمدة الحالي الذي يعاني انخفاضاً\Nفي شعبيته مؤخراً، كوريوا-سان
Dialogue: 0,0:05:44.21,0:05:47.27,Default,,0000,0000,0000,,كما كاواشيما-سان، أكثر رجال الجزيرة ثراءً
Dialogue: 0,0:05:47.96,0:05:50.23,Default,,0000,0000,0000,,...أخبرني مرضاي أنّ كاواشيما-سان غالباً مَن
Dialogue: 0,0:05:50.23,0:05:54.77,Default,,0000,0000,0000,,لا بأس يا ممرضة، لسنا مهتمين بالانتخابات حقاً
Dialogue: 0,0:05:54.99,0:05:57.83,Default,,0000,0000,0000,,{\a6}أنا الطبيبة أساي نارومي
Dialogue: 0,0:05:54.99,0:05:59.54,CharCard,,0000,0000,15,,{\fad(300,0)\pos(259.773,300)}{\a6}طبيبة\N(أساي نارومي    (26
Dialogue: 0,0:05:57.83,0:05:59.48,Default,,0000,0000,0000,,{\a6}!لديّ رخصة حقيقية
Dialogue: 0,0:05:59.80,0:06:02.15,Default,,0000,0000,0000,,كنتِ دكتورة إذاً
Dialogue: 0,0:06:02.15,0:06:04.32,Default,,0000,0000,0000,,إن كنتم متجهين للمركز الاجتماعي
Dialogue: 0,0:06:04.32,0:06:06.56,Default,,0000,0000,0000,,فيمكنكم لقاء أولئك الثلاثة هناك
Dialogue: 0,0:06:07.15,0:06:10.61,Default,,0000,0000,0000,,فستُعقد الليلة مناسبة ذكرى العام الثالث للعمدة السابق
Dialogue: 0,0:06:10.61,0:06:12.06,Default,,0000,0000,0000,,كامياما-سان
Dialogue: 0,0:06:12.06,0:06:14.43,Default,,0000,0000,0000,,العمدة السابق؟
Dialogue: 0,0:06:14.43,0:06:16.02,Default,,0000,0000,0000,,ذكرى العام الثالث؟
Dialogue: 0,0:06:16.02,0:06:17.98,Default,,0000,0000,0000,,!لا تدعوا العمدة يواصل حكم إرهابه
Dialogue: 0,0:06:18.60,0:06:21.51,Default,,0000,0000,0000,,!لا تدعوا العمدة يواصل حكم إرهابه
Dialogue: 0,0:06:21.51,0:06:23.23,Default,,0000,0000,0000,,يا إلهي
Dialogue: 0,0:06:23.84,0:06:27.94,Default,,0000,0000,0000,,{\a6}كيف يجرؤون على فعل هذا في\N!ليلة ذكرى العمدة السابق؟ يا لوقاحتهم
Dialogue: 0,0:06:23.84,0:06:27.94,CharCard,,0000,0000,0000,,{\fad(300,0)\pos(263.182,346.364)}عمدة جزيرة تسوكيكاغي\N(كوريوا تاتسوجي   (56
Dialogue: 0,0:06:28.25,0:06:31.30,Default,,0000,0000,0000,,{\a6}إنّهم مزعجون حقاً
Dialogue: 0,0:06:28.54,0:06:32.12,CharCard,,0000,0000,0010,,{\fad(300,0)}ابنة كوريوا الوحيدة\N(كوريوا ريكو   (27
Dialogue: 0,0:06:31.30,0:06:35.39,Default,,0000,0000,0000,,{\a6}!هيراتا! ما الذي تفعله؟\N!أغلق أفواههم فوراً
Dialogue: 0,0:06:35.83,0:06:37.27,Default,,0000,0000,0000,,{\a6}!حاضر سيّدتي
Dialogue: 0,0:06:36.04,0:06:38.36,CharCard,,0000,0000,0000,,{\fad(300,0)\pos(272.045,348.182)}سكرتير العمدة الشخصي\N(هيراتا كازواكي   (31
Dialogue: 0,0:06:38.62,0:06:41.29,On Top,,0000,0000,0000,,!لا تدعوا العمدة يواصل حكم إرهابه
Dialogue: 0,0:06:41.57,0:06:43.28,Default,,0000,0000,0000,,هل الأمور بخير؟
Dialogue: 0,0:06:43.28,0:06:44.35,Default,,0000,0000,0000,,ما قصدك يا شويتشي؟
Dialogue: 0,0:06:45.15,0:06:49.31,Default,,0000,0000,0000,,{\a6}يقولون أنّ الانتخابات المقبلة\Nلن تكون في صالح والدك{\a6}
Dialogue: 0,0:06:45.52,0:06:49.41,CharCard,,0000,0000,0000,,{\fad(300,0)\pos(265.909,345.455)}خاطب ريكو\N(موراساوا شويتشي   (27
Dialogue: 0,0:06:49.61,0:06:54.64,Default,,0000,0000,0000,,{\a6}فعلاً، يبدو أنّ المواطنين يميلون لي الأكثر بينكم{\a6}
Dialogue: 0,0:06:50.52,0:06:54.74,CharCard,,0000,0000,0000,,{\fad(300,0)\pos(270,353.636)}أثرى رجال البلدة\N(كاواشيما هيديو   (56
Dialogue: 0,0:06:55.85,0:06:59.02,Default,,0000,0000,0000,,هذا لأنّك تعرف كيف تستعمل المال فقط
Dialogue: 0,0:06:59.02,0:07:01.15,Default,,0000,0000,0000,,ما تعلّمتُه منك بالطبع
Dialogue: 0,0:07:01.63,0:07:04.39,Default,,0000,0000,0000,,يوجد رجل يريد رؤية العمدة
Dialogue: 0,0:07:04.59,0:07:06.26,Default,,0000,0000,0000,,من يكون في وقت كهذا؟
Dialogue: 0,0:07:06.26,0:07:09.09,Default,,0000,0000,0000,,...مُتحرٍّ من طوكيو
Dialogue: 0,0:07:09.09,0:07:11.48,Default,,0000,0000,0000,,!ماذا؟ مُتحرٍّ؟
Dialogue: 0,0:07:13.29,0:07:16.75,Default,,0000,0000,0000,,يا إلهي، إلى متى سيجعلونني أنتظر؟
Dialogue: 0,0:07:16.75,0:07:18.44,Default,,0000,0000,0000,,ماذا؟ أين كونان-كن؟
Dialogue: 0,0:07:21.16,0:07:22.35,Default,,0000,0000,0000,,بيانو؟
Dialogue: 0,0:07:23.94,0:07:26.19,Default,,0000,0000,0000,,!كونان-كن! توقف
Dialogue: 0,0:07:26.19,0:07:30.11,Default,,0000,0000,0000,,!ماذا؟ يا للغرفة الكبيرة
Dialogue: 0,0:07:30.11,0:07:33.75,Default,,0000,0000,0000,,طرف الشاطئ على الجانب الخلفي تماماً\Nللمركز الاجتماعي إذاً
Dialogue: 0,0:07:34.60,0:07:37.06,Default,,0000,0000,0000,,هذا البيانو متسخ
Dialogue: 0,0:07:37.06,0:07:39.40,Default,,0000,0000,0000,,...بمقدورهم تنظيفه بين الحين والآخر على الأقل
Dialogue: 0,0:07:40.60,0:07:42.60,Default,,0000,0000,0000,,!كلا! لا تلمسيه
Dialogue: 0,0:07:43.09,0:07:49.69,Default,,0000,0000,0000,,!إنّه البيانو الملعون الذي عزف أسو-سان عليه يوم موته
Dialogue: 0,0:07:50.05,0:07:52.93,Default,,0000,0000,0000,,...ملعون؟ لا تبالغ
Dialogue: 0,0:07:53.16,0:07:55.16,Default,,0000,0000,0000,,لم يكن أسو-سان الوحيد
Dialogue: 0,0:07:55.16,0:07:58.12,Default,,0000,0000,0000,,!حلّ الأمر نفسه بالعمدة السابق
Dialogue: 0,0:07:58.12,0:07:59.50,Default,,0000,0000,0000,,،تقصد كامياما إيسامو-سان
Dialogue: 0,0:07:59.50,0:08:01.97,Default,,0000,0000,0000,,الذي يعقدون تذكاراً له اليوم؟
Dialogue: 0,0:08:02.32,0:08:05.99,Default,,0000,0000,0000,,أجل، حدث الأمر قبل عامين
Dialogue: 0,0:08:08.15,0:08:10.49,Default,,0000,0000,0000,,كانت ليلة بدر
Dialogue: 0,0:08:10.49,0:08:14.89,Default,,0000,0000,0000,,كنتُ أمرّ بالمركز الاجتماعي الذي يفترض\Nأنّ لا أحد به
Dialogue: 0,0:08:14.89,0:08:17.65,Default,,0000,0000,0000,,حين سمعت صوت عزف بيانو من الداخل
Dialogue: 0,0:08:18.39,0:08:22.63,Default,,0000,0000,0000,,عندما سألتُ إن كان هناك أحد، توقف العزف
Dialogue: 0,0:08:24.18,0:08:27.80,Default,,0000,0000,0000,,!وفي الداخل، وجدت كامياما-ساما
Dialogue: 0,0:08:27.80,0:08:29.80,Default,,0000,0000,0000,,مات من نوبة قلبية
Dialogue: 0,0:08:29.80,0:08:32.71,Default,,0000,0000,0000,,والمقطوعة التي كان يعزفها قبيل موته
Dialogue: 0,0:08:32.71,0:08:38.00,Default,,0000,0000,0000,,"كانت نفس التي عزفها أسو-سان داخل النار، "ضوء القمر
Dialogue: 0,0:08:39.71,0:08:44.63,Default,,0000,0000,0000,,بعدها أصبح هذا البيانو معروفاً بالبيانو الملعون
Dialogue: 0,0:08:47.53,0:08:48.45,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:08:48.45,0:08:51.47,Default,,0000,0000,0000,,لا أرى خطباً غريباً بهذا البيانو
Dialogue: 0,0:08:52.81,0:08:56.22,Default,,0000,0000,0000,,بأيّ حال، انتظروا عند الباب الأمامي لحين\N!انتهاء المناسبة التذكارية رجاءً
Dialogue: 0,0:08:57.44,0:08:59.81,Default,,0000,0000,0000,,لا تزالون هنا؟
Dialogue: 0,0:09:00.48,0:09:02.34,Default,,0000,0000,0000,,نارومي-سان، أستحضرين المناسبة؟
Dialogue: 0,0:09:02.34,0:09:08.09,Default,,0000,0000,0000,,أجل، كان كامياما-سان أوّل من\Nشرّحته عندما أتيت هنا
Dialogue: 0,0:09:08.09,0:09:09.81,Default,,0000,0000,0000,,لذا خطر لي أن أحرق بخوراً لتكريمه
Dialogue: 0,0:09:10.89,0:09:13.89,Default,,0000,0000,0000,,هذا شيميزو-سان، التقيته في طريقي
Dialogue: 0,0:09:14.17,0:09:17.73,On Top,,0000,0000,0000,,مرحباً، اسمي شيميزو\Nيسرّني لقاؤكم
Dialogue: 0,0:09:14.17,0:09:17.73,CharCard,,0000,0000,0000,,{\fad(300,400)\pos(263.182,348.182)}مرشح عمدة\N(شيميزو ماساهيتو   (49
Dialogue: 0,0:09:22.09,0:09:24.62,CharCard,,0000,0000,0000,,{\fad(00,0)\pos(267.273,341.818)}عاطل\N(نيشيموتو كين   (55
Dialogue: 0,0:09:25.20,0:09:26.66,Default,,0000,0000,0000,,كاواشيما
Dialogue: 0,0:09:26.66,0:09:31.07,Default,,0000,0000,0000,,عيّنت مُتحرياً للتنقيب عن أسراري، صحيح؟
Dialogue: 0,0:09:31.07,0:09:31.72,Default,,0000,0000,0000,,سخافة
Dialogue: 0,0:09:33.31,0:09:34.35,Default,,0000,0000,0000,,!تهرب؟
Dialogue: 0,0:09:35.15,0:09:36.77,Default,,0000,0000,0000,,الحمّام
Dialogue: 0,0:09:41.02,0:09:42.97,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:09:42.97,0:09:46.14,Default,,0000,0000,0000,,يُفترض أن ذاك البيانو غير مستعمل لأعوام
Dialogue: 0,0:09:46.14,0:09:48.35,Default,,0000,0000,0000,,لكنه أصدر صوتاً مثالياً
Dialogue: 0,0:09:48.35,0:09:51.18,Default,,0000,0000,0000,,كان أحدهم يضبطه سرّاً بالتأكيد
Dialogue: 0,0:09:51.18,0:09:52.89,Default,,0000,0000,0000,,...لغرض ما
Dialogue: 0,0:09:53.29,0:09:57.85,Default,,0000,0000,0000,,وما كان معنى تلك الرسالة بالتحديد؟
Dialogue: 0,0:10:06.16,0:10:07.90,Default,,0000,0000,0000,,!هـ-هذه المعزوفة
Dialogue: 0,0:10:09.58,0:10:11.82,Default,,0000,0000,0000,,!ضوء القمر! كلا
Dialogue: 0,0:10:11.82,0:10:12.47,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:10:15.31,0:10:16.94,Default,,0000,0000,0000,,!أنت! أيها الصبي
Dialogue: 0,0:10:21.64,0:10:22.72,Default,,0000,0000,0000,,!كاواشيما-سان
Dialogue: 0,0:10:23.01,0:10:24.39,Default,,0000,0000,0000,,!تأخرت
Dialogue: 0,0:10:28.89,0:10:29.65,Default,,0000,0000,0000,,إنّه ميت
Dialogue: 0,0:10:30.06,0:10:31.35,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:31.71,0:10:34.59,Default,,0000,0000,0000,,ران، اتّصلي بمركز الشرطة المحلي
Dialogue: 0,0:10:34.59,0:10:35.59,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:10:35.59,0:10:38.84,Default,,0000,0000,0000,,طبيبة نارومي، افحصي الجثة رجاءً
Dialogue: 0,0:10:38.84,0:10:39.43,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:40.50,0:10:41.91,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:10:41.91,0:10:45.20,Default,,0000,0000,0000,,حذّرتنا تلك الرسالة من موت شخص\Nمرّة أخرى في جزيرة تسوكيكاغي
Dialogue: 0,0:10:45.20,0:10:48.27,Default,,0000,0000,0000,,!في ليلة بدر
Dialogue: 0,0:10:48.70,0:10:53.52,Default,,0000,0000,0000,,!إ-إنها اللعنة! إنها لعنة البيانو
Dialogue: 0,0:10:54.65,0:10:59.81,Default,,0000,0000,0000,,لا لعنة هناك، هذا المسجّل هو ما يشغل الموسيقى
Dialogue: 0,0:11:01.23,0:11:06.73,Default,,0000,0000,0000,,!هذه جريمة قتل أُعدّت لتشبه الحادثتين السابقتين
Dialogue: 0,0:11:07.14,0:11:08.73,Default,,0000,0000,0000,,!جريمة قتل؟
Dialogue: 0,0:11:08.73,0:11:11.27,Default,,0000,0000,0000,,أنت، لا تتفوه بالهراء
Dialogue: 0,0:11:11.27,0:11:13.43,Default,,0000,0000,0000,,!من تكون بالأصل؟
Dialogue: 0,0:11:14.30,0:11:18.63,Default,,0000,0000,0000,,!أنا المتحرّي الشهير من طوكيو، موري كوغورو
Dialogue: 0,0:11:18.63,0:11:20.82,Default,,0000,0000,0000,,رائد الفضاء ذاك؟
Dialogue: 0,0:11:21.41,0:11:24.33,Default,,0000,0000,0000,,كلا، إنّه من يظهر في روايات التحرّي
Dialogue: 0,0:11:24.33,0:11:26.00,Default,,0000,0000,0000,,ذاك أكيتشي
Dialogue: 0,0:11:26.00,0:11:27.73,Default,,0000,0000,0000,,من يكون هذا الشخص إذاً؟
Dialogue: 0,0:11:31.61,0:11:33.39,Default,,0000,0000,0000,,ماء بحر
Dialogue: 0,0:11:34.61,0:11:37.90,Default,,0000,0000,0000,,وقت الموت المقدر هو قبل نصف ساعة لساعة
Dialogue: 0,0:11:37.90,0:11:39.81,Default,,0000,0000,0000,,مات اختناقاً غالباً
Dialogue: 0,0:11:40.28,0:11:43.73,Default,,0000,0000,0000,,أعتقد أنّ كاواشيما-سان قد أُغرق
Dialogue: 0,0:11:43.73,0:11:45.27,Default,,0000,0000,0000,,أغرقه أحدهم؟
Dialogue: 0,0:11:45.73,0:11:48.81,Default,,0000,0000,0000,,لا يمكنني الجزم دون إجراء تشريح
Dialogue: 0,0:11:48.81,0:11:51.23,Default,,0000,0000,0000,,أظنّ الطبيبة نارومي محقّة
Dialogue: 0,0:11:51.55,0:11:53.80,Default,,0000,0000,0000,,انظروا، يوجد معطف بدلة على الشاطئ خارجاً
Dialogue: 0,0:11:53.80,0:11:56.44,Default,,0000,0000,0000,,لا بد أنّه لكاواشيما-سان
Dialogue: 0,0:11:56.80,0:12:01.01,Default,,0000,0000,0000,,يوجد أثر ماء بحر يمتد من الباب للبيانو
Dialogue: 0,0:12:01.01,0:12:03.98,Default,,0000,0000,0000,,وهناك وحل ورمل على ظهر كاواشيما-سان
Dialogue: 0,0:12:04.25,0:12:08.33,Default,,0000,0000,0000,,،كما من كون باب ونوافذ هذه الغرفة مغلقة
Dialogue: 0,0:12:08.33,0:12:12.60,Default,,0000,0000,0000,,...وفراغ الدقائق الأولى من شريط المسجّل
Dialogue: 0,0:12:12.60,0:12:15.44,Default,,0000,0000,0000,,...مـ-منذ متى بدأ
Dialogue: 0,0:12:15.65,0:12:19.70,Default,,0000,0000,0000,,أخذ المجرم كاواشيما-سان للمحيط\Nأثناء المناسبة التذكارية غالباً
Dialogue: 0,0:12:19.70,0:12:21.11,Default,,0000,0000,0000,,وأغرقه
Dialogue: 0,0:12:21.11,0:12:22.98,Default,,0000,0000,0000,,ثمّ سحب الجثّة لهذه الغرفة
Dialogue: 0,0:12:22.98,0:12:24.10,Default,,0000,0000,0000,,أقفل الباب
Dialogue: 0,0:12:24.10,0:12:27.02,Default,,0000,0000,0000,,شغّل مسجّل الأشرطة ثم خرج للرواق
Dialogue: 0,0:12:27.19,0:12:28.52,Default,,0000,0000,0000,,صحيح يا عمّ؟
Dialogue: 0,0:12:28.52,0:12:31.63,Default,,0000,0000,0000,,أ-أجل، معك حق
Dialogue: 0,0:12:33.84,0:12:36.69,Default,,0000,0000,0000,,بافتراض أنّ باب هذه الغرفة كان مقفلاً
Dialogue: 0,0:12:37.47,0:12:40.13,Default,,0000,0000,0000,,،هناك احتمال كبير أن القاتل رجع لقاعة المناسبة
Dialogue: 0,0:12:40.13,0:12:43.39,Default,,0000,0000,0000,,بما أنّنا كنا عند الباب الأمامي طوال الوقت
Dialogue: 0,0:12:43.62,0:12:45.37,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:12:45.37,0:12:47.88,Default,,0000,0000,0000,,!أتقصد أن القاتل لا يزال بيننا؟
Dialogue: 0,0:12:55.95,0:12:58.94,Default,,0000,0000,0000,,صحيح، المجرم هنا
Dialogue: 0,0:12:59.36,0:13:03.27,Default,,0000,0000,0000,,هل رأى أحدكم كاواشيما-سان يترك مقعده؟
Dialogue: 0,0:13:03.27,0:13:07.73,Default,,0000,0000,0000,,أنا رأيته، قال أنه سيذهب للحمّام
Dialogue: 0,0:13:08.06,0:13:11.55,Default,,0000,0000,0000,,هل رأى أحدكم شخصاً آخر غادر مقعده؟
Dialogue: 0,0:13:11.55,0:13:14.68,Default,,0000,0000,0000,,كأن بإمكاننا تذكر كلّ تفصيل حدث
Dialogue: 0,0:13:14.68,0:13:19.31,Default,,0000,0000,0000,,في هذه الحالة، أكان يحمل أحد ضغينة ضدّ كاواشيما-سان؟
Dialogue: 0,0:13:19.64,0:13:21.01,Default,,0000,0000,0000,,ليست ضغينة تماماً
Dialogue: 0,0:13:21.01,0:13:25.42,Default,,0000,0000,0000,,،لكن أكثر شخص سيسرّ بموته هو شيميزو-سان
Dialogue: 0,0:13:25.42,0:13:28.04,Default,,0000,0000,0000,,خصمه في انتخابات العمدة
Dialogue: 0,0:13:28.04,0:13:32.02,Default,,0000,0000,0000,,!مـ-ماذا؟! ينطبق الأمر عليك يا عمدة كوريوا
Dialogue: 0,0:13:32.32,0:13:34.03,Default,,0000,0000,0000,,أجل، دون كاواشيما-سان
Dialogue: 0,0:13:34.03,0:13:36.62,Default,,0000,0000,0000,,كان نصر أبي ليكون مضموناً
Dialogue: 0,0:13:36.62,0:13:38.28,Default,,0000,0000,0000,,طالما لم يكن أحدهم يخطط
Dialogue: 0,0:13:38.28,0:13:41.81,Default,,0000,0000,0000,,لسرقة أصوات كاواشيما-سان بالطبع
Dialogue: 0,0:13:41.81,0:13:42.65,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:42.65,0:13:43.60,Default,,0000,0000,0000,,!سيّدتي
Dialogue: 0,0:13:43.90,0:13:45.81,Default,,0000,0000,0000,,...اهدؤوا
Dialogue: 0,0:13:45.81,0:13:50.15,Default,,0000,0000,0000,,لكن لمَ وضع القاتلُ الجثّةَ في هذه الغرفة؟
Dialogue: 0,0:13:50.15,0:13:54.97,Default,,0000,0000,0000,,ذلك لأنّ القاتل أراد توجيه اللوم للبيانو الملعون
Dialogue: 0,0:13:54.97,0:13:57.48,Default,,0000,0000,0000,,بالمناسبة، منذ متى والبيانو هنا؟
Dialogue: 0,0:13:57.48,0:14:02.89,Default,,0000,0000,0000,,كان هنا لخمسة عشر عاماً مذ تبرع به أسو-سان
Dialogue: 0,0:14:03.13,0:14:05.96,Default,,0000,0000,0000,,أسو-سان ذاك إذاً؟
Dialogue: 0,0:14:05.96,0:14:09.52,Default,,0000,0000,0000,,أجل، اسمه على غطاء لوحة المفاتيح حتى
Dialogue: 0,0:14:11.00,0:14:12.64,Default,,0000,0000,0000,,ما-ما هذا؟
Dialogue: 0,0:14:15.37,0:14:16.95,Default,,0000,0000,0000,,قطعة موسيقية
Dialogue: 0,0:14:16.95,0:14:20.77,Default,,0000,0000,0000,,غريب، لم تكن موجودةً عندما تفقدناه في الظهيرة
Dialogue: 0,0:14:27.32,0:14:28.98,Default,,0000,0000,0000,,من كان ذاك؟
Dialogue: 0,0:14:28.98,0:14:30.40,Default,,0000,0000,0000,,نيشيموتو-سان
Dialogue: 0,0:14:30.82,0:14:32.89,Default,,0000,0000,0000,,كان بحالٍ ممتازة في السابق
Dialogue: 0,0:14:32.89,0:14:36.81,Default,,0000,0000,0000,,وأنفق الكثير من المال على الشراب والنساء والقمار كما سمعت
Dialogue: 0,0:14:36.81,0:14:39.93,Default,,0000,0000,0000,,،لكن بعد موت العمدة قبل عامين
Dialogue: 0,0:14:39.93,0:14:43.81,Default,,0000,0000,0000,,توقف عن الخروج كما لو كان يخشى شيئاً
Dialogue: 0,0:14:43.81,0:14:44.75,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:14:44.75,0:14:48.02,Default,,0000,0000,0000,,كان صديق طفولة لك أيها العمدة، صحيح؟
Dialogue: 0,0:14:48.92,0:14:51.72,Default,,0000,0000,0000,,أ-أجل، معك حق
Dialogue: 0,0:14:53.37,0:14:54.45,Default,,0000,0000,0000,,!إنّه شرطي
Dialogue: 0,0:14:54.45,0:14:55.66,Default,,0000,0000,0000,,تأخّرتِ يا ران
Dialogue: 0,0:14:55.66,0:14:59.73,Default,,0000,0000,0000,,لكن كان عليّ البحث عنه، لم يكن في مركز الشرطة
Dialogue: 0,0:15:00.12,0:15:02.40,Default,,0000,0000,0000,,حسناً، من طلبني؟
Dialogue: 0,0:15:02.40,0:15:05.31,Default,,0000,0000,0000,,هذا الشخص، اسمه موري كوغورو
Dialogue: 0,0:15:06.32,0:15:07.28,Default,,0000,0000,0000,,...ذاك المشهور
Dialogue: 0,0:15:07.28,0:15:07.94,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:15:07.94,0:15:09.23,Default,,0000,0000,0000,,!رائد الفضاء
Dialogue: 0,0:15:09.23,0:15:11.31,Default,,0000,0000,0000,,...كلا
Dialogue: 0,0:15:11.64,0:15:14.14,Default,,0000,0000,0000,,بأيّ حال، تأخر الوقت
Dialogue: 0,0:15:14.14,0:15:17.23,Default,,0000,0000,0000,,يمكننا تأجيل جمع المعلومات لصباح الغد
Dialogue: 0,0:15:17.52,0:15:21.55,Default,,0000,0000,0000,,لم تكن جريمة قتل، كانت لعنة أسو-سان
Dialogue: 0,0:15:21.55,0:15:22.93,Default,,0000,0000,0000,,...يا للرعب
Dialogue: 0,0:15:23.88,0:15:28.46,Default,,0000,0000,0000,,كان عليهم حرق ذاك البيانو القديم المريب
Dialogue: 0,0:15:28.46,0:15:32.93,Default,,0000,0000,0000,,أجل، قد نكون أفضل حالاً دون ذاك الشيء
Dialogue: 0,0:15:34.16,0:15:35.35,Default,,0000,0000,0000,,شويتشي؟
Dialogue: 0,0:15:37.31,0:15:40.50,Default,,0000,0000,0000,,!أدهشتني استنتاجاتك يا كونان-كن
Dialogue: 0,0:15:40.50,0:15:42.99,Default,,0000,0000,0000,,يحب لعب لعبة المُتحري
Dialogue: 0,0:15:42.99,0:15:46.69,Default,,0000,0000,0000,,كان الجميع يتكلمون عن قوّة إقناعه
Dialogue: 0,0:15:46.94,0:15:49.07,Default,,0000,0000,0000,,!كنتُ أقلد عمّي فقط
Dialogue: 0,0:15:49.07,0:15:51.81,Default,,0000,0000,0000,,!فأنا أراه في عمله دوماً
Dialogue: 0,0:15:52.68,0:15:56.85,Default,,0000,0000,0000,,لكنّه مجرد فرخ مقارنةً بي
Dialogue: 0,0:15:56.85,0:15:59.48,Default,,0000,0000,0000,,حسنٌ، سنرجع للنُزل الآن
Dialogue: 0,0:15:59.85,0:16:03.76,Default,,0000,0000,0000,,أراكم لاحقاً إذاً، آمل أن تحلّ القضية بأسرع ما يمكن
Dialogue: 0,0:16:03.76,0:16:06.81,Default,,0000,0000,0000,,أفضّل ألا أفحص جثثاً أكثر
Dialogue: 0,0:16:06.81,0:16:10.88,Default,,0000,0000,0000,,!لا تقلقي! سيكون هذا لقمةً سائغة بين يديّ
Dialogue: 0,0:16:12.41,0:16:16.29,Default,,0000,0000,0000,,يا للادّعاء، حتّى أنا لا أعرف ما يجري
Dialogue: 0,0:16:18.41,0:16:19.66,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:16:19.66,0:16:22.99,Default,,0000,0000,0000,,..."قالت الرسالة "ستبدأ بالاختفاء
Dialogue: 0,0:16:22.99,0:16:26.85,Default,,0000,0000,0000,,!أي أنّ هذه ليست النهاية
Dialogue: 0,0:16:26.85,0:16:30.57,Default,,0000,0000,0000,,!ماذا؟ لن تتوقف جرائم القتل؟
Dialogue: 0,0:16:30.57,0:16:33.56,Default,,0000,0000,0000,,هذه الرسالة تحذرنا من ذلك؟
Dialogue: 0,0:16:33.56,0:16:37.19,Default,,0000,0000,0000,,اختفاء الظلال يعني تطويق الضوء لها
Dialogue: 0,0:16:37.19,0:16:41.47,Default,,0000,0000,0000,,يرمز الضوء للمقطوعة في كل المسارح الجريمة، ضوء القمر
Dialogue: 0,0:16:41.47,0:16:43.01,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:16:43.01,0:16:46.44,Default,,0000,0000,0000,,المقطوعة التي عزفها السيّد أسو بين \N،ألسنة النار قبل 12 عاماً
Dialogue: 0,0:16:47.01,0:16:50.52,Default,,0000,0000,0000,,والتي عزفها العمدة قبل وفاته منذ عامين
Dialogue: 0,0:16:51.00,0:16:53.67,Default,,0000,0000,0000,,كانت سوناتا بيانو بيتهوفين، ضوء القمر
Dialogue: 0,0:16:53.67,0:16:57.85,Default,,0000,0000,0000,,وكلّ الحوادث الثلاث وقعت بجوار البيانو
Dialogue: 0,0:16:58.17,0:16:59.87,Default,,0000,0000,0000,,!ارجعا للنُزل
Dialogue: 0,0:16:59.87,0:17:00.65,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:17:02.74,0:17:05.77,Default,,0000,0000,0000,,!لنذهب يا ران-نيتشان للمركز الاجتماعي أيضاً
Dialogue: 0,0:17:09.20,0:17:11.77,Default,,0000,0000,0000,,أنتَ لست بعقلك حقاً
Dialogue: 0,0:17:11.77,0:17:13.98,Default,,0000,0000,0000,,تقضي الليلة مع جثّة هكذا
Dialogue: 0,0:17:13.98,0:17:16.19,Default,,0000,0000,0000,,!كما مع طفل
Dialogue: 0,0:17:16.98,0:17:19.69,Default,,0000,0000,0000,,!أخبرتكما أن ترجعا
Dialogue: 0,0:17:19.69,0:17:21.59,Default,,0000,0000,0000,,...لكن كونان-كن
Dialogue: 0,0:17:21.59,0:17:25.02,Default,,0000,0000,0000,,أخبرني، من حرّك الجثة دون إذني؟
Dialogue: 0,0:17:25.47,0:17:26.68,Default,,0000,0000,0000,,أنا
Dialogue: 0,0:17:26.68,0:17:30.97,Default,,0000,0000,0000,,شعرت بالأسف للمسكين في وضعيته
Dialogue: 0,0:17:31.33,0:17:33.00,Default,,0000,0000,0000,,هذه مشكلة
Dialogue: 0,0:17:33.00,0:17:34.79,Default,,0000,0000,0000,,لم ننته من التحقيق في مسرح الجريمة بعد
Dialogue: 0,0:17:34.79,0:17:36.81,Default,,0000,0000,0000,,ماذا؟ اختفت القطعة الموسيقية
Dialogue: 0,0:17:36.81,0:17:38.06,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:38.46,0:17:41.73,Default,,0000,0000,0000,,أخذتها معي كيلا تضيع، انظر
Dialogue: 0,0:17:42.45,0:17:43.57,Default,,0000,0000,0000,,...هذا العجوز
Dialogue: 0,0:17:43.57,0:17:44.87,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:44.87,0:17:46.82,Default,,0000,0000,0000,,!هذه مقطوعة ضوء القمر
Dialogue: 0,0:17:46.82,0:17:47.19,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:47.19,0:17:48.57,Default,,0000,0000,0000,,ضوء القمر؟
Dialogue: 0,0:17:56.65,0:17:58.40,Default,,0000,0000,0000,,!ما الذي تفعلينه؟! فاشلة العزف
Dialogue: 0,0:17:58.40,0:18:02.18,Default,,0000,0000,0000,,كلا، هذه الفاصلة الرابعة غريبة
Dialogue: 0,0:18:02.43,0:18:03.89,Default,,0000,0000,0000,,الفاصلة الرابعة؟
Dialogue: 0,0:18:03.89,0:18:05.44,Default,,0000,0000,0000,,...أيمكن أنّ هذه القطعة الموسيقية
Dialogue: 0,0:18:06.39,0:18:08.35,Default,,0000,0000,0000,,رسالة احتضار كاواشيما-سان؟
Dialogue: 0,0:18:08.76,0:18:11.79,Default,,0000,0000,0000,,!في تلك الحالة، قد يرجع القاتل لها
Dialogue: 0,0:18:11.79,0:18:13.47,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:18:13.79,0:18:17.21,Default,,0000,0000,0000,,عندما سألت عنكم في النُزل قالوا أنّكم هنا
Dialogue: 0,0:18:17.21,0:18:18.79,Default,,0000,0000,0000,,الطبيبة نارومي
Dialogue: 0,0:18:18.79,0:18:20.69,Default,,0000,0000,0000,,أحضرتُ عشاءً
Dialogue: 0,0:18:21.66,0:18:23.33,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:18:23.33,0:18:25.10,Default,,0000,0000,0000,,نتضور جوعاً
Dialogue: 0,0:18:28.33,0:18:31.82,Default,,0000,0000,0000,,لستِ من أهل الجزيرة إذاً؟
Dialogue: 0,0:18:31.82,0:18:35.15,Default,,0000,0000,0000,,كلا، أعود لطوكيو نهاية كلّ أسبوع
Dialogue: 0,0:18:35.15,0:18:36.83,Default,,0000,0000,0000,,كأنّي أعمل طبيبة بدوام جزئي هنا
Dialogue: 0,0:18:37.23,0:18:40.15,Default,,0000,0000,0000,,،لطالما أردت أن أعمل في جزيرة صغيرة كهذه
Dialogue: 0,0:18:40.15,0:18:44.26,Default,,0000,0000,0000,,...محاطةً بالطبيعة
Dialogue: 0,0:18:44.26,0:18:46.27,Default,,0000,0000,0000,,أكملت عامين هذه السنة
Dialogue: 0,0:18:46.85,0:18:48.18,Default,,0000,0000,0000,,الطبيبة نارومي
Dialogue: 0,0:18:48.18,0:18:54.23,Default,,0000,0000,0000,,هل مات العمدة السابق كامياما \Nمن نوبة قلبية قبل عامين حقاً؟
Dialogue: 0,0:18:54.50,0:18:58.06,Default,,0000,0000,0000,,أجل، كان يعاني مشاكل قلبية باستمرار
Dialogue: 0,0:18:58.06,0:19:01.08,Default,,0000,0000,0000,,لكن كان وجهه متشنّجاً
Dialogue: 0,0:19:01.08,0:19:03.82,Default,,0000,0000,0000,,كما لو رأى شيئاً مرعباً
Dialogue: 0,0:19:04.37,0:19:07.49,Default,,0000,0000,0000,,هل لاحظتِ أمراً غريباً آنذاك؟
Dialogue: 0,0:19:07.49,0:19:10.49,Default,,0000,0000,0000,,حسناً... تذكرت
Dialogue: 0,0:19:10.49,0:19:11.22,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:19:11.65,0:19:13.65,Default,,0000,0000,0000,,أظن أن إحدى النوافذ كانت مفتوحة
Dialogue: 0,0:19:13.65,0:19:15.56,Default,,0000,0000,0000,,نافذة؟
Dialogue: 0,0:19:15.82,0:19:21.01,Default,,0000,0000,0000,,...اعتقدنا أن أحداً نسي إغلاقها فقط آنذاك، لكن
Dialogue: 0,0:19:21.01,0:19:22.68,Default,,0000,0000,0000,,أيّ نافذة كانت؟
Dialogue: 0,0:19:22.68,0:19:23.84,Default,,0000,0000,0000,,...وفقما أتذكر
Dialogue: 0,0:19:27.68,0:19:28.90,Default,,0000,0000,0000,,كانت هذه النافذة
Dialogue: 0,0:19:28.90,0:19:29.61,Default,,0000,0000,0000,,!من هناك؟
Dialogue: 0,0:19:31.46,0:19:32.51,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:19:32.51,0:19:33.88,Default,,0000,0000,0000,,!لن تهرب
Dialogue: 0,0:19:38.63,0:19:41.33,Default,,0000,0000,0000,,!تبّاً! فقدناه
Dialogue: 0,0:19:41.33,0:19:45.98,Default,,0000,0000,0000,,كنتُ محقاً! رجع لأخذ هذه القطعة الموسيقية
Dialogue: 0,0:19:46.66,0:19:49.20,Default,,0000,0000,0000,,!حسنٌ! سنسهر طوال الليلة ونحرس المكان
Dialogue: 0,0:19:49.20,0:19:50.00,Default,,0000,0000,0000,,!واضح؟
Dialogue: 0,0:19:50.00,0:19:51.10,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:19:52.61,0:19:54.02,Default,,0000,0000,0000,,أنت، موري-كن
Dialogue: 0,0:19:55.11,0:19:56.35,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:19:57.49,0:19:58.82,Default,,0000,0000,0000,,إنّها الظهيرة
Dialogue: 0,0:19:58.82,0:20:01.31,Default,,0000,0000,0000,,حضرة المفتش ميغوري، ماذا تفعل هنا؟
Dialogue: 0,0:20:01.77,0:20:04.31,Default,,0000,0000,0000,,هذه الجزيرة تعتبر جزءاً من طوكيو
Dialogue: 0,0:20:04.64,0:20:06.39,Default,,0000,0000,0000,,صحيح، أين وضعت تلك؟
Dialogue: 0,0:20:06.93,0:20:09.71,Default,,0000,0000,0000,,،إن كنت تقصد القطعة الموسيقية\Nفكونان-كن أعطاني إياها
Dialogue: 0,0:20:10.14,0:20:12.64,Default,,0000,0000,0000,,شرح لي تفاصيل الوضع أيضاً
Dialogue: 0,0:20:12.64,0:20:16.17,Default,,0000,0000,0000,,كان ثلاثتهم مستيقظين عند وصولنا
Dialogue: 0,0:20:16.17,0:20:19.13,Default,,0000,0000,0000,,أنت وذاك العجوز كنتما وحدكما النائمين
Dialogue: 0,0:20:20.30,0:20:22.66,Default,,0000,0000,0000,,إنّهم يجرون استجوابات في دار البلدية
Dialogue: 0,0:20:22.66,0:20:24.50,Default,,0000,0000,0000,,اذهب وساعدهم
Dialogue: 0,0:20:24.50,0:20:25.36,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:20:35.57,0:20:39.40,Default,,0000,0000,0000,,كان علينا ألّا ننام هناك
Dialogue: 0,0:20:39.40,0:20:42.39,Default,,0000,0000,0000,,أبي، كيف جرى الأمر؟ هل عرفت المجرم؟
Dialogue: 0,0:20:42.39,0:20:47.02,Default,,0000,0000,0000,,لا تكوني سخيفة، كان هناك 38 شخصاً\Nفي المناسبة التذكارية
Dialogue: 0,0:20:47.02,0:20:48.81,Default,,0000,0000,0000,,لن يكون الأمر بتلك السهولة
Dialogue: 0,0:20:49.27,0:20:52.68,Default,,0000,0000,0000,,آسفة، لكن متى سيحين دوري؟
Dialogue: 0,0:20:52.68,0:20:56.22,Default,,0000,0000,0000,,تبدين مرهقة، لذا ترتيبك الأخير
Dialogue: 0,0:20:56.22,0:20:59.02,Default,,0000,0000,0000,,سأذهب لغسل وجهي في دورة مياه\Nالسيدات قبل ذلك إذاً
Dialogue: 0,0:21:00.43,0:21:03.35,Default,,0000,0000,0000,,كم استجواباً بقي لديكم؟
Dialogue: 0,0:21:03.67,0:21:06.54,Default,,0000,0000,0000,,بإضافة الطبيبة نارومي يكونون ستّة
Dialogue: 0,0:21:06.54,0:21:10.74,Default,,0000,0000,0000,,ابنة العمدة هناك، كوريوا ريكو
Dialogue: 0,0:21:10.74,0:21:13.36,Default,,0000,0000,0000,,وخطيبها موراساوا شويتشي
Dialogue: 0,0:21:13.36,0:21:15.20,Default,,0000,0000,0000,,المرشّح للعمدة شيميزو ماساتو
Dialogue: 0,0:21:15.20,0:21:16.89,Default,,0000,0000,0000,,وسكرتير العمدة هيراتا كازواكي
Dialogue: 0,0:21:17.49,0:21:20.98,Default,,0000,0000,0000,,ونيشيموتو كين الذي نستجوبه حالياً
Dialogue: 0,0:21:20.98,0:21:22.85,Default,,0000,0000,0000,,لكنه يهدر وقتنا حقاً
Dialogue: 0,0:21:23.44,0:21:25.65,Default,,0000,0000,0000,,لا ينبس ببنت شفة مهما سألناه
Dialogue: 0,0:21:25.65,0:21:28.31,Default,,0000,0000,0000,,تخبرني غريزتي أنّه كان الفاعل
Dialogue: 0,0:21:28.31,0:21:30.76,Default,,0000,0000,0000,,!أحمق! أي لعنة بيانو تتحدث عنها؟
Dialogue: 0,0:21:31.43,0:21:34.97,Default,,0000,0000,0000,,تحصل هذه الجرائم باستمرار لوجود ذاك الشيء
Dialogue: 0,0:21:34.97,0:21:36.48,Default,,0000,0000,0000,,...لكن أيّها العمدة
Dialogue: 0,0:21:36.48,0:21:39.18,Default,,0000,0000,0000,,!تخلّص منه فوراً! واضح يا هيراتا؟
Dialogue: 0,0:21:39.18,0:21:40.19,Default,,0000,0000,0000,,!حـ-حاضر
Dialogue: 0,0:21:40.19,0:21:41.93,Default,,0000,0000,0000,,...تبّاً
Dialogue: 0,0:21:45.23,0:21:47.35,Default,,0000,0000,0000,,!يكفي هذا
Dialogue: 0,0:21:47.35,0:21:50.76,Default,,0000,0000,0000,,!لا دافع لديّ لقتل كاواشيما-سان
Dialogue: 0,0:21:51.03,0:21:52.07,Default,,0000,0000,0000,,!يا إلهي
Dialogue: 0,0:21:52.07,0:21:54.20,Default,,0000,0000,0000,,اسمعي لريكو-سان
Dialogue: 0,0:21:54.20,0:21:56.19,Default,,0000,0000,0000,,لم تتوقف عن الصراخ لعشر دقائق
Dialogue: 0,0:21:56.19,0:21:57.66,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:21:57.66,0:22:02.81,Default,,0000,0000,0000,,انتهوا من استجوابه، فلمَ لم\Nيغادر نيشيموتو-سان؟
Dialogue: 0,0:22:02.81,0:22:03.56,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:22:05.02,0:22:07.15,Default,,0000,0000,0000,,سـ-سأذهب لدورة المياه
Dialogue: 0,0:22:15.76,0:22:18.65,Default,,0000,0000,0000,,ماذا؟ ألم يدخل نيشيموتو-سان هنا للتو؟
Dialogue: 0,0:22:18.97,0:22:20.11,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:22:20.51,0:22:22.31,Default,,0000,0000,0000,,!تبّاً! صعد الأدراج
Dialogue: 0,0:22:27.29,0:22:28.44,Default,,0000,0000,0000,,...هذه المقطوعة
Dialogue: 0,0:22:30.29,0:22:32.77,Default,,0000,0000,0000,,...إنّها الحركة الثانية لضوء القمر
Dialogue: 0,0:22:33.16,0:22:35.85,Default,,0000,0000,0000,,!أين مصدر الصوت؟
Dialogue: 0,0:22:35.85,0:22:37.78,Default,,0000,0000,0000,,!غرفة البثّ
Dialogue: 0,0:22:38.99,0:22:40.25,Default,,0000,0000,0000,,!نيشيموتو-سان
Dialogue: 0,0:22:45.32,0:22:46.82,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:22:48.65,0:22:50.36,Default,,0000,0000,0000,,!كلا، لا تدخلي
Dialogue: 0,0:22:52.47,0:22:54.81,Default,,0000,0000,0000,,!استدعوا المحلّلين وفريق التشريح فوراً
Dialogue: 0,0:22:54.81,0:22:55.51,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:22:55.51,0:22:59.19,Default,,0000,0000,0000,,غادر فريق التشريح لطوكيو مساءً\Nلفحص جثّة كاواشيما-سان
Dialogue: 0,0:22:59.19,0:23:00.51,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:23:00.51,0:23:02.34,Default,,0000,0000,0000,,...تبّاً! في هذا الوقت
Dialogue: 0,0:23:02.34,0:23:03.39,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:23:04.13,0:23:05.42,Default,,0000,0000,0000,,يمكنني فعلها
Dialogue: 0,0:23:05.42,0:23:06.85,Default,,0000,0000,0000,,...الطبيبة نارومي
Dialogue: 0,0:23:07.13,0:23:10.44,Default,,0000,0000,0000,,لكن هذا يقلّص عدد المشتبه بهم لفئة محدودة
Dialogue: 0,0:23:10.44,0:23:12.79,Default,,0000,0000,0000,,...لا يزال القاتل إذاً
Dialogue: 0,0:23:12.79,0:23:16.27,Default,,0000,0000,0000,,تحرس الشرطة كافة مخارج هذا المبنى
Dialogue: 0,0:23:16.27,0:23:17.74,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:23:17.74,0:23:21.39,Default,,0000,0000,0000,,!من هو؟! من القاتل؟
Dialogue: 0,0:23:28.32,0:23:32.55,Default,,0000,0000,0000,,يبدو أنّه مضت بضع دقائق فقط\Nعلى موت الضحية
Dialogue: 0,0:23:33.35,0:23:38.27,Default,,0000,0000,0000,,بالفعل، يبدو أنّ أول خمس دقائق ونصف\Nلهذا الشريط فارغة
Dialogue: 0,0:23:38.52,0:23:39.72,Default,,0000,0000,0000,,!المفتّش ميغوري
Dialogue: 0,0:23:39.72,0:23:41.67,Default,,0000,0000,0000,,!كان هناك شيءٌ غريب أسفل الجثة
Dialogue: 0,0:23:41.67,0:23:42.47,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:23:45.34,0:23:46.37,Default,,0000,0000,0000,,قطعة موسيقية؟
Dialogue: 0,0:23:47.17,0:23:50.06,Default,,0000,0000,0000,,أهذه رسالة احتضار أخرى من الضحية؟
Dialogue: 0,0:23:50.34,0:23:51.76,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:23:52.08,0:23:56.29,Default,,0000,0000,0000,,،لو كان لديه وقت وقوّة لكتابة كلّ هذا بدمه
Dialogue: 0,0:23:56.29,0:23:57.29,Default,,0000,0000,0000,,لطلب المساعدة
Dialogue: 0,0:23:58.04,0:24:00.93,Default,,0000,0000,0000,,...ترك القاتل هذه غالباً
Dialogue: 0,0:24:01.19,0:24:02.10,Default,,0000,0000,0000,,!لا تتدخل
Dialogue: 0,0:24:02.69,0:24:05.85,Default,,0000,0000,0000,,!كلا! الدليل الثمين
Dialogue: 0,0:24:06.65,0:24:07.77,Default,,0000,0000,0000,,!إنّه بخير
Dialogue: 0,0:24:08.90,0:24:11.93,Default,,0000,0000,0000,,!أنت تعترض عملنا! اخرج
Dialogue: 0,0:24:14.14,0:24:20.18,Default,,0000,0000,0000,,بما أنّ سوناتا ضوء القمر لبيتهوفين عُزفت\N،بعد كلّ جريمة قتل
Dialogue: 0,0:24:20.18,0:24:29.14,Default,,0000,0000,0000,,يمكننا استنتاج أنّ قاتل كاواشيما-سان في الجريمة الأولى\Nوقاتل كوريوا-سان في الثانية هو الشخص نفسه
Dialogue: 0,0:24:29.14,0:24:32.21,Default,,0000,0000,0000,,،وبناءً على جزء الشريط الفارغ
Dialogue: 0,0:24:32.21,0:24:33.83,Default,,0000,0000,0000,,قُتل كوريوا-سان
Dialogue: 0,0:24:33.83,0:24:37.64,Default,,0000,0000,0000,,عند السادسة ونصف، قبل دقائق فقط من اكتشاف جثته
Dialogue: 0,0:24:37.64,0:24:40.61,Default,,0000,0000,0000,,أي أنّ القاتل أحدكم بما أنّكم
Dialogue: 0,0:24:40.61,0:24:43.56,Default,,0000,0000,0000,,!كنتم الوحيدين في المركز الاجتماعي في هذا الوقت
Dialogue: 0,0:24:44.24,0:24:45.95,Default,,0000,0000,0000,,{\a6}،باستثناء موري-كن والبقية
Dialogue: 0,0:24:45.95,0:24:48.20,Default,,0000,0000,0000,,{\a6}يبقى المكتشف الأول للجثة، نيشيموتو كين-سان{\a6}
Dialogue: 0,0:24:48.20,0:24:51.14,Default,,0000,0000,0000,,{\a6}والطبيبة أساي نارومي التي تفضّلت بتشريح الجثة{\a6}
Dialogue: 0,0:24:51.64,0:24:55.10,Default,,0000,0000,0000,,{\a6}وهيراتا كازواكي-سان، سكرتير العمدة كوريوا المتوفى{\a6}
Dialogue: 0,0:24:55.10,0:24:58.31,Default,,0000,0000,0000,,{\a6}وابنة العمدة، كوريوا ريكو-سان {\a6}
Dialogue: 0,0:24:58.31,0:25:00.55,Default,,0000,0000,0000,,{\a6}وخطيبها موراساوا شويتشي-سان
Dialogue: 0,0:25:00.55,0:25:04.51,Default,,0000,0000,0000,,{\a6}وأخيراً شيميزو ماساتو-سان، المرشح في انتخابات العمدة{\a6}
Dialogue: 0,0:25:04.51,0:25:08.18,Default,,0000,0000,0000,,!انتظر! لمَ أنا ضمن المشتبه بهم؟
Dialogue: 0,0:25:08.18,0:25:12.29,Default,,0000,0000,0000,,!كنتَ تستجوبني منذ السادسة والثلث
Dialogue: 0,0:25:12.29,0:25:15.43,Default,,0000,0000,0000,,...معك حق، لم يكن بإمكانك ارتكاب الجريمة
Dialogue: 0,0:25:15.73,0:25:18.25,Default,,0000,0000,0000,,يمكنكم استثناء الطبيبة نارومي أيضاً إذاً
Dialogue: 0,0:25:18.25,0:25:21.03,Default,,0000,0000,0000,,فقد كانت رفقتنا مذ تمام السادسة
Dialogue: 0,0:25:21.03,0:25:22.32,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:25:22.32,0:25:23.14,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:25:23.14,0:25:27.35,Default,,0000,0000,0000,,يبقى أربعة رجال مشتبه بهم إذاً
Dialogue: 0,0:25:27.82,0:25:32.15,Default,,0000,0000,0000,,المعذرة، لكني كنت على هذا الطابق منذ السادسة
Dialogue: 0,0:25:32.15,0:25:33.70,Default,,0000,0000,0000,,ألديك شاهد؟
Dialogue: 0,0:25:34.81,0:25:38.02,Default,,0000,0000,0000,,يمكنكم أن تشهدوا بوجودي، صحيح؟
Dialogue: 0,0:25:38.02,0:25:41.47,Default,,0000,0000,0000,,آسف، لكني ذهبت لدورة المياه عند السادسة والنصف
Dialogue: 0,0:25:41.76,0:25:43.93,Default,,0000,0000,0000,,أخبرني يا نيشيموتو-سان
Dialogue: 0,0:25:44.26,0:25:48.22,Default,,0000,0000,0000,,كنتَ أوّل من وجد جثّة كوريوا-سان
Dialogue: 0,0:25:48.22,0:25:50.89,Default,,0000,0000,0000,,ماذا كنت تفعل هناك؟
Dialogue: 0,0:25:51.21,0:25:54.54,Default,,0000,0000,0000,,قال كوريوا أنّه يريد رؤيتي
Dialogue: 0,0:25:54.54,0:25:56.83,Default,,0000,0000,0000,,!ألم تكن من استدعاه وقتله؟
Dialogue: 0,0:25:56.83,0:25:58.13,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:25:58.13,0:25:59.73,Default,,0000,0000,0000,,!كان شيميزو
Dialogue: 0,0:25:59.73,0:26:02.57,Default,,0000,0000,0000,,،باختفاء كاواشيما وأبي من الانتخابات
Dialogue: 0,0:26:02.57,0:26:07.16,Default,,0000,0000,0000,,!سيفوز بمنصب العمدة تلقائياً
Dialogue: 0,0:26:07.16,0:26:09.73,Default,,0000,0000,0000,,ماذا؟ ما الذي تنظر له يا كونان-كن؟
Dialogue: 0,0:26:07.97,0:26:11.79,On Top,,0000,0000,0000,,لا تكوني حمقاء! لن أقتلهما الاثنين\N!لأخذ منصب العمدة فقط
Dialogue: 0,0:26:09.73,0:26:12.87,Default,,0000,0000,0000,,القطعة الموسيقية التي تركها القاتل في مسرح الجريمة
Dialogue: 0,0:26:11.79,0:26:12.87,On Top,,0000,0000,0000,,!يا للسخافة
Dialogue: 0,0:26:13.77,0:26:18.27,Default,,0000,0000,0000,,أظنّها رسالة مشفرة من القاتل
Dialogue: 0,0:26:18.86,0:26:21.72,Default,,0000,0000,0000,,أتساءل إن كان هناك شيء مميز في هذه\Nالنغمات الحادة والمنخفضة
Dialogue: 0,0:26:22.05,0:26:27.35,Default,,0000,0000,0000,,هذه المفاتيح السوداء على لوحة المفاتيح، صحيح؟
Dialogue: 0,0:26:27.35,0:26:28.35,Default,,0000,0000,0000,,لوحة المفاتيح؟
Dialogue: 0,0:26:29.18,0:26:32.54,Default,,0000,0000,0000,,...اعتقلوا هذا القاتل فوراً! وإلّا سيموت المزيد
Dialogue: 0,0:26:32.54,0:26:35.10,Default,,0000,0000,0000,,احترس، دورك التالي
Dialogue: 0,0:26:35.67,0:26:36.71,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:26:36.71,0:26:39.48,Default,,0000,0000,0000,,هذه الشفرة سهلة إن عرفتِ كيف تقرئينها
Dialogue: 0,0:26:40.45,0:26:44.83,Default,,0000,0000,0000,,إنها مبنية على النغمات المتوافقة \Nمع مفاتيح بيانو محددة
Dialogue: 0,0:26:44.83,0:26:48.94,Default,,0000,0000,0000,,.إن رتبت أحرف الأبجدية على لوحة مفاتيح بيانو
Dialogue: 0,0:26:49.49,0:26:53.76,Default,,0000,0000,0000,,باستعمال هذا، تقول القطعة الموسيقية\N:حيث قُتل كاواشيما-سان
Dialogue: 0,0:26:54.27,0:27:00.89,Default,,0000,0000,0000,,"احترس، دورك التالي"
Dialogue: 0,0:26:54.27,0:27:00.89,On Top,,0000,0000,0000,,"وا كا تّ إي رو نا تسو غي وا أومايي نو با ن دا"
Dialogue: 0,0:27:00.89,0:27:01.73,Default,,0000,0000,0000,,هكذا
Dialogue: 0,0:27:01.73,0:27:03.56,Default,,0000,0000,0000,,!مذهل يا كونان-كن
Dialogue: 0,0:27:03.56,0:27:06.43,Default,,0000,0000,0000,,!ماذا تقول القطعة الموسيقية الأخرى إذاً؟
Dialogue: 0,0:27:06.43,0:27:08.06,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:27:08.06,0:27:12.11,Default,,0000,0000,0000,,"غضب نار الجحيم مُطفأ"
Dialogue: 0,0:27:12.84,0:27:15.81,Default,,0000,0000,0000,,...غضب نار الجحيم؟! أيمكن
Dialogue: 0,0:27:16.25,0:27:20.49,Default,,0000,0000,0000,,عازف البيانو الذي انتحر في حريق قبل 12 عاماً؟
Dialogue: 0,0:27:23.83,0:27:27.99,Default,,0000,0000,0000,,!إنّه هو! أسو كيجي حيّ
Dialogue: 0,0:27:27.99,0:27:30.23,Default,,0000,0000,0000,,ليس هو
Dialogue: 0,0:27:30.23,0:27:34.07,Default,,0000,0000,0000,,آثار العظام التي وجدناها في الرماد\Nوافقت سجّل أسنانه
Dialogue: 0,0:27:34.07,0:27:35.64,Default,,0000,0000,0000,,لا شكّ أنه ميت
Dialogue: 0,0:27:36.44,0:27:39.48,Default,,0000,0000,0000,,كان كلّ شيء محروقاً تماماً
Dialogue: 0,0:27:39.48,0:27:43.60,Default,,0000,0000,0000,,ما تبقى كانت قطعةً موسيقية في خزنة \Nمضادة للحرائق فقط
Dialogue: 0,0:27:43.60,0:27:45.06,Default,,0000,0000,0000,,!قطعة موسيقية؟
Dialogue: 0,0:27:46.43,0:27:49.14,Default,,0000,0000,0000,,!أين هي؟ أين تلك القطعة الموسيقية؟
Dialogue: 0,0:27:49.14,0:27:51.34,Default,,0000,0000,0000,,في مخزن المركز الاجتماعي
Dialogue: 0,0:27:51.34,0:27:54.01,Default,,0000,0000,0000,,...لكن مفتاح المخزن في المحطة
Dialogue: 0,0:27:54.01,0:27:56.10,Default,,0000,0000,0000,,!اذهب واجلبه إذاً
Dialogue: 0,0:27:56.34,0:27:57.68,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:27:58.17,0:28:00.45,Default,,0000,0000,0000,,!انتظر أيّها الضابط! سأرافقك
Dialogue: 0,0:28:00.45,0:28:01.51,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:28:03.83,0:28:08.06,Default,,0000,0000,0000,,أخبرني، هل أحرق أسو-سان منزله حقاً؟
Dialogue: 0,0:28:08.29,0:28:12.15,Default,,0000,0000,0000,,أجل، كان هناك أربعة شهود
Dialogue: 0,0:28:12.15,0:28:14.07,Default,,0000,0000,0000,,العمدة السابق كامياما-سان
Dialogue: 0,0:28:14.07,0:28:18.35,Default,,0000,0000,0000,,والعمدة كوريوا ونيشيموتو-سان وكاواشيما-سان
Dialogue: 0,0:28:18.35,0:28:20.10,Default,,0000,0000,0000,,أكانت هناك صلة بينهم؟
Dialogue: 0,0:28:20.10,0:28:23.56,Default,,0000,0000,0000,,كانوا زملاء دراسة جميعاً، بالإضافة لأسو-سان
Dialogue: 0,0:28:24.60,0:28:27.14,Default,,0000,0000,0000,,ماذا عن موراساوا ذاك إذاً؟
Dialogue: 0,0:28:27.39,0:28:32.47,Default,,0000,0000,0000,,ظهر على تلك الجزيرة قبل 3 أعوام
Dialogue: 0,0:28:32.47,0:28:36.26,Default,,0000,0000,0000,,خطب ابنة العمدة ريكو-سان قبل فترة قصيرة
Dialogue: 0,0:28:36.26,0:28:38.06,Default,,0000,0000,0000,,مع أنّ العمدة عارض ذلك
Dialogue: 0,0:28:38.63,0:28:41.01,Default,,0000,0000,0000,,ماذا عن سكرتير العمدة، هيراتا؟
Dialogue: 0,0:28:41.46,0:28:43.75,Default,,0000,0000,0000,,ذاك الشخص مثير للشبهة
Dialogue: 0,0:28:43.75,0:28:45.79,Default,,0000,0000,0000,,لا أعرف ما قصته بالضبط
Dialogue: 0,0:28:45.79,0:28:48.08,Default,,0000,0000,0000,,لكنه كان يتسلل مع كاواشيما-سان
Dialogue: 0,0:28:48.08,0:28:49.69,Default,,0000,0000,0000,,في المركز الاجتماعي دوماً
Dialogue: 0,0:28:50.16,0:28:51.89,Default,,0000,0000,0000,,ماذا عن شيميزو؟
Dialogue: 0,0:28:52.32,0:28:55.70,Default,,0000,0000,0000,,لديه حسّ قوي بالعدالة، ويملك شعبية\Nكبيرة بين الصيادين
Dialogue: 0,0:28:59.99,0:29:02.81,Default,,0000,0000,0000,,هل انتهت أسئلتك يا أكيتشي-كن؟
Dialogue: 0,0:29:05.64,0:29:08.60,Default,,0000,0000,0000,,!ماذا؟ هذا غريب
Dialogue: 0,0:29:08.60,0:29:11.55,Default,,0000,0000,0000,,...كان هنا حتماً
Dialogue: 0,0:29:11.55,0:29:15.52,Default,,0000,0000,0000,,يا إلهي، مضت ساعة وأنت تبحث
Dialogue: 0,0:29:16.93,0:29:19.98,Default,,0000,0000,0000,,!ها هو! إنّه هذا المفتاح
Dialogue: 0,0:29:21.00,0:29:22.33,Default,,0000,0000,0000,,!أيّها الضابط
Dialogue: 0,0:29:22.33,0:29:23.96,Default,,0000,0000,0000,,ران-نيتشان
Dialogue: 0,0:29:23.96,0:29:25.17,Default,,0000,0000,0000,,!تأخّرتما
Dialogue: 0,0:29:25.17,0:29:27.02,Default,,0000,0000,0000,,سئم الجميع من الانتظار وغادروا
Dialogue: 0,0:29:27.62,0:29:29.44,Default,,0000,0000,0000,,!غادر كلّ المشتبه بهم؟
Dialogue: 0,0:29:29.96,0:29:30.95,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:29:30.95,0:29:36.03,Default,,0000,0000,0000,,قالت رسالة القاتل الأخيرة أنّ \Nغضب نار الجحيم قد انطفأ
Dialogue: 0,0:29:36.03,0:29:38.39,Default,,0000,0000,0000,,لذا ظنّوا أنه لن تقع المزيد من الجرائم
Dialogue: 0,0:29:38.39,0:29:39.91,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:29:39.91,0:29:42.15,Default,,0000,0000,0000,,عُزفت أول حركتين فقط لضوء القمر
Dialogue: 0,0:29:42.15,0:29:45.15,Default,,0000,0000,0000,,!في مسرح كلّ جريمة حتى الآن
Dialogue: 0,0:29:45.15,0:29:48.31,Default,,0000,0000,0000,,!تبقى لضوء القمر حركة أخيرة
Dialogue: 0,0:29:48.65,0:29:50.80,Default,,0000,0000,0000,,!سأذهب لتفقد المركز الاجتماعي
Dialogue: 0,0:29:52.14,0:29:54.89,Default,,0000,0000,0000,,!انتظر! كونان-كن
Dialogue: 0,0:29:57.80,0:30:00.17,Default,,0000,0000,0000,,يا لفضولك يا كونان-كن
Dialogue: 0,0:30:00.17,0:30:01.67,Default,,0000,0000,0000,,!أسرع وافتحه
Dialogue: 0,0:30:01.67,0:30:02.64,Default,,0000,0000,0000,,انتظر قليلاً
Dialogue: 0,0:30:05.38,0:30:07.81,Default,,0000,0000,0000,,ألم تسمعا صوتاً غريباً من غرفة البيانو؟
Dialogue: 0,0:30:08.83,0:30:09.77,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:30:11.39,0:30:12.01,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:30:16.28,0:30:17.43,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:30:20.98,0:30:23.81,Default,,0000,0000,0000,,!موراساوا-سان
Dialogue: 0,0:30:23.81,0:30:24.72,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:30:25.02,0:30:25.60,Default,,0000,0000,0000,,!المخزن
Dialogue: 0,0:30:30.26,0:30:31.30,Default,,0000,0000,0000,,نيشيموتو-سان
Dialogue: 0,0:30:31.89,0:30:34.60,Default,,0000,0000,0000,,!حضرة الضابط، اتّصل بالمفتش ميغوري
Dialogue: 0,0:30:34.60,0:30:35.27,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:30:39.39,0:30:41.18,Default,,0000,0000,0000,,هل عُزفت الحركة الثالثة؟
Dialogue: 0,0:30:41.75,0:30:43.67,Default,,0000,0000,0000,,توجد 30 دقيقة لكلّ جانب لهذا الشريط
Dialogue: 0,0:30:43.67,0:30:47.18,Default,,0000,0000,0000,,مما يعني أنّ نيشيموتو-سان مات\Nخلال النصف ساعة الماضية
Dialogue: 0,0:30:47.63,0:30:48.67,Default,,0000,0000,0000,,!انظر يا كونان-كن
Dialogue: 0,0:30:48.67,0:30:51.10,Default,,0000,0000,0000,,!توجد قطعة موسيقية أخرى عند أقدام نيشيموتو-سان
Dialogue: 0,0:30:56.37,0:30:58.16,Default,,0000,0000,0000,,ما تقول هذه المرة؟
Dialogue: 0,0:30:58.16,0:30:59.10,Default,,0000,0000,0000,,"وصيّة"
Dialogue: 0,0:30:59.49,0:31:01.23,Default,,0000,0000,0000,,وصيّته؟
Dialogue: 0,0:31:01.23,0:31:02.13,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:31:03.65,0:31:05.27,Default,,0000,0000,0000,,كان انتحاراً؟
Dialogue: 0,0:31:05.65,0:31:06.98,Default,,0000,0000,0000,,،وفقاً للوصيّة
Dialogue: 0,0:31:06.98,0:31:10.47,Default,,0000,0000,0000,,فقد شعر بالندم على قتل السيّد كاواشيما\Nوالسيّد كوريوا
Dialogue: 0,0:31:10.47,0:31:11.64,Default,,0000,0000,0000,,!نيشيموتو من قتلهما؟
Dialogue: 0,0:31:12.14,0:31:17.51,Default,,0000,0000,0000,,يبدو أنّه لم يرد أن يُكشف خطأ\Nقديم ارتكبوه
Dialogue: 0,0:31:17.51,0:31:20.80,Default,,0000,0000,0000,,والمشار لهم هم السيّد كامياما الذي مات قبل عامين
Dialogue: 0,0:31:20.80,0:31:23.75,Default,,0000,0000,0000,,والسيّد كاواشيما والسيّد كوريوا اللذان ماتا مؤخراً
Dialogue: 0,0:31:23.75,0:31:25.75,Default,,0000,0000,0000,,والسيّد نيشيموتو الذي شنق نفسه
Dialogue: 0,0:31:25.75,0:31:28.64,Default,,0000,0000,0000,,وأخيراً السيّد أسو الذي انتحر قبل 12 عاماً
Dialogue: 0,0:31:28.92,0:31:30.72,Default,,0000,0000,0000,,عازف البيانو أيضاً؟
Dialogue: 0,0:31:31.08,0:31:34.99,Default,,0000,0000,0000,,أتوقع أنّهم قاموا بشيء باستعمال هذه الشفرة
Dialogue: 0,0:31:34.99,0:31:39.45,Default,,0000,0000,0000,,هكذا إذاً، كان نيشيموتو يخشى\Nفضح سرّهم القديم
Dialogue: 0,0:31:39.45,0:31:42.14,Default,,0000,0000,0000,,فاقتحم المخزن للتخلص من القطعة الموسيقية
Dialogue: 0,0:31:42.65,0:31:45.48,Default,,0000,0000,0000,,،لكن عجزه عن العثور عليها حاصره نفسياً
Dialogue: 0,0:31:45.48,0:31:47.40,Default,,0000,0000,0000,,فقام بالانتحار
Dialogue: 0,0:31:47.40,0:31:48.94,Default,,0000,0000,0000,,لا أظنّه كان انتحاراً
Dialogue: 0,0:31:50.39,0:31:53.51,Default,,0000,0000,0000,,من المُحال أن تشنق نفسك\Nدون ما يسندك تحتك، صحيح؟
Dialogue: 0,0:31:53.81,0:31:56.14,Default,,0000,0000,0000,,ألم تكن أنت من أبعده؟
Dialogue: 0,0:31:56.14,0:31:57.73,Default,,0000,0000,0000,,لم أفعل ذلك
Dialogue: 0,0:31:58.06,0:32:03.18,Default,,0000,0000,0000,,كما أشك أن يكتب أحدهم وصيته باستخدام شفرة
Dialogue: 0,0:32:03.59,0:32:07.13,Default,,0000,0000,0000,,أتقصد أنّ القاتل شخص آخر؟
Dialogue: 0,0:32:07.13,0:32:08.94,Default,,0000,0000,0000,,رأيتُ شخصاً مريباً
Dialogue: 0,0:32:08.94,0:32:09.52,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:32:09.84,0:32:11.62,Default,,0000,0000,0000,,اثنان في غرفة البيانو
Dialogue: 0,0:32:11.62,0:32:13.47,Default,,0000,0000,0000,,أحدهما حطّم النافذة وهرب
Dialogue: 0,0:32:13.83,0:32:15.83,Default,,0000,0000,0000,,بينما الآخر كان موراساوا-نيتشان
Dialogue: 0,0:32:15.83,0:32:17.20,Default,,0000,0000,0000,,ضربه أحدهم
Dialogue: 0,0:32:17.20,0:32:20.97,Default,,0000,0000,0000,,وتعالجه الطبيبة نارومي في غرفة البيانو الآن
Dialogue: 0,0:32:24.03,0:32:25.36,Default,,0000,0000,0000,,!لمَ لم تقل ذلك قبلاً؟
Dialogue: 0,0:32:25.36,0:32:26.73,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:32:27.65,0:32:30.68,Default,,0000,0000,0000,,لم تجد قطعة السيّد أسو الموسيقية بعد؟
Dialogue: 0,0:32:31.35,0:32:35.68,Default,,0000,0000,0000,,حدث ذلك قبل 12 عاماً، من المستحيل\Nأن أتذكر أين وضعناها
Dialogue: 0,0:32:38.27,0:32:40.22,Default,,0000,0000,0000,,لا يزال فاقداً للوعي؟
Dialogue: 0,0:32:40.22,0:32:43.22,Default,,0000,0000,0000,,أجل، أظنّه تلقى ارتجاجاً دماغياً
Dialogue: 0,0:32:43.67,0:32:45.26,Default,,0000,0000,0000,,بالمناسبة يا كوريوا-سان
Dialogue: 0,0:32:45.26,0:32:49.19,Default,,0000,0000,0000,,ما الذي كان يفعله موراساوا-سان هنا\Nفي هذا الوقت المتأخر؟
Dialogue: 0,0:32:49.42,0:32:51.01,Default,,0000,0000,0000,,!كيف لي أن أعرف؟
Dialogue: 0,0:32:54.08,0:32:55.18,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:32:55.18,0:32:57.35,Default,,0000,0000,0000,,!لا تلمس أغراض شويتشي
Dialogue: 0,0:32:57.66,0:32:59.04,Default,,0000,0000,0000,,ما ذاك الشيء؟
Dialogue: 0,0:32:59.04,0:33:02.39,Default,,0000,0000,0000,,!لا أدري! لكنه كان مهماً لشويتشي
Dialogue: 0,0:33:02.99,0:33:07.03,Default,,0000,0000,0000,,إنّها مطرقة تنغيم تُستعمل لضبط البيانو
Dialogue: 0,0:33:07.03,0:33:08.57,Default,,0000,0000,0000,,...أي أنه كان من
Dialogue: 0,0:33:09.48,0:33:13.52,Default,,0000,0000,0000,,حسنٌ، اجلبوا كافة المشتبه بهم لدار البلدية فوراً
Dialogue: 0,0:33:13.52,0:33:14.22,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:33:20.59,0:33:22.09,Default,,0000,0000,0000,,ما الذي تفعله يا كونان-كن؟
Dialogue: 0,0:33:22.09,0:33:23.14,Default,,0000,0000,0000,,سنذهب لدار البلدية
Dialogue: 0,0:33:23.38,0:33:26.05,Default,,0000,0000,0000,,كان الشخص المريب الذي هرب\Nمن هذه الغرفة يبحث
Dialogue: 0,0:33:26.05,0:33:28.10,Default,,0000,0000,0000,,عن شيءٍ أسفل البيانو
Dialogue: 0,0:33:29.59,0:33:31.05,Default,,0000,0000,0000,,!هنا! وجدته
Dialogue: 0,0:33:32.67,0:33:35.88,Default,,0000,0000,0000,,!مُذهل، لوح خفيّ! رائع
Dialogue: 0,0:33:40.11,0:33:41.08,Default,,0000,0000,0000,,!مخدرات
Dialogue: 0,0:33:44.85,0:33:46.43,On Top,,0000,0000,0000,,دار  بلدية جزيرة تسوكيكاغي
Dialogue: 0,0:33:47.24,0:33:49.61,Default,,0000,0000,0000,,بناءً على أساليب الحوادث الثلاثة\N،التي وقعت على هذه الجزيرة
Dialogue: 0,0:33:49.61,0:33:52.39,Default,,0000,0000,0000,,فالفاعل هو نفس الشخص بلا شك
Dialogue: 0,0:33:52.60,0:33:56.35,Default,,0000,0000,0000,,للطبيبة نارومي وكوريوا ريكو-سان حجّتا غياب مؤكدتان
Dialogue: 0,0:33:56.35,0:33:58.10,Default,,0000,0000,0000,,فخرجا عن لائحة المشتبه بهم
Dialogue: 0,0:33:58.10,0:34:01.01,Default,,0000,0000,0000,,لكن لا حجّة غياب هناك للسكرتير هيراتا-سان
Dialogue: 0,0:34:01.01,0:34:03.72,Default,,0000,0000,0000,,والمرشح للعمدة شيميزو-سان
Dialogue: 0,0:34:03.72,0:34:07.34,Default,,0000,0000,0000,,ولا لموراساوا-سان الذي يرقد في عيادة حالياً
Dialogue: 0,0:34:07.34,0:34:09.69,Default,,0000,0000,0000,,!القاتل أحد هؤلاء الثلاثة
Dialogue: 0,0:34:10.50,0:34:12.79,Default,,0000,0000,0000,,طبيبة نارومي، لا يزال موراساوا-سان فاقداً للوعي؟
Dialogue: 0,0:34:12.79,0:34:16.83,Default,,0000,0000,0000,,أجل، ريكو-سان تعتني به لكنه\Nلم يستعد وعيه بعد
Dialogue: 0,0:34:16.83,0:34:21.32,Default,,0000,0000,0000,,هناك شيءٌ يضايقني، لكن ما هو؟
Dialogue: 0,0:34:21.32,0:34:26.98,Default,,0000,0000,0000,,...مُذ رأيت شفرة الدم في مسرح الجريمة
Dialogue: 0,0:34:27.53,0:34:28.28,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:34:28.28,0:34:31.19,Default,,0000,0000,0000,,صور مسرح جريمة قتل السيّد كوريوا جاهزة
Dialogue: 0,0:34:31.19,0:34:33.76,Default,,0000,0000,0000,,حسنٌ، ضعها على تلك الطاولة
Dialogue: 0,0:34:33.76,0:34:34.43,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:34:39.48,0:34:43.10,Default,,0000,0000,0000,,ما هذا الضوء عند عنق السيّد كوريوا؟
Dialogue: 0,0:34:43.10,0:34:45.77,Default,,0000,0000,0000,,ليس موجوداً في الصورة بعد تحريكه
Dialogue: 0,0:34:46.39,0:34:50.97,Default,,0000,0000,0000,,أيمكنني الذهاب لشراء عصير؟ أشعر بالعطش
Dialogue: 0,0:34:51.96,0:34:53.43,Default,,0000,0000,0000,,لا مشكلة
Dialogue: 0,0:34:54.21,0:34:55.29,Default,,0000,0000,0000,,مُصاب؟
Dialogue: 0,0:34:59.95,0:35:01.68,Default,,0000,0000,0000,,يا عمّ
Dialogue: 0,0:35:01.68,0:35:04.14,Default,,0000,0000,0000,,يوجد مسحوق أبيض على كمّيك
Dialogue: 0,0:35:04.14,0:35:06.24,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:35:07.16,0:35:09.56,Default,,0000,0000,0000,,!نقود كثيرة من كلّ أرجاء العالم
Dialogue: 0,0:35:10.15,0:35:12.94,Default,,0000,0000,0000,,أُحب البلدان الأجنبية
Dialogue: 0,0:35:16.27,0:35:17.02,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:35:21.14,0:35:23.01,Default,,0000,0000,0000,,ما الخطب أيّها الشرطي؟
Dialogue: 0,0:35:23.01,0:35:27.02,Default,,0000,0000,0000,,وجدتُ أخيراً القطعة الموسيقية \N!التي تركها أسو-سان
Dialogue: 0,0:35:27.47,0:35:28.44,Default,,0000,0000,0000,,!دعني أرى
Dialogue: 0,0:35:30.84,0:35:35.47,On Top,,0000,0000,0000,,"و ا غام وسو كو س ي جي إيه"
Dialogue: 0,0:35:30.84,0:35:35.47,Default,,0000,0000,0000,,"إلى ابني سيجي"
Dialogue: 0,0:35:35.84,0:35:37.05,Default,,0000,0000,0000,,ا-ابن؟
Dialogue: 0,0:35:37.05,0:35:43.05,Default,,0000,0000,0000,,...صحيح، كان لأسو سان ابن أيضاً
Dialogue: 0,0:35:43.41,0:35:47.49,Default,,0000,0000,0000,,أصابه مرض شديد في صغره وتمّ إسعافه للمشفى
Dialogue: 0,0:35:47.49,0:35:50.93,Default,,0000,0000,0000,,أظنّ اسمه كان سيجي
Dialogue: 0,0:35:51.15,0:35:52.57,Default,,0000,0000,0000,,!سيجي؟
Dialogue: 0,0:35:52.57,0:35:54.10,Default,,0000,0000,0000,,...لا-لا يمكن
Dialogue: 0,0:36:00.35,0:36:03.64,Default,,0000,0000,0000,,!أنت! انتظر أيّها الصبي! أين تذهب؟
Dialogue: 0,0:36:09.22,0:36:12.10,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:36:12.46,0:36:14.59,Default,,0000,0000,0000,,سبب استدراج القاتل كاواشيما-سان لغرفة البيانو
Dialogue: 0,0:36:14.59,0:36:16.93,Default,,0000,0000,0000,,!بعد إغراقه له
Dialogue: 0,0:36:16.93,0:36:19.39,Default,,0000,0000,0000,,ومعنى المعزوفة التي شُغلت في مسارح الجريمة
Dialogue: 0,0:36:19.39,0:36:22.10,Default,,0000,0000,0000,,ولغز الشفرة المكتوبة بالدم
Dialogue: 0,0:36:23.33,0:36:26.96,Default,,0000,0000,0000,,!لا شكّ في الأمر، ذاك الشخص هو المجرم
Dialogue: 0,0:36:32.32,0:36:34.89,Default,,0000,0000,0000,,تلقّى العم موري رسالةً من رجل مُتوفى
Dialogue: 0,0:36:34.89,0:36:37.06,Default,,0000,0000,0000,,وتوجه لجزيرة تسوكيكاغي
Dialogue: 0,0:36:37.06,0:36:40.72,Default,,0000,0000,0000,,كان المُرسل أسو كيجي، عازف بيانو قتل عائلته
Dialogue: 0,0:36:40.72,0:36:45.22,Default,,0000,0000,0000,,وأحرق منزله ومات وهو يعزف سوناتا بيانو ضوء القمر
Dialogue: 0,0:36:45.64,0:36:48.48,Default,,0000,0000,0000,,وقعت أوّل جريمة في ليلة ذكرى العمدة السابق
Dialogue: 0,0:36:48.48,0:36:50.47,Default,,0000,0000,0000,,السيّد كامياما
Dialogue: 0,0:36:50.47,0:36:52.76,Default,,0000,0000,0000,,وُجد كاواشيما هيديو ميتاً في غرفة البيانو
Dialogue: 0,0:36:52.76,0:36:55.60,Default,,0000,0000,0000,,مع تسجيل عزف الحركة الأولى لضوء القمر
Dialogue: 0,0:36:56.01,0:36:59.56,Default,,0000,0000,0000,,ووقعت الجريمة الثانية مع تسجيل الحركة الثانية
Dialogue: 0,0:36:59.96,0:37:02.58,Default,,0000,0000,0000,,كان الضحية العمدة الحالي كوريوا تاتسوجي
Dialogue: 0,0:37:02.58,0:37:04.83,Default,,0000,0000,0000,,وتقلّص عدد المشتبه بهم إلى ستّة أشخاص
Dialogue: 0,0:37:05.01,0:37:08.00,Default,,0000,0000,0000,,وضحيّة الجريمة الثالثة كان نيشيموتو كين
Dialogue: 0,0:37:08.00,0:37:10.14,Default,,0000,0000,0000,,الذي قُتل بأسلوب يجعله يبدو انتحاراً
Dialogue: 0,0:37:11.91,0:37:16.10,Default,,0000,0000,0000,,"إلى ابني سيجي"
Dialogue: 0,0:37:16.90,0:37:18.73,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:37:19.36,0:37:21.48,Default,,0000,0000,0000,,سبب استدراج القاتل لكاواشيما-سان لغرفة البيانو
Dialogue: 0,0:37:21.48,0:37:23.64,Default,,0000,0000,0000,,!بعد إغراقه له
Dialogue: 0,0:37:24.02,0:37:26.35,Default,,0000,0000,0000,,ومعنى المعزوفة التي شُغلت في مسارح الجريمة
Dialogue: 0,0:37:26.60,0:37:29.16,Default,,0000,0000,0000,,ولغز الشفرة المكتوبة بالدم
Dialogue: 0,0:37:30.51,0:37:34.34,Default,,0000,0000,0000,,!لا شكّ في الأمر، ذاك الشخص هو المجرم
Dialogue: 0,0:37:36.76,0:37:41.01,Default,,0000,0000,0000,,يا إلهي، لمَ ركضت لغرفة البثّ هكذا فجأةً؟
Dialogue: 0,0:37:41.01,0:37:43.00,Default,,0000,0000,0000,,!أيوجد شيء هنا؟
Dialogue: 0,0:37:43.00,0:37:44.76,Default,,0000,0000,0000,,كلا، ليس تماماً
Dialogue: 0,0:37:45.12,0:37:49.39,Default,,0000,0000,0000,,لا خيار لديّ، عليّ استعمال صوت العمّ وحلّ القضية
Dialogue: 0,0:37:49.39,0:37:51.34,Default,,0000,0000,0000,,بطلقة واحدة من مسدّس الساعة المخدّر
Dialogue: 0,0:37:53.64,0:37:57.82,Default,,0000,0000,0000,,سيرافقنا هيراتا-سان وشيميزو-سان لليابسة
Dialogue: 0,0:37:57.82,0:37:58.77,Default,,0000,0000,0000,,صباح الغد
Dialogue: 0,0:37:58.77,0:38:00.39,Default,,0000,0000,0000,,!لـ-لكن
Dialogue: 0,0:38:00.60,0:38:03.56,Default,,0000,0000,0000,,الحادثة الأولى حيث أُغرق السيّد كاواشيما
Dialogue: 0,0:38:03.56,0:38:07.23,Default,,0000,0000,0000,,وسُحبت جثته لغرفة بيانو المركز الاجتماعي ليلة الأمس
Dialogue: 0,0:38:07.23,0:38:09.68,Default,,0000,0000,0000,,والحادثة الثانية حيث قُتل السيّد كوريوا
Dialogue: 0,0:38:09.68,0:38:12.64,Default,,0000,0000,0000,,في غرفة البثّ هذه الليلة
Dialogue: 0,0:38:12.64,0:38:15.68,Default,,0000,0000,0000,,والحادثة الثالثة التي وقعت الليلة نفسها
Dialogue: 0,0:38:15.68,0:38:17.47,Default,,0000,0000,0000,,حيث قُتل السيّد نيشيموتو في المخزن
Dialogue: 0,0:38:17.47,0:38:19.35,Default,,0000,0000,0000,,بأسلوب يجعله يبدو انتحاراً
Dialogue: 0,0:38:20.00,0:38:23.33,Default,,0000,0000,0000,,أنتما الوحيدان اللذان لا يملكان\Nحجّة غياب لهذه الحوادث الثلاث
Dialogue: 0,0:38:23.33,0:38:26.68,Default,,0000,0000,0000,,بالإضافة لموراساوا-سان الذي يرقد في العيادة
Dialogue: 0,0:38:27.54,0:38:30.66,Default,,0000,0000,0000,,يؤسفني فعل ذلك، لكن علينا حراستكم اليوم
Dialogue: 0,0:38:30.66,0:38:33.66,Default,,0000,0000,0000,,!حللتُ الأمر سيّدي المفتش
Dialogue: 0,0:38:33.66,0:38:36.74,Default,,0000,0000,0000,,كلّ ما يحيط بجرائم القتل على هذه الجزيرة
Dialogue: 0,0:38:36.74,0:38:38.77,Default,,0000,0000,0000,,أبي! أنت في غرفة البثّ؟
Dialogue: 0,0:38:38.77,0:38:43.27,Default,,0000,0000,0000,,بدايةً، الشخص الذي أفقد موراساوا-سان\Nوعيه في غرفة البيانو
Dialogue: 0,0:38:43.27,0:38:46.89,Default,,0000,0000,0000,,ذاك أنت يا هيراتا-سان
Dialogue: 0,0:38:47.15,0:38:48.27,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:38:48.27,0:38:50.60,Default,,0000,0000,0000,,أُصيبت يد هيراتا-سان اليسرى
Dialogue: 0,0:38:50.60,0:38:53.47,Default,,0000,0000,0000,,عندما حطّم النافذة وهرب
Dialogue: 0,0:38:53.47,0:38:56.51,Default,,0000,0000,0000,,كنتَ الشخص المشبوه الذي رأيناه ليلة الأمس أيضاً
Dialogue: 0,0:38:56.51,0:38:58.39,Default,,0000,0000,0000,,لكن ما الذي كان يفعله؟
Dialogue: 0,0:38:58.64,0:39:03.04,Default,,0000,0000,0000,,كان يعقد صفقات مع السيّد كاواشيما في تلك الغرفة
Dialogue: 0,0:39:03.04,0:39:03.97,Default,,0000,0000,0000,,صفقات مخدرات
Dialogue: 0,0:39:04.21,0:39:05.52,Default,,0000,0000,0000,,!مـ-مخدرات؟
Dialogue: 0,0:39:06.09,0:39:08.75,Default,,0000,0000,0000,,استعمل هيراتا-سان لوحاً مخفياً في البيانو
Dialogue: 0,0:39:08.75,0:39:13.93,Default,,0000,0000,0000,,للمتاجرة بمخدرات اشتراها خارج البلاد\Nمقابل كمية كبيرة من النقود
Dialogue: 0,0:39:13.93,0:39:19.72,Default,,0000,0000,0000,,!هكذا إذاً! لذا كانا في المركز الاجتماعي كلّ ليلة
Dialogue: 0,0:39:20.15,0:39:24.23,Default,,0000,0000,0000,,سبب ادّعاء هيراتا-سان الدائم أنّ البيانو ملعون
Dialogue: 0,0:39:24.23,0:39:26.93,Default,,0000,0000,0000,,هو لإبعاد الناس من طريق صفقاته
Dialogue: 0,0:39:27.23,0:39:29.27,Default,,0000,0000,0000,,اعتدى على موراساوا-سان وهرب
Dialogue: 0,0:39:29.27,0:39:33.60,Default,,0000,0000,0000,,لأنّه رآه يأخذ المخدرات التي تركها هناك غالباً
Dialogue: 0,0:39:33.60,0:39:34.88,Default,,0000,0000,0000,,أي أنّك قتلت السيّد كاواشيما
Dialogue: 0,0:39:34.88,0:39:37.85,Default,,0000,0000,0000,,!لأنّكما تشاجرتما بشأن الصفقات؟
Dialogue: 0,0:39:37.85,0:39:38.89,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:39:38.89,0:39:42.35,Default,,0000,0000,0000,,لا علاقة لهيراتا-سان بالجرائم الثلاث
Dialogue: 0,0:39:42.92,0:39:47.00,Default,,0000,0000,0000,,لو كان القاتل، فلم يكن ليرتكب جرائمه في غرفة البيانو
Dialogue: 0,0:39:47.00,0:39:50.15,Default,,0000,0000,0000,,فهي الغرفة التي خزّن المخدرات فيها
Dialogue: 0,0:39:51.30,0:39:53.54,Default,,0000,0000,0000,,التالي هو موراساوا-سان
Dialogue: 0,0:39:53.54,0:39:55.33,Default,,0000,0000,0000,,!هو القاتل؟
Dialogue: 0,0:39:55.33,0:39:57.21,Default,,0000,0000,0000,,ليس القاتل أيضاً
Dialogue: 0,0:39:57.38,0:39:58.42,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:39:58.83,0:40:02.19,Default,,0000,0000,0000,,سبب كتابة القاتل وصيّةً لجعل الأمر يبدو انتحاراً
Dialogue: 0,0:40:02.19,0:40:04.15,Default,,0000,0000,0000,,وعدم وضعه لمسند أقدام في الغرفة
Dialogue: 0,0:40:04.15,0:40:06.61,Default,,0000,0000,0000,,هو هلعه عندما أتت ران والبقية ولوذه بالفرار
Dialogue: 0,0:40:06.61,0:40:09.35,Default,,0000,0000,0000,,سيكون من المستحيل دخول غرفة البيانو بعدها
Dialogue: 0,0:40:09.35,0:40:11.09,Default,,0000,0000,0000,,مـ-معك حق
Dialogue: 0,0:40:11.52,0:40:13.97,Default,,0000,0000,0000,,حتّى الآن، صورتنا عن القاتل هي رجل
Dialogue: 0,0:40:13.97,0:40:17.31,Default,,0000,0000,0000,,لأنّ الجرائم الثلاث تطلبت قوّةً بدنية
Dialogue: 0,0:40:17.31,0:40:19.80,Default,,0000,0000,0000,,كما شخص دون حجّة غياب
Dialogue: 0,0:40:20.42,0:40:23.26,Default,,0000,0000,0000,,المشتبه الوحيد المتبقي هو شيميزو-سان
Dialogue: 0,0:40:23.51,0:40:26.22,Default,,0000,0000,0000,,الآن علينا إمعان النظر في الجريمة الثانية
Dialogue: 0,0:40:26.84,0:40:31.20,Default,,0000,0000,0000,,افترضنا أنّ كوريوا-سان قُتل قبيل\Nدقائق من العثور على جثته
Dialogue: 0,0:40:31.20,0:40:33.29,Default,,0000,0000,0000,,...لكن تذكروا
Dialogue: 0,0:40:33.29,0:40:38.80,Default,,0000,0000,0000,,لم تزل شفرة الدم عندما سقط كونان عليها آنذاك
Dialogue: 0,0:40:40.28,0:40:45.44,Default,,0000,0000,0000,,يستغرق دم الإنسان 15 إلى 30 دقيقة\Nليجفّ في درجة حرارة الغرفة
Dialogue: 0,0:40:45.44,0:40:48.69,Default,,0000,0000,0000,,لكن كان ذاك الدم جافاً
Dialogue: 0,0:40:48.94,0:40:51.64,Default,,0000,0000,0000,,رغم أنّه قُتل قبيل دقائق افتراضياً
Dialogue: 0,0:40:51.93,0:40:58.60,Default,,0000,0000,0000,,صحيح، كانت حيلة استعملها المجرم\Nللتلاعب بوقت الوفاة المقدر
Dialogue: 0,0:40:58.60,0:41:00.51,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:41:00.51,0:41:04.56,Default,,0000,0000,0000,,لكن كانت أوّل خمس دقائق ونصف\Nهي الفارغة فقط في التسجيل
Dialogue: 0,0:41:04.84,0:41:06.34,Default,,0000,0000,0000,,قلب الشريط الآلي
Dialogue: 0,0:41:06.34,0:41:09.54,Default,,0000,0000,0000,,شغّل القاتل الجانب الثاني للشريط\Nالذي لم يحتو عزفاً
Dialogue: 0,0:41:09.54,0:41:13.51,Default,,0000,0000,0000,,وحصل على 30 دقيقة إضافية باستعمال القلب الآلي
Dialogue: 0,0:41:13.51,0:41:15.60,Default,,0000,0000,0000,,انظروا للصور رجاءً
Dialogue: 0,0:41:15.60,0:41:18.83,Default,,0000,0000,0000,,يوجد مفتاح مُضاء قرب عنق كوريوا-سان
Dialogue: 0,0:41:18.83,0:41:22.05,Default,,0000,0000,0000,,لكن الضوء اختفى بعدما حُركت جثته
Dialogue: 0,0:41:22.05,0:41:27.11,Default,,0000,0000,0000,,هذا دليل على أنّ القاتل أطفأه\Nبعيداً عن أنظار الشرطة
Dialogue: 0,0:41:27.11,0:41:30.26,Default,,0000,0000,0000,,...لكن وفقما أتذكر، من اقترب من الجثة آنذاك
Dialogue: 0,0:41:30.48,0:41:31.77,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:41:31.77,0:41:34.14,Default,,0000,0000,0000,,الشخص الوحيد الذي اقترب من الجثّة مع الشرطة
Dialogue: 0,0:41:34.14,0:41:36.48,Default,,0000,0000,0000,,ومن زيّف وقت الوفاة المقدر
Dialogue: 0,0:41:36.48,0:41:38.19,Default,,0000,0000,0000,,...هو من فحص الجثة
Dialogue: 0,0:41:38.88,0:41:41.39,Default,,0000,0000,0000,,!أنت أيّتها الطبيبة نارومي
Dialogue: 0,0:41:44.01,0:41:46.68,Default,,0000,0000,0000,,!هذا ليس صحيحاً، أليس كذلك أيّتها الطبيبة نارومي؟
Dialogue: 0,0:41:47.01,0:41:52.58,Default,,0000,0000,0000,,أغرقتِ كاواشيما-سان وسحبته لغرفة البيانو
Dialogue: 0,0:41:52.58,0:41:54.79,Default,,0000,0000,0000,,لإعادة محقّقي الوفاة لليابسة
Dialogue: 0,0:41:54.79,0:41:58.25,Default,,0000,0000,0000,,بما أنّهم لن يتمكنوا من تحليل موت غير طبيعي هنا
Dialogue: 0,0:41:58.25,0:42:01.95,Default,,0000,0000,0000,,وسبب وضعك للمساحة الفارغة في بداية كلّ تسجيل
Dialogue: 0,0:42:01.95,0:42:06.32,Default,,0000,0000,0000,,هو كي تستطيعي تضليلنا بتزييف وقت الجريمة الثانية
Dialogue: 0,0:42:06.32,0:42:10.44,Default,,0000,0000,0000,,وهكذا، تلاعبتِ بوقت موت كوريوا-سان
Dialogue: 0,0:42:10.44,0:42:12.60,Default,,0000,0000,0000,,وصنعتِ حجّة غياب لنفسك
Dialogue: 0,0:42:12.94,0:42:17.31,Default,,0000,0000,0000,,!لكن يا موري-كن، قلتَ أن المجرم رجل
Dialogue: 0,0:42:17.31,0:42:20.18,Default,,0000,0000,0000,,دافع الجرائم يعود لاثني عشر عاماً مضى
Dialogue: 0,0:42:20.18,0:42:21.80,Default,,0000,0000,0000,,أتسمعني؟
Dialogue: 0,0:42:22.09,0:42:26.02,Default,,0000,0000,0000,,لحادثة مقتل عازف البيانو أسو كيجي وعائلته
Dialogue: 0,0:42:26.30,0:42:27.85,Default,,0000,0000,0000,,!مقتل؟
Dialogue: 0,0:42:28.18,0:42:31.00,Default,,0000,0000,0000,,كاواشيما-سان ونيشيموتو-سان وكوريوا-سان
Dialogue: 0,0:42:31.00,0:42:33.81,Default,,0000,0000,0000,,والعمدة السابق كامياما-سان
Dialogue: 0,0:42:33.81,0:42:35.92,Default,,0000,0000,0000,,استغلوا عروض عزف أسو-سان العالمية
Dialogue: 0,0:42:35.92,0:42:39.23,Default,,0000,0000,0000,,كفرصة للمتاجرة بالمخدرات
Dialogue: 0,0:42:39.23,0:42:43.10,Default,,0000,0000,0000,,لكن قال أسو-سان عندها أنّه لن يتعاون معهم مجدداً
Dialogue: 0,0:42:43.74,0:42:46.37,Default,,0000,0000,0000,,خشيةً من فضح سرّهم
Dialogue: 0,0:42:46.37,0:42:50.06,Default,,0000,0000,0000,,أغلقوا عليه وعائلته في منزلهم وأحرقوه
Dialogue: 0,0:42:52.48,0:42:57.36,Default,,0000,0000,0000,,كلّ هذا مكتوب في القطعة الموسيقية التي نجت من النار
Dialogue: 0,0:42:57.36,0:43:00.93,Default,,0000,0000,0000,,في رسالة الاعتراف التي كتبها أسو-سان لطفله
Dialogue: 0,0:43:01.39,0:43:02.39,Default,,0000,0000,0000,,!ابنه؟
Dialogue: 0,0:43:02.68,0:43:07.14,Default,,0000,0000,0000,,كان لديه ابن في مشفى في طوكيو
Dialogue: 0,0:43:07.14,0:43:08.44,Default,,0000,0000,0000,,اسمه سيجي
Dialogue: 0,0:43:09.01,0:43:11.39,Default,,0000,0000,0000,,...سيجي؟ أيمكن
Dialogue: 0,0:43:12.00,0:43:15.17,Default,,0000,0000,0000,,اسم الطبيبة نارومي الحقيقي هو سيجي
Dialogue: 0,0:43:15.17,0:43:18.85,Default,,0000,0000,0000,,!كانت ابن أسو كيجي، أسو سيجي
Dialogue: 0,0:43:18.85,0:43:21.05,Default,,0000,0000,0000,,!مـ-محال
Dialogue: 0,0:43:21.33,0:43:25.22,Default,,0000,0000,0000,,أساي هو اسم عائلته المتبناة غالباً
Dialogue: 0,0:43:26.16,0:43:30.01,Default,,0000,0000,0000,,كان كلّ هذا انتقاماً لأبيه إذاً
Dialogue: 0,0:43:30.57,0:43:32.39,Default,,0000,0000,0000,,!سيدي المفتش! اختفى المجرم
Dialogue: 0,0:43:32.39,0:43:33.11,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:43:33.45,0:43:34.62,Default,,0000,0000,0000,,!ابحثوا عنه
Dialogue: 0,0:43:35.94,0:43:36.82,Default,,0000,0000,0000,,أعرف أين هو
Dialogue: 0,0:43:36.82,0:43:40.35,Default,,0000,0000,0000,,المكان الذي يوجد فيه البيانو الذي\Nتبرع به أسو كيجي، المركز الاجتماعي
Dialogue: 0,0:43:48.62,0:43:51.50,Default,,0000,0000,0000,,انتهى الأمر يا أبي
Dialogue: 0,0:43:53.39,0:43:55.00,Default,,0000,0000,0000,,!لم ينته بعد
Dialogue: 0,0:43:55.00,0:43:56.60,Default,,0000,0000,0000,,!عليك إلقاء نظرة هنا
Dialogue: 0,0:43:57.68,0:44:00.91,Default,,0000,0000,0000,,هناك رسالة لك في القطعة الموسيقية التي تركها والدك
Dialogue: 0,0:44:01.24,0:44:04.39,Default,,0000,0000,0000,,!يقول أنّه يريد منك عيش حياة صالحة
Dialogue: 0,0:44:05.04,0:44:07.56,Default,,0000,0000,0000,,أتمنى لو عرفت ذلك أبكر
Dialogue: 0,0:44:08.12,0:44:12.18,Default,,0000,0000,0000,,لم تقرأها؟ كيف عرفت ما حلّ بأبيك إذاً؟
Dialogue: 0,0:44:12.94,0:44:16.82,Default,,0000,0000,0000,,راودتني الشكوك باستمرار بشأن أبي بالتبني
Dialogue: 0,0:44:16.82,0:44:18.32,Default,,0000,0000,0000,,،فبعد تخرجي من كلية الطب
Dialogue: 0,0:44:18.32,0:44:21.01,Default,,0000,0000,0000,,أتيتُ لهذه الجزيرة كطبيبة
Dialogue: 0,0:44:22.31,0:44:26.98,Default,,0000,0000,0000,,فنطق اسمي ليس مكتوباً على رخصتي الطبية
Dialogue: 0,0:44:27.85,0:44:31.17,Default,,0000,0000,0000,,لكني كنت متوتراً عندما بدؤوا الاستجواب
Dialogue: 0,0:44:31.17,0:44:32.93,Default,,0000,0000,0000,,كانوا ليكتشفوا أنّي ذكر
Dialogue: 0,0:44:33.26,0:44:37.34,Default,,0000,0000,0000,,هكذا إذاً، لذا بقيت معنا تلك الليلة
Dialogue: 0,0:44:37.34,0:44:40.39,Default,,0000,0000,0000,,كي تؤجل استجوابك للنهاية
Dialogue: 0,0:44:40.83,0:44:45.70,Default,,0000,0000,0000,,عندما أخبرت العمدة السابق كامياما أنّي ابن أسو
Dialogue: 0,0:44:45.70,0:44:48.63,Default,,0000,0000,0000,,هلع فجأةً وأفصح لي عن كلّ شيء
Dialogue: 0,0:44:48.63,0:44:51.60,Default,,0000,0000,0000,,وفارق الحياة بعدها بنوبة قلبية
Dialogue: 0,0:44:52.65,0:44:57.82,Default,,0000,0000,0000,,،وعندما عزفت مقطوعة أبي المفضلة، ضوء القمر\Nكلحن وداع له
Dialogue: 0,0:44:57.82,0:45:00.33,Default,,0000,0000,0000,,خطرت لي فكرة هذه الجرائم
Dialogue: 0,0:45:02.93,0:45:05.18,Default,,0000,0000,0000,,!لنخرج يا سيجي-سان! لا يزال بإمكاننا النجاة
Dialogue: 0,0:45:05.18,0:45:07.48,Default,,0000,0000,0000,,فات الأوان عليّ
Dialogue: 0,0:45:08.31,0:45:13.20,Default,,0000,0000,0000,,فيداي ملطّختان بالدم مثل أولئك الأربعة
Dialogue: 0,0:45:18.47,0:45:19.54,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:45:19.71,0:45:20.45,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:45:20.45,0:45:21.40,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:45:21.40,0:45:22.31,Default,,0000,0000,0000,,!دعيني
Dialogue: 0,0:45:23.87,0:45:27.00,Default,,0000,0000,0000,,ما هذا الصوت؟
Dialogue: 0,0:45:27.00,0:45:28.89,Default,,0000,0000,0000,,إنّها الشفرة
Dialogue: 0,0:45:29.71,0:45:33.85,Default,,0000,0000,0000,,إنّه يعزف، بين ألسنة النار
Dialogue: 0,0:45:43.94,0:45:47.89,Default,,0000,0000,0000,,افتقد موراساوا-سان عازف البيانو أسو كيجي
Dialogue: 0,0:45:47.89,0:45:50.28,Default,,0000,0000,0000,,فكان يضبط البيانو خاصته من حين لآخر وفقما يبدو
Dialogue: 0,0:45:51.13,0:45:53.18,Default,,0000,0000,0000,,في ليلة تعرضه للاعتداء أيضاً
Dialogue: 0,0:45:55.05,0:45:58.35,Default,,0000,0000,0000,,لمَ أرسل لنا الطبيب نارومي تحذيراً عن الجرائم؟
Dialogue: 0,0:45:59.25,0:46:02.51,Default,,0000,0000,0000,,ربما كانت رسالة تحدّي لأبي
Dialogue: 0,0:46:02.92,0:46:06.67,Default,,0000,0000,0000,,أظنّه أراد أن يوقفه أحد عن القتل
Dialogue: 0,0:46:06.67,0:46:11.20,Default,,0000,0000,0000,,أخبرني، ما تحليل الشفرة التي عزفها الطبيب نارومي؟
Dialogue: 0,0:46:11.20,0:46:13.14,Default,,0000,0000,0000,,نسيت ذلك
Dialogue: 0,0:46:13.14,0:46:16.10,Default,,0000,0000,0000,,!تعابيرك لا توحي بذلك
Dialogue: 0,0:46:18.49,0:46:28.31,On Top,,0000,0000,0000,,{\fad(100,300)}شكراً لك أيّها المتحري الصغير
Dialogue: 0,0:48:02.34,0:48:04.50,Default,,0000,0000,0000,,أيمكن أنّ السيارة التي صعدتها أيومي-تشان
Dialogue: 0,0:48:04.50,0:48:06.92,Default,,0000,0000,0000,,!هي لمجرمي اختطاف الفتيات وقتلهن؟
Dialogue: 0,0:48:08.46,0:48:11.34,Default,,0000,0000,0000,,!انتظري يا أيومي-تشان! سنأتي لإنقاذك فوراً
Dialogue: 0,0:48:11.34,0:48:12.83,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:48:12.83,0:48:14.64,Default,,0000,0000,0000,,اختطاف أيومي-تشان
Dialogue: 0,0:48:30.66,0:48:32.97,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:48:32.97,0:48:34.83,Default,,0000,0000,0000,,مهرجان مدرسيّ
Dialogue: 0,0:48:34.83,0:48:36.83,Default,,0000,0000,0000,,تحمل الحلقة القادمة نمطاً مختلفاً قليلاً

