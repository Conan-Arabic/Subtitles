Dialogue: 0,0:00:01.18,0:00:04.68,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والقضايا تلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.68,0:00:06.68,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.68,0:00:10.05,Default,,0000,0000,0000,,!اليوم ختام قضيّة القصر! لا يتوقّف الأمر على الشفرة
Dialogue: 0,0:00:10.05,0:00:11.72,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.72,0:00:13.72,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.72,0:00:16.09,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.51,0:00:24.18,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.18,0:00:31.22,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.99,0:00:39.35,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.35,0:00:46.85,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.85,0:00:59.30,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.22,0:01:06.60,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.60,0:01:13.48,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.48,0:01:19.85,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.85,0:01:26.87,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:56.18,0:02:01.18,Default,,0000,0000,0000,,تلقّى العمّ رسالةً من شخص\Nيُدعى ناكامورا ميساو
Dialogue: 0,0:02:01.18,0:02:04.85,Default,,0000,0000,0000,,تطلب منه حلّ ألغاز غريبة\Nفي قصرٍ موروث
Dialogue: 0,0:02:06.80,0:02:09.05,Default,,0000,0000,0000,,كان القصر يعجّ بالألغاز حقّاً
Dialogue: 0,0:02:10.76,0:02:14.53,Default,,0000,0000,0000,,كان أحد عامودَي السور أمام المدخل\Nيحوي فوقه مجسّم نمر
Dialogue: 0,0:02:15.26,0:02:18.28,Default,,0000,0000,0000,,بينما بالآخر فتحة غريبة
Dialogue: 0,0:02:19.01,0:02:21.04,Default,,0000,0000,0000,,كان المنزل مليئاً بالساعات
Dialogue: 0,0:02:21.68,0:02:24.79,Default,,0000,0000,0000,,وإحداها قد نُزع منها\Nما يبدو أنّه كان ملتصقاً بها
Dialogue: 0,0:02:25.21,0:02:29.63,Default,,0000,0000,0000,,عند تمام الحادية عشرة، رنّت كلّ الساعات\Nالرقمية في المنزل
Dialogue: 0,0:02:31.26,0:02:34.13,Default,,0000,0000,0000,,كان مؤقّت جهاز الفيديو\Nمضبوطاً لدقيقة تماماً
Dialogue: 0,0:02:35.01,0:02:38.97,Default,,0000,0000,0000,,احتوت كلّ الساعات الرقمية\Nخدشاً في الموضع نفسه
Dialogue: 0,0:02:40.01,0:02:43.31,Default,,0000,0000,0000,,بدا أنّها تحاول الإيحاء بشيء
Dialogue: 0,0:02:45.55,0:02:49.92,Default,,0000,0000,0000,,فوق ذلك، هناك شخص يُشتبه\N!باختبائه في العليّة
Dialogue: 0,0:02:52.39,0:02:56.93,Default,,0000,0000,0000,,وكان يوجد ملفّ في المكتب\Nيحوي مقالات صحف
Dialogue: 0,0:02:56.93,0:03:01.29,Default,,0000,0000,0000,,عن الأغوال، عصابة لصوص \Nاختفت قبل 10 أعوام
Dialogue: 0,0:03:02.60,0:03:06.54,Default,,0000,0000,0000,,،وجدنا اسم مماثلاً لاسم زعيمهم، ديمون\Nعلى حقيبة غولف أيضاً
Dialogue: 0,0:03:08.60,0:03:13.18,Default,,0000,0000,0000,,فوق ذلك، ما أثار الغرابة أكثر هو\Nالمرآة المثبّتة على الحائط
Dialogue: 0,0:03:13.18,0:03:15.63,Default,,0000,0000,0000,,والفتحة في الحائط أسفل\Nساعة الوقواق تماماً
Dialogue: 0,0:03:17.51,0:03:21.68,Default,,0000,0000,0000,,وما خرج من ساعة الوقواق\N...عند الواحدة وعشر دقائق
Dialogue: 0,0:03:23.43,0:03:25.87,Default,,0000,0000,0000,,!كان مجسّمات أغوال شيطانيّة مرعبة
Dialogue: 0,0:03:28.68,0:03:30.92,Default,,0000,0000,0000,,أين مفتاح حلّ هذه الألغاز؟
Dialogue: 0,0:03:33.00,0:03:39.07,Title,,0000,0000,15,,{\fad(300,0)}قضيّة قصر عصابة اللصوص الغامض\N(الجزء الثاني)
Dialogue: 0,0:03:34.18,0:03:38.43,Default,,0000,0000,0000,,قضيّة قصر عصابة اللصوص الغامض\N(الجزء الثاني)
Dialogue: 0,0:03:39.89,0:03:43.35,Default,,0000,0000,0000,,...مجسّمات شياطين من ساعة الوقواق
Dialogue: 0,0:03:43.35,0:03:45.00,Default,,0000,0000,0000,,!الشياطين ليست حيوانات
Dialogue: 0,0:03:45.76,0:03:47.96,Default,,0000,0000,0000,,لمَ توجد تلك الأشياء المريبة هنا؟
Dialogue: 0,0:03:48.51,0:03:50.63,Default,,0000,0000,0000,,إنّها ليست مجرّد شياطين
Dialogue: 0,0:03:51.43,0:03:53.26,Default,,0000,0000,0000,,بل نفس مجسّمات الأغوال التي كانت
Dialogue: 0,0:03:53.26,0:03:56.67,Default,,0000,0000,0000,,عصابة الريح تتركها وراءها بلا شكّ
Dialogue: 0,0:03:58.10,0:03:59.47,Default,,0000,0000,0000,,لكن لمَ ثلاثة منها؟
Dialogue: 0,0:04:00.51,0:04:04.76,Default,,0000,0000,0000,,هذا هو! إنّه الشيء الغريب\N!الذي رأيته ذاك اليوم
Dialogue: 0,0:04:04.76,0:04:05.39,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:04:07.05,0:04:08.64,Default,,0000,0000,0000,,!ا-انظروا
Dialogue: 0,0:04:08.64,0:04:12.36,Default,,0000,0000,0000,,!توجد أحرف على رؤوسهم
Dialogue: 0,0:04:17.85,0:04:19.95,Default,,0000,0000,0000,,بالفعل! ما هذه؟
Dialogue: 0,0:04:21.51,0:04:23.85,Default,,0000,0000,0000,,...حرف "آر" على الشيطان الأيمن
Dialogue: 0,0:04:26.22,0:04:28.16,Default,,0000,0000,0000,,...و"إن" على الشيطان الأوسط
Dialogue: 0,0:04:31.26,0:04:34.30,Default,,0000,0000,0000,,...و"إل" على الشيطان الأيسر
Dialogue: 0,0:04:38.47,0:04:43.22,Default,,0000,0000,0000,,إذا كانت "آر" و"إل" تشيران\N...لليمين واليسار بالإنجليزية
Dialogue: 0,0:04:43.22,0:04:46.10,Default,,0000,0000,0000,,فما المقصود بـ "إن" في المنتصف؟
Dialogue: 0,0:04:46.10,0:04:48.52,Default,,0000,0000,0000,,نورث؟ أي الشمال؟
Dialogue: 0,0:04:53.47,0:04:54.78,Default,,0000,0000,0000,,توقّفت
Dialogue: 0,0:05:02.51,0:05:05.26,Default,,0000,0000,0000,,متى بدأت تلك الشياطين بالعويل؟
Dialogue: 0,0:05:05.26,0:05:07.51,Default,,0000,0000,0000,,عند الواحدة وعشر دقائق
Dialogue: 0,0:05:07.51,0:05:12.00,Default,,0000,0000,0000,,...الواحدة وعشر دقائق... ما يعني "110" أخرى
Dialogue: 0,0:05:12.00,0:05:14.67,Default,,0000,0000,0000,,لكن هذا غريب
Dialogue: 0,0:05:15.35,0:05:20.22,Default,,0000,0000,0000,,عندما رأيتها قبلاً، كانت قد بدأت\N!العويل عند العاشرة وخمسين دقيقة
Dialogue: 0,0:05:22.51,0:05:27.01,Default,,0000,0000,0000,,،ليس الواحدة وعشر دقائق\Nبل العاشرة وخمسين؟
Dialogue: 0,0:05:27.80,0:05:29.12,Default,,0000,0000,0000,,...ما يعني
Dialogue: 0,0:05:31.18,0:05:34.68,Default,,0000,0000,0000,,...ا-اسمع، أيمكن أن تلك المجسمّات
Dialogue: 0,0:05:34.68,0:05:36.52,Default,,0000,0000,0000,,هي تلك نفسها؟
Dialogue: 0,0:05:37.85,0:05:38.58,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:05:38.58,0:05:40.65,Default,,0000,0000,0000,,كلا، لا شيء
Dialogue: 0,0:05:43.35,0:05:44.61,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:05:46.03,0:05:50.08,Default,,0000,0000,0000,,!اكتشفتُ معظم ما يجري هنا
Dialogue: 0,0:05:53.25,0:05:56.20,Default,,0000,0000,0000,,لكنّي لم أجد المعنى بعد
Dialogue: 0,0:05:56.20,0:06:01.17,Default,,0000,0000,0000,,وراء هذه الآثار الغريبة والحيل\N!التي تركها مونجيرو-سان في المنزل
Dialogue: 0,0:06:02.37,0:06:06.91,Default,,0000,0000,0000,,بدأت الساعات الرقميّة وجهاز الفيديو\N...بالرنين عند الحادية عشرة
Dialogue: 0,0:06:06.91,0:06:11.18,Default,,0000,0000,0000,,العلامات البارزة الموجودة في نفس الموضع\Nعلى شريط كلّ الساعات
Dialogue: 0,0:06:12.58,0:06:16.75,Default,,0000,0000,0000,,وساعة الوقواق التي أطلقت عويلها\N...عند الواحدة وعشر دقائق
Dialogue: 0,0:06:16.75,0:06:20.69,Default,,0000,0000,0000,,،والشياطين الثلاثة الذين ظهروا من الساعة
Dialogue: 0,0:06:21.11,0:06:26.07,Default,,0000,0000,0000,,وأحرف "إل" و"إن" و"آر" المحفورة\Nعلى جباهها
Dialogue: 0,0:06:26.91,0:06:29.58,Default,,0000,0000,0000,,ما هو مفتاح حلّ هذه الألغاز؟
Dialogue: 0,0:06:33.25,0:06:34.29,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:06:35.37,0:06:36.25,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:06:36.25,0:06:40.42,Default,,0000,0000,0000,,ألم تلحظ أثناء البحث\Nعن الحيوانات في المنزل؟
Dialogue: 0,0:06:40.62,0:06:42.96,Default,,0000,0000,0000,,!اعتقدتُ أنّ هناك شيئاً ناقصاً
Dialogue: 0,0:06:43.58,0:06:45.25,Default,,0000,0000,0000,,!الأسد
Dialogue: 0,0:06:45.25,0:06:50.18,Default,,0000,0000,0000,,لم يكن هناك أيّ واحد، رغم أنّه\N!سهل التصميم وفقما يفترض
Dialogue: 0,0:06:50.50,0:06:55.83,Default,,0000,0000,0000,,يا حمقاء، كان هنالك أسدين كبيرين\N!أمام المدخل
Dialogue: 0,0:06:55.83,0:06:57.60,Default,,0000,0000,0000,,ماذا؟ حقّاً؟
Dialogue: 0,0:06:58.12,0:07:02.82,Default,,0000,0000,0000,,،كما إذا جمع هذا العدد من الحيوانات\Nفيستحيل أن يتجاهل الأسد
Dialogue: 0,0:07:03.33,0:07:05.70,Default,,0000,0000,0000,,فهو ملك الحيوانات
Dialogue: 0,0:07:06.41,0:07:07.34,Default,,0000,0000,0000,,ملك؟
Dialogue: 0,0:07:16.37,0:07:17.58,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:07:18.08,0:07:19.58,Default,,0000,0000,0000,,ما الخطب يا كونان-كن؟
Dialogue: 0,0:07:19.58,0:07:22.78,Default,,0000,0000,0000,,!لا شيء، تذكّرتُ أمراً طريفاً فقط
Dialogue: 0,0:07:25.66,0:07:27.26,Default,,0000,0000,0000,,صبيّ غريب الأطوار
Dialogue: 0,0:07:27.75,0:07:32.33,Default,,0000,0000,0000,,!إذا أصاب استنتاجي، فهي شفرة فريدة بحقّ
Dialogue: 0,0:07:32.33,0:07:33.70,Default,,0000,0000,0000,,،لكن انتظر
Dialogue: 0,0:07:33.70,0:07:41.95,Default,,0000,0000,0000,,"إذا صحّ الأمر، فيُفترض أن يظهر حرف "أو\Nأو رقم صفر من ساعة الوقواق
Dialogue: 0,0:07:41.95,0:07:46.19,Default,,0000,0000,0000,,،"لكن ما خرج كانت "إل" و"إن" و"آر\Nهذه الأحرف الثلاثة
Dialogue: 0,0:07:47.08,0:07:52.58,Default,,0000,0000,0000,,أيمكن أنّ معنى شفرة ساعة الوقواق\Nمختلف تماماً عن الساعة الرقمية؟
Dialogue: 0,0:07:54.04,0:07:55.50,Default,,0000,0000,0000,,...في تلك الحالة
Dialogue: 0,0:07:56.70,0:08:00.70,Default,,0000,0000,0000,,...الواحدة وعشر دقائق... 110
Dialogue: 0,0:08:00.70,0:08:03.67,Default,,0000,0000,0000,,...أحرف "إل" و"إن" و"آر" على رؤوسهم
Dialogue: 0,0:08:04.92,0:08:07.08,Default,,0000,0000,0000,,...ثلاثة أغوال
Dialogue: 0,0:08:07.46,0:08:09.96,Default,,0000,0000,0000,,...ثلاثة... ثلاثيّ
Dialogue: 0,0:08:11.72,0:08:14.81,Default,,0000,0000,0000,,توأم ثلاثيّ... توأم ثلاثيّ؟
Dialogue: 0,0:08:15.58,0:08:17.06,Default,,0000,0000,0000,,!إل" و"إن" و"آر" توأم ثلاثيّ"
Dialogue: 0,0:08:17.58,0:08:18.98,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:08:19.95,0:08:21.61,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:08:22.95,0:08:24.05,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:08:32.91,0:08:36.54,Default,,0000,0000,0000,,!فهمت، اكتشفت كلّ شيء
Dialogue: 0,0:08:37.29,0:08:40.08,Default,,0000,0000,0000,,كونان-كن! أين أنت؟
Dialogue: 0,0:08:40.71,0:08:42.55,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:08:44.71,0:08:46.97,Default,,0000,0000,0000,,أين ذهبت؟
Dialogue: 0,0:08:48.88,0:08:50.00,Default,,0000,0000,0000,,أين العمّ؟
Dialogue: 0,0:08:50.00,0:08:53.81,Default,,0000,0000,0000,,لا يزال يفكّر بالشفرة في المكتب
Dialogue: 0,0:08:54.80,0:08:57.05,Default,,0000,0000,0000,,على هذا النحو، سيخيم الظلام قريباً
Dialogue: 0,0:08:58.88,0:09:00.74,Default,,0000,0000,0000,,الاستعجال لن يفيد بشيء
Dialogue: 0,0:09:02.75,0:09:03.86,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:09:04.17,0:09:09.92,Default,,0000,0000,0000,,قد تأتي الإجابة إذا فكّرنا\Nملياً طوال اللّيل
Dialogue: 0,0:09:23.36,0:09:25.19,Default,,0000,0000,0000,,لا أستطيع اكتشافها
Dialogue: 0,0:09:25.19,0:09:28.87,Default,,0000,0000,0000,,رنّت كلّ الساعات الرقمية\N...عند الحادية عشرة صباحاً
Dialogue: 0,0:09:29.28,0:09:35.42,Default,,0000,0000,0000,,وتوجد خدوش على كل شاشاتها\N...بعد رقم 110
Dialogue: 0,0:09:36.23,0:09:42.03,Default,,0000,0000,0000,,،ورنّت ساعة الوقواق عند الواحدة وعشر دقائق\Nأي "110" أخرى
Dialogue: 0,0:09:42.03,0:09:45.07,Default,,0000,0000,0000,,!كلّها 110
Dialogue: 0,0:09:45.07,0:09:47.35,Default,,0000,0000,0000,,!ما معنى 110؟
Dialogue: 0,0:09:47.90,0:09:51.82,Default,,0000,0000,0000,,أهو رقم الشرطة فحسب بالفعل؟
Dialogue: 0,0:09:53.61,0:09:56.52,Default,,0000,0000,0000,,ربما حان وقت الاستسلام والعودة للبيت
Dialogue: 0,0:09:56.94,0:09:58.94,Default,,0000,0000,0000,,لكن هذا غريب
Dialogue: 0,0:09:58.94,0:10:02.44,Default,,0000,0000,0000,,كان سيكون ضبط الساعات الرقمية على\N...الواحدة وعشر دقائق أيضاً أكثر منطقيّة
Dialogue: 0,0:10:02.73,0:10:04.60,Default,,0000,0000,0000,,...اسمع يا أبي
Dialogue: 0,0:10:05.78,0:10:07.38,Default,,0000,0000,0000,,...أبي
Dialogue: 0,0:10:07.38,0:10:08.15,Default,,0000,0000,0000,,...أبي! أنا
Dialogue: 0,0:10:08.15,0:10:12.29,Default,,0000,0000,0000,,!اصمتي! إذا أردتِ العودة فارجعي بمفردك
Dialogue: 0,0:10:16.53,0:10:18.00,Default,,0000,0000,0000,,!لا تغضب عليّ
Dialogue: 0,0:10:25.36,0:10:27.09,Default,,0000,0000,0000,,اقترب الوقت
Dialogue: 0,0:10:27.53,0:10:31.53,Default,,0000,0000,0000,,...واحد واحد صفر... واحد واحد صفر\N...واحد واحد
Dialogue: 0,0:10:31.53,0:10:32.93,Default,,0000,0000,0000,,!فهمت! التخطيط
Dialogue: 0,0:10:33.28,0:10:37.52,Default,,0000,0000,0000,,!تشير 11 إلى نمط التخطيط
Dialogue: 0,0:10:37.86,0:10:42.73,Default,,0000,0000,0000,,لذا إذا تفقّدنا كلّ الحمير الوحشيّة\N!في المنزل فسنجد شيئاً بالتأكيد
Dialogue: 0,0:10:43.32,0:10:47.45,Default,,0000,0000,0000,,لكن ألم يكن عليه اختيار 11:11\Nفي تلك الحالة؟
Dialogue: 0,0:10:48.03,0:10:51.62,Default,,0000,0000,0000,,كما أن النمور مخطّطة أيضاً
Dialogue: 0,0:10:52.19,0:10:56.08,Default,,0000,0000,0000,,...صحيح، توجد قطط مخطّطة كذلك
Dialogue: 0,0:10:56.40,0:10:59.54,Default,,0000,0000,0000,,بالمناسبة، ما الأقوى بين الحمير الوحشيّة والنمور؟
Dialogue: 0,0:10:59.86,0:11:01.73,Default,,0000,0000,0000,,ماذا؟ النمور، أليس كذلك؟
Dialogue: 0,0:11:01.73,0:11:04.51,Default,,0000,0000,0000,,النمور هي رقم 1 بين الحيوانات إذاً؟
Dialogue: 0,0:11:04.73,0:11:07.72,Default,,0000,0000,0000,,لا بدّ أنّ الأسود هي رقم 1 يا صبيّ
Dialogue: 0,0:11:08.07,0:11:10.53,Default,,0000,0000,0000,,!صحيح! الأسود
Dialogue: 0,0:11:10.53,0:11:12.68,Default,,0000,0000,0000,,!كما يُتوقع من ما يُسمّى بملك الستّين وحشاً
Dialogue: 0,0:11:13.11,0:11:14.53,Default,,0000,0000,0000,,الستّين؟
Dialogue: 0,0:11:14.53,0:11:18.14,Default,,0000,0000,0000,,يا أحمق، تقصد ملك المئة وحش
Dialogue: 0,0:11:18.50,0:11:20.11,Default,,0000,0000,0000,,ملك المئة وحش؟
Dialogue: 0,0:11:18.50,0:11:22.32,Thoughts,,0000,0000,15,,،"نطق "110 وحش" مشابه لنطق رقم "110 \N"ونطق "ملك" يشبه حرف "أو
Dialogue: 0,0:11:20.11,0:11:22.32,Default,,0000,0000,0000,,(ماذا؟ ملك المئة وحش؟ (110 + أو
Dialogue: 0,0:11:25.16,0:11:27.37,On Top,,0000,0000,0000,,ملك المئة وحش
Dialogue: 0,0:11:27.86,0:11:29.66,Default,,0000,0000,0000,,!هكذا إذاً! حللتُها
Dialogue: 0,0:11:30.07,0:11:36.54,Default,,0000,0000,0000,,شفرة "1100" هذه تشير لملك\N!المئة وحش، أي ملك الوحوش: الأسد
Dialogue: 0,0:11:39.15,0:11:41.19,Default,,0000,0000,0000,,الخدش بين الصفرين كان يلمّح
Dialogue: 0,0:11:41.19,0:11:45.13,Default,,0000,0000,0000,,!للتفكير بهما منفصلين
Dialogue: 0,0:11:45.13,0:11:49.51,Default,,0000,0000,0000,,!تفقّد الأسود سيحلّ اللغز
Dialogue: 0,0:11:50.36,0:11:54.51,Default,,0000,0000,0000,,لـ-لكنّي لا أرى أيّة أسود
Dialogue: 0,0:11:54.86,0:11:59.69,Default,,0000,0000,0000,,لا بدّ أنّ مونجيرو-سان تخلّص من\Nكلّ الأسود غير المرتبطة في المنزل
Dialogue: 0,0:11:59.69,0:12:02.94,Default,,0000,0000,0000,,!كيلا تشتّت انتباهنا
Dialogue: 0,0:12:03.28,0:12:07.19,Default,,0000,0000,0000,,لذا بدا أنّ هنالك أشياءً\N!محطّمة أو تمّ نزعها
Dialogue: 0,0:12:07.19,0:12:09.40,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:12:09.73,0:12:13.83,Default,,0000,0000,0000,,هل الأسد المقصود هو الذي\Nأمام المدخل إذاً؟
Dialogue: 0,0:12:13.83,0:12:18.54,Default,,0000,0000,0000,,!أجل، سنجد شيئاً بالتأكيد إذا تفقدّناه
Dialogue: 0,0:12:23.03,0:12:26.15,Default,,0000,0000,0000,,لا شيء غريب به
Dialogue: 0,0:12:26.15,0:12:27.88,Default,,0000,0000,0000,,ذلك ما يبدو
Dialogue: 0,0:12:28.19,0:12:31.69,Default,,0000,0000,0000,,كما كيف تفسّر ساعة الوقواق؟
Dialogue: 0,0:12:32.69,0:12:37.56,Default,,0000,0000,0000,,إذا كان المقصود هو ملك المئة الوحش، فيُفترض أنّ\Nحرف "أو" الذي يعني "ملك" قد ظهر
Dialogue: 0,0:12:37.77,0:12:43.19,Default,,0000,0000,0000,,"مـ-معك حقّ، لا تتوافق "إل إن آر" مع "ملك
Dialogue: 0,0:12:44.02,0:12:47.19,Default,,0000,0000,0000,,أيمكن أنّ لها معنى مختلفاً؟
Dialogue: 0,0:12:47.19,0:12:49.02,Default,,0000,0000,0000,,فقد ظهرت في ساعة الوقواق فقط
Dialogue: 0,0:12:50.65,0:12:52.86,Default,,0000,0000,0000,,...ليس مستبعداً
Dialogue: 0,0:12:52.86,0:12:57.86,Default,,0000,0000,0000,,لكن ماذا إذاً؟ أهناك طريقة أخرى لقراءة 110؟
Dialogue: 0,0:12:57.86,0:13:01.37,Default,,0000,0000,0000,,إنّها الواحدة وعشر دقائق، فإذا\N...فصلت 1 و10
Dialogue: 0,0:13:01.86,0:13:05.71,Default,,0000,0000,0000,,..."واحد، "آي"، 10، "تو
Dialogue: 0,0:13:05.71,0:13:09.79,Default,,0000,0000,0000,,،"واحد، "تين"، واحد، "تو"\N..."هي"، "تو"
Dialogue: 0,0:13:10.26,0:13:11.63,CharCard,,0000,0000,0000,,{\fad(300,0)}(هيتو (ينبوع ساخن معزول
Dialogue: 0,0:13:10.27,0:13:11.65,On Top,,0000,0000,0000,,هيتو
Dialogue: 0,0:13:12.23,0:13:13.47,CharCard,,0000,0000,0000,,{\fad(300,0)}(إيتو (خيط
Dialogue: 0,0:13:12.36,0:13:13.69,On Top,,0000,0000,0000,,إيتو
Dialogue: 0,0:13:14.08,0:13:15.35,CharCard,,0000,0000,0000,,{\fad(300,0)}(إيتوو (اسم شخص
Dialogue: 0,0:13:14.11,0:13:15.59,On Top,,0000,0000,0000,,إيتوو؟
Dialogue: 0,0:13:15.77,0:13:17.10,Default,,0000,0000,0000,,!أجل، إيتوو
Dialogue: 0,0:13:17.77,0:13:22.69,Default,,0000,0000,0000,,أخبراني، هل كان يملك مونجيرو-سان\Nأحداً بين معارفه يُدعى إيتوو-سان؟
Dialogue: 0,0:13:22.69,0:13:23.52,Default,,0000,0000,0000,,...لا أدري
Dialogue: 0,0:13:23.52,0:13:26.56,Default,,0000,0000,0000,,ماذا عن نايتو-سان أو سايتو-سان إذاً؟
Dialogue: 0,0:13:29.36,0:13:30.90,Default,,0000,0000,0000,,ما المضحك؟
Dialogue: 0,0:13:31.40,0:13:38.07,Default,,0000,0000,0000,,هذا طريف! فتغيير الحرف الأوّل\N!يقلب الاسم تماماً
Dialogue: 0,0:13:39.19,0:13:41.53,Default,,0000,0000,0000,,ما الطريف في ذلك؟
Dialogue: 0,0:13:41.53,0:13:46.27,Default,,0000,0000,0000,,بالمناسبة، كان على كلّ رؤوس تلك الأغوال أحرف
Dialogue: 0,0:13:46.27,0:13:48.50,Default,,0000,0000,0000,,بدت متطابقةً أيضاً
Dialogue: 0,0:13:49.27,0:13:54.46,Default,,0000,0000,0000,,إل" و"إن" و"آر" على رؤوسها... ومتطابقة
Dialogue: 0,0:13:54.62,0:14:01.61,Default,,0000,0000,0000,,"ثلاث كلمات متشابهة تبدأ بـ "إل\Nو"إن" و"آر"، ثمّ 110؟
Dialogue: 0,0:14:07.11,0:14:08.64,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:14:08.94,0:14:11.23,Default,,0000,0000,0000,,!هذه هي
Dialogue: 0,0:14:12.27,0:14:16.70,Default,,0000,0000,0000,,كانت شفرة ساعة الوقواق تلك عن ثلاث كلمات \N،"تبدأ بأحرف "إن" و"إل" و"آر
Dialogue: 0,0:14:16.70,0:14:19.94,Default,,0000,0000,0000,,:ويتبعها جميعاً لفظ "إيتو"، فتصبح
Dialogue: 0,0:14:19.65,0:14:23.00,Thoughts,,0000,0000,15,,ضوء، ليل، يمين
Dialogue: 0,0:14:19.94,0:14:23.20,Default,,0000,0000,0000,,!لايت" و"نايت" و"رايت"، كما يُنطق باليابانية"
Dialogue: 0,0:14:23.86,0:14:29.62,Default,,0000,0000,0000,,أي أنّه سيحصل شيء إذا سلّطنا نوراً\N!على الأسد الأيمن ليلاً
Dialogue: 0,0:14:29.81,0:14:31.29,Default,,0000,0000,0000,,!مذهل يا أبي
Dialogue: 0,0:14:31.69,0:14:34.67,Default,,0000,0000,0000,,لكنّك فعلت ذلك قبل قليل
Dialogue: 0,0:14:36.69,0:14:38.17,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:14:41.36,0:14:43.63,Default,,0000,0000,0000,,ماذا؟ ما هذا يا ترى؟
Dialogue: 0,0:14:44.90,0:14:48.81,Default,,0000,0000,0000,,انظروا، وراء الأسد الأيمن
Dialogue: 0,0:14:48.81,0:14:50.31,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:50.81,0:14:54.73,Default,,0000,0000,0000,,،ليس واضحاً إذا لم تمعن النظر\Nلكن يبدو أنّه يُفتح
Dialogue: 0,0:15:00.11,0:15:01.40,Default,,0000,0000,0000,,!بالفعل
Dialogue: 0,0:15:02.15,0:15:06.58,Default,,0000,0000,0000,,...فهمت! إذا سلّطت النور عبر هذه الفتحة
Dialogue: 0,0:15:06.90,0:15:08.01,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:15:11.23,0:15:12.92,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:15:13.65,0:15:17.48,Default,,0000,0000,0000,,ران! أغلقي الباب وأبقي النور\N!مسلّطاً عبر الفتحة
Dialogue: 0,0:15:17.48,0:15:18.27,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:15:25.73,0:15:27.93,Default,,0000,0000,0000,,!الضوء ينعكس
Dialogue: 0,0:15:28.52,0:15:31.89,Default,,0000,0000,0000,,!فهمت! توجد مرآة في العامود
Dialogue: 0,0:15:32.19,0:15:34.81,Default,,0000,0000,0000,,!بأيّ حال، لنتبع النور فحسب
Dialogue: 0,0:15:44.73,0:15:48.79,Default,,0000,0000,0000,,!إنّه يدخل القصر عبر فتحة في الحائط
Dialogue: 0,0:15:49.19,0:15:51.75,Default,,0000,0000,0000,,!إنّها الفتحة التي كانت في المكتب
Dialogue: 0,0:15:52.15,0:15:54.71,Default,,0000,0000,0000,,!حسنٌ، لنتوجّه للمكتب
Dialogue: 0,0:15:57.19,0:15:58.71,Default,,0000,0000,0000,,أوجدتم شيئاً؟
Dialogue: 0,0:15:59.27,0:16:03.21,Default,,0000,0000,0000,,!واصلي تسليط النور مع إغلاق الباب فحسب
Dialogue: 0,0:16:04.05,0:16:06.32,Default,,0000,0000,0000,,ماذا؟ ليس بعد؟
Dialogue: 0,0:16:10.48,0:16:12.27,Default,,0000,0000,0000,,ما هذا الصوت؟
Dialogue: 0,0:16:23.15,0:16:26.07,Default,,0000,0000,0000,,!إ-إنّها حمامة وليس شيطاناً هذه المرّة
Dialogue: 0,0:16:27.58,0:16:29.45,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:16:30.24,0:16:34.21,Default,,0000,0000,0000,,،انعكس الضوء الداخل على المرآة فوق المكتب
Dialogue: 0,0:16:34.21,0:16:37.23,Default,,0000,0000,0000,,وأنار ساعة الوقواق من الأسفل
Dialogue: 0,0:16:37.23,0:16:39.92,Default,,0000,0000,0000,,أيوجد مقياس ضوئي في الداخل
Dialogue: 0,0:16:38.00,0:16:39.88,CharCard,,0000,0010,15,,{\fad(300,0}مقياس ضوئي
Dialogue: 0,0:16:40.48,0:16:46.84,Default,,0000,0000,0000,,لا بدّ أنّها معدّة بحيث تعمل ليلاً فقط\Nفلا تتأثّر بأشعّة الشمس
Dialogue: 0,0:16:48.48,0:16:50.47,Default,,0000,0000,0000,,يوجد شيءٌ على الحمامة
Dialogue: 0,0:16:52.52,0:16:54.19,Default,,0000,0000,0000,,ساعة معصم؟
Dialogue: 0,0:16:55.37,0:16:58.61,Default,,0000,0000,0000,,!لا بدّ أنّها هديّة تركها جدّي لي
Dialogue: 0,0:16:58.85,0:17:02.36,Default,,0000,0000,0000,,!لكنّها فاخرة حقّاً، المجوهرات ترصّعها
Dialogue: 0,0:17:02.98,0:17:06.47,Default,,0000,0000,0000,,إذا كانت هذه جواهر ممتازة، فقد يساوي\N!ثمنها مليارات الينّات
Dialogue: 0,0:17:07.52,0:17:11.04,Default,,0000,0000,0000,,...بالطبع! فهي
Dialogue: 0,0:17:12.02,0:17:15.23,Default,,0000,0000,0000,,،سلعة مسروقة احتفظ بها ديمون\N،زعيم عصابة الأغوال
Dialogue: 0,0:17:15.23,0:17:17.31,Default,,0000,0000,0000,,!وأخفاها غالباً
Dialogue: 0,0:17:18.36,0:17:21.71,Default,,0000,0000,0000,,ديمون، زعيم عصابة الأغوال؟
Dialogue: 0,0:17:22.02,0:17:24.67,Default,,0000,0000,0000,,الشخص الذي كان يعيش هنا، مونجيرو-سان
Dialogue: 0,0:17:24.67,0:17:27.86,Default,,0000,0000,0000,,المجسمّات التي خرجت من ساعة الوقواق
Dialogue: 0,0:17:27.86,0:17:32.90,Default,,0000,0000,0000,,بدت كمجسمّات الأغوال التي كانت عصابة\Nاللصوص تتركها وراءها دوماً
Dialogue: 0,0:17:32.90,0:17:36.39,Default,,0000,0000,0000,,وبدا أنّه تلقّى حقيبة غولف\N!بلقبه "ديمون" عليها أيضاً
Dialogue: 0,0:17:36.77,0:17:41.55,Default,,0000,0000,0000,,كما أنّي لا أعتقد أنّ ميساو-سان الذي\Nأرسل الرسالة لك هو أحدهما
Dialogue: 0,0:17:42.81,0:17:45.81,Default,,0000,0000,0000,,:فقد كان مذكوراً في الرسالة
Dialogue: 0,0:17:45.81,0:17:48.53,Default,,0000,0000,0000,,لم أقض وقتاً طويلاً هنا"\Nولا أعرف تفاصيل المنزل
Dialogue: 0,0:17:48.86,0:17:51.45,Default,,0000,0000,0000,,"رأيتُ أنّي لن أكتشف شيئاً من تلقاء نفسي
Dialogue: 0,0:17:51.86,0:17:56.62,Default,,0000,0000,0000,,،لكنّهما عرفا كيف يفتحان الباب العتيق\Nويعيشان هنا معاً
Dialogue: 0,0:17:57.00,0:18:03.56,Default,,0000,0000,0000,,كما أنّه أخطأ باعتقاد أنّ ساعة الوقواق رنّت\Nعند العاشرة والخمسين بدل الواحدة وعشر دقائق
Dialogue: 0,0:18:03.56,0:18:08.38,Default,,0000,0000,0000,,والسبب هو عدم رؤيته مباشرةً للساعة
Dialogue: 0,0:18:08.86,0:18:15.18,Default,,0000,0000,0000,,بل اختلس النظر عبر الفتحة في الحائط\N!ورأى صورة الساعة في المرآة
Dialogue: 0,0:18:15.86,0:18:20.90,Default,,0000,0000,0000,,...أي أنّ الشخص الذي شكّ ميساو-سان بمراقبته له
Dialogue: 0,0:18:21.52,0:18:23.23,Default,,0000,0000,0000,,!هو هما
Dialogue: 0,0:18:24.36,0:18:27.36,Default,,0000,0000,0000,,كما أنّي أعتقد أنّ ميساو-سان امرأة
Dialogue: 0,0:18:27.81,0:18:29.11,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:18:29.11,0:18:32.19,Default,,0000,0000,0000,,انظر للطابع على هذه الرسالة
Dialogue: 0,0:18:33.23,0:18:36.52,Default,,0000,0000,0000,,يوجد أحمر شفاه أسفله، أليس كذلك؟
Dialogue: 0,0:18:39.23,0:18:42.34,Default,,0000,0000,0000,,!فهمت! لعقتْه عندما لصقته هنا
Dialogue: 0,0:18:42.54,0:18:46.13,Default,,0000,0000,0000,,لكنّي متأكّد أنّك اكتشفت\N!كلّ ذلك سلفاً يا عمّ
Dialogue: 0,0:18:47.02,0:18:48.42,Default,,0000,0000,0000,,...أجل
Dialogue: 0,0:18:49.36,0:18:50.84,Default,,0000,0000,0000,,...ما يعني، أنتما
Dialogue: 0,0:18:57.69,0:18:59.60,Default,,0000,0000,0000,,مُبهر
Dialogue: 0,0:19:01.36,0:19:04.27,Default,,0000,0000,0000,,نحن أعضاء باقون للأغوال
Dialogue: 0,0:19:04.27,0:19:08.82,Default,,0000,0000,0000,,أتينا لأخذ الكنز الأخير الذي تمسّك الزعيم به
Dialogue: 0,0:19:09.07,0:19:10.52,Default,,0000,0000,0000,,تمسّك به؟
Dialogue: 0,0:19:10.52,0:19:16.69,Default,,0000,0000,0000,,أجل، عندما انفصلنا، قام بمنحنا\Nمعظم ما سرقناه
Dialogue: 0,0:19:16.69,0:19:21.33,Default,,0000,0000,0000,,!لكنّه احتفظ بأثمن الغنائم، واستأثرها لنفسه
Dialogue: 0,0:19:21.33,0:19:24.79,Default,,0000,0000,0000,,وتلك هي الجواهر على هذه الساعة؟
Dialogue: 0,0:19:25.15,0:19:29.02,Default,,0000,0000,0000,,مات أخيراً، فأتينا لتفتيش هذا المنزل الذي
Dialogue: 0,0:19:29.02,0:19:34.01,Default,,0000,0000,0000,,كان يستعمله كمخبأ... لكنّنا وجدنا شخصاً
Dialogue: 0,0:19:34.31,0:19:38.97,Default,,0000,0000,0000,,وهي ميساو-سان الحقيقيّة المحتجزة\Nفي العليّة حالياً، صحيح؟
Dialogue: 0,0:19:39.07,0:19:44.06,Default,,0000,0000,0000,,أجل، واصلت الصراخ عندما احتجزناها هناك
Dialogue: 0,0:19:44.06,0:19:48.61,Default,,0000,0000,0000,,وقالت أنّ متحرّياً عظيماً على وشك\Nالقدوم هنا، فعلينا التحضّر
Dialogue: 0,0:19:49.02,0:19:53.19,Default,,0000,0000,0000,,ثمّ أتيتَ في الوقت المناسب
Dialogue: 0,0:19:53.19,0:19:58.62,Default,,0000,0000,0000,,فانتحلتُ هويّتها كي أجعلك\Nتحلّ الشفرة التي تركها الزعيم
Dialogue: 0,0:19:59.06,0:20:01.62,Default,,0000,0000,0000,,!هيّا، فلتسلّم الساعة
Dialogue: 0,0:20:02.31,0:20:05.63,Default,,0000,0000,0000,,سلّمها بطواعيّة ولن أقتلك
Dialogue: 0,0:20:08.94,0:20:10.42,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:20:12.09,0:20:12.97,Default,,0000,0000,0000,,!الـ-الوغد
Dialogue: 0,0:20:20.06,0:20:22.23,Default,,0000,0000,0000,,لحظة، ما كان ذلك؟
Dialogue: 0,0:20:22.81,0:20:25.48,Default,,0000,0000,0000,,!لا تتحرّك! افعل وسأكسر عنقها
Dialogue: 0,0:20:25.62,0:20:26.89,Default,,0000,0000,0000,,!أ-أحمق
Dialogue: 0,0:20:26.89,0:20:28.44,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:20:40.86,0:20:43.04,Default,,0000,0000,0000,,...ضـ-ضربة كاحل سفلية
Dialogue: 0,0:20:45.05,0:20:46.50,Default,,0000,0000,0000,,!أفزعني
Dialogue: 0,0:20:47.61,0:20:49.46,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:20:49.86,0:20:52.67,Default,,0000,0000,0000,,!حسنٌ! لنتّصل بالشرطة
Dialogue: 0,0:22:22.59,0:22:26.90,Default,,0000,0000,0000,,بعد اتّصالنا، أتت الشرطة المحليّة للمكان فوراً
Dialogue: 0,0:22:27.34,0:22:31.32,Default,,0000,0000,0000,,نُقل المجرمان فاقدي الوعي\Nللإسعاف كما هما
Dialogue: 0,0:22:31.60,0:22:35.24,Default,,0000,0000,0000,,وأُنقذت ميساو-سان من العليّة بسلام
Dialogue: 0,0:22:35.44,0:22:41.21,Default,,0000,0000,0000,,كما توقّعنا، كانت الفتاة في الصورة\Nمع مونجيرو-سان
Dialogue: 0,0:22:42.38,0:22:44.17,Default,,0000,0000,0000,,هكذا إذاً؟
Dialogue: 0,0:22:44.63,0:22:46.96,Default,,0000,0000,0000,,كانت هذه داخل ساعة الوقواق؟
Dialogue: 0,0:22:46.96,0:22:53.76,Default,,0000,0000,0000,,صنع مونجيرو-سان هذه الساعة لك\Nمن الجواهر المسروقة غالباً
Dialogue: 0,0:22:53.76,0:22:57.46,Default,,0000,0000,0000,,قد لن يكتشف أحدٌ أمرك\N...إذا أخذتِها سرّاً
Dialogue: 0,0:22:57.46,0:23:00.89,Default,,0000,0000,0000,,،لكن تبقى الأغراض المسروقة مسروقةً\Nلا يمكنني قبولها
Dialogue: 0,0:23:01.51,0:23:04.51,Default,,0000,0000,0000,,كما أنّ جدّي قد أعطاني شيئاً
Dialogue: 0,0:23:04.51,0:23:06.61,Default,,0000,0000,0000,,أكثر قيمة من الجواهر
Dialogue: 0,0:23:08.42,0:23:11.68,Default,,0000,0000,0000,,الألغاز المتناثرة في هذا القصر
Dialogue: 0,0:23:12.84,0:23:17.28,Default,,0000,0000,0000,,!بالنسبة لمؤلّفة غموض مثلي، هذه أفضل هديّة
Dialogue: 0,0:23:17.70,0:23:18.82,Default,,0000,0000,0000,,...فهمت
Dialogue: 0,0:23:20.01,0:23:23.00,Default,,0000,0000,0000,,...لكن، سيكون هذا إهداراً
Dialogue: 0,0:23:23.78,0:23:25.17,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:23:25.17,0:23:30.71,Default,,0000,0000,0000,,ربما كانت هذه الساعة لأيّ\N!من يجدها، وليس لي تحديداً
Dialogue: 0,0:23:30.71,0:23:32.76,Default,,0000,0000,0000,,!في تلك الحالة، لي أنا؟
Dialogue: 0,0:23:33.02,0:23:34.51,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:23:34.92,0:23:37.71,Default,,0000,0000,0000,,ليس صحيحاً يا عمّ
Dialogue: 0,0:23:38.76,0:23:44.52,Default,,0000,0000,0000,,فهذه الساعة من صنع مونجيرو-سان\Nلميساو-سان بلا شكّ
Dialogue: 0,0:23:45.55,0:23:48.59,Default,,0000,0000,0000,,أمعن النظر لعقارب الساعة
Dialogue: 0,0:23:48.59,0:23:52.95,Default,,0000,0000,0000,,"توقّفت عند الثالثة والنصف. 330 تُقرأ "ميساو
Dialogue: 0,0:23:50.41,0:24:00.44,CharCard,,0000,0000,15,,{\fad(600,1000)}ميساو
Dialogue: 0,0:24:07.27,0:24:08.04,Default,,0000,0000,0000,,!ناكاي-سان
Dialogue: 0,0:24:15.84,0:24:16.63,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:24:25.35,0:24:31.35,On Top,,0000,0000,0000,,جريمة قتل صورة السبق الصحفيّ
Dialogue: 0,0:24:26.63,0:24:28.05,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:28.05,0:24:30.84,Default,,0000,0000,0000,,جريمة قتل صورة السبق الصحفيّ
Dialogue: 0,0:24:47.35,0:24:49.67,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:50.03,0:24:51.37,Default,,0000,0000,0000,,حافلة طريق سريع
Dialogue: 0,0:24:51.57,0:24:53.37,Default,,0000,0000,0000,,قضيّة الحلقة القادمة\N!سبق صحفيّ
Dialogue: 0,0:24:53.37,0:24:55.27,Default,,0000,0000,0000,,من هذا الظاهر في الصورة مع أبي؟
Dialogue: 0,0:24:55.27,0:24:56.12,Default,,0000,0000,0000,,!تبّاً

