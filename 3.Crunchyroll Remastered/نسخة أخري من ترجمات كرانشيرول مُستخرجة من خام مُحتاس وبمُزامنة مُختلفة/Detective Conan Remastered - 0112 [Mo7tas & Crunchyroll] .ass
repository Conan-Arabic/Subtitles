Dialogue: 0,0:00:01.02,0:00:04.44,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.44,0:00:06.27,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.52,0:00:08.23,Default,,0000,0000,0000,,!مسرح اليوم هو المدرسة ليلاً
Dialogue: 0,0:00:08.23,0:00:10.36,Default,,0000,0000,0000,,!تحوم شائعات مخيفة في مجرى الليل
Dialogue: 0,0:00:10.36,0:00:12.02,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.02,0:00:13.86,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.86,0:00:15.27,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.23,0:00:24.19,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.19,0:00:31.23,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:33.08,0:00:39.36,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.36,0:00:46.86,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.86,0:00:59.32,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.32,0:01:06.61,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.70,0:01:13.58,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.58,0:01:19.86,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.86,0:01:26.97,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.06,0:01:57.16,Title,,0000,0000,15,,{\fad(300,0)}قضيّة ألغاز ابتدائيّة تيتان السبعة
Dialogue: 0,0:01:51.69,0:01:54.74,Default,,0000,0000,0000,,قضيّة ألغاز ابتدائيّة تيتان السبعة
Dialogue: 0,0:01:57.52,0:02:00.12,Default,,0000,0000,0000,,هذه المدرسة ملعونة؟
Dialogue: 0,0:02:00.20,0:02:02.65,Default,,0000,0000,0000,,!أجل، إنّها الحقيقة
Dialogue: 0,0:02:02.65,0:02:05.16,Default,,0000,0000,0000,,!المدرسة بأسرها تتكلّم عنها
Dialogue: 0,0:02:05.73,0:02:09.48,Default,,0000,0000,0000,,"لا بد أنّها إحدى "الألغاز السبعة\Nالتي توجد في كلّ مدرسة
Dialogue: 0,0:02:09.48,0:02:12.86,Default,,0000,0000,0000,,،مثل البيانو الذي يُعزف من تلقاء نفسه\Nوالأدراج التي يرتفع عددها
Dialogue: 0,0:02:12.86,0:02:15.34,Default,,0000,0000,0000,,!ليست كلاماً طفوليّاً كهذا
Dialogue: 0,0:02:16.02,0:02:18.44,Default,,0000,0000,0000,,حدث الأمر في الصباح الباكر الأسبوع الفائت
Dialogue: 0,0:02:18.44,0:02:22.02,Default,,0000,0000,0000,,عندما دخلت تلميذةٌ غرفة الفنون
Dialogue: 0,0:02:22.02,0:02:25.35,Default,,0000,0000,0000,,كانت تحبّ اللوحات الكبيرة\Nفي غرفة الفنون
Dialogue: 0,0:02:25.35,0:02:27.73,Default,,0000,0000,0000,,وتذهب كلّ صباح للتحديق فيها
Dialogue: 0,0:02:27.73,0:02:30.94,Default,,0000,0000,0000,,...لكنّها رأت
Dialogue: 0,0:02:31.44,0:02:37.70,Default,,0000,0000,0000,,كلّ التماثيل الجصّية الثمانية\N!في غرفة الفنون تحدّق فيها
Dialogue: 0,0:02:39.19,0:02:41.69,Default,,0000,0000,0000,,ما رأيك؟ أليس غامضاً؟
Dialogue: 0,0:02:41.69,0:02:43.66,Default,,0000,0000,0000,,إنّها مجرد مصادفة، مصادفة
Dialogue: 0,0:02:44.15,0:02:45.94,Default,,0000,0000,0000,,!ليس هي فقط
Dialogue: 0,0:02:45.94,0:02:50.32,Default,,0000,0000,0000,,ألا ترى أنّ عدد التلامذة انخفض\Nفي هذه المدرسة مؤخراً؟
Dialogue: 0,0:02:50.32,0:02:52.37,Default,,0000,0000,0000,,سمعتُ أنّ الزكام منتشر
Dialogue: 0,0:02:52.73,0:02:56.34,Default,,0000,0000,0000,,!ربما أصابتهم جميعاً لعنة التماثيل الجصّية
Dialogue: 0,0:02:57.44,0:03:01.69,Default,,0000,0000,0000,,الشائعة التي سمعتُها أقوى\N!من تلك التماثيل الجصّية
Dialogue: 0,0:03:01.69,0:03:04.43,Default,,0000,0000,0000,,أتعرف تلك الدمية المقرفة في مكتب الممرضة؟
Dialogue: 0,0:03:04.65,0:03:06.89,Default,,0000,0000,0000,,تقصد نموذج التشريح؟
Dialogue: 0,0:03:06.89,0:03:09.35,Default,,0000,0000,0000,,...كان يركض
Dialogue: 0,0:03:09.83,0:03:14.40,Default,,0000,0000,0000,,!قـ-قبل أربع ليال في الرواق! وبسرعةٍ فائقة
Dialogue: 0,0:03:14.40,0:03:15.81,Default,,0000,0000,0000,,يا للسخافة
Dialogue: 0,0:03:16.14,0:03:19.52,Default,,0000,0000,0000,,!أيومي! أخبريه بقصّتك أيضاً
Dialogue: 0,0:03:19.52,0:03:21.53,Default,,0000,0000,0000,,ماذا؟ رأيتِ شيئاً أيضاً\Nيا أيومي-تشان؟
Dialogue: 0,0:03:22.23,0:03:23.49,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:23.83,0:03:27.15,Default,,0000,0000,0000,,بأيّ حال، علينا نحن فرقة\Nفتيان التحرّي البدء
Dialogue: 0,0:03:27.15,0:03:29.41,Default,,0000,0000,0000,,!بالتحقيق وإلّا قد تقع كارثة
Dialogue: 0,0:03:31.52,0:03:33.30,Default,,0000,0000,0000,,!كوباياشي سينسي
Dialogue: 0,0:03:33.36,0:03:36.82,On Top,,0000,0000,0000,,،إذا لم تستطع التهذّب أثناء درسي
Dialogue: 0,0:03:33.45,0:03:38.23,CharCard,,0000,0000,0004,,{\fad(250,250)}(كوباياشي سوميكو (26\Nمعلّمة الفصل 1-ب المشرفة
Dialogue: 0,0:03:36.82,0:03:38.23,On Top,,0000,0000,0000,,!فارحل فوراً
Dialogue: 0,0:03:40.07,0:03:42.52,Default,,0000,0000,0000,,!حسناً، اقرأ أنت تالياً يا فوكوموتو-كن
Dialogue: 0,0:03:42.52,0:03:44.30,Default,,0000,0000,0000,,!هيّا! لا تتباطأ
Dialogue: 0,0:03:44.77,0:03:45.36,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:03:45.36,0:03:47.30,Default,,0000,0000,0000,,ما مشكلتك أيّتها العجوز الشيطانة؟
Dialogue: 0,0:03:49.19,0:03:53.27,Default,,0000,0000,0000,,كانت توتاني سينسي أفضل، ألطف بكثير
Dialogue: 0,0:03:53.52,0:03:58.23,Default,,0000,0000,0000,,ليس باليد حيلة، فقد تزوّجت وتركت عملها
Dialogue: 0,0:03:58.86,0:04:00.69,Default,,0000,0000,0000,,هذا بائس
Dialogue: 0,0:04:02.57,0:04:04.07,Default,,0000,0000,0000,,أيومي-تشان؟
Dialogue: 0,0:04:06.27,0:04:08.03,Default,,0000,0000,0000,,ماذا؟ رأيتِ شخصاً غريباً؟
Dialogue: 0,0:04:08.32,0:04:11.57,Default,,0000,0000,0000,,أجل، في غرفة الفصل هذه قبل ثلاثة أيام
Dialogue: 0,0:04:11.57,0:04:14.00,Default,,0000,0000,0000,,لمَ أتيتِ للمدرسة ليلاً؟
Dialogue: 0,0:04:14.00,0:04:18.17,Default,,0000,0000,0000,,كنت... قلقةً على السمك
Dialogue: 0,0:04:18.48,0:04:21.36,Default,,0000,0000,0000,,السمك؟ تقصدين هذه؟
Dialogue: 0,0:04:21.36,0:04:26.97,Default,,0000,0000,0000,,أجل، نسيتُ إطعامها ذاك اليوم\Nفرجعت لتفقّد حالها
Dialogue: 0,0:04:27.19,0:04:31.61,Default,,0000,0000,0000,,!ورأيتُ شخصاً في غرفة الفصل هذه المظلمة
Dialogue: 0,0:04:31.61,0:04:35.61,Default,,0000,0000,0000,,!كان مريباً ويتجوّل بقناع أبيض كبير
Dialogue: 0,0:04:36.13,0:04:38.02,Default,,0000,0000,0000,,هل رأيتِ وجهه؟
Dialogue: 0,0:04:38.02,0:04:42.52,Default,,0000,0000,0000,,كلا، كان صوته مكتوماً أيضاً\Nفلم أتعرّف عليه
Dialogue: 0,0:04:42.52,0:04:44.90,Default,,0000,0000,0000,,لكنّه بدا غاضباً
Dialogue: 0,0:04:45.29,0:04:47.36,Default,,0000,0000,0000,,لمَ لم تخبري معلّماً بذلك؟
Dialogue: 0,0:04:47.61,0:04:51.52,Default,,0000,0000,0000,,فعلت! أخبرت نائب المدير الذي\N!يعيش في حيّنا
Dialogue: 0,0:04:51.52,0:04:54.02,Default,,0000,0000,0000,,وعد بتفقّد الأمر
Dialogue: 0,0:04:54.02,0:04:55.58,Default,,0000,0000,0000,,وما الذي وجده؟
Dialogue: 0,0:04:55.90,0:05:00.98,Default,,0000,0000,0000,,في الواقع... لم يأت للمدرسة\N!اليوم ولا بالأمس
Dialogue: 0,0:05:00.98,0:05:05.59,Default,,0000,0000,0000,,سألت كوباياشي سينسي وبقيّة المعلّمين\Nوقالوا أنّهم لم يروه
Dialogue: 0,0:05:05.59,0:05:10.14,Default,,0000,0000,0000,,ولم يجب أحدٌ على الجرس\N!عندما ذهبتُ لمنزله
Dialogue: 0,0:05:10.40,0:05:12.48,Default,,0000,0000,0000,,ألا يمكن أنّه طريح الفراش بالزكام لا أكثر؟
Dialogue: 0,0:05:12.48,0:05:15.60,Default,,0000,0000,0000,,كان ليتّصل بالمدرسة في تلك الحالة
Dialogue: 0,0:05:16.27,0:05:20.06,Default,,0000,0000,0000,,وفقما أذكر، فهو يعيش بمفرده\N...بعدما تُوفيّت زوجته
Dialogue: 0,0:05:20.32,0:05:22.94,Default,,0000,0000,0000,,!لا بد... لا بد أنّها غلطتي
Dialogue: 0,0:05:22.94,0:05:29.03,Default,,0000,0000,0000,,!بسبب ما طلبتُه منه، قتله ذاك الشخص الغريب
Dialogue: 0,0:05:29.37,0:05:32.99,Default,,0000,0000,0000,,!أنتم! لمَ هذه الجلبة؟ فلتبدؤوا التنظيف
Dialogue: 0,0:05:33.36,0:05:41.02,Default,,0000,0000,0000,,وعليكم توصيل إشعارات الفصل المفتوح\N!لمنزل صديقكم المتغيّب اليوم
Dialogue: 0,0:05:41.02,0:05:41.96,Default,,0000,0000,0000,,أفهمتم؟
Dialogue: 0,0:05:42.15,0:05:43.42,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:05:50.83,0:05:54.18,Default,,0000,0000,0000,,كوباياشي سينسي، لمَ هذه الملامح العبوسة؟
Dialogue: 0,0:05:54.43,0:05:58.03,CharCard,,0000,0000,0004,,{\fad(300,150)}(أوهاتا ماسايوكي (31\Nمعلّم الفصل 1-أ المشرف
Dialogue: 0,0:05:54.96,0:05:57.00,On Top,,0000,0000,0000,,قد يكون التعامل مع\Nطلّاب الصفّ الأوّل
Dialogue: 0,0:05:57.00,0:06:01.25,On Top,,0000,0000,0000,,فور انتقالك هنا صعباً، لكن عليكِ الاسترخاء أكثر
Dialogue: 0,0:06:01.60,0:06:03.56,Default,,0000,0000,0000,,لا، ليس الأمر هكذا
Dialogue: 0,0:06:05.67,0:06:10.17,Default,,0000,0000,0000,,،أخبرني يا أوهاتا سينسي\Nهل لي أن أسألك شيئاً؟
Dialogue: 0,0:06:10.59,0:06:12.42,Default,,0000,0000,0000,,أجل، ما الأمر؟
Dialogue: 0,0:06:12.42,0:06:16.79,Default,,0000,0000,0000,,أتعرف ما الذي حلّ بنائب المدير؟
Dialogue: 0,0:06:16.79,0:06:20.08,Default,,0000,0000,0000,,!ذ-ذلك... لا-لا أدري
Dialogue: 0,0:06:20.08,0:06:22.92,Default,,0000,0000,0000,,،يبدو إنّه غائبٌ ليومين بلا إشعار
Dialogue: 0,0:06:22.92,0:06:26.17,Default,,0000,0000,0000,,!لكنّي أظنّه سيظهر عاجلاً أم آجلاً
Dialogue: 0,0:06:30.12,0:06:32.08,Default,,0000,0000,0000,,إنّه يخفي شيئاً
Dialogue: 0,0:06:32.08,0:06:36.21,Default,,0000,0000,0000,,!تبّاً! كلّهم جماعة معلّمين بغيضين
Dialogue: 0,0:06:37.25,0:06:40.12,Default,,0000,0000,0000,,!أنت، لا تركل مبنى المدرسة هكذا
Dialogue: 0,0:06:41.18,0:06:42.33,Default,,0000,0000,0000,,!حضرة المدير
Dialogue: 0,0:06:42.43,0:06:46.34,CharCard,,0000,0000,0004,,{\fad(300,150)}(أويماتسو ريوجيرو (59\Nمديرة مدرسة تيتان الابتدائيّة
Dialogue: 0,0:06:43.81,0:06:47.01,On Top,,0000,0000,0000,,سيبلغ مبنى هذه المدرسة\Nعامه الثلاثين هذا الحول
Dialogue: 0,0:06:47.35,0:06:52.44,Default,,0000,0000,0000,,،تشاركتُ معه العديد من الأوقات العصيبة\Nلذا هو بمثابة ذاتي الأخرى
Dialogue: 0,0:06:52.93,0:06:55.43,Default,,0000,0000,0000,,هلّا عاملتموه بلطفٍ أكبر
Dialogue: 0,0:06:56.56,0:07:00.45,Default,,0000,0000,0000,,المعذرة، هل تعرف أمر النائب حضرة المدير؟
Dialogue: 0,0:07:03.18,0:07:08.00,Default,,0000,0000,0000,,محتّمٌ على الأسرار أن تتسرّب، كان سيّئ الحظّ بحقّ
Dialogue: 0,0:07:08.52,0:07:10.33,Default,,0000,0000,0000,,إنّه القدر
Dialogue: 0,0:07:18.68,0:07:21.02,Default,,0000,0000,0000,,حسناً، تفهمان ما سنفعله، صحيح؟
Dialogue: 0,0:07:21.02,0:07:21.89,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:07:21.89,0:07:26.68,Default,,0000,0000,0000,,...سنتسلّل نحن فرقة فتيان التحرّي لمبنى المدرسة
Dialogue: 0,0:07:26.68,0:07:30.44,Default,,0000,0000,0000,,!لحلّ الألغاز العديدة التي وقعت هنا
Dialogue: 0,0:07:31.18,0:07:34.31,Default,,0000,0000,0000,,أظنّ هذه كانت\Nالتي تركتها غير مقفلة
Dialogue: 0,0:07:42.06,0:07:45.02,Default,,0000,0000,0000,,!هذا ليس منصفاً
Dialogue: 0,0:07:42.06,0:07:45.02,Default,,0000,0000,0000,,!افتح لنا يا كونان-كن
Dialogue: 0,0:07:45.02,0:07:47.43,Default,,0000,0000,0000,,هذا خطر، فلترجعوا للبيت
Dialogue: 0,0:07:48.60,0:07:50.68,Default,,0000,0000,0000,,...استعداد
Dialogue: 0,0:07:52.60,0:07:55.50,Default,,0000,0000,0000,,!حسناً، حسناً! سأفتح لكم
Dialogue: 0,0:07:57.46,0:08:00.18,Default,,0000,0000,0000,,المدرسة ليلاً مخيفة حقّاً
Dialogue: 0,0:08:00.18,0:08:02.05,Default,,0000,0000,0000,,!أجل! قلبي ينبض بشدّة
Dialogue: 0,0:08:02.31,0:08:05.89,Default,,0000,0000,0000,,...لنتكتّم على الأمر، لو اكتشف المعلّمون هذا
Dialogue: 0,0:08:05.89,0:08:07.72,Default,,0000,0000,0000,,كلا، أنتم مكشوفون سلفاً
Dialogue: 0,0:08:08.39,0:08:10.35,Default,,0000,0000,0000,,خصوصاً بما أنّكم\Nترتدون أحذية موحلة
Dialogue: 0,0:08:13.94,0:08:17.86,Default,,0000,0000,0000,,يا إلهي، يا للجماعة المُتعِبة
Dialogue: 0,0:08:21.03,0:08:22.36,Default,,0000,0000,0000,,!حسناً، هيّا بنا
Dialogue: 0,0:08:22.60,0:08:24.70,Default,,0000,0000,0000,,!لنبدأ بغرفة الفنون
Dialogue: 0,0:08:24.70,0:08:25.77,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:08:35.71,0:08:36.85,Default,,0000,0000,0000,,!إنّها حالكة الظلام
Dialogue: 0,0:08:36.85,0:08:37.97,Default,,0000,0000,0000,,!الأنوار، الأنوار
Dialogue: 0,0:08:37.97,0:08:39.22,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:08:39.22,0:08:41.88,Default,,0000,0000,0000,,!سنُكشف إذا فتحت الأنوار
Dialogue: 0,0:08:42.56,0:08:45.39,Default,,0000,0000,0000,,عليكم جلب مصباح يدويّ على الأقل
Dialogue: 0,0:08:45.39,0:08:47.51,Default,,0000,0000,0000,,أحضرتُ واحداً بالفعل
Dialogue: 0,0:08:49.27,0:08:51.81,Default,,0000,0000,0000,,!تلك هي! هذه التماثيل الجصّية
Dialogue: 0,0:08:58.06,0:09:01.10,Default,,0000,0000,0000,,يوجد أثران بموضع التقاء التمثال والطاولة
Dialogue: 0,0:09:01.10,0:09:04.79,Default,,0000,0000,0000,,يبدو أنّ قصّة ميتسوهيكو\Nلم تكن مجرّد شائعة
Dialogue: 0,0:09:05.85,0:09:09.20,Default,,0000,0000,0000,,ما هذا؟ يوجد شيءٌ ملتصق\Nعلى جبهة التمثال
Dialogue: 0,0:09:09.77,0:09:11.66,Default,,0000,0000,0000,,شريط لاصق؟
Dialogue: 0,0:09:11.66,0:09:14.31,Default,,0000,0000,0000,,لا يبدو أنّه يوجد شيءٌ هنا
Dialogue: 0,0:09:14.31,0:09:17.18,Default,,0000,0000,0000,,هل نتّجه لمكتب الممرضة تالياً إذاً؟
Dialogue: 0,0:09:17.18,0:09:18.60,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:18.70,0:09:22.87,Default,,0000,0000,0000,,حسناً، نموذج تشريح، نموذج تشريح
Dialogue: 0,0:09:24.99,0:09:27.45,Default,,0000,0000,0000,,هذا غريب، إنّه ليس موجوداً
Dialogue: 0,0:09:27.45,0:09:29.99,Default,,0000,0000,0000,,أيمكن أنّه يركض في الرواق\Nكما جاء في الشائعات؟
Dialogue: 0,0:09:34.49,0:09:35.49,Default,,0000,0000,0000,,!أيومي-تشان
Dialogue: 0,0:09:37.95,0:09:39.66,Default,,0000,0000,0000,,!أيومي
Dialogue: 0,0:09:42.91,0:09:44.21,Default,,0000,0000,0000,,...مؤلم
Dialogue: 0,0:09:46.99,0:09:48.63,Default,,0000,0000,0000,,أأنتِ بخير يا أيومي-تشان؟
Dialogue: 0,0:09:48.63,0:09:49.51,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:49.66,0:09:52.72,Default,,0000,0000,0000,,لكن يبدو أنّي أسقطت\N...منديلي في مكانٍ ما
Dialogue: 0,0:09:52.95,0:09:54.11,Default,,0000,0000,0000,,ما ذلك؟
Dialogue: 0,0:09:54.74,0:09:58.28,Default,,0000,0000,0000,,!دمية! أظنّها كانت في هذا الصندوق
Dialogue: 0,0:09:58.28,0:10:00.24,Default,,0000,0000,0000,,!بالفعل! مذهل
Dialogue: 0,0:10:00.24,0:10:04.02,Default,,0000,0000,0000,,لا بدّ أنّ فصلاً في السابق\N!استعملها في مسرحية دمى
Dialogue: 0,0:10:04.62,0:10:08.49,Default,,0000,0000,0000,,لكن هذا غريب، لمَ يوجد الصندوق في الخارج؟
Dialogue: 0,0:10:09.95,0:10:14.16,Default,,0000,0000,0000,,!انظروا! لدمية سانزوهوشي هذه مثل اسمي الأخير
Dialogue: 0,0:10:14.16,0:10:15.33,Default,,0000,0000,0000,,!واسمي على ساكوجو
Dialogue: 0,0:10:16.16,0:10:22.62,Default,,0000,0000,0000,,!الرأس مقطوع
Dialogue: 0,0:10:16.71,0:10:18.29,Default,,0000,0000,0000,,اسمي أنا على تشو هاكّاي؟
Dialogue: 0,0:10:23.73,0:10:24.82,Default,,0000,0000,0000,,!ليس الرأس وحده
Dialogue: 0,0:10:24.82,0:10:27.95,Default,,0000,0000,0000,,!الدمية بأسرها في حالة يُرثى لها
Dialogue: 0,0:10:27.95,0:10:30.05,Default,,0000,0000,0000,,!أ-أيمكن أنّ أحدهم يستهدفني؟
Dialogue: 0,0:10:30.70,0:10:33.41,Default,,0000,0000,0000,,!صادف أنّها تحمل اسمك الأخير لا أكثر
Dialogue: 0,0:10:33.41,0:10:38.16,Default,,0000,0000,0000,,أجل! كان اسم أحد التلامذة\N!المشاركين في المسرحية غالباً
Dialogue: 0,0:10:38.16,0:10:39.97,Default,,0000,0000,0000,,كلا، ليس بالضرورة
Dialogue: 0,0:10:40.66,0:10:44.44,Default,,0000,0000,0000,,انظروا، اسم إيدوغاوا ليس شائعاً
Dialogue: 0,0:10:45.35,0:10:47.45,Default,,0000,0000,0000,,أهذه أسماؤنا الأخيرة حقّاً إذاً؟
Dialogue: 0,0:10:47.45,0:10:52.40,Default,,0000,0000,0000,,أيمكن أنّ هذا متّصل بانخفاض\Nعدد التلامذة مؤخراً؟
Dialogue: 0,0:10:53.32,0:10:55.53,Default,,0000,0000,0000,,!أيعني ذلك أنّي الضحيّة التالية؟
Dialogue: 0,0:10:55.53,0:11:01.49,Default,,0000,0000,0000,,!ليس كذلك! ضلّلتنا الشائعات لا أكثر
Dialogue: 0,0:11:01.49,0:11:05.38,Default,,0000,0000,0000,,كما أنّ التماثيل الجصّية كانت \N!في غرفة الفنون
Dialogue: 0,0:11:05.99,0:11:09.37,Default,,0000,0000,0000,,!ونموذج التشريح في مكتب الممرضة
Dialogue: 0,0:11:14.07,0:11:15.32,Default,,0000,0000,0000,,!ميتسوهيكو
Dialogue: 0,0:11:16.66,0:11:19.01,Default,,0000,0000,0000,,!نموذج التشريح أمام مكتب الممرضة
Dialogue: 0,0:11:19.29,0:11:20.37,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:11:22.07,0:11:24.82,Default,,0000,0000,0000,,!أين هو؟ لا أراه في أيّ مكان
Dialogue: 0,0:11:24.82,0:11:26.65,Default,,0000,0000,0000,,!لكنّي رأيتُه للتوّ
Dialogue: 0,0:11:28.63,0:11:30.96,Default,,0000,0000,0000,,!أنت! كونان! انتظر
Dialogue: 0,0:11:37.59,0:11:39.59,Default,,0000,0000,0000,,!إنّه هنا كما ترى
Dialogue: 0,0:11:39.59,0:11:41.55,Default,,0000,0000,0000,,لا بدّ أنّ الخوف جعلك\N!ترى شيئاً آخر
Dialogue: 0,0:11:41.95,0:11:45.93,Default,,0000,0000,0000,,كلا، انظروا لقاعدة نموذج التشريح هذا
Dialogue: 0,0:11:46.03,0:11:49.49,On Top,,0000,0000,0000,,الفصل 1-ب، يوشيدا أيومي
Dialogue: 0,0:11:46.44,0:11:49.49,Default,,0000,0000,0000,,المنديل الذي أسقطته أيومي-تشان\Nقبل قليل عالق أسفله
Dialogue: 0,0:11:49.86,0:11:54.92,Default,,0000,0000,0000,,أي أنّ هذا النموذج قد حُرّك\Nبعدما غادرنا مكتب الممرضة
Dialogue: 0,0:11:55.19,0:11:57.88,Default,,0000,0000,0000,,تحرّك من تلقاء نفسه إذاً؟
Dialogue: 0,0:11:58.15,0:12:01.80,Default,,0000,0000,0000,,لا تكوني حمقاء، حرّكه أحدهم بلا شكّ
Dialogue: 0,0:12:02.02,0:12:04.32,Default,,0000,0000,0000,,لكن لمَ قد يفعل ذلك؟
Dialogue: 0,0:12:04.32,0:12:06.51,Default,,0000,0000,0000,,أيمكن أنّه يحاول إخافتنا؟
Dialogue: 0,0:12:06.94,0:12:11.51,Default,,0000,0000,0000,,،لو كان يحاول إخافتنا فحسب\Nلما أعاده لمكانه الأصليّ
Dialogue: 0,0:12:14.60,0:12:17.95,Default,,0000,0000,0000,,لكن حمداً لله، لم تكن فعلة شبح، صحيح؟
Dialogue: 0,0:12:19.02,0:12:21.57,Default,,0000,0000,0000,,ما يثير الاشمئزاز أكثر من شبح
Dialogue: 0,0:12:22.19,0:12:28.11,Default,,0000,0000,0000,,هو شخص يتسلّل في هذا الوقت في المدرسة\N!ويقوم بأشياء غريبة
Dialogue: 0,0:12:36.97,0:12:38.36,Default,,0000,0000,0000,,!من هناك؟
Dialogue: 0,0:12:38.36,0:12:39.63,Default,,0000,0000,0000,,ما الأمر يا كونان؟
Dialogue: 0,0:12:39.86,0:12:43.88,Default,,0000,0000,0000,,!رأيت ظلّ أحدهم ينظر لنا من النافذة المقابلة
Dialogue: 0,0:12:48.52,0:12:51.64,Default,,0000,0000,0000,,ماذا؟ لا أحد هنا
Dialogue: 0,0:12:51.94,0:12:53.82,Default,,0000,0000,0000,,يستحيل أنّه كان موجوداً
Dialogue: 0,0:12:53.82,0:12:58.60,Default,,0000,0000,0000,,فقد رأيتُ نموذج التشريح من النافذة\N!المقابلة لمكتب الممرضة
Dialogue: 0,0:12:59.02,0:13:03.77,Default,,0000,0000,0000,,إذا سمع الفاعل صرختي، وأعاد النموذج لمكانه سريعاً
Dialogue: 0,0:13:03.77,0:13:06.65,Default,,0000,0000,0000,,ثمّ راقب من هذه النافذة
Dialogue: 0,0:13:06.65,0:13:10.58,Default,,0000,0000,0000,,!فكنّا لنلتقيه في طريقنا لمكتب الممرضة
Dialogue: 0,0:13:11.05,0:13:12.98,Default,,0000,0000,0000,,لا بدّ أنّها كانت مخيلتك يا كونان-كن
Dialogue: 0,0:13:12.98,0:13:15.90,Default,,0000,0000,0000,,كلا، كان أحدهم هنا بلا شكّ
Dialogue: 0,0:13:17.27,0:13:18.71,Default,,0000,0000,0000,,!انظري، هذه النافذة
Dialogue: 0,0:13:18.71,0:13:19.88,Default,,0000,0000,0000,,النافذة؟
Dialogue: 0,0:13:19.88,0:13:22.38,Default,,0000,0000,0000,,أترين البقعة البيضاء؟
Dialogue: 0,0:13:22.65,0:13:26.84,Default,,0000,0000,0000,,!إنّها دليلٌ على التصاق أحدهم بالنافذة، واستراقه النظر
Dialogue: 0,0:13:27.86,0:13:30.82,Default,,0000,0000,0000,,بأيّ حال، نحن في خطر بأنفسنا
Dialogue: 0,0:13:30.82,0:13:32.76,Default,,0000,0000,0000,,لنطلب قدوم الحارس هنا
Dialogue: 0,0:13:33.52,0:13:35.36,Default,,0000,0000,0000,,...حسناً، كان الهاتف في
Dialogue: 0,0:13:36.48,0:13:39.51,Default,,0000,0000,0000,,!يوجد هاتف في مكتب المعلّمين
Dialogue: 0,0:13:41.11,0:13:42.73,Default,,0000,0000,0000,,!أسرع يا كونان-كن
Dialogue: 0,0:13:43.32,0:13:45.87,Default,,0000,0000,0000,,لمَ باب مكتب المعلّمين مفتوح؟
Dialogue: 0,0:13:49.00,0:13:51.96,CharCard,,0000,0070,0010,,الحارس
Dialogue: 0,0:13:52.19,0:13:53.82,Default,,0000,0000,0000,,لا يردّ؟
Dialogue: 0,0:13:53.82,0:13:55.69,Default,,0000,0000,0000,,أوقع أمرٌ ما؟
Dialogue: 0,0:13:55.69,0:13:59.36,Default,,0000,0000,0000,,كلا، لعلّه ثمل وغطّ في النوم مُجدداً
Dialogue: 0,0:13:59.36,0:14:02.84,Default,,0000,0000,0000,,لطالما كان ذلك حال الحارس العجوز\Nمنذ الأيام الخوالي
Dialogue: 0,0:14:03.27,0:14:05.36,Default,,0000,0000,0000,,الأيام الخوالي؟
Dialogue: 0,0:14:05.36,0:14:07.76,Default,,0000,0000,0000,,ذلك ما قالته ران-نيتشان
Dialogue: 0,0:14:09.86,0:14:14.22,Default,,0000,0000,0000,,لا أستطيع إخبارهم أنّي \Nخريّج لهذه الابتدائيّة
Dialogue: 0,0:14:14.86,0:14:20.52,Default,,0000,0000,0000,,،لكن ما العمل الآن؟ لم يقع شيء\Nفلا أستطيع الاتّصال بالشرطة
Dialogue: 0,0:14:20.52,0:14:22.69,Default,,0000,0000,0000,,...مما يعني أن عليّ
Dialogue: 0,0:14:28.82,0:14:31.61,Default,,0000,0000,0000,,أجل، وكالة موري للتحرّي
Dialogue: 0,0:14:31.61,0:14:32.87,Default,,0000,0000,0000,,عمّ؟
Dialogue: 0,0:14:33.23,0:14:38.36,Default,,0000,0000,0000,,!كونان؟ أين أنت؟ ران قلقة جدّاً
Dialogue: 0,0:14:38.36,0:14:42.88,Default,,0000,0000,0000,,في ابتدائيّة تيتان! أيمكنك القدوم الآن؟
Dialogue: 0,0:14:42.88,0:14:44.84,Default,,0000,0000,0000,,آتي لمدرستك؟
Dialogue: 0,0:14:45.36,0:14:49.40,Default,,0000,0000,0000,,!يا أحمق! أنا تخرّجتُ من الابتدائيّة بالفعل
Dialogue: 0,0:14:49.40,0:14:53.47,Default,,0000,0000,0000,,ليس ذلك، أنا أحتاجك لأن تأتي هنا\N!فوراً مع ران-نيتشان
Dialogue: 0,0:14:53.47,0:14:57.07,Default,,0000,0000,0000,,!حسناً، عُلِم
Dialogue: 0,0:14:57.07,0:15:00.15,Default,,0000,0000,0000,,لمَ الجميع ثملون؟
Dialogue: 0,0:15:00.15,0:15:04.98,Default,,0000,0000,0000,,حسناً، لا يهمّ، سأبحث في أرجاء\Nالمدرسة أكثر حتّى يأتون
Dialogue: 0,0:15:07.36,0:15:08.90,Default,,0000,0000,0000,,!انتظر يا كونان
Dialogue: 0,0:15:10.78,0:15:12.36,Default,,0000,0000,0000,,ممن كان ذاك الاتّصال؟
Dialogue: 0,0:15:13.44,0:15:14.89,Default,,0000,0000,0000,,!اسمع، أبي
Dialogue: 0,0:15:19.32,0:15:21.25,Default,,0000,0000,0000,,هذا بهيجٌ نوعاً ما
Dialogue: 0,0:15:21.25,0:15:22.79,Default,,0000,0000,0000,,بهيج؟
Dialogue: 0,0:15:22.79,0:15:26.13,Default,,0000,0000,0000,,انظر، يبدو كأنّنا في حُلم
Dialogue: 0,0:15:28.07,0:15:30.26,Default,,0000,0000,0000,,ما-ما هذا الدخان؟
Dialogue: 0,0:15:33.53,0:15:34.39,Default,,0000,0000,0000,,!د-دم
Dialogue: 0,0:15:37.28,0:15:38.72,Default,,0000,0000,0000,,ليس دماً
Dialogue: 0,0:15:39.50,0:15:40.94,Default,,0000,0000,0000,,مجرّد طلاء أحمر
Dialogue: 0,0:15:41.86,0:15:42.69,Default,,0000,0000,0000,,طلاء؟
Dialogue: 0,0:15:43.40,0:15:47.15,Default,,0000,0000,0000,,يسكب أحدهم طلاءً من الأعلى\Nعبر فجوة سور السلّم
Dialogue: 0,0:15:47.52,0:15:52.82,Default,,0000,0000,0000,,يتقطّر الطلاء على هذه الورقة \Nالملصقة وينسكب على السور
Dialogue: 0,0:15:53.25,0:15:55.25,Default,,0000,0000,0000,,ما هذا الدخان إذاً؟
Dialogue: 0,0:15:55.38,0:15:59.36,Default,,0000,0000,0000,,ثلج جاف للتجارب العلميّة\Nأُضيف له ماء
Dialogue: 0,0:15:59.36,0:16:00.96,Default,,0000,0000,0000,,وجدتُه أعلى السلّم
Dialogue: 0,0:16:01.23,0:16:04.90,Default,,0000,0000,0000,,مما يعني أنّ الفاعل يحاول إخافتنا وجعلنا نرجع؟
Dialogue: 0,0:16:04.90,0:16:07.96,Default,,0000,0000,0000,,!حسناً، لنصعد ونمسك به
Dialogue: 0,0:16:08.23,0:16:11.40,Default,,0000,0000,0000,,لا جدوى، سيهرب غالباً
Dialogue: 0,0:16:11.40,0:16:13.93,Default,,0000,0000,0000,,...لكن إذا كان ذلك ما يريده، فعندها
Dialogue: 0,0:16:16.61,0:16:20.11,Default,,0000,0000,0000,,!أشباح! أشباح! أشعر بالخوف
Dialogue: 0,0:16:20.78,0:16:23.03,Default,,0000,0000,0000,,!هيّا، افعلوها أنتم أيضاً
Dialogue: 0,0:16:23.03,0:16:25.60,Default,,0000,0000,0000,,!فهمت، نتظاهر بالهرب
Dialogue: 0,0:16:26.07,0:16:27.44,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:16:37.57,0:16:40.76,Default,,0000,0000,0000,,ألا يمكننا الخروج الآن؟
Dialogue: 0,0:16:40.76,0:16:41.44,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:16:44.48,0:16:48.78,Default,,0000,0000,0000,,لكن تأخّر العمّ كثيراً، ما الذي يفعله؟
Dialogue: 0,0:16:52.07,0:16:53.03,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:16:53.20,0:16:55.25,Default,,0000,0000,0000,,!يـ-يوجد أشخاص
Dialogue: 0,0:16:55.25,0:16:57.15,Default,,0000,0000,0000,,!في فصلنا
Dialogue: 0,0:16:57.15,0:16:59.01,Default,,0000,0000,0000,,!وليسوا واحداً أو اثنين
Dialogue: 0,0:16:59.39,0:17:00.10,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:00.40,0:17:05.06,Default,,0000,0000,0000,,يوجد عشرة أشخاص! ما الذي يفعلونه\Nفي هذه الغرفة المظلمة؟
Dialogue: 0,0:17:05.47,0:17:07.48,Default,,0000,0000,0000,,ذلك الشخص الذي رأته أيومي-تشان إذاً؟
Dialogue: 0,0:17:07.48,0:17:09.11,Default,,0000,0000,0000,,ما ذلك؟ يحمل شيئاً
Dialogue: 0,0:17:11.69,0:17:14.15,Default,,0000,0000,0000,,فهمت، هكذا الأمر إذاً
Dialogue: 0,0:17:14.68,0:17:16.66,Default,,0000,0000,0000,,أين تذهب يا كونان؟
Dialogue: 0,0:17:17.15,0:17:20.12,Default,,0000,0000,0000,,أليس واضحاً؟ سأمسك بالفاعل
Dialogue: 0,0:17:23.94,0:17:25.91,Default,,0000,0000,0000,,أسيمضي هذا على ما يرام؟
Dialogue: 0,0:17:26.46,0:17:29.23,Default,,0000,0000,0000,,أيمكننا الإمساك به حقّاً؟
Dialogue: 0,0:17:29.23,0:17:29.92,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:17:36.11,0:17:37.44,Default,,0000,0000,0000,,!حسناً، ها هي
Dialogue: 0,0:17:45.94,0:17:47.58,Default,,0000,0000,0000,,الأنوار، الأنوار
Dialogue: 0,0:17:56.45,0:17:58.53,On Top,,0000,0000,0000,,يوشيدا
Dialogue: 0,0:18:00.19,0:18:03.15,Default,,0000,0000,0000,,!ما هذا؟ الدمية من قبل
Dialogue: 0,0:18:03.15,0:18:05.25,Default,,0000,0000,0000,,!الكثير منها موضوع على الطاولات أيضاً
Dialogue: 0,0:18:05.73,0:18:07.73,Default,,0000,0000,0000,,توجد تماثيل جصّية بجوار النوافذ
Dialogue: 0,0:18:07.73,0:18:09.71,Default,,0000,0000,0000,,يوجد نموذج تشريح أيضاً
Dialogue: 0,0:18:09.71,0:18:12.92,On Top,,0000,0000,0000,,آباء
Dialogue: 0,0:18:10.83,0:18:12.03,Default,,0000,0000,0000,,ما تلك الورقة؟
Dialogue: 0,0:18:12.03,0:18:12.92,Default,,0000,0000,0000,,آباء"؟"
Dialogue: 0,0:18:13.36,0:18:15.34,Default,,0000,0000,0000,,كأنّه فصل مفتوح
Dialogue: 0,0:18:15.52,0:18:16.73,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:18:16.73,0:18:18.86,Default,,0000,0000,0000,,استعمل الفاعل الدمى كتلامذة
Dialogue: 0,0:18:18.86,0:18:23.92,Default,,0000,0000,0000,,والتماثيل ونموذج التشريح كآباء\Nللتمرّن كلّ ليلة
Dialogue: 0,0:18:24.69,0:18:28.07,Default,,0000,0000,0000,,لأجل الفصل المفتوح الأسبوع القادم
Dialogue: 0,0:18:28.07,0:18:31.51,Default,,0000,0000,0000,,بينما يرتدي قناعاً\Nكيلا يُسمع صوته خارجاً
Dialogue: 0,0:18:32.65,0:18:37.32,Default,,0000,0000,0000,,ألستُ محقّاً؟ يا معلّمة الفصل 1-ب\N...المختبئة تحت المكتب
Dialogue: 0,0:18:38.83,0:18:40.49,Default,,0000,0000,0000,,!كوباياشي سينسي
Dialogue: 0,0:18:44.28,0:18:46.25,Default,,0000,0000,0000,,!بالفعل! إنّها كوباياشي سينسي
Dialogue: 0,0:18:51.15,0:18:55.75,Default,,0000,0000,0000,,القصص عن التماثيل المنتقلة\N...ونموذج التشريح الراكض إذاً
Dialogue: 0,0:18:56.39,0:18:59.57,Default,,0000,0000,0000,,لأنّ المعلّمة كانت تحملها\Nإلى هنا كلّ ليلة
Dialogue: 0,0:19:00.06,0:19:04.22,Default,,0000,0000,0000,,ما التبس عليهم بأنّه نموذج تشريح راكض\Nكانت هي وهي تنقله في عجلة
Dialogue: 0,0:19:04.88,0:19:09.14,Default,,0000,0000,0000,,لكن عليك التركيز أكثر على معاملتنا\Nبلطف بدل هذا التمرين
Dialogue: 0,0:19:09.96,0:19:14.03,Default,,0000,0000,0000,,!صحيح! عليكِ إصلاح سلوكك المعادي للأطفال أوّلاً
Dialogue: 0,0:19:14.03,0:19:16.36,Default,,0000,0000,0000,,كلا، الواقع عكس ذلك
Dialogue: 0,0:19:16.75,0:19:22.42,Default,,0000,0000,0000,,أنا أحبّ تلامذتي لحدٍّ شديد في الحقيقة
Dialogue: 0,0:19:23.96,0:19:29.50,Default,,0000,0000,0000,,كان تلامذتي أعزّاء جدّاً عليّ، فلم أستطع\Nالغضب منهم في مدرستي السابقة حتّى
Dialogue: 0,0:19:29.50,0:19:33.68,Default,,0000,0000,0000,,لكن في فصلي الأوّل المفتوح، توتّرت وفشلت فشلاً ذريعاً
Dialogue: 0,0:19:34.17,0:19:39.75,Default,,0000,0000,0000,,سخر منّي أحد الصبية آنذاك، وتشاجر معه الصبيّ بجواره
Dialogue: 0,0:19:39.75,0:19:41.61,Default,,0000,0000,0000,,فتأذّيا بشدّة
Dialogue: 0,0:19:41.79,0:19:45.57,Default,,0000,0000,0000,,لم أرد أن يتكرّر ذلك الأمر في هذه المدرسة
Dialogue: 0,0:19:46.25,0:19:50.16,Default,,0000,0000,0000,,لذا حجّرتُ قلبي، والتزمتُ الصرامة مع نفسي وتلامذتي
Dialogue: 0,0:19:51.13,0:19:55.96,Default,,0000,0000,0000,,لكن مع اقتراب الفصل المفتوح، ترجع لي تلك الذكريات
Dialogue: 0,0:19:55.96,0:19:58.33,Default,,0000,0000,0000,,فلا أستطيع الاحتمال
Dialogue: 0,0:19:58.33,0:20:01.42,Default,,0000,0000,0000,,أتمرّن كلّ ليلةٍ سرّاً هكذا
Dialogue: 0,0:20:02.83,0:20:06.50,Default,,0000,0000,0000,,أنت تشبه الصبيّ الذي افتعل\Nالشجار آنذاك يا كوجيما-كن
Dialogue: 0,0:20:06.50,0:20:08.59,Default,,0000,0000,0000,,لذا كنتُ قلقةً بالتحديد
Dialogue: 0,0:20:10.17,0:20:13.18,On Top,,0000,0000,0000,,كوجيما
Dialogue: 0,0:20:10.17,0:20:13.18,Default,,0000,0000,0000,,لذا كانت دمية غينتا وحدها مهترئة
Dialogue: 0,0:20:13.46,0:20:18.04,Default,,0000,0000,0000,,نتيجةً لذلك يخافني التلامذة، وينادونني بالعجوز الشيطانة
Dialogue: 0,0:20:18.04,0:20:21.15,Default,,0000,0000,0000,,ربما لا أصلح لأكون معلّمة
Dialogue: 0,0:20:21.51,0:20:25.07,Default,,0000,0000,0000,,!ليس صحيحاً! أعرف أنّك لطيفة
Dialogue: 0,0:20:25.67,0:20:28.88,Default,,0000,0000,0000,,أنتِ الوحيدة التي تروي الأزهار
Dialogue: 0,0:20:28.88,0:20:32.53,Default,,0000,0000,0000,,وتغيّر ماء السمك بعدما يغادر الجميع
Dialogue: 0,0:20:34.13,0:20:34.95,Default,,0000,0000,0000,,أليس كذلك؟
Dialogue: 0,0:20:35.82,0:20:40.33,Default,,0000,0000,0000,,بلى، لم يقم أيّ من معلّمي\Nبقيّة الفصول بذلك
Dialogue: 0,0:20:40.53,0:20:44.87,Default,,0000,0000,0000,,كنّا نقول جميعاً أنّ هذا غريب\Nعلى العجوز الشيطانة
Dialogue: 0,0:20:45.66,0:20:49.33,Default,,0000,0000,0000,,أي ببساطة، مهما زيّفتِ نفسك
Dialogue: 0,0:20:49.33,0:20:52.41,Default,,0000,0000,0000,,فلن تخدعي أعين الأطفال
Dialogue: 0,0:20:52.41,0:20:56.84,Default,,0000,0000,0000,,بما أنّ الحقيقة كُشفت، لمَ لا ترجعين لذاتك الحقيقيّة؟
Dialogue: 0,0:20:56.84,0:21:01.51,Default,,0000,0000,0000,,رغم أنّ عليك حلّ مشكلة توتّرك أوّلاً في حالتك
Dialogue: 0,0:21:02.03,0:21:03.47,Default,,0000,0000,0000,,أعرف
Dialogue: 0,0:21:04.03,0:21:08.44,Default,,0000,0000,0000,,لكن كان من القاسي استعمالك\N!للدخان والطلاء لإخافتنا يا معلّمة
Dialogue: 0,0:21:08.71,0:21:12.40,Default,,0000,0000,0000,,كنتِ من تراقبنا عبر النافذة، صحيح؟
Dialogue: 0,0:21:12.90,0:21:17.44,Default,,0000,0000,0000,,كلا، هذه أوّل مرّةٍ رأيتكم فيها الليلة
Dialogue: 0,0:21:17.44,0:21:21.78,Default,,0000,0000,0000,,فاجأني صراخ تسوبورايا-كن، فأعدت نموذج التشريح لمكانه
Dialogue: 0,0:21:21.78,0:21:25.57,Default,,0000,0000,0000,,وبقيت مختبئةً في مكتب الممرضة لفترة
Dialogue: 0,0:21:26.86,0:21:29.07,Default,,0000,0000,0000,,من فتح قفل باب مكتب المعلّمين إذاً؟
Dialogue: 0,0:21:29.55,0:21:32.04,Default,,0000,0000,0000,,مكتب المعلّمين؟ ما الذي تتكلّم عنه؟
Dialogue: 0,0:21:32.04,0:21:33.26,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:21:33.70,0:21:35.09,Default,,0000,0000,0000,,!كان هناك أحدهم بالفعل
Dialogue: 0,0:21:35.82,0:21:37.87,Default,,0000,0000,0000,,!انتظر! إيدوغاوا-كن
Dialogue: 0,0:21:38.03,0:21:39.92,Default,,0000,0000,0000,,!يوجد شخص آخر غير كوباياشي سينسي
Dialogue: 0,0:21:40.59,0:21:41.88,Default,,0000,0000,0000,,!هنالك نورٌ في مكتب المعلّمين
Dialogue: 0,0:21:42.04,0:21:43.25,Default,,0000,0000,0000,,!ها أنت
Dialogue: 0,0:21:44.57,0:21:46.17,Default,,0000,0000,0000,,نائب المدير؟
Dialogue: 0,0:21:49.39,0:21:51.90,Default,,0000,0000,0000,,!ما-ما الذي حلّ برأسك؟
Dialogue: 0,0:21:51.90,0:21:53.72,Default,,0000,0000,0000,,!كـ-كوباياشي سينسي
Dialogue: 0,0:21:58.15,0:22:02.00,Default,,0000,0000,0000,,من حاول إخافتنا لنرجع كان نائب المدير
Dialogue: 0,0:22:03.94,0:22:07.90,Default,,0000,0000,0000,,سبب قدومه هنا هو لإيجاد شعره المستعار\Nالذي قذفته الريح
Dialogue: 0,0:22:07.90,0:22:11.23,Default,,0000,0000,0000,,في مكتب المعلّمين قبل يومين
Dialogue: 0,0:22:11.23,0:22:17.79,Default,,0000,0000,0000,,من صنع ذاك المشهد الصادم كان\Nأوهاتا سينسي بعد فتحه للنافذة
Dialogue: 0,0:22:18.15,0:22:21.82,Default,,0000,0000,0000,,وبدأت رحلة البحث عن الشعر المستعار\N...الليلية المتأخّرة، لكن
Dialogue: 0,0:22:21.82,0:22:23.23,Default,,0000,0000,0000,,لا أجده بأيّ مكان
Dialogue: 0,0:22:23.23,0:22:24.57,Default,,0000,0000,0000,,لنتوقّف وحسب
Dialogue: 0,0:22:24.57,0:22:27.80,Default,,0000,0000,0000,,!كلا، كلا! لا يمكنني القدوم للمدرسة دونه
Dialogue: 0,0:22:29.36,0:22:33.61,Default,,0000,0000,0000,,وفي الواقع، كان المدير من يحتفظ به سرّاً
Dialogue: 0,0:24:07.67,0:24:09.88,Default,,0000,0000,0000,,!إنّها حجّة غياب مُطبقة
Dialogue: 0,0:24:10.17,0:24:14.29,Default,,0000,0000,0000,,!لكنّك من أعطى وقت الوفاة المقدّر
Dialogue: 0,0:24:14.29,0:24:16.84,Default,,0000,0000,0000,,!سنحتاج لرأي شخصٍ آخر
Dialogue: 0,0:24:17.54,0:24:19.68,Default,,0000,0000,0000,,!لا بدّ من وجود حيلةٍ ما
Dialogue: 0,0:24:20.33,0:24:23.88,Default,,0000,0000,0000,,!لا بدّ أن أطيح بحجّة غيابه
Dialogue: 0,0:24:25.72,0:24:31.72,On Top,,0000,0000,0000,,جريمة قتل شاطئ الرمل الأبيض
Dialogue: 0,0:24:26.33,0:24:27.71,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:27.71,0:24:30.46,Default,,0000,0000,0000,,جريمة قتل شاطئ الرمل الأبيض
Dialogue: 0,0:24:47.89,0:24:49.83,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.83,0:24:51.32,Default,,0000,0000,0000,,طوف عوم
Dialogue: 0,0:24:51.74,0:24:52.75,Default,,0000,0000,0000,,!نذهب للبحر الحلقة القادمة
Dialogue: 0,0:24:52.75,0:24:54.22,Default,,0000,0000,0000,,...نيابةً عن الطاقم
Dialogue: 0,0:24:54.22,0:24:56.37,Default,,0000,0000,0000,,!نتمنّى لكم صيفاً طيّباً

