Dialogue: 0,0:00:01.32,0:00:04.51,Default,,0000,0000,0000,,تصعب القضايا بتضاعف مع إقبال عامٍ جديد
Dialogue: 0,0:00:05.27,0:00:08.47,Default,,0000,0000,0000,,!يدخل كونان عامه الثاني اليوم! ويسقط في مأزق فوراً
Dialogue: 0,0:00:08.89,0:00:10.85,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.85,0:00:12.75,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:12.75,0:00:15.09,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.60,0:01:51.67,Title,,0000,0000,0000,,{\fad(300,0)}قضيّة اختطاف إيدوغاوا كونان
Dialogue: 0,0:01:46.61,0:01:49.90,Default,,0000,0000,0000,,قضيّة اختطاف إيدوغاوا كونان
Dialogue: 0,0:01:54.74,0:01:57.46,Default,,0000,0000,0000,,كونان-كن؟ أتصغي لي؟
Dialogue: 0,0:01:58.16,0:02:00.08,Default,,0000,0000,0000,,لا تجبني هكذا
Dialogue: 0,0:02:00.08,0:02:03.86,Default,,0000,0000,0000,,مضى وقتٌ طويل مذ انتقل والداك خارج البلاد
Dialogue: 0,0:02:03.86,0:02:07.36,Default,,0000,0000,0000,,وتركاك عندنا، ألا تفتقدهما؟
Dialogue: 0,0:02:07.36,0:02:08.57,Default,,0000,0000,0000,,ليس تماماً
Dialogue: 0,0:02:09.77,0:02:15.32,Default,,0000,0000,0000,,يا لهما من أبوين! لا يظهران أنفسهما\N!ولا اتّصال حتّى
Dialogue: 0,0:02:15.32,0:02:19.01,Default,,0000,0000,0000,,...تبّاً! كذبتي تُكشف
Dialogue: 0,0:02:19.01,0:02:25.11,Default,,0000,0000,0000,,مع أنّ والديّ الحقيقيّين خارج البلاد فعلاً، فليست كذبة بالكامل
Dialogue: 0,0:02:25.46,0:02:29.13,Default,,0000,0000,0000,,ألم يكن البروفسور آغاسا من جلبه هنا؟
Dialogue: 0,0:02:29.13,0:02:30.00,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:02:30.00,0:02:35.11,Default,,0000,0000,0000,,أليس علينا سؤاله عن كيفية التواصل\Nمع والديه على الأقل؟
Dialogue: 0,0:02:35.11,0:02:37.54,Default,,0000,0000,0000,,!لا-لا تفعلا ذلك
Dialogue: 0,0:02:37.54,0:02:38.40,Default,,0000,0000,0000,,!قادمة
Dialogue: 0,0:02:39.49,0:02:42.61,Default,,0000,0000,0000,,لمَ لا؟ هل التواصل معهما أمرٌ سيّئ؟
Dialogue: 0,0:02:42.61,0:02:48.82,Default,,0000,0000,0000,,تـ-تبّاً! إذا لم أتصرّف سريعاً\N!سيكتشفون أنّي كودو شينتشي
Dialogue: 0,0:02:50.28,0:02:51.98,Default,,0000,0000,0000,,!أتت! لقد أتت يا كونان-كن
Dialogue: 0,0:02:53.64,0:02:55.61,Default,,0000,0000,0000,,!إنّها أمّك
Dialogue: 0,0:02:56.41,0:03:00.31,Default,,0000,0000,0000,,آسفة يا كونان-تشان! لا بدّ أنّ الوحدة لازمتك
Dialogue: 0,0:03:00.31,0:03:02.23,Default,,0000,0000,0000,,لكن يمكنك الاسترخاء الآن
Dialogue: 0,0:03:03.26,0:03:05.57,Default,,0000,0000,0000,,هيّا، ارجع مع أمّك للبيت
Dialogue: 0,0:03:05.57,0:03:07.07,Default,,0000,0000,0000,,!مـ-من أنت؟
Dialogue: 0,0:03:07.07,0:03:08.76,Default,,0000,0000,0000,,ماذا؟ ليست هي؟
Dialogue: 0,0:03:08.76,0:03:15.24,Default,,0000,0000,0000,,يا إلهي، يتصرف بامتعاض وحسب\Nلأنّنا تركناه بمفرده لوقت طويل
Dialogue: 0,0:03:15.62,0:03:21.78,Default,,0000,0000,0000,,اسمي إيدوغاوا فوميو، أمّ إيدوغاوا كونان الحقيقية
Dialogue: 0,0:03:22.40,0:03:26.74,Default,,0000,0000,0000,,!كـ-كلا! إيدوغاوا كونان هو اسم مستعار ابتكرتُه
Dialogue: 0,0:03:26.74,0:03:28.82,Default,,0000,0000,0000,,!لا يمكن أن يمتلك والدين
Dialogue: 0,0:03:29.44,0:03:33.06,Default,,0000,0000,0000,,أقدّر اعتنائكما به، سأعطيكما عربون امتنان في وقتٍ آخر
Dialogue: 0,0:03:33.06,0:03:34.85,Default,,0000,0000,0000,,أجل! نتطلّع لذلك
Dialogue: 0,0:03:34.85,0:03:36.28,Default,,0000,0000,0000,,إلى اللقاء
Dialogue: 0,0:03:36.89,0:03:40.20,Default,,0000,0000,0000,,رافقتك السلامة يا كونان-كن! أرسل لنا\N!رسالةً عندما تصل
Dialogue: 0,0:03:43.38,0:03:46.91,Default,,0000,0000,0000,,!سيّدتي! لا تنسي عربون الامتنان
Dialogue: 0,0:03:51.09,0:03:53.03,Default,,0000,0000,0000,,مع السلامة يا كونان-كن
Dialogue: 0,0:03:55.71,0:03:56.99,Default,,0000,0000,0000,,من أنت يا عمّة؟
Dialogue: 0,0:03:58.37,0:04:01.53,Default,,0000,0000,0000,,أخبرتك، أنا أمّك
Dialogue: 0,0:04:01.53,0:04:03.11,Default,,0000,0000,0000,,...كلا! أمّي
Dialogue: 0,0:04:03.11,0:04:04.82,Default,,0000,0000,0000,,كودو يوكيكو
Dialogue: 0,0:04:05.82,0:04:11.40,Default,,0000,0000,0000,,أجل، أمّك هي ممثلة يابانية حسناء\Nسحرت أنظار رجال العالم
Dialogue: 0,0:04:11.40,0:04:16.95,Default,,0000,0000,0000,,وفازت بمختلف الجوائز الكبرى\Nوهي لا تزال في التاسعة عشرة
Dialogue: 0,0:04:17.52,0:04:20.98,Default,,0000,0000,0000,,لكنّها أُغرمت بالروائيّ الشاب كودو يوساكو
Dialogue: 0,0:04:20.98,0:04:24.68,Default,,0000,0000,0000,,وتزوّجت في العشرين ثمّ اعتزلت ببساطة
Dialogue: 0,0:04:24.68,0:04:29.01,Default,,0000,0000,0000,,أنجبت ابناً فيما بعد، لكنّها تركته للتجوّل حول العالم
Dialogue: 0,0:04:29.01,0:04:34.53,Default,,0000,0000,0000,,مع كودو يوساكو الذي أصبح\Nمؤلف غموض ذائع الصيت عالمياً
Dialogue: 0,0:04:35.17,0:04:39.91,Default,,0000,0000,0000,,أليس هذا صحيحاً يا ابنهما الوحيد، كودو شينتشي-كن؟
Dialogue: 0,0:04:40.62,0:04:46.86,Default,,0000,0000,0000,,أيمكن أنّها مع الرجال ذوي الرداء الأسود\N!الذين قلّصوا جسدي بالعقار؟
Dialogue: 0,0:04:46.86,0:04:48.66,Default,,0000,0000,0000,,على رسلك! لا تتحرك
Dialogue: 0,0:04:49.11,0:04:55.69,Default,,0000,0000,0000,,ابق ساكناً وسآخذك لمكانٍ جميل، مكان أكثر متعة
Dialogue: 0,0:04:58.60,0:05:01.59,Default,,0000,0000,0000,,!حمقاء! ما الذي تفعلينه؟! تحركي
Dialogue: 0,0:05:01.59,0:05:02.98,Default,,0000,0000,0000,,...ما الذي تفعله
Dialogue: 0,0:05:02.98,0:05:05.65,Default,,0000,0000,0000,,!ليمسك أحد بذاك الطفل
Dialogue: 0,0:05:14.79,0:05:18.44,Default,,0000,0000,0000,,كيف؟ كيف كشفوا هويّتي؟
Dialogue: 0,0:05:20.00,0:05:22.57,Default,,0000,0000,0000,,أيمكن لأنّي استعملت اسم كودو شينتشي
Dialogue: 0,0:05:22.57,0:05:24.90,Default,,0000,0000,0000,,!في جريمة قتل الكاراوكي؟
Dialogue: 0,0:05:25.28,0:05:30.07,Default,,0000,0000,0000,,سمعوا من مكانٍ ما أنّي لا أزال حيّاً\N...ولم يقتلني العقار
Dialogue: 0,0:05:30.74,0:05:34.90,Default,,0000,0000,0000,,!تبّاً! أكّدت على المفتّش ألا يذكر اسمي
Dialogue: 0,0:05:37.61,0:05:41.33,Default,,0000,0000,0000,,يا لحماقتي، إنّها غلطتي
Dialogue: 0,0:05:41.76,0:05:47.26,Default,,0000,0000,0000,,ماذا ستفعل الآن يا كودو شينتشي؟\Nأرجع لران وأكشف لها كلّ شيء؟
Dialogue: 0,0:05:47.26,0:05:51.73,Default,,0000,0000,0000,,...كلا، ستقع والعمّ في خطر إن فعلت الآن
Dialogue: 0,0:05:52.13,0:05:56.94,Default,,0000,0000,0000,,!سحقاً! ماذا أفعل؟ ماذا أفعل؟
Dialogue: 0,0:05:58.21,0:05:59.87,Default,,0000,0000,0000,,ماذا؟ هرب؟
Dialogue: 0,0:06:00.25,0:06:06.32,Default,,0000,0000,0000,,أجل، كان إهمالاً منّي. لكن يبدو أنّ ذاك \Nالطفل هو كودو شينتشي حقاً
Dialogue: 0,0:06:08.12,0:06:12.77,Default,,0000,0000,0000,,...فهمت، من كان ليتصوّر تقلّص جسده حقاً
Dialogue: 0,0:06:12.77,0:06:16.32,Default,,0000,0000,0000,,حسناً، ابحثي عنه! ستكون مشكلةً إن ذهب للشرطة
Dialogue: 0,0:06:16.32,0:06:17.57,Default,,0000,0000,0000,,لكن أين؟
Dialogue: 0,0:06:17.57,0:06:22.62,Default,,0000,0000,0000,,لا تقلقي، وجهته التالية ستكون هناك غالباً
Dialogue: 0,0:06:20.62,0:06:22.39,On Top,,0000,0000,0000,,منزل البروفسور آغاسا
Dialogue: 0,0:06:23.85,0:06:26.31,Default,,0000,0000,0000,,يبدو أنّ خياري الوحيد هو الكلام مع البروفسور آغاسا
Dialogue: 0,0:06:26.31,0:06:28.49,Default,,0000,0000,0000,,المطّلع على الوضع
Dialogue: 0,0:06:29.14,0:06:33.59,Default,,0000,0000,0000,,لكن ما الذي يأخّره؟ أين يتجوّل في وقت كهذا؟
Dialogue: 0,0:06:35.25,0:06:36.45,Default,,0000,0000,0000,,!رجع
Dialogue: 0,0:06:37.21,0:06:38.38,Default,,0000,0000,0000,,!بروفسور
Dialogue: 0,0:06:44.24,0:06:46.99,Default,,0000,0000,0000,,أحلام سعيدة يا فتى
Dialogue: 0,0:06:52.82,0:06:55.90,Default,,0000,0000,0000,,...أين أنا؟! يبدو كمطبخ
Dialogue: 0,0:06:57.36,0:07:00.36,Default,,0000,0000,0000,,تبّاً، لا أزال أشعر بدوار
Dialogue: 0,0:07:02.06,0:07:03.43,Default,,0000,0000,0000,,الطابق العلوي؟
Dialogue: 0,0:07:03.43,0:07:08.70,Default,,0000,0000,0000,,فهمت، نقلني أحدهم لهذا\Nالمنزل القديم بعدما فقدتُ وعيي
Dialogue: 0,0:07:09.02,0:07:11.32,Default,,0000,0000,0000,,!ماذا؟ لم تقتليه بعد؟
Dialogue: 0,0:07:11.45,0:07:13.59,Default,,0000,0000,0000,,!لا تصرخ عليّ
Dialogue: 0,0:07:13.59,0:07:15.11,Default,,0000,0000,0000,,كانت أوامر من الأعلى
Dialogue: 0,0:07:16.34,0:07:20.12,Default,,0000,0000,0000,,إنّها تلك المرأة. من الشخص أمامها؟
Dialogue: 0,0:07:21.50,0:07:27.32,Default,,0000,0000,0000,,تريده المنظمة عيّنةً لآثار العقار الجانبية
Dialogue: 0,0:07:27.32,0:07:30.78,Default,,0000,0000,0000,,فهمت، لذا لم تقتلني
Dialogue: 0,0:07:30.78,0:07:32.73,Default,,0000,0000,0000,,...لكن، ذاك الرجل
Dialogue: 0,0:07:32.97,0:07:34.61,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:07:36.41,0:07:40.65,Default,,0000,0000,0000,,من ذاك الرجل المقنّع؟ \N!تبّاً! إنّه قادم
Dialogue: 0,0:07:43.06,0:07:44.31,Default,,0000,0000,0000,,هل أفاق؟
Dialogue: 0,0:07:44.31,0:07:47.53,Default,,0000,0000,0000,,كلا، لا يزال تحت تأثير المنوّم
Dialogue: 0,0:07:47.53,0:07:52.63,Default,,0000,0000,0000,,لكن أهو متحرّي المرحلة الثانوية\Nكودو شينتشي حقّاً؟
Dialogue: 0,0:07:52.63,0:07:54.44,Default,,0000,0000,0000,,لا أزال عاجزة عن التصديق بدوري
Dialogue: 0,0:07:54.88,0:07:58.47,Default,,0000,0000,0000,,لكن يوم اختفاء كودو شينتشي تزامن
Dialogue: 0,0:07:58.47,0:08:01.90,Default,,0000,0000,0000,,مع ظهور ذاك الفتى في وكالة التحرّي
Dialogue: 0,0:08:02.62,0:08:06.86,Default,,0000,0000,0000,,وكلّ الجرائم التي وقعت بوجوده حُلّت بسهولة
Dialogue: 0,0:08:06.86,0:08:11.73,Default,,0000,0000,0000,,لا يظهر لي سوى أنّ العقار \Nالذي طوّرته المنظمة قلّصه فعلاً
Dialogue: 0,0:08:14.03,0:08:15.84,Default,,0000,0000,0000,,هل أجربه أيضاً إذاً؟
Dialogue: 0,0:08:15.84,0:08:16.86,Default,,0000,0000,0000,,تجربه؟
Dialogue: 0,0:08:17.49,0:08:21.53,Default,,0000,0000,0000,,لديّ أحدث عقار من المنظّمة بدوري
Dialogue: 0,0:08:22.94,0:08:28.82,Default,,0000,0000,0000,,إذا جعلتُ شخصاً آخر يتجرّعه\Nفسنكتشف إن كان يقلّص الناس حقاً
Dialogue: 0,0:08:29.39,0:08:31.53,Default,,0000,0000,0000,,لكن لِمَن نعطيه؟
Dialogue: 0,0:08:32.13,0:08:35.26,Default,,0000,0000,0000,,الشخص الذي سنعقد صفقة معه غداً
Dialogue: 0,0:08:35.26,0:08:39.43,Default,,0000,0000,0000,,يُفترض بنا التخلّص منه فور إتمام صفقة المنظمة
Dialogue: 0,0:08:39.43,0:08:41.53,Default,,0000,0000,0000,,إنّها الفرصة المثالية لاختبار العقار
Dialogue: 0,0:08:41.53,0:08:45.95,Default,,0000,0000,0000,,ماذا تنوي فعله إن وجدنا\Nأنّه يقلّص الناس حقاً؟
Dialogue: 0,0:08:45.95,0:08:50.24,Default,,0000,0000,0000,,...سنقتل طرف الصفقة الآخر للوقت الراهن، ثمّ
Dialogue: 0,0:08:50.24,0:08:52.19,Default,,0000,0000,0000,,نتخلّص من الطفل
Dialogue: 0,0:08:52.19,0:08:53.95,Default,,0000,0000,0000,,!ألم أخبرك؟
Dialogue: 0,0:08:53.95,0:09:00.66,Default,,0000,0000,0000,,أُمرنا بأخذه للمنظمة لدراسة\N!الآثار الجانبية للعقار
Dialogue: 0,0:09:00.66,0:09:02.90,Default,,0000,0000,0000,,لا يمكن ترك من يعرف أسرار المنظمة حيّاً
Dialogue: 0,0:09:02.90,0:09:04.03,Default,,0000,0000,0000,,!لكن
Dialogue: 0,0:09:04.03,0:09:05.40,Default,,0000,0000,0000,,!يكفي
Dialogue: 0,0:09:05.40,0:09:09.74,Default,,0000,0000,0000,,سنقوم بالأمور بطريقتي، لا تجعليني أحمل جثّةً أخرى
Dialogue: 0,0:09:10.06,0:09:11.69,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:09:12.39,0:09:16.47,Default,,0000,0000,0000,,بأيّ حال، هل أخبرت طرف الصفقة أين ستُعقد؟
Dialogue: 0,0:09:16.47,0:09:18.97,Default,,0000,0000,0000,,أجل، بالطريقة المعتادة
Dialogue: 0,0:09:18.97,0:09:23.04,Default,,0000,0000,0000,,،ستُعقد الصفقة عند الواحدة مساءً\Nاخلدي للنوم حتّى حينها
Dialogue: 0,0:09:29.63,0:09:32.32,Default,,0000,0000,0000,,حسنٌ، إنّهما مستغرقان في النوم
Dialogue: 0,0:09:32.82,0:09:37.78,Default,,0000,0000,0000,,!إنّه ينام مُرتدياً القناع! وغدٌ مريب
Dialogue: 0,0:09:38.12,0:09:41.53,Default,,0000,0000,0000,,!بأيّ حال، عليّ فك هذه الحبال والخروج من هنا
Dialogue: 0,0:09:42.27,0:09:44.52,Default,,0000,0000,0000,,!قنّينة نبيذ
Dialogue: 0,0:09:44.52,0:09:49.16,Default,,0000,0000,0000,,...حسنٌ! ألفّ السجّادة به و
Dialogue: 0,0:09:50.19,0:09:52.72,Default,,0000,0000,0000,,تبّاً! هل سمعا؟
Dialogue: 0,0:09:53.89,0:09:57.66,Default,,0000,0000,0000,,...يبدو أنّي بأمان. حسناً، سأستعمل شظيةً الآن لـ
Dialogue: 0,0:10:00.85,0:10:03.09,Default,,0000,0000,0000,,تخلّصتُ من الحبال
Dialogue: 0,0:10:03.88,0:10:07.21,Default,,0000,0000,0000,,لكن كيف أخرج من هذه الغرفة العلوية؟
Dialogue: 0,0:10:07.21,0:10:10.78,Default,,0000,0000,0000,,القفز خطر حتّى بوجود الثلج
Dialogue: 0,0:10:11.49,0:10:14.24,Default,,0000,0000,0000,,يبدو أنّ خياري الوحيد هو الاختباء\Nفي هذه الثلّاجة
Dialogue: 0,0:10:17.41,0:10:18.70,Default,,0000,0000,0000,,ما هذا الصوت؟
Dialogue: 0,0:10:19.24,0:10:23.36,Default,,0000,0000,0000,,...فهمت، النبيذ يتقطّر في مكانٍ ما
Dialogue: 0,0:10:24.73,0:10:26.15,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:10:27.32,0:10:29.74,Default,,0000,0000,0000,,ماذا؟ اختفى الطفل؟
Dialogue: 0,0:10:29.74,0:10:33.81,Default,,0000,0000,0000,,!أجل! لم أجده عندما استيقظت\N!لا بدّ أنّه هرب من النافذة
Dialogue: 0,0:10:33.81,0:10:34.57,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:10:38.39,0:10:42.88,Default,,0000,0000,0000,,!استعمل الثلج لتخفيف وقع سقوطه! لن يفلت
Dialogue: 0,0:10:44.13,0:10:46.55,Default,,0000,0000,0000,,!ماذا تفعل؟! لنبحث عنه بسرعة
Dialogue: 0,0:10:46.55,0:10:50.03,Default,,0000,0000,0000,,كلا، انتظري... إنّه لا يزال هنا
Dialogue: 0,0:10:52.49,0:10:53.62,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:53.62,0:10:57.17,Default,,0000,0000,0000,,تظاهر بالهروب وينتظر خروجنا\Nهنا في مكانٍ ما
Dialogue: 0,0:11:02.82,0:11:04.11,Default,,0000,0000,0000,,...أنت هنا إذاً
Dialogue: 0,0:11:06.57,0:11:07.53,Default,,0000,0000,0000,,!مُت
Dialogue: 0,0:11:14.47,0:11:16.70,Default,,0000,0000,0000,,عجباً، أخطأ حدسك
Dialogue: 0,0:11:17.60,0:11:20.60,Default,,0000,0000,0000,,لا مكان ليهرب له بأيّ حال
Dialogue: 0,0:11:20.60,0:11:24.34,Default,,0000,0000,0000,,سنجده بعد إتمام صفقة اليوم ونتخلّص منه
Dialogue: 0,0:11:30.80,0:11:32.73,Default,,0000,0000,0000,,ظننتُ أنّي هالك
Dialogue: 0,0:11:33.12,0:11:38.08,Default,,0000,0000,0000,,كنتُ لألقى حتفي لو لم أجد\Nالمخزن الصغير هذا أسفل السجّادة
Dialogue: 0,0:11:41.69,0:11:45.07,Default,,0000,0000,0000,,حسنٌ، سأبحث عن العقار بينما لديّ الفرصة
Dialogue: 0,0:11:50.49,0:11:52.81,Default,,0000,0000,0000,,تبّاً، لا أجده في أيّ مكان
Dialogue: 0,0:11:52.81,0:11:58.70,Default,,0000,0000,0000,,قال البروفسور آغاسا أنّنا قد نجد\Nطريقة لإعادة جسدي لطبيعته
Dialogue: 0,0:11:58.70,0:12:00.66,Default,,0000,0000,0000,,...لو درسنا تركيبته
Dialogue: 0,0:12:01.30,0:12:05.05,Default,,0000,0000,0000,,لعلّه أخذه لصفقة اليوم
Dialogue: 0,0:12:07.22,0:12:10.78,Default,,0000,0000,0000,,ما خطب هذه الصحيفة؟ مليئة بالثقوب
Dialogue: 0,0:12:11.66,0:12:16.21,Default,,0000,0000,0000,,لا بدّ أنّهما استخرجا أحرفاً منها
Dialogue: 0,0:12:16.21,0:12:18.74,Default,,0000,0000,0000,,لكتابة رسالة للرجل الذي يتعاملان معه
Dialogue: 0,0:12:19.29,0:12:25.20,Default,,0000,0000,0000,,...صحيح! قالا أنّهما سيقتلانه! هذا سيّئ
Dialogue: 0,0:12:25.20,0:12:29.41,Default,,0000,0000,0000,,عليّ إيجاد مكان الصفقة سريعاً\N!وإيقاف الجريمة والحصول على العقار
Dialogue: 0,0:12:30.15,0:12:36.69,Default,,0000,0000,0000,,،بناءً على الأحرف المفقودة\Nب، ي، ك، ا، ق، د، ن، ف
Dialogue: 0,0:12:36.69,0:12:41.98,Default,,0000,0000,0000,,"إذا أعدتُ ترتيبها... سأحصل على "فندق بيكا
Dialogue: 0,0:12:42.38,0:12:43.61,Default,,0000,0000,0000,,!فندق بيكا
Dialogue: 0,0:12:44.43,0:12:49.87,Default,,0000,0000,0000,,،لكن لا تحدّد أين في الفندق بالضبط\Nأهناك أحرف أخرى مفقودة؟
Dialogue: 0,0:12:54.33,0:12:57.33,Default,,0000,0000,0000,,لا فائدة، لم يُقطع شيء
Dialogue: 0,0:12:58.54,0:12:59.74,Default,,0000,0000,0000,,!علامات قاطع
Dialogue: 0,0:13:00.25,0:13:05.24,Default,,0000,0000,0000,,!فهمت! قُطعت صفحة أغسطس فوق هذه
Dialogue: 0,0:13:05.57,0:13:10.60,Default,,0000,0000,0000,,ما يعني أنّ يوم أغسطس الذي كان\N...فوق السابع والعشرين من سبتمبر
Dialogue: 0,0:13:10.97,0:13:12.19,Default,,0000,0000,0000,,!ثلاثون
Dialogue: 0,0:13:13.48,0:13:17.24,Default,,0000,0000,0000,,!فندق بيكا، ثلاثون! هذا مكان صفقتهم
Dialogue: 0,0:13:17.24,0:13:19.20,On Top,,0000,0000,0000,,فندق بيكا
Dialogue: 0,0:13:19.56,0:13:22.26,Default,,0000,0000,0000,,لكن ما المقصود بـ "فندق بيكا 30"؟
Dialogue: 0,0:13:22.26,0:13:26.93,Default,,0000,0000,0000,,بهذا الفندق 19 طابقاً فحسب، ولا توجد غرفة رقم 30
Dialogue: 0,0:13:26.93,0:13:29.66,Default,,0000,0000,0000,,رقم 19؟ لحظة من فضلك
Dialogue: 0,0:13:29.66,0:13:33.94,Default,,0000,0000,0000,,فهمت! قد يكون رقم حقائب! حسنٌ
Dialogue: 0,0:13:34.96,0:13:36.10,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:13:36.10,0:13:36.88,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:36.88,0:13:41.69,Default,,0000,0000,0000,,فقد أبي بطاقة رقمه، كان ثلاثين
Dialogue: 0,0:13:41.69,0:13:44.45,Default,,0000,0000,0000,,ثلاثين إذاً
Dialogue: 0,0:13:44.45,0:13:48.12,Default,,0000,0000,0000,,غريب، لدينا حتّى رقم 26 فحسب
Dialogue: 0,0:13:49.41,0:13:50.70,Default,,0000,0000,0000,,ماذا؟ يا صغير؟
Dialogue: 0,0:13:50.70,0:13:53.90,Default,,0000,0000,0000,,تبّاً! أين هم؟
Dialogue: 0,0:13:53.90,0:13:58.20,Default,,0000,0000,0000,,!هذا سيّئ! تجاوزنا الظهيرة! كانت الصفقة في الواحدة
Dialogue: 0,0:13:58.20,0:14:01.72,Default,,0000,0000,0000,,!كلا! نسيتُ محفظتي في السيّارة
Dialogue: 0,0:14:01.72,0:14:02.82,Default,,0000,0000,0000,,صدقاً؟
Dialogue: 0,0:14:02.82,0:14:04.15,Default,,0000,0000,0000,,أين ركنّا السيّارة؟
Dialogue: 0,0:14:04.15,0:14:06.24,Default,,0000,0000,0000,,الموقف 42، هاك المفتاح
Dialogue: 0,0:14:06.24,0:14:07.95,Default,,0000,0000,0000,,آسفة، سأعود فوراً
Dialogue: 0,0:14:08.35,0:14:09.89,Default,,0000,0000,0000,,مواقف السيّارات؟
Dialogue: 0,0:14:14.92,0:14:20.70,Default,,0000,0000,0000,,...هذه السيّارة المركونة في الموقف 30\Nأيمكن أنّ الصفقة ستُعقد داخلها؟
Dialogue: 0,0:14:21.83,0:14:23.61,Default,,0000,0000,0000,,لكن لا يوجد أحد في الداخل
Dialogue: 0,0:14:23.61,0:14:25.57,Default,,0000,0000,0000,,!أنت! ما الذي تفعله؟
Dialogue: 0,0:14:25.91,0:14:27.89,Default,,0000,0000,0000,,ما جلبك لسيّارتنا؟
Dialogue: 0,0:14:27.89,0:14:31.07,Default,,0000,0000,0000,,!أبي! لا بدّ أنّه لصّ! لصّ
Dialogue: 0,0:14:31.07,0:14:35.03,Default,,0000,0000,0000,,!كلا! ظننتُها سيّارةً رائعة وحسب
Dialogue: 0,0:14:35.44,0:14:38.49,Default,,0000,0000,0000,,لا يبدو أنّ لهم علاقة البتّة
Dialogue: 0,0:14:41.97,0:14:44.44,Default,,0000,0000,0000,,ربما ليس هذا أيضاً
Dialogue: 0,0:14:45.90,0:14:47.53,Default,,0000,0000,0000,,!يا للرجل الضخم
Dialogue: 0,0:14:51.63,0:14:52.94,Default,,0000,0000,0000,,ما الذي ينظر له؟
Dialogue: 0,0:14:53.84,0:14:55.40,Default,,0000,0000,0000,,رقم الموقف؟
Dialogue: 0,0:14:59.46,0:15:03.11,Default,,0000,0000,0000,,يوجد رقم واحد صغير\N!مكتوب بطبشور بجوار 30
Dialogue: 0,0:15:03.11,0:15:07.37,Default,,0000,0000,0000,,!فهمت، 301 هو رقم غرفة في الفندق غالباً
Dialogue: 0,0:15:07.37,0:15:11.31,Default,,0000,0000,0000,,!وهذا الرجل هو الطرف الآخر في صفقتهما
Dialogue: 0,0:15:17.86,0:15:19.09,Default,,0000,0000,0000,,!الرجل المقنّع
Dialogue: 0,0:15:20.36,0:15:23.06,Default,,0000,0000,0000,,هنا حيث سيعقدان الصفقة بالفعل إذاً
Dialogue: 0,0:15:26.93,0:15:27.91,Default,,0000,0000,0000,,!إنّها تلك المرأة
Dialogue: 0,0:15:29.02,0:15:30.86,Default,,0000,0000,0000,,!سحقاً! أنا مُحاصر
Dialogue: 0,0:15:31.51,0:15:35.82,Default,,0000,0000,0000,,سيقتلني هذا الرجل المقنّع\N!إن أمسك بي حتماً هذه المرّة
Dialogue: 0,0:15:35.82,0:15:40.09,Default,,0000,0000,0000,,!ماذا أفعل؟! ماذا أفعل؟! ماذا أفعل؟
Dialogue: 0,0:15:41.25,0:15:45.45,Default,,0000,0000,0000,,،فهمت يا ماساو. يُقفل الباب تلقائياً\Nلذا عليك إغلاقه فحسب
Dialogue: 0,0:15:45.75,0:15:47.50,Default,,0000,0000,0000,,كُن صالحاً في غيابي
Dialogue: 0,0:15:47.50,0:15:48.74,Default,,0000,0000,0000,,مع السلامة يا أمّي
Dialogue: 0,0:15:49.12,0:15:50.70,Default,,0000,0000,0000,,تأخّرتِ
Dialogue: 0,0:15:54.71,0:15:55.61,Default,,0000,0000,0000,,!لصّ
Dialogue: 0,0:15:56.66,0:15:59.99,Default,,0000,0000,0000,,لستُ شخصاً مريباً! أتيتُ من كوكب رانبو
Dialogue: 0,0:15:59.99,0:16:03.49,Default,,0000,0000,0000,,!لملاحقة فضائيين أشرار، أُدعى متحرّي الفضاء كونان
Dialogue: 0,0:16:03.73,0:16:06.52,Default,,0000,0000,0000,,!كاذب! أنت مجرد طفل
Dialogue: 0,0:16:06.52,0:16:10.76,Default,,0000,0000,0000,,استعرتُ هيئة الأطفال هذه لخداع أعدائي
Dialogue: 0,0:16:10.76,0:16:12.72,Default,,0000,0000,0000,,!أرني هيئتك الأصلية إذاً
Dialogue: 0,0:16:12.72,0:16:14.01,Default,,0000,0000,0000,,...لا، ذلك ليس
Dialogue: 0,0:16:14.01,0:16:15.16,Default,,0000,0000,0000,,!أنتَ لصّ بالفعل
Dialogue: 0,0:16:15.16,0:16:15.70,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:16:16.13,0:16:18.51,Default,,0000,0000,0000,,!قف مكانك! سأتّصل بالشرطة
Dialogue: 0,0:16:18.51,0:16:20.91,Default,,0000,0000,0000,,!توقف عن هذا يا ماساو
Dialogue: 0,0:16:20.91,0:16:22.44,Default,,0000,0000,0000,,!صـ-صوت أمّي
Dialogue: 0,0:16:23.87,0:16:27.41,Default,,0000,0000,0000,,أنا من كوكب رانبو، يمكنني استعمال أيّ صوت
Dialogue: 0,0:16:27.41,0:16:31.36,Default,,0000,0000,0000,,!مُذهل! أنت متحرّ فضاء حقاً
Dialogue: 0,0:16:32.95,0:16:35.28,Default,,0000,0000,0000,,يبدو أنّي خدعته بشكلٍ ما بمغيّر الصوت
Dialogue: 0,0:16:35.28,0:16:37.86,Default,,0000,0000,0000,,أخبرني، أهناك ما يمكنني المساعدة به؟
Dialogue: 0,0:16:37.86,0:16:41.56,Default,,0000,0000,0000,,أجل، أريد استعمال هاتفكم حالياً
Dialogue: 0,0:16:41.56,0:16:43.24,Default,,0000,0000,0000,,وهل لديك علكة؟
Dialogue: 0,0:16:43.24,0:16:47.70,Default,,0000,0000,0000,,أجل! لديّ! لكن لمَ؟
Dialogue: 0,0:16:50.60,0:16:51.41,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:16:51.41,0:16:53.86,Default,,0000,0000,0000,,جلبتُ طعاماً ونبيذاً
Dialogue: 0,0:16:53.86,0:16:56.52,Default,,0000,0000,0000,,ماذا؟ لم نطلب ذلك
Dialogue: 0,0:16:56.52,0:16:58.72,Default,,0000,0000,0000,,لكنّنا تلقينا اتّصالاً
Dialogue: 0,0:16:58.72,0:16:59.83,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:17:00.71,0:17:04.00,Default,,0000,0000,0000,,لا بأس، أنا أشعر بالجوع. أدخليه
Dialogue: 0,0:17:04.00,0:17:04.78,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:17:04.78,0:17:07.24,Default,,0000,0000,0000,,!يكفي! أدخليه فوراً
Dialogue: 0,0:17:08.12,0:17:10.42,Default,,0000,0000,0000,,حسناً، ادخل
Dialogue: 0,0:17:10.42,0:17:11.57,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:17:13.20,0:17:15.20,Default,,0000,0000,0000,,هيّا، لا تتباطأ
Dialogue: 0,0:17:15.20,0:17:17.20,Default,,0000,0000,0000,,!ارحل الآن
Dialogue: 0,0:17:20.77,0:17:21.69,Default,,0000,0000,0000,,علكة مكان القفل؟
Dialogue: 0,0:17:29.22,0:17:31.15,Default,,0000,0000,0000,,لنبدأ بنخب إذاً
Dialogue: 0,0:17:31.39,0:17:35.10,Default,,0000,0000,0000,,دعاني أقدّم ضيفنا الآخر أوّلاً
Dialogue: 0,0:17:35.46,0:17:38.98,Default,,0000,0000,0000,,!ضيفنا الآخر؟ أتقصد أنّ ذاك الفتى هنا؟
Dialogue: 0,0:17:40.92,0:17:43.79,Default,,0000,0000,0000,,ماذا؟ ليس موجوداً
Dialogue: 0,0:17:43.79,0:17:49.38,Default,,0000,0000,0000,,!هذه العربة طُعم... إنّه في الواقع... داخل هذه الخزانة
Dialogue: 0,0:17:49.38,0:17:51.23,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:17:51.65,0:17:52.51,Default,,0000,0000,0000,,اخرج
Dialogue: 0,0:17:52.51,0:17:54.19,Default,,0000,0000,0000,,!لكن متى دخل؟
Dialogue: 0,0:17:54.73,0:17:58.65,Default,,0000,0000,0000,,عندما كنّا نتكلم مع خادم الفندق
Dialogue: 0,0:17:58.65,0:18:02.69,Default,,0000,0000,0000,,ألصق علكةً بالباب لمنع الإقفال الآلي
Dialogue: 0,0:18:02.69,0:18:06.60,Default,,0000,0000,0000,,ثمّ تسلّل بينما تركيزنا على العربة
Dialogue: 0,0:18:08.81,0:18:11.57,Default,,0000,0000,0000,,أظننت حيلةً كهذه ستنطلي عليّ؟
Dialogue: 0,0:18:11.57,0:18:15.88,Default,,0000,0000,0000,,...تبّاً، خياري الوحيد هو استعمال ساعة المخدّر
Dialogue: 0,0:18:15.88,0:18:17.02,Default,,0000,0000,0000,,!لا تعمل
Dialogue: 0,0:18:17.38,0:18:22.71,Default,,0000,0000,0000,,عطّلتُ ساعتك المثيرة للاهتمام هذه\Nعندما أمسكنا بك أوّل مرّة
Dialogue: 0,0:18:22.71,0:18:23.36,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:18:23.75,0:18:27.87,Default,,0000,0000,0000,,...ستندم على استهانتك بي
Dialogue: 0,0:18:27.87,0:18:30.78,Default,,0000,0000,0000,,!يا متحرّي المرحلة الثانوية كودو شينتشي
Dialogue: 0,0:18:36.32,0:18:37.40,Default,,0000,0000,0000,,لعبة؟
Dialogue: 0,0:18:42.61,0:18:45.35,Default,,0000,0000,0000,,لم تكتشف بعد؟ إنّه أنا
Dialogue: 0,0:18:45.35,0:18:49.27,Default,,0000,0000,0000,,!روائي الغموض المشهور عالمياً، كودو يوساكو
Dialogue: 0,0:18:49.27,0:18:53.49,Default,,0000,0000,0000,,...أ-أبي؟ أيمكن أنّ هذه المرأة إذاً
Dialogue: 0,0:18:53.77,0:18:56.00,Default,,0000,0000,0000,,آسفة يا شين-تشان
Dialogue: 0,0:18:56.44,0:18:57.31,Default,,0000,0000,0000,,!أمّي
Dialogue: 0,0:18:57.88,0:19:02.78,Default,,0000,0000,0000,,عدم اكتشافك لهويّتي يعني\N!أنّي لا أزال أمتلك موهبة الممثلة
Dialogue: 0,0:19:03.67,0:19:05.27,Default,,0000,0000,0000,,...ذاك الرجل العملاق إذاً
Dialogue: 0,0:19:05.95,0:19:06.90,Default,,0000,0000,0000,,!إنّه أنا
Dialogue: 0,0:19:06.90,0:19:08.70,Default,,0000,0000,0000,,!بروفسور آغاسا
Dialogue: 0,0:19:10.65,0:19:14.15,Default,,0000,0000,0000,,لا تغضب هكذا، كنّا قلقين عليك بدورنا
Dialogue: 0,0:19:14.15,0:19:18.61,Default,,0000,0000,0000,,صحيح يا شين-تشان! لم نجدك في المنزل\N!بعدما عدنا من غيبتنا الطويلة
Dialogue: 0,0:19:18.61,0:19:23.36,Default,,0000,0000,0000,,ثمّ أخبركما البروفسور آغاسا عن تقلّصي بالعقار
Dialogue: 0,0:19:23.36,0:19:25.52,Default,,0000,0000,0000,,وألّفتما هذه المسرحية؟
Dialogue: 0,0:19:25.77,0:19:28.68,Default,,0000,0000,0000,,أردتُ اختبار مهاراتك في التحرّي
Dialogue: 0,0:19:28.68,0:19:34.30,Default,,0000,0000,0000,,ونجحتَ في تتبع كلّ الخيوط\N!التي تركناها لك للآن
Dialogue: 0,0:19:34.30,0:19:38.23,Default,,0000,0000,0000,,جرى كلّ شيء وفق مخططاتي حتى أطلقتُ عليك
Dialogue: 0,0:19:38.80,0:19:42.80,Default,,0000,0000,0000,,كنتَ تعرف أنّي مختبئ\N!في مخزن المطبخ آنذاك إذاً؟
Dialogue: 0,0:19:42.80,0:19:46.69,Default,,0000,0000,0000,,بالطبع! نجحتَ بالكاد كمتحرٍّ
Dialogue: 0,0:19:47.29,0:19:51.29,Default,,0000,0000,0000,,لكنّها غلطتك لعدم إدراكك تنكّري بشخصية بارون الليل
Dialogue: 0,0:19:51.29,0:19:53.89,Default,,0000,0000,0000,,!الذي يظهر في رواياتي
Dialogue: 0,0:19:53.89,0:19:58.27,Default,,0000,0000,0000,,!أحمق! لم يكن ذاك وقته! ظننتُ أنّي سأموت
Dialogue: 0,0:19:58.27,0:20:03.61,Default,,0000,0000,0000,,حقّاً؟ ما رأيك بأن تغادر هذا البلد الخطير إذاً
Dialogue: 0,0:20:03.61,0:20:06.23,Default,,0000,0000,0000,,وتعيش برخاء في الخارج مع أبويك؟
Dialogue: 0,0:20:08.27,0:20:09.77,Default,,0000,0000,0000,,صحيح يا شين-تشان
Dialogue: 0,0:20:09.77,0:20:14.31,Default,,0000,0000,0000,,فعلنا هذا كي تدرك الوضع الذي تعيش فيه
Dialogue: 0,0:20:14.31,0:20:18.68,Default,,0000,0000,0000,,لذا ساعدتهما في تمثيلهما يا شينتشي-كن
Dialogue: 0,0:20:19.77,0:20:26.10,Default,,0000,0000,0000,,،لديّ أصدقاء في الشرطة العالمية\Nسأطلب منهم البحث في أمور المنظمة
Dialogue: 0,0:20:26.29,0:20:30.71,Default,,0000,0000,0000,,سيحصلون على العقار في مرحلةٍ ما\Nوتتمكن من العودة لطبيعتك
Dialogue: 0,0:20:32.08,0:20:35.57,Default,,0000,0000,0000,,...لذا لتوقف لعبة التحرّي الخطرة
Dialogue: 0,0:20:35.57,0:20:36.90,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:20:36.90,0:20:40.73,Default,,0000,0000,0000,,!هذه قضيّتي! سأحلّها! لا تتدخلا
Dialogue: 0,0:20:40.73,0:20:42.36,Default,,0000,0000,0000,,...شين-تشان
Dialogue: 0,0:20:42.36,0:20:46.73,Default,,0000,0000,0000,,كما لا يمكنني مغادرة اليابان بعد
Dialogue: 0,0:20:49.02,0:20:50.06,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:20:50.06,0:20:53.40,Default,,0000,0000,0000,,لا بأس، لندعه يفعل ما يشاء لفترة
Dialogue: 0,0:20:53.40,0:20:54.89,Default,,0000,0000,0000,,...عزيزي
Dialogue: 0,0:20:54.89,0:20:58.15,Default,,0000,0000,0000,,لكن مقابل ذلك، سنأخذك خارج البلاد حالما تشتدّ الخطورة
Dialogue: 0,0:20:58.64,0:21:02.70,Default,,0000,0000,0000,,كما يبدو أنّ لديك سبباً آخر لعدم المغادرة
Dialogue: 0,0:21:05.13,0:21:07.06,Default,,0000,0000,0000,,!ستتركان ابنكما لدينا مُجدداً؟
Dialogue: 0,0:21:07.38,0:21:11.75,Default,,0000,0000,0000,,...أجل، أصرّ على البقاء هنا
Dialogue: 0,0:21:11.75,0:21:14.02,Default,,0000,0000,0000,,...لكن سيّدتي
Dialogue: 0,0:21:14.45,0:21:17.73,Default,,0000,0000,0000,,هذه نفقات الرعاية به
Dialogue: 0,0:21:18.07,0:21:20.78,Default,,0000,0000,0000,,اصرفوا قدرما تشاؤون
Dialogue: 0,0:21:22.28,0:21:23.81,Default,,0000,0000,0000,,!عشرة ملايين ينّ
Dialogue: 0,0:21:23.81,0:21:28.06,Default,,0000,0000,0000,,...بالطبع! الاعتناء بابنكما الظريف الصالح
Dialogue: 0,0:21:28.06,0:21:30.23,Default,,0000,0000,0000,,!سيكون من دواعي سروري
Dialogue: 0,0:21:31.86,0:21:33.25,Default,,0000,0000,0000,,بالمناسبة يا ران-سان
Dialogue: 0,0:21:33.25,0:21:33.72,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:21:33.72,0:21:38.56,Default,,0000,0000,0000,,اهتمي بهذا الطفل رجاءً، يبدو أنّه يحبّك
Dialogue: 0,0:21:39.33,0:21:41.19,Default,,0000,0000,0000,,ماذا؟ حقّاً يا كونان-كن؟
Dialogue: 0,0:21:41.35,0:21:42.40,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:21:42.63,0:21:44.43,Default,,0000,0000,0000,,...تبّاً لك
Dialogue: 0,0:23:19.91,0:23:22.58,Default,,0000,0000,0000,,كان ذلك مُسلياً حقاً
Dialogue: 0,0:23:22.58,0:23:26.19,Default,,0000,0000,0000,,!استحق الأمر ترك مخطوطاتي والهروب لليابان
Dialogue: 0,0:23:26.19,0:23:28.52,Default,,0000,0000,0000,,لكن هل سيكون شين-تشان بخير؟
Dialogue: 0,0:23:28.52,0:23:32.07,Default,,0000,0000,0000,,لا تقلقي، سيعترف بالهزيمة عاجلاً أو آجلاً
Dialogue: 0,0:23:32.07,0:23:35.33,Default,,0000,0000,0000,,بالمناسبة، ما رأيك برحلة حول العالم؟
Dialogue: 0,0:23:35.43,0:23:36.65,Default,,0000,0000,0000,,!فكرة رائعة
Dialogue: 0,0:23:36.65,0:23:37.66,Default,,0000,0000,0000,,!ها هو
Dialogue: 0,0:23:40.21,0:23:43.21,Default,,0000,0000,0000,,!إنّهم المُحرّرون الأجانب! كيف وجدوني؟
Dialogue: 0,0:23:43.41,0:23:44.80,Default,,0000,0000,0000,,!تلقّينا اتّصالاً من ابنك
Dialogue: 0,0:23:44.80,0:23:47.09,Default,,0000,0000,0000,,!لتنهِ الـ 308 صفحة الباقية
Dialogue: 0,0:23:47.28,0:23:48.35,Default,,0000,0000,0000,,!أحمق! نحن قبلك
Dialogue: 0,0:23:48.57,0:23:50.07,Default,,0000,0000,0000,,!أوقف طباعتنا
Dialogue: 0,0:23:50.52,0:23:51.47,Default,,0000,0000,0000,,نال منّا
Dialogue: 0,0:23:51.59,0:23:53.22,Default,,0000,0000,0000,,!ذاك الوغد
Dialogue: 0,0:24:03.03,0:24:04.52,Default,,0000,0000,0000,,!ما-ماذا حصل؟
Dialogue: 0,0:24:07.53,0:24:12.11,Default,,0000,0000,0000,,يبدو أنّ ديناميتاً زُرع في هذه الغرفة
Dialogue: 0,0:24:12.61,0:24:14.02,Default,,0000,0000,0000,,فعلة دموع؟
Dialogue: 0,0:24:14.02,0:24:18.61,Default,,0000,0000,0000,,!هـ-هذه السكّين! كان ريوجي وراء هذا
Dialogue: 0,0:24:22.03,0:24:23.48,Default,,0000,0000,0000,,!أنت القاتل
Dialogue: 0,0:24:24.52,0:24:26.11,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.11,0:24:28.47,Default,,0000,0000,0000,,جريمة قتل الأشقّاء هوتّا الثلاثة
Dialogue: 0,0:24:45.97,0:24:47.77,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.77,0:24:49.77,Default,,0000,0000,0000,,سماد
Dialogue: 0,0:24:50.17,0:24:52.47,Default,,0000,0000,0000,,يوجد مُجرم مفاجئ في الحلقة القادمة
Dialogue: 0,0:24:52.47,0:24:54.73,Default,,0000,0000,0000,,!فلتشاهدوا فيلم كونان لهذا العام

