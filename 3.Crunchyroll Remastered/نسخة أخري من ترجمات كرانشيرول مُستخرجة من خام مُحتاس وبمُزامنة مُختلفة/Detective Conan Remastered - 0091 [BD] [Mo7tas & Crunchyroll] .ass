Dialogue: 0,0:00:02.58,0:00:04.44,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مذنّب لامع
Dialogue: 0,0:00:04.44,0:00:07.78,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.78,0:00:11.52,Default,,0000,0000,0000,,!مسرح اليوم هو غرفة مشفى مشتركة! لتجد فيروس القضيّة
Dialogue: 0,0:00:11.52,0:00:13.20,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:13.20,0:00:15.27,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:15.27,0:00:17.03,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.43,0:01:57.22,Title,,0000,0000,15,,{\fad(300,0)}قضيّة السارق المنوّم في المشفى
Dialogue: 0,0:01:51.94,0:01:54.71,Default,,0000,0000,0000,,قضيّة السارق المنوّم في المشفى
Dialogue: 0,0:02:13.63,0:02:15.92,Default,,0000,0000,0000,,رجعت... ماذا؟
Dialogue: 0,0:02:15.92,0:02:19.74,Default,,0000,0000,0000,,ألم تكن ستذهب لحفلة\Nأوكينو يوكو-سان اليوم يا أبي؟
Dialogue: 0,0:02:29.82,0:02:31.57,Default,,0000,0000,0000,,!جوارب! جوارب
Dialogue: 0,0:02:29.82,0:02:31.57,On Top,,0000,0000,0000,,يا إلهي يا أبي
Dialogue: 0,0:02:31.57,0:02:33.48,Default,,0000,0000,0000,,!ربطة عنق! ربطة عنق
Dialogue: 0,0:02:31.57,0:02:33.48,On Top,,0000,0000,0000,,!توخَّ الحذر
Dialogue: 0,0:02:33.48,0:02:34.38,Default,,0000,0000,0000,,!معطف! معطف
Dialogue: 0,0:02:34.72,0:02:35.94,Default,,0000,0000,0000,,!تذكرة! تذكرة
Dialogue: 0,0:02:35.94,0:02:37.47,Default,,0000,0000,0000,,...و
Dialogue: 0,0:02:41.51,0:02:42.60,Default,,0000,0000,0000,,انتبه للأدراج
Dialogue: 0,0:02:54.55,0:02:58.80,Default,,0000,0000,0000,,أرجوكم! أنزلوني عند قاعة\N!حفلة أوكينو يوكو-تشان رجاءً
Dialogue: 0,0:02:59.45,0:03:02.49,Default,,0000,0000,0000,,اليوم آخر عرضٍ لها هناك
Dialogue: 0,0:03:02.49,0:03:07.26,Default,,0000,0000,0000,,!كسرت ساقك وتُنقل بالإسعاف، وليس سيّارة أجرة
Dialogue: 0,0:03:07.26,0:03:09.69,Default,,0000,0000,0000,,!يوكو-تشان
Dialogue: 0,0:03:09.86,0:03:11.56,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:03:11.56,0:03:13.68,On Top,,0000,0000,0000,,مشفى بيكا العام
Dialogue: 0,0:03:14.73,0:03:16.91,Default,,0000,0000,0000,,!يا له من مشفى كبير
Dialogue: 0,0:03:16.91,0:03:18.66,Default,,0000,0000,0000,,...بالفعل
Dialogue: 0,0:03:22.27,0:03:24.97,Default,,0000,0000,0000,,في أيّ غرفة العمّ؟
Dialogue: 0,0:03:24.97,0:03:27.49,Default,,0000,0000,0000,,لا أدري، سأذهب لسؤال مكتب الاستقبال
Dialogue: 0,0:03:40.25,0:03:42.12,Default,,0000,0000,0000,,!في الغرفة 503
Dialogue: 0,0:03:42.12,0:03:44.08,Default,,0000,0000,0000,,!حسنٌ! هيّا بنا
Dialogue: 0,0:03:52.27,0:03:54.15,On Top,,0000,0000,0000,,أكاباني غويمون\Nسيكيغوتشي دايسابورو\Nموري كوغورو
Dialogue: 0,0:03:57.06,0:04:01.06,Default,,0000,0000,0000,,!يا للسخافة! تسقط من الأدراج وتكسر عظامك
Dialogue: 0,0:04:01.06,0:04:04.18,Default,,0000,0000,0000,,!كما أنّ السبب كان حفلةً لأوكينو يوكو
Dialogue: 0,0:04:04.18,0:04:06.90,Default,,0000,0000,0000,,تعرف أنّ عليك ألّا\Nتسرع على الأدراج
Dialogue: 0,0:04:07.22,0:04:09.84,Default,,0000,0000,0000,,اصمتوا، لا أريد سماع هذا منكم
Dialogue: 0,0:04:09.84,0:04:13.05,Default,,0000,0000,0000,,خصوصاً أنّكم أتيتم للزيارة\Nفي طريقكم للعب
Dialogue: 0,0:04:13.05,0:04:14.30,Default,,0000,0000,0000,,كشفتنا؟
Dialogue: 0,0:04:14.30,0:04:17.71,Default,,0000,0000,0000,,سيعلّمنا كونان-كن لعب\N!كرة القدم في الحديقة
Dialogue: 0,0:04:17.71,0:04:19.60,Default,,0000,0000,0000,,فلترحلوا إذاً
Dialogue: 0,0:04:20.08,0:04:25.37,Default,,0000,0000,0000,,هوّن عليك يا موري-سان، أيهمّ إذا\Nزاروك في طريقهم فحسب؟
Dialogue: 0,0:04:25.37,0:04:30.56,Default,,0000,0000,0000,,كان لديّ الكثير من الزوّار عندما\Nدخلت المشفى بدايةً، لكن لا أحد مؤخراً
Dialogue: 0,0:04:31.07,0:04:33.98,Default,,0000,0000,0000,,عليك الامتنان لقدوم أحد لرؤيتك
Dialogue: 0,0:04:34.81,0:04:35.98,Default,,0000,0000,0000,,صحيح أيّها الجار؟
Dialogue: 0,0:04:37.52,0:04:39.94,Default,,0000,0000,0000,,ليس شخصاً ودوداً
Dialogue: 0,0:04:39.94,0:04:43.27,Default,,0000,0000,0000,,نٌقل إلى هنا قبل أسبوع تقريباً
Dialogue: 0,0:04:43.27,0:04:45.98,Default,,0000,0000,0000,,يبدو أنّه أصيب بشدّة في حادث مروريّ
Dialogue: 0,0:04:49.80,0:04:52.68,Default,,0000,0000,0000,,!يوشيو؟ من النادر رؤيتك
Dialogue: 0,0:04:53.26,0:04:56.18,Default,,0000,0000,0000,,كيف حال ظهرك يا أبي؟
Dialogue: 0,0:04:56.18,0:04:58.33,Default,,0000,0000,0000,,تحسّن كثيراً
Dialogue: 0,0:04:58.33,0:05:02.50,Default,,0000,0000,0000,,أمضيتُ أسبوعين في مشفى\Nبسبب ظهرٍ متدهور... مثير للشفقة
Dialogue: 0,0:05:02.50,0:05:04.14,Default,,0000,0000,0000,,أتأخذ دواءك؟
Dialogue: 0,0:05:05.75,0:05:06.85,Default,,0000,0000,0000,,نسيتُ أخذ جرعة اليوم
Dialogue: 0,0:05:08.45,0:05:12.85,Default,,0000,0000,0000,,تعرف أنّ ذلك لا يصحّ، فأنت تعاني من السكّري
Dialogue: 0,0:05:16.16,0:05:17.51,Default,,0000,0000,0000,,بالمناسبة، أين يومي-تشان؟
Dialogue: 0,0:05:23.90,0:05:25.19,Default,,0000,0000,0000,,لم تأت معك؟
Dialogue: 0,0:05:25.65,0:05:27.64,Default,,0000,0000,0000,,...يوميكو
Dialogue: 0,0:05:28.09,0:05:33.64,Default,,0000,0000,0000,,إنّها... ذ-ذهبت للتزلّج على الجليد مع صديقة
Dialogue: 0,0:05:33.64,0:05:38.46,Default,,0000,0000,0000,,هذا مؤسف، أردتُ رؤية وجه حفيدتي بعد غياب
Dialogue: 0,0:05:38.46,0:05:41.60,Default,,0000,0000,0000,,ليس باليد حيلة، فيوميكو تهوى اللعب
Dialogue: 0,0:05:47.45,0:05:48.71,Default,,0000,0000,0000,,ما خطبك يا رجل؟
Dialogue: 0,0:05:48.71,0:05:49.74,Default,,0000,0000,0000,,...لـ-لا
Dialogue: 0,0:05:49.74,0:05:51.24,Default,,0000,0000,0000,,!لا تحدّق بي
Dialogue: 0,0:05:51.24,0:05:52.84,Default,,0000,0000,0000,,!آ-آسف
Dialogue: 0,0:05:55.12,0:05:58.48,Default,,0000,0000,0000,,بالمناسبة، هل قبضوا على أولئك المجرمين؟
Dialogue: 0,0:05:58.48,0:06:03.23,Default,,0000,0000,0000,,أقصد السارقين الذي سطوا\Nعلى مصرفك الأسبوع الفائت
Dialogue: 0,0:06:03.98,0:06:06.69,Default,,0000,0000,0000,,لـ-لا، لا يزالون هاربين
Dialogue: 0,0:06:07.18,0:06:11.30,Default,,0000,0000,0000,,في تلك الحالة، لمَ لا تسأل \Nموري كوغورو-سان هناك؟
Dialogue: 0,0:06:11.30,0:06:13.43,Default,,0000,0000,0000,,قد يكتشف شيئاً
Dialogue: 0,0:06:13.43,0:06:14.10,Default,,0000,0000,0000,,مرحباً
Dialogue: 0,0:06:14.60,0:06:17.30,Default,,0000,0000,0000,,مـ-موري؟ ذاك المتحرّي الشهير؟
Dialogue: 0,0:06:19.07,0:06:19.76,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:06:21.15,0:06:25.99,Default,,0000,0000,0000,,لكن، كلّ ما فعلتُه هو\N...الارتجاف خوفاً تحت مكتبي
Dialogue: 0,0:06:25.99,0:06:27.22,Default,,0000,0000,0000,,مثير للشفقة
Dialogue: 0,0:06:27.22,0:06:30.06,Default,,0000,0000,0000,,أخبرني، أهم مجموعة اللصوص الذين
Dialogue: 0,0:06:30.06,0:06:33.48,Default,,0000,0000,0000,,سرقوا 100 مليون ينّ\Nولم يُقبض عليهم بعد؟
Dialogue: 0,0:06:33.85,0:06:37.42,Default,,0000,0000,0000,,صحيح، سرقوا مئة مليون في وضح النهار
Dialogue: 0,0:06:37.42,0:06:39.89,Default,,0000,0000,0000,,!دون أن يأذوا أحداً
Dialogue: 0,0:06:40.92,0:06:46.05,Default,,0000,0000,0000,,عطّلوا نظام الأمان سلفاً، وبناءً على أساليبهم الدقيقة
Dialogue: 0,0:06:46.05,0:06:49.47,Default,,0000,0000,0000,,فيبدو أنّ منظمتهم الإجرامية كبيرة
Dialogue: 0,0:06:54.21,0:06:56.90,Default,,0000,0000,0000,,مئة مليون ينّ؟ أتستطيع أكل أنقليس بذلك؟
Dialogue: 0,0:06:56.90,0:06:58.48,Default,,0000,0000,0000,,!تستطيع شراء أيّ شيء
Dialogue: 0,0:06:58.48,0:07:00.95,Default,,0000,0000,0000,,!الحصول على المال بالسرقة أمرٌ سيّئ
Dialogue: 0,0:07:00.95,0:07:02.57,Default,,0000,0000,0000,,...صـ-صحيح
Dialogue: 0,0:07:02.57,0:07:04.14,Default,,0000,0000,0000,,كم كان عدد السارقين؟
Dialogue: 0,0:07:04.57,0:07:08.55,Default,,0000,0000,0000,,،لـ-لا أدري، كما قلتُ قبل قليل\N...فقد كنتُ تحتي مكتبي أرتجف
Dialogue: 0,0:07:08.85,0:07:13.98,Default,,0000,0000,0000,,لكن لا بدّ أنّ قائدهم طلب منكم\Nرفع أيديكم بدايةً، أليس كذلك؟
Dialogue: 0,0:07:16.19,0:07:21.04,Default,,0000,0000,0000,,اخرسوا! إذا لم تريدوا الموت \N!فانبطحوا على الأرض ولا تتحركوا
Dialogue: 0,0:07:23.34,0:07:25.23,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:07:25.98,0:07:29.87,Default,,0000,0000,0000,,أبي، لديّ بعض الأعمال لذا سأذهب الآن
Dialogue: 0,0:07:29.87,0:07:31.12,Default,,0000,0000,0000,,ستغادر؟
Dialogue: 0,0:07:31.12,0:07:33.25,Default,,0000,0000,0000,,سآتي لزيارتك لاحقاً
Dialogue: 0,0:07:33.25,0:07:36.33,Default,,0000,0000,0000,,فلتجلب هديّةً وما شابه المرّة القادمة
Dialogue: 0,0:07:36.33,0:07:37.04,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:07:52.40,0:07:53.41,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:07:54.65,0:07:57.76,Default,,0000,0000,0000,,نحن من الشرطة. أنت سيكيغوتشي يوشيو-سان، صحيح؟
Dialogue: 0,0:07:58.26,0:07:59.72,Default,,0000,0000,0000,,أ-أجل، أهناك أمرٌ ما؟
Dialogue: 0,0:07:59.72,0:08:02.18,Default,,0000,0000,0000,,نودّ الاستعلام منك عن بعض الأشياء
Dialogue: 0,0:08:02.18,0:08:07.46,Default,,0000,0000,0000,,الرجل على السرير بجوار والدك\Nتعرّض لحادثٍ مروري
Dialogue: 0,0:08:07.46,0:08:09.97,Default,,0000,0000,0000,,هل أتى أحد لزيارته؟
Dialogue: 0,0:08:10.38,0:08:14.17,Default,,0000,0000,0000,,لـ-لا أدري، التقيتُه اليوم أوّل مرة
Dialogue: 0,0:08:14.17,0:08:16.56,Default,,0000,0000,0000,,...إ-إذاً، لديّ أعمال فسأغادر
Dialogue: 0,0:08:21.03,0:08:27.30,Default,,0000,0000,0000,,تخميني أنّ السارقين هربوا\Nخارج البلاد بقارب غالباً
Dialogue: 0,0:08:27.94,0:08:29.80,Default,,0000,0000,0000,,لعلّهم يختبئون في إحدى الجبال
Dialogue: 0,0:08:30.19,0:08:34.52,Default,,0000,0000,0000,,لا، قد يكونون في جولة تسوّق\N!بالمال الذي سرقوه
Dialogue: 0,0:08:34.86,0:08:38.26,Default,,0000,0000,0000,,لن يستعملوا المال الذي سرقوه فوراً
Dialogue: 0,0:08:38.26,0:08:40.47,Default,,0000,0000,0000,,أين يختبئون؟
Dialogue: 0,0:08:42.14,0:08:46.68,Default,,0000,0000,0000,,هناك احتمال كبير بأنّ مجموعة\Nالمجرمين لا تزال في القرب
Dialogue: 0,0:08:47.34,0:08:50.67,Default,,0000,0000,0000,,سارق المصرف لا يبدو أن يكون بالقرب
Dialogue: 0,0:08:47.68,0:08:52.27,Thoughts,,0000,0000,15,,غينكو: مصرف\Nكينكو: بالقرب
Dialogue: 0,0:08:50.67,0:08:51.97,Default,,0000,0000,0000,,!فهمتم؟
Dialogue: 0,0:08:54.43,0:08:56.09,Default,,0000,0000,0000,,لتكسر الساق الأخرى
Dialogue: 0,0:08:56.09,0:08:58.18,Default,,0000,0000,0000,,لترقد هنا للأبد
Dialogue: 0,0:08:58.47,0:09:00.74,Default,,0000,0000,0000,,ما رأيك يا سيكيغوتشي-سان؟
Dialogue: 0,0:09:01.09,0:09:01.62,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:03.59,0:09:06.54,Default,,0000,0000,0000,,...كان مفعماً بالحيوية قبل قليل
Dialogue: 0,0:09:06.54,0:09:08.41,Default,,0000,0000,0000,,أأصابه الإرهاق يا ترى؟
Dialogue: 0,0:09:11.04,0:09:14.75,Default,,0000,0000,0000,,لا يصحّ إيقاظه، لذا انتهت حفلة الاستنتاج
Dialogue: 0,0:09:14.75,0:09:16.91,Default,,0000,0000,0000,,هذا مُمل
Dialogue: 0,0:09:16.91,0:09:19.70,Default,,0000,0000,0000,,كونان، سيبدأ برنامج موسيقيّ عند الثالثة\Nتظهر فيه أوكينو يوكو-تشان
Dialogue: 0,0:09:19.70,0:09:21.70,Default,,0000,0000,0000,,وأريد مشاهدته في صالة الانتظار
Dialogue: 0,0:09:21.70,0:09:23.99,Default,,0000,0000,0000,,هلّا جلبت لي كرسيّاً متحرّكاً من الأسفل؟
Dialogue: 0,0:09:23.99,0:09:24.62,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:09:26.73,0:09:29.91,Default,,0000,0000,0000,,!حياة المشافي ليست سيّئة بين فترة وأخرى
Dialogue: 0,0:09:51.71,0:09:56.37,Default,,0000,0000,0000,,...مستحيل... لا أستطيع فعل ذلك
Dialogue: 0,0:09:56.37,0:09:58.32,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:09:58.70,0:10:02.62,Default,,0000,0000,0000,,لا تخبرني أنّك جبنت الآن
Dialogue: 0,0:10:03.20,0:10:08.61,Default,,0000,0000,0000,,!أ-أتدرك أنّ موري كوغورو في تلك الغرفة؟
Dialogue: 0,0:10:08.61,0:10:11.90,Default,,0000,0000,0000,,كما يوجد رجال شرطة يراقبون خارجها
Dialogue: 0,0:10:12.26,0:10:15.44,Default,,0000,0000,0000,,لا تهتم للشرطة، فقد تكفّلتُ بذلك
Dialogue: 0,0:10:15.44,0:10:17.07,Default,,0000,0000,0000,,ولا تقلق بشأن المتحرّي
Dialogue: 0,0:10:18.35,0:10:22.72,Default,,0000,0000,0000,,سيكون قد اختفى من الغرفة\Nقبل موعد الثالثة والنصف النهائيّ لك
Dialogue: 0,0:10:24.85,0:10:29.07,Default,,0000,0000,0000,,سيذهب لمشاهدة برنامج فنّانين\Nفي صالة الانتظار عند الثالثة
Dialogue: 0,0:10:29.07,0:10:32.99,Default,,0000,0000,0000,,ذهب أولئك الأطفال لجلب\Nكرسي متحرّك له الآن
Dialogue: 0,0:10:33.79,0:10:36.78,Default,,0000,0000,0000,,!لكن، لا أستطيع فعل ذلك أمام أبي
Dialogue: 0,0:10:36.78,0:10:39.45,Default,,0000,0000,0000,,أعطيته الحبوب المنوّمة، صحيح؟
Dialogue: 0,0:10:40.16,0:10:41.81,Default,,0000,0000,0000,,لا حاجة للقلق إذاً
Dialogue: 0,0:10:42.49,0:10:45.33,Default,,0000,0000,0000,,!ا-ابنتي! هل يوميكو بخير؟
Dialogue: 0,0:10:47.36,0:10:49.64,Default,,0000,0000,0000,,يا إلهي، لا حلّ معك
Dialogue: 0,0:10:57.10,0:10:59.97,Default,,0000,0000,0000,,مرحباً؟ ماذا؟ ما الأمر؟
Dialogue: 0,0:10:59.97,0:11:00.70,Default,,0000,0000,0000,,ابنته؟
Dialogue: 0,0:11:01.70,0:11:05.66,Default,,0000,0000,0000,,إنّها تستمتع بوقتها، أتريد أن أعطيها الهاتف؟
Dialogue: 0,0:11:07.34,0:11:08.11,Default,,0000,0000,0000,,اسمع
Dialogue: 0,0:11:08.11,0:11:09.00,Default,,0000,0000,0000,,أبي؟
Dialogue: 0,0:11:09.00,0:11:10.86,Default,,0000,0000,0000,,!يـ-يوميكو
Dialogue: 0,0:11:11.34,0:11:14.88,Default,,0000,0000,0000,,!أنا أستمتع كثيراً مع آنسة لطيفة هنا
Dialogue: 0,0:11:14.88,0:11:17.82,Default,,0000,0000,0000,,تعال لأخذي بعدما تنتهي\Nمن الكلام مع الطبيب، حسناً؟
Dialogue: 0,0:11:17.82,0:11:19.28,Default,,0000,0000,0000,,!يوميكو
Dialogue: 0,0:11:22.91,0:11:24.30,Default,,0000,0000,0000,,!يوميكو
Dialogue: 0,0:11:26.04,0:11:28.53,Default,,0000,0000,0000,,هاك، هذه هديّته
Dialogue: 0,0:11:34.24,0:11:35.63,Default,,0000,0000,0000,,تعرف ما تفعل، صحيح؟
Dialogue: 0,0:11:36.44,0:11:40.97,Default,,0000,0000,0000,,ستكون فرصتك هي قبل قيام الأطباء\Nبجولاتهم التفقدية عند الثالثة والنصف
Dialogue: 0,0:11:40.97,0:11:42.69,Default,,0000,0000,0000,,والحراسة مخففة
Dialogue: 0,0:11:43.18,0:11:44.37,Default,,0000,0000,0000,,يُفترض أن يكون الأمر بسيطاً
Dialogue: 0,0:11:44.37,0:11:50.34,Default,,0000,0000,0000,,لـ-لكني لم أقتل أحداً قبلاً! لم يسبق لي\N!الإطلاق أو حمل مسدّس بالأصل
Dialogue: 0,0:11:50.34,0:11:54.96,Default,,0000,0000,0000,,مهلك! ستثير الشبهة إذا رفعت صوتك
Dialogue: 0,0:11:54.96,0:12:01.33,Default,,0000,0000,0000,,اسمع، ضع المسدّس بجسده\Nواضغط الزناد ولن تخفق أبداً
Dialogue: 0,0:12:01.63,0:12:04.99,Default,,0000,0000,0000,,استجمع شجاعتك واقتله
Dialogue: 0,0:12:05.84,0:12:07.35,Default,,0000,0000,0000,,عندها سينتهي كلّ شيء
Dialogue: 0,0:12:07.35,0:12:09.66,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:12:09.66,0:12:16.09,Default,,0000,0000,0000,,لا يزال هناك وقت، اغسل وجهك في \Nدورة المياه واهدأ ثم افعلها
Dialogue: 0,0:12:16.09,0:12:17.74,Default,,0000,0000,0000,,لأجل ابنتك
Dialogue: 0,0:12:30.41,0:12:31.91,Default,,0000,0000,0000,,تأخّرت يا كونان-كن
Dialogue: 0,0:12:31.91,0:12:33.59,Default,,0000,0000,0000,,يا إلهي! ما الذي كنت تفعله؟
Dialogue: 0,0:12:33.59,0:12:36.86,Default,,0000,0000,0000,,آسف، أوجعتني معدتي فجأة
Dialogue: 0,0:12:36.86,0:12:39.53,Default,,0000,0000,0000,,هل غسلت يديك كما يجب؟
Dialogue: 0,0:12:39.53,0:12:41.55,Default,,0000,0000,0000,,لا أريد سماع ذلك منك
Dialogue: 0,0:12:43.56,0:12:45.93,Default,,0000,0000,0000,,أنتم متأكدون إذاً؟
Dialogue: 0,0:12:45.93,0:12:49.77,Default,,0000,0000,0000,,أجل، آثار إطارات السيّارة المستعملة\Nفي عمليّة السطو
Dialogue: 0,0:12:49.77,0:12:53.34,Default,,0000,0000,0000,,تطابق آثار إطارات السيّارة\Nالتي كان أكاباني فيها
Dialogue: 0,0:12:53.34,0:13:00.35,Default,,0000,0000,0000,,ظنّ السارقون أنّ أكاباني أصيب\Nفي الحادث ومات، فتركوه
Dialogue: 0,0:13:30.14,0:13:34.13,Default,,0000,0000,0000,,يا للمصادفة العجيبة، أكاباني في غرفة المتحرّي موري
Dialogue: 0,0:13:34.13,0:13:37.63,Default,,0000,0000,0000,,عجباً، سمعت أنّه كسر عظامه
Dialogue: 0,0:13:37.63,0:13:39.68,Default,,0000,0000,0000,,أجل، ساقه اليمنى
Dialogue: 0,0:13:39.68,0:13:41.17,Default,,0000,0000,0000,,!مُجدداً؟
Dialogue: 0,0:13:41.87,0:13:45.45,Default,,0000,0000,0000,,!كسر تلك الساق قبل فترة قصيرة
Dialogue: 0,0:13:46.00,0:13:48.39,Default,,0000,0000,0000,,يا للرجل سيّئ الحظ
Dialogue: 0,0:13:48.71,0:13:51.15,Default,,0000,0000,0000,,بأيّ حال، سأرجع للمركز
Dialogue: 0,0:13:51.15,0:13:55.45,Default,,0000,0000,0000,,عندما ترونه أصبح قابلاً للاستجواب، فاجلبوه فوراً
Dialogue: 0,0:13:55.45,0:13:57.33,Default,,0000,0000,0000,,عُلِم سيّدي المفتّش
Dialogue: 0,0:13:57.76,0:13:59.45,Default,,0000,0000,0000,,مـ-مفتّش؟
Dialogue: 0,0:13:59.45,0:14:04.51,Default,,0000,0000,0000,,هذه فرصتي! ذاك الشخص الذي\N!يراقبني ليس هنا
Dialogue: 0,0:14:04.77,0:14:09.98,Default,,0000,0000,0000,,...إذا بحتُ بكلّ شيء للمفتّش هنا، قد يستطيع
Dialogue: 0,0:14:11.18,0:14:12.88,Default,,0000,0000,0000,,!الـ-المعذرة
Dialogue: 0,0:14:14.22,0:14:16.47,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:14:16.47,0:14:19.72,Default,,0000,0000,0000,,...أ-أجل، في الواقع
Dialogue: 0,0:14:20.43,0:14:21.80,Default,,0000,0000,0000,,لا تعبث معنا
Dialogue: 0,0:14:23.25,0:14:28.45,Default,,0000,0000,0000,,سمعتَ من رفيقي، أنت تحت أنظار مراقبتنا دوماً
Dialogue: 0,0:14:29.10,0:14:33.34,Default,,0000,0000,0000,,جرّب الاستخفاف بنا ثانيةً\Nوستنال جزاءك الفوريّ
Dialogue: 0,0:14:33.95,0:14:35.41,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:14:35.41,0:14:40.36,Default,,0000,0000,0000,,لا شيء، سألني إذا ما كنتُ أحمل \Nدواءً معي بما أنّه يشعر بتوعّك
Dialogue: 0,0:14:40.36,0:14:43.34,Default,,0000,0000,0000,,عليك سؤال الأطبّاء وليس الشرطة في ذلك
Dialogue: 0,0:14:43.34,0:14:44.85,Default,,0000,0000,0000,,!صدقاً
Dialogue: 0,0:15:18.43,0:15:22.63,Default,,0000,0000,0000,,!كم يستغرق جلب كرسيّ متحرّك واحد؟
Dialogue: 0,0:15:22.90,0:15:26.36,Default,,0000,0000,0000,,رحل كونان لمكانٍ ما فجأة\N!فذهبنا للبحث عنه
Dialogue: 0,0:15:26.36,0:15:29.63,Default,,0000,0000,0000,,!كونان الوغد! سأنفذ عليك التفافة كوبرا لاحقاً
Dialogue: 0,0:15:34.85,0:15:36.93,Default,,0000,0000,0000,,!كونان، تبّاً لك
Dialogue: 0,0:15:36.93,0:15:39.18,Default,,0000,0000,0000,,!ادفعوا! ادفعوا! ادفعوا
Dialogue: 0,0:15:41.29,0:15:42.71,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:15:42.71,0:15:44.38,Default,,0000,0000,0000,,!أنا المتألّم
Dialogue: 0,0:15:44.38,0:15:48.17,Default,,0000,0000,0000,,!ما الذي كنت تفعله؟! سيبدأ برنامج يوكو-تشان
Dialogue: 0,0:15:48.17,0:15:50.34,Default,,0000,0000,0000,,تغادر دوماً
Dialogue: 0,0:15:50.34,0:15:53.08,Default,,0000,0000,0000,,!كونان! ادفع معهم! عليّ الذهاب للتلفاز بسرعة
Dialogue: 0,0:15:53.08,0:15:54.12,Default,,0000,0000,0000,,!آسف، آسف
Dialogue: 0,0:15:54.12,0:15:57.66,Default,,0000,0000,0000,,!ستكون غلطتكم إذا انتهى غناء يوكو-تشان
Dialogue: 0,0:15:57.66,0:15:59.35,Default,,0000,0000,0000,,!لم يبدأ بعد حتّى
Dialogue: 0,0:16:00.49,0:16:02.07,Default,,0000,0000,0000,,!انظر
Dialogue: 0,0:16:02.07,0:16:03.46,Default,,0000,0000,0000,,!وصلتُ في الوقت
Dialogue: 0,0:16:04.94,0:16:07.52,Default,,0000,0000,0000,,اسمعوا، أريد طلب شيءٍ منكم
Dialogue: 0,0:16:08.41,0:16:09.24,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:16:09.24,0:16:09.98,Default,,0000,0000,0000,,ما هو؟
Dialogue: 0,0:16:11.64,0:16:13.47,Default,,0000,0000,0000,,!فهمنا، دع الأمر لنا
Dialogue: 0,0:16:13.47,0:16:15.39,Default,,0000,0000,0000,,نخبرها بذلك فحسب؟
Dialogue: 0,0:16:15.39,0:16:16.22,Default,,0000,0000,0000,,!هيّا بنا
Dialogue: 0,0:16:18.68,0:16:21.38,Default,,0000,0000,0000,,أنتم! مهلاً! ألن تشاهدوا؟
Dialogue: 0,0:16:22.09,0:16:26.32,Default,,0000,0000,0000,,،لا أستطيع، طريقي مسدود\Nلن يصدقني أحد الآن
Dialogue: 0,0:16:28.09,0:16:29.77,Default,,0000,0000,0000,,الثالثة وأربع وعشرون
Dialogue: 0,0:16:30.63,0:16:36.18,Default,,0000,0000,0000,,...الحدّ الزمني هو الثالثة والنصف\N...إذا لم أقتله قبل ذلك، يوميكو سوف
Dialogue: 0,0:16:38.12,0:16:40.92,Default,,0000,0000,0000,,...يوميكو سوف تُلقى من ذاك السطح
Dialogue: 0,0:16:40.92,0:16:42.99,Default,,0000,0000,0000,,كلا، عليّ فعلها
Dialogue: 0,0:16:44.61,0:16:46.78,Default,,0000,0000,0000,,!عليّ فعلها وإلّا ستموت
Dialogue: 0,0:16:46.78,0:16:49.98,Default,,0000,0000,0000,,قالوا أنّهم سيتكفلون بالأمور\Nبحيث لا يكتشفني أحد
Dialogue: 0,0:16:49.98,0:16:52.88,Default,,0000,0000,0000,,وسأقتل سارق المصرف ذاك فحسب
Dialogue: 0,0:16:52.88,0:16:55.18,Default,,0000,0000,0000,,...لن يهتمّ أحد إذا
Dialogue: 0,0:16:55.64,0:16:56.47,Default,,0000,0000,0000,,لا تفعلها
Dialogue: 0,0:16:57.52,0:17:01.72,Default,,0000,0000,0000,,طُلِب منك قتل ذاك الرجل أكاباني، صحيح يا عمّ؟
Dialogue: 0,0:17:02.34,0:17:05.43,Default,,0000,0000,0000,,باستعمال السلاح داخل\Nصندوق الكعك بالقشدة هذا
Dialogue: 0,0:17:06.26,0:17:07.59,Default,,0000,0000,0000,,وما أدراك بذلك؟
Dialogue: 0,0:17:07.59,0:17:10.39,Default,,0000,0000,0000,,!صه! لا تنظر لي! سينتبهون
Dialogue: 0,0:17:15.20,0:17:16.63,Default,,0000,0000,0000,,...كيف
Dialogue: 0,0:17:16.63,0:17:18.22,Default,,0000,0000,0000,,صندوق الكعك
Dialogue: 0,0:17:19.08,0:17:23.24,Default,,0000,0000,0000,,لا يستطيع والدك تناول الحلويات\Nبما أنّه مُصاب بالسكّري
Dialogue: 0,0:17:23.24,0:17:25.24,Default,,0000,0000,0000,,من الطبيعي أن يشتبه أيّ أحد
Dialogue: 0,0:17:25.24,0:17:28.22,Default,,0000,0000,0000,,بعدما أخبرت والدك أنّ لديك أعمالاً\Nلكن بقيت في المشفى
Dialogue: 0,0:17:28.69,0:17:33.18,Default,,0000,0000,0000,,ولا تزال تحمل صندوقاً\Nلا يصلح ليكون هديّة
Dialogue: 0,0:17:33.39,0:17:37.97,Default,,0000,0000,0000,,كما استعمال الهواتف الخلويّة\Nداخل المشافي محظور
Dialogue: 0,0:17:38.23,0:17:44.43,Default,,0000,0000,0000,,مع ذلك، يحملها رجال غرباء\Nوهم حولك يراقبونك
Dialogue: 0,0:17:45.13,0:17:50.13,Default,,0000,0000,0000,,ابنتك مُحتجزة رهينة على سطح\Nمركز التسوّق ذاك، صحيح؟
Dialogue: 0,0:17:50.13,0:17:54.43,Default,,0000,0000,0000,,تمتمت باسمها بينما كنت\Nتحدّق من النافذة
Dialogue: 0,0:17:55.21,0:17:59.35,Default,,0000,0000,0000,,ورأيتُ شخصاً مريباً ينظر إلى هنا بمنظار
Dialogue: 0,0:17:59.35,0:18:01.78,Default,,0000,0000,0000,,و-وقعتُ في فخّ
Dialogue: 0,0:18:01.78,0:18:05.03,Default,,0000,0000,0000,,تلقّيتُ اتصالاً للقدوم هنا مع ابنتي
Dialogue: 0,0:18:05.03,0:18:07.35,Default,,0000,0000,0000,,...لمناقشة حالة أبي
Dialogue: 0,0:18:07.82,0:18:11.44,Default,,0000,0000,0000,,!إذا كنت تقدّر حياة ابنتك، فلتقتل أكاباني
Dialogue: 0,0:18:11.44,0:18:13.52,Default,,0000,0000,0000,,إذا أردت إبغاض أحد، فلتبغض أكاباني
Dialogue: 0,0:18:13.52,0:18:16.85,Default,,0000,0000,0000,,!الذي صادف أنّه في نفس الغرفة مع أبيك
Dialogue: 0,0:18:17.19,0:18:19.29,Default,,0000,0000,0000,,إنّهم يخططون لقتلك أيضاً
Dialogue: 0,0:18:21.22,0:18:24.34,Default,,0000,0000,0000,,فورما تقتل أكاباني
Dialogue: 0,0:18:24.34,0:18:28.34,Default,,0000,0000,0000,,إنّهم جماعة لصوص المصرف على الأرجح
Dialogue: 0,0:18:28.34,0:18:32.76,Default,,0000,0000,0000,,خطّتهم هي إسكات زميلهم المُتخلّف\Nوإلقاء كلّ اللوم عليك
Dialogue: 0,0:18:33.58,0:18:37.59,Default,,0000,0000,0000,,بجعل الأمر يبدو أنّك كنت\Nتعمل جاسوساً لهم في المصرف
Dialogue: 0,0:18:38.00,0:18:39.72,Default,,0000,0000,0000,,...لـ-لا يُعقل
Dialogue: 0,0:18:40.32,0:18:46.51,Default,,0000,0000,0000,,هذا هو الاستنتاج الذي وصلتُ له بناءً\Nعلى ما سمعتُه من المفتّش في دورة المياه
Dialogue: 0,0:18:46.51,0:18:52.02,Default,,0000,0000,0000,,ستبدأ جولات الأطبّاء، فلترجعوا لغرفكم رجاءً
Dialogue: 0,0:18:52.02,0:18:55.26,Default,,0000,0000,0000,,!كلا! تبقّت 3 دقائق! عليّ الذهاب
Dialogue: 0,0:18:55.55,0:18:59.13,Default,,0000,0000,0000,,تبّاً! لا يبدو أنّ غينتا والبقيّة\N!سيصلون في الوقت
Dialogue: 0,0:18:59.13,0:19:02.09,Default,,0000,0000,0000,,...ولا أعرف عدد الأشخاص هنا
Dialogue: 0,0:19:02.09,0:19:02.92,Default,,0000,0000,0000,,!لا خيار أمامي
Dialogue: 0,0:19:03.88,0:19:07.79,Default,,0000,0000,0000,,!رائع! كعك بالقشدة\N!دعني آكل واحدة يا عمّ
Dialogue: 0,0:19:07.79,0:19:08.33,Default,,0000,0000,0000,,!تـ-توقّف
Dialogue: 0,0:19:09.16,0:19:11.96,Default,,0000,0000,0000,,!ماذا؟ يوجد مسدّس في الداخل
Dialogue: 0,0:19:12.25,0:19:13.46,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:19:13.46,0:19:14.63,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,0:19:15.83,0:19:17.46,Default,,0000,0000,0000,,!ذاك الضابط أيضاً؟
Dialogue: 0,0:19:18.07,0:19:21.15,Default,,0000,0000,0000,,!لا يجدر بك العبث هكذا يا فتى
Dialogue: 0,0:19:21.15,0:19:22.42,Default,,0000,0000,0000,,!دعني
Dialogue: 0,0:19:33.38,0:19:34.30,Default,,0000,0000,0000,,!أ-أنت
Dialogue: 0,0:19:37.46,0:19:39.75,Default,,0000,0000,0000,,!رائع يا يوكو-تشان
Dialogue: 0,0:19:39.75,0:19:40.84,Default,,0000,0000,0000,,ما الذي يجري؟
Dialogue: 0,0:19:40.84,0:19:44.55,Default,,0000,0000,0000,,يبدو أنّهما تعثرا بواسطة كُرتي
Dialogue: 0,0:19:45.30,0:19:47.00,Default,,0000,0000,0000,,!تبّاً! كان هناك آخر
Dialogue: 0,0:19:51.37,0:19:53.42,Default,,0000,0000,0000,,ما الأمر؟ أنجحت الخطّة؟
Dialogue: 0,0:19:53.42,0:19:57.36,Default,,0000,0000,0000,,...كلا! فشلت! خذي الصغيرة رهينةً و
Dialogue: 0,0:20:04.46,0:20:06.26,Default,,0000,0000,0000,,!لحظة! مرحباً؟
Dialogue: 0,0:20:06.26,0:20:08.96,Default,,0000,0000,0000,,!يا حمقاء! ألا ترين؟ أنا في الأسفل
Dialogue: 0,0:20:08.96,0:20:10.84,Default,,0000,0000,0000,,!انظري لمدخل المشفى
Dialogue: 0,0:20:21.09,0:20:23.25,Default,,0000,0000,0000,,...يا آنسة
Dialogue: 0,0:20:23.25,0:20:25.68,Default,,0000,0000,0000,,يوميكو-تشان؟
Dialogue: 0,0:20:25.68,0:20:27.58,Default,,0000,0000,0000,,هل يوميكو-تشان هنا؟
Dialogue: 0,0:20:28.83,0:20:31.15,Default,,0000,0000,0000,,أجل، أنا يوميكو
Dialogue: 0,0:20:31.58,0:20:35.01,Default,,0000,0000,0000,,هذه الآنسة هي التي كانت معك إذاً؟
Dialogue: 0,0:20:35.25,0:20:39.41,Default,,0000,0000,0000,,إنّها فاقدة للوعي، لكن هل نخبرها\Nبما قاله كونان بأيّ حال؟
Dialogue: 0,0:20:39.41,0:20:40.45,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:40.45,0:20:45.24,Default,,0000,0000,0000,,،فشلت الخطّة! سأتّصل بك لاحقاً"\N"!اتركي الطفلة وغادري
Dialogue: 0,0:20:45.24,0:20:46.92,Default,,0000,0000,0000,,ما معنى ذلك برأيكما؟
Dialogue: 0,0:20:50.65,0:20:51.93,Default,,0000,0000,0000,,هو أيضاً؟
Dialogue: 0,0:20:51.93,0:20:53.17,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:20:55.15,0:20:56.80,Default,,0000,0000,0000,,!أبي! أبي
Dialogue: 0,0:20:57.89,0:20:59.26,Default,,0000,0000,0000,,...يوميكو
Dialogue: 0,0:21:00.72,0:21:02.22,Default,,0000,0000,0000,,!يوميكو
Dialogue: 0,0:21:03.14,0:21:06.26,Default,,0000,0000,0000,,!يوميكو! يوميكو
Dialogue: 0,0:21:07.33,0:21:08.96,Default,,0000,0000,0000,,هذا مؤلم يا أبي
Dialogue: 0,0:21:14.71,0:21:16.00,Default,,0000,0000,0000,,هذا رائع
Dialogue: 0,0:21:16.00,0:21:19.03,Default,,0000,0000,0000,,اتّصلتُ بالمفتّش ميغوري وطلبت\Nمنه القدوم هنا
Dialogue: 0,0:21:19.03,0:21:21.50,Default,,0000,0000,0000,,لذا ستكون الأمور على ما يرام\Nعندما توضّح له كلّ شيء
Dialogue: 0,0:21:22.87,0:21:25.72,Default,,0000,0000,0000,,!كونان! لنذهب بسرعة
Dialogue: 0,0:21:25.72,0:21:28.29,Default,,0000,0000,0000,,ألن تعلّمنا كيف نلعب كرة القدم؟
Dialogue: 0,0:21:28.29,0:21:29.83,Default,,0000,0000,0000,,!بلى
Dialogue: 0,0:21:29.83,0:21:31.25,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:21:33.52,0:21:35.51,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:21:36.85,0:21:39.46,Default,,0000,0000,0000,,إيدوغاوا كونان، متحرٍّ
Dialogue: 0,0:21:41.53,0:21:42.37,Default,,0000,0000,0000,,!لنذهب
Dialogue: 0,0:21:42.37,0:21:43.51,Default,,0000,0000,0000,,!لنذهب
Dialogue: 0,0:21:43.51,0:21:46.01,Default,,0000,0000,0000,,كونان-كن، ما حلّ بالكرة؟
Dialogue: 0,0:23:17.80,0:23:21.47,Default,,0000,0000,0000,,المعذرة، هلّا أخبرتني برقم الغرفة التي\Nفيها موري كوغورو؟ ساقه مكسورة
Dialogue: 0,0:23:21.47,0:23:22.18,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:23:22.33,0:23:25.42,Default,,0000,0000,0000,,!هيّا بنا! هيّا بنا! يوكو-سان! يوكو-تشان
Dialogue: 0,0:23:25.89,0:23:28.71,Default,,0000,0000,0000,,!يوكو-تشان! رائع
Dialogue: 0,0:23:28.71,0:23:29.09,On Top,,0000,0000,0000,,!مرحى
Dialogue: 0,0:23:29.09,0:23:30.59,Default,,0000,0000,0000,,...موري-سان في الغرفة رقم
Dialogue: 0,0:23:30.59,0:23:32.79,Default,,0000,0000,0000,,لا، لا بأس
Dialogue: 0,0:23:30.59,0:23:33.96,On Top,,0000,0000,0000,,!يوكو! يوكو! يوكو
Dialogue: 0,0:23:33.96,0:23:38.17,On Top,,0000,0000,0000,,!يوكو! يوكو! يوكو! يوكو
Dialogue: 0,0:23:38.17,0:23:42.13,On Top,,0000,0000,0000,,!يوكو! يوكو! يوكو
Dialogue: 0,0:23:42.13,0:23:43.99,On Top,,0000,0000,0000,,!يوكو! يوكو! يوكو! يوكو
Dialogue: 0,0:23:44.42,0:23:45.09,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:23:48.98,0:23:53.44,Default,,0000,0000,0000,,!لويتُ كاحلي! ا-اطلبي طبيباً يا ران
Dialogue: 0,0:23:53.44,0:23:55.11,Default,,0000,0000,0000,,!لم أعد أهتمّ
Dialogue: 0,0:23:55.35,0:23:57.54,Default,,0000,0000,0000,,!أيّها الطبيب
Dialogue: 0,0:24:00.43,0:24:03.14,Default,,0000,0000,0000,,!الثعلب يستهدف حياتك؟
Dialogue: 0,0:24:07.80,0:24:09.29,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,0:24:10.00,0:24:11.13,Default,,0000,0000,0000,,!إنّها رصاصات! انبطحوا
Dialogue: 0,0:24:13.30,0:24:16.74,Default,,0000,0000,0000,,سيمسك المتحرّي العظيم موري كوغورو بالثعلب
Dialogue: 0,0:24:16.74,0:24:20.29,Default,,0000,0000,0000,,!الذي سبّب الكثير من العناء للشرطة
Dialogue: 0,0:24:20.29,0:24:23.92,Default,,0000,0000,0000,,أمرٌ ما ليس في محلّه، يخفي هذا الرجل شيئاً
Dialogue: 0,0:24:24.03,0:24:30.02,On Top,,0000,0000,0000,,جريمة قتل تسلّق الجبال المخيفة \N(الجزء الأوّل)
Dialogue: 0,0:24:24.45,0:24:25.68,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.89,0:24:29.82,Default,,0000,0000,0000,,جريمة قتل تسلّق الجبال المخيفة \N(الجزء الأوّل)
Dialogue: 0,0:24:45.86,0:24:48.25,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.25,0:24:49.49,Default,,0000,0000,0000,,سكّين
Dialogue: 0,0:24:50.02,0:24:52.56,Default,,0000,0000,0000,,،"الحلقة القادمة عن "تسلّق جبال\Nبمعنى الصعود الطوليّ
Dialogue: 0,0:24:52.56,0:24:54.56,Default,,0000,0000,0000,,المعنى المبسّط هو صعود الجبال

