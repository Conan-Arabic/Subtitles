Dialogue: 0,0:00:01.28,0:00:03.35,Default,,0000,0000,0000,,،عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.35,0:00:05.10,Default,,0000,0000,0000,,دمية آلية الخروج وخزف محطّم
Dialogue: 0,0:00:05.10,0:00:08.46,Default,,0000,0000,0000,,المنطق المفكّك للغموض مفيد\Nفي مواجهة القلوب الجافّة
Dialogue: 0,0:00:08.68,0:00:11.96,Default,,0000,0000,0000,,،قضيّة اليوم عن رسّامة توضيحية حسناء \N!حبّ العبث يقود للموت
Dialogue: 0,0:00:12.25,0:00:15.21,Default,,0000,0000,0000,,يرى الحقيقة الواحدة، وباستنتاجات لا مُضاهٍ لها
Dialogue: 0,0:00:15.21,0:00:16.41,Default,,0000,0000,0000,,!إنّه المتحرّي كونان
Dialogue: 0,0:01:51.24,0:01:57.08,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل الرسّامة التوضيحية
Dialogue: 0,0:01:51.77,0:01:54.51,Default,,0000,0000,0000,,جريمة قتل الرسّامة التوضيحية
Dialogue: 0,0:01:57.08,0:02:02.06,On Top,,0000,0000,0000,,مكتب هاناوكا للتصميم
Dialogue: 0,0:01:57.81,0:02:02.06,Default,,0000,0000,0000,,ماذا؟ مجموعة رسومات مسارح جريمة؟
Dialogue: 0,0:02:02.06,0:02:06.26,Default,,0000,0000,0000,,لم أخبرك؟ ستصدر الشهر القادم
Dialogue: 0,0:02:06.26,0:02:10.56,Default,,0000,0000,0000,,من رسّام ورئيس مكتب التصميم هذا، هاناوكا سينسي
Dialogue: 0,0:02:10.84,0:02:15.79,Default,,0000,0000,0000,,طلبت منكما الاثنان القدوم اليوم لإجراء مقابلة
Dialogue: 0,0:02:15.79,0:02:18.67,Default,,0000,0000,0000,,نضيفها في ختامية المجموعة
Dialogue: 0,0:02:18.67,0:02:20.56,Default,,0000,0000,0000,,مقابلة؟
Dialogue: 0,0:02:23.82,0:02:24.98,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:02:25.49,0:02:30.65,Default,,0000,0000,0000,,قال أبي أنّها ستكون مجموعة رسمات له
Dialogue: 0,0:02:31.16,0:02:33.96,Default,,0000,0000,0000,,بدا ذلك غير منطقيّ، صحيح يا كونان-كن؟
Dialogue: 0,0:02:33.96,0:02:34.60,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:34.60,0:02:38.80,Default,,0000,0000,0000,,إذاً، أين الرسّام رفيع المقام هذا؟
Dialogue: 0,0:02:38.80,0:02:41.10,Default,,0000,0000,0000,,لم يأت بعد
Dialogue: 0,0:02:41.10,0:02:43.31,Default,,0000,0000,0000,,ربما لا يزال نائماً في الاستوديو
Dialogue: 0,0:02:43.66,0:02:45.18,Default,,0000,0000,0000,,...بربك
Dialogue: 0,0:02:45.18,0:02:47.65,On Top,,0000,0000,0000,,مجمع شقق بيكا 2
Dialogue: 0,0:02:53.04,0:02:54.74,Default,,0000,0000,0000,,ما-ما الذي تفعلينه؟
Dialogue: 0,0:02:54.74,0:02:56.02,Default,,0000,0000,0000,,استيقظت
Dialogue: 0,0:02:56.19,0:02:59.61,CharCard,,0000,0000,0005,,هاناوكا كينجين (48) - رسّام
Dialogue: 0,0:02:57.88,0:02:59.61,On Top,,0000,0000,0000,,ما هذا؟ طلاء؟
Dialogue: 0,0:03:00.04,0:03:01.95,On Top,,0000,0000,0000,,طلاء أظافر
Dialogue: 0,0:03:00.04,0:03:04.31,CharCard,,0000,0000,0005,,تشونو إيزومي (25) - رسّامة توضيحية
Dialogue: 0,0:03:01.95,0:03:04.31,On Top,,0000,0000,0000,,أليس لونه جميلاً؟ بدأ بيعه اليوم
Dialogue: 0,0:03:04.70,0:03:06.12,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:03:06.12,0:03:08.27,Default,,0000,0000,0000,,ألديك وقت للاسترخاء حقاً؟
Dialogue: 0,0:03:09.28,0:03:13.22,Default,,0000,0000,0000,,ألم يكن يُفترض بك\Nلقاء مُتحرٍّ ما عند الخامسة؟
Dialogue: 0,0:03:13.77,0:03:15.01,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:03:15.01,0:03:16.36,Default,,0000,0000,0000,,أسرع
Dialogue: 0,0:03:16.36,0:03:19.61,Default,,0000,0000,0000,,ألبستُك بنطالك وجواربك
Dialogue: 0,0:03:20.69,0:03:24.64,Default,,0000,0000,0000,,...لا تقومي بهذا المقلب مُجدداً، لو رأته زوجتي
Dialogue: 0,0:03:24.64,0:03:26.35,Default,,0000,0000,0000,,لذا قمتُ به
Dialogue: 0,0:03:26.35,0:03:31.19,Default,,0000,0000,0000,,عندها ستطلّقك ويمكننا البقاء معاً
Dialogue: 0,0:03:34.92,0:03:36.39,Default,,0000,0000,0000,,!لـ-لمَ هذا؟
Dialogue: 0,0:03:37.17,0:03:40.11,Default,,0000,0000,0000,,أخبرتك أنّ علاقتنا علاقة عمل فقط
Dialogue: 0,0:03:40.88,0:03:43.91,Default,,0000,0000,0000,,لذا يمكنك رسم أيّ ما تشائين
Dialogue: 0,0:03:43.91,0:03:45.68,Default,,0000,0000,0000,,والعيش في شقّة فارهة كهذه
Dialogue: 0,0:03:46.70,0:03:47.85,Default,,0000,0000,0000,,!سأكشف الحقيقة
Dialogue: 0,0:03:49.08,0:03:52.56,Default,,0000,0000,0000,,إنّها تشك بالفعل، لكنّها تتغاضى عن الأمر
Dialogue: 0,0:03:53.57,0:03:56.27,Default,,0000,0000,0000,,لم أقصد أمرنا، بل الرسومات
Dialogue: 0,0:03:57.23,0:04:02.89,Default,,0000,0000,0000,,ستّون بالمئة من رسماتك كانت من تنفيذي أنا
Dialogue: 0,0:04:04.10,0:04:04.68,Default,,0000,0000,0000,,مهلك
Dialogue: 0,0:04:04.68,0:04:08.85,Default,,0000,0000,0000,,إذا تسرّبت الحقيقة، ستتبخر سمعتك
Dialogue: 0,0:04:08.85,0:04:11.77,Default,,0000,0000,0000,,لن تستطيع بيع رسمة واحدة
Dialogue: 0,0:04:13.00,0:04:16.52,Default,,0000,0000,0000,,من سيصدّق رسامة توضيحية مبتدئة؟
Dialogue: 0,0:04:16.96,0:04:22.85,Default,,0000,0000,0000,,لم تعرف؟ وضعتُ علامةً على كلّ رسمة لي
Dialogue: 0,0:04:23.08,0:04:24.81,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:04:24.81,0:04:26.27,On Top,,0000,0000,0000,,عالم هاناوكا كينجين
Dialogue: 0,0:04:26.27,0:04:31.97,Default,,0000,0000,0000,,أمعن النظر تحت توقيعك على الرسمات\Nالتي كانت من تنفيذي
Dialogue: 0,0:04:34.28,0:04:35.77,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:04:36.48,0:04:42.18,Default,,0000,0000,0000,,وضعتُ تلك العلامة على كلّ أعمالي الأصلية
Dialogue: 0,0:04:42.18,0:04:48.23,Default,,0000,0000,0000,,أصبحت علامتي مشهورةً بسبب ازدهار عملك
Dialogue: 0,0:04:49.02,0:04:51.60,Default,,0000,0000,0000,,سهرتُ البارحة في إنهاء رسمة أخرى
Dialogue: 0,0:04:51.60,0:04:54.68,Default,,0000,0000,0000,,احرص على أن توصلها للناشر لاحقاً
Dialogue: 0,0:04:55.92,0:04:59.86,Default,,0000,0000,0000,,...مهما حاولت، فلن تستطيع الفرار مني
Dialogue: 0,0:05:01.17,0:05:02.43,Default,,0000,0000,0000,,طيلة حياتك
Dialogue: 0,0:05:03.39,0:05:06.10,Default,,0000,0000,0000,,!تأخّر! تجاوزت الخامسة والنصف
Dialogue: 0,0:05:06.58,0:05:10.75,Default,,0000,0000,0000,,لا جدوى. ليس في منزله، وأتلقى الردّ الآلي\Nعندما أتّصل بالاستوديو
Dialogue: 0,0:05:10.75,0:05:15.49,Default,,0000,0000,0000,,،ربما يكون في منزل تشونو-كن\Nفاليوم هو موعد التسليم النهائي لها
Dialogue: 0,0:05:15.49,0:05:16.52,Default,,0000,0000,0000,,تشونو؟
Dialogue: 0,0:05:16.90,0:05:22.56,Default,,0000,0000,0000,,رسّامة توضيحية جديدة، تعيش في ذاك المبنى هناك
Dialogue: 0,0:05:27.43,0:05:32.18,Default,,0000,0000,0000,,تبّاً! لم أقصد... لم أقصد قتلها
Dialogue: 0,0:05:34.60,0:05:37.97,Default,,0000,0000,0000,,مرحباً، أنا تشونو. لست متوفرة حالياً
Dialogue: 0,0:05:37.97,0:05:42.56,Default,,0000,0000,0000,,اترك رسالتك بعد سماع الصافرة من فضلك
Dialogue: 0,0:05:43.46,0:05:47.71,Default,,0000,0000,0000,,مرحباً، أنا تاناكا من مكتب تصميم هاناوكا
Dialogue: 0,0:05:47.71,0:05:50.37,Default,,0000,0000,0000,,أأنتِ موجودة يا تشونو-كن؟
Dialogue: 0,0:05:53.53,0:05:55.86,Default,,0000,0000,0000,,!مرحباً، مكتب تصميم هاناوكا
Dialogue: 0,0:05:55.86,0:05:58.15,Default,,0000,0000,0000,,مرحباً؟ مرحباً؟
Dialogue: 0,0:05:58.15,0:05:58.94,Default,,0000,0000,0000,,ماذا هناك؟
Dialogue: 0,0:05:58.94,0:06:00.86,Default,,0000,0000,0000,,اتّصال عابث
Dialogue: 0,0:06:01.70,0:06:03.56,Default,,0000,0000,0000,,ما الذي تنظر له يا كونان-كن؟
Dialogue: 0,0:06:04.23,0:06:07.52,Default,,0000,0000,0000,,شرفة تلك الشقّة
Dialogue: 0,0:06:09.35,0:06:10.27,Default,,0000,0000,0000,,...عجباً
Dialogue: 0,0:06:10.27,0:06:13.68,Default,,0000,0000,0000,,تركوا الفرشة خارجاً\Nمع أن المطر يهطل
Dialogue: 0,0:06:13.88,0:06:17.30,Default,,0000,0000,0000,,تلك شقّة تشونو-كن
Dialogue: 0,0:06:17.30,0:06:19.15,Default,,0000,0000,0000,,ربما هي نائمة
Dialogue: 0,0:06:22.25,0:06:26.50,Default,,0000,0000,0000,,هذا تأخير فوق المعقول! آسف، لكني سأغادر
Dialogue: 0,0:06:27.37,0:06:28.52,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:06:30.04,0:06:31.23,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:06:32.49,0:06:33.89,Default,,0000,0000,0000,,!هاناوكا سينسي
Dialogue: 0,0:06:34.91,0:06:36.58,Default,,0000,0000,0000,,أين كنت؟
Dialogue: 0,0:06:36.58,0:06:38.20,Default,,0000,0000,0000,,آسف، آسف
Dialogue: 0,0:06:38.20,0:06:40.11,Default,,0000,0000,0000,,غلبني النوم في الاستوديو
Dialogue: 0,0:06:40.49,0:06:43.56,Default,,0000,0000,0000,,الاستوديو؟ اتّصلنا به عدّة مرات
Dialogue: 0,0:06:43.81,0:06:46.52,Default,,0000,0000,0000,,أجل، أيقظني الرنين وقتها
Dialogue: 0,0:06:47.23,0:06:50.98,Default,,0000,0000,0000,,!أعتذر على جعلك تنتظر حضرة المتحرّي موري
Dialogue: 0,0:06:50.98,0:06:53.14,Default,,0000,0000,0000,,ماذا؟ ما خطب أظافرك؟
Dialogue: 0,0:06:53.14,0:06:53.93,Default,,0000,0000,0000,,أظافري؟
Dialogue: 0,0:06:57.64,0:06:59.56,Default,,0000,0000,0000,,أهذا طلاء أظافر؟
Dialogue: 0,0:06:59.56,0:07:02.31,Default,,0000,0000,0000,,!بالطبع لا! مجرد طلاء رسم
Dialogue: 0,0:07:03.11,0:07:05.06,Default,,0000,0000,0000,,لا بدّ أنه علق بي في الاستوديو
Dialogue: 0,0:07:05.71,0:07:09.77,Default,,0000,0000,0000,,بالمناسبة يا تاناكا-كن، قد تتّصل تشونو-كن
Dialogue: 0,0:07:09.77,0:07:12.45,Default,,0000,0000,0000,,أعطني السمّاعة عندما تفعل
Dialogue: 0,0:07:12.45,0:07:13.16,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:07:16.66,0:07:19.37,Default,,0000,0000,0000,,!تبّاً... تبّاً! تبّاً
Dialogue: 0,0:07:19.41,0:07:20.87,Default,,0000,0000,0000,,!تلك المرأة
Dialogue: 0,0:07:25.90,0:07:28.20,Default,,0000,0000,0000,,!مرحباً، مكتب تصميم هاناوكا
Dialogue: 0,0:07:28.20,0:07:29.81,Default,,0000,0000,0000,,مرحباً، أنا تشونو
Dialogue: 0,0:07:30.11,0:07:32.41,Default,,0000,0000,0000,,!إنّها أنت! انتظري لحظة
Dialogue: 0,0:07:34.68,0:07:36.56,Default,,0000,0000,0000,,سينسي، إنّها تشونو-كن
Dialogue: 0,0:07:37.55,0:07:41.52,Default,,0000,0000,0000,,معك هاناوكا، أتشعرين بتحسن الآن؟
Dialogue: 0,0:07:42.13,0:07:43.97,Default,,0000,0000,0000,,!ماذا؟ ستموتين؟
Dialogue: 0,0:07:44.59,0:07:46.94,Default,,0000,0000,0000,,!ستقفزين من الشرفة؟
Dialogue: 0,0:07:57.66,0:08:00.28,Default,,0000,0000,0000,,!قـ-قفزت
Dialogue: 0,0:08:05.07,0:08:08.60,Default,,0000,0000,0000,,المُتوفاة هي تشونو إيزومي-سان، 25 عاماً
Dialogue: 0,0:08:09.23,0:08:14.85,Default,,0000,0000,0000,,هاناوكا-سان، كانت رسّامةً توضيحية\Nفي مكتب تصميمك، صحيح؟
Dialogue: 0,0:08:14.85,0:08:19.31,Default,,0000,0000,0000,,أجل، كانت مبتدئة لكن تمتلك حسّاً دقيقاً
Dialogue: 0,0:08:19.60,0:08:26.17,Default,,0000,0000,0000,,لكنّها أخبرتني على الهاتف أنّ لا موهبة لها، وأنّها ستموت
Dialogue: 0,0:08:26.17,0:08:28.77,Default,,0000,0000,0000,,وبعدها فوراً، كانت قد قفزت من الشرفة
Dialogue: 0,0:08:29.80,0:08:32.97,Default,,0000,0000,0000,,هل شهدتم جميعاً ذلك؟
Dialogue: 0,0:08:32.97,0:08:33.72,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:36.29,0:08:37.57,Default,,0000,0000,0000,,عدسات لاصقة؟
Dialogue: 0,0:08:38.48,0:08:40.56,Default,,0000,0000,0000,,...لحظة، ألم تكن
Dialogue: 0,0:08:43.28,0:08:47.48,Default,,0000,0000,0000,,بوجود هذا العدد من الشاهدين، يبدو أنّه كان انتحاراً
Dialogue: 0,0:08:48.11,0:08:51.93,Default,,0000,0000,0000,,!كلا، كانت جريمة قتل
Dialogue: 0,0:08:52.43,0:08:55.52,Default,,0000,0000,0000,,لا بدّ أنها كانت ميتة قبل سقوطها
Dialogue: 0,0:08:55.52,0:08:57.90,Default,,0000,0000,0000,,ورماها أحدهم
Dialogue: 0,0:08:58.81,0:09:00.86,Default,,0000,0000,0000,,...ما يعني أن الأكثر شبهة
Dialogue: 0,0:09:01.35,0:09:04.27,Default,,0000,0000,0000,,هو هذا الشخص الذي حاول منعها \Nمن القفز على الهاتف
Dialogue: 0,0:09:05.17,0:09:07.80,Default,,0000,0000,0000,,أكان له متواطئ دفعها؟
Dialogue: 0,0:09:08.84,0:09:13.00,Default,,0000,0000,0000,,كلا، لم يكن هناك أحد على الشرفة عندما سقطت
Dialogue: 0,0:09:13.91,0:09:19.65,Default,,0000,0000,0000,,!كيف رماها إذاً... من تلك المسافة البعيدة؟
Dialogue: 0,0:09:25.19,0:09:27.10,Default,,0000,0000,0000,,ألا تجدون هذا غريباً؟
Dialogue: 0,0:09:27.82,0:09:31.27,Default,,0000,0000,0000,,انظروا لعينيها، ترتدي عدسات لاصقة
Dialogue: 0,0:09:32.06,0:09:33.64,Default,,0000,0000,0000,,ما في ذلك؟
Dialogue: 0,0:09:33.64,0:09:36.73,Default,,0000,0000,0000,,لكنّها كانت ترتدي نظارات عندما سقطت
Dialogue: 0,0:09:37.71,0:09:40.84,Default,,0000,0000,0000,,من قد يرتدي نظّارات\Nوبعينيه عدسات لاصقة سلفاً؟
Dialogue: 0,0:09:43.32,0:09:44.29,Default,,0000,0000,0000,,...معه حق
Dialogue: 0,0:09:44.70,0:09:49.50,Default,,0000,0000,0000,,ما يعني أنّ أحداً وضع نظّارتها عليها وأسقطها؟
Dialogue: 0,0:09:49.87,0:09:51.47,Default,,0000,0000,0000,,!انتظروا
Dialogue: 0,0:09:51.47,0:09:55.67,Default,,0000,0000,0000,,!حضرة المتحرّي، رأيت تشونو-كن تقفز بأم عينيك
Dialogue: 0,0:09:56.15,0:10:00.13,Default,,0000,0000,0000,,لم يكن هناك أحد سواها على الشرفة آنذاك
Dialogue: 0,0:10:00.17,0:10:01.36,On Top,,0000,0000,0000,,تشونو
Dialogue: 0,0:10:06.01,0:10:09.18,Default,,0000,0000,0000,,ماذا؟ الباب غير مقفل
Dialogue: 0,0:10:14.25,0:10:15.54,Default,,0000,0000,0000,,...مسمار
Dialogue: 0,0:10:15.96,0:10:17.50,Default,,0000,0000,0000,,لمَ هو هنا؟
Dialogue: 0,0:10:18.96,0:10:20.38,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:10:20.85,0:10:23.58,Default,,0000,0000,0000,,!ران! راقبي هذا الصبيّ
Dialogue: 0,0:10:24.16,0:10:27.54,Default,,0000,0000,0000,,هذه الشرفة التي سقطت منها إذاً
Dialogue: 0,0:10:27.54,0:10:32.32,Default,,0000,0000,0000,,خفّان، هاتف خلويّ، وأصيص مكسور
Dialogue: 0,0:10:33.36,0:10:36.38,Default,,0000,0000,0000,,تقود آثار الأصيص لفتحة التصريف
Dialogue: 0,0:10:38.34,0:10:41.79,Default,,0000,0000,0000,,تعرف أنّ عليك عدم العبث في المكان
Dialogue: 0,0:10:42.14,0:10:45.75,Default,,0000,0000,0000,,حافظة عدسات لاصقة، يبدو أنّها لها
Dialogue: 0,0:10:46.22,0:10:49.67,Default,,0000,0000,0000,,ما يعني أنّ تلك النظّارة هي المشكلة
Dialogue: 0,0:10:49.67,0:10:53.62,Default,,0000,0000,0000,,لا بدّ أنها نسيت ارتداءها لعدسات لاصقة
Dialogue: 0,0:10:54.46,0:10:58.96,Default,,0000,0000,0000,,لنفتّش المكان جيّداً، قد تكون هناك وصيّة\Nإذا كان هذا انتحاراً
Dialogue: 0,0:10:58.96,0:10:59.50,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:11:06.24,0:11:08.46,Default,,0000,0000,0000,,ما خطب هذه الصور؟
Dialogue: 0,0:11:08.46,0:11:14.61,Default,,0000,0000,0000,,إنّها صور التقطتها تشونو-كن\Nفي رحلة لعاملي المكتب مؤخراً
Dialogue: 0,0:11:14.61,0:11:18.46,Default,,0000,0000,0000,,كانت تحبّ تنفيذ مقالب على الأشخاص النائمين
Dialogue: 0,0:11:18.46,0:11:21.13,Default,,0000,0000,0000,,يبدو أنّها نفس الرسمة على الجميع
Dialogue: 0,0:11:21.43,0:11:23.85,Default,,0000,0000,0000,,ذاك توقيعها
Dialogue: 0,0:11:23.85,0:11:26.52,Default,,0000,0000,0000,,الفراشة من لفظ "تشو" في اسمها
Dialogue: 0,0:11:26.52,0:11:29.13,Default,,0000,0000,0000,,كانت ترسمها في كلّ أعمالها
Dialogue: 0,0:11:29.13,0:11:33.55,Default,,0000,0000,0000,,أصبحت شعبية رسوماتها ترتفع مؤخراً
Dialogue: 0,0:11:36.76,0:11:38.96,Default,,0000,0000,0000,,لا وصيّة في هذه الغرفة أيضاً
Dialogue: 0,0:11:39.42,0:11:42.92,Default,,0000,0000,0000,,مفتّش ميغوري، يوجد طلاء أظافر على الأرض
Dialogue: 0,0:11:43.41,0:11:46.75,Default,,0000,0000,0000,,أظنّه طلاء الأظافر الذي بدأ بيعه اليوم
Dialogue: 0,0:11:46.75,0:11:49.88,Default,,0000,0000,0000,,كان الجميع في المدرسة يتكلمون عن لونه الفريد
Dialogue: 0,0:11:50.25,0:11:53.08,Default,,0000,0000,0000,,أليس هو ما على اللحاف أيضاً؟
Dialogue: 0,0:11:54.17,0:11:55.32,Default,,0000,0000,0000,,!لا شكّ
Dialogue: 0,0:11:55.32,0:11:59.40,Default,,0000,0000,0000,,لكنها لم تضع أيّاً منه على يديها أو قدميها
Dialogue: 0,0:11:59.40,0:12:02.04,Default,,0000,0000,0000,,...الوحيد الذي كان به هذا اللون
Dialogue: 0,0:12:02.48,0:12:03.96,Default,,0000,0000,0000,,هو أنت يا سيّد، أليس كذلك؟
Dialogue: 0,0:12:05.39,0:12:06.88,Default,,0000,0000,0000,,أهذا صحيح؟
Dialogue: 0,0:12:07.23,0:12:10.77,Default,,0000,0000,0000,,!صادف أن يكون طلاءً بنفس اللون
Dialogue: 0,0:12:10.77,0:12:13.33,Default,,0000,0000,0000,,فقد كنتُ أعمل في الاستوديو حتّى الصباح
Dialogue: 0,0:12:13.88,0:12:17.26,Default,,0000,0000,0000,,لا شكّ في الأمر، إنّه القاتل
Dialogue: 0,0:12:17.26,0:12:21.83,Default,,0000,0000,0000,,لكنّه كان في المكتب عندما سقطتْ
Dialogue: 0,0:12:21.83,0:12:24.00,Default,,0000,0000,0000,,كما معنا نحن
Dialogue: 0,0:12:26.00,0:12:27.92,Default,,0000,0000,0000,,!سنغادر الآن يا كونان-كن
Dialogue: 0,0:12:28.37,0:12:31.58,Default,,0000,0000,0000,,...كلا! أريد البقاء أكثر
Dialogue: 0,0:12:32.20,0:12:33.54,Default,,0000,0000,0000,,!محلول تعقيم
Dialogue: 0,0:12:33.99,0:12:38.82,Default,,0000,0000,0000,,غريب، كانت عدساتها اللاصقة من الصنف \Nالرقيق بناءً على الحافظة
Dialogue: 0,0:12:38.82,0:12:41.50,Default,,0000,0000,0000,,يوجد محلول تعقيم فحسب في الثلّاجة
Dialogue: 0,0:12:41.98,0:12:43.96,Default,,0000,0000,0000,,أين المحلول الملحيّ؟
Dialogue: 0,0:12:44.52,0:12:48.39,Default,,0000,0000,0000,,مفتّش ميغوري، لم نجد أيّ وصية
Dialogue: 0,0:12:48.39,0:12:51.02,Default,,0000,0000,0000,,...ربما لم يكن انتحاراً
Dialogue: 0,0:12:51.02,0:12:52.41,Default,,0000,0000,0000,,...المعذرة
Dialogue: 0,0:12:52.72,0:12:54.09,Default,,0000,0000,0000,,أنا عامل توصيل
Dialogue: 0,0:12:54.09,0:12:58.09,Default,,0000,0000,0000,,نسيتُ ترك إيصال استلام عندما أتيت قبلاً
Dialogue: 0,0:12:58.09,0:12:59.38,Default,,0000,0000,0000,,قبلاً؟
Dialogue: 0,0:12:59.38,0:13:00.88,Default,,0000,0000,0000,,عند السادسة والنصف
Dialogue: 0,0:13:01.18,0:13:04.33,Default,,0000,0000,0000,,!السادسة والنصف؟ عندما قفزت
Dialogue: 0,0:13:04.33,0:13:06.79,Default,,0000,0000,0000,,هل رأيتها آنذاك إذاً؟
Dialogue: 0,0:13:07.04,0:13:11.32,Default,,0000,0000,0000,,كلا، تمّ إخباري أن بإمكاني أخذ الرسمات\Nبجوار الباب عندما أفتحه
Dialogue: 0,0:13:11.32,0:13:16.75,Default,,0000,0000,0000,,وأن آتي عند السادسة والنصف، فلم أقابل أحداً
Dialogue: 0,0:13:16.75,0:13:19.21,Default,,0000,0000,0000,,هذا إيصال استلام اليوم
Dialogue: 0,0:13:20.07,0:13:21.17,Default,,0000,0000,0000,,!هاناوكا؟
Dialogue: 0,0:13:23.23,0:13:28.23,Default,,0000,0000,0000,,مكتوبٌ أنّك من طلب الاستلام يا هاناوكا-سان
Dialogue: 0,0:13:28.23,0:13:29.90,Default,,0000,0000,0000,,ما الموضوع؟
Dialogue: 0,0:13:29.90,0:13:34.75,Default,,0000,0000,0000,,...عامل توصيل في نفس وقت موتها\Nهناك ما يبدو مريباً لي
Dialogue: 0,0:13:35.01,0:13:38.47,Default,,0000,0000,0000,,أ-أخبرتني على الهاتف أنّها أنهت رسمةً
Dialogue: 0,0:13:38.47,0:13:42.33,Default,,0000,0000,0000,,فرتّبتُ لأن يأخذها عامل توصيل ويعطيها للناشر فحسب
Dialogue: 0,0:13:42.33,0:13:45.13,Default,,0000,0000,0000,,بدت بحالٍ غريبة وكانت مرهقة
Dialogue: 0,0:13:45.13,0:13:49.30,Default,,0000,0000,0000,,فلم أجعلها تنتظر قدوم عامل التوصيل
Dialogue: 0,0:13:49.63,0:13:53.79,Default,,0000,0000,0000,,أكان هناك أمرٌ غريب عندما دخلت الشقّة؟
Dialogue: 0,0:13:54.07,0:13:57.71,Default,,0000,0000,0000,,بذكرك ذلك، انفتح الباب قوّة
Dialogue: 0,0:14:01.07,0:14:03.58,Default,,0000,0000,0000,,رغم أنّي بالكاد لمسته
Dialogue: 0,0:14:03.94,0:14:06.06,Default,,0000,0000,0000,,أمتأكد أنّها لم تكن من فتحه؟
Dialogue: 0,0:14:06.06,0:14:09.27,Default,,0000,0000,0000,,ذلك ما ظننته، لكن لم أجد أحداً
Dialogue: 0,0:14:09.27,0:14:11.20,Default,,0000,0000,0000,,سقط مسمار لا أكثر
Dialogue: 0,0:14:11.20,0:14:11.80,Default,,0000,0000,0000,,مسمار؟
Dialogue: 0,0:14:11.80,0:14:16.54,Default,,0000,0000,0000,,أجل، ثمّ سمعت صوت انكسار في الخلف
Dialogue: 0,0:14:17.76,0:14:19.00,Default,,0000,0000,0000,,!لحظة
Dialogue: 0,0:14:25.63,0:14:28.49,Default,,0000,0000,0000,,!مثاليّ! إنّه عالق بجزء من الأصيص
Dialogue: 0,0:14:35.24,0:14:41.75,Default,,0000,0000,0000,,فهمتُ كلّ شيء! سيمكن إسقاطها من الشرفة\N...باستعمال هذه الحيلة
Dialogue: 0,0:14:41.98,0:14:45.02,Default,,0000,0000,0000,,!ولو ابتعدت عشرات الكيلومترات
Dialogue: 0,0:14:50.19,0:14:53.46,Default,,0000,0000,0000,,!اكتشفتُ الحيلة التي استعملها القاتل
Dialogue: 0,0:14:54.72,0:14:57.88,Default,,0000,0000,0000,,!ما الذي تفعله؟ ظننتك غادرت
Dialogue: 0,0:14:59.64,0:15:01.29,Default,,0000,0000,0000,,...مؤلم! الناموس الحقير
Dialogue: 0,0:15:04.92,0:15:08.88,Default,,0000,0000,0000,,...أضع الآن الزرّ المكبّر للصوت على العمّ
Dialogue: 0,0:15:09.38,0:15:11.83,Default,,0000,0000,0000,,ماذا؟ عرفت هويّة القاتل؟
Dialogue: 0,0:15:12.87,0:15:17.79,Default,,0000,0000,0000,,أجل، لم تنتحر تشونو-سان، بل قُتلت
Dialogue: 0,0:15:18.24,0:15:20.26,Default,,0000,0000,0000,,وأنت من قتلها يا هاناوكا-سان
Dialogue: 0,0:15:20.79,0:15:26.71,Default,,0000,0000,0000,,رويدك يا موري-كن، أنت تعي أنّه لم يكن بمقدوره فعلها
Dialogue: 0,0:15:26.94,0:15:30.44,Default,,0000,0000,0000,,!صحيح، يستحيل أن يكون القاتل
Dialogue: 0,0:15:30.44,0:15:35.38,Default,,0000,0000,0000,,فقد كنّا في المكتب جميعاً عندما\N!رأينا المرأة تسقط
Dialogue: 0,0:15:35.77,0:15:37.59,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:15:38.39,0:15:41.29,Default,,0000,0000,0000,,!اخرس! كان بإمكانه فعلها
Dialogue: 0,0:15:41.59,0:15:45.30,Default,,0000,0000,0000,,احتاج لخيط صيد متين ومسمار لا أكثر
Dialogue: 0,0:15:45.30,0:15:47.76,Default,,0000,0000,0000,,مفتّش ميغوري، هلّا وفرتهما؟
Dialogue: 0,0:15:47.76,0:15:49.00,Default,,0000,0000,0000,,...حـ-حسناً
Dialogue: 0,0:15:49.34,0:15:52.96,Default,,0000,0000,0000,,كما علبة صلصة صويا وقهوة ساخنة
Dialogue: 0,0:15:52.96,0:15:56.09,Default,,0000,0000,0000,,علبة صلصة صويا وقهوة؟
Dialogue: 0,0:15:56.83,0:15:59.88,Default,,0000,0000,0000,,نعدّ القهوة حالياً
Dialogue: 0,0:16:00.16,0:16:02.53,Default,,0000,0000,0000,,لكن ما الذي تنوي فعله بالضبط؟
Dialogue: 0,0:16:02.53,0:16:05.71,Default,,0000,0000,0000,,افعل ما سأمليه عليك الآن من فضلك
Dialogue: 0,0:16:06.44,0:16:10.82,Default,,0000,0000,0000,,بدايةً، اصنع حلقة طويلةً بخيط الصيد
Dialogue: 0,0:16:10.82,0:16:14.71,Default,,0000,0000,0000,,تمتد من سور الشرفة إلى الباب
Dialogue: 0,0:16:15.56,0:16:19.98,Default,,0000,0000,0000,,مرر طرفاً عبر الحزام على الفرشة\Nالتي ستمثّل الضحيّة
Dialogue: 0,0:16:19.98,0:16:23.38,Default,,0000,0000,0000,,ثمّ مرره حول السور من الأعلى
Dialogue: 0,0:16:23.38,0:16:28.67,Default,,0000,0000,0000,,وضع الحلقة حول الأصيص
Dialogue: 0,0:16:29.84,0:16:34.67,Default,,0000,0000,0000,,بعدها اسحب الخيط للباب مع إمساكك الأصيص منعاً لسقوطه
Dialogue: 0,0:16:34.67,0:16:38.84,Default,,0000,0000,0000,,وضع الحلقة الأخرى على جهاز الاتّصال الداخلي مؤقتاً
Dialogue: 0,0:16:39.37,0:16:44.79,Default,,0000,0000,0000,,تالياً، مرر الضحيّة على مسار الخيط\Nواجعلها تتدلى من الشرفة
Dialogue: 0,0:16:45.45,0:16:48.61,Default,,0000,0000,0000,,غطّى الضحية بفرشة بالطبع
Dialogue: 0,0:16:48.61,0:16:52.25,Default,,0000,0000,0000,,كي يخفي الجثّة، مثل التمويه
Dialogue: 0,0:16:52.60,0:16:55.10,Default,,0000,0000,0000,,بعدها أغلِق الباب عند خروجك
Dialogue: 0,0:16:55.10,0:16:58.44,Default,,0000,0000,0000,,انزع الحلقة حول جهاز الاتّصال الداخلي واربطها بالمسمار
Dialogue: 0,0:16:58.44,0:17:03.63,Default,,0000,0000,0000,,دع المسمار عالقاً خارج الباب ويكتمل كلّ شيء
Dialogue: 0,0:17:04.93,0:17:08.76,Default,,0000,0000,0000,,،فهمت، عندما يفتح أحدهم الباب هكذا
Dialogue: 0,0:17:08.76,0:17:13.62,Default,,0000,0000,0000,,سينفكّ طرف، وتسقط الضحية تلقائياً
Dialogue: 0,0:17:13.96,0:17:18.46,Default,,0000,0000,0000,,من فتح الباب كان عامل التوصيل\Nالذي طلبه هاناوكا-سان بالطبع
Dialogue: 0,0:17:19.29,0:17:23.92,Default,,0000,0000,0000,,سيفتح الباب في أيّ وقت حدّده له
Dialogue: 0,0:17:24.49,0:17:30.57,Default,,0000,0000,0000,,نظرية مثيرة للاهتمام، لكن يُفترض أن يوجد \N!خيط صيد إن أصاب كلامك، أين هو؟
Dialogue: 0,0:17:30.57,0:17:31.88,Default,,0000,0000,0000,,الأمر بسيط
Dialogue: 0,0:17:31.88,0:17:32.87,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:33.27,0:17:38.84,Default,,0000,0000,0000,,بخيط إضافيّ وعلبة صلصة صويا، سيختفي كما لو كان سحراً
Dialogue: 0,0:17:38.84,0:17:43.96,Default,,0000,0000,0000,,تربط الخيط الإضافيّ بين الضحيّة والأصيص أوّلاً
Dialogue: 0,0:17:43.96,0:17:47.97,Default,,0000,0000,0000,,،وتمرر الطرف الآخر عبر غطاء مدخل وغطاء التصريف
Dialogue: 0,0:17:47.97,0:17:50.39,Default,,0000,0000,0000,,وتربطه بعلبة صلصة الصويا
Dialogue: 0,0:17:50.39,0:17:55.17,Default,,0000,0000,0000,,تُنزل بعدها صلصة الصويا في قناة التصريف فحسب
Dialogue: 0,0:17:55.54,0:17:59.67,Default,,0000,0000,0000,,العلبة مجرد ثقل، سيفي أيّ شيء بالغرض
Dialogue: 0,0:17:59.67,0:18:05.04,Default,,0000,0000,0000,,المحلول الملحيّ الخاص بالعدسات اللاصقة\Nالمفقود من الثلاجة مثلاً
Dialogue: 0,0:18:06.12,0:18:11.71,Default,,0000,0000,0000,,...التجربة تقطع الشكّ، فلنفتح الباب
Dialogue: 0,0:18:12.52,0:18:16.54,Default,,0000,0000,0000,,!باب القدر الذي سيحلّ لغز هذه القضيّة
Dialogue: 0,0:18:25.26,0:18:26.85,Default,,0000,0000,0000,,!د-دخل
Dialogue: 0,0:18:26.85,0:18:28.96,Default,,0000,0000,0000,,!تفقّدوا قناة التصريف فوراً
Dialogue: 0,0:18:29.22,0:18:33.46,Default,,0000,0000,0000,,حضرة المفتّش! وجدنا خيط الصيد\N!ومحلول العدسات الملحيّ سلفاً
Dialogue: 0,0:18:33.46,0:18:38.04,Default,,0000,0000,0000,,!حماقة! كنتُ على الهاتف معها قبل أن تسقط
Dialogue: 0,0:18:38.04,0:18:40.54,Default,,0000,0000,0000,,!هي من اتّصل بي
Dialogue: 0,0:18:40.54,0:18:44.42,Default,,0000,0000,0000,,فلتجربوا إعادة طلب رقم المكتب من الهاتف\N!الخلويّ الذي كان على الشرفة
Dialogue: 0,0:18:44.42,0:18:46.38,Default,,0000,0000,0000,,سيتّصل به غالباً
Dialogue: 0,0:18:46.83,0:18:54.83,Default,,0000,0000,0000,,لأنّك استعملت ذاك الهاتف للاتّصال بالمكتب\Nبعد تنفيذ حيلتك الآنفة
Dialogue: 0,0:18:55.23,0:18:58.82,Default,,0000,0000,0000,,والصوت الذي سمعه تاناكا-سان
Dialogue: 0,0:18:58.82,0:19:04.58,Default,,0000,0000,0000,,كان جزءاً من رسالة لها على آلة الردّ الآلي\Nفي الاستوديو خاصتك على الأرجح
Dialogue: 0,0:19:04.97,0:19:08.81,Default,,0000,0000,0000,,مررت بالاستوديو في طريقك للمكتب من هنا
Dialogue: 0,0:19:08.81,0:19:12.96,Default,,0000,0000,0000,,وأخذت التسجيل الذي حوى صوتها
Dialogue: 0,0:19:14.58,0:19:17.96,Default,,0000,0000,0000,,في المكتب، دخلت الحمّام مباشرةً
Dialogue: 0,0:19:17.96,0:19:21.25,Default,,0000,0000,0000,,واتّصلت بالمكتب من هاتفك الخلويّ
Dialogue: 0,0:19:21.58,0:19:23.71,Default,,0000,0000,0000,,مرحباً، أنا تشونو
Dialogue: 0,0:19:24.20,0:19:26.91,Default,,0000,0000,0000,,،بعد أخذ السمّاعة من تاناكا-سان
Dialogue: 0,0:19:26.91,0:19:30.05,Default,,0000,0000,0000,,حوّلت انتباه الجميع للشرفة المقابلة
Dialogue: 0,0:19:30.05,0:19:35.85,Default,,0000,0000,0000,,لجعل سقوط مرأة ميتة سلفاً يبدو انتحاراً
Dialogue: 0,0:19:37.15,0:19:43.77,Default,,0000,0000,0000,,سلاح الجريمة الذي قتلته بها\Nكان منفضة السجائر تحت المكتب غالباً
Dialogue: 0,0:19:43.77,0:19:47.29,Default,,0000,0000,0000,,لا بدّ أن اللومينول سيعطي تفاعلاً إذا فحصتموها
Dialogue: 0,0:19:48.43,0:19:53.96,Default,,0000,0000,0000,,مع كلّ تحليلك، أتملك دليلاً أنّي قتلتها هنا؟
Dialogue: 0,0:19:54.38,0:19:59.46,Default,,0000,0000,0000,,أشكّ في ذلك، فاليوم أوّل مرة\Nآتي فيها إلى هنا
Dialogue: 0,0:19:59.88,0:20:01.91,Default,,0000,0000,0000,,متحرّي موري، القهوة جاهزة
Dialogue: 0,0:20:02.20,0:20:04.33,Default,,0000,0000,0000,,إذاً أيّها المتحرّي؟
Dialogue: 0,0:20:04.33,0:20:05.88,Default,,0000,0000,0000,,سأعطيها إيّاه
Dialogue: 0,0:20:10.90,0:20:12.99,Default,,0000,0000,0000,,!بأيّ حال، أنا بريء
Dialogue: 0,0:20:13.40,0:20:15.57,Default,,0000,0000,0000,,ماذا؟ ما هذا؟
Dialogue: 0,0:20:17.99,0:20:19.13,Default,,0000,0000,0000,,...إ-إنّها
Dialogue: 0,0:20:19.44,0:20:22.58,Default,,0000,0000,0000,,!أليس توقيع تشونو-سان؟
Dialogue: 0,0:20:23.77,0:20:30.55,Default,,0000,0000,0000,,صحيح، رسمته بطلاء أظافر عبثاً\Nبينما كان هو نائماً
Dialogue: 0,0:20:30.55,0:20:33.75,Default,,0000,0000,0000,,لـ-لكن كيف عرفت ذلك؟
Dialogue: 0,0:20:34.05,0:20:38.92,Default,,0000,0000,0000,,،كان يوجد طلاء أظافر على السرير\Nلكن لم يكن أيّ منه على أظافرها
Dialogue: 0,0:20:38.92,0:20:42.21,Default,,0000,0000,0000,,بينما كان على أظافر يد هاناوكا-سان
Dialogue: 0,0:20:43.21,0:20:47.33,Default,,0000,0000,0000,,كما أنّ بيع طلاء الأظافر ذاك بدأ اليوم
Dialogue: 0,0:20:47.33,0:20:49.84,Default,,0000,0000,0000,,إذا كنت تدّعي البراءة فأجبني
Dialogue: 0,0:20:49.84,0:20:53.90,Default,,0000,0000,0000,,متى وأين وصلتك تلك العلامة، ومن رسمها؟
Dialogue: 0,0:20:55.65,0:20:58.53,Default,,0000,0000,0000,,هـ-هذا ليس صحيحاً، أليس كذلك يا هاناوكا-سان؟
Dialogue: 0,0:20:58.53,0:21:01.29,Default,,0000,0000,0000,,...لا أصدّق أنك قد تقتل تشونو-كن
Dialogue: 0,0:21:01.29,0:21:04.75,Default,,0000,0000,0000,,دافع الجريمة كان رسماته غالباً
Dialogue: 0,0:21:05.63,0:21:08.69,Default,,0000,0000,0000,,فتوقيع تشونو-سان ظهر مرات عديدة
Dialogue: 0,0:21:08.69,0:21:11.33,Default,,0000,0000,0000,,أسفل توقيعه الخاص في ألبوم رسماته
Dialogue: 0,0:21:11.68,0:21:16.99,Default,,0000,0000,0000,,كانت رسوماً لها نفذتها متّبعةً أسلوبه غالباً
Dialogue: 0,0:21:17.97,0:21:20.21,Default,,0000,0000,0000,,...تحوّل ذلك لصراع
Dialogue: 0,0:21:20.21,0:21:22.37,Default,,0000,0000,0000,,!أجل، كما قلت
Dialogue: 0,0:21:22.37,0:21:25.92,Default,,0000,0000,0000,,فقدتُ أعصابي، وبعدما رجع عقلي \N!وجدت أنّي قتلتها
Dialogue: 0,0:21:26.21,0:21:30.59,Default,,0000,0000,0000,,لكن... قد لا يكون ذاك الدافع الوحيد
Dialogue: 0,0:21:31.29,0:21:35.07,Default,,0000,0000,0000,,كنتُ خائفاً، خائفاً من موهبتها الشابة
Dialogue: 0,0:21:36.07,0:21:39.32,Default,,0000,0000,0000,,كانت فتاة لطيفة وظريفة بدايةً
Dialogue: 0,0:21:39.32,0:21:42.52,Default,,0000,0000,0000,,كالفراشة التي ترفرف حول الأزهار
Dialogue: 0,0:21:43.48,0:21:45.54,Default,,0000,0000,0000,,لكن سرعان ما هيمنتْ على تلك الأزهار
Dialogue: 0,0:21:45.54,0:21:49.52,Default,,0000,0000,0000,,وبدأت بقتلها بامتصاص معظم رحيقها
Dialogue: 0,0:21:49.78,0:21:54.43,Default,,0000,0000,0000,,لذا نزعتُ أجنحتها... كيلا تطير مُجدداً
Dialogue: 0,0:23:25.99,0:23:29.03,Default,,0000,0000,0000,,ماذا؟ تريدون استعمال أبي في إعلان؟
Dialogue: 0,0:23:29.86,0:23:31.23,Default,,0000,0000,0000,,!سأعطيه السمّاعة الآن
Dialogue: 0,0:23:32.27,0:23:35.07,Default,,0000,0000,0000,,!أجل، معك المتحرّي العظيم موري كوغورو
Dialogue: 0,0:23:35.35,0:23:39.28,Default,,0000,0000,0000,,!شعبية أبي عالية حقّاً! ألبوم صور والآن إعلان تلفازي
Dialogue: 0,0:23:39.28,0:23:41.80,Default,,0000,0000,0000,,تبّاً، يحظى بكلِّ المجد
Dialogue: 0,0:23:42.72,0:23:45.98,Default,,0000,0000,0000,,!مستحيل! لن أظهر في إعلان كهذا أبداً
Dialogue: 0,0:23:47.72,0:23:49.60,Default,,0000,0000,0000,,أيّ إعلان كان؟
Dialogue: 0,0:23:49.60,0:23:51.68,Default,,0000,0000,0000,,عن حبوب منوّمة
Dialogue: 0,0:23:51.68,0:23:54.32,Default,,0000,0000,0000,,!قالوا أنّ كل ما عليّ فعله هو النوم، يا للجرأة
Dialogue: 0,0:23:54.99,0:23:57.96,Default,,0000,0000,0000,,!هذا إذاً؟ يلائمك تماماً
Dialogue: 0,0:24:03.43,0:24:05.41,Default,,0000,0000,0000,,!رائحة... بنزين
Dialogue: 0,0:24:08.87,0:24:12.78,Default,,0000,0000,0000,,لمَ العمّ؟ ألهذا علاقة بسفينة الشبح؟
Dialogue: 0,0:24:13.11,0:24:18.50,Default,,0000,0000,0000,,لا مُتحرٍّ مرموق ذي احترام\N!قد يهرب بعد سماع كلام كهذا
Dialogue: 0,0:24:21.74,0:24:24.37,Default,,0000,0000,0000,,!لـ-لمَ أنا؟
Dialogue: 0,0:24:24.08,0:24:30.08,On Top,,0000,0000,15,,(جريمة قتل سفينة الأشباح (الجزء الأوّل
Dialogue: 0,0:24:24.67,0:24:26.35,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.35,0:24:29.31,Default,,0000,0000,0000,,(جريمة قتل سفينة الأشباح (الجزء الأوّل
Dialogue: 0,0:24:45.67,0:24:47.80,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.80,0:24:49.74,Default,,0000,0000,0000,,منظار
Dialogue: 0,0:24:50.29,0:24:52.67,Default,,0000,0000,0000,,!الحلقة القادمة أوّل قضيّة أصليّة من جزئين
Dialogue: 0,0:24:52.67,0:24:54.67,Default,,0000,0000,0000,,أيمكنك رؤية النجوم أيضاً؟

