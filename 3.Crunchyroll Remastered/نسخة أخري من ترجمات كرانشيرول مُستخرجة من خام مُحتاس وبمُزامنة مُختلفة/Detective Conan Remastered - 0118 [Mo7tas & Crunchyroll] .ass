Dialogue: 0,0:00:01.46,0:00:04.80,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، وأوساكا تلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.80,0:00:06.37,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.67,0:00:08.67,Default,,0000,0000,0000,,!اليوم حلقة نانيوا من 60 دقيقة
Dialogue: 0,0:00:08.67,0:00:10.51,Default,,0000,0000,0000,,!حلقة خاصّة، كما قضيّتها وألغازها
Dialogue: 0,0:00:10.51,0:00:12.09,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.09,0:00:13.96,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ دماغه لبالغ
Dialogue: 0,0:00:13.96,0:00:16.30,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.34,0:00:24.13,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.13,0:00:31.17,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:33.19,0:00:39.30,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.30,0:00:46.80,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.80,0:00:59.26,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.13,0:01:06.55,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.46,0:01:13.26,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.26,0:01:19.80,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.80,0:01:26.04,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:46.06,0:01:48.69,Default,,0000,0000,0000,,هذه الحادثة في مدينة تويوناكا
Dialogue: 0,0:01:48.69,0:01:53.15,Default,,0000,0000,0000,,وهذه التي وقعت الأسبوع\Nالفائت في هيراكاتا
Dialogue: 0,0:01:53.15,0:01:55.77,Default,,0000,0000,0000,,لا شهود على جريمتي القتل هاتين
Dialogue: 0,0:01:55.77,0:01:58.05,Default,,0000,0000,0000,,ويفصل بين الموقعين عدّة كيلومترات
Dialogue: 0,0:01:59.62,0:02:02.75,Default,,0000,0000,0000,,نحن نتحرّى في وجود أيّ صلة \N،بين الضحيّتين حالياً
Dialogue: 0,0:02:03.73,0:02:05.87,Default,,0000,0000,0000,,لكن لا شيء مشترك بينهما حتّى الآن
Dialogue: 0,0:02:06.30,0:02:09.38,CharCard,,0000,0000,0004,,{\fad(200,0)}كبير المحقّقين توياما\Nقيادة شرطة أوساكا
Dialogue: 0,0:02:06.73,0:02:08.89,On Top,,0000,0000,0000,,فقط شيء واحد
Dialogue: 0,0:02:09.99,0:02:11.67,Default,,0000,0000,0000,,سلاح الجريمة، السكّين
Dialogue: 0,0:02:11.67,0:02:15.61,Default,,0000,0000,0000,,لا أعرف السبب، لكنّهما طُعنا في القلب
Dialogue: 0,0:02:15.61,0:02:18.80,Default,,0000,0000,0000,,عبر المحفظة في جيب معطفيهما
Dialogue: 0,0:02:19.23,0:02:22.27,Default,,0000,0000,0000,,هل أخبرت الإعلام عن هذا؟
Dialogue: 0,0:02:22.27,0:02:25.52,Default,,0000,0000,0000,,كلا، تكتّمت على أمر المحفظة
Dialogue: 0,0:02:25.86,0:02:33.77,Default,,0000,0000,0000,,أي أنّ حادثة القتل الثانية لم يكن \Nفعلة مقلّد أحمق
Dialogue: 0,0:02:33.77,0:02:37.49,Default,,0000,0000,0000,,أجل، كان نفس الشخص بلا شكّ
Dialogue: 0,0:02:38.23,0:02:40.32,Default,,0000,0000,0000,,...سلسلة جرائم قتل
Dialogue: 0,0:02:40.98,0:02:43.91,Default,,0000,0000,0000,,إذا كانت عشوائية، فستثير الهلع
Dialogue: 0,0:02:47.44,0:02:52.23,On Top,,0000,0000,0000,,توياما، حاذر ألّا ترتكب أيّ زلّة
Dialogue: 0,0:02:47.87,0:02:52.23,CharCard,,0000,0000,0004,,{\fad(200,100)}هاتّوري هيزو\Nقائد شرطة أوساكا
Dialogue: 0,0:02:52.23,0:02:54.25,On Top,,0000,0000,0000,,أجل، أعي ذلك
Dialogue: 0,0:02:56.09,0:03:02.14,Title,,0000,0000,15,,{\fad(200,0)}قضيّة جرائم قتل نانيوا التسلسلية
Dialogue: 0,0:02:56.73,0:02:59.94,Default,,0000,0000,0000,,قضيّة جرائم قتل نانيوا التسلسلية
Dialogue: 0,0:03:02.44,0:03:05.06,Default,,0000,0000,0000,,هذه حديقة حيوانات تينّوجي
Dialogue: 0,0:03:05.44,0:03:07.77,Default,,0000,0000,0000,,وتلك قبّة أوساكا
Dialogue: 0,0:03:08.01,0:03:11.48,Default,,0000,0000,0000,,وهذا برج تسوتينكاكو
Dialogue: 0,0:03:11.48,0:03:14.23,Default,,0000,0000,0000,,ما رأيكم؟ أليست أوساكا رائعة؟
Dialogue: 0,0:03:14.56,0:03:16.69,Default,,0000,0000,0000,,بلى، المنظر رائع
Dialogue: 0,0:03:17.11,0:03:21.16,Default,,0000,0000,0000,,لكن لا يبدو مختلفاً عن برج طوكيو
Dialogue: 0,0:03:21.16,0:03:25.08,Default,,0000,0000,0000,,أحمق! لا تقارنه بذاك الشيء\Nا!لأحمر عديم الذوق
Dialogue: 0,0:03:25.52,0:03:28.11,Default,,0000,0000,0000,,تسوتينكاكو هذا وحيّ "شين سينكاي" المحيط به
Dialogue: 0,0:03:28.11,0:03:32.04,Default,,0000,0000,0000,,!يشعّان بطبيعة أهل أوساكا
Dialogue: 0,0:03:32.52,0:03:35.50,Default,,0000,0000,0000,,تبدو كوسط مدينة طوكيو
Dialogue: 0,0:03:35.73,0:03:37.90,Default,,0000,0000,0000,,ما رأيك بأن نتناول الطعام الآن؟
Dialogue: 0,0:03:37.90,0:03:40.97,Default,,0000,0000,0000,,انتظروا قليلاً، سيأتي أحدهم لاصطحابنا
Dialogue: 0,0:03:41.21,0:03:44.23,Default,,0000,0000,0000,,ليس باليد حيلة، سأذهب لتدخين لفافة
Dialogue: 0,0:03:44.23,0:03:45.25,Default,,0000,0000,0000,,هاتّوري
Dialogue: 0,0:03:47.40,0:03:50.39,Default,,0000,0000,0000,,أخبرني بسبب استدعائك لي إلى أوساكا؟
Dialogue: 0,0:03:50.65,0:03:53.06,Default,,0000,0000,0000,,ماذا؟ أكنت قلقاً حيال ذلك؟
Dialogue: 0,0:03:53.06,0:03:56.06,Default,,0000,0000,0000,,لديك دافع آخر حقيقيّ، أليس كذلك؟
Dialogue: 0,0:03:56.06,0:03:59.61,Default,,0000,0000,0000,,كلا، كلا! لا عمل هذه المرّة حقّاً
Dialogue: 0,0:04:00.15,0:04:03.57,Default,,0000,0000,0000,,خطر لي أن أطلعكم على أوساكا لا أكثر
Dialogue: 0,0:04:04.15,0:04:08.00,Default,,0000,0000,0000,,فلا يعرف المرء متى يفارق الحياة
Dialogue: 0,0:04:08.00,0:04:10.12,Default,,0000,0000,0000,,ما-ما قصدك بذلك؟
Dialogue: 0,0:04:13.15,0:04:15.34,Default,,0000,0000,0000,,راودني حلمٌ غريب
Dialogue: 0,0:04:15.86,0:04:16.69,Default,,0000,0000,0000,,حلم؟
Dialogue: 0,0:04:16.69,0:04:21.06,Default,,0000,0000,0000,,أجل، نكون فيه على وشك الإمساك بالمجرم
Dialogue: 0,0:04:21.06,0:04:23.05,Default,,0000,0000,0000,,لكنّه يطعنك في المقابل
Dialogue: 0,0:04:23.65,0:04:25.55,Default,,0000,0000,0000,,!فتموت
Dialogue: 0,0:04:26.94,0:04:29.47,Default,,0000,0000,0000,,!أنت، لا تقتل الآخرين من تلقاء نفسك
Dialogue: 0,0:04:30.15,0:04:34.40,Default,,0000,0000,0000,,حسناً، هذا ما عليه الأمر، لذا فلتستمتع بأوساكا
Dialogue: 0,0:04:35.72,0:04:37.39,Default,,0000,0000,0000,,!آسف يا هيجي-كن
Dialogue: 0,0:04:38.53,0:04:39.77,Default,,0000,0000,0000,,أتى أخيراً
Dialogue: 0,0:04:40.27,0:04:44.11,CharCard,,0000,0000,0004,,{\fad(200,200)}(ساكاتا يوسكي (26\Nمحقّق في مركز توجيري، القسم الأوّل
Dialogue: 0,0:04:41.01,0:04:44.11,On Top,,0000,0000,0000,,أنا ساكاتا من مركز توجيري \Nلشرطة محافظة أوساكا
Dialogue: 0,0:04:44.11,0:04:45.69,On Top,,0000,0000,0000,,أعتذر على التأخير
Dialogue: 0,0:04:46.10,0:04:47.85,Default,,0000,0000,0000,,لمَ أتى محقّق شرطة هنا؟
Dialogue: 0,0:04:47.85,0:04:51.85,Default,,0000,0000,0000,,أخبرني أبي أنّه في حال\N،قدوم العمّ موري إلى أوساكا
Dialogue: 0,0:04:51.85,0:04:54.77,Default,,0000,0000,0000,,فعليّ أن أصطحبه في جولة إرشاديّة لائقة
Dialogue: 0,0:04:56.01,0:04:59.91,Default,,0000,0000,0000,,ماذا؟ أين أبي؟ قال أنّه سيمرّ بنا
Dialogue: 0,0:05:00.60,0:05:03.33,Default,,0000,0000,0000,,حضرة الرئيس مشغولٌ في اجتماع\Nبشأن تلك القضيّة
Dialogue: 0,0:05:03.33,0:05:05.50,Default,,0000,0000,0000,,تلك القضيّة؟
Dialogue: 0,0:05:05.93,0:05:08.93,Default,,0000,0000,0000,,إذاً، هل جهّزت تلك السيّارة؟
Dialogue: 0,0:05:08.93,0:05:10.26,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:05:10.26,0:05:15.47,Default,,0000,0000,0000,,فعلتُ ما طلبتَه منّي، وأخذت أفضل\N!سيّارة في مركز توجيري
Dialogue: 0,0:05:15.89,0:05:18.93,Default,,0000,0000,0000,,مهلك، أيمكن أنّ تلك السيّارة
Dialogue: 0,0:05:19.43,0:05:21.23,Default,,0000,0000,0000,,!هيّا، هلمّ بنا
Dialogue: 0,0:05:23.47,0:05:25.19,Default,,0000,0000,0000,,أليس هذا رائعاً؟
Dialogue: 0,0:05:25.58,0:05:27.31,Default,,0000,0000,0000,,!لا شيء يغلب سيّارات الشرطة
Dialogue: 0,0:05:27.31,0:05:29.48,Default,,0000,0000,0000,,يمكنك تجاوز بقيّة السيّارات\N!حتى في الازدحام المروري
Dialogue: 0,0:05:30.39,0:05:32.32,Default,,0000,0000,0000,,إذاً أين مقصدكم يا حضرة الضيوف؟
Dialogue: 0,0:05:33.35,0:05:34.87,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:05:35.10,0:05:38.43,Default,,0000,0000,0000,,!أتخبرنا أن نجوب أوساكا بهذه السيّارة؟
Dialogue: 0,0:05:38.43,0:05:41.24,Default,,0000,0000,0000,,ماذا؟ لم تنل إعجابك؟
Dialogue: 0,0:05:41.24,0:05:43.31,Default,,0000,0000,0000,,إنّها حديثة الطراز
Dialogue: 0,0:05:44.54,0:05:50.26,Default,,0000,0000,0000,,بالمناسبة، ما رأيكم أن نشغّل الصافرات؟\Nيمكننا الإسراع أكثر
Dialogue: 0,0:05:50.26,0:05:52.47,Default,,0000,0000,0000,,...لا، ليس الأمر هكذا
Dialogue: 0,0:05:53.06,0:05:57.43,Default,,0000,0000,0000,,يبدو أنّنا معتقلون، فالأمر مُحرج قليلاً
Dialogue: 0,0:05:57.85,0:06:02.43,Default,,0000,0000,0000,,!لا تقلقوا حيال ذلك! لم تقدموا على أيّ أمر سيّئ
Dialogue: 0,0:06:02.43,0:06:04.60,Default,,0000,0000,0000,,!فيمكنكم رفع رؤوسكم بفخر
Dialogue: 0,0:06:05.26,0:06:07.56,Default,,0000,0000,0000,,!ما رأيكم؟ هذا هو الأودون الحقيقيّ
Dialogue: 0,0:06:07.97,0:06:10.97,Default,,0000,0000,0000,,الحساء صافٍ بحيث ترون قاع الوعاء
Dialogue: 0,0:06:10.97,0:06:11.99,Default,,0000,0000,0000,,!معك حقّ
Dialogue: 0,0:06:25.43,0:06:26.96,Default,,0000,0000,0000,,نكهته خفيفة، لكنّه لذيذ
Dialogue: 0,0:06:28.89,0:06:30.42,Default,,0000,0000,0000,,لا مذاق له
Dialogue: 0,0:06:30.89,0:06:35.09,Default,,0000,0000,0000,,هيجي! من هذه الفتاة؟ \Nحبيبة جديدة؟
Dialogue: 0,0:06:35.97,0:06:36.97,Default,,0000,0000,0000,,أيبدو كذلك؟
Dialogue: 0,0:06:36.97,0:06:40.35,Default,,0000,0000,0000,,...كلا! أنا زائرة عاديّة من طوكيو
Dialogue: 0,0:06:44.26,0:06:45.43,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:06:45.43,0:06:47.27,Default,,0000,0000,0000,,...شعرتُ ببرودةٍ ما
Dialogue: 0,0:06:48.72,0:06:50.44,Default,,0000,0000,0000,,إذاً، أين تريدون الذهاب تالياً؟
Dialogue: 0,0:06:50.93,0:06:54.95,Default,,0000,0000,0000,,حسناً، الشيء الثاني الذي تتميّز\N...به أوساكا بعد الأودون
Dialogue: 0,0:06:55.60,0:06:57.36,Default,,0000,0000,0000,,!لذيذ
Dialogue: 0,0:06:57.36,0:07:00.43,Default,,0000,0000,0000,,أليس هذا التاكوياكي لذيذاً جدّاً؟
Dialogue: 0,0:07:00.43,0:07:03.37,Default,,0000,0000,0000,,لم يسبق ورأيته يحتوي\Nأخطبوطاً كبيراً كهذا
Dialogue: 0,0:07:04.39,0:07:05.04,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:07:05.35,0:07:10.38,Default,,0000,0000,0000,,لا شيء، أشعر كأنّ أحدهم\Nيراقبني لفترة فقط
Dialogue: 0,0:07:10.68,0:07:13.84,Default,,0000,0000,0000,,!لا تقلقي حيال ذلك، وكلي فحسب
Dialogue: 0,0:07:15.56,0:07:17.81,Default,,0000,0000,0000,,!لا أستطيع الإهمال معكما
Dialogue: 0,0:07:17.81,0:07:20.64,Default,,0000,0000,0000,,ظننتُ أنّكِ في حمية
Dialogue: 0,0:07:21.89,0:07:26.23,Default,,0000,0000,0000,,أوكونومياكي؟َ لمَ لم تذكروا\N!ذلك قبل التاكوياكي؟
Dialogue: 0,0:07:26.72,0:07:29.26,Default,,0000,0000,0000,,المطعم اللذيذ الذي أعرفه\Nشمال المكان من هنا
Dialogue: 0,0:07:29.26,0:07:32.19,Default,,0000,0000,0000,,نحن في الطريق المعاكس! لا يمكننا\N!الذهاب هناك عبر ميدوسوجي
Dialogue: 0,0:07:32.76,0:07:34.89,Default,,0000,0000,0000,,،أوساكا مليئة بالطرق أحاديّة الاتّجاه
Dialogue: 0,0:07:34.89,0:07:38.22,Default,,0000,0000,0000,,لذا اعتماداً على موقعك، قد يتعيّن\Nعليك أخذ منعطف طويل
Dialogue: 0,0:07:38.22,0:07:42.12,Default,,0000,0000,0000,,في تلك الحالة، هل أصطحبهم إلى\Nمكان قريب أعرفه؟
Dialogue: 0,0:07:42.68,0:07:45.58,Default,,0000,0000,0000,,من الجيّد أنّه كان يوجد\Nمطعم جيّد بالقرب
Dialogue: 0,0:07:45.93,0:07:49.76,Default,,0000,0000,0000,,سأتّصل بأمّي سريعاً
Dialogue: 0,0:07:49.76,0:07:52.79,Default,,0000,0000,0000,,!يا عمّ! لا تنسَ الأرز
Dialogue: 0,0:07:53.43,0:07:56.26,Default,,0000,0000,0000,,تأكل الأكونومياكي مع الأرزّ؟
Dialogue: 0,0:07:56.57,0:08:00.32,Default,,0000,0000,0000,,هذا طبيعيّ، فالأكونومياكي طبق جانبيّ
Dialogue: 0,0:08:00.70,0:08:04.02,Default,,0000,0000,0000,,!توجد صلصة على الأرزّ، وتجعل طعمه لذيذاً
Dialogue: 0,0:08:06.45,0:08:08.31,Default,,0000,0000,0000,,!أوساكا مثيرة للاهتمام حقّاً
Dialogue: 0,0:08:08.31,0:08:09.16,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:08:12.30,0:08:13.46,Default,,0000,0000,0000,,...هذا المقعد محجو
Dialogue: 0,0:08:15.70,0:08:17.67,Default,,0000,0000,0000,,أنت كودو، أليس كذلك؟
Dialogue: 0,0:08:19.86,0:08:23.72,Default,,0000,0000,0000,,يتكلّم هيجي عنك دوماً
Dialogue: 0,0:08:24.86,0:08:26.18,Default,,0000,0000,0000,,!مهلك! مهلك
Dialogue: 0,0:08:26.57,0:08:28.39,Default,,0000,0000,0000,,هاتّوري-كن؟
Dialogue: 0,0:08:28.69,0:08:33.35,Default,,0000,0000,0000,,لا داعي للتظاهر بالحماقة، فأنا أعرف كلّ شيء
Dialogue: 0,0:08:34.07,0:08:35.19,Default,,0000,0000,0000,,!لـ-لحظة
Dialogue: 0,0:08:35.19,0:08:36.57,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:08:37.75,0:08:42.41,Default,,0000,0000,0000,,الفتاة كودو التي أغوته عندما\N!كان في طوكيو، أليس كذلك؟
Dialogue: 0,0:08:44.74,0:08:47.03,Default,,0000,0000,0000,,...المعذرة، أظنّكِ أسأتِ الفهم
Dialogue: 0,0:08:48.20,0:08:51.20,Default,,0000,0000,0000,,سأخبرك بأمرٍ واحد
Dialogue: 0,0:08:51.20,0:08:56.33,Default,,0000,0000,0000,,"أنا وهيجي مربوطان بـ "السلسة الحديديّة\N منذ وقتٍ طويل
Dialogue: 0,0:08:56.95,0:09:00.70,Default,,0000,0000,0000,,!إذا أردتِ العبث مع هيجي، فعليكِ تجاوزي
Dialogue: 0,0:09:00.70,0:09:02.49,Default,,0000,0000,0000,,ماذا يا كازوها؟
Dialogue: 0,0:09:03.62,0:09:06.01,Default,,0000,0000,0000,,ما الذي تفعلينه هنا؟
Dialogue: 0,0:09:08.32,0:09:09.97,Default,,0000,0000,0000,,!يا لطرافتها
Dialogue: 0,0:09:10.24,0:09:13.93,On Top,,0000,0000,0000,,كودو الذي كنت أتكلّم عنه\N!هو شاب! شاب
Dialogue: 0,0:09:10.58,0:09:14.03,CharCard,,0000,0000,0004,,{\fad(200,0)}(توياما كازوها (17\Nصديقة طفولة هيجي
Dialogue: 0,0:09:14.63,0:09:17.50,On Top,,0000,0000,0000,,وهذه الآنسة هي فتاة كودو
Dialogue: 0,0:09:19.13,0:09:20.58,Default,,0000,0000,0000,,فتاته؟
Dialogue: 0,0:09:20.58,0:09:22.63,Default,,0000,0000,0000,,!لـ-ليس الأمر هكذا
Dialogue: 0,0:09:22.96,0:09:24.61,Default,,0000,0000,0000,,إنّها تخالفك
Dialogue: 0,0:09:24.61,0:09:26.58,Default,,0000,0000,0000,,لكنّها تحمرّ خجلاً
Dialogue: 0,0:09:27.76,0:09:30.80,Default,,0000,0000,0000,,لمَ لم تستدعي كودو-كن ذاك\Nإلى هنا أيضاً إذاً؟
Dialogue: 0,0:09:31.09,0:09:33.31,Default,,0000,0000,0000,,...يا حمقاء! كودو موجـ
Dialogue: 0,0:09:34.63,0:09:36.72,Default,,0000,0000,0000,,!مـ-مشغول، فلم يستطع القدوم
Dialogue: 0,0:09:39.30,0:09:43.19,Default,,0000,0000,0000,,عموماً، أخبرنا عن رابطة\N!تلك السلسلة الحديديّة
Dialogue: 0,0:09:44.05,0:09:47.20,Default,,0000,0000,0000,,...في صغرنا، وجدت في عليّة منزلي
Dialogue: 0,0:09:47.77,0:09:51.62,Default,,0000,0000,0000,,أصفاداً قديمة لأبي مع كازوها
Dialogue: 0,0:09:52.26,0:09:56.36,Default,,0000,0000,0000,,عندما قرّرنا لعب لعبة الشرطة، لم نستطع نزعها بعدها
Dialogue: 0,0:09:58.01,0:10:00.84,Default,,0000,0000,0000,,ومررنا بوقتٍ عصيب، كان أمراً سخيفاً
Dialogue: 0,0:10:00.84,0:10:03.11,Default,,0000,0000,0000,,!لم يكن سخيفاً
Dialogue: 0,0:10:03.11,0:10:06.13,Default,,0000,0000,0000,,فقد كان علينا الاستحمام واستعمال\Nالمرحاض سويّاً وقتها
Dialogue: 0,0:10:06.13,0:10:08.34,Default,,0000,0000,0000,,!حمقاء! لا داعي لتخبريهم بذلك
Dialogue: 0,0:10:08.84,0:10:10.80,Default,,0000,0000,0000,,الاستحمام واستعمال المرحاض؟
Dialogue: 0,0:10:11.21,0:10:14.26,Default,,0000,0000,0000,,أي أنّها علاقة منتنة
Dialogue: 0,0:10:14.59,0:10:20.34,Default,,0000,0000,0000,,إحياءً للذكرى، أضفت قطعةً من تلك\Nالسلسلة في تميمة الحظّ هذه
Dialogue: 0,0:10:20.34,0:10:23.73,Default,,0000,0000,0000,,!مقرف! تخلّصي منها
Dialogue: 0,0:10:23.96,0:10:27.15,Default,,0000,0000,0000,,أخبراني، أأنتما في علاقة عاطفيّة؟
Dialogue: 0,0:10:29.34,0:10:33.09,Default,,0000,0000,0000,,!كـ-كلا! أنا وهيجي مجرّد صديقا طفولة
Dialogue: 0,0:10:33.09,0:10:36.41,Default,,0000,0000,0000,,أنا أشبه بأخته الكبيرة التي\Nتعتني به دوماً
Dialogue: 0,0:10:36.84,0:10:38.37,Default,,0000,0000,0000,,لا يحقّ لك قول ذلك
Dialogue: 0,0:10:39.05,0:10:44.63,Default,,0000,0000,0000,,،والدها كبير المحقّقين في شرطة أوساكا\Nوهو صديق أبي
Dialogue: 0,0:10:44.63,0:10:47.47,Default,,0000,0000,0000,,،فكنّا نعرف بعضنا مُذ صغرنا\Nهذا كلّ ما بالأمر
Dialogue: 0,0:10:48.76,0:10:52.21,Default,,0000,0000,0000,,...صبي متحرٍّ وابنة محقّق شرطة
Dialogue: 0,0:10:52.21,0:10:54.05,Default,,0000,0000,0000,,يا للثنائيّ المشؤوم
Dialogue: 0,0:10:54.05,0:10:56.30,Default,,0000,0000,0000,,ماذا؟ لمَ؟ لا أرى مشكلة
Dialogue: 0,0:10:58.51,0:11:00.88,Default,,0000,0000,0000,,لكن لمَ أنتِ هنا؟
Dialogue: 0,0:11:00.88,0:11:04.84,Default,,0000,0000,0000,,،بما أنّي أؤدي دور أختك الكبيرة\Nكنت أقوم بمراقبتك
Dialogue: 0,0:11:04.84,0:11:08.65,Default,,0000,0000,0000,,كيلا تغويك فتاة طوكيو الغريبة
Dialogue: 0,0:11:10.05,0:11:12.11,Default,,0000,0000,0000,,مراقبتي؟ من أين؟
Dialogue: 0,0:11:12.63,0:11:14.53,Default,,0000,0000,0000,,برج تسوتينكاكو
Dialogue: 0,0:11:15.22,0:11:16.61,On Top,,0000,0000,0000,,!لا تفعلي ذلك
Dialogue: 0,0:11:15.67,0:11:16.61,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:11:16.93,0:11:18.17,On Top,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:11:17.98,0:11:20.55,Default,,0000,0000,0000,,كانت هي صاحبة تلك الرمقة
Dialogue: 0,0:11:18.17,0:11:19.91,On Top,,0000,0000,0000,,لأنّه مقرف
Dialogue: 0,0:11:19.91,0:11:22.05,On Top,,0000,0000,0000,,ما سلوكك هذا؟ كنت قلقةً عليك
Dialogue: 0,0:11:23.34,0:11:24.59,Default,,0000,0000,0000,,شكراً على الطعام
Dialogue: 0,0:11:24.59,0:11:26.17,Default,,0000,0000,0000,,أكلتُ كثيراً
Dialogue: 0,0:11:26.67,0:11:28.13,Default,,0000,0000,0000,,كان الطعام لذيذاً
Dialogue: 0,0:11:28.46,0:11:33.55,Default,,0000,0000,0000,,،نعتذر على جعلك تنتظر\N!كان حريّ بك مشاركتنا
Dialogue: 0,0:11:33.55,0:11:36.09,Default,,0000,0000,0000,,لا داعي، دوري اصطحابكم فحسب
Dialogue: 0,0:11:39.38,0:11:41.01,Default,,0000,0000,0000,,أين نذهب تالياً؟
Dialogue: 0,0:11:41.01,0:11:44.02,Default,,0000,0000,0000,,أرى أنّ أفضل مكان هي قلعة أوساكا
Dialogue: 0,0:11:44.92,0:11:46.85,Default,,0000,0000,0000,,لمَ صعدتِ؟
Dialogue: 0,0:11:47.13,0:11:49.81,Default,,0000,0000,0000,,!أين المشكلة؟ اصطحبوني معكم
Dialogue: 0,0:11:50.01,0:11:51.90,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:11:56.51,0:11:57.45,Default,,0000,0000,0000,,ماذا هناك؟
Dialogue: 0,0:12:34.96,0:12:36.96,Default,,0000,0000,0000,,ما خطب هذا الرجل؟
Dialogue: 0,0:12:36.96,0:12:40.30,Default,,0000,0000,0000,,لا أدري، سقط على غطاء السيّارة فجأةً
Dialogue: 0,0:12:41.05,0:12:42.85,Default,,0000,0000,0000,,من سطح هذا المبنى
Dialogue: 0,0:12:43.51,0:12:45.01,Default,,0000,0000,0000,,!يوجد أحد هناك
Dialogue: 0,0:12:45.76,0:12:48.46,Default,,0000,0000,0000,,!ساكاتا-هان! اتّصل بالشرطة
Dialogue: 0,0:12:48.46,0:12:49.23,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:12:49.67,0:12:50.56,Default,,0000,0000,0000,,!مهلك
Dialogue: 0,0:12:50.56,0:12:51.54,Default,,0000,0000,0000,,!هيجي
Dialogue: 0,0:12:51.54,0:12:52.15,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:13:03.84,0:13:04.80,Default,,0000,0000,0000,,،حسناً
Dialogue: 0,0:13:04.80,0:13:09.67,Default,,0000,0000,0000,,أخبرنا لمَ أسقطت الجثّة\Nعلى سيّارة شرطة؟
Dialogue: 0,0:13:11.46,0:13:13.85,Default,,0000,0000,0000,,...كـ-كلا! أنا فقط
Dialogue: 0,0:13:14.76,0:13:18.42,Default,,0000,0000,0000,,ماذا؟ اُستدعي للسطح؟
Dialogue: 0,0:13:18.63,0:13:25.71,Default,,0000,0000,0000,,أجل، تلقّى هذا الرجل اتّصالاً يفيد\Nبوجود رجل غريب على السطح، فصعد هناك
Dialogue: 0,0:13:25.71,0:13:29.45,Default,,0000,0000,0000,,أنا أدير متجر شاي في الطابق\Nالثاني لهذه البناية
Dialogue: 0,0:13:30.71,0:13:33.82,Default,,0000,0000,0000,,لكن ما الذي أسقط الجثّة؟
Dialogue: 0,0:13:34.21,0:13:38.17,Default,,0000,0000,0000,,كانت الجثّة مربوطةً بحبل، ومعلّقةً بسور السطح المعدنيّ
Dialogue: 0,0:13:38.17,0:13:42.13,Default,,0000,0000,0000,,ويغطّيها غطاء فينيليّ، بينما طرف الحبل الآخر
Dialogue: 0,0:13:42.13,0:13:45.79,Default,,0000,0000,0000,,رُبط بالباب بحيث ينحلّ عندما يفتحه أحد
Dialogue: 0,0:13:46.46,0:13:50.88,Default,,0000,0000,0000,,وقت وفاته المقدّر هو قبل \Nيومٍ كامل من الآن
Dialogue: 0,0:13:50.88,0:13:55.71,Default,,0000,0000,0000,,أي أنّ أحدهم قتله بالأمس قرابة\Nهذا الوقت وجعله يتدلّى
Dialogue: 0,0:13:56.09,0:13:58.84,Default,,0000,0000,0000,,لكن لمَ فوق سيّارة شرطة؟
Dialogue: 0,0:13:58.84,0:14:02.01,Default,,0000,0000,0000,,لعلّ سقوطه عليها كان محض مصادفة
Dialogue: 0,0:14:02.01,0:14:05.72,Default,,0000,0000,0000,,أو ربما ضرب مثال من أحدهم
Dialogue: 0,0:14:06.17,0:14:07.14,Default,,0000,0000,0000,,ضرب مثال؟
Dialogue: 0,0:14:08.21,0:14:12.05,Default,,0000,0000,0000,,...سكّين اخترقت المحفظة وطعنت صدره
Dialogue: 0,0:14:12.05,0:14:14.11,Default,,0000,0000,0000,,هذا مرتبط بتلك القضيّة بوضوح
Dialogue: 0,0:14:18.30,0:14:19.86,Default,,0000,0000,0000,,!لحظة، يا سيّدة
Dialogue: 0,0:14:19.86,0:14:20.94,Default,,0000,0000,0000,,!انتظري
Dialogue: 0,0:14:20.94,0:14:21.93,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:14:26.80,0:14:28.04,Default,,0000,0000,0000,,رحلت
Dialogue: 0,0:14:28.30,0:14:31.00,Default,,0000,0000,0000,,لا بأس، حفظت رقم لوحتها
Dialogue: 0,0:14:31.30,0:14:36.34,Default,,0000,0000,0000,,ذلك جانباً، أخبرني عن تلك القضيّة \Nالتي ذكرتها يا هاتّوري
Dialogue: 0,0:14:38.77,0:14:42.17,CharCard,,0000,0000,0004,,{\fad(200,0)}مركز شرطة توجيري -  محافظة أوساكا
Dialogue: 0,0:14:38.80,0:14:42.34,On Top,,0000,0000,0000,,!سـ-سلسلة جرائم قتل؟
Dialogue: 0,0:14:42.71,0:14:46.26,Default,,0000,0000,0000,,!والرجل الذي سقط قبل قليل هو الضحيّة الثالثة؟
Dialogue: 0,0:14:46.63,0:14:47.76,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:14:47.76,0:14:52.05,Default,,0000,0000,0000,,في كلّ جريمة، طُعن الضحيّة في صدره عبر محفظته
Dialogue: 0,0:14:52.05,0:14:55.23,Default,,0000,0000,0000,,بعدما قُتل خنقاً بشيءٍ ما
Dialogue: 0,0:14:55.43,0:14:58.82,Default,,0000,0000,0000,,ألا يمكن أنّه شخص يكنّ ضغينةً\Nبسبب المال؟
Dialogue: 0,0:14:59.03,0:15:01.28,Default,,0000,0000,0000,,لا يمكننا الجزم بذلك
Dialogue: 0,0:15:01.71,0:15:04.13,On Top,,0000,0000,0000,,،كان الضحيّة الأولى، ناغاو هيديتوشي
Dialogue: 0,0:15:01.71,0:15:05.11,CharCard,,0000,0000,0004,,{\fad(200,0)}ناغاو هيديتوشي\Nمالك متجر تموينات
Dialogue: 0,0:15:04.13,0:15:05.11,On Top,,0000,0000,0000,,مالك متجر تموينات
Dialogue: 0,0:15:05.57,0:15:07.66,On Top,,0000,0000,0000,,،والضحيّة التالية، نيشيغوتشي تايو
Dialogue: 0,0:15:05.65,0:15:10.10,CharCard,,0000,0000,0004,,{\fad(200,0)}نيشيغوتشي تايو\Nمالكة حانة صغيرة
Dialogue: 0,0:15:07.66,0:15:09.91,On Top,,0000,0000,0000,,كانت مالكة حانة صغيرة
Dialogue: 0,0:15:09.91,0:15:12.74,On Top,,0000,0000,0000,,،والضحيّة التي سقطت قبل قليل، نوياسو كازوتو
Dialogue: 0,0:15:10.59,0:15:15.07,CharCard,,0000,0000,0004,,{\fad(200,0)}نوياسو كازوتو\Nسائق سيّارة أجرة
Dialogue: 0,0:15:12.74,0:15:15.07,On Top,,0000,0000,0000,,كان سائق سيّارة أجرة
Dialogue: 0,0:15:15.31,0:15:19.24,Default,,0000,0000,0000,,لم يملك أيٌّ منهم مالاً يكفي\Nليثير ضغينة أحدهم
Dialogue: 0,0:15:19.24,0:15:23.49,Default,,0000,0000,0000,,كما لا تربطهم أيّ صلة حتّى الآن
Dialogue: 0,0:15:23.82,0:15:25.70,Default,,0000,0000,0000,,لا صلة؟
Dialogue: 0,0:15:25.70,0:15:26.53,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:15:26.53,0:15:30.99,Default,,0000,0000,0000,,كانت ولادتهم ونشأتهم ودراستهم\Nكما نطاق عملهم في أوساكا
Dialogue: 0,0:15:30.99,0:15:32.71,Default,,0000,0000,0000,,لكن في أماكن متفرّقة
Dialogue: 0,0:15:35.32,0:15:39.01,Default,,0000,0000,0000,,!وجدناها يا هيجي-كن! الصلة بين الضحايا
Dialogue: 0,0:15:39.53,0:15:40.31,Default,,0000,0000,0000,,!حقّاً؟
Dialogue: 0,0:15:45.30,0:15:47.03,Default,,0000,0000,0000,,!غوشي-سان! ألديك أيّة تعليقات؟
Dialogue: 0,0:15:47.03,0:15:48.06,Default,,0000,0000,0000,,!غوشي-سان
Dialogue: 0,0:15:49.07,0:15:56.15,Default,,0000,0000,0000,,ما هذا؟ أليست قضيّة محاكمة فساد عضو\Nمجلس النوّاب غوشي سوتارو قبل 6 أعوام؟
Dialogue: 0,0:15:56.63,0:16:00.86,Default,,0000,0000,0000,,القضيّة التي تحمّل فيها المساعد كامل\Nالمسؤولية واستقال من عمله؟
Dialogue: 0,0:16:01.45,0:16:04.45,Default,,0000,0000,0000,,...وفقما أذكر، كان اسم المساعد ناغاو
Dialogue: 0,0:16:04.45,0:16:06.78,Default,,0000,0000,0000,,...لحظة، أيمكن أنّ ناغاو
Dialogue: 0,0:16:07.11,0:16:08.29,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:08.66,0:16:12.71,Default,,0000,0000,0000,,كان هذا الرجل الضحيّة الأولى، ناغاو هيديتوشي
Dialogue: 0,0:16:13.36,0:16:17.70,Default,,0000,0000,0000,,لكن ألم تتفقّد ذلك سلفاً؟ لمَ تذكره مجدداً؟
Dialogue: 0,0:16:17.70,0:16:20.92,Default,,0000,0000,0000,,كلا، ما أريدك منك النظر إليه هو السائق
Dialogue: 0,0:16:21.53,0:16:22.86,Default,,0000,0000,0000,,السائق؟
Dialogue: 0,0:16:24.87,0:16:28.31,Default,,0000,0000,0000,,!هـ-هذا نوياسو، الضحيّة الثالثة
Dialogue: 0,0:16:28.86,0:16:32.77,Default,,0000,0000,0000,,كان سائق عضو مجلس النوّاب غوشي\Nحتّى قبل أربعة وفقما يبدو
Dialogue: 0,0:16:33.53,0:16:36.32,Default,,0000,0000,0000,,...مساعده السابق وسائقه الشخصيّ السابق
Dialogue: 0,0:16:36.32,0:16:39.94,Default,,0000,0000,0000,,قد يكون هذا مرتبطاً بعضو\Nمجلس النوّاب غوشي
Dialogue: 0,0:16:40.32,0:16:45.57,Default,,0000,0000,0000,,فكرنا بذلك، لذا يتّجه أحد زملائي\Nالأكبر خبرة إلى منزله الآن
Dialogue: 0,0:16:46.16,0:16:50.29,Default,,0000,0000,0000,,لكنّ غوشي مشهور بكرهه للشرطة
Dialogue: 0,0:16:50.91,0:16:53.25,Default,,0000,0000,0000,,قد يتطلّب مجرّد لقائه عناءً
Dialogue: 0,0:16:53.91,0:16:57.21,Default,,0000,0000,0000,,ما رأيك بأن نذهب له بدورنا يا ساكاتا-هان؟
Dialogue: 0,0:16:57.49,0:17:00.67,Default,,0000,0000,0000,,!مهلك! عليك ترك ذلك للشرطة
Dialogue: 0,0:17:01.28,0:17:02.61,Default,,0000,0000,0000,,أحمق
Dialogue: 0,0:17:02.61,0:17:07.64,Default,,0000,0000,0000,,لا أستطيع ترك الشخص الذي أفسد جولتكم\Nفي أوساكا يعبث طليقاً
Dialogue: 0,0:17:08.07,0:17:11.60,Default,,0000,0000,0000,,خذوا عنوان منزلي من كازوها واسبقوني إلى هناك
Dialogue: 0,0:17:11.91,0:17:14.52,Default,,0000,0000,0000,,هيجي! هل تميمة الحظّ معك؟
Dialogue: 0,0:17:15.53,0:17:18.19,Default,,0000,0000,0000,,أجل، إنّها معي، لا تقلقي
Dialogue: 0,0:17:18.91,0:17:20.02,Default,,0000,0000,0000,,أراكم لاحقاً
Dialogue: 0,0:17:23.61,0:17:25.32,Default,,0000,0000,0000,,أيّ تميمة حظّ؟
Dialogue: 0,0:17:25.32,0:17:30.87,Default,,0000,0000,0000,,تميمةٌ أعطيته إيّاها، لطالما حمت حياته
Dialogue: 0,0:17:31.82,0:17:33.36,Default,,0000,0000,0000,,مبالغة
Dialogue: 0,0:17:33.36,0:17:34.57,Default,,0000,0000,0000,,!إنّها الحقيقة
Dialogue: 0,0:17:34.57,0:17:39.59,Default,,0000,0000,0000,,،في المرّة الفائتة التي نسيها فيه\Nتأذّى بشدّة في مباراة كيندو
Dialogue: 0,0:17:40.32,0:17:44.20,Default,,0000,0000,0000,,إنّها تميمةٌ هامّة جدّاً لا يوجد منها\Nإلّا اثنتان في هذا العالم
Dialogue: 0,0:17:44.20,0:17:45.05,Default,,0000,0000,0000,,اثنتان؟
Dialogue: 0,0:17:45.05,0:17:50.70,Default,,0000,0000,0000,,ألم أخبركم قبل قليل عن قصّة الأصفاد\Nالتي ربطتني وهيجي في الماضي؟
Dialogue: 0,0:17:50.70,0:17:53.77,Default,,0000,0000,0000,,أضفت قطعةً منها في تميمة\Nهيجي سرّاً أيضاً
Dialogue: 0,0:17:54.24,0:17:55.73,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:17:58.61,0:18:01.66,Default,,0000,0000,0000,,رغم أنّ الأمر لا يخصّك
Dialogue: 0,0:18:01.66,0:18:03.69,Default,,0000,0000,0000,,صـ-صحيح
Dialogue: 0,0:18:04.03,0:18:07.36,Default,,0000,0000,0000,,ذلك جانباً، لا أرى ذاك الصبيّ
Dialogue: 0,0:18:07.36,0:18:08.46,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:18:08.46,0:18:10.13,Default,,0000,0000,0000,,لعلّه ذهب للحمّام
Dialogue: 0,0:18:10.83,0:18:13.71,Default,,0000,0000,0000,,لا نستطيع الذهاب بسيّارة شرطة إذاً
Dialogue: 0,0:18:17.32,0:18:18.74,Default,,0000,0000,0000,,آسفٌ يا ساكاتا-هان
Dialogue: 0,0:18:18.74,0:18:22.07,Default,,0000,0000,0000,,كان عليك كتابة تقرير عن أضرار\Nتحطّم السيّارة، أليس كذلك؟
Dialogue: 0,0:18:22.07,0:18:23.75,Default,,0000,0000,0000,,ليست مشكلة، فأنا معتاد
Dialogue: 0,0:18:24.45,0:18:26.36,Default,,0000,0000,0000,,ذلك جانباً، لمَ معدتك هكذا؟
Dialogue: 0,0:18:26.36,0:18:27.47,Default,,0000,0000,0000,,هذا؟
Dialogue: 0,0:18:30.95,0:18:33.39,Default,,0000,0000,0000,,سيفيدنا هذا الصبيّ
Dialogue: 0,0:18:35.36,0:18:37.56,Default,,0000,0000,0000,,لكن ألن يكون موري-هان قلقاً؟
Dialogue: 0,0:18:37.99,0:18:39.98,Default,,0000,0000,0000,,ليست مشكلة، سأتّصل به لاحقاً
Dialogue: 0,0:18:40.61,0:18:44.28,Default,,0000,0000,0000,,بالمناسبة، وجدنا عنوان ورقم هاتف\Nالمرأة المشبوهة التي رأيتَها
Dialogue: 0,0:18:44.28,0:18:47.95,Default,,0000,0000,0000,,عبر رقم لوحة سيّارتها
Dialogue: 0,0:18:48.61,0:18:51.66,Default,,0000,0000,0000,,اسمها أوكازاكي سومي، 39 عاماً
Dialogue: 0,0:18:52.24,0:18:57.16,Default,,0000,0000,0000,,تطلّقت العام الفائت، وتعيش في مجمع\Nشقق الجانب الغربيّ بالقرب من هنا
Dialogue: 0,0:18:57.57,0:18:59.33,Default,,0000,0000,0000,,أتريد المرور بها أوّلاً؟
Dialogue: 0,0:18:59.74,0:19:03.29,Default,,0000,0000,0000,,حسناً، بدا أنّها تعرف شيئاً
Dialogue: 0,0:19:04.11,0:19:07.26,Default,,0000,0000,0000,,سأجرّب الاتّصال بها لرؤية\Nما إن كانت في المنزل
Dialogue: 0,0:19:07.97,0:19:12.35,CharCard,,0000,0080,0011,,{\fad(200,200)}مجمع شقق الجانب الغربيّ
Dialogue: 0,0:19:08.17,0:19:13.55,On Top,,0000,0000,0000,,،في الواحدة من ظهر اليوم\Nسقطت جثّة بجوار جسر شينساي
Dialogue: 0,0:19:13.55,0:19:19.67,On Top,,0000,0000,0000,,تم التعرّف على هويّة المتوفّى، وتبيّن أنّه\Nنوياسو كازوتو-سان، 41 عاماً
Dialogue: 0,0:19:19.67,0:19:20.04,On Top,,0000,0000,0000,,...إضافةً لذلك
Dialogue: 0,0:19:20.51,0:19:23.06,Default,,0000,0000,0000,,...سامحني... سامحني
Dialogue: 0,0:19:30.05,0:19:30.88,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:19:30.88,0:19:33.42,Default,,0000,0000,0000,,أهذا منزل أوكازاكي-سان؟
Dialogue: 0,0:19:33.42,0:19:37.51,Default,,0000,0000,0000,,،أنا ساكاتا، من شرطة محافظة أوساكا\Nمركز توجيري
Dialogue: 0,0:19:37.84,0:19:43.48,Default,,0000,0000,0000,,حـ-حضرة الضابط! تعال إلى هنا سريعاً \N!واحمني! سوف أُقتل
Dialogue: 0,0:19:44.01,0:19:47.63,Default,,0000,0000,0000,,،سأكشف لكم كلّ ما حدث بالماضي\N!لذا أسرعوا إلى هنا! بسرعة
Dialogue: 0,0:19:47.63,0:19:50.26,Default,,0000,0000,0000,,اهدئي بأيّ حال، سنأتي فوراً
Dialogue: 0,0:19:50.26,0:19:53.36,Default,,0000,0000,0000,,!أقفلي أبوابك، ولا تسمحي لأحد بالدخول
Dialogue: 0,0:19:54.30,0:19:57.91,Default,,0000,0000,0000,,!كلا! تجاوزنا مجمع الشقق الغربيّ
Dialogue: 0,0:19:58.46,0:20:01.55,Default,,0000,0000,0000,,،ماذا نفعل؟! اليوم موعد تسليم أجور\Nفشارع ميدوسوجي مزدحم
Dialogue: 0,0:20:01.55,0:20:03.00,Default,,0000,0000,0000,,سنحتاج وقتاً طويلاً للاستدارة
Dialogue: 0,0:20:03.55,0:20:05.71,Default,,0000,0000,0000,,!سيكون الركض أسرع! توقّف قليلاً
Dialogue: 0,0:20:05.71,0:20:06.67,Default,,0000,0000,0000,,!هـ-هيجي-كن؟
Dialogue: 0,0:20:09.13,0:20:10.14,Default,,0000,0000,0000,,!انتبه
Dialogue: 0,0:20:10.14,0:20:10.88,Default,,0000,0000,0000,,!آسف
Dialogue: 0,0:20:11.88,0:20:12.96,Default,,0000,0000,0000,,!حاذر
Dialogue: 0,0:20:17.65,0:20:22.17,CharCard,,0000,0000,0004,,{\fad(200,0)}مجمع شقق الجانب الغربيّ
Dialogue: 0,0:20:25.62,0:20:30.69,Default,,0000,0000,0000,,أنت! يا سيّدة! نحن مع الشرطّي الذي\N!اتّصلتِ به قبل قليل، افتحي الباب
Dialogue: 0,0:20:35.75,0:20:37.73,Default,,0000,0000,0000,,غير مقفل
Dialogue: 0,0:20:41.62,0:20:43.43,Default,,0000,0000,0000,,أنت، يا سيّدة؟
Dialogue: 0,0:20:45.62,0:20:46.52,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:20:50.33,0:20:52.66,Default,,0000,0000,0000,,يا سيّدة! أين أنت؟
Dialogue: 0,0:21:00.83,0:21:02.75,Default,,0000,0000,0000,,أجل، معك ساكاتا
Dialogue: 0,0:21:03.04,0:21:05.54,Default,,0000,0000,0000,,!ماذا؟ أوكازاكي-سان ليست في البيت؟
Dialogue: 0,0:21:05.54,0:21:07.72,Default,,0000,0000,0000,,أجل، إنّه فارغ
Dialogue: 0,0:21:08.04,0:21:10.68,Default,,0000,0000,0000,,!هذه حماقة! أخبرتها ألّا تغادر
Dialogue: 0,0:21:10.96,0:21:14.02,Default,,0000,0000,0000,,هل وردك اتّصال منها؟
Dialogue: 0,0:21:14.41,0:21:18.19,Default,,0000,0000,0000,,بالطبع لا، فلم أعطها رقمي
Dialogue: 0,0:21:18.50,0:21:20.15,Default,,0000,0000,0000,,ذلك صحيح
Dialogue: 0,0:21:20.65,0:21:23.61,Default,,0000,0000,0000,,.أيّاً يكن، تعال هنا بسرعة\Nهناك أمرٌ غريب
Dialogue: 0,0:21:23.91,0:21:28.57,Default,,0000,0000,0000,,،خرجت من ميدوسوجي للتوّ\Nسأصلكم في 3 إلى 4 دقائق
Dialogue: 0,0:21:31.50,0:21:32.37,Default,,0000,0000,0000,,!إنّه من الأسفل
Dialogue: 0,0:21:34.91,0:21:36.25,Default,,0000,0000,0000,,الحمّام العمومي؟
Dialogue: 0,0:21:36.25,0:21:37.71,Default,,0000,0000,0000,,...أ-أيمكن
Dialogue: 0,0:21:55.54,0:21:57.68,Default,,0000,0000,0000,,فات الأوان، إنّها ميتة
Dialogue: 0,0:21:58.21,0:22:01.65,Default,,0000,0000,0000,,لكن لمَ. لمَ غادرت المنزل؟
Dialogue: 0,0:22:02.05,0:22:05.48,Default,,0000,0000,0000,,...وطُعنت بسكّين في صدرها عبر محفظتها
Dialogue: 0,0:22:07.30,0:22:10.07,Default,,0000,0000,0000,,من فعل هذا؟ ولمَ؟
Dialogue: 0,0:22:16.20,0:22:19.93,Default,,0000,0000,0000,,الضحيّة هي أوكازاكي سومي-سان، 39 عاماً
Dialogue: 0,0:22:20.91,0:22:24.11,Default,,0000,0000,0000,,سبب الموت كان الخنق بحبلٍ ما
Dialogue: 0,0:22:24.11,0:22:28.66,Default,,0000,0000,0000,,يبدو أنّها طُعنت بالسكّين بعدما خُنقت
Dialogue: 0,0:22:28.66,0:22:30.21,Default,,0000,0000,0000,,متى وجدت الجثّة؟
Dialogue: 0,0:22:30.53,0:22:33.70,Default,,0000,0000,0000,,قبل 3 إلى 4 دقائق قبيل قدومك
Dialogue: 0,0:22:33.70,0:22:36.78,Default,,0000,0000,0000,,وجدها منظّف دورة المياه هذا
Dialogue: 0,0:22:36.78,0:22:42.01,Default,,0000,0000,0000,,لكن لمَ يطعن القاتل المحفظة كلّ مرّة؟
Dialogue: 0,0:22:42.47,0:22:47.48,Default,,0000,0000,0000,,،أخبرتَ هذه السيّدة بألّا تخرج\Nلكن يبدو أنّها ماتت هنا
Dialogue: 0,0:22:48.70,0:22:53.20,Default,,0000,0000,0000,,،تعالي إلى جسر شينساي الآن\Nستلتقين صديقاً قديماً
Dialogue: 0,0:22:54.70,0:22:57.49,Default,,0000,0000,0000,,الواحدة وثمان دقائق مساءً
Dialogue: 0,0:22:59.28,0:23:03.41,Default,,0000,0000,0000,,رأيتِ؟ أنتِ التالية التي\Nستلقى هذا المصير
Dialogue: 0,0:23:04.53,0:23:07.37,Default,,0000,0000,0000,,الواحدة وعشر دقائق مساءً
Dialogue: 0,0:23:07.70,0:23:11.29,Default,,0000,0000,0000,,لا شكّ أنّ هذه رسائل من القاتل
Dialogue: 0,0:23:11.57,0:23:15.57,Default,,0000,0000,0000,,مما يعني أنّ تلك السيّدة\Nسمعت الرسالة الأولى
Dialogue: 0,0:23:15.57,0:23:17.17,Default,,0000,0000,0000,,وذهبت لجسر شينساي
Dialogue: 0,0:23:17.76,0:23:20.82,Default,,0000,0000,0000,,ثمّ عندما رجعت، سمعت الرسالة الثانية
Dialogue: 0,0:23:20.82,0:23:23.41,Default,,0000,0000,0000,,وبقيت مرتعدةً في شقّتها
Dialogue: 0,0:23:25.66,0:23:28.73,Default,,0000,0000,0000,,لكن ما قصده بالصديق القديم؟
Dialogue: 0,0:23:29.32,0:23:32.12,Default,,0000,0000,0000,,لعلّه يشير للأشخاص الذين\Nقتلهم حتّى الآن
Dialogue: 0,0:23:32.78,0:23:35.98,Default,,0000,0000,0000,,محقّق ساكاتا، هنالك اتّصال من مقرّ القيادة
Dialogue: 0,0:23:35.98,0:23:36.65,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:23:36.91,0:23:40.62,Default,,0000,0000,0000,,هاتّوري، رسائل آلة الردّ هذه غريبة
Dialogue: 0,0:23:41.20,0:23:42.53,Default,,0000,0000,0000,,كيف ذلك؟
Dialogue: 0,0:23:42.53,0:23:44.83,Default,,0000,0000,0000,,وقت ومحتوى الرسائل
Dialogue: 0,0:23:45.41,0:23:49.99,Default,,0000,0000,0000,,تفصل دقيقتان فحسب بين\Nرسالة "تعالي" الأولى
Dialogue: 0,0:23:49.99,0:23:52.46,Default,,0000,0000,0000,,ورسالة "رأيتِ" الثانية
Dialogue: 0,0:23:52.82,0:23:56.67,Default,,0000,0000,0000,,أيعني هذا أنّ القاتل كان يراقبها؟
Dialogue: 0,0:23:57.10,0:24:00.54,Default,,0000,0000,0000,,هنالك أمرٌ غريب في سلسلة\Nجرائم القتل الأربع هذه
Dialogue: 0,0:24:01.31,0:24:05.00,Default,,0000,0000,0000,,يراودني شعورٌ سيّئ بتلاعب القاتل بنا
Dialogue: 0,0:24:05.89,0:24:07.15,Default,,0000,0000,0000,,شعور سيّئ؟
Dialogue: 0,0:24:12.51,0:24:13.84,Default,,0000,0000,0000,,!كودو
Dialogue: 0,0:24:15.43,0:24:16.85,Default,,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:24:16.85,0:24:19.14,Default,,0000,0000,0000,,!لا-لا شيء! لا تهتم
Dialogue: 0,0:24:19.68,0:24:23.56,Default,,0000,0000,0000,,كلا، تذكّرت ذاك الحلم المشؤوم
Dialogue: 0,0:24:29.93,0:24:32.28,Default,,0000,0000,0000,,إذاً هيجي-كن، أين نذهب تالياً؟
Dialogue: 0,0:24:32.76,0:24:35.24,Default,,0000,0000,0000,,هل نتوجّه لمكتب غوشي-سان؟
Dialogue: 0,0:24:37.39,0:24:38.45,Default,,0000,0000,0000,,هيجي-كن؟
Dialogue: 0,0:24:39.76,0:24:41.16,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:24:41.76,0:24:44.47,Default,,0000,0000,0000,,لكن هذه قضايا غريبة بحقّ
Dialogue: 0,0:24:44.47,0:24:48.22,Default,,0000,0000,0000,,لا شهود عيان، ولا نعرف العلاقة بينها
Dialogue: 0,0:24:48.22,0:24:50.38,Default,,0000,0000,0000,,مع ذلك نستطيع اكتشاف\Nهويّات الضحايا فوراً
Dialogue: 0,0:24:50.68,0:24:52.43,Default,,0000,0000,0000,,معك حقّ
Dialogue: 0,0:24:52.43,0:24:57.72,Default,,0000,0000,0000,,أُذيع اسم أوّل ضحيّتين في الأنباء\Nفور اكتشاف الجثّتين
Dialogue: 0,0:24:58.14,0:25:00.26,Default,,0000,0000,0000,,ذلك طبيعيّ
Dialogue: 0,0:25:00.26,0:25:04.64,Default,,0000,0000,0000,,فقد كانت رخص قيادتهم موجودة\Nفي المحافظ المطعونة بالسكّين
Dialogue: 0,0:25:05.01,0:25:07.44,Default,,0000,0000,0000,,!رخص قيادتهم؟ هذه هي
Dialogue: 0,0:25:07.81,0:25:10.50,CharCard,,0000,0000,0004,,{\fad(300,0)}ساحة اختبار كادوما لرخص القيادة
Dialogue: 0,0:25:10.77,0:25:13.32,Default,,0000,0000,0000,,لم تكن هنالك حوادث أو مخالفات\Nفي سجّلات الأربعة المرورية إذاً؟
Dialogue: 0,0:25:13.32,0:25:13.96,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:25:14.24,0:25:18.92,Default,,0000,0000,0000,,،ظننتُ أنّنا قد نجد صلة بالسيّارات\Nلكن يبدو أنّ تخميني لم يصب
Dialogue: 0,0:25:19.36,0:25:23.88,Default,,0000,0000,0000,,إضافةً لذلك، أمكنة وتواريخ إصدار\Nرخص قيادة الأربعة مختلفة
Dialogue: 0,0:25:25.16,0:25:30.53,Default,,0000,0000,0000,,اسمع، مكتوبٌ أنّ أوكازاكي-سان وحدها تعلّمت\Nالقيادة في هيوغو وليس أوساكا
Dialogue: 0,0:25:30.53,0:25:31.31,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:25:31.91,0:25:33.53,Default,,0000,0000,0000,,لمَ فعلت هناك؟
Dialogue: 0,0:25:35.68,0:25:38.52,Default,,0000,0000,0000,,ذاك المكان مشهور بأجور مخيّم تمرين\Nالرخصة منخفضة الأجر
Dialogue: 0,0:25:38.99,0:25:41.53,Default,,0000,0000,0000,,...مخيّم تمرين؟! أيمكن
Dialogue: 0,0:25:42.32,0:25:44.36,Default,,0000,0000,0000,,ستلتقين صديقاً قديماً
Dialogue: 0,0:25:45.03,0:25:46.53,Default,,0000,0000,0000,,إنّهما صديقان
Dialogue: 0,0:25:47.57,0:25:50.33,Default,,0000,0000,0000,,أتعرف رقم هاتف ذاك المكان يا سيّد؟
Dialogue: 0,0:25:50.64,0:25:51.87,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:25:53.78,0:25:58.38,Default,,0000,0000,0000,,تشاركت أوكازاكي سومي ونيشيغوتشي تايو\Nغرفةً أثناء المخيم؟
Dialogue: 0,0:25:58.78,0:26:00.11,Default,,0000,0000,0000,,حـ-حقّاً؟
Dialogue: 0,0:26:00.11,0:26:04.20,Default,,0000,0000,0000,,!حسناً! بدأنا نجد روابط بين الضحايا الأربعة
Dialogue: 0,0:26:04.20,0:26:07.32,Default,,0000,0000,0000,,لكن... أليس هذا غريباً؟
Dialogue: 0,0:26:07.32,0:26:10.91,Default,,0000,0000,0000,,حصلت أوكازاكي-سان على رخصتها\N،في ذاك العام
Dialogue: 0,0:26:10.91,0:26:14.77,Default,,0000,0000,0000,,لكن حاول نيشيغوتشي-سان الحصول\Nعلى رخصته مجدداً بعد ثلاثة أعوام
Dialogue: 0,0:26:15.32,0:26:19.06,Default,,0000,0000,0000,,لعلّه كان فاشلاً في القيادة، ولم يتخرّج ذاك العام؟
Dialogue: 0,0:26:20.91,0:26:22.06,Default,,0000,0000,0000,,!لا-لا يمكن
Dialogue: 0,0:26:22.91,0:26:24.78,Default,,0000,0000,0000,,!أأنت متأكّد؟
Dialogue: 0,0:26:25.20,0:26:26.74,Default,,0000,0000,0000,,ماذا؟ ما الأمر؟
Dialogue: 0,0:26:27.36,0:26:32.66,Default,,0000,0000,0000,,كان هنالك آخرون بالإضافة لـ أوكازاكي-سان\Nونيشيغوتشي-سان في ذاك المخيم قبل 20 عاماً
Dialogue: 0,0:26:33.14,0:26:36.53,Default,,0000,0000,0000,,الضحيّة الأولى ناغاو هيديتوشي-سان
Dialogue: 0,0:26:36.53,0:26:39.57,Default,,0000,0000,0000,,والضحيّة الثالثة نوياسو كازوتو-سان
Dialogue: 0,0:26:40.11,0:26:43.78,Default,,0000,0000,0000,,!كما عضو مجلس النوّاب غوشي-سان، هؤلاء الثلاثة
Dialogue: 0,0:26:45.61,0:26:47.89,Default,,0000,0000,0000,,!ارتادوا جميعاً المكان نفسه
Dialogue: 0,0:26:48.99,0:26:50.05,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:26:50.41,0:26:52.47,Default,,0000,0000,0000,,ليس هذا كلّ شيء
Dialogue: 0,0:26:53.11,0:26:57.44,Default,,0000,0000,0000,,كان هنالك رجلٌ معروف الاسم\Nفي ذاك المخيّم أيضاً
Dialogue: 0,0:26:57.86,0:27:00.40,Default,,0000,0000,0000,,معروف؟ من هو؟
Dialogue: 0,0:27:01.91,0:27:05.36,Default,,0000,0000,0000,,نو-نومابوتشي، نومابوتشي كيتشيرو
Dialogue: 0,0:27:05.66,0:27:08.20,Default,,0000,0000,0000,,...نومابوتشي كيتشيرو؟ أيمكن
Dialogue: 0,0:27:09.20,0:27:11.03,Default,,0000,0000,0000,,...المجرم الهارب حالياً
Dialogue: 0,0:27:11.77,0:27:14.25,Default,,0000,0000,0000,,مرتكب السطو والقتل؟
Dialogue: 0,0:27:15.28,0:27:17.18,Default,,0000,0000,0000,,ها هي، مدرسة المخيّم
Dialogue: 0,0:27:20.78,0:27:23.75,Default,,0000,0000,0000,,لا شكّ في الأمر، إنّه نومابوتشي
Dialogue: 0,0:27:24.11,0:27:27.20,Default,,0000,0000,0000,,أوجه وأسماء الخمسة الآخرين متطابقة أيضاً
Dialogue: 0,0:27:27.20,0:27:28.76,Default,,0000,0000,0000,,لكن هذا غريب
Dialogue: 0,0:27:28.76,0:27:33.18,On Top,,0000,0000,0000,,خرّيجو 23 أغسطس، 1978
Dialogue: 0,0:27:29.32,0:27:33.18,Default,,0000,0000,0000,,أترى؟ مكتوبٌ أنّهم تخرّجوا بعد المخيّم
Dialogue: 0,0:27:33.53,0:27:36.91,Default,,0000,0000,0000,,لكن كانت أوكازاكي-سان وحدها\Nمن حصلت على الرخصة
Dialogue: 0,0:27:36.91,0:27:42.65,Default,,0000,0000,0000,,حصل أمرٌ ما في ذاك المخيّم\Nقبل 20 عاماً، أمرٌ ما
Dialogue: 0,0:27:42.98,0:27:44.70,Default,,0000,0000,0000,,هكذا إذاً، شكراً
Dialogue: 0,0:27:45.99,0:27:50.11,Default,,0000,0000,0000,,لا يعرف أحد العاملين الحاليين شيئاً\Nعمَ حصل قبل 20 عاماً
Dialogue: 0,0:27:50.99,0:27:52.83,Default,,0000,0000,0000,,لا عجب
Dialogue: 0,0:27:53.90,0:27:56.12,On Top,,0000,0000,0000,,لكن لا بدّ من وجود حادثة
Dialogue: 0,0:27:54.02,0:27:56.99,CharCard,,0000,0000,0004,,{\fad(100,0)}مكتبة ناكانوشيما الإقليمية
Dialogue: 0,0:27:57.23,0:28:02.53,Default,,0000,0000,0000,,وقعت في ساحة التمرين تلك\Nقبل 20 عاماً
Dialogue: 0,0:28:04.65,0:28:07.25,Default,,0000,0000,0000,,!ها هي! هذه
Dialogue: 0,0:28:07.43,0:28:14.17,On Top,,0000,0000,0000,,موت معلّم قيادة في حادث\Nاشتباه بقيادته ثملاً
Dialogue: 0,0:28:08.06,0:28:10.48,Default,,0000,0000,0000,,،في يوم تخرّج أولئك الستّة قبل 20 عاماً
Dialogue: 0,0:28:10.48,0:28:14.17,Default,,0000,0000,0000,,كان أحد المعلّمين يقود ثملاً، ولقي حتفه
Dialogue: 0,0:28:14.56,0:28:18.68,Default,,0000,0000,0000,,اسمه إينابا تيتسوجي، أكثر المعلّمين صرامة في المدرسة
Dialogue: 0,0:28:19.02,0:28:21.40,Default,,0000,0000,0000,,اسمع، ما رأيك بهذا؟
Dialogue: 0,0:28:21.40,0:28:26.56,Default,,0000,0000,0000,,قرّر نومابوتشي الواقع في مشكلة ماليّة\Nبعدما نفدّت مدّخرات هروبه
Dialogue: 0,0:28:26.56,0:28:30.98,Default,,0000,0000,0000,,ابتزاز عضو مجلس النوّاب غوشي بالحادثة القديمة \Nللحصول على المال، لكنّه قُوبل بالرفض
Dialogue: 0,0:28:30.98,0:28:34.48,Default,,0000,0000,0000,,فقتل رفاقه القدامى ذوي الصلة\Nبالحادثة واحداً تلو الآخر
Dialogue: 0,0:28:34.48,0:28:36.15,Default,,0000,0000,0000,,وكرّر تهديده
Dialogue: 0,0:28:36.65,0:28:39.73,Default,,0000,0000,0000,,أو ربما استعمل غوشي نومابوتشي لقتل الجميع
Dialogue: 0,0:28:39.73,0:28:45.12,Default,,0000,0000,0000,,كيلا تعكّر الضحيّة القدمة حملة ترشّحه للبرلمان
Dialogue: 0,0:28:45.56,0:28:48.23,Default,,0000,0000,0000,,كلاهما أمران محتملان
Dialogue: 0,0:28:48.23,0:28:52.65,Default,,0000,0000,0000,,عندما توقّف ناغاو-سان ونوياسو-سان عن عمليهما\N،كمساعد وسائق شخصيّ له
Dialogue: 0,0:28:52.65,0:28:55.30,Default,,0000,0000,0000,,تلقّيا أجر إنهاء خدمة مُجزٍ وفقما يبدو
Dialogue: 0,0:28:55.90,0:29:01.93,Default,,0000,0000,0000,,عندما نذكر حادثة معلّمه قبل 20 عاماً\N،وأسماء رفاقه في المخيّم
Dialogue: 0,0:29:01.93,0:29:05.14,Default,,0000,0000,0000,,فلا بدّ أن حتّى كاره الشرطة ذاك سيفتح فمه
Dialogue: 0,0:29:05.45,0:29:06.74,Default,,0000,0000,0000,,هيّا، لنذهب
Dialogue: 0,0:29:12.31,0:29:15.81,Default,,0000,0000,0000,,كونان-كن! ما الذي تفعله في مكانٍ كهذا؟
Dialogue: 0,0:29:15.81,0:29:17.03,Default,,0000,0000,0000,,!اختفيتَ فجأةً
Dialogue: 0,0:29:17.27,0:29:19.40,Default,,0000,0000,0000,,!تبّاً! نسيت الاتّصال
Dialogue: 0,0:29:19.73,0:29:22.32,Default,,0000,0000,0000,,مرحباً يا هي-تشان، مضى وقتٌ طويل
Dialogue: 0,0:29:22.90,0:29:26.33,Default,,0000,0000,0000,,أوتاكي-هان من مقرّ القيادة أيضاً؟\Nلمَ أنت هنا؟
Dialogue: 0,0:29:26.69,0:29:29.73,On Top,,0000,0000,0000,,طلبت منّي كازوها-تشان أن أكون السائق
Dialogue: 0,0:29:26.69,0:29:30.33,CharCard,,0000,0000,0004,,{\fad(250,200)}المفتّش أوتاكي\Nمقرّ قيادة شرطة محافظة أوساكا
Dialogue: 0,0:29:29.73,0:29:33.79,On Top,,0000,0000,0000,,اتّصل بنا ساكاتا-سان، وأتينا لأخذ الصبيّ ذو النظّارات
Dialogue: 0,0:29:34.02,0:29:36.40,Default,,0000,0000,0000,,بأيّ حاجة؟
Dialogue: 0,0:29:36.40,0:29:39.73,Default,,0000,0000,0000,,تتأمّرين رجال الشرطة كما تشائين
Dialogue: 0,0:29:39.73,0:29:43.73,Default,,0000,0000,0000,,استعملتَ سيّارة شرطة لأخذ جولة\N!في أوساكا، فلا يحقّ لك الكلام
Dialogue: 0,0:29:43.73,0:29:44.64,Default,,0000,0000,0000,,هوّنا عليكما
Dialogue: 0,0:29:45.06,0:29:48.56,Default,,0000,0000,0000,,سأقلّ هذا الطفل إلى منزل الرئيس إذا أردتم
Dialogue: 0,0:29:49.19,0:29:50.27,Default,,0000,0000,0000,,هل نذهب يا ولد؟
Dialogue: 0,0:29:50.27,0:29:53.40,Default,,0000,0000,0000,,!كلا! أريد البقاء مع هيجي-نيتشان
Dialogue: 0,0:29:53.40,0:29:54.89,Default,,0000,0000,0000,,انتظر قليلاً يا أوتاكي-هان
Dialogue: 0,0:29:57.65,0:30:03.65,Default,,0000,0000,0000,,هذه أوساكا، دع القضيّة لنا وانسحب يا كودو
Dialogue: 0,0:30:04.69,0:30:09.20,Default,,0000,0000,0000,,لكن بمعرفتي بك، ستجد طريقةً لإقحام أنفك بالتأكيد
Dialogue: 0,0:30:10.94,0:30:14.74,Default,,0000,0000,0000,,ليس بيدي حيلة، سأتركك تحتفظ بهذه
Dialogue: 0,0:30:14.74,0:30:15.86,Default,,0000,0000,0000,,التميمة؟
Dialogue: 0,0:30:15.86,0:30:19.40,Default,,0000,0000,0000,,في المقابل، اضبط نفسك قدر المستطاع اليوم
Dialogue: 0,0:30:19.40,0:30:23.11,Default,,0000,0000,0000,,عندما أرجع للبيت، سأحكي لك كلّ تفاصيل القضيّة
Dialogue: 0,0:30:23.11,0:30:23.84,Default,,0000,0000,0000,,اتّفقنا؟
Dialogue: 0,0:30:26.56,0:30:28.44,Default,,0000,0000,0000,,كونان-كن، اصعد بسرعة
Dialogue: 0,0:30:30.85,0:30:35.44,Default,,0000,0000,0000,,لا تقلق، لن أدعه يعبث بأوساكا\Nأكثر مما فعل
Dialogue: 0,0:30:35.44,0:30:36.81,Default,,0000,0000,0000,,أراهن بحياتي على هذا
Dialogue: 0,0:30:37.86,0:30:39.40,Default,,0000,0000,0000,,!أراكم لاحقاً
Dialogue: 0,0:30:41.02,0:30:42.81,Default,,0000,0000,0000,,من كان يكلّمه؟
Dialogue: 0,0:30:46.32,0:30:48.78,Default,,0000,0000,0000,,أشعر بالجوع
Dialogue: 0,0:30:48.78,0:30:53.29,Default,,0000,0000,0000,,سنصل لمنزل الرئيس في نيياغاوا\Nفي غضون نصف ساعة
Dialogue: 0,0:30:53.61,0:30:57.77,Default,,0000,0000,0000,,قالت أمّ هيجي أنّها ستعدّ حساء\Nالسمكة المنتفخة للعشاء
Dialogue: 0,0:30:57.77,0:30:58.75,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:30:58.98,0:31:01.44,Default,,0000,0000,0000,,أتطلّع لذلك
Dialogue: 0,0:31:03.36,0:31:05.31,Default,,0000,0000,0000,,أجل، معك أوتاكي
Dialogue: 0,0:31:05.31,0:31:06.31,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:31:06.31,0:31:08.76,Default,,0000,0000,0000,,وجدتم سيّارة نومابوتشي الهارب
Dialogue: 0,0:31:08.76,0:31:10.27,Default,,0000,0000,0000,,!في جبال مينو؟
Dialogue: 0,0:31:10.27,0:31:12.31,Default,,0000,0000,0000,,!حسناً، سآتي فوراً
Dialogue: 0,0:31:12.72,0:31:18.27,Default,,0000,0000,0000,,موري-هان، أنا آسف، لكن عليك تأجيل\Nحساء السمكة المنتفخة قليلاً
Dialogue: 0,0:31:18.57,0:31:20.40,Default,,0000,0000,0000,,!سآخذ منعطفاً
Dialogue: 0,0:31:25.77,0:31:30.28,CharCard,,0040,0000,0000,,{\fad(200,0)}شلّال مينو
Dialogue: 0,0:31:36.01,0:31:40.01,Default,,0000,0000,0000,,آسف، سأجعل ضابطاً يافعاً يقلّكم في لحظات
Dialogue: 0,0:31:40.01,0:31:40.91,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:31:41.18,0:31:45.10,Default,,0000,0000,0000,,أليس نومابوتشي هو القاتل \Nالذي هرب ومعه مسدّس؟
Dialogue: 0,0:31:45.10,0:31:48.88,Default,,0000,0000,0000,,...أصبح الوضع سيّئاً، أليس كذلك يا كونان
Dialogue: 0,0:31:49.60,0:31:51.00,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:31:53.26,0:31:54.58,Default,,0000,0000,0000,,كيف الأمر؟
Dialogue: 0,0:31:54.58,0:31:55.68,Default,,0000,0000,0000,,مفتّش أوتاكي
Dialogue: 0,0:31:55.68,0:32:00.18,Default,,0000,0000,0000,,،وجدنا السيّارة والحشائش تغطّيها\Nلكن لم نجد نومابوتشي بعد
Dialogue: 0,0:32:01.31,0:32:03.26,Default,,0000,0000,0000,,وذاك الكوخ؟
Dialogue: 0,0:32:03.26,0:32:05.69,Default,,0000,0000,0000,,لم نجد فيه أحداً عندما تفقّدنا قبل قليل
Dialogue: 0,0:32:07.14,0:32:10.15,Default,,0000,0000,0000,,لعلّه ترك السيّارة وهرب إلى مكانٍ آخر
Dialogue: 0,0:32:10.15,0:32:12.07,Default,,0000,0000,0000,,إنّه موجود في الداخل
Dialogue: 0,0:32:12.21,0:32:14.78,Default,,0000,0000,0000,,!يا-يا فتى! متى وصلت هنا؟
Dialogue: 0,0:32:15.93,0:32:17.24,Default,,0000,0000,0000,,انظروا هنا
Dialogue: 0,0:32:17.97,0:32:22.76,Default,,0000,0000,0000,,وجدتُ هذه الآثار المحترقة مدفونةً\Nتحت العشب في هذه الحاوية
Dialogue: 0,0:32:23.58,0:32:27.85,Default,,0000,0000,0000,,أترون؟ إنّها إيصالات متجر تموينات\Nترجع لقبل خمسة وثلاثة أيام
Dialogue: 0,0:32:27.85,0:32:31.55,Default,,0000,0000,0000,,كما ملصقات ختم علب غداء من متاجر\Nتموينات تاريخ انتهائها اليوم
Dialogue: 0,0:32:32.06,0:32:34.72,Default,,0000,0000,0000,,لا يأكل الكثيرون علب غداء المتاجر
Dialogue: 0,0:32:34.72,0:32:36.51,Default,,0000,0000,0000,,في مكانٍ كهذا يومياً، أليس كذلك؟
Dialogue: 0,0:32:36.93,0:32:41.47,Default,,0000,0000,0000,,لكن يا فتى، إذا ظهر رجل مطلوبٌ\N...للعدالة في متجر تموينات
Dialogue: 0,0:32:41.81,0:32:43.93,Default,,0000,0000,0000,,من اشتراها كان شخصاً آخراً على الأرجح
Dialogue: 0,0:32:44.60,0:32:46.77,Default,,0000,0000,0000,,أحدهم يؤيه
Dialogue: 0,0:32:47.39,0:32:48.89,Default,,0000,0000,0000,,لسببٍ ما
Dialogue: 0,0:33:14.96,0:33:17.57,Default,,0000,0000,0000,,إذاً، أوجدت نومابوتشي؟
Dialogue: 0,0:33:18.30,0:33:19.51,Default,,0000,0000,0000,,كيف الأمر؟
Dialogue: 0,0:33:19.51,0:33:23.87,Default,,0000,0000,0000,,...كلا، هنالك آثار لعيش أحدٍ هنا قبل فترة، لكن
Dialogue: 0,0:33:28.76,0:33:31.00,Default,,0000,0000,0000,,هنالك وحلٌ على عتبة النافذة
Dialogue: 0,0:33:31.71,0:33:34.72,Default,,0000,0000,0000,,لا خيوط عناكب على العامود والعارضة هناك
Dialogue: 0,0:33:36.09,0:33:39.43,Default,,0000,0000,0000,,...فهمت، وقف على عتبة النافذة
Dialogue: 0,0:33:44.59,0:33:46.56,Default,,0000,0000,0000,,!أ-أنت، يا فتى
Dialogue: 0,0:33:53.76,0:33:57.19,Default,,0000,0000,0000,,ماذا؟ يبدو أنه يمكنك الذهاب\Nللعليّة من هنا
Dialogue: 0,0:33:57.42,0:34:00.65,Default,,0000,0000,0000,,!انتظر يا فتى! دع الباقي لنا
Dialogue: 0,0:34:07.09,0:34:08.87,Default,,0000,0000,0000,,!نومابوتشي
Dialogue: 0,0:34:09.38,0:34:12.84,Default,,0000,0000,0000,,نومابوتشي كيتشيرو! أنت تحت الاعتقال\N!لجريمة السطو والقتل
Dialogue: 0,0:34:12.84,0:34:14.25,Default,,0000,0000,0000,,!الـ-الطعام
Dialogue: 0,0:34:15.46,0:34:17.87,Default,,0000,0000,0000,,!بسرعة، أعطوني طعاماً
Dialogue: 0,0:34:19.00,0:34:22.57,CharCard,,0000,0000,0004,,{\fad(115,110)}منزل غوشي سوتارو
Dialogue: 0,0:34:19.84,0:34:23.22,On Top,,0000,0000,0000,,ماذا؟ المُسنّ غوشي لم يخرج؟
Dialogue: 0,0:34:23.33,0:34:27.60,Default,,0000,0000,0000,,أجل، جعلنا ننتظره في هذه\Nالغرفة منذ المساء
Dialogue: 0,0:34:27.88,0:34:29.96,Default,,0000,0000,0000,,!سأذهب لمقابلته بنفسي
Dialogue: 0,0:34:29.96,0:34:35.06,Default,,0000,0000,0000,,مهلك، لنبق هادئين ونترك زميلي الخبير\Nيحفظ ماء وجهه
Dialogue: 0,0:34:35.42,0:34:39.52,On Top,,0000,0000,0000,,سينسي، لا يمكننا ترك رجال\Nالشرطة ينتظرون أكثر
Dialogue: 0,0:34:36.36,0:34:39.58,CharCard,,0000,0000,0004,,{\fad(115,0)}غوشي سوتارو\Nعضو في مجلس نوّاب المحافظة
Dialogue: 0,0:34:39.94,0:34:43.34,Default,,0000,0000,0000,,دعهم وشأنهم، سيستلمون\Nبنهاية المطاف ويرحلون
Dialogue: 0,0:34:43.94,0:34:49.18,Default,,0000,0000,0000,,هل أعلمهم باتّصال الشخص غريب الصوت\Nالذي وردنا قبل قليل على الأقل؟
Dialogue: 0,0:34:49.18,0:34:52.47,Default,,0000,0000,0000,,...كـ-كلا! لا يمكننا قطعاً
Dialogue: 0,0:34:53.44,0:34:58.77,Default,,0000,0000,0000,,لنعقد صفقةٌ حيال الحادثة قبل 20 عاماً\Nبعد ساعة من الآن
Dialogue: 0,0:34:58.77,0:35:02.48,Default,,0000,0000,0000,,افتح الباب الخلفيّ وانتظر\Nفي المستودع البعيد بمفردك
Dialogue: 0,0:35:04.44,0:35:06.57,Default,,0000,0000,0000,,لا يمكننا إخبارهم قطعاً
Dialogue: 0,0:35:07.69,0:35:12.07,Default,,0000,0000,0000,,يا إلهي، أخبرتك عن تتوقّف\Nعن التجوّل يا كونان-كن
Dialogue: 0,0:35:12.48,0:35:14.28,Default,,0000,0000,0000,,كلّ ما تفعله هو جعلي أقلق
Dialogue: 0,0:35:14.28,0:35:14.93,Default,,0000,0000,0000,,آسف
Dialogue: 0,0:35:14.93,0:35:17.22,Default,,0000,0000,0000,,هيّا، امش بسرعة
Dialogue: 0,0:35:22.38,0:35:23.25,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:35:26.19,0:35:27.71,Default,,0000,0000,0000,,أأنت بخير؟
Dialogue: 0,0:35:29.48,0:35:29.92,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:35:31.38,0:35:33.09,Default,,0000,0000,0000,,!ابتعدا
Dialogue: 0,0:35:43.23,0:35:44.19,Default,,0000,0000,0000,,!نومابوتشي
Dialogue: 0,0:35:50.31,0:35:51.36,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:35:52.56,0:35:55.00,Default,,0000,0000,0000,,!كونان-كن! تماسك
Dialogue: 0,0:35:55.00,0:35:56.04,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:36:02.90,0:36:04.46,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:36:05.73,0:36:07.69,Default,,0000,0000,0000,,ما الأمر يا هيجي-كن؟
Dialogue: 0,0:36:07.69,0:36:09.05,Default,,0000,0000,0000,,!لا شيء
Dialogue: 0,0:36:11.11,0:36:12.63,Default,,0000,0000,0000,,ماذا؟ أين ساكاتا-هان؟
Dialogue: 0,0:36:13.15,0:36:15.60,Default,,0000,0000,0000,,غادر قبل قليل إلى دورة المياه
Dialogue: 0,0:36:15.60,0:36:18.11,Default,,0000,0000,0000,,لعلّي سأذهب بدوري
Dialogue: 0,0:36:20.81,0:36:22.98,Default,,0000,0000,0000,,!كونان-كن! كونان-كن
Dialogue: 0,0:36:23.48,0:36:26.39,Default,,0000,0000,0000,,!ليقلّه أحدكم للمشفى بشكلٍ عاجل
Dialogue: 0,0:36:26.39,0:36:27.07,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:36:28.44,0:36:30.99,Default,,0000,0000,0000,,لا بأس، وخزتني فحسب
Dialogue: 0,0:36:31.23,0:36:33.78,Default,,0000,0000,0000,,...أنت تكذب! فالسكّين قد
Dialogue: 0,0:36:39.86,0:36:41.25,Default,,0000,0000,0000,,تميمة؟
Dialogue: 0,0:36:42.57,0:36:45.71,Default,,0000,0000,0000,,لا بدّ أنّه كان تأثير التميمة\Nالتي أعطاني إيّاها هيجي-نيتشان
Dialogue: 0,0:36:46.31,0:36:47.42,Default,,0000,0000,0000,,هيجي؟
Dialogue: 0,0:36:48.06,0:36:54.12,Default,,0000,0000,0000,,أترون؟ علقت مقدّمة السكين في حلقة\Nرابطة السلسلة، فلم تطعنّي
Dialogue: 0,0:36:56.23,0:36:57.89,Default,,0000,0000,0000,,لا تتهوّر مُجدداً
Dialogue: 0,0:36:58.26,0:36:59.89,Default,,0000,0000,0000,,!هيّا، انهض
Dialogue: 0,0:37:00.52,0:37:01.93,Default,,0000,0000,0000,,!لا تتباطأ
Dialogue: 0,0:37:03.15,0:37:06.40,Default,,0000,0000,0000,,لمَ على يده اليسرى صفدين؟
Dialogue: 0,0:37:06.69,0:37:12.61,Default,,0000,0000,0000,,هذا؟ لا أدري لمَ، لكنّه كان مقيّداً بعامود
Dialogue: 0,0:37:12.61,0:37:17.53,Default,,0000,0000,0000,,لم يكن أمامي خيار آخر، فقطعت تلك\Nالسلسلة وقيّدته بأصفادي
Dialogue: 0,0:37:18.48,0:37:19.99,Default,,0000,0000,0000,,كان مقيّداً؟
Dialogue: 0,0:37:20.52,0:37:26.56,Default,,0000,0000,0000,,يبدو أنّ أحدهم كان يجلب\Nله الطعام كما قلت
Dialogue: 0,0:37:27.61,0:37:28.45,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:37:29.31,0:37:31.17,Default,,0000,0000,0000,,أيمكن؟ أيمكن؟
Dialogue: 0,0:37:32.36,0:37:33.51,Default,,0000,0000,0000,,أيمكن؟
Dialogue: 0,0:37:36.61,0:37:37.94,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:37:54.36,0:37:57.30,Default,,0000,0000,0000,,انتظر قدرما تشاء، لن يأتي المُسنّ غوشي
Dialogue: 0,0:37:58.90,0:38:03.66,Default,,0000,0000,0000,,ساكاتا-هان، ألستَ المجرم وراء\Nسلسلة جرائم القتل؟
Dialogue: 0,0:38:05.44,0:38:07.92,Default,,0000,0000,0000,,!لا-لا تتفوّه بالهراء رجاءً
Dialogue: 0,0:38:08.73,0:38:12.88,Default,,0000,0000,0000,,لفتت انتباهي غرابة هذا المستودع\Nلا أكثر، فكنت أتأمّله
Dialogue: 0,0:38:14.40,0:38:16.84,Default,,0000,0000,0000,,بدايةً، الحادثة عندما سقطت\N...الجثّة على سيّارة الشرطة
Dialogue: 0,0:38:17.90,0:38:21.05,Default,,0000,0000,0000,,حيث أخذتنا لذاك المكان بدهاء
Dialogue: 0,0:38:21.56,0:38:26.39,Default,,0000,0000,0000,,قبل لحظات من مغادرتنا للمطعم، أجريتَ اتّصالاً
Dialogue: 0,0:38:26.39,0:38:28.48,Default,,0000,0000,0000,,...وفعّلت الآليّة التي ستجعل
Dialogue: 0,0:38:29.80,0:38:31.77,Default,,0000,0000,0000,,الجثّة تسقط تلقائياً
Dialogue: 0,0:38:33.44,0:38:38.99,Default,,0000,0000,0000,,بعدها، اتّصلتَ بأوكازاكي-سان عندما\Nكنتُ على السطح، واستدعيتَها هنا
Dialogue: 0,0:38:39.40,0:38:43.87,Default,,0000,0000,0000,,تركت رسالة تهديد على آلة ردّها \Nبينما تعلم أنّها ليست في المنزل
Dialogue: 0,0:38:44.40,0:38:48.16,Default,,0000,0000,0000,,وجعلتها تحتجز نفسها في شقّتها عند عودتها
Dialogue: 0,0:38:48.90,0:38:53.75,Default,,0000,0000,0000,,بعدما جعلتني أشاهدها في مسرح الحادثة\Nحيث تركت لديّ انطباعاً
Dialogue: 0,0:38:54.15,0:38:58.30,Default,,0000,0000,0000,,ذكرتَ موضوعها بعدما تجاوزنا مجمع شققها
Dialogue: 0,0:38:58.83,0:39:00.30,Default,,0000,0000,0000,,وأجريت الاتّصال
Dialogue: 0,0:39:00.36,0:39:05.56,Default,,0000,0000,0000,,،وبعدما سمعتُ صوتها الفزع ووثبت من السيّارة
Dialogue: 0,0:39:06.06,0:39:12.36,Default,,0000,0000,0000,,،ركنت السيّارة في شارع جانبيّ فوراً\Nوعاودت الاتّصال بها وأنت تلاحقني
Dialogue: 0,0:39:13.77,0:39:16.86,Default,,0000,0000,0000,,!أنا المحقّق الذي اتّصل قبل قليل! مكانكِ خطر
Dialogue: 0,0:39:16.86,0:39:20.07,Default,,0000,0000,0000,,فلتنتظري في دورة المياه\Nالعمومية المجاورة، حسناً؟
Dialogue: 0,0:39:21.23,0:39:25.04,Default,,0000,0000,0000,,...ثمّ، بينما كنّا في شقّتها
Dialogue: 0,0:39:26.17,0:39:27.56,Default,,0000,0000,0000,,...قمتَ
Dialogue: 0,0:39:28.97,0:39:30.60,Default,,0000,0000,0000,,...داخل الحمّام
Dialogue: 0,0:39:33.06,0:39:34.67,Default,,0000,0000,0000,,بقتلها
Dialogue: 0,0:39:36.19,0:39:40.11,Default,,0000,0000,0000,,سبب تمكّنك من الوصول بالسيّارة لبناية\Nشقّتها فور العثور على جثّتها
Dialogue: 0,0:39:40.89,0:39:44.96,Default,,0000,0000,0000,,هو لاستئجارك لسيّارتين من الطراز\Nوالتصميم الداخليّ نفسه
Dialogue: 0,0:39:45.60,0:39:50.93,Default,,0000,0000,0000,,بعد قتلك لها، صعدت السيّارة المستأجرة\Nالأخرى التي كانت بجوار البناية
Dialogue: 0,0:39:51.72,0:39:57.85,Default,,0000,0000,0000,,كي يبدو أنّه تعيّن عليك أخذ منعطف بما أنّ ميدوسوجي \Nطريق أحاديّ الاتّجاه، ولا تستطيع الذهاب شمالاً
Dialogue: 0,0:39:58.31,0:40:03.77,Default,,0000,0000,0000,,إقلالك لي، كما إقرابي من جوهر القضيّة
Dialogue: 0,0:40:04.35,0:40:07.40,Default,,0000,0000,0000,,!كان كي تجمعنا هنا، وتقتل المُسنّ غوشي
Dialogue: 0,0:40:08.14,0:40:11.85,Default,,0000,0000,0000,,،إنّه عضو في مجلس نوّاب المحافظة\Nسيلفت الأنظار إذا غادر منزله
Dialogue: 0,0:40:11.85,0:40:14.33,Default,,0000,0000,0000,,وقد يصطحب معه حرّاس شخصيّين\Nإذا لم تكن حذراً
Dialogue: 0,0:40:14.81,0:40:20.02,Default,,0000,0000,0000,,لكن بقدومك هنا معي، يمكنك التجوّل\Nفي المنزل دون إثارة الريبة
Dialogue: 0,0:40:22.68,0:40:25.29,Default,,0000,0000,0000,,متى أدركت يا هيجي-كن؟
Dialogue: 0,0:40:25.81,0:40:28.20,Default,,0000,0000,0000,,كانت مرآة السيّارة المستأجرة\Nالجانبيّة هي أوّل علامة
Dialogue: 0,0:40:28.93,0:40:32.47,Default,,0000,0000,0000,,كانت زاويتها مختلفة عندما\Nصعدتُ المرّة الثانية
Dialogue: 0,0:40:33.06,0:40:35.93,Default,,0000,0000,0000,,ثمّ أدركت عندما دقّقت في الصورة\Nالتي وصلت بالفاكس
Dialogue: 0,0:40:36.57,0:40:39.43,Default,,0000,0000,0000,,أنّك شبيهٌ لحدّ كبيرٍ بالمعلّم الذي تُوفي
Dialogue: 0,0:40:39.43,0:40:41.89,Default,,0000,0000,0000,,قبل 20 عاماً
Dialogue: 0,0:40:42.39,0:40:45.85,Default,,0000,0000,0000,,كان عادتك عند صعودك السيّارة\Nهي ما قطعت شكّي باليقين
Dialogue: 0,0:40:45.85,0:40:47.85,Default,,0000,0000,0000,,عدّلت مرآة الرؤية الخلفيّة
Dialogue: 0,0:40:47.85,0:40:50.22,Default,,0000,0000,0000,,بنفس أسلوب نوياسو-سان وأوكازاكي-سان
Dialogue: 0,0:40:52.35,0:40:55.87,Default,,0000,0000,0000,,هذا دليلٌ على أنّكم\Nمرتبطون بالشخص نفسه
Dialogue: 0,0:40:56.60,0:40:59.26,Default,,0000,0000,0000,,،لا أعرف ما الذي حصل 20 عاماً
Dialogue: 0,0:40:59.26,0:41:01.84,Default,,0000,0000,0000,,لكن ألا يجدر بك تسليم\Nنفسك يا ساكاتا-هان؟
Dialogue: 0,0:41:04.56,0:41:06.34,Default,,0000,0000,0000,,آسفٌ يا هيجي-كن
Dialogue: 0,0:41:08.39,0:41:11.42,Default,,0000,0000,0000,,انتهى الأمر في هذه المرحلة
Dialogue: 0,0:41:11.60,0:41:12.51,Default,,0000,0000,0000,,!يا-يا أحمق
Dialogue: 0,0:41:14.22,0:41:16.43,Default,,0000,0000,0000,,!ساكاتا هو القاتل؟
Dialogue: 0,0:41:16.67,0:41:19.77,Default,,0000,0000,0000,,أجل، أخبرنا نومابوتشي بكلّ شيء
Dialogue: 0,0:41:20.06,0:41:23.85,Default,,0000,0000,0000,,،بعد تنفيذ ساكاتا لسلسلة جرائم القتل\Nكان ينوى إلفاق التهمة بـ نومابوتشي
Dialogue: 0,0:41:24.39,0:41:27.64,Default,,0000,0000,0000,,ثمّ يقتله بحيث يبدو انتحاراً
Dialogue: 0,0:41:28.51,0:41:29.81,Default,,0000,0000,0000,,!أين ساكاتا؟
Dialogue: 0,0:41:29.81,0:41:32.47,Default,,0000,0000,0000,,...إ-إنّه غير موجود لفترة
Dialogue: 0,0:41:39.43,0:41:43.26,Default,,0000,0000,0000,,هذه الرصاصات كلّها! لا يمكنك\N!الإقدام على حماقات الآن
Dialogue: 0,0:41:48.10,0:41:50.13,Default,,0000,0000,0000,,هل أصابت طلقةٌ ساقك؟
Dialogue: 0,0:41:50.60,0:41:54.09,Default,,0000,0000,0000,,لا-لا تهتم لي، أسرع واهرب يا هيجي-كن
Dialogue: 0,0:41:55.18,0:41:59.22,Default,,0000,0000,0000,,كلا... يبدو أنّي أُصبت في معدتي أيضاً
Dialogue: 0,0:42:01.60,0:42:04.14,Default,,0000,0000,0000,,كان أبي
Dialogue: 0,0:42:04.72,0:42:07.18,Default,,0000,0000,0000,,المعلّم الذي مات قبل 20 عاماً
Dialogue: 0,0:42:07.85,0:42:09.51,Default,,0000,0000,0000,,كان سائقاً صارماً
Dialogue: 0,0:42:09.51,0:42:14.15,Default,,0000,0000,0000,,ويخبر أمّي بالتحقّق من مرآة\Nالرؤية الخلفيّة دوماً
Dialogue: 0,0:42:16.14,0:42:18.12,Default,,0000,0000,0000,,لا بدّ أنّ ذلك مصدر عادتي
Dialogue: 0,0:42:18.81,0:42:21.91,Default,,0000,0000,0000,,أتظنّ شخصاً مثله سيقود ثملاً؟
Dialogue: 0,0:42:22.56,0:42:26.22,Default,,0000,0000,0000,,...لذا أصبحت محقّقاً في الشرطة
Dialogue: 0,0:42:26.22,0:42:29.13,Default,,0000,0000,0000,,كي أكشف حقيقة موت أبي
Dialogue: 0,0:42:30.01,0:42:35.81,Default,,0000,0000,0000,,حللتُ اللغز عندما وجدت نومابوتشي الذي\Nكان هارباً في كوخٍ جبليّ
Dialogue: 0,0:42:35.81,0:42:40.81,Default,,0000,0000,0000,,ملامحي شبيهة أبي، فهلع عندما رآني
Dialogue: 0,0:42:40.81,0:42:42.80,Default,,0000,0000,0000,,ونطق بكلّ شيء
Dialogue: 0,0:42:43.75,0:42:47.47,Default,,0000,0000,0000,,!سامحني رجاءً يا معلّم إينابا! كان مجرّد مقلب
Dialogue: 0,0:42:47.47,0:42:50.51,Default,,0000,0000,0000,,أردنا رؤية ملامح الخوف على معلّمنا الصارم
Dialogue: 0,0:42:50.51,0:42:54.69,Default,,0000,0000,0000,,بعدما ندفعه للشرب ونجعله يقود\N!سيّارة بلا زيت مكابح
Dialogue: 0,0:42:56.74,0:43:01.86,Default,,0000,0000,0000,,وبدأت باستهداف الستّة المشاركين\Nفي تلك المكيدة؟
Dialogue: 0,0:43:01.86,0:43:04.80,Default,,0000,0000,0000,,الحدّ الزمني القضائيّ لجرائم القتل\Nهو 15 عاماً
Dialogue: 0,0:43:05.07,0:43:09.77,Default,,0000,0000,0000,,!لذا قرّرت أن أطبّق العدالة عليهم مكان القانون
Dialogue: 0,0:43:15.86,0:43:19.22,Default,,0000,0000,0000,,آسفٌ على إقحامك في هذا يا هيجي-كن
Dialogue: 0,0:43:19.78,0:43:23.16,Default,,0000,0000,0000,,لا-لا تقل كلاماً بائساً كهذا
Dialogue: 0,0:43:24.49,0:43:30.99,Default,,0000,0000,0000,,أنت ضابط شرطة، الوحيدون المسموح لهم\N!بحمل مسدّس في اليابان
Dialogue: 0,0:43:30.99,0:43:33.67,Default,,0000,0000,0000,,لمَ لم تفتخر بذلك؟
Dialogue: 0,0:43:35.48,0:43:37.21,Default,,0000,0000,0000,,!انهض يا ساكاتا
Dialogue: 0,0:43:37.85,0:43:41.30,Default,,0000,0000,0000,,!شعار زهرة الكرز في دفتر مذكّراتك يبكي
Dialogue: 0,0:43:56.99,0:43:58.65,Default,,0000,0000,0000,,...أ-أوتاكي-سان
Dialogue: 0,0:43:59.11,0:44:00.36,Default,,0000,0000,0000,,كيف هيجي-كن؟
Dialogue: 0,0:44:00.36,0:44:03.86,Default,,0000,0000,0000,,نقلوه بسيّارة إسعاف أخرى للتو
Dialogue: 0,0:44:04.41,0:44:09.58,Default,,0000,0000,0000,,إنّه شابٌ مذهل، اندفع من النار\Nوهو يحملك على ظهره
Dialogue: 0,0:44:10.70,0:44:11.61,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:44:11.61,0:44:15.33,Default,,0000,0000,0000,,!أهذا هو؟! المجرم الذي حاول قتلي؟
Dialogue: 0,0:44:15.67,0:44:16.96,Default,,0000,0000,0000,,!تبّاً لك
Dialogue: 0,0:44:18.78,0:44:23.26,Default,,0000,0000,0000,,لا يزال تابعي حالياً، لا تمدّ يدك رجاءً
Dialogue: 0,0:44:23.70,0:44:25.97,Default,,0000,0000,0000,,!سـ-سيّد توياما
Dialogue: 0,0:44:28.86,0:44:31.72,Default,,0000,0000,0000,,سأزورك لاحقاً يا غوشي-سان
Dialogue: 0,0:44:32.72,0:44:36.32,Default,,0000,0000,0000,,عندها يمكننا الكلام بشأن الحادثة\Nالقديمة قبل 20 عاماً
Dialogue: 0,0:46:22.37,0:46:24.45,Default,,0000,0000,0000,,!هيجي! تماسك
Dialogue: 0,0:46:24.45,0:46:26.45,Default,,0000,0000,0000,,!هيجي
Dialogue: 0,0:46:26.45,0:46:28.91,Default,,0000,0000,0000,,كيف هي إصابة هاتّوري-كن؟
Dialogue: 0,0:46:29.43,0:46:33.12,Default,,0000,0000,0000,,لا ندري بعد، علينا استخراج الرصاصة\Nبأسرع ما يمكن حالياً
Dialogue: 0,0:46:33.94,0:46:34.83,Default,,0000,0000,0000,,!الرصاصة؟
Dialogue: 0,0:46:35.18,0:46:37.16,Default,,0000,0000,0000,,هل أطلق عليك ساكاتا-سان؟
Dialogue: 0,0:46:37.16,0:46:39.16,Default,,0000,0000,0000,,لم يطلق عليّ
Dialogue: 0,0:46:39.16,0:46:43.30,Default,,0000,0000,0000,,بل حاولت منعه من الانتحار، وأُصبت عرضاً أثناء ذلك
Dialogue: 0,0:46:43.49,0:46:46.43,Default,,0000,0000,0000,,لمَ؟ لمَ تقدم على أمرٍ خطر كهذا؟
Dialogue: 0,0:46:47.87,0:46:54.77,Default,,0000,0000,0000,,أخبرني أحمقٌ ما أنّه لا يجدر بك دفع المجرم \Nإلى الموت باستنتاجاتك
Dialogue: 0,0:46:55.38,0:46:56.77,Default,,0000,0000,0000,,...هاتّوري
Dialogue: 0,0:46:59.71,0:47:01.15,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:47:02.19,0:47:03.63,Default,,0000,0000,0000,,نظري يصبح مشوّشاً
Dialogue: 0,0:47:04.35,0:47:05.96,Default,,0000,0000,0000,,دعوني أنم قليلاً
Dialogue: 0,0:47:07.41,0:47:09.58,Default,,0000,0000,0000,,!كلا! لا يمكنك النوم يا هيجي
Dialogue: 0,0:47:11.12,0:47:12.04,Default,,0000,0000,0000,,هيجي؟
Dialogue: 0,0:47:22.60,0:47:23.63,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:47:24.00,0:47:26.42,Default,,0000,0000,0000,,!هيجي
Dialogue: 0,0:47:29.96,0:47:31.25,Default,,0000,0000,0000,,!اصمتي
Dialogue: 0,0:47:31.25,0:47:34.02,Default,,0000,0000,0000,,ألا تفهمين عندما أخبرك\N!بأن تتركيني أنام يا حمقاء؟
Dialogue: 0,0:47:35.80,0:47:38.62,Default,,0000,0000,0000,,أظنّه بخير إن كان بهذه الحيويّة
Dialogue: 0,0:47:42.08,0:47:46.41,Default,,0000,0000,0000,,لم أنم كفايتي البارحة لانشغالي\Nبالتخطيط لجولة أوساكا
Dialogue: 0,0:47:46.41,0:47:49.87,Default,,0000,0000,0000,,فلا تزعجيني بنحيبك، ساذجة
Dialogue: 0,0:47:53.80,0:47:56.79,Default,,0000,0000,0000,,اعذرني على نحيبي المزعج
Dialogue: 0,0:48:00.96,0:48:02.46,Default,,0000,0000,0000,,!ما الذي تفعلينه يا حمقاء؟
Dialogue: 0,0:48:02.85,0:48:06.09,Default,,0000,0000,0000,,!أنت الأحمق! من يرقد بذاك الشكل المربك؟
Dialogue: 0,0:48:06.37,0:48:08.55,Default,,0000,0000,0000,,...هـ-هوّنا عليكما
Dialogue: 0,0:48:08.78,0:48:10.55,On Top,,0000,0000,0000,,!افهمي! أنا مصاب
Dialogue: 0,0:48:13.15,0:48:15.85,Default,,0000,0000,0000,,لا أظنّه سيلقى منيّته\Nفي أيّ وقتٍ قريب
Dialogue: 0,0:48:28.95,0:48:29.83,Default,,0000,0000,0000,,!توقّف
Dialogue: 0,0:48:29.83,0:48:30.78,Default,,0000,0000,0000,,!كلا يا كونان-كن
Dialogue: 0,0:48:30.78,0:48:32.78,Default,,0000,0000,0000,,ماذا؟ لمَ؟
Dialogue: 0,0:48:35.65,0:48:38.55,Default,,0000,0000,0000,,كانت هذه جريمة قتل كليّة
Dialogue: 0,0:48:39.10,0:48:42.00,Default,,0000,0000,0000,,من تدبير أحدهم منذ البداية
Dialogue: 0,0:48:42.00,0:48:44.00,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:48:42.00,0:48:48.01,On Top,,0000,0000,0000,,جريمة قتل يايبا المقنّع
Dialogue: 0,0:48:44.00,0:48:46.79,Default,,0000,0000,0000,,جريمة قتل يايبا المقنّع
Dialogue: 0,0:48:49.15,0:48:51.58,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:48:51.58,0:48:53.01,Default,,0000,0000,0000,,مسدّس مقلّد
Dialogue: 0,0:48:53.34,0:48:55.52,Default,,0000,0000,0000,,تُبث الحلقة القادمة في الثاني\N!عشر من أكتوبر
Dialogue: 0,0:48:55.52,0:48:56.50,Default,,0000,0000,0000,,"اقرؤوا مجلّة "ساندي
Dialogue: 0,0:48:56.50,0:48:58.50,Default,,0000,0000,0000,,!كونوا بانتظارنا

