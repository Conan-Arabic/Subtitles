Dialogue: 0,0:00:01.71,0:00:04.78,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:04.78,0:00:07.03,Default,,0000,0000,0000,,!رجع شينتشي أخيراً اليوم
Dialogue: 0,0:00:07.03,0:00:09.03,Default,,0000,0000,0000,,لكن هناك أمرٌ ليس في محلّه
Dialogue: 0,0:00:09.03,0:00:10.83,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:10.83,0:00:13.32,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.32,0:00:15.61,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:45.48,0:01:51.58,Default,,0000,0000,0000,,ظهر مُتحرّ في الثانوية من كانساي\Nفي مكتب العمّ فجأةً يُدعى هاتّوري هيجي
Dialogue: 0,0:01:51.58,0:01:54.55,Default,,0000,0000,0000,,بدا أنّه يريد منازلتي، أي شينتشي
Dialogue: 0,0:01:54.92,0:01:58.97,Default,,0000,0000,0000,,وحينذاك، أتت زوجة الدبلوماسيّ تسوجيمورا
Dialogue: 0,0:01:58.97,0:02:02.13,Default,,0000,0000,0000,,وطلبت من العمّ تحرّي خلفية حبيبة ابنها
Dialogue: 0,0:02:02.13,0:02:08.29,Default,,0000,0000,0000,,وفي منزلها، وجدنا الدبلوماسي ميتاً بالسُم في مكتبه
Dialogue: 0,0:02:08.29,0:02:11.50,Default,,0000,0000,0000,,!كما أنّها كانت جريمة غرفة مقفلة
Dialogue: 0,0:02:11.50,0:02:16.05,Default,,0000,0000,0000,,يجد هاتّوري الدلائل توالياً ويكتشف الحيل
Dialogue: 0,0:02:16.05,0:02:19.61,Default,,0000,0000,0000,,لكنّ زكامي والشراب الكحولي الذي أعطاني إيّاه هاتّوري
Dialogue: 0,0:02:19.61,0:02:22.59,Default,,0000,0000,0000,,قادا بي لارتفاع حرارتي وانهياري
Dialogue: 0,0:02:22.98,0:02:25.98,Default,,0000,0000,0000,,لكن هناك أمرٌ غريب في هذه الحُمّى
Dialogue: 0,0:02:25.98,0:02:27.22,Default,,0000,0000,0000,,يوجد خطبٌ ما
Dialogue: 0,0:02:28.23,0:02:29.27,Default,,0000,0000,0000,,!أشعر بسخونة شديدة
Dialogue: 0,0:02:29.27,0:02:31.42,Default,,0000,0000,0000,,!كأنّ قلبي على وشك الانفجار
Dialogue: 0,0:02:31.72,0:02:33.22,Default,,0000,0000,0000,,إذاً يا كودو؟
Dialogue: 0,0:02:33.22,0:02:36.68,Default,,0000,0000,0000,,لو كانت لديك مشكلة مع استنتاجي فأظهر نفسك
Dialogue: 0,0:02:36.68,0:02:39.64,Default,,0000,0000,0000,,!عليك الإسراع وإلّا سأحلّ كل شيء
Dialogue: 0,0:02:40.70,0:02:47.03,Title,,0000,0000,15,,{\fad(300,0)}(جريمة قتل الدبلوماسيّ (الجزء الثاني
Dialogue: 0,0:02:41.87,0:02:45.46,Default,,0000,0000,0000,,(جريمة قتل الدبلوماسيّ (الجزء الثاني
Dialogue: 0,0:02:47.75,0:02:49.27,Default,,0000,0000,0000,,...من يكون
Dialogue: 0,0:02:49.27,0:02:51.67,Default,,0000,0000,0000,,من يكون القاتل إذاً يا هاتّوري-كن؟
Dialogue: 0,0:02:51.67,0:02:53.54,Default,,0000,0000,0000,,على رسلك
Dialogue: 0,0:02:55.61,0:02:59.24,Default,,0000,0000,0000,,ما الخطب يا كودو؟ هل ستنسحب من النزال؟
Dialogue: 0,0:03:00.57,0:03:01.44,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:03:01.62,0:03:03.26,Default,,0000,0000,0000,,!هيّا! بسرعة
Dialogue: 0,0:03:04.53,0:03:07.86,Default,,0000,0000,0000,,سيستغرق قتل الضحيّة وتنفيذ الحيلة
Dialogue: 0,0:03:07.86,0:03:09.61,Default,,0000,0000,0000,,بين 5 إلى 6 دقائق على الأقل
Dialogue: 0,0:03:09.61,0:03:11.22,Default,,0000,0000,0000,,...وقعت الجريمة
Dialogue: 0,0:03:11.22,0:03:14.80,Default,,0000,0000,0000,,في النصف ساعة بين الثالثة والنصف والرابعة
Dialogue: 0,0:03:15.69,0:03:16.77,Default,,0000,0000,0000,,!أتى الطبيب
Dialogue: 0,0:03:18.31,0:03:19.73,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:03:20.73,0:03:22.59,Default,,0000,0000,0000,,زوجته خارج الشبهات
Dialogue: 0,0:03:22.59,0:03:25.51,Default,,0000,0000,0000,,فقد كانت معنا طوال الوقت
Dialogue: 0,0:03:25.51,0:03:27.52,Default,,0000,0000,0000,,وينطبق الأمر على الخادم
Dialogue: 0,0:03:28.09,0:03:31.00,Default,,0000,0000,0000,,الذي كان يتكلّم مع الجيران
Dialogue: 0,0:03:31.00,0:03:34.51,Default,,0000,0000,0000,,في تلك الفترة عند الباب الأمامي
Dialogue: 0,0:03:34.51,0:03:36.43,Default,,0000,0000,0000,,قبل أن يستقبلنا
Dialogue: 0,0:03:37.12,0:03:39.27,Default,,0000,0000,0000,,أين أنت يا كونان-كن؟
Dialogue: 0,0:03:39.27,0:03:41.97,Default,,0000,0000,0000,,الابن وحبيبته مثيران للشبهة
Dialogue: 0,0:03:41.97,0:03:47.57,Default,,0000,0000,0000,,بما أنّهما وصلا قبل الزوجة بقليل\N،ووجدناهما نازلين من الطابق الثاني
Dialogue: 0,0:03:47.57,0:03:50.20,Default,,0000,0000,0000,,لكن لم يلبثا هناك إلا دقيقة أو اثنتين
Dialogue: 0,0:03:50.20,0:03:51.30,Default,,0000,0000,0000,,فلا وقت لارتكاب الجريمة
Dialogue: 0,0:03:51.77,0:03:55.02,Default,,0000,0000,0000,,...أين ذهب كونان-كن
Dialogue: 0,0:03:55.02,0:03:57.66,Default,,0000,0000,0000,,كونان-كن! أين أنت؟
Dialogue: 0,0:03:58.94,0:04:00.40,Default,,0000,0000,0000,,...ما يترك لنا
Dialogue: 0,0:04:00.40,0:04:06.28,Default,,0000,0000,0000,,الشخص الذي وصل بعد الثانية وشاهد التلفاز \N...في الغرفة المجاورة للمكتب
Dialogue: 0,0:04:06.28,0:04:08.54,Default,,0000,0000,0000,,!أنت أيّها العجوز
Dialogue: 0,0:04:10.01,0:04:13.21,Default,,0000,0000,0000,,...وجدتُ الدليل في الغرفة يابانية الطراز
Dialogue: 0,0:04:13.21,0:04:14.14,Default,,0000,0000,0000,,!خيط صيد سمك
Dialogue: 0,0:04:14.46,0:04:19.60,Default,,0000,0000,0000,,هذا أحدث وأقوى نوع من خيوط الصيد
Dialogue: 0,0:04:19.83,0:04:22.55,Default,,0000,0000,0000,,!أنت صيّاد سمك فلا تتظاهر بالجهل
Dialogue: 0,0:04:22.82,0:04:28.48,Default,,0000,0000,0000,,...كما أنّنا صادفناك في طريقنا مع الزوجة للمكتب
Dialogue: 0,0:04:28.91,0:04:30.97,Default,,0000,0000,0000,,انتظر في غرفة الضيافة يابانية الطراز رجاءً
Dialogue: 0,0:04:31.44,0:04:37.02,Default,,0000,0000,0000,,أي أنّك كنت في الغرفة\Nيابانية الطراز بعد الجريمة
Dialogue: 0,0:04:37.27,0:04:42.39,Default,,0000,0000,0000,,وجود خيط الصيد هذا في حاوية قمامة\N!تلك الغرفة دليلٌ دامغ
Dialogue: 0,0:04:42.39,0:04:43.51,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:04:43.51,0:04:44.97,Default,,0000,0000,0000,,!إذاً؟ أأنا مخطئ؟
Dialogue: 0,0:04:45.51,0:04:49.14,Default,,0000,0000,0000,,المعذرة، هل رأيتما كونان-كن هنا؟
Dialogue: 0,0:04:49.14,0:04:49.93,Default,,0000,0000,0000,,...كلا
Dialogue: 0,0:04:50.30,0:04:52.02,Default,,0000,0000,0000,,!أيّها العجوز
Dialogue: 0,0:04:53.38,0:04:56.47,Default,,0000,0000,0000,,صحيح، كان أنا
Dialogue: 0,0:04:57.34,0:04:58.73,Default,,0000,0000,0000,,!فزت
Dialogue: 0,0:04:59.67,0:05:04.89,Default,,0000,0000,0000,,...كنتُ من قتل ابني إيساو
Dialogue: 0,0:05:04.89,0:05:07.22,Default,,0000,0000,0000,,كلا، ليس صحيحاً
Dialogue: 0,0:05:07.22,0:05:07.81,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:05:13.90,0:05:15.93,Default,,0000,0000,0000,,ليس صحيحاً البتّة
Dialogue: 0,0:05:16.83,0:05:17.89,Default,,0000,0000,0000,,!كودو
Dialogue: 0,0:05:18.40,0:05:19.85,Default,,0000,0000,0000,,...شينتشي
Dialogue: 0,0:05:20.89,0:05:22.30,Default,,0000,0000,0000,,...شينتشي
Dialogue: 0,0:05:22.89,0:05:26.26,Default,,0000,0000,0000,,!هذا كودو... كودو شينتشي
Dialogue: 0,0:05:27.48,0:05:31.61,Default,,0000,0000,0000,,...إنّه... إنّه شينتشي حقّاً
Dialogue: 0,0:05:33.05,0:05:34.59,Default,,0000,0000,0000,,...شينتشي
Dialogue: 0,0:05:34.59,0:05:36.01,Default,,0000,0000,0000,,!أين كنت؟
Dialogue: 0,0:05:36.84,0:05:38.98,Default,,0000,0000,0000,,!تختفي فجأةً وتظهر فجأةً
Dialogue: 0,0:05:39.47,0:05:41.87,Default,,0000,0000,0000,,!كنت... كنت قلقةً جداً
Dialogue: 0,0:05:41.87,0:05:44.08,Default,,0000,0000,0000,,لا تبكي يا حمقاء
Dialogue: 0,0:05:44.08,0:05:44.93,Default,,0000,0000,0000,,!اسكت
Dialogue: 0,0:05:45.29,0:05:47.12,Default,,0000,0000,0000,,معها حقّ
Dialogue: 0,0:05:47.12,0:05:49.91,Default,,0000,0000,0000,,تظهر فجأةً وتطعن بكلامي؟
Dialogue: 0,0:05:49.91,0:05:52.64,Default,,0000,0000,0000,,أترى نقصاً في استنتاجي؟
Dialogue: 0,0:05:55.15,0:05:56.54,Default,,0000,0000,0000,,...انتظري يا ران
Dialogue: 0,0:05:58.28,0:05:59.56,Default,,0000,0000,0000,,...أنت تتعرّق
Dialogue: 0,0:05:59.79,0:06:02.47,Default,,0000,0000,0000,,سأنتهي بسرعة
Dialogue: 0,0:06:03.10,0:06:04.30,Default,,0000,0000,0000,,شينتشي؟
Dialogue: 0,0:06:08.43,0:06:11.47,Default,,0000,0000,0000,,!أين الخطأ في استنتاجي يا كودو؟
Dialogue: 0,0:06:12.63,0:06:16.26,Default,,0000,0000,0000,,الحيلة التي شرحتَها نظرية لا عملية
Dialogue: 0,0:06:16.26,0:06:18.77,Default,,0000,0000,0000,,%أي مستحيلة 100
Dialogue: 0,0:06:19.05,0:06:20.55,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:06:20.55,0:06:22.12,Default,,0000,0000,0000,,انتظر يا كودو-كن
Dialogue: 0,0:06:22.12,0:06:24.08,Default,,0000,0000,0000,,،أكره المقاطعة
Dialogue: 0,0:06:24.08,0:06:26.47,Default,,0000,0000,0000,,لكن حيلة الغرفة المقفلة التي أشار لها تعمل بإتقان
Dialogue: 0,0:06:26.47,0:06:29.27,Default,,0000,0000,0000,,اختبرناها قبل قليل ببنطالي
Dialogue: 0,0:06:29.95,0:06:32.57,Default,,0000,0000,0000,,تأخذ خيطاً بطرف مربوط بإبرة بدايةً
Dialogue: 0,0:06:32.57,0:06:36.39,Default,,0000,0000,0000,,،وتلصق الطرف الآخر بحمّالة المفتاح
Dialogue: 0,0:06:36.78,0:06:40.77,Default,,0000,0000,0000,,ثمّ تمرر طرف الإبرة عبر جيب البنطال من الداخل
Dialogue: 0,0:06:40.77,0:06:46.56,Default,,0000,0000,0000,,،وتسحب الطرفين خارج الغرفة وتقفل الباب
Dialogue: 0,0:06:46.56,0:06:48.27,Default,,0000,0000,0000,,...ثمّ بسحبك لطرف الإبرة
Dialogue: 0,0:06:51.64,0:06:55.26,Default,,0000,0000,0000,,سيدخل المفتاح الجيب من تلقاء نفسه...
Dialogue: 0,0:06:55.26,0:06:57.58,Default,,0000,0000,0000,,...وبسحبة أخيرة
Dialogue: 0,0:06:57.95,0:06:59.97,Default,,0000,0000,0000,,سيتحرر الخيط من الشريط
Dialogue: 0,0:06:59.97,0:07:03.12,Default,,0000,0000,0000,,وكلّ ما يبقى هو ربط الخيط وسيختفي الدليل
Dialogue: 0,0:07:03.12,0:07:05.22,Default,,0000,0000,0000,,وتنشأ الغرفة المقفلة
Dialogue: 0,0:07:05.62,0:07:09.18,Default,,0000,0000,0000,,هل المفتاح داخل جيبك حقاً يا مفتّش ميغوري؟
Dialogue: 0,0:07:10.46,0:07:15.74,Default,,0000,0000,0000,,سمعتُ أنّ المفتاح كان في جيب مزدوج لبنطال الضحيّة
Dialogue: 0,0:07:15.74,0:07:16.95,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:07:16.95,0:07:17.89,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:07:17.89,0:07:19.86,Default,,0000,0000,0000,,!إن ظننت أنّنا نكذب فانظر بنفسك
Dialogue: 0,0:07:19.86,0:07:22.39,Default,,0000,0000,0000,,...أترى؟ إنّه في جيب
Dialogue: 0,0:07:25.56,0:07:27.68,Default,,0000,0000,0000,,!لا... يمكن
Dialogue: 0,0:07:28.44,0:07:32.43,Default,,0000,0000,0000,,!أنا متأكد أني مررت الخيط عبر جيبه المزدوج
Dialogue: 0,0:07:32.43,0:07:36.14,Default,,0000,0000,0000,,ذلك لأنّ المفتّش ميغوري كان جالساً\Nعندما أدخلت المفتاح
Dialogue: 0,0:07:36.14,0:07:37.27,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:07:37.59,0:07:39.01,Default,,0000,0000,0000,,،لأنّه كان جالساً
Dialogue: 0,0:07:39.01,0:07:42.21,Default,,0000,0000,0000,,،انطوى الجيب وحجب طريق المفتاح
Dialogue: 0,0:07:42.21,0:07:47.47,Default,,0000,0000,0000,,ونُزع الشريط قبل أن يصل الجيب المزدوج
Dialogue: 0,0:07:47.47,0:07:51.89,Default,,0000,0000,0000,,كما أنّ الضحيّة كان مليئاً مثل المفتّش ميغوري
Dialogue: 0,0:07:52.20,0:07:53.99,Default,,0000,0000,0000,,...بذكرك ذلك
Dialogue: 0,0:07:53.99,0:07:56.27,Default,,0000,0000,0000,,...عندما أدخلتُ يدي في جيب الضحية
Dialogue: 0,0:07:58.07,0:08:00.56,Default,,0000,0000,0000,,تبّاً، بنطاله ضيّق
Dialogue: 0,0:08:00.94,0:08:05.52,Default,,0000,0000,0000,,...لكن يمكن أن يحصل ذلك في مرّة من 10 آلاف\Nكلا، مرّة من 10 مرات
Dialogue: 0,0:08:05.52,0:08:08.02,Default,,0000,0000,0000,,ستبقى النتيجة نفسها مهما حاولت
Dialogue: 0,0:08:08.02,0:08:14.43,Default,,0000,0000,0000,,تذكّر اتّجاه المفتاح عندما كان\Nفي الجيب المزدوج لبنطال الضحيّة
Dialogue: 0,0:08:14.43,0:08:16.64,Default,,0000,0000,0000,,اتّجاه المفتاح؟
Dialogue: 0,0:08:20.18,0:08:24.67,Default,,0000,0000,0000,,صحيح، حتّى لو دخل الجيب في مرّة من 10 آلاف
Dialogue: 0,0:08:24.67,0:08:26.56,Default,,0000,0000,0000,,ستدخل الحمّالة فحسب
Dialogue: 0,0:08:27.13,0:08:33.37,Default,,0000,0000,0000,,لا يمكن أن ينقلب المفتاح\Nويدخل مع الحمّالة في الجيب الضيق
Dialogue: 0,0:08:33.37,0:08:36.18,Default,,0000,0000,0000,,وجوده بالكامل في الدّاخل
Dialogue: 0,0:08:36.57,0:08:42.09,Default,,0000,0000,0000,,يعني أنّ القاتل وضعه في جيب الضحية سلفاً
Dialogue: 0,0:08:42.48,0:08:46.56,Default,,0000,0000,0000,,ماذا عن خيط الصيد بالإبرة الذي وجدتُه إذاً؟
Dialogue: 0,0:08:46.56,0:08:52.26,Default,,0000,0000,0000,,فخّ آخر نصبه القاتل لإلقاء اللوم على العجوز
Dialogue: 0,0:08:53.18,0:08:58.27,Default,,0000,0000,0000,,وجدتُ أشياء أخرى مشابهة في أرجاء المنزل
Dialogue: 0,0:08:59.22,0:09:02.17,Default,,0000,0000,0000,,وضعها القاتل في بقيّة الغرف أيضاً
Dialogue: 0,0:09:02.17,0:09:06.18,Default,,0000,0000,0000,,كيلا يهم أين كان العجوز وقت وقوع الجريمة
Dialogue: 0,0:09:06.18,0:09:09.64,Default,,0000,0000,0000,,!لكنّه اعترف بارتكاب الجريمة
Dialogue: 0,0:09:10.34,0:09:14.10,Default,,0000,0000,0000,,دخل فخّ القاتل من محض إرادته فحسب
Dialogue: 0,0:09:14.91,0:09:17.56,Default,,0000,0000,0000,,رغم أنّي أجهل السبب
Dialogue: 0,0:09:18.16,0:09:21.23,Default,,0000,0000,0000,,كانت هذه الغرفة مقفلة تماماً
Dialogue: 0,0:09:21.23,0:09:24.01,Default,,0000,0000,0000,,لا تقترح أنّه كان انتحاراً، صحيح؟
Dialogue: 0,0:09:24.32,0:09:26.07,Default,,0000,0000,0000,,كلا، لم يكن انتحاراً
Dialogue: 0,0:09:26.07,0:09:30.93,Default,,0000,0000,0000,,كما أنّ حيلة القاتل الحقيقية لا تزال هنا
Dialogue: 0,0:09:30.93,0:09:31.93,Default,,0000,0000,0000,,الحيلة الحقيقية؟
Dialogue: 0,0:09:31.93,0:09:33.60,Default,,0000,0000,0000,,أنسيت؟
Dialogue: 0,0:09:33.60,0:09:35.56,Default,,0000,0000,0000,,،عندما اكتشفتم الجثّة
Dialogue: 0,0:09:35.56,0:09:36.93,Default,,0000,0000,0000,,كانت هناك أوبرا تُعزف في الغرفة
Dialogue: 0,0:09:37.31,0:09:39.73,Default,,0000,0000,0000,,كما كتباً متراصّة بجواره
Dialogue: 0,0:09:40.18,0:09:42.71,Default,,0000,0000,0000,,كان الهدف من الأوبرا عزل صرخات الضحيّة
Dialogue: 0,0:09:42.71,0:09:45.72,Default,,0000,0000,0000,,التي قد تصدر بعد تسميمه بالإبرة
Dialogue: 0,0:09:46.89,0:09:51.13,Default,,0000,0000,0000,,والكتب لإخفاء وجهه المعصور بالألم غالباً
Dialogue: 0,0:09:52.83,0:09:53.97,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:09:54.87,0:09:57.93,Default,,0000,0000,0000,,لخداع أعين وآذان من؟
Dialogue: 0,0:09:58.12,0:10:01.38,Default,,0000,0000,0000,,!كان الهدف... أنت يا هاتّوري
Dialogue: 0,0:10:01.85,0:10:02.58,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:03.40,0:10:05.19,Default,,0000,0000,0000,,ليس أنت فحسب
Dialogue: 0,0:10:05.19,0:10:10.72,Default,,0000,0000,0000,,لم ينتبه المتحرّي موري وران\Nاللذان أتيا معك أيضاً
Dialogue: 0,0:10:11.10,0:10:12.84,Default,,0000,0000,0000,,...لحظة، أتقصد
Dialogue: 0,0:10:13.22,0:10:15.18,Default,,0000,0000,0000,,،عندما دخلتم المكتب
Dialogue: 0,0:10:15.18,0:10:17.81,Default,,0000,0000,0000,,...أوّل من اقترب من الضحيّة
Dialogue: 0,0:10:22.46,0:10:26.43,Default,,0000,0000,0000,,!أجل، القاتل هو... أنت
Dialogue: 0,0:10:32.68,0:10:36.20,Default,,0000,0000,0000,,...أجل، القاتل
Dialogue: 0,0:10:36.20,0:10:37.89,Default,,0000,0000,0000,,!هو أنت يا سيّدة
Dialogue: 0,0:10:38.85,0:10:41.15,Default,,0000,0000,0000,,قتلت السيّدة زوجها؟
Dialogue: 0,0:10:41.15,0:10:42.80,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:10:42.99,0:10:46.74,Default,,0000,0000,0000,,أتقصد أنّ الضحيّة كان لا يزال حيّاً آنذاك؟
Dialogue: 0,0:10:46.74,0:10:51.76,Default,,0000,0000,0000,,أجل، أفقدته وعيه فحسب سلفاً بعقار ما
Dialogue: 0,0:10:52.23,0:10:56.22,Default,,0000,0000,0000,,ثمّ سمّمته بالإبرة وهي تتظاهر بإيقاظه
Dialogue: 0,0:10:56.36,0:10:59.23,Default,,0000,0000,0000,,رغم أنّه من الطبيعي أنّ أحداً لم ينتبه
Dialogue: 0,0:10:59.23,0:11:03.14,Default,,0000,0000,0000,,...إذا كان العقار المنوّم والسم قويّين بما يكفي
Dialogue: 0,0:11:03.59,0:11:07.60,Default,,0000,0000,0000,,سيموت الضحيّة فوراً بعد وخزه كما لو كان نائماً
Dialogue: 0,0:11:08.05,0:11:12.93,Default,,0000,0000,0000,,جهّزت الأوبرا والكتب تحسّباً
Dialogue: 0,0:11:12.93,0:11:17.46,Default,,0000,0000,0000,,...لكن إذا ظهرت آثار العقار المنوّم في التشريح
Dialogue: 0,0:11:17.46,0:11:18.37,Default,,0000,0000,0000,,...ستُكشف الحيلة
Dialogue: 0,0:11:18.37,0:11:20.46,Default,,0000,0000,0000,,كلا، لن تُكشف
Dialogue: 0,0:11:20.46,0:11:24.03,Default,,0000,0000,0000,,افترضنا أنّه كان ميتاً قبل دخولنا
Dialogue: 0,0:11:24.03,0:11:29.07,Default,,0000,0000,0000,,كنا لنعرف أنّه أُفقد وعيه قبل تعرضه للقتل وحسب
Dialogue: 0,0:11:30.07,0:11:34.30,Default,,0000,0000,0000,,،أي أنّها كانت جريمة قتل غرفة مقفلة ذهنية
Dialogue: 0,0:11:34.30,0:11:38.48,Default,,0000,0000,0000,,مبنيّة على افتراض أنّ لا أحد سيدعو مُتحرّياً
Dialogue: 0,0:11:38.85,0:11:40.88,Default,,0000,0000,0000,,!لغرفة مقفلة ثم يقتل أحداً داخلها
Dialogue: 0,0:11:41.55,0:11:43.33,Default,,0000,0000,0000,,ذاك ما تريد قوله يا كودو، صحيح؟
Dialogue: 0,0:11:43.33,0:11:44.68,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:44.68,0:11:47.26,Default,,0000,0000,0000,,هلّا أريتنا دليلاً إذاً؟
Dialogue: 0,0:11:47.26,0:11:51.26,Default,,0000,0000,0000,,كما أنّي لم أرها تخرج إبرة مسمومة آنذاك
Dialogue: 0,0:11:53.50,0:11:57.58,Default,,0000,0000,0000,,أجل، أخرجت الإبرة
Dialogue: 0,0:11:57.58,0:12:00.49,Default,,0000,0000,0000,,بطريقة لا ينتبه لها أحد
Dialogue: 0,0:12:00.49,0:12:01.93,Default,,0000,0000,0000,,مع المفتاح
Dialogue: 0,0:12:01.93,0:12:03.76,Default,,0000,0000,0000,,الـ-المفتاح؟
Dialogue: 0,0:12:03.76,0:12:10.47,Default,,0000,0000,0000,,أجل، لحمّالة مفتاحها نفس تصميم حمّالة مفتاح الضحيّة
Dialogue: 0,0:12:12.31,0:12:16.10,Default,,0000,0000,0000,,يُفترض أن تنفصل حمّالتها طبيعياً أيضاً
Dialogue: 0,0:12:16.10,0:12:17.52,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:12:17.52,0:12:22.05,Default,,0000,0000,0000,,هلّا أريتِنا مفتاحك وحمّالته وما بها رجاءً؟
Dialogue: 0,0:12:22.30,0:12:25.01,Default,,0000,0000,0000,,...سيّدتي، سأتفقدها قليلاً
Dialogue: 0,0:12:30.83,0:12:32.22,Default,,0000,0000,0000,,ما هذا الخطّ؟
Dialogue: 0,0:12:32.22,0:12:36.08,Default,,0000,0000,0000,,وُضعت الإبرة المسمومة به غالباً
Dialogue: 0,0:12:36.08,0:12:40.95,Default,,0000,0000,0000,,عدّلت الحمّالة كي يمكنها إخراج الإبرة\Nفور دخولنا الغرفة
Dialogue: 0,0:12:41.95,0:12:45.03,Default,,0000,0000,0000,,أي أنّ حمّالة المفتاح هذه
Dialogue: 0,0:12:45.03,0:12:48.64,Default,,0000,0000,0000,,!هي دليل دامغ بأنّها القاتلة
Dialogue: 0,0:12:48.64,0:12:52.14,Default,,0000,0000,0000,,لكن لمَ قد تقتل زوجها؟
Dialogue: 0,0:12:53.01,0:12:55.06,Default,,0000,0000,0000,,،إن أصاب حدسي
Dialogue: 0,0:12:55.06,0:12:59.68,Default,,0000,0000,0000,,فدافعها موجود في هذه الصورة غالباً
Dialogue: 0,0:13:02.00,0:13:04.30,Default,,0000,0000,0000,,هذه صورة من شبابها
Dialogue: 0,0:13:04.30,0:13:07.09,Default,,0000,0000,0000,,أمعن النظر سيّدي المفتّش
Dialogue: 0,0:13:07.09,0:13:10.05,Default,,0000,0000,0000,,ألا تشبه أحداً؟
Dialogue: 0,0:13:10.05,0:13:12.00,Default,,0000,0000,0000,,!تبدو مثل يوكيكو-سان
Dialogue: 0,0:13:14.24,0:13:15.58,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:13:15.58,0:13:17.63,Default,,0000,0000,0000,,انظروا، لون شعرها مختلف فحسب
Dialogue: 0,0:13:18.29,0:13:20.20,Default,,0000,0000,0000,,بالطبع تشبهني
Dialogue: 0,0:13:20.20,0:13:23.96,Default,,0000,0000,0000,,!فأنا... أمّ يوكيكو
Dialogue: 0,0:13:24.44,0:13:26.46,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:13:26.46,0:13:28.93,Default,,0000,0000,0000,,!لا-لا يمكن
Dialogue: 0,0:13:28.93,0:13:31.60,Default,,0000,0000,0000,,هذه ابنة من زوجك إيساو-سان إذاً؟
Dialogue: 0,0:13:31.60,0:13:35.84,Default,,0000,0000,0000,,كلا، أنجبتُ يوكيكو من زواجي السابق
Dialogue: 0,0:13:36.43,0:13:41.05,Default,,0000,0000,0000,,أجل! إنّها ابنة ياماشيرو كينجي، دبلوماسي نُبذ من المجتمع
Dialogue: 0,0:13:41.05,0:13:47.63,Default,,0000,0000,0000,,!على يد زوجي الحالي تسوجيمورا إيساو قبل 20 عاماً
Dialogue: 0,0:13:47.63,0:13:49.43,Default,,0000,0000,0000,,ياماشيرو كينجي؟
Dialogue: 0,0:13:49.43,0:13:52.91,Default,,0000,0000,0000,,أجل، الرجل الذي مات في السجن قبل 20 عاماً
Dialogue: 0,0:13:52.91,0:13:56.66,Default,,0000,0000,0000,,كان هدف تسوجيمورا التخلّص منه
Dialogue: 0,0:13:56.66,0:13:58.88,Default,,0000,0000,0000,,!بما أنّه كان منافساً له
Dialogue: 0,0:13:59.22,0:14:03.13,Default,,0000,0000,0000,,!ثمّ أخذني زوجةً له
Dialogue: 0,0:14:03.13,0:14:05.82,Default,,0000,0000,0000,,اُعتقل زوجي
Dialogue: 0,0:14:05.82,0:14:08.44,Default,,0000,0000,0000,,ثمّ تبنّت عائلته يوكيكو
Dialogue: 0,0:14:08.44,0:14:11.73,Default,,0000,0000,0000,,...بعد انهياري الذهني
Dialogue: 0,0:14:12.89,0:14:15.92,Default,,0000,0000,0000,,انفصلتُ عن زوجتي لأجلك
Dialogue: 0,0:14:16.89,0:14:19.81,Default,,0000,0000,0000,,،تقرّب لي تسوجيمورا
Dialogue: 0,0:14:19.81,0:14:23.42,Default,,0000,0000,0000,,وأصبحتُ زوجةً لذاك الرجل الشيطان
Dialogue: 0,0:14:23.42,0:14:30.54,Default,,0000,0000,0000,,أدركتُ كلّ شيء عندما جلب تاكايوشي-سان\Nصورة حبيبته يوكيكو للمنزل
Dialogue: 0,0:14:30.54,0:14:35.51,Default,,0000,0000,0000,,...ظننتُه مجرد تشابه عابر بدايةً، لكنّ تسوجيمورا
Dialogue: 0,0:14:36.46,0:14:42.71,Default,,0000,0000,0000,,كلا! مستحيل أن أترك تاكايوشي\N!يرتبط بابنة ذاك الرجل أبداً
Dialogue: 0,0:14:43.15,0:14:46.07,Default,,0000,0000,0000,,...شككتُ وضغطتُ عليه
Dialogue: 0,0:14:46.07,0:14:51.42,Default,,0000,0000,0000,,فبدأ يتكلّم عن إلفاقه تهمة الفساد بياماشيرو
Dialogue: 0,0:14:51.69,0:14:56.38,Default,,0000,0000,0000,,وعن مساعدة أبيه له
Dialogue: 0,0:14:56.98,0:14:59.27,Default,,0000,0000,0000,,آسف يا كيمي-سان
Dialogue: 0,0:14:59.27,0:15:02.09,Default,,0000,0000,0000,,لم أكن أفكر برشد آنذاك
Dialogue: 0,0:15:02.09,0:15:03.76,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:15:04.10,0:15:12.71,Default,,0000,0000,0000,,وطأت فخّ السيّدة متقصّداً للتكفير عن خطيئتك في الماضي
Dialogue: 0,0:15:13.12,0:15:16.13,Default,,0000,0000,0000,,لا جدوى من التظاهر بالصلح الآن يا أبتاه
Dialogue: 0,0:15:16.62,0:15:22.13,Default,,0000,0000,0000,,لأنّه فارق هذا العالم رجلاً بريئاً لُفّقت له تهمة
Dialogue: 0,0:15:26.74,0:15:27.92,Default,,0000,0000,0000,,تاكايوشي-سان
Dialogue: 0,0:15:27.92,0:15:29.84,Default,,0000,0000,0000,,أ-أجل؟
Dialogue: 0,0:15:30.16,0:15:35.06,Default,,0000,0000,0000,,لا أملك حقّ قول هذا الآن
Dialogue: 0,0:15:35.06,0:15:37.84,Default,,0000,0000,0000,,لكن اعتن بيوكيكو رجاءً
Dialogue: 0,0:15:37.85,0:15:40.25,Default,,0000,0000,0000,,...نـ-نعم
Dialogue: 0,0:15:41.43,0:15:45.26,Default,,0000,0000,0000,,هكذا إذاً، كانت قاسيةً مع ابنتها
Dialogue: 0,0:15:45.55,0:15:49.42,Default,,0000,0000,0000,,كيلا تدرك علاقتهما
Dialogue: 0,0:15:51.13,0:15:52.42,Default,,0000,0000,0000,,!كودو
Dialogue: 0,0:15:51.83,0:15:52.42,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:15:52.42,0:15:53.48,Default,,0000,0000,0000,,!كودو
Dialogue: 0,0:15:53.48,0:15:54.80,Default,,0000,0000,0000,,!أأنت بخير يا شينتشي؟
Dialogue: 0,0:15:55.67,0:15:58.01,Default,,0000,0000,0000,,...أجل، إنّه زكامي فحسب
Dialogue: 0,0:15:58.46,0:16:03.07,Default,,0000,0000,0000,,لكن كيف عرفت تفاصيل هذه القضيّة؟
Dialogue: 0,0:16:03.07,0:16:05.17,Default,,0000,0000,0000,,...لا بدّ أنّك كنت تتجسس بالقرب
Dialogue: 0,0:16:05.66,0:16:10.05,Default,,0000,0000,0000,,أحمق، أخبرني ذاك الفتى ذو النظّارات على الهاتف
Dialogue: 0,0:16:10.56,0:16:11.77,Default,,0000,0000,0000,,تقصد كونان-كن؟
Dialogue: 0,0:16:11.77,0:16:12.46,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:12.94,0:16:17.27,Default,,0000,0000,0000,,قال أنّ هناك متحرّياً غريباً من أوساكا\N...وعليّ القدوم فوراً
Dialogue: 0,0:16:17.27,0:16:23.76,Default,,0000,0000,0000,,لـ-لـ-لذا أنهيتُ القضية التي كنت \N...أعمل عليها سريعاً وصعدتُ القطار
Dialogue: 0,0:16:23.76,0:16:25.26,Default,,0000,0000,0000,,!كاذب
Dialogue: 0,0:16:25.78,0:16:31.00,Default,,0000,0000,0000,,أخبرني هذا الشاب أنّ من الغريب\N!عدم سؤالك عن حالتي على الهاتف
Dialogue: 0,0:16:31.00,0:16:32.92,Default,,0000,0000,0000,,كنت بالقرب في الواقع، صحيح؟
Dialogue: 0,0:16:33.95,0:16:37.63,Default,,0000,0000,0000,,!أنا واثقة أنك كنت تراقبني وأنا قلقة وتضحك
Dialogue: 0,0:16:38.18,0:16:39.84,Default,,0000,0000,0000,,...مهلك، ران
Dialogue: 0,0:16:40.12,0:16:41.79,Default,,0000,0000,0000,,لمَ تفعل ذلك؟
Dialogue: 0,0:16:42.70,0:16:46.30,Default,,0000,0000,0000,,...أنا... أنا بهذا
Dialogue: 0,0:16:47.37,0:16:48.26,Default,,0000,0000,0000,,لا تستهيني بي
Dialogue: 0,0:16:50.65,0:16:52.25,Default,,0000,0000,0000,,أنا مُتحرٍّ
Dialogue: 0,0:16:53.03,0:16:55.21,Default,,0000,0000,0000,,يمكنني أن أعرف الكثير من صوتك فحسب
Dialogue: 0,0:16:58.83,0:17:02.43,Default,,0000,0000,0000,,!شينتشي! انتظر، سأستدعي الطبيب
Dialogue: 0,0:17:05.12,0:17:09.22,Default,,0000,0000,0000,,كان استنتاجي خاطئاً من البداية إذاً
Dialogue: 0,0:17:09.22,0:17:12.04,Default,,0000,0000,0000,,خسرتُ في كلّ جانب هذه المرّة
Dialogue: 0,0:17:12.25,0:17:13.96,Default,,0000,0000,0000,,أنتَ بارع يا كودو
Dialogue: 0,0:17:13.96,0:17:16.21,Default,,0000,0000,0000,,منطِقُك يفوقني بمستوى
Dialogue: 0,0:17:16.21,0:17:16.97,Default,,0000,0000,0000,,لا تكن أحمقاً
Dialogue: 0,0:17:17.25,0:17:21.92,Default,,0000,0000,0000,,...لا فوز ولا خسارة، ولا فوق ولا أسفل في المنطق
Dialogue: 0,0:17:23.83,0:17:30.11,Default,,0000,0000,0000,,ففي النهاية.. الحقيقة واحدة دوماً
Dialogue: 0,0:17:34.98,0:17:36.34,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:17:36.65,0:17:41.29,Default,,0000,0000,0000,,يبدو أنّي انشغلتُ بمنافستنا ففقدتُ رزانتي
Dialogue: 0,0:17:43.53,0:17:46.21,Default,,0000,0000,0000,,كودو! أأنت متأكد أنّه زكام فقط؟
Dialogue: 0,0:17:46.52,0:17:47.48,Default,,0000,0000,0000,,!كودو
Dialogue: 0,0:17:48.64,0:17:50.65,Default,,0000,0000,0000,,!كودو! أأنت بخير؟
Dialogue: 0,0:17:50.65,0:17:52.04,Default,,0000,0000,0000,,!طبيب، بسرعة
Dialogue: 0,0:17:53.90,0:17:55.26,Default,,0000,0000,0000,,...تـ-تبّاً
Dialogue: 0,0:17:55.26,0:17:56.28,Default,,0000,0000,0000,,!كودو، أنت
Dialogue: 0,0:17:56.46,0:17:58.67,Default,,0000,0000,0000,,!قلبي مُجدداً
Dialogue: 0,0:18:01.50,0:18:02.88,Default,,0000,0000,0000,,!أنا أحترق
Dialogue: 0,0:18:04.57,0:18:07.03,Default,,0000,0000,0000,,...كأنّ عظامي تذوب
Dialogue: 0,0:18:07.03,0:18:08.54,Default,,0000,0000,0000,,!كودو
Dialogue: 0,0:18:10.66,0:18:13.44,Default,,0000,0000,0000,,...أيمكن أنّي سأرجع
Dialogue: 0,0:18:13.44,0:18:15.62,Default,,0000,0000,0000,,!بعدما عدت لجسدي الطبيعي أخيراً
Dialogue: 0,0:18:16.19,0:18:20.58,Default,,0000,0000,0000,,!هل سأتحوّل لذاك الصبيّ... كونان مُجدداً؟
Dialogue: 0,0:18:22.30,0:18:23.62,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:18:24.13,0:18:24.84,Default,,0000,0000,0000,,!ر-ران
Dialogue: 0,0:18:24.84,0:18:27.59,Default,,0000,0000,0000,,!لا يصحّ بك الحركة
Dialogue: 0,0:18:27.59,0:18:28.46,Default,,0000,0000,0000,,!أنت مريض
Dialogue: 0,0:18:29.13,0:18:32.75,Default,,0000,0000,0000,,...هذا سيّئ، إذا تحوّلتُ لكونان الآن
Dialogue: 0,0:18:32.75,0:18:33.66,Default,,0000,0000,0000,,...ستكتشف
Dialogue: 0,0:18:35.55,0:18:36.49,Default,,0000,0000,0000,,ران هويّتي
Dialogue: 0,0:18:37.46,0:18:38.58,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:18:42.93,0:18:46.46,Default,,0000,0000,0000,,!هذا معطفه فحسب! شينتشي
Dialogue: 0,0:18:47.16,0:18:50.41,Default,,0000,0000,0000,,!أرجوك! لا ترجعني
Dialogue: 0,0:18:50.60,0:18:51.94,Default,,0000,0000,0000,,...دعني أخبر ران على الأقل
Dialogue: 0,0:18:51.94,0:18:53.33,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:18:53.57,0:18:54.83,Default,,0000,0000,0000,,...بفمي الحقيقي
Dialogue: 0,0:18:55.73,0:18:57.62,Default,,0000,0000,0000,,وصوتي الحقيقي
Dialogue: 0,0:18:58.28,0:19:02.12,Default,,0000,0000,0000,,!أمر أخير فحسب
Dialogue: 0,0:19:08.27,0:19:09.58,Default,,0000,0000,0000,,!شينتشي؟
Dialogue: 0,0:19:10.13,0:19:11.41,Default,,0000,0000,0000,,من هناك؟
Dialogue: 0,0:19:13.50,0:19:15.04,Default,,0000,0000,0000,,!شينتشي
Dialogue: 0,0:19:19.63,0:19:21.74,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:19:22.78,0:19:26.12,Default,,0000,0000,0000,,أين كنت؟ بحثت عنك! كما من أين لك هذا القميص؟
Dialogue: 0,0:19:26.12,0:19:28.53,Default,,0000,0000,0000,,كنتُ متعرّقاً بشدة
Dialogue: 0,0:19:28.53,0:19:30.16,Default,,0000,0000,0000,,فاستعرتُه من تلك الغرفة
Dialogue: 0,0:19:30.77,0:19:33.12,Default,,0000,0000,0000,,أخبرني، هل رأيت شينتشي؟
Dialogue: 0,0:19:33.89,0:19:37.79,Default,,0000,0000,0000,,قال شينتشي-نيتشان أنّه تذكر قضيّةً جديدة
Dialogue: 0,0:19:38.77,0:19:41.72,Default,,0000,0000,0000,,غيّر ثيابه وغادر من الباب الأمامي
Dialogue: 0,0:19:42.00,0:19:42.94,Default,,0000,0000,0000,,!ذاك الوغد
Dialogue: 0,0:19:43.19,0:19:51.92,Default,,0000,0000,0000,,كما قال عليكم ألّا تخبروا أحداً\N...بتدخله في هذه القضية
Dialogue: 0,0:19:54.00,0:19:56.58,Default,,0000,0000,0000,,!لـ-لحظة، كونان-كن
Dialogue: 0,0:19:57.29,0:19:58.75,Default,,0000,0000,0000,,!كونان-كن؟
Dialogue: 0,0:21:33.04,0:21:35.91,Default,,0000,0000,0000,,لازمتُ الفراش 3 أيام بعد ذلك
Dialogue: 0,0:21:36.28,0:21:39.04,Default,,0000,0000,0000,,وفي تلك الفترة رجع هاتّوري هيجي إلى أوساكا
Dialogue: 0,0:21:39.04,0:21:42.08,Default,,0000,0000,0000,,،وبفضل طلبي من ران قبل أن يُغمى علي
Dialogue: 0,0:21:42.08,0:21:46.00,Default,,0000,0000,0000,,لم يظهر اسم كودو شينتشي في الصحف بشأن القضيّة
Dialogue: 0,0:21:46.64,0:21:53.02,Default,,0000,0000,0000,,هكذا لن يكتشف الرجال ذوو الرداء الأسود\Nالذين قلّصوا جسدي أنّني حيّ
Dialogue: 0,0:21:54.92,0:21:58.51,Default,,0000,0000,0000,,لكن كيف رجعتُ لجسدي من المدرسة الثانوية؟
Dialogue: 0,0:21:58.51,0:22:03.70,Default,,0000,0000,0000,,...لحظة، وفقما أذكر... أتى ذاك الشخص، ثمّ
Dialogue: 0,0:22:03.70,0:22:08.29,Default,,0000,0000,0000,,!ثمّ شربتُ الساكي الذي جلبه
Dialogue: 0,0:22:14.20,0:22:15.16,Default,,0000,0000,0000,,!هذه هي
Dialogue: 0,0:22:15.53,0:22:17.03,Default,,0000,0000,0000,,!لا شكّ في الأمر
Dialogue: 0,0:22:17.03,0:22:19.46,Default,,0000,0000,0000,,!رجعتُ لطبيعتي بشربي لذاك الساكي
Dialogue: 0,0:22:21.10,0:22:23.24,Default,,0000,0000,0000,,حسنٌ، لا يزال هناك الكثير
Dialogue: 0,0:22:23.64,0:22:25.52,Default,,0000,0000,0000,,سببت جرعة واحدة ذلك
Dialogue: 0,0:22:25.52,0:22:28.52,Default,,0000,0000,0000,,!إذا شربتُ هذا كلّه سأعود لطبيعتي كليّاً
Dialogue: 0,0:22:29.64,0:22:30.37,Default,,0000,0000,0000,,!ولد
Dialogue: 0,0:22:31.84,0:22:34.01,Default,,0000,0000,0000,,!ما الذي تشربه يا كونان-كن؟
Dialogue: 0,0:22:34.68,0:22:37.59,Default,,0000,0000,0000,,!كما ظننت، ساكي
Dialogue: 0,0:22:39.04,0:22:43.71,Default,,0000,0000,0000,,لا يمكن للصغار شرب ساكي، تعرف ذلك
Dialogue: 0,0:22:43.71,0:22:46.50,Default,,0000,0000,0000,,حمقاء، أنا في السنة الثانية من الثانوية
Dialogue: 0,0:22:46.50,0:22:48.71,Default,,0000,0000,0000,,...لحظة، لا أزال قاصراً
Dialogue: 0,0:22:48.71,0:22:50.62,Default,,0000,0000,0000,,أسرع وغيّر ملابسك
Dialogue: 0,0:22:51.73,0:22:53.41,Default,,0000,0000,0000,,أتى أصدقاؤك
Dialogue: 0,0:22:55.08,0:22:56.40,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:22:56.40,0:22:57.57,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:22:57.57,0:22:58.66,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:22:58.66,0:23:01.03,Default,,0000,0000,0000,,...أنتم مجدداً
Dialogue: 0,0:23:01.15,0:23:02.98,Default,,0000,0000,0000,,!شعرنا بالقلق
Dialogue: 0,0:23:02.98,0:23:05.50,Default,,0000,0000,0000,,مرضتَ بالزكام لثلاثة أيام
Dialogue: 0,0:23:05.50,0:23:08.81,Default,,0000,0000,0000,,يا لحظّك بتغيّبك عن المدرسة
Dialogue: 0,0:23:08.81,0:23:10.01,Default,,0000,0000,0000,,ربما سأُصاب بالزكام بدوري
Dialogue: 0,0:23:10.01,0:23:12.55,Default,,0000,0000,0000,,يستحيل أن يصيبك الزكام يا غينتا-كن
Dialogue: 0,0:23:12.55,0:23:13.55,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:23:13.55,0:23:16.08,Default,,0000,0000,0000,,..."ألا تعرف مقولة "لا يُصيب الأغبياء الزكام
Dialogue: 0,0:23:16.08,0:23:19.29,Default,,0000,0000,0000,,!من الرائع أنّك عدت لطبيعتك
Dialogue: 0,0:23:19.29,0:23:22.91,Default,,0000,0000,0000,,...أجل، رجعت لطبيعتي
Dialogue: 0,0:23:23.96,0:23:26.88,Default,,0000,0000,0000,,أخبروني، لمَ علينا الذهاب للمكتبة الآن؟
Dialogue: 0,0:23:26.88,0:23:32.74,Default,,0000,0000,0000,,أنت الوحيد الذي لم يسلّم\N!تقرير كتاب في الفصل
Dialogue: 0,0:23:32.74,0:23:36.37,Default,,0000,0000,0000,,لذا فكّرنا بمساعدتك، صحيح؟
Dialogue: 0,0:23:36.37,0:23:37.33,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:23:36.37,0:23:37.33,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:23:38.03,0:23:43.86,Default,,0000,0000,0000,,قد يكون هذا هو الحال مع أيومي، ولكن ماذا\Nعن غينتا وميتسوهيكو؟
Dialogue: 0,0:23:43.86,0:23:46.04,Default,,0000,0000,0000,,لكن ربما سأرافقهم
Dialogue: 0,0:23:47.08,0:23:50.43,Default,,0000,0000,0000,,بعدما أشرب ذاك الساكي وأرجع\Nطالباً في المدرسة الثانوية
Dialogue: 0,0:23:50.43,0:23:57.33,Default,,0000,0000,0000,,قد لن أستطيع التسكّع معهم هكذا مُجدداً
Dialogue: 0,0:24:00.21,0:24:03.79,Default,,0000,0000,0000,,في الواقع، تامادا-سان مفقود منذ ليلتين
Dialogue: 0,0:24:09.70,0:24:11.91,Default,,0000,0000,0000,,!حـ-حمقى! لا تشعلوا الأنوار
Dialogue: 0,0:24:21.67,0:24:23.95,Default,,0000,0000,0000,,!وجدتُه! مكان إخفاء الجثّة
Dialogue: 0,0:24:24.48,0:24:25.90,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.90,0:24:27.89,Default,,0000,0000,0000,,جريمة قتل المكتبة
Dialogue: 0,0:24:45.46,0:24:47.63,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.63,0:24:50.10,Default,,0000,0000,0000,,كتاب بغلاف مجلّد
Dialogue: 0,0:24:50.41,0:24:52.45,Default,,0000,0000,0000,,الحلقة القادمة، أهي القضيّة الأخيرة لكونان؟
Dialogue: 0,0:24:52.45,0:24:54.89,Default,,0000,0000,0000,,!فرقة فتيان التحرّي منيعة

