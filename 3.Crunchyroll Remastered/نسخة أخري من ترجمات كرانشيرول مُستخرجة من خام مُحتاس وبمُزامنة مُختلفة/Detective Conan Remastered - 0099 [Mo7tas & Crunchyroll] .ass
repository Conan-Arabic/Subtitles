Dialogue: 0,0:00:00.67,0:00:04.55,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والقضايا تلفّها طبقات أكثر حتّى
Dialogue: 0,0:00:04.55,0:00:06.88,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.88,0:00:08.55,Default,,0000,0000,0000,,!اليوم جزء الختام لقضيّة الفخّاري
Dialogue: 0,0:00:08.55,0:00:10.54,Default,,0000,0000,0000,,!لا تصدّعات هناك في استنتاج كونان
Dialogue: 0,0:00:10.54,0:00:12.42,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.42,0:00:14.21,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.21,0:00:15.96,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.63,0:00:24.09,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.09,0:00:31.13,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.85,0:00:39.26,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.26,0:00:46.76,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.76,0:00:59.21,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.09,0:01:06.51,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.47,0:01:13.35,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.35,0:01:19.76,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.76,0:01:26.24,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:52.07,0:01:55.36,Default,,0000,0000,0000,,قام كيكويمون-سان، الفخّاري الشهير\N،والمعروف بالكنز الوطنيّ الحيّ
Dialogue: 0,0:01:55.86,0:01:59.28,Default,,0000,0000,0000,,بدعوتي أنا وران والعمّ إلى منزله في تاما الغربية
Dialogue: 0,0:02:01.03,0:02:02.74,Default,,0000,0000,0000,,لم يمض وقتٌ طويل حتّى وقعت حادثة
Dialogue: 0,0:02:03.64,0:02:09.24,Default,,0000,0000,0000,,كسرت ماسوكو-سان آخر أعمال كيكويمون-سان\Nالمعروف بفوسوي مارو في المستودع
Dialogue: 0,0:02:09.91,0:02:13.87,Default,,0000,0000,0000,,في تلك الليلة، ثملت ماسوكو-سان بشدّة أثناء حفلة
Dialogue: 0,0:02:14.78,0:02:18.01,Default,,0000,0000,0000,,...وفي الصباح التالي، في المستودع
Dialogue: 0,0:02:20.32,0:02:22.97,Default,,0000,0000,0000,,!وجدناها مشنوقةً
Dialogue: 0,0:02:24.03,0:02:29.98,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل الفخّاري الشهير\N(الجزء الثاني)
Dialogue: 0,0:02:24.36,0:02:28.24,Default,,0000,0000,0000,,جريمة قتل الفخّاري الشهير\N(الجزء الثاني)
Dialogue: 0,0:02:31.20,0:02:35.19,Default,,0000,0000,0000,,أكنتم جميعاً في غرفة المعيشة حقّاً؟
Dialogue: 0,0:02:35.19,0:02:40.07,Default,,0000,0000,0000,,أ-أجل، من غادر كان أوتاني فحسب\Nالذي ذهب لإيقاظها
Dialogue: 0,0:02:40.07,0:02:40.96,Default,,0000,0000,0000,,أليس كذلك؟
Dialogue: 0,0:02:41.66,0:02:46.24,Default,,0000,0000,0000,,أيمكن أنّك تظاهرت بالذهاب لإنقاذها\Nوشنقتها في نومها؟
Dialogue: 0,0:02:46.24,0:02:49.33,Default,,0000,0000,0000,,!لـ-لا! غبتُ للحظةً فقط
Dialogue: 0,0:02:49.74,0:02:53.45,Default,,0000,0000,0000,,!تبعد غرفتها بغرفتين عن غرفة المعيشة فحسب
Dialogue: 0,0:02:54.32,0:02:55.58,Default,,0000,0000,0000,,أهذا صحيح؟
Dialogue: 0,0:02:55.58,0:02:56.57,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:56.57,0:02:58.80,Default,,0000,0000,0000,,أظنّه غاب لأقلّ من 10 ثوانٍ
Dialogue: 0,0:02:59.82,0:03:03.01,Default,,0000,0000,0000,,يستحيل أنّه قام بشيء\Nفي ذاك الوقت الوجيز
Dialogue: 0,0:03:03.53,0:03:04.74,Default,,0000,0000,0000,,أغادر أحدٌ آخر؟
Dialogue: 0,0:03:04.74,0:03:07.48,Default,,0000,0000,0000,,غادرتُ قليلاً للاتّصال بها
Dialogue: 0,0:03:08.07,0:03:10.74,Default,,0000,0000,0000,,ظننا أنّها قد خرجت
Dialogue: 0,0:03:10.74,0:03:12.41,Default,,0000,0000,0000,,،لكنّي لم أغادر حقّاً
Dialogue: 0,0:03:12.41,0:03:17.49,Default,,0000,0000,0000,,فقد اتّصلتُ بهاتفها الخلويّ من الهاتف\Nفي الرواق أمام غرفة المعيشة
Dialogue: 0,0:03:18.91,0:03:21.53,Default,,0000,0000,0000,,غريب، إنّها لا تجيب
Dialogue: 0,0:03:21.82,0:03:24.45,Default,,0000,0000,0000,,هاتفها الخلويّ؟ لديها واحد؟
Dialogue: 0,0:03:24.82,0:03:30.67,Default,,0000,0000,0000,,أجل، طلبتُ من ماسوكو-سان حمل\Nهاتف خلويّ دوماً
Dialogue: 0,0:03:30.67,0:03:33.91,Default,,0000,0000,0000,,فقد كانت تتولّى كلّ المسؤوليات الأخرى
Dialogue: 0,0:03:33.91,0:03:37.71,Default,,0000,0000,0000,,بحيث نستطيع التركيز على صنع أعمالنا
Dialogue: 0,0:03:37.71,0:03:39.42,Default,,0000,0000,0000,,المسؤوليات الأخرى؟
Dialogue: 0,0:03:39.74,0:03:42.45,Default,,0000,0000,0000,,مثل عمليات بيع القطع\Nوجدولة المعارض
Dialogue: 0,0:03:42.45,0:03:45.76,Default,,0000,0000,0000,,لذا كان معلّمنا لا يغادر معظم الوقت
Dialogue: 0,0:03:45.76,0:03:51.73,Default,,0000,0000,0000,,لكنّ ذلك غريب، لم نجد هاتفاً خلويّاً بجوار جثّتها
Dialogue: 0,0:03:51.73,0:03:56.82,Default,,0000,0000,0000,,بخصوص الهاتف الخلويّ، فقد وجدناه في غرفة الضحيّة
Dialogue: 0,0:03:56.82,0:04:00.61,Default,,0000,0000,0000,,...حسناً، كان تحت فراشها وفقما يبدو
Dialogue: 0,0:04:00.61,0:04:01.74,Default,,0000,0000,0000,,تحت فراشها؟
Dialogue: 0,0:04:04.53,0:04:09.50,Default,,0000,0000,0000,,كانت تضعه تحت وسادتها دوماً\Nوتستعمله كساعة تنبيه
Dialogue: 0,0:04:09.50,0:04:12.96,Default,,0000,0000,0000,,يبدو أنّ الهاتف الخلويّ كان مُطفأً
Dialogue: 0,0:04:13.36,0:04:19.09,Default,,0000,0000,0000,,فهمت، لذا لم يصدر صوت رغم أنّ\Nالاتّصال أُجري بالقرب
Dialogue: 0,0:04:20.91,0:04:23.57,Default,,0000,0000,0000,,إذاً، أغادر شخصٌ آخر الغرفة؟
Dialogue: 0,0:04:23.57,0:04:25.58,Default,,0000,0000,0000,,...كلا، لا أظنّ
Dialogue: 0,0:04:25.58,0:04:26.60,Default,,0000,0000,0000,,...لم يغادر
Dialogue: 0,0:04:26.60,0:04:27.76,Default,,0000,0000,0000,,أيّ أحد
Dialogue: 0,0:04:28.07,0:04:33.53,Default,,0000,0000,0000,,من حملها إلى المستودع وقتلها إذاً؟
Dialogue: 0,0:04:33.53,0:04:36.23,Default,,0000,0000,0000,,بافتراض أنّ العثور على الجثّة كان\N،بعد تعرّضها للشنق مباشرةً
Dialogue: 0,0:04:36.70,0:04:39.69,Default,,0000,0000,0000,,حيث كان الجميع في غرفة المعيشة\Nولديهم حجج غياب
Dialogue: 0,0:04:39.69,0:04:42.65,Default,,0000,0000,0000,,!لذا أخبرتك أنّه انتحار! انتحار
Dialogue: 0,0:04:43.41,0:04:49.24,Default,,0000,0000,0000,,كانت قدما السيّدة حافيتين لأنّها\Nكانت متضايقةً وعلى وشك قتل نفسها
Dialogue: 0,0:04:49.24,0:04:52.20,Default,,0000,0000,0000,,ولم تتسّخ قدماها لأنّها استعملت المواطئ الحجرية
Dialogue: 0,0:04:52.20,0:04:55.38,Default,,0000,0000,0000,,بين المنزل والمستودع على الأرجح
Dialogue: 0,0:04:55.38,0:05:00.05,Default,,0000,0000,0000,,كما أنّها كسرت فوسوي مارو في هذا المستودع
Dialogue: 0,0:05:00.57,0:05:04.57,Default,,0000,0000,0000,,أستطيّع تصوّر استيقاظها صباحاً وتوجّهها للمستودع
Dialogue: 0,0:05:04.57,0:05:07.01,Default,,0000,0000,0000,,والنظر فيه بلا تفكير
Dialogue: 0,0:05:07.01,0:05:13.74,Default,,0000,0000,0000,,معك حقّ، كنّا نستعمل ذاك الحبل\Nفي المستودع لربط الأشياء
Dialogue: 0,0:05:13.74,0:05:17.48,Default,,0000,0000,0000,,كما أنّنا سمعنا صوت تحطّم الإناء\Nفي الوقت نفسه جميعاً
Dialogue: 0,0:05:18.41,0:05:21.41,Default,,0000,0000,0000,,بأيّ حال، لن نحقّق أيّ تقدّم
Dialogue: 0,0:05:21.41,0:05:24.28,Default,,0000,0000,0000,,حتّى نفحص المستودع بدقّة أكثر
Dialogue: 0,0:05:24.28,0:05:27.95,Default,,0000,0000,0000,,أطلب منكم الانتظار في غرفة المعيشة لبعض الوقت
Dialogue: 0,0:05:28.30,0:05:31.22,Default,,0000,0000,0000,,ولا تقدموا على أيّ تصرّف بلا إذن رجاءً
Dialogue: 0,0:05:33.26,0:05:37.13,Default,,0000,0000,0000,,انتحار؟ أكان كذلك حقّاً؟
Dialogue: 0,0:05:38.51,0:05:40.85,Default,,0000,0000,0000,,...لكن هناك أشياء كثيرة غريبة
Dialogue: 0,0:05:42.01,0:05:45.59,Default,,0000,0000,0000,,...الجرح المفتوح على ساقها اليمنى
Dialogue: 0,0:05:45.59,0:05:50.42,Default,,0000,0000,0000,,وتصرّفها الغريب بعدم انتعال شيء\Nوبقاء أخمصيّ قدميها نظيفين
Dialogue: 0,0:05:50.42,0:05:51.42,Default,,0000,0000,0000,,...كما
Dialogue: 0,0:05:53.26,0:05:59.09,Default,,0000,0000,0000,,الكرة الرخامية التي وجدتُها بجوار\N...فوسوي مارو المكسور في اليوم السابق
Dialogue: 0,0:05:59.09,0:06:00.62,Default,,0000,0000,0000,,وما ذاك الشيء؟
Dialogue: 0,0:06:01.30,0:06:05.26,Default,,0000,0000,0000,,...هناك ما أثار حيرتي عندما رأيته في مسرح الجريمة
Dialogue: 0,0:06:05.26,0:06:06.17,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:06:07.51,0:06:09.46,Default,,0000,0000,0000,,ماذا؟ كرّة رخامية فحسب
Dialogue: 0,0:06:09.46,0:06:12.55,Default,,0000,0000,0000,,لا يهتمّ بهذه الأشياء إلّا الأطفال
Dialogue: 0,0:06:14.68,0:06:15.56,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:06:17.14,0:06:19.60,Default,,0000,0000,0000,,ما الذي تفعله يا عمّ؟
Dialogue: 0,0:06:27.67,0:06:28.96,Default,,0000,0000,0000,,...ماذا؟ ما الذي
Dialogue: 0,0:06:28.96,0:06:33.17,Default,,0000,0000,0000,,!تمهّل يا كونان-كن، من أين تدخل؟ توقّف
Dialogue: 0,0:06:33.17,0:06:35.30,Default,,0000,0000,0000,,ما ذلك؟
Dialogue: 0,0:06:36.87,0:06:39.01,Default,,0000,0000,0000,,أحمر شفاه؟
Dialogue: 0,0:06:39.01,0:06:41.13,Default,,0000,0000,0000,,...لم أكن من وضعته
Dialogue: 0,0:06:43.59,0:06:45.95,Default,,0000,0000,0000,,لمَ يوجد أحمر شفاه هنا؟
Dialogue: 0,0:06:47.71,0:06:48.92,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:06:48.92,0:06:49.84,Default,,0000,0000,0000,,!تـ-تمهّل
Dialogue: 0,0:06:50.32,0:06:51.84,Default,,0000,0000,0000,,!أ-أنت! ماذا تفعل؟
Dialogue: 0,0:06:51.84,0:06:53.64,Default,,0000,0000,0000,,أين تذهب يا كونان-كن؟
Dialogue: 0,0:06:54.05,0:06:56.26,Default,,0000,0000,0000,,...ما كان يحيّرني
Dialogue: 0,0:06:58.68,0:06:59.79,Default,,0000,0000,0000,,...أيمكن أنّه
Dialogue: 0,0:07:02.59,0:07:03.91,Default,,0000,0000,0000,,ماذا؟ ما الأمر؟
Dialogue: 0,0:07:03.91,0:07:05.38,Default,,0000,0000,0000,,نسيتُ شيئاً
Dialogue: 0,0:07:05.38,0:07:08.09,Default,,0000,0000,0000,,ولو فعلت، لكن لا يمكنك الدخول هكذا
Dialogue: 0,0:07:08.09,0:07:09.96,Default,,0000,0000,0000,,ماذا؟ أين جثّة العمّة؟
Dialogue: 0,0:07:09.96,0:07:11.99,Default,,0000,0000,0000,,نقلناها لمشفى الشرطة
Dialogue: 0,0:07:15.59,0:07:18.03,Default,,0000,0000,0000,,!وجدتُها! هذه هي
Dialogue: 0,0:07:18.70,0:07:23.54,Default,,0000,0000,0000,,وجدت الأثر الذي فشل القاتل\N!في إخفائه أخيراً
Dialogue: 0,0:07:23.76,0:07:27.50,Default,,0000,0000,0000,,...وجوده هنا يعني أنّ في الأعلى
Dialogue: 0,0:07:31.59,0:07:33.64,Default,,0000,0000,0000,,كما ظننت
Dialogue: 0,0:07:33.93,0:07:39.05,Default,,0000,0000,0000,,باستعمال هذه الطريقة، يمكن ارتكاب الجريمة\N!دون الحاجة للتواجد في الغرفة حتّى
Dialogue: 0,0:07:41.26,0:07:47.56,Default,,0000,0000,0000,,لكن للتيقّن من نجاح الجريمة، لا بدّ من\N...تواجد ذاك الشيء بالقرب
Dialogue: 0,0:07:48.13,0:07:49.13,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:07:52.55,0:07:55.74,Default,,0000,0000,0000,,!أ-أنت! ما الذي تفعله؟ انزل
Dialogue: 0,0:07:55.74,0:07:59.05,Default,,0000,0000,0000,,!أخبرتكم أنّي أبحث عن شيءٍ نسيته
Dialogue: 0,0:07:59.05,0:08:02.92,Default,,0000,0000,0000,,تفقّدنا ذاك المكان للتوّ ولم\N!نجد شيئاً خارج المألوف
Dialogue: 0,0:08:02.92,0:08:04.71,Default,,0000,0000,0000,,!ما تفعله خطر، فانزل
Dialogue: 0,0:08:05.09,0:08:08.63,Default,,0000,0000,0000,,بالفعل، لا يبدو أنّ هناك شيئاً باستثناء الفخّاريات
Dialogue: 0,0:08:16.84,0:08:20.59,Default,,0000,0000,0000,,فهمت، كما تتوقّع من فخّاري
Dialogue: 0,0:08:21.56,0:08:23.02,Default,,0000,0000,0000,,!انزل بسرعة
Dialogue: 0,0:08:23.02,0:08:24.26,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:08:24.62,0:08:28.68,Default,,0000,0000,0000,,...ما يعني... أنّ المجرم بين ذلكما الاثنين فحسب
Dialogue: 0,0:08:29.90,0:08:31.31,Default,,0000,0000,0000,,وهو ذاك غالباً
Dialogue: 0,0:08:32.26,0:08:36.32,Default,,0000,0000,0000,,...نصب فخّاً للسيّدة وقتلها بحيث يبدو انتحاراً
Dialogue: 0,0:08:36.59,0:08:39.62,Default,,0000,0000,0000,,...كما من لا يزال يحمل الدليل عليه
Dialogue: 0,0:08:41.12,0:08:42.88,Default,,0000,0000,0000,,!لا أحد غيره
Dialogue: 0,0:08:48.59,0:08:51.54,Default,,0000,0000,0000,,!حسنٌ، اكتشفت القاتل وحيلته
Dialogue: 0,0:08:51.54,0:08:55.26,Default,,0000,0000,0000,,...ما تبقّى هو كيفيّة إخبار المفتّش ميغوري بذلك
Dialogue: 0,0:08:55.26,0:08:59.80,Default,,0000,0000,0000,,المعذرة، إلى متى علينا البقاء في غرفة المعيشة؟
Dialogue: 0,0:09:01.07,0:09:04.43,Default,,0000,0000,0000,,آسف، سنبقى هنا لفترة أطول
Dialogue: 0,0:09:04.43,0:09:08.67,Default,,0000,0000,0000,,أيمكننا الذهاب لجلب طعام؟ فلم نأكل شيئاً منذ الصباح
Dialogue: 0,0:09:08.67,0:09:10.40,Default,,0000,0000,0000,,أودّ تغيير ثيابي أيضاً
Dialogue: 0,0:09:10.71,0:09:14.59,Default,,0000,0000,0000,,لا أمانع ذلك، طالما تخبرون رجالي أوّلاً
Dialogue: 0,0:09:14.59,0:09:18.59,Default,,0000,0000,0000,,!لا يصحّ! إذا سمحت بذلك فسيختفي الدليل
Dialogue: 0,0:09:18.59,0:09:19.32,Default,,0000,0000,0000,,الدليل؟
Dialogue: 0,0:09:20.26,0:09:22.66,Default,,0000,0000,0000,,!اخرس أيّها الصبيّ
Dialogue: 0,0:09:22.66,0:09:23.55,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:09:23.55,0:09:28.75,Default,,0000,0000,0000,,!أيّ دليل؟ كان هذا انتحاراً\N!لا قاتل هناك
Dialogue: 0,0:09:29.26,0:09:31.17,Default,,0000,0000,0000,,ألستُ محقّاً يا حضرة المفتّش؟
Dialogue: 0,0:09:31.17,0:09:32.71,Default,,0000,0000,0000,,...بـ-بلى
Dialogue: 0,0:09:32.71,0:09:34.38,Default,,0000,0000,0000,,...مؤلم
Dialogue: 0,0:09:34.38,0:09:37.51,Default,,0000,0000,0000,,ليس بيدي سوى تنويم العمّ\N...بمسدّس ساعتي بالفعل
Dialogue: 0,0:09:38.97,0:09:43.42,Default,,0000,0000,0000,,اسمع، وجدتُ الشيء الذي كنت\N!تتكلّم عنه يا عمّ
Dialogue: 0,0:09:43.42,0:09:45.01,Default,,0000,0000,0000,,ماذا؟ أيّ شيء؟
Dialogue: 0,0:09:45.01,0:09:48.71,Default,,0000,0000,0000,,لا تهتمّ إذا أفصحت عنه أمام الجميع؟
Dialogue: 0,0:09:48.71,0:09:49.76,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:09:49.76,0:09:50.94,Default,,0000,0000,0000,,أعطني أذنك
Dialogue: 0,0:09:50.94,0:09:55.30,Default,,0000,0000,0000,,...كما قلت، الشيء الذي أخبرتني به
Dialogue: 0,0:10:02.63,0:10:07.30,Default,,0000,0000,0000,,حسنٌ، ألصق مكبّر الصوت الشبيه\N...بالزرّ على ياقته
Dialogue: 0,0:10:07.30,0:10:10.62,Default,,0000,0000,0000,,!رائع! وجدت ذاك الشيء إذاً؟ أحسنت
Dialogue: 0,0:10:12.71,0:10:16.80,Default,,0000,0000,0000,,لحظة، ما الذي وجده؟
Dialogue: 0,0:10:16.80,0:10:20.88,Default,,0000,0000,0000,,الدليل الذي فشل القاتل\Nفي إخفائه بالطبع
Dialogue: 0,0:10:20.88,0:10:23.18,Default,,0000,0000,0000,,...الـ-القاتل؟! أتقصد
Dialogue: 0,0:10:23.18,0:10:27.60,Default,,0000,0000,0000,,أجل، لم تنتحر السيّدة، بل قُتلت
Dialogue: 0,0:10:27.92,0:10:30.80,Default,,0000,0000,0000,,من قِبل أحد موجود هنا في الواقع
Dialogue: 0,0:10:33.38,0:10:36.38,Default,,0000,0000,0000,,!سيكون هذا مثيراً
Dialogue: 0,0:10:36.38,0:10:41.28,Default,,0000,0000,0000,,!من المُشرّف مشاهدة تحليل كوغورو النائم بأمّ عيني
Dialogue: 0,0:10:41.28,0:10:45.17,Default,,0000,0000,0000,,موري-كن، إذا وُجدت الجثّة بعد موتها فوراً
Dialogue: 0,0:10:45.17,0:10:47.96,Default,,0000,0000,0000,,فيستحيل أنّ أحدهم أقدم على قتلها
Dialogue: 0,0:10:47.96,0:10:50.87,Default,,0000,0000,0000,,كما أنّك من كان مصرّاً\N!على أنّه كان انتحاراً
Dialogue: 0,0:10:51.09,0:10:54.13,Default,,0000,0000,0000,,كانت كذبةً لجعل القاتل يستهتر
Dialogue: 0,0:10:54.13,0:10:58.34,Default,,0000,0000,0000,,لأنّنا لا نريد أن يتخلّص من الدليل
Dialogue: 0,0:10:58.34,0:11:01.26,Default,,0000,0000,0000,,كما قلت، أيّ دليلٍ هذا؟
Dialogue: 0,0:11:01.88,0:11:03.22,Default,,0000,0000,0000,,!الدم يا حضرة المفتّش
Dialogue: 0,0:11:03.22,0:11:04.18,Default,,0000,0000,0000,,الدم
Dialogue: 0,0:11:04.18,0:11:10.14,Default,,0000,0000,0000,,أجل، طلب منّي العمّ البحث عن بقعة\Nدم غريبة على الأرض
Dialogue: 0,0:11:10.42,0:11:11.85,Default,,0000,0000,0000,,بقعة دم غريبة؟
Dialogue: 0,0:11:11.85,0:11:14.82,Default,,0000,0000,0000,,انظر، لا بدّ أنّه كان يقصد هذه البقعة
Dialogue: 0,0:11:18.61,0:11:20.57,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:11:21.17,0:11:23.78,Default,,0000,0000,0000,,أنتما من حملا الجثّة إلى هنا، صحيح؟
Dialogue: 0,0:11:23.78,0:11:26.70,Default,,0000,0000,0000,,أجل، ظننا أنّها قد لا تزال حيّة
Dialogue: 0,0:11:27.42,0:11:30.54,Default,,0000,0000,0000,,فحملتُها من ذراعيها، بينما حمل سيتو ساقيها
Dialogue: 0,0:11:30.54,0:11:32.76,Default,,0000,0000,0000,,وأنزلناها عند الزاوية
Dialogue: 0,0:11:32.76,0:11:33.59,Default,,0000,0000,0000,,أليس كذلك؟
Dialogue: 0,0:11:33.59,0:11:34.21,Default,,0000,0000,0000,,بلى
Dialogue: 0,0:11:35.51,0:11:38.67,Default,,0000,0000,0000,,في تلك الحالة، فهذا غريبٌ بالفعل
Dialogue: 0,0:11:38.67,0:11:40.76,Default,,0000,0000,0000,,أهناك أمرٌ ما بذاك الدم؟
Dialogue: 0,0:11:40.76,0:11:45.64,Default,,0000,0000,0000,,...أظنّه دماً تساقط أثناء حملنا للجثّة
Dialogue: 0,0:11:45.96,0:11:49.56,Default,,0000,0000,0000,,كلا، ليس كلّه دماً من حملكما لها
Dialogue: 0,0:11:51.09,0:11:54.09,Default,,0000,0000,0000,,تصعب الملاحظة بما أنّه محاط بدمّ آخر
Dialogue: 0,0:11:54.09,0:11:55.52,Default,,0000,0000,0000,,لكن يوجد شيءٌ آخر هنا
Dialogue: 0,0:11:55.52,0:11:57.48,Default,,0000,0000,0000,,شـ-شيء آخر؟
Dialogue: 0,0:11:57.84,0:12:00.84,Default,,0000,0000,0000,,الشكل الذي تتركه قطرات دم الإنسان\Nعند سقوطها على الأرض
Dialogue: 0,0:12:00.84,0:12:05.05,Default,,0000,0000,0000,,يعتمد على الارتفاع الذي تسقط منه غالباً
Dialogue: 0,0:12:05.05,0:12:07.88,Default,,0000,0000,0000,,،كلّما سقطت من ارتفاع أعلى، توسّعت الدائرة
Dialogue: 0,0:12:07.88,0:12:11.08,Default,,0000,0000,0000,,كما شدّة التلطّخ حولها
Dialogue: 0,0:12:11.08,0:12:14.13,Default,,0000,0000,0000,,،إذا حملتماها من ذراعيها وساقيها
Dialogue: 0,0:12:14.13,0:12:17.54,Default,,0000,0000,0000,,فستكون المسافة من أظفار أقدامها\Nللأرض 50 سم بأبعد الحدود
Dialogue: 0,0:12:17.84,0:12:23.46,Default,,0000,0000,0000,,لكنّ بقعة الدم هذه سقطت\Nمن ارتفاع يعلو متراً بكلّ وضوح
Dialogue: 0,0:12:23.63,0:12:26.63,Default,,0000,0000,0000,,...وجودها هنا يعني
Dialogue: 0,0:12:26.63,0:12:30.18,Default,,0000,0000,0000,,أتقصد أنّها كانت فوق هذا الرفّ؟
Dialogue: 0,0:12:30.46,0:12:32.67,Default,,0000,0000,0000,,لكن لمَ؟
Dialogue: 0,0:12:32.67,0:12:33.89,Default,,0000,0000,0000,,!أيمكن؟
Dialogue: 0,0:12:34.07,0:12:41.47,Default,,0000,0000,0000,,أجل، حملها القاتل لأعلى الرفّ\N...في غطاء الليل البارحة
Dialogue: 0,0:12:42.26,0:12:48.30,Default,,0000,0000,0000,,حيث نامت وحبلٌ مربوط حول عنقها\Nمتّصل بعارضة السقف
Dialogue: 0,0:12:48.30,0:12:52.46,Default,,0000,0000,0000,,بهذا الشكل، عندما تستيقظ صباحاً، ستفقد توازنها
Dialogue: 0,0:12:52.46,0:12:57.92,Default,,0000,0000,0000,,وتُشنق بمجرّد سقوطها من الرفّ آلياً
Dialogue: 0,0:12:57.92,0:13:01.38,Default,,0000,0000,0000,,،الصوت المرتفع الذي أصدرته بعد شنقها بقليل
Dialogue: 0,0:13:01.38,0:13:07.05,Default,,0000,0000,0000,,كان من الأواني الموضوعة أسفل\Nأنشوطة الحبل تماماً
Dialogue: 0,0:13:07.05,0:13:12.21,Default,,0000,0000,0000,,التعرّض للشنق من ذاك الارتفاع سيؤدي\Nللموت الفوريّ تقريباً
Dialogue: 0,0:13:12.21,0:13:19.95,Default,,0000,0000,0000,,ستبدو الأواني المحطّمة عندها \Nمجرّد مواطئ أقدام أطاحت بها
Dialogue: 0,0:13:20.43,0:13:24.17,Default,,0000,0000,0000,,كان الهدف من هذا تعجيل\Nالعثور على الجثّة بالطبع
Dialogue: 0,0:13:24.17,0:13:28.57,Default,,0000,0000,0000,,وتثبيت حجّة القاتل في غرفة المعيشة
Dialogue: 0,0:13:28.57,0:13:32.20,Default,,0000,0000,0000,,ماذا عن الجرح على ربلتها اليمنى أيضاً؟
Dialogue: 0,0:13:32.43,0:13:37.42,Default,,0000,0000,0000,,،أمعنوا النظر لأعلى الرفّ رجاءً\Nألا تجدون مسماراً بارزاً؟
Dialogue: 0,0:13:37.42,0:13:39.17,Default,,0000,0000,0000,,بلى، صحيح
Dialogue: 0,0:13:39.42,0:13:47.38,Default,,0000,0000,0000,,،عندما فقدت توازنها وسقطت\Nجرح ذاك المسمار ربلتها غالباً
Dialogue: 0,0:13:47.38,0:13:50.01,Default,,0000,0000,0000,,سقوط الدمّ على موقع مختلف على الأرض
Dialogue: 0,0:13:50.01,0:13:53.51,Default,,0000,0000,0000,,هو لتمسّكها بالرفّ لبضعة ثوانٍ على الأرجح
Dialogue: 0,0:13:53.51,0:13:57.92,Default,,0000,0000,0000,,أي أنّ الجرح كان بالمصادفة؟
Dialogue: 0,0:13:57.92,0:14:02.02,Default,,0000,0000,0000,,أجل، لم يكن في حسابات القاتل
Dialogue: 0,0:14:02.38,0:14:06.48,Default,,0000,0000,0000,,صعقته الدهشة عندما رآه غالباً
Dialogue: 0,0:14:07.52,0:14:11.76,Default,,0000,0000,0000,,لكنّ القاتل كان ليدرك سببه فوراً
Dialogue: 0,0:14:11.76,0:14:14.20,Default,,0000,0000,0000,,كما الدمّ بجوار الرفّ
Dialogue: 0,0:14:14.59,0:14:20.79,Default,,0000,0000,0000,,حتّى لو ترنّحت الجثّة، وتناثر الدم في المكان\Nفيبقى الرفّ بعيداً جدّاً
Dialogue: 0,0:14:21.38,0:14:26.67,Default,,0000,0000,0000,,خشي القاتل أن تُكتشف حيلته\N،إذا اُكتشفت بقعة الدمّ هذه
Dialogue: 0,0:14:26.67,0:14:32.96,Default,,0000,0000,0000,,فموّه على الجميع، وجعل الجثّة\Nتُنقل لمكان البقعة
Dialogue: 0,0:14:32.96,0:14:35.55,Default,,0000,0000,0000,,لإخفاء الدمّ بدم آخر
Dialogue: 0,0:14:35.55,0:14:40.55,Default,,0000,0000,0000,,ألستُ محقّاً، يا من غادر\N،أثناء حفلة البارحة
Dialogue: 0,0:14:40.55,0:14:45.11,Default,,0000,0000,0000,,...لحمل السيّدة للمخزن ونصب هذه الحيلة
Dialogue: 0,0:14:46.05,0:14:48.07,Default,,0000,0000,0000,,يا سيتو ريويتشي-سان؟
Dialogue: 0,0:14:49.65,0:14:54.62,Default,,0000,0000,0000,,...سـ-سيتو؟ أيمكن أنّك
Dialogue: 0,0:14:55.38,0:14:59.08,Default,,0000,0000,0000,,انتظر قليلاً! لم أكن الوحيد الذي\N!غادر أثناء الحفلة
Dialogue: 0,0:15:00.09,0:15:02.51,Default,,0000,0000,0000,,كما لمَ قد أُقدم على شيءٍ بهذه الجرأة
Dialogue: 0,0:15:02.51,0:15:04.88,Default,,0000,0000,0000,,بتواجد مُتحرٍّ عظيم مثلك؟
Dialogue: 0,0:15:05.18,0:15:07.93,Default,,0000,0000,0000,,لم يكن أمامك خيارٌ آخر
Dialogue: 0,0:15:07.93,0:15:11.31,Default,,0000,0000,0000,,لأنّها حطّمت فوسوي مارو
Dialogue: 0,0:15:11.68,0:15:16.76,Default,,0000,0000,0000,,ألم تكن من وضع الكرة الرخامية أسفل فوسوي مارو
Dialogue: 0,0:15:16.76,0:15:18.72,Default,,0000,0000,0000,,لتسهيل سقوطه؟
Dialogue: 0,0:15:18.72,0:15:21.32,Default,,0000,0000,0000,,لجعل هذه الجريمة تبدو انتحاراً أقدمت عليه
Dialogue: 0,0:15:21.32,0:15:24.28,Default,,0000,0000,0000,,بسبب إخفاقها في حمل الآنية؟
Dialogue: 0,0:15:24.68,0:15:26.22,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:15:26.22,0:15:29.39,Default,,0000,0000,0000,,،إذا كانت هي المسؤولة عن بيع القطع
Dialogue: 0,0:15:29.39,0:15:33.22,Default,,0000,0000,0000,,فهي من يخزّنها هنا ويخرجها غالباً
Dialogue: 0,0:15:33.22,0:15:36.00,Default,,0000,0000,0000,,فكان حتميّاً أن تسقطه بنهاية المطاف
Dialogue: 0,0:15:36.36,0:15:40.81,Default,,0000,0000,0000,,كما أنّها نامت من الثمالة أثناء الحفلة
Dialogue: 0,0:15:40.81,0:15:43.31,Default,,0000,0000,0000,,كانت البارحة الفرصة المثاليّة
Dialogue: 0,0:15:43.31,0:15:47.97,Default,,0000,0000,0000,,توقّف رجاءً! لا يمكنك إلقاء التهمّة عليّ\N...دون امتلاك دليل
Dialogue: 0,0:15:48.56,0:15:52.47,Default,,0000,0000,0000,,أليس الدليل على شيءٍ ترتديه بالفعل؟
Dialogue: 0,0:15:53.14,0:15:57.94,Default,,0000,0000,0000,,حسناً حضرة المفتّش، ارفع معطفه\Nمن على ظهره رجاءً
Dialogue: 0,0:16:04.35,0:16:05.82,Default,,0000,0000,0000,,!هذا؟
Dialogue: 0,0:16:05.82,0:16:07.32,Default,,0000,0000,0000,,أ-أحمر شفاه؟
Dialogue: 0,0:16:07.32,0:16:12.24,Default,,0000,0000,0000,,وصله عندما كان يحمل السيّدة للرفّ على الأرجح
Dialogue: 0,0:16:12.85,0:16:17.22,Default,,0000,0000,0000,,لا يمكنك صعود السلّم\Nدون حملها على كتفيك
Dialogue: 0,0:16:17.22,0:16:23.12,Default,,0000,0000,0000,,ثمّ رجعت لغرفة المعيشة كما لو\Nأنّ شيئاً لم يحصل
Dialogue: 0,0:16:23.12,0:16:29.43,Default,,0000,0000,0000,,غادرت الحفلة لنقلها هناك\N!قبل أن تصحو من ثملها
Dialogue: 0,0:16:31.01,0:16:33.89,Default,,0000,0000,0000,,انظروا لوسادات الجلوس\Nفي غرفة المعيشة
Dialogue: 0,0:16:33.89,0:16:38.39,Default,,0000,0000,0000,,على إحداها أحمر الشفاه الذي انتقل منه
Dialogue: 0,0:16:39.40,0:16:44.35,Default,,0000,0000,0000,,،ارفق بي! قد يكون هذا أحمر شفاهها
Dialogue: 0,0:16:44.35,0:16:48.40,Default,,0000,0000,0000,,لكن ربما نقلته لظهري مصادفةً
Dialogue: 0,0:16:48.76,0:16:52.25,Default,,0000,0000,0000,,بينما كانت نائمةً أثناء الحفلة
Dialogue: 0,0:16:53.38,0:16:56.01,Default,,0000,0000,0000,,كنتُ ثملاً البارحة، فلا أتذكّر بوضوح
Dialogue: 0,0:16:56.01,0:16:59.14,Default,,0000,0000,0000,,لكن أيمكنك إنكار هذه الاحتماليّة؟
Dialogue: 0,0:17:00.47,0:17:04.22,Default,,0000,0000,0000,,لا تترك لي خياراً إذاً، سأريك دليلي الخاص
Dialogue: 0,0:17:04.22,0:17:07.31,Default,,0000,0000,0000,,كونان! هات ذاك الشيء الذي وجدته
Dialogue: 0,0:17:08.98,0:17:10.98,Default,,0000,0000,0000,,!كونان-كن؟
Dialogue: 0,0:17:10.98,0:17:12.56,Default,,0000,0000,0000,,!ها هو يا عمّ، صحيح؟
Dialogue: 0,0:17:12.56,0:17:14.10,Default,,0000,0000,0000,,!كونان-كن! هذا خطر
Dialogue: 0,0:17:15.19,0:17:15.73,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:23.61,0:17:24.78,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:17:25.40,0:17:26.99,Default,,0000,0000,0000,,!هاتف خلويّ؟
Dialogue: 0,0:17:28.23,0:17:31.15,Default,,0000,0000,0000,,!لمَ يوجد داخل الإناء؟
Dialogue: 0,0:17:31.15,0:17:34.56,Default,,0000,0000,0000,,كان للتحقّق من نجاح الجريمة
Dialogue: 0,0:17:35.86,0:17:38.65,Default,,0000,0000,0000,,،حتّى لو كانت مستلقيةً على رفٍّ ضيّق
Dialogue: 0,0:17:38.65,0:17:41.38,Default,,0000,0000,0000,,لا ضمان لفقدانها توازنها عند استيقاظها
Dialogue: 0,0:17:41.65,0:17:46.05,Default,,0000,0000,0000,,لكن سيختلف الموضوع إذا رنّ\Nالهاتف أسفل وسادتها
Dialogue: 0,0:17:46.05,0:17:49.27,Default,,0000,0000,0000,,سيمدّ الجميع أيديهم بلا تفكير\Nفي ذاك الوضع غالباً
Dialogue: 0,0:17:49.27,0:17:54.16,Default,,0000,0000,0000,,خصوصاً لو كانوا يستعملون هاتفهم\Nكساعة تنبيه مثل السيّدة
Dialogue: 0,0:17:55.02,0:18:01.78,Default,,0000,0000,0000,,أجل، وضع سيتو-سان ذاك الإناء\Nفي الرفّ أسفلها تماماً
Dialogue: 0,0:18:02.89,0:18:10.98,Default,,0000,0000,0000,,وجعل الهاتف في هذا الإناء \Nمزدوج القاع الخاصّ يرن
Dialogue: 0,0:18:12.23,0:18:16.46,Default,,0000,0000,0000,,تفقّد رقم هذا الهاتف الخلويّ سيكشف فوراً
Dialogue: 0,0:18:17.65,0:18:19.81,Default,,0000,0000,0000,,أنّه يخصّ سيتو-سان
Dialogue: 0,0:18:28.19,0:18:32.89,Default,,0000,0000,0000,,أخبرني حضرة المتحرّي، كيف عرفت أنّه أنا؟
Dialogue: 0,0:18:35.15,0:18:40.61,Default,,0000,0000,0000,,صحيحٌ أنّي أجريت الاتّصال، لكن كان بإمكان\Nأوتاني الذي غادر الغرفة أيضاً فعل ذلك
Dialogue: 0,0:18:40.87,0:18:42.56,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:18:42.56,0:18:46.57,Default,,0000,0000,0000,,فكّرتُ بالأمر عندما وجد كونان\Nالإناء الذي يحوي الهاتف
Dialogue: 0,0:18:46.57,0:18:47.69,Default,,0000,0000,0000,,!كيف إذاً؟
Dialogue: 0,0:18:47.69,0:18:52.33,Default,,0000,0000,0000,,:عندما اتّصلت بها، قلتَ التالي
Dialogue: 0,0:18:52.86,0:18:55.41,Default,,0000,0000,0000,,غريب، إنّها لا تجيب
Dialogue: 0,0:18:55.90,0:19:02.52,Default,,0000,0000,0000,,لكن هاتفها الخلويّ كان مُطفأً\Nعندما عُثر عليه
Dialogue: 0,0:19:02.52,0:19:05.59,Default,,0000,0000,0000,,يبدو أنّ الهاتف الخلويّ كان مُطفأً
Dialogue: 0,0:19:05.99,0:19:09.77,Default,,0000,0000,0000,,في تلك الحالة، كان ليكون ردّ الهاتف الخلويّ
Dialogue: 0,0:19:09.77,0:19:15.60,Default,,0000,0000,0000,,أنّه مُطفأ، أو خارج نطاق الإرسال
Dialogue: 0,0:19:17.02,0:19:20.23,Default,,0000,0000,0000,,تيقّنتُ بعدما تذكّرتُ ذلك
Dialogue: 0,0:19:20.98,0:19:26.02,Default,,0000,0000,0000,,كنتَ قد اتّصلت برقمٍ آخر آنذاك
Dialogue: 0,0:19:26.02,0:19:31.86,Default,,0000,0000,0000,,فهمت، كان عليّ قول أنّي\Nلا أستطيع الوصول لهاتفها إذاً
Dialogue: 0,0:19:31.86,0:19:38.67,Default,,0000,0000,0000,,لكن لا أستطيع تصديق أنّك قتلتها\N!وحطّمت فوسوي مارو الخاصّ بالمعلّم لذلك
Dialogue: 0,0:19:38.94,0:19:42.13,Default,,0000,0000,0000,,ولو تحطّم ذاك الشيء لأشلاء، فلا يعنيني
Dialogue: 0,0:19:43.93,0:19:50.01,Default,,0000,0000,0000,,فهو قطعة مزيّفة صنعتها\Nبتقليد فوسوي مارو الحقيقيّ
Dialogue: 0,0:19:50.01,0:19:52.19,Default,,0000,0000,0000,,!قـ-قطعة مزيّفة؟
Dialogue: 0,0:19:52.19,0:19:56.10,Default,,0000,0000,0000,,أجل، الحقيقيّة محفوظة في مكانٍ آخر
Dialogue: 0,0:20:01.56,0:20:07.69,Default,,0000,0000,0000,,لكن، نجاحي في خداع أعين السيّدة\N...رغم أنّه تحطّم أمامها
Dialogue: 0,0:20:07.69,0:20:10.99,Default,,0000,0000,0000,,هذا يثبت أنّ مهارتي تحسّنت
Dialogue: 0,0:20:11.38,0:20:15.79,Default,,0000,0000,0000,,رغم أنّها تمكّنت من بيع أعمالي\Nبأسعار باهظة لهذا السبب
Dialogue: 0,0:20:16.19,0:20:17.88,Default,,0000,0000,0000,,!أ-أسعار باهظة؟
Dialogue: 0,0:20:17.88,0:20:18.75,Default,,0000,0000,0000,,...أتقصد
Dialogue: 0,0:20:19.19,0:20:20.98,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:20.98,0:20:26.11,Default,,0000,0000,0000,,،أخذت أعمالي وباعتها لأثرياء سُذّج جاهلين
Dialogue: 0,0:20:26.11,0:20:29.09,Default,,0000,0000,0000,,!مدّعية أنّها من صنع المعلّم
Dialogue: 0,0:20:29.36,0:20:30.38,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:31.02,0:20:34.15,Default,,0000,0000,0000,,بوقت إدراكي ذلك، كانت قد باعت عدّة عشرات
Dialogue: 0,0:20:34.15,0:20:36.69,Default,,0000,0000,0000,,،،،واجهتُها بذلك بالطبع
Dialogue: 0,0:20:36.69,0:20:39.02,Default,,0000,0000,0000,,...لكنّها، ناهيك عن عدم الاعتذار
Dialogue: 0,0:20:39.32,0:20:42.23,Default,,0000,0000,0000,,يجدر بك الامتنان
Dialogue: 0,0:20:42.23,0:20:48.90,Default,,0000,0000,0000,,فأنا أنجح في بيع الخرد \Nغير الأصليّة اللي تصنعها
Dialogue: 0,0:20:53.99,0:20:57.41,Default,,0000,0000,0000,,...أيعني ذلك أنّ هبوط مستواك مؤخراً
Dialogue: 0,0:20:57.41,0:20:59.73,Default,,0000,0000,0000,,!أجل، كان مقصوداً
Dialogue: 0,0:20:59.73,0:21:03.88,Default,,0000,0000,0000,,!لم أرد تشويه اسم المعلّم أكثر
Dialogue: 0,0:21:04.40,0:21:07.77,Default,,0000,0000,0000,,!لكنّها هددتني بطردي إذا توقّفت عن صنع الأواني
Dialogue: 0,0:21:07.77,0:21:10.76,Default,,0000,0000,0000,,...لم أستطع تحمّل ذلك أكثر، فقرّرت
Dialogue: 0,0:21:11.05,0:21:12.68,Default,,0000,0000,0000,,!يا-يا أحمق
Dialogue: 0,0:21:26.56,0:21:31.36,Default,,0000,0000,0000,,...لمَ لم تخبر المعلّم بهذا الأمر؟ كان حتماً لـ
Dialogue: 0,0:21:31.63,0:21:33.27,Default,,0000,0000,0000,,لم أستطع
Dialogue: 0,0:21:33.27,0:21:39.49,Default,,0000,0000,0000,,كيف أخبره أنّ قطعي المزيّفة قد بِيعت\Nبثمن أعلى من أعماله الأصليّة؟
Dialogue: 0,0:21:44.23,0:21:45.52,Default,,0000,0000,0000,,هيّا بنا
Dialogue: 0,0:23:29.92,0:23:32.24,Default,,0000,0000,0000,,هذا الكأس الذي تبلغ قيمته 10 ملايين ينّ إذاً؟
Dialogue: 0,0:23:33.95,0:23:37.32,Default,,0000,0000,0000,,...بصراحة، لا يبدو بذاك المستوى لي
Dialogue: 0,0:23:37.32,0:23:39.86,Default,,0000,0000,0000,,المظاهر لا تطابق المضمون دوماً
Dialogue: 0,0:23:40.41,0:23:41.00,Default,,0000,0000,0000,,!ساخن
Dialogue: 0,0:23:47.46,0:23:49.49,Default,,0000,0000,0000,,!دعابة
Dialogue: 0,0:23:54.74,0:23:59.20,Default,,0000,0000,0000,,في حالته، المظهر يطابق المضمون
Dialogue: 0,0:24:01.42,0:24:02.93,Default,,0000,0000,0000,,!حُب أوّل؟
Dialogue: 0,0:24:04.57,0:24:05.89,Default,,0000,0000,0000,,!هذا سيّئ
Dialogue: 0,0:24:06.61,0:24:09.80,Default,,0000,0000,0000,,كانت حُبّ شينتشي الأوّل؟
Dialogue: 0,0:24:11.48,0:24:12.98,Default,,0000,0000,0000,,!النزل يحترق
Dialogue: 0,0:24:14.31,0:24:14.98,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:24:15.57,0:24:20.03,Default,,0000,0000,0000,,!لا تزال أسامي سينباي هناك
Dialogue: 0,0:24:23.73,0:24:24.85,Default,,0000,0000,0000,,!سينباي
Dialogue: 0,0:24:25.45,0:24:27.45,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.45,0:24:31.45,On Top,,0000,0000,0000,,قضيّة ذكريات الحُب الأوّل\N(الجزء الأوّل)
Dialogue: 0,0:24:27.45,0:24:29.45,Default,,0000,0000,0000,,قضيّة ذكريات الحُب الأوّل\N(الجزء الأوّل)
Dialogue: 0,0:24:47.05,0:24:49.36,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.59,0:24:51.02,Default,,0000,0000,0000,,فطيرة بالليمون
Dialogue: 0,0:24:51.74,0:24:53.55,Default,,0000,0000,0000,,للحلقة القادمة، أيّ مذاق يتبادر لك\Nعندما تفكّر بالحبّ الأوّل؟
Dialogue: 0,0:24:53.55,0:24:54.99,Default,,0000,0000,0000,,!علبة غداء أنقليس
Dialogue: 0,0:24:54.99,0:24:55.79,Default,,0000,0000,0000,,...مهلك

