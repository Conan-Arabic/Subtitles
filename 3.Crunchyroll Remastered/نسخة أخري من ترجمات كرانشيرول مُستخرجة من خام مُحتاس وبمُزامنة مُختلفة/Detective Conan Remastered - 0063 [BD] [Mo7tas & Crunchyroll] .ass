Dialogue: 0,0:00:01.32,0:00:03.15,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:03.15,0:00:06.84,Default,,0000,0000,0000,,تبلل الاستنتاجات المفككة للغموض \Nالقلوب التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:06.84,0:00:08.94,Default,,0000,0000,0000,,ندخل اليوم عالم الأفلام المذهل
Dialogue: 0,0:00:08.94,0:00:11.06,Default,,0000,0000,0000,,تقع جريمة في ظلّ وحش
Dialogue: 0,0:00:11.06,0:00:13.05,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:13.05,0:00:15.30,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:15.30,0:00:16.83,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.28,0:01:57.23,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل الوحش العملاق غوميرا
Dialogue: 0,0:01:51.91,0:01:55.28,Default,,0000,0000,0000,,جريمة قتل الوحش العملاق غوميرا
Dialogue: 0,0:02:05.97,0:02:07.47,Default,,0000,0000,0000,,!اقطع
Dialogue: 0,0:02:08.35,0:02:10.56,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:02:10.56,0:02:11.86,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:02:13.81,0:02:16.04,Default,,0000,0000,0000,,!إنّه غوميرا الحقيقيّ
Dialogue: 0,0:02:16.04,0:02:17.71,Default,,0000,0000,0000,,!مذهل بالفعل
Dialogue: 0,0:02:17.71,0:02:19.63,Default,,0000,0000,0000,,يبدو قويّاً جدّاً
Dialogue: 0,0:02:19.63,0:02:21.31,Default,,0000,0000,0000,,مضى وقت طويل يا آغاسا
Dialogue: 0,0:02:21.31,0:02:23.12,Default,,0000,0000,0000,,!ميكامي-كن
Dialogue: 0,0:02:23.12,0:02:26.16,Default,,0000,0000,0000,,أهم من أرادوا المشاهدة؟
Dialogue: 0,0:02:26.16,0:02:27.29,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:27.29,0:02:28.78,Default,,0000,0000,0000,,من هذا الرجل؟
Dialogue: 0,0:02:29.20,0:02:34.15,Default,,0000,0000,0000,,إنّه المخرج ميكامي-كن، صديقي ومُبتكر غوميرا
Dialogue: 0,0:02:34.76,0:02:38.19,CharCard,,0000,0000,0005,,{\fad(300,0)}ميكامي دايسكي\Nمخرج أفلام
Dialogue: 0,0:02:35.11,0:02:37.07,On Top,,0000,0000,0000,,مرحباً بكم يا أطفال
Dialogue: 0,0:02:38.78,0:02:42.61,Default,,0000,0000,0000,,هل تريدون رؤية غوميرا عن قرب؟
Dialogue: 0,0:02:42.61,0:02:43.43,Default,,0000,0000,0000,,أيمكننا؟
Dialogue: 0,0:02:43.43,0:02:47.35,Default,,0000,0000,0000,,أجل، سنأخذ استراحة لفترة. يمكنكم خلال ذلك
Dialogue: 0,0:02:47.35,0:02:48.85,Default,,0000,0000,0000,,!رائع
Dialogue: 0,0:02:51.47,0:02:53.48,Default,,0000,0000,0000,,هذه البنايات صغيرة
Dialogue: 0,0:02:53.84,0:02:56.69,Default,,0000,0000,0000,,!انظر هناك
Dialogue: 0,0:02:58.34,0:03:00.65,Default,,0000,0000,0000,,!ظهر غوميرا مفتوح
Dialogue: 0,0:03:03.66,0:03:05.86,Default,,0000,0000,0000,,!وُلِد شخص من غوميرا
Dialogue: 0,0:03:06.16,0:03:09.07,Default,,0000,0000,0000,,إنّها مجرد بذلة، وينتجون العمل بحيث يبدو
Dialogue: 0,0:03:09.21,0:03:13.15,Default,,0000,0000,0000,,كما لو أنّ الوحش يثور في المدينة المصغّرة
Dialogue: 0,0:03:13.44,0:03:16.69,Default,,0000,0000,0000,,...هذه البنايات مصنوعه بإتقان
Dialogue: 0,0:03:16.69,0:03:18.11,Default,,0000,0000,0000,,!أنتم أيّها الأطفال
Dialogue: 0,0:03:18.53,0:03:22.95,CharCard,,0000,0000,0005,,{\fad(300,0)}أداتشي ريوتا\Nفنّي
Dialogue: 0,0:03:18.69,0:03:20.32,On Top,,0000,0000,0000,,!لا تلمسوها بأيديكم القذرة
Dialogue: 0,0:03:20.32,0:03:22.95,On Top,,0000,0000,0000,,!ستقعون في مشكلة إن أفسدتم المسرح
Dialogue: 0,0:03:23.81,0:03:27.18,Default,,0000,0000,0000,,!حضرة المخرج! تصرّف مع هؤلاء الأطفال
Dialogue: 0,0:03:27.18,0:03:28.32,Default,,0000,0000,0000,,...هوّن عليك
Dialogue: 0,0:03:28.81,0:03:31.45,On Top,,0000,0000,0000,,هل تريدون أن أعتني بهم؟
Dialogue: 0,0:03:29.66,0:03:34.27,CharCard,,0000,0000,0005,,{\fad(300,0)}ماتسوي شوغو\Nممثل غوميرا
Dialogue: 0,0:03:31.85,0:03:34.27,On Top,,0000,0000,0000,,فلا مشاهد لدينا حتّى الظهيرة
Dialogue: 0,0:03:34.84,0:03:36.47,Default,,0000,0000,0000,,شكراً يا ماتسوي-كن
Dialogue: 0,0:03:36.47,0:03:38.05,Default,,0000,0000,0000,,إنّه شخص لطيف
Dialogue: 0,0:03:38.05,0:03:40.03,Default,,0000,0000,0000,,غوميرا في جانب الأطفال
Dialogue: 0,0:03:40.55,0:03:44.98,Default,,0000,0000,0000,,يثور غوميرا بسبب البالغين السيّئين دوماً في الأصل
Dialogue: 0,0:03:45.33,0:03:47.83,On Top,,0000,0000,0000,,وإيميلا الجنّية هي من يُخمد
Dialogue: 0,0:03:46.14,0:03:50.91,CharCard,,0000,0000,0005,,{\fad(300,0)}ساكاغوتشي تومومي\Nممثلة
Dialogue: 0,0:03:47.83,0:03:51.95,On Top,,0000,0000,0000,,ثورة غوميرا يا صغار
Dialogue: 0,0:03:52.46,0:03:56.90,Default,,0000,0000,0000,,إيميلا؟ جنّية الخاتم التي تخرج\Nعندما تكون هناك مشكلة فقط؟
Dialogue: 0,0:03:56.90,0:03:58.15,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:03:58.57,0:04:01.87,Default,,0000,0000,0000,,مستحيل! إيميلا صغيرة بهذا الحجم
Dialogue: 0,0:04:01.87,0:04:03.60,Default,,0000,0000,0000,,إنّها تبدو مثلها
Dialogue: 0,0:04:03.94,0:04:06.37,Default,,0000,0000,0000,,لكن أليست كبيرة السنّ نوعاً ما؟
Dialogue: 0,0:04:06.37,0:04:08.31,Default,,0000,0000,0000,,اصمت
Dialogue: 0,0:04:09.35,0:04:11.27,Default,,0000,0000,0000,,لديك طاقم جيّد
Dialogue: 0,0:04:11.27,0:04:13.60,Default,,0000,0000,0000,,أجل، كلّهم يحبّون غوميرا
Dialogue: 0,0:04:13.60,0:04:17.52,Default,,0000,0000,0000,,وهم كعائلة عملت على غوميرا لعشرة أعوام
Dialogue: 0,0:04:17.93,0:04:19.49,Default,,0000,0000,0000,,سينتهي ذلك هذا العام
Dialogue: 0,0:04:20.36,0:04:23.00,On Top,,0000,0000,0000,,أفلام الوحوش طفوليّة
Dialogue: 0,0:04:20.88,0:04:25.06,CharCard,,0000,0000,0005,,{\fad(300,0)}كامي أوسامو\Nمنتج أفلام
Dialogue: 0,0:04:23.00,0:04:25.06,On Top,,0000,0000,0000,,ولّى عصرها
Dialogue: 0,0:04:25.50,0:04:28.78,Default,,0000,0000,0000,,موسيقى مبتذلة ونهج متكرر
Dialogue: 0,0:04:29.17,0:04:31.87,Default,,0000,0000,0000,,مسرح باهظ جدّاً وتأثيرات خاصة
Dialogue: 0,0:04:31.87,0:04:35.70,Default,,0000,0000,0000,,الجنّية التي كانت في الرابعة عشر\Nعند ظهورها الأوّل أصبحت في الرابعة والعشرين
Dialogue: 0,0:04:35.70,0:04:37.48,Default,,0000,0000,0000,,وقت إسدال ستار الختام
Dialogue: 0,0:04:38.07,0:04:42.95,Default,,0000,0000,0000,,بالمناسبة، يبدو أنّ التسجيل المبدئي للفيلم قد انتهى
Dialogue: 0,0:04:42.95,0:04:45.44,Default,,0000,0000,0000,,اذهبوا لمشاهدته في غرفة العرض
Dialogue: 0,0:04:45.44,0:04:48.27,Default,,0000,0000,0000,,لن تشاهده؟
Dialogue: 0,0:04:48.27,0:04:53.48,Default,,0000,0000,0000,,كلا. ما رأيك أن ترافقيني للأكل \Nيا تومومي-كن؟ فلدينا ذاك الموضوع لمناقشته
Dialogue: 0,0:04:53.89,0:04:55.94,Default,,0000,0000,0000,,كلا، سأمتنع
Dialogue: 0,0:04:58.89,0:05:00.99,Default,,0000,0000,0000,,أيّ موضوع؟
Dialogue: 0,0:05:00.99,0:05:02.89,Default,,0000,0000,0000,,عن فيلمه التالي
Dialogue: 0,0:05:02.89,0:05:05.38,Default,,0000,0000,0000,,طلب مني لعب دور الشرطيّة البطلة
Dialogue: 0,0:05:05.38,0:05:08.86,Default,,0000,0000,0000,,كيف يلوم الناس ثمّ يطلب شيئاً كذاك؟
Dialogue: 0,0:05:09.29,0:05:12.88,Default,,0000,0000,0000,,لمَ تتذمرين؟ لديك عمل ينتظرك على الأقل
Dialogue: 0,0:05:12.88,0:05:15.94,Default,,0000,0000,0000,,نحن في العراء، صحيح يا ماتشان؟
Dialogue: 0,0:05:16.53,0:05:21.74,Default,,0000,0000,0000,,...كلا، طلب مني أن ألعب دور الشخصية الشريرة
Dialogue: 0,0:05:21.74,0:05:23.40,Default,,0000,0000,0000,,ماذا؟ أنا فحسب إذاً؟
Dialogue: 0,0:05:23.90,0:05:28.40,Default,,0000,0000,0000,,لا يهمّ، لنذهب لمشاهدة غوميرا العظيم\Nفي غرفة العرض
Dialogue: 0,0:05:28.40,0:05:30.86,Default,,0000,0000,0000,,الأطفال في رعايتك يا ماتسوي-كن إذاً
Dialogue: 0,0:05:30.86,0:05:32.82,On Top,,0000,0000,0000,,المخزن رقم 1
Dialogue: 0,0:05:32.82,0:05:35.80,Default,,0000,0000,0000,,!مذهل! انظروا لكلّ هذه الوحوش
Dialogue: 0,0:05:35.80,0:05:38.03,Default,,0000,0000,0000,,!كلّها غلبها غوميرا
Dialogue: 0,0:05:38.64,0:05:39.72,Default,,0000,0000,0000,,أنت
Dialogue: 0,0:05:42.05,0:05:45.23,Default,,0000,0000,0000,,آسف، لم أعتقد أن تتفاجئي هكذا
Dialogue: 0,0:05:45.59,0:05:47.50,Default,,0000,0000,0000,,ما تلك اليد؟
Dialogue: 0,0:05:47.50,0:05:50.42,Default,,0000,0000,0000,,إنّها يد غوميرا، نستعملها عند اللقطات المقربة
Dialogue: 0,0:05:50.42,0:05:54.20,Default,,0000,0000,0000,,يوجد وجه يُتحكّم به عن بعد أيضاً، أتريدون رؤيته؟
Dialogue: 0,0:05:54.20,0:05:55.62,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:05:55.62,0:05:57.66,Default,,0000,0000,0000,,انتظروا، سأذهب لجلبه
Dialogue: 0,0:05:57.66,0:05:58.65,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:06:01.83,0:06:06.32,Default,,0000,0000,0000,,هل ستنتهي أفلام غوميرا حقاً؟ إنّها مسلية جداً
Dialogue: 0,0:06:06.32,0:06:09.48,Default,,0000,0000,0000,,قال أنّها تكلف الكثير من المال
Dialogue: 0,0:06:09.48,0:06:12.36,Default,,0000,0000,0000,,لا بدّ أنه مال الطعام! فغوميرا كبير الحجم
Dialogue: 0,0:06:12.65,0:06:14.56,Default,,0000,0000,0000,,يا للبسطاء
Dialogue: 0,0:06:18.42,0:06:19.19,Default,,0000,0000,0000,,!ماتسوي-سان
Dialogue: 0,0:06:21.47,0:06:23.17,Default,,0000,0000,0000,,ما حلّ بساقك؟
Dialogue: 0,0:06:23.17,0:06:24.36,Default,,0000,0000,0000,,!إ-إنّه غوميرا
Dialogue: 0,0:06:24.36,0:06:25.31,Default,,0000,0000,0000,,غوميرا؟
Dialogue: 0,0:06:25.80,0:06:29.65,Default,,0000,0000,0000,,!كان في هذه الغرفة، وطعنني بسكّين
Dialogue: 0,0:06:29.96,0:06:31.21,Default,,0000,0000,0000,,أين ذهب؟
Dialogue: 0,0:06:31.21,0:06:33.10,Default,,0000,0000,0000,,هرب من ذاك الباب
Dialogue: 0,0:06:34.16,0:06:36.19,Default,,0000,0000,0000,,!انتظروا! أيّها الأطفال
Dialogue: 0,0:06:39.65,0:06:41.20,Default,,0000,0000,0000,,ما هذا المكان؟
Dialogue: 0,0:06:41.20,0:06:42.61,Default,,0000,0000,0000,,يمكننا رؤية الاستوديو
Dialogue: 0,0:06:43.03,0:06:44.81,Default,,0000,0000,0000,,ماذا؟ يوجد شخص
Dialogue: 0,0:06:44.81,0:06:47.27,Default,,0000,0000,0000,,أليس المنتج؟
Dialogue: 0,0:06:52.11,0:06:52.94,Default,,0000,0000,0000,,ماتسوي-كن؟
Dialogue: 0,0:06:57.52,0:06:58.48,Default,,0000,0000,0000,,مهلك
Dialogue: 0,0:07:12.42,0:07:13.23,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:07:14.58,0:07:15.69,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:07:17.58,0:07:18.65,Default,,0000,0000,0000,,مات
Dialogue: 0,0:07:20.62,0:07:23.99,Default,,0000,0000,0000,,آثار أقدام؟ هرب من ذاك الباب
Dialogue: 0,0:07:24.61,0:07:25.19,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:07:28.32,0:07:30.28,Default,,0000,0000,0000,,!أنتم أيضاً
Dialogue: 0,0:07:30.74,0:07:31.74,Default,,0000,0000,0000,,أرأيتِ غوميرا؟
Dialogue: 0,0:07:31.74,0:07:34.19,Default,,0000,0000,0000,,ذاك هو، ارتطمت به للتوّ
Dialogue: 0,0:07:34.73,0:07:36.86,Default,,0000,0000,0000,,لحظة! أكان ذلك ماتسوي-سان؟
Dialogue: 0,0:07:43.05,0:07:43.60,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:43.60,0:07:45.56,Default,,0000,0000,0000,,غوميرا ليس موجوداً
Dialogue: 0,0:07:45.92,0:07:49.69,Default,,0000,0000,0000,,مستحيل، لا مكان يختبئ فيه هنا
Dialogue: 0,0:07:49.97,0:07:52.15,Default,,0000,0000,0000,,لعلّه طار
Dialogue: 0,0:07:52.15,0:07:54.61,Default,,0000,0000,0000,,غينتا-كن، لا يستطيع غوميرا الطيران
Dialogue: 0,0:07:57.12,0:07:58.53,Default,,0000,0000,0000,,سقط على الأرض
Dialogue: 0,0:07:59.12,0:08:00.19,Default,,0000,0000,0000,,تبّاً! انتحار؟
Dialogue: 0,0:08:05.53,0:08:08.28,Default,,0000,0000,0000,,!إنّه فارغ! مستحيل
Dialogue: 0,0:08:08.86,0:08:14.27,Default,,0000,0000,0000,,اعذرني على السؤال، لكن أين كنت وقت وقوع\Nالجريمة عند الحادية عشر والنصف صباحاً؟
Dialogue: 0,0:08:14.27,0:08:17.06,Default,,0000,0000,0000,,كنتُ في الطابق الأوّل للاستوديو
Dialogue: 0,0:08:17.06,0:08:19.57,Default,,0000,0000,0000,,أقوم بالمراجعات الاستمرارية الأخيرة بمفردي
Dialogue: 0,0:08:20.02,0:08:22.35,Default,,0000,0000,0000,,لم يكن هناك من يشهد لك إذاً؟
Dialogue: 0,0:08:22.35,0:08:23.02,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:08:24.01,0:08:26.45,Default,,0000,0000,0000,,أنت تتعرّق بشدة
Dialogue: 0,0:08:26.45,0:08:28.94,Default,,0000,0000,0000,,أجل، أنا كثير العرق بطبيعتي
Dialogue: 0,0:08:28.94,0:08:32.51,Default,,0000,0000,0000,,عندما دخلت المخزن، كان القاتل موجوداً
Dialogue: 0,0:08:32.51,0:08:36.08,Default,,0000,0000,0000,,وفي بذلة غوميرا بالفعل، صحيح؟
Dialogue: 0,0:08:36.08,0:08:37.15,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:08:38.62,0:08:40.33,Default,,0000,0000,0000,,أهو بخير؟
Dialogue: 0,0:08:40.33,0:08:44.06,Default,,0000,0000,0000,,أعطيته علاجاً أوليّاً، لكن يجب أخذه لمشفى
Dialogue: 0,0:08:45.66,0:08:48.53,Default,,0000,0000,0000,,يستحيل أنّه ارتكب الجريمة بحالة ساقه
Dialogue: 0,0:08:48.99,0:08:52.36,Default,,0000,0000,0000,,لمَ كنتِ هنا يا ساكاغوتشي-سان\Nعندما وقعت الجريمة؟
Dialogue: 0,0:08:52.90,0:08:58.81,Default,,0000,0000,0000,,أردتُ أن يرى المنتج كامي التسجيل المبدئي\Nلآخر أفلام غوميرا
Dialogue: 0,0:08:58.81,0:09:00.98,Default,,0000,0000,0000,,...كان مصوّراً بدقّة، لذا
Dialogue: 0,0:09:00.98,0:09:02.15,Default,,0000,0000,0000,,التسجيل المبدئي؟
Dialogue: 0,0:09:02.15,0:09:05.27,Default,,0000,0000,0000,,فيلم غير محرّر انتهى تصويره للتوّ
Dialogue: 0,0:09:05.80,0:09:08.23,Default,,0000,0000,0000,,من كان ليظن أنّ هذا سيحصل
Dialogue: 0,0:09:08.84,0:09:13.75,Default,,0000,0000,0000,,أخبريني يا تومومي-سان، رأيتِ ظهر\Nالشخص في البذلة، أليس كذلك؟
Dialogue: 0,0:09:14.40,0:09:18.36,Default,,0000,0000,0000,,...أجل، لكنّي لا أدري من كان. أسلوب ركضه مع ذلك
Dialogue: 0,0:09:18.79,0:09:20.22,Default,,0000,0000,0000,,أسلوب ركضه؟
Dialogue: 0,0:09:20.22,0:09:22.46,Default,,0000,0000,0000,,أجل، بدا أنّه يعاني من الركض
Dialogue: 0,0:09:22.46,0:09:25.12,Default,,0000,0000,0000,,كما لو أنّه ليس معتاداً على ارتدائه
Dialogue: 0,0:09:25.12,0:09:28.98,Default,,0000,0000,0000,,بالطبع، سيكون ذلك حال الجميع باستثناء ماتسوي-كن
Dialogue: 0,0:09:28.98,0:09:35.94,Default,,0000,0000,0000,,أي أنّ الجميع باستثناء ماتسوي-سان\Nوساكاغوتشي-سان والمخرج ميكامي كانوا في غرفة العرض
Dialogue: 0,0:09:36.36,0:09:38.90,Default,,0000,0000,0000,,أجل، شاهدتُ التسجيل المبدئي بدوري
Dialogue: 0,0:09:39.90,0:09:40.61,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:09:40.61,0:09:45.31,Default,,0000,0000,0000,,!آغاسا! المخترع العبقريّ الذي يعيش بجوار شينتشي-كن
Dialogue: 0,0:09:45.64,0:09:47.97,Default,,0000,0000,0000,,!سمعتُ بك
Dialogue: 0,0:09:47.97,0:09:50.48,Default,,0000,0000,0000,,تخترع أشياء غريبة دوماً
Dialogue: 0,0:09:53.13,0:09:53.98,Default,,0000,0000,0000,,...أنت
Dialogue: 0,0:09:53.98,0:09:54.69,Default,,0000,0000,0000,,مهلك
Dialogue: 0,0:09:55.13,0:09:58.42,Default,,0000,0000,0000,,أكان الطاقم بأسرهم في غرفة العرض حقّاً؟
Dialogue: 0,0:09:58.42,0:10:01.18,Default,,0000,0000,0000,,كانت الوحيدة التي غادرت
Dialogue: 0,0:10:01.59,0:10:04.69,Default,,0000,0000,0000,,...لحظة، كان هناك آخرٌ خرج خلسة
Dialogue: 0,0:10:05.08,0:10:06.15,Default,,0000,0000,0000,,من هو؟
Dialogue: 0,0:10:06.66,0:10:08.24,Default,,0000,0000,0000,,...أظنّه
Dialogue: 0,0:10:08.24,0:10:11.58,Default,,0000,0000,0000,,!أخبرتكم، لا أدري كيف وصل هذا الطلاء هنا
Dialogue: 0,0:10:11.58,0:10:12.61,Default,,0000,0000,0000,,!ذاك الشخص
Dialogue: 0,0:10:13.07,0:10:15.57,Default,,0000,0000,0000,,لمَ أضع طلاءً في منتصف المسرح
Dialogue: 0,0:10:15.57,0:10:18.07,Default,,0000,0000,0000,,ولدينا تصوير في الظهيرة؟
Dialogue: 0,0:10:18.65,0:10:20.53,Default,,0000,0000,0000,,أجل، خرجت
Dialogue: 0,0:10:20.90,0:10:24.23,Default,,0000,0000,0000,,انتبهتُ لشيء في المسرح عندما\Nرأيتُ التسجيل المبدئي
Dialogue: 0,0:10:25.18,0:10:28.06,Default,,0000,0000,0000,,لا تشكّون بي، صحيح؟
Dialogue: 0,0:10:28.06,0:10:31.45,Default,,0000,0000,0000,,خرج أداتشي-سان لأربع أو خمس دقائق فحسب
Dialogue: 0,0:10:31.89,0:10:34.96,Default,,0000,0000,0000,,لا يكفي ذلك لارتداء البذلة وقتل شخص
Dialogue: 0,0:10:34.96,0:10:38.90,Default,,0000,0000,0000,,ثمّ العودة لغرفة العرض بعد صعود الأدراج
Dialogue: 0,0:10:39.76,0:10:43.65,Default,,0000,0000,0000,,من وضع هذا الطلاء هنا بأيّ حال؟
Dialogue: 0,0:10:43.84,0:10:46.63,Default,,0000,0000,0000,,كان أنت
Dialogue: 0,0:10:47.92,0:10:52.86,Default,,0000,0000,0000,,تركته هناك بعد بروفة الصباح، هل نسيت؟
Dialogue: 0,0:10:56.03,0:10:58.89,Default,,0000,0000,0000,,!صحيح! نسيت تماماً
Dialogue: 0,0:10:58.89,0:10:59.58,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:10:59.91,0:11:03.03,Default,,0000,0000,0000,,لمَ لم يشاهد ماتسوي-سان التسجيل المبدئي؟
Dialogue: 0,0:11:03.65,0:11:07.57,Default,,0000,0000,0000,,لا أدري، قال أنّه لم يرد المشاهدة وحسب
Dialogue: 0,0:11:07.57,0:11:12.00,Default,,0000,0000,0000,,لا تقل ذلك، فهو أحد من أرادوا ترك غوميرا
Dialogue: 0,0:11:12.97,0:11:14.15,Default,,0000,0000,0000,,ماتسوي-سان؟
Dialogue: 0,0:11:14.47,0:11:19.39,Default,,0000,0000,0000,,أجل، يبدو أنّه كان يتذمّر للمنتج كثيراً
Dialogue: 0,0:11:19.39,0:11:22.86,Default,,0000,0000,0000,,سئم من دور غوميرا وأراد تمثيل أدوار طبيعية
Dialogue: 0,0:11:27.13,0:11:31.29,Default,,0000,0000,0000,,الأمر ليس منطقياً، أين اختفى القاتل؟
Dialogue: 0,0:11:32.13,0:11:35.41,Default,,0000,0000,0000,,تبعنا آثار الأقدام عند الزاوية وصعدنا الأدراج
Dialogue: 0,0:11:35.41,0:11:38.74,Default,,0000,0000,0000,,كونان-كن، لنصنع قبراً لغوميرا
Dialogue: 0,0:11:39.20,0:11:42.08,Default,,0000,0000,0000,,ثمّ خرجنا من ذاك الباب للسطح
Dialogue: 0,0:11:42.45,0:11:45.03,Default,,0000,0000,0000,,كونان-كن! قبراً له
Dialogue: 0,0:11:45.03,0:11:47.87,Default,,0000,0000,0000,,!اصمتي! ليس هذا وقته
Dialogue: 0,0:11:48.11,0:11:50.53,Default,,0000,0000,0000,,!لا تغضب مثل غوميرا
Dialogue: 0,0:11:50.98,0:11:52.61,Default,,0000,0000,0000,,مثل غوميرا؟
Dialogue: 0,0:11:52.85,0:11:56.91,Default,,0000,0000,0000,,انظر هنا! لا أثر ذيل له على الأدراج
Dialogue: 0,0:11:56.91,0:12:00.31,Default,,0000,0000,0000,,هذا دليل على أنّ غوميرا\Nصعد الأدراج غاضباً
Dialogue: 0,0:12:00.31,0:12:02.82,Default,,0000,0000,0000,,فهو يرفع ذيله عندما يغضب
Dialogue: 0,0:12:03.51,0:12:05.78,Default,,0000,0000,0000,,...لحظة! أيمكن
Dialogue: 0,0:12:06.26,0:12:08.12,Default,,0000,0000,0000,,ا-انتظر
Dialogue: 0,0:12:08.12,0:12:10.20,Default,,0000,0000,0000,,!ما-ما الخطب يا كونان؟
Dialogue: 0,0:12:11.09,0:12:12.45,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:12:17.04,0:12:18.12,Default,,0000,0000,0000,,ما الذي تراه؟
Dialogue: 0,0:12:18.12,0:12:19.08,Default,,0000,0000,0000,,ماذا هناك؟
Dialogue: 0,0:12:19.08,0:12:20.87,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:12:23.91,0:12:24.57,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:12:24.94,0:12:27.03,Default,,0000,0000,0000,,حسناً، عرفت الحيلة
Dialogue: 0,0:12:27.03,0:12:28.49,On Top,,0000,0000,0000,,الاستوديو أ
Dialogue: 0,0:12:28.69,0:12:31.46,Default,,0000,0000,0000,,!لمَ لا تسمحون لنا بالدخول؟
Dialogue: 0,0:12:31.46,0:12:34.56,Default,,0000,0000,0000,,لا يمكنكم، ليس مكاناً للهو الأطفال
Dialogue: 0,0:12:34.56,0:12:35.28,Default,,0000,0000,0000,,!من هنا
Dialogue: 0,0:12:35.28,0:12:36.32,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:12:37.60,0:12:39.99,Default,,0000,0000,0000,,يوجد آخرون هنا أيضاً
Dialogue: 0,0:12:40.56,0:12:41.39,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:12:41.39,0:12:42.95,On Top,,0000,0000,0000,,المخزن رقم 1
Dialogue: 0,0:12:48.28,0:12:49.02,Default,,0000,0000,0000,,!أنتم
Dialogue: 0,0:12:49.02,0:12:50.61,Default,,0000,0000,0000,,!نسينا شيئاً
Dialogue: 0,0:12:54.04,0:12:55.52,Default,,0000,0000,0000,,ماذا تفعلون هنا؟
Dialogue: 0,0:12:55.52,0:12:57.12,Default,,0000,0000,0000,,كونان-كن
Dialogue: 0,0:12:57.12,0:13:00.29,Default,,0000,0000,0000,,سنأخذ ماتسوي-كن للمشفى
Dialogue: 0,0:13:00.29,0:13:04.24,Default,,0000,0000,0000,,يبدو أنّه لن يستطيع أداء دور\Nغوميرا لفترة بحال ساقه
Dialogue: 0,0:13:04.90,0:13:08.11,Default,,0000,0000,0000,,انسوا غوميرا، لا يمكنه أداء\N...دور بشريّ حتى
Dialogue: 0,0:13:10.03,0:13:13.19,Default,,0000,0000,0000,,إذاً؟ أحللت القضيّة؟
Dialogue: 0,0:13:13.19,0:13:15.20,Default,,0000,0000,0000,,كلا، لم أجد الفاعل بعد
Dialogue: 0,0:13:15.85,0:13:20.49,Default,,0000,0000,0000,,لمَ هاجم ماتسوي-سان في هذا المخزن؟
Dialogue: 0,0:13:20.85,0:13:25.33,Default,,0000,0000,0000,,،ربما لأنّه أتى لأخذ السكّين \Nلكن رآه ماتسوي-سان؟
Dialogue: 0,0:13:27.30,0:13:31.22,Default,,0000,0000,0000,,أدوات الأفلام لا تقتل الناس
Dialogue: 0,0:13:34.13,0:13:38.37,Default,,0000,0000,0000,,لحظة، في هذه الحالة لا يمكن\N!أن يكون القاتل سوى ذاك الشخص
Dialogue: 0,0:13:49.45,0:13:50.94,Default,,0000,0000,0000,,ما الخطب يا شينتشي؟
Dialogue: 0,0:13:50.94,0:13:53.03,Default,,0000,0000,0000,,...لا أجد ساعتي المخدّرة
Dialogue: 0,0:13:55.06,0:13:58.16,Default,,0000,0000,0000,,...أيّها البروفسور! ما رأيك أن
Dialogue: 0,0:13:58.52,0:14:02.55,Default,,0000,0000,0000,,حضرة المفتّش، سنأخذ ماتسوي-كن للمشفى
Dialogue: 0,0:14:02.55,0:14:03.36,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:14:03.36,0:14:05.31,Default,,0000,0000,0000,,!تمهلوا
Dialogue: 0,0:14:06.47,0:14:10.45,Default,,0000,0000,0000,,!المجرم موجود في هذه الغرفة
Dialogue: 0,0:14:10.45,0:14:11.58,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:14:12.67,0:14:16.50,Default,,0000,0000,0000,,!حرّك شفتيك تزامناً مع ما سأقوله فحسب
Dialogue: 0,0:14:16.50,0:14:19.49,Default,,0000,0000,0000,,أين المشكلة؟ دعني أستمتع ببعض المجد بدوري
Dialogue: 0,0:14:19.75,0:14:24.99,Default,,0000,0000,0000,,إذاً يا آغاسا-سان، هلّا شرحت بما أنّك\Nتعرف هويّة المجرم
Dialogue: 0,0:14:24.99,0:14:27.45,Default,,0000,0000,0000,,كيف اختفى من السطح؟
Dialogue: 0,0:14:27.74,0:14:28.91,Default,,0000,0000,0000,,!تأثيرات خاصة
Dialogue: 0,0:14:29.83,0:14:32.94,Default,,0000,0000,0000,,تعرفون تلك الصور المجسّمة
Dialogue: 0,0:14:32.94,0:14:36.82,Default,,0000,0000,0000,,!لا بدّ أن القاتل كان كذلك طوال الوقت
Dialogue: 0,0:14:37.44,0:14:39.15,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:14:39.15,0:14:44.47,Default,,0000,0000,0000,,ما الذي تقوله؟! ارتطمتُ بالقاتل\N!في الرواق، ورأيته يهرب فوق ذلك
Dialogue: 0,0:14:44.47,0:14:47.85,Default,,0000,0000,0000,,...كلا، حسناً... انسوا ما قلتُه! الحقيقة
Dialogue: 0,0:14:47.85,0:14:48.98,Default,,0000,0000,0000,,!كانت حيلة
Dialogue: 0,0:14:49.80,0:14:51.91,Default,,0000,0000,0000,,وبغاية البساطة إضافةً لذلك
Dialogue: 0,0:14:51.91,0:14:55.25,Default,,0000,0000,0000,,رأت تومومي-سان والأطفال القاتل
Dialogue: 0,0:14:55.25,0:14:57.12,Default,,0000,0000,0000,,حتّى استدار في الرواق فحسب
Dialogue: 0,0:14:57.50,0:15:01.08,Default,,0000,0000,0000,,لا جزم بصعوده للجدران من عدمه بعدها
Dialogue: 0,0:15:01.42,0:15:04.95,Default,,0000,0000,0000,,لكن كانت هناك آثار أقدام على الأدراج
Dialogue: 0,0:15:04.95,0:15:06.74,Default,,0000,0000,0000,,...صـ-صحيح
Dialogue: 0,0:15:06.74,0:15:09.19,Default,,0000,0000,0000,,!طابق صوتي فحسب
Dialogue: 0,0:15:09.19,0:15:10.04,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:15:10.04,0:15:15.49,Default,,0000,0000,0000,,وضع القاتل آثار الأقدام\N!على الأدراج سلفاً
Dialogue: 0,0:15:17.15,0:15:19.86,Default,,0000,0000,0000,,يكاد لا يذهب أحد للسطح
Dialogue: 0,0:15:19.86,0:15:23.90,Default,,0000,0000,0000,,لن يكون غريباً ألا ينتبه أحد لذاك الدرج
Dialogue: 0,0:15:24.43,0:15:29.31,Default,,0000,0000,0000,,اُستعملت أقدام غوميرا وحدها لترك الآثار غالباً
Dialogue: 0,0:15:29.31,0:15:33.86,Default,,0000,0000,0000,,،ودليل ذلك هو وجود أثر ذيل في الرواق\Nلكن ليس على الأدراج
Dialogue: 0,0:15:34.25,0:15:38.83,Default,,0000,0000,0000,,خلع القاتل البذلة سريعاً أمام الأدراج
Dialogue: 0,0:15:39.30,0:15:42.53,Default,,0000,0000,0000,,نزل في الاتّجاه المعاكس ودخل غرفةً
Dialogue: 0,0:15:43.24,0:15:47.70,Default,,0000,0000,0000,,أضرم النار في البذلة ثم رماها على الأرض
Dialogue: 0,0:15:47.70,0:15:49.70,Default,,0000,0000,0000,,
Dialogue: 0,0:15:48.15,0:15:49.70,Default,,0000,0000,0000,,!هكذا إذاً
Dialogue: 0,0:15:49.70,0:15:51.66,Default,,0000,0000,0000,,...لا شيء
Dialogue: 0,0:15:51.66,0:15:54.86,Default,,0000,0000,0000,,لكن هل سيتمكن من وضع آثار أقدام سلفاً
Dialogue: 0,0:15:54.86,0:15:59.19,Default,,0000,0000,0000,,دون معرفة ما سيكون لون الطلاء على المسرح؟
Dialogue: 0,0:15:59.19,0:16:00.98,Default,,0000,0000,0000,,صحيح يا أداتشي-سان؟
Dialogue: 0,0:16:00.98,0:16:05.82,Default,,0000,0000,0000,,أجل، صادف أن وضعتُ ذاك الطلاء قبل الحادثة فحسب
Dialogue: 0,0:16:06.10,0:16:09.49,Default,,0000,0000,0000,,كلامك متناقض
Dialogue: 0,0:16:09.77,0:16:12.18,Default,,0000,0000,0000,,هذا طبيعيّ
Dialogue: 0,0:16:12.18,0:16:17.41,Default,,0000,0000,0000,,فتومومي-سان وأداتشي-سان يكذبان\N!للتغطية على القاتل
Dialogue: 0,0:16:18.67,0:16:19.87,Default,,0000,0000,0000,,يكذبان؟
Dialogue: 0,0:16:20.51,0:16:25.62,Default,,0000,0000,0000,,كان القاتل من وضع الطلاء عند المسرح
Dialogue: 0,0:16:25.62,0:16:28.08,Default,,0000,0000,0000,,لاستعماله في حيلة آثار الأقدام
Dialogue: 0,0:16:28.08,0:16:31.29,Default,,0000,0000,0000,,!أي يعرفان هويّة القاتل؟
Dialogue: 0,0:16:31.29,0:16:35.53,Default,,0000,0000,0000,,جارى أداتشي-سان ما قالته تومومي-سان فحسب غالباً
Dialogue: 0,0:16:35.53,0:16:37.99,Default,,0000,0000,0000,,لكن يُفترض أنّها تعرف
Dialogue: 0,0:16:37.99,0:16:41.45,Default,,0000,0000,0000,,رأت القاتل عندما ارتطمت به في الرواق على الأرجح
Dialogue: 0,0:16:41.74,0:16:44.64,Default,,0000,0000,0000,,من القاتل إذاً؟
Dialogue: 0,0:16:44.64,0:16:48.24,Default,,0000,0000,0000,,،القاتل بين الذين لم يكونوا في غرفة العرض\Nالمخرج ميكامي وماتسوي-سان
Dialogue: 0,0:16:48.85,0:16:54.15,Default,,0000,0000,0000,,كما بين من غادروها في فترةٍ ما، تومومي-سان\Nوأداتشي-سان، أحد هؤلاء الأربعة
Dialogue: 0,0:16:54.15,0:16:58.47,Default,,0000,0000,0000,,،غاب أداتشي-سان لأربع أو خمس دقائق فقط\Nفلم يمتلك وقتاً كافياً
Dialogue: 0,0:16:58.47,0:17:02.12,Default,,0000,0000,0000,,رأت تومومي-سان القاتل مع الأطفال، فهي بريئة أيضاً
Dialogue: 0,0:17:02.12,0:17:05.32,Default,,0000,0000,0000,,تبقّى المخرج ميكامي وماتسوي-سان فحسب
Dialogue: 0,0:17:05.54,0:17:08.62,Default,,0000,0000,0000,,مهلك، ماتسوي-سان مصاب إصابة بليغة
Dialogue: 0,0:17:08.62,0:17:10.66,Default,,0000,0000,0000,,!وميكامي-كن صديقي العزيز
Dialogue: 0,0:17:12.36,0:17:14.74,Default,,0000,0000,0000,,...ولذا سيشكّل هذا صدمةً
Dialogue: 0,0:17:14.74,0:17:16.24,Default,,0000,0000,0000,,...أجل، القاتل هو
Dialogue: 0,0:17:16.24,0:17:17.49,Default,,0000,0000,0000,,اسمع
Dialogue: 0,0:17:17.95,0:17:20.24,Default,,0000,0000,0000,,ما الذي تفعله يا كونان-كن؟
Dialogue: 0,0:17:20.95,0:17:23.48,Default,,0000,0000,0000,,!أنتم تضايقونني! ابتعدوا
Dialogue: 0,0:17:23.48,0:17:25.20,Default,,0000,0000,0000,,نضايقك؟ نبتعد؟
Dialogue: 0,0:17:25.60,0:17:29.19,Default,,0000,0000,0000,,!كلا، مجرد ذبابات مزعجة! ابتعدوا
Dialogue: 0,0:17:29.19,0:17:31.16,Default,,0000,0000,0000,,إذاً، من هو القاتل؟
Dialogue: 0,0:17:34.51,0:17:37.93,Default,,0000,0000,0000,,!القاتل هو ماتسوي-سان، أنت
Dialogue: 0,0:17:39.13,0:17:43.82,Default,,0000,0000,0000,,أحمق! لم يكن يستطيع الهرب\N!في تلك البذلة الثقيلة بإصابته
Dialogue: 0,0:17:44.12,0:17:48.03,Default,,0000,0000,0000,,بافتراض أنّه أُصيب قبل الجريمة حقّاً
Dialogue: 0,0:17:48.46,0:17:50.49,Default,,0000,0000,0000,,...أتقصد أنّ تلك الإصابة
Dialogue: 0,0:17:50.87,0:17:54.45,Default,,0000,0000,0000,,أجل، أسقط البذلة بعد ارتكاب الجريمة
Dialogue: 0,0:17:54.70,0:17:58.41,Default,,0000,0000,0000,,ورجع للمخزن وطعن نفسه بسكّين أخرى
Dialogue: 0,0:17:58.78,0:18:00.87,Default,,0000,0000,0000,,!لخداعنا
Dialogue: 0,0:18:01.24,0:18:05.65,Default,,0000,0000,0000,,لكن رأى الأطفال إصابته قبل وقوع الجريمة
Dialogue: 0,0:18:05.65,0:18:07.90,Default,,0000,0000,0000,,كان دماً مزيّفاً غالباً
Dialogue: 0,0:18:07.90,0:18:10.79,Default,,0000,0000,0000,,هذا مسرح تصوير، ستجده بسهولة
Dialogue: 0,0:18:11.27,0:18:17.39,Default,,0000,0000,0000,,لكن الأطفال لحقوا بغوميرا للاستوديو\Nبعدما رأوا إصابته
Dialogue: 0,0:18:17.39,0:18:21.14,Default,,0000,0000,0000,,يوجد طريق واحد فقط من المخزن للاستوديو
Dialogue: 0,0:18:21.14,0:18:24.45,Default,,0000,0000,0000,,أين تجاوزهم ماتسوي-سان بالضبط؟
Dialogue: 0,0:18:25.00,0:18:29.67,Default,,0000,0000,0000,,الاستوديو بجوار باب الرواق مباشرةً
Dialogue: 0,0:18:29.67,0:18:33.90,Default,,0000,0000,0000,,دخله بعد مغادرة الأطفال غالباً
Dialogue: 0,0:18:33.90,0:18:39.28,Default,,0000,0000,0000,,ارتدى البذلة بعدها، وقتل المنتج كامي
Dialogue: 0,0:18:39.28,0:18:43.82,Default,,0000,0000,0000,,تحتاج هذه الحيلة شهوداً\Nللحاق بآثار الأقدام
Dialogue: 0,0:18:44.23,0:18:50.52,Default,,0000,0000,0000,,فهمت، لذا اختار الأطفال باعتبار أنّهم بطيئون
Dialogue: 0,0:18:50.52,0:18:55.28,Default,,0000,0000,0000,,،الأطفال كتلة من الفضول\Nأخبرهم ألّا يذهبوا وسيذهبون
Dialogue: 0,0:18:55.93,0:19:00.08,Default,,0000,0000,0000,,أحرق البذلة كي يمحو آثار العرق داخلها
Dialogue: 0,0:19:00.08,0:19:03.50,Default,,0000,0000,0000,,ما دليل أنّ ماتسوي-سان كان الفاعل؟
Dialogue: 0,0:19:03.50,0:19:09.67,Default,,0000,0000,0000,,السكّين التي استعملها لطعن نفسه\Nموجودة في صندوق معدّات التصوير في المخزن
Dialogue: 0,0:19:09.67,0:19:12.09,Default,,0000,0000,0000,,كان ذلك المكان الوحيد لإخفائها غالباً
Dialogue: 0,0:19:12.09,0:19:14.49,Default,,0000,0000,0000,,فلم يستطع المشي بعد طعن ساقه
Dialogue: 0,0:19:15.20,0:19:19.83,Default,,0000,0000,0000,,!ودليل آخر، القميص الذي يرتديه
Dialogue: 0,0:19:20.83,0:19:22.08,Default,,0000,0000,0000,,قميصه؟
Dialogue: 0,0:19:22.08,0:19:26.19,Default,,0000,0000,0000,,ركض القاتل بأقصى سرعته وهو يرتدي البذلة
Dialogue: 0,0:19:26.19,0:19:29.48,Default,,0000,0000,0000,,من الطبيعيّ أن يكون القميص مليئاً بالعرق
Dialogue: 0,0:19:29.48,0:19:32.47,Default,,0000,0000,0000,,لكن لا بقع عرق على قميصه
Dialogue: 0,0:19:32.47,0:19:35.53,Default,,0000,0000,0000,,بالطبع لا، فقد غيّره
Dialogue: 0,0:19:35.93,0:19:37.47,Default,,0000,0000,0000,,غيّره؟
Dialogue: 0,0:19:37.47,0:19:40.39,Default,,0000,0000,0000,,يمكن لكونان-كن إثبات ذلك
Dialogue: 0,0:19:40.39,0:19:42.08,Default,,0000,0000,0000,,!ها أنا
Dialogue: 0,0:19:43.67,0:19:49.53,Default,,0000,0000,0000,,أتذكر عندما سكبت أيومي-تشان\Nعصيراً على قميصك؟
Dialogue: 0,0:19:50.63,0:19:53.62,Default,,0000,0000,0000,,لكن هذا غريب، لا بقعة هنا
Dialogue: 0,0:19:53.62,0:19:55.04,Default,,0000,0000,0000,,أين غيّرت قميصك؟
Dialogue: 0,0:19:55.04,0:19:57.28,Default,,0000,0000,0000,,ظننت أنّك لم تستطع الحركة بإصابة ساقك
Dialogue: 0,0:19:57.79,0:20:01.13,Default,,0000,0000,0000,,أأنت متأكد أنّك لم تخطئ يا ولد؟
Dialogue: 0,0:20:01.87,0:20:04.78,Default,,0000,0000,0000,,لعلّ العصير سُكب على الأرض وليس القميص؟
Dialogue: 0,0:20:05.07,0:20:06.86,Default,,0000,0000,0000,,...لكنّي رأيت
Dialogue: 0,0:20:06.86,0:20:09.70,Default,,0000,0000,0000,,!أأنت متأكد حقّاً؟ تذكّر جيّداً
Dialogue: 0,0:20:10.19,0:20:12.15,Default,,0000,0000,0000,,!أرجوك يا ولد
Dialogue: 0,0:20:14.35,0:20:16.24,Default,,0000,0000,0000,,يكفي يا تومومي-تشان
Dialogue: 0,0:20:17.52,0:20:21.60,Default,,0000,0000,0000,,إنّه محق، كنتُ متعرقاً بشدّة فغيّرت قميصي
Dialogue: 0,0:20:21.60,0:20:24.25,Default,,0000,0000,0000,,وضعته داخل حقيبتي
Dialogue: 0,0:20:24.25,0:20:25.74,Default,,0000,0000,0000,,حسناً، تفقدوها فوراً
Dialogue: 0,0:20:26.17,0:20:29.26,Default,,0000,0000,0000,,لمَ؟ لمَ قتلت المنتج كامي؟
Dialogue: 0,0:20:29.26,0:20:32.01,Default,,0000,0000,0000,,ألم يعطك دوراً في فيلمه القادم؟
Dialogue: 0,0:20:32.01,0:20:38.16,Default,,0000,0000,0000,,،لم يكن ذلك في بالي منذ البداية\Nكان غوميرا كلّ ما فكرتُ به فحسب
Dialogue: 0,0:20:38.62,0:20:43.32,Default,,0000,0000,0000,,!لكن ألم تكن أكثر من أراد ترك غوميرا؟
Dialogue: 0,0:20:43.32,0:20:46.62,Default,,0000,0000,0000,,ذاك أمرٌ اختلقه المنتج كامي
Dialogue: 0,0:20:47.07,0:20:52.23,Default,,0000,0000,0000,,استغربتُ من محاولة الجميع تشجيعي بابتسامات حزينة
Dialogue: 0,0:20:52.23,0:20:56.28,Default,,0000,0000,0000,,لا أصدّق أني سمعت بأكاذيبه قبل أسبوعين فحسب
Dialogue: 0,0:20:56.73,0:21:01.23,Default,,0000,0000,0000,,ذهبتُ لمناقشته هلعاً، لكنه قال أنّه أعلن سلفاً
Dialogue: 0,0:21:01.23,0:21:07.01,Default,,0000,0000,0000,,أنّ هذا سيكون فيلم غوميرا الأخير، ولا عودة الآن
Dialogue: 0,0:21:07.01,0:21:13.49,Default,,0000,0000,0000,,!سينسى الجميع وحش المطّاط ذاك بعد سنة
Dialogue: 0,0:21:14.12,0:21:16.58,Default,,0000,0000,0000,,!لمَ لم تتكلم معنا؟
Dialogue: 0,0:21:16.58,0:21:18.37,Default,,0000,0000,0000,,لم أستطع
Dialogue: 0,0:21:18.37,0:21:22.44,Default,,0000,0000,0000,,فقد كانت رؤية الجميع يجتهدون\Nمرة أخيرة عصيبة عليّ
Dialogue: 0,0:21:23.61,0:21:29.41,Default,,0000,0000,0000,,لكن ما أنا بنادم. فلن يكون هناك \Nمشهد موت نهائيّ لغوميرا الآن
Dialogue: 0,0:21:29.41,0:21:34.52,Default,,0000,0000,0000,,أتحسّر على جعل الأطفال يرون ما رأوه فحسب
Dialogue: 0,0:21:36.85,0:21:41.83,Default,,0000,0000,0000,,أخبرينا يا تومومي-تشان، هل رأيتِ\Nماتشان في بذلة غوميرا حقّاً؟
Dialogue: 0,0:21:42.38,0:21:46.77,Default,,0000,0000,0000,,كلا، لم أرَ شيئاً. فقد اختفى سريعاً
Dialogue: 0,0:21:47.68,0:21:49.26,Default,,0000,0000,0000,,...كيف إذاً
Dialogue: 0,0:21:49.26,0:21:53.83,Default,,0000,0000,0000,,أحمق، يمكنني أن أعرف من مجرد\Nتحركاته دون الحاجة للنظر داخلاً
Dialogue: 0,0:21:53.83,0:21:59.72,Default,,0000,0000,0000,,فقد كان زميلي الذي عمل معي \Nفي العشرة أعوام الفائتة
Dialogue: 0,0:23:27.33,0:23:30.16,Default,,0000,0000,0000,,تمّ عرض غوميرا في صالات الأفلام بعدها بشهرين
Dialogue: 0,0:23:31.16,0:23:35.90,Default,,0000,0000,0000,,رُبط المشهد الأخير بكلّ الأفلام السابقة
Dialogue: 0,0:23:35.90,0:23:37.74,Default,,0000,0000,0000,,ومُحي مشهد موت غوميرا
Dialogue: 0,0:23:38.73,0:23:42.28,Default,,0000,0000,0000,,يمكن لغوميرا العيش في الشاشات الآن للأبد
Dialogue: 0,0:23:43.35,0:23:48.68,Default,,0000,0000,0000,,يحبس المتفرجون أنفاسهم عندما يرون\Nالرسوم المفعمة بالقوّة والقصة الحماسية
Dialogue: 0,0:23:48.68,0:23:53.42,Default,,0000,0000,0000,,لكن، بدت لي صرخة غوميرا مليئةً بالحزن
Dialogue: 0,0:23:53.42,0:23:56.92,Default,,0000,0000,0000,,بينما يتردّد صداها في المسرح
Dialogue: 0,0:24:00.96,0:24:04.04,Default,,0000,0000,0000,,عندما حاول تيراوكا-سان اعتقال ماتسوياما-سان
Dialogue: 0,0:24:04.04,0:24:05.74,Default,,0000,0000,0000,,أُطلق المسدّس
Dialogue: 0,0:24:06.12,0:24:08.33,Default,,0000,0000,0000,,أكانت هذه حادثة؟
Dialogue: 0,0:24:08.33,0:24:13.40,Default,,0000,0000,0000,,بالمناسبة، هناك ما أخفيناه عن الإعلام\Nبشأن حادثة الأمس
Dialogue: 0,0:24:13.40,0:24:16.28,Default,,0000,0000,0000,,وجدنا 3 بصمات مختلفة على المسدّس
Dialogue: 0,0:24:16.69,0:24:19.53,Default,,0000,0000,0000,,لمن هي البصمة الثالثة؟
Dialogue: 0,0:24:19.53,0:24:23.27,Default,,0000,0000,0000,,...إن كان مالك المسدّس هو من أشتبه به، إذاً
Dialogue: 0,0:24:24.24,0:24:30.20,On Top,,0000,0000,15,,جريمة قتل البصمة الثالثة
Dialogue: 0,0:24:24.60,0:24:25.93,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.93,0:24:28.93,Default,,0000,0000,0000,,جريمة قتل البصمة الثالثة
Dialogue: 0,0:24:45.79,0:24:48.27,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.27,0:24:50.08,Default,,0000,0000,0000,,حافظة شريط فيديو
Dialogue: 0,0:24:50.47,0:24:52.25,Default,,0000,0000,0000,,!قضيّة الحلقة القادمة فريدة جدّاً
Dialogue: 0,0:24:52.25,0:24:54.25,Default,,0000,0000,0000,,!كم أتطلّع للأسبوع القادم

