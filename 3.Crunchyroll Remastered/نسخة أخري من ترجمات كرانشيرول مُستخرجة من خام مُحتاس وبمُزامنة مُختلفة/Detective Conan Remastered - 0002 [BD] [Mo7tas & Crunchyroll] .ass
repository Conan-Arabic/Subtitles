Dialogue: 0,0:00:01.14,0:00:02.88,Default,,0000,0000,0000,,اسمي كودو شينتشي
Dialogue: 0,0:00:02.88,0:00:06.14,Default,,0000,0000,0000,,مُتحرٍّ في الثانوية حلّ الكثير من القضايا
Dialogue: 0,0:00:06.34,0:00:08.77,Default,,0000,0000,0000,,حللتُ قضية قتل أفعوانية بلا أيّ صعوبة
Dialogue: 0,0:00:08.77,0:00:11.90,Default,,0000,0000,0000,,لكن أجبرتني منظمة غامضة على تجرّع سمٍّ غريب
Dialogue: 0,0:00:11.90,0:00:13.02,Default,,0000,0000,0000,,!الوضع سيّئ بحق
Dialogue: 0,0:00:13.02,0:00:14.89,Default,,0000,0000,0000,,!ران! ما الذي سيحلّ بي؟
Dialogue: 0,0:01:46.05,0:01:51.97,Title,,0000,0000,0000,,{\fad(300,0)}اختطاف ابنة رئيس الشركة
Dialogue: 0,0:01:47.21,0:01:50.38,Default,,0000,0000,0000,,اختطاف ابنة رئيس الشركة
Dialogue: 0,0:01:53.03,0:01:55.11,Default,,0000,0000,0000,,أأنت بخير أيّها الصبي الصغير؟
Dialogue: 0,0:01:55.11,0:01:56.86,Default,,0000,0000,0000,,صبيّ صغير؟
Dialogue: 0,0:01:56.86,0:01:58.61,Default,,0000,0000,0000,,ما الذي يتكلمان عنه؟
Dialogue: 0,0:01:58.61,0:02:00.54,Default,,0000,0000,0000,,أنا في السنة الثانية في الثانوية
Dialogue: 0,0:02:00.54,0:02:03.12,Default,,0000,0000,0000,,كيف أُصبت بالجرح على رأسك؟
Dialogue: 0,0:02:03.12,0:02:04.86,Default,,0000,0000,0000,,جرح؟
Dialogue: 0,0:02:04.86,0:02:06.03,Default,,0000,0000,0000,,!صحيح
Dialogue: 0,0:02:06.03,0:02:07.97,Default,,0000,0000,0000,,...ضربني الرجل برداء أسود
Dialogue: 0,0:02:09.93,0:02:10.58,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:02:11.26,0:02:13.39,Default,,0000,0000,0000,,وجدنا صبيّاً مُصاباً
Dialogue: 0,0:02:13.39,0:02:14.99,Default,,0000,0000,0000,,أجل، إنّه تلميذ في الابتدائية
Dialogue: 0,0:02:15.17,0:02:17.71,Default,,0000,0000,0000,,!من التلميذ في الابتدائية؟
Dialogue: 0,0:02:17.71,0:02:19.17,Default,,0000,0000,0000,,!ما الذي يتكلم عنه؟
Dialogue: 0,0:02:19.17,0:02:20.75,Default,,0000,0000,0000,,!هذان الضابطان يتصرفان بغرابة
Dialogue: 0,0:02:22.13,0:02:25.37,Default,,0000,0000,0000,,ربما وقعت حادثة، هناك إصابة برأسه
Dialogue: 0,0:02:26.58,0:02:27.57,Default,,0000,0000,0000,,!أين ذهب الفتى؟
Dialogue: 0,0:02:28.04,0:02:29.70,Default,,0000,0000,0000,,!قد تكون لدينا جريمة هنا! ابحث عنه
Dialogue: 0,0:02:29.70,0:02:30.83,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:02:32.00,0:02:34.99,On Top,,0000,0000,0000,,وكالة موري للتحرّي
Dialogue: 0,0:02:33.20,0:02:34.99,Default,,0000,0000,0000,,عُدت
Dialogue: 0,0:02:34.99,0:02:36.86,Default,,0000,0000,0000,,!رجعتِ يا ران
Dialogue: 0,0:02:36.86,0:02:40.15,Default,,0000,0000,0000,,!يا إلهي يا أبي! كفّ عن رمي القمامة هكذا
Dialogue: 0,0:02:40.15,0:02:44.86,Default,,0000,0000,0000,,!لهذا لا تتلقى أيّ طلبات عمل! ولهذا تركتك أمّي
Dialogue: 0,0:02:44.86,0:02:47.18,Default,,0000,0000,0000,,أنا أختار الأعمال التي أقبلها
Dialogue: 0,0:02:47.18,0:02:50.56,Default,,0000,0000,0000,,بأيّ حال، أين ذاك الفتى الذي\Nيلعب لعبة المتحرّي؟
Dialogue: 0,0:02:50.56,0:02:52.77,Default,,0000,0000,0000,,ألم يكن معك؟
Dialogue: 0,0:02:52.77,0:02:55.71,Default,,0000,0000,0000,,كان كذلك قبل مغادرتنا حديقة الملاهي
Dialogue: 0,0:02:55.71,0:02:57.24,Default,,0000,0000,0000,,...لكن عندها
Dialogue: 0,0:02:57.24,0:02:59.76,Default,,0000,0000,0000,,!آسف يا ران! ارجعي قبلي
Dialogue: 0,0:03:01.13,0:03:03.67,Default,,0000,0000,0000,,ما الذي يفعله شينتشي؟
Dialogue: 0,0:03:21.83,0:03:25.77,Default,,0000,0000,0000,,لم أركض مسافةً طويلة، ومع ذلك أنفاسي منقطعة
Dialogue: 0,0:03:30.68,0:03:33.18,Default,,0000,0000,0000,,!تـ-تقلّص جسدي
Dialogue: 0,0:03:34.77,0:03:36.22,Default,,0000,0000,0000,,!كيف؟
Dialogue: 0,0:03:36.22,0:03:38.62,Default,,0000,0000,0000,,...لحظة، أيمكن
Dialogue: 0,0:03:38.97,0:03:41.76,Default,,0000,0000,0000,,سنستعمل هذا، آخر سمّ طوّرته منظمتنا
Dialogue: 0,0:03:42.55,0:03:45.66,Default,,0000,0000,0000,,!أيمكن لأنّي تجرّعت ذاك العقار؟
Dialogue: 0,0:03:51.29,0:03:53.21,Default,,0000,0000,0000,,مرحباً، أنا كودو شينتشي
Dialogue: 0,0:03:53.21,0:03:54.97,Default,,0000,0000,0000,,لستُ موجوداً هذه اللحظة
Dialogue: 0,0:03:54.97,0:03:57.52,Default,,0000,0000,0000,,،إن كنت مهتماً بطلب خدماتي\Nفاترك اسمك ورقمك من فضلك
Dialogue: 0,0:03:57.52,0:04:00.04,Default,,0000,0000,0000,,غريب، لم يعد للبيت بعد
Dialogue: 0,0:04:00.04,0:04:04.74,Default,,0000,0000,0000,,إنّه يتناول العشاء مع أبيه الروائيّ في مطعم حتماً
Dialogue: 0,0:04:04.74,0:04:07.98,Default,,0000,0000,0000,,انتقل والدا شينتشي لأمريكا قبل 3 أعوام
Dialogue: 0,0:04:07.98,0:04:10.04,Default,,0000,0000,0000,,!ويعيش بمفرده الآن
Dialogue: 0,0:04:10.04,0:04:11.50,Default,,0000,0000,0000,,صحيح، هكذا إذاً
Dialogue: 0,0:04:12.02,0:04:15.70,Default,,0000,0000,0000,,لا بدّ أنّ أمراً حلّ به بعدها
Dialogue: 0,0:04:15.70,0:04:17.80,Default,,0000,0000,0000,,!سأذهب لمنزله
Dialogue: 0,0:04:17.80,0:04:20.10,Default,,0000,0000,0000,,!لحظة! ماذا عن عشائي؟
Dialogue: 0,0:04:24.82,0:04:28.78,Default,,0000,0000,0000,,!تبّاً! لا يمكنني دخول منزلي حتّى؟
Dialogue: 0,0:04:36.92,0:04:38.51,Default,,0000,0000,0000,,!بروفسور آغاسا
Dialogue: 0,0:04:38.51,0:04:39.80,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:04:39.80,0:04:41.83,Default,,0000,0000,0000,,!إنّه أنا! شينتشي
Dialogue: 0,0:04:42.46,0:04:44.38,Default,,0000,0000,0000,,قريب لشينتشي؟
Dialogue: 0,0:04:44.38,0:04:46.28,Default,,0000,0000,0000,,منزله هو المجاور
Dialogue: 0,0:04:46.28,0:04:48.25,Default,,0000,0000,0000,,!أنا شينتشي
Dialogue: 0,0:04:48.25,0:04:49.91,Default,,0000,0000,0000,,!سأخبرك عمَّ أعرفه عنك إذاً
Dialogue: 0,0:04:50.32,0:04:51.95,Default,,0000,0000,0000,,!اسمك آغاسا هيروشي، 52 عاماً
Dialogue: 0,0:04:51.95,0:04:54.81,Default,,0000,0000,0000,,أنت مخترع غريب الأطوار وتدّعي أنّك عبقري
Dialogue: 0,0:04:54.81,0:04:56.60,Default,,0000,0000,0000,,!لكن كلّ ما تصنعه هو خردة
Dialogue: 0,0:04:56.60,0:04:59.28,Default,,0000,0000,0000,,!كما لديك شامة على مؤخرتك بشعرة بارزة
Dialogue: 0,0:04:59.28,0:05:02.23,Default,,0000,0000,0000,,!شينتشي وحده يعرف ذلك
Dialogue: 0,0:05:02.89,0:05:05.61,Default,,0000,0000,0000,,ينشر أسراري بين الناس إذاً
Dialogue: 0,0:05:05.61,0:05:08.26,Default,,0000,0000,0000,,!كلا! أعرف لأنّي شينتشي
Dialogue: 0,0:05:08.26,0:05:10.66,Default,,0000,0000,0000,,!أُجبرت على تجرّع عقار غريب وتقلّص جسدي
Dialogue: 0,0:05:11.22,0:05:12.80,Default,,0000,0000,0000,,عقار قلّص جسدك؟
Dialogue: 0,0:05:12.80,0:05:13.62,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:05:15.42,0:05:18.79,Default,,0000,0000,0000,,!أشكّ كثيراً بوجود هكذا عقار
Dialogue: 0,0:05:18.79,0:05:21.33,Default,,0000,0000,0000,,!أيّها الشقي المريب! سآخذك للشرطة
Dialogue: 0,0:05:21.33,0:05:22.93,Default,,0000,0000,0000,,بروفسور! تعثرت في طريق عودتك مسرعاً
Dialogue: 0,0:05:22.93,0:05:25.03,Default,,0000,0000,0000,,من مطعم كولومبو، أليس كذلك؟
Dialogue: 0,0:05:25.91,0:05:27.49,Default,,0000,0000,0000,,كـ-كيف تعرف؟
Dialogue: 0,0:05:27.82,0:05:29.28,Default,,0000,0000,0000,,ملابسك يا بروفسور
Dialogue: 0,0:05:29.28,0:05:32.74,Default,,0000,0000,0000,,مُقدمة ثيابك لا تزال مُبللة، بينما الجانب الخلفي جاف تماماً
Dialogue: 0,0:05:32.74,0:05:35.06,Default,,0000,0000,0000,,هذا دليلٌ على أنك كنت تركض في المطر
Dialogue: 0,0:05:35.06,0:05:36.95,Default,,0000,0000,0000,,كما هناك وحل على بنطالك
Dialogue: 0,0:05:37.31,0:05:39.27,Default,,0000,0000,0000,,الشارع الوحيد الموحل في هذه المنطقة
Dialogue: 0,0:05:39.27,0:05:41.41,Default,,0000,0000,0000,,!هو ذاك قيد الإنشاء أمام كولومبو
Dialogue: 0,0:05:41.85,0:05:45.39,Default,,0000,0000,0000,,كما لا تزال صلصة لحم كولومبو الخاصة عالقة على شاربيك
Dialogue: 0,0:05:46.93,0:05:48.24,Default,,0000,0000,0000,,مـ-من أنت؟
Dialogue: 0,0:05:50.26,0:05:52.33,Default,,0000,0000,0000,,!هذا بسيط يا آغاسا-كن
Dialogue: 0,0:05:52.59,0:05:55.27,Default,,0000,0000,0000,,شـ-شينتشي؟
Dialogue: 0,0:05:57.13,0:05:58.58,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:05:58.58,0:06:04.74,Default,,0000,0000,0000,,السم غير المكتمل قلّص جسدك بشكل غامض
Dialogue: 0,0:06:05.03,0:06:06.82,Default,,0000,0000,0000,,هذه فحوى الموضوع
Dialogue: 0,0:06:06.82,0:06:10.04,Default,,0000,0000,0000,,يا للسخافة، ملابسي من صغري تلائمني تماماً
Dialogue: 0,0:06:11.11,0:06:13.27,Default,,0000,0000,0000,,أرجوك يا بروفسور! أنت عبقري، أليس كذلك؟
Dialogue: 0,0:06:13.27,0:06:16.51,Default,,0000,0000,0000,,!اصنع دواءً يعيدني لطبيعتي
Dialogue: 0,0:06:16.51,0:06:19.69,Default,,0000,0000,0000,,رويدك! لا أعرف مكوّنات العقار الذي تجرعته حتّى
Dialogue: 0,0:06:20.10,0:06:22.26,Default,,0000,0000,0000,,كلّ ما علينا فعله هو العثور عليهم إذاً
Dialogue: 0,0:06:22.26,0:06:24.03,Default,,0000,0000,0000,,!ثمّ أخذ ذاك العقار
Dialogue: 0,0:06:24.03,0:06:27.05,Default,,0000,0000,0000,,حسناً، سيساعد ذلك حتماً
Dialogue: 0,0:06:27.05,0:06:28.38,Default,,0000,0000,0000,,اسمع يا شينتشي
Dialogue: 0,0:06:28.38,0:06:30.25,Default,,0000,0000,0000,,إن عرفوا أنّك لا تزال حيّاً
Dialogue: 0,0:06:30.25,0:06:32.92,Default,,0000,0000,0000,,سيعودون للقضاء عليك
Dialogue: 0,0:06:32.92,0:06:35.58,Default,,0000,0000,0000,,!لذا أبقِ ما حصل سرّاً بيننا فقط
Dialogue: 0,0:06:35.58,0:06:37.16,Default,,0000,0000,0000,,!إيّاك أن تخبر أحداً
Dialogue: 0,0:06:37.16,0:06:38.99,Default,,0000,0000,0000,,!حتّى ران-كن بالطبع
Dialogue: 0,0:06:38.99,0:06:41.04,Default,,0000,0000,0000,,شينتشي! أأنت موجود؟
Dialogue: 0,0:06:41.04,0:06:41.99,Default,,0000,0000,0000,,!إنّها ران
Dialogue: 0,0:06:41.99,0:06:43.74,Default,,0000,0000,0000,,!كلا! اختبئ بسرعة
Dialogue: 0,0:06:43.74,0:06:46.07,Default,,0000,0000,0000,,!إن كنت في المنزل فأجب على الهاتف على الأقل
Dialogue: 0,0:06:47.57,0:06:50.61,Default,,0000,0000,0000,,ماذا؟ بروفسور آغاسا؟\Nأين شينتشي؟
Dialogue: 0,0:06:50.61,0:06:52.53,Default,,0000,0000,0000,,...في الواقع، إنّه
Dialogue: 0,0:06:51.31,0:06:52.53,Default,,0000,0000,0000,,نظّارات أبي
Dialogue: 0,0:06:52.53,0:06:54.64,Default,,0000,0000,0000,,!وقت التنكر
Dialogue: 0,0:06:52.53,0:06:54.64,On Top,,0000,0000,0000,,ليس هنا؟
Dialogue: 0,0:06:54.64,0:06:55.61,Default,,0000,0000,0000,,!إنّها حادة
Dialogue: 0,0:06:55.61,0:06:57.89,Default,,0000,0000,0000,,ماذا؟ أهناك أحد؟
Dialogue: 0,0:06:59.64,0:07:01.72,Default,,0000,0000,0000,,لا بد أنّك خجول حقاً
Dialogue: 0,0:07:01.72,0:07:03.89,Default,,0000,0000,0000,,هيّا، التفت لي
Dialogue: 0,0:07:05.30,0:07:07.40,Default,,0000,0000,0000,,...إ-إنّه
Dialogue: 0,0:07:09.07,0:07:10.61,Default,,0000,0000,0000,,!ظريفٌ جداً
Dialogue: 0,0:07:12.01,0:07:13.53,Default,,0000,0000,0000,,صدرها
Dialogue: 0,0:07:14.27,0:07:15.52,Default,,0000,0000,0000,,من هذا الصبيّ؟
Dialogue: 0,0:07:15.52,0:07:17.91,Default,,0000,0000,0000,,إنّه ابن قريبٍ بعيد الصلة لي
Dialogue: 0,0:07:17.91,0:07:18.98,Default,,0000,0000,0000,,ما اسمك؟
Dialogue: 0,0:07:18.98,0:07:22.37,Default,,0000,0000,0000,,...ا-اسمي شينـ
Dialogue: 0,0:07:22.37,0:07:23.86,Default,,0000,0000,0000,,...أقصد
Dialogue: 0,0:07:27.73,0:07:28.64,Default,,0000,0000,0000,,!كونان
Dialogue: 0,0:07:28.64,0:07:30.72,Default,,0000,0000,0000,,!اسمي إيدوغاوا كونان
Dialogue: 0,0:07:31.31,0:07:34.23,Default,,0000,0000,0000,,كونان؟ اسمٌ غريب
Dialogue: 0,0:07:34.23,0:07:37.57,Default,,0000,0000,0000,,...كان أبي مُعجباً كبيراً بكونان دويل، لذا
Dialogue: 0,0:07:38.26,0:07:40.53,Default,,0000,0000,0000,,يذكّرني بشينتشي نوعاً ما
Dialogue: 0,0:07:40.53,0:07:42.26,Default,,0000,0000,0000,,!صحيح يا ران-كن
Dialogue: 0,0:07:42.26,0:07:45.83,Default,,0000,0000,0000,,أيمكنك تركه يقيم في منزلك لبعض الوقت؟
Dialogue: 0,0:07:45.83,0:07:46.98,Default,,0000,0000,0000,,...ما الذي تقولـ
Dialogue: 0,0:07:47.83,0:07:50.08,Default,,0000,0000,0000,,والداه في المشفى بعد تعرّضهما لحادث
Dialogue: 0,0:07:50.08,0:07:54.78,Default,,0000,0000,0000,,...طلبا مني رعايته، لكنّي رجلٌ بمفردي فلذا
Dialogue: 0,0:07:54.78,0:07:57.53,Default,,0000,0000,0000,,لا بأس، لكنّي سأسأل أبي أوّلاً
Dialogue: 0,0:07:57.53,0:08:00.03,Default,,0000,0000,0000,,أجل! لا تمانعين أخذه إذاً؟
Dialogue: 0,0:08:00.03,0:08:01.20,Default,,0000,0000,0000,,أليس هذا رائعاً يا كونان؟
Dialogue: 0,0:08:01.66,0:08:05.35,Default,,0000,0000,0000,,ماذا لو كشفت ران هويّتي وأنا هناك؟
Dialogue: 0,0:08:05.35,0:08:07.48,Default,,0000,0000,0000,,أوّل خطوة لإعادتك لطبيعتك
Dialogue: 0,0:08:07.48,0:08:11.20,Default,,0000,0000,0000,,هي العثور على الرجال بالرداء الأسود\Nالذين استعملوا العقار عليك
Dialogue: 0,0:08:11.69,0:08:14.10,Default,,0000,0000,0000,,!ومنزل ران-كن وكالة تحرٍّ
Dialogue: 0,0:08:14.10,0:08:16.47,Default,,0000,0000,0000,,!قد تمرّ على أبيها معلومات عنهم
Dialogue: 0,0:08:16.47,0:08:17.57,Default,,0000,0000,0000,,!تماماً
Dialogue: 0,0:08:23.09,0:08:24.28,Default,,0000,0000,0000,,أخبرني يا كونان-كن
Dialogue: 0,0:08:25.17,0:08:27.00,Default,,0000,0000,0000,,أجل؟
Dialogue: 0,0:08:27.00,0:08:28.73,Default,,0000,0000,0000,,لن أعتاد على هذا الاسم أبداً
Dialogue: 0,0:08:29.17,0:08:31.08,Default,,0000,0000,0000,,أيوجد أحد تحبّه؟
Dialogue: 0,0:08:31.08,0:08:34.20,Default,,0000,0000,0000,,فتاة في المدرسة وما شابه
Dialogue: 0,0:08:34.49,0:08:36.65,Default,,0000,0000,0000,,كلا، لا لديّ
Dialogue: 0,0:08:37.20,0:08:40.11,Default,,0000,0000,0000,,أنا أملك شخصاً يعجبني كثيراً
Dialogue: 0,0:08:41.28,0:08:45.36,Default,,0000,0000,0000,,أيمكن أنّه شينتشي-نيتشان الذي كنتِ\Nتبحثين عنه قبل قليل؟
Dialogue: 0,0:08:47.44,0:08:48.32,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:08:50.26,0:08:51.90,Default,,0000,0000,0000,,لطالما كان مزعجاً مُذ صغره
Dialogue: 0,0:08:51.90,0:08:53.97,Default,,0000,0000,0000,,ومغترّاً كثيراً بنفسه
Dialogue: 0,0:08:53.97,0:08:59.53,Default,,0000,0000,0000,,ومهووس تحرٍّ، لكنه أهل للثقة متى استدعت\Nالحاجة، كما رائعٌ وشجاع
Dialogue: 0,0:09:00.26,0:09:03.45,Default,,0000,0000,0000,,أنا أُحب شينتشي كثيراً
Dialogue: 0,0:09:05.79,0:09:08.42,Default,,0000,0000,0000,,لكن أبقِ هذا سرّاً عنه
Dialogue: 0,0:09:10.90,0:09:12.74,Default,,0000,0000,0000,,هذا هو منزلي
Dialogue: 0,0:09:12.74,0:09:15.36,Default,,0000,0000,0000,,أشعر كأنّي حصلت على أخ صغير ظريف
Dialogue: 0,0:09:15.36,0:09:17.48,Default,,0000,0000,0000,,كأن بإمكاني الكلام معك في أيّ شيء يا كونان-كن
Dialogue: 0,0:09:18.15,0:09:19.26,Default,,0000,0000,0000,,...ران
Dialogue: 0,0:09:19.89,0:09:21.47,Default,,0000,0000,0000,,سأعرّفك على أبي، اتبعني
Dialogue: 0,0:09:23.98,0:09:26.23,Default,,0000,0000,0000,,...ران، أنا
Dialogue: 0,0:09:27.27,0:09:29.80,Default,,0000,0000,0000,,...فـ-في الواقع
Dialogue: 0,0:09:32.05,0:09:32.85,Default,,0000,0000,0000,,...أنا
Dialogue: 0,0:09:32.85,0:09:34.76,Default,,0000,0000,0000,,!أتى! أتى! أتى
Dialogue: 0,0:09:34.76,0:09:36.25,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:09:37.34,0:09:39.17,Default,,0000,0000,0000,,!أوّل عمل لي في 6 أشهر
Dialogue: 0,0:09:39.17,0:09:41.00,Default,,0000,0000,0000,,!اختطف أحدهم ابنة رجلٍ ثري
Dialogue: 0,0:09:41.00,0:09:42.60,Default,,0000,0000,0000,,!شخص برداء أسود
Dialogue: 0,0:09:42.60,0:09:45.46,Default,,0000,0000,0000,,!شـ-شخص برداء أسود؟
Dialogue: 0,0:09:48.56,0:09:50.02,Default,,0000,0000,0000,,!تاكسي
Dialogue: 0,0:09:51.49,0:09:52.86,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:09:57.95,0:09:59.69,Default,,0000,0000,0000,,هذه القضية تناديني
Dialogue: 0,0:09:59.69,0:10:03.40,Default,,0000,0000,0000,,!المتحرّي العظيم موري كوغورو
Dialogue: 0,0:10:05.31,0:10:07.19,Default,,0000,0000,0000,,!لمَ أنتِ هنا؟
Dialogue: 0,0:10:07.19,0:10:09.22,Default,,0000,0000,0000,,!لأنّه صعد قبل أن أتمكن من إيقافه
Dialogue: 0,0:10:09.22,0:10:11.51,Default,,0000,0000,0000,,!أنا في سيّارة! مرحى
Dialogue: 0,0:10:11.51,0:10:12.84,Default,,0000,0000,0000,,!ومن هذا الفتى؟
Dialogue: 0,0:10:12.84,0:10:14.60,Default,,0000,0000,0000,,!إنّه لقريب للبروفسور آغاسا
Dialogue: 0,0:10:14.60,0:10:17.01,Default,,0000,0000,0000,,!لا تعترضا عملي! اخرجا
Dialogue: 0,0:10:17.01,0:10:19.92,Default,,0000,0000,0000,,!لا يمكننا! نحن في الخطّ السريع
Dialogue: 0,0:10:22.83,0:10:25.43,Default,,0000,0000,0000,,المُختطفة هي ابنتي الوحيدة
Dialogue: 0,0:10:25.43,0:10:27.89,Default,,0000,0000,0000,,تاني أكيكو، 10 أعوام
Dialogue: 0,0:10:27.89,0:10:30.82,Default,,0000,0000,0000,,رأى كبير خدمي أساو الفاعل بأم عينيه
Dialogue: 0,0:10:30.82,0:10:33.16,Default,,0000,0000,0000,,تبّاً، لا أستطيع رؤية الصورة
Dialogue: 0,0:10:33.16,0:10:34.95,Default,,0000,0000,0000,,قصر القامة مزعج حقّاً
Dialogue: 0,0:10:37.42,0:10:39.43,Default,,0000,0000,0000,,ما كانت الظروف المحيطة عندما اختُطفت؟
Dialogue: 0,0:10:40.36,0:10:42.15,Default,,0000,0000,0000,,من هذا الصبيّ؟
Dialogue: 0,0:10:42.15,0:10:43.81,Default,,0000,0000,0000,,...أحد المعارف فقط
Dialogue: 0,0:10:44.15,0:10:46.27,Default,,0000,0000,0000,,!ران! راقبيه
Dialogue: 0,0:10:46.69,0:10:49.34,Default,,0000,0000,0000,,إذاً يا آساو-سان، اشرح ما حصل بالتفصيل رجاءً
Dialogue: 0,0:10:49.97,0:10:54.80,Default,,0000,0000,0000,,وقعت الحادثة بعدما ذهبت للهو\Nفي الخارج بعد عودتها من المدرسة
Dialogue: 0,0:10:56.05,0:11:00.01,Default,,0000,0000,0000,,!ظهر رجل برداء أسود فجأةً من زاوية الحديقة
Dialogue: 0,0:11:00.67,0:11:02.79,Default,,0000,0000,0000,,أخبر ربّ البيت بهذه الرسالة
Dialogue: 0,0:11:02.79,0:11:07.79,Default,,0000,0000,0000,,إن أراد عودة ابنته، فليغلق شركته شهراً كاملاً
Dialogue: 0,0:11:07.79,0:11:11.43,Default,,0000,0000,0000,,!وإن أبلغ الشرطة فستفقد حياتها بالطبع
Dialogue: 0,0:11:11.43,0:11:12.91,Default,,0000,0000,0000,,،بعد قول هذا
Dialogue: 0,0:11:12.91,0:11:15.41,Default,,0000,0000,0000,,تسلّق المختطف شجرة الصنوبر وهرب للخارج
Dialogue: 0,0:11:15.41,0:11:17.39,Default,,0000,0000,0000,,أكان بذاك الرجل أيّ علامات مميّزة؟
Dialogue: 0,0:11:17.74,0:11:20.07,Default,,0000,0000,0000,,...نظري ليس كما كان عليه، لذا
Dialogue: 0,0:11:20.07,0:11:21.61,Default,,0000,0000,0000,,هذا مؤسف
Dialogue: 0,0:11:23.65,0:11:27.44,Default,,0000,0000,0000,,لا تتدخل في عمل أبي يا كونان-كن
Dialogue: 0,0:11:27.77,0:11:32.39,Default,,0000,0000,0000,,بالمناسبة، أسمع أيّ أحد آخر صوت المختطِف\Nأو أيّ صوت غريب؟
Dialogue: 0,0:11:32.39,0:11:38.85,Default,,0000,0000,0000,,كلا، كان الصمت مخيماً باستثناء صرخات\Nآساو-سان طلباً للنجدة
Dialogue: 0,0:11:39.05,0:11:42.26,Default,,0000,0000,0000,,مما يعني أنّ آساو-سان وحده من رأى الفاعل
Dialogue: 0,0:11:42.26,0:11:46.73,Default,,0000,0000,0000,,بناءً على طلبه، من المُرجّح أن المختطِف\Nموظّف من شركة منافسة
Dialogue: 0,0:11:46.73,0:11:50.58,Default,,0000,0000,0000,,!تبّاً! يريدون مالاً فوق طلبهم ذاك
Dialogue: 0,0:11:50.78,0:11:51.79,Default,,0000,0000,0000,,!مـ-مال؟
Dialogue: 0,0:11:51.79,0:11:53.43,Default,,0000,0000,0000,,!وصلني اتّصال قبل قليل
Dialogue: 0,0:11:53.90,0:11:56.57,Default,,0000,0000,0000,,!طلب مني تحضير 300 مليون، بعملة ورقية قديمة
Dialogue: 0,0:11:56.57,0:11:58.89,Default,,0000,0000,0000,,!لا بدّ أنّه خطأ ما يا سيّدي
Dialogue: 0,0:11:58.89,0:12:00.85,Default,,0000,0000,0000,,!اخرس! ابق صامتاً
Dialogue: 0,0:12:00.85,0:12:04.29,Default,,0000,0000,0000,,أيّ شركات ستستفيد من إغلاق شركتك؟
Dialogue: 0,0:12:05.02,0:12:08.64,Default,,0000,0000,0000,,هناك أمرٌ غريب بهذه القضيّة
Dialogue: 0,0:12:08.64,0:12:11.76,Default,,0000,0000,0000,,لمَ خطفها الفاعل داخل منزلها؟
Dialogue: 0,0:12:11.76,0:12:14.56,Default,,0000,0000,0000,,الأمر أسهل لو اختطفها في طريقها من المدرسة
Dialogue: 0,0:12:14.56,0:12:18.22,Default,,0000,0000,0000,,كما رؤية أحد له إهمال كبير
Dialogue: 0,0:12:18.97,0:12:24.50,Default,,0000,0000,0000,,...لكنّ طلب عملات قديمة إجراء حذِر غريب
Dialogue: 0,0:12:24.50,0:12:27.46,Default,,0000,0000,0000,,أنتَ بارع في كرة القدم يا كونان-كن
Dialogue: 0,0:12:27.46,0:12:28.77,Default,,0000,0000,0000,,نوعاً ما
Dialogue: 0,0:12:29.15,0:12:32.70,Default,,0000,0000,0000,,كان شينتشي يفعل مثلك دوماً عندما يفكر بشيء
Dialogue: 0,0:12:32.70,0:12:35.18,Default,,0000,0000,0000,,يقول أنّ هذا يحفّز دماغه للعمل
Dialogue: 0,0:12:35.57,0:12:38.65,Default,,0000,0000,0000,,!شينتشي ذاك هو أنا
Dialogue: 0,0:12:44.43,0:12:46.02,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:12:53.10,0:12:57.06,Default,,0000,0000,0000,,من النادر أن يكون جامبو ودوداً مع غريب
Dialogue: 0,0:12:59.54,0:13:05.00,Default,,0000,0000,0000,,تسلّق الخاطف شجرة الصنوبر هذه للتسلل \Nللداخل ثم الخروج
Dialogue: 0,0:13:05.00,0:13:08.76,Default,,0000,0000,0000,,!مما يعني أنّ الكلب نبح عليه حتماً
Dialogue: 0,0:13:08.76,0:13:11.47,Default,,0000,0000,0000,,!فهمت! حللت هذه القضية
Dialogue: 0,0:13:11.78,0:13:15.43,Default,,0000,0000,0000,,يبدو أنّ هذا الكلب ينبح تّجاه كل الغرباء، صحيح؟
Dialogue: 0,0:13:15.82,0:13:19.39,Default,,0000,0000,0000,,أجل، فجامبو من أفضل كلاب الحراسة
Dialogue: 0,0:13:19.39,0:13:21.60,Default,,0000,0000,0000,,لحظة، قال الخدم أنّ المكان\Nكان هادئاً تماماً
Dialogue: 0,0:13:21.60,0:13:24.77,Default,,0000,0000,0000,,باستثناء وقت صراخ كبير الخدم
Dialogue: 0,0:13:28.39,0:13:30.35,Default,,0000,0000,0000,,أين تذهب يا أساو-سان؟
Dialogue: 0,0:13:31.84,0:13:33.60,Default,,0000,0000,0000,,أدرك الأمر
Dialogue: 0,0:13:33.84,0:13:37.01,Default,,0000,0000,0000,,!هناك أمرٌ غريب بروايتك
Dialogue: 0,0:13:37.01,0:13:42.13,Default,,0000,0000,0000,,تسلل الخاطف وأخذ الفتاة وهرب عبر تلك الشجرة
Dialogue: 0,0:13:42.13,0:13:43.89,Default,,0000,0000,0000,,!مع ذلك لم ينبح كلب الحراسة أبداً
Dialogue: 0,0:13:44.50,0:13:45.85,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:13:45.85,0:13:50.37,Default,,0000,0000,0000,,كما أنّ شهادتك مليئة بالغموض
Dialogue: 0,0:13:50.37,0:13:54.81,Default,,0000,0000,0000,,أكان هناك رجلاً موشوحاً بالسواد حقاً يا آساو-سان؟
Dialogue: 0,0:13:55.91,0:13:58.72,Default,,0000,0000,0000,,!أو بالأحرى، يا مختطِف
Dialogue: 0,0:13:58.72,0:14:01.18,Default,,0000,0000,0000,,!آساو! كيف تجرؤ؟
Dialogue: 0,0:14:01.40,0:14:03.65,Default,,0000,0000,0000,,!أقدّم خالص اعتذاري سيّدي
Dialogue: 0,0:14:03.65,0:14:05.52,Default,,0000,0000,0000,,!لمَ أقدمت على فعلتك؟
Dialogue: 0,0:14:05.52,0:14:07.14,Default,,0000,0000,0000,,!أأمرك أحد؟
Dialogue: 0,0:14:07.30,0:14:10.10,Default,,0000,0000,0000,,!كلا! قمتُ بهذا من تلقاء نفسي
Dialogue: 0,0:14:10.63,0:14:13.50,Default,,0000,0000,0000,,أين الفتاة الآن إذاً؟
Dialogue: 0,0:14:13.50,0:14:15.06,Default,,0000,0000,0000,,...في فندق بالقرب
Dialogue: 0,0:14:17.41,0:14:19.43,Default,,0000,0000,0000,,!أُغلقت القضية
Dialogue: 0,0:14:19.43,0:14:25.02,Default,,0000,0000,0000,,!لا قضيّة تستعصي مع المتحرّي موري كوغورو
Dialogue: 0,0:14:25.45,0:14:27.70,Default,,0000,0000,0000,,!كلا! لم ينته الأمر بعد
Dialogue: 0,0:14:28.81,0:14:31.63,Default,,0000,0000,0000,,!لا يزال هناك جانب آخر لهذه القضيّة
Dialogue: 0,0:14:41.89,0:14:43.89,Default,,0000,0000,0000,,!سيّدي! هناك اتّصال
Dialogue: 0,0:14:44.39,0:14:47.06,Default,,0000,0000,0000,,أنا مشغول. أخبريه بالاتصال لاحقاً
Dialogue: 0,0:14:47.06,0:14:48.34,Default,,0000,0000,0000,,...لـ-لكن
Dialogue: 0,0:14:50.05,0:14:50.88,Default,,0000,0000,0000,,تاني معك
Dialogue: 0,0:14:50.88,0:14:52.92,Default,,0000,0000,0000,,هل الثلاثمئة مليون جاهزة؟
Dialogue: 0,0:14:54.05,0:14:55.27,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:14:57.54,0:14:59.79,Default,,0000,0000,0000,,اتّصلت بك قبل قليل
Dialogue: 0,0:14:59.79,0:15:02.06,Default,,0000,0000,0000,,أنا مُختطف ابنتك
Dialogue: 0,0:15:02.06,0:15:04.52,Default,,0000,0000,0000,,...ذلك مُحال! المختطف بالفعل قد
Dialogue: 0,0:15:04.83,0:15:06.66,Default,,0000,0000,0000,,!كان لديك متواطئ إذاً؟
Dialogue: 0,0:15:06.66,0:15:09.47,Default,,0000,0000,0000,,!كلا، كنت بمفردي! صدّقني رجاءً
Dialogue: 0,0:15:10.36,0:15:13.15,Default,,0000,0000,0000,,هذا الرجل يقول الحقيقة
Dialogue: 0,0:15:13.15,0:15:16.43,Default,,0000,0000,0000,,،بعد أن اُختطفت الفتاة في أوّل مرة
Dialogue: 0,0:15:16.82,0:15:21.35,Default,,0000,0000,0000,,تمّ اختطافها مُجدداً من قِبل شخص\Nآخر على الأرجح
Dialogue: 0,0:15:21.35,0:15:23.39,Default,,0000,0000,0000,,شخص أكثر شرّاً
Dialogue: 0,0:15:23.53,0:15:24.85,Default,,0000,0000,0000,,!أبي! النجدة
Dialogue: 0,0:15:24.85,0:15:25.85,Default,,0000,0000,0000,,!أكيكو
Dialogue: 0,0:15:28.09,0:15:30.13,Default,,0000,0000,0000,,أنا رجلٌ قصير الصبر
Dialogue: 0,0:15:30.13,0:15:32.47,Default,,0000,0000,0000,,جهّز الثلاثمئة مليون سريعاً
Dialogue: 0,0:15:32.47,0:15:34.27,Default,,0000,0000,0000,,وإلّا لستُ مسؤولاً عمَّ سيحلّ بابنتك
Dialogue: 0,0:15:34.84,0:15:37.29,Default,,0000,0000,0000,,!أرجوك! سأجلب المال بطريقة ما
Dialogue: 0,0:15:37.29,0:15:39.72,Default,,0000,0000,0000,,!أعد أكيكو سليمة فقط
Dialogue: 0,0:15:39.72,0:15:43.83,Default,,0000,0000,0000,,واصل الكلام وحاول استخراج موقعه
Dialogue: 0,0:15:43.83,0:15:44.92,Default,,0000,0000,0000,,موقعه؟
Dialogue: 0,0:15:44.92,0:15:46.18,Default,,0000,0000,0000,,من معك؟
Dialogue: 0,0:15:46.66,0:15:48.15,Default,,0000,0000,0000,,لا تخبرني أنّها الشرطة
Dialogue: 0,0:15:48.15,0:15:49.89,Default,,0000,0000,0000,,...كلا! ليست الشرطة
Dialogue: 0,0:15:49.89,0:15:51.85,Default,,0000,0000,0000,,!أبي! أنا في مخزن مدرسة
Dialogue: 0,0:15:52.15,0:15:54.40,Default,,0000,0000,0000,,...أرى مدخنةً كبيرة من النافذة
Dialogue: 0,0:15:54.40,0:15:55.31,Default,,0000,0000,0000,,!أكيكو
Dialogue: 0,0:15:55.31,0:15:57.35,Default,,0000,0000,0000,,سأعاود الاتصال في ساعة
Dialogue: 0,0:15:57.35,0:15:58.89,Default,,0000,0000,0000,,لتجهّز المال حينها
Dialogue: 0,0:16:00.98,0:16:02.31,Default,,0000,0000,0000,,شقيّة ثرثارة
Dialogue: 0,0:16:03.31,0:16:06.81,Default,,0000,0000,0000,,مدخنة كبيرة يمكن رؤيتها من مخزن مدرسة
Dialogue: 0,0:16:06.81,0:16:09.30,Default,,0000,0000,0000,,ليست معلومة كافية لتحديد أيّ مدرسة
Dialogue: 0,0:16:09.51,0:16:13.34,Default,,0000,0000,0000,,بأيّ حال، وفّر لنا وقتاً بتجهيز المال
Dialogue: 0,0:16:13.34,0:16:14.77,Default,,0000,0000,0000,,حـ-حسناً
Dialogue: 0,0:16:18.46,0:16:20.96,Default,,0000,0000,0000,,الخاطف متوتر الآن بما أنّنا مدركون لموقعه
Dialogue: 0,0:16:20.96,0:16:23.14,Default,,0000,0000,0000,,...إلم ننقذ الفتاة سريعاً
Dialogue: 0,0:16:23.14,0:16:25.71,Default,,0000,0000,0000,,ماذا تفعل يا كونان-كن؟
Dialogue: 0,0:16:25.71,0:16:28.49,Default,,0000,0000,0000,,لم يمرّ وقت طويل على اختطافها
Dialogue: 0,0:16:28.49,0:16:31.10,Default,,0000,0000,0000,,فظننتُ أنّها قد تكون قريبة
Dialogue: 0,0:16:31.41,0:16:32.53,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:16:32.53,0:16:36.11,Default,,0000,0000,0000,,من المحال أنّه ابتعد بفتاة صغيرة معه
Dialogue: 0,0:16:36.11,0:16:39.55,Default,,0000,0000,0000,,،إن قلّصنا الاحتمالات ضمن المنطقة لمجاورة\Nستكون مدارس معدودة
Dialogue: 0,0:16:39.55,0:16:41.30,Default,,0000,0000,0000,,!أين تذهب يا كونان-كن؟
Dialogue: 0,0:16:41.30,0:16:42.97,Default,,0000,0000,0000,,!ران! لنلحق بالكلب
Dialogue: 0,0:16:42.97,0:16:43.56,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:16:48.09,0:16:50.59,Default,,0000,0000,0000,,المدخنة التي تراها غالباً تعود لمصنع أو حمّام عام
Dialogue: 0,0:16:50.59,0:16:53.68,Default,,0000,0000,0000,,توجد 5 مدارس فقط في هذه المنطقة\Nحيث ترى منها مداخناً
Dialogue: 0,0:17:06.70,0:17:07.55,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:17:08.92,0:17:09.51,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:17:10.83,0:17:12.12,Default,,0000,0000,0000,,!ليست هذه أيضاً
Dialogue: 0,0:17:12.32,0:17:15.27,Default,,0000,0000,0000,,!تبّاً! لم تكن أيّاً منها
Dialogue: 0,0:17:15.74,0:17:18.39,Default,,0000,0000,0000,,لم تبق هناك مدارس بإطلالات على مداخن
Dialogue: 0,0:17:18.39,0:17:20.62,Default,,0000,0000,0000,,لعلها ليست في هذه المنطقة بالفعل
Dialogue: 0,0:17:25.46,0:17:27.38,Default,,0000,0000,0000,,...لحظة، أيمكن
Dialogue: 0,0:17:46.37,0:17:47.71,Default,,0000,0000,0000,,!هذه هي
Dialogue: 0,0:17:48.28,0:17:51.17,Default,,0000,0000,0000,,!رأت هذا البناء من الجانب وظنّته مدخنة
Dialogue: 0,0:17:51.73,0:17:54.65,Default,,0000,0000,0000,,...المدارس في الجوار بمنظر جانبي لهذا البناء
Dialogue: 0,0:17:57.23,0:17:58.51,Default,,0000,0000,0000,,!مدرسة فوتاتسوباشي الإعدادية
Dialogue: 0,0:18:00.51,0:18:03.51,Default,,0000,0000,0000,,ضع المال على المقعد في حديقة هياكوجي
Dialogue: 0,0:18:03.51,0:18:05.72,Default,,0000,0000,0000,,وسأعيد ابنتك بعدما يصبح بحوزتي
Dialogue: 0,0:18:05.72,0:18:08.41,Default,,0000,0000,0000,,!دعني أسمع صوت أكيكو مُجدداً
Dialogue: 0,0:18:08.41,0:18:10.14,Default,,0000,0000,0000,,ستسمعه بما يكفي لاحقاً
Dialogue: 0,0:18:12.08,0:18:13.91,Default,,0000,0000,0000,,وصلنا لاتّفاق
Dialogue: 0,0:18:13.91,0:18:16.84,Default,,0000,0000,0000,,أي أنّ دورك انتهى تقريباً
Dialogue: 0,0:18:21.40,0:18:22.01,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:18:25.40,0:18:27.02,Default,,0000,0000,0000,,!من هناك؟! أين أنت؟
Dialogue: 0,0:18:27.02,0:18:27.99,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:18:35.10,0:18:37.34,Default,,0000,0000,0000,,أنتِ بخير الآن
Dialogue: 0,0:18:37.34,0:18:38.93,Default,,0000,0000,0000,,من أنت؟
Dialogue: 0,0:18:38.93,0:18:40.05,Default,,0000,0000,0000,,كودو شينتشي
Dialogue: 0,0:18:40.05,0:18:43.92,Default,,0000,0000,0000,,أقصد... إيدوغاوا كونان، مُتحرٍّ
Dialogue: 0,0:18:44.43,0:18:45.80,Default,,0000,0000,0000,,مُتحرٍّ؟
Dialogue: 0,0:18:50.04,0:18:53.17,Default,,0000,0000,0000,,!لا تستهن بي أيّها الصبيّ العفن
Dialogue: 0,0:18:57.11,0:19:01.27,Default,,0000,0000,0000,,!تباً! قوّتي ضعيفة بهذا الجسد الضئيل
Dialogue: 0,0:19:03.03,0:19:05.26,Default,,0000,0000,0000,,!ما رأيك بهذه؟
Dialogue: 0,0:19:05.76,0:19:09.09,Default,,0000,0000,0000,,!لا جدوى! ضعفت قوّة ركلي أيضاً
Dialogue: 0,0:19:18.51,0:19:20.84,Default,,0000,0000,0000,,حتّى لو وجدتُ المجرمين
Dialogue: 0,0:19:20.84,0:19:24.61,Default,,0000,0000,0000,,!لا يمكنني القبض عليهم أو حتّى ضربهم بجسدي الصغير
Dialogue: 0,0:19:24.92,0:19:27.88,Default,,0000,0000,0000,,!انتهى وقت اللعب! تحضّر لموتك
Dialogue: 0,0:19:27.88,0:19:28.65,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:19:31.46,0:19:32.36,Default,,0000,0000,0000,,!سينال مني
Dialogue: 0,0:19:35.08,0:19:36.34,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:19:48.67,0:19:50.63,Default,,0000,0000,0000,,!قـ-قويّة
Dialogue: 0,0:19:50.86,0:19:52.48,Default,,0000,0000,0000,,كلّ شيء على ما يرام الآن
Dialogue: 0,0:19:52.48,0:19:54.15,Default,,0000,0000,0000,,كيف عرفتِ المكان؟
Dialogue: 0,0:19:54.15,0:19:57.58,Default,,0000,0000,0000,,لحقتُ بك ثم رأيت جامبو يخرج من هنا
Dialogue: 0,0:20:00.60,0:20:02.26,Default,,0000,0000,0000,,!جامبو
Dialogue: 0,0:20:02.26,0:20:04.82,Default,,0000,0000,0000,,!أنتَ الفاعل إذاً؟ تبّاً لك
Dialogue: 0,0:20:05.55,0:20:09.79,Default,,0000,0000,0000,,!قضية اختطاف؟ المُتحري موري كوغورو لها
Dialogue: 0,0:20:10.59,0:20:11.81,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:20:15.97,0:20:19.96,Default,,0000,0000,0000,,كنتُ من فكّرت بحادثة اختطافي هذه
Dialogue: 0,0:20:20.24,0:20:22.26,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:22.26,0:20:26.58,Default,,0000,0000,0000,,أنت مشغول دوماً بالعمل يا أبي\N...ولا تهتم لي
Dialogue: 0,0:20:26.58,0:20:30.77,Default,,0000,0000,0000,,لذا طلبت من آساو-سان مساعدتي وتولّي الاختطاف
Dialogue: 0,0:20:30.77,0:20:32.67,Default,,0000,0000,0000,,ظننت سيمكنك قضاء وقت معي
Dialogue: 0,0:20:32.67,0:20:35.36,Default,,0000,0000,0000,,!لو استرحت من شركتك قليلاً
Dialogue: 0,0:20:37.47,0:20:42.09,Default,,0000,0000,0000,,فهمت، كان الاختطاف الأوّل مزيفاً إذاً
Dialogue: 0,0:20:42.35,0:20:44.43,Default,,0000,0000,0000,,،ولو كان ذلك بناء على طلب ابنتي
Dialogue: 0,0:20:44.43,0:20:46.92,Default,,0000,0000,0000,,!من الصعب عليّ أن أصفح عمَّ فعلته
Dialogue: 0,0:20:46.92,0:20:48.25,Default,,0000,0000,0000,,!تدرك ذلك يا آساو، صحيح؟
Dialogue: 0,0:20:48.25,0:20:49.54,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:49.88,0:20:51.02,Default,,0000,0000,0000,,،عقاباً لك
Dialogue: 0,0:20:51.02,0:20:53.30,Default,,0000,0000,0000,,!ستتولى التجهيزات لرحلة أسبوع تبدأ غداً
Dialogue: 0,0:20:53.30,0:20:56.26,Default,,0000,0000,0000,,!الوجهة هي أستراليا التي لطالما أرادت أكيكو زيارتها
Dialogue: 0,0:20:56.26,0:20:58.13,Default,,0000,0000,0000,,!سـ-سيّدي
Dialogue: 0,0:20:58.13,0:21:01.70,Default,,0000,0000,0000,,سنذهب سويّاً بالطبع
Dialogue: 0,0:21:01.70,0:21:02.67,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:21:06.13,0:21:09.15,Default,,0000,0000,0000,,إطلاق الكلب كي يجد ابنتي كانت حركةً عبقرية
Dialogue: 0,0:21:09.15,0:21:11.34,Default,,0000,0000,0000,,كما يُتوقع من المتحري العظيم
Dialogue: 0,0:21:11.34,0:21:14.82,Default,,0000,0000,0000,,!كلا، كان ذلك بفضل تجاربي الكثيرة
Dialogue: 0,0:21:15.01,0:21:18.52,Default,,0000,0000,0000,,كنتُ أنا من وجدها، ما حقك بالكلام؟
Dialogue: 0,0:21:18.72,0:21:21.35,Default,,0000,0000,0000,,سأعبر عن امتناني لك في يوم آخر إذاً
Dialogue: 0,0:21:21.35,0:21:23.17,Default,,0000,0000,0000,,!أجل! أتطلّع لذلك
Dialogue: 0,0:21:25.88,0:21:27.94,Default,,0000,0000,0000,,!شكراً لك أيّها المتحري
Dialogue: 0,0:21:30.34,0:21:31.67,Default,,0000,0000,0000,,المتحري؟
Dialogue: 0,0:21:31.67,0:21:33.76,Default,,0000,0000,0000,,!كلا، لا تقصدني
Dialogue: 0,0:21:33.89,0:21:36.42,Default,,0000,0000,0000,,!بل تقصد عمّي حتماً
Dialogue: 0,0:21:41.25,0:21:43.75,Default,,0000,0000,0000,,أبي، بشأن هذا الفتى
Dialogue: 0,0:21:44.52,0:21:47.31,Default,,0000,0000,0000,,طلب مني البروفسور آغاسا الاعتناء به
Dialogue: 0,0:21:50.42,0:21:52.88,Default,,0000,0000,0000,,لستَ موافقاً؟
Dialogue: 0,0:21:54.44,0:21:55.56,Default,,0000,0000,0000,,!لا مشكلة
Dialogue: 0,0:21:55.56,0:21:59.38,Default,,0000,0000,0000,,حصلت على عمل حال ظهوره\Nثم حللت القضية بكلّ براعة
Dialogue: 0,0:21:59.38,0:22:01.26,Default,,0000,0000,0000,,!قد يكون إله حظّ حسن
Dialogue: 0,0:22:01.26,0:22:04.84,Default,,0000,0000,0000,,!ابقَ معنا وكن ابني
Dialogue: 0,0:23:48.36,0:23:50.98,Default,,0000,0000,0000,,!انتقلتُ هنا للتو! اسمي إيدوغاوا كونان
Dialogue: 0,0:23:50.98,0:23:52.00,Default,,0000,0000,0000,,!سُررت بلقائكم
Dialogue: 0,0:23:53.90,0:23:57.68,Default,,0000,0000,0000,,عليّ العودة للابتدائية؟
Dialogue: 0,0:24:00.35,0:24:01.88,Default,,0000,0000,0000,,...الفاعل
Dialogue: 0,0:24:02.14,0:24:03.46,Default,,0000,0000,0000,,!هو أنت
Dialogue: 0,0:24:04.43,0:24:08.17,Default,,0000,0000,0000,,لو كان شينتشي هنا، لحلّ هذه القضية بسهولة
Dialogue: 0,0:24:10.00,0:24:13.71,Default,,0000,0000,0000,,أين ذهب مهووس التحرّي ذاك؟
Dialogue: 0,0:24:13.71,0:24:14.59,Default,,0000,0000,0000,,!حارّ
Dialogue: 0,0:24:14.88,0:24:17.29,Default,,0000,0000,0000,,!موري-كن! كنتَ محقاً
Dialogue: 0,0:24:17.29,0:24:19.54,Default,,0000,0000,0000,,!تغيّرت نظرتي تجاهك أيّها المتحري العظيم
Dialogue: 0,0:24:19.83,0:24:24.01,Default,,0000,0000,0000,,...لا يمكنني أن أكون قويّةً مثلك يا يوكو-سان
Dialogue: 0,0:24:24.29,0:24:25.83,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:25.83,0:24:28.25,Default,,0000,0000,0000,,جريمة قتل خلف أبواب مغلقة لشقّة الفنّانة
Dialogue: 0,0:24:45.67,0:24:47.36,Default,,0000,0000,0000,,:تلميح الحلقة القادمة
Dialogue: 0,0:24:48.33,0:24:49.28,Default,,0000,0000,0000,,ثلج
Dialogue: 0,0:24:50.82,0:24:53.28,Default,,0000,0000,0000,,هل ستستطيعون التغلّب عليّ الحلقة القادمة؟

