Dialogue: 0,0:00:02.01,0:00:03.67,Default,,0000,0000,0000,,عقرب دقائق مسرِع، شهب لامعة
Dialogue: 0,0:00:03.67,0:00:06.82,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!المُثقلة بالمجتمع الحديث
Dialogue: 0,0:00:07.25,0:00:10.95,Default,,0000,0000,0000,,لقضيّة اليوم لونٌ مختلف! أيّ زهرة تحوي أشواكاً؟
Dialogue: 0,0:00:10.95,0:00:12.50,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.50,0:00:14.33,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.33,0:00:14.83,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:54.83,0:01:59.20,Default,,0000,0000,0000,,حفلة جائزة الفنّ العالميّ
Dialogue: 0,0:01:59.20,0:02:01.82,Default,,0000,0000,0000,,أفازت بجائزة كبيرة كهذه؟
Dialogue: 0,0:02:08.98,0:02:12.58,Default,,0000,0000,0000,,!انظر، انظر! إنّها الممثلة آوتشي ماريكا
Dialogue: 0,0:02:20.47,0:02:23.03,Default,,0000,0000,0000,,!انظر! إنّه تاكاهاتا كوجي، لاعب كرة القدم
Dialogue: 0,0:02:23.30,0:02:26.49,Default,,0000,0000,0000,,...يا إلهي، هذا يبدو بائساً فتوقّفي
Dialogue: 0,0:02:26.49,0:02:32.16,Default,,0000,0000,0000,,مذهل! مذهل! الكثير من الشخصيات \N!الشهيرة من النجوم للرياضيّين
Dialogue: 0,0:02:32.16,0:02:35.43,Default,,0000,0000,0000,,!أيّها الغبيّان! من تظنانني؟
Dialogue: 0,0:02:35.43,0:02:39.41,Default,,0000,0000,0000,,!أخبرتك أن تدعني! لقد اُستدعيت إلى هنا
Dialogue: 0,0:02:39.70,0:02:40.87,Default,,0000,0000,0000,,!أبي؟
Dialogue: 0,0:02:39.70,0:02:40.87,Default,,0000,0000,0000,,!العمّ؟
Dialogue: 0,0:02:42.28,0:02:44.11,Default,,0000,0000,0000,,ألا تعرفان وجه المتحرّي
Dialogue: 0,0:02:44.11,0:02:46.69,Default,,0000,0000,0000,,!العظيم منقطع النظير موري كوغورو؟
Dialogue: 0,0:02:47.31,0:02:51.70,Default,,0000,0000,0000,,المعذرة، لكن لا يستطيع الأشخاص\Nبلا بطاقة دعوة الدخول
Dialogue: 0,0:02:51.70,0:02:55.00,CharCard,,0000,0000,0004,,(أوزاكي ميدوري (33\Nمساعدة أوكانو ريكا
Dialogue: 0,0:02:52.19,0:02:55.04,On Top,,0000,0000,0000,,انتظرا، أنا استدعيته هنا
Dialogue: 0,0:02:55.81,0:02:57.40,Default,,0000,0000,0000,,أفهمتما الآن؟
Dialogue: 0,0:02:57.40,0:03:03.01,Default,,0000,0000,0000,,أتى المتحرّي العظيم منقطع النظير\Nموري كوغورو-ساما للساحة
Dialogue: 0,0:03:03.01,0:03:05.94,Default,,0000,0000,0000,,!للتحقيق في تهديد قتل
Dialogue: 0,0:03:06.33,0:03:08.15,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:03:09.10,0:03:15.16,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل رائحة الزهرة
Dialogue: 0,0:03:10.00,0:03:13.03,Default,,0000,0000,0000,,جريمة قتل رائحة الزهرة
Dialogue: 0,0:03:35.45,0:03:39.24,CharCard,,0000,0210,0004,,(28) أوكانو ريكا\N منظّمة أزهار ريادية
Dialogue: 0,0:03:40.18,0:03:44.45,Default,,0000,0000,0000,,تلقّينا رسالة التهديد قبل عدّة أيام
Dialogue: 0,0:03:46.69,0:03:50.66,Default,,0000,0000,0000,,ستتفتّح أزهار الموت في"\N"فندق بي فرونت
Dialogue: 0,0:03:50.66,0:03:54.79,Default,,0000,0000,0000,,لا بدّ أنّه مقلب، أنتِ تبالغين
Dialogue: 0,0:03:54.79,0:03:55.99,Default,,0000,0000,0000,,تجاهله وحسب
Dialogue: 0,0:03:56.53,0:04:02.33,Default,,0000,0000,0000,,لكن يا سينسي، هناك احتمال بكونه \Nحقيقيّاً، فلا ضرّ من الحذر
Dialogue: 0,0:04:02.33,0:04:06.19,Default,,0000,0000,0000,,إنّها مضايقة من أناس حاقدين\Nبسبب فوزيّ بالجائزة فقط
Dialogue: 0,0:04:06.19,0:04:10.28,Default,,0000,0000,0000,,إعطاؤهم أيّ اهتمام سيكون\Nإهداراً للوقت لا أكثر
Dialogue: 0,0:04:10.77,0:04:12.19,Default,,0000,0000,0000,,من هي؟
Dialogue: 0,0:04:12.19,0:04:16.26,Default,,0000,0000,0000,,أوكانو ريكا، فنّانة تنظيم أزهار ريادية
Dialogue: 0,0:04:16.26,0:04:18.68,Default,,0000,0000,0000,,تظهر في التلفاز كثيراً، ألا تراها؟
Dialogue: 0,0:04:18.68,0:04:20.28,Default,,0000,0000,0000,,تنظيم أزهار ريادية؟
Dialogue: 0,0:04:20.28,0:04:25.24,Default,,0000,0000,0000,,!إنّها مذهلة! تجعل براعم الأزهار تتفتّح فجأةً
Dialogue: 0,0:04:25.24,0:04:27.20,Default,,0000,0000,0000,,!كأنّها حيلة سحر
Dialogue: 0,0:04:27.71,0:04:33.12,Default,,0000,0000,0000,,يمكنك اعتبارها كذلك، لكن هل ستعتبرني\Nمحتالة فنّ عالمي أيضاً؟
Dialogue: 0,0:04:33.12,0:04:35.08,Default,,0000,0000,0000,,...يا لها من امرأة بغيضة
Dialogue: 0,0:04:35.46,0:04:37.78,Default,,0000,0000,0000,,يكمن السرّ في الحرارة في الواقع
Dialogue: 0,0:04:42.03,0:04:43.83,Default,,0000,0000,0000,,!سيّد شيراكي
Dialogue: 0,0:04:43.83,0:04:47.78,On Top,,0000,0000,0000,,سمعتُ عن تلقّيك لرسالة تهديد سخيفة
Dialogue: 0,0:04:44.12,0:04:47.87,CharCard,,0000,0000,0004,,{\fad(200,0)}(شيراكي دايسكي (58\Nمالك فندق بي فرونت
Dialogue: 0,0:04:48.23,0:04:49.49,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:04:49.49,0:04:52.02,Default,,0000,0000,0000,,،ليس أنّي أتوّقع ذلك
Dialogue: 0,0:04:52.02,0:04:56.32,Default,,0000,0000,0000,,لكن لن تكون هناك أيّ\Nتغييرات في حفلة اليوم، صحيح؟
Dialogue: 0,0:04:56.32,0:04:57.26,Default,,0000,0000,0000,,...ذلك
Dialogue: 0,0:04:57.26,0:04:58.81,Default,,0000,0000,0000,,لا تقلق رجاءً
Dialogue: 0,0:04:58.81,0:05:02.56,Default,,0000,0000,0000,,هذه الحفلة لي، سيمضي كلّ شيءٍ وفق الجدول
Dialogue: 0,0:05:02.56,0:05:04.74,Default,,0000,0000,0000,,لكن ماذا لو حصل شيءٌ ما؟
Dialogue: 0,0:05:04.74,0:05:06.38,Default,,0000,0000,0000,,ليست هذه الحفلة فحسب
Dialogue: 0,0:05:06.38,0:05:11.62,Default,,0000,0000,0000,,لا تنسي مجموعة شيراكي\Nالتي لطالما دعمتكِ رجاءً
Dialogue: 0,0:05:11.96,0:05:13.58,Default,,0000,0000,0000,,بالطبع، لن أفعل
Dialogue: 0,0:05:16.44,0:05:18.44,Default,,0000,0000,0000,,أراكِ لاحقاً إذاً
Dialogue: 0,0:05:22.33,0:05:24.37,Default,,0000,0000,0000,,...يا للوغد
Dialogue: 0,0:05:24.37,0:05:29.36,Default,,0000,0000,0000,,إنّه مالك هذا الفندق والشركة\Nالتي تموّل أعمالها الفنّية
Dialogue: 0,0:05:30.57,0:05:33.24,Default,,0000,0000,0000,,!يعتقد أنّ المال يستطيع شراء الفنّ له
Dialogue: 0,0:05:33.78,0:05:36.32,Default,,0000,0000,0000,,!رؤية وجهه تشعرني برغبة في الغثيان
Dialogue: 0,0:05:38.93,0:05:41.49,Default,,0000,0000,0000,,...هذه الأزهار مذهلة
Dialogue: 0,0:05:45.72,0:05:47.47,Default,,0000,0000,0000,,لا تعبث يا فتى
Dialogue: 0,0:05:47.47,0:05:49.01,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:05:49.01,0:05:50.24,Default,,0000,0000,0000,,نيتروجين سائل
Dialogue: 0,0:05:51.46,0:05:54.70,Default,,0000,0000,0000,,أليس ذاك الشيء الذي يتجمّد بلحظات؟
Dialogue: 0,0:05:55.01,0:05:57.87,Default,,0000,0000,0000,,صحيح، من المُبهر أنّك تعرف
Dialogue: 0,0:05:57.87,0:06:00.16,Default,,0000,0000,0000,,إنّه سرّ فنّ سينسي
Dialogue: 0,0:06:00.58,0:06:02.87,Default,,0000,0000,0000,,أهي من ابتكرت الفكرة؟
Dialogue: 0,0:06:03.08,0:06:06.57,Default,,0000,0000,0000,,من جعلتها مشهورة بالأحرى
Dialogue: 0,0:06:06.57,0:06:09.03,Default,,0000,0000,0000,,جعلتها مشهورة؟
Dialogue: 0,0:06:15.89,0:06:18.39,Default,,0000,0000,0000,,!يبدو لذيذاً
Dialogue: 0,0:06:18.39,0:06:21.20,Default,,0000,0000,0000,,!توقّف يا أبي! أنت تحرجني
Dialogue: 0,0:06:21.48,0:06:25.14,Default,,0000,0000,0000,,المعذرة، أنت المتحرّي الشهير موري-ساما، صحيح؟
Dialogue: 0,0:06:25.14,0:06:25.99,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:06:26.22,0:06:29.66,Default,,0000,0000,0000,,آسف على مضايقتك، لكن لديّ طلب
Dialogue: 0,0:06:34.13,0:06:38.53,Default,,0000,0000,0000,,،أتيتُ لإخباره أن الوقت اقترب لاصطحابه\Nلكن لم يكن هناك ردّ
Dialogue: 0,0:06:39.54,0:06:42.99,Default,,0000,0000,0000,,فهمت، أيوجد مفتاح احتياطيّ؟
Dialogue: 0,0:06:42.99,0:06:45.40,Default,,0000,0000,0000,,!نعم، هنا
Dialogue: 0,0:06:55.69,0:06:57.78,Default,,0000,0000,0000,,!الـ-السيّد شيراكي
Dialogue: 0,0:07:07.57,0:07:10.13,Default,,0000,0000,0000,,لمن الربطة حول عنقه؟
Dialogue: 0,0:07:10.13,0:07:12.28,Default,,0000,0000,0000,,إنّها تخصّه
Dialogue: 0,0:07:12.93,0:07:15.69,Default,,0000,0000,0000,,يبدو أنّه قُتل خنقاً بلا شكّ
Dialogue: 0,0:07:16.21,0:07:18.53,Default,,0000,0000,0000,,لكن هناك أمرٌ غريب في هذه الجثّة
Dialogue: 0,0:07:19.50,0:07:20.65,Default,,0000,0000,0000,,ما قصدك؟
Dialogue: 0,0:07:20.65,0:07:22.37,Default,,0000,0000,0000,,!متى أتيت هنا؟
Dialogue: 0,0:07:22.37,0:07:25.65,Default,,0000,0000,0000,,!انظروا، عقدة ربطة العنق نحو المقدمة
Dialogue: 0,0:07:27.36,0:07:28.70,Default,,0000,0000,0000,,...بالفعل
Dialogue: 0,0:07:29.33,0:07:33.96,Default,,0000,0000,0000,,!فهمت! قتله المجرم من الأمام
Dialogue: 0,0:07:33.96,0:07:37.78,Default,,0000,0000,0000,,يُفترض أنّه سيقاوم بشدّة إذا كان يُخنق
Dialogue: 0,0:07:37.78,0:07:40.21,Default,,0000,0000,0000,,خصوصاً لو من الأمام
Dialogue: 0,0:07:40.21,0:07:43.99,Default,,0000,0000,0000,,أي أنّ المجرم كان قويّاً كفاية
Dialogue: 0,0:07:43.99,0:07:47.98,Default,,0000,0000,0000,,بحيث استطاع خنق الضحيّة\Nدون أن يتأثر بمقاومته
Dialogue: 0,0:07:47.98,0:07:51.04,Default,,0000,0000,0000,,!رجل، وكبير البنية فوق ذلك
Dialogue: 0,0:07:51.04,0:07:54.21,Default,,0000,0000,0000,,لكن لا يبدو أنّ هذا الرجل قاوم أبداً
Dialogue: 0,0:07:54.21,0:07:55.34,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:07:55.68,0:08:00.54,Default,,0000,0000,0000,,كان ليقاوم قليلاً مهما بلغت\Nقوّة المجرم، أليس كذلك؟
Dialogue: 0,0:08:00.54,0:08:05.99,Default,,0000,0000,0000,,أجل، مثل خدش القاتل بينما يخنقه\Nأو نزع ربطة العنق
Dialogue: 0,0:08:05.99,0:08:07.42,Default,,0000,0000,0000,,صحيح؟
Dialogue: 0,0:08:07.42,0:08:09.46,Default,,0000,0000,0000,,لكن انظروا ليده
Dialogue: 0,0:08:09.46,0:08:12.42,Default,,0000,0000,0000,,لا بقايا على أظافره البتّة
Dialogue: 0,0:08:12.42,0:08:16.24,Default,,0000,0000,0000,,فهمت، لا توجد أيّة آثار على أظافره
Dialogue: 0,0:08:16.24,0:08:18.95,Default,,0000,0000,0000,,لا، لا يمكننا الجزم
Dialogue: 0,0:08:18.95,0:08:24.61,Default,,0000,0000,0000,,من المحتمل أنّه فقد وعيه فورياً\Nإذا ما خُنق بقوّة شديدة
Dialogue: 0,0:08:24.61,0:08:28.20,Default,,0000,0000,0000,,!لا بدّ أنّ القاتل شخص بقوّة مصارع محترف
Dialogue: 0,0:08:29.60,0:08:32.94,Default,,0000,0000,0000,,تفقّدوا إذا ما كان هناك\Nرجل بهذه المواصفات
Dialogue: 0,0:08:32.94,0:08:34.19,Default,,0000,0000,0000,,!ضمن الحضور فوراً
Dialogue: 0,0:08:34.19,0:08:35.17,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:08:35.17,0:08:38.12,Default,,0000,0000,0000,,مهلكم، أليس هذا بسيطاً جدّاً؟
Dialogue: 0,0:08:38.51,0:08:44.04,Default,,0000,0000,0000,,بأيّ حال، لا يمكننا تحريك الجثّة\Nحتى يصل فريق الفحص الجنائي
Dialogue: 0,0:08:45.05,0:08:47.75,Default,,0000,0000,0000,,!كونان! لا تزال هنا؟
Dialogue: 0,0:08:47.75,0:08:49.54,Default,,0000,0000,0000,,!ارحل
Dialogue: 0,0:08:50.92,0:08:53.67,Default,,0000,0000,0000,,أودّ التكلّم مع المسؤول
Dialogue: 0,0:08:53.88,0:08:56.87,Default,,0000,0000,0000,,ما الأمر؟ أنا المسؤول
Dialogue: 0,0:08:56.87,0:08:59.08,Default,,0000,0000,0000,,ميغوري من قسم التحقيق الأوّل لمركز الشرطة
Dialogue: 0,0:08:59.62,0:09:04.34,Default,,0000,0000,0000,,،سمعتُ أنّ المالك قُتل\Nما الذي تنوون فعله الآن؟
Dialogue: 0,0:09:04.34,0:09:08.11,Default,,0000,0000,0000,,إلغاء الحفلة فوراً بالطبع
Dialogue: 0,0:09:08.11,0:09:09.04,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:09:10.06,0:09:13.23,Default,,0000,0000,0000,,دعونا كلّ هؤلاء الضيوف المرموقين
Dialogue: 0,0:09:13.23,0:09:16.93,Default,,0000,0000,0000,,!إلغاء هذا الحدث سيلطّخ سيرتي
Dialogue: 0,0:09:16.93,0:09:17.95,Default,,0000,0000,0000,,...سينسي
Dialogue: 0,0:09:19.76,0:09:21.89,Default,,0000,0000,0000,,!هذه أنانيّة
Dialogue: 0,0:09:21.89,0:09:25.42,Default,,0000,0000,0000,,!اسمعي، هذه جريمة قتل بسابق الإصرار والترصّد
Dialogue: 0,0:09:25.42,0:09:27.67,Default,,0000,0000,0000,,أعي ذلك بالطبع
Dialogue: 0,0:09:27.67,0:09:32.71,Default,,0000,0000,0000,,لكن كان هدف المجرم هو المالك، وليس أنا
Dialogue: 0,0:09:32.71,0:09:34.63,Default,,0000,0000,0000,,هذا يعني أنّ الخطر زال
Dialogue: 0,0:09:35.00,0:09:37.58,Default,,0000,0000,0000,,...ربما، لكن
Dialogue: 0,0:09:37.58,0:09:40.49,Default,,0000,0000,0000,,...يا للمرأة شديدة الأنانيّة
Dialogue: 0,0:09:40.49,0:09:41.50,Default,,0000,0000,0000,,مع ذلك
Dialogue: 0,0:09:43.12,0:09:46.19,Default,,0000,0000,0000,,!يعتقد أنّ المال يستطيع شراء الفنّ له
Dialogue: 0,0:09:46.19,0:09:48.75,Default,,0000,0000,0000,,!رؤية وجهه تشعرني بالغثيان
Dialogue: 0,0:09:49.32,0:09:50.57,Default,,0000,0000,0000,,...أيمكن
Dialogue: 0,0:09:50.57,0:09:53.79,Default,,0000,0000,0000,,لكن يستحيل عليها بذلك بقوّتها
Dialogue: 0,0:09:54.44,0:09:56.10,Default,,0000,0000,0000,,!حضرة المفتّش
Dialogue: 0,0:09:56.10,0:10:00.01,Default,,0000,0000,0000,,!وجدتُ عدداً من الضيوف يطابقون المواصفات
Dialogue: 0,0:10:00.01,0:10:02.31,Default,,0000,0000,0000,,المصارع المحترف آناكوندا كاتاغيري
Dialogue: 0,0:10:02.31,0:10:05.46,Default,,0000,0000,0000,,...ولاعب كرة القدم إيمامورا كوتارو، كما
Dialogue: 0,0:10:05.80,0:10:11.46,Default,,0000,0000,0000,,سبق وأن تشاجر آناكوندا كاتاغيري-ساما\Nمع المالك حول العوائد
Dialogue: 0,0:10:11.46,0:10:14.42,Default,,0000,0000,0000,,في برنامج عشاء
Dialogue: 0,0:10:14.42,0:10:16.87,Default,,0000,0000,0000,,!إنّه هو! لا شكّ في الأمر
Dialogue: 0,0:10:17.24,0:10:21.83,Default,,0000,0000,0000,,أتمنّى أنّها قضيّة بهذه البساطة
Dialogue: 0,0:10:22.03,0:10:27.52,Default,,0000,0000,0000,,...شكراً لكم لجميعاً لحضوركم حفلة التهنئة بجائزة
Dialogue: 0,0:10:27.52,0:10:32.70,Default,,0000,0000,0000,,!الفنّ العالميّ لأوكانو ريكا سينسي
Dialogue: 0,0:10:37.86,0:10:39.48,Default,,0000,0000,0000,,حقّاً ذلك؟
Dialogue: 0,0:10:43.51,0:10:47.11,CharCard,,0000,0000,0007,,{\fad(300,200)}(آناكوندا كاتاغيري (35\Nمصارع محترف
Dialogue: 0,0:10:46.16,0:10:47.15,On Top,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:47.29,0:10:51.49,Default,,0000,0000,0000,,آناكوندا كاتاغيري-سان، هلّا أتيت للكلام معنا قليلاً؟
Dialogue: 0,0:10:51.49,0:10:54.54,Default,,0000,0000,0000,,!لاحقاً! لاحقاً! لا أزال أريد الأكل
Dialogue: 0,0:10:55.53,0:10:56.40,Default,,0000,0000,0000,,!أيّها الوغد
Dialogue: 0,0:10:57.78,0:10:58.40,Default,,0000,0000,0000,,!تبّاً لك
Dialogue: 0,0:11:06.02,0:11:08.45,Default,,0000,0000,0000,,!حضرة المفتّش! لديه حجّة غياب
Dialogue: 0,0:11:09.57,0:11:15.02,Default,,0000,0000,0000,,كان هذا الرجل... أقصد كان آناكوندا-سان\Nفي قاعة الحفل مع أصدقائه طوال الوقت
Dialogue: 0,0:11:15.02,0:11:16.32,Default,,0000,0000,0000,,!شهد عدّة أشخاص له
Dialogue: 0,0:11:22.66,0:11:26.29,Default,,0000,0000,0000,,!المفتّش في ورطة! طلب قدومكما للمساعدة
Dialogue: 0,0:11:33.42,0:11:36.24,Default,,0000,0000,0000,,رائحة كلوروفورم خفيفة
Dialogue: 0,0:11:36.24,0:11:37.82,Default,,0000,0000,0000,,...انتظر
Dialogue: 0,0:11:37.82,0:11:39.78,Default,,0000,0000,0000,,،إذا تمّ تنويمه أوّلاً
Dialogue: 0,0:11:39.78,0:11:42.74,Default,,0000,0000,0000,,يمكن لشخص ضعيف حتّى أن يخنقه
Dialogue: 0,0:11:43.41,0:11:47.07,Default,,0000,0000,0000,,لكن كيف جعله الفاعل يتنشّق الكلوروفورم؟
Dialogue: 0,0:11:49.53,0:11:54.12,Default,,0000,0000,0000,,هناك شيءٌ غريب في هذه الزهرة... ما هو؟
Dialogue: 0,0:11:54.40,0:11:57.26,Default,,0000,0000,0000,,...انتظر! عندما كان في غرفة تغيير الثياب
Dialogue: 0,0:11:57.26,0:11:58.70,Default,,0000,0000,0000,,...كانت الزهرة على صدره
Dialogue: 0,0:11:59.22,0:12:01.16,Default,,0000,0000,0000,,!مغلقة
Dialogue: 0,0:12:01.55,0:12:03.74,Default,,0000,0000,0000,,لكنّها متفتّحة الآن
Dialogue: 0,0:12:07.46,0:12:11.05,Default,,0000,0000,0000,,!موته كان أروع جائزة احتفال قطّ
Dialogue: 0,0:12:12.54,0:12:16.82,Default,,0000,0000,0000,,لم يعد عن كونه موطئ قدم\N!أصعد عليه للشهرة
Dialogue: 0,0:12:16.82,0:12:19.74,Default,,0000,0000,0000,,يبقى موطئ القدم موطئ قدم
Dialogue: 0,0:12:19.74,0:12:22.41,Default,,0000,0000,0000,,لم أكن دميته التي يتلاعب بها أبداً
Dialogue: 0,0:12:22.41,0:12:24.91,Default,,0000,0000,0000,,سينسي! ماذا لو سمعكِ أحد؟
Dialogue: 0,0:12:25.20,0:12:30.83,Default,,0000,0000,0000,,ميدوري-سان، عليكِ السكوت والتكفّل\Nبإدارة أعمالي وحسب
Dialogue: 0,0:12:31.36,0:12:34.62,Default,,0000,0000,0000,,بفضل من تستطيعين الأكل بظنّك؟
Dialogue: 0,0:12:34.62,0:12:37.32,Default,,0000,0000,0000,,آسفة على الكلام فيما لا يخصني
Dialogue: 0,0:12:37.32,0:12:39.54,Default,,0000,0000,0000,,...إنّها فظيعة بحقّ
Dialogue: 0,0:12:41.14,0:12:42.32,Default,,0000,0000,0000,,!قادمة
Dialogue: 0,0:12:45.01,0:12:46.03,Default,,0000,0000,0000,,أنت يا فتى
Dialogue: 0,0:12:46.34,0:12:48.49,Default,,0000,0000,0000,,قالوا أنّ وقت العرض اقترب
Dialogue: 0,0:12:48.75,0:12:50.41,Default,,0000,0000,0000,,هكذا إذاً، شكراً لك
Dialogue: 0,0:12:51.04,0:12:53.37,Default,,0000,0000,0000,,سينسي، عليكِ المغادرة الآن
Dialogue: 0,0:13:12.98,0:13:15.02,Default,,0000,0000,0000,,!وجدتُه! ها هو
Dialogue: 0,0:13:17.64,0:13:22.20,Default,,0000,0000,0000,,...كلوروفورم كما ظننت، والقنّينة الأخرى
Dialogue: 0,0:13:23.14,0:13:25.88,Default,,0000,0000,0000,,!مركّب سيانيد؟
Dialogue: 0,0:13:25.88,0:13:29.13,Default,,0000,0000,0000,,لا تزال تنوي قتل شخص آخر؟
Dialogue: 0,0:13:29.13,0:13:31.41,Default,,0000,0000,0000,,لكن كيف؟
Dialogue: 0,0:13:34.25,0:13:35.32,Default,,0000,0000,0000,,مكعّبات ثلجية؟
Dialogue: 0,0:13:38.49,0:13:41.16,Default,,0000,0000,0000,,!ثلج كلوروفورم
Dialogue: 0,0:13:41.16,0:13:42.76,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:13:43.33,0:13:48.69,Default,,0000,0000,0000,,أذابت الكلوروفورم المجمّد ببطء\Nفي درجة حرارة الغرفة
Dialogue: 0,0:13:48.69,0:13:50.58,Default,,0000,0000,0000,,!وجعلت الضحيّة يستنشقه
Dialogue: 0,0:13:52.32,0:13:54.65,Default,,0000,0000,0000,,!وهذه المرّة، ستستعمل السيانيد
Dialogue: 0,0:13:55.43,0:13:57.06,Default,,0000,0000,0000,,لكن كيف؟
Dialogue: 0,0:14:02.27,0:14:03.87,Default,,0000,0000,0000,,بتلة زهرة؟
Dialogue: 0,0:14:05.59,0:14:10.78,Default,,0000,0000,0000,,!إنّها مذهلة! تجعل براعم الأزهار تتفتّح فجأةً
Dialogue: 0,0:14:11.17,0:14:13.70,Default,,0000,0000,0000,,إنّه سرّ فنّ سينسي
Dialogue: 0,0:14:13.92,0:14:18.66,Default,,0000,0000,0000,,هكذا إذاً، كان للزهرة المغلقة سرّ خفيّ
Dialogue: 0,0:14:18.66,0:14:21.45,Default,,0000,0000,0000,,!كانت الزهرة مجمّدة بدورها
Dialogue: 0,0:14:21.45,0:14:24.91,Default,,0000,0000,0000,,،وُضع الكلوروفورم المجمّد داخل بتلة
Dialogue: 0,0:14:24.91,0:14:27.03,Default,,0000,0000,0000,,ثمّ جُمّدت
Dialogue: 0,0:14:30.07,0:14:32.53,Default,,0000,0000,0000,,لن يشتبه أحد بشيء هكذا
Dialogue: 0,0:14:32.94,0:14:37.49,Default,,0000,0000,0000,,لأنّ جميع ضيوف الحفلة كانوا يضعون\Nبتلات أزهار على صدورهم
Dialogue: 0,0:14:37.49,0:14:40.74,Default,,0000,0000,0000,,ثمّ، عندما دفأت الزهرة\N،في درجة حرارة الغرفة
Dialogue: 0,0:14:41.18,0:14:45.19,Default,,0000,0000,0000,,بدأت تتفتّح مجدداً، فتبخّر الكلوروفورم
Dialogue: 0,0:14:46.22,0:14:50.24,Default,,0000,0000,0000,,تنشّق المالك الكلوروفورم فأغمي عليه
Dialogue: 0,0:14:50.55,0:14:53.16,Default,,0000,0000,0000,,فتمكّن القاتل من قتله ببطء
Dialogue: 0,0:14:53.16,0:14:57.61,Default,,0000,0000,0000,,!موته كان أروع جائزة احتفال قطّ
Dialogue: 0,0:14:58.21,0:15:02.71,Default,,0000,0000,0000,,!إذا كانت أوكانو ريكا القاتلة، فمن تستهدف تالياً؟
Dialogue: 0,0:15:09.64,0:15:12.02,Default,,0000,0000,0000,,!ما الخطب؟! هاتوا ما لديكم
Dialogue: 0,0:15:17.60,0:15:20.60,Default,,0000,0000,0000,,!يُفترض أنّ زهرة الهدف مغلقة
Dialogue: 0,0:15:21.01,0:15:22.54,Default,,0000,0000,0000,,!عليّ إيجادها سريعاً
Dialogue: 0,0:15:23.47,0:15:26.73,Default,,0000,0000,0000,,!يتبخّر السيانيد عند 25.7 درجة مئوية
Dialogue: 0,0:15:26.97,0:15:29.19,Default,,0000,0000,0000,,!ستكون النهاية حالما تتفتّح الزهرة
Dialogue: 0,0:15:31.65,0:15:34.96,Default,,0000,0000,0000,,أيّها السادة، شكراً على الانتظار
Dialogue: 0,0:15:34.96,0:15:40.56,Default,,0000,0000,0000,,ها هو العرض الفرديّ بمناسبة فوز\N!أوكانو ريكا بجائزة الفنّ العالميّ
Dialogue: 0,0:16:12.50,0:16:13.83,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:16:15.17,0:16:16.96,Default,,0000,0000,0000,,!بدأ الثلج بالذوبان
Dialogue: 0,0:16:16.96,0:16:19.69,Default,,0000,0000,0000,,!بهذه الحرارة، حتّى ثلج القاتل سيذوب
Dialogue: 0,0:16:19.69,0:16:20.95,Default,,0000,0000,0000,,...لحظة
Dialogue: 0,0:16:20.95,0:16:25.02,Default,,0000,0000,0000,,تلقّى كلّ الضيوف أزهاراً عند\N!مكتب الاستقبال قبل الدخول
Dialogue: 0,0:16:29.98,0:16:33.73,Default,,0000,0000,0000,,في تلك الحالة، يُفترض أنّ الزهرة\Nتفتّحت منذ وقت طويل
Dialogue: 0,0:16:33.73,0:16:38.68,Default,,0000,0000,0000,,هل كنتُ أبالغ في التفكير؟\Nأكان المالك الهدف الوحيد؟
Dialogue: 0,0:16:38.68,0:16:43.68,Default,,0000,0000,0000,,لا، لن تكون هناك حاجة\Nلتجهيز السيانيد في تلك الحالة
Dialogue: 0,0:16:43.68,0:16:47.07,Default,,0000,0000,0000,,لا بدّ أنّ المجرم يخطّط\N!لقتل شخصٍ به
Dialogue: 0,0:16:48.13,0:16:51.73,Default,,0000,0000,0000,,!ليست هذه! أين؟ أين هي؟
Dialogue: 0,0:17:05.37,0:17:10.56,Default,,0000,0000,0000,,!إنّها مذهلة! تجعل براعم الأزهار تتفتّح فجأةً
Dialogue: 0,0:17:10.86,0:17:14.65,Default,,0000,0000,0000,,!هكذا إذاً! تلك هي! أيمكن أنّها تخطط لقتلها؟
Dialogue: 0,0:17:25.61,0:17:27.57,Default,,0000,0000,0000,,!لا جدوى! لن أصل في الوقت
Dialogue: 0,0:17:30.25,0:17:31.27,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:17:31.27,0:17:32.56,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:17:41.53,0:17:42.31,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:48.61,0:17:50.02,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:17:50.35,0:17:54.82,Default,,0000,0000,0000,,!أفسد هذا الصبيّ عرضي
Dialogue: 0,0:17:55.19,0:17:58.35,Default,,0000,0000,0000,,!أيّها الصبيّ الشقيّ! ما الذي فعلته؟
Dialogue: 0,0:17:58.35,0:18:01.81,Default,,0000,0000,0000,,!أعتذر! كنتُ ألوّح به وأطلق فجأة
Dialogue: 0,0:18:02.65,0:18:05.04,Default,,0000,0000,0000,,...ما الذي كنت
Dialogue: 0,0:18:08.52,0:18:09.94,Default,,0000,0000,0000,,!مهلك
Dialogue: 0,0:18:10.96,0:18:13.01,Default,,0000,0000,0000,,ما الخطب يا عمّ؟
Dialogue: 0,0:18:13.80,0:18:15.46,Default,,0000,0000,0000,,ما الأمر يا موري-كن؟
Dialogue: 0,0:18:15.46,0:18:18.48,Default,,0000,0000,0000,,!هل وجدت خيطاً لحلّ القضيّة؟
Dialogue: 0,0:18:18.87,0:18:23.40,Default,,0000,0000,0000,,كنتُ أنا من طلب منه\Nاعتراض العرض في الواقع
Dialogue: 0,0:18:23.74,0:18:27.85,Default,,0000,0000,0000,,!ما معنى هذا؟! ستدفع الثمن إذا كان صحيحاً
Dialogue: 0,0:18:28.23,0:18:30.78,Default,,0000,0000,0000,,لحظة تفتّح الأزهار
Dialogue: 0,0:18:30.78,0:18:34.32,Default,,0000,0000,0000,,كانت ستكون لحظة إغلاق حياتك
Dialogue: 0,0:18:34.61,0:18:35.94,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:18:35.94,0:18:39.52,Default,,0000,0000,0000,,موري-كن، هلّا شرحت بوضوحٍ أكثر؟
Dialogue: 0,0:18:39.89,0:18:43.77,Default,,0000,0000,0000,,حضرة المفتّش، أغلق كلّ الأزهار المنظمة رجاءً
Dialogue: 0,0:18:43.77,0:18:47.49,Default,,0000,0000,0000,,إغلاق ثنائيّ وثلاثيّ بحيث\Nلا يتسرّب أيّ هواء
Dialogue: 0,0:18:48.77,0:18:53.63,Default,,0000,0000,0000,,...سرّ قتل المجرم مخفيّ داخل هذه الأزهار
Dialogue: 0,0:18:53.63,0:18:55.73,Default,,0000,0000,0000,,!كما خطّة قتل فاشلة
Dialogue: 0,0:18:56.13,0:18:57.51,Default,,0000,0000,0000,,!أسرع
Dialogue: 0,0:18:57.51,0:18:58.68,Default,,0000,0000,0000,,!حـ-حسناً
Dialogue: 0,0:19:04.11,0:19:07.58,Default,,0000,0000,0000,,وضعناها في أكياس جميعاً \Nيا موري-كن، فلتتكلّم الآن
Dialogue: 0,0:19:08.74,0:19:14.03,Default,,0000,0000,0000,,طريقة قتل المالك شيراكي-سان\Nوخطّة القتل الأخرى
Dialogue: 0,0:19:14.03,0:19:16.32,Default,,0000,0000,0000,,...كانت موضوع تنظيم الأزهار لريكا-سان عينه
Dialogue: 0,0:19:16.32,0:19:20.52,Default,,0000,0000,0000,,!أجل، تفتّح الأزهار المغلقة
Dialogue: 0,0:19:20.52,0:19:23.14,Default,,0000,0000,0000,,!أوكانو ريكا-سان هي القاتلة إذاً؟
Dialogue: 0,0:19:23.14,0:19:24.16,Default,,0000,0000,0000,,!أنت؟
Dialogue: 0,0:19:24.16,0:19:25.52,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:19:25.52,0:19:30.94,Default,,0000,0000,0000,,!أيّ هراء هذا؟! لمَ قد أقتل المالك؟
Dialogue: 0,0:19:30.94,0:19:32.92,Default,,0000,0000,0000,,صحيح، لم تكن أنت
Dialogue: 0,0:19:32.92,0:19:36.40,Default,,0000,0000,0000,,لأنّكِ كنتِ الضحيّة الثانية\Nالمستهدفة بعد المالك
Dialogue: 0,0:19:36.80,0:19:39.10,Default,,0000,0000,0000,,!لا يُعقل! أنا؟
Dialogue: 0,0:19:39.10,0:19:42.24,Default,,0000,0000,0000,,من المجرم إذاً؟
Dialogue: 0,0:19:42.24,0:19:45.21,Default,,0000,0000,0000,,إنّه من وضع الزهرة على صدر المالك
Dialogue: 0,0:19:45.21,0:19:48.03,Default,,0000,0000,0000,,وحضّر الأزهار على المسرح
Dialogue: 0,0:19:48.03,0:19:51.77,Default,,0000,0000,0000,,ريكا-سان، تعرفين من هي
Dialogue: 0,0:19:51.95,0:19:57.19,Default,,0000,0000,0000,,!أجل، كانت مديرتك أوزاكي ميدوري-سان
Dialogue: 0,0:19:58.02,0:19:59.64,Default,,0000,0000,0000,,حاولت ميدوري قتلي؟
Dialogue: 0,0:19:59.85,0:20:06.11,Default,,0000,0000,0000,,فميدوري-سان كانت الوحيدة\Nالقادرة على التلاعب بالأزهار على المسرح
Dialogue: 0,0:20:06.11,0:20:09.01,Default,,0000,0000,0000,,،لكن إذا كانت القاتلة
Dialogue: 0,0:20:09.01,0:20:11.81,Default,,0000,0000,0000,,!كانت لتموت من الأزهار التي فخّختها أيضاً
Dialogue: 0,0:20:11.81,0:20:17.77,Default,,0000,0000,0000,,صحيح، نوت الانتقام والموت مع ريكا-سان
Dialogue: 0,0:20:18.25,0:20:19.33,Default,,0000,0000,0000,,الانتقام؟
Dialogue: 0,0:20:19.33,0:20:20.04,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:20.04,0:20:21.73,Default,,0000,0000,0000,,...كان دافعها غالباً
Dialogue: 0,0:20:22.00,0:20:24.15,Default,,0000,0000,0000,,...دافعها غالباً
Dialogue: 0,0:20:24.71,0:20:28.35,Default,,0000,0000,0000,,من جعلتها مشهورة بالأحرى
Dialogue: 0,0:20:28.82,0:20:33.16,Default,,0000,0000,0000,,،بناءً على ما قالته
Dialogue: 0,0:20:33.16,0:20:38.81,Default,,0000,0000,0000,,فلم تكن ريكا-سان مبتكرة\Nفكرة تفتّح الأزهار
Dialogue: 0,0:20:39.81,0:20:44.61,Default,,0000,0000,0000,,صحيح، لم أستطع مسامحة المالك شيراكي وريكا
Dialogue: 0,0:20:45.56,0:20:49.55,Default,,0000,0000,0000,,بدأت أختي هاروكا في تنظيم الأزهار الرياديّ هذا
Dialogue: 0,0:20:49.55,0:20:51.77,Default,,0000,0000,0000,,!وكانت أوكانو ريكا تلميذتها
Dialogue: 0,0:20:52.26,0:20:55.14,Default,,0000,0000,0000,,لكنّها وجدت شيراكي وجعلته راعياً لها
Dialogue: 0,0:20:55.14,0:20:58.88,Default,,0000,0000,0000,,لتحاول أن تصبح منظّمة\N!الأزهار الريادية الأولى
Dialogue: 0,0:21:02.75,0:21:07.78,Default,,0000,0000,0000,,في عالم الفنّ، من الطبيعي أن يُسقط\Nالموهوب غير الموهوب
Dialogue: 0,0:21:07.78,0:21:10.45,Default,,0000,0000,0000,,لكن عرفت أوكانو ريكا أنّها لن تصبح الأفضل
Dialogue: 0,0:21:10.45,0:21:12.28,Default,,0000,0000,0000,,أبداً بوجود أختي
Dialogue: 0,0:21:12.28,0:21:15.91,Default,,0000,0000,0000,,لذا استعملت حيلاً دنيئة ودعم شيراكي
Dialogue: 0,0:21:15.91,0:21:20.60,Default,,0000,0000,0000,,للضغط عليها فتصبح عاجزة \N!عن المطالبة بتقدير ما سرقته ريكا
Dialogue: 0,0:21:20.60,0:21:24.31,Default,,0000,0000,0000,,فوق ذلك، كانت أختي من ابتكرت
Dialogue: 0,0:21:24.31,0:21:26.48,Default,,0000,0000,0000,,!فكرة تفتّح الأزهار المغلقة
Dialogue: 0,0:21:26.48,0:21:28.64,Default,,0000,0000,0000,,...وريكا
Dialogue: 0,0:21:28.64,0:21:31.89,Default,,0000,0000,0000,,ماذا فعلت أختك بعدها؟
Dialogue: 0,0:21:34.14,0:21:38.68,Default,,0000,0000,0000,,أصابها الإحباط وأقدمت على الانتحار
Dialogue: 0,0:21:40.79,0:21:43.92,Default,,0000,0000,0000,,ريكا لا تحبّ الأزهار البتّة
Dialogue: 0,0:21:43.92,0:21:47.86,Default,,0000,0000,0000,,استعملتها للحصول على الشهرة والمال لا أكثر
Dialogue: 0,0:21:49.20,0:21:51.70,Default,,0000,0000,0000,,أدركتُ ذلك بوضوح
Dialogue: 0,0:21:51.70,0:21:53.87,Default,,0000,0000,0000,,بعدما غيّرتُ اسمي وأصبحت مديرة أعمالها
Dialogue: 0,0:21:53.87,0:21:55.78,Default,,0000,0000,0000,,!لذا كان عليها دفع الثمن
Dialogue: 0,0:23:35.33,0:23:40.52,Default,,0000,0000,0000,,بهذه الحادثة، ظهرت سرقة أوكانو ريكا الفكرية للعلن
Dialogue: 0,0:23:41.38,0:23:45.44,Default,,0000,0000,0000,,فلن تظهر على مسرح من جديد غالباً
Dialogue: 0,0:23:46.17,0:23:47.52,Default,,0000,0000,0000,,...بينما أنا
Dialogue: 0,0:23:47.52,0:23:48.39,Default,,0000,0000,0000,,!أيّها الصبيّ
Dialogue: 0,0:23:48.39,0:23:54.36,Default,,0000,0000,0000,,تلقّيت عقوبةً من العمّ الذي\Nلم يعرف شيئاً مما حصل لنومه
Dialogue: 0,0:23:54.99,0:23:56.45,Default,,0000,0000,0000,,!مؤلم
Dialogue: 0,0:24:01.35,0:24:06.07,Default,,0000,0000,0000,,هناك احتمال أنّ مجموعة المجرمين\Nلا تزال في القرب
Dialogue: 0,0:24:07.27,0:24:09.44,Default,,0000,0000,0000,,هو الفاعل إذاً؟
Dialogue: 0,0:24:12.47,0:24:13.42,Default,,0000,0000,0000,,لا تفعلها
Dialogue: 0,0:24:14.51,0:24:18.68,Default,,0000,0000,0000,,طُلِب منك قتل أكاباني ذاك، صحيح؟
Dialogue: 0,0:24:18.68,0:24:20.81,Default,,0000,0000,0000,,!مذهل! رائع
Dialogue: 0,0:24:22.42,0:24:23.86,Default,,0000,0000,0000,,الضابط أيضاً؟
Dialogue: 0,0:24:23.86,0:24:29.86,On Top,,0000,0000,0000,,قضيّة السارق المنوّم في المشفى
Dialogue: 0,0:24:24.79,0:24:26.14,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.14,0:24:29.00,Default,,0000,0000,0000,,قضيّة السارق المنوّم في المشفى
Dialogue: 0,0:24:45.64,0:24:48.08,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.08,0:24:50.08,Default,,0000,0000,0000,,كعك بالقشدة
Dialogue: 0,0:24:50.08,0:24:51.89,Default,,0000,0000,0000,,العمّ كوغورو منوّم في المشفى\N!في الحلقة القادمة
Dialogue: 0,0:24:51.89,0:24:53.93,Default,,0000,0000,0000,,!هيّا بنا يا ميغوري-كن! وداعاً يا ضابط تاكاغي
Dialogue: 0,0:24:53.93,0:24:55.93,Default,,0000,0000,0000,,!ماذا؟

