Dialogue: 0,0:00:01.14,0:00:02.68,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:02.68,0:00:05.63,Default,,0000,0000,0000,,أُجبر طالب الثانوية كودو شينتشي على\Nتجرّع عقار قلص جسده
Dialogue: 0,0:00:05.63,0:00:08.63,Default,,0000,0000,0000,,،رغم أنّي أصبحت أصغر\N!لا يزال عقلي عقل متحرٍّ عظيم
Dialogue: 0,0:00:08.63,0:00:11.63,Default,,0000,0000,0000,,مسرح قضيّة اليوم هو موقع تصوير دراما تلفزية
Dialogue: 0,0:00:11.63,0:00:15.41,Default,,0000,0000,0000,,!مهما كان الممثل بارعاً، تبقى الحقيقة واحدة دوماً
Dialogue: 0,0:01:47.03,0:01:49.95,Default,,0000,0000,0000,,جريمة قتل الدراما التلفزية
Dialogue: 0,0:01:52.14,0:01:55.19,On Top,,0000,0000,0000,,ضريح بيكا
Dialogue: 0,0:02:12.71,0:02:14.67,Default,,0000,0000,0000,,...لا يمكن
Dialogue: 0,0:02:17.25,0:02:19.81,Default,,0000,0000,0000,,...لم أنوِ قتله
Dialogue: 0,0:02:20.91,0:02:23.50,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:02:23.53,0:02:25.69,Default,,0000,0000,0000,,!اقطع
Dialogue: 0,0:02:25.69,0:02:27.81,Default,,0000,0000,0000,,حسنٌ، هذه نهاية المشهد
Dialogue: 0,0:02:28.12,0:02:30.52,Default,,0000,0000,0000,,كان تمثيلاً ممتازاً يا يوكو
Dialogue: 0,0:02:31.49,0:02:33.98,Default,,0000,0000,0000,,تصوير دراما تلفزية أمرٌ مثير، ألا تتفق؟
Dialogue: 0,0:02:33.98,0:02:34.73,Default,,0000,0000,0000,,!بلى
Dialogue: 0,0:02:35.40,0:02:37.86,CharCard,,0000,0000,0000,,فنّانة مشهورة\N(أوكينو يوكو (21
Dialogue: 0,0:02:36.32,0:02:37.86,On Top,,0000,0000,0000,,شكراً جزيلاً
Dialogue: 0,0:02:39.61,0:02:44.77,CharCard,,0000,0000,0000,,الممثل البطل\N(ناتشي شينغو (23
Dialogue: 0,0:02:40.53,0:02:44.77,On Top,,0000,0000,0000,,مُحال للممثل النجم البطل ناتشي \N!شينغو أن تشوبه شائبة
Dialogue: 0,0:02:44.77,0:02:47.93,Default,,0000,0000,0000,,!يوكو-تشان! عملٌ رائع
Dialogue: 0,0:02:47.93,0:02:49.31,Default,,0000,0000,0000,,شكراً يا موري-سان
Dialogue: 0,0:02:49.31,0:02:52.46,Default,,0000,0000,0000,,!كان تمثيلاً بديعاً
Dialogue: 0,0:02:52.46,0:02:55.98,Default,,0000,0000,0000,,!ستصبح هذه الدراما تحفة فنّية دون أدنى شك
Dialogue: 0,0:02:55.98,0:03:00.07,Default,,0000,0000,0000,,سيكون ذلك بفضل مساعدتك لنا\Nفي الإشراف على نصوص الغموض
Dialogue: 0,0:03:00.63,0:03:02.12,Default,,0000,0000,0000,,إنّها محقة
Dialogue: 0,0:03:02.12,0:03:04.29,Default,,0000,0000,0000,,معنا المتحرّي الشهير الذي يُعرف
Dialogue: 0,0:03:04.29,0:03:05.64,Default,,0000,0000,0000,,بأنّه أكيتشي كوغورو هذا الزمان
Dialogue: 0,0:03:05.74,0:03:08.61,CharCard,,0000,0000,0000,,المخرج\N(كوندو تاكيتوشي (57
Dialogue: 0,0:03:06.00,0:03:08.61,Default,,0000,0000,0000,,{\a6}ستحقّق هذه الدراما نجاحاً باهراً، لا شك لديّ
Dialogue: 0,0:03:08.83,0:03:11.96,Default,,0000,0000,0000,,لعلّي ساعدت نوعاً ما
Dialogue: 0,0:03:14.86,0:03:17.10,Default,,0000,0000,0000,,إنّه بأفضل مزاج الآن
Dialogue: 0,0:03:17.94,0:03:22.02,Default,,0000,0000,0000,,...هذه هكذا، وهذه هنا
Dialogue: 0,0:03:22.27,0:03:23.98,Default,,0000,0000,0000,,سهلةٌ جداً
Dialogue: 0,0:03:23.98,0:03:25.14,Default,,0000,0000,0000,,!أنت
Dialogue: 0,0:03:25.73,0:03:27.85,Default,,0000,0000,0000,,!لا تلمس أغراضي
Dialogue: 0,0:03:27.85,0:03:29.23,Default,,0000,0000,0000,,آسفة يا ناتشي-سان
Dialogue: 0,0:03:29.73,0:03:31.89,Default,,0000,0000,0000,,لم أنتبه له كما يجب
Dialogue: 0,0:03:33.17,0:03:36.67,Default,,0000,0000,0000,,ر-ربما يمكنني مسامحته\Nلأجل فتاة ظريفة مثلك
Dialogue: 0,0:03:36.67,0:03:38.02,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:03:38.51,0:03:40.48,Default,,0000,0000,0000,,يا للمتملق
Dialogue: 0,0:03:40.84,0:03:44.83,Default,,0000,0000,0000,,أتحبّ حل أحجيات أعواد الثقاب يا ناتشي-سان؟
Dialogue: 0,0:03:44.83,0:03:48.98,Default,,0000,0000,0000,,أجل، فالأبطال مثلي يميلون للهوايات الفكرية
Dialogue: 0,0:03:50.83,0:03:52.77,Default,,0000,0000,0000,,أحقاً ذلك؟
Dialogue: 0,0:03:53.82,0:03:56.36,On Top,,0000,0000,0000,,!ناتشي-سان! عملٌ موفق
Dialogue: 0,0:03:53.91,0:03:57.35,CharCard,,0000,0000,0000,,مشرفة النصّ\N(ماميغاكي تايكو (24
Dialogue: 0,0:03:56.36,0:03:57.35,On Top,,0000,0000,0000,,تفضّل منشفة
Dialogue: 0,0:03:58.19,0:03:59.65,Default,,0000,0000,0000,,!شكراً لك
Dialogue: 0,0:04:00.20,0:04:02.98,Default,,0000,0000,0000,,ما رأيك بأن نتناول العشاء معاً الليلة؟
Dialogue: 0,0:04:03.52,0:04:04.65,Default,,0000,0000,0000,,آسفة
Dialogue: 0,0:04:04.65,0:04:06.10,Default,,0000,0000,0000,,أين المشكلة؟ لن نطيل
Dialogue: 0,0:04:06.10,0:04:08.23,Default,,0000,0000,0000,,لا يمكنها
Dialogue: 0,0:04:08.23,0:04:11.19,Default,,0000,0000,0000,,فهي ستتزوج هذا الشاب الشهر المقبل
Dialogue: 0,0:04:11.19,0:04:12.43,Default,,0000,0000,0000,,صحيح يا شيمازاكي؟
Dialogue: 0,0:04:12.43,0:04:16.15,CharCard,,0000,0000,0000,,المخرج المساعد\N(شيمازاكي يوجي (26
Dialogue: 0,0:04:13.51,0:04:15.38,On Top,,0000,0000,0000,,...أجل، صحيح
Dialogue: 0,0:04:17.34,0:04:20.30,Default,,0000,0000,0000,,!حقاً؟! تهانينا
Dialogue: 0,0:04:20.30,0:04:21.07,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:04:21.07,0:04:24.77,Default,,0000,0000,0000,,هُنّ كالأزهار قبل الزواج فقط
Dialogue: 0,0:04:25.33,0:04:27.90,On Top,,0000,0000,0000,,لا تدرك أنّه سراب\Nإلّا بعد فوات الأوان
Dialogue: 0,0:04:25.33,0:04:27.90,CharCard,,0000,0000,0000,,مشرف التصوير\N(أنزاي موريو (25
Dialogue: 0,0:04:28.17,0:04:29.52,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:04:30.58,0:04:31.61,Default,,0000,0000,0000,,!كلا يا يوجي-سان
Dialogue: 0,0:04:31.82,0:04:34.44,Default,,0000,0000,0000,,!يتفوّه بكلامٍ مهين دوماً
Dialogue: 0,0:04:34.74,0:04:39.36,Default,,0000,0000,0000,,هذا كلامٌ عام، لم أكن أوجّهه لكما بالضبط
Dialogue: 0,0:04:39.36,0:04:41.79,Default,,0000,0000,0000,,لا تغضب هكذا
Dialogue: 0,0:04:44.81,0:04:46.40,Default,,0000,0000,0000,,إنّه منّبه ساعتي
Dialogue: 0,0:04:46.69,0:04:51.15,Default,,0000,0000,0000,,صوتٌ مثير، صحيح؟ اشتريتها الشهر الفائت\Nعندما سافرتُ إلى أمريكا
Dialogue: 0,0:04:54.47,0:04:55.73,Default,,0000,0000,0000,,يبدو أنّكم لا تهتمون
Dialogue: 0,0:04:56.01,0:04:58.15,Default,,0000,0000,0000,,أراكم لاحقاً
Dialogue: 0,0:04:58.51,0:05:00.25,Default,,0000,0000,0000,,يا للبغيض
Dialogue: 0,0:05:02.58,0:05:04.63,Default,,0000,0000,0000,,واحد، اثنان، ثلاثة
Dialogue: 0,0:05:04.63,0:05:06.96,Default,,0000,0000,0000,,هل انتهى التصوير؟
Dialogue: 0,0:05:06.96,0:05:08.27,Default,,0000,0000,0000,,جدّي
Dialogue: 0,0:05:08.83,0:05:11.36,On Top,,0000,0000,0000,,تذكّروا تنظيف كّل شيء قبل المغادرة
Dialogue: 0,0:05:08.83,0:05:11.36,CharCard,,0000,0000,0000,,جدّ تايكو\N(ماميغاكي كيوساكو (75
Dialogue: 0,0:05:11.74,0:05:13.98,Default,,0000,0000,0000,,أشياء كتلك بالتحديد
Dialogue: 0,0:05:14.82,0:05:17.49,Default,,0000,0000,0000,,نفهم يا جدّي
Dialogue: 0,0:05:17.49,0:05:18.78,Default,,0000,0000,0000,,أعتمد عليك
Dialogue: 0,0:05:20.20,0:05:23.77,Default,,0000,0000,0000,,جدّك هو المسؤول عن الضريح هنا؟
Dialogue: 0,0:05:24.02,0:05:26.98,Default,,0000,0000,0000,,أجل، هذا الضريح الذي ترعرعت فيه
Dialogue: 0,0:05:27.31,0:05:28.94,Default,,0000,0000,0000,,ران-نيتشان
Dialogue: 0,0:05:28.94,0:05:32.43,Default,,0000,0000,0000,,ألم يطلب أصدقاؤك توقيع ناتشي شينغو؟
Dialogue: 0,0:05:32.97,0:05:34.18,Default,,0000,0000,0000,,!نسيت
Dialogue: 0,0:05:34.18,0:05:35.21,Default,,0000,0000,0000,,أين ناتشي-سان؟
Dialogue: 0,0:05:35.21,0:05:36.97,Default,,0000,0000,0000,,ذهب لتغيير ثيابه قبل فترة
Dialogue: 0,0:05:36.97,0:05:37.90,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:05:37.90,0:05:39.85,Default,,0000,0000,0000,,!ا-انتظري، ران-نيتشان
Dialogue: 0,0:05:40.80,0:05:42.81,Default,,0000,0000,0000,,!يكفي هراءً
Dialogue: 0,0:05:43.17,0:05:44.92,Default,,0000,0000,0000,,...كان ذلك صوت ناتشي-سان
Dialogue: 0,0:05:44.92,0:05:46.67,Default,,0000,0000,0000,,ألديك دليلٌ حتّى؟
Dialogue: 0,0:05:46.67,0:05:48.11,Default,,0000,0000,0000,,بالطبع
Dialogue: 0,0:05:48.67,0:05:52.78,Default,,0000,0000,0000,,،إن أردتَ هذه الصور الملونة والسلبية\Nتعرف ما عليك فعله
Dialogue: 0,0:05:52.78,0:05:53.43,Default,,0000,0000,0000,,مال؟
Dialogue: 0,0:05:56.45,0:05:57.94,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:05:58.66,0:06:01.19,Default,,0000,0000,0000,,!كلا، لا شيء
Dialogue: 0,0:06:06.02,0:06:09.36,Default,,0000,0000,0000,,موري-سان، سنقضي الليلة في هذا النُزل
Dialogue: 0,0:06:09.65,0:06:12.14,Default,,0000,0000,0000,,ما رأيك بحمّامٍ مريح وشراب؟
Dialogue: 0,0:06:12.14,0:06:13.43,Default,,0000,0000,0000,,!يبدو رائعاً
Dialogue: 0,0:06:13.72,0:06:15.89,Default,,0000,0000,0000,,...أبي، يا إلهي
Dialogue: 0,0:06:15.89,0:06:18.76,Default,,0000,0000,0000,,انضما لنا يا ران-سان وكونان-كن أيضاً
Dialogue: 0,0:06:18.76,0:06:19.56,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:06:19.56,0:06:21.92,Default,,0000,0000,0000,,!يا للنُزل رديء المظهر
Dialogue: 0,0:06:21.92,0:06:25.39,Default,,0000,0000,0000,,لن يقيم بطلٌ مثلي في مكانٍ كهذا
Dialogue: 0,0:06:25.39,0:06:28.73,Default,,0000,0000,0000,,...لا يكفّ عن الكلام عن بطوليّته، كم هو مزعج
Dialogue: 0,0:06:29.30,0:06:32.39,Default,,0000,0000,0000,,سأبقى في فندق تيتان
Dialogue: 0,0:06:32.87,0:06:35.14,Default,,0000,0000,0000,,!لـ-لحظة، ناتشي-سان
Dialogue: 0,0:06:35.45,0:06:37.39,Default,,0000,0000,0000,,...لا أمل معه
Dialogue: 0,0:06:41.12,0:06:44.06,Default,,0000,0000,0000,,!اشرب يا موري-سان
Dialogue: 0,0:06:44.36,0:06:46.77,Default,,0000,0000,0000,,شكراً لانتظاركم
Dialogue: 0,0:06:46.77,0:06:48.65,Default,,0000,0000,0000,,أنزاي! أين تذهب؟
Dialogue: 0,0:06:48.65,0:06:51.48,Default,,0000,0000,0000,,عليّ ضبط الكاميرا
Dialogue: 0,0:06:51.85,0:06:53.93,Default,,0000,0000,0000,,كم هو انعزاليّ
Dialogue: 0,0:06:54.77,0:06:58.52,Default,,0000,0000,0000,,يوجي-سان، عليّ التكفل بأمرٍ في المنزل
Dialogue: 0,0:06:58.52,0:07:01.28,Default,,0000,0000,0000,,حسناً، فهمت. عودي سريعاً
Dialogue: 0,0:07:07.51,0:07:11.02,Default,,0000,0000,0000,,لا تحتاجين لمساحيق التجميل\N!يا ران-سان، لا تزالين يافعة
Dialogue: 0,0:07:11.66,0:07:12.66,Default,,0000,0000,0000,,شيمازاكي-سان
Dialogue: 0,0:07:14.37,0:07:17.66,Default,,0000,0000,0000,,!شيمازاكي! اجلب لي سجائر معك
Dialogue: 0,0:07:17.66,0:07:18.88,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:07:20.16,0:07:23.82,Default,,0000,0000,0000,,هلّا رافقتني للبقالة يا ران-سان؟
Dialogue: 0,0:07:23.82,0:07:27.40,Default,,0000,0000,0000,,لكن أليس من السيّئ أن\Nتتجوّل فنانة في وقت متأخر؟
Dialogue: 0,0:07:27.65,0:07:29.32,Default,,0000,0000,0000,,لا بأس
Dialogue: 0,0:07:29.32,0:07:33.35,Default,,0000,0000,0000,,لن يعرفني أحد إن غيّرتُ تسريحتي\N!وارتديت قبعة
Dialogue: 0,0:07:33.98,0:07:36.06,Default,,0000,0000,0000,,رأيتهما يبدّلان ملابسهما
Dialogue: 0,0:07:36.06,0:07:39.06,Default,,0000,0000,0000,,أأنتِ متأكدة لا مشكلة في هذا يا يوكو-سان؟
Dialogue: 0,0:07:39.06,0:07:40.71,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:07:44.67,0:07:47.06,Default,,0000,0000,0000,,يبدو أنّ أنزاي-سان سيخرج أيضاً
Dialogue: 0,0:07:50.26,0:07:53.16,Default,,0000,0000,0000,,أنتِ كثيرة القلق يا ران-سان
Dialogue: 0,0:07:53.16,0:07:54.58,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:07:54.58,0:07:55.44,Default,,0000,0000,0000,,تايكو-سان
Dialogue: 0,0:07:57.91,0:07:59.23,Default,,0000,0000,0000,,تايكو-سان
Dialogue: 0,0:07:59.23,0:08:00.50,Default,,0000,0000,0000,,!تايكو-سان
Dialogue: 0,0:08:00.50,0:08:01.99,Default,,0000,0000,0000,,!ران-سان
Dialogue: 0,0:08:01.99,0:08:03.77,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:08:03.77,0:08:05.60,Default,,0000,0000,0000,,...كـ-كلا
Dialogue: 0,0:08:09.49,0:08:10.98,Default,,0000,0000,0000,,ما كان ذلك يا ترى؟
Dialogue: 0,0:08:10.98,0:08:13.54,Default,,0000,0000,0000,,بدت كأنّها رأت شبحاً
Dialogue: 0,0:08:15.48,0:08:17.04,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:08:20.23,0:08:22.22,Default,,0000,0000,0000,,رأيتِ؟ أخبرتك لا مشكلة
Dialogue: 0,0:08:22.22,0:08:24.31,Default,,0000,0000,0000,,!معكِ حق! لم يعرفوك أبداً
Dialogue: 0,0:08:27.84,0:08:29.18,Default,,0000,0000,0000,,!من ذاك؟
Dialogue: 0,0:08:29.18,0:08:31.54,Default,,0000,0000,0000,,!أيمكن أنّه سارق تبرّعات؟
Dialogue: 0,0:08:37.46,0:08:38.81,Default,,0000,0000,0000,,!هناك شخصٌ على الأرض
Dialogue: 0,0:08:42.57,0:08:43.52,Default,,0000,0000,0000,,!أنزاي-سان
Dialogue: 0,0:08:45.82,0:08:48.19,Default,,0000,0000,0000,,!إنّه ميت! اتّصلوا بالشرطة
Dialogue: 0,0:08:48.95,0:08:49.69,Default,,0000,0000,0000,,!بسرعة
Dialogue: 0,0:08:49.69,0:08:50.61,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:08:56.48,0:08:59.48,Default,,0000,0000,0000,,،حتّى لو سقطت قبعة الضحية مع سقوطه
Dialogue: 0,0:08:59.48,0:09:01.15,Default,,0000,0000,0000,,كيف نُزعت سترته؟
Dialogue: 0,0:09:04.59,0:09:07.36,Default,,0000,0000,0000,,هذه... السكّين التي اُستعملت في التصوير
Dialogue: 0,0:09:08.76,0:09:12.33,Default,,0000,0000,0000,,مما يعني أنّ القاتل أحد العمّال
Dialogue: 0,0:09:20.33,0:09:22.02,On Top,,0000,0000,0000,,تمثال كوما إينو
Dialogue: 0,0:09:22.02,0:09:25.85,Default,,0000,0000,0000,,!هذه رسالة احتضار تركها الضحيّة
Dialogue: 0,0:09:26.32,0:09:27.87,Default,,0000,0000,0000,,(كوما إينو؟ (كلب أسد
Dialogue: 0,0:09:27.87,0:09:30.03,Default,,0000,0000,0000,,أيشير هذا لهويّة الفاعل؟
Dialogue: 0,0:09:34.48,0:09:39.40,Default,,0000,0000,0000,,رأيتم شخصاً مريباً قبل \Nعثوركم على الجثّة، صحيح؟
Dialogue: 0,0:09:39.40,0:09:43.89,Default,,0000,0000,0000,,أجل، منعنا الظلام من معرفة إن\Nما كان رجلاً أو امرأة
Dialogue: 0,0:09:44.35,0:09:45.85,Default,,0000,0000,0000,,وكان ذلك عند العاشرة والنصف
Dialogue: 0,0:09:46.30,0:09:49.39,Default,,0000,0000,0000,,مما يعني أنّ الجريمة وقعت بين العاشرة
Dialogue: 0,0:09:49.39,0:09:53.04,Default,,0000,0000,0000,,وبعد مغادرة الضحيّة النُزل حتى العاشرة والنصف
Dialogue: 0,0:09:54.34,0:09:57.42,Default,,0000,0000,0000,,سيدي المفتش، هذه القضية بمنتهى البساطة
Dialogue: 0,0:09:57.42,0:09:58.63,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:09:58.63,0:10:04.35,Default,,0000,0000,0000,,أوّلاً، اُستعمل سلاح الجريمة في تصوير الدراما
Dialogue: 0,0:10:04.70,0:10:07.31,Default,,0000,0000,0000,,وثانياً، تشير كوما إينو إلى ضريح شينتو
Dialogue: 0,0:10:07.66,0:10:10.52,Default,,0000,0000,0000,,...مما يعني من هذين الأمرين
Dialogue: 0,0:10:10.83,0:10:13.22,Default,,0000,0000,0000,,!المجرم هو أنت يا ماميغاكي تايكو-سان
Dialogue: 0,0:10:13.22,0:10:16.10,Default,,0000,0000,0000,,!هراء! لن تجرؤ تايكو على قتل أحد
Dialogue: 0,0:10:16.10,0:10:21.07,Default,,0000,0000,0000,,،كنتِ متغيّبةً لقرابة ساعة أثناء الحفلة\Nصحيح يا تايكو-سان؟
Dialogue: 0,0:10:21.47,0:10:24.51,Default,,0000,0000,0000,,كان عليّ البحث عن شيء في المنزل
Dialogue: 0,0:10:24.51,0:10:26.47,Default,,0000,0000,0000,,فهو خلف الضريح
Dialogue: 0,0:10:26.47,0:10:29.01,Default,,0000,0000,0000,,أهناك من يشهد على وجودك؟
Dialogue: 0,0:10:29.01,0:10:32.31,Default,,0000,0000,0000,,كان جدّي خارجاً، فكنتُ بمفردي
Dialogue: 0,0:10:32.31,0:10:37.94,Default,,0000,0000,0000,,لكنّ تايكو-سان عادت مع مغادرة\Nأزاي-سان للنُزل يا أبي
Dialogue: 0,0:10:37.94,0:10:40.00,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:40.00,0:10:43.64,Default,,0000,0000,0000,,بقيت في الرواق طوال الوقت بعد عودتها
Dialogue: 0,0:10:44.04,0:10:47.10,Default,,0000,0000,0000,,أي يستحيل أن تكون من ارتكبت الجريمة
Dialogue: 0,0:10:47.66,0:10:49.44,Default,,0000,0000,0000,,اضبط عقلك
Dialogue: 0,0:10:49.79,0:10:52.48,Default,,0000,0000,0000,,أهناك بصمات على سلاح الجريمة؟
Dialogue: 0,0:10:52.48,0:10:54.81,Default,,0000,0000,0000,,كلا، لكن هناك آثار لإزالة أحدهم لها
Dialogue: 0,0:10:55.23,0:10:56.40,Default,,0000,0000,0000,,غريب
Dialogue: 0,0:10:56.40,0:10:58.44,Default,,0000,0000,0000,,إن كان للقاتل وقت كافٍ لإزالة البصمات
Dialogue: 0,0:10:58.44,0:11:00.52,Default,,0000,0000,0000,,فلمَ لم يأخذ سلاح الجريمة معه؟
Dialogue: 0,0:11:01.03,0:11:06.49,Default,,0000,0000,0000,,أبينكم من غادر النُزل بين العاشرة\Nوالعاشرة والنصف؟
Dialogue: 0,0:11:08.68,0:11:11.39,Default,,0000,0000,0000,,أنا ذهبتُ لشراء السجائر
Dialogue: 0,0:11:11.76,0:11:13.67,Default,,0000,0000,0000,,متى كان ذلك؟
Dialogue: 0,0:11:13.67,0:11:14.46,Default,,0000,0000,0000,,...في الواقع
Dialogue: 0,0:11:14.46,0:11:16.02,Default,,0000,0000,0000,,التاسعة وخمسٌ وأربعون
Dialogue: 0,0:11:17.09,0:11:19.42,Default,,0000,0000,0000,,صادف أن نظرتُ للساعة ذاك الوقت
Dialogue: 0,0:11:19.42,0:11:20.98,Default,,0000,0000,0000,,ومتى رجعت؟
Dialogue: 0,0:11:21.45,0:11:23.33,Default,,0000,0000,0000,,نصف ساعة بعدها
Dialogue: 0,0:11:23.33,0:11:25.78,Default,,0000,0000,0000,,أيّ عند العاشرة والربع؟
Dialogue: 0,0:11:25.78,0:11:26.44,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:11:26.95,0:11:28.66,Default,,0000,0000,0000,,بالمناسبة يا ناتشي-سان
Dialogue: 0,0:11:28.66,0:11:31.28,Default,,0000,0000,0000,,سمعت أنّك الوحيد الذي اختار\Nالإقامة في فندق تيتان
Dialogue: 0,0:11:31.28,0:11:32.39,Default,,0000,0000,0000,,بدل هذا النُزل
Dialogue: 0,0:11:32.82,0:11:38.36,Default,,0000,0000,0000,,لن يسمح لي فخر البطل\Nبأن أقيم في كوخٍ كهذا
Dialogue: 0,0:11:38.61,0:11:42.31,Default,,0000,0000,0000,,أين كنت بين العاشرة والعاشرة والنصف؟
Dialogue: 0,0:11:42.31,0:11:45.02,Default,,0000,0000,0000,,كنتُ في حانة الفندق حتى العاشرة
Dialogue: 0,0:11:45.02,0:11:46.71,Default,,0000,0000,0000,,يوجد الكثير من الشهود
Dialogue: 0,0:11:46.71,0:11:47.81,Default,,0000,0000,0000,,أسألك عمَّا بعدها
Dialogue: 0,0:11:49.06,0:11:50.85,Default,,0000,0000,0000,,كنتُ في غرفتي
Dialogue: 0,0:11:50.85,0:11:52.26,Default,,0000,0000,0000,,أهناك شهود؟
Dialogue: 0,0:11:52.26,0:11:54.43,Default,,0000,0000,0000,,!كنتُ بمفردي، لذا لا
Dialogue: 0,0:11:55.26,0:11:58.36,Default,,0000,0000,0000,,...القاتل أحد العمّال في الدراما
Dialogue: 0,0:11:58.59,0:12:02.77,Default,,0000,0000,0000,,الخيط الوحيد هو عبارة كوما إينو\Nالتي كتبها الضحية
Dialogue: 0,0:12:03.25,0:12:06.14,Default,,0000,0000,0000,,تايكو-سان هي الأقرب صلةً بتماثيل كوما إينو ظاهرياً
Dialogue: 0,0:12:06.14,0:12:11.35,Default,,0000,0000,0000,,لكنّها عادت للنُزل مع مغادرة الضحيّة له
Dialogue: 0,0:12:11.65,0:12:13.14,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:12:13.61,0:12:16.44,Default,,0000,0000,0000,,لمَ كانت الدهشة تغلب ملامحها آنذاك؟
Dialogue: 0,0:12:18.49,0:12:21.11,Default,,0000,0000,0000,,ذهب شيمازاكي-سان لشراء\Nالسجائر عند التاسعة وخمس وأربعون
Dialogue: 0,0:12:21.48,0:12:23.64,Default,,0000,0000,0000,,ثمّ عاد للنزل عند العاشرة والربع
Dialogue: 0,0:12:23.64,0:12:25.36,Default,,0000,0000,0000,,لديه وقت كافٍ لارتكاب الجريمة
Dialogue: 0,0:12:26.27,0:12:29.94,Default,,0000,0000,0000,,لكنّنا رأينا صورة الشخص عند الضريح\Nفي العاشرة والنصف
Dialogue: 0,0:12:29.94,0:12:31.55,Default,,0000,0000,0000,,وكان شيمازاكي-سان قد عاد للنُزل
Dialogue: 0,0:12:33.26,0:12:36.90,Default,,0000,0000,0000,,،لا يملك ناتشي-سان حجّة غياب بعد العاشرة\Nفيمكن أنّه ارتكبها أيضاً
Dialogue: 0,0:12:37.22,0:12:39.34,Default,,0000,0000,0000,,بدا أنّه يتعرض للابتزاز من الضحية
Dialogue: 0,0:12:39.34,0:12:41.85,Default,,0000,0000,0000,,لذا فهو الأكثر شبهةً من ناحية الدافع
Dialogue: 0,0:12:42.25,0:12:45.79,Default,,0000,0000,0000,,وبنيته هي الأقرب للشخص\Nالذي رأيناه في الظلام
Dialogue: 0,0:12:47.00,0:12:49.69,Default,,0000,0000,0000,,سيّدي المفتش، وجدنا هذه في غرفة الضحية
Dialogue: 0,0:12:52.47,0:12:56.98,Default,,0000,0000,0000,,هذه... صورتك وأنت تغادر الفندق\Nمع امرأة يا ناتشي-سان
Dialogue: 0,0:12:57.66,0:13:00.40,Default,,0000,0000,0000,,!هذه المرأة هي الممثلة هاغياما ريتسوكو
Dialogue: 0,0:13:01.44,0:13:03.85,Default,,0000,0000,0000,,!لكنّها متزوجة
Dialogue: 0,0:13:04.31,0:13:06.35,Default,,0000,0000,0000,,صور تدين علاقتك غير الشرعية
Dialogue: 0,0:13:06.77,0:13:08.59,Default,,0000,0000,0000,,...تـ-تذكرت
Dialogue: 0,0:13:08.59,0:13:10.57,Default,,0000,0000,0000,,أتعرفين شيئاً يا ران؟
Dialogue: 0,0:13:11.02,0:13:15.73,Default,,0000,0000,0000,,رأيتُ أنزاي-سان يبتزّ ناتشي-سان\Nقبل هبوط الظلام
Dialogue: 0,0:13:15.73,0:13:18.14,Default,,0000,0000,0000,,!يبتزّ؟
Dialogue: 0,0:13:18.14,0:13:20.19,Default,,0000,0000,0000,,!أنت القاتل إذاً
Dialogue: 0,0:13:20.19,0:13:22.17,Default,,0000,0000,0000,,!أخبرتك كلا
Dialogue: 0,0:13:22.17,0:13:25.50,Default,,0000,0000,0000,,!إن كنتُ القاتل فما معني كوما إينو؟
Dialogue: 0,0:13:25.50,0:13:27.77,Default,,0000,0000,0000,,أليس أحد ألقابك؟
Dialogue: 0,0:13:27.77,0:13:29.02,Default,,0000,0000,0000,,!أحمق
Dialogue: 0,0:13:29.11,0:13:34.73,Default,,0000,0000,0000,,لن يرضى بطلٌ مثلي\N!بلقب سخيفٍ كهذا
Dialogue: 0,0:13:35.49,0:13:38.61,Default,,0000,0000,0000,,ما المقصود بـ كوما إينو هذه بالضبط؟
Dialogue: 0,0:13:41.61,0:13:42.65,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:13:42.65,0:13:44.77,Default,,0000,0000,0000,,لمَ تكبّد عناء كتابة الرموز؟
Dialogue: 0,0:13:45.15,0:13:46.77,Default,,0000,0000,0000,,فقد قُتل أمام تمثال كوما إينو مباشرةً
Dialogue: 0,0:13:47.19,0:13:49.15,Default,,0000,0000,0000,,كلّ ما كان عليه هو توجيه إصبعه له
Dialogue: 0,0:13:49.48,0:13:51.18,Default,,0000,0000,0000,,لم تكن هناك حاجة للكتابة
Dialogue: 0,0:13:52.47,0:13:53.70,Default,,0000,0000,0000,,!هذا
Dialogue: 0,0:13:58.68,0:14:02.13,Default,,0000,0000,0000,,!ألديكم دليل أنّي كنت هنا أصلاً؟
Dialogue: 0,0:14:02.13,0:14:03.89,Default,,0000,0000,0000,,!هذا الرمز غريب
Dialogue: 0,0:14:04.17,0:14:05.98,Default,,0000,0000,0000,,!ليس مكتوباً بشكل صحيح
Dialogue: 0,0:14:06.25,0:14:07.85,Default,,0000,0000,0000,,!ذاك الشقيّ مجدداً
Dialogue: 0,0:14:08.59,0:14:10.50,Default,,0000,0000,0000,,...أنت! كم مرّةً أكرر كلامي
Dialogue: 0,0:14:10.50,0:14:14.23,Default,,0000,0000,0000,,هذا الرجل بالغ لكنه لم يعرف\Nكتابة الكاتاكانا بشكل صحيح حتى
Dialogue: 0,0:14:14.58,0:14:16.31,Default,,0000,0000,0000,,كتابتها بشكل صحيح؟
Dialogue: 0,0:14:16.31,0:14:21.22,Default,,0000,0000,0000,,انظر، يُفترض أن تكتب هذا الحرف بحركة واحدة
Dialogue: 0,0:14:21.22,0:14:23.93,Default,,0000,0000,0000,,لكنه فعل بحركتين
Dialogue: 0,0:14:23.93,0:14:25.52,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:26.98,0:14:28.23,Default,,0000,0000,0000,,...أنتَ مُحق
Dialogue: 0,0:14:29.27,0:14:31.97,Default,,0000,0000,0000,,الأمر نفسه مع الرمز الأخير
Dialogue: 0,0:14:31.97,0:14:32.47,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:14:34.10,0:14:39.15,Default,,0000,0000,0000,,أيمكن أنّ هذه الحركات الخاطئة\Nقد أُضيفت لاحقاً؟
Dialogue: 0,0:14:41.10,0:14:42.55,Default,,0000,0000,0000,,!البطل؟
Dialogue: 0,0:14:42.55,0:14:45.85,Default,,0000,0000,0000,,!البطل الوحيد هنا هو ناتشي شينغو
Dialogue: 0,0:14:46.30,0:14:48.61,Default,,0000,0000,0000,,يبدو أنّ الدليل الدامغ قد ظهر
Dialogue: 0,0:14:48.92,0:14:51.45,Default,,0000,0000,0000,,!كـ-كلا! لم يكن أنا
Dialogue: 0,0:14:51.45,0:14:55.49,Default,,0000,0000,0000,,كان يُفترض أن ألتقي أنزاي\Nهنا عند العاشرة والنصف حقاً
Dialogue: 0,0:14:55.49,0:14:58.90,Default,,0000,0000,0000,,!لكنه كان ميتاً في وقت وصولي
Dialogue: 0,0:14:59.20,0:15:00.83,Default,,0000,0000,0000,,!يكفي هراءً
Dialogue: 0,0:15:00.83,0:15:04.07,Default,,0000,0000,0000,,!إنّها الحقيقة! كان ميتاً بالفعل عندما أتيت
Dialogue: 0,0:15:04.07,0:15:07.44,Default,,0000,0000,0000,,كنتُ على وشك الهرب، لكني رأيت "البطل" مكتوبة
Dialogue: 0,0:15:07.44,0:15:11.18,Default,,0000,0000,0000,,فأضفت خطوط عامودية كما أفعل\Nمع أحجيات أعواد الثقاب التي أحلّها
Dialogue: 0,0:15:11.52,0:15:16.60,Default,,0000,0000,0000,,إذا لم تكن القاتل، فلمَ كتب الضحية "البطل"؟
Dialogue: 0,0:15:16.60,0:15:18.06,Default,,0000,0000,0000,,!كيف لي أن أعرف؟
Dialogue: 0,0:15:18.06,0:15:19.43,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:15:19.43,0:15:21.88,Default,,0000,0000,0000,,ليس من الطبيعي أن شخصاً زيّف رسالة احتضار
Dialogue: 0,0:15:21.88,0:15:24.10,Default,,0000,0000,0000,,لم يجهز حجّة غياب مزيفة
Dialogue: 0,0:15:24.59,0:15:28.81,Default,,0000,0000,0000,,أيمكن أن القاتل الحقيقي من عدّل\Nالرسالة لتكون "البطل"؟
Dialogue: 0,0:15:34.04,0:15:36.56,Default,,0000,0000,0000,,!أيمكن أنّ هذا ما أعتقده؟
Dialogue: 0,0:15:36.83,0:15:40.66,Default,,0000,0000,0000,,مستحيل، لا يمكن أن يكون ذاك الشخص
Dialogue: 0,0:15:42.99,0:15:43.77,Default,,0000,0000,0000,,...هذا
Dialogue: 0,0:15:46.24,0:15:48.69,Default,,0000,0000,0000,,!لا دم على على هذه الساعة
Dialogue: 0,0:15:48.99,0:15:51.81,Default,,0000,0000,0000,,!فهمت! هكذا إذاً
Dialogue: 0,0:15:51.81,0:15:54.18,Default,,0000,0000,0000,,!عرفتُ حقيقة هذه القضية
Dialogue: 0,0:15:54.64,0:15:56.94,Default,,0000,0000,0000,,!لم يكن أنا! لم أفعلها
Dialogue: 0,0:15:56.94,0:16:00.44,Default,,0000,0000,0000,,منظرك بائس الآن أيّها النجم البطل
Dialogue: 0,0:16:06.52,0:16:09.38,Default,,0000,0000,0000,,يمكنك الإدلاء بالتفاصيل في المركز
Dialogue: 0,0:16:09.38,0:16:11.43,Default,,0000,0000,0000,,!انتظروا
Dialogue: 0,0:16:11.87,0:16:15.44,Default,,0000,0000,0000,,مفتش ميغوري، ناتشي-سان ليس القاتل
Dialogue: 0,0:16:15.44,0:16:16.90,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:16:16.90,0:16:21.26,Default,,0000,0000,0000,,فالجريمة قد وقعت قبل العاشرة
Dialogue: 0,0:16:21.26,0:16:23.15,Default,,0000,0000,0000,,!مستحيل
Dialogue: 0,0:16:23.15,0:16:24.82,Default,,0000,0000,0000,,ما الذي تقوله يا أبي؟
Dialogue: 0,0:16:24.82,0:16:28.45,Default,,0000,0000,0000,,!رأينا أنزاي-سان يغادر النزل عند العاشرة
Dialogue: 0,0:16:28.45,0:16:30.86,Default,,0000,0000,0000,,!كما سمعنا منبّه ساعة يده
Dialogue: 0,0:16:30.86,0:16:34.31,Default,,0000,0000,0000,,حضرة المفتش، انظر لساعة يد الضحية
Dialogue: 0,0:16:34.31,0:16:35.81,Default,,0000,0000,0000,,ساعة يده؟
Dialogue: 0,0:16:37.89,0:16:40.65,Default,,0000,0000,0000,,ذراعه اليسرى تغطيها الدماء
Dialogue: 0,0:16:40.65,0:16:43.18,Default,,0000,0000,0000,,لكن لا دم على ساعته
Dialogue: 0,0:16:43.18,0:16:44.64,Default,,0000,0000,0000,,!مـ-معك حق
Dialogue: 0,0:16:44.64,0:16:50.43,Default,,0000,0000,0000,,مما يعني أنّ أحدهم خلع الساعة من الجثّة
Dialogue: 0,0:16:50.43,0:16:52.10,Default,,0000,0000,0000,,بعد أن قُتل الضحية
Dialogue: 0,0:16:52.46,0:16:54.56,Default,,0000,0000,0000,,خلع شخص ساعته؟
Dialogue: 0,0:16:54.56,0:16:57.62,Default,,0000,0000,0000,,أراد ذاك الشخص أن يجعل وقت وقوع الجريمة
Dialogue: 0,0:16:57.62,0:16:59.54,Default,,0000,0000,0000,,أبعد مما حصل
Dialogue: 0,0:16:59.54,0:17:03.49,Default,,0000,0000,0000,,فخطرت له فكرة أخذ الساعة معه للنزل
Dialogue: 0,0:17:03.49,0:17:05.99,Default,,0000,0000,0000,,وتفعيل المنبه في غرفة الضحية
Dialogue: 0,0:17:05.99,0:17:09.40,Default,,0000,0000,0000,,لكن ستكون مشكلةً لو تقطر الدم في طريق عودته
Dialogue: 0,0:17:09.40,0:17:11.81,Default,,0000,0000,0000,,فنظّف الساعة تماماً
Dialogue: 0,0:17:12.15,0:17:14.77,Default,,0000,0000,0000,,...أي أن من رأيناه في النزل
Dialogue: 0,0:17:15.15,0:17:17.81,Default,,0000,0000,0000,,أجل، لم يكن أنزاي-سان
Dialogue: 0,0:17:17.81,0:17:21.31,Default,,0000,0000,0000,,...من شغل المنبه في غرفة أنزاي-سان
Dialogue: 0,0:17:21.59,0:17:26.94,Default,,0000,0000,0000,,ارتدى السترة والقبعة وغادر بتنكّر أزاي-سان
Dialogue: 0,0:17:27.64,0:17:30.93,Default,,0000,0000,0000,,انطلق ذاك الشخص مسرعاً للضريح مجدداً
Dialogue: 0,0:17:30.93,0:17:33.56,Default,,0000,0000,0000,,وأعاد الساعة للجثة
Dialogue: 0,0:17:33.56,0:17:36.65,Default,,0000,0000,0000,,وترك القبعة والسترة بالقرب
Dialogue: 0,0:17:36.65,0:17:41.35,Default,,0000,0000,0000,,ثمّ كتب "البطل" لتوجيه التهمة نحو ناتشي-سان
Dialogue: 0,0:17:41.91,0:17:43.82,Default,,0000,0000,0000,,،لو أراد الشخص توجيه التهمة لـ ناتشي-سان
Dialogue: 0,0:17:43.82,0:17:45.95,Default,,0000,0000,0000,,!فلمَ لم يكتب ناتشي فقط؟
Dialogue: 0,0:17:45.95,0:17:48.81,Default,,0000,0000,0000,,!كان ذلك سيضللنا بتأثير أكبر
Dialogue: 0,0:17:48.81,0:17:51.06,Default,,0000,0000,0000,,"لم يستطع القاتل كتابة "ناتشي
Dialogue: 0,0:17:51.06,0:17:54.69,Default,,0000,0000,0000,,فالضحية قد كتب بالفعل
Dialogue: 0,0:17:54.69,0:17:56.19,Default,,0000,0000,0000,,ما يدين القاتل
Dialogue: 0,0:17:56.19,0:17:57.65,Default,,0000,0000,0000,,ما يدين القاتل؟
Dialogue: 0,0:17:57.65,0:17:58.81,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:17:58.81,0:18:01.64,Default,,0000,0000,0000,,البطل" كانت كلمةً كتبها الضحية"
Dialogue: 0,0:18:01.64,0:18:04.48,Default,,0000,0000,0000,,بخطوط إضافية كتُبت لاحقاً
Dialogue: 0,0:18:04.48,0:18:08.10,Default,,0000,0000,0000,,...أي أن الكلمة التي كتبها الضحية في الأصل
Dialogue: 0,0:18:08.10,0:18:11.64,Default,,0000,0000,0000,,إنّها... مامي
Dialogue: 0,0:18:12.25,0:18:16.02,Default,,0000,0000,0000,,ماميغاكي تايكو-سان، أنتِ القاتلة
Dialogue: 0,0:18:16.02,0:18:18.73,Default,,0000,0000,0000,,...مـ-مستحيل! لا يمكن أنّ تايكو
Dialogue: 0,0:18:18.73,0:18:20.34,Default,,0000,0000,0000,,لا يُعقل
Dialogue: 0,0:18:20.34,0:18:21.83,Default,,0000,0000,0000,,لكن موري-سان
Dialogue: 0,0:18:21.83,0:18:27.90,Default,,0000,0000,0000,,عادت تايكو-سان للنزل مع مغادرة الشخص\Nالذي تنكّر كأنزاي-سان
Dialogue: 0,0:18:27.90,0:18:30.98,Default,,0000,0000,0000,,!كان أنا! أنا قتلت أنزاي
Dialogue: 0,0:18:30.98,0:18:32.77,Default,,0000,0000,0000,,!كنتُ من تنكر بهيئته
Dialogue: 0,0:18:33.36,0:18:35.10,Default,,0000,0000,0000,,!لم تكن كلمة "مامي" مكتوبة
Dialogue: 0,0:18:35.60,0:18:39.90,Default,,0000,0000,0000,,،شيمازاكي-سان، كنتَ من قد تنكّر بهيئته فعلاً
Dialogue: 0,0:18:39.90,0:18:41.56,Default,,0000,0000,0000,,لكن لستَ المجرم
Dialogue: 0,0:18:41.56,0:18:45.76,Default,,0000,0000,0000,,ترون الدم المنتشر حول الجثة؟
Dialogue: 0,0:18:45.76,0:18:47.77,Default,,0000,0000,0000,,لا بدّ أنّ القاتل كانت تغطيه الدماء بدوره
Dialogue: 0,0:18:48.60,0:18:51.97,Default,,0000,0000,0000,,لكن لا توجد أيّ قطرة على ثيابك
Dialogue: 0,0:18:52.30,0:18:57.17,Default,,0000,0000,0000,,الوحيدة التي كان لها وقت\Nلتغيير ثيابها وغسل الدم
Dialogue: 0,0:18:57.17,0:18:59.02,Default,,0000,0000,0000,,هي تايكو-سان فقط
Dialogue: 0,0:18:59.02,0:19:02.16,Default,,0000,0000,0000,,!كلا! أنا قتلته
Dialogue: 0,0:19:02.16,0:19:04.58,Default,,0000,0000,0000,,يوجي-سان، انتهى الأمر
Dialogue: 0,0:19:04.58,0:19:05.35,Default,,0000,0000,0000,,!تايكو
Dialogue: 0,0:19:06.16,0:19:08.33,Default,,0000,0000,0000,,كما قال موري-سان
Dialogue: 0,0:19:08.33,0:19:10.44,Default,,0000,0000,0000,,أنا قتلتُ أنزاي
Dialogue: 0,0:19:10.44,0:19:11.81,Default,,0000,0000,0000,,!تايكو-سان
Dialogue: 0,0:19:11.81,0:19:12.64,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:19:13.11,0:19:18.44,Default,,0000,0000,0000,,لم تعرفي أنّ شيمازاكي-سان تنكر بهيئته؟
Dialogue: 0,0:19:18.44,0:19:19.57,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:19:19.57,0:19:25.22,Default,,0000,0000,0000,,لذا كنتُ مصدومةً عندما\Nرأيتُ أنزاي عند مدخل النزل
Dialogue: 0,0:19:25.22,0:19:28.15,Default,,0000,0000,0000,,لم أكن أملك فكرةً عمَّ يجري
Dialogue: 0,0:19:28.15,0:19:30.31,Default,,0000,0000,0000,,!لكن لمَ يا تايكو-سان؟
Dialogue: 0,0:19:32.34,0:19:36.10,Default,,0000,0000,0000,,تايكو-سان، كان أنزاي يبتزك أيضاً، صحيح؟
Dialogue: 0,0:19:36.84,0:19:38.09,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:19:38.09,0:19:41.75,Default,,0000,0000,0000,,عندما كنتُ في الثانوية، مررت بفترة تمرد لفترة قصيرة
Dialogue: 0,0:19:41.75,0:19:44.62,Default,,0000,0000,0000,,بعد موت والديّ في حادث
Dialogue: 0,0:19:44.62,0:19:48.50,Default,,0000,0000,0000,,توقفت عن ارتياد المدرسة وتسكّعت\Nمع أشخاص سيّئين
Dialogue: 0,0:19:48.50,0:19:51.65,Default,,0000,0000,0000,,كان أنزاي من ضمنهم
Dialogue: 0,0:19:52.99,0:19:54.49,Default,,0000,0000,0000,,جدّي
Dialogue: 0,0:19:54.49,0:19:57.66,Default,,0000,0000,0000,,أتذكر الجلبة الكبيرة التي وقعت\Nبعدما سُرق تمثال باهظ
Dialogue: 0,0:19:57.66,0:20:00.19,Default,,0000,0000,0000,,من مخزن الضريح؟
Dialogue: 0,0:20:00.19,0:20:01.56,Default,,0000,0000,0000,,...أ-أجل
Dialogue: 0,0:20:01.81,0:20:04.81,Default,,0000,0000,0000,,كانت غلطتي
Dialogue: 0,0:20:04.81,0:20:10.02,Default,,0000,0000,0000,,...فبعدما بحتُ بالأمر لأنزاي، سرقوه فوراً
Dialogue: 0,0:20:10.02,0:20:11.84,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:20:11.84,0:20:13.72,Default,,0000,0000,0000,,!لمَ لم تخبريني وقتها؟
Dialogue: 0,0:20:13.72,0:20:15.80,Default,,0000,0000,0000,,!حاولت
Dialogue: 0,0:20:15.80,0:20:19.47,Default,,0000,0000,0000,,لكن... سوغياما-سان الذي كان مشرف المخزن
Dialogue: 0,0:20:19.47,0:20:22.25,Default,,0000,0000,0000,,شعر بالمسؤولية وانتحر
Dialogue: 0,0:20:22.25,0:20:27.06,Default,,0000,0000,0000,,منعني الخوف من قول أيّ شيء بعد رؤية ذلك
Dialogue: 0,0:20:27.06,0:20:30.16,Default,,0000,0000,0000,,ومُذ آنذاك، توقفت عن مرافقة أنزاي وجماعته
Dialogue: 0,0:20:30.16,0:20:32.78,Default,,0000,0000,0000,,وعدتُ للمدرسة بجديّة
Dialogue: 0,0:20:32.78,0:20:37.06,Default,,0000,0000,0000,,كنتُ على وشك دفن ذكريات الحادثة البغيضة ونسيها
Dialogue: 0,0:20:37.36,0:20:42.19,Default,,0000,0000,0000,,كلّ ما أردتُه هو تزوّج يوجي-سان \Nوتشكيل عائلة سعيدة
Dialogue: 0,0:20:42.19,0:20:44.27,Default,,0000,0000,0000,,!لكنّه ظهر عندها
Dialogue: 0,0:20:44.27,0:20:46.98,Default,,0000,0000,0000,,وحاول ابتزازك
Dialogue: 0,0:20:46.98,0:20:48.23,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:20:48.23,0:20:50.84,Default,,0000,0000,0000,,قال أنّي كنت متواطئة في تلك الحادثة
Dialogue: 0,0:20:50.84,0:20:54.26,Default,,0000,0000,0000,,وأتحمل جزءاً من انتحار سوغياما-سان
Dialogue: 0,0:20:54.26,0:20:55.23,Default,,0000,0000,0000,,!لم يكفّ عن قول ذلك
Dialogue: 0,0:20:56.01,0:21:01.22,Default,,0000,0000,0000,,شعرتُ أنّه سيفسد زواجي إلّم أفعل شيئاً
Dialogue: 0,0:21:02.25,0:21:07.42,Default,,0000,0000,0000,,كان يُفترض أن أدفع له نقوداً\Nهنا الليلة عند التاسعة والنصف
Dialogue: 0,0:21:07.42,0:21:11.22,Default,,0000,0000,0000,,!لكني جلبت سكّيناً بدل ذلك لردّ تهديد أنزاي
Dialogue: 0,0:21:11.66,0:21:15.16,Default,,0000,0000,0000,,!أخبرته بألّا يظهر أمامي مجدداً
Dialogue: 0,0:21:15.16,0:21:17.98,Default,,0000,0000,0000,,...لكنه غضب ثمّ هاجمني
Dialogue: 0,0:21:18.49,0:21:20.27,Default,,0000,0000,0000,,...وعندها السكين اخترقت
Dialogue: 0,0:21:25.85,0:21:29.06,Default,,0000,0000,0000,,...لم أنو قتله
Dialogue: 0,0:21:32.68,0:21:39.34,Default,,0000,0000,0000,,،أثرتِ قلقي بملامحك عند مغادرتك\Nفتظاهرت بشراء السجائر وذهبت للضريح
Dialogue: 0,0:21:39.34,0:21:41.00,Default,,0000,0000,0000,,ووجدتُ أنزاي ميتاً
Dialogue: 0,0:21:41.00,0:21:44.00,Default,,0000,0000,0000,,و"مامي" مكتوبة بدمه
Dialogue: 0,0:21:44.00,0:21:46.63,Default,,0000,0000,0000,,ظننتُ أنّك من قتله
Dialogue: 0,0:21:46.63,0:21:49.17,Default,,0000,0000,0000,,!فبذلت قصارى جهدي لمحو الأدلّة
Dialogue: 0,0:21:49.17,0:21:50.54,Default,,0000,0000,0000,,مسحت البصمات عن السكّين
Dialogue: 0,0:21:50.54,0:21:53.70,Default,,0000,0000,0000,,وأعدت ساعة أنزاي معي للنُزل
Dialogue: 0,0:21:53.70,0:21:56.16,Default,,0000,0000,0000,,الباقي كما استنتج موري-سان
Dialogue: 0,0:21:56.16,0:21:59.16,Default,,0000,0000,0000,,كان عليّ إزالة رسالة الدم كليّاً
Dialogue: 0,0:21:59.16,0:22:02.68,Default,,0000,0000,0000,,لكن تذكرت أنّه هدّد ناتشي-سان مساء اليوم
Dialogue: 0,0:22:03.36,0:22:06.69,Default,,0000,0000,0000,,"فحوّلت "مامي" إلى "البطل
Dialogue: 0,0:22:07.19,0:22:09.86,Default,,0000,0000,0000,,!آسفة يا يوجي-سان! آسفة
Dialogue: 0,0:22:09.86,0:22:11.81,Default,,0000,0000,0000,,!تايكو
Dialogue: 0,0:24:06.23,0:24:07.99,Default,,0000,0000,0000,,كانت هذه الغرفة مغلقة
Dialogue: 0,0:24:07.99,0:24:10.19,Default,,0000,0000,0000,,لعلّه أقدم على الانتحار
Dialogue: 0,0:24:10.19,0:24:12.64,Default,,0000,0000,0000,,كلا، كانت جريمة قتل
Dialogue: 0,0:24:12.64,0:24:14.81,Default,,0000,0000,0000,,!أنتَ مُجدداً
Dialogue: 0,0:24:14.81,0:24:18.06,Default,,0000,0000,0000,,أمعن النظر لإطار المدخل
Dialogue: 0,0:24:18.48,0:24:22.10,Default,,0000,0000,0000,,!المجرم أحدكم السبعة
Dialogue: 0,0:24:24.84,0:24:26.26,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.26,0:24:29.65,Default,,0000,0000,0000,,سلسلة جرائم قتل السفينة السياحية الفاخرة\Nالجزء الأوّل
Dialogue: 0,0:24:45.90,0:24:48.53,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.53,0:24:49.72,Default,,0000,0000,0000,,كسرة خبز
Dialogue: 0,0:24:49.72,0:24:51.71,Default,,0000,0000,0000,,

