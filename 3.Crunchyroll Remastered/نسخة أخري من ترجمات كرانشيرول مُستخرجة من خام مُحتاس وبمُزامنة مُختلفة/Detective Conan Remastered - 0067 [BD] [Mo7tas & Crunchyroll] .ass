Dialogue: 0,0:00:00.85,0:00:02.85,Default,,0000,0000,0000,,عقرب دقائق مسرِع، مُذنّب ساقط
Dialogue: 0,0:00:02.85,0:00:06.37,Default,,0000,0000,0000,,لنعالج باستنتاجات كونان القلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:06.37,0:00:07.95,Default,,0000,0000,0000,,!قضيّة اليوم مسرحها عالم التمثيل
Dialogue: 0,0:00:08.46,0:00:10.29,Default,,0000,0000,0000,,!يختبئ التعطّش للدماء وراء الأنوار المتلألئة
Dialogue: 0,0:00:10.29,0:00:12.21,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.21,0:00:14.37,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.37,0:00:17.07,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.21,0:01:57.08,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل ممثلة المسرح
Dialogue: 0,0:01:52.05,0:01:54.70,Default,,0000,0000,0000,,جريمة قتل ممثلة المسرح
Dialogue: 0,0:02:02.83,0:02:05.03,On Top,,0000,0000,0000,,وكالة موري للتحرّي
Dialogue: 0,0:02:05.36,0:02:07.70,Default,,0000,0000,0000,,أنت أستاذ أبي؟
Dialogue: 0,0:02:07.70,0:02:11.44,Default,,0000,0000,0000,,لم يكن حاد الذهن
Dialogue: 0,0:02:11.44,0:02:16.68,Default,,0000,0000,0000,,لطالما احتاج مساعدتي بينما كان\Nفي الشرطة، وحتّى بعدما أصبح متحرّياً
Dialogue: 0,0:02:16.68,0:02:19.46,Default,,0000,0000,0000,,أأنت شيوتا هيهاتشيرو-سان يا جدّ؟
Dialogue: 0,0:02:19.81,0:02:24.87,CharCard,,0000,0000,0004,,{\fad(300,0)}شيوتا هيهاتشيرو\Nمتحرّي أسطوري
Dialogue: 0,0:02:22.35,0:02:24.91,On Top,,0000,0000,0000,,أنا المعروف بهولمز اليابان
Dialogue: 0,0:02:25.67,0:02:27.33,Default,,0000,0000,0000,,شيوتا هيهاتشيرو؟
Dialogue: 0,0:02:28.34,0:02:31.25,Default,,0000,0000,0000,,هذا العجوز هو ذاك المتحرّي الأسطوري؟
Dialogue: 0,0:02:31.76,0:02:36.45,Default,,0000,0000,0000,,بدا أنّ اسم موري يرتفع مؤخراً، لذا أتيتُ لمراقبته
Dialogue: 0,0:02:36.83,0:02:40.29,Default,,0000,0000,0000,,آسفة، قد خرج في قضيّة اليوم
Dialogue: 0,0:02:40.29,0:02:43.32,Default,,0000,0000,0000,,يبدو أنّ فرقة تمثيل مشهورة تلقّت تهديداً
Dialogue: 0,0:02:44.32,0:02:45.53,Default,,0000,0000,0000,,تهديد؟
Dialogue: 0,0:02:46.49,0:02:48.32,Default,,0000,0000,0000,,!أرشديني يا ابنتي
Dialogue: 0,0:02:48.32,0:02:49.00,Default,,0000,0000,0000,,...حاضر
Dialogue: 0,0:02:49.28,0:02:54.45,Default,,0000,0000,0000,,!هذا مُثير! أتشوّق لرؤية عمل المتحرّي الأسطوري
Dialogue: 0,0:02:54.45,0:02:56.95,On Top,,0000,0000,0000,,مسرح بيكا للفنون
Dialogue: 0,0:03:00.62,0:03:05.58,Default,,0000,0000,0000,,"ألغوا العرض، وإلّا سيصبح مأساة شنيعة"
Dialogue: 0,0:03:06.30,0:03:07.63,Default,,0000,0000,0000,,ألديك فكرة عن المُرسل؟
Dialogue: 0,0:03:07.63,0:03:09.09,Default,,0000,0000,0000,,بالطبع لا
Dialogue: 0,0:03:09.09,0:03:12.50,Default,,0000,0000,0000,,!أنتم! أين شوكو؟! متى سنبدأ التدريب؟
Dialogue: 0,0:03:12.92,0:03:14.70,Default,,0000,0000,0000,,لم تتجهّز بعد
Dialogue: 0,0:03:15.25,0:03:17.62,On Top,,0000,0000,0000,,تبّاً، بدأت تختال بنفسها
Dialogue: 0,0:03:15.31,0:03:19.16,CharCard,,0000,0000,0004,,{\fad(300,0)}موتوكي كازو\Nمخرج
Dialogue: 0,0:03:17.62,0:03:19.16,On Top,,0000,0000,0000,,لأنّها حصلت على أدوار تلفزية
Dialogue: 0,0:03:19.83,0:03:24.11,Default,,0000,0000,0000,,،بأيّ حال، هذا هو الوضع. قد يكون مجرّد مقلب\Nلكن الجميع يشعرون بالخوف
Dialogue: 0,0:03:24.11,0:03:26.24,Default,,0000,0000,0000,,هلّا تحرّيت؟
Dialogue: 0,0:03:26.24,0:03:28.50,Default,,0000,0000,0000,,لكن لا تؤثر على عملنا
Dialogue: 0,0:03:30.28,0:03:31.34,Default,,0000,0000,0000,,...تبّاً
Dialogue: 0,0:03:32.07,0:03:34.20,Default,,0000,0000,0000,,هذه هي إذاً
Dialogue: 0,0:03:34.81,0:03:36.56,Default,,0000,0000,0000,,!ما-ماذا تفعلان هنا؟
Dialogue: 0,0:03:36.56,0:03:39.23,Default,,0000,0000,0000,,طلب منّا شيوتا هيهاتشيرو-سان إرشاده للمكان
Dialogue: 0,0:03:39.23,0:03:41.48,Default,,0000,0000,0000,,!ماذا؟! ذاك العجوز؟
Dialogue: 0,0:03:41.48,0:03:42.21,Default,,0000,0000,0000,,أين؟ أين هو؟
Dialogue: 0,0:03:42.52,0:03:44.66,Default,,0000,0000,0000,,اختفى فورما وصلنا هنا
Dialogue: 0,0:03:45.13,0:03:46.59,Default,,0000,0000,0000,,اختفى؟
Dialogue: 0,0:03:52.04,0:03:53.44,Default,,0000,0000,0000,,!ابتعدوا
Dialogue: 0,0:03:56.33,0:03:59.54,Default,,0000,0000,0000,,هي-سان! ماذا تفعل هنا؟
Dialogue: 0,0:03:59.54,0:04:01.54,Default,,0000,0000,0000,,!لمس مؤخرتي
Dialogue: 0,0:04:01.54,0:04:06.45,Default,,0000,0000,0000,,سـ-سامحيني! لم يبق شيء على\N!مغادرتي لهذا العالم
Dialogue: 0,0:04:07.53,0:04:08.58,Default,,0000,0000,0000,,...هذا العجوز
Dialogue: 0,0:04:09.11,0:04:12.12,On Top,,0000,0000,0000,,ما الخطب يا شوكو-سان؟ أوقعت مشكلة؟
Dialogue: 0,0:04:09.76,0:04:12.21,CharCard,,0000,0000,0004,,{\fad(300,0)}ساساكي هيتومي\Nمديرة أعمال
Dialogue: 0,0:04:12.50,0:04:14.70,Default,,0000,0000,0000,,!لم أعد أحتمل! سئمت من كلّ شيء
Dialogue: 0,0:04:15.69,0:04:17.56,On Top,,0000,0000,0000,,وكيف يُملي عليّ ذاك المخرج الفاشل
Dialogue: 0,0:04:15.69,0:04:20.46,CharCard,,0000,0000,0004,,{\fad(300,0)}أويدي شوكو\Nممثلة رئيسية
Dialogue: 0,0:04:17.56,0:04:20.37,On Top,,0000,0000,0000,,!كيف أمثّل؟
Dialogue: 0,0:04:21.06,0:04:24.24,Default,,0000,0000,0000,,!وجعل حبيبي السابق بطلاً، هذا شنيع
Dialogue: 0,0:04:24.24,0:04:25.64,Default,,0000,0000,0000,,!ابتعدوا
Dialogue: 0,0:04:25.64,0:04:26.62,Default,,0000,0000,0000,,!شوكو-سان
Dialogue: 0,0:04:27.09,0:04:28.93,On Top,,0000,0000,0000,,!ممثلة استعراضية متغطرسة
Dialogue: 0,0:04:27.10,0:04:30.67,CharCard,,0000,0190,0004,,{\fad(300,0)}ناكاياما إيكو\Nممثلة
Dialogue: 0,0:04:30.96,0:04:35.33,Default,,0000,0000,0000,,ما خطب هذا؟ تظهر فجأةً ثمّ تعترض العمل؟
Dialogue: 0,0:04:35.33,0:04:38.00,Default,,0000,0000,0000,,لا تزال تلك الممثلة بحاجة لتعلّم الكثير
Dialogue: 0,0:04:38.88,0:04:41.17,Default,,0000,0000,0000,,المؤخرة هي دلالة للحياة
Dialogue: 0,0:04:41.17,0:04:44.87,Default,,0000,0000,0000,,بلمسة واحدة يمكنك معرفة كيف يعيش المرء
Dialogue: 0,0:04:47.28,0:04:48.54,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:04:51.82,0:04:52.63,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:04:55.31,0:04:56.41,Default,,0000,0000,0000,,!مُفعمة بالحياة
Dialogue: 0,0:04:56.90,0:04:59.36,Default,,0000,0000,0000,,أأنت المتحرّي العظيم حقّاً؟
Dialogue: 0,0:05:05.10,0:05:06.66,Default,,0000,0000,0000,,ما الذي يفعلونه؟
Dialogue: 0,0:05:07.14,0:05:11.30,Default,,0000,0000,0000,,يُدعى بتحديد المواضع، يُعلم الممثلين أين يقفون
Dialogue: 0,0:05:11.30,0:05:16.37,Default,,0000,0000,0000,,هذا مهم لتحديد مواقع معيّنة لتسليط الأنوار
Dialogue: 0,0:05:16.79,0:05:19.00,Default,,0000,0000,0000,,المسرحيات عمل معقد حقّاً
Dialogue: 0,0:05:19.00,0:05:20.79,Default,,0000,0000,0000,,!ما مشكلتك؟
Dialogue: 0,0:05:20.79,0:05:23.20,Default,,0000,0000,0000,,!كفّي عن التذمّر يا هاوية
Dialogue: 0,0:05:23.49,0:05:26.49,Default,,0000,0000,0000,,!لستُ أتذمر! أطلب فحسب
Dialogue: 0,0:05:26.49,0:05:31.33,Default,,0000,0000,0000,,!كادت الأنوار تسقط على شوكو الأسبوع الفائت
Dialogue: 0,0:05:31.33,0:05:34.19,Default,,0000,0000,0000,,ماذا؟ أتقصدين أنّي تعمّدت ذلك؟
Dialogue: 0,0:05:34.19,0:05:36.87,Default,,0000,0000,0000,,عجباً! هكذا الوضع فوق المسرح؟
Dialogue: 0,0:05:37.23,0:05:40.21,CharCard,,0000,0200,0004,,{\fad(300,0)}تاتيوكا جونيتشي\Nمسؤول المعدّات
Dialogue: 0,0:05:38.40,0:05:40.21,On Top,,0000,0000,0000,,تحقّقي بنفسك
Dialogue: 0,0:05:40.50,0:05:42.23,Default,,0000,0000,0000,,يا للسخرية
Dialogue: 0,0:05:44.14,0:05:45.64,Default,,0000,0000,0000,,شكراً لك يا ولد
Dialogue: 0,0:05:45.64,0:05:47.20,Default,,0000,0000,0000,,أهناك من يستهدف شوكو-سان؟
Dialogue: 0,0:05:47.81,0:05:49.26,Default,,0000,0000,0000,,ربما
Dialogue: 0,0:05:49.26,0:05:52.31,Default,,0000,0000,0000,,!لا يجدر بك التواجد هنا، المكان خطر
Dialogue: 0,0:05:57.33,0:06:00.66,Default,,0000,0000,0000,,هل أويدي شوكو-سان هي هدف الفاعل؟
Dialogue: 0,0:06:01.13,0:06:04.58,Default,,0000,0000,0000,,لن أتركك أبداً، ولو ذهبتُ للجحيم
Dialogue: 0,0:06:04.58,0:06:07.74,Default,,0000,0000,0000,,!سأتبعك أينما ذهبت
Dialogue: 0,0:06:07.74,0:06:12.00,Default,,0000,0000,0000,,!مُقدّر لحبّنا أن يصبح نجماً، ويربطنا في الجنّة بالتأكيد
Dialogue: 0,0:06:12.54,0:06:17.45,Default,,0000,0000,0000,,يا للملل، كان عليهم تمثيل\Nمسرحية "كونيسادا تشوجي" الكلاسيكية بدل هذا
Dialogue: 0,0:06:27.93,0:06:31.12,On Top,,0000,0000,0000,,هل ستموتين رفقتي؟
Dialogue: 0,0:06:27.93,0:06:31.34,CharCard,,0000,0200,0004,,{\fad(300,0)}أودا يويتشي\Nالبطل
Dialogue: 0,0:06:31.97,0:06:33.87,Default,,0000,0000,0000,,لا خوف يعتريني وأنا معك
Dialogue: 0,0:06:34.88,0:06:36.12,Default,,0000,0000,0000,,يا للتمثيل السيّئ
Dialogue: 0,0:07:04.64,0:07:08.45,Default,,0000,0000,0000,,!مُبهر يا شوكو! كان ذلك واقعياً تماماً
Dialogue: 0,0:07:08.45,0:07:13.01,Default,,0000,0000,0000,,!بحق، غلبتني بأدائك
Dialogue: 0,0:07:13.01,0:07:14.55,Default,,0000,0000,0000,,!شوكو
Dialogue: 0,0:07:18.97,0:07:19.75,Default,,0000,0000,0000,,...شوكو
Dialogue: 0,0:07:20.47,0:07:21.37,Default,,0000,0000,0000,,ما الخطب؟
Dialogue: 0,0:07:24.58,0:07:26.79,Default,,0000,0000,0000,,بربّك يا شوكو، هذا تمادٍ
Dialogue: 0,0:07:30.37,0:07:31.87,Default,,0000,0000,0000,,!إنّها ميتة
Dialogue: 0,0:07:32.37,0:07:34.45,Default,,0000,0000,0000,,!ابقوا أماكنكم جميعاً
Dialogue: 0,0:07:34.45,0:07:37.41,Default,,0000,0000,0000,,!تبّاً! أمام ناظريّ
Dialogue: 0,0:07:40.70,0:07:44.64,Default,,0000,0000,0000,,بشرة ورديّة، وبها بقع غريبة
Dialogue: 0,0:07:44.64,0:07:45.70,Default,,0000,0000,0000,,...هذا بوضوح
Dialogue: 0,0:07:45.70,0:07:49.16,Default,,0000,0000,0000,,تسمم بالسيانيد
Dialogue: 0,0:07:49.52,0:07:51.42,Default,,0000,0000,0000,,!هي-سان! لمَ أنت هنا؟
Dialogue: 0,0:07:51.85,0:07:54.05,Default,,0000,0000,0000,,سمعتُ عنك وعن موري
Dialogue: 0,0:07:54.05,0:07:56.58,Default,,0000,0000,0000,,لذا أتيتُ لرؤية مدى نموكما
Dialogue: 0,0:07:57.09,0:08:01.29,Default,,0000,0000,0000,,!بأيّ حال، أنت قد تقاعدت! لا تعترض عملنا رجاءً
Dialogue: 0,0:08:02.63,0:08:04.83,Default,,0000,0000,0000,,!اسمعوا لكلام المتبجّحين هذا
Dialogue: 0,0:08:04.83,0:08:11.25,Default,,0000,0000,0000,,من الذي أنقذ عملك عندما\Nتركتَ القاتل التسلسليّ يهرب؟
Dialogue: 0,0:08:11.25,0:08:13.03,Default,,0000,0000,0000,,...ذ-ذلك
Dialogue: 0,0:08:13.03,0:08:18.70,Default,,0000,0000,0000,,حللتُ لغز جريمة الغرفة المقفلة لك\Nفي إحدى المرات أيضاً
Dialogue: 0,0:08:19.49,0:08:23.19,Default,,0000,0000,0000,,لا تقلق حضرة المفتّش، لديّ فكرة عن المجرم
Dialogue: 0,0:08:23.19,0:08:27.75,Default,,0000,0000,0000,,أعتمد عليك، لن يسكت هي-سان أبداً\Nإذا سبقنا بحلّ الجريمة
Dialogue: 0,0:08:28.10,0:08:32.09,Default,,0000,0000,0000,,لعلّي سأجلس هنا وأراقب فحسب بكلّ رويّة
Dialogue: 0,0:08:32.89,0:08:38.09,Default,,0000,0000,0000,,المجرم كان من وضع السمّ\N!بدل المادة المزيّفة للمسرح! أنت يا أودا-سان
Dialogue: 0,0:08:38.09,0:08:41.58,Default,,0000,0000,0000,,سخافة، لم يكن لديّ دافع لقتل شوكو
Dialogue: 0,0:08:41.97,0:08:46.08,Default,,0000,0000,0000,,ليس صحيحاً، كنتَ تواعد شوكو
Dialogue: 0,0:08:46.08,0:08:50.25,Default,,0000,0000,0000,,لكنّها فاقتك شهرةً الآن، فلا بدّ أن الغيرة تملّكتك
Dialogue: 0,0:08:50.79,0:08:55.87,Default,,0000,0000,0000,,!كانت تتشاجر معك يومياً بخصوص الإخراج
Dialogue: 0,0:08:55.87,0:09:00.25,Default,,0000,0000,0000,,كان ذلك مجرّد جدال كي ننتج معاً مسرحية ممتازة
Dialogue: 0,0:09:00.25,0:09:01.71,Default,,0000,0000,0000,,!هكذا تقول
Dialogue: 0,0:09:02.24,0:09:05.74,Default,,0000,0000,0000,,ابتلاع السيانيد يقود للموت الفوريّ تقريباً
Dialogue: 0,0:09:06.27,0:09:11.15,Default,,0000,0000,0000,,شربت شوكو-سان الماء برويّة\Nبعدما تجرّعت المادة المزيفة
Dialogue: 0,0:09:12.45,0:09:15.13,Default,,0000,0000,0000,,لم يكن هناك سمّ بها
Dialogue: 0,0:09:15.56,0:09:19.40,Default,,0000,0000,0000,,انظر، سأثبت الآن إذا كان هناك سمّاً أم لا
Dialogue: 0,0:09:19.40,0:09:20.34,Default,,0000,0000,0000,,!انتظر! لا
Dialogue: 0,0:09:20.77,0:09:22.23,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:09:23.70,0:09:24.58,Default,,0000,0000,0000,,رأيتم؟
Dialogue: 0,0:09:26.55,0:09:27.54,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:09:28.30,0:09:30.96,Default,,0000,0000,0000,,كيف تجرّعت شوكو-سان السمّ؟
Dialogue: 0,0:09:31.68,0:09:34.75,Default,,0000,0000,0000,,استمرّ التدريب لأربعين دقيقة متتالية
Dialogue: 0,0:09:35.21,0:09:39.54,Default,,0000,0000,0000,,،لو تجرّعت كبسولة قبل التدريب\Nكانت لتتحلل في غضون 15 دقيقة
Dialogue: 0,0:09:39.54,0:09:43.82,Default,,0000,0000,0000,,كما أنّها ليست مُحكمة السدّ، فليست صالحة للسيانيد
Dialogue: 0,0:09:43.82,0:09:45.17,Default,,0000,0000,0000,,...في تلك الحالة
Dialogue: 0,0:09:45.88,0:09:47.79,Default,,0000,0000,0000,,!يا لغطرستها
Dialogue: 0,0:09:48.49,0:09:51.17,Default,,0000,0000,0000,,كانت هي من جلب الماء والكأسين
Dialogue: 0,0:09:53.56,0:09:54.63,Default,,0000,0000,0000,,!ليست هنا
Dialogue: 0,0:09:55.36,0:09:59.13,Default,,0000,0000,0000,,!ما الذي تفعلانه؟ لم تتطوّرا البتّة
Dialogue: 0,0:09:59.48,0:10:02.15,Default,,0000,0000,0000,,أي أنّك عرفت الفاعل؟
Dialogue: 0,0:10:02.15,0:10:05.02,Default,,0000,0000,0000,,هذا من أبسط الأساسيّات، الفاعل كانت المرأة
Dialogue: 0,0:10:05.02,0:10:05.58,Default,,0000,0000,0000,,المرأة؟
Dialogue: 0,0:10:06.26,0:10:10.05,Default,,0000,0000,0000,,كانت من حمل إناء الماء والكأسين
Dialogue: 0,0:10:10.05,0:10:15.13,Default,,0000,0000,0000,,!هكذا إذاً! وضعت السمّ في الإناء
Dialogue: 0,0:10:17.88,0:10:19.83,Default,,0000,0000,0000,,!أنت! ما الذي تفعلينه؟
Dialogue: 0,0:10:19.83,0:10:23.95,Default,,0000,0000,0000,,!ما خطبك؟! لا شيء! أنظّف فحسب
Dialogue: 0,0:10:23.95,0:10:27.33,Default,,0000,0000,0000,,!ما الذي تحاولين إخفاءه؟ أريني
Dialogue: 0,0:10:27.33,0:10:28.42,Default,,0000,0000,0000,,!ما الذي تفعله؟
Dialogue: 0,0:10:30.20,0:10:32.48,Default,,0000,0000,0000,,!ما قصدك أنّي فعلت؟
Dialogue: 0,0:10:32.48,0:10:36.98,Default,,0000,0000,0000,,!أخبرتكم ألّا يتحرّك أحد حتّى ننهي التحقيق
Dialogue: 0,0:10:36.98,0:10:38.32,Default,,0000,0000,0000,,...هذه
Dialogue: 0,0:10:38.32,0:10:41.34,Default,,0000,0000,0000,,اُستعمل هذا الدفتر لكتابة رسالة التهديد
Dialogue: 0,0:10:41.73,0:10:45.00,Default,,0000,0000,0000,,!ماذا؟ أنت يا ولد\N!تتدخل في التحقيق مُجدداً
Dialogue: 0,0:10:45.47,0:10:48.06,Default,,0000,0000,0000,,!يستحيل أن تعرف ذلك بتلك السهولة
Dialogue: 0,0:10:48.06,0:10:50.56,Default,,0000,0000,0000,,لكن انظر، توجد آثار للقلم
Dialogue: 0,0:10:51.81,0:10:53.37,Default,,0000,0000,0000,,...معك حق
Dialogue: 0,0:10:57.67,0:11:00.55,Default,,0000,0000,0000,,حُلّت القضيّة سريعاً بفضلك
Dialogue: 0,0:11:02.95,0:11:06.08,Default,,0000,0000,0000,,كيف عرفت أنّ المرأة مثيرة للشبهة؟
Dialogue: 0,0:11:06.62,0:11:10.26,Default,,0000,0000,0000,,"كما تنصّ المقولة "توجد مرأة في ظلّ كل جريمة
Dialogue: 0,0:11:10.79,0:11:12.71,Default,,0000,0000,0000,,أنت... هذه مزحة، صحيح؟
Dialogue: 0,0:11:12.71,0:11:13.78,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:11:13.78,0:11:15.86,Default,,0000,0000,0000,,ما الأمر يا تاكاغي-كن؟
Dialogue: 0,0:11:15.86,0:11:18.17,Default,,0000,0000,0000,,لم نجد أيّ سيانيد
Dialogue: 0,0:11:18.48,0:11:25.13,Default,,0000,0000,0000,,أخبرتكم! أعترف بكتابتي رسالة التهديد\N!لكنّي لم أقتل تلك المرأة
Dialogue: 0,0:11:25.13,0:11:26.81,Default,,0000,0000,0000,,حقّاً؟
Dialogue: 0,0:11:26.81,0:11:31.59,Default,,0000,0000,0000,,لكنّك انفعلتِ جدّاً عندما\Nحصلت شوكو على دور البطلة
Dialogue: 0,0:11:31.93,0:11:37.17,Default,,0000,0000,0000,,!بالطبع! لكنّك قلت أنّك تتمنّى موتها بدورك
Dialogue: 0,0:11:37.17,0:11:41.13,Default,,0000,0000,0000,,!أنا أكثر من سيعاني إذا توقّفت هذه المسرحية
Dialogue: 0,0:11:41.13,0:11:42.70,Default,,0000,0000,0000,,...رويدكما
Dialogue: 0,0:11:42.70,0:11:43.66,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:11:44.91,0:11:49.29,Default,,0000,0000,0000,,وجدنا سيانيداً في الماء المتبقّي\Nفي كأس الضحيّة
Dialogue: 0,0:11:49.29,0:11:50.67,Default,,0000,0000,0000,,لم يكن هناك شيءٌ بالإناء
Dialogue: 0,0:11:51.12,0:11:53.19,Default,,0000,0000,0000,,كانت أنت بالفعل إذاً
Dialogue: 0,0:11:53.19,0:11:55.94,Default,,0000,0000,0000,,!لم أكن أنا أيّها المتحرّي الفاشل
Dialogue: 0,0:11:55.94,0:12:01.63,Default,,0000,0000,0000,,ألم يعطك أحد الكأس قبل بدء المسرحية\Nفي الكواليس يا إيكو-سان؟
Dialogue: 0,0:12:01.63,0:12:03.50,Default,,0000,0000,0000,,!بلى، صحيح
Dialogue: 0,0:12:04.02,0:12:07.00,Default,,0000,0000,0000,,!كان تاتيوكا-سان من جهّز الكأس
Dialogue: 0,0:12:07.21,0:12:11.02,Default,,0000,0000,0000,,!كـ-كان أنا، لكنّي لم أضع أيّ سم
Dialogue: 0,0:12:11.02,0:12:15.75,Default,,0000,0000,0000,,.بالمناسبة، أخبرتني شوكو أن أطردك\Nما الذي حصل بالضبط؟
Dialogue: 0,0:12:16.38,0:12:20.09,Default,,0000,0000,0000,,مديرة الأعمال ساساكي هيتومي-سان، هل سمعتِ بشيء؟
Dialogue: 0,0:12:20.72,0:12:25.04,Default,,0000,0000,0000,,كان تاتيوكا-سان يسترق النظر\Nبينما كانت تغيّر ثيابها
Dialogue: 0,0:12:25.33,0:12:27.96,Default,,0000,0000,0000,,...لا بدّ أنّك أضمرت لها السوء
Dialogue: 0,0:12:28.29,0:12:30.37,Default,,0000,0000,0000,,لم يكن الفاعل
Dialogue: 0,0:12:30.37,0:12:31.37,Default,,0000,0000,0000,,لمَ؟
Dialogue: 0,0:12:31.37,0:12:33.20,Default,,0000,0000,0000,,لأنّه ليس مرأة؟
Dialogue: 0,0:12:35.24,0:12:36.71,Default,,0000,0000,0000,,يا لفطنتك
Dialogue: 0,0:12:37.24,0:12:40.09,Default,,0000,0000,0000,,أبسط الأساسيّات إذاً؟
Dialogue: 0,0:12:40.09,0:12:42.44,Default,,0000,0000,0000,,أبسط الأساسيّات؟
Dialogue: 0,0:12:42.44,0:12:46.13,Default,,0000,0000,0000,,لن تلتئم الصورة إذا كان \Nتاتيوكا-سان يستهدف شوكو-سان
Dialogue: 0,0:12:46.94,0:12:49.35,Default,,0000,0000,0000,,كان الكأسان متماثلين
Dialogue: 0,0:12:49.35,0:12:54.37,Default,,0000,0000,0000,,وضع أيّهما أمام شوكو-سان\Nكان أمراً بيد النادلة إيكو-سان فقط
Dialogue: 0,0:12:54.84,0:12:56.88,Default,,0000,0000,0000,,يستحيل عليه استهدافها بالتحديد
Dialogue: 0,0:12:56.88,0:13:00.05,Default,,0000,0000,0000,,!أفصح عن الحقيقة وأنه الأمر
Dialogue: 0,0:13:00.05,0:13:02.92,Default,,0000,0000,0000,,!إنّها الحقيقة! لم أضع أيّ سم
Dialogue: 0,0:13:02.92,0:13:07.84,Default,,0000,0000,0000,,...فكّرتُ بإصابتها عبر العبث بالستائر قليلاً فحسب
Dialogue: 0,0:13:08.46,0:13:10.50,Default,,0000,0000,0000,,العبث بالستائر؟
Dialogue: 0,0:13:14.61,0:13:16.21,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:13:18.99,0:13:20.63,Default,,0000,0000,0000,,!سـ-سأبقى
Dialogue: 0,0:13:21.28,0:13:25.08,Default,,0000,0000,0000,,ما الذي تقوله؟ لمَ أنا هنا برأيك؟
Dialogue: 0,0:13:25.60,0:13:28.65,Default,,0000,0000,0000,,واجب الأستاذ إصلاح ما يفسده تلامذته
Dialogue: 0,0:13:28.65,0:13:30.55,Default,,0000,0000,0000,,استرخ وتماثل للشفاء
Dialogue: 0,0:13:30.98,0:13:33.39,Default,,0000,0000,0000,,سأحلّ أنا القضيّة
Dialogue: 0,0:13:34.76,0:13:38.31,Default,,0000,0000,0000,,...لن أدعك! تخطف الأضواء دوماً
Dialogue: 0,0:13:39.50,0:13:41.74,Default,,0000,0000,0000,,!خذوه للمشفى بسرعة رجاءً
Dialogue: 0,0:13:49.13,0:13:52.70,Default,,0000,0000,0000,,كيف جعل القاتل شوكو-سان تتجرّع السيانيد؟
Dialogue: 0,0:13:52.70,0:13:55.78,Default,,0000,0000,0000,,لم يضعه في الكأس، أو الماء
Dialogue: 0,0:13:56.78,0:14:01.16,Default,,0000,0000,0000,,كان ذلك قبيل شربها للماء بلا شكّ
Dialogue: 0,0:14:01.16,0:14:03.37,Default,,0000,0000,0000,,نظرة حسنة يا فتى
Dialogue: 0,0:14:03.65,0:14:07.29,Default,,0000,0000,0000,,!تبدو كمتحرٍّ أكثر من موري بمراحل
Dialogue: 0,0:14:07.90,0:14:12.89,Default,,0000,0000,0000,,أخبرني يا جدّ، كيف سمّم القاتل\Nشوكو-سان برأيك؟
Dialogue: 0,0:14:12.89,0:14:17.29,Default,,0000,0000,0000,,سؤال جيّد، الإجابة في علم الإله فقط
Dialogue: 0,0:14:19.18,0:14:21.72,Default,,0000,0000,0000,,ليس شيئاً أستخفّ به يا ولد
Dialogue: 0,0:14:21.72,0:14:23.96,Default,,0000,0000,0000,,أتعرف رواية "خيط العنكبوت"؟
Dialogue: 0,0:14:23.96,0:14:27.54,Default,,0000,0000,0000,,!أجل! التي ألّفها أكوتاغاوا ريونوسكي
Dialogue: 0,0:14:27.92,0:14:33.66,Default,,0000,0000,0000,,صحيح، قال أنّ البوذا مطّلع\Nعلى كلّ الأمور من خيرها وشرّها
Dialogue: 0,0:14:33.66,0:14:36.50,Default,,0000,0000,0000,,انظر لذاك المنظر القبيح
Dialogue: 0,0:14:36.50,0:14:40.41,Default,,0000,0000,0000,,!تاتيوكا! أكنت تحاول إفساد مسرحيتي؟
Dialogue: 0,0:14:40.41,0:14:43.57,Default,,0000,0000,0000,,!هذه غلطتك لاستعمال تلك الممثلة الفاشلة
Dialogue: 0,0:14:43.57,0:14:44.71,Default,,0000,0000,0000,,!تلومينني أنا؟
Dialogue: 0,0:14:44.71,0:14:51.30,Default,,0000,0000,0000,,عندما يتشاجر الحمقى، لا يدركون كشفهم لقبحهم الذاتيّ
Dialogue: 0,0:14:52.35,0:14:56.56,Default,,0000,0000,0000,,مثل الأغبياء الذين يقطعون خيط العنكبوت
Dialogue: 0,0:14:56.56,0:14:58.25,Default,,0000,0000,0000,,الذي يمدّه البوذا إليهم
Dialogue: 0,0:14:59.26,0:15:02.76,Default,,0000,0000,0000,,...هذا ليس وقت خيط العنكبوت، علينا الآن معرفة هويّة
Dialogue: 0,0:15:03.67,0:15:04.96,Default,,0000,0000,0000,,خيط العنكبوت؟
Dialogue: 0,0:15:08.88,0:15:11.09,Default,,0000,0000,0000,,ما خطب تلك النجمة المرفوعة؟
Dialogue: 0,0:15:20.79,0:15:21.66,Default,,0000,0000,0000,,!هنا
Dialogue: 0,0:15:23.73,0:15:25.50,Default,,0000,0000,0000,,!فوق الطاولة تماماً
Dialogue: 0,0:15:27.03,0:15:28.86,Default,,0000,0000,0000,,...خيط صيد ممزق
Dialogue: 0,0:15:28.86,0:15:30.99,Default,,0000,0000,0000,,كان مربوطاً حول حبل النجمة
Dialogue: 0,0:15:31.69,0:15:33.62,Default,,0000,0000,0000,,خيط العنكبوت؟ فهمت الآن
Dialogue: 0,0:15:34.31,0:15:39.75,Default,,0000,0000,0000,,باستعمال هذه الطريقة، كان يمكن لأيّ أحد\N!وضع السيانيد في كأس شوكو-سان
Dialogue: 0,0:15:45.34,0:15:50.67,Default,,0000,0000,0000,,أكان واجب تاتيوكا-سان إعطاء\Nالماء للنادلة ناكاياما إيكو-سان؟
Dialogue: 0,0:15:50.67,0:15:53.33,Default,,0000,0000,0000,,كلا، كان يمكن لأيّ أحد إعطاؤها إيّاه
Dialogue: 0,0:15:56.32,0:15:59.21,Default,,0000,0000,0000,,فهمت، كان هذا الشخص
Dialogue: 0,0:15:59.21,0:16:02.65,Default,,0000,0000,0000,,يا للورطة، العمّ ليس موجوداً عندما أحتاجه
Dialogue: 0,0:16:02.65,0:16:06.13,Default,,0000,0000,0000,,!وجدتُها! هناك شخص مثاليّ للدور
Dialogue: 0,0:16:06.13,0:16:08.50,Default,,0000,0000,0000,,!أعتمد عليك أيّها المتحرّي الأسطوري
Dialogue: 0,0:16:10.53,0:16:13.17,Default,,0000,0000,0000,,وقت القيلولة؟
Dialogue: 0,0:16:18.02,0:16:22.59,Default,,0000,0000,0000,,إذاً يا تاتيوكا-سان، يمكنك توضيح\N!ما لديك في المركز
Dialogue: 0,0:16:24.09,0:16:29.97,Default,,0000,0000,0000,,...يبدو أنّ الطاقم اجتمع، لذا حان وقت بدء العرض
Dialogue: 0,0:16:31.05,0:16:35.08,Default,,0000,0000,0000,,وكشف هويّة بطل ومنتج هذه المسرحية
Dialogue: 0,0:16:35.46,0:16:37.79,Default,,0000,0000,0000,,تـ-تقصد أنّ المجرم شخص آخر؟
Dialogue: 0,0:16:38.29,0:16:40.12,Default,,0000,0000,0000,,بالفعل
Dialogue: 0,0:16:40.12,0:16:43.24,Default,,0000,0000,0000,,كان المجرم ينتظر لحظةً محدّدة
Dialogue: 0,0:16:43.24,0:16:50.71,Default,,0000,0000,0000,,أجل، الذروة عندما تتسمّر أنظار الجميع\Nعلى البطلين شوكو-سان وأودا-سان
Dialogue: 0,0:16:51.11,0:16:54.92,Default,,0000,0000,0000,,لكن ألن يستطيع الجميع رؤية\Nإضافة القاتل للسمّ وقتها؟
Dialogue: 0,0:16:55.52,0:16:59.27,Default,,0000,0000,0000,,...كان الوضع مختلفاً قليلاً عندها
Dialogue: 0,0:16:59.27,0:17:04.21,Default,,0000,0000,0000,,سُلّط الضوء عليهما وحدهما، ومحيطهما مُظلم تماماً
Dialogue: 0,0:17:04.88,0:17:08.22,Default,,0000,0000,0000,,انتظر القاتل لحظة الظلام تلك
Dialogue: 0,0:17:09.55,0:17:16.38,Default,,0000,0000,0000,,...لكن يا هي-سان، مهما كان الظلام حالكاً\Nلا يمكن أن يقترب أحد من الطاولة دون انتباه أحد
Dialogue: 0,0:17:17.08,0:17:19.84,Default,,0000,0000,0000,,لم يكن هناك داعٍ ليغترب
Dialogue: 0,0:17:20.25,0:17:22.02,Default,,0000,0000,0000,,يغترب؟
Dialogue: 0,0:17:23.41,0:17:25.53,Default,,0000,0000,0000,,لا، أقصد يقترب
Dialogue: 0,0:17:25.53,0:17:31.57,Default,,0000,0000,0000,,عندما يركّز الناس على نقطة، ينعدم انتباههم لغيرها
Dialogue: 0,0:17:31.57,0:17:33.00,Default,,0000,0000,0000,,تحديداً ما هو في الأعلى
Dialogue: 0,0:17:34.19,0:17:36.67,Default,,0000,0000,0000,,سكب أحدهم السّيانيد من الأعلى؟
Dialogue: 0,0:17:36.67,0:17:39.92,Default,,0000,0000,0000,,هذا مُحتمل، لكن غير مرجّح
Dialogue: 0,0:17:40.60,0:17:44.26,Default,,0000,0000,0000,,سنسمع صوت سقوطه في الماء\Nلو ألقاه من الأعلى
Dialogue: 0,0:17:44.26,0:17:48.55,Default,,0000,0000,0000,,كما لا يمكن لأحد سكبه في الكأس\N!من ذاك الارتفاع بدقّة
Dialogue: 0,0:17:50.26,0:17:53.08,Default,,0000,0000,0000,,لا تملك مخيّلة بالنسبة لمخرج
Dialogue: 0,0:17:54.88,0:17:59.05,Default,,0000,0000,0000,,أتعرف رواية خيط العنكبوت لأكوتاغاوا ريونوسكي؟
Dialogue: 0,0:17:59.33,0:18:05.12,Default,,0000,0000,0000,,أتقصد عندما حاول البوذا إنقاذ\N...اللصوص الذين سقطوا في الجحيم بإلقاء
Dialogue: 0,0:18:05.99,0:18:07.00,Default,,0000,0000,0000,,!خيط؟
Dialogue: 0,0:18:07.53,0:18:14.23,Default,,0000,0000,0000,,أجل، ألا ترون النجمة المرتفعة\Nعن غيرها في السقف؟
Dialogue: 0,0:18:14.90,0:18:18.92,Default,,0000,0000,0000,,مربوطٌ حولها خيط صيد اُستعمل في الجريمة
Dialogue: 0,0:18:19.31,0:18:25.89,Default,,0000,0000,0000,,بطرفه يوجد ثقل، تفقّدوه وستجدون سيانيداً
Dialogue: 0,0:18:26.89,0:18:31.67,Default,,0000,0000,0000,,أخفض القاتل الثقل المسممّ من النجمة
Dialogue: 0,0:18:31.67,0:18:34.96,Default,,0000,0000,0000,,أدخله الكأس، ثم سحبه للأعلى
Dialogue: 0,0:18:36.34,0:18:39.46,Default,,0000,0000,0000,,ودون علمها، شربت الضحيّة الماء
Dialogue: 0,0:18:40.34,0:18:45.28,Default,,0000,0000,0000,,أي أنّ براءتي أُثبتت بما أنّي\N!لم أكن في الأعلى وقت الجريمة
Dialogue: 0,0:18:45.28,0:18:46.29,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:18:46.99,0:18:50.80,Default,,0000,0000,0000,,يمكنك تنفيذ هذه الحيلة حتّى\Nدون تواجدك في الأعلى
Dialogue: 0,0:18:51.12,0:18:52.75,Default,,0000,0000,0000,,لكن كيف؟
Dialogue: 0,0:18:53.07,0:18:57.48,Default,,0000,0000,0000,,أليس مكان كأس الضحيّة مُحدّداً سلفاً؟
Dialogue: 0,0:18:57.48,0:19:00.46,Default,,0000,0000,0000,,أظنّ ذلك يُدعى بتحديد المواضع
Dialogue: 0,0:19:01.40,0:19:09.60,Default,,0000,0000,0000,,يمكنك تنفيذ هذا من الكواليس بإنزال الخيط من السقف\N عبر النجمة، والاستمرار بنفس الخطّ حتّى يدخل الكأس
Dialogue: 0,0:19:10.26,0:19:14.63,Default,,0000,0000,0000,,لكن علق الخيط بحبل النجمة عندما سُحب مُجدداً
Dialogue: 0,0:19:15.13,0:19:18.38,Default,,0000,0000,0000,,!تلك النجمة المرفوعة على السقف
Dialogue: 0,0:19:18.38,0:19:21.30,Default,,0000,0000,0000,,!من الفاعل؟ من كان الفاعل؟
Dialogue: 0,0:19:21.99,0:19:25.13,Default,,0000,0000,0000,,يمكننا معرفة ذلك بفحص أيديهم
Dialogue: 0,0:19:25.45,0:19:26.24,Default,,0000,0000,0000,,أيديهم؟
Dialogue: 0,0:19:26.24,0:19:28.12,Default,,0000,0000,0000,,ما هذا الكلام يا عجوز؟
Dialogue: 0,0:19:28.12,0:19:32.08,Default,,0000,0000,0000,,تفاهة، هل ستعرف القاتل عن طريق قراءة كفّ اليد؟
Dialogue: 0,0:19:32.40,0:19:37.50,Default,,0000,0000,0000,,!لن يستطيع المُذنب الكشف عن راحة يده
Dialogue: 0,0:19:37.90,0:19:40.48,Default,,0000,0000,0000,,هكذا إذاً؟
Dialogue: 0,0:19:40.48,0:19:43.25,Default,,0000,0000,0000,,!حسناً، ليفتح الجميع أياديهم
Dialogue: 0,0:19:45.56,0:19:46.38,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:19:48.27,0:19:52.37,Default,,0000,0000,0000,,حسنٌ، تحقّقوا من أيديهم جميعاً الآن
Dialogue: 0,0:20:02.00,0:20:06.88,Default,,0000,0000,0000,,،مديرة الأعمال ساساكي هيتومي-سان\Nما الخطب؟ افتحي يديك لنا رجاءً
Dialogue: 0,0:20:10.79,0:20:12.25,Default,,0000,0000,0000,,...هـ-هذه الآثار
Dialogue: 0,0:20:12.86,0:20:16.84,Default,,0000,0000,0000,,أجل، إنّها نتيجة سحب خيط الصيد بقوّة
Dialogue: 0,0:20:17.40,0:20:18.84,Default,,0000,0000,0000,,كانت متوترة غالباً
Dialogue: 0,0:20:21.36,0:20:26.73,Default,,0000,0000,0000,,أمر موري الجميع بالبقاء أماكنهم بعد وقوع الحادثة
Dialogue: 0,0:20:27.68,0:20:32.58,Default,,0000,0000,0000,,يُفترض أنّ خيط الصيد الذي استعملتِه\Nفي الجريمة لا يزال في جيبك
Dialogue: 0,0:20:32.84,0:20:35.05,Default,,0000,0000,0000,,لمَ قد تفعل مديرة الأعمال هذا؟
Dialogue: 0,0:20:35.05,0:20:38.17,Default,,0000,0000,0000,,لأنّي هجرتُك لأجل شوكو؟
Dialogue: 0,0:20:38.42,0:20:39.45,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:20:40.17,0:20:45.08,Default,,0000,0000,0000,,تقبّلتُ اختيارك لها عليّ
Dialogue: 0,0:20:45.08,0:20:46.08,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:20:47.16,0:20:48.55,Default,,0000,0000,0000,,انفصلتُ عن أودا
Dialogue: 0,0:20:49.66,0:20:52.25,Default,,0000,0000,0000,,إنّه مُمل وجاهل كما ظننت
Dialogue: 0,0:20:52.74,0:20:56.45,Default,,0000,0000,0000,,يمكنك استعادته، لمَ لا ترجعين له؟
Dialogue: 0,0:20:58.95,0:21:02.39,Default,,0000,0000,0000,,لم تهتمّ لأمر المسرحية أبداً
Dialogue: 0,0:21:02.39,0:21:05.35,Default,,0000,0000,0000,,لم تكن جادة وأرادت سرقتك منّي وحسب
Dialogue: 0,0:21:09.35,0:21:10.51,Default,,0000,0000,0000,,...هيتومي
Dialogue: 0,0:21:17.88,0:21:20.59,Default,,0000,0000,0000,,!عملٌ موفق يا هي-سان
Dialogue: 0,0:21:21.01,0:21:24.71,Default,,0000,0000,0000,,سمعتُ الشائعات، لكن لا عجب أن\N"تحليل كوغورو النائم"
Dialogue: 0,0:21:24.71,0:21:28.55,Default,,0000,0000,0000,,!مصدره أستاذ موري كوغورو-سان
Dialogue: 0,0:21:31.99,0:21:34.46,Default,,0000,0000,0000,,!كان موري من قلّدني
Dialogue: 0,0:21:35.61,0:21:39.08,Default,,0000,0000,0000,,!وأنت مطابق له في حبّ الادّعاء
Dialogue: 0,0:23:05.52,0:23:08.35,Default,,0000,0000,0000,,تماسك يا أبي، أأنت بخير؟
Dialogue: 0,0:23:09.33,0:23:10.42,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:23:10.42,0:23:11.81,Default,,0000,0000,0000,,!ما-ما هذا؟
Dialogue: 0,0:23:11.67,0:23:16.21,On Top,,0000,0000,0000,,وكالة شيوتا هيهاتشيرو للتحرّي
Dialogue: 0,0:23:16.31,0:23:18.14,Default,,0000,0000,0000,,!ما معنى هذا يا هي-سان؟
Dialogue: 0,0:23:19.86,0:23:21.41,Default,,0000,0000,0000,,كما ترى
Dialogue: 0,0:23:21.41,0:23:25.82,Default,,0000,0000,0000,,.لا تزال غير مؤهل، لذا سأعتني بك لفترة
Dialogue: 0,0:23:25.82,0:23:28.14,Default,,0000,0000,0000,,لا تقلق
Dialogue: 0,0:23:29.52,0:23:30.48,Default,,0000,0000,0000,,!أيّها الجدّ
Dialogue: 0,0:23:31.06,0:23:32.18,Default,,0000,0000,0000,,!عزيزتي
Dialogue: 0,0:23:32.89,0:23:36.97,Default,,0000,0000,0000,,قلتَ أنك ستذهب لطوكيو للسياحة، لكنّك لم ترجع
Dialogue: 0,0:23:36.97,0:23:38.65,Default,,0000,0000,0000,,خنتني مُجدداً، أليس كذلك؟
Dialogue: 0,0:23:39.30,0:23:40.10,Default,,0000,0000,0000,,خيانة؟
Dialogue: 0,0:23:40.10,0:23:45.35,Default,,0000,0000,0000,,!كلا، صدّقيني! أنت الوحيدة التي أحبّها
Dialogue: 0,0:23:45.75,0:23:48.58,Default,,0000,0000,0000,,!أتساءل عن صحّة ذلك، تعال معي
Dialogue: 0,0:23:49.23,0:23:50.54,Default,,0000,0000,0000,,!هيّا
Dialogue: 0,0:23:53.45,0:23:58.17,Default,,0000,0000,0000,,عبثه مع النساء مشتقّ من معلّمه أيضاً إذاً
Dialogue: 0,0:24:00.35,0:24:04.84,Default,,0000,0000,0000,,لم يكشف أبي هويّة بارون الليل بعد
Dialogue: 0,0:24:04.84,0:24:08.80,Default,,0000,0000,0000,,...لكن من يستعمل اسمه موجود هنا
Dialogue: 0,0:24:09.17,0:24:11.01,Default,,0000,0000,0000,,أبي مُتحرٍّ
Dialogue: 0,0:24:14.16,0:24:16.21,Default,,0000,0000,0000,,يبدو أنّ أبي مشهور
Dialogue: 0,0:24:17.75,0:24:18.75,Default,,0000,0000,0000,,!بارون الليل
Dialogue: 0,0:24:24.21,0:24:30.05,On Top,,0000,0000,0000,,(جريمة قتل بارون الليل (جزء القضيّة
Dialogue: 0,0:24:24.90,0:24:26.19,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.19,0:24:29.45,Default,,0000,0000,0000,,(جريمة قتل بارون الليل (جزء القضيّة
Dialogue: 0,0:24:45.67,0:24:47.84,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:47.84,0:24:49.66,Default,,0000,0000,0000,,فيروس حاسوب
Dialogue: 0,0:24:50.38,0:24:52.36,Default,,0000,0000,0000,,!الحلقة القادمة بمعيار كبير أخيراً
Dialogue: 0,0:24:52.36,0:24:54.04,Default,,0000,0000,0000,,ماذا؟ أنقليس بمعيار كبير؟
Dialogue: 0,0:24:54.04,0:24:56.04,Default,,0000,0000,0000,,ماذا؟

