Dialogue: 0,0:00:02.04,0:00:04.72,Default,,0000,0000,0000,,تتضاعف القضايا المعقّدة\Nمع مضيّ خط الوقت
Dialogue: 0,0:00:05.40,0:00:07.31,Default,,0000,0000,0000,,!مسرح اليوم ساحة تمرين غولف
Dialogue: 0,0:00:07.31,0:00:09.60,Default,,0000,0000,0000,,!تسديدة متقنة مليئة بالتعطّش للدماء
Dialogue: 0,0:00:09.60,0:00:11.53,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.53,0:00:13.68,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:13.68,0:00:15.93,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:47.36,0:01:50.35,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل ساحة تمرين الغولف
Dialogue: 0,0:01:47.36,0:01:50.35,Default,,0000,0000,0000,,جريمة قتل ساحة تمرين الغولف
Dialogue: 0,0:01:52.44,0:01:54.68,On Top,,0000,0000,0000,,حديقة بيكا للغولف
Dialogue: 0,0:02:03.80,0:02:05.31,Default,,0000,0000,0000,,!ها هي
Dialogue: 0,0:02:10.26,0:02:14.00,Default,,0000,0000,0000,,...لا أرى الغولف تصلح له
Dialogue: 0,0:02:14.00,0:02:18.62,Default,,0000,0000,0000,,قال أنّه لا يجيد\Nأيّ رياضة بها أدوات
Dialogue: 0,0:02:18.62,0:02:21.60,Default,,0000,0000,0000,,كان عليه الرفض إذاً
Dialogue: 0,0:02:22.04,0:02:24.55,Default,,0000,0000,0000,,سبب بدء العمّ للغولف
Dialogue: 0,0:02:24.55,0:02:28.48,Default,,0000,0000,0000,,هو اتّصال أتاه من تلفاز نيتشيوري قبل 3 أيام
Dialogue: 0,0:02:28.99,0:02:32.66,Default,,0000,0000,0000,,ماذا؟ مسابقة غولف خيرية للهواة والمحترفين؟
Dialogue: 0,0:02:32.66,0:02:36.23,Default,,0000,0000,0000,,...آسف، لكنّ الغولف بالنسبة لي
Dialogue: 0,0:02:36.23,0:02:39.15,Default,,0000,0000,0000,,!ماذا؟! أوصت بي أوكينو يوكو؟
Dialogue: 0,0:02:39.15,0:02:41.31,Default,,0000,0000,0000,,!ستشارك يوكو-تشان؟
Dialogue: 0,0:02:41.72,0:02:44.30,Default,,0000,0000,0000,,،سأشارك! قد لا يبدو عليّ
Dialogue: 0,0:02:44.30,0:02:46.94,Default,,0000,0000,0000,,!لكنّي أستاذ في الغولف
Dialogue: 0,0:02:49.39,0:02:51.14,Default,,0000,0000,0000,,...مع ذلك
Dialogue: 0,0:02:53.92,0:02:56.79,Default,,0000,0000,0000,,ولو كان التمرين الصباحي أرخص
Dialogue: 0,0:02:56.79,0:02:58.83,Default,,0000,0000,0000,,لا تزال 6:30 مبكّراً جدّاً
Dialogue: 0,0:02:58.83,0:03:00.74,Default,,0000,0000,0000,,وتحديداً مع جلبك لنا
Dialogue: 0,0:03:04.50,0:03:07.51,CharCard,,0000,0000,0005,,{\fad(00,0)}(تاتشيبانا إيسوكي (56 \Nالرئيس العام لقسم تطوير المنتجات لإيتسوي للالكترونيات
Dialogue: 0,0:03:04.93,0:03:07.51,On Top,,0000,0000,0000,,حسناً، لنتمرّن حتى التعرُّق مُجدداً اليوم
Dialogue: 0,0:03:08.62,0:03:11.60,On Top,,0000,0000,0000,,إنّه تمرين بدنيّ ممتاز قبل العمل
Dialogue: 0,0:03:08.62,0:03:11.60,CharCard,,0000,0000,0005,,{\fad(300,0)}(ياسوي مينورو (44\Nمدير قسم تطوير المنتجات لإيتسوي للالكترونيات
Dialogue: 0,0:03:11.60,0:03:15.56,On Top,,0000,0000,0000,,تحسّنت صحتي كثيراً بفضلك سيّدي الرئيس
Dialogue: 0,0:03:11.69,0:03:15.56,CharCard,,0000,0000,0005,,{\fad(300,0)}(أوكبو تاتسويا (35\Nمسؤول قسم تطوير المنتجات لإيتسوي للالكترونيات
Dialogue: 0,0:03:15.64,0:03:18.52,CharCard,,0000,0000,0005,,{\fad(00,0)}(مينامي توموفومي (28\Nموظف في قسم تطوير المنتجات لإيتسوي للالكترونيات
Dialogue: 0,0:03:15.67,0:03:18.52,On Top,,0000,0000,0000,,!حقّاً؟ لا عجب
Dialogue: 0,0:03:21.14,0:03:22.52,On Top,,0000,0000,0000,,محجوز
Dialogue: 0,0:03:30.43,0:03:33.54,Default,,0000,0000,0000,,ماذا؟ معدتك توجعك؟ يا لك من مُفسد للتسلية
Dialogue: 0,0:03:33.54,0:03:35.41,Default,,0000,0000,0000,,!اذهب للحمام وحسب
Dialogue: 0,0:03:52.35,0:03:54.57,Default,,0000,0000,0000,,!الرمية الثالثة، خرجت
Dialogue: 0,0:03:54.57,0:03:57.27,Default,,0000,0000,0000,,متى ستصل واحدة للسور؟
Dialogue: 0,0:04:05.64,0:04:07.96,Default,,0000,0000,0000,,سأذهب لمشاهدة الآخرين
Dialogue: 0,0:04:08.04,0:04:09.05,Default,,0000,0000,0000,,لا تضايقهم
Dialogue: 0,0:04:09.05,0:04:09.83,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:04:14.14,0:04:15.71,Default,,0000,0000,0000,,سيّدي الرئيس، هاك
Dialogue: 0,0:04:15.71,0:04:17.14,Default,,0000,0000,0000,,شكراً
Dialogue: 0,0:04:17.14,0:04:19.14,Default,,0000,0000,0000,,يا للمُتملق
Dialogue: 0,0:04:20.00,0:04:22.60,Default,,0000,0000,0000,,يجدر بك الابتعاد يا فتى، فالمكان خطر
Dialogue: 0,0:04:23.00,0:04:25.56,Default,,0000,0000,0000,,هذه مسافة آمنة، أليس كذلك؟
Dialogue: 0,0:04:26.29,0:04:27.31,Default,,0000,0000,0000,,اسمع
Dialogue: 0,0:04:27.91,0:04:31.73,Default,,0000,0000,0000,,لا تنس كتابة إصلاح مضرب الرئيس كتكاليف للقسم
Dialogue: 0,0:04:31.73,0:04:33.43,Default,,0000,0000,0000,,حاضر، فهمت
Dialogue: 0,0:04:46.14,0:04:48.85,Default,,0000,0000,0000,,رأيت؟ أخبرتك أنّ المكان خطر
Dialogue: 0,0:04:48.85,0:04:51.10,Default,,0000,0000,0000,,معك حق
Dialogue: 0,0:05:10.83,0:05:12.48,Default,,0000,0000,0000,,!ضربة جميلة
Dialogue: 0,0:05:12.70,0:05:15.32,Default,,0000,0000,0000,,!طارت بعيداً
Dialogue: 0,0:05:15.32,0:05:19.81,Default,,0000,0000,0000,,نعرف الآن من سيكون الفائز\N!في مسابقة وداع الأحد
Dialogue: 0,0:05:28.81,0:05:31.60,Default,,0000,0000,0000,,انتهى ذاك الرجل بالفعل؟
Dialogue: 0,0:05:31.60,0:05:35.47,Default,,0000,0000,0000,,...سدّد بسرعة عالية
Dialogue: 0,0:05:35.47,0:05:39.27,Default,,0000,0000,0000,,كما أنّه أعطى مجموعة من كراته للرئيس
Dialogue: 0,0:05:40.09,0:05:42.81,Default,,0000,0000,0000,,يا للتملّق الواضح
Dialogue: 0,0:05:52.87,0:05:55.05,Default,,0000,0000,0000,,!تسديدة جميلة
Dialogue: 0,0:05:56.95,0:05:58.41,Default,,0000,0000,0000,,هاك مضربك الطويل
Dialogue: 0,0:06:14.66,0:06:16.43,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:06:16.43,0:06:17.85,Default,,0000,0000,0000,,!هيّا
Dialogue: 0,0:06:18.26,0:06:19.92,Default,,0000,0000,0000,,إخفاق آخر؟
Dialogue: 0,0:06:19.92,0:06:21.70,Default,,0000,0000,0000,,أجل، عشرون توالياً
Dialogue: 0,0:06:40.03,0:06:40.77,Default,,0000,0000,0000,,!ماذا حصل؟
Dialogue: 0,0:06:43.60,0:06:44.42,Default,,0000,0000,0000,,!سيّدي الرئيس
Dialogue: 0,0:06:44.42,0:06:46.45,Default,,0000,0000,0000,,!كلا! لا تلمسه
Dialogue: 0,0:06:49.48,0:06:50.64,Default,,0000,0000,0000,,إنّه ميت
Dialogue: 0,0:06:51.06,0:06:53.47,Default,,0000,0000,0000,,!ران! اتّصلي بالمفتش ميغوري
Dialogue: 0,0:06:53.47,0:06:54.75,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:06:54.75,0:06:56.93,Default,,0000,0000,0000,,!ما الذي حصل؟
Dialogue: 0,0:06:56.93,0:06:59.89,Default,,0000,0000,0000,,كانت قنبلة انفجرت غالباً
Dialogue: 0,0:06:59.89,0:07:00.99,Default,,0000,0000,0000,,قنبلة؟
Dialogue: 0,0:07:04.60,0:07:08.18,Default,,0000,0000,0000,,!هذه الرائحة الحادة الفريدة... بارود
Dialogue: 0,0:07:10.79,0:07:12.04,Default,,0000,0000,0000,,!سيّدي
Dialogue: 0,0:07:12.04,0:07:13.20,Default,,0000,0000,0000,,!اتّصلوا بالإسعاف
Dialogue: 0,0:07:13.20,0:07:16.20,Default,,0000,0000,0000,,!كلا، توجد مشفى بالقرب
Dialogue: 0,0:07:16.20,0:07:18.22,Default,,0000,0000,0000,,ماذا؟ أنت مصاب بدورك
Dialogue: 0,0:07:18.57,0:07:21.56,Default,,0000,0000,0000,,!أنا بخير! علينا أخذه للمشفى فوراً
Dialogue: 0,0:07:21.56,0:07:22.35,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:07:31.77,0:07:36.01,Default,,0000,0000,0000,,الميت هو الرئيس العام في إيتسوي للالكترونيات، تاتشيبانا
Dialogue: 0,0:07:36.01,0:07:37.47,Default,,0000,0000,0000,,ومن أنتم؟
Dialogue: 0,0:07:37.47,0:07:40.51,Default,,0000,0000,0000,,أنا مدير القسم، ياسوي
Dialogue: 0,0:07:40.51,0:07:43.04,Default,,0000,0000,0000,,وهذان أوكوبو ومينامي
Dialogue: 0,0:07:43.04,0:07:47.93,Default,,0000,0000,0000,,نعمل جميعاً في قسم تطوير المنتجات\Nتحت الرئيس تاتشيبانا
Dialogue: 0,0:07:47.93,0:07:50.35,Default,,0000,0000,0000,,أترتادون هذا المكان؟
Dialogue: 0,0:07:50.35,0:07:53.83,Default,,0000,0000,0000,,أجل، فهو قريب من الشركة
Dialogue: 0,0:07:53.83,0:07:56.35,Default,,0000,0000,0000,,لكن كان اليوم آخر يوم للرئيس
Dialogue: 0,0:07:56.35,0:07:57.52,Default,,0000,0000,0000,,آخر يوم؟
Dialogue: 0,0:07:58.09,0:08:03.09,Default,,0000,0000,0000,,كان سيُرقّى ليصبح رئيس فرع نيويورك\Nمن الأسبوع المقبل
Dialogue: 0,0:08:04.02,0:08:08.94,Default,,0000,0000,0000,,سيّدي المفتش، يبدو أنّ باروداً قد اُستعمل
Dialogue: 0,0:08:08.94,0:08:11.69,Default,,0000,0000,0000,,وتعال هناك من فضلك
Dialogue: 0,0:08:13.35,0:08:16.47,Default,,0000,0000,0000,,هذه قطعة من رأس المضرب الطويل
Dialogue: 0,0:08:16.47,0:08:20.60,Default,,0000,0000,0000,,...وهذه بقايا من الكرة
Dialogue: 0,0:08:21.01,0:08:22.52,Default,,0000,0000,0000,,لكن انظر لهذا
Dialogue: 0,0:08:23.13,0:08:24.51,Default,,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:08:24.92,0:08:26.80,Default,,0000,0000,0000,,يبدو أنّه فتيل
Dialogue: 0,0:08:26.80,0:08:27.72,Default,,0000,0000,0000,,...أي
Dialogue: 0,0:08:28.13,0:08:31.63,Default,,0000,0000,0000,,كانت القنبلة داخل الكرة
Dialogue: 0,0:08:31.63,0:08:36.81,Default,,0000,0000,0000,,وضُبطت على الانفجار عندما يضربها
Dialogue: 0,0:08:36.81,0:08:37.97,Default,,0000,0000,0000,,تماماً
Dialogue: 0,0:08:42.98,0:08:47.32,Default,,0000,0000,0000,,أيّها المدير، هل تحمل كلّ الكرات هنا خطوط حمراء؟
Dialogue: 0,0:08:47.32,0:08:49.28,Default,,0000,0000,0000,,كلّا، بل زرقاء
Dialogue: 0,0:08:49.28,0:08:50.10,Default,,0000,0000,0000,,خطوط زرقاء؟
Dialogue: 0,0:08:52.23,0:08:53.55,Default,,0000,0000,0000,,يوجد بعضها هناك
Dialogue: 0,0:08:53.93,0:08:58.56,Default,,0000,0000,0000,,.فهمت، بها خطوط زرقاء بالفعل\Nخطّ واحد لكل كرة
Dialogue: 0,0:08:58.56,0:09:04.35,Default,,0000,0000,0000,,ما يعني أنّ الخطّين المتقاطعين الأحمرين\Nكانا علامة على الكرة المفخخة
Dialogue: 0,0:09:05.80,0:09:10.17,Default,,0000,0000,0000,,السؤال هو إن كانت هذه الجريمة\N،تستهدف الرئيس تاتشيبانا
Dialogue: 0,0:09:10.17,0:09:12.81,Default,,0000,0000,0000,,...أو كانت جريمة إرهاب عشوائية
Dialogue: 0,0:09:12.81,0:09:16.22,Default,,0000,0000,0000,,أظنّها كانت تستهدفه بالتحديد
Dialogue: 0,0:09:16.22,0:09:18.68,Default,,0000,0000,0000,,لمَ تعتقد ذلك؟
Dialogue: 0,0:09:19.08,0:09:27.18,Default,,0000,0000,0000,,لأنّنا الثلاثة هنا كنا نكرهه\Nبما يكفي لقتله
Dialogue: 0,0:09:27.40,0:09:28.60,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:09:29.07,0:09:30.90,Default,,0000,0000,0000,,!ما الذي تقوله يا مينامي؟
Dialogue: 0,0:09:30.90,0:09:32.57,Default,,0000,0000,0000,,معه حق
Dialogue: 0,0:09:32.87,0:09:35.94,Default,,0000,0000,0000,,كان لدينا نحن الاثنان دافع كافٍ لقتله
Dialogue: 0,0:09:36.23,0:09:41.65,Default,,0000,0000,0000,,فقد نسب لنفسه 3 من أفكار\Nالمنتجات التي ابتكرتُها أنا
Dialogue: 0,0:09:41.65,0:09:47.90,Default,,0000,0000,0000,,وكان يتجاهلك دوماً مهما\Nاقترحت من أفكار جيّدة
Dialogue: 0,0:09:47.90,0:09:51.22,Default,,0000,0000,0000,,!ليس أنا! لم تكن لديّ أي مشكلة مع الرئيس
Dialogue: 0,0:09:51.22,0:09:53.84,Default,,0000,0000,0000,,دعك من الكذب يا مدير ياسوي
Dialogue: 0,0:09:53.84,0:09:58.86,Default,,0000,0000,0000,,!نعرف جميعاً أنّه سرق حبيبتك في الماضي
Dialogue: 0,0:09:59.17,0:10:03.66,Default,,0000,0000,0000,,!كلا! لم يسرقها، بل هجرتني فحسب
Dialogue: 0,0:10:03.66,0:10:08.78,Default,,0000,0000,0000,,وجدتُها! عرفت هويّة قاتل\N!الرئيس تاتشيبانا حضرة المفتّش
Dialogue: 0,0:10:08.78,0:10:10.74,Default,,0000,0000,0000,,حقّاً يا موري-كن؟
Dialogue: 0,0:10:10.74,0:10:14.11,Default,,0000,0000,0000,,...أجل، بالنسبة لتفصيل الجريمة أوّلاً
Dialogue: 0,0:10:14.11,0:10:19.40,Default,,0000,0000,0000,,خلط القاتل الكرة المفخخة مع بقيّة الكرات في الآلة
Dialogue: 0,0:10:19.40,0:10:21.40,Default,,0000,0000,0000,,كي يضربها الضحيّة
Dialogue: 0,0:10:22.74,0:10:25.14,Default,,0000,0000,0000,,،يكون السؤال هنا
Dialogue: 0,0:10:25.14,0:10:30.57,Default,,0000,0000,0000,,من جلب الكرات من الآلة للرئيس تاتشيبانا؟
Dialogue: 0,0:10:30.57,0:10:33.31,Default,,0000,0000,0000,,كان هذا الرجل أوكوبو
Dialogue: 0,0:10:39.88,0:10:43.41,Default,,0000,0000,0000,,في تلك الأثناء، كان مينامي-سان في دورة المياه
Dialogue: 0,0:10:43.41,0:10:46.33,Default,,0000,0000,0000,,وياسوي عند آلته الخاصة
Dialogue: 0,0:10:46.33,0:10:48.52,Default,,0000,0000,0000,,!كان أنت إذاً
Dialogue: 0,0:10:48.75,0:10:51.29,Default,,0000,0000,0000,,الفتى محق، لم ألمس ولا مينامي
Dialogue: 0,0:10:51.29,0:10:53.90,Default,,0000,0000,0000,,!سلّة الرئيس أبداً
Dialogue: 0,0:10:53.90,0:10:57.98,Default,,0000,0000,0000,,!لا يمكن لأحد وضع الكرة المفخخة سواك
Dialogue: 0,0:10:57.98,0:11:01.44,Default,,0000,0000,0000,,لكن ليس بالضرورة أن يكون هذا ما حدث
Dialogue: 0,0:11:01.70,0:11:03.77,Default,,0000,0000,0000,,لا شكّ أنّ مينامي-سان
Dialogue: 0,0:11:03.77,0:11:07.19,Default,,0000,0000,0000,,كان بعيداً عن الضحيّة
Dialogue: 0,0:11:07.19,0:11:10.39,Default,,0000,0000,0000,,لكنّ الأمر لا ينطبق عليك يا ياسوي-سان
Dialogue: 0,0:11:10.39,0:11:14.60,Default,,0000,0000,0000,,فقد سمعتُ أنّك شاركت\Nبعضاً من كراتك مع الضحيّة
Dialogue: 0,0:11:17.34,0:11:18.94,Default,,0000,0000,0000,,...كـ-كان ذلك
Dialogue: 0,0:11:18.94,0:11:19.93,Default,,0000,0000,0000,,أي كان بإمكانك
Dialogue: 0,0:11:19.93,0:11:24.48,Default,,0000,0000,0000,,وضع الكرة المفخخة هناك
Dialogue: 0,0:11:24.48,0:11:29.75,Default,,0000,0000,0000,,،ا-انتظر! لو وضعتُها حقّاً
Dialogue: 0,0:11:29.75,0:11:34.85,Default,,0000,0000,0000,,!كان يمكن أن أموت في الانفجار بدوري
Dialogue: 0,0:11:35.07,0:11:37.32,Default,,0000,0000,0000,,بتلك الآلة نظام جدولة
Dialogue: 0,0:11:37.57,0:11:41.65,Default,,0000,0000,0000,,آخر كُرات تُوضع هي آخر كُرات تخرج
Dialogue: 0,0:11:42.32,0:11:47.11,Default,,0000,0000,0000,,وأنهيتَ الضرب قبل تاتشيبانا-سان
Dialogue: 0,0:11:47.11,0:11:51.06,Default,,0000,0000,0000,,أيمكن أنّك تعمّدت الإسراع
Dialogue: 0,0:11:51.06,0:11:53.48,Default,,0000,0000,0000,,كي تنتهي قبل أن يضرب الكرة المفخخة؟
Dialogue: 0,0:11:53.48,0:11:57.55,Default,,0000,0000,0000,,!كلا! من عادتي أن أضرب سريعاً وحسب
Dialogue: 0,0:11:57.55,0:12:00.44,Default,,0000,0000,0000,,أليس صحيحاً يا أوكوبو؟ مينامي؟
Dialogue: 0,0:12:02.39,0:12:04.21,Default,,0000,0000,0000,,...أمرٌ إضافي
Dialogue: 0,0:12:04.21,0:12:07.63,Default,,0000,0000,0000,,أين كنت أثناء الانفجار؟
Dialogue: 0,0:12:07.63,0:12:11.46,Default,,0000,0000,0000,,في تلك المرحلة، يمكن استبعاد أوكوبو-سان\Nمن لائحة المشتبه بهم كذلك
Dialogue: 0,0:12:11.46,0:12:18.73,Default,,0000,0000,0000,,فقد وقع في دائرة الانفجار مع مينامي-سان
Dialogue: 0,0:12:19.07,0:12:23.06,Default,,0000,0000,0000,,لكن أعتقد أنّك كنت عند المدخل
Dialogue: 0,0:12:23.40,0:12:25.02,Default,,0000,0000,0000,,...ذ-ذلك
Dialogue: 0,0:12:25.69,0:12:33.76,Default,,0000,0000,0000,,أيمكن لأنّك رأيت الكرة بالخطّين الأحمرين\Nوابتعدت لحماية نفسك؟
Dialogue: 0,0:12:34.06,0:12:37.28,Default,,0000,0000,0000,,!كلا! ذهبتُ لطلب القهوة
Dialogue: 0,0:12:37.65,0:12:39.08,Default,,0000,0000,0000,,القهوة؟
Dialogue: 0,0:12:39.35,0:12:45.64,Default,,0000,0000,0000,,أجل، كان الرئيس يحبّ شرب القهوة التي تحضّرها \Nالسيّدة هنا بعدما ينتهي من الضرب دوماً
Dialogue: 0,0:12:45.64,0:12:52.54,Default,,0000,0000,0000,,لذا كنتُ أذهب وأطلبها قبل 10 دقائق من انتهائه
Dialogue: 0,0:12:52.83,0:12:54.46,Default,,0000,0000,0000,,إنّها الحقيقة
Dialogue: 0,0:12:54.46,0:12:57.13,Default,,0000,0000,0000,,نحضّر القهوة من الحبوب
Dialogue: 0,0:12:57.13,0:12:59.95,Default,,0000,0000,0000,,لذا كان يطلبها مسبقاً دوماً
Dialogue: 0,0:13:02.67,0:13:12.20,Default,,0000,0000,0000,,لكن عدم وجودك وقت الانفجار\Nيبدو ملائماً لك جدّاً
Dialogue: 0,0:13:12.45,0:13:13.77,Default,,0000,0000,0000,,،أي بمنظورك
Dialogue: 0,0:13:13.77,0:13:15.90,Default,,0000,0000,0000,,كان الفاعل ياسوي-سان؟
Dialogue: 0,0:13:15.90,0:13:17.11,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:13:17.11,0:13:18.78,Default,,0000,0000,0000,,!لا شكّ في الأمر
Dialogue: 0,0:13:18.98,0:13:20.44,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:13:20.44,0:13:22.99,Default,,0000,0000,0000,,!لستُ القاتل! إنّها الحقيقة
Dialogue: 0,0:13:22.99,0:13:27.41,Default,,0000,0000,0000,,هل تسمح لنا بتفقّد أمتعتك\Nللتأكد يا ياسوي-سان؟
Dialogue: 0,0:13:27.68,0:13:30.37,Default,,0000,0000,0000,,...حـ-حسناً، لا أمانع
Dialogue: 0,0:13:32.33,0:13:36.42,Default,,0000,0000,0000,,لا عيب في استنتاج العمّ للآن\Nعلى خلاف العادة
Dialogue: 0,0:13:36.42,0:13:39.28,Default,,0000,0000,0000,,...لكن إذا كان ياسوي-سان القاتل حقّاً
Dialogue: 0,0:13:42.46,0:13:45.57,Default,,0000,0000,0000,,سيّدي المفتش، وجدت هذه في حقيبته
Dialogue: 0,0:13:46.05,0:13:47.11,Default,,0000,0000,0000,,...هذه
Dialogue: 0,0:13:47.58,0:13:49.33,Default,,0000,0000,0000,,!مـ-مستحيل
Dialogue: 0,0:13:49.33,0:13:51.53,Default,,0000,0000,0000,,!هذا دليل دامغ
Dialogue: 0,0:13:51.53,0:13:57.11,Default,,0000,0000,0000,,!كانت لديك كرة احتياطية في حالة فشل الأخرى
Dialogue: 0,0:13:57.11,0:13:59.08,Default,,0000,0000,0000,,!كلا! لم أضع تلك
Dialogue: 0,0:13:59.08,0:14:03.72,Default,,0000,0000,0000,,!كانت قضيّة سهلة بحق
Dialogue: 0,0:14:03.72,0:14:06.89,Default,,0000,0000,0000,,،بالنسبة للمتحرّي العظيم موري كوغورو
Dialogue: 0,0:14:06.89,0:14:10.21,Default,,0000,0000,0000,,!كان هذا أشبه بإفطار خفيف
Dialogue: 0,0:14:12.14,0:14:14.17,Default,,0000,0000,0000,,هذا بسيط جدّاً
Dialogue: 0,0:14:14.17,0:14:18.66,Default,,0000,0000,0000,,لم يهتمّ ياسوي-سان إذا أمسكوا به\Nلقتل الرئيس تاتشيبانا؟
Dialogue: 0,0:14:18.66,0:14:22.61,Default,,0000,0000,0000,,كلا، هناك شيء غاب عنّا
Dialogue: 0,0:14:23.41,0:14:25.57,Default,,0000,0000,0000,,شيء حتّى أنا لم ألحظه
Dialogue: 0,0:14:28.45,0:14:31.16,Default,,0000,0000,0000,,ماذا؟ توجد كرة على المثبّت
Dialogue: 0,0:14:31.16,0:14:34.28,Default,,0000,0000,0000,,يبدو أنّ العمّ أخفق التصويب مُجدداً
Dialogue: 0,0:14:35.53,0:14:36.92,Default,,0000,0000,0000,,...لحظة، سمعت آنذاك
Dialogue: 0,0:14:41.65,0:14:46.61,Default,,0000,0000,0000,,اعتقدت أنّ الكرة التي ضربها العمّ\Nأصابت الحاجز المعدني
Dialogue: 0,0:14:47.39,0:14:49.20,Default,,0000,0000,0000,,...لكنّه لم يضربها
Dialogue: 0,0:14:49.81,0:14:52.12,Default,,0000,0000,0000,,ما كان ذاك الصوت إذاً؟
Dialogue: 0,0:15:03.79,0:15:05.54,Default,,0000,0000,0000,,رائحة متفجرات
Dialogue: 0,0:15:05.54,0:15:09.41,Default,,0000,0000,0000,,ما يعني أنّ هذه كانت الكرة\N،التي ضربها الرئيس تاتشيبانا
Dialogue: 0,0:15:09.41,0:15:14.21,Default,,0000,0000,0000,,والصوت المعدني كان صوت ارتطامها بالحاجز
Dialogue: 0,0:15:14.74,0:15:18.61,Default,,0000,0000,0000,,ما كانت بقايا الكرة المفخخة تلك إذاً؟
Dialogue: 0,0:15:18.61,0:15:19.99,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:15:19.99,0:15:21.87,Default,,0000,0000,0000,,!هذه حيلة وضعها القاتل
Dialogue: 0,0:15:21.87,0:15:24.07,Default,,0000,0000,0000,,!الفاعل الحقيقيّ شخص آخر
Dialogue: 0,0:15:28.43,0:15:30.54,Default,,0000,0000,0000,,يمكننا الكلام في المركز
Dialogue: 0,0:15:30.54,0:15:31.95,Default,,0000,0000,0000,,!كلا، عليّ الإسراع
Dialogue: 0,0:15:35.82,0:15:37.57,Default,,0000,0000,0000,,!حسناً، الطريقة المعتادة
Dialogue: 0,0:15:43.34,0:15:45.79,Default,,0000,0000,0000,,!حضرة المفتّش، صدّقني رجاءً
Dialogue: 0,0:15:45.79,0:15:48.41,Default,,0000,0000,0000,,!لستُ القاتل حقّاً
Dialogue: 0,0:15:48.41,0:15:52.00,Default,,0000,0000,0000,,معه حق، لست القاتل يا ياسوي-سان
Dialogue: 0,0:15:53.16,0:15:54.75,Default,,0000,0000,0000,,أبي؟
Dialogue: 0,0:15:55.06,0:16:00.36,Default,,0000,0000,0000,,افتراض أنّ الانفجار وقع عندما\Nضرب الضحية الكرة المفخّخة
Dialogue: 0,0:16:00.36,0:16:02.70,Default,,0000,0000,0000,,كان خاطئاً من البداية
Dialogue: 0,0:16:02.70,0:16:04.75,Default,,0000,0000,0000,,ما الذي تقوله يا موري-كن؟
Dialogue: 0,0:16:05.10,0:16:08.99,Default,,0000,0000,0000,,!وجدنا قطعةً من الكرة بفتيل بها في مسرح الجريمة
Dialogue: 0,0:16:08.99,0:16:13.75,Default,,0000,0000,0000,,صحيح، وجدنا ذلك بالفعل، لكن انظر لهذا حضرة المفتّش
Dialogue: 0,0:16:13.75,0:16:18.09,Default,,0000,0000,0000,,وجدتُ تلك الكرة قرب عامود معدنيّ عند الشبكة
Dialogue: 0,0:16:18.09,0:16:21.43,Default,,0000,0000,0000,,ليست قويّة، لكن يُفترض أن تشمّ رائحة متفجرات
Dialogue: 0,0:16:21.43,0:16:22.70,Default,,0000,0000,0000,,أجل، معك حق
Dialogue: 0,0:16:23.26,0:16:25.37,Default,,0000,0000,0000,,،عندما انفجرت القنبلة
Dialogue: 0,0:16:25.37,0:16:27.75,Default,,0000,0000,0000,,،لم يضرب تاتشيبانا-سان الكرة الحمراء
Dialogue: 0,0:16:27.75,0:16:32.16,Default,,0000,0000,0000,,بل الكرة بالخطّ الأزرق
Dialogue: 0,0:16:32.50,0:16:34.08,Default,,0000,0000,0000,,!لـ-لحظة
Dialogue: 0,0:16:34.08,0:16:36.03,Default,,0000,0000,0000,,!لا أفهم الذي تقوله
Dialogue: 0,0:16:36.41,0:16:42.03,Default,,0000,0000,0000,,لم يضع القاتل الكرة المفخخة في آلة تاتشيبانا-سان
Dialogue: 0,0:16:42.03,0:16:44.99,Default,,0000,0000,0000,,بل داخل رأس المضرب الطويل مسبقاً
Dialogue: 0,0:16:44.99,0:16:45.91,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:16:46.31,0:16:50.56,Default,,0000,0000,0000,,هنا يظهر مكر القاتل
Dialogue: 0,0:16:50.56,0:16:54.56,Default,,0000,0000,0000,,،إن وقع الانفجار لحظة ضرب تاتشيبانا-سان للكرة
Dialogue: 0,0:16:54.56,0:17:02.24,Default,,0000,0000,0000,,وكانت هناك بقايا، سيعتقد الجميع \Nأنّ الكرة هي ما انفجر
Dialogue: 0,0:17:02.75,0:17:05.54,Default,,0000,0000,0000,,،أجل، بعد الانفجار
Dialogue: 0,0:17:05.54,0:17:07.50,Default,,0000,0000,0000,,وضع القاتل جزءاً حضّره من كرة مفخخة
Dialogue: 0,0:17:07.50,0:17:09.08,Default,,0000,0000,0000,,عندما سنحت له الفرصة
Dialogue: 0,0:17:09.29,0:17:12.00,Default,,0000,0000,0000,,...لـ-لكن، سيعني ذلك أنّ القاتل
Dialogue: 0,0:17:12.54,0:17:19.08,Default,,0000,0000,0000,,ياسوي-سان، أظن أنّك ذكرت شيئاً\Nعن تكاليف إصلاح مضرب الرئيس
Dialogue: 0,0:17:19.49,0:17:24.16,Default,,0000,0000,0000,,أجل، كان بالعصا شقّ فطلبتُ من مينامي إرساله للإصلاح
Dialogue: 0,0:17:25.02,0:17:26.79,Default,,0000,0000,0000,,...مينامي، أنت
Dialogue: 0,0:17:28.19,0:17:29.36,Default,,0000,0000,0000,,مينامي-سان
Dialogue: 0,0:17:29.36,0:17:31.54,Default,,0000,0000,0000,,أين وضعت المضرب للإصلاح؟
Dialogue: 0,0:17:31.86,0:17:33.36,Default,,0000,0000,0000,,لدينا
Dialogue: 0,0:17:33.36,0:17:35.74,Default,,0000,0000,0000,,نقوم بإصلاحات للمضارب أيضاً
Dialogue: 0,0:17:36.05,0:17:38.20,Default,,0000,0000,0000,,وكيف أتممتم التصليح؟
Dialogue: 0,0:17:38.20,0:17:47.16,Default,,0000,0000,0000,,بدّلتُ العصا، رأيت أنّ من الأفضل التبديل\Nلعصا كربونية بما أنّ ذلك الرائج حالياً
Dialogue: 0,0:17:47.60,0:17:52.50,Default,,0000,0000,0000,,تلقّى الرئيس هذا المضرب من الرئيس التنفيذي\Nالحالي قبل 15 عاماً
Dialogue: 0,0:17:52.50,0:17:55.78,Default,,0000,0000,0000,,...لذا كان متعلّقاً به
Dialogue: 0,0:17:55.78,0:17:59.83,Default,,0000,0000,0000,,كان رأسه خشبياً قديم الطراز إذاً؟
Dialogue: 0,0:17:59.83,0:18:02.75,Default,,0000,0000,0000,,أخبرني، متى أعدت المضرب المصلّح لمينامي-سان؟
Dialogue: 0,0:18:02.75,0:18:05.45,Default,,0000,0000,0000,,أعدته قبل ليلتين
Dialogue: 0,0:18:05.98,0:18:07.98,Default,,0000,0000,0000,,!قبل ليلتين؟
Dialogue: 0,0:18:07.98,0:18:10.91,Default,,0000,0000,0000,,!لكنّك أعطيته للرئيس هذا الصباح
Dialogue: 0,0:18:11.36,0:18:18.37,Default,,0000,0000,0000,,ما يعني أنّ المضرب كان بحوزتك\Nليوم كامل وليلة يا مينامي-سان
Dialogue: 0,0:18:20.43,0:18:24.56,Default,,0000,0000,0000,,دعنا نسترجع أفعالك اليوم
Dialogue: 0,0:18:24.56,0:18:26.28,Default,,0000,0000,0000,,...بعد وصولك هنا فوراً
Dialogue: 0,0:18:26.63,0:18:29.96,Default,,0000,0000,0000,,ماذا؟ معدتك توجعك؟ يا لك من مُفسد للتسلية
Dialogue: 0,0:18:29.96,0:18:31.78,Default,,0000,0000,0000,,!اذهب للحمام وحسب
Dialogue: 0,0:18:33.84,0:18:39.70,Default,,0000,0000,0000,,كانت تلك إحدى خطوات خطّته
Dialogue: 0,0:18:39.70,0:18:45.23,Default,,0000,0000,0000,,هل كنت تطلب من مينامي-سان\Nجلب كراتك عادةً
Dialogue: 0,0:18:45.23,0:18:50.58,Default,,0000,0000,0000,,ووضع 10 أو ما يقارب منها في آلة الرئيس تاتشيبانا؟
Dialogue: 0,0:18:50.78,0:18:52.29,Default,,0000,0000,0000,,صـ-صحيح
Dialogue: 0,0:18:52.73,0:18:58.02,Default,,0000,0000,0000,,هذه المرّة، تعمّد التعذر بألم معدته\Nوذهب لدورة المياه
Dialogue: 0,0:18:58.02,0:18:59.91,Default,,0000,0000,0000,,كي ينقل ذاك الدور لك
Dialogue: 0,0:19:01.85,0:19:06.42,Default,,0000,0000,0000,,،كما خطّط لتقليص قائمة المشتبه بهم لتحتويك فحسب
Dialogue: 0,0:19:06.42,0:19:10.46,Default,,0000,0000,0000,,بإبعادك عن مسرح الجريمة لحظة وقوع الانفجار
Dialogue: 0,0:19:10.46,0:19:15.58,Default,,0000,0000,0000,,فعل ذلك بإعطائه المضرب الطويل
Dialogue: 0,0:19:15.58,0:19:21.29,Default,,0000,0000,0000,,بينما غادرتَ لطلب القهوة
Dialogue: 0,0:19:23.00,0:19:24.20,Default,,0000,0000,0000,,،فوق ذلك
Dialogue: 0,0:19:24.20,0:19:27.70,Default,,0000,0000,0000,,،لإزالة الشبهات عنه
Dialogue: 0,0:19:28.07,0:19:34.21,Default,,0000,0000,0000,,وقف بالقرب كي يطاله الانفجار
Dialogue: 0,0:19:34.61,0:19:35.56,Default,,0000,0000,0000,,حضرة المفتّش
Dialogue: 0,0:19:35.56,0:19:38.70,Default,,0000,0000,0000,,فكّر بمكان إصابة مينامي-سان
Dialogue: 0,0:19:38.70,0:19:42.52,Default,,0000,0000,0000,,أُصيب أوكوبو-سان في كامل أرجاء جسده
Dialogue: 0,0:19:42.52,0:19:47.05,Default,,0000,0000,0000,,لكن إصابات مينامي في طرف كوعه الأيسر\Nوساقه اليسرى فحسب
Dialogue: 0,0:19:47.05,0:19:49.10,Default,,0000,0000,0000,,لمَ الجانب الأيسر؟
Dialogue: 0,0:19:49.10,0:19:51.87,Default,,0000,0000,0000,,لمَ الطرف الخارجي وليس الداخلي؟
Dialogue: 0,0:19:51.87,0:19:54.22,Default,,0000,0000,0000,,،هذا لأنّه قبيل وقوع الانفجار
Dialogue: 0,0:19:54.22,0:19:56.87,Default,,0000,0000,0000,,غطّى أعينه سريعاً
Dialogue: 0,0:19:56.87,0:19:59.00,Default,,0000,0000,0000,,بذراعه اليسرى واحتمى وراء عامود
Dialogue: 0,0:20:04.78,0:20:06.03,Default,,0000,0000,0000,,مينامي-سان
Dialogue: 0,0:20:06.49,0:20:11.53,Default,,0000,0000,0000,,كان اليوم آخر فرصة لك لقتل الرئيس تاتشيبانا
Dialogue: 0,0:20:11.53,0:20:14.11,Default,,0000,0000,0000,,بما أنّه كان سينتقل لنيويورك
Dialogue: 0,0:20:14.11,0:20:21.69,Default,,0000,0000,0000,,لكن ألم يكن استعمال المضرب الطويل\Nالذي كان بحوزتك وحدك في اليومين الفائتين
Dialogue: 0,0:20:21.69,0:20:24.90,Default,,0000,0000,0000,,كسلاح جريمة إهمالاً منك؟
Dialogue: 0,0:20:26.72,0:20:30.18,Default,,0000,0000,0000,,لطالما أبغضتُ الرئيس
Dialogue: 0,0:20:30.18,0:20:33.43,Default,,0000,0000,0000,,،الرئيس الذي لم يعترف بموهبتي قطّ
Dialogue: 0,0:20:33.43,0:20:36.87,Default,,0000,0000,0000,,...والمدير ياسوي الذي لم يفعل شيئاً سوى التمّلق له
Dialogue: 0,0:20:38.58,0:20:43.54,Default,,0000,0000,0000,,لذا خطّطتُ لقتل الرئيس\Nوإلقاء التهمة على المدير
Dialogue: 0,0:20:44.17,0:20:49.24,Default,,0000,0000,0000,,ولم تهتم إذا مات شخص آخر في الانفجار؟
Dialogue: 0,0:20:49.66,0:20:53.25,Default,,0000,0000,0000,,...لو كانت ساحة التدريب مكتظة، كان ليعلق أشخاص أكثر
Dialogue: 0,0:20:53.25,0:20:56.20,Default,,0000,0000,0000,,لا علاقة لي
Dialogue: 0,0:21:00.99,0:21:02.85,Default,,0000,0000,0000,,حسناً، لنذهب
Dialogue: 0,0:21:09.80,0:21:12.77,Default,,0000,0000,0000,,أتظنّينه كان صادقاً في ذلك؟
Dialogue: 0,0:21:12.77,0:21:13.71,Default,,0000,0000,0000,,...كونان-كن
Dialogue: 0,0:21:14.14,0:21:15.66,Default,,0000,0000,0000,,...آنذاك
Dialogue: 0,0:21:16.54,0:21:19.12,Default,,0000,0000,0000,,يجدر بك الابتعاد يا فتى، فالمكان خطر
Dialogue: 0,0:21:19.33,0:21:23.58,Default,,0000,0000,0000,,أظنّه قال ذلك وقتها كيلا يطالني الانفجار
Dialogue: 0,0:21:23.58,0:21:25.03,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:21:25.03,0:21:32.03,Default,,0000,0000,0000,,ربما كان شخصاً لطيفاً ضلّ طريقه بشكل ما
Dialogue: 0,0:21:34.66,0:21:35.98,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:21:35.98,0:21:38.32,Default,,0000,0000,0000,,!تأخرنا على المدرسة
Dialogue: 0,0:23:09.39,0:23:11.70,On Top,,0000,0000,0000,,مسابقة الغولف الخيرية للهواة والمحترفين\Nالخاصة بذكرى تلفاز نيتشيوري الأولى
Dialogue: 0,0:23:18.24,0:23:20.33,Default,,0000,0000,0000,,!يوكو-تشان! ضربة جميلة
Dialogue: 0,0:23:21.76,0:23:22.79,Default,,0000,0000,0000,,،في الأحد التالي
Dialogue: 0,0:23:23.01,0:23:25.54,Default,,0000,0000,0000,,شارك العمّ في مسابقة الغولف
Dialogue: 0,0:23:25.54,0:23:29.66,Default,,0000,0000,0000,,بشرط أن يكون في فريق أوكينو يوكو
Dialogue: 0,0:23:30.08,0:23:33.29,Default,,0000,0000,0000,,،كانت يوكو-تشان غير ثابتة قليلاً\Nلكن كانت ضربة ممتازة
Dialogue: 0,0:23:33.29,0:23:36.11,Default,,0000,0000,0000,,!التالي هو دور المتحرّي الشهير، موري كوغورو-سان
Dialogue: 0,0:23:36.78,0:23:39.08,Default,,0000,0000,0000,,!موري-سان! أنت لها
Dialogue: 0,0:23:40.44,0:23:42.04,Default,,0000,0000,0000,,!دعي الأمر لي
Dialogue: 0,0:23:42.65,0:23:44.66,Default,,0000,0000,0000,,هل سيكون أبي بخير؟
Dialogue: 0,0:23:44.66,0:23:45.99,Default,,0000,0000,0000,,مستحيل
Dialogue: 0,0:23:51.73,0:23:53.04,Default,,0000,0000,0000,,...آخ
Dialogue: 0,0:23:55.38,0:23:57.43,Default,,0000,0000,0000,,ارحمنا
Dialogue: 0,0:24:01.27,0:24:03.10,Default,,0000,0000,0000,,تـ-تينغو الضباب؟
Dialogue: 0,0:24:05.10,0:24:08.93,Default,,0000,0000,0000,,يبدو أنّ المجرم هو ذاك الشخص بلا شكّ
Dialogue: 0,0:24:09.56,0:24:11.83,Default,,0000,0000,0000,,الحلقة الخاصة القادمة من كونان
Dialogue: 0,0:24:11.83,0:24:14.66,Default,,0000,0000,0000,,جرائم قتل أسطورة تينغو الضباب
Dialogue: 0,0:24:30.26,0:24:32.46,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:32.46,0:24:34.46,Default,,0000,0000,0000,,بتلة ساكورا
Dialogue: 0,0:24:35.12,0:24:37.45,Default,,0000,0000,0000,,الحلقة القادمة حلقة خاصة كبيرة\N!من 60 دقيقة
Dialogue: 0,0:24:37.45,0:24:39.45,Default,,0000,0000,0000,,تبدأ عند السابعة مساءً

