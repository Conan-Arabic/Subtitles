Dialogue: 0,0:00:00.87,0:00:04.12,Default,,0000,0000,0000,,لقاءات البشر مغلّفة بالغموض، والعالم تلفّه طبقات أكثر حتّى
Dialogue: 0,0:00:04.12,0:00:06.10,Default,,0000,0000,0000,,!أنا مسرورٌ حقّاً لكوني معك
Dialogue: 0,0:00:06.10,0:00:08.11,Default,,0000,0000,0000,,حلقة اليوم عن رابطة أختيّة حزينة
Dialogue: 0,0:00:08.11,0:00:09.77,Default,,0000,0000,0000,,أحللتم لغز الغرفة المغلقة؟
Dialogue: 0,0:00:10.12,0:00:11.57,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:11.57,0:00:13.57,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ دماغه لبالغ
Dialogue: 0,0:00:13.57,0:00:16.03,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:00:16.70,0:00:24.20,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:00:24.20,0:00:31.24,Song,,0000,0000,0000,,{\i1}لطالما كنتُ أشاهدك {\i0}
Dialogue: 0,0:00:32.92,0:00:39.37,Song,,0000,0000,0000,,{\i1} لمَ أنا بهذه السعادة {\i0}
Dialogue: 0,0:00:39.37,0:00:46.87,Song,,0000,0000,0000,,{\i1} مع ذلك يتسلّل إليّ الحزن\Nعندما أنظر إلى الأفق؟{\i0}
Dialogue: 0,0:00:46.87,0:00:59.32,Song,,0000,0000,0000,,{\i1} أشعر كأنّي أنظر لنفسي من ذاك الوقت، عن بعد{\i0}
Dialogue: 0,0:01:00.16,0:01:06.62,Song,,0000,0000,0000,,{\i1}أدير روليت القدر {\i0}
Dialogue: 0,0:01:07.53,0:01:13.42,Song,,0000,0000,0000,,{\i1} الأشياء المتفرّقة التي أفكّر بها ألغاز عالقة{\i0}
Dialogue: 0,0:01:13.42,0:01:19.87,Song,,0000,0000,0000,,{\i1} أترى؟ شخصك المقدّر لك هناك{\i0}
Dialogue: 0,0:01:19.87,0:01:26.81,Song,,0000,0000,0000,,{\i1}يشاهدك دوماً {\i0}
Dialogue: 0,0:01:51.30,0:01:56.17,Default,,0000,0000,0000,,في طريقنا لحفلة أوكينو يوكو، فقد العمّ تذكرته
Dialogue: 0,0:01:56.17,0:01:59.63,Default,,0000,0000,0000,,ثمّ صادف فتاةً تُدعى آوشيما ماسايو
Dialogue: 0,0:01:59.63,0:02:04.01,Default,,0000,0000,0000,,التي وعدت بإعطائه تذكرةً مقابل\Nاصطحابه لشقيقتها الصغيرة
Dialogue: 0,0:02:06.30,0:02:09.97,Default,,0000,0000,0000,,،لكنّ شقيقتها، آوشيما مينا
Dialogue: 0,0:02:09.97,0:02:13.78,Default,,0000,0000,0000,,وُجدت ميتةً في حمّام مغلق
Dialogue: 0,0:02:14.97,0:02:19.07,Default,,0000,0000,0000,,فوق كون الباب والنافذة موصدين\N،من الداخل بشريطٍ لاصق
Dialogue: 0,0:02:19.07,0:02:23.34,Default,,0000,0000,0000,,كُتبت كلمة "وداعاً" بالشريط على زجاج الباب
Dialogue: 0,0:02:24.72,0:02:30.01,Default,,0000,0000,0000,,ولاكتشاف بصمات الشقيقة وحدها\N،على الشريط اللاصق
Dialogue: 0,0:02:30.01,0:02:33.34,Default,,0000,0000,0000,,حكم العمّ والمفتّش ميغوري بأنّه انتحار
Dialogue: 0,0:02:35.13,0:02:38.80,Default,,0000,0000,0000,,!كلا، هذا ليس انتحاراً
Dialogue: 0,0:02:38.80,0:02:42.38,Default,,0000,0000,0000,,!المجرم الذي قتل مينا-سان هي ماسايو-سان
Dialogue: 0,0:02:43.81,0:02:49.85,Title,,0000,0000,15,,{\fad(300,0)}جريمة قتل الحمّام المغلق\N(الجزء الثاني)
Dialogue: 0,0:02:44.13,0:02:47.84,Default,,0000,0000,0000,,جريمة قتل الحمّام المغلق\N(الجزء الثاني)
Dialogue: 0,0:02:51.55,0:02:53.31,Default,,0000,0000,0000,,مفتّش ميغوري
Dialogue: 0,0:02:54.23,0:02:55.11,Default,,0000,0000,0000,,تاكاغي-كن
Dialogue: 0,0:02:55.30,0:02:58.07,Default,,0000,0000,0000,,إذاً، هل تأكّدت من متجر التموينات؟
Dialogue: 0,0:02:58.38,0:02:59.84,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:02:59.84,0:03:01.76,Default,,0000,0000,0000,,،في قرابة الساعة السابعة البارحة
Dialogue: 0,0:03:01.76,0:03:06.95,Default,,0000,0000,0000,,اشترت مطهريّ حوض استحمام وشريطاً\Nلاصقاً وعلبتيّ جعّة وفقما يبدو
Dialogue: 0,0:03:06.95,0:03:08.55,Default,,0000,0000,0000,,علبتيّ جعّة؟
Dialogue: 0,0:03:08.55,0:03:13.76,Default,,0000,0000,0000,,كانت هنالك علبتان فارغتان في المطبخ\Nمع حبوب منوّمة
Dialogue: 0,0:03:13.76,0:03:16.96,Default,,0000,0000,0000,,لعلّها لم تستطع استجماع الجرأة\Nلقتل نفسها بوعيها
Dialogue: 0,0:03:17.30,0:03:20.17,Default,,0000,0000,0000,,إذاً، كيف كان حال مينا-سان\Nعند شرائها لها؟
Dialogue: 0,0:03:20.46,0:03:24.51,Default,,0000,0000,0000,,،أجل، لم يبد عليها شيء بخلاف المعتاد\N...ما بالأمر فقط
Dialogue: 0,0:03:24.51,0:03:26.35,Default,,0000,0000,0000,,ما بالأمر... ماذا؟
Dialogue: 0,0:03:26.63,0:03:29.92,Default,,0000,0000,0000,,ليس شيئاً مهمّاً
Dialogue: 0,0:03:29.92,0:03:35.13,Default,,0000,0000,0000,,!أي أنّه كان انتحاراً بالفعل! انتحار
Dialogue: 0,0:03:35.33,0:03:36.56,Default,,0000,0000,0000,,حضرة الضابط
Dialogue: 0,0:03:37.42,0:03:38.98,Default,,0000,0000,0000,,ما بالأمر؟
Dialogue: 0,0:03:40.00,0:03:45.00,Default,,0000,0000,0000,,في الواقع، قال مالك المتجر شيئاً غريباً
Dialogue: 0,0:03:45.00,0:03:46.61,Default,,0000,0000,0000,,...في نهاية حسابها، مينا-سان
Dialogue: 0,0:03:47.08,0:03:50.00,Default,,0000,0000,0000,,بالمناسبة حضرة المفتّش، ما الساعة الآن؟
Dialogue: 0,0:03:50.00,0:03:51.95,Default,,0000,0000,0000,,الآن؟
Dialogue: 0,0:03:52.17,0:03:55.29,Default,,0000,0000,0000,,رأيت؟ أليس ذلك غريباً؟
Dialogue: 0,0:03:55.29,0:03:59.66,Default,,0000,0000,0000,,لكن كانت الغرفة مقفلة، ويبدو أنّه جُزم\Nبأنّه كان انتحاراً
Dialogue: 0,0:03:59.91,0:04:05.38,Default,,0000,0000,0000,,،أرى أنّ عليك إخبار المفتّش بذلك\N...فلا بدّ أنّه سيثبت أنّه لم
Dialogue: 0,0:04:05.61,0:04:07.17,Default,,0000,0000,0000,,يكن انتحاراً
Dialogue: 0,0:04:10.33,0:04:13.05,Default,,0000,0000,0000,,انظر! ما ذاك؟
Dialogue: 0,0:04:14.17,0:04:15.72,Default,,0000,0000,0000,,ثقب الباب؟
Dialogue: 0,0:04:15.72,0:04:17.69,Default,,0000,0000,0000,,!بل الوسخ الأسود فوقه
Dialogue: 0,0:04:22.17,0:04:23.81,Default,,0000,0000,0000,,!هـ-هذه بقعة دم
Dialogue: 0,0:04:24.12,0:04:25.12,Default,,0000,0000,0000,,بقعة دم؟
Dialogue: 0,0:04:25.12,0:04:26.67,Default,,0000,0000,0000,,أ-أجل
Dialogue: 0,0:04:29.29,0:04:31.74,Default,,0000,0000,0000,,لكن لمَ توجد هنا؟
Dialogue: 0,0:04:32.80,0:04:33.98,Default,,0000,0000,0000,,!مينا
Dialogue: 0,0:04:35.92,0:04:37.17,Default,,0000,0000,0000,,!كـ-كينجي
Dialogue: 0,0:04:37.17,0:04:38.83,Default,,0000,0000,0000,,...أ-أصحيحٌ
Dialogue: 0,0:04:39.04,0:04:41.33,Default,,0000,0000,0000,,!أصحيحٌ أنّ مينا انتحرت؟
Dialogue: 0,0:04:41.33,0:04:42.83,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:04:42.83,0:04:45.63,Default,,0000,0000,0000,,لكن كيف عرفت يا كينجي؟
Dialogue: 0,0:04:47.58,0:04:50.87,Default,,0000,0000,0000,,أخبرناه
Dialogue: 0,0:04:50.87,0:04:56.84,Default,,0000,0000,0000,,فقد ترك رسالةً على آلة الردّ هنا\Nفي وقت الوفاة المقدّر
Dialogue: 0,0:04:57.33,0:05:02.10,Default,,0000,0000,0000,,،فبحثت في دفتر عناوينها\Nوطلبت قدومه إلى هنا
Dialogue: 0,0:05:02.33,0:05:06.83,Default,,0000,0000,0000,,!لمَ؟ لمَ قد تنتحر مينا؟
Dialogue: 0,0:05:06.83,0:05:08.46,Default,,0000,0000,0000,,،لو كنتُ أعرف حصول هذا
Dialogue: 0,0:05:08.46,0:05:11.18,Default,,0000,0000,0000,,!لحطّمت النافذة ودخلت آنذاك
Dialogue: 0,0:05:12.04,0:05:13.90,Default,,0000,0000,0000,,آنذاك؟
Dialogue: 0,0:05:13.90,0:05:16.17,Default,,0000,0000,0000,,هل أتيت هنا البارحة؟
Dialogue: 0,0:05:16.17,0:05:19.87,Default,,0000,0000,0000,,أجل، بعدما تركتُ رسالتي
Dialogue: 0,0:05:19.87,0:05:21.52,Default,,0000,0000,0000,,!صـ-صدقاً؟
Dialogue: 0,0:05:21.52,0:05:22.83,Default,,0000,0000,0000,,أجل، صحيح
Dialogue: 0,0:05:23.50,0:05:27.08,Default,,0000,0000,0000,,لكن لم يجب أحدٌ مهما قرعت الجرس
Dialogue: 0,0:05:27.08,0:05:31.75,Default,,0000,0000,0000,,انتظرت فترةً أمام الباب، لكنّها لم ترجع
Dialogue: 0,0:05:31.75,0:05:34.55,Default,,0000,0000,0000,,فظننتُ أنّها قد نامت، ورحلت
Dialogue: 0,0:05:35.47,0:05:37.95,Default,,0000,0000,0000,,ولذا أُصبت بهذا الزكام
Dialogue: 0,0:05:39.00,0:05:41.52,Default,,0000,0000,0000,,...انتظر، أيمكن أنّ
Dialogue: 0,0:05:42.71,0:05:44.39,Default,,0000,0000,0000,,بقعة الدم تلك؟
Dialogue: 0,0:05:44.39,0:05:49.17,Default,,0000,0000,0000,,لكن أليس من الغريب أن تأتي هنا\Nبعلمك أنّها ليست موجودة؟
Dialogue: 0,0:05:49.17,0:05:52.65,Default,,0000,0000,0000,,اتّفقنا على تناول العشاء معاً
Dialogue: 0,0:05:53.33,0:05:55.87,Default,,0000,0000,0000,,وآلة ردّ مينا تعمل دوماً
Dialogue: 0,0:05:55.87,0:06:00.07,Default,,0000,0000,0000,,ردّها على مكالمتك لا يعني\Nأنّ مينا ليست في البيت
Dialogue: 0,0:06:01.33,0:06:04.17,Default,,0000,0000,0000,,!ذلك جانباً، خذني بسرعة لمينا أيّها الضابط
Dialogue: 0,0:06:04.17,0:06:04.83,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:06:05.21,0:06:07.79,Default,,0000,0000,0000,,!فهمت، هكذا إذاً
Dialogue: 0,0:06:08.50,0:06:11.25,Default,,0000,0000,0000,,!حيلة الغرفة المغلقة بالشريط اللاصق
Dialogue: 0,0:06:11.67,0:06:14.21,Default,,0000,0000,0000,,!بقعة الدم الغامضة على الباب
Dialogue: 0,0:06:14.42,0:06:18.79,Default,,0000,0000,0000,,...والشعور الغريب الذي كان يراودني
Dialogue: 0,0:06:18.79,0:06:22.87,Default,,0000,0000,0000,,فهمتُ كلّ شيء، أرى الصورة بوضوحٍ الآن
Dialogue: 0,0:06:22.87,0:06:25.18,Default,,0000,0000,0000,,...القاتل كان بلا شكّ
Dialogue: 0,0:06:25.55,0:06:29.15,Default,,0000,0000,0000,,!بلا شكّ، هي! ماسايو-سان
Dialogue: 0,0:06:29.83,0:06:36.21,Default,,0000,0000,0000,,أحضرتنا إلى هنا لإكمال جريمة\N!قتل الغرفة المغلقة هذه
Dialogue: 0,0:06:36.21,0:06:40.91,Default,,0000,0000,0000,,!في جهلها أنّها تحمل الدليل القاطع معها
Dialogue: 0,0:06:41.33,0:06:45.87,Default,,0000,0000,0000,,!انتحار، انتحار! كان انتحاراً بوضوح حضرة المفتّش
Dialogue: 0,0:06:47.33,0:06:51.21,Default,,0000,0000,0000,,باب ونافذة هذا الحمام كانا موصدين بشريط لاصق
Dialogue: 0,0:06:51.21,0:06:54.84,Default,,0000,0000,0000,,من الداخل، مما جعله غرفةً مغلقة بالكامل
Dialogue: 0,0:06:55.96,0:07:00.08,Default,,0000,0000,0000,,وبناءً على الشريط على زجاج الباب\N...المُفترض بأنّه وصيّتها
Dialogue: 0,0:07:00.08,0:07:03.76,Default,,0000,0000,0000,,...ووجود بصماتها وحدها عليه
Dialogue: 0,0:07:04.50,0:07:09.96,Default,,0000,0000,0000,,فلا يمكننا التفكير بغير أنّها\Nقطعت معصمها هنا وانتحرت
Dialogue: 0,0:07:09.96,0:07:11.73,Default,,0000,0000,0000,,...موري-سان، أنا
Dialogue: 0,0:07:14.92,0:07:15.87,Default,,0000,0000,0000,,ماسايو-سان
Dialogue: 0,0:07:15.87,0:07:16.69,Default,,0000,0000,0000,,هاك
Dialogue: 0,0:07:17.17,0:07:20.32,Default,,0000,0000,0000,,هذه التذكرة لحفلة الليلة \Nالتي وعدتك بها
Dialogue: 0,0:07:23.41,0:07:25.74,Default,,0000,0000,0000,,!أعتذر على طلبها في وقتٍ كهذا
Dialogue: 0,0:07:27.42,0:07:29.71,Default,,0000,0000,0000,,إذاً حضرة المفتّش، سأنصرف الآن
Dialogue: 0,0:07:29.88,0:07:32.96,Default,,0000,0000,0000,,!انتظر، موري-كن! لم نستجوبك بعد
Dialogue: 0,0:07:33.18,0:07:38.76,Default,,0000,0000,0000,,!لا تقلق! سأمرّ بمركز الشرطة بعد انتهاء الحفلة
Dialogue: 0,0:07:44.96,0:07:46.64,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:07:56.52,0:07:57.47,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:07:57.47,0:07:58.40,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:07:59.00,0:08:01.87,Default,,0000,0000,0000,,أيمكن أنّها أتت مجدداً؟
Dialogue: 0,0:08:01.87,0:08:03.61,Default,,0000,0000,0000,,أتت؟ ما هي؟
Dialogue: 0,0:08:03.94,0:08:08.54,Default,,0000,0000,0000,,لمع لي نورٌ للتوّ، وحللت كلّ شيء
Dialogue: 0,0:08:08.54,0:08:12.58,Default,,0000,0000,0000,,بما في ذلك حيلة القاتل\N!لإغلاق هذا الحمّام
Dialogue: 0,0:08:21.54,0:08:25.76,Default,,0000,0000,0000,,!القاتل؟ كنتَ تقول أنّه انتحار لتوّك
Dialogue: 0,0:08:25.88,0:08:32.18,Default,,0000,0000,0000,,فلتنسوا كلّ ما قلتُه قبلاً من فضلكم، فقد كان مزحة
Dialogue: 0,0:08:34.21,0:08:35.19,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:08:35.83,0:08:38.27,Default,,0000,0000,0000,,لم تقدم مينا-سان على الانتحار
Dialogue: 0,0:08:39.08,0:08:40.61,Default,,0000,0000,0000,,بل قُتلت
Dialogue: 0,0:08:43.50,0:08:49.45,Default,,0000,0000,0000,,!بأيدي أختها، أنت يا ماسايو-سان
Dialogue: 0,0:08:51.58,0:08:53.33,Default,,0000,0000,0000,,ماسايو-سان؟
Dialogue: 0,0:08:53.33,0:08:57.84,Default,,0000,0000,0000,,!مـ-مهلك، أهذا صحيحٌ يا ماسايو؟
Dialogue: 0,0:08:58.17,0:09:03.55,Default,,0000,0000,0000,,!لا-لا تقل كلاماً سخيفاً\Nكيف لي أن أقتل أختي؟
Dialogue: 0,0:09:04.17,0:09:07.96,Default,,0000,0000,0000,,كما يُفترض أنّك تعرف أكثر من غيرك
Dialogue: 0,0:09:07.96,0:09:12.73,Default,,0000,0000,0000,,بأنّ هذا الحمام كان مغلقاً عندما\Nكان علينا فتح الباب عنوة
Dialogue: 0,0:09:12.73,0:09:14.69,Default,,0000,0000,0000,,إنّها محقّة يا موري-كن
Dialogue: 0,0:09:14.69,0:09:18.83,Default,,0000,0000,0000,,إذا كنت تدّعي أنّ ماسايو-سان هي القاتلة، فلتخبرنا
Dialogue: 0,0:09:18.83,0:09:23.40,Default,,0000,0000,0000,,ما هي حيلتها الإعجازيّة التي استعملتها\Nلمغادرة الغرفة المغلقة بالشريط اللاصق؟
Dialogue: 0,0:09:23.56,0:09:25.32,Default,,0000,0000,0000,,الإعجازيّة؟
Dialogue: 0,0:09:26.25,0:09:29.12,Default,,0000,0000,0000,,لم تكن شيئاً بذاك الإعجاز
Dialogue: 0,0:09:30.45,0:09:34.41,Default,,0000,0000,0000,,إنّها طريقة بسيطة يمكن لأيّ أحد تنفيذها
Dialogue: 0,0:09:34.60,0:09:39.38,Default,,0000,0000,0000,,إذاً حضرة المفتّش، فلتبدأ بإغلاق باب\Nالحمّام من فضلك
Dialogue: 0,0:09:42.46,0:09:43.42,Default,,0000,0000,0000,,هكذا؟
Dialogue: 0,0:09:44.07,0:09:46.70,Default,,0000,0000,0000,,كيف يبدو الباب لك؟
Dialogue: 0,0:09:47.98,0:09:49.50,Default,,0000,0000,0000,,كـ-كيف؟
Dialogue: 0,0:09:54.03,0:09:56.26,Default,,0000,0000,0000,,أ-أيمكن، أتقصد؟
Dialogue: 0,0:09:56.26,0:09:57.74,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:09:57.91,0:10:00.22,Default,,0000,0000,0000,,الشريط الملصق على الداخل موضوعٌ على الزجاج
Dialogue: 0,0:10:00.74,0:10:07.31,Default,,0000,0000,0000,,بحيث يبدو أنّ الباب قد أُغلق من الداخل
Dialogue: 0,0:10:07.52,0:10:11.98,Default,,0000,0000,0000,,استغلّت ماسايو-سان ذاك الوهم
Dialogue: 0,0:10:12.22,0:10:14.37,Default,,0000,0000,0000,,مجرّد عمل آلة الردّ
Dialogue: 0,0:10:14.48,0:10:16.37,Default,,0000,0000,0000,,لا تقتضي أنّك غير موجود بالمنزل
Dialogue: 0,0:10:16.37,0:10:18.49,Default,,0000,0000,0000,,الأمر مثله
Dialogue: 0,0:10:18.59,0:10:24.60,Default,,0000,0000,0000,,هذا الباب إذاً... لم يكن موصداً منذ البداية؟
Dialogue: 0,0:10:24.70,0:10:25.90,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:10:25.90,0:10:30.66,Default,,0000,0000,0000,,أفقدت ماسايو-سان أختها وعيها\Nبحبوب منوّمة غالباً
Dialogue: 0,0:10:31.07,0:10:36.96,Default,,0000,0000,0000,,ثمّ حملتها لحوض الاستحمام، وألصقت الشريط\Nاللاصق على الباب والنافذة
Dialogue: 0,0:10:37.27,0:10:39.92,Default,,0000,0000,0000,,...وبعد قطعها لمعصمها
Dialogue: 0,0:10:41.92,0:10:46.39,Default,,0000,0000,0000,,فتحت الباب المربوط بالشريط بالقوّة
Dialogue: 0,0:10:46.39,0:10:50.60,Default,,0000,0000,0000,,وخرجت، وأغلقت الباب مُجدداً
Dialogue: 0,0:10:50.90,0:10:53.02,Default,,0000,0000,0000,,الجانب الداخليّ للباب نقطة عمياء
Dialogue: 0,0:10:53.57,0:10:57.90,Default,,0000,0000,0000,,ولو كان الشريط منزوعاً\Nفي الداخل منذ البداية
Dialogue: 0,0:10:57.90,0:11:02.82,Default,,0000,0000,0000,,لا يمكنك معرفة متى حصل ذلك\Nبعدما تدخل الغرفة
Dialogue: 0,0:11:03.32,0:11:07.78,Default,,0000,0000,0000,,!لـ-لكنّك قلت أنّك واجهت صعوبةً في الدخول
Dialogue: 0,0:11:08.00,0:11:12.24,Default,,0000,0000,0000,,أجل، خدعتني ماسايو-سان بتمثيلها تماماً
Dialogue: 0,0:11:14.20,0:11:15.79,Default,,0000,0000,0000,,...آنذاك
Dialogue: 0,0:11:16.23,0:11:17.75,Default,,0000,0000,0000,,...استعداد
Dialogue: 0,0:11:19.07,0:11:22.65,Default,,0000,0000,0000,,كانت ماسايو-سان من تمسك بمقبض الباب
Dialogue: 0,0:11:22.65,0:11:25.32,Default,,0000,0000,0000,,أدارت مقبض الباب في التوقيت المناسب
Dialogue: 0,0:11:25.32,0:11:29.80,Default,,0000,0000,0000,,وجعلتنا نستشعر أنّنا فتحنا الباب بالقوّة
Dialogue: 0,0:11:29.80,0:11:35.52,Default,,0000,0000,0000,,وزرعت إيهام كون هذا حيزاً مغلقاً في أذهاننا
Dialogue: 0,0:11:37.11,0:11:44.02,Default,,0000,0000,0000,,كانت بحاجة لرفيق لجعل هذه\Nالحيلة الذهنية تنطلي على الجميع بالطبع
Dialogue: 0,0:11:44.02,0:11:52.66,Default,,0000,0000,0000,,لذا أحضرتنا هنا، مكان كينجي-كن الذي لم\Nيستطع القدوم لإصابته بالزكام
Dialogue: 0,0:11:52.99,0:11:55.00,Default,,0000,0000,0000,,لـ-لكن يا موري-كن
Dialogue: 0,0:11:55.40,0:12:00.96,Default,,0000,0000,0000,,لم نجد إلّا بصمات شقيقتها المتوفاة\N!على الشريط اللاصق في الداخل
Dialogue: 0,0:12:00.96,0:12:04.07,Default,,0000,0000,0000,,كما أنّ كلّ قطعة شريط احتوت
Dialogue: 0,0:12:04.07,0:12:07.48,Default,,0000,0000,0000,,!بصمات سبّابتها وإبهامها
Dialogue: 0,0:12:07.48,0:12:09.30,Default,,0000,0000,0000,,!كيف تفسّر ذلك؟
Dialogue: 0,0:12:09.57,0:12:11.26,Default,,0000,0000,0000,,حزم الأمتعة
Dialogue: 0,0:12:11.26,0:12:13.10,Default,,0000,0000,0000,,حـ-حزم الأمتعة؟
Dialogue: 0,0:12:13.10,0:12:18.27,Default,,0000,0000,0000,,قبل قتلها لشقيقتها، جعلتها ماسايو-سان\Nتساعدها في الحزم
Dialogue: 0,0:12:18.94,0:12:22.36,Default,,0000,0000,0000,,وأخبرتها بقطع أجزاءٍ من الشريط اللاصق\Nبطول ملائم وترتيبها
Dialogue: 0,0:12:22.73,0:12:27.44,Default,,0000,0000,0000,,ثمّ استعملت تلك الأجزاء لإغلاق\Nنافذة وباب الحمّام
Dialogue: 0,0:12:28.07,0:12:30.99,Default,,0000,0000,0000,,"وتشكيل كلمة "وداعاً
Dialogue: 0,0:12:30.99,0:12:35.99,Default,,0000,0000,0000,,وهي ترتدي قفّازاً كيلا تترك بصمات بالطبع
Dialogue: 0,0:12:35.99,0:12:40.07,Default,,0000,0000,0000,,ودليلاً لذلك، توجد صناديق كرتونيّة فتُحت قبلاً
Dialogue: 0,0:12:40.07,0:12:43.96,Default,,0000,0000,0000,,وآثار أجزاء شريط لاصق مرتّبة على الطاولة
Dialogue: 0,0:12:44.26,0:12:48.17,Default,,0000,0000,0000,,رغم أنّ المحلّل يعرف ذلك سلفاً
Dialogue: 0,0:12:49.02,0:12:53.94,Default,,0000,0000,0000,,بالمناسبة، كانت ماسايو-سان هي من أرسلت أختها
Dialogue: 0,0:12:53.94,0:12:59.85,Default,,0000,0000,0000,,لشراء الشريط اللاصق ومطهريّ \Nحوض الاستحمام الضروريين للجريمة
Dialogue: 0,0:13:00.23,0:13:02.52,Default,,0000,0000,0000,,نويتِ إيصاد الغرفة أوّلاً
Dialogue: 0,0:13:02.82,0:13:07.48,Default,,0000,0000,0000,,وقتل أختك بخلط المطهّرين
Dialogue: 0,0:13:07.48,0:13:12.73,Default,,0000,0000,0000,,لكنّها اشترت صنفين متماثلين\Nلا ينتجان غازاً
Dialogue: 0,0:13:12.73,0:13:16.41,Default,,0000,0000,0000,,،أدركتِ ذلك بعد إغلاقك للغرفة
Dialogue: 0,0:13:16.41,0:13:21.52,Default,,0000,0000,0000,,فقرّرتِ قطع معصمها سريعاً وجعلها\Nتموت بفقدان الدم بدل ذلك
Dialogue: 0,0:13:22.61,0:13:25.84,Default,,0000,0000,0000,,أو شيء من ذاك القبيل على الأرجح
Dialogue: 0,0:13:26.05,0:13:27.49,Default,,0000,0000,0000,,يا ماسايو-سان
Dialogue: 0,0:13:32.07,0:13:33.59,Default,,0000,0000,0000,,!ما-ماسايو؟
Dialogue: 0,0:13:35.52,0:13:40.02,Default,,0000,0000,0000,,،صحيح، إذا فعلتُ ما قلتَه \Nفكان بمقدوري ارتكاب الجريمة
Dialogue: 0,0:13:40.73,0:13:45.98,Default,,0000,0000,0000,,وأنا الأكثر شبهة بصفتي ساكنة سابقة\Nفي المنزل، وشقيقتها
Dialogue: 0,0:13:46.65,0:13:52.19,Default,,0000,0000,0000,,لكن هل رأيتني أغلق الحجرة بالشريط اللاصق؟
Dialogue: 0,0:13:52.19,0:13:54.95,Default,,0000,0000,0000,,هل رأيتني أقطع معصمها؟
Dialogue: 0,0:13:57.40,0:14:01.27,Default,,0000,0000,0000,,يمكنك الهذي بافتراضاتك، لكن يبقى الخيال خيالاً
Dialogue: 0,0:14:01.27,0:14:03.36,Default,,0000,0000,0000,,لا يثبت شيئاً
Dialogue: 0,0:14:03.36,0:14:08.63,Default,,0000,0000,0000,,فمن المحتمل أنّ هذه الحجرة\Nكانت مقفلةً بالشريط بالفعل
Dialogue: 0,0:14:09.23,0:14:11.34,Default,,0000,0000,0000,,ألستُ محقّة حضرة المفتّش؟
Dialogue: 0,0:14:11.56,0:14:15.26,Default,,0000,0000,0000,,ما جوابك يا موري-كن؟
Dialogue: 0,0:14:15.57,0:14:17.22,Default,,0000,0000,0000,,إنّها محقّة
Dialogue: 0,0:14:17.22,0:14:19.22,Default,,0000,0000,0000,,!أ-أبي
Dialogue: 0,0:14:19.48,0:14:23.69,Default,,0000,0000,0000,,لا أملك دليلاً واضحاً على هذه الحيلة
Dialogue: 0,0:14:24.65,0:14:25.86,Default,,0000,0000,0000,,!موري
Dialogue: 0,0:14:25.86,0:14:27.11,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:14:27.82,0:14:32.57,Default,,0000,0000,0000,,!تبقّت آثار على قتلك لشقيقتك
Dialogue: 0,0:14:34.78,0:14:38.49,Default,,0000,0000,0000,,!دليلٌ قاطع لا يمكنك التهرّب منه
Dialogue: 0,0:14:38.49,0:14:40.33,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:14:40.73,0:14:45.57,Default,,0000,0000,0000,,كينجي-سان، قلتَ أنّك أتيت\Nهنا البارحة، أليس كذلك؟
Dialogue: 0,0:14:45.57,0:14:46.79,Default,,0000,0000,0000,,بـ-بلى
Dialogue: 0,0:14:46.79,0:14:50.77,Default,,0000,0000,0000,,كم أمضيت في قرع الجرس آنذاك؟
Dialogue: 0,0:14:50.77,0:14:52.38,Default,,0000,0000,0000,,طويلاً
Dialogue: 0,0:14:52.82,0:14:57.67,Default,,0000,0000,0000,,تأخّرت على موعدنا، فظننت أنّها مستاءة في الداخل
Dialogue: 0,0:14:59.11,0:15:02.27,Default,,0000,0000,0000,,فهمت، كما ظننت
Dialogue: 0,0:15:02.85,0:15:04.91,Default,,0000,0000,0000,,ما-ماذا؟
Dialogue: 0,0:15:04.91,0:15:08.23,Default,,0000,0000,0000,,!ما الذي ظننته؟ قلها وحسب
Dialogue: 0,0:15:08.85,0:15:14.00,Default,,0000,0000,0000,,ماسايو-سان، كنتِ لا تزالين في\Nهذا المنزل آنذاك، أليس كذلك؟
Dialogue: 0,0:15:14.89,0:15:22.27,Default,,0000,0000,0000,,وتحقّقتِ من هويّة الزائر المزعج\N...عبر ثقب الباب
Dialogue: 0,0:15:22.27,0:15:25.45,Default,,0000,0000,0000,,!ودم شقيقتك لا يزال عليك
Dialogue: 0,0:15:27.60,0:15:30.10,Default,,0000,0000,0000,,فلتتفقدوا الباب الأماميّ
Dialogue: 0,0:15:30.10,0:15:33.60,Default,,0000,0000,0000,,ستجدون بقعة دم وصلته من ذاك الوقت
Dialogue: 0,0:15:33.60,0:15:36.43,Default,,0000,0000,0000,,أليس كذلك يا محقّق تاكاغي؟
Dialogue: 0,0:15:36.43,0:15:37.54,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:15:38.93,0:15:42.98,Default,,0000,0000,0000,,!لكن... لكن ما في ذلك؟
Dialogue: 0,0:15:42.98,0:15:45.55,Default,,0000,0000,0000,,!يمكن أنّ شقيقتي تركتها هناك
Dialogue: 0,0:15:46.35,0:15:51.27,Default,,0000,0000,0000,,تستعمل شيئاً مبهماً لا تعرف متى\N...وصل هناك ومن تركه كدليل
Dialogue: 0,0:15:51.27,0:15:53.88,Default,,0000,0000,0000,,...وتعتبر نفسك متحريّاً عظيماً
Dialogue: 0,0:16:05.68,0:16:08.78,Default,,0000,0000,0000,,أجل، لا تزال موجودة
Dialogue: 0,0:16:11.10,0:16:17.46,Default,,0000,0000,0000,,بقعة دم تطابق البقعة على الباب الأمامي\Nبحذافيرها، ولشقيقتك
Dialogue: 0,0:16:18.39,0:16:24.38,Default,,0000,0000,0000,,ماسايو-سان، إنّها على العصابة السوداء\Nالتي تربطينها حول رأسك
Dialogue: 0,0:16:26.64,0:16:31.22,Default,,0000,0000,0000,,حسناً، هلّا شرحتِ لنا يا ماسايو-سان
Dialogue: 0,0:16:31.93,0:16:35.74,Default,,0000,0000,0000,,لمَ يوجد دم أختك على هذه العصابة
Dialogue: 0,0:16:35.74,0:16:39.23,Default,,0000,0000,0000,,التي صدرت مع قرصٍ مدمج بالأمس؟
Dialogue: 0,0:16:39.60,0:16:41.68,Default,,0000,0000,0000,,،لـ-لكن يا موري-كن
Dialogue: 0,0:16:41.68,0:16:46.28,Default,,0000,0000,0000,,كيف عرفت أنّها كانت ترتدي\N!العصابة وقت الجريمة؟
Dialogue: 0,0:16:48.97,0:16:50.45,Default,,0000,0000,0000,,الشعار، صحيح؟
Dialogue: 0,0:16:52.45,0:16:54.41,Default,,0000,0000,0000,,الشعار على العصابة
Dialogue: 0,0:16:54.81,0:17:03.72,Default,,0000,0000,0000,,للشعار الحقيقيّ شرطةٌ فوق حرف\Nأو" الأوّل لمدّ الحرف"
Dialogue: 0,0:17:03.72,0:17:08.38,Default,,0000,0000,0000,,اختفاؤها يعني أنّ هناك ما يغطّيها
Dialogue: 0,0:17:09.18,0:17:14.06,Default,,0000,0000,0000,,لا بدّ أنّ دمّ أختي تطاير عليها، واسوّد فغطّاها
Dialogue: 0,0:17:16.34,0:17:19.23,Default,,0000,0000,0000,,لكن من المبهر أنّك عرفت ذلك يا موري-سان
Dialogue: 0,0:17:20.35,0:17:23.43,Default,,0000,0000,0000,,فلم تكن لديك عصابة بدورك، أليس كذلك؟
Dialogue: 0,0:17:23.43,0:17:30.23,Default,,0000,0000,0000,,،بلى، كان يراودني شعورٌ غريب لفترة\Nلكن لم أستطع تحديد سببه بدقّة
Dialogue: 0,0:17:31.68,0:17:37.91,Default,,0000,0000,0000,,حتّى رأيتُ الشعار على حاملة المفاتيح\Nوبقعة الدم فوق ثقب الباب
Dialogue: 0,0:17:38.47,0:17:43.88,Default,,0000,0000,0000,,وعرفت أنّ كينجي-سان كان \Nيقرع الباب البارحة
Dialogue: 0,0:17:44.56,0:17:46.47,Default,,0000,0000,0000,,فهمت
Dialogue: 0,0:17:46.84,0:17:51.87,Default,,0000,0000,0000,,حاملة المفاتيح هذه التي أريتك إيّاها\Nأدّت لهلاكي إذاً
Dialogue: 0,0:17:53.68,0:17:57.07,Default,,0000,0000,0000,,تعترفين بالجريمة إذاً؟
Dialogue: 0,0:17:57.22,0:18:01.19,Default,,0000,0000,0000,,أجل، خذني لمركز الشرطة أو أينما شئت
Dialogue: 0,0:18:01.51,0:18:07.15,Default,,0000,0000,0000,,!لـ-لكن، لمَ قتلتِ مينا؟\N!كنتما شقيقتين مقرّبتين جدّاً
Dialogue: 0,0:18:09.44,0:18:12.11,Default,,0000,0000,0000,,ربما مقرّبتين أكثر من اللازم
Dialogue: 0,0:18:14.52,0:18:18.68,Default,,0000,0000,0000,,لطالما كانت شقيقتي مينا تتبع آثاري
Dialogue: 0,0:18:18.68,0:18:24.08,Default,,0000,0000,0000,,أحبّت نفس الفنّانين مثلي، واشترت نفس حقائبي وثيابي
Dialogue: 0,0:18:24.08,0:18:28.05,Default,,0000,0000,0000,,قامت بتقليد أثاثي وأوانيي حتّى
Dialogue: 0,0:18:28.32,0:18:32.01,Default,,0000,0000,0000,,،رأيتُ أنّ ذلك كان ظريفاً في البداية\Nفهي شقيقتي الصغيرة
Dialogue: 0,0:18:32.60,0:18:35.97,Default,,0000,0000,0000,,لكن في إحدى الأيام، بعدما بدأ الأمر يغيظني
Dialogue: 0,0:18:36.85,0:18:40.89,Default,,0000,0000,0000,,،ارتسمت على وجهها ملامح بريئة\N...وأخبرتني بهذا وهي تبتسم
Dialogue: 0,0:18:41.63,0:18:43.42,Default,,0000,0000,0000,,!آسفة يا أختي
Dialogue: 0,0:18:43.42,0:18:48.06,Default,,0000,0000,0000,,وقعتُ في حبّ نفس الشخص \N!مثلك مُجدداً، واعترفت له أخيراً
Dialogue: 0,0:18:48.27,0:18:50.55,Default,,0000,0000,0000,,...لحظة، أتقصدين
Dialogue: 0,0:18:50.55,0:18:56.02,Default,,0000,0000,0000,,أجل، كان أنت يا كينجي\Nبعد تواعدنا لخمس سنوات
Dialogue: 0,0:18:57.63,0:19:00.63,Default,,0000,0000,0000,,كانت تتنافس معي بالأصل لا أكثر
Dialogue: 0,0:19:00.63,0:19:04.74,Default,,0000,0000,0000,,وفي النهاية، خطبتما بعضكما
Dialogue: 0,0:19:04.74,0:19:08.56,Default,,0000,0000,0000,,وكان عليّ مغادرة هذا المنزل
Dialogue: 0,0:19:10.17,0:19:16.76,Default,,0000,0000,0000,,أردتُ التخلّص من تلك الشيطانة\N!الصغيرة التي سلبت كلّ شيءٍ منّي
Dialogue: 0,0:19:16.76,0:19:19.42,Default,,0000,0000,0000,,!أردتُ إزالتها من ناظري فوراً
Dialogue: 0,0:19:19.42,0:19:20.92,Default,,0000,0000,0000,,!أ-أخطأتِ يا ماسايو
Dialogue: 0,0:19:21.72,0:19:25.09,Default,,0000,0000,0000,,!كنتُ من تقرّب لها، وضغط عليها الزواج
Dialogue: 0,0:19:26.88,0:19:29.47,Default,,0000,0000,0000,,رفضتني باستمرار بالطبع
Dialogue: 0,0:19:29.47,0:19:32.88,Default,,0000,0000,0000,,وطلبت منّي إصلاح علاقتي معك بدلاً منها
Dialogue: 0,0:19:32.88,0:19:37.44,Default,,0000,0000,0000,,هـ-هذه كذبة! فقد قالت أنّها\N!من تقرّبت منك
Dialogue: 0,0:19:37.44,0:19:42.90,Default,,0000,0000,0000,,كان ذلك شرطها عندما قبلت بخطبتي لها
Dialogue: 0,0:19:43.34,0:19:48.88,Default,,0000,0000,0000,,لا بدّ أنّها لم ترد أن تعرفي\Nأنّي فضّلتها عليك
Dialogue: 0,0:19:48.88,0:19:51.83,Default,,0000,0000,0000,,ففخرك أعلى من غيرك
Dialogue: 0,0:19:54.76,0:20:00.63,Default,,0000,0000,0000,,توقّف عن هذا الهراء! من المستحيل\N...أن تراعيني فتاة أنانيّة مثلها
Dialogue: 0,0:20:00.92,0:20:06.55,Default,,0000,0000,0000,,لا سبيل لمعرفة مشاعر شقيقتك الحقيقيّة الآن
Dialogue: 0,0:20:06.80,0:20:11.94,Default,,0000,0000,0000,,لكن لا شكّ أنّك كنتِ عزيزةً عليها
Dialogue: 0,0:20:14.16,0:20:15.50,Default,,0000,0000,0000,,...ما-ما
Dialogue: 0,0:20:16.72,0:20:19.52,Default,,0000,0000,0000,,!ما الذي تعرفه؟
Dialogue: 0,0:20:19.72,0:20:23.40,Default,,0000,0000,0000,,...قال مالك متجر التموينات
Dialogue: 0,0:20:24.34,0:20:26.55,Default,,0000,0000,0000,,أنّه في نهاية حساب شقيقتك
Dialogue: 0,0:20:26.86,0:20:31.24,Default,,0000,0000,0000,,ذهبت لاستبدال أحد المطهرين
Dialogue: 0,0:20:31.64,0:20:35.30,Default,,0000,0000,0000,,بآخر بحيث لا ينتج غاز كلوريّ عن غير قصد
Dialogue: 0,0:20:35.30,0:20:37.17,Default,,0000,0000,0000,,إذا خلطتِهما معاً
Dialogue: 0,0:20:37.97,0:20:41.00,Default,,0000,0000,0000,,لحماية حياتك
Dialogue: 0,0:20:42.43,0:20:44.72,Default,,0000,0000,0000,,...لا-لا يمكن
Dialogue: 0,0:20:46.40,0:20:49.32,Default,,0000,0000,0000,,...لـ-ليس صحيحاً
Dialogue: 0,0:20:50.27,0:20:55.02,Default,,0000,0000,0000,,...اسمعي يا مينا
Dialogue: 0,0:20:50.79,0:20:51.83,Default,,0000,0000,0000,,!مينا
Dialogue: 0,0:20:53.14,0:20:54.35,Default,,0000,0000,0000,,...اسمعي
Dialogue: 0,0:20:56.97,0:20:58.81,Default,,0000,0000,0000,,!أخبريني أنّ ذلك ليس صحيحاً
Dialogue: 0,0:20:59.88,0:21:02.13,Default,,0000,0000,0000,,!مينا! مينا
Dialogue: 0,0:21:02.50,0:21:04.74,Default,,0000,0000,0000,,!مينا! مينا
Dialogue: 0,0:21:06.94,0:21:08.55,Default,,0000,0000,0000,,!مينا
Dialogue: 0,0:21:11.22,0:21:13.06,Default,,0000,0000,0000,,!مينا
Dialogue: 0,0:21:17.96,0:21:22.75,Default,,0000,0000,0000,,أثار لطفٌ مشاعر كره، وتحوّل لإرادة إجراميّة
Dialogue: 0,0:21:24.25,0:21:28.46,Default,,0000,0000,0000,,،بين أصداء صرخات بكاء الآثمة المتعصّرة ألماً
Dialogue: 0,0:21:28.46,0:21:34.20,Default,,0000,0000,0000,,تجاور كأسان وفرشتيّ أسنان بصمت أمام المرآة
Dialogue: 0,0:21:35.79,0:21:38.59,Default,,0000,0000,0000,,كما لو أنّهما نسيا الذكريات السعيدة
Dialogue: 0,0:21:39.67,0:21:41.92,Default,,0000,0000,0000,,لزمن استعمالهما قبلاً
Dialogue: 0,0:23:16.02,0:23:19.86,OS,,0000,0000,0000,,!عرض آخر! عرض آخر! عرض آخر
Dialogue: 0,0:23:20.33,0:23:22.50,Default,,0000,0000,0000,,!يوكو-تشان
Dialogue: 0,0:23:24.08,0:23:26.71,Default,,0000,0000,0000,,!عزيزتي يوكو-تشان
Dialogue: 0,0:23:26.71,0:23:27.33,Default,,0000,0000,0000,,!موري-سان
Dialogue: 0,0:23:28.17,0:23:30.29,Default,,0000,0000,0000,,!أتيتَ بالفعل إذاً
Dialogue: 0,0:23:31.00,0:23:32.46,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:23:32.46,0:23:33.80,Default,,0000,0000,0000,,يسعدني ذلك
Dialogue: 0,0:23:37.08,0:23:39.52,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:23:39.52,0:23:40.90,Default,,0000,0000,0000,,!يوكو-تشان
Dialogue: 0,0:23:41.56,0:23:45.21,Default,,0000,0000,0000,,لا يجدر بك أن تقومي بشيء\N!مُسعد كهذا أمام معجبيك
Dialogue: 0,0:23:45.21,0:23:48.97,Default,,0000,0000,0000,,لا أدري لمَ، لكنّه يبتسم في نومه
Dialogue: 0,0:23:49.71,0:23:52.28,Default,,0000,0000,0000,,لا بدّ أنّه يحلم بحلم\Nحضر فيه الحفلة
Dialogue: 0,0:23:52.56,0:23:54.80,Default,,0000,0000,0000,,!لا يصحّ
Dialogue: 0,0:23:58.49,0:24:00.15,Default,,0000,0000,0000,,!يوكو-تشان
Dialogue: 0,0:24:02.53,0:24:06.86,Default,,0000,0000,0000,,المذيعة آكي-سان مفقودة؟ أتلقّت تهديداً؟
Dialogue: 0,0:24:06.86,0:24:11.18,Default,,0000,0000,0000,,كلا، لم يبد أنّها خائفة أبداً آنذاك
Dialogue: 0,0:24:12.87,0:24:16.26,Default,,0000,0000,0000,,ماذا لو كان ذاك الاتّصال\N!فخّاً لاستدراجها إلى مكان؟
Dialogue: 0,0:24:22.24,0:24:23.75,Default,,0000,0000,0000,,!هذه هي النهاية
Dialogue: 0,0:24:25.56,0:24:31.59,On Top,,0000,0000,0000,,قضيّة اختطاف مذيعة الطقس
Dialogue: 0,0:24:26.57,0:24:28.07,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:28.07,0:24:31.59,Default,,0000,0000,0000,,قضيّة اختطاف مذيعة الطقس
Dialogue: 0,0:24:47.52,0:24:49.79,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:49.79,0:24:51.79,Default,,0000,0000,0000,,جهاز مناداة
Dialogue: 0,0:24:51.79,0:24:53.79,Default,,0000,0000,0000,,!الحلقة القادمة عن مذيعة طقس جميلة
Dialogue: 0,0:24:53.79,0:24:55.48,Default,,0000,0000,0000,,!سأريها قصارى جهدي
Dialogue: 0,0:24:55.48,0:24:57.48,Default,,0000,0000,0000,,مهلك

