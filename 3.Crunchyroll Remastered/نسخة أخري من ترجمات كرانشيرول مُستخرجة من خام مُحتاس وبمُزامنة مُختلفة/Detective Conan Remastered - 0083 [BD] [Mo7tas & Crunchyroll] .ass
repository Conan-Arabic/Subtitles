Dialogue: 0,0:00:02.13,0:00:03.88,Default,,0000,0000,0000,,عقرب دقائق مسرِع، سديمٌ لامع
Dialogue: 0,0:00:03.88,0:00:07.49,Default,,0000,0000,0000,,استنتاجات كونان دواء ممتاز للقلوب\N!التي جفّفها المجتمع الحديث
Dialogue: 0,0:00:07.49,0:00:11.00,Default,,0000,0000,0000,,!تقع قضيّة اليوم في مشفى عام\N!العمّ موري قاتل؟
Dialogue: 0,0:00:11.00,0:00:12.32,Default,,0000,0000,0000,,يرى الحقيقة الواحدة
Dialogue: 0,0:00:12.32,0:00:14.33,Default,,0000,0000,0000,,يحمل مظهر طفل، لكنّ عقله عقل بالغ
Dialogue: 0,0:00:14.33,0:00:16.32,Default,,0000,0000,0000,,!اسمه المتحرّي كونان
Dialogue: 0,0:01:51.07,0:01:56.99,Title,,0000,0000,0000,,{\fad(300,0)}جريمة قتل المشفى العام
Dialogue: 0,0:01:52.02,0:01:54.56,Default,,0000,0000,0000,,جريمة قتل المشفى العام
Dialogue: 0,0:01:57.05,0:01:59.45,On Top,,0000,0000,0000,,مشفى شرق بيكا العام
Dialogue: 0,0:02:07.00,0:02:08.81,Default,,0000,0000,0000,,أشعر بالضجر
Dialogue: 0,0:02:08.81,0:02:09.93,Default,,0000,0000,0000,,...بربّك يا أبي
Dialogue: 0,0:02:10.13,0:02:13.35,Default,,0000,0000,0000,,هذا الأسبوع الثالث على\Nإقامة العمّ في المشفى
Dialogue: 0,0:02:13.35,0:02:17.05,Default,,0000,0000,0000,,كسر ساقه وهو يصارع لصّاً حاول الإمساك به
Dialogue: 0,0:02:19.16,0:02:23.09,Default,,0000,0000,0000,,لكن بالطبع كنتُ أنا من أطاح به
Dialogue: 0,0:02:23.83,0:02:27.86,Default,,0000,0000,0000,,لكنّك كنت مشغولاً كثيراً مؤخراً\Nلذا هذه فرصة مناسبة للاسترخاء
Dialogue: 0,0:02:30.86,0:02:32.45,Default,,0000,0000,0000,,!وقت الطعام
Dialogue: 0,0:02:33.82,0:02:35.36,Default,,0000,0000,0000,,!طعام أخيراً
Dialogue: 0,0:02:35.36,0:02:39.06,Default,,0000,0000,0000,,يبدو أنّ المحقق الشهير يتضوّر جوعاً
Dialogue: 0,0:02:41.14,0:02:42.97,Default,,0000,0000,0000,,...كم أودّ أكل ساشيمي مع جعّة
Dialogue: 0,0:02:43.21,0:02:46.51,Default,,0000,0000,0000,,!لا يليق هذا بمتحرٍّ شهير يا أبي! يا للخزي
Dialogue: 0,0:02:46.51,0:02:51.92,CharCard,,0000,0000,0004,,(26) ناكاياما كازومي\Nممرضة
Dialogue: 0,0:02:47.67,0:02:53.06,On Top,,0000,0000,0000,,لكنّ جميع الممرضات يتكلّمن عن رغبتهن\N!برؤية موري-سان الشهير بأمّ أعينهن
Dialogue: 0,0:02:54.58,0:02:57.50,Default,,0000,0000,0000,,الحسناوات ذوات الرداء الأبيض يتكلّمن عني؟
Dialogue: 0,0:02:57.50,0:02:58.01,Default,,0000,0000,0000,,!نعم
Dialogue: 0,0:02:58.55,0:03:01.99,On Top,,0000,0000,0000,,أودّ سماع قصصك بدوري
Dialogue: 0,0:02:59.88,0:03:03.86,CharCard,,0000,0000,0004,,\N\N{\fad(300,0)}(40)  شيراي ميتسو\Nالطبيب المسؤول
Dialogue: 0,0:03:02.03,0:03:03.94,On Top,,0000,0000,0000,,قد أتعلّم الكثير
Dialogue: 0,0:03:04.04,0:03:08.33,Default,,0000,0000,0000,,،هذا إطراءٌ كثير أيّها الطبيب شيراي\Nستجعلني أخجل
Dialogue: 0,0:03:09.04,0:03:10.75,Default,,0000,0000,0000,,تتعلّم ماذا؟
Dialogue: 0,0:03:11.19,0:03:14.85,Default,,0000,0000,0000,,احترس من ألّا يستغلّك في تجاربه حضرة المتحرّي
Dialogue: 0,0:03:15.10,0:03:16.18,Default,,0000,0000,0000,,!يا للفظاظة
Dialogue: 0,0:03:16.22,0:03:21.02,CharCard,,0000,0000,0004,,\N\N{\fad(300,0)} (40) إيتو كاتسوتوشي\Nجرّاح
Dialogue: 0,0:03:16.36,0:03:19.35,On Top,,0000,0000,0000,,!يا للنظرة المخيفة
Dialogue: 0,0:03:19.35,0:03:24.14,On Top,,0000,0000,0000,,حضرة المتحرّي، إذا قُتلت فاعرف أنّ\Nشيراي هو الفاعل
Dialogue: 0,0:03:31.05,0:03:32.39,Default,,0000,0000,0000,,من كان ذاك؟
Dialogue: 0,0:03:33.01,0:03:38.08,Default,,0000,0000,0000,,.إنّه إيتو-كن، جرّاح زميل لي\Nارتدنا الجامعة سويّاً
Dialogue: 0,0:03:38.08,0:03:41.31,Default,,0000,0000,0000,,إنّه سليط اللسان، لكنّه جرّاح بارع
Dialogue: 0,0:03:41.79,0:03:44.77,Default,,0000,0000,0000,,قد يكون بارعاً، لكنّه فظيع الشخصيّة
Dialogue: 0,0:03:49.28,0:03:53.19,Default,,0000,0000,0000,,المطر يهطل، هل نرجع يا كونان-كن؟
Dialogue: 0,0:03:53.19,0:03:53.94,Default,,0000,0000,0000,,نعم
Dialogue: 0,0:03:54.24,0:03:58.68,Default,,0000,0000,0000,,،موري-سان، لا يمكنك شراب الساكي \Nلكن يمكنك احتساء قهوة
Dialogue: 0,0:03:59.39,0:04:03.14,Default,,0000,0000,0000,,هلّا أسمعتني بعضاً من قصص إنجازاتك؟
Dialogue: 0,0:04:04.42,0:04:05.73,Default,,0000,0000,0000,,!بالطبع
Dialogue: 0,0:04:06.13,0:04:11.63,Default,,0000,0000,0000,,القضيّة الأخيرة مثال ممتاز للجرائم\Nالتي حللتُها باستنتاجاتي الحادة
Dialogue: 0,0:04:11.88,0:04:17.01,Default,,0000,0000,0000,,فقد كانت مغلفةً بالغموض بما أنّ المجرم\Nلم يترك أيّ شيء وراءه
Dialogue: 0,0:04:17.21,0:04:19.41,Default,,0000,0000,0000,,!يحبّ السكّريات كثيراً
Dialogue: 0,0:04:26.61,0:04:29.06,Default,,0000,0000,0000,,ماذا؟ أين الطبيب شيراي؟
Dialogue: 0,0:04:31.02,0:04:34.07,Default,,0000,0000,0000,,تأخّر الوقت لهذا الحدّ؟
Dialogue: 0,0:04:37.43,0:04:39.22,Default,,0000,0000,0000,,!جـ-جريمة قتل
Dialogue: 0,0:04:44.35,0:04:45.85,Default,,0000,0000,0000,,!اتّصلوا بالشرطة
Dialogue: 0,0:04:45.85,0:04:49.18,Default,,0000,0000,0000,,!هناك جريمة قتل! اتّصلوا بـ 110 بسرعة
Dialogue: 0,0:04:49.18,0:04:51.14,Default,,0000,0000,0000,,!حاضر، فوراً
Dialogue: 0,0:04:54.26,0:04:56.37,Default,,0000,0000,0000,,!انتظر يا موري-سان
Dialogue: 0,0:05:03.48,0:05:05.37,Default,,0000,0000,0000,,هذه الغرفة فارغة
Dialogue: 0,0:05:06.93,0:05:09.64,Default,,0000,0000,0000,,...ماذا؟ أنا متأكد أنّي رأيتُ هنا
Dialogue: 0,0:05:14.74,0:05:16.93,Default,,0000,0000,0000,,اختفت الجثّة؟
Dialogue: 0,0:05:17.20,0:05:20.98,Default,,0000,0000,0000,,...ذاك الاحتمال الوحيد، لكنّي رأيت فعلاً
Dialogue: 0,0:05:22.11,0:05:24.95,Default,,0000,0000,0000,,أأنت متأكّد من وجود واحدة في الأصل؟
Dialogue: 0,0:05:25.30,0:05:26.94,Default,,0000,0000,0000,,!أتشكّ بي؟
Dialogue: 0,0:05:26.94,0:05:29.97,Default,,0000,0000,0000,,...لكنّ الحقيقة أنّنا لم نجد شيئاً
Dialogue: 0,0:05:29.97,0:05:34.42,Default,,0000,0000,0000,,مهلكما، الوقت متأخّر فعلينا\Nألّا نزعج المرضى
Dialogue: 0,0:05:34.42,0:05:35.40,Default,,0000,0000,0000,,...لننصرف الليلة
Dialogue: 0,0:05:35.40,0:05:38.79,Default,,0000,0000,0000,,...يا طبيب! رأيتُ بأمّ عيني
Dialogue: 0,0:05:38.79,0:05:41.61,Default,,0000,0000,0000,,بدوتَ مرهقاً كثيراً مؤخراً
Dialogue: 0,0:05:42.08,0:05:46.98,Default,,0000,0000,0000,,حسناً، لعلّي نمتُ بينما كنت\N...أقصّ عليك قصتي
Dialogue: 0,0:05:48.77,0:05:52.36,Default,,0000,0000,0000,,كان المتحرّي الشهير مرهقاً فحسب إذاً
Dialogue: 0,0:05:52.67,0:05:54.90,Default,,0000,0000,0000,,يا إلهي، جلبتَ المتاعب للآخرين
Dialogue: 0,0:06:00.56,0:06:02.74,Default,,0000,0000,0000,,سننصرف نحن بدورنا
Dialogue: 0,0:06:04.64,0:06:06.33,Default,,0000,0000,0000,,شكراً لكم
Dialogue: 0,0:06:12.21,0:06:16.98,Default,,0000,0000,0000,,لكن العمّ شاهد نفس المنظر\Nمرّات عديدة متتالية
Dialogue: 0,0:06:16.98,0:06:19.69,Default,,0000,0000,0000,,!لا-لا شكّ هذه المرّة
Dialogue: 0,0:06:23.08,0:06:25.69,Default,,0000,0000,0000,,!اتّصلي بـ 110! 110
Dialogue: 0,0:06:25.69,0:06:26.56,Default,,0000,0000,0000,,مُجدداً؟
Dialogue: 0,0:06:29.77,0:06:31.73,Default,,0000,0000,0000,,...مستحيل
Dialogue: 0,0:06:33.69,0:06:35.24,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:06:35.77,0:06:39.19,Default,,0000,0000,0000,,!ما الخطب يا أبي؟ هذه المرّة الرابعة
Dialogue: 0,0:06:42.81,0:06:47.60,Default,,0000,0000,0000,,...لا أكذب، رأيتُ حقّاً... رأيت
Dialogue: 0,0:06:47.84,0:06:49.57,Default,,0000,0000,0000,,أبي
Dialogue: 0,0:06:49.57,0:06:57.37,Default,,0000,0000,0000,,لعلّ الضغط من التعامل مع الكثير\Nمن الجرائم بصفته متحرياً شهيراً أثّر عليه
Dialogue: 0,0:06:58.13,0:06:59.57,Default,,0000,0000,0000,,...فأصبح يرى هلوسات
Dialogue: 0,0:07:00.00,0:07:02.65,Default,,0000,0000,0000,,!كلا! لم تكن تلك هلوسات
Dialogue: 0,0:07:02.65,0:07:05.49,Default,,0000,0000,0000,,!اهدأ يا أبي! تماسك
Dialogue: 0,0:07:05.65,0:07:07.54,Default,,0000,0000,0000,,ما حلّ بك؟
Dialogue: 0,0:07:11.19,0:07:13.61,Default,,0000,0000,0000,,سأتفقد المكان تحسّباً
Dialogue: 0,0:07:23.52,0:07:26.44,Default,,0000,0000,0000,,هذه بقع حديثة
Dialogue: 0,0:07:26.80,0:07:31.90,Default,,0000,0000,0000,,هطل المطر مرّتين في الليلة\Nالتي شهد فيها العمّ الجرائم
Dialogue: 0,0:07:38.62,0:07:41.44,Default,,0000,0000,0000,,أي أنّ هذه النافذة كانت مفتوحة وقتها
Dialogue: 0,0:07:43.65,0:07:46.06,Default,,0000,0000,0000,,غرفته المقابلة من هنا
Dialogue: 0,0:07:48.45,0:07:51.22,Default,,0000,0000,0000,,لا ستائر، أتلك غرفة غير مستعملة؟
Dialogue: 0,0:07:52.32,0:07:54.03,Default,,0000,0000,0000,,!فهمت! هكذا إذاً
Dialogue: 0,0:07:55.28,0:07:57.23,Default,,0000,0000,0000,,،إذا أُضيئت المصابيح في تلك الغرفة ليلاً
Dialogue: 0,0:07:57.23,0:08:01.26,Default,,0000,0000,0000,,فستكون هذه النافذة كمرآة\Nمع المبنى المظلم وراءها
Dialogue: 0,0:08:01.90,0:08:04.52,Default,,0000,0000,0000,,،وبناءً على زاوية فتحك للنافذة
Dialogue: 0,0:08:04.52,0:08:06.60,Default,,0000,0000,0000,,...يمكنك عكس صورة غرفة ما
Dialogue: 0,0:08:07.09,0:08:09.06,Default,,0000,0000,0000,,!وتلك غرفة العمّ
Dialogue: 0,0:08:09.51,0:08:12.30,Default,,0000,0000,0000,,لا يمكن رؤية غرفة الجريمة\Nمن نافذته مباشرةً
Dialogue: 0,0:08:12.59,0:08:13.78,Default,,0000,0000,0000,,...ما بالغرفة
Dialogue: 0,0:08:14.22,0:08:15.94,Default,,0000,0000,0000,,يُعكس على هذه النافذة
Dialogue: 0,0:08:16.50,0:08:19.94,Default,,0000,0000,0000,,!فيبدو للعمّ أنّ هناك جريمة تقع هنا
Dialogue: 0,0:08:20.63,0:08:23.12,Default,,0000,0000,0000,,!هذه خدعة مرآة باستعمال النوافذ
Dialogue: 0,0:08:26.35,0:08:27.99,On Top,,0000,0000,0000,,مخزن
Dialogue: 0,0:08:27.99,0:08:28.81,Default,,0000,0000,0000,,!هذا هو
Dialogue: 0,0:08:43.56,0:08:45.66,Default,,0000,0000,0000,,دمية إسعافات أوليّة
Dialogue: 0,0:08:47.22,0:08:49.53,Default,,0000,0000,0000,,اُستعملت للتمثيل
Dialogue: 0,0:08:50.72,0:08:55.35,Default,,0000,0000,0000,,أهذا مجرّد مقلب أم يحمل معنى آخر وراءه؟
Dialogue: 0,0:09:01.04,0:09:04.70,Default,,0000,0000,0000,,!سأبقى الليلة مع العمّ للاعتناء به
Dialogue: 0,0:09:05.57,0:09:07.69,Default,,0000,0000,0000,,يا لاهتمامك
Dialogue: 0,0:09:10.65,0:09:13.64,Default,,0000,0000,0000,,إذاً يا موري-سان، تناول هذه واسترح رجاءً
Dialogue: 0,0:09:16.52,0:09:18.49,Default,,0000,0000,0000,,المطر يهطل بشدّة
Dialogue: 0,0:09:18.73,0:09:20.06,Default,,0000,0000,0000,,عُمتما مساءً
Dialogue: 0,0:09:45.99,0:09:46.64,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:09:46.95,0:09:49.39,Default,,0000,0000,0000,,كونان! أرأيت ذلك أيضاً؟
Dialogue: 0,0:09:49.39,0:09:52.01,Default,,0000,0000,0000,,!نعم! لم تكن هلوسة
Dialogue: 0,0:09:52.01,0:09:53.51,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:09:53.51,0:09:55.31,Default,,0000,0000,0000,,!حسنٌ
Dialogue: 0,0:10:00.98,0:10:02.39,Default,,0000,0000,0000,,!رجع موري كوغورو
Dialogue: 0,0:10:05.14,0:10:06.60,On Top,,0000,0000,0000,,مخزن
Dialogue: 0,0:10:16.08,0:10:19.37,Default,,0000,0000,0000,,لا أحد هنا، ولا يبدو أنّ الدمية قد اُستعملت
Dialogue: 0,0:10:19.37,0:10:20.92,Default,,0000,0000,0000,,ما معنى هذا؟
Dialogue: 0,0:10:20.92,0:10:22.47,Default,,0000,0000,0000,,!أيمكن؟ تبّاً
Dialogue: 0,0:10:26.57,0:10:27.95,Default,,0000,0000,0000,,!يا عمّ
Dialogue: 0,0:10:30.57,0:10:32.27,Default,,0000,0000,0000,,!طبيب إيتو
Dialogue: 0,0:10:34.94,0:10:37.48,Default,,0000,0000,0000,,تلقّت الجثة طعنتين
Dialogue: 0,0:10:37.48,0:10:41.59,Default,,0000,0000,0000,,ولم تكن هناك تفاعلات حيوية \Nمع الطعنة الثانية
Dialogue: 0,0:10:42.55,0:10:44.99,Default,,0000,0000,0000,,أي أنّ الأولى قتلته؟
Dialogue: 0,0:10:45.51,0:10:47.19,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:10:47.97,0:10:49.77,Default,,0000,0000,0000,,ما الذي حصل هنا؟
Dialogue: 0,0:10:49.77,0:10:51.93,Default,,0000,0000,0000,,...لستُ متأكداً بدوري
Dialogue: 0,0:10:52.29,0:10:54.89,Default,,0000,0000,0000,,...ضربني أحدهم فجأةً و
Dialogue: 0,0:10:54.89,0:10:56.54,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:10:56.54,0:10:58.15,Default,,0000,0000,0000,,ما الذي يجري؟
Dialogue: 0,0:10:59.59,0:11:01.06,Default,,0000,0000,0000,,...لستُ متأكداً
Dialogue: 0,0:11:01.25,0:11:03.43,Default,,0000,0000,0000,,كونان-كن! ما الذي حصل؟
Dialogue: 0,0:11:03.43,0:11:05.51,Default,,0000,0000,0000,,...لا أعرف بدوري
Dialogue: 0,0:11:05.51,0:11:07.40,Default,,0000,0000,0000,,!موري-سان قتل إيتو-كن؟
Dialogue: 0,0:11:09.32,0:11:10.81,Default,,0000,0000,0000,,لا يفاجئني ذلك
Dialogue: 0,0:11:11.20,0:11:13.26,Default,,0000,0000,0000,,المعذرة، من أنت؟
Dialogue: 0,0:11:13.52,0:11:17.47,Default,,0000,0000,0000,,،الطبيب شيراي المسؤول عن موري-سان\Nلديّ مناوبة ليلية اليوم
Dialogue: 0,0:11:17.47,0:11:20.69,Default,,0000,0000,0000,,قلتَ أنّ الأمر لا يفاجئك
Dialogue: 0,0:11:20.86,0:11:26.09,Default,,0000,0000,0000,,كنت أقصد أنّ موري-سان\Nتعرّض لضغط كبير مؤخراً
Dialogue: 0,0:11:26.43,0:11:28.76,Default,,0000,0000,0000,,أصبح يرى هلوسات متكررة
Dialogue: 0,0:11:28.76,0:11:33.10,Default,,0000,0000,0000,,وكنتُ قلقاً من حصول شيء كهذا
Dialogue: 0,0:11:34.13,0:11:38.56,Default,,0000,0000,0000,,لكنّي رأيتُ الجريمة في الغرفة\N!المقابلة مع العمّ
Dialogue: 0,0:11:38.56,0:11:41.13,Default,,0000,0000,0000,,أتفهّم مشاعرك يا كونان-كن
Dialogue: 0,0:11:41.13,0:11:44.74,Default,,0000,0000,0000,,لكنّ شهادتك ستُعتبر حمايةً لموري-كن
Dialogue: 0,0:11:44.74,0:11:48.02,Default,,0000,0000,0000,,ولن تصمد في المحكمة غالباً
Dialogue: 0,0:11:48.02,0:11:49.88,Default,,0000,0000,0000,,...لا-لا يمكن
Dialogue: 0,0:11:50.35,0:11:54.32,Default,,0000,0000,0000,,بالتفكير في الأمر، تتلاشى ذاكرتي أحياناً
Dialogue: 0,0:11:54.32,0:11:57.81,Default,,0000,0000,0000,,!يمكن أنّي قتلت شخصاً وقتها
Dialogue: 0,0:11:58.25,0:11:59.77,Default,,0000,0000,0000,,...يا عمّ
Dialogue: 0,0:12:00.14,0:12:01.10,Default,,0000,0000,0000,,!ما الذي تقوله؟
Dialogue: 0,0:12:01.51,0:12:04.97,Default,,0000,0000,0000,,!لا تتفوّه بحماقات! تماسك يا أبي
Dialogue: 0,0:12:06.09,0:12:07.96,Default,,0000,0000,0000,,...هوّني عليك يا ران-كن
Dialogue: 0,0:12:08.14,0:12:11.39,Default,,0000,0000,0000,,بأيّ حال، بناءً على موقع غرفة الجريمة\Nوالأدراج والمصاعد
Dialogue: 0,0:12:11.39,0:12:17.44,Default,,0000,0000,0000,,ومركز الممرضات فلا يُرجّح أنّ القاتل\Nتسلّل من الخارج
Dialogue: 0,0:12:18.38,0:12:23.72,Default,,0000,0000,0000,,بالمناسبة، سمعت أنّ بينك والضحيّة\Nاختلافات حادة يا طبيب شيراي
Dialogue: 0,0:12:23.72,0:12:26.18,Default,,0000,0000,0000,,!كلا، لا شيء كبير كهذا البتّة
Dialogue: 0,0:12:26.18,0:12:30.14,Default,,0000,0000,0000,,هلّا أخبرتنا بحجّة غيابك بأيّ حال؟
Dialogue: 0,0:12:30.54,0:12:34.53,Default,,0000,0000,0000,,حاضر، وقعت الجريمة عند الحادية عشرة والنصف، صحيح؟
Dialogue: 0,0:12:34.53,0:12:40.10,Default,,0000,0000,0000,,كنتُ في غرفتي ذاك الوقت\Nفي الطابق الثاني من الجناح الشمالي
Dialogue: 0,0:12:40.36,0:12:42.55,Default,,0000,0000,0000,,أيمكنك إثبات ذلك؟
Dialogue: 0,0:12:42.81,0:12:47.52,Default,,0000,0000,0000,,أوكيتا-كن، قمتِ بتسليمي سجّلات\Nفي ذاك الوقت، صحيح؟
Dialogue: 0,0:12:48.10,0:12:51.43,Default,,0000,0000,0000,,نعم، كان قرابة ذاك الوقت
Dialogue: 0,0:12:51.59,0:12:54.39,Default,,0000,0000,0000,,وأنتِ متأكّدة أنّه كان في الغرفة وقتها؟
Dialogue: 0,0:12:54.59,0:12:57.00,Default,,0000,0000,0000,,أجل، لكنّه كان يتكلّم على الهاتف
Dialogue: 0,0:13:01.79,0:13:03.12,Default,,0000,0000,0000,,طبيب شيراي
Dialogue: 0,0:13:03.12,0:13:05.93,Default,,0000,0000,0000,,أحضرتُ السجّلات، معها قهوة أيضاً
Dialogue: 0,0:13:05.93,0:13:07.25,Default,,0000,0000,0000,,!شكراً
Dialogue: 0,0:13:07.25,0:13:11.39,Default,,0000,0000,0000,,،أنا أتكلّم على الهاتف الآن\Nهلّا تركتِها على المكتب؟
Dialogue: 0,0:13:11.39,0:13:12.31,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:13:16.40,0:13:19.52,Default,,0000,0000,0000,,حصلت هذه الجلبة في ذاك الوقت تقريباً
Dialogue: 0,0:13:19.52,0:13:23.89,Default,,0000,0000,0000,,تكلّمتِ معه إذاً رغم أنّك لم تريه؟
Dialogue: 0,0:13:23.89,0:13:25.73,Default,,0000,0000,0000,,ولم يكن تسجيلاً؟
Dialogue: 0,0:13:25.73,0:13:26.47,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:13:26.47,0:13:29.43,Default,,0000,0000,0000,,حجّة غيابي ثابتة إذاً حضرة المفتّش
Dialogue: 0,0:13:30.58,0:13:32.40,Default,,0000,0000,0000,,لكن ما كانت المكالمة؟
Dialogue: 0,0:13:32.40,0:13:34.99,Default,,0000,0000,0000,,هل أنت من اتّصل؟ أم تلقّيت الاتّصال؟
Dialogue: 0,0:13:34.99,0:13:36.46,Default,,0000,0000,0000,,وما المهم؟
Dialogue: 0,0:13:36.46,0:13:37.66,Default,,0000,0000,0000,,إذاً؟
Dialogue: 0,0:13:37.82,0:13:43.47,Default,,0000,0000,0000,,اتّصل بي شخص مجهول\Nللتذمّر من تشخيصي له
Dialogue: 0,0:13:43.47,0:13:45.11,Default,,0000,0000,0000,,يحصل ذلك من حينٍ لآخر
Dialogue: 0,0:13:45.64,0:13:47.91,Default,,0000,0000,0000,,أي لا يمكننا التثبّت من هويّة المتّصل
Dialogue: 0,0:13:48.45,0:13:52.15,Default,,0000,0000,0000,,ما يعني أنّ موري-كن هو الأكثر شبهة
Dialogue: 0,0:13:52.40,0:13:53.71,Default,,0000,0000,0000,,!لا يُعقل
Dialogue: 0,0:13:53.98,0:13:56.40,Default,,0000,0000,0000,,أحقّاً ذلك؟
Dialogue: 0,0:13:56.40,0:13:59.98,Default,,0000,0000,0000,,تبدو حجّة الطبيب شيراي مطبقة حقّاً
Dialogue: 0,0:14:00.46,0:14:01.59,Default,,0000,0000,0000,,...لكن
Dialogue: 0,0:14:04.13,0:14:07.22,Default,,0000,0000,0000,,فتح الطبيب شيراي ستائر\Nغرفة العمّ
Dialogue: 0,0:14:08.88,0:14:10.80,Default,,0000,0000,0000,,ووقّت ساعة التنبيه
Dialogue: 0,0:14:10.80,0:14:14.51,Default,,0000,0000,0000,,كي يشهد تلك الجرائم بكلّ وضوح
Dialogue: 0,0:14:16.04,0:14:17.92,Default,,0000,0000,0000,,...لكن حجّة غيابه
Dialogue: 0,0:14:18.11,0:14:19.29,On Top,,0000,0000,0000,,شيراي
Dialogue: 0,0:14:28.95,0:14:31.71,Default,,0000,0000,0000,,هاتف بخاصية تكبير صوت
Dialogue: 0,0:14:37.52,0:14:39.51,Default,,0000,0000,0000,,لم يضف سكّراً
Dialogue: 0,0:14:45.68,0:14:49.57,Default,,0000,0000,0000,,!فهمت! عرفت حيلة حجّة غيابه
Dialogue: 0,0:14:50.26,0:14:53.36,Default,,0000,0000,0000,,!لا شكّ في الأمر! القاتل هو الطبيب شيراي
Dialogue: 0,0:14:54.29,0:14:56.37,Default,,0000,0000,0000,,لكن لا دليل لديّ
Dialogue: 0,0:14:56.99,0:15:00.26,Default,,0000,0000,0000,,...لحظة، أيمكن أنّ كأس القهوة هذا
Dialogue: 0,0:15:02.19,0:15:04.08,Default,,0000,0000,0000,,سيّدي المُحلل
Dialogue: 0,0:15:05.53,0:15:08.52,Default,,0000,0000,0000,,أنتَ الفتى الذي يقيم مع موري-سان
Dialogue: 0,0:15:08.94,0:15:11.95,Default,,0000,0000,0000,,يبدو أنّ وضعه صعب هذه المرّة
Dialogue: 0,0:15:11.95,0:15:16.04,Default,,0000,0000,0000,,في الواقع، أخبرني المفتّش ميغوري أنّه\Nيريد منك فحص شيء
Dialogue: 0,0:15:18.18,0:15:19.31,On Top,,0000,0000,0000,,شيراي
Dialogue: 0,0:15:21.18,0:15:23.09,Default,,0000,0000,0000,,!إذاً؟ ما الذي وجدته؟
Dialogue: 0,0:15:23.09,0:15:25.83,Default,,0000,0000,0000,,نعم، كما قلتَ تماماً يا فتى
Dialogue: 0,0:15:26.00,0:15:27.59,Default,,0000,0000,0000,,!كما ظننت
Dialogue: 0,0:15:27.59,0:15:33.04,Default,,0000,0000,0000,,وجدتُ الدليل على كأس القهوة\N!الذي يدين الطبيب شيراي
Dialogue: 0,0:15:44.99,0:15:46.57,Default,,0000,0000,0000,,!بدأت حضرة المفتّش
Dialogue: 0,0:15:46.57,0:15:47.74,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:15:48.15,0:15:49.67,Default,,0000,0000,0000,,ما الخطب يا ميغوري-سان؟
Dialogue: 0,0:15:49.90,0:15:54.48,Default,,0000,0000,0000,,"لا تقلق، هذه وضعيّة "كوغورو النائم\Nالتي يتّخذها موري-كن
Dialogue: 0,0:15:54.48,0:15:56.04,Default,,0000,0000,0000,,!عندما يبدأ شرح استنتاجاته
Dialogue: 0,0:15:57.01,0:16:01.49,Default,,0000,0000,0000,,يا سادة، هذه جريمة مدبّرة بمكر\Nتتكوّن من خطوتين
Dialogue: 0,0:16:02.21,0:16:05.13,Default,,0000,0000,0000,,الخطوة الأولى كانت هي الإثقال عليّ ذهنياً
Dialogue: 0,0:16:05.13,0:16:09.92,Default,,0000,0000,0000,,لإقناعي والجميع أنّي قد أرتكب جريمة
Dialogue: 0,0:16:09.92,0:16:11.49,Default,,0000,0000,0000,,تحت الضغط النفسيّ
Dialogue: 0,0:16:11.49,0:16:15.46,Default,,0000,0000,0000,,والخطوة الثانية هي ارتكاب القاتل للجريمة\Nوتلفيق التهمة بي
Dialogue: 0,0:16:15.46,0:16:20.42,Default,,0000,0000,0000,,ثمّ تنفيذه حيلة حجّة غيابه\Nليهرب من دائرة الشبهة
Dialogue: 0,0:16:21.16,0:16:27.75,Default,,0000,0000,0000,,لفعل ذلك، استعمل القاتل دمية الإسعافات الأوليّة\Nفي مخزن الطابق الرابع أوّلاً
Dialogue: 0,0:16:28.25,0:16:33.17,Default,,0000,0000,0000,,فتح القاتل نافذة غرفة الجريمة بزاوية محددة
Dialogue: 0,0:16:33.69,0:16:37.77,Default,,0000,0000,0000,,...وجعل جرائمه المزيّفة في المخزن تنعكس
Dialogue: 0,0:16:37.77,0:16:41.17,Default,,0000,0000,0000,,بحيث أستطيع رؤيتها في الجناح الجنوبي
Dialogue: 0,0:16:41.96,0:16:44.71,Default,,0000,0000,0000,,ثمّ، الحادية عشرة والنصف من هذه الليلة
Dialogue: 0,0:16:45.00,0:16:48.78,Default,,0000,0000,0000,,استدعى الضحيّة لتلك الغرفة وقتله
Dialogue: 0,0:16:49.67,0:16:54.60,Default,,0000,0000,0000,,بنفس أسلوب تمثيله السابق، لكن بتطبيق فعليّ هذه المرّة
Dialogue: 0,0:16:54.78,0:16:58.16,Default,,0000,0000,0000,,ذلك ما شهدتُه وكونان
Dialogue: 0,0:16:58.16,0:17:02.11,Default,,0000,0000,0000,,لكن كيف يستطيع جعلكما\Nتشهدانها وفقما يريد؟
Dialogue: 0,0:17:02.11,0:17:08.07,Default,,0000,0000,0000,,لفعل ذلك، أتى القاتل لغرفتي وفتح الستائر
Dialogue: 0,0:17:08.07,0:17:13.03,Default,,0000,0000,0000,,وجعلني أتجرّع كميّة محسوبة\Nمن حبوب منوّمة
Dialogue: 0,0:17:13.03,0:17:17.88,Default,,0000,0000,0000,,فوق ذلك، ضبط ساعة التنبيه على\Nالحادية عشرة والنصف، وقت الجريمة
Dialogue: 0,0:17:18.49,0:17:22.86,Default,,0000,0000,0000,,ثمّ ضربني بأداة صلبة وأفقدني الوعي\Nبعدما هرعتُ لمسرح الجريمة
Dialogue: 0,0:17:23.07,0:17:26.03,Default,,0000,0000,0000,,وجعلني أمسك بالسكّين لترك بصماتي عليه
Dialogue: 0,0:17:26.03,0:17:28.13,Default,,0000,0000,0000,,!من فعل ذلك؟
Dialogue: 0,0:17:33.28,0:17:35.61,Default,,0000,0000,0000,,...أ-أيمكن أنّ الطبيب شيراي
Dialogue: 0,0:17:35.61,0:17:37.95,Default,,0000,0000,0000,,ذلك ما تريد قوله، صحيح يا موري-سان؟
Dialogue: 0,0:17:37.95,0:17:44.27,Default,,0000,0000,0000,,نعم، قاتل الطبيب إيتو كان أنت\N!يا طبيب شيراي
Dialogue: 0,0:17:44.27,0:17:48.12,Default,,0000,0000,0000,,لكن لديّ حجّة غياب يا موري-سان
Dialogue: 0,0:17:48.73,0:17:50.57,Default,,0000,0000,0000,,!ذلك صحيح يا موري-كن
Dialogue: 0,0:17:50.57,0:17:55.72,Default,,0000,0000,0000,,طلب من هذه الممرضة تسليم سجّلات\N!في ذاك الوقت وكلّمها
Dialogue: 0,0:17:56.01,0:17:58.07,Default,,0000,0000,0000,,!ولم يكن تسجيلاً
Dialogue: 0,0:17:58.07,0:18:00.03,Default,,0000,0000,0000,,كان هاتفه الخلويّ
Dialogue: 0,0:18:00.96,0:18:02.85,Default,,0000,0000,0000,,هاتف خلويّ؟
Dialogue: 0,0:18:02.85,0:18:09.95,Default,,0000,0000,0000,,أوّلاً، اتّصل الطبيب بهاتفه الخلويّ من غرفته\Nبعد الحادية عشرة بقليل
Dialogue: 0,0:18:09.95,0:18:13.98,Default,,0000,0000,0000,,وفعّل وضعية مكبّر الصوت، وذهب لغرفة\Nالجريمة في الجناح الشمالي
Dialogue: 0,0:18:14.86,0:18:18.57,Default,,0000,0000,0000,,قتل هناك الطبيب إيتو الذي استدعاه سلفاً
Dialogue: 0,0:18:18.57,0:18:23.43,Default,,0000,0000,0000,,واستعمل الجثّة لتمثيل الجريمة\Nعند الحادية عشرة والنصف
Dialogue: 0,0:18:23.43,0:18:28.93,Default,,0000,0000,0000,,ثمّ استعمل هاتفه الخلويّ للكلام\Nمع الممرضة عبر الهاتف الثابت
Dialogue: 0,0:18:33.85,0:18:38.11,Default,,0000,0000,0000,,ثمّ، عندما وصلتُ لمسرح الجريمة\Nضربني بأداة صلبة
Dialogue: 0,0:18:38.11,0:18:42.38,Default,,0000,0000,0000,,أفقدني الوعي، جعلني أمسك السكّين فأترك بصماتي
Dialogue: 0,0:18:42.87,0:18:47.25,Default,,0000,0000,0000,,بعدها، رجع لغرفته أثناء الفوضى
Dialogue: 0,0:18:47.25,0:18:49.71,Default,,0000,0000,0000,,وأطفأ الهاتف
Dialogue: 0,0:18:49.71,0:18:53.90,Default,,0000,0000,0000,,لا بدّ أنّه شعر بارتياح آنذاك\Nلظنّه أن كلّ شيء انتهى
Dialogue: 0,0:18:54.36,0:18:56.70,Default,,0000,0000,0000,,لكنّه ارتكب خطأً كبيراً في حساباته
Dialogue: 0,0:18:56.70,0:18:59.85,Default,,0000,0000,0000,,كان القهوة التي جلبتها الممرضة
Dialogue: 0,0:19:00.45,0:19:05.47,Default,,0000,0000,0000,,تعرفن جميعاً أنّ الطبيب شيراي\Nيحب السكّريات، صحيح؟
Dialogue: 0,0:19:05.81,0:19:10.02,Default,,0000,0000,0000,,لكنّ السكّر مع القهوة لم يُستعمل أبداً
Dialogue: 0,0:19:10.02,0:19:15.73,Default,,0000,0000,0000,,هذا دليل على أنّ الطبيب شيراي\Nلم يشرب القهوة
Dialogue: 0,0:19:16.18,0:19:20.80,Default,,0000,0000,0000,,سخافة، حتّى أنا أشربها دون سكّر أحياناً
Dialogue: 0,0:19:20.80,0:19:23.31,Default,,0000,0000,0000,,لن ينفع ذلك كدليل
Dialogue: 0,0:19:23.45,0:19:26.40,Default,,0000,0000,0000,,شربتها بالفعل إذاً؟
Dialogue: 0,0:19:26.83,0:19:30.42,Default,,0000,0000,0000,,نعم، لكن إذا كنت ستذكر\Nعدم وجود لعاب على الكأس
Dialogue: 0,0:19:30.42,0:19:33.70,Default,,0000,0000,0000,,فذلك لأنّي غسلته سريعاً غالباً
Dialogue: 0,0:19:33.70,0:19:36.03,Default,,0000,0000,0000,,هناك شيء آخر مفقود
Dialogue: 0,0:19:36.03,0:19:38.32,Default,,0000,0000,0000,,حقّاً؟ وما هو؟
Dialogue: 0,0:19:38.32,0:19:43.27,Default,,0000,0000,0000,,بصماتك، غير موجودة على الكأس
Dialogue: 0,0:19:43.27,0:19:45.77,Default,,0000,0000,0000,,...ذلك لأنّي غسلته
Dialogue: 0,0:19:46.23,0:19:52.69,Default,,0000,0000,0000,,لكنّ بصمات الممرضة التي جلبت\Nالقهوة موجودة على يد الكأس
Dialogue: 0,0:19:52.97,0:20:00.59,Default,,0000,0000,0000,,أتريد قول أنّك غسلت بصماتك فحسب\Nمن فوق بصماتها؟
Dialogue: 0,0:20:00.59,0:20:02.00,Default,,0000,0000,0000,,ذلك مستحيل
Dialogue: 0,0:20:02.00,0:20:08.63,Default,,0000,0000,0000,,أي أنّك عندما غسلت الكأس، كنت ترتدي قفّازات
Dialogue: 0,0:20:08.63,0:20:11.06,Default,,0000,0000,0000,,قفّازات جراحية استعملتها في ارتكابك الجريمة
Dialogue: 0,0:20:11.06,0:20:14.52,Default,,0000,0000,0000,,لمَ ظلّ مرتدياً القفّازات وقتها؟
Dialogue: 0,0:20:14.52,0:20:17.95,Default,,0000,0000,0000,,،عندما رجع لغرفته بعد ارتكاب الجريمة
Dialogue: 0,0:20:17.95,0:20:21.52,Default,,0000,0000,0000,,كان لا يزال يحمل السلاح\Nالذي ضربني به
Dialogue: 0,0:20:21.52,0:20:24.52,Default,,0000,0000,0000,,لا يمكنه السماح بأن تنتقل\Nبصماته له قبل تخلّصه منه
Dialogue: 0,0:20:24.94,0:20:30.02,Default,,0000,0000,0000,,بأيّ حال، بعدما رجعت لغرفتك\Nرأيت أنّ عليك سكب القهوة
Dialogue: 0,0:20:30.02,0:20:33.76,Default,,0000,0000,0000,,وإلا سيُشتبه بحجّة غيابك وكونك في الغرفة
Dialogue: 0,0:20:33.76,0:20:40.27,Default,,0000,0000,0000,,فسكبتها سريعاً وأنت ترتدي القفّازات\Nوغسلت الكأس
Dialogue: 0,0:20:40.86,0:20:43.29,Default,,0000,0000,0000,,لكن داخله فحسب
Dialogue: 0,0:20:43.81,0:20:49.43,Default,,0000,0000,0000,,لذلك بقيت بصمات الممرضة فحسب على الكأس
Dialogue: 0,0:20:49.73,0:20:52.78,Default,,0000,0000,0000,,قلتَ أنّك شربت القهوة
Dialogue: 0,0:20:52.78,0:20:58.23,Default,,0000,0000,0000,,أتوجد أسباب أخرى لعدم وجود\Nبصماتك على الكأس؟
Dialogue: 0,0:21:00.57,0:21:01.68,Default,,0000,0000,0000,,يا للسخرية
Dialogue: 0,0:21:01.68,0:21:06.68,Default,,0000,0000,0000,,تركتُ دليلاً بسبب قفّازات ارتديتها\Nكيلا أترك دليلاً
Dialogue: 0,0:21:06.68,0:21:08.77,Default,,0000,0000,0000,,تعترف إذاً؟
Dialogue: 0,0:21:08.77,0:21:11.30,Default,,0000,0000,0000,,كلّ شيء كان كما قاله موري-سان
Dialogue: 0,0:21:11.30,0:21:13.76,Default,,0000,0000,0000,,لمَ؟ ما كان دافعك؟
Dialogue: 0,0:21:13.76,0:21:18.09,Default,,0000,0000,0000,,سيُجبر كبير الجرّاحين في المشفى\Nعلى التقاعد الشهر المقبل
Dialogue: 0,0:21:18.09,0:21:22.72,Default,,0000,0000,0000,,كنتُ وإيتو المرشّحين لأخذ منصبه
Dialogue: 0,0:21:23.16,0:21:27.79,Default,,0000,0000,0000,,لكنّ إيتو ابتزني كي أستبعد نفسي
Dialogue: 0,0:21:27.79,0:21:30.92,Default,,0000,0000,0000,,لم يكن بيدي سوى الانصياع لطلبه
Dialogue: 0,0:21:31.45,0:21:36.09,Default,,0000,0000,0000,,فقد كان يعرف أنّي دخلت\Nكليّة الطب عبر الرشوة
Dialogue: 0,0:21:36.40,0:21:42.14,Default,,0000,0000,0000,,!والرشوة التي قدّمتُها للالتحاق كانت لوالده البروفسور
Dialogue: 0,0:21:42.73,0:21:47.91,Default,,0000,0000,0000,,لمَ دفعتُ تلك الرشوة ودخلتُ المجال بشكل غير شرعي؟
Dialogue: 0,0:21:48.34,0:21:55.01,Default,,0000,0000,0000,,أي أنّ الخداع والجريمة لا يعودان لك بشيء يا طبيب
Dialogue: 0,0:23:34.22,0:23:39.00,Default,,0000,0000,0000,,!يكفي! انتهيتُ من قصّة "كوغورو النائم" هذه
Dialogue: 0,0:23:39.97,0:23:43.55,Default,,0000,0000,0000,,!لمَ؟ حللتَ القضيّة ببراعة
Dialogue: 0,0:23:45.18,0:23:46.02,Default,,0000,0000,0000,,أنا؟
Dialogue: 0,0:23:46.02,0:23:46.94,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:23:48.12,0:23:53.47,Default,,0000,0000,0000,,!بالفعل إذاً! كوغورو النائم بصحّة وعافية
Dialogue: 0,0:23:54.44,0:23:56.65,Default,,0000,0000,0000,,...مُسن لا يتّعلم
Dialogue: 0,0:24:06.41,0:24:08.30,Default,,0000,0000,0000,,!سينسي! سونوكو
Dialogue: 0,0:24:09.10,0:24:11.55,Default,,0000,0000,0000,,،بعدما أُفقدت وعيها بالكلوروفورم
Dialogue: 0,0:24:11.55,0:24:13.93,Default,,0000,0000,0000,,!خُنقت بحبل
Dialogue: 0,0:24:14.34,0:24:16.14,Default,,0000,0000,0000,,!لا تزال هناك آثار أقدام
Dialogue: 0,0:24:17.09,0:24:18.39,Default,,0000,0000,0000,,...الباب الأمامي
Dialogue: 0,0:24:18.39,0:24:23.46,Default,,0000,0000,0000,,!ما يعني أنّ الفاعل... لا يزال داخل النزل
Dialogue: 0,0:24:24.11,0:24:30.11,On Top,,0000,0000,0000,,جريمة قتل نزل التزلّج\N(الجزء الأوّل)
Dialogue: 0,0:24:24.75,0:24:26.29,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:24:26.29,0:24:29.73,Default,,0000,0000,0000,,جريمة قتل نزل التزلّج\N(الجزء الأوّل)
Dialogue: 0,0:24:45.85,0:24:48.42,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:24:48.42,0:24:50.11,Default,,0000,0000,0000,,جهاز تدفئة
Dialogue: 0,0:24:50.11,0:24:52.10,Default,,0000,0000,0000,,الحلقة القادمة هي الجزء الأوّل\N...من قضيّة بـ
Dialogue: 0,0:24:52.10,0:24:54.10,Default,,0000,0000,0000,,♪ الجزء الأوّل ♪

