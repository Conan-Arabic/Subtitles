Dialogue: 0,0:00:01.09,0:00:06.89,Default,,0,0,0,,‫{\pos(960,825)\fad(450,0)\bord4.5\fs90\\b1}\N‫ ترجمة : ABOODY SUBS  \N‫Aoibu_Arabic : محاكاة\N‫X : @ABOODY_SUBS & X : @Aoibu_Arabic
Dialogue: 0,0:00:34.34,0:00:38.34,Default,,0,0,0,,‫تم إخلاء السكان في نطاق ثلاث بنايات.
Dialogue: 0,0:00:39.34,0:00:44.24,Default,,0,0,0,,‫بدأ تفكيك القنبلة في الموقع الأول الآن.
Dialogue: 0,0:00:47.84,0:00:50.04,Default,,0,0,0,,‫تم تفكيك القنبلة في الموقع الأول.
Dialogue: 0,0:00:50.94,0:00:52.34,Default,,0,0,0,,‫الخوذة مجهزة بقناة للتبريد
Dialogue: 0,0:00:52.34,0:00:56.14,Default,,0,0,0,,‫للتنفس تعمل أيضاً كمزيل للضباب على العدسة.
Dialogue: 0,0:00:56.14,0:00:59.44,Default,,0,0,0,,‫ونحن نتجه إلى الموقع الثاني مع الضابط ماتسودا.
Dialogue: 0,0:01:00.04,0:01:02.94,Default,,0,0,0,,‫للحماية من الهواء الساخن للانفجار،
Dialogue: 0,0:01:02.94,0:01:05.24,Default,,0,0,0,,‫تصميم البدلة لا يسمح بأي فتحات.
Dialogue: 0,0:01:05.24,0:01:09.74,Default,,0,0,0,,‫الجيوب في جميع أنحاء البدلة تحتوي على ألواح معدنية واقية.
Dialogue: 0,0:01:09.74,0:01:13.44,Default,,0,0,0,,‫البدلة معقدة جدًا لدرجة أنك لا تستطيع ارتدائها بنفسك.
Dialogue: 0,0:01:14.54,0:01:16.94,Default,,0,0,0,,‫وزنها 40 كيلوغرامًا.
Dialogue: 0,0:01:16.94,0:01:19.94,Default,,0,0,0,,‫في المعدات الواقية، تشعر وكأنك في ساونا حتى في الشتاء البارد.
Dialogue: 0,0:01:20.84,0:01:25.84,Default,,0,0,0,,‫لا يمكنك الاستمرار في ارتدائها لأكثر من خمس دقائق.
Dialogue: 0,0:01:25.84,0:01:27.54,Default,,0,0,0,,‫بل أنها مستحيلة.
Dialogue: 0,0:01:34.04,0:01:37.94,Default,,0,0,0,,‫إلى جميع وحدات الشرطة، إلى جميع وحدات الشرطة.
Dialogue: 0,0:01:37.94,0:01:43.44,Default,,0,0,0,,‫تفرقوا من المنطقة 1.
Dialogue: 0,0:01:43.44,0:01:46.44,Default,,0,0,0,,‫توجهوا لتأمين المنطقة 2...
Dialogue: 0,0:01:48.84,0:01:51.44,Default,,0,0,0,,‫إلى جميع الوحدات داخل حدود المدينة،
Dialogue: 0,0:01:51.44,0:01:54.64,Default,,0,0,0,,‫انتبهوا للمركبات المشبوهة.
Dialogue: 0,0:01:54.64,0:01:56.34,Default,,0,0,0,,‫هذا كل شيء.
Dialogue: 0,0:01:56.34,0:01:58.74,Default,,0,0,0,,‫وحدة دي سي 80، تلقينا.
Dialogue: 0,0:01:58.74,0:02:00.64,Default,,0,0,0,,‫وحدة إيه في، تلقينا.
Dialogue: 0,0:02:02.14,0:02:05.54,Default,,0,0,0,,‫ابقوا هادئين ومركزين.
Dialogue: 0,0:02:05.54,0:02:08.74,Default,,0,0,0,,‫من دون أمتعة، من فضلكم. أخلوا بسرعة وهدوء.
Dialogue: 0,0:02:08.74,0:02:11.84,Default,,0,0,0,,‫من فضلكم احرصوا على عدم دفع الآخرين.
Dialogue: 0,0:02:11.84,0:02:14.04,Default,,0,0,0,,‫لا داعي للاندفاع.
Dialogue: 0,0:02:42.04,0:02:45.04,Default,,0,0,0,,‫تم إخلاء سكان هذا المبنى.
Dialogue: 0,0:02:46.04,0:02:47.64,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:02:47.64,0:02:50.14,Default,,0,0,0,,‫حسنًا، لنبدأ...
Dialogue: 0,0:02:47.64,0:02:50.14,Default,,0,0,0,,‫{\pos(960,740)\fad(450,0)\bord4.5\fs120\b1}كينجي هاغيوارا\N‫ضابط في وحدة تفكيك القنابل في قسم الشغب بشرطة العاصمة
Dialogue: 0,0:02:50.14,0:02:52.14,Default,,0,0,0,,‫العمل عليه.
Dialogue: 0,0:03:02.24,0:03:05.14,Default,,0,0,0,,‫{\pos(960,740)\fad(450,0)\bord4.5\fs120\b1}جيمبي ماتسودا\N‫ضابط في وحدة تفكيك القنابل في قسم الشغب بشرطة العاصمة
Dialogue: 0,0:03:05.64,0:03:08.04,Default,,0,0,0,,‫لقد قمت بعمل جيد، ماتسودا.
Dialogue: 0,0:03:08.04,0:03:10.74,Default,,0,0,0,,‫كيف حال هاغيوارا؟
Dialogue: 0,0:03:10.74,0:03:14.74,Default,,0,0,0,,‫حسنًا، التحليل يُظهر زنادًا حساسًا للضوء.
Dialogue: 0,0:03:14.74,0:03:17.34,Default,,0,0,0,,‫سلك أبيض من مفتاح زئبقي.
Dialogue: 0,0:03:17.34,0:03:19.44,Default,,0,0,0,,‫من الشاشة الرقمية...
Dialogue: 0,0:03:19.44,0:03:21.64,Default,,0,0,0,,‫ماتسودا. ما الخطب؟
Dialogue: 0,0:03:21.64,0:03:25.44,Default,,0,0,0,,‫هاغيوارا! ما الذي يأخذك كل هذا الوقت؟
Dialogue: 0,0:03:25.44,0:03:27.54,Default,,0,0,0,,‫هيا، فكها بسرعة.
Dialogue: 0,0:03:27.54,0:03:30.44,Default,,0,0,0,,‫مهلا، مهلا، لا داعي للغضب.
Dialogue: 0,0:03:30.44,0:03:32.64,Default,,0,0,0,,‫أنت تجعل أصابعي ترتعش.
Dialogue: 0,0:03:32.64,0:03:34.34,Default,,0,0,0,,‫هل انتهيت بالفعل؟
Dialogue: 0,0:03:34.34,0:03:35.64,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:03:35.64,0:03:40.04,Default,,0,0,0,,‫فتحتها ووجدت أنها آلية بسيطة.
Dialogue: 0,0:03:40.04,0:03:41.24,Default,,0,0,0,,‫إنها بسيطة جدًا.
Dialogue: 0,0:03:41.24,0:03:44.34,Default,,0,0,0,,‫ثلاث دقائق كانت كافية؟
Dialogue: 0,0:03:47.44,0:03:50.24,Default,,0,0,0,,‫ماذا عنك؟
Dialogue: 0,0:03:50.24,0:03:53.44,Default,,0,0,0,,‫سيستغرق الأمر أكثر من 3 دقائق بالتأكيد.
Dialogue: 0,0:03:54.24,0:03:58.54,Default,,0,0,0,,‫تبدو بسيطة، لكن هناك الكثير من الفخاخ حولها.
Dialogue: 0,0:03:59.14,0:04:02.94,Default,,0,0,0,,‫أعتقد أن هذه هي الحقيقية.
Dialogue: 0,0:04:02.94,0:04:04.54,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:04:04.54,0:04:08.34,Default,,0,0,0,,‫بالمناسبة، أنت ترتدي بدلة التفجير الخاصة بك، أليس كذلك؟
Dialogue: 0,0:04:10.04,0:04:12.44,Default,,0,0,0,,‫لا أستطيع الحركة في ذلك الشيء، لم أكن لأرتديها...
Dialogue: 0,0:04:12.44,0:04:14.34,Default,,0,0,0,,‫أحمق!، هل تريد أن تقتل نفسك؟
Dialogue: 0,0:04:16.04,0:04:19.44,Default,,0,0,0,,‫حسنًا، إذا حدث ذلك، فسيكون عليك أن تنتقم لي.
Dialogue: 0,0:04:19.44,0:04:21.94,Default,,0,0,0,,‫انت تثير أعصابي.
Dialogue: 0,0:04:21.94,0:04:26.54,Default,,0,0,0,,‫أنا أمزح فقط، يا صديقي أنت تعرف أنني لن أخطئ بهذا الشكل.
Dialogue: 0,0:04:26.54,0:04:30.34,Default,,0,0,0,,‫على أي حال، أنهِ الأمر بأسرع ما يمكن وعد إلى هنا.
Dialogue: 0,0:04:30.34,0:04:33.24,Default,,0,0,0,,‫سأنتظرك في المكان المعتاد.
Dialogue: 0,0:04:33.24,0:04:34.74,Default,,0,0,0,,‫هذا جيد!
Dialogue: 0,0:04:34.74,0:04:36.34,Default,,0,0,0,,‫لقد جذبتني للعمل بأقصى سرعة.
Dialogue: 0,0:04:36.34,0:04:38.34,Default,,0,0,0,,‫سأعمل بأقصى سرعة.
Dialogue: 0,0:04:39.94,0:04:41.24,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:04:41.24,0:04:42.84,Default,,0,0,0,,‫ما الخطب، هاغيوارا؟
Dialogue: 0,0:04:44.54,0:04:46.74,Default,,0,0,0,,‫اهربوا، الجميع!
Dialogue: 0,0:04:46.74,0:04:49.24,Default,,0,0,0,,‫اخرجوا من هنا!
Dialogue: 0,0:04:49.24,0:04:50.74,Default,,0,0,0,,‫بدأ المؤقت من جديد!
Dialogue: 0,0:04:51.94,0:04:53.14,Default,,0,0,0,,‫هاغيوارا؟
Dialogue: 0,0:04:53.14,0:04:56.44,Default,,0,0,0,,‫أجب يا هاغيوارا!
Dialogue: 0,0:05:12.64,0:05:14.04,Default,,0,0,0,,‫هاغيوارا...
Dialogue: 0,0:05:22.24,0:05:26.64,Default,,0,0,0,,‫هاغيوارا!
Dialogue: 0,0:05:33.44,0:05:35.84,Default,,0,0,0,,‫كيف؟، كيف عرفت؟
Dialogue: 0,0:05:35.84,0:05:39.14,Default,,0,0,0,,‫سألت الصبي ذو النظارات.
Dialogue: 0,0:05:39.14,0:05:42.24,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:05:42.24,0:05:44.04,Default,,0,0,0,,‫بالمناسبة، شينيتشي،
Dialogue: 0,0:05:44.04,0:05:46.54,Default,,0,0,0,,‫ماذا ستفعل بخصوص امتحان المحاكاة الوطني؟
Dialogue: 0,0:05:46.54,0:05:47.84,Default,,0,0,0,,‫امتحان المحاكاة الوطني؟
Dialogue: 0,0:05:49.74,0:05:51.94,Default,,0,0,0,,‫لن تتمكن من الحضور، أليس كذلك؟
Dialogue: 0,0:05:51.94,0:05:57.14,Default,,0,0,0,,‫أراهن أنك ستقول أنك مشغول بقضية جديدة أو شيء من هذا القبيل.
Dialogue: 0,0:05:58.24,0:05:59.54,Default,,0,0,0,,‫انتظر! ما هذا؟
Dialogue: 0,0:05:59.54,0:06:03.14,Default,,0,0,0,,‫ كيف فعلت ذلك؟
Dialogue: 0,0:05:59.54,0:06:03.14,Top,,0,0,0,,‫ لقد حصلت على ملامحكِ انثاء نومكِ\N‫- المحقق الصغير 
Dialogue: 0,0:06:03.14,0:06:04.64,Default,,0,0,0,,‫أمسكتك!
Dialogue: 0,0:06:04.64,0:06:06.34,Default,,0,0,0,,‫تبا.
Dialogue: 0,0:06:22.19,0:06:24.52,DCOpening,,0,0,0,,‫لا يمكنني كبح حبي لك
Dialogue: 0,0:06:24.52,0:06:35.12,DCOpening,,0,0,0,,‫تحدثنا عن المستقبل وكأنني مقدر أن أكون بجانبك
Dialogue: 0,0:06:35.12,0:06:38.20,DCOpening,,0,0,0,,‫يا عزيزي، لا يمكنني كبح حبي لك
Dialogue: 0,0:06:38.20,0:06:41.37,DCOpening,,0,0,0,,‫سأصبح أي شيء من أجلك
Dialogue: 0,0:06:42.29,0:06:49.80,DCOpening,,0,0,0,,‫أعدك بأن أثق بيدي بين يديك بينما نمضي قدمًا
Dialogue: 0,0:06:50.59,0:06:57.60,DCOpening,,0,0,0,,‫لن أخبرك بكذبة مثل "أكرهك"
Dialogue: 0,0:06:57.60,0:07:04.14,DCOpening,,0,0,0,,‫ولكن أيضًا لن أقول "أحبك" لأنها ليست كذبة!
Dialogue: 0,0:07:05.35,0:07:08.65,DCOpening,,0,0,0,,‫لذا حتى عندما لا نكون معًا
Dialogue: 0,0:07:08.65,0:07:11.99,DCOpening,,0,0,0,,‫لن تكون حرًا في التفكير بأي شيء آخر
Dialogue: 0,0:07:11.99,0:07:17.53,DCOpening,,0,0,0,,‫لأنني أريد أن يكون قلبي كل ما يشغل بالك
Dialogue: 0,0:07:19.16,0:07:21.70,DCOpening,,0,0,0,,‫لا يمكنني كبح حبي لك
Dialogue: 0,0:07:21.70,0:07:28.79,DCOpening,,0,0,0,,‫لئلا يتباعد حبنا أبدًا
Dialogue: 0,0:07:28.79,0:07:31.09,DCOpening,,0,0,0,,‫لنعانق بعضنا ونصبح واحدًا
Dialogue: 0,0:07:32.13,0:07:39.26,DCOpening,,0,0,0,,‫ومع ذلك ستكون هناك ليالٍ أشعر فيها بعدم الارتياح
Dialogue: 0,0:07:39.26,0:07:47.98,DCOpening,,0,0,0,,‫لذا عندما يحين الوقت، لنتشبث ببعضنا بقوة أكبر
Dialogue: 0,0:07:57.58,0:08:00.88,Default,,0,0,0,,‫أبي، كونان!
Dialogue: 0,0:08:01.48,0:08:05.08,Default,,0,0,0,,‫أسرعوا. الإفطار جاهز!
Dialogue: 0,0:08:05.08,0:08:07.68,Default,,0,0,0,,‫أبي.
Dialogue: 0,0:08:07.68,0:08:10.48,Default,,0,0,0,,‫ما كل هذه الضجة من الصباح الباكر؟
Dialogue: 0,0:08:10.48,0:08:12.28,Default,,0,0,0,,‫إنه وقت الظهيرة بالفعل.
Dialogue: 0,0:08:12.28,0:08:18.48,Default,,0,0,0,,‫لقد وعدت سونوكو أن أدرس معها من أجل امتحان الغد، فانهي طعامك بسرعة.
Dialogue: 0,0:08:18.48,0:08:21.08,Default,,0,0,0,,‫هذه مشكلتك، وليست مشكلتي.
Dialogue: 0,0:08:21.08,0:08:25.98,Default,,0,0,0,,‫أنت تأخذ تقريرك إلى العميل، أليس كذلك؟
Dialogue: 0,0:08:25.98,0:08:27.68,Default,,0,0,0,,‫وانت يا كونان، لقد وعدت أيومي والآخرين
Dialogue: 0,0:08:27.68,0:08:30.58,Default,,0,0,0,,‫أنك ستذهب معهم إلى مركز هايدو للتسوق.
Dialogue: 0,0:08:32.08,0:08:33.38,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:08:33.38,0:08:35.78,Default,,0,0,0,,‫مركز هايدو للتسوق؟
Dialogue: 0,0:08:35.78,0:08:39.48,Default,,0,0,0,,‫انه ذلك المكان الذي به العجلة الكبيرة.
Dialogue: 0,0:08:39.48,0:08:40.88,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:08:42.68,0:08:45.58,Default,,0,0,0,,‫الاثنين، السادس من يناير.
Dialogue: 0,0:08:45.58,0:08:48.58,Default,,0,0,0,,‫كانت العطلة الشتوية على وشك الانتهاء.
Dialogue: 0,0:08:48.58,0:08:50.48,Default,,0,0,0,,‫بدأ ذلك اليوم بسلام شديد
Dialogue: 0,0:08:50.48,0:08:52.68,Default,,0,0,0,,‫لكن في اليومين التاليين تحولا إلى كابوس.
Dialogue: 0,0:08:54.38,0:08:59.98,Default,,0,0,0,,‫"‏مقر شرطة العاصمة المضطرب: 12 مليون رهينة"
Dialogue: 0,0:08:54.38,0:08:59.98,Default,,0,0,0,,‫{\fs120\pos(960,250)} مقر شرطة العاصمة المضطرب: 12 مليون رهينة
Dialogue: 0,0:09:07.78,0:09:11.78,Default,,0,0,0,,‫أنسة ساتو، ما رأيك في هذا التنكر الخاص بي؟
Dialogue: 0,0:09:12.38,0:09:14.08,Default,,0,0,0,,‫إنه رائع، أليس كذلك؟
Dialogue: 0,0:09:15.38,0:09:16.88,Default,,0,0,0,,‫أنسة ساتو؟
Dialogue: 0,0:09:16.88,0:09:18.58,Default,,0,0,0,,‫ هل هناك مشكلة؟
Dialogue: 0,0:09:23.88,0:09:25.88,Default,,0,0,0,,‫أنسة ساتو؟
Dialogue: 0,0:09:29.48,0:09:31.18,Default,,0,0,0,,‫ميواكو؟
Dialogue: 0,0:09:31.18,0:09:33.08,Default,,0,0,0,,‫يا ميواكو.
Dialogue: 0,0:09:33.08,0:09:34.68,Default,,0,0,0,,‫ميواكو!
Dialogue: 0,0:09:38.58,0:09:39.58,Default,,0,0,0,,‫يومي.
Dialogue: 0,0:09:39.58,0:09:42.58,Default,,0,0,0,,‫ما الأمر؟، تبدين غير مركزة.
Dialogue: 0,0:09:42.58,0:09:43.98,Default,,0,0,0,,‫أنا بخير.
Dialogue: 0,0:09:43.98,0:09:45.78,Default,,0,0,0,,‫أشعر بتعب بسيط، أعتقد.
Dialogue: 0,0:09:47.78,0:09:49.68,Default,,0,0,0,,‫سأخرج لبعض الوقت.
Dialogue: 0,0:09:49.68,0:09:53.48,Default,,0,0,0,,‫قلتِ أنكِ ستعملين على الأوراق طوال اليوم، اليوم.
Dialogue: 0,0:09:53.48,0:09:55.28,Default,,0,0,0,,‫هناك شيء ما يقلقني.
Dialogue: 0,0:09:57.18,0:09:59.88,Default,,0,0,0,,‫لا تنسى حفل الكاريوكي الليلة.
Dialogue: 0,0:09:59.88,0:10:02.48,Default,,0,0,0,,‫نعم. في أي وقت كان؟
Dialogue: 0,0:10:02.48,0:10:04.08,Default,,0,0,0,,‫التاسعة مساءً.
Dialogue: 0,0:10:04.08,0:10:06.78,Default,,0,0,0,,‫أرسلت بريدًا إلى هاتفكِ. يمكنكِ الاطلاع عليه.
Dialogue: 0,0:10:08.78,0:10:11.98,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:10:11.98,0:10:14.08,Default,,0,0,0,,‫آسفة، لقد حذفته بالفعل.
Dialogue: 0,0:10:14.08,0:10:18.28,Default,,0,0,0,,‫تبا، توقفِ عن حذف الرسائل فور قراءتها.
Dialogue: 0,0:10:18.28,0:10:23.48,Default,,0,0,0,,‫إذا لم أحذفهم، ستمتلئ رسائل بريدي سريعًا برسائل غير مهمة.
Dialogue: 0,0:10:23.48,0:10:25.68,Default,,0,0,0,,‫وأفقد الرسائل المهمة.
Dialogue: 0,0:10:25.68,0:10:30.08,Default,,0,0,0,,‫إذن، تقصدين أن رسالتي ليست مهمة.
Dialogue: 0,0:10:30.08,0:10:31.68,Default,,0,0,0,,‫اهدئي.
Dialogue: 0,0:10:31.68,0:10:32.88,Default,,0,0,0,,‫تبا.
Dialogue: 0,0:10:32.88,0:10:34.98,Default,,0,0,0,,‫حسنًا، أراكِ في التاسعة مساء.
Dialogue: 0,0:10:34.98,0:10:36.38,Default,,0,0,0,,‫لا تتأخري!
Dialogue: 0,0:10:36.38,0:10:37.78,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:10:43.78,0:10:46.18,Default,,0,0,0,,‫رسالة لا يمكنكِ حذفها...
Dialogue: 0,0:10:51.28,0:10:54.28,Top,,0,0,0,,‫مركز هايدو للتسوق
Dialogue: 0,0:10:55.48,0:10:57.08,Default,,0,0,0,,‫إنها عالية جدًا!
Dialogue: 0,0:10:58.48,0:11:01.08,Default,,0,0,0,,‫حقًا. رائع!
Dialogue: 0,0:11:01.08,0:11:04.98,Default,,0,0,0,,‫هذه العجلة العملاقة يبلغ ارتفاعها 125 مترًا.
Dialogue: 0,0:11:04.98,0:11:07.08,Default,,0,0,0,,‫إنها الأعلى في اليابان.
Dialogue: 0,0:11:08.08,0:11:10.88,Default,,0,0,0,,‫تستغرق 18 دقيقة لتدور دورة كاملة.
Dialogue: 0,0:11:10.88,0:11:13.28,Default,,0,0,0,,‫يمكنني صنع ستة أكواب من الرامن!
Dialogue: 0,0:11:14.18,0:11:16.58,Default,,0,0,0,,‫قطر الدائرة 105 أمتار
Dialogue: 0,0:11:16.58,0:11:19.58,Default,,0,0,0,,‫وتستغرق 18 دقيقة لتدور دورة كاملة.
Dialogue: 0,0:11:19.58,0:11:21.38,Default,,0,0,0,,‫هذا يعني أن سرعة هذه العربة
Dialogue: 0,0:11:21.38,0:11:24.68,Default,,0,0,0,,‫حوالي 30 سنتيمترًا في الثانية.
Dialogue: 0,0:11:24.68,0:11:29.18,Default,,0,0,0,,‫غريب، ألا يمكنكِ التفكير في أي شيء آخر؟
Dialogue: 0,0:11:29.18,0:11:34.48,Default,,0,0,0,,‫ مثل الطاقة اللازمة لتدور دورة كاملة؟
Dialogue: 0,0:11:35.68,0:11:36.98,Default,,0,0,0,,‫لا يهم.
Dialogue: 0,0:11:46.58,0:11:49.58,Default,,0,0,0,,‫لقد مرت ثلاث سنوات الآن.
Dialogue: 0,0:11:53.18,0:11:55.98,Default,,0,0,0,,‫جميعًا، دعوني أقدم...
Dialogue: 0,0:11:55.98,0:11:58.18,Default,,0,0,0,,‫السيد جيمبي ماتسودا.
Dialogue: 0,0:11:58.18,0:12:01.58,Default,,0,0,0,,‫سيبدأ العمل معنا اعتبارًا من اليوم
Dialogue: 0,0:12:01.58,0:12:03.88,Default,,0,0,0,,‫في قسم التحقيقات الجنائية.
Dialogue: 0,0:12:03.88,0:12:07.48,Default,,0,0,0,,‫كان يعمل في قسم الأمن، قوة المهام الخاصة،
Dialogue: 0,0:12:07.48,0:12:09.38,Default,,0,0,0,,‫وهو استثنائي جدًا.
Dialogue: 0,0:12:09.38,0:12:11.98,Default,,0,0,0,,‫كفى هراءً ايها المفتش.
Dialogue: 0,0:12:11.98,0:12:15.38,Default,,0,0,0,,‫أنا لست طفلًا جديدًا من الريف.
Dialogue: 0,0:12:15.38,0:12:17.28,Default,,0,0,0,,‫ولا أعتقد أن هذا العرض والحديث عني
Dialogue: 0,0:12:17.28,0:12:19.68,Default,,0,0,0,,‫سيكون مفيدًا لأي شخص.
Dialogue: 0,0:12:19.68,0:12:22.48,Default,,0,0,0,,‫وجدت نفسي حيث لا أريد أن أكون.
Dialogue: 0,0:12:22.48,0:12:24.38,Default,,0,0,0,,‫وأنا منزعج من ذلك.
Dialogue: 0,0:12:27.58,0:12:30.08,Default,,0,0,0,,‫حسنًا إذن، الضابطة ساتو!
Dialogue: 0,0:12:30.08,0:12:32.48,Default,,0,0,0,,‫ساعديه و...
Dialogue: 0,0:12:32.48,0:12:34.48,Default,,0,0,0,,‫أنا؟
Dialogue: 0,0:12:34.48,0:12:36.68,Default,,0,0,0,,‫لا تتهربي!
Dialogue: 0,0:12:36.68,0:12:38.48,Default,,0,0,0,,‫إنه هنا لأسباب معينة،
Dialogue: 0,0:12:38.48,0:12:41.38,Default,,0,0,0,,‫وطلبوا مني شخصيًا أن اهتم به.
Dialogue: 0,0:12:41.38,0:12:43.48,Default,,0,0,0,,‫هل ستهتمين به؟
Dialogue: 0,0:12:43.48,0:12:44.88,Default,,0,0,0,,‫حسناً.
Dialogue: 0,0:12:51.58,0:12:55.28,Default,,0,0,0,,‫أي نوع من الاستجواب كان ذلك؟
Dialogue: 0,0:12:55.28,0:12:57.48,Default,,0,0,0,,‫استجواب الناس مثل رجل عصابات هكذا،
Dialogue: 0,0:12:57.48,0:12:59.78,Default,,0,0,0,,‫لن يجيبك أحد.
Dialogue: 0,0:12:59.78,0:13:03.18,Default,,0,0,0,,‫تبا، لقد كنت معنا لمدة 6 أيام الآن.
Dialogue: 0,0:13:03.18,0:13:06.78,Default,,0,0,0,,‫لماذا لا تستمع إلي وتفعل كما أقول؟
Dialogue: 0,0:13:06.78,0:13:08.08,Default,,0,0,0,,‫هل لديك بريد؟
Dialogue: 0,0:13:08.08,0:13:09.68,Default,,0,0,0,,‫أنت سريع جدًا.
Dialogue: 0,0:13:09.68,0:13:11.18,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:13:11.18,0:13:14.38,Default,,0,0,0,,‫أنا فقط بارع بأصابعي.
Dialogue: 0,0:13:14.38,0:13:16.78,Default,,0,0,0,,‫هل تراسل صديقتك؟
Dialogue: 0,0:13:16.78,0:13:19.98,Default,,0,0,0,,‫لا. أرسل بريدًا إلى صديقي المفضل،
Dialogue: 0,0:13:19.98,0:13:23.78,Default,,0,0,0,,‫على الرغم من أنني أعلم أنه لن يرد علي
Dialogue: 0,0:13:23.78,0:13:26.58,Default,,0,0,0,,‫لأنه مات قبل 4 سنوات.
Dialogue: 0,0:13:26.58,0:13:27.88,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:13:31.98,0:13:34.98,Default,,0,0,0,,‫ماذا تقصد، أنك لن تذهب؟!
Dialogue: 0,0:13:34.98,0:13:38.88,Default,,0,0,0,,‫سأبقى في المقر اليوم.
Dialogue: 0,0:13:38.88,0:13:40.58,Default,,0,0,0,,‫أنا متأكد أنكم تستطيعون إحضار المشتبه به القديم
Dialogue: 0,0:13:40.58,0:13:44.08,Default,,0,0,0,,‫من الشرطة المحلية إلى هنا بدوني.
Dialogue: 0,0:13:44.08,0:13:45.68,Default,,0,0,0,,‫الآن، استمع إلي.
Dialogue: 0,0:13:45.68,0:13:47.48,Default,,0,0,0,,‫أنا أستمع.
Dialogue: 0,0:13:47.48,0:13:51.08,Default,,0,0,0,,‫تتلقون رسالة كل عام في السادس من يناير، أليس كذلك؟
Dialogue: 0,0:13:51.08,0:14:01.38,Default,,0,0,0,,‫تلك الرسالة المزيفة الذي تلقاه المقر الرئيسي على مدى السنوات الثلاث الماضية؟
Dialogue: 0,0:14:01.38,0:14:03.08,Default,,0,0,0,,‫تقصدين الرسالة التي تحمل رقمًا كبيرًا فقط، أليس كذلك؟
Dialogue: 0,0:14:03.08,0:14:04.58,Default,,0,0,0,,‫كان مكتوبًا عليه الرقم 3 قبل ثلاث سنوات؛
Dialogue: 0,0:14:04.58,0:14:06.18,Default,,0,0,0,,‫الرقم 2 قبل عامين،
Dialogue: 0,0:14:06.18,0:14:07.68,Default,,0,0,0,,‫والرقم 1 قبل عام.
Dialogue: 0,0:14:07.68,0:14:09.58,Default,,0,0,0,,‫أنا متأكد
Dialogue: 0,0:14:09.58,0:14:12.28,Default,,0,0,0,,‫أنه عد تنازلي لقنبلة موقوتة.
Dialogue: 0,0:14:12.28,0:14:15.08,Default,,0,0,0,,‫إذا كان سيحدث شيء، فسيكون اليوم.
Dialogue: 0,0:14:16.48,0:14:19.78,Default,,0,0,0,,‫أيها المفتش!، لقد تلقينا واحدة هذا العام أيضًا.
Dialogue: 0,0:14:19.78,0:14:23.18,Default,,0,0,0,,‫تلك الرسالة الذي تحمل رقمًا، تقصد.
Dialogue: 0,0:14:23.18,0:14:26.38,Default,,0,0,0,,‫إذن،  ما هو الرقم هذه المرة؟
Dialogue: 0,0:14:26.38,0:14:29.68,Default,,0,0,0,,‫إنه ليس رقمًا هذه المرة.
Dialogue: 0,0:14:30.78,0:14:33.08,Default,,0,0,0,,‫"أنا فارس من فرسان الطاولة المستديرة.
Dialogue: 0,0:14:33.08,0:14:36.28,Default,,0,0,0,,‫اوجه هذا الكلام إلى الشرطة الحمقى والضيقي الأفق.
Dialogue: 0,0:14:36.28,0:14:38.28,Default,,0,0,0,,‫اليوم عند الظهر، في الساعة الثانية ظهرا،
Dialogue: 0,0:14:38.28,0:14:39.58,Default,,0,0,0,,‫سأطلق ألعاًبا مسلية،
Dialogue: 0,0:14:39.58,0:14:42.48,Default,,0,0,0,,‫لتأبين رفيقي في القتال.
Dialogue: 0,0:14:42.48,0:14:45.08,Default,,0,0,0,,‫إذا أردتم إيقافها، تعالوا إلي.
Dialogue: 0,0:14:45.08,0:14:48.18,Default,,0,0,0,,‫لقد أعددنا المقعد الثاني والسبعين لكم سأكون بانتظاركم.
Dialogue: 0,0:14:49.28,0:14:50.88,Default,,0,0,0,,‫ماذا يعني هذا؟
Dialogue: 0,0:14:50.88,0:14:52.08,Default,,0,0,0,,‫لا أعرف.
Dialogue: 0,0:14:56.48,0:14:58.18,Default,,0,0,0,,‫مهلا!، إلى أين أنت ذاهب؟
Dialogue: 0,0:14:58.18,0:15:00.18,Default,,0,0,0,,‫إلى أي مكان آخر؟
Dialogue: 0,0:15:00.18,0:15:05.38,Default,,0,0,0,,‫فارس الطاولة المستديرة يقول أن هناك 72 مقعدًا.
Dialogue: 0,0:15:05.38,0:15:08.58,Default,,0,0,0,,‫إذا كانت مستديرة ولها 72 مقعدًا،
Dialogue: 0,0:15:08.58,0:15:11.78,Default,,0,0,0,,‫فهي العجلة العملاقة...
Dialogue: 0,0:15:11.78,0:15:14.18,Default,,0,0,0,,‫في مركز هايدو للتسوق.
Dialogue: 0,0:15:14.18,0:15:15.88,Default,,0,0,0,,‫من فضلك، تفضل.
Dialogue: 0,0:15:26.98,0:15:29.38,Default,,0,0,0,,‫تبا!، نحن متأخرون جدًا.
Dialogue: 0,0:15:29.38,0:15:32.88,Default,,0,0,0,,‫لكن الوقت متأخر عن الظهيرة بـ 30 دقيقة.
Dialogue: 0,0:15:34.28,0:15:36.58,Default,,0,0,0,,‫الشرطة. ماذا حدث؟
Dialogue: 0,0:15:36.58,0:15:39.98,Default,,0,0,0,,‫انفجرت غرفة التحكم في العجلة العملاقة فجأة.
Dialogue: 0,0:15:39.98,0:15:42.28,Default,,0,0,0,,‫لا يمكننا إيقاف العجلة.
Dialogue: 0,0:15:42.28,0:15:44.58,Default,,0,0,0,,‫نود إخراج الناس من العربات، لكن...
Dialogue: 0,0:15:44.58,0:15:47.88,Default,,0,0,0,,‫أين العربة 72 الآن؟
Dialogue: 0,0:15:47.88,0:15:49.48,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:15:49.48,0:15:52.08,Default,,0,0,0,,‫ستنزل قريبًا.
Dialogue: 0,0:15:57.78,0:15:59.48,Default,,0,0,0,,‫-ماتسودا! \N‫-ابتعدي!
Dialogue: 0,0:16:00.48,0:16:03.08,Default,,0,0,0,,‫الفارس لم يكن ينتظرنا،
Dialogue: 0,0:16:03.08,0:16:06.48,Default,,0,0,0,,‫لكن هناك شيء تحت المقعد.
Dialogue: 0,0:16:07.38,0:16:09.38,Default,,0,0,0,,‫ايعقل أنها... قنبلة؟
Dialogue: 0,0:16:09.38,0:16:11.98,Default,,0,0,0,,‫انتظر، ماتسودا!
Dialogue: 0,0:16:11.98,0:16:13.98,Default,,0,0,0,,‫ساكون بخير.
Dialogue: 0,0:16:13.98,0:16:16.38,Default,,0,0,0,,‫دعي محترف مثلي يتولى أمر هذا الشيء.
Dialogue: 0,0:16:19.48,0:16:21.68,Default,,0,0,0,,‫انتظر لحظة، ماتسودا!
Dialogue: 0,0:16:21.68,0:16:23.38,Default,,0,0,0,,‫ماذا تعني بكلمة محترف؟
Dialogue: 0,0:16:23.38,0:16:29.78,Default,,0,0,0,,‫حتى العام الماضي، كان عضوًا في فرقة المتفجرات في شرطة مكافحة الشغب.
Dialogue: 0,0:16:29.78,0:16:33.58,Default,,0,0,0,,‫إذن الصديق الذي كان يتحدث عنه والذي قال إنه توفي...
Dialogue: 0,0:16:33.58,0:16:38.38,Default,,0,0,0,,‫على الأرجح صديقه هاغيوارا من نفس الفريق،
Dialogue: 0,0:16:38.38,0:16:40.78,Default,,0,0,0,,‫الذي مات أثناء تأديته لواجبه وهو يتخلص من قنبلة،
Dialogue: 0,0:16:40.78,0:16:44.18,Default,,0,0,0,,‫قبل أربع سنوات، في 6 يناير.
Dialogue: 0,0:17:03.23,0:17:08.23,Default,,0,0,0,,‫تم وضع قنبلتين في موقعين منفصلين.
Dialogue: 0,0:17:08.23,0:17:10.83,Default,,0,0,0,,‫ماتسودا تخلص من قنبلة واحدة.
Dialogue: 0,0:17:10.83,0:17:14.13,Default,,0,0,0,,‫لكن هاغيوارا لم يكن لديه وقت كافٍ.
Dialogue: 0,0:17:14.13,0:17:17.43,Default,,0,0,0,,‫لم يتم التعرف على المفجر بعد.
Dialogue: 0,0:17:17.43,0:17:21.03,Default,,0,0,0,,‫طلب ماتسودا نقله إلى الفريق الخاص
Dialogue: 0,0:17:21.03,0:17:23.53,Default,,0,0,0,,‫الذي يحقق في قضية المفجر.
Dialogue: 0,0:17:24.33,0:17:27.93,Default,,0,0,0,,‫استمر في طلب النقل، لكن تم رفضه.
Dialogue: 0,0:17:27.93,0:17:29.43,Default,,0,0,0,,‫بما أنهم اعتقدوا يريد الانتقام لصديقه
Dialogue: 0,0:17:29.43,0:17:31.83,Default,,0,0,0,,‫اختاروا نقله، حتى يهدأ،
Dialogue: 0,0:17:31.83,0:17:34.13,Default,,0,0,0,,‫وأرسلوه إلى قسمنا.
Dialogue: 0,0:17:34.13,0:17:36.93,Default,,0,0,0,,‫ايها المفتش، ماذا سنفعل؟
Dialogue: 0,0:17:36.93,0:17:40.13,Default,,0,0,0,,‫لم يتبق سوى ست دقائق حتى الظهيرة.
Dialogue: 0,0:17:40.13,0:17:44.13,Default,,0,0,0,,‫ستستغرق العربة 10 دقائق أخرى لتدور دورة كاملة وتعود.
Dialogue: 0,0:17:45.53,0:17:49.93,Default,,0,0,0,,‫ليس لدينا خيار سوى ترك الأمر لماتسودا.
Dialogue: 0,0:18:05.13,0:18:06.33,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:18:09.63,0:18:10.73,Default,,0,0,0,,‫توقفت.
Dialogue: 0,0:18:11.53,0:18:13.03,Default,,0,0,0,,‫أطفئوا الحريق بسرعة!
Dialogue: 0,0:18:14.23,0:18:17.43,Default,,0,0,0,,‫هذه مشكلة.
Dialogue: 0,0:18:22.33,0:18:25.43,Default,,0,0,0,,‫مرحبًا!، ماتسودا؟، هل أنت بخير؟
Dialogue: 0,0:18:25.43,0:18:26.73,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:18:26.73,0:18:31.03,Default,,0,0,0,,‫لكن مع الصدمة الآن، تم تشغيل مفتاح غريب.
Dialogue: 0,0:18:31.03,0:18:32.13,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:18:32.13,0:18:33.73,Default,,0,0,0,,‫رافعة الزئبق.
Dialogue: 0,0:18:33.73,0:18:35.83,Default,,0,0,0,,‫رافعة الزئبق؟
Dialogue: 0,0:18:35.83,0:18:38.93,Default,,0,0,0,,‫هزة بسيطة يمكن أن تجعل قطرة الزئبق تتدحرج،
Dialogue: 0,0:18:38.93,0:18:41.13,Default,,0,0,0,,‫وإذا لامست القطرة السلك، ينتهي كل شيء.
Dialogue: 0,0:18:42.43,0:18:44.73,Default,,0,0,0,,‫إذا كنتِ لا تريدين أن ترانين أنفجر،
Dialogue: 0,0:18:44.73,0:18:48.53,Default,,0,0,0,,‫أبقِ العربة ثابتة حتى أتخلص من هذه القنبلة.
Dialogue: 0,0:18:48.53,0:18:52.93,Default,,0,0,0,,‫لكن لم يتبق سوى أقل من خمس دقائق حتى الانفجار.
Dialogue: 0,0:18:54.53,0:18:57.83,Default,,0,0,0,,‫ثلاث دقائق ستكون أكثر من كافية لمثل هذا الجهاز.
Dialogue: 0,0:18:58.83,0:19:01.43,Top,,0,0,0,,‫"إلى ضابط الشرطة الشجاع..."
Dialogue: 0,0:19:01.43,0:19:03.93,Default,,0,0,0,,‫"إلى ضابط الشرطة الشجاع.
Dialogue: 0,0:19:03.93,0:19:06.53,Default,,0,0,0,,‫تقديرًا لشجاعتك، سنمنحك جائزة."
Dialogue: 0,0:19:06.53,0:19:09.43,Default,,0,0,0,,‫انتظر، ما الذي تتحدث عنه؟
Dialogue: 0,0:19:09.43,0:19:15.63,Default,,0,0,0,,‫"دليل على مكان الألعاب النارية الثانية الأكبر"
Dialogue: 0,0:19:15.63,0:19:17.93,Default,,0,0,0,,‫قبل 3 ثوانٍ من الانفجار،
Dialogue: 0,0:19:17.93,0:19:19.43,Default,,0,0,0,,‫ حظًا موفقًا."
Dialogue: 0,0:19:20.43,0:19:25.03,Default,,0,0,0,,‫هذه هي الكلمات المعروضة على لوحة العرض الآن.
Dialogue: 0,0:19:25.03,0:19:28.93,Default,,0,0,0,,‫أعتقد أنه إذا أوقفنا القنبلة وأطفأنا الطاقة،
Dialogue: 0,0:19:28.93,0:19:31.43,Default,,0,0,0,,‫لن نتمكن أبدًا من قراءة الدليل مرة أخرى.
Dialogue: 0,0:19:32.53,0:19:36.43,Default,,0,0,0,,‫أي أن الرجل قصد وضع شخص ما في هذه العربة
Dialogue: 0,0:19:36.43,0:19:39.43,Default,,0,0,0,,‫وعرض هذه الكلمات عليه.
Dialogue: 0,0:19:39.43,0:19:41.93,Default,,0,0,0,,‫إذن، تم تشغيل الانفجار
Dialogue: 0,0:19:41.93,0:19:45.43,Default,,0,0,0,,‫لأن المفجر رأئك تدخل العربة.
Dialogue: 0,0:19:45.43,0:19:48.03,Default,,0,0,0,,‫بمعنى آخر، المفجر موجود في مكان قريب.
Dialogue: 0,0:19:48.93,0:19:52.63,Default,,0,0,0,,‫من الصعب جدًا التعرف عليه من بين هذا الحشد من الناس.
Dialogue: 0,0:19:53.43,0:19:56.23,Default,,0,0,0,,‫لكن يمكنني تخمين مكان القنبلة الأخرى.
Dialogue: 0,0:19:57.73,0:20:01.73,Default,,0,0,0,,‫الفاكس يقول، "ثار زميلنا الفارس."
Dialogue: 0,0:20:01.73,0:20:05.03,Default,,0,0,0,,‫فرسان الطاولة المستديرة كانوا من أوروبا في العصور الوسطى.
Dialogue: 0,0:20:05.03,0:20:09.23,Default,,0,0,0,,‫وهؤلاء الفرسان في العصور الوسطى كانوا يرتدون خوذات مصممة بصليب في المقدمة.
Dialogue: 0,0:20:09.23,0:20:10.93,Default,,0,0,0,,‫أصبح الأمر واضحًا الآن، أليس كذلك؟
Dialogue: 0,0:20:10.93,0:20:12.63,Default,,0,0,0,,‫علامة رسمية لمستشفى؟
Dialogue: 0,0:20:12.63,0:20:14.03,Default,,0,0,0,,‫ صحيح.
Dialogue: 0,0:20:14.03,0:20:17.33,Default,,0,0,0,,‫سأخبرك بأي مستشفى بعد أن أقرأ الدليل.
Dialogue: 0,0:20:17.33,0:20:19.23,Default,,0,0,0,,‫ستخبرني بعد أن تقرأه؟
Dialogue: 0,0:20:19.23,0:20:21.13,Default,,0,0,0,,‫لكن الدليل يظهر قبل 3 ثوانٍ فقط.
Dialogue: 0,0:20:21.13,0:20:24.13,Default,,0,0,0,,‫حسنًا، البطارية على وشك النفاد.
Dialogue: 0,0:20:24.13,0:20:25.33,Default,,0,0,0,,‫وداعًا الآن.
Dialogue: 0,0:20:26.63,0:20:29.23,Default,,0,0,0,,‫ماتسودا...
Dialogue: 0,0:20:30.23,0:20:32.43,Default,,0,0,0,,‫ماتسودا...
Dialogue: 0,0:20:45.53,0:20:48.53,Default,,0,0,0,,‫اسمح لي اليوم فقط.
Dialogue: 0,0:20:49.43,0:20:52.03,Default,,0,0,0,,‫ لا. لم يتبق سوى دقيقة واحدة.
Dialogue: 0,0:20:52.03,0:20:54.03,Default,,0,0,0,,‫جميعًا! اخرجوا من هنا!
Dialogue: 0,0:20:54.03,0:20:55.33,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:20:57.63,0:20:58.63,Default,,0,0,0,,‫ماتسودا!
Dialogue: 0,0:20:58.63,0:21:01.13,Default,,0,0,0,,‫اسرعي، ساتو! لقد فات الأوان!
Dialogue: 0,0:21:01.13,0:21:03.03,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:21:08.83,0:21:10.63,Default,,0,0,0,,‫ ابتعدوا، من فضلكم!
Dialogue: 0,0:21:10.63,0:21:11.93,Default,,0,0,0,,‫لكنه لا يزال هناك!
Dialogue: 0,0:21:14.63,0:21:15.93,Default,,0,0,0,,‫إنه بالداخل!
Dialogue: 0,0:21:19.23,0:21:21.93,Default,,0,0,0,,‫آسف، هاغيوارا.
Dialogue: 0,0:21:21.93,0:21:24.03,Default,,0,0,0,,‫أعتقد أنني لم أستطع الوفاء بعهدي.
Dialogue: 0,0:21:39.73,0:21:40.73,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:21:40.73,0:21:45.13,Default,,0,0,0,,‫ماذا سنفعل؟، الفاكس يقول أن هناك قنبلة أخرى.
Dialogue: 0,0:21:45.13,0:21:47.83,Default,,0,0,0,,‫أعرف ذلك!
Dialogue: 0,0:21:47.83,0:21:49.93,Default,,0,0,0,,‫مستشفى بيكا المركزي.
Dialogue: 0,0:21:49.93,0:21:51.13,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:21:51.13,0:21:53.63,Default,,0,0,0,,‫مستشفى بيكا المركزي.
Dialogue: 0,0:21:53.63,0:21:55.73,Default,,0,0,0,,‫القنبلة الأخرى هناك!
Dialogue: 0,0:21:55.73,0:21:58.63,Default,,0,0,0,,‫أرسلوا فريق من القنابل على الفور!
Dialogue: 0,0:22:04.23,0:22:07.53,Default,,0,0,0,,‫كان مثل نسيم.
Dialogue: 0,0:22:18.23,0:22:20.83,Default,,0,0,0,,‫اختفى في لحظة.
Dialogue: 0,0:22:20.83,0:22:23.03,Default,,0,0,0,,‫كل ما تبقى هو الصوت الحزين.
Dialogue: 0,0:22:26.43,0:22:28.63,Default,,0,0,0,,‫الضابطة ساتو!
Dialogue: 0,0:22:28.63,0:22:30.93,Default,,0,0,0,,‫انتم.
Dialogue: 0,0:22:30.93,0:22:35.13,Default,,0,0,0,,‫لم أكن أعرف أن مثل هذا الشيء حدث قبل ثلاث سنوات.
Dialogue: 0,0:22:35.13,0:22:36.33,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:22:36.33,0:22:40.23,Default,,0,0,0,,‫إذا كانت ساتو لا تزال تحتفظ بذكريات عن الحادث،
Dialogue: 0,0:22:40.23,0:22:42.33,Default,,0,0,0,,‫ليس لدينا فرصة.
Dialogue: 0,0:22:42.33,0:22:44.53,Default,,0,0,0,,‫أعتقد ذلك.
Dialogue: 0,0:22:44.53,0:22:49.73,Default,,0,0,0,,‫إذا كنت تريد أن تكون مثله، يمكنك أن تموت أثناء أداء واجبك.
Dialogue: 0,0:22:49.73,0:22:54.03,Default,,0,0,0,,‫مهلا!، لا تقل أشياء كهذه.
Dialogue: 0,0:22:54.03,0:22:56.23,Default,,0,0,0,,‫ إنها انسة ساتو.
Dialogue: 0,0:22:56.23,0:22:59.03,Default,,0,0,0,,‫تاكاغي وشيراتوري.
Dialogue: 0,0:22:59.03,0:23:00.63,Default,,0,0,0,,‫ما الخطب؟
Dialogue: 0,0:23:00.63,0:23:02.13,Default,,0,0,0,,‫كونان والأطفال هنا أيضًا.
Dialogue: 0,0:23:02.13,0:23:04.73,Default,,0,0,0,,‫لقد صادفتهم بالصدفة.
Dialogue: 0,0:23:04.73,0:23:07.13,Default,,0,0,0,,‫لأنني ممتنّة لهم لمساعدتهم في حل القضية الاخيرة،
Dialogue: 0,0:23:07.13,0:23:10.03,Default,,0,0,0,,‫سأحضر لهم الحلوى أو شيء ما.
Dialogue: 0,0:23:10.03,0:23:12.23,Default,,0,0,0,,‫كل الكعك الذي نستطيع أكله.
Dialogue: 0,0:23:12.23,0:23:13.93,Default,,0,0,0,,‫وما الذي أتى بكم إلى هنا؟
Dialogue: 0,0:23:13.93,0:23:17.73,Default,,0,0,0,,‫لقد تلقينا إبلاغًا.
Dialogue: 0,0:23:17.73,0:23:20.63,Default,,0,0,0,,‫بحثنا داخل هذا المطعم،
Dialogue: 0,0:23:20.63,0:23:22.33,Default,,0,0,0,,‫لكن لم يظهر شيء.
Dialogue: 0,0:23:22.33,0:23:25.33,Default,,0,0,0,,‫من المحتمل أن يكون بلاغًا كاذبًا.
Dialogue: 0,0:23:25.33,0:23:28.63,Default,,0,0,0,,‫حسنًا، إذن، سأذهب إلى حفل الكاريوكي مع يومي هذا المساء.
Dialogue: 0,0:23:28.63,0:23:29.83,Default,,0,0,0,,‫هل ترغبون في الانضمام إلينا؟
Dialogue: 0,0:23:29.83,0:23:32.53,Default,,0,0,0,,‫ماذا؟، بالطبع نرغب.
Dialogue: 0,0:23:32.53,0:23:35.13,Default,,0,0,0,,‫حسنًا، اذهبوا بدوني.
Dialogue: 0,0:23:36.43,0:23:38.93,Default,,0,0,0,,‫لست في مزاج جيد اليوم.
Dialogue: 0,0:23:38.93,0:23:41.43,Default,,0,0,0,,‫لذا سأعتذر.
Dialogue: 0,0:23:41.43,0:23:43.23,Default,,0,0,0,,‫هيا، دعونا نسرع ونذهب.
Dialogue: 0,0:23:43.23,0:23:44.23,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:23:44.23,0:23:47.23,Default,,0,0,0,,‫أخبرني، ما نوع الإبلاغ الذي كان؟
Dialogue: 0,0:23:47.23,0:23:50.53,Default,,0,0,0,,‫نعم. كانت مكالمة هاتفية، تحذير،
Dialogue: 0,0:23:50.53,0:23:52.53,Default,,0,0,0,,‫أن قنبلة مزروعة في هذا المطعم.
Dialogue: 0,0:23:57.63,0:23:59.13,Default,,0,0,0,,‫اليوم هو 6 يناير.
Dialogue: 0,0:23:59.13,0:24:03.03,Default,,0,0,0,,‫نفس يوم التفجير قبل 7 سنوات و 3 سنوات.
Dialogue: 0,0:24:03.03,0:24:05.43,Default,,0,0,0,,‫لذا، جئنا وتحققنا.
Dialogue: 0,0:24:05.43,0:24:08.83,Default,,0,0,0,,‫تحذير بوجود قنبلة، بلاغ كاذب...
Dialogue: 0,0:24:08.83,0:24:10.23,Top,,0,0,0,,‫"أنا لاعب في الدوري الرئيسي، رامٍ قوي وضارب أيضًا."
Dialogue: 0,0:24:10.23,0:24:11.23,Default,,0,0,0,,‫"الآن، هذه بداية الشوط الثاني."
Dialogue: 0,0:24:12.83,0:24:14.33,Default,,0,0,0,,‫ايعقل...
Dialogue: 0,0:24:20.73,0:24:22.13,Default,,0,0,0,,‫شيراتوري!
Dialogue: 0,0:24:30.88,0:24:32.18,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:24:32.18,0:24:33.88,Default,,0,0,0,,‫تفجير، مرة أخرى؟
Dialogue: 0,0:24:33.88,0:24:35.68,Default,,0,0,0,,‫شيراتوري!
Dialogue: 0,0:24:39.08,0:24:40.38,Default,,0,0,0,,‫شيراتوري!
Dialogue: 0,0:24:41.38,0:24:42.98,Default,,0,0,0,,‫شيراتوري!
Dialogue: 0,0:24:43.88,0:24:45.58,Default,,0,0,0,,‫المكان خطير.
Dialogue: 0,0:24:45.58,0:24:48.38,Default,,0,0,0,,‫اخرجوا من هنا، بسرعة.
Dialogue: 0,0:24:48.38,0:24:52.38,Default,,0,0,0,,‫هل أنت بخير، سيد شيراتوري؟
Dialogue: 0,0:24:52.38,0:24:58.88,Default,,0,0,0,,‫نعم. لكنني لست جيدًا مثلك في تفادي الانفجارات...
Dialogue: 0,0:24:58.88,0:25:02.78,Default,,0,0,0,,‫تاكاغي!، أغلق هذا الطريق واستدعي على سيارة إسعاف.
Dialogue: 0,0:25:02.78,0:25:04.58,Default,,0,0,0,,‫حسناً.
Dialogue: 0,0:25:04.58,0:25:09.08,Default,,0,0,0,,‫لكنه يستطيع الكلام، هذا يعني أنه بخير.
Dialogue: 0,0:25:09.08,0:25:12.48,Default,,0,0,0,,‫لا. إنه ينزف من جانب رأسه،
Dialogue: 0,0:25:12.48,0:25:14.78,Default,,0,0,0,,‫مع شلل في الأطراف اليسرى.
Dialogue: 0,0:25:14.78,0:25:16.18,Default,,0,0,0,,‫هذا يمكن أن يكون...
Dialogue: 0,0:25:16.18,0:25:18.78,Default,,0,0,0,,‫نزيف تحت الجافية الحاد.
Dialogue: 0,0:25:20.08,0:25:23.38,Default,,0,0,0,,‫من الأفضل أن نأخذه إلى المستشفى في أسرع وقت ممكن، وإلا سيكون في ورطة كبيرة.
Dialogue: 0,0:25:23.38,0:25:25.18,Default,,0,0,0,,‫مستحيل.
Dialogue: 0,0:25:25.18,0:25:27.38,Default,,0,0,0,,‫على أي حال، إذا اشتعلت الغازات،
Dialogue: 0,0:25:27.38,0:25:29.38,Default,,0,0,0,,‫قد تسبب انفجارًا ثانويًا.
Dialogue: 0,0:25:29.38,0:25:30.88,Default,,0,0,0,,‫لننقل المفتش شيراتوري بعيدًا عن السيارة
Dialogue: 0,0:25:30.88,0:25:34.08,Default,,0,0,0,,‫حتى تصل سيارة الإسعاف.
Dialogue: 0,0:25:34.08,0:25:35.18,Default,,0,0,0,,‫نعم، لنفعل ذلك.
Dialogue: 0,0:25:38.18,0:25:40.78,Default,,0,0,0,,‫هذا فظيع. حقًا فظيع.
Dialogue: 0,0:25:40.78,0:25:44.58,Default,,0,0,0,,‫نعم. من يمكنه فعل شيء كهذا؟
Dialogue: 0,0:25:44.58,0:25:46.58,Default,,0,0,0,,‫لا أعرف من هو المفجر،
Dialogue: 0,0:25:46.58,0:25:49.48,Default,,0,0,0,,‫لكنني متأكد أنه يستهدف ضابط شرطة.
Dialogue: 0,0:25:49.48,0:25:50.48,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:25:50.48,0:25:53.78,Default,,0,0,0,,‫أعطى إنذارًا كاذبًا بوجود قنبلة في المطعم،
Dialogue: 0,0:25:53.78,0:25:55.58,Default,,0,0,0,,‫وجذب الشرطة إلى الداخل.
Dialogue: 0,0:25:55.58,0:25:58.18,Default,,0,0,0,,‫بينما كان الضباط يبحثون عن القنبلة،
Dialogue: 0,0:25:58.18,0:26:01.78,Default,,0,0,0,,‫زرع القنبلة الحقيقية في السيارة،
Dialogue: 0,0:26:01.78,0:26:03.68,Default,,0,0,0,,‫مختبئًا بين الزبائن
Dialogue: 0,0:26:03.68,0:26:06.68,Default,,0,0,0,,‫الذين أُخرجوا من المطعم.
Dialogue: 0,0:26:06.68,0:26:08.18,Default,,0,0,0,,‫من ما رأيته،
Dialogue: 0,0:26:08.18,0:26:09.88,Default,,0,0,0,,‫آلية الزناد تعمل
Dialogue: 0,0:26:09.88,0:26:12.98,Default,,0,0,0,,‫بحيث ينطلق دبوس الأمان عند فتح الباب أول مرة.
Dialogue: 0,0:26:12.98,0:26:15.58,Default,,0,0,0,,‫وعند فتح الباب مرة أخرى للخروج،
Dialogue: 0,0:26:15.58,0:26:17.18,Default,,0,0,0,,‫تنفجر القنبلة.
Dialogue: 0,0:26:17.98,0:26:18.98,Default,,0,0,0,,‫السؤال هو،
Dialogue: 0,0:26:18.98,0:26:22.38,Default,,0,0,0,,‫لماذا حاول المفتش شيراتوري الخروج فورًا؟
Dialogue: 0,0:26:23.88,0:26:26.68,Default,,0,0,0,,‫هذا...
Dialogue: 0,0:26:26.68,0:26:27.78,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:26:27.78,0:26:31.18,Default,,0,0,0,,‫أردت أن أريكِ هذا في أقرب وقت ممكن.
Dialogue: 0,0:26:32.08,0:26:35.88,Default,,0,0,0,,‫الذكرى التي تحملينها بداخلك ولا تستطيعين محوها...
Dialogue: 0,0:26:35.88,0:26:39.48,Default,,0,0,0,,‫هذه فرصة للتخلص منها.
Dialogue: 0,0:26:42.88,0:26:45.68,Default,,0,0,0,,‫"أنا لاعب في الدوري الرئيسي، رامٍ قوي وضارب أيضًا."
Dialogue: 0,0:26:45.68,0:26:48.18,Default,NTP,0,0000,0000,0000,‫"الآن، هذه بداية الاشواط الاضافية."
Dialogue: 0,0:26:48.18,0:26:51.08,Default,NTP,0,0000,0000,0000,‫"تبدأ المباراة عند الظهيرة غدًا."
Dialogue: 0,0:26:51.08,0:26:53.48,Default,,0,0,0,,‫"وتنتهي عند الثالثة عصرًا."
Dialogue: 0,0:26:53.48,0:26:57.18,Default,,0,0,0,,‫"لا فائدة من إعداد حارس مرمى جيد."
Dialogue: 0,0:26:57.18,0:26:59.48,Default,,0,0,0,,‫"لأنني سأفوز في النهاية."
Dialogue: 0,0:26:59.48,0:27:03.38,Default,,0,0,0,,‫"وإذا أردتم إيقاف المباراة، فتعالوا إليّ."
Dialogue: 0,0:27:03.38,0:27:05.08,Default,,0,0,0,,‫"سأنتظركم"
Dialogue: 0,0:27:05.08,0:27:11.38,Default,,0,0,0,,‫"لتسلق التلة الدموية في صندوق الضارب الفولاذي."
Dialogue: 0,0:27:11.38,0:27:13.18,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:27:13.18,0:27:14.48,Default,,0,0,0,,‫إنه...
Dialogue: 0,0:27:14.48,0:27:16.38,Default,,0,0,0,,‫مهلا.
Dialogue: 0,0:27:16.38,0:27:17.88,Default,,0,0,0,,‫ايعقل...
Dialogue: 0,0:27:17.88,0:27:19.68,Default,,0,0,0,,‫هذا هو...
Dialogue: 0,0:27:19.68,0:27:21.88,Default,,0,0,0,,‫"أنا فارس من فرسان الطاولة المستديرة."
Dialogue: 0,0:27:21.88,0:27:24.98,Default,,0,0,0,,‫"اوجه هذا الكلام إلى الشرطة الحمقى و..."
Dialogue: 0,0:27:24.98,0:27:27.28,Default,,0,0,0,,‫دعي محترف مثلي يتولى أمر هذا الشيء.
Dialogue: 0,0:27:34.28,0:27:35.98,Default,,0,0,0,,‫إنه هو.
Dialogue: 0,0:27:35.98,0:27:37.88,Default,,0,0,0,,‫لقد عاد مرة أخرى.
Dialogue: 0,0:27:48.78,0:27:51.18,Default,,0,0,0,,‫حقًا؟
Dialogue: 0,0:27:51.18,0:27:54.68,Default,,0,0,0,,‫هل تعرض شيراتوري لانفجار؟
Dialogue: 0,0:27:54.68,0:27:55.88,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:27:55.88,0:27:59.78,Default,,0,0,0,,‫نُقل بواسطة الإسعاف إلى مستشفى قريب للتو.
Dialogue: 0,0:27:59.78,0:28:01.28,Default,,0,0,0,,‫أصيب بجروح خطيرة.
Dialogue: 0,0:28:01.28,0:28:04.18,Default,,0,0,0,,‫ما هو الوضع هناك؟
Dialogue: 0,0:28:04.18,0:28:08.08,Default,,0,0,0,,‫نفس الفاكس بنفس الكلمات التي أخبرتني بها للتو.
Dialogue: 0,0:28:08.08,0:28:09.78,Default,,0,0,0,,‫تم إرسال نفس الفاكسات إلى
Dialogue: 0,0:28:09.78,0:28:11.68,Default,,0,0,0,,‫جميع أقسام الشرطة في العاصمة.
Dialogue: 0,0:28:11.68,0:28:14.08,Default,,0,0,0,,‫كلهم منزعجون من الفاكس.
Dialogue: 0,0:28:14.08,0:28:16.78,Default,,0,0,0,,‫هناك احتمال أنه نفس الشخص
Dialogue: 0,0:28:16.78,0:28:20.28,Default,,0,0,0,,‫المسؤول عن التفجيرات قبل 7 سنوات و 3 سنوات.
Dialogue: 0,0:28:20.28,0:28:23.78,Default,,0,0,0,,‫لا شك في ذلك. إنه من المفجر.
Dialogue: 0,0:28:23.78,0:28:26.18,Default,,0,0,0,,‫أخبر المدير ماتسوموتو بذلك.
Dialogue: 0,0:28:27.08,0:28:32.18,Default,,0,0,0,,‫فقط النصف الأول من الفاكس من ثلاث سنوات مضت كان معروفًا للعامة.
Dialogue: 0,0:28:32.18,0:28:35.38,Default,,0,0,0,,‫لا يمكن لمقلد أن يكتب شيئًا بهذا التشابه.
Dialogue: 0,0:28:37.58,0:28:41.08,Default,,0,0,0,,‫أنسة ساتو، أحضرتُ سيارتك هنا.
Dialogue: 0,0:28:41.08,0:28:42.98,Default,,0,0,0,,‫شكرًا، تشيبا.
Dialogue: 0,0:28:42.98,0:28:45.88,Default,,0,0,0,,‫الآن، سأذهب للتحقيق.
Dialogue: 0,0:28:45.88,0:28:49.48,Default,,0,0,0,,‫مهلا، ساتو! ساتو!
Dialogue: 0,0:28:50.68,0:28:53.68,Default,,0,0,0,,‫لن يفلت مني هذه المرة.
Dialogue: 0,0:28:55.08,0:28:57.18,Default,,0,0,0,,‫سأقبض عليه بنفسي.
Dialogue: 0,0:29:02.92,0:29:04.82,Default,,0,0,0,,‫حالة طوارئ، حالة طوارئ.
Dialogue: 0,0:29:04.82,0:29:06.82,Default,,0,0,0,,‫من شرطة العاصمة إلى جميع المحطات.
Dialogue: 0,0:29:06.82,0:29:08.22,Default,,0,0,0,,‫لم نحدد المكان بعد،
Dialogue: 0,0:29:08.22,0:29:11.12,Default,,0,0,0,,‫لكننا تلقينا تحذيرًا بوجود قنبلة.
Dialogue: 0,0:29:11.12,0:29:12.62,Default,,0,0,0,,‫هناك قنبلتان.
Dialogue: 0,0:29:12.62,0:29:17.52,Default,,0,0,0,,‫وقت الانفجار عند الظهيرة غدًا وعند الثالثة من نفس اليوم.
Dialogue: 0,0:29:17.52,0:29:21.32,Default,,0,0,0,,‫كما تظهر الحوادث السابقة، هذا التحذير موثوق جدًا.
Dialogue: 0,0:29:21.32,0:29:23.22,Default,,0,0,0,,‫حافظوا على المراقبة الدقيقة وكونوا في حالة تأهب.
Dialogue: 0,0:29:23.22,0:29:25.52,Default,,0,0,0,,‫واصلوا التحقيق ولا تدعوا المشتبه به يهرب.
Dialogue: 0,0:29:29.72,0:29:31.62,Default,,0,0,0,,‫الاشواط الاضافية؟
Dialogue: 0,0:29:31.62,0:29:33.42,Default,,0,0,0,,‫إنه يلعب بنا.
Dialogue: 0,0:29:33.42,0:29:35.32,Default,,0,0,0,,‫-ميغوري! \N‫-نعم.
Dialogue: 0,0:29:35.32,0:29:38.02,Default,,0,0,0,,‫لا يمنكننا السماح لهذه المباراة بالاستمرار.
Dialogue: 0,0:29:38.02,0:29:41.32,Default,,0,0,0,,‫أحسموا القضية نهائيًا، هل فهمتم؟
Dialogue: 0,0:29:41.32,0:29:42.82,Default,,0,0,0,,‫فهمت، سيدي.
Dialogue: 0,0:29:47.22,0:29:49.22,Default,,0,0,0,,‫إنها فرصتك لـ...
Dialogue: 0,0:29:49.22,0:29:53.02,Default,,0,0,0,,‫الذكرى التي تحملينها بداخلك ولا تستطيعين محوها...
Dialogue: 0,0:29:53.02,0:29:55.12,Default,,0,0,0,,‫هذه فرصة للتخلص منها.
Dialogue: 0,0:29:55.12,0:29:58.02,Default,,0,0,0,,‫نعم. يجب أن أتخلص منها.
Dialogue: 0,0:29:58.02,0:30:01.52,Default,,0,0,0,,‫يجب أن أقبض على المفجر وأنسى الماضي.
Dialogue: 0,0:30:01.52,0:30:02.92,Default,,0,0,0,,‫أنسى؟
Dialogue: 0,0:30:07.52,0:30:09.02,Default,,0,0,0,,‫تذكارات من والدك الذي مات أثناء الواجب،
Dialogue: 0,0:30:09.02,0:30:11.22,Default,,0,0,0,,‫وترتدينها كتعويذة.
Dialogue: 0,0:30:11.22,0:30:13.52,Default,,0,0,0,,‫أعدها إليّ!
Dialogue: 0,0:30:13.52,0:30:17.02,Default,,0,0,0,,‫أعرف ما تريد قوله لي،
Dialogue: 0,0:30:17.02,0:30:19.22,Default,,0,0,0,,‫تخلصي منها للمضي قدمًا، انسيها.
Dialogue: 0,0:30:19.22,0:30:22.12,Default,,0,0,0,,‫لا. ليس عليكِ أن تنسي.
Dialogue: 0,0:30:22.12,0:30:23.62,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:30:23.62,0:30:27.22,Default,,0,0,0,,‫المضي قدمًا أو عدمه يعتمد عليكِ.
Dialogue: 0,0:30:27.22,0:30:31.82,Default,,0,0,0,,‫إذا نسيتيها تمامًا، سيختفي والدك حقًا.
Dialogue: 0,0:30:33.02,0:30:34.32,Default,,0,0,0,,‫ماتسودا.
Dialogue: 0,0:30:36.72,0:30:38.12,Default,,0,0,0,,‫ماتسودا.
Dialogue: 0,0:30:39.42,0:30:41.72,Default,,0,0,0,,‫إذن، هل ستخبريني بالحقيقة؟
Dialogue: 0,0:30:42.52,0:30:46.82,Default,,0,0,0,,‫لماذا يحمل هذا المفجر حقداً اتجاه الشرطة؟
Dialogue: 0,0:30:46.82,0:30:48.42,Default,,0,0,0,,‫كونان!
Dialogue: 0,0:30:48.42,0:30:50.32,Default,,0,0,0,,‫متى دخلت السيارة؟
Dialogue: 0,0:30:50.32,0:30:52.62,Default,,0,0,0,,‫هيا أجبيني.
Dialogue: 0,0:30:58.22,0:31:00.42,Default,,0,0,0,,‫في حادثة التفجير قبل 7 سنوات،
Dialogue: 0,0:31:00.42,0:31:02.62,Default,,0,0,0,,‫كان هناك مفجران.
Dialogue: 0,0:31:03.52,0:31:07.52,Default,,0,0,0,,‫قاما بزرع القنابل في مجمعين سكنيين منفصلين.
Dialogue: 0,0:31:08.62,0:31:10.62,Default,,0,0,0,,‫وطلبوا مليار ين،
Dialogue: 0,0:31:10.62,0:31:12.72,Default,,0,0,0,,‫وقالوا أنهم سيفجرون القنبلة
Dialogue: 0,0:31:12.72,0:31:14.92,Default,,0,0,0,,‫إذا هرب حتى أحد السكان من المجمع.
Dialogue: 0,0:31:16.22,0:31:19.62,Default,,0,0,0,,‫لقد تعاملنا مع إحدى القنابل في الوقت المناسب
Dialogue: 0,0:31:19.62,0:31:21.82,Default,,0,0,0,,‫لكننا فشلنا مع الأخرى.
Dialogue: 0,0:31:21.82,0:31:25.72,Default,,0,0,0,,‫كان علينا قبول طلبهم.
Dialogue: 0,0:31:25.72,0:31:27.52,Default,,0,0,0,,‫أوقفوا عداد الوقت
Dialogue: 0,0:31:27.52,0:31:30.32,Default,,0,0,0,,‫لتفجير القنبلة عبر جهاز التحكم عن بعد.
Dialogue: 0,0:31:30.32,0:31:32.52,Default,,0,0,0,,‫تم إخلاء جميع السكان
Dialogue: 0,0:31:32.52,0:31:35.02,Default,,0,0,0,,‫وبدا الأمر وكأن كل شيء انتهى.
Dialogue: 0,0:31:35.02,0:31:40.12,Default,,0,0,0,,‫لكن بعد 30 دقيقة، اتصل أحد المفجرين بالشرطة.
Dialogue: 0,0:31:40.12,0:31:44.72,Default,,0,0,0,,‫قال: "العداد ما زال يعمل، ما الذي يحدث؟"
Dialogue: 0,0:31:44.72,0:31:50.22,Default,,0,0,0,,‫على الأرجح ارتكب خطأ بمشاهدة أخبار التلفزيون
Dialogue: 0,0:31:50.22,0:31:52.22,Default,,0,0,0,,‫ومراجعة ما حدث عبر جهاز التسجيل.
Dialogue: 0,0:31:52.22,0:31:56.52,Default,,0,0,0,,‫اعتقدت الشرطة أنها فرصة جيدة للقبض على المفجر.
Dialogue: 0,0:31:56.52,0:31:59.22,Default,,0,0,0,,‫تحدثوا معه ونجحوا في تتبع مكالمته.
Dialogue: 0,0:31:59.22,0:32:01.82,Default,,0,0,0,,‫وجدنا المفجر في كشك الهاتف.
Dialogue: 0,0:32:03.72,0:32:05.82,Default,,0,0,0,,‫لكن للأسف...
Dialogue: 0,0:32:11.82,0:32:16.62,Default,,0,0,0,,‫هرب المفجر وصدمته سيارة ومات.
Dialogue: 0,0:32:19.52,0:32:24.12,Default,,0,0,0,,‫إذن، كيف عرفتم بوجود المفجر الآخر؟
Dialogue: 0,0:32:24.12,0:32:25.42,Default,,0,0,0,,‫إنه بسبب...
Dialogue: 0,0:32:26.92,0:32:29.72,Default,,0,0,0,,‫ العداد الذي كان من المفترض أن يتوقف
Dialogue: 0,0:32:29.72,0:32:33.42,Default,,0,0,0,,‫بدأ بالعد مرة أخرى وانفجرت القنبلة.
Dialogue: 0,0:32:33.42,0:32:34.92,Default,,0,0,0,,‫اهربوا، جميعًا!
Dialogue: 0,0:32:34.92,0:32:36.52,Default,,0,0,0,,‫العداد يعمل مرة أخرى!
Dialogue: 0,0:32:46.72,0:32:50.92,Default,,0,0,0,,‫وجدنا عنوان المفجر الذي قُتل.
Dialogue: 0,0:32:50.92,0:32:54.72,Default,,0,0,0,,‫لكن كل ما اكتشفناه هو أنه كان يعيش هناك مع شخص آخر.
Dialogue: 0,0:32:54.72,0:32:58.72,Default,,0,0,0,,‫على الأرجح اعتقد المفجر الآخر
Dialogue: 0,0:32:58.72,0:33:02.52,Default,,0,0,0,,‫أن الشرطة قدمت معلومات خاطئة عبر التلفزيون
Dialogue: 0,0:33:02.52,0:33:05.02,Default,,0,0,0,,‫ونصبوا فخًا، مما أدى إلى مقتل صديقه.
Dialogue: 0,0:33:07.72,0:33:11.32,Default,,0,0,0,,‫هذا سبب تافه للحقد!
Dialogue: 0,0:33:11.32,0:33:13.22,Default,,0,0,0,,‫إنه خطأهم، لأنهم زرعوا القنبلة
Dialogue: 0,0:33:13.22,0:33:15.12,Default,,0,0,0,,‫وكانت غايتهم الأساسية هي المال.
Dialogue: 0,0:33:15.12,0:33:16.62,Default,,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:33:16.62,0:33:20.72,Default,,0,0,0,,‫حسنًا، هذا كل ما أعرفه عن القضية. هل يمكنكم الخروج الآن؟
Dialogue: 0,0:33:20.72,0:33:23.22,Default,,0,0,0,,‫لكننا نريد المساعدة!
Dialogue: 0,0:33:23.22,0:33:26.72,Default,,0,0,0,,‫كلما زاد العدد كان أفضل، أليس كذلك؟
Dialogue: 0,0:33:26.72,0:33:28.82,Default,,0,0,0,,‫حسنًا، لكن إذا اكتشفوا
Dialogue: 0,0:33:28.82,0:33:30.82,Default,,0,0,0,,‫أنني أجري تحقيقات مع أطفال في سيارتي...
Dialogue: 0,0:33:30.82,0:33:36.82,Default,,0,0,0,,‫لكن الأطفال غالبًا ما يكونون أفضل من البالغين في حل الألغاز الطفولية مثل هذه.
Dialogue: 0,0:33:36.82,0:33:42.22,Default,,0,0,0,,‫أم أن مشكلتك الحقيقية هي أنك فقدت إيدوغاوا وانتهى بك الأمر معنا؟
Dialogue: 0,0:33:42.22,0:33:46.12,Default,,0,0,0,,‫هل هذا صحيح؟
Dialogue: 0,0:33:46.12,0:33:49.02,Default,,0,0,0,,‫لا، ليس هذا السبب.
Dialogue: 0,0:33:49.02,0:33:51.32,Default,,0,0,0,,‫لكن، لماذا بذل المفجر جهدًا
Dialogue: 0,0:33:51.32,0:33:54.52,Default,,0,0,0,,‫لإرسال رسالة مشفرة إلى الشرطة؟
Dialogue: 0,0:33:54.52,0:33:57.22,Default,,0,0,0,,‫ إذا لم يرسل شيئًا على الإطلاق لن يعثر عليه أحد.
Dialogue: 0,0:33:58.02,0:34:00.42,Default,,0,0,0,,‫لنفترض أنك أخفيت كنزًا
Dialogue: 0,0:34:00.42,0:34:03.12,Default,,0,0,0,,‫وجاء أحدهم يحاول العثور عليه، ماذا ستفعلون؟
Dialogue: 0,0:34:03.12,0:34:06.32,Default,,0,0,0,,‫سأراقبه بقلب ينبض بسرعة.
Dialogue: 0,0:34:06.32,0:34:10.72,Default,,0,0,0,,‫لنفترض أنك أخفيت الكنز في فخ مع مصيدة؟
Dialogue: 0,0:34:10.72,0:34:12.82,Default,,0,0,0,,‫ بالطبع، سنقوم...
Dialogue: 0,0:34:12.82,0:34:15.02,Default,,0,0,0,,‫سنقدم لهم أدلة شيئًا فشيئًا.
Dialogue: 0,0:34:15.02,0:34:17.72,Default,,0,0,0,,‫هذا هو! لهذا بدأ في تقديم الأدلة.
Dialogue: 0,0:34:17.72,0:34:21.22,Default,,0,0,0,,‫صحيح، المفجر يتصرف كطفل،
Dialogue: 0,0:34:21.22,0:34:23.42,Default,,0,0,0,,‫يلعب بلعبة تسمى القنبلة.
Dialogue: 0,0:34:23.42,0:34:25.12,Default,,0,0,0,,‫إنه طفل شرير بيده لعبة شريرة.
Dialogue: 0,0:34:53.43,0:34:57.43,Default,,0,0,0,,‫يا ران!، الهاتف!
Dialogue: 0,0:34:57.43,0:35:00.43,Default,,0,0,0,,‫تبا، أبي، لماذا لا ترد عليه؟
Dialogue: 0,0:35:00.43,0:35:04.13,Default,,0,0,0,,‫لكن يداي مشغولتان.
Dialogue: 0,0:35:04.13,0:35:05.83,Default,,0,0,0,,‫تبا.
Dialogue: 0,0:35:08.83,0:35:10.53,Default,,0,0,0,,‫مرحبًا، هذا منزل موري.
Dialogue: 0,0:35:10.53,0:35:12.23,Default,,0,0,0,,‫إنه أنا.
Dialogue: 0,0:35:12.23,0:35:13.63,Default,,0,0,0,,‫البروفيسور أغاسا!
Dialogue: 0,0:35:13.63,0:35:17.03,Default,,0,0,0,,‫ران، الأمر يتعلق بكونان.
Dialogue: 0,0:35:17.03,0:35:19.93,Default,,0,0,0,,‫إنه يصر على البقاء معي هنا الليلة.
Dialogue: 0,0:35:19.93,0:35:22.63,Default,,0,0,0,,‫ماذا؟، في منزلك، ايها البروفيسور أغاسا؟
Dialogue: 0,0:35:22.63,0:35:25.23,Default,,0,0,0,,‫نعم. الأطفال أحبوا اللعبة التي صنعتها
Dialogue: 0,0:35:25.23,0:35:27.73,Default,,0,0,0,,‫واصبحوا مدمنون عليها. 
Dialogue: 0,0:35:27.73,0:35:30.33,Default,,0,0,0,,‫أيومي والآخرون هناك أيضًا؟
Dialogue: 0,0:35:30.33,0:35:31.93,Default,,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:35:31.93,0:35:34.43,Default,,0,0,0,,‫ستنتهي إجازة الشتاء،
Dialogue: 0,0:35:34.43,0:35:37.03,Default,,0,0,0,,‫لذا سيعودون بحلول مساء الغد.
Dialogue: 0,0:35:37.03,0:35:38.03,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:35:38.03,0:35:40.43,Default,,0,0,0,,‫حسنًا إذن، إلى اللقاء.
Dialogue: 0,0:35:42.93,0:35:45.33,Default,,0,0,0,,‫منزل أيومي التالي.
Dialogue: 0,0:35:46.63,0:35:48.23,Default,,0,0,0,,‫من فضلك، ايها البروفيسور.
Dialogue: 0,0:35:48.23,0:35:51.33,Default,,0,0,0,,‫نريد الانتقام من المفجر لما فعله بالمفتش شيراتوري.
Dialogue: 0,0:35:51.33,0:35:53.23,Default,,0,0,0,,‫نعم، نريد الانتقام له!
Dialogue: 0,0:35:53.23,0:35:54.83,Default,,0,0,0,,‫من فضلك، أيها البروفيسور.
Dialogue: 0,0:35:54.83,0:35:57.03,Default,,0,0,0,,‫سأحرص على إبعادهم عن الخطر.
Dialogue: 0,0:35:58.13,0:36:01.43,Default,,0,0,0,,‫تبا، سأواجه مشكلة إذا اكتشف أحد الأمر.
Dialogue: 0,0:36:03.33,0:36:06.73,Default,,0,0,0,,‫وأعددت الطبق المفضل لكونان.
Dialogue: 0,0:36:06.73,0:36:08.53,Default,,0,0,0,,‫لا تقلقي!
Dialogue: 0,0:36:08.53,0:36:11.33,Default,,0,0,0,,‫امتحان المحاكاة الوطني غداً، أليس كذلك؟
Dialogue: 0,0:36:11.33,0:36:16.23,Default,,0,0,0,,‫بهذه الطريقة يمكنك الدراسة دون الحاجة لرعاية ذلك الصبي، صحيح؟
Dialogue: 0,0:36:17.13,0:36:20.23,Default,,0,0,0,,‫بالمناسبة، ران، أريد زجاجة أخرى، من فضلك.
Dialogue: 0,0:36:20.23,0:36:22.53,Default,,0,0,0,,‫ماذا؟ ستشرب المزيد؟
Dialogue: 0,0:36:22.53,0:36:25.53,Default,,0,0,0,,‫سيكون الأمر على ما يرام.
Dialogue: 0,0:36:25.53,0:36:28.93,Default,,0,0,0,,‫بصراحة، رعاية هذا السكير أصعب بكثير من رعاية صبي.
Dialogue: 0,0:36:33.63,0:36:36.53,Default,,0,0,0,,‫ماذا تعني هذه الرسالة؟
Dialogue: 0,0:36:36.53,0:36:40.03,Default,,0,0,0,,‫الشيء الوحيد الذي نعرفه هو الوقت.
Dialogue: 0,0:36:40.03,0:36:43.03,Default,,0,0,0,,‫على أي حال، الرجل أجنبي.
Dialogue: 0,0:36:43.03,0:36:45.23,Default,,0,0,0,,‫إنه لاعب بيسبول في الدوري الرئيسي.
Dialogue: 0,0:36:45.23,0:36:47.23,Default,,0,0,0,,‫ليس أجنبيًا بالضبط.
Dialogue: 0,0:36:47.23,0:36:50.73,Default,,0,0,0,,‫هناك لاعبون يابانيون في الدوري الرئيسي هذه الأيام.
Dialogue: 0,0:36:50.73,0:36:52.53,Default,,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:36:52.53,0:36:57.33,Default,,0,0,0,,‫لكنه زرع قنبلة في ملعب بيسبول في مكان ما، أنا متأكد.
Dialogue: 0,0:36:57.33,0:37:02.23,Default,,0,0,0,,‫نعم. مكتوب "التلة" و"صندوق الضارب".
Dialogue: 0,0:37:02.23,0:37:03.93,Default,,0,0,0,,‫إنها في محطة هايدو الجنوبية.
Dialogue: 0,0:37:03.93,0:37:05.93,Default,,0,0,0,,‫ محطة هايدو الجنوبية؟
Dialogue: 0,0:37:05.93,0:37:07.53,Default,,0,0,0,,‫اتقصدين خط توتو المركزي؟
Dialogue: 0,0:37:07.53,0:37:08.63,Default,,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:37:08.63,0:37:10.23,Default,,0,0,0,,‫عم تتحدثون؟
Dialogue: 0,0:37:10.23,0:37:14.33,Default,,0,0,0,,‫لا يوجد ملعب بيسبول قرب محطة هايدو الجنوبية.
Dialogue: 0,0:37:14.33,0:37:16.13,Default,,0,0,0,,‫إنه رمز.
Dialogue: 0,0:37:16.13,0:37:20.73,Default,,0,0,0,,‫لا يشير حرفيًا إلى تلة أو صندوق ضارب.
Dialogue: 0,0:37:20.73,0:37:23.93,Default,,0,0,0,,‫إذن، تقصدين أنكِ فككتِ الرمز؟
Dialogue: 0,0:37:23.93,0:37:25.23,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:37:25.23,0:37:28.83,Default,,0,0,0,,‫قبل ثلاث سنوات، تم زرع قنابل في
Dialogue: 0,0:37:28.83,0:37:31.63,Default,,0,0,0,,‫العجلة العملاقة في مركز هايدو للتسوق
Dialogue: 0,0:37:31.63,0:37:34.03,Default,,0,0,0,,‫ومستشفى بيكا المركزي.
Dialogue: 0,0:37:34.03,0:37:36.93,Default,,0,0,0,,‫ محطة هايدو الجنوبية في خط توتو المركزي
Dialogue: 0,0:37:36.93,0:37:41.93,Default,,0,0,0,,‫تقع حيث تتقاطع الطرق المؤدية إلى المكانين.
Dialogue: 0,0:37:42.73,0:37:47.53,Default,,0,0,0,,‫لكن هذه مجرد لعبة كلمات وخطوط ممتدة.
Dialogue: 0,0:37:47.53,0:37:48.93,Default,,0,0,0,,‫أنتم بطيئون، أليس كذلك؟
Dialogue: 0,0:37:48.93,0:37:51.93,Default,,0,0,0,,‫إذا كانت المحطة تقع حيث تتقاطع الطرق،
Dialogue: 0,0:37:51.93,0:37:55.33,Default,,0,0,0,,‫فمن الطبيعي أن يكون هناك موقف، أليس كذلك؟
Dialogue: 0,0:37:55.33,0:37:56.63,Default,,0,0,0,,‫موقف؟
Dialogue: 0,0:37:56.63,0:37:57.83,Default,,0,0,0,,‫موقف؟
Dialogue: 0,0:37:57.83,0:37:59.23,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:37:59.23,0:38:01.23,Default,,0,0,0,,‫فهمت!، لقد عرفت!
Dialogue: 0,0:38:01.23,0:38:02.23,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:38:02.23,0:38:05.13,Default,,0,0,0,,‫إنه حاجز السكك الحديدية، أليس كذلك؟
Dialogue: 0,0:38:05.13,0:38:09.43,Default,,0,0,0,,‫إذن، صندوق الضارب الفولاذي يمكن أن يكون...
Dialogue: 0,0:38:09.43,0:38:12.73,Default,,0,0,0,,‫صندوق فولاذي، أو عربة القطار.
Dialogue: 0,0:38:12.73,0:38:15.93,Default,,0,0,0,,‫و"تسلق التلة الدموية"،
Dialogue: 0,0:38:15.93,0:38:18.33,Default,,0,0,0,,‫يمكن أن تعني قطارًا أحمر اللون يصعد إلى مركز المدينة.
Dialogue: 0,0:38:18.33,0:38:22.33,Default,,0,0,0,,‫تبا، علي إخبار الانسة ساتو بهذا.
Dialogue: 0,0:38:22.33,0:38:25.03,Default,,0,0,0,,‫لا بأس، سمعت كل شي.
Dialogue: 0,0:38:25.03,0:38:27.53,Default,,0,0,0,,‫نحن كذلك توصّلنا إلى النتيجة نفسها تمامًا.
Dialogue: 0,0:38:27.53,0:38:31.53,Default,,0,0,0,,‫سيتم زرع قنبلة في قطار خط توتو المركزي
Dialogue: 0,0:38:31.53,0:38:34.93,Default,,0,0,0,,‫الذي يذهب من محطة هايدو الجنوبية إلى طوكيو.
Dialogue: 0,0:38:34.93,0:38:38.53,Default,,0,0,0,,‫سأتصل بالمفتش لإرسال المحققين.
Dialogue: 0,0:38:38.53,0:38:41.33,Default,,0,0,0,,‫تاكاغي، اتصل على فريق مكافحة القنابل.
Dialogue: 0,0:38:41.33,0:38:43.43,Default,,0,0,0,,‫-بسرعة! \N‫-نعم.
Dialogue: 0,0:38:44.03,0:38:46.53,Default,,0,0,0,,‫ماذا؟، محطة هايدو الجنوبية؟
Dialogue: 0,0:38:46.53,0:38:47.93,Default,,0,0,0,,‫حقًا؟
Dialogue: 0,0:38:47.93,0:38:52.13,Default,,0,0,0,,‫نعم. ثم ماذا؟
Dialogue: 0,0:38:52.13,0:38:54.63,Default,,0,0,0,,‫حسنًا، فهمت.
Dialogue: 0,0:38:54.63,0:38:55.93,Default,,0,0,0,,‫سنقوم بالإخلاء فورًا.
Dialogue: 0,0:39:00.63,0:39:03.93,Default,,0,0,0,,‫الجميع، من فضلكم اخلوا بهدوء!
Dialogue: 0,0:39:13.83,0:39:15.73,Default,,0,0,0,,‫ماذا؟، إنها مجرد قمامة.
Dialogue: 0,0:39:15.73,0:39:17.63,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:39:17.63,0:39:19.33,Default,,0,0,0,,‫هذا... هذا هو...
Dialogue: 0,0:39:19.33,0:39:21.33,Default,,0,0,0,,‫قنبلة؟
Dialogue: 0,0:39:21.33,0:39:24.43,Default,,0,0,0,,‫تراجعوا جميعًا، إنها قنبلة!
Dialogue: 0,0:39:24.43,0:39:26.13,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:39:32.53,0:39:34.63,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:39:35.83,0:39:37.93,Default,,0,0,0,,‫ماذا؟، مزيفة؟
Dialogue: 0,0:39:37.93,0:39:40.13,Default,,0,0,0,,‫تقولون أنها ليست قنبلة حقيقية؟
Dialogue: 0,0:39:40.13,0:39:41.23,Default,,0,0,0,,‫ثم ماذا؟
Dialogue: 0,0:39:41.23,0:39:42.93,Default,,0,0,0,,‫أعتقد أن المفجر توقع
Dialogue: 0,0:39:42.93,0:39:46.53,Default,,0,0,0,,‫أن يذهب المحققون للبحث هناك.
Dialogue: 0,0:39:46.53,0:39:51.43,Default,,0,0,0,,‫صحيح، إنه طفل مشاكس يلعب بنا، على ما أعتقد.
Dialogue: 0,0:39:51.43,0:39:55.83,Default,,0,0,0,,‫بالإضافة إلى أنه لا يريد المال. 
Dialogue: 0,0:39:55.83,0:40:00.63,Default,,0,0,0,,‫نعم. المفجر على الأرجح يحمل حقداً اتجاه الشرطة،
Dialogue: 0,0:40:00.63,0:40:06.73,Default,,0,0,0,,‫ويحتجز 12 مليون شخص يعيشون في مدينة طوكيو كرهائن.
Dialogue: 0,0:40:18.77,0:40:20.87,Top,,0,0,0,,‫"خط توتو، محطة هايدو الجنوبية"
Dialogue: 0,0:40:45.67,0:40:47.77,Top,NTP,0,0000,0000,0000,‫"فشل"
Dialogue: 0,0:40:48.47,0:40:51.27,Default,,0,0,0,,‫ماذا؟، قنبلة مزيفة مرة أخرى؟
Dialogue: 0,0:40:51.27,0:40:53.67,Default,,0,0,0,,‫هل فحصتموها جميعًا؟
Dialogue: 0,0:40:53.67,0:40:56.37,Default,,0,0,0,,‫ألا توجد قنبلة حقيقية؟
Dialogue: 0,0:40:56.37,0:40:57.57,Default,,0,0,0,,‫لا.
Dialogue: 0,0:40:57.57,0:41:02.87,Default,,0,0,0,,‫لقد فحصنا جميع القطارات الحمراء التي تمر عبر المدينة،
Dialogue: 0,0:41:02.87,0:41:07.27,Default,,0,0,0,,‫لكن كل القنابل التي وجدناها كانت مزيفة.
Dialogue: 0,0:41:07.27,0:41:08.77,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:41:08.77,0:41:12.77,Default,,0,0,0,,‫المفجر يحاول على الأرجح تعطيل تحقيقاتنا.
Dialogue: 0,0:41:12.77,0:41:15.57,Default,,0,0,0,,‫على أي حال، لا تتراخوا واستمروا في تحقيقاتكم.
Dialogue: 0,0:41:15.57,0:41:17.07,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:41:17.07,0:41:18.57,Default,,0,0,0,,‫ايها المشرف ماتسوموتو.
Dialogue: 0,0:41:18.57,0:41:19.57,Default,,0,0,0,,‫ما الأمر؟
Dialogue: 0,0:41:19.57,0:41:22.97,Default,,0,0,0,,‫تقرير من فريق أوزاكي، سيدي. إنهم في ملاعب البيسبول.
Dialogue: 0,0:41:22.97,0:41:25.17,Default,,0,0,0,,‫-وماذا حصلتم؟\N‫ -نعم،
Dialogue: 0,0:41:25.17,0:41:32.17,Default,,0,0,0,,‫فتشنا ملاعب البيسبول الرئيسية في المدينة، لكننا لم نجد شيئأ.
Dialogue: 0,0:41:32.17,0:41:37.27,Default,,0,0,0,,‫نحن الآن نفتش الملاعب الصغيرة أيضاً
Dialogue: 0,0:41:38.67,0:41:42.47,Default,,0,0,0,,‫لا داعي للتفتيش ملاعب البيسبول بعد الآن، أعتقد.
Dialogue: 0,0:41:42.47,0:41:46.67,Default,,0,0,0,,‫حسنًا. أوقفوا جميع القطارات الحمراء في المدينة.
Dialogue: 0,0:41:46.67,0:41:48.77,Default,,0,0,0,,‫أخرجوا جميع المحققين من ملاعب البيسبول
Dialogue: 0,0:41:48.77,0:41:51.37,Default,,0,0,0,,‫وأرسلوهم إلى جميع المحطات لإجراء التحقيقات.
Dialogue: 0,0:41:51.37,0:41:53.77,Default,,0,0,0,,‫لا يزال لدينا خمس ساعات أخرى
Dialogue: 0,0:41:53.77,0:41:55.67,Default,,0,0,0,,‫قبل الانفجار الأول المتوقع عند الظهيرة.
Dialogue: 0,0:41:55.67,0:42:00.07,Default,,0,0,0,,‫من المحتمل أن المفجر لم يزرع القنبلة بعد!
Dialogue: 0,0:42:00.07,0:42:01.37,Default,,0,0,0,,‫نعم!
Dialogue: 0,0:42:07.17,0:42:10.17,Default,,0,0,0,,‫خمس ساعات أخرى؟
Dialogue: 0,0:42:10.17,0:42:15.57,Default,,0,0,0,,‫كنت أريد أن أقول أنه لم يتبق لنا سوى خمس ساعات.
Dialogue: 0,0:42:15.57,0:42:16.87,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:42:27.97,0:42:29.27,Default,,0,0,0,,‫أشعر بالنعاس.
Dialogue: 0,0:42:36.17,0:42:37.57,Default,,0,0,0,,‫أليس هذا غريبًا؟
Dialogue: 0,0:42:37.57,0:42:38.97,Default,,0,0,0,,‫من هذه الرسالة، يبدو أنه
Dialogue: 0,0:42:38.97,0:42:41.97,Default,,0,0,0,,‫المفجر كان يعلم أننا سنبحث في ملاعب البيسبول بموجب هذا التهديد،
Dialogue: 0,0:42:41.97,0:42:43.57,Default,,0,0,0,,‫لكن لم يحدث شيء.
Dialogue: 0,0:42:45.47,0:42:48.27,Default,,0,0,0,,‫لقد اعتقد أن لا أحد سيأتي.
Dialogue: 0,0:42:48.27,0:42:51.67,Default,,0,0,0,,‫إنه خارج الموسم ولا توجد مباريات كبيرة مجدولة.
Dialogue: 0,0:42:51.67,0:42:53.17,Default,,0,0,0,,‫ صحيح.
Dialogue: 0,0:42:53.17,0:42:55.07,Default,,0,0,0,,‫إذا كان يريد أن يلعب خدعًا على الشرطة،
Dialogue: 0,0:42:55.07,0:42:59.87,Default,,0,0,0,,‫كان يمكنه أن ينصب فخًا مزيفاً أو اثنين.
Dialogue: 0,0:42:59.87,0:43:03.87,Default,,0,0,0,,‫على أي حال، لا يمكننا إبقاء هؤلاء الأطفال معنا بعد الآن.
Dialogue: 0,0:43:04.97,0:43:06.67,Default,,0,0,0,,‫أنتِ محقة.
Dialogue: 0,0:43:06.67,0:43:10.17,Default,,0,0,0,,‫بالمناسبة، كيف حال شيراتوري؟، هل سألت عنه؟
Dialogue: 0,0:43:10.17,0:43:11.97,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:43:11.97,0:43:15.77,Default,,0,0,0,,‫يومي تعتني بشيراتوري،
Dialogue: 0,0:43:15.77,0:43:17.47,Default,,0,0,0,,‫وأخبرتني أن العملية كانت ناجحة.
Dialogue: 0,0:43:17.47,0:43:20.87,Default,,0,0,0,,‫إنهم ينتظرون أن يستعيد وعيه.
Dialogue: 0,0:43:20.87,0:43:23.57,Default,,0,0,0,,‫حقاً؟، الحمدلله.
Dialogue: 0,0:43:26.57,0:43:28.47,Default,,0,0,0,,‫اسمعني، تاكاغي.
Dialogue: 0,0:43:28.47,0:43:31.07,Default,,0,0,0,,‫تأكد من إبعاد ميواكو عن المواقف الخطيرة.
Dialogue: 0,0:43:31.07,0:43:33.07,Default,,0,0,0,,‫إذا كان المفجر هو نفس المفجر
Dialogue: 0,0:43:33.07,0:43:36.57,Default,,0,0,0,,‫الذي قتل ماتسودا بقنبلة،
Dialogue: 0,0:43:36.57,0:43:38.87,Default,,0,0,0,,‫من يدري ماذا قد تفعل
Dialogue: 0,0:43:38.87,0:43:42.67,Default,,0,0,0,,‫ولن يكون هناك أحد غيرك قادرًا على إنقاذها.
Dialogue: 0,0:43:42.67,0:43:46.47,Default,,0,0,0,,‫ماذا؟، لماذا أنا؟
Dialogue: 0,0:43:46.47,0:43:51.27,Default,,0,0,0,,‫أنت تشبه السيد ماتسودا كثيرًا.
Dialogue: 0,0:43:51.27,0:43:55.27,Default,,0,0,0,,‫فقط لأنني بدوت مثله في ذلك التنكر...
Dialogue: 0,0:43:55.27,0:44:00.37,Default,,0,0,0,,‫بالطبع، هو أفضل منك بخمس إلى عشر مرات.
Dialogue: 0,0:44:00.37,0:44:02.67,Default,,0,0,0,,‫عشر مرات؟
Dialogue: 0,0:44:02.67,0:44:05.17,Default,,0,0,0,,‫لكن هناك شيء فيك يذكرني به.
Dialogue: 0,0:44:05.17,0:44:08.57,Default,,0,0,0,,‫قد يكون قلبك، روحك، أو أي شيء...
Dialogue: 0,0:44:08.57,0:44:11.27,Default,,0,0,0,,‫شيء يشبه ماتسودا.
Dialogue: 0,0:44:11.27,0:44:15.37,Default,,0,0,0,,‫أعتقد أن ميواكو أدركت ذلك مؤخرًا.
Dialogue: 0,0:44:15.37,0:44:16.87,Default,,0,0,0,,‫يا تاكاغي.
Dialogue: 0,0:44:16.87,0:44:19.77,Default,,0,0,0,,‫تاكاغي!
Dialogue: 0,0:44:19.77,0:44:22.97,Default,,0,0,0,,‫فيما كنت تفكر؟
Dialogue: 0,0:44:22.97,0:44:26.17,Default,,0,0,0,,‫هل اكتشفت مكان القنبلة؟
Dialogue: 0,0:44:26.17,0:44:27.87,Default,,0,0,0,,‫لا، ليس كذلك.
Dialogue: 0,0:44:27.87,0:44:29.17,Default,,0,0,0,,‫إذن، ماذا؟
Dialogue: 0,0:44:29.17,0:44:32.47,Default,,0,0,0,,‫لا شيء مهم.
Dialogue: 0,0:44:33.57,0:44:34.87,Default,,0,0,0,,‫حسناً، لا يهم.
Dialogue: 0,0:44:39.77,0:44:42.37,Default,,0,0,0,,‫إذن، أنا سأستمر في التحقيق.
Dialogue: 0,0:44:42.37,0:44:45.57,Default,,0,0,0,,‫أرسل الأطفال إلى المنزل.
Dialogue: 0,0:44:45.57,0:44:48.67,Default,,0,0,0,,‫ثم عد إلى مقر الشرطة ونام جداً.
Dialogue: 0,0:44:48.67,0:44:51.27,Default,,0,0,0,,‫وكن هناك لمساعدة المفتش ميغوري.
Dialogue: 0,0:44:51.27,0:44:53.27,Default,,0,0,0,,‫لكن يمكنني الاستمرار في التحقيق.
Dialogue: 0,0:44:53.27,0:44:56.77,Default,,0,0,0,,‫لا تكن سخيفًا، وجود ضابط نعسان في الشوارع!
Dialogue: 0,0:44:56.77,0:44:59.47,Default,,0,0,0,,‫سيعيق التحقيق فقط، هل فهمت؟
Dialogue: 0,0:45:01.27,0:45:02.77,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:45:07.57,0:45:09.17,Default,,0,0,0,,‫لن أسمح.
Dialogue: 0,0:45:09.17,0:45:11.17,Default,,0,0,0,,‫لن أسمح له بأخذه مني.
Dialogue: 0,0:45:12.77,0:45:14.77,Default,,0,0,0,,‫ليس بعد الآن.
Dialogue: 0,0:45:14.77,0:45:16.07,Default,,0,0,0,,‫أبدًا.
Dialogue: 0,0:45:24.07,0:45:29.17,Default,,0,0,0,,‫امتحان بعد رأس السنة مباشرة... يبدو مثل امتحان القبول بالجامعة.
Dialogue: 0,0:45:29.17,0:45:30.17,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:45:30.17,0:45:32.77,Default,,0,0,0,,‫أيام السنة الجديدة مخصصة للاستمتاع للجميع!
Dialogue: 0,0:45:32.77,0:45:34.87,Default,,0,0,0,,‫إذن، استمتعتي، أليس كذلك؟
Dialogue: 0,0:45:34.87,0:45:36.97,Default,,0,0,0,,‫أنا فقط لا أريد أن يكون لدي أي ندم.
Dialogue: 0,0:45:38.47,0:45:42.57,Default,,0,0,0,,‫حسنًا، الشيء الوحيد الذي يمكنني الاعتماد عليه هو هذا.
Dialogue: 0,0:45:42.57,0:45:46.07,Default,,0,0,0,,‫ماذا؟ أليس هذا... هل يمكن أن يكون...
Dialogue: 0,0:45:47.17,0:45:48.87,Default,,0,0,0,,‫لا.
Dialogue: 0,0:45:48.87,0:45:49.87,Default,,0,0,0,,‫انظري!
Dialogue: 0,0:45:51.97,0:45:55.17,Default,,0,0,0,,‫إنها مجرد صورة لكيوغوكو.
Dialogue: 0,0:45:55.17,0:45:59.27,Default,,0,0,0,,‫نعم. هذه الصورة تعطيني الطاقة عندما أنظر إليها.
Dialogue: 0,0:45:59.27,0:46:01.97,Default,,0,0,0,,‫حتى لو لم تكن نتائج امتحاناتي جيدة،
Dialogue: 0,0:46:01.97,0:46:04.47,Default,,0,0,0,,‫لن أشعر بالاكتئاب.
Dialogue: 0,0:46:04.47,0:46:06.97,Default,,0,0,0,,‫طالما لدي حب ماكوتو،
Dialogue: 0,0:46:06.97,0:46:09.37,Default,,0,0,0,,‫لا أحتاج إلى الحصول على 100 في امتحاني.
Dialogue: 0,0:46:09.37,0:46:12.57,Default,,0,0,0,,‫ أشعر بالخجل من نفسي لكوني جريئة جدًا!
Dialogue: 0,0:46:12.57,0:46:14.17,Default,,0,0,0,,‫نعم، نعم.
Dialogue: 0,0:46:23.07,0:46:25.97,Top,,0,0,0,,‫"لقد حصلت على ملامحكِ انثاء نومكِ\N‫- المحقق الصغير ."
Dialogue: 0,0:46:36.57,0:46:38.37,Default,,0,0,0,,‫حسنًا، أيها الأطفال. سأخذكم إلى المنزل.
Dialogue: 0,0:46:38.37,0:46:41.07,Default,,0,0,0,,‫أخبروني أين تعيشون، حسنًا؟
Dialogue: 0,0:46:41.07,0:46:42.17,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:46:42.17,0:46:44.87,Default,,0,0,0,,‫هل ستأخذنا إلى المنزل؟
Dialogue: 0,0:46:44.87,0:46:48.57,Default,,0,0,0,,‫قد نتمكن من حل هذا الرمز في لحظة.
Dialogue: 0,0:46:48.57,0:46:51.07,Default,,0,0,0,,‫جميعكم لم تناموا منذ وقت طويل.
Dialogue: 0,0:46:51.07,0:46:56.57,Default,,0,0,0,,‫لا يمكنني إبقاء تلاميذ المدارس، معي لفترة أطول.
Dialogue: 0,0:46:56.57,0:46:57.57,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:47:00.37,0:47:03.87,Default,,0,0,0,,‫أخبرني!، أين الضابطة ساتو؟
Dialogue: 0,0:47:03.87,0:47:06.17,Default,,0,0,0,,‫إنها تحقق في القضية.
Dialogue: 0,0:47:06.17,0:47:11.17,Default,,0,0,0,,‫فهمت. الضابطة ساتو طلبت منك أن ترسلنا إلى المنزل.
Dialogue: 0,0:47:11.17,0:47:13.77,Default,,0,0,0,,‫أنت تفعل كل ما تأمرك به، أليس كذلك؟
Dialogue: 0,0:47:13.77,0:47:18.77,Default,,0,0,0,,‫يجب علي ذلك. إنها أكبر مني بسنتين ورئيستي أيضًا.
Dialogue: 0,0:47:18.77,0:47:21.67,Default,,0,0,0,,‫هل ستسمح لها بالسيطرة عليك بعد الزواج؟
Dialogue: 0,0:47:21.67,0:47:23.27,Default,,0,0,0,,‫الزواج؟
Dialogue: 0,0:47:23.27,0:47:28.07,Default,,0,0,0,,‫لن أفعل، لأنها رفضتني في ذلك اليوم.
Dialogue: 0,0:47:28.77,0:47:31.67,Default,,0,0,0,,‫أنسة ساتو.
Dialogue: 0,0:47:31.67,0:47:33.27,Default,,0,0,0,,‫نعم؟
Dialogue: 0,0:47:33.27,0:47:36.27,Default,,0,0,0,,‫قلتِ أن لديكِ شيء لتخبرينني به.
Dialogue: 0,0:47:37.87,0:47:39.37,Default,,0,0,0,,‫بخصوص ذلك...
Dialogue: 0,0:47:42.57,0:47:44.87,Default,,0,0,0,,‫انسة ساتو.
Dialogue: 0,0:47:47.97,0:47:50.87,Default,,0,0,0,,‫هل يمكننا إلغاء موعدنا؟
Dialogue: 0,0:47:50.87,0:47:51.87,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:47:51.87,0:47:53.87,Default,,0,0,0,,‫أنا ملعونة.
Dialogue: 0,0:47:53.87,0:47:56.37,Default,,0,0,0,,‫ملعونة؟
Dialogue: 0,0:47:56.37,0:47:59.57,Default,,0,0,0,,‫كل الأشخاص الذين أهتم بهم كثيرًا،
Dialogue: 0,0:47:59.57,0:48:02.47,Default,,0,0,0,,‫يبدو أنهم يختفون مني.
Dialogue: 0,0:48:02.47,0:48:07.07,Default,,0,0,0,,‫والدي، مدرس التربية البدنية في المدرسة،
Dialogue: 0,0:48:07.07,0:48:09.87,Default,,0,0,0,,‫والشاب الذي أعجبني في نادي البيسبول،
Dialogue: 0,0:48:09.87,0:48:11.27,Default,,0,0,0,,‫و...
Dialogue: 0,0:48:14.67,0:48:17.07,Default,,0,0,0,,‫هو أيضًا.
Dialogue: 0,0:48:20.97,0:48:25.37,Default,,0,0,0,,‫لا أريد أن أمر بهذا الألم مرة أخرى.
Dialogue: 0,0:48:25.37,0:48:26.67,Default,,0,0,0,,‫أنسة ساتو.
Dialogue: 0,0:48:28.17,0:48:32.37,Default,,0,0,0,,‫لذا، دعنا نبقى مجرد زملاء عمل.
Dialogue: 0,0:48:35.17,0:48:37.77,Default,,0,0,0,,‫أنسة ساتو.
Dialogue: 0,0:48:39.27,0:48:40.97,Default,,0,0,0,,‫تاكاغي.
Dialogue: 0,0:48:44.47,0:48:46.17,Default,,0,0,0,,‫سـ...
Dialogue: 0,0:48:46.17,0:48:51.07,Default,,0,0,0,,‫أنتِ محقة. نحن غير مناسبين من الأساس.
Dialogue: 0,0:48:51.07,0:48:56.07,Default,,0,0,0,,‫نعم، أنت تستحق فتاة أجمل وألطف.
Dialogue: 0,0:48:56.07,0:48:57.67,Default,,0,0,0,,‫حقًا؟
Dialogue: 0,0:48:59.87,0:49:02.17,Default,,0,0,0,,‫لذا، لا يوجد أي احتمال أن نتزوج.
Dialogue: 0,0:49:02.17,0:49:04.37,Default,,0,0,0,,‫إذن تخلت عنها؟
Dialogue: 0,0:49:04.37,0:49:06.37,Default,,0,0,0,,‫يا لك من جبان!
Dialogue: 0,0:49:06.37,0:49:08.17,Default,,0,0,0,,‫لا شجاعة لديك على الإطلاق.
Dialogue: 0,0:49:08.17,0:49:11.87,Default,,0,0,0,,‫لا أريد أن أتخلى عنها، لكن...
Dialogue: 0,0:49:11.87,0:49:14.57,Default,,0,0,0,,‫لكن ماذا؟
Dialogue: 0,0:49:14.57,0:49:17.07,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:49:17.07,0:49:22.57,Default,,0,0,0,,‫الضابط ماتسودا خاطر بحياته لإنقاذ الناس في المستشفى،
Dialogue: 0,0:49:22.57,0:49:25.87,Default,,0,0,0,,‫لكنني لا أستطيع أن أكون مثله. أليس كذلك؟
Dialogue: 0,0:49:25.87,0:49:27.17,Default,,0,0,0,,‫من أين عرفت ذلك؟
Dialogue: 0,0:49:27.17,0:49:29.67,Default,,0,0,0,,‫الضابط تاكاغي، انظر امامك!
Dialogue: 0,0:49:30.77,0:49:33.17,Default,,0,0,0,,‫سمعنا عنها من الضابطة في سيارة الدوريات الصغيرة.
Dialogue: 0,0:49:33.17,0:49:34.17,Default,,0,0,0,,‫تقصد الانسة يومي؟
Dialogue: 0,0:49:34.17,0:49:37.07,Default,,0,0,0,,‫أخبرتنا بالتفاصيل.
Dialogue: 0,0:49:38.37,0:49:40.27,Default,,0,0,0,,‫إذن، قرر الضابط ماتسودا في ذلك الوقت
Dialogue: 0,0:49:40.27,0:49:45.17,Default,,0,0,0,,‫أن يخاطر بحياته ليخبرنا أين زرعت القنبلة الأخرى.
Dialogue: 0,0:49:45.17,0:49:47.07,Default,,0,0,0,,‫نعم، نعم.
Dialogue: 0,0:49:47.07,0:49:51.67,Default,,0,0,0,,‫حسنًا، انتهى الوقت، عليّ أن أغلق الآن.
Dialogue: 0,0:49:51.67,0:49:53.87,Default,,0,0,0,,‫انتظر، ماتسودا!
Dialogue: 0,0:49:53.87,0:49:56.57,Default,,0,0,0,,‫ماتسودا...
Dialogue: 0,0:50:00.37,0:50:03.87,Default,,0,0,0,,‫كانت قصة حزينة للسماع وللرواية.
Dialogue: 0,0:50:03.87,0:50:05.37,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:50:06.57,0:50:08.47,Default,,0,0,0,,‫هكذا إذن.
Dialogue: 0,0:50:08.47,0:50:11.37,Default,,0,0,0,,‫لن ألومك إذا استسلمت.
Dialogue: 0,0:50:12.57,0:50:17.47,Default,,0,0,0,,‫عندما يغيب شخص ما، يخلد أحباؤه ذاكرته
Dialogue: 0,0:50:17.47,0:50:21.37,Default,,0,0,0,,‫في صورة مثالية تبقى معهم طوال حياتهم.
Dialogue: 0,0:50:21.37,0:50:22.97,Default,,0,0,0,,‫مثل شخص أعرفه.
Dialogue: 0,0:50:22.97,0:50:26.37,Default,,0,0,0,,‫مهلا!، أنا لم أمت بعد.
Dialogue: 0,0:50:37.47,0:50:39.67,Default,,0,0,0,,‫كيف كان أداؤك في امتحان الرياضيات؟
Dialogue: 0,0:50:39.67,0:50:42.27,Default,,0,0,0,,‫سيء.
Dialogue: 0,0:50:43.07,0:50:48.47,Default,,0,0,0,,‫على عكسك، ليس لدي أحد لمساعدتي في صعوباتي.
Dialogue: 0,0:50:48.47,0:50:49.77,Default,,0,0,0,,‫مساعد؟
Dialogue: 0,0:50:49.77,0:50:51.67,Default,,0,0,0,,‫لا يمكنكِ خداعي، ران.
Dialogue: 0,0:50:51.67,0:50:57.27,Default,,0,0,0,,‫كنتِ تنظرين إلى مقعد شينيتشي طوال الامتحان.
Dialogue: 0,0:50:57.27,0:50:59.07,Default,,0,0,0,,‫"ساعدني، شينيتشي!
Dialogue: 0,0:50:59.07,0:51:03.77,Default,,0,0,0,,‫لدي مشكلة في حل هذه المعادلة."
Dialogue: 0,0:51:03.77,0:51:04.77,Default,,0,0,0,,‫هكذا.
Dialogue: 0,0:51:04.77,0:51:07.87,Default,,0,0,0,,‫ليس كذلك! كنت أنظر إلى مقعده لأن...
Dialogue: 0,0:51:07.87,0:51:09.97,Default,,0,0,0,,‫لأن؟
Dialogue: 0,0:51:09.97,0:51:12.17,Default,,0,0,0,,‫لأن...
Dialogue: 0,0:51:21.47,0:51:24.27,Default,,0,0,0,,‫وجهك يحمر بشدة.
Dialogue: 0,0:51:24.27,0:51:27.17,Default,,0,0,0,,‫اللون الأحمر لون مشؤوم أثناء الامتحان.
Dialogue: 0,0:51:27.17,0:51:28.17,Default,,0,0,0,,‫بالحديث عن الأحمر،
Dialogue: 0,0:51:28.17,0:51:31.67,Default,,0,0,0,,‫كان هناك الكثير من صفارات الإنذار منذ الصباح.
Dialogue: 0,0:51:31.67,0:51:33.67,Default,,0,0,0,,‫صحيح. أنتِ محقة.
Dialogue: 0,0:51:33.67,0:51:35.97,Default,,0,0,0,,‫ماذا حدث؟
Dialogue: 0,0:51:42.57,0:51:45.67,Default,,0,0,0,,‫أحمر، أحمر...
Dialogue: 0,0:51:45.67,0:51:47.27,Default,,0,0,0,,‫ما خطب الأحمر؟
Dialogue: 0,0:51:47.27,0:51:49.27,Default,,0,0,0,,‫شيء ما لا يتناسب.
Dialogue: 0,0:51:49.27,0:51:52.37,Default,,0,0,0,,‫هذا "تسلق التلة الدموية" يعني.
Dialogue: 0,0:51:52.37,0:51:55.17,Default,,0,0,0,,‫تقصد أنه ليس قطارًا أحمر؟
Dialogue: 0,0:51:55.17,0:51:59.07,Default,,0,0,0,,‫إنه فقط لا يتناسب.
Dialogue: 0,0:51:59.07,0:52:03.17,Default,,0,0,0,,‫لحظة، إذا كان الأمر كما كان قبل 3 سنوات،
Dialogue: 0,0:52:03.17,0:52:04.57,Default,,0,0,0,,‫القنبلة الأولى وضعت في مكان
Dialogue: 0,0:52:04.57,0:52:08.87,Default,,0,0,0,,‫سهل للشرطة العثور عليه.
Dialogue: 0,0:52:09.67,0:52:12.17,Default,,0,0,0,,‫علي أن أفكر بشكل أبسط.
Dialogue: 0,0:52:12.17,0:52:13.57,Default,,0,0,0,,‫كلما كان أبسط، كان أفضل.
Dialogue: 0,0:52:14.37,0:52:17.57,Default,,0,0,0,,‫شيء يذكرك بالأحمر؟
Dialogue: 0,0:52:17.57,0:52:19.77,Default,,0,0,0,,‫صناديق البريد، سيارات الإطفاء...
Dialogue: 0,0:52:19.77,0:52:22.17,Default,,0,0,0,,‫الشيطان الأحمر، ذات الرداء الأحمر...
Dialogue: 0,0:52:22.17,0:52:26.57,Default,,0,0,0,,‫الطماطم، الفراولة، البطيخ، التفاح،
Dialogue: 0,0:52:26.57,0:52:30.47,Default,,0,0,0,,‫الكرز، الفلفل الحار، سمك السلمون الأحمر الحساء الأحمر...
Dialogue: 0,0:52:30.47,0:52:35.47,Default,,0,0,0,,‫أحمر... تسلق... فولاذ... صندوق...
Dialogue: 0,0:52:35.47,0:52:38.17,Default,,0,0,0,,‫غينتا، أنت تفكر فقط في الطعام.
Dialogue: 0,0:52:38.17,0:52:41.17,Default,,0,0,0,,‫كل هذا التفكير يجعلني جائعاً.
Dialogue: 0,0:52:41.17,0:52:43.87,Default,,0,0,0,,‫أشعر بالعطش قليلاً.
Dialogue: 0,0:52:43.87,0:52:48.17,Default,,0,0,0,,‫حسنًا، هل نجعله يتوقف في منطقة استراحة.
Dialogue: 0,0:52:49.37,0:52:52.57,Default,,0,0,0,,‫بالمناسبة، هذا أحمر أيضاً، إذا فكرت في الأمر.
Dialogue: 0,0:52:52.57,0:52:54.77,Default,,0,0,0,,‫انظروا، يمكنكم رؤيته هناك.
Dialogue: 0,0:52:54.77,0:52:56.37,Default,,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:53:00.97,0:53:02.57,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:53:02.57,0:53:06.17,Default,,0,0,0,,‫أحمر، تسلق، صندوق فولاذي...
Dialogue: 0,0:53:15.91,0:53:18.91,Top,,0,0,0,,‫"برج توتو"
Dialogue: 0,0:53:24.11,0:53:26.11,Default,,0,0,0,,‫هل حدث شيء بالفعل؟
Dialogue: 0,0:53:26.11,0:53:27.71,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:53:27.71,0:53:29.31,Default,,0,0,0,,‫هناك دخان يتصاعد.
Dialogue: 0,0:53:29.31,0:53:33.81,Default,,0,0,0,,‫أتساءل إذا كانت قنبلة قد زرعت هنا بعد كل شيء.
Dialogue: 0,0:53:33.81,0:53:37.11,Default,,0,0,0,,‫سأذهب لأستفسر عما حدث،
Dialogue: 0,0:53:37.11,0:53:39.91,Default,,0,0,0,,‫لذا انتظروا في السيارة.
Dialogue: 0,0:53:39.91,0:53:41.11,Default,,0,0,0,,‫حسنًا؟
Dialogue: 0,0:53:44.01,0:53:47.01,Default,,0,0,0,,‫كنا نخطط لإحضار
Dialogue: 0,0:53:47.01,0:53:49.91,Default,,0,0,0,,‫تقرير خاص عن تميمة أبراج توتو اليوم،
Dialogue: 0,0:53:49.91,0:53:52.01,Default,,0,0,0,,‫لكن بسبب حادث،
Dialogue: 0,0:53:52.01,0:53:54.81,Default,,0,0,0,,‫تغير الجدول حتمًا.
Dialogue: 0,0:53:54.81,0:53:58.01,Default,,0,0,0,,‫المعذرة. ماذا حدث بالضبط؟
Dialogue: 0,0:53:58.01,0:53:59.51,Default,,0,0,0,,‫كما ترى، الأمر هو...
Dialogue: 0,0:54:00.31,0:54:03.11,Default,,0,0,0,,‫ماذا؟ القنبلة داخل برج توتو؟
Dialogue: 0,0:54:03.11,0:54:05.61,Default,,0,0,0,,‫نعم، أنا متأكد.
Dialogue: 0,0:54:05.61,0:54:08.11,Default,,0,0,0,,‫ماذا تقصد بالضبط؟، أخبرني بالتفاصيل،
Dialogue: 0,0:54:08.11,0:54:13.31,Default,,0,0,0,,‫نعم. قبل وصولي بقليل، كان هناك انفجار صغير،
Dialogue: 0,0:54:13.31,0:54:15.81,Default,,0,0,0,,‫ويبدو أن المصعد توقف عن العمل.
Dialogue: 0,0:54:15.81,0:54:17.71,Default,,0,0,0,,‫-ماذا؟\N‫ -على الأرجح أن
Dialogue: 0,0:54:17.71,0:54:20.41,Default,,0,0,0,,‫المشتبه به اعتقد أن الشرطة حددت موقع القنبلة،
Dialogue: 0,0:54:20.41,0:54:23.61,Default,,0,0,0,,‫فاستخدم جهاز تحكم عن بعد لتفجيرها.
Dialogue: 0,0:54:26.21,0:54:29.01,Default,,0,0,0,,‫انفجرت غرفة التحكم في العجلة الدوارة فجأة.
Dialogue: 0,0:54:29.01,0:54:31.11,Default,,0,0,0,,‫لا يمكننا إيقاف العجلة.
Dialogue: 0,0:54:32.61,0:54:35.51,Default,,0,0,0,,‫إنه نفس ما حدث سابقًا.
Dialogue: 0,0:54:35.51,0:54:40.81,Default,,0,0,0,,‫سأذهب إلى المصعد المتوقف وأتفقد الأمور.
Dialogue: 0,0:54:40.81,0:54:41.91,Default,,0,0,0,,‫إياك!
Dialogue: 0,0:54:41.91,0:54:45.61,Default,,0,0,0,,‫تلك القنبلة وضعت لجذب الشرطة هناك، إنه فخ!
Dialogue: 0,0:54:45.61,0:54:48.91,Default,,0,0,0,,‫ماذا؟، فخ؟
Dialogue: 0,0:54:48.91,0:54:52.51,Default,,0,0,0,,‫سأكون هناك خلال 5 دقائق، فانتظر حتى أصل.
Dialogue: 0,0:54:52.51,0:54:53.71,Default,,0,0,0,,‫أتفهم؟
Dialogue: 0,0:54:53.71,0:54:55.11,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:54:55.11,0:54:57.31,Default,,0,0,0,,‫مهلا، لدينا مشكلة!
Dialogue: 0,0:54:58.61,0:55:01.61,Default,,0,0,0,,‫يبدو أن فتاة محتجزة في المصعد المتوقف
Dialogue: 0,0:55:01.61,0:55:03.81,Default,,0,0,0,,‫بسبب الانفجار منذ قليل.
Dialogue: 0,0:55:03.81,0:55:05.71,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:55:05.71,0:55:09.11,Default,,0,0,0,,‫انسة ساتو، هناك طفلة محتجزة في المصعد المتوقف.
Dialogue: 0,0:55:09.11,0:55:10.41,Default,,0,0,0,,‫أهدا
Dialogue: 0,0:55:10.41,0:55:13.61,Default,,0,0,0,,‫لا يزال أمامنا ساعتان قبل وقت التفجير المتوقع.
Dialogue: 0,0:55:13.61,0:55:18.31,Default,,0,0,0,,‫لكن من الأفضل أن أتفقد الأمور بأسرع ما يمكن.
Dialogue: 0,0:55:18.31,0:55:19.61,Default,,0,0,0,,‫لا تقلق.
Dialogue: 0,0:55:19.61,0:55:22.91,Default,,0,0,0,,‫سأجد حلاً، لذا ابقَ هنا فقط.
Dialogue: 0,0:55:22.91,0:55:24.61,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:55:24.61,0:55:26.41,Default,,0,0,0,,‫اسمعني، تاكاغي.
Dialogue: 0,0:55:26.41,0:55:29.21,Default,,0,0,0,,‫تأكد من إبعاد ميواكو عن المواقف الخطيرة.
Dialogue: 0,0:55:29.21,0:55:32.11,Default,,0,0,0,,‫سأنقذ تلك الفتاة. أعدك!
Dialogue: 0,0:55:32.11,0:55:33.31,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:55:33.31,0:55:36.31,Default,,0,0,0,,‫من يدري ماذا قد تفعل لاحقًا.
Dialogue: 0,0:55:36.31,0:55:38.61,Default,,0,0,0,,‫أتفهم؟
Dialogue: 0,0:55:38.61,0:55:42.01,Default,,0,0,0,,‫ابقَ هنا حتى أصل.
Dialogue: 0,0:55:42.01,0:55:43.61,Default,,0,0,0,,‫أتفهم، تاكاغي؟
Dialogue: 0,0:55:45.11,0:55:47.91,Default,,0,0,0,,‫مهلا، تاكاغي. هل تسمعني؟
Dialogue: 0,0:55:47.91,0:55:50.61,Default,,0,0,0,,‫الضابط تاكاغي، رد علي!
Dialogue: 0,0:55:50.61,0:55:52.31,Default,,0,0,0,,‫يا تاكاغي!
Dialogue: 0,0:55:52.31,0:55:54.31,Default,,0,0,0,,‫يا تاكاغي!
Dialogue: 0,0:55:54.31,0:55:56.71,Default,,0,0,0,,‫من فضلك، تاكاغي، لا تذهب!
Dialogue: 0,0:56:00.21,0:56:01.91,Default,,0,0,0,,‫سأذهب.
Dialogue: 0,0:56:05.51,0:56:09.41,Default,,0,0,0,,‫سأتفقد ما يحدث بالداخل.
Dialogue: 0,0:56:09.41,0:56:11.41,Default,,0,0,0,,‫ تاكاغي!
Dialogue: 0,0:56:15.31,0:56:16.51,Default,,0,0,0,,‫جميعكم!
Dialogue: 0,0:56:16.51,0:56:20.31,Default,,0,0,0,,‫سأدخل البرج الآن،
Dialogue: 0,0:56:20.31,0:56:23.11,Default,,0,0,0,,‫لذا ابقوا هنا وانتظروا، حسنًا؟
Dialogue: 0,0:56:23.11,0:56:24.41,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:56:24.41,0:56:26.21,Default,,0,0,0,,‫أتفهمون؟
Dialogue: 0,0:56:26.21,0:56:27.81,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:56:27.81,0:56:29.71,Default,,0,0,0,,‫سأعود حالاً!
Dialogue: 0,0:56:30.91,0:56:33.51,Default,,0,0,0,,‫أتساءل إذا كان الضابط تاكاجي سيكون بخير.
Dialogue: 0,0:56:34.91,0:56:37.51,Default,,0,0,0,,‫هايبرا، اعتني بالأطفال.
Dialogue: 0,0:56:39.31,0:56:41.21,Default,,0,0,0,,‫مهلا، كونان!
Dialogue: 0,0:56:41.21,0:56:43.81,Default,,0,0,0,,‫ماذا؟ هل ستذهب أيضًا، كونان؟
Dialogue: 0,0:56:43.81,0:56:47.01,Default,,0,0,0,,‫سأذهب فقط لأتفقد الأمور.
Dialogue: 0,0:56:47.01,0:56:50.11,Default,,0,0,0,,‫ابقوا على أهبة الاستعداد وتأكدوا من عدم اقتراب أي شخص مشبوه
Dialogue: 0,0:56:50.11,0:56:51.41,Default,,0,0,0,,‫من هذه السيارة.
Dialogue: 0,0:56:51.41,0:56:52.81,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:56:52.81,0:56:56.81,Default,,0,0,0,,‫سنواجه مشكلة كبيرة إذا تم زرع قنبلة في هذه السيارة مرة أخرى، أليس كذلك؟
Dialogue: 0,0:56:56.81,0:56:59.71,Default,,0,0,0,,‫لكنني أعلم أنكم، فريق المحققين الصغار،
Dialogue: 0,0:56:59.71,0:57:02.11,Default,,0,0,0,,‫ستتمكنون من التعامل مع الأمور حتى في غيابي، أليس كذلك؟
Dialogue: 0,0:57:02.11,0:57:03.71,Default,,0,0,0,,‫حسنًا، أعتقد ذلك.
Dialogue: 0,0:57:03.71,0:57:05.21,Default,,0,0,0,,‫اترك الأمر لنا.
Dialogue: 0,0:57:05.21,0:57:06.81,Default,,0,0,0,,‫إلى اللقاء!
Dialogue: 0,0:57:06.81,0:57:08.51,Default,,0,0,0,,‫كن حذرًا، كونان!
Dialogue: 0,0:57:16.51,0:57:19.71,Default,,0,0,0,,‫وفقًا لتقرير الضابط تاكاغي،
Dialogue: 0,0:57:19.71,0:57:21.01,Default,,0,0,0,,‫قبل حوالي 15 دقيقة،
Dialogue: 0,0:57:21.01,0:57:26.21,Default,,0,0,0,,‫كان هناك انفجار صغير قرب منطقة المراقبة الخاصة.
Dialogue: 0,0:57:26.21,0:57:30.81,Default,,0,0,0,,‫ويبدو أن أحد مصاعد المراقبة قد توقف.
Dialogue: 0,0:57:30.81,0:57:34.11,Default,,0,0,0,,‫لم يتم التأكد بعد إذا كان هذا الانفجار
Dialogue: 0,0:57:34.11,0:57:37.31,Default,,0,0,0,,‫بسبب قنبلة أو حادث.
Dialogue: 0,0:57:37.31,0:57:42.51,Default,,0,0,0,,‫لا، إنه يشبه كثيرًا ما حدث قبل 3 سنوات ليكون حادثًا.
Dialogue: 0,0:57:42.51,0:57:44.31,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:57:44.31,0:57:46.71,Default,,0,0,0,,‫هذا على الأرجح هو المكان الصحيح.
Dialogue: 0,0:57:48.51,0:57:50.41,Default,,0,0,0,,‫حالة طوارئ، حالة طوارئ!
Dialogue: 0,0:57:50.41,0:57:52.21,Default,,0,0,0,,‫من مقر الشرطة إلى جميع المحطات.
Dialogue: 0,0:57:52.21,0:57:53.81,Default,,0,0,0,,‫هناك احتمال كبير بأن
Dialogue: 0,0:57:53.81,0:57:56.51,Default,,0,0,0,,‫قنبلة قد زرعت في أبراج توتو في منطقة ميناتو.
Dialogue: 0,0:57:56.51,0:57:59.31,Default,,0,0,0,,‫توجهوا إلى الموقع على الفور
Dialogue: 0,0:57:59.31,0:58:01.31,Default,,0,0,0,,‫وأغلقوا مدخل برج توتو.
Dialogue: 0,0:58:01.31,0:58:04.71,Default,,0,0,0,,‫جهزوا موقع إخلاء للمواطنين في الجوار.
Dialogue: 0,0:58:06.41,0:58:07.71,Default,,0,0,0,,‫ تاكاغي.
Dialogue: 0,0:58:09.01,0:58:11.61,Default,,0,0,0,,‫إعلان طوارئ لجميع الزوار.
Dialogue: 0,0:58:11.61,0:58:16.31,Default,,0,0,0,,‫نعتذر عن إعلان إغلاق البرج اليوم.
Dialogue: 0,0:58:16.31,0:58:18.61,Default,,0,0,0,,‫يرجى اتباع توجيهات موظفينا
Dialogue: 0,0:58:18.61,0:58:21.11,Default,,0,0,0,,‫ومغادرة البرج فورًا.
Dialogue: 0,0:58:21.11,0:58:25.11,Default,,0,0,0,,‫لا داعي للاندفاع. يرجى الإخلاء ببطء.
Dialogue: 0,0:58:25.11,0:58:28.01,Default,,0,0,0,,‫المعذرة، أنا من الشرطة. اسمحوا لي بالدخول!
Dialogue: 0,0:58:28.01,0:58:30.11,Default,,0,0,0,,‫من فضلكم لا تذعروا.
Dialogue: 0,0:58:30.11,0:58:34.21,Default,,0,0,0,,‫أنا من الشرطة!، أين المصعد المتوقف؟
Dialogue: 0,0:58:34.21,0:58:36.71,Default,,0,0,0,,‫إنه المصعد في النهاية.
Dialogue: 0,0:58:36.71,0:58:38.51,Default,,0,0,0,,‫شكرًا.
Dialogue: 0,0:58:38.51,0:58:41.61,Default,,0,0,0,,‫أكيمي، ستكونين بخير. لا تخافي. تعالي إلى هنا.
Dialogue: 0,0:58:41.61,0:58:43.21,Default,,0,0,0,,‫أنا من الشرطة.
Dialogue: 0,0:58:43.21,0:58:46.51,Default,,0,0,0,,‫هل هذا المصعد الذي تحتجز فيه الفتاة؟
Dialogue: 0,0:58:46.51,0:58:47.91,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:58:47.91,0:58:49.51,Default,,0,0,0,,‫-لقد نزل من الطابق العلوي... \N‫-أكيمي...
Dialogue: 0,0:58:49.51,0:58:53.71,Default,,0,0,0,,‫وكان على وشك الوصول إلى هنا في سطح المراقبة الرئيسي عندما توقف.
Dialogue: 0,0:58:53.71,0:58:56.71,Default,,0,0,0,,‫أكيمي. ماذا تفعلين، أكيمي؟
Dialogue: 0,0:58:56.71,0:58:59.51,Default,,0,0,0,,‫أسرعي واخرجي!، تعالي إلى هنا!
Dialogue: 0,0:58:59.51,0:59:01.01,Default,,0,0,0,,‫أكيمي!
Dialogue: 0,0:59:01.01,0:59:03.51,Default,,0,0,0,,‫ هناك طفلة واحدة فقط في المصعد
Dialogue: 0,0:59:03.51,0:59:05.81,Default,,0,0,0,,‫لكنها خائفة جدًا ولا تسمع كلام أمها
Dialogue: 0,0:59:05.81,0:59:08.21,Default,,0,0,0,,‫التي تأمرها بالخروج.
Dialogue: 0,0:59:08.21,0:59:11.81,Default,,0,0,0,,‫هذه المساحة ضيقة جدًا ليدخلها شخص بالغ.
Dialogue: 0,0:59:11.81,0:59:13.61,Default,,0,0,0,,‫هل يمكنك حملي لأدخل إذن؟
Dialogue: 0,0:59:13.61,0:59:14.81,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:59:14.81,0:59:16.91,Default,,0,0,0,,‫يمكنني الدخول، أليس كذلك؟
Dialogue: 0,0:59:16.91,0:59:18.81,Default,,0,0,0,,‫كونان.
Dialogue: 0,0:59:20.41,0:59:23.81,Default,,0,0,0,,‫نستمر في بث الأخبار المباشرة من برج توتو.
Dialogue: 0,0:59:23.81,0:59:27.11,Default,,0,0,0,,‫اليوم، في حوالي الساعة 9:45 صباحًا،
Dialogue: 0,0:59:27.11,0:59:29.31,Default,,0,0,0,,‫وقع انفجار داخل برج توتو.
Dialogue: 0,0:59:29.31,0:59:31.11,Default,,0,0,0,,‫سبب الانفجار لا يزال مجهولاً.
Dialogue: 0,0:59:31.11,0:59:33.91,Default,,0,0,0,,‫لحسن الحظ، لم ترد أنباء عن إصابات،
Dialogue: 0,0:59:33.91,0:59:35.31,Default,,0,0,0,,‫لكن بسبب تأثير الانفجار،
Dialogue: 0,0:59:35.31,0:59:38.51,Default,,0,0,0,,‫توقف أحد المصاعد عن العمل.
Dialogue: 0,0:59:38.51,0:59:41.61,Default,,0,0,0,,‫فتاة تبلغ من العمر أربع سنوات كانت في المصعد
Dialogue: 0,0:59:41.61,0:59:43.51,Default,,0,0,0,,‫محتجزة بالداخل.
Dialogue: 0,0:59:43.51,0:59:47.21,Default,,0,0,0,,‫حاليًا، أثناء محاولة العثور على سبب الانفجار...
Dialogue: 0,1:00:03.91,1:00:05.61,Default,,0,0,0,,‫كونان، هل أنت بخير؟
Dialogue: 0,1:00:05.61,1:00:06.91,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:00:06.91,1:00:09.61,Default,,0,0,0,,‫مرحبًا، أكيمي.
Dialogue: 0,1:00:11.31,1:00:15.81,Default,,0,0,0,,‫سأقترب منك الآن، فانتظري، حسنًا؟
Dialogue: 0,1:00:20.41,1:00:23.61,Default,,0,0,0,,‫أكيمي، هذا دبدوب لطيف.
Dialogue: 0,1:00:23.61,1:00:25.61,Default,,0,0,0,,‫ما اسمه؟
Dialogue: 0,1:00:26.61,1:00:29.11,Default,,0,0,0,,‫جام.
Dialogue: 0,1:00:29.11,1:00:32.41,Default,,0,0,0,,‫يا له من اسم لطيف!، هل هو صبي؟
Dialogue: 0,1:00:32.41,1:00:34.31,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:00:34.31,1:00:38.91,Default,,0,0,0,,‫أريد أن أقترب وأحيي جام.
Dialogue: 0,1:00:38.91,1:00:40.21,Default,,0,0,0,,‫هل هذا مقبول؟
Dialogue: 0,1:00:40.21,1:00:41.71,Default,,0,0,0,,‫نعم، مقبول.
Dialogue: 0,1:00:41.71,1:00:43.51,Default,,0,0,0,,‫سأقترب الآن، حسنًا؟
Dialogue: 0,1:00:44.41,1:00:47.61,Default,,0,0,0,,‫لقد تلقينا تقريرًا يفيد بأن
Dialogue: 0,1:00:47.61,1:00:50.61,Default,,0,0,0,,‫ضابط شرطة دخل المصعد
Dialogue: 0,1:00:50.61,1:00:54.11,Default,,0,0,0,,‫لإنقاذ الفتاة المحتجزة بالداخل.
Dialogue: 0,1:00:55.21,1:00:58.01,Default,,0,0,0,,‫ماذا؟، طفل دخل المصعد؟
Dialogue: 0,1:00:58.01,1:00:59.61,Default,,0,0,0,,‫ايعقل!
Dialogue: 0,1:01:02.91,1:01:08.01,Default,,0,0,0,,‫واشترت لي أمي جام لعيد ميلادي.
Dialogue: 0,1:01:08.01,1:01:12.21,Default,,0,0,0,,‫فهمت، أمكِ تنتظركِ في الخارج، هل تريدين الذهاب؟
Dialogue: 0,1:01:12.21,1:01:13.41,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:01:22.21,1:01:24.61,Default,,0,0,0,,‫حسنًا، تعالي. فتاة مطيعة.
Dialogue: 0,1:01:26.01,1:01:28.01,Default,,0,0,0,,‫-أمي! \N‫-أكيمي!
Dialogue: 0,1:01:28.01,1:01:29.31,Default,,0,0,0,,‫أمي!
Dialogue: 0,1:01:29.31,1:01:30.81,Default,,0,0,0,,‫-أكيمي! \N‫-أمي!
Dialogue: 0,1:01:30.81,1:01:32.51,Default,,0,0,0,,‫أكيمي!
Dialogue: 0,1:01:36.51,1:01:38.91,Default,,0,0,0,,‫أنت أيضًا يا كونان!
Dialogue: 0,1:01:48.51,1:01:49.71,Default,,0,0,0,,‫كونان!
Dialogue: 0,1:01:51.61,1:01:53.01,Default,,0,0,0,,‫تبا!
Dialogue: 0,1:02:02.91,1:02:09.61,Default,,0,0,0,,‫تجاهلتني وانطلقت بشجاعة للإنقاذ، والآن أنت محاصر في المصعد مع كونان!
Dialogue: 0,1:02:09.61,1:02:11.91,Default,,0,0,0,,‫أنا آسف.
Dialogue: 0,1:02:11.91,1:02:17.11,Default,,0,0,0,,‫بالمناسبة، هل أنت متأكد أنه لا يوجد قنبلة في ذلك المصعد؟
Dialogue: 0,1:02:17.11,1:02:22.51,Default,,0,0,0,,‫لا، لا يوجد شيء يشبه القنبلة هنا في المصعد.
Dialogue: 0,1:02:22.51,1:02:25.61,Default,,0,0,0,,‫سأتفقد الجزء العلوي من المصعد الآن.
Dialogue: 0,1:02:37.31,1:02:40.71,Default,,0,0,0,,‫هل تعرف أين أنت الآن؟
Dialogue: 0,1:02:40.71,1:02:42.41,Default,,0,0,0,,‫ربما...
Dialogue: 0,1:02:42.41,1:02:44.61,Default,,0,0,0,,‫يبدو أن جميع الأسلاك قد قُطعت،
Dialogue: 0,1:02:44.61,1:02:47.21,Default,,0,0,0,,‫لذا أعتقد أننا مع الفرامل الطارئة
Dialogue: 0,1:02:47.21,1:02:52.21,Default,,0,0,0,,‫في مكان ما بين سطح المراقبة الرئيسي والطابق العلوي.
Dialogue: 0,1:02:52.21,1:02:53.21,Default,,0,0,0,,‫هل هذا صحيح؟
Dialogue: 0,1:02:53.21,1:02:55.81,Default,,0,0,0,,‫أعتقد أن عليّ تسلق السقف
Dialogue: 0,1:02:55.81,1:02:58.11,Default,,0,0,0,,‫وانتظر فريق الإنقاذ.
Dialogue: 0,1:02:58.11,1:03:00.21,Default,,0,0,0,,‫لا، لا تتسلق إلى السقف!
Dialogue: 0,1:03:00.21,1:03:02.81,Default,,0,0,0,,‫رافعة الزئبق ستعمل!
Dialogue: 0,1:03:02.81,1:03:05.51,Default,,0,0,0,,‫رافعة الزئبق؟
Dialogue: 0,1:03:05.51,1:03:07.11,Default,,0,0,0,,‫رافعة الزئبق؟
Dialogue: 0,1:03:08.11,1:03:11.31,Default,,0,0,0,,‫أقل هزة يمكن أن تجعل قطرة الزئبق تتدحرج،
Dialogue: 0,1:03:11.31,1:03:13.41,Default,,0,0,0,,‫وإذا لامست القطرة السلك، ينتهي كل شيء.
Dialogue: 0,1:03:14.41,1:03:18.31,Default,,0,0,0,,‫كونان، ما هي رافعة الزئبق؟
Dialogue: 0,1:03:18.31,1:03:21.11,Default,,0,0,0,,‫إنها جزء من جهاز تفجير القنبلة.
Dialogue: 0,1:03:21.11,1:03:23.31,Default,,0,0,0,,‫إنها قنبلة كبيرة بما يكفي لتكون قادرة على
Dialogue: 0,1:03:23.31,1:03:25.81,Default,,0,0,0,,‫ليس فقط تفجير هذا المصعد
Dialogue: 0,1:03:25.81,1:03:27.71,Default,,0,0,0,,‫بل برج توتو بأكمله أيضًا.
Dialogue: 0,1:03:39.73,1:03:42.03,Default,,0,0,0,,‫قنبلة؟
Dialogue: 0,1:03:42.03,1:03:44.73,Default,,0,0,0,,‫على سقف هذا المصعد؟
Dialogue: 0,1:03:44.73,1:03:48.43,Default,,0,0,0,,‫هل أنت متأكد من ذلك، كونان؟
Dialogue: 0,1:03:48.43,1:03:53.83,Default,,0,0,0,,‫نعم. لقد رأيت قنابل تبدو تمامًا مثل هذه على التلفزيون.
Dialogue: 0,1:03:53.83,1:03:56.93,Default,,0,0,0,,‫سمعت أنه إذا كان سائلًا واحدًا فقط فلا بأس،
Dialogue: 0,1:03:56.93,1:03:58.33,Default,,0,0,0,,‫ولكن عندما يختلط بالسائل الآخر،
Dialogue: 0,1:03:58.33,1:04:00.93,Default,,0,0,0,,‫يتحول إلى قنبلة قوية جدًا.
Dialogue: 0,1:04:00.93,1:04:03.03,Default,,0,0,0,,‫إذن، أليس هذا سببًا إضافيًا
Dialogue: 0,1:04:03.03,1:04:05.93,Default,,0,0,0,,‫لجعل فريق الإنقاذ يأتي إلى هنا؟
Dialogue: 0,1:04:05.93,1:04:10.03,Default,,0,0,0,,‫لقد قلت للتو أن رافعة الزئبق مضبوطة، أليس كذلك؟
Dialogue: 0,1:04:10.03,1:04:12.93,Default,,0,0,0,,‫من المرجح أن المفتاح قد تم تشغيله
Dialogue: 0,1:04:12.93,1:04:14.83,Default,,0,0,0,,‫بسبب تأثير توقف المصعد منذ قليل.
Dialogue: 0,1:04:16.63,1:04:21.53,Default,,0,0,0,,‫حتى أقل حركة ستسبب انفجار هذا الشيء.
Dialogue: 0,1:04:21.53,1:04:38.13,Default,,0,0,0,,‫لذا، إذا حاولت التسلق إلى هنا، أو إذا حاول فريق الإنقاذ النزول، فسوف ينفجر بنا جميعًا!
Dialogue: 0,1:04:34.43,1:04:38.13,Default,,0,0,0,,‫هل هي بهذه القوة؟
Dialogue: 0,1:04:38.13,1:04:39.93,Default,,0,0,0,,‫رافعة الزئبق.
Dialogue: 0,1:04:42.13,1:04:43.83,Default,,0,0,0,,‫رافعة الزئبق...
Dialogue: 0,1:04:45.53,1:04:47.13,Default,,0,0,0,,‫كما توقعت.
Dialogue: 0,1:04:47.13,1:04:48.63,Default,,0,0,0,,‫أنا متأكد من أن الشخص الذي نصب هذا
Dialogue: 0,1:04:48.63,1:04:51.13,Default,,0,0,0,,‫هو نفس المفجر منذ ثلاث سنوات.
Dialogue: 0,1:04:54.13,1:04:57.93,Default,,0,0,0,,‫إذن، ايعقل...
Dialogue: 0,1:04:58.63,1:05:05.53,Default,,0,0,0,,‫ماذا عن أن نطلب منهم إنزال حبل من فتحة المصعد فوقنا؟
Dialogue: 0,1:05:05.53,1:05:07.93,Default,,0,0,0,,‫لا أعتقد أن هذا سينجح أيضًا.
Dialogue: 0,1:05:07.93,1:05:09.13,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,1:05:09.13,1:05:13.73,Default,,0,0,0,,‫هناك جهاز تنصت بالقرب من القنبلة.
Dialogue: 0,1:05:13.73,1:05:16.23,Default,,0,0,0,,‫لذا، أنا متأكد من أن المفجر
Dialogue: 0,1:05:16.23,1:05:18.63,Default,,0,0,0,,‫يستمع إلى محادثتنا من مكان ما.
Dialogue: 0,1:05:18.63,1:05:21.93,Default,,0,0,0,,‫وفي اللحظة التي نغادر فيها ويتوقف عن سماع محادثتنا،
Dialogue: 0,1:05:21.93,1:05:24.83,Default,,0,0,0,,‫سيقوم بتشغيل المفتاح وتفجير القنبلة.
Dialogue: 0,1:05:24.83,1:05:28.73,Default,,0,0,0,,‫مما يعني أننا محاصرون في كلتا الحالتين.
Dialogue: 0,1:05:28.73,1:05:31.33,Default,,0,0,0,,‫لا، لا يزال لدينا مخرج واحد.
Dialogue: 0,1:05:34.53,1:05:37.63,Default,,0,0,0,,‫عليّ تفكيك هذه القنبلة.
Dialogue: 0,1:05:37.63,1:05:41.03,Default,,0,0,0,,‫لكنني بحاجة إلى إنزال أدوات التفكيك من الأعلى.
Dialogue: 0,1:05:44.53,1:05:45.93,Default,,0,0,0,,‫أكرر.
Dialogue: 0,1:05:45.93,1:05:48.03,Default,,0,0,0,,‫جميع المواطنين في محيط برج توتو،
Dialogue: 0,1:05:48.03,1:05:52.43,Default,,0,0,0,,‫يرجى اتباع تعليمات الشرطة والإخلاء إلى مكان آمن.
Dialogue: 0,1:05:52.43,1:05:55.43,Default,,0,0,0,,‫-ماذا؟ -\N‫هل نهرب؟
Dialogue: 0,1:05:55.43,1:05:59.43,Default,,0,0,0,,‫كونان والضابط تاكاغي ما زالا هناك.
Dialogue: 0,1:05:59.43,1:06:02.13,Default,,0,0,0,,‫لا داعي للقلق،
Dialogue: 0,1:06:02.13,1:06:05.83,Default,,0,0,0,,‫سيعودان إلى هنا قريبًا.
Dialogue: 0,1:06:05.83,1:06:09.33,Default,,0,0,0,,‫ تشيبا، اصطحب الأطفال إلى مكان آمن.
Dialogue: 0,1:06:09.33,1:06:11.53,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,1:06:11.53,1:06:15.23,Default,,0,0,0,,‫أنتِ تريدين أن تجعلي هذين يفككان القنبلة
Dialogue: 0,1:06:15.23,1:06:17.23,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,1:06:17.23,1:06:23.13,Default,,0,0,0,,‫لهذا فإن فريق تفكيك القنابل في الخارج ينتظر الأوامر.
Dialogue: 0,1:06:23.23,1:06:25.53,Default,NTP,0,0000,0000,0000,‫إذن هذا هو المقصود، أليس كذلك؟
Dialogue: 0,1:06:25.53,1:06:27.33,Default,,0,0,0,,‫سيكونون بخير.
Dialogue: 0,1:06:27.33,1:06:29.63,Default,,0,0,0,,‫تركيبة القنبلة هي نفسها تقريبًا
Dialogue: 0,1:06:29.63,1:06:34.23,Default,,0,0,0,,‫التي نُصبت في مستشفى بيكا المركزي منذ 3 سنوات،
Dialogue: 0,1:06:34.23,1:06:37.13,Default,,0,0,0,,‫لذا هذان الاثنان سيتدبران الأمر بطريقة ما.
Dialogue: 0,1:06:37.13,1:06:39.03,Default,,0,0,0,,‫نعم، أعتقد ذلك.
Dialogue: 0,1:06:40.13,1:06:42.03,Default,,0,0,0,,‫طالما أنهم لا يصغون
Dialogue: 0,1:06:42.03,1:06:44.83,Default,,0,0,0,,‫لصوت الشيطان، كما حدث منذ 3 سنوات...
Dialogue: 0,1:06:48.53,1:06:50.73,Default,,0,0,0,,‫أنزله ببطء.
Dialogue: 0,1:06:50.73,1:06:53.43,Default,,0,0,0,,‫بهدوء الآن، بهدوء.
Dialogue: 0,1:06:53.43,1:06:55.73,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,1:06:58.73,1:07:00.03,Default,,0,0,0,,‫هل أنت بخير؟
Dialogue: 0,1:07:00.03,1:07:01.93,Default,,0,0,0,,‫حسنًا، لقد حصلت عليه!
Dialogue: 0,1:07:03.83,1:07:05.23,Default,,0,0,0,,‫حاضر!
Dialogue: 0,1:07:05.23,1:07:08.23,Default,,0,0,0,,‫لقد أكملنا إعطاء المعدات.
Dialogue: 0,1:07:08.23,1:07:09.53,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,1:07:09.53,1:07:13.43,Default,,0,0,0,,‫حسنًا، تاكاغي، لنبدأ.
Dialogue: 0,1:07:13.43,1:07:14.73,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:07:14.73,1:07:16.33,Default,,0,0,0,,‫أيها الأحمق!
Dialogue: 0,1:07:16.33,1:07:19.33,Default,,0,0,0,,‫كن رجلاً وتوقف عن الذعر!
Dialogue: 0,1:07:19.33,1:07:23.13,Default,,0,0,0,,‫الشخص الذي سيقوم بالعمل الفعلي هو الصبي الذي معك!
Dialogue: 0,1:07:23.13,1:07:27.93,Default,,0,0,0,,‫إذا شعرت بالارتباك، قد تجعله قلقًا وهذا قد يؤدي إلى أخطاء غير مقصودة!
Dialogue: 0,1:07:27.93,1:07:29.13,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:07:29.13,1:07:30.63,Default,,0,0,0,,‫لا تقلق.
Dialogue: 0,1:07:30.63,1:07:34.23,Default,,0,0,0,,‫إذا كنت هادئًا واتبعت تعليماتنا، فسيكون هذا منتهيًا في لمح البصر.
Dialogue: 0,1:07:34.23,1:07:35.93,Default,,0,0,0,,‫اهدأ!
Dialogue: 0,1:07:35.93,1:07:37.23,Default,,0,0,0,,‫فهمت.
Dialogue: 0,1:07:37.23,1:07:39.63,Default,,0,0,0,,‫حسنًا. أولاً،
Dialogue: 0,1:07:39.63,1:07:41.93,Default,,0,0,0,,‫لنبدأ بإزالة جهاز التفجير الحساس للضوء.
Dialogue: 0,1:07:41.93,1:07:43.23,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:07:43.23,1:07:47.13,Default,,0,0,0,,‫سنقوم بإطفاء أضواء المصعد بعد دقيقة من الآن،
Dialogue: 0,1:07:47.13,1:07:49.53,Default,,0,0,0,,‫لذا ارتدوا نظارة الرؤية الليلية بالأشعة تحت الحمراء.
Dialogue: 0,1:07:51.93,1:07:56.63,Default,,0,0,0,,‫عندما يحل الظلام، أزيلوا الغطاء الجانبي الأيمن لرافعة الزئبق.
Dialogue: 0,1:07:56.63,1:07:59.33,Default,,0,0,0,,‫احرصوا على عدم لمس رافعة الزئبق.
Dialogue: 0,1:07:59.33,1:08:02.93,Default,,0,0,0,,‫أولاً، نزيل الغطاء، أليس كذلك؟
Dialogue: 0,1:08:02.93,1:08:06.03,Default,,0,0,0,,‫صحيح. سنقوم بإطفاء الأضواء الآن.
Dialogue: 0,1:08:07.43,1:08:09.73,Default,,0,0,0,,‫هل فهمت ذلك، كونان؟
Dialogue: 0,1:08:12.73,1:08:14.93,Default,,0,0,0,,‫كونان؟
Dialogue: 0,1:08:14.93,1:08:17.63,Default,,0,0,0,,‫ها هو. الأنبوب الحساس للضوء.
Dialogue: 0,1:08:17.63,1:08:20.23,Default,,0,0,0,,‫إذا قطعت الحبل...
Dialogue: 0,1:08:22.93,1:08:25.33,Default,,0,0,0,,‫هذا واحد.
Dialogue: 0,1:08:25.33,1:08:27.53,Default,,0,0,0,,‫كونان، هل تسمعني؟
Dialogue: 0,1:08:27.53,1:08:30.63,Default,,0,0,0,,‫نعم!، أستطيع سماعك، لذا تابع.
Dialogue: 0,1:08:30.63,1:08:32.63,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:08:32.63,1:08:34.03,Default,,0,0,0,,‫لنرى.
Dialogue: 0,1:08:34.03,1:08:37.53,Default,,0,0,0,,‫إذا نزعت الغطاء، يمكنك رؤية الكثير من الآلات، أليس كذلك؟
Dialogue: 0,1:08:37.53,1:08:41.33,Default,,0,0,0,,‫فوق تلك الآلات مباشرة، يجب أن ترى جهازًا يتحرك
Dialogue: 0,1:08:41.33,1:08:44.83,Default,,0,0,0,,‫عندما يكتشف الضوء يسمى الأنبوب الحساس للضوء.
Dialogue: 0,1:08:44.83,1:08:47.23,Default,,0,0,0,,‫أولاً، اقطع الحبل
Dialogue: 0,1:08:47.23,1:08:48.73,Default,,0,0,0,,‫البارز من الأنبوب الحساس للضوء.
Dialogue: 0,1:08:48.73,1:08:50.83,Default,,0,0,0,,‫ثم، أدر هذا...
Dialogue: 0,1:08:53.53,1:08:55.93,Default,,0,0,0,,‫الكهرباء تعمل!
Dialogue: 0,1:08:55.93,1:08:58.03,Default,,0,0,0,,‫ كان ذلك وشيكًا!
Dialogue: 0,1:08:58.03,1:09:00.33,Default,,0,0,0,,‫حسنًا، إذن. سأضع اللوحة البلاستيكية في هذه المساحة
Dialogue: 0,1:09:00.33,1:09:03.23,Default,,0,0,0,,‫واستخدمها كمانع.
Dialogue: 0,1:09:03.23,1:09:05.13,Default,,0,0,0,,‫مانع؟
Dialogue: 0,1:09:05.13,1:09:07.83,Default,,0,0,0,,‫بالمناسبة، ذلك اللغز...
Dialogue: 0,1:09:07.83,1:09:11.63,Default,,0,0,0,,‫"لا فائدة من تحضير مانع جيد"، هذا ما قاله.
Dialogue: 0,1:09:12.73,1:09:16.73,Default,,0,0,0,,‫المانع الجيد يعني على الأرجح متوسط الأرباح.
Dialogue: 0,1:09:18.73,1:09:22.13,Default,,0,0,0,,‫لكن، لماذا لاعب دوري رئيسي؟
Dialogue: 0,1:09:22.13,1:09:24.03,Default,,0,0,0,,‫نحن في اليابان.
Dialogue: 0,1:09:24.03,1:09:26.43,Default,,0,0,0,,‫كان يمكنه فقط كتابة لاعب بيسبول محترف.
Dialogue: 0,1:09:28.63,1:09:30.33,Default,,0,0,0,,‫ لحظة.
Dialogue: 0,1:09:30.33,1:09:34.33,Default,,0,0,0,,‫أشواط إضافية... متوسط الضربات...
Dialogue: 0,1:09:34.33,1:09:37.33,Default,,0,0,0,,‫قلب اللعبة... لاعب دوري رئيسي...
Dialogue: 0,1:09:38.23,1:09:41.73,Default,,0,0,0,,‫ايعقل أن القنبلة الأخرى موجودة في...
Dialogue: 0,1:09:44.63,1:09:47.33,Default,,0,0,0,,‫لا يزال هناك الكثير من الوقت،
Dialogue: 0,1:09:47.33,1:09:49.73,Default,,0,0,0,,‫لكن ما لم أعرف مكانها...
Dialogue: 0,1:09:54.03,1:09:55.43,Default,,0,0,0,,‫الآن استمع، كونان.
Dialogue: 0,1:09:55.43,1:09:57.23,Default,,0,0,0,,‫عندما تنتهي مما تفعله، بعد ذلك...
Dialogue: 0,1:09:57.23,1:10:00.03,Default,,0,0,0,,‫يا ضابط تاكاغي.
Dialogue: 0,1:10:00.03,1:10:01.83,Default,,0,0,0,,‫ما الأمر، كونان؟
Dialogue: 0,1:10:01.83,1:10:05.03,Default,,0,0,0,,‫لدي شيء أريد مناقشته معك.
Dialogue: 0,1:10:09.53,1:10:11.23,Default,,0,0,0,,‫ما الذي يحدث؟
Dialogue: 0,1:10:11.23,1:10:13.43,Default,,0,0,0,,‫الآن، إنها مروحيات محطات التلفزيون!
Dialogue: 0,1:10:13.43,1:10:16.23,Default,,0,0,0,,‫أتساءل إذا كان شيء ما قد حدث بعد كل شيء.
Dialogue: 0,1:10:16.23,1:10:18.13,Default,,0,0,0,,‫انتم!
Dialogue: 0,1:10:18.13,1:10:19.13,Default,,0,0,0,,‫تبًا!
Dialogue: 0,1:10:19.13,1:10:22.43,Default,,0,0,0,,‫نحن نجري امتحان الآن. كونوا هادئين.
Dialogue: 0,1:10:22.43,1:10:25.23,Default,,0,0,0,,‫الوقت الآن هو 11:40.
Dialogue: 0,1:10:25.23,1:10:29.33,Default,,0,0,0,,‫لم يتبق سوى أقل من 20 دقيقة قبل انفجار القنبلة.
Dialogue: 0,1:10:29.33,1:10:33.13,Default,,0,0,0,,‫الصبي والضابط المحاصران مع القنبلة
Dialogue: 0,1:10:33.13,1:10:35.43,Default,,0,0,0,,‫لم يتم إنقاذهما بعد.
Dialogue: 0,1:10:35.43,1:10:37.73,Default,,0,0,0,,‫الوقت ينفد بسرعة.
Dialogue: 0,1:10:37.73,1:10:41.93,Default,,0,0,0,,‫ما الذي سيحدث للصبي والضابط؟
Dialogue: 0,1:10:41.93,1:10:47.03,Default,,0,0,0,,‫هل سيهلكان مع رمز طوكيو؟
Dialogue: 0,1:10:49.03,1:10:51.83,Default,,0,0,0,,‫ماذا؟ لا يستطيع قطع الحبل؟
Dialogue: 0,1:10:51.83,1:10:54.33,Default,,0,0,0,,‫لم يتبق سوى ثلاثة فقط!
Dialogue: 0,1:10:54.33,1:10:58.33,Default,,0,0,0,,‫أولاً، الحبل الأصفر لإيقاف لوحة العرض.
Dialogue: 0,1:10:58.33,1:11:01.63,Default,,0,0,0,,‫بعد ذلك، الحبل الأبيض المتصل برافعة الزئبق.
Dialogue: 0,1:11:01.63,1:11:04.33,Default,,0,0,0,,‫والحبل الهاتفي الأسود الموضوع هناك
Dialogue: 0,1:11:04.33,1:11:07.63,Default,,0,0,0,,‫للتلاعب بالتحكم عن بعد.
Dialogue: 0,1:11:07.63,1:11:10.03,Default,,0,0,0,,‫إذا قطعته بهذا الترتيب، ستتوقف القنبلة تمامًا.
Dialogue: 0,1:11:11.23,1:11:14.43,Default,,0,0,0,,‫كيف لا تستطيع فعل ذلك بعد أن وصلت إلى هذا الحد؟
Dialogue: 0,1:11:14.43,1:11:15.63,Default,,0,0,0,,‫أعطيني الهاتف!
Dialogue: 0,1:11:15.63,1:11:17.43,Default,,0,0,0,,‫يا تاكاغي!، ما الذي تفعله؟
Dialogue: 0,1:11:17.43,1:11:19.93,Default,,0,0,0,,‫أسرع!، أسرع واقطعه!
Dialogue: 0,1:11:19.93,1:11:22.73,Default,,0,0,0,,‫لا يمكننا قطعه.
Dialogue: 0,1:11:22.73,1:11:26.13,Default,,0,0,0,,‫عن ماذا تتحدث؟ لم يتبق سوى 10 دقائق.
Dialogue: 0,1:11:26.13,1:11:28.63,Default,,0,0,0,,‫"إلى الضابط الشجاع."
Dialogue: 0,1:11:28.63,1:11:29.93,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,1:11:29.93,1:11:34.13,Default,,0,0,0,,‫"تقديرًا لشجاعتك، سنمنحك جائزة.
Dialogue: 0,1:11:34.13,1:11:38.43,Default,,0,0,0,,‫دليل مكان وجود الألعاب النارية الكبيرة التي ستنهي هذه اللعبة
Dialogue: 0,1:11:38.43,1:11:42.03,Default,,0,0,0,,‫قبل 3 ثوان من الانفجار.
Dialogue: 0,1:11:42.03,1:11:44.43,Default,,0,0,0,,‫حظاً موقفاً."
Dialogue: 0,1:11:44.43,1:11:49.73,Default,,0,0,0,,‫يقول كونان أن هذه هي الكلمات المعروضة على لوحة العرض.
Dialogue: 0,1:11:50.53,1:11:53.93,Default,,0,0,0,,‫أود على الأقل إخراج كونان بطريقة ما،
Dialogue: 0,1:11:53.93,1:11:55.13,Default,,0,0,0,,‫لكن لتحديد المكان الآخر حيث تم وضع القنبلة
Dialogue: 0,1:11:55.13,1:11:56.53,Default,,0,0,0,,‫وتجنب وقوع عدد كبير من الضحايا،
Dialogue: 0,1:11:56.53,1:11:58.43,Default,,0,0,0,,‫يبدو أنه ليس لدينا خيار آخر  
Dialogue: 0,1:11:58.43,1:12:00.83,Default,,0,0,0,,‫سوى أن ينظر كونان إلى التلميح  
Dialogue: 0,1:12:00.83,1:12:06.53,Default,,0,0,0,,‫وأنا أنقل الموقع عبر الهاتف.  
Dialogue: 0,1:12:09.63,1:12:11.03,Default,,0,0,0,,‫أنا آسف.  
Dialogue: 0,1:12:12.33,1:12:14.03,Default,,0,0,0,,‫ تاكاغي.  
Dialogue: 0,1:12:14.03,1:12:18.63,Default,,0,0,0,,‫لكنكِ تفهمين الأمر، أليس كذلك؟  
Dialogue: 0,1:12:21.53,1:12:22.73,Default,,0,0,0,,‫أحمق.  
Dialogue: 0,1:12:25.33,1:12:26.83,Default,,0,0,0,,‫4 دقائق متبقية!  
Dialogue: 0,1:12:26.83,1:12:29.13,Default,,0,0,0,,‫لم يتبق سوى 4 دقائق حتى تنفجر القنبلة.  
Dialogue: 0,1:12:29.13,1:12:31.73,Default,,0,0,0,,‫الموقت لم يتوقف بعد.  
Dialogue: 0,1:12:31.73,1:12:34.43,Default,,0,0,0,,‫أيها المفجر. إذا كنت تشاهد هذا البث،  
Dialogue: 0,1:12:34.43,1:12:38.03,Default,,0,0,0,,‫أرجوك أوقف الموقت، من فضلك!  
Dialogue: 0,1:12:38.03,1:12:41.33,Default,,0,0,0,,‫إذا كان لديك ذرة من ضمير.  
Dialogue: 0,1:12:43.73,1:12:45.23,Default,,0,0,0,,‫الضمير...  
Dialogue: 0,1:12:47.03,1:12:51.43,Default,,0,0,0,,‫ما زلت لا أصدق أن كل شيء يسير بهذا الشكل الجيد.  
Dialogue: 0,1:12:51.43,1:12:53.93,Default,,0,0,0,,‫إذن، لماذا لا تلتقط بث التلفزيون عبر الراديو  
Dialogue: 0,1:12:53.93,1:12:56.53,Default,,0,0,0,,‫وتستمع إلى قصتنا البطولية؟  
Dialogue: 0,1:12:59.93,1:13:02.63,Default,,0,0,0,,‫موقت القنبلة ما زال يعمل.  
Dialogue: 0,1:13:02.63,1:13:05.23,Default,,0,0,0,,‫-ماذا؟\N‫ -أيها المفجر، هل تشاهد؟  
Dialogue: 0,1:13:05.23,1:13:08.93,Default,,0,0,0,,‫ايعقل أن جهاز التحكم عن بعد لم يعمل بشكل صحيح!  
Dialogue: 0,1:13:08.93,1:13:12.33,Default,,0,0,0,,‫انسَ الأمر،  لقد حصلنا على المال.  
Dialogue: 0,1:13:12.33,1:13:16.03,Default,,0,0,0,,‫عليّ أن أتصل بالشرطة وأخبرهم…...  
Dialogue: 0,1:13:16.03,1:13:17.33,Default,,0,0,0,,‫مهلا!  
Dialogue: 0,1:13:17.33,1:13:19.03,Default,,0,0,0,,‫بكيفية تعطيلها!  
Dialogue: 0,1:13:19.03,1:13:20.63,Default,,0,0,0,,‫مهلا!، انتظر!  
Dialogue: 0,1:13:31.33,1:13:33.13,Default,,0,0,0,,‫الشرطة...  
Dialogue: 0,1:13:33.13,1:13:37.33,Default,,0,0,0,,‫هؤلاء الشرطة استغلوا ضميره  
Dialogue: 0,1:13:37.33,1:13:39.63,Default,,0,0,0,,‫وقتلوه.  
Dialogue: 0,1:13:41.53,1:13:43.93,Default,,0,0,0,,‫أشعر بالأسف على الصبي. 
Dialogue: 0,1:13:43.93,1:13:45.63,Default,,0,0,0,,‫لكن إذا انفجرت القنبلة، سيتم إلقاء اللوم على الشرطة  
Dialogue: 0,1:13:45.63,1:13:47.33,Default,,0,0,0,,‫لعدم تمكنهم من إنقاذ الصبي. 
Dialogue: 0,1:13:47.33,1:13:49.93,Default,,0,0,0,,‫إذا تراجعوا وأوقفوا القنبلة قبل انفجارها،  
Dialogue: 0,1:13:49.93,1:13:53.53,Default,,0,0,0,,‫لن يحصلوا على الدليل الذي يحتاجونه لإنقاذ مئات الأرواح.  
Dialogue: 0,1:13:56.63,1:14:00.23,Default,,0,0,0,,‫سأكشف هذا للصحافة  
Dialogue: 0,1:14:00.23,1:14:05.03,Default,,0,0,0,,‫وسيتم فضح الخطأ الفادح للشرطة علناً.  
Dialogue: 0,1:14:05.03,1:14:08.83,Default,,0,0,0,,‫في كلتا الحالتين، الشرطة منتهية.  
Dialogue: 0,1:14:14.43,1:14:18.13,Default,,0,0,0,,‫إذن، هذا ما يعنيه اللغز.
Dialogue: 0,1:14:20.13,1:14:23.73,Default,,0,0,0,,‫إذا تحدثت بصوت عالٍ، سيسمعنا المفجر.  
Dialogue: 0,1:14:25.43,1:14:30.53,Default,,0,0,0,,‫لكن هناك أكثر من 400 مكان منهم في طوكيو.
Dialogue: 0,1:14:30.53,1:14:37.13,Default,,0,0,0,,‫نعم. سيكون من المستحيل تفقد كل الأماكن من الآن  
Dialogue: 0,1:14:37.13,1:14:38.93,Default,,0,0,0,,‫دون أن يلاحظ المفجر.  
Dialogue: 0,1:14:40.33,1:14:43.33,Default,,0,0,0,,‫إذا حاولنا إخلاء جميع الأشخاص
Dialogue: 0,1:14:43.33,1:14:45.53,Default,,0,0,0,,‫في أكثر من 400 موقع...
Dialogue: 0,1:14:45.53,1:14:47.53,Default,,0,0,0,,‫بناءً على شخصية المفجر،
Dialogue: 0,1:14:47.53,1:14:50.23,Default,,0,0,0,,‫سيقوم على الأرجح بتشغيل القنبلة عن بعد.
Dialogue: 0,1:14:51.53,1:14:55.13,Default,,0,0,0,,‫بمعنى آخر، لإنقاذ الجميع بالتأكيد...
Dialogue: 0,1:14:55.13,1:14:56.93,Default,,0,0,0,,‫ليس لدينا خيار آخر
Dialogue: 0,1:14:56.93,1:15:02.23,Default,,0,0,0,,‫سوى أن ننظر إلى الدليل، ونبحث بدقة في المكان الصحيح، ونحدد موقع القنبلة.
Dialogue: 0,1:15:02.23,1:15:06.23,Default,,0,0,0,,‫تمامًا كما فعل الضابط ماتسودا، أليس كذلك؟
Dialogue: 0,1:15:06.23,1:15:07.73,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:15:07.73,1:15:09.13,Default,,0,0,0,,‫وبالإضافة إلى ذلك،
Dialogue: 0,1:15:09.13,1:15:12.23,Default,,0,0,0,,‫قد تكون هناك،
Dialogue: 0,1:15:12.23,1:15:15.73,Default,,0,0,0,,‫أهم شخص في العالم بالنسبة لي. لا يمكنني تركها تموت.
Dialogue: 0,1:15:17.73,1:15:20.63,Default,,0,0,0,,‫أنا آسف ايها الضابط تاكاغي.
Dialogue: 0,1:15:20.63,1:15:22.73,Default,,0,0,0,,‫لا بأس.
Dialogue: 0,1:15:22.73,1:15:25.23,Default,,0,0,0,,‫قل لي يا كونان.
Dialogue: 0,1:15:25.23,1:15:28.93,Default,,0,0,0,,‫أخبرني بشيء واحد فقط...
Dialogue: 0,1:15:28.93,1:15:33.53,Default,,0,0,0,,‫من تكون انت بالضبط؟
Dialogue: 0,1:15:35.93,1:15:37.53,Default,,0,0,0,,‫إذا كنت تريد أن تعرف...
Dialogue: 0,1:15:39.53,1:15:41.83,Default,,0,0,0,,‫سأخبرك...
Dialogue: 0,1:15:48.23,1:15:49.83,Default,,0,0,0,,‫في العالم الآخر.
Dialogue: 0,1:15:49.83,1:15:52.23,Default,,0,0,0,,‫لم يتم إنقاذ الاثنين بعد.
Dialogue: 0,1:15:52.23,1:15:54.03,Default,,0,0,0,,‫لم يتبق سوى دقيقة واحدة.
Dialogue: 0,1:15:54.03,1:15:55.63,Default,,0,0,0,,‫الثواني تنفد!
Dialogue: 0,1:15:55.63,1:15:58.33,Default,,0,0,0,,‫مهلا!، ما الذي يحدث؟
Dialogue: 0,1:15:58.33,1:16:01.53,Default,,0,0,0,,‫كونان والضابط تاكاغي ما زالا في الداخل!
Dialogue: 0,1:16:01.53,1:16:03.43,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,1:16:03.43,1:16:05.33,Default,,0,0,0,,‫يبدو أن أفراد فرقة مكافحة الشغب
Dialogue: 0,1:16:05.33,1:16:06.83,Default,,0,0,0,,‫قد تم إخلاؤهم أيضًا!
Dialogue: 0,1:16:06.83,1:16:10.53,Default,,0,0,0,,‫أعدنا إلى برج توتو!
Dialogue: 0,1:16:10.53,1:16:12.23,Default,,0,0,0,,‫مهلا، هذا خطير، خطير!
Dialogue: 0,1:16:12.23,1:16:14.23,Default,,0,0,0,,‫خذنا هناك!، هيا، تشيبا!
Dialogue: 0,1:16:14.23,1:16:16.13,Default,,0,0,0,,‫خذنا هناك!
Dialogue: 0,1:16:16.13,1:16:18.43,Default,,0,0,0,,‫لقد استمعوا إليها.
Dialogue: 0,1:16:18.43,1:16:21.93,Default,,0,0,0,,‫نفس كلمات الشيطان، كما كانت قبل 3 سنوات...
Dialogue: 0,1:16:28.03,1:16:30.53,Default,,0,0,0,,‫لكنني أعرفكم يا فريق المحققين الصغار،
Dialogue: 0,1:16:30.53,1:16:33.03,Default,,0,0,0,,‫ستتمكنون من التعامل مع الأمور حتى لو لم أكن هنا، أليس كذلك؟
Dialogue: 0,1:16:33.03,1:16:35.43,Default,,0,0,0,,‫كونان!
Dialogue: 0,1:16:37.33,1:16:39.43,Default,,0,0,0,,‫15 ثانية متبقية.
Dialogue: 0,1:16:39.43,1:16:41.93,Default,,0,0,0,,‫هل أنت مستعد ايها الضابط تاكاغي؟
Dialogue: 0,1:16:41.93,1:16:43.23,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:16:43.23,1:16:46.73,Default,,0,0,0,,‫لقد كتبت كل استنتاجاتك في الرسالة.
Dialogue: 0,1:16:46.73,1:16:49.43,Default,,0,0,0,,‫كل ما تبقى هو إدخال التلميح الذي ستقرأه
Dialogue: 0,1:16:49.43,1:16:50.83,Default,,0,0,0,,‫وإرساله.
Dialogue: 0,1:16:52.23,1:16:53.83,Default,,0,0,0,,‫سيظهر قريبًا.
Dialogue: 0,1:16:53.83,1:16:55.53,Default,,0,0,0,,‫الحرف الأول هو...
Dialogue: 0,1:16:55.53,1:16:56.83,Default,,0,0,0,,‫الحرف...
Dialogue: 0,1:16:56.83,1:16:58.43,Default,,0,0,0,,‫E...
Dialogue: 0,1:16:58.43,1:16:59.93,Default,,0,0,0,,‫V...
Dialogue: 0,1:16:59.93,1:17:01.43,Default,,0,0,0,,‫I...
Dialogue: 0,1:17:01.43,1:17:02.43,Default,,0,0,0,,‫T...
Dialogue: 0,1:17:02.43,1:17:04.63,Default,,0,0,0,,‫لا!
Dialogue: 0,1:17:12.83,1:17:15.73,Default,,0,0,0,,‫اخرجي من هناك...
Dialogue: 0,1:17:15.73,1:17:17.63,Default,,0,0,0,,‫اخرجي من هناك يا ران!
Dialogue: 0,1:17:19.63,1:17:21.33,Default,,0,0,0,,‫شينيتشي؟
Dialogue: 0,1:17:23.63,1:17:24.93,Default,,0,0,0,,‫ران!
Dialogue: 0,1:17:31.97,1:17:33.27,Default,,0,0,0,,‫تاكاغي!
Dialogue: 0,1:17:44.77,1:17:47.57,Default,,0,0,0,,‫كونان! بسرعة، ما التالي؟
Dialogue: 0,1:17:52.97,1:17:54.57,Default,,0,0,0,,‫ماذا؟ ما هذا...
Dialogue: 0,1:17:54.57,1:17:57.37,Default,,0,0,0,,‫أقل هزة ستفجر القنبلة!
Dialogue: 0,1:17:57.37,1:17:58.37,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,1:17:58.37,1:18:00.67,Default,,0,0,0,,‫كنت خائفًا جدًا من الموت،
Dialogue: 0,1:18:00.67,1:18:02.87,Default,,0,0,0,,‫فقطعت بقية الأسلاك وأوقفت القنبلة.
Dialogue: 0,1:18:02.87,1:18:04.57,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,1:18:04.57,1:18:06.07,Default,,0,0,0,,‫أنا آسف.
Dialogue: 0,1:18:12.57,1:18:14.57,Default,,0,0,0,,‫إذن توقفت في منتصف التلميح.
Dialogue: 0,1:18:14.57,1:18:17.17,Default,,0,0,0,,‫نعم. مع الحروف "EVIT" فقط،
Dialogue: 0,1:18:17.17,1:18:21.17,Default,,0,0,0,,‫لا يمكننا معرفة مكان القنبلة الأخرى.
Dialogue: 0,1:18:21.17,1:18:22.77,Default,,0,0,0,,‫حسنًا، لا يمكن فعل شيء.
Dialogue: 0,1:18:22.77,1:18:26.27,Default,,0,0,0,,‫لنطلب من فريق الإنقاذ أن يأتي لإنقاذنا.
Dialogue: 0,1:18:27.57,1:18:31.17,Default,,0,0,0,,‫إذن، لقد تراجعوا بعد كل شيء.
Dialogue: 0,1:18:31.17,1:18:33.57,Default,,0,0,0,,‫الصبي هو من أوقف القنبلة،
Dialogue: 0,1:18:33.57,1:18:36.87,Default,,0,0,0,,‫لكن الناس سيعتقدون أن الشرطة جعلته يوقفها.
Dialogue: 0,1:18:37.77,1:18:40.27,Default,,0,0,0,,‫سيعتقدون أن الشرطة ضحت بحياة الكثيرين
Dialogue: 0,1:18:40.27,1:18:43.47,Default,,0,0,0,,‫فقط لإنقاذ أنفسهم.
Dialogue: 0,1:18:48.17,1:18:51.07,Default,,0,0,0,,‫استمعوا إلى هتافات الناس!
Dialogue: 0,1:18:51.07,1:18:53.37,Default,,0,0,0,,‫لقد تم إيقاف القنبلة بأمان!
Dialogue: 0,1:18:53.37,1:18:56.07,Default,,0,0,0,,‫والأكثر من ذلك، الشخص الذي فكك القنبلة
Dialogue: 0,1:18:56.07,1:18:59.77,Default,,0,0,0,,‫كان الصبي المحاصر في المصعد!
Dialogue: 0,1:18:59.77,1:19:02.47,Default,,0,0,0,,‫لنسأل الصبي بعض الأسئلة إذن.
Dialogue: 0,1:19:02.47,1:19:04.37,Default,,0,0,0,,‫أراهن أنك كنت خائفًا، ايها الصبي؟
Dialogue: 0,1:19:05.77,1:19:07.57,Default,,0,0,0,,‫ نعم!
Dialogue: 0,1:19:08.27,1:19:10.67,Default,,0,0,0,,‫شينيتشي؟
Dialogue: 0,1:19:10.67,1:19:14.87,Default,,0,0,0,,‫لكن الشرطة علمتني كيف أفعل ذلك جيدًا،
Dialogue: 0,1:19:14.87,1:19:17.07,Default,,0,0,0,,‫لذا كان من السهل تفكيكها.
Dialogue: 0,1:19:18.07,1:19:19.47,Default,,0,0,0,,‫ تاكاغي.
Dialogue: 0,1:19:22.27,1:19:24.47,Default,,0,0,0,,‫أنسة ساتو.
Dialogue: 0,1:19:24.47,1:19:27.17,Default,,0,0,0,,‫أحمق. لا تلوم نفسك.
Dialogue: 0,1:19:27.17,1:19:29.57,Default,,0,0,0,,‫بقي ساعتان ونصف.
Dialogue: 0,1:19:29.57,1:19:32.27,Default,,0,0,0,,‫لنذهب للبحث عن القنبلة الأخرى!
Dialogue: 0,1:19:32.27,1:19:33.87,Default,,0,0,0,,‫لكن المشكلة...
Dialogue: 0,1:19:40.37,1:19:42.97,Default,,0,0,0,,‫أنا سعيد أنك بخير!
Dialogue: 0,1:19:42.97,1:19:46.17,Default,,0,0,0,,‫كنت أعرف أنك ستنجح، كونان!
Dialogue: 0,1:19:46.17,1:19:48.27,Default,,0,0,0,,‫كما هو متوقع من تابعي!
Dialogue: 0,1:19:50.07,1:19:53.07,Default,,0,0,0,,‫حسنًا، لقد فعلت الصواب بإيقاف القنبلة.
Dialogue: 0,1:19:53.07,1:19:56.27,Default,,0,0,0,,‫من السخيف التضحية بحياتك
Dialogue: 0,1:19:56.27,1:19:58.17,Default,,0,0,0,,‫من أجل أناس لا تعرفهم حتى.
Dialogue: 0,1:19:58.17,1:20:00.37,Default,,0,0,0,,‫نعم، أعتقد ذلك.
Dialogue: 0,1:20:01.87,1:20:05.37,Default,,0,0,0,,‫أنا متأكد أن المفجر فكر بنفس الطريقة أيضًا.
Dialogue: 0,1:20:11.87,1:20:14.17,Default,,0,0,0,,‫أخيرًا، بقي امتحان واحد فقط!
Dialogue: 0,1:20:16.27,1:20:19.57,Default,,0,0,0,,‫ما الأمر يا ران؟، تبدين محبطة.
Dialogue: 0,1:20:19.57,1:20:22.87,Default,,0,0,0,,‫الامتحان التالي هو أفضل مادة لديكِ، اللغة اليابانية.
Dialogue: 0,1:20:22.87,1:20:25.07,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:20:25.07,1:20:26.07,Default,,0,0,0,,‫كنت أفكر فقط أن هناك
Dialogue: 0,1:20:26.07,1:20:28.77,Default,,0,0,0,,‫الكثير من السيارات تخرج وتدخل اليوم.
Dialogue: 0,1:20:28.77,1:20:30.87,Default,,0,0,0,,‫ربما لأنهم يحملون طاولة البينج بونج
Dialogue: 0,1:20:30.87,1:20:32.67,Default,,0,0,0,,‫إلى مستودع الصالة الرياضية.
Dialogue: 0,1:20:32.67,1:20:34.77,Default,,0,0,0,,‫يبدو أن بطولة البينج بونج القادمة
Dialogue: 0,1:20:34.77,1:20:36.97,Default,,0,0,0,,‫ستقام في مدرستنا.
Dialogue: 0,1:20:38.17,1:20:40.77,Default,,0,0,0,,‫بينما هم في ذلك، عليهم أخذ براميل الطبول الكبيرة
Dialogue: 0,1:20:40.77,1:20:43.67,Default,,0,0,0,,‫الموجودة داخل المستودع معهم أيضًا.
Dialogue: 0,1:20:43.67,1:20:45.37,Default,,0,0,0,,‫عم تتحدثين؟
Dialogue: 0,1:20:45.37,1:20:46.67,Default,,0,0,0,,‫ألا تعلمين؟
Dialogue: 0,1:20:46.67,1:20:49.17,Default,,0,0,0,,‫بسبب تلك البراميل الخمسة الكبيرة.
Dialogue: 0,1:20:49.17,1:20:52.67,Default,,0,0,0,,‫من الصعب جدًا إخراج شبكة التنس.
Dialogue: 0,1:20:55.47,1:20:57.87,Default,,0,0,0,,‫إذن، لم يعثروا عليها بعد كل شيء.
Dialogue: 0,1:20:57.87,1:20:59.57,Default,,0,0,0,,‫حسنًا، حتى لو وجدوها الآن،
Dialogue: 0,1:20:59.57,1:21:01.37,Default,,0,0,0,,‫لن يتمكنوا من الإخلاء.
Dialogue: 0,1:21:04.37,1:21:07.67,Default,,0,0,0,,‫لم يتبق سوى 5 ثوانٍ.
Dialogue: 0,1:21:07.67,1:21:12.97,Default,,0,0,0,,‫4، 3، 2، 1...
Dialogue: 0,1:21:12.97,1:21:14.47,Default,,0,0,0,,‫0...
Dialogue: 0,1:21:14.47,1:21:16.07,Default,,0,0,0,,‫انفجار!
Dialogue: 0,1:21:18.87,1:21:21.77,Default,,0,0,0,,‫لماذا؟، لماذا لا تنفجر؟
Dialogue: 0,1:21:21.77,1:21:24.47,Default,,0,0,0,,‫حسنًا، لا يهم! 
Dialogue: 0,1:21:24.47,1:21:26.27,Default,,0,0,0,,‫سأفجر القنبلة بالتحكم عن بعد.
Dialogue: 0,1:21:31.07,1:21:35.97,Default,,0,0,0,,‫عليّ أن أقول أن شريكك لن يتمكن من التحدث معك بعد الآن.
Dialogue: 0,1:21:35.97,1:21:39.67,Default,,0,0,0,,‫فريق تفكيك القنابل دخل المدرسة بهدوء
Dialogue: 0,1:21:39.67,1:21:44.57,Default,,0,0,0,,‫مع الحرص على عدم ترك أي أصوات على جهاز التنصت
Dialogue: 0,1:21:44.57,1:21:46.47,Default,,0,0,0,,‫وفكك جميع القنابل الخمس
Dialogue: 0,1:21:46.47,1:21:50.47,Default,,0,0,0,,‫التي نصبتموها في البراميل.
Dialogue: 0,1:21:50.47,1:21:55.47,Default,,0,0,0,,‫تبدو كأنك تتساءل كيف حددنا موقع القنابل.
Dialogue: 0,1:21:56.27,1:21:58.77,Default,,0,0,0,,‫لقد فككنا الشفرة التي أرسلتموها من برج توتو
Dialogue: 0,1:21:58.77,1:22:03.27,Default,,0,0,0,,‫ووقت التفجير كما يلي:
Dialogue: 0,1:22:03.27,1:22:06.17,Default,,0,0,0,,‫"أنا لاعب في الدوري الرئيسي، رامٍ قوي وضارب ممتاز."
Dialogue: 0,1:22:06.17,1:22:09.37,Default,,0,0,0,,‫"الآن، هذه بداية الاشواط الاضافية."
Dialogue: 0,1:22:09.37,1:22:12.57,Default,,0,0,0,,‫"لا فائدة من تحضير مانع جيد."
Dialogue: 0,1:22:12.57,1:22:15.27,Default,,0,0,0,,‫"لأنني سأفوز في النهاية."
Dialogue: 0,1:22:15.27,1:22:17.07,Default,,0,0,0,,‫عبارة "لاعب في الدوري الرئيسي" تعني
Dialogue: 0,1:22:17.07,1:22:20.17,Default,,0,0,0,,‫تحويل كل شيء إلى الإنجليزية.
Dialogue: 0,1:22:20.17,1:22:21.87,Default,,0,0,0,,‫المانع الجيد يعني
Dialogue: 0,1:22:21.87,1:22:24.77,Default,,0,0,0,,‫رامٍ بمعدل ضربات جيد..
Dialogue: 0,1:22:24.77,1:22:26.17,Default,,0,0,0,,‫الاشواط الاضافية بالإنجليزية
Dialogue: 0,1:22:26.17,1:22:29.17,Default,,0,0,0,,‫تسمى Extra inning game.
Dialogue: 0,1:22:29.17,1:22:32.67,Default,,0,0,0,,‫اختصار معدل الضربات هو ERA.
Dialogue: 0,1:22:32.67,1:22:38.77,Default,,0,0,0,,‫إذا أزلت الكلمات غير المفيدة "ERA" من كلمة "EXTRA"،
Dialogue: 0,1:22:38.77,1:22:40.67,Default,,0,0,0,,‫تحصل على "XT".
Dialogue: 0,1:22:40.67,1:22:44.37,Default,,0,0,0,,‫XT مكتوب عموديًا وعند "قلبه"،
Dialogue: 0,1:22:44.37,1:22:46.57,Default,,0,0,0,,‫يصبح الحرف الكانجي الياباني "بون".
Dialogue: 0,1:22:46.57,1:22:49.87,Default,,0,0,0,,‫وهو رمز الخريطة الذي يمثل المدرسة.
Dialogue: 0,1:22:49.87,1:22:54.97,Default,,0,0,0,,‫والتلميح الذي ظهر على شاشة العرض للقنبلة الأولى،
Dialogue: 0,1:22:54.97,1:22:59.07,Default,,0,0,0,,‫"EVIT" هو تهجئة "Detective" بالإنجليزية،
Dialogue: 0,1:22:59.07,1:23:03.37,Default,,0,0,0,,‫أي جزء منه، مكتوبًا بالعكس.
Dialogue: 0,1:23:04.07,1:23:06.67,Default,,0,0,0,,‫وإذا عكسنا الكلمة اليابانية لـ "المحقق"،
Dialogue: 0,1:23:06.67,1:23:08.97,Default,,0,0,0,,‫تصبح "تيتان".
Dialogue: 0,1:23:08.97,1:23:11.77,Default,,0,0,0,,‫المدرسة المسماة تيتان لديها مدرسة ابتدائية،
Dialogue: 0,1:23:11.77,1:23:13.67,Default,,0,0,0,,‫إعدادية، ثانوية وجامعة،
Dialogue: 0,1:23:13.67,1:23:17.47,Default,,0,0,0,,‫لكن المدرسة الوحيدة التي يتجمع فيها الكثير من الطلاب خلال العطلة الشتوية
Dialogue: 0,1:23:17.47,1:23:19.57,Default,,0,0,0,,‫هي فقط ثانوية تيتان
Dialogue: 0,1:23:19.57,1:23:22.57,Default,,0,0,0,,‫التي تقيم امتحانات وطنية.
Dialogue: 0,1:23:23.57,1:23:27.87,Default,,0,0,0,,‫لم تزرع قنبلة مزيفة في ملعب البيسبول
Dialogue: 0,1:23:27.87,1:23:30.27,Default,,0,0,0,,‫لأنك أردت إبعاد انتباه الجميع
Dialogue: 0,1:23:30.27,1:23:32.77,Default,,0,0,0,,‫عن المدارس التي لديها ملاعب بيسبول.
Dialogue: 0,1:23:32.77,1:23:34.87,Default,,0,0,0,,‫حسنًا، لكنني أعتقد أنك استخففت بنا
Dialogue: 0,1:23:34.87,1:23:37.07,Default,,0,0,0,,‫بمراقبتك من مكان واضح مثل هذا،
Dialogue: 0,1:23:37.07,1:23:40.67,Default,,0,0,0,,‫تراقب ثانوية تيتان، انتهى كل شيء.
Dialogue: 0,1:23:45.07,1:23:46.37,Default,,0,0,0,,‫انتبه!
Dialogue: 0,1:23:48.67,1:23:50.37,Default,,0,0,0,,‫تبا!
Dialogue: 0,1:24:00.07,1:24:01.87,Default,,0,0,0,,‫-ساتو... \N‫-انسة ساتو!
Dialogue: 0,1:24:15.87,1:24:17.37,Default,,0,0,0,,‫تبا!
Dialogue: 0,1:24:36.17,1:24:37.37,Default,,0,0,0,,‫لا!
Dialogue: 0,1:24:37.37,1:24:38.67,Default,,0,0,0,,‫أنسة ساتو!
Dialogue: 0,1:25:05.77,1:25:07.47,Default,,0,0,0,,‫انتظري!
Dialogue: 0,1:25:07.47,1:25:10.87,Default,,0,0,0,,‫لست أنا...
Dialogue: 0,1:25:10.87,1:25:13.57,Default,,0,0,0,,‫أ-أليس هذا يحدث كثيرًا؟
Dialogue: 0,1:25:13.57,1:25:17.17,Default,,0,0,0,,‫سمعت في رأسي صوت طفل.
Dialogue: 0,1:25:17.17,1:25:20.17,Default,,0,0,0,,‫قال لي أن أقتل الشرطة.
Dialogue: 0,1:25:20.17,1:25:22.97,Default,,0,0,0,,‫لا، قال لي أن أقتل أي أحد.
Dialogue: 0,1:25:24.07,1:25:26.37,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:25:26.37,1:25:28.57,Default,,0,0,0,,‫لهذا السبب ليس خطئي.
Dialogue: 0,1:25:31.97,1:25:33.87,Default,,0,0,0,,‫هذا هو...
Dialogue: 0,1:25:36.77,1:25:38.27,Default,,0,0,0,,‫هذا هو الشخص!
Dialogue: 0,1:25:39.27,1:25:41.07,Default,,0,0,0,,‫هذا هو الشخص!
Dialogue: 0,1:25:50.87,1:25:52.47,Default,,0,0,0,,‫أنسة ساتو!
Dialogue: 0,1:26:09.37,1:26:11.67,Default,,0,0,0,,‫ماذا تفعل!، اتركني!
Dialogue: 0,1:26:12.87,1:26:14.37,Default,,0,0,0,,‫لا تفعلي ذلك، انسة ساتو!
Dialogue: 0,1:26:14.37,1:26:16.97,Default,,0,0,0,,‫اتركني! اتركني، قلت!
Dialogue: 0,1:26:16.97,1:26:19.67,Default,,0,0,0,,‫هذا الشخص... هو السبب!
Dialogue: 0,1:26:19.67,1:26:20.97,Default,,0,0,0,,‫لذا، اتركني!
Dialogue: 0,1:26:30.27,1:26:32.97,Default,,0,0,0,,‫ما الذي تفعلينه بالضبط، أنسة ساتو؟
Dialogue: 0,1:26:34.37,1:26:37.57,Default,,0,0,0,,‫ألم تكوني دائمًا تقولين
Dialogue: 0,1:26:37.57,1:26:39.57,Default,,0,0,0,,‫أن نخدم الأمة والمواطنين
Dialogue: 0,1:26:39.57,1:26:41.87,Default,,0,0,0,,‫بفخر وإحساس واهتمام،
Dialogue: 0,1:26:41.87,1:26:44.17,Default,,0,0,0,,‫وألا نتراجع خوفًا أو كراهية
Dialogue: 0,1:26:44.17,1:26:47.27,Default,,0,0,0,,‫وفي جميع الأوقات نحترم حقوق الناس،
Dialogue: 0,1:26:47.27,1:26:50.97,Default,,0,0,0,,‫ونؤدي واجباتنا كضباط شرطة بالعدل.
Dialogue: 0,1:26:50.97,1:26:53.07,Default,,0,0,0,,‫هذا ما كنتِ تقولينه دائمًا، أليس كذلك؟
Dialogue: 0,1:26:59.17,1:27:01.97,Default,,0,0,0,,‫لكن...
Dialogue: 0,1:27:03.87,1:27:05.17,Default,,0,0,0,,‫بتصرفك هكذا الآن،
Dialogue: 0,1:27:05.17,1:27:08.37,Default,,0,0,0,,‫أنا متأكد أن الضابط ماتسودا سوف يوبخك.
Dialogue: 0,1:27:08.37,1:27:11.27,Default,,0,0,0,,‫أحمق...
Dialogue: 0,1:27:11.27,1:27:12.97,Default,,0,0,0,,‫أريد أن أنساه، لكنك...
Dialogue: 0,1:27:15.87,1:27:18.17,Default,,0,0,0,,‫دعني أنساه!
Dialogue: 0,1:27:18.17,1:27:19.67,Default,,0,0,0,,‫أيها الأحمق!
Dialogue: 0,1:27:27.17,1:27:30.27,Default,,0,0,0,,‫لا يجب أن تنسيه.
Dialogue: 0,1:27:33.27,1:27:37.27,Default,,0,0,0,,‫إذا كانت ذكرى عزيزة، لا يجب أن تنسيها.
Dialogue: 0,1:27:37.97,1:27:39.57,Default,,0,0,0,,‫بمجرد أن يموت الشخص،
Dialogue: 0,1:27:39.57,1:27:43.17,Default,,0,0,0,,‫يمكنه أن يعيش فقط في ذاكرتك.
Dialogue: 0,1:27:45.67,1:27:47.07,Default,,0,0,0,,‫ تاكاغي.
Dialogue: 0,1:27:47.87,1:27:49.37,Default,,0,0,0,,‫ تاكاغي.
Dialogue: 0,1:28:02.67,1:28:05.57,Default,,0,0,0,,‫مهلا!، ما كانت تلك الطلقة الآن؟
Dialogue: 0,1:28:12.37,1:28:13.47,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,1:28:13.47,1:28:15.97,Default,,0,0,0,,‫أطلقت طلقة تحذيرية فقط.
Dialogue: 0,1:28:15.97,1:28:18.87,Default,,0,0,0,,‫ايعقل أنه قد أُصيب أو ما شابه؟
Dialogue: 0,1:28:18.87,1:28:21.57,Default,,0,0,0,,‫لم نكن نقبل!
Dialogue: 0,1:28:24.16,1:28:34.62,DCEnding,,0,0,0,,‫العيش وحيدًا يعطيني إحساسًا مرحبًا به من الثقة
Dialogue: 0,1:28:36.00,1:28:45.93,DCEnding,,0,0,0,,‫لكن الآن أشتاق لطاقة الكفاح التي يمتلكها الباحث عن الحرية
Dialogue: 0,1:28:46.72,1:28:52.56,DCEnding,,0,0,0,,‫كوني طليقة أمر جديد عليّ جدًا (أبحث عن شخص لأحتضنه)
Dialogue: 0,1:28:52.56,1:28:58.23,DCEnding,,0,0,0,,‫كل ما يمكنني فعله هو الصراخ (كيف تشعر؟)
Dialogue: 0,1:28:58.23,1:29:04.11,DCEnding,,0,0,0,,‫حلمي تحقق أخيرًا، لكني الآن أغرق فيه
Dialogue: 0,1:29:04.11,1:29:14.58,DCEnding,,0,0,0,,‫انتهى. حان الوقت للانتقال إلى شيء جديد
Dialogue: 0,1:29:15.62,1:29:26.01,DCEnding,,0,0,0,,‫وحيد جدًا، لا أتحمل أن أكون وحيدًا كل ليلة
Dialogue: 0,1:29:26.97,1:29:37.40,DCEnding,,0,0,0,,‫يومًا ما أريد أن أصل إلى عالم أحلامي
Dialogue: 0,1:29:38.81,1:29:51.24,DCEnding,,0,0,0,,‫وأريد أن أجده ينتظرني هناك
Dialogue: 0,1:29:54.27,1:29:58.37,Default,,0,0,0,,‫لكن الصراحة، أنا مُدهش أنك أوقفتها.
Dialogue: 0,1:29:58.37,1:30:01.87,Default,,0,0,0,,‫كان لديك أقل من 3 ثوانٍ لقطع السلك، أليس كذلك؟
Dialogue: 0,1:30:01.87,1:30:05.27,Default,,0,0,0,,‫في الحقيقة، كانت قاطعة الأسلاك في يدي فقد قررت أن أقطع السلك 
Dialogue: 0,1:30:05.27,1:30:08.27,Default,,0,0,0,,‫في حال فهمت التلميح.
Dialogue: 0,1:30:08.27,1:30:11.67,Default,,0,0,0,,‫بالإضافة إلى ذلك، لم أستطع تحمل فكرة موت الضابط تاكاغي.
Dialogue: 0,1:30:11.67,1:30:13.47,Default,,0,0,0,,‫لكنني مندهشة أنك
Dialogue: 0,1:30:13.47,1:30:18.57,Default,,0,0,0,,‫استطعت معرفة أن 'EVIT' هي 'Detective' مكتوبة بالعكس.
Dialogue: 0,1:30:18.57,1:30:20.57,Default,,0,0,0,,‫أنا أيضًا!
Dialogue: 0,1:30:20.57,1:30:24.47,Default,,0,0,0,,‫حمقاء، بالطبع كنت سأفهمها.
Dialogue: 0,1:30:24.47,1:30:31.97,Default,,0,0,0,,‫لأنني كنتُ أتمنى من كل قلبي ألا تكون هناك.
Dialogue: 0,1:30:34.27,1:30:36.47,Default,,0,0,0,,‫يا ساتو.
Dialogue: 0,1:30:36.47,1:30:39.27,Default,,0,0,0,,‫سنزور شيراتوري في المستشفى.
Dialogue: 0,1:30:39.27,1:30:41.37,Default,,0,0,0,,‫نعم، أنا قادمة!
Dialogue: 0,1:30:53.97,1:30:57.87,Default,,0,0,0,,‫وداعًا، ماتسودا.
Dialogue: 0,1:30:57.87,1:30:59.17,Default,,0,0,0,,‫لكنني...
Dialogue: 0,1:31:03.27,1:31:06.57,Default,,0,0,0,,‫لكنني لن أنساك.
