Dialogue: 0,0:03:07.28,0:03:13.18,Default,,0,0,0,,‫"تصادم الأحمر والأسود - الموت أثناء تأدية الواجب"‬
Dialogue: 0,0:03:07.28,0:03:13.18,Default,,0,0,0,,{\fs80\pos(950,310)} تصادم الأحمر والأسود 
Dialogue: 0,0:03:07.28,0:03:13.18,Default,,0,0,0,,{\fs80\pos(959,830)}الموت أثناء تأدية الواجب
Dialogue: 0,0:04:01.28,0:04:04.23,Default,,0,0,0,,‫وكالة الاستخبارات المركزية؟‬
Dialogue: 0,0:04:04.22,0:04:05.57,Default,,0,0,0,,‫عما تتحدث؟‬
Dialogue: 0,0:04:05.58,0:04:08.23,Default,,0,0,0,,‫لماذا أختي...
Dialogue: 0,0:04:08.23,0:04:10.23,Default,,0,0,0,,‫مهلا لحظة... انا لا أفهم!‬
Dialogue: 0,0:04:10.48,0:04:12.24,Default,,0,0,0,,‫مهلا...
Dialogue: 0,0:04:12.23,0:04:13.47,Default,,0,0,0,,‫لم أنتهِ من الحديث بعد.‬
Dialogue: 0,0:04:15.18,0:04:17.58,Default,,0,0,0,,‫اخي إي.‬
Dialogue: 0,0:04:22.78,0:04:23.88,Default,,0,0,0,,‫أبي.‬
Dialogue: 0,0:04:23.88,0:04:26.25,Default,,0,0,0,,‫لا تستسلمي، هيديمي.‬
Dialogue: 0,0:04:26.25,0:04:27.68,Default,,0,0,0,,‫إذا استمررتِ في الانتظار،‬
Dialogue: 0,0:04:27.68,0:04:29.38,Default,,0,0,0,,‫فالأصدقاء سيظهرون بالتأكيد.‬
Dialogue: 0,0:04:30.58,0:04:32.98,Default,,0,0,0,,‫اعديني بأنكِ ستكملين مهمتي نيابة عني.‬
Dialogue: 0,0:05:18.30,0:05:21.18,Default,,0,0,0,,‫ماذا...
Dialogue: 0,0:05:21.18,0:05:22.98,Default,,0,0,0,,‫ما الأمر؟‬
Dialogue: 0,0:05:22.98,0:05:26.31,Default,,0,0,0,,‫قادم من الاتجاه المعاكس.‬
Dialogue: 0,0:05:28.31,0:05:30.08,Default,,0,0,0,,‫لقد وصلت قبلك...
Dialogue: 0,0:05:30.08,0:05:32.32,Default,,0,0,0,,‫وتحققت من الكثير من الأمور.‬
Dialogue: 0,0:05:32.48,0:05:34.08,Default,,0,0,0,,‫حقًا؟‬
Dialogue: 0,0:05:34.08,0:05:36.32,Default,,0,0,0,,‫و...
Dialogue: 0,0:05:36.32,0:05:38.88,Default,,0,0,0,,‫هل تمكنت من الحصول على ما تريده؟‬
Dialogue: 0,0:05:38.88,0:05:42.88,Default,,0,0,0,,‫التأكيد على أنني جئت إلى هنا وحدي.‬
Dialogue: 0,0:05:46.33,0:05:47.58,Default,,0,0,0,,‫نعم.‬
Dialogue: 0,0:05:47.58,0:05:50.33,Default,,0,0,0,,‫يبدو كذلك.‬
Dialogue: 0,0:05:50.33,0:05:54.88,Default,,0,0,0,,‫إذن، ما هي المعلومات التي ستتقدميها لي‬
Dialogue: 0,0:05:54.88,0:05:58.34,Default,,0,0,0,,‫مقابل المساعدة في الهروب...
Dialogue: 0,0:06:01.78,0:06:04.98,Default,,0,0,0,,‫نعم، الشيء الذي يمكنني تقديمه لك هو. . .‬
Dialogue: 0,0:06:59.78,0:07:02.41,Default,,0,0,0,,‫بورش 356A.‬
Dialogue: 0,0:07:05.68,0:07:08.41,Default,,0,0,0,,‫إذن، هكذا هو الأمر...
Dialogue: 0,0:07:17.98,0:07:19.68,Default,,0,0,0,,‫ما الأمر، كير؟‬
Dialogue: 0,0:07:19.68,0:07:22.98,Default,,0,0,0,,‫أسرعي وانهيه.‬
Dialogue: 0,0:07:22.98,0:07:24.43,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:07:24.42,0:07:26.87,Default,,0,0,0,,‫لقد أصبت رئته.‬
Dialogue: 0,0:07:26.88,0:07:30.18,Default,,0,0,0,,‫حتى لو تركناه، لن يصمد أكثر من ثلاثين دقيقة.‬
Dialogue: 0,0:07:31.28,0:07:32.44,Default,,0,0,0,,‫رأسه. . .‬
Dialogue: 0,0:07:34.08,0:07:37.08,Default,,0,0,0,,‫أطلقي الرصاصة عبر رأسه.‬
Dialogue: 0,0:07:37.08,0:07:41.08,Default,,0,0,0,,‫بهذه الطريقة يمكننا التأكد من أن حياته قد وصلت إلى نهايتها.‬
Dialogue: 0,0:07:42.44,0:07:44.44,Default,,0,0,0,,‫حاضرة.‬
Dialogue: 0,0:08:02.46,0:08:05.47,Default,,0,0,0,,‫من كان يتصور ان الامور ستصل إلى هذا الحد؟‬
Dialogue: 0,0:08:05.48,0:08:08.18,Default,,0,0,0,,‫أنا متفاجئة أيضًا‬
Dialogue: 0,0:08:08.18,0:08:11.18,Default,,0,0,0,,‫أن كل شيء سار بسلاسة.‬
Dialogue: 0,0:08:39.48,0:08:40.50,Default,,0,0,0,,‫الشرطة.‬
Dialogue: 0,0:08:42.50,0:08:45.77,Default,,0,0,0,,‫يبدو أن هناك حادثًا قريبًا.‬
Dialogue: 0,0:08:47.38,0:08:50.51,Default,,0,0,0,,‫كير، امسحي الاثار وغادري.‬
Dialogue: 0,0:08:50.51,0:08:51.98,Default,,0,0,0,,‫حاضرة.‬
Dialogue: 0,0:08:59.98,0:09:02.53,Default,,0,0,0,,‫لم... لم يكن لدي خيار...
Dialogue: 0,0:09:32.55,0:09:34.55,Default,,0,0,0,,‫ماذا!‬
Dialogue: 0,0:09:36.28,0:09:38.28,Default,,0,0,0,,‫أسرع، اتصل بالمحطة!‬
Dialogue: 0,0:09:38.28,0:09:39.38,Default,,0,0,0,,‫حسناً!‬
Dialogue: 0,0:09:53.78,0:09:56.08,Default,,0,0,0,,‫لماذا؟ ، لماذا لا يجيب‬
Dialogue: 0,0:09:56.08,0:09:59.08,Default,,0,0,0,,‫حتى من استعارة هاتف كونان للاتصال به.‬
Dialogue: 0,0:10:00.08,0:10:02.58,Default,,0,0,0,,‫شو لا يجيب على الهاتف.‬
Dialogue: 0,0:10:02.58,0:10:04.98,Default,,0,0,0,,‫ربما يأخذ قيلولة.‬
Dialogue: 0,0:10:04.98,0:10:06.58,Default,,0,0,0,,‫سيد أكاي لم ينام جيداً‬
Dialogue: 0,0:10:06.58,0:10:08.58,Default,,0,0,0,,‫منذ بداية تلك القضية.‬
Dialogue: 0,0:10:08.58,0:10:10.18,Default,,0,0,0,,‫يا إلهي. . .‬
Dialogue: 0,0:10:10.18,0:10:11.58,Default,,0,0,0,,‫ماذا ستفعل، كونان؟‬
Dialogue: 0,0:10:12.78,0:10:17.78,Default,,0,0,0,,‫لقد قلت أنك تريد المجيء إلى المستشفى مرة أخرى قبل انسحابنا، أليس كذلك؟‬
Dialogue: 0,0:10:17.78,0:10:19.48,Default,,0,0,0,,‫نعم.‬
Dialogue: 0,0:10:19.48,0:10:21.68,Default,,0,0,0,,‫هل ترغب في القدوم معنا الآن؟‬
Dialogue: 0,0:10:21.68,0:10:23.78,Default,,0,0,0,,‫كنت أخطط لذلك، لكن...
Dialogue: 0,0:10:23.78,0:10:25.58,Default,,0,0,0,,‫قررت أن الأفضل ألا أفعل.‬
Dialogue: 0,0:10:25.58,0:10:28.61,Default,,0,0,0,,‫فوجود طفل يتجول قد يسبب لكم مشاكل.‬
Dialogue: 0,0:10:28.78,0:10:31.88,Default,,0,0,0,,‫بالإضافة إلى ذلك، اليوم هو الجمعة، الثالث عشر.‬
Dialogue: 0,0:10:32.88,0:10:34.28,Default,,0,0,0,,‫أعتقد أنه سيكون من الأفضل لي‬
Dialogue: 0,0:10:34.28,0:10:36.18,Default,,0,0,0,,‫أن أتوجه إلى المنزل وأخلد للنوم.‬
Dialogue: 0,0:10:36.18,0:10:38.62,Default,,0,0,0,,‫أراكِ لاحقًا، معلمة جودي.‬
Dialogue: 0,0:10:38.62,0:10:41.58,Default,,0,0,0,,‫الجمعة الثالث عشر؟‬
Dialogue: 0,0:10:44.08,0:10:45.38,Default,,0,0,0,,‫كوني حذرًة.‬
Dialogue: 0,0:10:47.28,0:10:50.63,Default,,0,0,0,,‫لدي شعور سيء اليوم.‬
Dialogue: 0,0:10:50.63,0:10:54.38,Default,,0,0,0,,‫لأن اليوم هو الجمعة الثالث عشر، أليس كذلك؟‬
Dialogue: 0,0:10:56.64,0:10:59.78,Default,,0,0,0,,‫لا أهتم حقًا بهذه الأمور.‬
Dialogue: 0,0:11:01.18,0:11:03.48,Default,,0,0,0,,‫حقًا؟‬
Dialogue: 0,0:11:16.07,0:11:20.17,Default,,0,0,0,,‫شو... شو ذهب لرؤية ميزوناشي رينا بعد أن اتصلت به؟‬
Dialogue: 0,0:11:20.17,0:11:21.17,Default,,0,0,0,,‫نعم.‬
Dialogue: 0,0:11:21.17,0:11:26.67,Default,,0,0,0,,‫تلقى مكالمة منها بعد مغادرتكِ مباشرة.‬
Dialogue: 0,0:11:26.67,0:11:28.67,Default,,0,0,0,,‫قال إنها طلبت لقاءً سريًا بينهما.‬
Dialogue: 0,0:11:28.67,0:11:30.17,Default,,0,0,0,,‫لقاءً سريًا بينهما...
Dialogue: 0,0:11:30.17,0:11:32.27,Default,,0,0,0,,‫أنا متأكدة أن هذا فخ!‬
Dialogue: 0,0:11:32.27,0:11:34.68,Default,,0,0,0,,‫لماذا... لماذا لم تمنعه؟‬
Dialogue: 0,0:11:34.87,0:11:37.27,Default,,0,0,0,,‫لا، لقد حاولت منعه...
Dialogue: 0,0:11:37.27,0:11:41.67,Default,,0,0,0,,‫لكنه أصر على الذهاب، لأنه إذا لم يفعل، ستكون حياتها في خطر.‬
Dialogue: 0,0:11:41.67,0:11:43.57,Default,,0,0,0,,‫لكننا نتحدث عن أكاي،‬
Dialogue: 0,0:11:43.57,0:11:45.97,Default,,0,0,0,,‫لذا، لا أعتقد أن هناك داعي للقلق.‬
Dialogue: 0,0:11:45.97,0:11:48.27,Default,,0,0,0,,‫المعذرة...
Dialogue: 0,0:11:48.27,0:11:52.17,Default,,0,0,0,,‫كانوا سيلتقون في ممر رايها، أليس كذلك؟‬
Dialogue: 0,0:11:52.17,0:11:53.67,Default,,0,0,0,,‫نعم.‬
Dialogue: 0,0:11:53.67,0:11:57.07,Default,,0,0,0,,‫رأيت في نشرات الأخبار التلفزيونية الآن‬
Dialogue: 0,0:11:57.07,0:11:59.87,Default,,0,0,0,,‫أن سيارة اشتعلت فيها النيران في ممر رايها‬
Dialogue: 0,0:11:59.87,0:12:02.70,Default,,0,0,0,,‫ويبدو أنه تم العثور على جثة محترقة بداخلها.‬
Dialogue: 0,0:12:03.20,0:12:04.17,Default,,0,0,0,,‫ماذا قلت! ؟‬
Dialogue: 0,0:12:05.37,0:12:07.67,Default,,0,0,0,,‫السيارة التي اشتعلت فيها النيران كانت شيفروليه سوداء،‬
Dialogue: 0,0:12:07.67,0:12:11.17,Default,,0,0,0,,‫وتم العثور بداخلها على رجل في العشرينات أو الثلاثينات من عمره.‬
Dialogue: 0,0:12:11.17,0:12:13.87,Default,,0,0,0,,‫تم العثور على السيارة من قبل ضابط شرطة‬
Dialogue: 0,0:12:13.87,0:12:16.72,Default,,0,0,0,,‫في سيارة دورية كانت في طريقها إلى حادث آخر.‬
Dialogue: 0,0:12:16.72,0:12:18.72,Default,,0,0,0,,‫وفقًا لتقرير شاهد عيان من ذلك الضابط،‬
Dialogue: 0,0:12:18.72,0:12:21.67,Default,,0,0,0,,‫يقول أن السيارة انفجرت فجأة أمام عينيه.‬
Dialogue: 0,0:12:21.67,0:12:25.07,Default,,0,0,0,,‫ومن حقيقة وجود علامات جروح رصاص على الجثة...
Dialogue: 0,0:12:25.07,0:12:28.37,Default,,0,0,0,,‫الشرطة تحقق في هذه القضية كجريمة قتل.‬
Dialogue: 0,0:12:28.37,0:12:31.07,Default,,0,0,0,,‫إنهم يأملون في تحديد هوية الجثة من خلال ما تبقى من أرقام السيارة‬
Dialogue: 0,0:12:31.07,0:12:32.07,Default,,0,0,0,,‫واليد اليمنى للجثة...
Dialogue: 0,0:12:32.07,0:12:34.17,Default,,0,0,0,,‫لا! هذا ليس شو!‬
Dialogue: 0,0:12:34.17,0:12:37.17,Default,,0,0,0,,‫لابد انه وضع شخصًا من المنظمة في مكانه!‬
Dialogue: 0,0:12:37.17,0:12:38.74,Default,,0,0,0,,‫لابد أنه فعل ذلك!‬
Dialogue: 0,0:12:38.97,0:12:40.17,Default,,0,0,0,,‫هذا ما أؤمن به أيضًا!‬
Dialogue: 0,0:12:40.17,0:12:42.74,Default,,0,0,0,,‫أنا متأكدة أننا نستطيع التحقق والتاكد بسهولة‬
Dialogue: 0,0:12:42.74,0:12:44.74,Default,,0,0,0,,‫إذا ذهبنا إلى قسم الشرطة!‬
Dialogue: 0,0:12:44.74,0:12:49.66,Default,,0,0,0,,‫لكن، هل يمكننا التأكيد عندما تكون الجثة محترقة؟‬
Dialogue: 0,0:12:49.67,0:12:51.67,Default,,0,0,0,,‫إذا كانت اليد اليمنى للجثة لا تزال موجودة،‬
Dialogue: 0,0:12:51.67,0:12:54.76,Default,,0,0,0,,‫يمكننا التأكيد بمطابقتها مع بصمات أكاي.‬
Dialogue: 0,0:12:54.75,0:12:57.46,Default,,0,0,0,,‫إذن، يمكننا مطابقتها مع بصمات أكاي‬
Dialogue: 0,0:12:57.47,0:12:58.76,Default,,0,0,0,,‫المسجلة في مكتب التحقيقات الفيدرالي.‬
Dialogue: 0,0:12:58.76,0:13:02.37,Default,,0,0,0,,‫"من فضلكم، أعيرونا تلك اليد اليمنى لنقارن البصمات. "‬
Dialogue: 0,0:13:02.37,0:13:06.57,Default,,0,0,0,,‫"قد تكون تلك الجثة لعميل في مكتب التحقيقات الفيدرالي"‬
Dialogue: 0,0:13:06.57,0:13:08.17,Default,,0,0,0,,‫هل هذا ما سنقوله؟‬
Dialogue: 0,0:13:09.77,0:13:12.37,Default,,0,0,0,,‫الأمر نفسه ينطبق على سيارة أكاي.‬
Dialogue: 0,0:13:12.37,0:13:15.47,Default,,0,0,0,,‫أنا متأكد أن بصماته ستكون في مكان ما عليها،‬
Dialogue: 0,0:13:15.47,0:13:18.77,Default,,0,0,0,,‫لكنها ليست محترقة فحسب، بل هي تحت حراسة الشرطة.‬
Dialogue: 0,0:13:18.77,0:13:20.77,Default,,0,0,0,,‫لا يمكننا أن نطلب منهم إعطائها لنا،‬
Dialogue: 0,0:13:20.77,0:13:22.78,Default,,0,0,0,,‫بدون شرح الأسباب.‬
Dialogue: 0,0:13:24.78,0:13:32.79,Default,,0,0,0,,‫إلا إذا كان هناك فقط طريقة لمقارنة بصماته مع بصمات الجثة دون جعلهم يشتبهون...
Dialogue: 0,0:13:32.79,0:13:36.07,Default,,0,0,0,,‫إذا استخدمنا الهاتف الخلوي الذي يحمل بصماته،‬
Dialogue: 0,0:13:36.07,0:13:39.17,Default,,0,0,0,,‫أنا متأكد أننا سنتمكن من مطابقة البصمات بنجاح.‬
Dialogue: 0,0:13:39.17,0:13:41.57,Default,,0,0,0,,‫لكن، هاتفه الخلوي هو...
Dialogue: 0,0:13:44.17,0:13:48.47,Default,,0,0,0,,‫هذا هاتف خلوي استعرته من كونان، لكن...
Dialogue: 0,0:13:48.47,0:13:51.57,Default,,0,0,0,,‫سأخرج ثم أتصل به على الهاتف.‬
Dialogue: 0,0:13:51.57,0:13:53.97,Default,,0,0,0,,‫أعتقد أنه سيأتي على الفور.‬
Dialogue: 0,0:13:55.17,0:13:57.17,Default,,0,0,0,,‫بغض النظر عن مدى ذكائك...
Dialogue: 0,0:13:57.17,0:14:00.07,Default,,0,0,0,,‫هذا شيء لا يمكن القيام به.‬
Dialogue: 0,0:14:00.07,0:14:02.57,Default,,0,0,0,,‫هذه مهمة لمكتب التحقيقات الفيدرالي.‬
Dialogue: 0,0:14:04.82,0:14:08.83,Default,,0,0,0,,‫لا يمكننا السماح للمواطنين العاديين بالتدخل أكثر من ذلك.‬
Dialogue: 0,0:14:08.83,0:14:10.83,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:14:12.47,0:14:14.84,Default,,0,0,0,,‫اترك الباقي لنا.‬
Dialogue: 0,0:14:16.17,0:14:18.47,Default,,0,0,0,,‫إذن، لديكِ بصمات أكاي؟‬
Dialogue: 0,0:14:18.47,0:14:19.57,Default,,0,0,0,,‫نعم.‬
Dialogue: 0,0:14:19.57,0:14:21.67,Default,,0,0,0,,‫سآخذه وأذهب إلى الشرطة.‬
Dialogue: 0,0:14:23.07,0:14:25.97,Default,,0,0,0,,‫انتظري، دعيني أوصلكِ.‬
Dialogue: 0,0:14:25.97,0:14:32.17,Default,,0,0,0,,‫قد. أكون أبالغ في هذا، لكن تأكدي من أنكِ لا تخبرين أحدًا أن الجثة هي أحد أعضاء مكتب التحقيقات الفيدرالي.‬
Dialogue: 0,0:14:32.17,0:14:36.47,Default,,0,0,0,,‫نعم، سأقوم بذلك بدقة، دون أن أثير أي شكوك حولي.‬
Dialogue: 0,0:14:42.86,0:14:47.67,Default,,0,0,0,,‫تقولين يمكن أن يكون الرجل الذي التقط هاتفكِ؟‬
Dialogue: 0,0:14:47.67,0:14:50.87,Default,,0,0,0,,‫تقصدين الرجل الذي تم العثور عليه محترقًا حتى الموت؟‬
Dialogue: 0,0:14:50.87,0:14:56.57,Default,,0,0,0,,‫لقد كنت أمر بممر رايها هذا الصباح....
Dialogue: 0,0:14:56.57,0:14:59.37,Default,,0,0,0,,‫تناولت الغداء في مطعم قريب.‬
Dialogue: 0,0:14:59.37,0:15:02.17,Default,,0,0,0,,‫لذا اظن أنني أسقطته في مكان ما.‬
Dialogue: 0,0:15:02.17,0:15:05.47,Default,,0,0,0,,‫ويبدو أن هذا الرجل التقط هاتفي الخلوي من أجلي.‬
Dialogue: 0,0:15:05.47,0:15:07.27,Default,,0,0,0,,‫كان ذلك الرجل يركب سيارة شيفروليه أيضًا،‬
Dialogue: 0,0:15:07.27,0:15:09.97,Default,,0,0,0,,‫لذا اعتقدت أنه ربما يكون هو.‬
Dialogue: 0,0:15:09.97,0:15:12.67,Default,,0,0,0,,‫يمكنني المساعدة في التحقيق‬
Dialogue: 0,0:15:12.67,0:15:15.17,Default,,0,0,0,,‫لأنني أتذكر ما كان يرتديه وكذلك وجهه.‬
Dialogue: 0,0:15:15.17,0:15:16.47,Default,,0,0,0,,‫فهمت.‬
Dialogue: 0,0:15:16.47,0:15:18.90,Default,,0,0,0,,‫إذًا من فضلك أعطيني إياه.‬
Dialogue: 0,0:15:21.07,0:15:25.57,Default,,0,0,0,,‫هذا الهاتف الخلوي هو ما استعرته من كونان.‬
Dialogue: 0,0:15:25.57,0:15:28.91,Default,,0,0,0,,‫لذا أعتقد أن بصماتي وكذلك كونان موجودة عليه أيضًا.‬
Dialogue: 0,0:15:28.91,0:15:30.27,Default,,0,0,0,,‫فهمت.‬
Dialogue: 0,0:15:30.27,0:15:31.97,Default,,0,0,0,,‫سأتحقق منه على الفور،‬
Dialogue: 0,0:15:31.97,0:15:33.87,Default,,0,0,0,,‫لذا من فضلكِ انتظري هنا.‬
Dialogue: 0,0:15:43.39,0:15:44.93,Default,,0,0,0,,‫لقد حصلنا على النتائج.‬
Dialogue: 0,0:15:46.49,0:15:48.19,Default,,0,0,0,,‫وماذا كانت...
Dialogue: 0,0:15:48.19,0:15:52.19,Default,,0,0,0,,‫هل كنت مخطئة بعد كل شيء؟‬
Dialogue: 0,0:15:56.94,0:15:59.29,Default,,0,0,0,,‫أنا آسف على كل هذا الإزعاج.‬
Dialogue: 0,0:15:59.29,0:16:01.79,Default,,0,0,0,,‫لا.‬
Dialogue: 0,0:16:01.79,0:16:04.95,Default,,0,0,0,,‫أنا من يجب أن يعتذر.‬
Dialogue: 0,0:16:04.94,0:16:07.99,Default,,0,0,0,,‫لا أستطيع حقًا تذكر الكثير عن مظهره.‬
Dialogue: 0,0:16:07.99,0:16:12.69,Default,,0,0,0,,‫ومع ذلك، هناك الكثير من الأمور غير المبررة حول تلك الجثة.‬
Dialogue: 0,0:16:12.69,0:16:14.29,Default,,0,0,0,,‫لذا، من فضلك أخبرينا‬
Dialogue: 0,0:16:14.29,0:16:15.59,Default,,0,0,0,,‫إذا تذكرت أي شيء آخر.‬
Dialogue: 0,0:16:15.59,0:16:16.96,Default,,0,0,0,,‫نعم، بالطبع.‬
Dialogue: 0,0:16:18.49,0:16:22.49,Default,,0,0,0,,‫حسنًا، إذن شكرًا جزيلًا لكِ على كل شيء اليوم.‬
Dialogue: 0,0:16:26.99,0:16:28.69,Default,,0,0,0,,‫وفقًا للتقرير...
Dialogue: 0,0:16:28.69,0:16:29.99,Default,,0,0,0,,‫كما ذكرتِ،‬
Dialogue: 0,0:16:29.99,0:16:33.59,Default,,0,0,0,,‫تم العثور على بصماتك مع كونان أيضًا‬
Dialogue: 0,0:16:33.59,0:16:35.99,Default,,0,0,0,,‫مع بصمات الرجل‬
Dialogue: 0,0:16:35.99,0:16:38.59,Default,,0,0,0,,‫الذي احترق حتى الموت منذ قليل.‬
Dialogue: 0,0:16:41.89,0:16:43.99,Default,,0,0,0,,‫بناءً على تعابيركِ...
Dialogue: 0,0:16:43.99,0:16:47.29,Default,,0,0,0,,‫أعتقد أن الجثة كانت أكاي بعد كل شيء.‬
Dialogue: 0,0:16:50.19,0:16:54.79,Default,,0,0,0,,‫لكن، لا يمكننا إلقاء اللوم على رينا ميزوناشي أيضًا.‬
Dialogue: 0,0:16:54.79,0:16:58.09,Default,,0,0,0,,‫كانت ستُقتل إذا لم تقتله‬
Dialogue: 0,0:16:58.09,0:17:01.99,Default,,0,0,0,,‫ويبدو أنها أخبرت أكاي أن...
Dialogue: 0,0:17:01.99,0:17:03.79,Default,,0,0,0,,‫بغض النظر عما سيحدث،‬
Dialogue: 0,0:17:03.79,0:17:06.79,Default,,0,0,0,,‫مهمة والدي في وكالة الاستخبارات المركزية تأتي أولاً.‬
Dialogue: 0,0:17:06.79,0:17:10.79,Default,,0,0,0,,‫حتى لو أصبحت عبئًا على مكتب التحقيقات الفيدرالي، لا تفكرو بي بشكل سيء.‬
Dialogue: 0,0:17:11.79,0:17:13.39,Default,,0,0,0,,‫لذا...
Dialogue: 0,0:17:13.39,0:17:18.59,Default,,0,0,0,,‫الآن تمكنا من دق إسفين في المنظمة.‬
Dialogue: 0,0:17:18.59,0:17:21.59,Default,,0,0,0,,‫إسفين فولاذي لا يمكن إزالته أبدًا.‬
Dialogue: 0,0:17:23.59,0:17:25.99,Default,,0,0,0,,‫ربما أكاي...
Dialogue: 0,0:17:25.99,0:17:29.99,Default,,0,0,0,,‫ضحّى بنفسه عمدًا ليدق هذا الإسفين.‬
Dialogue: 0,0:17:31.59,0:17:36.39,Default,,0,0,0,,‫لكن الثمن كان باهظًا جدًا.‬
Dialogue: 0,0:17:36.39,0:17:40.39,Default,,0,0,0,,‫شو...
Dialogue: 0,0:17:47.79,0:17:49.05,Default,,0,0,0,,‫ماذا؟‬
Dialogue: 0,0:17:50.59,0:17:53.69,Default,,0,0,0,,‫البندقية...
Dialogue: 0,0:17:56.39,0:17:57.99,Default,,0,0,0,,‫متى فعلتِ...
Dialogue: 0,0:17:57.99,0:18:02.69,Default,,0,0,0,,‫أسقطِ مسدسك، قلت لكِ أن تسقطِ مسدسك...
Dialogue: 0,0:18:02.69,0:18:04.69,Default,,0,0,0,,‫وإلا ستكون الطلقة التالية في رأسك.‬
Dialogue: 0,0:18:09.79,0:18:11.39,Default,,0,0,0,,‫صوت مضخة؟‬
Dialogue: 0,0:18:11.39,0:18:13.07,Default,,0,0,0,,‫بندقية؟‬
Dialogue: 0,0:18:13.07,0:18:15.07,Default,,0,0,0,,‫حسنًا، كالفادوس،‬
Dialogue: 0,0:18:15.07,0:18:16.79,Default,,0,0,0,,‫سنأخذها من الجانبين.‬
Dialogue: 0,0:18:19.49,0:18:21.09,Default,,0,0,0,,‫يا للمصيبة!‬
Dialogue: 0,0:18:21.09,0:18:22.29,Default,,0,0,0,,‫إنه قادم من الخلف.‬
Dialogue: 0,0:18:38.09,0:18:39.79,Default,,0,0,0,,‫هيا، كالفادوس.‬
Dialogue: 0,0:18:39.79,0:18:42.59,Default,,0,0,0,,‫استخدم بندقية ريمينجتون الخاصة بك‬
Dialogue: 0,0:18:42.59,0:18:46.29,Default,,0,0,0,,‫لتفجير تلك القطة الصغيرة من مكتب التحقيقات الفيدرالي.‬
Dialogue: 0,0:18:46.29,0:18:49.11,Default,,0,0,0,,‫إذن اسم ذلك الرجل هو...
Dialogue: 0,0:18:49.11,0:18:51.89,Default,,0,0,0,,‫كالفادوس.‬
Dialogue: 0,0:18:54.89,0:18:58.89,Default,,0,0,0,,‫كان لديه بندقية، وثلاث مسدسات معه.‬
Dialogue: 0,0:19:00.39,0:19:04.19,Default,,0,0,0,,‫لذا اعتقدت أنه بائع أسلحة أو شيء من هذا القبيل.‬
Dialogue: 0,0:19:04.19,0:19:06.19,Default,,0,0,0,,‫أكاي شويتشي؟‬
Dialogue: 0,0:19:06.19,0:19:07.39,Default,,0,0,0,,‫شو.‬
Dialogue: 0,0:19:16.69,0:19:19.99,Default,,0,0,0,,‫لا تقتلها، شو!‬
Dialogue: 0,0:19:30.39,0:19:35.16,Default,,0,0,0,,‫رغم حالتها، تمكنت من إطلاق النار على خزان البنزين باستخدام المرآة.‬
Dialogue: 0,0:19:35.15,0:19:36.59,Default,,0,0,0,,‫مثيرة للإعجاب.‬
Dialogue: 0,0:19:36.59,0:19:38.69,Default,,0,0,0,,‫شو.‬
Dialogue: 0,0:19:38.69,0:19:40.29,Default,,0,0,0,,‫هذا ليس وقت الإعجاب!‬
Dialogue: 0,0:19:40.29,0:19:44.29,Default,,0,0,0,,‫إنها تهرب ومعها رهينة!‬
Dialogue: 0,0:19:44.29,0:19:47.17,Default,,0,0,0,,‫يجب ألا تتركِ مفاتيحك في السيارة أبدًا.‬
Dialogue: 0,0:19:49.19,0:19:51.89,Default,,0,0,0,,‫حسنًا، سأترك الباقي لكِ.‬
Dialogue: 0,0:19:53.19,0:19:59.18,Default,,0,0,0,,‫لم يحن الوقت بعد لتلك الفتاة ذات الشعر البني لتراني.‬
Dialogue: 0,0:20:07.79,0:20:09.19,Default,,0,0,0,,‫شو.‬
Dialogue: 0,0:20:09.39,0:20:13.19,Default,,0,0,0,,‫لم تُكمل كل مهامك بعد، أليس كذلك؟‬
Dialogue: 0,0:20:19.49,0:20:23.49,Default,,0,0,0,,‫شو... شو...
Dialogue: 0,0:21:06.29,0:21:08.59,Default,,0,0,0,,‫لا تحتاجون إلى رصاصتين.‬
Dialogue: 0,0:21:10.59,0:21:16.09,Default,,0,0,0,,‫فرصاصة فضية واحدة تكفي...
Dialogue: 0,0:21:34.90,0:21:39.19,DCEnding,,0,0,0,,لماذا تجلس في غرفتك؟
Dialogue: 0,0:21:41.61,0:21:47.74,DCEnding,,0,0,0,,ما دمت لا أحس ببرودة المطر المنهمر خارجًا
Dialogue: 0,0:21:48.20,0:21:52.41,DCEnding,,0,0,0,,سأكون بجانبك إلى الأبد
Dialogue: 0,0:21:54.83,0:22:01.09,DCEnding,,0,0,0,,نسيت توتري وقلقي وعجلي لبعض الوقت
Dialogue: 0,0:22:02.13,0:22:07.72,DCEnding,,0,0,0,,حتى تلك الأيام المليئة بالغموض الذي لم يُحل تُصبغ باللونين الأحمر والأسود
Dialogue: 0,0:22:08.01,0:22:13.02,DCEnding,,0,0,0,,مع نفسي كما أنا، أرغب في الوقوف في وجه التحديات والقتال
Dialogue: 0,0:22:14.02,0:22:19.23,DCEnding,,0,0,0,,مثلما يتدفق النهر عندما يذوب الثلج
Dialogue: 0,0:22:20.57,0:22:27.28,DCEnding,,0,0,0,,رغم كل شيء، ألتزم بالحقيقة التي أعيشها
Dialogue: 0,0:22:27.78,0:22:34.04,DCEnding,,0,0,0,,تمامًا كأنك ورقة ميتة تتنقل، تطفو رغم أن الأمر يبدو وكأنك تغرق
Dialogue: 0,0:22:34.37,0:22:41.84,DCEnding,,0,0,0,,إلا عندما أنظر إليك، فكل شيء آخر مجرد شكوك
Dialogue: 0,0:22:46.89,0:22:50.49,Default,,0,0,0,,‫تفضل.‬
Dialogue: 0,0:22:50.49,0:22:53.35,Default,,0,0,0,,‫الهاتف الخلوي الذي استعرته منك.‬
Dialogue: 0,0:22:53.35,0:22:55.69,Default,,0,0,0,,‫ماذا؟ ، لا تحتاجينه بعد الآن؟‬
Dialogue: 0,0:22:55.69,0:22:57.36,Default,,0,0,0,,‫نعم.‬
Dialogue: 0,0:22:57.36,0:22:58.59,Default,,0,0,0,,‫ذلك الهاتف الخلوي...
Dialogue: 0,0:22:58.59,0:23:01.36,Default,,0,0,0,,‫سنضطر إلى الاحتفاظ به هنا لفترة،‬
Dialogue: 0,0:23:01.36,0:23:06.69,Default,,0,0,0,,‫فهل يمكنكِ إعطاء هذا الهاتف الخلوي لكونان من نفس الموديل؟‬
Dialogue: 0,0:23:06.69,0:23:11.69,Default,,0,0,0,,‫طالما أن لديه شريحة الهاتف، فلن يواجه مشكلة في استخدامه.‬
Dialogue: 0,0:23:11.69,0:23:14.99,Default,,0,0,0,,‫حسنًا، شكرًا لك، كونان.‬
Dialogue: 0,0:23:22.39,0:23:24.59,Default,,0,0,0,,‫الرقم التسلسلي مختلف.‬
Dialogue: 0,0:23:24.59,0:23:26.49,Default,,0,0,0,,‫يا معلمة جودي.‬
Dialogue: 0,0:23:28.79,0:23:29.79,Default,,0,0,0,,‫ماذا؟‬
Dialogue: 0,0:23:29.79,0:23:32.29,Default,,0,0,0,,‫فقط أقول...
Dialogue: 0,0:23:32.29,0:23:33.99,Default,,0,0,0,,‫حظًا سعيدًا.‬
Dialogue: 0,0:23:33.99,0:23:35.40,Default,,0,0,0,,‫نعم.‬
Dialogue: 0,0:23:40.69,0:23:41.99,Default,,0,0,0,,‫يا كونان!‬
Dialogue: 0,0:23:41.99,0:23:43.40,Default,,0,0,0,,‫ما الذي تفعله؟‬
Dialogue: 0,0:23:43.40,0:23:45.19,Default,,0,0,0,,‫سنكون متأخرين.‬
Dialogue: 0,0:23:51.41,0:23:53.69,Default,,0,0,0,,‫حسنًا!‬
Dialogue: 0,0:24:01.74,0:24:03.06,Default,,0,0,0,,‫تلميح كونان التالي:‬
Dialogue: 0,0:24:03.74,0:24:05.42,Default,,0,0,0,,‫شعر.‬
Dialogue: 0,0:24:05.82,0:24:08.35,Default,,0,0,0,,‫- استعدي اذهبي \N- التالي، حادثة تحدث في صالون تجميل.‬
Dialogue: 0,0:24:08.35,0:24:09.86,Default,,0,0,0,,‫- الآن، قصي! \N- قص رائع.‬
Dialogue: 0,0:24:09.86,0:24:56.68,Default,,0,0,0,,‫أليس كذلك؟‬
