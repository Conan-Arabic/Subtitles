Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs40\pos(200,200)} ABOODY SUBS | ترجمة \NAoibu_Arabic : محاكاة\NX : @ABOODY_SUBS \NX : @Aoibu_Arabic
Dialogue: 0,0:00:01.90,0:00:04.65,Default,,0,0,0,,.أعذار، رموز، حيل، صفقات
Dialogue: 0,0:00:04.65,0:00:06.99,Default,,0,0,0,,.المنظمة السوداء الغامضة
Dialogue: 0,0:00:06.99,0:00:08.74,Default,,0,0,0,,.جريمة مستحيلة لا يمكن تخيلها
Dialogue: 0,0:00:08.74,0:00:10.74,Default,,0,0,0,,!لا بد أن هناك دليلًا في مكان ما
Dialogue: 0,0:00:10.74,0:00:12.41,Default,,0,0,0,,،يسعى وراء الحقيقة دائما
Dialogue: 0,0:00:12.41,0:00:13.75,Default,,0,0,0,,!بجسد طفل وعقل بالغ
Dialogue: 0,0:00:13.75,0:00:16.71,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:00:16.66,0:00:18.37,DCOpening,,0,0,0,,!بحثًا عن الحب!   بحثًا عن الحلم
Dialogue: 0,0:00:18.37,0:00:19.79,DCOpening,,0,0,0,,!!بحثًا عن كل الحقيقة
Dialogue: 0,0:00:19.79,0:00:22.79,DCOpening,,0,0,0,,لا أحد يستطيع أن ينتزع  
Dialogue: 0,0:00:22.79,0:00:26.17,DCOpening,,0,0,0,,!الحلم الذي أخفيته في عينيك
Dialogue: 0,0:00:26.17,0:00:32.59,DCOpening,,0,0,0,,!الآن أمسك الحقيقة بوضوح
Dialogue: 0,0:00:38.43,0:00:44.35,DCOpening,,0,0,0,,الدموع الدافئة التي سالت عندما لمست كتفك
Dialogue: 0,0:00:44.35,0:00:50.15,DCOpening,,0,0,0,,!!ستولد من جديد قبل الفجر... لتصبح قوة
Dialogue: 0,0:00:50.77,0:00:56.86,DCOpening,,0,0,0,,...حتى لو لم نكن معًا
Dialogue: 0,0:00:56.86,0:01:03.20,DCOpening,,0,0,0,,...بالحب، يمكننا إيقاف الزمن لندعو بعضنا  
Dialogue: 0,0:01:04.79,0:01:06.29,DCOpening,,0,0,0,,!بحثًا عن الحب!   بحثًا عن الحلم
Dialogue: 0,0:01:06.29,0:01:07.79,DCOpening,,0,0,0,,!!بحثًا عن كل الحقيقة
Dialogue: 0,0:01:07.79,0:01:10.75,DCOpening,,0,0,0,,شغفي اللامحدود  
Dialogue: 0,0:01:10.75,0:01:14.13,DCOpening,,0,0,0,,يدفعني لأصل إلى المستقبل الذي أردته  
Dialogue: 0,0:01:14.13,0:01:17.13,DCOpening,,0,0,0,,!!لأنك كنت دائمًا إجابتي
Dialogue: 0,0:01:17.13,0:01:18.64,DCOpening,,0,0,0,,!بحثًا عن الحب!  بحثًا عن الحلم  
Dialogue: 0,0:01:18.64,0:01:20.14,DCOpening,,0,0,0,,!!بحثًا عن كل الحقيقة
Dialogue: 0,0:01:20.14,0:01:23.43,DCOpening,,0,0,0,,لا أحد يستطيع أن ينتزع  
Dialogue: 0,0:01:23.43,0:01:26.31,DCOpening,,0,0,0,,!الحلم الذي أخفيته في عينيك
Dialogue: 0,0:01:26.31,0:01:32.98,DCOpening,,0,0,0,,!!الآن أمسك الحقيقة بوضوح
Dialogue: 0,0:01:52.58,0:02:01.96,Default,,0,0,0,,.أخذني عمي كوغورو مع ران وسونوكو إلى اجتماع عشاق السحر عبر الإنترنت في كوخ جبلي
Dialogue: 0,0:02:01.96,0:02:08.88,Default,,0,0,0,,في طريق العودة، ذكرت أخبار الراديو أن السيد تسوتومو نيشياما، قائد مجموعة عشاق السحر، قد قُتل
Dialogue: 0,0:02:08.88,0:02:13.56,Default,,0,0,0,,.مع كلمات مكتوبة على حاسوبه تشير إلى جرائم قتل متسلسلة مستقبلية
Dialogue: 0,0:02:15.97,0:02:19.31,Default,,0,0,0,,،عدنا لتحذير ران والآخرين
Dialogue: 0,0:02:19.31,0:02:22.64,Default,,0,0,0,,!فوجدنا الجسر يحترق، وكأنه يحجب طريقنا
Dialogue: 0,0:02:26.60,0:02:29.65,Default,,0,0,0,,،بطريقة ما تمكنت من الوصول إلى الكوخ
Dialogue: 0,0:02:29.65,0:02:33.16,Default,,0,0,0,,.لكن زكامي ازداد سوءًا، وأغمي عليّ بسبب الحمى الشديدة
Dialogue: 0,0:02:35.45,0:02:37.49,Default,,0,0,0,,...وبعد ذلك
Dialogue: 0,0:02:37.49,0:02:41.45,Default,,0,0,0,,!وُجدنا الضحية الثانية
Dialogue: 0,0:02:42.16,0:02:44.08,Default,,0,0,0,,!هذا مستحيل
Dialogue: 0,0:02:44.62,0:02:46.92,Default,,0,0,0,,ما الخطب، سيد هامانو؟
Dialogue: 0,0:02:50.00,0:02:51.89,Default,,0,0,0,,!لا تقتربوا
Dialogue: 0,0:02:53.88,0:02:56.30,Default,,0,0,0,,.لا فائدة. إنه ميت بالفعل
Dialogue: 0,0:02:56.80,0:02:57.84,Default,,0,0,0,,!مستحيل
Dialogue: 0,0:02:57.84,0:03:00.72,Default,,0,0,0,,.ولا يجب أن نلمس أي شيء في مسرح الجريمة
Dialogue: 0,0:03:00.72,0:03:02.47,Default,,0,0,0,,مسرح الجريمة؟
Dialogue: 0,0:03:02.47,0:03:04.39,Default,,0,0,0,,ألا ترون؟
Dialogue: 0,0:03:04.39,0:03:07.77,Default,,0,0,0,,،إنه على بعد أكثر من 10 أمتار من الكوخ
Dialogue: 0,0:03:07.77,0:03:11.27,Default,,0,0,0,,.ولا توجد أي آثار أقدام حوله إلا تلك التي تركها الشخص الذي ركض للتو
Dialogue: 0,0:03:11.27,0:03:13.74,Default,,0,0,0,,...لكن هذا
Dialogue: 0,0:03:13.74,0:03:19.67,Default,,0,0,0,,.نعم. هذه جريمة لا يمكن لأي إنسان أن يرتكبها إلا إذا كان للجاني يمتلك أجنحة
Dialogue: 0,0:03:20.07,0:03:22.25,Default,,0,0,0,,!جريمة مستحيلة
Dialogue: 0,0:03:26.83,0:03:32.09,Default,,0,0,0,,""‏قضية قتل عشاق السحر  - جزء الاستنتاج
Dialogue: 0,0:03:33.76,0:03:35.93,Default,,0,0,0,,جريمة مستحيلة؟
Dialogue: 0,0:03:36.91,0:03:38.71,Default,,0,0,0,,ولكن، لماذا السيد هامانو؟
Dialogue: 0,0:03:38.71,0:03:41.61,Default,,0,0,0,,لماذا قُتل؟
Dialogue: 0,0:03:41.81,0:03:43.97,Default,,0,0,0,,...ما زلنا لا نعرف
Dialogue: 0,0:03:43.97,0:03:47.64,Default,,0,0,0,,.حاليًا، كل ما يمكننا قوله هو أن سبب الوفاة كان الاختناق
Dialogue: 0,0:03:48.27,0:03:53.19,Default,,0,0,0,,.من قتل السيد هامانو فعل ذلك بلف شيء مثل خيط رفيع حول عنقه
Dialogue: 0,0:03:53.19,0:03:58.37,Default,,0,0,0,,.وبغض النظر عن الدافع أو الطريقة، فإن شيء واحد واضح
Dialogue: 0,0:03:59.49,0:04:02.96,Default,,0,0,0,,.إنه شخص قريب من هذا الكوخ
Dialogue: 0,0:04:03.87,0:04:09.25,Default,,0,0,0,,مهلاً، مهلاً. هل تقول إن الجاني بيننا؟
Dialogue: 0,0:04:09.25,0:04:11.79,Default,,0,0,0,,.لا. من المبكر الحكم
Dialogue: 0,0:04:11.79,0:04:14.50,Default,,0,0,0,,لكن ألسنا الوحيدين هنا؟
Dialogue: 0,0:04:14.50,0:04:15.92,Default,,0,0,0,,.لا
Dialogue: 0,0:04:15.92,0:04:19.47,Default,,0,0,0,,.أعتقد أن هناك مشتبه به آخر
Dialogue: 0,0:04:19.47,0:04:25.77,Default,,0,0,0,,.أعتقد أنه كان يختبئ هنا منذ فترة طويلة
Dialogue: 0,0:04:25.77,0:04:27.48,Default,,0,0,0,,من هذا؟
Dialogue: 0,0:04:27.48,0:04:29.77,Default,,0,0,0,,هل نسيتم بالفعل؟
Dialogue: 0,0:04:29.77,0:04:31.81,Default,,0,0,0,,.أنتم غريبون
Dialogue: 0,0:04:31.81,0:04:37.78,Default,,0,0,0,,.إنه أحد أعضاء مجموعة عشاق السحر الذي كان من المفترض أن ياتي إلى هذا الكوخ
Dialogue: 0,0:04:38.74,0:04:40.79,Default,,0,0,0,,.الظل
Dialogue: 0,0:04:43.95,0:04:47.41,Default,,0,0,0,,.فهمت. هذا منطقي
Dialogue: 0,0:04:47.41,0:04:53.42,Default,,0,0,0,,.بعد كل شيء، ترك رسالة مثل تلك بجوار السيد نيشياما المقتول
Dialogue: 0,0:04:54.00,0:04:59.13,Default,,0,0,0,,إذن، الآن، قد يكون يختبئ وينتظر لانتزاع حياتنا؟
Dialogue: 0,0:04:59.13,0:05:01.43,Default,,0,0,0,,.لا بد أنكم تمزحون
Dialogue: 0,0:05:01.43,0:05:03.14,Default,,0,0,0,,!انتظري، أنسة تاناكا
Dialogue: 0,0:05:03.14,0:05:05.27,Default,,0,0,0,,أنسة تاناكا، ما الخطب؟
Dialogue: 0,0:05:05.64,0:05:10.48,Default,,0,0,0,,!سأعود إلى المنزل! لن أبقى في كوخ يوجد فيه قاتل
Dialogue: 0,0:05:10.77,0:05:11.90,Default,,0,0,0,,.لا يمكنكِ العودة
Dialogue: 0,0:05:13.15,0:05:17.73,Default,,0,0,0,,.عندما عدت إلى هنا، كان أحدهم قد أشعل النار في الجسر
Dialogue: 0,0:05:18.23,0:05:22.95,Default,,0,0,0,,!ماذا قلت؟ بدون ذلك الجسر، لا يمكننا مغادرة الجبل
Dialogue: 0,0:05:22.95,0:05:25.42,Default,,0,0,0,,هل يمكن أن الجاني هو من قطع خط الهواتف؟
Dialogue: 0,0:05:25.66,0:05:27.58,Default,,0,0,0,,!لا زلنا نمتلك هواتفنا المحمولة
Dialogue: 0,0:05:27.58,0:05:29.08,Default,,0,0,0,,.نـ-نعم
Dialogue: 0,0:05:29.08,0:05:30.79,Default,,0,0,0,,.لا فائدة
Dialogue: 0,0:05:30.79,0:05:33.30,Default,,0,0,0,,.لا توجد إشارة للهاتف هنا
Dialogue: 0,0:05:33.92,0:05:39.51,Default,,0,0,0,,.باختصار، الجاني عزلنا عن العالم الخارجي
Dialogue: 0,0:05:39.88,0:05:42.73,Default,,0,0,0,,!مستحيل
Dialogue: 0,0:05:45.01,0:05:49.43,Default,,0,0,0,,هل تعرف هوية الظل؟ حقًا، أيها المفتش؟
Dialogue: 0,0:05:49.43,0:05:56.82,Default,,0,0,0,,.نعم. لا نعرف هويته الحقيقية، لكننا اكتشفنا أنه في مجموعة أعضاء السحر
Dialogue: 0,0:05:57.19,0:05:59.53,Default,,0,0,0,,.إذن انظر إلى بيانات هويته
Dialogue: 0,0:05:59.53,0:06:02.24,Default,,0,0,0,,.حاولنا. حصلنا على شخص غريب تمامًا
Dialogue: 0,0:06:02.24,0:06:03.15,Default,,0,0,0,,شخص... غريب؟
Dialogue: 0,0:06:03.15,0:06:04.57,Default,,0,0,0,,.نعم
Dialogue: 0,0:06:04.57,0:06:11.92,Default,,0,0,0,,.كان شخصًا لا يهتم بالسحر، ولم يلمس حاسوبًا منذ سنوات
Dialogue: 0,0:06:12.37,0:06:19.80,Default,,0,0,0,,".باختصار، شخص ما استخدم تلك الهوية وكلمة المرور، وكان ينشر تحت اسم "الظل
Dialogue: 0,0:06:20.76,0:06:24.77,Default,,0,0,0,,.بالإضافة إلى ذلك، هذه ليست المشكلة الوحيدة
Dialogue: 0,0:06:25.43,0:06:29.60,Default,,0,0,0,,...هناك مشكلة أخرى
Dialogue: 0,0:06:29.60,0:06:37.44,Default,,0,0,0,,...شخص مشبوه بين من في الكوخ يرسل باستخدام هوية مزيفة
Dialogue: 0,0:06:46.11,0:06:48.37,Default,,0,0,0,,...إنه خطأي
Dialogue: 0,0:06:49.03,0:06:55.12,Default,,0,0,0,,.بعد كل شيء، أنا من اختار السيد هامانو كمسؤول عن الترفيه الليلة
Dialogue: 0,0:06:55.12,0:07:00.43,Default,,0,0,0,,...لو لم يذهب السيد هامانو إلى غرفته بمفرده، لما قُتل
Dialogue: 0,0:07:01.34,0:07:05.18,Default,,0,0,0,,...لكن بما أنني اخترته، السيد هامانو
Dialogue: 0,0:07:05.88,0:07:06.84,Default,,0,0,0,,...سونوكو
Dialogue: 0,0:07:06.84,0:07:09.10,Default,,0,0,0,,.لا تقلقي بشأن ذلك
Dialogue: 0,0:07:09.22,0:07:14.73,Default,,0,0,0,,في ذلك الوقت، كنتِ معصوبة العينين، وكل ما فعلتيه هو سحب رموز عشوائية، أليس كذلك؟
Dialogue: 0,0:07:15.39,0:07:17.71,Default,,0,0,0,,،عندما تخسر في اليانصيب
Dialogue: 0,0:07:17.71,0:07:21.27,Default,,0,0,0,,لا تحمل ضغينة تجاه من فازوا، أليس كذلك؟
Dialogue: 0,0:07:21.27,0:07:22.69,Default,,0,0,0,,.الأمر نفسه هنا
Dialogue: 0,0:07:23.23,0:07:27.41,Default,,0,0,0,,.كل ما فعلتيه هو مساعدة السيد هامانو في سحره
Dialogue: 0,0:07:27.41,0:07:30.99,Default,,0,0,0,,ليس لديكِ سبب للقلق بشأن ذلك، أليس كذلك؟
Dialogue: 0,0:07:30.99,0:07:32.41,Default,,0,0,0,,.نـ-نعم
Dialogue: 0,0:07:32.91,0:07:35.37,Default,,0,0,0,,مساعدة سحره؟
Dialogue: 0,0:07:35.96,0:07:38.67,Default,,0,0,0,,،لكن، هل سنكون بخير
Dialogue: 0,0:07:38.67,0:07:41.75,Default,,0,0,0,,.أن نبقى هنا بانتظار احد ياتي للإنقاذنا
Dialogue: 0,0:07:41.75,0:07:43.64,Default,,0,0,0,,.سنكون بخير
Dialogue: 0,0:07:43.96,0:07:47.88,Default,,0,0,0,,:بعد أن تجاوزت الجسر المحترق، ناداني العم
Dialogue: 0,0:07:47.88,0:07:52.68,Default,,0,0,0,,"!"سأتصل بالشرطة على الفور، لذا ابقوا مكانكم وانتظروا في الكوخ
Dialogue: 0,0:07:52.68,0:07:57.14,Default,,0,0,0,,!أنا متأكد أن الشرطة ستأتي وتنقذنا قبل الصباح
Dialogue: 0,0:07:57.14,0:07:59.15,Default,,0,0,0,,...هذا جيد، لكن
Dialogue: 0,0:07:59.60,0:08:03.82,Default,,0,0,0,,...لكن إذا كان الجاني هو الظل، إذن
Dialogue: 0,0:08:03.82,0:08:07.24,Default,,0,0,0,,عرفت ذلك. إنه يفعل كل هذا بسبب الدردشة في ذلك اليوم، أليس كذلك؟
Dialogue: 0,0:08:07.84,0:08:09.49,Default,,0,0,0,,الدردشة؟
Dialogue: 0,0:08:09.50,0:08:17.42,Default,,0,0,0,,.الدردشة هي محادثة فورية عبر الحواسيب بين عدة أشخاص عبر خط الهاتف
Dialogue: 0,0:08:17.88,0:08:22.93,Default,,0,0,0,,.في الدردشة، نتحدث من خلال الكلمات التي نكتبها وتظهر على الشاشة
Dialogue: 0,0:08:23.76,0:08:26.26,Default,,0,0,0,,لكن ما علاقة ذلك بالجريمة؟
Dialogue: 0,0:08:26.26,0:08:31.15,Default,,0,0,0,,.ألا تتذكري؟ لقد قالوا شيئًا عن جدال حول ساحر
Dialogue: 0,0:08:31.35,0:08:39.65,Default,,0,0,0,,.هل تعلمون؟ ساحر عجوز يدعى هودن هاروي أطلق على نفسه لقب ملك الهروب الياباني
Dialogue: 0,0:08:40.69,0:08:44.37,Default,,0,0,0,,هل تقصد الذي مات قبل شهر أثناء أدائه خدعة سحرية؟
Dialogue: 0,0:08:44.78,0:08:48.83,Default,,0,0,0,,،نعم. عندما كان الجميع يتحدثون عن ذلك الحادث في ذلك الوقت
Dialogue: 0,0:08:48.83,0:08:52.84,Default,,0,0,0,,.قال الظل شيئًا غريبًا
Dialogue: 0,0:08:53.50,0:08:57.55,Default,,0,0,0,,"!"ذلك الساحر العظيم مات بسببكم
Dialogue: 0,0:08:58.38,0:09:00.01,Default,,0,0,0,,ماذا قصد بذلك؟
Dialogue: 0,0:09:00.71,0:09:06.30,Default,,0,0,0,,.قبل بضعة أسابيع، في الدردشة، كنا نتحدث عن فقرة هروبه
Dialogue: 0,0:09:06.30,0:09:10.02,Default,,0,0,0,,.قلنا إننا نتمنى أن يحاول أحدهم ذلك مرة أخرى
Dialogue: 0,0:09:10.02,0:09:12.10,Default,,0,0,0,,.ثم حدث الحادث
Dialogue: 0,0:09:12.10,0:09:16.69,Default,,0,0,0,,...قال الظل إنه حدث لأننا تحدثنا عنه، لكن
Dialogue: 0,0:09:16.69,0:09:18.87,Default,,0,0,0,,.هذا سخيف، مع ذلك
Dialogue: 0,0:09:19.36,0:09:23.28,Default,,0,0,0,,،أزعجني ذلك، فاستشرت قائد المجموعة، السيد نيشياما
Dialogue: 0,0:09:23.28,0:09:28.53,Default,,0,0,0,,.واستنتجنا أن لا أحد ممن كانوا في تلك الدردشة يمكن أن يكون السيد هاروي
Dialogue: 0,0:09:29.16,0:09:33.00,Default,,0,0,0,,،لكننا لا نستطيع أبدًا أن نكون متأكدين من أن الشخص الذي يحمل هوية معينة هو من يقول إنه هو
Dialogue: 0,0:09:33.00,0:09:37.59,Default,,0,0,0,,.أو أن أحدهم قد أظهر له سجل الدردشة
Dialogue: 0,0:09:37.59,0:09:42.38,Default,,0,0,0,,.لهذا السبب، نظمت أنا والسيد نيشياما هذا الاجتماع
Dialogue: 0,0:09:42.38,0:09:48.60,Default,,0,0,0,,.إذا اجتمعنا بكل من كان في تلك الدردشة، يمكننا معرفة ما إذا كان هناك أي شيء فيها
Dialogue: 0,0:09:48.60,0:09:50.43,Default,,0,0,0,,.فهمت
Dialogue: 0,0:09:51.22,0:09:55.90,Default,,0,0,0,,لكن الظل لم يكن عضوًا منذ فترة طويلة، أليس كذلك؟
Dialogue: 0,0:09:55.90,0:09:58.65,Default,,0,0,0,,كيف عرف عن تلك المحادثة؟
Dialogue: 0,0:09:58.65,0:10:04.74,Default,,0,0,0,,.نعم. دعونا الظل أيضًا حتى نرى بأنفسنا
Dialogue: 0,0:10:05.15,0:10:08.82,Default,,0,0,0,,بالمناسبة، كان الكاهن الظل دائمًا يقول
Dialogue: 0,0:10:08.82,0:10:13.50,Default,,0,0,0,,"."أستطيع الطيران في السماء، والإختفاء عند الرغبة
Dialogue: 0,0:10:13.50,0:10:15.21,Default,,0,0,0,,...مهلا، هذا
Dialogue: 0,0:10:15.21,0:10:16.79,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:10:16.79,0:10:19.63,Default,,0,0,0,,،إذا الجاني هو الظل حقًا
Dialogue: 0,0:10:19.63,0:10:23.60,Default,,0,0,0,,.فسيكون قادرًا على تنفيذ تلك الجريمة المستحيلة
Dialogue: 0,0:10:24.26,0:10:28.14,Default,,0,0,0,,.أمام أعيننا، عرض سحري دموي
Dialogue: 0,0:10:31.89,0:10:36.15,Default,,0,0,0,,.الجو يزداد برودة. سأذهب لأحضر شيئًا لأغطي نفسي من غرفتي
Dialogue: 0,0:10:37.19,0:10:40.19,Default,,0,0,0,,.سأذهب أيضًا
Dialogue: 0,0:10:40.19,0:10:43.15,Default,,0,0,0,,.أريد أن أحضر سترة أو شيئًا لألبسه
Dialogue: 0,0:10:43.15,0:10:45.90,Default,,0,0,0,,.حسنًا، سأذهب معكم أيضًا
Dialogue: 0,0:10:46.20,0:10:47.83,Default,,0,0,0,,.كلما زاد عددنا، زادت سلامتنا
Dialogue: 0,0:10:56.47,0:11:00.06,Default,,0,0,0,,...تبا. أن نتوتر لدخول غرفة
Dialogue: 0,0:11:01.14,0:11:03.35,Default,,0,0,0,,...هذا كبير جدًا بالنسبة لي
Dialogue: 0,0:11:03.75,0:11:05.72,Default,,0,0,0,,.توقف عن الحركة
Dialogue: 0,0:11:05.73,0:11:09.99,Default,,0,0,0,,أخبريني، ماذا قصدوا عندما قالوا إن أختي سونوكو ساعدت في الخدعة السحرية؟
Dialogue: 0,0:11:09.99,0:11:15.49,Default,,0,0,0,,.لقد ساعدت السيد هامانو في تعيين مهام الجميع من خلال خدعة سحرية
Dialogue: 0,0:11:15.49,0:11:17.46,Default,,0,0,0,,خدعة سحرية؟
Dialogue: 0,0:11:18.08,0:11:21.25,Default,,0,0,0,,،اتضح أن القائد المؤقت كانت الانسة كورودا
Dialogue: 0,0:11:21.25,0:11:24.04,Default,,0,0,0,,.والانسة تاناكا كانت مسؤولة عن إعداد الحمام
Dialogue: 0,0:11:24.04,0:11:26.67,Default,,0,0,0,,.والمسؤول عن الترفيه كان السيد هامانو
Dialogue: 0,0:11:26.67,0:11:32.68,Default,,0,0,0,,إذن، ذهب السيد هامانو إلى غرفته بمفرده لأنه كان لأنه كان مسؤول الترفيه؟
Dialogue: 0,0:11:32.68,0:11:33.68,Default,,0,0,0,,.نعم
Dialogue: 0,0:11:33.68,0:11:36.10,Default,,0,0,0,,.كان يجهز الخدع السحرية في غرفته
Dialogue: 0,0:11:36.51,0:11:39.35,Default,,0,0,0,,وفي ذلك الوقت، ماذا كان الآخرون يفعلون؟
Dialogue: 0,0:11:39.35,0:11:42.31,Default,,0,0,0,,.أعتقد أن الجميع كانوا يقومون بالمهام الموكلة إليهم
Dialogue: 0,0:11:42.85,0:11:44.52,Default,,0,0,0,,.صديقتي ران، أسرعي
Dialogue: 0,0:11:44.59,0:11:47.09,Default,,0,0,0,,.فلا احد يعرف يعلم أين يتواجد الظل الآن
Dialogue: 0,0:11:47.09,0:11:48.49,Default,,0,0,0,,.آسفة
Dialogue: 0,0:11:51.53,0:11:53.20,Default,,0,0,0,,...الظل
Dialogue: 0,0:11:53.20,0:11:55.96,Default,,0,0,0,,هل هو الجاني حقًا؟
Dialogue: 0,0:11:56.53,0:11:59.58,Default,,0,0,0,,.لم يقابله أحد بعد
Dialogue: 0,0:11:59.58,0:12:02.29,Default,,0,0,0,,.وأدلة الآخرين ليست واضحة تمامًا
Dialogue: 0,0:12:02.29,0:12:07.50,Default,,0,0,0,,.بأي حال، الجاني عزلنا هنا ولا يزال لديه خطط لنا
Dialogue: 0,0:12:07.50,0:12:13.47,Default,,0,0,0,,!لكنني لن أسمح له بتنفيذ خطته، خاصة بعد ارتكاب جريمة قتل
Dialogue: 0,0:12:17.34,0:12:18.26,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:12:19.14,0:12:20.86,Default,,0,0,0,,...سهم
Dialogue: 0,0:12:22.27,0:12:23.77,Default,,0,0,0,,...مستحيل
Dialogue: 0,0:12:24.64,0:12:26.31,Default,,0,0,0,,!من هناك؟ اخرج
Dialogue: 0,0:12:26.31,0:12:28.27,Default,,0,0,0,,!لا تفعلي -\N!ابتعدي عن النافذة -
Dialogue: 0,0:12:30.23,0:12:32.28,Default,,0,0,0,,!ماذا الآن؟
Dialogue: 0,0:12:32.82,0:12:33.69,Default,,0,0,0,,...سونوكو
Dialogue: 0,0:12:33.69,0:12:35.33,Default,,0,0,0,,!تبا
Dialogue: 0,0:12:39.24,0:12:40.95,Default,,0,0,0,,!سونوكو... أين سونوكو؟
Dialogue: 0,0:12:40.95,0:12:42.67,Default,,0,0,0,,.إنها مع الانسة كورودا في الحمام
Dialogue: 0,0:12:42.87,0:12:44.08,Default,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:12:44.08,0:12:50.29,Default,,0,0,0,,.زجاج... سمعنا صوت زجاج ينكسر في الحمام، فذهبت سونوكو للتحقق
Dialogue: 0,0:12:54.34,0:12:56.68,Default,,0,0,0,,...هناك سهم في المرآة
Dialogue: 0,0:12:56.68,0:12:58.76,Default,,0,0,0,,هل أتى من تلك النافذة؟
Dialogue: 0,0:12:58.76,0:13:03.06,Default,,0,0,0,,!شخص... شخص ما يهاجمنا من الخارج
Dialogue: 0,0:13:03.06,0:13:05.81,Default,,0,0,0,,!لا بد أنك تمزح! لقد سئمت من هذا
Dialogue: 0,0:13:05.81,0:13:07.81,Default,,0,0,0,,!انتظري، أنسة تاناكا
Dialogue: 0,0:13:10.19,0:13:12.02,Default,,0,0,0,,!أنسة تاناكا
Dialogue: 0,0:13:12.02,0:13:13.61,Default,,0,0,0,,!لا تخرجي
Dialogue: 0,0:13:14.57,0:13:16.40,Default,,0,0,0,,لا أعرف من أنت، لكن
Dialogue: 0,0:13:16.40,0:13:19.04,Default,,0,0,0,,!اخرج واظهر نفسك
Dialogue: 0,0:13:19.82,0:13:22.91,Default,,0,0,0,,!مهلا، انظروا ! هناك الكثير من الآثار بين الأشجار
Dialogue: 0,0:13:23.74,0:13:26.37,Default,,0,0,0,,!كما توقعت! هناك شخص مختبئ
Dialogue: 0,0:13:26.37,0:13:28.26,Default,,0,0,0,,!لا... مستحيل
Dialogue: 0,0:13:29.50,0:13:30.46,Default,,0,0,0,,!كوني حذرًة
Dialogue: 0,0:13:32.34,0:13:33.72,Default,,0,0,0,,!انسة تاناكا
Dialogue: 0,0:13:34.88,0:13:36.47,Default,,0,0,0,,هل أنتِ بخير؟
Dialogue: 0,0:13:36.47,0:13:40.39,Default,,0,0,0,,!لماذا يحدث هذا لنا؟ لماذا؟
Dialogue: 0,0:13:43.93,0:13:46.31,Default,,0,0,0,,مـ-مهلاً! هل هذا...؟
Dialogue: 0,0:13:46.89,0:13:48.27,Default,,0,0,0,,أليس هذا قوسًا؟
Dialogue: 0,0:13:51.69,0:13:53.65,Default,,0,0,0,,.لكننا الآن متأكدون
Dialogue: 0,0:13:53.65,0:13:57.07,Default,,0,0,0,,.الجاني ليس أيًا منا
Dialogue: 0,0:13:57.07,0:14:03.16,Default,,0,0,0,,.لكن هذا جيد. لقد تخلى عن قوسه قبل أن يؤذي أحدًا
Dialogue: 0,0:14:08.33,0:14:09.46,Default,,0,0,0,,!تبا
Dialogue: 0,0:14:17.00,0:14:20.09,Default,,0,0,0,,!تبا. يا لها من اجتماع هذا
Dialogue: 0,0:14:20.09,0:14:22.30,Default,,0,0,0,,.ما كان ينبغي لي المجيء إلى هذا المكان أبدًا
Dialogue: 0,0:14:22.30,0:14:25.72,Default,,0,0,0,,.لا تلقي اللوم على الاجتماع
Dialogue: 0,0:14:25.72,0:14:31.31,Default,,0,0,0,,قد تكون مرتاحًا، لكنني كدت أن أُقتل بذلك القوس، أتعلم؟
Dialogue: 0,0:14:31.31,0:14:33.15,Default,,0,0,0,,هل لديك أي فكرة عما أشعر به؟
Dialogue: 0,0:14:33.15,0:14:35.23,Default,,0,0,0,,.على أي حال، لنعود إلى الكوخ
Dialogue: 0,0:14:35.23,0:14:37.44,Default,,0,0,0,,.البقاء هنا خطر
Dialogue: 0,0:14:37.44,0:14:38.28,Default,,0,0,0,,.أنتِ محقة
Dialogue: 0,0:14:40.19,0:14:42.86,Default,,0,0,0,,...السيد هامانو... يا له من مسكين
Dialogue: 0,0:14:42.86,0:14:45.03,Default,,0,0,0,,.سيُترك وحيدًا في الثلج
Dialogue: 0,0:14:45.62,0:14:48.74,Default,,0,0,0,,.ربما يجب أن نضع أغطية أو شيئًا عليه
Dialogue: 0,0:14:48.74,0:14:50.50,Default,,0,0,0,,.لا يمكنكِ
Dialogue: 0,0:14:51.16,0:14:56.75,Default,,0,0,0,,،لا توجد آثار أقدام حول الجثة في الثلج
Dialogue: 0,0:14:56.75,0:15:00.01,Default,,0,0,0,,.مما يثبت أن جريمة مستحيلة قد ارتكبت
Dialogue: 0,0:15:00.01,0:15:06.01,Default,,0,0,0,,.لا يمكننا تشويه هذا العمل الفني الجميل بآثار أقدامنا غير الضرورية
Dialogue: 0,0:15:07.60,0:15:10.32,Default,,0,0,0,,عمل فني، تقول؟ -\N!الجو بارد -
Dialogue: 0,0:15:14.60,0:15:16.61,Default,,0,0,0,,أليس هذا من القوس؟
Dialogue: 0,0:15:17.36,0:15:20.78,Default,,0,0,0,,إذن هذه السهام كانت موجهة لنا؟
Dialogue: 0,0:15:20.78,0:15:24.07,Default,,0,0,0,,.لو كنا غير محظوظين، لقتلنا جميعًا
Dialogue: 0,0:15:24.82,0:15:27.66,Default,,0,0,0,,.على أي حال، لنعود إلى الداخل جميعًا
Dialogue: 0,0:15:35.50,0:15:39.67,Default,,0,0,0,,الثلج الوحيد الذي سقط كان ما على الأغصان؟
Dialogue: 0,0:15:40.88,0:15:42.64,Default,,0,0,0,,لماذا؟
Dialogue: 0,0:15:52.22,0:15:56.06,Default,,0,0,0,,!ثقب! هناك ثقب صغير في جذع الشجرة
Dialogue: 0,0:15:56.06,0:15:59.02,Default,,0,0,0,,هل صنعه أحد للمتعة؟
Dialogue: 0,0:15:59.02,0:16:02.95,Default,,0,0,0,,أم أن شخصًا قريبًا صنعه للتو؟
Dialogue: 0,0:16:03.40,0:16:05.91,Default,,0,0,0,,وإذا كان الأمر كذلك، فلماذا؟
Dialogue: 0,0:16:06.24,0:16:10.71,Default,,0,0,0,,...والأكثر إثارة للشكوك هو الرجل الذي كان يتصرف بغرابة منذ فترة
Dialogue: 0,0:16:12.79,0:16:14.83,Default,,0,0,0,,.دويتو كاتسوكي
Dialogue: 0,0:16:15.37,0:16:18.83,Default,,0,0,0,,ماذا كنت أفعل عندما قُتل السيد هامانو؟
Dialogue: 0,0:16:19.88,0:16:23.01,Default,,0,0,0,,.كنت نائمًا حينها، لذا أريد أن أعرف
Dialogue: 0,0:16:23.01,0:16:25.47,Default,,0,0,0,,لكن لماذا تريد معرفة ذلك؟
Dialogue: 0,0:16:25.87,0:16:30.75,Default,,0,0,0,,فهمت. ما زلت تعتقد أن أحدنا هو الجاني، أليس كذلك؟
Dialogue: 0,0:16:30.75,0:16:34.67,Default,,0,0,0,,،لكن أيها الصبي، السهم جاء من الخارج
Dialogue: 0,0:16:34.67,0:16:40.80,Default,,0,0,0,,.ووجدنا القوس خارجًا. مما يعني أن شخصًا من الخارج يحاول قتلنا
Dialogue: 0,0:16:40.80,0:16:46.26,Default,,0,0,0,,لكن لم ير أحد وجهه، أليس كذلك؟ هل من المبكر افتراض ذلك؟
Dialogue: 0,0:16:46.85,0:16:47.72,Default,,0,0,0,,!كونان
Dialogue: 0,0:16:47.72,0:16:51.02,Default,,0,0,0,,.نعم، أنه محق. من الأفضل أن نخبره بما كنا نفعله
Dialogue: 0,0:16:51.68,0:16:57.15,Default,,0,0,0,,السيد هامانو كان وحده في غرفته عندما قُتل، أليس كذلك؟
Dialogue: 0,0:16:57.15,0:17:02.74,Default,,0,0,0,,.في ذلك الوقت، كنت أجهز الطاولة مع الانسة كورودا في انتظار وقت الترفيه
Dialogue: 0,0:17:02.74,0:17:04.53,Default,,0,0,0,,أليس هذا صحيحًا، يا انسة كورودا؟
Dialogue: 0,0:17:04.53,0:17:10.49,Default,,0,0,0,,.نعم. وبعد ذلك، ذهبت إلى المطبخ لمساعدة سوغاما
Dialogue: 0,0:17:10.49,0:17:14.04,Default,,0,0,0,,.السيد آرا طلب مني تحضير شيء للأكل
Dialogue: 0,0:17:14.79,0:17:19.00,Default,,0,0,0,,عندما كانت الانسة كورودا والسيد سوغاما في المطبخ، أين كنت يا سيد دويتو.
Dialogue: 0,0:17:19.00,0:17:22.97,Default,,0,0,0,,.ذهبت إلى غرفتي لأحضر بعض البسكويت
Dialogue: 0,0:17:23.51,0:17:25.84,Default,,0,0,0,,ماذا؟ بسكويت؟
Dialogue: 0,0:17:26.51,0:17:31.31,Default,,0,0,0,,.اما انا فذهبت إلى غرفة ران للاطمئنان على كونان
Dialogue: 0,0:17:31.31,0:17:39.06,Default,,0,0,0,,.نعم. ثم طلبت مني سونوكو النزول، تركت كونان هناك وجئت إلى غرفة المعيشة
Dialogue: 0,0:17:39.06,0:17:42.86,Default,,0,0,0,,.اما انا فذهبت وحدي إلى قبو النبيذ لأحضر بعض النبيذ
Dialogue: 0,0:17:42.86,0:17:47.41,Default,,0,0,0,,.وانا ذهبت لإحضار حطب للحمام
Dialogue: 0,0:17:47.41,0:17:50.62,Default,,0,0,0,,هل تعرفين كم استغرق منك ذلك؟
Dialogue: 0,0:17:50.62,0:17:54.79,Default,,0,0,0,,.لا أعرف... 7-8 دقائق، أعتقد
Dialogue: 0,0:17:54.79,0:17:58.54,Default,,0,0,0,,.أنا أيضًا لا أتذكر كم استغرق مني، كان نفس الشيء تقريبًا
Dialogue: 0,0:17:59.17,0:18:01.00,Default,,0,0,0,,.كانت ثماني دقائق
Dialogue: 0,0:18:01.42,0:18:05.97,Default,,0,0,0,,.نظرت إلى ساعة الفرن بالصدفة عندما عاد السيد آرا
Dialogue: 0,0:18:06.80,0:18:10.30,Default,,0,0,0,,لكن كيف استغرقت 8 دقائق فقط لإحضار النبيذ؟
Dialogue: 0,0:18:11.01,0:18:16.77,Default,,0,0,0,,.نسيت أنني أحتاج إلى مفتاح جديد لقبو النبيذ، فاضطررت إلى العودة إلى غرفتي لأحضره
Dialogue: 0,0:18:16.77,0:18:18.85,Default,,0,0,0,,مفتاح جديد؟
Dialogue: 0,0:18:18.85,0:18:21.73,Default,,0,0,0,,هل تريدون التحقق منه؟
Dialogue: 0,0:18:25.49,0:18:28.74,Default,,0,0,0,,.انظروا، في الأعلى لدي قفلان جديدان
Dialogue: 0,0:18:29.11,0:18:31.74,Default,,0,0,0,,.هذا صحيح. لديك
Dialogue: 0,0:18:31.74,0:18:34.12,Default,,0,0,0,,لكن لماذا تريد الكثير من الأقفال؟
Dialogue: 0,0:18:34.12,0:18:39.08,Default,,0,0,0,,.لأن لصًا تسلل في ذلك اليوم، فقررت زيادة الأمان
Dialogue: 0,0:18:39.08,0:18:43.88,Default,,0,0,0,,.لدي أشياء ثمينة كثيرة في قبو النبيذ
Dialogue: 0,0:18:43.88,0:18:47.09,Default,,0,0,0,,مهلاً، هل هذا باب المطبخ؟
Dialogue: 0,0:18:47.09,0:18:48.51,Default,,0,0,0,,.نعم
Dialogue: 0,0:18:48.51,0:18:51.35,Default,,0,0,0,,هناك الكثير من آثار الأقدام هنا، ألا تظنوا ذلك؟
Dialogue: 0,0:18:51.35,0:18:56.35,Default,,0,0,0,,.عندما وصلنا لأول مرة، تجولنا جميعًا في المكان لمعرفة لكتشف المكان
Dialogue: 0,0:18:56.35,0:18:58.10,Default,,0,0,0,,أليس عندها تركنا هذه الآثار؟
Dialogue: 0,0:18:58.89,0:19:02.44,Default,,0,0,0,,.حسنًا أيها الصبي، أعتقد أن هذا يكفي. لنعد بسرعة إلى الداخل
Dialogue: 0,0:19:02.44,0:19:05.98,Default,,0,0,0,,.بما أننا هنا بالخارج، أود أن أرى مكان إشعال النار للحمام
Dialogue: 0,0:19:05.98,0:19:07.44,Default,,0,0,0,,...مهلاً، مهلاً
Dialogue: 0,0:19:09.49,0:19:11.87,Default,,0,0,0,,.هنا نُسخن الحمام
Dialogue: 0,0:19:11.87,0:19:15.58,Default,,0,0,0,,.يبدو أنه لا يوجد الكثير من الثلج بالقرب من السقف
Dialogue: 0,0:19:15.58,0:19:19.83,Default,,0,0,0,,.نعم، لأن الحمام أثناء تشغيله يذيب الثلج عن السقف
Dialogue: 0,0:19:22.38,0:19:24.67,Default,,0,0,0,,وهذه النافذة؟
Dialogue: 0,0:19:24.67,0:19:27.84,Default,,0,0,0,,.إنها في نهاية الممر بالطابق الثاني
Dialogue: 0,0:19:28.26,0:19:32.55,Default,,0,0,0,,إذن يمكنكِ الوصول إلى الطابق الأول إذا تسلقتِ إلى السقف، أليس كذلك انسة تاناكا؟
Dialogue: 0,0:19:32.55,0:19:34.86,Default,,0,0,0,,!كونان
Dialogue: 0,0:19:35.06,0:19:37.85,Default,,0,0,0,,.أعتقد ذلك. لكنني لستُ الوحيدة الذي يمكنها فعل ذلك
Dialogue: 0,0:19:38.98,0:19:44.27,Default,,0,0,0,,.في الواقع، ذهبت عدة مرات إلى الحمام لفحص درجة حرارة الماء
Dialogue: 0,0:19:44.69,0:19:47.15,Default,,0,0,0,,انتظري، ماذا تقصدين بذلك؟
Dialogue: 0,0:19:47.15,0:19:51.74,Default,,0,0,0,,.أنه إذا جاء أحد أثناء غيابي، يمكنه التسلق
Dialogue: 0,0:19:51.74,0:19:52.61,Default,,0,0,0,,.لم أفعل ذلك
Dialogue: 0,0:19:52.61,0:19:59.79,Default,,0,0,0,,...القوس أُطلق نحو نافذة الحمام، وتلك النافذة أسفل غرفة الانسة تاناكا مباشرة
Dialogue: 0,0:19:59.79,0:20:05.50,Default,,0,0,0,,...لو أن القاتل أطلقه، فلا بد أنه كان من الغابة التي زرناها للتو، لكن
Dialogue: 0,0:20:05.50,0:20:07.42,Default,,0,0,0,,.هناك شيء غير متطابق
Dialogue: 0,0:20:07.80,0:20:13.01,Default,,0,0,0,,،يمكنني فهم إطلاق السهم نحو غرفة الانسة تاناكا بعد رؤية ظل من النافذة
Dialogue: 0,0:20:13.01,0:20:16.39,Default,,0,0,0,,لكن لماذا يُطلق نحو حمام فارغ؟
Dialogue: 0,0:20:19.64,0:20:21.02,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:20:21.02,0:20:22.14,Default,,0,0,0,,أليست هذه دبوساً؟
Dialogue: 0,0:20:22.94,0:20:25.91,Default,,0,0,0,,ما الذي تفعله في مكان كهذا؟
Dialogue: 0,0:20:27.27,0:20:29.53,Default,,0,0,0,,!...ايعقل
Dialogue: 0,0:20:37.37,0:20:40.05,Default,,0,0,0,,...يمكن أن يكون
Dialogue: 0,0:20:42.00,0:20:45.13,Default,,0,0,0,,كيف تسير التحقيقات، أيها المحقق الصغير؟
Dialogue: 0,0:20:45.96,0:20:47.68,Default,,0,0,0,,.جيدا، نوعًا ما
Dialogue: 0,0:20:50.17,0:20:52.47,Default,,0,0,0,,.انظر، الجميع عادوا إلى الداخل بالفعل
Dialogue: 0,0:20:52.47,0:20:57.10,Default,,0,0,0,,.تبا. أنت دائمًا تتجول هنا وهناك، لذا لا يمكننا إبعاد أعيننا عنك
Dialogue: 0,0:20:57.10,0:20:58.98,Default,,0,0,0,,...أختي سونوكو
Dialogue: 0,0:20:59.81,0:21:04.14,Default,,0,0,0,,كيف قام السيد هامانو بخدعته لاختيار مهام الجميع؟
Dialogue: 0,0:21:09.23,0:21:11.15,Default,,0,0,0,,.فهمت
Dialogue: 0,0:21:11.15,0:21:14.57,Default,,0,0,0,,.الآن عرفت ما يحدث في هذه القضية
Dialogue: 0,0:21:14.57,0:21:17.70,Default,,0,0,0,,.رغم أن هناك لغزًا واحدًا باقيًا للحل
Dialogue: 0,0:21:17.70,0:21:19.87,Default,,0,0,0,,.الجريمة المستحيلة
Dialogue: 0,0:21:19.87,0:21:24.88,Default,,0,0,0,,.لن أتمكن من القبض على الجاني حتى أحل هذا اللغز
Dialogue: 0,0:21:25.12,0:21:27.54,Default,,0,0,0,,لكن كيف فعلها؟
Dialogue: 0,0:21:27.54,0:21:33.63,Default,,0,0,0,,.لم تكن هناك أي آثار أقدام في الثلج ضمن دائرة نصف قطرها 10 أمتار حول الجثة
Dialogue: 0,0:21:33.63,0:21:39.30,Default,,0,0,0,,.سيكون ذلك مستحيلاً دون رافعة أو شيء مماثل
Dialogue: 0,0:21:39.30,0:21:43.52,Default,,0,0,0,,...على الأقل يجب أن يكون هناك عمود قريب
Dialogue: 0,0:21:43.52,0:21:46.73,Default,,0,0,0,,...لا أستطيع التفكير في أي طريقة أخرى
Dialogue: 0,0:21:46.73,0:21:49.56,Default,,0,0,0,,هل يمكنني تقديم كأس نبيذ لكم؟
Dialogue: 0,0:21:49.56,0:21:51.73,Default,,0,0,0,,نبيذ في وقت كهذا؟
Dialogue: 0,0:21:51.73,0:21:53.61,Default,,0,0,0,,.لا أعتقد أن كأسًا سيؤذي
Dialogue: 0,0:21:53.61,0:21:56.71,Default,,0,0,0,,.قد يصفّي أذهاننا قليلاً
Dialogue: 0,0:22:07.37,0:22:10.59,Default,,0,0,0,,!فهمت. هكذا كان الأمر
Dialogue: 0,0:22:11.46,0:22:17.18,Default,,0,0,0,,!لهذا أحرق الجاني الجسر وعزلنا جميعًا هنا
Dialogue: 0,0:22:19.85,0:22:25.06,Default,,0,0,0,,.الآن فهمت كيف تم تنفيذ خدعة الجريمة المستحيلة
Dialogue: 0,0:22:25.06,0:22:30.98,Default,,0,0,0,,!بالإضافة إلى ذلك، اكتشفت هوية الجاني
Dialogue: 0,0:22:39.97,0:22:44.77,DCEnding,,0,0,0,,شيء ما سيحدث الليلة  
Dialogue: 0,0:22:44.77,0:22:51.02,DCEnding,,0,0,0,,.فادعُ، لكن لا تغمض عينيك
Dialogue: 0,0:22:51.02,0:22:55.45,DCEnding,,0,0,0,,قالت أمي إن في هذه الليالي  
Dialogue: 0,0:22:55.45,0:23:01.99,DCEnding,,0,0,0,,عندما يذوب القمر، يولد الحب  
Dialogue: 0,0:23:08.05,0:23:14.18,DCEnding,,0,0,0,,والآن كل شيء يدور في مكانه  
Dialogue: 0,0:23:14.18,0:23:21.02,DCEnding,,0,0,0,,لأني أرى مستقبلي يتمزق  
Dialogue: 0,0:23:21.02,0:23:27.57,DCEnding,,0,0,0,,فاقرع الأرض حافي القدمين  
Dialogue: 0,0:23:27.57,0:23:33.57,DCEnding,,0,0,0,,!اعبر القوس قزح، وأمسك السماء
Dialogue: 0,0:23:34.28,0:23:40.03,DCEnding,,0,0,0,,في الصباح، أتمنى على الصليب في صدري  
Dialogue: 0,0:23:40.03,0:23:46.41,DCEnding,,0,0,0,,في المساء، تمطر الأماني عليك  
Dialogue: 0,0:23:46.41,0:23:52.59,DCEnding,,0,0,0,,ضوء لطيف يلفك  
Dialogue: 0,0:23:52.59,0:24:02.30,DCEnding,,0,0,0,, للأبد ثابت من أجلك، من أجل حبك  
