Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS\NX : @Theconansign
Dialogue: 0,0:00:03.80,0:00:08.15,Default,,0,0,0,,هل كان هناك تقريبًا حيث ظهر الشبح؟
Dialogue: 0,0:00:09.54,0:00:13.06,Default,,0,0,0,,.لقد مرّ أسبوعان منذ أن بدأت المجيء إلى هذا المنزل للعمل
Dialogue: 0,0:00:13.06,0:00:15.43,Default,,0,0,0,,.أراه كل يوم خميس
Dialogue: 0,0:00:15.84,0:00:17.83,Default,,0,0,0,,.من المرجّح أن يظهر مجددًا اليوم
Dialogue: 0,0:00:23.13,0:00:25.55,Default,,0,0,0,,!لقد ظهر حقًا
Dialogue: 0,0:00:25.55,0:00:27.10,Default,,0,0,0,,!إ-إنه شبح
Dialogue: 0,0:00:27.10,0:00:28.63,Default,,0,0,0,,!ألم أقل لكم
Dialogue: 0,0:00:32.36,0:00:33.99,Default,,0,0,0,,!بل هناك حتى لهب أرواح
Dialogue: 0,0:00:33.99,0:00:37.52,Default,,0,0,0,,!آسفة! قد أكون نسيت أن أذكر ذلك
Dialogue: 0,0:00:40.57,0:00:42.39,Default,,0,0,0,,!لقد اختفى
Dialogue: 0,0:00:42.39,0:00:45.02,Default,,0,0,0,,!لا شك في ذلك!، لقد كان شبحًا
Dialogue: 0,0:00:46.56,0:00:49.43,Default,,0,0,0,,...شبح حقيقي
Dialogue: 0,0:00:52.00,0:00:54.30,Default,,0,0,0,,ماذا تخفي تحت ذلك الوجه البارد؟
Dialogue: 0,0:00:54.30,0:00:56.32,Default,,0,0,0,,!لغز لهب الأرواح الذي يظهر فوق الأسطح
Dialogue: 0,0:00:56.32,0:00:58.54,Default,,0,0,0,,!الحب ومهارة المحقق سيُنقذان العالم
Dialogue: 0,0:00:58.54,0:01:00.15,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:01:00.15,0:01:01.96,Default,,0,0,0,,،بجسد طفل وعقل بالغ
Dialogue: 0,0:01:01.96,0:01:04.67,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:01:03.85,0:01:06.94,DCOpening,,0,0,0,,!جدي، فضولي، غامض، يقودنا نحو المستقبل
Dialogue: 0,0:01:06.94,0:01:10.26,DCOpening,,0,0,0,,بالتأكيد يمكنك كشف هذه الأجزاء الملونة التي تحوم حول قلبي ، أليس كذلك؟
Dialogue: 0,0:01:10.26,0:01:11.93,DCOpening,,0,0,0,,هذا الوجه البارد
Dialogue: 0,0:01:11.93,0:01:13.47,DCOpening,,0,0,0,,لا يمكنك خداع عيناي
Dialogue: 0,0:01:13.47,0:01:14.74,DCOpening,,0,0,0,,لا يمكنك الهروب من قدرك
Dialogue: 0,0:01:14.74,0:01:16.74,DCOpening,,0,0,0,,...لذا اتبعني اتبعني اتبعني
Dialogue: 0,0:01:16.74,0:01:17.60,DCOpening,,0,0,0,,لكنك بطريق الخطأ وبخبث
Dialogue: 0,0:01:17.60,0:01:19.94,DCOpening,,0,0,0,,,أمسكت بالدليل، انظر
Dialogue: 0,0:01:19.94,0:01:23.36,DCOpening,,0,0,0,,لا أستطيع التوقف الآن، أريد أن أتعقبه حتى النهاية
Dialogue: 0,0:01:23.36,0:01:26.45,DCOpening,,0,0,0,,لن أخيب ظن أحد لا تستخف بي كمجرد صبي
Dialogue: 0,0:01:26.44,0:01:29.61,DCOpening,,0,0,0,,هذه المفاهيم المسبقة ليست سوى خدع طفولية
Dialogue: 0,0:01:29.82,0:01:32.67,DCOpening,,0,0,0,,أعلم أنك تريدني، ولن أخذلك أبدًا
Dialogue: 0,0:01:32.68,0:01:35.66,DCOpening,,0,0,0,,في الحقيقة...
Dialogue: 0,0:01:36.16,0:01:39.40,DCOpening,,0,0,0,,أعلم أنك تكرهني ومع ذلك، لم أستطع لن أتركك أبدًا
Dialogue: 0,0:01:39.40,0:01:43.04,DCOpening,,0,0,0,,أرني مشاعرك الحقيقية؟
Dialogue: 0,0:01:43.87,0:01:44.75,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:01:50.40,0:01:51.89,DCOpening,,0,0,0,,!انطلق
Dialogue: 0,0:01:57.01,0:02:00.56,DCOpening,,0,0,0,,النهاية السعيدة المثالية
Dialogue: 0,0:02:00.56,0:02:03.65,DCOpening,,0,0,0,,ابتسامة لتجنب الألم، قلبي ينفتح عند 4869
Dialogue: 0,0:02:03.64,0:02:07.19,DCOpening,,0,0,0,,قبلة سرية أطلقت في البحر مشاعر ما زالت تحتل قلبي
Dialogue: 0,0:02:07.19,0:02:10.48,DCOpening,,0,0,0,,افتح قلبي أيضًا أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:15.30,0:02:17.62,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:21.77,0:02:23.77,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:27.99,0:02:28.66,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:02:46.02,0:02:52.03,sign_episode_title,SIGN,0,0,0,,{\fad(400,1)} ظهر الشبح 
Dialogue: 0,0:02:46.73,0:02:48.67,Default,,0,0,0,,"!ظهر شبح"
Dialogue: 0,0:02:56.58,0:02:58.28,Default,,0,0,0,,.لقد ظهر مجددًا
Dialogue: 0,0:02:58.72,0:03:03.16,Default,,0,0,0,,تبا ، الآن تجعلين الأطفال يدخلون في ذعر الأشباح؟
Dialogue: 0,0:03:03.48,0:03:05.63,Default,,0,0,0,,.الشبح كان حقيقيًا
Dialogue: 0,0:03:05.63,0:03:07.54,Default,,0,0,0,,.نحن رأيناه أيضًا
Dialogue: 0,0:03:07.93,0:03:09.29,Default,,0,0,0,,أهذا صحيح؟
Dialogue: 0,0:03:09.74,0:03:11.74,Default,,0,0,0,,.اليوم كان الثالث
Dialogue: 0,0:03:09.42,0:03:13.42,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(285,256)}(19) مامية ماميا 
Dialogue: 0,0:03:09.42,0:03:13.42,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(285,273)}طالبة
Dialogue: 0,0:03:11.74,0:03:13.67,Default,,0,0,0,,!أنا أعلم ما رأيت
Dialogue: 0,0:03:13.67,0:03:16.68,sign_suspect,SIGN,0,0,0,,{\pos(354,255)}(75) كانازاوا موتوكو 
Dialogue: 0,0:03:13.67,0:03:16.68,sign_suspect,SIGN,0,0,0,,{\fs14\pos(354,272)}امرأة تعيش وحدها
Dialogue: 0,0:03:13.96,0:03:16.68,Default,,0,0,0,,.حسنًا، حسنًا. أصدقكِ
Dialogue: 0,0:03:17.16,0:03:20.55,Default,,0,0,0,,.لابد أن هناك سببًا لالتقائنا بالأتسة مامي
Dialogue: 0,0:03:20.55,0:03:22.81,Default,,0,0,0,,شبح
Dialogue: 0,0:03:20.55,0:03:22.81,sign_1173_phone_search,SIGN,0,0,0,,{\c&H96726C&\pos(235,98)\an2\frz10\fs9\fscy85\shadx0\fad(1,700)}شبح
Dialogue: 0,0:03:20.55,0:03:24.00,Default,,0,0,0,,.سنساعدكِ في حل مشكلة الشبح
Dialogue: 0,0:03:24.56,0:03:27.25,Default,,0,0,0,,.فعلًا، فنحن فريق المحققين الصغار
Dialogue: 0,0:03:28.38,0:03:31.19,Default,,0,0,0,,.ارجو إلا تفعلوا شيئًا متهورًا
Dialogue: 0,0:03:31.61,0:03:33.94,Default,,0,0,0,,هل كنتِ على الهاتف؟
Dialogue: 0,0:03:33.94,0:03:35.46,Default,,0,0,0,,...حسنًا
Dialogue: 0,0:03:35.46,0:03:37.67,Default,,0,0,0,,هل حدث ذلك مجددًا؟
Dialogue: 0,0:03:37.67,0:03:39.67,Default,,0,0,0,,.نعم، في الواقع
Dialogue: 0,0:03:39.67,0:03:40.95,Default,,0,0,0,,ما الذي حدث مجددًا؟
Dialogue: 0,0:03:41.47,0:03:44.91,Default,,0,0,0,,.أظن أنه كان منذ حوالي أسبوعين
Dialogue: 0,0:03:44.91,0:03:47.33,Default,,0,0,0,,.لقد تلقيتُ مكالمات مقالب
Dialogue: 0,0:03:47.33,0:03:51.47,Default,,0,0,0,,.هذا نفس الوقت الذي بدأ فيه ظهور الشبح
Dialogue: 0,0:03:51.78,0:03:54.96,Default,,0,0,0,,هل يمكن أن الشبح هو الذي يتصل بكِ؟
Dialogue: 0,0:03:54.96,0:03:58.09,Default,,0,0,0,,هناك أشباحٌ تدريجيًا\N.تقترب منا
Dialogue: 0,0:03:58.56,0:04:01.97,Default,,0,0,0,,.صحيح. المكالمات صامتة
Dialogue: 0,0:04:03.76,0:04:05.60,Default,,0,0,0,,!شكرًا لاستضافتنا
Dialogue: 0,0:04:05.94,0:04:07.60,Default,,0,0,0,,.سأوصلهم إلى المحطة
Dialogue: 0,0:04:07.87,0:04:09.21,Default,,0,0,0,,.كوني حذرة
Dialogue: 0,0:04:09.21,0:04:10.21,Default,,0,0,0,,.نعم
Dialogue: 0,0:04:15.61,0:04:17.49,Default,,0,0,0,,ما هذه اثار الأقدام؟
Dialogue: 0,0:04:17.82,0:04:21.27,Default,,0,0,0,,أنسة موتوكو، هل جاء أحد بينما كنا في الطابق العلوي؟
Dialogue: 0,0:04:21.27,0:04:22.37,Default,,0,0,0,,.لا
Dialogue: 0,0:04:30.34,0:04:33.00,Default,,0,0,0,,هل يمكن أن تكون\Nآثار أقدام الشبح؟
Dialogue: 0,0:04:34.95,0:04:37.51,Default,,0,0,0,,.الأصابع دائرية أكثر من حذائي
Dialogue: 0,0:04:38.86,0:04:41.88,Default,,0,0,0,,.لا أرى أن للأشباح أقدامًا حقًا
Dialogue: 0,0:04:41.88,0:04:44.11,Default,,0,0,0,,.قد يكون لديه
Dialogue: 0,0:04:44.11,0:04:46.43,Default,,0,0,0,,!أنت محق. لابد وأنه الشبح
Dialogue: 0,0:04:46.43,0:04:47.71,Default,,0,0,0,,ماذا سأفعل؟
Dialogue: 0,0:04:47.71,0:04:50.39,Default,,0,0,0,,ماذا لو جاء الشبح إلى هذا المنزل؟
Dialogue: 1,0:04:50.39,0:04:53.39,sign_note,,0,0,0,,{\an7\pos(0,0)\fad(700,1)\fscx100\fscy100\p1\shad2\bord0\c&HEFECE6&\3c&HEFECE6&\4c&H6199D8&}m 335 165 l 235 165 235 350 335 350
Dialogue: 1,0:04:50.39,0:04:53.40,sign_1173_restaurant_notice,SIGN,0,0,0,,{\bord0\shad0\c&H808080&\frz270\an7\fad(700,1)\fs11\pos(321,173)}إشعار بخصوص ساعات العمل
Dialogue: 1,0:04:50.39,0:04:53.40,sign_1173_restaurant_notice,SIGN,0,0,0,,{\bord0\shad0\c&H6C4CC7&\frz270\an7\fad(700,1)\fs14\pos(294,173)}أيام الخميس\N\N\Nمفتوح للغداء فقط
Dialogue: 0,0:04:59.18,0:05:00.81,Default,,0,0,0,,.شكرًا على انتظاركم
Dialogue: 0,0:05:02.03,0:05:04.16,sign_suspect,SIGN,0,0,0,,{\pos(325,256)}(28)ميساكي هارو 
Dialogue: 0,0:05:02.03,0:05:04.16,sign_suspect,SIGN,0,0,0,,{\fs14\pos(325,273)}احد أعضاء طاقم مطعم تومو
Dialogue: 0,0:05:05.75,0:05:07.91,Default,,0,0,0,,!يبدو هذا شهيًا جدًا
Dialogue: 0,0:05:07.24,0:05:07.91,sign_1173_menu,SIGN,0,0,0,,{\pos(255,10)\an9\fad(200,1)\fs11\c&HB5C9D9&\3c&H617FA2&}قائمة جديدة\N\N{\fs14\c&H3F5575&\3c&HB5C9D9&}حساء لحم البقر
Dialogue: 0,0:05:07.24,0:05:07.91,Default,,0,0,0,,قائمة جديدة\Nحساء لحم البقر
Dialogue: 0,0:05:08.32,0:05:11.17,Default,,0,0,0,,أنتِ متأكدة أنكِ لا تمانعين في الدفع؟
Dialogue: 0,0:05:11.17,0:05:12.58,Default,,0,0,0,,.بالطبع
Dialogue: 0,0:05:12.58,0:05:14.96,Default,,0,0,0,,.إنها نفقة ضرورية لفريق المحققين الصغار
Dialogue: 0,0:05:14.96,0:05:16.11,Default,,0,0,0,,.شكرًا لكِ
Dialogue: 0,0:05:16.11,0:05:18.59,Default,,0,0,0,,.أعدكِ أننا سنحل القضية قريبًا
Dialogue: 0,0:05:18.59,0:05:20.47,Default,,0,0,0,,أليس كذلك يا كونان؟
Dialogue: 0,0:05:22.73,0:05:25.66,Default,,0,0,0,,.كنت أعلم أنهم كانوا يتسلّلون مؤخرًا
Dialogue: 0,0:05:25.66,0:05:27.63,Default,,0,0,0,,.إذن هذا ما كانوا يفعلونه
Dialogue: 0,0:05:27.63,0:05:30.56,Default,,0,0,0,,الشبح يظهر من هذا المبنى، أليس كذلك؟
Dialogue: 0,0:05:31.78,0:05:35.02,Default,,0,0,0,,ربما هناك شيء\N.يتعلق بالمبنى نفسه
Dialogue: 0,0:05:35.02,0:05:36.82,Default,,0,0,0,,.قد يكون مربوطًا بهذا المكان
Dialogue: 0,0:05:36.82,0:05:40.46,Default,,0,0,0,,...هذا بالتأكيد هو السبب، لكن الآن
Dialogue: 0,0:05:40.46,0:05:43.06,Default,,0,0,0,,!دعونا نأكل طعامنا وهو ساخن
Dialogue: 0,0:05:43.06,0:05:44.72,Default,,0,0,0,,!لذيذ جدًا
Dialogue: 0,0:05:44.72,0:05:47.08,Default,,0,0,0,,!هذا حساء لحم البقر رائع
Dialogue: 0,0:05:52.92,0:05:54.03,Default,,0,0,0,,.عذرًا
Dialogue: 0,0:05:54.47,0:05:56.43,Default,,0,0,0,,،آسف على السؤال الغريب
Dialogue: 0,0:05:56.43,0:06:00.41,Default,,0,0,0,,لكن هل رأيتَ شخصًا\Nعلى سطح هذا المبنى؟
Dialogue: 0,0:06:01.15,0:06:03.41,Default,,0,0,0,,ماذا؟ على السطح؟
Dialogue: 0,0:06:03.82,0:06:07.14,Default,,0,0,0,,أيها الشيف، السطح غير قابل للوصول، أليس كذلك؟
Dialogue: 0,0:06:07.14,0:06:09.96,Default,,0,0,0,,.ماذا؟ نعم، هذا صحيح
Dialogue: 0,0:06:10.36,0:06:12.98,Default,,0,0,0,,.باب الوصول إلى السطح لا يُفتح
Dialogue: 0,0:06:12.98,0:06:15.48,Default,,0,0,0,,.إنه مكسور منذ فترة
Dialogue: 0,0:06:15.47,0:06:17.85,sign_1173_spray,SIGN,0,0,0,,{\an2\pos(50,140)\shad2}بخاخ مقاوم للماء
Dialogue: 0,0:06:15.47,0:06:17.85,Default,,0,0,0,,بخاخ مقاوم للماء
Dialogue: 0,0:06:15.48,0:06:17.86,Default,,0,0,0,,هل هناك مشكلة في السطح؟
Dialogue: 0,0:06:19.29,0:06:23.86,Default,,0,0,0,,الحقيقة هي... يظهر شبح\N.على سطح هذا المبنى
Dialogue: 0,0:06:26.18,0:06:27.73,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:06:27.73,0:06:29.87,Default,,0,0,0,,.ويصاحبه لهب أرواح
Dialogue: 0,0:06:29.87,0:06:32.12,Default,,0,0,0,,.رأيته ثلاث مرات
Dialogue: 0,0:06:32.12,0:06:40.37,sign_1173_spray,SIGN,0,0,0,,{\an2\shad2\fs12\pos(53,246)}بخاخ مقاوم للماء
Dialogue: 0,0:06:32.12,0:06:40.37,Default,,0,0,0,,بخاخ مقاوم للماء
Dialogue: 0,0:06:33.72,0:06:38.62,Default,,0,0,0,,.حسنًا، لم نره، ولم أسمع عن حصول ذلك من قبل
Dialogue: 0,0:06:38.62,0:06:40.38,Default,,0,0,0,,.ربما تخيّلتكم
Dialogue: 0,0:06:42.40,0:06:44.62,Default,,0,0,0,,.ليست أوهامنا
Dialogue: 0,0:06:44.62,0:06:46.39,Default,,0,0,0,,.كلنا رأيناه
Dialogue: 0,0:06:46.39,0:06:48.14,Default,,0,0,0,,.صحيح
Dialogue: 0,0:06:48.45,0:06:50.76,Default,,0,0,0,,.لا يمكن الوصول إليه من الخارج
Dialogue: 0,0:06:50.76,0:06:53.27,Default,,0,0,0,,.أقول لكم، إنه شبح
Dialogue: 0,0:06:53.27,0:06:56.22,Default,,0,0,0,,.قادر على الظهور والاختفاء فجأة
Dialogue: 0,0:06:56.22,0:06:58.49,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:07:05.15,0:07:07.85,Default,,0,0,0,,.هذه المركبة تتحرّك للخلف، هذه المركبة تتحرّك للخلف
Dialogue: 0,0:07:07.85,0:07:10.66,Default,,0,0,0,,ماذا تفعلون أيها الأطفال؟
Dialogue: 0,0:07:10.94,0:07:12.63,Default,,0,0,0,,...في الحقيقة
Dialogue: 0,0:07:13.66,0:07:16.17,Default,,0,0,0,,.هذا ليس مكانًا آمنًا للبقاء
Dialogue: 0,0:07:16.17,0:07:18.17,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:07:20.84,0:07:23.67,Default,,0,0,0,,هل أضفتم أعضاء جددًا؟
Dialogue: 0,0:07:23.67,0:07:25.42,Default,,0,0,0,,.مرحبًا
Dialogue: 0,0:07:25.42,0:07:28.80,Default,,0,0,0,,.كونان وآي أيضًا جزء من فريق المحققين الصغار
Dialogue: 0,0:07:28.80,0:07:30.65,Default,,0,0,0,,أحقًا؟
Dialogue: 0,0:07:30.65,0:07:33.56,Default,,0,0,0,,هل يمكننا أن نتفقد المنزل؟
Dialogue: 0,0:07:33.56,0:07:35.52,Default,,0,0,0,,.تفضّلوا وافعلوا ما تشاؤون
Dialogue: 0,0:07:36.81,0:07:39.86,Default,,0,0,0,,هل يمكنك وصف ترتيب الآثار؟
Dialogue: 0,0:07:39.86,0:07:44.32,Default,,0,0,0,,.كانت في كل مكان. كان عددها مخيفًا
Dialogue: 0,0:07:45.59,0:07:47.95,Default,,0,0,0,,.في الواقع التقطت صورة
Dialogue: 0,0:07:47.95,0:07:50.10,Default,,0,0,0,,!عمل رائع، ميتسوهِيكو
Dialogue: 0,0:07:50.10,0:07:52.63,Default,,0,0,0,,.إنها كبيرة فعلاً
Dialogue: 0,0:07:52.63,0:07:54.45,Default,,0,0,0,,.آثار دائرية
Dialogue: 0,0:07:54.45,0:07:57.01,Default,,0,0,0,,.إذن الشبح رجل
Dialogue: 0,0:07:57.01,0:08:02.96,Default,,0,0,0,,.ماذا؟ لكن ظننت أن الأشباح النسائية هي من تجري المكالمات
Dialogue: 0,0:08:03.47,0:08:06.99,Default,,0,0,0,,آثار الأقدام انتهت تقريبًا هنا، أليس كذلك؟
Dialogue: 0,0:08:06.99,0:08:08.66,Default,,0,0,0,,.نعم
Dialogue: 0,0:08:10.84,0:08:12.67,Default,,0,0,0,,.شكرًا
Dialogue: 0,0:08:19.60,0:08:21.06,Default,,0,0,0,,مطعم فندق هايدو ريتش
Dialogue: 0,0:08:19.60,0:08:21.06,Default,,0,0,0,,أطباق لحم وأسماك
Dialogue: 0,0:08:19.60,0:08:21.06,sign_1173_recipes,SIGN,0,0,0,,{\c&H372E2C&\pos(385,97)\frz-16\fax-0.1\an2\fs16\fad(1,500)}مطعم فندق هايدو ريتش
Dialogue: 0,0:08:19.60,0:08:21.06,sign_1173_recipes,SIGN,0,0,0,,{\c&H372E2C&\an8\frz-15\pos(351,173)\fad(1,500)}أطباق لحم وأسماك
Dialogue: 0,0:08:19.60,0:08:22.11,Default,,0,0,0,,!رائع
Dialogue: 0,0:08:22.56,0:08:25.93,Default,,0,0,0,,هل صنعتِ هذه الكعكة أيضًا؟
Dialogue: 0,0:08:25.93,0:08:27.86,Default,,0,0,0,,.تبدو كأنها من المتجر تمامًا
Dialogue: 0,0:08:31.24,0:08:33.83,Default,,0,0,0,,.تبدو شهية جدًا
Dialogue: 0,0:08:33.83,0:08:35.99,Default,,0,0,0,,.أحتاج شوكة الآن
Dialogue: 0,0:08:37.18,0:08:38.50,Default,,0,0,0,,.نحتاج واحدة أخرى
Dialogue: 0,0:08:41.25,0:08:43.29,Default,SIGN,0,0,0,,{\an2\frz55\fax0.1\fad(500,300)\pos(270,138)}تومو
Dialogue: 0,0:08:41.25,0:08:43.29,Default,,0,0,0,,تومو
Dialogue: 0,0:08:44.02,0:08:45.00,Default,,0,0,0,,.وجدتها
Dialogue: 0,0:08:46.38,0:08:48.20,Default,,0,0,0,,!لذيذ
Dialogue: 0,0:08:48.20,0:08:49.93,Default,,0,0,0,,!لذيذ جدًا
Dialogue: 0,0:08:50.99,0:08:52.76,Default,,0,0,0,,أنتِ شيف، أليس كذلك؟
Dialogue: 0,0:08:52.76,0:08:56.39,sign_1173_restaurant,SIGN,0,0,0,,{\pos(340,96)\an2\frz2}مطبخ موتوكو
Dialogue: 0,0:08:52.76,0:08:56.39,Default,,0,0,0,,مطبخ موتوكو
Dialogue: 0,0:08:53.70,0:08:56.39,Default,,0,0,0,,.يقال إن مطعمك مشهور جدًا
Dialogue: 0,0:08:56.95,0:08:58.77,Default,,0,0,0,,.ذلك كان منذ زمن بعيد
Dialogue: 0,0:08:58.77,0:09:00.50,Default,,0,0,0,,!رائع
Dialogue: 0,0:09:00.50,0:09:04.06,Default,,0,0,0,,.كنتِ تنظرين إلى شيء أثناء الطهي سابقًا
Dialogue: 0,0:09:04.06,0:09:05.52,Default,,0,0,0,,...هل كان
Dialogue: 0,0:09:05.52,0:09:09.65,Default,,0,0,0,,.كان كتاب وصفات كتبتُها أنا
Dialogue: 0,0:09:09.95,0:09:14.86,Default,,0,0,0,,.كثيرون طلبوا منّي رؤيته في الماضي، لكنّي كنتُ أرفض دومًا
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&H5BA1B4&\4c&H88B46A&\xshad-2\yshad1\bord3\fs14\pos(465,79)}شوربات ~مكونات الربيع~
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HCFE5DF&\4c&H6865AB&\xshad-2\yshad1\bord3\fs14\pos(430,79)}شوربات ~مكونات الخريف~
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HF6F7F0&\4c&H9B947A&\xshad-2\yshad1\bord3\fs14\pos(395,79)}شوربات ~مكونات الشتاء~
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HD0BCD6&\4c&HA37CB6&\xshad-2\yshad1\bord3\fs14\pos(360,79)}أطباق لحم وأسماك 2
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HADC18B&\4c&H938FBD&\xshad-2\yshad1\bord3\fs14\pos(325,79)}أطباق يابانية ~مكونات الربيع~
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HEDDFCD&\4c&H87C3D9&\xshad-2\yshad1\bord3\fs14\pos(295,79)}أطباق يابانية ~مكونات الصيف~
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&H80CFB0&\4c&H96D191&\xshad-2\yshad1\bord3\fs14\pos(260,79)}أطباق يابانية ~مكونات الخريف~
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HF6F5F0&\4c&H8CC3D5&\xshad-2\yshad1\bord3\fs14\pos(225,79)}أطباق يابانية ~مكونات الشتاء~
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HF7F9F6&\4c&H518E60&\xshad-2\yshad1\bord3\fs14\pos(190,79)}أطباق فرنسية 1
Dialogue: 0,0:09:13.28,0:09:17.04,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HF7F9F6&\4c&H518E60&\xshad-2\yshad1\bord3\fs14\pos(155,79)}أطباق فرنسية 3
Dialogue: 0,0:09:14.86,0:09:17.04,Default,,0,0,0,,.إنها كنزي
Dialogue: 0,0:09:17.04,0:09:19.18,Default,,0,0,0,,.لا عجب أن طعم هذا لذيذ جدًا
Dialogue: 0,0:09:22.04,0:09:25.32,Default,,0,0,0,,.سأواجههم بكلامًا قاسيًا اليوم
Dialogue: 0,0:09:27.19,0:09:28.56,Default,,0,0,0,,مرحبا؟
Dialogue: 0,0:09:29.29,0:09:30.84,Default,,0,0,0,,مرحبا؟
Dialogue: 0,0:09:31.74,0:09:32.93,Default,,0,0,0,,.إنهم لا يتكلمون
Dialogue: 0,0:09:33.39,0:09:35.05,Default,,0,0,0,,!توقفوا عن الاتصال بي
Dialogue: 0,0:09:36.34,0:09:39.37,Default,,0,0,0,,.لكن لماذا؟ لا يزال المساء مبكرًا
Dialogue: 0,0:09:39.37,0:09:42.78,Default,,0,0,0,,.كنت أظن أن الأشباح تنشط ليلًا فقط
Dialogue: 0,0:09:42.78,0:09:45.38,Default,,0,0,0,,.المكالمات لا علاقة لها بالشبح
Dialogue: 0,0:09:45.38,0:09:47.57,Default,,0,0,0,,.لابد أنهم يحاولون إزعاجي فقط
Dialogue: 0,0:09:47.97,0:09:50.45,Default,,0,0,0,,عندكِ فكرة عمّن قد يكون، أليس كذلك؟
Dialogue: 0,0:09:51.57,0:09:53.02,Default,,0,0,0,,.حسنًا، نعم
Dialogue: 0,0:10:00.01,0:10:01.20,Default,,0,0,0,,مرحبا؟
Dialogue: 0,0:10:01.20,0:10:03.43,Default,,0,0,0,,.مرحبا، هذا أنا
Dialogue: 0,0:10:03.43,0:10:05.43,Default,,0,0,0,,مرحبا، هل أنتَ؟
Dialogue: 0,0:10:05.43,0:10:09.01,Default,,0,0,0,,.تعرضت لحادثٍ صغير وأحتاج مالًا
Dialogue: 0,0:10:09.01,0:10:11.04,Default,,0,0,0,,.حسنًا، هذا ليس جيدًا
Dialogue: 0,0:10:11.04,0:10:12.38,Default,,0,0,0,,كم تحتاج؟
Dialogue: 0,0:10:12.74,0:10:14.72,Default,,0,0,0,,ما الذي عليّ أن أفعل بالمال؟
Dialogue: 0,0:10:15.61,0:10:19.31,Default,,0,0,0,,.تظاهرت أني صدقتُه وحددت موقع اللقاء
Dialogue: 0,0:10:27.39,0:10:31.23,Default,,0,0,0,,.آسفة، لكنني لا أملك اولاد
Dialogue: 0,0:10:31.75,0:10:35.24,Default,,0,0,0,,.رئيسه، الذي اتصل لاحقًا، تم القبض عليه أيضًا
Dialogue: 0,0:10:35.24,0:10:37.08,sign_1173_award,SIGN,0,0,0,,{\fnGeorgia\pos(390,55)\an2\fad(1,400)}البر والإحسان\Nالعدالة\Nاللباقة
Dialogue: 0,0:10:35.24,0:10:37.08,sign_1173_award,SIGN,0,0,0,,{\fnGeorgia\pos(228,55)\an2\fad(1,400)}الحكمة\Nالإخلاص
Dialogue: 0,0:10:37.73,0:10:41.61,Default,,0,0,0,,.حصلت على جائزة لتوقيفي محتالّي الهاتف
Dialogue: 0,0:10:37.19,0:10:42.50,Default,SIGN,0,0,0,,{\fnGeorgia\an2\fad(200,500)\fs10\b1\bord0\shad0\pos(216,249)\c&H686768&\frz280}"!لا أملك اولاد"
Dialogue: 0,0:10:37.19,0:10:42.50,sign_1173_award,SIGN,0,0,0,,{\fnGeorgia\an8\fad(200,500)\fs10\b1\bord0\shad0\c&H686768&\frz280\pos(495,202)}امرأة تفشل محتالّي الهاتف
Dialogue: 0,0:10:42.72,0:10:45.87,Default,,0,0,0,,...حتى أني ظهرت في الصحف، لذا
Dialogue: 0,0:10:46.38,0:10:49.39,Default,,0,0,0,,.من الممكن أن يشعروا بالضغينة تجاهكِ بسبب ذلك
Dialogue: 0,0:10:49.39,0:10:52.76,Default,,0,0,0,,إذن، هل الاتصالات من النصابين؟
Dialogue: 0,0:10:52.76,0:10:56.28,Default,,0,0,0,,...قد تكون الآثار تركت ليس بسبب شبح، بل
Dialogue: 0,0:11:01.11,0:11:04.49,Default,,0,0,0,,.ليست عمل شبح. إنه إنسان
Dialogue: 0,0:11:04.49,0:11:06.81,Default,,0,0,0,,.المكالمات تأتي من نفس الشخص
Dialogue: 0,0:11:06.81,0:11:08.40,Default,,0,0,0,,كيف عرفت ذلك؟
Dialogue: 0,0:11:08.40,0:11:13.87,Default,,0,0,0,,إذا رتبت هذه الصناديق لتصبح درجات,\N.تستطيع الوصول إلى السلم
Dialogue: 0,0:11:13.87,0:11:16.37,Default,,0,0,0,,.السطح يمكن الوصول إليه من الخارج
Dialogue: 0,0:11:17.91,0:11:19.52,Default,,0,0,0,,.فهمت
Dialogue: 0,0:11:19.52,0:11:22.90,Default,,0,0,0,,.لهذا السبب الشبح يظهر دائمًا في نفس اليوم
Dialogue: 0,0:11:22.90,0:11:24.54,Default,,0,0,0,,ماذا تعني؟
Dialogue: 0,0:11:24.87,0:11:27.87,Default,,0,0,0,,.لأن الشحنات تأتي في يوم محدد
Dialogue: 0,0:11:27.87,0:11:30.92,Default,,0,0,0,,المطعم يفتح للغداء فقط يوم الخميس، أليس كذلك؟
Dialogue: 0,0:11:30.92,0:11:34.63,Default,,0,0,0,,.لابد أنهم يستبدلون المكونات ويجهزون في ذلك اليوم
Dialogue: 0,0:11:34.63,0:11:38.82,Default,,0,0,0,,هذا النوع من القضايا يُجمع غالبًا\N.في اليوم التالي
Dialogue: 0,0:11:38.82,0:11:42.56,Default,,0,0,0,,إذن الجاني كان يتظاهر بأنه شبح؟
Dialogue: 0,0:11:42.56,0:11:46.69,Default,,0,0,0,,.ليس عمدًا، هو فقط بدا وكأنه شبح
Dialogue: 0,0:11:47.07,0:11:52.43,Default,,0,0,0,,كان يرتدي قميصًا أسود وسروالًا أبيض
Dialogue: 0,0:11:52.43,0:11:55.49,Default,,0,0,0,,.وكان يتصل من هاتفه على السطح
Dialogue: 0,0:11:55.91,0:12:00.32,Default,,0,0,0,,لهذا بدا وكأن فوقه\N.لهيب روح
Dialogue: 0,0:12:00.32,0:12:03.12,Default,,0,0,0,,.إذن هذا ما كان عليه
Dialogue: 0,0:12:03.12,0:12:05.48,Default,,0,0,0,,لكن لماذا يتصل من السطح؟
Dialogue: 0,0:12:05.48,0:12:09.57,Default,,0,0,0,,.ربما كان يراقب منزل الأنسة موتوكو
Dialogue: 0,0:12:10.59,0:12:14.95,Default,,0,0,0,,لكن كيف كان يختفي\Nويظهر فجأة هكذا؟
Dialogue: 0,0:12:14.95,0:12:17.09,Default,,0,0,0,,.لا أعلم ذلك بعد
Dialogue: 0,0:12:17.09,0:12:24.10,Default,,0,0,0,,إذا كان الجاني اتصل من هنا سابقًا,\Nهل يمكن أن يكون ما يزال قريبًا؟
Dialogue: 0,0:12:25.24,0:12:28.04,Default,,0,0,0,,.دعونا نتفرق ونبحث عنه
Dialogue: 0,0:12:28.04,0:12:32.07,Default,,0,0,0,,.نعم، لكن لا تطاردوه بعيدًا إذا وجدتموه
Dialogue: 0,0:12:32.07,0:12:34.32,Default,,0,0,0,,.تواصلوا معي عبر شارات التحقيق
Dialogue: 0,0:12:34.32,0:12:35.86,Default,,0,0,0,,شارات التحقيق؟
Dialogue: 0,0:12:35.86,0:12:37.20,Default,,0,0,0,,!هذه هي
Dialogue: 0,0:12:37.20,0:12:39.36,Default,,0,0,0,,.يمكننا التواصل باستخدامها
Dialogue: 0,0:12:39.36,0:12:42.41,Default,,0,0,0,,!أنتم رائعون حقاً يا فريق المحققين الصغار
Dialogue: 0,0:12:45.51,0:12:46.51,Default,,0,0,0,,!أمسكيني
Dialogue: 0,0:12:50.14,0:12:52.38,Default,,0,0,0,,.لا أثر للجاني
Dialogue: 0,0:12:52.38,0:12:57.05,Default,,0,0,0,,لماذا اضطر الجاني\Nلاستخدام هذا المبنى؟
Dialogue: 0,0:12:57.49,0:13:00.63,Default,,0,0,0,,البنايات على الجانبين\N.تقريبًا بنفس الارتفاع
Dialogue: 0,0:13:00.63,0:13:02.69,Default,,0,0,0,,.إنه ليس هنا
Dialogue: 0,0:13:02.69,0:13:06.06,Default,,0,0,0,,.انتهى بنا المطاف أمام منزل الأنسة موتوكو
Dialogue: 0,0:13:16.06,0:13:17.85,Default,,0,0,0,,!هذا سيء
Dialogue: 0,0:13:17.85,0:13:19.79,Default,,0,0,0,,!الأنسة موتوكو في خطر
Dialogue: 0,0:13:28.64,0:13:30.29,Default,,0,0,0,,!قـ-قف مكانك
Dialogue: 0,0:13:34.74,0:13:36.55,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:36.55,0:13:39.08,Default,,0,0,0,,!انا لانني أزعجتكم
Dialogue: 0,0:13:40.29,0:13:44.45,Default,,0,0,0,,!انه ليس هو
Dialogue: 0,0:13:48.16,0:13:50.43,Default,,0,0,0,,...ما هذه الرائحة
Dialogue: 0,0:13:51.50,0:13:53.67,Default,,0,0,0,,.يبدو أنهم استغرقوا وقتًا طويلاً للعودة
Dialogue: 0,0:13:55.90,0:13:56.86,Default,,0,0,0,,!خلف المبنى
Dialogue: 0,0:14:02.41,0:14:03.67,Default,,0,0,0,,!عفوًا
Dialogue: 0,0:14:04.16,0:14:05.57,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:14:06.00,0:14:08.85,Default,,0,0,0,,.اتصل بالإسعاف، هايبارا
Dialogue: 0,0:14:08.85,0:14:09.90,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:14:09.90,0:14:14.78,Default,,0,0,0,,هل هذا يعني أن هذا الرجل كان المحتال؟
Dialogue: 0,0:14:14.78,0:14:20.30,Default,,0,0,0,,إذن هو استخدم سطح هذا المبنى لأنه يعمل هنا؟
Dialogue: 0,0:14:20.30,0:14:21.34,Default,,0,0,0,,مرحبا؟
Dialogue: 0,0:14:22.16,0:14:23.84,Default,,0,0,0,,.إنها تمطر
Dialogue: 0,0:14:25.68,0:14:28.14,Default,,0,0,0,,.ساعدوني في جمع الصناديق
Dialogue: 0,0:14:28.14,0:14:30.65,Default,,0,0,0,,.أريد تفقد السطح مرة أخرى
Dialogue: 0,0:14:30.65,0:14:33.20,Default,,0,0,0,,.قد نكون قد فوّتْنا شيئًا
Dialogue: 0,0:14:36.73,0:14:37.85,Default,,0,0,0,,...مؤلم
Dialogue: 0,0:14:39.55,0:14:41.01,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:14:41.01,0:14:43.38,Default,,0,0,0,,ماذا كنت تفعل هنا؟
Dialogue: 0,0:14:43.77,0:14:47.41,Default,,0,0,0,,.رأيت الشيف ينزل من السلم قبل قليل
Dialogue: 0,0:14:47.41,0:14:50.70,Default,,0,0,0,,،سمعت عن الشبح على السطح
Dialogue: 0,0:14:50.70,0:14:53.37,Default,,0,0,0,,.ففكرت فيما كان يفعله هناك
Dialogue: 0,0:14:53.37,0:14:55.37,Default,,0,0,0,,.فكرت أن أصعد لأتفقد الأمر
Dialogue: 0,0:14:56.66,0:14:58.13,Default,,0,0,0,,!أيها الأطفال
Dialogue: 0,0:14:58.68,0:15:00.59,Default,,0,0,0,,هل رأيتم غينتا؟
Dialogue: 0,0:15:02.50,0:15:04.43,Default,,0,0,0,,.ظننا أنه معكِ
Dialogue: 0,0:15:04.43,0:15:05.95,Default,,0,0,0,,.حدثت أمور كثيرة
Dialogue: 0,0:15:05.95,0:15:12.48,Default,,0,0,0,,.مررنا بمنزل الأنسة موتوكو، وتذوقنا حساء لحم البقر الذي أعدته للعشاء
Dialogue: 0,0:15:13.89,0:15:20.11,Default,,0,0,0,,ثم قال غينتا إنه ذاق مثل حساء\N.هذا المطعم وركض خارج المنزل
Dialogue: 0,0:15:20.11,0:15:21.13,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:21.13,0:15:29.05,Default,,0,0,0,,ربما لم يكن الجاني الذي يراقب من السطح\N.هو النصّاب بل الشيف
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&H5BA1B4&\4c&H88B46A&\xshad-2\yshad1\bord3\fs14\pos(465,79)}شوربات ~مكونات الربيع~
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HCFE5DF&\4c&H6865AB&\xshad-2\yshad1\bord3\fs14\pos(430,79)}شوربات ~مكونات الخريف~
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HF6F7F0&\4c&H9B947A&\xshad-2\yshad1\bord3\fs14\pos(395,79)}شوربات ~مكونات الشتاء~
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HD0BCD6&\4c&HA37CB6&\xshad-2\yshad1\bord3\fs14\pos(360,79)}أطباق لحم وأسماك 2
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HADC18B&\4c&H938FBD&\xshad-2\yshad1\bord3\fs14\pos(325,79)}أطباق يابانية ~مكونات الربيع~
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HEDDFCD&\4c&H87C3D9&\xshad-2\yshad1\bord3\fs14\pos(295,79)}أطباق يابانية ~مكونات الصيف~
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&H80CFB0&\4c&H96D191&\xshad-2\yshad1\bord3\fs14\pos(260,79)}أطباق يابانية ~مكونات الخريف~
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HF6F5F0&\4c&H8CC3D5&\xshad-2\yshad1\bord3\fs14\pos(225,79)}أطباق يابانية ~مكونات الشتاء~
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HF7F9F6&\4c&H518E60&\xshad-2\yshad1\bord3\fs14\pos(190,79)}أطباق فرنسية 1
Dialogue: 0,0:15:25.49,0:15:34.37,sign_1173_recipes,SIGN,0,0,0,,{\frz270\an7\c&H595959&\3c&HF7F9F6&\4c&H518E60&\xshad-2\yshad1\bord3\fs14\pos(155,79)}أطباق فرنسية 3
Dialogue: 0,0:15:29.44,0:15:34.36,Default,,0,0,0,,،كان يحاول سرقة وصفات الأنسة موتوكو\N.بما أنها كانت تدير مطعمًا مشهورًا
Dialogue: 0,0:15:35.11,0:15:37.37,Default,,0,0,0,,.الشيف يعمل أيضًا في هذا المبنى
Dialogue: 0,0:15:38.03,0:15:43.25,Default,,0,0,0,,الشيف كان يراقب الأنسة موتوكو\N.لكي يعرف متى تغادر المنزل
Dialogue: 0,0:15:43.25,0:15:50.03,Default,,0,0,0,,لكن ساق الأنسة موتوكو مصابة منذ\N.ثلاثة أسابيع، لذا توقف عن رؤيتها
Dialogue: 0,0:15:50.53,0:15:52.89,Default,,0,0,0,,...لكي يعرف إن كانت في المنزل
Dialogue: 0,0:15:52.89,0:15:54.83,Default,,0,0,0,,!كان يتصل دون أن يقول شيئًا
Dialogue: 0,0:15:54.83,0:15:55.84,Default,,0,0,0,,.صحيح
Dialogue: 0,0:15:55.84,0:16:01.77,Default,,0,0,0,,وعندما علم أنها في المنزل، كان يذهب\N.إلى منزلها ليسرق وصفاتها
Dialogue: 0,0:16:01.77,0:16:04.28,Default,,0,0,0,,.هنا تُركت آثار الأقدام
Dialogue: 0,0:16:04.28,0:16:08.03,Default,,0,0,0,,.وهكذا أكمل قائمة طعامه الجديدة
Dialogue: 0,0:16:08.03,0:16:10.03,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:16:10.03,0:16:11.95,Default,,0,0,0,,!لابد أن غينتا مع الشيف
Dialogue: 0,0:16:11.95,0:16:13.70,Default,,0,0,0,,آي، هل يمكنك مراقبته؟
Dialogue: 0,0:16:13.70,0:16:15.54,Default,,0,0,0,,!انتظروا
Dialogue: 0,0:16:30.29,0:16:31.43,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:16:44.69,0:16:46.83,Default,,0,0,0,,.قميصه فقط كان أبيض
Dialogue: 0,0:16:46.83,0:16:47.80,Default,,0,0,0,,.أنت محق
Dialogue: 0,0:16:47.80,0:16:49.95,Default,,0,0,0,,.باقي ملابسه كلها سوداء
Dialogue: 0,0:16:50.26,0:16:52.21,Default,,0,0,0,,.فهمت، مئزر
Dialogue: 0,0:16:52.21,0:16:56.12,Default,,0,0,0,,.هكذا كان يختفي فجأة ويظهر
Dialogue: 0,0:16:56.12,0:16:57.80,Default,,0,0,0,,ماذا تقصد؟
Dialogue: 0,0:16:57.80,0:17:03.73,Default,,0,0,0,,المئزر له من الأمام فقط، لذا كل ما\N.عليه فعله هو أن يدير ظهره
Dialogue: 0,0:17:05.31,0:17:06.71,Default,,0,0,0,,.فهمت
Dialogue: 0,0:17:06.71,0:17:10.22,Default,,0,0,0,,أليست هذه آثار غينتا؟
Dialogue: 0,0:17:10.98,0:17:12.26,Default,,0,0,0,,.أنتِ محقة
Dialogue: 0,0:17:12.26,0:17:14.99,Default,,0,0,0,,غينتا أدرك أن الشيف سرق الوصفات
Dialogue: 0,0:17:14.99,0:17:17.65,Default,,0,0,0,,.فجاء إلى هنا ليطلب إجابات من الشيف
Dialogue: 0,0:17:18.48,0:17:20.60,Default,,0,0,0,,.ثم قُبض عليه
Dialogue: 0,0:17:20.98,0:17:25.48,Default,,0,0,0,,...لكي يسكت غينتا الذي اكتشف سره
Dialogue: 0,0:17:25.48,0:17:27.36,Default,,0,0,0,,!غينتا في خطر
Dialogue: 0,0:17:30.19,0:17:31.36,Default,,0,0,0,,!انه هو
Dialogue: 0,0:17:31.36,0:17:32.36,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:17:33.56,0:17:35.38,Default,,0,0,0,,!ابتعد عنه
Dialogue: 0,0:17:35.38,0:17:37.74,Default,,0,0,0,,!غينتا ليس طعمه جيد
Dialogue: 0,0:17:39.12,0:17:41.00,Default,,0,0,0,,.هذا ليس ما حدث
Dialogue: 0,0:17:41.45,0:17:42.62,Default,,0,0,0,,.كونان
Dialogue: 0,0:17:42.93,0:17:45.20,Default,,0,0,0,,.لكننا رأيناه
Dialogue: 0,0:17:45.20,0:17:47.86,Default,,0,0,0,,.فقط مئزر الشيف أبيض
Dialogue: 0,0:17:47.86,0:17:50.26,Default,,0,0,0,,.كان مئزرًا طويلاً
Dialogue: 0,0:17:50.26,0:17:54.90,Default,,0,0,0,,.صحيح أنّ الشبح الذي رأيتموه كان الطباخ
Dialogue: 0,0:17:55.39,0:17:58.14,Default,,0,0,0,,.حتى أنه ترك أدلة على السطح
Dialogue: 0,0:17:58.14,0:17:59.52,Default,,0,0,0,,أدلة؟
Dialogue: 0,0:17:59.99,0:18:03.01,Default,,0,0,0,,.المطر كشف عن آثاره
Dialogue: 0,0:18:03.01,0:18:06.90,Default,,0,0,0,,طابقت آثار أقدامه التي كانت أمام منزل الأنسة موتوكو
Dialogue: 0,0:18:06.90,0:18:09.28,sign_1173_spray,SIGN,0,0,0,,{\an2\shad2\pos(334,113)\fs24\c&HAE6C50&\3c&HF1F1F1&\4c&HC07F67&\fad(500,700)}بخاخ مقاوم للماء
Dialogue: 0,0:18:06.90,0:18:09.28,sign_1173_spray,SIGN,0,0,0,,{\an8\shad0\c&H00FFFF&\bord0\frz7\fax-0.2\3c&HC0806B&\fs10\fad(500,700)\pos(354,265)}طويل الأمد
Dialogue: 0,0:18:07.57,0:18:10.53,Default,,0,0,0,,لابد أنه استخدم بخاخ مقاومًا للماء\N.أثناء تواجده على السطح
Dialogue: 0,0:18:10.96,0:18:13.35,Default,,0,0,0,,.الشيف لديه دافع
Dialogue: 0,0:18:13.35,0:18:17.79,Default,,0,0,0,,.أليس الهدف من المكالمات هو الانتقام
Dialogue: 0,0:18:17.79,0:18:20.77,Default,,0,0,0,,.وهو كان يسرق وصفات الأنسة موتوكو
Dialogue: 0,0:18:20.77,0:18:21.77,Default,,0,0,0,,.لا
Dialogue: 0,0:18:21.77,0:18:24.29,Default,,0,0,0,,...هذا ما ظننتُه أيضًا، لكن
Dialogue: 0,0:18:35.87,0:18:37.18,Default,,0,0,0,,...توموهارو
Dialogue: 0,0:18:37.18,0:18:39.06,sign_suspect,SIGN,0,0,0,,{\pos(322,254)}(45) كانازاوا توموهارو
Dialogue: 0,0:18:37.18,0:18:39.06,Default,SIGN,0,0,0,,{\fs14\pos(322,271)}رئيس مطعم تومو
Dialogue: 0,0:18:25.54,0:18:28.42,Default,,0,0,0,,ما هذا الضجيج كله؟
Dialogue: 0,0:18:31.22,0:18:34.68,Default,,0,0,0,,.يبدو أن الطباخ هو ابن الأنسة موتوكو
Dialogue: 0,0:18:39.06,0:18:41.93,Default,,0,0,0,,.لهذا طعم أطباقهم كان متقاربًا
Dialogue: 0,0:18:44.48,0:18:49.98,Default,,0,0,0,,قبل عشرين عامًا، كان بيني وبين أمي شجار كبير\N.على اتجاه المطعم
Dialogue: 0,0:18:49.98,0:18:52.19,Default,,0,0,0,,.غادرت المنزل بسبب ذلك
Dialogue: 0,0:18:52.19,0:18:55.39,Default,,0,0,0,,.لسنوات عملت شيفًا في فندق
Dialogue: 0,0:18:56.34,0:19:00.94,Default,,0,0,0,,.كنت عنيدًا ورفضت التواصل مع والدتي
Dialogue: 0,0:19:01.43,0:19:06.42,Default,,0,0,0,,قبل عدة أشهر، تركت عملي في الفندق\N.وقررت فتح مطعمي الخاص
Dialogue: 0,0:19:06.95,0:19:11.84,Default,,0,0,0,,وجدت بمحض الصدفة عقارًا قرب منزل أمي\N.وقررت افتتاحه هناك
Dialogue: 0,0:19:16.36,0:19:19.85,Default,,0,0,0,,.كنت أريد فقط أن أتفقد أمي سرًا
Dialogue: 0,0:19:19.85,0:19:22.29,Default,,0,0,0,,.يبدو ذلك مريبًا من الخارج
Dialogue: 0,0:19:22.29,0:19:27.98,Default,,0,0,0,,احد من طاقمك سقط من السلم أثناء\N.محاولتهُ معرفة ما كنت تفعله
Dialogue: 0,0:19:28.30,0:19:30.48,Default,,0,0,0,,مياكي فعل ذلك؟
Dialogue: 0,0:19:31.58,0:19:34.77,Default,,0,0,0,,.هايبارا في طريقها إلى المستشفى معه الآن
Dialogue: 0,0:19:34.77,0:19:37.38,Default,,0,0,0,,.تعرض لإصابة طفيفة، لكنه بخير
Dialogue: 0,0:19:37.38,0:19:38.62,Default,,0,0,0,,.لا تقلق
Dialogue: 0,0:19:38.62,0:19:40.43,Default,,0,0,0,,.الحمد لله
Dialogue: 0,0:19:40.43,0:19:42.33,Default,,0,0,0,,لكن لماذا اتصلت؟
Dialogue: 0,0:19:42.33,0:19:45.50,Default,,0,0,0,,.تلك المكالمات جعلت الأمور معقّدة بعض الشيء
Dialogue: 0,0:19:45.50,0:19:47.75,Default,,0,0,0,,.ذلك لأنكِ هنا
Dialogue: 0,0:19:47.75,0:19:49.75,Default,,0,0,0,,أنا؟
Dialogue: 0,0:19:50.13,0:19:53.72,Default,,0,0,0,,فجأة توقف السيد توموهارو عن رؤيت\N.الأنسة موتوكو في أحد الأيام
Dialogue: 0,0:19:53.72,0:19:57.46,Default,,0,0,0,,.وبدلاً من ذلك، أنتِ كنتِ تظهرين في الطابق الثاني
Dialogue: 0,0:19:57.46,0:20:01.26,Default,,0,0,0,,.السيد توموهارو لم يعرف ما الذي يجري، فارتبك واتصل
Dialogue: 0,0:20:01.79,0:20:06.77,Default,,0,0,0,,،أجابت والدتي عندما اتصلتُ\N.فشعرت بالاطمئنان حينها
Dialogue: 0,0:20:06.76,0:20:20.15,sign_1173_house_nameplate,SIGN,0,0,0,,{\frz-15\fax0.3\xshad-4\yshad3\fs12\an8\move(290,130,110,130)}كانازاوا
Dialogue: 0,0:20:07.20,0:20:09.18,Default,,0,0,0,,.لكنني ما زلت أشعر بالقلق
Dialogue: 0,0:20:09.18,0:20:13.17,Default,,0,0,0,,.في كل مرة يظهر فيها غريب في الطابق الثاني، لم أستطع أن افعل شيئًا إلا بالاتصال
Dialogue: 0,0:20:13.17,0:20:15.91,Default,,0,0,0,,.لكنني لم أستطع أن أقول أنه أنا
Dialogue: 0,0:20:15.91,0:20:20.16,Default,,0,0,0,,.أتيت إلى منزلها الأسبوع الماضي لكن لم أستطع الدخول
Dialogue: 0,0:20:20.16,0:20:24.54,Default,,0,0,0,,.لقد تركتَ كل تلك الآثار لأنك لم تستطع أن تقرر ما تفعل
Dialogue: 0,0:20:24.90,0:20:28.99,Default,,0,0,0,,عندما ظهرت اليوم\N،وسمعت عن ذعر الشبح
Dialogue: 0,0:20:28.99,0:20:32.82,Default,,0,0,0,,قررت أن اليوم سيكون آخر مرة\Nأتفقدها من السطح
Dialogue: 0,0:20:32.82,0:20:36.06,Default,,0,0,0,,.واتصلت بوالدتي، لكنها أغلقت الهاتف
Dialogue: 0,0:20:38.98,0:20:42.68,Default,,0,0,0,,تبا، لماذا فعلت كل هذا؟
Dialogue: 0,0:20:42.68,0:20:48.43,Default,,0,0,0,,يا سيد توموهارو، هل رأيت المقالة عن جائزة الأنسة موتوكو؟
Dialogue: 0,0:20:48.43,0:20:49.06,Default,SIGN,0,0,0,,{\fnGeorgia\an8\fad(1,500)\fs12\b1\bord0\shad0\c&H686768&\frz270\pos(495,190)}امرأة تفشل محتالّي الهاتف
Dialogue: 0,0:20:49.51,0:20:51.56,Default,SIGN,0,0,0,,{\fnGeorgia\an2\fad(1000,1)\fs24\b1\bord0\shad0\c&H737373&\frz270\pos(345,190)}"!لا أملك اولاد"
Dialogue: 0,0:20:51.56,0:20:58.82,Default,,0,0,0,,...صُدمت عندما علمت أني لم أعد في قلب والدتي، فلم أستطع
Dialogue: 0,0:20:58.82,0:21:00.57,Default,,0,0,0,,.يا لك من أحمق
Dialogue: 0,0:21:00.57,0:21:05.62,Default,,0,0,0,,.لقد قلت ذلك فقط لجعل المحتالون يتخلون عنك
Dialogue: 0,0:21:06.40,0:21:09.54,Default,,0,0,0,,.الأنسة موتوكو لم تنسَك أبدًا
Dialogue: 0,0:21:09.54,0:21:14.09,Default,,0,0,0,,،لا تزال تحتفظ بملعقة وشوكتك من أيام طفولتك
Dialogue: 0,0:21:14.09,0:21:14.71,Default,SIGN,0,0,0,,{\an2\frz55\alphaAA\fax0.1\fad(1,100)\pos(270,138)}تومو
Dialogue: 0,0:21:14.65,0:21:16.53,Default,,0,0,0,,.كما لو كانت كنزًا
Dialogue: 0,0:21:17.67,0:21:18.97,Default,,0,0,0,,...أمي
Dialogue: 0,0:21:18.97,0:21:22.72,Default,,0,0,0,,.كان يجب أن تكون صادقًا منذ البداية
Dialogue: 0,0:21:24.79,0:21:27.85,Default,,0,0,0,,.أنا آسف جدًا على كل المتاعب التي سببتها
Dialogue: 0,0:21:27.85,0:21:30.17,Default,,0,0,0,,.حتى أن مياكي تعرض للأذى بسببي
Dialogue: 0,0:21:30.17,0:21:32.05,Default,,0,0,0,,.أعتذر عن ما فعلت
Dialogue: 0,0:21:32.05,0:21:35.96,Default,,0,0,0,,.لكن، غينتا، أنت سبب وجودي هنا الآن
Dialogue: 0,0:21:35.96,0:21:37.00,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:21:37.91,0:21:39.06,Default,,0,0,0,,أ-أنا؟
Dialogue: 0,0:21:39.06,0:21:40.90,Default,,0,0,0,,.عمل جميل، غينتا
Dialogue: 0,0:21:40.90,0:21:44.49,Default,,0,0,0,,!أنتم رائعون حقاً يا فريق المحققين الصغار
Dialogue: 0,0:21:44.49,0:21:47.05,Default,,0,0,0,,كنتُ أنا؟
Dialogue: 0,0:21:48.17,0:21:50.00,Default,,0,0,0,,نحن رائعون، أليس كذلك؟
Dialogue: 0,0:21:53.25,0:21:55.04,DCEnding,,0,0,0,,!مرح! مرح! مرح
Dialogue: 0,0:21:57.43,0:22:03.64,DCEnding,,0,0,0,,قلبي ينبض بقوة قلبي ينبض بقوة أنا حقًا فضولي بشأن الحقيقة
Dialogue: 0,0:22:03.84,0:22:10.44,DCEnding,,0,0,0,,هل تحاول؟ من الصعب الكذب، أليس كذلك؟ يا! يا
Dialogue: 0,0:22:10.49,0:22:16.73,DCEnding,,0,0,0,,لاااا، أنا أفقد صوابي! هل من أحد يساعدني؟
Dialogue: 0,0:22:16.93,0:22:22.10,DCEnding,,0,0,0,,(كذبة أم حقيقة؟ لا أستطيع أن أقول (كل شيء أو لا شيء
Dialogue: 0,0:22:22.71,0:22:29.78,DCEnding,,0,0,0,,أنا في غاية الحب معك، أنا في غاية الحب معك
Dialogue: 0,0:22:29.93,0:22:36.47,DCEnding,,0,0,0,,يحب! هذا صحيح! سوف أتعرض لحروق شديدة
Dialogue: 0,0:22:36.63,0:22:43.80,DCEnding,,0,0,0,,تألق، ارقص معي، ارقص، ارقص، ارقص بابتسامة مبهرة
Dialogue: 0,0:22:44.97,0:22:51.14,DCEnding,,0,0,0,,أنسى الأشياء السيئة وأحبها، لا يمكن مساعدتها
Dialogue: 0,0:22:51.43,0:22:57.37,DCEnding,,0,0,0,,أنت وأنا وتلك الفتاة، إذا رقصنا، سنكون جميعًا سعداء
Dialogue: 0,0:22:57.81,0:23:03.98,DCEnding,,0,0,0,,تعال! تعال! أنت تتألق بشكل مشرق اليوم أيضًا
Dialogue: 0,0:23:04.63,0:23:09.62,DCEnding,,0,0,0,,!إنه أمر ممتع عندما يكون الجميع هناك، لذلك دعونا نذهب
Dialogue: 0,0:23:13.65,0:23:15.03,Default,,0,0,0,,!يبدو هذا شهيًا جدًا
Dialogue: 0,0:23:15.03,0:23:16.45,Default,,0,0,0,,.هذا كعطاءٍ شكرٍ لكم
Dialogue: 0,0:23:16.45,0:23:17.96,Default,,0,0,0,,.كلوا قدر ما تشاؤون
Dialogue: 0,0:23:18.74,0:23:20.71,Default,,0,0,0,,!شكرًا على الطعام
Dialogue: 0,0:23:22.82,0:23:24.97,Default,,0,0,0,,.أنا سعيدة لأن قدميكِ أصبحت أفضل
Dialogue: 0,0:23:25.25,0:23:26.72,Default,,0,0,0,,.شكرًا لكِ
Dialogue: 0,0:23:27.34,0:23:29.91,Default,,0,0,0,,.لكن الآن أنا مصاب
Dialogue: 0,0:23:29.91,0:23:32.93,Default,,0,0,0,,.تشرفت بوجود شيف أسطورية هنا
Dialogue: 0,0:23:34.90,0:23:38.24,Default,,0,0,0,,.لن أدع ابني يهزمني
Dialogue: 0,0:23:38.24,0:23:39.98,Default,,0,0,0,,!سنصارع بالنكهات
Dialogue: 0,0:23:41.42,0:23:43.49,Default,,0,0,0,,.حسناً، حنساُ
Dialogue: 0,0:23:44.99,0:24:09.01,Default,SIGN,0,0,0,,في الحلقة القادمة 
Dialogue: 0,0:23:45.69,0:23:47.49,Default,,0,0,0,,أوراشيما تارو؟
Dialogue: 0,0:23:47.76,0:23:52.74,Default,,0,0,0,,.الشائعة تقول إن هذه الحادثة سببتها لعنة أوراشيما تارو
Dialogue: 0,0:23:53.04,0:23:58.00,Default,,0,0,0,,.إنها حلوى خاصة مصنوعة من المحار المقلي، شرائح ذيل الصفاح، والبطاطس المهروسة
Dialogue: 0,0:24:00.21,0:24:02.13,Default,,0,0,0,,أوراشيما تارو؟
Dialogue: 0,0:24:04.51,0:24:09.01,Default,,0,0,0,,!تـ-تاكيشي فتح الصندوق المرصع بالجواهر
Dialogue: 0,0:24:09.01,0:24:15.02,Default,SIGN,0,0,0,,{\pos(320,45)}‏السطح الزجاجي للماء\N(الجزء الأول)
Dialogue: 0,0:24:09.45,0:24:14.03,Default,,0,0,0,,الحلقة القادمة من كونان هي "‏السطح الزجاجي للماء – الجزء الأول!"
Dialogue: 0,0:24:30.52,0:24:32.86,Default,,0,0,0,,!تلميح كونان القادم
Dialogue: 0,0:24:30.03,0:24:34.95,Default,SIGN,0,0,0,,{\pos(320,225)}‏منزل القوارب
Dialogue: 0,0:24:32.86,0:24:34.30,Default,,0,0,0,,!‏منزل القوارب
Dialogue: 0,0:24:34.95,0:24:37.09,Default,,0,0,0,,.سمعت إشاعة عن بيت مسكون
Dialogue: 0,0:24:34.95,0:24:39.96,Default,SIGN,0,0,0,,{\pos(245,304)}لا تفوتوا الحلقة القادمة
Dialogue: 0,0:24:37.09,0:24:38.24,Default,,0,0,0,,.ربما إنها قضية أخرى
Dialogue: 0,0:24:38.24,0:24:39.92,Default,,0,0,0,,قضية أخرى؟
