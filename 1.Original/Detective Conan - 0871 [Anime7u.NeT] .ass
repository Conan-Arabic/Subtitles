Dialogue: 0,0:00:03.48,0:00:05.01,DCMain,GENTA,0,0,0,,!وصلنا أخيرًا
Dialogue: 0,0:00:05.52,0:00:07.03,DCMain,MITSUHIKO,0,0,0,,في الوقت المناسب
Dialogue: 0,0:00:17.90,0:00:19.44,DCMain,AYUMI,0,0,0,,!لامع جدًا
Dialogue: 0,0:00:19.44,0:00:21.26,DCMain,MITSUHIKO,0,0,0,,إنه نوبوناغا
Dialogue: 0,0:00:21.26,0:00:22.75,DCMain,GENTA,0,0,0,,!مدهش
Dialogue: 0,0:00:23.21,0:00:25.80,DCItalic,CONAN,0,0,0,,،في هذه السنة 2017
Dialogue: 0,0:00:25.80,0:00:31.96,DCItalic,CONAN,0,0,0,,توافق الذكرى السنوية الـ 450 لدخول أودا \Nنوبوناغا، قائد القوات الدولية المتحاربة، إلى قلعة غيفو
Dialogue: 0,0:00:32.61,0:00:35.14,DCItalic,CONAN,0,0,0,,وهناك، إلى جانب التجول في المدينة
Dialogue: 0,0:00:35.14,0:00:39.29,DCItalic,CONAN,0,0,0,,{\an8}جئنا لمشاهدة الفعاليات الكثيرة احتفالًا بذكرى ذلك الحدث العظيم
Dialogue: 0,0:01:03.16,0:01:05.37,DCMain,AYUMI,0,0,0,,ألم يكن ذلك مسليًا يا [كونان]؟
Dialogue: 0,0:01:05.77,0:01:07.37,DCMain,CONAN,0,0,0,,بلى، كان كذلك
Dialogue: 0,0:01:08.70,0:01:11.88,DCMain,GENTA,0,0,0,,[لم أعلم أنكِ مهتمة بمثل هذه الأشياء يا [أيومي
Dialogue: 0,0:01:12.23,0:01:14.85,DCMain,HAIBARA,0,0,0,,ألا تعلم؟ إنها رائجة مؤخرًا بين الفتيات
Dialogue: 0,0:01:14.85,0:01:17.89,DCMain,MITSUHIKO,0,0,0,,تسمى بأشياء مثل هواة التاريخ أو الفتيات المحاربات
Dialogue: 0,0:01:18.21,0:01:21.18,DCMain,AYUMI,0,0,0,,لا أعلم بشأن ذلك
Dialogue: 0,0:01:21.18,0:01:23.64,DCMain,AYUMI,0,0,0,,ولكنها ممتعة جدًا
Dialogue: 0,0:01:23.94,0:01:26.09,DCMain,AGASA,0,0,0,,والآن، لننتقل إلى المكان التالي
Dialogue: 0,0:01:26.09,0:01:28.12,DCMain,ALL,0,0,0,,حسنًا
Dialogue: 0,0:03:27.71,0:03:30.50,DCMain,CONAN,0,0,0,,قضية نوبوناغا الـ 450
Dialogue: 0,0:03:38.29,0:03:40.49,DCMain,AGASA,0,0,0,,{\an8}سنمكث في هذا النزل الليلة
Dialogue: 0,0:03:40.95,0:03:43.00,DCMain,WOMAN,0,0,0,,أهلًا وسهلًا
Dialogue: 0,0:03:43.46,0:03:44.99,DCMain,ALL,0,0,0,,شكرًا على عنايتكم بنا
Dialogue: 0,0:03:47.02,0:03:48.17,DCMain,AGASA,0,0,0,,[سيد [توباياما
Dialogue: 0,0:03:49.18,0:03:51.30,DCMain,TOBAYAMA,0,0,0,,[مرحبًا، سيد [أغاسا
Dialogue: 0,0:03:52.12,0:03:58.50,DCMain,AGASA,0,0,0,,يا أولاد، هذا صديق قديم لي وهو من دعانا إلى هنا
Dialogue: 0,0:03:58.50,0:04:00.51,DCMain,AGASA,0,0,0,,[الصياد بطيور الغاق، السيد [توباياما
Dialogue: 0,0:04:01.38,0:04:05.18,DCMain,TOBAYAMA,0,0,0,,"{\an8}مرحبًا، لا بد أنكم "فرقة المتحريين الصغار
Dialogue: 0,0:04:05.40,0:04:07.55,DCMain,ALL,0,0,0,,تشرفنا بلقائك
Dialogue: 0,0:04:08.54,0:04:10.18,DCMain,TOBAYAMA,0,0,0,,جيد، أحب هذه الروح العالية
Dialogue: 0,0:04:21.00,0:04:22.02,DCMain,GENTA,0,0,0,,!مدهش
Dialogue: 0,0:04:22.02,0:04:22.82,DCMain,MITSUHIKO,0,0,0,,!ما أجملها
Dialogue: 0,0:04:26.12,0:04:27.83,DCMain,AGASA,0,0,0,,[انظروا، هذا السيد [توباياما
Dialogue: 0,0:04:30.33,0:04:32.20,DCMain,ALL,0,0,0,,![سيد [توباياما
Dialogue: 0,0:04:40.82,0:04:44.18,DCMain,AGASA,0,0,0,,والآن، أين نذهب تاليًا؟
Dialogue: 0,0:04:40.82,0:04:44.18,DCMain,AGASA,0,0,0,,{\fs44\pos(592.986,623.432)}"إيكومايكا"
Dialogue: 0,0:04:44.22,0:04:46.82,DCMain,AYUMI,0,0,0,,(عرفت، هذه لهجة سكان (غيفو
Dialogue: 0,0:04:46.82,0:04:50.60,DCMain,CONAN,0,0,0,,بالأحرى، كلمة "إيكومايكا" ليست استفهامية
Dialogue: 0,0:04:50.60,0:04:53.21,DCMain,CONAN,0,0,0,,"بل تعني: "لنذهب لمكان محدد
Dialogue: 0,0:04:53.21,0:04:57.34,DCMain,HAIBARA,0,0,0,,كما هو متوقع من متحرٍ مطّلع على كل شيء
Dialogue: 0,0:04:57.34,0:04:58.52,DCMain,CONAN,0,0,0,,دعيني وشأني{ارحميني_من_تعليقاتك}
Dialogue: 0,0:04:58.52,0:05:01.44,DCMain,GENTA,0,0,0,,ها قد بدأت أشعر بالجوع
Dialogue: 0,0:05:01.44,0:05:02.26,DCMain,BOTH,0,0,0,,ماذا؟
Dialogue: 0,0:05:02.26,0:05:06.95,DCMain,AYUMI,0,0,0,,ألم تأكل قبل وقت قصير ثلاثًا من "شرائح لحم هيدا"؟
Dialogue: 0,0:05:06.95,0:05:08.49,DCMain,GENTA,0,0,0,,هذا صحيح
Dialogue: 0,0:05:12.72,0:05:17.04,DCMain,MITSUHIKO,0,0,0,,أجل، عرفت. عندي اقتراح لمكان نذهب إليه
Dialogue: 0,0:05:19.46,0:05:22.05,DCMain,RED,0,0,0,,بما أن [نوبوناغا] استولى على القلعة قبل أربعئمائة سنة
Dialogue: 0,0:05:23.57,0:05:24.88,DCMain,BLUE,0,0,0,,وخمسون عامًا
Dialogue: 0,0:05:24.92,0:05:26.93,DCMain,BLUE,0,0,0,,،ففي هذه السنة بعد مرور الزمن
Dialogue: 0,0:05:27.26,0:05:30.51,DCMain,GREEN,0,0,0,,وعلى هذه الأرض، سنأتي بالصداقة والعدالة
Dialogue: 0,0:05:32.29,0:05:33.78,DCMain,BLACK,0,0,0,,الشجاعة وبذل الجهد
Dialogue: 0,0:05:35.90,0:05:38.43,DCMain,PINK,0,0,0,,الحب والابتسامة
Dialogue: 0,0:05:40.52,0:05:44.28,DCMain,ALL,0,0,0,,!وصلت فرقة أوريغامي نوبونا غايزر
Dialogue: 0,0:05:47.40,0:05:49.40,DCMain,CROWD,0,0,0,,!نوبونا غايزر
Dialogue: 0,0:05:56.56,0:05:58.50,DCMain,CONAN,0,0,0,,عرض أبطال محلي إذًا؟
Dialogue: 0,0:05:58.80,0:06:01.62,DCMain,GENTA,0,0,0,,نوبو... نوزا؟
Dialogue: 0,0:06:01.62,0:06:02.63,DCMain,GENTA,0,0,0,,ما هو؟
Dialogue: 0,0:06:02.87,0:06:04.66,DCMain,HAIBARA,0,0,0,,"نوبونا غايزر"
Dialogue: 0,0:06:04.66,0:06:08.13,DCMain,HAIBARA,0,0,0,,[أبطال يجسّدون [أودا نوبوناغا
Dialogue: 0,0:06:08.36,0:06:09.58,DCMain,AYUMI,0,0,0,,!رائعون
Dialogue: 0,0:06:09.58,0:06:11.11,DCMain,MITSUHIKO,0,0,0,,أرأيتم؟
Dialogue: 0,0:06:11.11,0:06:13.97,DCMain,MITSUHIKO,0,0,0,,في الحقيقة إنني أحضرت هذا معي
Dialogue: 0,0:06:17.38,0:06:18.80,DCMain,GENTA,0,0,0,,!أهذا معقول؟
Dialogue: 0,0:06:18.80,0:06:21.68,DCMain,AYUMI,0,0,0,,هل صنعتها أنت يا [ميتسوهيكو]؟
Dialogue: 0,0:06:21.68,0:06:22.36,DCMain,MITSUHIKO,0,0,0,,نعم
Dialogue: 0,0:06:22.65,0:06:25.20,DCMain,MITSUHIKO,0,0,0,,بالخروج في رحلات والبحث عبر الإنترنت
Dialogue: 0,0:06:25.20,0:06:29.61,DCMain,MITSUHIKO,0,0,0,,جمعتُ بيانات عن الأبطال المحليين عبر البلاد
Dialogue: 0,0:06:29.79,0:06:31.72,DCMain,GENTA,0,0,0,,عددهم كبير جدًا
Dialogue: 0,0:06:31.72,0:06:35.12,DCMain,GENTA,0,0,0,,مع وجود كل هذا العدد من الأبطال، سيكون العالم في أمان تام
Dialogue: 0,0:06:35.90,0:06:37.06,DCMain,MITSUHIKO,0,0,0,,هذا صحيح
Dialogue: 0,0:06:44.75,0:06:46.76,DCMain,MITSUHIKO,0,0,0,,!انطلقوا
Dialogue: 0,0:06:58.88,0:07:00.31,DCMain,ALL,0,0,0,,!"نوبونا غايزر"
Dialogue: 0,0:07:03.41,0:07:05.32,DCMain,CROWD,0,0,0,,!"نوبونا غايزر"
Dialogue: 0,0:07:06.82,0:07:11.07,DCMain,MITSUHIKO,0,0,0,,بالمناسبة حركتهم تلك للتو هي المميزة لهم وتسمى هبوط غايزر الثلاثي
Dialogue: 0,0:07:11.28,0:07:12.77,DCMain,GENTA,0,0,0,,!ما أروعها
Dialogue: 0,0:07:12.77,0:07:14.03,DCMain,AYUMI,0,0,0,,!مذهلة
Dialogue: 0,0:07:17.43,0:07:19.19,DCMain,MITSUHIKO,0,0,0,,وأنا سأساعد أيضًا
Dialogue: 0,0:07:19.19,0:07:20.04,DCMain,AYUMI,0,0,0,,وأنا أيضًا
Dialogue: 0,0:07:20.04,0:07:21.67,DCMain,GENTA,0,0,0,,وأنا كذلك
Dialogue: 0,0:07:23.08,0:07:24.17,DCMain,RED,0,0,0,,شكرًا
Dialogue: 0,0:07:24.94,0:07:27.42,DCMain,BLUE,0,0,0,,سوف يكافئكم نوبونا غايزر
Dialogue: 0,0:07:27.71,0:07:29.60,DCMain,GREEN,0,0,0,,تأكدوا من أن تأخذوا المكافأة
Dialogue: 0,0:07:30.26,0:07:32.11,DCMain,BLACK,0,0,0,,!اصطفّوا هنا
Dialogue: 0,0:07:33.12,0:07:34.16,DCMain,PINK,0,0,0,,تفضلي هذه
Dialogue: 0,0:07:34.16,0:07:35.43,DCMain,CHILD,0,0,0,,شكرًا
Dialogue: 0,0:07:42.32,0:07:43.87,DCMain,PINK,0,0,0,,تفضلي هذه
Dialogue: 0,0:07:43.87,0:07:46.06,DCMain,AYUMI,0,0,0,,!ما أجملها من ورقة
Dialogue: 0,0:07:46.32,0:07:48.82,DCMain,MITSUHIKO,0,0,0,,أليست هذه ورقة مينوا؟
Dialogue: 0,0:07:48.82,0:07:51.07,DCMain,RED,0,0,0,,تعرفها جيدًا إذًا
Dialogue: 0,0:07:51.27,0:07:56.70,DCMain,MITSUHIKO,0,0,0,,لأنني أجريتُ بحثًا عن أماكن عملكم قبل مجيئي إلى هنا
Dialogue: 0,0:07:57.03,0:07:59.17,DCMain,BLUE,0,0,0,,هذا مدهش يا فتى
Dialogue: 0,0:07:59.17,0:08:00.99,DCMain,GREEN,0,0,0,,يسرني سماع ذلك
Dialogue: 0,0:08:00.99,0:08:03.40,DCMain,BLACK,0,0,0,,لولاكم لَما كنا موجودين
Dialogue: 0,0:08:04.10,0:08:05.13,DCMain,PINK,0,0,0,,شكرًا
Dialogue: 0,0:08:07.54,0:08:10.84,DCMain,MITSUHIKO,0,0,0,,وأنا أيضًا سعيد للغاية وممتنٌّ جدًا
Dialogue: 0,0:08:10.84,0:08:12.72,DCMain,MITSUHIKO,0,0,0,,شكرًا جزيلًا
Dialogue: 0,0:08:13.07,0:08:14.93,DCMain,RED,0,0,0,,بل نحن نشكركم
Dialogue: 0,0:08:14.93,0:08:17.26,DCMain,RED,0,0,0,,!يا رفاق، إلى اللقاء
Dialogue: 0,0:08:17.26,0:08:19.77,DCMain,ALL,0,0,0,,مع السلامة
Dialogue: 0,0:08:20.05,0:08:23.77,DCMain,CONAN,0,0,0,,يبدو مذهلًا. لأول مرة أرى فيها [ميتسوهيكو] هكذا
Dialogue: 0,0:08:23.77,0:08:24.38,DCMain,RED,0,0,0,,بورك عملك
Dialogue: 0,0:08:24.38,0:08:25.86,DCMain,MAN,0,0,0,,شكرًا على جهدك
Dialogue: 0,0:08:25.86,0:08:26.96,DCMain,PINK,0,0,0,,بورك عملك
Dialogue: 0,0:08:26.96,0:08:28.57,DCMain,BLACK,0,0,0,,بورك عملك
Dialogue: 0,0:08:28.57,0:08:29.64,DCMain,BLUE,0,0,0,,بورك عملك
Dialogue: 0,0:08:30.10,0:08:31.24,DCMain,GREEN,0,0,0,,بورك عملك
Dialogue: 0,0:08:34.96,0:08:37.38,DCMain,MAN,0,0,0,,صدقًا، بورك عملكم يا رفاق
Dialogue: 0,0:09:00.38,0:09:03.43,DCMain,OYABU,0,0,0,,إذًا، لدينا اجتماع لمناقشة فعالية يوم غد
Dialogue: 0,0:09:03.85,0:09:06.15,DCMain,OYABU,0,0,0,,{\an8}سوف نجتمع في المكتب
Dialogue: 0,0:09:06.15,0:09:07.31,DCMain,ALL,0,0,0,,{\an8}حسنًا
Dialogue: 0,0:09:08.90,0:09:12.84,DCMain,MITSUHIKO,0,0,0,,[من المخالف للقواعد أن ترى وجه البطل يا [كونان
Dialogue: 0,0:09:12.84,0:09:14.78,DCMain,CONAN,0,0,0,,هذا صحيح
Dialogue: 0,0:09:15.16,0:09:17.72,DCMain,AGASA,0,0,0,,إذًا، دعونا نعُد إلى النزل يا أولاد
Dialogue: 0,0:09:17.72,0:09:19.28,DCMain,ALL,0,0,0,,حاضر
Dialogue: 0,0:09:20.78,0:09:23.29,DCMain,HAIBARA,0,0,0,,أشعر بامتلاء معدتي بالفعل
Dialogue: 0,0:09:24.53,0:09:25.79,DCMain,CONAN,0,0,0,,أتفق معك
Dialogue: 0,0:09:26.05,0:09:29.91,DCMain,GENTA,0,0,0,,ماذا؟ كان ما يزال بإمكان أكل المزيد
Dialogue: 0,0:09:29.91,0:09:34.06,DCMain,GENTA,0,0,0,,أرجو أن تدعنا نتوقف عند محل البقالة في طريق عودتنا يا بروفيسور
Dialogue: 0,0:09:34.06,0:09:36.66,DCMain,GENTA,0,0,0,,لنشتري وجبة معلبة مثلًا، أو فطائر اللحم
Dialogue: 0,0:09:36.66,0:09:40.30,DCMain,GENTA,0,0,0,,أو الشطائر أو البطاطس المقلية والعصير
Dialogue: 0,0:09:40.30,0:09:42.31,DCMain,AGASA,0,0,0,,حسنٌ، حسنٌ
Dialogue: 0,0:09:42.48,0:09:45.65,DCMain,AYUMI,0,0,0,,ولكن يا [غينتا]، هذا أكل كثير
Dialogue: 0,0:09:45.65,0:09:46.81,DCMain,MITSUHIKO,0,0,0,,بالفعل
Dialogue: 0,0:09:49.35,0:09:51.27,DCMain,AYUMI,0,0,0,,ما الخطب يا [ميتسوهيكو]؟
Dialogue: 0,0:09:51.97,0:09:55.19,DCMain,MITSUHIKO,0,0,0,,!نسيتُ أن أطلب منهم التوقيع على ألبومي للصور
Dialogue: 0,0:09:55.46,0:09:57.11,DCMain,MITSUHIKO,0,0,0,,!ما أسوأ حظي
Dialogue: 0,0:09:57.68,0:10:01.99,DCMain,CONAN,0,0,0,,ما بالك يا [ميتسوهيكو]؟ هل تنوي الاستسلام بهذه السهولة؟
Dialogue: 0,0:10:02.63,0:10:04.49,DCMain,HAIBARA,0,0,0,,سننتظرك
Dialogue: 0,0:10:04.49,0:10:05.54,DCMain,AYUMI,0,0,0,,أجل
Dialogue: 0,0:10:05.74,0:10:08.58,DCMain,GENTA,0,0,0,,ولكننا سنذهب لاحقًا إلى البقالة
Dialogue: 0,0:10:08.58,0:10:09.79,DCMain,MITSUHIKO,0,0,0,,شكرًا جزيلًا
Dialogue: 0,0:10:10.07,0:10:11.97,DCMain,AGASA,0,0,0,,احترس في طريقك
Dialogue: 0,0:10:11.97,0:10:12.79,DCMain,MITSUHIKO,0,0,0,,حاضر
Dialogue: 0,0:10:19.98,0:10:21.55,DCMain,MITSUHIKO,0,0,0,,أرجو المعذرة
Dialogue: 0,0:10:22.17,0:10:25.24,DCMain,MITSUHIKO,0,0,0,,...يا حضرات أعضاء نوبونا غايزر
Dialogue: 0,0:10:35.28,0:10:37.90,DCMain,GENTA,0,0,0,,تأخر [ميتسوهيكو] كثيرًا
Dialogue: 0,0:10:38.34,0:10:41.07,DCMain,GENTA,0,0,0,,أكاد أموت من الجوع
Dialogue: 0,0:10:47.06,0:10:48.51,DCMain,AYUMI,0,0,0,,المكان هادئ
Dialogue: 0,0:10:48.51,0:10:49.98,DCMain,GENTA,0,0,0,,لنتصل به
Dialogue: 0,0:10:54.01,0:10:55.59,DCMain,AYUMI,0,0,0,,![هذه لـ [ميتسوهيكو
Dialogue: 0,0:10:58.64,0:10:59.69,DCMain,AYUMI,0,0,0,,!لا أصدق
Dialogue: 0,0:10:59.69,0:11:00.97,DCMain,CONAN,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:11:08.76,0:11:10.62,DCMain,TOBAYAMA,0,0,0,,لم تجدوه بعد؟
Dialogue: 0,0:11:10.62,0:11:12.31,DCMain,TOBAYAMA,0,0,0,,لقد مضت ساعتان بالفعل
Dialogue: 0,0:11:12.80,0:11:15.57,DCMain,TOBAYAMA,0,0,0,,أخبرت بقية زملائي الصيادين
Dialogue: 0,0:11:15.57,0:11:18.24,DCMain,TOBAYAMA,0,0,0,,إذا عرفوا شيئًا فسيتصلون بي على الفور
Dialogue: 0,0:11:18.24,0:11:19.86,DCMain,AGASA,0,0,0,,أشكر لك تعاونك معنا
Dialogue: 0,0:11:20.12,0:11:22.09,DCMain,HAIBARA,0,0,0,,إذًا، ماذا عن الشرطة؟
Dialogue: 0,0:11:22.09,0:11:25.74,DCMain,CONAN,0,0,0,,استخدم البروفيسور اسم العم [كوغورو] لحثّهم على التحقيق
Dialogue: 0,0:11:25.74,0:11:27.23,DCMain,CONAN,0,0,0,,سيصلون قريبًا
Dialogue: 0,0:11:35.89,0:11:36.80,DCMain,MATSUSHIRO,0,0,0,,!عجبًا
Dialogue: 0,0:11:37.33,0:11:39.30,DCMain,MATSUSHIRO,0,0,0,,أين رأيتكم من قبل؟
Dialogue: 0,0:11:39.47,0:11:41.01,DCMain,GENTA,0,0,0,,!تذكرتك
Dialogue: 0,0:11:41.01,0:11:45.18,DCMain,AYUMI,0,0,0,,تقابلنا في قضية قرية (أونيزاوا) التراثية
Dialogue: 0,0:11:45.54,0:11:47.78,DCMain,HAIBARA,0,0,0,,المحقق [ماتسوشيرو]، صحيح؟
Dialogue: 0,0:11:48.71,0:11:52.69,DCMain,MATSUSHIRO,0,0,0,,{\an8}إذًا، ألم يأت السيد [موري] اليوم؟
Dialogue: 0,0:11:53.04,0:11:56.69,DCMain,CONAN,0,0,0,,[بدلًا منه، جاء معنا البروفيسور [أغاسا
Dialogue: 0,0:11:56.69,0:11:58.64,DCMain,MATSUSHIRO,0,0,0,,![البروفيسور [أغاسا
Dialogue: 0,0:11:58.64,0:12:00.46,DCMain,MATSUSHIRO,0,0,0,,سمعت عنك بالطبع
Dialogue: 0,0:12:00.46,0:12:03.41,DCMain,MATSUSHIRO,0,0,0,,[تتمتع بمهارة استنتاجية تضاهي المتحري [موري
Dialogue: 0,0:12:03.64,0:12:06.14,DCMain,MATSUSHIRO,0,0,0,,وحللتَ العديد من القضايا المعقدة
Dialogue: 0,0:12:06.14,0:12:08.24,DCMain,AGASA,0,0,0,,أحقًا هذا؟
Dialogue: 0,0:12:08.60,0:12:11.15,DCMain,CONAN,0,0,0,,بينما أنا المصدر الأساسي لكليهما
Dialogue: 0,0:12:11.15,0:12:12.54,DCMain,HAIBARA,0,0,0,,سيسمعك
Dialogue: 0,0:12:13.00,0:12:15.68,DCMain,MATSUSHIRO,0,0,0,,إذًا، هلّا أطلعتموني على التفاصيل؟
Dialogue: 0,0:12:16.62,0:12:21.22,DCItalic,CONAN,0,0,0,,...ولكن، ما يزال مكان [ميتسوهيكو] مجهولًا حتى الآن، وأيضًا
Dialogue: 0,0:12:22.13,0:12:24.24,DCMain,CONAN,0,0,0,,!حتى نوبونا غايزر اختفوا؟
Dialogue: 0,0:12:24.24,0:12:25.67,DCMain,HAIBARA,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:12:25.67,0:12:28.56,DCMain,MATSUSHIRO,0,0,0,,أردنا سؤالهم من باب الاحتياط
Dialogue: 0,0:12:29.16,0:12:32.06,DCMain,MATSUSHIRO,0,0,0,,ولكننا لم نستطع الاتصال بهم إلى الآن
Dialogue: 0,0:12:33.12,0:12:35.19,DCMain,CONAN,0,0,0,,أشعر أن هذا لا يبشر بخير
Dialogue: 0,0:12:35.71,0:12:36.57,DCMain,HAIBARA,0,0,0,,أتفق معك
Dialogue: 0,0:13:01.26,0:13:06.09,DCMain,MATSUSHIRO,0,0,0,,المسروقات تشمل، تمثال [أودا نوبوناغا] الذهبي المصغر
Dialogue: 0,0:13:06.32,0:13:07.72,DCMain,MATSUSHIRO,0,0,0,,ورقاقة ذهبية
Dialogue: 0,0:13:08.27,0:13:10.81,DCMain,MATSUSHIRO,0,0,0,,وسُرقت كذلك بعض المخطوطات ذات القيمة التاريخية
Dialogue: 0,0:13:11.28,0:13:13.93,DCMain,MATSUSHIRO,0,0,0,,(إنها تعتبر من كنوز (غيفو
Dialogue: 0,0:13:14.57,0:13:19.23,DCMain,HAIBARA,0,0,0,,على الأغلب إننا إذا لم نسرع في إيجادهم، سوف\N يبيعونها في السوق السوداء وتُنقل خارج البلاد
Dialogue: 0,0:13:19.43,0:13:21.23,DCMain,AYUMI,0,0,0,,أحقًا هذا؟
Dialogue: 0,0:13:21.23,0:13:23.24,DCMain,GENTA,0,0,0,,يبدو أنها مشكلة كبرى
Dialogue: 0,0:13:30.58,0:13:32.01,DCMain,AGASA,0,0,0,,...عذرًا
Dialogue: 0,0:13:32.01,0:13:35.61,DCMain,AGASA,0,0,0,,أيمكننا مشاهدة ما سجلته كاميرا المراقبة الأمنية؟
Dialogue: 0,0:13:35.61,0:13:36.16,DCMain,MATSUSHIRO,0,0,0,,نعم
Dialogue: 0,0:13:38.71,0:13:40.92,DCMain,GENTA,0,0,0,,...عجبًا! هؤلاء
Dialogue: 0,0:13:41.13,0:13:43.92,DCMain,AYUMI,0,0,0,,إنهم نوبونا غايزر... صحيح؟
Dialogue: 0,0:13:53.16,0:13:54.52,DCMain,GENTA,0,0,0,,!هذا مستحيل
Dialogue: 0,0:13:54.52,0:13:58.19,DCMain,GENTA,0,0,0,,!لم أرغب في تصديق هذا، ولكن الأبطال هم اللصوص
Dialogue: 0,0:13:58.19,0:14:00.31,DCMain,AYUMI,0,0,0,,!إنهم الأسوأ! لن أغفر لهم
Dialogue: 0,0:14:01.50,0:14:02.91,DCMain,MATSUSHIRO,0,0,0,,!ما- ماذا؟
Dialogue: 0,0:14:03.82,0:14:06.57,DCMain,MATSUSHIRO,0,0,0,,!وجدتم سيارة نوبونا غايزر؟
Dialogue: 0,0:14:19.04,0:14:20.28,DCMain,AYUMI,0,0,0,,ما هذا؟
Dialogue: 0,0:14:22.69,0:14:24.29,DCMain,GENTA,0,0,0,,!هذه شارة نوبوناغا
Dialogue: 0,0:14:24.29,0:14:26.38,DCMain,AYUMI,0,0,0,,أيعقل أنها لـ [ميتسوهيكو]؟
Dialogue: 0,0:14:26.69,0:14:29.04,DCMain,GENTA,0,0,0,,هل كان راكبًا في هذه السيارة؟
Dialogue: 0,0:14:29.04,0:14:30.74,DCMain,MATSUSHIRO,0,0,0,,ربما أخذوه رهينة
Dialogue: 0,0:14:32.21,0:14:33.05,DCMain,HAIBARA,0,0,0,,انظر
Dialogue: 0,0:14:33.05,0:14:34.89,DCMain,CONAN,0,0,0,,أجل، حتى أنا لاحظته
Dialogue: 0,0:14:37.35,0:14:39.15,DCMain,CONAN,0,0,0,,وانظري أيضًا للعجلة الأمامية
Dialogue: 0,0:14:43.77,0:14:44.82,DCMain,HAIBARA,0,0,0,,...هل هذا
Dialogue: 0,0:14:45.14,0:14:48.40,DCMain,CONAN,0,0,0,,من دون شك، إنه قار الإسفلت
Dialogue: 0,0:15:07.53,0:15:09.76,DCMain,CONAN,0,0,0,,ربما ما كان يجب عليّ قول ذلك
Dialogue: 0,0:15:10.39,0:15:14.72,DCFlashback,CONAN,0,0,0,,ما بالك يا [ميتسوهيكو]؟ هل تنوي الاستسلام بهذه السهولة؟
Dialogue: 0,0:15:15.27,0:15:17.17,DCFlashback,HAIBARA,0,0,0,,سننتظرك
Dialogue: 0,0:15:17.17,0:15:18.27,DCFlashback,AYUMI,0,0,0,,أجل
Dialogue: 0,0:15:18.52,0:15:21.30,DCFlashback,GENTA,0,0,0,,ولكننا سنذهب لاحقًا إلى البقالة
Dialogue: 0,0:15:21.30,0:15:22.52,DCFlashback,MITSUHIKO,0,0,0,,شكرًا جزيلًا
Dialogue: 0,0:15:22.92,0:15:24.65,DCFlashback,AGASA,0,0,0,,احترس في طريقك
Dialogue: 0,0:15:24.65,0:15:25.52,DCFlashback,MITSUHIKO,0,0,0,,حاضر
Dialogue: 0,0:15:25.75,0:15:28.00,DCMain,AYUMI,0,0,0,,إن كان كذلك، فأنا أيضًا شجّعته للذهاب
Dialogue: 0,0:15:28.00,0:15:29.75,DCMain,HAIBARA,0,0,0,,لم أحاول منعه
Dialogue: 0,0:15:29.75,0:15:30.78,DCMain,GENTA,0,0,0,,وأنا أيضًا
