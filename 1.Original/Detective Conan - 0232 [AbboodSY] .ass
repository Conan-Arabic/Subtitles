Dialogue: 0,0:00:02.02,0:00:03.98,Default,,0,0,0,,!التلميحات تقود إلى الإستنتاجات
Dialogue: 0,0:00:03.98,0:00:06.02,Default,,0,0,0,,!هناك لغزٌ وراء كل قضية
Dialogue: 0,0:00:06.02,0:00:07.73,Default,,0,0,0,,!قضية اليوم ستكون بداخل شقةٍ غريبة
Dialogue: 0,0:00:07.73,0:00:09.61,Default,,0,0,0,,!و هناك دوافع قتلٍ وراء حادثةٍ غريبة
Dialogue: 0,0:00:09.86,0:00:11.49,Default,,0,0,0,,يرى الحقيقة واحدةً كما هي
Dialogue: 0,0:00:11.49,0:00:13.49,Default,,0,0,0,,يبدو كطفل صغير و لكنه بعقل كبير
Dialogue: 0,0:00:13.49,0:00:15.70,Default,,0,0,0,,و اسمه هو، المحقق كونان
Dialogue: 0,0:01:41.58,0:01:47.33,Alternative,Sign,0,0,0,,{\pos(444,218)}قضية السقوط من فوق الشقّة
Dialogue: 0,0:01:48.58,0:01:49.58,Default,,0,0,0,,تباً
Dialogue: 0,0:01:50.29,0:01:53.92,Default,,0,0,0,,تذهب ران لمشاهدة فلمٍ ما بينما أعلق أنا مع كونان
Dialogue: 0,0:01:54.51,0:01:56.84,Default,,0,0,0,,هذا ربما لأنني أجلب لك الحظ
Dialogue: 0,0:01:56.84,0:01:58.09,Default,,0,0,0,,ما الذي تعنيه؟
Dialogue: 0,0:01:58.09,0:02:01.30,Default,,0,0,0,,كلما كنت بجانبك تقوم بحل العديد من القضايا
Dialogue: 0,0:02:01.51,0:02:03.93,Default,,0,0,0,,أحمق! إنها صدفةٌ فقط
Dialogue: 0,0:02:03.93,0:02:05.14,Default,,0,0,0,,!مرحباً بك
Dialogue: 0,0:02:07.85,0:02:09.10,Default,,0,0,0,,هل أنت السيد موري؟
Dialogue: 0,0:02:09.10,0:02:10.48,Default,,0,0,0,,نعم
Dialogue: 0,0:02:10.48,0:02:12.90,Default,,0,0,0,,لابد أنك السيد ويدا، تفضل
Dialogue: 0,0:02:13.32,0:02:14.11,Default,,0,0,0,,حسناً
Dialogue: 0,0:02:16.82,0:02:20.87,Default,,0,0,0,,عفواً.. هل يزعجك دخان السجائر؟
Dialogue: 0,0:02:20.87,0:02:21.87,Default,,0,0,0,,نعم
Dialogue: 0,0:02:22.41,0:02:24.12,Default,,0,0,0,,قهوة ساخنة من فضلك
Dialogue: 0,0:02:24.12,0:02:25.33,Default,,0,0,0,,على الفور
Dialogue: 0,0:02:27.87,0:02:32.79,Default,,0,0,0,,{\pos(424,122)}في الحقيقة أتيت هنا بناءً على طلب يوشيمورا\Nإنه طالبٌ من كلية الطب التي أدرس بها
Dialogue: 0,0:02:28.00,0:02:32.79,Top,,0,0,0,,{\p1\pos(727,466)}m 0 0 l -29 0 l -29 12 l 0 12{\p0}
Dialogue: 0,0:02:28.00,0:02:32.79,Italic,Sign,0,0,0,,{\pos(421,584)\fs42\b1}(ويدا جوجي (٢٩\Nطبيب في مدرسة\N طوكيو الطبية
Dialogue: 0,0:02:33.04,0:02:36.30,Default,,0,0,0,,هل لا يزال يتلقى تهديدات؟
Dialogue: 0,0:02:36.30,0:02:46.47,Default,,0,0,0,,الأمر يزداد سوءاً، كان يستلم رسائل تهديدية وحسب\Nولكن مؤخراً بدأوا يتصلون به
Dialogue: 0,0:02:46.47,0:02:52.10,Default,,0,0,0,,و يقومون باللحاق به أينما ذهب\Nلذا فالأمر بدأ يصيبه بالجنون
Dialogue: 0,0:02:52.10,0:02:55.36,Default,,0,0,0,,أنا قلقٌ من أن يبدأ بارتكاب الأخطاء في عمله
Dialogue: 0,0:02:55.40,0:02:57.82,Default,,0,0,0,,هذا مزعجٌ بالفعل
Dialogue: 0,0:02:57.82,0:03:00.61,Default,,0,0,0,,لا فكرة لديه عن سبب حصول كل هذا
Dialogue: 0,0:03:00.61,0:03:05.58,Default,,0,0,0,,أرجوك اكتشف لي من هو الفاعل و لماذا يقومون بمطاردته
Dialogue: 0,0:03:06.12,0:03:09.96,Default,,0,0,0,,!فهمت، يمكنك الإعتماد عليّ أنا موري كوغورو
Dialogue: 0,0:03:09.96,0:03:17.09,Default,,0,0,0,,ولكن أولاً يجب أن نحصل على معلومات من الضحية\Nالسيد يوشيمورا بنفسه
Dialogue: 0,0:03:17.09,0:03:22.38,Default,,0,0,0,,إذاً.. سأتصل مع يوشيمورا لأرى إن كان بالمنزل
Dialogue: 0,0:03:26.01,0:03:26.81,Default,,0,0,0,,مرحباً
Dialogue: 0,0:03:26.81,0:03:28.52,Default,,0,0,0,,يوشيمورا، إنه أنا
Dialogue: 0,0:03:35.27,0:03:38.32,Default,,0,0,0,,يوشيمورا في المنزل، سآخذك إلى هناك
Dialogue: 0,0:03:48.12,0:03:53.21,Default,,0,0,0,,هذه هي شقته، سيد موري\Nيعيش يوشيمورا في زاوية الطابق الخامس
Dialogue: 0,0:03:54.25,0:03:55.46,Default,,0,0,0,,إذاً، لنصعد
Dialogue: 0,0:03:58.84,0:04:00.17,Default,,0,0,0,,ما هذا الصوت؟
Dialogue: 0,0:04:00.51,0:04:01.63,Default,,0,0,0,,من هنا
Dialogue: 0,0:04:01.63,0:04:02.80,Default,,0,0,0,,!كونان
Dialogue: 0,0:04:09.77,0:04:11.81,Default,,0,0,0,,ماذا جرى؟
Dialogue: 0,0:04:11.81,0:04:12.85,Default,,0,0,0,,!هذا
Dialogue: 0,0:04:12.85,0:04:14.48,Default,,0,0,0,,!عمي! إتصل بالإسعاف
Dialogue: 0,0:04:16.40,0:04:17.23,Default,,0,0,0,,!يوشيمورا
Dialogue: 0,0:04:17.23,0:04:18.15,Default,,0,0,0,,ماذا قلت!؟
Dialogue: 0,0:04:19.44,0:04:21.15,Default,,0,0,0,,{\pos(412,74)}!إنه يوشيمورا
Dialogue: 0,0:04:19.86,0:04:24.40,Top,,0,0,0,,{\p1\pos(713,456)\c&H7A2124&}m 0 0 l -29 0 l -29 12 l 0 12{\p0}
Dialogue: 0,0:04:19.86,0:04:24.40,Italic,Sign,0,0,0,,{\fs42\b1\pos(406,578)}﻿(يوشيمورا ميتسو (٢٥\Nطبيب في مدرسة\N طوكيو الطبية
Dialogue: 0,0:04:21.15,0:04:22.86,Default,,0,0,0,,!إنه يوشيمورا ميتسو
Dialogue: 0,0:04:27.03,0:04:33.46,Default,,0,0,0,,!يوشيمورا! يوشيمورا! تماسك! يوشيمورا! يوشيمورا
Dialogue: 0,0:04:41.09,0:04:42.42,Default,,0,0,0,,ما هذا بحق!؟
Dialogue: 0,0:04:50.85,0:04:57.35,Default,,0,0,0,,الضحية هو السيد يوشيمورا ميتسو، ٢٥ عاماً \Nيعمل طبيباً في مدرسة الطب
Dialogue: 0,0:04:58.31,0:05:01.40,Default,,0,0,0,,وجدنا مفتاح شقته في إحدى جيوبه
Dialogue: 0,0:05:01.78,0:05:07.61,Default,,0,0,0,,إذاً موري-كن، أتيت هنا لرؤية السيد يوشيمورا\Nبناءً على طلبه و شهدت الحادثة؟
Dialogue: 0,0:05:07.61,0:05:15.79,Default,,0,0,0,,نعم،  وفقاً لصديقه السيد ويدا\Nكان هناك أحدٌ يتعقبه و يقوم بتهديده
Dialogue: 0,0:05:16.54,0:05:22.00,Default,,0,0,0,,منزل السيد يوشيمورا في زاوية الطابق الخامس في هذا البناء
Dialogue: 0,0:05:22.30,0:05:31.56,Default,,0,0,0,,لقد سقط من شقته إذاً.. لنذهب إلى شقته، قد نكتشف لِمَ سقط
Dialogue: 0,0:05:33.06,0:05:36.35,Default,,0,0,0,,أعلم أنه عملك أنت، ولكن شكراً على مساعدتك
Dialogue: 0,0:05:37.56,0:05:40.86,Top,,0,0,0,,{\p1\pos(729,462)}m 0 0 l -29 0 l -29 12 l 0 12{\p0}
Dialogue: 0,0:05:37.56,0:05:40.86,Default,,0,0,0,,لا مشكلة، هذه الحالة تتطلب الإنتباه
Dialogue: 0,0:05:37.56,0:05:40.86,Italic,Sign,0,0,0,,{\pos(427,556)}(هارا ريوجي (٥٦\Nمدير البناء
Dialogue: 0,0:05:41.57,0:05:43.28,Default,,0,0,0,,..ولكن هل حقاً أن السيد يوشيمورا
Dialogue: 0,0:05:56.66,0:05:59.38,Default,,0,0,0,,ماذا؟ ليس هناك أحدٌ مجدداً؟
Dialogue: 0,0:06:00.13,0:06:04.76,Default,,0,0,0,,يتوقف المصعد عند كل طابقٍ في الليل لأسبابٍ أمنية
Dialogue: 0,0:06:04.76,0:06:08.63,Default,,0,0,0,,فهمت، ولكن هذا مزعجٌ قليلاً لأننا على عجلة من أمرنا
Dialogue: 0,0:06:09.47,0:06:16.35,Default,,0,0,0,,لهذا السبب استعمل السيد يوشيمورا سلالم الطوارئ\Nفي المخزن القريب للبناء عندما كان على عجلة أيضاً
Dialogue: 0,0:06:16.81,0:06:18.98,Default,,0,0,0,,سلالم المخزن المجاور؟
Dialogue: 0,0:06:18.98,0:06:20.02,Default,,0,0,0,,هذا صحيح
Dialogue: 0,0:06:20.69,0:06:26.19,Default,,0,0,0,,المسافة التي بين شرفته و المبنى المجاور يمكن قطعها عبر قفزةٍ فقط
Dialogue: 0,0:06:27.07,0:06:29.61,Default,,0,0,0,,..حذرته مراراً أن لا يفعل هذا ولكن
Dialogue: 0,0:06:32.66,0:06:33.70,Default,,0,0,0,,هذا الطابق الخامس
Dialogue: 0,0:06:37.54,0:06:41.13,Default,,0,0,0,,سيدي المفتش، هل يمكنني تغيير ملابسي أولاً؟
Dialogue: 0,0:06:41.50,0:06:45.17,Default,,0,0,0,,شقتي في الطابق الذي فوقنا لو احتجتني
Dialogue: 0,0:06:45.17,0:06:49.59,Default,,0,0,0,,لا مانع، حالما تنتهي من هذا قم بالمجيء إلى شقة السيد يوشيمورا من فضلك
Dialogue: 0,0:06:50.09,0:06:51.84,Default,,0,0,0,,حسناً، عُلِم
Dialogue: 0,0:06:53.35,0:06:55.81,Default,Sign,0,0,0,,{\pos(440.739,517.4)\frz2.563}يوشيمورا
Dialogue: 0,0:07:13.28,0:07:16.74,Default,,0,0,0,,مع أننا دخلنا شهر أيار، إلا أن الطقس لا يزال بارداً
Dialogue: 0,0:07:16.74,0:07:18.04,Default,,0,0,0,,بالفعل
Dialogue: 0,0:07:20.54,0:07:22.12,Default,,0,0,0,,بعض الشراب
Dialogue: 0,0:07:22.42,0:07:24.59,Default,,0,0,0,,يبدو أنه كان يشرب لوحده
Dialogue: 0,0:07:24.96,0:07:30.30,Default,,0,0,0,,يبدو أنه لم يكن يشعر بالأمان إلا في منزله و في العمل
Dialogue: 0,0:07:30.92,0:07:39.31,Default,,0,0,0,,على ذكرك هذا، كان هناك مؤخراً بعض الرجال الغريبين\Nالذين يقومون باللحاق بالسيد يوشيمورا بوقتٍ متأخر من الليل
Dialogue: 0,0:07:39.31,0:07:44.73,Default,,0,0,0,,السيد ويدا قال أنه كان يتلقى مكالمات تهديدية على الهاتف\Nو تحذيراتٍ في ساعاتٍ عشوائية من النهار
Dialogue: 0,0:07:48.94,0:07:49.82,Default,,0,0,0,,..هذا
Dialogue: 0,0:07:54.16,0:07:57.87,Default,,0,0,0,,هل هذه هي الشرفة التي استعملها السيد يوشيمورا للمجيء و الذهاب؟
Dialogue: 0,0:07:57.87,0:08:05.79,Default,,0,0,0,,نعم، كان السيد يوشيمورا دائماً يترك صندله الأيسر هنا\N..عندما يذهب، لقد حذرته كثيراً من قبل ولكن
Dialogue: 0,0:08:06.42,0:08:14.59,Default,,0,0,0,,مفتش، الشقة كانت مقفلة، و المفتاح كان في جيب الضحية
Dialogue: 0,0:08:15.01,0:08:18.76,Default,,0,0,0,,الأضواء لم تكن مطفئة و ليس هناك أي آثار للمقاومة بكل وضوح
Dialogue: 0,0:08:19.35,0:08:24.94,Default,,0,0,0,,بالأخذ بجميع هذه المعطيات فليس هناك شك أن وفاته كانت مجرد حادثة
Dialogue: 0,0:08:24.94,0:08:26.98,Default,,0,0,0,,حتى الآن تبدو نظريتك صحيحة
Dialogue: 0,0:08:29.65,0:08:30.65,Default,,0,0,0,,!صندل
Dialogue: 0,0:08:31.44,0:08:34.15,Default,,0,0,0,,كيف وصل إلى هناك
Dialogue: 0,0:08:34.15,0:08:35.57,Default,,0,0,0,,..ولكن
Dialogue: 0,0:08:35.57,0:08:36.57,Default,,0,0,0,,!انتظر
Dialogue: 0,0:08:47.92,0:08:50.75,Default,,0,0,0,,..إذا لم يكن السطح، فهاذا يعني
Dialogue: 0,0:08:51.51,0:08:55.22,Default,,0,0,0,,هكذا إذاً، عفواً على إزعاجكِ
Dialogue: 0,0:08:58.35,0:09:00.43,Default,,0,0,0,,..لقد كان مقلباً بالفعل
Dialogue: 0,0:09:03.39,0:09:05.31,Default,Sign,0,0,0,,{\pos(399.074,430.3)\frz351.3}ويدا
Dialogue: 0,0:09:08.48,0:09:10.77,Default,,0,0,0,,ماذا! الجرس لا يعمل
Dialogue: 0,0:09:11.11,0:09:13.69,Default,,0,0,0,,سيد ويدا؟ سيد ويدا؟
Dialogue: 0,0:09:13.69,0:09:14.61,Default,,0,0,0,,أتيت
Dialogue: 0,0:09:16.61,0:09:20.91,Default,,0,0,0,,المعذرة سيد ويدا، أنا عطشٌ كثيراً، هل يمكنني شرب كأسٍ من الماء؟
Dialogue: 0,0:09:21.54,0:09:22.33,Default,,0,0,0,,حسناً
Dialogue: 0,0:09:25.00,0:09:26.83,Default,,0,0,0,,ادخل، هيا
Dialogue: 0,0:09:26.83,0:09:28.00,Default,,0,0,0,,شكراً
Dialogue: 0,0:09:30.92,0:09:32.84,Default,,0,0,0,,انتظر هنا سأعود على الفور
Dialogue: 0,0:09:32.84,0:09:33.92,Default,,0,0,0,,حاضر
Dialogue: 0,0:09:38.80,0:09:42.60,Default,,0,0,0,,يا سيد ويدا، قبل قليل كان هناك عامل توصيل زهور في الخارج
Dialogue: 0,0:09:42.85,0:09:45.35,Default,,0,0,0,,نعم، لقد كان الأمر مقلباً ما
Dialogue: 0,0:09:59.70,0:10:01.12,Default,,0,0,0,,ماذا هناك يا فتى؟
Dialogue: 0,0:10:01.62,0:10:04.75,Default,,0,0,0,,لا يجب أن تصعد إلى هناك إنه خطير، هيا إنزل
Dialogue: 0,0:10:04.75,0:10:06.00,Default,,0,0,0,,حاضر
Dialogue: 0,0:10:11.96,0:10:13.46,Default,,0,0,0,,خذ، عصير
Dialogue: 0,0:10:14.67,0:10:15.84,Default,,0,0,0,,شكراً لك
Dialogue: 0,0:10:15.84,0:10:18.72,Default,,0,0,0,,سنذهب و ننضم إلى السيد موري حين تنتهي
Dialogue: 0,0:10:18.72,0:10:19.72,Default,,0,0,0,,حسناً
Dialogue: 0,0:10:21.01,0:10:24.14,Default,,0,0,0,,سيد ويدا هل تشعر بالحرارة؟ أنت تتعرق
Dialogue: 0,0:10:25.93,0:10:28.10,Default,,0,0,0,,أنا أتعرق بسرعة عادةً
Dialogue: 0,0:10:29.60,0:10:32.48,Default,,0,0,0,,سأذهب للحمام قليلاً، أنهي ذلك العصير حسناً؟
Dialogue: 0,0:10:32.48,0:10:33.40,Default,,0,0,0,,حاضر
Dialogue: 0,0:10:40.03,0:10:41.70,Default,,0,0,0,,ما ذلك الأثر؟
Dialogue: 0,0:10:45.12,0:10:46.24,Default,,0,0,0,,..هذا
Dialogue: 0,0:10:48.96,0:10:49.92,Default,,0,0,0,,هناك المزيد
Dialogue: 0,0:10:50.79,0:10:51.96,Default,,0,0,0,,و هناك
Dialogue: 0,0:10:52.83,0:10:56.17,Default,,0,0,0,,فوق السرير، الطاولة و الأريكة أيضاً
Dialogue: 0,0:11:06.52,0:11:09.27,Default,,0,0,0,,فهمت، هكذا حصل إذاً
Dialogue: 0,0:11:15.40,0:11:17.65,Default,,0,0,0,,ما الذي تقوم به؟
Dialogue: 0,0:11:17.65,0:11:21.74,Default,,0,0,0,,نسيت شيئاً في الغرفة الاخرى، سأذهب لإحضاره بسرعة
Dialogue: 0,0:11:22.28,0:11:23.32,Default,,0,0,0,,..تباً
Dialogue: 0,0:11:32.12,0:11:37.21,Default,,0,0,0,,توقف! لا يجب أن تفعل هذا! لا نزال نحلل مسرح الجريمة
Dialogue: 0,0:11:37.50,0:11:43.26,Default,,0,0,0,,آسف، في الحقيقة أرسلني عمي موري كي أنقل لك رسالته
Dialogue: 0,0:11:43.26,0:11:44.55,Default,,0,0,0,,من السيد موري؟
Dialogue: 0,0:11:44.55,0:11:45.10,Default,,0,0,0,,..قال لك
Dialogue: 0,0:11:48.81,0:11:49.89,Default,,0,0,0,,فهمت
Dialogue: 0,0:11:50.48,0:11:54.02,Default,,0,0,0,,سأذهب إلى هناك حالاً، فقط لا تقم بلمس أي شيء حسناً؟
Dialogue: 0,0:11:54.02,0:11:55.15,Default,,0,0,0,,حاضر
Dialogue: 0,0:11:58.73,0:12:00.94,Default,Sign,0,0,0,,{\frz353.6\frx20\fry350\pos(455.06,219.7)}لا رسائل جديدة
Dialogue: 0,0:12:01.61,0:12:04.20,Default,,0,0,0,,كما توقعت، لا شك بهذا
Dialogue: 0,0:12:05.91,0:12:09.49,Default,,0,0,0,,!وفاة السيد يوشيمورا ليست حادثة، بل قُتِل
Dialogue: 0,0:12:14.42,0:12:18.55,Default,,0,0,0,,للأسف ولكن كما قال موري-كن، هذه الوفاة كانت عرضية
Dialogue: 0,0:12:19.17,0:12:24.80,Default,,0,0,0,,لسببٍ ما قد زلت قدمه عندما كان يريد القفز من الشرفة إلى المخزن
Dialogue: 0,0:12:24.80,0:12:28.39,Default,,0,0,0,,يا لسوء الحظ، حصل ذلك بعدما أتينا بك إلى هنا
Dialogue: 0,0:12:28.72,0:12:33.14,Default,,0,0,0,,سيد ويدا، لقد قمت بالإتصال به كي تخبره بأننا قادمون صحيح؟
Dialogue: 0,0:12:33.77,0:12:36.52,Default,,0,0,0,,إذاً لماذا برأيك كان يريد الخروج؟
Dialogue: 0,0:12:38.02,0:12:40.19,Default,,0,0,0,,لا تزعج الكبار
Dialogue: 0,0:12:40.19,0:12:42.32,Default,,0,0,0,,إذهب للخارج إن كنت ستواصل إزعاجنا
Dialogue: 0,0:12:42.32,0:12:43.74,Default,,0,0,0,,حاضر
Dialogue: 0,0:12:45.20,0:12:46.32,Default,,0,0,0,,لا خيار آخر
Dialogue: 0,0:12:46.32,0:12:48.12,Default,,0,0,0,,لا يمكنني فعل شيء إلا أن أقوم بتنويمه
Dialogue: 0,0:12:53.12,0:12:55.42,Default,,0,0,0,,ما الخطب موري-كن؟
Dialogue: 0,0:12:55.42,0:12:59.42,Default,,0,0,0,,حضرة المفتش، من المبكر جداً مغادرة المكان
Dialogue: 0,0:12:59.42,0:13:00.13,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:13:00.13,0:13:04.63,Default,,0,0,0,,هناك العديد من التفاصيل المشبوهة التي يجب أن نفهمها\Nقبل أن نغلق هذه القضية على أنها وفاة عرضية
Dialogue: 0,0:13:04.93,0:13:13.39,Default,,0,0,0,,شقة السيد يوشيمورا كانت مغلقة، ولكن سلسلسة القفل لم تكن مركّبة
Dialogue: 0,0:13:13.39,0:13:17.10,Default,,0,0,0,,ألا تظن أن هذا غريب بالنسبة لشخص يتعرض للتهديد المتواصل؟
Dialogue: 0,0:13:17.65,0:13:18.73,Default,,0,0,0,,فهمت
Dialogue: 0,0:13:18.73,0:13:23.69,Default,,0,0,0,,و أيضاً، بما أنه كان يقوم بالشرب قبل أن يسقط
Dialogue: 0,0:13:23.69,0:13:27.95,Default,,0,0,0,,ألا تعتقد أنه من الغريب ذوبان الثلج بهذه السرعة؟
Dialogue: 0,0:13:28.82,0:13:31.54,Default,,0,0,0,,موري-كن، ما الذي تحاول أن تقول؟
Dialogue: 0,0:13:31.99,0:13:37.08,Default,,0,0,0,,ببساطة أن السيد يوشيمورا لم يكن في شقته حين سقط
Dialogue: 0,0:13:37.37,0:13:40.59,Default,,0,0,0,,هذا هراء، إذاً من أين سقط؟
Dialogue: 0,0:13:40.88,0:13:43.92,Default,,0,0,0,,صندل السيد يوشيمورا هو الجواب
Dialogue: 0,0:13:44.42,0:13:46.22,Default,,0,0,0,,صندله؟
Dialogue: 0,0:13:46.22,0:13:52.31,Default,,0,0,0,,الضحية كان يرتدي صندلاً في قدمه اليسرى\Nولكن لم يكن يرتدي في قدمه اليمنى
Dialogue: 0,0:13:52.81,0:13:58.27,Default,,0,0,0,,الصندل المفقود تم رميه بعيداً إلى سطح المخزن المجاور للبناء
Dialogue: 0,0:13:58.60,0:14:03.28,Default,,0,0,0,,حتى لو أنه فقد توازنه على سلالم الطوارئ مثلاً
Dialogue: 0,0:14:03.28,0:14:04.03,Default,Sign,0,0,0,,{\fs45.5\pos(301.422,330.2)}صندل
Dialogue: 1,0:14:03.73,0:14:10.32,Default,,0,0,0,,{\pos(417,182)}أتساءل لو كان بمقدور الصندل أن يطير كل هذه المسافة\Nلابد أنه وصل هذه المسافة بسبب سقوطه من مكانٍ أعلى من الطابق الخامس
Dialogue: 0,0:14:04.03,0:14:10.37,Default,Sign,0,0,0,,{\fs45.5\move(301.422,330.2,99.606,522.6)}صندل
Dialogue: 0,0:14:10.37,0:14:11.24,Default,Sign,0,0,0,,{\fs45.5\pos(99.606,522.6)}صندل
Dialogue: 0,0:14:11.78,0:14:14.12,Default,,0,0,0,,المكان المفترض هو السطح
Dialogue: 0,0:14:15.12,0:14:19.25,Default,,0,0,0,,ولكن باب السطح مقفل
Dialogue: 0,0:14:19.71,0:14:22.09,Default,,0,0,0,,..ماذا؟ إذاً هذا يعني
Dialogue: 0,0:14:22.38,0:14:26.92,Default,,0,0,0,,هناك مكانٌ واحدٌ فقط يمكنه السقوط منه إلى جانب السطح
Dialogue: 0,0:14:26.92,0:14:28.30,Default,,0,0,0,,..ولكن هذا يعني
Dialogue: 0,0:14:28.88,0:14:37.27,Default,,0,0,0,,تماماً أيها المفتش، السيد يوشيمورا لم يسقط من شقته\Nبل من الشقة التي في الطابق السادس
Dialogue: 0,0:14:37.93,0:14:42.36,Default,,0,0,0,,سيد ويدا، كانت هذه فعلتك أليس كذلك؟
Dialogue: 0,0:14:44.23,0:14:45.73,Default,,0,0,0,,ما هذا الهراء؟
Dialogue: 0,0:14:46.11,0:14:49.40,Default,,0,0,0,,تشيبا، هل يمكنك مساعدتي ببعض الأمور؟
Dialogue: 0,0:14:49.40,0:14:50.20,Default,,0,0,0,,حسناً
Dialogue: 0,0:14:50.57,0:14:53.87,Default,,0,0,0,,أولاً قم بتحريك التلفاز لزاوية الغرفة من فضلك
Dialogue: 0,0:14:53.87,0:14:54.62,Default,,0,0,0,,حسناً
Dialogue: 0,0:14:56.70,0:14:58.29,Default,,0,0,0,,هل هذا جيد؟
Dialogue: 0,0:14:58.58,0:14:59.92,Default,,0,0,0,,جيد
Dialogue: 0,0:14:59.92,0:15:04.25,Default,,0,0,0,,ثانياً، قم بتحريك الطاولة لمنتصف الغرفة و ضع الكراسي على جانبيها
Dialogue: 0,0:15:04.79,0:15:08.21,Default,,0,0,0,,و أخيراً قم بنقل السرير إلى جانب الحائط
Dialogue: 0,0:15:08.21,0:15:12.09,Default,,0,0,0,,انتظر قليلاً موري-كن، السرير ثقيلٌ جداً على أن يتم تحريكه
Dialogue: 0,0:15:12.09,0:15:14.22,Default,,0,0,0,,حسناً انتظر قليلاً و سترى
Dialogue: 0,0:15:16.77,0:15:19.68,Default,,0,0,0,,يحوي هذا السرير على عجلات لذا من السهل تحريكه
Dialogue: 0,0:15:19.98,0:15:26.44,Default,,0,0,0,,و الآن أيها المفتش، ألا تبدو هذه الغرفة مشابهةٌ لغرفةٍ اخرى في مكانٍ ما؟
Dialogue: 0,0:15:31.66,0:15:35.78,Default,,0,0,0,,ترتيب الأثاث ييدو مشابهاً للذي في غرفة السيد يوشيمورا
Dialogue: 0,0:15:35.78,0:15:45.59,Default,,0,0,0,,قام السيد ويدا بترتيب هذه الشقة من قبل، كي يخدع\Nالسيد يوشيمورا أن يظن بأنها شقته هو
Dialogue: 0,0:15:45.92,0:15:48.42,Default,,0,0,0,,ولكن موري-كن، الأثاث ليس مطابقاً لأثاثه
Dialogue: 0,0:15:48.76,0:15:55.85,Default,,0,0,0,,صحيح و لكن إن استيقظ في الظلام، لن يلاحظ\Nأنه كان نائماً في شقة أحدٍ ما غيره
Dialogue: 0,0:15:55.85,0:16:01.43,Default,,0,0,0,,هكذا قمت بجعل السيد يوشيمورا يقفز من النافذة، و يموت بعدها
Dialogue: 0,0:16:01.73,0:16:08.86,Default,,0,0,0,,أرجوك انتظر قليلاً! عندما سقط يوشيمورا\Nكنت أنا تماماً إلى جانبك أليس هذا سيد موري؟
Dialogue: 0,0:16:08.86,0:16:14.32,Default,,0,0,0,,هذا صحيح، قمت باستعمالي لأكون دليل براءتك
Dialogue: 0,0:16:16.07,0:16:22.25,Default,,0,0,0,,ولكن اشرح لي أرجوك، كيف من الممكن لي أن أجعل يوشيمورا\Nيسقط في حين أني كنت واقفاً معك؟
Dialogue: 0,0:16:22.83,0:16:30.30,Default,,0,0,0,,قمت باستعمال عادة السيد يوشيمورا باستعمال سُلُّم الطوارئ\Nالخاص بالمخزن المجاور للبناء كي تجعل هذه الخدعة تنجح
Dialogue: 0,0:16:31.84,0:16:36.51,Default,,0,0,0,,على الأغلب أنك كنت تحتسي الشراب مع السيد يوشيمورا في شقته
Dialogue: 0,0:16:36.51,0:16:49.19,Default,,0,0,0,,ثم انتظرته حتى نام، قمت بحمله إلى هنا ثم وضعته على السرير
Dialogue: 0,0:16:52.44,0:16:59.28,Default,,0,0,0,,قمت بجعل المغدور السيد يوشيمورا يظن بأنه كان نائماً في شقته الخاصة
Dialogue: 0,0:16:59.28,0:17:02.79,Default,,0,0,0,,ثم و بينما كنت معنا في ذلك المقهى
Dialogue: 0,0:17:02.79,0:17:08.04,Default,,0,0,0,,اتصلت به و قلت له "الرجل الذي يقوم بتهديدك قادمٌ إليك الآن" و طلبت منه الهرب
Dialogue: 0,0:17:08.42,0:17:10.92,Default,,0,0,0,,و أيضاً، كان معك مساعد
Dialogue: 0,0:17:11.34,0:17:13.30,Default,,0,0,0,,هل تقول أن لديه شركاء؟
Dialogue: 0,0:17:13.30,0:17:18.85,Default,,0,0,0,,مفتش ميغوري، لدى هذا الرجل شيءٌ مهمٌ كي يدلي به
Dialogue: 0,0:17:18.85,0:17:20.72,Default,,0,0,0,,أنا يوميموتو، عامل أزهار
Dialogue: 0,0:17:21.10,0:17:28.73,Default,,0,0,0,,مفتش ميغوري، هذا هو الشريك الذي ساعده بالخدعة دون أن يدرك هذا
Dialogue: 0,0:17:29.15,0:17:35.65,Default,,0,0,0,,سيد يوميموتو، هل تمانع إخبارنا ماذا حصل معك بالضبط الليلة؟
Dialogue: 0,0:17:36.03,0:17:45.91,Default,,0,0,0,,حسناً، تلقيت مكالمةً لتوصيل الأزهار إلى شقة\Nالسيد ويدا عند السابعة مساءً
Dialogue: 0,0:17:46.16,0:17:47.54,Default,,0,0,0,,إلى هذه الشقة؟
Dialogue: 0,0:17:47.96,0:17:48.88,Default,,0,0,0,,نعم
Dialogue: 0,0:17:48.88,0:17:59.01,Default,,0,0,0,,عندما أتيت في السابعة مساءً، طرقت على الباب مراراً\Nلأنه تم إعلامي بأن الجرس معطل ولا يعمل
Dialogue: 0,0:17:59.01,0:18:01.22,Default,,0,0,0,,ولكن لم يجبني أحد
Dialogue: 0,0:18:01.22,0:18:04.22,Default,,0,0,0,,هل يمكنك إخبارنا ماذا فعلت بعدها؟
Dialogue: 0,0:18:04.43,0:18:14.53,Default,,0,0,0,,حسناً عدت إلى هنا بعد انتهائي من باقي طلبات التوصيل\Nو فتح لي الباب ذلك الرجل و أخبرني بأنه لم يطلب شيء
Dialogue: 0,0:18:15.82,0:18:19.57,Default,,0,0,0,,مفتش ميغوري، هل فهمت ما حصل الآن؟
Dialogue: 0,0:18:19.57,0:18:27.25,Default,,0,0,0,,عندما طرق الباب عامل التوصيل، ملأ الإتصال الهاتفي\Nالسيد يوشيمورا بالرعب
Dialogue: 0,0:18:27.25,0:18:35.55,Default,,0,0,0,,لأنه جعله يظن بأنه هو الرجل الذي كان يهدده\Nفحاول السيد يوشيمورا القفز كعادته إلى المخزن المجاور
Dialogue: 0,0:18:36.92,0:18:41.01,Default,,0,0,0,,ولكن للأسف كان في الطابق السادس ولم يتمكن من الوصول
Dialogue: 0,0:18:44.89,0:18:46.77,Default,,0,0,0,,و سقط مباشرةً على الأرض
Dialogue: 0,0:18:47.31,0:18:50.77,Default,,0,0,0,,!هذا هراء! كل هذا محض صناعة خيالك
Dialogue: 0,0:18:51.10,0:19:00.03,Default,,0,0,0,,السبب الذي دفعك لإمساك جثة السيد يوشيمورا كان لخلق\Nعذرٍ كي تتمكن من العودة لشقتك و تعيد الأثاث إلى مكانه
Dialogue: 0,0:19:00.70,0:19:03.95,Default,,0,0,0,,عبر أن تقول بأنك تريد تبديل ملابسك الملطخة بالدماء
Dialogue: 0,0:19:04.41,0:19:11.96,Default,,0,0,0,,و سبب رؤية كونان لك و أنت تتعرق في شقتك\Nكان لأنك كنت قد انتهيت للتو من تحريك الأثاث لمكانه
Dialogue: 0,0:19:13.13,0:19:15.80,Default,,0,0,0,,هذا غير صحيح! هل لديك دليل!؟
Dialogue: 0,0:19:15.80,0:19:19.09,Default,,0,0,0,,..دليل..؟ بالطبع
Dialogue: 0,0:19:19.80,0:19:24.51,Default,,0,0,0,,عندما كنا في المقهى قلت لنا أنك لا تدخن
Dialogue: 0,0:19:25.26,0:19:28.47,Default,,0,0,0,,ولكن يوجد هنا سجائر و منفضة في هذه الغرفة
Dialogue: 0,0:19:29.52,0:19:31.69,Default,,0,0,0,,السيد يوشيمورا كان مدخناً
Dialogue: 0,0:19:31.69,0:19:39.86,Default,,0,0,0,,لو أنه استيقظ باكراً و أراد أن يدخن، لن تريد منه\Nأن يشعر بأنه ليس فعلياً في شقته
Dialogue: 0,0:19:39.86,0:19:43.82,Default,,0,0,0,,و لهذا السبب أحضرت المنفضة من شقة السيد يوشيمورا
Dialogue: 0,0:19:44.62,0:19:50.50,Default,,0,0,0,,!أحضرتها يوشيمورا بنفسه حين أتى لزيارتي، هذا لا يثبت شيء
Dialogue: 0,0:19:50.79,0:19:55.25,Default,,0,0,0,,أيها المفتش، من فضلك قم بتفقد آخر مكالمة في هاتفه
Dialogue: 0,0:19:56.38,0:19:58.25,Default,,0,0,0,,..لنرى
Dialogue: 0,0:19:59.21,0:20:01.47,Default,,0,0,0,,كان هناك مكالمةٌ في السابعة مساءً
Dialogue: 0,0:20:02.76,0:20:06.30,Default,,0,0,0,,موري-كن، هذه المكالمة أتت من جهازٍ خليوي
Dialogue: 0,0:20:06.35,0:20:12.81,Default,,0,0,0,,على الأغلب أنه رقم السيد ويدا حين قام بالإتصال به في المقهى
Dialogue: 0,0:20:13.73,0:20:14.85,Default,,0,0,0,,فهمت
Dialogue: 0,0:20:14.85,0:20:19.90,Default,,0,0,0,,انتظر قليلاً! في ذلك الوقت قمت بطلب رقمي بالخطأ عوضاً عن رقمه
Dialogue: 0,0:20:20.11,0:20:26.49,Default,,0,0,0,,إذاً لماذا ليس هناك سجل للمكالمة في هاتف السيد يوشيمورا؟
Dialogue: 0,0:20:28.16,0:20:33.62,Default,,0,0,0,,كيف قمت بالتأكد أن السيد يوشيمورا في منزله حينها إذاً؟
Dialogue: 0,0:20:34.17,0:20:41.88,Default,,0,0,0,,لابد أنك ظننت أننا لن نشك بك لأنك كنت معنا أليس كذلك؟
Dialogue: 0,0:20:41.88,0:20:45.84,Default,,0,0,0,,لهذا السبب لم تقم بالتحقق من سجل هاتفك على الأرجح
Dialogue: 0,0:20:46.26,0:20:48.60,Default,,0,0,0,,هل هذا صحيح سيد ويدا؟
Dialogue: 0,0:20:51.72,0:20:56.19,Default,,0,0,0,,في الحقيقة لقد تورطت بكثيرٍ من الديون حتى أصبحت بحاجةٍ للمال
Dialogue: 0,0:20:56.19,0:21:05.66,Default,,0,0,0,,عقد يوشيمورا صفقةً معي لم أستطع رفضها\Nالخطة كانت أن نسرق العقاقير من الجامعة و نقوم ببيعها
Dialogue: 0,0:21:06.61,0:21:17.79,Default,,0,0,0,,قمت بهذا و حصلت على حصتي من الأرباح، ولكن حين قلت\Nله أنني لا أريد القيام بهذا مجدداً هددني بأنه سيخبر الجميع
Dialogue: 0,0:21:18.46,0:21:23.76,Default,,0,0,0,,لذا حين أدركت أنني سأتدمر على هذا المعدل\Nاضطررت أن أتخلص منه مهما كان الثمن
Dialogue: 0,0:21:24.30,0:21:32.06,Default,,0,0,0,,و بعدها علمت أنه كان يتعرض للتهديد من شركائه\Nالسابقين، فاستعملت هذا الأمر لصالحي أثناء تنفيذ هذا
Dialogue: 0,0:23:08.78,0:23:11.49,Default,,0,0,0,,قضيةٌ اخرى تم حلها
Dialogue: 0,0:23:13.78,0:23:17.79,Default,,0,0,0,,عمي، لقد عطست منذ فترة كذلك، لابد أنك أُصبت بالزكام
Dialogue: 0,0:23:17.79,0:23:20.87,Default,,0,0,0,,كلا لقد كان هناك شيئاً ما في أنفي جعله يحتك و تسبب بعطاسي
Dialogue: 0,0:23:20.87,0:23:25.09,Default,,0,0,0,,من الأفضل أن لا تصاب أنت بالزكام و تسبب المشاكل لنا
Dialogue: 0,0:23:26.05,0:23:27.38,Default,,0,0,0,,..انظروا من الذي يتكلم
Dialogue: 0,0:23:27.84,0:23:30.59,Default,,0,0,0,,بالمناسبة يا كونان، سوف ترافقني غداً كذلك
Dialogue: 0,0:23:30.59,0:23:32.55,Default,,0,0,0,,هل لديك عملٌ آخر غداً؟
Dialogue: 0,0:23:32.55,0:23:40.52,Default,,0,0,0,,سباق الأحصنة! عندما تكون معي أصبح محظوظاً\N!لذا سأقوم باختيار الحصان ذو الجائزة الكبرى
Dialogue: 0,0:23:41.44,0:23:44.06,Default,,0,0,0,,..من المستحيل أن تفوز بشيءٍ كهذا معي
Dialogue: 0,0:23:45.30,0:24:09.55,Top Italic,,0,0,0,,{\pos(169,94)}الحلقة القادمة
Dialogue: 0,0:23:48.38,0:23:48.80,Default,,0,0,0,,غريب
Dialogue: 0,0:23:49.87,0:23:52.84,Default,,0,0,0,,لماذا.. جسمه بتلك الوضعية الغريبة
Dialogue: 0,0:23:53.95,0:23:54.89,Default,,0,0,0,,انظر هنا قليلاً
Dialogue: 0,0:23:55.55,0:23:58.79,Default,,0,0,0,,زجاجات النبيذ على الرف الأول من هذا الجانب قد تضررت
Dialogue: 0,0:23:59.98,0:24:02.15,Default,,0,0,0,,ولكن الزجاجات على هذا الجانب لم يحدث لها شيء
Dialogue: 0,0:24:03.56,0:24:05.78,Default,,0,0,0,,لقد وجدته.. الدليل القوي
Dialogue: 0,0:24:06.82,0:24:08.98,Default,,0,0,0,,!و القاتل ما زال محتفظاً به  إلى الآن
Dialogue: 0,0:24:09.57,0:24:15.38,Alternative,,0,0,0,,{\pos(439,196)\c&HF3FEEE&\fs85}قبو النبيذ المقفول
