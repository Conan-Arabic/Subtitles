Dialogue: 0,0:04:45.04,0:04:47.89,Default,HIRASAWA,0,0,0,,‫لكني لم أقم بقتل (واكاباياشي)
Dialogue: 0,0:04:48.20,0:04:51.64,Default,KOGORO,0,0,0,,‫إذن، لِمَ استأجرتَ ذلك الزيّ؟
Dialogue: 0,0:04:55.24,0:04:58.96,Default,HIRASAWA,0,0,0,,‫في هذا العام تحلُّ الذكرى الخامسة لهذا المطعم
Dialogue: 0,0:04:58.96,0:05:03.90,Default,HIRASAWA,0,0,0,,‫فكرتُ في استخدام زيّ الخروف الأحمر لحفل الذكرى
Dialogue: 0,0:04:59.73,0:05:03.90,FifthAnn,SIGN SIGN,0,0,0,,‫{\fad(915,1)}الذكرى الخامسة لـ"لا موتشو"
Dialogue: 0,0:05:04.27,0:05:08.58,Default,RAN,0,0,0,,‫لكن، تم استخدام ذلك الزيّ في مهرجانٍ ما منذ عشرة سنين مضت
Dialogue: 0,0:05:08.58,0:05:10.66,Default,RAN,0,0,0,,‫لِمَ عساك أن تستخدم شيئًا قديمًا لهذا الحد؟
Dialogue: 0,0:05:11.22,0:05:14.58,Default,HIRASAWA,0,0,0,,‫ذلك لأنني هو من قام بتصميم ذلك الزيّ
Dialogue: 0,0:05:14.87,0:05:15.58,Default,BOTH,0,0,0,,‫ماذا؟
Dialogue: 0,0:05:16.71,0:05:20.21,Default,MEGURE,0,0,0,,‫كنتُ أعتقد أن تخصصك الرئيسي هو التصميم المكاني
Dialogue: 0,0:05:21.03,0:05:23.99,Default,HIRASAWA,0,0,0,,‫في الماضي، فعلتُ كل شيء
Dialogue: 0,0:05:23.99,0:05:26.77,Default,HIRASAWA,0,0,0,,‫لقد كنتُ أنا من أرتدي ذلك الزيّ في السابق أيضًا
Dialogue: 0,0:05:26.77,0:05:29.68,Default,HIRASAWA,0,0,0,,‫لذا شعرتُ بأني معلقٌ بي
Dialogue: 0,0:05:29.68,0:05:32.72,Default,HIRASAWA,0,0,0,,‫لم أرد أن أنسى مقدار معاناتي في الماضي
Dialogue: 0,0:05:33.18,0:05:37.71,Default,HIRASAWA,0,0,0,,‫لكن عندما أخبرتُ (واكاباياشي) أنني أريد استخدامه في حفل الذكرى...
Dialogue: 0,0:05:37.71,0:05:39.42,Default - italic,WAKABAYASHI,0,0,0,,‫ما الذي تفكر به؟
Dialogue: 0,0:05:39.42,0:05:43.73,Default - italic,WAKABAYASHI,0,0,0,,‫هذا الزيّ السخيف لا يليق بسمعة مطعمنا!
Dialogue: 0,0:05:44.22,0:05:47.30,Default,HIRASAWA,0,0,0,,‫على غير العادة، فلقد كان معارضًا للفكرة بشدة
Dialogue: 0,0:05:47.30,0:05:49.11,Default,HIRASAWA,0,0,0,,‫لذا قمتُ مجبرًا بالتخلي عن الفكرة
Dialogue: 0,0:05:49.41,0:05:51.92,Default,KOGORO,0,0,0,,‫إذن، فلقد قتلتَ السيد (واكاباياشي) لأنك شعرتَ بالغضب نحوه بسبب ذلك؟
Dialogue: 0,0:05:51.92,0:05:52.83,Default,HIRASAWA,0,0,0,,‫مستحيل!
Dialogue: 0,0:05:53.22,0:05:55.66,Default,HIRASAWA,0,0,0,,‫أنا و (واكاباياشي) كنا شركاء
Dialogue: 0,0:05:55.66,0:05:57.62,Default,HIRASAWA,0,0,0,,‫لقد كان مهمًا جدًا كشريكٍ للعمل بالنسبة لي
Dialogue: 0,0:05:57.98,0:06:02.00,Default,CONAN,0,0,0,,‫إن كنتم شركاء، فمن المؤكد أنك تعلم كل شيء عن السيد (واكاباياشي)
Dialogue: 0,0:06:02.33,0:06:03.16,Default,KOGORO,0,0,0,,‫ماذا؟
Dialogue: 0,0:06:03.16,0:06:08.18,Default,CONAN,0,0,0,,‫رسالة التهديد التي وصلت إلى جهاز السيد (واكاباياشي) \Nكانت عند الساعة العاشرة مساءً
Dialogue: 0,0:06:08.58,0:06:11.15,Default,CONAN,0,0,0,,‫ستكون البنوك مغلقة في ذلك الحين
Dialogue: 0,0:06:11.15,0:06:14.93,Default,CONAN,0,0,0,,‫فكيف حصل على الخمسين مليون ينًا؟
Dialogue: 0,0:06:16.40,0:06:17.29,Default,MEGURE,0,0,0,,‫بعبارةٍ أخرى
Dialogue: 0,0:06:17.29,0:06:22.19,Default,MEGURE,0,0,0,,‫فإن الجاني كان يعلم بأن السيد (واكاباياشي) يستطيع\N الحصول على ذلك المبلغ من المال حالاً
Dialogue: 0,0:06:22.76,0:06:24.94,Default,HIRASAWA,0,0,0,,‫لـ-لا أملك أية فكرة عمّا تقوله
Dialogue: 0,0:06:25.18,0:06:32.70,Default,CONAN,0,0,0,,‫لكني رأيتُك متفاجئًا وموشحًا بنظرك نحو المطبخ عندما \Nسمعتَ أن مبلغ الفدية كان خمسين مليون ين
Dialogue: 0,0:06:30.97,0:06:32.13,Default,HIRASAWA,0,0,0,,‫خمسون مليونًا؟ {\an8}
Dialogue: 0,0:06:34.64,0:06:39.32,Default,CONAN,0,0,0,,‫لقد كنتَ تنظر بدون تفكير لأنك كنت تعلم أن خمسين مليون ينًا \Nكانت في المطبخ بالفعل، أليس كذلك؟
Dialogue: 0,0:06:40.82,0:06:42.85,Default,KOGORO,0,0,0,,‫خمسون مليون ينًا في المطبخ؟
Dialogue: 0,0:06:44.58,0:06:49.00,Default,TAKAGI,0,0,0,,‫أيها المفتش، هناك آثار على الأرض تشير إلى أن هذا الشيء قد تم تحريكه
Dialogue: 0,0:06:54.10,0:06:56.14,Default,KOGORO,0,0,0,,‫أيها المفتش، توجد خزنةُ مخفيةٌ هنا
Dialogue: 0,0:07:00.14,0:07:02.90,Default,TAKAGI,0,0,0,,‫لا توجد أية نقود داخلها
Dialogue: 0,0:07:03.08,0:07:05.84,Default,TAKAGI,0,0,0,,‫لكن، توجد مذكرة
Dialogue: 0,0:07:07.48,0:07:10.38,Default,TAKAGI,0,0,0,,‫يبدو أنه كتاب لحساب بنكي
Dialogue: 0,0:07:10.38,0:07:12.66,Default,MEGURE,0,0,0,,‫هل من الممكن أنه كتابٌ لحسابٍ بنكي سري؟
Dialogue: 0,0:07:14.93,0:07:16.83,Default,HIRASAWA,0,0,0,,‫أنا آسف
Dialogue: 0,0:07:16.83,0:07:22.67,Default,HIRASAWA,0,0,0,,‫في كل عام، كنا نقلل من أرباحنا المُعلنة ونخفيها على شكل نقود
Dialogue: 0,0:07:22.97,0:07:25.51,Default,MEGURE,0,0,0,,‫بعبارةٍ أخرى، تهرب ضريبي
Dialogue: 0,0:07:25.51,0:07:26.56,Default,HIRASAWA,0,0,0,,‫نعم
Dialogue: 0,0:07:26.56,0:07:30.92,Default,HIRASAWA,0,0,0,,‫لكني أنا و (واكاباياشي) الوحيدان اللذان كنا نعلم عن هذا الأمر
Dialogue: 0,0:07:31.21,0:07:36.41,Default,KOGORO,0,0,0,,‫مما يعني أنك أردت الاحتفاظ بالخمسين مليون ينًا \Nالتي كسبتموها من التهرب الضريبي لنفسك
Dialogue: 0,0:07:36.41,0:07:41.94,Default,KOGORO,0,0,0,,‫لذا قمتَ باختطاف حبيبة السيد (واكاباياشي) وهددته قائلاً بأنك الخروف الأحمر
Dialogue: 0,0:07:42.21,0:07:44.72,Default,MEGURE,0,0,0,,‫ما قولك يا سيد (هيراساوا)؟
Dialogue: 0,0:07:46.14,0:07:49.24,Default,CONAN,0,0,0,,‫لكن، إذا كان السيد (هيراساوا) هو الجاني
Dialogue: 0,0:07:49.24,0:07:52.70,Default,CONAN,0,0,0,,‫أشك في أنه كان سيستخدم اسمه الخاص عندما استأجر الزيّ
Dialogue: 0,0:07:53.23,0:07:54.11,Default,KOGORO,0,0,0,,‫ماذا؟
Dialogue: 0,0:07:54.11,0:07:58.78,Default,CONAN,0,0,0,,‫بالإضافة إلى أنه مرّت أسابيع قليلة مذ بدأ الناس التحدث عن الخروف الأحمر
Dialogue: 0,0:07:58.78,0:08:03.62,Default,CONAN,0,0,0,,‫وبما أن الزيّ تمت إعادته قبل ثلاثة أسابيع، ففارق الزمن واسعٌ بعض الشيء
Dialogue: 0,0:08:05.11,0:08:06.60,Default,KOGORO,0,0,0,,‫أنت محق
Dialogue: 0,0:08:07.62,0:08:12.47,Default,KOGORO,0,0,0,,‫مالك شركة الأزياء قال أن الزيّ تم أخذه عدة مرات بعد أن تمت إعادته
Dialogue: 0,0:08:12.74,0:08:14.27,Default,IWAMI,0,0,0,,‫في الأسابيع الماضية
Dialogue: 0,0:08:14.27,0:08:17.72,Default,IWAMI,0,0,0,,‫‫لاحظت آثارًا تدل على أنه كان يؤخذ من المتجر عدة مرات أثناء الليل
Dialogue: 0,0:08:18.03,0:08:22.31,Default,KOGORO,0,0,0,,‫ربما هناك شخصٌ ما يحاول تلفيق التهمة على السيد (هيراساوا)
Dialogue: 0,0:08:22.31,0:08:24.31,Default,HIRASAWA,0,0,0,,‫بالحديث عن ذلك...
Dialogue: 0,0:08:25.73,0:08:29.36,Default,HIRASAWA,0,0,0,,‫ألم أطلب منكما الانتباه للصندوق الذي تم وضع الزيّ فيه؟
Dialogue: 0,0:08:29.63,0:08:31.88,Default,HIRASAWA,0,0,0,,‫أخبرتكما بأن شركةً للتوصيل سوف تأتي لتأخذه
Dialogue: 0,0:08:31.88,0:08:33.43,Default,RYOTA,0,0,0,,‫ماذا؟ هذا صحيح
Dialogue: 0,0:08:33.43,0:08:35.89,Default,RYOTA,0,0,0,,‫ذلك الزيّ كان بداخل ذلك الصندوق؟
Dialogue: 0,0:08:35.89,0:08:38.62,Default,AMI,0,0,0,,‫لم تكن هناك أية طريقة لنعرف هذا الأمر
Dialogue: 0,0:08:38.62,0:08:43.28,Default,CONAN,0,0,0,,‫سيد (هيراساوا)، هل تتكذر وضعك قسيمة الشحن على الصندوق؟
Dialogue: 0,0:08:43.28,0:08:44.04,Default,HIRASAWA,0,0,0,,‫نعم
Dialogue: 0,0:08:44.19,0:08:47.79,Default,CONAN,0,0,0,,‫قسائم الشحن تحتوي على مكانٍ يُكتب فيه محتوى الصندوق
Dialogue: 0,0:08:47.79,0:08:49.42,Default,CONAN,0,0,0,,‫ما الذي كتبته هناك؟
Dialogue: 0,0:08:50.42,0:08:52.92,Default,HIRASAWA,0,0,0,,‫أعتقد أني كتبت "زيّ واحد"
Dialogue: 0,0:08:53.19,0:08:55.31,Default,RYOTA,0,0,0,,‫لـ-لا أتذكر هذا
Dialogue: 0,0:08:55.31,0:08:57.18,Default,AMI,0,0,0,,‫لم أرَ شيئًا كهذا
Dialogue: 0,0:08:57.56,0:09:01.81,Default,KOGORO,0,0,0,,‫غرفة التخزين التي تخزن فيها الأزياء قديمة, والباب ليس مقفلاً حتى
Dialogue: 0,0:09:01.81,0:09:04.81,Default,KOGORO,0,0,0,,‫سيكون من السهل عليكما أخذ زيّ من هناك إن أردتما
Dialogue: 0,0:09:04.98,0:09:09.82,Default,RYOTA,0,0,0,,‫لكن، من أين لنا أن نعلم أن قفل غرفة التخزين تلك كانت مكسورة
Dialogue: 0,0:09:10.02,0:09:11.43,Default,CONAN,0,0,0,,‫ماذا؟
Dialogue: 0,0:09:11.43,0:09:14.58,Default,CONAN,0,0,0,,‫ما قاله عمي هو أن باب الغرفة ليس مقفلاً
Dialogue: 0,0:09:14.58,0:09:17.07,Default,CONAN,0,0,0,,‫لم يقل أبدًا أنه كان مكسورًا
Dialogue: 0,0:09:19.15,0:09:20.95,Default,KOGORO,0,0,0,,‫الطفل على حق
Dialogue: 0,0:09:21.40,0:09:24.62,Default,KOGORO,0,0,0,,‫هناك قفل على باب غرفة التخزين
Dialogue: 0,0:09:24.62,0:09:26.25,Default,KOGORO,0,0,0,,‫لكنه فُتِح بسهولة
Dialogue: 0,0:09:26.97,0:09:29.61,Default,KOGORO,0,0,0,,‫الجاني فقط من كان على معرفةٍ بذلك
Dialogue: 0,0:09:30.41,0:09:32.60,Default,AMI,0,0,0,,‫لـ-لقد خدعتموه
Dialogue: 0,0:09:32.60,0:09:34.99,Default,AMI,0,0,0,,‫كل ما فعله أنه قال ذلك بشكلٍ خاطئ
Dialogue: 0,0:09:34.99,0:09:38.00,Default,RYOTA,0,0,0,,‫(آمي)، لا يمكننا المواصلة
Dialogue: 0,0:09:38.00,0:09:39.51,Default,AMI,0,0,0,,‫(ريوتا)...
Dialogue: 0,0:09:40.14,0:09:43.64,Default,RYOTA,0,0,0,,‫أيها السيد المحقق، نحن وراء أمر الخروف الأحمر
Dialogue: 0,0:09:44.62,0:09:46.89,Default,RYOTA,0,0,0,,‫(آمي) كانت ترتدي الزيّ
Dialogue: 0,0:09:49.50,0:09:51.40,Default,RYOTA,0,0,0,,‫بينما كنتُ أقوم بالتصوير
Dialogue: 0,0:09:51.85,0:09:53.90,Default,RYOTA,0,0,0,,‫قمنا بتنزيل الفيديوهات على موقع لمشاركة الفيديوهات
Dialogue: 0,0:09:54.29,0:09:57.40,Default,KOGORO,0,0,0,,‫إذن فقد كنتما أنتما بالفعل
Dialogue: 0,0:09:58.24,0:09:59.91,Default - italic,CONAN,0,0,0,,‫اتضح كل شيء الآن
Dialogue: 0,0:10:00.36,0:10:05.91,Default - italic,CONAN,0,0,0,,‫الخروف الأحمر الذي رأيناه أنا و (ران) كان يخدش السقف بقرونه
Dialogue: 0,0:10:06.41,0:10:10.87,Default - italic,CONAN,0,0,0,,‫لكن قرون الخروف الأحمر الذي رأيناه في الفيديوهات لم تكن تصل للسقف
Dialogue: 0,0:10:11.66,0:10:18.05,Default - italic,CONAN,0,0,0,,‫بعبارةٍ أخرى، قاتل السيد (واكاباياشي) هو شخصٌ أطول
Dialogue: 0,0:10:18.45,0:10:20.49,Default,HIRASAWA,0,0,0,,‫كيف أمكنكما فعل ذلك؟
Dialogue: 0,0:10:20.49,0:10:22.32,Default,AMI,0,0,0,,‫هذا خطؤك
Dialogue: 0,0:10:22.32,0:10:25.45,Default,AMI,0,0,0,,‫سمعنا أنك ستجعلنا نوزع منشورات بهذا الزيّ
Dialogue: 0,0:10:25.45,0:10:28.63,Default,AMI,0,0,0,,‫لذا قمنا بتخريب سمعة هذا الزيّ
Dialogue: 0,0:10:28.63,0:10:29.65,Default,HIRASAWA,0,0,0,,‫ماذا؟
Dialogue: 0,0:10:30.00,0:10:32.14,Default,RYOTA,0,0,0,,‫نوينا أن نفعلها مرةً واحدةً فقط
Dialogue: 0,0:10:32.14,0:10:35.90,Default,RYOTA,0,0,0,,‫لكن عندما رأينا الفيديوهات تنتشر بشكلٍ هائل،\N قررنا المواصلة والاستمتاع بذلك
Dialogue: 0,0:10:36.09,0:10:37.04,Default,KOGORO,0,0,0,,‫لحظة
Dialogue: 0,0:10:37.04,0:10:40.83,Default,KOGORO,0,0,0,,‫من أخبركم بأنكم كنتم ستوزعون المنشورات بهذا الزيّ؟
Dialogue: 0,0:10:40.83,0:10:41.68,Default,AMI,0,0,0,,‫ماذا؟
Dialogue: 0,0:10:41.68,0:10:44.96,Default,KOGORO,0,0,0,,‫سيد (هيراساوا)، هل أخبرتَ أحدًا بذلك؟
Dialogue: 0,0:10:44.96,0:10:47.82,Default,HIRASAWA,0,0,0,,‫لا، فقط (واكاباياشي)
Dialogue: 0,0:10:47.82,0:10:49.80,Default,HIRASAWA,0,0,0,,‫لم أخبر أحدًا عداه
Dialogue: 0,0:10:51.06,0:10:55.18,Default,KOGORO,0,0,0,,‫هذا يعني أنكما كنتما تتنصتان لمحادثتهما
Dialogue: 0,0:10:55.18,0:10:55.92,Default,AMI,0,0,0,,‫ماذا؟
Dialogue: 0,0:10:56.10,0:10:59.72,Default,KOGORO,0,0,0,,‫أراهن بأنكما سمعتما عن الخمسين مليون ينًا التي في الخزنة كذلك
Dialogue: 0,0:10:59.72,0:11:05.81,Default,TAKAGI,0,0,0,,‫لكن يا سيد (موري)، ألم يكونا معك أثناء وقوع الجريمة؟
Dialogue: 0,0:11:06.88,0:11:10.91,Default,AMI,0,0,0,,‫هـ-هذا صحيح، لدينا حجة غياب
Dialogue: 0,0:11:11.27,0:11:16.02,Default,MEGURE,0,0,0,,‫إذن، مَن قتل السيد (واكاباياشي)؟
Dialogue: 0,0:11:23.24,0:11:27.91,Default,KOGORO,0,0,0,,‫صحيحٌ أن هناك شخصٌ آخر قام بارتكاب جريمة القتل
Dialogue: 0,0:11:27.91,0:11:32.50,Default,KOGORO,0,0,0,,‫لكن هذان الاثنان هما من قاما باختطاف السيدة (آنري)
Dialogue: 0,0:11:32.99,0:11:35.20,Default,KOGORO,0,0,0,,‫وطالبا بمبلغ خمسين مليون ينًا من السيد (واكاباياشي)
Dialogue: 0,0:11:35.20,0:11:39.51,Default,KOGORO,0,0,0,,‫هذا الخروف الأحمر الذي في الفيديو هو أنت، صحيح؟
Dialogue: 0,0:11:39.74,0:11:41.18,Default,AMI,0,0,0,,‫لا
Dialogue: 0,0:11:41.18,0:11:43.64,Default,KOGORO,0,0,0,,‫ماذا؟ توقفي عن الكذب
Dialogue: 0,0:11:43.64,0:11:47.14,Default,KOGORO,0,0,0,,‫للتو ذكرتِ أنكِ أنتِ هو الخروف الأحمر
Dialogue: 0,0:11:47.14,0:11:50.76,Default,AMI,0,0,0,,‫لهذا أقول لك مرةً أخرى، أنا تلك الخروف
Dialogue: 0,0:11:50.76,0:11:53.02,Default,AMI,0,0,0,,‫لكني لستُ هذا بالطبع
Dialogue: 0,0:11:53.49,0:11:55.88,Default,KOGORO,0,0,0,,‫لا يوجد خروف هنا وهناك
Dialogue: 0,0:11:56.38,0:12:00.31,Default,KOGORO,0,0,0,,‫عد كل تلك الخرفان سيصيبني بالنعاس
Dialogue: 0,0:12:00.76,0:12:05.28,Default,KOGORO,0,0,0,,‫كما تعلمون، خروفٌ واحد، خروفان، ثلاثة خرفان
Dialogue: 0,0:12:02.95,0:12:05.28,Default - italic,CONAN,0,0,0,,‫{\an8}انتظر لحظة
Dialogue: 0,0:12:05.75,0:12:06.92,Default,KOGORO,0,0,0,,‫بالإضافة
Dialogue: 0,0:12:09.21,0:12:11.62,Default,KOGORO,0,0,0,,‫الخروف، الخروف!
Dialogue: 0,0:12:14.12,0:12:15.29,Default,KOGORO,0,0,0,,‫المعذرة
Dialogue: 0,0:12:15.53,0:12:18.80,Default,KOGORO,0,0,0,,‫اسمحوا لي جميعًا بأن أصحح ما قلته
Dialogue: 0,0:12:19.94,0:12:24.93,Default,KOGORO,0,0,0,,‫الخروف الأحمر الذي ظهر في رسالة التهديد تلك ليست السيدة (آمي)
Dialogue: 0,0:12:25.14,0:12:27.43,Default,TAKAGI,0,0,0,,‫ماذا؟ ليست السيدة (آمي)؟
Dialogue: 0,0:12:27.83,0:12:28.99,Default,KOGORO,0,0,0,,‫هذا صحيح
Dialogue: 0,0:12:29.50,0:12:32.39,Default,MEGURE,0,0,0,,‫(موري)، ما الذي تعنيه؟
Dialogue: 0,0:12:32.39,0:12:37.94,Default,KOGORO,0,0,0,,‫السيدة (آمي) ليست الخروف الأحمر، بل الرهينة
Dialogue: 0,0:12:38.29,0:12:38.64,Default,TAKAGI,0,0,0,,‫ماذا؟
Dialogue: 0,0:12:38.64,0:12:39.44,Default,MEGURE,0,0,0,,‫ماذا؟
Dialogue: 0,0:12:39.90,0:12:40.69,Default,HIRASAWA,0,0,0,,‫ماذا؟
Dialogue: 0,0:12:41.93,0:12:43.73,Default,RYOTA,0,0,0,,‫(آمي) هي الرهينة
Dialogue: 0,0:12:43.73,0:12:44.75,Default,KOGORO,0,0,0,,‫نعم
Dialogue: 0,0:12:44.75,0:12:47.20,Default,KOGORO,0,0,0,,‫المدعوة بالسيدة (آنري) والتي التقت بالسيد (واكاباياشي) في تطبيقٍ للمواعدة
Dialogue: 0,0:12:47.63,0:12:53.46,Default,KOGORO,0,0,0,,‫وأصبحت حبيبته، هي في الواقع السيدة (آمي)
Dialogue: 0,0:12:55.78,0:12:57.96,Default,RYOTA,0,0,0,,‫مـ-ما الذي تتحدث عنه؟
Dialogue: 0,0:12:58.20,0:13:00.16,Default,RYOTA,0,0,0,,‫أنا هو حبيب (آمي)
Dialogue: 0,0:13:00.64,0:13:03.22,Default,RYOTA,0,0,0,,‫لا يمكنها أن تكون حبيبةً لرئيس الطهاة
Dialogue: 0,0:13:03.64,0:13:08.22,Default,KOGORO,0,0,0,,‫لم يكن يعلم السيد (واكاباياشي) وجوه أو أسماء موظفي الدوام الجزئي
Dialogue: 0,0:13:08.48,0:13:14.23,Default,KOGORO,0,0,0,,‫بعبارةٍ أخرى، لم يكن ليلاحظ ادّعاء السيدة (آمي) أنها هي (آنري)
Dialogue: 0,0:13:14.83,0:13:16.65,Default,RYOTA,0,0,0,,‫(آمي)، انكري ذلك
Dialogue: 0,0:13:17.55,0:13:21.73,Default,TAKAGI,0,0,0,,‫إذن، من هذا الخروف الأحمر الذي في الرسالة؟
Dialogue: 0,0:13:22.22,0:13:23.49,Default,KOGORO,0,0,0,,‫سيد (هيراساوا)
Dialogue: 0,0:13:23.49,0:13:28.24,Default,KOGORO,0,0,0,,‫ألم تقل أنك أنت من جعلت السيد (واكاباياشي) هو رئيس الطهاة؟
Dialogue: 0,0:13:28.55,0:13:31.99,Default,HIRASAWA,0,0,0,,‫نعم، بالرغم من أنه لم يكن راضيًا بشأن ذلك
Dialogue: 0,0:13:32.20,0:13:37.37,Default,KOGORO,0,0,0,,‫ربما لذلك السبب، قام بتلقيب نفسه "شيف" في تطبيق المواعدة
Dialogue: 0,0:13:37.37,0:13:43.51,Default,KOGORO,0,0,0,,‫وهنا شخصان اثنان كانا يلقبانه بالشيف
Dialogue: 0,0:13:43.76,0:13:45.00,Default,KOGORO,0,0,0,,‫الأولى هي السيدة (آمي)
Dialogue: 0,0:13:45.76,0:13:49.67,Default - italic,AMI,0,0,0,,‫نعم، لم نتحدث أبدًا مع الطاهي
Dialogue: 0,0:13:49.67,0:13:52.64,Default - italic,AMI,0,0,0,,‫‫أشك في أنه كان يعرف حتى كيف كان شكلنا
Dialogue: 0,0:13:52.86,0:13:56.39,Default,KOGORO,0,0,0,,‫والآخر هو أنت يا سيد (كوميو)
Dialogue: 0,0:13:56.82,0:13:57.89,Default,KAMIO,0,0,0,,‫ماذا؟
Dialogue: 0,0:13:58.14,0:14:00.94,Default - italic,KAMIO,0,0,0,,‫‫لقد اقترحتُه عليه قبل شهر
Dialogue: 0,0:14:01.20,0:14:04.19,Default - italic,KAMIO,0,0,0,,‫‫لم يكن لدى الشيف أي فرص لمقابلة النساء
Dialogue: 0,0:14:04.96,0:14:07.87,Default,KAMIO,0,0,0,,‫ما من فرقٍ بين الشيف ورئيس الطهاة
Dialogue: 0,0:14:07.87,0:14:10.95,Default,KAMIO,0,0,0,,‫أتقول أنك تعتقد أني فعلتُ ذلك بسبب أني كنتُ أدعوه بالشيف؟
Dialogue: 0,0:14:11.19,0:14:12.66,Default,KOGORO,0,0,0,,‫ليس هذا هو السبب الوحيد
Dialogue: 0,0:14:12.66,0:14:16.45,Default,KOGORO,0,0,0,,‫(كونان)، هل لك أن تستخدم رأس الزيّ لتشرح لهم؟
Dialogue: 0,0:14:16.69,0:14:18.21,Default,CONAN,0,0,0,,‫بالطبع
Dialogue: 0,0:14:19.25,0:14:25.46,Default,CONAN,0,0,0,,‫رأس الزيّ لديه خوذة، لذا من السهل جدًا ارتداؤه
Dialogue: 0,0:14:25.66,0:14:28.22,Default,CONAN,0,0,0,,‫سيد (كاميو)، هل لك أن تضعه عليك؟
Dialogue: 0,0:14:28.44,0:14:30.64,Default,KAMIO,0,0,0,,‫ماذا؟ لكن...
Dialogue: 0,0:14:30.81,0:14:34.64,Default,MEGURE,0,0,0,,‫سيد (كاميو)، من فضلك اتبع تعليمات (كونان)
Dialogue: 0,0:14:35.81,0:14:36.78,Default,KAMIO,0,0,0,,‫حسنًا
Dialogue: 0,0:14:39.01,0:14:42.60,Default,CONAN,0,0,0,,‫ابقَ ثابتًا ولا تحرك يديك
Dialogue: 0,0:14:51.24,0:14:52.53,Default,RYOTA,0,0,0,,‫سيد (كاميو)...
Dialogue: 0,0:14:54.65,0:14:58.29,Default,KOGORO,0,0,0,,‫سيد (كاميو)، تسريحة الشعر التي تتفاخر بها خربت
Dialogue: 0,0:14:58.54,0:15:01.29,Default,KAMIO,0,0,0,,‫ماذا؟ تبًا
Dialogue: 0,0:15:01.81,0:15:05.40,Default,KOGORO,0,0,0,,‫البارحة، كان شعرك بنفس هذا الشكل
Dialogue: 0,0:15:05.40,0:15:06.05,Default,KAMIO,0,0,0,,‫ماذا...
Dialogue: 0,0:15:08.76,0:15:13.01,Default,KOGORO,0,0,0,,‫أتذكر شكله جيدًا لأنك كنت تعبث به طوال الوقت
Dialogue: 0,0:15:14.06,0:15:18.31,Default,KAMIO,0,0,0,,‫البارحة كان شعري هكذا لأني قدتُ بدراجتي للوصول إلى المطعم
Dialogue: 0,0:15:18.64,0:15:23.06,Default,KOGORO,0,0,0,,‫ألم تقل أنك لم تعد تستخدم دراجتك منذ الحادثة؟
Dialogue: 0,0:15:23.62,0:15:26.07,Default - italic,KAMIO,0,0,0,,‫كنتُ في المنزل طوال اليوم
Dialogue: 0,0:15:26.35,0:15:29.57,Default - italic,KAMIO,0,0,0,,‫‫لم أعد استخدم دراجتي الهوائية منذ ذلك الحادث
Dialogue: 0,0:15:29.91,0:15:31.99,Default,HIRASAWA,0,0,0,,‫أنت محق، لقد قال ذلك بالفعل
Dialogue: 0,0:15:32.25,0:15:35.49,Default,KOGORO,0,0,0,,‫وأخيرًا، هناك دليلٌ آخر
Dialogue: 0,0:15:35.49,0:15:39.34,Default,KOGORO,0,0,0,,‫محقق (تاكاجي)، هل يمكنك فحص ساعة السيد (كاميو)؟
Dialogue: 0,0:15:39.34,0:15:41.81,Default,TAKAGI,0,0,0,,‫حاضر \N‫‫من فضلك
Dialogue: 0,0:15:42.81,0:15:44.26,Default,KOGORO,0,0,0,,‫ألقِ نظرة عن قرب
Dialogue: 0,0:15:44.26,0:15:47.22,Default,KOGORO,0,0,0,,‫هل هناك ألياف حمراء عالقة في الحزام؟
Dialogue: 0,0:15:48.32,0:15:51.63,Default,TAKAGI,0,0,0,,‫يبدو أن هناك شيئًا يشبه الخيط الأحمر الرفيع
Dialogue: 0,0:15:51.94,0:15:56.64,Default,KOGORO,0,0,0,,‫هذه هي ألياف النايلون التي تغطي سطح هذا الزيّ
Dialogue: 0,0:15:57.14,0:16:03.40,Default,KOGORO,0,0,0,,‫لا يمكن لها أن تلتصق بحزام ساعته إلا إذا ارتدى هذا الزيّ
Dialogue: 0,0:16:04.36,0:16:06.81,Default,KAMIO,0,0,0,,‫هذا لأنني للتو ارتديتُ الرأس
Dialogue: 0,0:16:06.81,0:16:08.02,Default,KAMIO,0,0,0,,‫لقد علقت الآن
Dialogue: 0,0:16:08.32,0:16:12.78,Default,KOGORO,0,0,0,,‫لا، أظن أن (كونان) قد أخبرك بألا تحرك يديك
Dialogue: 0,0:16:13.03,0:16:14.48,Default,MEGURE,0,0,0,,‫إنه محق
Dialogue: 0,0:16:14.48,0:16:17.28,Default,MEGURE,0,0,0,,‫لم تلمس ذلك الزيّ
Dialogue: 0,0:16:19.46,0:16:24.12,Default,KOGORO,0,0,0,,‫سيد (كاميو)، على الأرجح أنك كنت تتنصت على المطبخ
Dialogue: 0,0:16:24.12,0:16:26.17,Default,KOGORO,0,0,0,,‫لجمع المعلومات حول المطعم
Dialogue: 0,0:16:26.64,0:16:30.29,Default,KOGORO,0,0,0,,‫وهكذا علمتَ عن أمر الخمسين مليون ينًا المخفية
Dialogue: 0,0:16:31.22,0:16:32.13,Default,KAMIO,0,0,0,,‫(آمي)
Dialogue: 0,0:16:33.84,0:16:35.68,Default,AMI,0,0,0,,‫انتهى كل شيء
Dialogue: 0,0:16:35.68,0:16:41.01,Default,KAMIO,0,0,0,,‫اللعنة، كان عليّ أن أترك هذا المطعم وأجوره الرديئة فورًا
Dialogue: 0,0:16:43.66,0:16:46.19,Default,RYOTA,0,0,0,,‫(آمي)، هل أنتِ مع السيد (كاميو)؟
Dialogue: 0,0:16:46.84,0:16:49.52,Default,AMI,0,0,0,,‫نعم، منذ فترةٍ طويلة
Dialogue: 0,0:16:50.05,0:16:52.36,Default,AMI,0,0,0,,‫لقد كنتُ أستمتع بوقتي معك فقط
Dialogue: 0,0:16:52.36,0:16:57.41,Default,AMI,0,0,0,,‫استخدمتُ لعبة الخروف الأحمر لجعلك تأتي إلى الحديقة لصنع حجة غياب
Dialogue: 0,0:16:57.79,0:16:59.83,Default,RYOTA,0,0,0,,‫مـ-مستحيل...
Dialogue: 0,0:17:00.18,0:17:03.05,Default,MEGURE,0,0,0,,‫إذن، (موري) على حق، صحيح؟
Dialogue: 0,0:17:04.59,0:17:08.59,Default,KAMIO,0,0,0,,‫صحيحٌ أنني و (آمي) كنا نخطط لسرقة الخمسون مليون ينًا
Dialogue: 0,0:17:08.82,0:17:10.94,Default,KAMIO,0,0,0,,‫من الشيف وإرسال رسالة تهديد له
Dialogue: 0,0:17:11.85,0:17:14.91,Default,KAMIO,0,0,0,,‫لكن ذلك الجزء الوحيد الذي التزمنا فيه بالخطة
Dialogue: 0,0:17:14.91,0:17:17.34,Default,KAMIO,0,0,0,,‫لم نحصل على مبلغ الفدية أبدًا
Dialogue: 0,0:17:17.94,0:17:20.35,Default,KAMIO,0,0,0,,‫ولم نقتل الشيف أيضًا!
Dialogue: 0,0:17:20.64,0:17:22.78,Default,TAKAGI,0,0,0,,‫أما زلتَ مصرًا على إنكارك؟
Dialogue: 0,0:17:22.78,0:17:26.27,Default,TAKAGI,0,0,0,,‫(كونان) والسيدة (ران) رأوك تهرب من مسرح الجريمة
Dialogue: 0,0:17:26.51,0:17:30.52,Default,RAN,0,0,0,,‫لقد رأيتُ خروفًا أحمر يحمل شنطة سوداء معه يهرب بعيدًا
Dialogue: 0,0:17:30.76,0:17:33.21,Default,KAMIO,0,0,0,,‫وأنا أقول لكم، لم أكن أنا!
Dialogue: 0,0:17:33.21,0:17:35.03,Default,KAMIO,0,0,0,,‫لم أكن أنا بالفعل
Dialogue: 0,0:17:35.27,0:17:36.78,Default,MEGURE,0,0,0,,‫ما الذي تعنيه؟
Dialogue: 0,0:17:37.31,0:17:39.85,Default,KAMIO,0,0,0,,‫بعد أن اتجهت (آمي) للحديقة
Dialogue: 0,0:17:39.85,0:17:44.24,Default,KAMIO,0,0,0,,‫وضعتُ الزيّ في حقيبة السيارة لآخذ استراحة
Dialogue: 0,0:17:44.80,0:17:45.99,Default,KAMIO,0,0,0,,‫لكن لاحقًا...
Dialogue: 0,0:17:49.62,0:17:52.30,Default,KAMIO,0,0,0,,‫بعد أن استيقظت، كان زيّ الخروف مختفيًا
Dialogue: 0,0:17:52.60,0:17:53.46,Default,TAKAGI,0,0,0,,‫اختفى؟
Dialogue: 0,0:17:53.64,0:17:54.76,Default,KAMIO,0,0,0,,‫نعم
Dialogue: 0,0:17:54.76,0:17:56.84,Default,KAMIO,0,0,0,,‫لقد اختفى الخروف الأحمر
Dialogue: 0,0:17:59.68,0:18:04.31,Default - italic,CONAN,0,0,0,,‫الخروف الأحمر والخمسون مليون ينًا اختفوا؟
Dialogue: 0,0:18:05.81,0:18:07.12,Default - italic,CONAN,0,0,0,,‫فهمت
Dialogue: 0,0:18:07.12,0:18:08.38,Default - italic,CONAN,0,0,0,,‫هل هذا معقول؟
Dialogue: 0,0:18:33.24,0:18:35.62,Default,KOGORO,0,0,0,,‫أيها المفتش، لقد تم تأمين الموقع
Dialogue: 0,0:18:35.62,0:18:37.17,Default,KOGORO,0,0,0,,‫تفضل بالدخول
Dialogue: 0,0:18:39.81,0:18:42.67,Default,MEGURE,0,0,0,,‫أنت هو من قتل السيد (واكاباياشي تيتسوسابورو)
Dialogue: 0,0:18:42.67,0:18:45.45,Default,MEGURE,0,0,0,,‫وسرق الخمسين مليون ينًا، أليس كذلك؟
Dialogue: 0,0:18:45.45,0:18:47.43,Default,IWAMI,0,0,0,,‫مـ-ما الذي تتحدثون عنه؟
Dialogue: 0,0:18:49.84,0:18:54.69,Default,CONAN,0,0,0,,‫يبدو أن خمسين مليون ينًا تزن خمسة كيلو جرامات، لذا
Dialogue: 0,0:18:58.64,0:18:59.64,Default,CONAN,0,0,0,,‫هذا مؤلم...
Dialogue: 0,0:19:02.09,0:19:05.25,Default,CONAN,0,0,0,,‫البطريق هو الوحيد الذي كان معلقًا بمسافةٍ أقل من الأزياء الأخرى
Dialogue: 0,0:19:05.25,0:19:07.58,Default,CONAN,0,0,0,,‫لقد ارتطم رأسي به
Dialogue: 0,0:19:15.05,0:19:18.97,Default,IWAMI,0,0,0,,‫كنتُ أنوي الإمساك بالجاني
Dialogue: 0,0:19:20.22,0:19:21.47,Default,KOGORO,0,0,0,,‫الجاني؟
Dialogue: 0,0:19:24.13,0:19:30.13,Default,IWAMI,0,0,0,,‫لقد راهنت بهذا المكان حتى أتمكن من التقاط الوغد الذي يسرق الأزياء
Dialogue: 0,0:19:30.13,0:19:31.98,Default,IWAMI,0,0,0,,‫في منتصف الليل دون دفع رسوم إيجار
Dialogue: 0,0:19:32.92,0:19:36.73,Default,IWAMI,0,0,0,,‫في ذلك الوقت، سمعتُ خطتهما
Dialogue: 0,0:19:38.23,0:19:42.24,Default,IWAMI,0,0,0,,‫بسرقة خمسين مليون ينًا من رجلٍ يُدعى (واكاباياشي)
Dialogue: 0,0:19:46.02,0:19:49.42,Default,IWAMI,0,0,0,,‫شركتي على وشك الإفلاس
Dialogue: 0,0:19:49.42,0:19:52.97,Default,IWAMI,0,0,0,,‫بينما كانوا يحاولون أن يضعوا أيديهم على مبلغٍ من المال وكأن الأمر لعبة
Dialogue: 0,0:19:52.97,0:19:56.42,Default,IWAMI,0,0,0,,‫اعتقدت أنه لن يكون هناك خطأ في الحصول على هذا المال
Dialogue: 0,0:19:56.42,0:19:58.00,Default,IWAMI,0,0,0,,‫لذا قمتُ بتتبعهم
Dialogue: 0,0:20:10.92,0:20:15.19,Default,IWAMI,0,0,0,,‫لم يكن ليعلم من أنا إن قمتُ بارتداء الزيّ
Dialogue: 0,0:20:15.78,0:20:18.10,Default - italic,RED SHEEP,0,0,0,,‫اترك المال وتراجع
Dialogue: 0,0:20:20.47,0:20:24.95,Default,IWAMI,0,0,0,,‫قام بإطاعة أوامري ووضع الخمسين مليون ينًا أمامي
Dialogue: 0,0:20:25.13,0:20:29.62,Default,MEGURE,0,0,0,,‫ما الذي جعلك تقتل السيد (واكاباياشي) بعد أن حصلتَ على المال؟
Dialogue: 0,0:20:31.48,0:20:35.88,Default,IWAMI,0,0,0,,‫ذلك لأنني عندما فتحتُ الحقيبة لتفقد محتواها
Dialogue: 0,0:20:36.57,0:20:38.50,Default,IWAMI,0,0,0,,‫وجدتُ سكينًا داخلها
Dialogue: 0,0:20:38.86,0:20:40.42,Default,KOGORO,0,0,0,,‫وجدتَ سكينًا بداخل الحقيبة؟
Dialogue: 0,0:20:40.61,0:20:45.93,Default,CONAN,0,0,0,,‫السيد (واكاباياشي) قام بإخفاء ذلك السكين بداخلها ليدافع عن نفسه
Dialogue: 0,0:20:46.31,0:20:49.68,Default,IWAMI,0,0,0,,‫عندما نظرتُ للأعلى بدون تفكير...
Dialogue: 0,0:21:09.74,0:21:12.65,Default,IWAMI,0,0,0,,‫لم أرد قتله
Dialogue: 0,0:21:13.59,0:21:17.07,Default,IWAMI,0,0,0,,‫ليته لم يرى وجهي
Dialogue: 0,0:22:57.35,0:23:01.19,DCNote,SIGN,0,0,0,,‫وكالة (موري) للتحريات
Dialogue: 0,0:23:03.69,0:23:05.54,Default,CONAN,0,0,0,,‫ما خطبه يا تُرى؟
Dialogue: 0,0:23:05.54,0:23:07.94,Default,RAN,0,0,0,,‫يبدو أنه لا يستطيع النوم أثناء الليل
Dialogue: 0,0:23:08.26,0:23:10.70,Default,RAN,0,0,0,,‫ظل يحلم بخروفٍ طوال الوقت
Dialogue: 0,0:23:10.70,0:23:12.24,Default,CONAN,0,0,0,,‫خروف؟
Dialogue: 0,0:23:12.24,0:23:16.73,Default,RAN,0,0,0,,‫يبدو أن أبي أيضًا كان خائفًا من ذلك الخروف الأحمر
Dialogue: 0,0:23:16.73,0:23:19.96,Default,RAN,0,0,0,,‫ظل يقول في حلمه "ابتعد، ابتعد عني"
Dialogue: 0,0:23:20.84,0:23:22.00,Default,KOGORO,0,0,0,,‫ابتعد
Dialogue: 0,0:23:22.90,0:23:23.94,Default,KOGORO,0,0,0,,‫ابتعد
Dialogue: 0,0:23:25.39,0:23:26.83,Default,KOGORO,0,0,0,,‫ابتعد
Dialogue: 0,0:23:28.02,0:23:29.75,Default,KOGORO,0,0,0,,‫ابقَ بعيدًا عني
Dialogue: 0,0:23:30.28,0:23:31.72,Default,KOGORO,0,0,0,,‫ابتعد
Dialogue: 0,0:23:33.00,0:23:36.54,Default - italic,CONAN,0,0,0,,‫أ...أشعر بأن هناك شيء آخر
Dialogue: 0,0:23:39.96,0:23:43.72,Default,KOGORO,0,0,0,,‫استمروا في فك الزجاجات أيها الحملان الصغيرتان الجميلتان!
Dialogue: 0,0:23:44.98,0:24:09.01,DCEpPreview,SIGN,0,0,0,,{\pos(53.224,57.71)\alpha40}‫في الحلقة القادمة
Dialogue: 0,0:23:45.26,0:23:48.68,Default,TAKAGI,0,0,0,,‫لقد ضغطوا على (ياماكابي)، والذي نجح في بيع البضائع المستوردة
Dialogue: 0,0:23:48.68,0:23:51.49,Default,TAKAGI,0,0,0,,‫لينشر سيرة ذاتية
Dialogue: 0,0:23:51.73,0:23:54.58,Default,MEGURE,0,0,0,,‫وجدنا شيئًا يدين إلى حد ما
Dialogue: 0,0:23:54.58,0:23:56.70,Default,MEGURE,0,0,0,,‫في السيارة المستخدمة لنقل الجثة
Dialogue: 0,0:23:56.92,0:24:01.71,Default,KOGORO,0,0,0,,‫كان خزان الوقود في سيارة (تيموكاي) ممتلئًا عندما وقع الحادث؟
Dialogue: 0,0:24:02.40,0:24:05.00,Default,MEGURE,0,0,0,,‫مر وقتٌ طويل، (تيموكاي)
Dialogue: 0,0:24:07.30,0:24:09.01,Default,KOGORO,0,0,0,,‫يمكننا إنقاذ حضرة المفتش
Dialogue: 0,0:24:09.01,0:24:15.01,NextEPTitle,SIGN,0,0,0,,{\pos(424,164.684)\blur5}‫التهديد لمسيرة (ميغوري) في الشرطة
Dialogue: 0,0:24:09.33,0:24:13.88,Default,CONAN,0,0,0,,‫الحلقة القادمة من (كونان): "التهديد لمسيرة (ميغوري) في الشرطة!"
