Comment: 0,0:00:00.00,0:00:00.02,DCItalic,CONAN,0,0,0,,[Eyecatch]
Dialogue: 0,0:00:01.28,0:00:03.37,DCItalic,CONAN,0,0,0,,كوغورو النائم
Dialogue: 0,0:00:03.37,0:00:07.48,DCItalic,CONAN,0,0,0,,حلّ العجوز قضيةً قبل أن يُعرف بهذا اللقب
Dialogue: 0,0:00:12.52,0:00:15.90,DCItalic,CONAN,0,0,0,,وما حدث في تلك القضية كانت بداية كل شيء
Dialogue: 0,0:00:17.79,0:00:19.74,DCMain,KANAE,0,0,0,,أرجوك ساعدني يا موري-سان
Dialogue: 0,0:00:20.18,0:00:25.25,DCMain,KANAE,0,0,0,,{\an8}سرقَ شخص ما دبوسي المُزخرف الثمين
Dialogue: 0,0:00:25.76,0:00:28.26,DCMain,KANAE,0,0,0,,لا أعلم متى سُرق بالضبط
Dialogue: 0,0:00:28.26,0:00:33.34,DCMain,KANAE,0,0,0,,لكنني لم ألاحظ أنه مسروق إلا صباح اليوم\Nلأنني وجدتُ هذه في صندوق البريد
Dialogue: 0,0:00:33.80,0:00:35.11,DCMain,KOGORO,0,0,0,,دعيني ألقي نظرة عليها
Dialogue: 0,0:00:35.74,0:00:41.02,DCMain,KOGORO,0,0,0,,أخذتُ دبوسكِ الثمين، إذا كنتِ تريدين استعادته، فستجدينه في المقبرة
Dialogue: 0,0:00:41.02,0:00:42.67,DCMain,KOGORO,0,0,0,,تعالي إلى متنزه كوروتشي
Dialogue: 0,0:00:42.67,0:00:47.15,DCMain,KOGORO,0,0,0,,"إذا أخبرتِ الشرطة فسأتخلص من كنزك الثمين فورًا
Dialogue: 0,0:00:47.53,0:00:49.34,DCMain,KOGORO,0,0,0,,المقبرة، هاه؟
Dialogue: 0,0:00:49.34,0:00:52.15,DCMain,KOGORO,0,0,0,,لمَ تعدّين هذا الدبوس كنزًا؟
Dialogue: 0,0:00:52.45,0:00:58.11,DCMain,KANAE,0,0,0,,إنه ليس غاليًا لكنه تذكارٌ من أمي التي توفيّت منذ مدة
Dialogue: 0,0:00:58.66,0:01:03.54,DCMain,KANAE,0,0,0,,أريد تسوية الأمر بهدوء لذا طلبتُ إليك المساعدة بدلًا من الشرطة
Dialogue: 0,0:01:03.76,0:01:04.91,DCMain,KOGORO,0,0,0,,فهمت
Dialogue: 0,0:01:06.01,0:01:08.42,DCItalic,KOGORO,0,0,0,,...لكن هذه الكلمة
Dialogue: 0,0:01:09.05,0:01:15.67,DCItalic,KOGORO,0,0,0,,ربما يستخدم المجرم ذلك الكنز طُعمًا كي يستدرجها ثم يقتلها
Dialogue: 0,0:01:16.47,0:01:19.77,DCItalic,KOGORO,0,0,0,,!لكنها جميلة حقًا
Dialogue: 0,0:01:19.77,0:01:20.91,DCMain,KANAE,0,0,0,,هل من مشكلة؟
Dialogue: 0,0:01:20.91,0:01:23.43,DCMain,KOGORO,0,0,0,,!لا لا
Dialogue: 0,0:01:24.76,0:01:26.12,DCMain,KOGORO,0,0,0,,!اعتمدي عليّ يا آنسة
Dialogue: 0,0:01:26.12,0:01:32.90,DCMain,KOGORO,0,0,0,,!لم يفشل المحقق العظيم موري كوغورو في أي مهمة من قبل
Dialogue: 0,0:01:33.93,0:01:35.46,DCMain,KANAE,0,0,0,,شكرًا لك
Dialogue: 0,0:01:35.46,0:01:38.42,DCMain,KANAE,0,0,0,,!كما يُقال، أنت محققٌ عظيمٌ بحقّ
Dialogue: 0,0:01:39.50,0:01:41.66,DCItalic,CONAN,0,0,0,,عمَّ يتحدث؟
Dialogue: 0,0:01:42.17,0:01:45.39,DCItalic,CONAN,0,0,0,,لكن ماذا يقصد المجرم بالمقبرة؟
Dialogue: 0,0:01:53.11,0:01:54.66,Otanoshimi,CONAN,0,0,0,,{\fs20\blur3\t(0,500,\fs100\frz-360)\t(1500,2800,\fs10\frz0)\fad(300,300)\c&HEEEEEE&\3c&H020202&}!طلاقة لساني يُشار إليها بالبنان
Dialogue: 0,0:01:54.66,0:01:56.45,Otanoshimi,CONAN,0,0,0,,{\blur3\t(0,150,\fscx10)\t(200,250,\fscx105\fscy105)\t(1200,1700,\fscx10)\fad(300,300)\c&HEEEEEE&\3c&H0A0A0A&}!ومهاراتي الاستنتاجية مثالية
Dialogue: 0,0:01:56.45,0:01:58.30,Otanoshimi,CONAN,0,0,0,,{\blur3\t(0,200,\fscy2)\t(200,250,\fscx105\fscy105)\fad(300,300)\c&HFFFFFF&\3c&H0A0A0A&}!الرسالة التي وصلت إلى المرأة الجميلة
Dialogue: 0,0:01:58.30,0:02:00.28,Otanoshimi,CONAN,0,0,0,,{\blur3\t(0,200,\fscy2)\t(200,250,\fscx105\fscy105)\fad(300,300)\c&HFFFFFF&\3c&H0A0A0A&}!يقترب كوغورو النائم من المقبرة
Dialogue: 0,0:02:00.28,0:02:01.90,Otanoshimi,CONAN,0,0,0,,{\fad(300,300)\move(100,700,1200,700,0,0)\c&H000000&\blur3\3c&HFFFFFF&}يكتشف الحقيقة دائمًا
Dialogue: 0,0:02:01.90,0:02:03.60,Otanoshimi,CONAN,0,0,0,,{\blur3\move(1200,700,100,700,0,0)\fad(300,300)\c&H000000&\3c&HFFFFFF&}بجسد طفل وعقل بالغ
Dialogue: 0,0:02:03.73,0:02:05.73,Otanoshimi,CONAN,0,0,0,,{\fad(0,300)\c&HFFFFFF&\move(1354,700,794,702,100,500)\fs100\blur3\3c&H000000&}اسمه
Dialogue: 0,0:02:04.48,0:02:05.73,Otanoshimi,CONAN,0,0,0,,{\fad(0,300)\c&HFFFFFF&\fs100\blur3\move(683.6,800,680,705,118,524)\3c&H000000&}المحقق
Dialogue: 0,0:02:05.02,0:02:05.73,Otanoshimi,CONAN,0,0,0,,{\fad(0,300)\c&HFFFFFF&\fs100\move(-68.4,713.2,553,708.8,30,364)\blur3\3c&H000000&}!كونان
Dialogue: 0,0:03:52.53,0:03:54.17,DCMain,KOGORO,0,0,0,,{\an8}.ها قد وصلنا
Dialogue: 0,0:03:54.67,0:03:59.51,DCMain,KOGORO,0,0,0,,هذه أول مرة آتي فيها إلى متنزه كوروتشي
Dialogue: 0,0:03:59.69,0:04:01.38,DCMain,KOGORO,0,0,0,,أين المدخل؟
Dialogue: 0,0:04:09.91,0:04:12.75,DCItalic,KOGORO,0,0,0,,...تذكرت.. هذا المكان
Dialogue: 0,0:04:14.37,0:04:16.52,DCMain,KANAE,0,0,0,,ما الخطب يا موري-سان؟
Dialogue: 0,0:04:16.52,0:04:17.90,DCMain,KOGORO,0,0,0,,!لا شيء
Dialogue: 0,0:04:18.18,0:04:19.87,DCMain,KOGORO,0,0,0,,هيا بنا
Dialogue: 0,0:04:23.22,0:04:25.63,DCMain,KOGORO,0,0,0,,أين هو؟
Dialogue: 0,0:04:25.63,0:04:30.91,DCMain,KOGORO,0,0,0,,...يا دبوس.. يا دبوس.. يا دبوس أين أنت
Dialogue: 0,0:04:33.54,0:04:37.18,DCMain,KOGORO,0,0,0,,!لم نجد شيئًا يدلنا على كنزكِ أو يدلنا على المجرم
Dialogue: 0,0:04:37.18,0:04:38.89,DCMain,KOGORO,0,0,0,,ماذا نفعل الآن؟
Dialogue: 0,0:04:40.73,0:04:41.63,DCMain,KOGORO,0,0,0,,ما ذاك الصوت؟
Dialogue: 0,0:04:43.39,0:04:44.29,DCMain,KOGORO,0,0,0,,ما هذا؟
Dialogue: 0,0:04:48.46,0:04:49.48,DCMain,KOGORO,0,0,0,,ما هذه؟
Dialogue: 0,0:04:50.62,0:04:53.39,DCMain,KANAE,0,0,0,,!إنها كالرسالة التي وصلتني بالضبط
Dialogue: 0,0:04:54.00,0:04:56.19,DCMain,KOGORO,0,0,0,,فلنرَ ما بداخلها
Dialogue: 0,0:04:57.15,0:04:59.21,DCMain,KOGORO,0,0,0,,"طلبتِ مساعدة المحقق موري إذًا
Dialogue: 0,0:04:59.21,0:05:03.39,DCMain,KOGORO,0,0,0,,إذًا فلتستمتعا بالمشي نحو الجحيم
Dialogue: 0,0:05:03.39,0:05:07.95,DCMain,KOGORO,0,0,0,,إذا أردتِ استعادة كنزكِ، فتعالي إلى صالة داداغايا للحفلات
Dialogue: 0,0:05:08.14,0:05:12.05,DCMain,KANAE,0,0,0,,كيف علم المجرم أنني طلبتُ إليك المساعدة؟
Dialogue: 0,0:05:12.05,0:05:17.96,DCMain,KOGORO,0,0,0,,يبدو أنه كان يراقبنا من مكانٍ ما في المتنزه ليتأكد أنكِ أتيتِ لوحدك
Dialogue: 0,0:05:18.72,0:05:26.55,DCMain,KOGORO,0,0,0,,كتب المجرم هذه الرسالة فيما كنا نبحث في المتنزه
Dialogue: 0,0:05:26.97,0:05:32.42,DCMain,KOGORO,0,0,0,,ثم وضعها في هذه الساعة كي نكتشفها
Dialogue: 0,0:05:32.42,0:05:36.64,DCMain,KANAE,0,0,0,,إذًا فالمجرم مختبئٌ هنا في مكان ما
Dialogue: 0,0:05:36.98,0:05:37.48,DCMain,KOGORO,0,0,0,,نعم
Dialogue: 0,0:05:38.12,0:05:43.03,DCMain,KOGORO,0,0,0,,ولكن يبدو أن المجرم يفضّل التعامل مع محقق بدلًا من الشرطة
Dialogue: 0,0:05:43.03,0:05:45.99,DCMain,KOGORO,0,0,0,,!إنه يستهين بموري كوغورو
Dialogue: 0,0:05:46.38,0:05:49.69,DCMain,KOGORO,0,0,0,,فلنذهب إلى صالة داداغايا للحفلات
Dialogue: 0,0:05:54.32,0:05:59.00,DCMain,KOGORO,0,0,0,,على كل حال، أليست المسافة طويلة حتى نصل إليها؟
Dialogue: 0,0:05:59.98,0:06:02.11,DCMain,KANAE,0,0,0,,{\an8}تقع صالة الحفلات في الجانب الشرقي
Dialogue: 0,0:06:03.90,0:06:06.01,DCMain,KOGORO,0,0,0,,يبدو أنها للحفلات الخارجية في الهواء الطلق
Dialogue: 0,0:06:06.21,0:06:07.76,DCMain,KANAE,0,0,0,,نعم، إنها جميلة
Dialogue: 0,0:06:09.30,0:06:09.89,DCMain,KOGORO,0,0,0,,!انتبهي
Dialogue: 0,0:06:21.08,0:06:22.19,DCMain,KANAE,0,0,0,,...تلك السيارة
Dialogue: 0,0:06:22.80,0:06:24.99,DCItalic,KOGORO,0,0,0,,!يحاول قتلنا إذًا
Dialogue: 0,0:06:26.33,0:06:27.45,DCMain,KOGORO,0,0,0,,لا بأس
Dialogue: 0,0:06:29.08,0:06:29.95,DCMain,KOGORO,0,0,0,,ما هذا؟
Dialogue: 0,0:06:36.81,0:06:37.91,DCMain,KANAE,0,0,0,,أعتذر
Dialogue: 0,0:06:38.11,0:06:39.42,DCMain,KANAE,0,0,0,,إنه مهمٌ جدًا
Dialogue: 0,0:06:42.06,0:06:43.82,DCMain,KOGORO,0,0,0,,هيا بنا
Dialogue: 0,0:06:43.82,0:06:44.71,DCMain,KANAE,0,0,0,,حسنًا
Dialogue: 0,0:06:50.84,0:06:56.06,DCMain,KOGORO,0,0,0,,هل يريد أن نجد ذلك الدبوس بعد أن أخفاه هنا في مكانٍ ما؟
Dialogue: 0,0:06:58.21,0:06:59.15,DCMain,KOGORO,0,0,0,,ما هذه؟
Dialogue: 0,0:07:00.40,0:07:03.44,DCMain,KOGORO,0,0,0,,"اذهبا الآن إلى متحف سوتيرو الفنّي"
Dialogue: 0,0:07:03.91,0:07:05.68,DCMain,KOGORO,0,0,0,,هل سنسافر مجددًا؟
Dialogue: 0,0:07:05.68,0:07:08.94,DCMain,KOGORO,0,0,0,,!يقع المتحف غرب المدينة، أي على الجانب المقابل
Dialogue: 0,0:07:13.87,0:07:17.44,DCMain,KANAE,0,0,0,,أعتذر من جعلك تسافر من طرف مدينة طوكيو إلى الطرف الآخر
Dialogue: 0,0:07:18.35,0:07:19.33,DCMain,KOGORO,0,0,0,,لا بأس
Dialogue: 0,0:07:19.72,0:07:21.95,DCMain,KOGORO,0,0,0,,لا تعتذري من شيء
Dialogue: 0,0:07:32.01,0:07:33.09,DCMain,KOGORO,0,0,0,,!كانت وشيكة
Dialogue: 0,0:07:33.65,0:07:35.78,DCMain,KOGORO,0,0,0,,!ربما أسقطها غراب
Dialogue: 0,0:07:35.78,0:07:37.60,DCMain,KOGORO,0,0,0,,!لا بأس، تحدث مثل هذه الأمور كثيرًا
Dialogue: 0,0:07:38.38,0:07:39.89,DCMain,KOGORO,0,0,0,,هلّا نواصل؟
Dialogue: 0,0:07:40.91,0:07:41.39,DCMain,KANAE,0,0,0,,حسنًا
Dialogue: 0,0:07:47.01,0:07:48.81,DCMain,KANAE,0,0,0,,وجدتُ ظرفًا
Dialogue: 0,0:07:48.81,0:07:49.90,DCMain,KOGORO,0,0,0,,ماذا يحوي؟
Dialogue: 0,0:07:50.77,0:07:54.03,DCMain,KOGORO,0,0,0,,"اذهبا الآن إلى شاطئ متنزه هادوسون؟"
Dialogue: 0,0:07:54.62,0:07:57.06,DCMain,KANAE,0,0,0,,شاطئ متنزه هادوسون...؟
Dialogue: 0,0:08:05.03,0:08:06.54,DCMain,KOGORO,0,0,0,,ما هذا؟
Dialogue: 0,0:08:06.83,0:08:10.55,DCMain,KOGORO,0,0,0,,!هذا المكان المشهور للمواعدة وحسب
Dialogue: 0,0:08:10.55,0:08:13.81,DCMain,KOGORO,0,0,0,,!نحن في منتصف الأسبوع وكذلك منتصف النهار\N فهل هذا الوقت مناسبٌ للمواعدة؟
Dialogue: 0,0:08:13.81,0:08:16.05,DCMain,KOGORO,0,0,0,,أليسوا موظفين؟ صحيح؟
Dialogue: 0,0:08:16.05,0:08:18.64,DCMain,KANAE,0,0,0,,...بلى
Dialogue: 0,0:08:20.19,0:08:22.27,DCItalic,KOGORO,0,0,0,,ماذا يحدث؟ هل هو المجرم؟
Dialogue: 0,0:08:23.19,0:08:26.94,DCMain,BOTH,0,0,0,,أنت المحقق العظيم موري كوغورو، صحيح؟
Dialogue: 0,0:08:27.16,0:08:29.36,DCMain,BOTH,0,0,0,,هلّا نلتقط صورةً معك؟
Dialogue: 0,0:08:30.61,0:08:31.86,DCMain,KOGORO,0,0,0,,!لا
Dialogue: 0,0:08:33.84,0:08:36.16,DCMain,WOMAN,0,0,0,,...في الحقيقة، نحن
Dialogue: 0,0:08:36.16,0:08:40.74,DCMain,MAN,0,0,0,,يجب علينا الاعتناء بالأبقار لذا لم نستطع السفر لقضاء شهر العسل
Dialogue: 0,0:08:41.16,0:08:45.66,DCMain,WOMAN,0,0,0,,ولكن أخيرًا استطعنا المجيء إلى طوكيو لنقضي يومين هنا
Dialogue: 0,0:08:45.66,0:08:51.46,DCMain,MAN,0,0,0,,إلا إن الأبقار في انتظارنا، وعلينا أن نسافر هذه الليلة
Dialogue: 0,0:08:53.77,0:08:55.59,DCMain,KOGORO,0,0,0,,التقطي لنا صورة واحدة من فضلك
Dialogue: 0,0:08:56.14,0:08:56.76,DCMain,KANAE,0,0,0,,ماذا؟
Dialogue: 0,0:08:56.94,0:08:58.70,DCMain,KOGORO,0,0,0,,!ابتسما
Dialogue: 0,0:09:02.62,0:09:04.02,DCMain,MAN,0,0,0,,!شكرًا لك
Dialogue: 0,0:09:04.22,0:09:05.39,DCMain,BOTH,0,0,0,,!أسعدتَنا
Dialogue: 0,0:09:05.82,0:09:08.37,DCMain,MAN,0,0,0,,!لن ننسى هذا اليوم ما حيينا
Dialogue: 0,0:09:08.37,0:09:10.40,DCMain,WOMAN,0,0,0,,!شكرًا جزيلًا لك
Dialogue: 0,0:09:11.39,0:09:14.53,DCMain,KOGORO,0,0,0,,!أرجو لكما حياة زوجية طيبة
Dialogue: 0,0:09:14.53,0:09:15.32,DCMain,KOGORO,0,0,0,,!انتظري
Dialogue: 0,0:09:15.32,0:09:15.78,DCMain,KANAE,0,0,0,,نعم؟
Dialogue: 0,0:09:16.12,0:09:18.28,DCMain,KOGORO,0,0,0,,!هذا ليس الوقت المناسب للهو
Dialogue: 0,0:09:20.66,0:09:23.42,DCMain,KANAE,0,0,0,,هل نبحث حول ذلك التمثال؟
Dialogue: 0,0:09:28.11,0:09:28.92,DCMain,KANAE,0,0,0,,ما الخطب؟
Dialogue: 0,0:09:29.13,0:09:30.92,DCMain,KOGORO,0,0,0,,لا شيء
Dialogue: 0,0:09:34.22,0:09:36.27,DCMain,KANAE,0,0,0,,انظر هنا
Dialogue: 0,0:09:36.27,0:09:37.47,DCMain,KOGORO,0,0,0,,هل وجدتِ شيئًا؟
Dialogue: 0,0:09:38.29,0:09:40.97,DCMain,KOGORO,0,0,0,,"اذهبا الآن إلى كنيسة هيبونزاكا؟"
Dialogue: 0,0:09:42.49,0:09:46.01,DCMain,KANAE,0,0,0,,ألا تقع كنيسة هيبونزاكا في ضواحي طوكيو؟
Dialogue: 0,0:09:46.01,0:09:47.98,DCMain,KOGORO,0,0,0,,نعم شمال المدينة
Dialogue: 0,0:09:48.68,0:09:51.28,DCItalic,KOGORO,0,0,0,,لا شك في أنه يتلاعب بنا
Dialogue: 0,0:09:51.93,0:09:55.71,DCItalic,KOGORO,0,0,0,,...يحاول المجرم قتل هذه المرأة ولكن
Dialogue: 0,0:09:56.92,0:09:58.24,DCItalic,KOGORO,0,0,0,,!ذاك الوغد
Dialogue: 0,0:10:00.24,0:10:03.27,DCMain,KOGORO,0,0,0,,ماذا تفعل هنا يا صعلوك؟
Dialogue: 0,0:10:06.06,0:10:09.25,DCMain,KOGORO,0,0,0,,تبًا! لمَ تبعتني؟
Dialogue: 0,0:10:09.50,0:10:11.94,DCMain,KOGORO,0,0,0,,ستعود إلى المنزل فورما تنتهي من الأكل
Dialogue: 0,0:10:11.94,0:10:13.84,DCMain,KANAE,0,0,0,,لا بأس يا موري-سان
Dialogue: 0,0:10:13.84,0:10:16.16,DCMain,KANAE,0,0,0,,سأذهب إلى الحمام
Dialogue: 0,0:10:16.16,0:10:18.60,DCMain,KOGORO,0,0,0,,أجل لا بأس
Dialogue: 0,0:10:18.60,0:10:22.81,DCMain,CONAN,0,0,0,,إذًا ما رأيك في هذه القضية؟
Dialogue: 0,0:10:24.16,0:10:31.02,DCMain,CONAN,0,0,0,,هل اكتشفت الرابط بين الأماكن التي زرتها؟
Dialogue: 0,0:10:31.02,0:10:33.24,DCMain,KOGORO,0,0,0,,!لا أعلم
Dialogue: 0,0:10:33.24,0:10:35.23,DCMain,KOGORO,0,0,0,,...هذه أول مرة
Dialogue: 0,0:10:35.23,0:10:36.15,DCMain,KOGORO,0,0,0,,!لا
Dialogue: 0,0:10:36.56,0:10:40.57,DCMain,KOGORO,0,0,0,,أتيتُ من قبل إلى منطقة بالقرب من متنزه كوروتشي
Dialogue: 0,0:10:40.57,0:10:41.42,DCMain,CONAN,0,0,0,,ماذا؟
Dialogue: 0,0:10:41.42,0:10:43.03,DCMain,KOGORO,0,0,0,,منذ سنتين
Dialogue: 0,0:10:43.03,0:10:49.96,DCMain,KOGORO,0,0,0,,أتيتُ للتحقيق في قضية موت عضو برلمان\N يكرهه أغلب الناس وقد مات ميتةً غامضة
Dialogue: 0,0:10:50.54,0:10:54.80,DCMain,KOGORO,0,0,0,,تأكدتُ أنها جريمة قتل فرأيتُ مخطط المجرم وتتبعته
Dialogue: 0,0:10:55.61,0:11:03.01,DCMain,KOGORO,0,0,0,,{\an8}اسمه ناغاكورا ريوجي، وكان يدير شركة نشر دفاتر رسم مع صديقه
Dialogue: 0,0:11:04.78,0:11:09.10,DCMain,KOGORO,0,0,0,,استدرجته إلى سطح الشركة ثم واجهته باستنتاجي
Dialogue: 0,0:11:10.03,0:11:14.34,DCMain,KOGORO,0,0,0,,..فأكّد لي كل شيء ولم يعترض على كلامي قط ولكن
Dialogue: 0,0:11:15.53,0:11:17.82,DCItalic,NAGAKURA,0,0,0,,إنه شيطان فاسد في المجتمع
Dialogue: 0,0:11:18.31,0:11:24.98,DCItalic,NAGAKURA,0,0,0,,لا أندم على قتله من أجل معتقداتي
Dialogue: 0,0:11:25.78,0:11:30.33,DCItalic,NAGAKURA,0,0,0,,إلا إنني أشكّ في أن المجتمع أو المحاكم سيفهمون هذا
Dialogue: 0,0:11:32.04,0:11:40.63,DCMain,KOGORO,0,0,0,,وبعد اعتقاله، أمضى ناغاكورا حياته في السجن قبل أن تبدأ محاكمته
Dialogue: 0,0:11:45.35,0:11:47.83,DCMain,CONAN,0,0,0,,هل حللت تلك القضية؟
Dialogue: 0,0:11:47.83,0:11:51.10,DCMain,KOGORO,0,0,0,,!نعم! قلت لك إنني محققٌ عظيم
Dialogue: 0,0:11:51.83,0:11:57.63,DCMain,KOGORO,0,0,0,,ربما قرر الانتحار حين كشفتُ الحقيقة آنذاك
Dialogue: 0,0:11:58.22,0:12:01.54,DCMain,KOGORO,0,0,0,,حدث ذلك على سطح الشركة التي تقابل متنزه كوروتشي
Dialogue: 0,0:12:03.20,0:12:06.21,DCMain,KOGORO,0,0,0,,إنها قصة قديمة
Dialogue: 0,0:12:06.21,0:12:09.49,DCMain,KOGORO,0,0,0,,أما الآن، فيحاول أحدهم قتل كاناي-سان
Dialogue: 0,0:12:10.41,0:12:11.50,DCItalic,CONAN,0,0,0,,...في الحقيقة
Dialogue: 0,0:12:11.98,0:12:15.00,DCItalic,MAN,0,0,0,,!لا أصدق أن عائلة قطط ظهرت أمامي فجأة
Dialogue: 0,0:12:15.29,0:12:18.00,DCItalic,WOMAN,0,0,0,,!وقعت مني من الطابق الثالث إلا إنها لم تنكسر
Dialogue: 0,0:12:18.19,0:12:21.35,DCItalic,MAN,0,0,0,,علمتُ أن التمرّن هنا خطر
Dialogue: 0,0:12:21.96,0:12:24.39,DCItalic,CONAN,0,0,0,,كانت حوادثًا عرضية...
Dialogue: 0,0:12:25.81,0:12:29.89,DCMain,KOGORO,0,0,0,,دعني أركز في القضية
Dialogue: 0,0:12:29.89,0:12:32.20,DCMain,KOGORO,0,0,0,,أنهِ واجباتك المدرسية أو افعل أي شيء
Dialogue: 0,0:12:32.96,0:12:35.27,DCMain,KOGORO,0,0,0,,أخبر ران بأنني سأتأخر في العودة
Dialogue: 0,0:12:35.63,0:12:36.77,DCMain,CONAN,0,0,0,,طيب
Dialogue: 0,0:12:45.17,0:12:52.58,DCItalic,CONAN,0,0,0,,لا شك في وجود رابط مشترك بين الأماكن التي حددها المجرم
Dialogue: 0,0:12:54.06,0:12:55.20,DCItalic,CONAN,0,0,0,,لا شك في ذلك
Dialogue: 0,0:12:56.06,0:12:57.00,DCItalic,CONAN,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:12:58.82,0:13:00.30,DCMain,CONAN,0,0,0,,هل حدث شيء يا سيدي؟
Dialogue: 0,0:13:01.36,0:13:06.60,DCMain,POLICE,0,0,0,,نعم، أفكر في هذه
Dialogue: 0,0:13:06.60,0:13:08.51,DCMain,CONAN,0,0,0,,ألم تسقط جراء حادث؟
Dialogue: 0,0:13:09.04,0:13:12.13,DCMain,POLICE,0,0,0,,لكن لم يحدث هنا أي حادث
Dialogue: 0,0:13:12.59,0:13:16.26,DCMain,POLICE,0,0,0,,ولم أسمع بموت أحدٍ أيضًا
Dialogue: 0,0:13:17.84,0:13:19.87,DCItalic,CONAN,0,0,0,,بدأ عمي من المتنزه
Dialogue: 0,0:13:19.87,0:13:25.53,DCItalic,CONAN,0,0,0,,...ثم زار صالة الحفلات والمتحف وشاطئ المتنزه والكنيسة و
Dialogue: 0,0:13:27.19,0:13:28.63,DCItalic,CONAN,0,0,0,,هل يمكن هذا؟
Dialogue: 0,0:13:37.17,0:13:39.33,DCMain,KOGORO,0,0,0,,فكرتُ في القضية مليًا
Dialogue: 0,0:13:39.89,0:13:43.78,DCMain,KOGORO,0,0,0,,لمَ يستدرجنا المجرم إلى أماكن مختلفة؟
Dialogue: 0,0:13:43.78,0:13:48.01,DCMain,KOGORO,0,0,0,,يبدو أنه يريد أن ندرك شيئًا
Dialogue: 0,0:13:48.99,0:13:54.81,DCMain,KOGORO,0,0,0,,متنزه كوروتشي، وصالة داداغايا للحفلات\N ومتحف سوتيرو، وشاطئ متنزه هادوسون
Dialogue: 0,0:13:54.81,0:13:58.02,DCMain,KOGORO,0,0,0,,والآن ذاهبان إلى كنيسة هيبونزاكا
Dialogue: 0,0:13:58.42,0:14:04.32,DCMain,KOGORO,0,0,0,,لكل موقع ذكرى ومعنى خاص به، ويريد المجرم أن تدركي هذا
Dialogue: 0,0:14:04.32,0:14:09.03,DCMain,KOGORO,0,0,0,,أشعر بأن المجرم يلحّ عليكِ بهذا
Dialogue: 0,0:14:09.29,0:14:14.13,DCMain,KOGORO,0,0,0,,ألا تعلمين ما السبب يا كاناي-سان؟
Dialogue: 0,0:14:14.13,0:14:17.12,DCMain,KANAE,0,0,0,,ما رأيك يا موري-سان؟
Dialogue: 0,0:14:17.12,0:14:18.04,DCMain,KOGORO,0,0,0,,رأيي؟
Dialogue: 0,0:14:18.44,0:14:22.16,DCMain,KOGORO,0,0,0,,أنا أحقق في القضية وحسب، لا أعلم شيئًا
Dialogue: 0,0:14:22.16,0:14:24.38,DCMain,KANAE,0,0,0,,على الرغم من أنك أعظم محقق في البلاد؟
Dialogue: 0,0:14:25.29,0:14:29.05,DCMain,KOGORO,0,0,0,,أعتذر، لا يمكنني معرفة كل ما أجهله
Dialogue: 0,0:14:29.05,0:14:31.25,DCMain,KOGORO,0,0,0,,موقفي صعب
Dialogue: 0,0:14:36.22,0:14:37.62,DCMain,CONAN,0,0,0,,{\an8}!لو سمحت
Dialogue: 0,0:14:38.31,0:14:39.92,DCMain,CONAN,0,0,0,,أنت تعمل هنا، صحيح؟
Dialogue: 0,0:14:39.92,0:14:43.78,DCMain,CONAN,0,0,0,,أنا مساعد المحقق موري كوغورو
Dialogue: 0,0:14:43.78,0:14:46.07,DCMain,SHIDA,0,0,0,,هل تعمل عند موري-سان؟
Dialogue: 0,0:14:46.40,0:14:52.83,DCMain,CONAN,0,0,0,,طلب إلي سؤالك عن ناغاكورا ريوجي-سان الذي توفي منذ سنتين
Dialogue: 0,0:14:54.26,0:14:55.27,DCMain,KOGORO,0,0,0,,{\an8}.وجدتها
Dialogue: 0,0:14:55.83,0:14:59.57,DCMain,KOGORO,0,0,0,,ما المكان التالي يا ترى؟
Dialogue: 0,0:15:01.05,0:15:03.00,DCMain,KANAE,0,0,0,,خريطة؟
Dialogue: 0,0:15:03.58,0:15:08.15,DCMain,KANAE,0,0,0,,12, 1, 29\Nما معنى هذه الأرقام؟
Dialogue: 0,0:15:08.15,0:15:10.26,DCMain,KOGORO,0,0,0,,قد يكون عنوانًا؟
Dialogue: 0,0:15:10.92,0:15:14.68,DCMain,KOGORO,0,0,0,,على كل حال فلنستخدمها لتحديد الموقع التالي
Dialogue: 0,0:15:17.49,0:15:21.17,DCItalic,KOGORO,0,0,0,,يقع تقاطع أوماغاري في ضواحي طوكيو
Dialogue: 0,0:15:21.17,0:15:24.89,DCItalic,KOGORO,0,0,0,,...وإذا كان يقع بين ضواحي طوكيو وتقاطع شيرايتو فهذا يعني
Dialogue: 0,0:15:27.21,0:15:31.20,DCItalic,KOGORO,0,0,0,,...هكذا إذًا! إذا فكرت بها بتلك الطريقة
Dialogue: 0,0:15:31.94,0:15:34.56,DCMain,KANAE,0,0,0,,!موري-سان! موري-سان
Dialogue: 0,0:15:36.46,0:15:38.39,DCMain,KOGORO,0,0,0,,"تعالي وخذيه عند المقبرة"
Dialogue: 0,0:15:39.26,0:15:42.96,DCMain,KOGORO,0,0,0,,!يبدو أن المكان التالي هو خط النهاية
Dialogue: 0,0:15:43.33,0:15:44.53,DCMain,KANAE,0,0,0,,أليست تلك...؟
Dialogue: 0,0:15:46.15,0:15:48.70,DCMain,KOGORO,0,0,0,,نعم، إنها المقبرة
Dialogue: 0,0:15:50.28,0:15:53.97,DCMain,KANAE,0,0,0,,هل يخطط المجرم لاستدراجي هناك ثم...؟
Dialogue: 0,0:15:56.99,0:15:58.97,DCMain,KOGORO,0,0,0,,فلنذهب إلى هناك
Dialogue: 0,0:15:59.94,0:16:01.48,DCMain,CONAN,0,0,0,,حقًا؟
Dialogue: 0,0:16:01.48,0:16:06.21,DCMain,CONAN,0,0,0,,هل ترك ذلك الشخص الورود هنا صباح اليوم وقال هذا؟
Dialogue: 0,0:16:06.21,0:16:07.51,DCMain,WOMAN,0,0,0,,نعم
Dialogue: 0,0:16:07.51,0:16:08.77,DCMain,WOMAN,0,0,0,,!انتظر
Dialogue: 0,0:16:10.73,0:16:12.74,DCItalic,CONAN,0,0,0,,لا شك في هذا
Dialogue: 0,0:16:20.87,0:16:22.25,DCMain,CONAN,0,0,0,,!لم يردّ
Dialogue: 0,0:16:23.92,0:16:25.16,DCItalic,CONAN,0,0,0,,ماذا أفعل؟
Dialogue: 0,0:16:31.48,0:16:34.13,DCMain,CONAN,0,0,0,,!لدي سؤال أخير
Dialogue: 0,0:16:34.13,0:16:36.39,DCMain,CONAN,0,0,0,,أين قبر ناغاكورا-سان؟
Dialogue: 0,0:16:48.61,0:16:53.76,DCMain,KOGORO,0,0,0,,خططتِ لإحضاري هنا منذ البداية
Dialogue: 0,0:16:55.45,0:17:00.54,DCMain,KOGORO,0,0,0,,لم أفهم إلا حين علمتُ أن مكاننا التالي هو مقبرة أوكاغاوكا
Dialogue: 0,0:17:01.45,0:17:05.75,DCMain,KOGORO,0,0,0,,أنا الشخص المُتلاعَب به وليس أنتِ
Dialogue: 0,0:17:06.68,0:17:10.41,DCMain,KOGORO,0,0,0,,زرتُ هذا القبر من قبل
Dialogue: 0,0:17:11.55,0:17:13.44,DCItalic,CONAN,0,0,0,,هل اكتشفت الأمر أيها العجوز؟
Dialogue: 0,0:17:13.44,0:17:15.76,DCItalic,CONAN,0,0,0,,لا داعي لأتدخل إذًا
Dialogue: 0,0:17:16.54,0:17:22.77,DCMain,KOGORO,0,0,0,,كذبتِ فقلتِ إن دبوسكِ الثمين قد سُرق لتستدرجينني إلى هنا وحسب
Dialogue: 0,0:17:23.50,0:17:26.02,DCMain,KOGORO,0,0,0,,لم أعلم عنكِ شيئًا في البداية
Dialogue: 0,0:17:26.30,0:17:30.02,DCMain,KOGORO,0,0,0,,ولكن حين رأيتُ ذلك الخاتم في حقيبتك
Dialogue: 0,0:17:30.53,0:17:35.03,DCMain,KOGORO,0,0,0,,علمتُ أنكِ خطيبة ناغاكورا ريوجي-سان
Dialogue: 0,0:17:35.61,0:17:40.03,DCMain,KOGORO,0,0,0,,أخذتِني في جولة إلى عدة أماكن\Nتملؤها الذكريات وأخيرًا أتيتِ بي إلى قبره
Dialogue: 0,0:17:40.26,0:17:41.53,DCMain,KANAE,0,0,0,,ألن تنام؟
Dialogue: 0,0:17:43.26,0:17:44.04,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:17:44.54,0:17:47.95,DCMain,KANAE,0,0,0,,ألا تنام دائمًا حين تبدأ عرض استنتاجاتك؟
Dialogue: 0,0:17:47.95,0:17:49.96,DCMain,KOGORO,0,0,0,,...في الحقيقة
Dialogue: 0,0:17:51.24,0:17:52.59,DCMain,KANAE,0,0,0,,..إن لم تنَم
Dialogue: 0,0:17:54.62,0:17:56.84,DCMain,KANAE,0,0,0,,!فسأنوِّمك بنفسي
Dialogue: 0,0:17:58.35,0:17:58.93,DCMain,KOGORO,0,0,0,,!مخطئة
Dialogue: 0,0:18:00.08,0:18:02.37,DCMain,KOGORO,0,0,0,,..ربما تجهلين هذا
Dialogue: 0,0:18:02.37,0:18:06.59,DCMain,KOGORO,0,0,0,,ولكنني لم أنم حين حللتُ تلك القضية
Dialogue: 0,0:18:08.14,0:18:14.86,DCMain,KOGORO,0,0,0,,أقسمتِ على الانتقام مني مُذ مات ناغاكورا
Dialogue: 0,0:18:15.10,0:18:16.54,DCMain,KANAE,0,0,0,,!بالطبع
Dialogue: 0,0:18:16.54,0:18:19.56,DCMain,KANAE,0,0,0,,!لو لم تتبجح وتكشف الحقيقة في ذلك الحين لما اعتُقل خطيبي
Dialogue: 0,0:18:32.21,0:18:34.88,DCMain,KANAE,0,0,0,,ها قد نمتَ إذًا
Dialogue: 0,0:18:34.88,0:18:39.80,DCMain,KOGORO,0,0,0,,أظن أن هذه الوضعية مناسبة لعرض استنتاجاتي كالعادة
Dialogue: 0,0:18:40.29,0:18:44.51,DCMain,KOGORO,0,0,0,,:قال الناس الذين يعرفونه حق المعرفة كالتالي
Dialogue: 0,0:18:44.51,0:18:49.56,DCMain,KOGORO,0,0,0,,"كان ناغاكورا-سان هادئًا ويحب الموسيقى والفنّ"
Dialogue: 0,0:18:50.83,0:18:55.73,DCMain,KOGORO,0,0,0,,فهل التقيتما في صالة داداغايا للاحتفالات؟
Dialogue: 0,0:18:57.89,0:19:01.32,DCMain,KOGORO,0,0,0,,وأول مكان ذهبتما إليه كان متحف سوتيرو
Dialogue: 0,0:19:03.12,0:19:06.96,DCMain,KOGORO,0,0,0,,ثم عشتما أحلى اللحظات عند شاطئ متنزه هادوسون
Dialogue: 0,0:19:08.07,0:19:13.28,DCMain,KOGORO,0,0,0,,وخططتما للزواج في كنيسة هيبونزاكا
Dialogue: 0,0:19:14.10,0:19:20.09,DCMain,KOGORO,0,0,0,,إلا إن موت ناغاكورا حطّم كل أحلامكما
Dialogue: 0,0:19:20.60,0:19:21.98,DCMain,KANAE,0,0,0,,صحيح
Dialogue: 0,0:19:21.98,0:19:27.23,DCMain,KANAE,0,0,0,,دمّرتَ ماضينا ومستقبلنا
Dialogue: 0,0:19:27.71,0:19:29.56,DCMain,KANAE,0,0,0,,...بعد أن أخذتك في جولة
Dialogue: 0,0:19:32.98,0:19:38.11,DCMain,KANAE,0,0,0,,!هنا أمام قبره، قررتُ أن ألحقك به
Dialogue: 0,0:19:38.39,0:19:40.36,DCMain,KOGORO,0,0,0,,..وأنتِ
Dialogue: 0,0:19:46.60,0:19:51.87,DCItalic,KANAE,0,0,0,,كل شيءٍ انتهى حين حاصرك ذلك الرجل على السطح يا عزيزي
Dialogue: 0,0:19:52.82,0:19:56.04,DCItalic,KANAE,0,0,0,,سألحقك قريبًا
Dialogue: 0,0:19:57.14,0:19:59.88,DCMain,KOGORO,0,0,0,,خططتِ للحاق بناغاكورا-سان هنا..
Dialogue: 0,0:20:00.31,0:20:03.13,DCMain,KANAE,0,0,0,,اتخذتُ قراري حين مات
Dialogue: 0,0:20:03.30,0:20:05.64,DCMain,KOGORO,0,0,0,,لكنّكِ لم تفعلي شيئًا منذ سنتين
Dialogue: 0,0:20:05.87,0:20:08.84,DCMain,KOGORO,0,0,0,,!لا يريد ناغاكورا-سان حدوث هذا
Dialogue: 0,0:20:08.84,0:20:09.83,DCMain,KANAE,0,0,0,,!أنت مخطئ
Dialogue: 0,0:20:09.83,0:20:11.66,DCMain,KOGORO,0,0,0,,!بل تعلمين هذا
Dialogue: 0,0:20:11.66,0:20:15.65,DCMain,KANAE,0,0,0,,أنت مخطئ! بقيتُ حية حتى الآن لأن أمي ماتت الأسبوع الماضي وحسب
Dialogue: 0,0:20:15.65,0:20:17.93,DCMain,KANAE,0,0,0,,—لو فعلتُ هذا من قبل، لحزنت أمي حزنًا شديدًا
Dialogue: 0,0:20:17.93,0:20:21.03,DCMain,KOGORO,0,0,0,,!بغض النظر عمّن سيحزن عليكِ، إذا أصرّ المرء على فعل شيء، فسيفعله
Dialogue: 0,0:20:21.32,0:20:23.23,DCMain,KOGORO,0,0,0,,!ارمي تلك السكين
Dialogue: 0,0:20:23.77,0:20:27.14,DCMain,KOGORO,0,0,0,,—انتظرتِ حتى هذا اليوم لأنكِ تعلمين أن ناغاكورا-سان لا يريد هذا
Dialogue: 0,0:20:27.14,0:20:28.03,DCMain,KANAE,0,0,0,,!!!أنت مخطئ
Dialogue: 0,0:20:28.03,0:20:28.62,DCItalic,CONAN,0,0,0,,!تبًا
Dialogue: 0,0:20:39.99,0:20:43.97,DCMain,KANAE,0,0,0,,...لا أجرؤ على هذا
Dialogue: 0,0:20:45.00,0:20:46.68,DCMain,KANAE,0,0,0,,...رأيتك
Dialogue: 0,0:20:47.34,0:20:51.90,DCMain,KANAE,0,0,0,,رأيت الوجه البريء للشخص الذي أكرهه
Dialogue: 0,0:20:52.57,0:20:54.19,DCMain,KANAE,0,0,0,,وكَذا لطافتك
Dialogue: 0,0:20:54.76,0:20:57.19,DCMain,KANAE,0,0,0,,واعترافك بالعجز في الأمور التي تجهلها ولم تدَّعِ المعرفة
Dialogue: 0,0:20:58.08,0:21:01.69,DCMain,KANAE,0,0,0,,وقد أنقذتني عدة مرات
Dialogue: 0,0:21:02.99,0:21:04.99,DCMain,KANAE,0,0,0,,..لا أجرؤ على قتلك
Dialogue: 0,0:21:05.90,0:21:09.21,DCMain,KANAE,0,0,0,,!بعد أن رأيتُ كل هذا منك..
Dialogue: 0,0:21:10.39,0:21:12.30,DCMain,KANAE,0,0,0,,!ولا أحد كذلك
Dialogue: 0,0:22:51.91,0:22:53.88,DCMain,KOGORO,0,0,0,,!كاناي-سان! لا تتسرعي
Dialogue: 0,0:22:56.28,0:22:58.98,DCMain,KOGORO,0,0,0,,!لـ- ليست هنا! كاناي-سان
Dialogue: 0,0:22:58.98,0:23:01.28,DCMain,KOGORO,0,0,0,,...رأسي
Dialogue: 0,0:23:01.28,0:23:03.54,DCMain,CONAN,0,0,0,,غادرت تلك المرأة
Dialogue: 0,0:23:03.54,0:23:07.24,DCMain,KOGORO,0,0,0,,ماذا؟! هل لحقتني مجددًا؟
Dialogue: 0,0:23:07.46,0:23:11.18,DCMain,KOGORO,0,0,0,,!المهم أنها خططت لقتلي ثم الانتحار
Dialogue: 0,0:23:11.18,0:23:13.05,DCMain,CONAN,0,0,0,,كل شيءٍ على ما يرام
Dialogue: 0,0:23:13.05,0:23:13.99,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:23:14.27,0:23:21.00,DCMain,CONAN,0,0,0,,طلبت إليّ أن أشكرك جراء ما فعلته معها
Dialogue: 0,0:23:21.88,0:23:23.18,DCMain,KOGORO,0,0,0,,حقًا؟
Dialogue: 0,0:23:23.18,0:23:25.36,DCMain,CONAN,0,0,0,,!فقد منعتَ حدوث جريمة قتل
Dialogue: 0,0:23:25.36,0:23:27.17,DCMain,CONAN,0,0,0,,!هذا رائع يا عمي
Dialogue: 0,0:23:27.17,0:23:28.48,DCMain,KOGORO,0,0,0,,أصبت
Dialogue: 0,0:23:28.48,0:23:30.72,DCMain,CONAN,0,0,0,,!أنت أعظم محققٍ في البلاد حقًا
Dialogue: 0,0:23:31.01,0:23:32.01,DCMain,KOGORO,0,0,0,,!أصبت
Dialogue: 0,0:23:32.31,0:23:33.12,DCMain,KOGORO,0,0,0,,أرأيت؟
Dialogue: 0,0:23:33.12,0:23:38.86,DCMain,KOGORO,0,0,0,,!أنقذتُ امرأة وجعلتها تكمل حياتها
Dialogue: 0,0:23:40.34,0:23:42.97,DCItalic,CONAN,0,0,0,,!نعم، لك جزءٌ من الفضل هذه المرة
Dialogue: 0,0:23:45.29,0:23:49.03,DCMain,SATO,0,0,0,,هلّا تحدثنا أكثر عن القضية؟
Dialogue: 0,0:23:50.28,0:23:53.05,DCMain,MAN,0,0,0,,أعتذر، لا أستطيع
Dialogue: 0,0:23:53.05,0:23:57.03,DCMain,MAN,0,0,0,,لا يمكننا تسليم معلومات عملائنا لأي أحد
Dialogue: 0,0:23:57.03,0:24:00.79,DCMain,MEGURE,0,0,0,,!استدعوا جميع الضباط واعتقلوا جميع المشبوهين
Dialogue: 0,0:24:01.30,0:24:04.79,DCItalic,CONAN,0,0,0,,!يوجد مخطط يظهر أجهزة التفجير عن بعد
Dialogue: 0,0:24:05.75,0:24:09.05,DCItalic,CONAN,0,0,0,,!أين هو؟ أين زر التفجير؟
Dialogue: 0,0:24:30.54,0:24:33.23,DCMain,KOGORO,0,0,0,,!تلميح كونان القادم
Dialogue: 0,0:24:33.23,0:24:34.99,DCMain,CONAN,0,0,0,,!لص
Dialogue: 0,0:24:34.99,0:24:35.84,DCMain,CONAN,0,0,0,,{\fad(300,300)\an7\fs70\fnAsmaa Font\bord10\blur10\3c&H8372EE&\b1}هل خسرت رهانك على الخيول؟
Dialogue: 0,0:24:35.84,0:24:37.51,DCMain,KOGORO,0,0,0,,{\fad(300,300)\an7\fs70\fnAsmaa Font\bord10\blur10\3c&H7399EE&\b1}!الوداع يا فوكوزاوا يوكيتشي-ساما
