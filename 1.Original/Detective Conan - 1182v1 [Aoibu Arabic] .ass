Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS \NX : @Theconansign
Dialogue: 0,0:00:29.45,0:00:31.73,Default,,0,0,0,,.أشعر وكأنني رأيته من قبل
Dialogue: 0,0:00:38.48,0:00:40.14,Default,,0,0,0,,!إنه هو
Dialogue: 0,0:01:01.39,0:01:02.43,Default,,0,0,0,,!الوضع طارئ، يا رفاق
Dialogue: 0,0:01:02.43,0:01:04.06,Default,,0,0,0,,!أعتقد أنني وجدت أحدًا
Dialogue: 0,0:01:06.89,0:01:09.47,Default,,0,0,0,,ماذا تخفي خلف قناعك المحطم؟
Dialogue: 0,0:01:09.47,0:01:10.97,Default,,0,0,0,,من هو الشخص الذي رأته أيومي؟
Dialogue: 0,0:01:10.97,0:01:13.47,Default,,0,0,0,,!وراءه، يا فريق المحققين الصغار
Dialogue: 0,0:01:13.47,0:01:15.22,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:01:15.22,0:01:16.97,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:01:16.97,0:01:19.98,Default,,0,0,0,,!اسمه هو المحقق كونان
Dialogue: 0,0:03:01.43,0:03:03.64,Default,,0,0,0,,"!اقبض على ذلك الوجه"
Dialogue: 0,0:03:10.39,0:03:12.23,Default,,0,0,0,,ماذا الان يا كونان؟
Dialogue: 0,0:03:13.06,0:03:15.16,Default,,0,0,0,,.لا أستطيع رؤية وجهه
Dialogue: 0,0:03:15.72,0:03:18.09,Default,,0,0,0,,.لقد بدا تمامًا مثله
Dialogue: 0,0:03:18.09,0:03:20.72,Default,,0,0,0,,.كيتو كين، 32 عامًا
Dialogue: 0,0:03:20.72,0:03:23.56,Default,,0,0,0,,ارتكب جريمة سرقة وقتل منذ خمس سنوات
Dialogue: 0,0:03:23.56,0:03:25.18,Default,,0,0,0,,.ولا يزال طليقًا
Dialogue: 0,0:03:25.18,0:03:27.48,Default,,0,0,0,,.هناك مكافأة بقيمة ثلاثة ملايين ين مقابل القبض عليه
Dialogue: 0,0:03:27.48,0:03:29.80,Default,,0,0,0,,.إذا كان هو حقًا، إذن فقد أحسنتِ
Dialogue: 0,0:03:29.80,0:03:30.98,Default,,0,0,0,,.نعم
Dialogue: 0,0:03:31.24,0:03:35.11,Default,,0,0,0,,.لوحة الاسم بجانب ذلك الشقة مكتوب عليها يامادا تارو
Dialogue: 0,0:03:35.46,0:03:37.86,Default,,0,0,0,,.يبدو وكأنه اسم مستعار
Dialogue: 0,0:03:38.22,0:03:39.43,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:03:39.43,0:03:44.24,Default,,0,0,0,,!لنلقِ القبض على ذلك المطلوب ونحصل على المكافأة
Dialogue: 0,0:03:44.24,0:03:45.24,Default,,0,0,0,,!نعم
Dialogue: 0,0:03:45.24,0:03:46.38,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:03:46.99,0:03:48.36,Default,,0,0,0,,.عليكم مغادرة المكان
Dialogue: 0,0:03:48.36,0:03:49.88,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:03:49.88,0:03:52.91,Default,,0,0,0,,.قد يكون سارقًا وقاتلًا
Dialogue: 0,0:03:52.91,0:03:54.13,Default,,0,0,0,,.الأمر خطير للغاية
Dialogue: 0,0:03:54.13,0:03:57.52,Default,,0,0,0,,!سيكون الأمر أكثر خطورة لو تركناكما هنا
Dialogue: 0,0:03:57.52,0:03:59.60,Default,,0,0,0,,!نعم، هذا صحيح
Dialogue: 0,0:03:59.60,0:04:02.22,Default,,0,0,0,,ماذا تفعلون أيها الأطفال؟
Dialogue: 0,0:04:04.30,0:04:06.64,Default,,0,0,0,,هل تتجسسون على شخص ما؟
Dialogue: 0,0:04:06.64,0:04:09.39,Default,,0,0,0,,...لا، في الواقع
Dialogue: 0,0:04:09.39,0:04:12.65,Default,,0,0,0,,.قد نكون وجدنا مجرمًا مطلوبًا
Dialogue: 0,0:04:12.65,0:04:15.53,Default,,0,0,0,,.رجل اسمه كيتو موجود في تلك الشقة
Dialogue: 0,0:04:15.53,0:04:17.45,Default,,0,0,0,,...هناك مكافأة ثلاثة ملايين ين
Dialogue: 0,0:04:17.45,0:04:18.90,Default,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:04:22.08,0:04:23.16,Default,,0,0,0,,...أسف
Dialogue: 0,0:04:23.16,0:04:24.79,Default,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:04:27.41,0:04:30.29,Default,,0,0,0,,مستحيل، أليس كذلك؟
Dialogue: 0,0:04:33.10,0:04:34.30,Default,,0,0,0,,!إنه مثله تمامًا
Dialogue: 0,0:04:35.51,0:04:37.05,Default,,0,0,0,,إذن فهو نفسه حقًا؟
Dialogue: 0,0:04:37.40,0:04:41.30,Default,,0,0,0,,.من الممكن أن يكون لديهما نفس الوجه تمامًا
Dialogue: 0,0:04:41.30,0:04:42.80,Default,,0,0,0,,...لكن
Dialogue: 0,0:04:53.81,0:04:55.44,Default,,0,0,0,,.يجب أن تذهبوا
Dialogue: 0,0:04:55.44,0:04:56.77,Default,,0,0,0,,.سنتواصل معكم لاحقًا
Dialogue: 0,0:04:57.44,0:05:00.36,Default,,0,0,0,,!مهلاً، من الخطير أن تذهبوا وحدكم أيها الأطفال
Dialogue: 0,0:05:05.36,0:05:06.95,Default,,0,0,0,,إلى أين هو ذاهب؟
Dialogue: 0,0:05:06.95,0:05:10.21,Default,,0,0,0,,ماذا لو كان يختار ضحية جديدة؟
Dialogue: 0,0:05:10.21,0:05:13.46,Default,,0,0,0,,.الأهم من ذلك، يمكنكم أنتم الأطفال المغادرة أيضًا
Dialogue: 0,0:05:13.74,0:05:17.21,Default,,0,0,0,,أنت تريد المكافأة لنفسك فقط، أليس كذلك؟
Dialogue: 0,0:05:17.21,0:05:20.25,Default,,0,0,0,,...ليس كذلك، أنا فقط
Dialogue: 0,0:05:23.83,0:05:25.22,Default,,0,0,0,,طبيب أسنان؟
Dialogue: 0,0:05:25.22,0:05:26.97,Default,,0,0,0,,ربما أسنانه تؤلمه؟
Dialogue: 0,0:05:26.97,0:05:29.52,Default,,0,0,0,,.ربما هو خائف من طبيب الأسنان
Dialogue: 0,0:05:29.52,0:05:32.02,Default,,0,0,0,,.يا له من جبان
Dialogue: 0,0:05:32.68,0:05:33.96,Default,,0,0,0,,!قلت لكم أن تذهبوا
Dialogue: 0,0:05:33.96,0:05:36.61,Default,,0,0,0,,.إذا صرخت، سيلاحظ أننا نتبعه
Dialogue: 0,0:05:37.16,0:05:38.36,Default,,0,0,0,,...تباً
Dialogue: 0,0:05:39.03,0:05:43.62,Default,,0,0,0,,.على أي حال، من الغريب أن يخاف بالغ من طبيب الأسنان
Dialogue: 0,0:05:50.37,0:05:53.67,Default,,0,0,0,,.إذا كان هو حقًا، سأقبض عليه وحدي
Dialogue: 0,0:05:53.67,0:05:55.38,Default,,0,0,0,,.ابتعدوا أيها الأطفال
Dialogue: 0,0:05:55.38,0:05:58.38,Default,,0,0,0,,!أنت حقًا تخطط لادعاء كل الفضل لنفسك
Dialogue: 0,0:05:58.71,0:06:00.40,Default,,0,0,0,,.الأمر ليس كذلك
Dialogue: 0,0:06:00.40,0:06:04.13,Default,,0,0,0,,.أنا فقط لا أريد أن يحدث شيء سيئ لكم أيها الأطفال. هذا كل شيء
Dialogue: 0,0:06:04.13,0:06:07.78,Default,,0,0,0,,.حقًا؟، لم أتوقع هذا اللطف منك أيها العم
Dialogue: 0,0:06:07.78,0:06:09.58,Default,,0,0,0,,.لا تناديني هكذا
Dialogue: 0,0:06:09.58,0:06:11.39,Default,,0,0,0,,إذن، ماذا ينبغي أن نناديك؟
Dialogue: 0,0:06:11.86,0:06:14.38,Default,,0,0,0,,{\an8}.تاناكا. تاناكا كوجي
Dialogue: 0,0:06:14.38,0:06:15.65,Default,,0,0,0,,{\an8}.تشرفت بمعرفتكم
Dialogue: 0,0:06:20.82,0:06:22.85,Default,,0,0,0,,.يا له من مكان غريب
Dialogue: 0,0:06:22.85,0:06:25.23,Default,,0,0,0,,.لا يوجد أحد هنا
Dialogue: 0,0:06:25.23,0:06:27.91,Default,,0,0,0,,.نعم. هناك الكثير من المنازل المهجورة هنا
Dialogue: 0,0:06:28.74,0:06:31.54,Default,,0,0,0,,أيمكن انه يستدرجنا إلى هنا عمدًا؟
Dialogue: 0,0:06:46.49,0:06:50.05,Default,,0,0,0,,!الأمر خطير ابقوا هناك أيها الأطفال واتصلوا بالشرطة
Dialogue: 0,0:06:50.05,0:06:51.43,Default,,0,0,0,,.لا تقلقوا
Dialogue: 0,0:06:51.43,0:06:52.91,Default,,0,0,0,,!أعدكم أني سأقبض عليه
Dialogue: 0,0:06:53.56,0:06:54.62,Default,,0,0,0,,!سيد تاناكا
Dialogue: 0,0:06:54.62,0:06:55.52,Default,,0,0,0,,!هايبرا
Dialogue: 0,0:06:55.52,0:06:56.69,Default,,0,0,0,,.فهمت
Dialogue: 0,0:07:01.40,0:07:03.65,Default,,0,0,0,,!تبًا لا أستطيع رؤية أي شيء
Dialogue: 0,0:07:12.96,0:07:15.74,Default,,0,0,0,,.لقد هرب
Dialogue: 0,0:07:21.21,0:07:23.63,Default,,0,0,0,,هل سقط من هنا؟
Dialogue: 0,0:07:23.63,0:07:24.97,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:07:25.42,0:07:27.25,Default,,0,0,0,,.هذا يبدو سيئًا
Dialogue: 0,0:07:28.14,0:07:31.07,Default,,0,0,0,,.سـ-سأذهب لأحضر المساعدة
Dialogue: 0,0:07:41.95,0:07:42.98,Default,,0,0,0,,!ها هو
Dialogue: 0,0:07:43.40,0:07:44.54,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:07:47.79,0:07:49.53,Default,,0,0,0,,أنت، هل أنت بخير؟
Dialogue: 0,0:07:52.03,0:07:53.28,Default,,0,0,0,,.هذا سيء
Dialogue: 0,0:08:04.46,0:08:06.48,Default,,0,0,0,,.جيد إنه على قيد الحياة
Dialogue: 0,0:08:09.32,0:08:10.32,Default,,0,0,0,,.تبًا
Dialogue: 0,0:08:17.43,0:08:18.77,Default,,0,0,0,,!يا رفاق
Dialogue: 0,0:08:31.45,0:08:35.01,Default,,0,0,0,,.يبدو أنه أصاب رأسه عندما سقط
Dialogue: 0,0:08:35.01,0:08:37.32,Default,,0,0,0,,.إنه فاقد للوعي وفي حالة حرجة
Dialogue: 0,0:08:37.32,0:08:38.77,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:08:39.69,0:08:41.63,Default,,0,0,0,,.على أي حال
Dialogue: 0,0:08:41.63,0:08:44.71,Default,,0,0,0,,!ماذا كنتم تفعلون أيها الأطفال
Dialogue: 0,0:08:44.71,0:08:47.10,Default,,0,0,0,,.نحن آسفون
Dialogue: 0,0:08:47.10,0:08:50.22,Default,,0,0,0,,لكن أليس هو مجرمًا مطلوبًا؟
Dialogue: 0,0:08:50.88,0:08:53.72,Default,,0,0,0,,.في الواقع ليس كذلك
Dialogue: 0,0:08:53.72,0:08:54.84,Default,,0,0,0,,!ماذا
Dialogue: 0,0:08:54.84,0:08:57.97,Default,,0,0,0,,.بل هو السيد يامادا تارو
Dialogue: 0,0:08:57.97,0:09:00.98,Default,,0,0,0,,.لـ-لكن وجوههما متطابقة
Dialogue: 0,0:09:00.98,0:09:04.94,Default,,0,0,0,,.أعلم لكن بصماته تختلف كثيرًا عن بصمات كيتو
Dialogue: 0,0:09:04.94,0:09:08.61,Default,,0,0,0,,.لدرجة أنه يمكنك معرفة أنهما شخصان مختلفان بنظرة واحدة
Dialogue: 0,0:09:08.87,0:09:13.34,Default,,0,0,0,,.ندباته الجراحية وخصائصه الجسدية مختلفة أيضًا
Dialogue: 0,0:09:13.34,0:09:15.99,Default,,0,0,0,,.من الواضح أنهما شخصان مختلفان
Dialogue: 0,0:09:15.99,0:09:20.00,Default,,0,0,0,,.في الواقع نتلقى الكثير من الإبلاغات عنه
Dialogue: 0,0:09:20.00,0:09:23.88,Default,,0,0,0,,.إنه مشهور في المقر الرئيسي لكونه شبيهه
Dialogue: 0,0:09:24.20,0:09:26.78,Default,,0,0,0,,.فهمت لهذا السبب
Dialogue: 0,0:09:27.34,0:09:30.13,Default,,0,0,0,,.نعم كان عليه أن يزيل قناعه عند طبيب الأسنان
Dialogue: 0,0:09:31.41,0:09:32.38,Default,,0,0,0,,.لهذا السبب
Dialogue: 0,0:09:32.38,0:09:35.14,Default,,0,0,0,,.ليس لأنه كان خائفًا من طبيب الأسنان
Dialogue: 0,0:09:35.60,0:09:40.14,Default,,0,0,0,,.ربما مر بالكثير خلال السنوات الخمس الماضية
Dialogue: 0,0:09:40.14,0:09:46.15,Default,,0,0,0,,.أعلم بدا أنه يعاني في المرة الأخيرة التي تحدثت فيها معه
Dialogue: 0,0:09:46.65,0:09:48.90,Default,,0,0,0,,.وبعد كل ما مر به نحن
Dialogue: 0,0:09:54.04,0:09:59.01,Default,,0,0,0,,.إذن أين ذلك الشخص تاناكا الذي طارده معكم
Dialogue: 0,0:10:00.25,0:10:04.74,Default,,0,0,0,,.ربما هرب لتجنب التورط
Dialogue: 0,0:10:04.74,0:10:07.35,Default,,0,0,0,,.لن يكون هناك أي صرف لمكافأة في هذه القضية
Dialogue: 0,0:10:08.42,0:10:11.05,Default,,0,0,0,,.لكنه بدا شخصًا لطيفًا
Dialogue: 0,0:10:11.05,0:10:14.16,Default,,0,0,0,,.ربما اعتقد أنه سيُحاسب على ما حدث
Dialogue: 0,0:10:14.16,0:10:18.43,Default,,0,0,0,,.لا أحد يريد الوقوع في مشكلة وهو يحاول فعل الخير
Dialogue: 0,0:10:20.98,0:10:22.43,Default,,0,0,0,,.آسفون
Dialogue: 0,0:10:23.25,0:10:24.94,Default,,0,0,0,,هل هذا حقًا كل شيء؟
Dialogue: 0,0:10:28.69,0:10:31.57,Default,,0,0,0,,.كانت حاوية القمامة تلك ثقيلة جدًا
Dialogue: 0,0:10:31.57,0:10:35.24,Default,,0,0,0,,.يجب أن تركلها بقوة لكي يحدث ذلك
Dialogue: 0,0:10:35.24,0:10:37.11,Default,,0,0,0,,تقصد أنه فعل ذلك عمدًا؟
Dialogue: 0,0:10:37.11,0:10:40.20,Default,,0,0,0,,.وهو أيضًا من طارد السيد يامادا إلى الزقاق
Dialogue: 0,0:10:40.66,0:10:45.46,Default,,0,0,0,,.والسيد تاناكا هو الوحيد الذي رأى اللحظة التي سقط فيها السيد يامادا
Dialogue: 0,0:10:46.71,0:10:49.21,Default,,0,0,0,,تقصد؟
Dialogue: 0,0:10:49.94,0:10:56.97,Default,,0,0,0,,.من الممكن أنه حاول قتل السيد يامادا وجعل الأمر يبدو كحادث
Dialogue: 0,0:10:58.47,0:11:02.22,Default,,0,0,0,,.بدا أيضًا أنه على دراية بالمنطقة
Dialogue: 0,0:11:02.63,0:11:05.23,Default,,0,0,0,,.هناك الكثير من المنازل المهجورة هنا
Dialogue: 0,0:11:05.23,0:11:10.41,Default,,0,0,0,,.عرف أين يحاصره ليبدو الأمر كحادث
Dialogue: 0,0:11:10.41,0:11:13.68,Default,,0,0,0,,.إذن السبب في محاولة إبعادنا
Dialogue: 0,0:11:14.27,0:11:16.81,Default,,0,0,0,,.لم يكن لأنه كان قلقًا علينا
Dialogue: 0,0:11:16.81,0:11:19.74,Default,,0,0,0,,.بل انه لم يريد أحداً أن يشهد جريمته
Dialogue: 0,0:11:19.74,0:11:23.55,Default,,0,0,0,,!الأمر خطير ابقوا هناك أيها الأطفال واتصلوا بالشرطة
Dialogue: 0,0:11:28.62,0:11:31.00,Default,,0,0,0,,.نعم صحيح
Dialogue: 0,0:11:33.00,0:11:35.05,Default,,0,0,0,,أعني أليس كذلك؟
Dialogue: 0,0:11:35.05,0:11:41.07,Default,,0,0,0,,.ليس لديه دافع لقتل السيد يامادا أو كيتو
Dialogue: 0,0:11:41.07,0:11:42.50,Default,,0,0,0,,.لا تعرف ذلك
Dialogue: 0,0:11:42.50,0:11:47.02,Default,,0,0,0,,.ربما كان يملك حسًّا عاليًا بالعدالة فلم يستطع أن يترك مجرمًا مطلوبًا من دون عقاب
Dialogue: 0,0:11:47.02,0:11:51.27,Default,,0,0,0,,لكن هل سيفعل شيئًا حيال ذلك بنفسه؟
Dialogue: 0,0:11:51.27,0:11:53.90,Default,,0,0,0,,.ربما الأمر غير منطقي في النهاية
Dialogue: 0,0:11:53.90,0:11:58.53,Default,,0,0,0,,.ربما كان حبيب الضحية وأراد الانتقام أو شيء من هذا القبيل
Dialogue: 0,0:11:58.53,0:12:04.04,Default,,0,0,0,,.قبل خمس سنوات كانت الضحية رجلاً يبلغ من العمر 80 عامًا وليس له عائلة
Dialogue: 0,0:12:04.38,0:12:06.04,Default,,0,0,0,,...هكذا إذن
Dialogue: 0,0:12:06.04,0:12:12.04,Default,,0,0,0,,ربما هو في الواقع وراء الجرائم القديمة وأراد إسكاته؟
Dialogue: 0,0:12:12.04,0:12:17.30,Default,,0,0,0,,.لا، كيتو بالتأكيد تصرف بمفرده قبل خمس سنوات
Dialogue: 0,0:12:17.30,0:12:21.80,Default,,0,0,0,,.وكانت جريمة عرضية دون أي تخطيط على الإطلاق
Dialogue: 0,0:12:21.80,0:12:28.17,Default,,0,0,0,,.أنت محق. إنه لا يكسب شيئًا من قتل كيتو
Dialogue: 0,0:12:28.17,0:12:31.06,Default,,0,0,0,,.إذن كان الأمر مجرد صدفة
Dialogue: 0,0:12:32.08,0:12:33.06,Default,,0,0,0,,.أعتقد ذلك
Dialogue: 0,0:12:33.06,0:12:35.57,Default,,0,0,0,,.ياللسوء. هذا ليس ممتعًا
Dialogue: 0,0:12:37.57,0:12:42.57,Default,,0,0,0,,.لكن ما زلنا بحاجة إلى استجواب هذا الشخص تاناكا
Dialogue: 0,0:12:42.88,0:12:48.58,Default,,0,0,0,,.بما أنه يعرف المنطقة، لا بد أنه يعيش أو يعمل بالقرب من هنا
Dialogue: 0,0:12:49.06,0:12:53.34,Default,,0,0,0,,.لاحقًا، ساعدنا في إنشاء رسم لوجه السيد تاناكا
Dialogue: 0,0:12:53.34,0:12:56.79,Default,,0,0,0,,.تأكدوا من أن تبقوا أيها الأطفال بعيدًا عن المشاكل
Dialogue: 0,0:12:56.79,0:12:59.29,Default,,0,0,0,,وبعد التوبيخ المعتاد من المفتش
Dialogue: 0,0:12:59.29,0:13:01.94,Default,,0,0,0,,...انفصلنا كلنا في الطريق، لكن
Dialogue: 0,0:13:09.70,0:13:11.60,Default,,0,0,0,,.أنت تخفي شيئًا
Dialogue: 0,0:13:12.38,0:13:13.49,Default,,0,0,0,,!هايبرا
Dialogue: 0,0:13:13.49,0:13:17.36,Default,,0,0,0,,أنت لا تعتقد حقًا أنها مجرد صدفة، أليس كذلك؟
Dialogue: 0,0:13:17.36,0:13:23.11,Default,,0,0,0,,.حسنًا، لا، لكنهم كانوا سيفعلون شيئًا متهورًا مرة أخرى إذا لم أقل ذلك
Dialogue: 0,0:13:23.11,0:13:26.87,Default,,0,0,0,,إذن، هل حاول تاناكا قتل السيد يامادا بعد كل شيء؟
Dialogue: 0,0:13:27.14,0:13:31.50,Default,,0,0,0,,.ليس لدي أي دليل بعد، لذا فهذا مجرد تخمين
Dialogue: 0,0:13:31.50,0:13:34.45,Default,,0,0,0,,.والأهم من ذلك، لا أستطيع التوصل لدافع
Dialogue: 0,0:13:34.89,0:13:38.13,Default,,0,0,0,,.لكن هناك شيء غير صحيح
Dialogue: 0,0:13:39.46,0:13:41.38,Default,,0,0,0,,إذن أنت ذاهب للبحث عنه، أليس كذلك؟
Dialogue: 0,0:13:42.49,0:13:43.48,Default,,0,0,0,,.نعم
Dialogue: 0,0:13:50.82,0:13:53.40,Default,,0,0,0,,ألا تعتقد أنه محق؟
Dialogue: 0,0:13:54.90,0:13:57.65,Default,,0,0,0,,.أعني استنتاج كونان سابقًا
Dialogue: 0,0:13:57.65,0:14:00.21,Default,,0,0,0,,.لكن كونان قال أنه مخطئ
Dialogue: 0,0:14:00.21,0:14:02.90,Default,,0,0,0,,.لا أعتقد أنه مخطئ تمامًا، مع ذلك
Dialogue: 0,0:14:03.26,0:14:05.03,Default,,0,0,0,,...إذن هل حاول هذا الرجل حقًا
Dialogue: 0,0:14:07.28,0:14:08.93,Default,,0,0,0,,.سأذهب للبحث عنه
Dialogue: 0,0:14:08.93,0:14:13.29,Default,,0,0,0,,.ما حدث للسيد يامادا هو خطأي
Dialogue: 0,0:14:13.29,0:14:15.29,Default,,0,0,0,,.يجب أن أفعل شيئًا
Dialogue: 0,0:14:16.31,0:14:18.09,Default,,0,0,0,,.أنتِ لستِ الوحيدة
Dialogue: 0,0:14:18.09,0:14:20.05,Default,,0,0,0,,.نحن مسؤولون أيضًا
Dialogue: 0,0:14:20.05,0:14:24.80,Default,,0,0,0,,!لنريهم ما يستطيع فريق المحققين الصغار فعله
Dialogue: 0,0:14:25.31,0:14:26.80,Default,,0,0,0,,!نعم
Dialogue: 0,0:14:57.57,0:15:02.19,Default,,0,0,0,,.ياللسوء الحظ. لم نستطع العثور عليه على الإطلاق
Dialogue: 0,0:15:02.19,0:15:05.37,Default,,0,0,0,,هل هو حقًا هنا؟
Dialogue: 0,0:15:05.37,0:15:08.30,Default,,0,0,0,,.ربما قد هرب بعيدًا بالفعل
Dialogue: 0,0:15:10.14,0:15:14.56,Default,,0,0,0,,.هذه الصلصة رائحتها مثل الرائحة التي شممتها عليه
Dialogue: 0,0:15:16.56,0:15:18.39,Default,,0,0,0,,بائع حلوى تاكوياكي؟
Dialogue: 0,0:15:20.82,0:15:25.45,Default,,0,0,0,,أليست جميع الصلصات لها نفس الرائحة؟
Dialogue: 0,0:15:25.45,0:15:30.08,Default,,0,0,0,,.لا. رائحة صلصة كل متجر مختلفة تمامًا
Dialogue: 0,0:15:30.08,0:15:32.58,Default,,0,0,0,,.لديك حاسة شم جيدة، أيها الولد
Dialogue: 0,0:15:32.92,0:15:35.19,Default,,0,0,0,,يا عم، هل رأيت هذا الرجل؟
Dialogue: 0,0:15:35.19,0:15:38.33,Default,,0,0,0,,.نعتقد أنه كان أحد زبائنك اليوم
Dialogue: 0,0:15:38.33,0:15:40.73,Default,,0,0,0,,أليس هذا السيد تاناكا؟
Dialogue: 0,0:15:40.73,0:15:42.34,Default,,0,0,0,,.إنه زبون دائم
Dialogue: 0,0:15:43.69,0:15:46.80,Default,,0,0,0,,هل تعرف أين يسكن؟
Dialogue: 0,0:15:47.52,0:15:50.18,Default,,0,0,0,,.أنا متأكد أنه يسكن في ذلك المبنى السكني
Dialogue: 0,0:15:52.95,0:15:54.37,Default,,0,0,0,,.ها هو
Dialogue: 0,0:15:54.85,0:15:58.35,Default,,0,0,0,,الأضواء مطفأة. ألا يوجد أحد في المنزل؟
Dialogue: 0,0:16:00.83,0:16:02.35,Default,,0,0,0,,.الباب مفتوح
Dialogue: 0,0:16:05.68,0:16:07.86,Default,,0,0,0,,.لا يبدو أن هناك أحد في المنزل
Dialogue: 0,0:16:09.06,0:16:11.19,Default,,0,0,0,,.قد نجد دليلاً
Dialogue: 0,0:16:12.74,0:16:15.47,Default,,0,0,0,,المعذرة. هل تعرف هذا الشخص؟
Dialogue: 0,0:16:15.47,0:16:17.82,Default,,0,0,0,,.لا، لا أعرفه
Dialogue: 0,0:16:17.82,0:16:19.07,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:16:19.81,0:16:21.63,Default,,0,0,0,,.ما زلنا لم نجده
Dialogue: 0,0:16:21.63,0:16:29.74,Default,,0,0,0,,.حتى لو رآه أحد، فلن يلاحظ إلا إذا كان يعرفه
Dialogue: 0,0:16:29.74,0:16:31.82,Default,,0,0,0,,.أنتِ محقة
Dialogue: 0,0:16:32.77,0:16:37.39,Default,,0,0,0,,...لحظة؟، عندما رأى السيد ياماد، لماذا قال
Dialogue: 0,0:16:37.74,0:16:39.39,Default,,0,0,0,,!إنه مثله تمامًا
Dialogue: 0,0:16:39.64,0:16:42.42,Default,,0,0,0,,لأنه رأى الملصق المطلوب، أليس كذلك؟
Dialogue: 0,0:16:42.42,0:16:45.03,Default,,0,0,0,,لن يتمكن من الجزم على الفور
Dialogue: 0,0:16:45.03,0:16:48.18,Default,,0,0,0,,.دون مقارنته بالملصق
Dialogue: 0,0:16:48.18,0:16:49.90,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:16:50.28,0:16:52.04,Default,,0,0,0,,.وهذا ليس كل شيء
Dialogue: 0,0:16:52.04,0:16:55.16,Default,,0,0,0,,...عندما قال غينتا أننا وجدنا كيتو، قال
Dialogue: 0,0:16:55.54,0:16:57.04,Default,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:16:57.04,0:16:59.87,Default,,0,0,0,,مستحيل، أليس كذلك؟
Dialogue: 0,0:17:00.47,0:17:03.81,Default,,0,0,0,,.تحدث وكأنه متأكد
Dialogue: 0,0:17:03.81,0:17:05.10,Default,,0,0,0,,أيعقل؟
Dialogue: 0,0:17:05.10,0:17:06.42,Default,,0,0,0,,.يا كونان
Dialogue: 0,0:17:08.33,0:17:09.92,Default,,0,0,0,,ما الأمر، ميتسوهيكو؟
Dialogue: 0,0:17:09.92,0:17:14.68,Default,,0,0,0,,.تتبعنا عنوان شقة السيد تاناكا، ونحن نفتشها حاليًا
Dialogue: 0,0:17:14.68,0:17:15.58,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:17:15.58,0:17:18.41,Default,,0,0,0,,!ماذا تفعلون أيها الأطفال؟
Dialogue: 0,0:17:18.94,0:17:20.23,Default,,0,0,0,,أنسة هايبرا؟
Dialogue: 0,0:17:20.23,0:17:23.69,Default,,0,0,0,,...في الحقيقة، أردنا اختبار استنتاج كونان
Dialogue: 0,0:17:26.39,0:17:27.94,Default,,0,0,0,,.انظروا إلى هذا
Dialogue: 0,0:17:29.27,0:17:30.70,Default,,0,0,0,,هل وجدتم شيئًا؟
Dialogue: 0,0:17:30.70,0:17:32.20,Default,,0,0,0,,.إنه دواء
Dialogue: 0,0:17:32.20,0:17:34.95,Default,,0,0,0,,.لكن الاسم عليه ليس تاناكا
Dialogue: 0,0:17:34.95,0:17:38.02,Default,,0,0,0,,.مكتوب عليه شيما ساتورو
Dialogue: 0,0:17:38.02,0:17:41.65,Default,,0,0,0,,.يذهب إلى مكان يسمى عيادة كاغامي
Dialogue: 0,0:17:41.65,0:17:44.22,Default,,0,0,0,,هل لديه مرض مزمن؟
Dialogue: 0,0:17:44.22,0:17:46.41,Default,,0,0,0,,عيادة كاغامي؟
Dialogue: 0,0:17:46.41,0:17:48.84,Default,,0,0,0,,...لحظة، أليس ذلك المكان
Dialogue: 0,0:17:48.84,0:17:52.34,Default,,0,0,0,,...مهلاً، اخرجوا من هناك الآن! هذا
Dialogue: 0,0:17:53.97,0:17:57.45,Default,,0,0,0,,.تباً، ذلك المالك لا يتوقف عن الكلام
Dialogue: 0,0:17:57.83,0:17:59.89,Default,,0,0,0,,!مصيبة!، لقد عاد
Dialogue: 0,0:17:59.89,0:18:01.56,Default,,0,0,0,,.أطفئوا الأضواء
Dialogue: 0,0:18:01.56,0:18:02.96,Default,,0,0,0,,ما الأمر، يا رفاق؟
Dialogue: 0,0:18:03.51,0:18:04.79,Default,,0,0,0,,.سأقطع الأتصال الآن
Dialogue: 0,0:18:07.87,0:18:09.53,Default,,0,0,0,,.أسرعا، أنتما الاثنان
Dialogue: 0,0:18:13.99,0:18:15.49,Default,,0,0,0,,!غينتا، أسرع
Dialogue: 0,0:18:17.61,0:18:18.94,Default,,0,0,0,,.اسحبوني للأعلى
Dialogue: 0,0:18:21.75,0:18:23.61,Default,,0,0,0,,!كدت أصل
Dialogue: 0,0:18:24.25,0:18:26.27,Default,,0,0,0,,...تماسك
Dialogue: 0,0:18:30.94,0:18:31.76,Default,,0,0,0,,.ها هم
Dialogue: 0,0:18:32.02,0:18:33.26,Default,,0,0,0,,.إنهم قريبون
Dialogue: 0,0:18:35.80,0:18:38.26,Default,,0,0,0,,.أيها الضابط تاكاغي؟ لقد وجدنا السيد تاناكا
Dialogue: 0,0:18:47.90,0:18:52.35,Default,,0,0,0,,.عيادة كاغامي هي عيادة تجميل مشهورة
Dialogue: 0,0:18:52.35,0:18:54.59,Default,,0,0,0,,...إذا كنت محقًا، إذن
Dialogue: 0,0:18:56.91,0:18:59.21,Default,,0,0,0,,.كنت محقًا، يا كونان
Dialogue: 0,0:19:01.16,0:19:03.37,Default,,0,0,0,,تحدثنا مع العيادة
Dialogue: 0,0:19:03.37,0:19:08.77,Default,,0,0,0,,.اتضح أن رجلاً اسمه شيما ساتورو غيّر ملامح وجهه تجميليًا منذ خمس سنوات
Dialogue: 0,0:19:08.77,0:19:10.92,Default,,0,0,0,,.نعم، سنتجه إلى هناك فورًا
Dialogue: 0,0:19:10.92,0:19:12.16,Default,,0,0,0,,.كما توقعت تماماً
Dialogue: 0,0:19:12.16,0:19:13.42,Default,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:19:13.88,0:19:16.18,Default,,0,0,0,,...في اللحظة التي رأى فيها السيد يامادا
Dialogue: 0,0:19:16.62,0:19:22.22,Default,,0,0,0,,.السبب في معرفته أنه يشبه كيتو تمامًا لأن ذلك كان وجهه القديم
Dialogue: 0,0:19:22.22,0:19:24.81,Default,,0,0,0,,.وجهه قبل أن يجري عملية التجميل
Dialogue: 0,0:19:26.31,0:19:31.46,Default,,0,0,0,,.أحيانًا، الحفاظ على ذلك المظهر يتطلب صيانة دورية
Dialogue: 0,0:19:31.46,0:19:33.60,Default,,0,0,0,,.لهذا السبب ما زال يذهب إلى العيادة
Dialogue: 0,0:19:33.60,0:19:34.82,Default,,0,0,0,,...إذن هو
Dialogue: 0,0:19:34.82,0:19:38.82,Default,,0,0,0,,.نعم. إنه ليس تاناكا كوجي ولا شيما ساتورو
Dialogue: 0,0:19:38.82,0:19:40.53,Default,,0,0,0,,...بل هو في الواقع
Dialogue: 0,0:19:40.53,0:19:43.11,Default,,0,0,0,,!المجرم المطلوب نفسه، كيتو كين
Dialogue: 0,0:19:48.37,0:19:51.89,Default,,0,0,0,,.لقد حاول قتل السيد يامادا بصفته كيتو
Dialogue: 0,0:19:53.23,0:19:55.59,Default,,0,0,0,,كان يأمل أنه بجعله يسقط من هناك
Dialogue: 0,0:19:55.59,0:19:58.09,Default,,0,0,0,,سيُجرَف بعيدًا بسبب النهر المغمور بمياه الأمطار
Dialogue: 0,0:19:58.09,0:19:59.98,Default,,0,0,0,,.مما يجعل العثور على الجثة صعبًا
Dialogue: 0,0:19:59.98,0:20:03.10,Default,,0,0,0,,.ولن تفحص الشرطة بصماته أو حمضه النووي فورًا
Dialogue: 0,0:20:03.92,0:20:06.85,Default,,0,0,0,,ربما ذهب كيتو إلى شقة السيد يامادا بعد ذلك
Dialogue: 0,0:20:06.85,0:20:09.10,Default,,0,0,0,,.لإزالة بصمات السيد يامادا
Dialogue: 0,0:20:09.91,0:20:12.22,Default,,0,0,0,,إذا ترك بصماته بدلاً من ذلك
Dialogue: 0,0:20:12.22,0:20:17.61,Default,,0,0,0,,.قد تعتقد الشرطة أن يامادا تارو هو في الواقع كيتو كين
Dialogue: 0,0:20:17.61,0:20:22.39,Default,,0,0,0,,هكذا إذن. ستستنتج الشرطة أن كيتو سقط في النهر ومات
Dialogue: 0,0:20:22.39,0:20:26.87,Default,,0,0,0,,.وسيكون كيتو الحقيقي حرًا طوال حياته
Dialogue: 0,0:20:29.69,0:20:32.38,Default,,0,0,0,,.الآن لم أعد مضطرًا للخوف بعد الآن
Dialogue: 0,0:20:32.38,0:20:36.65,Default,,0,0,0,,.ففي النهاية، كيتو كين ميت
Dialogue: 0,0:20:42.32,0:20:44.16,Default,,0,0,0,,...لهذا أنتم أيها الأطفال
Dialogue: 0,0:20:44.16,0:20:45.93,Default,,0,0,0,,ماذا تفعلون هنا؟
Dialogue: 0,0:20:48.66,0:20:51.65,Default,,0,0,0,,تـ-سأل ماذا نفعل؟
Dialogue: 0,0:20:54.30,0:20:55.68,Default,,0,0,0,,!هذا المال
Dialogue: 0,0:20:55.68,0:20:57.65,Default,,0,0,0,,...أ-أليس هذا
Dialogue: 0,0:20:57.65,0:20:58.98,Default,,0,0,0,,أيمكن؟
Dialogue: 0,0:20:59.65,0:21:03.91,Default,,0,0,0,,...لقد رأيتم أيها الأطفال شيئًا لم يكن ينبغي لكم رؤيته
Dialogue: 0,0:21:18.92,0:21:20.55,Default,,0,0,0,,هل الجميع بخير؟
Dialogue: 0,0:21:20.55,0:21:22.30,Default,,0,0,0,,!الضابط تاكاغي
Dialogue: 0,0:21:23.52,0:21:24.99,Default,,0,0,0,,!لا تتحرك، يا كيتو
Dialogue: 0,0:21:24.99,0:21:26.16,Default,,0,0,0,,!تبًا
Dialogue: 0,0:21:26.57,0:21:28.38,Default,,0,0,0,,!لن تهرب
Dialogue: 0,0:21:28.38,0:21:30.97,Default,,0,0,0,,!ها هي قوة فريق المحققين الصغار
Dialogue: 0,0:21:30.97,0:21:32.56,Default,,0,0,0,,!من أجل السيد يامادا
Dialogue: 0,0:21:34.67,0:21:35.90,Default,,0,0,0,,.تباً
Dialogue: 0,0:21:36.57,0:21:40.07,Default,,0,0,0,,!فريق المحققين الصغار ينتصرون مجددًا
Dialogue: 0,0:21:43.21,0:21:46.72,Default,,0,0,0,,لاحقًا، تم إثبات أن الرجل الذي قبض عليه فريق المحققين الصغار
Dialogue: 0,0:21:46.72,0:21:49.84,Default,,0,0,0,,هو المجرم المطلوب الحقيقي، كيتو كين
Dialogue: 0,0:21:49.84,0:21:54.29,Default,,0,0,0,,...وقد تعافى السيد يامادا تارو بنجاح
Dialogue: 0,0:21:54.91,0:21:59.96,Default,,0,0,0,,.ولكن لا داعي للقول أنهم تلقوا توبيخًا شديدًا من المفتش ميغوري
Dialogue: 0,0:22:00.36,0:22:02.93,Default,,0,0,0,,...نحن آسفون
Dialogue: 0,0:23:26.89,0:23:28.68,Default,,0,0,0,,ماذا يفعلون؟
Dialogue: 0,0:23:28.68,0:23:32.68,Default,,0,0,0,,.إنهم يحاولون العثور على مجرمهم المطلوب التالي
Dialogue: 0,0:23:32.68,0:23:33.89,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:23:33.89,0:23:35.84,Default,,0,0,0,,..."التالي"
