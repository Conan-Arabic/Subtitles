Dialogue: 0,0:00:01.01,0:00:50.33,DCMain,MAN 1,0000,0000,0000,,www.ttopanime.blogspot.com
Dialogue: 0,0:00:50.33,0:00:53.49,DCMain,MAN 1,0000,0000,0000,,مهلاً، الى. أين تعتقد أنك ذاهب؟
Dialogue: 0,0:00:55.22,0:00:58.24,DCMain,MAN 2,0000,0000,0000,,لٓ-لٓا أحد قال أننا سوف نقتل أي شخص
Dialogue: 0,0:00:58.67,0:01:03.16,DCMain,MAN 1,0000,0000,0000,,لقد تجاهلوا تحذيراتنا \Nسنقتلهم إذا قاومَّوا
Dialogue: 0,0:01:03.76,0:01:05.50,DCMain,MAN 1,0000,0000,0000,,لقد حصلوا على ما يستحقونه
Dialogue: 0,0:01:05.84,0:01:09.25,DCMain,MAN 2,0000,0000,0000,,أنا-أنا خارج
Dialogue: 0,0:01:09.57,0:01:11.35,DCMain,MAN 1,0000,0000,0000,,مهلاً هذا ليس جزءًا من الخطة
Dialogue: 0,0:01:12.05,0:01:13.65,DCMain,MAN 1,0000,0000,0000,,لقد انتها العقد
Dialogue: 0,0:01:14.21,0:01:15.34,DCMain,MAN 1,0000,0000,0000,,أنتَ خائن
Dialogue: 0,0:01:16.23,0:01:17.89,DCMain,MAN 1,0000,0000,0000,,يجب أن تعاقب
Dialogue: 0,0:01:19.82,0:01:21.51,DCMain,POLICE 1,0000,0000,0000,,!يا هذا
Dialogue: 0,0:01:22.82,0:01:24.06,DCMain,POLICE 1,0000,0000,0000,,ماذا تفعل؟
Dialogue: 0,0:01:27.36,0:01:28.27,DCMain,POLICE 2,0000,0000,0000,,!ًمهلا
Dialogue: 0,0:01:40.12,0:01:42.02,DCMain,CONAN,0000,0000,0000,,!الستائر ترتفع كما يظهر المتصدر
Dialogue: 0,0:01:42.02,0:01:44.60,DCMain,CONAN,0000,0000,0000,,انه يرقص بشكل جميل له \N!خطوات حل الغموض
Dialogue: 0,0:01:44.60,0:01:46.71,DCMain,CONAN,0000,0000,0000,,!المجرمونَ يتصرفون سرًا
Dialogue: 0,0:01:46.71,0:01:48.42,DCMain,CONAN,0000,0000,0000,,سوف تأتي المباحث \Nفي اتصال معهم؟
Dialogue: 0,0:01:48.82,0:01:50.56,DCMain,CONAN,0000,0000,0000,,دائمًا تحدد الحقيقة واحدة
Dialogue: 0,0:01:50.56,0:01:52.59,DCMain,CONAN,0000,0000,0000,,مع جسم طفل \N،وعقل شخص بالغً
Dialogue: 0,0:01:52.59,0:01:54.98,DCMain,CONAN,0000,0000,0000,,!اسمه المحقق كونان
Dialogue: 0,0:03:34.98,0:03:40.99,DCEpTitle,EPTITLE,0000,0000,0000,,{\fad(401,1)}كونان يختفي فوق جرف \N(الجزء الأول)
Dialogue: 0,0:03:35.70,0:03:39.31,DCMain,CONAN,0000,0000,0000,,"! كونان يختفي فوق جرف، الجزء الأول "
Dialogue: 0,0:03:41.39,0:03:43.83,DCMain,REPORTER,0000,0000,0000,,وقد أبلغ عن الضحايا في هذه القضية
Dialogue: 0,0:03:43.83,0:03:46.61,DCMain,REPORTER,0000,0000,0000,,المسلسل المسلح السطو و \Nمجموعة الحرائق المعروفة باسم زورو
Dialogue: 0,0:03:46.61,0:03:49.46,DCMain,REPORTER,0000,0000,0000,,قتل ثلاثة اشخاص \N،من المنزل الذي اقتحم
Dialogue: 0,0:03:49.46,0:03:55.12,DCMain,REPORTER,0000,0000,0000,,وأصيبَ بجراحً خطيرة ضابط شرطة \Nوابلغ عن الحريق قبل أن يهرب
Dialogue: 0,0:03:55.12,0:04:01.46,DCItalic,REPORTER,0000,0000,0000,,،ووفقًا لما ذكره ضابط الدورية الٓاخر \Nأطلق الجاني القوس والنشاب دون سابق إنذار
Dialogue: 0,0:03:57.09,0:03:58.86,DCMain,KOGORO,0000,0000,0000,,{\an8}سخيف
Dialogue: 0,0:03:59.86,0:04:03.22,DCMain,KOGORO,0000,0000,0000,,{\an8}هذه هي الجريمة الرابعة \Nالمنزل الذي استهدف
Dialogue: 0,0:04:01.46,0:04:05.72,DCItalic,REPORTER,0000,0000,0000,,لا يمكن فعل أي شيء\N للقبض على هؤلاء المجرمين
Dialogue: 0,0:04:09.28,0:04:11.69,DCMain,KOGORO,0000,0000,0000,,انهم عكس اسم زورو
Dialogue: 0,0:04:11.69,0:04:14.43,DCMain,KOGORO,0000,0000,0000,,انهم مجموعة شيطانية من البلطجية
Dialogue: 0,0:04:14.43,0:04:17.44,DCMain,RAN,0000,0000,0000,,،أبي، أنا أعلم أنه يوّم العطلة الخاص بك
Dialogue: 0,0:04:17.44,0:04:20.61,DCMain,RAN,0000,0000,0000,,ولكن لا تشرب اليوم كثيرًا
Dialogue: 0,0:04:20.61,0:04:22.61,DCMain,KOGORO,0000,0000,0000,,اعرف
Dialogue: 0,0:04:24.14,0:04:26.20,DCMain,KOGORO,0000,0000,0000,,إلى اين ذهب؟
Dialogue: 0,0:04:26.20,0:04:31.12,DCMain,KOGORO,0000,0000,0000,,هذا الطفل الذي يعصي الاوامر دائمًا \Nأنفه من الأخبار من هذا القبيل؟
Dialogue: 0,0:04:31.44,0:04:35.07,DCKOGORO,RAn,0000,0000,0000,, ذهب كونان كون مع \Nاي تشان وأطفال آخرين
Dialogue: 0,0:04:35.07,0:04:36.38,DCMain,RAN,0000,0000,0000,,هل نسيت؟
Dialogue: 0,0:04:37.55,0:04:39.92,DCMain,KOGORO,0000,0000,0000,,يجب أن يكون لديه مسؤوليات
Dialogue: 0,0:04:40.38,0:04:44.30,DCMain,RAN,0000,0000,0000,,يجب أن تكون لطيفًا بالنسبة لك، أيضًا، أبي
Dialogue: 0,0:04:49.78,0:04:51.14,DCMain,ALL,0000,0000,0000,,... جاهز، و
Dialogue: 0,0:04:51.14,0:04:52.56,DCMain,AYUMI,0000,0000,0000,,{\a6}!الفول والعسل
Dialogue: 0,0:04:51.14,0:04:52.56,DCMain,MITSUHIKO,0000,0000,0000,,!الحلوى
Dialogue: 0,0:04:51.14,0:04:52.56,DCMain,GENTA,0000,0000,0000,,!الانقليس
Dialogue: 0,0:04:52.76,0:04:55.17,DCMain,AYUMI,0000,0000,0000,,هل حصلت على كل ذلك، كونان كون؟
Dialogue: 0,0:04:55.17,0:04:58.58,DCMain,CONAN,0000,0000,0000,,الفول والعسل والحلوى، وثعبان البحر
Dialogue: 0,0:04:59.20,0:05:00.60,DCMain,MITSUHIKO,0000,0000,0000,,هذا صحيح
Dialogue: 0,0:05:00.60,0:05:01.76,DCMain,GENTA,0000,0000,0000,,هذا مدهش
Dialogue: 0,0:05:01.76,0:05:03.49,DCMain,GENTA,0000,0000,0000,,كيف عرفت؟
Dialogue: 0,0:05:03.93,0:05:05.99,DCItalic,CONAN,0000,0000,0000,,من الواضحِ
Dialogue: 0,0:05:06.27,0:05:08.75,DCMain,AYUMI,0000,0000,0000,,دعونا نفعل المواضيع المفضلة لدينا
Dialogue: 0,0:05:09.09,0:05:11.49,DCItalic,CONAN,0000,0000,0000,,وهذا واضحً أيضًا
Dialogue: 0,0:05:11.76,0:05:14.50,DCMain,AGASA,0000,0000,0000,,نحن تقريبا سنصل هناك، والأطفال
Dialogue: 0,0:05:14.74,0:05:17.06,DCMain,ALL,0000,0000,0000,,!الاغاني
Dialogue: 0,0:05:21.35,0:05:22.72,DCMain,AYUMI,0000,0000,0000,,!انها رائعة جدًا
Dialogue: 0,0:05:23.32,0:05:27.16,DCMain,MITSUHIKO,0000,0000,0000,,البقاء هنا يجعلني أشعر بأنني من المشاهير
Dialogue: 0,0:05:27.16,0:05:30.51,DCMain,GENTA,0000,0000,0000,,أراهن أنها تخدم أفضل
Dialogue: 0,0:05:31.18,0:05:33.09,DCMain,CONAN,0000,0000,0000,,أنا لست متأكدًا من هذا
Dialogue: 0,0:05:33.09,0:05:38.31,DCMain,HAIBARA,0000,0000,0000,,لسوء الحظ، لدينا طهي الطعام \Nبأنفسنا هنا، كوجيما كون
Dialogue: 0,0:05:38.31,0:05:40.65,DCMain,GENTA,0000,0000,0000,,ماذا؟ لٓ- لٓا توجد وسيلة
Dialogue: 0,0:05:42.58,0:05:46.50,DCMain,CONAN,0000,0000,0000,,على أي حال، اتصالاتك أبداً \Nسيءَ في إقناع، أستاذ
Dialogue: 0,0:05:46.85,0:05:49.95,DCMain,CONAN,0000,0000,0000,,لا أستطيع أن أصدق أنك تعرف \Nالشخص الذي يملك هذه الفيلاً
Dialogue: 0,0:05:50.10,0:05:54.50,DCMain,GENTA,0000,0000,0000,,لا تعرف أي بائع ثعبان البحر، أستاذ؟
Dialogue: 0,0:05:54.76,0:05:56.00,DCMain,AGASA,0000,0000,0000,,لا
Dialogue: 0,0:05:56.26,0:05:58.59,DCMain,GENTA,0000,0000,0000,,كيف يمكن الإجابة بسرعة؟
Dialogue: 0,0:06:03.88,0:06:04.91,DCMain,AYUMI,0000,0000,0000,,ماذا؟
Dialogue: 0,0:06:06.71,0:06:08.05,DCMain,CONAN,0000,0000,0000,,! ما هو الخطأ، أيومي تشان؟
Dialogue: 0,0:06:13.16,0:06:15.77,DCMain,GENTA,0000,0000,0000,,مهلاً، من هو؟
Dialogue: 0,0:06:20.05,0:06:21.02,DCMain,CONAN,0000,0000,0000,,انه على قيد الحياة
Dialogue: 0,0:06:24.76,0:06:27.41,DCMain,MITSUHIKO,0000,0000,0000,,لقد أصيب بجروح خطيرة، لكنه يتنفس
Dialogue: 0,0:06:27.41,0:06:29.28,DCMain,CONAN,0000,0000,0000,,هيبارا، اتصلي بسيارة إسعاف
Dialogue: 0,0:06:29.28,0:06:30.19,DCMain,HAIBARA,0000,0000,0000,,حسنًا
Dialogue: 0,0:06:52.96,0:06:55.56,DCMain,MITSUHIKO,0000,0000,0000,,كان ذلك فجأة
Dialogue: 0,0:06:55.56,0:06:59.90,DCMain,MITSUHIKO,0000,0000,0000,,من كان، وماذا حدث له؟
Dialogue: 0,0:06:59.90,0:07:01.81,DCMain,MITSUHIKO,0000,0000,0000,,هل هو نوع من القضية؟
Dialogue: 0,0:07:01.81,0:07:04.48,DCMain,GENTA,0000,0000,0000,,ربما يكون مجرد لص
Dialogue: 0,0:07:04.48,0:07:08.57,DCMain,GENTA,0000,0000,0000,,ربما ارتكب خطأ في حين \Nكسر وأضر نفسه
Dialogue: 0,0:07:08.95,0:07:11.32,DCMain,HAIBARA,0000,0000,0000,,انه مستحيلاً
Dialogue: 0,0:07:11.32,0:07:14.32,DCMain,HAIBARA,0000,0000,0000,,إذا كان يمكن أن يطلق النار على نفسه \Nالذراع مع القوس والنشاب
Dialogue: 0,0:07:15.24,0:07:16.35,DCMain,HAIBARA,0000,0000,0000,,القوس والنشاب؟
Dialogue: 0,0:07:16.86,0:07:18.49,DCMain,HAIBARA,0000,0000,0000,,لم يكن أمس ...؟
Dialogue: 0,0:07:18.49,0:07:20.21,DCMain,AYUMI,0000,0000,0000,,هاه؟ أين كونان كون؟
Dialogue: 0,0:07:20.44,0:07:23.71,DCMain,AGASA,0000,0000,0000,,ماذا؟ وكان هنا قبل دقيقة
Dialogue: 0,0:07:43.62,0:07:46.15,DCItalic,CONAN,0000,0000,0000,,يجب أن لايترك هذا وراءه
Dialogue: 0,0:07:50.44,0:07:51.85,DCItalic,CONAN,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:07:52.54,0:07:55.79,DCMain,HAIBARA,0000,0000,0000,,هو على الأرجح إما \Nأسماء المستخدمين وكلمات المرور
Dialogue: 0,0:07:55.79,0:07:57.05,DCMain,CONAN,0000,0000,0000,,هيبارا
Dialogue: 0,0:07:57.05,0:07:59.16,DCMain,HAIBARA,0000,0000,0000,,انهم مختلفون تماماً
Dialogue: 0,0:07:59.74,0:08:02.33,DCMain,HAIBARA,0000,0000,0000,,ماذا ستفعل مع \Nذلك؟ إعادته له؟
Dialogue: 0,0:08:02.56,0:08:04.29,DCMain,CONAN,0000,0000,0000,,أظن ذلك
Dialogue: 0,0:08:04.86,0:08:06.96,DCMain,CONAN,0000,0000,0000,,نشكل بعض العذر لإخبار الآخرين، حسنًا؟
Dialogue: 0,0:08:08.34,0:08:11.02,DCMain,HAIBARA,0000,0000,0000,,شيئًا ما، هاه؟
Dialogue: 0,0:08:11.47,0:08:17.18,Clinic,SIGN,0000,0000,0000,,{\fad(2064,1)}عيادة ميساكياما
Dialogue: 0,0:08:21.82,0:08:25.17,DCItalic,CONAN,0000,0000,0000,,تم استخدام القوس النشاب في سرقة أمس
Dialogue: 0,0:08:25.90,0:08:29.48,DCItalic,CONAN,0000,0000,0000,,ظننت أنني سألته عنه \Nلكنه، لكنه ليس مستيقظاً بعد
Dialogue: 0,0:09:01.77,0:09:03.22,DCItalic,CONAN,0000,0000,0000,,الأحذية العسكرية؟
Dialogue: 0,0:09:42.16,0:09:43.10,DCMain,MAN 1,0000,0000,0000,,ماذا؟
Dialogue: 0,0:09:49.95,0:09:52.49,DCMain,CONAN,0000,0000,0000,,الآن استدعي الشرطة
Dialogue: 0,0:10:00.61,0:10:02.33,DCItalic,CONAN,0000,0000,0000,,المفتش ميغور
Dialogue: 0,0:10:03.52,0:10:06.64,DCItalic,CONAN,0000,0000,0000,,هل هذا يعني أن هذا متصل \Nبقضية الأمس؟
Dialogue: 0,0:10:11.81,0:10:12.79,DCMain,CONAN,0000,0000,0000,,!سحقًا 
Dialogue: 0,0:10:13.12,0:10:14.74,DCMain,TAKAGI,0000,0000,0000,,ماذا؟ كونان كون؟
Dialogue: 0,0:10:14.74,0:10:16.55,DCMain,CONAN,0000,0000,0000,,!فر رجل مشبوه من خلال النافذة
Dialogue: 0,0:10:16.78,0:10:17.80,DCMain,CONAN,0000,0000,0000,,!تحقق من المدخل الخلفي
Dialogue: 0,0:10:18.02,0:10:18.80,DCMain,MEGURE,0000,0000,0000,,ماذا؟
Dialogue: 0,0:10:28.07,0:10:29.27,DCMain,CHIBA,0000,0000,0000,,غير مجدي
Dialogue: 0,0:10:29.76,0:10:31.10,DCMain,CHIBA,0000,0000,0000,,هرب
Dialogue: 0,0:10:31.62,0:10:33.69,DCMain,CHIBA,0000,0000,0000,,وجدنا هذا في القمامة الخلفية
Dialogue: 0,0:10:35.99,0:10:40.45,DCMain,COMain,0000,0000,0000,,كان هذا الرجل المصاب جزء \N من مجموعة سورو زورو؟
Dialogue: 0,0:10:40.71,0:10:45.70,DCMain,TAKAGI,0000,0000,0000,,والواقع أن المجموعة تستأجر أعضائها
Dialogue: 0,0:10:46.12,0:10:48.78,DCMain,TAKAGI,0000,0000,0000,,{\an8}إيسيهارا يوجي، ثمانية وعشرين عامًا
Dialogue: 0,0:10:46.29,0:10:52.96,Yuji,TEXT,0000,0000,0000,,{\fad(250,250)}ايسيهارا يوجي (28) \Nقرصان
Dialogue: 0,0:10:48.78,0:10:54.25,DCMain,TAKAGI,0000,0000,0000,,{\an8}إنه قراصنة مهرة جرائمنا الإلكترونية \Nكان القسم يتابعه أيضًا
Dialogue: 0,0:10:54.25,0:10:59.22,DCMain,TAKAGI,0000,0000,0000,,انه يخترق ويتلاعب في \Nالمعلومات الأمنية
Dialogue: 0,0:10:59.71,0:11:01.86,DCMain,TAKAGI,0000,0000,0000,,سمعنا من خلال شرطة كاناغاوا
Dialogue: 0,0:11:01.86,0:11:06.29,DCMain,TAKAGI,0000,0000,0000,,ًأن لديهم احتمالا \N،المشتبه بهم في الحجز
Dialogue: 0,0:11:06.29,0:11:08.14,DCMain,TAKAGI,0000,0000,0000,,لذلك جئنا هنا
Dialogue: 0,0:11:08.91,0:11:10.47,DCMain,TAKAGI,0000,0000,0000,,هل هذه المعلومات كافية؟
Dialogue: 0,0:11:10.47,0:11:12.22,DCMain,CONAN,0000,0000,0000,, شكراً
Dialogue: 0,0:11:12.22,0:11:15.27,DCMain,CONAN,0000,0000,0000,,سوف تكون قادرًا على إعطاء \Nكوغورو-نو-أوجيسان تقرير كامل
Dialogue: 0,0:11:16.30,0:11:18.65,DCMain,CHIBA,0000,0000,0000,,!ماذا؟ إيسيهارا في عداد المفقودين، أيضًا؟
Dialogue: 0,0:11:19.12,0:11:20.28,DCMain,MEGURE,0000,0000,0000,,ماذا؟
Dialogue: 0,0:11:26.20,0:11:27.70,DCMain,MEGURE,0000,0000,0000,,!اعثر عليهم
Dialogue: 0,0:11:27.70,0:11:28.46,DCMain,BOTH,0000,0000,0000,,!نعم سيدي
Dialogue: 0,0:11:37.86,0:11:39.54,DCMain,KOGORO,0000,0000,0000,,أنا أرى
Dialogue: 0,0:11:39.54,0:11:43.39,DCMain,KOGORO,0000,0000,0000,,شكرًا لك على الاتصال بي، المفتش
Dialogue: 0,0:11:43.82,0:11:47.80,DCMain,RAN,0000,0000,0000,,تم العثور على أحد اللصوص أمس في \Nالفيلا حيث يقيم الأطفال؟
Dialogue: 0,0:11:47.80,0:11:48.68,DCMain,KOGORO,0000,0000,0000,,بلى
Dialogue: 0,0:11:49.22,0:11:53.14,DCMain,KOGORO,0000,0000,0000,,أنا لا أعرف ما حدث، لكنه كان \Nيختبئ في الفناء مع عصابة
Dialogue: 0,0:11:53.40,0:11:56.26,DCMain,RAN,0000,0000,0000,,هل سيكون كونان كون على حقًا؟
Dialogue: 0,0:11:56.69,0:11:58.48,DCMain,KOGORO,0000,0000,0000,,الشرطة هناك
Dialogue: 0,0:11:58.48,0:12:00.13,DCMain,KOGORO,0000,0000,0000,,أنت لا داعي للقلق
Dialogue: 0,0:12:00.13,0:12:01.74,DCMain,RAN,0000,0000,0000,,هذا ليس ما قصدته
Dialogue: 0,0:12:05.08,0:12:07.88,DCMain,CONAN,0000,0000,0000,,أنا سعيد لأنني أخذت صورة فقط في حالة
Dialogue: 0,0:12:30.15,0:12:33.54,DCMain,RAN,0000,0000,0000,,أبي، متى ستستمر في شرب الكحول؟
Dialogue: 0,0:12:33.54,0:12:34.78,DCMain,RAN,0000,0000,0000,,لنذهب
Dialogue: 0,0:12:34.78,0:12:35.60,DCMain,KOGORO,0000,0000,0000,,هاه؟
Dialogue: 0,0:12:35.81,0:12:39.82,DCMain,RAN,0000,0000,0000,,ليس هناك طريقة كونان كون \Nيقضي وقته بالجلوس
Dialogue: 0,0:12:40.36,0:12:43.28,DCMain,RAN,0000,0000,0000,,بالتأكيد سوف تحصل على ما يصل \Nإلى شيء خطير
Dialogue: 0,0:12:43.62,0:12:47.47,DCMain,KOGORO,0000,0000,0000,,نعم، ولكن ليس مثل ما \Nتم تعيينهم للتحقيق
Dialogue: 0,0:12:47.47,0:12:49.57,DCMain,RAN,0000,0000,0000,,{\an8}عن ماذا تتحدث؟
Dialogue: 0,0:12:48.20,0:12:53.29,DCMain,KOGORO,0000,0000,0000,,ليس هناك حاجة \N-للمباحث موري كوغورو
Dialogue: 0,0:12:49.57,0:12:51.58,DCMain,RAN,0000,0000,0000,,{\an8}توقف عن الشكوى
Dialogue: 0,0:12:53.57,0:12:54.65,DCMain,KOGORO,0000,0000,0000,,! أو، أو، أو
Dialogue: 0,0:12:54.65,0:12:55.82,DCMain,RAN,0000,0000,0000,,كانوا يغادرون
Dialogue: 0,0:12:55.82,0:12:57.88,DCMain,KOGORO,0000,0000,0000,,! أو، أو، أو
Dialogue: 0,0:13:06.22,0:13:08.03,DCItalic,CONAN,0000,0000,0000,,أنا قريب
Dialogue: 0,0:13:14.91,0:13:18.65,DCMain,MITSUHIKO,0000,0000,0000,,هذا ليس عادلاً، كونان كون
Dialogue: 0,0:13:18.98,0:13:22.15,DCMain,MITSUHIKO,0000,0000,0000,,كنت قد أخبرتنا أن كان هناك شيء ما
Dialogue: 0,0:13:23.14,0:13:26.15,DCMain,AYUMI,0000,0000,0000,,المخبر مه فريق الاولاد
Dialogue: 0,0:13:26.15,0:13:29.41,DCMain,GENTA,0000,0000,0000,,إنني جائع أنا جائع
Dialogue: 0,0:13:53.22,0:13:56.88,DCMain,GENTA,0000,0000,0000,,هاه؟ أين ذهب كونان؟
Dialogue: 0,0:13:57.41,0:13:59.06,DCMain,MITSUHIKO,0000,0000,0000,,هذا غريب
Dialogue: 0,0:13:59.51,0:14:01.60,DCMain,MITSUHIKO,0000,0000,0000,,يمكننا أن نراه حتى لحظة
Dialogue: 0,0:14:01.95,0:14:04.07,DCMain,AYUMI,0000,0000,0000,,انها بدأت تظلم
Dialogue: 0,0:14:04.71,0:14:07.24,DCMain,AYUMI,0000,0000,0000,,هل سيكون كونان كون بخير؟
Dialogue: 0,0:14:08.03,0:14:09.66,DCMain,HAIBARA,0000,0000,0000,,تقصد أننا سوف نكون بخير؟
Dialogue: 0,0:14:09.92,0:14:11.72,DCMain,AYUMI,0000,0000,0000,,... أ-أقصد ذلك
Dialogue: 0,0:14:12.31,0:14:16.18,DCMain,MITSUHIKO,0000,0000,0000,,يبدو أننا فقدناه
Dialogue: 0,0:14:16.18,0:14:18.27,DCMain,GENTA,0000,0000,0000,,ماذا؟ لا يمكن أن يكون بخطر
Dialogue: 0,0:14:18.27,0:14:22.54,DCMain,GENTA,0000,0000,0000,,...ماذا عن العشاء؟ وجبة عشاء
Dialogue: 0,0:14:24.34,0:14:26.50,DCMain,HAIBARA,0000,0000,0000,,،منذ النهار وهو بهذه الطريقة
Dialogue: 0,0:14:27.18,0:14:28.74,DCMain,HAIBARA,0000,0000,0000,,المحيط بهاذ الطريقة
Dialogue: 0,0:14:29.64,0:14:32.19,DCMain,HAIBARA,0000,0000,0000,,،لا يزال بإمكاننا تحديد الاتجاهات في الوقت الحالي
Dialogue: 0,0:14:32.55,0:14:34.97,DCMain,HAIBARA,0000,0000,0000,,حتى نتمكن من العودة إذا كنا بحاجة إلى
Dialogue: 0,0:14:35.34,0:14:36.79,DCMain,AYUMI,0000,0000,0000,,حقًا، أي تشان؟
Dialogue: 0,0:14:36.79,0:14:38.62,DCMain,MITSUHIKO,0000,0000,0000,,! مثيرة للإعجاب كما هو الحال دائمًا، هيبارا سان
Dialogue: 0,0:14:39.00,0:14:40.73,DCMain,GENTA,0000,0000,0000,,! حتى نتمكن من الحصول على العشاء؟
Dialogue: 0,0:14:41.00,0:14:44.97,DCMain,HAIBARA,0000,0000,0000,,نعم، دعنا نذهب أبعد قليلاً
Dialogue: 0,0:14:46.49,0:14:48.77,DCMain,CONAN,0000,0000,0000,,... إذا واصلت السير بهذه الطريقة
Dialogue: 0,0:14:49.34,0:14:50.61,DCMain,CONAN,0000,0000,0000,,اين انا؟
Dialogue: 0,0:14:51.05,0:14:53.45,DCMain,CONAN,0000,0000,0000,,، وضع الشمس هناك
Dialogue: 0,0:14:54.12,0:14:56.10,DCMain,CONAN,0000,0000,0000,,... والمحيطات بهذه الطريقة، لذلك
Dialogue: 0,0:14:58.59,0:14:59.81,DCMain,CONAN,0000,0000,0000,,هذا هو...؟
Dialogue: 0,0:15:00.59,0:15:02.59,DCMain,CONAN,0000,0000,0000,,أنا داخل كهف
Dialogue: 0,0:15:08.08,0:15:09.38,DCMain,CONAN,0000,0000,0000,,نسيم البحر؟
Dialogue: 0,0:15:09.88,0:15:13.05,DCMain,CONAN,0000,0000,0000,,لذلك هناك مخرج على الجانب الآخر؟
Dialogue: 0,0:15:18.24,0:15:19.71,DCMain,CONAN,0000,0000,0000,,بالطبع لا
Dialogue: 0,0:15:25.37,0:15:29.20,DCMain,CONAN,0000,0000,0000,,... هذا مثير للإعجاب
Dialogue: 0,0:15:31.17,0:15:34.21,DCMain,CONAN,0000,0000,0000,,انتظر، ليس لدي وقتٍ للتفاف الطرق
Dialogue: 0,0:15:41.55,0:15:46.22,DCMain,CONAN,0000,0000,0000,,أنا أخيرًا هنا، ولكن \Nانها مظلمة تمامًا
Dialogue: 0,0:16:00.08,0:16:01.55,DCMain,CONAN,0000,0000,0000,,هل فقدت مرة أخرى؟
Dialogue: 0,0:16:02.45,0:16:04.02,DCMain,CONAN,0000,0000,0000,,سأضطر إلى العودة
Dialogue: 0,0:16:05.52,0:16:06.27,DCMain,CONAN,0000,0000,0000,,ما هذا؟
Dialogue: 0,0:16:23.14,0:16:24.39,DCMain,CONAN,0000,0000,0000,,وجدت ذلك
Dialogue: 0,0:16:50.63,0:16:52.06,DCMain,MAN B,0000,0000,0000,,يالك من أبله
Dialogue: 0,0:16:52.51,0:16:55.14,DCMain,MAN A,0000,0000,0000,,ماذا سنفعل، زورو سان؟
Dialogue: 0,0:16:56.70,0:17:01.79,Go,TEXT,0000,0000,0000,,{\fad(250,250)}ميزوروجي غو (35) \Nالسارق المسلح زورو
Dialogue: 0,0:16:56.78,0:17:02.20,DCMain,MIZOROGI,0000,0000,0000,,{\an8}كنت أعرف بالضبط أين كنت أذهب، ايسيهارا
Dialogue: 0,0:17:07.26,0:17:08.42,DCItalic,CONAN,0000,0000,0000,,انه هو
Dialogue: 0,0:17:10.26,0:17:12.32,DCMain,ISEHARA,0000,0000,0000,,أ-أقطع لي
Dialogue: 0,0:17:12.82,0:17:15.84,DCMain,ISEHARA,0000,0000,0000,,ارجوا أن تخبرني
Dialogue: 0,0:17:16.10,0:17:18.84,DCMain,MIZOROGI,0000,0000,0000,,زوجتك واطفالك؟
Dialogue: 0,0:17:18.84,0:17:20.72,DCMain,MIZOROGI,0000,0000,0000,,الحديث عن ميلودراماتيك
Dialogue: 0,0:17:23.69,0:17:25.85,DCMain,MIZOROGI,0000,0000,0000,,تحدثت، أليس كذلك؟
Dialogue: 0,0:17:27.85,0:17:29.86,DCMain,ISEHARA,0000,0000,0000,,!أنا-أنا لم أقل أي شيء
Dialogue: 0,0:17:30.31,0:17:32.33,DCMain,MIZOROGI,0000,0000,0000,,سوف تتيح لك اختيار
Dialogue: 0,0:17:33.25,0:17:36.37,DCMain,MIZOROGI,0000,0000,0000,,،إما سأقتل عائلتك
Dialogue: 0,0:17:36.37,0:17:38.77,DCMain,MIZOROGI,0000,0000,0000,,أو تموت هنا
Dialogue: 0,0:17:39.12,0:17:40.74,DCMain,MIZOROGI,0000,0000,0000,,الأمر متروك لك
Dialogue: 0,0:17:43.09,0:17:44.37,DCMain,MIZOROGI,0000,0000,0000,,اختر الآن
Dialogue: 0,0:18:25.90,0:18:26.54,DCMain,MIZOROGI,0000,0000,0000,,من هناك؟
Dialogue: 0,0:18:33.45,0:18:34.49,DCMain,MIZOROGI,0000,0000,0000,,!إسيهارا
Dialogue: 0,0:18:40.38,0:18:41.62,DCMain,CONAN,0000,0000,0000,,هنا
Dialogue: 0,0:18:42.02,0:18:42.89,DCMain,ISEHARA,0000,0000,0000,,من أنت؟
Dialogue: 0,0:18:43.54,0:18:45.81,DCMain,CONAN,0000,0000,0000,,إدوغاوا كونان. أنا مخبر
Dialogue: 0,0:18:46.14,0:18:47.55,DCMain,ISEHARA,0000,0000,0000,,أ-أ المباحث؟
Dialogue: 0,0:18:47.55,0:18:48.63,DCMain,MIZOROGI,0000,0000,0000,,إلى اين ذهب؟
Dialogue: 0,0:18:49.69,0:18:50.60,DCMain,CONAN,0000,0000,0000,,أسرع
Dialogue: 0,0:18:53.18,0:18:54.12,DCMain,MIZOROGI,0000,0000,0000,,طفل؟
Dialogue: 0,0:19:07.40,0:19:08.56,DCMain,MIZOROGI,0000,0000,0000,,عليك اللعنة
Dialogue: 0,0:19:09.67,0:19:11.13,DCMain,MIZOROGI,0000,0000,0000,,!أين ذهبوا؟
Dialogue: 0,0:19:15.34,0:19:17.17,DCMain,ISEHARA,0000,0000,0000,,انهم سوف يقتلوني
Dialogue: 0,0:19:18.09,0:19:19.29,DCMain,CONAN,0000,0000,0000,,انتَ بخير
Dialogue: 0,0:19:19.71,0:19:21.93,DCMain,CONAN,0000,0000,0000,,انهم لا يعرفون أين نحن
Dialogue: 0,0:19:31.44,0:19:34.44,DCMain,ISEHARA,0000,0000,0000,,!لا! أنا لا أريد أن أموت
Dialogue: 0,0:19:35.64,0:19:36.58,DCMain,MIZOROGI,0000,0000,0000,,من هنا
Dialogue: 0,0:19:39.70,0:19:40.97,DCMain,CONAN,0000,0000,0000,,!انتظر
Dialogue: 0,0:20:05.81,0:20:07.02,DCMain,CONAN,0000,0000,0000,,...هذا المكان
Dialogue: 0,0:20:29.64,0:20:30.46,DCMain,GENTA,0000,0000,0000,,! كونان
Dialogue: 0,0:20:30.46,0:20:32.46,DCMain,MITSUHIKO,0000,0000,0000,,ماذا؟ كونان كون؟
Dialogue: 0,0:20:32.96,0:20:33.96,DCMain,AYUMI,0000,0000,0000,,! كونان كون
Dialogue: 0,0:20:41.48,0:20:44.22,DCMain,KOGORO,0000,0000,0000,,مرة اخرى. لا، اثنين آخرين
Dialogue: 0,0:20:45.00,0:20:47.47,DCMain,RAN,0000,0000,0000,,لدي شعور سيء
Dialogue: 0,0:20:48.40,0:20:50.22,DCMain,RAN,0000,0000,0000,,هل يمكن أن تذهب أسرع؟
Dialogue: 0,0:20:53.80,0:20:56.50,DCMain,RAN,0000,0000,0000,,أبي، استيقظ
Dialogue: 0,0:20:59.44,0:21:03.24,DCMain,ISEHARA,0000,0000,0000,,أ-أجبني، من فضلك
Dialogue: 0,0:21:03.64,0:21:08.24,DCMain,MIZOROGI,0000,0000,0000,,كنت وضعتنا من خلال كل هذا \Nالعمل لا لزوم لها، خائن
Dialogue: 0,0:21:19.55,0:21:20.72,DCMain,MIZOROGI,0000,0000,0000,,متّ
Dialogue: 0,0:21:44.98,0:21:47.71,DCMain,AYUMI,0000,0000,0000,,!كونان كون
Dialogue: 0,0:21:54.55,0:21:56.70,DCMain,KOGORO,0000,0000,0000,,آه، الأستاذ أغاسا
Dialogue: 0,0:21:56.70,0:21:59.13,DCMain,KOGORO,0000,0000,0000,,شكرًا لك لئنك اتيت
Dialogue: 0,0:22:00.00,0:22:02.63,DCMain,RAN,0000,0000,0000,,هل حدث شيء للأطفال؟
Dialogue: 0,0:22:02.85,0:22:03.37,DCMain,KOGORO,0000,0000,0000,,هاه؟
Dialogue: 0,0:22:03.37,0:22:07.80,DCMain,AGASA,0000,0000,0000,,أنا-سمعت للتو من الأطفال
Dialogue: 0,0:22:09.73,0:22:10.80,DCMain,RAN,0000,0000,0000,,ماذا؟
Dialogue: 0,0:22:12.14,0:22:13.31,DCMain,RAN,0000,0000,0000,,... كونان كون هو
Dialogue: 0,0:22:13.31,0:22:15.16,DCMain,KOGORO,0000,0000,0000,,أنا- هل هو ...؟
Dialogue: 0,0:22:16.12,0:22:17.06,DCMain,KOGORO,0000,0000,0000,,!ران
Dialogue: 0,0:22:17.92,0:22:18.98,DCMain,KOGORO,0000,0000,0000,,!ران
Dialogue: 0,0:23:45.02,0:24:09.05,DCEpPreview,TEXT,0000,0000,0000,,معاينة الحلقة
Dialogue: 0,0:23:45.55,0:23:46.86,DCMain,AYUMI,0000,0000,0000,,...كونان كون هو
Dialogue: 0,0:23:47.14,0:23:48.51,DCMain,MITSUHIKO,0000,0000,0000,,لا يمكن أن يكون صحيحًا
Dialogue: 0,0:23:48.51,0:23:51.57,DCMain,GENTA,0000,0000,0000,,لٓ-لكننا جميعًا رأينا ذلك
Dialogue: 0,0:23:51.57,0:23:53.87,DCMain,MEGURE,0000,0000,0000,,!لن ندع ذلك يحدث
Dialogue: 0,0:23:54.56,0:23:55.87,DCMain,KOGORO,0000,0000,0000,,المفتش
Dialogue: 0,0:23:56.04,0:23:58.74,DCMain,RAN,0000,0000,0000,,ماذا؟ أي تشان في عداد المفقودين، أيضًا؟
Dialogue: 0,0:23:59.76,0:24:02.30,DCMain,HAIBARA,0000,0000,0000,,جائت وحدها كما كانت تعليمات
Dialogue: 0,0:24:04.64,0:24:05.60,DCMain,MIZOROGI,0000,0000,0000,,لنذهب
Dialogue: 0,0:24:09.05,0:24:15.05,DCNextEp,TEXT,0000,0000,0000,,كونان يختفي فوق جرف \N(الجزء الثاني)
Dialogue: 0,0:24:09.74,0:24:14.55,DCMain,CONAN,0000,0000,0000,,الحلقة التالية من كونان هي "كونان \N! يختفي فوق جرف، الجزء الثاني "
Dialogue: 0,0:24:30.07,0:24:35.07,Hint,TEXT,0000,0000,0000,,كلمه السر
Dialogue: 0,0:24:30.33,0:24:33.10,DCMain,ALL,0000,0000,0000,,!التالي تلميح كونان
Dialogue: 0,0:24:33.10,0:24:34.53,DCMain,HAIBARA,0000,0000,0000,,كلمة السر
Dialogue: 0,0:24:35.07,0:24:35.98,DCMain,GENTA,0000,0000,0000,,{\an8}كونان، هل أنت جاد؟
Dialogue: 0,0:24:35.07,0:24:40.08,Don'tMiss,TEXT,0000,0000,0000,,لا تفوت الحلقة التالية
Dialogue: 0,0:24:35.98,0:24:36.70,DCMain,AYUMI,0000,0000,0000,,{\an8}! لا يمكن
Dialogue: 0,0:24:36.70,0:24:37.67,DCMain,MITSUHIKO,0000,0000,0000,,{\an8}! هذا مستحيل
Dialogue: 0,0:24:37.67,0:24:39.16,DCMain,HAIBARA,0000,0000,0000,,{\an8}سيكون علينا أن ننتظر حتى الأسبوع المقبل
Dialogue: 0,0:24:39.16,0:24:41.16,DCMain,,0000,0000,0000,,www.ttopanime.blogspot.com


