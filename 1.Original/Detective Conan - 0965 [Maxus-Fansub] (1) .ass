Dialogue: 0,0:00:02.89,0:00:06.36,DCMain,CONAN,0,0,0,,!كل عام وأنتم بخير
Dialogue: 0,0:00:06.59,0:00:10.65,DCMain,CONAN,0,0,0,,شكرًا لكم على دعمكم لنا العام الماضي
Dialogue: 0,0:00:10.65,0:00:15.53,DCMain,CONAN,0,0,0,,سوف نبذل قصارى جهدنا لإمتاعكم هذا العام أيضًا
Dialogue: 0,0:00:15.87,0:00:18.77,DCMain,CONAN,0,0,0,,نحن تحت رعايتكم
Dialogue: 0,0:00:52.13,0:00:54.20,DCMain,YAIBA,0,0,0,,!ركلة يايبا
Dialogue: 0,0:01:07.42,0:01:08.80,DCMain,GENTA,0,0,0,,أليس مذهلًا؟
Dialogue: 0,0:01:08.80,0:01:10.96,DCMain,GENTA,0,0,0,,!غوميرا ضد يايبا
Dialogue: 0,0:01:11.13,0:01:13.54,DCMain,MITSUHIKO,0,0,0,,!إنه شيء خارق حقًا
Dialogue: 0,0:01:13.54,0:01:15.26,DCMain,AYUMI,0,0,0,,!أريد مشاهدته حالًا
Dialogue: 0,0:01:15.26,0:01:20.07,DCMain,HAIBARA,0,0,0,,لكن، يبدو أنهم بدؤوا للتو في العمل عليه؛ إذ أن هذا إعلان إنتاج الفلم
Dialogue: 0,0:01:20.07,0:01:21.85,DCMain,HAIBARA,0,0,0,,مما يعني أنه سيستغرق مدةً حتى يُنتج
Dialogue: 0,0:01:21.85,0:01:25.10,DCMain,AYUMI,0,0,0,,ماذا؟ لكني أتوق لمشاهدته في الحال
Dialogue: 0,0:01:25.10,0:01:27.94,DCMain,HEIJI,0,0,0,,..لا أُصدق أنهم سيُصورون فلمًا لـكايجو
Dialogue: 0,0:01:27.94,0:01:29.86,DCMain,HEIJI,0,0,0,,احتفالًا بتشييدهم للمبنى الجديد
Dialogue: 0,0:01:30.23,0:01:32.15,DCMain,HEIJI,0,0,0,,الغاية تبرر الوسيلة
Dialogue: 0,0:01:32.15,0:01:33.40,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:01:33.40,0:01:38.18,DCMain,CONAN,0,0,0,,لكن لأجل ذلك، سبب تعلقنا الغريب بـغوميرا ويايبا
Dialogue: 0,0:01:38.18,0:01:40.95,DCMain,CONAN,0,0,0,,هو أننا جميعًا دعينا للحفل
Dialogue: 0,0:01:41.98,0:01:43.38,DCMain,KOGORO,0,0,0,,!لذيذ
Dialogue: 0,0:01:45.56,0:01:49.48,DCMain,CONAN,0,0,0,,إذًا، هل دُعيت عن طريق والدك؟
Dialogue: 0,0:01:49.48,0:01:51.40,DCMain,HEIJI,0,0,0,,لا، بل هي السبب
Dialogue: 0,0:01:54.76,0:01:57.27,DCMain,KAZUKA,0,0,0,,!إن غوميرا رائع جدًا
Dialogue: 0,0:01:57.27,0:01:59.26,DCMain,RAN,0,0,0,,..أجل
Dialogue: 0,0:01:59.70,0:02:02.58,DCMain,RAN,0,0,0,,كازوها-تشان، لم أعلم أنك تحبين كايجو
Dialogue: 0,0:02:02.58,0:02:04.27,DCMain,KAZUHA,0,0,0,,..غوميرا استثنائي
Dialogue: 0,0:02:04.54,0:02:08.05,DCMain,KAZUHA,0,0,0,,أيام طفولتي كنت أشاهد أفلامه في المسرح مع هيجي
Dialogue: 0,0:02:08.05,0:02:09.77,DCMain,KAZUHA,0,0,0,,!كنت متأثرة جدًا
Dialogue: 0,0:02:10.00,0:02:12.27,DCMain,RAN,0,0,0,,حقًا؟
Dialogue: 0,0:02:12.46,0:02:17.44,DCMain,KAZUHA,0,0,0,,لكن منذ فلم "إلى الأبد"، بعد "المعركة الأخيرة"، استبدلوا الممثل بداخل الزي
Dialogue: 0,0:02:17.44,0:02:21.80,DCMain,KAZUHA,0,0,0,,أفلامه لم تعد بتلك القوة لفترة، لكنا حصلنا على هذا الآن
Dialogue: 0,0:02:21.80,0:02:24.32,DCMain,KAZUHA,0,0,0,,!أنا متشوّقة للغاية
Dialogue: 0,0:02:24.32,0:02:25.86,DCMain,RAN,0,0,0,,{\a6\be1}أنت على دارية واسعة به فعلًا
Dialogue: 0,0:02:25.32,0:02:30.11,DCMain,HEIJI,0,0,0,,ظننت أني أعلم كل شيء عن كازوها، لكن يبدو أني أجهل الكثير
Dialogue: 0,0:02:25.86,0:02:28.65,DCMain,KAZUHA,0,0,0,,{\an8\be1}!سيكون فائق الجودة
Dialogue: 0,0:02:30.11,0:02:31.41,DCMain,KAZUHA,0,0,0,,!لنشاهده معًا
Dialogue: 0,0:02:31.41,0:02:32.39,DCMain,KAZUHA,0,0,0,,!هيجي
Dialogue: 0,0:02:32.39,0:02:33.29,DCMain,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,0:02:33.57,0:02:36.62,DCMain,KAZUHA,0,0,0,,!لنلتقط صورةً مع غوميرا
Dialogue: 0,0:02:36.62,0:02:37.89,DCMain,HEIJI,0,0,0,,!بئسًا
Dialogue: 0,0:02:37.89,0:02:39.80,DCMain,HEIJI,0,0,0,,..رفقًا بي
Dialogue: 0,0:02:40.28,0:02:42.34,DCItalic,CONAN,0,0,0,,!لا يقول لا أبدًا، مع ذلك
Dialogue: 0,0:02:43.33,0:02:44.70,DCMain,RAN,0,0,0,,سأُصوركما
Dialogue: 0,0:02:45.49,0:02:47.31,DCMain,RAN,0,0,0,,!ابتسما
Dialogue: 0,0:02:46.19,0:02:47.31,DCMain,KAZUHA,0,0,0,,{\an8\be1}!غوميرا
Dialogue: 0,0:04:54.89,0:04:56.43,DCMain,YONEKURA,0,0,0,,{\an8\be1}!مرحبًا بكم جميعًا
Dialogue: 0,0:04:56.43,0:05:01.78,DCMain,YONEKURA,0,0,0,,{\an8\be1}شكرًا لقدومكم الحدث الإعلاني عن الفلم التذكاري المنشأ احتفالًا \Nبتشييد مبنى تلفاز نيتشيوري الجديد
Dialogue: 0,0:05:02.01,0:05:09.66,DCMain,YONEKURA,0,0,0,,{\be1\an8}"الحدث الإعلاني لفلم "كايجو غوميرا ضد كامين يايبا
Dialogue: 0,0:05:09.87,0:05:13.55,DCMain,HEIJI,0,0,0,,أعتقد أني أعرف هذا المنتج
Dialogue: 0,0:05:09.87,0:05:15.54,DCMain,YONEKURA,0,0,0,,{\an8\be1}،بعد هذا، سنقدم عرضًا لكامين يايبا
Dialogue: 0,0:05:13.55,0:05:17.73,DCMain,CONAN,0,0,0,,أجل، إنه ملقب بصانع الصيت لتلفاز نيتشيوري
Dialogue: 0,0:05:15.54,0:05:19.24,DCMain,YONEKURA,0,0,0,,{\an8\be1}وأيضًا سنُعلن عن شيء جديد لـكايجو، لذا لا تفوتوا الأمر
Dialogue: 0,0:05:17.73,0:05:20.17,DCMain,CONAN,0,0,0,,إنه يظهر على التلفاز أحيانًا
Dialogue: 0,0:05:20.78,0:05:24.42,DCMain,CONAN,0,0,0,,بدأ في مجال صناعة الأفلام منذ أعوام قليلة
Dialogue: 0,0:05:22.46,0:05:27.95,DCMain,SUZUKI,0,0,0,,{\an8\be1}لدينا تحضيرات كثيرة للحدث التالي، لذا توقعوا ذلك فيما بينكم
Dialogue: 0,0:05:25.69,0:05:27.95,DCMain,HEIJI,0,0,0,,من التلفاز إلى صناعة الأفلام؟
Dialogue: 0,0:05:27.95,0:05:30.43,DCMain,KOSUGI,0,0,0,,أعتذر عن مقاطعتكم
Dialogue: 0,0:05:30.69,0:05:34.01,DCMain,KOSUGI,0,0,0,,أنت المحقق العظيم موري كوغورو-سان، صحيح؟
Dialogue: 0,0:05:34.01,0:05:35.18,DCMain,KOGORO,0,0,0,,أجل
Dialogue: 0,0:05:35.84,0:05:38.10,DCMain,KOSUGI,0,0,0,,{\an8\be1}أنا مساعد يونيكرا
Dialogue: 0,0:05:38.10,0:05:39.69,DCMain,KOSUGI,0,0,0,,{\an8\be1}اسمي كوسوغي
Dialogue: 0,0:05:39.92,0:05:41.19,DCMain,KOGORO,0,0,0,,تشرفنا
Dialogue: 0,0:05:41.71,0:05:44.29,DCMain,KOSUGI,0,0,0,,أتتطلع للعمل مع سيادتك غدًا في تصوير الفلم
Dialogue: 0,0:05:44.29,0:05:46.10,DCMain,KOGORO,0,0,0,,ماذا؟ تصوير الفلم؟
Dialogue: 0,0:05:46.10,0:05:50.37,DCMain,RAN,0,0,0,,أبي، كان ذلك مكتوبًا في الدعوة
Dialogue: 0,0:05:50.62,0:05:52.22,DCMain,KOGORO,0,0,0,,حقًا؟
Dialogue: 0,0:05:52.22,0:05:53.83,DCMain,KAZUHA,0,0,0,,أجل
Dialogue: 0,0:05:53.83,0:05:57.66,DCMain,KAZUHA,0,0,0,,سيُصورون غدًا مشهدًا احتشاديًّا في منتزه قلعة أوساكا
Dialogue: 0,0:05:57.88,0:05:59.20,DCMain,KOGORO,0,0,0,,مشهدًا احتشاديًّا؟
Dialogue: 0,0:05:59.20,0:06:04.16,DCMain,MITSUHIKO,0,0,0,,!سيُصورون مشهدًا تهرب فيه الناس من كايجو الذي سيظهر في قلعة أوساكا
Dialogue: 0,0:06:04.16,0:06:06.21,DCMain,GENTA,0,0,0,,إصافيون؟
Dialogue: 0,0:06:06.21,0:06:07.42,DCMain,HAIBARA,0,0,0,,بل إضافيون
Dialogue: 0,0:06:07.42,0:06:10.59,DCMain,GENTA,0,0,0,,سنلعب دور الممثلين الإضافيين، صحيح؟
Dialogue: 0,0:06:10.59,0:06:12.68,DCMain,AYUMI,0,0,0,,سنظهر في الفلم أيضًا، صحيح؟
Dialogue: 0,0:06:12.93,0:06:14.62,DCMain,KOSUGI,0,0,0,,أجل، بالطبع
Dialogue: 0,0:06:14.62,0:06:15.85,DCMain,AYUMI,0,0,0,,!مرحى
Dialogue: 0,0:06:15.85,0:06:19.55,DCMain,MITSUHIKO,0,0,0,,لكن نظرًا لأنه مشهد احتشادي، فسيكون ثمة أناس كُثر
Dialogue: 0,0:06:19.55,0:06:22.62,DCMain,GENTA,0,0,0,,!إذًا لنرتدي أزياءً بارزةً
Dialogue: 0,0:06:22.62,0:06:23.78,DCMain,AYUMI,0,0,0,,مثل كايتو كيد؟
Dialogue: 0,0:06:23.78,0:06:25.69,DCMain,MITSUHIKO,0,0,0,,!يا لها من فكرة عظيمة
Dialogue: 0,0:06:38.69,0:06:40.00,DCMain,STAFF,0,0,0,,يونيكرا-سان؟
Dialogue: 0,0:06:40.78,0:06:44.25,DCMain,STAFF,0,0,0,,ما بك؟ تبدو متجهم الوجه
Dialogue: 0,0:06:44.25,0:06:47.74,DCMain,YONEKURA,0,0,0,,لا شيء، أفكر في أمر ما
Dialogue: 0,0:06:47.74,0:06:49.55,DCMain,YONEKURA,0,0,0,,بوركت جهودك
Dialogue: 0,0:06:49.55,0:06:51.06,DCMain,STAFF,0,0,0,,بوركت جهودك
Dialogue: 0,0:07:02.37,0:07:04.02,DCMain,YONEKURA,0,0,0,,!كوسوغي
Dialogue: 0,0:07:04.48,0:07:06.46,DCMain,YONEKURA,0,0,0,,أين أنت، يا كوسوغي؟
Dialogue: 0,0:07:09.67,0:07:11.78,DCMain,YONEKURA,0,0,0,,!سحقًا، أخفتني
Dialogue: 0,0:07:32.81,0:07:36.05,DCMain,YONEKURA,0,0,0,,بئس الأمر، لماذا يجدر بأوندا فعل ذلك؟
Dialogue: 0,0:07:58.58,0:08:01.21,DCMain,HAIBARA,0,0,0,,إنهم يعطوننا وقتًا طويلًا للدردشة معًا
Dialogue: 0,0:08:01.21,0:08:02.41,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:08:05.21,0:08:06.08,DCMain,HAIBARA,0,0,0,,ما الذي يجري؟
Dialogue: 0,0:08:06.51,0:08:08.34,DCMain,HAIBARA,0,0,0,,يبدون مرتبكين
Dialogue: 0,0:08:08.88,0:08:09.63,DCMain,CONAN,0,0,0,,معك حق
Dialogue: 0,0:08:18.47,0:08:20.60,DCMain,KOGORO,0,0,0,,ماذا يجري؟
Dialogue: 0,0:08:21.48,0:08:22.13,DCMain,KOGORO,0,0,0,,..مهلًا
Dialogue: 0,0:08:22.65,0:08:23.94,DCMain,KOGORO,0,0,0,,ما هذا؟
Dialogue: 0,0:08:23.94,0:08:24.59,DCMain,CONAN,0,0,0,,!معذرةً
Dialogue: 0,0:08:24.59,0:08:25.20,DCMain,HEIJI,0,0,0,,!دعونا نمر
Dialogue: 0,0:08:25.20,0:08:26.48,DCMain,SUZUKI,0,0,0,,!تمهلا
Dialogue: 0,0:08:26.48,0:08:27.95,DCMain,SUZUKI,0,0,0,,!لا يمكنكما الدخول
Dialogue: 0,0:08:30.77,0:08:32.53,DCMain,KOGORO,0,0,0,,ماذا يجري هنا؟
Dialogue: 0,0:08:32.53,0:08:34.31,DCMain,SUZUKI,0,0,0,,..ثمة
Dialogue: 0,0:08:35.92,0:08:37.87,DCMain,KOGORO,0,0,0,,!ما هذا؟
Dialogue: 0,0:08:38.26,0:08:39.71,DCMain,KOGORO,0,0,0,,هل اتصلتم بالشرطة؟
Dialogue: 0,0:08:39.71,0:08:41.88,DCMain,SUZUKI,0,0,0,,نعم، للتو
Dialogue: 0,0:08:41.88,0:08:43.87,DCMain,KOGORO,0,0,0,,!لا تلمس الجثة
Dialogue: 0,0:08:53.59,0:08:55.14,DCMain,OTAKI,0,0,0,,{\an8\be1}!يا لها من خاتمة شنيعة
Dialogue: 0,0:08:55.14,0:08:57.44,DCMain,OTAKI,0,0,0,,{\an8\be1}طعن مباشر في المعدة بناب
Dialogue: 0,0:08:57.44,0:08:58.64,DCMain,KOGORO,0,0,0,,أجل
Dialogue: 0,0:08:59.49,0:09:00.18,DCMain,OTAKI,0,0,0,,!حسنًا
Dialogue: 0,0:09:00.80,0:09:02.82,DCMain,KOGORO,0,0,0,,الضحية هو يونيكرا إيساتو
Dialogue: 0,0:09:02.82,0:09:04.77,DCMain,KOGORO,0,0,0,,يعمل هنا كمنتج
Dialogue: 0,0:09:05.22,0:09:09.54,DCMain,OTAKI,0,0,0,,حسنًا، لكن المكان مظلم جدًا هنا
Dialogue: 0,0:09:09.54,0:09:11.74,DCMain,OTAKI,0,0,0,,ألا يمكنكم زيادة الإضاءة هنا؟
Dialogue: 0,0:09:11.74,0:09:12.88,DCMain,POLICE,0,0,0,,..آسف
Dialogue: 0,0:09:12.88,0:09:16.66,DCMain,POLICE,0,0,0,,نواجه مشاكل في النظام الكهربائي هنا، لذا لا نستطيع زيادتها
Dialogue: 0,0:09:16.83,0:09:19.01,DCMain,OTAKI,0,0,0,,..سحقًا، على هذا الحال
Dialogue: 0,0:09:19.01,0:09:20.64,DCMain,OTAKI,0,0,0,,!أنت هناك
Dialogue: 0,0:09:20.64,0:09:21.29,DCMain,POLICE,0,0,0,,أجل؟
Dialogue: 0,0:09:21.72,0:09:25.33,DCMain,OTAKI,0,0,0,,!افتح الباب، سيزيد ذلك من إضاءة المكان قليلًا
Dialogue: 0,0:09:25.33,0:09:26.67,DCMain,POLICE,0,0,0,,..في الواقع
Dialogue: 0,0:09:26.99,0:09:31.00,DCMain,POLICE,0,0,0,,يُغلق هذا الباب تلقائيًا، ما لم يُثبت يدويًا
Dialogue: 0,0:09:31.80,0:09:32.92,DCMain,OTAKI,0,0,0,,أأنت أحمق؟
Dialogue: 0,0:09:33.31,0:09:36.34,DCMain,OTAKI,0,0,0,,!إذًا ثبته بأي شيء
Dialogue: 0,0:09:36.34,0:09:37.64,DCMain,KOGORO,0,0,0,,!اهدأ، اهدأ
Dialogue: 0,0:09:37.64,0:09:41.17,DCMain,KOGORO,0,0,0,,..على كل حال، يبدو أن هذا لم يكن مفتعلًا
Dialogue: 0,0:09:41.17,0:09:42.50,DCMain,KOGORO,0,0,0,,!فلا مشكلة إذًا
Dialogue: 0,0:09:42.50,0:09:43.96,DCMain,OTAKI,0,0,0,,..أتفق معك
Dialogue: 0,0:09:43.96,0:09:46.35,DCMain,HEIJI,0,0,0,,أواثقان من ذلك؟
Dialogue: 0,0:09:46.63,0:09:49.01,DCMain,KOGORO,0,0,0,,..واثقان أم لا، فمهما نظرت
Dialogue: 0,0:09:49.01,0:09:51.23,DCMain,HEIJI,0,0,0,,!انظرا إلى يد الضحية اليمنى
Dialogue: 0,0:09:52.31,0:09:53.61,DCMain,KOGORO,0,0,0,,ما بها يده اليمنى؟
Dialogue: 0,0:09:54.94,0:09:55.85,DCMain,OTAKI,0,0,0,,ماذا؟
Dialogue: 0,0:09:55.85,0:09:58.74,DCMain,OTAKI,0,0,0,,مُسحت الدماء من على سبابته فقط
Dialogue: 0,0:09:58.74,0:09:59.73,DCMain,KOGORO,0,0,0,,أجل
Dialogue: 0,0:09:59.73,0:10:03.03,DCMain,CONAN,0,0,0,,!وانظرا للهاتف المحمول بجواره
Dialogue: 0,0:10:03.03,0:10:03.87,DCMain,KOGORO,0,0,0,,الهاتف؟
Dialogue: 0,0:10:04.36,0:10:05.35,DCMain,KOGORO,0,0,0,,ما هذا؟
Dialogue: 0,0:10:05.35,0:10:08.75,DCMain,OTAKI,0,0,0,,..هكذا إذًا، زر بصمة الإصبع
Dialogue: 0,0:10:09.03,0:10:14.50,DCMain,HEIJI,0,0,0,,..كان الضحية واعيًا بعدما طُعن في معدته
Dialogue: 0,0:10:14.50,0:10:17.76,DCMain,HEIJI,0,0,0,,وقد أخرج هاتفه وفتح قفل الشاشة
Dialogue: 0,0:10:17.99,0:10:23.42,DCMain,CONAN,0,0,0,,!ومسح الدم من على سبابته، ليتمكن من فتح الهاتف
Dialogue: 0,0:10:24.02,0:10:28.71,DCMain,OTAKI,0,0,0,,حسنًا، سأصدر أمرًا بفحص شامل لبيانات الهاتف
Dialogue: 0,0:10:28.71,0:10:29.74,DCMain,HEIJI,0,0,0,,أجل
Dialogue: 0,0:10:29.74,0:10:30.85,DCMain,POLICE,0,0,0,,!أيها المفتش أوتاكي
Dialogue: 0,0:10:30.85,0:10:31.65,DCMain,OTAKI,0,0,0,,ماذا؟
Dialogue: 0,0:10:31.93,0:10:34.15,DCMain,POLICE,0,0,0,,!ألقِ نظرةً على هذا الحبل
Dialogue: 0,0:10:36.69,0:10:41.60,DCMain,HEIJI,0,0,0,,!فهمت، إنه مهترئ، لكن هذا القطع ليس طبيعيًا
Dialogue: 0,0:10:41.60,0:10:42.41,DCMain,POLICE,0,0,0,,!أجل
Dialogue: 0,0:10:42.81,0:10:47.85,DCMain,POLICE,0,0,0,,من الواضح أنه حبل متين، لذا فمن المرجح أن من قطعه عانى بشدة
Dialogue: 0,0:10:47.85,0:10:52.13,DCMain,CONAN,0,0,0,,!انظروا، ثمة خدش هنا
Dialogue: 0,0:10:52.13,0:10:56.47,DCMain,POLICE,0,0,0,,أجل، لا بد أن هذا الخدش أحدثه سكين حاد أو ما شابه
Dialogue: 0,0:10:56.47,0:10:58.94,DCMain,KOGORO,0,0,0,,خدش سكين على قمة الرف؟
Dialogue: 0,0:10:59.90,0:11:05.58,DCMain,KOGORO,0,0,0,,مما يعني أن الجاني أوقع السكين أثناء قطعه للحبل فخدش الرف
Dialogue: 0,0:11:05.58,0:11:06.39,DCMain,POLICE,0,0,0,,أجل
Dialogue: 0,0:11:06.65,0:11:11.48,DCMain,POLICE,0,0,0,,لكن الخدش صغير جدًا \N لستُ واثقًا من كوننا سنتمكن من تحديد نوع السلاح المسبب له
Dialogue: 0,0:11:12.69,0:11:15.32,DCMain,HEIJI,0,0,0,,..أجل، لكن الأمر جلي الآن
Dialogue: 0,0:11:16.14,0:11:17.94,DCMain,HEIJI,0,0,0,,..هذا لم يكن حادثًا
Dialogue: 0,0:11:19.38,0:11:21.32,DCMain,HEIJI,0,0,0,,بل جريمة قتل
Dialogue: 0,0:11:22.78,0:11:25.33,DCMain,KOSUGI,0,0,0,,لا أستطيع تصديق ما حل بيونكرا-سان
Dialogue: 0,0:11:25.56,0:11:27.55,DCMain,KOSUGI,0,0,0,,إني أجهل ما يحدث
Dialogue: 0,0:11:27.55,0:11:32.71,DCMain,OTAKI,0,0,0,,إذًا، كيف كان أمن ذلك المستودع أو مسرح الجريمة بمعنًى أدق
Dialogue: 0,0:11:32.94,0:11:38.13,DCMain,KOSUGI,0,0,0,,إنه مغلق بهذه البطاقات
Dialogue: 0,0:11:38.13,0:11:41.30,DCMain,KOGORO,0,0,0,,من لديه مثلها؟
Dialogue: 0,0:11:41.30,0:11:45.22,DCMain,KOSUGI,0,0,0,,باحتساب يونيكرا-سان، فأعتقد أنهم 15 شخصًا
Dialogue: 0,0:11:45.72,0:11:49.84,DCMain,KOSUGI,0,0,0,,الكايجو الجدد كان يحتفظ بهم هناك سرًّا
Dialogue: 0,0:11:49.84,0:11:51.53,DCMain,KOSUGI,0,0,0,,،لحين أُعلن عنهم في حدث اليوم
Dialogue: 0,0:11:51.53,0:11:55.73,DCMain,KOSUGI,0,0,0,,لذا فثمة قلائل ممن يُسمح لهم بدخول هذه الغرفة
Dialogue: 0,0:11:56.06,0:11:57.17,DCMain,KOGORO,0,0,0,,فهمت
Dialogue: 0,0:11:57.17,0:11:59.60,DCMain,KOGORO,0,0,0,,هذا يقلص عدد المشتبه بهم
Dialogue: 0,0:11:59.60,0:12:00.96,DCMain,OTAKI,0,0,0,,أجل
Dialogue: 0,0:12:00.96,0:12:01.82,DCMain,KOSUGI,0,0,0,,!معذرةً
Dialogue: 0,0:12:02.42,0:12:05.49,DCMain,KOSUGI,0,0,0,,ألم يمت يونيكرا-سان جراء حادث؟
Dialogue: 0,0:12:05.93,0:12:08.00,DCMain,OTAKI,0,0,0,,نحن نتقصى الأمر حاليًا
Dialogue: 0,0:12:08.00,0:12:12.50,DCMain,OTAKI,0,0,0,,على كلٍ، سمعت أن ثمة مناوشات بينك وبين الضحية
Dialogue: 0,0:12:12.75,0:12:15.37,DCMain,KOSUGI,0,0,0,,..ماذا؟ أنا
Dialogue: 0,0:12:15.37,0:12:18.38,DCMain,OTAKI,0,0,0,,شوهدت وأنت تتجادل معه
Dialogue: 0,0:12:19.16,0:12:23.76,DCMain,OTAKI,0,0,0,,،على ما يبدو أن فكرة الفلم كانت منك
Dialogue: 0,0:12:23.76,0:12:26.45,DCMain,OTAKI,0,0,0,,لكن الضحية نسبها لنفسه
Dialogue: 0,0:12:26.45,0:12:27.39,DCMain,KOSUGI,0,0,0,,!هذا خطأ
Dialogue: 0,0:12:27.71,0:12:31.39,DCMain,KOSUGI,0,0,0,,!تناقشت مع يونيكرا-سان وخططنا لكل شيء معًا
Dialogue: 0,0:12:31.79,0:12:34.90,DCMain,KOGORO,0,0,0,,لكنه فعليًا نسب كل الحقوق لنفسه
Dialogue: 0,0:12:35.18,0:12:36.44,DCMain,KOSUGI,0,0,0,,!كلا
Dialogue: 0,0:12:36.44,0:12:37.98,DCMain,CONAN,0,0,0,,أونيسان
Dialogue: 0,0:12:38.54,0:12:42.34,DCMain,CONAN,0,0,0,,ما سبب ذهابك للمستودع آنذاك؟
Dialogue: 0,0:12:42.34,0:12:43.07,DCMain,KOSUGI,0,0,0,,ماذا؟
Dialogue: 0,0:12:43.40,0:12:48.23,DCMain,KOSUGI,0,0,0,,تلقيت رسالة على شكل ملاحظة من يونيكرا-سان يخبرني فيها أن أذهب للمستودع الساعة 2:30
Dialogue: 0,0:12:48.23,0:12:52.36,DCMain,KOSUGI,0,0,0,,،كان على يونيكرا-سان الرحيل لبانكوك مباشرة عقب الحدث
Dialogue: 0,0:12:52.36,0:12:55.18,DCMain,KOSUGI,0,0,0,,لذا ظننت أنه يريد مناقشة شيء ما قبيل رحيله
Dialogue: 0,0:12:55.18,0:12:58.37,DCMain,OTAKI,0,0,0,,إذًا أين تلك الورقة الآن؟
Dialogue: 0,0:12:58.37,0:12:59.78,DCMain,KOSUGI,0,0,0,,..رميتها
Dialogue: 0,0:12:59.78,0:13:01.71,DCMain,KOSUGI,0,0,0,,كما طُلب مني فيها
Dialogue: 0,0:13:04.22,0:13:05.47,DCMain,KOSUGI,0,0,0,,!آسف
Dialogue: 0,0:13:10.10,0:13:13.67,DCMain,AYUMI,0,0,0,,سحقًا، أُلغي عرض يايبا
Dialogue: 0,0:13:13.67,0:13:17.23,DCMain,MITSUHIKO,0,0,0,,!آمل أن يُصور مشهد الغد كما خُطط له
Dialogue: 0,0:13:17.62,0:13:20.21,DCMain,GENTA,0,0,0,,ضقت ذرعًا من الانتظار، أنا جائع
Dialogue: 0,0:13:20.21,0:13:22.61,DCMain,MITSUHIKO,0,0,0,,غينتا-كن، أنت جائع دائمًا
Dialogue: 0,0:13:22.61,0:13:25.15,DCMain,AYUMI,0,0,0,,إن عرض يايبا أهم من ذلك
Dialogue: 0,0:13:25.15,0:13:27.36,DCMain,GENTA,0,0,0,,لكنهم لن يعرضوه
Dialogue: 0,0:13:34.00,0:13:35.03,DCMain,RAN,0,0,0,,آي-تشان؟
Dialogue: 0,0:13:35.79,0:13:36.75,DCMain,RAN,0,0,0,,أثمة خطب ما؟
Dialogue: 0,0:13:38.81,0:13:39.92,DCMain,HAIBARA,0,0,0,,لا شيء
Dialogue: 0,0:13:40.12,0:13:41.01,DCMain,RAN,0,0,0,,حسنًا
Dialogue: 0,0:13:41.01,0:13:44.17,DCMain,KAZUHA,0,0,0,,بئسًا، لم يرسل لي هيجي شيئًا
Dialogue: 0,0:13:44.17,0:13:45.94,DCMain,KAZUHA,0,0,0,,ماذا يجدر بنا أن نفعل، ران-تشان؟
Dialogue: 0,0:13:45.94,0:13:47.80,DCMain,RAN,0,0,0,,!لننتظر قليلًا بعد
Dialogue: 0,0:13:48.06,0:13:50.51,DCMain,RAN,0,0,0,,مهلًا، أين كونان-كن؟
Dialogue: 0,0:13:50.51,0:13:53.40,DCMain,MITSUHIKO,0,0,0,,مضت فترة لم أره فيها
Dialogue: 0,0:13:53.40,0:13:56.18,DCMain,AYUMI,0,0,0,,ربما يكون مع هيجي-أونيسان
Dialogue: 0,0:13:56.18,0:13:59.06,DCMain,GENTA,0,0,0,,هل يتسكع معه مجددًا؟
Dialogue: 0,0:14:07.26,0:14:13.58,DCMain,STAFF,0,0,0,,أجل، كان يونيكرا-سان يحدق في هاتفه مُتجهم الوجه
Dialogue: 0,0:14:13.96,0:14:16.20,DCMain,CONAN,0,0,0,,أتعلمين كم الوقت كان حينها؟
Dialogue: 0,0:14:17.36,0:14:23.26,DCMain,STAFF,0,0,0,,كان ذلك عقب اجتماع ما بعد الظهيرة مباشرةً، لذا كانت حوالي 2:20
Dialogue: 0,0:14:24.77,0:14:25.96,DCMain,OTAKI,0,0,0,,!هيي-تشان
Dialogue: 0,0:14:26.28,0:14:28.08,DCMain,OTAKI,0,0,0,,نحن مستعدون
Dialogue: 0,0:14:28.08,0:14:29.85,DCMain,HEIJI,0,0,0,,سآتي على الفور
Dialogue: 0,0:14:29.85,0:14:31.07,DCMain,HEIJI,0,0,0,,!شكرًا
Dialogue: 0,0:14:32.22,0:14:35.80,DCMain,OTAKI,0,0,0,,،من ضمن من يملكون بطاقات المستودع
Dialogue: 0,0:14:35.80,0:14:40.98,DCMain,OTAKI,0,0,0,,فقط اثنان فضلًا عن كوسوغي كانا بالخلف وقت وقوع الجريمة
Dialogue: 0,0:14:41.33,0:14:44.60,DCMain,HEIJI,0,0,0,,،هذا عظيم \N إذًا، فمن هما؟
Dialogue: 0,0:14:44.60,0:14:47.74,DCMain,OTAKI,0,0,0,,جعلتهما ينتظران في غرفة الاجتماعات
Dialogue: 0,0:14:48.62,0:14:50.96,DCMain,OTAKI,0,0,0,,!نعتذر عن جعلكما تنتظران
Dialogue: 0,0:14:50.96,0:14:53.12,DCMain,MIHARA,0,0,0,,إلى متى كنتم تنوون جعلنا ننتظر؟
Dialogue: 0,0:14:53.71,0:14:57.87,DCMain,MIHARA,0,0,0,,{\an8\be1} نحن لسنا كالشرطة، فكل ثانية من وقتنا ثمينة
Dialogue: 0,0:14:58.24,0:15:03.38,DCMain,KOUCHI,0,0,0,,{\an8\be1}نحن مشغولون كفايةً، ولم ينقصنا ما حل بيونيكرا حتى
Dialogue: 0,0:15:03.67,0:15:05.66,DCMain,HEIJI,0,0,0,,!يا لكما من عدوانيين
Dialogue: 0,0:15:05.66,0:15:09.01,DCMain,HEIJI,0,0,0,,أثمة شيء محدد تمانعان سؤالكما عنه؟
Dialogue: 0,0:15:10.28,0:15:11.38,DCMain,MIHARA,0,0,0,,من أنت؟
Dialogue: 0,0:15:12.00,0:15:13.12,DCMain,HEIJI,0,0,0,,أنا؟
Dialogue: 0,0:15:13.12,0:15:16.81,DCMain,HEIJI,0,0,0,,متحري الثانوية هاتوري هيجي
Dialogue: 0,0:15:18.05,0:15:20.69,DCMain,MIHARA,0,0,0,,سمعت عنك
Dialogue: 0,0:15:21.04,0:15:27.00,DCMain,MIHARA,0,0,0,,أنت الصعلوك الذي يدعى أنه متحري الثانوية خصم كودو شينتشي في الغرب
Dialogue: 0,0:15:28.43,0:15:33.48,DCMain,KOUCHI,0,0,0,,أمتأكد أنك لا تستغل علاقات والدك لإذاعة صيت إنجازاتك؟
Dialogue: 0,0:15:36.33,0:15:38.58,DCMain,OTAKI,0,0,0,,!!أنتما
Dialogue: 0,0:15:39.60,0:15:41.16,DCMain,HEIJI,0,0,0,,لا بأس
Dialogue: 0,0:15:41.16,0:15:45.21,DCMain,HEIJI,0,0,0,,لدي بعض الأسئلة لكما بخصوص مقتل يونيكرا-سان
Dialogue: 0,0:15:45.49,0:15:47.78,DCMain,KOUCHI,0,0,0,,ألم يمت يونيكرا-سان جراء حادث؟
Dialogue: 0,0:15:47.78,0:15:50.67,DCMain,KOUCHI,0,0,0,,لِم يوجد متحرٍ يحشر أنفه؟
Dialogue: 0,0:15:50.67,0:15:52.32,DCMain,MIHARA,0,0,0,,ماذا في الأمر؟
Dialogue: 0,0:15:52.32,0:15:54.97,DCMain,MIHARA,0,0,0,,أتقول أن ثمة من أقدم على قتله؟
Dialogue: 0,0:15:55.48,0:15:58.47,DCMain,HEIJI,0,0,0,,أنتما ضمن طاقم مساعدي يونيكرا-سان، أليس كذلك؟
Dialogue: 0,0:15:58.47,0:16:00.24,DCMain,MIHARA,0,0,0,,هذا صحيح
Dialogue: 0,0:16:00.24,0:16:03.39,DCMain,MIHARA,0,0,0,,كان يُلقبنا بفريق يونيكرا
Dialogue: 0,0:16:03.39,0:16:08.11,DCMain,KOUCHI,0,0,0,,لكنا تشاركنا غالبية خططه الأخيرة
Dialogue: 0,0:16:08.53,0:16:11.56,DCMain,KOUCHI,0,0,0,,كان ملقبًا بصانع الصيت
Dialogue: 0,0:16:11.56,0:16:14.61,DCMain,KOUCHI,0,0,0,,لكنه كان محض واجهة حسنة
Dialogue: 0,0:16:14.87,0:16:19.30,DCMain,HEIJI,0,0,0,,وبعد موت يونيكرا-سان، مُهد الطريق أمامكما ليعلو منصبكما
Dialogue: 0,0:16:19.30,0:16:21.54,DCMain,HEIJI,0,0,0,,يبدو لي هذا أفضل دافع
Dialogue: 0,0:16:21.54,0:16:23.00,DCMain,KOUCHI,0,0,0,,!لا تتحامق
Dialogue: 0,0:16:23.00,0:16:25.51,DCMain,MIHARA,0,0,0,,حسبك، ماذا عن كوسوغي؟
Dialogue: 0,0:16:25.51,0:16:27.50,DCMain,MIHARA,0,0,0,,كان جزءًا من فريق يونيكرا أيضًا
Dialogue: 0,0:16:27.72,0:16:29.81,DCMain,MIHARA,0,0,0,,لِم هو ليس هنا؟
Dialogue: 0,0:16:29.81,0:16:34.26,DCMain,HEIJI,0,0,0,,أليس من الأفضل أن تفكرا بنفسيكما أولًا؟
Dialogue: 0,0:16:34.71,0:16:38.76,DCMain,HEIJI,0,0,0,,أين وماذا كنتما تفعلان الساعة 2:30؟
Dialogue: 0,0:16:39.66,0:16:41.39,DCMain,MIHARA,0,0,0,,تبحثون في أعذار غيابنا إذًا؟
Dialogue: 0,0:16:41.94,0:16:47.86,DCMain,MIHARA,0,0,0,,في ذلك الوقت، كنت في الطابق الثالث في غرفة الاجتماعات أخطط لبعض الأمور المتعلقة بالفلم
Dialogue: 0,0:16:47.86,0:16:48.90,DCItalic,CONAN,0,0,0,,لماذا؟
Dialogue: 0,0:16:48.90,0:16:52.41,DCMain,MIHARA,0,0,0,,{\an8\be1}كنت وحيدًا طوال الوقت، لذا فلا يُعتبر عذر غياب
Dialogue: 0,0:16:49.59,0:16:52.41,DCItalic,CONAN,0,0,0,,لِم يبدوان واثقين جدًا هكذا؟
Dialogue: 0,0:16:52.92,0:16:54.40,DCMain,MIHARA,0,0,0,,لا، مهلًا
Dialogue: 0,0:16:54.40,0:16:56.61,DCMain,MIHARA,0,0,0,,،الساعة 2:30
Dialogue: 0,0:16:56.61,0:17:04.12,DCMain,MIHARA,0,0,0,,طلبت من فتاة جلب مسكنات الألم خاصتي من سيارتي في المواقف
Dialogue: 0,0:17:04.12,0:17:05.92,DCMain,HEIJI,0,0,0,,مسكنات ألم؟
Dialogue: 0,0:17:06.20,0:17:07.92,DCMain,MIHARA,0,0,0,,!انظر لهذا
Dialogue: 0,0:17:08.42,0:17:11.42,DCMain,MIHARA,0,0,0,,تعثرت قبل ثلاثة أيام، وقمت بلف قدمي
Dialogue: 0,0:17:11.81,0:17:17.30,DCMain,MIHARA,0,0,0,,..جعلتها تأتي لتأخذ مفاتيح السيارة الساعة 2:20
Dialogue: 0,0:17:17.30,0:17:21.43,DCMain,MIHARA,0,0,0,,وجلبت لي الدواء الساعة 2:30
Dialogue: 0,0:17:21.78,0:17:26.10,DCMain,CONAN,0,0,0,,استغرق الأمر وقتًا، حتى تجلب لك الدواء
Dialogue: 0,0:17:26.10,0:17:26.81,DCMain,MIHARA,0,0,0,,أجل
Dialogue: 0,0:17:27.32,0:17:32.55,DCMain,MIHARA,0,0,0,,لم يكن المصعد متاحًا اليوم؛ بسبب الحدث
Dialogue: 0,0:17:32.55,0:17:36.82,DCMain,MIHARA,0,0,0,,..ليس ذلك فحسب، فقد قالت أن الدرج من الطابق الأول إلى المواقف كان مكتظًا بالأشخاص
Dialogue: 0,0:17:36.82,0:17:39.32,DCMain,MIHARA,0,0,0,,لذا أخذت بعض الوقت
Dialogue: 0,0:17:39.57,0:17:42.10,DCItalic,CONAN,0,0,0,,ثمة فجوة 10 دقائق في عذر غيابه
Dialogue: 0,0:17:42.62,0:17:46.96,DCItalic,CONAN,0,0,0,,إن لم يكن يستيطع استخدام المصعد؛ فلا بد أنه استخدم الدرج
Dialogue: 0,0:17:47.28,0:17:49.59,DCItalic,HEIJI,0,0,0,,قدمه مصابة
Dialogue: 0,0:17:49.59,0:17:53.46,DCItalic,HEIJI,0,0,0,,..سيشق عليه المضي ذهابًا وإيابًا من الطابق الثالث للطابق السادس
Dialogue: 0,0:17:53.46,0:17:54.96,DCItalic,HEIJI,0,0,0,,ويقتل في ظرف 10 دقائق فقط
Dialogue: 0,0:17:55.73,0:17:57.97,DCMain,OTAKI,0,0,0,,إذًا، ماذا عنك يا كوتشي-سان؟
Dialogue: 0,0:17:58.27,0:18:03.97,DCMain,KOUCHI,0,0,0,,كنت أتفقد دورات المياه وبعض الأماكن المهجورة بحثًا عن أي أغراض مشبوهة وحدي
Dialogue: 0,0:18:04.65,0:18:07.98,DCMain,KOUCHI,0,0,0,,..لم أقابل أحدًا، لذا فما من عذر غياب لدي
Dialogue: 0,0:18:08.98,0:18:11.86,DCMain,KOUCHI,0,0,0,,لكني لم أقتل يونيكرا
Dialogue: 0,0:18:12.78,0:18:13.73,DCMain,HEIJI,0,0,0,,لِم لا؟
Dialogue: 0,0:18:14.42,0:18:16.74,DCMain,KOUCHI,0,0,0,,إني أخشى المرتفعات
Dialogue: 0,0:18:16.74,0:18:17.84,DCMain,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,0:18:17.84,0:18:20.30,DCMain,KOUCHI,0,0,0,,لدي حالة هلع شديدة من المرتفعات
Dialogue: 0,0:18:20.30,0:18:24.85,DCMain,KOUCHI,0,0,0,,الأماكن المرتفعة لا تمت للسؤال بصلة، لكني أخاف صعود الدرج
Dialogue: 0,0:18:24.85,0:18:29.75,DCMain,KOUCHI,0,0,0,,..سمعت أن كايجو وقع على يونيكرا
Dialogue: 0,0:18:30.29,0:18:36.26,DCMain,KOUCHI,0,0,0,,مما يعني أن الجاني تسلق الخزانة \N وقطع الحبل الذي كان يمسك كايجو، صحيح؟
Dialogue: 0,0:18:36.59,0:18:39.51,DCMain,KOUCHI,0,0,0,,وأنا لا يمكنني تسلقها
Dialogue: 0,0:18:39.82,0:18:41.18,DCMain,MIHARA,0,0,0,,أأنت واثق؟
Dialogue: 0,0:18:41.18,0:18:43.26,DCMain,MIHARA,0,0,0,,إذا تعلق الأمر بالحديث، فكل شيء سهل
Dialogue: 0,0:18:43.46,0:18:45.43,DCMain,KOUCHI,0,0,0,,أأنت أحمق؟ إنك تعلم أن هذا حقيقي
Dialogue: 0,0:18:45.43,0:18:46.79,DCMain,MIHARA,0,0,0,,حقًا؟
Dialogue: 0,0:18:57.74,0:19:00.78,DCMain,HEIJI,0,0,0,,يجدر بنا استعمال شيء، لنجعل الباب يبقى مفتوحًا
Dialogue: 0,0:19:00.78,0:19:01.74,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:19:01.74,0:19:04.82,DCMain,CONAN,0,0,0,,قد يأتي المفتش أوتاكي لينادينا
Dialogue: 0,0:19:07.05,0:19:09.84,DCMain,CONAN,0,0,0,,أولئك الاثنان يبدوان مريبين
Dialogue: 0,0:19:09.84,0:19:14.57,DCMain,HEIJI,0,0,0,,أجل، لكن كوسوغي فقط من يملك الدافع والوقت لفعلها
Dialogue: 0,0:19:16.59,0:19:18.63,DCMain,OTAKI,0,0,0,,هيي-تشان، أين أنت؟
Dialogue: 0,0:19:18.63,0:19:20.80,DCMain,HEIJI,0,0,0,,أوتاكي-هان، نحن هنا
Dialogue: 0,0:19:21.27,0:19:24.16,DCMain,OTAKI,0,0,0,,انتهينا من فحص هاتف يونيكرا-سان
Dialogue: 0,0:19:24.16,0:19:25.31,DCMain,HEIJI,0,0,0,,حقًا؟
Dialogue: 0,0:19:25.31,0:19:29.90,DCMain,OTAKI,0,0,0,,أجل، يبدو أن يونيكرا-سان التقط صورة للجاني
Dialogue: 0,0:19:29.90,0:19:33.31,DCMain,HEIJI,0,0,0,,هذا مدهش؛ هكذا ستُحل القضية
Dialogue: 0,0:19:33.51,0:19:37.82,DCMain,OTAKI,0,0,0,,!في الحقيقة، حسنًا.. سترى بنفسك
Dialogue: 0,0:19:39.40,0:19:43.86,DCMain,OTAKI,0,0,0,,يستحيل تحديد هويته من خلال صورة ضبابية
Dialogue: 0,0:19:43.86,0:19:46.61,DCMain,HEIJI,0,0,0,,أوتاكي-هان، أين ميهارا وكوتشي؟
Dialogue: 0,0:19:46.61,0:19:49.08,DCMain,OTAKI,0,0,0,,ماذا؟ توجها إلى الطابق الأول
Dialogue: 0,0:19:49.27,0:19:50.87,DCMain,CONAN,0,0,0,,!لا تدعهما يخرجان من المبنى
Dialogue: 0,0:19:51.13,0:19:52.06,DCMain,OTAKI,0,0,0,,ماذا؟
Dialogue: 0,0:19:55.56,0:19:57.92,DCMain,OTAKI,0,0,0,,ماذا تقصدان بعدم سماحنا لهما بالخروج؟
Dialogue: 0,0:19:57.92,0:19:59.86,DCMain,CONAN,0,0,0,,!أمعن النظر في الصورة
Dialogue: 0,0:20:00.85,0:20:05.98,DCMain,CONAN,0,0,0,,المستودع كان مظلمًا بسبب مشكلة كهربائية، لكن هنا ثمة شعاع ضوء
Dialogue: 0,0:20:05.98,0:20:07.39,DCMain,OTAKI,0,0,0,,أجل
Dialogue: 0,0:20:07.61,0:20:10.24,DCMain,HEIJI,0,0,0,,من أين تظن أنه آتٍ؟
Dialogue: 0,0:20:10.24,0:20:11.39,DCMain,OTAKI,0,0,0,,من أين؟
Dialogue: 0,0:20:11.69,0:20:15.77,DCMain,CONAN,0,0,0,,الباب، لقد كان مفتوحًا، حيث سمح للضوء أن يدخل
Dialogue: 0,0:20:15.77,0:20:18.73,DCMain,OTAKI,0,0,0,,!لكن الباب يُغلق تلقائيًا
Dialogue: 0,0:20:19.43,0:20:23.74,DCMain,HEIJI,0,0,0,,صحيح، أحدهم كان يمسك بالباب ليبقيه مفتوحًا
Dialogue: 0,0:20:24.11,0:20:26.52,DCMain,CONAN,0,0,0,,أي أن هناك مجرمان
Dialogue: 0,0:20:26.52,0:20:29.37,DCMain,CONAN,0,0,0,,كوتشي-سان وميهارا-سان كانا يعملان معًا
Dialogue: 0,0:20:29.70,0:20:33.87,DCMain,CONAN,0,0,0,,اتكأ ميهارا-سان على كوتشي-سان، وصعدا السلم، ليتخطيا الإصابة
Dialogue: 0,0:20:34.08,0:20:39.36,DCMain,CONAN,0,0,0,,وساعد كوتشي-سان ميهارا-سان في صعود الخزانة
Dialogue: 0,0:20:42.17,0:20:43.72,DCItalic,OTAKI,0,0,0,,!أوتاكي يتحدث
Dialogue: 0,0:20:43.72,0:20:47.60,DCItalic,OTAKI,0,0,0,,!إن رأيتم كوتشي أو ميهارا؛ فاقبضوا عليهما على وجه السرعة
Dialogue: 0,0:20:51.96,0:20:53.23,DCMain,GUARD,0,0,0,,!أنتما الاثنان
Dialogue: 0,0:20:55.10,0:20:56.60,DCMain,GUARD,0,0,0,,!لا تتحركا
Dialogue: 0,0:20:55.34,0:20:57.80,DCMain,GUARD,0,0,0,,{\an8\be1}!كوتشي وميهارا في المواقف
Dialogue: 0,0:20:56.80,0:20:57.44,DCMain,MIHARA,0,0,0,,!أسرع
Dialogue: 0,0:20:57.44,0:20:59.24,DCMain,KOUCHI,0,0,0,,يجب أن يكون المفتاح الاحتياطي هنا
Dialogue: 0,0:20:59.24,0:20:59.94,DCMain,KOUCHI,0,0,0,,!عثرتُ عليه
Dialogue: 0,0:21:00.18,0:21:02.00,DCMain,MIHARA,0,0,0,,!قُد السيارة
Dialogue: 0,0:21:02.00,0:21:02.65,DCMain,KOUCHI,0,0,0,,حسنًا
Dialogue: 0,0:21:02.94,0:21:03.95,DCMain,GUARD,0,0,0,,!توقفا
Dialogue: 0,0:21:04.15,0:21:04.86,DCMain,MIHARA,0,0,0,,!هيا بنا
Dialogue: 0,0:21:06.94,0:21:08.03,DCMain,GUARD,0,0,0,,!افتح الباب
Dialogue: 0,0:21:11.26,0:21:12.46,DCMain,GUARD,0,0,0,,!أُلقي القبض على ميهارا
Dialogue: 0,0:21:12.46,0:21:14.37,DCMain,GUARD,0,0,0,,!يفرّ كوتشي بسيارة يونكيرا
Dialogue: 0,0:21:14.37,0:21:16.21,DCMain,GUARD,0,0,0,,!إنها سيارة دفع رباعي سوداء كبيرة
Dialogue: 0,0:21:20.63,0:21:21.39,DCMain,HEIJI,0,0,0,,!سحقًا
Dialogue: 0,0:21:25.30,0:21:26.43,DCMain,CONAN,0,0,0,,!ران
Dialogue: 0,0:21:25.30,0:21:26.43,DCMain,HEIJI,0,0,0,,!كازوها
Dialogue: 0,0:21:29.68,0:21:30.72,DCMain,RAN,0,0,0,,!كازوها-تشان
Dialogue: 0,0:22:59.77,0:23:00.81,DCMain,RAN,0,0,0,,!كازوها-تشان
Dialogue: 0,0:23:08.51,0:23:09.40,DCMain,KAZUHA,0,0,0,,!ران-تشان
Dialogue: 0,0:23:09.40,0:23:10.78,DCMain,CONAN,0,0,0,,!ران-نيتشان
Dialogue: 0,0:23:09.72,0:23:11.12,DCMain,HEIJI,0,0,0,,{\an8\be1}أأنت بخير يا كازوها؟
Dialogue: 0,0:23:12.21,0:23:13.99,DCMain,RAN,0,0,0,,!شكرًا لك
Dialogue: 0,0:23:17.12,0:23:18.59,DCMain,CONAN,0,0,0,,{\be1\an8}!المفتش أيانوكوجي
Dialogue: 0,0:23:20.14,0:23:22.92,DCMain,AYANOKOJI,0,0,0,,{\an8\be1}!ها قد تقابلنا مجددًا يا كونان-كن
Dialogue: 0,0:23:25.69,0:23:27.58,DCMain,KOUCHI,0,0,0,,لن يُقبض علي
Dialogue: 0,0:23:45.36,0:23:51.45,DCMain,HIRAKURA,0,0,0,,ألم يحن الوقت لتوضح لنا ماذا كنت تفعل في مسرح وقوع الجريمة؟
Dialogue: 0,0:23:52.11,0:23:57.24,DCMain,OTAKI,0,0,0,,سيكون على شرطة أوساكا وكيوتو أن يُشكلا مقر تحقيق مشترك
Dialogue: 0,0:23:59.49,0:24:00.71,DCMain,GENTA,0,0,0,,!إنه كايجو
Dialogue: 0,0:24:00.93,0:24:02.46,DCMain,AYUMI,0,0,0,,!النجدة
Dialogue: 0,0:24:02.46,0:24:04.33,DCMain,MITSUHIKO,0,0,0,,!آيومي-تشان! من هذا الطريق
Dialogue: 0,0:24:05.25,0:24:09.09,DCMain,KAZUHA,0,0,0,,!بالطبع، هذا كامين يايبا
Dialogue: 0,0:24:09.64,0:24:14.79,DCMain,CONAN,0,0,0,,الحلقة القادمة من كونان\N "كايجو غوميرا ضد كامين يايبا، الفاصل"
Dialogue: 0,0:24:30.50,0:24:33.27,DCMain,ALL,0,0,0,,!تلميح كونان التالي
Dialogue: 0,0:24:35.03,0:24:36.93,DCMain,HAIBARA,0,0,0,,{\fad(300,300)\fnAsmaa Font\an7\bord5\blur10\shad0\c&HFFFFFF&\3c&H2AC82F&}!أول غرض قضية في السنة الجديدة
Dialogue: 0,0:24:36.93,0:24:39.75,DCMain,ALL,0,0,0,,{\fad(300,300)\fnAsmaa Font\an7\bord5\blur10\shad0\c&HFFFFFF&\3c&HC86F2A&}!شكرًا لكم على متابعتنا لسنة أخرى
