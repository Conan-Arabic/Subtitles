Dialogue: 0,0:00:50.02,0:00:55.41,Title,SIGN,0,0,0,,{\fad(920,1)\fscx135\fscy147\c&HE5F483&\3c&H543DA3&\3a&HFF&\pos(582,30)}الساعات
Dialogue: 0,0:00:50.02,0:00:55.41,Title,SIGN,0,0,0,,{\fad(920,1)\fscx135\fscy147\c&HCEA746&\3c&H543DA3&\3a&HFF&\pos(462,28)}الثلاث
Dialogue: 0,0:00:51.10,0:00:53.81,DCMain,CONAN,0,0,0,,"الجد تيك تاك يعمل صانعًا للساعات"
Dialogue: 0,0:00:53.40,0:00:55.32,Author,SIGN,0,0,0,,{\pos(1159,671)}تأليف إيماي كينيتشي
Dialogue: 0,0:00:54.45,0:00:56.71,DCMain,CONAN,0,0,0,,"تيك تاك، تيك تاك"
Dialogue: 0,0:00:57.28,0:01:01.90,DCMain,CONAN,0,0,0,,"أوصل الساعة الأخيرة إلى منتصف سبعة"
Dialogue: 0,0:01:03.83,0:01:05.84,Otanoshimi,CONAN,0,0,0,,!يرتفع الستار عند ظهور بطل المسرح
Dialogue: 0,0:01:05.84,0:01:08.31,Otanoshimi,CONAN,0,0,0,,ليرقص بخطوات جميلة تكشف غموض الألغاز
Dialogue: 0,0:01:08.31,0:01:10.42,Otanoshimi,CONAN,0,0,0,,كتاب صور بارزة والقنبلة الأخيرة
Dialogue: 0,0:01:10.42,0:01:12.46,Otanoshimi,CONAN,0,0,0,,لغز "سبعة" يأخذنا إلى اتجاه غير متوقع
Dialogue: 0,0:01:12.84,0:01:14.59,Otanoshimi,CONAN,0,0,0,,...يكشف دائمًا الحقيقة الواحدة
Dialogue: 0,0:01:14.59,0:01:16.47,Otanoshimi,CONAN,0,0,0,,مظهره كطفل صغير وعقله كشخص بالغ
Dialogue: 0,0:01:16.47,0:01:19.01,Otanoshimi,CONAN,0,0,0,,!اسمه، المتحري كونان
Dialogue: 0,0:02:58.99,0:03:04.95,DCEpTitle,EPTITLE,0,0,0,,{\fad(396,1)\pos(642.038,132.089)\fscx112\fscy112}المفجر البارز من الكتاب
Dialogue: 0,0:02:58.99,0:03:04.99,DCEpTitle,EPTITLE,0,0,0,,{\fad(396,1)\pos(636,486)\fscx60\fscy90}(الجزء الثاني)
Dialogue: 0,0:02:59.82,0:03:03.42,DCMain,CONAN,0,0,0,,المفجر البارز من الكتاب - الجزء الثاني
Dialogue: 0,0:03:04.99,0:03:08.16,Text,TEXT,0,0,0,,{\fscx121\fscy123\pos(561,13)}"أوصل الساعة الأخيرة إلى منتصف سبعة"
Dialogue: 0,0:03:08.74,0:03:09.95,DCMain,KOGORO,0,0,0,,!سحقًا
Dialogue: 0,0:03:09.95,0:03:12.50,DCMain,KOGORO,0,0,0,,ما المقصود بمنتصف سبعة؟
Dialogue: 0,0:03:12.91,0:03:16.00,DCMain,KOGORO,0,0,0,,تقسيم سبعة على اثنين، الناتج 3.5
Dialogue: 0,0:03:16.00,0:03:17.18,DCMain,KOGORO,0,0,0,,..."نانا"
Dialogue: 0,0:03:16.42,0:03:19.63,Nana,TEXT,0,0,0,,{\blur30\fscx157\fscy162\pos(325,42)}نانا
Dialogue: 0,0:03:17.18,0:03:19.39,DCMain,KOGORO,0,0,0,,ماذا يوجد بين "نا" و "نا"؟
Dialogue: 0,0:03:17.17,0:03:19.63,Na1,TEXT,0,0,0,,{\blur20\fscx159\fscy157\pos(107,274)}نا
Dialogue: 0,0:03:17.71,0:03:19.63,Na2,TEXT,0,0,0,,{\blur20\fscx159\fscy157\pos(398,278)}نا
Dialogue: 0,0:03:21.00,0:03:22.06,DCMain,KOGORO,0,0,0,,!"سيفين"
Dialogue: 0,0:03:22.06,0:03:22.68,DCMain,KOGORO,0,0,0,,ڤي"؟"
Dialogue: 0,0:03:22.10,0:03:23.26,V,TEXT,0,0,0,,{\blur20\fad(1,375)\pos(316,170)}ڤي
Dialogue: 0,0:03:24.39,0:03:27.16,DCMain,KOGORO,0,0,0,,لا يبدو أيًا منها منطقيًا
Dialogue: 0,0:03:27.89,0:03:30.05,DCMain,KOGORO,0,0,0,,!لا أفهم
Dialogue: 0,0:03:33.46,0:03:34.66,DCMain,KOGORO,0,0,0,,!يا رجل
Dialogue: 0,0:03:34.66,0:03:37.73,DCMain,KOGORO,0,0,0,,أحقًا لا تتذكر جواب اللغز؟
Dialogue: 0,0:03:37.73,0:03:38.82,DCMain,TOMONAGA,0,0,0,,آسف
Dialogue: 0,0:03:39.03,0:03:45.41,Hiroyuki,,0,0,0,,{\p1\c&H731B1F&\3c&HCC8A92&\3a&HFF&\4c&H000000&\4a&HFF&\fscx1569\fscy1248\pos(555.867,706.467)\clip(m 514 581 l 769 583 766 694 514 694)}m 0 0 l 27 0 l 27 13 l 0 13 l 0 0
Dialogue: 0,0:03:39.03,0:03:45.41,Hiroyuki,TEXT,0,0,0,,{\fad(250,250)\fscx91\fscy100\pos(638,671)}(توموناغا هيرويوكي (45\Nرئيس تحرير
Dialogue: 0,0:03:39.20,0:03:42.73,DCMain,TOMONAGA,0,0,0,,{\an8}كما قلتُ لكم، تأجّل النشر
Dialogue: 0,0:03:42.73,0:03:46.48,DCMain,TOMONAGA,0,0,0,,{\an8}وكنتُ مشغولًا بموضوع الرائج ولم أقرأ الكتاب بالتفصيل
Dialogue: 0,0:03:47.58,0:03:49.33,DCMain,TOMONAGA,0,0,0,,ولكنني أتذكر النهاية
Dialogue: 0,0:03:49.57,0:03:50.88,DCMain,KOGORO,0,0,0,,النهاية؟
Dialogue: 0,0:03:50.88,0:03:53.59,DCMain,TOMONAGA,0,0,0,,لم تكن نهاية سعيدة مئة بالمئة
Dialogue: 0,0:03:53.59,0:03:58.42,DCMain,TOMONAGA,0,0,0,,وكانت شركتنا مترددة بخصوص ما إذا كان كتابًا مناسبًا للأطفال
Dialogue: 0,0:03:59.28,0:04:02.48,DCMain,RAN,0,0,0,,وهذا ما ظننته كذلك حين قرأتُ النهاية
Dialogue: 0,0:04:02.48,0:04:05.30,DCMain,RAN,0,0,0,,على الرغم من أن الرسومات والصور ظريفة جدًا
Dialogue: 0,0:04:05.57,0:04:06.98,DCMain,KOGORO,0,0,0,,ما معنى ذلك؟
Dialogue: 0,0:04:06.98,0:04:10.24,DCMain,RAN,0,0,0,,لأن الجد تيك تاك يموت
Dialogue: 0,0:04:10.24,0:04:14.21,DCMain,RAN,0,0,0,,في الحقيقة، نعرف في النهاية أنه مريض جدًا
Dialogue: 0,0:04:14.99,0:04:16.63,DCMain,RAN,0,0,0,,،ولكن بعد عشر سنوات
Dialogue: 0,0:04:16.63,0:04:22.67,DCMain,RAN,0,0,0,,يتولى حفيده إدارة العمل في خاتمة القصة
Dialogue: 0,0:04:22.67,0:04:24.57,DCMain,RAN,0,0,0,,ولهذا كان ذلك مطمئنًا نوعًا ما
Dialogue: 0,0:04:24.92,0:04:26.27,DCMain,TOMONAGA,0,0,0,,معك حق
Dialogue: 0,0:04:26.27,0:04:30.31,DCMain,KOGORO,0,0,0,,ما هذا؟ ليس تلميحًا على مكان القنبلة
Dialogue: 0,0:04:30.31,0:04:33.88,DCMain,KOGORO,0,0,0,,الأهم من ذلك، ما جواب اللغز؟ ما الجواب؟
Dialogue: 0,0:04:33.88,0:04:35.74,DCMain,RAN,0,0,0,,لا أعرف حتى إن أصررتَ بالسؤال
Dialogue: 0,0:04:35.74,0:04:37.08,DCMain,TOMONAGA,0,0,0,,آسف
Dialogue: 0,0:04:37.83,0:04:40.55,DCMain,CONAN,0,0,0,,عذرًا... بمَ يذكركم الرقم سبعة؟
Dialogue: 0,0:04:41.46,0:04:43.82,DCMain,CONAN,0,0,0,,كما قلت، ما الذي يعبر عنه الرقم سبعة؟
Dialogue: 0,0:04:43.82,0:04:45.54,DCMain,KOGORO,0,0,0,,يعبر عنه؟
Dialogue: 0,0:04:46.36,0:04:49.73,DCMain,KOGORO,0,0,0,,عرفت. مثلًا، أيام الأسبوع سبعة
Dialogue: 0,0:04:49.73,0:04:50.35,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:04:50.88,0:04:53.77,DCMain,RAN,0,0,0,,إن كان كذلك، ربما هي ألوان الطيف السبعة
Dialogue: 0,0:04:55.78,0:04:57.52,DCMain,TAKAGI,0,0,0,,مفاتيح السلم الموسيقي سبعة، صحيح؟
Dialogue: 0,0:04:57.68,0:04:59.77,DCMain,CONAN,0,0,0,,وما الذي في منتصفها؟
Dialogue: 0,0:05:00.16,0:05:02.18,DCMain,CHIBA,0,0,0,,بالنسبة للأسبوع، سيكون الثلاثاء
Dialogue: 0,0:05:02.18,0:05:03.35,DCMain,CHIBA,0,0,0,,...وألوان الطيف
Dialogue: 0,0:05:04.61,0:05:06.73,DCMain,RAN,0,0,0,,سيكون اللون الأخضر
Dialogue: 0,0:05:07.26,0:05:09.78,DCMain,KOGORO,0,0,0,,"وفي السلم الموسيقي، سيكون "فا
Dialogue: 0,0:05:09.78,0:05:12.66,DCMain,KOGORO,0,0,0,,ولكن مع ذلك فالاحتمالات كثيرة جدًا
Dialogue: 0,0:05:12.88,0:05:18.20,DCMain,CONAN,0,0,0,,صحيح. ولكن ماذا لو أن القنبلة ستنفجر في مكان متعلق بهذه الأشياء؟
Dialogue: 0,0:05:18.20,0:05:19.90,DCMain,KOGORO,0,0,0,,!حضرة المفتش
Dialogue: 0,0:05:20.92,0:05:22.67,DCMain,MEGURE,0,0,0,,بالطبع، لا يجب أن نتجاهلها
Dialogue: 0,0:05:22.84,0:05:27.05,DCMain,MEGURE,0,0,0,,!أبلغا قسم الشرطة بأكمله بالتحرك للبحث عن القنبلة حالًا
Dialogue: 0,0:05:27.05,0:05:27.95,DCMain,BOTH,0,0,0,,حاضر
Dialogue: 0,0:05:29.84,0:05:36.14,DCMain,TOMONAGA,0,0,0,,عذرًا يا حضرة المفتش، إذا بقيتُ هنا مدة أطول فلن أكون سوى عائقًا لكم
Dialogue: 0,0:05:36.31,0:05:37.72,DCMain,MEGURE,0,0,0,,هذا صحيح
Dialogue: 0,0:05:37.72,0:05:42.44,DCMain,MEGURE,0,0,0,,بما أن التحقيق اتخذ مجرًى محددًا، فأنت حر في الذهاب
Dialogue: 0,0:05:42.89,0:05:44.45,DCMain,TOMONAGA,0,0,0,,شكرًا جزيلًا
Dialogue: 0,0:05:45.68,0:05:49.18,DCMain,TOMONAGA,0,0,0,,اعذرني. والآن، أستأذنكم
Dialogue: 0,0:05:51.20,0:05:53.07,DCMain,RAN,0,0,0,,لحظة، الكتاب
Dialogue: 0,0:05:54.23,0:05:55.36,DCMain,RAN,0,0,0,,أعطنيه يا كونان-كن
Dialogue: 0,0:05:55.36,0:05:56.58,DCMain,RAN,0,0,0,,لو سمحت... هذا لك
Dialogue: 0,0:05:56.99,0:05:58.88,DCMain,RAN,0,0,0,,ألا تريده؟
Dialogue: 0,0:06:01.66,0:06:04.17,DCItalic,CONAN,0,0,0,,ولكن، هذا غريب
Dialogue: 0,0:06:04.77,0:06:05.87,DCItalic,CONAN,0,0,0,,...حتى الآن
Dialogue: 0,0:06:05.87,0:06:10.96,DCItalic,CONAN,0,0,0,,كان لكل لغز إجابة واحدة محددة وواضحة
Dialogue: 0,0:06:11.22,0:06:15.97,Green,TEXT,0,0,0,,{\fad(210,875)}"كلمات تبدأ بـ "أخضر/ميدوري/غرين
Dialogue: 0,0:06:11.65,0:06:15.54,DCItalic,CONAN,0,0,0,,ولكن اللغز هذه المرة واسع الاحتمالات
Dialogue: 0,0:06:11.97,0:06:15.97,Tree,TEXT,0,0,0,,{\fad(460,875)}"كلمات من خمسة حروف تشمل "شجرة
Dialogue: 0,0:06:13.47,0:06:15.97,Fa,TEXT,0,0,0,,{\fad(460,875)}"كلمات تبدأ بـ "فا
Dialogue: 0,0:06:15.11,0:06:18.60,Tree,SIGN,0,0,0,,{\fad(960,1)\frz348.6\pos(186,72)}حديقة كينوميري
Dialogue: 0,0:06:16.23,0:06:18.60,Office,TEXT,0,0,0,,{\blur5\fad(210,1)}مكتب ميدوري للمحاماة
Dialogue: 0,0:06:16.48,0:06:18.60,School,TEXT,0,0,0,,{\blur5\fad(210,1)\pos(501,571)}مدرسة ميدوري الابتدائية
Dialogue: 0,0:06:16.73,0:06:18.60,Restaurant,TEXT,0,0,0,,{\blur5\fad(210,1)\frz5.217\pos(177,240)}مطعم غرين غرين
Dialogue: 0,0:06:16.98,0:06:18.60,Center,TEXT,0,0,0,,{\blur5\fad(210,1)\frz353.7\pos(666,481)}مركز كوكب المشتري للبحوث والرصد
Dialogue: 0,0:06:17.06,0:06:18.34,DCItalic,CONAN,0,0,0,,لماذا؟
Dialogue: 0,0:06:19.10,0:06:20.69,DCItalic,CONAN,0,0,0,,وثمة شيءٌ آخر
Dialogue: 0,0:06:21.15,0:06:24.57,DCItalic,CONAN,0,0,0,,تثير اهتمامي تلك القنبلة التي رماها العم كوغورو في فتحة الصرف الصحي
Dialogue: 0,0:06:26.16,0:06:30.87,DCItalic,CONAN,0,0,0,,وهكذا، تم استنفار جميع محققي الشرطة
Dialogue: 0,0:06:31.30,0:06:35.35,DCItalic,CONAN,0,0,0,,والعمل جارٍ الآن من أجل العثور على القنبلة غير المنفجرة
Dialogue: 0,0:06:36.23,0:06:38.36,DCItalic,CONAN,0,0,0,,ماذا؟ هل من المحتمل؟
Dialogue: 0,0:06:38.83,0:06:39.89,DCMain,MEGURE,0,0,0,,هذا جيد
Dialogue: 0,0:06:39.89,0:06:41.28,DCMain,MEGURE,0,0,0,,استمروا
Dialogue: 0,0:06:39.89,0:06:41.28,DCMain,CONAN,0,0,0,,{\an8}عذرًا، أيها المفتش ميغوري
Dialogue: 0,0:06:41.28,0:06:43.84,DCMain,MEGURE,0,0,0,,نعم؟ ما الأمر يا كونان-كن؟
Dialogue: 0,0:06:44.15,0:06:49.09,DCMain,CONAN,0,0,0,,المفجر المدعو هيروكاوا، ما الذي فعله تحديدًا؟
Dialogue: 0,0:06:49.33,0:06:51.12,DCMain,MEGURE,0,0,0,,ما الذي تقصده؟
Dialogue: 0,0:06:51.12,0:06:53.52,DCMain,MEGURE,0,0,0,,قام بالتفجير، بالطبع
Dialogue: 0,0:06:53.52,0:06:58.31,DCMain,MEGURE,0,0,0,,كان يصنع المتفجرات، ويفجر بها الخزائن المالية المصرفية
Dialogue: 0,0:06:58.31,0:07:03.23,DCMain,MEGURE,0,0,0,,وكذلك مركبات نقل الأموال وسرق مبالغَ كبيرة
Dialogue: 0,0:07:04.48,0:07:06.63,DCMain,MEGURE,0,0,0,,ماذا في ذلك؟
Dialogue: 0,0:07:06.63,0:07:08.66,DCMain,CONAN,0,0,0,,لا شيء
Dialogue: 0,0:07:09.45,0:07:16.24,DCItalic,CONAN,0,0,0,,غير صحيح. لا شيء من ذلك يشبه هذه \Nالجريمة التي يبدو أن الدافع فيها شعور بالحقد
Dialogue: 0,0:07:31.22,0:07:33.72,Megrez,TEXT,0,0,0,,{\fscx125\fscy125\pos(636,132)}ميغريز الأمنية
Dialogue: 0,0:07:37.88,0:07:39.77,DCMain,SECURITY B,0,0,0,,هل حدث شيء يا تُرى؟
Dialogue: 0,0:07:39.77,0:07:41.06,DCMain,SECURITY A,0,0,0,,لا أعلم
Dialogue: 0,0:07:43.78,0:07:46.19,DCMain,MEGURE,0,0,0,,!ماذا؟ وجدتم القنبلة؟
Dialogue: 0,0:07:47.32,0:07:51.52,DCMain,MEGURE,0,0,0,,نقطة تجميع النفايات في مبنى الخميس رقم 3 في حي توريا؟
Dialogue: 0,0:07:51.94,0:07:53.57,DCMain,TAKAGI,0,0,0,,ونحن وجدنا واحدة أيضًا
Dialogue: 0,0:07:53.49,0:07:56.99,Garden,SIGN,0,0,0,,{\fscx160\fscy167}الحديقة الخضراء
Dialogue: 0,0:07:54.08,0:07:56.01,DCMain,TAKAGI,0,0,0,,في بستان فواكه في حي كينباشي
Dialogue: 0,0:07:56.55,0:07:59.33,DCMain,TAKAGI,0,0,0,,موجودة في سلة المهملات في مكتب الإدارة
Dialogue: 0,0:07:59.41,0:08:04.75,Alloy,SIGN,0,0,0,,{\fad(340,1)\fscx187\fscy172\pos(630,23)}"ورشة "ف.ا
Dialogue: 0,0:07:59.68,0:08:02.91,DCMain,CHIBA,0,0,0,,ونحن وجدنا واحدة في ورشة ف.أ في حي دايتوما
Dialogue: 0,0:08:02.91,0:08:06.96,DCMain,CHIBA,0,0,0,,"إنه مصنع محلي للطلاء الذهبي معروف باسم "ورشة فا
Dialogue: 0,0:08:07.34,0:08:10.48,DCMain,CHIBA,0,0,0,,ومثل السابقة، وجدناها في سلة مهملات
Dialogue: 0,0:08:11.41,0:08:13.76,DCMain,MEGURE,0,0,0,,ثلاث قنابل في آنٍ واحد؟
Dialogue: 0,0:08:18.68,0:08:20.33,DCMain,SECURITY A,0,0,0,,هل حدث شيء؟
Dialogue: 0,0:08:20.33,0:08:24.35,DCMain,HIRUKAWA,0,0,0,,أرجو المعذرة. تم العثور على قنبلة بعد هذه النقطة
Dialogue: 0,0:08:24.35,0:08:26.77,DCMain,SECURITY A,0,0,0,,ماذا؟ قنبلة؟
Dialogue: 0,0:08:26.98,0:08:29.90,DCMain,KOGORO,0,0,0,,!وجدنا القنابل! الثلاثة كلها
Dialogue: 0,0:08:30.34,0:08:32.11,DCMain,KOGORO,0,0,0,,أخبرنا طريقة تعطيلها
Dialogue: 0,0:08:32.40,0:08:34.22,DCMain,KOGORO,0,0,0,,أنت! أجبني
Dialogue: 0,0:08:35.11,0:08:36.37,DCMain,KOGORO,0,0,0,,!أقول لك أجبني
Dialogue: 0,0:08:45.12,0:08:48.54,Wow,SIGN,0,0,0,,{\fad(1295,1)\pos(20,28)}بووم! هل تفاجأتم؟
Dialogue: 0,0:08:50.56,0:08:54.24,DCMain,MEGURE,0,0,0,,ماذا؟ القنابل الثلاث كلها مزيفة؟
Dialogue: 0,0:08:54.83,0:08:56.89,DCMain,RAN,0,0,0,,ما معنى ذلك؟
Dialogue: 0,0:08:59.91,0:09:00.94,DCMain,KOGORO,0,0,0,,تبًا
Dialogue: 0,0:09:00.94,0:09:03.58,DCMain,KOGORO,0,0,0,,ما الذي يحاول هيروكاوا فعله؟
Dialogue: 0,0:09:03.58,0:09:04.78,DCMain,CONAN,0,0,0,,إنها خدعة
Dialogue: 0,0:09:05.80,0:09:10.35,DCMain,CONAN,0,0,0,,مثلما كانت الألغاز السابقة، القنابل المزيفة الثلاث كانت خادعة
Dialogue: 0,0:09:10.35,0:09:12.28,DCMain,CONAN,0,0,0,,بينما الحقيقية في مكانٍ آخر
Dialogue: 0,0:09:12.53,0:09:13.78,DCMain,KOGORO,0,0,0,,!ماذا؟
Dialogue: 0,0:09:14.96,0:09:17.78,DCMain,HIRUKAWA,0,0,0,,حسنٌ، حسنٌ
Dialogue: 0,0:09:17.78,0:09:21.54,DCMain,HIRUKAWA,0,0,0,,استمر، استمر، استمر
Dialogue: 0,0:09:22.05,0:09:27.04,DCMain,HIRUKAWA,0,0,0,,استمر، استمر، استمر
Dialogue: 0,0:09:27.52,0:09:29.69,DCMain,HIRUKAWA,0,0,0,,استمر، استمر
Dialogue: 0,0:09:33.53,0:09:34.92,DCMain,SECURITY A,0,0,0,,هل من خطب؟
Dialogue: 0,0:09:35.38,0:09:37.54,DCMain,SECURITY A,0,0,0,,مهلًا! أيها الشرطي؟
Dialogue: 0,0:09:39.93,0:09:41.52,DCMain,SECURITY A,0,0,0,,هل من خطب؟
Dialogue: 0,0:09:58.95,0:10:01.95,Megrez,SIGN,0,0,0,,{\fscx128\fscy133\pos(640,156)}ميغريز الأمنية
Dialogue: 0,0:09:59.62,0:10:01.70,DCMain,CONAN,0,0,0,,ميغريز الأمنية
Dialogue: 0,0:10:03.66,0:10:05.85,DCMain,RAN,0,0,0,,هل من خطب يا كونان-كن؟
Dialogue: 0,0:10:05.85,0:10:10.59,DCMain,CONAN,0,0,0,,كلمة "ميغريز" في اسم شركة ميغريز الأمنية يشير إلى هذه النجمة
Dialogue: 0,0:10:11.75,0:10:13.00,DCMain,RAN,0,0,0,,...أليست هذه
Dialogue: 0,0:10:14.20,0:10:16.51,DCMain,RAN,0,0,0,,مجموعة "أوغومازا" النجمية؟
Dialogue: 0,0:10:17.52,0:10:18.88,DCMain,RAN,0,0,0,,الدب الأكبر؟
Dialogue: 0,0:10:19.12,0:10:20.08,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:10:20.08,0:10:25.27,DCMain,CONAN,0,0,0,,"النجوم السبع المكونة لذيل "أوغومازا" تسمى "الدب الأكبر
Dialogue: 0,0:10:25.33,0:10:28.23,DCMain,CONAN,0,0,0,,...والنجمة التي تتوسطها
Dialogue: 0,0:10:28.23,0:10:29.52,DCMain,CONAN,0,0,0,,هي ميغريز هذه...
Dialogue: 0,0:10:29.86,0:10:32.18,DCMain,RAN,0,0,0,,هذا هو المقصود بمنتصف السبعة إذًا
Dialogue: 0,0:10:32.18,0:10:32.98,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:10:34.00,0:10:36.32,DCItalic,CONAN,0,0,0,,تبًا للمجرم الوغد
Dialogue: 0,0:10:36.32,0:10:40.73,DCItalic,CONAN,0,0,0,,جعل الجواب واضحًا لإدراكه أننا لن نستطيع معرفته في الوقت المناسب
Dialogue: 0,0:10:41.16,0:10:43.83,DCMain,TAKAGI,0,0,0,,حضرة المفتش ميغوري! تعال قليلًا لترى من فضلك
Dialogue: 0,0:10:44.20,0:10:46.45,Bomb,TEXT,0,0,0,,{\blur1\frz11.86\pos(1089,617)}موقع القنبلة
Dialogue: 0,0:10:44.20,0:10:46.45,Kanematsu,TEXT,0,0,0,,{\blur1\frz8.688\pos(704,549)}حديقة كانيماتسو
Dialogue: 0,0:10:46.76,0:10:48.41,DCMain,KOGORO,0,0,0,,ما... ما هذه؟
Dialogue: 0,0:10:48.79,0:10:50.29,DCMain,CONAN,0,0,0,,خريطة قنوات الصرف الصحي؟
Dialogue: 0,0:10:50.62,0:10:51.79,DCMain,TAKAGI,0,0,0,,بالضبط
Dialogue: 0,0:10:51.79,0:10:58.26,DCMain,TAKAGI,0,0,0,,من حيث فتحة المجاري التي رمى فيها \Nموري-سان القنبلة في حديقة كانيماتسو إلى هنا
Dialogue: 0,0:10:59.48,0:11:03.48,DCMain,RAN,0,0,0,,هل يعقل أن تلك القنبلة انجرفت من هناك إلى هنا؟
Dialogue: 0,0:11:04.10,0:11:06.18,DCItalic,CONAN,0,0,0,,نعم. لا شك من ذلك
Dialogue: 0,0:11:06.52,0:11:11.45,DCMain,TAKAGI,0,0,0,,على الأرجح إنها انجرفت مع زيادة منسوب المياه من أمطار البارحة
Dialogue: 0,0:11:11.45,0:11:14.11,DCMain,TAKAGI,0,0,0,,ثم توقفت عند الحاجز الموجود هنا في الأسفل
Dialogue: 0,0:11:15.44,0:11:17.66,DCMain,CHIBA,0,0,0,,وتفعيلها لم يكن من مؤقت
Dialogue: 0,0:11:17.66,0:11:21.57,DCMain,CHIBA,0,0,0,,بل تم ذلك من جهاز عن بعد لتفجيرها. حسب ما قاله الفاحص الجنائي
Dialogue: 0,0:11:21.85,0:11:24.70,DCMain,KOGORO,0,0,0,,إذًا خلاصة القول... ما المعنى من ذلك؟
Dialogue: 0,0:11:24.96,0:11:26.06,DCMain,CONAN,0,0,0,,...الخلاصة
Dialogue: 0,0:11:26.06,0:11:31.54,DCMain,CONAN,0,0,0,,هدفه الأصلي منذ البداية كان تفجير مركبة نقل الأموال المصرفية، صحيح؟
Dialogue: 0,0:11:31.54,0:11:33.45,DCMain,KOGORO,0,0,0,,ماذا تقول؟
Dialogue: 0,0:11:33.45,0:11:35.71,DCMain,MEGURE,0,0,0,,يبدو أن هذا هو المنطقي
Dialogue: 0,0:11:36.34,0:11:39.88,DCMain,MEGURE,0,0,0,,استدرج موري-كن ليرمي القنبلة في فتحة الصرف الصحي
Dialogue: 0,0:11:39.88,0:11:42.54,DCMain,MEGURE,0,0,0,,من أجل أن تنجرف وتنفجر في هذا المكان
Dialogue: 0,0:11:43.06,0:11:49.64,DCMain,MEGURE,0,0,0,,مما يعني أن القنبلة الأولى كانت لغرض التمويه لهذه القنبلة كذلك
Dialogue: 0,0:11:49.69,0:11:51.69,DCMain,KOGORO,0,0,0,,!هذا لا يغتفر
Dialogue: 0,0:11:53.18,0:11:55.44,DCMain,KOGORO,0,0,0,,كيف يجرؤ على العبث معي؟
Dialogue: 0,0:11:55.96,0:11:57.11,DCMain,POLICE,0,0,0,,!حضرة المفتش ميغوري
Dialogue: 0,0:11:59.02,0:12:00.32,DCMain,MEGURE,0,0,0,,!ما... ماذا؟
Dialogue: 0,0:12:00.74,0:12:03.17,DCMain,MEGURE,0,0,0,,وجدتم مخبأ هيروكاوا؟
Dialogue: 0,0:12:07.59,0:12:08.84,DCMain,TAKAGI,0,0,0,,سنذهب إلى هناك
Dialogue: 0,0:12:11.68,0:12:13.46,DCMain,KOGORO,0,0,0,,حضرة المفتش، لنذهب نحن أيضًا
Dialogue: 0,0:12:13.46,0:12:14.38,DCMain,MEGURE,0,0,0,,أجل
Dialogue: 0,0:12:14.38,0:12:15.79,DCMain,CONAN,0,0,0,,انتظرا
Dialogue: 0,0:12:16.15,0:12:18.55,DCMain,CONAN,0,0,0,,كيف عرفتم أنه مخبأ المجرم؟
Dialogue: 0,0:12:19.87,0:12:22.72,DCMain,MEGURE,0,0,0,,تلقينا بلاغًا من مجهول
Dialogue: 0,0:12:24.21,0:12:28.35,DCMain,MEGURE,0,0,0,,قال إنه شاهد المفجر هيروكاوا تاكوجي، وطلب منا القبض عليه
Dialogue: 0,0:12:28.68,0:12:31.21,DCMain,MEGURE,0,0,0,,وترك لنا العنوان وأنهى المكالمة
Dialogue: 0,0:12:33.76,0:12:34.95,DCItalic,CONAN,0,0,0,,فهمت
Dialogue: 0,0:12:34.95,0:12:36.60,DCItalic,CONAN,0,0,0,,هكذا هو الأمر إذًا
Dialogue: 0,0:13:34.76,0:13:35.97,DCMain,KOGORO,0,0,0,,!يا للعجب
Dialogue: 0,0:13:36.43,0:13:39.06,DCMain,KOGORO,0,0,0,,يبدو أنك شفيت من إصابتك
Dialogue: 0,0:13:40.42,0:13:42.00,DCMain,KOGORO,0,0,0,,يا رئيس التحرير، توموتاغا
Dialogue: 0,0:13:43.58,0:13:47.19,DCMain,KOGORO,0,0,0,,كما لو أنك لم تكن مصابًا أصلًا
Dialogue: 0,0:13:47.54,0:13:49.39,DCMain,TOMONAGA,0,0,0,,ما معنى ما يحدث؟
Dialogue: 0,0:13:50.12,0:13:53.40,DCMain,KOGORO,0,0,0,,بالمناسبة، سمعت أنك ستصبح مستقلًا قريبًا
Dialogue: 0,0:13:53.40,0:13:57.46,DCMain,KOGORO,0,0,0,,هل ستقوم بالتمويل لنفسك بالأموال المصرفية التي سرقها هيروكاوا من الناقلة؟
Dialogue: 0,0:13:57.86,0:14:00.26,DCMain,TOMONAGA,0,0,0,,عمّ تتحدث؟
Dialogue: 0,0:14:00.26,0:14:02.03,DCMain,TOMONAGA,0,0,0,,لا أفهم ما ترمي إليه
Dialogue: 0,0:14:02.03,0:14:03.97,DCMain,KOGORO,0,0,0,,ألم تشاهد الأخبار؟
Dialogue: 0,0:14:03.97,0:14:04.78,DCMain,TOMONAGA,0,0,0,,!ماذا؟
Dialogue: 0,0:14:05.09,0:14:08.80,DCMain,KOGORO,0,0,0,,مخبأ هيروكاوا انفجر واحترق
Dialogue: 0,0:14:08.80,0:14:11.03,DCMain,TOMONAGA,0,0,0,,بلى، عرفتُ قبل قليل
Dialogue: 0,0:14:11.03,0:14:12.82,DCMain,KOGORO,0,0,0,,،حسب الفحص الجنائي
Dialogue: 0,0:14:12.82,0:14:15.08,DCMain,KOGORO,0,0,0,,،حتى بعد حساب الأوراق المالية المحترقة
Dialogue: 0,0:14:15.13,0:14:17.75,DCMain,KOGORO,0,0,0,,بعد جمعها مع الأموال المتبقية الموجودة وسط الحطام
Dialogue: 0,0:14:17.75,0:14:20.29,DCMain,KOGORO,0,0,0,,لم يصل المجموع الكلي للمبلغ المسروق
Dialogue: 0,0:14:20.91,0:14:24.17,DCMain,KOGORO,0,0,0,,أين ذهب المبلغ المتبقي يا تُرى؟
Dialogue: 0,0:14:24.26,0:14:26.86,DCMain,TOMONAGA,0,0,0,,وما أدراني؟ لا تسألني عن ذلك
Dialogue: 0,0:14:26.86,0:14:31.94,DCMain,KOGORO,0,0,0,,كما سمعت أن موقع المخبأ تم التبليغ عنه من قِبل مجهول
Dialogue: 0,0:14:31.94,0:14:32.85,DCMain,TOMONAGA,0,0,0,,ماذا؟
Dialogue: 0,0:14:33.34,0:14:38.85,DCMain,CONAN,0,0,0,,قال المجهول أنه رأى المفجر هيروكاوا تاكوجي وطلب من الشرطة القبض عليه فورًا
Dialogue: 0,0:14:39.42,0:14:41.10,DCMain,TOMONAGA,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:14:41.38,0:14:46.61,DCMain,KOGORO,0,0,0,,الفكرة في جهاز تغيير الصوت. بدا صوته كأنه يستخدم شيئًا كهذا
Dialogue: 0,0:14:47.14,0:14:49.62,DCMain,KOGORO,0,0,0,,مما جعل من الصعب معرفة صاحب الصوت
Dialogue: 0,0:14:49.62,0:14:52.87,DCMain,TOMONAGA,0,0,0,,إذًا؟ وما شأني أنا بهذا؟
Dialogue: 0,0:14:53.16,0:14:56.87,DCMain,KOGORO,0,0,0,,المشكلة ليست في الصوت، بل بما قاله
Dialogue: 0,0:14:57.99,0:14:59.12,DCMain,TOMONAGA,0,0,0,,ما قاله؟
Dialogue: 0,0:14:59.12,0:15:00.14,DCMain,KOGORO,0,0,0,,أجل
Dialogue: 0,0:15:00.14,0:15:04.13,DCMain,KOGORO,0,0,0,,لم يُعلن عن اسم هيروكاوا للإعلام بعد تلك القضية
Dialogue: 0,0:15:05.19,0:15:09.88,DCMain,KOGORO,0,0,0,,ولا أحد يعرف أنه الجاني سوانا نحن والشرطة وكذلك رئيس التحرير
Dialogue: 0,0:15:10.87,0:15:13.59,DCMain,KOGORO,0,0,0,,أي أن لا أحد سواك قد يعرفه
Dialogue: 0,0:15:13.59,0:15:21.44,DCMain,TOMONAGA,0,0,0,,ربما لأن صورة لوجه هيروكاوا ظهرت خلال الحديث\N عن التفجيرات في تلك الأيام، ربما تذكره ذاك الشخص
Dialogue: 0,0:15:21.62,0:15:22.65,DCMain,KOGORO,0,0,0,,أأنت الفاعل؟
Dialogue: 0,0:15:23.30,0:15:26.19,DCMain,TOMONAGA,0,0,0,,أنا؟ لماذا تشير إلي أنا؟
Dialogue: 0,0:15:26.41,0:15:29.22,DCMain,TOMONAGA,0,0,0,,هل يعقل أنك تشتبه بي يا موري-سان؟
Dialogue: 0,0:15:29.22,0:15:31.37,DCMain,KOGORO,0,0,0,,نعم. أشتبه بك
Dialogue: 0,0:15:31.37,0:15:33.57,DCMain,KOGORO,0,0,0,,بالأحرى، أتّهمك بكل تأكيد
Dialogue: 0,0:15:33.96,0:15:38.58,DCMain,KOGORO,0,0,0,,الشخص الموجِّه لـ هيروكاوا كان أنت يا توموناغا-سان
Dialogue: 0,0:15:38.92,0:15:42.64,DCMain,KOGORO,0,0,0,,مثلما يقدم المحرر توجيهاته للمؤلف الجديد
Dialogue: 0,0:15:44.10,0:15:48.21,DCMain,TOMONAGA,0,0,0,,إذًا، لو كنتَ تشتبه بي فأرني الدليل
Dialogue: 0,0:15:48.73,0:15:53.21,DCMain,KOGORO,0,0,0,,،بينما كانت القنابل مزودة بمؤقت
Dialogue: 0,0:15:53.21,0:15:56.47,DCMain,KOGORO,0,0,0,,إلا أنها كانت مهيأة لتنفجر بواسطة جهاز تحكم عن بعد
Dialogue: 0,0:15:56.80,0:15:59.52,DCMain,KOGORO,0,0,0,,،حسب تفاصيل الفحص الجنائي
Dialogue: 0,0:15:59.52,0:16:04.36,DCMain,KOGORO,0,0,0,,موجات الإرسال من أجهزة التحكم عن بعد لا تؤثر إلا في نطاق لا يتجاوز ثلاثين مترًا
Dialogue: 0,0:16:04.48,0:16:06.73,DCMain,TOMONAGA,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:16:07.04,0:16:11.07,DCMain,KOGORO,0,0,0,,...ولهذا، تسريع مؤقت القنبلة الثانية
Dialogue: 0,0:16:11.89,0:16:16.03,DCMain,KOGORO,0,0,0,,وإرسال الرسائل لي تزامنًا مع الأحداث
Dialogue: 0,0:16:16.51,0:16:18.62,DCMain,KOGORO,0,0,0,,لا أحد سيفعل ذلك سوى شخص كان معنا
Dialogue: 0,0:16:19.00,0:16:20.96,DCMain,KOGORO,0,0,0,,...وذاك الشخص يا توموناغا هيرويوكي-سان
Dialogue: 0,0:16:22.12,0:16:23.96,DCMain,KOGORO,0,0,0,,لا أحد سواك
Dialogue: 0,0:16:24.73,0:16:29.00,DCMain,KOGORO,0,0,0,,وبعد ذلك، طلبتَ من المفتش أن ترافقنا
Dialogue: 0,0:16:29.36,0:16:34.51,DCMain,KOGORO,0,0,0,,وأرسلتَ لي الرسائل المتوافقة تمامًا مع تحركاتي
Dialogue: 0,0:16:36.28,0:16:37.93,DCMain,KOGORO,0,0,0,,هل أخطأتُ في شيء؟
Dialogue: 0,0:16:39.79,0:16:47.40,DCMain,KOGORO,0,0,0,,اقترحتَ على هيروكاوا الهجوم على مركبة نقل \Nالأموال المصرفية ويجعل الأمر يبدو وكأنه انتقام لأخيه الأصغر
Dialogue: 0,0:16:47.72,0:16:51.66,DCMain,KOGORO,0,0,0,,حتى إنك استغللتني أنا، موري كوغورو، وأقحمتني في القضية
Dialogue: 0,0:16:51.66,0:16:54.16,DCMain,KOGORO,0,0,0,,من أجل إخفاء نواياك الحقيقية
Dialogue: 0,0:16:54.95,0:17:01.33,DCMain,KOGORO,0,0,0,,ومن ثم تخلصتَ من هيروكاوا مستخدمًا القنبلة الإضافية التي جعلتَه يصنعها
Dialogue: 0,0:17:02.20,0:17:04.11,DCMain,TOMONAGA,0,0,0,,لا عجب من متحرٍ عظيم
Dialogue: 0,0:17:04.11,0:17:06.16,DCMain,TOMONAGA,0,0,0,,استنتاج مبهر بحق
Dialogue: 0,0:17:06.60,0:17:10.46,DCMain,TOMONAGA,0,0,0,,بعد أن أصبح مستقلًا، ما رأيك بكتابة روايات بوليسية لأجلي؟
Dialogue: 0,0:17:10.92,0:17:13.10,DCMain,TOMONAGA,0,0,0,,رواية بوليسية من تأليف متحرٍ شهير
Dialogue: 0,0:17:13.10,0:17:15.32,DCMain,TOMONAGA,0,0,0,,لا بد أنها ستحصد أعلى المبيعات
Dialogue: 0,0:17:16.16,0:17:19.44,DCMain,TOMONAGA,0,0,0,,ولكن كلها محض افتراضات تخلو من الدليل
Dialogue: 0,0:17:19.44,0:17:23.48,DCMain,TOMONAGA,0,0,0,,لا بد أنك ستسمع انتقادات لاذعة من محبي الروايات البوليسية
Dialogue: 0,0:17:23.83,0:17:26.12,DCMain,KOGORO,0,0,0,,ولكن هذه ليست رواية بوليسية
Dialogue: 0,0:17:26.12,0:17:27.98,DCMain,KOGORO,0,0,0,,بل جريمة حقيقية
Dialogue: 0,0:17:28.36,0:17:32.86,DCMain,KOGORO,0,0,0,,ومجرد اعتراف من هيروكاوا كفيل بتغيير مجرى القصة
Dialogue: 0,0:17:33.10,0:17:35.02,DCMain,TOMONAGA,0,0,0,,عمّ تتحدث؟
Dialogue: 0,0:17:35.02,0:17:36.45,DCMain,TOMONAGA,0,0,0,,...لا بد أنه ميت
Dialogue: 0,0:17:36.66,0:17:40.45,DCMain,TOMONAGA,0,0,0,,لا! أقصد هذا ما قالوه في الأخبار
Dialogue: 0,0:17:40.75,0:17:45.06,DCMain,KOGORO,0,0,0,,لا، لم يُذكر أي شيء في الأخبار عن ذلك
Dialogue: 0,0:17:45.06,0:17:46.53,DCMain,KOGORO,0,0,0,,ولم أقله أنا كذلك
Dialogue: 0,0:17:47.60,0:17:49.37,DCMain,TOMONAGA,0,0,0,,!هل يعقل؟
Dialogue: 0,0:17:50.08,0:17:52.42,DCMain,MEGURE,0,0,0,,أجل. لقد نجا
Dialogue: 0,0:17:52.61,0:17:53.92,DCMain,MEGURE,0,0,0,,أقصد هيروكاوا
Dialogue: 0,0:17:54.13,0:17:57.43,DCMain,MEGURE,0,0,0,,وهذا بفضل استنتاج موري-كن
Dialogue: 0,0:17:58.75,0:18:02.18,DCMain,KOGORO,0,0,0,,...رغم قولك أنك نسيت جواب اللغز
Dialogue: 0,0:18:02.18,0:18:05.89,DCMain,KOGORO,0,0,0,,ولكنك أخذتَ تتحدث فجأة عن رسومات الكتاب
Dialogue: 0,0:18:06.27,0:18:10.99,DCMain,KOGORO,0,0,0,,لم أفهم السبب آنذاك ولكنك أردتَ أن تكون النهاية نفسها، صحيح؟
Dialogue: 0,0:18:11.61,0:18:13.74,DCMain,KOGORO,0,0,0,,...انتحار المجرم
Dialogue: 0,0:18:13.94,0:18:15.20,DCMain,KOGORO,0,0,0,,...ورسومات كتاب الصور
Dialogue: 0,0:18:15.78,0:18:18.41,DCMain,KOGORO,0,0,0,,أردتَهما أن يتداخلا معًا
Dialogue: 0,0:18:20.72,0:18:27.67,DCMain,TAKAGI,0,0,0,,وبعد ملاحظة موري-سان، اتصل بنا وطلب منا\N أن نسبق فريق المداهمة ونأخذ هيروكاوا تحت وصايتنا
Dialogue: 0,0:18:28.06,0:18:32.84,DCMain,CHIBA,0,0,0,,تجاوزنا سيارات الشرطة المتجهة إلى هناك ودخلنا من المدخل الخلفي للمخبأ
Dialogue: 0,0:18:35.36,0:18:38.97,DCMain,CHIBA,0,0,0,,ونجحنا في أخذ هيروكاوا في آخر لحظة
Dialogue: 0,0:18:39.24,0:18:43.97,DCMain,KOGORO,0,0,0,,...ومن دون إدراكك شيئًا، بعد أن تجمّع رجال الشرطة حول المخبأ
Dialogue: 0,0:18:44.24,0:18:47.73,DCMain,KOGORO,0,0,0,,قمتَ بتفجير القنبلة من جهاز التحكم عن بعد
Dialogue: 0,0:18:49.45,0:18:57.82,DCMain,MEGURE,0,0,0,,لا بد أن هيروكاوا سيقول معلومات كثيرة مثيرة \Nللاهتمام بمجرد أن يعرف عن استغلالك له ومحاولتك قتله
Dialogue: 0,0:19:02.52,0:19:05.69,DCMain,TOMONAGA,0,0,0,,متى... متى عرفت أنني الفاعل؟
Dialogue: 0,0:19:05.69,0:19:10.12,DCMain,KOGORO,0,0,0,,منذ قولك أن المؤلف ترك تلك الطبعة الأولية لأخيه
Dialogue: 0,0:19:11.96,0:19:12.78,DCMain,KOGORO,0,0,0,,كونان
Dialogue: 0,0:19:12.78,0:19:14.23,DCMain,CONAN,0,0,0,,حاضر
Dialogue: 0,0:19:14.23,0:19:15.42,DCMain,CONAN,0,0,0,,انظر هنا
Dialogue: 0,0:19:15.98,0:19:19.80,DCMain,CONAN,0,0,0,,رغم إنها طبعة أولية، ولكن من الواضح أنها نسخة
Dialogue: 0,0:19:20.13,0:19:23.85,DCMain,CONAN,0,0,0,,أليس غريبًا أن تكون الطبعة الأولية مختلفة المحاذاة؟
Dialogue: 0,0:19:26.85,0:19:31.60,DCMain,KOGORO,0,0,0,,من المفترض بديهيًا أن يكون هيروكاوا طلب الحصول على الأصل
Dialogue: 0,0:19:32.44,0:19:34.98,DCMain,KOGORO,0,0,0,,ولكنه قال إنه لا يملكها
Dialogue: 0,0:19:35.18,0:19:39.53,DCMain,KOGORO,0,0,0,,أي أن من المؤكد أنها ما تزال بحوزتك
Dialogue: 0,0:19:40.05,0:19:45.03,DCMain,KOGORO,0,0,0,,مما يعني أنك ألقيت نظرة عليها خلال هذه القضية
Dialogue: 0,0:19:45.36,0:19:47.74,DCMain,KOGORO,0,0,0,,ولكنك كذبت علينا بادعائك عدم قراءتها
Dialogue: 0,0:19:48.44,0:19:49.61,DCMain,KOGORO,0,0,0,,لمَ ذلك؟
Dialogue: 0,0:19:49.61,0:19:56.17,DCMain,KOGORO,0,0,0,,لأنك المجرم، بالأحرى العقل المدبر لهذه الجريمة بأكملها
Dialogue: 0,0:20:19.78,0:20:22.90,DCMain,KOGORO,0,0,0,,والآن في الختام، لدي سؤال أطرحه عليك
Dialogue: 0,0:20:23.38,0:20:27.33,DCMain,KOGORO,0,0,0,,لماذا لم تعطِ هيروكاوا النص الأصلي؟
Dialogue: 0,0:20:27.83,0:20:28.88,DCMain,TOMONAGA,0,0,0,,...لأن
Dialogue: 0,0:20:33.96,0:20:35.96,DCMain,TOMONAGA,0,0,0,,لأنها كانت تحفة فنية، بالطبع
Dialogue: 0,0:20:36.31,0:20:38.52,DCMain,TOMONAGA,0,0,0,,وأنا ما أزال محررًا
Dialogue: 0,0:20:38.52,0:20:39.96,DCMain,TOMONAGA,0,0,0,,أستطيع معرفة قيمتها
Dialogue: 0,0:20:40.24,0:20:43.97,DCMain,TOMONAGA,0,0,0,,حتى وإن كان فردًا من عائلته، لن أستطيع تسليمها لمجرم
Dialogue: 0,0:20:44.66,0:20:48.02,DCMain,TOMONAGA,0,0,0,,...وتمزيق الصفحات التي تحتوي على التلميحات
Dialogue: 0,0:20:49.28,0:20:53.57,DCMain,TOMONAGA,0,0,0,,رغم إنها خطتي، ولكنني لم أجرؤ على فعل ذلك بنفسي
Dialogue: 0,0:20:54.14,0:20:59.50,DCMain,TOMONAGA,0,0,0,,كنت أخطط لنشر النص الأصلي للكتاب يومًا ما بيديّ هاتين
Dialogue: 0,0:20:59.50,0:21:00.46,DCMain,RAN,0,0,0,,!كفى
Dialogue: 0,0:21:01.47,0:21:02.86,DCMain,RAN,0,0,0,,!لا تفعل رجاءً
Dialogue: 0,0:21:02.86,0:21:05.32,DCMain,RAN,0,0,0,,!لا تملك الحق في ذلك
Dialogue: 0,0:21:07.32,0:21:09.06,DCMain,RAN,0,0,0,,،حتى وإن كانت نسخة
Dialogue: 0,0:21:09.66,0:21:13.04,DCMain,RAN,0,0,0,,...استخدامك قصة جميلة كهذه في ارتكاب جريمة
Dialogue: 0,0:21:14.19,0:21:16.92,DCMain,RAN,0,0,0,,لا بد أن هذا يُبكي المؤلف الراحل
Dialogue: 0,0:21:20.12,0:21:21.01,DCItalic,CONAN,0,0,0,,!ران
Dialogue: 0,0:23:09.03,0:23:18.41,Title,SIGN,0,0,0,,{\fad(920,1)\fscx135\fscy147\3c&H543DA3&\3a&HFF&\pos(836,28)}الجد
Dialogue: 0,0:23:09.03,0:23:18.41,Title,SIGN,0,0,0,,{\fad(920,1)\fscx135\fscy147\c&H85C7E2&\3c&H543DA3&\3a&HFB&\pos(742,30)}تيك تاك
Dialogue: 0,0:23:09.03,0:23:18.41,Title,SIGN,0,0,0,,{\fad(920,1)\fscx135\fscy147\c&HE9ECEA&\3c&H543DA3&\3a&HFF&\pos(660,30)}و
Dialogue: 0,0:23:09.03,0:23:18.41,Title,SIGN,0,0,0,,{\fad(920,1)\fscx135\fscy147\c&HE5F483&\3c&H543DA3&\3a&HFF&\pos(582,30)}الساعات
Dialogue: 0,0:23:09.03,0:23:18.41,Title,SIGN,0,0,0,,{\fad(920,1)\fscx135\fscy147\c&HCEA746&\3c&H543DA3&\3a&HFF&\pos(462,28)}الثلاث
Dialogue: 0,0:23:11.07,0:23:11.70,DCMain,CONAN,0,0,0,,،بعد ستة أشهر
Dialogue: 0,0:23:12.49,0:23:16.37,DCMain,CONAN,0,0,0,,،سواء كانت توقعات المحرر توموناغا صوابًا أم خطأ
Dialogue: 0,0:23:17.08,0:23:19.25,DCMain,CONAN,0,0,0,,تم نشر كتاب الصور ذلك بالكامل
Dialogue: 0,0:23:18.41,0:23:22.42,Winner,TEXT,0,0,0,,{\pos(638,13)}الفائز بالجائزة الرابعة والثلاثين للمؤلفين المستجدين
Dialogue: 0,0:23:18.41,0:23:22.42,Recommended,TEXT,0,0,0,,{\frz18.09\pos(1103,384)}يوصي به طاقم العمل
Dialogue: 0,0:23:19.83,0:23:22.42,DCMain,CONAN,0,0,0,,وفاز بجائرة مسابقة المؤلفين المستجدين بامتياز
Dialogue: 0,0:23:24.42,0:23:25.84,DCMain,CONAN,0,0,0,,،كان وداعًا لائقًا
Dialogue: 0,0:23:24.46,0:23:31.51,Note,TEXT,0,0,0,,{\fad(1750,1)\pos(359,729)}كلمة المؤلف: أحب كتابة الألغاز والرسم
Dialogue: 0,0:23:24.46,0:23:31.51,Author2,TEXT,0,0,0,,{\fad(2670,1)\pos(1016,81)}كتاب قصة مصورة من تأليف إيماي كينيتشي
Dialogue: 0,0:23:26.17,0:23:29.30,DCMain,CONAN,0,0,0,,للمؤلف الذي توفي في ريعان شبابه
Dialogue: 0,0:23:29.76,0:23:31.51,DCMain,CONAN,0,0,0,,ولكن هذا موضوع آخر
Dialogue: 0,0:23:32.55,0:23:36.18,DCMain,KOGORO,0,0,0,,تبًا. رغم كل الجري والجهد الذي بذلته هذه المرة
Dialogue: 0,0:23:36.77,0:23:39.06,DCMain,KOGORO,0,0,0,,ولكن لا أشعر أنني أنجزت شيئًا
Dialogue: 0,0:23:39.06,0:23:40.60,DCMain,KOGORO,0,0,0,,أشعر بالتعب وحسب
Dialogue: 0,0:23:41.35,0:23:42.73,DCMain,KOGORO,0,0,0,,ولكن... لا يهم
Dialogue: 0,0:23:43.19,0:23:46.11,DCMain,KOGORO,0,0,0,,لا شيء أفضل من مذاق الجعة بعد جهد شاق
Dialogue: 0,0:23:52.57,0:23:53.37,DCMain,KOGORO,0,0,0,,!لذيذة
Dialogue: 0,0:23:53.53,0:23:55.66,DCMain,RAN,0,0,0,,مذاقها نفسه كالعادة، صحيح؟
Dialogue: 0,0:23:56.87,0:23:57.91,DCMain,CONAN,0,0,0,,أقنعيه بذلك
Dialogue: 0,0:24:14.93,0:24:19.93,Hint,TEXT,0,0,0,,{\pos(640,500)\fscx111\fscy111}مواقع المقاعد
Dialogue: 0,0:24:15.97,0:24:17.85,DCMain,KOGORO,0,0,0,,تلميح كونان التالي
Dialogue: 0,0:24:18.52,0:24:19.93,DCMain,CONAN,0,0,0,,مواقع المقاعد
Dialogue: 0,0:24:20.52,0:24:21.94,DCMain,RAN,0,0,0,,{\an8}الحلقة القادمة دور كازوها-تشان
Dialogue: 0,0:24:19.93,0:24:40.04,Don'tMiss,TEXT,0,0,0,,{\fscx83\fscy92\pos(608,623)}لا تفوّتوا مشاهدة الحلقة القادمة
Dialogue: 0,0:24:21.94,0:24:22.81,DCMain,CONAN,0,0,0,,{\an8}مما يعني هاتوري أيضًا
Dialogue: 0,0:24:22.81,0:24:23.44,DCMain,RAN,0,0,0,,{\an8}أستشعر الحب في الجو
Dialogue: 0,0:24:23.44,0:24:24.56,DCMain,CONAN,0,0,0,,{\an8}لا، بل هي قضية
