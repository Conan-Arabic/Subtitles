Dialogue: 0,0:05:06.95,0:05:12.95,DCEpTitle,EPTITLE,0,0,0,,{\fad(404,1)\fscx85\fscy105\pos(658,124)}غموض الخيمة المحروقة
Dialogue: 0,0:05:06.95,0:05:12.95,DCEpTitle,EPTITLE,0,0,0,,{\fnSimple Bold Jut Out\pos(772,474)})
Dialogue: 0,0:05:06.95,0:05:12.95,DCEpTitle,TEXT,0,0,0,,{\pos(640,476)}{\fnSimple Bold Jut Out}({\fscx56\fscy68\fnMCS QUDS  SPINED}الجزء الثاني
Dialogue: 0,0:05:07.61,0:05:10.52,DCMain,CONAN,0,0,0,,!غموض الخيمة المحروقة، الجزء الثاني
Dialogue: 0,0:05:13.79,0:05:19.46,DCMain,MIDORI,0,0,0,,كان الثَمَلُ قد نال من أوروشيبارا-كن عندما زرت خيمته
Dialogue: 0,0:05:19.54,0:05:26.63,Midori,SIGN,0,0,0,,{\fad(250,250)\p1\c&H8A332F&\pos(618,720)\fscx2510\fscy1459\clip(m 515 581 l 774 583 772 694 513 694)}m 0 0 l 20 0 l 20 12 l 0 12 l 0 0
Dialogue: 0,0:05:19.54,0:05:26.63,Midori,TEXT,0,0,0,,{\fad(250,250)\blur1\pos(640,628)}(فوروكا ميدوري (22
Dialogue: 0,0:05:19.54,0:05:26.63,Midori,TEXT,0,0,0,,{\fad(250,250)\blur1\pos(642,676)}مديرة فريق كرة سلة
Dialogue: 0,0:05:19.82,0:05:24.56,DCMain,MIDORI,0,0,0,,{\an8}ظل يصرخ "اخرسي وارحلي!" مهما حاولتُ معه
Dialogue: 0,0:05:24.96,0:05:26.72,DCMain,MIDORI,0,0,0,,{\an8}لم تكن محادثة لائقة
Dialogue: 0,0:05:26.93,0:05:30.52,DCMain,KURODA,0,0,0,,هل كانت إنارة الخيمة مطفأة حينها؟
Dialogue: 0,0:05:30.52,0:05:31.58,DCMain,MIDORI,0,0,0,,أجل
Dialogue: 0,0:05:31.58,0:05:36.73,DCMain,MIDORI,0,0,0,,كانت لا تزال مطفأة وقال إنه سيقرأ بعض المانغا قبل النوم
Dialogue: 0,0:05:37.04,0:05:42.05,DCMain,YUMINAGA,0,0,0,,ولكن لماذا كانت هناك شمعات كثيرة داخل خيمته؟
Dialogue: 0,0:05:42.05,0:05:45.49,DCMain,YUMINAGA,0,0,0,,عددها كبير مهما نظرنا للأمر
Dialogue: 0,0:05:45.83,0:05:51.97,DCMain,MIDORI,0,0,0,,كانت مهمته إحضار أعواد الثقاب والشمعات
Dialogue: 0,0:05:51.97,0:05:52.91,DCMain,YUMINAGA,0,0,0,,فهمت
Dialogue: 0,0:05:52.91,0:05:54.06,DCMain,CONAN,0,0,0,,...في تلك الحالة
Dialogue: 0,0:05:54.61,0:05:58.03,DCMain,CONAN,0,0,0,,هل كانت مهمة أوروشيبارا-سان إحضار كل أعمال المانغا تلك؟
Dialogue: 0,0:05:58.03,0:06:00.78,DCMain,MIDORI,0,0,0,,أجل.. إنها تخصني
Dialogue: 0,0:06:00.78,0:06:04.00,DCMain,MIDORI,0,0,0,,قال أوروشيبارا-كن إنه أراد قراءتها أثناء التخييم
Dialogue: 0,0:06:04.31,0:06:07.35,DCMain,MIDORI,0,0,0,,،ولكن لو علمتُ أن هذا سيحدث
Dialogue: 0,0:06:08.18,0:06:11.39,DCMain,MIDORI,0,0,0,,لسحبته لخارج خيمته
Dialogue: 0,0:06:11.98,0:06:15.66,DCMain,MIDORI,0,0,0,,كان علي إجباره على تناول الكاري معنا عوضًا عن قراءة المانغا
Dialogue: 0,0:06:21.25,0:06:23.07,DCMain,ASHIZAWA,0,0,0,,،عندما زرتُ خيمته
Dialogue: 0,0:06:23.07,0:06:26.69,DCMain,ASHIZAWA,0,0,0,,لم يجبني أبدًا مهما ناديته
Dialogue: 0,0:06:26.69,0:06:33.74,Sumito,SIGN,0,0,0,,{\fad(250,250)\p1\c&H70495D&\fscx2510\fscy1459\pos(524,714.667)\clip(m 359 579 l 624 580 624 695 362 696)}m 0 0 l 20 0 l 20 12 l 0 12 l 0 0
Dialogue: 0,0:06:26.69,0:06:33.74,Sumito,TEXT,0,0,0,,{\fad(250,250)\blur1\pos(490,628)}(آشيزاوا سوميتو (22
Dialogue: 0,0:06:26.69,0:06:33.74,Sumito,TEXT,0,0,0,,{\fad(250,250)\fscx91\fscy97\blur1\pos(492,674)}لاعب بفريق كرة السلة
Dialogue: 0,0:06:27.12,0:06:30.72,DCMain,ASHIZAWA,0,0,0,,{\an8}،ظننتُ في البداية أنه يتجاهلني
Dialogue: 0,0:06:30.72,0:06:35.45,DCMain,ASHIZAWA,0,0,0,,{\an8}ولكن ظننت أنه ثمِل وخلد للنوم بعد سماع كلام فوروكا
Dialogue: 0,0:06:35.79,0:06:39.09,DCMain,ASHIZAWA,0,0,0,,لا يستيقظ أبدًا عندما يفقد وعيه من فرط الشراب
Dialogue: 0,0:06:39.09,0:06:43.54,DCMain,ASHIZAWA,0,0,0,,حاله ميؤوس منها لدرجة أن الآخرين يرسمون على وجهه أثناء تخييمنا
Dialogue: 0,0:06:44.00,0:06:46.12,DCMain,KURODA,0,0,0,,هل كانت الأضواء مشتعلة داخل الخيمة حينها؟
Dialogue: 0,0:06:46.87,0:06:49.38,DCMain,ASHIZAWA,0,0,0,,لا أعتقد ذلك
Dialogue: 0,0:06:49.63,0:06:53.23,DCMain,ASHIZAWA,0,0,0,,،صحيح، بعد أن غادرت خيمته
Dialogue: 0,0:06:53.23,0:06:55.29,DCMain,ASHIZAWA,0,0,0,,اشتعلت الأضواء فجأة
Dialogue: 0,0:06:55.29,0:06:58.27,DCMain,ASHIZAWA,0,0,0,,كان يؤدي التمارين داخل خيمته
Dialogue: 0,0:06:59.20,0:07:00.27,DCMain,KURODA,0,0,0,,تمارين؟
Dialogue: 0,0:07:00.52,0:07:01.29,DCMain,ASHIZAWA,0,0,0,,أجل
Dialogue: 0,0:07:01.29,0:07:05.55,DCMain,ASHIZAWA,0,0,0,,قال إنه يؤديها كلما همّ بالنوم
Dialogue: 0,0:07:05.55,0:07:07.79,DCMain,GENTA,0,0,0,,!رأيناه نحن أيضًا
Dialogue: 0,0:07:08.35,0:07:11.61,DCMain,GENTA,0,0,0,,كانت يداه خلف رأسه هكذا
Dialogue: 0,0:07:11.61,0:07:14.23,DCMain,MITSUHIKO,0,0,0,,كان يؤدي تمارين انحناء باستمرار
Dialogue: 0,0:07:14.23,0:07:16.16,DCMain,AYUMI,0,0,0,,رأينا ظله على الخيمة
Dialogue: 0,0:07:16.59,0:07:17.41,DCMain,KURODA,0,0,0,,فهمت
Dialogue: 0,0:07:17.41,0:07:22.67,DCMain,YUMINAGA,0,0,0,,إن كان هذا صحيحًا، فهو يعني أن الضحية كان مستيقظًا حينها
Dialogue: 0,0:07:22.69,0:07:23.61,DCMain,KURODA,0,0,0,,أجل
Dialogue: 0,0:07:24.09,0:07:27.59,DCMain,KURODA,0,0,0,,...هذا يعني أن آخر من زار خيمة الضحية
Dialogue: 0,0:07:28.51,0:07:29.57,DCMain,DANNO,0,0,0,,{\an8}!مهلًا
Dialogue: 0,0:07:28.38,0:07:32.47,Kuninori,SIGN,0,0,0,,{\fad(250,0)\p1\c&H8A332F&\fscx2510\fscy1459\pos(620,704)\clip(m 513 578 l 773 579 773 696 510 697)}m 0 0 l 20 0 l 20 12 l 0 12 l 0 0
Dialogue: 0,0:07:28.38,0:07:32.47,Kuninori,TEXT,0,0,0,,{\fad(250,0)\fscx108\fscy118\blur1\pos(644,636)}(دانو كونينوري (22
Dialogue: 0,0:07:28.38,0:07:32.47,Kuninori,TEXT,0,0,0,,{\fad(250,0)\fscx91\fscy97\blur1\pos(640,680)}لاعب بفريق كرة السلة
Dialogue: 0,0:07:29.57,0:07:32.47,DCMain,DANNO,0,0,0,,{\an8}!لم أشعل خيمة أوروشيبارا
Dialogue: 0,0:07:32.84,0:07:36.35,DCMain,DANNO,0,0,0,,،عندما ذهبتُ لخيمته لإغرائه برائحة الكاري ليخرج
Dialogue: 0,0:07:36.35,0:07:39.89,DCMain,DANNO,0,0,0,,لم يقل شيئًا كما كان الأمر عندما زاره آشيزاوا
Dialogue: 0,0:07:40.31,0:07:44.27,DCMain,DANNO,0,0,0,,حاولت الحديث معه، ولكنه واصل أداء التمارين بصمت
Dialogue: 0,0:07:44.27,0:07:48.40,DCMain,DANNO,0,0,0,,ظننت أنه كان يؤديها مرتديًا سماعات أذن ويستمع للموسيقى أو ما شابه
Dialogue: 0,0:07:49.47,0:07:53.28,DCMain,DANNO,0,0,0,,بالتفكير في الأمر، ربما سمعني
Dialogue: 0,0:07:53.28,0:07:57.16,DCMain,DANNO,0,0,0,,كما لو كان يطلب مني الرحيل
Dialogue: 0,0:07:57.81,0:08:01.66,DCMain,DANNO,0,0,0,,أصبحت حركات تمارينه أسرع تدريجيًا
Dialogue: 0,0:08:02.08,0:08:05.17,DCItalic,CONAN,0,0,0,,أصبحت حركاته أسرع تدريجيًا؟
Dialogue: 0,0:08:05.50,0:08:12.68,DCMain,YUMINAGA,0,0,0,,لماذا بقي الضحية أوروشيبارا-سان في خيمته عوضًا عن تناول الكاري مع البقية؟
Dialogue: 0,0:08:12.68,0:08:14.93,DCMain,DANNO,0,0,0,,حدث جدال بيننا
Dialogue: 0,0:08:15.20,0:08:17.53,DCMain,DANNO,0,0,0,,كانت تجمعنا علاقة شائكة
Dialogue: 0,0:08:17.53,0:08:18.93,DCMain,KURODA,0,0,0,,شائكة؟
Dialogue: 0,0:08:19.16,0:08:22.47,DCMain,DANNO,0,0,0,,...حسنًا، خلال تدريب كرة السلة، أصابني بمرفقه
Dialogue: 0,0:08:22.47,0:08:23.32,DCMain,CONAN,0,0,0,,لو سمحت
Dialogue: 0,0:08:23.94,0:08:26.95,DCMain,CONAN,0,0,0,,ادّعى دانو-سان أنه كان نجم فريق كرة السلة
Dialogue: 0,0:08:26.95,0:08:27.83,DCMain,CONAN,0,0,0,,هل ذلك صحيح؟
Dialogue: 0,0:08:27.83,0:08:29.32,DCMain,MIDORI,0,0,0,,أجل، كان كذلك
Dialogue: 0,0:08:29.76,0:08:35.11,DCMain,MIDORI,0,0,0,,لفت أنظار العديد من فرق المحترفين لأنه استطاع تنفيذ كرات ساحقة بطوله
Dialogue: 0,0:08:35.11,0:08:36.41,DCMain,CONAN,0,0,0,,حقًا؟
Dialogue: 0,0:08:36.80,0:08:37.61,DCMain,MIDORI,0,0,0,,...لكن
Dialogue: 0,0:08:37.61,0:08:42.65,DCMain,ASHIZAWA,0,0,0,,،لولا الإصابة التي تعرض لها في عينه اليمنى بسبب أوروشيبارا
Dialogue: 0,0:08:43.11,0:08:46.84,DCMain,ASHIZAWA,0,0,0,,لانتهى به المطاف لاعبًا في فريق أجنبي ما
Dialogue: 0,0:08:46.84,0:08:53.76,DCMain,ASHIZAWA,0,0,0,,ولكن من السخرية أنني ترقيت من لاعب احتياطي إلى لاعب أساسي بفضل تلك الإصابة
Dialogue: 0,0:08:53.78,0:08:56.32,DCMain,ASHIZAWA,0,0,0,,وأنا النجم الآن
Dialogue: 0,0:08:56.32,0:08:58.30,DCMain,ASHIZAWA,0,0,0,,،وبما أن دانو اعتزل اللعب
Dialogue: 0,0:08:58.30,0:09:02.05,DCMain,ASHIZAWA,0,0,0,,،فقد بدأ بقضاء وقت أطول مع مديرتنا فوروكا-سان
Dialogue: 0,0:09:02.05,0:09:04.79,DCMain,ASHIZAWA,0,0,0,,وهما يتواعدان الآن
Dialogue: 0,0:09:04.79,0:09:06.51,DCMain,MIDORI,0,0,0,,أجل
Dialogue: 0,0:09:06.99,0:09:11.00,DCMain,ASHIZAWA,0,0,0,,،لطالما أحاطت المعجبات بدانو
Dialogue: 0,0:09:11.00,0:09:15.65,DCMain,ASHIZAWA,0,0,0,,ولكنهن تركنه عندما أصبح مديرًا
Dialogue: 0,0:09:17.32,0:09:18.59,DCMain,POLICE,0,0,0,,!حضرة المفتش يوميناغا
Dialogue: 0,0:09:19.21,0:09:20.14,DCMain,YUMINAGA,0,0,0,,ما الأمر؟
Dialogue: 0,0:09:20.14,0:09:21.82,DCMain,YUMINAGA,0,0,0,,هل اكتشفتم شيئًا؟
Dialogue: 0,0:09:22.29,0:09:28.35,DCMain,POLICE,0,0,0,,يتعلق الأمر باللفافة الطبية على أصابع الضحية التي طلبت فحصها
Dialogue: 0,0:09:29.04,0:09:29.75,DCItalic,CONAN,0,0,0,,ماذا؟
Dialogue: 0,0:09:30.21,0:09:32.23,DCMain,POLICE,0,0,0,,،السطح محترق
Dialogue: 0,0:09:32.23,0:09:36.93,DCMain,POLICE,0,0,0,,ولكن سَلِم معظم الجانب اللزج ولهذا أزلناها
Dialogue: 0,0:09:36.93,0:09:39.76,DCMain,POLICE,0,0,0,,لم نعثر على أي خدعة أو آلية
Dialogue: 0,0:09:39.95,0:09:41.30,DCMain,YUMINAGA,0,0,0,,فهمت
Dialogue: 0,0:09:41.30,0:09:43.05,DCMain,CONAN,0,0,0,,أيها المفتش يوميناغا
Dialogue: 0,0:09:43.52,0:09:45.98,DCMain,CONAN,0,0,0,,هل يمكنني رؤية الصورة؟
Dialogue: 0,0:09:47.13,0:09:49.11,DCMain,YUMINAGA,0,0,0,,أجل، بالطبع
Dialogue: 0,0:09:49.51,0:09:50.27,DCMain,CONAN,0,0,0,,شكرًا
Dialogue: 0,0:09:51.03,0:09:52.27,DCItalic,CONAN,0,0,0,,كما توقعت
Dialogue: 0,0:09:52.78,0:09:54.35,DCItalic,CONAN,0,0,0,,...ذلك الشخص
Dialogue: 0,0:09:54.35,0:09:55.74,DCMain,YUMINAGA,0,0,0,,يا ولد
Dialogue: 0,0:09:56.44,0:09:58.85,DCMain,YUMINAGA,0,0,0,,هل اكتشفتَ شيئًا ما مجددًا؟
Dialogue: 0,0:09:58.85,0:09:59.87,DCMain,CONAN,0,0,0,,...ولكن
Dialogue: 0,0:10:00.15,0:10:01.81,DCMain,CONAN,0,0,0,,قد أكون حائرًا
Dialogue: 0,0:10:03.64,0:10:05.53,DCMain,YUMINAGA,0,0,0,,حائرٌ إذًا؟
Dialogue: 0,0:10:08.06,0:10:09.63,DCMain,CONAN,0,0,0,,!يا رفاق
Dialogue: 0,0:10:12.42,0:10:16.63,DCItalic,CONAN,0,0,0,,!ياحبيبي.. نسوا القضية تمامًا
Dialogue: 0,0:10:16.63,0:10:17.97,DCMain,AYUMI,0,0,0,,!نجحت
Dialogue: 0,0:10:17.97,0:10:19.18,DCMain,CONAN,0,0,0,,يا إلهي
Dialogue: 0,0:10:19.87,0:10:22.07,DCMain,CONAN,0,0,0,,ماذا تفعلون؟
Dialogue: 0,0:10:22.07,0:10:23.47,DCMain,GENTA,0,0,0,,كونان
Dialogue: 0,0:10:23.47,0:10:26.04,DCMain,GENTA,0,0,0,,أرتنا المعلمة واكاسا للتو
Dialogue: 0,0:10:26.04,0:10:28.02,DCMain,MITSUHIKO,0,0,0,,ولذا كنا نجمعها
Dialogue: 0,0:10:28.72,0:10:30.02,DCMain,AYUMI,0,0,0,,انظر
Dialogue: 0,0:10:30.30,0:10:32.40,DCMain,AYUMI,0,0,0,,بلوط متوازن
Dialogue: 0,0:10:36.92,0:10:39.15,DCItalic,CONAN,0,0,0,,!فهمت.. هذه هي
Dialogue: 0,0:10:39.59,0:10:48.67,DCItalic,CONAN,0,0,0,,هذا ما استخدمه القاتل ليخدع أعيننا ويشعل الحريق طبيعيًا
Dialogue: 0,0:10:51.48,0:10:54.25,DCMain,DANNO,0,0,0,,ارحمنا يا حضرة المحقق
Dialogue: 0,0:10:54.58,0:10:58.01,DCMain,DANNO,0,0,0,,لسنا نحن من أضرمنا النيران في خيمة أوروشيبارا
Dialogue: 0,0:10:58.55,0:11:03.55,DCMain,DANNO,0,0,0,,،زرنا خيمته مرةً قبل أن تشتعل
Dialogue: 0,0:11:03.55,0:11:06.35,DCMain,DANNO,0,0,0,,ولكن لم يُجب أيًا منا
Dialogue: 0,0:11:06.57,0:11:11.96,DCMain,ASHIZAWA,0,0,0,,،علمنا أن أوروشيبارا في الداخل بما أننا رأينا ظله وهو يؤدي التمارين
Dialogue: 0,0:11:11.96,0:11:15.73,DCMain,ASHIZAWA,0,0,0,,ولكن لم يكن بمقدورنا إضرام النار من الداخل دون أن ندخل للخيمة
Dialogue: 0,0:11:16.00,0:11:22.37,DCMain,MIDORI,0,0,0,,وكان سحاب سديل الخيمة مقفلًا عليه، أليس كذلك؟
Dialogue: 0,0:11:22.57,0:11:26.28,DCMain,ASHIZAWA,0,0,0,,ألا يعني هذا أن الخيمة عبارة عن غرفة مقفلة؟
Dialogue: 0,0:11:26.28,0:11:28.99,DCMain,MIDORI,0,0,0,,كان أوروشيبارا ثملًا للغاية
Dialogue: 0,0:11:28.99,0:11:35.75,DCMain,DANNO,0,0,0,,ألا يحتمل أنه ثَمِل أثناء تأديته للتمارين وأسقط الفانوس؟
Dialogue: 0,0:11:36.00,0:11:41.68,DCMain,KURODA,0,0,0,,ولكن ماذا لو استخدمت الشمعات لصنع أداة إشعال تلقائية؟
Dialogue: 0,0:11:41.86,0:11:43.76,DCMain,ALL,0,0,0,,أداة إشعال تلقائية؟
Dialogue: 0,0:11:43.76,0:11:45.43,DCMain,DANNO,0,0,0,,هذا سخيف
Dialogue: 0,0:11:45.43,0:11:49.49,DCMain,MIDORI,0,0,0,,كان ليلاحظ وجود شيء كهذا بكل تأكيد
Dialogue: 0,0:11:49.49,0:11:51.69,DCMain,ASHIZAWA,0,0,0,,كان يؤدي التمارين
Dialogue: 0,0:11:52.17,0:11:56.73,DCMain,CONAN,0,0,0,,الأرجح أن أوروشيبارا كان ثملًا ونائمًا فعلًا في ذلك الوقت
Dialogue: 0,0:11:57.01,0:11:57.84,DCMain,DANNO,0,0,0,,ماذا؟
Dialogue: 0,0:11:57.84,0:12:00.41,DCMain,CONAN,0,0,0,,سأثبت لكم إن كنتم تظنونني كاذبًا
Dialogue: 0,0:12:01.32,0:12:09.58,DCMain,CONAN,0,0,0,,سأريكم كيف أجعل رجلًا نائمًا يؤدي التمارين وأشعل النار في خيمته
Dialogue: 0,0:12:18.24,0:12:20.02,DCMain,CONAN,0,0,0,,،في البداية
Dialogue: 0,0:12:20.63,0:12:23.76,DCMain,CONAN,0,0,0,,نضع سيخ بامبو نهاية شمعة
Dialogue: 0,0:12:24.12,0:12:27.72,DCMain,CONAN,0,0,0,,ثم نسكب قطرة شمع من شمعة أخرى عليه
Dialogue: 0,0:12:28.91,0:12:31.73,DCMain,CONAN,0,0,0,,ونلصق شمعتين معًا
Dialogue: 0,0:12:32.06,0:12:34.86,DCMain,CONAN,0,0,0,,ونحصر السيخ بينهما لنشكل خطًا مستقيمًا
Dialogue: 0,0:12:35.47,0:12:41.74,DCMain,CONAN,0,0,0,,،بعدها، وبما أننا صنعنا ثقبين في أعلى الشمعتين فوق الكتب
Dialogue: 0,0:12:42.34,0:12:46.41,DCMain,CONAN,0,0,0,,...إن وضعنا طرفي السيخ في الثقبين
Dialogue: 0,0:12:47.15,0:12:48.03,DCMain,CONAN,0,0,0,,أرأيتم؟
Dialogue: 0,0:12:48.03,0:12:50.46,DCMain,CONAN,0,0,0,,اكتملت أرجوحة الشمعة
Dialogue: 0,0:12:51.81,0:12:56.65,DCMain,CONAN,0,0,0,,ونشعل الآن كلا طرفي الشمعتين الملتصقتين ببعضيهما
Dialogue: 0,0:12:57.13,0:13:00.82,DCMain,CONAN,0,0,0,,يخف وزن الطرف الذي يحترق أسرع ويرتفع
Dialogue: 0,0:13:00.82,0:13:05.47,DCMain,CONAN,0,0,0,,وسيكون الطرف النازل معرضًا للكثير من النيران وهذا يجعله يُسقط المزيد من الشمع
Dialogue: 0,0:13:05.69,0:13:08.66,DCMain,CONAN,0,0,0,,ويصبح هذا الطرف أخف ويرتفع
Dialogue: 0,0:13:09.67,0:13:11.54,DCMain,CONAN,0,0,0,,...إن كررنا هذه العملية
Dialogue: 0,0:13:11.54,0:13:12.66,DCMain,GENTA,0,0,0,,مذهل
Dialogue: 0,0:13:12.66,0:13:13.92,DCMain,AYUMI,0,0,0,,هذا مثير جدًا
Dialogue: 0,0:13:13.92,0:13:16.98,DCMain,MITSUHIKO,0,0,0,,تتأرجح الشمعة للأمام وللخلف مثل البلوط المتوازن
Dialogue: 0,0:13:17.56,0:13:23.63,DCMain,CONAN,0,0,0,,،إن استخدمنا الكتب لاعتراض النار في جانب واحد
Dialogue: 0,0:13:24.19,0:13:27.11,DCMain,CONAN,0,0,0,,،فإن نارًا واحدة فقط ترتفع وتنزل
Dialogue: 0,0:13:27.58,0:13:29.70,DCMain,CONAN,0,0,0,,انظروا خلفكم
Dialogue: 0,0:13:30.62,0:13:33.66,DCMain,CONAN,0,0,0,,ترتفع ظلالنا على الخيمة وتنزل أيضًا
Dialogue: 0,0:13:34.07,0:13:36.37,DCMain,AYUMI,0,0,0,,أنت محق. تكبر وتتقلص
Dialogue: 0,0:13:36.37,0:13:38.25,DCMain,MITSUHIKO,0,0,0,,هذا مذهل
Dialogue: 0,0:13:38.49,0:13:39.66,DCMain,YUMIHIKO,0,0,0,,فهمت
Dialogue: 0,0:13:39.66,0:13:43.62,DCMain,YUMIHIKO,0,0,0,,،بعقد يدي الضحية خلف رأسه
Dialogue: 0,0:13:43.62,0:13:47.59,DCMain,YUMIHIKO,0,0,0,,،وإجلاسه على كرسي عديم الأرجل
Dialogue: 0,0:13:47.59,0:13:51.71,DCMain,YUMIHIKO,0,0,0,,،ووضع حقيبة كبيرة لتغطية الجزء السفلي من جسده
Dialogue: 0,0:13:51.71,0:13:57.14,DCMain,YUMIHIKO,0,0,0,,أصبح ظله يبدو وكأنه يؤدي التمارين باستخدام ارتفاع ونزول النار
Dialogue: 0,0:13:57.39,0:13:58.59,DCMain,KURODA,0,0,0,,،باختصار
Dialogue: 0,0:13:58.59,0:14:07.78,DCMain,KURODA,0,0,0,,‏‏‏‏‏‏‏‏‏‏‏‏‏‏‏‫شكل V الغريب على المجلة كان بسبب وضعها فوق الحاسب المحمول لاعتراض الضوء
Dialogue: 0,0:14:07.78,0:14:09.53,DCMain,KURODA,0,0,0,,وذلك من طرف واحد للشمعة
Dialogue: 0,0:14:09.53,0:14:14.66,DCMain,KURODA,0,0,0,,وكان الجزء الداخلي فقط معرضًا للنار عندما احترقت الخيمة
Dialogue: 0,0:14:14.93,0:14:19.44,DCMain,YUMIHIKO,0,0,0,,ماذا عن الشمعات الذائبة معًا إذًا؟
Dialogue: 0,0:14:19.44,0:14:23.68,DCMain,KURODA,0,0,0,,،الأرجح أن القاتل بعثرها أمام الأداة
Dialogue: 0,0:14:23.68,0:14:26.10,DCMain,KURODA,0,0,0,,وذلك حتى يخفي حقيقة خدعته
Dialogue: 0,0:14:26.10,0:14:27.42,DCMain,YUMIHIKO,0,0,0,,فهمت
Dialogue: 0,0:14:27.97,0:14:32.54,DCMain,KURODA,0,0,0,,،وأخيرًا، بإيقاعه الحاسب مستخدمًا الماء الذي أحضره لإطفاء النار
Dialogue: 0,0:14:32.54,0:14:35.68,DCMain,KURODA,0,0,0,,فإنه استطاع حرق الدليل الذي يشير لخدعته
Dialogue: 0,0:14:36.16,0:14:39.81,DCMain,DANNO,0,0,0,,أجل، ولكن كانت الشمعة تتحرك للأعلى والأسفل
Dialogue: 0,0:14:39.81,0:14:42.50,DCMain,MIDORI,0,0,0,,لن يتسبب ذلك بحرق أي شيء
Dialogue: 0,0:14:43.02,0:14:44.06,DCMain,CONAN,0,0,0,,بلى
Dialogue: 0,0:14:44.70,0:14:48.99,DCMain,CONAN,0,0,0,,مع مرور الوقت تصبح حركة الأداء أسرع
Dialogue: 0,0:14:49.51,0:14:52.60,DCMain,CONAN,0,0,0,,...إن وضعنا قماشًا قابلًا للاشتعال على الأرض
Dialogue: 0,0:14:54.96,0:14:56.41,DCMain,MITSUHIKO,0,0,0,,إنه يحترق
Dialogue: 0,0:15:02.72,0:15:04.90,DCMain,HAIBARA,0,0,0,,هذا خطير، ولذا لا تطبقوها في المنزل
Dialogue: 0,0:15:04.90,0:15:06.25,DCMain,ALL,0,0,0,,!حسنًا
Dialogue: 0,0:15:06.54,0:15:10.73,DCMain,YUMIHIKO,0,0,0,,...هذا يعني أن هذه الخدعة
Dialogue: 0,0:15:11.33,0:15:18.18,DCMain,YUMIHIKO,0,0,0,,،من ادّعت أن الإنارة كانت مطفأة حتى ينام الضحية عندما زارته، فوروكا ميدوري-سان
Dialogue: 0,0:15:18.69,0:15:22.09,DCMain,YUMIHIKO,0,0,0,,،ومن زار الخيمة بعد أن بدأ الضحية بأداء التمارين، دانو كونينوري-سان
Dialogue: 0,0:15:22.09,0:15:24.48,DCMain,YUMIHIKO,0,0,0,,لم يكن بوسعهما إعداد الخدعة
Dialogue: 0,0:15:24.67,0:15:29.90,DCMain,YUMIHIKO,0,0,0,,،هذا يعني أن من ادّعى أن الإنارة كانت مطفأة عندما زار الخيمة
Dialogue: 0,0:15:29.90,0:15:32.06,DCMain,YUMIHIKO,0,0,0,,،ولكن نظر للخلف أثناء مغادرته
Dialogue: 0,0:15:32.06,0:15:36.49,DCMain,YUMIHIKO,0,0,0,,...ورأى الضحية يشعل الأضواء ليتمرن
Dialogue: 0,0:15:36.67,0:15:40.75,DCMain,YUMIHIKO,0,0,0,,أنت الوحيد ولا غيرك يا آشيزاوا سوميتو-سان
Dialogue: 0,0:15:41.03,0:15:42.52,DCMain,DANNO,0,0,0,,حقًا؟
Dialogue: 0,0:15:42.52,0:15:44.42,DCMain,MIDORI,0,0,0,,هل هذا صحيح يا آشيزاوا؟
Dialogue: 0,0:15:44.61,0:15:46.49,DCMain,ASHIZAWA,0,0,0,,!كلا
Dialogue: 0,0:15:46.49,0:15:53.18,DCMain,ASHIZAWA,0,0,0,,كانت خيمة أوروشيبارا محكمة الإغلاق، أليس كذلك؟
Dialogue: 0,0:15:53.18,0:15:55.89,DCMain,ASHIZAWA,0,0,0,,أنى لي دخولها؟
Dialogue: 0,0:15:55.89,0:15:57.56,DCMain,KURODA,0,0,0,,الطين على مرفقك الأيمن
Dialogue: 0,0:15:57.71,0:15:58.55,DCMain,ASHIZAWA,0,0,0,,ماذا؟
Dialogue: 0,0:16:00.01,0:16:01.73,DCMain,KURODA,0,0,0,,متى تلطخت به؟
Dialogue: 0,0:16:03.80,0:16:05.74,DCMain,ASHIZAWA,0,0,0,,...هذا
Dialogue: 0,0:16:05.74,0:16:10.28,DCMain,KURODA,0,0,0,,،الأرجح أن هذا حدث عندما كان الضحية فاقدًا الوعي
Dialogue: 0,0:16:10.55,0:16:14.66,DCMain,KURODA,0,0,0,,،صنعت شقًا في الخيمة بأداة حادة
Dialogue: 0,0:16:14.66,0:16:21.54,DCMain,KURODA,0,0,0,,ولمست الأرض بمرفقك الأيمن أثناء مرورك للداخل
Dialogue: 0,0:16:21.83,0:16:23.09,DCMain,YUMINAGA,0,0,0,,فهمت
Dialogue: 0,0:16:23.09,0:16:27.19,DCMain,YUMINAGA,0,0,0,,وسيختفي أثر الشق بعد احتراق الخيمة
Dialogue: 0,0:16:27.19,0:16:31.38,DCMain,ASHIZAWA,0,0,0,,كلا، تلطختُ بالطين عندما تعثرت سابقًا
Dialogue: 0,0:16:31.38,0:16:34.95,DCMain,CONAN,0,0,0,,لماذا أزلت اللفافة الطبية من يدك اليمنى إذًا؟
Dialogue: 0,0:16:34.95,0:16:35.67,DCMain,ASHIZAWA,0,0,0,,ماذا؟
Dialogue: 0,0:16:36.09,0:16:39.87,DCMain,CONAN,0,0,0,,كانت هناك لفافة طبية على يده، أليس كذلك؟
Dialogue: 0,0:16:39.87,0:16:42.85,DCMain,GENTA,0,0,0,,أجل، على الإصبع السبابة
Dialogue: 0,0:16:43.00,0:16:45.42,DCMain,AYUMI,0,0,0,,رأيناها عندما كان يمسك مغرفة الكاري
Dialogue: 0,0:16:45.42,0:16:50.73,DCMain,MITSUHIKO,0,0,0,,وأظن أنه كانت هناك لفافة على إصبعي أوروشيبارا السبابة والوسطى اليمنيين
Dialogue: 0,0:16:51.46,0:16:54.23,DCMain,CONAN,0,0,0,,ماذا عن يد أوروشيبارا-سان اليسرى؟
Dialogue: 0,0:16:54.23,0:16:55.45,DCMain,ALL,0,0,0,,...حسنًا
Dialogue: 0,0:16:55.45,0:16:58.24,DCMain,HAIBARA,0,0,0,,لم تكن هناك أي لفافة على يده اليسرى
Dialogue: 0,0:17:04.05,0:17:10.25,DCMain,CONAN,0,0,0,,...ولكن كانت هناك لفافة على كلتا يدي جثة أوروشيبارا-سان المتفحمة، وهذا يعني
Dialogue: 0,0:17:13.25,0:17:17.61,DCMain,CONAN,0,0,0,,أن القاتل أزال لفافته الخاصة
Dialogue: 0,0:17:17.61,0:17:25.77,DCMain,CONAN,0,0,0,,ووضعها عليه ليبقي يدي أوروشيبارا-سان المُغمى عليه معقودة خلف رأسه
Dialogue: 0,0:17:28.83,0:17:30.64,DCMain,YUMINAGA,0,0,0,,،لو كان ذلك صحيحًا
Dialogue: 0,0:17:30.64,0:17:40.62,DCMain,YUMINAGA,0,0,0,,فقد نتمكن من العثور على بقايا جلدك وشعر\Nيحتوي على حمضك النووي على السطح اللزج من اللفافة على اليد اليمنى للجثة
Dialogue: 0,0:17:42.52,0:17:46.90,DCMain,YUMINAGA,0,0,0,,،إن كنتَ لم تتخلص من السكين الذي استخدمته لشق الخيمة
Dialogue: 0,0:17:46.90,0:17:50.78,DCMain,YUMINAGA,0,0,0,,فستكون بقايا ألياف خيمة الضحية موجودة عليه أيضًا
Dialogue: 0,0:17:53.94,0:17:57.26,DCMain,ASHIZAWA,0,0,0,,أجل، ما زال لدي
Dialogue: 0,0:18:01.30,0:18:02.56,DCMain,ASHIZAWA,0,0,0,,!تراجعوا
Dialogue: 0,0:18:02.88,0:18:04.81,DCMain,ASHIZAWA,0,0,0,,!سأطعنها إن اقتربتم مني
Dialogue: 0,0:18:05.22,0:18:06.18,DCMain,CONAN,0,0,0,,!آيومي-تشان
Dialogue: 0,0:18:08.92,0:18:10.33,DCMain,ASHIZAWA,0,0,0,,!هذا صحيح
Dialogue: 0,0:18:10.33,0:18:13.69,DCMain,ASHIZAWA,0,0,0,,!أنا من أحرقت خيمة أوروشيبارا
Dialogue: 0,0:18:14.56,0:18:16.25,DCMain,MIDORI,0,0,0,,!لكن لماذا؟
Dialogue: 0,0:18:16.25,0:18:19.09,DCMain,DANNO,0,0,0,,!لا سبب يدعوك لتكره أوروشيبارا
Dialogue: 0,0:18:19.09,0:18:23.70,DCMain,ASHIZAWA,0,0,0,,ولكنه يعلم سرّي
Dialogue: 0,0:18:23.70,0:18:24.62,DCMain,MIDORI,0,0,0,,سرّ؟
Dialogue: 0,0:18:24.62,0:18:25.82,DCMain,ASHIZAWA,0,0,0,,أجل
Dialogue: 0,0:18:25.82,0:18:30.48,DCMain,ASHIZAWA,0,0,0,,أنا من طلب من أوروشيبارا أن يؤذي دانو
Dialogue: 0,0:18:30.48,0:18:33.63,DCMain,ASHIZAWA,0,0,0,,وذلك حتى أستطيع اللعب
Dialogue: 0,0:18:33.83,0:18:35.34,DCMain,DANNO,0,0,0,,ماذا؟
Dialogue: 0,0:18:35.70,0:18:40.89,DCMain,ASHIZAWA,0,0,0,,،لم أتوقع أن تنهي تلك الإصابة مسيرته
Dialogue: 0,0:18:40.89,0:18:43.14,DCMain,ASHIZAWA,0,0,0,,ولكنه كان مصدر تهديد مستمر لي
Dialogue: 0,0:18:43.63,0:18:45.69,DCMain,ASHIZAWA,0,0,0,,،عندما ذهبت لخيمته اليوم
Dialogue: 0,0:18:45.69,0:18:48.96,DCMain,ASHIZAWA,0,0,0,,،تمتم وهو ثمل
Dialogue: 0,0:18:48.96,0:18:51.55,DCMain,ASHIZAWA,0,0,0,,"،إن كنتَ لا تريدني أن أفضح سرك"
Dialogue: 0,0:18:51.55,0:18:55.65,DCMain,ASHIZAWA,0,0,0,,"فعليك أن تدفع لي الكثير من المال عندما تحترف"
Dialogue: 0,0:18:56.03,0:18:58.83,DCMain,ASHIZAWA,0,0,0,,،وبما أنه توقف عن إجابتي
Dialogue: 0,0:18:58.83,0:19:02.54,DCMain,ASHIZAWA,0,0,0,,دخلت خيمته وجهزت الخدعة
Dialogue: 0,0:19:02.54,0:19:08.45,DCMain,ASHIZAWA,0,0,0,,ولحسن حظي كانت كل الأشياء التي احتجت إليها في الداخل
Dialogue: 0,0:19:09.75,0:19:11.81,DCMain,ASHIZAWA,0,0,0,,ولكنها النهاية الآن
Dialogue: 0,0:19:11.81,0:19:14.11,DCMain,ASHIZAWA,0,0,0,,هناك جرف في الغابة
Dialogue: 0,0:19:14.11,0:19:16.25,DCMain,ASHIZAWA,0,0,0,,،لا أريد أن أموت وحدي
Dialogue: 0,0:19:16.25,0:19:20.26,DCMain,ASHIZAWA,0,0,0,,ولذا لنقفز معًا أيتها الطفلة
Dialogue: 0,0:19:26.29,0:19:27.02,DCMain,GENTA,0,0,0,,!آيومي
Dialogue: 0,0:19:27.02,0:19:29.23,DCMain,MITSUHIKO,0,0,0,,!تماسكي يا آيومي-تشان
Dialogue: 0,0:19:29.48,0:19:32.91,DCMain,HAIBARA,0,0,0,,استخدم ساعتك المخدرة وكرة القدم بسرعة
Dialogue: 0,0:19:32.91,0:19:35.05,DCMain,CONAN,0,0,0,,إنهما بداخل خيمتنا
Dialogue: 0,0:19:40.03,0:19:42.24,DCMain,YUMINAGA,0,0,0,,...مهلًا، أنت
Dialogue: 0,0:19:43.95,0:19:45.55,DCMain,ASHIZAWA,0,0,0,,!تراجعي
Dialogue: 0,0:19:45.55,0:19:48.24,DCMain,WAKASA,0,0,0,,اترك تلميذتي وشأنها
Dialogue: 0,0:19:48.47,0:19:50.78,DCMain,ASHIZAWA,0,0,0,,!قلت لك تراجعي
Dialogue: 0,0:19:50.78,0:19:52.25,DCMain,WAKASA,0,0,0,,سأكرر ما قلتُه مجددًا
Dialogue: 0,0:19:52.47,0:19:55.25,DCMain,WAKASA,0,0,0,,اترك تلميذتي وشأنها
Dialogue: 0,0:19:57.14,0:19:59.88,DCMain,WAKASA,0,0,0,,...إن رفضتَ ذلك
Dialogue: 0,0:20:02.17,0:20:03.51,DCMain,WAKASA,0,0,0,,اطعنها
Dialogue: 0,0:20:05.26,0:20:06.14,DCMain,WAKASA,0,0,0,,هيا
Dialogue: 0,0:20:06.56,0:20:08.01,DCMain,WAKASA,0,0,0,,اطعنها
Dialogue: 0,0:20:08.55,0:20:11.90,DCMain,WAKASA,0,0,0,,كما فعلت عندما شققت الخيمة بالسكين
Dialogue: 0,0:20:12.51,0:20:13.90,DCMain,WAKASA,0,0,0,,افعلها
Dialogue: 0,0:20:14.11,0:20:15.90,DCMain,WAKASA,0,0,0,,...أم تريدني
Dialogue: 0,0:20:17.07,0:20:19.19,DCMain,WAKASA,0,0,0,,أن أساعدك؟
Dialogue: 0,0:20:33.44,0:20:34.33,DCMain,WAKASA,0,0,0,,!يوشيدا-سان
Dialogue: 0,0:20:34.33,0:20:36.08,DCMain,WAKASA,0,0,0,,!استيقظي يا يوشيدا-سان
Dialogue: 0,0:20:36.67,0:20:38.27,DCMain,WAKASA,0,0,0,,هل أنت بخير يا يوشيدا-سان؟
Dialogue: 0,0:20:38.27,0:20:39.07,DCMain,WAKASA,0,0,0,,هل يمكنك سماعي؟
Dialogue: 0,0:20:39.07,0:20:41.09,DCMain,WAKASA,0,0,0,,!أنا معلمتك! يوشيدا-سان
Dialogue: 0,0:20:45.39,0:20:46.48,DCMain,AYUMI,0,0,0,,معلمتي
Dialogue: 0,0:20:47.84,0:20:49.52,DCMain,AYUMI,0,0,0,,!كنتُ خائفة للغاية
Dialogue: 0,0:20:49.52,0:20:50.47,DCMain,AYUMI,0,0,0,,!معلمتي
Dialogue: 0,0:20:53.28,0:20:58.57,DCMain,KURODA,0,0,0,,شكرًا أيتها المعلمة واكاسا لأنك جذبت انتباه القاتل
Dialogue: 0,0:20:58.57,0:21:02.70,DCMain,YUMINAGA,0,0,0,,،إن سمحنا بطعن طفلة أمام أعيننا
Dialogue: 0,0:21:02.70,0:21:06.29,DCMain,YUMINAGA,0,0,0,,فسنُطرد أنا والضابط المسؤول شر طردة
Dialogue: 0,0:21:06.29,0:21:07.49,DCMain,WAKASA,0,0,0,,العفو
Dialogue: 0,0:21:07.81,0:21:12.50,DCMain,KURODA,0,0,0,,لكنني لم أتمكن من سماع ما قلتِه له لجذب انتباهه
Dialogue: 0,0:21:12.77,0:21:15.00,DCMain,WAKASA,0,0,0,,يا إلهي.. حقًا؟
Dialogue: 0,0:21:31.81,0:21:37.82,ED Tr,,0,0,0,,{\blur2}أقع في الحب كما كان مُقدرًا لي
Dialogue: 0,0:21:38.15,0:21:43.16,ED Tr,,0,0,0,,{\blur2}وجهك الباسم واليدان الصغيرتان
Dialogue: 0,0:21:43.53,0:21:49.62,ED Tr,,0,0,0,,{\blur2}اليوم وأكثر من الأمسِ وغدًا وحتى اليوم
Dialogue: 0,0:21:49.87,0:21:55.05,ED Tr,,0,0,0,,{\blur2}سنحظى بالسعادة بلا شك
Dialogue: 0,0:21:55.67,0:21:58.13,ED Tr,,0,0,0,,{\blur2}أرجوك حاولي أن تتذكري
Dialogue: 0,0:21:58.63,0:22:01.18,ED Tr,,0,0,0,,{\blur2}نحن الاثنان في المستقبل البعيد
Dialogue: 0,0:22:01.43,0:22:04.01,ED Tr,,0,0,0,,{\blur2}عندما تتجعد أيدينا
Dialogue: 0,0:22:04.31,0:22:09.19,ED Tr,,0,0,0,,{\blur2}وترتبط ببعض ونحن نتنزه
Dialogue: 0,0:22:09.56,0:22:15.15,ED Tr,,0,0,0,,{\blur2}والوجوه الباسمة تتراكم في الأيام التالية
Dialogue: 0,0:22:15.40,0:22:20.95,ED Tr,,0,0,0,,{\blur2}أدرك أنك قدري
Dialogue: 0,0:22:21.28,0:22:26.87,ED Tr,,0,0,0,,{\blur2}حلمتُ بذلك ربيعًا وصيفًا وخريفًا وشتاءً
Dialogue: 0,0:22:27.12,0:22:32.75,ED Tr,,0,0,0,,{\blur2}سنظل معًا للأبد.. للأبد
Dialogue: 0,0:22:33.00,0:22:38.67,ED Tr,,0,0,0,,{\blur2}هذا الحلم عزيز علي
Dialogue: 0,0:22:38.96,0:22:47.06,ED Tr,,0,0,0,,{\blur2\fad(0,1700)}وسأجعلك سعيدة
Dialogue: 0,0:22:55.65,0:22:57.52,DCMain,CONAN,0,0,0,,هل رأيتِ ذلك يا هايبارا؟
Dialogue: 0,0:22:57.92,0:22:58.85,DCMain,HAIBARA,0,0,0,,ماذا؟
Dialogue: 0,0:22:59.14,0:23:03.88,DCMain,CONAN,0,0,0,,وجه القاتل قبل أن يعتقله الضابط المسؤول كورودا
Dialogue: 0,0:23:03.88,0:23:06.94,DCMain,HAIBARA,0,0,0,,أجل، كان وجهه ملتويًا
Dialogue: 0,0:23:07.48,0:23:11.74,DCMain,HAIBARA,0,0,0,,ربما استولى عليه طيف معلمة تسعى لإنقاذ تلميذتها
Dialogue: 0,0:23:12.03,0:23:15.16,DCMain,CONAN,0,0,0,,ألم تلاحظي عينها اليمنى؟
Dialogue: 0,0:23:15.43,0:23:19.34,DCMain,HAIBARA,0,0,0,,المعلمة واكاسا تعجبني لعلمك فقط
Dialogue: 0,0:23:19.78,0:23:21.67,DCMain,HAIBARA,0,0,0,,إياك واحتقارها
Dialogue: 0,0:23:21.97,0:23:22.88,DCMain,CONAN,0,0,0,,!ماذا؟
Dialogue: 0,0:23:33.91,0:23:35.97,DCItalic,CONAN,0,0,0,,هناك طين على جيبها
Dialogue: 0,0:23:36.52,0:23:37.91,DCItalic,CONAN,0,0,0,,أرى شكلًا
Dialogue: 0,0:23:40.30,0:23:42.50,DCItalic,CONAN,0,0,0,,ما هذا؟
Dialogue: 0,0:23:44.98,0:24:09.01,DCEpPreview,TEXT,0,0,0,,الحلقة القادمة
Dialogue: 0,0:23:45.44,0:23:47.22,DCMain,,0,0,0,,،لا شك أنك لم تنسَ يا موري-كن
Dialogue: 0,0:23:47.62,0:23:51.73,DCMain,,0,0,0,,عن المتاعب التي تسببتَ بها عندما عملت تحت قيادتي في التحقيقات
Dialogue: 0,0:23:52.42,0:23:54.24,DCMain,,0,0,0,,...حضرة المفتش
Dialogue: 0,0:23:54.71,0:23:57.97,DCMain,,0,0,0,,!لهذا أطلب منك المساعدة
Dialogue: 0,0:23:58.55,0:24:02.49,DCItalic,,0,0,0,,كان مايهاما ريوجي يهدد تينياما هيدي-سان في ساساغو-تشو
Dialogue: 0,0:24:02.49,0:24:06.57,DCMain,,0,0,0,,سيكون علينا إسقاط التهم في هذا الحال
Dialogue: 0,0:24:06.57,0:24:09.00,DCMain,,0,0,0,,!رغم علمنا أنه الفاعل
Dialogue: 0,0:24:09.01,0:24:15.01,DCNextEp,TEXT,0,0,0,,{\pos(664,171)\blur5}طلب عمل من المفتش ميغوري
Dialogue: 0,0:24:09.57,0:24:14.16,DCMain,CONAN,0,0,0,,في الحلقة القادمة من كونان: طلب عمل من المفتش ميغوري
Dialogue: 0,0:24:30.03,0:24:34.95,Hint,TEXT,0,0,0,,{\pos(646,654)}إنذار
Dialogue: 0,0:24:30.34,0:24:32.88,DCMain,WAKASA,0,0,0,,!تلميح كونان القادم
Dialogue: 0,0:24:33.42,0:24:34.72,DCMain,CONAN,0,0,0,,!إنذار
