Dialogue: 0,0:00:00.00,0:00:05.00,Title,,0,0,0,,{\blur2\fs45\c&H604A58&\3c&HFFFFFF&\pos(1240,16)}آل فانتوم\N{\fs45\fnEgg}ALPhantom
Dialogue: 0,0:00:00.94,0:00:03.48,Default,CONAN,0,0,0,,،بدعوَةٍ من هاتوري هيجي و توياما كازوها
Dialogue: 0,0:00:03.86,0:00:06.51,Default,CONAN,0,0,0,,أتينا أنا و ران إلى قرية يادوري في مُقاطعة شيزوكا
Dialogue: 0,0:00:06.51,0:00:09.78,Default,CONAN,0,0,0,,.للمُساعدة في استخراج كنز توكوغاوا المَدفون
Dialogue: 0,0:00:11.48,0:00:13.15,Default,CONAN,0,0,0,,...مع ذلك، في تلك اللّيلة
Dialogue: 0,0:00:13.87,0:00:15.08,Default,HEIJI,0,0,0,,.يُوجد نورٌ في الخارج
Dialogue: 0,0:00:16.38,0:00:17.18,Default,HEIJI,0,0,0,,ماذا يحصل؟
Dialogue: 0,0:00:19.38,0:00:21.62,Default,HEIJI,0,0,0,,!يُوجد حريقٌ أمام الفُندق
Dialogue: 0,0:00:21.62,0:00:22.50,Default,BOTH,0,0,0,,ماذا؟
Dialogue: 0,0:00:25.02,0:00:27.04,Default,HEIJI,0,0,0,,من أمكنه فِعل هذا؟
Dialogue: 0,0:00:27.50,0:00:29.28,Default,HAJIME,0,0,0,,...هـ-هذا نوي
Dialogue: 0,0:00:30.32,0:00:33.30,Default,HAJIME,0,0,0,,.أتى النوي في غيمةٍ من الدّخان الأسود
Dialogue: 0,0:00:33.71,0:00:36.56,Default,HEIJI,0,0,0,,...أيّها الغبيّ! من المُستحيل لشيءٍ كهذا
Dialogue: 0,0:00:36.56,0:00:38.90,Default,KAZUHA,0,0,0,,...هـ-هيجي! أُنظر
Dialogue: 0,0:00:51.65,0:00:55.61,Default,CONAN,0,0,0,,...بعد مُلاحقة الوَحش، وَجدنا
Dialogue: 0,0:00:56.29,0:00:57.28,Default,CONAN,0,0,0,,دِماء؟
Dialogue: 0,0:01:03.45,0:01:05.09,Default,HEIJI,0,0,0,,!هذا سوميجي سان
Dialogue: 0,0:01:05.54,0:01:06.98,Default,HEIJI,0,0,0,,هل هو فاقدٌ الوَعي؟
Dialogue: 0,0:01:07.53,0:01:10.00,Default,CONAN,0,0,0,,.كلّا، لَقد مات بالفِعل
Dialogue: 0,0:01:10.48,0:01:15.26,Default,CONAN,0,0,0,,.مع وُجود خُدوشٍ على ظهره كما لَو أنّ وَحشاً برّيّاً قد هاجمه
Dialogue: 0,0:01:20.84,0:01:22.85,Default,CONAN,0,0,0,,!ترتفع السّتائر بينما يَظهر مُتصدّر العناوين
Dialogue: 0,0:01:22.85,0:01:25.38,Default,CONAN,0,0,0,,!يرقص بجمالٍ بخُطوات حلّه للغُموض
Dialogue: 0,0:01:25.38,0:01:26.68,Default,CONAN,0,0,0,,هل هو النوي أو شيءٌ آخر؟
Dialogue: 0,0:01:26.68,0:01:29.65,Default,CONAN,0,0,0,,.الخُدوش الضّخمة تدفع لمُواصلة البحث في أمر غُموض الكنز المَدفون
Dialogue: 0,0:01:29.65,0:01:33.48,Default,CONAN,0,0,0,,،يُظهر الحقيقة الوَحيدة دائماً بجسد طفلٍ و عقل بالغ
Dialogue: 0,0:01:33.48,0:01:35.74,Default,CONAN,0,0,0,,!إسمه المُتحرّي كونان
Dialogue: 0,0:03:15.96,0:03:21.97,Title,EPTITLE,0,0,0,,{\fad(402,1)\pos(1084,152)}"!أُسطورة النوي لكونان و هيجي، فصل الخدش"
Dialogue: 0,0:03:16.59,0:03:20.44,Default,CONAN,0,0,0,,"!أُسطورة النوي لكونان و هيجي، فصل الخدش"
Dialogue: 0,0:03:26.20,0:03:27.64,Default,RAN,0,0,0,,لَـ-لَقد مات؟
Dialogue: 0,0:03:27.94,0:03:29.14,Default,RAN,0,0,0,,مات سوميجي سان؟
Dialogue: 0,0:03:29.14,0:03:30.70,Default,KAZUHA,0,0,0,,حـ-حقّاً؟
Dialogue: 0,0:03:30.70,0:03:31.47,Default,HEIJI,0,0,0,,.نعم
Dialogue: 0,0:03:32.08,0:03:35.77,Default,HEIJI,0,0,0,,.وَجدناه عند الأشجار بجانب البُحيرة المُجاورة للفُندق
Dialogue: 0,0:03:36.11,0:03:39.90,Default,HEIJI,0,0,0,,.تمّ قتلُه، مع وُجود علاماتٍ لخُدوشٍ ضخمةٍ على ظهره
Dialogue: 0,0:03:40.10,0:03:40.95,Default,FUMIE,0,0,0,,{\an8}ماذا؟
Dialogue: 0,0:03:40.24,0:03:45.28,Caracters,TEXT,0,0,0,,{\fad(250,1)\pos(606,601)}ماسوكو فومي (46) عاماً\Nمُؤلّفة
Dialogue: 0,0:03:40.95,0:03:46.83,Default,FUMIE,0,0,0,,{\an8}لَـ-لَم تبدو كعلامات آثار مَخالِب نمِر، صحيح؟
Dialogue: 0,0:03:46.83,0:03:50.08,Default,CONAN,0,0,0,,.كلّا، كانت أكبر
Dialogue: 0,0:03:50.08,0:03:52.79,Default,CONAN,0,0,0,,.كانت 4 خُدوشٍ على بُعد 10 سنتمتر عن بعضها
Dialogue: 0,0:03:54.06,0:03:56.53,Default,FUMIE,0,0,0,,.لا-لابدّ من أنّكَ تمزح
Dialogue: 0,0:03:56.53,0:03:58.69,Default,HAJIME,0,0,0,,.هذه لَيست مزحة
Dialogue: 0,0:03:59.35,0:04:00.90,Default,HAJIME,0,0,0,,{\an8}.إنّه النوي
Dialogue: 0,0:03:59.38,0:04:04.34,Caracters,TEXT,0,0,0,,{\fad(250,222)\pos(450,591)}تسوروما هاجيمي (22) عاماً\Nكاتبٌ وَثائقيّ
Dialogue: 0,0:04:00.90,0:04:03.80,Default,HAJIME,0,0,0,,{\an8}.قتلَه الوَحش الضّخم
Dialogue: 0,0:04:03.80,0:04:06.52,Default,HAJIME,0,0,0,,{\an8}.يُقال بأنّ النوي يملك أقدام نمِر
Dialogue: 0,0:04:07.01,0:04:10.52,Caracters,TEXT,0,0,0,,{\fad(250,1)\pos(1058,598)}تانزاوا ميتشيكي (62) عاماً\Nعالِم آثار
Dialogue: 0,0:04:07.42,0:04:10.52,Default,MICHIKI,0,0,0,,.ظننتُها كانت الجّرار، لكن للوَحش وُجودٌ حقّاً
Dialogue: 0,0:04:11.23,0:04:12.02,Default,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,0:04:12.61,0:04:14.65,Default,MICHIKI,0,0,0,,.لا شيء. كنتُ أتحدّث إلى نفسي فقط
Dialogue: 0,0:04:15.70,0:04:16.90,Default,HEIJI,0,0,0,,...ظنّها كانت
Dialogue: 0,0:04:16.90,0:04:18.40,Default,CONAN,0,0,0,,الجّرار؟...
Dialogue: 0,0:04:18.82,0:04:21.02,Default,HEIJI,0,0,0,,إذاً، هل اتّصلتُما بالشّرطة؟
Dialogue: 0,0:04:21.02,0:04:23.30,Default,RAN,0,0,0,,.نعم، فعلنا
Dialogue: 0,0:04:23.30,0:04:27.04,Default,KAZUHA,0,0,0,,.بما أنّنا في الجّبال، قالوا بأنّه لا يُمكنهم الوُصول بالحال
Dialogue: 0,0:04:27.04,0:04:31.29,Default,KAZUHA,0,0,0,,.لكن لا أظنّ أنّ بمَقدور الشّرطة التّعامل مع مثل هذا الوَحش
Dialogue: 0,0:04:31.46,0:04:33.15,Default,CONAN,0,0,0,,.لا تقلَقي
Dialogue: 0,0:04:33.15,0:04:36.33,Default,CONAN,0,0,0,,.من المُستحيل أن يكون الوَحش حقيقيّاً
Dialogue: 0,0:04:37.02,0:04:38.90,Default,HEIJI,0,0,0,,.لابدّ من أنّها كانت خِدعةً من نوعٍ ما
Dialogue: 0,0:04:39.34,0:04:42.30,Default,HEIJI,0,0,0,,.أشتمّ رائحة كيروسين في هذه الحُروق أيضاً
Dialogue: 0,0:04:42.30,0:04:46.35,Default,HAJIME,0,0,0,,لكنّكما وَجدتّما خُدوشاً ضخمةً على الجُثّة، صحيح؟
Dialogue: 0,0:04:46.35,0:04:51.23,Default,HEIJI,0,0,0,,،هربَ سوميجي سان من مُهاجمه على الأرجح بعد أن تمّ طعنه في ظهره
Dialogue: 0,0:04:51.23,0:04:53.08,Default,HEIJI,0,0,0,,،لكنّه انهار من الإرهاق
Dialogue: 0,0:04:53.08,0:04:56.85,Default,HEIJI,0,0,0,,.و صنع الجّاني جُرحاً طويلاً فوق الجّرح الأساسيّ
Dialogue: 0,0:04:57.12,0:05:01.73,Default,HEIJI,0,0,0,,.و بعدها أضاف ثلاثةً آخرين ليبدو كما لَو أنّ النوي هاجمه
Dialogue: 0,0:05:02.27,0:05:07.10,Default,HEIJI,0,0,0,,.العُمدة الذي دعا سوميجي سان إلى هُنا هو على الأرجح الوَحيد القادر على فِعل هذا
Dialogue: 0,0:05:07.10,0:05:08.45,Default,DENSUKE,0,0,0,,.أوه، لا
Dialogue: 0,0:05:08.70,0:05:14.16,Caracters,TEXT,0,0,0,,{\fad(250,250)\pos(632,593)}تاكيكوما دينسكي (58) عاماً\Nعُمدة قرية يادوري
Dialogue: 0,0:05:08.78,0:05:11.70,Default,DENSUKE,0,0,0,,{\an8}.في الوَاقع، طُلِب منّي دعوَة الجّميع من قِبَل شخصٍ غريب
Dialogue: 0,0:05:12.11,0:05:14.61,Default,DENSUKE,0,0,0,,{\an8}،إضافةً إلى دفتر المُلاحظات الذي أريتُه لكم وَقت وَجبة العشاء
Dialogue: 0,0:05:14.61,0:05:18.46,Default,DENSUKE,0,0,0,,تمّ أيضاً إرسال بعض النّقود إليّ و رسالةٌ تقول بأن أدعو أربعتهم
Dialogue: 0,0:05:18.46,0:05:22.57,Default,DENSUKE,0,0,0,,.ممّا سيُؤدّي إلى إعادة إحياء أُسطورة الكنز المَدفون و إعادة تنشيط القرية
Dialogue: 0,0:05:22.57,0:05:25.30,Default,DENSUKE,0,0,0,,.تمّ أيضاً إرفاق أربعة رسائل مُوَجّهةً لهم
Dialogue: 0,0:05:25.30,0:05:28.12,Default,DENSUKE,0,0,0,,.كان قُدومهم مُؤكّداً إن أرسلتُها
Dialogue: 0,0:05:28.12,0:05:32.68,Default,DENSUKE,0,0,0,,هل تذكر المُغلّف الإضافيّ في الرّسالة التي أرسلتُها لك؟
Dialogue: 0,0:05:32.68,0:05:33.74,Default,MICHIKI,0,0,0,,.نعم
Dialogue: 0,0:05:33.74,0:05:37.35,Default,HAJIME,0,0,0,,.رسالةٌ عن انهيار الكهف قبل 16 عاماً
Dialogue: 0,0:05:37.56,0:05:41.48,Default,FUMIE,0,0,0,,.من المُمكن أن تكون تكذِب
Dialogue: 0,0:05:42.00,0:05:43.80,Default,DENSUKE,0,0,0,,.لا أكذِب
Dialogue: 0,0:05:43.80,0:05:48.13,Default,DENSUKE,0,0,0,,.حدّدَت الرّسالة حتّى في أيّ فُندقٍ و الغُرَف التي يجب أن تُقيموا فيها
Dialogue: 0,0:05:48.13,0:05:49.72,Default,HEIJI,0,0,0,,...على أيّة حال
Dialogue: 0,0:05:50.90,0:05:53.27,Default,HEIJI,0,0,0,,.سنتحدّث حالَما تصل الشّرطة
Dialogue: 0,0:05:53.27,0:05:57.00,Default,HEIJI,0,0,0,,.حتّى وَقتها، ستبقون في غُرفكم
Dialogue: 0,0:05:58.29,0:06:02.75,Default,HEIJI,0,0,0,,.و سآخذ أيّ شيءٍ تملكونه و يُمكنه إصدار صوتٍ مثل هواتفكم
Dialogue: 0,0:06:02.75,0:06:05.23,Default,HEIJI,0,0,0,,لرُبّما أصدَر أحدٌ تلك الصّرخة الغريبة
Dialogue: 0,0:06:05.23,0:06:08.09,Default,HEIJI,0,0,0,,.باستخدامٍ جهازٍ من نوعٍ ما
Dialogue: 0,0:06:08.48,0:06:09.67,Default,RAN,0,0,0,,.إ-إنتظر لَحظة
Dialogue: 0,0:06:10.32,0:06:15.78,Default,RAN,0,0,0,,...إن كانت غُرَف الجّميع مُحدّدةً كما قال العُمدة
Dialogue: 0,0:06:16.18,0:06:18.89,Default,KAZUHA,0,0,0,,.رُبّما يُوجد شيءٌ في الغُرَف
Dialogue: 0,0:06:18.89,0:06:25.07,Default,RAN,0,0,0,,.كان الأجنبيّ الذي مات بانهيار الكهف هو من استخدَم غُرفتنا
Dialogue: 0,0:06:25.07,0:06:27.95,Default,KAZUHA,0,0,0,,.أتمنّى لَو يستبدل أحدهم غُرفته معنا
Dialogue: 0,0:06:27.95,0:06:29.63,Default,FUMIE,0,0,0,,حقّاً؟
Dialogue: 0,0:06:30.64,0:06:35.89,Default,RAN,0,0,0,,.نعم. دفتر المُلاحظات الذي استخدمه للتّدرّب على الهيراغانا كان في دُرج المَكتب
Dialogue: 0,0:06:36.26,0:06:39.57,Default,KAZUHA,0,0,0,,.كانت تُوجد دفاتر مُلاحظاتٍ أُخرى هناك أيضاً
Dialogue: 0,0:06:39.57,0:06:41.40,Default,FUMIE,0,0,0,,.كم هذا مُثيرٌ للإهتمام
Dialogue: 0,0:06:41.40,0:06:44.20,Default,FUMIE,0,0,0,,.سأكون على استعدادٍ لتبادل الغُرَف معكم
Dialogue: 0,0:06:44.20,0:06:45.06,Default,MICHIKI,0,0,0,,.كلّا
Dialogue: 0,0:06:45.88,0:06:48.38,Default,MICHIKI,0,0,0,,.سأبقى في الغُرفة
Dialogue: 0,0:06:48.82,0:06:52.40,Default,MICHIKI,0,0,0,,.لا يُمكنني السّماح للنّساء بأن تشعُرنَ بالفزع
Dialogue: 0,0:06:53.35,0:06:56.39,Default,HAJIME,0,0,0,,إذاً هل يُمكنني الإنتقال إلى غُرفةٍ في الطّابق الثّالث؟
Dialogue: 0,0:06:56.71,0:07:00.10,Default,HEIJI,0,0,0,,.لا أُمانع، لكن لا تخرجوا من غُرفكم على الإطلاق
Dialogue: 0,0:07:00.47,0:07:02.23,Default,HEIJI,0,0,0,,.إن فعل أحدكم، سأفترض بأنّه القاتِل
Dialogue: 0,0:07:05.43,0:07:06.98,Default,DENSUKE,0,0,0,,.فهمت، فهمت
Dialogue: 0,0:07:07.16,0:07:10.24,Default,DENSUKE,0,0,0,,.يُمكننا رُؤية غُرفهم جميعاً من هُنا
Dialogue: 0,0:07:10.24,0:07:14.54,Default,DENSUKE,0,0,0,,.و إن ظهرَ الوَحش ثانيةً، سنتمكّن من مُلاحقته و إبعاده
Dialogue: 0,0:07:14.54,0:07:17.50,Default,HEIJI,0,0,0,,لماذا أنتَ هُنا على أيّة حال؟
Dialogue: 0,0:07:17.50,0:07:19.00,Default,HEIJI,0,0,0,,.يجب أن تبقى في غُرفتك
Dialogue: 0,0:07:19.35,0:07:22.37,Default,CONAN,0,0,0,,.يُمكنكَ السّماح لنا بالتّعامل مع هذا
Dialogue: 0,0:07:22.61,0:07:25.23,Default,DENSUKE,0,0,0,,،كلّا على الإطلاق، لرُبّما تمّ إبلاغي لفِعل هذا
Dialogue: 0,0:07:25.23,0:07:28.27,Default,DENSUKE,0,0,0,,.لكنّني من دعا الجّميع إلى هُنا
Dialogue: 0,0:07:28.27,0:07:30.96,Default,DENSUKE,0,0,0,,.كالعُمدة، يجب أن أضمن سلامة الجّميع
Dialogue: 0,0:07:30.96,0:07:34.96,Default,HEIJI,0,0,0,,مهما يكُن. مادُمتَ هُنا، لِمَ لا تُخبرنا؟
Dialogue: 0,0:07:34.96,0:07:36.38,Default,DENSUKE,0,0,0,,أُخبركما بماذا؟
Dialogue: 0,0:07:36.38,0:07:38.27,Default,HEIJI,0,0,0,,.لماذا دعوتَ كلّ وَاحدٍ منهم
Dialogue: 0,0:07:39.32,0:07:42.64,Default,HEIJI,0,0,0,,ألَم يكُن هذا مَذكوراً في الرّسالة من الشّخص الغريب؟
Dialogue: 0,0:07:42.92,0:07:44.02,Default,DENSUKE,0,0,0,,.نعم
Dialogue: 0,0:07:44.53,0:07:47.15,Default,DENSUKE,0,0,0,,عالِم الآثار تانزاوا ميتشيكي سان يملك مَعرفةً
Dialogue: 0,0:07:47.77,0:07:50.94,Default,DENSUKE,0,0,0,,،عن جيولوجيّة شيزوكا
Dialogue: 0,0:07:50.94,0:07:54.28,Default,DENSUKE,0,0,0,,.و تفحّص هذه المنطقة مرّةً في الماضي
Dialogue: 0,0:07:54.95,0:07:59.63,Default,DENSUKE,0,0,0,,.إستخرَج آثاراً لَيس فقط في مُقاطعة شيزوكا، بل في جميع أنحاء الدّولة
Dialogue: 0,0:07:59.63,0:08:01.62,Default,DENSUKE,0,0,0,,،حتّى بضعة أعوام
Dialogue: 0,0:08:01.62,0:08:05.04,Default,DENSUKE,0,0,0,,.كان مَشهوراً كمُعلّقٍ في برنامجٍ تلفازيٍّ عن الآثار
Dialogue: 0,0:08:05.55,0:08:08.81,Default,DENSUKE,0,0,0,,على الرّغم من أنّه اختفى بالكامل بعد أن تمّ الشّكّ بأنّ
Dialogue: 0,0:08:08.81,0:08:11.04,Default,DENSUKE,0,0,0,,.فُخّارةً ما إستخرَجها كانت مُزيّفة
Dialogue: 0,0:08:12.00,0:08:14.69,Default,HEIJI,0,0,0,,ماذا بشأن المُؤلّفة؟
Dialogue: 0,0:08:14.69,0:08:17.26,Default,DENSUKE,0,0,0,,هل تعني بأنّكَ لا تعرف من هي ماسوكو فومي؟
Dialogue: 0,0:08:18.17,0:08:22.06,Default,DENSUKE,0,0,0,,.هي مَشهورةٌ بسبب قصصها الغامضة التي تتحدّث عن الوُحوش
Dialogue: 0,0:08:22.32,0:08:27.13,Default,DENSUKE,0,0,0,,.كمُؤلّفةٍ لمثل هذه الكُتب، من الطّبيعيّ امتلاكها المَعرفة عن الوُحوش اليابانيّة
Dialogue: 0,0:08:27.13,0:08:31.61,Default,DENSUKE,0,0,0,,عندما تمّ تصوير اقتباساتٍ تلفازيّةٍ عن أعمالها، غيّرَت مَواقع التّصوير
Dialogue: 0,0:08:31.61,0:08:35.24,Default,DENSUKE,0,0,0,,.و أعادَت دهن مَواقع التّصوير لأنّها لَم تتناسب مع رُؤيتها
Dialogue: 0,0:08:35.50,0:08:40.24,Default,DENSUKE,0,0,0,,.يبدو بأنّها تخرّجَت من جامعةٍ فنّيّة، لذا يُمكنني أن أرى لماذا هذا مُهمٌّ بالنّسبة لها
Dialogue: 0,0:08:41.52,0:08:44.85,Default,HEIJI,0,0,0,,.لا علاقة لهذا بكنز توكوغاوا المَدفون
Dialogue: 0,0:08:44.85,0:08:48.02,Default,DENSUKE,0,0,0,,،إ-إقترحَت الرّسالة استغلال النوي لإعادة تنشيط البلدة
Dialogue: 0,0:08:48.02,0:08:50.74,Default,DENSUKE,0,0,0,,.إن لَم ينجح الكنز المَدفون
Dialogue: 0,0:08:50.74,0:08:51.85,Default,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,0:08:51.85,0:08:53.46,Default,CONAN,0,0,0,,...نعم، لكن
Dialogue: 0,0:08:53.88,0:08:57.28,Default,CONAN,0,0,0,,الكاتب الوَثائقيّ لَيس مَشهوراً، صحيح؟
Dialogue: 0,0:08:57.28,0:08:58.60,Default,DENSUKE,0,0,0,,.هذا صحيح
Dialogue: 0,0:08:59.02,0:09:01.90,Default,DENSUKE,0,0,0,,القتيل سوميجي ياسوكاتسو سان
Dialogue: 0,0:09:01.90,0:09:06.10,Default,DENSUKE,0,0,0,,.كان مُؤرّخاً يملك مَعرفةً عن كنز توكوغاوا المَدفون مع ذلك
Dialogue: 0,0:09:08.02,0:09:11.33,Default,DENSUKE,0,0,0,,ذكرَت الرّسالة ببساطةٍ بأنّ تسوروما هاجيمي سان
Dialogue: 0,0:09:11.33,0:09:14.98,Default,DENSUKE,0,0,0,,.هو صحفيٌّ مُبتدئٌ يُسافر عبر البلاد لأجل قصص الوُحوش
Dialogue: 0,0:09:15.36,0:09:17.49,Default,DENSUKE,0,0,0,,.لا أعلَم عن السّبب لدعوَته أيضاً
Dialogue: 0,0:09:20.22,0:09:27.12,Default,HEIJI,0,0,0,,لكن لماذا لَم يُدعى النّاجون من إنهيار الكهف؟
Dialogue: 0,0:09:27.12,0:09:30.00,Default,HEIJI,0,0,0,,.لتمكّنّا من سُؤالهم المزيد عن الحادثة
Dialogue: 0,0:09:30.44,0:09:35.59,Default,DENSUKE,0,0,0,,.عـ-على ما يبدو، إختفوا جميعاً بعد الحادثة
Dialogue: 0,0:09:36.21,0:09:38.24,Default,DENSUKE,0,0,0,,.لا نعرف أسمائهم حتّى
Dialogue: 0,0:09:38.69,0:09:42.44,Default,CONAN,0,0,0,,إذاً لماذا دعوتَ هيجي ني تشان؟
Dialogue: 0,0:09:42.44,0:09:44.71,Default,DENSUKE,0,0,0,,طلبَت الرّسالة في الوَاقع أن أدعو
Dialogue: 0,0:09:44.71,0:09:47.89,Default,DENSUKE,0,0,0,,،أعظم مُتحرٍّ، موري كوغورو سان
Dialogue: 0,0:09:48.35,0:09:51.90,Default,DENSUKE,0,0,0,,.لكنّني استخدمتُ بعض النّقود لإجراء إصلاحاتٍ للفُندق
Dialogue: 0,0:09:52.20,0:09:56.51,Default,DENSUKE,0,0,0,,،في البداية فكّرتُ بدعوَة كودو شينتشي ساما من طوكيو
Dialogue: 0,0:09:56.51,0:10:00.00,Default,DENSUKE,0,0,0,,.لكنّني لَم أتمكّن من التّواصل معه، لذا دعوتُ هاتوري ساما من أوساكا بدلاً منه
Dialogue: 0,0:10:01.95,0:10:05.50,Default,HEIJI,0,0,0,,إذاً أنا هُنا لأنّكَ و المُسنّ لَم تتمكّنا من الحُضور؟
Dialogue: 0,0:10:05.50,0:10:06.83,Default,CONAN,0,0,0,,.أعتذر
Dialogue: 0,0:10:07.70,0:10:13.56,Default,HEIJI,0,0,0,,.ذكرَت رسالتكَ بأن أُحضِر صديقاتي
Dialogue: 0,0:10:13.56,0:10:16.84,Default,HEIJI,0,0,0,,هل كان هذا في الرّسالة من الشّخص الغريب أيضاً؟
Dialogue: 0,0:10:16.84,0:10:17.47,Default,DENSUKE,0,0,0,,.نعم
Dialogue: 0,0:10:17.80,0:10:23.16,Default,DENSUKE,0,0,0,,.ذكرَت الرّسالة دعوَة إبنة المُتحرّي موري أيضاً
Dialogue: 0,0:10:23.16,0:10:28.14,Default,DENSUKE,0,0,0,,.سيكون من الأفضل وُجود فتياتٍ شابّاتٍ  في فيديو البلدة التّرويجيّ
Dialogue: 0,0:10:28.51,0:10:31.15,Default,HEIJI,0,0,0,,.نجح هذا على ما أظنّ
Dialogue: 0,0:10:31.35,0:10:34.48,Default,CONAN,0,0,0,,.إذاً بشأن الأشجار المَوجودة أمام الفُندق
Dialogue: 0,0:10:35.03,0:10:37.80,Default,CONAN,0,0,0,,لماذا الشّجرة الوَحيدة في الحافّة اليُسرى تختلِف عن البقيّة؟
Dialogue: 0,0:10:37.80,0:10:38.71,Default,DENSUKE,0,0,0,,ماذا؟
Dialogue: 0,0:10:38.71,0:10:44.34,Default,CONAN,0,0,0,,،أُنظر. جميع الأشجار الأُخرى أمام الفُندق تملك قِمماً حادّة
Dialogue: 0,0:10:44.34,0:10:46.24,Default,CONAN,0,0,0,,.لكن إحداها فقط مُختلِفة
Dialogue: 0,0:10:46.48,0:10:47.62,Default,DENSUKE,0,0,0,,من يدري؟
Dialogue: 0,0:10:47.62,0:10:50.88,Default,DENSUKE,0,0,0,,.لَم آتي إلى هُنا منذ فترةٍ طويلة
Dialogue: 0,0:10:53.80,0:10:54.87,Default,HEIJI,0,0,0,,ما هذا؟
Dialogue: 0,0:10:55.38,0:10:59.29,Default,HEIJI,0,0,0,,.يُوجد ما يُشبه قِطعة قُماشٍ في نهاية هذه العصى المُحترقة
Dialogue: 0,0:11:00.66,0:11:03.21,Default,CONAN,0,0,0,,هل كانت هذه أمام الفُندق دائماً؟
Dialogue: 0,0:11:03.21,0:11:04.19,Default,DENSUKE,0,0,0,,من يدري؟
Dialogue: 0,0:11:04.19,0:11:05.22,Default,FUMIE,0,0,0,,!هاي
Dialogue: 0,0:11:05.85,0:11:07.61,Default,FUMIE,0,0,0,,.أخفضوا أصواتكم
Dialogue: 0,0:11:07.61,0:11:08.93,Default,DENSUKE,0,0,0,,.أ-أعتذر
Dialogue: 0,0:11:09.39,0:11:12.67,Default,FUMIE,0,0,0,,،كنتُ سآخذ قيلولةً قبل وُصول الشّرطة
Dialogue: 0,0:11:12.67,0:11:16.32,Default,FUMIE,0,0,0,,!لكن لا يُمكنني النّوم مع كلّ هذه الضجّة التي تُصدرونها
Dialogue: 0,0:11:16.32,0:11:18.12,Default,HAJIME,0,0,0,,.لا أُمانع
Dialogue: 0,0:11:19.02,0:11:22.56,Default,HAJIME,0,0,0,,،بعد كلّ شيء، أنا صحفيٌّ بلا مَوهبة
Dialogue: 0,0:11:22.56,0:11:24.57,Default,HAJIME,0,0,0,,.تمّت دعوَتي معكم أيّها المَشاهير جميعاً
Dialogue: 0,0:11:24.81,0:11:27.20,Default,HAJIME,0,0,0,,لَن أتمكّن من كتابة مقالاتٍ جيّدةٍ إلّا إن ضحّيتُ بالنّوم
Dialogue: 0,0:11:27.20,0:11:29.08,Default,HAJIME,0,0,0,,.لأُبقي عيناي و أُذناي مَفتوحة
Dialogue: 0,0:11:29.30,0:11:33.77,Default,HAJIME,0,0,0,,.إضافةً إلى هذا، لا يُمكن مَعرفة متى سيَظهر الوَحش
Dialogue: 0,0:11:39.13,0:11:40.42,Default,HEIJI,0,0,0,,.إنّها تلك الصّرخة ثانيةً
Dialogue: 0,0:11:41.02,0:11:42.30,Default,CONAN,0,0,0,,من أين تأتي؟
Dialogue: 0,0:11:43.65,0:11:44.34,Default,CONAN,0,0,0,,ماذا؟
Dialogue: 0,0:11:44.82,0:11:45.82,Default,HEIJI,0,0,0,,من أين أتى ذلك الحريق؟
Dialogue: 0,0:11:45.82,0:11:47.97,Default,CONAN,0,0,0,,.لا أعلَم. إشتعل فجأة
Dialogue: 0,0:11:56.65,0:11:57.76,Default,HAJIME,0,0,0,,.إنّه النوي
Dialogue: 0,0:11:57.76,0:12:00.99,Default,HAJIME,0,0,0,,!لَقد عاد الوَحش
Dialogue: 0,0:12:11.74,0:12:12.82,Default,HAJIME,0,0,0,,.إنّه النوي
Dialogue: 0,0:12:12.82,0:12:15.75,Default,HAJIME,0,0,0,,!لَقد عاد الوَحش
Dialogue: 0,0:12:19.37,0:12:21.88,Default,CONAN,0,0,0,,ما-ماذا كانت تلك الصّرخة؟
Dialogue: 0,0:12:22.22,0:12:25.22,Default,FUMIE,0,0,0,,.بدَت كصرخة تانزاوا سان من الغُرفة العُلويّة
Dialogue: 0,0:12:25.22,0:12:28.05,Default,HEIJI,0,0,0,,.تلك كانت الغُرفة التي كنّا نُقيم فيها بالأساس
Dialogue: 0,0:12:28.05,0:12:29.73,Default,CONAN,0,0,0,,.في النّهاية اليُسرى من الطّابق الثّالث
Dialogue: 0,0:12:30.56,0:12:31.56,Default,DENSUKE,0,0,0,,.هاي، إنتظرا
Dialogue: 0,0:12:31.84,0:12:33.98,Default,DENSUKE,0,0,0,,.لَن تتمكّنا من دُخولها دون المِفتاح الإحتياطيّ
Dialogue: 0,0:12:43.64,0:12:45.74,Default,HEIJI,0,0,0,,هاي، تانزاوا سان! ماذا حصل؟
Dialogue: 0,0:12:45.98,0:12:47.72,Default,HEIJI,0,0,0,,!هاي، تانزاوا سان
Dialogue: 0,0:12:47.72,0:12:49.15,Default,DENSUKE,0,0,0,,.إبتعدا رجاءً
Dialogue: 0,0:12:49.15,0:12:50.24,Default,DENSUKE,0,0,0,,.سـ-سأفتح الباب
Dialogue: 0,0:12:52.08,0:12:53.73,Default,HEIJI,0,0,0,,.تانزاوا سان، سندخل
Dialogue: 0,0:13:00.60,0:13:02.89,Default,HEIJI,0,0,0,,.لا فائدة. لَقد مات بالفِعل
Dialogue: 0,0:13:06.08,0:13:08.68,Default,CONAN,0,0,0,,.نُقطتان حمراوتان تحت ذقنه
Dialogue: 0,0:13:10.10,0:13:11.43,Default,CONAN,0,0,0,,هل عضّته أفعى؟
Dialogue: 0,0:13:11.90,0:13:14.43,Default,HEIJI,0,0,0,,هل هذا هو المِفتاح الإحتياطيّ الوَحيد لهذه الغُرفة؟
Dialogue: 0,0:13:14.43,0:13:16.19,Default,DENSUKE,0,0,0,,.نـ-نعم
Dialogue: 0,0:13:16.38,0:13:18.94,Default,CONAN,0,0,0,,.ممّا يعني بأنّها غُرفةٌ مُغلَقة
Dialogue: 0,0:13:19.43,0:13:22.93,Default,HEIJI,0,0,0,,هاي، لا تُخبرني
Dialogue: 0,0:13:23.73,0:13:25.82,Default,HEIJI,0,0,0,,.بأنّ للنوي وُجودٌ حقّاً
Dialogue: 0,0:13:32.51,0:13:35.58,Default,YOKOMIZO,0,0,0,,.شُكراً على انتظاركم جميعاً
Dialogue: 0,0:13:35.94,0:13:38.75,Default,YOKOMIZO,0,0,0,,.أنا يوكوميزو سانغو من شُرطة شيزوكا
Dialogue: 0,0:13:39.08,0:13:43.23,Default,YOKOMIZO,0,0,0,,.وِفقاً للإتّصال الذي استلمناه، لَقد رأيتُم وَحشاً ضخماً على ما يبدو
Dialogue: 0,0:13:43.23,0:13:45.84,Default,YOKOMIZO,0,0,0,,.لكن بوُجودي هُنا الآن، سيكون الأمر بخير
Dialogue: 0,0:13:45.84,0:13:48.64,Default,YOKOMIZO,0,0,0,,.سأحميكم من الوَحش المَذكور
Dialogue: 0,0:13:49.47,0:13:52.68,Default,HEIJI,0,0,0,,.مات شخصان بالفِعل مع ذلك
Dialogue: 0,0:13:53.04,0:13:56.17,Default,YOKOMIZO,0,0,0,,،وَاثقٌ من أنّها خِدعةٌ من نوعٍ ما
Dialogue: 0,0:13:56.17,0:14:00.94,Default,YOKOMIZO,0,0,0,,لكن لماذا لا تُخبرونا بما رأيتُموه عندما شاهدتّم الوَحش؟
Dialogue: 0,0:14:02.86,0:14:06.20,Default,KAZUHA,0,0,0,,،سمعنا صُراخاً غريباً
Dialogue: 0,0:14:06.20,0:14:08.95,Default,KAZUHA,0,0,0,,.و اشتعل الحريق بالعُشب أمام الفُندق
Dialogue: 0,0:14:09.22,0:14:12.33,Default,RAN,0,0,0,,...عندما خرجنا من خلف الجّدار
Dialogue: 0,0:14:13.02,0:14:14.90,Default,KAZUHA,0,0,0,,.ظهرَ وَحشٌ بأربعة أرجُل...
Dialogue: 0,0:14:14.90,0:14:18.83,Default,RAN,0,0,0,,.كان ضخماً جدّاً، وَصل طوله لنوَافذ الطّابق الثّاني
Dialogue: 0,0:14:19.12,0:14:21.25,Default,YOKOMIZO,0,0,0,,فهمت. و؟
Dialogue: 0,0:14:21.25,0:14:25.52,Default,YOKOMIZO,0,0,0,,هل رأيتُما خيطاً رفيعاً فوق الوَحش؟
Dialogue: 0,0:14:25.52,0:14:27.34,Default,KAZUHA,0,0,0,,.لَم نرى شيئاً من هذا القبيل
Dialogue: 0,0:14:27.34,0:14:28.41,Default,RAN,0,0,0,,.نعم
Dialogue: 0,0:14:28.41,0:14:29.38,Default,YOKOMIZO,0,0,0,,.فهمت
Dialogue: 0,0:14:29.38,0:14:32.52,Default,KAZUHA,0,0,0,,،لَيس هذا فقط، لكنّه عضّ اللّافتة أمامه
Dialogue: 0,0:14:32.52,0:14:34.89,Default,RAN,0,0,0,,.إنتزعها عن الأرض، و ابتعد معها
Dialogue: 0,0:14:35.06,0:14:38.17,Default,YOKOMIZO,0,0,0,,إنتزع اللّافتة و ابتعد معها؟
Dialogue: 0,0:14:38.17,0:14:41.24,Default,YOKOMIZO,0,0,0,,هل كانت اللّافتة بارتفاع 30 سنتمتر تقريباً؟
Dialogue: 0,0:14:41.24,0:14:42.71,Default,HEIJI,0,0,0,,.هذه هي اللّافتة
Dialogue: 0,0:14:42.71,0:14:43.19,Default,YOKOMIZO,0,0,0,,ماذا؟
Dialogue: 0,0:14:43.36,0:14:46.19,Default,CONAN,0,0,0,,.هل ترى؟ عليها آثار أسنان
Dialogue: 0,0:14:47.08,0:14:49.82,Default,YOKOMIZO,0,0,0,,.إ-إنّها ضخمةٌ بالفِعل
Dialogue: 0,0:14:50.07,0:14:54.48,Default,HEIJI,0,0,0,,.وَجدنا هذه اللّافتة على الأرض حيث ذهب الوَحش
Dialogue: 0,0:14:54.48,0:14:58.75,Default,CONAN,0,0,0,,.بجانب اللّافتة كانت آثارٌ من الدّماء تقود إلى البُحيرة
Dialogue: 0,0:14:58.75,0:15:00.33,Default,CONAN,0,0,0,,،عندما وَجدناها
Dialogue: 0,0:15:01.16,0:15:04.21,Default,HEIJI,0,0,0,,.وَجدنا جُثّة المُؤرّخ سوميجي سان
Dialogue: 0,0:15:04.90,0:15:08.21,Default,CONAN,0,0,0,,.بخُدوشٍ على ظهره
Dialogue: 0,0:15:08.49,0:15:11.67,Default,YOKOMIZO,0,0,0,,خُـ-خُدوش؟ مثل التي من قِطّة؟
Dialogue: 0,0:15:12.18,0:15:14.72,Default,HEIJI,0,0,0,,.هذه هي الصّور التي التقطناها للجُثّة
Dialogue: 0,0:15:15.05,0:15:18.91,Default,HEIJI,0,0,0,,هل ترى كيف أنّ الخُدوش بينها مسافة 10 سنتمتر؟
Dialogue: 0,0:15:18.91,0:15:20.39,Default,CONAN,0,0,0,,.لَم تكُن قِطّة
Dialogue: 0,0:15:20.70,0:15:22.72,Default,YOKOMIZO,0,0,0,,.أ-أنتَ مُحقّ
Dialogue: 0,0:15:23.17,0:15:25.76,Default,HEIJI,0,0,0,,طلَبنا من الجّميع أن يبقوا في غُرَفهم
Dialogue: 0,0:15:25.76,0:15:28.65,Default,HEIJI,0,0,0,,.حتّى وُصول الشّرطة
Dialogue: 0,0:15:29.02,0:15:33.57,Default,HEIJI,0,0,0,,.أخذنا هواتفهم حتّى لا يتمكّنوا من إنتاج أيّة أصواتٍ للإحتياط فقط
Dialogue: 0,0:15:33.57,0:15:41.00,Default,CONAN,0,0,0,,.كنّا نُراقب مكان ظُهور الوَحش مع العُمدة
Dialogue: 0,0:15:41.00,0:15:44.21,Default,CONAN,0,0,0,,،عندما سمعنا الصّراخ ثانيةً
Dialogue: 0,0:15:44.91,0:15:48.27,Default,CONAN,0,0,0,,،العُشب الذي أطفأناه مُسبقاً إشتعل بالحريق فجأة
Dialogue: 0,0:15:48.27,0:15:49.97,Default,CONAN,0,0,0,,.و استمرّ بالإنتشار
Dialogue: 0,0:15:50.67,0:15:53.89,Default,HEIJI,0,0,0,,بينما كنّا وَاقفين بصدمة، سمعنا صُراخ موت
Dialogue: 0,0:15:53.89,0:15:58.01,Default,HEIJI,0,0,0,,.عالِم الآثار تانزاوا سان من الغُرفة في نهاية الطّابق الثّالث
Dialogue: 0,0:15:58.01,0:15:59.53,Default,HEIJI,0,0,0,,،عندما ذهبنا إلى غُرفته
Dialogue: 0,0:15:59.98,0:16:02.85,Default,HEIJI,0,0,0,,.وَجدناه مُسموماً حتّى الموت في غُرفةٍ مُغلَقة
Dialogue: 0,0:16:03.58,0:16:07.61,Default,CONAN,0,0,0,,.هذه المرّة مع وُجود علامةٍ تحت ذقنه كما لَو أنّ أفعى قد عضّته
Dialogue: 0,0:16:07.82,0:16:09.50,Default,KAZUHA,0,0,0,,،بـ-بالتّفكير بالأمر
Dialogue: 0,0:16:09.50,0:16:12.92,Default,KAZUHA,0,0,0,,.رأينا ذيل الوَحش عندما غادر
Dialogue: 0,0:16:12.92,0:16:14.40,Default,RAN,0,0,0,,.نعم
Dialogue: 0,0:16:14.40,0:16:15.98,Default,RAN,0,0,0,,بدا كأفعى، صحيح؟
Dialogue: 0,0:16:15.98,0:16:16.78,Default,KAZUHA,0,0,0,,.نعم
Dialogue: 0,0:16:17.03,0:16:18.88,Default,YOKOMIZO,0,0,0,,كان ذيله أفعى؟
Dialogue: 0,0:16:18.88,0:16:21.31,Default,FUMIE,0,0,0,,أيّها الضّابط، سمعتَ عن النوي، صحيح؟
Dialogue: 0,0:16:21.66,0:16:25.37,Default,FUMIE,0,0,0,,،يملك رأس قِرد، جسد كلب راكون
Dialogue: 0,0:16:25.37,0:16:28.67,Default,FUMIE,0,0,0,,.أقدام نمِر، و ذيله أفعى
Dialogue: 0,0:16:28.87,0:16:30.54,Default,YOKOMIZO,0,0,0,,ا-النوي؟
Dialogue: 0,0:16:30.54,0:16:35.21,Default,HAJIME,0,0,0,,.الوَحش الأُسطوريّ الذي يظهر مع صرخةٍ غريبةٍ و غيمةٍ من الدّخان الأسود
Dialogue: 0,0:16:35.21,0:16:37.05,Default,YOKOMIZO,0,0,0,,أُ-أُسطوريّ؟
Dialogue: 0,0:16:37.30,0:16:38.97,Default,HAJIME,0,0,0,,ألَم تسمع عنه؟
Dialogue: 0,0:16:38.97,0:16:41.09,Default,YOKOMIZO,0,0,0,,.إهدأوا جميعاً
Dialogue: 0,0:16:41.09,0:16:45.60,Default,YOKOMIZO,0,0,0,,.تجعلون الأمر يبدو كما لَو أنّه قد تمّ إعادة إحياء الوَحش
Dialogue: 0,0:16:46.54,0:16:50.23,Default,YOKOMIZO,0,0,0,,لكن كان يُوجد في الماضي وَحشٌ يُعرَف بالنوي
Dialogue: 0,0:16:50.65,0:16:52.74,Default,YOKOMIZO,0,0,0,,.كان يُوجد في غابة كوروغاني
Dialogue: 0,0:16:52.92,0:16:53.99,Default,BOTH,0,0,0,,ماذا؟
Dialogue: 0,0:16:54.37,0:16:58.50,Default,YOKOMIZO,0,0,0,,كان يُوجد تقريرٌ من شاهد عيانٍ عن نوي
Dialogue: 0,0:16:58.50,0:17:00.37,Default,YOKOMIZO,0,0,0,,.قبل 16 عاماً
Dialogue: 0,0:17:00.37,0:17:01.79,Default,DENSUKE,0,0,0,,...نـ-نعم
Dialogue: 0,0:17:02.78,0:17:08.38,Default,DENSUKE,0,0,0,,الأجنبيّ من فريق التّنقيب الذي علِقَ بانهيار كهفٍ
Dialogue: 0,0:17:08.38,0:17:11.80,Default,DENSUKE,0,0,0,,.و كتب كلِمة "نوي" قبل أن يموت
Dialogue: 0,0:17:12.22,0:17:14.13,Default,DENSUKE,0,0,0,,...أخبرتُهم بالفِعل عن
Dialogue: 0,0:17:14.13,0:17:16.68,Default,YOKOMIZO,0,0,0,,.هل ترون؟ له وُجود
Dialogue: 0,0:17:16.95,0:17:21.60,Default,YOKOMIZO,0,0,0,,.كان النوي يختبئ في الغابة لـ16 عاماً
Dialogue: 0,0:17:22.26,0:17:27.28,Default,HEIJI,0,0,0,,.كودو، هذا الرّجل لا يختلِف عن شُرطيّ غونما الغير كفؤٍ ذاك
Dialogue: 0,0:17:27.28,0:17:28.35,Default,CONAN,0,0,0,,.نعم
Dialogue: 0,0:17:28.75,0:17:34.06,Default,YOKOMIZO,0,0,0,,.على أيّة حال، ستحميكم الشّرطة
Dialogue: 0,0:17:34.06,0:17:37.36,Default,YOKOMIZO,0,0,0,,.يجب أن تجتمعوا في غُرفةٍ وَاحدةٍ و أن تنتظروا هناك
Dialogue: 0,0:17:38.92,0:17:42.85,Default,YOKOMIZO,0,0,0,,سأتّصل مع مَسؤوليّ لأسأل
Dialogue: 0,0:17:42.85,0:17:44.66,Default,YOKOMIZO,0,0,0,,.إن أمكننا تحريك قوّات الدّفاع
Dialogue: 0,0:17:44.66,0:17:45.75,Default,HEIJI,0,0,0,,!حقّاً؟
Dialogue: 0,0:17:46.06,0:17:50.65,Default,DENSUKE,0,0,0,,.على أيّة حال، ظننتُها ستُمطِر، لكن لَم تفعل بعد
Dialogue: 0,0:17:50.65,0:17:52.51,Default,CONAN,0,0,0,,ماذا؟ لماذا؟
Dialogue: 0,0:17:52.51,0:17:57.66,Default,DENSUKE,0,0,0,,.في المرّة الثّانية التي اشتعلَت فيها الأعشاب بالحريق، سقطَت قطرة مَطرٍ على خدّي
Dialogue: 0,0:17:58.21,0:18:00.14,Default,DENSUKE,0,0,0,,ظننتُني سمعت
Dialogue: 0,0:18:00.14,0:18:05.14,Default,DENSUKE,0,0,0,,.صوت مَشروبٍ غازيٍّ يُفتح أيضاً
Dialogue: 0,0:18:05.29,0:18:06.90,Default,HEIJI,0,0,0,,مَشروبٌ غازيّ؟
Dialogue: 0,0:18:06.90,0:18:08.81,Default,FUMIE,0,0,0,,.لَم يكُن أنا
Dialogue: 0,0:18:09.06,0:18:12.73,Default,FUMIE,0,0,0,,طلبتُ نبيذاً أبيضاً و مياه صودا
Dialogue: 0,0:18:12.73,0:18:15.24,Default,FUMIE,0,0,0,,،لأتمكّن من خلطهما
Dialogue: 0,0:18:15.76,0:18:18.82,Default,FUMIE,0,0,0,,،لكن إن سكبتُها من نافذتي
Dialogue: 0,0:18:18.82,0:18:21.95,Default,FUMIE,0,0,0,,.لَم يكُن العُمدة ليكون الوَحيد الذي تبلّل
Dialogue: 0,0:18:22.36,0:18:27.55,Default,FUMIE,0,0,0,,.إضافةً إلى أنّه على خِلافه، أملك رُقيّاً أكبر من الشّرب من على عتبة النّافذة
Dialogue: 0,0:18:27.55,0:18:29.58,Default,HAJIME,0,0,0,,.أعتذر لأنّني مُتدنّي المُستوى
Dialogue: 0,0:18:29.58,0:18:32.76,Default,HAJIME,0,0,0,,.تخلّى عنّي وَالِداي خلال طُفولَتي
Dialogue: 0,0:18:32.76,0:18:35.13,Default,HAJIME,0,0,0,,.لَم تتمّ تربيَتي بشكلٍ جيّد
Dialogue: 0,0:18:35.42,0:18:38.24,Default,HAJIME,0,0,0,,.لَم تكُن المياه منّي أيضاً
Dialogue: 0,0:18:38.24,0:18:41.63,Default,HAJIME,0,0,0,,،حتّى لَو رججتُ الكولا خاصّتي بكلّ قوّتي
Dialogue: 0,0:18:41.63,0:18:44.09,Default,HAJIME,0,0,0,,.لما كانت قد وَصلَت إلى العُمدة
Dialogue: 0,0:18:44.09,0:18:45.14,Default,CONAN,0,0,0,,.هيجي ني تشان
Dialogue: 0,0:18:45.31,0:18:46.09,Default,HEIJI,0,0,0,,هاه؟
Dialogue: 0,0:18:47.88,0:18:49.22,Default,CONAN,0,0,0,,.أُنظر
Dialogue: 0,0:18:50.26,0:18:54.52,Default,CONAN,0,0,0,,.تُوجد أجسامٌ بيضاءٌ مُكوّرةٌ في جميع أرجاء العُشب
Dialogue: 0,0:18:54.76,0:18:58.10,Default,HEIJI,0,0,0,,،إن كانت ما أظنّها
Dialogue: 0,0:18:58.56,0:19:00.53,Default,HEIJI,0,0,0,,...إذاً حتّى من دون أعواد الثّقاب أو قدّاحة
Dialogue: 0,0:19:01.00,0:19:02.78,Default,CONAN,0,0,0,,.لأمكنه إشعال حريق...
Dialogue: 0,0:19:03.25,0:19:08.04,Default,HEIJI,0,0,0,,...ممّا يترك أمر الخِدعة خلف الوَحش الضّخم
Dialogue: 0,0:19:08.45,0:19:11.26,Default,CONAN,0,0,0,,.و التّسميم في الغُرفة المُغلَقة...
Dialogue: 0,0:19:13.35,0:19:14.92,Default,HEIJI,0,0,0,,.لنبدأ بالغُرفة المُغلَقة
Dialogue: 0,0:19:15.20,0:19:19.12,Default,HEIJI,0,0,0,,إنتقل الضّحيّة تانزاوا سان إلى غُرفة الطّابق الثّالث
Dialogue: 0,0:19:19.12,0:19:22.01,Default,HEIJI,0,0,0,,التي كنّا نُقيم فيها بالأساس، صحيح؟
Dialogue: 0,0:19:22.01,0:19:22.93,Default,CONAN,0,0,0,,.نعم
Dialogue: 0,0:19:23.13,0:19:26.24,Default,CONAN,0,0,0,,،إعتماداً على مَواقع غُرفهم
Dialogue: 0,0:19:26.24,0:19:28.72,Default,CONAN,0,0,0,,.ماسوكو سان في الغُرفة أسفلَها هي الأكثر إثارةً للرّيبة
Dialogue: 0,0:19:28.72,0:19:32.69,Default,CONAN,0,0,0,,،عندما تفاجأ تانزاوا سان بالحريق و أخرَج رأسه من النّافذة
Dialogue: 0,0:19:32.69,0:19:36.51,Default,CONAN,0,0,0,,.لأمكنها دفع عصاً طويلةً بإبَرٍ مَسمومةٍ في نهايتها إلى الأعلى
Dialogue: 0,0:19:37.50,0:19:41.37,Default,CONAN,0,0,0,,،لسببٍ ما، فقط جانبٌ وُاحدٌ من نافذة تلك الغُرفة يُفتَح
Dialogue: 0,0:19:41.37,0:19:44.44,Default,CONAN,0,0,0,,.لذا لأمكنها تنبّؤ من أين سيُخرج رأسه
Dialogue: 0,0:19:45.00,0:19:49.28,Default,HEIJI,0,0,0,,،لكن عندما أخذنا هاتف ماسوكو سان
Dialogue: 0,0:19:49.28,0:19:54.71,Default,HEIJI,0,0,0,,.تفحّصنا الغُرفة و لَم نجِد أيّ عُصيّ
Dialogue: 0,0:19:55.26,0:19:56.40,Default,CONAN,0,0,0,,.نعم
Dialogue: 0,0:19:56.40,0:19:58.46,Default,CONAN,0,0,0,,الأشياء الوَحيدة المُثيرة للإهتمام في الغُرفة
Dialogue: 0,0:19:59.18,0:20:03.79,Default,CONAN,0,0,0,,،هي قنّينَتيّ مياه الصّودا بسِعة لِتر
Dialogue: 0,0:20:03.79,0:20:08.08,Default,CONAN,0,0,0,,.قنّينة نبيذٍ وَاحدة، كأسٌ وَاحدة، سكّينة النّبيذ التي طلَبتها من العُمدة
Dialogue: 0,0:20:08.08,0:20:12.98,Default,CONAN,0,0,0,,،داخل حقيبة ماسوكو سان كانت تُوجد أدوات كتابةٍ مثل أقلام التّحديد المُدوّرة
Dialogue: 0,0:20:12.98,0:20:16.98,Default,CONAN,0,0,0,,.شريطٌ لاصقٌ وَرقيّ، طقم أدوات خياطة، و دفتر مُلاحظات
Dialogue: 0,0:20:17.49,0:20:20.66,Default,HEIJI,0,0,0,,ماذا عن الكاتب الوَثائقيّ؟
Dialogue: 0,0:20:20.66,0:20:23.30,Default,HEIJI,0,0,0,,،عندما انتقل تانزاوا سان إلى غُرفتنا
Dialogue: 0,0:20:23.30,0:20:26.99,Default,HEIJI,0,0,0,,.إنتقل إلى الغُرفة المُجاورة إلى الغُرفة في النّهاية اليُسرى للطّابق الثّالث
Dialogue: 0,0:20:27.50,0:20:31.84,Default,HEIJI,0,0,0,,رُبّما فُتِحَ جانبٌ وَاحدٌ فقط من نافذة غُرفة تانزاوا سان
Dialogue: 0,0:20:31.84,0:20:36.75,Default,HEIJI,0,0,0,,.حتّى لا يُعيقه عند إطلاق سهم النّفخ المَسموم عليه
Dialogue: 0,0:20:37.02,0:20:42.99,Default,CONAN,0,0,0,,لكن كان يفصل بين نافِذتيّ غُرفتيّ تسورومي سان و تانزاوا سان 10 أمتار
Dialogue: 0,0:20:42.99,0:20:46.35,Default,CONAN,0,0,0,,.مع وُجود نافذةٍ بينهما
Dialogue: 0,0:20:46.76,0:20:49.14,Default,CONAN,0,0,0,,.إضافةً إلى أنّه لَن يتمكّن من ثقب أسفل ذقنه من الجّانب
Dialogue: 0,0:20:49.88,0:20:52.58,Default,CONAN,0,0,0,,.و لَم يملك تسورومي سان سهام نفخ
Dialogue: 0,0:20:53.28,0:20:54.90,Default,HEIJI,0,0,0,,.نعم
Dialogue: 0,0:20:54.90,0:20:57.27,Default,HEIJI,0,0,0,,وَجدنا في غُرفته
Dialogue: 0,0:20:57.90,0:21:01.97,Default,HEIJI,0,0,0,,،ثلاثة قناني كولا بسِعة 500 ملّيلتر
Dialogue: 0,0:21:01.97,0:21:03.95,Default,HEIJI,0,0,0,,،كيسان من رقائق البطاطا
Dialogue: 0,0:21:03.95,0:21:07.93,Default,HEIJI,0,0,0,,،سكّينةٌ مَطويّة، عصا سيلفي، سجائر و وَلّاعة
Dialogue: 0,0:21:08.48,0:21:12.16,Default,HEIJI,0,0,0,,.و النّموذج البلاستيكيّ الذي قال بأنّه اشتراه لتمضية الوَقت
Dialogue: 0,0:21:12.87,0:21:15.67,Default,HEIJI,0,0,0,,.إشترى الصّمغ حتّى
Dialogue: 0,0:21:16.02,0:21:20.84,Default,CONAN,0,0,0,,.لَم يملك أيّ شيءٍ يُمكنه استخدامه لتسميم أحد
Dialogue: 0,0:21:21.13,0:21:23.82,Default,HEIJI,0,0,0,,.ممّا يترك العُمدة
Dialogue: 0,0:21:24.47,0:21:27.72,Default,CONAN,0,0,0,,.كلّ ما كان يحمله هو المِكنسة طويلة السّاق
Dialogue: 0,0:21:30.50,0:21:32.35,Default,HEIJI,0,0,0,,ماذا تفعلان هناك؟
Dialogue: 0,0:21:32.98,0:21:35.67,Default,HEIJI,0,0,0,,.أخبرَتنا الشّرطة بأن نبقى داخل الغُرفة
Dialogue: 0,0:21:35.67,0:21:38.86,Default,KAZUHA,0,0,0,,.نعم، لكنّنا قلِقتان على الكلب
Dialogue: 0,0:21:39.08,0:21:42.17,Default,RAN,0,0,0,,،عندما صرخَ النوي مُسبقاً
Dialogue: 0,0:21:42.17,0:21:46.15,Default,RAN,0,0,0,,.سمعناه ينبح و يخدش الحائط
Dialogue: 0,0:21:46.58,0:21:49.91,Default,KAZUHA,0,0,0,,،ظننّاه كان جائعاً و أراد الخُروج
Dialogue: 0,0:21:50.12,0:21:53.17,Default,KAZUHA,0,0,0,,.لذا صنعنا له العشاء في المطبخ و أحضرناه له
Dialogue: 0,0:21:53.47,0:21:55.79,Default,RAN,0,0,0,,.لكنّه لا يأكل
Dialogue: 0,0:21:56.72,0:22:00.34,Default,CONAN,0,0,0,,...بالتّفكير بالأمر، عندما سمعنا صُراخ النوي للمرّة الأُولى
Dialogue: 0,0:22:00.34,0:22:02.30,Default,HEIJI,0,0,0,,.كان ينبح وَقتها أيضاً
Dialogue: 0,0:22:03.67,0:22:06.20,Default,CONAN,0,0,0,,...لكن عندما ظهرَ الوَحش
Dialogue: 0,0:22:06.72,0:22:08.30,Default,HEIJI,0,0,0,,.لَم يكُن ينبح...
Dialogue: 0,0:22:09.46,0:22:10.80,Default,CONAN,0,0,0,,.فهمت
Dialogue: 0,0:22:11.48,0:22:13.56,Default,HEIJI,0,0,0,,.إذاً هكذا الأمر
Dialogue: 0,0:22:14.45,0:22:17.00,Default,CONAN,0,0,0,,...و الوَحيد الذي أمكنه فِعل هذا
Dialogue: 0,0:22:17.00,0:22:19.28,Default,HEIJI,0,0,0,,.كان ذلك الشّخص...
Dialogue: 0,0:23:44.98,0:24:09.01,Default,TEXT,0,0,0,,{\pos(228,184)}في الحلقة القادمة
Dialogue: 0,0:23:45.39,0:23:47.48,Default,HEIJI,0,0,0,,...سنستدعي
Dialogue: 0,0:23:48.16,0:23:49.74,Default,CONAN,0,0,0,,.الوَحش ثانيةً...
Dialogue: 0,0:23:50.44,0:23:52.40,Default,YOKOMIZO,0,0,0,,...هذا غير مُمكن
Dialogue: 0,0:23:54.69,0:23:59.00,Default,HAJIME,0,0,0,,.إنّه صُراخ النوي
