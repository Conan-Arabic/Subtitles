Dialogue: 0,0:00:00.00,0:00:02.69,DCMain,CONAN,0,0,0,,[op]
Dialogue: 0,0:00:00.00,0:00:02.69,Diary,SIGN,0,0,0,,مذكرات مصورة
Dialogue: 0,0:00:01.06,0:00:02.83,DCMain,AYUMI,0,0,0,,مذكرات أيومي المصورة
Dialogue: 0,0:00:03.26,0:00:08.32,DCMain,AYUMI,0,0,0,,قالت الأستاذة كوباياشي أن المذكرات المصورة التي صنعتها اخر مرة كانت رائعة
Dialogue: 0,0:00:08.44,0:00:10.36,Produce,SIGN LEFT,0,0,0,,{\fad(335,1)}متجر اوجينو بروديوس
Dialogue: 0,0:00:08.44,0:00:10.36,Jewelry,SIGN RIGHT,0,0,0,,{\fad(335,1)}مجوهرات كانيكو
Dialogue: 0,0:00:21.27,0:00:28.42,DCMain,AYUMI,0,0,0,,وقالت أن فريق المحققين الصغار رائعٌ للغاية لحلهم قضية لص المجوهرات
Dialogue: 0,0:00:30.38,0:00:31.80,Produce2,SIGN LEFT,0,0,0,,متجر اوجينو بروديوس
Dialogue: 0,0:00:30.38,0:00:31.80,Jewelry2,SIGN RIGHT,0,0,0,,مجوهرات كانيكو
Dialogue: 0,0:00:30.64,0:00:34.13,DCMain,AYUMI,0,0,0,,هذه المرة سأضيف المزيد من الرسومات
Dialogue: 0,0:00:33.47,0:00:34.93,Diary2,SIGN,0,0,0,,ذكريات مصورة
Dialogue: 0,0:00:34.13,0:00:37.19,DCMain,AYUMI,0,0,0,,لكي تعطينا المزيد من المديح
Dialogue: 0,0:00:37.62,0:00:43.40,DCMain,AYUMI,0,0,0,,قضية مذكرات أيومي المصورة الجزء الثاني تبدأ الان!
Dialogue: 0,0:00:44.67,0:00:46.23,DCMain,CONAN,0,0,0,,يأتي لِّزيارة بعد الخلود ألى النوم
Dialogue: 0,0:00:46.23,0:00:48.28,DCMain,CONAN,0,0,0,,واقعٌ في حب الاستنتاج وحل الغموض!
Dialogue: 0,0:00:48.28,0:00:50.17,DCMain,CONAN,0,0,0,,مذكرات أيومي المصورة تصف أحداث هذه الجريمة
Dialogue: 0,0:00:50.17,0:00:51.90,DCMain,CONAN,0,0,0,,ما هي الحقيقة خلف تهديد القنبلة؟
Dialogue: 0,0:00:51.90,0:00:53.53,DCMain,CONAN,0,0,0,,يجد دائما الحقيقة الواحدة والوحيدة
Dialogue: 0,0:00:53.53,0:00:55.32,DCMain,CONAN,0,0,0,,بجسم طفلٍ وعقل بالغ
Dialogue: 0,0:00:55.32,0:00:57.78,DCMain,CONAN,0,0,0,,أسمه هو المحقق كونان!
Dialogue: 0,0:02:40.01,0:02:46.02,DCEpTitle,EPTITLE,0,0,0,,{\fad(400,1)}قضية مذكرات أيومي المصورة الثانية
Dialogue: 0,0:02:47.09,0:02:51.47,DCMain,AYUMI,0,0,0,,بدأ الأمر عندما كنا في طريق عودتنا الى البيت بعد رحلةٍ في السيارة
Dialogue: 0,0:03:07.16,0:03:09.09,DCMain,AYUMI,0,0,0,,كونان، كونان!
Dialogue: 0,0:03:09.73,0:03:11.31,DCMain,AYUMI,0,0,0,,ما هذا؟
Dialogue: 0,0:03:20.22,0:03:20.93,Comments,SIGN,0,0,0,,هنالك وميض
Dialogue: 0,0:03:20.22,0:03:21.09,Comments,SIGN,0,0,0,,هل هذا وميض؟
Dialogue: 0,0:03:20.22,0:03:22.05,Comments,SIGN,0,0,0,,هل هناك مشكلة؟
Dialogue: 0,0:03:20.80,0:03:24.22,Comments2,SIGN,0,0,0,,وميض, وميض, وميض
Dialogue: 0,0:03:20.80,0:03:24.22,Comments2,SIGN,0,0,0,,وميييض, وميييض, وميييض
Dialogue: 0,0:03:20.80,0:03:24.22,Comments2,SIGN,0,0,0,,وميض، وميض، وميض
Dialogue: 0,0:03:20.80,0:03:24.22,Comments2,SIGN,0,0,0,,...ماذا يعني هذا؟
Dialogue: 0,0:03:21.97,0:03:26.22,Comments,SIGN,0,0,0,,إنها شفرةٌ من نوعٍ ما\Nماذا كان أسمها يا ترى؟
Dialogue: 0,0:03:22.97,0:03:26.22,Comments,SIGN,0,0,0,,تقصد شفرة موريس؟
Dialogue: 0,0:03:24.97,0:03:26.22,Comments,SIGN,0,0,0,,صحيح! أنها شفرة موريس!
Dialogue: 0,0:03:25.02,0:03:26.22,Comments,SIGN,0,0,0,,عل ترجمها أحد؟
Dialogue: 0,0:03:26.06,0:03:26.22,Comments,SIGN,0,0,0,,أذن، ماذا تعني؟
Dialogue: 0,0:03:28.95,0:03:31.44,DCMain,AYUMI,0,0,0,,أليست هذه شفرة موريس؟
Dialogue: 0,0:03:31.44,0:03:32.26,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:03:32.26,0:03:34.84,DCMain,CONAN,0,0,0,,ليس هذا فقط، ترجمتها هي\NSOS : رمز الاستغاثة العالمي
Dialogue: 0,0:03:34.84,0:03:36.93,DCMain,CONAN,0,0,0,,أحسنت عملاً بمعرفتها، أيومي
Dialogue: 0,0:03:36.93,0:03:39.03,DCMain,GENTA,0,0,0,,هل تم أحتجاز رهينةٍ هناك؟
Dialogue: 0,0:03:39.56,0:03:40.49,DCMain,CONAN,0,0,0,,لا أعرف؟
Dialogue: 0,0:03:40.99,0:03:42.58,DCMain,CONAN,0,0,0,,سوف أذهب لتفقد الأمر
Dialogue: 0,0:03:42.58,0:03:43.53,DCMain,CONAN,0,0,0,,وانتم انتظروني هنا
Dialogue: 0,0:04:00.25,0:04:01.77,DCMain,CONAN,0,0,0,,وكونوا حذرين ايضاً
Dialogue: 0,0:04:19.56,0:04:23.06,DCMain,MITSUHIKO,0,0,0,,ألا يشبه الشاتشيوكو قليلاً؟\Nالشاتشيهوكو : هو حيوان في الثقافة اليابانية يملك رأس نمر وجسم سمكة
Dialogue: 0,0:04:23.06,0:04:24.24,DCMain,AGASA,0,0,0,,هل أنت بخير
Dialogue: 0,0:04:27.31,0:04:28.49,DCMain,DANNO,0,0,0,,هنالك قنبلة؟
Dialogue: 0,0:04:28.77,0:04:30.62,DCMain,DANNO,0,0,0,,شخصٌ ما زرع قنبلةً في هذا البيت
Dialogue: 0,0:04:30.62,0:04:31.62,DCMain,ALL,0,0,0,,ماذا؟!
Dialogue: 0,0:04:32.05,0:04:33.37,DCMain,DANNO,0,0,0,,أهربوا!
Dialogue: 0,0:04:33.69,0:04:36.17,DCMain,CONAN,0,0,0,,من زرع هذه القنبلة؟!
Dialogue: 0,0:04:36.53,0:04:38.02,DCMain,DANNO,0,0,0,,لا أعرف
Dialogue: 0,0:04:38.02,0:04:42.55,DCMain,DANNO,0,0,0,,جئت إلا هنا فقط لإيصال طرد
Dialogue: 0,0:04:42.89,0:04:45.42,DCMain,DANNO,0,0,0,,وبينما كنت مقيداً هنا
Dialogue: 0,0:04:45.42,0:04:49.81,DCMain,DANNO,0,0,0,,سمعتهم يتحدثون عن قنبلة
Dialogue: 0,0:04:53.01,0:04:55.69,DCMain,MITSUHIKO,0,0,0,,يجب أن نبلغ الشرطة عن هذا يا بروفيسور!
Dialogue: 0,0:04:56.18,0:04:57.95,DCMain,AGASA,0,0,0,,أ-انت محق!
Dialogue: 0,0:04:57.95,0:04:59.73,DCMain,AYUMI,0,0,0,,أين ذهب كونان؟
Dialogue: 0,0:04:59.73,0:05:00.44,DCMain,ALL,0,0,0,,ماذا؟
Dialogue: 0,0:05:00.80,0:05:02.40,DCMain,MITSUHIKO,0,0,0,,هو لم يبقى في الداخل، أليس كذلك؟
Dialogue: 0,0:05:02.40,0:05:03.19,DCMain,BOTH,0,0,0,,ماذا؟
Dialogue: 0,0:05:19.25,0:05:22.94,DCMain,DANNO,0,0,0,,هذه خطرٌ أيها الفتى، يجب أن نهرب
Dialogue: 0,0:05:22.94,0:05:26.09,DCMain,CONAN,0,0,0,,سوف أكون بخير، لا تقلق علي
Dialogue: 0,0:05:26.27,0:05:27.75,DCMain,DANNO,0,0,0,,لا يمكنني السماح بهذا
Dialogue: 0,0:05:27.75,0:05:29.01,DCMain,CONAN,0,0,0,,مهلا، أنتظر قليلاً
Dialogue: 0,0:05:29.01,0:05:33.39,DCMain,DANNO,0,0,0,,من المستحيل لطفلٍ أن يعطل قنبلة
Dialogue: 0,0:05:29.31,0:05:31.90,DCMain,CONAN,0,0,0,,{\an8}أتركني
Dialogue: 0,0:05:44.06,0:05:47.03,DCMain,CONAN,0,0,0,,المحقق تاكاغي وشيبا، لقد وصلتم بسرعة
Dialogue: 0,0:05:47.43,0:05:53.54,DCMain,CHIBA,0,0,0,,تلقينا أتصالاً مجهولاً يقول أن هناك من يرسل طلب استغاثة من هذا المكتب
Dialogue: 0,0:05:53.88,0:05:55.33,DCMain,CONAN,0,0,0,,مجهول؟
Dialogue: 0,0:05:58.76,0:06:02.67,DCMain,AYUMI,0,0,0,,أيها المحقق تاكاغي، هذا هو الشخص صاحب نداء الأستغاثة
Dialogue: 0,0:06:03.11,0:06:06.66,DCMain,TAKAGI,0,0,0,,هل يمكنك أن تخبرنا التفاصيل؟
Dialogue: 0,0:06:06.66,0:06:09.18,DCMain,CHIBA,0,0,0,,أولاً، ما هو أسمك؟
Dialogue: 0,0:06:09.34,0:06:12.77,DCMain,DANNO,0,0,0,,{\an8}أسمي هو دانو ماسارو
Dialogue: 0,0:06:11.47,0:06:15.43,Danno,SIGN,0,0,0,,{\fad(250,460)}دانو ماسارو   ٢٦ عاماً\Nعامل توصيل
Dialogue: 0,0:06:12.77,0:06:15.81,DCMain,DANNO,0,0,0,,{\an8}يكتب هكذا دانو داي \Nويُقرأ هكذا دانو ماسارو
Dialogue: 0,0:06:15.93,0:06:18.69,Delivery,SIGN JACKET,0,0,0,,D.D\Nلتوصيل الطرود على الدراجات
Dialogue: 0,0:06:16.25,0:06:18.69,DCMain,DANNO,0,0,0,,{\an8}أنا عامل توصيل يستخدم دراجة
Dialogue: 0,0:06:19.52,0:06:25.25,DCMain,DANNO,0,0,0,,وصلت إلا الطابق الثالث من هذه المبنى لكي أوصل الطرد
Dialogue: 0,0:06:25.25,0:06:29.95,DCMain,DANNO,0,0,0,,وبينما كان الرجل المتسخ الذي أخذ الطرد يكتب توقيعه سقط من جيبه مسدس
Dialogue: 0,0:06:30.26,0:06:32.95,DCMain,MITSUHIKO,0,0,0,,ولماذا سقط المسدس من جيبه؟
Dialogue: 0,0:06:34.40,0:06:38.16,DCMain,DANNO,0,0,0,,أظن أنه كان يحاول أخراج ختمه من جيبه
Dialogue: 0,0:06:38.43,0:06:39.65,DCMain,TAKAGI,0,0,0,,لقد فهمت
Dialogue: 0,0:06:39.65,0:06:42.29,DCMain,TAKAGI,0,0,0,,إذن قام بتقيدك لأنك رأيت مسدسه
Dialogue: 0,0:06:42.49,0:06:43.90,DCMain,DANNO,0,0,0,,أجل، على ما أظن
Dialogue: 0,0:06:43.90,0:06:48.12,DCMain,DANNO,0,0,0,,فقدت الوعي بعدما ضربني أحدهم من الخلف على رأسي
Dialogue: 0,0:06:48.12,0:06:52.30,DCMain,DANNO,0,0,0,,عندما أستيقظت كنت مقيداً وعاجزاً عن الحراك
Dialogue: 0,0:06:52.46,0:06:54.56,DCMain,DANNO,0,0,0,,وبعدها سمعت حديثهم عن القنبلة
Dialogue: 0,0:06:54.98,0:06:57.57,DCMain,DANNO,0,0,0,,وقالوا أنه لا يوجد حاجةٌ لقتلي
Dialogue: 0,0:06:57.57,0:07:00.20,DCMain,DANNO,0,0,0,,لأنهم سيفجرون المبنى بأكمله
Dialogue: 0,0:07:00.90,0:07:05.82,DCMain,AYUMI,0,0,0,,ولماذا تحدث المجرمون عن هذه الأمر أمامك؟
Dialogue: 0,0:07:07.62,0:07:09.82,DCMain,DANNO,0,0,0,,لأنني كنت فاقداً الوعي قبل مدةٍ قصيرة من حديثهم
Dialogue: 0,0:07:10.04,0:07:11.05,DCMain,AYUMI,0,0,0,,لقد فهمت
Dialogue: 0,0:07:11.05,0:07:13.11,DCMain,AYUMI,0,0,0,,كنت تتظاهر أنك لا تزال غائباً عن الوعي
Dialogue: 0,0:07:13.32,0:07:15.01,DCMain,DANNO,0,0,0,,أجل بالضبط
Dialogue: 0,0:07:15.01,0:07:19.75,DCMain,DANNO,0,0,0,,وبعد أن غادر المجرمان, كلكم تعرفون ما حدث......
Dialogue: 0,0:07:20.01,0:07:25.63,DCMain,TAKAGI,0,0,0,,أستخدمت المصباح لترسل نداء الأسغاثة بشيفرة موريس
Dialogue: 0,0:07:26.15,0:07:28.38,DCMain,MITSUHIKO,0,0,0,,رغم أن شكلك كان مثل الشاتشيهوكو
Dialogue: 0,0:07:31.18,0:07:32.82,DCMain,CONAN,0,0,0,,عذراً يا سيد
Dialogue: 0,0:07:32.82,0:07:36.22,DCMain,CONAN,0,0,0,,كيف خطر على بالك أن ترسل نداء أستغاثة بشيفرة موريس
Dialogue: 0,0:07:36.64,0:07:38.48,DCMain,DANNO,0,0,0,,كيف؟
Dialogue: 0,0:07:38.48,0:07:42.01,DCMain,DANNO,0,0,0,,لأنني كنت معتاداً على أن أكون فتى كشافة
Dialogue: 0,0:07:42.01,0:07:46.23,DCMain,DANNO,0,0,0,,وصدف أن تذكرت تعلمي لشفرة موريس في ذلك الوقت
Dialogue: 0,0:07:47.52,0:07:49.04,DCMain,CONAN,0,0,0,,لقد فهمت
Dialogue: 0,0:07:49.04,0:07:51.74,DCMain,CONAN,0,0,0,,بالمناسبة، هل هذه هي دراجتك؟
Dialogue: 0,0:07:51.88,0:07:54.74,DCMain,DANNO,0,0,0,,نعم ، هذه دراجتي الحبيبة
Dialogue: 0,0:07:57.41,0:08:00.50,DCMain,POLICE A,0,0,0,,لقد تلقينا خبراً من فرقة تعطيل القنابل في المبنى
Dialogue: 0,0:08:00.50,0:08:03.75,DCMain,POLICE A,0,0,0,,وجدو ما قد يكون قنبلةً في الطابق الثالث
Dialogue: 0,0:08:04.20,0:08:09.04,DCMain,POLICE A,0,0,0,,يسمعون صوتاً يشبه صوت دقات الساعة صادراً من صندوقٍ كرتوني
Dialogue: 0,0:08:19.26,0:08:20.02,Comments - Copy,SIGN,0,0,0,,لقد كان نداء أستغاثة حقيقي
Dialogue: 0,0:08:19.26,0:08:20.27,Comments - Copy,SIGN,0,0,0,,هل وجدو القنبلة
Dialogue: 0,0:08:19.26,0:08:20.27,Comments - Copy,SIGN,0,0,0,,نداء الاستغاثة كان حقيقياً....
Dialogue: 0,0:08:19.26,0:08:20.35,Comments - Copy,SIGN,0,0,0,,هل كان هناك قنبلة
Dialogue: 0,0:08:19.39,0:08:21.27,Comments2 - Copy,SIGN,0,0,0,,لقد كانت شفرة مورس فعلاً
Dialogue: 0,0:08:19.47,0:08:20.85,Comments2 - Copy,SIGN,0,0,0,,حقاً لول سوف أذهب إلا هناك لول
Dialogue: 0,0:08:19.52,0:08:21.23,Comments - Copy,SIGN,0,0,0,,هذا جنونيٌ فعلاً
Dialogue: 0,0:08:19.56,0:08:21.81,Comments2 - Copy,SIGN,0,0,0,,الشخص الذي أرسل نداء الاستغاثة أثار اعجابي
Dialogue: 0,0:08:19.64,0:08:21.10,Comments - Copy,SIGN,0,0,0,,هل وجدو القنبلة؟
Dialogue: 0,0:08:19.77,0:08:20.93,Comments - Copy,SIGN,0,0,0,,هل سوف تنفجر؟
Dialogue: 0,0:08:19.77,0:08:21.27,Comments2 - Copy,SIGN,0,0,0,,هل تم أخلاء المبنى بالكامل؟
Dialogue: 0,0:08:19.93,0:08:21.39,Comments2 - Copy,SIGN,0,0,0,,هناك قنبلة فعلا لول
Dialogue: 0,0:08:20.06,0:08:21.27,Comments - Copy,SIGN,0,0,0,,يجب أخلاء المكان.......
Dialogue: 0,0:08:20.22,0:08:21.68,Comments2 - Copy,SIGN,0,0,0,,لقد ارسلوا فرقة تعطيل القنابل!
Dialogue: 0,0:08:20.35,0:08:21.85,Comments - Copy,SIGN,0,0,0,,نداء الأستغاثة كان حقيقياً!!!
Dialogue: 0,0:08:20.43,0:08:21.64,Comments - Copy,SIGN,0,0,0,,أنا قريبٌ من المكان لول
Dialogue: 0,0:08:20.47,0:08:21.73,Comments2 - Copy,SIGN,0,0,0,,أرجو أن يرسلو فرقة تعطيل القنابل لول
Dialogue: 0,0:08:20.47,0:08:21.89,Comments2 - Copy,SIGN,0,0,0,,مستحيل!!
Dialogue: 0,0:08:20.47,0:08:22.27,Comments - Copy,SIGN,0,0,0,,لا تقف هناك وتشاهد، أهرب أيها المغفل!
Dialogue: 0,0:08:20.47,0:08:22.31,Comments2 - Copy,SIGN,0,0,0,,هجوم أرهابيين!!!
Dialogue: 0,0:08:20.68,0:08:22.10,Comments - Copy,SIGN,0,0,0,,لماذا لا يهرب الجميع!!!
Dialogue: 0,0:08:21.06,0:08:22.60,Comments - Copy,SIGN,0,0,0,,يا لها من بلادٍ خطرة
Dialogue: 1,0:08:21.08,0:08:22.41,DCMain,SIGN,0,0,0,,مخيف
Dialogue: 0,0:08:21.10,0:08:22.39,Comments2 - Copy,SIGN,0,0,0,,أنا خائف! سوف اقفل باب بيتي
Dialogue: 0,0:08:21.14,0:08:22.68,Comments - Copy,SIGN,0,0,0,,قنبلة.... لماذا....
Dialogue: 0,0:08:21.23,0:08:22.60,Comments - Copy,SIGN,0,0,0,,الحمد لله وصلت فرقة القنابل
Dialogue: 0,0:08:21.23,0:08:22.77,Comments - Copy,SIGN,0,0,0,,هذا خطير...
Dialogue: 0,0:08:21.27,0:08:23.23,Comments2 - Copy,SIGN,0,0,0,,أشعر بوجودبكارثة وشيكة لول
Dialogue: 0,0:08:21.31,0:08:23.27,Comments - Copy,SIGN,0,0,0,,يا للروعة فرقة قنابل!!!
Dialogue: 0,0:08:21.35,0:08:23.27,Comments - Copy,SIGN,0,0,0,,ماذا.... أن الحي الذي أعيش فيه خطير
Dialogue: 0,0:08:21.39,0:08:23.02,Comments2 - Copy,SIGN,0,0,0,,يومٌ مسالمٌ اخر في مدينة بيكا
Dialogue: 0,0:08:21.77,0:08:23.10,Comments2 - Copy,SIGN,0,0,0,,هذه البلد تعُج بالجرائم
Dialogue: 0,0:08:21.81,0:08:23.85,Comments2 - Copy,SIGN,0,0,0,,لن يكون الأمر مضحكاً أذا انفجرت لول
Dialogue: 0,0:08:21.89,0:08:23.77,Comments2 - Copy,SIGN,0,0,0,,أليس هذا مقلباً؟
Dialogue: 0,0:08:21.93,0:08:23.60,Comments2 - Copy,SIGN,0,0,0,,جميع التعليقات هنا كتبها اطفال
Dialogue: 0,0:08:22.10,0:08:23.73,Comments2 - Copy,SIGN,0,0,0,,لا أصدق أن شيئاً مخيفاً كهذا يحدث بجواري!
Dialogue: 0,0:08:22.31,0:08:24.39,Comments2 - Copy,SIGN,0,0,0,,فرقة القنابل رائعةٌ للغاية
Dialogue: 0,0:08:22.43,0:08:24.10,Comments - Copy,SIGN,0,0,0,,ماذا سوف نفعل إذا انفجرت
Dialogue: 0,0:08:22.52,0:08:23.73,Comments - Copy,SIGN,0,0,0,,أطفال...؟ ولكن لماذا؟
Dialogue: 0,0:08:22.64,0:08:24.69,Comments2 - Copy,SIGN,0,0,0,,لوووووول
Dialogue: 0,0:08:22.68,0:08:24.35,Comments - Copy,SIGN,0,0,0,,يجب اخلاء المدنيين من هذه المنطقة
Dialogue: 0,0:08:22.98,0:08:24.39,Comments2 - Copy,SIGN,0,0,0,,ماذا!! يا الهي
Dialogue: 0,0:08:22.98,0:08:25.31,Comments2 - Copy,SIGN,0,0,0,,لماذا... لماذا حوادثٌ كهذه تحدث كل يوم....
Dialogue: 0,0:08:23.31,0:08:24.56,Comments - Copy,SIGN,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:08:23.39,0:08:25.77,Comments2 - Copy,SIGN,0,0,0,,أتمنى ألا تنفجر....
Dialogue: 0,0:08:23.48,0:08:25.52,Comments2 - Copy,SIGN,0,0,0,,فرقة القنابل تقوم بعملها الأن
Dialogue: 0,0:08:23.64,0:08:24.90,Comments2 - Copy,SIGN,0,0,0,,لماذا....
Dialogue: 0,0:08:23.77,0:08:25.77,Comments - Copy,SIGN,0,0,0,,حظاً موفقاً بن فرقة القنابل
Dialogue: 0,0:08:23.89,0:08:25.44,Comments - Copy,SIGN,0,0,0,,أليس هذا أعلاناً كاذباً؟
Dialogue: 0,0:08:24.10,0:08:25.40,Comments - Copy,SIGN,0,0,0,,برودةُ اعصابهم مذهلة!
Dialogue: 0,0:08:24.19,0:08:25.77,Comments - Copy,SIGN,0,0,0,,يبدو أن هناك قنبلة حقيقية!
Dialogue: 0,0:08:24.23,0:08:25.44,Comments - Copy,SIGN,0,0,0,,أنا اثق بالشرطة
Dialogue: 0,0:08:24.44,0:08:25.77,Comments2 - Copy,SIGN,0,0,0,,هل كل شيئٍ بخير؟
Dialogue: 0,0:08:24.69,0:08:25.77,Comments2 - Copy,SIGN,0,0,0,,أين هي القنبلة؟ داخل البناية؟
Dialogue: 0,0:08:24.94,0:08:25.77,Comments2 - Copy,SIGN,0,0,0,,هجومٌ أرهابي؟ مخيف
Dialogue: 0,0:08:25.10,0:08:25.77,Comments - Copy,SIGN,0,0,0,,يجب أن تبتعد من هناك!
Dialogue: 0,0:08:25.48,0:08:25.77,Comments2 - Copy,SIGN,0,0,0,,أحذروا
Dialogue: 0,0:08:30.78,0:08:32.25,DCMain,AYUMI,0,0,0,,بوووووم!
Dialogue: 0,0:08:32.25,0:08:35.11,DCMain,AYUMI,0,0,0,,... هذا ما ظننا أنه سيحدث
Dialogue: 0,0:08:36.01,0:08:41.28,DCMain,AYUMI,0,0,0,,لكن كل ما وجدوه في الصندوق كان ساعة تنبيهٍ عادية
Dialogue: 0,0:08:42.62,0:08:44.41,DCMain,POLICE A,0,0,0,,قمنا بتفتيش المبنى بدقة
Dialogue: 0,0:08:44.77,0:08:47.68,DCMain,POLICE A,0,0,0,,لكننا لم نجد أي قنبلة
Dialogue: 0,0:08:47.68,0:08:49.80,DCMain,CHIBA,0,0,0,,ماذا يجب أن نفعل، ايها المحقق تاكاغي
Dialogue: 0,0:08:51.53,0:08:54.01,DCMain,TAKAGI,0,0,0,,سوف نزيل حشد الناس المحيط بالمبنى
Dialogue: 0,0:08:54.01,0:08:57.21,DCMain,TAKAGI,0,0,0,,ونترك جزءًا فقط من فريق الطب الشرعي.
Dialogue: 0,0:08:57.21,0:08:57.93,DCMain,POLICE A,0,0,0,,حاضر
Dialogue: 0,0:08:58.12,0:09:00.95,DCMain,AGASA,0,0,0,,أذن لم يجدوا أي قنبلة
Dialogue: 0,0:09:00.95,0:09:05.94,DCMain,DANNO,0,0,0,,لكنني متأكدٌ انهم تحدثوا عن زراعة قنبلة
Dialogue: 0,0:09:07.52,0:09:12.69,DCMain,MITSUHIKO,0,0,0,,اتسائل لماذا لم يقتلوك إذا لم يكن هناك قنبلةٌ من الأساس؟
Dialogue: 0,0:09:13.02,0:09:16.32,DCMain,DANNO,0,0,0,,كلامك له وقعٌ سيء عندما تقوله بصوتٍ عالٍ
Dialogue: 0,0:09:16.55,0:09:20.34,DCMain,TAKAGI,0,0,0,,على أي حال، عدم وجود قنبلة هو افضل نتيجةٍ ممكنة
Dialogue: 0,0:09:20.99,0:09:23.12,DCMain,AYUMI,0,0,0,,كونان، أين كنت؟
Dialogue: 0,0:09:23.12,0:09:25.36,DCMain,CONAN,0,0,0,,أوه، كنت فقط أتجول في الأرجاء
Dialogue: 0,0:09:27.68,0:09:28.54,DCMain,CHIBA,0,0,0,,مرحبا؟
Dialogue: 0,0:09:29.36,0:09:30.38,DCMain,CHIBA,0,0,0,,نعم
Dialogue: 0,0:09:31.70,0:09:32.84,DCMain,CHIBA,0,0,0,,ماذا؟
Dialogue: 0,0:09:35.46,0:09:40.97,DCMain,CHIBA,0,0,0,,أيها المحقق تاكاغي، حدث سطوٌ مسلح على متجر مجوهرات كانيكو في مدينة بيكا
Dialogue: 0,0:09:40.97,0:09:42.10,DCMain,TAKAGI,0,0,0,,ماذا؟
Dialogue: 0,0:09:42.74,0:09:44.96,DCMain,GENTA,0,0,0,,مجوهرات كانيكو؟
Dialogue: 0,0:09:44.96,0:09:49.12,DCMain,MITSUHIKO,0,0,0,,يقع هذه المتجر على نفس طريق ذهابنا إلا المدرسة
Dialogue: 0,0:09:46.77,0:09:49.40,Produce2,SIGN LEFT,0,0,0,,اوجينو بروديوس
Dialogue: 0,0:09:46.77,0:09:49.44,Jewelry2,SIGN RIGHT,0,0,0,,مجوهرات كانيكو
Dialogue: 0,0:09:50.14,0:09:54.34,DCMain,AYUMI,0,0,0,,بشكل لا يصدق، حدث سطوٌ مسلح جديد
Dialogue: 0,0:09:54.36,0:09:59.03,Case,SIGN,0,0,0,,{\fs30\an2}قضية نداء الاستغاثة والأختطاف
Dialogue: 0,0:09:54.96,0:09:58.69,DCMain,AYUMI,0,0,0,,{\a6}وهكذا أخذت قضية نداء الاستغاثة والأختطاف
Dialogue: 0,0:09:59.64,0:10:04.68,DCMain,AYUMI,0,0,0,,{\a6}والأختطاف منحنىً غير متوقع!
Dialogue: 0,0:10:23.47,0:10:26.35,DCMain,GENTA,0,0,0,,لا أصدق انه تم سطوُهم مرةً أخرى
Dialogue: 0,0:10:26.69,0:10:28.48,DCMain,MITSUHIKO,0,0,0,,يا لسوء الحظ
Dialogue: 0,0:10:31.20,0:10:33.61,DCMain,CONAN,0,0,0,,لقد فمهت هكذا حدث الأمر إذاً
Dialogue: 0,0:10:33.89,0:10:34.81,DCMain,ALL,0,0,0,,ماذا؟
Dialogue: 0,0:10:34.81,0:10:37.10,DCMain,CONAN,0,0,0,,بروفيسور، هل يمكنك أن تجلب السيارة
Dialogue: 0,0:10:41.61,0:10:44.20,DCMain,AYUMI,0,0,0,,لقد اكتشفت شيئا أليس كذلك يا كونان؟
Dialogue: 0,0:10:44.20,0:10:47.12,DCMain,AYUMI,0,0,0,,لقد قلت لِتو: لقد فمهت هكذا حدث الأمر إذاً
Dialogue: 0,0:10:47.44,0:10:53.63,DCMain,CONAN,0,0,0,,لقد كُنا شركاء المجرمين في هذه الجريمة دون أن ندرك ذلك!
Dialogue: 0,0:10:54.03,0:10:55.63,DCMain,MITSUHIKO,0,0,0,,كنا شركاء في الجريمة؟
Dialogue: 0,0:10:55.85,0:10:56.63,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:10:56.63,0:11:01.64,DannoWriteup,SIGN,0,0,0,,يكتبُ دانو داي\Nويُقرأ دانو ماسارو\Nيعمل مع\Nالمجرمين
Dialogue: 0,0:10:57.37,0:11:01.64,DCMain,CONAN,0,0,0,,عامل التوصيل ذاك كان على الأغلب يعمل مع المجرمين
Dialogue: 0,0:11:01.84,0:11:02.89,DCMain,ALL,0,0,0,,ماذا؟
Dialogue: 0,0:11:03.21,0:11:07.29,DCMain,CONAN,0,0,0,,من المريب أنه بقي في المبنى وأستخدم شفرة مورس لطلب المساعدة
Dialogue: 0,0:11:07.29,0:11:11.14,DCMain,CONAN,0,0,0,,رغم عدم معرفته وقت أنفجار القنبلة
Dialogue: 0,0:11:11.14,0:11:14.15,DCMain,CONAN,0,0,0,,ومتى سيلاحظ الناس رسالته هذا أذا كانو سيلاحظونها من الأساس
Dialogue: 0,0:11:14.40,0:11:20.61,DCMain,CONAN,0,0,0,,وألا ترون أنه من المريب أيضاً أن سطواً مسلح حدث في نفس وقت عملية تعطيل القنبلة المزيفة
Dialogue: 0,0:11:21.68,0:11:26.56,DCMain,AGASA,0,0,0,,والتي تسببت بتجمع عددٍ كبير من الشرطة في المبنى
Dialogue: 0,0:11:26.56,0:11:29.39,DCMain,AGASA,0,0,0,,حتى أنهم ارسلوا فرقة تعطيل القنابل
Dialogue: 0,0:11:29.39,0:11:32.11,DCMain,AGASA,0,0,0,,لقد كان تضليلاً جيداً
Dialogue: 0,0:11:32.11,0:11:35.36,DCMain,MITSUHIKO,0,0,0,,لكن ألا يمكن أن تكون مصادفة؟
Dialogue: 0,0:11:35.36,0:11:38.92,DCMain,GENTA,0,0,0,,تحتاج دليلاً لكي تتهم أحداً
Dialogue: 0,0:11:39.25,0:11:44.55,DCMain,CONAN,0,0,0,,أنا أعرف هذا، لذلك قمت بتفتيشه عن قرب ولم أستطع أيجاده
Dialogue: 0,0:11:45.02,0:11:46.05,DCMain,AYUMI,0,0,0,,أيجاد ماذا؟
Dialogue: 0,0:11:46.54,0:11:47.31,DCMain,CONAN,0,0,0,,الكدمة
Dialogue: 0,0:11:47.86,0:11:48.92,DCMain,AYUMI,0,0,0,,الكدمة؟
Dialogue: 0,0:11:50.09,0:11:52.77,DCMain,CONAN,0,0,0,,قال أنه قد ضُرِبَ على رأسه من الخلف
Dialogue: 0,0:11:52.77,0:11:57.07,DCMain,CONAN,0,0,0,,لكنني لم أستطع أن اجد كدمةً أو جرحاً من أي نوع
Dialogue: 0,0:11:57.41,0:11:59.79,DCMain,MITSUHIKO,0,0,0,,اذا لم يكن قد تم ضربه، هذا يعني...
Dialogue: 0,0:11:59.79,0:12:03.32,DCMain,AYUMI,0,0,0,,تقصد أن كل ما قاله كان كذباً؟
Dialogue: 0,0:12:03.50,0:12:08.73,DCMain,AGASA,0,0,0,,بعبارةٍ أخرى، لقد قام بخداعنا نحن والشرطة
Dialogue: 0,0:12:09.26,0:12:10.98,DCMain,CONAN,0,0,0,,ليس تماما
Dialogue: 0,0:12:10.98,0:12:12.96,DCMain,AYUMI,0,0,0,,ماذا تقصد؟
Dialogue: 0,0:12:13.32,0:12:18.21,DCMain,CONAN,0,0,0,,كنت أظنه مشبوهاً منذ مدة، لذلك وضعت جهاز تعقب على دراجته
Dialogue: 0,0:12:18.21,0:12:19.48,DCMain,BOTH,0,0,0,,ماذا؟
Dialogue: 0,0:12:19.48,0:12:22.47,DCMain,GENTA,0,0,0,,هذا يعني أننا ذاهبون نحو.....
Dialogue: 0,0:12:22.99,0:12:26.71,DCMain,CONAN,0,0,0,,أجل، لقد ركن دراجته أمامنا مباشرة
Dialogue: 0,0:12:33.62,0:12:34.74,DCMain,AYUMI,0,0,0,,أنظروا
Dialogue: 0,0:12:35.47,0:12:37.36,DCMain,AYUMI,0,0,0,,أليس هذه هو السيد دانو
Dialogue: 0,0:12:40.18,0:12:42.05,DCMain,GENTA,0,0,0,,هو ليس نائماً، أليس كذلك؟
Dialogue: 0,0:12:42.05,0:12:44.37,DCMain,AYUMI,0,0,0,,هذه المرة لديه كدمةٌ كبيرة على رأسه
Dialogue: 0,0:12:44.88,0:12:48.12,DCMain,CONAN,0,0,0,,لا يزال حياً إنه فاقدٌ للوعي فقط
Dialogue: 0,0:12:48.12,0:12:49.49,DCMain,MITSUHIKO,0,0,0,,لكن لماذا؟
Dialogue: 0,0:12:49.68,0:12:52.47,DCMain,CONAN,0,0,0,,ربما حدث شجارٌ بينهم
Dialogue: 0,0:12:52.47,0:12:55.54,DCMain,CONAN,0,0,0,,ميتسوهيكو، اتصل بالإسعاف والشرطة
Dialogue: 0,0:12:55.54,0:12:56.89,DCMain,MITSUHIKO,0,0,0,,حاضر
Dialogue: 0,0:12:58.39,0:13:02.50,DCMain,CONAN,0,0,0,,حاولوا ألا تلمسوا شيئاً
Dialogue: 0,0:13:19.48,0:13:20.45,DCMain,CONAN,0,0,0,,ها هو ذا
Dialogue: 0,0:13:23.00,0:13:24.26,DCMain,AYUMI,0,0,0,,ما هذا؟
Dialogue: 0,0:13:24.26,0:13:26.03,DCMain,CONAN,0,0,0,,داش كام\Nتعريف: هي عبارة عن كاميرا تسجل باستمرار تثبت على الزجاج الأمامي للسيارة
Dialogue: 0,0:13:26.48,0:13:30.39,DCMain,CONAN,0,0,0,,توقعت وجود واحدة بما أن المفاتيح لم تكن في جيبه
Dialogue: 0,0:13:30.39,0:13:32.04,DCMain,CONAN,0,0,0,,وتم ركن دراجته بشكلٍ غريب
Dialogue: 0,0:13:32.87,0:13:37.79,DCMain,CONAN,0,0,0,,لقد أوقف دراجته بطريقةٍ تجعل المستودع مرئيًا وترك كاميرته تعمل
Dialogue: 0,0:13:38.54,0:13:41.82,DCMain,AGASA,0,0,0,,تقصد أنه لم يكن يثق بشركائه؟
Dialogue: 0,0:13:41.82,0:13:44.30,DCMain,CONAN,0,0,0,,هذا هو المقصود بالضبط
Dialogue: 0,0:13:44.65,0:13:47.33,DCMain,GENTA,0,0,0,,لدينا رؤيةٌ واضحةٌ لهم
Dialogue: 0,0:13:51.19,0:13:52.69,DCMain,AGASA,0,0,0,,هذا يبدو مؤلماً
Dialogue: 0,0:13:52.69,0:13:53.81,DCMain,CONAN,0,0,0,,سوف اتخطى القليل منه
Dialogue: 0,0:13:59.72,0:14:00.68,DCMain,CONAN,0,0,0,,ممتاز
Dialogue: 0,0:14:00.68,0:14:02.69,DCMain,MITSUHIKO,0,0,0,,تم تصويرهم بوضوح
Dialogue: 0,0:14:06.77,0:14:11.29,DCMain,CONAN,0,0,0,,مرحبا المحقق تشيبا؟\N لقد عرفنا مواصفات سيارة اللصوص
Dialogue: 0,0:14:11.29,0:14:13.45,DCMain,CONAN,0,0,0,,إنها سيارةٌ زرقاء، ورقم اللوحة هو....
Dialogue: 0,0:14:14.62,0:14:15.65,DCItalic,CONAN,0,0,0,,قبل ١٥ دقيقة
Dialogue: 0,0:14:15.65,0:14:19.90,DCItalic,CONAN,0,0,0,,انطلقوا غربًا من المصنع المهجورة في مدينة هايدو 7 تشومي
Dialogue: 0,0:14:19.90,0:14:22.24,DCMain,CHIBA,0,0,0,,فهمت، سوف ابلغ بقية الوحدات
Dialogue: 0,0:14:40.67,0:14:42.81,DCItalic,RADIO,0,0,0,,تقرير من نظام مراقبة حركة المرور
Dialogue: 0,0:14:42.81,0:14:44.51,DCItalic,RADIO,0,0,0,,تم ايجاد السيارة صاحبة الموصفات المذكورة
Dialogue: 0,0:14:48.18,0:14:49.28,DCMain,TAKAGI,0,0,0,,لننطلق
Dialogue: 0,0:15:03.25,0:15:06.26,DCItalic,RADIO,0,0,0,,السيارة المستهدفة تتجه غربًا عبر مدينة هايدو
Dialogue: 0,0:15:06.26,0:15:09.31,DCItalic,RADIO,0,0,0,,لتتجه السيارات في تلك المنطقة إلى هناك على الفور وتأمن الهدف
Dialogue: 0,0:15:11.53,0:15:12.97,DCItalic,POLICE B,0,0,0,,تم رصد المركبة الهاربة
Dialogue: 0,0:15:12.97,0:15:15.98,DCItalic,POLICE B,0,0,0,,تتجه حالياً شمالًا من استاد داشينوموتو على طريق كوم السريع\Nملاحظة : استاد تعني الملعب الرياضي الضخم
Dialogue: 0,0:15:21.02,0:15:23.65,DCMain,CONAN,0,0,0,,فلتخرج من تقاطع الطرق التالي يا بروفيسور!
Dialogue: 0,0:15:23.65,0:15:25.01,DCMain,CONAN,0,0,0,,بسرعة
Dialogue: 0,0:15:25.01,0:15:25.77,DCMain,AGASA,0,0,0,,حاضر
Dialogue: 0,0:15:25.96,0:15:27.69,DCMain,AYUMI,0,0,0,,هل هذه...؟
Dialogue: 0,0:15:27.69,0:15:29.03,DCMain,ALL,0,0,0,,مطاردةٌ بالسيارة!
Dialogue: 0,0:15:29.71,0:15:34.54,DCMain,AYUMI,0,0,0,,تم كسر حدود السرعة في مطاردةٍ تتحدى الوصف ذهابًا و إيابًا
Dialogue: 0,0:15:34.54,0:15:40.30,DCMain,AYUMI,0,0,0,,بين المجرمين والشرطة من شأنها أن تجعل حتى هوليوود تُصدم من روعتها
Dialogue: 0,0:15:41.94,0:15:44.17,DCMain,AYUMI,0,0,0,,وبعدها، أنفجارٌ ضخم
Dialogue: 0,0:15:45.41,0:15:47.55,DCMain,AYUMI,0,0,0,,...لم يحدث، وفوق كل هذا......
Dialogue: 0,0:15:55.71,0:15:58.02,DCItalic,RADIO,0,0,0,,بلاغٌ من الوحدة بس سي ٢١
Dialogue: 0,0:15:58.02,0:16:01.80,DCItalic,RADIO,0,0,0,,فقدوا أثر السيارة الهاربة شمال مقبرة هاما
Dialogue: 0,0:16:02.70,0:16:03.81,DCItalic,RADIO,0,0,0,,مرةً أخرى....
Dialogue: 0,0:16:06.62,0:16:09.82,DCMain,AYUMI,0,0,0,,أتسائل أين ذهبت سيارةُ المجرمين
Dialogue: 0,0:16:11.20,0:16:15.57,DCMain,AGASA,0,0,0,,لقد عبؤنا الاستاد ايم يجب أن نذهب الأن؟
Dialogue: 0,0:16:15.90,0:16:19.00,DCItalic,CONAN,0,0,0,,كانو يتجهون غرباً قبل أن يتم رصدهم هنا
Dialogue: 0,0:16:19.59,0:16:21.86,DCItalic,CONAN,0,0,0,,وتوجهوا شمالاً بعد رصدهم مباشرة
Dialogue: 0,0:16:26.31,0:16:28.09,DCMain,CONAN,0,0,0,,توجه يساراً عند ذلك المفترق
Dialogue: 0,0:16:28.09,0:16:28.62,DCMain,BOTH,0,0,0,,ماذا؟
Dialogue: 0,0:16:28.62,0:16:30.71,DCMain,GENTA,0,0,0,,كيف تعرف أن هذا هو الطريق الصحيح؟
Dialogue: 0,0:16:31.28,0:16:34.59,DCMain,CONAN,0,0,0,,بما أنهم بدؤوا التوجه شملاً بعد أن تم رصدهم
Dialogue: 0,0:16:34.59,0:16:37.26,DCMain,CONAN,0,0,0,,من الصعب التصديق أن تلك هي وجهتهم الحقيقية
Dialogue: 0,0:16:37.62,0:16:42.27,DCMain,CONAN,0,0,0,,علاوة على ذلك، عادةً ما يفترض مطاردوك أنك ستستمر في التوجه شمالًا بمجرد أن يفقدوا أثرك
Dialogue: 0,0:16:42.55,0:16:45.64,DCMain,CONAN,0,0,0,,لذلك سيقومون بالعكس ويتوجهوا نحو الجنوب
Dialogue: 0,0:16:45.64,0:16:47.02,DCMain,CONAN,0,0,0,,هذا ما كنت سأفعل لو كنت مكانهم
Dialogue: 0,0:16:47.23,0:16:48.30,DCMain,MITSUHIKO,0,0,0,,فهمت
Dialogue: 0,0:16:48.82,0:16:54.17,DCMain,CONAN,0,0,0,,سوف يتجنبون الطرق السريعة والطرق الرئيسية التي بها كاميرات مراقبة
Dialogue: 0,0:16:54.75,0:16:58.07,DCMain,CONAN,0,0,0,,مما يعني أنهم سيأخذون هذه الطريق على الأغلب
Dialogue: 0,0:17:08.63,0:17:11.28,DCMain,MITSUHIKO,0,0,0,,نحن نبحث عن سيارةٍ زرقاء، أليس كذلك
Dialogue: 0,0:17:11.28,0:17:13.42,DCMain,CONAN,0,0,0,,اجل، لكن
Dialogue: 0,0:17:13.42,0:17:15.80,DCMain,GENTA,0,0,0,,أين هي؟
Dialogue: 0,0:17:30.53,0:17:31.40,DCMain,AYUMI,0,0,0,,هل هي ذا
Dialogue: 0,0:17:31.96,0:17:33.35,DCMain,GENTA,0,0,0,,سيارةٌ زرقاء
Dialogue: 0,0:17:33.35,0:17:36.49,DCMain,MITSUHIKO,0,0,0,,هذه هي السيارة من الفيديو بلا أدنى شك
Dialogue: 0,0:17:36.78,0:17:38.54,DCMain,CONAN,0,0,0,,أحسنتي عملاً يا أيومي
Dialogue: 0,0:17:38.54,0:17:39.49,DCMain,AYUMI,0,0,0,,أجل!
Dialogue: 0,0:17:42.26,0:17:44.60,DCMain,CONAN,0,0,0,,لا تدعهم يهربون يا بروفيسور
Dialogue: 0,0:17:44.60,0:17:45.79,DCMain,AGASA,0,0,0,,أعرف
Dialogue: 0,0:17:46.06,0:17:47.67,DCMain,AYUMI,0,0,0,,هذه المرة هل هذه فعلاً......؟
Dialogue: 0,0:17:47.67,0:17:48.92,DCMain,ALL,0,0,0,,مطاردةٌ بالسيارة!!!
Dialogue: 0,0:17:49.41,0:17:52.28,DCMain,AYUMI,0,0,0,,وبعدها من الممكن أن يحدث هذه
Dialogue: 0,0:17:52.25,0:17:54.76,TransformButton,SIGN,0,0,0,,زرُ\Nالتحويل
Dialogue: 0,0:17:52.81,0:17:54.56,DCMain,AYUMI,0,0,0,,تحويل!
Dialogue: 0,0:18:00.14,0:18:01.68,DCMain,AYUMI,0,0,0,,ما هذا؟
Dialogue: 0,0:18:01.68,0:18:03.35,DCMain,AYUMI,0,0,0,,يا أخي
Dialogue: 0,0:18:03.35,0:18:07.69,DCMain,AYUMI,0,0,0,,أيتها الخنفساء القاتلة\Nوجي ضربةً يمنى
Dialogue: 0,0:18:15.97,0:18:18.12,DCMain,AYUMI,0,0,0,,...وهذا هو ما لم يحدث
Dialogue: 0,0:18:18.12,0:18:20.70,DCMain,AYUMI,0,0,0,,تبعنا السيارة بهدوء
Dialogue: 0,0:18:21.61,0:18:24.95,DCMain,AYUMI,0,0,0,,ووصلوا إلى موقف للسيارات خارج مجمع سكني
Dialogue: 0,0:18:28.29,0:18:30.61,DCMain,GENTA,0,0,0,,ماذا يفعلون؟
Dialogue: 0,0:18:30.61,0:18:32.84,DCMain,CONAN,0,0,0,,يحاولون سرقة سيارة!
Dialogue: 0,0:18:33.01,0:18:34.19,DCMain,MITSUHIKO,0,0,0,,هذا فظيع
Dialogue: 0,0:18:34.19,0:18:35.77,DCMain,MITSUHIKO,0,0,0,,يجب أن نوقفهم
Dialogue: 0,0:18:35.77,0:18:37.09,DCMain,CONAN,0,0,0,,أعرف
Dialogue: 0,0:18:37.09,0:18:38.34,DCMain,AYUMI,0,0,0,,هل سيكون هناك تبادل لإطلاق النار؟
Dialogue: 0,0:18:39.05,0:18:41.34,Shootout,SIGN,0,0,0,,{\fad(290,1)}تبادلٌ لإطلاق النار
Dialogue: 0,0:18:40.14,0:18:41.34,DCMain,CONAN,0,0,0,,بالطبع لع
Dialogue: 0,0:18:42.24,0:18:45.48,DCMain,CONAN,0,0,0,,لكن لا يمكننا فقط الجلوس هنا وفعل لا شيء
Dialogue: 0,0:18:47.28,0:18:50.42,DCMain,CONAN,0,0,0,,أتصل بالشرطة يا بروفيسور
Dialogue: 0,0:18:50.42,0:18:52.57,DCMain,AGASA,0,0,0,,حاضر
Dialogue: 0,0:18:52.57,0:18:56.53,DCMain,AYUMI,0,0,0,,وبعدها أقترب كونان من اللصوص
Dialogue: 0,0:18:58.68,0:19:03.27,DCMain,BAD GUY B,0,0,0,,على أي حالٍ يا أخي، لماذا كانت الشرطةُ تطاردنا؟
Dialogue: 0,0:19:03.27,0:19:05.82,DCMain,BAD GUY B,0,0,0,,لم نتخطى السرعة القانونية
Dialogue: 0,0:19:05.82,0:19:08.13,DCMain,BOD GUY A,0,0,0,,ربما أدركوا أن سيارتنا مسروقة
Dialogue: 0,0:19:08.13,0:19:09.73,DCMain,BAD GUY B,0,0,0,,هل تظن ذلك حقاً؟
Dialogue: 0,0:19:09.73,0:19:12.67,DCMain,BAD GUY B,0,0,0,,هذه السيارةُ معنا منذ الصباح
Dialogue: 0,0:19:13.01,0:19:14.40,DCMain,BAD GUY A,0,0,0,,كف عن النحيب.
Dialogue: 0,0:19:14.40,0:19:17.92,DCMain,BAD GUY A,0,0,0,,لقد نجحنا في سرقة كل هذه الكنز
Dialogue: 0,0:19:18.23,0:19:19.74,DCMain,BAD GUY B,0,0,0,,أنت محق
Dialogue: 0,0:19:19.74,0:19:23.30,DCMain,BAD GUY B,0,0,0,,خططك دائما مثاليةٌ يا أخي
Dialogue: 0,0:19:23.30,0:19:27.18,DCMain,CONAN,0,0,0,,لكن لماذا خنت دانو؟
Dialogue: 0,0:19:27.43,0:19:28.74,DCMain,BAD GUY A,0,0,0,,لماذا؟
Dialogue: 0,0:19:28.74,0:19:32.24,DCMain,BAD GUY A,0,0,0,,لكي نحتفظ بحصته من الكنوز لنا
Dialogue: 0,0:19:32.24,0:19:33.44,DCMain,BAD GUY A,0,0,0,,لحظة من تكون أنت؟
Dialogue: 0,0:19:33.65,0:19:34.93,DCMain,CONAN,0,0,0,,لقد فهمت
Dialogue: 0,0:19:34.93,0:19:39.44,DCMain,CONAN,0,0,0,,كنت تنوي استغلاله و تجاهله منذ البداية
Dialogue: 0,0:19:39.75,0:19:40.50,DCMain,BOTH,0,0,0,,ماذا؟
Dialogue: 0,0:19:41.12,0:19:42.45,DCMain,BAD GUY B,0,0,0,,من هذه الفتى؟
Dialogue: 0,0:19:42.91,0:19:45.69,DCMain,CONAN,0,0,0,,أنت هو من خطط لكل هذا، صحيح؟
Dialogue: 0,0:19:45.69,0:19:49.33,DCMain,CONAN,0,0,0,,لقد طلبت من دانو أن يسبب بعض الفوضى
Dialogue: 0,0:19:49.33,0:19:51.22,DCMain,CONAN,0,0,0,,كي تتمكنوا من سرقة متجر المجوهرات، أليس كذلك؟
Dialogue: 0,0:19:51.22,0:19:55.45,DCMain,BAD GUY A,0,0,0,,أيها طفل، لا أعرف لماذا تعتقد أنه يجب عليك التدخل
Dialogue: 0,0:19:55.45,0:19:57.96,DCMain,BAD GUY A,0,0,0,,لكنك تخطيت وقت نومك
Dialogue: 0,0:19:58.38,0:20:02.48,DCMain,CONAN,0,0,0,,عملية الهجوم على محل المجوهرات نفسها كانت بسيطة بما فيه الكفاية
Dialogue: 0,0:20:02.48,0:20:06.72,DCMain,CONAN,0,0,0,,كل ما كان عليك فعله هو تحطم حائط المتجر بالشاحنة التي سرقتها من المصنع
Dialogue: 0,0:20:06.97,0:20:08.43,DCMain,BAD GUY B,0,0,0,,كيف عرفت هذا؟
Dialogue: 0,0:20:08.93,0:20:10.98,DCMain,BAD GUY B,0,0,0,,هل كنت تراقبنا؟
Dialogue: 0,0:20:11.24,0:20:14.17,DCMain,CONAN,0,0,0,,بما أنه قبض عليك من قِبل طفل مثلي
Dialogue: 0,0:20:14.17,0:20:16.36,DCMain,CONAN,0,0,0,,ألا يعني هذه أن خطتك كانت فشلاً ذريعاً
Dialogue: 0,0:20:18.03,0:20:21.74,DCMain,CONAN,0,0,0,,أتريد مني أخبارك لماذا فشلت؟
Dialogue: 0,0:20:23.44,0:20:24.99,DCMain,BAD GUY A,0,0,0,,أجل لماذا لا تخبرنا كيف؟
Dialogue: 0,0:20:25.26,0:20:30.25,DCMain,CONAN,0,0,0,,لان السيد دانو عرف أنكم سيتم خيانته
Dialogue: 0,0:20:30.61,0:20:32.61,DCMain,CONAN,0,0,0,,من أجل مصلحتكم
Dialogue: 0,0:20:32.61,0:20:34.52,DCMain,CONAN,0,0,0,,يجب أن تستسلموا وتسلموا أنفسكم
Dialogue: 0,0:20:34.52,0:20:37.63,DCMain,BAD GUY B,0,0,0,,ما-ما الذي يجب أن نفعله يا أخي!
Dialogue: 0,0:20:38.70,0:20:42.06,DCMain,BAD GUY A,0,0,0,,أسمع أيها طفل، فلتعد إلا منزلك حالاً
Dialogue: 0,0:20:42.06,0:20:44.76,DCMain,BAD GUY A,0,0,0,,وإلا فأنك ستندم
Dialogue: 0,0:20:48.14,0:20:49.94,DCMain,CONAN,0,0,0,,توقعت أن تقول هذا
Dialogue: 0,0:20:49.94,0:20:53.02,DCMain,CONAN,0,0,0,,البالغون القذرون امثالك يجب أن يعاقبوا
Dialogue: 0,0:20:53.60,0:20:54.54,DCMain,CONAN,0,0,0,,خذ هذا
Dialogue: 0,0:20:55.23,0:20:57.21,DCMain,CONAN,0,0,0,,الضربة القتالة!
Dialogue: 0,0:21:03.30,0:21:05.03,DCMain,ALL,0,0,0,,أجل!
Dialogue: 0,0:21:05.79,0:21:11.74,DCMain,AYUMI,0,0,0,,وهكذا تم القبض على اللصوص واسترداد الجواهر
Dialogue: 0,0:21:12.26,0:21:14.91,DCMain,ALL,0,0,0,,فعلناها
Dialogue: 0,0:21:17.07,0:21:20.80,DCMain,AYUMI,0,0,0,,وعامل التوصيل الذي كان يعمل مع المجرمين تم القبض عليه أيضاً
Dialogue: 0,0:21:21.24,0:21:24.84,DCMain,AYUMI,0,0,0,,وتماماً كما أستنتج كونان
Dialogue: 0,0:21:24.84,0:21:26.78,DCMain,AYUMI,0,0,0,,عندما ذهب ليأخذ حصته من المسروقات
Dialogue: 0,0:21:26.78,0:21:30.24,DCMain,AYUMI,0,0,0,,تم ضربه على رأسه من الخلف
Dialogue: 0,0:21:30.81,0:21:33.27,Jewelry2,SIGN,0,0,0,,مجوهرات كانيكو
Dialogue: 0,0:21:33.95,0:21:39.70,DCMain,AYUMI,0,0,0,,كان صاحب المتجر سعيدًا جدًا عندما أعدنا الجواهر
Dialogue: 0,0:21:40.82,0:21:46.52,DCMain,AYUMI,0,0,0,,كمكافأة لحل القضية، سيكافئنا المحقق تاكاجي بسخاءٍ مرة أخرى
Dialogue: 0,0:21:46.52,0:21:48.63,DCMain,ALL,0,0,0,,رائع
Dialogue: 0,0:21:48.63,0:21:50.83,DCMain,TAKAGI,0,0,0,,ما زال أمامي بضع ايام قبل يوم الراتب
Dialogue: 0,0:23:14.05,0:23:18.52,DCMain,MITSUHIKO,0,0,0,,أعتقد أن المحقق تاكاجي قال إنه لم يأخذ مرتبه بعد
Dialogue: 0,0:23:18.52,0:23:21.75,DCMain,AYUMI,0,0,0,,يبدو أننا لا نستطيع أن نأمل الحصول على وجبةٍ فخمة
Dialogue: 0,0:23:23.02,0:23:24.38,DCMain,AYUMI,0,0,0,,لكن هذا ليس كل حدث
Dialogue: 0,0:23:24.38,0:23:27.54,DCMain,AYUMI,0,0,0,,كانت هناك وجبة باهظةٌ للغاية تنتظرنا
Dialogue: 0,0:23:28.21,0:23:31.76,DCMain,AYUMI,0,0,0,,شكرًا على أعطائنا ما يكفينا من الطعام
Dialogue: 0,0:23:31.76,0:23:34.14,DCMain,ALL,0,0,0,,شكراً على الطعام
Dialogue: 0,0:23:35.33,0:23:37.42,DCMain,ALL,0,0,0,,المزيد رجاءً
Dialogue: 0,0:23:40.62,0:23:43.30,DCMain,TAKAGI,0,0,0,,ألا يكفي هذا يا رفاق
