Dialogue: 0,0:00:09.56,0:00:11.69,DCMain,RAN,0,0,0,,!رائع
Dialogue: 0,0:00:11.88,0:00:15.38,DCMain,CONAN,0,0,0,,هذا مخيم ترِف بدل المخيم العادي
Dialogue: 0,0:00:15.38,0:00:18.28,DCMain,SONOKO,0,0,0,,وما أدراك؟
Dialogue: 0,0:00:18.28,0:00:20.95,DCMain,CONAN,0,0,0,,شاهدته على التلفاز بالأمس
Dialogue: 0,0:00:21.11,0:00:25.96,DCMain,SONOKO,0,0,0,,سُمي هذا المخيم بالترِف لوجود كل سبل الراحة فيه
Dialogue: 0,0:00:26.33,0:00:29.09,DCMain,SONOKO,0,0,0,,لنستمتع اليوم يا ران
Dialogue: 0,0:00:29.78,0:00:30.84,DCMain,RAN,0,0,0,,نعم
Dialogue: 0,0:00:33.68,0:00:37.47,DCMain,SONOKO,0,0,0,,مسرورة لأننا لم نحضر سوى ملابسنا
Dialogue: 0,0:00:37.47,0:00:41.35,DCMain,RAN,0,0,0,,لو كنا في مخيم عادي لأحضرنا العديد من المعدات
Dialogue: 0,0:00:41.35,0:00:45.23,DCMain,RAN,0,0,0,,عندها سنحتاج لأبي
Dialogue: 0,0:00:45.23,0:00:47.77,DCItalic,CONAN,0,0,0,,لحمل أمتعتك؟
Dialogue: 0,0:00:47.77,0:00:49.86,DCMain,WOMAN,0,0,0,,سألتقط الصورة
Dialogue: 0,0:00:54.22,0:00:55.86,DCMain,ALL,0,0,0,,حسنًا
Dialogue: 0,0:00:57.56,0:00:58.74,DCMain,MAN,0,0,0,,هل التقطتها؟
Dialogue: 0,0:00:59.45,0:01:01.53,DCMain,RAN,0,0,0,,كونان-كن تعال إلى هنا
Dialogue: 0,0:01:01.53,0:01:03.00,DCMain,CONAN,0,0,0,,حاضر
Dialogue: 0,0:01:03.89,0:01:05.79,DCMain,MAN,0,0,0,,تبدو رائعة
Dialogue: 0,0:01:05.79,0:01:06.96,DCMain,MAN,0,0,0,,دعني أرى
Dialogue: 0,0:03:11.20,0:03:13.33,DCMain,RAN,0,0,0,,!إنها كبيرة
Dialogue: 0,0:03:13.33,0:03:14.38,DCMain,CONAN,0,0,0,,نعم
Dialogue: 0,0:03:14.38,0:03:15.78,DCMain,SONOKO,0,0,0,,!مرحى
Dialogue: 0,0:03:16.28,0:03:18.17,DCMain,SONOKO,0,0,0,,!الأسرّة مريحة
Dialogue: 0,0:03:18.34,0:03:19.88,DCMain,SONOKO,0,0,0,,لنمرح الآن
Dialogue: 0,0:03:19.88,0:03:21.20,DCMain,RAN,0,0,0,,
Dialogue: 0,0:03:29.38,0:03:31.52,DCMain,ALL,0,0,0,,لنأكل
Dialogue: 0,0:03:34.16,0:03:36.34,DCMain,RAN,0,0,0,,!العشاء فاخر
Dialogue: 0,0:03:39.61,0:03:40.78,DCMain,RAN,0,0,0,,!لذيذ
Dialogue: 0,0:03:40.97,0:03:45.03,DCMain,SONOKO,0,0,0,,صحيح، لا أصدق بأننا في مخيم
Dialogue: 0,0:03:45.03,0:03:47.16,DCMain,CONAN,0,0,0,,ليس مخيمًا عاديًا
Dialogue: 0,0:03:47.16,0:03:50.66,DCMain,SONOKO,0,0,0,,اصمت يا فتى، لو لم نحضرك لما كنت ستستمع اليوم
Dialogue: 0,0:03:50.66,0:03:52.44,DCMain,CONAN,0,0,0,,أعتذر
Dialogue: 0,0:03:58.24,0:03:59.42,DCMain,CONAN,0,0,0,,تفضلا
Dialogue: 0,0:03:59.58,0:04:02.21,DCMain,SONOKO,0,0,0,,شكرًا لك
Dialogue: 0,0:04:02.21,0:04:05.93,DCMain,CONAN,0,0,0,,ران-نيتشان أعدت هذه الكعكات
Dialogue: 0,0:04:09.51,0:04:10.86,DCMain,RAN,0,0,0,,!جميلة
Dialogue: 0,0:04:27.77,0:04:28.87,DCMain,CONAN,0,0,0,,ماذا يجري؟
Dialogue: 0,0:04:29.60,0:04:32.58,DCMain,SONOKO,0,0,0,,ماذا حدث، أهذه مزحة؟
Dialogue: 0,0:04:32.94,0:04:36.71,DCMain,SONOKO,0,0,0,,يرتدي لباس امرأة ووجهه ملطخ بالألوان
Dialogue: 0,0:04:36.71,0:04:40.99,DCMain,SONOKO,0,0,0,,ومقص سلطعون في فمه وورقة في يده
Dialogue: 0,0:04:40.99,0:04:42.26,DCMain,CONAN,0,0,0,,ران-نيتشان اتصلي بالإسعاف
Dialogue: 0,0:04:42.55,0:04:44.00,DCMain,CONAN,0,0,0,,والشرطة
Dialogue: 0,0:04:44.00,0:04:45.32,DCMain,RAN,0,0,0,,حسنًا
Dialogue: 0,0:04:46.75,0:04:49.49,DCMain,RAN,0,0,0,,مرحبًا، تعالوا في الحال
Dialogue: 0,0:04:49.49,0:04:51.68,DCMain,RAN,0,0,0,,نحن في مخيم أوكوهوكو الترِف
Dialogue: 0,0:04:52.77,0:04:53.94,DCMain,CONAN,0,0,0,,إنه ميت
Dialogue: 0,0:04:54.80,0:04:56.19,DCMain,MIURA,0,0,0,,!توساكي-سان
Dialogue: 0,0:04:56.46,0:04:57.80,DCMain,TANABE,0,0,0,,ما الذي حدث له؟
Dialogue: 0,0:04:58.53,0:04:59.65,DCMain,KYOKO,0,0,0,,..عزيزي
Dialogue: 0,0:05:02.83,0:05:04.64,DCMain,KYOKO,0,0,0,,كيف حصل هذا؟
Dialogue: 0,0:05:05.67,0:05:07.45,DCMain,KYOKO,0,0,0,,لم أفعل هذا
Dialogue: 0,0:05:09.18,0:05:10.83,DCMain,TANABE,0,0,0,,هناك المزيد
Dialogue: 0,0:05:11.91,0:05:13.87,DCMain,SONOKO,0,0,0,,هل تعرفونه؟
Dialogue: 0,0:05:14.93,0:05:18.47,DCMain,TANABE,0,0,0,,نعم، أعتقد
Dialogue: 0,0:05:18.47,0:05:21.25,DCMain,KYOKO,0,0,0,,إنه زوجي
Dialogue: 0,0:05:22.01,0:05:24.61,DCMain,CONAN,0,0,0,,هل فعلتما شيئًا له؟
Dialogue: 0,0:05:27.22,0:05:30.39,DCMain,TANABE,0,0,0,,أنا آسف، لونت وجهه فقط
Dialogue: 0,0:05:30.39,0:05:31.72,DCMain,TANABE,0,0,0,,لكنني لم أقتله
Dialogue: 0,0:05:31.72,0:05:33.56,DCMain,KYOKO,0,0,0,,تانابي-سان أنت أيضًا؟
Dialogue: 0,0:05:33.78,0:05:34.60,DCMain,ALL,0,0,0,,أيضًا؟
Dialogue: 0,0:05:34.84,0:05:36.87,DCMain,MIURA,0,0,0,,وأنتِ أيضًا؟
Dialogue: 0,0:05:41.94,0:05:44.88,DCMain,KYOKO,0,0,0,,{\an8}اسمي توساكي كيوكو
Dialogue: 0,0:05:45.34,0:05:47.86,DCMain,KYOKO,0,0,0,,{\an8}وزوجي اسمه توساكي كيداي
Dialogue: 0,0:05:48.35,0:05:51.05,DCMain,KYOKO,0,0,0,,وهو رئيس شركة صغيرة
Dialogue: 0,0:05:51.05,0:05:53.60,DCMain,KYOKO,0,0,0,,جئنا هنا مع ميورا-سان
Dialogue: 0,0:05:53.60,0:05:58.75,DCMain,KYOKO,0,0,0,,لنأكل ما صنعت وما أعد الطاهي تانابي-سان
Dialogue: 0,0:05:59.16,0:06:01.04,DCMain,TANABE,0,0,0,,{\an8}اسمي تانابي هيروشي
Dialogue: 0,0:06:01.04,0:06:03.75,DCMain,TANABE,0,0,0,,{\an8}أعمل في هذا المكان
Dialogue: 0,0:06:04.39,0:06:08.28,DCMain,TANABE,0,0,0,,والرئيس توساكي زبون دائم لنا
Dialogue: 0,0:06:08.80,0:06:10.52,DCMain,MIURA,0,0,0,,{\an8}أنا ميورا ميكا
Dialogue: 0,0:06:10.52,0:06:12.89,DCMain,MIURA,0,0,0,,{\an8}وأنا خبيرة تجميل
Dialogue: 0,0:06:13.26,0:06:16.95,DCMain,MIURA,0,0,0,,..عملت مع توساكي-سان قبل أيام
Dialogue: 0,0:06:16.95,0:06:19.13,DCMain,MIURA,0,0,0,,في بعض الصور الإعلانية
Dialogue: 0,0:06:19.13,0:06:21.90,DCMain,MIURA,0,0,0,,وقد أعجب بعملي
Dialogue: 0,0:06:22.32,0:06:26.40,DCMain,MIURA,0,0,0,,لهذا دعاني اليوم إلى هنا
Dialogue: 0,0:06:26.40,0:06:30.07,DCMain,TANABE,0,0,0,,كان سعيدًا قبل المساء
Dialogue: 0,0:06:30.07,0:06:31.78,DCMain,KYOKO,0,0,0,,انظروا، هذه صورنا
Dialogue: 0,0:06:32.06,0:06:34.26,DCMain,KYOKO,0,0,0,,التقطنا كل هذه
Dialogue: 0,0:06:34.26,0:06:39.42,DCMain,KYOKO,0,0,0,,ذهبنا للتجديف وتناولنا الشواء الذي أعده تانابي في الغداء
Dialogue: 0,0:06:39.84,0:06:43.54,DCMain,KYOKO,0,0,0,,بعدها شربنا الشاي مع كعكات ميورا-سان
Dialogue: 0,0:06:44.06,0:06:47.80,DCMain,CONAN,0,0,0,,كيف حدث هذا لزوجك؟
Dialogue: 0,0:06:48.06,0:06:49.42,DCMain,KYOKO,0,0,0,,لا أعلم
Dialogue: 0,0:06:49.87,0:06:53.92,DCMain,KYOKO,0,0,0,,..ذهبت للخارج وعندما عدت
Dialogue: 0,0:06:55.01,0:06:56.31,DCItalic,KYOKO,0,0,0,,..عزيزي
Dialogue: 0,0:06:56.61,0:07:02.06,DCMain,KYOKO,0,0,0,,كنت سأصرخ لكنني لاحظت شيئًا
Dialogue: 0,0:07:02.25,0:07:03.46,DCMain,RAN,0,0,0,,ما هو؟
Dialogue: 0,0:07:03.94,0:07:07.68,DCMain,KYOKO,0,0,0,,ظننت أن اللوم سيُلقى علي
Dialogue: 0,0:07:08.71,0:07:11.57,DCMain,KYOKO,0,0,0,,لذا قررت فعل شيء يبعد الشبهة عني
Dialogue: 0,0:07:12.45,0:07:13.95,DCItalic,CONAN,0,0,0,,أأنت جادة؟
Dialogue: 0,0:07:14.44,0:07:16.33,DCMain,KYOKO,0,0,0,,حملته إلى غرفة تانابي-سان حتى يُتهم
Dialogue: 0,0:07:17.00,0:07:22.96,DCMain,KYOKO,0,0,0,,ووضعت مقص السلطعون في فمه
Dialogue: 0,0:07:23.92,0:07:25.21,DCItalic,KYOKO,0,0,0,,سيَفي هذا بالغرض
Dialogue: 0,0:07:25.47,0:07:26.88,DCMain,TANABE,0,0,0,,كيف لك أن تفعلي هذا؟
Dialogue: 0,0:07:26.88,0:07:29.59,DCMain,TANABE,0,0,0,,أنت التي تركت الجثة في غرفتي
Dialogue: 0,0:07:30.04,0:07:31.26,DCMain,KYOKO,0,0,0,,..لكن
Dialogue: 0,0:07:31.26,0:07:32.63,DCMain,TANABE,0,0,0,,لكن ماذا؟
Dialogue: 0,0:07:32.63,0:07:33.93,DCMain,RAN,0,0,0,,اهدؤوا
Dialogue: 0,0:07:33.93,0:07:37.10,DCMain,SONOKO,0,0,0,,لِم وضعت مقص السلطعون في فمه؟
Dialogue: 0,0:07:37.42,0:07:42.89,DCMain,KYOKO,0,0,0,,لأنني وجدتها في ثلاجة تانابي-سان
Dialogue: 0,0:07:42.89,0:07:46.36,DCMain,KYOKO,0,0,0,,ظننت أن الطاهي سيُتهم إن وُجد طعام على الجثة
Dialogue: 0,0:07:46.67,0:07:47.95,DCMain,TANABE,0,0,0,,{\an8}حقًا؟
Dialogue: 0,0:07:46.67,0:07:48.94,DCMain,SONOKO,0,0,0,,!نقلت جسده
Dialogue: 0,0:07:48.94,0:07:50.74,DCMain,CONAN,0,0,0,,تانابي-سان، ماذا فعلت بعدها؟
Dialogue: 0,0:07:50.92,0:07:53.74,DCMain,TANABE,0,0,0,,..من، أنا
Dialogue: 0,0:07:54.06,0:07:57.24,DCMain,TANABE,0,0,0,,وجدت جثة توساكي-سان عندما عدت لغرفتي
Dialogue: 0,0:07:57.74,0:08:00.25,DCMain,TANABE,0,0,0,,ولسبب ما وضع أحدهم مقص السلطعون في فمه
Dialogue: 0,0:08:00.55,0:08:04.32,DCMain,TANABE,0,0,0,,..كنت سأتصل بأحدهم لكنني قررت ألا أفعل
Dialogue: 0,0:08:04.32,0:08:07.63,DCMain,TANABE,0,0,0,,حتى لا أُتهم
Dialogue: 0,0:08:08.13,0:08:13.84,DCMain,TANABE,0,0,0,,لهذا قررت أن أورط صاحبة النظارة التي جاءت مع توساكي-سان
Dialogue: 0,0:08:14.58,0:08:16.97,DCMain,MIURA,0,0,0,,أين إنسانيتك؟
Dialogue: 0,0:08:16.97,0:08:18.64,DCMain,RAN,0,0,0,,اهدؤوا
Dialogue: 0,0:08:18.93,0:08:20.13,DCMain,CONAN,0,0,0,,ثم؟
Dialogue: 0,0:08:20.79,0:08:24.39,DCMain,TANABE,0,0,0,,قالت بأنها تستخدم المستحضرات التجميلية
Dialogue: 0,0:08:25.00,0:08:26.41,DCMain,TANABE,0,0,0,,..لهذا أخذت قلمًا ملونًا
Dialogue: 0,0:08:26.41,0:08:28.50,DCMain,RAN,0,0,0,,..ورسمت على وجهه
Dialogue: 0,0:08:28.50,0:08:29.65,DCMain,TANABE,0,0,0,,مستخدمًا أدواتها
Dialogue: 0,0:08:29.88,0:08:32.61,DCMain,MIURA,0,0,0,,ليس لديك أي احترام لعملي
Dialogue: 0,0:08:32.61,0:08:33.78,DCMain,SONOKO,0,0,0,,لا يبدو الأمر هكذا
Dialogue: 0,0:08:33.97,0:08:37.78,DCMain,CONAN,0,0,0,,ثم نقلت توساكي-سان لخيمة ميورا-سان
Dialogue: 0,0:08:37.78,0:08:38.69,DCMain,TANABE,0,0,0,,نعم
Dialogue: 0,0:08:38.69,0:08:39.96,DCMain,MIURA,0,0,0,,أنت دنيء
Dialogue: 0,0:08:39.96,0:08:41.36,DCMain,CONAN,0,0,0,,وماذا عنك يا ميورا-سان
Dialogue: 0,0:08:41.36,0:08:43.79,DCMain,MIURA,0,0,0,,..أنا
Dialogue: 0,0:08:44.72,0:08:46.13,DCMain,MIURA,0,0,0,,عندما عدت لخيمتي
Dialogue: 0,0:08:46.13,0:08:50.30,DCMain,MIURA,0,0,0,,وجدت جثة توساكي-سان مع مقص سلطعون في فمه \Nوألوان على وجهه
Dialogue: 0,0:08:50.65,0:08:56.30,DCMain,MIURA,0,0,0,,كنت سأصرخ لكني خشيت أن أثير الشبهات حولي
Dialogue: 0,0:08:58.62,0:09:01.81,DCMain,MIURA,0,0,0,,"وكتبت على ورقة "زوجتي هي الفاعلة
Dialogue: 0,0:09:02.12,0:09:07.19,DCMain,MIURA,0,0,0,,ووضعتها في يده وحاولت نقله لخيمته
Dialogue: 0,0:09:07.38,0:09:10.66,DCMain,MIURA,0,0,0,,لكنه كان ثقيلًا فتركته وهربت
Dialogue: 0,0:09:11.31,0:09:13.47,DCMain,TANABE,0,0,0,,إن فعلت شيئًا فأتمّيه
Dialogue: 0,0:09:13.47,0:09:16.28,DCMain,KYOKO,0,0,0,,لماذا اتهمتني؟
Dialogue: 0,0:09:16.28,0:09:18.11,DCMain,MIURA,0,0,0,,لم أعني ذلك
Dialogue: 0,0:09:18.11,0:09:22.37,DCMain,MIURA,0,0,0,,لكن الشبهة تُقدم للأقربين أولًا
Dialogue: 0,0:09:23.65,0:09:25.47,DCMain,SONOKO,0,0,0,,{\an8}!جميعهم نقلوه
Dialogue: 0,0:09:23.65,0:09:25.47,DCMain,KYOKO,0,0,0,,!سئمت منك
Dialogue: 0,0:09:25.47,0:09:27.63,DCMain,MIURA,0,0,0,,لم أرد أن توجه التهمة لي أيضًا
Dialogue: 0,0:09:26.77,0:09:28.40,DCMain,RAN,0,0,0,,اهدؤوا
Dialogue: 0,0:09:28.40,0:09:30.21,DCMain,CONAN,0,0,0,,ألا يعون بأن أحدهم مقتول
Dialogue: 0,0:09:30.42,0:09:33.46,DCMain,TANABE,0,0,0,,..ماذا؟ أظهرتنا كأشخاص سيئين
Dialogue: 0,0:09:33.64,0:09:35.93,DCMain,TANABE,0,0,0,,رغم أنك أسوؤنا
Dialogue: 0,0:09:35.93,0:09:37.54,DCMain,KYOKO,0,0,0,,ماذا قلت؟
Dialogue: 0,0:09:37.54,0:09:38.72,DCMain,MEGURE,0,0,0,,هذا يكفي
Dialogue: 0,0:09:39.62,0:09:41.47,DCMain,MEGURE,0,0,0,,أنا ميغوري من شرطة العاصمة
Dialogue: 0,0:09:41.85,0:09:44.22,DCMain,MEGURE,0,0,0,,أنتم المتورطون في القضية؟
Dialogue: 0,0:09:44.50,0:09:46.96,DCMain,CONAN,0,0,0,,المفتش ميغوري، والضابط تاكاغي
Dialogue: 0,0:09:46.96,0:09:52.49,DCMain,TAKAGI,0,0,0,,كونان-كن، دائمًا توجد أينما تحدث القضايا
Dialogue: 0,0:09:53.48,0:09:58.45,DCMain,MEGURE,0,0,0,,لِم لا تخبرونا بما حدث؟
Dialogue: 0,0:10:01.18,0:10:04.49,DCMain,MEGURE,0,0,0,,فهمت الأمر الآن
Dialogue: 0,0:10:04.82,0:10:08.00,DCMain,MEGURE,0,0,0,,أهناك شيء آخر لاحظته؟
Dialogue: 0,0:10:08.00,0:10:10.71,DCMain,KYOKO,0,0,0,,شيء لاحظته؟
Dialogue: 0,0:10:10.99,0:10:14.16,DCMain,TAKAGI,0,0,0,,لِم وضعت مقص السلطعون في فمه يا سيدتي؟
Dialogue: 0,0:10:14.16,0:10:19.20,DCMain,KYOKO,0,0,0,,في الحقيقة، لأن زوجي لديه حساسية تجاه السلطعون
Dialogue: 0,0:10:19.20,0:10:20.72,DCMain,MEGURE,0,0,0,,حساسية؟
Dialogue: 0,0:10:21.08,0:10:25.28,DCMain,KYOKO,0,0,0,,..في إحدى المرات تناول طبقًا يحتوي السلطعون
Dialogue: 0,0:10:25.28,0:10:27.73,DCMain,KYOKO,0,0,0,,وكاد يموت
Dialogue: 0,0:10:28.10,0:10:31.98,DCMain,KYOKO,0,0,0,,منذ ذلك الحين وهو لا يحب حتى النظر إلى أي سلطعون
Dialogue: 0,0:10:32.19,0:10:33.45,DCMain,TAKAGI,0,0,0,,..أكانت تلك
Dialogue: 0,0:10:33.45,0:10:35.06,DCMain,CONAN,0,0,0,,نوبة حساسية
Dialogue: 0,0:10:35.06,0:10:36.86,DCMain,SONOKO,0,0,0,,...نوبة ح
Dialogue: 0,0:10:37.14,0:10:42.36,DCMain,TAKAGI,0,0,0,,يموت العديد من الأشخاص سنويًا بسبب الحساسية
Dialogue: 0,0:10:42.36,0:10:45.64,DCMain,TAKAGI,0,0,0,,..إن أُسعف المصاب بسرعة فسينجو
Dialogue: 0,0:10:45.64,0:10:48.36,DCMain,TAKAGI,0,0,0,,أما لو تأخر إسعافه فسيهلك
Dialogue: 0,0:10:49.80,0:10:52.89,DCMain,MEGURE,0,0,0,,هل يعلم أحد غيرك بشأن هذا؟
Dialogue: 0,0:10:52.89,0:10:55.17,DCMain,KYOKO,0,0,0,,نعم، تانابي-سان
Dialogue: 0,0:10:55.86,0:10:58.02,DCMain,TANABE,0,0,0,,نعم أعلم
Dialogue: 0,0:10:58.02,0:11:02.14,DCMain,TANABE,0,0,0,,لقد أخبرني توساكي-سان وعاملو المخيم ألا أستخدم السلطعون
Dialogue: 0,0:11:02.33,0:11:07.12,DCMain,MEGURE,0,0,0,,فهمت، كنتما تعلمان إذًا
Dialogue: 0,0:11:07.12,0:11:11.45,DCMain,TAKAGI,0,0,0,,لِم لم تذكر أمر حساسيته عندما رأيت السلطعون؟
Dialogue: 0,0:11:11.45,0:11:14.58,DCMain,TANABE,0,0,0,,!لم يسألني أحد
Dialogue: 0,0:11:15.24,0:11:20.53,DCMain,TANABE,0,0,0,,أكانت تلك المرأة الحقيرة تحاول توريطي حقًا؟
Dialogue: 0,0:11:20.53,0:11:24.91,DCMain,MEGURE,0,0,0,,من الصعب اكتشاف ما تفكر به الزوجة
Dialogue: 0,0:11:25.37,0:11:27.14,DCMain,TANABE,0,0,0,,..هل تعلمون
Dialogue: 0,0:11:27.59,0:11:30.41,DCMain,TANABE,0,0,0,,أن علاقتها مع زوجها كانت سيئة
Dialogue: 0,0:11:30.71,0:11:31.73,DCMain,TAKAGI,0,0,0,,
Dialogue: 0,0:11:31.73,0:11:35.18,DCMain,TANABE,0,0,0,,..كانا يتظاهران بالوفاق أمام الناس
Dialogue: 0,0:11:35.18,0:11:37.92,DCMain,TANABE,0,0,0,,وفي الواقع هما دائما الشجار
Dialogue: 0,0:11:38.56,0:11:42.27,DCMain,TANABE,0,0,0,,الزوجة سيئة جدًا وزوجها نذلٌ أيضًا
Dialogue: 0,0:11:42.98,0:11:47.04,DCMain,TANABE,0,0,0,,ربما تكون تلك الشابة خليلة الزوج
Dialogue: 0,0:11:49.18,0:11:51.50,DCMain,MIURA,0,0,0,,!لا يمكن أن تكون جادًا
Dialogue: 0,0:11:51.50,0:11:53.56,DCMain,MIURA,0,0,0,,لِم قد أفعل هذا؟
Dialogue: 0,0:11:54.51,0:11:58.31,DCMain,MIURA,0,0,0,,توساكي-سان معجب بعملي فقط
Dialogue: 0,0:11:58.79,0:12:00.57,DCMain,MIURA,0,0,0,,هذا كل ما في الأمر
Dialogue: 0,0:12:00.57,0:12:04.57,DCMain,TAKAGI,0,0,0,,مهلًا، هل لاحظت أي شيء؟
Dialogue: 0,0:12:05.10,0:12:06.09,DCMain,MIURA,0,0,0,,لا
Dialogue: 0,0:12:07.13,0:12:11.58,DCItalic,CONAN,0,0,0,,بناءً على اعترافاتهم فإن لكل منهم دافع للقتل
Dialogue: 0,0:12:12.53,0:12:16.05,DCItalic,CONAN,0,0,0,,..إن كانت علاقتهما متوترة كما قال تانابي-سان
Dialogue: 0,0:12:16.05,0:12:17.96,DCItalic,CONAN,0,0,0,,فسيكون لكيوكو-سان دافع لقتله
Dialogue: 0,0:12:18.59,0:12:24.99,DCItalic,CONAN,0,0,0,,لكن تانابي-سان لم يقل شيئًا حتى الآن رغم علمه بشأن\Nحساسية توساكي-سان تجاه السلطعون
Dialogue: 0,0:12:25.65,0:12:28.92,DCItalic,CONAN,0,0,0,,..إن كان استنتاج تانابي-سان صحيحًا
Dialogue: 0,0:12:28.92,0:12:34.06,DCItalic,CONAN,0,0,0,,فسيكون أمر توريط ميورا-سان لكيوكو-سان معقولًا
Dialogue: 0,0:12:34.78,0:12:40.07,DCItalic,CONAN,0,0,0,,لكن الأكيد الآن هو أن أحدهم كاذب
Dialogue: 0,0:12:43.84,0:12:45.49,DCMain,CONAN,0,0,0,,مساء الخير يا رجال المباحث
Dialogue: 0,0:12:45.49,0:12:48.07,DCMain,FORENSICS,0,0,0,,أنت طفل موري-سان
Dialogue: 0,0:12:48.39,0:12:53.03,DCMain,CONAN,0,0,0,,هل أصيب هذا الشخص بنوبة حساسية؟
Dialogue: 0,0:12:53.03,0:12:53.92,DCMain,FORENSICS,0,0,0,,نعم
Dialogue: 0,0:12:54.38,0:12:56.71,DCMain,FORENSICS,0,0,0,,لم نحلل الجثة بعد
Dialogue: 0,0:12:57.14,0:13:00.15,DCMain,FORENSICS,0,0,0,,..لكن الخدوش على رقبته
Dialogue: 0,0:13:00.15,0:13:02.96,DCMain,FORENSICS,0,0,0,,..والتورم حول فمه
Dialogue: 0,0:13:02.96,0:13:06.69,DCMain,FORENSICS,0,0,0,,يشيران إلى أنه تعرض لنوبة حساسية
Dialogue: 0,0:13:06.69,0:13:07.76,DCMain,CONAN,0,0,0,,فهمت
Dialogue: 0,0:13:07.76,0:13:10.77,DCMain,FORENSICS,0,0,0,,على أي حال، كيف عرفت هذا؟
Dialogue: 0,0:13:10.77,0:13:12.97,DCMain,CONAN,0,0,0,,عمي كوغورو علمني
Dialogue: 0,0:13:14.17,0:13:15.10,DCMain,CONAN,0,0,0,,شكرًا لكم
Dialogue: 0,0:13:15.97,0:13:19.61,DCItalic,CONAN,0,0,0,,من المؤكد أنه تعرض لنوبة حساسية
Dialogue: 0,0:13:20.35,0:13:21.39,DCItalic,CONAN,0,0,0,,..مما يعني
Dialogue: 0,0:13:30.25,0:13:32.45,DCItalic,CONAN,0,0,0,,..إن كان استنتاجي صائبًا
Dialogue: 0,0:13:35.22,0:13:36.35,DCItalic,CONAN,0,0,0,,وجدتها
Dialogue: 0,0:13:39.21,0:13:41.40,DCMain,KYOKO,0,0,0,,إلى متى سننتظر؟
Dialogue: 0,0:13:43.10,0:13:45.63,DCMain,RAN,0,0,0,,كونان-كن، تأخرت في الحمام
Dialogue: 0,0:13:45.63,0:13:47.23,DCMain,RAN,0,0,0,,هل تعاني من ألم في المعدة؟
Dialogue: 0,0:13:47.23,0:13:48.47,DCMain,CONAN,0,0,0,,أنا بخير
Dialogue: 0,0:13:49.22,0:13:50.22,DCMain,CONAN,0,0,0,,يا عمة
Dialogue: 0,0:13:51.47,0:13:52.64,DCMain,KYOKO,0,0,0,,عمة؟
Dialogue: 0,0:13:52.90,0:13:55.28,DCMain,CONAN,0,0,0,,أعني آنسة
Dialogue: 0,0:13:55.28,0:13:57.84,DCMain,CONAN,0,0,0,,هل يمكنني رؤية الصور مرة أخرى؟
Dialogue: 0,0:13:57.84,0:13:59.52,DCMain,KYOKO,0,0,0,,بالطبع
Dialogue: 0,0:14:00.29,0:14:01.77,DCMain,KYOKO,0,0,0,,تفضل
Dialogue: 0,0:14:05.69,0:14:07.26,DCMain,CONAN,0,0,0,,أريد نسخها يا عمتي
Dialogue: 0,0:14:07.26,0:14:08.53,DCMain,KYOKO,0,0,0,,لست عمتك
Dialogue: 0,0:14:09.48,0:14:11.02,DCMain,CONAN,0,0,0,,ران-نيتشان
Dialogue: 0,0:14:11.02,0:14:14.04,DCMain,RAN,0,0,0,,كونان-كن عليك أن تناديها بالآنسة
Dialogue: 0,0:14:14.42,0:14:16.08,DCMain,CONAN,0,0,0,,أيمكنك إسداء معروف لي؟
Dialogue: 0,0:14:23.53,0:14:26.06,DCItalic,CONAN,0,0,0,,كل شيء جاهز
Dialogue: 0,0:14:27.11,0:14:29.98,DCItalic,CONAN,0,0,0,,كل ما بقي هو كشف القاتل
Dialogue: 0,0:14:36.03,0:14:38.94,DCMain,KYOKO,0,0,0,,عذرًا ولكن كم من الوقت سنبقى هنا؟
Dialogue: 0,0:14:39.34,0:14:42.32,DCMain,TANABE,0,0,0,,لدي عمل في الصباح
Dialogue: 0,0:14:42.32,0:14:45.28,DCMain,MIURA,0,0,0,,لا يمكننا البقاء طويلًا
Dialogue: 0,0:14:45.28,0:14:47.69,DCMain,MIURA,0,0,0,,علي أن أغادر بسرعة
Dialogue: 0,0:14:48.12,0:14:50.05,DCMain,SONOKO,0,0,0,,سأصاب بالبرد
Dialogue: 0,0:14:50.05,0:14:52.99,DCMain,SONOKO,0,0,0,,..وستتأثر بشرتي
Dialogue: 0,0:14:52.99,0:14:56.20,DCMain,KYOKO,0,0,0,,إن لم تكتشفوا الحقيقة فلا فائدة من بقائنا هنا
Dialogue: 0,0:14:56.63,0:14:59.53,DCMain,MEGURE,0,0,0,,ما باليد حيلة، سنستأنف في الغد
Dialogue: 0,0:14:59.53,0:15:00.96,DCMain,SONOKO,0,0,0,,مهلًا
Dialogue: 0,0:15:02.16,0:15:03.48,DCMain,KYOKO,0,0,0,,ماذا؟
Dialogue: 0,0:15:03.48,0:15:04.46,DCMain,SONOKO,0,0,0,,..أيها المفتش ميغوري
Dialogue: 0,0:15:04.84,0:15:06.36,DCMain,SONOKO,0,0,0,,حللت القضية
Dialogue: 0,0:15:06.36,0:15:08.97,DCMain,SONOKO,0,0,0,,هل لي أن أخبركم؟
Dialogue: 0,0:15:09.92,0:15:12.82,DCMain,TAKAGI,0,0,0,,..سونوكو-سان لا يمكنك
Dialogue: 0,0:15:12.82,0:15:16.22,DCMain,MEGURE,0,0,0,,ممتاز، لنستمع إلى سونوكو-كن
Dialogue: 0,0:15:16.58,0:15:17.97,DCMain,SONOKO,0,0,0,,شكرًا لك
Dialogue: 0,0:15:18.65,0:15:22.85,DCMain,SONOKO,0,0,0,,كان من المفترض أن تكون هذه القضية جريمة بسيطة
Dialogue: 0,0:15:22.85,0:15:25.86,DCMain,SONOKO,0,0,0,,..لكن الأشخاص المستهترين هنا
Dialogue: 0,0:15:25.86,0:15:29.49,DCMain,SONOKO,0,0,0,,حولوها إلى جريمة معقدة
Dialogue: 0,0:15:29.87,0:15:33.01,DCMain,SONOKO,0,0,0,,وأوقعوا الشبهة على أنفسهم
Dialogue: 0,0:15:33.01,0:15:35.68,DCMain,SONOKO,0,0,0,,وحاولوا توريط غيرهم
Dialogue: 0,0:15:36.37,0:15:39.03,DCMain,SONOKO,0,0,0,,وضعت الزوجة كيوكو-سان مقص سلطعون في فمه
Dialogue: 0,0:15:39.03,0:15:41.72,DCMain,SONOKO,0,0,0,,ولون الطاهي تانابي-سان وجهه
Dialogue: 0,0:15:41.72,0:15:45.00,DCMain,SONOKO,0,0,0,,وتركت ميورا-سان رسالة في يده
Dialogue: 0,0:15:45.60,0:15:49.76,DCMain,SONOKO,0,0,0,,إضافة لهذا، جميعهم قاموا بنقل الجثة من مكان لآخر
Dialogue: 0,0:15:50.52,0:15:53.68,DCMain,SONOKO,0,0,0,,أيها الضابط تاكاغي، هل حددتم سبب الوفاة؟
Dialogue: 0,0:15:53.68,0:15:57.14,DCMain,TAKAGI,0,0,0,,..نعم، بعد تحليل الجثة وأخذ اعترافاتهم بعين الاعتبار
Dialogue: 0,0:15:57.32,0:16:02.62,DCMain,TAKAGI,0,0,0,,تبين لنا بأنه توفي بسبب نوبة حساسية جراء تناوله للسلطعون
Dialogue: 0,0:16:03.11,0:16:06.15,DCMain,SONOKO,0,0,0,,..إن كان تعرض لنوبة حساسية
Dialogue: 0,0:16:06.48,0:16:09.87,DCMain,SONOKO,0,0,0,,فيجب أن يكون المجرم على علم بهذا
Dialogue: 0,0:16:09.87,0:16:11.28,DCMain,KYOKO,0,0,0,,!لا يمكن أن تكوني جادة
Dialogue: 0,0:16:11.28,0:16:14.18,DCMain,KYOKO,0,0,0,,أنا من أخبر الشرطة بشأن السلطعون
Dialogue: 0,0:16:14.18,0:16:18.16,DCMain,TANABE,0,0,0,,!وأنا لم أضع أي سلطعون في طعام توساكي-سان
Dialogue: 0,0:16:18.70,0:16:19.99,DCMain,SONOKO,0,0,0,,..كما ترون
Dialogue: 0,0:16:19.99,0:16:23.33,DCMain,SONOKO,0,0,0,,..قتل توساكي-سان من خلال إطعامه
Dialogue: 0,0:16:23.33,0:16:25.69,DCMain,SONOKO,0,0,0,,يضعكما تحت الشبهة على الفور
Dialogue: 0,0:16:25.69,0:16:26.92,DCMain,TAKAGI,0,0,0,,..أتعنين
Dialogue: 0,0:16:27.18,0:16:28.10,DCMain,SONOKO,0,0,0,,أجل
Dialogue: 0,0:16:28.10,0:16:31.81,DCMain,SONOKO,0,0,0,,الشخص الواثق من عدم وقوعه في الشبهة هو المجرم
Dialogue: 0,0:16:32.34,0:16:33.30,DCMain,SONOKO,0,0,0,,..بعبارة أخرى
Dialogue: 0,0:16:33.30,0:16:38.18,DCMain,SONOKO,0,0,0,,..الشخص الذي قتل توساكي-سان مستغلًا حساسيته
Dialogue: 0,0:16:38.77,0:16:41.06,DCMain,SONOKO,0,0,0,,هو أنت يا ميورا-سان
Dialogue: 0,0:16:42.51,0:16:46.87,DCMain,SONOKO,0,0,0,,..لا بد وأنكِ صدمت عندما رأيت الجثة
Dialogue: 0,0:16:46.87,0:16:49.73,DCMain,SONOKO,0,0,0,,التي أبعدتها يا ميورا-سان
Dialogue: 0,0:16:49.73,0:16:52.26,DCMain,MIURA,0,0,0,,لم أفعل أي شيء
Dialogue: 0,0:16:52.26,0:16:56.95,DCMain,MIURA,0,0,0,,كما قلت سابقًا، لم ألتقِ بتوساكي-سان إلا أثناء العمل في اليوم الماضي
Dialogue: 0,0:16:57.26,0:16:58.60,DCMain,SONOKO,0,0,0,,حسنٌ
Dialogue: 0,0:16:58.60,0:17:01.95,DCMain,SONOKO,0,0,0,,لنبدأ بالنظر في كيفية القتل
Dialogue: 0,0:17:02.16,0:17:08.12,DCMain,SONOKO,0,0,0,,كيف لأي منكم أن يطعم السلطعون لشخص يعاني\Nمن حساسية تجاهه؟
Dialogue: 0,0:17:08.12,0:17:09.44,DCMain,TAKAGI,0,0,0,,!فهمت
Dialogue: 0,0:17:09.44,0:17:14.72,DCMain,TAKAGI,0,0,0,,دائمًا ما يكون الشخص المصاب بالحساسية حذرًا حول\Nالمقادير التي يتناولها
Dialogue: 0,0:17:15.16,0:17:19.77,DCMain,SONOKO,0,0,0,,لهذا خلطته مع عجينة الكعك
Dialogue: 0,0:17:21.57,0:17:23.39,DCMain,CONAN,0,0,0,,انظر أيها المفتش ميغوري
Dialogue: 0,0:17:23.39,0:17:24.23,DCMain,MEGURE,0,0,0,,ما هذه؟
Dialogue: 0,0:17:24.53,0:17:27.64,DCMain,CONAN,0,0,0,,صورة التُقطت أثناء وقت الغداء
Dialogue: 0,0:17:31.49,0:17:34.15,DCMain,TAKAGI,0,0,0,,وتلك هي الكعكات
Dialogue: 0,0:17:35.32,0:17:39.08,DCMain,SONOKO,0,0,0,,ميورا-سان، هل أنت التي خبزت الكعك؟
Dialogue: 0,0:17:39.08,0:17:40.41,DCMain,MIURA,0,0,0,,نعم
Dialogue: 0,0:17:40.41,0:17:45.79,DCMain,SONOKO,0,0,0,,كان من المفترض أن يموت توساكي-سان بعد تناوله الكعك آنذاك
Dialogue: 0,0:17:46.16,0:17:50.26,DCMain,SONOKO,0,0,0,,وحتى إن اكتشفنا السلطعون في الكعك
Dialogue: 0,0:17:50.26,0:17:54.50,DCMain,SONOKO,0,0,0,,فستعتبر وفاته حادثًا لادعائك الجهل بذلك
Dialogue: 0,0:17:56.28,0:18:00.92,DCMain,SONOKO,0,0,0,,لكن الأمر لم يسرِ كما خططت له
Dialogue: 0,0:18:00.92,0:18:02.35,DCMain,SONOKO,0,0,0,,..والسبب هو
Dialogue: 0,0:18:03.43,0:18:06.86,DCMain,SONOKO,0,0,0,,هل تذكرين شيئًا يا سيدتي؟
Dialogue: 0,0:18:06.86,0:18:09.69,DCMain,KYOKO,0,0,0,,كان طعمها مرًا
Dialogue: 0,0:18:10.25,0:18:12.04,DCMain,SONOKO,0,0,0,,..هذا معقول
Dialogue: 0,0:18:12.04,0:18:18.45,DCMain,SONOKO,0,0,0,,لأنك استخدمت الكثير من الكاكاو لتخفي رائحة وطعم السلطعون
Dialogue: 0,0:18:18.67,0:18:22.95,DCMain,SONOKO,0,0,0,,لا شك أن توساكي-سان رفض تناول الكعك
Dialogue: 0,0:18:23.19,0:18:25.70,DCMain,SONOKO,0,0,0,,لأنه رأى ردة فعل كيوكو-سان بعدما تناولت أول قطعة
Dialogue: 0,0:18:25.70,0:18:28.96,DCMain,SONOKO,0,0,0,,لهذا دعيت توساكي-سان لخيمتك
Dialogue: 0,0:18:29.76,0:18:31.76,DCMain,SONOKO,0,0,0,,وأجبرته على تناول الكعك
Dialogue: 0,0:18:39.37,0:18:45.13,DCMain,SONOKO,0,0,0,,..ومن أجل إبعاد الشبهة عنك
Dialogue: 0,0:18:45.13,0:18:49.60,DCMain,SONOKO,0,0,0,,قمت بنقل توساكي-سان إلى خيمته
Dialogue: 0,0:18:49.96,0:18:54.86,DCMain,SONOKO,0,0,0,,بعدها أخذ كل منهم ينقل الجثة لمكان آخر كما تعلمون
Dialogue: 0,0:18:56.96,0:18:58.99,DCMain,MIURA,0,0,0,,تحليل مذهل
Dialogue: 0,0:18:59.34,0:19:01.45,DCMain,MIURA,0,0,0,,لكنك لم تصلي لشيء
Dialogue: 0,0:19:01.45,0:19:04.49,DCMain,MIURA,0,0,0,,ما زال ينقصك دليل مادي
Dialogue: 0,0:19:04.49,0:19:05.91,DCMain,MEGURE,0,0,0,,ماذا تعنين؟
Dialogue: 0,0:19:06.26,0:19:10.17,DCMain,MIURA,0,0,0,,أين هي الكعكات المحشوة بالسلطعون؟
Dialogue: 0,0:19:10.38,0:19:14.23,DCMain,MIURA,0,0,0,,من المؤسف أنني أكلتها كلها هذا المساء
Dialogue: 0,0:19:14.78,0:19:16.43,DCMain,SONOKO,0,0,0,,ران، هل الكعك معك؟
Dialogue: 0,0:19:16.43,0:19:17.67,DCMain,RAN,0,0,0,,نعم
Dialogue: 0,0:19:18.98,0:19:19.67,DCMain,MIURA,0,0,0,,
Dialogue: 0,0:19:19.86,0:19:21.25,DCMain,MIURA,0,0,0,,!مستحيل
Dialogue: 0,0:19:21.25,0:19:24.82,DCMain,SONOKO,0,0,0,,..هذه هي الكعكات التي قدمتها
Dialogue: 0,0:19:26.75,0:19:27.80,DCMain,TAKAGI,0,0,0,,!انتظري
Dialogue: 0,0:19:30.44,0:19:32.10,DCMain,MIURA,0,0,0,,..دليلك الآن
Dialogue: 0,0:19:33.00,0:19:34.11,DCMain,MIURA,0,0,0,,إنها ليست مرة؟
Dialogue: 0,0:19:35.51,0:19:36.61,DCMain,MIURA,0,0,0,,ما هذه؟
Dialogue: 0,0:19:36.95,0:19:40.44,DCMain,SONOKO,0,0,0,,بقايا كعك وُجدت في غرفتك
Dialogue: 0,0:19:40.44,0:19:46.03,DCMain,RAN,0,0,0,,ما تناولته كانت الكعكات التي حضرتها بنفسي
Dialogue: 0,0:19:46.25,0:19:51.29,DCMain,SONOKO,0,0,0,,إن استمر التحقيق فسيُكشف أمر علاقتك مع توساكي-سان
Dialogue: 0,0:19:51.58,0:19:56.09,DCMain,SONOKO,0,0,0,,..وإن حللوا هذه البقايا فحتمًا
Dialogue: 0,0:19:58.27,0:20:00.80,DCMain,MURA,0,0,0,,فشلت
Dialogue: 0,0:20:01.67,0:20:05.63,DCMain,MIURA,0,0,0,,كانت علاقتنا عادية في البداية
Dialogue: 0,0:20:06.15,0:20:06.80,DCMain,MIURA,0,0,0,,..لكن
Dialogue: 0,0:20:07.77,0:20:11.31,DCMain,MIURA,0,0,0,,في لحظة ما لم نستطع الفراق
Dialogue: 0,0:20:11.69,0:20:15.64,DCMain,MIURA,0,0,0,,أخبرني أنه سيترك زوجته من أجلي
Dialogue: 0,0:20:16.44,0:20:20.72,DCMain,MIURA,0,0,0,,كنا سعيدين حتى ذاك اليوم
Dialogue: 0,0:20:21.32,0:20:24.12,DCItalic,MIURA,0,0,0,,كيداي تناول بعضًا منه هيا
Dialogue: 0,0:20:24.12,0:20:27.78,DCItalic,KEIDAI,0,0,0,,عذرًا ولكن عندي حساسية
Dialogue: 0,0:20:27.78,0:20:30.33,DCItalic,MIURA,0,0,0,,لن يضر القليل
Dialogue: 0,0:20:30.33,0:20:32.72,DCItalic,KEIDAI,0,0,0,,لا أستطيع
Dialogue: 0,0:20:33.38,0:20:37.34,DCItalic,MIURA,0,0,0,,ما مشكلتك؟ إنني أطعمك فقط
Dialogue: 0,0:20:38.55,0:20:40.88,DCItalic,KEIDAI,0,0,0,,أنا جاد! هل تحاولين قتلي؟
Dialogue: 0,0:20:41.34,0:20:43.85,DCItalic,KEIDAI,0,0,0,,لا وقت عندي لك
Dialogue: 0,0:20:43.85,0:20:49.20,DCMain,MIURA,0,0,0,,اعتذرت له بعد ذلك وطلبت أن نرجع معًا
Dialogue: 0,0:20:49.20,0:20:51.74,DCMain,MIURA,0,0,0,,لكن كيداي رفض
Dialogue: 0,0:20:52.35,0:20:58.86,DCMain,MIURA,0,0,0,,لهذا سألته أن أرافقه مع زوجته للمخيم
Dialogue: 0,0:20:58.86,0:21:01.15,DCMain,KYOKO,0,0,0,,..ميورا-سان كنت
Dialogue: 0,0:21:02.42,0:21:05.25,DCMain,MIURA,0,0,0,,..نعم، كنت أخطط
Dialogue: 0,0:21:05.25,0:21:09.72,DCMain,MIURA,0,0,0,,لقتله وتوريطك
Dialogue: 0,0:21:10.48,0:21:13.90,DCMain,MIURA,0,0,0,,باستخدام السلطعون الذي فرقنا
Dialogue: 0,0:21:15.62,0:21:17.18,DCMain,MEGURE,0,0,0,,ميورا ميكا-سان
Dialogue: 0,0:21:17.82,0:21:21.42,DCMain,MEGURE,0,0,0,,أكملي اعترافاتك في المركز
Dialogue: 0,0:21:27.35,0:21:30.31,DCMain,TANABE,0,0,0,,انتهت القضية
Dialogue: 0,0:21:30.31,0:21:33.10,DCMain,KYOKO,0,0,0,,وأزيلت الشبهة عنا
Dialogue: 0,0:21:33.10,0:21:34.44,DCMain,MEGURE,0,0,0,,ليس بعد
Dialogue: 0,0:21:34.44,0:21:36.48,DCMain,MEGURE,0,0,0,,أنتما مذنبان أيضًا
Dialogue: 0,0:21:38.13,0:21:41.20,DCMain,MEGURE,0,0,0,,تانابي هيروشي-سان، توساكي كيوكو-سان
Dialogue: 0,0:21:41.20,0:21:45.83,DCMain,MEGURE,0,0,0,,نود استجوابكما بشأن الجثة
Dialogue: 0,0:21:48.99,0:21:50.50,DCItalic,CONAN,0,0,0,,بالطبع
Dialogue: 0,0:23:15.77,0:23:18.05,DCMain,SONOKO,0,0,0,,!لذيذ
Dialogue: 0,0:23:18.05,0:23:19.81,DCMain,SONOKO,0,0,0,,لا أصدق بأنها استخدمت السلطعون
Dialogue: 0,0:23:19.81,0:23:22.11,DCMain,SONOKO,0,0,0,,السلطعون بريء
Dialogue: 0,0:23:23.64,0:23:25.50,DCMain,RAN,0,0,0,,ما بك يا كونان-كن؟
Dialogue: 0,0:23:25.50,0:23:32.43,DCMain,CONAN,0,0,0,,لا بد أنهم يمقتون المقتول ليفعلوا به كل هذا
Dialogue: 0,0:23:35.50,0:23:36.88,DCMain,RAN,0,0,0,,إنها قضية مخيفة
Dialogue: 0,0:23:45.45,0:23:49.57,DCMain,REIZEI,0,0,0,,لقد اهتممت بهذا المكان منذ وجود والدك
Dialogue: 0,0:23:49.57,0:23:51.74,DCMain,REIZEI,0,0,0,,ما أمر الزينة الرخيصة؟
Dialogue: 0,0:23:52.13,0:23:54.12,DCMain,HAIBARA,0,0,0,,..بالحكم على هذه الدماء
Dialogue: 0,0:23:54.44,0:23:55.95,DCMain,CONAN,0,0,0,,نعم بالتأكيد
Dialogue: 0,0:23:56.23,0:23:59.15,DCMain,MEI,0,0,0,,إنها قضية غرفة مغلقة
Dialogue: 0,0:24:01.18,0:24:02.75,DCMain,KOGORO,0,0,0,,دعوني أتولى الأمر
Dialogue: 0,0:24:02.75,0:24:08.96,DCMain,KOGORO,0,0,0,,المحقق العظيم موري كوغورو سيحل القضية خلال ساعة
Dialogue: 0,0:24:09.51,0:24:14.57,DCMain,CONAN,0,0,0,,الحلقة القادمة هي
Dialogue: 0,0:24:30.65,0:24:33.27,DCMain,BOTH,0,0,0,,!تلميح كونان المقبل
Dialogue: 0,0:24:33.27,0:24:34.67,DCMain,CONAN,0,0,0,,عكاز
Dialogue: 0,0:24:34.91,0:24:36.02,DCMain,SONOKO,0,0,0,,{\fad(300,300)\fnAsmaa Font\an7\bord5\blur10\shad0\c&HFFFFFF&\3c&H2AC82F&}!لا بأس عليك أيها العم
Dialogue: 0,0:24:36.02,0:24:37.94,DCMain,RAN,0,0,0,,{\fad(300,300)\fnAsmaa Font\an7\bord5\blur10\shad0\c&HFFFFFF&\3c&HC8592A&}وافق على ذلك لأنهم طلبوا منه
