Dialogue: 0,0:00:06.48,0:00:08.65,sign_1168_account_book,SIGN,0,0,0,,{\an2\fs14\bord2\shad0.5\fad(750,1000)\pos(361,80)}دفتر الحسابات
Dialogue: 0,0:00:07.38,0:00:08.74,DCMain,GENTA,0,0,0,,!اهدأ
Dialogue: 0,0:00:07.69,0:00:08.74,DCMainTop,MITSUHIKO,0,0,0,,ماذا؟
Dialogue: 0,0:00:09.36,0:00:11.52,DCMain,MITSUHIKO,0,0,0,,ألم يكن ذلك غينتا للتو؟
Dialogue: 0,0:00:11.52,0:00:15.24,DCMain,CONAN,0,0,0,,قال أن لديه شيء ليفعله وغادر مبكرًا، فماذا يفعل؟
Dialogue: 0,0:00:15.24,0:00:20.49,sign_1168_ginpachi_delivery,SIGN,0,0,0,,{\\c&H181818&\an2\pos(325,240)}انقليس
Dialogue: 0,0:00:15.57,0:00:16.67,DCMainTop,GENTA,0,0,0,,!أسرع، أسرع
Dialogue: 0,0:00:18.09,0:00:19.64,DCMainTop,AYUMI,0,0,0,,!يا غينتا
Dialogue: 0,0:00:21.00,0:00:22.15,DCMain,GENTA,0,0,0,,!يا رفاق
Dialogue: 0,0:00:22.15,0:00:24.25,DCMain,CONAN,0,0,0,,ماذا تفعل يا غينتا؟
Dialogue: 0,0:00:24.25,0:00:26.63,sign_1168_account_book,SIGN,0,0,0,,{\an3\fs18\bord2\shad0.5\pos(255,270)}دفتر الحسابات
Dialogue: 0,0:00:24.25,0:00:26.63,DCMainTop,MITSUHIKO,0,0,0,,هل يمكنك التوقف لحظة؟
Dialogue: 0,0:00:26.63,0:00:30.13,DCMain,GENTA,0,0,0,,!لا! لا يمكنني التوقف الآن
Dialogue: 0,0:00:30.13,0:00:31.72,DCMain,CONAN,0,0,0,,!ماذا؟
Dialogue: 0,0:00:34.31,0:00:36.52,DCItalic,CONAN,0,0,0,,ماذا تخفي تحت ذلك الوجه البارد؟
Dialogue: 0,0:00:36.52,0:00:38.79,DCItalic,CONAN,0,0,0,,!أعطه طبق الأنقليس، وسيكون الأفضل في اليابان
Dialogue: 0,0:00:38.79,0:00:40.52,DCItalic,CONAN,0,0,0,,!حاسة التذوق لدى غينتا تحل القضية
Dialogue: 0,0:00:40.52,0:00:42.27,DCItalic,CONAN,0,0,0,,يسعى وراء الحقيقة دائما 
Dialogue: 0,0:00:42.27,0:00:44.15,DCItalic,CONAN,0,0,0,,،بجسد طفل وعقل بالغ
Dialogue: 0,0:00:44.15,0:00:46.59,DCItalic,CONAN,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:00:46.89,0:00:49.98,DCOpening,,0,0,0,,!جدي، فضولي، غامض، يقودنا نحو المستقبل
Dialogue: 0,0:00:49.98,0:00:53.30,DCOpening,,0,0,0,,بالتأكيد يمكنك كشف هذه الأجزاء الملونة التي تحوم حول قلبي ، أليس كذلك؟
Dialogue: 0,0:00:53.30,0:00:54.97,DCOpening,,0,0,0,,هذا الوجه البارد
Dialogue: 0,0:00:54.97,0:00:56.51,DCOpening,,0,0,0,,لا يمكنك خداع عيناي
Dialogue: 0,0:00:56.51,0:00:57.78,DCOpening,,0,0,0,,لا يمكنك الهروب من قدرك
Dialogue: 0,0:00:57.78,0:00:59.78,DCOpening,,0,0,0,,...لذا اتبعني اتبعني اتبعني
Dialogue: 0,0:00:59.78,0:01:00.64,DCOpening,,0,0,0,,لكنك بطريق الخطأ وبخبث
Dialogue: 0,0:01:00.64,0:01:02.98,DCOpening,,0,0,0,,,أمسكت بالدليل، انظر
Dialogue: 0,0:01:02.98,0:01:06.40,DCOpening,,0,0,0,,لا أستطيع التوقف الآن، أريد أن أتعقبه حتى النهاية
Dialogue: 0,0:01:06.40,0:01:09.49,DCOpening,,0,0,0,,لن أخيب ظن أحد لا تستخف بي كمجرد صبي
Dialogue: 0,0:01:09.48,0:01:12.65,DCOpening,,0,0,0,,هذه المفاهيم المسبقة ليست سوى خدع طفولية
Dialogue: 0,0:01:12.86,0:01:15.71,DCOpening,,0,0,0,,أعلم أنك تريدني، ولن أخذلك أبدًا
Dialogue: 0,0:01:15.72,0:01:18.70,DCOpening,,0,0,0,,...في الحقيقة
Dialogue: 0,0:01:19.20,0:01:22.44,DCOpening,,0,0,0,,أعلم أنك تكرهني ومع ذلك، لم أستطع لن أتركك أبدًا
Dialogue: 0,0:01:22.44,0:01:26.08,DCOpening,,0,0,0,,أرني مشاعرك الحقيقية؟
Dialogue: 0,0:01:26.91,0:01:27.79,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:01:33.44,0:01:34.93,DCOpening,,0,0,0,,!انطلق
Dialogue: 0,0:01:40.05,0:01:43.60,DCOpening,,0,0,0,,النهاية السعيدة المثالية
Dialogue: 0,0:01:43.60,0:01:46.69,DCOpening,,0,0,0,,ابتسامة لتجنب الألم، قلبي ينفتح عند 4869
Dialogue: 0,0:01:46.68,0:01:50.23,DCOpening,,0,0,0,,قبلة سرية أطلقت في البحر مشاعر ما زالت تحتل قلبي
Dialogue: 0,0:01:50.23,0:01:53.52,DCOpening,,0,0,0,,افتح قلبي أيضًا أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:01:58.34,0:02:00.66,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:04.81,0:02:06.81,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:11.03,0:02:11.70,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:02:28.00,0:02:34.00,sign_episode_title,SIGN,0,0,0,,{\fad(400,1)}‏مذكرة صيد الأنقليس لغينتا
Dialogue: 0,0:02:28.78,0:02:31.60,DCItalic,CONAN,0,0,0,,!"‏مذكرة صيد الأنقليس لغينتا"
Dialogue: 0,0:02:35.06,0:02:38.49,DCMain,CONAN,0,0,0,,.إذن الطاهي في مطعم الأنقليس في منطقتك
Dialogue: 0,0:02:38.49,0:02:44.85,DCMain,CONAN,0,0,0,,.أصيب قدمه ولا يستطيع توصيل الطلبات، لذا أنت تساعده
Dialogue: 0,0:02:44.85,0:02:46.02,DCMain,GENTA,0,0,0,,.نعم
Dialogue: 0,0:02:46.44,0:02:49.77,DCMain,GENTA,0,0,0,,.بعد كل شيء، اليوم هو يوم الثور في منتصف الصيف
Dialogue: 0,0:02:50.16,0:02:52.28,DCMain,CONAN,0,0,0,,.أنت محق
Dialogue: 0,0:02:53.59,0:02:55.78,DCMain,AYUMI,0,0,0,,.لم أسمع بيوم الثور من قبل
Dialogue: 0,0:02:55.78,0:03:00.56,DCMain,CONAN,0,0,0,,.يوم الثور الذي يتحدث عنه غينتا ليس أحد أيام الأسبوع
Dialogue: 0,0:03:00.56,0:03:02.51,DCMain,GENTA,0,0,0,,.يوم الثور في منتصف الصيف
Dialogue: 0,0:03:04.03,0:03:05.78,sign_1168_genta_writing,SIGN,0,0,0,,{\frz1\fax-0.1\pos(469,48)\c&H4C4C4C&\fad(150,1)}يوم الثور في منتصف الصيف
Dialogue: 0,0:03:04.29,0:03:05.79,DCMain,GENTA,0,0,0,,.هكذا تكتبها
Dialogue: 0,0:03:06.06,0:03:08.79,DCMain,HAIBARA,0,0,0,,.أنا مُندهشة أنك تعرف الكانجي
Dialogue: 0,0:03:10.44,0:03:13.30,DCMain,GENTA,0,0,0,,.على أي حال، من المفترض أن تأكل الأنقليس في هذا اليوم
Dialogue: 0,0:03:13.58,0:03:16.05,DCMain,AYUMI,0,0,0,,ماذا؟ لماذا؟
Dialogue: 0,0:03:16.05,0:03:17.81,DCMain,CONAN,0,0,0,,...لأن
Dialogue: 0,0:03:17.81,0:03:23.19,DCMain,GENTA,0,0,0,,.بدأ الناس يأكلون الأنقليس في يوم الثور في منتصف الصيف خلال فترة إيدو
Dialogue: 0,0:03:23.19,0:03:26.66,DCMain,GENTA,0,0,0,,،الأنقليس في موسمه خلال الخريف والشتاء
Dialogue: 0,0:03:26.66,0:03:30.81,DCMain,GENTA,0,0,0,,.لذا لم يتمكن البائعون من بيعه خلال الصيف
Dialogue: 0,0:03:31.20,0:03:37.78,DCMain,GENTA,0,0,0,,"،ثم قال رجل يدعى هيراغا جيناي، "يوم الثور في منتصف الصيف هو يوم الأنقليس
Dialogue: 0,0:03:37.78,0:03:40.49,DCMain,GENTA,0,0,0,,.وبدأ الجميع يأكلونه
Dialogue: 0,0:03:40.89,0:03:42.22,DCMain,HAIBARA,0,0,0,,.هذا صحيح
Dialogue: 0,0:03:42.22,0:03:47.25,DCMain,HAIBARA,0,0,0,,.الأنقليس غني بالمغذيات، لذا يمكنه منع إجهاد الصيف
Dialogue: 0,0:03:47.52,0:03:48.78,DCMain,AYUMI,0,0,0,,حقًا؟
Dialogue: 0,0:03:48.78,0:03:51.70,DCMain,MITSUHIKO,0,0,0,,.أنا منبهر أنك تعرف كل ذلك يا غينتا
Dialogue: 0,0:03:51.70,0:03:53.86,DCMain,AYUMI,0,0,0,,.بالإضافة، يمكنك كتابة الكانجي الصعبة
Dialogue: 0,0:03:53.86,0:03:54.88,DCMain,AYUMI,0,0,0,,.هذا رائع
Dialogue: 0,0:03:56.37,0:03:58.85,DCMain,HAIBARA,0,0,0,,"."الشغف هو مفتاح الإتقان
Dialogue: 0,0:03:58.85,0:04:02.20,DCMain,HAIBARA,0,0,0,,.الناس يصبحون عارفين بالأشياء التي يحبونها
Dialogue: 0,0:04:02.20,0:04:05.39,DCMain,GENTA,0,0,0,,!ولا أحد يحب الأنقليس أكثر مني
Dialogue: 0,0:04:09.47,0:04:10.85,DCMain,MITSUHIKO,0,0,0,,الشرطة؟
Dialogue: 0,0:04:10.85,0:04:12.65,DCMain,MITSUHIKO,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:04:12.64,0:04:15.15,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\move(319,117,211,117,29,2489)} مطعم جينباتشي للأنقليس
Dialogue: 0,0:04:13.07,0:04:15.15,DCMain,HAIBARA,0,0,0,,...مهلا، أليس ذلك المتجر
Dialogue: 0,0:04:15.15,0:04:16.47,DCMain,GENTA,0,0,0,,!أيها الطاهي
Dialogue: 0,0:04:16.47,0:04:17.78,DCMain,CONAN,0,0,0,,!مهلا، غينتا
Dialogue: 0,0:04:18.14,0:04:20.03,DCMain,GENTA,0,0,0,,!أيها المحقق تاكاغي
Dialogue: 0,0:04:20.40,0:04:24.79,DCMain,TAKAGI,0,0,0,,غينتا!، أنتم!، كونان، ماذا تفعلون هنا؟
Dialogue: 0,0:04:25.19,0:04:30.04,DCMain,CONAN,0,0,0,,.صاحب هذا المتجر طلب من غينتا توصيل طلبات الأنقليس نيابة عنه
Dialogue: 0,0:04:30.04,0:04:32.21,DCMain,TAKAGI,0,0,0,,ماذا؟ حقًا؟
Dialogue: 0,0:04:33.06,0:04:34.17,DCMain,TAKAGI,0,0,0,,.أيها المفتش ميغوري
Dialogue: 0,0:04:35.30,0:04:37.73,DCMain,MEGURE,0,0,0,,ماذا يفعلون هؤلاء الأطفال هنا؟
Dialogue: 0,0:04:37.73,0:04:40.89,DCMain,TAKAGI,0,0,0,,.على ما يبدو، يعرفوا الضحية
Dialogue: 0,0:04:41.63,0:04:44.50,DCMain,GENTA,0,0,0,,أخبرني، هل الطاهي بخير؟
Dialogue: 0,0:04:44.50,0:04:45.56,DCMain,TAKAGI,0,0,0,,...حسنًا، في الواقع
Dialogue: 0,0:04:45.90,0:04:48.61,DCMain,TAKAGI,0,0,0,,،تلقينا مكالمة وأسرعنا إلى هنا
Dialogue: 0,0:04:48.61,0:04:54.30,DCMain,TAKAGI,0,0,0,,.حيث وجدنا الطاهي السيد أوناجيزوكا شيجيرو مطعونًا في الجانب الأيسر من الصدر
Dialogue: 0,0:04:54.52,0:04:57.31,sign_1168_ginpachi_delivery,SIGN,0,0,0,,{\an3\c&H181818&\fad(300,1)\pos(345,313)} مطعم جينباتشي للأنقليس
Dialogue: 0,0:04:55.16,0:04:57.71,DCMain,TAKAGI,0,0,0,,.يتم علاجه في المستشفى الآن
Dialogue: 0,0:04:57.71,0:05:00.34,DCMain,TAKAGI,0,0,0,,.لكنه فاقد للوعي وفي حالة حرجة
Dialogue: 0,0:05:00.34,0:05:01.83,DCMain,GENTA,0,0,0,,...ايها الطاهي
Dialogue: 0,0:05:01.83,0:05:03.52,DCMain,GENTA,0,0,0,,...مستحيل
Dialogue: 0,0:05:03.52,0:05:06.45,DCMain,MITSUHIKO,0,0,0,,.غينتا أنا متأكد أنه سيكون بخير
Dialogue: 0,0:05:07.33,0:05:08.83,DCMain,GENTA,0,0,0,,.سيدفعون ثمن هذا
Dialogue: 0,0:05:08.83,0:05:11.58,DCMain,GENTA,0,0,0,,!سأقبض على الجاني
Dialogue: 0,0:05:11.84,0:05:13.00,DCMain,MITSUHIKO,0,0,0,,.أنت محق
Dialogue: 0,0:05:13.00,0:05:15.84,DCMain,MITSUHKO,0,0,0,,.فريق المحققين الصغار سيلقون القبض على الجاني
Dialogue: 0,0:05:15.84,0:05:17.59,DCMain,AYUMI,0,0,0,,.سأساعد
Dialogue: 0,0:05:17.59,0:05:19.95,DCMain,TAKAGI,0,0,0,,.انتظروا لحظة
Dialogue: 0,0:05:19.95,0:05:22.33,DCMain,TAKAGI,0,0,0,,.نحن من سيتولى القبض على الجاني
Dialogue: 0,0:05:22.33,0:05:26.82,DCMain,TAKAGI,0,0,0,,.نود أن نسألكم عن آخر مرة رأيتم فيها السيد أوناجيزوكا
Dialogue: 0,0:05:26.82,0:05:28.63,DCMain,TAKAGI,0,0,0,,هل تتذكرون متى كان ذلك؟
Dialogue: 0,0:05:28.63,0:05:33.47,DCMain,GENTA,0,0,0,,حسنًا، جئت إلى هنا بعد تناول وجبة خفيفة في الثالثة
Dialogue: 0,0:05:33.47,0:05:38.11,DCMain,GENTA,0,0,0,,.وغادرتُ على الفور لتوصيل الطلبات، لذا أعتقد أن الوقت كان حوالي 3:30
Dialogue: 0,0:05:38.52,0:05:40.36,DCMain,TAKAGI,0,0,0,,.عند 3:30 مساءً
Dialogue: 0,0:05:40.74,0:05:44.62,DCMain,CONAN,0,0,0,,بالمناسبة، أيها المحقق تاكاغي، من اتصل بالشرطة؟
Dialogue: 0,0:05:45.53,0:05:49.50,DCMain,TAKAGI,0,0,0,,.ذلك الرجل الجالس في الخلف
Dialogue: 0,0:05:50.24,0:05:53.74,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\pos(423,259)}(31) كوراشيما يوا 
Dialogue: 0,0:05:50.24,0:05:53.74,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(423,276)}الطاهي الخامس لـ"صلصة كوراشيما"
Dialogue: 0,0:05:50.68,0:05:52.75,DCMainTop,MEGURE,0,0,0,,.السيد كوراشيما يوا
Dialogue: 0,0:05:52.75,0:05:53.75,DCMainTop,KURASHIMA,0,0,0,,نعم؟
Dialogue: 0,0:05:54.80,0:05:56.74,DCMain,MEGURE,0,0,0,,.أنا ميغوري من شرطة العاصمة
Dialogue: 0,0:05:56.74,0:06:01.76,DCMain,MEGURE,0,0,0,,آسف للإزعاج، لكن هل يمكنك وصف كيف وجدت الضحية مرة أخرى؟
Dialogue: 0,0:06:01.76,0:06:06.60,DCMain,KURASHIMA,0,0,0,,.نعم. اليوم، جئت لتوصيل صلصتنا
Dialogue: 0,0:06:07.06,0:06:10.02,DCFlashback,KURASHIMA,0,0,0,,.مرحبًا. لقد مر وقت طويل
Dialogue: 0,0:06:10.01,0:06:15.77,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\move(190,130,66,130,0,5740)}الأنقليس
Dialogue: 0,0:06:10.51,0:06:12.06,DCFlashback,KURASHIMA,0,0,0,,.إنا كوراشيما
Dialogue: 0,0:06:12.47,0:06:14.80,DCMain,KURASHIMA,0,0,0,,.لكن لم يجب أحد
Dialogue: 0,0:06:14.80,0:06:18.85,DCMain,KURASHIMA,0,0,0,,.رأيت الستار خارج المطعم، فاستغربت ونظرت باتجاه المطبخ
Dialogue: 0,0:06:20.19,0:06:21.47,DCFlashback,KURASHIMA,0,0,0,,!أيها الطاهي
Dialogue: 0,0:06:22.03,0:06:26.28,DCMain,TAKAGI,0,0,0,,.ووجدت أوناجيزوكا مطعونًا بأداة حادة في صدره
Dialogue: 0,0:06:26.28,0:06:28.71,DCMain,AYUMI,0,0,0,,أداة حادة؟
Dialogue: 0,0:06:28.71,0:06:32.66,DCMain,GENTA,0,0,0,,.إنها أداة حادة تستخدم لإعداد الأنقليس
Dialogue: 0,0:06:32.95,0:06:36.67,DCMain,KURASHIMA,0,0,0,,.أعتقد أن الوقت كان حوالي 4:30 مساءً
Dialogue: 0,0:06:37.00,0:06:42.92,DCMain,GENTA,0,0,0,,.غادرت المتجر في 3:30، وتم العثور على الطاهي في 4:30
Dialogue: 0,0:06:43.48,0:06:47.68,DCMain,CONAN,0,0,0,,ألم تكن بصمة الجاني على الأداة؟
Dialogue: 0,0:06:48.08,0:06:52.18,DCMain,TAKAGI,0,0,0,,.لسوء الحظ، تم مسحها
Dialogue: 0,0:06:52.18,0:06:53.94,DCMain,CONAN,0,0,0,,.هكذا إذن
Dialogue: 0,0:06:55.46,0:06:57.11,DCMain,AYUMI,0,0,0,,ما الأمر يا غينتا؟
Dialogue: 0,0:06:57.11,0:06:59.44,DCMain,GENTA,0,0,0,,.رأيت شخصًا مريبًا سابقًا
Dialogue: 0,0:06:59.44,0:07:00.94,DCMain,MEGURE,0,0,0,,حقًا؟
Dialogue: 0,0:07:01.25,0:07:05.45,DCMain,GENTA,0,0,0,,.نعم. عندما غادرت صادفتُ شخصًا عند توصيلي للطلبات
Dialogue: 0,0:07:05.85,0:07:07.95,DCFlashback,GENTA,0,0,0,,!شكرًا لكم
Dialogue: 0,0:07:07.94,0:07:11.45,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an9\pos(130,8)\fs22}الأنقليس
Dialogue: 0,0:07:09.68,0:07:11.45,DCMain,GENTA,0,0,0,,...ثم بعد ذلك مباشرة
Dialogue: 0,0:07:11.45,0:07:14.70,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an7\pos(100,10)\fs28} مطعم جينباتشي للأنقليس
Dialogue: 0,0:07:12.80,0:07:14.71,DCFlashback,UNAGIZUKA,0,0,0,,!كم مرة يجب أن أقولها؟
Dialogue: 0,0:07:15.17,0:07:16.39,DCFlashback,UNAGIZUKA,0,0,0,,!اخرج
Dialogue: 0,0:07:17.25,0:07:20.96,DCMain,TAKAGI,0,0,0,,هل تتذكر كيف كان شكل ذلك الشخص؟
Dialogue: 0,0:07:24.22,0:07:26.53,DCMain,GENTA,0,0,0,,.كان يحمل مغلفًا
Dialogue: 0,0:07:26.53,0:07:30.22,DCMain,GENTA,0,0,0,,".أنا متأكد أنه مكتوب عليه "أويويا
Dialogue: 0,0:07:27.59,0:07:30.22,sign_1168_aoiya_dept_store_mail,SIGN,0,0,0,,{\pos(330,165)\frz86\c&H243443&\bord0\shad0\an2\fad(500,1)}أويويا\Nمتجر\Nالبضائع
Dialogue: 0,0:07:30.81,0:07:34.41,DCMain,TAKAGI,0,0,0,,هل يمكن أن يكون متجر أويويا؟
Dialogue: 0,0:07:35.54,0:07:38.54,DCMain,MEGURE,0,0,0,,.خذهم معك للتأكد على الفور
Dialogue: 0,0:07:38.54,0:07:39.31,DCMain,TAKAGI,0,0,0,,.حاضر
Dialogue: 0,0:07:39.85,0:07:41.52,sign_1168_aoiya_dept_store_bldg,SIGN,0,0,0,,{\frz-17\fax0.3\an2\fad(1,200)\move(313,114,313,38,0,1652)}متجر أويويا
Dialogue: 0,0:07:40.48,0:07:42.19,DCMain,OKAMOTO,0,0,0,,.شكرًا لانتظاركم
Dialogue: 0,0:07:42.81,0:07:44.96,DCMain,TAKAGI,0,0,0,,.آسف لمقاطعة عملك المزدحم
Dialogue: 0,0:07:44.96,0:07:46.09,DCMain,OKAMOTO,0,0,0,,.لا بأس
Dialogue: 0,0:07:46.70,0:07:50.20,DCMain,OKAMOTO,0,0,0,,.أدير أعمالً مع متجر الأنقليس
Dialogue: 0,0:07:50.20,0:07:52.58,DCMain,TAKAGI,0,0,0,,اعذرني، لكن ما اسمك؟
Dialogue: 0,0:07:52.58,0:07:54.30,DCMain,OKAMOTO,0,0,0,,.المعذرة
Dialogue: 0,0:07:54.30,0:07:57.58,DCMainTop,OKAMOTO,0,0,0,,.أنا مدير الفعاليات، أوكاموتو
Dialogue: 0,0:07:54.57,0:07:57.58,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\pos(309,254)}(45) أوكاموتو هيرويوكي 
Dialogue: 0,0:07:54.57,0:07:57.58,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(309,271)}مدير فعاليات متجر أويويا
Dialogue: 0,0:07:57.58,0:08:01.54,DCMain,TAKAGI,0,0,0,,يا سيد أوكاموتو، لقد ذهبت إلى متجر الأنقليس اليوم، أليس كذلك؟
Dialogue: 0,0:08:01.54,0:08:02.57,DCMain,OKAMOTO,0,0,0,,.نعم
Dialogue: 0,0:08:02.57,0:08:04.84,DCMain,TAKAGI,0,0,0,,بأي غرض؟
Dialogue: 0,0:08:04.84,0:08:07.68,DCMain,OKAMOTO,0,0,0,,.زرته للعمل
Dialogue: 0,0:08:07.68,0:08:09.09,DCMain,OKAMOTO,0,0,0,,ماذا في ذلك؟
Dialogue: 0,0:08:09.09,0:08:14.72,DCMain,TAKAGI,0,0,0,,.هذا الفتى قال إنه سمعك تتجادل مع صاحب المطعم
Dialogue: 0,0:08:14.72,0:08:18.07,DCMain,OKAMOTO,0,0,0,,.لا، لا، لن أقول أننا تجادلنا
Dialogue: 0,0:08:18.36,0:08:20.98,DCMain,OKAMOTO,0,0,0,,.كان فقط هو يصرخ في وجهي
Dialogue: 0,0:08:22.62,0:08:24.44,DCMain,TAKAGI,0,0,0,,ماذا تعني؟
Dialogue: 0,0:08:24.44,0:08:26.88,DCMain,OKAMOTO,0,0,0,,.لحظة واحدة من فضلك
Dialogue: 0,0:08:28.27,0:08:30.73,sign_1168_anniversary_flyer,SIGN,0,0,0,,{\an4\c&H000000&\3c&H7DE5DF&\4c&H8CEAC9&\fs12\frz-27\fax-0.5\pos(503,191)\fad(1030,1)}جينباتشي
Dialogue: 0,0:08:28.27,0:08:30.73,sign_1168_anniversary_flyer,SIGN,0,0,0,,{\an6\c&H000000&\3c&H7EE1DB&\4c&H8AE1CF&\fs10\frz38\fax0.4\fad(1030,1)\pos(466,238)}متجر أويويا
Dialogue: 0,0:08:29.22,0:08:30.24,DCMain,OKAMOTO,0,0,0,,.هذا هو
Dialogue: 0,0:08:32.66,0:08:33.78,DCMain,TAKAGI,0,0,0,,ما هذا؟
Dialogue: 0,0:08:34.18,0:08:40.88,DCMain,OKAMOTO,0,0,0,,.نحن نخطط لبيع الأنقليس المشوية من جينباتشي في متجرنا
Dialogue: 0,0:08:40.88,0:08:43.99,DCMain,OKAMOTO,0,0,0,,،طلبنا منه الإشراف على المشروع
Dialogue: 0,0:08:43.99,0:08:48.10,DCMain,OKAMOTO,0,0,0,,.لكنه رفض بيع الأنقليس في أي مكان غير مطعمه
Dialogue: 0,0:08:48.48,0:08:53.18,DCMain,OKAMOTO,0,0,0,,.لكنني لم أستسلم، فزرته مرة أخرى اليوم
Dialogue: 0,0:08:53.18,0:08:55.14,DCMain,TAKAGI,0,0,0,,حوالي أي وقت كان ذلك؟
Dialogue: 0,0:08:55.75,0:08:59.13,DCMain,OKAMOTO,0,0,0,,،أعتقد أنني زرته حوالي 3:30
Dialogue: 0,0:08:59.13,0:09:01.90,DCMain,OKAMOTO,0,0,0,,.رغم أنه طردني بعد عشر دقائق فقط
Dialogue: 0,0:09:02.25,0:09:06.40,DCMain,GENTA,0,0,0,,.إذن كنتَ في المطعم من 3:30 إلى 3:40
Dialogue: 0,0:09:08.07,0:09:11.41,DCMain,OKAMOTO,0,0,0,,هل حدث شيء للسيد أوناجيزوكا؟
Dialogue: 0,0:09:11.41,0:09:16.41,DCMain,CONAN,0,0,0,,.قام أحدهم بطعنه في الصدر، وتم العثور عليه في المطبخ
Dialogue: 0,0:09:16.41,0:09:17.41,DCMain,CONAN,0,0,0,,أليس كذلك؟
Dialogue: 0,0:09:17.41,0:09:19.66,DCMain,OKAMOTO,0,0,0,,.ماذا؟ هذا فظيع
Dialogue: 0,0:09:19.99,0:09:23.43,DCMain,GENTA,0,0,0,,انت.  امتأكد أنك لم تكن أنت من فعلها؟
Dialogue: 0,0:09:23.43,0:09:26.69,DCMain,GENTA,0,0,0,,.أراهن أنك غضبت لأنه رفض، فطعنته
Dialogue: 0,0:09:26.69,0:09:28.35,DCMain,OKAMOTO,0,0,0,,.انتظر لحظة
Dialogue: 0,0:09:28.35,0:09:32.05,DCMain,OKAMOTO,0,0,0,,.انا انواجه رفضًا دائمًا للفعاليات
Dialogue: 0,0:09:32.05,0:09:34.93,DCMain,OKAMOTO,0,0,0,,.لن أطعن أحدًا بسبب ذلك
Dialogue: 0,0:09:35.34,0:09:37.05,DCMain,TAKAGI,0,0,0,,.بالطبع لن تفعل
Dialogue: 0,0:09:37.05,0:09:39.74,DCMain,TAKAGI,0,0,0,,.لا يجب أن تقول أشياء كهذه
Dialogue: 0,0:09:40.74,0:09:42.19,DCMain,GENTA,0,0,0,,...نعم، لكن
Dialogue: 0,0:09:42.59,0:09:45.40,DCMain,OKAMOTO,0,0,0,,هل انتهينا هنا؟
Dialogue: 0,0:09:45.40,0:09:47.43,DCMain,OKAMOTO,0,0,0,,.لدي عمل آخر لأقوم به
Dialogue: 0,0:09:47.43,0:09:50.89,DCMain,TAKAGI,0,0,0,,.نعم. شكرًا لك على تعاونك
Dialogue: 0,0:09:50.89,0:09:52.90,DCMain,TAKAGI,0,0,0,,...هذه الدعوة
Dialogue: 0,0:09:52.90,0:09:56.36,DCMain,OKAMOTO,0,0,0,,.إذا لم تكن بحاجة إليها، سأهتم بها
Dialogue: 0,0:09:56.36,0:09:57.56,DCMain,TAKAGI,0,0,0,,.المعذرة، إذن
Dialogue: 0,0:10:01.04,0:10:02.12,DCMain,GENTA,0,0,0,,.تبا
Dialogue: 0,0:10:02.51,0:10:05.74,DCMain,GENTA,0,0,0,,.ظننت أن ذلك الرجل مريب
Dialogue: 0,0:10:05.74,0:10:08.38,DCMain,CONAN,0,0,0,,ايها المحقق تاكاغي، ماذا ستفعل الآن؟
Dialogue: 0,0:10:08.74,0:10:12.38,DCMain,TAKAGI,0,0,0,,.سأقابل آخر زبون للمطعم
Dialogue: 0,0:10:12.38,0:10:14.38,DCMain,AYUMI,0,0,0,,من هو؟
Dialogue: 0,0:10:15.87,0:10:21.09,DCMain,TAKAGI,0,0,0,,.حددنا آخر زبون دفع من بيانات مبيعات جينباتشي
Dialogue: 0,0:10:21.09,0:10:24.39,DCMain,TAKAGI,0,0,0,,.لحسن الحظ، دفعوا باستخدام بطاقة ائتمان
Dialogue: 0,0:10:24.70,0:10:26.64,DCMain,GENTA,0,0,0,,!انت، ماذا تنتظر
Dialogue: 0,0:10:26.64,0:10:27.65,DCMain,GENTA,0,0,0,,!أسرع
Dialogue: 0,0:10:28.12,0:10:31.14,DCMain,MITSUHIKO,0,0,0,,.غينتا أكثر تحفيزًا من المعتاد
Dialogue: 0,0:10:31.14,0:10:33.65,DCMain,HAIBARA,0,0,0,,.حبّه للأنقليس جعلهُ يتفجر
Dialogue: 0,0:10:41.95,0:10:45.89,DCMain,RIO,0,0,0,,.جينباتشي؟ نعم، لقد ذهبت هناك
Dialogue: 0,0:10:45.89,0:10:51.30,DCMainTop,RIO,0,0,0,,.تذكرت في طريق العودة أن اليوم هو يوم الثور في منتصف الصيف، فتوقفت هناك
Dialogue: 0,0:10:46.79,0:10:50.79,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(335,256)}(28) ماتسوي ريو 
Dialogue: 0,0:10:46.79,0:10:50.79,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(335,273)}موظفة
Dialogue: 0,0:10:51.30,0:10:54.30,DCMain,TAKAGI,0,0,0,,هل تتذكرين متى دخلتِ المطعم؟
Dialogue: 0,0:10:55.00,0:10:58.95,DCMain,RIO,0,0,0,,.أعتقد أن الوقت كان حوالي 3:45
Dialogue: 0,0:10:58.95,0:11:02.06,DCMain,RIO,0,0,0,,.استلمت طعامي بعد حوالي 30 دقيقة
Dialogue: 0,0:11:02.06,0:11:06.81,DCMain,GENTA,0,0,0,,.إذن كنتِ في المطعم من 3:45 إلى 4:15
Dialogue: 0,0:11:07.13,0:11:11.20,DCMain,TAKAGI,0,0,0,,هل رأيتِ أي شخص مريب في المطعم؟
Dialogue: 0,0:11:11.20,0:11:12.25,DCMain,RIO,0,0,0,,.لا
Dialogue: 0,0:11:14.32,0:11:18.23,DCMain,MITSUHIKO,0,0,0,,غينتا، لا تقل لي انك جائع الآن؟
Dialogue: 0,0:11:18.59,0:11:24.58,DCMain,GENTA,0,0,0,,.كان من المفترض أن أحصل على الأنقليس بعد انتهائي من التوصيلات
Dialogue: 0,0:11:25.60,0:11:27.50,DCMain,RIO,0,0,0,,إذن، هل تريد طبق الأنقليس؟
Dialogue: 0,0:11:27.50,0:11:28.83,DCMain,GENTA,0,0,0,,حقًا؟
Dialogue: 0,0:11:28.83,0:11:34.93,DCMain,RIO,0,0,0,,.بالتأكيد. زوجي يعمل لوقت متأخر ولا يحتاج العشاء الآن، لذا لدي واحد إضافي
Dialogue: 0,0:11:35.38,0:11:36.64,DCMain,RIO,0,0,0,,.انتظروا هنا
Dialogue: 0,0:11:39.69,0:11:41.72,DCMain,RIO,0,0,0,,.حسناً، تفضلوا
Dialogue: 0,0:11:42.14,0:11:44.63,DCMain,ALL,0,0,0,,شكرًا على الطعام!
Dialogue: 0,0:11:51.24,0:11:52.62,DCMain,AYUMI,0,0,0,,.إنه لذيذ جدًا
Dialogue: 0,0:11:52.98,0:11:54.36,DCMain,MITSUHIKO,0,0,0,,!أنتِ محقة
Dialogue: 0,0:11:54.36,0:11:58.49,DCMain,MITSUHIKO,0,0,0,,.النكهة قوية جدًا لدرجة أن هذه الكمية تكفيني
Dialogue: 0,0:11:58.79,0:12:01.49,DCMain,HAIBARA,0,0,0,,.لا شيء يضاهي نكهة مطعم عريق
Dialogue: 0,0:12:01.49,0:12:03.09,DCMain,CONAN,0,0,0,,.بالضبط
Dialogue: 0,0:12:14.31,0:12:16.66,DCMain,MITSUHIKO,0,0,0,,.اختصرنا المدة الزمنية إلى حدّ كبير
Dialogue: 0,0:12:16.66,0:12:19.57,DCMain,CONAN,0,0,0,,نعم. الجريمة على الأرجح حدثت خلال الـ15 دقيقة
Dialogue: 0,0:12:19.00,0:12:28.26,sign_1168_genta_writing,SIGN,0,0,0,,{\pos(620,20)\an9\fs24\3c&HDFE4E3&\bord3\xshad-2\yshad2}أنا 3:30 جينباتشي\Nكوراشيما 4:32 اتصل بالشرطة\Nأوكاموتو 3:30 إلى 3:40 في المطعم \Nماتسوي 4:15 استلمت وجبة الأنقليس
Dialogue: 0,0:12:19.57,0:12:23.16,DCMain,CONAN,0,0,0,,.بين 4:15 عندما استلمت الإنسة ماتسوي\Nوجبة الأنقليس
Dialogue: 0,0:12:23.16,0:12:27.91,DCMain,CONAN,0,0,0,,.و4:30 عندما وجد السيد كوراشيما الطاهي
Dialogue: 0,0:12:30.24,0:12:32.02,DCMain,AYUMI,0,0,0,,غينتا، هل هناك خطب ما؟
Dialogue: 0,0:12:32.53,0:12:38.91,DCMain,GENTA,0,0,0,,.أشعر أن طعم طبق الأنقليس الذي أكلناه مختلف عن المعتاد
Dialogue: 0,0:12:38.91,0:12:41.76,DCMain,MITSUHIKO,0,0,0,,.حقًا؟ ظننت أنه كان لذيذًا
Dialogue: 0,0:12:41.76,0:12:43.91,DCMain,GENTA,0,0,0,,...كان لذيذًا، لكن
Dialogue: 0,0:12:44.48,0:12:47.46,DCMain,TAKAGI,0,0,0,,.سأعود إلى المقر الرئيسي
Dialogue: 0,0:12:47.46,0:12:49.92,DCMain,TAKAGI,0,0,0,,.وأنتم يا أطفال عليكم الذهاب مباشرة إلى منازلكم
Dialogue: 0,0:12:50.24,0:12:51.66,DCMain,ALL,0,0,0,,!حسنًا
Dialogue: 0,0:12:53.35,0:12:55.19,DCMain,MITSUHIKO,0,0,0,,ماذا يجب أن نفعل الآن؟
Dialogue: 0,0:12:55.19,0:12:59.17,DCMain,CONAN,0,0,0,,.حسنًا، ليس لدينا أي أدلة أخرى الآن
Dialogue: 0,0:12:59.61,0:13:01.68,DCMain,GENTA,0,0,0,,!سأعود إلى المطعم
Dialogue: 0,0:13:01.17,0:13:01.67,sign_1168_house_nameplate,SIGN,0,0,0,,{\an2\xshad-2\yshad2\frz90\fax-0.1\pos(350,45)\fad(200,1)}\hماتسوي\h
Dialogue: 0,0:13:01.67,0:13:06.93,sign_1168_house_nameplate,SIGN,0,0,0,,{\an2\xshad-1\yshad2\fad(1,1)\pos(262,64)\3c&HE8E1D9&\c&H5F5755&}\hماتسوي\h
Dialogue: 0,0:13:01.68,0:13:03.38,DCMain,CONAN,0,0,0,,!ماذا؟ مهلاً، غينتا
Dialogue: 0,0:13:03.38,0:13:04.74,DCMain,MITSUHIKO & AYUMI,0,0,0,,!غينتا
Dialogue: 0,0:13:04.74,0:13:06.13,DCMain,CONAN,0,0,0,,.تبا
Dialogue: 0,0:13:06.93,0:13:09.55,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an2\pos(269,182)} مطعم جينباتشي للأنقليس 
Dialogue: 0,0:13:07.81,0:13:10.75,DCMain,MITSUHIKO,0,0,0,,.يبدو أنهم انتهوا بالفعل من فحص مسرح الجريمة
Dialogue: 0,0:13:09.55,0:13:11.56,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an8\fs26\pos(270,90)\bord3}مطعم جينباتشي للأنقليس 
Dialogue: 0,0:13:10.75,0:13:11.86,DCMain,CONAN,0,0,0,,.أنت محق
Dialogue: 0,0:13:11.89,0:13:15.23,sign_1168_account_book,SIGN,0,0,0,,{\an2\fs14\bord2\shad0.5\fad(200,200)\pos(249,169)}دفتر الحسابات
Dialogue: 0,0:13:14.01,0:13:16.32,DCMain,AYUMI,0,0,0,,غينتا، ماذا تبحث عنه؟
Dialogue: 0,0:13:16.61,0:13:21.03,DCMain,GENTA,0,0,0,,.لا أستطيع التوقف عن التفكير في كيف أن طعم طبق الأنقليس كان مختلفًا
Dialogue: 0,0:13:21.03,0:13:24.07,DCMain,MITSUHIKO,0,0,0,,.اكتشاف ذلك لن يساعدنا في العثور على الجاني
Dialogue: 0,0:13:25.50,0:13:29.58,DCMain,GENTA,0,0,0,,...أعرف ذلك، لكن مع ذلك
Dialogue: 0,0:13:35.27,0:13:39.17,DCMain,MITSUHIKO,0,0,0,,.على أي حال، هذا المكان به العديد من الأدوات التي لم أرها من قبل
Dialogue: 0,0:13:39.17,0:13:41.68,DCMain,CONAN,0,0,0,,.لأنها أدوات مخصصة لإعداد الأنقليس
Dialogue: 0,0:13:42.38,0:13:43.55,DCMain,GENTA,0,0,0,,!فهمت
Dialogue: 0,0:13:43.55,0:13:46.51,DCMain,GENTA,0,0,0,,!هذا يمكن أن يكون السبب في اختلاف الطعم
Dialogue: 0,0:13:45.17,0:13:47.18,sign_1168_soy_sauce,SIGN,0,0,0,,{\an2\frz32\fax0.3\fnGeorgia\pos(227,151)\fad(500,1)}صلصة بيكا
Dialogue: 0,0:13:47.18,0:13:54.18,sign_1168_soy_sauce,SIGN,0,0,0,,{\an8\fs18\frz15\fnGeorgia\pos(245,310)}صلصة بيكا
Dialogue: 0,0:13:47.55,0:13:49.47,DCMainTop,AYUMI,0,0,0,,ماذا عن صلصة الصويا؟
Dialogue: 0,0:13:49.47,0:13:51.35,DCMainTop,GENTA,0,0,0,,.انظر إلى الملصق
Dialogue: 0,0:13:52.07,0:13:54.19,DCMainTop,MITSUHIKO,0,0,0,,".مكتوب عليها "صلصة بيكا
Dialogue: 0,0:13:54.44,0:13:59.06,DCMain,CONAN,0,0,0,,السيد كوراشيما، الذي وجد الطاهي، قال إنه جاء لتوصيل طلب، أليس كذلك؟
Dialogue: 0,0:13:59.06,0:14:03.01,DCMain,CONAN,0,0,0,,.لكن في الواقع، هذا المطعم يستخدم صلصة صويا من مصنع آخر
Dialogue: 0,0:14:03.01,0:14:06.20,DCMain,HAIBARA,0,0,0,,هل كان يكذب؟
Dialogue: 0,0:14:06.19,0:14:11.20,sign_1168_soy_sauce,SIGN,0,0,0,,{\an2\fs18\fnGeorgia\pos(450,306)\frz347.9}صلصة بيكا
Dialogue: 0,0:14:06.53,0:14:10.88,DCMainTop,GENTA,0,0,0,,.نعم. دعونا نستجوبه مرة أخرى
Dialogue: 0,0:14:11.53,0:14:13.45,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an2\fs24\fnGeorgia\fad(500,1)\c&HE9E8DA&\3c&H1F1413&\4c&H5C3D46&\yshad2\move(460,321,460,138,29,1905)}كورا
Dialogue: 0,0:14:12.39,0:14:13.46,DCMain,KURASHIMA,0,0,0,,حسنًا؟
Dialogue: 0,0:14:13.90,0:14:15.64,DCMain,KURASHIMA,0,0,0,,ماذا أردتم مناقشته؟
Dialogue: 0,0:14:16.71,0:14:20.58,sign_1168_soy_sauce,SIGN,0,0,0,,{\an8\fs18\fnGeorgia\fad(500,1)\frz335\3c&H8AA0A3&\4c&H264929&\yshad2\pos(380,270)}صلصة بيكا
Dialogue: 0,0:14:18.23,0:14:20.59,DCMain,GENTA,0,0,0,,هل تعرف هذه صلصة الصويا؟
Dialogue: 0,0:14:22.59,0:14:25.52,DCMain,GENTA,0,0,0,,.هذه صلصة الصويا المستخدمة في مطعم جينباتشي
Dialogue: 0,0:14:25.52,0:14:26.97,DCMain,GENTA,0,0,0,,.إنهم لا يستخدمون صلصتك
Dialogue: 0,0:14:27.47,0:14:30.40,DCMain,GENTA,0,0,0,,!لقد كذبت بشأن توصيل طلب إلى جينباتشي
Dialogue: 0,0:14:30.40,0:14:32.51,DCMain,GENTA,0,0,0,,ماذا كنت تفعل حقًا هناك؟
Dialogue: 0,0:14:34.74,0:14:39.08,DCMain,KURASHIMA,0,0,0,,.هذا صحيح. لقد كذبت بشأن توصيل طلب
Dialogue: 0,0:14:39.08,0:14:41.23,DCMain,KURASHIMA,0,0,0,,.في الواقع، ذهبت هناك لتقديم طلب
Dialogue: 0,0:14:41.23,0:14:42.73,sign_1168_account_book,SIGN,0,0,0,,{\an2\fs20\bord2\shad0.5\3c&H9A9F9E&\pos(132,232)}دفتر الحسابات
Dialogue: 0,0:14:41.66,0:14:42.74,DCMain,CONAN,0,0,0,,طلب؟
Dialogue: 0,0:14:43.22,0:14:46.51,DCMain,KURASHIMA,0,0,0,,.هذا المطعم كان يستخدم صلصة الصويا الخاصة بنا
Dialogue: 0,0:14:47.16,0:14:52.25,DCMain,KURASHIMA,0,0,0,,.لكن منذ أن توليت المسؤولية، قيل لي أن جودتنا انخفضت، فتوقف عن الشراء منها
Dialogue: 0,0:14:52.24,0:14:54.49,sign_1168_account_book,SIGN,0,0,0,,{\an2\fs20\bord2\shad0.5\3c&H9A9F9E&\pos(61,236)}دفتر الحسابات
Dialogue: 0,0:14:52.66,0:14:54.50,DCMain,AYUMI,0,0,0,,.هكذا إذن
Dialogue: 0,0:14:54.50,0:14:59.50,DCMain,MITSUHIKO,0,0,0,,هل طعنت الطاهي لأنه لم يقبل صلصة الصويا الخاصة بك؟
Dialogue: 0,0:15:00.02,0:15:05.01,DCMain,KURASHIMA,0,0,0,,!لا! الطاهي كان مطعوناً أصلا عندما وصلت
Dialogue: 0,0:15:05.47,0:15:09.41,DCMain,KURASHIMA,0,0,0,,.بالإضافة، إذا كنت سأطعنه بسبب ذلك، لكنت فعلت ذلك منذ عام
Dialogue: 0,0:15:09.41,0:15:12.07,DCMain,KURASHIMA,0,0,0,,.لقد غير صلصة الصويا في ذلك الوقت
Dialogue: 0,0:15:12.07,0:15:13.52,DCMain,CONAN,0,0,0,,حقًا؟
Dialogue: 0,0:15:14.14,0:15:17.14,DCMain,KURASHIMA,0,0,0,,.يمكن أن يستغرق صنع صلصة الصويا سنوات
Dialogue: 0,0:15:17.14,0:15:22.28,DCMain,KURASHIMA,0,0,0,,.بما أنني صنعت صلصة صويا جديدة، أحضرت بعضًا منها ليذوقها الطاهي
Dialogue: 0,0:15:22.82,0:15:24.40,DCMain,MITSUHIKO,0,0,0,,.فهمت
Dialogue: 0,0:15:24.85,0:15:30.07,DCMain,GENTA,0,0,0,,.إذن صلصة الصويا لم تكن السبب في اختلاف طعم طبق الأنقليس اليوم
Dialogue: 0,0:15:30.07,0:15:32.91,DCMain,MITSUHIKO,0,0,0,,.يا غينتا، لست متأكدًا أن هذا مهم الآن
Dialogue: 0,0:15:33.48,0:15:37.26,DCMain,GENTA,0,0,0,,...لا، كان مختلفًا بالتأكيد
Dialogue: 0,0:15:38.21,0:15:41.17,DCMain,GENTA,0,0,0,,!فهمت! لقد عرفت الأمر هذه المرة
Dialogue: 0,0:15:41.17,0:15:42.31,DCMain,ALL,0,0,0,,ماذا؟
Dialogue: 0,0:15:42.67,0:15:47.67,sign_1168_house_nameplate,SIGN,0,0,0,,{\an9\xshad5\yshad6\fs38\fad(1,1)\3c&HA0BFDE&\c&H353535&\4c&H363A6C&\pos(218,40)}\hماتسوي\h
Dialogue: 0,0:15:46.72,0:15:47.68,DCMain,RIO,0,0,0,,نعم؟
Dialogue: 0,0:15:47.68,0:15:49.39,DCMain,RIO,0,0,0,,.هذا أنتم يا أطفال مرة أخرى
Dialogue: 0,0:15:49.39,0:15:51.55,DCItalic,GENTA,0,0,0,,هل لا يزال لديكِ المزيد من طبق الأنقليس ذلك؟
Dialogue: 0,0:15:51.55,0:15:52.43,DCMain,RIO,0,0,0,,ماذا؟
Dialogue: 0,0:15:55.31,0:15:56.61,DCMain,RIO,0,0,0,,.هذا هو
Dialogue: 0,0:15:56.61,0:15:57.51,DCMain,GENTA,0,0,0,,.رائع
Dialogue: 0,0:15:58.98,0:16:00.81,DCMain,GENTA,0,0,0,,!كما توقعت
Dialogue: 0,0:16:02.01,0:16:03.57,DCMain,CONAN,0,0,0,,.إذن هكذا هو الأمر
Dialogue: 0,0:16:03.94,0:16:06.82,DCMain,MITSUHIKO,0,0,0,,إذن هكذا هو الأمر؟، كيف هو الأمر؟
Dialogue: 0,0:16:07.53,0:16:09.38,DCMain,CONAN,0,0,0,,...في هذه الحالة
Dialogue: 0,0:16:10.79,0:16:15.33,DCMain,CONAN,0,0,0,,يا انسة ماتسوي، هل هذا هو الرجل الذي صنع لك وجبات الثعبان في مطعم جينباتشي؟
Dialogue: 0,0:16:15.32,0:16:17.58,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an2\fs26\bord3\c&HEFE7E3&\3c&H94603E&\pos(328,93)}جينباتشي
Dialogue: 0,0:16:15.32,0:16:17.58,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an2\fs18\bord2\3c&HEFE7E3&\c&H623516&\pos(328,293)}جينباتشي\Nالطاهي أوناجيزوكا شيجيرو
Dialogue: 0,0:16:17.58,0:16:20.86,DCMain,RIO,0,0,0,,،كان يرتدي منشفة وقناعًا، لذا لم أستطع رؤية وجهه بوضوح
Dialogue: 0,0:16:20.86,0:16:23.37,DCMain,RIO,0,0,0,,.لكنه لم يكن بهذا العمر
Dialogue: 0,0:16:23.37,0:16:25.79,DCMain,RIO,0,0,0,,.بدا أصغر من ذلك
Dialogue: 0,0:16:25.79,0:16:27.34,DCMain,AYUMI & MITSUHIKO,0,0,0,,!ماذا؟
Dialogue: 0,0:16:28.11,0:16:31.31,DCItalic,CONAN/ID,0,0,0,,.كما توقعت. لقد فهمت كل شيء
Dialogue: 0,0:16:31.31,0:16:35.36,DCItalic,CONAN/ID,0,0,0,,.أعرف لماذا اختلف طعم طبق الأنقليس ومن هو الجاني
Dialogue: 0,0:16:35.85,0:16:37.60,sign_1168_office,SIGN,0,0,0,,{\pos(430,105)\an8\fs20\c&H444444&\3c&HEEEEE9&\4c&H878787&\yshad0.5\fad(1,500)}\hقسم إدارة الفعاليات\h
Dialogue: 0,0:16:38.62,0:16:40.35,DCMain,OKAMOTO,0,0,0,,...ماذا؟ أنتم يا أطفال
Dialogue: 0,0:16:40.65,0:16:41.86,DCMain,MITSUHIKO,0,0,0,,...اعذرنا
Dialogue: 0,0:16:42.21,0:16:43.86,DCMain,OKAMOTO,0,0,0,,هل نسيتم شيئًا؟
Dialogue: 0,0:16:46.64,0:16:49.11,DCMain,GENTA,0,0,0,,أنت تعرف هذا طبق الأنقليس، أليس كذلك؟
Dialogue: 0,0:16:51.63,0:16:54.43,DCMain,OKAMOTO,0,0,0,,بالطبع. هذا طبق الأنقليس من مطعم جينباتشي، أليس كذلك؟
Dialogue: 0,0:16:54.43,0:16:55.74,DCMain,GENTA,0,0,0,,.الصندوق من جينباتشي
Dialogue: 0,0:16:56.10,0:16:59.25,DCMain,GENTA,0,0,0,,.لكن الطاهي لم يعد الطعام الموجود بداخله
Dialogue: 0,0:16:59.25,0:17:00.37,DCMain,OKAMOTO,0,0,0,,ماذا؟
Dialogue: 0,0:17:00.37,0:17:02.84,DCMain,GENTA,0,0,0,,.انظر عن قرب إلى هذا الطبق
Dialogue: 0,0:17:03.70,0:17:06.13,DCMain,GENTA,0,0,0,,.لقد تم قطعه من البطن
Dialogue: 0,0:17:12.71,0:17:13.89,DCMain,OKAMOTO,0,0,0,,.أنت محق
Dialogue: 0,0:17:14.24,0:17:17.89,DCMain,GENTA,0,0,0,,.يتم إعداد الأنقليس بشكل مختلف في كانتو وكانساي
Dialogue: 0,0:17:17.89,0:17:21.90,sign_1168_onscreen_descriptions_bg,SIGN,0,0,0,,{\pos(505,180)\frz90\fnGeorgia\c&HF4F5F4&\3c&HF4F5F4&\4c&H114988&\xshad-2\yshad-2}كانتو يقطع من العمود الفقري
Dialogue: 1,0:17:17.89,0:17:21.90,sign_1168_onscreen_descriptions,SIGN,0,0,0,,{\pos(505,180)\frz90\fnGeorgia\c&H4E81CB&\3c&H114988&\alpha33}كانتو يقطع من العمود الفقري
Dialogue: 0,0:17:18.30,0:17:21.90,DCMain,GENTA,0,0,0,,،قال الطاهي إنه في كانتو، الثعبان\Nيقطع من العمود الفقري
Dialogue: 0,0:17:21.89,0:17:25.14,sign_1168_onscreen_descriptions_bg,SIGN,0,0,0,,{\pos(505,180)\frz90\fnGeorgia\c&HF3F5F5&\3c&HF3F5F5&\4c&H6E7287&\xshad-2\yshad-2\fs22}كانساي يقطع من البطن
Dialogue: 1,0:17:21.89,0:17:25.14,sign_1168_onscreen_descriptions,SIGN,0,0,0,,{\pos(505,180)\frz90\fnGeorgia\c&H2DDBCF&\3c&H6E7287&\alpha33\fs22}كانساي يقطع من البطن
Dialogue: 0,0:17:21.90,0:17:27.90,DCMain,GENTA,0,0,0,,.وفي كانساي، الأنقليس يقطع من البطن
Dialogue: 0,0:17:27.90,0:17:30.15,DCMain,AYUMI,0,0,0,,حقًا؟
Dialogue: 0,0:17:30.15,0:17:34.00,DCMain,GENTA,0,0,0,,يعتقد بعض الناس أن الأنقليس يقطع من العمود الفقري في كانتو
Dialogue: 0,0:17:33.19,0:17:41.16,sign_1168_onscreen_descriptions_bg,SIGN,0,0,0,,{\fnGeorgia\c&HFFFFFF&\3c&HFFFFFF&\4c&H5B598D&\xshad2\yshad-2\fs14\an2\fad(500,500)\pos(120,43)}يقطع من البطن
Dialogue: 1,0:17:33.19,0:17:41.16,sign_1168_onscreen_descriptions,SIGN,0,0,0,,{\fnGeorgia\c&H322BC3&\3c&H5B598D&\alpha33\fs14\fad(500,500)\an2\bord0.3\pos(120,43)}يقطع من البطن
Dialogue: 0,0:17:33.19,0:17:41.16,sign_1168_onscreen_descriptions_bg,SIGN,0,0,0,,{\fnGeorgia\c&HFFFFFF&\3c&HFFFFFF&\4c&H5B598D&\xshad-2\yshad-2\fs14\an2\fad(500,500)\pos(300,43)}هاراكيري
Dialogue: 1,0:17:33.19,0:17:41.16,sign_1168_onscreen_descriptions,SIGN,0,0,0,,{\fnGeorgia\c&H322BC3&\3c&H5B598D&\alpha33\fs14\fad(500,500)\an2\bord0.3\pos(300,43)}هاراكيري
Dialogue: 0,0:17:34.00,0:17:38.60,DCMain,GENTA,0,0,0,,،لتجنب أي ارتباطات مع الهاراكيري
Dialogue: 0,0:17:38.60,0:17:42.35,DCMain,GENTA,0,0,0,,.لكن في كانتو، الأنقليس يتم تبخيره قبل الشوي
Dialogue: 0,0:17:42.35,0:17:47.03,DCMain,GENTA,0,0,0,,،لمنع الأنقليس من أن يصبح طريًا جدًا ويسقط من السيخ
Dialogue: 0,0:17:47.03,0:17:49.62,DCMain,GENTA,0,0,0,,.يتم سحب الأنقليس من جانب العمود الفقري الأكثر سمكًا
Dialogue: 0,0:17:49.62,0:17:51.42,DCMain,GENTA,0,0,0,,.لهذا السبب يقطعون من العمود الفقري
Dialogue: 0,0:17:51.72,0:17:53.04,DCMain,AYUMI,0,0,0,,!رائع
Dialogue: 0,0:17:53.04,0:17:56.18,DCMain,HAIBARA,0,0,0,,.الأنقليس له ظهور داكنة وبطون بيضاء
Dialogue: 0,0:17:56.18,0:17:58.93,DCMain,HAIBARA,0,0,0,,،بما أن الجلد على الحواف أبيض
Dialogue: 0,0:17:59.25,0:18:03.18,DCMain,HAIBARA,0,0,0,,.هذا يعني أن هذا الأنقليس تم قطعه من البطن
Dialogue: 0,0:18:03.18,0:18:05.69,DCMain,MITSUHIKO,0,0,0,,.بمعنى آخر، تم إعداده على طريقة كانساي
Dialogue: 0,0:18:06.08,0:18:08.31,DCMain,CONAN,0,0,0,,.الطاهي كان طوكيويًا أصيلاً
Dialogue: 0,0:18:08.31,0:18:11.69,DCMain,CONAN,0,0,0,,سيكون غريبًا أن يعد الأنقليس فجأة على طريقة كانساي، أليس كذلك؟
Dialogue: 0,0:18:12.15,0:18:15.02,DCMain,GENTA,0,0,0,,.وهذا الأنقليس لم يتم تبخيره
Dialogue: 0,0:18:15.02,0:18:17.59,DCMain,GENTA,0,0,0,,.لم يكن رقيقًا على الإطلاق
Dialogue: 0,0:18:17.59,0:18:22.21,DCMain,GENTA,0,0,0,,.بمعنى آخر، شخص آخر أعد هذا الأنقليس على طريقة كانساي
Dialogue: 0,0:18:23.21,0:18:24.46,DCMain,OKAMOTO,0,0,0,,.فهمت
Dialogue: 0,0:18:25.13,0:18:29.96,DCMain,CONAN,0,0,0,,يا سيد أوكاموتو، أنت طاهي سابق من كانساي، أليس كذلك؟
Dialogue: 0,0:18:30.26,0:18:31.46,DCMain,OKAMOTO,0,0,0,,ماذا؟
Dialogue: 0,0:18:31.78,0:18:34.53,DCMain,CONAN,0,0,0,,.يديك متعرجة وسميكة
Dialogue: 0,0:18:34.53,0:18:37.72,DCMain,CONAN,0,0,0,,.يديك تحملان آثار مسامير من كثرة استعمال السكاكين عبر السنين.
Dialogue: 0,0:18:39.47,0:18:43.83,DCMain,CONAN,0,0,0,,.بالإضافة، قلت أنك سـ"ترتب" الدعوة
Dialogue: 0,0:18:43.64,0:18:49.23,sign_1168_onscreen_descriptions_bg,SIGN,0,0,0,,{\c&H291D11&\3c&HF1F4F3&\4c&H291D11&\an4\fs16\pos(155,70)\fad(500,1)\fnGeorgia}كانساي
Dialogue: 0,0:18:43.64,0:18:49.23,sign_1168_onscreen_descriptions,SIGN,0,0,0,,{\c&HF5EAE3&\3c&H291D11&\4c&HAD8766&\an8\fs16\pos(155,160)\fad(500,1)\fnGeorgia}ترتيب
Dialogue: 0,0:18:43.64,0:18:49.23,sign_1168_onscreen_descriptions_bg,SIGN,0,0,0,,{\c&H291D11&\3c&HF1F4F3&\4c&H291D11&\an4\fs16\pos(185,220)\fad(500,1)\fnGeorgia}اليابانية\Nالقياسية
Dialogue: 0,0:18:43.64,0:18:49.23,sign_1168_onscreen_descriptions,SIGN,0,0,0,,{\c&HF5EAE3&\3c&H291D11&\4c&HAD8766&\an7\fs16\pos(265,265)\fad(500,1)\fnGeorgia}الوضع البعيدًا
Dialogue: 0,0:18:44.22,0:18:47.14,DCMain,CONAN,0,0,0,,.إذا كنت تقصد أنك ستضعها بعيدًا
Dialogue: 0,0:18:47.14,0:18:49.23,DCMain,CONAN,0,0,0,,أليس ذلك باللهجة الكانسائية؟
Dialogue: 0,0:18:50.15,0:18:57.57,DCMain,OKAMOTO,0,0,0,,صحيح أنني كنت طاهي الأنقليس في كانساي، لكن ماذا في ذلك؟
Dialogue: 0,0:18:57.57,0:19:00.49,DCMain,OKAMOTO,0,0,0,,لماذا اطهي الأنقليس في مطعم جينباتشي؟
Dialogue: 0,0:19:00.85,0:19:02.17,DCMain,CONAN,0,0,0,,.الأمر بسيط
Dialogue: 0,0:19:02.17,0:19:07.13,DCMain,CONAN,0,0,0,,.تجادلت مع الطاهي وطعنته بأداة حادة قريبة
Dialogue: 0,0:19:12.55,0:19:13.76,DCMain,RIO,0,0,0,,.المعذرة
Dialogue: 0,0:19:13.76,0:19:16.88,DCMain,CONAN,0,0,0,,ثم دخلت زبونة بالصدفة إلى المطعم، أليس كذلك؟
Dialogue: 0,0:19:16.88,0:19:18.82,DCFlashbackTop,RIO,0,0,0,,هل يمكنني طلب شيء للتوصيل؟
Dialogue: 0,0:19:17.78,0:19:21.26,DCMain,CONAN,0,0,0,,،إذا هربت على الفور، سيتم الإبلاغ عنك والقبض عليك فورًا
Dialogue: 0,0:19:18.82,0:19:21.26,DCFlashbackTop,RIO,0,0,0,,.أريد بعض الأنقليس
Dialogue: 0,0:19:21.87,0:19:26.77,DCMain,CONAN,0,0,0,,.لذا تظاهرت بأنك الطاهي بدلاً من ذلك
Dialogue: 0,0:19:26.77,0:19:31.27,DCMain,MITSUHIKO,0,0,0,,.لهذا كان طعم طبق الأنقليس مختلفًا عن المعتاد
Dialogue: 0,0:19:31.27,0:19:33.13,DCMain,OKAMOTO,0,0,0,,.انتظروا لحظة
Dialogue: 0,0:19:33.13,0:19:36.28,DCMain,OKAMOTO,0,0,0,,هل لديكم أي دليل على أنني الجاني؟
Dialogue: 0,0:19:36.28,0:19:38.03,DCMain,GENTA,0,0,0,,.بالطبع لدينا
Dialogue: 0,0:19:38.03,0:19:39.03,DCMain,OKAMOTO,0,0,0,,ماذا؟
Dialogue: 0,0:19:39.03,0:19:41.88,DCMain,GENTA,0,0,0,,.لاحظت شيئًا أثناء البحث في مطعم جينباتشي
Dialogue: 0,0:19:41.88,0:19:46.29,DCMain,GENTA,0,0,0,,.إحدى الأدوات المستخدمة لطهي الأنقليس كانت مفقودة
Dialogue: 0,0:19:46.29,0:19:47.31,DCMain,AYUMI,0,0,0,,ماذا؟
Dialogue: 0,0:19:47.31,0:19:49.29,DCMain,MITSUHIKO,0,0,0,,ما الذي كان مفقودًا؟
Dialogue: 0,0:19:49.63,0:19:50.90,DCMain,GENTA,0,0,0,,.مروحة
Dialogue: 0,0:19:50.90,0:19:53.55,DCMain,GENTA,0,0,0,,.تستخدم عند شوي الأنقليس على الفحم
Dialogue: 0,0:19:53.54,0:19:58.80,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an7\3c&H2C296D&\c&HE0E0E0&\fad(1,500)\pos(460,10)}جينباتشي
Dialogue: 0,0:19:53.55,0:19:56.81,DCMain,CONAN,0,0,0,,استخدمتها أثناء طهي الأنقليس، أليس كذلك؟
Dialogue: 0,0:19:56.81,0:20:02.10,DCMain,CONAN,0,0,0,,،بعد انتهائك من الطهي وكنت تمسح بصماتك
Dialogue: 0,0:20:02.09,0:20:07.56,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an6\frz20\fs24\3c&H2C296D&\c&HE0E0E0&\fad(500,1)\pos(257,165)}جينباتشي
Dialogue: 0,0:20:02.10,0:20:07.56,DCMain,CONAN,0,0,0,,.أدركتَ أنك لا تستطيع إزالة بصماتك من المروحة الورقية
Dialogue: 0,0:20:07.56,0:20:10.31,DCMain,HAIBARA,0,0,0,,.لذا كان عليك إحضارها معك
Dialogue: 0,0:20:16.89,0:20:18.82,DCMain,GENTA,0,0,0,,!إنها هنا ، أليس كذلك؟
Dialogue: 0,0:20:17.80,0:20:18.82,DCMainTop,OKAMOTO,0,0,0,,!أعطني ذلك
Dialogue: 0,0:20:19.19,0:20:21.07,sign_1168_ginpachi_awning,SIGN,0,0,0,,{\an6\frz20\fs24\3c&H2C296D&\c&HE0E0E0&\fad(500,1)\pos(570,69)}جينباتشي
Dialogue: 0,0:20:19.72,0:20:21.07,DCMain,GENTA,0,0,0,,!كما توقعت
Dialogue: 0,0:20:22.38,0:20:24.68,DCMain,CONAN,0,0,0,,.لا يمكنك التهرب من هذا
Dialogue: 0,0:20:24.68,0:20:26.45,DCMain,OKAMOTO,0,0,0,,!تبا! ابتعدوا
Dialogue: 0,0:20:27.73,0:20:28.83,DCMain,MITSUHIKO,0,0,0,,!لقد هرب
Dialogue: 0,0:20:29.24,0:20:30.86,DCMain,GENTA,0,0,0,,!لن يهرب
Dialogue: 0,0:20:33.04,0:20:34.21,DCMain,GENTA,0,0,0,,!توقف
Dialogue: 0,0:20:34.45,0:20:35.46,DCMain,CONAN,0,0,0,,!غينتا
Dialogue: 0,0:20:36.44,0:20:41.55,DCMain,GENTA,0,0,0,,!لا أحد يهرب بعد تهديده للأنقليس وانا موجود
Dialogue: 0,0:20:45.06,0:20:46.22,DCMain,MITSUHIKO,0,0,0,,!غينتا
Dialogue: 0,0:20:46.22,0:20:48.22,sign_1168_account_book,SIGN,0,0,0,,{\an2\fs16\bord2\shad0.5\frz-70\pos(325,144)}دفتر الحسابات
Dialogue: 0,0:20:46.46,0:20:48.23,DCMain,MITSUHIKO,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:20:50.91,0:20:57.42,DCItalic,GENTA/ID,0,0,0,,!بعد ذلك، جاءت الشرطة والمحقق تاكاغي وأخذوا الجاني
Dialogue: 0,0:21:03.24,0:21:09.00,sign_1168_genta_writing,SIGN,0,0,0,,{\fs30\c&H000000&\3c&HA4B7DD&\4c&H8A96AE&\frz-10\an3\pos(603,128)\fad(200,500)}القضية انتهت 
Dialogue: 0,0:21:03.56,0:21:06.06,DCMain,GENTA,0,0,0,,!القضية انتهت
Dialogue: 0,0:21:12.20,0:21:13.99,DCEnding,,0,0,0,,!مرح! مرح! مرح
Dialogue: 0,0:21:16.38,0:21:22.59,DCEnding,,0,0,0,,قلبي ينبض بقوة قلبي ينبض بقوة أنا حقًا فضولي بشأن الحقيقة
Dialogue: 0,0:21:22.79,0:21:29.39,DCEnding,,0,0,0,,هل تحاول؟ من الصعب الكذب، أليس كذلك؟ يا! يا
Dialogue: 0,0:21:29.44,0:21:35.68,DCEnding,,0,0,0,,لاااا، أنا أفقد صوابي! هل من أحد يساعدني؟
Dialogue: 0,0:21:35.88,0:21:41.05,DCEnding,,0,0,0,,(كذبة أم حقيقة؟ لا أستطيع أن أقول (كل شيء أو لا شيء
Dialogue: 0,0:21:41.66,0:21:48.73,DCEnding,,0,0,0,,أنا في غاية الحب معك، أنا في غاية الحب معك
Dialogue: 0,0:21:48.88,0:21:55.42,DCEnding,,0,0,0,,يحب! هذا صحيح! سوف أتعرض لحروق شديدة
Dialogue: 0,0:21:55.58,0:22:02.75,DCEnding,,0,0,0,,تألق، ارقص معي، ارقص، ارقص، ارقص بابتسامة مبهرة
Dialogue: 0,0:22:03.92,0:22:10.09,DCEnding,,0,0,0,,أنسى الأشياء السيئة وأحبها، لا يمكن مساعدتها
Dialogue: 0,0:22:10.38,0:22:16.32,DCEnding,,0,0,0,,أنت وأنا وتلك الفتاة، إذا رقصنا، سنكون جميعًا سعداء
Dialogue: 0,0:22:16.76,0:22:22.93,DCEnding,,0,0,0,,تعال! تعال! أنت تتألق بشكل مشرق اليوم أيضًا
Dialogue: 0,0:22:23.58,0:22:28.57,DCEnding,,0,0,0,,!إنه أمر ممتع عندما يكون الجميع هناك، لذلك دعونا نذهب
Dialogue: 0,0:22:31.99,0:22:35.66,DCMainTop,UNAGIZUKA,0,0,0,,.غضبت لأنه لم يبتعد عني
Dialogue: 0,0:22:35.50,0:22:40.00,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(340,256)}(60) أوناجيزوكا شيجيرو 
Dialogue: 0,0:22:35.50,0:22:40.00,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(340,273)} صاحب مطعم الأنقليس "جينباتشي"
Dialogue: 0,0:22:35.66,0:22:39.22,DCMainTop,UNAGIZUKA,0,0,0,,"صرخت، "كنت طاهي الأنقليس! أليس لديك أي ضمير؟
Dialogue: 0,0:22:39.22,0:22:43.40,DCMainTop,UNAGIZUKA,0,0,0,,"!"كيف تجرؤ على استخدام الأنقليس لتحقيق ربح ما
Dialogue: 0,0:22:43.40,0:22:45.96,DCMain,UNAGIZUKA,0,0,0,,.لا بد أن هذا أزعجه
Dialogue: 0,0:22:45.96,0:22:48.01,DCMain,MITSUHIKO,0,0,0,,.كان ذلك قاسيًا منك
Dialogue: 0,0:22:48.34,0:22:50.40,DCMain,UNAGIZUKA,0,0,0,,.أنا من طوكيو
Dialogue: 0,0:22:50.40,0:22:52.52,DCMain,UNAGIZUKA,0,0,0,,.لقد ولدت هكذا
Dialogue: 0,0:22:52.52,0:22:56.23,DCMain,HAIBARA,0,0,0,,.يجب أن تكون أكثر حذرًا في المستقبل
Dialogue: 0,0:22:56.23,0:22:58.52,DCMain,HAIBARA,0,0,0,,.يقولون أن الكلام أصل البلاء
Dialogue: 0,0:22:59.52,0:23:00.85,DCMain,UNAGIZUKA,0,0,0,,.لا شك في ذلك
Dialogue: 0,0:23:00.85,0:23:04.53,DCMain,UNAGIZUKA,0,0,0,,.على أي حال، سمعت أنكم يا أطفال وجدتم الجاني
Dialogue: 0,0:23:04.91,0:23:07.85,DCMain,MITSUHIKO,0,0,0,,.غينتا لعب دورًا كبيرًا هذه المرة
Dialogue: 0,0:23:07.85,0:23:12.47,DCMain,CONAN,0,0,0,,.نعم. إذا لم يلاحظ غينتا أن شخصًا آخر طهَ الأنقليس
Dialogue: 0,0:23:12.47,0:23:15.04,DCMain,CONAN,0,0,0,,.ربما لم نكن لنعرف الجاني أبدًا
Dialogue: 0,0:23:15.04,0:23:17.54,DCMain,AYUMI,0,0,0,,.أعرف. كنت رائعًا يا غينتا
Dialogue: 0,0:23:17.90,0:23:20.73,DCMain,GENTA,0,0,0,,.لم أفعل الكثير
Dialogue: 0,0:23:20.73,0:23:25.80,DCMain,UNAGIZUKA,0,0,0,,.حسنًا، أنا معجب. بمجرد خروجي من هنا، سأطعمكم جميع أنواع الأنقليس التي تستطيعون أكلها
Dialogue: 0,0:23:26.62,0:23:28.05,DCMain,GENTA,0,0,0,,!حقًا؟
Dialogue: 0,0:23:28.39,0:23:30.33,DCMain,UNAGIZUKA,0,0,0,,.الرجل لا يتراجع عن كلمته
Dialogue: 0,0:23:30.33,0:23:33.31,DCMain,UNAGIZUKA,0,0,0,,.آمل أن تساعدوني مرة أخرى إذا حدث أي شيء
Dialogue: 0,0:23:33.31,0:23:35.61,DCMain,GENTA,0,0,0,,!يمكنك الاعتماد علينا
Dialogue: 0,0:23:35.61,0:23:38.96,DCMain,GENTA,0,0,0,,.ثم سأملأ نفسي بالأنقليس
Dialogue: 0,0:23:40.01,0:23:41.21,DCMain,GENTA,0,0,0,,!لذيذ جدًا
Dialogue: 0,0:23:41.21,0:23:42.30,DCItalic,NA,0,0,0,,!لذيذ
Dialogue: 1,0:23:41.44,0:23:44.82,sign_1168_onscreen_descriptions,SIGN,0,0,0,,{\pos(550,210)\an2\fs20\c&H2729EB&\bord0\3c&H0000AB&\4c&H000098&\shad1\fad(700,2100)}لذيذ!
Dialogue: 0,0:23:41.44,0:23:44.90,sign_1168_onscreen_descriptions_bg,SIGN,0,0,0,,{\pos(550,210)\an2\fs20\c&HFCFFFF&\3c&HFCFFFF&\4c&H0000AB&\yshad-2\xshad-2\fad(700,2000)}لذيذ!
