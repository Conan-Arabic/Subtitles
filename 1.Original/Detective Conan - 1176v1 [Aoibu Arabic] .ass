Dialogue: 0,0:06:52.14,0:06:53.39,Default,,0,0,0,,!لذيذ جدًا
Dialogue: 0,0:06:53.39,0:06:54.89,Default,,0,0,0,,!لذيذ
Dialogue: 0,0:06:54.89,0:06:56.52,Default,,0,0,0,,!أنه رائع
Dialogue: 0,0:07:08.10,0:07:09.57,Default,,0,0,0,,.هذا المحقق تشيبا
Dialogue: 0,0:07:09.57,0:07:13.09,Default,,0,0,0,,نعم. ماذا يفعل هنا؟
Dialogue: 0,0:07:13.09,0:07:14.29,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:07:14.95,0:07:16.62,Default,,0,0,0,,.لا شيء إطلاقاً
Dialogue: 0,0:07:25.05,0:07:28.30,sign_1176_hall,SIGN,0,0,0,,{\pos(320,250)\fnImpact\fax-0.4}قاعة يايبا إيشينوماكي
Dialogue: 0,0:07:25.05,0:07:28.30,sign_suspect,SIGN,0,0,0,,{\pos(320,290)\fad(500,1)}قاعة يايبا - إيشينوماكي
Dialogue: 0,0:07:28.58,0:07:29.79,Default,,0,0,0,,.أهلًا وسهلًا
Dialogue: 0,0:07:29.79,0:07:31.45,Default,,0,0,0,,!مرحبًا
Dialogue: 0,0:07:31.45,0:07:34.06,Default,,0,0,0,,.ارجو ان تستمتعوا اليوم
Dialogue: 0,0:07:55.08,0:07:57.58,sign_1176_tv_dialogue,SIGN,0,0,0,,{\an2\frz15\fry30\fax-0.3\pos(125,210)\c&HA8692D&}هيا! {\c&H804188&}كامين يايبا!!
Dialogue: 0,0:08:00.33,0:08:03.59,sign_suspect,SIGN,0,0,0,,{\pos(320,290)\fad(500,1)}كنتيو كانكيمارو شوتن
Dialogue: 0,0:08:11.02,0:08:12.13,Default,,0,0,0,,.تشيبا معك
Dialogue: 0,0:08:12.90,0:08:15.27,Default,,0,0,0,,.لا اتصال بعد
Dialogue: 0,0:08:16.27,0:08:19.98,Default,,0,0,0,,.نعم. نعم. حسنًا
Dialogue: 0,0:08:23.73,0:08:26.74,sign_suspect,SIGN,0,0,0,,{\pos(320,300)}داريو (35)
Dialogue: 0,0:08:26.74,0:08:31.87,sign_1176_shoten,SIGN BUILDING,0,0,0,,{\s1\fnGeorgia\pos(540,145)\shad1\4c&H130D1D&\c&H3C3051&}كانكيمارو شوتن
Dialogue: 0,0:08:35.99,0:08:37.50,Default,,0,0,0,,.آمل أن تكونوا استمتعتم اليوم
Dialogue: 0,0:08:37.81,0:08:39.94,Default,,0,0,0,,.أراكم غدًا
Dialogue: 0,0:08:39.94,0:08:41.65,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:08:43.89,0:08:45.75,Default,,0,0,0,,!في صحتكم
Dialogue: 0,0:09:11.62,0:09:14.03,Default,,0,0,0,,!لذيذ جدًا! واحد أخر، من فضلك
Dialogue: 0,0:09:14.38,0:09:16.90,Default,,0,0,0,,.أبي
Dialogue: 0,0:09:19.73,0:09:21.99,Default,,0,0,0,,ما زلت تفكر في المحقق تشيبا؟
Dialogue: 0,0:09:21.99,0:09:25.31,Default,,0,0,0,,.نعم. لدي شعور سيء
Dialogue: 0,0:09:33.41,0:09:34.79,Default,,0,0,0,,.لقد اقترب الوقت
Dialogue: 0,0:09:34.79,0:09:37.79,Default,,0,0,0,,.أنا أشعر بتوتر كبير
Dialogue: 0,0:09:37.79,0:09:40.65,Default,,0,0,0,,.ابقي معي، آي
Dialogue: 0,0:09:40.65,0:09:42.10,Default,,0,0,0,,.بالطبع
Dialogue: 0,0:09:42.68,0:09:44.66,Default,,0,0,0,,.الساعة التاسعة والنصف
Dialogue: 0,0:09:44.66,0:09:47.36,Default,,0,0,0,,.السيد كانيهارا متأخر قليلًا
Dialogue: 0,0:09:48.98,0:09:50.86,Default,,0,0,0,,!لا، الشارة
Dialogue: 0,0:09:50.86,0:09:52.36,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:09:52.62,0:09:55.37,Default,,0,0,0,,ماذا؟ نسيتيه في الغرفة؟
Dialogue: 0,0:09:55.37,0:09:57.76,Default,,0,0,0,,.أنا آسفة جدًا! سأذهب لأحضره
Dialogue: 0,0:09:57.76,0:09:59.24,Default,,0,0,0,,.انتظري، سأذهب معكِ
Dialogue: 0,0:09:59.56,0:10:00.75,Default,,0,0,0,,!سأكون بخير
Dialogue: 0,0:10:20.49,0:10:21.77,Default,,0,0,0,,المحقق تشيبا؟
Dialogue: 0,0:10:32.53,0:10:35.60,Default,,0,0,0,,تبا. أين ذهب؟
Dialogue: 0,0:10:35.60,0:10:37.64,Default,,0,0,0,,هل أستطيع مساعدتك؟
Dialogue: 0,0:10:38.24,0:10:39.53,Default,,0,0,0,,!أيها المحقق تشيبا
Dialogue: 0,0:10:41.75,0:10:43.00,Default,,0,0,0,,آيومي؟
Dialogue: 0,0:10:43.70,0:10:45.54,Default,,0,0,0,,!ابتعدي! اهربي
Dialogue: 0,0:10:47.54,0:10:49.98,Default,,0,0,0,,!توقف! أطلق سراحها
Dialogue: 0,0:11:07.12,0:11:09.52,Default,,0,0,0,,.آيومي تأخذ وقتًا طويلاً جدًا
Dialogue: 0,0:11:10.09,0:11:11.78,Default,,0,0,0,,آيومي، هل ستعودين؟
Dialogue: 0,0:11:12.11,0:11:14.53,Default,,0,0,0,,ماذا حدث لآيومي؟
Dialogue: 0,0:11:14.53,0:11:16.19,Default,,0,0,0,,.أنا قلق
Dialogue: 0,0:11:16.19,0:11:18.53,Default,,0,0,0,,.ربما يجب أن نعود أيضًا
Dialogue: 0,0:11:22.37,0:11:24.66,Default,,0,0,0,,.آسف لتأخري
Dialogue: 0,0:11:25.54,0:11:29.67,Default,,0,0,0,,.آسفة. أحد الأطفال عاد ليأخذ شيئًا نسيه
Dialogue: 0,0:11:29.67,0:11:31.80,Default,,0,0,0,,هل يمكنك الانتظار قليلاً؟
Dialogue: 0,0:11:32.05,0:11:35.48,Default,,0,0,0,,.آسف، لكن التصوير سيبدأ قريبًا
Dialogue: 0,0:11:35.48,0:11:37.18,Default,,0,0,0,,.سنبدأ معكم أولًا
Dialogue: 0,0:11:37.18,0:11:39.74,Default,,0,0,0,,.لا يمكننا فعل ذلك
Dialogue: 0,0:11:39.74,0:11:42.90,Default,,0,0,0,,.لن نكن فرقة المحققين الصغار إلا إذا كنا جميعًا هنا
Dialogue: 0,0:11:42.90,0:11:45.18,Default,,0,0,0,,...حـ-حسنًا، لكن
Dialogue: 0,0:11:45.48,0:11:49.38,Default,,0,0,0,,يا أختي ران، لماذا لا تذهبين مع هذين الاثنين؟
Dialogue: 0,0:11:49.38,0:11:52.44,Default,,0,0,0,,.سنبحث عن آيومي ونلتحق بكم لاحقًا
Dialogue: 0,0:11:53.94,0:11:56.82,Default,,0,0,0,,.فهمت. أعتمد عليكم
Dialogue: 0,0:12:05.52,0:12:08.49,Default,,0,0,0,,...يا كونان، ساعدني
Dialogue: 0,0:12:10.13,0:12:12.21,Default,,0,0,0,,.المعذرة. أرجو أن توقف السيارة
Dialogue: 0,0:12:12.21,0:12:13.41,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:12:13.41,0:12:15.48,Default,,0,0,0,,.أحتاج لاستخدام المرحاض
Dialogue: 0,0:12:15.48,0:12:16.59,Default,,0,0,0,,.وأنا كذلك
Dialogue: 0,0:12:16.92,0:12:20.72,Default,,0,0,0,,.حسنًا، سنتوقف عند محل، تحملوا
Dialogue: 0,0:12:26.68,0:12:29.85,Default,,0,0,0,,.ليس لدينا وقت كثير. أسرعوا
Dialogue: 0,0:12:31.86,0:12:33.20,Default,,0,0,0,,.آسف
Dialogue: 0,0:12:33.20,0:12:35.36,Default,,0,0,0,,.نعتذر، اذهبوا بدلاً منا
Dialogue: 0,0:12:35.36,0:12:37.61,Default,,0,0,0,,.ماذا؟ مهلاً، انتظروا
Dialogue: 0,0:12:39.36,0:12:41.02,Default,,0,0,0,,...تبا
Dialogue: 0,0:12:43.37,0:12:45.87,sign_1176_phone_call,SIGN,0,0,0,,{\c&HFFFFFF&\bord0\shad0\frz-38\an2\fax-0.5\pos(396,95)}مكالمة واردة
Dialogue: 0,0:12:43.37,0:12:45.87,sign_1176_phone_call,SIGN,0,0,0,,{\c&HFFFFFF&\bord0\shad0\frz-38\an8\fax-0.5\fs24\pos(340,153)}ران
Dialogue: 0,0:12:43.37,0:12:45.87,sign_1176_phone_call,SIGN RED,0,0,0,,{\frz-42\an8\fax-0.4\3c&H79449B&\yshad2\4c&HFFFFFF&\c&HFFFFFF&\pos(165,196)}رفض
Dialogue: 0,0:12:43.37,0:12:45.87,sign_1176_phone_call,SIGN GREEN,0,0,0,,{\frz-42\an8\fax-0.3\c&HFFFFFF&\yshad2\4c&HFFFFFF&\3c&H7A9828&\pos(247,269)}رد
Dialogue: 0,0:12:44.98,0:12:48.37,Default,,0,0,0,,.لسان البقر، لسان البقر
Dialogue: 0,0:12:48.37,0:12:50.95,Default,,0,0,0,,.محار، محار
Dialogue: 0,0:12:52.99,0:12:56.88,Default,,0,0,0,,.لم تعود، شارة التحقيق كانت على الأرض أيضًا
Dialogue: 0,0:12:56.88,0:13:00.00,Default,,0,0,0,,.تبا. كان حدسي صحيحًا
Dialogue: 0,0:13:19.25,0:13:21.61,Default,,0,0,0,,ماذا؟ أحدهم رأى المحقق تشيبا؟
Dialogue: 0,0:13:21.61,0:13:25.20,Default,,0,0,0,,.نعم. شخصاً بدا مثله، على الأقل
Dialogue: 0,0:13:32.12,0:13:33.20,Default,,0,0,0,,.نعم، نعم
Dialogue: 0,0:13:33.20,0:13:34.88,Default,,0,0,0,,مرحبًا، كونان؟
Dialogue: 0,0:13:34.88,0:13:37.08,Default,,0,0,0,,أيها المحقق تاكاكي؟
Dialogue: 0,0:13:37.08,0:13:39.51,Default,,0,0,0,,.عمي كوغورو طلب مني أن أتصل
Dialogue: 0,0:13:39.91,0:13:42.67,Default,,0,0,0,,ألم يكن المحقق تشيبا يحقق في شيء؟
Dialogue: 0,0:13:42.67,0:13:45.15,Default,,0,0,0,,...ماذا؟
Dialogue: 0,0:13:45.15,0:13:47.76,Default,,0,0,0,,كونان، أين أنتم الآن؟
Dialogue: 0,0:13:48.84,0:13:51.14,Default,,0,0,0,,.نحن في إيشينوماكي
Dialogue: 0,0:13:51.14,0:13:52.26,Default,,0,0,0,,.قال عمي كوغورو إنه رأى المحقق تشيبا
Dialogue: 0,0:13:54.88,0:13:57.17,Default,,0,0,0,,.يا إلهي
Dialogue: 0,0:13:57.76,0:14:01.28,Default,,0,0,0,,...يا كونان، بيننا فقط
Dialogue: 0,0:14:02.57,0:14:04.72,Default,,0,0,0,,،حسب كلام المحقق تاكاكي
Dialogue: 0,0:14:04.72,0:14:08.54,Default,,0,0,0,,.كان المحقق تشيبا يجرِّى تحقيقًا تمهيديًا خاصًا
Dialogue: 0,0:14:10.08,0:14:17.50,Default,,0,0,0,,.لسنوات، كانت تُسرق سلع نادرة ومرغوبة وتُباع في السوق السوداء بالخارج
Dialogue: 0,0:14:17.50,0:14:25.30,Default,,0,0,0,,.حدث حتى قتل مرتبط بالقضية في المدينة
Dialogue: 0,0:14:28.77,0:14:33.90,Default,,0,0,0,,وبوصفه مُحبًا لتوكوساتسو، ظن المحقق تشيبا أنه يجد مشتبهين محتملين
Dialogue: 0,0:14:34.23,0:14:37.68,Default,,0,0,0,,.بتتبع الأمر من الباعة الدوليين
Dialogue: 0,0:14:38.58,0:14:43.08,Default,,0,0,0,,،كان ينوي عرض قضيته على مقر التحقيق عندما يجد دليلًا
Dialogue: 0,0:14:43.08,0:14:45.18,Default,,0,0,0,,.مدفوعًا بغضبه
Dialogue: 0,0:14:46.46,0:14:48.07,Default,,0,0,0,,.هذا ليس جيدًا
Dialogue: 0,0:14:48.07,0:14:51.17,Default,,0,0,0,,.نعم. يبدو أن آيومي تورطت في القضية التي يحقق بها المحقق تشيبا
Dialogue: 0,0:14:54.56,0:14:58.67,Default,,0,0,0,,،إذا اتصلنا بلا مبالاة بهاتف أنسة يوشيدا ولاحظ الجاني
Dialogue: 0,0:14:58.67,0:14:59.84,Default,,0,0,0,,.قد نُعرضها للخطر
Dialogue: 0,0:15:02.32,0:15:05.47,Default,,0,0,0,,...لحظة. أليس المحقق تشيبا
Dialogue: 0,0:15:10.42,0:15:12.97,Default,,0,0,0,,مسح رمز الباروكود؟
Dialogue: 0,0:15:13.29,0:15:17.04,Default,,0,0,0,,.ربما هناك دليل في ذلك الرمز
Dialogue: 0,0:15:17.04,0:15:19.44,Default,,0,0,0,,.نعم. للنحقق في الأمر
Dialogue: 0,0:15:19.44,0:15:21.73,Default,,0,0,0,,!يا كونان
Dialogue: 0,0:15:21.73,0:15:23.90,Default,,0,0,0,,!أنسة هايبرا
Dialogue: 0,0:15:25.29,0:15:26.67,Default,,0,0,0,,أنتما؟
Dialogue: 0,0:15:26.67,0:15:29.40,Default,,0,0,0,,آيومي مفقودة، أليس كذلك؟
Dialogue: 0,0:15:29.40,0:15:31.87,Default,,0,0,0,,.سنساعدكما في البحث عنها
Dialogue: 0,0:15:31.87,0:15:33.42,Default,,0,0,0,,.سمعونا
Dialogue: 0,0:15:34.24,0:15:37.21,Default,,0,0,0,,.حسنًا. إذًا لنتفرق
Dialogue: 0,0:15:37.21,0:15:40.38,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}متحف سان خوان باوتيستا
Dialogue: 0,0:15:41.10,0:15:43.74,Default,,0,0,0,,.أتساءل إن كان الأطفال بخير
Dialogue: 0,0:15:44.33,0:15:47.01,Default,,0,0,0,,أين كانيهارا؟
Dialogue: 0,0:15:47.37,0:15:49.79,Default,,0,0,0,,هل اختفى مرة أخرى؟
Dialogue: 0,0:15:49.79,0:15:51.01,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:52.78,0:15:54.37,Default,,0,0,0,,.ليس هذا
Dialogue: 0,0:15:54.37,0:15:56.14,Default,,0,0,0,,.وليس هذا أيضًا
Dialogue: 0,0:15:58.76,0:15:59.90,Default,,0,0,0,,.هذا ليس
Dialogue: 0,0:16:00.48,0:16:02.35,Default,,0,0,0,,.ليس هذا
Dialogue: 0,0:16:05.33,0:16:07.15,Default,,0,0,0,,.هناك واحد هنا أيضًا
Dialogue: 0,0:16:19.11,0:16:22.33,Default,,0,0,0,,.192NE صغير و R حرف 
Dialogue: 0,0:16:22.33,0:16:24.61,Default,,0,0,0,,هل هذا يشير إلى طريق واتجاه؟
Dialogue: 0,0:16:24.61,0:16:26.08,Default,,0,0,0,,.من المحتمل
Dialogue: 0,0:16:26.08,0:16:28.80,Default,,0,0,0,,.هناك أيضًا هذا الذي تقشر
Dialogue: 0,0:16:28.80,0:16:31.18,Default,,0,0,0,,هل هذا المكان الذي تُجرى فيه الصفقة؟
Dialogue: 0,0:16:31.53,0:16:33.68,Default,,0,0,0,,.أو ربما نقطة تبادل
Dialogue: 0,0:16:34.03,0:16:35.43,Default,,0,0,0,,.لنذهب لنتفقده
Dialogue: 0,0:16:35.43,0:16:38.86,Default,,0,0,0,,.أ-أنا متعب
Dialogue: 0,0:16:38.86,0:16:41.00,Default,,0,0,0,,.لم أعد أستطيع الركض
Dialogue: 0,0:16:44.34,0:16:47.19,Default,,0,0,0,,.مرحبًا. شكرًا لأنكم مررتم علينا البارحة
Dialogue: 0,0:16:47.62,0:16:49.20,Default,,0,0,0,,!سيد موتومورا
Dialogue: 0,0:16:54.13,0:16:56.70,Default,,0,0,0,,هل أنت مستيقظ يا محقق تشيبا؟
Dialogue: 0,0:16:57.58,0:17:00.08,Default,,0,0,0,,.نعم. آسف، آيومي
Dialogue: 0,0:17:00.42,0:17:03.21,Default,,0,0,0,,.لا بأس. ليست غلطتك
Dialogue: 0,0:17:10.66,0:17:11.84,Default,,0,0,0,,.فهمت
Dialogue: 0,0:17:11.84,0:17:16.85,Default,,0,0,0,,.لن يفلتوا بفعل ذلك في مدينتنا إيشينوماكي
Dialogue: 0,0:17:16.85,0:17:18.34,Default,,0,0,0,,!هيا بنا
Dialogue: 0,0:17:24.05,0:17:25.28,Default,,0,0,0,,.انه قريب
Dialogue: 0,0:17:25.69,0:17:26.90,Default,,0,0,0,,!أنتِ قادرة على ذلك
Dialogue: 0,0:17:29.99,0:17:31.43,Default,,0,0,0,,هل توقفنا؟
Dialogue: 0,0:17:31.93,0:17:33.24,Default,,0,0,0,,!نعم
Dialogue: 0,0:17:33.24,0:17:35.24,Default,,0,0,0,,!حصلت على هاتفي
Dialogue: 0,0:17:37.87,0:17:39.68,Default,,0,0,0,,أين نحن؟
Dialogue: 0,0:17:39.68,0:17:41.20,Default,,0,0,0,,.أيها المحقق تشيبا، انظر
Dialogue: 0,0:17:49.11,0:17:50.32,Default,,0,0,0,,!إنها آيومي
Dialogue: 0,0:17:50.87,0:17:52.51,Default,,0,0,0,,!آيومي، مرحبًا؟
Dialogue: 0,0:17:52.51,0:17:53.84,Default,,0,0,0,,.كونان
Dialogue: 0,0:17:53.84,0:17:55.19,Default,,0,0,0,,.الحمد لله
Dialogue: 0,0:17:55.19,0:17:56.72,Default,,0,0,0,,هل أنتِ بخير يا آيومي؟
Dialogue: 0,0:17:56.72,0:17:57.76,Default,,0,0,0,,.نعم
Dialogue: 0,0:17:58.24,0:18:00.27,Default,,0,0,0,,.المحقق تشيبا معي
Dialogue: 0,0:18:00.27,0:18:03.89,Default,,0,0,0,,.آسف لأنني سمحت لحدوث هذا
Dialogue: 0,0:18:03.89,0:18:06.22,Default,,0,0,0,,الأهم، أين أنتم؟
Dialogue: 0,0:18:06.22,0:18:08.02,Default,,0,0,0,,،لا أعرف أين نحن
Dialogue: 0,0:18:08.38,0:18:11.19,Default,,0,0,0,,.لكننا محبوسون داخل صندوق شاحنة مغطاة
Dialogue: 0,0:18:12.29,0:18:15.42,Default,,0,0,0,,.رأينا صورًا كبيرة جدًا منذ قليل
Dialogue: 0,0:18:15.42,0:18:16.61,Default,,0,0,0,,صور؟
Dialogue: 0,0:18:16.61,0:18:20.29,Default,,0,0,0,,هل يمكن أن تكون جداريات ضخمة؟
Dialogue: 0,0:18:20.29,0:18:23.89,Default,,0,0,0,,.هذا هو. رأينا أربع جداريات كبيرة
Dialogue: 0,0:18:23.89,0:18:25.97,Default,,0,0,0,,،توقفنا هناك قليلاً
Dialogue: 0,0:18:25.97,0:18:28.14,Default,,0,0,0,,.ثم بدأنا بالتحرك مجددًا
Dialogue: 0,0:18:28.51,0:18:30.92,Default,,0,0,0,,...إذا توقفوا لفترة قصيرة، إذن
Dialogue: 0,0:18:31.41,0:18:33.42,Default,,0,0,0,,.لابد أنها نقطة التبديل
Dialogue: 0,0:18:33.68,0:18:36.93,Default,,0,0,0,,.أعرف أين كانوا. لنسرع
Dialogue: 0,0:18:42.93,0:18:45.81,sign_1176_signpost,SIGN,0,0,0,,{\c&HCACACC&\3c&HAB5D21&\4c&H46463A&\pos(260,220)\fs9\an8}مخرج
Dialogue: 0,0:18:46.06,0:18:49.82,sign_suspect,SIGN,0,0,0,,{\pos(320,290)\fad(500,1)}متحف كايغانسنو
Dialogue: 0,0:18:49.82,0:18:51.61,Default,,0,0,0,,!رائع
Dialogue: 0,0:18:51.61,0:18:53.07,Default,,0,0,0,,.قوي جدًا
Dialogue: 0,0:18:53.47,0:18:57.68,Default,,0,0,0,,.إذا رأوها على يمينهم، فعلينا التوجه مباشرة للأمام
Dialogue: 0,0:18:57.68,0:18:58.90,Default,,0,0,0,,.لنسرع
Dialogue: 0,0:18:58.90,0:19:03.32,Default,,0,0,0,,.انتظروا. إيدوغاوا يتأكد من وجهتنا الآن
Dialogue: 0,0:19:05.48,0:19:06.33,Default,,0,0,0,,.وجدته
Dialogue: 0,0:19:06.33,0:19:07.61,Default,,0,0,0,,.إنه رمز الباركود
Dialogue: 0,0:19:09.34,0:19:12.84,sign_1176_signpost,SIGN,0,0,0,,{\c&HCACACC&\3c&HAB5D21&\4c&H46463A&\fs9\an8\pos(345,234)}مخرج
Dialogue: 0,0:19:25.35,0:19:26.35,Default,,0,0,0,,.لا بد أنه هذا
Dialogue: 0,0:19:28.10,0:19:29.12,Default,,0,0,0,,!أوقف السيارة
Dialogue: 0,0:19:42.38,0:19:43.95,Default,,0,0,0,,!انطلقي
Dialogue: 0,0:19:54.75,0:19:56.01,Default,,0,0,0,,!آيومي
Dialogue: 0,0:19:56.01,0:19:57.13,Default,,0,0,0,,!آيومي
Dialogue: 0,0:19:57.13,0:19:58.34,Default,,0,0,0,,هل أنتِ بخير؟
Dialogue: 0,0:19:59.64,0:20:02.05,Default,,0,0,0,,.نعم، أنا بخير
Dialogue: 0,0:20:02.05,0:20:05.39,Default,,0,0,0,,.يبدو أن كرشي كان مفيدًا
Dialogue: 0,0:20:05.39,0:20:07.39,Default,,0,0,0,,!رائع
Dialogue: 0,0:20:10.15,0:20:13.90,sign_suspect,SIGN,0,0,0,,{\pos(320,290)\fad(500,1)}ميناء صيد إيشينوماكي
Dialogue: 0,0:20:14.60,0:20:16.90,Default,,0,0,0,,!رائع
Dialogue: 0,0:20:17.26,0:20:20.07,Default,,0,0,0,,.هذا هو المال
Dialogue: 0,0:20:21.86,0:20:23.10,Default,,0,0,0,,.كلّها هنا
Dialogue: 0,0:20:23.67,0:20:25.04,Default,,0,0,0,,أين الفتاة؟
Dialogue: 0,0:20:25.34,0:20:26.86,Default,,0,0,0,,.مع الشرطي
Dialogue: 0,0:20:26.86,0:20:28.91,Default,,0,0,0,,.لا داعي للقلق
Dialogue: 0,0:20:28.91,0:20:31.03,Default,,0,0,0,,ألا تظنوا أن ذلك تصرّف متهورًا بعض الشيء؟
Dialogue: 0,0:20:32.09,0:20:35.80,Default,,0,0,0,,.لقد كادوا يفقدون حياتهم
Dialogue: 0,0:20:38.28,0:20:40.54,Default,,0,0,0,,!لقد أحطنا المنطقة
Dialogue: 0,0:20:40.54,0:20:41.80,Default,,0,0,0,,!لا يمكنكم الهرب
Dialogue: 0,0:20:51.98,0:20:54.94,Default,,0,0,0,,كانيهارا؟ لكن لماذا؟
Dialogue: 0,0:20:57.07,0:21:00.84,Default,,0,0,0,,.أنا مُعجب كبير بكامين يايبا
Dialogue: 0,0:21:01.90,0:21:04.93,Default,,0,0,0,,!فعلت ذلك من أجل المعجبين حول العالم
Dialogue: 0,0:21:04.93,0:21:06.24,Default,,0,0,0,,!لا تكن سخيفًا
Dialogue: 0,0:21:06.24,0:21:08.71,Default,,0,0,0,,!لقد بعت السلع بأسعار خيالية
Dialogue: 0,0:21:08.71,0:21:11.21,Default,,0,0,0,,!هذا ليس من شيم المعجب الحقيقي
Dialogue: 0,0:21:12.85,0:21:14.04,Default,,0,0,0,,.كانيهارا
Dialogue: 0,0:21:17.72,0:21:21.72,Default,,0,0,0,,...صلّح أخطاءك وابدأ من جديد
Dialogue: 0,0:21:25.04,0:21:29.13,Default,,0,0,0,,.إن كنت حقًا من معجبيني
Dialogue: 0,0:21:43.25,0:21:45.04,DCEnding,,0,0,0,,!مرح! مرح! مرح
Dialogue: 0,0:21:47.43,0:21:53.64,DCEnding,,0,0,0,,قلبي ينبض بقوة قلبي ينبض بقوة أنا حقًا فضولي بشأن الحقيقة
Dialogue: 0,0:21:53.84,0:22:00.44,DCEnding,,0,0,0,,هل تحاول؟ من الصعب الكذب، أليس كذلك؟ يا! يا
Dialogue: 0,0:22:00.49,0:22:06.73,DCEnding,,0,0,0,,لاااا، أنا أفقد صوابي! هل من أحد يساعدني؟
Dialogue: 0,0:22:06.93,0:22:12.10,DCEnding,,0,0,0,,(كذبة أم حقيقة؟ لا أستطيع أن أقول (كل شيء أو لا شيء
Dialogue: 0,0:22:12.71,0:22:19.78,DCEnding,,0,0,0,,أنا في غاية الحب معك، أنا في غاية الحب معك
Dialogue: 0,0:22:19.93,0:22:26.47,DCEnding,,0,0,0,,يحب! هذا صحيح! سوف أتعرض لحروق شديدة
Dialogue: 0,0:22:26.63,0:22:33.80,DCEnding,,0,0,0,,تألق، ارقص معي، ارقص، ارقص، ارقص بابتسامة مبهرة
Dialogue: 0,0:22:34.97,0:22:41.14,DCEnding,,0,0,0,,أنسى الأشياء السيئة وأحبها، لا يمكن مساعدتها
Dialogue: 0,0:22:41.43,0:22:47.37,DCEnding,,0,0,0,,أنت وأنا وتلك الفتاة، إذا رقصنا، سنكون جميعًا سعداء
Dialogue: 0,0:22:47.81,0:22:53.98,DCEnding,,0,0,0,,تعال! تعال! أنت تتألق بشكل مشرق اليوم أيضًا
Dialogue: 0,0:22:54.63,0:22:59.62,DCEnding,,0,0,0,,!إنه أمر ممتع عندما يكون الجميع هناك، لذلك دعونا نذهب
Dialogue: 0,0:23:06.30,0:23:09.95,Default,,0,0,0,,.شكرًا لكم.يا أعضاء فرقة أطفال يايبا
Dialogue: 0,0:23:09.95,0:23:14.96,Default,,0,0,0,,...بمساعدتكم، هزمتُ الأشرار
Dialogue: 0,0:23:17.46,0:23:22.18,Default,,0,0,0,,.لنستمر في العمل معًا لحماية السلام على الأرض
Dialogue: 0,0:23:22.18,0:23:23.31,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:23:24.60,0:23:26.47,Default,,0,0,0,,!حسنًا، توقفوا
Dialogue: 0,0:23:27.03,0:23:31.38,Default,,0,0,0,,.مرة أخرى من هذا الموقع المثير، كانت معكم هاتشيا من تلفزيون مياجي
Dialogue: 0,0:23:31.38,0:23:33.81,Default,,0,0,0,,!كامين يايبا رائع
Dialogue: 0,0:23:33.81,0:23:36.09,Default,,0,0,0,,!وكذلك المحققين الصغار
Dialogue: 0,0:23:36.09,0:23:38.11,Default,,0,0,0,,!نعم
Dialogue: 0,0:23:40.57,0:23:43.16,Default,,0,0,0,,!إيشينوماكي رائعة
Dialogue: 0,0:23:44.99,0:24:09.01,sign_episode_preview,SIGN,0,0,0,,في الحلقة القادمة 
Dialogue: 0,0:23:48.81,0:23:50.93,Default,,0,0,0,,!المحققين الصغار
Dialogue: 0,0:23:51.51,0:23:52.97,Default,,0,0,0,,!هذا نحن
Dialogue: 0,0:23:55.50,0:23:59.75,Default,,0,0,0,,.نعم، راقبنا المنطقة بعناية البارحة أيضًا
Dialogue: 0,0:24:00.25,0:24:01.50,Default,,0,0,0,,!توقف
Dialogue: 0,0:24:02.75,0:24:06.76,Default,,0,0,0,,...إلا إذا وُجد إيصال في أسفل حقيبة البارحة
Dialogue: 0,0:24:06.76,0:24:09.01,Default,,0,0,0,,!فهمت. هكذا إذن
Dialogue: 0,0:24:09.01,0:24:15.02,sign_next_episode,SIGN,0,0,0,,{\pos(320,55)} ابحث عن العملاق الأسطوري 
Dialogue: 0,0:24:09.60,0:24:13.90,Default,,0,0,0,,"!الحلقة القادمة من كونان هي "‏ابحث عن العملاق الأسطوري
Dialogue: 0,0:24:30.03,0:24:32.73,Default,,0,0,0,,!تلميح كونان القادم
Dialogue: 0,0:24:30.03,0:24:34.95,sign_hint,SIGN,0,0,0,,{\pos(320,231)}أحذية
Dialogue: 0,0:24:32.73,0:24:34.17,Default,,0,0,0,,!أحذية
Dialogue: 0,0:24:34.95,0:24:36.60,Default,,0,0,0,,{\an8}.لنعد إلى مياجي يومًا ما
Dialogue: 0,0:24:34.95,0:24:39.96,sign_dont_miss,SIGN,0,0,0,,{\pos(245,304)}لا تفوتوا الحلقة القادمة
Dialogue: 0,0:24:36.60,0:24:38.38,Default,,0,0,0,,{\an8}.نأمل ألا تكون هناك قضية في المرة القادمة
Dialogue: 0,0:24:38.38,0:24:39.92,Default,,0,0,0,,{\an8}...نعم
