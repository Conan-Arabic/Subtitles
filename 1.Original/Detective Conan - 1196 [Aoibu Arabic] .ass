Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,90)} ‫ABOODY SUBS | ترجمة \N‫Theconansign : محاكاة\N‫X : @ABOODY_SUBS \N‫X : @Theconansign
Dialogue: 0,0:00:01.06,0:00:04.48,Default,,0,0,0,,قُتِل شخص في متحف تسوروفوجي كيو للفنون في مدينة أوكوهو
Dialogue: 0,0:00:04.48,0:00:07.65,Default,,0,0,0,,‫المعروف أيضًا باسم القصر الحلزوني.
Dialogue: 0,0:00:08.42,0:00:12.66,Default,,0,0,0,,‫الضحية هو مدير المتحف، السيد تسوروفوجي سينسوكي.{\an8}
Dialogue: 0,0:00:10.66,0:00:12.66,sign_suspect,SIGN,0000,0000,0000,,{\pos(320,255)}(41) تسوروفوجي سينسوكي
Dialogue: 0,0:00:10.66,0:00:12.66,sign_suspect,SIGN,0000,0000,0000,,{\fs14\pos(320,272)}ابن تسوروفوجي كيو
Dialogue: 0,0:00:13.03,0:00:14.54,Default,,0,0,0,,‫قُتل ببندقية صيد.
Dialogue: 0,0:00:14.94,0:00:19.53,Default,,0,0,0,,بعد سماعنا صوت إطلاق النار، هرعنا إلى الطابق الثالث
Dialogue: 0,0:00:19.53,0:00:22.74,Default,,0,0,0,,‫لكن الجاني لم يكن في الطوابق العليا ولا السفلى.
Dialogue: 0,0:00:23.71,0:00:26.69,Default,,0,0,0,,وبينما كنا نحاول معرفة أين ذهب
Dialogue: 0,0:00:26.69,0:00:29.49,Default,,0,0,0,,لاحظت البناء غير الطبيعي للمبنى
Dialogue: 0,0:00:27.88,0:00:28.71,sign_1196_studio,SIGN,0000,0000,0000,,{\an8\fad(200,1)\pos(421,83)\c&HFDF9F4&\4c&HFDF9F4&\3c&HB8B2BF&}استديو
Dialogue: 1,0:00:27.88,0:00:28.71,sign_1196_studio,SIGN,0000,0000,0000,,{\an8\bord0\shad0\blur0.4\b0\fsp0.8\c&HE8E2C4&\fad(200,1)\pos(421,83)}استديو
Dialogue: 0,0:00:29.49,0:00:32.34,Default,,0,0,0,,‫واكتشفت آلية تعمل من خلال دمج الأعمال الفنية.
Dialogue: 0,0:00:33.35,0:00:39.03,Default,,0,0,0,,‫قمنا بتشغيلها وعثرنا على غرفة سرية بين الطابقين الثالث والرابع.
Dialogue: 0,0:00:39.69,0:00:41.99,Default,,0,0,0,,هل استخدم الجاني هذا؟
Dialogue: 0,0:00:42.40,0:00:43.86,Default,,0,0,0,,‫ولكن بعد ذلك...
Dialogue: 0,0:00:44.23,0:00:48.54,Default,,0,0,0,,‫بالمناسبة يا آنسة مايماي، لا أرى السيد أوماغاري هنا.
Dialogue: 0,0:00:48.54,0:00:52.53,Default,,0,0,0,,‫لقد خرج في نزهة حوالي الساعة الواحدة.
Dialogue: 0,0:00:52.99,0:00:56.58,Default,,0,0,0,,‫إنه يتأخر حقًا. لقد صارت الثالثة بالفعل.
Dialogue: 0,0:00:56.58,0:00:59.04,Default,,0,0,0,,هل يأخذ دائمًا نزهات طويلة كهذه؟
Dialogue: 0,0:00:59.04,0:01:03.54,Default,,0,0,0,,‫لا. عادةً، يمشى لمدة ساعة على الأكثر.
Dialogue: 0,0:01:04.86,0:01:07.89,Default,,0,0,0,,‫يا تاكاغي، اذهب لإحضار السيد أوماغاري.
Dialogue: 0,0:01:07.89,0:01:08.63,Default,,0,0,0,,‫حاضر.
Dialogue: 0,0:01:22.56,0:01:26.07,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\pos(385,255)}(39) أوماغاري ساتوشي
Dialogue: 0,0:01:22.56,0:01:26.07,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\fs14\pos(385,272)}زوج مايماي
Dialogue: 0,0:01:31.49,0:01:33.28,Default,,0,0,0,,في مواجهة لغز غير متوقع
Dialogue: 0,0:01:33.28,0:01:35.23,Default,,0,0,0,,‫الحل الوحيد هو مهارات الاستنتاج الفائقة!
Dialogue: 0,0:01:35.23,0:01:37.24,Default,,0,0,0,,‫تصميم غريب به فخاخ خفية!
Dialogue: 0,0:01:37.24,0:01:38.91,Default,,0,0,0,,‫ألغاز مخبأة داخل القصر الحلزوني!
Dialogue: 0,0:01:38.91,0:01:40.62,Default,,0,0,0,,يسعى وراء الحقيقة دائماً
Dialogue: 0,0:01:40.62,0:01:42.41,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:01:42.41,0:01:44.75,Default,,0,0,0,,‫اسمه المحقق كونان!
Dialogue: 0,0:01:46.51,0:01:50.27,DC-OP,,0,0,0,,‫ليس بوسعي تغييره بنفسي
Dialogue: 0,0:01:50.45,0:01:53.50,DC-OP,,0,0,0,,‫ما كان منك وما أصابك، فقد مضى وانتهى
Dialogue: 0,0:01:53.98,0:01:57.75,DC-OP,,0,0,0,,‫لا يُعرف من أين جاء ولا ما هو
Dialogue: 0,0:01:57.84,0:02:01.47,DC-OP,,0,0,0,,‫كأن يهاجمك أحد الوحوش
Dialogue: 0,0:02:01.76,0:02:05.54,DC-OP,,0,0,0,,‫أركض كي لا يلحقوا بي
Dialogue: 0,0:02:05.54,0:02:08.80,DC-OP,,0,0,0,,‫ربما يحدث خيراً، من يعلم؟
Dialogue: 0,0:02:09.20,0:02:13.10,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:02:13.10,0:02:17.11,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:02:17.11,0:02:20.82,DC-OP,,0,0,0,,‫أجعل عمق الليل يلمع باللون الوردي
Dialogue: 0,0:02:20.82,0:02:24.54,DC-OP,,0,0,0,,‫مهما طال الزمن، كل ما علي فعله هو المحاولة
Dialogue: 0,0:02:32.24,0:02:36.04,DC-OP,,0,0,0,,‫أبحث عن سعادة جديدة
Dialogue: 0,0:02:36.04,0:02:39.33,DC-OP,,0,0,0,,‫أين يكمن؟، لا احد يعلم
Dialogue: 0,0:02:39.66,0:02:43.76,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:02:43.76,0:02:47.17,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:02:47.36,0:02:50.77,DC-OP,,0,0,0,,‫أضيء على الذكريات المظلمة
Dialogue: 0,0:02:51.05,0:02:54.75,DC-OP,,0,0,0,,‫احدق فيها حتى يزول خوفها
Dialogue: 0,0:02:55.01,0:02:58.73,DC-OP,,0,0,0,,‫في لحظة تلتفت فيها إلى الماضي
Dialogue: 0,0:02:58.83,0:03:02.47,DC-OP,,0,0,0,,‫لم يكن سوى أن أطلقت أعظم دموعك
Dialogue: 0,0:03:27.10,0:03:32.98,sign_episode_title,SIGN,0000,0000,0000,,{\fad(230,1)}لغز القصر: قصر المتاهة\Nالجزء الثاني 
Dialogue: 0,0:03:27.48,0:03:30.99,Default,,0,0,0,,‫"لغز القصر : قصر المتاهة، الجزء الثاني!"
Dialogue: 0,0:03:33.96,0:03:36.74,Default,,0,0,0,,‫عزيزي... عزيزي!
Dialogue: 0,0:03:36.74,0:03:40.24,sign_suspect,SIGN,0000,0000,0000,,{\pos(288,256)}(38)تسوروفوجي مايماي
Dialogue: 0,0:03:36.74,0:03:40.24,sign_suspect,SIGN,0000,0000,0000,,{\fs14\pos(288,273)}ابنة تسوروفوجي كيو
Dialogue: 0,0:03:43.24,0:03:47.00,Default,,0,0,0,,‫الكلمات في ذلك الكتاب داخل الغرفة السرية...
Dialogue: 0,0:03:47.00,0:03:51.10,Default,,0,0,0,,‫"الرجل غضب وقتل خطيبته.
Dialogue: 0,0:03:51.75,0:03:55.36,Default,,0,0,0,,‫ثم اختفى.
Dialogue: 0,0:03:55.36,0:03:59.47,Default,,0,0,0,,ابتلعته عوالم الأفكار
Dialogue: 0,0:03:59.47,0:04:04.01,Default,,0,0,0,,‫التي كانت موجودة فقط في الحلزونات التي رسمها."
Dialogue: 0,0:04:06.12,0:04:12.66,Default,,0,0,0,,هل يعني ذلك أن الجاني اختفى أيضًا في حلزون؟
Dialogue: 0,0:04:12.66,0:04:20.05,Default,,0,0,0,,‫مستحيل. لم تكن هناك أي حلزونات في غرفة سينسوكي أثناء الجريمة الأولى.
Dialogue: 0,0:04:20.53,0:04:24.29,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\pos(295,256)}(41) تسوروفوجي يوكو
Dialogue: 0,0:04:20.53,0:04:24.29,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\fs14\pos(295,273)}زوجة سينسوكي
Dialogue: 0,0:04:20.61,0:04:24.29,Default,,0,0,0,,‫زوجي كان يكره الحلزونات أكثر من أي شيء آخر.{\an8}
Dialogue: 0,0:04:24.29,0:04:27.29,Default,,0,0,0,,‫لا، كان هناك حلزون في تلك الغرفة.
Dialogue: 0,0:04:27.75,0:04:29.04,Default,,0,0,0,,أين؟
Dialogue: 0,0:04:29.50,0:04:32.88,Default,,0,0,0,,‫سبطانة البندقية كانت محلزنة.
Dialogue: 0,0:04:47.70,0:04:50.10,Default,,0,0,0,,‫فهمت. عمل جيد.
Dialogue: 0,0:04:51.75,0:04:54.58,Default,,0,0,0,,جميعًا... أظهر تشريح الجثة أن سبب الوفاة
Dialogue: 0,0:04:54.58,0:04:58.69,Default,,0,0,0,,‫كان لارتجاج دماغي ناتج عن ضربة على مؤخرة الرأس.
Dialogue: 0,0:04:59.33,0:05:02.45,Default,,0,0,0,,‫الوقت المقدر للوفاة هو 1:15 ظهرًا.
Dialogue: 0,0:05:02.96,0:05:05.70,Default,,0,0,0,,‫كنت أحقق داخل المتحف في ذلك الوقت.
Dialogue: 0,0:05:05.70,0:05:12.62,Default,,0,0,0,,بخلاف الضحية، الأشخاص الذين خرجوا إلى الخارج حوالي ذلك الوقت
Dialogue: 0,0:05:13.09,0:05:14.62,Default,,0,0,0,,‫كانوا الآنسة نيجي كاورو...{\an8}
Dialogue: 0,0:05:14.08,0:05:17.59,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\pos(350,255)}(25) نيجي كاورو
Dialogue: 0,0:05:14.08,0:05:17.59,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\fs14\pos(350,272)}المشرفة على القصر الحلزوني
Dialogue: 0,0:05:14.62,0:05:15.58,Default,,0,0,0,,‫نعم.{\an8}
Dialogue: 0,0:05:17.59,0:05:19.55,Default,,0,0,0,,‫...والسيد هاياسي كازومي.{\an8}
Dialogue: 0,0:05:17.59,0:05:21.09,sign_suspect,SIGN,0000,0000,0000,,{\pos(225,255)}(25) هاياسي كازومي
Dialogue: 0,0:05:17.59,0:05:21.09,sign_suspect,SIGN,0000,0000,0000,,{\fs14\pos(225,272)}محرر مجلة
Dialogue: 0,0:05:21.50,0:05:24.90,Default,,0,0,0,,ماذا كنتما تفعلان بالخارج؟
Dialogue: 0,0:05:24.90,0:05:25.88,Default,,0,0,0,,‫أنا...
Dialogue: 0,0:05:25.88,0:05:27.66,Default,,0,0,0,,‫لقد كانت معي.
Dialogue: 0,0:05:27.66,0:05:31.34,Default,,0,0,0,,لقد رأيتنا نتحدث، أتذكر؟
Dialogue: 0,0:05:32.66,0:05:33.60,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:05:34.25,0:05:37.17,Default,,0,0,0,,‫كما ترى، هناك من يشهد لنا.
Dialogue: 0,0:05:37.17,0:05:40.49,Default,,0,0,0,,‫حسنًا. في هذه الحالة، آنسة مايماي...
Dialogue: 0,0:05:43.24,0:05:49.24,Default,,0,0,0,,تعازياتي لكِ، لكن أين كنتِ حوالي الساعة 1:15 ظهرًا؟
Dialogue: 0,0:05:50.13,0:05:52.25,Default,,0,0,0,,‫في الاستوديو بالطابق الرابع.
Dialogue: 0,0:05:52.82,0:05:56.75,Default,,0,0,0,,فهمت. وأنتِ، آنسة يوكو؟
Dialogue: 0,0:05:56.75,0:05:59.04,Default,,0,0,0,,‫كنتُ هنا.
Dialogue: 0,0:05:59.04,0:06:00.53,Default,,0,0,0,,طوال الوقت؟
Dialogue: 0,0:06:00.53,0:06:01.47,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:06:02.96,0:06:05.77,Default,,0,0,0,,‫لابد أنكِ ذهبتِ إلى الحمام فقط.
Dialogue: 0,0:06:05.77,0:06:10.02,Default,,0,0,0,,لقد ذهبت. ماذا تلمحين؟
Dialogue: 0,0:06:10.02,0:06:14.53,Default,,0,0,0,,‫قد يكون من الممكن الخروج إلى الخارج من نافذة الحمام.
Dialogue: 0,0:06:14.53,0:06:16.77,Default,,0,0,0,,‫مـ-ماذا تقولين؟!
Dialogue: 0,0:06:16.77,0:06:20.40,Default,,0,0,0,,أنا فقط أذكر الحقيقة. أليس كذلك، آنسة نيجي؟
Dialogue: 0,0:06:20.40,0:06:22.19,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:06:24.50,0:06:26.49,Default,,0,0,0,,‫هل أنتما جادّتان؟!
Dialogue: 0,0:06:40.95,0:06:45.80,Default,,0,0,0,,‫هذا هو المكان تقريبًا الذي كان السيد أوماغاري يرسم فيه.
Dialogue: 0,0:06:46.94,0:06:51.52,Default,,0,0,0,,‫ربما رأى شيئًا من هنا.
Dialogue: 0,0:06:53.68,0:06:57.02,Default,,0,0,0,,‫لا شيء في هذا المبنى منطقي.
Dialogue: 0,0:06:57.02,0:07:00.52,Default,,0,0,0,,‫لقد بناه تسوروفوجي كيو.
Dialogue: 0,0:06:57.02,0:07:00.52,sign_1196_studio,SIGN,0000,0000,0000,,{\an2\pos(320,115)}ماي ماي 
Dialogue: 1,0:06:57.02,0:07:00.52,sign_1196_studio,SIGN,0000,0000,0000,,{\an2\bord0\shad0\blur0.4\c&HC093ED&\b0\fsp0.8\pos(320,115)}ماي ماي 
Dialogue: 0,0:06:57.02,0:07:00.52,sign_1196_studio,SIGN,0000,0000,0000,,{\an8\pos(320,215)}استديو
Dialogue: 1,0:06:57.02,0:07:00.52,sign_1196_studio,SIGN,0000,0000,0000,,{\an8\bord0\shad0\blur0.4\b0\fsp0.8\c&HD6C489&\pos(320,215)} استديو 
Dialogue: 0,0:07:01.65,0:07:04.12,Default,,0,0,0,,‫سيكون الأمر أغرب لو لم يكن غريبًا.
Dialogue: 0,0:07:04.12,0:07:06.90,Default,,0,0,0,,‫على أي حال، لا يمكنني البقاء هنا.
Dialogue: 0,0:07:06.90,0:07:10.48,Default,,0,0,0,,‫سأرحل بمجرد حل هذه القضية.
Dialogue: 0,0:07:10.48,0:07:13.04,Default,,0,0,0,,‫اذهبي فورًا. لن أمنعكِ.
Dialogue: 0,0:07:13.39,0:07:17.71,Default,,0,0,0,,‫في هذه الحالة، دعينا نناقش كيف سنقسم الأصول.
Dialogue: 0,0:07:17.72,0:07:20.05,Default,,0,0,0,,‫لقد تزوجت من العائلة، لذا لن أطلب النصف.
Dialogue: 0,0:07:20.05,0:07:24.04,Default,,0,0,0,,‫الثلث، لا، حتى الربع سيكفيني.
Dialogue: 0,0:07:24.58,0:07:25.80,Default,,0,0,0,,‫غير ممكن.
Dialogue: 0,0:07:25.80,0:07:27.22,Default,,0,0,0,,ولم لا؟
Dialogue: 0,0:07:27.22,0:07:29.85,Default,,0,0,0,,‫لأنه لا توجد أصول لتقسيمها!
Dialogue: 0,0:07:29.85,0:07:31.51,Default,,0,0,0,,‫لكن هناك.
Dialogue: 0,0:07:31.51,0:07:34.19,Default,,0,0,0,,على الرغم من أنني لا أهتم بها شخصيًا
Dialogue: 0,0:07:34.19,0:07:36.48,Default,,0,0,0,,‫فهي كنوز يمكن أن تباع بثروة.
Dialogue: 0,0:07:37.12,0:07:42.80,Default,,0,0,0,,‫إذا كنتِ تقصدين أعمال والدي الفنية، فهي ملك للمتحف.
Dialogue: 0,0:07:42.80,0:07:46.24,Default,,0,0,0,,‫إنها لا تعود لأي منا.
Dialogue: 0,0:07:46.24,0:07:49.32,Default,,0,0,0,,مـ-من قرر ذلك؟
Dialogue: 0,0:07:49.32,0:07:56.33,Default,,0,0,0,,‫أخي، عندما قررنا ماذا نفعل بميراث والدنا.
Dialogue: 0,0:07:57.57,0:08:00.92,Default,,0,0,0,,‫لن أقبل بهذا، ولن أرحل بلا مقابل.
Dialogue: 0,0:08:00.92,0:08:04.73,Default,,0,0,0,,‫سآخذ بعض الأعمال الفنية من قاعات العرض.
Dialogue: 0,0:08:04.73,0:08:07.59,Default,,0,0,0,,‫إن تجرأتِ وفعلتِها، فسأفضحكِ بالصراخ: "لص!"
Dialogue: 0,0:08:08.02,0:08:12.14,Default,,0,0,0,,‫مع وجود كل رجال الشرطة حولكِ، سيتم القبض عليكِ متلبسة.
Dialogue: 0,0:08:19.95,0:08:21.48,Default,,0,0,0,,هل كنتَ تتجسس؟
Dialogue: 0,0:08:21.48,0:08:24.48,Default,,0,0,0,,‫لقد وصلت للتو.
Dialogue: 0,0:08:29.55,0:08:31.87,Default,,0,0,0,,هل تريد شيئًا، أيها الصبي؟
Dialogue: 0,0:08:31.87,0:08:37.00,Default,,0,0,0,,هل يمكنني رؤية الرسم الذي أعاده السيد أوماغاري معه؟
Dialogue: 0,0:08:38.14,0:08:39.30,Default,,0,0,0,,‫بالتأكيد.
Dialogue: 0,0:08:42.75,0:08:45.66,Default,,0,0,0,,‫هذه الزاوية تبدو جديدة.
Dialogue: 0,0:08:45.66,0:08:48.26,Default,,0,0,0,,‫عادةً، يرسم بجانب البحيرة.
Dialogue: 0,0:08:49.72,0:08:51.91,Default,,0,0,0,,إنه ليس ماهرًا جدًا، أليس كذلك؟
Dialogue: 0,0:08:51.91,0:08:56.76,Default,,0,0,0,,‫ولكن مؤخرًا، ظهر معرض فني يشتري أعمال أوماغاري من العدم.
Dialogue: 0,0:08:56.76,0:09:02.16,Default,,0,0,0,,‫لقد تفاجأت جدًا. لا بد أن هناك خطأ في أعينهم.
Dialogue: 0,0:09:02.16,0:09:03.44,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:03.44,0:09:05.82,Default,,0,0,0,,‫هذه اللوحة مزدوجة الطبقات.
Dialogue: 0,0:09:07.96,0:09:14.46,Default,,0,0,0,,لقد سمعت عن وضع طبقات من القماش لترميم اللوحات
Dialogue: 0,0:09:14.46,0:09:16.49,Default,,0,0,0,,لكن هذا العمل جديد، أليس كذلك؟
Dialogue: 0,0:09:17.04,0:09:18.75,Default,,0,0,0,,ما الذي يحدث بالضبط؟
Dialogue: 0,0:09:46.03,0:09:47.15,Default,,0,0,0,,هذا؟
Dialogue: 0,0:09:50.29,0:09:51.65,Default,,0,0,0,,‫لا أصدق ذلك...
Dialogue: 0,0:09:52.84,0:09:55.99,Default,,0,0,0,,‫لم يكن يبيع أعماله الخاصة!
Dialogue: 0,0:09:56.37,0:09:58.41,Default,,0,0,0,,‫لقد كان يبيع أعمال والدي الفنية!
Dialogue: 0,0:09:59.24,0:10:00.41,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:10:02.00,0:10:03.92,Default,,0,0,0,,‫مهلا أيها الصبي.
Dialogue: 0,0:10:03.92,0:10:05.43,Default,,0,0,0,,مـ-ماذا؟
Dialogue: 0,0:10:05.43,0:10:08.95,Default,,0,0,0,,‫لا تخبر أحدًا آخر بهذا!
Dialogue: 0,0:10:08.95,0:10:12.09,Default,,0,0,0,,خاصة تلك المرأة!، فهمت؟
Dialogue: 0,0:10:15.62,0:10:21.61,Default,,0,0,0,,‫السيد أوماغاري كان يغطي أعمال تسوروفوجي كيو بأعماله ويبيعها.
Dialogue: 0,0:10:23.62,0:10:26.86,Default,,0,0,0,,‫على أي حال، هذه النوافذ نظيفة بالتأكيد.
Dialogue: 0,0:10:27.35,0:10:29.61,Default,,0,0,0,,‫أتساءل كيف ينظفونها.
Dialogue: 0,0:10:31.74,0:10:36.90,Default,,0,0,0,,‫النوافذ تُنظف بالنزول بالحبال من السطح.
Dialogue: 0,0:10:36.90,0:10:39.12,Default,,0,0,0,,هل تستأجرون شركة للقيام بذلك؟
Dialogue: 0,0:10:39.12,0:10:43.35,Default,,0,0,0,,‫لا. لا يمكننا تحمل تلك التكلفة، لذا نقوم بذلك بأنفسنا.
Dialogue: 0,0:10:43.35,0:10:45.87,Default,,0,0,0,,أليس هذا خطيرًا؟
Dialogue: 0,0:10:46.38,0:10:47.84,Default,,0,0,0,,‫لا بأس.
Dialogue: 0,0:10:47.84,0:10:52.04,Default,,0,0,0,,على أي حال، هل يمكنني أن أسألكَ شيئًا أيضًا؟
Dialogue: 0,0:10:52.04,0:10:52.92,Default,,0,0,0,,‫بالتأكيد.
Dialogue: 0,0:10:53.37,0:10:58.77,Default,,0,0,0,,أفكر في الكشف عن آلية الغرفة السرية التي وجدتها
Dialogue: 0,0:10:58.77,0:11:01.55,Default,,0,0,0,,‫والأعمال غير المعروفة في تلك الغرفة للجمهور.
Dialogue: 0,0:11:01.55,0:11:06.67,Default,,0,0,0,,إذا كتب هاياسي مقالاً عن ذلك، ألن يتضاعف عدد زوارنا؟
Dialogue: 0,0:11:09.21,0:11:10.37,Default,,0,0,0,,هل تعتقد أنني لا يجب أن أفعل؟
Dialogue: 0,0:11:10.37,0:11:12.36,Default,,0,0,0,,‫ليس تمامًا، لكن...
Dialogue: 0,0:11:13.19,0:11:14.30,Default,,0,0,0,,‫انتبهي!
Dialogue: 0,0:11:20.45,0:11:22.16,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:11:48.90,0:11:50.64,Default,,0,0,0,,‫حلزون آخر.
Dialogue: 0,0:12:05.53,0:12:08.33,Default,,0,0,0,,‫لابد أنه فرا بحبل تنظيف النوافذ.
Dialogue: 0,0:12:13.83,0:12:14.83,Default,,0,0,0,,‫لحظة.
Dialogue: 0,0:12:17.07,0:12:25.70,Default,,0,0,0,,‫واحد، اثنان، ثلاثة، أربعة، خمسة، ستة، سبعة...
Dialogue: 0,0:12:27.74,0:12:32.11,Default,,0,0,0,,‫18 ونصف. هذا تقريبًا 18 مترًا.
Dialogue: 0,0:12:32.11,0:12:35.60,sign_1196_studio,SIGN,0000,0000,0000,,{\an2\fad(1,500)\an2\pos(335,100)}ماي ماي 
Dialogue: 1,0:12:32.11,0:12:35.60,sign_1196_studio,SIGN,0000,0000,0000,,{\an2\bord0\shad0\an2\blur0.4\c&HC093ED&\b0\fsp0.8\fad(1,500)\pos(335,100)}ماي ماي 
Dialogue: 0,0:12:32.11,0:12:35.60,sign_1196_studio,SIGN,0000,0000,0000,,{\an8\fad(1,500)\pos(335,220)}استديو
Dialogue: 1,0:12:32.11,0:12:35.60,sign_1196_studio,SIGN,0000,0000,0000,,{\an8\bord0\shad0\blur0.4\b0\fsp0.8\c&HD6C489&\fad(1,500)\pos(335,220)}استديو
Dialogue: 0,0:12:37.35,0:12:38.86,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:12:39.18,0:12:41.99,Default,,0,0,0,,هل يمكنني استعارة بعض الطين؟
Dialogue: 0,0:12:42.38,0:12:43.65,Default,,0,0,0,,طين؟
Dialogue: 0,0:12:43.65,0:12:44.93,Default,,0,0,0,,‫رجاءً.
Dialogue: 0,0:12:46.98,0:12:47.97,Default,,0,0,0,,‫تفضل.
Dialogue: 0,0:12:49.19,0:12:50.59,Default,,0,0,0,,‫شكرًا لكِ.
Dialogue: 0,0:13:01.33,0:13:04.80,Default,,0,0,0,,‫واحد، اثنان، ثلاثة...
Dialogue: 0,0:13:01.33,0:13:04.80,sign_1196_visitor_path,SIGN,0000,0000,0000,,{\an2\fnGeorgia\frz-1\pos(416,116)}طريق الزائر
Dialogue: 0,0:13:04.80,0:13:07.81,Default,,0,0,0,,‫أربعة وأكثر قليلاً.
Dialogue: 0,0:13:08.13,0:13:11.75,Default,,0,0,0,,‫مـ-ماذا؟ ماذا؟ ماذا؟!
Dialogue: 0,0:13:11.75,0:13:13.73,Default,,0,0,0,,ما الأمر يا كونان؟
Dialogue: 0,0:13:13.73,0:13:19.84,Default,,0,0,0,,هل يمكنكِ وضع برج بابل داخل الهاوية في دقيقة واحدة بالضبط؟
Dialogue: 0,0:13:20.59,0:13:22.66,Default,,0,0,0,,أتقصد، تفعيل آلية الغرفة السرية؟
Dialogue: 0,0:13:22.66,0:13:26.01,Default,,0,0,0,,‫نعم. سأكون في الطابق الثاني.
Dialogue: 0,0:13:45.07,0:13:46.64,Default,,0,0,0,,مـ-ماذا يحدث؟
Dialogue: 0,0:13:53.18,0:13:54.23,Default,,0,0,0,,ماذا تفعلين؟
Dialogue: 0,0:13:54.23,0:13:58.98,Default,,0,0,0,,‫كونان طلب مني تفعيل آلية الغرفة السرية.
Dialogue: 0,0:13:58.98,0:14:01.11,Default,,0,0,0,,إذن، أين هو؟
Dialogue: 0,0:14:01.11,0:14:03.11,Default,,0,0,0,,‫في الطابق الثاني.
Dialogue: 0,0:14:03.11,0:14:08.11,sign_1196_visitor_path,SIGN,0000,0000,0000,,{\an2\fnGeorgia\pos(410,100)}طريق الزائر
Dialogue: 0,0:14:04.83,0:14:07.14,Default,,0,0,0,,أيها الصبي. أين أنت؟
Dialogue: 0,0:14:08.74,0:14:09.91,Default,,0,0,0,,‫إنه ليس هنا.
Dialogue: 0,0:14:09.91,0:14:11.21,Default,,0,0,0,,‫هذا غريب.
Dialogue: 0,0:14:11.21,0:14:13.38,Default,,0,0,0,,‫النجدة!
Dialogue: 0,0:14:13.73,0:14:15.07,Default,,0,0,0,,ما خطبك أيها الصبي؟
Dialogue: 0,0:14:17.99,0:14:19.89,Default,,0,0,0,,تباً. أين هو؟
Dialogue: 0,0:14:20.41,0:14:22.09,Default,,0,0,0,,ما كل هذه الصراخ؟
Dialogue: 0,0:14:22.09,0:14:25.51,Default,,0,0,0,,آنسة مايماي ، هل رأيتِ الصبي ذو النظارات؟
Dialogue: 0,0:14:25.89,0:14:31.10,Default,,0,0,0,,لا. لقد ركضت خارج الاستوديو لأنه بدأ ينزل
Dialogue: 0,0:14:31.10,0:14:32.85,Default,,0,0,0,,‫ثم سمعت صراخًا.
Dialogue: 0,0:14:32.85,0:14:34.62,Default,,0,0,0,,ماذا حدث بالضبط؟
Dialogue: 0,0:14:34.62,0:14:36.81,Default,,0,0,0,,ماذا تفعلون جميعاً؟
Dialogue: 0,0:14:40.30,0:14:43.11,Default,,0,0,0,,كونان، أين كنت؟
Dialogue: 0,0:14:43.11,0:14:44.74,Default,,0,0,0,,‫في الغرفة السرية.
Dialogue: 0,0:14:44.74,0:14:48.31,Default,,0,0,0,,ماذا؟، أليست الغرفة السرية هنا؟
Dialogue: 0,0:14:48.79,0:14:50.39,Default,,0,0,0,,‫أنت، انتظر!
Dialogue: 0,0:14:54.29,0:14:55.75,Default,,0,0,0,,‫مهلا، أيها الصبي!
Dialogue: 0,0:14:56.70,0:14:57.92,Default,,0,0,0,,أين ذهب؟
Dialogue: 0,0:15:04.46,0:15:07.64,Default,,0,0,0,,موري؟ أين كونان؟
Dialogue: 0,0:15:09.85,0:15:11.89,Default,,0,0,0,,‫"كوغورو النائم"؟
Dialogue: 0,0:15:13.03,0:15:19.27,Default,,0,0,0,,‫لقد استخدمت كونان في الواقع لإعادة تمثيل حيلة الغرفة السرية التي استخدمها الجاني.
Dialogue: 0,0:15:19.89,0:15:21.15,Default,,0,0,0,,حيلة؟
Dialogue: 0,0:15:21.81,0:15:23.28,Default,,0,0,0,,غرفة سرية؟
Dialogue: 0,0:15:23.61,0:15:28.34,Default,,0,0,0,,‫نعم، لكنني لا أعني تلك الغرفة السرية.
Dialogue: 0,0:15:28.68,0:15:32.29,Default,,0,0,0,,‫هناك غرفة سرية أخرى في هذا المبنى.
Dialogue: 0,0:15:32.62,0:15:34.66,Default,,0,0,0,,أين؟
Dialogue: 0,0:15:34.66,0:15:40.44,Default,,0,0,0,,‫الإجابة يمكن العثور عليها في ارتفاع المبنى بأكمله.
Dialogue: 0,0:15:40.44,0:15:44.58,Default,,0,0,0,,‫ارتفاع القصر الحلزوني بالكامل حوالي 18 مترًا.
Dialogue: 0,0:15:44.58,0:15:50.12,Default,,0,0,0,,‫في الوقت نفسه، أسقف الممرات يبلغ ارتفاعها حوالي أربعة أمتار.
Dialogue: 0,0:15:50.60,0:15:53.29,Default,,0,0,0,,القصر الحلزوني مكون من أربعة طوابق
Dialogue: 0,0:15:53.29,0:15:57.61,Default,,0,0,0,,لذا يجب أن يكون أربعة في أربعة، أي 16 مترًا
Dialogue: 0,0:15:58.07,0:16:00.18,Default,,0,0,0,,‫لكن هناك فرق حوالي مترين.
Dialogue: 0,0:16:00.81,0:16:02.62,Default,,0,0,0,,هل تعرفون لماذا؟
Dialogue: 0,0:16:04.08,0:16:07.07,Default,,0,0,0,,أليس ذلك مجرد طلاء الأرضيات؟
Dialogue: 0,0:16:07.47,0:16:08.94,Default,,0,0,0,,‫بالضبط.
Dialogue: 0,0:16:09.35,0:16:17.37,Default,,0,0,0,,‫لأن جميع نوافذ المبنى مثبتة، يتم تدوير الهواء عبر الأرضيات.
Dialogue: 0,0:16:17.37,0:16:20.75,Default,,0,0,0,,لقد تأكدت باستخدام آلية الغرفة السرية
Dialogue: 0,0:16:21.18,0:16:26.21,Default,,0,0,0,,‫من وجود قناة تهوية بسمك حوالي 50 سنتيمترًا أسفل الأرضيات.
Dialogue: 0,0:16:26.21,0:16:32.72,Default,,0,0,0,,‫بالإضافة إلى ذلك، كان هناك باب وصول إلى القناة في أرضية ممر الطابق الثالث.
Dialogue: 0,0:16:34.10,0:16:35.46,Default,,0,0,0,,‫لا بد أن هذا هو.
Dialogue: 0,0:16:35.91,0:16:37.85,Default,,0,0,0,,‫النجدة!
Dialogue: 0,0:16:38.59,0:16:43.07,Default,,0,0,0,,‫أرضية الطابق الثالث هي أيضًا سقف الطابق الثاني.
Dialogue: 0,0:16:43.07,0:16:48.36,Default,,0,0,0,,‫بمعنى آخر، الجاني عبر هناك للوصول إلى الطابق الثاني.
Dialogue: 0,0:16:48.86,0:16:50.43,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:16:50.43,0:16:52.23,Default,,0,0,0,,بناءً على هذا
Dialogue: 0,0:16:52.23,0:16:56.33,Default,,0,0,0,,‫يمكننا حصر المشتبه بهم في أولئك الذين صعدوا إلى الطابق الثالث.
Dialogue: 0,0:16:56.33,0:16:59.37,Default,,0,0,0,,بمعنى آخر، الآنسة تسوروفوجي يوكو
Dialogue: 0,0:17:00.09,0:17:01.37,Default,,0,0,0,,والآنسة نيجي كاورو
Dialogue: 0,0:17:01.99,0:17:04.13,Default,,0,0,0,,‫والسيد هاياسي كازومي.
Dialogue: 0,0:17:04.83,0:17:08.01,Default,,0,0,0,,‫إذن أنا لستُ مشتبهة بها.
Dialogue: 0,0:17:08.56,0:17:10.26,Default,,0,0,0,,‫نعم، هذا ما يعنيه الأمر.
Dialogue: 0,0:17:10.26,0:17:14.68,Default,,0,0,0,,لكن كيف وصل الجاني إلى الطابق الثالث؟
Dialogue: 0,0:17:14.68,0:17:19.52,Default,,0,0,0,,‫كنا في الطابق الثاني، ولم يأتي أحد إلى الأعلى.
Dialogue: 0,0:17:19.52,0:17:23.78,Default,,0,0,0,,لقد استخدم حبل تنظيف النوافذ والدعامات من لافتة النيون
Dialogue: 0,0:17:24.39,0:17:27.10,Default,,0,0,0,,‫ليصعد خارج المبنى.
Dialogue: 1,0:17:26.39,0:17:32.61,sign_1196_studio,SIGN,0000,0000,0000,,{\an2\bord0\shad0\blur0.4\fad(500,500)\c&HC093ED&\b0\fsp0.8\pos(175,125)\fs30} ماي ماي \N{\b0\c&HD6C489&}استديو
Dialogue: 0,0:17:26.39,0:17:32.61,sign_1196_studio,SIGN,0000,0000,0000,,{\an2\fad(500,500)\pos(175,125)\fs30}ماي ماي\Nاستديو
Dialogue: 0,0:17:27.57,0:17:30.07,Default,,0,0,0,,الآنسة مايماي كانت في الطابق الرابع
Dialogue: 0,0:17:30.07,0:17:34.80,Default,,0,0,0,,‫لكنها لم تلاحظ لأنها كانت مركزة على العمل في الاستوديو.
Dialogue: 0,0:17:34.80,0:17:38.15,Default,,0,0,0,,مـ-ماذا لو لاحظت؟
Dialogue: 0,0:17:38.51,0:17:42.18,Default,,0,0,0,,‫لكنتِ اصبحتي في خطر.
Dialogue: 0,0:17:42.18,0:17:43.12,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:17:43.98,0:17:47.06,Default,,0,0,0,,‫ثم قام بضرب السيد سينسوكي في الطابق الثالث.
Dialogue: 0,0:17:47.62,0:17:51.00,Default,,0,0,0,,و قتله بطريقة تشبه الانتحار
Dialogue: 0,0:17:51.00,0:17:53.26,Default,,0,0,0,,‫وفرا إلى الطابق الثاني.
Dialogue: 0,0:17:53.71,0:17:54.39,Default,,0,0,0,,‫ران.
Dialogue: 0,0:17:55.19,0:18:00.64,Default,,0,0,0,,هل تذكرين الترتيب الذي صعدوا به إلى الطابق الثالث؟
Dialogue: 0,0:18:00.64,0:18:03.13,Default,,0,0,0,,‫حسناً...
Dialogue: 0,0:18:03.13,0:18:06.05,Default,,0,0,0,,الآنسة يوكو وصلت أولاً
Dialogue: 0,0:18:06.05,0:18:07.86,Default,,0,0,0,,ثم الآنسة نيجي
Dialogue: 0,0:18:07.86,0:18:12.03,Default,,0,0,0,,‫وأخيرًا، السيد هاياسي وصل أخيرًا.
Dialogue: 0,0:18:12.38,0:18:13.91,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:18:14.24,0:18:16.31,Default,,0,0,0,,‫بالمناسبة، سيد هاياسي...
Dialogue: 0,0:18:17.16,0:18:22.61,Default,,0,0,0,,‫كان لديك تعبير غريب عندما وصلت إلى مسرح جريمة الطابق الثالث.
Dialogue: 0,0:18:23.13,0:18:26.30,Default,,0,0,0,,‫بدوت مرتبك بعض الشيء.
Dialogue: 0,0:18:26.89,0:18:28.89,Default,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:18:28.89,0:18:29.75,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:18:32.10,0:18:34.30,Default,,0,0,0,,أهذا صحيح؟
Dialogue: 0,0:18:34.91,0:18:37.58,Default,,0,0,0,,ألم تتصل متأخر
Dialogue: 0,0:18:37.58,0:18:41.43,Default,,0,0,0,,لأنك كنت تنتظر في الطابق الأول شخصًا كان بالخارج؟
Dialogue: 0,0:18:43.53,0:18:48.19,Default,,0,0,0,,‫لكنه وصل إلى مسرح الجريمة قبلك.
Dialogue: 0,0:18:48.19,0:18:51.79,Default,,0,0,0,,أليس هذا سبب كونك تبدوا مرتبكاً جدًا؟
Dialogue: 0,0:18:53.41,0:18:56.59,Default,,0,0,0,,اعتقدتَ أنه كان خيالًا منك حينها
Dialogue: 0,0:18:56.59,0:19:00.33,Default,,0,0,0,,‫لكن بعد الجريمة الثانية، أصبحت متأكد.
Dialogue: 0,0:19:00.60,0:19:04.83,Default,,0,0,0,,‫ليس لدي أي فكرة عما تتحدث عنه.
Dialogue: 0,0:19:05.29,0:19:09.96,Default,,0,0,0,,ألم تكون تنتظر الآنسة نيجي، التي كانت من المفترض أن تكون بالخارج؟
Dialogue: 0,0:19:14.52,0:19:17.93,Default,,0,0,0,,سيد هاياسي، لقد قلت إنك كنت مع الآنسة نيجي
Dialogue: 0,0:19:17.93,0:19:21.73,Default,,0,0,0,,‫طوال الوقت عندما وقعت الجريمة الثانية.
Dialogue: 0,0:19:21.73,0:19:27.78,Default,,0,0,0,,لكن في الواقع، ألم تلتقي بها قبل أن يراك كونان مباشرة؟
Dialogue: 0,0:19:30.18,0:19:31.55,Default,,0,0,0,,‫كاورو.
Dialogue: 0,0:19:31.55,0:19:34.74,Default,,0,0,0,,‫آسفة لتأخري، هاياسي.
Dialogue: 0,0:19:34.74,0:19:37.02,Default,,0,0,0,,‫لا بأس.
Dialogue: 0,0:19:37.02,0:19:39.62,Default,,0,0,0,,إذن، ما الذي كنتَ تريد مناقشته؟
Dialogue: 0,0:19:41.99,0:19:46.02,Default,,0,0,0,,لم لا تستقيلين من العمل هنا وتأتين للعمل في شركتي؟
Dialogue: 0,0:19:46.02,0:19:48.00,Default,,0,0,0,,لماذا تقول ذلك؟
Dialogue: 0,0:19:50.93,0:19:54.10,Default,,0,0,0,,خوفًا من أن لا يكون ذلك كافيًا
Dialogue: 0,0:19:54.41,0:19:59.51,Default,,0,0,0,,‫أسقطت حجارة على كونان والآنسة نيجي من السطح بينما كانا يتحدثان.
Dialogue: 0,0:20:07.73,0:20:12.98,Default,,0,0,0,,‫اعتقدت أن ذلك سيزيل الآنسة نيجي من قائمة المشتبه بهم.
Dialogue: 0,0:20:13.39,0:20:16.02,Default,,0,0,0,,‫مخطئ! أنت مخطئ!
Dialogue: 0,0:20:16.02,0:20:18.78,Default,,0,0,0,,‫لا بأس، هاياسي.
Dialogue: 0,0:20:19.25,0:20:20.79,Default,,0,0,0,,‫كاورو...
Dialogue: 0,0:20:20.79,0:20:26.67,Default,,0,0,0,,‫لقد دعوتكَ في الواقع فقط لاختلاق عذر غيابي.
Dialogue: 0,0:20:26.67,0:20:28.74,Default,,0,0,0,,إذا لم يكن هناك زوار
Dialogue: 0,0:20:28.74,0:20:32.18,Default,,0,0,0,,‫كنتُ سأستخدمك كشاهد طرف ثالث.
Dialogue: 0,0:20:34.12,0:20:38.26,Default,,0,0,0,,‫لأن كل ما خططت له سار دون عوائق...
Dialogue: 0,0:20:48.39,0:20:51.90,Default,,0,0,0,,‫ظننت أنني قد لا أُقبض علي.
Dialogue: 0,0:20:51.90,0:20:56.28,Default,,0,0,0,,هل أنتِ جادة؟ لماذا قتلتِ زوجي؟
Dialogue: 0,0:20:56.66,0:21:01.12,Default,,0,0,0,,لأن السيد سينسوكي حاول بيع بعض أعمال تسوروفوجي كيو لتاجر أعمال فنية
Dialogue: 0,0:21:01.12,0:21:03.95,Default,,0,0,0,,‫بسبب صعوبات مالية!
Dialogue: 0,0:21:04.49,0:21:06.66,Default,,0,0,0,,‫بسعر منخفض بشكل لا يصدق أيضًا.
Dialogue: 0,0:21:06.66,0:21:11.58,Default,,0,0,0,,‫خمسة ملايين مقابل عمل لتسوروفوجي كيو هو أمر سخيف!
Dialogue: 0,0:21:11.91,0:21:14.71,Default,,0,0,0,,إذن لماذا قتلتِ زوجي؟
Dialogue: 0,0:21:15.21,0:21:22.34,Default,,0,0,0,,‫لقد رآني أنزل إلى الطابق الثاني عبر الأرضية بينما كان يرسم.
Dialogue: 0,0:21:29.85,0:21:34.47,Default,,0,0,0,,‫ابتزني، لذا لم يكن لدي خيار.
Dialogue: 0,0:21:45.89,0:21:51.37,DC-ED,,0,0,0,,‫الوقت يمضي، مرة أخرى
Dialogue: 0,0:21:51.77,0:21:55.95,DC-ED,,0,0,0,,‫أن أصادف أزهار الكرز
Dialogue: 0,0:21:56.76,0:22:02.07,DC-ED,,0,0,0,,‫قلبي يترقّب قدومك بفارغ الصبر
Dialogue: 0,0:22:02.26,0:22:07.11,DC-ED,,0,0,0,,‫كالزهرة المتفتحة
Dialogue: 0,0:22:07.66,0:22:13.50,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:22:19.38,0:22:28.49,DC-ED,,0,0,0,,‫مشاعر الاشتياق التي لا تُقابل باللقاء
Dialogue: 0,0:22:30.04,0:22:33.93,DC-ED,,0,0,0,,‫تستمر بلا نهاية
Dialogue: 0,0:22:34.08,0:22:39.46,DC-ED,,0,0,0,,‫رغم محاولاتي المتكررة للنسيان
Dialogue: 0,0:22:40.82,0:22:42.87,DC-ED,,0,0,0,,‫أخبرتني
Dialogue: 0,0:22:42.87,0:22:45.93,DC-ED,,0,0,0,,‫كل المشاعر الدافئة
Dialogue: 0,0:22:45.93,0:22:50.33,DC-ED,,0,0,0,,‫لا تفارقني
Dialogue: 0,0:22:58.61,0:23:04.51,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:23:06.13,0:23:09.91,Default,,0,0,0,,‫لقد كان متحفًا غريبًا بالتأكيد.
Dialogue: 0,0:23:10.53,0:23:14.93,Default,,0,0,0,,‫بالمناسبة، كونان، الشخص الذي صمم ذلك المبنى...
Dialogue: 0,0:23:14.93,0:23:16.67,Default,,0,0,0,,هيروكي ماساتارو؟
Dialogue: 0,0:23:16.97,0:23:20.92,Default,,0,0,0,,نعم. كيف هو سيد هيروكي؟
Dialogue: 0,0:23:21.31,0:23:27.02,Default,,0,0,0,,‫يبدو أنه صمم الكثير من المباني الغريبة.
Dialogue: 0,0:23:27.02,0:23:31.11,Default,,0,0,0,,‫لكن منذ عامين، اختفى بشكل غامض.
Dialogue: 0,0:23:32.51,0:23:37.37,Default,,0,0,0,,بعد تصميم مباني غريبة، اختفى بشكل غامض؟
Dialogue: 0,0:23:37.81,0:23:41.51,Default,,0,0,0,,‫لدي شعور سيئ حيال ذلك...
Dialogue: 0,0:23:44.94,0:23:49.28,Default,,0,0,0,,‫يبدو أن كامين يايبا يأتي إلى تلك الحديقة كل صباح.
Dialogue: 0,0:23:44.94,0:24:08.97,sign_episode_preview,SIGN,0000,0000,0000,, في الحلقة القادمة 
Dialogue: 0,0:23:52.79,0:23:54.37,Default,,0,0,0,,‫اتركني!
Dialogue: 0,0:23:54.37,0:23:55.66,Default,,0,0,0,,‫توقف!
Dialogue: 0,0:24:01.17,0:24:03.11,Default,,0,0,0,,لحظة، ماذا كان ذلك؟
Dialogue: 0,0:24:03.11,0:24:05.47,Default,,0,0,0,,‫بدا ذلك وكأنه كونان ويايبا.
Dialogue: 0,0:24:05.47,0:24:07.49,Default,,0,0,0,,‫لا، أمامهما.
Dialogue: 0,0:24:07.49,0:24:08.97,Default,,0,0,0,,ألم يكن ذلك مختلس حقيبة؟
Dialogue: 0,0:24:08.97,0:24:14.97,sign_next_episode,SIGN,0000,0000,0000,,{\pos(320,55)}قائد التنكر الإعصاري
Dialogue: 0,0:24:09.40,0:24:13.62,Default,,0,0,0,,‫الحلقة القادمة من كونان: "قائد التنكر الإعصاري!"
Dialogue: 0,0:24:29.99,0:24:33.19,Default,,0,0,0,,‫لنلتقي مرة أخرى أيها الصبي. تلميح كونان القادم!{\an8}
Dialogue: 0,0:24:29.99,0:24:34.91,sign_hint_label,SIGN,0000,0000,0000,,{\an2\fnImpact\pos(320,300)}{\3c&HACA8A6&} ملكة الرياح 
Dialogue: 0,0:24:33.19,0:24:34.91,Default,,0,0,0,,‫ملكة الرياح!{\an8}
Dialogue: 0,0:24:34.91,0:24:39.92,sign_dont_miss,SIGN,0000,0000,0000,,{\pos(245,304)} لا تفوتوا الحلقة القادمة 
Dialogue: 0,0:24:35.35,0:24:37.88,Default,,0,0,0,,‫"ملاك الطريق السريع الساقط" يُعرض الأسبوع القادم!{\an8}
Dialogue: 0,0:24:37.88,0:24:39.47,Default,,0,0,0,,‫شاهدوني في عرض الجمعة القادم!{\an8}
