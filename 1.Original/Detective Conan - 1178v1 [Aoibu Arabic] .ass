Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)}Iy nasan & ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS & @Iy_ nasan\NX : @Theconansign
Dialogue: 0,0:00:06.70,0:00:07.10,Default,,0,0,0,,مهلًا
Dialogue: 0,0:00:07.90,0:00:08.55,Default,,0,0,0,,انتظروا
Dialogue: 0,0:00:09.30,0:00:10.20,Default,,0,0,0,,قلت
Dialogue: 0,0:00:10.90,0:00:12.10,Default,,0,0,0,,انتظروا قليلًا
Dialogue: 0,0:00:13.80,0:00:14.76,Default,,0,0,0,,..ما رأيكم أن نستريح 
Dialogue: 0,0:00:17.76,0:00:18.76,Default,,0,0,0,,في هذه المنطقة
Dialogue: 0,0:00:20.16,0:00:23.96,Default,,0,0,0,,يا إلهي أبي! أولم نسترح للتو؟
Dialogue: 0,0:00:23.96,0:00:25.86,Default,,0,0,0,,سنتركك ونرحل
Dialogue: 0,0:00:29.26,0:00:30.76,Default,,0,0,0,, ..لم أنم كثيرًا لذا
Dialogue: 0,0:00:32.00,0:00:34.32,Default,,0,0,0,,ارحموني قليلًا
Dialogue: 0,0:00:34.72,0:00:36.82,Default,,0,0,0,,لم يكن عليك مرافقتنا إذًا
Dialogue: 0,0:00:37.42,0:00:41.72,Default,,0,0,0,,ألست قلقًا أن ابنتك العزيزة (ران) ذاهبة لمكان بعيد
Dialogue: 0,0:00:41.72,0:00:45.32,Default,,0,0,0,,ومعها فتى في الثانوية لذا قد يكون الوضع خطير
Dialogue: 0,0:00:45.32,0:00:48.42,Default,,0,0,0,,ولكن مع (هيجي) فهي في أيد أمينة أوليس كذلك؟
Dialogue: 0,0:00:48.62,0:00:50.82,Default,,0,0,0,,لا أعلم فإن حدث شيئ ما عندها أنا
Dialogue: 0,0:00:52.72,0:00:54.42,Default,,0,0,0,,ماذا تعني إن حدث شيئ ما؟
Dialogue: 0,0:00:55.12,0:00:57.52,Default,,0,0,0,,!صحيح, إنها في أيد أمينة
Dialogue: 0,0:00:58.92,0:01:01.30,Default,,0,0,0,,ولكن لم علينا تسلق الجبل؟
Dialogue: 0,0:01:01.64,0:01:06.40,Default,,0,0,0,,لأنه في قمة جبل "واشيو" هذا توجد إطلالة خلابة
Dialogue: 0,0:01:06.40,0:01:10.73,Default,,0,0,0,,حيث أني سمعت أن منظر غروب الشمس اتجاه جبل "فوجي" بديع للغاية
Dialogue: 0,0:01:12.03,0:01:13.40,Default,,0,0,0,,إنني أتطلع لذلك
Dialogue: 0,0:01:13.40,0:01:14.60,Default,,0,0,0,,أليس كذلك (هيجي)؟
Dialogue: 0,0:01:15.00,0:01:16.40,Default,,0,0,0,,نـ نعم أنت محقة
Dialogue: 0,0:01:16.90,0:01:20.10,Default,,0,0,0,,..صحيح, أحضرتهما لهنا لسبب وهو بالطبع
Dialogue: 0,0:01:20.70,0:01:24.00,Default,,0,0,0,,جعلهما ثنائي عن طريق اعترافهما في منطقة خلابة
Dialogue: 0,0:01:25.00,0:01:30.60,Default,,0,0,0,,وشعرتُ بأن الآنسة (موميجي) ستلاحقنا من جديد\N..لذا إن تسلقنا الجبل
Dialogue: 0,0:01:36.50,0:01:40.00,Default,,0,0,0,,!ياليت كان هناك مصعد يوصلني للقمة
Dialogue: 0,0:01:40.50,0:01:44.00,Default,,0,0,0,,فظننتُ أنها ستستسلم في منتصف الطريق
Dialogue: 0,0:01:44.70,0:01:49.40,Default,,0,0,0,,ولكن على أي حال يبدو أن الآنسة (موميجي) لديها مسابقة "كاروتا" اليوم فلن تتمكن من المجيئ
Dialogue: 0,0:01:58.11,0:02:01.91,Default,,0,0,0,,إنهما في مزاج رائع كان تسلق الجبل الخيار الصحيح
Dialogue: 0,0:02:02.31,0:02:03.58,Default,,0,0,0,,!عمل جيد يا أنا
Dialogue: 0,0:02:06.00,0:02:09.70,Default,,0,0,0,,..ولكن الجو غائم للغاية وقد يهطل
Dialogue: 0,0:02:14.40,0:02:16.10,Default,,0,0,0,,!لقد هطل فجأة
Dialogue: 0,0:02:16.50,0:02:20.00,Default,,0,0,0,,مستحيل, رغم أنهم اعلنوا في نشرة الطقس أنها لن تمطر اليوم
Dialogue: 0,0:02:20.00,0:02:22.60,Default,,0,0,0,,(ران) أنا أملك معي مظلة
Dialogue: 0,0:02:23.10,0:02:24.90,Default,,0,0,0,,هيا فلتأتي أنت أيضًا يا (هيجي)
Dialogue: 0,0:02:25.30,0:02:27.80,Default,,0,0,0,,حمقاء,ألا ترين أنها بالكاد تكفيكم
Dialogue: 0,0:02:29.10,0:02:29.80,Default,,0,0,0,,سحقًا
Dialogue: 0,0:02:30.60,0:02:31.90,Default,,0,0,0,,ألا وجود لمكان ما
Dialogue: 0,0:02:32.40,0:02:33.80,Default,,0,0,0,,نستطيع أن نحتمي به
Dialogue: 0,0:02:34.20,0:02:36.10,Default,,0,0,0,,أي شيء له سقف
Dialogue: 0,0:02:39.30,0:02:40.00,Default,,0,0,0,,!هناك
Dialogue: 0,0:02:43.60,0:02:44.10,Default,,0,0,0,,إنه معبد
Dialogue: 0,0:02:44.60,0:02:45.20,Default,,0,0,0,,!معبد
Dialogue: 0,0:02:48.00,0:02:50.00,Default,,0,0,0,,مالذي تخفيه خلف قناعك المحطم؟
Dialogue: 0,0:02:50.00,0:02:52.40,Default,,0,0,0,,هل سيعترف (هيجي) لـ(كازوها)؟
Dialogue: 0,0:02:52.40,0:02:54.40,Default,,0,0,0,,خطة سوداء في المطر المفاجئ
Dialogue: 0,0:02:54.40,0:02:56.00,Default,,0,0,0,,يسعى وراء الحقيقة الوحيدة
Dialogue: 0,0:02:56.20,0:02:57.70,Default,,0,0,0,,جسده طفل وعقله بالغ
Dialogue: 0,0:02:57.70,0:03:00.40,Default,,0,0,0,,يدعى بالمحقق (كونان)
Dialogue: 0,0:04:42.61,0:04:45.85,Default,,0,0,0,,"!الجمجمة القرمزية في جبل واشيو - الجزء الأول"
Dialogue: 0,0:04:50.90,0:04:54.10,Default,,0,0,0,,وهذا ماحدث, نحن في ورطة كبيرة
Dialogue: 0,0:04:54.60,0:04:59.00,Default,,0,0,0,,سماحكم لنا بالراحة في الداخل إلى أن يتوقف المطر سيكون ذو عون كبير
Dialogue: 0,0:05:00.90,0:05:04.60,Default,,0,0,0,,{\an8}بالطبع لامشكلة, خذوا راحتكم من فضلكم
Dialogue: 0,0:05:05.20,0:05:07.00,Default,,0,0,0,,{\an8}شكرًا لك, أعتذر على الإزعاج
Dialogue: 0,0:05:07.00,0:05:08.60,Default,,0,0,0,,شكرًا لك
Dialogue: 0,0:05:09.10,0:05:17.40,Default,,0,0,0,,باستثناء الجنائز وحفلات التأبين فهذا المعبد الصغير لا يُزار إلا من أجل تمثال (بوذا) لذا هذا ليس اعتيادي
Dialogue: 0,0:05:17.90,0:05:19.40,Default,,0,0,0,,تمثال (بوذا)؟
Dialogue: 0,0:05:20.40,0:05:21.70,Default,,0,0,0,,هيا أنتما
Dialogue: 0,0:05:21.90,0:05:22.40,Default,,0,0,0,,{\an8}نعم
Dialogue: 0,0:05:22.90,0:05:25.90,Default,,0,0,0,,{\an8}(كينتيتسو) قم بإعداد شاي دافئ لهؤلاء السادة
Dialogue: 0,0:05:25.90,0:05:26.90,Default,,0,0,0,,{\an8}حاضر
Dialogue: 0,0:05:26.90,0:05:30.60,Default,,0,0,0,,{\an8}(تونتيستو) قم بإخراج بعض المناشف ليمسحو بها بللهم
Dialogue: 0,0:05:30.60,0:05:31.50,Default,,0,0,0,,{\an8}فهمت
Dialogue: 0,0:05:36.40,0:05:38.60,Default,,0,0,0,,لا يبدو أن المطر سيتوقف عما قريب
Dialogue: 0,0:05:39.90,0:05:43.26,Default,,0,0,0,,رغم أني كنت متحمسة لرؤية الغروب على قمة الجبل
Dialogue: 0,0:05:43.26,0:05:45.70,Default,,0,0,0,,يبدو أنه سيتوقف بحلول المساء
Dialogue: 0,0:05:45.70,0:05:46.60,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:05:46.60,0:05:47.40,Default,,0,0,0,,أجل
Dialogue: 0,0:05:47.40,0:05:51.00,Default,,0,0,0,,وأيضًا غروب الشمس من معبد (شوغاكو) هذا مشهور أيضًا
Dialogue: 0,0:05:52.60,0:05:57.60,Default,,0,0,0,,بالمناسبة يمكنك رؤية الغروب باتجاه جبل فوجي بوضوح من هذه الغرفة
Dialogue: 0,0:05:57.60,0:05:58.70,Default,,0,0,0,,من هذه الغرفة؟
Dialogue: 0,0:05:58.70,0:05:59.60,Default,,0,0,0,,أجل
Dialogue: 0,0:05:59.60,0:06:04.10,Default,,0,0,0,,والنافذة مفتوحة أيضًا مارأيكم بالجلوس إلى وقت الغروب؟
Dialogue: 0,0:06:04.10,0:06:06.10,Default,,0,0,0,,شكرًا جزيلًا
Dialogue: 0,0:06:08.40,0:06:12.40,Default,,0,0,0,,إن كان ذلك فلنبحث قليلًا عن هذا المعبد
Dialogue: 0,0:06:13.80,0:06:14.80,Default,,0,0,0,,!إنه محق
Dialogue: 0,0:06:15.20,0:06:17.30,Default,,0,0,0,,مكتوب عنه أنه بقعة سرية ذات إطلالة خلابة
Dialogue: 0,0:06:17.70,0:06:20.90,Default,,0,0,0,,إذًا أليس من الأفضل أن نرى الغروب من هنا؟
Dialogue: 0,0:06:22.90,0:06:25.20,Default,,0,0,0,,إذًا أخبريني مالذي تريدين التحدث به؟
Dialogue: 0,0:06:25.90,0:06:28.00,Default,,0,0,0,,ألم تقولي يا (ران) أن هناك ما ستخبريني به؟
Dialogue: 0,0:06:30.90,0:06:36.20,Default,,0,0,0,,في الحقيقة لم أكن أريد إخبارك حتى\N ..تسير أموركِ يا(كازوها) بشكل جيد ولكن
Dialogue: 0,0:06:37.70,0:06:38.50,Default,,0,0,0,,جيد؟
Dialogue: 0,0:06:43.60,0:06:44.10,Default,,0,0,0,,..في الحقيقة 
Dialogue: 0,0:06:45.40,0:06:47.00,Default,,0,0,0,,..أنا و(شينتشي)
Dialogue: 0,0:06:47.50,0:06:49.00,Default,,0,0,0,,بدأنا بالمواعدة
Dialogue: 0,0:06:55.10,0:06:58.00,Default,,0,0,0,,أعتذر لأني لم أخبرك عن ذلك طوال هذا الوقت
Dialogue: 0,0:07:02.30,0:07:10.00,Default,,0,0,0,,هذا رائع يا(ران) لم تعودي تتحدثي عن (كودو) مطلقًا لذا ظننتُ أن الأمور قد ساءت بينكما
Dialogue: 0,0:07:10.30,0:07:12.90,Default,,0,0,0,,أنا حقًا سعيدة
Dialogue: 0,0:07:14.70,0:07:15.50,Default,,0,0,0,,أشكرك
Dialogue: 0,0:07:16.80,0:07:18.90,Default,,0,0,0,,..ولكن ما سأقوله ليس بسبب هذا ولكن
Dialogue: 0,0:07:19.50,0:07:22.77,Default,,0,0,0,,..هذه المرة مجيئ (هاتوري) معكِ على ما أظن هو
Dialogue: 0,0:07:24.50,0:07:27.90,Default,,0,0,0,,هاقد عدت مجددًا لحدسك في الحب
Dialogue: 0,0:07:28.40,0:07:29.90,Default,,0,0,0,,فلتكفّي عن هذا
Dialogue: 0,0:07:29.90,0:07:35.70,Default,,0,0,0,,..لقد ظننتُ أني أبالغ في التفكير لذا عندما سألتُ (شينتشي) قال
Dialogue: 0,0:07:36.40,0:07:41.60,Default,,0,0,0,,إن كان تحليلي صائبًا فلا شك بأن (هاتوري) يحب (كازوها)
Dialogue: 0,0:07:42.00,0:07:43.20,Default,,0,0,0,,هذا ماقاله..
Dialogue: 0,0:07:43.90,0:07:45.00,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:07:45.80,0:07:47.70,Default,,0,0,0,,قال أن الحقيقة واحدة دائمًا
Dialogue: 0,0:07:47.90,0:07:49.50,Default,,0,0,0,,!لم أقل إلى ذلك الحد
Dialogue: 0,0:07:50.00,0:07:55.60,Default,,0,0,0,,ولكن ألم تقولي أن كلًا من (هولمز) و(كودو)\N سيئان في الأمور التي تتعلق بالحب؟
Dialogue: 0,0:07:56.20,0:07:58.40,Default,,0,0,0,,هنا تكمن المشكلة 
Dialogue: 0,0:07:59.00,0:07:59.90,Default,,0,0,0,,ويحكِ
Dialogue: 0,0:08:00.40,0:08:01.60,Default,,0,0,0,,مالذي تفعلونه؟
Dialogue: 0,0:08:02.70,0:08:05.00,Default,,0,0,0,,عمّ تتحدثون سرية هكذا؟
Dialogue: 0,0:08:05.90,0:08:06.60,Default,,0,0,0,,!(هيجي)
Dialogue: 0,0:08:07.40,0:08:08.40,Default,,0,0,0,,لقد أفزعتني
Dialogue: 0,0:08:08.40,0:08:10.40,Default,,0,0,0,,ياإلهي لم أنت عاري الجذع؟
Dialogue: 0,0:08:10.40,0:08:11.90,Default,,0,0,0,,أنت أيضًا يا أبي
Dialogue: 0,0:08:12.40,0:08:13.80,Default,,0,0,0,,ليست باليد حيلة
Dialogue: 0,0:08:13.80,0:08:16.80,Default,,0,0,0,,لأننا لم نستطع الدخول تحت المظلة تبللنا بالكامل
Dialogue: 0,0:08:16.80,0:08:20.20,Default,,0,0,0,,إنهم يقومون بتجفيف ملابسنا بالمجفف
Dialogue: 0,0:08:20.40,0:08:21.30,Default,,0,0,0,,المعذرة
Dialogue: 0,0:08:21.90,0:08:23.10,Default,,0,0,0,,أعتذر على التأخير
Dialogue: 0,0:08:23.30,0:08:24.80,Default,,0,0,0,,لقد جففتُ ملابسكم
Dialogue: 0,0:08:25.80,0:08:26.30,Default,,0,0,0,,المعذرة
Dialogue: 0,0:08:26.60,0:08:27.20,Default,,0,0,0,,أشكرك
Dialogue: 0,0:08:33.70,0:08:35.30,Default,,0,0,0,,لا أجد تميمتي
Dialogue: 0,0:08:36.20,0:08:37.10,Default,,0,0,0,,أين ذهبت؟
Dialogue: 0,0:08:37.60,0:08:39.90,Default,,0,0,0,,لقد تأكدت من وضعها في السلة
Dialogue: 0,0:08:40.50,0:08:42.70,Default,,0,0,0,,هل وضعت التميمة أيضًا في المجفف؟
Dialogue: 0,0:08:42.90,0:08:44.30,Default,,0,0,0,,أجل فقد كانت مبللة
Dialogue: 0,0:08:44.30,0:08:45.80,Default,,0,0,0,,ستُعاقب على ذلك
Dialogue: 0,0:08:46.30,0:08:48.40,Default,,0,0,0,,ألم تسقط في طريق إحضارك لها؟
Dialogue: 0,0:08:48.40,0:08:49.20,Default,,0,0,0,,ربما
Dialogue: 0,0:08:49.80,0:08:51.70,Default,,0,0,0,,ماذا؟ أفقدتم شيئًا ما؟
Dialogue: 0,0:08:51.70,0:08:54.40,Default,,0,0,0,,أيها الراهب ألم ترَ تميمة؟
Dialogue: 0,0:08:54.60,0:08:57.70,Default,,0,0,0,,لنرَ, (كونتيستيو) ألم ترها؟
Dialogue: 0,0:08:57.80,0:08:58.40,Default,,0,0,0,,كلا
Dialogue: 0,0:08:58.90,0:09:01.20,Default,,0,0,0,,إذًا فلنسأل الآخر أيضًا
Dialogue: 0,0:09:03.80,0:09:06.80,Default,,0,0,0,,هناك شخص آخر في هذا المعبد صحيح؟
Dialogue: 0,0:09:09.80,0:09:11.70,Default,,0,0,0,,كيف عرفت؟
Dialogue: 0,0:09:12.50,0:09:17.90,Default,,0,0,0,,سابقًا عندما استعرتُ المنشفة من المغسلة \Nكانت هناك أربع أكواب بفرش أسنان
Dialogue: 0,0:09:19.10,0:09:20.30,Default,,0,0,0,,هـ هكذا إذًا
Dialogue: 0,0:09:20.80,0:09:21.80,Default,,0,0,0,,..في الحقيقة
Dialogue: 0,0:09:22.30,0:09:26.40,Default,,0,0,0,,في هذا المعبد هناك راهب آخر يدعى (كونتاتسو)
Dialogue: 0,0:09:26.40,0:09:30.00,Default,,0,0,0,,لقد اختفى منذ خمسة أيام
Dialogue: 0,0:09:30.70,0:09:35.90,Default,,0,0,0,,لقد كان يدخن السجائر خفية \Nلذا وضعته في غرفة التأديب لفترة
Dialogue: 0,0:09:36.37,0:09:37.90,Default,,0,0,0,,غرفة التأديب؟
Dialogue: 0,0:09:38.00,0:09:41.38,Default,,0,0,0,,لابد أنه كره الرهبانية فهرب
Dialogue: 0,0:09:41.38,0:09:42.88,Default,,0,0,0,,كلا أنت مخطئ
Dialogue: 0,0:09:43.48,0:09:44.38,Default,,0,0,0,,سيد (كينتيتسو)
Dialogue: 0,0:09:44.78,0:09:48.48,Default,,0,0,0,,أيها الراهب و(تونتيتسو) ألم ترياها أيضًا؟
Dialogue: 0,0:09:49.00,0:09:50.48,Default,,0,0,0,,"تلك "الهيتوداما
Dialogue: 0,0:09:51.38,0:09:52.28,Default,,0,0,0,,هـ هيتوداما؟
Dialogue: 0,0:09:52.88,0:09:55.28,Default,,0,0,0,,في ذاك اليوم الذي اختفى به (كانتيتسو)
Dialogue: 0,0:09:55.28,0:09:59.48,Default,,0,0,0,,كانت تصعد الدرجات المؤدية إلى غرفة التأديب
Dialogue: 0,0:10:01.85,0:10:06.52,Default,,0,0,0,,!لا بد أن (كانتيتسو) اختطف من قبل الجمجمة القرمزية
Dialogue: 0,0:10:07.92,0:10:09.32,Default,,0,0,0,,الجمجمة القرمزية
Dialogue: 0,0:10:11.92,0:10:13.62,Default,,0,0,0,,ماهذه؟
Dialogue: 0,0:10:14.52,0:10:17.82,Default,,0,0,0,,إنها قصة متداولة في جبل "واشيو" هذا
Dialogue: 0,0:10:19.22,0:10:25.52,Default,,0,0,0,,تظهر سوية مع "الهيتوداما" تختطف \Nأصحاب الأفعال السيئة وتلتهم أرواحهم
Dialogue: 0,0:10:25.82,0:10:29.92,Default,,0,0,0,,ثم بعد ذلك بفترة تترك بقاياهم وترحل
Dialogue: 0,0:10:30.62,0:10:32.82,Default,,0,0,0,,إنها أسطورة تناقلوها منذ القدم
Dialogue: 0,0:10:33.72,0:10:40.82,Default,,0,0,0,,ولكن الأساطير تبقى أساطير\Nالضوء الذي رأيناه حينها قد يكون ليراعات تاهت فالمعبد غالبًا
Dialogue: 0,0:10:41.82,0:10:44.52,Default,,0,0,0,,ولكن هناك من رأى "الهيتوداما" في الغابة
Dialogue: 0,0:10:44.52,0:10:45.68,Default,,0,0,0,,وكانت هناك جثث حقيقيـ
Dialogue: 0,0:10:45.68,0:10:47.68,Default,,0,0,0,,!!فلتصمت
Dialogue: 0,0:10:47.68,0:10:50.18,Default,,0,0,0,,!لا يمكن لشيء كهذا أن يوجد
Dialogue: 0,0:10:53.48,0:10:56.68,Default,,0,0,0,,على أي حال, فلنتوقف هنا
Dialogue: 0,0:10:56.68,0:11:00.38,Default,,0,0,0,,وقم بتحضير بعض الشاي والكعك لهؤلاء الضيوف
Dialogue: 0,0:11:01.28,0:11:02.38,Default,,0,0,0,,حـ حاضر
Dialogue: 0,0:11:11.38,0:11:15.78,Default,,0,0,0,,حتى حمام معبد كهذا مبني على طراز غربي حديث
Dialogue: 0,0:11:18.68,0:11:19.58,Default,,0,0,0,,ماذا ماذا؟
Dialogue: 0,0:11:26.28,0:11:27.68,Default,,0,0,0,,كرة معدنية
Dialogue: 0,0:11:28.68,0:11:30.18,Default,,0,0,0,,هل سقطت من أعلى الدرج؟
Dialogue: 0,0:11:31.28,0:11:35.18,Default,,0,0,0,,ما يوجد في الأعلى هو ماقالو عنه غرفة التأديب
Dialogue: 0,0:11:38.78,0:11:41.68,Default,,0,0,0,,معذرة, أما من أحد هنا؟
Dialogue: 0,0:11:43.58,0:11:44.68,Default,,0,0,0,,المعذرة
Dialogue: 0,0:11:47.08,0:11:48.78,Default,,0,0,0,,ألا توجد إضاءة؟
Dialogue: 0,0:11:57.58,0:11:58.88,Default,,0,0,0,,أبي
Dialogue: 0,0:11:59.58,0:12:00.58,Default,,0,0,0,,أين أنت؟
Dialogue: 0,0:12:01.07,0:12:03.35,Default,,0,0,0,,!أبي
Dialogue: 0,0:12:04.69,0:12:06.80,Default,,0,0,0,,ما الأمر يا ران؟
Dialogue: 0,0:12:06.80,0:12:10.08,Default,,0,0,0,,ذهب أبي إلى الحمام ولم يعد.
Dialogue: 0,0:12:10.36,0:12:14.39,Default,,0,0,0,,ربما تناول بعض الفطر الغريب في الجبال وأصيب باضطراب في المعدة.
Dialogue: 0,0:12:14.39,0:12:16.81,Default,,0,0,0,,لكن لم يكن هناك أحد في الحمام.
Dialogue: 0,0:12:16.81,0:12:19.33,Default,,0,0,0,,.إذًا ربما هو يغفو في مكان ما
Dialogue: 0,0:12:19.33,0:12:21.09,Default,,0,0,0,,.فهو كوغورو النانم، في النهاية
Dialogue: 0,0:12:21.57,0:12:23.64,Default,,0,0,0,,.أشك في ذلك
Dialogue: 0,0:12:26.24,0:12:27.69,Default,,0,0,0,,ما كان ذلك الصراخ؟
Dialogue: 0,0:12:27.69,0:12:29.23,Default,,0,0,0,,.كان ذلك صراخًا مخيفًا
Dialogue: 0,0:12:29.53,0:12:31.54,Default,,0,0,0,,.أتى من هنا
Dialogue: 0,0:12:32.98,0:12:35.21,Default,,0,0,0,,...أ-أليس ذلك
Dialogue: 0,0:12:39.13,0:12:40.49,Default,,0,0,0,,...الأنوار الروحية
Dialogue: 0,0:12:42.50,0:12:45.35,Default,,0,0,0,,!الأنوار الروحية تصعد الدرج
Dialogue: 0,0:12:45.99,0:12:47.86,Default,,0,0,0,,!إنها الجمجمة القرمزية
Dialogue: 0,0:12:47.86,0:12:50.03,Default,,0,0,0,,!حمقاء! هذا مستحيل
Dialogue: 0,0:12:58.99,0:13:00.89,Default,,0,0,0,,هيجي، أين الأنوار الروحية؟
Dialogue: 0,0:13:00.89,0:13:03.68,Default,,0,0,0,,هذه هي غرفة الراهب، أليس كذلك؟
Dialogue: 0,0:13:16.95,0:13:19.19,Default,,0,0,0,,ما الأمر؟ ماذا يحدث؟
Dialogue: 0,0:13:19.19,0:13:21.07,Default,,0,0,0,,!أيها العم
Dialogue: 0,0:13:21.07,0:13:23.01,Default,,0,0,0,,!هناك راهب في الداخل
Dialogue: 0,0:13:23.01,0:13:25.33,Default,,0,0,0,,!هناك راهب لا نعرفه على الأرض
Dialogue: 0,0:13:26.38,0:13:29.58,Default,,0,0,0,,!كـ-كانتيتسو؟ إنه كانتيتسو
Dialogue: 0,0:13:29.86,0:13:35.20,Default,,0,0,0,,أهذا هو الراهب الذي اختفى فجأة منذ خمسة أيام؟
Dialogue: 0,0:13:35.20,0:13:36.20,Default,,0,0,0,,.نعم
Dialogue: 0,0:13:36.20,0:13:39.09,Default,,0,0,0,,.يبدو مهزولاً جدًا، لكن أعتقد ذلك
Dialogue: 0,0:13:39.44,0:13:44.33,Default,,0,0,0,,لكن لم يكن هناك أحد هنا عندما أتيت أنا وكنتيتسو إلى هنا سابقًا.
Dialogue: 0,0:13:44.33,0:13:47.60,Default,,0,0,0,,إذًا، هل كانتيتسو بخير؟
Dialogue: 0,0:13:47.60,0:13:49.81,Default,,0,0,0,,.لا، إنه لا يتنفس
Dialogue: 0,0:13:49.81,0:13:52.81,Default,,0,0,0,,.لقد مر يوم تقريبًا منذ وفاته
Dialogue: 0,0:13:53.86,0:13:55.11,Default,,0,0,0,,أما بالنسبة لسبب الوفاة
Dialogue: 0,0:13:55.56,0:14:02.11,Default,,0,0,0,,...استنادًا إلى عينيه الغائرتين، وشفتيه الجافتين، ولحيته الخفيفة
Dialogue: 0,0:14:02.11,0:14:04.55,Default,,0,0,0,,هـ-هل مات جوعًا؟
Dialogue: 0,0:14:04.55,0:14:05.55,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:14:05.55,0:14:07.12,Default,,0,0,0,,...إذا مات جوعًا، إذًا
Dialogue: 0,0:14:09.07,0:14:11.19,Default,,0,0,0,,أنه الجمجمة القرمزية؟
Dialogue: 0,0:14:11.19,0:14:13.79,Default,,0,0,0,,هل امتص روحه؟
Dialogue: 0,0:14:13.79,0:14:15.38,Default,,0,0,0,,.لا أعتقد ذلك
Dialogue: 0,0:14:16.71,0:14:21.76,Default,,0,0,0,,.بناءً على وصف أخي هيجي، يبدو أنه مات بسبب الجفاف
Dialogue: 0,0:14:21.76,0:14:27.64,Default,,0,0,0,,.على الأرجح أن هذا الشخص حُبس في مكان ما دون طعام أو ماء لمدة أربعة أيام تقريبًا
Dialogue: 0,0:14:28.15,0:14:32.52,Default,,0,0,0,,.بالإضافة إلى ذلك، هناك علامات تدل على أن فمه كان مغطى بشريط لاصق
Dialogue: 0,0:14:33.23,0:14:37.77,Default,,0,0,0,,.يعني أن الجاني لم يرد منه أن يتحدث أثناء احتجازه
Dialogue: 0,0:14:38.10,0:14:41.45,Default,,0,0,0,,الوحش لن يستخدم شريطًا لاصقًا، أليس كذلك؟
Dialogue: 0,0:14:41.45,0:14:42.78,Default,,0,0,0,,.أنت محق
Dialogue: 0,0:14:43.15,0:14:48.83,Default,,0,0,0,,.والسماء تمطر بالخارج، لكن الجثة جافة تمامًا
Dialogue: 0,0:14:48.83,0:14:52.98,Default,,0,0,0,,إذا لم يكن هناك شيء هنا عندما أتوا لتنظيف هذه الغرفة سابقًا
Dialogue: 0,0:14:53.55,0:15:00.64,Default,,0,0,0,,فإذًا أحدكم الثلاثة حبس السيد كانتيتسو في مكان ما في هذا المعبد، وقتله
Dialogue: 0,0:15:00.64,0:15:06.29,Default,,0,0,0,,.وحمل الجثة صعودًا على الدرج إلى هذه الغرفة
Dialogue: 0,0:15:08.10,0:15:12.42,Default,,0,0,0,,.ألقيت نظرة سريعة ولم أرى أي أبواب خفية
Dialogue: 0,0:15:18.54,0:15:20.44,Default,,0,0,0,,.إنها تعويذتي الخاصة
Dialogue: 0,0:15:20.44,0:15:22.46,Default,,0,0,0,,ما الذي أتى بها هنا؟
Dialogue: 0,0:15:23.38,0:15:26.05,Default,,0,0,0,,.في الوقت الحالي، ربما ينبغي علينا الاتصال بالشرطة
Dialogue: 0,0:15:26.05,0:15:26.99,Default,,0,0,0,,.نعم
Dialogue: 0,0:15:26.99,0:15:28.95,Default,,0,0,0,,.سأفعل ذلك
Dialogue: 0,0:15:35.38,0:15:37.93,Default,,0,0,0,,...يالهي، لقد تبلل الدرج
Dialogue: 0,0:15:37.93,0:15:39.31,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:15:39.31,0:15:40.46,Default,,0,0,0,,.نـ-نعم
Dialogue: 0,0:15:40.46,0:15:44.51,Default,,0,0,0,,.هذا غريب. اعتقدت أنني أفرغت دلو التنظيف
Dialogue: 0,0:15:44.51,0:15:46.94,Default,,0,0,0,,.على أي حال، ابق هادئًا واتصل بالشرطة
Dialogue: 0,0:15:46.94,0:15:47.84,Default,,0,0,0,,.نعم
Dialogue: 0,0:15:48.51,0:15:54.22,Default,,0,0,0,,.سأقفل هذه الغرفة حتى وصول الشرطة للحفاظ على مكان الجريمة
Dialogue: 0,0:15:54.51,0:15:58.12,Default,,0,0,0,,بما أنني غريب، سأحتفظ بالمفتاح. هل هذا مقبول؟
Dialogue: 0,0:15:58.12,0:15:59.44,Default,,0,0,0,,.نعم
Dialogue: 0,0:15:59.44,0:16:02.42,Default,,0,0,0,,.نحن بحاجة إلى العثور على ذلك المحقق المسن أيضًا
Dialogue: 0,0:16:02.42,0:16:04.82,Default,,0,0,0,,.لقد نسيت
Dialogue: 0,0:16:04.82,0:16:06.97,Default,,0,0,0,,.هناك شيء بجانب الجثة
Dialogue: 0,0:16:07.53,0:16:09.99,Default,,0,0,0,,خشب؟ هل هذه نشارة خشب؟
Dialogue: 0,0:16:10.59,0:16:12.24,Default,,0,0,0,,.هيا يا كونان
Dialogue: 0,0:16:12.24,0:16:13.15,Default,,0,0,0,,.لنذهب
Dialogue: 0,0:16:13.15,0:16:14.24,Default,,0,0,0,,.حسناً
Dialogue: 0,0:16:19.28,0:16:20.35,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:16:20.35,0:16:22.00,Default,,0,0,0,,أين أنا؟
Dialogue: 0,0:16:23.76,0:16:27.00,Default,,0,0,0,,.أعتقد أنني رأيت شيئًا في غرفة العقاب
Dialogue: 0,0:16:27.00,0:16:28.76,Default,,0,0,0,,...أتذكر هذا فقط، لكن
Dialogue: 0,0:16:29.36,0:16:32.76,Default,,0,0,0,,.فقط ذراعيَّ ومعصميَّ مقيدان
Dialogue: 0,0:16:34.65,0:16:36.27,Default,,0,0,0,,.هناك شيء على الأرض
Dialogue: 0,0:16:38.80,0:16:41.27,Default,,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:16:41.64,0:16:43.53,Default,,0,0,0,,!يوجد مجموعة منها
Dialogue: 0,0:16:44.97,0:16:48.50,Default,,0,0,0,,بجدية، ما هذا المكان؟
Dialogue: 0,0:16:51.11,0:16:55.54,Default,,0,0,0,,ماذا؟ الشرطة لا تستطيع الحضور فورًا بسبب المطر؟
Dialogue: 0,0:16:55.54,0:16:56.87,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:16:56.87,0:16:59.83,Default,,0,0,0,,.نعم. الطرق موحلة جدًا
Dialogue: 0,0:16:59.83,0:17:02.14,Default,,0,0,0,,.سوف يستغرق الأمر ساعة أخرى على الأقل
Dialogue: 0,0:17:02.14,0:17:05.02,Default,,0,0,0,,إذًا بينما ننتظر الشرطة
Dialogue: 0,0:17:05.02,0:17:06.77,Default,,0,0,0,,لمَ لا تخبروني بالتفاصيل؟
Dialogue: 0,0:17:06.77,0:17:12.05,Default,,0,0,0,,.قلتم أن شخصًا ما رأى أنوارًا روحية وجثة في الغابة
Dialogue: 0,0:17:13.25,0:17:17.07,Default,,0,0,0,,.حدث ذلك منذ حوالي شهر في المساء
Dialogue: 0,0:17:17.96,0:17:22.81,Default,,0,0,0,,أحد المتنزهين الذي كان يمر بالدرج الحجري في الغابة المجاورة
Dialogue: 0,0:17:22.81,0:17:25.32,Default,,0,0,0,,.رأى أنوارًا روحية تصعد الدرج
Dialogue: 0,0:17:25.59,0:17:30.55,Default,,0,0,0,,...تسلق الدرج الحجري بخوف ووجد
Dialogue: 0,0:17:33.64,0:17:37.33,Default,,0,0,0,,.جثة محروقة على الأرض
Dialogue: 0,0:17:37.33,0:17:40.63,Default,,0,0,0,,هل تم التعرف على الجثة؟
Dialogue: 0,0:17:40.63,0:17:42.83,Default,,0,0,0,,.نعم. لقد ظهر في الأخبار
Dialogue: 0,0:17:42.83,0:17:48.48,Default,,0,0,0,,.بناءً على سجلات الأسنان، تم التعرف عليه بأنه موراتا جون، باحث في التماثيل البوذية
Dialogue: 0,0:17:48.48,0:17:51.08,Default,,0,0,0,,حتى أنه أتى إلى هذا المعبد، أليس كذلك؟
Dialogue: 0,0:17:51.08,0:17:55.47,Default,,0,0,0,,.نعم. لقد اشتكى عندما رأى تمثال كانون الخاص بنا
Dialogue: 0,0:17:55.47,0:17:56.72,Default,,0,0,0,,اشتكى؟
Dialogue: 0,0:17:57.23,0:18:00.35,Default,,0,0,0,,.قال إنه لا يلهمه للعبادة
Dialogue: 0,0:18:00.35,0:18:03.38,Default,,0,0,0,,أهو حقا تمثال سيء إلى هذا الحد؟
Dialogue: 0,0:18:03.38,0:18:05.36,Default,,0,0,0,,!لا، بالطبع لا
Dialogue: 0,0:18:05.74,0:18:08.95,Default,,0,0,0,,.ذلك التمثال كانون منحوت من قبل النحات من عصر كاماكورا دوكي
Dialogue: 0,0:18:08.95,0:18:12.86,Default,,0,0,0,,.حتى أنه يُعتبر مرشحًا ليصبح من الممتلكات الثقافية الهامة
Dialogue: 0,0:18:12.86,0:18:15.94,Default,,0,0,0,,.لكن ذلك الرجل انتقده
Dialogue: 0,0:18:15.94,0:18:18.13,Default,,0,0,0,,.لا بد أنه عوقب على ذلك
Dialogue: 0,0:18:18.13,0:18:22.60,Default,,0,0,0,,.بالمناسبة، قال إنه يريد التحدث معك لاحقًا
Dialogue: 0,0:18:22.60,0:18:24.52,Default,,0,0,0,,ماذا قال؟
Dialogue: 0,0:18:24.52,0:18:27.51,Default,,0,0,0,,.لم يظهر بعد ذلك
Dialogue: 0,0:18:28.61,0:18:33.13,Default,,0,0,0,,على أي حال، هل يمكننا إلقاء نظرة على ذلك التمثال؟
Dialogue: 0,0:18:33.61,0:18:37.64,Default,,0,0,0,,!أبي! إذا كنت هناك، قل شيئًا
Dialogue: 0,0:18:38.11,0:18:42.39,Default,,0,0,0,,!إذا كنت تختبئ في مكان ما، توقف عن معاملتنا هكذا واخرج
Dialogue: 0,0:18:42.91,0:18:46.74,Default,,0,0,0,,مهلا، يا ران. لمَ لا تحاولين الاتصال به مرة أخرى؟
Dialogue: 0,0:18:46.74,0:18:47.90,Default,,0,0,0,,.صحيح
Dialogue: 0,0:18:51.24,0:18:52.38,Default,,0,0,0,,.تبًا
Dialogue: 0,0:18:52.38,0:18:54.98,Default,,0,0,0,,.هاتفي يرن، لكن لا يمكنني الإجابة
Dialogue: 0,0:18:56.14,0:19:00.21,Default,,0,0,0,,هل هذا يعني أن هاتفي لم يُؤخذ مني؟
Dialogue: 0,0:19:00.21,0:19:03.97,Default,,0,0,0,,.من حبسني هنا لا بد كان مستعجلًا
Dialogue: 0,0:19:03.97,0:19:05.89,Default,,0,0,0,,.إنه في جيبي الخلفي
Dialogue: 0,0:19:05.89,0:19:07.93,Default,,0,0,0,,.يجب أن أتمكن من إخراجه
Dialogue: 0,0:19:11.67,0:19:20.18,Default,,0,0,0,,.حسنًا، الآن أنا فقط بحاجة لإحضار هاتفي إلى حيث أستطيع رؤيته
Dialogue: 0,0:19:22.93,0:19:24.74,Default,,0,0,0,,...تشغيل الكاميرا
Dialogue: 0,0:19:27.09,0:19:33.23,Default,,0,0,0,,...وإرسال الصورة إلى ران
Dialogue: 0,0:19:37.03,0:19:39.83,Default,,0,0,0,,.هذا تمثال جميل جدًا
Dialogue: 0,0:19:39.83,0:19:41.95,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:19:42.53,0:19:46.71,Default,,0,0,0,,.نحن ممتنون لوجود هذا التمثال هنا على مر الأجيال
Dialogue: 0,0:19:54.30,0:19:56.47,Default,,0,0,0,,من هوكايدو إلى أوكيناوا
Dialogue: 0,0:19:56.80,0:20:01.57,Default,,0,0,0,,.الكثير من الناس يتسلقون إلى هنا لرؤية هذا التمثال
Dialogue: 0,0:20:01.57,0:20:05.91,Default,,0,0,0,,.لا بد أنه ذات قيمة كبيرة
Dialogue: 0,0:20:05.91,0:20:09.38,Default,,0,0,0,,بالمناسبة، أين يُحفظ هذا التمثال؟
Dialogue: 0,0:20:09.38,0:20:11.78,Default,,0,0,0,,.نضعه في خزنة كل يوم
Dialogue: 0,0:20:11.78,0:20:13.69,Default,,0,0,0,,.نحن الأربعة نتبادل الأدوار
Dialogue: 0,0:20:13.69,0:20:16.09,Default,,0,0,0,,...حسنًا، منذ أن اختفى كانتيتسو
Dialogue: 0,0:20:16.09,0:20:17.49,Default,,0,0,0,,.كنا نحن الثلاثة فقط
Dialogue: 0,0:20:17.84,0:20:21.66,Default,,0,0,0,,.لا تقلق. هذا هو الأسبوع الأخير
Dialogue: 0,0:20:32.75,0:20:36.29,Default,,0,0,0,,.تبًا. إنها تمطر حقًا
Dialogue: 0,0:20:36.29,0:20:41.01,Default,,0,0,0,,.كنت أريد حل القضية وإخبار كازوها بمشاعري أمام منظر جميل
Dialogue: 0,0:20:41.80,0:20:44.98,Default,,0,0,0,,.لكنني ما زلت غير قادر على حل القضية. لذا أشك في أن ذلك سيحدث الآن
Dialogue: 0,0:20:45.44,0:20:47.37,Default,,0,0,0,,هل المطر يزعجك؟
Dialogue: 0,0:20:47.37,0:20:50.92,Default,,0,0,0,,.ليس كذلك. كنت أفكر فقط أنها لم تتوقف
Dialogue: 0,0:20:50.92,0:20:54.26,Default,,0,0,0,,.قال الراهب أنها ستتوقف بحلول هذا المساء
Dialogue: 0,0:20:54.26,0:20:59.03,Default,,0,0,0,,.وغروب الشمس في هذا المعبد جوهرة خفية
Dialogue: 0,0:20:59.03,0:21:00.76,Default,,0,0,0,,!حقًا؟
Dialogue: 0,0:21:00.76,0:21:01.95,Default,,0,0,0,,.نعم
Dialogue: 0,0:21:01.95,0:21:04.03,Default,,0,0,0,,.إنه واضح جدًا
Dialogue: 0,0:21:05.19,0:21:10.65,Default,,0,0,0,,.على أي حال، إذا كان بإمكاننا رؤية غروب الشمس من هنا، فمن الأفضل أن نحل هذه القضية قريبًا
Dialogue: 0,0:21:10.65,0:21:14.82,Default,,0,0,0,,.أنا متأكد من أن المحقق المسن سيرغب في رؤية غروب الشمس، لذا من الأفضل أن نبحث عنه
Dialogue: 0,0:21:15.93,0:21:19.64,Default,,0,0,0,,بالحديث عن البحث، هل وجدت تعويذتك؟
Dialogue: 0,0:21:20.26,0:21:23.13,Default,,0,0,0,,.نعم. كانت في غرفة العقاب
Dialogue: 0,0:21:23.13,0:21:25.82,Default,,0,0,0,,ماذا؟ في الغرفة التي بها الجثة؟
Dialogue: 0,0:21:25.82,0:21:27.06,Default,,0,0,0,,...بخصوص ذلك
Dialogue: 0,0:21:27.77,0:21:33.05,Default,,0,0,0,,.كانت ممتدة في خط رفيع هكذا
Dialogue: 0,0:21:33.05,0:21:36.56,Default,,0,0,0,,.بسبب ذلك، لم ألاحظها حتى دست عليها
Dialogue: 0,0:21:38.09,0:21:40.79,Default,,0,0,0,,إنها ملطخة. لماذا؟
Dialogue: 0,0:21:41.40,0:21:43.80,Default,,0,0,0,,.ربما لأنك دست عليها
Dialogue: 0,0:21:43.80,0:21:48.73,Default,,0,0,0,,.لقد لاحظت سابقًا، لكن أسفل جواربك ملطخ
Dialogue: 0,0:21:50.23,0:21:52.33,Default,,0,0,0,,.حسنًا، جواربك أيضًا
Dialogue: 0,0:21:52.33,0:21:54.47,Default,,0,0,0,,ماذا؟ حقًا؟
Dialogue: 0,0:21:54.83,0:21:56.42,Default,,0,0,0,,لكن أين؟
Dialogue: 0,0:21:56.42,0:21:58.11,Default,,0,0,0,,أين تلطخت؟
Dialogue: 0,0:22:01.14,0:22:02.54,Default,,0,0,0,,!كان ذلك حينها
Dialogue: 0,0:22:02.54,0:22:05.60,Default,,0,0,0,,.عندما ركضنا صاعدين الدرج بعد الأنوار الروحية
Dialogue: 0,0:22:08.10,0:22:09.96,Default,,0,0,0,,رسالة؟
Dialogue: 0,0:22:10.87,0:22:12.04,Default,,0,0,0,,!إنها من المسن
Dialogue: 0,0:22:12.04,0:22:13.34,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:22:13.34,0:22:15.05,Default,,0,0,0,,.الرسالة فارغة
Dialogue: 0,0:22:15.05,0:22:17.01,Default,,0,0,0,,.لكن هناك صورة مرفقة
Dialogue: 0,0:22:17.61,0:22:19.68,Default,,0,0,0,,!مـ-ما هذا؟
Dialogue: 0,0:22:20.44,0:22:21.84,Default,,0,0,0,,.فهمت
Dialogue: 0,0:22:21.84,0:22:23.61,Default,,0,0,0,,.إذًا هكذا هو الأمر
Dialogue: 0,0:23:45.03,0:23:47.38,Default,,0,0,0,,!أبي
Dialogue: 0,0:23:47.38,0:23:49.03,Default,,0,0,0,,!أيها العم
Dialogue: 0,0:23:56.54,0:23:57.79,Default,,0,0,0,,.كازوها
Dialogue: 0,0:23:57.79,0:23:59.06,Default,,0,0,0,,.هيجي
Dialogue: 0,0:24:00.27,0:24:03.80,Default,,0,0,0,,لقد أحضرتِ الجهاز اللوحي، أليس كذلك؟
Dialogue: 0,0:24:09.79,0:24:14.68,Default,,0,0,0,,"!الحلقة القادمة من كونان هي "الجمجمة القرمزية في جبل واشيو - الجزء الثاني
Dialogue: 0,0:24:30.73,0:24:32.66,Default,,0,0,0,,!تلميح كونان القادم
Dialogue: 0,0:24:32.66,0:24:34.34,Default,,0,0,0,,!غروب الشمس
Dialogue: 0,0:24:34.99,0:24:37.45,Default,,0,0,0,,{\an8}!أراهن أنه غروب شمس بقيمة مليون دولار
Dialogue: 0,0:24:37.45,0:24:38.50,Default,,0,0,0,,{\an8}أتسمع ذلك، هاتوري؟
