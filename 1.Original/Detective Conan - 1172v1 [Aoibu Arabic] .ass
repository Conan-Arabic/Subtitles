Dialogue: 0,0:06:42.27,0:06:46.03,Default,,0,0,0,,ج-ا-ر-ب
Dialogue: 0,0:06:46.65,0:06:47.53,Default,,0,0,0,,جارب؟
Dialogue: 0,0:06:47.90,0:06:48.74,Default,,0,0,0,,مالوضع؟
Dialogue: 0,0:06:49.03,0:06:50.20,Default,,0,0,0,,هل اقتربت من إيجاده؟
Dialogue: 0,0:06:50.70,0:06:52.20,Default,,0,0,0,,انتظر قليلًا
Dialogue: 0,0:06:54.99,0:06:58.83,Default,,0,0,0,,لم أجد أي شيء في كلا الجوربين
Dialogue: 0,0:07:00.29,0:07:01.00,Default,,0,0,0,,ماهذا
Dialogue: 0,0:07:01.50,0:07:03.34,Default,,0,0,0,,هناك علامة غريبة فالقدم اليمنى
Dialogue: 0,0:07:05.38,0:07:07.80,Default,,0,0,0,,إنها علامة بطاقة الذاكرة على ما أظن
Dialogue: 0,0:07:08.84,0:07:10.68,Default,,0,0,0,,أين قد يمكن أن تكون؟
Dialogue: 0,0:07:11.43,0:07:12.93,Default,,0,0,0,,ياسيد خادم
Dialogue: 0,0:07:14.26,0:07:17.77,Default,,0,0,0,,نريد أن نطلب شرابًا هل أجلب لك أيضًا؟
Dialogue: 0,0:07:18.43,0:07:19.93,Default,,0,0,0,,إن كنت تريد
Dialogue: 0,0:07:22.06,0:07:24.02,Default,,0,0,0,,فاختر من هذه القائمة
Dialogue: 0,0:07:25.22,0:07:28.76,sign_1172_phone_text_message,SIGN,0,0,0,,{\an1\move(299,296,299,-20)\3c&HE8CA83&\bord2} إيدوغاوا كونان  
Dialogue: 0,0:07:26.17,0:07:29.34,sign_1172_phone_text_message,SIGN,0,0,0,,{\an7\move(250,350,250,70)\3c&HFFFEFF&\bord3\4c&H5D412C&\fad(1,200)}،أنت تبحث عن هذا\N صحيح؟
Dialogue: 0,0:07:32.99,0:07:34.87,Default,,0,0,0,,يبدو أن العصير لذيذ
Dialogue: 0,0:07:35.95,0:07:38.75,Default,,0,0,0,,ياهذا اختر أي شيء واصرفه
Dialogue: 0,0:07:39.41,0:07:40.66,Default,,0,0,0,,حسنًا إذا سأطلبه
Dialogue: 0,0:07:42.29,0:07:44.88,Default,,0,0,0,,ان اخترت العصير فهناك أنواع
Dialogue: 0,0:07:46.59,0:07:47.71,Default,,0,0,0,,مارأيك بهذا؟
Dialogue: 0,0:07:49.38,0:07:50.63,Default,,0,0,0,,إن كان كذلك
Dialogue: 0,0:07:50.88,0:07:53.84,Default,,0,0,0,,هل ستقوم بالإجابة على ما سأسألك؟
Dialogue: 0,0:07:56.64,0:07:57.85,Default,,0,0,0,,أجل سأطلب هذا
Dialogue: 0,0:08:02.52,0:08:04.48,Default,,0,0,0,,هل أنت متأكد أن هذا ماتريد؟
Dialogue: 0,0:08:05.15,0:08:07.36,Default,,0,0,0,,تفحص القائمة جيدًا
Dialogue: 0,0:08:08.15,0:08:10.86,Default,,0,0,0,,إذًا أرني أنواعًا أخرى
Dialogue: 0,0:08:11.09,0:08:11.30,sign_1172_phone_text_message,SIGN,0,0,0,,{\an9\3c&HFFFEFF&\fs24\bord3\4c&H5D412C&\fad(1,200)\pos(600,20)}،إذا كان الأمر كذلك\Nهل يمكنك الإجابة على أسئلتي؟  
Dialogue: 0,0:08:11.09,0:08:17.02,sign_1172_phone_text_message,SIGN,0,0,0,,{\an7\fs24\3c&HE8CA83&\bord3\pos(40,20)} إيدوغاوا كونان  
Dialogue: 0,0:08:11.30,0:08:17.02,sign_1172_phone_text_message,SIGN,0,0,0,,{\an9\3c&HFFFEFF&\fs24\bord3\4c&H5D412C&\fad(200,1)\pos(600,20)}سيد إيوري، هناك من يهددك\Nأليس كذلك؟ ،USB للبحث عن ذاكرة 
Dialogue: 0,0:08:11.82,0:08:16.62,Default,,0,0,0,,سيد (إيوري) لقد قامو بتهديدك للبحث عن بطاقة الذاكرة صحيح؟
Dialogue: 0,0:08:17.37,0:08:19.87,Default,,0,0,0,,أجل ,هذا أيضًا جيد
Dialogue: 0,0:08:20.15,0:08:20.27,sign_1172_phone_text_message,SIGN,0,0,0,,{\an9\3c&HFFFEFF&\fs24\bord3\4c&H5D412C&\fad(1,100)\pos(600,20)}سيد إيوري، هناك من يهددك\Nأليس كذلك؟ ،USB للبحث عن ذاكرة 
Dialogue: 0,0:08:20.15,0:08:23.02,sign_1172_phone_text_message,SIGN,0,0,0,,{\an7\fs24\3c&HE8CA83&\bord3\pos(40,20)} إيدوغاوا كونان  
Dialogue: 0,0:08:20.27,0:08:23.02,sign_1172_phone_text_message,SIGN,0,0,0,,{\an9\3c&HFFFEFF&\fs24\bord3\4c&H5D412C&\fad(200,1)\pos(600,20)}...والشخص الذي يهددك هو
Dialogue: 0,0:08:20.62,0:08:22.62,Default,,0,0,0,,..والذين قامو بتهديدك هم
Dialogue: 0,0:08:23.58,0:08:26.04,Default,,0,0,0,,الشخص الذي مقعده خلف أخي (هيجي)
Dialogue: 0,0:08:26.46,0:08:28.75,Default,,0,0,0,,ويحمل سكينًا ملطخة بالدماء؟
Dialogue: 0,0:08:31.84,0:08:34.38,Default,,0,0,0,,نعم وهذا أيضًا يبدو لذيذًا
Dialogue: 0,0:08:34.54,0:08:34.74,sign_1172_phone_text_message,SIGN,0,0,0,,{\an9\3c&HFFFEFF&\fs24\bord3\4c&H5D412C&\fad(1,100)\pos(600,20)}الرجل ذو السكين الدموي\Nالجالس خلف أخي هيجي 
Dialogue: 0,0:08:34.54,0:08:37.54,sign_1172_phone_text_message,SIGN,0,0,0,,{\an7\fs24\3c&HE8CA83&\bord3\pos(40,20)} إيدوغاوا كونان  
Dialogue: 0,0:08:34.74,0:08:37.54,sign_1172_phone_text_message,SIGN,0,0,0,,{\an9\3c&HFFFEFF&\fs24\bord3\4c&H5D412C&\fad(200,1)\pos(600,20)}...وهناك من يراقبك
Dialogue: 0,0:08:35.01,0:08:37.97,Default,,0,0,0,,وأثناء مراقبتهم لك
Dialogue: 0,0:08:38.22,0:08:40.56,Default,,0,0,0,,هم يملون عليك الأوامر من خلال سماعة صحيح؟
Dialogue: 0,0:08:41.27,0:08:44.10,Default,,0,0,0,,أجل هناك عصائر كهذه أيضًا
Dialogue: 0,0:08:45.15,0:08:47.56,Default,,0,0,0,,حاليًا نريد القبض على هؤلاء الاثنين
Dialogue: 0,0:08:47.94,0:08:50.11,Default,,0,0,0,,لذا هل ستشاركنا في خطتنا؟
Dialogue: 0,0:08:50.69,0:08:51.32,Default,,0,0,0,,اجل
Dialogue: 0,0:08:51.78,0:08:52.99,Default,,0,0,0,,سأختار هذا
Dialogue: 0,0:08:53.95,0:08:58.45,Default,,0,0,0,,إذا, سيقوم أخي (هيجي) برفع يده كإشارة عندما ننتهي من التحضيرات
Dialogue: 0,0:08:58.81,0:09:03.81,sign_1172_phone_text_message,SIGN,0,0,0,,{\an7\fs14\3c&HE8CA83&\bord2\shad1\pos(40,20)\4c&HE8CA83&} إيدوغاوا كونان\N\N{\3c&HFFFEFF&}حتى ذلك الحين،\NUSB خذ هذه ذاكرة\N...وفعل كما يقول المجرم
Dialogue: 0,0:08:59.53,0:09:00.37,Default,,0,0,0,,إلى ذاك الحين
Dialogue: 0,0:09:00.54,0:09:03.66,Default,,0,0,0,,قم بأخذ بطاقة الذاكرة هذه واستمر بالاستماع للجناة
Dialogue: 0,0:09:08.54,0:09:11.21,Default,,0,0,0,,توقف عن المطالة في اختيارك
Dialogue: 0,0:09:11.38,0:09:14.01,Default,,0,0,0,,اختر بسرعة واصرف الولد سريعًا
Dialogue: 0,0:09:14.34,0:09:15.68,Default,,0,0,0,,وإلا
Dialogue: 0,0:09:16.13,0:09:22.97,Default,,0,0,0,,فرأس آنستك المبجلة (موميجي) سيفصل عن جسدها
Dialogue: 0,0:09:23.64,0:09:27.19,Default,,0,0,0,,لابأس فلقد حصلت على بطاقة الذاكرة
Dialogue: 0,0:09:27.69,0:09:28.69,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:09:29.06,0:09:31.07,Default,,0,0,0,,إذا كما أمرتك
Dialogue: 0,0:09:31.32,0:09:36.03,Default,,0,0,0,,ضعها على المغسلة الواقعة بين المقطورة الثالثة عشر والرابعة عشر
Dialogue: 0,0:09:48.04,0:09:49.75,Default,,0,0,0,,وضعتها ,والآن؟
Dialogue: 0,0:09:50.50,0:09:54.21,Default,,0,0,0,,فلتعد إلى الكرسي المجاور للجثة
Dialogue: 0,0:10:16.78,0:10:19.07,Default,,0,0,0,,!حسنٌ ,فلتبدأ الخطة
Dialogue: 0,0:10:32.59,0:10:33.92,Default,,0,0,0,,..حسنٌ, أولا
Dialogue: 0,0:10:33.95,0:10:41.29,sign_1172_phone_text_message,SIGN,0,0,0,,{\an9\fs20\3c&HE8CA83&\bord2\shad1\pos(600,20)\4c&HE8CA83&} إيدوغاوا كونان\N\N{\3c&HFFFEFF&}عندما يعطي اخي هيجي الإشارة،\Nهل يمكنك التحدث تدريجيًا\Nبصوت أهدأ تجاه المجرم؟
Dialogue: 0,0:10:34.96,0:10:36.92,Default,,0,0,0,,عندما يقوم أخي (هيجي) بالإشارة
Dialogue: 0,0:10:37.22,0:10:41.01,Default,,0,0,0,,هل يمكنك اخفاض صوتك تدريجيًا عند التحدث للجاني؟
Dialogue: 0,0:10:41.93,0:10:45.14,Default,,0,0,0,,صحيح, هناك مشكلة صغير في بطاقة الذاكرة
Dialogue: 0,0:10:45.43,0:10:46.56,Default,,0,0,0,,مشكلة؟
Dialogue: 0,0:10:47.06,0:10:49.10,Default,,0,0,0,,..الجزء الداخلي للبطاقة
Dialogue: 0,0:10:51.19,0:10:52.15,Default,,0,0,0,,..الاتصال
Dialogue: 0,0:10:52.52,0:10:54.36,Default,,0,0,0,,مالذي تقوله؟
Dialogue: 0,0:10:56.15,0:10:57.40,Default,,0,0,0,,!لا أسمعك
Dialogue: 0,0:10:58.99,0:11:01.49,Default,,0,0,0,,فلترفع صوتك أكثر
Dialogue: 0,0:11:03.07,0:11:04.28,Default,,0,0,0,,!هأنتذا
Dialogue: 0,0:11:06.33,0:11:07.66,Default,,0,0,0,,كازوها, لا بأس الآن
Dialogue: 0,0:11:08.04,0:11:09.12,Default,,0,0,0,,!افعليها
Dialogue: 0,0:11:09.62,0:11:10.21,Default,,0,0,0,,حسنًا
Dialogue: 0,0:11:14.09,0:11:15.96,Default,,0,0,0,,!فهمت
Dialogue: 0,0:11:26.22,0:11:28.56,Default,,0,0,0,,أيها العم , سأستعيرها قليلًا
Dialogue: 0,0:11:30.39,0:11:32.10,Default,,0,0,0,,من أنت ياهذا؟
Dialogue: 0,0:11:34.19,0:11:35.11,Default,,0,0,0,,أنا؟
Dialogue: 0,0:11:35.82,0:11:37.36,Default,,0,0,0,,أنا (هاتوري هيجي)
Dialogue: 0,0:11:38.99,0:11:40.24,Default,,0,0,0,,!محقق
Dialogue: 0,0:11:42.28,0:11:43.24,Default,,0,0,0,,محقق؟
Dialogue: 0,0:11:44.16,0:11:45.95,Default,,0,0,0,,!أيها الصعلوك
Dialogue: 0,0:11:50.54,0:11:52.37,Default,,0,0,0,,!مُت
Dialogue: 0,0:12:16.56,0:12:19.23,Default,,0,0,0,,أعتذر على الإزعاج
Dialogue: 0,0:12:20.11,0:12:20.99,Default,,0,0,0,,!هيجي
Dialogue: 0,0:12:21.99,0:12:22.74,Default,,0,0,0,,مالذي جرى؟
Dialogue: 0,0:12:23.20,0:12:25.35,Default,,0,0,0,,.أمسكنا بالرجل
Dialogue: 0,0:12:25.35,0:12:26.89,Default,,0,0,0,,.وأنا كذلك
Dialogue: 0,0:12:27.31,0:12:28.96,Default,,0,0,0,,.شكراً، كازوها
Dialogue: 0,0:12:30.18,0:12:33.90,Default,,0,0,0,,.يبدو أن الجناة كانوا اثنين فقط
Dialogue: 0,0:12:34.61,0:12:36.43,Default,,0,0,0,,حسنًا، أيها الخادم؟
Dialogue: 0,0:12:36.43,0:12:38.90,Default,,0,0,0,,بامان ، أليس كذلك USB ذاكرة الـ 
Dialogue: 0,0:12:39.43,0:12:44.12,Default,,0,0,0,,.الذي تركته على الحوض اختفى USB في الواقع، ذاكرة الـ 
Dialogue: 0,0:12:44.12,0:12:45.66,Default,,0,0,0,,!مستحيل
Dialogue: 0,0:12:45.66,0:12:50.36,Default,,0,0,0,,.لم يغادر أي راكب هذا القطار بعد عودتك
Dialogue: 0,0:12:51.07,0:12:55.48,Default,,0,0,0,,.قالت كازوها إنه لم يدخل أو يخرج أحد من القطار أيضًا
Dialogue: 0,0:12:56.35,0:12:57.86,Default,,0,0,0,,ركاب؟
Dialogue: 0,0:12:58.52,0:13:01.80,Default,,0,0,0,,...بالمناسبة، تلك البائعة قبل قليل
Dialogue: 0,0:13:02.78,0:13:09.31,Default,,0,0,0,,عادةً، ينحني البائعون أمام الركاب\N.عند دخولهم أو خروجهم من القطار
Dialogue: 0,0:13:13.31,0:13:15.67,Default,,0,0,0,,.لكنها لم تفعل ذلك
Dialogue: 0,0:13:18.11,0:13:19.32,Default,,0,0,0,,ايعقل؟
Dialogue: 0,0:13:25.58,0:13:26.58,Default,,0,0,0,,!هذا سيء
Dialogue: 0,0:13:30.22,0:13:31.30,Default,,0,0,0,,.مهلاً
Dialogue: 0,0:13:32.17,0:13:33.51,Default,,0,0,0,,.ابتعدي عنه
Dialogue: 0,0:13:34.83,0:13:35.84,Default,,0,0,0,,من أنتِ؟
Dialogue: 0,0:13:36.98,0:13:38.96,Default,,0,0,0,,.هذا رفيقي
Dialogue: 0,0:13:40.17,0:13:42.93,Default,,0,0,0,,!ابتعدي عنه
Dialogue: 0,0:13:58.96,0:14:00.94,Default,,0,0,0,,!أيها الوغد
Dialogue: 0,0:14:01.63,0:14:06.37,Default,,0,0,0,,!الشر لا ينتصر أبداً
Dialogue: 0,0:14:12.09,0:14:14.12,Default,,0,0,0,,إذن كان هناك واحد آخر، أليس كذلك؟
Dialogue: 0,0:14:14.12,0:14:16.13,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:14:17.07,0:14:18.13,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:14:18.67,0:14:21.63,Default,,0,0,0,,!لا، لا، لا! أرجوك، لا
Dialogue: 0,0:14:21.63,0:14:24.63,Default,,0,0,0,,!لا تمُتْ، إيوري
Dialogue: 0,0:14:26.81,0:14:29.27,Default,,0,0,0,,.أ-أنا بخير
Dialogue: 0,0:14:29.80,0:14:32.64,Default,,0,0,0,,...لكنه عميق جدًا
Dialogue: 0,0:14:42.72,0:14:45.91,Default,,0,0,0,,.أترين؟ أنا بخير
Dialogue: 0,0:14:47.25,0:14:49.17,Default,,0,0,0,,...أنت لا تنزف
Dialogue: 0,0:14:50.98,0:14:52.92,Default,,0,0,0,,.نحن بأمان الآن
Dialogue: 0,0:14:56.04,0:14:57.95,Default,,0,0,0,,لكن كيف؟
Dialogue: 0,0:14:57.95,0:15:04.17,Default,,0,0,0,,.ربما بسبب بطاقات الكاروتا  التي في جيب صدري
Dialogue: 0,0:15:06.81,0:15:10.31,Default,,0,0,0,,.صحيح. السكين اخترقت البطاقات بدلاً من ذلك
Dialogue: 0,0:15:11.63,0:15:14.81,Default,,0,0,0,,.الصغير قد يحل محل الكبير بعد كل شيء
Dialogue: 0,0:15:17.15,0:15:21.47,Default,,0,0,0,,،كل بطاقة صغيرة ورقيقة
Dialogue: 0,0:15:22.76,0:15:26.94,Default,,0,0,0,,.عندما تتكدس كميات كافية منها، تصبح درعًا قويًا ومتينًا
Dialogue: 0,0:15:33.53,0:15:36.48,Default,,0,0,0,,،قد تكون قد نسيته
Dialogue: 0,0:15:37.37,0:15:41.23,Default,,0,0,0,,.لكنني قلت لك ذلك من قبل
Dialogue: 0,0:15:53.35,0:15:54.58,Default,,0,0,0,,من أنتِ؟
Dialogue: 0,0:15:58.28,0:15:59.85,Default,,0,0,0,,فتاة؟
Dialogue: 0,0:16:00.30,0:16:02.63,Default,,0,0,0,,.انا من عليَ أن أطرح عليك هذا السؤال
Dialogue: 0,0:16:03.15,0:16:05.15,Default,,0,0,0,,.أنا أوكا موميجي
Dialogue: 0,0:16:05.15,0:16:07.36,Default,,0,0,0,,ومن أنت؟
Dialogue: 0,0:16:07.36,0:16:08.67,Default,,0,0,0,,موميجي؟
Dialogue: 0,0:16:08.67,0:16:11.12,Default,,0,0,0,,حفيدة رئيس الوزراء السابق أوكا؟
Dialogue: 0,0:16:11.51,0:16:14.47,Default,,0,0,0,,.أنا إيوري، ضابط في الأمن العام
Dialogue: 0,0:16:14.97,0:16:17.55,Default,,0,0,0,,الأمن العام؟ هل أنت ضابط شرطة؟
Dialogue: 0,0:16:17.55,0:16:20.38,Default,,0,0,0,,.نـ-نعم، إلى حدٍ ما
Dialogue: 0,0:16:27.38,0:16:29.13,Default,,0,0,0,,لماذا لم تهربي؟
Dialogue: 0,0:16:29.82,0:16:34.49,Default,,0,0,0,,الرجال السيئون دخلوا بينما\N.كنت أعتني بجروحك
Dialogue: 0,0:16:35.57,0:16:37.11,Default,,0,0,0,,تعتنين بجروحي؟
Dialogue: 0,0:16:44.89,0:16:47.62,Default,,0,0,0,,،يقولون إن الكبير يمكن أن يحل محل الصغير
Dialogue: 0,0:16:47.62,0:16:50.74,Default,,0,0,0,,لكن أحيانًا، يمكن للصغير\N.أن يحل محل الكبير أيضًا
Dialogue: 0,0:16:50.74,0:16:54.85,Default,,0,0,0,,.قال الخدم إن أكواب القياس تعمل بهذه الطريقة
Dialogue: 0,0:16:55.70,0:16:59.75,Default,,0,0,0,,.كان علي أن أستعمل كل الضمادات مع ذلك
Dialogue: 0,0:17:00.26,0:17:04.59,Default,,0,0,0,,.أطفأت منبه ساعتك أيضًا
Dialogue: 0,0:17:04.59,0:17:06.70,Default,,0,0,0,,.كنتَ نائمًا عميقاً
Dialogue: 0,0:17:06.70,0:17:08.51,Default,,0,0,0,,لكن لماذا اعتنيت بجروحي؟
Dialogue: 0,0:17:08.83,0:17:10.45,Default,,0,0,0,,.هذا طبيعي
Dialogue: 0,0:17:11.11,0:17:15.09,Default,,0,0,0,,.وأحتاجك أن تبقى بصحة جيدة حتى تتمكن من حمايتي
Dialogue: 0,0:17:24.87,0:17:27.36,Default,,0,0,0,,كيف لي أن أنسى؟
Dialogue: 0,0:17:30.45,0:17:36.18,Default,,0,0,0,,هذا السبب الذي جعلني أترك مكتب\N.الأمن العام وأصبح خادمكِ
Dialogue: 0,0:17:47.65,0:17:51.88,Default,,0,0,0,,بعد 30 دقيقة، وصل القطار\N،إلى محطة طوكيو
Dialogue: 0,0:17:52.36,0:17:55.64,Default,,0,0,0,,وتم اقتياد الثلاثة جميعًا\Nإلى المقر
Dialogue: 0,0:17:55.64,0:17:59.14,Default,,0,0,0,,بواسطة قوات المفتش ميغوري\N.التي قمت باستدعائها
Dialogue: 0,0:17:59.90,0:18:05.35,Default,,0,0,0,,اتضح أن الجناة مرتبطون\Nبالنائب تسوروجي
Dialogue: 0,0:18:05.35,0:18:09.67,Default,,0,0,0,,.وقاموا بارتكاب هذه الجريمة بأوامره
Dialogue: 0,0:18:10.91,0:18:16.16,Default,,0,0,0,, الذي حاول الجناة USB محتوى ذاكرة الـ \Nسرقته من الكاتب المستقل
Dialogue: 0,0:18:16.68,0:18:23.67,Default,,0,0,0,,كان مقطع فيديو مصوّرًا بهاتف ذكي للسكرتير الذي\Nادّعى مسؤوليته عن رشاوى النائب
Dialogue: 0,0:18:23.67,0:18:28.63,Default,,0,0,0,,.الذي يُقال إنه قفز للموت بعد أن دفعوه الثلاثة
Dialogue: 0,0:18:29.82,0:18:32.68,Default,,0,0,0,,أحد سكان الشقة المقابلة
Dialogue: 0,0:18:32.68,0:18:36.78,Default,,0,0,0,,قرر أن يصور الفيديو\N،لأن الغروب كان جميلاً
Dialogue: 0,0:18:36.78,0:18:40.56,Default,,0,0,0,,وكان النائب تسوروجي مرئيًا بوضوح\N.في الخلفية
Dialogue: 0,0:18:41.62,0:18:47.40,Default,,0,0,0,,من المحتمل أن يُعتقل النائب تسوروجي\Nفي وقت لاحق
Dialogue: 0,0:18:47.40,0:18:49.43,Default,,0,0,0,,.بسبب التواطؤ في جريمة قتل
Dialogue: 0,0:18:51.06,0:18:56.23,Default,,0,0,0,,على أي حال، أعجبتني أنك اكتشفت\N.أنني كنتُ مهدداً
Dialogue: 0,0:18:56.23,0:18:59.95,Default,,0,0,0,,،كان الأمر سهلاً. لم تعود إلى مقعدك
Dialogue: 0,0:19:00.47,0:19:04.96,Default,,0,0,0,,،ولم ترد على مكالمات موميجي\N.فذهبت لأتفقدك
Dialogue: 0,0:19:06.57,0:19:12.21,Default,,0,0,0,,رأيتك ترتدي سماعة غريبة\N.وتحقّق من جسد رجل غريب
Dialogue: 0,0:19:13.27,0:19:16.22,Default,,0,0,0,,.فحصت الجسد بعد مغادرتك
Dialogue: 0,0:19:16.64,0:19:21.54,Default,,0,0,0,,كان مقتولاً، وكان هناك\N.كتابة غريبة على فخذِه
Dialogue: 0,0:19:23.15,0:19:29.73,Default,,0,0,0,,أرسلت صورة إلى كونان، وفهمنا\N.في جواربه USB أنه كان لديه ذاكرة 
Dialogue: 0,0:19:30.23,0:19:36.24,Default,,0,0,0,,استخدمنا جهازًا لوحيًا لتأكيد ما عليه\N.وفهمنا ما الذي يجري
Dialogue: 0,0:19:37.43,0:19:40.24,Default,,0,0,0,,فهمت؟ الأمر بسيط، أليس كذلك؟
Dialogue: 0,0:19:41.74,0:19:43.24,Default,,0,0,0,,!رائع
Dialogue: 0,0:19:43.24,0:19:47.44,Default,,0,0,0,,!أنت حقًا تكون الرجل الذي يليق بالآنسة موميجي
Dialogue: 0,0:19:47.91,0:19:49.88,Default,,0,0,0,,!يا لها من ملاحظة دقيقة
Dialogue: 0,0:19:49.88,0:19:52.13,Default,,0,0,0,,...في الواقع
Dialogue: 0,0:19:52.43,0:19:56.51,Default,,0,0,0,,...أنا من فك رموز الاختصارات
Dialogue: 0,0:19:57.77,0:19:59.01,Default,,0,0,0,,!مهلاً
Dialogue: 0,0:19:59.31,0:20:02.51,Default,,0,0,0,,هاتوري، هل تتركني وحدي أيضًا؟
Dialogue: 0,0:20:02.51,0:20:04.02,Default,,0,0,0,,!انتظروني
Dialogue: 0,0:20:05.04,0:20:07.93,Default,,0,0,0,,.الآن فهمت شعور العجوز
Dialogue: 0,0:20:12.45,0:20:14.24,DCEnding,,0,0,0,,!مرح! مرح! مرح
Dialogue: 0,0:20:16.63,0:20:22.84,DCEnding,,0,0,0,,قلبي ينبض بقوة قلبي ينبض بقوة أنا حقًا فضولي بشأن الحقيقة
Dialogue: 0,0:20:23.04,0:20:29.64,DCEnding,,0,0,0,,هل تحاول؟ من الصعب الكذب، أليس كذلك؟ يا! يا
Dialogue: 0,0:20:29.69,0:20:35.93,DCEnding,,0,0,0,,لاااا، أنا أفقد صوابي! هل من أحد يساعدني؟
Dialogue: 0,0:20:36.13,0:20:41.30,DCEnding,,0,0,0,,(كذبة أم حقيقة؟ لا أستطيع أن أقول (كل شيء أو لا شيء
Dialogue: 0,0:20:41.91,0:20:48.98,DCEnding,,0,0,0,,أنا في غاية الحب معك، أنا في غاية الحب معك
Dialogue: 0,0:20:49.13,0:20:55.67,DCEnding,,0,0,0,,يحب! هذا صحيح! سوف أتعرض لحروق شديدة
Dialogue: 0,0:20:55.83,0:21:03.00,DCEnding,,0,0,0,,تألق، ارقص معي، ارقص، ارقص، ارقص بابتسامة مبهرة
Dialogue: 0,0:21:04.17,0:21:10.34,DCEnding,,0,0,0,,أنسى الأشياء السيئة وأحبها، لا يمكن مساعدتها
Dialogue: 0,0:21:10.63,0:21:16.57,DCEnding,,0,0,0,,أنت وأنا وتلك الفتاة، إذا رقصنا، سنكون جميعًا سعداء
Dialogue: 0,0:21:17.01,0:21:23.18,DCEnding,,0,0,0,,تعال! تعال! أنت تتألق بشكل مشرق اليوم أيضًا
Dialogue: 0,0:21:23.83,0:21:28.82,DCEnding,,0,0,0,,!إنه أمر ممتع عندما يكون الجميع هناك، لذلك دعونا نذهب
Dialogue: 0,0:21:32.83,0:21:34.77,Default,,0,0,0,,ما الأمر، كازامي؟
Dialogue: 0,0:21:34.77,0:21:39.14,Default,,0,0,0,,.اعتقدت أنني رأيت زميلًا من أكاديمية الشرطة
Dialogue: 0,0:21:39.14,0:21:40.53,Default,,0,0,0,,.صحيح
Dialogue: 0,0:21:41.27,0:21:43.53,Default,,0,0,0,,.حدثت مشكلة ما
Dialogue: 0,0:21:43.53,0:21:45.96,Default,,0,0,0,,.لا بد أنه أحد الضباط الذين حضروا لذلك
Dialogue: 0,0:21:46.44,0:21:52.57,Default,,0,0,0,,،في الواقع، كان استثنائيًا وانضم نفس المكتب مثلك
Dialogue: 0,0:21:52.57,0:21:54.64,Default,,0,0,0,,.لكن سمعت أنه استقال
Dialogue: 0,0:21:57.83,0:22:00.12,Default,,0,0,0,,.هنا ينتهي بك الطريق
Dialogue: 0,0:22:00.12,0:22:05.66,Default,,0,0,0,,ألا تستطيع أن تخبرني بمن ستقابل؟
Dialogue: 0,0:22:17.82,0:22:20.82,Default,,0,0,0,,.لـ-لا يوجد أحد هنا
Dialogue: 0,0:22:22.47,0:22:24.83,Default,,0,0,0,,.لكن القطار على وشك المغادرة
Dialogue: 0,0:22:29.15,0:22:30.34,Default,,0,0,0,,هاتف؟
Dialogue: 0,0:22:35.34,0:22:36.54,Default,,0,0,0,,أين هو؟
Dialogue: 0,0:22:39.73,0:22:40.84,Default,,0,0,0,,.ها هو
Dialogue: 0,0:22:45.22,0:22:47.35,Default,,0,0,0,,مرحبا؟
Dialogue: 0,0:22:48.30,0:22:51.22,Default,,0,0,0,,.انظر من النافذة
Dialogue: 0,0:23:02.24,0:23:06.31,Default,,0,0,0,,.تحقق من أمر إيدوغاوا كونان
Dialogue: 0,0:23:07.46,0:23:11.28,Default,,0,0,0,,.حتى نخاع عظامه
Dialogue: 0,0:23:18.10,0:23:20.51,Default,,0,0,0,,.حاضر
Dialogue: 0,0:23:23.73,0:23:25.79,Default,,0,0,0,,.معك فورويا
Dialogue: 0,0:23:25.79,0:23:28.77,Default,,0,0,0,,ما الخطب؟ لماذا لم ترد فورًا؟
Dialogue: 0,0:23:29.54,0:23:32.27,Default,,0,0,0,,.تبدو متحمسًا بعض الشيء
Dialogue: 0,0:23:33.59,0:23:35.77,Default,,0,0,0,,هل حدث شيء؟
Dialogue: 0,0:23:37.06,0:23:38.27,Default,,0,0,0,,.لا
Dialogue: 0,0:23:40.56,0:23:42.15,Default,,0,0,0,,.لا شيء على الإطلاق
Dialogue: 0,0:23:44.94,0:24:08.97,sign_episode_preview,SIGN,0,0,0,,الحلقة القادمة 
Dialogue: 0,0:23:48.74,0:23:51.61,Default,,0,0,0,,!لقد ظهر حقًا
Dialogue: 0,0:23:51.61,0:23:52.74,Default,,0,0,0,,!إنه شبح
Dialogue: 0,0:23:53.29,0:23:55.03,Default,,0,0,0,,.اليوم كان المرة الثالثة
Dialogue: 0,0:23:55.03,0:23:57.12,Default,,0,0,0,,.أعرف ما رأيت
Dialogue: 0,0:23:58.88,0:24:00.88,Default,,0,0,0,,ما هذه الآثار؟
Dialogue: 0,0:24:01.20,0:24:04.13,Default,,0,0,0,,هل يمكننا أن نلقي نظرة في المنزل؟
Dialogue: 0,0:24:04.67,0:24:07.06,Default,,0,0,0,,.إنها كبيرة جدًا
Dialogue: 0,0:24:07.06,0:24:08.97,Default,,0,0,0,,.إنها آثار دائرية
Dialogue: 0,0:24:08.97,0:24:14.97,sign_next_episode,SIGN,0,0,0,,{\pos(320,55)}ظهر الشبح
Dialogue: 0,0:24:09.60,0:24:13.29,Default,,0,0,0,,"!في الحلقة القادمة من كونان هي "ظهر الشبح
Dialogue: 0,0:24:29.99,0:24:34.91,sign_hint,SIGN,0,0,0,,{\pos(320,240)}شوكة
Dialogue: 0,0:24:30.24,0:24:32.57,Default,,0,0,0,, : تلميح كونان القادم 
Dialogue: 0,0:24:32.94,0:24:34.33,Default,,0,0,0,,!شوكة 
Dialogue: 0,0:24:34.91,0:24:39.92,sign_dont_miss,SIGN,0,0,0,,{\pos(245,304)}لا تفوتوا الحلقة القادمة
Dialogue: 0,0:24:34.91,0:24:37.52,Default,,0,0,0,,ستتمكن من المشاهدة على مدار 24 ساعة، أليس كذلك، كازامي؟
Dialogue: 0,0:24:37.52,0:24:38.50,Default,,0,0,0,,.بـ-بالطبع
Dialogue: 0,0:24:38.50,0:24:39.87,Default,,0,0,0,,تقصد برنامج الأسبوع القادم؟
