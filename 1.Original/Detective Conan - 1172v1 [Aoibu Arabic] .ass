Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)}Iy nasan & ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS & @Iy_ nasan\NX : @Theconansign
Dialogue: 0,0:00:05.38,0:00:10.51,Default,,0,0,0,,(هاتوري) (كازوها) (موميجي) الذين ركبو قطار الطلقة للذهاب إلى طوكيو
Dialogue: 0,0:00:12.26,0:00:15.55,Default,,0,0,0,,عندما ذهب خادم (موميجي) السيد (إيوري) إلى الحمام
Dialogue: 0,0:00:16.68,0:00:20.43,Default,,0,0,0,,أُخذت (موميجي) كرهينة لقاءَ طلب معين
Dialogue: 0,0:00:25.44,0:00:32.49,Default,,0,0,0,,وكان الطلب هو بطاقة ذاكرة يمتلكها أحد راكبين قطار الطلقة
Dialogue: 0,0:00:35.88,0:00:38.15,Default,,0,0,0,,ما الذي تخفيه وراء ذلك الوجه البارد؟
Dialogue: 0,0:00:38.15,0:00:40.02,Default,,0,0,0,,!حماية موميجِي في الماضي والحاضر
Dialogue: 0,0:00:40.08,0:00:42.25,Default,,0,0,0,,وعد الخادم وذكرى اللقاء الاول
Dialogue: 0,0:00:42.52,0:00:44.03,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:00:44.03,0:00:45.94,Default,,0,0,0,,،بجسد طفل وعقل بالغ
Dialogue: 0,0:00:45.94,0:00:48.59,Default,,0,0,0,,!أسمه المحقق كونان
Dialogue: 0,0:00:48.45,0:00:51.54,DCOpening,,0,0,0,,!جدي، فضولي، غامض، يقودنا نحو المستقبل
Dialogue: 0,0:00:51.54,0:00:54.86,DCOpening,,0,0,0,,بالتأكيد يمكنك كشف هذه الأجزاء الملونة التي تحوم حول قلبي ، أليس كذلك؟
Dialogue: 0,0:00:54.86,0:00:56.53,DCOpening,,0,0,0,,هذا الوجه البارد
Dialogue: 0,0:00:56.53,0:00:58.07,DCOpening,,0,0,0,,لا يمكنك خداع عيناي
Dialogue: 0,0:00:58.07,0:00:59.34,DCOpening,,0,0,0,,لا يمكنك الهروب من قدرك
Dialogue: 0,0:00:59.34,0:01:01.34,DCOpening,,0,0,0,,...لذا اتبعني اتبعني اتبعني
Dialogue: 0,0:01:01.34,0:01:02.20,DCOpening,,0,0,0,,لكنك بطريق الخطأ وبخبث
Dialogue: 0,0:01:02.20,0:01:04.54,DCOpening,,0,0,0,,,أمسكت بالدليل، انظر
Dialogue: 0,0:01:04.54,0:01:07.96,DCOpening,,0,0,0,,لا أستطيع التوقف الآن، أريد أن أتعقبه حتى النهاية
Dialogue: 0,0:01:07.96,0:01:11.05,DCOpening,,0,0,0,,لن أخيب ظن أحد لا تستخف بي كمجرد صبي
Dialogue: 0,0:01:11.04,0:01:14.21,DCOpening,,0,0,0,,هذه المفاهيم المسبقة ليست سوى خدع طفولية
Dialogue: 0,0:01:14.42,0:01:17.27,DCOpening,,0,0,0,,أعلم أنك تريدني، ولن أخذلك أبدًا
Dialogue: 0,0:01:17.28,0:01:20.26,DCOpening,,0,0,0,,في الحقيقة...
Dialogue: 0,0:01:20.76,0:01:24.00,DCOpening,,0,0,0,,أعلم أنك تكرهني ومع ذلك، لم أستطع لن أتركك أبدًا
Dialogue: 0,0:01:24.00,0:01:27.64,DCOpening,,0,0,0,,أرني مشاعرك الحقيقية؟
Dialogue: 0,0:01:28.47,0:01:29.35,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:01:35.00,0:01:36.49,DCOpening,,0,0,0,,!انطلق
Dialogue: 0,0:01:41.61,0:01:45.16,DCOpening,,0,0,0,,النهاية السعيدة المثالية
Dialogue: 0,0:01:45.16,0:01:48.25,DCOpening,,0,0,0,,ابتسامة لتجنب الألم، قلبي ينفتح عند 4869
Dialogue: 0,0:01:48.24,0:01:51.79,DCOpening,,0,0,0,,قبلة سرية أطلقت في البحر مشاعر ما زالت تحتل قلبي
Dialogue: 0,0:01:51.79,0:01:55.08,DCOpening,,0,0,0,,افتح قلبي أيضًا أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:01:59.90,0:02:02.22,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:06.37,0:02:08.37,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:12.59,0:02:13.26,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:02:30.00,0:02:35.54,sign_episode_title,SIGN,0,0,0,,{\fad(400,1)} لماذا أصبحت خادمها \Nالجزء الثاني 
Dialogue: 0,0:02:30.51,0:02:33.49,Default,,0,0,0,,!لماذا أصبحت خادمها - الجزء الثاني
Dialogue: 0,0:02:37.99,0:02:40.99,Default,,0,0,0,,هل سمعتم صوتًا يصدر من تحت الأرض؟
Dialogue: 0,0:02:41.16,0:02:43.41,Default,,0,0,0,,بلى, صوت فتاة
Dialogue: 0,0:02:46.42,0:02:48.32,Default,,0,0,0,,تبًا, لقد لاحظوني
Dialogue: 0,0:02:48.86,0:02:49.67,Default,,0,0,0,,عذرًا
Dialogue: 0,0:02:51.54,0:02:52.67,Default,,0,0,0,,إنهم ثلاثة
Dialogue: 0,0:02:54.63,0:02:56.76,Default,,0,0,0,,اثنان يتحدثان كثيرًا
Dialogue: 0,0:02:57.21,0:02:59.01,Default,,0,0,0,,وواحد صامت
Dialogue: 0,0:02:59.72,0:03:01.47,Default,,0,0,0,,أستطيع معرفة ذلك من أصوات أحذيتهم
Dialogue: 0,0:03:02.89,0:03:05.26,Default,,0,0,0,,أنا ماهرة في لعبة الكاروتا
Dialogue: 0,0:03:06.18,0:03:08.60,Default,,0,0,0,,لهذا سمعي أفضل من الآخرين
Dialogue: 0,0:03:13.02,0:03:15.19,Default,,0,0,0,,هأنذا, سأفتح الباب
Dialogue: 0,0:03:19.53,0:03:21.07,Default,,0,0,0,,آنستي
Dialogue: 0,0:03:21.24,0:03:24.66,Default,,0,0,0,,سأخرجك من هناك
Dialogue: 0,0:03:33.71,0:03:34.58,Default,,0,0,0,,سقط الأول
Dialogue: 0,0:03:35.04,0:03:36.25,Default,,0,0,0,,!حقير
Dialogue: 0,0:03:39.63,0:03:40.22,Default,,0,0,0,,الثاني
Dialogue: 0,0:03:49.89,0:03:50.77,Default,,0,0,0,,تبقى الأخير
Dialogue: 0,0:04:12.46,0:04:13.87,Default,,0,0,0,,!مدهش مدهش
Dialogue: 0,0:04:14.29,0:04:16.50,Default,,0,0,0,,كما هو متوقع من عضو الأمن العام (إيوري)
Dialogue: 0,0:04:16.71,0:04:17.88,Default,,0,0,0,,!أنت قوي
Dialogue: 0,0:04:26.64,0:04:28.30,Default,,0,0,0,,!سحقًا
Dialogue: 0,0:04:29.01,0:04:31.14,Default,,0,0,0,,!سأردها لك
Dialogue: 0,0:04:31.73,0:04:33.89,Default,,0,0,0,,عضو الأمن العام (إيوري)
Dialogue: 0,0:04:35.48,0:04:37.48,Default,,0,0,0,,تذكر هذا
Dialogue: 0,0:04:39.57,0:04:41.15,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:04:41.53,0:04:42.19,Default,,0,0,0,,نعم
Dialogue: 0,0:04:43.45,0:04:44.65,Default,,0,0,0,,..ولكن أحدهم
Dialogue: 0,0:04:46.61,0:04:48.16,Default,,0,0,0,,تمكن من الهرب
Dialogue: 0,0:04:53.08,0:04:55.17,Default,,0,0,0,,سيد (إيوري)
Dialogue: 0,0:04:59.92,0:05:02.01,Default,,0,0,0,,بم أنت شارد؟
Dialogue: 0,0:05:02.34,0:05:05.34,Default,,0,0,0,,تبقت أربعون دقيقة فقط للوصول إلى المحطة الأخيرة
Dialogue: 0,0:05:06.89,0:05:08.26,Default,,0,0,0,,..كما توقعت هذا الصوت
Dialogue: 0,0:05:09.22,0:05:11.97,Default,,0,0,0,,هو ذاته البلطجي الذي تمكن من الهرب تلك المرة
Dialogue: 0,0:05:13.18,0:05:14.64,Default,,0,0,0,,..هؤلاء البلطجية
Dialogue: 0,0:05:15.10,0:05:19.69,Default,,0,0,0,,كانت لدي شكوكي بكونهم ذو علاقة بالنائب (تسوروغي)
Dialogue: 0,0:05:20.40,0:05:23.78,Default,,0,0,0,,الذي تمت إقالته من قبل رئيس الوزراء السابق بسبب فضيحة
Dialogue: 0,0:05:24.90,0:05:28.20,Default,,0,0,0,,..ولك هل يمكن أن الرجل الذي انتحر أيضًا
Dialogue: 0,0:05:32.58,0:05:34.04,Default,,0,0,0,,إنه مجرد قلم حبر
Dialogue: 0,0:05:36.16,0:05:37.04,Default,,0,0,0,,على ذكر هذا
Dialogue: 0,0:05:37.46,0:05:40.46,Default,,0,0,0,,قلم الحبر الذي بجوار الجثة ــ
Dialogue: 0,0:05:41.75,0:05:43.80,Default,,0,0,0,,..مهلًا.. على ما أذكر
Dialogue: 0,0:05:44.67,0:05:47.93,Default,,0,0,0,,كان ضاغط القلم ملطخ بالدماء
Dialogue: 0,0:05:48.84,0:05:52.26,Default,,0,0,0,,!ولكن كان هناك جزء لم تطاله الدماء
Dialogue: 0,0:05:53.60,0:05:55.31,Default,,0,0,0,,بعدما أنهى كتابة شيء ما
Dialogue: 0,0:05:55.64,0:05:59.15,Default,,0,0,0,,قام بإغلاق القلم حتى لايُكشف
Dialogue: 0,0:06:03.32,0:06:04.98,Default,,0,0,0,,مما يعني كما ظننت
Dialogue: 0,0:06:05.24,0:06:08.57,Default,,0,0,0,,هنالك ماكُتب بجوار جثة الرجل
Dialogue: 0,0:06:12.87,0:06:14.66,Default,,0,0,0,,على فخذ البنطال
Dialogue: 0,0:06:15.75,0:06:17.46,Default,,0,0,0,,هناك ثقب غريب
Dialogue: 0,0:06:18.79,0:06:22.00,Default,,0,0,0,,هكذا إذا, قام بوخز البنطال من الأعلى
Dialogue: 0,0:06:22.96,0:06:25.09,Default,,0,0,0,,وقام بكتابة شيء ما
Dialogue: 0,0:06:25.88,0:06:27.38,Default,,0,0,0,,اعذرني لحظة
Dialogue: 0,0:06:32.51,0:06:33.01,Default,,0,0,0,,هذه؟
Dialogue: 0,0:06:34.39,0:06:35.39,Default,,0,0,0,,كتابة مختصرة
Dialogue: 0,0:06:36.06,0:06:39.02,Default,,0,0,0,,إن كانت قد كتبت كما المفكرة بأسلوب "واسيدا"
