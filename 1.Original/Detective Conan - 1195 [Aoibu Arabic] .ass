Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,90)} ‫ABOODY SUBS | ترجمة \N‫Theconansign : محاكاة\N‫X : @ABOODY_SUBS \N‫X : @Theconansign
Dialogue: 0,0:00:28.11,0:00:31.18,Default,,0,0,0,,‫انظروا إلى كل هذا الإبداع يدور و يُبهر.
Dialogue: 0,0:00:31.18,0:00:33.18,Default,,0,0,0,,‫ممتاز.
Dialogue: 0,0:00:34.34,0:00:36.52,Default,,0,0,0,,ما خطب أبي؟
Dialogue: 0,0:00:36.92,0:00:41.33,Default,,0,0,0,,‫قامت أوكينو يوكو بتغطية هذا المكان بالتلفاز في ذلك اليوم.
Dialogue: 0,0:00:41.64,0:00:44.32,Default,,0,0,0,,لهذا السبب؟
Dialogue: 0,0:00:44.80,0:00:49.20,Default,,0,0,0,,‫عرفت أن الأمر غريب عندما اقترح الذهاب إلى متحف...
Dialogue: 0,0:00:56.54,0:00:58.35,Default,,0,0,0,,في مواجهة لغز غير متوقع
Dialogue: 0,0:00:58.35,0:01:00.31,Default,,0,0,0,,‫الحل الوحيد هو مهارات الاستنتاج الفائقة!
Dialogue: 0,0:01:00.31,0:01:04.19,Default,,0,0,0,,‫شهية للدماء تتزايد بهدوء، تفتح باب المأساة!
Dialogue: 0,0:01:04.19,0:01:05.80,Default,,0,0,0,,يسعى وراء الحقيقة دائماً
Dialogue: 0,0:01:05.80,0:01:07.50,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:01:07.50,0:01:10.15,Default,,0,0,0,,‫اسمه المحقق كونان!
Dialogue: 0,0:01:11.71,0:01:15.47,DC-OP,,0,0,0,,‫ليس بوسعي تغييره بنفسي
Dialogue: 0,0:01:15.65,0:01:18.70,DC-OP,,0,0,0,,‫ما كان منك وما أصابك، فقد مضى وانتهى
Dialogue: 0,0:01:19.18,0:01:22.95,DC-OP,,0,0,0,,‫لا يُعرف من أين جاء ولا ما هو
Dialogue: 0,0:01:23.04,0:01:26.67,DC-OP,,0,0,0,,‫كأن يهاجمك أحد الوحوش
Dialogue: 0,0:01:26.96,0:01:30.74,DC-OP,,0,0,0,,‫أركض كي لا يلحقوا بي
Dialogue: 0,0:01:30.74,0:01:34.00,DC-OP,,0,0,0,,‫ربما يحدث خيراً، من يعلم؟
Dialogue: 0,0:01:34.40,0:01:38.30,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:01:38.30,0:01:42.31,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:01:42.31,0:01:46.02,DC-OP,,0,0,0,,‫أجعل عمق الليل يلمع باللون الوردي
Dialogue: 0,0:01:46.02,0:01:49.74,DC-OP,,0,0,0,,‫مهما طال الزمن، كل ما علي فعله هو المحاولة
Dialogue: 0,0:01:57.44,0:02:01.24,DC-OP,,0,0,0,,‫أبحث عن سعادة جديدة
Dialogue: 0,0:02:01.24,0:02:04.53,DC-OP,,0,0,0,,‫أين يكمن؟، لا احد يعلم
Dialogue: 0,0:02:04.86,0:02:08.96,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:02:08.96,0:02:12.37,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:02:12.56,0:02:15.97,DC-OP,,0,0,0,,‫أضيء على الذكريات المظلمة
Dialogue: 0,0:02:16.25,0:02:19.95,DC-OP,,0,0,0,,‫احدق فيها حتى يزول خوفها
Dialogue: 0,0:02:20.21,0:02:23.93,DC-OP,,0,0,0,,‫في لحظة تلتفت فيها إلى الماضي
Dialogue: 0,0:02:24.03,0:02:27.67,DC-OP,,0,0,0,,‫لم يكن سوى أن أطلقت أعظم دموعك
Dialogue: 0,0:02:52.15,0:02:58.03,sign_episode_title,SIGN,0,0,0,,{\fad(230,1)}لغز القصر: قصر المتاهة\Nالجزء الثاني 
Dialogue: 0,0:02:52.28,0:02:56.12,Default,,0,0,0,,‫"لغز القصر : قصر المتاهة، الجزء الأول!"
Dialogue: 0,0:03:00.86,0:03:02.68,Default,,0,0,0,,هذا برج بابل، أليس كذلك؟
Dialogue: 0,0:03:02.68,0:03:06.72,Default,,0,0,0,,لكن هذا مجرد مثقاب بوضوح، أليس كذلك؟
Dialogue: 0,0:03:06.72,0:03:07.79,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:03:07.79,0:03:08.92,Default,,0,0,0,,‫منذ زمن بعيد...
Dialogue: 0,0:03:09.23,0:03:14.55,Default,,0,0,0,,قدّم مارسيل دوشامب مرة مبولة للمعرض الافتتاحي
Dialogue: 0,0:03:14.55,0:03:19.55,Default,,0,0,0,,‫لجمعية الفنانين المستقلين في نيويورك وسمّاها "النافورة".
Dialogue: 0,0:03:19.55,0:03:23.27,Default,,0,0,0,,‫مهد عمله الطريق للفن الفكري.
Dialogue: 0,0:03:24.77,0:03:29.90,Default,,0,0,0,,‫عفواً. أنا نيجي، المشرفة.{\an8}
Dialogue: 0,0:03:26.64,0:03:29.90,sign_suspect,SIGN,0,0,0,,{\fs20}{\fad(500,1)\pos(307,255)}(25) نيجي كاورو
Dialogue: 0,0:03:26.64,0:03:29.90,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(307,272)}المشرفة على القصر الحلزوني
Dialogue: 0,0:03:30.59,0:03:36.28,Default,,0,0,0,,‫تسوروفوجي كيو هو أبرز فنان فكري في اليابان.
Dialogue: 0,0:03:37.58,0:03:38.64,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:03:39.22,0:03:41.67,Default,,0,0,0,,ما هذا الدرج الحلزوني؟
Dialogue: 0,0:03:43.37,0:03:45.79,Default,,0,0,0,,‫يتوقف عند السقف.
Dialogue: 0,0:03:48.36,0:03:51.04,Default,,0,0,0,,‫هناك شيء مكتوب هناك.
Dialogue: 0,0:03:51.04,0:03:54.31,Default,,0,0,0,,‫يمكنك صعود الدرج لقراءة ما هو مكتوب.
Dialogue: 0,0:03:54.71,0:03:56.53,Default,,0,0,0,,‫حسناً، لا مانع لدي.
Dialogue: 0,0:04:02.15,0:04:03.56,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:04:03.56,0:04:09.56,sign_1195_spiral_mystery,SIGN,0,0,0,,{\fs20}{\an1\frz-9\fax-0.4\pos(247,135)}\h\h\h\h،عندما يتقاطع السماء والأعماق\N.يُخلق طريق، وسيفتح الباب
Dialogue: 0,0:04:03.97,0:04:06.43,Default,,0,0,0,,"عندما يتقاطع السماء والأعماق
Dialogue: 0,0:04:06.43,0:04:09.21,Default,,0,0,0,,‫يُخلق طريق، وسيفتح الباب."
Dialogue: 0,0:04:10.30,0:04:12.83,Default,,0,0,0,,ماذا يعني ذلك؟
Dialogue: 0,0:04:12.83,0:04:14.94,Default,,0,0,0,,‫إنه لغز.
Dialogue: 0,0:04:14.94,0:04:18.26,Default,,0,0,0,,‫أعتقد أنه قد يكون اقتباساً من أسطورة أو شيء.
Dialogue: 0,0:04:18.71,0:04:20.51,Default,,0,0,0,,هل لديك أي أفكار؟
Dialogue: 0,0:04:22.78,0:04:26.08,Default,,0,0,0,,‫هل هو كتاب التغيرات؟ لا، ليس هذا.
Dialogue: 0,0:04:49.04,0:04:53.04,Default,,0,0,0,,‫إذن هي لوحة خادعة يتغير تعبيرها حسب الزاوية.
Dialogue: 0,0:04:53.48,0:04:56.98,sign_note,SIGN,0,0,0,,{\an7\fscx100\fscy100\p1\xshad-1\yshad2\bord0\c&HFDFDFD&\3c&HFFFFFF&\4c&HAFAEAE&\move(450,25,25,25,0,855)}m 180 -10 l -10 -10 -10 110 180 110
Dialogue: 1,0:04:53.48,0:04:56.98,sign_1195_painting_caption,SIGN,0,0,0,,{\fs20}{\u1\an7\move(450,25,25,25,0,855)}.صورة ذاتية بثلاثة أوجه{\u0}\N\N،حائر عند رؤيته من الأمام\N.طفولي من اليسار، وساخر من اليمين\N\N.كل تعبير يلتقط ثلاثة جوانب من شخصية تسوروفوجي كيو
Dialogue: 0,0:04:54.45,0:04:56.98,Default,,0,0,0,,‫"صورة ذاتية بثلاثة أوجه."
Dialogue: 0,0:04:56.98,0:04:59.70,Default,,0,0,0,,"حائر عند رؤيته من الأمام
Dialogue: 0,0:04:56.98,0:05:04.24,sign_note,SIGN,0,0,0,,{\an7\fscx100\fscy100\p1\xshad-1\yshad2\bord0\c&HF8F6F4&\3c&HFFFFFF&\4c&HD7D0CF&\pos(450,25)}m 180 -10 l -10 -10 -10 110 180 110
Dialogue: 1,0:04:56.98,0:05:04.24,sign_1195_painting_caption,SIGN,0,0,0,,{\fs20}{\u1\an7\pos(450,25)}.صورة ذاتية بثلاثة أوجه{\u0}\N\N،حائر عند رؤيته من الأمام\N.طفولي من اليسار، وساخر من اليمين\N\N.كل تعبير يلتقط ثلاثة جوانب من شخصية تسوروفوجي كيو
Dialogue: 0,0:04:59.70,0:05:04.24,Default,,0,0,0,,‫طفولي من اليسار، وساخر من اليمين.
Dialogue: 0,0:05:04.58,0:05:10.75,Default,,0,0,0,,‫كل تعبير يلتقط ثلاثة جوانب من شخصية تسوروفوجي كيو."
Dialogue: 0,0:05:14.50,0:05:16.21,Default,,0,0,0,,الهاوية؟
Dialogue: 0,0:05:21.95,0:05:24.01,Default,,0,0,0,,‫إنها عميقة جداً.
Dialogue: 0,0:05:24.87,0:05:26.53,Default,,0,0,0,,‫أهلاً بك.
Dialogue: 0,0:05:26.97,0:05:29.66,Default,,0,0,0,,‫المعذرة، أنا بالصدفة...
Dialogue: 0,0:05:29.66,0:05:31.13,Default,,0,0,0,,‫هاياسي.
Dialogue: 0,0:05:31.64,0:05:33.80,Default,,0,0,0,,‫كاورو.
Dialogue: 0,0:05:33.80,0:05:36.50,Default,,0,0,0,,‫خذوا وقتكم. المعذرة.
Dialogue: 0,0:05:39.97,0:05:43.12,Default,,0,0,0,,‫شكراً لحضورك يا هاياسي.
Dialogue: 0,0:05:43.12,0:05:47.15,Default,,0,0,0,,كيف لا أحضر وأنتِ من طلبتِ مني المجيء؟
Dialogue: 0,0:05:48.12,0:05:51.62,sign_suspect,SIGN,0,0,0,,{\fs20}{\fad(500,1)\pos(320,255)}(41) تسوروفوجي سينسوكي
Dialogue: 0,0:05:48.12,0:05:51.62,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(320,272)}ابن تسوروفوجي كيو
Dialogue: 0,0:05:52.37,0:05:55.63,sign_suspect,SIGN,0,0,0,,{\fs20}{\fad(500,1)\pos(410,255)}(38)تسوروفوجي مايماي
Dialogue: 0,0:05:52.37,0:05:55.63,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(410,272)}ابنة تسوروفوجي كيو
Dialogue: 0,0:05:56.13,0:05:59.63,sign_suspect,SIGN,0,0,0,,{\fs20}{\fad(500,1)\pos(270,255)}(41) تسوروفوجي يوكو
Dialogue: 0,0:05:56.13,0:05:59.63,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(270,272)}زوجة سينسوكي
Dialogue: 0,0:06:00.13,0:06:03.63,sign_suspect,SIGN,0,0,0,,{\fs20}{\pos(320,255)\fad(500,1)}(25) هاياسي كازومي
Dialogue: 0,0:06:00.13,0:06:03.63,sign_suspect,SIGN,0,0,0,,{\pos(320,272)\fad(500,1)\fs14}محرر مجلة
Dialogue: 0,0:06:03.63,0:06:09.05,Default,,0,0,0,,عندما فاز تسوروفوجي كيو بالجائزة الكبرى في بينالي باريس
Dialogue: 0,0:06:09.05,0:06:11.42,Default,,0,0,0,,‫كان عمره 27 عاماً فقط.
Dialogue: 0,0:06:11.42,0:06:14.90,Default,,0,0,0,,‫قال الناس إن فناناً يابانياً مجهولاً بدأ ثورة.
Dialogue: 0,0:06:15.30,0:06:17.67,Default,,0,0,0,,‫أحدث ضجة كبيرة.
Dialogue: 0,0:06:17.67,0:06:22.57,Default,,0,0,0,,‫بعد ذلك، أقام معارض فردية في مدريد ونيويورك.
Dialogue: 0,0:06:22.57,0:06:25.15,Default,,0,0,0,,‫المعذرة.
Dialogue: 0,0:06:25.15,0:06:31.29,Default,,0,0,0,,‫كان يجب أن أذكر هذا أولاً، لكن مجلتنا تفرض رسوم نشر.
Dialogue: 0,0:06:31.29,0:06:35.29,Default,,0,0,0,,ماذا؟، حتى وإن كان الفنان العالمي الشهير تسوروفوجي كيو؟
Dialogue: 0,0:06:35.60,0:06:37.04,Default,,0,0,0,,‫هذه هي القاعدة.
Dialogue: 0,0:06:37.04,0:06:41.30,Default,,0,0,0,,توقعت ذلك. إذن، كم المبلغ؟
Dialogue: 0,0:06:41.30,0:06:43.30,Default,,0,0,0,,‫300 ألف ين.
Dialogue: 0,0:06:43.30,0:06:45.05,Default,,0,0,0,,‫300 ألف؟!
Dialogue: 0,0:06:47.39,0:06:49.22,Default,,0,0,0,,300 ألف، إذن؟
Dialogue: 0,0:06:49.22,0:06:54.33,Default,,0,0,0,,هاياسي، ألا يمكنك إعطاؤنا خصماً بما أننا زملاء دراسة سابقون؟
Dialogue: 0,0:06:54.33,0:06:55.60,Default,,0,0,0,,‫لا أستطيع.
Dialogue: 0,0:06:56.80,0:07:00.12,Default,,0,0,0,,‫حسناً. سندفع الـ300 ألف.
Dialogue: 0,0:07:00.12,0:07:02.08,Default,,0,0,0,,‫مهلاً، ماذا تقولين؟!
Dialogue: 0,0:07:02.08,0:07:04.37,Default,,0,0,0,,‫لم لا؟ إنها فقط 300 ألف.
Dialogue: 0,0:07:04.37,0:07:05.99,Default,,0,0,0,,‫هذا مستحيل.
Dialogue: 0,0:07:05.99,0:07:07.74,Default,,0,0,0,,لكن لماذا؟
Dialogue: 0,0:07:07.74,0:07:10.53,Default,,0,0,0,,‫لأنه لا يمكننا إنفاق مال لا نملكه.
Dialogue: 0,0:07:14.29,0:07:16.21,Default,,0,0,0,,أليس كذلك يا عزيزي؟
Dialogue: 0,0:07:16.21,0:07:22.79,Default,,0,0,0,,‫نعم. على أي حال، أنا آسف، لكن عليك المغادرة.
Dialogue: 0,0:07:23.84,0:07:25.86,Default,,0,0,0,,‫انتظر!
Dialogue: 0,0:07:29.97,0:07:34.25,Default,,0,0,0,,‫تباً ، لا أطيق الأشخاص الذين لا يملكون حساً اقتصادياً.
Dialogue: 0,0:07:41.63,0:07:43.04,Default,,0,0,0,,‫آسف.
Dialogue: 0,0:07:43.04,0:07:45.34,Default,,0,0,0,,‫ليس خطأك يا هاياسي.
Dialogue: 0,0:07:45.34,0:07:47.72,Default,,0,0,0,,‫في الواقع، شكراً لحضورك.
Dialogue: 0,0:07:47.72,0:07:49.97,Default,,0,0,0,,‫بما أنك هنا بالفعل، خذ وقتك.
Dialogue: 0,0:07:58.45,0:08:00.54,Default,,0,0,0,,‫حسناً، إلى الغرفة التالية.
Dialogue: 0,0:08:00.54,0:08:01.16,sign_1195_visitor_path,SIGN,0,0,0,,{\fs20}{\pos(403,154)\an2\frz-1\fnGeorgia\fad(1,200)}طريق الزائر
Dialogue: 0,0:08:01.87,0:08:03.92,sign_1195_visitor_path,SIGN,0,0,0,,{\fs20}{\pos(403,154)\an2\frz-1\fnGeorgia\fad(400,400)}طريق الزائر
Dialogue: 0,0:08:03.34,0:08:07.71,Default,,0,0,0,,‫أبي، لا يمكنك الذهاب من هناك.
Dialogue: 0,0:08:04.37,0:08:06.05,sign_1195_visitor_path,SIGN,0,0,0,,{\fs20}{\pos(403,154)\an2\frz-1\fnGeorgia\fad(600,1)}طريق الزائر
Dialogue: 0,0:08:08.05,0:08:11.43,Default,,0,0,0,,‫آسف. في هذه الحالة، سنعود إلى...
Dialogue: 0,0:08:13.47,0:08:15.56,Default,,0,0,0,,‫ذلك الصوت...
Dialogue: 0,0:08:15.56,0:08:17.98,Default,,0,0,0,,‫لابد أن أحدهم تعثر أو شيء.
Dialogue: 0,0:08:20.10,0:08:21.48,Default,,0,0,0,,‫يا عمي!
Dialogue: 0,0:08:21.48,0:08:24.73,sign_1195_visitor_path,SIGN,0,0,0,,{\fs20}{\pos(403,154)\an2\frz-1\fnGeorgia}طريق الزائر
Dialogue: 0,0:08:21.82,0:08:23.43,Default,,0,0,0,,‫ابقيا أنتما هنا!
Dialogue: 0,0:08:30.06,0:08:31.30,Default,,0,0,0,,‫لا أحد هنا...
Dialogue: 0,0:08:46.00,0:08:47.74,Default,,0,0,0,,انتحار؟
Dialogue: 0,0:08:47.74,0:08:50.01,Default,,0,0,0,,إذاً ما ذلك الصوت الذي سمعناه؟
Dialogue: 0,0:08:51.10,0:08:54.05,Default,,0,0,0,,‫أنت! قلت لكَ ابق في الطابق الثاني!
Dialogue: 0,0:08:54.05,0:08:58.32,Default,,0,0,0,,ألا يعني ذلك الصوت أنه يمكن أن يكون قتلاً؟
Dialogue: 0,0:08:59.85,0:09:02.39,Default,,0,0,0,,‫ران، اتصلي بالشرطة.
Dialogue: 0,0:09:02.39,0:09:03.34,Default,,0,0,0,,‫حسناً.
Dialogue: 0,0:09:06.02,0:09:07.86,Default,,0,0,0,,ما ذلك الصوت؟
Dialogue: 0,0:09:07.86,0:09:11.33,Default,,0,0,0,,‫أخوك أصيب بطلق ناري من بندقية صيد.
Dialogue: 0,0:09:11.33,0:09:12.32,Default,,0,0,0,,‫مستحيل!
Dialogue: 0,0:09:12.32,0:09:15.20,Default,,0,0,0,,الأهم، هل أتى أحد إلى الطابق العلوي؟
Dialogue: 0,0:09:15.20,0:09:16.82,Default,,0,0,0,,‫لا.
Dialogue: 0,0:09:16.82,0:09:18.29,Default,,0,0,0,,‫عزيزي!
Dialogue: 0,0:09:20.16,0:09:22.05,Default,,0,0,0,,‫عزيزي!
Dialogue: 0,0:09:22.05,0:09:25.54,Default,,0,0,0,,‫أيتها الجدة، لا يمكنكِ لمسه حتى تصل الشرطة!
Dialogue: 0,0:09:26.04,0:09:28.14,Default,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:09:37.54,0:09:39.68,Default,,0,0,0,,‫البندقية هي لأخي.
Dialogue: 0,0:09:39.68,0:09:43.31,Default,,0,0,0,,عندما زار مبنى البلدية لمناقشة منحة
Dialogue: 0,0:09:43.31,0:09:47.57,Default,,0,0,0,,‫سُئل عما إذا كان يرغب في تجربة الصيد نظراً لوجود نقص.
Dialogue: 0,0:09:47.57,0:09:50.21,Default,,0,0,0,,‫حصل على رخصته حينها.
Dialogue: 0,0:09:50.21,0:09:52.70,Default,,0,0,0,,لكن لماذا يقتل نفسه؟
Dialogue: 0,0:09:52.70,0:09:54.49,Default,,0,0,0,,‫لم يقتل نفسه.
Dialogue: 0,0:09:54.49,0:09:57.69,Default,,0,0,0,,ما الذي يجعلك تقولين ذلك يا جدة؟
Dialogue: 0,0:09:57.69,0:10:00.90,Default,,0,0,0,,‫ليس لدي سبب. أنا أعلم فقط لأنني زوجته.
Dialogue: 0,0:10:00.90,0:10:04.75,Default,,0,0,0,,لكن إذا كانت هذه جريمة قتل، أين ذهب الجاني؟
Dialogue: 0,0:10:04.75,0:10:08.75,Default,,0,0,0,,‫على الأقل، لم ينزل أحد إلى الطابق الثاني.
Dialogue: 0,0:10:08.75,0:10:12.76,Default,,0,0,0,,نزلت إلى الطابق السفلي بمجرد سماع صوت إطلاق النار
Dialogue: 0,0:10:12.76,0:10:15.99,Default,,0,0,0,,‫ولم يصعد أحد إلى الطابق الرابع.
Dialogue: 0,0:10:17.51,0:10:23.64,Default,,0,0,0,,لكن إذا كان هذا انتحاراً، فما هو الصوت الذي سمعناه قبل إطلاق النار؟
Dialogue: 0,0:10:23.64,0:10:25.31,Default,,0,0,0,,أي صوت؟
Dialogue: 0,0:10:25.31,0:10:31.61,Default,,0,0,0,,‫إصابة الرأس التي ذكرها الطبيب الشرعي قد يكون لها علاقة بذلك.
Dialogue: 0,0:10:31.61,0:10:35.28,Default,,0,0,0,,‫إذاً، من المرجح أن هذه كانت جريمة قتل بالفعل.
Dialogue: 0,0:10:37.53,0:10:41.41,Default,,0,0,0,,لكن أين ذهب الجاني؟
Dialogue: 0,0:10:43.26,0:10:47.29,Default,,0,0,0,,‫لم أكن أنا. ليس لدي حتى دافع.
Dialogue: 0,0:10:47.29,0:10:48.98,Default,,0,0,0,,هل أنتِ متأكدة؟
Dialogue: 0,0:10:48.98,0:10:53.17,Default,,0,0,0,,‫كنتِ تتجادلين مع زوجي بشأن مقال المجلة في وقت سابق.
Dialogue: 0,0:10:53.17,0:10:57.24,Default,,0,0,0,,‫لـ-لم يكن ذلك جدالاً، كان مجرد اختلاف في الرأي.
Dialogue: 0,0:10:57.24,0:11:00.64,Default,,0,0,0,,ماذا كنتِ تفعلين قبل أن تسمعين إطلاق النار؟
Dialogue: 0,0:11:00.64,0:11:02.64,Default,,0,0,0,,‫كنتُ أعمل في مرسمي.
Dialogue: 0,0:11:02.64,0:11:04.54,Default,,0,0,0,,هل يمكن لأحد أن يؤكد ذلك؟
Dialogue: 0,0:11:04.54,0:11:07.58,Default,,0,0,0,,‫لا. كنتُ وحدي.
Dialogue: 0,0:11:07.58,0:11:10.32,Default,,0,0,0,,‫زوجتي لم تقتل أحداً.
Dialogue: 0,0:11:19.09,0:11:20.38,Default,,0,0,0,,من أنتَ؟
Dialogue: 0,0:11:20.38,0:11:21.95,Default,,0,0,0,,‫هذا زوجي.
Dialogue: 0,0:11:21.95,0:11:25.83,Default,,0,0,0,,‫عفواً. اسمي أوماغاري ساتوشي.{\an8}
Dialogue: 0,0:11:22.83,0:11:25.83,sign_suspect,SIGN,0,0,0,,{\fs20}{\fad(500,1)\pos(275,255)}(39) أوماغاري ساتوشي
Dialogue: 0,0:11:22.83,0:11:25.83,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(275,272)}زوج مايماي
Dialogue: 0,0:11:25.83,0:11:29.96,Default,,0,0,0,,إذاً، ما الذي يجعلك متأكداً أن زوجتكَ لم تفعلها؟
Dialogue: 0,0:11:29.96,0:11:32.53,Default,,0,0,0,,‫لأن شخصاً آخر فعلها.
Dialogue: 0,0:11:33.31,0:11:35.22,Default,,0,0,0,,‫إنه أحدهم.
Dialogue: 0,0:11:38.41,0:11:40.93,Default,,0,0,0,,هل شهدت شيئاً؟
Dialogue: 0,0:11:40.93,0:11:42.68,Default,,0,0,0,,‫ربما.
Dialogue: 0,0:11:42.68,0:11:46.31,Default,,0,0,0,,‫مهلاً عزيزي، لا تقل أشياء غريبة.
Dialogue: 0,0:11:46.31,0:11:51.57,Default,,0,0,0,,‫آسف. كان الجميع يتهمونكِ، لذلك لم أتمالك نفسي.
Dialogue: 0,0:12:06.08,0:12:09.33,sign_1195_floor_map,SIGN,0,0,0,,{\an7\frz10.5\fax0.15\b1\yshad5\move(28,94,48,117)}\hالقصر الحلزوني\h\h\h{\c&H567541&\3c&HE0E3E0&\b0}\hالمخطط\h\h\h
Dialogue: 0,0:12:06.59,0:12:09.33,Default,,0,0,0,,غرف المعارض في الطابقين الأول والثاني
Dialogue: 0,0:12:09.33,0:12:12.35,Default,,0,0,0,,‫والطابقان الثالث والرابع مغلقان أمام الجمهور.
Dialogue: 0,0:12:12.35,0:12:14.08,Default,,0,0,0,,يوجد سطح أيضاً؟
Dialogue: 0,0:12:14.62,0:12:16.45,Default,,0,0,0,,‫يجب أن أتفقده تحسباً.
Dialogue: 0,0:12:20.93,0:12:23.00,Default,,0,0,0,,‫النوافذ مثبتة.
Dialogue: 0,0:12:23.00,0:12:28.25,Default,,0,0,0,,‫من المستحيل الدخول أو الخروج من هنا.
Dialogue: 0,0:12:28.25,0:12:31.95,Default,,0,0,0,,‫مما يعني أنه من غير المرجح أن يكون الجاني دخيلاً.
Dialogue: 0,0:12:31.95,0:12:35.23,Default,,0,0,0,,‫إذاً دعونا نفحص الغرف.
Dialogue: 0,0:12:41.99,0:12:45.99,Default,,0,0,0,,إذا كانت النوافذ مثبتة، فماذا يُفعلون للتهوية؟
Dialogue: 0,0:12:48.00,0:12:49.26,Default,,0,0,0,,‫لابد أن هذا هو.
Dialogue: 0,0:12:57.38,0:13:02.39,Default,,0,0,0,,‫شكراً لكَ يا عزيزي. بدونك، أنا...
Dialogue: 0,0:12:57.38,0:13:02.39,sign_1195_studio,SIGN,0,0,0,,{\fs20}{\pos(320,90)\an2}استوديو
Dialogue: 1,0:12:57.38,0:13:02.39,sign_1195_studio,SIGN,0,0,0,,{\pos(320,90)\an2\bord0\shad0\blur0.4\c&HC093ED&\b0\fsp0.8}Maimai{\c&H80D2A9&}'s
Dialogue: 0,0:12:57.38,0:13:02.39,sign_1195_studio,SIGN,0,0,0,,{\fs20}{\pos(320,235)\an8}مايماي 
Dialogue: 1,0:12:57.38,0:13:02.39,sign_1195_studio,SIGN,0,0,0,,{\pos(320,235)\an8\bord0\shad0\blur0.4\b0\fsp0.8\c&HD6C489&}Studio
Dialogue: 0,0:13:02.39,0:13:05.90,Default,,0,0,0,,‫فعلتُ فقط ما يفعله أي زوج.
Dialogue: 0,0:13:05.90,0:13:07.94,Default,,0,0,0,,‫حسناً، سأذهب في نزهة.
Dialogue: 0,0:13:09.10,0:13:09.85,sign_1195_studio,SIGN,0,0,0,,{\fs20}{\pos(320,100)\an2\fad(1,500)\an2}استوديو
