Dialogue: 1,0:13:12.18,0:13:13.73,sign_1195_studio,SIGN,0,0,0,,{\pos(320,100)\an2\bord0\shad0\blur0.4\c&HC093ED&\b0\fsp0.8\fad(500,1}مايماي 
Dialogue: 0,0:13:12.18,0:13:13.73,sign_1195_studio,SIGN,0,0,0,,{\fs20}{\pos(320,220)\an8\fad(500,1}استوديو
Dialogue: 1,0:13:12.18,0:13:13.73,sign_1195_studio,SIGN,0,0,0,,{\pos(320,220)\an8\bord0\shad0\blur0.4\b0\fsp0.8\c&HD6C489&\fad(500,1}استوديو
Dialogue: 0,0:13:13.06,0:13:15.30,Default,,0,0,0,,‫حتى أنا لا أستطيع تصديق أنني قلتُ ذلك.
Dialogue: 0,0:13:23.34,0:13:25.26,Default,,0,0,0,,‫جبال إلى الشرق.
Dialogue: 0,0:13:25.95,0:13:27.75,Default,,0,0,0,,‫غابة إلى الجنوب.
Dialogue: 0,0:13:28.16,0:13:31.53,Default,,0,0,0,,‫وبحيرة إلى الغرب.
Dialogue: 0,0:13:43.17,0:13:46.01,Default,,0,0,0,,البحيرة؟
Dialogue: 0,0:13:46.22,0:13:47.26,sign_1195_studio,SIGN,0,0,0,,{\fs20}{\an8\fad(200,1)\pos(421,83)\c&HFDF9F4&\4c&HFDF9F4&\3c&HB8B2BF&}استوديو
Dialogue: 1,0:13:46.22,0:13:47.26,sign_1195_studio,SIGN,0,0,0,,{\an8\bord0\shad0\blur0.4\b0\fsp0.8\c&HE8E2C4&\fad(200,1)\pos(421,83)}استوديو
Dialogue: 0,0:13:48.05,0:13:53.60,Default,,0,0,0,,‫أنا متأكد أن النافذة أمام الغرفة بالأسفل تطل على الجبال.
Dialogue: 0,0:13:55.16,0:13:57.07,Default,,0,0,0,,‫سأذهب لأتفقدها.
Dialogue: 0,0:13:57.46,0:14:02.38,Default,,0,0,0,,‫واحد، اثنان، ثلاثة، أربعة، خمسة...
Dialogue: 0,0:14:02.38,0:14:06.58,Default,,0,0,0,,‫...85، 86، 87، 88
Dialogue: 0,0:14:06.58,0:14:11.58,Default,,0,0,0,,‫.172، 173، 174، 175
Dialogue: 0,0:14:11.58,0:14:12.90,Default,,0,0,0,,‫كما توقعت.
Dialogue: 0,0:14:13.67,0:14:19.54,Default,,0,0,0,,‫واحد، اثنان، ثلاثة، أربعة، خمسة، ستة...
Dialogue: 0,0:14:19.54,0:14:23.34,Default,,0,0,0,,‫115، 116، 117.
Dialogue: 0,0:14:23.77,0:14:28.58,Default,,0,0,0,,‫هناك 117 درجة بين الطابق الأول والثاني وبين الثاني والثالث.
Dialogue: 0,0:14:28.58,0:14:32.41,Default,,0,0,0,,‫لكن هناك 175 درجة بين الطابق الثالث والرابع.
Dialogue: 0,0:14:32.41,0:14:34.35,Default,,0,0,0,,‫ذلك يساوي درجة ونصف.
Dialogue: 0,0:14:34.73,0:14:36.10,Default,,0,0,0,,‫لكن هذا يعني...
Dialogue: 0,0:14:36.10,0:14:40.69,Default,,0,0,0,,أن سقف الطابق الثالث سيكون أعلى بمقدار درجة ونصف من سقف الأول أو الثاني
Dialogue: 0,0:14:40.69,0:14:45.16,Default,,0,0,0,,‫لكن سقف الطابق الثالث في الواقع أقل من الطابقين الآخرين.
Dialogue: 0,0:14:45.71,0:14:46.73,Default,,0,0,0,,بمعنى أخر
Dialogue: 0,0:14:46.73,0:14:52.10,Default,,0,0,0,,‫توجد مساحة نصف طابق بين الطابق الثالث والرابع.
Dialogue: 0,0:14:52.10,0:14:54.04,Default,,0,0,0,,‫غرفة مخفية.
Dialogue: 0,0:14:58.39,0:15:02.06,Default,,0,0,0,,هذا الخيط مربوط بزناد البندقية
Dialogue: 0,0:15:02.06,0:15:06.74,Default,,0,0,0,,‫الذي يُسحب مع الخيط.
Dialogue: 0,0:15:06.74,0:15:08.30,Default,,0,0,0,,‫هكذا إذن.
Dialogue: 0,0:15:08.63,0:15:13.81,Default,,0,0,0,,لكن يا موري، ألم يكن بلاط الأرضية مبللاً عندما تم اكتشاف الجثة؟
Dialogue: 0,0:15:13.81,0:15:17.69,Default,,0,0,0,,‫في هذه الحالة...
Dialogue: 0,0:15:17.69,0:15:20.85,Default,,0,0,0,,أين ذهب كونان؟
Dialogue: 0,0:15:23.12,0:15:27.83,Default,,0,0,0,,أيتها الجدة، هل لديكِ مخططات تفصيلية لهذا القصر؟
Dialogue: 0,0:15:27.83,0:15:32.39,Default,,0,0,0,,‫لستُ متأكدة. يجب أن تسأل الآنسة نيجي.
Dialogue: 0,0:15:32.39,0:15:33.97,Default,,0,0,0,,أين الآنسة نيجي؟
Dialogue: 0,0:15:33.97,0:15:35.54,Default,,0,0,0,,‫إنها بالخارج.
Dialogue: 0,0:15:35.54,0:15:36.75,Default,,0,0,0,,‫شكراً.
Dialogue: 0,0:15:37.80,0:15:39.55,Default,,0,0,0,,‫انتظر يا كونان!
Dialogue: 0,0:15:41.71,0:15:45.40,Default,,0,0,0,,يا كونان، لماذا تريد رؤية مخططات القصر؟
Dialogue: 0,0:15:45.40,0:15:49.22,Default,,0,0,0,,‫إنه مبنى غير عادي، لذلك أردت رؤية تخطيطه.
Dialogue: 0,0:15:49.63,0:15:53.55,Default,,0,0,0,,لماذا لا تتركِ العمل هنا وتأتي للعمل في شركتي؟
Dialogue: 0,0:15:53.55,0:15:55.73,Default,,0,0,0,,لماذا تقول ذلك؟
Dialogue: 0,0:15:55.73,0:16:01.51,Default,,0,0,0,,‫سمعت إشاعات سلبية عن زوج الآنسة مايماي، السيد أوماغاري.
Dialogue: 0,0:16:01.51,0:16:03.63,Default,,0,0,0,,‫يبدو أنه خائن فظيع.
Dialogue: 0,0:16:03.63,0:16:05.22,Default,,0,0,0,,‫هكذا إذن.
Dialogue: 0,0:16:05.22,0:16:08.78,Default,,0,0,0,,‫أقدر قلقك. سأكون حذرة.
Dialogue: 0,0:16:08.78,0:16:10.42,Default,,0,0,0,,‫عفواً، آنسة!
Dialogue: 0,0:16:10.99,0:16:14.24,Default,,0,0,0,,هل يمكنني رؤية مخططات بناء هذا القصر؟
Dialogue: 0,0:16:14.24,0:16:17.42,Default,,0,0,0,,‫نعم، بالطبع.
Dialogue: 0,0:16:17.75,0:16:20.75,sign_1195_name_architect,SIGN,0,0,0,,{\fs20}{\frz10.5\pos(333,190)\an2}المهندس هيروكي ماساتارو
Dialogue: 0,0:16:18.64,0:16:20.75,Default,,0,0,0,,‫هيروكي ماساتارو...
Dialogue: 0,0:16:20.75,0:16:22.22,Default,,0,0,0,,هل تعرفه؟
Dialogue: 0,0:16:22.22,0:16:24.63,Default,,0,0,0,,‫نعم، لكن بالاسم فقط.
Dialogue: 0,0:16:25.27,0:16:27.00,Default,,0,0,0,,‫إنه ليس هنا.
Dialogue: 0,0:16:34.00,0:16:37.03,Default,,0,0,0,,عندما يتقاطع السماء والأعماق"
Dialogue: 0,0:16:37.03,0:16:39.64,Default,,0,0,0,,‫يُخلق طريق، وسيفتح الباب."
Dialogue: 0,0:16:43.61,0:16:47.53,Default,,0,0,0,,‫بالمناسبة، برج بابل مذكور في سفر التكوين.
Dialogue: 0,0:16:48.16,0:16:54.12,Default,,0,0,0,,‫"هيا نبني لأنفسنا مدينة، وبرجاً يصل إلى السماء."
Dialogue: 0,0:16:58.41,0:16:59.79,Default,,0,0,0,,‫الهاوية...
Dialogue: 0,0:17:01.04,0:17:04.26,Default,,0,0,0,,‫هاوية... أعماق...
Dialogue: 0,0:17:05.42,0:17:08.62,Default,,0,0,0,,‫برج بابل... السماء...
Dialogue: 0,0:17:13.06,0:17:20.44,Default,,0,0,0,,أخبريني، هل يمكننا وضع برج بابل في تلك الحفرة التي تسمى الهاوية؟
Dialogue: 0,0:17:20.44,0:17:22.85,Default,,0,0,0,,يا كونان، ماذا تقول؟
Dialogue: 0,0:17:22.85,0:17:24.16,Default,,0,0,0,,هل يمكننا؟
Dialogue: 0,0:17:24.16,0:17:25.93,Default,,0,0,0,,‫اسمع أيها الفتى...
Dialogue: 0,0:17:25.93,0:17:27.86,Default,,0,0,0,,‫من الواضح أنه لا يمكننا.
Dialogue: 0,0:17:27.86,0:17:30.24,Default,,0,0,0,,ما الأمر يا آنسة نيجي؟
Dialogue: 0,0:17:30.59,0:17:32.13,Default,,0,0,0,,‫آنسة مايماي.
Dialogue: 0,0:17:32.52,0:17:37.36,Default,,0,0,0,,‫هذا الفتى يريد وضع برج بابل داخل الهاوية.
Dialogue: 0,0:17:38.90,0:17:41.05,Default,,0,0,0,,‫بالطبع يريد.
Dialogue: 0,0:17:41.05,0:17:45.18,Default,,0,0,0,,‫في الواقع، أردتُ فعل الشيء نفسه عندما كنتُ طفلة.
Dialogue: 0,0:17:45.18,0:17:46.38,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:17:47.04,0:17:48.39,Default,,0,0,0,,هل نفعلها؟
Dialogue: 0,0:17:48.39,0:17:49.51,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:17:49.51,0:17:53.18,Default,,0,0,0,,مهلاً يا آنسة مايماي، هل أنتِ متأكدة من هذا؟
Dialogue: 0,0:17:53.18,0:17:57.01,Default,,0,0,0,,لا بأس. أليس كذلك يا أبي؟
Dialogue: 0,0:18:01.94,0:18:04.71,Default,,0,0,0,,‫جميل، لقد تناسب تماماً.
Dialogue: 0,0:18:04.71,0:18:06.77,Default,,0,0,0,,‫أليس كذلك؟ ها نحن.
Dialogue: 0,0:18:06.77,0:18:07.52,Default,,0,0,0,,‫حسناً.
Dialogue: 0,0:18:07.52,0:18:08.78,Default,,0,0,0,,‫استعدوا...
Dialogue: 0,0:18:11.71,0:18:13.35,Default,,0,0,0,,‫لقد أحدث صوتاً للتو.
Dialogue: 0,0:18:16.78,0:18:18.40,Default,,0,0,0,,مـ-ماذا يحدث؟
Dialogue: 0,0:18:19.41,0:18:20.79,Default,,0,0,0,,‫الغرفة...
Dialogue: 0,0:18:22.79,0:18:24.78,Default,,0,0,0,,مـ-ماذا يحدث؟
Dialogue: 0,0:18:35.30,0:18:37.30,Default,,0,0,0,,‫لـ-لقد توقف.
Dialogue: 0,0:18:37.71,0:18:40.93,Default,,0,0,0,,مهلاً، ماذا يحدث؟ ماذا حدث؟
Dialogue: 0,0:18:41.41,0:18:45.69,Default,,0,0,0,,‫هذه الغرفة بأكملها هي مصعد.
Dialogue: 0,0:18:45.69,0:18:47.23,Default,,0,0,0,,‫ماذا قلت؟!
Dialogue: 0,0:18:47.23,0:18:51.99,Default,,0,0,0,,لكن كيف نعود إلى الطابق العلوي؟
Dialogue: 0,0:18:51.99,0:18:54.24,Default,,0,0,0,,‫سنستخدم الدرج الحلزوني.
Dialogue: 0,0:18:54.58,0:18:56.73,Default,,0,0,0,,‫لهذا صُنع.
Dialogue: 0,0:18:56.73,0:18:58.11,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:18:58.11,0:19:00.14,Default,,0,0,0,,‫سأذهب لأتفقده.
Dialogue: 0,0:19:01.08,0:19:03.20,Default,,0,0,0,,‫انتظر و أنا أيضاً.
Dialogue: 0,0:19:17.65,0:19:19.85,Default,,0,0,0,,‫تلك هي الفتحة التي رأيتها سابقاً.
Dialogue: 0,0:19:22.61,0:19:25.60,Default,,0,0,0,,‫فهمت. الفتحة مزيفة.
Dialogue: 0,0:19:25.60,0:19:28.02,Default,,0,0,0,,‫إنها في الواقع مدخل الغرفة السرية.
Dialogue: 0,0:19:29.05,0:19:30.94,Default,,0,0,0,,‫مهلاً، أيها الفتى!
Dialogue: 0,0:19:31.51,0:19:32.65,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:19:32.65,0:19:35.53,Default,,0,0,0,,‫ربما مدخل غرفة سرية.
Dialogue: 0,0:19:35.53,0:19:37.26,Default,,0,0,0,,غرفة سرية؟
Dialogue: 0,0:19:42.00,0:19:44.70,Default,,0,0,0,,ماذا؟ هل المصباح عطل؟
Dialogue: 0,0:19:50.46,0:19:54.70,Default,,0,0,0,,‫هذه الأعمال لا تشبه تلك الموجودة في غرف المعارض.
Dialogue: 0,0:19:55.07,0:19:58.38,Default,,0,0,0,,‫إنها شريرة نوعاً ما.
Dialogue: 0,0:19:58.38,0:20:04.13,Default,,0,0,0,,‫ربما هي أعماله المبكرة عندما درس في فرنسا.
Dialogue: 0,0:20:04.67,0:20:07.89,Default,,0,0,0,,"‫"...Une descente dans le Maelstrom
Dialogue: 0,0:20:08.32,0:20:10.15,Default,,0,0,0,,ماذا يعني ذلك؟
Dialogue: 0,0:20:10.15,0:20:13.52,Default,,0,0,0,,‫"نزول إلى المتاهة"، على ما أعتقد.
Dialogue: 0,0:20:13.97,0:20:18.32,Default,,0,0,0,,‫نزول إلى المتاهة. لإدغار آلان بو.
Dialogue: 0,0:20:19.99,0:20:24.33,Default,,0,0,0,,‫هناك نقش بالفرنسية. سأترجمه.
Dialogue: 0,0:20:24.33,0:20:29.45,Default,,0,0,0,,‫"أولاً، خاف من المتاهة التي امتدت إلى الأعماق.
Dialogue: 0,0:20:29.45,0:20:31.33,Default,,0,0,0,,‫ثم، انجذب إليها.
Dialogue: 0,0:20:31.33,0:20:37.75,Default,,0,0,0,,‫في ذلك الشغف المتاهي، رأى فرحة لا تنتهي.
Dialogue: 0,0:20:38.34,0:20:46.47,Default,,0,0,0,,‫لوحات، أواني، مباخر، لولبيات، أمونيتات، نوتيلوس، أصداف.
Dialogue: 0,0:20:47.10,0:20:50.66,Default,,0,0,0,,‫بدأ بجمع كل أنواع الحلزونيات.
Dialogue: 0,0:20:52.51,0:20:55.46,Default,,0,0,0,,‫شعرت خطيبته بالغيرة.
Dialogue: 0,0:20:55.46,0:21:02.18,Default,,0,0,0,,‫لاستعادة حبه، بدأت برمي مجموعته الحلزونية.
Dialogue: 0,0:21:02.74,0:21:06.57,Default,,0,0,0,,‫غضب الرجل وقتل خطيبته.
Dialogue: 0,0:21:07.50,0:21:10.75,Default,,0,0,0,,‫ثم اختفى.
Dialogue: 0,0:21:11.16,0:21:14.09,Default,,0,0,0,,ابتلعته عالم الأفكار
Dialogue: 0,0:21:14.09,0:21:19.76,Default,,0,0,0,,‫التي كانت موجودة فقط في الحلزونات التي رسمها."
Dialogue: 0,0:21:22.17,0:21:25.36,Default,,0,0,0,,حسناً، هناك بالفعل غرفة سرية
Dialogue: 0,0:21:25.36,0:21:29.68,Default,,0,0,0,,لكن لا يمكن الوصول إليها دون تفعيل الآلية
Dialogue: 0,0:21:29.68,0:21:32.91,Default,,0,0,0,,‫مما يعني أنها غير مرتبطة بهذه القضية.
Dialogue: 0,0:21:32.91,0:21:33.90,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:21:34.30,0:21:38.55,Default,,0,0,0,,‫بالمناسبة، آنسة مايماي، لا أرى السيد أوماغاري هنا.
Dialogue: 0,0:21:38.55,0:21:42.57,Default,,0,0,0,,‫خرج في نزهة حوالي الساعة الواحدة.
Dialogue: 0,0:21:42.98,0:21:46.60,Default,,0,0,0,,‫إنه يأخذ وقته حقاً. إنها الثالثة بالفعل.
Dialogue: 0,0:21:46.60,0:21:49.08,Default,,0,0,0,,هل يأخذ دوماً مثل هذه النزهات الطويلة؟
Dialogue: 0,0:21:49.08,0:21:53.58,Default,,0,0,0,,‫لا. عادةً، يمشي لمدة ساعة على الأكثر.
Dialogue: 0,0:21:54.95,0:21:57.93,Default,,0,0,0,,‫تاكاغي، اذهب لإحضار السيد أوماغاري.
Dialogue: 0,0:21:57.93,0:21:58.93,Default,,0,0,0,,‫حاضر.
Dialogue: 0,0:22:25.39,0:22:30.87,DC-ED,,0,0,0,,‫الوقت يمضي، مرة أخرى
Dialogue: 0,0:22:31.27,0:22:35.45,DC-ED,,0,0,0,,‫أن أصادف أزهار الكرز
Dialogue: 0,0:22:36.26,0:22:41.57,DC-ED,,0,0,0,,‫قلبي يترقّب قدومك بفارغ الصبر
Dialogue: 0,0:22:41.76,0:22:46.61,DC-ED,,0,0,0,,‫كالزهرة المتفتحة
Dialogue: 0,0:22:47.16,0:22:53.00,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:22:58.88,0:23:07.99,DC-ED,,0,0,0,,‫مشاعر الاشتياق التي لا تُقابل باللقاء
Dialogue: 0,0:23:09.54,0:23:13.43,DC-ED,,0,0,0,,‫تستمر بلا نهاية
Dialogue: 0,0:23:13.58,0:23:18.96,DC-ED,,0,0,0,,‫رغم محاولاتي المتكررة للنسيان
Dialogue: 0,0:23:20.32,0:23:22.37,DC-ED,,0,0,0,,‫أخبرتني
Dialogue: 0,0:23:22.37,0:23:25.43,DC-ED,,0,0,0,,‫كل المشاعر الدافئة
Dialogue: 0,0:23:25.43,0:23:29.83,DC-ED,,0,0,0,,‫لا تفارقني
Dialogue: 0,0:23:38.11,0:23:44.01,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:23:45.07,0:23:48.66,Default,,0,0,0,,أين كنتِ حوالي الساعة 1:15 مساءً؟
Dialogue: 0,0:23:45.07,0:24:09.09,sign_episode_preview,SIGN,0,0,0,, في الحلقة القادمة 
Dialogue: 0,0:23:49.71,0:23:51.45,Default,,0,0,0,,‫هل أنت جاد؟!
Dialogue: 0,0:23:51.45,0:23:54.60,Default,,0,0,0,,أين كان السيد أوماغاري يرسم؟
Dialogue: 0,0:23:55.29,0:23:56.46,Default,,0,0,0,,هل يمكن؟
Dialogue: 0,0:23:57.08,0:24:00.21,Default,,0,0,0,,‫لا تخبر أحداً آخر!
Dialogue: 0,0:24:02.09,0:24:03.59,Default,,0,0,0,,‫انتبهي!
Dialogue: 0,0:24:07.05,0:24:08.39,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:24:09.09,0:24:15.10,sign_next_episode,SIGN,0,0,0,,{\fs20}{\pos(320,45)}لغز القصر  : قصر المتاهة\Nالجزء الثاني 
Dialogue: 0,0:24:09.64,0:24:14.72,Default,,0,0,0,,‫الحلقة القادمة من كونان هي "لغز القصر : قصر المتاهة، الجزء الثاني!"
Dialogue: 0,0:24:30.11,0:24:32.92,Default,,0,0,0,,‫تلميح كونان القادم!{\an8}
Dialogue: 0,0:24:30.11,0:24:35.04,sign_hint_label,SIGN,0,0,0,,{\fs20}{\an2\fnImpact\pos(320,300)}{\3c&HB1ACAB&\c&H141722&}حبل
Dialogue: 0,0:24:32.92,0:24:34.31,Default,,0,0,0,,‫حبل!{\an8}
Dialogue: 0,0:24:35.04,0:24:36.42,Default,,0,0,0,,{\an8}فن حلزوني؟
Dialogue: 0,0:24:35.04,0:24:40.04,sign_dont_miss,SIGN,0,0,0,,{\fs20}{\pos(245,304)}لا تفوتوا الحلقة القادمة 
Dialogue: 0,0:24:36.42,0:24:38.51,Default,,0,0,0,,‫إنه يجعلني أشعر بالدوار! مثل هذه الحلزونيات المرعبة!{\an8}
