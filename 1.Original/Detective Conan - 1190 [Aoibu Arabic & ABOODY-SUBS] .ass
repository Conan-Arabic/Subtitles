Dialogue: 0,0:00:17.88,0:00:24.37,Default,,0,0,0,,.المرحلة الأولى من الجولة هي ركوب قطار سوبر هاكتو من أوساكا إلى توتوري
Dialogue: 0,0:00:24.80,0:00:26.01,Default,,0,0,0,,...ومن هناك
Dialogue: 0,0:00:26.01,0:00:31.17,Default,,0,0,0,,{\an8}نستقل حافلة إلى أعظم ينابيع ساخنة في منطقة تشوغوكو
Dialogue: 0,0:00:26.01,0:00:28.01,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}ينابيع ميساسا الساخنة
Dialogue: 0,0:00:31.17,0:00:34.01,Default,,0,0,0,,.والتي يعود تاريخها لأكثر من 850 عامًا
Dialogue: 0,0:00:34.01,0:00:36.52,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}مجمع ينابيع ميساسا
Dialogue: 0,0:00:38.88,0:00:42.40,Default,,0,0,0,,!لقد وصلنا إلى ينابيع ميساسا الساخنة
Dialogue: 0,0:00:42.90,0:00:46.30,Default,,0,0,0,,{\an8}.النُزل الذي سنقيم فيه على الجانب الآخر من هذا الجسر. هيا بنا
Dialogue: 0,0:00:42.90,0:00:46.90,sign_suspect,SIGN,0,0,0,,{\pos(320,290)\fad(500,500)}جسر كويتاني
Dialogue: 0,0:00:46.30,0:00:47.78,Default,,0,0,0,,{\an8}.يا كونان
Dialogue: 0,0:00:47.78,0:00:51.28,sign_1190_bridge_pont_koitani,SIGN,0,0,0,,{\an7\xshad5\yshad5\frz90\fnGeorgia\move(305,131,305,271)}جسر كويتاني
Dialogue: 0,0:00:48.15,0:00:51.28,Default,,0,0,0,,.هذا الجسر يُسمى جسر كويتاني
Dialogue: 0,0:00:51.79,0:00:55.41,Default,,0,0,0,,.ضفدع الكاجيكا يعيش في نهر ميساسا
Dialogue: 0,0:00:55.41,0:00:58.11,Default,,0,0,0,,إذا وضعت لوحة صورة أثناء فرك هذا
Dialogue: 0,0:00:58.11,0:01:01.42,Default,,0,0,0,,.يقولون أنك ستبقى مع حبيبك للأبد
Dialogue: 0,0:01:01.42,0:01:03.38,Default,,0,0,0,,.ربما أجرب ذلك
Dialogue: 0,0:01:03.38,0:01:05.59,Default,,0,0,0,,!لا يُجدي نفعًا
Dialogue: 0,0:01:05.59,0:01:07.45,Default,,0,0,0,,!اهدئي يا ساتشيو
Dialogue: 0,0:01:07.45,0:01:14.35,Default,,0,0,0,,.لكن يا ياسوتو! عمتي ووالدك لا يسمحان لنا بالزواج
Dialogue: 0,0:01:14.35,0:01:16.65,Default,,0,0,0,,{\an8}.لنجرب أن نطلب منهما مرة أخرى
Dialogue: 0,0:01:14.85,0:01:19.35,sign_suspect,SIGN,0,0,0,,{\pos(180,290)\fad(500,500)}(22) أوتسوبوكي ياسوتو
Dialogue: 0,0:01:14.85,0:01:19.35,sign_suspect,SIGN,0,0,0,,{\pos(480,290)\fad(500,500)}(22) يوميميا ساتشيو
Dialogue: 0,0:01:16.65,0:01:20.63,Default,,0,0,0,,{\an8}...لا فائدة. ربما علينا فقط
Dialogue: 0,0:01:20.63,0:01:21.63,Default,,0,0,0,,{\an8}...ربما
Dialogue: 0,0:01:21.63,0:01:25.61,Default,,0,0,0,,يا أنسة ساتشيو، ألم أمنعكِ من مقابلة ذلك الرجل؟
Dialogue: 0,0:01:25.61,0:01:27.18,Default,,0,0,0,,{\an8}.عمتي
Dialogue: 0,0:01:26.73,0:01:31.24,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(254,255)}(59)يوميميا كازوكو
Dialogue: 0,0:01:26.73,0:01:31.24,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(254,272)}عمة ساتشيو
Dialogue: 0,0:01:27.18,0:01:30.83,Default,,0,0,0,,{\an8}.لن أسمح لكِ أبدًا بالزواج من ذلك الرجل
Dialogue: 0,0:01:30.83,0:01:32.99,Default,,0,0,0,,{\an8}.أنا أعرف أنه منصب على المال
Dialogue: 0,0:01:34.25,0:01:35.52,Default,,0,0,0,,.سنعود إلى المنزل
Dialogue: 0,0:01:36.10,0:01:38.33,Default,,0,0,0,,.اتركيني يا عمة كازوكو
Dialogue: 0,0:01:38.33,0:01:41.22,Default,,0,0,0,,.أنسة كازوكو، من فضلك استمعي إلينا
Dialogue: 0,0:01:41.22,0:01:42.48,Default,,0,0,0,,!ياسوتو
Dialogue: 0,0:01:42.92,0:01:45.67,sign_suspect,SIGN,0,0,0,,{\pos(366,255)}(58) أوتسوبوكي هيساو
Dialogue: 0,0:01:42.92,0:01:45.67,sign_suspect,SIGN,0,0,0,,{\fs14\pos(366,272)}والد ياسوتو
Dialogue: 0,0:01:43.22,0:01:45.67,Default,,0,0,0,,{\an8}أتيت إلى هنا مرة أخرى؟
Dialogue: 0,0:01:46.00,0:01:47.07,Default,,0,0,0,,.أبي
Dialogue: 0,0:01:47.07,0:01:52.56,Default,,0,0,0,,!لن أسمح لك أبدًا بالزواج من ابنة أخت تلك المرأة
Dialogue: 0,0:01:52.56,0:01:53.56,Default,,0,0,0,,.سنعود إلى المنزل
Dialogue: 0,0:01:53.56,0:01:55.89,Default,,0,0,0,,!توقف! تبا
Dialogue: 0,0:01:55.89,0:01:58.01,Default,,0,0,0,,!دعني! دعني
Dialogue: 0,0:02:00.52,0:02:02.55,Default,,0,0,0,,في مواجهة لغز غير متوقع
Dialogue: 0,0:02:02.55,0:02:04.43,Default,,0,0,0,,!الحل الوحيد هو مهارات الاستنتاج الفائقة
Dialogue: 0,0:02:04.43,0:02:06.26,Default,,0,0,0,,!جسر كويتاني يجمع الحبيبان
Dialogue: 0,0:02:06.26,0:02:07.94,Default,,0,0,0,,لكن ماذا يحدث عندما يُفرق بينهما؟
Dialogue: 0,0:02:07.94,0:02:09.78,Default,,0,0,0,,يسعى وراء الحقيقة دائماً
Dialogue: 0,0:02:09.78,0:02:11.74,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:02:11.74,0:02:14.38,Default,,0,0,0,,!أسمه المحقق كونان
Dialogue: 0,0:02:15.61,0:02:19.37,DC-OP,,0,0,0,,‫ليس بوسعي تغييره بنفسي
Dialogue: 0,0:02:19.55,0:02:22.60,DC-OP,,0,0,0,,‫ما كان منك وما أصابك، فقد مضى وانتهى
Dialogue: 0,0:02:23.08,0:02:26.85,DC-OP,,0,0,0,,‫لا يُعرف من أين جاء ولا ما هو
Dialogue: 0,0:02:26.94,0:02:30.57,DC-OP,,0,0,0,,‫كأن يهاجمك أحد الوحوش
Dialogue: 0,0:02:30.86,0:02:34.64,DC-OP,,0,0,0,,‫أركض كي لا يلحقوا بي
Dialogue: 0,0:02:34.64,0:02:37.90,DC-OP,,0,0,0,,‫ربما يحدث خيراً، من يعلم؟
Dialogue: 0,0:02:38.30,0:02:42.20,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:02:42.20,0:02:46.21,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:02:46.21,0:02:49.92,DC-OP,,0,0,0,,‫أجعل عمق الليل يلمع باللون الوردي
Dialogue: 0,0:02:49.92,0:02:53.64,DC-OP,,0,0,0,,‫مهما طال الزمن، كل ما علي فعله هو المحاولة
Dialogue: 0,0:03:01.34,0:03:05.14,DC-OP,,0,0,0,,‫أبحث عن سعادة جديدة
Dialogue: 0,0:03:05.14,0:03:08.43,DC-OP,,0,0,0,,‫أين يكمن؟، لا احد يعلم
Dialogue: 0,0:03:08.76,0:03:12.86,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:03:12.86,0:03:16.27,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:03:16.46,0:03:19.87,DC-OP,,0,0,0,,‫أضيء على الذكريات المظلمة
Dialogue: 0,0:03:20.15,0:03:23.85,DC-OP,,0,0,0,,‫احدق فيها حتى يزول خوفها
Dialogue: 0,0:03:24.11,0:03:27.83,DC-OP,,0,0,0,,‫في لحظة تلتفت فيها إلى الماضي
Dialogue: 0,0:03:27.93,0:03:31.57,DC-OP,,0,0,0,,‫لم يكن سوى أن أطلقت أعظم دموعك
Dialogue: 0,0:03:56.13,0:04:02.01,sign_episode_title,SIGN,0,0,0,,{\fad(400,1)}الحبيب الذي اختفى على جسر كويتاني\Nجزء توتوري 
Dialogue: 0,0:03:56.51,0:04:00.71,Default,,0,0,0,,"!الحبيب الذي اختفى على جسر كويتاني، جزء توتوري"
Dialogue: 0,0:04:02.01,0:04:04.27,sign_suspect,SIGN,0,0,0,,{\pos(312,290)}نُزل يوميميا
Dialogue: 0,0:04:02.96,0:04:04.27,Default,,0,0,0,,{\an8}!أهلاً بكم
Dialogue: 0,0:04:04.27,0:04:07.02,Default,,0,0,0,,{\an8}.شكرًا لاختياركم نُزل يوميميا
Dialogue: 0,0:04:07.77,0:04:09.88,Default,,0,0,0,,.شكرًا لاستضافتكم لنا
Dialogue: 0,0:04:11.96,0:04:15.03,Default,,0,0,0,,.هذا النُزل رائع بالتأكيد
Dialogue: 0,0:04:15.03,0:04:17.28,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:04:17.61,0:04:22.56,Default,,0,0,0,,{\an8}.إنه أحد أقدم النُزل في ينابيع ميساسا الساخنة
Dialogue: 0,0:04:17.78,0:04:22.28,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(320,255)}(27 )يوميميا تيروكي
Dialogue: 0,0:04:17.78,0:04:22.28,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(320,272)}ابن كازوكو
Dialogue: 0,0:04:22.56,0:04:25.73,Default,,0,0,0,,{\an8}.تم تصنيفه كملك ثقافي وطني
Dialogue: 0,0:04:27.21,0:04:28.20,Default,,0,0,0,,.أنسة يوشيمي
Dialogue: 0,0:04:28.63,0:04:30.42,Default,,0,0,0,,.ليس من ذلك الطريق
Dialogue: 0,0:04:30.42,0:04:33.79,Default,,0,0,0,,.إلى اليمين، هناك
Dialogue: 0,0:04:34.04,0:04:37.80,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\pos(299,234)}(35)كوموري يوشيمي
Dialogue: 0,0:04:34.04,0:04:37.80,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(299,251)}نادلة
Dialogue: 0,0:04:34.41,0:04:37.80,Default,,0,0,0,,{\an8}.صحيح. أنا... أنا آسفة
Dialogue: 0,0:04:40.26,0:04:43.43,Default,,0,0,0,,.إنها جميلة. يالها من كيمونو رائعة
Dialogue: 0,0:04:43.96,0:04:46.92,Default,,0,0,0,,.النُزل يفخر بامتلاك هذه التحفة
Dialogue: 0,0:04:46.92,0:04:49.29,Default,,0,0,0,,."إنها تُسمى "يوميزاكرا
Dialogue: 0,0:04:49.29,0:04:51.94,Default,,0,0,0,,يوميزاكرا، أليس كذلك؟
Dialogue: 0,0:04:51.94,0:04:55.07,Default,,0,0,0,,إنها للعرض فقط؟ لا يرتديها أحد؟
Dialogue: 0,0:04:56.15,0:04:59.70,Default,,0,0,0,,.سترتديها قريبًا
Dialogue: 0,0:05:02.41,0:05:04.95,Default,,0,0,0,,...إنها تلك المرأة من على الجسر
Dialogue: 0,0:05:05.27,0:05:07.95,Default,,0,0,0,,.إذن فهي تعمل هنا
Dialogue: 0,0:05:09.14,0:05:10.61,Default,,0,0,0,,خمن من؟
Dialogue: 0,0:05:12.74,0:05:14.33,Default,,0,0,0,,{\an8}.إنه ياماني كاتسوهيكو
Dialogue: 0,0:05:12.88,0:05:16.88,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(505,265)}(36) ياماني كاتسوهيكو
Dialogue: 0,0:05:12.88,0:05:16.88,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(505,282)}محقق في شرطة كورايوشي
Dialogue: 0,0:05:13.88,0:05:16.88,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(320,265)}(25) أوكاموتو ريو
Dialogue: 0,0:05:13.88,0:05:16.88,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(320,282)}محقق في شرطة كورايوشي
Dialogue: 0,0:05:14.33,0:05:16.54,Default,,0,0,0,,{\an8}!وأوكاموتو ريو
Dialogue: 0,0:05:17.52,0:05:23.43,Default,,0,0,0,,{\an8}.شكرًا لمساعدتك في قضية سرقة عائلة كورايوشي كومادو
Dialogue: 0,0:05:23.75,0:05:25.93,Default,,0,0,0,,.إنهما ضابطا شرطة كورايوشي
Dialogue: 0,0:05:25.93,0:05:29.15,Default,,0,0,0,,ماذا تفعلان أنتما هنا؟
Dialogue: 0,0:05:29.15,0:05:35.30,Default,,0,0,0,,.ألقينا القبض على سارق حقائب متسلسل الأسبوع الماضي، لذلك نحتفل
Dialogue: 0,0:05:35.30,0:05:36.82,Default,,0,0,0,,.انضم إلينا يا سيد موري
Dialogue: 0,0:05:36.82,0:05:39.69,Default,,0,0,0,,.حسنًا، إذا أصررتما
Dialogue: 0,0:05:42.40,0:05:46.20,Default,,0,0,0,,!الخطوة الأولى: تحرك بسرعة، كسرعة الضوء
Dialogue: 0,0:05:46.72,0:05:51.71,Default,,0,0,0,,!الخطوة الثانية: استفسر على نطاق واسع، كالماء المنتشر
Dialogue: 0,0:05:51.71,0:05:53.56,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:05:53.56,0:05:58.25,Default,,0,0,0,,!الخطوة الثالثة: كن صامتًا، وستكشف الحقيقة عن نفسها
Dialogue: 0,0:05:58.70,0:06:00.30,Default,,0,0,0,,هل فهمتما كل ذلك؟
Dialogue: 0,0:06:00.30,0:06:01.22,Default,,0,0,0,,!نعم
Dialogue: 0,0:06:01.22,0:06:04.55,Default,,0,0,0,,...الخطوة الثالثة بالنسبة لك هي النوم
Dialogue: 0,0:06:04.55,0:06:07.60,Default,,0,0,0,,.تفضل، خذ كوب عصير آخر
Dialogue: 0,0:06:07.92,0:06:10.02,Default,,0,0,0,,.شكرًا يا أنسة ساتشيو
Dialogue: 0,0:06:10.02,0:06:13.11,Default,,0,0,0,,أ-أتعرفني؟
Dialogue: 0,0:06:13.11,0:06:17.23,Default,,0,0,0,,كنتِ مع رجل على جسر كويتاني، أليس كذلك؟
Dialogue: 0,0:06:17.53,0:06:20.73,Default,,0,0,0,,.ياللسوء، أنا آسفة لأنكم شاهدتما ذلك
Dialogue: 0,0:06:21.06,0:06:23.61,Default,,0,0,0,,هل أقاربك يعارضون زواجك؟
Dialogue: 0,0:06:25.29,0:06:26.28,Default,,0,0,0,,...أظن ذلك
Dialogue: 0,0:06:26.28,0:06:29.87,Default,,0,0,0,,.ساتشيو هي وريثة هذا النُزل
Dialogue: 0,0:06:30.37,0:06:31.84,Default,,0,0,0,,‫عمي.
Dialogue: 0,0:06:31.84,0:06:33.00,Default,,0,0,0,,‫"عمي"؟
Dialogue: 0,0:06:33.31,0:06:36.21,Default,,0,0,0,,{\an8}.تشرفنا. اسمي كاسوغا
Dialogue: 0,0:06:34.42,0:06:38.92,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(320,255)}(48)كاسوغا ماساميتشي
Dialogue: 0,0:06:34.42,0:06:38.92,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(320,272)}عم ساتشيو
Dialogue: 0,0:06:36.21,0:06:39.40,Default,,0,0,0,,{\an8}.أنا قريب بعيد
Dialogue: 0,0:06:39.40,0:06:41.42,Default,,0,0,0,,.لقد جئت من طوكيو
Dialogue: 0,0:06:41.42,0:06:45.98,Default,,0,0,0,,.حقًا؟، نحن أيضًا من طوكيو
Dialogue: 0,0:06:45.98,0:06:47.39,Default,,0,0,0,,.تناول مشروبًا
Dialogue: 0,0:06:47.77,0:06:49.47,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:06:49.47,0:06:52.16,Default,,0,0,0,,يا سيد كاسوغا، ماذا تقصد بوريثة؟
Dialogue: 0,0:06:52.16,0:06:57.35,Default,,0,0,0,,.ذلك؟. الحقيقة أن والدا ساتشيو كانا يديران هذا النُزل
Dialogue: 0,0:06:58.31,0:07:00.24,Default,,0,0,0,,لكن والدها توفي وهي صغيرة
Dialogue: 0,0:07:00.24,0:07:04.31,Default,,0,0,0,,.وتوفيت والدتها بسبب مرض منذ ستة أشهر
Dialogue: 0,0:07:04.31,0:07:07.82,Default,,0,0,0,,.الآن، عمتها أنسة كازوكو هي المديرة بالنيابة عنهما
Dialogue: 0,0:07:07.82,0:07:11.70,Default,,0,0,0,,لكن لماذا تعارض أنسة كازوكو زواجها؟
Dialogue: 0,0:07:12.16,0:07:16.33,Default,,0,0,0,,عمتي كازوكو كانت ذات مرة في نزاع على ممتلكات
Dialogue: 0,0:07:16.33,0:07:21.28,Default,,0,0,0,,.قرب مدينة كورايوشي مع والد سيد ياسوتو
Dialogue: 0,0:07:21.28,0:07:23.34,Default,,0,0,0,,.ما زالا يكرهان بعضهما
Dialogue: 0,0:07:23.34,0:07:26.09,Default,,0,0,0,,.لذلك فهما يعارضان الزواج
Dialogue: 0,0:07:26.09,0:07:31.02,Default,,0,0,0,,عندما سمعت أن العلاقة بين ساتشيو و سيد كازوكو متوترة
Dialogue: 0,0:07:31.02,0:07:33.52,Default,,0,0,0,,.جئت للاطمئنان عليها
Dialogue: 0,0:07:34.50,0:07:37.83,Default,,0,0,0,,لكنكِ تحبينه، أليس كذلك؟
Dialogue: 0,0:07:37.83,0:07:38.83,Default,,0,0,0,,.نعم
Dialogue: 0,0:07:40.06,0:07:43.02,Default,,0,0,0,,.إذن، فأنا ادعمكما
Dialogue: 0,0:07:43.02,0:07:45.82,Default,,0,0,0,,‫إذا كنتما تحبان بعضكما، فلا يجب أن تستسلما!
Dialogue: 0,0:07:45.82,0:07:48.07,Default,,0,0,0,,.نعم. شكرًا لكِ
Dialogue: 0,0:07:49.11,0:07:50.93,Default,,0,0,0,,!أنا آسفة
Dialogue: 0,0:07:51.31,0:07:53.24,Default,,0,0,0,,.أنا آسفة جدًا
Dialogue: 0,0:07:56.25,0:07:58.55,Default,,0,0,0,,.سأحضر لك يوكاتا جديدة
Dialogue: 0,0:07:58.55,0:08:00.93,Default,,0,0,0,,.أنسة يوشيمي، خذي هذا الفتى إلى الحمام
Dialogue: 0,0:08:01.46,0:08:04.02,Default,,0,0,0,,.حـ-حسنًا. لنذهب
Dialogue: 0,0:08:04.02,0:08:06.38,Default,,0,0,0,,.لا بأس
Dialogue: 0,0:08:12.06,0:08:15.31,Default,,0,0,0,,.أخبرتكِ، لا بأس
Dialogue: 0,0:08:17.08,0:08:18.63,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,0:08:18.63,0:08:20.59,Default,,0,0,0,,.لقد أخطأت مرة أخرى
Dialogue: 0,0:08:20.59,0:08:26.49,Default,,0,0,0,,.مرت ستة أشهر منذ أن تم تعييني، لكني أواصل ارتكاب الأخطاء
Dialogue: 0,0:08:26.85,0:08:30.62,Default,,0,0,0,,.انظري، لديكِ بقعة على مريولك
Dialogue: 0,0:08:30.62,0:08:32.49,Default,,0,0,0,,لماذا لا تحضرين واحدة جديدة؟
Dialogue: 0,0:08:33.40,0:08:36.82,Default,,0,0,0,,.شكرًا لك. أنت لطيف جدًا
Dialogue: 0,0:08:36.82,0:08:38.41,Default,,0,0,0,,‫أنسة يوشيمي!
Dialogue: 0,0:08:38.41,0:08:42.00,Default,,0,0,0,,أظننتِ أنكِ ستُغفرين إذا كسبتِ تعاطف ذلك الفتى؟
Dialogue: 0,0:08:42.00,0:08:43.92,Default,,0,0,0,,.لا، لم يكن ذلك قصدي
Dialogue: 0,0:08:44.25,0:08:45.47,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:08:45.47,0:08:48.49,Default,,0,0,0,,لقد وظفتك لأنكِ لم يكن لديكِ مكان تذهبين إليه
Dialogue: 0,0:08:48.49,0:08:51.80,Default,,0,0,0,,.لكنكِ تستمرين في الإضرار بسمعتنا
Dialogue: 0,0:08:51.80,0:08:53.51,Default,,0,0,0,,.أنا آسفة جدًا
Dialogue: 0,0:08:53.51,0:08:56.04,Default,,0,0,0,,!أنسة يوشيمي، توقفي من فضلك
Dialogue: 0,0:08:56.04,0:08:58.88,Default,,0,0,0,,.لكنها غلطتي
Dialogue: 0,0:08:58.88,0:09:00.31,Default,,0,0,0,,.لا، دعيني أتحدث
Dialogue: 0,0:09:01.02,0:09:04.31,Default,,0,0,0,,.عمتي، لم أعد أتحمل أكثر من ذلك
Dialogue: 0,0:09:04.31,0:09:06.82,Default,,0,0,0,,ماذا تقصدين؟
Dialogue: 0,0:09:07.20,0:09:09.52,Default,,0,0,0,,.أنا لا أتحدث فقط عن زواجي
Dialogue: 0,0:09:09.52,0:09:11.57,Default,,0,0,0,,.أنتِ قاسية مع أنسة يوشيمي أيضًا
Dialogue: 0,0:09:11.57,0:09:13.76,Default,,0,0,0,,أين الخطأ في ذلك؟
Dialogue: 0,0:09:13.76,0:09:16.45,Default,,0,0,0,,.كل ما أقوله صحيح
Dialogue: 0,0:09:16.45,0:09:17.96,Default,,0,0,0,,...لكن
Dialogue: 0,0:09:17.96,0:09:20.96,Default,,0,0,0,,.يا أنسة كازوكو، يكفي هذا
Dialogue: 0,0:09:22.33,0:09:26.95,Default,,0,0,0,,يا سيد كاسوغا، شركتك تعاني من أزمة مالية، أليس كذلك؟
Dialogue: 0,0:09:26.95,0:09:30.17,Default,,0,0,0,,.لسوء الحظ، لن أقرضك أي شيء
Dialogue: 0,0:09:31.09,0:09:34.97,Default,,0,0,0,,.أمي، هذه أشياء لا يجب ان تقوليها
Dialogue: 0,0:09:35.34,0:09:39.97,Default,,0,0,0,,تيروكي، لقد غرقت في الديون بعد أن أنفقت كل أموالك على امرأة في أوساكا
Dialogue: 0,0:09:39.97,0:09:42.36,Default,,0,0,0,,.ثم عدت إلى المنزل باكيًا
Dialogue: 0,0:09:42.36,0:09:44.88,Default,,0,0,0,,.وأراهن أنك تحمل ديونًا أكثر
Dialogue: 0,0:09:45.82,0:09:46.92,Default,,0,0,0,,.اسمعيني جيداً
Dialogue: 0,0:09:46.92,0:09:49.66,Default,,0,0,0,,والدتكِ الراحلة طلبت مني أن أراقبك
Dialogue: 0,0:09:49.66,0:09:54.36,Default,,0,0,0,,.بعناية حتى تتمكني من تولي إدارة هذا النُزل
Dialogue: 0,0:09:54.36,0:09:57.00,Default,,0,0,0,,.هذه مسؤوليتي
Dialogue: 0,0:09:57.00,0:10:01.75,Default,,0,0,0,,نعم، لكنكِ في الحقيقة لا تريدين أن تعطيني هذا النُزل، أليس كذلك؟
Dialogue: 0,0:10:01.75,0:10:03.43,Default,,0,0,0,,.أنتِ مخطئة
Dialogue: 0,0:10:03.43,0:10:08.41,Default,,0,0,0,,لهذا أريدكِ أن تتزوجي من رجل يعتمد عليه
Dialogue: 0,0:10:08.41,0:10:11.01,Default,,0,0,0,,.بدلاً من ابن ذلك البخيل
Dialogue: 0,0:10:11.38,0:10:14.80,Default,,0,0,0,,.لن أسمح لكِ أبدًا بالزواج من ذلك الرجل
Dialogue: 0,0:10:14.80,0:10:16.01,Default,,0,0,0,,مفهوم؟
Dialogue: 0,0:10:17.15,0:10:18.64,Default,,0,0,0,,.مفهوم
Dialogue: 0,0:10:19.51,0:10:21.57,Default,,0,0,0,,.انتظري يا ساتشيو
Dialogue: 0,0:10:25.31,0:10:28.23,Default,,0,0,0,,.آسف لأنك شاهدت ذلك
Dialogue: 0,0:10:28.23,0:10:29.61,Default,,0,0,0,,.لا بأس
Dialogue: 0,0:10:29.61,0:10:32.74,Default,,0,0,0,,يا سيد تيروكي، هل أنت ابن الأنسة كازوكو؟
Dialogue: 0,0:10:33.04,0:10:36.02,Default,,0,0,0,,.نعم. لا أستطيع مجاراتها
Dialogue: 0,0:10:36.02,0:10:38.83,Default,,0,0,0,,.تبًا، أنا مُهان
Dialogue: 0,0:10:39.87,0:10:42.35,Default,,0,0,0,,.تفضل، ها هي يوكاتا جديدة
Dialogue: 0,0:10:42.35,0:10:44.25,Default,,0,0,0,,.شكرًا
Dialogue: 0,0:10:48.43,0:10:52.54,Default,,0,0,0,,.لم أعد أتحمل عمة كازوكو بعد الآن
Dialogue: 0,0:10:52.54,0:10:56.64,Default,,0,0,0,,.ساتشيو، أفهم شعورك، لكن اهدئي
Dialogue: 0,0:10:56.64,0:10:57.92,Default,,0,0,0,,...لكن
Dialogue: 0,0:10:58.67,0:11:02.52,Default,,0,0,0,,.أنا آسفة لأني أجعلك تقلق دائمًا يا عمي
Dialogue: 0,0:11:02.52,0:11:04.16,Default,,0,0,0,,...ساتشيو
Dialogue: 0,0:11:07.04,0:11:10.30,Default,,0,0,0,,.أنسة يوشيمي، هذا كثير جدًا
Dialogue: 0,0:11:10.30,0:11:11.80,Default,,0,0,0,,.نعم
Dialogue: 0,0:11:11.80,0:11:14.53,Default,,0,0,0,,ماذا لو أسقطتِ شيئًا مرة أخرى؟
Dialogue: 0,0:11:14.53,0:11:17.73,Default,,0,0,0,,‫أنا عائد إلى قاعة الوليمة على أي حال. سأساعدكِ.
Dialogue: 0,0:11:17.73,0:11:19.53,Default,,0,0,0,,‫شكرًا لك.
Dialogue: 0,0:11:20.42,0:11:24.54,Default,,0,0,0,,‫يكون الأمر أسهل بكثير عندما تأتي إلي، كما تعلم.
Dialogue: 0,0:11:24.84,0:11:27.42,Default,,0,0,0,,عندما أتي إليك؟
Dialogue: 0,0:11:27.42,0:11:29.67,Default,,0,0,0,,‫أنتِ محقة. إنه أسهل.
Dialogue: 0,0:11:53.50,0:11:54.59,Default,,0,0,0,,هل وجدتموها؟
Dialogue: 0,0:11:54.59,0:11:55.65,Default,,0,0,0,,‫لا.
Dialogue: 0,0:11:55.96,0:11:57.90,Default,,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:11:59.41,0:12:03.02,Default,,0,0,0,,‫سيد موري! من فضلك استيقظ، سيد موري!
Dialogue: 0,0:12:04.02,0:12:06.41,Default,,0,0,0,,هل هناك مشكلة؟
Dialogue: 0,0:12:06.74,0:12:09.57,Default,,0,0,0,,‫إحدى النادلات مفقودة!
Dialogue: 0,0:12:09.57,0:12:11.04,Default,,0,0,0,,مفقودة؟
Dialogue: 0,0:12:11.04,0:12:13.30,Default,,0,0,0,,هل هي أنسة ساتشيو؟
Dialogue: 0,0:12:13.30,0:12:18.59,Default,,0,0,0,,‫نعم. عادةً، تكون أول من يصل إلى المطبخ، لكنها ليست هناك.
Dialogue: 0,0:12:18.59,0:12:21.85,Default,,0,0,0,,‫ذهبت إلى غرفتها، لكنها لم تكن هناك أيضًا.
Dialogue: 0,0:12:22.15,0:12:27.10,Default,,0,0,0,,‫إنها مسؤولة جدًا، لذا لم يحدث هذا من قبل.
Dialogue: 0,0:12:27.10,0:12:29.52,Default,,0,0,0,,أنسة ساتشيو مفقودة؟
Dialogue: 0,0:12:29.52,0:12:32.48,Default,,0,0,0,,أين يمكن أن تكون ذهبت تلك الفتاة؟
Dialogue: 0,0:12:32.89,0:12:35.70,Default,,0,0,0,,‫سيد موري، أنت محقق.
Dialogue: 0,0:12:35.70,0:12:37.38,Default,,0,0,0,,هل يمكنكَ البحث عنها؟
Dialogue: 0,0:12:37.38,0:12:39.99,Default,,0,0,0,,‫هيا يا أمي. اطلبي مساعدتهُ.
Dialogue: 0,0:12:41.42,0:12:43.03,Default,,0,0,0,,‫إذن، ما باليد حيلة.
Dialogue: 0,0:12:43.03,0:12:45.20,Default,,0,0,0,,‫هذا سيؤثر على عملنا أيضًا.
Dialogue: 0,0:12:45.20,0:12:46.87,Default,,0,0,0,,هل ستساعدنا؟
Dialogue: 0,0:12:46.87,0:12:50.61,Default,,0,0,0,,‫أنا هنا فقط في جولة سياحية.
Dialogue: 0,0:12:53.93,0:12:55.15,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:12:57.29,0:13:01.81,Default,,0,0,0,,‫الخطوة الأولى: تحرك بسرعة، كسرعة الضوء!
Dialogue: 0,0:13:01.81,0:13:03.01,Default,,0,0,0,,‫نعم!
Dialogue: 0,0:13:03.44,0:13:06.01,Default,,0,0,0,,‫اطلب التعزيزات من مركز شرطة ميساسا.
Dialogue: 0,0:13:06.01,0:13:07.14,Default,,0,0,0,,‫مفهوم.
Dialogue: 0,0:13:12.25,0:13:13.26,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:13:13.27,0:13:16.53,sign_1190_construction,SIGN,0,0,0,,{\move(136,150,489,150)\frz90\fnGeorgia\an8}شركة أوتسوبوكي للمقاولات
Dialogue: 0,0:13:14.72,0:13:16.53,Default,,0,0,0,,ساتشيو مفقودة؟
Dialogue: 0,0:13:16.53,0:13:19.53,Default,,0,0,0,,نعم. هل تعرف أين هي يا ياسوتو؟
Dialogue: 0,0:13:19.53,0:13:23.05,Default,,0,0,0,,‫لـ-لا، لم تأتِ إلى هنا.
Dialogue: 0,0:13:24.94,0:13:27.57,Default,,0,0,0,,‫ساتشيو فعلتها حقًا...
Dialogue: 0,0:13:28.34,0:13:31.04,Default,,0,0,0,,‫لم تذهب إلى كورايوشي أيضًا.
Dialogue: 0,0:13:33.08,0:13:35.29,Default,,0,0,0,,‫لقد أحضرنا مشتبهًا به محتملاً.
Dialogue: 0,0:13:35.29,0:13:36.21,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:36.47,0:13:40.43,Default,,0,0,0,,‫هذا الرجل كان يتجول قرب جسر كاجيكا.
Dialogue: 0,0:13:40.43,0:13:43.05,Default,,0,0,0,,‫اسمه سيد كيتامي توشيهيرو.{\an8}
Dialogue: 0,0:13:43.05,0:13:47.56,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(417,254)}(31) كيتامي توشيهيرو 
Dialogue: 0,0:13:43.05,0:13:47.56,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(417,271)}مصور
Dialogue: 0,0:13:43.23,0:13:46.66,Default,,0,0,0,,‫ليس لي علاقة بهذا. أنا مجرد مصور.{\an8}
Dialogue: 0,0:13:46.66,0:13:48.69,Default,,0,0,0,,‫أتخصص في البرمائيات.{\an8}
Dialogue: 0,0:13:49.10,0:13:52.73,Default,,0,0,0,,‫لقد جئت فقط لالتقاط صور لضفادع كاجيكا في نهر ميساسا.
Dialogue: 0,0:13:52.73,0:13:55.13,Default,,0,0,0,,‫هذا ما يقوله، لكن...
Dialogue: 0,0:13:56.94,0:13:59.35,Default,,0,0,0,,‫هذه الأنسة ساتشيو.
Dialogue: 0,0:13:59.35,0:14:03.24,Default,,0,0,0,,‫جمالها كان لافتًا، فالتقطت صورتها. هذا كل شيء.
Dialogue: 0,0:14:03.24,0:14:04.76,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:14:04.76,0:14:07.42,Default,,0,0,0,,سيد كيتامي، أنا آسف
Dialogue: 0,0:14:07.42,0:14:11.00,Default,,0,0,0,,لكن هل يمكنك البقاء هنا حتى ننتهي من التحقيق؟
Dialogue: 0,0:14:11.32,0:14:15.38,Default,,0,0,0,,‫بالتأكيد، لا مشكلة. أنا أيضًا قلق عليها.
Dialogue: 0,0:14:16.44,0:14:20.44,Default,,0,0,0,,هل يمكنك التفكير في أي شخص آخر؟
Dialogue: 0,0:14:20.44,0:14:23.13,Default,,0,0,0,,‫ربما صديق مقرب لأنسة ساتشيو.
Dialogue: 0,0:14:23.13,0:14:26.38,Default,,0,0,0,,صديق مقرب؟
Dialogue: 0,0:14:27.46,0:14:28.51,Default,,0,0,0,,‫هنا.
Dialogue: 0,0:14:28.51,0:14:31.47,sign_1190_magazine,SIGN TOP,0,0,0,,{\c&H3D8A40&\b1\fs30\an9\bord2\shad2\pos(310,80)\fad(500)}جمعية\Nتوتوري\Nللفنون والثقافة
Dialogue: 0,0:14:28.51,0:14:33.10,sign_1190_magazine,SIGN YELLOW,0,0,0,,{\an4\c&H202020&\fad(1,500)\pos(552,118)}فنان
Dialogue: 0,0:14:29.32,0:14:32.51,Default,,0,0,0,,جمعية توتوري للفنون والثقافة؟
Dialogue: 0,0:14:31.39,0:14:38.77,sign_1190_magazine,SIGN BLUE,0,0,0,,{\an2\c&H202020&\frz3\fax0.1\move(94,354,94,154)}مرشد\Nجبلي
Dialogue: 0,0:14:32.51,0:14:33.76,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:14:33.76,0:14:38.77,Default,,0,0,0,,‫إنها شبكة من الشباب الذين يريدون الترويج للثقافة التقليدية في توتوري.
Dialogue: 0,0:14:39.18,0:14:43.87,Default,,0,0,0,,‫الأنسة ساتشيو كانت تزور هؤلاء الأشخاص بشكل متكرر مؤخرًا.
Dialogue: 0,0:14:43.87,0:14:44.78,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:14:44.78,0:14:47.78,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}محطة يوناكو 
Dialogue: 0,0:14:47.78,0:14:50.19,Default,,0,0,0,,‫هذا ممر جميل للمشي.
Dialogue: 0,0:14:50.19,0:14:52.86,Default,,0,0,0,,‫يبدو أنه تم الانتهاء منه مؤخرًا فقط.
Dialogue: 0,0:14:54.54,0:14:57.04,Default,,0,0,0,,‫هذا قطار ياكومو الجديد.{\an8}
Dialogue: 0,0:14:54.54,0:14:58.54,sign_suspect,SIGN,0,0,0,,{\pos(320,290)\fad(500,500)}قطار ياكومو السريع 
Dialogue: 0,0:14:57.04,0:14:59.79,Default,,0,0,0,,‫يسير من يوناغو إلى أوكاياما.{\an8}
Dialogue: 0,0:15:00.30,0:15:03.30,sign_suspect,SIGN,0,0,0,,{\pos(320,290)\fad(500,1)}ينابيع كايكه الساخنة 
Dialogue: 0,0:15:04.88,0:15:07.68,Default,,0,0,0,,‫من المفترض أنهم يقيمون جولة هنا...
Dialogue: 0,0:15:07.68,0:15:09.05,Default,,0,0,0,,‫لكن لا يوجد أحد هنا.
Dialogue: 0,0:15:09.05,0:15:12.06,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}المركز السياحي في مدينة يوناكو
Dialogue: 0,0:15:12.38,0:15:14.94,Default,,0,0,0,,هم في أطلال قلعة يوناغو؟
Dialogue: 0,0:15:14.94,0:15:18.06,Default,,0,0,0,,‫نعم. جاءنا طلب مفاجئ.
Dialogue: 0,0:15:20.32,0:15:22.82,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}أطلال قلعة يوناكو
Dialogue: 0,0:15:28.86,0:15:33.48,Default,,0,0,0,,يُقدر أن قلعة يوناغو بُنيت حوالي القرن الخامس عشر
Dialogue: 0,0:15:33.48,0:15:37.42,Default,,0,0,0,,‫وسُميت معلماً تاريخياً وطنياً في عام 2006.
Dialogue: 0,0:15:37.42,0:15:39.05,Default,,0,0,0,,‫يجب أن تكون هي.
Dialogue: 0,0:15:41.24,0:15:44.38,Default,,0,0,0,,‫ساتشيو لم تأتِ إلى هنا.
Dialogue: 0,0:15:44.38,0:15:45.84,Default,,0,0,0,,‫هكذا إذن.
Dialogue: 0,0:15:45.84,0:15:49.59,Default,,0,0,0,,هل تعلمين أين قد تكون ذهبت الأنسة ساتشيو؟
Dialogue: 0,0:15:49.92,0:15:51.31,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:15:51.98,0:15:54.10,Default,,0,0,0,,‫أشك في أنها ستذهب بعيدًا.
Dialogue: 0,0:15:54.10,0:15:55.48,Default,,0,0,0,,لماذا لا؟
Dialogue: 0,0:15:55.48,0:16:00.70,Default,,0,0,0,,‫ينابيع ميساسا الساخنة كانت مليئة بالفن في الماضي.
Dialogue: 0,0:16:00.70,0:16:05.78,Default,,0,0,0,,‫ساتشيو قالت إنها تريد إحياء تلك الثقافة.
Dialogue: 0,0:16:05.78,0:16:09.43,Default,,0,0,0,,أرادت أن تصبح مديرة عظيمة، وترتدي يوميزاكرا
Dialogue: 0,0:16:09.43,0:16:11.49,Default,,0,0,0,,‫وتصبح أنسة الفن بنفسها.
Dialogue: 0,0:16:11.85,0:16:15.45,Default,,0,0,0,,يوميزاكرا؟ تقصدين ذلك الكيمونو؟
Dialogue: 0,0:16:15.45,0:16:19.21,Default,,0,0,0,,‫نعم، لذلك من المحتمل أنها قريبة.
Dialogue: 0,0:16:21.46,0:16:24.46,Default,,0,0,0,,أخبريني، هل هذا جبل دايسن؟
Dialogue: 0,0:16:24.96,0:16:28.47,Default,,0,0,0,,‫نعم، يُعرف أيضًا بـ"هوكي فوجي".
Dialogue: 0,0:16:24.96,0:16:28.47,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(200,205)}جبل دايسن
Dialogue: 0,0:16:28.47,0:16:31.70,Default,,0,0,0,,‫إنه أعلى جبل في منطقة تشوغوكو.
Dialogue: 0,0:16:35.85,0:16:40.21,Default,,0,0,0,,‫الخطوة الثانية: استفسر على نطاق واسع، كالماء المنتشر!
Dialogue: 0,0:16:40.85,0:16:45.58,Default,,0,0,0,,‫ساتشيو؟ لم تأتِ إلى جبل دايسن.
Dialogue: 0,0:16:45.58,0:16:47.48,Default,,0,0,0,,هل تعلم أين قد تكون؟
Dialogue: 0,0:16:47.48,0:16:53.32,Default,,0,0,0,,‫حسنًا، ساتشيو وياسوتو واقعان في حب بعضهما بشدة.
Dialogue: 0,0:16:53.32,0:16:59.29,Default,,0,0,0,,‫أشك في أنهما سيفترقان أبدًا، مثل شلالي كوتورا التوأم.
Dialogue: 0,0:16:59.29,0:17:01.57,Default,,0,0,0,,‫لا يفترقان أبدًا...
Dialogue: 0,0:17:02.33,0:17:03.69,Default,,0,0,0,,سيد موري؟
Dialogue: 0,0:17:04.39,0:17:07.31,Default,,0,0,0,,‫لقد انتهينا من استجواب الناس في معبد دايسنجي.
Dialogue: 0,0:17:07.85,0:17:09.30,Default,,0,0,0,,كيف الحال هناك؟
Dialogue: 0,0:17:09.30,0:17:11.80,Default,,0,0,0,,‫ماذا؟، أنا على وشك البدء.{\an8}
Dialogue: 0,0:17:09.30,0:17:11.80,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}حوض سلطعون كارو في توتوري
Dialogue: 0,0:17:12.31,0:17:16.73,Default,,0,0,0,,لم تكن تخطط لأكل السلطعون، أليس كذلك؟
Dialogue: 0,0:17:16.73,0:17:19.74,Default,,0,0,0,,‫لن أحلم بذلك!
Dialogue: 0,0:17:19.74,0:17:20.94,Default,,0,0,0,,‫تبًا...
Dialogue: 0,0:17:20.94,0:17:23.94,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}محطة توتوري
Dialogue: 0,0:17:23.94,0:17:26.44,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}صحراء توتوري الرملية
Dialogue: 0,0:17:27.48,0:17:29.94,Default,,0,0,0,,نحات رمال؟
Dialogue: 0,0:17:29.94,0:17:33.45,sign_suspect,SIGN,0,0,0,,{\pos(320,302)}مركز الرمال الترفيهي في توتوري
Dialogue: 0,0:17:33.45,0:17:35.95,sign_suspect,SIGN,0,0,0,,{\pos(317,290)}متحف الرمال
Dialogue: 0,0:17:38.08,0:17:44.23,Default,,0,0,0,,كانا يتحدثان معي لبعض الوقت، لكن ساتشيو اختفت أخيرًا، أليس كذلك؟
Dialogue: 0,0:17:46.17,0:17:48.00,Default,,0,0,0,,‫إذن هذا هو السبب.
Dialogue: 0,0:17:48.42,0:17:53.01,Default,,0,0,0,,‫ما المضحك؟، الجميع قلقون.
Dialogue: 0,0:17:55.38,0:17:58.89,Default,,0,0,0,,‫عليك أن تجعل الرمال صلبة، هكذا.
Dialogue: 0,0:17:58.89,0:18:00.14,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:18:00.14,0:18:04.72,Default,,0,0,0,,‫عليك أن تجعلها تبدو حقيقية.
Dialogue: 0,0:18:05.15,0:18:08.40,Default,,0,0,0,,‫لكن لا شيء أجمل.
Dialogue: 0,0:18:08.73,0:18:10.19,Default,,0,0,0,,‫اجعلها تبدو حقيقية...
Dialogue: 0,0:18:10.65,0:18:13.15,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}محطة كورايوشي
Dialogue: 0,0:18:18.46,0:18:22.07,Default,,0,0,0,,يا عمي، هل صحيح أنك عرفت أين الأنسة ساتشيو؟
Dialogue: 0,0:18:22.07,0:18:22.91,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:18:22.91,0:18:25.92,sign_suspect,SIGN,0,0,0,,{\pos(320,281)}مستودعات الجدران البيضاء في كورايوشي\Nمكتب الإرشاد السياحي
Dialogue: 0,0:18:26.39,0:18:28.55,Default,,0,0,0,,‫ساتشيو اختفت!
Dialogue: 0,0:18:28.55,0:18:30.18,Default,,0,0,0,,‫هذا خطؤك!
Dialogue: 0,0:18:30.18,0:18:33.42,Default,,0,0,0,,‫ليس مشكلتي. اذهب إلى العمل.
Dialogue: 0,0:18:33.42,0:18:35.96,Default,,0,0,0,,لماذا لا تفهم؟
Dialogue: 0,0:18:38.64,0:18:42.27,Default,,0,0,0,,لـ-لماذا تبدو جادًا هكذا؟
Dialogue: 0,0:18:42.27,0:18:44.20,Default,,0,0,0,,‫لا تتظاهر بالجهل.
Dialogue: 0,0:18:44.20,0:18:48.40,Default,,0,0,0,,‫لقد استجوبنا الناس في يوناغو، دايسن، وتوتوري.
Dialogue: 0,0:18:48.40,0:18:49.73,Default,,0,0,0,,في الأماكن الثلاثة جميعها؟
Dialogue: 0,0:18:50.68,0:18:53.44,Default,,0,0,0,,‫وماذا في ذلك؟ لا أعرف أي شيء.
Dialogue: 0,0:18:53.44,0:18:55.91,Default,,0,0,0,,‫لن تفترقا أبدًا.
Dialogue: 0,0:18:55.91,0:18:57.92,Default,,0,0,0,,‫وعليكما أن تجعلا الأمر يبدو حقيقيًا.
Dialogue: 0,0:18:59.16,0:19:01.20,Default,,0,0,0,,إنها ليست مفقودة حقًا، أليس كذلك؟
Dialogue: 0,0:19:03.08,0:19:04.33,Default,,0,0,0,,ليست مفقودة؟
Dialogue: 0,0:19:04.33,0:19:10.48,Default,,0,0,0,,‫نعم. هما الاثنان خططا لهذا لإثبات أن حبهما حقيقي.
Dialogue: 0,0:19:11.37,0:19:16.36,Default,,0,0,0,,‫في الحقيقة... أنت محق. أنا آسف.
Dialogue: 0,0:19:16.78,0:19:19.60,Default,,0,0,0,,‫أردنا فقط أن تفهم الأنسة كازوكو ووالدي.
Dialogue: 0,0:19:20.94,0:19:23.18,Default,,0,0,0,,‫لم نعتقد أن الأمر سيتضخم هكذا.
Dialogue: 0,0:19:23.18,0:19:25.46,Default,,0,0,0,,‫أنا آسف حقًا.
Dialogue: 0,0:19:25.46,0:19:26.62,Default,,0,0,0,,‫كما توقعت.
Dialogue: 0,0:19:26.62,0:19:29.11,Default,,0,0,0,,إذن، أين الأنسة ساتشيو؟
Dialogue: 0,0:19:31.61,0:19:35.11,sign_suspect,SIGN,0,0,0,,{\pos(320,290)}متحف كمان ميساسا
Dialogue: 0,0:19:38.74,0:19:42.90,Default,,0,0,0,,متحف الكمان؟ الأنسة ساتشيو هنا؟
Dialogue: 0,0:19:42.90,0:19:46.45,Default,,0,0,0,,‫نعم. هناك مستودع في الخلف.
Dialogue: 0,0:19:51.00,0:19:53.50,Default,,0,0,0,,‫قالت إنها ستختبئ هنا لبعض الوقت.
Dialogue: 0,0:19:54.02,0:19:56.01,Default,,0,0,0,,‫يا ساتشيو.
Dialogue: 0,0:19:59.15,0:20:00.64,Default,,0,0,0,,‫لا يوجد أحد هنا.
Dialogue: 0,0:20:00.64,0:20:02.71,Default,,0,0,0,,‫أنت محق. إنها ليست هنا.
Dialogue: 0,0:20:02.71,0:20:04.06,Default,,0,0,0,,‫هذا غريب.
Dialogue: 0,0:20:07.97,0:20:10.36,Default,,0,0,0,,‫يا محقق أوكاموتو، انظر إلى هذا.
Dialogue: 0,0:20:10.36,0:20:12.26,Default,,0,0,0,,‫إنه ظرف.
Dialogue: 0,0:20:12.26,0:20:13.76,Default,,0,0,0,,‫أنه قطعة منه.
Dialogue: 0,0:20:14.86,0:20:17.74,Default,,0,0,0,,‫ماذا؟ سيد موري، أخبار فظيعة!
Dialogue: 0,0:20:18.22,0:20:20.74,Default,,0,0,0,,هل تم اختطاف الأنسة ساتشيو؟
Dialogue: 0,0:20:21.07,0:20:23.17,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:20:23.17,0:20:27.16,Default,,0,0,0,,‫لقد تلقيت رسالة غريبة للتو.
Dialogue: 0,0:20:27.52,0:20:28.67,Default,,0,0,0,,‫ساتشيو!
Dialogue: 0,0:20:29.06,0:20:32.01,Default,,0,0,0,,‫أنا آسفة. لقد تم اختطافي.
Dialogue: 0,0:20:32.01,0:20:35.47,Default,,0,0,0,,‫إنه يؤلمني. من فضلكما توقفاً.
Dialogue: 0,0:20:35.47,0:20:40.19,Default,,0,0,0,,‫قالوا إنهم سيرسلون مقطعين فيديو آخرين كل ساعة.
Dialogue: 0,0:20:40.19,0:20:42.63,Default,,0,0,0,,‫لدينا يوميميا ساتشيو.
Dialogue: 0,0:20:40.43,0:20:46.68,sign_1190_ransom,SIGN,0,0,0,,{\fs20\fnGeorgia\an6\move(190,420,190,250,0,5985)}لدي\N\N.يوميميا ساتشيو\N\Nاحضروا 100 مليون ين\N\Nخلال ساعتين
Dialogue: 0,0:20:42.63,0:20:45.85,Default,,0,0,0,,‫اجمعوا 100 مليون ين خلال ساعتين.
Dialogue: 0,0:20:46.68,0:20:48.23,Default,,0,0,0,,‫100 مليون؟!
Dialogue: 0,0:20:48.92,0:20:53.44,Default,,0,0,0,,لحظة. ألم تخططا أنتما لاختفاء الأنسة ساتشيو؟
Dialogue: 0,0:20:54.23,0:20:59.31,Default,,0,0,0,,‫نعم. كان من المفترض أن تختبئ هناك حتى المساء.
Dialogue: 0,0:20:59.31,0:21:01.57,Default,,0,0,0,,‫ساتشيو! ساتشيو!
Dialogue: 0,0:21:01.57,0:21:04.11,Default,,0,0,0,,من يمكنه فعل هذا؟
Dialogue: 0,0:21:05.38,0:21:09.28,Default,,0,0,0,,بالتفكير في الأمر، سمعت من إحدى النادلات
Dialogue: 0,0:21:09.28,0:21:14.59,Default,,0,0,0,,‫أن سيارة سوداء مريبة كانت متوقفة قرب الجبال مساء أمس.
Dialogue: 0,0:21:14.59,0:21:17.08,Default,,0,0,0,,‫يمكن أن يكون هذا من فعل الجناة.
Dialogue: 0,0:21:17.08,0:21:20.87,Default,,0,0,0,,‫لقد خططوا لاختطاف الأنسة ساتشيو منذ البداية.
Dialogue: 0,0:21:20.87,0:21:26.34,Default,,0,0,0,,‫ولحسن حظهم، اختارت الأنسة ساتشيو الاختباء في متحف الكمان القريب.
Dialogue: 0,0:21:27.02,0:21:31.35,Default,,0,0,0,,هل حدث هذا بسببي؟
Dialogue: 0,0:21:31.35,0:21:32.65,Default,,0,0,0,,‫ساتشيو!
Dialogue: 0,0:21:33.34,0:21:37.71,Default,,0,0,0,,‫اطلب التعزيزات. أنشئ نقاط تفتيش على كل طريق محلي في المنطقة.
Dialogue: 0,0:21:38.19,0:21:40.05,Default,,0,0,0,,‫اعثروا على تلك السيارة السوداء!
Dialogue: 0,0:21:40.05,0:21:41.05,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:21:41.53,0:21:43.28,Default,,0,0,0,,‫أنسة ساتشيو...
Dialogue: 0,0:21:43.28,0:21:46.27,Default,,0,0,0,,‫مسرحيتها للاختفاء تحولت إلى اختطاف حقيقي...
Dialogue: 0,0:21:48.90,0:21:52.79,Default,,0,0,0,,يا محقق ياماني، أين تلك القطعة الورقية من مستودع المتحف؟
Dialogue: 0,0:21:52.79,0:21:55.29,Default,,0,0,0,,‫حسناً، تفضل.
Dialogue: 0,0:21:57.71,0:21:59.10,Default,,0,0,0,,‫إنهما متماثلتان.
Dialogue: 0,0:21:57.71,0:21:59.09,sign_1190_stationery_ryokan,SIGN,0,0,0,,{\pos(534,224)\an3\frz-30\fs12} نُزل\N{\b1\fs16} يوميميا 
Dialogue: 0,0:21:59.53,0:22:01.47,Default,,0,0,0,,شخص ما داخل النُزل
Dialogue: 0,0:22:01.47,0:22:05.26,Default,,0,0,0,,‫قد يكون على اتصال بالجاني في الخارج.
Dialogue: 0,0:22:05.26,0:22:06.81,Default,,0,0,0,,على اتصال؟
Dialogue: 0,0:22:07.26,0:22:11.81,Default,,0,0,0,,‫نعم. قد يكون هناك شريك بينكم.
Dialogue: 0,0:22:11.81,0:22:13.32,Default,,0,0,0,,‫شريك؟!
Dialogue: 0,0:22:16.06,0:22:21.81,Default,,0,0,0,,فوق ذلك، واحد منهم شريك للخاطف؟
Dialogue: 0,0:22:25.19,0:22:30.67,DC-ED,,0,0,0,,‫الوقت يمضي، مرة أخرى
Dialogue: 0,0:22:31.07,0:22:35.25,DC-ED,,0,0,0,,‫أن أصادف أزهار الكرز
Dialogue: 0,0:22:36.06,0:22:41.37,DC-ED,,0,0,0,,‫قلبي يترقّب قدومك بفارغ الصبر
Dialogue: 0,0:22:41.56,0:22:46.41,DC-ED,,0,0,0,,‫كالزهرة المتفتحة
Dialogue: 0,0:22:46.96,0:22:52.80,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:22:58.68,0:23:07.79,DC-ED,,0,0,0,,‫مشاعر الاشتياق التي لا تُقابل باللقاء
Dialogue: 0,0:23:09.34,0:23:13.23,DC-ED,,0,0,0,,‫تستمر بلا نهاية
Dialogue: 0,0:23:13.38,0:23:18.76,DC-ED,,0,0,0,,‫رغم محاولاتي المتكررة للنسيان
Dialogue: 0,0:23:20.12,0:23:22.17,DC-ED,,0,0,0,,‫أخبرتني
Dialogue: 0,0:23:22.17,0:23:25.23,DC-ED,,0,0,0,,‫كل المشاعر الدافئة
Dialogue: 0,0:23:25.23,0:23:29.63,DC-ED,,0,0,0,,‫لا تفارقني
Dialogue: 0,0:23:37.91,0:23:43.81,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:23:45.03,0:23:47.16,Default,,0,0,0,,حجج غياب؟
Dialogue: 0,0:23:45.03,0:24:09.05,sign_episode_preview,SIGN,0,0,0,, في الحلقة القادمة 
Dialogue: 0,0:23:47.16,0:23:51.48,Default,,0,0,0,,هل تم اختطاف الأنسة ساتشيو حقًا بعد خروجها من المستودع؟
Dialogue: 0,0:23:52.89,0:23:56.96,Default,,0,0,0,,‫أ-أسرعوا وانقذوني! إذا مت، سيكون ذلك خطأكم كله!
Dialogue: 0,0:23:56.96,0:23:59.38,Default,,0,0,0,,‫كما توقعت، ساتشيو لا تتصرف كعادتها.
Dialogue: 0,0:24:00.47,0:24:03.25,Default,,0,0,0,,‫يمكنني الحصول على 100 مليون ين.
Dialogue: 0,0:24:03.69,0:24:05.01,Default,,0,0,0,,صوت الأمواج؟
Dialogue: 0,0:24:05.01,0:24:07.80,Default,,0,0,0,,‫توقفوا! لا تدفعوا 100 مليون ين!
Dialogue: 0,0:24:07.80,0:24:09.05,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:24:09.05,0:24:10.63,Default,,0,0,0,,‫الحلقة القادمة من كونان:
Dialogue: 0,0:24:09.05,0:24:15.06,sign_next_episode,SIGN,0,0,0,,{\pos(320,35)}الحبيب الذي اختفى على جسر كويتاني\Nجزء ميساسا 
Dialogue: 0,0:24:10.63,0:24:14.29,Default,,0,0,0,,‫"الحبيب الذي اختفى على جسر كويتاني، جزء ميساسا!"
Dialogue: 0,0:24:30.07,0:24:32.50,Default,,0,0,0,,‫تلميح كونان القادم!{\an8}
Dialogue: 0,0:24:30.07,0:24:34.99,sign_hint_label,SIGN,0,0,0,,{\an2\fnImpact\pos(320,300)}{\3c&HB7B1AF&} الأرنب 
Dialogue: 0,0:24:32.96,0:24:34.41,Default,,0,0,0,,‫الأرانب!{\an8}
Dialogue: 0,0:24:34.99,0:24:36.63,Default,,0,0,0,,‫أود أن أشرب مع فتاة الأرنب.{\an8}
Dialogue: 0,0:24:34.99,0:24:40.00,sign_dont_miss,SIGN,0,0,0,,{\an3\pos(603,314)}لا تفوتوا الحلقة القادمة 
Dialogue: 0,0:24:36.63,0:24:37.58,Default,,0,0,0,,‫أبي.{\an8}
Dialogue: 0,0:24:37.58,0:24:39.45,Default,,0,0,0,,‫ربما يأتون من القمر ليزورونا.{\an8}
