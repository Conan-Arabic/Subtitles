Dialogue: 0,0:09:57.95,0:10:00.07,Default,,0,0,0,,{\fnFF Bouya Messy\bord0\c&H311792&\blur1\frx358\fry40\frz11.94\fscx115\fscy133\pos(224,310)}لعنة
Dialogue: 0,0:09:58.26,0:09:59.38,Default,,0,0,0,,كوتشي-سان
Dialogue: 0,0:10:01.93,0:10:02.74,Default,,0,0,0,,...لا تقل
Dialogue: 0,0:10:03.32,0:10:06.49,Default,,0,0,0,,هل سار إلى البحيرة مثل الخمسة زبائن؟
Dialogue: 0,0:10:06.93,0:10:08.57,Default,,0,0,0,,هذا مستحيل
Dialogue: 0,0:10:08.57,0:10:09.68,Default,,0,0,0,,تاكاجي، شيبا
Dialogue: 0,0:10:09.68,0:10:11.74,Default,,0,0,0,,!أريد أن تُفتش هذه البحيرة حالاً
Dialogue: 0,0:10:11.74,0:10:13.00,Default,,0,0,0,,لا يمكننا تحمّل الانتظار للفجر
Dialogue: 0,0:10:13.10,0:10:13.70,Default,,0,0,0,,حاضر، سيدي
Dialogue: 0,0:10:18.73,0:10:20.64,Thoughts,,0,0,0,,إذاً كما توقعت
Dialogue: 0,0:10:26.05,0:10:30.86,Default,,0,0,0,,هل حقاً لا بأس أنني أنا الوحيد الذي يفتش البحيرة؟
Dialogue: 0,0:10:30.86,0:10:32.16,Default,,0,0,0,,لا بأس
Dialogue: 0,0:10:32.16,0:10:38.45,Default,,0,0,0,,قال المحقق ميجوري أن المحقق شيبا كان ذاهباً لتفتيش البحيرة مع الشرطة المحلية
Dialogue: 0,0:10:39.13,0:10:40.58,Default,,0,0,0,,...مع هذا
Dialogue: 0,0:10:40.58,0:10:44.31,Default,,0,0,0,,هل حقاً أخبرنا موري سان أن نبحث هنا؟
Dialogue: 0,0:10:44.31,0:10:45.29,Default,,0,0,0,,أجل
Dialogue: 0,0:10:45.63,0:10:46.41,Default,,0,0,0,,أرأيتَ؟
Dialogue: 0,0:10:46.72,0:10:48.41,Default,,0,0,0,,...انظر عن كثب
Dialogue: 0,0:10:48.69,0:10:50.50,Default,,0,0,0,,لا تفعل هذا، كونان-كن
Dialogue: 0,0:10:50.50,0:10:52.61,Default,,0,0,0,,لا يمكنكَ إمساك الأدلة وحسب
Dialogue: 0,0:10:55.34,0:10:56.17,Default,,0,0,0,,أرأيتَ؟
Dialogue: 0,0:10:56.44,0:10:58.48,Default,,0,0,0,,هذه خريطة
Dialogue: 0,0:10:58.48,0:10:59.30,Default,,0,0,0,,أجل
Dialogue: 0,0:10:59.71,0:11:01.74,Default,,0,0,0,,إذا كانت الحديقة هنا
Dialogue: 0,0:11:01.74,0:11:03.88,Default,,0,0,0,,إذاً فهذا هو المطعم
Dialogue: 0,0:11:03.88,0:11:06.18,Default,,0,0,0,,وهدفنا هنا
Dialogue: 0,0:11:06.56,0:11:07.94,Default,,0,0,0,,أوشكنا على الوصول
Dialogue: 0,0:11:14.49,0:11:15.80,Default,,0,0,0,,أليس هذا؟
Dialogue: 0,0:11:15.80,0:11:18.69,Default,,0,0,0,,أجل، تماماً مثل الطاهي إيجو-سان
Dialogue: 0,0:11:19.25,0:11:21.28,Default,,0,0,0,,ربما هذا مثل توقيعه؟
Dialogue: 0,0:11:21.66,0:11:25.00,Default,,0,0,0,,لذا فالمخزن الذي يمتلكه كوتشي-سان
Dialogue: 0,0:11:27.13,0:11:28.45,Default,,0,0,0,,هل سمعتَ هذا؟
Dialogue: 0,0:11:28.45,0:11:30.23,Default,,0,0,0,,افتحه، أيها المحقق تاكاجي
Dialogue: 0,0:11:30.23,0:11:31.25,Default,,0,0,0,,فهمتُ
Dialogue: 0,0:11:39.83,0:11:41.26,Default,,0,0,0,,...هؤلاء الناس
Dialogue: 0,0:11:42.41,0:11:44.89,Default,,0,0,0,,!الخمسة ضيوف المختفون
Dialogue: 0,0:11:46.31,0:11:48.15,Default,,0,0,0,,...بدون أحذيتهم
Dialogue: 0,0:11:48.15,0:11:51.39,Default,,0,0,0,,إذاً هل هذا يعني أن آثار الأقدام كانت...؟
Dialogue: 0,0:11:51.60,0:11:54.90,Default,,0,0,0,,أجل، كوتشي-سان هو من وضعها
Dialogue: 0,0:11:55.27,0:11:58.12,Default,,0,0,0,,كان هذا كله من فعله
Dialogue: 0,0:11:58.46,0:12:02.28,Default,,0,0,0,,كوغورو-سان قال أنه حتى الجرح الذي كان برأسه
Dialogue: 0,0:12:02.28,0:12:04.50,Default,,0,0,0,,كان جزءاً من الخطة
Dialogue: 0,0:12:05.41,0:12:07.07,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:12:07.07,0:12:08.41,Default,,0,0,0,,لكن لماذا؟
Dialogue: 0,0:12:08.83,0:12:10.60,Default,,0,0,0,,وإلى أين ذهب؟
Dialogue: 0,0:12:10.60,0:12:14.79,Default,,0,0,0,,قال أنه لا بد من أن هؤلاء يعرفون
