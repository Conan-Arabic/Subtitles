Dialogue: 0,0:05:49.49,0:05:54.25,Default,,0,0,0,,{\fnHacen Extender X4 Super Fit\bord0\shad0\c&H60381B&\blur1\frz6.736\frx18\fry2\fscx107\fscy110\pos(678,686)}ماناكا كاوري
Dialogue: 0,0:05:49.88,0:05:52.62,Default,,0,0,0,,كلهم يعملون بـ أوندا للتجارة
Dialogue: 0,0:05:52.62,0:05:55.92,Default,,0,0,0,,صفحة الشركة على الإنترنت تؤكد هذا أيضاً
Dialogue: 0,0:05:56.96,0:06:00.04,Default,,0,0,0,,كوتشي-سان، أيمكنكَ تأكيد أن هؤلاء هم من رأيتَهم؟
Dialogue: 0,0:06:00.60,0:06:02.28,Default,,0,0,0,,...أوندا للتجارة
Dialogue: 0,0:06:02.67,0:06:03.67,Default,,0,0,0,,أين سمعتُ هذا؟
Dialogue: 0,0:06:03.63,0:06:06.38,Default,,0,0,0,,{\clip(m 880 336 l 1272 380 1282 602 826 580)\p1\3c&H010224&\3a&HFF&\4c&H020236&\4a&HFF&\c&HF5F1F0&\fscx2370\fscy1864\pos(1052,590)}m 0 0 l 29 0 l 29 13 l 0 13 l 0 0
Dialogue: 0,0:06:03.63,0:06:06.38,Default,,0,0,0,,{\fnHacen Extender X4 Super Fit\bord0\shad0\c&H60381B&\blur1\fscx186\fscy207\pos(1042,608)\frz356}المدير والرئيس\Nأوندا تيروكاي
Dialogue: 0,0:06:03.63,0:06:06.38,Default,,0,0,0,,{\clip(m 652 126 l 988 154 980 240 624 212)\p1\3c&H010224&\3a&HFF&\4c&H020236&\4a&HFF&\c&HF6F2F0&\fscx2030\fscy1162\frz354.1\pos(816,246)}m 0 0 l 29 0 l 29 13 l 0 13 l 0 0
Dialogue: 0,0:06:03.63,0:06:06.38,Default,,0,0,0,,{\fnHacen Extender X4 Super Fit\bord0\shad0\c&H60381B&\blur1\frz355.6\fscx172\fscy192\pos(834,248)}أوندا للتجارة
Dialogue: 0,0:06:03.91,0:06:06.42,Default,,0,0,0,,أجل، هؤلاء هم بالتأكيد
Dialogue: 0,0:06:06.42,0:06:09.14,Default,,0,0,0,,تمكنا من التواصل مع رئيس شركة أوندا
Dialogue: 0,0:06:09.14,0:06:12.70,Default,,0,0,0,,لذا قمنا بتحقيق محلي للشرطة\Nفي منزله للإطمئنان
Dialogue: 0,0:06:12.70,0:06:14.31,Default,,0,0,0,,...يا محقق تاكاجي
Dialogue: 0,0:06:14.72,0:06:19.18,Default,,0,0,0,,...عندما دخلنا، كان هنالك صورة على الهاتف
Dialogue: 0,0:06:19.18,0:06:20.94,Default,,0,0,0,,هؤلاء هم نفس الأشخاص، صحيح؟
Dialogue: 0,0:06:21.13,0:06:22.71,Default,,0,0,0,,أجل، هذا صحيح
Dialogue: 0,0:06:22.71,0:06:24.40,Default,,0,0,0,,لا أعلم كم كانوا مقربين
Dialogue: 0,0:06:24.40,0:06:27.14,Default,,0,0,0,,لكن من الواضح أن خمستهم يخرجون معاً كثيراً
Dialogue: 0,0:06:27.14,0:06:29.91,Default,,0,0,0,,لأنه كان لهم صور كثيرة وهم يحتفلون بأماكن متعددة
Dialogue: 0,0:06:31.10,0:06:34.40,Default,,0,0,0,,أراهن أنهم خططوا لالتقاط واحدة هنا أيضاً
Dialogue: 0,0:06:35.98,0:06:38.87,Default,,0,0,0,,لذا، خمستهم معاً أتوا إلى هنا؟
Dialogue: 0,0:06:38.87,0:06:39.71,Default,,0,0,0,,صحيح
Dialogue: 0,0:06:40.34,0:06:43.21,Default,,0,0,0,,أتوا منذ حوالي ساعة، في سيارة
Dialogue: 0,0:06:43.57,0:06:46.46,Default,,0,0,0,,هذا أي قبل 20 دقيقة من ظهورنا
Dialogue: 0,0:06:48.24,0:06:49.87,Thoughts,,0,0,0,,...انتظر، وقتها
Dialogue: 0,0:06:55.32,0:06:56.86,Default,,0,0,0,,ماذا حدث بعدها؟
Dialogue: 0,0:06:56.86,0:06:59.38,Default,,0,0,0,,طلبوا نخباً
Dialogue: 0,0:06:59.38,0:07:02.48,Default,,0,0,0,,وذهبتُ للمطبخ لإكمال الطهي
Dialogue: 0,0:07:03.26,0:07:05.61,Default,,0,0,0,,قدمتُ المقبلات والحساء
Dialogue: 0,0:07:05.87,0:07:08.88,Default,,0,0,0,,!وبعد حوالي 15 دقيقة ضُربتُ من الخلف فجأة
Dialogue: 0,0:07:13.38,0:07:15.92,Default,,0,0,0,,إذاً لم ترَ من الذي ضربكَ؟
Dialogue: 0,0:07:15.92,0:07:16.74,Default,,0,0,0,,لا
Dialogue: 0,0:07:18.35,0:07:23.48,Default,,0,0,0,,من الواضح بالتأكيد أن أحداً من تلك المجموعة\Nهو من ضربكَ
Dialogue: 0,0:07:26.70,0:07:27.88,Thoughts,,0,0,0,,أليست هذه؟
Dialogue: 0,0:07:28.39,0:07:30.63,Thoughts,,0,0,0,,إيصال لم تكتمل كتابته؟
Dialogue: 0,0:07:36.14,0:07:37.91,Default,,0,0,0,,...يا، كوتشي-سان
Dialogue: 0,0:07:38.56,0:07:41.44,Default,,0,0,0,,هذه هي الكعكة التي اسمها تريميسو، صحيح؟
Dialogue: 0,0:07:42.92,0:07:44.06,Default,,0,0,0,,أجل
Dialogue: 0,0:07:44.42,0:07:46.87,Default,,0,0,0,,كان الجميع يتناولون العشاء
Dialogue: 0,0:07:46.87,0:07:49.24,Default,,0,0,0,,كيف يُعقل أن أحدهم كان يتناول الكعك؟
Dialogue: 0,0:07:49.24,0:07:54.32,Default,,0,0,0,,تصدف هكذا اشخاص أحياناً يريدون أن يبدأو بالتحلية
Dialogue: 0,0:07:55.86,0:08:00.58,Default,,0,0,0,,أراهن أن السيدة التي جلست هنا بالتأكيد أحبت الحلوى
Dialogue: 0,0:08:01.29,0:08:03.14,Default,,0,0,0,,قد يكون هذا هو الأمر
Dialogue: 0,0:08:03.14,0:08:05.13,Default,,0,0,0,,يجب أن يكون ذلك واضحاً
Dialogue: 0,0:08:06.22,0:08:08.18,Default,,0,0,0,,توقف عن إفساد مسرح الجريمة
Dialogue: 0,0:08:08.18,0:08:09.86,Default,,0,0,0,,آسف
Dialogue: 0,0:08:09.86,0:08:11.79,Default,,0,0,0,,...في هذه الحالة، اخرج من
Dialogue: 0,0:08:10.72,0:08:11.79,Default,,0,0,0,,{\an8}أمر آخر
Dialogue: 0,0:08:12.89,0:08:16.72,Default,,0,0,0,,هل كسر أحدهم كأسه عندما طلبوا نخباً؟
Dialogue: 0,0:08:17.67,0:08:20.80,Default,,0,0,0,,أنا... لا أظن ذلك
Dialogue: 0,0:08:20.80,0:08:23.98,Default,,0,0,0,,كنتُ سألاحظ إذا فعل أحدهم\Nبدون ذكر أنه سيكون علي التنظيف
Dialogue: 0,0:08:24.19,0:08:25.37,Default,,0,0,0,,...هذا ما ظننتُه
Dialogue: 0,0:08:25.37,0:08:28.42,Default,,0,0,0,,سلة القمامة في المطبخ كانت فارغة أيضاً
Dialogue: 0,0:08:28.42,0:08:31.49,Default,,0,0,0,,أمر آخر، السيارة بالخارج
Dialogue: 0,0:08:32.58,0:08:34.08,Default,,0,0,0,,هذا يكفي
Dialogue: 0,0:08:38.33,0:08:40.89,Default,,0,0,0,,لا يمكنكَ أن تركض بمفردكَ، تعلم هذا؟
Dialogue: 0,0:08:40.89,0:08:42.57,Default,,0,0,0,,...آسف
Dialogue: 0,0:08:42.57,0:08:44.40,Default,,0,0,0,,لننتظر هنا معاً
Dialogue: 0,0:08:44.40,0:08:45.67,Default,,0,0,0,,...حسناً
Dialogue: 0,0:08:54.12,0:08:55.09,Default,,0,0,0,,أليس هذا؟
Dialogue: 0,0:08:55.74,0:08:56.84,Default,,0,0,0,,ماذا قلتَ؟
Dialogue: 0,0:08:57.26,0:08:58.25,Default,,0,0,0,,مفهوم
Dialogue: 0,0:08:58.80,0:08:59.71,Default,,0,0,0,,حضرة المفتش
Dialogue: 0,0:09:00.80,0:09:02.34,Default,,0,0,0,,...بشأن أوندا للتجارة
Dialogue: 0,0:09:03.37,0:09:04.67,Default,,0,0,0,,منذ ثلاث سنوات
Dialogue: 0,0:09:04.67,0:09:08.66,Default,,0,0,0,,كانت الشركة مشبوهة بتهريب مواد الخام الصناعية
Dialogue: 0,0:09:08.66,0:09:10.97,Default,,0,0,0,,وكان هنالك تحقيق في هذا
Dialogue: 0,0:09:11.34,0:09:16.32,Default,,0,0,0,,لكن واحد من المدراء الآخرين ترك ملاحظة\Nتزعم أنهم كانوا المسؤولين عن كل هذا
Dialogue: 0,0:09:16.32,0:09:17.99,Default,,0,0,0,,وانتحر
Dialogue: 0,0:09:18.90,0:09:21.17,Default,,0,0,0,,هاه، يالها من قضية
Dialogue: 0,0:09:21.17,0:09:24.02,Default,,0,0,0,,إذاً فقد يكون الخمسة موظفين من هذه الحادثة متورطين؟
Dialogue: 0,0:09:24.02,0:09:25.30,Default,,0,0,0,,...أيضاً
Dialogue: 0,0:09:25.30,0:09:29.71,Default,,0,0,0,,المدير الذي قتل نفسه كان اسمه كوتشي كيجو
Dialogue: 0,0:09:30.59,0:09:31.76,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:31.76,0:09:33.93,Default,,0,0,0,,هذا نفس اسم عائلة الطاهي
Dialogue: 0,0:09:33.93,0:09:35.30,Default,,0,0,0,,حضرة المفتش ميغوري
Dialogue: 1,0:09:36.14,0:09:38.34,Default,,0,0,0,,انظر ماذا يوجد على مدونة كوتشي-سان الشخصية
Dialogue: 0,0:09:38.30,0:09:41.06,Default,,0,0,0,,{\clip(m 248 218 l 408 268 388 350 378 390 326 378 214 338)\p1\3c&H010224&\3a&HFF&\4c&H020236&\4a&HFF&\c&HF0EEEC&\fscx1590\fscy1321\frz344.7\pos(300,386)}m 0 0 l 29 0 l 29 13 l 0 13 l 0 0
Dialogue: 0,0:09:38.30,0:09:41.06,Default,,0,0,0,,{\fnFF Bouya Messy\bord0\c&H311792&\frz341.2\pos(300,342)\blur1\fscx124\fscy122}لعنة
Dialogue: 0,0:09:38.30,0:09:41.06,Default,,0,0,0,,{\p1\3c&H010224&\3a&HFF&\4c&H020236&\4a&HFF&\c&HDFD2CF&\frz344.7\fscx3518\fscy1906\clip(m 182 428 l 400 516 664 618 804 674 794 722 76 718)\pos(372,684)}m 0 0 l 29 0 l 29 13 l 0 13 l 0 0
Dialogue: 0,0:09:38.30,0:09:41.06,Default,,0,0,0,,{\bord0\shad0\blur1\fnBahij Janna\c&H6A1AF8&\fscx198\fscy195\pos(412,640)\frz340.4}! ؟ {\c&H624325&}ماذا حدث لزبائني
Dialogue: 0,0:09:39.09,0:09:40.97,Default,,0,0,0,,{\an8}"ماذا حدث لزبائني؟"
Dialogue: 0,0:09:41.39,0:09:42.47,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:43.27,0:09:47.47,Default,,0,0,0,,...سيدي، حقاً لا يجب أن تقوم بهذا النوع من الأمور
Dialogue: 0,0:09:48.85,0:09:50.31,Default,,0,0,0,,اختفى كوتشي-سان
Dialogue: 0,0:09:50.73,0:09:52.30,Default,,0,0,0,,إلى أين ذهب؟
Dialogue: 0,0:09:53.58,0:09:54.48,Default,,0,0,0,,...هل هذا
