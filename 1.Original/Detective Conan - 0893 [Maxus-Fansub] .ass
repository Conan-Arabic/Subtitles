Dialogue: 0,0:12:27.30,0:12:30.81,Default,,0,0,0,,{\fad(250,1)\bord0\shad0\fnAl-Jazeera-Arabic-Bold\fscx56\fscy67\pos(544,636)}(أوندا توروكاي (45
Dialogue: 0,0:12:27.30,0:12:30.81,Default,,0,0,0,,{\fad(250,1)\bord0\shad0\fnAl-Jazeera-Arabic-Bold\fscx54\fscy55\pos(548,680)}رئيس أوندا للتجارة
Dialogue: 0,0:12:38.20,0:12:40.62,Default,,0,0,0,,مرت فترة، أيها الرئيس
Dialogue: 0,0:12:40.62,0:12:42.63,Default,,0,0,0,,...منذ جنازة أبي
Dialogue: 0,0:12:42.63,0:12:44.49,Default,,0,0,0,,...أنتَ
Dialogue: 0,0:12:44.49,0:12:47.24,Default,,0,0,0,,!إذاً فأنتَ حقاً ابن كوتشي
Dialogue: 0,0:12:47.98,0:12:49.90,Default,,0,0,0,,كان أبي ضعيفاً
Dialogue: 0,0:12:49.90,0:12:52.02,Default,,0,0,0,,...سمح لكم بدفعه
Dialogue: 0,0:12:52.02,0:12:56.14,Default,,0,0,0,,لا، التلاعب به لكي ينتحر ويتلقى اللوم وحده
Dialogue: 0,0:12:56.14,0:12:59.41,Default,,0,0,0,,لكن هذا لن يحدث معي
Dialogue: 0,0:13:00.36,0:13:01.34,Default,,0,0,0,,هذا يكفي
Dialogue: 0,0:13:02.34,0:13:04.47,Default,,0,0,0,,توقيت رائع، اتركني
Dialogue: 0,0:13:04.99,0:13:08.75,Default,,0,0,0,,أنتَ أوندا تيروكاي\Nرئيس أوندا للتجارة، صحيح؟
Dialogue: 0,0:13:08.75,0:13:11.22,Default,,0,0,0,,أنا ميجوري، مع وحدة تحقيقات القسم الأول
Dialogue: 0,0:13:11.22,0:13:13.41,Default,,0,0,0,,شرطة؟
Dialogue: 0,0:13:14.61,0:13:16.63,Default,,0,0,0,,كنتُ بانتظاركَ، موري سان
Dialogue: 0,0:13:17.10,0:13:20.98,Default,,0,0,0,,إذا كنتَ هنا الآن، فهذا يعني أنكَ حللتَ اللغز، صحيح؟
Dialogue: 0,0:13:20.98,0:13:21.69,Default,,0,0,0,,هاه؟
Dialogue: 0,0:13:22.32,0:13:24.82,Default,,0,0,0,,ماذا كان ذلك مجدداً؟
Dialogue: 0,0:13:24.82,0:13:26.02,Default,,0,0,0,,هيا الآن
Dialogue: 0,0:13:26.02,0:13:29.53,Default,,0,0,0,,نحن هنا فقط لأنكَ أخبرتَنا أن ننقذ الخمسة المفقودين
Dialogue: 0,0:13:29.53,0:13:31.33,Default,,0,0,0,,ونستجوبهم بشأن هذا الموقع
Dialogue: 0,0:13:31.92,0:13:33.12,Default,,0,0,0,,إنقاذ؟
Dialogue: 0,0:13:33.37,0:13:34.44,Default,,0,0,0,,أجل
Dialogue: 0,0:13:34.44,0:13:37.00,Default,,0,0,0,,لقد أنقذناهم من المكان الذي كانوا محتجزين فيه
Dialogue: 0,0:13:37.00,0:13:38.30,Default,,0,0,0,,أخذناهم للحجز
Dialogue: 0,0:13:38.30,0:13:41.63,Default,,0,0,0,,وحالياً نقوم باستجوابهم بشأن هذا الموقف
Dialogue: 0,0:13:42.02,0:13:44.85,Default,,0,0,0,,لذا، موري سان، ما هذا اللغز؟
Dialogue: 0,0:13:44.85,0:13:47.42,Default,,0,0,0,,...حسناً، لأكون صادقاً
Dialogue: 0,0:13:47.42,0:13:49.69,Default,,0,0,0,,...ليس لدي فكرة
Dialogue: 0,0:13:50.46,0:13:51.89,Default,,0,0,0,,هاه؟
Dialogue: 0,0:13:57.76,0:13:58.60,Default,,0,0,0,,هل هذا...؟
Dialogue: 0,0:13:59.06,0:14:00.36,Default,,0,0,0,,أخيراً
Dialogue: 0,0:14:02.08,0:14:03.86,Default,,0,0,0,,كوغورو النائم
Dialogue: 0,0:14:04.28,0:14:05.86,Default,,0,0,0,,اعذرني
Dialogue: 0,0:14:05.86,0:14:08.74,Default,,0,0,0,,الآن، لِحل اللغز
Dialogue: 0,0:14:09.49,0:14:13.56,Default,,0,0,0,,كانت مواقفها مشابه مع احدى القضايا التي لم تحل
Dialogue: 0,0:14:14.13,0:14:17.28,Default,,0,0,0,,...لكن بالنسبة للأدلة التي تحلها
Dialogue: 0,0:14:17.76,0:14:18.52,Default,,0,0,0,,كونان
Dialogue: 0,0:14:19.28,0:14:20.63,Default,,0,0,0,,هنا
Dialogue: 0,0:14:20.90,0:14:22.01,Default,,0,0,0,,حسناً، كما ترى
Dialogue: 0,0:14:22.01,0:14:26.03,Default,,0,0,0,,أول شيء ظننتُه كان غريباً هو تيراميسو
Dialogue: 0,0:14:26.03,0:14:27.26,Default,,0,0,0,,كعك التيراميسو؟
Dialogue: 0,0:14:27.62,0:14:28.57,Default,,0,0,0,,أجل
Dialogue: 0,0:14:28.57,0:14:33.51,Default,,0,0,0,,كانت التحلية على المقعد مع امرأة\Nبحوزتها منديل مرسوم عليه زهور
Dialogue: 0,0:14:34.67,0:14:37.88,Default,,0,0,0,,كان وقت العشاء عندما اختفى الجميع
Dialogue: 0,0:14:37.88,0:14:40.55,Default,,0,0,0,,لكن شخص واحد كان يتناول التيراميسو بدلاً من ذلك
Dialogue: 0,0:14:40.55,0:14:46.82,Default,,0,0,0,,...وقال الطاهي أن هذا بسبب أن بعض الناس يحبون تناول التحلية أولاً، لكن
Dialogue: 0,0:14:47.74,0:14:50.03,Default,,0,0,0,,أدركتُ أن الأمر كان غلطة
Dialogue: 0,0:14:51.21,0:14:52.66,Default,,0,0,0,,أي غلطة؟
Dialogue: 0,0:14:52.86,0:14:56.66,Default,,0,0,0,,كان للإجابة علاقة بالصور التي وُجدت على الهاتف
Dialogue: 0,0:14:57.85,0:15:02.92,Default,,0,0,0,,في صور الحفلات السابقة، كان هنالك\N...دائماً شخص واحد يتناول التحلية
Dialogue: 0,0:15:03.37,0:15:08.17,Default,,0,0,0,,لكنها لم تكن إيكوني سان\Nبل إيكيتاني سان، رجلاً
Dialogue: 0,0:15:08.17,0:15:09.78,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:09.78,0:15:10.93,Default,,0,0,0,,ليس ذلك فقط
Dialogue: 0,0:15:11.36,0:15:13.51,Default,,0,0,0,,لكن عندما يكون لديكَ نفس المجموعة دائماً
Dialogue: 0,0:15:13.51,0:15:16.56,Default,,0,0,0,,يجب أن يكون هنالك نظام جلوس معين لهم
Dialogue: 0,0:15:16.90,0:15:19.81,Default,,0,0,0,,وهذه المرة أشارت أن هذا كان الوضع
Dialogue: 0,0:15:21.06,0:15:23.94,Default,,0,0,0,,لكن لسبب ما، ذلك لم يحدث الليلة
Dialogue: 0,0:15:24.31,0:15:26.26,Default,,0,0,0,,نظام الجلوس المعتاد
Dialogue: 0,0:15:26.26,0:15:29.57,Default,,0,0,0,,كان به أغراض أشخاص مختلفة بالمكان
Dialogue: 0,0:15:30.73,0:15:33.00,Default,,0,0,0,,...لستُ متأكداً من أنه يمكنني مجاراتكَ
Dialogue: 0,0:15:33.00,0:15:35.46,Default,,0,0,0,,ماذا كانت الفائدة من كل ذلك؟
Dialogue: 0,0:15:35.46,0:15:40.08,Default,,0,0,0,,...كانت لجعل موري كوغورو يلاحظ شيئاً
Dialogue: 0,0:15:40.63,0:15:42.21,Default,,0,0,0,,الحقيقة خلف هذه القضية
Dialogue: 0,0:15:42.21,0:15:44.00,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:46.43,0:15:48.71,Default,,0,0,0,,عندما جمعتَهما هما الاثنان
Dialogue: 0,0:15:49.36,0:15:54.00,Default,,0,0,0,,هذا يظهر طريقاً للمخزن حيث تم إخفاء الأشخاص المفقودين
Dialogue: 0,0:15:54.44,0:15:58.72,Default,,0,0,0,,ملاحظات "لعنة" تلك كانت جزءاً آخراً من الأحجية
Dialogue: 0,0:15:59.47,0:16:04.41,Default,,0,0,0,,في البداية ظننتُ أن خمستهم تم احتجازهم بالمطعم
Dialogue: 0,0:16:04.87,0:16:09.66,Default,,0,0,0,,وبعدها نُقلوا للمخزن حيث تم حبسهم
Dialogue: 0,0:16:09.66,0:16:11.74,Default,,0,0,0,,أليس هذا ما حدث؟
Dialogue: 0,0:16:11.94,0:16:12.68,Default,,0,0,0,,لا
Dialogue: 0,0:16:12.68,0:16:16.50,Default,,0,0,0,,إذا كان ذلك ما حدث، فسيكون خمستهم جالسين بنفس المكان كالمعتاد
Dialogue: 0,0:16:16.50,0:16:19.38,Default,,0,0,0,,تاركين أغراضهم على مقاعدهم
Dialogue: 0,0:16:19.79,0:16:21.39,Default,,0,0,0,,ولم يكن هناك أغراض أخرى
Dialogue: 0,0:16:21.39,0:16:23.00,Default,,0,0,0,,معطف ملطخ بالنبيذ
Dialogue: 0,0:16:23.69,0:16:27.75,Default,,0,0,0,,مع أجزاء من الزجاج المكسور\Nلم يكن له تفسير بذلك الوقت
Dialogue: 0,0:16:28.51,0:16:33.88,Default,,0,0,0,,لم يكن هنالك أي علامة على كأس مكسور أو زجاجة في سلّات قمامة المطعم أيضاً
Dialogue: 0,0:16:34.11,0:16:35.67,Default,,0,0,0,,...مما يعني
Dialogue: 0,0:16:36.06,0:16:38.86,Default,,0,0,0,,أيها المحقق ميجوري، حاول التذكر رجاءً
Dialogue: 0,0:16:39.22,0:16:45.40,Default,,0,0,0,,بدأوا بتناول الطعام قبل وصولنا للمطعم بـ20 دقيقة
Dialogue: 0,0:16:45.86,0:16:49.40,Default,,0,0,0,,لكن محركات السيارة المركونة بالخارج\Nكانت لا تزال تشع حرارة
Dialogue: 0,0:16:49.40,0:16:54.40,Default,,0,0,0,,كما لو أنها مركونة منذ لحظات فقط
Dialogue: 0,0:16:55.13,0:16:59.03,Default,,0,0,0,,وذلك المخزن، كان به طاولة مع مقاعد
Dialogue: 0,0:16:59.03,0:17:02.29,Default,,0,0,0,,وكؤوس نبيذ مكسورة وزجاجة
Dialogue: 0,0:17:02.65,0:17:05.44,Default,,0,0,0,,...فهمتُ، إذاً تقول
Dialogue: 0,0:17:05.44,0:17:09.08,Default,,0,0,0,,تم خداعهم من الأساس في ذلك المخزن
Dialogue: 0,0:17:09.08,0:17:10.67,Default,,0,0,0,,حيث تم حبسهم
Dialogue: 0,0:17:12.62,0:17:16.12,Default,,0,0,0,,أيها الرئيس أوندا، كنتم جميعاً تحتفلون في أماكن متنوعة
Dialogue: 0,0:17:16.12,0:17:18.68,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:17:18.90,0:17:23.84,Default,,0,0,0,,تضمنت الصورة على الهاتف مطاعماً واسطح ناطحات سحاب
Dialogue: 0,0:17:23.84,0:17:27.26,Default,,0,0,0,,قمم جبال، شواطئاً وحتى جزراً مهجورة
Dialogue: 0,0:17:27.80,0:17:31.76,Default,,0,0,0,,استخدام اسمكَ كـ طُعم كان سيكون كافياً
Dialogue: 0,0:17:31.76,0:17:33.80,Default,,0,0,0,,لاستدراجهم للمخزن بقليل من المتاعب
Dialogue: 0,0:17:33.80,0:17:36.26,Default,,0,0,0,,وجعلهم يبدأون اقتراح نخب بين أنفسهم
Dialogue: 0,0:17:36.26,0:17:38.45,Default,,0,0,0,,مخزن؟ عماذا تتحدث؟
Dialogue: 0,0:17:39.17,0:17:41.70,Default,,0,0,0,,حسناً، شكراً، أيها المحقق تاكاجي
Dialogue: 0,0:17:42.43,0:17:45.23,Default,,0,0,0,,تماماً كما استنتج العم كوغورو
Dialogue: 0,0:17:45.23,0:17:47.15,Default,,0,0,0,,النبيذ من المخزن
Dialogue: 0,0:17:47.15,0:17:51.10,Default,,0,0,0,,والنبيذ على المعطف في المطعم متطابقان
Dialogue: 0,0:17:51.10,0:17:53.46,Default,,0,0,0,,وكان به منوّم
Dialogue: 0,0:17:53.85,0:17:58.47,Default,,0,0,0,,أيضاً كان هنالك بريد إلكتروني من ذلك الرئيس يطلب منهم جميعاً الحضور
Dialogue: 0,0:17:58.47,0:18:02.35,Default,,0,0,0,,لا أذكر ابداً بأنني قد ارسلت ذلك البريد الإلكتروني
Dialogue: 0,0:18:02.72,0:18:05.60,Default,,0,0,0,,هذا لأن كوتشي-سان هو من أرسله
Dialogue: 0,0:18:09.14,0:18:12.65,Default,,0,0,0,,ما إن غابوا عن الوعي أخذ أحذيتهم
Dialogue: 0,0:18:13.22,0:18:15.24,Default,,0,0,0,,مع المعاطف وبعض المقتنيات الأخرى
Dialogue: 0,0:18:16.44,0:18:19.97,Default,,0,0,0,,وعاد للمطعم في السيارة التي وصلوا بها
Dialogue: 0,0:18:20.72,0:18:23.28,Default,,0,0,0,,وعندها استبدل أغراضهم على الطاولة
Dialogue: 0,0:18:23.28,0:18:26.40,Default,,0,0,0,,كما لو أنهم جميعاً هم من طلبوا الطعام
Dialogue: 0,0:18:27.34,0:18:31.10,Default,,0,0,0,,بعد ذلك، أعد آثار الأقدام التي \Nتقود للبحيرة من الباب الخلفي
Dialogue: 0,0:18:31.88,0:18:34.38,Default,,0,0,0,,لجعلها تبدو كما لو أنهم أغرقوا أنفسهم
Dialogue: 0,0:18:34.88,0:18:37.13,Default,,0,0,0,,"وضع ملاحظة "لعنة
Dialogue: 0,0:18:37.50,0:18:41.86,Default,,0,0,0,,وبعدها أذى نفسه بينما كان ينتظر وصولنا
Dialogue: 0,0:18:42.88,0:18:47.38,Default,,0,0,0,,بالمناسبة، تلك الملاحظات كانت رسالة في الواقع
Dialogue: 0,0:18:47.38,0:18:52.90,Default,,0,0,0,,للرئيس أوندا باستخدام اسم والده، أليس كذلك؟
Dialogue: 0,0:18:54.32,0:18:56.53,Default,,0,0,0,,باستخدام اسم والده؟
Dialogue: 0,0:18:56.91,0:19:00.64,Default,,0,0,0,,اسم والده هو كوتشي كيجو
Dialogue: 0,0:19:01.22,0:19:04.66,Default,,0,0,0,,إذا أخذتَ "كوتشي" كانجي من كوتشي-سان\Nو "آني" من كيجو
Dialogue: 0,0:19:04.66,0:19:06.40,Default,,0,0,0,,"فهذه كلمة "لعنة
Dialogue: 0,0:19:07.25,0:19:12.04,Default,,0,0,0,,قد يكون توقيعاً استخدمه والدكَ بالماضي؟
Dialogue: 0,0:19:12.58,0:19:15.42,Default,,0,0,0,,لأنكَ تستخدم واحداً مشابهاً
Dialogue: 0,0:19:16.55,0:19:17.63,Default,,0,0,0,,إي
Dialogue: 0,0:19:19.41,0:19:22.91,Default,,0,0,0,,بكلمات أخرى، ابن كوتشي كيجو سان\Nيكون إيجو-سان
Dialogue: 0,0:19:22.91,0:19:25.85,Default,,0,0,0,,مخططاً للانتقام لوالده
Dialogue: 0,0:19:25.85,0:19:28.43,Default,,0,0,0,,بقتل مجموعة الموظفين هؤلاء
