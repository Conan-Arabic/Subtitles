Dialogue: 0,0:00:15.46,0:00:16.93,Default,,0,0,0,,رائع
Dialogue: 0,0:00:19.74,0:00:21.76,Default,,0,0,0,,أليس هذا رائعاً، كونان-كن؟
Dialogue: 0,0:00:21.76,0:00:23.25,Default,,0,0,0,,إنه فعلاً كذلك
Dialogue: 0,0:00:25.99,0:00:28.06,Default,,0,0,0,,...أظن أننا لسنا الوحيدين هنا
Dialogue: 0,0:00:43.09,0:00:43.85,Default,,0,0,0,,هاه؟
Dialogue: 0,0:00:44.56,0:00:46.89,Default,,0,0,0,,ظننتُ أنه كان هنالك أشخاص آخرون هنا
Dialogue: 0,0:00:48.36,0:00:51.61,Default,,0,0,0,,على الأرجح أنهم ليسوا في الحمام
Dialogue: 0,0:00:52.13,0:00:53.52,Default,,0,0,0,,جميعهم؟
Dialogue: 0,0:01:04.92,0:01:07.17,Default,,0,0,0,,هذا النوع من التشابه
Dialogue: 0,0:01:07.68,0:01:10.63,Default,,0,0,0,,ماذا حدث لتلك السفينة؟
Dialogue: 0,0:01:11.14,0:01:14.76,Default,,0,0,0,,تعني لغز ماري سيليستي؟
Dialogue: 0,0:01:14.76,0:01:16.88,Default,,0,0,0,,أوه، أجل! تلك
Dialogue: 0,0:01:16.88,0:01:19.14,Default,,0,0,0,,لغز ماري سيليستي؟
Dialogue: 0,0:01:19.30,0:01:20.18,Default,,0,0,0,,أجل
Dialogue: 0,0:01:20.18,0:01:24.31,Default,,0,0,0,,إنها قضية شهيرة لم تُحل من القرن الـ19
Dialogue: 0,0:01:24.90,0:01:29.73,Default,,0,0,0,,إن لم تخني الذاكرة، طاقم عمل من\Nعشر أشخاص قد تبخر في الهواء
Dialogue: 0,0:01:30.59,0:01:34.33,Default,,0,0,0,,وبعدها وُجدت السفينة هائمة في البحر
Dialogue: 0,0:01:35.23,0:01:37.52,Default,,0,0,0,,وكان هناك حساء ساخن وأواني فضية منصوبة
Dialogue: 0,0:01:37.52,0:01:40.63,Default,,0,0,0,,تجعلكَ تظن أنهم أوشكوا على تناول الطعام
Dialogue: 0,0:01:42.83,0:01:45.39,Default,,0,0,0,,هذا الموقف مشابه
Dialogue: 0,0:01:48.90,0:01:49.88,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:01:52.93,0:01:54.00,Default,,0,0,0,,كوتشي-سان
Dialogue: 0,0:01:54.01,0:01:58.47,Default,,0,0,0,,{\p1\c&HCC858F&\3c&H010224&\3a&HFF&\fscx1610\fscy1525\4c&H020236&\4a&HFF&\clip(m 514 581 l 765 582 765 696 514 698)\fad(250,1)\pos(678,716)}m 0 0 l 25 0 l 25 10 l 0 10 l 0 0
