Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS \NX : @Theconansign
Dialogue: 0,0:00:03.25,0:00:04.48,Default,,0,0,0,,!أنت محق
Dialogue: 0,0:00:04.84,0:00:09.74,Default,,0,0,0,,.لم يسبق لي أن رأيت الشارة التي ترتديها لـ"كامين يايبا" من قبل
Dialogue: 0,0:00:09.74,0:00:11.87,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:00:12.23,0:00:17.73,Default,,0,0,0,,!لقد فزت بشارة نادرة بمناسبة الذكرى الرابعة والعشرين
Dialogue: 0,0:00:18.34,0:00:22.63,Default,,0,0,0,,.لقد نسيت تماماً أنني شاركت في السحب
Dialogue: 0,0:00:22.63,0:00:24.18,Default,,0,0,0,,!كم أنت محظوظ
Dialogue: 0,0:00:24.18,0:00:27.01,Default,,0,0,0,,...نعم. بالمناسبة
Dialogue: 0,0:00:27.38,0:00:29.25,Default,,0,0,0,,بحديثنا عن يايبا
Dialogue: 0,0:00:29.81,0:00:33.56,Default,,0,0,0,,سمعت أن هناك قط ضائع هنا يشبه
Dialogue: 0,0:00:33.56,0:00:36.81,Default,,0,0,0,,.قطة هوية يايبا السرية، شيروغاني رايها
Dialogue: 0,0:00:43.65,0:00:45.67,Default,,0,0,0,,أليست هذا هو القط؟
Dialogue: 0,0:00:45.67,0:00:46.90,Default,,0,0,0,,!إنه هو
Dialogue: 0,0:00:46.90,0:00:49.61,Default,,0,0,0,,.إنه حقاً يشبه توراكاغي
Dialogue: 0,0:00:49.92,0:00:51.78,Default,,0,0,0,,.تعال إلى هنا
Dialogue: 0,0:00:51.78,0:00:53.48,Default,,0,0,0,,.هيا. تعال إلى هنا
Dialogue: 0,0:00:56.89,0:00:58.04,Default,,0,0,0,,.قط مطيع
Dialogue: 0,0:01:01.27,0:01:04.84,Default,,0,0,0,,.هناك قطعة ورق ممزقة في فمه
Dialogue: 0,0:01:10.47,0:01:11.86,Default,,0,0,0,,.يبدو أنها موجهة إليك
Dialogue: 0,0:01:12.55,0:01:13.55,Default,,0,0,0,,...حسناً
Dialogue: 0,0:01:18.40,0:01:20.39,Default,,0,0,0,,هل هناك شيء مكتوب عليها؟
Dialogue: 0,0:01:23.12,0:01:25.14,Default,,0,0,0,,النجدة؟
Dialogue: 0,0:01:27.84,0:01:30.14,Default,,0,0,0,,ماذا تخفي خلف قناعك المحطم؟
Dialogue: 0,0:01:30.14,0:01:31.99,Default,,0,0,0,,!نداء استغاثة محمول في فم قط
Dialogue: 0,0:01:31.99,0:01:34.49,Default,,0,0,0,,!ملكة الرياح على رأس المهمة
Dialogue: 0,0:01:34.49,0:01:36.06,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:01:36.06,0:01:37.91,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:01:37.91,0:01:40.41,Default,,0,0,0,,!اسمه هو المحقق كونان
Dialogue: 0,0:03:22.42,0:03:26.33,Default,,0,0,0,,"!مستودع الطوب الأحمر - المجرم الذي اختفى، الجزء الأول"
Dialogue: 0,0:03:37.59,0:03:38.78,Default,,0,0,0,,.تباً
Dialogue: 0,0:03:39.24,0:03:40.28,Default,,0,0,0,,.تباً
Dialogue: 0,0:03:40.68,0:03:41.80,Default,,0,0,0,,!تباً
Dialogue: 0,0:03:42.39,0:03:46.46,Default,,0,0,0,,...إذا تمكن هذا الرجل من الهرب، فإن شيروي
Dialogue: 0,0:03:51.98,0:03:55.63,Default,,0,0,0,,.كانت مراقبة الليل بأكمله مرهقة
Dialogue: 0,0:03:57.75,0:03:58.76,Default,,0,0,0,,!أنت
Dialogue: 0,0:04:00.19,0:04:02.39,Default,,0,0,0,,تلك الدراجة النارية لك، أليس كذلك؟
Dialogue: 0,0:04:02.39,0:04:04.31,Default,,0,0,0,,.غير مسموح لك بالركن هنا
Dialogue: 0,0:04:07.06,0:04:10.19,Default,,0,0,0,,.انقلها، وإلا ستتلقى مخالفة
Dialogue: 0,0:04:11.13,0:04:12.19,Default,,0,0,0,,.من يومي
Dialogue: 0,0:04:24.45,0:04:27.34,Default,,0,0,0,,!أنت! حقيبتك
Dialogue: 0,0:04:31.21,0:04:32.40,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:04:33.54,0:04:35.62,Default,,0,0,0,,ماذا تفعلين، ساتو؟
Dialogue: 0,0:04:35.62,0:04:36.42,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:04:36.42,0:04:40.12,Default,,0,0,0,,المفـ-المفتش هاتوري من فريق التحقيق الخاص؟
Dialogue: 0,0:04:40.12,0:04:44.43,Default,,0,0,0,,!ذلك الرجل الذي فرّ على الدراجة النارية هو مختطف جاء لاستلام الفدية
Dialogue: 0,0:04:44.43,0:04:45.71,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:04:45.71,0:04:47.49,Default,,0,0,0,,ألم تسمعي؟
Dialogue: 0,0:04:47.49,0:04:52.69,Default,,0,0,0,,.هذا الصباح، تم اختطاف حفيدة الرئيس إيشيغامي شوجي، شيروي
Dialogue: 0,0:04:53.05,0:04:57.07,Default,,0,0,0,,.هذا كان موقع تسليم الفدية
Dialogue: 0,0:04:57.44,0:05:01.59,Default,,0,0,0,,كنا نخطط للسماح له بأخذ الحقيبة التي تحتوي على الفدية وجهاز تتبع
Dialogue: 0,0:05:01.59,0:05:06.84,Default,,0,0,0,,.وتتبع مخبئهم أو أينما كانوا يحتجزون شيروي
Dialogue: 0,0:05:06.84,0:05:09.58,Default,,0,0,0,,!لكن ليس لدينا خيار الآن. تبا
Dialogue: 0,0:05:09.58,0:05:12.84,Default,,0,0,0,,!أنطلقي وراءه واعتقلِيه
Dialogue: 0,0:05:12.84,0:05:15.21,Default,,0,0,0,,!لا تمنحيه فرصة للاتصال بشركائه
Dialogue: 0,0:05:15.21,0:05:16.42,Default,,0,0,0,,!حاضر
Dialogue: 0,0:05:18.25,0:05:20.60,Default,,0,0,0,,!لن أسمح له بالإفلات
Dialogue: 0,0:05:20.60,0:05:23.78,Default,,0,0,0,,.أنسة ساتو، هذا سيئ
Dialogue: 0,0:05:23.78,0:05:24.78,Default,,0,0,0,,ما هو السيئ؟
Dialogue: 0,0:05:24.78,0:05:25.78,Default,,0,0,0,,.ذلك
Dialogue: 0,0:05:25.78,0:05:26.60,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:05:26.60,0:05:29.60,Default,,0,0,0,,.لقد دخلنا محافظة كاناغاوا
Dialogue: 0,0:05:30.08,0:05:31.73,Default,,0,0,0,,.هذا سيئ حقاً
Dialogue: 0,0:05:33.73,0:05:36.21,Default,,0,0,0,,.كوني حذرة من الآن فصاعداً
Dialogue: 0,0:06:00.30,0:06:03.32,Default,,0,0,0,,.إنه يتجاهل إشارات المرور
Dialogue: 0,0:06:37.87,0:06:39.96,Default,,0,0,0,,.لا فائدة. لا يمكنني التوقف في الوقت المناسب
Dialogue: 0,0:06:57.56,0:06:59.16,Default,,0,0,0,,مـ-ماذا حدث؟
Dialogue: 0,0:07:00.39,0:07:02.65,Default,,0,0,0,,هـ-هل هو بخير؟
Dialogue: 0,0:07:08.01,0:07:09.10,Default,,0,0,0,,حسناً؟
Dialogue: 0,0:07:09.10,0:07:10.91,Default,,0,0,0,,.أنا بخير
Dialogue: 0,0:07:11.56,0:07:12.84,Default,,0,0,0,,.هذا عظيم
Dialogue: 0,0:07:13.65,0:07:14.75,Default,,0,0,0,,.كلنا بخير هنا
Dialogue: 0,0:07:14.75,0:07:16.67,Default,,0,0,0,,لماذا لا تتوقفين على جانب الطريق؟
Dialogue: 0,0:07:16.67,0:07:17.92,Default,,0,0,0,,.حاضر
Dialogue: 0,0:07:23.44,0:07:26.21,Default,,0,0,0,,.يبدو أننا فقدناه
Dialogue: 0,0:07:26.21,0:07:27.40,Default,,0,0,0,,.نعم
Dialogue: 0,0:07:27.40,0:07:28.44,Default,,0,0,0,,...لا
Dialogue: 0,0:07:28.99,0:07:32.49,Default,,0,0,0,,.الدراجة النارية التي كنتما تطاردونها انقلبت هناك
Dialogue: 0,0:07:32.49,0:07:36.99,Default,,0,0,0,,.اختفى السائق بين الحشود عند مستودع الطوب الأحمر
Dialogue: 0,0:07:38.09,0:07:42.11,Default,,0,0,0,,اعذريني إذا كنت مخطئ
Dialogue: 0,0:07:42.11,0:07:46.07,Default,,0,0,0,,لكن هل التقينا في حفل التعارف وقضية؟
Dialogue: 0,0:07:53.35,0:07:58.83,Default,,0,0,0,,أنا نقيبة الوحدة المرورية المتنقلة الثالثة، قسم مرور شرطة كاناغاوا
Dialogue: 0,0:07:59.58,0:08:01.59,Default,,0,0,0,,.هاغيوارا تشيهايا
Dialogue: 0,0:08:04.46,0:08:08.79,Default,,0,0,0,,.يبدو أن تلك الدراجة النارية كانت مطلوبة لأكثر من مجرد السرعة
Dialogue: 0,0:08:08.79,0:08:10.77,Default,,0,0,0,,...في الواقع
Dialogue: 0,0:08:11.19,0:08:12.71,Default,,0,0,0,,.المعذرة
Dialogue: 0,0:08:15.07,0:08:16.98,Default,,0,0,0,,ماذا؟ كـ-كونان يتصل؟
Dialogue: 0,0:08:18.85,0:08:23.23,Default,,0,0,0,,.أسف، كونان. ليس لدي وقت للتحدث معك الآن
Dialogue: 0,0:08:23.23,0:08:27.24,Default,,0,0,0,,هل تم اختطاف فتاة اسمها شيروي؟
Dialogue: 0,0:08:27.24,0:08:28.34,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:08:30.44,0:08:31.74,Default,,0,0,0,,.فهمت
Dialogue: 0,0:08:32.05,0:08:34.45,Default,,0,0,0,,للتوضيح، هذا الصباح
Dialogue: 0,0:08:34.45,0:08:39.65,Default,,0,0,0,,.تم اختطاف حفيدة الرئيس إيشيغامي شوجي، شيروي
Dialogue: 0,0:08:39.65,0:08:42.52,Default,,0,0,0,,عندما جاء المختطف لاستلام الفدية
Dialogue: 0,0:08:42.52,0:08:46.76,Default,,0,0,0,,.قمتِ أنتِ وزميلك عن طريق الخطأ بتركه يهرب، لذا طاردتموه إلى هنا
Dialogue: 0,0:08:46.76,0:08:49.88,Default,,0,0,0,,في الوقت نفسه، في مدينة بيكا في الشارع الخامس، كونان وأصدقاؤه
Dialogue: 0,0:08:49.88,0:08:56.18,Default,,0,0,0,,.كانوا في طريقهم إلى المنزل من المدرسة ووجدوا قط ضائع يحمل قطعة ورق في فمه
Dialogue: 0,0:08:56.18,0:08:58.39,Default,,0,0,0,,وعندما فتحوها
Dialogue: 0,0:08:58.39,0:09:01.16,Default,,0,0,0,,.وجدوا مكتوباً عليها "شيروي النجدة"
Dialogue: 0,0:09:01.16,0:09:05.14,Default,,0,0,0,,نعم. الورقة ممزقة، لذا لا يمكننا قراءتها بشكل صحيح
Dialogue: 0,0:09:05.14,0:09:08.78,Default,,0,0,0,,.لكن أعتقد أنها قالت: "شيروي في خطر، أرسلوا النجدة"
Dialogue: 0,0:09:09.23,0:09:11.95,Default,,0,0,0,,ما هو عنوان منزل شيروي؟
Dialogue: 0,0:09:11.95,0:09:14.38,Default,,0,0,0,,...تأكدنا أثناء مطاردة المختطف
Dialogue: 0,0:09:14.38,0:09:18.07,Default,,0,0,0,,.المكان في مدينة هايدو، الشارع الأول، القطعة رقم ثمانية
Dialogue: 0,0:09:18.07,0:09:21.79,Default,,0,0,0,,.هذا قريب من المكان الذي وجد فيه كونان الورقة
Dialogue: 0,0:09:22.09,0:09:28.95,Default,,0,0,0,,إذن، إما أنها أسقطت تلك الورقة طالبة النجدة لأنها اختُطيفت من منزلها
Dialogue: 0,0:09:28.95,0:09:34.05,Default,,0,0,0,,.أو لأنها محتجزة في مكان قريب
Dialogue: 0,0:09:34.52,0:09:39.37,Default,,0,0,0,,.إذن سنستجوب الأشخاص الذين يعيشون هنا بالجوار
Dialogue: 0,0:09:39.37,0:09:41.73,Default,,0,0,0,,.سنخبركم إذا علمنا بأي شيء
Dialogue: 0,0:09:42.72,0:09:44.20,Default,,0,0,0,,!انتظر
Dialogue: 0,0:09:44.20,0:09:50.32,Default,,0,0,0,,.أنا متأكدة أن المختطفين قالوا أنهم سيقتلونها إذا تم الاتصال بالشرطة
Dialogue: 0,0:09:50.81,0:09:54.32,Default,,0,0,0,,.لذا فإن ترك الأمر لكونان ليس فكرة سيئة
Dialogue: 0,0:09:55.33,0:09:57.58,Default,,0,0,0,,لـ-لكن لماذا؟
Dialogue: 0,0:09:57.58,0:10:03.58,Default,,0,0,0,,إذا اعتقدوا أن الأطفال يسألون لأن صديقهم تغيب عن المدرسة وهم قلقون
Dialogue: 0,0:10:03.58,0:10:05.81,Default,,0,0,0,,.فمن المرجح أن يكونوا أقل شكاً
Dialogue: 0,0:10:06.35,0:10:08.67,Default,,0,0,0,,...ربما، لكن
Dialogue: 0,0:10:08.67,0:10:13.72,Default,,0,0,0,,.حسناً، إذا حدث أي شيء للأطفال، يمكنكما تحمل المسؤولية ببساطة
Dialogue: 0,0:10:17.25,0:10:21.37,Default,,0,0,0,,.الآن دعونا نتفقد المحلات في مستودع الطوب الأحمر
Dialogue: 0,0:10:22.31,0:10:23.36,Default,,0,0,0,,...لكن
Dialogue: 0,0:10:23.36,0:10:25.10,Default,,0,0,0,,ألم يهرب المختطف بالفعل؟
Dialogue: 0,0:10:26.07,0:10:31.86,Default,,0,0,0,,إذا لم يتصل رئيسكم ليوبخكم لتركه يهرب
Dialogue: 0,0:10:32.44,0:10:38.10,Default,,0,0,0,,.فإنه لم يتلق مكالمة غاضبة من المختطفين الذين لم يحصلوا على الفدية
Dialogue: 0,0:10:39.12,0:10:43.88,Default,,0,0,0,,.بمعنى آخر، الجاني لا يمكنه الاتصال بشركائه
Dialogue: 0,0:10:43.88,0:10:51.37,Default,,0,0,0,,.من المرجح أنه محتجز ومختبئ، يأمل في انتظارنا حتى نستسلم
Dialogue: 0,0:10:53.14,0:10:57.82,Default,,0,0,0,,على أي حال، ما المنطقة التي يجب أن نغطيها في الاستجواب؟
Dialogue: 0,0:10:58.35,0:11:01.36,Default,,0,0,0,,فقط المنطقة المحيطة بمنزلها يجب أن تكون كافية، أليس كذلك؟
Dialogue: 0,0:11:01.36,0:11:06.28,Default,,0,0,0,,.لكننا لا نعرف من أين التقط هذا القط قطعة الورق هذه
Dialogue: 0,0:11:06.28,0:11:10.02,Default,,0,0,0,,.لا يمكن معرفة إلى أي مدى قد يبقى ضائع
Dialogue: 0,0:11:10.02,0:11:14.38,Default,,0,0,0,,.في الواقع، على الأرجح لا يزيد عن دائرة نصف قطره مائة متر
Dialogue: 0,0:11:14.38,0:11:17.78,Default,,0,0,0,,.لا يمكن معرفة إلى أي مدى قد يصل قط نحيل بالفعل
Dialogue: 0,0:11:18.27,0:11:22.17,Default,,0,0,0,,.لكن شبيه توراكاغي هذا مستدير وجميل
Dialogue: 0,0:11:22.17,0:11:24.41,Default,,0,0,0,,.شخص ما كان يطعمه
Dialogue: 0,0:11:24.41,0:11:26.98,Default,,0,0,0,,.بمعنى آخر، هو في الأساس حيوان أليف
Dialogue: 0,0:11:26.98,0:11:31.92,Default,,0,0,0,,.القطط الذكور الخارجية تتنقل فقط حوالي مائة متر
Dialogue: 0,0:11:31.92,0:11:33.89,Default,,0,0,0,,.فهمت
Dialogue: 0,0:11:33.89,0:11:36.61,Default,,0,0,0,,.هذه مهمة لفريق المحققين الصغار
Dialogue: 0,0:11:36.61,0:11:37.67,Default,,0,0,0,,.نعم
Dialogue: 0,0:11:38.96,0:11:40.62,Default,,0,0,0,,.سأذهب مع غينتا
Dialogue: 0,0:11:40.62,0:11:44.80,Default,,0,0,0,,.أنتم الثلاثة استجوبوا الجيران معاً
Dialogue: 0,0:11:44.80,0:11:45.93,Default,,0,0,0,,.فهمت
Dialogue: 0,0:11:45.93,0:11:49.91,Default,,0,0,0,,.لا تذكروا موضوع الاختطاف
Dialogue: 0,0:11:49.91,0:11:54.70,Default,,0,0,0,,.قصتنا هي أننا قلقون على شيروي لأنها تغيبت عن المدرسة
Dialogue: 0,0:11:54.70,0:11:55.71,Default,,0,0,0,,.حسناً
Dialogue: 0,0:11:55.71,0:11:57.95,Default,,0,0,0,,.لنتقابل هنا مرة أخرى بعد ساعة
Dialogue: 0,0:11:57.95,0:11:58.85,Default,,0,0,0,,!نعم
Dialogue: 0,0:11:58.85,0:11:59.63,Default,,0,0,0,,!حسناً
Dialogue: 0,0:12:08.18,0:12:09.67,Default,,0,0,0,,.كما توقعت
Dialogue: 0,0:12:09.67,0:12:12.57,Default,,0,0,0,,.خلع خوذته وسترته، وهرب
Dialogue: 0,0:12:12.57,0:12:16.47,Default,,0,0,0,,.ليس ذلك فحسب، بل نسي الهاتف في جيبه أيضاً
Dialogue: 0,0:12:16.47,0:12:19.22,Default,,0,0,0,,.ربما أنه كان في عجلة من أمره
Dialogue: 0,0:12:19.94,0:12:23.48,Default,,0,0,0,,الهاتف مقفل، لذا لا يمكننا رؤية ما فيه
Dialogue: 0,0:12:24.42,0:12:26.49,Default,,0,0,0,,.والدراجة النارية مسروقة
Dialogue: 0,0:12:26.49,0:12:29.74,Default,,0,0,0,,.لا نعرف وجهه ولا اسمه
Dialogue: 0,0:12:29.74,0:12:35.01,Default,,0,0,0,,.إذا كان يحاول تجنبنا، أشك أنه يتجول في الخارج ببساطة
Dialogue: 0,0:12:35.01,0:12:40.48,Default,,0,0,0,,.لا أتخيل أنه سيقف في طابور في متجر على مرأى من مطارديه
Dialogue: 0,0:12:43.94,0:12:50.25,Default,,0,0,0,,عندما تستبعد المحلات المغلقة لتناول الغداء
Dialogue: 0,0:12:50.74,0:12:56.03,Default,,0,0,0,,.من الآمن افتراض أنه اختبأ في متجر الفطائر هذا الفارغ نسبياً والمتوفر فيه مقاعد
Dialogue: 0,0:12:57.13,0:13:01.38,Default,,0,0,0,,تلك. أنسة ساتو، الجاني رأى وجوهنا، أتذكرين؟
Dialogue: 0,0:13:01.87,0:13:03.39,Default,,0,0,0,,.ستتلقى مخالفة
Dialogue: 0,0:13:04.34,0:13:07.18,Default,,0,0,0,,.هذا بالفعل يجعل من الصعب علينا الدخول
Dialogue: 0,0:13:07.18,0:13:11.37,Default,,0,0,0,,.لا نريد أن نثيره ويدخل في عنف داخل المتجر
Dialogue: 0,0:13:12.27,0:13:13.59,Default,,0,0,0,,.إذن ليس لدينا خيار
Dialogue: 0,0:13:16.00,0:13:19.36,Default,,0,0,0,,.يا أنسة قسم التحقيق الأول، اخلعي ملابسكِ
Dialogue: 0,0:13:19.70,0:13:20.74,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:20.74,0:13:22.11,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:22.48,0:13:25.62,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:13:34.99,0:13:36.27,Default,,0,0,0,,!مهلاً
Dialogue: 0,0:13:36.27,0:13:38.88,Default,,0,0,0,,!توقفي عن الدفع! المكان ضيق هنا
Dialogue: 0,0:13:38.88,0:13:41.41,Default,,0,0,0,,.وأنتِ أيضاً
Dialogue: 0,0:13:42.83,0:13:44.18,Default,,0,0,0,,!أنت تلمسيني
Dialogue: 0,0:13:44.70,0:13:46.50,Default,,0,0,0,,.تباعدي أكثر قليلاً
Dialogue: 0,0:13:46.50,0:13:48.18,Default,,0,0,0,,!هذا مؤلم
Dialogue: 0,0:13:46.50,0:13:48.90,Default,,0,0,0,,{\an8}لمن هذه المؤخرة؟
Dialogue: 0,0:13:53.91,0:13:57.87,Default,,0,0,0,,.إنها ضيقة قليلاً في منطقة الصدر، لكن ذلك لا يؤثر كثيراً
Dialogue: 0,0:13:57.87,0:13:59.82,Default,,0,0,0,,...هكذا إذن
Dialogue: 0,0:14:01.32,0:14:03.74,Default,,0,0,0,,.سأستعير زوجكِ
Dialogue: 0,0:14:03.74,0:14:05.41,Default,,0,0,0,,ز-زوج؟
Dialogue: 0,0:14:09.41,0:14:10.86,Default,,0,0,0,,.أهلاً
Dialogue: 0,0:14:11.56,0:14:13.80,Default,,0,0,0,,.اثنين، من فضلك
Dialogue: 0,0:14:18.73,0:14:20.82,Default,,0,0,0,,.اجلسا هنا
Dialogue: 0,0:14:20.82,0:14:22.59,Default,,0,0,0,,.حسناً
Dialogue: 0,0:14:24.18,0:14:26.72,Default,,0,0,0,,.هناك الكثير من الزبائن
Dialogue: 0,0:14:27.14,0:14:30.20,Default,,0,0,0,,.قد يكون من الصعب العثور على الجاني
Dialogue: 0,0:14:30.20,0:14:31.55,Default,,0,0,0,,.ثلاثة
Dialogue: 0,0:14:31.55,0:14:32.27,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:14:32.27,0:14:34.43,Default,,0,0,0,,ألم تلاحظ؟
Dialogue: 0,0:14:35.15,0:14:41.01,Default,,0,0,0,,.سائقي الدراجات النارية يعلقون قدمهم اليسرى تحت دواسة التروس للقيادة
Dialogue: 0,0:14:41.01,0:14:44.36,Default,,0,0,0,,.هذا يجعل أطراف أحذيتهم اليسرى متسخة
Dialogue: 0,0:14:44.36,0:14:48.16,Default,,0,0,0,,.هناك ثلاثة زبائن بهذه الصفة في هذا المتجر
Dialogue: 0,0:14:48.52,0:14:51.99,Default,,0,0,0,,إذن أحدهم هو المختطف؟
Dialogue: 0,0:14:51.99,0:14:55.42,Default,,0,0,0,,.نعم، على الأرجح
Dialogue: 0,0:14:57.65,0:15:04.39,Default,,0,0,0,,.إذن، من هم هؤلاء الثلاثة؟ أخبريني
Dialogue: 0,0:15:04.79,0:15:05.93,Default,,0,0,0,,ثلاثة؟
Dialogue: 0,0:15:05.93,0:15:10.36,Default,,0,0,0,,...أيتها الضابطة هاغيـ -أعني، أنسة هاغيوارا، ألم تقولي للتو
Dialogue: 0,0:15:10.36,0:15:12.57,Default,,0,0,0,,.نحن في موعد. ناديني تشيهايا
Dialogue: 0,0:15:12.57,0:15:16.69,Default,,0,0,0,,...أنـسة تشيهايا، لقد قلتِ للتو
Dialogue: 0,0:15:16.69,0:15:19.66,Default,,0,0,0,,.هناك ثلاثة زبائن هنا قد يكونون المشتبه به
Dialogue: 0,0:15:19.66,0:15:21.69,Default,,0,0,0,,.آسفة
Dialogue: 0,0:15:22.10,0:15:25.20,Default,,0,0,0,,.الفطائر هنا لذيذة جداً
Dialogue: 0,0:15:25.53,0:15:28.07,Default,,0,0,0,,.لقد تشتت انتباهي بتذوقها
Dialogue: 0,0:15:28.07,0:15:29.57,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:29.87,0:15:33.93,Default,,0,0,0,,.بالإضافة إلى ذلك، سيكون مريباً إذا تصرفنا بمجرد دخولنا
Dialogue: 0,0:15:33.93,0:15:35.75,Default,,0,0,0,,.اعتقد أنكِ محقة
Dialogue: 0,0:15:36.88,0:15:38.88,Default,,0,0,0,,.سنبدأ بالشخص الأول
Dialogue: 0,0:15:39.17,0:15:45.13,Default,,0,0,0,,.ذاك الجالس عند اتجاه الثانية، هو الرجل المعروف بتلاعبه بالنساء
Dialogue: 0,0:15:46.20,0:15:49.56,Default,,0,0,0,,.الجو بارد قليلاً في هذا الوقت من السنة لارتداء قميص فقط
Dialogue: 0,0:15:49.56,0:15:52.89,Default,,0,0,0,,.يبدو أنه خلع سترته
Dialogue: 0,0:15:53.35,0:15:57.90,Default,,0,0,0,,وطرف حذائه الأيسر متسخ أيضاً
Dialogue: 0,0:15:57.90,0:16:02.77,Default,,0,0,0,,.لكن من الصعب التأكد مما إذا كان ذلك من دواسة تروس دون نظرة أقرب
Dialogue: 0,0:16:03.87,0:16:06.30,Default,,0,0,0,,.التالي، الشخص الثاني
Dialogue: 0,0:16:06.30,0:16:11.41,Default,,0,0,0,,.إنه الرجل ذو المظهر القاسي عند الساعة الواحدة من حيث جلوسك
Dialogue: 0,0:16:11.87,0:16:15.22,Default,,0,0,0,,لا يبدو كشخص يستمتع بالفطائر
Dialogue: 0,0:16:15.22,0:16:17.85,Default,,0,0,0,,.ولديه خدش على رسغه الأيسر
Dialogue: 0,0:16:17.85,0:16:21.53,Default,,0,0,0,,.ربما أصاب نفسه عندما انقلبت دراجته النارية
Dialogue: 0,0:16:22.45,0:16:26.59,Default,,0,0,0,,طرف حذائه الأيسر متسخ أيضاً
Dialogue: 0,0:16:26.59,0:16:29.08,Default,,0,0,0,,.لكن لا يمكننا التأكد دون فحصه
Dialogue: 0,0:16:29.81,0:16:32.25,Default,,0,0,0,,.أخيراً، الشخص الأخير
Dialogue: 0,0:16:32.25,0:16:35.24,Default,,0,0,0,,.لا تنظر عندما أخبرك بمكانه
Dialogue: 0,0:16:35.24,0:16:36.68,Default,,0,0,0,,نعم؟
Dialogue: 0,0:16:37.14,0:16:40.94,Default,,0,0,0,,.إنه الموظف ذو النظارات خلفك مباشرة
Dialogue: 0,0:16:46.32,0:16:49.85,Default,,0,0,0,,.يرتدي سترة لافتة لا تناسبه
Dialogue: 0,0:16:50.41,0:16:56.65,Default,,0,0,0,,.الأذواق لا تُناقش، لكنه ربما اشترى شيئاً عشوائياً من مكان قريب
Dialogue: 0,0:16:57.67,0:17:01.87,Default,,0,0,0,,وبالطبع، طرف حذائه الأيسر متسخ
Dialogue: 0,0:17:01.87,0:17:04.43,Default,,0,0,0,,.رغم أن هذا أيضاً يحتاج لتأكيد
Dialogue: 0,0:17:05.34,0:17:09.34,Default,,0,0,0,,هل يمكنكِ سماعنا يا ضابطة قسم التحقيق الأول المنتظرة في الخارج؟
Dialogue: 0,0:17:09.34,0:17:10.45,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:17:10.45,0:17:12.93,Default,,0,0,0,,.أسفة، لكنني سأبدأ الآن
Dialogue: 0,0:17:12.93,0:17:14.97,Default,,0,0,0,,تبدئين بماذا؟
Dialogue: 0,0:17:23.58,0:17:25.71,Default,,0,0,0,,!أيها المتلاعب بالنساء
Dialogue: 0,0:17:25.71,0:17:28.11,Default,,0,0,0,,بماذا تعاملني؟
Dialogue: 0,0:17:29.46,0:17:34.62,Default,,0,0,0,,!من هي ميواكو؟ لقد قلتَ اسمها بينما كنت نائماً في السرير الليلة الماضية
Dialogue: 0,0:17:35.17,0:17:36.62,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:17:37.75,0:17:40.02,Default,,0,0,0,,أنسة تـ-تشيهايا؟
Dialogue: 0,0:17:41.51,0:17:43.00,Default,,0,0,0,,.خلفك
Dialogue: 0,0:17:48.14,0:17:49.71,Default,,0,0,0,,!أ-أنا آسف جداً
Dialogue: 0,0:17:49.71,0:17:51.82,Default,,0,0,0,,.أ-أنت متبلل بالماء
Dialogue: 0,0:17:51.82,0:17:53.93,Default,,0,0,0,,.لا تقلق بشأن ذلك
Dialogue: 0,0:17:54.80,0:17:58.10,Default,,0,0,0,,.حتى سروالك مبلل
Dialogue: 0,0:18:01.57,0:18:04.31,Default,,0,0,0,,المعذرة! هل يمكنني الحصول على منشفة؟
Dialogue: 0,0:18:08.96,0:18:11.19,Default,,0,0,0,,.سأذهب إلى الحمام
Dialogue: 0,0:18:19.78,0:18:21.58,Default,,0,0,0,,.أنا آسفة
Dialogue: 0,0:18:21.58,0:18:23.29,Default,,0,0,0,,.أحتاج إلى التقاط نقودي
Dialogue: 0,0:18:23.29,0:18:25.33,Default,,0,0,0,,هل يمكنك إبقاء قدميك ثابتة؟
Dialogue: 0,0:18:25.79,0:18:26.79,Default,,0,0,0,,.بالتأكيد
Dialogue: 0,0:18:27.34,0:18:28.96,Default,,0,0,0,,.اعذرني
Dialogue: 0,0:18:28.96,0:18:31.02,Default,,0,0,0,,.أقدر تعاونك
Dialogue: 0,0:18:32.14,0:18:36.72,Default,,0,0,0,,أنت ترتدي ملابس خفيفة. ألا تشعر بالبرد؟
Dialogue: 0,0:18:36.99,0:18:39.76,Default,,0,0,0,,.على الإطلاق. أنا أشعر بالحر
Dialogue: 0,0:18:39.76,0:18:41.85,Default,,0,0,0,,.أتمنى لو أستطيع خلع هذا القميص أيضاً
Dialogue: 0,0:18:42.33,0:18:44.04,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:18:46.23,0:18:48.61,Default,,0,0,0,,.نقودي تدحرجت إلى هناك أيضاً
Dialogue: 0,0:18:49.45,0:18:51.11,Default,,0,0,0,,.أنا آسفة جداً
Dialogue: 0,0:18:51.69,0:18:53.86,Default,,0,0,0,,أسقطت نقودي. هل يمكنك البقاء ثابتاً؟
Dialogue: 0,0:18:55.07,0:18:56.67,Default,,0,0,0,,.سأحضرها لكِ
Dialogue: 0,0:18:57.89,0:18:59.04,Default,,0,0,0,,.تفضلي
Dialogue: 0,0:18:59.04,0:19:00.29,Default,,0,0,0,,.شكراً
Dialogue: 0,0:19:00.74,0:19:05.25,Default,,0,0,0,,...رسغك الأيسر يبدو مجروحاً
Dialogue: 0,0:19:05.25,0:19:07.38,Default,,0,0,0,,بخصوص هذا؟
Dialogue: 0,0:19:07.38,0:19:10.37,Default,,0,0,0,,.اصطدم بي أحد من الخلف
Dialogue: 0,0:19:10.37,0:19:14.26,Default,,0,0,0,,.خدشته عندما تمايلت ووضعت يدي على الحائط
Dialogue: 0,0:19:15.19,0:19:17.30,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:19:19.02,0:19:22.39,Default,,0,0,0,,.حصلنا على مجموعة من المعلومات عن شيري
Dialogue: 0,0:19:22.39,0:19:23.57,Default,,0,0,0,,.حسناً
Dialogue: 0,0:19:25.12,0:19:27.52,Default,,0,0,0,,.لنراجع المعلومات التي جمعناها
Dialogue: 0,0:19:27.52,0:19:29.79,Default,,0,0,0,,.سأبدأ أنا وغينتا
Dialogue: 0,0:19:29.79,0:19:33.06,Default,,0,0,0,,.هذه الضائع مشهور هنا في الجوار
Dialogue: 0,0:19:33.06,0:19:36.03,Default,,0,0,0,,.الناس في الواقع ينادونه توراكاغي
Dialogue: 0,0:19:38.34,0:19:46.52,Default,,0,0,0,,أيضاً، توراكاغي يتم إطعامه عادةً من قبل الأنسة\N.كاوري، جدة شيروي المختطفة
Dialogue: 0,0:19:46.52,0:19:48.42,Default,,0,0,0,,حـ-حقاً؟
Dialogue: 0,0:19:48.42,0:19:55.01,Default,,0,0,0,,نعم. حول وقت الغداء، تترك الأنسة كاوري الطعام بجانب الشرفة في منزل شيروي
Dialogue: 0,0:19:55.01,0:19:58.18,Default,,0,0,0,,.ويتسلل توراكاغي ليأكله
Dialogue: 0,0:19:58.18,0:20:00.18,Default,,0,0,0,,.هذه هي روتينهم
Dialogue: 0,0:20:00.18,0:20:05.84,Default,,0,0,0,,.إذن، ربما تكون شيروي محتجزة في مكان يذهب إليه توراكاغي غالباً
Dialogue: 0,0:20:05.84,0:20:07.31,Default,,0,0,0,,.انتِ محقة
Dialogue: 0,0:20:07.31,0:20:13.07,Default,,0,0,0,,.ربما أعطت تلك الورقة للقط ليحملها إلى جدتها
Dialogue: 0,0:20:13.07,0:20:14.14,Default,,0,0,0,,.لا
Dialogue: 0,0:20:15.18,0:20:19.78,Default,,0,0,0,,.من المستحيل جعل قط يأخذ ويوصل ورقة
Dialogue: 0,0:20:19.78,0:20:21.85,Default,,0,0,0,,للتأكد من وصولها لشخص ما
Dialogue: 0,0:20:21.85,0:20:26.20,Default,,0,0,0,,.يجب لفها على شكل خيط وربطها حول عنق القط
Dialogue: 0,0:20:26.20,0:20:29.26,Default,,0,0,0,,.ربما كان هناك سبب يمنعها من فعل ذلك
Dialogue: 0,0:20:29.71,0:20:31.82,Default,,0,0,0,,بما أنها استطاعت كتابة هذه الورقة
Dialogue: 0,0:20:31.82,0:20:35.71,Default,,0,0,0,,.فمن المحتمل أنها ليست مقيدة بالكامل
Dialogue: 0,0:20:36.10,0:20:40.49,Default,,0,0,0,,إذا كان جزء من هذه الرسالة يشير إلى مكان احتجازها
Dialogue: 0,0:20:40.49,0:20:43.22,Default,,0,0,0,,.لكنا استطعنا استخدامه للعثور عليها
Dialogue: 0,0:20:43.51,0:20:47.28,Default,,0,0,0,,إذن، هل عرفتم أي شيء غير عادي يا رفاق؟
Dialogue: 0,0:20:47.28,0:20:48.46,Default,,0,0,0,,.نعم
Dialogue: 0,0:20:48.46,0:20:49.73,Default,,0,0,0,,...ينادونه
Dialogue: 0,0:20:50.31,0:20:52.32,Default,,0,0,0,,!رجل النرد
Dialogue: 0,0:20:55.48,0:20:58.75,Default,,0,0,0,,.ما هذا؟ يبدو مخيفاً
Dialogue: 0,0:20:58.75,0:21:04.12,Default,,0,0,0,,.طفل هنا رآه عندما مر أمام منزل شيروي
Dialogue: 0,0:21:04.67,0:21:07.55,Default,,0,0,0,,رجل مريب يرتدي قناعاً وقبعة
Dialogue: 0,0:21:07.55,0:21:12.13,Default,,0,0,0,,.ينظر إلى نرد موضوع على لوحة الاسم وهو يهمس لنفسه
Dialogue: 0,0:21:12.13,0:21:15.43,Default,,0,0,0,,هل تعرفين نوع النرد الذي كان؟
Dialogue: 0,0:21:15.43,0:21:20.13,Default,,0,0,0,,نعم. في ذلك الوقت، كان هناك ثلاثة على لوحة الاسم
Dialogue: 0,0:21:20.50,0:21:24.14,Default,,0,0,0,,لكن عندما خاطبه الطفل، هرب مسرعاً
Dialogue: 0,0:21:24.42,0:21:27.89,Default,,0,0,0,,.وأثناء ذلك، أسقط هذه القطعة
Dialogue: 0,0:21:36.90,0:21:40.03,Default,,0,0,0,,.إنها نوعاً ما مخيفة، أليس كذلك؟
Dialogue: 0,0:21:40.03,0:21:42.33,Default,,0,0,0,,هل هذا هو النرد الوحيد؟
Dialogue: 0,0:21:42.33,0:21:47.65,Default,,0,0,0,,.هذه هي القطعة الفعلية الوحيدة التي لدينا، لكن كان هناك قطعة على لوحة الاسم في اليوم التالي
Dialogue: 0,0:21:47.65,0:21:50.29,Default,,0,0,0,,.التقطوا صوراً بهاتفهم
Dialogue: 0,0:21:55.06,0:21:58.50,Default,,0,0,0,,بعد ذلك، سمعوا صوت باب المدخل يفتح
Dialogue: 0,0:21:58.50,0:22:02.85,Default,,0,0,0,,.لذا أعادوا النرد وذهبوا
Dialogue: 0,0:22:07.34,0:22:14.56,Default,,0,0,0,,.إذن من الممكن أن يكون للمختطفين شريك داخل منزل شيروي
Dialogue: 0,0:22:14.56,0:22:16.36,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:23:46.39,0:23:49.09,Default,,0,0,0,,!هذا تماماً مثل رجل النرد
Dialogue: 0,0:23:49.09,0:23:50.99,Default,,0,0,0,,.كان لديه شيء هنا أيضاً
Dialogue: 0,0:23:50.99,0:23:56.00,Default,,0,0,0,,.إذن رجل النرد هو بالتأكيد أحد المختطفين تقريباً
Dialogue: 0,0:23:57.37,0:23:59.33,Default,,0,0,0,,!تـ-تشيهايا
Dialogue: 0,0:24:00.31,0:24:02.34,Default,,0,0,0,,.لا مشكلة
Dialogue: 0,0:24:06.26,0:24:07.26,Default,,0,0,0,,.حسناً
Dialogue: 0,0:24:07.54,0:24:09.01,Default,,0,0,0,,.لنبدأ
Dialogue: 0,0:24:09.37,0:24:10.88,Default,,0,0,0,,الحلقة القادمة من كونان هي
Dialogue: 0,0:24:10.88,0:24:14.68,Default,,0,0,0,,"!مستودع الطوب الأحمر - المجرم الذي اختفى، الجزء الثاني 
Dialogue: 0,0:24:30.44,0:24:32.70,Default,,0,0,0,,!تلميح كونان القادم
Dialogue: 0,0:24:33.20,0:24:34.95,Default,,0,0,0,,!النرد
Dialogue: 0,0:24:34.95,0:24:36.21,Default,,0,0,0,,{\an8}.تبدوان كأنكما تستمتعان
Dialogue: 0,0:24:36.21,0:24:37.22,Default,,0,0,0,,{\an8}...كـ-كنا فقط نتظاهر
