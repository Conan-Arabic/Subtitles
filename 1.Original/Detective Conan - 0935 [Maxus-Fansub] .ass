Dialogue: 0,0:00:02.48,0:00:03.48,DCMain,OGU,0,0,0,,سينسي
Dialogue: 0,0:00:03.84,0:00:06.94,DCMain,OGU,0,0,0,,سينسي، إن لم تغادري الآن فستتأخرين
Dialogue: 0,0:00:08.95,0:00:10.61,DCMain,OGU,0,0,0,,.سينسي، سأدخل
Dialogue: 0,0:00:12.67,0:00:13.20,DCMain,OGU,0,0,0,,
Dialogue: 0,0:00:14.13,0:00:15.45,DCMain,OGU,0,0,0,,!سينسي
Dialogue: 0,0:00:16.87,0:00:18.09,DCMain,OGU,0,0,0,,!هذا سيّئ
Dialogue: 0,0:00:19.83,0:00:21.33,DCMain,MEGURE,0,0,0,,مخنوقة؟
Dialogue: 0,0:00:21.57,0:00:23.21,DCMain,TAKAGI,0,0,0,,باستخدام الحبل
Dialogue: 0,0:00:23.21,0:00:27.35,DCMain,TAKAGI,0,0,0,,الضحية مالكة لمحل بابا ساداكو-سان وعمرها 62 عامًا
Dialogue: 0,0:00:27.35,0:00:29.46,DCMain,TAKAGI,0,0,0,,وكانت وسيطة وعرّافة
Dialogue: 0,0:00:29.46,0:00:30.73,DCMain,MEGURE,0,0,0,,عرّافة؟
Dialogue: 0,0:00:30.73,0:00:31.84,DCMain,OGU,0,0,0,,.نعم
Dialogue: 0,0:00:31.84,0:00:35.80,Satoshi,SIGN,0,0,0,,{\fad(250,250)\p1\bord0\c&H6A2F4A&\fscx2310\fscy1325\clip(462.667,576,732,698.667)\pos(601.334,713.333)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:00:31.84,0:00:35.80,Satoshi,SIGN,0,0,0,,{\fad(250,250)\pos(598,632)\blur0.5}(أوغو ماسايا (26
Dialogue: 0,0:00:31.84,0:00:35.80,Satoshi,SIGN,0,0,0,,{\fad(250,250)\pos(594,680)\blur0.5}سكرتير باربارا ساداكو
Dialogue: 0,0:00:32.34,0:00:36.34,DCTop,OGU,0,0,0,,إنها تدير محلًا للعِرافة قرب محطة شيباهاما تحت اسم باربارا ساداكو
Dialogue: 0,0:00:36.52,0:00:39.32,DCMain,TAKAGI,0,0,0,,هذا سكرتير ساداكو-سان، أوغو ماسايا-سان
Dialogue: 0,0:00:39.32,0:00:41.22,DCMain,TAKAGI,0,0,0,,.وهو الذي اكتشف الجثة
Dialogue: 0,0:00:41.53,0:00:46.23,DCMain,CHIBA,0,0,0,,.سننتظر تقرير تشريح الجثة لكن يبدو أنها قُتلت الليلة الماضية
Dialogue: 0,0:00:46.51,0:00:47.71,DCMain,OGU,0,0,0,,الليلة الماضية؟
Dialogue: 0,0:00:47.71,0:00:48.86,DCMain,MEGURE,0,0,0,,أمن مشكلة؟
Dialogue: 0,0:00:48.86,0:00:53.17,DCMain,OGU,0,0,0,,.ربما يعرف المحقق موري كوغورو شيئًا بشأن هذا
Dialogue: 0,0:00:53.17,0:00:54.49,DCMain,MEGURE,0,0,0,,موري-كن؟
Dialogue: 0,0:00:54.96,0:00:56.99,DCMain,OGU,0,0,0,,لقد اتصل بالأمس
Dialogue: 0,0:00:58.25,0:01:00.99,DCItalic,OGU,0,0,0,,محل باربارا ساداكو للعِرافة، تفضل
Dialogue: 0,0:01:01.85,0:01:03.32,DCItalic,OGU,0,0,0,,.لحظة واحدة من فضلك
Dialogue: 0,0:01:04.31,0:01:07.31,DCItalic,OGU,0,0,0,,سينسي، إنه موري كوغورو-سان
Dialogue: 0,0:01:07.31,0:01:09.00,DCItalic,SADAKO,0,0,0,,المحقق المشهور؟
Dialogue: 0,0:01:09.00,0:01:12.84,Fukami,SIGN,0,0,0,,{\fad(250,250)\p1\bord0\c&H88273F&\clip(385.333,574.667,850.667,701.333)\pos(606.667,709.334)\fscx3020\fscy1306}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:01:09.00,0:01:12.84,Fukami,SIGN,0,0,0,,{\fad(250,250)\pos(614.667,637.334)\blur0.5}(بابا ساداكو (باربارا ساداكو) (62
Dialogue: 0,0:01:09.00,0:01:12.84,Fukami,SIGN,0,0,0,,{\fad(250,250)\pos(619.334,693.333)\blur0.5}عرّافة
Dialogue: 0,0:01:09.82,0:01:12.58,DCItalic,SADAKO,0,0,0,,{\a6}معك باربارا ساداكو
Dialogue: 0,0:01:14.45,0:01:17.45,DCMain,MEGURE,0,0,0,,دعا موري-كن الضحية للخروج؟
Dialogue: 0,0:03:14.72,0:03:17.40,DCMain,CONAN,0,0,0,,
Dialogue: 0,0:03:20.41,0:03:23.57,DCMain,KOGORO,0,0,0,,.لم أتصل بها
Dialogue: 0,0:03:23.57,0:03:24.22,DCMain,OGU,0,0,0,,...لكن
Dialogue: 0,0:03:24.52,0:03:26.39,DCMain,KOGORO,0,0,0,,.بلا لكن
Dialogue: 0,0:03:26.39,0:03:29.48,DCMain,KOGORO,0,0,0,,.إضافة لهذا إنني لا أعرف شيئًا عن الضحية
Dialogue: 0,0:03:29.48,0:03:32.23,DCMain,CONAN,0,0,0,,.وكنت في المنزل طوال الليل
Dialogue: 0,0:03:32.62,0:03:33.81,DCMain,KOGORO,0,0,0,,!صحيح
Dialogue: 0,0:03:33.81,0:03:36.86,DCMain,KOGORO,0,0,0,,.مهلًا، هذا الشقي يلحقني مجددًا
Dialogue: 0,0:03:37.75,0:03:40.11,DCMain,CONAN,0,0,0,,.لقد أكدت حُجّتك
Dialogue: 0,0:03:40.67,0:03:46.50,DCMain,KOGORO,0,0,0,,.من المحتمل أن السكرتير فعلها ويحاول الإيقاع بي
Dialogue: 0,0:03:46.50,0:03:49.01,DCMain,MEGURE,0,0,0,,هو من اكتشف الجثة
Dialogue: 0,0:03:49.01,0:03:51.44,DCMain,MEGURE,0,0,0,,تأكدنا من حجّته بالطبع
Dialogue: 0,0:03:51.44,0:03:52.97,DCMain,MEGURE,0,0,0,,.إنه بريء تمامًا
Dialogue: 0,0:03:53.96,0:03:55.25,DCMain,KOGORO,0,0,0,,.فهمت
Dialogue: 0,0:03:55.61,0:03:58.46,DCMain,MEGURE,0,0,0,,..من المؤكد أن الجاني استخدم اسم موري-كن
Dialogue: 0,0:03:58.46,0:04:02.05,DCMain,MEGURE,0,0,0,,.ليدعو ساداكو-سان إلى موقع الجريمة..
Dialogue: 0,0:04:02.05,0:04:02.76,DCMain,OGU,0,0,0,,.نعم
Dialogue: 0,0:04:03.01,0:04:05.85,DCMain,CONAN,0,0,0,,ألم تُقتل هنا؟
Dialogue: 0,0:04:05.85,0:04:06.79,DCMain,TAKAGI,0,0,0,,.لا
Dialogue: 0,0:04:06.79,0:04:11.77,DCMain,TAKAGI,0,0,0,,.نُقلت إلى هنا بعدما قُتلت في مكان آخر
Dialogue: 0,0:04:12.00,0:04:16.02,DCMain,CONAN,0,0,0,,لمَ تكبّد الجاني عناء نقل الجثة؟
Dialogue: 0,0:04:16.26,0:04:19.38,DCMain,KOGORO,0,0,0,,من أجل أن يؤخر اكتشافها بالطبع
Dialogue: 0,0:04:19.38,0:04:21.95,DCMain,CONAN,0,0,0,,ولمَ لمْ يأخذها إلى الجبال؟
Dialogue: 0,0:04:21.95,0:04:25.28,DCMain,CONAN,0,0,0,,ولمَ استخدم اسمك؟
Dialogue: 0,0:04:25.59,0:04:28.41,DCMain,TAKAGI,0,0,0,,ربما لأنه مشهور
Dialogue: 0,0:04:28.59,0:04:33.41,DCMain,CONAN,0,0,0,,لكن إن استخدم أحدهم اسمك، أفلا يعني هذا أنك مقصود لتكتشف المجرم؟
Dialogue: 0,0:04:33.41,0:04:34.70,DCMain,KOGORO,0,0,0,,!بلى
Dialogue: 0,0:04:34.70,0:04:38.42,DCMain,CONAN,0,0,0,,إذًا لماذا أراد المجرم استدارج محققًا في هذا؟
Dialogue: 0,0:04:39.13,0:04:42.39,DCItalic,CONAN,0,0,0,,.لا أفهم ما يفعله هذا المجرم
Dialogue: 0,0:04:46.12,0:04:47.73,DCMain,KOGORO,0,0,0,,...بشأن الملف الجنائي
Dialogue: 0,0:04:47.73,0:04:48.97,DCMain,CONAN,0,0,0,,
Dialogue: 0,0:04:49.55,0:04:50.98,DCMain,CONAN,0,0,0,,ما هذه؟
Dialogue: 0,0:04:51.76,0:04:53.46,DCMain,KOGORO,0,0,0,,"،كِدتُ أُقتل"
Dialogue: 0,0:04:53.46,0:04:56.23,DCMain,KOGORO,0,0,0,,"مَن مِن هؤلاء الثلاثة فعلها؟"
Dialogue: 0,0:04:56.23,0:04:59.23,Satoshi,SIGN,0,0,0,,{\p1\bord0\c&HFFFFFF&\clip(198,176,1062,440)\pos(590,426)\fscx5974\fscy2596}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
