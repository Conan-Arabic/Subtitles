Dialogue: 0,0:05:29.26,0:05:33.14,Ryoichi,SIGN,0,0,0,,{\fad(250,250)\pos(500,674.667)\blur0.5}زبون باربارا ساداكو
Dialogue: 0,0:05:31.83,0:05:33.14,DCTop,SAZANAMI,0,0,0,,تحملي المسؤولية
Dialogue: 0,0:05:33.71,0:05:35.55,DCTop,OGU,0,0,0,,.اهدأوا من فضلكم
Dialogue: 0,0:05:35.55,0:05:36.77,DCTop,GUARD,0,0,0,,ما الأمر؟
Dialogue: 0,0:05:38.06,0:05:39.89,DCTop,SAZANAMI,0,0,0,,هذا المكان مزدحم جدًا
Dialogue: 0,0:05:39.89,0:05:43.03,DCTop,SAZANAMI,0,0,0,,علينا المغادرة الآن ونأتي بخطة أخرى لاحقًا
Dialogue: 0,0:05:43.39,0:05:45.85,DCTop,SAZANAMI,0,0,0,,!ستدفعين ثمن هذا يا باربارا ساداكو
Dialogue: 0,0:05:47.18,0:05:50.03,DCMain,OGU,0,0,0,,لا أعلم ماذا أخبرتهم
Dialogue: 0,0:05:50.03,0:05:52.38,DCMain,OGU,0,0,0,,..لكن إن كرهها أي شخص
Dialogue: 0,0:05:52.38,0:05:56.79,DCMain,OGU,0,0,0,,فلابد أن يكون كاناوا شينسوكي أو إندو فوكامي أو سازانامي ريويتشي
Dialogue: 0,0:05:57.13,0:06:00.42,DCMain,CONAN,0,0,0,,كاناوا، إندو، سازانامي
Dialogue: 0,0:06:00.85,0:06:03.34,DCMain,KOGORO,0,0,0,,لابد أن يكون أحدهم المجرم
Dialogue: 0,0:06:03.34,0:06:08.21,DCMain,MEGURE,0,0,0,,.ولكن عليكم أن تبحثوا عما إذا كان يوجد من يكره الضحية حتى نتأكد
Dialogue: 0,0:06:08.21,0:06:08.95,DCMain,CHIBA,0,0,0,,!حاضر
Dialogue: 0,0:06:09.83,0:06:12.81,DCMain,TAKAGI,0,0,0,,ثلاثة أشخاص مشبوهين
Dialogue: 0,0:06:12.81,0:06:15.36,DCMain,TAKAGI,0,0,0,,واحدة منهم امرأة
Dialogue: 0,0:06:15.36,0:06:17.90,DCMain,TAKAGI,0,0,0,,وجدنا هذا بجانب الجثة
Dialogue: 0,0:06:23.21,0:06:24.78,DCMain,OGU,0,0,0,,ذاك الدبوس
Dialogue: 0,0:06:25.25,0:06:26.65,DCMain,OGU,0,0,0,,إنه لإندو-سان
Dialogue: 0,0:06:26.95,0:06:30.78,DCMain,MEGURE,0,0,0,,يبدو بأنها قد أوقعته دون قصد عندما نقلت الجثة إلى هنا
Dialogue: 0,0:06:31.58,0:06:34.60,DCItalic,CONAN,0,0,0,,إن كان هذا صحيحًا فهذا يعني أنها لا تبالي إطلاقًا
Dialogue: 0,0:06:35.70,0:06:36.81,DCMain,MEGURE,0,0,0,,اعذروني
Dialogue: 0,0:06:38.31,0:06:40.75,DCMain,MEGURE,0,0,0,,نعم؟ ماذا قلت؟
Dialogue: 0,0:06:41.27,0:06:45.50,DCMain,MEGURE,0,0,0,,لقد اكتشفوا شيئًا مشبوهًا في حديقة شيباهاما
Dialogue: 0,0:06:45.51,0:06:47.51,DCNote,SIGN,0,0,0,,{\fnالمحارب2 مطور\fs40\bord0\c&HA2A4A9&\blur0.5\pos(957.334,549.333)}حديقة شيباهاما
Dialogue: 0,0:06:48.02,0:06:49.82,DCMain,OGU,0,0,0,,هذه محفظة البطاقات لساداكو-سينسي
Dialogue: 0,0:06:49.82,0:06:53.30,DCMain,TAKAGI,0,0,0,,أيمكن أن يكون هذا الحبل سلاح الجريمة؟
Dialogue: 0,0:06:53.30,0:06:56.89,DCMain,MEGURE,0,0,0,,لابد أن هذا مكان مقتلها
Dialogue: 0,0:06:56.89,0:06:58.89,DCMain,MEGURE,0,0,0,,.أنا متفاجئ من أنكم وجدتموه
Dialogue: 0,0:06:59.30,0:07:02.56,DCMain,POLICE,0,0,0,,استلمنا بلاغًا من مجهول هذا الصباح
Dialogue: 0,0:07:02.56,0:07:06.84,DCMain,POLICE,0,0,0,,..يقول فيه أنه رأى شخصًا مشبوهًا يحمل شيئًا كبيرًا
Dialogue: 0,0:07:06.84,0:07:08.88,DCMain,POLICE,0,0,0,,.إلى داخل السيارة في الحديقة الليلة الماضية
Dialogue: 0,0:07:08.88,0:07:10.69,DCMain,POLICE,0,0,0,,..وعندما أتيت لأحقق
Dialogue: 0,0:07:10.69,0:07:14.19,DCMain,POLICE,0,0,0,,.وجدت علامات تدل على مقاومة الضحية وهذه الأشياء
Dialogue: 0,0:07:14.19,0:07:17.60,DCMain,KOGORO,0,0,0,,..إذًا فقد خنقت إندو فوكامي ساداكو-سان هنا
Dialogue: 0,0:07:17.60,0:07:21.17,DCMain,KOGORO,0,0,0,,.ثم نقلتها إلى ذلك المنزل وتركتها هناك
Dialogue: 0,0:07:21.46,0:07:24.92,DCMain,POLICE,0,0,0,,.وجدتُ هذه هنا أيضًا
Dialogue: 0,0:07:25.52,0:07:27.17,DCMain,CONAN,0,0,0,,ش.كاناوا؟
Dialogue: 0,0:07:27.48,0:07:30.02,DCMain,OGU,0,0,0,,أيمكن أن تكون لكاناوا شينسوكي
Dialogue: 0,0:07:33.78,0:07:34.58,DCMain,MEGURE,0,0,0,,نعم؟
Dialogue: 0,0:07:35.88,0:07:39.68,DCMain,MEGURE,0,0,0,,سيارة متروكة قرب المنزل؟
Dialogue: 0,0:07:40.12,0:07:40.81,DCMain,MEGURE,0,0,0,,ماذا؟
Dialogue: 0,0:07:41.24,0:07:43.81,DCMain,MEGURE,0,0,0,,إنها ملك لسازانامي ريويتشي؟
Dialogue: 0,0:07:44.46,0:07:46.57,DCMain,POLICE,0,0,0,,كان وضع السيارة غريبًا لهذا تفقدت رقم اللوحة
Dialogue: 0,0:07:47.20,0:07:50.57,DCMain,POLICE,0,0,0,,.وعلمتُ أنه إبلاغٌ بالسرقة ورد عليها
Dialogue: 0,0:07:50.84,0:07:53.10,DCMain,SAZANAMI,0,0,0,,لقد سرقت قبل يومين
Dialogue: 0,0:07:53.10,0:07:56.20,DCMain,SAZANAMI,0,0,0,,لكن لماذا تركن سيارتي هنا؟
Dialogue: 0,0:07:57.64,0:08:01.46,DCMain,MEGURE,0,0,0,,قارن هذا الشعر بشعر الضحية
Dialogue: 0,0:08:01.78,0:08:03.59,DCMain,KANAWA,0,0,0,,هذه قداحتي
Dialogue: 0,0:08:03.59,0:08:06.05,DCMain,KANAWA,0,0,0,,.أضعتها قبل أيام
Dialogue: 0,0:08:06.05,0:08:09.21,DCMain,FUKAMI,0,0,0,,.وأنا أيضًا أضعت هذا الدبوس
Dialogue: 0,0:08:09.54,0:08:11.72,DCMain,KOGORO,0,0,0,,لقد اكتشفت هوية القاتل
Dialogue: 0,0:08:12.10,0:08:17.72,DCMain,KOGORO,0,0,0,,..فيما هؤلاء الثلاثة مشبوهين فإن الجاني ليس واحدًا منهم
Dialogue: 0,0:08:18.42,0:08:21.32,DCMain,KOGORO,0,0,0,,بل ثلاثتهم هاجموا الضحية
Dialogue: 0,0:08:21.32,0:08:24.48,DCMain,KOGORO,0,0,0,,هذا عندما أوقع كاناوا-سان قداحته
Dialogue: 0,0:08:24.71,0:08:27.48,DCMain,KOGORO,0,0,0,,ثم وضعوا الجثة داخل السيارة
Dialogue: 0,0:08:27.84,0:08:30.73,DCMain,KOGORO,0,0,0,,بعدها نقلوها إلى مكتب ساداكو-سان في منزلها
Dialogue: 0,0:08:31.14,0:08:36.02,DCMain,KOGORO,0,0,0,,وذلك عندما أسقطت فوكامي-سان دبوسها وغادرت دون ملاحظة ذلك
Dialogue: 0,0:08:36.93,0:08:39.54,DCMain,KOGORO,0,0,0,,.جميعهم متورطون في هذا
Dialogue: 0,0:08:39.54,0:08:40.99,DCMain,ALL,0,0,0,,
Dialogue: 0,0:08:41.30,0:08:44.69,DCMain,MEGURE,0,0,0,,.هذا يفسر وجود ممتلكاتهم
Dialogue: 0,0:08:44.69,0:08:45.50,DCMain,TAKAGI,0,0,0,,نعم
Dialogue: 0,0:08:45.94,0:08:47.17,DCMain,CONAN,0,0,0,,...لكن
Dialogue: 0,0:08:47.17,0:08:51.45,DCMain,CHIBA,0,0,0,,.أيها المفتش، هؤلاء الثلاثة الوحيدون الذين يكرهون الضحية
Dialogue: 0,0:08:51.45,0:08:53.16,DCMain,KANAWA,0,0,0,,!انتظر، لم نفعل هذا
Dialogue: 0,0:08:53.16,0:08:54.27,DCMain,FUKAMI,0,0,0,,!صحيح
Dialogue: 0,0:08:54.27,0:08:54.76,DCMain,SAZANAMI,0,0,0,,!نعم
Dialogue: 0,0:09:00.24,0:09:02.52,DCMain,MEGURE,0,0,0,,يعود الشعر الموجود في السيارة إلى الضحية
Dialogue: 0,0:09:02.95,0:09:07.45,DCMain,MEGURE,0,0,0,,سازانامي-سان، استخدمت سيارتك لنقل الجثة
Dialogue: 0,0:09:07.45,0:09:09.15,DCMain,SAZANAMI,0,0,0,,!مستحيل
Dialogue: 0,0:09:09.54,0:09:12.31,DCMain,OGU,0,0,0,,.وجميعهم يكرهون ساداكو-سينسي
Dialogue: 0,0:09:12.31,0:09:13.64,DCMain,KANAWA,0,0,0,,.بالطبع
Dialogue: 0,0:09:13.64,0:09:17.66,DCMain,KANAWA,0,0,0,,كنت أفكر في شراء منزل، لذا طلبت منها أن تخبرني عن أفضل اتجاه لي
Dialogue: 0,0:09:18.55,0:09:23.16,DCMain,SADAKO,0,0,0,,.أفضل اتجاه لك الشمال الشرقي
Dialogue: 0,0:09:23.47,0:09:26.08,DCMain,KANAWA,0,0,0,,..في اللحظة التي وثقت بها واشتريت المنزل
Dialogue: 0,0:09:26.08,0:09:30.69,DCMain,KANAWA,0,0,0,,.أُغلقت شركة البناء التي أعمل فيها وتركتني زوجتي
Dialogue: 0,0:09:30.69,0:09:33.80,DCMain,FUKAMI,0,0,0,,وأنا طلبت منها إخباري عن مستقبلي العاطفي
Dialogue: 0,0:09:34.85,0:09:39.57,DCMain,SADAKO,0,0,0,,.سيكون حُبّ حياتك الرجل الذي يقف أمام عينيكِ
Dialogue: 0,0:09:40.13,0:09:43.06,DCMain,FUKAMI,0,0,0,,لكنه خدعني بعدما وثقت به وتزوجته
Dialogue: 0,0:09:43.31,0:09:45.60,DCMain,SAZANAMI,0,0,0,,.لدي مشروع أود أن أبدؤه
Dialogue: 0,0:09:45.60,0:09:48.56,DCMain,SAZANAMI,0,0,0,,لذا طلبت منها أن تخبرني متى علي أن أبدأ
Dialogue: 0,0:09:49.32,0:09:52.36,DCMain,SADAKO,0,0,0,,.بلغ حظك الآن ذروته
Dialogue: 0,0:09:53.23,0:09:57.61,DCMain,SAZANAMI,0,0,0,,لكن عندما استعجلت واستقلت من عملي وفتحت متجرًا، فشلت والآن أنا غارق في الديون
Dialogue: 0,0:09:57.61,0:10:00.53,DCMain,KOGORO,0,0,0,,.تضرّر ثلاثتهم بشدّة
Dialogue: 0,0:10:00.53,0:10:03.95,DCMain,MEGURE,0,0,0,,.وهذا دافعٌ لهم بالتأكيد
Dialogue: 0,0:10:04.13,0:10:07.93,DCMain,TAKAGI,0,0,0,,ولا يملك أيحدكم حُجّةً لليلة الماضية، صحيح؟
Dialogue: 0,0:10:07.93,0:10:09.71,DCMain,FUKAMI,0,0,0,,أخبرتك أن شخصًا ما اتصل بي
Dialogue: 0,0:10:10.60,0:10:12.21,DCMain,FUKAMI,0,0,0,,!كان رجلًا
Dialogue: 0,0:10:13.17,0:10:15.31,DCMain,SAZANAMI,0,0,0,,.واستقبلنا المكالمة نفسها أيضًا
Dialogue: 0,0:10:15.31,0:10:17.53,DCMain,KANAWA,0,0,0,,.كان يتأكد من أننا لا نملك حُججًا
Dialogue: 0,0:10:17.53,0:10:20.26,DCMain,SAZANAMI,0,0,0,,.لقد أوقع بنا المجرم
Dialogue: 0,0:10:20.64,0:10:24.18,DCMain,KOGORO,0,0,0,,أتتوقعون منا تصديق قصصكم؟
Dialogue: 0,0:10:26.28,0:10:27.10,DCMain,MEGURE,0,0,0,,نعم؟
Dialogue: 0,0:10:28.76,0:10:29.52,DCMain,MEGURE,0,0,0,,ماذا؟
Dialogue: 0,0:10:29.87,0:10:31.40,DCMain,MEGURE,0,0,0,,!ظهرت نتائج التشريح
Dialogue: 0,0:10:31.40,0:10:36.03,DCMain,MEGURE,0,0,0,,.وتُظهر أن الضحية ماتت ما بين الساعة الثامنة والتاسعة مساءً
Dialogue: 0,0:10:36.53,0:10:39.03,DCItalic,CONAN,0,0,0,,قُتلت في حوالي الساعة التاسعة على الأقل؟
Dialogue: 0,0:10:39.03,0:10:39.98,DCItalic,CONAN,0,0,0,,...إذًا
Dialogue: 0,0:10:40.52,0:10:42.28,DCMain,KOGORO,0,0,0,,أيها الفتى، إلى أين تذهب؟
Dialogue: 0,0:10:43.68,0:10:44.53,DCMain,CONAN,0,0,0,,!عرفت هذا
Dialogue: 0,0:10:45.04,0:10:48.41,DCMain,CONAN,0,0,0,,كُتبت هذه الرسالة بعد الساعة العاشرة مساءً
Dialogue: 0,0:10:48.65,0:10:50.43,DCMain,KOGORO,0,0,0,,...مما يعني
Dialogue: 0,0:10:50.43,0:10:52.54,DCMain,CONAN,0,0,0,,..أن الضحية لم تكتبها
Dialogue: 0,0:10:53.30,0:10:56.49,DCMain,CONAN,0,0,0,,بل كتبها الجاني بعدما نقل الجثة إلى هنا
Dialogue: 0,0:10:57.36,0:11:00.31,DCMain,CONAN,0,0,0,,.حتى يثير الشكوك حول هؤلاء الثلاثة
Dialogue: 0,0:11:00.31,0:11:03.50,DCMain,KOGORO,0,0,0,,.باختصار، لقد أوقِعَ بهم
Dialogue: 0,0:11:03.50,0:11:04.18,DCMain,KANAWA,0,0,0,,أترون؟
Dialogue: 0,0:11:04.58,0:11:09.23,DCMain,TAKAGI,0,0,0,,إن قتلها واحد منهم فلا يمكن أن يكتب ذلك
Dialogue: 0,0:11:09.79,0:11:11.46,DCMain,KOGORO,0,0,0,,..إن حاول الجاني أن يورطهم
Dialogue: 0,0:11:11.46,0:11:16.73,DCMain,KOGORO,0,0,0,,فلابد أنه كان يعرف أنهم يكرهون المجني عليها
Dialogue: 0,0:11:17.38,0:11:18.99,DCMain,KOGORO,0,0,0,,أأخبرت شخصًا آخر؟
Dialogue: 0,0:11:19.23,0:11:21.67,DCMain,OGU,0,0,0,,.لم أخبر أحدًا
Dialogue: 0,0:11:21.67,0:11:22.84,DCMain,KANAWA,0,0,0,,ولا أنا
Dialogue: 0,0:11:22.84,0:11:26.19,DCMain,FUKAMI,0,0,0,,لم أكن لأحرج نفسي بهذا
Dialogue: 0,0:11:26.19,0:11:27.37,DCMain,SAZANAMI,0,0,0,,.صحيح
Dialogue: 0,0:11:27.72,0:11:29.87,DCMain,TAKAGI,0,0,0,,لكن لابد أن شخصًا ما قد أخبرهم
Dialogue: 0,0:11:30.08,0:11:35.13,DCItalic,CONAN,0,0,0,,...من الصعب تخيلهم وهم يخبرون شخصًا ما عن غرضهم، مما يعني
Dialogue: 0,0:11:35.35,0:11:38.56,DCMain,SAZANAMI,0,0,0,,.أرجوكم اقبضوا على الشخص الذي أوقع بنا
Dialogue: 0,0:11:38.56,0:11:40.19,DCMain,KANAWA,0,0,0,,ألست المحقق العظيم؟
Dialogue: 0,0:11:40.19,0:11:42.83,DCMain,FUKAMI,0,0,0,,سيبطل هذا اتهامنا
Dialogue: 0,0:11:42.83,0:11:47.14,DCMain,KOGORO,0,0,0,,إن فحصنا موقع الجريمة فأنا متأكد من أننا سنجد دليلًا عن هوية المجرم
Dialogue: 0,0:11:47.46,0:11:49.90,DCMain,MEGURE,0,0,0,,..من أجل إيجاد المجرم
Dialogue: 0,0:11:49.90,0:11:52.55,DCMain,MEGURE,0,0,0,,لنأخذ استراحة قبل أن نناقش القضية أكثر
Dialogue: 0,0:11:55.23,0:11:56.15,DCMain,CONAN,0,0,0,,أيمكن أن يكون...؟
Dialogue: 0,0:11:56.63,0:12:00.68,DCMain,CONAN,0,0,0,,لا أحد آخر يكره الضحية غير هؤلاء الثلاثة صحيح؟
Dialogue: 0,0:12:00.68,0:12:03.20,DCMain,CHIBA,0,0,0,,.نعم، بحثت ولم أجد شخصًا آخر
Dialogue: 0,0:12:03.90,0:12:07.39,DCItalic,CONAN,0,0,0,,إذًا من المحتمل أنهم لم يتورطوا في هذا
Dialogue: 0,0:12:07.39,0:12:10.08,DCItalic,CONAN,0,0,0,,بل أراد المجرم أن نظنّ ذلك
Dialogue: 0,0:12:10.08,0:12:12.96,DCItalic,CONAN,0,0,0,,بعبارة أخرى، المجرم واحدٌ منهم
Dialogue: 0,0:12:14.10,0:12:18.92,DCItalic,CONAN,0,0,0,,فعل ذلك لوحده لأنه لم يحتج للعمل الجماعي
Dialogue: 0,0:12:19.98,0:12:22.88,DCItalic,CONAN,0,0,0,,لماذا جعلنا المجرم نشتبه بثلاثتهم؟
Dialogue: 0,0:12:23.68,0:12:28.58,DCItalic,CONAN,0,0,0,,ولمَ أقحم العم في هذا؟
Dialogue: 0,0:12:29.54,0:12:34.19,DCItalic,CONAN,0,0,0,,.لابد أنه يوجد سببًا ما وراء فعله لذلك
Dialogue: 0,0:12:35.38,0:12:36.69,DCItalic,CONAN,0,0,0,,..وإن اكتشفت ذلك
Dialogue: 0,0:12:37.77,0:12:39.77,DCItalic,CONAN,0,0,0,,فسأكتشف الفاعل..
Dialogue: 0,0:12:45.37,0:12:47.20,DCMain,KOGORO,0,0,0,,لم يكتشفوا شيئًا؟
Dialogue: 0,0:12:47.58,0:12:49.43,DCMain,KOGORO,0,0,0,,هذا غريب
Dialogue: 0,0:12:49.43,0:12:54.73,DCMain,KOGORO,0,0,0,,لم يكن للسكرتير أن يخبر أحدًا بشأن كره الضحية
Dialogue: 0,0:12:54.73,0:12:56.88,DCMain,KOGORO,0,0,0,,.لأنه سيضر بالعمل
Dialogue: 0,0:12:56.88,0:13:00.20,DCMain,KOGORO,0,0,0,,..وأيضًا أولئك الثلاثة
Dialogue: 0,0:13:00.20,0:13:01.84,DCMain,KOGORO,0,0,0,,.لأن الأمر سيحرجهم..
Dialogue: 0,0:13:02.08,0:13:06.72,DCMain,KOGORO,0,0,0,,ألا يعني هذا أن لا أحد آخر يعلم؟
Dialogue: 0,0:13:06.98,0:13:09.97,DCMain,KANAWA,0,0,0,,أين ومتى أضعت قداحتي؟
Dialogue: 0,0:13:09.97,0:13:14.35,DCMain,CONAN,0,0,0,,.طلب مني العمّ كوغور سؤالك
Dialogue: 0,0:13:14.35,0:13:17.66,DCMain,FUKAMI,0,0,0,,..لو كان يعلم لذهب لأخذها
Dialogue: 0,0:13:17.66,0:13:19.84,DCMain,FUKAMI,0,0,0,,أليس هو المحقّق العظيم؟
Dialogue: 0,0:13:21.30,0:13:25.85,DCMain,SAZANAMI,0,0,0,,إن لم يستطيعوا إيجاد المجرم الحقيقي فماذا سيحدث للقضية؟
Dialogue: 0,0:13:25.85,0:13:28.49,DCMain,KANAWA,0,0,0,,.ربما لن يحلّوها
Dialogue: 0,0:13:28.77,0:13:29.99,DCMain,CONAN,0,0,0,,
Dialogue: 0,0:13:30.26,0:13:33.60,DCMain,KANAWA,0,0,0,,استحقت تلك العرّافة الكاذبة ما حصل لها
Dialogue: 0,0:13:33.60,0:13:36.89,DCMain,KANAWA,0,0,0,,.طلبت منها أن تخبرني لأني لم أستطع اتخاذ القرار بنفسي
Dialogue: 0,0:13:36.89,0:13:38.67,DCMain,FUKAMI,0,0,0,,.وأنا مثلك
Dialogue: 0,0:13:38.67,0:13:40.65,DCMain,FUKAMI,0,0,0,,.في الحقيقة أنا ضعيفة
Dialogue: 0,0:13:40.65,0:13:42.34,DCMain,SAZANAMI,0,0,0,,.وأنا أيضًا
Dialogue: 0,0:13:42.34,0:13:44.51,DCMain,SAZANAMI,0,0,0,,.لهذا اعتمدت على العِرافة
Dialogue: 0,0:13:45.09,0:13:46.47,DCItalic,CONAN,0,0,0,,.فهمت
Dialogue: 0,0:13:46.47,0:13:50.51,DCItalic,CONAN,0,0,0,,!إن فكرت بها بتلك الطريقة فهذا سيشرح لماذا تورط الثلاثة
Dialogue: 0,0:13:50.77,0:13:54.64,DCMain,KANAWA,0,0,0,,لم تكن الشركة التي أعمل بها تبلي بلاءً حسنًا حتى قبل أن أشتري المنزل
Dialogue: 0,0:13:54.64,0:13:58.14,DCMain,KANAWA,0,0,0,,.وكانت علاقتي بزوجتي سيئة لبعض الوقت
Dialogue: 0,0:13:58.14,0:14:02.69,DCMain,FUKAMI,0,0,0,,..وأنا كذبت بشأن الرجل الذي كنت أواعده
Dialogue: 0,0:14:02.69,0:14:05.14,DCMain,FUKAMI,0,0,0,,.لذا من الواضح أن إمكانياتها غير واضحة..
Dialogue: 0,0:14:05.91,0:14:08.07,DCMain,CONAN,0,0,0,,.إذًا لم تكن تستحق كرهكم لها
Dialogue: 0,0:14:08.07,0:14:09.72,DCMain,FUKAMI,0,0,0,,.أعرف هذا
Dialogue: 0,0:14:09.72,0:14:11.46,DCMain,SAZANAMI,0,0,0,,لكن موقفي مختلف
Dialogue: 0,0:14:12.09,0:14:14.37,DCMain,SAZANAMI,0,0,0,,..لو أنها لم تخبرني أن أبدأ بسرعة
Dialogue: 0,0:14:14.73,0:14:17.62,DCMain,SAZANAMI,0,0,0,,.لنجح الرامن الفضائي..
Dialogue: 0,0:14:17.88,0:14:19.62,DCMain,CONAN,0,0,0,,الرامن الفضائي؟
Dialogue: 0,0:14:20.08,0:14:22.25,DCMain,SAZANAMI,0,0,0,,إنه المطعم الذي بدأت فيه بعدما استقلت من عملي
Dialogue: 0,0:14:22.92,0:14:26.26,DCMain,SAZANAMI,0,0,0,,يحمل النُدل الرامن للزبائن مرتديين ملابسًا فضائية
Dialogue: 0,0:14:26.72,0:14:31.15,DCMain,SAZANAMI,0,0,0,,"ويرمون قطع لحم على شكل نجم ويصرخون "شهاب
Dialogue: 0,0:14:32.29,0:14:37.08,DCMain,SAZANAMI,0,0,0,,كان المشروع سينجح نجاحًا باهرًا لو افتتحته في الوقت المناسب
Dialogue: 0,0:14:37.50,0:14:38.38,DCMain,SAZANAMI,0,0,0,,صحيح؟
Dialogue: 0,0:14:39.56,0:14:41.94,DCItalic,CONAN,0,0,0,,لمَ هو واثق هكذا؟
Dialogue: 0,0:14:42.35,0:14:43.54,DCMain,SAZANAMI,0,0,0,,صحيح؟
Dialogue: 0,0:14:43.54,0:14:45.59,DCMain,CONAN,0,0,0,,لا تسألني
Dialogue: 0,0:14:46.06,0:14:47.61,DCMain,CONAN,0,0,0,,أريد الذهاب إلى دورة المياه
Dialogue: 0,0:14:49.22,0:14:50.17,DCMain,CONAN,0,0,0,,
Dialogue: 0,0:14:50.87,0:14:52.48,DCMain,CONAN,0,0,0,,هكذا الأمر إذًا
Dialogue: 0,0:14:52.48,0:14:56.20,DCItalic,CONAN,0,0,0,,إن فكرت بها بتلك الطريقة فسأعرف لماذا وُرط العم في هذا
Dialogue: 0,0:14:56.89,0:14:58.71,DCItalic,CONAN,0,0,0,,.ولكن ما من دليلٍ كافٍ
Dialogue: 0,0:14:59.27,0:15:00.71,DCItalic,CONAN,0,0,0,,...في هذه الحالة
Dialogue: 0,0:15:01.12,0:15:04.59,DCMain,KOGORO,0,0,0,,.أنا المحقق موري كوغورو وأنا مساعد في التحقيق
Dialogue: 0,0:15:05.03,0:15:07.71,DCMain,KOGORO,0,0,0,,أودّ التبليغ عن شيء
Dialogue: 0,0:15:14.05,0:15:15.22,DCMain,KOGORO,0,0,0,,!عرفت
Dialogue: 0,0:15:15.58,0:15:19.78,DCMain,KOGORO,0,0,0,,نعم، أيمكنك مقارنتها بالبيانات التي أرسلتها لك؟
Dialogue: 0,0:15:20.24,0:15:21.36,DCMain,KOGORO,0,0,0,,.شكرًا لك
Dialogue: 0,0:15:22.71,0:15:28.15,DCMain,MEGURE,0,0,0,,.اتصل موري-كن قائلًا أنه اكتشف المجرم
Dialogue: 0,0:15:28.34,0:15:29.00,DCMain,CONAN,0,0,0,,
Dialogue: 0,0:15:29.90,0:15:33.91,DCNote,SIGN,0,0,0,,{\fnالمحارب2 مطور\fs50\bord0\fax-0.3\frx0\fry342\c&HA2A4A9&\pos(911.999,478.666)\frz16.81\blur0.5}حديقة شيباهاما
Dialogue: 0,0:15:30.80,0:15:33.91,DCMain,KOGORO,0,0,0,,كاناوا-سان، إندو-سان، سازانامي-سان
Dialogue: 0,0:15:34.20,0:15:36.94,DCMain,KOGORO,0,0,0,,لم تكونوا متورطين بسبب المجرم
Dialogue: 0,0:15:36.94,0:15:39.31,DCMain,KOGORO,0,0,0,,أردتم منا أن نعتقد ذلك
Dialogue: 0,0:15:39.92,0:15:41.32,DCMain,ALL,0,0,0,,
Dialogue: 0,0:15:41.32,0:15:43.42,DCMain,MEGURE,0,0,0,,ما الذي تقصده يا موري-كن؟
Dialogue: 0,0:15:43.81,0:15:47.47,DCMain,KOGORO,0,0,0,,بالتظاهر أنهم متورطون بسبب المجرم
Dialogue: 0,0:15:47.47,0:15:51.63,DCMain,KOGORO,0,0,0,,..وبعد قتلهم للضحية
Dialogue: 0,0:15:51.63,0:15:54.68,DCMain,KOGORO,0,0,0,,.حاولوا تجنب أن يكونوا مشبوهين
Dialogue: 0,0:15:54.98,0:16:00.07,DCMain,MEGURE,0,0,0,,.بعبارة أخرى، ما من مجرم ورطهم في هذا
Dialogue: 0,0:16:00.07,0:16:02.76,DCMain,KOGORO,0,0,0,,نعم، لقد كنت محقًا من البداية
Dialogue: 0,0:16:02.76,0:16:05.56,DCMain,KOGORO,0,0,0,,.ثلاثتهم شركاء في الجريمة
Dialogue: 0,0:16:05.72,0:16:06.85,DCMain,ALL,0,0,0,,
Dialogue: 0,0:16:06.85,0:16:09.32,DCMain,TAKAGI,0,0,0,,هذا معقول
Dialogue: 0,0:16:09.32,0:16:12.57,DCMain,CHIBA,0,0,0,,لأنهم الوحيدون الذين يكرهون الضحية
Dialogue: 0,0:16:12.83,0:16:16.52,DCMain,MEGURE,0,0,0,,يبدو أننا سنستجوبكم مرة أخرى
Dialogue: 0,0:16:16.52,0:16:18.45,DCMain,MEGURE,0,0,0,,.خذوهم إلى المركز
Dialogue: 0,0:16:18.61,0:16:19.52,DCMain,BOTH,0,0,0,,!حاضر
Dialogue: 0,0:16:19.52,0:16:20.97,DCMain,KANAWA,0,0,0,,!انتظروا لحظة
Dialogue: 0,0:16:20.97,0:16:22.49,DCMain,FUKAMI,0,0,0,,!لم أفعلها
Dialogue: 0,0:16:22.49,0:16:24.72,DCMain,SAZANAMI,0,0,0,,!ابحثوا عن المجرم الحقيقي
Dialogue: 0,0:16:24.72,0:16:29.14,DCMain,KOGORO,0,0,0,,هذا يعني أن القضية أغلقت
Dialogue: 0,0:16:29.90,0:16:31.42,DCMain,KOGORO,0,0,0,,!انتظروا يا جماعة
Dialogue: 0,0:16:32.04,0:16:35.86,DCMain,KOGORO,0,0,0,,كونكم شركاء واحد من عدة احتمالات
Dialogue: 0,0:16:35.86,0:16:38.18,DCMain,KOGORO,0,0,0,,.لدينا طريقة أخرى لتفسير الوضع
Dialogue: 0,0:16:38.51,0:16:40.06,DCMain,MEGURE,0,0,0,,تفسير آخر؟
Dialogue: 0,0:16:40.06,0:16:44.81,DCMain,KOGORO,0,0,0,,يكمن حل هذه القضية في شخصية المجرم
Dialogue: 0,0:16:45.11,0:16:46.62,DCMain,TAKAGI,0,0,0,,شخصية؟
Dialogue: 0,0:16:46.62,0:16:48.44,DCMain,CHIBA,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:16:48.84,0:16:51.64,DCMain,KOGORO,0,0,0,,..نقل الجاني الجثّة
Dialogue: 0,0:16:51.64,0:16:55.20,DCMain,KOGORO,0,0,0,,.على الرغم من أن هذا لن يفيده بشيء..
Dialogue: 0,0:16:55.59,0:17:00.87,DCMain,KOGORO,0,0,0,,ثم ترك أشياء شخصية عن قصد في موقع الجريمة وعند مكان الجثة
Dialogue: 0,0:17:01.22,0:17:06.11,DCMain,KOGORO,0,0,0,,لأنه احتاج إلى سيارة سازانامي-سان لينقل الجثة
Dialogue: 0,0:17:06.93,0:17:11.98,DCMain,KOGORO,0,0,0,,هذا بجانب الرسالة التي تركها حول المشبوهين
Dialogue: 0,0:17:12.79,0:17:16.31,DCMain,MEGURE,0,0,0,,ليجعلهم متورطين في القضية
Dialogue: 0,0:17:16.31,0:17:21.79,DCMain,KOGORO,0,0,0,,نعم بالتأكيد، لكن الفعل نتاج شخصية المجرم
Dialogue: 0,0:17:21.79,0:17:22.64,DCMain,MEGURE,0,0,0,,
Dialogue: 0,0:17:23.07,0:17:27.26,DCMain,KOGORO,0,0,0,,إن نظرت في دوافعهم فسترى أنهم سيقعون تحت الشبهة في النهاية
Dialogue: 0,0:17:27.26,0:17:31.76,DCMain,KOGORO,0,0,0,,..عوضًا عن الخوف من أن تصل الشرطة إلى أبوابهم
Dialogue: 0,0:17:31.76,0:17:35.53,DCMain,KOGORO,0,0,0,,ظنوا أنه من الأفضل أن يكشفوا أنفسهم حالًا..
Dialogue: 0,0:17:35.53,0:17:38.00,DCMain,MEGURE,0,0,0,,أي منطق غبي هذا؟
Dialogue: 0,0:17:38.00,0:17:41.29,DCMain,KOGORO,0,0,0,,إنهم ليسوا أغبياء بل ضعفاء
Dialogue: 0,0:17:41.29,0:17:45.06,DCMain,KOGORO,0,0,0,,.ضعفاء لدرجة أنهم يعتمدون على العِرافة في تحديد قرارات مصيرية
Dialogue: 0,0:17:46.37,0:17:48.67,DCMain,OGU,0,0,0,,.إذًا هم مرتكبو الجريمة
Dialogue: 0,0:17:49.41,0:17:53.16,DCMain,KOGORO,0,0,0,,ولأن المجرم ضعيف جدًا، أحس بأنه ليس من السهل فعل ذلك لوحده
Dialogue: 0,0:17:53.64,0:17:57.61,DCMain,KOGORO,0,0,0,,وأراد الآخرين الذين في مثل موقفه أن يكونوا معه
Dialogue: 0,0:17:57.61,0:18:03.42,DCMain,KOGORO,0,0,0,,.الدافع نفسه ولا أعذار وأشياء شخصية متروكة في موقع الجريمة
Dialogue: 0,0:18:03.42,0:18:05.56,DCMain,MEGURE,0,0,0,,من المجرم؟
Dialogue: 0,0:18:05.99,0:18:09.51,DCMain,KOGORO,0,0,0,,واستخدم اسمي أيضًا حتى يستدرجني بسبب ضعفه
Dialogue: 0,0:18:09.51,0:18:13.04,DCMain,KOGORO,0,0,0,,..إن طالت مدة التحقيق
Dialogue: 0,0:18:13.04,0:18:15.57,DCMain,KOGORO,0,0,0,,فستضطر الشرطة لطلب مساعدتي..
Dialogue: 0,0:18:16.32,0:18:20.32,DCMain,KOGORO,0,0,0,,...وبدلًا من انتظار ردة فعل المحقق العظيم
Dialogue: 0,0:18:20.65,0:18:23.44,DCMain,TAKAGI,0,0,0,,.قرر استدراجه من البداية
Dialogue: 0,0:18:23.44,0:18:24.65,DCMain,KOGORO,0,0,0,,!أصبت
Dialogue: 0,0:18:25.51,0:18:30.24,DCMain,KOGORO,0,0,0,,..وإن كنت أنا، الرجل الذي تثق به الشرطة قد استنتجت أن ثلاثتهم
Dialogue: 0,0:18:30.24,0:18:34.96,DCMain,KOGORO,0,0,0,,متورطون من قبل المجرم الحقيقي، فسيكون ضمانًا كبيرًا..
Dialogue: 0,0:18:35.19,0:18:36.74,DCMain,TAKAGI,0,0,0,,...لكن يا موري-سان
Dialogue: 0,0:18:36.74,0:18:40.59,DCMain,MEGURE,0,0,0,,.لا يوجد ما يضمن بأنك ستأتي بالنتيجة المرجوة
Dialogue: 0,0:18:40.59,0:18:42.79,DCMain,KOGORO,0,0,0,,.هذه النقطة المهمة
Dialogue: 0,0:18:42.79,0:18:43.47,DCMain,ALL,0,0,0,,
Dialogue: 0,0:18:43.78,0:18:46.42,DCMain,KOGORO,0,0,0,,لم يكن لشخص عادي أن يجازف بهذه المخاطرة
Dialogue: 0,0:18:46.86,0:18:49.85,DCMain,KOGORO,0,0,0,,لكن المجرم كان واثقًا من أنها ستنجح
Dialogue: 0,0:18:50.63,0:18:55.05,DCMain,KOGORO,0,0,0,,..واحد من هؤلاء ضعيف الإرادة وفي الوقت نفسه
Dialogue: 0,0:18:55.05,0:18:57.36,DCMain,KOGORO,0,0,0,,هو مفرط الثقة..
Dialogue: 0,0:18:58.35,0:18:59.36,DCMain,KOGORO,0,0,0,,..أهذا صحيح
Dialogue: 0,0:18:59.71,0:19:01.41,DCMain,KOGORO,0,0,0,,يا سازانامي ريويتشي-سان؟
Dialogue: 0,0:19:01.41,0:19:02.24,DCMain,SAZANAMI,0,0,0,,
Dialogue: 0,0:19:02.47,0:19:04.03,DCMain,MEGURE,0,0,0,,هو؟
Dialogue: 0,0:19:04.03,0:19:06.00,DCMain,SAZANAMI,0,0,0,,!لا! ليس أنا
Dialogue: 0,0:19:06.00,0:19:10.50,DCMain,KOGORO,0,0,0,,اتصلت البارحة بالضحية ودعوتها للخارج
Dialogue: 0,0:19:11.88,0:19:14.54,DCMain,SAZANAMI,0,0,0,,.أنا المحقق موري كوغورو
Dialogue: 0,0:19:14.54,0:19:16.84,DCMain,SAZANAMI,0,0,0,,لدي شيء لأناقشه مع باربارا ساداكو-سينسي
Dialogue: 0,0:19:17.76,0:19:23.01,DCMain,KOGORO,0,0,0,,ثم اتصلت بكاناوا-سان وإندو-سان حتى لا يكون لديهما أي عذر
Dialogue: 0,0:19:24.21,0:19:27.69,DCMain,SAZANAMI,0,0,0,,ستزورك ساداكو-سينسي الليلة حتى تعتذر عمّا قالته لك
Dialogue: 0,0:19:27.69,0:19:29.27,DCMain,SAZANAMI,0,0,0,,أرجوك ابقَ في منزلك
Dialogue: 0,0:19:29.53,0:19:33.02,DCMain,KOGORO,0,0,0,,ثم قتلت الضحية في حديقة شيباهاما
Dialogue: 0,0:19:33.39,0:19:36.40,DCMain,KOGORO,0,0,0,,وتركت قداحة كاناوا-سان في موقع الجريمة
Dialogue: 0,0:19:36.40,0:19:39.27,DCMain,KOGORO,0,0,0,,والتي على الأرجح أنك سرقتها عندما ذهبت لتشكو له
Dialogue: 0,0:19:39.69,0:19:45.03,DCMain,KOGORO,0,0,0,,واستخدمت سيارتك التي ادعيت أنها مسروقة لنقل الجثة إلى منزل بابا
Dialogue: 0,0:19:45.39,0:19:50.04,DCMain,KOGORO,0,0,0,,ثم تركت دبوس إندو-سان بجانب الجثة والذي سرقته أيضًا
Dialogue: 0,0:19:50.04,0:19:54.60,DCMain,KOGORO,0,0,0,,..بعدها تركتَ رسالة مفتوحة
Dialogue: 0,0:19:54.60,0:19:56.04,DCMain,KOGORO,0,0,0,,يمكن اكتشافها وقت التحقيق..
Dialogue: 0,0:19:56.33,0:19:59.49,DCItalic,SAZANAMI,0,0,0,,لقد أوقع بنا المجرم
Dialogue: 0,0:20:00.22,0:20:04.30,DCMain,KOGORO,0,0,0,,بعد ادّعائك ذاك، انتظرت ريثما تظهر نتيجة التشريح
Dialogue: 0,0:20:05.44,0:20:10.06,DCItalic,TAKAGI,0,0,0,,إن كان القاتل واحدًا من هؤلاء فمن المستحيل أن يكتب هذه
Dialogue: 0,0:20:10.99,0:20:14.92,DCMain,KOGORO,0,0,0,,..لقد حاولت التهرب والخروج من القضية
Dialogue: 0,0:20:14.92,0:20:18.82,DCMain,KOGORO,0,0,0,,بينما كانت الشرطة تبحث عن مجرم لا وجود له..
Dialogue: 0,0:20:20.32,0:20:24.32,DCMain,KOGORO,0,0,0,,.نعم، حتى لا تحل القضية أبدًا
Dialogue: 0,0:20:24.53,0:20:26.64,DCMain,SAZANAMI,0,0,0,,ضعيف الإرادة وواثق؟
Dialogue: 0,0:20:26.64,0:20:30.05,DCMain,SAZANAMI,0,0,0,,أأكون القاتل لأن هذه شخصيتي؟
Dialogue: 0,0:20:30.05,0:20:31.85,DCMain,SAZANAMI,0,0,0,,!لا علاقة لي بهذه القضية
Dialogue: 0,0:20:31.85,0:20:36.13,DCMain,KOGORO,0,0,0,,ثم كيف عرفت أن الجريمة ارتُكِبَتْ هنا؟
Dialogue: 0,0:20:36.36,0:20:37.59,DCMain,SAZANAMI,0,0,0,,...لا يمكن لي أن
Dialogue: 0,0:20:37.75,0:20:39.88,DCMain,KOGORO,0,0,0,,!أخبرنا
Dialogue: 0,0:20:41.84,0:20:44.14,DCMain,MEGURE,0,0,0,,أتعني المكالمة المجهولة؟
Dialogue: 0,0:20:44.14,0:20:46.89,DCMain,KOGORO,0,0,0,,.استمعت للتسجيل قبل قليل
Dialogue: 0,0:20:48.00,0:20:51.93,DCItalic,SAZANAMI,0,0,0,,رأيتُ شخصًا مشبوهًا في حديقة شيباهاما الليلة الماضية
Dialogue: 0,0:20:52.57,0:20:54.37,DCMain,SAZANAMI,0,0,0,,!لست أنا المتصل
Dialogue: 0,0:20:57.32,0:20:58.44,DCMain,CONAN,0,0,0,,.أنا سأجيب
Dialogue: 0,0:21:00.68,0:21:02.76,DCMain,CONAN,0,0,0,,نعم سأخبره
Dialogue: 0,0:21:03.75,0:21:05.27,DCMain,CONAN,0,0,0,,قالوا بأنهما تطابقا
Dialogue: 0,0:21:07.41,0:21:10.03,DCMain,KOGORO,0,0,0,,..أمرتهم أن يقارنوا ما بين الصوتين
Dialogue: 0,0:21:11.10,0:21:13.98,DCMain,KOGORO,0,0,0,,اللذين أرسلتهما إلى الأدلة الجنائية..
Dialogue: 0,0:21:14.98,0:21:16.99,DCMain,KOGORO,0,0,0,,..أنت من اتصل
Dialogue: 0,0:21:16.99,0:21:21.30,DCMain,KOGORO,0,0,0,,وأخبرتنا بموقع الجريمة الذي لا يعرفه إلا المجرم..
Dialogue: 0,0:21:21.80,0:21:25.30,DCMain,SAZANAMI,0,0,0,,لقد حفرت قبري بتلك المكالمة الهاتفية
Dialogue: 0,0:21:25.57,0:21:28.40,DCMain,MEGURE,0,0,0,,لكن لماذا اتصل؟
Dialogue: 0,0:21:28.40,0:21:30.05,DCMain,KOGORO,0,0,0,,لأنه اضطر لذلك
Dialogue: 0,0:21:30.40,0:21:34.94,DCMain,KOGORO,0,0,0,,..حالما نكتشف قداحة كاناوا-سان في موقع الجريمة
Dialogue: 0,0:21:35.36,0:21:39.56,DCMain,KOGORO,0,0,0,,فسيكونون كلهم مشبوهين
Dialogue: 0,0:21:40.81,0:21:43.94,DCMain,SAZANAMI,0,0,0,,شعرت باليأس دون الجميع
Dialogue: 0,0:21:43.94,0:21:47.34,DCMain,MEGURE,0,0,0,,إذًا تعترف بأنك أنت من قتلت باربارا ساداكو-سان
Dialogue: 0,0:21:47.34,0:21:51.49,DCMain,SAZANAMI,0,0,0,,..لو أنها أخبرتني بأن عملي سينجح
Dialogue: 0,0:21:51.90,0:21:54.87,DCMain,SAZANAMI,0,0,0,,!فسيكون من المستحيل ألا يجذب الرامن الفضائي الزبائن
Dialogue: 0,0:21:55.25,0:21:57.29,DCMain,MEGURE,0,0,0,,الرامن الفضائي؟
Dialogue: 0,0:21:58.37,0:22:01.32,DCItalic,CONAN,0,0,0,,ضعيف الإرادة  لكنه واثق
Dialogue: 0,0:22:01.76,0:22:03.43,DCItalic,CONAN,0,0,0,,يا لها من شخصية
Dialogue: 0,0:23:27.26,0:23:31.63,DCMain,CONAN,0,0,0,,..سهل التملق، ثمل وغير مسؤول
Dialogue: 0,0:23:31.87,0:23:34.28,DCMain,KOGORO,0,0,0,,عمّن تتحدّث؟
Dialogue: 0,0:23:34.28,0:23:38.05,DCMain,KOGORO,0,0,0,,أيوجد شخصٌ كهذا؟
Dialogue: 0,0:23:39.33,0:23:41.09,DCMain,KOGORO,0,0,0,,لا لا
Dialogue: 0,0:23:41.65,0:23:42.97,DCItalic,CONAN,0,0,0,,لا يوجد وعي ذاتي
