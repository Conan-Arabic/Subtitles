Dialogue: 0,0:00:17.43,0:00:20.43,Default,,0,0,0,,
Dialogue: 0,0:00:20.43,0:00:22.33,Default,,0,0,0,,‫قلبٌ قوي، مع حدسٍ حادّ وقوةٍ لا تُضاهى.
Dialogue: 0,0:00:22.33,0:00:24.43,Default,,0,0,0,,‫خطوةٌ إلى الجوهر، بإيقاعٍ صارم.
Dialogue: 0,0:00:24.43,0:00:25.93,Default,,0,0,0,,‫بركةٌ يتبدّل لونها مع مرور الزمن… فتغدو قرمزية.
Dialogue: 0,0:00:25.93,0:00:28.03,Default,,0,0,0,,‫وتُحلّ القضية.
Dialogue: 0,0:00:28.03,0:00:29.43,Default,,0,0,0,,‫إنه يرى الحقيقة الوحيدة من بين الجميع.
Dialogue: 0,0:00:29.43,0:00:31.43,Default,,0,0,0,,‫طفلٌ في المظهر، بعقلٍ يضاهي عقل البالغين.
Dialogue: 0,0:00:31.43,0:00:33.93,Default,,0,0,0,,‫اسمه… المحقّق كونان!
Dialogue: 0,0:01:58.59,0:02:01.39,Default,,0,0,0,,‫حضرنا مراسم الشاي نيابةً عن سونوكو ووالدها،
Dialogue: 0,0:02:01.39,0:02:05.39,Default,,0,0,0,,‫وكان من المقرّر إقامتها في منزل عائلة أونوجي.
Dialogue: 0,0:02:06.69,0:02:08.09,Default,,0,0,0,,‫في الحديقة بركةٌ يتغيّر لون مائها
Dialogue: 0,0:02:08.09,0:02:09.59,Default,,0,0,0,,‫إلى خمسة ألوان مختلفة.
Dialogue: 0,0:02:09.59,0:02:10.69,Default,,0,0,0,,‫وفي وسطها،
Dialogue: 0,0:02:10.69,0:02:13.29,Default,,0,0,0,,‫تقع غرفة شاي لا يُوصل إليها إلا عبر ممرٍّ معلق.
Dialogue: 0,0:02:14.49,0:02:16.79,Default,,0,0,0,,‫كنّا نستمتع بمشاهدة البركة،
Dialogue: 0,0:02:16.79,0:02:18.39,Default,,0,0,0,,‫حين وقع الحادث.
Dialogue: 0,0:02:19.99,0:02:22.59,Default,,0,0,0,,‫لقد شنق السيّد نفسه… ومات!
Dialogue: 0,0:02:22.59,0:02:24.99,Default,,0,0,0,,‫بل ومات تمامًا كما ورد في الأسطورة.
Dialogue: 0,0:02:25.99,0:02:29.49,Default,,0,0,0,,‫لا، هذا ليس انتحارًا.
Dialogue: 0,0:02:30.69,0:02:32.69,Default,,0,0,0,,‫إنها جريمة قتل!
Dialogue: 0,0:02:32.69,0:02:34.69,Default,,0,0,0,,‫أنا واثقٌ أن أحد الموجودين هنا
Dialogue: 0,0:02:34.69,0:02:37.69,Default,,0,0,0,,‫دبّر حيلةً محكمة وقتل السيّد،
Dialogue: 0,0:02:37.69,0:02:40.99,Default,,0,0,0,,‫ثم جعل الأمر يبدو وكأنه انتحار!
Dialogue: 0,0:02:40.99,0:02:43.29,Default,,0,0,0,,‫من الذي قد يفعل ذلك؟
Dialogue: 0,0:02:43.29,0:02:46.59,Default,,0,0,0,,‫ومن الذي يتقمّص دور الوحش؟
Dialogue: 0,0:02:48.79,0:02:54.89,Default,,0,0,0,,‫«أسطورة قصر المياه الخمسة الملوّنة – الجزء الثاني»
Dialogue: 0,0:02:54.89,0:02:58.09,Default,,0,0,0,,‫إذًا، بعد الرابعة عصرًا بقليل،
Dialogue: 0,0:02:58.09,0:02:59.59,Default,,0,0,0,,‫حين اجتمع الجميع في هذه الغرفة،
Dialogue: 0,0:02:59.59,0:03:03.59,Default,,0,0,0,,‫رأيتم جثة السيّد من هذه الشرفة، أليس كذلك؟
Dialogue: 0,0:03:05.69,0:03:06.99,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:03:06.99,0:03:10.39,Default,,0,0,0,,‫كان لون ماء البركة يتحوّل إلى القرمزي.
Dialogue: 0,0:03:10.39,0:03:14.89,Default,,0,0,0,,‫كما أن ريوإيتشي نظر إلى ساعته ليتأكد من الوقت.
Dialogue: 0,0:03:14.89,0:03:16.39,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:03:16.39,0:03:18.19,Default,,0,0,0,,‫كانت الرابعة تمامًا.
Dialogue: 0,0:03:18.19,0:03:20.49,Default,,0,0,0,,‫نظرتُ حينها نحو غرفة الشاي،
Dialogue: 0,0:03:20.49,0:03:22.89,Default,,0,0,0,,‫لكن جثة والدي لم تكن هناك بعد.
Dialogue: 0,0:03:22.89,0:03:27.49,Default,,0,0,0,,‫وحدث ذلك فور عودة الآنسة ميمورا.
Dialogue: 0,0:03:27.49,0:03:30.79,Default,,0,0,0,,‫أين كنتم جميعًا في ذلك الوقت؟
Dialogue: 0,0:03:30.79,0:03:34.19,Default,,0,0,0,,‫كنتُ أستحمّ لنحو ثلاثين دقيقة.
Dialogue: 0,0:03:34.19,0:03:37.99,Default,,0,0,0,,‫كان لديّ أمرٌ شخصي، فخرجتُ قليلًا.
Dialogue: 0,0:03:37.99,0:03:40.09,Default,,0,0,0,,‫وإلى أين ذهبت؟
Dialogue: 0,0:03:40.09,0:03:42.09,Default,,0,0,0,,‫هذا شأنٌ خاص!
Dialogue: 0,0:03:42.09,0:03:43.69,Default,,0,0,0,,‫لا أُجبر على الإجابة!
Dialogue: 0,0:03:45.09,0:03:46.69,Default,,0,0,0,,‫وماذا عنكِ، آنسة هاناساكي؟
Dialogue: 0,0:03:46.69,0:03:48.79,Default,,0,0,0,,‫كنتُ في المطبخ أُحضّر لأمسية الشاي،
Dialogue: 0,0:03:48.79,0:03:52.39,Default,,0,0,0,,‫وأهتمّ بالضيوف.
Dialogue: 0,0:03:52.39,0:03:54.59,Default,,0,0,0,,‫وأنت، السيّد ريوإيتشي؟
Dialogue: 0,0:03:54.59,0:03:58.29,Default,,0,0,0,,‫كنتُ أتنقّل بين غرفة الضيوف.
Dialogue: 0,0:03:58.29,0:04:03.39,Default,,0,0,0,,‫سمعنا أن السيّد أحرق صنّارة صيدك العزيزة؟
Dialogue: 0,0:04:03.39,0:04:06.29,Default,,0,0,0,,‫حسنًا… في الحقيقة…
Dialogue: 0,0:04:06.29,0:04:08.29,Default,,0,0,0,,‫أخبرنا بما حدث فعلًا.
Dialogue: 0,0:04:09.29,0:04:13.79,Default,,0,0,0,,‫طُلب منّي حضور مراسم الشاي الليلة.
Dialogue: 0,0:04:13.79,0:04:18.49,Default,,0,0,0,,‫ويبدو أنه كان ينوي إعلان اختياري خليفةً له
Dialogue: 0,0:04:18.49,0:04:20.59,Default,,0,0,0,,‫خلال المراسم.
Dialogue: 0,0:04:20.59,0:04:24.29,Default,,0,0,0,,‫لكنّك لا تعرف شيئًا عن طقوس الشاي!
Dialogue: 0,0:04:24.29,0:04:25.49,Default,,0,0,0,,‫مستحيل!
Dialogue: 0,0:04:25.49,0:04:28.99,Default,,0,0,0,,‫لا يمكن أن يكون قال ذلك!
Dialogue: 0,0:04:28.99,0:04:33.19,Default,,0,0,0,,‫إذًا، هل قبلتَ العرض؟
Dialogue: 0,0:04:33.19,0:04:35.49,Default,,0,0,0,,‫بالطبع لا! لقد رفضت!
Dialogue: 0,0:04:37.59,0:04:39.89,Default,,0,0,0,,‫بمعنى آخر، أحرق السيّد صنّارتك
Dialogue: 0,0:04:39.89,0:04:42.19,Default,,0,0,0,,‫لأنك لم تُطعْه؟
Dialogue: 0,0:04:42.19,0:04:45.89,Default,,0,0,0,,‫فحقدتَ عليه بسبب ذلك؟
Dialogue: 0,0:04:45.89,0:04:47.79,Default,,0,0,0,,‫انتظر لحظة.
Dialogue: 0,0:04:47.79,0:04:51.39,Default,,0,0,0,,‫أيها الضابط يوكوميزو، وقت وفاة السيّد،
Dialogue: 0,0:04:51.39,0:04:54.69,Default,,0,0,0,,‫كان الجميع، ومنهم ريوإيتشي، هنا في هذه الغرفة.
Dialogue: 0,0:04:54.69,0:04:56.09,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:04:56.09,0:04:59.59,Default,,0,0,0,,‫ولو أن أحدهم ذهب لقتله،
Dialogue: 0,0:04:59.59,0:05:03.39,Default,,0,0,0,,‫لكان قد مرّ من الشرفة ورأيناه.
Dialogue: 0,0:05:03.39,0:05:06.89,Default,,0,0,0,,‫كنتُ جالسًا على ذلك الكرسي طوال الوقت،
Dialogue: 0,0:05:06.89,0:05:09.99,Default,,0,0,0,,‫ولم أرَ أحدًا يتجه إلى غرفة الشاي.
Dialogue: 0,0:05:12.09,0:05:15.59,Default,,0,0,0,,‫ما يعني أن للجميع حجّة غيابٍ كاملة.
Dialogue: 0,0:05:16.59,0:05:20.99,Default,,0,0,0,,‫لكن ما يشغلني هو ما حملته الآنسة ميمورا عند عودتها.
Dialogue: 0,0:05:20.99,0:05:23.89,Default,,0,0,0,,‫بدت وكأنها تخشى أن يراها أحد.
Dialogue: 0,0:05:23.89,0:05:26.49,Default,,0,0,0,,‫ومع ذلك، لم يكن لديها وقتٌ لإخفاء أي شيء.
Dialogue: 0,0:05:26.49,0:05:28.69,Default,,0,0,0,,‫وهذا يعني…
Dialogue: 0,0:05:32.29,0:05:33.49,Default,,0,0,0,,‫هل يمكن أن يكون هذا هو؟
Dialogue: 0,0:05:41.49,0:05:43.99,Default,,0,0,0,,‫كما توقعت!
Dialogue: 0,0:05:43.99,0:05:46.09,Default,,0,0,0,,‫هل لي بكأس ماء، من فضلكم؟
Dialogue: 0,0:05:47.09,0:05:50.99,Default,,0,0,0,,‫عذرًا… أشعر بعطشٍ شديد.
Dialogue: 0,0:05:50.99,0:05:53.29,Default,,0,0,0,,‫تفضّل.
Dialogue: 0,0:05:53.29,0:05:54.49,Default,,0,0,0,,‫شكرًا جزيلًا.
Dialogue: 0,0:05:54.49,0:05:57.59,Default,,0,0,0,,‫سأُحضّر الشاي للجميع حالًا.
Dialogue: 0,0:06:01.39,0:06:03.19,Default,,0,0,0,,‫عذرًا، آنسة هاناساكي.
Dialogue: 0,0:06:03.19,0:06:04.69,Default,,0,0,0,,‫نعم، يا بُني؟
Dialogue: 0,0:06:04.69,0:06:07.09,Default,,0,0,0,,‫لماذا لا يرغب السيّد ريوإيتشي في خلافة السيّد،
Dialogue: 0,0:06:07.09,0:06:09.19,Default,,0,0,0,,‫مع أنه الابن الوحيد؟
Dialogue: 0,0:06:09.19,0:06:11.49,Default,,0,0,0,,‫هذا…
Dialogue: 0,0:06:11.49,0:06:15.09,Default,,0,0,0,,‫لا تتدخّل، أيها الصغير!
Dialogue: 0,0:06:16.39,0:06:18.59,Default,,0,0,0,,‫لكن هذا صحيح… لماذا؟
Dialogue: 0,0:06:18.59,0:06:21.99,Default,,0,0,0,,‫لأنني لم أرد أن أُصبح مثل والدي.
Dialogue: 0,0:06:21.99,0:06:23.59,Default,,0,0,0,,‫كان والدي متكبّرًا جدًا،
Dialogue: 0,0:06:23.59,0:06:25.99,Default,,0,0,0,,‫حتى إن والدتي كانت تبكي حزنًا دائمًا.
Dialogue: 0,0:06:25.99,0:06:29.29,Default,,0,0,0,,‫لكن أليس من الطبيعي أن يرغب الأب
Dialogue: 0,0:06:29.29,0:06:31.09,Default,,0,0,0,,‫في أن يرث ابنه المنصب المتوارث؟
Dialogue: 0,0:06:31.09,0:06:32.79,Default,,0,0,0,,‫أن تكون سيّدًا يعني إلقاء الخطب والمحاضرات.
Dialogue: 0,0:06:32.79,0:06:36.39,Default,,0,0,0,,‫أجرٌ مرتفع، وامتلاك أواني شاي
Dialogue: 0,0:06:36.39,0:06:40.69,Default,,0,0,0,,‫توارثتها الأجيال.
Dialogue: 0,0:06:40.69,0:06:43.09,Default,,0,0,0,,‫هذا كل ما كان يهتمّ به والدي!
Dialogue: 0,0:06:43.09,0:06:46.19,Default,,0,0,0,,‫فإن سلّمك المنصب،
Dialogue: 0,0:06:46.19,0:06:48.69,Default,,0,0,0,,‫سيواصل عيش حياته كما اعتاد.
Dialogue: 0,0:06:48.69,0:06:53.49,Default,,0,0,0,,‫وهذا ما كنت أكرهه فيه.
Dialogue: 0,0:06:53.49,0:06:56.89,Default,,0,0,0,,‫اسمحي لي بمساعدتكِ، آنسة هاناساكي.
Dialogue: 0,0:06:56.89,0:06:59.09,Default,,0,0,0,,‫شكرًا لك.
Dialogue: 0,0:06:59.09,0:07:00.39,Default,,0,0,0,,‫إن كنتِ تكرهينه إلى هذا الحد،
Dialogue: 0,0:07:00.39,0:07:03.79,Default,,0,0,0,,‫فلماذا لم تغادر المنزل؟
Dialogue: 0,0:07:03.79,0:07:05.49,Default,,0,0,0,,‫مهلًا!
Dialogue: 0,0:07:05.49,0:07:06.79,Default,,0,0,0,,‫صحيح…
Dialogue: 0,0:07:06.79,0:07:10.09,Default,,0,0,0,,‫لقد غادرتُ فعلًا لفترة طويلة.
Dialogue: 0,0:07:10.09,0:07:11.79,Default,,0,0,0,,‫لكنها أعادتني،
Dialogue: 0,0:07:11.79,0:07:15.79,Default,,0,0,0,,‫لأنها لم تعد تحتمل رعاية السيّد وحدها.
Dialogue: 0,0:07:15.79,0:07:17.09,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:07:17.09,0:07:19.59,Default,,0,0,0,,‫عدتُ بشرط ألا أكون خليفته.
Dialogue: 0,0:07:19.59,0:07:22.29,Default,,0,0,0,,‫لم يكن لديه من يدير أمواله،
Dialogue: 0,0:07:22.29,0:07:24.09,Default,,0,0,0,,‫فقال إن بإمكاني العودة إن تولّيتُ المحاسبة.
Dialogue: 0,0:07:24.09,0:07:27.49,Default,,0,0,0,,‫كان جشعًا بحق.
Dialogue: 0,0:07:27.49,0:07:32.29,Default,,0,0,0,,‫ومع ذلك، عاد وطلب منك الخلافة.
Dialogue: 0,0:07:32.29,0:07:33.69,Default,,0,0,0,,‫المحاسبة؟
Dialogue: 0,0:07:33.69,0:07:36.39,Default,,0,0,0,,‫إذًا أنت تعرف حجم أموال
Dialogue: 0,0:07:36.39,0:07:38.29,Default,,0,0,0,,‫وممتلكات عائلة أونوجي، أليس كذلك؟
Dialogue: 0,0:07:38.29,0:07:39.29,Default,,0,0,0,,‫مهلًا!
Dialogue: 0,0:07:39.29,0:07:41.49,Default,,0,0,0,,‫أهذا صحيح؟
Dialogue: 0,0:07:41.49,0:07:45.49,Default,,0,0,0,,‫إن مات والدك قبل تحديد خليفة،
Dialogue: 0,0:07:45.49,0:07:48.49,Default,,0,0,0,,‫فستَرِثُ جميع ممتلكاته، صحيح؟
Dialogue: 0,0:07:48.49,0:07:49.59,Default,,0,0,0,,‫وفوق ذلك،
Dialogue: 0,0:07:49.59,0:07:52.59,Default,,0,0,0,,‫سيصبح منصب السيّد شاغرًا لك.
Dialogue: 0,0:07:52.59,0:07:55.59,Default,,0,0,0,,‫ما سبب عودتك الحقيقي؟
Dialogue: 0,0:07:55.59,0:07:56.99,Default,,0,0,0,,‫يا لقلة الذوق!
Dialogue: 0,0:07:56.99,0:08:00.69,Default,,0,0,0,,‫كان السيّد يعاني من مشاكل صحية!
Dialogue: 0,0:08:00.69,0:08:02.29,Default,,0,0,0,,‫أفلا يكون القلق عليه
Dialogue: 0,0:08:02.29,0:08:04.29,Default,,0,0,0,,‫سببًا كافيًا لعودته؟
Dialogue: 0,0:08:04.29,0:08:07.19,Default,,0,0,0,,‫لا بأس، شكرًا لكِ يا آنسة هاناساكي.
Dialogue: 0,0:08:07.19,0:08:09.39,Default,,0,0,0,,‫سأذهب لتقديم الشاي الآن.
Dialogue: 0,0:08:13.19,0:08:16.59,Default,,0,0,0,,‫إذًا، السيّد الذي كان يخشى وحش البركة
Dialogue: 0,0:08:16.59,0:08:18.49,Default,,0,0,0,,‫ظلّ حبيس غرفة الشاي،
Dialogue: 0,0:08:18.49,0:08:21.49,Default,,0,0,0,,‫وقد عُلّقت التعاويذ في كل مكان.
Dialogue: 0,0:08:21.49,0:08:25.09,Default,,0,0,0,,‫بل وكان يكره اقتراب أي شخص منها.
Dialogue: 0,0:08:25.09,0:08:29.59,Default,,0,0,0,,‫نعم، حتى أنه وضع نظام إنذار.
Dialogue: 0,0:08:29.59,0:08:30.89,Default,,0,0,0,,‫ما يعني أن
Dialogue: 0,0:08:30.89,0:08:35.19,Default,,0,0,0,,‫دخول شخصٍ غريب كان بالغ الصعوبة.
Dialogue: 0,0:08:35.19,0:08:37.29,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:08:37.29,0:08:39.89,Default,,0,0,0,,‫وفوق ذلك، غرفة الشاي محاطة بالبركة.
Dialogue: 0,0:08:39.89,0:08:42.99,Default,,0,0,0,,‫ولو مرّ أحد عبر الممر الوحيد،
Dialogue: 0,0:08:42.99,0:08:45.99,Default,,0,0,0,,‫لكان قد رآه أحدنا.
Dialogue: 0,0:08:45.99,0:08:48.09,Default,,0,0,0,,‫فكيف نفّذ القاتل فعلته؟
Dialogue: 0,0:08:48.09,0:08:49.99,Default,,0,0,0,,‫ما مشكلتك؟
Dialogue: 0,0:08:49.99,0:08:54.49,Default,,0,0,0,,‫أراهن أنك كنت تخدعه بأواني شاي باهظة،
Dialogue: 0,0:08:54.49,0:08:57.49,Default,,0,0,0,,‫لكنه لم يكن أحمق!
Dialogue: 0,0:08:57.49,0:08:58.99,Default,,0,0,0,,‫تحدّث عن نفسك!
Dialogue: 0,0:08:58.99,0:09:01.89,Default,,0,0,0,,‫سمعتُ أنك استثمرتَ أموالًا طائلة
Dialogue: 0,0:09:01.89,0:09:04.29,Default,,0,0,0,,‫حتى أفلسَت شركتك!
Dialogue: 0,0:09:04.29,0:09:05.99,Default,,0,0,0,,‫اهدأوا قليلًا!
Dialogue: 0,0:09:05.99,0:09:09.19,Default,,0,0,0,,‫كل ما أسأل عنه هو علاقتكم بالسيّد.
Dialogue: 0,0:09:12.19,0:09:14.79,Default,,0,0,0,,‫هاه؟ ما شأن هذا الكوب؟
Dialogue: 0,0:09:14.79,0:09:17.69,Default,,0,0,0,,‫آنسة هاناساكي! هناك صدع فيه.
Dialogue: 0,0:09:18.79,0:09:21.29,Default,,0,0,0,,‫أنا آسفة جدًا.
Dialogue: 0,0:09:21.29,0:09:23.79,Default,,0,0,0,,‫يبدو أنكم تهتمّون بالمظهر فقط،
Dialogue: 0,0:09:23.79,0:09:26.99,Default,,0,0,0,,‫ولا يهمّكم ما في الداخل!
Dialogue: 0,0:09:27.19,0:09:30.39,Default,,0,0,0,,‫المظهر الخارجي فقط؟
Dialogue: 0,0:09:30.39,0:09:33.99,Default,,0,0,0,,‫اهدأوا… من الطبيعي أن تكون مضطربة.
Dialogue: 0,0:09:33.99,0:09:35.49,Default,,0,0,0,,‫أترى؟
Dialogue: 0,0:09:35.49,0:09:38.99,Default,,0,0,0,,‫آنسة هاناساكي، أراهن أنكِ سعيدة بموته.
Dialogue: 0,0:09:38.99,0:09:42.39,Default,,0,0,0,,‫فهو من ساق زوجته،
Dialogue: 0,0:09:42.39,0:09:45.69,Default,,0,0,0,,‫التي كانت تحسن رعايتك، إلى حتفها.
Dialogue: 0,0:09:45.69,0:09:47.99,Default,,0,0,0,,‫لم أفعل ذلك أبدًا!
Dialogue: 0,0:09:47.99,0:09:52.49,Default,,0,0,0,,‫لقد كانت آنسة هاناساكي تعتني بوالدي جيدًا.
Dialogue: 0,0:09:52.49,0:09:54.79,Default,,0,0,0,,‫ومن يدري؟ ربما دفعتموه إلى الانتحار
Dialogue: 0,0:09:54.79,0:09:58.99,Default,,0,0,0,,‫بأحاديثكم المتواصلة عن الوحش.
Dialogue: 0,0:10:00.09,0:10:02.09,Default,,0,0,0,,‫– ماذا؟ – هذا هراء!
Dialogue: 0,0:10:03.79,0:10:05.49,Default,,0,0,0,,‫آنسة هاناساكي!
Dialogue: 0,0:10:11.99,0:10:13.09,Default,,0,0,0,,‫آنسة هاناساكي…
Dialogue: 0,0:10:13.09,0:10:15.49,Default,,0,0,0,,‫كيف تجرؤ على القول إنني كنت أكرهه؟
Dialogue: 0,0:10:17.19,0:10:18.99,Default,,0,0,0,,‫لا تدعيها تزعجك.
Dialogue: 0,0:10:18.99,0:10:22.09,Default,,0,0,0,,‫كما تعلمين، هي هكذا دائمًا.
Dialogue: 0,0:10:22.09,0:10:25.39,Default,,0,0,0,,‫هل هي زوجة السيّد؟
Dialogue: 0,0:10:25.39,0:10:27.49,Default,,0,0,0,,‫تبدو لطيفة جدًا.
Dialogue: 0,0:10:28.99,0:10:32.09,Default,,0,0,0,,‫كانت لطيفة فعلًا.
Dialogue: 0,0:10:32.09,0:10:35.49,Default,,0,0,0,,‫مجرد النظر إلى صورتها يبعث الطمأنينة.
Dialogue: 0,0:10:35.49,0:10:38.29,Default,,0,0,0,,‫لذلك أحتفظ بالكثير من صورها هنا.
Dialogue: 0,0:10:40.19,0:10:44.19,Default,,0,0,0,,‫لم توبّخني يومًا لكرهي طقوس الشاي.
Dialogue: 0,0:10:44.19,0:10:46.69,Default,,0,0,0,,‫بل كانت ترافقني في الصيد أيضًا.
Dialogue: 0,0:10:49.49,0:10:51.29,Default,,0,0,0,,‫طريقة ربط هذا الحبل…
Dialogue: 0,0:11:05.39,0:11:09.19,Default,,0,0,0,,‫ها هنا! لقد اقتحم أحدهم المكان.
Dialogue: 0,0:11:09.19,0:11:11.59,Default,,0,0,0,,‫إن كان استنتاجي صحيحًا…
Dialogue: 0,0:11:18.99,0:11:21.79,Default,,0,0,0,,‫كما توقعت.
Dialogue: 0,0:11:21.79,0:11:23.49,Default,,0,0,0,,‫ما يعني أن القاتل هو الشخص
Dialogue: 0,0:11:23.49,0:11:27.69,Default,,0,0,0,,‫الذي تصرّف بغرابة عند العثور على الجثة.
Dialogue: 0,0:11:28.69,0:11:32.09,Default,,0,0,0,,‫لا بدّ أنه ترك دليلًا خلفه.
Dialogue: 0,0:11:38.19,0:11:40.09,Default,,0,0,0,,‫هذا هو…
Dialogue: 0,0:11:40.09,0:11:43.79,Default,,0,0,0,,‫لقد وجدتُ دليلًا قاطعًا لا يُدحض!
Dialogue: 0,0:11:44.89,0:11:47.19,Default,,0,0,0,,‫شكرًا لكم جميعًا.
Dialogue: 0,0:11:47.19,0:11:48.99,Default,,0,0,0,,‫إذًا يمكنني العودة إلى المنزل.
Dialogue: 0,0:11:48.99,0:11:52.69,Default,,0,0,0,,‫نعم، فلا شكّ أنه انتحار.
Dialogue: 0,0:11:52.69,0:11:54.89,Default,,0,0,0,,‫– ماذا؟ – يا إلهي!
Dialogue: 0,0:11:54.89,0:11:56.79,Default,,0,0,0,,‫هيا يا كونان، سنغادر.
Dialogue: 0,0:11:56.79,0:11:58.39,Default,,0,0,0,,‫أين العمّ؟
Dialogue: 0,0:11:58.39,0:11:59.49,Default,,0,0,0,,‫سيأتي حالًا.
Dialogue: 0,0:11:59.49,0:12:00.49,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:12:02.39,0:12:04.89,Default,,0,0,0,,‫وهكذا انتهى الأمر.
Dialogue: 0,0:12:04.89,0:12:08.19,Default,,0,0,0,,‫حسنًا، حان وقت العودة.
Dialogue: 0,0:12:08.19,0:12:11.09,Default,,0,0,0,,‫نعم، بعد أن تأخذ قيلولة أولًا.
Dialogue: 0,0:12:15.98,0:12:18.98,Default,,0,0,0,,‫لم يتبقَّ سوى انتظار تقرير الطبيب الشرعي.
Dialogue: 0,0:12:18.98,0:12:19.98,Default,,0,0,0,,‫نعم، سيدي.
Dialogue: 0,0:12:19.98,0:12:21.38,Default,,0,0,0,,‫أيها الضابط!
Dialogue: 0,0:12:22.38,0:12:25.28,Default,,0,0,0,,‫أبي يقول: "لا تخبروني أنهم سيغادرون
Dialogue: 0,0:12:25.28,0:12:27.88,Default,,0,0,0,,‫والقاتل أمام أعينهم مباشرة!"
Dialogue: 0,0:12:27.88,0:12:29.48,Default,,0,0,0,,‫القاتل؟
Dialogue: 0,0:12:29.48,0:12:32.08,Default,,0,0,0,,‫أبي اكتشف الأمر!
Dialogue: 0,0:12:35.58,0:12:38.18,Default,,0,0,0,,‫ماذا تقصد تحديدًا يا سيد موري؟
Dialogue: 0,0:12:38.18,0:12:40.78,Default,,0,0,0,,‫أنت تعرف بالفعل، أليس كذلك،
Dialogue: 0,0:12:40.78,0:12:43.18,Default,,0,0,0,,‫أيها الضابط يوكوميزو؟
Dialogue: 0,0:12:43.18,0:12:46.08,Default,,0,0,0,,‫أن السيّد لم ينتحر،
Dialogue: 0,0:12:46.08,0:12:49.18,Default,,0,0,0,,‫بل قُتل.
Dialogue: 0,0:12:49.18,0:12:51.78,Default,,0,0,0,,‫رجاءً أعطنا التفاصيل.
Dialogue: 0,0:12:51.78,0:12:54.98,Default,,0,0,0,,‫حسنًا، أنا سعيد أن لدينا محقّقًا مشهورًا هنا!
Dialogue: 0,0:12:54.98,0:12:57.28,Default,,0,0,0,,‫على الأقل لن نموت من الملل.
Dialogue: 0,0:12:57.28,0:12:59.88,Default,,0,0,0,,‫إذًا سأشرح الأمر باختصار.
Dialogue: 0,0:12:59.88,0:13:02.08,Default,,0,0,0,,‫في الوقت الذي تحوّلت فيه البركة إلى اللون القرمزي،
Dialogue: 0,0:13:02.08,0:13:05.78,Default,,0,0,0,,‫وقعت جريمة القتل دون أن ينتبه أحد.
Dialogue: 0,0:13:05.78,0:13:09.58,Default,,0,0,0,,‫لكن عندما عُثر على جثة السيّد،
Dialogue: 0,0:13:09.58,0:13:12.98,Default,,0,0,0,,‫كنتم جميعًا في هذه الغرفة، صحيح؟
Dialogue: 0,0:13:12.98,0:13:16.68,Default,,0,0,0,,‫نعم، القاتل ربط السيّد
Dialogue: 0,0:13:16.68,0:13:20.08,Default,,0,0,0,,‫داخل غرفة الشاي إلى عارضةٍ علوية،
Dialogue: 0,0:13:20.08,0:13:23.08,Default,,0,0,0,,‫وهو باقٍ في هذه الغرفة مستخدمًا حبلًا واحدًا!
Dialogue: 0,0:13:23.08,0:13:24.58,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:13:24.58,0:13:26.68,Default,,0,0,0,,‫بحبلٍ واحد؟
Dialogue: 0,0:13:26.68,0:13:29.48,Default,,0,0,0,,‫اتّبع القاتل تفاصيل حكاية الوحش
Dialogue: 0,0:13:29.48,0:13:31.88,Default,,0,0,0,,‫عن هذه البركة التي تناقلتها الأجيال،
Dialogue: 0,0:13:31.88,0:13:34.98,Default,,0,0,0,,‫وطعن السيّد على شرفة غرفة الشاي.
Dialogue: 0,0:13:34.98,0:13:36.18,Default,,0,0,0,,‫ثم خُنق السيّد حتى الموت
Dialogue: 0,0:13:36.18,0:13:38.58,Default,,0,0,0,,‫بحبلٍ لُفّ حول عنقه من الخلف.
Dialogue: 0,0:13:39.58,0:13:42.18,Default,,0,0,0,,‫ربط القاتل الحبل الذي كان مخبّأً في مكانٍ ما
Dialogue: 0,0:13:42.18,0:13:44.88,Default,,0,0,0,,‫داخل غرفة الشاي بعارضةٍ علوية.
Dialogue: 0,0:13:44.88,0:13:46.78,Default,,0,0,0,,‫وعُقدت عقدة خاصة بحيث إذا سُحب أحد الطرفين،
Dialogue: 0,0:13:46.78,0:13:49.18,Default,,0,0,0,,‫تضيق حلقة الحبل،
Dialogue: 0,0:13:49.18,0:13:52.68,Default,,0,0,0,,‫فيكون طرفٌ ملتفًا حول عنق السيّد،
Dialogue: 0,0:13:52.68,0:13:56.18,Default,,0,0,0,,‫والطرف الآخر مربوطًا بدعامة العارضة.
Dialogue: 0,0:13:56.18,0:13:58.78,Default,,0,0,0,,‫ثم مُرّر الحبل عبر النافذة إلى الخارج.
Dialogue: 0,0:13:58.78,0:14:01.88,Default,,0,0,0,,‫وكان الحبل مربوطًا مسبقًا بعصا طاحونة الهواء
Dialogue: 0,0:14:01.88,0:14:04.98,Default,,0,0,0,,‫ومغمورًا عميقًا في ماء البركة.
Dialogue: 0,0:14:04.98,0:14:06.08,Default,,0,0,0,,‫ثم ربط القاتل هذا الحبل
Dialogue: 0,0:14:06.08,0:14:08.18,Default,,0,0,0,,‫بطرف الحبل الذي أخرجه من الداخل إلى الخارج.
Dialogue: 0,0:14:09.78,0:14:12.98,Default,,0,0,0,,‫وهكذا تم إعداد الحبل.
Dialogue: 0,0:14:13.98,0:14:16.78,Default,,0,0,0,,‫وأخيرًا، صُنِع نابضٌ باستخدام الخشبة القابلة للإزالة
Dialogue: 0,0:14:16.78,0:14:20.78,Default,,0,0,0,,‫عند المدخل الصغير، مع دبوسٍ مطاطي ورباطٍ مطاطي.
Dialogue: 0,0:14:22.88,0:14:24.98,Default,,0,0,0,,‫وخدعة الباب المُغلق تُجهّز عبر إسناد الباب
Dialogue: 0,0:14:24.98,0:14:26.98,Default,,0,0,0,,‫بلفافةٍ معلّقة،
Dialogue: 0,0:14:26.98,0:14:29.18,Default,,0,0,0,,‫لتسقط بعد أن يغادر القاتل.
Dialogue: 0,0:14:32.08,0:14:34.18,Default,,0,0,0,,‫الآن وقد ذكرتِ ذلك، كان هناك شيءٌ
Dialogue: 0,0:14:34.18,0:14:36.38,Default,,0,0,0,,‫يشبه ثقب دبوسٍ على الباب.
Dialogue: 0,0:14:36.38,0:14:38.28,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:14:38.28,0:14:41.38,Default,,0,0,0,,‫عاد القاتل إلى هذه الغرفة بعد أن أنهى كل شيء،
Dialogue: 0,0:14:41.38,0:14:43.48,Default,,0,0,0,,‫وصنع لنفسه حجّة غياب.
Dialogue: 0,0:14:43.48,0:14:45.98,Default,,0,0,0,,‫يا إلهي! حقًا؟
Dialogue: 0,0:14:45.98,0:14:49.98,Default,,0,0,0,,‫تتحوّل البركة إلى القرمزي قرابة الرابعة مساءً،
Dialogue: 0,0:14:49.98,0:14:52.38,Default,,0,0,0,,‫ويبدأ المؤقّت بتدوير طاحونة الهواء تلقائيًا.
Dialogue: 0,0:14:52.38,0:14:57.38,Default,,0,0,0,,‫ثم يلتف الحبل حول عصا الطاحونة،
Dialogue: 0,0:14:57.38,0:15:00.28,Default,,0,0,0,,‫فتُسحب الجثة إلى داخل الغرفة.
Dialogue: 0,0:15:00.28,0:15:04.08,Default,,0,0,0,,‫تصطدم اللفافة بالجسد فيسقط،
Dialogue: 0,0:15:04.08,0:15:06.38,Default,,0,0,0,,‫فيُغلق الباب تمامًا.
Dialogue: 0,0:15:07.88,0:15:11.58,Default,,0,0,0,,‫ثم تُقفل الخشبة القابلة للإزالة داخل فتحة العمود.
Dialogue: 0,0:15:11.58,0:15:14.78,Default,,0,0,0,,‫وبعد أن يسحب الحبل الجثة إلى أعلى العارضة،
Dialogue: 0,0:15:14.78,0:15:17.48,Default,,0,0,0,,‫تُشد الحلقة بإحكام.
Dialogue: 0,0:15:17.48,0:15:19.78,Default,,0,0,0,,‫والجزء من الحبل الذي كان قد قيس مسبقًا
Dialogue: 0,0:15:19.78,0:15:22.88,Default,,0,0,0,,‫وقُطع جزئيًا يُقطع بالكامل،
Dialogue: 0,0:15:22.88,0:15:26.58,Default,,0,0,0,,‫ثم تسحبه الطاحونة إلى الخارج.
Dialogue: 0,0:15:26.58,0:15:28.98,Default,,0,0,0,,‫وكل ما تبقّى بعد ذلك هو أن يتعمّد أحدهم
Dialogue: 0,0:15:28.98,0:15:30.78,Default,,0,0,0,,‫إظهار الباب وكأنه يُزاح إلى الجانب،
Dialogue: 0,0:15:30.78,0:15:33.88,Default,,0,0,0,,‫بينما كنا جميعًا مصدومين عند العثور على الجثة،
Dialogue: 0,0:15:33.88,0:15:37.28,Default,,0,0,0,,‫ثم ينزع الدبوس والرباط المطاطي.
Dialogue: 0,0:15:38.28,0:15:39.78,Default,,0,0,0,,‫أفهم.
Dialogue: 0,0:15:39.78,0:15:42.48,Default,,0,0,0,,‫إذًا يمكن تنفيذ الجريمة بهذه الطريقة.
Dialogue: 0,0:15:42.48,0:15:44.48,Default,,0,0,0,,‫تقريبًا في الوقت الذي تبدأ فيه الطاحونة بالدوران،
Dialogue: 0,0:15:44.48,0:15:45.68,Default,,0,0,0,,‫تأتي أشعة الشمس من الغرب
Dialogue: 0,0:15:45.68,0:15:46.78,Default,,0,0,0,,‫فتشتّت انعكاس الضوء على سطح الماء،
Dialogue: 0,0:15:46.78,0:15:48.98,Default,,0,0,0,,‫مما يجعل الحبل صعب الرؤية.
Dialogue: 0,0:15:48.98,0:15:53.88,Default,,0,0,0,,‫واستغل القاتل هذه الخاصية لتنفيذ الجريمة.
Dialogue: 0,0:15:53.88,0:15:58.58,Default,,0,0,0,,‫لكن كيف وصل القاتل إلى غرفة الشاي؟
Dialogue: 0,0:15:58.58,0:16:02.98,Default,,0,0,0,,‫باستخدام الممرّ الواصل الذي كنّا ننظر إليه.
Dialogue: 0,0:16:02.98,0:16:06.28,Default,,0,0,0,,‫ألم تكن أنت من شهد قبل قليل
Dialogue: 0,0:16:06.28,0:16:11.48,Default,,0,0,0,,‫أن أحدًا لم يُرَ متجهًا إلى غرفة الشاي؟
Dialogue: 0,0:16:11.48,0:16:13.48,Default,,0,0,0,,‫لكن أنت من قال:
Dialogue: 0,0:16:13.48,0:16:15.58,Default,,0,0,0,,‫"كل ما تهتمون به هو كيف يبدو من الخارج،
Dialogue: 0,0:16:15.58,0:16:18.48,Default,,0,0,0,,‫ولا تهتمون كيف يبدو من الداخل."
Dialogue: 0,0:16:18.48,0:16:20.18,Default,,0,0,0,,‫أليس كذلك؟
Dialogue: 0,0:16:20.18,0:16:22.48,Default,,0,0,0,,‫ماذا؟ نعم.
Dialogue: 0,0:16:22.48,0:16:24.58,Default,,0,0,0,,‫أنت محق.
Dialogue: 0,0:16:24.58,0:16:26.98,Default,,0,0,0,,‫استغل القاتل تلك النقطة العمياء،
Dialogue: 0,0:16:26.98,0:16:29.18,Default,,0,0,0,,‫فتركنا ننظر إلى البركة،
Dialogue: 0,0:16:29.18,0:16:32.88,Default,,0,0,0,,‫بينما مرّ أمام أعيننا مباشرة
Dialogue: 0,0:16:32.88,0:16:35.58,Default,,0,0,0,,‫من تحت الممرّ الواصل.
Dialogue: 0,0:16:35.58,0:16:37.68,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:16:37.68,0:16:40.28,Default,,0,0,0,,‫تسلّل القاتل أولًا تحت الممرّ الواصل
Dialogue: 0,0:16:40.28,0:16:43.68,Default,,0,0,0,,‫من بين الشجيرات بجانب الممر.
Dialogue: 0,0:16:43.68,0:16:47.68,Default,,0,0,0,,‫ثم سبح حتى وصل إلى غرفة الشاي.
Dialogue: 0,0:16:47.68,0:16:50.98,Default,,0,0,0,,‫وبعد ذلك، خرج أمام باب المدخل على الشرفة.
Dialogue: 0,0:16:50.98,0:16:54.38,Default,,0,0,0,,‫وبعد أن استدرج السيّد إلى الخارج،
Dialogue: 0,0:16:54.38,0:16:56.78,Default,,0,0,0,,‫طعنه بالسكين.
Dialogue: 0,0:16:56.78,0:16:59.18,Default,,0,0,0,,‫إذًا يا سيد موري… من القاتل؟
Dialogue: 0,0:16:59.18,0:17:01.18,Default,,0,0,0,,‫تصرف القاتل بغرابة
Dialogue: 0,0:17:01.18,0:17:03.38,Default,,0,0,0,,‫أثناء وقت تنفيذ الجريمة.
Dialogue: 0,0:17:03.38,0:17:05.28,Default,,0,0,0,,‫آنسة ميمورا، إنها أنتِ، أليس كذلك؟
Dialogue: 0,0:17:05.28,0:17:07.08,Default,,0,0,0,,‫قلتِ إنكِ خرجتِ، لكن…
Dialogue: 0,0:17:07.08,0:17:08.08,Default,,0,0,0,,‫ما قصتكِ؟
Dialogue: 0,0:17:08.08,0:17:10.68,Default,,0,0,0,,‫أتقول إنني أنا من قتل السيّد؟
Dialogue: 0,0:17:10.68,0:17:15.88,Default,,0,0,0,,‫إذًا ستشرحين لنا أين ذهبتِ الآن؟
Dialogue: 0,0:17:15.88,0:17:19.48,Default,,0,0,0,,‫ذهبتُ فقط لألتقط هذا!
Dialogue: 0,0:17:19.48,0:17:22.68,Default,,0,0,0,,‫أليس هذا وعاءً باهظ الثمن؟
Dialogue: 0,0:17:23.98,0:17:25.88,Default,,0,0,0,,‫كيف عرفتَ؟
Dialogue: 0,0:17:25.88,0:17:28.18,Default,,0,0,0,,‫بعد أن علمتِ أن السيّد
Dialogue: 0,0:17:28.18,0:17:31.48,Default,,0,0,0,,‫سينسحب بعد مراسم الشاي الليلة،
Dialogue: 0,0:17:31.48,0:17:33.58,Default,,0,0,0,,‫ألم تخشي أن ينال السيد ياغورا
Dialogue: 0,0:17:33.58,0:17:37.58,Default,,0,0,0,,‫مقعد الخلافة بوصفه الوريث؟
Dialogue: 0,0:17:37.58,0:17:40.28,Default,,0,0,0,,‫لذلك خرجتِ لتحصلي على وعاء
Dialogue: 0,0:17:40.28,0:17:44.78,Default,,0,0,0,,‫أغلى حتى مما أحضره السيد ياغورا.
Dialogue: 0,0:17:44.78,0:17:47.08,Default,,0,0,0,,‫أليس كذلك، آنسة ميمورا؟
Dialogue: 0,0:17:49.08,0:17:50.58,Default,,0,0,0,,‫لأنني إن ورثتُ منصب السيّد،
Dialogue: 0,0:17:50.58,0:17:54.08,Default,,0,0,0,,‫فمعظم ممتلكاته ستصبح لي.
Dialogue: 0,0:17:54.08,0:17:56.68,Default,,0,0,0,,‫لقد طمعتُ قليلًا.
Dialogue: 0,0:17:56.68,0:17:59.68,Default,,0,0,0,,‫أنا متأكد أنكِ تقولين الحقيقة.
Dialogue: 0,0:17:59.68,0:18:01.88,Default,,0,0,0,,‫لو خرجتِ ثم تسللتِ للداخل،
Dialogue: 0,0:18:01.88,0:18:04.28,Default,,0,0,0,,‫لانطلق إنذار الأمان.
Dialogue: 0,0:18:04.28,0:18:06.68,Default,,0,0,0,,‫وعندما عادت الآنسة ميمورا فعلًا،
Dialogue: 0,0:18:06.68,0:18:10.98,Default,,0,0,0,,‫ذهبت الآنسة هاناساكي لاستقبالها عند الباب.
Dialogue: 0,0:18:10.98,0:18:15.78,Default,,0,0,0,,‫للأسف، لم يكن لديها وقت للاقتراب من غرفة الشاي.
Dialogue: 0,0:18:15.78,0:18:19.48,Default,,0,0,0,,‫وهذا يعني أن الآنسة ميمورا ليست القاتلة.
Dialogue: 0,0:18:21.28,0:18:23.78,Default,,0,0,0,,‫إذًا، من قتل السيّد؟
Dialogue: 0,0:18:23.78,0:18:26.68,Default,,0,0,0,,‫القاتل، بعد أن حسب أن السيّد
Dialogue: 0,0:18:26.68,0:18:28.58,Default,,0,0,0,,‫الذي أراد عرضًا مهيبًا،
Dialogue: 0,0:18:28.58,0:18:32.88,Default,,0,0,0,,‫لن يسمح لأحد بالاقتراب من غرفة الشاي،
Dialogue: 0,0:18:32.88,0:18:37.78,Default,,0,0,0,,‫علّقه من عنقه مستخدمًا طريقة ربطٍ خاصة.
Dialogue: 0,0:18:37.78,0:18:40.28,Default,,0,0,0,,‫إنها طريقة ربط يستخدمها الصيادون
Dialogue: 0,0:18:40.28,0:18:44.68,Default,,0,0,0,,‫عندما يريدون تثبيت القارب في مكانه.
Dialogue: 0,0:18:46.08,0:18:47.58,Default,,0,0,0,,‫صيّاد؟
Dialogue: 0,0:18:47.58,0:18:48.68,Default,,0,0,0,,‫أنا لم أفعلها!
Dialogue: 0,0:18:48.68,0:18:50.88,Default,,0,0,0,,‫لا، ليس أنت.
Dialogue: 0,0:18:50.88,0:18:56.28,Default,,0,0,0,,‫فالقاتل سبح عبر الممرّ.
Dialogue: 0,0:18:56.28,0:18:57.88,Default,,0,0,0,,‫أفهم!
Dialogue: 0,0:18:57.88,0:19:02.08,Default,,0,0,0,,‫كان لا بدّ أن يكون القاتل مبلّلًا! شعره وجسده وكل شيء!
Dialogue: 0,0:19:02.08,0:19:04.58,Default,,0,0,0,,‫ولكي يُخفي ذلك، كان عليه أن يستحمّ
Dialogue: 0,0:19:04.58,0:19:07.08,Default,,0,0,0,,‫مباشرة بعد ارتكاب الجريمة.
Dialogue: 0,0:19:07.08,0:19:08.28,Default,,0,0,0,,‫بالضبط.
Dialogue: 0,0:19:08.28,0:19:10.98,Default,,0,0,0,,‫القاتل هو أنت، السيد ياغورا!
Dialogue: 0,0:19:12.98,0:19:16.98,Default,,0,0,0,,‫عندما كان الجميع مجتمعين في هذه الغرفة،
Dialogue: 0,0:19:16.98,0:19:20.18,Default,,0,0,0,,‫انتقدتِ سلوك الآنسة ميمورا بشدة، أليس كذلك؟
Dialogue: 0,0:19:20.18,0:19:22.78,Default,,0,0,0,,‫كان عليّ أن أتدخل بينكما لأوقفكما.
Dialogue: 0,0:19:23.78,0:19:28.38,Default,,0,0,0,,‫فعلتَ ذلك لأنك لم تُرِد لنا أن نلاحظ
Dialogue: 0,0:19:28.38,0:19:31.98,Default,,0,0,0,,‫أن جثة السيّد كانت تُسحب إلى الأعلى، أليس كذلك؟
Dialogue: 0,0:19:31.98,0:19:34.58,Default,,0,0,0,,‫لا عجب أنك كنت غاضبًا بهذا الشكل.
Dialogue: 0,0:19:34.58,0:19:35.68,Default,,0,0,0,,‫كل ما كان عليك فعله بعد ذلك
Dialogue: 0,0:19:35.68,0:19:39.68,Default,,0,0,0,,‫هو انتظار أن يلاحظ أحدهم جثة السيّد.
Dialogue: 0,0:19:39.68,0:19:40.78,Default,,0,0,0,,‫كل هذا كذب!
Dialogue: 0,0:19:40.78,0:19:44.38,Default,,0,0,0,,‫أنت تفترض أمورًا بلا أي دليل!
Dialogue: 0,0:19:44.38,0:19:46.88,Default,,0,0,0,,‫لا فائدة من الخداع الآن.
Dialogue: 0,0:19:46.88,0:19:51.78,Default,,0,0,0,,‫لقد تركتَ دليلًا يراه الجميع.
Dialogue: 0,0:19:51.78,0:19:54.08,Default,,0,0,0,,‫في الممرّ الواصل إلى غرفة الشاي.
Dialogue: 0,0:19:54.08,0:19:56.88,Default,,0,0,0,,‫يا سيد موري، لقد وجدتُ ما طلبتَ مني البحث عنه!
Dialogue: 0,0:19:56.88,0:19:58.18,Default,,0,0,0,,‫وما هو؟
Dialogue: 0,0:19:58.18,0:19:59.68,Default,,0,0,0,,‫الشيء الذي وُجد على العوارض
Dialogue: 0,0:19:59.68,0:20:01.48,Default,,0,0,0,,‫تحت الممرّ الواصل.
Dialogue: 0,0:20:01.48,0:20:02.48,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:20:02.48,0:20:04.68,Default,,0,0,0,,‫إنها بصمة يد.
Dialogue: 0,0:20:04.68,0:20:06.98,Default,,0,0,0,,‫وهذا الشيء الأسود هو…
Dialogue: 0,0:20:06.98,0:20:09.78,Default,,0,0,0,,‫إنه طحلب البركة.
Dialogue: 0,0:20:09.78,0:20:11.48,Default,,0,0,0,,‫لو مرّ من هناك،
Dialogue: 0,0:20:11.48,0:20:14.48,Default,,0,0,0,,‫فمن الطبيعي أن يعلق به شيء.
Dialogue: 0,0:20:16.38,0:20:18.08,Default,,0,0,0,,‫هناك آثار كثيرة لبصمة اليد،
Dialogue: 0,0:20:18.08,0:20:20.78,Default,,0,0,0,,‫وأعتقد أننا نستطيع تمييز بصمات الأصابع منها أيضًا.
Dialogue: 0,0:20:20.78,0:20:22.38,Default,,0,0,0,,‫رجال قسم التحقيق الجنائي
Dialogue: 0,0:20:22.38,0:20:23.68,Default,,0,0,0,,‫يفحصونها الآن.
Dialogue: 0,0:20:23.68,0:20:24.78,Default,,0,0,0,,‫أعتذر إن بدا الأمر وقحًا،
Dialogue: 0,0:20:24.78,0:20:27.98,Default,,0,0,0,,‫لكن هل تسمح لي بأخذ بصماتك، سيد ياغورا؟
Dialogue: 0,0:20:30.38,0:20:34.08,Default,,0,0,0,,‫ظننتُ أن الخطة كانت مثالية.
Dialogue: 0,0:20:34.08,0:20:36.98,Default,,0,0,0,,‫إذًا تعترف؟
Dialogue: 0,0:20:39.78,0:20:43.28,Default,,0,0,0,,‫ذلك الرجل كان الأسوأ!
Dialogue: 0,0:20:43.28,0:20:44.78,Default,,0,0,0,,‫أراهن أنه قال لك
Dialogue: 0,0:20:44.78,0:20:47.68,Default,,0,0,0,,‫إنه سيجعلك ترث منصبه وأنك وافقت على ذلك.
Dialogue: 0,0:20:47.68,0:20:49.38,Default,,0,0,0,,‫لا!
Dialogue: 0,0:20:51.08,0:20:53.28,Default,,0,0,0,,‫كنتُ أصنع معه قطع فخار باهظة مزيّفة
Dialogue: 0,0:20:53.28,0:20:57.48,Default,,0,0,0,,‫ثم نبيعها.
Dialogue: 0,0:20:57.48,0:20:59.58,Default,,0,0,0,,‫مستحيل…
Dialogue: 0,0:21:00.58,0:21:01.98,Default,,0,0,0,,‫أراهن أنك لم تكن تعلم، أليس كذلك؟
Dialogue: 0,0:21:01.98,0:21:04.38,Default,,0,0,0,,‫نفعل ذلك منذ عشر سنوات.
Dialogue: 0,0:21:04.38,0:21:06.28,Default,,0,0,0,,‫لكن بعد وفاة زوجته،
Dialogue: 0,0:21:06.28,0:21:08.38,Default,,0,0,0,,‫بدأ يؤمن بوجود الوحش،
Dialogue: 0,0:21:08.38,0:21:10.38,Default,,0,0,0,,‫وتغيّرت شخصيته بالكامل.
Dialogue: 0,0:21:10.38,0:21:12.18,Default,,0,0,0,,‫قال إنه سيجعل ريوإيتشي يرث كل شيء،
Dialogue: 0,0:21:12.18,0:21:14.88,Default,,0,0,0,,‫وسيكشف ما حدث للعلن.
Dialogue: 0,0:21:14.88,0:21:16.48,Default,,0,0,0,,‫ولهذا لم يكن أمامك خيار سوى قتله
Dialogue: 0,0:21:16.48,0:21:20.78,Default,,0,0,0,,‫قبل أن يفضح كل شيء.
Dialogue: 0,0:21:20.78,0:21:23.68,Default,,0,0,0,,‫لم يكن عليه أن يبني غرفة الشاي تلك.
Dialogue: 0,0:21:25.78,0:21:30.18,Default,,0,0,0,,‫انظروا! يحدث تمامًا كما تقول الأسطورة، أليس كذلك؟
Dialogue: 0,0:23:06.58,0:23:09.08,Default,,0,0,0,,‫لقد أصبح الليل.
Dialogue: 0,0:23:09.08,0:23:11.68,Default,,0,0,0,,‫يمكنني أن أوصلكم إلى محطة،
Dialogue: 0,0:23:11.68,0:23:13.78,Default,,0,0,0,,‫أو إلى نُزل ينابيع ساخنة إن شئتم.
Dialogue: 0,0:23:13.78,0:23:15.58,Default,,0,0,0,,‫سأكون ممتنًا جدًا!
Dialogue: 0,0:23:15.58,0:23:17.38,Default,,0,0,0,,‫مع أنه جعل الأمر يبدو وكأنه يتماشى مع الأسطورة،
Dialogue: 0,0:23:17.38,0:23:20.58,Default,,0,0,0,,‫فأنا بدأت أظنّ
Dialogue: 0,0:23:20.58,0:23:23.18,Default,,0,0,0,,‫أن هناك وحشًا فعلًا.
Dialogue: 0,0:23:23.18,0:23:25.08,Default,,0,0,0,,‫حسنًا، بما أن ذلك حدث منذ زمن بعيد،
Dialogue: 0,0:23:25.08,0:23:28.08,Default,,0,0,0,,‫فربما كان هناك أفعى عملاقة على الأقل؟
Dialogue: 0,0:23:28.08,0:23:30.28,Default,,0,0,0,,‫لكن لا بأس.
Dialogue: 0,0:23:30.28,0:23:31.48,Default,,0,0,0,,‫إن خرجت تزحف،
Dialogue: 0,0:23:31.48,0:23:34.78,Default,,0,0,0,,‫فكل ما علينا فعله هو الإمساك بها ونزع جلدها.
Dialogue: 0,0:23:40.98,0:23:43.28,Default,,0,0,0,,‫ما بكم يا رفاق؟
Dialogue: 0,0:23:43.28,0:23:44.68,Default,,0,0,0,,‫-ذلك… -ذلك…
Dialogue: 0,0:23:52.38,0:23:53.98,Default,,0,0,0,,‫إنها أفعى!
Dialogue: 0,0:23:55.68,0:23:59.38,Default,,0,0,0,,‫مرحبًا! ألم تقل إنه لا مشكلة؟
Dialogue: 0,0:24:03.64,0:24:05.34,Default,,0,0,0,,‫تلميح كونان للحلقة القادمة:
Dialogue: 0,0:24:05.90,0:24:07.24,Default,,0,0,0,,‫"الصيّاد"
Dialogue: 0,0:24:07.68,0:24:09.38,Default,,0,0,0,,‫في الحلقة القادمة، فرقة المحققين الصغار تبذل كل ما لديها.
Dialogue: 0,0:24:09.40,0:24:11.32,Default,,0,0,0,,‫كونان، نعتمد عليك في الحلقة القادمة.
Dialogue: 0,0:24:11.44,0:24:12.80,Default,,0,0,0,,‫حسنًا!
