Dialogue: 0,0:00:01.83,0:00:04.42,Default,,0,0,0,, في يوم الاباء بمدرسة تيتان الابتدائية
Dialogue: 0,0:00:05.53,0:00:11.30,Default,,0,0,0,,سوية مع فريق المتحرين الصغار \Nمررنا بمتجر لشراء بعض الادوات المدرسية
Dialogue: 0,0:00:12.97,0:00:16.10,Default,,0,0,0,,وهناك صادفنا زميلتنا ماريا هيغاشيو
Dialogue: 0,0:00:14.24,0:00:16.12,sign_suspect,SIGN,0000,0000,0000,,{\pos(320,254)}هيغاشيو ماريا (7)
Dialogue: 0,0:00:14.24,0:00:16.12,sign_suspect,SIGN,0000,0000,0000,,{\fs14\pos(320,271)}الصف 1-ب
Dialogue: 0,0:00:16.12,0:00:18.37,sign_suspect,SIGN,0000,0000,0000,,{\pos(250,255)}ساكاموتو تاكوما (7)
Dialogue: 0,0:00:16.12,0:00:18.37,sign_suspect,SIGN,0000,0000,0000,,{\fs14\pos(250,272)}الصف 1-ب
Dialogue: 0,0:00:17.06,0:00:18.16,Default,,0,0,0,,وتاكوما ساكاموتو
Dialogue: 0,0:00:19.64,0:00:23.22,Default,,0,0,0,,وايضا الطالب المنقول كايسوكي دانو 
Dialogue: 0,0:00:21.00,0:00:23.25,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\pos(264,255)}دانو كايسوكي (7)
Dialogue: 0,0:00:21.00,0:00:23.25,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\fs14\pos(264,272)}الصف 1-أ
Dialogue: 0,0:00:24.22,0:00:27.77,Default,,0,0,0,,اشترى كلا من هايبرا وماريا وتاكوما ادوات مدرسية
Dialogue: 0,0:00:28.40,0:00:33.45,Default,,0,0,0,,دانو كان ينظر الى أحد الوجبات الخفيفة \Nولكنه خرج من المتجر دون شراء اي شيئ
Dialogue: 0,0:00:38.12,0:00:44.20,Default,,0,0,0,,في المدرسة كان دانو يحكي لزملائه في الصف \Nقصة روح الصف الاكلة للبشر
Dialogue: 0,0:00:45.12,0:00:50.08,Default,,0,0,0,,وقال ان تلك الروح انتقلت لمدرسة تيتان
Dialogue: 0,0:00:51.21,0:00:54.35,Default,,0,0,0,,عندما سمع فريق المتحرين الصغار ذلك اخبروه بأنها كذبة
Dialogue: 0,0:00:54.36,0:01:05.06,Default,,0,0,0,,ولكن دانو قال بأن الروح قامت بتكسير المزهريات \Nوفتحت باب خزانة المكانس فجأة واحرقت حوض الزهور في المدارس
Dialogue: 0,0:01:06.48,0:01:09.40,Default,,0,0,0,,اثناء تنفيذ المهام اليومية بعد استراحة الغداء
Dialogue: 0,0:01:09.98,0:01:13.74,Default,,0,0,0,,لاحظ ميتسيهكو احتراق حوض الزهور المواجهة للصف
Dialogue: 0,0:01:15.53,0:01:17.61,Default,,0,0,0,,اثناء ذهابي لجلب مطفأة حريق
Dialogue: 0,0:01:17.61,0:01:21.00,Default,,0,0,0,,كانت هايبرا قد أطفأتها بماء مزهرية الصف
Dialogue: 0,0:01:21.90,0:01:27.25,Default,,0,0,0,,ولكن دانو الذي رأى ماحصل قال بأن روح الصف \Nالاكلة للبشر حقيقية
Dialogue: 0,0:01:30.00,0:01:34.18,Default,,0,0,0,,استنتجت أنه تم استخدام اداة ما للاشتعال الذاتي
Dialogue: 0,0:01:35.85,0:01:38.13,Default,,0,0,0,,ولكني لم أجد اي اثر لما يثبت ذلك
Dialogue: 0,0:01:39.80,0:01:42.00,Default,,0,0,0,,من يملك دافعا لفعل ذلك هم ثلاثة
Dialogue: 0,0:01:42.85,0:01:45.98,Default,,0,0,0,,دانو صاحب قصة الصف الاكل للبشر
Dialogue: 0,0:01:48.00,0:01:52.11,Default,,0,0,0,,وتاكوما الذي كان يحدق بحوض الزهور في استراحة الغداء
Dialogue: 0,0:01:53.89,0:02:01.37,Default,,0,0,0,,وماريا التي لن تضطر والدتها المتعبة للحضور\Nان تم الغاء يوم الاباء بسبب الحادثة
Dialogue: 0,0:02:03.95,0:02:06.87,Default,,0,0,0,,في حين أن الوقت المتبقي لقدوم الاباء يقل
Dialogue: 0,0:02:07.25,0:02:12.49,Default,,0,0,0,,الا اني قطعت وعدا بحل هذه القضية خلال فترة الاستراحة
Dialogue: 0,0:02:15.76,0:02:18.76,Default,,0,0,0,,هايبرا ألا تملكين 10 ين؟
Dialogue: 0,0:02:19.89,0:02:20.76,Default,,0,0,0,,10ين؟
Dialogue: 0,0:02:21.36,0:02:25.64,Default,,0,0,0,,ان كانت 100ين فنعم ولكني لا أملك 10 ين
Dialogue: 0,0:02:26.98,0:02:29.35,Default,,0,0,0,,اذا ماذا عنك ماريا؟ الا تملكينها؟
Dialogue: 0,0:02:30.09,0:02:30.99,Default,,0,0,0,,أنا؟
Dialogue: 0,0:02:31.80,0:02:37.30,Default,,0,0,0,,ان اردت فانا اعتقد ان املك بعض العملات من فئة ال100 وال50
Dialogue: 0,0:02:37.88,0:02:39.70,Default,,0,0,0,,ماذا عنك تاكوما؟
Dialogue: 0,0:02:40.20,0:02:46.16,Default,,0,0,0,,لقد كنت امتلك عملتين من ال10 ولكنني استخدمتهما \Nعند شرائي الدفتر سابقا
Dialogue: 0,0:02:46.16,0:02:48.16,Default,,0,0,0,,حيث كان ب320 ين
Dialogue: 0,0:02:48.16,0:02:49.41,Default,,0,0,0,,هكذا اذا
Dialogue: 0,0:02:50.17,0:02:54.34,Default,,0,0,0,,لا أعلم ما القصة ولكن باستطاعتي اعارتك 10ين 
Dialogue: 0,0:02:54.42,0:02:56.42,Default,,0,0,0,,فأنا املكها
Dialogue: 0,0:02:56.42,0:02:58.42,Default,,0,0,0,,لا ,لاحاجة لها
Dialogue: 0,0:02:59.90,0:03:01.72,Default,,0,0,0,,لاني عرفت الجاني
Dialogue: 0,0:03:05.00,0:03:08.40,Default,,0,0,0,,عرفت الجاني؟ من يكون؟
Dialogue: 0,0:03:08.62,0:03:10.35,Default,,0,0,0,,سأخبرك بالطبع
Dialogue: 0,0:03:11.25,0:03:15.40,Default,,0,0,0,,قبل اختفاء الخدعة والدليل
Dialogue: 0,0:03:19.32,0:03:21.11,Default,,0,0,0,,مالذي تخفيه خلف قناعك المحكم؟
Dialogue: 0,0:03:21.40,0:03:23.70,Default,,0,0,0,,الفصل المشتت من احتراق حوض الزهور
Dialogue: 0,0:03:23.78,0:03:25.47,Default,,0,0,0,,اجتماع الاباء على وشك التأجيل
Dialogue: 0,0:03:25.48,0:03:27.05,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:03:27.05,0:03:28.90,Default,,0,0,0,,،بجسد طفل وعقل بالغ
Dialogue: 0,0:03:28.90,0:03:31.45,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:03:31.95,0:03:35.04,DCOpening,,0,0,0,,!جدي، فضولي، غامض، يقودنا نحو المستقبل
Dialogue: 0,0:03:35.04,0:03:38.36,DCOpening,,0,0,0,,بالتأكيد يمكنك كشف هذه الأجزاء الملونة التي تحوم حول قلبي ، أليس كذلك؟
Dialogue: 0,0:03:38.36,0:03:40.03,DCOpening,,0,0,0,,هذا الوجه البارد
Dialogue: 0,0:03:40.03,0:03:41.57,DCOpening,,0,0,0,,لا يمكنك خداع عيناي
Dialogue: 0,0:03:41.57,0:03:42.84,DCOpening,,0,0,0,,لا يمكنك الهروب من قدرك
Dialogue: 0,0:03:42.84,0:03:44.84,DCOpening,,0,0,0,,...لذا اتبعني اتبعني اتبعني
Dialogue: 0,0:03:44.84,0:03:45.70,DCOpening,,0,0,0,,لكنك بطريق الخطأ وبخبث
Dialogue: 0,0:03:45.70,0:03:48.04,DCOpening,,0,0,0,,,أمسكت بالدليل، انظر
Dialogue: 0,0:03:48.04,0:03:51.46,DCOpening,,0,0,0,,لا أستطيع التوقف الآن، أريد أن أتعقبه حتى النهاية
Dialogue: 0,0:03:51.46,0:03:54.55,DCOpening,,0,0,0,,لن أخيب ظن أحد لا تستخف بي كمجرد صبي
Dialogue: 0,0:03:54.54,0:03:57.71,DCOpening,,0,0,0,,هذه المفاهيم المسبقة ليست سوى خدع طفولية
Dialogue: 0,0:03:57.92,0:04:00.77,DCOpening,,0,0,0,,أعلم أنك تريدني، ولن أخذلك أبدًا
Dialogue: 0,0:04:00.78,0:04:03.76,DCOpening,,0,0,0,,في الحقيقة...
Dialogue: 0,0:04:04.26,0:04:07.50,DCOpening,,0,0,0,,أعلم أنك تكرهني ومع ذلك، لم أستطع لن أتركك أبدًا
Dialogue: 0,0:04:07.50,0:04:11.14,DCOpening,,0,0,0,,أرني مشاعرك الحقيقية؟
Dialogue: 0,0:04:11.97,0:04:12.85,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:04:18.50,0:04:19.99,DCOpening,,0,0,0,,!انطلق
Dialogue: 0,0:04:25.11,0:04:28.66,DCOpening,,0,0,0,,النهاية السعيدة المثالية
Dialogue: 0,0:04:28.66,0:04:31.75,DCOpening,,0,0,0,,ابتسامة لتجنب الألم، قلبي ينفتح عند 4869
Dialogue: 0,0:04:31.74,0:04:35.29,DCOpening,,0,0,0,,قبلة سرية أطلقت في البحر مشاعر ما زالت تحتل قلبي
Dialogue: 0,0:04:35.29,0:04:38.58,DCOpening,,0,0,0,,افتح قلبي أيضًا أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:04:43.40,0:04:45.72,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:04:49.87,0:04:51.87,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:04:56.09,0:04:56.76,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:05:12.95,0:05:18.96,sign_episode_title,SIGN,0000,0000,0000,,{\fad(400,1)\pos(320,40)}لغز الصف آكل البشر\Nالجزء الثاني
Dialogue: 0,0:05:13.59,0:05:16.87,Default,,0,0,0,,"!لغز الصف آكل البشر،\Nالجزء الثاني"
Dialogue: 0,0:05:22.75,0:05:24.25,Default,,0,0,0,,ماذا تظن يا يو؟
Dialogue: 0,0:05:24.25,0:05:27.11,Default,,0,0,0,,لقد عدت لكوني ايدوغاوا فومي بعد مدة!
Dialogue: 0,0:05:28.51,0:05:31.41,Default,,0,0,0,,بهذا الزي خدعتي شينتشي سابقا صحيح؟
Dialogue: 0,0:05:34.51,0:05:35.71,Default,,0,0,0,,يالها من ذكريات
Dialogue: 0,0:05:35.72,0:05:37.21,Default,,0,0,0,,صحيح؟
Dialogue: 0,0:05:37.61,0:05:41.76,Default,,0,0,0,,ولكن هل حقا ستذهبين بهذا التنكر الى اجتماع الاباء؟
Dialogue: 0,0:05:42.84,0:05:45.34,Default,,0,0,0,,الا يمكنك التنكر بجسدك العادي؟
Dialogue: 0,0:05:45.34,0:05:46.68,Default,,0,0,0,,لا يمكنني
Dialogue: 0,0:05:47.34,0:05:55.43,Default,,0,0,0,,فهناك احتمال ان يلتقط احد الاباء صورة لي \Nعن طريق الخطأ وقد يراها كوغورو او ران بالصدفة
Dialogue: 0,0:05:56.94,0:06:00.34,Default,,0,0,0,,اليست تبدو مختلفة عن والدة كونان التي قابلناها سابقا؟
Dialogue: 0,0:06:00.34,0:06:01.84,Default,,0,0,0,,هذا ماقد يحصل صحيح؟
Dialogue: 0,0:06:02.93,0:06:04.36,Default,,0,0,0,,هذا صحيح
Dialogue: 0,0:06:04.60,0:06:07.02,Default,,0,0,0,,سأحرص على تغيير صوتي ايضا لذا لا تقلق
Dialogue: 0,0:06:07.61,0:06:13.36,Default,,0,0,0,,ولكن من حسن حظنا ان اكاي\N لديه اجتماع مع عملاء الاستخبارات خارج المنزل
Dialogue: 0,0:06:13.93,0:06:20.29,Default,,0,0,0,,حيث انه سيكون من الصعب تبرير سبب ذهابك متنكرة\N الى يوم اجتماع الاباء في مدرسة كونان
Dialogue: 0,0:06:20.30,0:06:21.37,Default,,0,0,0,,انت محق
Dialogue: 0,0:06:21.90,0:06:26.55,Default,,0,0,0,,اني اتسائل الى متى سيواصل اخفاء هويته عن اكاي
Dialogue: 0,0:06:27.00,0:06:30.50,Default,,0,0,0,,ولكني اشعر بأن اكاي قد ادرك الامر
Dialogue: 0,0:06:30.84,0:06:32.50,Default,,0,0,0,,ولكن هل ذلك صحيح؟
Dialogue: 0,0:06:32.88,0:06:35.53,Default,,0,0,0,,المعلمة المساعدة المدعوة بأكاسا 
Dialogue: 0,0:06:35.60,0:06:39.31,Default,,0,0,0,,كانت سابقا الحارسة الشخصية للمليونيرة المتوفاة
Dialogue: 0,0:06:39.32,0:06:44.32,Default,,0,0,0,,لذا قد تكون تنوي الانتقام من أحد اعضاء المنظمة التي يلاحقها شين
Dialogue: 0,0:06:44.48,0:06:45.15,Default,,0,0,0,,نعم
Dialogue: 0,0:06:45.56,0:06:53.60,Default,,0,0,0,,اغلب الظن انها هي من كانت تنشرالمعلومات\Nالتي تخص قضية هانيدا كوجي باستمرار
Dialogue: 0,0:06:53.79,0:06:56.80,Default,,0,0,0,,ساعية للايقاع بأحد اعضاء المنظمة
Dialogue: 0,0:06:56.73,0:07:01.23,sign_1170_news_pc,SIGN,0000,0000,0000,,{\pos(305,136)\an9}الموت الغامض\Nلعبقري كيشي
Dialogue: 0,0:06:57.12,0:07:01.03,Default,,0,0,0,,عندها لفت نظرها الدخول المتكرر على الموقع لاحدهم
Dialogue: 0,0:07:01.37,0:07:06.88,Default,,0,0,0,,تعقبته وتوصلت الى حاسوب البروفيسور اغاسا وبالتالي ابننا ايدوغاوا كونان
Dialogue: 0,0:07:07.24,0:07:11.74,sign_1170_chalkboard,SIGN,0000,0000,0000,,{\frz270\an1\pos(549,98)}واكاسا رومي
Dialogue: 0,0:07:07.55,0:07:11.68,Default,,0,0,0,,ولتتقرب منه انضمت الى ابتدائية تيتان
Dialogue: 0,0:07:12.15,0:07:15.71,Default,,0,0,0,,هذا ما توصلت اليه انا واكاي
Dialogue: 0,0:07:15.90,0:07:18.00,Default,,0,0,0,,وهل يعلم بذلك شين؟
Dialogue: 0,0:07:18.17,0:07:21.81,Default,,0,0,0,,انه يعلم بل ويشاطرنا ذات الرأي
Dialogue: 0,0:07:22.14,0:07:22.90,Default,,0,0,0,,هكذا اذا
Dialogue: 0,0:07:23.61,0:07:27.44,Default,,0,0,0,,لكن من الجيد ان تلك المعلمة ليست بشخص سيئ
Dialogue: 0,0:07:27.74,0:07:30.14,Default,,0,0,0,,لا , لايجب عليك خفض حذرك
Dialogue: 0,0:07:31.00,0:07:35.30,Default,,0,0,0,,قد تكون ممن لا تهمهم الوسيلة في تحقيق أهدافهم
Dialogue: 0,0:07:35.71,0:07:43.90,Default,,0,0,0,,قد يكون سبب بقاءها كمعلمة مساعدة هو ان الشخص \Nالذي ترغب بالانتقام منه يوجد في محيط ابننا
Dialogue: 0,0:07:43.90,0:07:47.80,Default,,0,0,0,,وربما قد يكون سبب أكبر من هذا حتى
Dialogue: 0,0:07:47.80,0:07:54.88,Default,,0,0,0,,على اي حال, اذهبي الى المدرسة وخذي حذرك\Nان قابلتي المعلمة واكاسا
Dialogue: 0,0:07:54.88,0:07:56.88,Default,,0,0,0,,انت محق
Dialogue: 0,0:07:56.88,0:07:58.00,Default,,0,0,0,,اذا؟
Dialogue: 0,0:07:58.26,0:08:04.52,Default,,0,0,0,,لم تقاطعي عملي لتريني تنكرك فحسب اليس كذلك؟
Dialogue: 0,0:08:05.58,0:08:07.11,Default,,0,0,0,,اوه صحيح لقد تذكرت!
Dialogue: 0,0:08:07.69,0:08:10.23,Default,,0,0,0,,لقد كنت تملك جهاز لوحي اليس كذلك؟
Dialogue: 0,0:08:10.43,0:08:14.43,Default,,0,0,0,,نعم ,على ماذكر انه يوجد في درج مكتبي
Dialogue: 0,0:08:15.92,0:08:18.82,Default,,0,0,0,,هل هناك ماترغبين بالبحث عنه قبل اجتماع الاباء؟
Dialogue: 0,0:08:20.62,0:08:21.96,Default,,0,0,0,,يمكنك قول ذلك
Dialogue: 0,0:08:23.66,0:08:27.75,Default,,0,0,0,,اولا ,كيف استطاع الجاني اشعال النيران في هذا الحوض
Dialogue: 0,0:08:28.56,0:08:36.80,Default,,0,0,0,,اشتعلت النيران بعد انتهاءنا من تناولنا للغداء مباشرة \Nلذا من غير المرجح ان احدهم قام باشعالها بنفسه
Dialogue: 0,0:08:37.35,0:08:44.02,Default,,0,0,0,,اما انه انهى طعامه بسرعة وركض بأقصى سرعته\Nمن باب الطوارئ الى حوض الزهور
Dialogue: 0,0:08:44.60,0:08:52.70,Default,,0,0,0,,او انه خرج اثناء الاستراحة من نافذة\N الصف خلسة واقترب من حوض الزهور واشعله
Dialogue: 0,0:08:52.70,0:09:00.16,Default,,0,0,0,,ولكن لابد من ان يراه شخص ما\Nوبما انه لم يخبرنا احد برؤيته فسنستبعد هذا الاحتمال
Dialogue: 0,0:09:01.00,0:09:02.16,Default,,0,0,0,,اذا كما توقعنا
Dialogue: 0,0:09:02.16,0:09:04.16,Default,,0,0,0,,صحيح, تبقى شيء واحد
Dialogue: 0,0:09:06.29,0:09:07.88,Default,,0,0,0,,الاشتعال الذاتي
Dialogue: 0,0:09:09.67,0:09:13.67,Default,,0,0,0,,قام الجاني بتجهيز خدعة بحيث تشتعل ذاتيا في وقت محدد
Dialogue: 0,0:09:13.88,0:09:20.84,Default,,0,0,0,,ولكن لم يكن هناك اي خدعة كهذه عندما \Nقفزت من النافذة لاطفاء النار بماء المزهرية
Dialogue: 0,0:09:21.18,0:09:23.18,Default,,0,0,0,,الم تقومي بإسقاطه آنذاك؟
Dialogue: 0,0:09:23.18,0:09:26.44,Default,,0,0,0,,ذاك الاصيص ذو الدعامات
Dialogue: 0,0:09:27.03,0:09:31.19,Default,,0,0,0,,وعندما قلبت الاصيص وجدت تحته هذا
Dialogue: 0,0:09:32.03,0:09:33.94,Default,,0,0,0,,حبة بطاطس محروقة
Dialogue: 0,0:09:35.95,0:09:37.55,Default,,0,0,0,,لماذا يوجد بطاطس؟
Dialogue: 0,0:09:37.55,0:09:39.45,Default,,0,0,0,,الم يكن الجاني يأكلها؟
Dialogue: 0,0:09:39.86,0:09:43.47,Default,,0,0,0,,صحيح! لانه تسلل من استراحة الغداء!
Dialogue: 0,0:09:43.47,0:09:44.67,Default,,0,0,0,,كلا , كلا
Dialogue: 0,0:09:45.00,0:09:49.69,Default,,0,0,0,,البطاطس تقلى بالزيت لذا تستخدم في التخييم وماشابه
Dialogue: 0,0:09:50.42,0:09:52.12,Default,,0,0,0,,كمادة مساعدة لاشتعال
Dialogue: 0,0:09:52.18,0:09:55.63,Default,,0,0,0,,كما انها بطاطس لذا تستمر بالاشتعال لمدة دقيقة
Dialogue: 0,0:09:56.55,0:09:57.37,Default,,0,0,0,,حقا؟
Dialogue: 0,0:09:57.38,0:09:58.28,Default,,0,0,0,,نعم
Dialogue: 0,0:09:58.57,0:10:03.00,Default,,0,0,0,,على ذكر هذا ,الم يكن هناك احدهم \Nعلى وشك شراء البطاطس من المتجر صباح اليوم؟
Dialogue: 0,0:10:03.00,0:10:04.00,Default,,0,0,0,,صحيح
Dialogue: 0,0:10:04.02,0:10:05.57,Default,,0,0,0,,لقد كان من الصف المجاور
Dialogue: 0,0:10:05.57,0:10:07.57,Default,,0,0,0,,الطالب المنقول الذي يدعى بدانو
Dialogue: 0,0:10:08.77,0:10:10.61,Default,,0,0,0,,لقد كنت انت الجاني
Dialogue: 0,0:10:10.62,0:10:12.07,Default,,0,0,0,,انت مخطئ
Dialogue: 0,0:10:12.38,0:10:15.10,Default,,0,0,0,,وايضا كنت انظر للبطاطس فقط ولم اشتريها
Dialogue: 0,0:10:15.12,0:10:17.99,Default,,0,0,0,,لا تتهمني كذبا ايها الاحمق!
Dialogue: 0,0:10:17.99,0:10:19.22,Default,,0,0,0,,مالذي قلته!
Dialogue: 0,0:10:19.45,0:10:24.95,Default,,0,0,0,,ليس من الضروري شراءه من المتجر\Nفشيء كالبطاطس بإمكانك احضاره من المنزل
Dialogue: 0,0:10:24.95,0:10:30.75,Default,,0,0,0,,ولكن حتى وان كانت البطاطس مساعدة للاشتعال \Nكيف قام بإشعال النار فالمقام الاول؟
Dialogue: 0,0:10:30.75,0:10:34.85,Default,,0,0,0,,المفتاح لحل هذه المعضلة هو بالاصيص\Nالذي قامات هايبرا باسقاطه حين اطفأت النار
Dialogue: 0,0:10:34.88,0:10:37.68,Default,,0,0,0,,وتحديدا دعامة الزهور هذه
Dialogue: 0,0:10:38.22,0:10:41.92,Default,,0,0,0,,رغم اشتعالها الا انه لايوجد اثار لوجود الازهار عليها صحيح؟
Dialogue: 0,0:10:42.78,0:10:44.14,Default,,0,0,0,,انت محق!
Dialogue: 0,0:10:45.68,0:10:51.28,Default,,0,0,0,,بمعنى اخر قام الجاني بفصل الدعامة عن الازهار مسبقا وثبتها بهذا الشكل
Dialogue: 0,0:10:51.28,0:10:54.27,Default,,0,0,0,,وقام بوضع البطاطس اسفل الدعامة
Dialogue: 0,0:10:55.02,0:10:55.62,Default,,0,0,0,,انظروا
Dialogue: 0,0:10:56.15,0:11:00.27,Default,,0,0,0,,هناك شيء معين ان وضع هنا فسيجعل اشعة الشمس تشعل النار
Dialogue: 0,0:11:05.95,0:11:07.45,Default,,0,0,0,,عدسة تكبير!
Dialogue: 0,0:11:07.45,0:11:08.75,Default,,0,0,0,,أحسنتم!
Dialogue: 0,0:11:11.46,0:11:14.71,Default,,0,0,0,,ولكن لم يكن هناك ما يشبه عدسة التكبير في الجوار
Dialogue: 0,0:11:14.95,0:11:17.05,Default,,0,0,0,,لانها ليست مجرد عدسة تكبير عادية
Dialogue: 0,0:11:17.55,0:11:22.25,Default,,0,0,0,,ان كانت مصنوعة من الثلج فمع مرور الوقت ستذوب وتختفي صحيح؟
Dialogue: 0,0:11:25.05,0:11:26.35,Default,,0,0,0,,عدسة مكبرة..
Dialogue: 0,0:11:26.35,0:11:27.68,Default,,0,0,0,,..مصنوعة من الثلج؟
Dialogue: 0,0:11:27.68,0:11:28.81,Default,,0,0,0,,أجل
Dialogue: 0,0:11:29.08,0:11:30.98,Default,,0,0,0,,وطريقة صناعتها سهلة جدا
Dialogue: 0,0:11:31.68,0:11:36.38,Default,,0,0,0,,بإضافة الماء في وعاء دائري بسماكة 1 او 2 سم
Dialogue: 0,0:11:36.38,0:11:44.20,Default,,0,0,0,,غلفه بغطاء بلاستيكي وضع فوقه منشفة جافة او غطاء عازل\Nواحكم ربطه باستخدام المطاط
Dialogue: 0,0:11:44.90,0:11:51.00,Default,,0,0,0,,وبعد حفظه في مجمد الثلاجة لما يزيد عن اليوم وتجميده ببطء
Dialogue: 0,0:11:52.23,0:11:54.75,Default,,0,0,0,,ضع الوعاء في ماء حار 
Dialogue: 0,0:11:55.00,0:11:57.00,Default,,0,0,0,,وبعد ان تخرجها
Dialogue: 0,0:11:57.74,0:12:01.44,Default,,0,0,0,,تكون قد حصلت على عدسة مكبرة بنجاح!
Dialogue: 0,0:12:03.88,0:12:09.31,Default,,0,0,0,,وان قمت بتجهيز الخدعة بعد انتهاء\Nالحصة الرابعة وقبل بدء استراحة الغداء
Dialogue: 0,0:12:09.80,0:12:12.31,Default,,0,0,0,,ووضعت العدسة المكبرة على الدعامة هذه
Dialogue: 0,0:12:12.51,0:12:19.41,Default,,0,0,0,,ووضعت بعض البطاطس أسفلها وغطيتها \Nبغلاف اسود بحيث يسهل اشتعالها
Dialogue: 0,0:12:14.92,0:12:18.75,Default,,0,0,0,,وتغطيتها بأوراق أوريغامي سوداء\Nحتى تشتعل بسهولة أكبر.
Dialogue: 0,0:12:18.75,0:12:24.14,Default,,0,0,0,,اضبط وضعية وأرجل الحامل
Dialogue: 0,0:12:24.14,0:12:28.79,Default,,0,0,0,,...حتى يتم تركيز ضوء الشمس على الأوريغامي قرب نهاية فترة الغداء
Dialogue: 0,0:12:29.76,0:12:33.63,Default,,0,0,0,,.وسوف تشتعل أحواض الزهور قرب نهاية الغداء
Dialogue: 0,0:12:34.36,0:12:39.86,Default,,0,0,0,,لكن ألن يستغرق ذلك وقتًا حتى تذوب عدسة جليدية بهذا الحجم؟
Dialogue: 0,0:12:40.19,0:12:41.62,Default,,0,0,0,,.استخدم عملات الـ10 ين
Dialogue: 0,0:12:41.95,0:12:43.99,Default,,0,0,0,,ع-عملة الـ10 ين؟
Dialogue: 0,0:12:44.37,0:12:50.25,Default,,0,0,0,,.عملات الـ10 ين تحتوي على 95% نحاس،\Nلذا فهي موصلة جيدة للحرارة
Dialogue: 0,0:12:50.66,0:12:51.90,Default,,0,0,0,,.صحيح
Dialogue: 0,0:12:51.90,0:12:57.71,Default,,0,0,0,,لذا إذا قمت بتسخين مجموعة من عملات الـ10 ين\Nبوضعها في جيبك
Dialogue: 0,0:12:57.71,0:13:01.38,Default,,0,0,0,,,ووضعت عدسة جليدية بداخلها
Dialogue: 0,0:13:01.38,0:13:05.87,Default,,0,0,0,,.حتى العدسة الجليدية الكبيرة\Nستذوب أمام عينيك
Dialogue: 0,0:13:06.62,0:13:07.89,Default,,0,0,0,,...أليس كذلك
Dialogue: 0,0:13:09.59,0:13:10.78,Default,,0,0,0,,هايبرا؟
Dialogue: 0,0:13:16.86,0:13:23.10,Default,,0,0,0,,.عملات الـ10 ين تحتوي على 95% نحاس،\Nلذا فهي موصلة جيدة للحرارة
Dialogue: 0,0:13:23.10,0:13:24.39,Default,,0,0,0,,.صحيح
Dialogue: 0,0:13:24.39,0:13:30.25,Default,,0,0,0,,لذا إذا قمت بتسخين مجموعة من عملات الـ10 ين\Nبوضعها في جيبك
Dialogue: 0,0:13:30.25,0:13:33.88,Default,,0,0,0,,,ووضعت عدسة جليدية بداخلها
Dialogue: 0,0:13:33.88,0:13:38.38,Default,,0,0,0,,.حتى العدسة الجليدية الكبيرة\Nستذوب أمام عينيك
Dialogue: 0,0:13:39.11,0:13:40.38,Default,,0,0,0,,...أليس كذلك
Dialogue: 0,0:13:42.11,0:13:43.39,Default,,0,0,0,,هايبارا؟
Dialogue: 0,0:13:46.15,0:13:47.89,Default,,0,0,0,,!لقد كانت هايبارا؟
Dialogue: 0,0:13:59.21,0:14:02.01,Default,,0,0,0,,!هذا صحيح! أنا من أشعلت النار
Dialogue: 0,0:14:02.01,0:14:03.41,Default,,0,0,0,,أنا آسفة، حسنًا؟
Dialogue: 0,0:14:04.06,0:14:05.91,Default,,0,0,0,,أنت غاضبة مني؟
Dialogue: 0,0:14:05.91,0:14:07.91,Default,,0,0,0,,!ليس خطأ آي؟
Dialogue: 0,0:14:09.41,0:14:13.84,Default,,0,0,0,,.آي-تشان كانت فقط تنفذ\Nما طلبته منها
Dialogue: 0,0:14:14.42,0:14:21.09,Default,,0,0,0,,.طلبت منها إلغاء زيارة الصف حتى لا تضطر أمي للحضور رغم مرضها
Dialogue: 0,0:14:28.88,0:14:32.10,Default,,0,0,0,,...أوه، صحيح. أمك
Dialogue: 0,0:14:32.10,0:14:37.61,Default,,0,0,0,,.لقد أصيبت بظهرها عندما أجهدت نفسها لحضور حفلة الموسيقى الأخيرة
Dialogue: 0,0:14:37.61,0:14:40.41,Default,,0,0,0,,.كنت أعلم ذلك
Dialogue: 0,0:14:40.86,0:14:46.38,Default,,0,0,0,,.على أي حال، أنا منبهرة أنك اكتشفت أن هايبرا  هي الفاعلة
Dialogue: 0,0:14:46.38,0:14:49.87,Default,,0,0,0,,.عرفت ذلك بسبب قلم الرصاص الآلي الذي استعرته من هايبرا
Dialogue: 0,0:14:50.71,0:14:54.29,Default,,0,0,0,,،هايبارا اشترت هذا الصباح قلم رصاص\Nمن نوع B من المتجر
Dialogue: 0,0:14:54.78,0:14:59.26,Default,,0,0,0,,.لكنها أعارتني قلمًا من نوع HB كان رطبًا
Dialogue: 0,0:15:00.52,0:15:04.88,Default,,0,0,0,,،عندما أزلت العدسة الجليدية المخزنة مع عبوات ثلجية داخل حاوية في مكتبها
Dialogue: 0,0:15:04.88,0:15:07.95,Default,,0,0,0,,.لا بد أن بعض قطرات الماء سقطت
Dialogue: 0,0:15:07.95,0:15:13.19,Default,,0,0,0,,.تسربت إلى علبة أقلام الرصاص داخل حافظة أقلام هايبرا القماشية
Dialogue: 0,0:15:13.68,0:15:18.19,Default,,0,0,0,,،بالإضافة إلى ذلك، هايبارا اشترت رصاصًا بقيمة 258 ينًا باستخدام ورقة ألف ين
Dialogue: 0,0:15:18.50,0:15:22.69,Default,,0,0,0,,،وماريا اشترت شريطًا بقيمة 302 ين باستخدام عملة 500 ين
Dialogue: 0,0:15:23.28,0:15:27.32,Default,,0,0,0,,.لذا كان يجب أن يكون مع كلتيهما أربع عملات من فئة 10 ين
Dialogue: 0,0:15:27.75,0:15:33.47,Default,,0,0,0,,،ولكن عندما طلبت استعارة واحدة لفتح غطاء البطارية في مؤقت المطبخ
Dialogue: 0,0:15:33.47,0:15:37.83,Default,,0,0,0,,.قالتا كلتاهما أنهما لا تملكان عملات 10 ين دون حتى فتح محفظتيهما
Dialogue: 0,0:15:38.42,0:15:42.34,Default,,0,0,0,,.بالإضافة إلى ذلك، لسبب ما، كانت هايبرا تبقي يدها اليسرى في جيبها
Dialogue: 0,0:15:42.79,0:15:44.46,Default,,0,0,0,,...هكذا عرفت
Dialogue: 0,0:15:45.15,0:15:48.64,Default,,0,0,0,,،أن هايبرا وماريا تعاونتا لإشعال الحريق
Dialogue: 0,0:15:48.64,0:15:52.48,Default,,0,0,0,,،واستعادتاً العدسة الجليدية عندما قفزت هايبرا لإطفاء الحريق
Dialogue: 0,0:15:52.48,0:15:56.60,Default,,0,0,0,,.وكانتاً تحاولان إتلاف الأدلة عن طريق إذابتها في جيبها
Dialogue: 0,0:15:58.60,0:16:01.79,Default,,0,0,0,,...بناءً على رد فعلهما، ربما شعرتما بالخوف
Dialogue: 0,0:16:01.79,0:16:06.33,Default,,0,0,0,,.لأن الحريق كان أكبر مما توقعتما
Dialogue: 0,0:16:06.86,0:16:12.01,Default,,0,0,0,,.إذن لم يكن ذلك الوغد من الصف المجاور
Dialogue: 0,0:16:12.01,0:16:16.40,Default,,0,0,0,,لا. أيضًا، تلك القصة المرعبة عن الصف آكل البشر
Dialogue: 0,0:16:16.40,0:16:21.00,Default,,0,0,0,,.ربما اختلقها أصدقاء دانو في مدرسته القديمة
Dialogue: 0,0:16:21.57,0:16:24.70,Default,,0,0,0,,خزانات أدوات التنظيف والمزهريات
Dialogue: 0,0:16:24.70,0:16:28.76,Default,,0,0,0,,،يمكن فتحها وإسقاطها بسهولة باستخدام خيط صيد
Dialogue: 0,0:16:29.18,0:16:33.94,Default,,0,0,0,,،ويمكنهم إشعال أحواض الزهور لتعزيز مصداقية القصة
Dialogue: 0,0:16:33.94,0:16:38.86,Default,,0,0,0,,.كل ذلك للمطالبة بالوجبات الخفيفة التي تركتها في مكتبك كقرابين
Dialogue: 0,0:16:39.27,0:16:42.66,Default,,0,0,0,,!حقًا؟ إذن لقد تم خداعك فحسب
Dialogue: 0,0:16:42.66,0:16:43.76,Default,,0,0,0,,!هذا سخيف
Dialogue: 0,0:16:43.76,0:16:45.03,Default,,0,0,0,,!كاذب
Dialogue: 0,0:16:45.46,0:16:51.05,Default,,0,0,0,,،صحيح. الوقوع في قصة مختلقة ونشرها ليس أمرًا جيدًا
Dialogue: 0,0:16:51.53,0:16:54.07,Default,,0,0,0,,.ولكن هذا كل ما يجب أن تشعر بالسوء تجاهه
Dialogue: 0,0:16:54.07,0:16:59.82,Default,,0,0,0,,.أصدقاؤك أكثر سخافة بكثير لخداعك
Dialogue: 0,0:16:59.82,0:17:01.29,Default,,0,0,0,,.نـ-نعم
Dialogue: 0,0:17:02.20,0:17:03.79,Default,,0,0,0,,...أيضًا، تاكوما
Dialogue: 0,0:17:05.12,0:17:08.41,Default,,0,0,0,,لقد أخذت واحدة من بصيلات الزنبق إلى المنزل، أليس كذلك؟
Dialogue: 0,0:17:09.64,0:17:14.36,Default,,0,0,0,,ربما تعثرت وثنيت ساقًا أثناء مراقبة الكسوف
Dialogue: 0,0:17:14.36,0:17:18.05,Default,,0,0,0,,.وكنت تخطط لإعادتها بهدوء بعد أن تزهر مرة أخرى في المنزل
Dialogue: 0,0:17:19.38,0:17:24.01,Default,,0,0,0,,.إذا فعلت ذلك، فلن تزهر هذا العام، لذا أحضر البصيلة مرة أخرى
Dialogue: 0,0:17:24.01,0:17:26.57,Default,,0,0,0,,.حـ-حسنًا. فهمت
Dialogue: 0,0:17:28.73,0:17:34.05,Default,,0,0,0,,على أي حال، يا رفاق، أليس لديكم ما تقولونه للجميع؟
Dialogue: 0,0:17:34.97,0:17:38.62,Default,,0,0,0,,.بعض الطلاب كانوا يتطلعون لاجتماع اولياء الأمور اليوم
Dialogue: 0,0:17:43.86,0:17:45.46,Default,,0,0,0,,.أنا آسفة
Dialogue: 0,0:17:46.10,0:17:47.84,Default,,0,0,0,,.أنا آسفة
Dialogue: 0,0:17:47.84,0:17:50.84,Default,,0,0,0,,.يا لهما من مثيرتي مشاكل
Dialogue: 0,0:17:51.29,0:17:56.85,Default,,0,0,0,,.على أي حال، ربما يمكنكم التغاضي عنهما... ولكن ربما لا
Dialogue: 0,0:17:56.85,0:18:01.56,Default,,0,0,0,,.حسنًا، يجب أن نخبر المدير بهذا
Dialogue: 0,0:18:01.56,0:18:04.34,Default,,0,0,0,,.لقد سمعت كل شيء
Dialogue: 0,0:18:04.34,0:18:06.29,Default,,0,0,0,,أ-أيها المدير؟
Dialogue: 0,0:18:08.75,0:18:13.27,Default,,0,0,0,,إذن هاتان هما الفتاتان اللتان ارتكبتا هذه الفعلة؟
Dialogue: 0,0:18:14.26,0:18:19.29,Default,,0,0,0,,.أ-أيها المدير، هذه الفتاتان كان لديهما سبب لما فعلتاه
Dialogue: 0,0:18:19.29,0:18:23.44,Default,,0,0,0,,مهما كان السبب، إجراء تجربة علمية\Nأثناء الغداء
Dialogue: 0,0:18:23.44,0:18:26.29,Default,,0,0,0,,!في المدرسة دون إذن هو أمر غير مقبول
Dialogue: 0,0:18:26.80,0:18:28.75,Default,,0,0,0,,تـ-تجربة؟
Dialogue: 0,0:18:31.98,0:18:37.45,Default,,0,0,0,,كعقاب، ستساعدان في إعادة زرع الزهور المحترقة
Dialogue: 0,0:18:37.45,0:18:41.04,Default,,0,0,0,,.وستكونان مسؤولتين عن ربها لمدة شهر
Dialogue: 0,0:18:41.04,0:18:42.77,Default,,0,0,0,,!نـ-نعم
Dialogue: 0,0:18:43.71,0:18:46.83,Default,,0,0,0,,.هيا. ماذا تفعلون؟
Dialogue: 0,0:18:46.83,0:18:50.37,Default,,0,0,0,,.الآباء سيصلون قريبًا
Dialogue: 0,0:18:51.24,0:18:53.53,Default,,0,0,0,,!لم يتبق سوى أقل من عشر دقائق حتى إجتماع اولياء الأمور
Dialogue: 0,0:18:54.75,0:18:56.28,Default,,0,0,0,,!ايتها المعلمة
Dialogue: 0,0:18:56.28,0:19:00.16,Default,,0,0,0,,إذا جاءت أمي، هل يمكنكِ إخبارها بعدم إجهاد نفسها؟
Dialogue: 0,0:19:00.16,0:19:02.79,Default,,0,0,0,,.لا تقلقي. لقد اتصلت بها البارحة
Dialogue: 0,0:19:02.79,0:19:07.68,Default,,0,0,0,,.أمك لن تأتي، ولكنها ستكون هنا
Dialogue: 0,0:19:11.40,0:19:13.08,Default,,0,0,0,,...إنها لن تأتي
Dialogue: 0,0:19:13.08,0:19:14.76,Default,,0,0,0,,ولكنها ستكون هنا؟
Dialogue: 0,0:19:19.66,0:19:21.45,DCEnding,,0,0,0,,!مرح! مرح! مرح
Dialogue: 0,0:19:23.84,0:19:30.05,DCEnding,,0,0,0,,قلبي ينبض بقوة قلبي ينبض بقوة أنا حقًا فضولي بشأن الحقيقة
Dialogue: 0,0:19:30.25,0:19:36.85,DCEnding,,0,0,0,,هل تحاول؟ من الصعب الكذب، أليس كذلك؟ يا! يا
Dialogue: 0,0:19:36.90,0:19:43.14,DCEnding,,0,0,0,,لاااا، أنا أفقد صوابي! هل من أحد يساعدني؟
Dialogue: 0,0:19:43.34,0:19:48.51,DCEnding,,0,0,0,,(كذبة أم حقيقة؟ لا أستطيع أن أقول (كل شيء أو لا شيء
Dialogue: 0,0:19:49.12,0:19:56.19,DCEnding,,0,0,0,,أنا في غاية الحب معك، أنا في غاية الحب معك
Dialogue: 0,0:19:56.34,0:20:02.88,DCEnding,,0,0,0,,يحب! هذا صحيح! سوف أتعرض لحروق شديدة
Dialogue: 0,0:20:03.04,0:20:10.21,DCEnding,,0,0,0,,تألق، ارقص معي، ارقص، ارقص، ارقص بابتسامة مبهرة
Dialogue: 0,0:20:11.38,0:20:17.55,DCEnding,,0,0,0,,أنسى الأشياء السيئة وأحبها، لا يمكن مساعدتها
Dialogue: 0,0:20:17.84,0:20:23.78,DCEnding,,0,0,0,,أنت وأنا وتلك الفتاة، إذا رقصنا، سنكون جميعًا سعداء
Dialogue: 0,0:20:24.22,0:20:30.39,DCEnding,,0,0,0,,تعال! تعال! أنت تتألق بشكل مشرق اليوم أيضًا
Dialogue: 0,0:20:31.04,0:20:36.03,DCEnding,,0,0,0,,!إنه أمر ممتع عندما يكون الجميع هناك، لذلك دعونا نذهب
Dialogue: 0,0:20:49.67,0:20:51.34,Default,,0,0,0,,.حسنًا، جميعًا
Dialogue: 0,0:20:51.34,0:20:54.20,Default,,0,0,0,,.خمسة زائد مربع يساوي سبعة
Dialogue: 0,0:20:54.20,0:20:57.57,Default,,0,0,0,,.لنكتشف أي رقم يذهب داخل هذا المربع
Dialogue: 0,0:21:05.53,0:21:07.02,Default,,0,0,0,,...أمي
Dialogue: 0,0:21:08.30,0:21:10.31,Default,,0,0,0,,هل يمكنكِ الرؤية؟
Dialogue: 0,0:21:10.31,0:21:12.08,Default,,0,0,0,,.نعم، بوضوح شديد
Dialogue: 0,0:21:12.51,0:21:14.18,Default,,0,0,0,,من يعرف الإجابة؟
Dialogue: 0,0:21:14.18,0:21:18.09,Default,,0,0,0,,!أنا! أنا
Dialogue: 0,0:21:14.66,0:21:17.58,Default,,0,0,0,,!ماريا ترفع يدها
Dialogue: 0,0:21:18.09,0:21:20.09,Default,,0,0,0,,!يمكنكِ فعلها
Dialogue: 0,0:21:22.27,0:21:23.62,Default,,0,0,0,,.فهمت
Dialogue: 0,0:21:24.42,0:21:29.10,Default,,0,0,0,,.إذن هذا هو اجتماع عبر الإنترنت الذي ذكره البروفيسور
Dialogue: 0,0:21:30.63,0:21:31.85,Default,,0,0,0,,ما الخطب، أي؟
Dialogue: 0,0:21:32.45,0:21:34.86,Default,,0,0,0,,ألا يمكنك حل هذه المسألة؟
Dialogue: 0,0:21:35.66,0:21:39.35,Default,,0,0,0,,.أنا أتمالك نفسي حتى لا أثير الشكوك بحل الكثير منها
Dialogue: 0,0:21:40.17,0:21:43.36,Default,,0,0,0,,.أنا أشاهد أيضًا. ابذلي قصارى جهدكِ
Dialogue: 0,0:21:49.52,0:21:50.89,Default,,0,0,0,,.حسناً، حنساً
Dialogue: 0,0:21:54.62,0:21:56.88,Default,,0,0,0,,.حسنًا، إيدوغاوا كونان
Dialogue: 0,0:21:58.63,0:22:02.06,Default,,0,0,0,,ما الرقم الذي يكون داخل المربع؟
Dialogue: 0,0:22:02.06,0:22:04.88,Default,,0,0,0,,.تبا، لماذا انا
Dialogue: 0,0:22:06.33,0:22:08.64,Default,,0,0,0,,.أعتقد أنه اثنان
Dialogue: 0,0:22:09.15,0:22:11.64,Default,,0,0,0,,ما رأيكم، جميعًا؟
Dialogue: 0,0:22:11.64,0:22:14.40,Default,,0,0,0,,!نعم
Dialogue: 0,0:22:15.18,0:22:17.29,Default,,0,0,0,,.هذا محرج للغاية
Dialogue: 0,0:22:17.29,0:22:19.74,Default,,0,0,0,,!رائع، كونان
Dialogue: 0,0:22:19.74,0:22:21.78,Default,,0,0,0,,!أنت عبقري
Dialogue: 0,0:22:23.12,0:22:26.66,Default,,0,0,0,,!أمي، هذا صوتك الطبيعي
Dialogue: 0,0:22:28.79,0:22:31.03,Default,,0,0,0,,.اهدوا ، جميعًا
Dialogue: 0,0:22:39.85,0:22:42.78,Default,,0,0,0,,إذن، أتعتقد أنك تستطيع العثور عليها؟
Dialogue: 0,0:22:42.78,0:22:45.70,Default,,0,0,0,,.لا، على الأرجح ليس في المدرسة
Dialogue: 0,0:22:45.70,0:22:47.89,Default,,0,0,0,,.لم أعتقد ذلك
Dialogue: 0,0:22:47.89,0:22:48.80,Default,,0,0,0,,...تلك المرأة
Dialogue: 0,0:22:48.80,0:22:52.59,Default,,0,0,0,,.ستستخدم على الأرجح معلمين آخرين أو طلابًا كدروع إذا لزم الأمر
Dialogue: 0,0:22:53.26,0:22:56.80,Default,,0,0,0,,.هذا سيجذب الكثير من الاهتمام
Dialogue: 0,0:22:56.80,0:22:58.44,Default,,0,0,0,,.فهمت
Dialogue: 0,0:22:59.05,0:23:01.50,Default,,0,0,0,,إذن هل حددت أماكن اختبائها؟
Dialogue: 0,0:23:01.50,0:23:03.34,Default,,0,0,0,,...في الحقيقة
Dialogue: 0,0:23:04.10,0:23:09.14,Default,,0,0,0,,.لقد حددنا بعض المواقع، ولكنها تتجنبنا في معظم الحالات
Dialogue: 0,0:23:09.14,0:23:11.42,Default,,0,0,0,,.ربما لديها ضعف ذلك
Dialogue: 0,0:23:14.09,0:23:17.03,Default,,0,0,0,,.يمكننا أخذ وقتنا
Dialogue: 0,0:23:17.03,0:23:18.43,Default,,0,0,0,,.حسناً، سيدي
Dialogue: 0,0:23:18.80,0:23:26.74,Default,,0,0,0,,.بالإضافة إلى ذلك، أنا فضولي لمعرفة سبب بقائها في تلك المدرسة
Dialogue: 0,0:23:30.43,0:23:31.85,Default,,0,0,0,,.حسنًا، جميعًا
Dialogue: 0,0:23:32.52,0:23:35.41,Default,,0,0,0,,.مربع زائد أربعة يساوي 12
Dialogue: 0,0:23:35.41,0:23:38.86,Default,,0,0,0,,من يعرف أي رقم يكون داخل هذا المربع؟
Dialogue: 0,0:23:38.86,0:23:43.83,Default,,0,0,0,,!أنا! أنا
