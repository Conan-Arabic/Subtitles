Dialogue: 0,0:05:23.46,0:05:32.22,Makio,TEXT,0,0,0,,{\fad(200,250)\bord0\p1\fscx425\fscy415\c&H742A27&\pos(44,243.222)}m 92 53 l 92 73 l 51 73 l 51 53{\p1}
