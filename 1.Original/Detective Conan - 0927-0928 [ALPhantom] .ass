Dialogue: 0,0:00:01.00,0:00:06.00,Title,,0,0,0,,{\blur2\fs35\c&HFFFFFF&\3c&H7A1F1E&\3a&H00&\pos(1256,15)}آل فانتوم\N{\fs35\fnReady}ALPhantom
Dialogue: 0,0:00:05.12,0:00:08.61,Default,CONAN,0,0,0,,!عامٌ جديدٌ سعيد، جميعكم
Dialogue: 0,0:00:08.94,0:00:12.79,Default,CONAN,0,0,0,,،في العام الماضي، الكتاب المُصور، و الأنمي التّلفازيّ، و الفلم
Dialogue: 0,0:00:12.79,0:00:16.47,Default,CONAN,0,0,0,,.و مُختلَف الأحداث قد لُوقيَت بحماسٍ كبير
Dialogue: 0,0:00:16.47,0:00:21.83,Default,CONAN,0,0,0,,.بالأخصّ فلم "زيرو المُنفّذ" الذي كان نجاحاً باهراً
Dialogue: 0,0:00:22.36,0:00:27.04,Default,CONAN,0,0,0,,.نشكُركم جميعاً على هذا
Dialogue: 0,0:00:27.47,0:00:31.12,Default,CONAN,0,0,0,,،سنعمل بجِدٍّ أكبر حتّى هذا العام
Dialogue: 0,0:00:31.12,0:00:33.57,Default,CONAN,0,0,0,,.لذا نُقدّر دعمكم المُستمرّ
Dialogue: 0,0:00:53.23,0:00:55.54,Default,RAN,0,0,0,,.إ-إنتظري، سونوكو
Dialogue: 0,0:00:55.54,0:00:57.95,Default,SONOKO,0,0,0,,.هيّا الآن. مرّ وَقتٌ طويل
Dialogue: 0,0:00:58.23,0:00:59.57,Default,RAN,0,0,0,,!كلّا، كلّا، كلّا، كلّا
Dialogue: 0,0:00:59.57,0:01:00.95,Default,RAN,0,0,0,,!أعطِني استراحة
Dialogue: 0,0:01:00.95,0:01:02.29,Default,SONOKO,0,0,0,,.هيّا الآن
Dialogue: 0,0:01:02.29,0:01:06.25,Default,SONOKO,0,0,0,,.سألتقط لكما صورةً رومانسيّة
Dialogue: 0,0:01:06.58,0:01:08.66,Default,RAN,0,0,0,,.لنلتقط صورةً لنا جميعاً
Dialogue: 0,0:01:08.66,0:01:09.50,Default,SONOKO,0,0,0,,.كلّا
Dialogue: 0,0:01:10.20,0:01:15.43,Default,SONOKO,0,0,0,,.يُمكنكِ تقبيل قُبلةٍ حميمة، سيّدتي
Dialogue: 0,0:01:15.43,0:01:16.59,Default,RAN,0,0,0,,ماذا؟
Dialogue: 0,0:01:16.99,0:01:18.32,Default,SONOKO,0,0,0,,...على أيّة حال
Dialogue: 0,0:01:19.17,0:01:21.30,Default,SONOKO,0,0,0,,!إذهبي
Dialogue: 0,0:01:25.69,0:01:29.19,Title,EPTITLE,0,0,0,,المُتحرّي كونان - ساعةٌ خاصّة
Dialogue: 0,0:01:25.69,0:01:29.19,Title,EPTITLE,0,0,0,,{\fad(1040,1)}(الرّحلة المدرسيّة القُرمزيّة (جُزء الأحمر الزّاهي
Dialogue: 0,0:01:40.20,0:01:46.21,Title,EPTITLE,0,0,0,,{\fad(400,1)\fs60\b1\pos(990,144)}(الرّحلة المدرسيّة القُرمزيّة (جُزء الأحمر الزّاهي
Dialogue: 0,0:01:40.88,0:01:44.25,Default,CONAN,0,0,0,,"!الرّحلة المدرسيّة القُرمزيّة، جُزء الأحمر الزّاهي”
Dialogue: 0,0:01:46.72,0:01:48.58,Default,RAN,0,0,0,,.أعتذر لاصطدامي بك
Dialogue: 0,0:01:48.78,0:01:50.00,Default,RAN,0,0,0,,هل تأذّيت؟
Dialogue: 0,0:01:51.59,0:01:54.71,Default,SHINICHI,0,0,0,,.لا يجدُر بكِ الإقتراب منّي كثيراً على الأرجح
Dialogue: 0,0:01:55.36,0:01:58.23,Default,SHINICHI,0,0,0,,.أخبرتكِ، أنا مُصابٌ ببعض البرد
Dialogue: 0,0:01:58.88,0:01:59.89,Default,RAN,0,0,0,,هل أنتَ بخير؟
Dialogue: 0,0:02:00.21,0:02:02.51,Default,RAN,0,0,0,,.أحضرتُ بعضاً من دواء البرد
Dialogue: 0,0:02:02.51,0:02:04.07,Default,SHINICHI,0,0,0,,.أنا بخير
Dialogue: 0,0:02:04.07,0:02:06.20,Default,SHINICHI,0,0,0,,.أعطاني البروفيسور بعض الدّواء
Dialogue: 0,0:02:06.20,0:02:07.81,Default,SONOKO,0,0,0,,.أُنظُرا إليكما
Dialogue: 0,0:02:08.20,0:02:10.60,Default,SONOKO,0,0,0,,هل تُخطّطان للِقاء أحبّةٍ لللّيلة؟
Dialogue: 0,0:02:10.60,0:02:11.96,Default,RAN,0,0,0,,!سونوكو
Dialogue: 0,0:02:11.96,0:02:14.71,Default,RAN,0,0,0,,.إن لَم تتوَقّفي، سأغضب حقّاً
Dialogue: 0,0:02:15.62,0:02:20.57,Default,SONOKO,0,0,0,,.أنتِ ظريفةٌ حتّى عندما تغضبين، سيّدتي
Dialogue: 0,0:02:20.57,0:02:22.52,Default,SHINICHI,0,0,0,,...يا إلهي
Dialogue: 0,0:02:23.00,0:02:27.44,Default,SHINICHI,0,0,0,,،كنتُ أنظُر إليها من زاويةٍ مُنخفضةٍ فقط مُؤخّراً، لذا كنتُ قد بدأتُ أنسى
Dialogue: 0,0:02:27.89,0:02:29.83,Default,SHINICHI,0,0,0,,...لكن برُؤيتها عن قُرب
Dialogue: 0,0:02:30.64,0:02:31.58,Default,SERA,0,0,0,,.هاي، أنت
Dialogue: 0,0:02:31.58,0:02:32.19,Default,SHINICHI,0,0,0,,هاه؟
Dialogue: 0,0:02:32.60,0:02:33.30,Default,SHINICHI,0,0,0,,!هواه
Dialogue: 0,0:02:33.67,0:02:36.33,Default,SERA,0,0,0,,هل أنتَ كودو شينتشي حقّاً؟
Dialogue: 0,0:02:36.33,0:02:37.42,Default,SHINICHI,0,0,0,,...نـ-نعم
Dialogue: 0,0:02:40.28,0:02:41.55,Default,SHINICHI,0,0,0,,ما-ماذا؟
Dialogue: 0,0:02:43.76,0:02:46.06,Default,SERA,0,0,0,,لا تذكُرني، صحيح؟
Dialogue: 0,0:02:46.42,0:02:48.37,Default,SHINICHI,0,0,0,,.هاه؟ أوه، نعم
Dialogue: 0,0:02:48.37,0:02:50.86,Default,SHINICHI,0,0,0,,ألَم نلتقي عند الشّاطئ خلال طُفولتنا؟
Dialogue: 0,0:02:50.86,0:02:51.94,Default,SHINICHI,0,0,0,,مرّت 10 أعوام، صحيح؟
Dialogue: 0,0:02:52.64,0:02:54.38,Default,SERA,0,0,0,,10أعوام؟
Dialogue: 0,0:02:54.38,0:02:56.23,Default,SERA,0,0,0,,هل مرّ كلّ هذا الوَقت حقّاً؟
Dialogue: 0,0:02:56.52,0:02:58.74,Default,SHINICHI,0,0,0,,.هاه؟ أوه، نعم، بالتّأكيد
Dialogue: 0,0:03:01.36,0:03:04.41,Default,RAN,0,0,0,,.سيرا تشان، سنذهب إلى كيوميزو بوتاي
Dialogue: 0,0:03:04.69,0:03:05.46,Default,SERA,0,0,0,,.حسناً
Dialogue: 0,0:03:06.15,0:03:06.91,Default,SERA,0,0,0,,.أراكنّ لاحقاً
Dialogue: 0,0:03:07.38,0:03:10.27,Default,SERA,0,0,0,,.يُمكننا الدّردشة قليلاً إذاً
Dialogue: 0,0:03:10.27,0:03:11.20,Default,SHINICHI,0,0,0,,...بالتّأكيد
Dialogue: 0,0:03:11.20,0:03:12.33,Default,NAKAMICHI,0,0,0,,.هاي، كودو
Dialogue: 0,0:03:12.66,0:03:13.72,Default,NAKAMICHI,0,0,0,,.نحن مَحظوظون بالتّأكيد
Dialogue: 0,0:03:13.72,0:03:15.88,Default,SHINICHI,0,0,0,,ناكاميتشي، ماذا تعني؟
Dialogue: 0,0:03:16.32,0:03:23.47,Default,NAKAMICHI,0,0,0,,.في مَجموعتنا 3 ممّن كُنّ في أعلى 10 مراكز بمُنافسة الشّعبيّة لفتيات ثانويّة تيتان
Dialogue: 0,0:03:23.47,0:03:24.64,Default,SHINICHI,0,0,0,,حقّاً؟
Dialogue: 0,0:03:24.95,0:03:27.17,Default,SHINICHI,0,0,0,,مُنافسة شعبيّة، هاه؟
Dialogue: 0,0:03:27.91,0:03:30.18,Default,SHINICHI,0,0,0,,ماذا كان مركز ران؟
Dialogue: 0,0:03:31.10,0:03:36.44,Default,NAKAMICHI,0,0,0,,.بما أنّكَ اعترفتَ بمَشاعركَ لموري في لندن، سأتجاوز عنها احتراماً لك
Dialogue: 0,0:03:36.44,0:03:37.83,Default,SHINICHI,0,0,0,,.أيّها الغبيّ
Dialogue: 0,0:03:37.83,0:03:42.78,Default,SHINICHI,0,0,0,,...تملك سونوكو حبيباً قويّاً جدّاً، و سيرا تُجيد الجيت كوندو
Dialogue: 0,0:03:43.36,0:03:43.99,Default,SHINICHI,0,0,0,,ماذا؟
Dialogue: 0,0:03:44.15,0:03:46.24,Default,SHINICHI,0,0,0,,!كيف تعرف بأنّني اعترفتُ بمَشاعري؟
Dialogue: 0,0:03:46.47,0:03:49.12,Default,NAKAMICHI,0,0,0,,.ماذا؟ أخبرَت سوزوكي الجّميع بهذا
Dialogue: 0,0:03:49.35,0:03:50.16,Default,SHINICHI,0,0,0,,ماذا؟
Dialogue: 0,0:03:50.16,0:03:52.99,Default,NAKAMICHI,0,0,0,,.قالَت بأنّه يجدُر بنا دعمكما
Dialogue: 0,0:03:52.99,0:03:55.24,Default,SHINICHI,0,0,0,,...سونوكو اللّعينة
Dialogue: 0,0:03:55.24,0:03:56.42,Default,NAKAMICHI,0,0,0,,...على أيّة حال، كودو
Dialogue: 0,0:03:57.11,0:03:59.72,Default,NAKAMICHI,0,0,0,,.مُتفاجئٌ لتمكّنكَ من القُدوم إلى الرّحلة المدرسيّة
Dialogue: 0,0:03:59.72,0:04:01.30,Default,NAKAMICHI,0,0,0,,.لَم أظنّكَ ستأتي
Dialogue: 0,0:04:01.30,0:04:02.80,Default,SHINICHI,0,0,0,,.أوه، نعم
Dialogue: 0,0:04:03.25,0:04:04.98,Default,SHINICHI,0,0,0,,.إحتاج الأمر للكثير لآتي إلى هُنا
Dialogue: 0,0:04:08.59,0:04:10.43,Default,CONAN,0,0,0,,،لَم نفعل ذلك لأجل هذا
Dialogue: 0,0:04:10.72,0:04:14.44,Default,CONAN,0,0,0,,...لكن إن كنتِ لا تُمانعين، الدّواء لإعادة جسدي
Dialogue: 0,0:04:14.44,0:04:17.48,Default,HAIBARA,0,0,0,,!بالتّأكيد لا
Dialogue: 0,0:04:17.89,0:04:20.27,Default,CONAN,0,0,0,,.لَم أظنّ ذلك
Dialogue: 0,0:04:23.07,0:04:24.54,Default,AGASA,0,0,0,,هل أُصبتَ بالبرد؟
Dialogue: 0,0:04:24.54,0:04:25.49,Default,CONAN,0,0,0,,.كلّا
Dialogue: 0,0:04:25.81,0:04:30.66,Default,GENTA,0,0,0,,.قفزَ كونان إلى البَحر عندما كاد أن يسقط الشّريط في الماء
Dialogue: 0,0:04:30.66,0:04:33.79,Default,MITSUHIKO,0,0,0,,.إنتهى به الأمر بأن يكون لشخصٍ آخر مع ذلك
Dialogue: 0,0:04:33.79,0:04:36.75,Default,AYUMI,0,0,0,,.و استمرّ بالبحث بالرّغم من أنّ ملابسه كانت مُبلّلة
Dialogue: 0,0:04:37.01,0:04:40.88,Default,AGASA,0,0,0,,.بالتّفكير بالأمر، تبدون أيّها الأطفال قذرين قليلاً أيضاً
Dialogue: 0,0:04:41.19,0:04:43.82,Default,GENTA,0,0,0,,.كنّا نبحث تحت السيّارات و ما إلى ذلك أيضاً
Dialogue: 0,0:04:43.82,0:04:45.26,Default,AYUMI,0,0,0,,.فعلنا هذا لأجل آي تشان
Dialogue: 0,0:04:45.56,0:04:47.39,Default,MITSUHIKO,0,0,0,,.نحن بخير
Dialogue: 0,0:04:47.39,0:04:48.64,Default,ALL,0,0,0,,!نعم
Dialogue: 0,0:04:49.67,0:04:51.64,Default,MITSUHIKO,0,0,0,,،إن كان لمُساعدة هايبارا سان
Dialogue: 0,0:04:51.83,0:04:52.70,Default,GENTA,0,0,0,,.نعم
Dialogue: 0,0:04:52.70,0:04:54.14,Default,MITSUHIKO,0,0,0,,.لا أُمانع بأن أتلَوّث هكذا على الإطلاق
Dialogue: 0,0:04:59.84,0:05:03.41,Default,CONAN,0,0,0,,.أظنّني سأُضطرّ لنسيان أمر الرّحلة المدرسيّة
Dialogue: 0,0:05:03.41,0:05:07.40,Default,CONAN,0,0,0,,.لَن أرغب بأن يعرف الآخرون أنّ شينتشي كودو مازال على قيد الحياة
Dialogue: 0,0:05:07.80,0:05:09.56,Default,CONAN,0,0,0,,!هذا مُؤلِم
Dialogue: 0,0:05:10.60,0:05:12.40,Default,CONAN,0,0,0,,لِمَ فعلتِ هذا، هايبارا؟
Dialogue: 0,0:05:12.82,0:05:14.60,Default,HAIBARA,0,0,0,,.سأُعطيكَ الدّواء
Dialogue: 0,0:05:14.60,0:05:15.46,Default,CONAN,0,0,0,,حقّاً؟
Dialogue: 0,0:05:15.73,0:05:16.71,Default,ALL,0,0,0,,هاه؟
Dialogue: 0,0:05:16.88,0:05:20.25,Default,HAIBARA,0,0,0,,.لكن يجب أن تتّبع تعليماتي
Dialogue: 0,0:05:20.25,0:05:21.36,Default,HAIBARA,0,0,0,,حسناً؟
Dialogue: 0,0:05:21.36,0:05:24.72,Default,SHINICHI,0,0,0,,.نعم، نعم. أعلَم
Dialogue: 0,0:05:26.12,0:05:27.72,Default,RAN,0,0,0,,.واه
Dialogue: 0,0:05:28.05,0:05:30.10,Default,RAN,0,0,0,,.ياله من مَشهدٍ جميل
Dialogue: 0,0:05:30.29,0:05:34.99,Default,SERA,0,0,0,,.لكن، هذا المكان لَيس عالٍ جدّاً
Dialogue: 0,0:05:35.56,0:05:37.54,Default,SERA,0,0,0,,.يبدو بارتفاع 12 متراً تقريباً
Dialogue: 0,0:05:38.19,0:05:41.51,Default,RAN,0,0,0,,.سيرا تشان، لا تنحني كثيراً. هذا خطِر
Dialogue: 0,0:05:41.51,0:05:45.96,Default,SONOKO,0,0,0,,.على ما يبدو، قفزَ شخصٌ لمَوته من هُنا قبل فترة
Dialogue: 0,0:05:45.96,0:05:46.99,Default,SERA,0,0,0,,حقّاً؟
Dialogue: 0,0:05:46.99,0:05:47.96,Default,SONOKO,0,0,0,,إذاً؟
Dialogue: 0,0:05:48.85,0:05:51.54,Default,SONOKO,0,0,0,,هل أجبتِ على اعتراف شينتشي كن؟
Dialogue: 0,0:05:51.54,0:05:52.26,Default,RAN,0,0,0,,ماذا؟
Dialogue: 0,0:05:55.78,0:05:57.07,Default,RAN,0,0,0,,...لَيس بعد
Dialogue: 0,0:05:57.07,0:06:00.59,Default,SONOKO,0,0,0,,.إذاً يجدُر بكِ تقبيلة هُنا حقّاً
Dialogue: 0,0:06:01.07,0:06:03.98,Default,SONOKO,0,0,0,,.تخيّلي قفزكِ عن كيوميزو بوتاي
Dialogue: 0,0:06:03.98,0:06:06.01,Default,RAN,0,0,0,,!لا يُمكنني فِعل ذلك
Dialogue: 0,0:06:06.43,0:06:09.53,Default,SERA,0,0,0,,ماذا يحصل؟ ران كن، هل ستقفزي؟
Dialogue: 0,0:06:09.53,0:06:11.76,Default,SONOKO,0,0,0,,.هذه مَسألة حافز
Dialogue: 0,0:06:16.74,0:06:19.27,Default,KEIKO,0,0,0,,.إنتظر فقط، ديكوري كن
Dialogue: 0,0:06:20.03,0:06:21.30,Default,KEIKO,0,0,0,,.لَن يطول الأمر الآن
Dialogue: 0,0:06:28.09,0:06:33.28,Default,RAN,0,0,0,,عُذراً، هل أنتِ المُمثّلة كوراتشي كيكو سان؟
Dialogue: 0,0:06:34.45,0:06:37.87,Caracters,TEXT,0,0,0,,{\fad(250,250)\pos(616,607)}كوراتشي كيكو (37) عاماً\Nمُمثّلة
Dialogue: 0,0:06:35.08,0:06:37.02,Default,KEIKO,0,0,0,,{\an8}.أتيتُ إلى هُنا بسرّيّة
Dialogue: 0,0:06:37.02,0:06:38.16,Default,KEIKO,0,0,0,,{\an8}.لا تُخبري أحداً
Dialogue: 0,0:06:38.16,0:06:39.43,Default,RAN,0,0,0,,.بالتّأكيد
Dialogue: 0,0:06:39.92,0:06:41.17,Default,SERA,0,0,0,,هل هي مَشهورة؟
Dialogue: 0,0:06:41.17,0:06:43.04,Default,SONOKO,0,0,0,,هل يُمكننا التقاط صورةٍ معكِ؟
Dialogue: 0,0:06:43.41,0:06:45.34,Default,KEIKO,0,0,0,,.نعم، مادمنا نفعل هذا بهُدوء
Dialogue: 0,0:06:45.34,0:06:46.92,Default,RAN,0,0,0,,.شُكراً لكِ
Dialogue: 0,0:06:46.92,0:06:49.93,Default,RAN,0,0,0,,.شينتشي، ناكاميتشي كن، تعالا إلى هُنا
Dialogue: 0,0:06:49.93,0:06:51.64,Default,RAN,0,0,0,,.لنلتقط صورةً معاً
Dialogue: 0,0:06:52.93,0:06:54.20,Default,KEIKO,0,0,0,,شينتشي؟
Dialogue: 0,0:06:56.68,0:06:59.16,Default,ALL,0,0,0,,!شُكراً لكِ
Dialogue: 0,0:06:59.16,0:07:00.59,Default,KEIKO,0,0,0,,.هاي، أنت
Dialogue: 0,0:07:00.59,0:07:01.42,Default,SHINICHI,0,0,0,,هاه؟
Dialogue: 0,0:07:01.42,0:07:05.95,Default,KEIKO,0,0,0,,هل أنتَ كودو شينتشي، مُتحرّي المدرسة الثّانويّة؟
Dialogue: 0,0:07:05.95,0:07:07.27,Default,SHINICHI,0,0,0,,.نعم
Dialogue: 0,0:07:07.27,0:07:09.45,Default,KEIKO,0,0,0,,أنتَ إبن يوكيكو تشان، صحيح؟
Dialogue: 0,0:07:09.45,0:07:10.62,Default,SHINICHI,0,0,0,,.نعم، إنّه أنا
Dialogue: 0,0:07:10.62,0:07:11.87,Default,KEIKO,0,0,0,,.كما ظننت
Dialogue: 0,0:07:11.87,0:07:14.53,Default,KEIKO,0,0,0,,.غيّرتُ حفّاضكَ سابقاً
Dialogue: 0,0:07:15.10,0:07:17.41,Default,KEIKO,0,0,0,,هل أنتَ في رحلةٍ مدرسيّة؟
Dialogue: 0,0:07:17.41,0:07:18.14,Default,SHINICHI,0,0,0,,.نعم
Dialogue: 0,0:07:18.14,0:07:21.22,Default,SONOKO,0,0,0,,.هاي، سيّدتي. زوجكِ يخونكِ
Dialogue: 0,0:07:21.22,0:07:22.89,Default,RAN,0,0,0,,.يبدو بأنّهما يعرفان بعضهما
Dialogue: 0,0:07:22.89,0:07:26.04,Default,KEIKO,0,0,0,,.مُستحيل. نُقيم في نفس الفُندق
Dialogue: 0,0:07:26.04,0:07:28.80,Default,SHINICHI,0,0,0,,نحن؟ هل أنتِ هُنا مع أحد؟
Dialogue: 0,0:07:29.06,0:07:30.06,Default,KEIKO,0,0,0,,.نعم
Dialogue: 0,0:07:30.45,0:07:35.30,Default,KEIKO,0,0,0,,.أتيتُ مع بعض زُملاء الجّامعة لتقديم احترامنا لصديقٍ قديم
Dialogue: 0,0:07:35.71,0:07:39.74,Default,KEIKO,0,0,0,,.أقول زُملاء جامعة، لكنّهم جميعاً مَشاهيرٌ أيضاً
Dialogue: 0,0:07:39.74,0:07:40.99,Default,SHINICHI,0,0,0,,حقّاً؟
Dialogue: 0,0:07:40.99,0:07:45.31,Default,KEIKO,0,0,0,,أعلَم. بما أنّنا نُقيم في نفس الفُندق، هل يُمكنكَ أن تأتي إلى غُرفتي اللّيلة؟
Dialogue: 0,0:07:45.49,0:07:46.32,Default,SHINICHI,0,0,0,,ماذا؟
Dialogue: 0,0:07:46.76,0:07:48.70,Default,KEIKO,0,0,0,,.هناك ما أُريد أن أُريه لك
Dialogue: 0,0:07:48.70,0:07:49.94,Default,SHINICHI,0,0,0,,تُريني ماذا؟
Dialogue: 0,0:07:50.37,0:07:51.51,Default,KEIKO,0,0,0,,.إنّها شيفرة
Dialogue: 0,0:07:52.51,0:07:54.45,Default,KEIKO,0,0,0,,يُحبّ المُتحرّون هذه الأُمور، صحيح؟
Dialogue: 0,0:07:56.41,0:07:58.31,Default,KEIKO,0,0,0,,.تعال لرُؤيتي في حوالي الـ9 من مَساء اللّيلة
Dialogue: 0,0:07:58.31,0:08:00.96,Default,KEIKO,0,0,0,,.هذا رقم غُرفتي
Dialogue: 0,0:08:01.27,0:08:03.33,Default,SONOKO,0,0,0,,.أعطَته شيئاً ما
Dialogue: 0,0:08:05.65,0:08:09.80,Default,KEIKO,0,0,0,,.كنتُ سأطلُب من زوج يوكيكو تشان
Dialogue: 0,0:08:09.80,0:08:11.47,Default,KEIKO,0,0,0,,هل أنتَ مُنشغلٌ جدّاً؟
Dialogue: 0,0:08:11.65,0:08:13.47,Default,SHINICHI,0,0,0,,!كلّا، لا مُشكلة على الإطلاق
Dialogue: 0,0:08:13.65,0:08:15.01,Default,KEIKO,0,0,0,,.تقرّر الأمر إذاً
Dialogue: 0,0:08:15.53,0:08:17.72,Default,KEIKO,0,0,0,,.يُمكنكَ إحضار حبيبتكَ أيضاً
Dialogue: 0,0:08:17.90,0:08:18.56,Default,SHINICHI,0,0,0,,هاه؟
Dialogue: 0,0:08:18.94,0:08:21.18,Default,KEIKO,0,0,0,,إنّها التي هناك ذات الشّعر الطّويل، صحيح؟
Dialogue: 0,0:08:21.18,0:08:23.45,Default,KEIKO,0,0,0,,.كانت تُحدّق بنا طوال هذا الوَقت
Dialogue: 0,0:08:25.54,0:08:26.71,Default,KEIKO,0,0,0,,.أراكَ لاحقاً
Dialogue: 0,0:08:26.71,0:08:28.49,Default,KEIKO,0,0,0,,.سأكون بالإنتظار. يجب أن تأتي
Dialogue: 0,0:08:28.49,0:08:29.82,Default,SHINICHI,0,0,0,,.حـ-حسناً
Dialogue: 0,0:08:33.99,0:08:35.36,Default,SONOKO,0,0,0,,!إنتظري، ران
Dialogue: 0,0:08:37.86,0:08:39.37,Default,SHINICHI,0,0,0,,اليوم في الـ9، هاه؟
Dialogue: 0,0:08:48.91,0:08:50.23,Default,SHINICHI,0,0,0,,.هذا قريب
Dialogue: 0,0:09:02.08,0:09:04.09,Title,SIGN,0,0,0,,تنقية الجّسد و الرّوح بمياه التّجميل
Dialogue: 0,0:09:55.55,0:09:58.56,Title,SIGN,0,0,0,,قصر موموياما\Nسقفٌ مُدمّي\Nلَوحة باب الأرز\Nمن رسم سوتاتسو في هذا المَعبد
Dialogue: 0,0:09:57.59,0:10:00.13,Default,GUIDE,0,0,0,,.أرجوكم أُنظروا إلى الأعلى نحو السّقف
Dialogue: 0,0:10:00.13,0:10:03.56,Default,GUIDE,0,0,0,,...الجنرال الذي يُقيم في قلعة فوشيمي في ذلك الوَقت
Dialogue: 0,0:10:03.78,0:10:06.82,Default,SONOKO,0,0,0,,...إذاً هذا هو السّقف المُدمّي
Dialogue: 0,0:10:07.09,0:10:09.65,Default,SERA,0,0,0,,.إنّه مَسرَح جريمةٍ قديم
Dialogue: 0,0:10:09.65,0:10:11.70,Default,NAKAMICHI,0,0,0,,.من الطّبيعيّ أن تقول مُتحرّية مدرسةٍ ثانويّةٍ هذا
Dialogue: 0,0:10:12.38,0:10:13.37,Default,RAN,0,0,0,,.هاي
Dialogue: 0,0:10:13.90,0:10:16.11,Default,RAN,0,0,0,,.لنستمرّ بالتّقدّم
Dialogue: 0,0:10:16.11,0:10:18.78,Default,SHINICHI,0,0,0,,.لا تقلَقي. لَن يُنقّط علينا
Dialogue: 0,0:10:18.78,0:10:20.70,Default,RAN,0,0,0,,.أعلَم ذلك
Dialogue: 0,0:10:20.98,0:10:25.31,Default,SHINICHI,0,0,0,,.أيضاً، رُسمَ على السّقف إحياءً لذِكرى الرّجال الذين ماتوا في المَعركة
Dialogue: 0,0:10:25.31,0:10:27.71,Default,SHINICHI,0,0,0,,.يجدُر بكِ النّظر إليه و الدّعوَة لهم
Dialogue: 0,0:10:28.50,0:10:30.09,Default,RAN,0,0,0,,.أ-أنتَ مُحقّ
Dialogue: 0,0:10:37.02,0:10:38.16,Default,SHINICHI,0,0,0,,.أه، أوه
Dialogue: 0,0:10:40.09,0:10:41.64,Default,SHINICHI,0,0,0,,.هذا ممتعٌ جدّاً
Dialogue: 0,0:10:47.67,0:10:50.84,Default,RAN,0,0,0,,ما رقم غُرفة كوراتشي سان؟
Dialogue: 0,0:10:50.84,0:10:51.82,Default,SHINICHI,0,0,0,,.أوه
Dialogue: 0,0:10:52.05,0:10:54.28,Default,SHINICHI,0,0,0,,.إنّها الغُرفة 1506
Dialogue: 0,0:10:52.58,0:10:55.20,Default,MANAGER,0,0,0,,{\an8}.أعتذر بشأن المُلصق، ماي سان
Dialogue: 0,0:10:55.40,0:10:56.75,Default,KURAKI,0,0,0,,.لا يُمكن فِعل شيءٍ بشأن ذلك
Dialogue: 0,0:10:56.75,0:11:00.20,Default,KURAKI,0,0,0,,كانوا أصدقاء منذ الجّامعة، صحيح؟
Dialogue: 0,0:11:00.86,0:11:05.67,Default,KURAKI,0,0,0,,.أيضاً، سمعتُ بأنّ ذلك الفلم إعادة إنتاجٍ للفلم الذي أنتجوه في الجّامعة
Dialogue: 0,0:11:00.95,0:11:02.59,Default,SONOKO,0,0,0,,{\an8}!كوراكي ماي
Dialogue: 0,0:11:03.88,0:11:04.89,Up,SERA,0,0,0,,من؟
Dialogue: 0,0:11:07.52,0:11:11.31,Default,KURAKI,0,0,0,,،إن ظهرَ إسمي إلى جانب أسمائهم في مُلصق الفلم
Dialogue: 0,0:11:11.31,0:11:13.95,Default,KURAKI,0,0,0,,،سيبدو الأمر كما لَو أنّني أجبرتُهم على فِعل ذلك
Dialogue: 0,0:11:13.95,0:11:18.78,Default,KURAKI,0,0,0,,.بالرّغم من أنّني غنّيتُ أُغنية الفلم
Dialogue: 0,0:11:18.78,0:11:20.79,Default,KURAKI,0,0,0,,.سعيدةٌ لأنّهم رفضوا طلَبنا
Dialogue: 0,0:11:20.79,0:11:22.24,Default,MANAGER,0,0,0,,.أعتذر
Dialogue: 0,0:11:22.43,0:11:24.90,Default,MANAGER,0,0,0,,.ظننتُها ستكون فُرصةً جيّدةً للتّرويج لكِ
Dialogue: 0,0:11:25.59,0:11:27.53,Default,KURAKI,0,0,0,,هل أنتُم أطفالٌ في الثّانويّة؟
Dialogue: 0,0:11:27.53,0:11:28.81,Default,KURAKI,0,0,0,,هل أنتُم في رحلةٍ مدرسيّة؟
Dialogue: 0,0:11:29.27,0:11:30.44,Default,SHINICHI,0,0,0,,.نعم
Dialogue: 0,0:11:30.73,0:11:33.25,Default,KURAKI,0,0,0,,.فهمت. هذا جميل
Dialogue: 0,0:11:33.25,0:11:36.10,Default,KURAKI,0,0,0,,موعدٌ غراميٌّ مُزدوجٌ في رحلةٍ مدرسيّة، هاه؟
Dialogue: 0,0:11:36.10,0:11:37.70,Default,KURAKI,0,0,0,,.أوه، ما أجمل الشّباب
Dialogue: 0,0:11:37.70,0:11:39.95,Default,KURAKI,0,0,0,,.جعلتُم قلبي يتسارع
Dialogue: 0,0:11:43.02,0:11:44.52,Default,RAN,0,0,0,,موعدٌ غراميٌّ مُزدوج؟
Dialogue: 0,0:11:50.09,0:11:51.39,Default,SERA,0,0,0,,.ظننتُني كنتُ سأموت
Dialogue: 0,0:11:51.39,0:11:52.34,Default,SONOKO,0,0,0,,.أعتذر
Dialogue: 0,0:11:53.83,0:11:55.05,Default,KEIKO,0,0,0,,!أنا قادِمة
Dialogue: 0,0:11:56.22,0:11:57.26,Default,KEIKO,0,0,0,,.مرحباً
Dialogue: 0,0:11:57.26,0:11:57.84,Default,KEIKO,0,0,0,,...أوه
Dialogue: 0,0:11:58.40,0:12:01.00,Default,KEIKO,0,0,0,,.أحضرتَ أشخاصاً أكثر منها فقط
Dialogue: 0,0:12:01.00,0:12:02.13,Default,SHINICHI,0,0,0,,.أعتذر
Dialogue: 0,0:12:02.13,0:12:04.71,Default,SHINICHI,0,0,0,,.عندما أخبرتُهم بأنّني سألتقي بكِ، أصرّوا على القُدوم
Dialogue: 0,0:12:04.71,0:12:06.03,Default,SONOKO,0,0,0,,!مرحباً
Dialogue: 0,0:12:06.03,0:12:07.35,Default,SHINICHI,0,0,0,,ألَم يكُن يجدُر بي إحضارهم؟
Dialogue: 0,0:12:07.61,0:12:09.82,Default,KEIKO,0,0,0,,.كلّا، لا مُشكلة على الإطلاق
Dialogue: 0,0:12:09.82,0:12:11.23,Default,KEIKO,0,0,0,,كلّما كان العدد أكثر سيزداد المَرَح، صحيح؟
Dialogue: 0,0:12:11.62,0:12:13.45,Default,SERA,0,0,0,,.سأحلّ لكِ تلك الشّيفرة
Dialogue: 0,0:12:14.61,0:12:17.86,Default,SONOKO,0,0,0,,.هي مُتحرّيةٌ أيضاً\N.مُتحرّيةٌ في المدرسة الثّانويّة
Dialogue: 0,0:12:18.13,0:12:20.26,Default,KEIKO,0,0,0,,.حقّاً؟ كم هذا وَاعد
Dialogue: 0,0:12:20.26,0:12:21.20,Default,RAN,0,0,0,,.عُذراً
Dialogue: 0,0:12:21.69,0:12:24.16,Default,RAN,0,0,0,,ترتدين قُبّعةً في الدّاخل أيضاً؟
Dialogue: 0,0:12:24.16,0:12:25.12,Default,KEIKO,0,0,0,,أوه، هذه؟
Dialogue: 0,0:12:25.66,0:12:29.05,Default,KEIKO,0,0,0,,.تعثّرتُ خلال التّصوير و أُصبتُ بكدمةٍ في رأسي
Dialogue: 0,0:12:29.05,0:12:32.84,Default,SONOKO,0,0,0,,هل كنتِ تُصوّرين لفلمكِ الذي سيصدُر في نهاية الأُسبوع هذه؟
Dialogue: 0,0:12:32.84,0:12:34.13,Default,IHAYA,0,0,0,,.هذا صحيح
Dialogue: 0,0:12:34.66,0:12:36.06,Default,IHAYA,0,0,0,,".التينغو الأحمر المُقاتِل"
Dialogue: 0,0:12:36.09,0:12:39.47,Caracters,TEXT,0,0,0,,{\fad(250,250)\pos(634,601)}إيهايا شينيا (37) عاماً\Nمُمثّل
Dialogue: 0,0:12:36.68,0:12:40.55,Default,IHAYA,0,0,0,,{\an8}.سيكون تسليط الضّوء في فلم الخيال التّاريخيّ هذا هو نَجمه، أنا
Dialogue: 0,0:12:42.22,0:12:43.31,Default,MAYAMA,0,0,0,,.كلّا، كلّا
Dialogue: 0,0:12:43.74,0:12:48.27,Default,MAYAMA,0,0,0,,{\an8}.أظنّ بأنّ الضّوء في هذا الفلم سيُسلّط عليّ أنا، المُخرِج
Dialogue: 0,0:12:45.60,0:12:48.44,Caracters,TEXT,0,0,0,,{\fad(250,250)\pos(646,595)}ماياما مينيتو (38) عاماً\Nمُخرِج أفلام
Dialogue: 0,0:12:48.27,0:12:49.75,Up,AGATA,0,0,0,,.كلّا، كلّا، كلّا
Dialogue: 0,0:12:50.12,0:12:53.32,Default,AGATA,0,0,0,,{\an8}.أظنّ بأنّ نُقطة الجّذب لهذا الفلم هي موسيقتي
Dialogue: 0,0:12:50.69,0:12:53.65,Caracters,TEXT,0,0,0,,{\fad(250,250)\pos(632,601)}أغاتا ريكي (37) عاماً\Nمُؤلّف
Dialogue: 0,0:12:54.08,0:12:55.33,Default,IHAYA,0,0,0,,ما الذي تتكلّمان عنه؟
Dialogue: 0,0:12:55.33,0:12:56.49,Default,IHAYA,0,0,0,,.لا وُجود لهذا الفلم دون نَجمه
Dialogue: 0,0:12:56.49,0:12:57.84,Default,MAYAMA,0,0,0,,.أنتَ مُخطئ
Dialogue: 0,0:12:57.84,0:13:00.28,Default,MAYAMA,0,0,0,,.يُقال دائماً بأنّ ما يصنع الفلم هو مُخرجه
Dialogue: 0,0:13:00.82,0:13:03.28,Default,SHINICHI,0,0,0,,.جميعهم مَشاهير بالفِعل
Dialogue: 0,0:13:03.28,0:13:04.32,Default,KEIKO,0,0,0,,.هذا صحيح
Dialogue: 0,0:13:04.76,0:13:07.93,Default,KEIKO,0,0,0,,.جميعهم أصدقائي من الجّامعة
Dialogue: 0,0:13:08.61,0:13:11.21,Default,SHINICHI,0,0,0,,إذاً، ما الشّيفرة التي ذكرتِها؟
Dialogue: 0,0:13:11.21,0:13:13.04,Default,KEIKO,0,0,0,,.أوه، صحيح
Dialogue: 0,0:13:13.49,0:13:16.00,Default,KEIKO,0,0,0,,.إنّها مع كاتب نُصوصنا نيشيكي كن
Dialogue: 0,0:13:16.00,0:13:18.05,Default,KEIKO,0,0,0,,.لنذهب إلى غُرفته معاً
Dialogue: 0,0:13:19.80,0:13:20.55,Default,NISHIKI,0,0,0,,.نعم
Dialogue: 0,0:13:20.99,0:13:24.72,Default,NISHIKI,0,0,0,,.هذه هي الشّيفرة التي وَصلَتني في الأُسبوع الماضي
Dialogue: 0,0:13:25.06,0:13:26.39,Default,SHINICHI,0,0,0,,.دعني أُلقي نظرَة
Dialogue: 0,0:13:26.74,0:13:32.51,Default,NISHIKI,0,0,0,,.إحتوى المُغلّف الذي احتوى الشّيفرة أيضاً على وَرقة نبتةٍ مُجفّفة
Dialogue: 0,0:13:32.51,0:13:33.40,Default,SHINICHI,0,0,0,,.عُذراً
Dialogue: 0,0:13:33.63,0:13:39.26,Default,SHINICHI,0,0,0,,هل تعرف ماذا تعني هذه المُربّعات الـ4 السّوداء في أعلى الشّيفرة؟
Dialogue: 0,0:13:39.26,0:13:40.11,Default,IHAYA,0,0,0,,.نعم
Dialogue: 0,0:13:40.66,0:13:44.97,Default,IHAYA,0,0,0,,.إنّه رمز ديكوري، من اخترعَ تلك الشّيفرة
Dialogue: 0,0:13:44.97,0:13:48.50,Default,AGATA,0,0,0,,.رسمَ ذلك الرّمز على كُتب مُلاحظاته و حقائبه
Dialogue: 0,0:13:49.00,0:13:53.07,Default,SERA,0,0,0,,إذاً ألا يُمكنكم أن تسألوا ديكوري ذاك عن مَعنى الشّيفرة؟
Dialogue: 0,0:13:53.07,0:13:54.64,Default,NISHIKI,0,0,0,,.لَم يعُد بإمكاننا ذلك
Dialogue: 0,0:13:55.72,0:14:00.76,Default,NISHIKI,0,0,0,,.قبل فترة، قفزَ لمَوته من الكيوميزو بوتاي
Dialogue: 0,0:14:01.13,0:14:02.01,Default,ALL,0,0,0,,ماذا؟
Dialogue: 0,0:14:02.42,0:14:06.70,Default,NISHIKI,0,0,0,,ظننتُ بأنّ تلك الشّيفرة كانت رسالةً قد تمّ تركها لي
Dialogue: 0,0:14:06.70,0:14:09.49,Default,NISHIKI,0,0,0,,.قبل انتحاره
Dialogue: 0,0:14:09.49,0:14:11.39,Default,NISHIKI,0,0,0,,.لهذا أردتّكَ أن تفكّ تشفيرها
Dialogue: 0,0:14:13.75,0:14:15.11,Default,MAYAMA,0,0,0,,.هاي، أيّها الأطفال
Dialogue: 0,0:14:15.67,0:14:20.00,Default,MAYAMA,0,0,0,,.سنذهب لتناول العشاء في صالة الفُندق
Dialogue: 0,0:14:20.00,0:14:22.91,Default,MAYAMA,0,0,0,,إن أردتّم مَعرفة المزيد، لِمَ لا تأتوا معنا؟
Dialogue: 0,0:14:22.91,0:14:24.95,Default,SHINICHI,0,0,0,,.كلّا، شُكراً. سنُفوّت هذا
Dialogue: 0,0:14:25.19,0:14:27.83,Default,KEIKO,0,0,0,,.إذاً راسلني عندما تفكّ الشّيفرة
Dialogue: 0,0:14:28.19,0:14:29.29,Default,SHINICHI,0,0,0,,.حسناً
Dialogue: 0,0:14:32.50,0:14:35.35,Default,SONOKO,0,0,0,,.إنّها شيفرةٌ بدائيّةٌ جدّاً
Dialogue: 0,0:14:35.35,0:14:37.51,Default,RAN,0,0,0,,.و الرّموز مُرتّبةٌ بطريقةٍ غير مُنظّمة
Dialogue: 0,0:14:37.51,0:14:42.57,Default,SERA,0,0,0,,.يُوجد بالأحرى مَعنىً لهذه الفراغات الغير مُنظّمة
Dialogue: 0,0:14:43.15,0:14:47.14,Default,RAN,0,0,0,,.بالتّفكير بالأمر، أتسائل عن أمر وَرقة النّبتة المُجفّفة
Dialogue: 0,0:14:48.68,0:14:52.07,Default,SHINICHI,0,0,0,,يحمل تينغو عادةً أوراق نباتاتٍ مُجفّفة، صحيح؟
Dialogue: 0,0:14:55.69,0:14:57.23,Default,SHINICHI,0,0,0,,.إنّها من كيكو سان
Dialogue: 0,0:14:57.53,0:15:00.22,Default,SHINICHI,0,0,0,,.هيّا الآن. لَم أفكّ الشّيفرة بعد
Dialogue: 0,0:15:01.15,0:15:03.15,Title,TEXT,0,0,0,,من: كوراتشي كيكو
Dialogue: 0,0:15:01.15,0:15:03.15,Title,TEXT,0,0,0,,الموضوع: لا موضوع
Dialogue: 0,0:15:01.15,0:15:03.15,Title,TEXT,0,0,0,,!!شينتشي كن، أسرِع! تعال إلى غُرفة نيشيكي كن
Dialogue: 0,0:15:06.94,0:15:08.03,Default,SHINICHI,0,0,0,,ماذا حصل، كيكو سان؟
Dialogue: 0,0:15:14.50,0:15:15.84,Default,SHINICHI,0,0,0,,.تمّ طعنُه
Dialogue: 0,0:15:16.38,0:15:18.34,Default,SHINICHI,0,0,0,,.و تُوجد كدماتٌ على رأسه
Dialogue: 0,0:15:18.89,0:15:23.59,Default,SERA,0,0,0,,ألَم تقولوا بأنّكم ستتناولون العشاء في القاعة؟
Dialogue: 0,0:15:24.49,0:15:29.21,Default,IHAYA,0,0,0,,.نعم. بعدها عُدنا إلى غُرَفنا لنَستعدّ
Dialogue: 0,0:15:29.74,0:15:33.60,Default,AGATA,0,0,0,,.كان يُفترض أن نلتقي في هذه الغُرفة بعد 10 دقائق قبل أن ننزل
Dialogue: 0,0:15:34.18,0:15:37.44,Default,MAYAMA,0,0,0,,،لَم يجُب على الباب مهما رننّا الجّرَس
Dialogue: 0,0:15:37.44,0:15:39.86,Default,MAYAMA,0,0,0,,.لذا جعلنا مُوَظّف الخدَمات يفتحه
Dialogue: 0,0:15:39.86,0:15:41.43,Default,MAYAMA,0,0,0,,.هكذا وَجدناه
Dialogue: 0,0:15:45.93,0:15:46.78,Default,SERA,0,0,0,,ما الأمر؟
Dialogue: 0,0:15:46.78,0:15:49.03,Default,SHINICHI,0,0,0,,.سقطَ شيءٌ على كتِفي
Dialogue: 0,0:15:55.70,0:15:58.17,Default,SERA,0,0,0,,.يُشبه السّقف المُدمّي تماماً
Dialogue: 0,0:15:58.33,0:16:05.08,Default,SHINICHI,0,0,0,,.نعم، و تتّجه آثار الأقدام على السّقف نحو النّافذة
Dialogue: 0,0:16:05.78,0:16:10.93,Default,SERA,0,0,0,,،أراد الجّاني على الأرجح أن يبدو الأمر كما لَو أنّه رفعَ الضّحيّة إلى السّقف و طعنَه
Dialogue: 0,0:16:11.34,0:16:14.03,Default,SERA,0,0,0,,،و سار عبر السّقف إلى النّافذة
Dialogue: 0,0:16:14.63,0:16:19.73,Default,SERA,0,0,0,,.و اختفى من نافذة غُرفة هذا الطّابق الـ15
Dialogue: 0,0:16:20.63,0:16:23.73,Default,SERA,0,0,0,,كما لَو أنّ وَحشاً بجناحين قادرٌ على الطّيران
Dialogue: 0,0:16:24.94,0:16:29.14,Default,SERA,0,0,0,,و يملك قِوىً سحريّةً يُمكنها التّلاعب بالجّسد البَشريّ
Dialogue: 0,0:16:30.77,0:16:32.78,Default,SERA,0,0,0,,.هو من ارتكبَ هذه الجّريمة
Dialogue: 0,0:16:41.25,0:16:43.79,Default,KEIKO,0,0,0,,تـ-تعنين تينغو؟
Dialogue: 0,0:16:44.44,0:16:46.84,Default,KEIKO,0,0,0,,هل تعنين بأنّ تينغو قد قتلَ نيشيكي كن؟
Dialogue: 0,0:16:46.84,0:16:48.40,Default,IHAYA,0,0,0,,!لا-لا تكوني سخيفة
Dialogue: 0,0:16:48.40,0:16:53.26,Default,KEIKO,0,0,0,,...لـ-لكن وَحشٌ بقِوىً سحريّةً و يُمكنه الطّيران
Dialogue: 0,0:16:53.62,0:16:54.77,Default,AGATA,0,0,0,,ما الذي تتكلّمين عنه؟
Dialogue: 0,0:16:54.77,0:16:56.89,Default,AGATA,0,0,0,,!لا وُجود لها بالوَاقع
Dialogue: 0,0:16:56.89,0:16:58.53,Default,KEIKO,0,0,0,,.لكنّه التّفسير المَنطقيّ الوَحيد
Dialogue: 0,0:16:58.53,0:17:00.27,Default,MAYAMA,0,0,0,,.التينغو كائناتٌ خياليّة
Dialogue: 0,0:17:00.63,0:17:05.45,Default,MAYAMA,0,0,0,,.لا تُوجد إلّا في الأفلام كالذي كنّا نُصوّره مُؤخّراً
Dialogue: 0,0:17:06.47,0:17:10.95,Default,MAYAMA,0,0,0,,هل تعنين بأنّ كائناً خياليّاً قتلَ نيشيكي؟
Dialogue: 0,0:17:12.35,0:17:17.29,Default,SHINICHI,0,0,0,,.بكِلتا الحالَتين، يبدو بأنّ الجّاني أراد جعل الأمر يبدو كما لَو أنّه من فِعل تينغو
Dialogue: 0,0:17:18.31,0:17:23.29,Default,SHINICHI,0,0,0,,.تُوجد وَرقة نبتةٍ مُجفّفةٍ في سُترة الضّحيّة، و التي يحملها التينغو عادةً
Dialogue: 0,0:17:23.69,0:17:26.27,Default,SHINICHI,0,0,0,,.و شيفرةٌ جديدةٌ أيضاً
Dialogue: 0,0:17:28.47,0:17:33.65,Default,SHINICHI,0,0,0,,رُبّما الشّيفرة المُشابهة التي وَصلَت إلى نيشيكي سان الأُسبوع الماضي
Dialogue: 0,0:17:33.65,0:17:36.22,Default,SHINICHI,0,0,0,,.كانت تحذيراً
Dialogue: 0,0:17:36.40,0:17:38.46,Default,MAYAMA,0,0,0,,تحذير؟
Dialogue: 0,0:17:38.46,0:17:42.46,Default,IHAYA,0,0,0,,...إنتظر. إن كانت هناك شيفرةٌ جديدة
Dialogue: 0,0:17:42.46,0:17:44.82,Default,KEIKO,0,0,0,,هل يعني ذلك بأنّه سيُقتَل شخصٌ آخر؟
Dialogue: 0,0:17:45.37,0:17:51.15,Default,SERA,0,0,0,,هل يُمكن بأنّ ديروكو ذاك الذي اخترعَ الشّيفرة قد كرِهكم؟
Dialogue: 0,0:17:52.63,0:17:55.52,Default,IHAYA,0,0,0,,هـ-هذا مُستحيل، صحيح؟
Dialogue: 0,0:17:55.52,0:17:56.66,Default,AGATA,0,0,0,,.نـ-نعم
Dialogue: 0,0:17:58.31,0:18:02.94,Default,SHINICHI,0,0,0,,بكِلتا الحالَتين، هذا على الأرجح من فِعل شخصٍ مُنزعجٍ
Dialogue: 0,0:18:03.33,0:18:07.34,Default,SHINICHI,0,0,0,,.من فلمكم "التينغو المُقاتِل" الذي سيصدر في عُطلة الأُسبوع هذه
Dialogue: 0,0:18:07.95,0:18:12.01,Default,SHINICHI,0,0,0,,.نصّ الفلم مُبعثرٌ على الأرض
Dialogue: 0,0:18:14.07,0:18:14.93,Default,SHINICHI,0,0,0,,،بالمُناسبة
Dialogue: 0,0:18:15.79,0:18:20.64,Default,SHINICHI,0,0,0,,ما قُصاصات الوَرق المَلساء تلك المُلصقة على النّصّ؟
Dialogue: 0,0:18:22.42,0:18:24.65,Default,MAYAMA,0,0,0,,.إنّها مُلصقات
Dialogue: 0,0:18:24.88,0:18:28.58,Default,MAYAMA,0,0,0,,كان نيشيكي يستخدِم هذا النّوع من المُلصقات مُؤخّراً
Dialogue: 0,0:18:28.58,0:18:31.53,Default,MAYAMA,0,0,0,,.بما أنّه من السّهل لَصقها و إزالتها
Dialogue: 0,0:18:32.10,0:18:34.29,Default,MAYAMA,0,0,0,,،بما أنّ الفلم سيُحوّل إلى رواية
Dialogue: 0,0:18:34.29,0:18:38.85,Default,MAYAMA,0,0,0,,.أحضرَ نيشيكي النّصّ إلى الفُندق ليتمكّن من إجراء تعديلات
Dialogue: 0,0:18:38.85,0:18:40.04,Default,SHINICHI,0,0,0,,.فهمت
Dialogue: 0,0:18:40.62,0:18:44.64,Default,KEIKO,0,0,0,,...كان مُتحمّساً جدّاً لإنهائه قبل افتتاح الفلم
Dialogue: 0,0:18:48.05,0:18:49.24,Default,MAYAMA,0,0,0,,.عُذراً
Dialogue: 0,0:18:50.34,0:18:51.49,Default,MAYAMA,0,0,0,,مرحباً؟
Dialogue: 0,0:18:51.90,0:18:58.05,Default,SERA,0,0,0,,.قلتُم بأنّكم خطّطتّم لأن تلتقوا بعد 10 دقائق في هذه الغُرفة قبل الذّهاب لتناول العشاء
Dialogue: 0,0:18:58.29,0:19:00.73,Default,SERA,0,0,0,,من أوّل من وَصل إلى الغُرفة؟
Dialogue: 0,0:19:00.73,0:19:03.55,Default,IHAYA,0,0,0,,.أنا و أغاتا
Dialogue: 0,0:19:03.98,0:19:08.02,Default,AGATA,0,0,0,,.عندما وَصلنا، لَم يكُن يُجيب على بابه
Dialogue: 0,0:19:10.06,0:19:11.60,Default,SHINICHI,0,0,0,,،إن كان هذا صحيحاً
Dialogue: 0,0:19:11.60,0:19:15.85,Default,SHINICHI,0,0,0,,إذاً فقد قتلَ الجّاني نيشيكي سان و رشّ السّقف
Dialogue: 0,0:19:15.85,0:19:19.63,Default,SHINICHI,0,0,0,,.بالدّماء خلال تلك الـ10 دقائق
Dialogue: 0,0:19:20.26,0:19:25.92,Default,SERA,0,0,0,,.نعم. لَم يكُن ذلك الدّم هُنا عندما أتينا مُسبقاً
Dialogue: 0,0:19:26.97,0:19:29.92,Default,SHINICHI,0,0,0,,هل اتّصلتُم بالشّرطة؟
Dialogue: 0,0:19:30.17,0:19:35.62,Default,MAYAMA,0,0,0,,.إتّصلَ مُوَظّف الخدَمات الذي فتح الباب بالشّرطة لأجلنا
Dialogue: 0,0:19:35.62,0:19:41.81,Default,MAYAMA,0,0,0,,.إتّصلَ للتّوّ ليقول بأنّ المُفتّش أيانوكوجي من شُرطة كيوتو آتٍ
Dialogue: 0,0:19:42.29,0:19:45.41,Default,SERA,0,0,0,,المُفتّش أيانوكوجي من شُرطة كيوتو، هاه؟
Dialogue: 0,0:19:45.41,0:19:49.02,Default,SHINICHI,0,0,0,,،إنّه مُفتّشٌ غريب الأطوار معه سنجابٌ كحيوانٍ أليف
Dialogue: 0,0:19:49.88,0:19:51.55,Default,SHINICHI,0,0,0,,.لكنّه رجلٌ ذكيّ
Dialogue: 0,0:19:51.55,0:19:52.83,Default,SHINICHI,0,0,0,,...لا حاجة لكي نقلَق بشأن
Dialogue: 0,0:19:55.57,0:19:57.28,Default,SERA,0,0,0,,هل من خطب؟
Dialogue: 0,0:19:58.70,0:20:01.25,Default,SHINICHI,0,0,0,,.كـ-كلّا، لا شيء
Dialogue: 0,0:20:01.68,0:20:02.54,Default,SERA,0,0,0,,.هاي
Dialogue: 0,0:20:02.54,0:20:06.16,Default,SHINICHI,0,0,0,,.هذا لَيس جيّداً. تأثير الدّواء يتلاشى
Dialogue: 0,0:20:06.57,0:20:07.89,Default,SERA,0,0,0,,هل أنتَ بخير؟
Dialogue: 0,0:20:07.89,0:20:09.52,Default,SHINICHI,0,0,0,,.نـ-نعم
Dialogue: 0,0:20:10.35,0:20:14.03,Default,SHINICHI,0,0,0,,.عـ-على أيّة حال، أترك لكِ البقيّة، سيرا
Dialogue: 0,0:20:14.03,0:20:14.67,Default,SERA,0,0,0,,!هاي
Dialogue: 0,0:20:15.56,0:20:16.29,Default,RAN,0,0,0,,ماذا؟
Dialogue: 0,0:20:16.29,0:20:18.21,Default,MAYAMA,0,0,0,,هل أنتَ بخير؟
Dialogue: 0,0:20:18.21,0:20:20.80,Default,SHINICHI,0,0,0,,.نعم. ستعتني الشّرطة بالبقيّة
Dialogue: 0,0:20:21.42,0:20:24.48,Default,SHINICHI,0,0,0,,.سأترك سيرا معكم\N.إن احتجتُم لأيّ شيء، تكلّموا معها
Dialogue: 0,0:20:24.48,0:20:25.22,Default,MAYAMA,0,0,0,,.حسناً
Dialogue: 0,0:20:25.22,0:20:26.31,Default,RAN,0,0,0,,شينتشي؟
Dialogue: 0,0:20:27.48,0:20:29.34,Default,RAN,0,0,0,,.تبدو شاحباً
Dialogue: 0,0:20:29.34,0:20:31.81,Default,SONOKO,0,0,0,,هل الوَضع بهذا السّوء في الدّاخل؟
Dialogue: 0,0:20:31.81,0:20:35.57,Default,SHINICHI,0,0,0,,.نـ-نعم. لا تدخُلا
Dialogue: 0,0:20:35.89,0:20:36.90,Default,RAN,0,0,0,,شينتشي؟
Dialogue: 0,0:20:36.90,0:20:37.86,Default,SHINICHI,0,0,0,,!لا تتبعيني
Dialogue: 0,0:20:39.93,0:20:42.45,Default,SHINICHI,0,0,0,,.عاد بردي بقوّة
Dialogue: 0,0:20:42.45,0:20:44.58,Default,SHINICHI,0,0,0,,.لا أُريدكِ أن تمرَضي
Dialogue: 0,0:20:44.58,0:20:48.16,Default,SHINICHI,0,0,0,,.يُفترض أن أكون بخيرٍ بعد نوم ليلةٍ جيّد. لا تقلَقي
Dialogue: 0,0:20:49.77,0:20:53.22,Default,SHINICHI,0,0,0,,.لا يُمكنني العودة لأكون كونان أمام ران
Dialogue: 0,0:20:54.22,0:20:55.64,Default,RAN,0,0,0,,...شينتشي
Dialogue: 0,0:21:01.17,0:21:02.05,Default,NAKAMICHI,0,0,0,,!نعم
Dialogue: 0,0:21:02.05,0:21:03.72,Default,NAKAMICHI,0,0,0,,!أوّل خاسر
Dialogue: 0,0:21:03.72,0:21:05.40,Default,STUDENT,0,0,0,,!سُحقاً
Dialogue: 0,0:21:08.58,0:21:10.72,Default,STUDENT,0,0,0,,هل هو سينساي قادمٌ لتفقّدنا؟
Dialogue: 0,0:21:10.72,0:21:11.80,Default,NAKAMICHI,0,0,0,,حقّاً؟
Dialogue: 0,0:21:11.80,0:21:14.08,Default,STUDENT,0,0,0,,.هذا لَيس جيّداً. كودو لَيس هُنا
Dialogue: 0,0:21:14.08,0:21:15.86,Default,STUDENT,0,0,0,,.أجِب على الباب، ناكاميتشي
Dialogue: 0,0:21:16.46,0:21:17.31,Default,NAKAMICHI,0,0,0,,أنا؟
Dialogue: 0,0:21:17.31,0:21:19.89,Default,STUDENT,0,0,0,,.بالتّأكيد. هذه غُرفتك
Dialogue: 0,0:21:19.89,0:21:22.09,Default,STUDENT,0,0,0,,.سنقوم بتنظيف هذا
Dialogue: 0,0:21:24.04,0:21:26.37,Default,NAKAMICHI,0,0,0,,.أنا قادِم
Dialogue: 0,0:21:26.68,0:21:28.61,Default,NAKAMICHI,0,0,0,,.أعتذر، سينساي
Dialogue: 0,0:21:28.61,0:21:29.66,Default,NAKAMICHI,0,0,0,,!هواه
Dialogue: 0,0:21:30.22,0:21:32.13,Default,NAKAMICHI,0,0,0,,.أوه، هذا أنتَ فقط، كودو
Dialogue: 0,0:21:33.19,0:21:35.08,Default,SHINICHI,0,0,0,,.أعتذر، ناكاميتشي
Dialogue: 0,0:21:35.08,0:21:37.88,Default,SHINICHI,0,0,0,,.نسيتُ مِفتاحي داخل الغُرفة
Dialogue: 0,0:21:38.06,0:21:39.41,Default,STUDENT,0,0,0,,.لا تُخفنا هكذا
Dialogue: 0,0:21:39.41,0:21:41.95,Default,STUDENT,0,0,0,,.ظننّا بأنّكَ كنتَ سينساي
Dialogue: 0,0:21:43.10,0:21:44.53,Default,NAKAMICHI,0,0,0,,على أيّة حال، كيف جرى الأمر؟
Dialogue: 0,0:21:44.53,0:21:47.30,Default,NAKAMICHI,0,0,0,,كان يلتقي بالمُمثّلة الرّائعة كوراتشي كيكو؟
Dialogue: 0,0:21:47.30,0:21:50.49,Default,SHINICHI,0,0,0,,.سـ-سأُخبركم عن هذا في الغد
Dialogue: 0,0:21:50.49,0:21:52.62,Default,SHINICHI,0,0,0,,.أنا مُتعَب، لذا سأنام
Dialogue: 0,0:21:53.29,0:21:54.23,Default,SHINICHI,0,0,0,,.لا تُوقِظوني
Dialogue: 0,0:21:54.23,0:21:57.58,Default,NAKAMICHI,0,0,0,,.بجِدّ؟ كنّا نتشوّق للسّماع عن هذا
Dialogue: 0,0:21:57.58,0:22:00.32,Default,STUDENT,0,0,0,,.لا يهمّكَ إلّا المَشاهير، ناكاميتشي
Dialogue: 0,0:22:00.32,0:22:01.15,Default,NAKAMICHI,0,0,0,,.حـ-حسناً، نعم
Dialogue: 0,0:22:01.73,0:22:03.97,Default,STUDENT,0,0,0,,.لنستمرّ باللّعب
Dialogue: 0,0:22:03.97,0:22:06.41,Default,STUDENT,0,0,0,,.فوزكَ قبل قليلٍ لا يُحتسَب، ناكاميتشي
Dialogue: 0,0:22:06.81,0:22:08.53,Default,NAKAMICHI,0,0,0,,لِمَ لا؟
Dialogue: 0,0:22:08.53,0:22:11.67,Default,STUDENT,0,0,0,,.خلَطنا أوراق اللّعب لظنّنا بأنّ سينساي قد أتى لتفقّدنا
Dialogue: 0,0:22:11.88,0:22:15.50,Default,NAKAMICHI,0,0,0,,.إذاً يُمكنكم لَعب بقيّة الجّولة وَحدكم
Dialogue: 0,0:22:18.23,0:22:20.54,Default,NAKAMICHI,0,0,0,,هل أنتَ بخير، كودو؟
Dialogue: 0,0:22:20.54,0:22:21.97,Default,STUDENT,0,0,0,,.أُترُكه و شأنه
Dialogue: 0,0:22:21.97,0:22:25.25,Default,STUDENT,0,0,0,,.يشعر بالحماس فقط لأنّه تمكّن من رُؤية زوجته ثانيةً أخيراً
Dialogue: 0,0:22:25.25,0:22:26.49,Default,NAKAMICHI,0,0,0,,.أوه، صحيح
Dialogue: 0,0:22:26.49,0:22:27.62,Default,STUDENT,0,0,0,,!ران
Dialogue: 0,0:22:27.62,0:22:30.69,Default,STUDENT,0,0,0,,!شينتشي! إشتقتُ لك
Dialogue: 0,0:22:31.91,0:22:34.51,Default,CONAN,0,0,0,,.أولئكَ الحمقى يفعلون ما يشاؤون دائماً
Dialogue: 0,0:22:34.88,0:22:36.56,Default,CONAN,0,0,0,,.هاي، يُمكنكَ الخُروج الآن
Dialogue: 0,0:22:37.16,0:22:41.57,Default,HEIJI,0,0,0,,.لتعلَم فقط، كودو، أنتَ مَدينٌ لي بالكثير على هذا
Dialogue: 0,0:22:41.76,0:22:45.73,Default,CONAN,0,0,0,,.نعم، أعلَم. تأكّد من ألّا يكتشف أحدٌ هذا
Dialogue: 0,0:22:45.73,0:22:47.42,Default,HEIJI,0,0,0,,.يُمكنكَ الإعتماد عليّ
Dialogue: 0,0:22:50.50,0:22:52.79,Default,NAKAMICHI,0,0,0,,.أوه، صحيح. هاي، كودو
Dialogue: 0,0:22:53.07,0:22:57.61,Default,NAKAMICHI,0,0,0,,.قبل أن تنام، أخبرنا عن اعترافكَ بمَشاعركَ لموري في لندن
Dialogue: 0,0:23:00.63,0:23:02.63,Default,NAKAMICHI,0,0,0,,.لا تكُن خجولاً، كودو
Dialogue: 0,0:23:02.63,0:23:04.26,Default,NAKAMICHI,0,0,0,,لِم تنَم بعد، صحيح؟
Dialogue: 0,0:23:04.66,0:23:07.40,Default,NAKAMICHI,0,0,0,,هل قبّلتُما بعضكما؟
Dialogue: 0,0:23:07.86,0:23:10.24,Default,NAKAMICHI,0,0,0,,.إن لَم تُخبرنا، سأنزع الأغطية
Dialogue: 0,0:23:10.24,0:23:14.56,Default,HEIJI,0,0,0,,.نعم. بالتّأكيد قبّلنا بعضنا، أيّها المُغفّل
Dialogue: 0,0:23:15.45,0:23:17.09,Default,STUDENT,0,0,0,,لَـ-لَقد فعلاها حقّاً؟
Dialogue: 0,0:23:17.09,0:23:17.90,Default,STUDENT,0,0,0,,قبّلا بعضهما؟
Dialogue: 0,0:23:18.36,0:23:20.40,Default,NAKAMICHI,0,0,0,,لِمَ تتكلّم بلَكنة كانساي؟
Dialogue: 0,0:23:20.83,0:23:23.27,Default,HEIJI,0,0,0,,عندما تكون في روما، إفعل كما يفعل الرّومان، ألا تعلَم؟
Dialogue: 0,0:23:23.27,0:23:26.16,Default,HEIJI,0,0,0,,.من الأفضل أن تتعلّموا كيف تتكلّمون بلَكنة كانساي أيضاً
Dialogue: 0,0:23:26.16,0:23:28.03,Default,NAKAMICHI,0,0,0,,...أوه، بالتّأكيد
Dialogue: 0,0:23:28.22,0:23:29.77,Default,STUDENT,0,0,0,,قبّلا بعضهما؟
Dialogue: 0,0:23:29.77,0:23:30.68,Default,STUDENT,0,0,0,,.مَحظوظ
Dialogue: 0,0:23:30.68,0:23:31.91,Default,STUDENT,0,0,0,,.مَحظوظ
Dialogue: 0,0:23:32.96,0:23:37.69,Default,CONAN,0,0,0,,.من الأفضل أن أُبقي مُغيّر صوتي معي بدءاً من الغد
Dialogue: 0,0:23:38.54,0:23:42.54,Default,CONAN,0,0,0,,.إتّباع قوانين هايبارا لَيس سهلاً
Dialogue: 0,0:23:43.13,0:23:44.32,Default,HAIBARA,0,0,0,,.إسمع جيّداً
Dialogue: 0,0:23:44.32,0:23:46.30,Default,HAIBARA,0,0,0,,.هذه القوانين الـ3 مُهمّة
Dialogue: 0,0:23:47.02,0:23:50.34,Default,HAIBARA,0,0,0,,.لا تأخذ الجّرعة التّالية مُباشرةً بعد تلاشي تأثير الدّواء
Dialogue: 0,0:23:50.34,0:23:52.43,Default,HAIBARA,0,0,0,,.يجب أن تنتظر لـ8 ساعات
Dialogue: 0,0:23:52.91,0:23:57.90,Default,HAIBARA,0,0,0,,.فكّر بخُطّةٍ حتّى لا يُلاحظ من حولكَ بأنّك تتحوّل إلى طفل
Dialogue: 0,0:23:58.47,0:24:03.02,Default,HAIBARA,0,0,0,,.لا تجذِب الإنتباه نحوكَ و أنتَ كودو شينتشي
Dialogue: 0,0:24:03.43,0:24:05.74,Default,HAIBARA,0,0,0,,.لا تتغزّل كثيراً
Dialogue: 0,0:24:06.91,0:24:08.32,Default,CONAN,0,0,0,,لا أتغزّل؟
Dialogue: 0,0:24:08.90,0:24:11.21,Default,CONAN,0,0,0,,ألَم تكُن 4 أشياء؟
Dialogue: 0,0:24:11.21,0:24:14.05,Default,HAIBARA,0,0,0,,.حسناً، الـ4 غير مُهمّة
Dialogue: 0,0:24:14.46,0:24:19.74,Default,HAIBARA,0,0,0,,.لكن اتّباع الـ3 الأُولى هي شرطي لإعطائكَ ترياق عقار أبتوكسي 4869
Dialogue: 0,0:24:19.74,0:24:21.85,Default,CONAN,0,0,0,,.بعد 8 ساعاتٍ أُخرى
Dialogue: 0,0:24:21.85,0:24:23.78,Default,CONAN,0,0,0,,.سيكون هذا طويلاً
Dialogue: 0,0:24:25.12,0:24:28.66,Default,CONAN,0,0,0,,.أوه، صحيح. يجدُر بي أن أُري هاتوري
Dialogue: 0,0:24:34.10,0:24:34.92,Default,HEIJI,0,0,0,,هاه؟
Dialogue: 0,0:24:35.69,0:24:36.88,Default,HEIJI,0,0,0,,رسالة؟
Dialogue: 0,0:24:39.51,0:24:40.65,Default,HEIJI,0,0,0,,ما هذه؟
Dialogue: 0,0:24:40.98,0:24:42.49,Default,HEIJI,0,0,0,,شيفرة؟
Dialogue: 0,0:24:45.01,0:24:46.15,Default,AYANOKOJI,0,0,0,,.فهمت
Dialogue: 0,0:24:46.58,0:24:50.95,Default,AYANOKOJI,0,0,0,,هل ذكرَني مُتحرّي المدرسة الثّانويّة شينتشي كن؟
Dialogue: 0,0:24:50.95,0:24:54.66,Default,SERA,0,0,0,,.نعم. قال بألّا نقلَق بما أنّكَ مُفتّشٌ ذكيّ
Dialogue: 0,0:24:55.58,0:24:59.00,Caracters,TEXT,0,0,0,,{\fad(250,250)\pos(644,599)}أيانوكوجي فوميمارو (28) عاماً\Nمُفتّشٌ في القسم الأوّل من شُرطة كيوتو
Dialogue: 0,0:24:55.61,0:24:57.46,Default,AYANOKOJI,0,0,0,,{\an8}.أُقدّر ذلك
Dialogue: 0,0:24:57.46,0:24:59.17,Default,AYANOKOJI,0,0,0,,{\an8}.هذا غريبٌ مع ذلك
Dialogue: 0,0:24:59.62,0:25:02.21,Default,AYANOKOJI,0,0,0,,.لَم ألتقي بكودو كن سابقاً أبداً
Dialogue: 0,0:25:02.21,0:25:04.42,Default,SERA,0,0,0,,.لَديه سنجابٌ كحيوانٍ أليفٍ بالفِعل
Dialogue: 0,0:25:04.81,0:25:07.49,Default,AYANOKOJI,0,0,0,,.رُبّما أخبرَه كونان كن عنّي
Dialogue: 0,0:25:07.49,0:25:12.32,Default,SERA,0,0,0,,هل يجدُر بشُرطيٍّ إحضار حيوانٍ أليفٍ إلى مَسرَح جريمة؟
Dialogue: 0,0:25:12.68,0:25:15.93,Default,AYANOKOJI,0,0,0,,.هذه جريمة قتلٍ وَحشيّة
Dialogue: 0,0:25:16.15,0:25:20.62,Default,AYANOKOJI,0,0,0,,.لَم يُطعَن في قلبه فقط، بل لَديه كدمَتان على رأسه
Dialogue: 0,0:25:21.08,0:25:24.82,Default,AYANOKOJI,0,0,0,,.سيحتاج الأمر بعض الوَقت لفحص مَسرَح جريمة
Dialogue: 0,0:25:25.47,0:25:29.32,Default,AYANOKOJI,0,0,0,,هل يُمكنكم الإنتظار في غُرفكم رجاءً؟
Dialogue: 0,0:25:29.70,0:25:34.11,Default,AYANOKOJI,0,0,0,,.بعد كلّ شيء، الضّحيّة و المُشتبه بهم جميعاً من المَشاهير
Dialogue: 0,0:25:34.82,0:25:38.62,Default,AYANOKOJI,0,0,0,,.وَاثقٌ من أنّه ستكون هناك جلَبةٌ كبيرةٌ صباح الغد
Dialogue: 0,0:25:57.81,0:25:58.73,Default,CONAN,0,0,0,,...هذا مُؤلِم
Dialogue: 0,0:25:59.37,0:26:02.73,Default,CONAN,0,0,0,,.بالتّفكير بالأمر، نمتُ تحت السّرير
Dialogue: 0,0:26:06.46,0:26:08.94,Default,CONAN,0,0,0,,.مرّت 8 ساعات
Dialogue: 0,0:26:08.94,0:26:10.84,Default,CONAN,0,0,0,,.حان وَقت أخذي للدّواء
Dialogue: 0,0:26:25.86,0:26:30.01,Default,SHINICHI,0,0,0,,هل سأتمكّن من الإستمرار حتّى نهاية الرّحلة المدرسيّة؟
Dialogue: 0,0:26:31.59,0:26:36.96,Default,SHINICHI,0,0,0,,ألَم يعودوا إلى غُرفهم؟
Dialogue: 0,0:26:36.96,0:26:38.25,Default,SHINICHI,0,0,0,,.يا إلهي
Dialogue: 0,0:26:40.65,0:26:41.92,Default,SHINICHI,0,0,0,,.إنّها من كيكو سان
Dialogue: 0,0:26:42.85,0:26:45.86,Title,TEXT,0,0,0,,من: كوراتشي كيكو
Dialogue: 0,0:26:42.85,0:26:45.86,Title,TEXT,0,0,0,,الموضوع: لا موضوع
Dialogue: 0,0:26:42.85,0:26:45.86,Title,TEXT,0,0,0,,!شينتشي كن، ساعدني\N!!أغاتا كن في وَرطةٍ الآن\N!تعال إلى الغُرفة 1504
Dialogue: 0,0:26:44.06,0:26:45.86,Default,SHINICHI,0,0,0,,!هل أصاب مَكروهٌ أغاتا سان؟
Dialogue: 0,0:26:47.39,0:26:49.50,Default,SHINICHI,0,0,0,,!هاي، هاتوري! إستيقظ
Dialogue: 0,0:26:50.05,0:26:52.11,Default,HEIJI,0,0,0,,...كلّا، لا يُمكنني أن آكل أكثر
Dialogue: 0,0:26:52.31,0:26:53.74,Default,SHINICHI,0,0,0,,!هاتوري، إنّها قضيّة
Dialogue: 0,0:26:54.12,0:26:55.02,Default,HEIJI,0,0,0,,هاه؟
Dialogue: 0,0:26:55.95,0:26:59.74,Default,AYANOKOJI,0,0,0,,هل قال أغاتا سان هذا حقّاً؟
Dialogue: 0,0:26:59.93,0:27:04.00,Default,KEIKO,0,0,0,,.نعم. كان يصرُخ بصوتٍ عالٍ حتّى أنّني تمكّنتُ من سماعه من الغُرفة المُجاورة
Dialogue: 0,0:27:04.31,0:27:06.69,Default,KEIKO,0,0,0,,!"كان يصرُخ، "ساعدوني! سيقتُلني
Dialogue: 0,0:27:06.69,0:27:08.06,Default,IHAYA,0,0,0,,حقّاً؟
Dialogue: 0,0:27:08.06,0:27:09.17,Default,SHINICHI,0,0,0,,!كيكو سان
Dialogue: 0,0:27:09.45,0:27:10.64,Default,KEIKO,0,0,0,,.شينتشي كن
Dialogue: 0,0:27:10.64,0:27:13.17,Default,AYANOKOJI,0,0,0,,هل أنتَ كودو شينتشي كن؟
Dialogue: 0,0:27:13.51,0:27:14.32,Default,AYANOKOJI,0,0,0,,أوه؟
Dialogue: 0,0:27:14.32,0:27:16.76,Default,AYANOKOJI,0,0,0,,الصّبيّ إلى جانبكَ هو
Dialogue: 0,0:27:17.17,0:27:21.37,Default,AYANOKOJI,0,0,0,,.إبن رئيس شُرطة أوكاسا، هاتوري هيجي كن
Dialogue: 0,0:27:21.37,0:27:22.78,Default,AYANOKOJI,0,0,0,,ماذا تفعل هُنا؟
Dialogue: 0,0:27:22.78,0:27:25.39,Default,HEIJI,0,0,0,,.د-دعاني كودو لكي آتي و أُمضي الوَقت معه
Dialogue: 0,0:27:25.39,0:27:26.52,Default,HEIJI,0,0,0,,.تصادف وُجودي هُنا فقط
Dialogue: 0,0:27:26.95,0:27:28.66,Default,HEIJI,0,0,0,,على أيّة حال، ماذا حصل؟
Dialogue: 0,0:27:28.66,0:27:32.53,Default,AYANOKOJI,0,0,0,,.تمّ سماع أغاتا سان يصرُخ بشيءٍ غريبٍ من داخل غُرفته
Dialogue: 0,0:27:32.77,0:27:35.15,Default,AYANOKOJI,0,0,0,,.مُوَظّف الخدَمات هذا يفتح الباب لنا
Dialogue: 0,0:27:35.15,0:27:36.16,Default,BELLHOP,0,0,0,,.إنّه مَفتوح
Dialogue: 0,0:27:36.16,0:27:37.38,Default,AYANOKOJI,0,0,0,,.شُكراً لك
Dialogue: 0,0:27:37.38,0:27:43.62,Default,AYANOKOJI,0,0,0,,.يرى كوابيس على الأرجح بعد رُؤيته لمَسرَح جريمة ليلة البارحة و ينوح في منامه
Dialogue: 0,0:27:44.36,0:27:46.87,Default,AYANOKOJI,0,0,0,,أغاتا سان، هل أنتَ بخير؟
Dialogue: 0,0:27:47.24,0:27:48.54,Default,AYANOKOJI,0,0,0,,.سندخل
Dialogue: 0,0:27:49.38,0:27:50.67,Default,AYANOKOJI,0,0,0,,.أغاتا سان
Dialogue: 0,0:27:53.57,0:27:55.96,Default,AGATA,0,0,0,,.أ-أرجوكَ لا تفعل
Dialogue: 0,0:27:56.75,0:27:58.72,Default,SHINICHI,0,0,0,,تـ-تينغو؟
Dialogue: 0,0:27:58.91,0:28:03.06,Default,AGATA,0,0,0,,!سـ-سامحني. سامحني
Dialogue: 0,0:28:03.06,0:28:05.58,Default,HEIJI,0,0,0,,هاي، هل تحمل أيّ سلاح؟
Dialogue: 0,0:28:05.58,0:28:06.06,Default,AYANOKOJI,0,0,0,,...كلّا
Dialogue: 0,0:28:06.32,0:28:09.19,Default,AGATA,0,0,0,,!تـ-تراجع! تراجع
Dialogue: 0,0:28:09.19,0:28:09.86,Default,SHINICHI,0,0,0,,!سُحقاً
Dialogue: 0,0:28:10.79,0:28:12.20,Default,AGATA,0,0,0,,!تراجع
Dialogue: 0,0:28:16.92,0:28:18.19,Default,MAYAMA,0,0,0,,!لَـ-لَقد اختفى
Dialogue: 0,0:28:18.19,0:28:19.70,Default,IHAYA,0,0,0,,!إشتعلَ و اختفى
Dialogue: 0,0:28:19.70,0:28:20.87,Default,KEIKO,0,0,0,,!مُـ-مُستحيل
Dialogue: 0,0:28:21.62,0:28:23.04,Default,HEIJI,0,0,0,,...هاي، كودو
Dialogue: 0,0:28:24.42,0:28:27.87,Default,HEIJI,0,0,0,,لَسنا مانزال نائمَين، صحيح؟
Dialogue: 0,0:28:39.47,0:28:40.99,Default,STUDENT,0,0,0,,هل نمتِ بعدها؟
Dialogue: 0,0:28:40.99,0:28:44.29,Default,STUDENT,0,0,0,,.كلّا، لكنّني جائعة
Dialogue: 0,0:28:44.29,0:28:46.25,Default,STUDENT,0,0,0,,إلى أين سنذهب اليوم؟
Dialogue: 0,0:28:46.25,0:28:48.23,Default,STUDENT,0,0,0,,.سنزور أشهر المَعالِم
Dialogue: 0,0:28:49.12,0:28:49.94,Default,SERA,0,0,0,,تينغو؟
Dialogue: 0,0:28:50.52,0:28:53.45,Default,SERA,0,0,0,,ظهرَ تينغو في غُرفة أغاتا سان؟
Dialogue: 0,0:28:53.98,0:28:56.87,Default,SHINICHI,0,0,0,,.نعم، كفلمٍ بمُؤثّراتٍ خاصّة
Dialogue: 0,0:28:57.41,0:29:01.16,Default,SERA,0,0,0,,إذاً، ماذا فعلَ التينغو بعدها؟
Dialogue: 0,0:29:01.67,0:29:05.95,Default,SHINICHI,0,0,0,,.عندما رمى عليه أغاتا سان مِطفئة سجائره، إشتعلَ و اختفى
Dialogue: 0,0:29:05.95,0:29:07.89,Default,SERA,0,0,0,,إشتعلَ و اختفى؟
Dialogue: 0,0:29:07.89,0:29:09.76,Default,SERA,0,0,0,,.يبدو هذا كفِعل مُؤثّراتٍ خاصّةٍ بالفِعل
Dialogue: 0,0:29:10.27,0:29:13.80,Default,SHINICHI,0,0,0,,،وِفقاً لأقواله، بعد مَقتل نيشيكي سان
Dialogue: 0,0:29:14.33,0:29:17.04,Default,SHINICHI,0,0,0,,.عاد إلى غُرفته ليرتاح
Dialogue: 0,0:29:17.44,0:29:19.00,Default,SHINICHI,0,0,0,,،لعدَم تمكّنه من النّوم
Dialogue: 0,0:29:19.00,0:29:21.68,Default,SHINICHI,0,0,0,,،قرّر أن يشرَب في الحانة
Dialogue: 0,0:29:21.92,0:29:24.04,Default,SHINICHI,0,0,0,,.لكنّه شرب الكثير و ثمل
Dialogue: 0,0:29:30.50,0:29:34.49,Default,SHINICHI,0,0,0,,.عندما استعاد وَعيه، كان قد عاد إلى غُرفته
Dialogue: 0,0:29:35.78,0:29:40.81,Default,SHINICHI,0,0,0,,،عندما أشعل سيجارةً ليُدخّن
Dialogue: 0,0:29:44.53,0:29:48.40,Default,SHINICHI,0,0,0,,.شعرَ بشيءٍ غريبٍ و نظرَ عالياً إلى السّقف
Dialogue: 0,0:29:53.85,0:29:57.84,Default,SHINICHI,0,0,0,,.سمعَته كيكو سان من الغُرفة المُجاورة
Dialogue: 0,0:29:57.84,0:30:02.73,Default,SHINICHI,0,0,0,,.وَصلنا بعد أن توَاصلَت معنا و رأينا التينغو أيضاً
Dialogue: 0,0:30:04.42,0:30:07.48,Default,SERA,0,0,0,,،إن عاد إلى غُرفته في وَقتٍ ما
Dialogue: 0,0:30:07.48,0:30:13.14,Default,SERA,0,0,0,,.من المُمكن أن يكون أحدهم قد أخذَ أغاتا سان الثّمل إلى غُرفته و أعدّ شيئاً ما
Dialogue: 0,0:30:13.14,0:30:16.33,Default,SHINICHI,0,0,0,,.لكنّنا لَم نجِد أيّ دلالاتٍ على خِدعة
Dialogue: 0,0:30:16.33,0:30:17.56,Default,SERA,0,0,0,,ماذا عن الشّيفرة إذاً؟
Dialogue: 0,0:30:17.56,0:30:19.76,Default,SERA,0,0,0,,كانت هناك شيفرةٌ جديدة، صحيح؟
Dialogue: 0,0:30:19.76,0:30:22.17,Default,SHINICHI,0,0,0,,.لَم تُوجد وَاحدةٌ منها أيضاً
Dialogue: 0,0:30:23.87,0:30:24.91,Default,SHINICHI,0,0,0,,...لكن
Dialogue: 0,0:30:26.33,0:30:28.81,Default,SHINICHI,0,0,0,,،مثل نيشيكي المَقتول...
Dialogue: 0,0:30:28.81,0:30:32.13,Default,SHINICHI,0,0,0,,.كان على رأس أغاتا سان كدمتان
Dialogue: 0,0:30:32.52,0:30:34.21,Default,SERA,0,0,0,,،بالحديث عن الكدمات
Dialogue: 0,0:30:34.21,0:30:38.39,Default,SERA,0,0,0,,.قالَت كوراتشي كيكو سان بأنّها أُصيبَت بكدماتٍ على رأسها خلال التّمثيل
Dialogue: 0,0:30:38.86,0:30:40.10,Default,SHINICHI,0,0,0,,.نعم
Dialogue: 0,0:30:40.10,0:30:43.80,Default,SHINICHI,0,0,0,,طلبَت من المُخرِج إعادة تصوير المَشهد الأخير
Dialogue: 0,0:30:43.80,0:30:46.50,Default,SHINICHI,0,0,0,,.و أُصيبَت بكدماتٍ وَقتها عندما تعثّرَت
Dialogue: 0,0:30:48.85,0:30:52.60,Default,SHINICHI,0,0,0,,،عندما رأيتُها قبل قليل، كان جبينها مايزال مُتوَرّماً
Dialogue: 0,0:30:52.60,0:30:55.48,Default,SHINICHI,0,0,0,,.لذا من الصّحيح على الأرجح بأنّها تعثّرَت
Dialogue: 0,0:30:56.54,0:31:00.87,Default,SHINICHI,0,0,0,,.قالَت بأنّه بتذكّر الأمر، من المُمكن أن يكون أحدٌ قد دفعها
Dialogue: 0,0:31:01.21,0:31:05.75,Default,SHINICHI,0,0,0,,.عندما تعثّرَت، سخرَت من كيف أنّها بدَت مثل كوبوتوري جيسان من الحكاية الشّعبيّة
Dialogue: 0,0:31:05.75,0:31:09.88,Default,SERA,0,0,0,,.ماذا؟ ظننتُ بأنّ كدمات كوبوتوري جيسان كانت على خدّيه
Dialogue: 0,0:31:10.24,0:31:14.26,Default,SHINICHI,0,0,0,,.يبدو بأنّ كلّ منطقةٍ تملك نُسختها من القصّة
Dialogue: 0,0:31:14.89,0:31:21.14,Default,SHINICHI,0,0,0,,على أيّة حال، هل كانت الدّماء على السّقف في مَسرَح جريمة قتل نيشيكي سان دِماؤه؟
Dialogue: 0,0:31:21.45,0:31:22.41,Default,SERA,0,0,0,,.كلّا
Dialogue: 0,0:31:22.41,0:31:28.59,Default,SERA,0,0,0,,،فحصَتها الشّرطة و وَجدَت بأنّه يُوجد في مركز رشق الدّم فقط
Dialogue: 0,0:31:28.59,0:31:33.69,Default,SERA,0,0,0,,،بمَعنىً آخر، القليل الذي نقّطَ على كتفكَ كان من دِماء نيشيكي سان
Dialogue: 0,0:31:33.99,0:31:37.96,Default,SERA,0,0,0,,.و البقيّة كان دهاناً مَرشوشاً على السّقف سابقاً
Dialogue: 0,0:31:40.22,0:31:41.88,Default,SHINICHI,0,0,0,,.عرفتُ ذلك
Dialogue: 0,0:31:41.88,0:31:47.78,Default,SERA,0,0,0,,.أيضاً، لَم يجدوا النّصل الذي استُخدِمَ لطعن نيشيكي سان في مَسرَح الجّريمة
Dialogue: 0,0:31:48.19,0:31:52.92,Default,SERA,0,0,0,,.ظننتُه سيكون مَدفوناً تحت الصّفحات المُبعثرة على الأرض
Dialogue: 0,0:31:54.02,0:31:57.47,Default,SHINICHI,0,0,0,,.ممّا يعني بأنّ السّلاح مازال مع الجّاني
Dialogue: 0,0:32:01.19,0:32:03.60,Default,SHINICHI,0,0,0,,ر-ران، ما الخطب؟
Dialogue: 0,0:32:03.84,0:32:06.22,Default,RAN,0,0,0,,ما الخطب؟
Dialogue: 0,0:32:06.22,0:32:09.79,Default,RAN,0,0,0,,!يقولون بأنّنا قبّلنا بعضنا بقوّةٍ في لندن
Dialogue: 0,0:32:09.79,0:32:11.19,Default,RAN,0,0,0,,!ماذا يحصل؟
Dialogue: 0,0:32:11.36,0:32:12.47,Default,SHINICHI,0,0,0,,!ماذا؟
Dialogue: 0,0:32:13.32,0:32:17.53,Default,SONOKO,0,0,0,,.يُخبر ناكاميتشي كن الجّميع بهذا بلَكنة كانساي غريبة
Dialogue: 0,0:32:17.53,0:32:22.03,Default,SONOKO,0,0,0,,."يقول، "قبّلَ هذان الطّفلان بعضهما بالفِعل
Dialogue: 0,0:32:22.32,0:32:26.54,Default,SHINICHI,0,0,0,,.كان ذلك صوتي، لكنّه لَم أكُن أنا في الوَاقع
Dialogue: 0,0:32:26.85,0:32:30.85,Default,RAN,0,0,0,,ماذا؟ كان صوتكَ لكن لَم يكُن أنت؟
Dialogue: 0,0:32:30.85,0:32:33.17,Default,RAN,0,0,0,,!لا تتكلّم بمَنطقيّة
Dialogue: 0,0:32:33.55,0:32:35.66,Default,RAN,0,0,0,,{\a6}!فسّر ما قُلت، شينتشي
Dialogue: 0,0:32:34.15,0:32:36.72,Default,SERA,0,0,0,,لِمَ يتكلّم بلَكنة كانساي؟
Dialogue: 0,0:32:36.09,0:32:37.32,Default,SHINICHI,0,0,0,,{\a6}أُفسّر ما قُلت؟
Dialogue: 0,0:32:36.72,0:32:37.64,Default,SONOKO,0,0,0,,.لَستُ وَاثقة
Dialogue: 0,0:32:37.32,0:32:40.07,Default,SHINICHI,0,0,0,,{\a6}.الأهمّ، لنأكل
Dialogue: 0,0:32:37.64,0:32:42.47,Default,SONOKO,0,0,0,,."على ما يبدو، أخبرَه شينتشي كن "عندما تكون في روما، إفعل كما يفعل الرّومان
Dialogue: 0,0:32:40.07,0:32:43.44,Default,SHINICHI,0,0,0,,{\a6}.الطّعام لَذيذ\N.السّجق هو الأفضل
Dialogue: 0,0:32:42.86,0:32:44.10,Default,SERA,0,0,0,,حقّاً؟
Dialogue: 0,0:32:43.44,0:32:44.55,Default,RAN,0,0,0,,{\a6}!توَقّف عن مُحاولة خِداعي
Dialogue: 0,0:32:44.55,0:32:45.18,Default,SERA,0,0,0,,.هاي
Dialogue: 0,0:32:46.74,0:32:50.68,Default,SERA,0,0,0,,لِمَ كُمّاكَ مَطويّان للأعلى هكذا؟
Dialogue: 0,0:32:50.68,0:32:51.19,Default,SHINICHI,0,0,0,,هاه؟
Dialogue: 0,0:32:51.65,0:32:55.39,Default,SERA,0,0,0,,ألَن تقوم بالعادة برَفع كُمّيكَ للأعلى هكذا إن كانت تُعيقك؟
Dialogue: 0,0:32:55.39,0:32:57.36,Default,SHINICHI,0,0,0,,.لَم أُفكّر بهذا حقّاً
Dialogue: 0,0:32:57.88,0:33:03.04,Default,SERA,0,0,0,,.كما لَو أنّ طفلاً صغيراً كان يرتدي تلك السّترة
Dialogue: 0,0:33:04.52,0:33:07.76,Default,SHINICHI,0,0,0,,.أ-أيّتها الغبيّة، من الوَاضح بأنّ هذا لَيس ما حصل
Dialogue: 0,0:33:09.57,0:33:12.08,Default,RAN,0,0,0,,.هذا مُلصقٌ للفلم الذي تُمثّل فيه كيكو سان
Dialogue: 0,0:33:12.08,0:33:13.04,Title,TEXT,0,0,0,,العرض في المَسرَح الوَطنيّ بتاريخ 11/10
Dialogue: 0,0:33:13.05,0:33:15.59,Title,TEXT,0,0,0,,المُخرِج: ماياما مينيتو
Dialogue: 0,0:33:13.05,0:33:15.59,Title,TEXT,0,0,0,,كاتب النّصّ: نيشيكي تاروبو
Dialogue: 0,0:33:13.05,0:33:15.59,Title,TEXT,0,0,0,,المُمثّل: إيهايا شينيا
Dialogue: 0,0:33:13.05,0:33:15.59,Title,TEXT,0,0,0,,المُمثّلة المُساعدة: كوراتشي كيكو
Dialogue: 0,0:33:13.05,0:33:15.59,Title,TEXT,0,0,0,,الموسيقى: أغاتا ريكي
Dialogue: 0,0:33:13.09,0:33:15.59,Default,SERA,0,0,0,,التينغو الأحمر المُقاتِل"، هاه؟"
Dialogue: 0,0:33:13.97,0:33:15.59,Title,TEXT,0,0,0,,التينغو الأحمر المُقاتِل
Dialogue: 0,0:33:15.92,0:33:21.57,Default,SONOKO,0,0,0,,.لكن نظراً لما حصلَ لكاتب النّصّ نيشيكي سان، قد لا يتمّ افتتاحه
Dialogue: 0,0:33:21.57,0:33:22.51,Default,RAN,0,0,0,,.نعم
Dialogue: 0,0:33:22.96,0:33:25.00,Default,SERA,0,0,0,,.أتسائل عمّا هو
Dialogue: 0,0:33:25.93,0:33:27.54,Default,SHINICHI,0,0,0,,.تجري أحداثه في فترة إيدو
Dialogue: 0,0:33:28.38,0:33:32.25,Default,SHINICHI,0,0,0,,شُرطيٌّ من مَكتب قضاء كيوتو يُدعى كورانوسكي
Dialogue: 0,0:33:32.25,0:33:38.02,Default,SHINICHI,0,0,0,,.يسأل القاضي إن كان بإمكانه عرض أيّ شيءٍ غير عاديٍّ على الجنرال
Dialogue: 0,0:33:38.56,0:33:40.45,Default,SHINICHI,0,0,0,,،بسماع ذلك
Dialogue: 0,0:33:40.45,0:33:45.16,Default,SHINICHI,0,0,0,,...تُهدي زوجته مانا زوجها وَرقة نبتةٍ مُجفّفةٍ ذهبيّةً و تقول له
Dialogue: 0,0:33:45.84,0:33:49.21,Default,MANA,0,0,0,,.وَجدتّ وَرقة النّبتة هذه بينما كنتُ أبحث عن الخُضراوات في الجّبال
Dialogue: 0,0:33:49.21,0:33:52.74,Default,MANA,0,0,0,,،بما أنّها بدَت مُبجّلة
Dialogue: 0,0:33:52.74,0:33:55.17,Default,MANA,0,0,0,,.دعوتُ لها دائماً بيَدان مُتشابكتان، لكنّني أحضرتُها لك
Dialogue: 0,0:33:55.34,0:33:56.88,Default,KURANOSUKE,0,0,0,,.إنّها غير عاديّةٍ بالتّأكيد
Dialogue: 0,0:33:56.88,0:33:59.23,Default,KURANOSUKE,0,0,0,,.وَاثقٌ من أنّ الجنرال سيُسعَد
Dialogue: 0,0:33:59.23,0:34:02.67,Default,SHINICHI,0,0,0,,.بعد قوله هذا، يشكُر كورانوسكي مانا
Dialogue: 0,0:34:02.97,0:34:07.45,Default,SHINICHI,0,0,0,,لكن بعد ذلك اليوم، بدأت وُحوشٌ غريبةٌ بالظّهور كلّ ليلةٍ
Dialogue: 0,0:34:07.45,0:34:09.64,Default,SHINICHI,0,0,0,,.في كيوتو و تلتهم البَشر
Dialogue: 0,0:34:10.27,0:34:15.67,Default,SHINICHI,0,0,0,,كانت وَرقة النّبتة المُجفّفة تلك ختماً سحريّاً إستخدَمه تينغو\N.قبل فترةٍ طويلةٍ لاحتجاز الوُحوش
Dialogue: 0,0:34:16.19,0:34:20.12,Default,SHINICHI,0,0,0,,.بينما كان ذلك يحصل، ظهرَ التينغو في أحلام كورانوسكي
Dialogue: 0,0:34:20.12,0:34:23.84,Default,TENGU,0,0,0,,يخشى الوَحوش من أنّ من كسرَ الختم عليهم
Dialogue: 0,0:34:23.84,0:34:27.19,Default,TENGU,0,0,0,,.سيأتي لاحتجازهم ثانيةً
Dialogue: 0,0:34:27.19,0:34:31.45,Default,TENGU,0,0,0,,.يبحثون عنها لكي يقتُلوها
Dialogue: 0,0:34:31.95,0:34:36.80,Default,TENGU,0,0,0,,إن أخفيتَ وَرقة النّبتة المُجفّفة الذّهبيّة في صدر زوجتكَ
Dialogue: 0,0:34:36.80,0:34:38.95,Default,TENGU,0,0,0,,،و سمحتَ للوُحوش بالتهامها
Dialogue: 0,0:34:38.95,0:34:41.46,Default,TENGU,0,0,0,,.سيُحتجَزون ثانيةً
Dialogue: 0,0:34:41.89,0:34:44.75,Default,KURANOSUKE,0,0,0,,!لَن أفعل ذلك حتّى لَو تسبّب بقتلي
Dialogue: 0,0:34:44.75,0:34:47.85,Default,TENGU,0,0,0,,.فهمت. أنتَ مُستعدٌّ للمُخاطرة بحياتك
Dialogue: 0,0:34:47.85,0:34:51.47,Default,TENGU,0,0,0,,.إذاً خُذ وُرقة النّبتة المُجفّفة و اقفز من كيوميزو بوتاي
Dialogue: 0,0:34:52.06,0:34:55.48,Default,TENGU,0,0,0,,.سيُفتَح لكَ الطّريق
Dialogue: 0,0:34:56.22,0:34:57.92,Default,SHINICHI,0,0,0,,،مُصدّقاً لكلمات التينغو
Dialogue: 0,0:34:57.92,0:35:02.97,Default,SHINICHI,0,0,0,,.يقفز كورانوسكي من كيوميزو بوتاي و يُصبح تينغو ذهبيّ
Dialogue: 0,0:35:03.26,0:35:06.16,Default,SHINICHI,0,0,0,,،يُنقِذ مانا من الوُحوش عندما كانوا على وَشك أن يلتَهموها
Dialogue: 0,0:35:06.16,0:35:09.20,Default,SHINICHI,0,0,0,,.و يهزِمهم باستخدام قِوىً سِحريّةً عظيمة
Dialogue: 0,0:35:09.81,0:35:14.65,Default,SHINICHI,0,0,0,,.لكن بما أنّ كورانوسكي قد أصبح تينغو، لَم يعُد بإمكان مانا رُؤيته بعدها
Dialogue: 0,0:35:15.50,0:35:19.66,Default,SHINICHI,0,0,0,,،بينما كانت مانا تبكي بسبب اختفاء زوجها الفُجائيّ
Dialogue: 0,0:35:19.66,0:35:21.90,Default,SHINICHI,0,0,0,,.تسمع صوت كورانوسكي
Dialogue: 0,0:35:23.18,0:35:24.91,Default,KURANOSUKE,0,0,0,,،إن أردتّ أن تريه
Dialogue: 0,0:35:24.91,0:35:28.80,Default,KURANOSUKE,0,0,0,,خُذي زهرة تينغو إلى كيوميزو بوتاي عند غُروب الشّمس
Dialogue: 0,0:35:28.80,0:35:32.09,Default,KURANOSUKE,0,0,0,,.عندما يكون لَون أوراق النّباتات أكثر احمراراً
Dialogue: 0,0:35:32.92,0:35:38.78,Default,SHINICHI,0,0,0,,.تقطِف مانا زهرة حواشي و تذهب إلى كيوميزو بوتاي كما تمّ إخبارها
Dialogue: 0,0:35:39.66,0:35:44.65,Default,SHINICHI,0,0,0,,.يظهر كورانوسكي أمامها كتينغو و يشرَح لمانا ما حصل
Dialogue: 0,0:35:45.28,0:35:47.82,Default,MANA,0,0,0,,لكن لِمَ أخبرتَني بأن آتي في المَساء؟
Dialogue: 0,0:35:47.82,0:35:52.87,Default,MANA,0,0,0,,.لَو أتيتُ عندما كانت الشّمس في السّماء، لأمكننا تمضية وَقتٍ أطوَل معاً
Dialogue: 0,0:35:52.87,0:35:56.30,Default,KURANOSUKE,0,0,0,,،حوّلَ غضبي من الوُحوش وَجهي إلى اللّون الأحمر
Dialogue: 0,0:35:56.68,0:36:00.24,Default,KURANOSUKE,0,0,0,,.و جسدي بأكمله أحمرٌ من دِمائهم
Dialogue: 0,0:36:01.31,0:36:06.80,Default,KURANOSUKE,0,0,0,,.إن كنّا مُحاطين باللّون الأحمر، سيُقلّل هذا من شدّة اللّون قليلاً
Dialogue: 0,0:36:06.80,0:36:11.66,Default,SHINICHI,0,0,0,,،بعد إجابته على أسئلتها، تبادلا قُبلةً وَداعيّة
Dialogue: 0,0:36:12.15,0:36:14.73,Default,SHINICHI,0,0,0,,.و اختفى كورانوسكي في الظّلام المُقترِب
Dialogue: 0,0:36:16.74,0:36:19.27,Default,SHINICHI,0,0,0,,.إنّها قصّةٌ حزينة
Dialogue: 0,0:36:19.43,0:36:20.64,Default,SONOKO,0,0,0,,!هذا مُذهل
Dialogue: 0,0:36:20.64,0:36:23.04,Default,RAN,0,0,0,,كيف تعرف الكثير عنها؟
Dialogue: 0,0:36:23.04,0:36:25.19,Default,SERA,0,0,0,,لَم يُعرَض الفلم بعد، صحيح؟
Dialogue: 0,0:36:25.85,0:36:30.80,Default,SHINICHI,0,0,0,,في الوَاقع، هذا الفلم إعادة إنتاجٍ لفلم تخرّجٍ
Dialogue: 0,0:36:30.80,0:36:33.07,Default,SHINICHI,0,0,0,,.صوّروه في جامعة غيون للفُنون
Dialogue: 0,0:36:34.03,0:36:37.04,Title,TEXT,0,0,0,,قصّة التينغو الأحمر المُقاتِل
Dialogue: 0,0:36:34.26,0:36:37.04,Default,SHINICHI,0,0,0,,.القصّة بأكملها مُتوَفّرةٌ على الإنترنت
Dialogue: 0,0:36:37.37,0:36:43.18,Default,SHINICHI,0,0,0,,،إشتهَروا بسبب مَشروع التّخرّج ذاك
Dialogue: 0,0:36:43.65,0:36:49.55,Default,SHINICHI,0,0,0,,.لذا من الصّعب تخيّل أنّه أحدهم كان مُنزعجاً منه
Dialogue: 0,0:36:51.16,0:36:52.29,Default,RAN,0,0,0,,،بالتّفكير بالأمر
Dialogue: 0,0:36:52.29,0:36:54.60,Default,RAN,0,0,0,,،عندما التقينا بكيكو سان في كيوميزو بوتاي
Dialogue: 0,0:36:55.04,0:36:57.39,Default,RAN,0,0,0,,.أطلقَت مانا زهرةً مَضغوطةً في الرّياح
Dialogue: 0,0:36:59.67,0:37:03.38,Default,RAN,0,0,0,,.رُبّما كانت زهرة حواشي كالتي في القصّة
Dialogue: 0,0:37:03.38,0:37:04.96,Default,SHINICHI,0,0,0,,حقّاً؟
Dialogue: 0,0:37:04.96,0:37:05.73,Default,RAN,0,0,0,,.نعم
Dialogue: 0,0:37:06.05,0:37:10.97,Default,RAN,0,0,0,,."أظنّها قالَت أيضاً، "إنتظر فقط، ديكوري كن. لَن يطول الأمر الآن
Dialogue: 0,0:37:10.97,0:37:12.74,Default,SHINICHI,0,0,0,,ماذا؟ ديكوري كن؟
Dialogue: 0,0:37:13.37,0:37:15.38,Default,SHINICHI,0,0,0,,من هو ديكوري كن؟
Dialogue: 0,0:37:15.38,0:37:17.83,Default,SHINICHI,0,0,0,,.لَم يُوجد أحدٌ بهذا الإسم في قائمة المُشاركين بالعمل
Dialogue: 0,0:37:28.56,0:37:33.32,Default,RAN,0,0,0,,...قبّلَ مانا و كورانوسكي بعضهما عند كيوميزو بوتاي
Dialogue: 0,0:37:40.59,0:37:46.47,Default,RAN,0,0,0,,هل يُريد شينتشي أن نُقبّل بعضنا أيضاً؟
Dialogue: 0,0:38:01.44,0:38:02.75,Default,TEACHER,0,0,0,,.حسناً، جميعكم
Dialogue: 0,0:38:02.75,0:38:06.13,Default,TEACHER,0,0,0,,.يُمكنكم بعد ظُهر اليوم الذّهاب إلى حيث تشاؤون مع مَجموعاتكم
Dialogue: 0,0:38:06.38,0:38:09.50,Default,TEACHER,0,0,0,,تأكّدوا من اتّباع البرنامج الذي خطّطتّم له مع مَجموعتكم
Dialogue: 0,0:38:09.50,0:38:12.29,Default,TEACHER,0,0,0,,.و عودوا إلى الفُندق عند الـ6
Dialogue: 0,0:38:12.29,0:38:14.42,Default,ALL,0,0,0,,.حسناً
Dialogue: 0,0:38:15.33,0:38:17.14,Default,NAKAMICHI,0,0,0,,هل سمعت، كودو؟
Dialogue: 0,0:38:17.48,0:38:21.93,Default,NAKAMICHI,0,0,0,,.إن استخدمتَ عصاة السيلفي في طريق الفُندق، يُمكنكَ النّظر إلى حمّامات النّساء
Dialogue: 0,0:38:21.93,0:38:22.94,Default,SHINCIHI,0,0,0,,حقّاً؟
Dialogue: 0,0:38:22.94,0:38:24.20,Default,NAKAMICHI,0,0,0,,.بجِدّ
Dialogue: 0,0:38:24.20,0:38:29.09,Default,NAKAMICHI,0,0,0,,،صدر سيرا لَيس كبيراً
Dialogue: 0,0:38:30.28,0:38:33.34,Default,NAKAMICHI,0,0,0,,.لكن لابدّ من أنّ صدر موري جنونيّ
Dialogue: 0,0:38:33.34,0:38:34.94,Default,SHINICHI,0,0,0,,.حـ-حسناً، نعم
Dialogue: 0,0:38:36.07,0:38:37.45,Default,NAKAMICHI,0,0,0,,حسناً، نعم؟
Dialogue: 0,0:38:37.45,0:38:40.12,Default,NAKAMICHI,0,0,0,,لَم تُقبّلها فقط بل استحممتَ معها أيضاً؟
Dialogue: 0,0:38:42.48,0:38:44.29,Default,SHINICHI,0,0,0,,.بالتّأكيد لا
Dialogue: 0,0:38:44.29,0:38:45.55,Default,NAKAMICHI,0,0,0,,لِمَ تردّدتّ؟
Dialogue: 0,0:38:45.55,0:38:46.88,Default,NAKAMICHI,0,0,0,,!هيّا الآن، أخبرني
Dialogue: 0,0:38:46.88,0:38:49.04,Default,SHINICHI,0,0,0,,!أخبرتُك، لَم أفعل
Dialogue: 0,0:38:49.66,0:38:51.55,Default,SHINICHI,0,0,0,,.أفعل ككونان أحياناً مع ذلك
Dialogue: 0,0:38:51.55,0:38:52.51,Default,NAKAMICHI,0,0,0,,.إعترف
Dialogue: 0,0:38:52.51,0:38:54.80,Default,NAKAMICHI,0,0,0,,.أخبرني و سأُسامحك
Dialogue: 0,0:38:54.80,0:38:59.43,Default,NAKAMICHI,0,0,0,,.هيّا الآن. إعترف بسرعة
Dialogue: 0,0:39:00.58,0:39:01.53,Default,NAKAMICHI,0,0,0,,.هيّا الآن
Dialogue: 0,0:39:00.93,0:39:03.61,Default,SHINICHI,0,0,0,,{\an8}.وَقت استراحة. هناك من يتّصل بي
Dialogue: 0,0:39:05.90,0:39:06.93,Default,SHINICHI,0,0,0,,هاتوري؟
Dialogue: 0,0:39:06.93,0:39:07.95,Default,SHINICHI,0,0,0,,.أعتذر، يجب أن أُجيب عليه
Dialogue: 0,0:39:07.95,0:39:08.91,Default,NAKAMICHI,0,0,0,,.بالتّأكيد
Dialogue: 0,0:39:09.75,0:39:11.73,Default,SHINICHI,0,0,0,,مرحباً، هاتوري؟
Dialogue: 0,0:39:11.73,0:39:13.88,Default,SHINICHI,0,0,0,,هل حصل شيءٌ ما ثانيةً؟
Dialogue: 0,0:39:13.88,0:39:15.03,Default,HEIJI,0,0,0,,.لا يبدو الأمر جيّداً
Dialogue: 0,0:39:15.41,0:39:19.62,Default,HEIJI,0,0,0,,.إجتمعَت وَسائل الإعلام أمام الفُندق\N.يصنعون جلبةً كبيرة
Dialogue: 0,0:39:19.88,0:39:25.21,Default,HEIJI,0,0,0,,لا يُمكن فِعل شيءٍ بشأن ذلك بما أنّ نيشيكي تارو الفائز\N،بجائزة ناوموتو قد مات ليلة البارحة
Dialogue: 0,0:39:25.62,0:39:28.85,Default,HEIJI,0,0,0,,لكن هل ستكون بخيرٍ مع حُصول كلّ ذلك؟
Dialogue: 0,0:39:29.26,0:39:33.79,Default,HEIJI,0,0,0,,.قد يُلغي السينساي الرّحلة و يُعيدوكم إلى طوكيو
Dialogue: 0,0:39:33.79,0:39:34.51,Default,SHINICHI,0,0,0,,.أوه، نعم
Dialogue: 0,0:39:34.87,0:39:36.78,Default,SHINICHI,0,0,0,,.نحن بخيرٍ للآن
Dialogue: 0,0:39:36.78,0:39:41.22,Default,SHINICHI,0,0,0,,،يبدو بأنّ السينساي يتجنّبون ذِكر القضيّة
Dialogue: 0,0:39:41.22,0:39:43.01,Default,SHINICHI,0,0,0,,و الغُرَف التي نُقيم فيها
Dialogue: 0,0:39:43.29,0:39:47.73,Default,SHINICHI,0,0,0,,.بعيدةٌ عن الغُرفة التي مات فيها نيشيكي سان
Dialogue: 0,0:39:47.73,0:39:49.66,Default,HEIJI,0,0,0,,على أيّة حال، هل تظنّ بأنّه يُمكنكَ التّسلّل بعيداً؟
Dialogue: 0,0:39:49.66,0:39:50.31,Default,SHINICHI,0,0,0,,هاه؟
Dialogue: 0,0:39:50.61,0:39:56.19,Default,HEIJI,0,0,0,,.يُريد أربعتهم إخبارنا عن ديروكي ذاك الذي اخترعَ الشّيفرة
Dialogue: 0,0:39:56.54,0:39:59.21,Default,HEIJI,0,0,0,,،من الصّعب عليهم التّكلّم هُنا بينما وَسائل الإعلام في الأرجاء
Dialogue: 0,0:39:59.21,0:40:03.95,Default,HEIJI,0,0,0,,.لذا يُريدون لِقاءنا بالسّرّ لتناول الغداء في مَطعمٍ قاموا بالحجز فيه
Dialogue: 0,0:40:04.39,0:40:06.83,Default,HEIJI,0,0,0,,.سأذهب مع الشّرطة
Dialogue: 0,0:40:07.16,0:40:09.71,Default,HEIJI,0,0,0,,سترغب بالتّكلّم معهم شخصيّاً، صحيح؟
Dialogue: 0,0:40:09.71,0:40:10.96,Default,SHINICHI,0,0,0,,أيّ مَطعم؟
Dialogue: 0,0:40:11.21,0:40:13.71,Default,RAN,0,0,0,,هاي، أين يجب أن نذهب لتناول الغداء؟
Dialogue: 0,0:40:14.16,0:40:16.54,Default,SERA,0,0,0,,.ساندويشات الفواكه كانت لَذيذةً البارحة
Dialogue: 0,0:40:16.54,0:40:17.70,Default,NAKAMICHI,0,0,0,,.أُريد لَحماً بَقريّاً
Dialogue: 0,0:40:17.70,0:40:19.71,Default,SONOKO,0,0,0,,...إذاً اليوم
Dialogue: 0,0:40:19.71,0:40:20.59,Default,SHINICHI,0,0,0,,.هاي
Dialogue: 0,0:40:20.93,0:40:23.94,Default,SHINICHI,0,0,0,,ماذا عن مَطعمٍ يُدعى إيسوغياما في مدينة بونتو؟
Dialogue: 0,0:40:24.35,0:40:26.85,Title,SIGN,0,0,0,,إيسوغياما في مدينة بونتو
Dialogue: 0,0:40:25.14,0:40:26.85,Default,RAN,0,0,0,,.أحسنتِ، سونوكو
Dialogue: 0,0:40:27.09,0:40:30.34,Default,RAN,0,0,0,,.قالوا في البداية بأنّهم كانوا مَحجوزين بالكامل
Dialogue: 0,0:40:30.34,0:40:32.58,Default,NAKAMICHI,0,0,0,,.تكتّل شركات سوزوكي رائعٌ بالفِعل
Dialogue: 0,0:40:32.58,0:40:34.07,Default,SONOKO,0,0,0,,.حسناً، نعم
Dialogue: 0,0:40:34.81,0:40:38.24,Default,SERA,0,0,0,,ما هذا الحاجز المُستدير المَصنوع من الخيزران؟
Dialogue: 0,0:40:38.88,0:40:42.74,Default,SHINICHI,0,0,0,,.يُوجد مثله أمام المَتاجر الأُخرى أيضاً
Dialogue: 0,0:40:43.05,0:40:44.60,Default,NAKAMICHI,0,0,0,,.رُبّما هذه نزعةٌ في كيوتو
Dialogue: 0,0:40:44.60,0:40:46.03,Default,SHINICHI,0,0,0,,.لا يُمكن أن يكون هذا صحيحاً
Dialogue: 0,0:40:46.03,0:40:48.00,Default,MOMIJI,0,0,0,,.هذا إينوياراي
Dialogue: 0,0:40:48.79,0:40:53.78,Default,MOMIJI,0,0,0,,،يُقال بأنّه لرَدع اللّصوص أو لتحديد حوافّ الطّريق
Dialogue: 0,0:40:54.23,0:40:57.17,Default,MOMIJI,0,0,0,,.لكن يبدو بأنّه لمَنع الكِلاب من التّبوّل
Dialogue: 0,0:40:57.48,0:40:58.68,Default,RAN,0,0,0,,.موميجي سان
Dialogue: 0,0:40:58.68,0:40:59.56,Default,SONOKO,0,0,0,,هل تعرفينها؟
Dialogue: 0,0:40:59.56,0:41:03.25,Default,RAN,0,0,0,,.نعم. إلتقينا في آخر مرّةٍ أتيتُ فيها إلى طوكيو مع أبي
Dialogue: 0,0:41:03.25,0:41:05.18,Default,SERA,0,0,0,,...صدرها ضخم
Dialogue: 0,0:41:05.58,0:41:07.45,Default,MOMIJI,0,0,0,,هل هُم أصدقاؤكِ؟
Dialogue: 0,0:41:07.45,0:41:09.86,Default,MOMIJI,0,0,0,,.ترتدون نفس الزيّ
Dialogue: 0,0:41:09.86,0:41:10.52,Default,RAN,0,0,0,,.نعم
Dialogue: 0,0:41:10.91,0:41:13.77,Default,RAN,0,0,0,,.أتينا من طوكيو في رحلةٍ مدرسيّة
Dialogue: 0,0:41:14.04,0:41:17.11,Default,MOMIJI,0,0,0,,فهمت. من طوكيو؟
Dialogue: 0,0:41:17.11,0:41:21.03,Default,MOMIJI,0,0,0,,.شُكراً لقُدومكم كلّ هذه المَسافة من المُحافظة
Dialogue: 0,0:41:21.67,0:41:23.12,Default,SONOKO,0,0,0,,الـ-المُحافظة؟
Dialogue: 0,0:41:23.12,0:41:25.28,Default,SHINICHI,0,0,0,,.لكنّنا من العاصمة
Dialogue: 0,0:41:25.73,0:41:28.79,Default,SERA,0,0,0,,ماذا يجب أن يأكل الشّخص ليملك مثل هذا الصّدر الكبير؟
Dialogue: 0,0:41:29.28,0:41:32.20,Default,MOMIJI,0,0,0,,.إنتهى دوام ثانويّتي بعد ظُهر اليوم
Dialogue: 0,0:41:32.20,0:41:35.54,Default,MOMIJI,0,0,0,,.كنتُ أُفكّر بتناول الغداء هُنا
Dialogue: 0,0:41:35.94,0:41:37.55,Default,MOMIJI,0,0,0,,هلّا أكلنا معاً؟
Dialogue: 0,0:41:37.77,0:41:42.30,Default,RAN,0,0,0,,أوه، صحيح. موميجي سان، ترتادين ثانويّة كيوتو سينشين، صحيح؟
Dialogue: 0,0:41:42.70,0:41:44.37,Default,MOMIJI,0,0,0,,.نعم، أفعل
Dialogue: 0,0:41:44.37,0:41:46.72,Default,RAN,0,0,0,,هل تعرفين أوكيتو سوشي كن؟
Dialogue: 0,0:41:47.82,0:41:52.52,Default,MOMIJI,0,0,0,,.أوه، نعم. شقيّ الكيندو في صفّي
Dialogue: 0,0:41:52.76,0:41:54.19,Default,RAN,0,0,0,,حقّاً؟
Dialogue: 0,0:41:54.19,0:41:57.02,Default,MOMIJI,0,0,0,,.دعونا لا نقِف في الخارج هُنا
Dialogue: 0,0:41:57.02,0:41:58.93,Default,MOMIJI,0,0,0,,لِمَ لا نتكلّم في الدّاخل؟
Dialogue: 0,0:41:58.93,0:42:00.03,Default,RAN,0,0,0,,.حسناً
Dialogue: 0,0:42:00.23,0:42:01.28,Default,MAN,0,0,0,,!تينغو
Dialogue: 0,0:42:02.32,0:42:04.99,Default,MAN,0,0,0,,!يُوجد تينغو في طريق كياماتشي
Dialogue: 0,0:42:05.36,0:42:06.41,Default,MAN,0,0,0,,!تينغو
Dialogue: 0,0:42:06.41,0:42:07.21,Default,SHINICHI,0,0,0,,تينغو؟
Dialogue: 0,0:42:07.21,0:42:08.32,Default,SERA,0,0,0,,حقّاً؟
Dialogue: 0,0:42:17.50,0:42:19.12,Default,SHINICHI,0,0,0,,...هواه، هواه، هواه
Dialogue: 0,0:42:20.58,0:42:22.38,Default,SHINICHI,0,0,0,,كم يُوجد منهم بالضّبط؟
Dialogue: 0,0:42:24.48,0:42:25.68,Default,POLICE,0,0,0,,.مُفتّش أيانوكوجي
Dialogue: 0,0:42:25.68,0:42:27.58,Default,AYANOKOJI,0,0,0,,ما سبب كلّ هذه الضّوضاء؟
Dialogue: 0,0:42:27.58,0:42:28.55,Default,POLICE,0,0,0,,.أعتذر، سيّدي
Dialogue: 0,0:42:28.92,0:42:33.43,Default,POLICE,0,0,0,,.يُقال بأنّ تينغو قد ظهروا في طريق كياماتشي
Dialogue: 0,0:42:33.66,0:42:36.45,Default,HEIJI,0,0,0,,.طريق كياماتشي؟ هذا بالقُرب من هُنا
Dialogue: 0,0:42:36.45,0:42:40.07,Default,AYANOKOJI,0,0,0,,.إفعلوا شيئاً بشأن أولئكَ المُغفّلين بأنفسكم
Dialogue: 0,0:42:40.54,0:42:45.29,Default,POLICE,0,0,0,,.لكن، أيّها المُفتّش، لَيسوا مُجرّد عددٍ قليلٍ من التينغو
Dialogue: 0,0:42:45.29,0:42:46.36,Default,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,0:42:46.63,0:42:48.93,Default,KEIKO,0,0,0,,...هـ-هل هؤلاء التينغو
Dialogue: 0,0:42:48.93,0:42:51.31,Default,MAYAMA,0,0,0,,لهم علاقةٌ بقضيّة نيشيكي؟
Dialogue: 0,0:42:51.31,0:42:54.12,Default,IHAYA,0,0,0,,هـ-هاي! ستحمونا، صحيح؟
Dialogue: 0,0:42:54.50,0:42:55.98,Default,AYANOKOJI,0,0,0,,.حسناً إذاً
Dialogue: 0,0:42:55.98,0:42:58.82,Default,AYANOKOJI,0,0,0,,.يجب أن نُغادر لبعض الوَقت
Dialogue: 0,0:42:58.82,0:43:00.90,Default,AYANOKOJI,0,0,0,,.أرجوكم لا تذهبوا إلى أيّ مكان
Dialogue: 0,0:43:00.90,0:43:02.13,Default,MAYAMA,0,0,0,,.حسناً
Dialogue: 0,0:43:02.55,0:43:04.02,Default,KEIKO,0,0,0,,.أنا خائفة
Dialogue: 0,0:43:04.84,0:43:06.88,Default,AGATA,0,0,0,,.لا-لا تسمحوا لهم بالهرَب
Dialogue: 0,0:43:07.25,0:43:09.14,Default,HEIJI,0,0,0,,.سنعتني بهذا
Dialogue: 0,0:43:18.33,0:43:20.08,Default,NAKAMICHI,0,0,0,,ماذا يجب أن نفعل، كودو؟
Dialogue: 0,0:43:20.08,0:43:22.68,Default,SHINICHI,0,0,0,,!نبدأ بالإمساك بهم
Dialogue: 0,0:43:22.68,0:43:23.44,Default,NAKAMICHI,0,0,0,,.حسناً
Dialogue: 0,0:43:24.65,0:43:27.01,Default,SERA,0,0,0,,!ران كن، لنُساعدهم
Dialogue: 0,0:43:27.01,0:43:27.94,Default,RAN,0,0,0,,.حسناً
Dialogue: 0,0:43:27.94,0:43:29.62,Default,SONOKO,0,0,0,,!هـ-هاي، إنتظرا
Dialogue: 0,0:43:29.62,0:43:31.31,Default,SONOKO,0,0,0,,!لا تتركاني في الخلف
Dialogue: 0,0:43:51.27,0:43:52.22,Default,MOMIJI,0,0,0,,.إيوري
Dialogue: 0,0:43:53.15,0:43:54.22,Default,IORI,0,0,0,,.آنستي
Dialogue: 0,0:43:54.53,0:43:55.91,Default,MOMIJI,0,0,0,,!إيوري
Dialogue: 0,0:43:55.91,0:43:58.08,Default,IORI,0,0,0,,آنستي. هل تأذّيتِ؟
Dialogue: 0,0:43:58.08,0:43:59.23,Default,MOMIJI,0,0,0,,.أنا بخير
Dialogue: 0,0:44:00.23,0:44:01.12,Default,SONOKO,0,0,0,,من هذا؟
Dialogue: 0,0:44:01.12,0:44:02.22,Default,HEIJI,0,0,0,,من أنتَ بحقّ الله؟
Dialogue: 0,0:44:02.22,0:44:04.36,Default,TENGU,0,0,0,,.سُحقاً. تمّ إمساكي
Dialogue: 0,0:44:04.63,0:44:05.73,Default,MOMIJI,0,0,0,,.هيجي كن
Dialogue: 0,0:44:05.99,0:44:09.61,Default,HEIJI,0,0,0,,!لِمَ ترتدون هذه الأقنعة الغريبة؟
Dialogue: 0,0:44:09.83,0:44:12.19,Default,TENGU,0,0,0,,.كـ-كانوا يُجنّدوننا على الإنترنت
Dialogue: 0,0:44:12.19,0:44:16.87,Default,TENGU,0,0,0,,.سيُدفَع لنا 100.000 ين مُقدّماً لوَضع قِناع التينغو و الرّكض في طريق كياماتشي
Dialogue: 0,0:44:17.36,0:44:21.32,Default,TENGU,0,0,0,,.إن لَم يتمّ إمساكنا لـ30 دقيقة، قالوا بأنّه سيُدفع لنا مليون
Dialogue: 0,0:44:21.32,0:44:22.83,Default,HEIJI,0,0,0,,حقّاً؟
Dialogue: 0,0:44:22.83,0:44:23.88,Default,SHINICHI,0,0,0,,!هاتوري
Dialogue: 0,0:44:24.48,0:44:27.38,Default,SHINICHI,0,0,0,,هاتوري، هل أولئكَ الـ4 وَحدهم في المَطعم الآن؟
Dialogue: 0,0:44:27.38,0:44:29.92,Default,HEIJI,0,0,0,,.نعم. من الأفضل أن نعود بسرعة
Dialogue: 0,0:44:35.41,0:44:36.15,Default,SHINICHI,0,0,0,,.سُحقاً
Dialogue: 0,0:44:36.15,0:44:37.64,Default,HEIJI,0,0,0,,.لَقد خدَعونا
Dialogue: 0,0:44:40.98,0:44:43.52,Default,SHINICHI,0,0,0,,.إنّه المُمثّل إيهايا سان هذه المرّة
Dialogue: 0,0:44:43.70,0:44:46.48,Default,HAIJI,0,0,0,,.نعم. تمّ شقّ شريانه السّباتيّ بالكامل
Dialogue: 0,0:44:46.91,0:44:50.03,Default,SERA,0,0,0,,.إنّه بالمَقلوب مع وُجود كدمَتين على رأسه ثانيةً
Dialogue: 0,0:44:50.34,0:44:52.81,Default,HEIJI,0,0,0,,.ياله من جانٍ غريب الأطوار
Dialogue: 0,0:44:52.81,0:44:55.66,Default,HEIJI,0,0,0,,لابدّ من أنّه تمهّل بصُنع هذه العلامات
Dialogue: 0,0:44:56.08,0:44:58.87,Default,HEIJI,0,0,0,,.قبل دعوَته خارجاً لقتله
Dialogue: 0,0:44:59.58,0:45:00.73,Default,SHINICHI,0,0,0,,.كلّا
Dialogue: 0,0:45:00.73,0:45:03.53,Default,SHINICHI,0,0,0,,،عندما غادرنا قبل 10 دقائق
Dialogue: 0,0:46:57.23,0:47:02.23,Title,,0,0,0,,{\blur2\fs35\c&HFFFFFF&\3c&H7A1F1E&\3a&H00&\pos(1256,15)}آل فانتوم\N{\fs35\fnReady}ALPhantom
Dialogue: 0,0:47:06.46,0:47:09.42,Default,AYANOKOJI,0,0,0,,.فهمت. كانت هذه نُقطةً عمياء
Dialogue: 0,0:47:09.66,0:47:14.18,Default,AYANOKOJI,0,0,0,,.كنّا نُراقب الباب الخلفيّ بما أنّنا توَقّعنا مارّةً في الخارج بالأمام
Dialogue: 0,0:47:14.39,0:47:17.42,Default,HEIJI,0,0,0,,لكن لِمَ خرجَ إيهايا سان؟
Dialogue: 0,0:47:17.42,0:47:20.30,Default,HEIJI,0,0,0,,.أخبرتُكم بأن تبقوا في غُرفتكم
Dialogue: 0,0:47:20.30,0:47:21.52,Default,AGATA,0,0,0,,.كنّا ذاهبين إلى دورة المياه
Dialogue: 0,0:47:21.73,0:47:24.65,Caracters,TEXT,0,0,0,,{\fad(250,290)\pos(644,595)}ماياما مينيتو (38) عاماً\Nمُخرِج أفلام
Dialogue: 0,0:47:21.76,0:47:26.56,Default,MAYAMA,0,0,0,,{\an8}.إيهايا، و أغاتا، و أنا ذهبنا إلى دورة المياه معاً
Dialogue: 0,0:47:26.97,0:47:29.82,Default,MAYAMA,0,0,0,,{\an8}،قال إيهايا بأنّه شعرَ بالقلَق بشأن ترك كيكو تشان وَحدها في الغُرفة
Dialogue: 0,0:47:27.90,0:47:30.87,Caracters,TEXT,0,0,0,,{\fad(250,475)\pos(606,601)}إيهايا شينيا (37) عاماً\Nمُمثّل
Dialogue: 0,0:47:29.82,0:47:32.28,Default,MAYAMA,0,0,0,,{\an8}.لذا عاد وَحدَه
Dialogue: 0,0:47:33.25,0:47:36.21,Caracters,,0,0,0,,{\fad(250,420)\pos(640,601)}أغاتا ريكي (37) عاماً\Nمُلَحّن
Dialogue: 0,0:47:33.63,0:47:37.91,Default,AGATA,0,0,0,,{\an8}.ظننتُني رأيتُه يتفقّد رسائله قبل عودته
Dialogue: 0,0:47:38.16,0:47:39.52,Default,AYANOKOJI,0,0,0,,.فهمت
Dialogue: 0,0:47:39.52,0:47:43.70,Default,AYANOKOJI,0,0,0,,هل عاد إيهايا سان إلى الغُرفة على الفور؟
Dialogue: 0,0:47:43.70,0:47:44.79,Default,KEIKO,0,0,0,,.كلّا
Dialogue: 0,0:47:45.19,0:47:50.28,Default,KEIKO,0,0,0,,{\an8}.خشيتُ البقاء في الغُرفة وَحدي، لذا ذهبتُ إلى دورة المياه بعدها بقليل
Dialogue: 0,0:47:45.21,0:47:48.68,Caracters,TEXT,0,0,0,,{\fad(250,460)\pos(606,607)}كوراتشي كيكو (37) عاماً\Nمُمثّلة
Dialogue: 0,0:47:50.28,0:47:54.43,Default,KEIKO,0,0,0,,.يُمكن أن يكون قد عاد بعد أن غادرتُ الغُرفة
Dialogue: 0,0:47:54.59,0:47:58.06,Caracters,TEXT,0,0,0,,{\fad(250,460)\pos(674,599)}أيانوكوجي فوميمارو (28) عاماً\Nمُفتّشٌ في القسم الأوّل من شُرطة كيوتو
Dialogue: 0,0:47:54.79,0:47:58.43,Default,AYANOKOJI,0,0,0,,{\an8}حتّى متى بقيتُما في دورة المياه؟
Dialogue: 0,0:47:58.81,0:48:03.21,Default,MAYAMA,0,0,0,,.غادرتُ دورة المياه على الفور، لكنّني ضِعت في طريق العودة
Dialogue: 0,0:48:03.21,0:48:06.94,Default,AGATA,0,0,0,,.شعرتُ بتلبّكٍ في مَعِدتي، لذا بقيتُ في دورة المياه لفترة
Dialogue: 0,0:48:07.51,0:48:11.44,Default,SERA,0,0,0,,بمَعنىً آخر، لأمكن لثلاثتكم جميعاً إرسال رسالةٍ إلى إيهايا سان
Dialogue: 0,0:48:11.44,0:48:14.32,Default,SERA,0,0,0,,.و قتلِه
Dialogue: 0,0:48:14.58,0:48:15.66,Default,KEIKO,0,0,0,,ماذا؟
Dialogue: 0,0:48:15.66,0:48:16.85,Default,AGATA,0,0,0,,...لـ-لكن
Dialogue: 0,0:48:16.85,0:48:19.03,Default,MAYAMA,0,0,0,,!لَم نكُن لنفعل هذا أبداً
Dialogue: 0,0:48:19.03,0:48:21.46,Default,AYANOKOJI,0,0,0,,،حسناً الآن، لَستِ مُخطئة
Dialogue: 0,0:48:21.73,0:48:24.96,Default,AYANOKOJI,0,0,0,,...لكن رشق الدّم و آثار خُطى الأقدام على الإينوياراي
Dialogue: 0,0:48:25.27,0:48:29.01,Default,AYANOKOJI,0,0,0,,.يبدو بأنّها مَرسومةٌ منذ فترة
Dialogue: 0,0:48:29.48,0:48:34.06,Default,AYANOKOJI,0,0,0,,،عندما كنتُم هُنا قبل اكتشاف الدّم
Dialogue: 0,0:48:34.06,0:48:36.83,Default,AYANOKOJI,0,0,0,,ألَم تكُن هُنا حقّاً؟
Dialogue: 0,0:48:36.83,0:48:38.20,Default,RAN,0,0,0,,.نعم
Dialogue: 0,0:48:38.20,0:48:44.46,Default,MOMIJI,0,0,0,,.رُ-رُبّما خدعَنا ثعلبٌ جميعاً
Dialogue: 0,0:48:50.23,0:48:52.03,Default,SHINICHI,0,0,0,,ما هذه العلامة؟
Dialogue: 0,0:48:52.31,0:48:53.65,Default,SHINICHI,0,0,0,,هاه؟
Dialogue: 0,0:48:53.89,0:48:54.57,Default,ALL,0,0,0,,ماذا؟
Dialogue: 0,0:48:54.97,0:49:00.15,Default,SHINICHI,0,0,0,,.تُوجد علاماتٌ غريبةٌ حول الإينوياراي
Dialogue: 0,0:49:00.15,0:49:02.66,Default,SHINICHI,0,0,0,,.أه، أوه. فعلتُ ما أفعله دائماً
Dialogue: 0,0:49:02.66,0:49:05.69,Default,HEIJI,0,0,0,,.أنتَ مُحقّ. إنّها مَوجودةٌ حولها
Dialogue: 0,0:49:05.69,0:49:06.88,Default,HEIJI,0,0,0,,.أتسائل ما هي
Dialogue: 0,0:49:09.37,0:49:12.10,Default,RAN,0,0,0,,هل قال "هاه" للتّوّ؟
Dialogue: 0,0:49:12.10,0:49:15.36,Default,SONOKO,0,0,0,,يُقلّد ذلك الشّقيّ الآن؟
Dialogue: 0,0:49:15.36,0:49:16.84,Default,SONOKO,0,0,0,,.يا للوَقاحة
Dialogue: 0,0:49:17.17,0:49:19.35,Default,SHINICHI,0,0,0,,عـ-على أيّة حال، هل كانت هناك شيفرة؟
Dialogue: 0,0:49:19.35,0:49:21.60,Default,SHINICHI,0,0,0,,هل كانت في جيب صدره ثانيةً؟
Dialogue: 0,0:49:21.88,0:49:23.00,Default,AYANOKOJI,0,0,0,,.نعم
Dialogue: 0,0:49:23.00,0:49:25.24,Default,AYANOKOJI,0,0,0,,،مثل جريمة قتل نيشيكي سان
Dialogue: 0,0:49:25.24,0:49:28.84,Default,AYANOKOJI,0,0,0,,.كانت مَوجودةً مع وَرقة النّبتة هذه
Dialogue: 0,0:49:29.68,0:49:32.41,Default,AYANOKOJI,0,0,0,,.الشّيفرة الـ3
Dialogue: 0,0:49:33.11,0:49:36.20,Default,HEIJI,0,0,0,,ترَكوا شيفرةً تافهةً أُخرى؟
Dialogue: 0,0:49:36.20,0:49:42.37,Default,HEIJI,0,0,0,,و لِمَ هذه المُربّعات الـ4 في البداية هي علامة ديكوري؟
Dialogue: 0,0:49:42.54,0:49:46.90,Default,SERA,0,0,0,,رُبّما لأنّ رمز "دي" في ديكوري سيُشكَّل
Dialogue: 0,0:49:46.90,0:49:50.07,Default,SERA,0,0,0,,.إن رسمتَ مُربّعاً كبيراً حولها
Dialogue: 0,0:49:50.07,0:49:53.99,Default,HEIJI,0,0,0,,أرسُم مُربّعاً كبيراً حولها، هاه؟
Dialogue: 0,0:49:56.20,0:49:57.39,Default,HEIJI,0,0,0,,.أنتِ مُحقّة
Dialogue: 0,0:49:58.07,0:50:00.39,Default,SHINICHI,0,0,0,,.هاتوري، هاتفكَ يرنّ
Dialogue: 0,0:50:00.39,0:50:01.96,Default,HEIJI,0,0,0,,.هاه؟ أوه
Dialogue: 0,0:50:02.64,0:50:04.64,Title,TEXT,0,0,0,,إتّصالٌ وَارد\Nكازوها\Nإجابة     رفض
Dialogue: 0,0:50:03.22,0:50:04.64,Default,HEIJI,0,0,0,,.إنّها كازوها
Dialogue: 0,0:50:07.55,0:50:10.15,Default,HEIJI,0,0,0,,...ما الأمر، كازوها؟ أنا
Dialogue: 0,0:50:10.15,0:50:12.65,Default,KAZUHA,0,0,0,,!هيجي، ماذا تفعل؟
Dialogue: 0,0:50:12.91,0:50:14.73,Default,HEIJI,0,0,0,,أ-ألَم أُخبركِ؟
Dialogue: 0,0:50:14.73,0:50:18.78,Default,HEIJI,0,0,0,,.أُصبتُ بالبرد و أنا مريض، لذا لا يُمكنني الذّهاب إلى المدرسة
Dialogue: 0,0:50:19.55,0:50:21.70,Default,KAZUHA,0,0,0,,!لا تكُن سخيفاً
Dialogue: 0,0:50:21.70,0:50:25.45,Title,TEXT,0,0,0,,!المُمثّل إيهايا موريا سان مَقتول
Dialogue: 0,0:50:21.70,0:50:25.45,Title,TEXT,0,0,0,,هل يُمكن أن تكون جريمة قتلٍ مُتسلسل؟
Dialogue: 0,0:50:22.00,0:50:24.50,Default,KAZUHA,0,0,0,,!أراكَ على التّلفاز
Dialogue: 0,0:50:24.50,0:50:25.45,Default,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,0:50:26.05,0:50:27.98,Default,HEIJI,0,0,0,,.أوه، نـ-نعم
Dialogue: 0,0:50:27.98,0:50:31.47,Default,HEIJI,0,0,0,,.تجوّلتُ وُصولاً إلى كيوتو لأجِدَ تعويذة حظٍّ جيّدٍ لشفاء البرد
Dialogue: 0,0:50:31.47,0:50:32.84,Default,KAZUHA,0,0,0,,!ماذا؟
Dialogue: 0,0:50:33.44,0:50:35.34,Default,SHINICHI,0,0,0,,.هذا لَيس عُذراً قابلاً للتّصديق
Dialogue: 0,0:50:35.63,0:50:37.65,Default,HEIJI,0,0,0,,،عـ-على أيّة حال
Dialogue: 0,0:50:37.65,0:50:41.80,Default,HEIJI,0,0,0,,.أحتاج لحلّ قضيّة القتل المُتسلسل هذه و حلّ الشّيفرة
Dialogue: 0,0:50:41.80,0:50:44.65,Default,HEIJI,0,0,0,,.لا تُخبري وَالِداي عن هذا
Dialogue: 0,0:50:44.65,0:50:46.35,Default,KAZUHA,0,0,0,,{\an8}،حتّى لَو لَم أُخبرهما
Dialogue: 0,0:50:44.65,0:50:46.35,Default,MOMIJI,0,0,0,,.هاي، هيجي كن
Dialogue: 0,0:50:46.35,0:50:51.38,Default,KAZUHA,0,0,0,,{\an8}ألَن يعرف وَالِداكَ إن شاهداكَ على التّلفاز؟
Dialogue: 0,0:50:46.85,0:50:51.83,Default,MOMIJI,0,0,0,,.هذه الرّموز في الكود تُذكّرني بأسماء مَواقع في كيوتو
Dialogue: 0,0:50:51.83,0:50:52.61,Default,ALL,0,0,0,,ماذا؟
Dialogue: 0,0:50:53.30,0:50:57.76,Default,MOMIJI,0,0,0,,{\an8}.هذا الرّمز هو "هيساشي" من هيساشي تشو في جناح كاميغيو
Dialogue: 0,0:50:54.52,0:50:57.33,Caracters,TEXT,0,0,0,,{\fad(250,260)\pos(826,593)}مدينة كيوتو - جناح كاميغيو\Nهيساشي تشو
Dialogue: 0,0:50:57.76,0:51:02.11,Default,MOMIJI,0,0,0,,{\an8}.على يسارها هي الـ"تو" من توكوساياما تشو في جناح شيموغيو
Dialogue: 0,0:50:58.65,0:51:01.46,Caracters,TEXT,0,0,0,,{\fad(250,460)\pos(466,601)}مدينة كيوتو - جناح شيموغيو\Nتوكوساياما تشو
Dialogue: 0,0:51:02.11,0:51:05.62,Default,MOMIJI,0,0,0,,{\an8}.على يسارها "أداشي" من أداشينو في جناح أوكيو
Dialogue: 0,0:51:03.37,0:51:05.62,Caracters,TEXT,0,0,0,,{\fad(250,1)\pos(472,599)}مدينة كيوتو - جناح أوكيو\Nأداشينو تشو
Dialogue: 0,0:51:06.10,0:51:08.13,Default,HEIJI,0,0,0,,تُقرأ "أداشي"؟
Dialogue: 0,0:51:08.13,0:51:09.18,Default,MOMIJI,0,0,0,,.هذا صحيح
Dialogue: 0,0:51:09.18,0:51:10.37,Default,SERA,0,0,0,,.لَحظة
Dialogue: 0,0:51:11.06,0:51:14.54,Default,SERA,0,0,0,,...إن كانت تُوجد أجنحةٌ تحوي رُموزاً تعني أعلى، و أسفل، و أيمن في أسمائها، إذاً
Dialogue: 0,0:51:14.84,0:51:15.74,Default,MOMIJI,0,0,0,,.نعم
Dialogue: 0,0:51:15.74,0:51:20.20,Default,MOMIJI,0,0,0,,،تحوي كيوتو على جناح كاميغيو، و جناح ناكاغيو، و جناح شيموغيو
Dialogue: 0,0:51:16.84,0:51:17.80,Title,TEXT,0,0,0,,جناح كاميغيو
Dialogue: 0,0:51:17.84,0:51:18.80,Title,TEXT,0,0,0,,جناح ناكاغيو
Dialogue: 0,0:51:18.88,0:51:19.84,Title,TEXT,0,0,0,,جناح شيموغيو
Dialogue: 0,0:51:20.09,0:51:21.05,Title,TEXT,0,0,0,,جناح ساكيو
Dialogue: 0,0:51:20.20,0:51:21.99,Default,MOMIJI,0,0,0,,.و جناح ساكيو، و جناح أوكيو
Dialogue: 0,0:51:21.13,0:51:22.09,Title,TEXT,0,0,0,,جناح أوكيو
Dialogue: 0,0:51:21.99,0:51:25.11,Default,MOMIJI,0,0,0,,.جميعها مَوجودةٌ في الأعلى، و الأوسط، و الأسفل، و الأيسر، و الأيمن
Dialogue: 0,0:51:22.09,0:51:25.01,Title,TEXT,0,0,0,,{\fad(420,1)}الأعلى\Nالأيسر  الأوسط  الأيمن\Nالأسفل
Dialogue: 0,0:51:25.11,0:51:25.93,Default,ALL,0,0,0,,ماذا؟
Dialogue: 0,0:51:26.30,0:51:27.71,Default,SERA,0,0,0,,...إذاً رُبّما هذه
Dialogue: 0,0:51:27.71,0:51:29.19,Default,HEIJI,0,0,0,,هل يُمكن ذلك؟
Dialogue: 0,0:51:29.19,0:51:30.67,Default,SHINICHI,0,0,0,,.لابدّ من أنّ هذا هو الأمر
Dialogue: 0,0:51:30.67,0:51:31.94,Default,KAZUHA,0,0,0,,!هاي، هيجي
Dialogue: 0,0:51:31.94,0:51:32.89,Default,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,0:51:32.89,0:51:35.69,Default,KAZUHA,0,0,0,,.ظننتُني سمعتُ صوت موميجي سان
Dialogue: 0,0:51:36.26,0:51:39.24,Default,MOMIJI,0,0,0,,يا وَرقة الشّجر الصّغيرة. كيف كان حالكِ؟
Dialogue: 0,0:51:39.60,0:51:40.43,Default,KAZUHA,0,0,0,,!مو
Dialogue: 0,0:51:40.43,0:51:43.10,Default,MOMIJI,0,0,0,,.دعيني أعتني بهيجي كن
Dialogue: 0,0:51:43.10,0:51:46.10,Default,MOMIJI,0,0,0,,.يجدُر بكِ التّركيز على دراستك
Dialogue: 0,0:51:46.10,0:51:46.85,Default,KAZUHA,0,0,0,,!أنا
Dialogue: 0,0:51:46.85,0:51:48.16,Default,MOMIJI,0,0,0,,.وَداعاً الآن
Dialogue: 0,0:51:48.16,0:51:51.39,Default,KAZUHA,0,0,0,,!لا يُمكنني السّماح لكِ بالإعتناء به، أيّتها الغبيّة
Dialogue: 0,0:51:52.59,0:51:54.10,Default,STUDENT,0,0,0,,ألا يُمكنكِ السّماح لنا بالإعتناء بالأمر؟
Dialogue: 0,0:51:54.10,0:51:56.78,Default,STUDENT,0,0,0,,هل ستُنظّفين غُرفة الصّفّ وَحدكِ، كازوها؟
Dialogue: 0,0:51:56.78,0:51:58.17,Default,KAZUHA,0,0,0,,.لَم أعني ذلك
Dialogue: 0,0:51:59.11,0:52:00.67,Default,KAZUHA,0,0,0,,...يا إلهي
Dialogue: 0,0:52:03.77,0:52:06.68,Default,AYANOKOJI,0,0,0,,.أظنّنا كنّا في مُنتصف مُحادثتنا
Dialogue: 0,0:52:07.19,0:52:10.18,Default,AYANOKOJI,0,0,0,,لِمَ لا تُخبرونا هذه المرّة
Dialogue: 0,0:52:10.67,0:52:16.04,Default,AYANOKOJI,0,0,0,,.عن الرّجل المَدعوّ ديكوري الذي اخترعَ هذه الشّيفرات الـ3
Dialogue: 0,0:52:18.46,0:52:20.00,Default,CONAN,0,0,0,,!يُوجد أقصى قدرٍ من الإبداع في عيناي
Dialogue: 0,0:52:20.00,0:52:21.74,Default,CONAN,0,0,0,,!مهاراتي في التّحرّي هي استجابة الغد
Dialogue: 0,0:52:21.97,0:52:23.57,Default,CONAN,0,0,0,,!جريمة قتلٍ مُتسلسلٍ تتسبّب بمَشاكل في كيوتو
Dialogue: 0,0:52:23.57,0:52:25.61,Default,CONAN,0,0,0,,!يتشارك التيغو و الفِلم برابطةٍ مُفاجئة
Dialogue: 0,0:52:25.61,0:52:29.16,Default,CONAN,0,0,0,,،يُظهر الحقيقة الوَحيدة دائماً بجسد طفلٍ و عقل بالغ
Dialogue: 0,0:52:29.16,0:52:31.69,Default,CONAN,0,0,0,,!إسمه المُتحرّي كونان
Dialogue: 0,0:53:58.18,0:54:04.18,Title,EPTITLE,0,0,0,,{\fad(397,1)\fs60\b1\pos(956,162)}(الرّحلة المدرسيّة القُرمزيّة (جُزء أحمر الحُبّ
Dialogue: 0,0:53:58.66,0:54:02.46,Default,CONAN,0,0,0,,"!الرّحلة المدرسيّة القُرمزيّة، جُزء أحمر الحُبّ"
Dialogue: 0,0:54:07.85,0:54:10.36,Title,SIGN,0,0,0,,بونتو تشو - إيسوغيمايا
Dialogue: 0,0:54:08.62,0:54:10.36,Default,AYANOKOJI,0,0,0,,ديكوري ميتشيو؟
Dialogue: 0,0:54:10.69,0:54:16.59,Default,AYANOKOJI,0,0,0,,هل كان زميلكم في الدّراسة أيضاً في جامعة غيون للفُنون؟
Dialogue: 0,0:54:16.59,0:54:17.74,Default,KEIKO,0,0,0,,.نـ-نعم
Dialogue: 0,0:54:18.40,0:54:22.46,Default,AGATA,0,0,0,,.كان في قِسم الفُنون الجّميلة، لكنّني كنتُ تِلميذاً في المُوسيقى
Dialogue: 0,0:54:22.46,0:54:24.62,Default,MAYAMA,0,0,0,,.درستُ الأفلام
Dialogue: 0,0:54:24.62,0:54:27.75,Default,KEIKO,0,0,0,,.كنتُ و إيهايا كن في قِسم التّمثيل
Dialogue: 0,0:54:28.15,0:54:30.84,Default,MAYAMA,0,0,0,,.و كان نيشيكي في قِسم الفُنون الأدبيّة
Dialogue: 0,0:54:30.84,0:54:35.92,Default,SERA,0,0,0,,كيف تمكّنتُم من التّعارف بينما درستُم تخصّصاتٍ مُختلِفة؟
Dialogue: 0,0:54:35.92,0:54:39.13,Default,AGATA,0,0,0,,.إنضممنا جميعاً إلى نادي مُؤثّرات الأفلام الخاصّة
Dialogue: 0,0:54:39.44,0:54:42.92,Default,AGATA,0,0,0,,.كان ديكوري في نادي الرّسوم الهزليّة أيضاً مع ذلك
Dialogue: 0,0:54:42.92,0:54:47.39,Default,MAYAMA,0,0,0,,.كلّ عام، كنّا نعرِض الفِلم الذي صوّرناه في مهرجان الجّامعة
Dialogue: 0,0:54:47.70,0:54:50.99,Default,MAYAMA,0,0,0,,.كنتُ بارعاً دائماً في المُؤثّرات الخاصّة
Dialogue: 0,0:54:50.99,0:54:54.93,Default,KEIKO,0,0,0,,.كنتُ و إيهايا سان بارعان في مِكياج المُؤثّرات الخاصّة
Dialogue: 0,0:54:54.93,0:54:58.90,Default,AGATA,0,0,0,,.و كنتُ أُؤلّف موسيقى غريبةً للفِلم المُكتمل
Dialogue: 0,0:54:59.33,0:55:00.85,Default,AGATA,0,0,0,,،كان نيشيكي يكتُب النّصّ
Dialogue: 0,0:55:00.85,0:55:05.09,Default,AGATA,0,0,0,,و كان ديكوري يُصمّم الأزياء و الوُحوش، صحيح؟
Dialogue: 0,0:55:05.09,0:55:08.25,Default,MAYAMA,0,0,0,,،عندما كان ديكوري مُنشغلاً برُسومه الهزليّة
Dialogue: 0,0:55:08.25,0:55:10.79,Default,MAYAMA,0,0,0,,.تعاونّا جميعاً
Dialogue: 0,0:55:11.16,0:55:15.19,Default,KEIKO,0,0,0,,.كان أغاتا كن الوَحيد المُفيد حقّاً مع ذلك
Dialogue: 0,0:55:15.19,0:55:16.24,Default,MAYAMA,0,0,0,,.نعم
Dialogue: 0,0:55:16.24,0:55:20.30,Default,SHINICHI,0,0,0,,لكن إسم ديكوري لا يظهر في قائمة المُشاركين بالعمل
Dialogue: 0,0:55:20.30,0:55:24.93,Default,SHINICHI,0,0,0,,."الذين اعتمدَ عليهم إنتاج مَشروع التّخرّج "التيغو الأحمر المُقاتِل
Dialogue: 0,0:55:26.59,0:55:27.96,Default,SHINICHI,0,0,0,,لماذا؟
Dialogue: 0,0:55:29.37,0:55:32.10,Default,HEIJI,0,0,0,,ماذا؟ لِمَ لا تقولون أيّ شيء؟
Dialogue: 0,0:55:32.43,0:55:37.40,Default,AGATA,0,0,0,,.كان نيشيكي يُعاني من مَتاعب في كتابة نصّ مَشروع تخرّجنا
Dialogue: 0,0:55:37.40,0:55:42.11,Default,MAYAMA,0,0,0,,.وَقتها وَجدَ رُسوماً هزليّةً شخصيّة النّشر أنتجها ديكوري
Dialogue: 0,0:55:42.37,0:55:44.87,Default,KEIKO,0,0,0,,.كانت قِصّةً خياليّةً مُذهلة
Dialogue: 0,0:55:45.01,0:55:48.32,Default,SERA,0,0,0,,كانت "التيغو الأحمر المُقاتِل"، صحيح؟
Dialogue: 0,0:55:48.32,0:55:49.17,Default,KEIKO,0,0,0,,.نعم
Dialogue: 0,0:55:49.86,0:55:54.14,Default,KEIKO,0,0,0,,قال ديكوري كن بأنّه يُخطّط لنَشرها رسميّاً
Dialogue: 0,0:55:54.14,0:55:57.65,Default,KEIKO,0,0,0,,،حالما يُصبح فنّان رُسومٍ هزليّةٍ خبير
Dialogue: 0,0:55:57.65,0:55:59.01,Default,KEIKO,0,0,0,,.لذا أخبرَنا بألّا نستخدِمها
Dialogue: 0,0:55:59.41,0:56:04.39,Default,AGATA,0,0,0,,،ظننّا بأنّ ديكوري سيتقبّل الأمر حال رُؤيته المُنتج الكامل
Dialogue: 0,0:56:04.39,0:56:06.60,Default,AGATA,0,0,0,,.لذا قرّرنا تصوير قِصّته
Dialogue: 0,0:56:06.60,0:56:09.91,Default,MAYAMA,0,0,0,,،و إن أضفنا إسمه إلى قائمة المُشاركين بالعمل
Dialogue: 0,0:56:09.91,0:56:12.52,Default,MAYAMA,0,0,0,,.سيكون مَشروع تخرّجه أيضاً
Dialogue: 0,0:56:12.81,0:56:16.18,Default,KEIKO,0,0,0,,...لكن عندما شاهدَ الفِلم في غُرفة نادينا
Dialogue: 0,0:56:16.90,0:56:20.15,Default,DEKURI,0,0,0,,!هذا لَيس عمَلي! لَقد قُمتُم بخيانتي
Dialogue: 0,0:56:20.62,0:56:22.30,Default,MAYAMA,0,0,0,,.إنتظر، ديكوري
Dialogue: 0,0:56:22.30,0:56:25.34,Default,DEKURI,0,0,0,,!لا تضعوا إسمي عليه
Dialogue: 0,0:56:25.34,0:56:26.53,Default,KEIKO,0,0,0,,ديكوري كن؟
Dialogue: 0,0:56:28.25,0:56:32.32,Default,KEIKO,0,0,0,,.لاحقاً، حصل مَشروع تخرّجنا على ثناءٍ كبير
Dialogue: 0,0:56:32.32,0:56:36.17,Default,KEIKO,0,0,0,,.وُضِعَ خمستُنا فجأةً في دائرة الإهتمام
Dialogue: 0,0:56:36.62,0:56:38.81,Default,HEIJI,0,0,0,,.يَكرهكم بالكامل
Dialogue: 0,0:56:38.81,0:56:43.17,Default,MAYAMA,0,0,0,,،لكن في ليلة إعلاننا عن الفِلم
Dialogue: 0,0:56:43.53,0:56:45.83,Default,MAYAMA,0,0,0,,.وَرَدَني اتّصالٌ من ديكوري
Dialogue: 0,0:56:47.14,0:56:52.57,Default,MAYAMA,0,0,0,,.قال بأنّه قد تخلّى عن رسم الرّسوم الهزليّة و أنّه كان يعمل في شرِكة تصميمٍ صغيرة
Dialogue: 0,0:56:52.57,0:56:56.32,Default,MAYAMA,0,0,0,,طلبَ منّا وَضع إسمه في قائمة المُشاركين بالعمل
Dialogue: 0,0:56:56.32,0:56:58.86,Default,MAYAMA,0,0,0,,.إن كنّا سنُعيد إنتاج ذلك الفِلم
Dialogue: 0,0:56:59.35,0:57:04.11,Default,KEIKO,0,0,0,,.قال ديكوري كن بأنّ حُلمه كان تكييف رُسومه الهزليّة لتُعرَض على الشّاشة الكبيرة
Dialogue: 0,0:57:04.31,0:57:07.67,Default,AYANOKOJI,0,0,0,,هل وَضعتُم إسمه في قائمة المُشاركين بالعمل؟
Dialogue: 0,0:57:07.67,0:57:11.74,Default,MAYAMA,0,0,0,,.كنّا سنفعل، لكن حصل خطأٌ صغير
Dialogue: 0,0:57:12.38,0:57:17.08,Default,AGATA,0,0,0,,،عندما رآى بأنّ إسمه لَم يكُن مَوجوداً في قائمة المُشاركين بالعمل في العرض الأوّليّ
Dialogue: 0,0:57:17.08,0:57:19.25,Default,AGATA,0,0,0,,.إنتحرَ بسبب خيبة الأمَل
Dialogue: 0,0:57:20.24,0:57:24.88,Default,MAYAMA,0,0,0,,،فكّرنا حتّى بإلغاء عرض الفِلم
Dialogue: 0,0:57:25.26,0:57:28.14,Default,MAYAMA,0,0,0,,.لكن لَم يسمح لنا راعونا بذلك
Dialogue: 0,0:57:28.61,0:57:30.10,Default,AYANOKOJI,0,0,0,,.فهمت
Dialogue: 0,0:57:32.29,0:57:33.39,Default,MOMIJI,0,0,0,,لماذا؟
Dialogue: 0,0:57:33.90,0:57:38.40,Default,MOMIJI,0,0,0,,لِمَ يُسمَح لهيجي كن و الآخرين بالدّخول و نحن لا؟
Dialogue: 0,0:57:38.72,0:57:42.53,Default,MOMIJI,0,0,0,,.تركَتني وَرقة الشّجر الصّغيرة أعتني بهيجي كن أخيراً
Dialogue: 0,0:57:42.78,0:57:46.91,Default,IORI,0,0,0,,.يبدو بأنّه قد حصل على ثِقة المُفتّش أيانوكوجي
Dialogue: 0,0:57:47.44,0:57:48.66,Default,SONOKO,0,0,0,,بجِدّ، من هو؟
Dialogue: 0,0:57:48.83,0:57:50.97,Default,MOMIJI,0,0,0,,.هذا عملُك، إفعل شيئاً بشأن هذا
Dialogue: 0,0:57:50.97,0:57:52.75,Default,RAN,0,0,0,,.عُذراً، موميجي سان
Dialogue: 0,0:57:52.75,0:57:53.79,Default,MOMIJI,0,0,0,,ما الأمر؟
Dialogue: 0,0:57:54.20,0:57:56.92,Default,RAN,0,0,0,,أين يُمكنني الذّهاب للِقاء أوكيتا كن؟
Dialogue: 0,0:57:58.77,0:58:03.17,Default,MOMIJI,0,0,0,,حسناً، شقيّ الكيندو ذاك
Dialogue: 0,0:58:03.17,0:58:06.34,Default,MOMIJI,0,0,0,,.يتدرّب في الدوجو الآن على الأرجح
Dialogue: 0,0:58:06.94,0:58:09.26,Default,MOMIJI,0,0,0,,.إن كنتِ تُريدين إيصال رسالةٍ له، سأُوصِلها لأجلك
Dialogue: 0,0:58:10.13,0:58:13.81,Default,RAN,0,0,0,,.في الوَاقع، هناك ما أردتّ مُناقشته معه شخصيّاً
Dialogue: 0,0:58:14.39,0:58:15.48,Default,OKITA,0,0,0,,هاه؟
Dialogue: 0,0:58:16.30,0:58:17.59,Default,OKITA,0,0,0,,.هذه أنتِ، ران تشان
Dialogue: 0,0:58:17.59,0:58:18.35,Default,RAN,0,0,0,,ماذا؟
Dialogue: 0,0:58:18.70,0:58:19.98,Default,RAN,0,0,0,,!أوكيتا كن
Dialogue: 0,0:58:19.98,0:58:22.36,Default,OKITA,0,0,0,,ماذا تفعلين هُنا؟
Dialogue: 0,0:58:22.62,0:58:25.01,Default,MOMIJI,0,0,0,,ماذا تفعل هُنا؟
Dialogue: 0,0:58:25.01,0:58:27.44,Default,MOMIJI,0,0,0,,.أحضرتَ جميع تابعيكَ معك
Dialogue: 0,0:58:27.44,0:58:30.78,Default,OKITA,0,0,0,,،سمعتُ بأنّ بعض التيغو كانوا يركضون بهمَجيّةٍ في طريق كياماتشي
Dialogue: 0,0:58:31.04,0:58:33.44,Default,OKITA,0,0,0,,.لذا أحضرتُ النّادي لهزيمتهم
Dialogue: 0,0:58:33.44,0:58:35.91,Default,MOMIJI,0,0,0,,.شُكراً لك
Dialogue: 0,0:58:35.91,0:58:38.74,Default,SONOKO,0,0,0,,.يُشبه شينتشي كن بالضّبط
Dialogue: 0,0:58:38.74,0:58:40.42,Default,SONOKO,0,0,0,,هل يعني ذلك...؟
Dialogue: 0,0:58:41.14,0:58:44.74,Default,MOMIJI,0,0,0,,.تقول هذه الفتاة بأنّها أرادَت لِقاءك
Dialogue: 0,0:58:45.56,0:58:46.80,Default,OKITA,0,0,0,,حقّاً؟
Dialogue: 0,0:58:46.80,0:58:49.82,Default,OKITA,0,0,0,,.إذاً أتيتِ إلى كيوتو لأنّكِ أردتّ أن تريني
Dialogue: 0,0:58:49.82,0:58:51.55,Default,RAN,0,0,0,,.أوه، لا
Dialogue: 0,0:58:52.35,0:58:53.97,Default,RAN,0,0,0,,.تـ-تعال معي
Dialogue: 0,0:58:53.97,0:58:54.72,Default,OKITA,0,0,0,,هاه؟
Dialogue: 0,0:59:43.55,0:59:46.43,Title,,0,0,0,,لوس آنجيلوس
Dialogue: 0,0:59:44.96,0:59:46.68,Default,YUKIKO,0,0,0,,{\an8}كوراتشي كيكو؟
Dialogue: 0,0:59:47.32,0:59:49.51,Default,YUKIKO,0,0,0,,.أوه، كيوكو تشان
Dialogue: 0,0:59:49.51,0:59:52.23,Default,YUKIKO,0,0,0,,.ظهرنا في الكثير من الدراما معاً
Dialogue: 0,0:59:52.23,0:59:54.94,Default,YUKIKO,0,0,0,,.بالتّأكيد، لَعبتُ دور البُطولة دائماً
Dialogue: 0,0:59:55.33,0:59:58.18,Default,SHINICHI,0,0,0,,كيوكو تشان؟ لَيس كيكو؟
Dialogue: 0,0:59:58.18,1:00:00.19,Default,YUKIKO,0,0,0,,.إسمها الحقيقيّ هو كيوكو
Dialogue: 0,1:00:00.52,1:00:04.87,Default,YUKIKO,0,0,0,,،بعد كلّ ما مرّت به بسبب مَشروع تخرّجها من الجّامعة
Dialogue: 0,1:00:04.87,1:00:07.52,Default,YUKIKO,0,0,0,,،"أضافت رمز الشّمس فوق "كيو" لـ"كيوتو
Dialogue: 0,1:00:07.52,1:00:09.83,Default,YUKIKO,0,0,0,,.و جعلَت إسمها كيكو
Dialogue: 0,1:00:10.20,1:00:10.96,Default,SHINICHI,0,0,0,,حقّاً؟
Dialogue: 0,1:00:11.25,1:00:13.16,Default,YUKIKO,0,0,0,,،بالحديث عن الأسماء
Dialogue: 0,1:00:13.16,1:00:17.59,Default,YUKIKO,0,0,0,,قالَت بأنّ نيشيكي سان و ماياما سان قد غيّرا إسميهما
Dialogue: 0,1:00:17.59,1:00:20.34,Default,YUKIKO,0,0,0,,.لأجل مَشروع التّخرّج ذاك أيضاً
Dialogue: 0,1:00:20.57,1:00:22.28,Default,SHINICHI,0,0,0,,غيّرا إسميهما؟
Dialogue: 0,1:00:22.55,1:00:23.72,Default,YUKIKO,0,0,0,,.نعم
Dialogue: 0,1:00:23.90,1:00:29.35,Default,YUKIKO,0,0,0,,،غيّرَ ماياما سان الجبل الجّوهريّ لـ"ميني" في "مينيتو" من الأعلى إلى اليسار
Dialogue: 0,1:00:27.14,1:00:29.57,Title,TEXT,0,0,0,,مينيتو
Dialogue: 0,1:00:29.62,1:00:32.92,Default,YUKIKO,0,0,0,,.و غيّر نيشيكي سان إسمه من تارو إلى تاروبو
Dialogue: 0,1:00:29.74,1:00:33.23,Title,TEXT,0,0,0,,تاروبو
Dialogue: 0,1:00:31.02,1:00:33.23,Title,TEXT,0,0,0,,{\fad(250,1)}تارو
Dialogue: 0,1:00:33.23,1:00:38.38,Default,SHINICHI,0,0,0,,.بالتّفكير بالأمر، التيغو الأكثر أُسطوريّةً في اليابان يُدعى تاروبو أيضاً
Dialogue: 0,1:00:38.38,1:00:40.28,Default,YUKIKO,0,0,0,,،أوه، نعم. بالحديث عن كيوكو تشان
Dialogue: 0,1:00:40.68,1:00:43.27,Default,YUKIKO,0,0,0,,أحبّت شخصاً خلال الجّامعة و لَم تتزوّج
Dialogue: 0,1:00:43.27,1:00:47.28,Default,YUKIKO,0,0,0,,.لأنّها مازالَت تُحبّه
Dialogue: 0,1:00:47.67,1:00:49.03,Default,YUSAKU,0,0,0,,.فهمت
Dialogue: 0,1:00:49.03,1:00:52.35,Default,YUSAKU,0,0,0,,هل إسم ذلك الرّجل ديكوري ميتشيو كن؟
Dialogue: 0,1:00:52.35,1:00:54.21,Default,YUKIKO,0,0,0,,مُستحيل. كيف عرفت؟
Dialogue: 0,1:00:54.50,1:00:57.80,Default,SHINICHI,0,0,0,,...هاي، أُمّي. ديكوري ذاك
Dialogue: 0,1:00:57.80,1:00:59.48,Default,YUKIKO,0,0,0,,كيف عرفت؟
Dialogue: 0,1:01:00.71,1:01:02.23,Default,SHINICHI,0,0,0,,.لَقد أغلَقت الهاتف
Dialogue: 0,1:01:03.13,1:01:04.22,Default,SHINICHI,0,0,0,,رسالةٌ من سونوكو؟
Dialogue: 0,1:01:04.90,1:01:05.55,Default,SHINICHI,0,0,0,,ماذا؟
Dialogue: 0,1:01:05.55,1:01:08.43,Title,TEXT,0,0,0,,من: سوزوكي سونوكو
Dialogue: 0,1:01:05.55,1:01:08.43,Title,TEXT,0,0,0,,الموضوع: زوجتكَ تخونك
Dialogue: 0,1:01:06.73,1:01:08.43,Default,SHINICHI,0,0,0,,!أ-أوكيتا؟
Dialogue: 0,1:01:08.59,1:01:12.18,Default,SHINICHI,0,0,0,,لِـ-لِمَ ران مع أوكيتا؟
Dialogue: 0,1:01:12.40,1:01:15.19,Default,SHINICHI,0,0,0,,و ماذا تعني تعابير وَجهيهما؟
Dialogue: 0,1:01:16.52,1:01:17.44,Default,HEIJI,0,0,0,,.هاي، كودو
Dialogue: 0,1:01:18.44,1:01:19.87,Default,HEIJI,0,0,0,,ما الذي تنظُر إليه؟
Dialogue: 0,1:01:19.87,1:01:21.07,Default,SHINICHI,0,0,0,,.لا شيء
Dialogue: 0,1:01:21.40,1:01:22.43,Default,HEIJI,0,0,0,,.لنذهب
Dialogue: 0,1:01:22.43,1:01:24.35,Default,SHINICHI,0,0,0,,إ-إلى أين؟
Dialogue: 0,1:01:24.35,1:01:25.96,Default,HEIJI,0,0,0,,.إلى فُندق غيون
Dialogue: 0,1:01:25.96,1:01:30.12,Default,SERA,0,0,0,,،عندما حاول نيشيكي سان حجز غُرفةٍ للمُدخّنين
Dialogue: 0,1:01:30.39,1:01:33.32,Default,SERA,0,0,0,,،أخبروه في البداية بأنّها كانت مَحجوزةً بالكامل
Dialogue: 0,1:01:33.32,1:01:37.43,Default,SERA,0,0,0,,.لكن أُلغيَ حجزٌ بينما كان يتحدّث بالهاتف، لذا حصل على غُرفةٍ بعد كلّ شيء
Dialogue: 0,1:01:37.43,1:01:39.38,Default,SERA,0,0,0,,تشعر بالفُضول، صحيح؟
Dialogue: 0,1:01:39.38,1:01:40.75,Default,SHINICHI,0,0,0,,...نـ-نعم
Dialogue: 0,1:01:41.36,1:01:42.63,Default,SHINICHI,0,0,0,,.بالفِعل
Dialogue: 0,1:01:43.07,1:01:45.13,Default,SHINICHI,0,0,0,,.هذا يُشعرني بالفُضول أيضاً
Dialogue: 0,1:01:48.70,1:01:50.64,Default,RECEPTION,0,0,0,,.نعم، هذا صحيح
Dialogue: 0,1:01:51.04,1:01:54.73,Default,RECEPTION,0,0,0,,.تمّ إلغاء حجزٍ بينما كنّا نُكلّم نيشيكي ساما على الهاتف
Dialogue: 0,1:01:54.73,1:01:57.77,Default,RECEPTION,0,0,0,,.حجزَ الغُرفة ليومين بِدءاً من البارحة
Dialogue: 0,1:01:57.95,1:01:59.45,Default,AYANOKOJI,0,0,0,,.فهمت
Dialogue: 0,1:01:59.45,1:02:02.65,Default,HEIJI,0,0,0,,.بالتّفكير بالأمر، تُدخّن أيضاً، أغاتا سان
Dialogue: 0,1:02:03.09,1:02:05.49,Default,HEIJI,0,0,0,,هل تمكّنتَ من حجز غُرفةٍ على الفور؟
Dialogue: 0,1:02:05.49,1:02:06.57,Default,AGATA,0,0,0,,.نعم
Dialogue: 0,1:02:06.57,1:02:09.78,Default,AGATA,0,0,0,,.قام أحدٌ آخر بالإلغاء بعد اتّصال نيشيكي مُباشرةً
Dialogue: 0,1:02:10.18,1:02:15.60,Default,AGATA,0,0,0,,.إجتمعنا في غُرفة نيشيكي و قُمنا بحُجوزاتنا معاً
Dialogue: 0,1:02:15.60,1:02:16.72,Default,AGATA,0,0,0,,صحيح؟
Dialogue: 0,1:02:16.72,1:02:17.79,Default,KEIKO,0,0,0,,.نعم
Dialogue: 0,1:02:17.99,1:02:19.15,Default,AYANOKOJI,0,0,0,,حقّاً؟
Dialogue: 0,1:02:20.14,1:02:21.19,Default,RECEPTION,0,0,0,,.نعم
Dialogue: 0,1:02:21.19,1:02:23.49,Default,RECEPTION,0,0,0,,،بعد أن قام نيشيكي بالحجز
Dialogue: 0,1:02:23.49,1:02:27.72,Default,RECEPTION,0,0,0,,.ألغى شخصٌ آخر، و حجزَ أغاتا سان الغُرفة
Dialogue: 0,1:02:27.94,1:02:31.58,Default,RECEPTION,0,0,0,,.كانت مَجموعة ضُيوفٍ من ألغوا
Dialogue: 0,1:02:31.58,1:02:34.60,Default,SERA,0,0,0,,،بالحديث عن غُرفة أغاتا سان
Dialogue: 0,1:02:34.81,1:02:37.37,Default,SERA,0,0,0,,.ظهرَ تيغو ضخمٌ داخلها على ما يبدو
Dialogue: 0,1:02:37.37,1:02:40.93,Default,SERA,0,0,0,,هل صحيحٌ أنّه لَم يتمّ إيجاد أيّ شيءٍ غريبٍ في الغُرفة بعدها؟
Dialogue: 0,1:02:40.93,1:02:41.94,Default,AYANOKOJI,0,0,0,,.نعم
Dialogue: 0,1:02:41.94,1:02:45.87,Default,AYANOKOJI,0,0,0,,،كانت تُوجد مادّةٌ شبيهةٌ بالصّمغ على السّقف المُحترِق
Dialogue: 0,1:02:45.87,1:02:50.24,Default,AYANOKOJI,0,0,0,,.لكنّه لَم يكُن كافياً لدَعم شيءٍ كبير
Dialogue: 0,1:02:50.53,1:02:55.47,Default,AYANOKOJI,0,0,0,,كانت تُوجد أيضاً علاماتٌ ترَكها الكُرسيّ عندما وَقعَ عنه أغاتا سان
Dialogue: 0,1:02:55.47,1:02:58.58,Default,AYANOKOJI,0,0,0,,و حرقٌ بطول 3سم في السجّادة
Dialogue: 0,1:02:58.58,1:03:01.25,Default,AYANOKOJI,0,0,0,,.عندما سقطَت سيجارةٌ من مِطفأة السّجائر التي تمّ رميُها على التيغو
Dialogue: 0,1:03:01.59,1:03:05.84,Default,AYANOKOJI,0,0,0,,.و لسببٍ ما، كانت تُوجد وِسادةٌ أُخرى في مُنتصف السّرير
Dialogue: 0,1:03:05.84,1:03:08.51,Default,AGATA,0,0,0,,.هـ-هذه عادَتي
Dialogue: 0,1:03:08.51,1:03:12.76,Default,AGATA,0,0,0,,{\an8}.تتشنّج ساقاي إن لَم أضع وِسادةً تحتها
Dialogue: 0,1:03:08.74,1:03:12.76,Default,SHINICHI,0,0,0,,.ما الأمر، هناك شيءٌ بهذا لَم يبدو مَنطقيّاً
Dialogue: 0,1:03:13.39,1:03:15.35,Default,SHINICHI,0,0,0,,...الصّمغ على السّقف
Dialogue: 0,1:03:16.02,1:03:17.95,Default,SHINICHI,0,0,0,,...العلامات التي ترَكها الكُرسيّ
Dialogue: 0,1:03:19.22,1:03:20.77,Default,OKITA,0,0,0,,.أنا أوكيتا سوشي
Dialogue: 0,1:03:21.96,1:03:23.27,Default,SHINICHI,0,0,0,,...حرق السّيجارة
Dialogue: 0,1:03:23.54,1:03:25.52,Default,RAN,0,0,0,,.أتسائل إن كنّا سنتمكّن من لِقاء أوكيتا كن
Dialogue: 0,1:03:26.17,1:03:28.03,Default,SHINICHI,0,0,0,,...الوِسادة في مُنتصف السّرير
Dialogue: 0,1:03:28.03,1:03:29.53,Title,TEXT,0,0,0,,من: سوزوكي سونوكو
Dialogue: 0,1:03:28.03,1:03:29.53,Title,TEXT,0,0,0,,الموضوع: زوجتكَ تخونك
Dialogue: 0,1:03:28.03,1:03:29.53,Default,SONOKO,0,0,0,,.زوجتكَ تخونك
Dialogue: 0,1:03:32.20,1:03:33.81,Default,SHINICHI,0,0,0,,.سُحقاً
Dialogue: 0,1:03:33.81,1:03:37.79,Default,SHINICHI,0,0,0,,.لا يُمكنني التّركيز على القضيّة لأنّني أستمرّ بالتّفكير بصورتهما تلك
Dialogue: 0,1:03:38.36,1:03:41.29,Default,SHINICHI,0,0,0,,.لا أملك الوَقت للتّفكير بهذا الآن
Dialogue: 0,1:03:41.48,1:03:43.21,Default,SHINICHI,0,0,0,,ماذا؟ وَقت؟
Dialogue: 0,1:03:45.06,1:03:47.64,Default,SHINICHI,0,0,0,,.تبّاً. ها قد بدأ
Dialogue: 0,1:03:47.64,1:03:49.80,Default,SHINICHI,0,0,0,,.أبكَر من البارحة
Dialogue: 0,1:03:50.15,1:03:52.48,Default,HEIJI,0,0,0,,هـ-هاي، كودو. هل أنتَ بخير؟
Dialogue: 0,1:03:52.48,1:03:53.68,Default,SHINICHI,0,0,0,,.نـ-نعم
Dialogue: 0,1:03:54.00,1:03:56.65,Default,SHINICHI,0,0,0,,.الأهمّ، أعرف من الجّاني
Dialogue: 0,1:03:56.65,1:03:57.46,Default,BOTH,0,0,0,,ماذا؟
Dialogue: 0,1:03:57.46,1:03:58.47,Default,HEIJI,0,0,0,,حقّاً؟
Dialogue: 0,1:03:58.47,1:04:03.70,Default,SHINICHI,0,0,0,,.لكن لا تُوجد أدلّةٌ كافيةٌ لاعتقاله
Dialogue: 0,1:04:03.70,1:04:05.98,Default,HEIJI,0,0,0,,ماذا ستفعل إذاً، كودو؟
Dialogue: 0,1:04:06.81,1:04:07.94,Default,SHINICHI,0,0,0,,.مُفتّش أيانوكوجي
Dialogue: 0,1:04:08.18,1:04:09.23,Default,AYANOKOJI,0,0,0,,ما الأمر؟
Dialogue: 0,1:04:09.23,1:04:13.29,Default,SHINICHI,0,0,0,,هل يُمكنني الحصول على بعض المُساعدة من شُرطة كيوتو؟
Dialogue: 0,1:04:13.29,1:04:15.57,Default,AYANOKOJI,0,0,0,,.نعم، إن كان بإمكاننا
Dialogue: 0,1:04:15.75,1:04:23.33,Default,SHINICHI,0,0,0,,.قـ-قد يكون هذا... مُحرجاً قليلاً مع ذلك
Dialogue: 0,1:04:29.22,1:04:34.72,Default,AYANOKOJI,0,0,0,,{\a6}،على أيّة حال، بما أنّه قد تمّ إيجاد شيفرةٍ جديدةٍ على جُثّة إيهايا سان البارحة
Dialogue: 0,1:04:29.67,1:04:33.18,Caracters,AYANOKOJI,0,0,0,,{\fad(278,438)\pos(636,613)}في اليوم التّالي
Dialogue: 0,1:04:35.16,1:04:41.23,Default,AYANOKOJI,0,0,0,,.قد يُخطّط الجّاني لقتل شخصٍ آخر منكم
Dialogue: 0,1:04:41.43,1:04:47.15,Default,AYANOKOJI,0,0,0,,.أرجوكم إبقوا في غُرفكم حتّى وَقت مُغادرة الفُندق
Dialogue: 0,1:04:47.42,1:04:49.27,Default,AYANOKOJI,0,0,0,,،لاتّخاذ الحيطة
Dialogue: 0,1:04:49.27,1:04:53.44,Default,AYANOKOJI,0,0,0,,.سنُعيّن شُرطيّاً أمام غُرَف كلٍّ منكم
Dialogue: 0,1:04:53.44,1:04:55.00,Default,MAYAMA,0,0,0,,.شُكراً لك
Dialogue: 0,1:04:55.00,1:04:55.97,Default,AYANOKOJI,0,0,0,,.وَداعاً
Dialogue: 0,1:04:58.95,1:05:01.58,Default,HEIJI,0,0,0,,هاي، كودو. هل أنتَ بخير؟
Dialogue: 0,1:05:01.58,1:05:03.32,Default,SHINICHI,0,0,0,,.نعم، بالكاد
Dialogue: 0,1:05:03.32,1:05:05.40,Default,SHINICHI,0,0,0,,.أخذتُ دوائي مُتأخّراً صباخ اليوم
Dialogue: 0,1:05:05.40,1:05:06.23,Default,SERA,0,0,0,,دواءك؟
Dialogue: 0,1:05:06.23,1:05:06.88,Default,BOTH,0,0,0,,هاه؟
Dialogue: 0,1:05:07.18,1:05:08.57,Default,SERA,0,0,0,,أيّ دواء؟
Dialogue: 0,1:05:09.12,1:05:10.66,Default,SHINICHI,0,0,0,,.دواء البرد
Dialogue: 0,1:05:11.14,1:05:12.32,Default,SERA,0,0,0,,حقّاً؟
Dialogue: 0,1:05:13.27,1:05:16.66,Default,MAYAMA,0,0,0,,.تحوّل الأمر إلى زيارةٍ لا مثيل لها
Dialogue: 0,1:05:16.66,1:05:17.51,Default,AGATA,0,0,0,,.نعم
Dialogue: 0,1:05:17.51,1:05:20.35,Default,AGATA,0,0,0,,.لَم نتمكّن من الوُصول إلى قبر ديكوري حتّى
Dialogue: 0,1:05:20.87,1:05:23.04,Default,MAYAMA,0,0,0,,.سنحتاج للذّهاب في وَقتٍ آخر
Dialogue: 0,1:05:23.04,1:05:24.23,Default,AGATA,0,0,0,,.أنتَ مُحقّ
Dialogue: 0,1:05:24.23,1:05:25.47,Default,MAYAMA,0,0,0,,.أراكما لاحقاً
Dialogue: 0,1:05:25.47,1:05:26.44,Default,BOTH,0,0,0,,.حسناً
Dialogue: 0,1:05:34.05,1:05:34.97,Default,KEIKO,0,0,0,,حُلمك؟
Dialogue: 0,1:05:36.77,1:05:38.87,Default,KEIKO,0,0,0,,هذا هو حُلمك، ديكوري كن؟
Dialogue: 0,1:05:39.46,1:05:40.58,Default,DEKURI,0,0,0,,.نعم
Dialogue: 0,1:05:40.58,1:05:46.87,Default,DEKURI,0,0,0,,رُؤية عبارة "مُعتمِدةٌ على الرّسوم الهزليّة من تأليف ديكوري ميتشيو" على\N.الشّاشة الكبيرة هو حُلمي
Dialogue: 0,1:06:05.74,1:06:06.69,Default,DEKURI,0,0,0,,حقّاً؟
Dialogue: 0,1:06:07.08,1:06:10.84,Default,DEKURI,0,0,0,,ستضع إسمي في قائمة المُشاركين بالعمل حقّاً؟
Dialogue: 0,1:06:12.20,1:06:16.67,Default,MAYAMA,0,0,0,,.بالتّأكيد. أنتَ كاتب القِصّة
Dialogue: 0,1:06:16.67,1:06:17.71,Default,DEKURI,0,0,0,,.يُسعِدني هذا
Dialogue: 0,1:06:17.71,1:06:18.20,Default,MAYAMA,0,0,0,,ماذا؟
Dialogue: 0,1:06:18.92,1:06:21.34,Default,DEKURI,0,0,0,,.لَقد ندمتُ على هذا دائماً في الوَاقع
Dialogue: 0,1:06:21.71,1:06:24.97,Default,DEKURI,0,0,0,,،أُنتِجَ مَشروع تخرّجكم بشكلٍ مُمتاز
Dialogue: 0,1:06:24.97,1:06:27.83,Default,DEKURI,0,0,0,,.قلتُ هذا بسبب خيبة الأمَل
Dialogue: 0,1:06:28.27,1:06:31.73,Default,DEKURI,0,0,0,,.أعتذر. و شُكراً لك
Dialogue: 0,1:06:43.68,1:06:45.89,Default,AGATA,0,0,0,,ما الخطب، ديكوري؟
Dialogue: 0,1:06:47.26,1:06:49.87,Default,AGATA,0,0,0,,.نحتاج للمُغادرة\N.إنّهم يُغلِقون المَسرَح
Dialogue: 0,1:06:49.87,1:06:51.02,Default,DEKURI,0,0,0,,.هذا غريب
Dialogue: 0,1:06:51.74,1:06:55.11,Default,DEKURI,0,0,0,,.مهما انتظرت، لَم يظهر إسمي أبداً
Dialogue: 0,1:06:55.54,1:06:56.82,Default,DEKURI,0,0,0,,ألَيس هذا غريباً؟
Dialogue: 0,1:07:26.66,1:07:27.98,Default,POLICE,0,0,0,,إلى أين تذهب؟
Dialogue: 0,1:07:29.23,1:07:30.25,Default,MAYAMA,0,0,0,,.إلى دورة المياه
Dialogue: 0,1:07:30.25,1:07:33.05,Default,MAYAMA,0,0,0,,.دورة مياه غُرفتي مُعطّلة
Dialogue: 0,1:07:33.05,1:07:34.61,Default,MAYAMA,0,0,0,,.سأذهب إلى دورة مياه الرّدهة
Dialogue: 0,1:07:34.99,1:07:36.60,Default,MAYAMA,0,0,0,,.سأعود على الفور
Dialogue: 0,1:07:36.60,1:07:37.75,Default,POLICE,0,0,0,,.كُن حذراً
Dialogue: 0,1:07:43.62,1:07:44.62,Default,POLICE,0,0,0,,مرحباً؟
Dialogue: 0,1:07:53.78,1:07:54.91,Default,MAYAMA,0,0,0,,.إلى مَعبد كيوميزو
Dialogue: 0,1:07:54.91,1:07:56.38,Default,DRIVER,0,0,0,,.حسناً
Dialogue: 0,1:07:59.00,1:07:59.96,Default,AGATA,0,0,0,,مرحباً؟
Dialogue: 0,1:07:59.96,1:08:02.67,Default,MAYAMA,0,0,0,,أغاتا، حتّى متى ستجعلني أنتظر؟
Dialogue: 0,1:08:02.67,1:08:04.49,Default,AGATA,0,0,0,,تنتظر؟ ما الذي تتكلّم عنه؟
Dialogue: 0,1:08:04.49,1:08:05.20,Default,MAYAMA,0,0,0,,ماذا؟
Dialogue: 0,1:08:05.71,1:08:10.33,Default,MAYAMA,0,0,0,,،أرسلتَ لي رسالةً قبل قليلٍ تقول بأنّكَ قتلتَ نيشيكي و إيهايا
Dialogue: 0,1:08:10.33,1:08:16.84,Title,TEXT,0,0,0,,الموضوع: أنا أغاتا
Dialogue: 0,1:08:10.33,1:08:16.84,Title,TEXT,0,0,0,,.قتلتُ نيشيكي و إيهايا\N.هناك ما أرغب بإخباركَ به قبل أن تعتقِلني الشّرطة\N.إلتقي بي في الكيوميزو بوتاي
Dialogue: 0,1:08:10.57,1:08:14.35,Default,MAYAMA,0,0,0,,و أردتّ التّكلّم معي في الكيوميزو بوتاي
Dialogue: 0,1:08:14.35,1:08:16.84,Default,MAYAMA,0,0,0,,.قبل أن تعتقِلكَ الشّرطة
Dialogue: 0,1:08:16.84,1:08:20.20,Default,AGATA,0,0,0,,.ماذا؟ لَم أكُن لأُرسل هذا أبداً
Dialogue: 0,1:08:20.20,1:08:21.83,Default,AGATA,0,0,0,,هل تفقّدتّ العنوان الإلكترونيّ للمُرسل؟
Dialogue: 0,1:08:21.83,1:08:23.26,Default,MAYAMA,0,0,0,,.إ-إنتظر
Dialogue: 0,1:08:24.11,1:08:29.23,Default,MAYAMA,0,0,0,,."chestnut@" عنوان المُرسل الإلكترونيّ هو
Dialogue: 0,1:08:30.33,1:08:31.59,Default,MAYAMA,0,0,0,,...كستناء
Dialogue: 0,1:08:32.22,1:08:34.90,Default,AGATA,0,0,0,,ألا تعني "كوري" كستناء؟
Dialogue: 0,1:08:34.90,1:08:37.25,Default,AGATA,0,0,0,,ألَيس هذا عنوان ديكوري الإلكترونيّ؟
Dialogue: 0,1:08:37.25,1:08:38.24,Default,VOICE,0,0,0,,.هذا صحيح
Dialogue: 0,1:08:41.58,1:08:43.47,Default,VOICE,0,0,0,,.أنا من أرسل الرّسالة
Dialogue: 0,1:08:43.47,1:08:44.62,Default,VOICE,0,0,0,,.أنا، ديكوري
Dialogue: 0,1:08:45.37,1:08:46.93,Default,MAYAMA,0,0,0,,!هـ-هذا مُستحيل
Dialogue: 0,1:08:46.93,1:08:48.25,Default,MAYAMA,0,0,0,,!أنتَ ميّت
Dialogue: 0,1:08:48.68,1:08:50.33,Default,VOICE,0,0,0,,.هذا صحيح
Dialogue: 0,1:08:50.33,1:08:52.09,Default,VOICE,0,0,0,,،بعد خيانتكم لي
Dialogue: 0,1:08:52.09,1:08:56.98,Default,VOICE,0,0,0,,.بدافع يأسي، رميتُ بنفسي من الكيوميزو بوتاي و انتحرت
Dialogue: 0,1:08:56.98,1:08:57.96,Default,VOICE,0,0,0,,...لكن
Dialogue: 0,1:09:00.36,1:09:05.39,Default,VOICE,0,0,0,,.للإنتقام، عُدتّ من العالَم السّفليّ
Dialogue: 0,1:09:06.63,1:09:08.76,Default,VOICE,0,0,0,,كيف أمكنكم خِداعي هكذا؟
Dialogue: 0,1:09:08.76,1:09:10.89,Default,VOICE,0,0,0,,.لَن أُسامحكم أبداً. أبداً
Dialogue: 0,1:09:11.97,1:09:13.02,Default,VOICE,0,0,0,,!لَن أُسامحكم أبداً
Dialogue: 0,1:09:13.24,1:09:16.52,Default,MAYAMA,0,0,0,,...كـ-كلّا! كـ-كان إسمكَ في الوَاقع
Dialogue: 0,1:09:19.95,1:09:22.15,Default,CULPRIT,0,0,0,,إعتذر من ديكوري
Dialogue: 0,1:09:22.60,1:09:24.26,Default,CULPRIT,0,0,0,,!في الجّحيم
Dialogue: 0,1:09:36.85,1:09:37.80,Default,CULPRIT,0,0,0,,لماذا؟
Dialogue: 0,1:09:38.21,1:09:40.63,Default,SHINICHI,0,0,0,,.البوتاي بارتفاع 12م تقريباً
Dialogue: 0,1:09:44.59,1:09:47.22,Default,SHINICHI,0,0,0,,،إن وَضعتَ وِسادةً مُسبقاً
Dialogue: 0,1:09:47.22,1:09:50.14,Default,SHINICHI,0,0,0,,،لَن ينتهي بكَ الأمر في العالَم السّفليّ
Dialogue: 0,1:09:52.48,1:09:53.83,Default,SHINICHI,0,0,0,,.أغاتا ريكي سان
Dialogue: 0,1:09:54.32,1:09:55.82,Default,AGATA,0,0,0,,كيف عرفتُم بأنّني سأكون هُنا؟
Dialogue: 0,1:09:55.82,1:09:57.40,Default,AGATA,0,0,0,,هل حللتُم الشّيفرة؟
Dialogue: 0,1:09:57.81,1:09:58.94,Default,SHINICHI,0,0,0,,.نعم
Dialogue: 0,1:09:58.94,1:10:01.47,Default,SHINICHI,0,0,0,,المِفتاح لحلّها هو شكل الصّليب المُحاطِ
Dialogue: 0,1:10:01.47,1:10:05.40,Default,SHINICHI,0,0,0,,.بـ4 مُربّعاتٍ سوداء في أعلى الشّيفرة
Dialogue: 0,1:10:06.00,1:10:11.49,Default,SHINICHI,0,0,0,,،تُشير إلى كاميغيو، و ناكاغيو، و شيموغيو، و ساكيو
Dialogue: 0,1:10:07.58,1:10:08.53,Title,TEXT,0,0,0,,{\fad(210,210)}الأعلى
Dialogue: 0,1:10:08.58,1:10:09.54,Title,TEXT,0,0,0,,{\fad(210,210)}الأوسط
Dialogue: 0,1:10:09.58,1:10:10.79,Title,TEXT,0,0,0,,{\fad(210,210)}الأسفل
Dialogue: 0,1:10:10.83,1:10:11.41,Title,TEXT,0,0,0,,{\fad(210,210)}الأيسر
Dialogue: 0,1:10:11.45,1:10:12.04,Title,TEXT,0,0,0,,{\fad(210,210)}الأيمن
Dialogue: 0,1:10:11.49,1:10:13.46,Default,SHINICHI,0,0,0,,.و أوكيو، أجنحة كيوتو
Dialogue: 0,1:10:13.46,1:10:16.92,Default,SHINICHI,0,0,0,,.بقيّة الرّموز هي أجزاءٌ من أسماء مَوَاقع في كيوتو
Dialogue: 0,1:10:17.58,1:10:20.49,Default,SHINICHI,0,0,0,,مُقارنتُها بمَوَاقع الرّموز في الصّليب الأبيض
Dialogue: 0,1:10:20.49,1:10:25.22,Default,SHINICHI,0,0,0,,.تُبيّن أسماء المَوَاقع التي تُشير لها و كيفيّة قِراءتها
Dialogue: 0,1:10:25.95,1:10:28.00,Default,SHINICHI,0,0,0,,،باستخدام تلك الطّريقة
Dialogue: 0,1:10:28.00,1:10:31.77,Default,SHINICHI,0,0,0,,...بداية الشّيفرة المُرسلَة إلى نيشيكي سان تحوي
Dialogue: 0,1:10:32.62,1:10:35.10,Default,SHINICHI,0,0,0,,.كون" من كونتاكا تشو في جناح كاميغيو"
Dialogue: 0,1:10:35.10,1:10:37.76,Default,SHINICHI,0,0,0,,.رو" من توروياما تشو في جناح ناكاغيو"
Dialogue: 0,1:10:37.76,1:10:40.68,Default,SHINICHI,0,0,0,,.سوجي" من سوجيكايباشي تشو في جناح كاميغيو"
Dialogue: 0,1:10:40.68,1:10:42.88,Default,SHINICHI,0,0,0,,.نو" من أداشينو في جناح أوكيو"
Dialogue: 0,1:10:42.88,1:10:45.20,Default,SHINICHI,0,0,0,,.هاتي" من كاميهاتي تشو في جناح سايكو"
Dialogue: 0,1:10:45.89,1:10:48.87,Default,SHINICHI,0,0,0,,،إن قُمتَ بصفّ اللّفظ الأوّل من كلّ رمزٍ معاً
Dialogue: 0,1:10:49.31,1:10:52.16,Default,SHINICHI,0,0,0,,."تحصل على "كو-رو-سو-نو-ها
Dialogue: 0,1:10:52.76,1:10:55.16,Default,SHINICHI,0,0,0,,."بمَعنىً آخر، تُصبح "سأقتُل
Dialogue: 0,1:10:55.79,1:10:59.42,Default,HEIJI,0,0,0,,الرّمز العكسيّ لـ"ساكي" الذي يظهر أحياناً
Dialogue: 0,1:10:59.42,1:11:02.21,Default,HEIJI,0,0,0,,.هو الـ"بون" من بونتو تشو في جناح ناكاغيو
Dialogue: 0,1:11:02.21,1:11:05.88,Default,HEIJI,0,0,0,,.إن قلَبتَها، تحصل على "نوب"، لذا تقرأها كـ"ن" فقط
Dialogue: 0,1:11:06.18,1:11:09.18,Default,HEIJI,0,0,0,,،إذاً مَعنى الشّيفرة الـ1 هو
Dialogue: 0,1:11:09.39,1:11:14.32,Default,HEIJI,0,0,0,,."سأقتُل 3 بِدءاً بكاتب النّصّ"
Dialogue: 0,1:11:14.95,1:11:20.23,Default,SERA,0,0,0,,،إن قرأتَ الشّيفرة الـ3 التي وُجِدَت على جُثّة نيشيكي سان بنفس الطّريقة
Dialogue: 0,1:11:20.23,1:11:24.04,Default,SERA,0,0,0,,."تحصل على "2 آخران لقتلِهما، التّالي هو النّجم
Dialogue: 0,1:11:24.58,1:11:26.20,Default,SERA,0,0,0,,،تعني الشّيفرة الـ3
Dialogue: 0,1:11:26.20,1:11:32.00,Default,SERA,0,0,0,,."1آخر لقتلِه، بعدها سأسقط من البوتاي"
Dialogue: 0,1:11:32.66,1:11:36.37,Default,SERA,0,0,0,,،بعد جعل موت ماياما سان يبدو كانتحار
Dialogue: 0,1:11:36.37,1:11:38.83,Default,SERA,0,0,0,,،نويتَ على الأرجح إعلان اكتشافكَ لطريقة قِراءة الشّيفرة
Dialogue: 0,1:11:39.11,1:11:43.59,Default,SERA,0,0,0,,،ممّا سيجعل الأمر يبدو كما لَو أنّ الشّيفرة الـ3 هي رسالة انتحار ماياما سان
Dialogue: 0,1:11:44.26,1:11:46.84,Default,SERA,0,0,0,,،لكن بسبب كتابتكَ أين ستنتحر
Dialogue: 0,1:11:47.21,1:11:50.59,Default,SERA,0,0,0,,.تمكّنّا من أن نسبقكَ إلى هُنا
Dialogue: 0,1:11:50.59,1:11:52.53,Default,AGATA,0,0,0,,.إ-إنّها اللّعنة
Dialogue: 0,1:11:52.94,1:11:54.19,Default,AGATA,0,0,0,,!إنّها اللّعنة
Dialogue: 0,1:11:54.63,1:11:58.95,Default,AGATA,0,0,0,,!إنّها لَعنةٌ التي دفعَتني لفِعل كلّ هذا
Dialogue: 0,1:11:59.37,1:12:02.98,Default,AGATA,0,0,0,,ألَم تروا السّقف في غُرفة نيشيكي؟
Dialogue: 0,1:12:03.41,1:12:05.93,Default,AGATA,0,0,0,,!لا يُمكن أن يكون بَشريّاً قد فعلَ ذلك بأقلّ من 10 دقائق
Dialogue: 0,1:12:05.93,1:12:07.40,Default,SHINICHI,0,0,0,,.أوراق مُلاحظاتٍ إستاتيكيّة
Dialogue: 0,1:12:08.41,1:12:14.41,Default,SHINICHI,0,0,0,,باستخدام أوراق مُلاحظاتٍ إستاتيكيّة، التي يُمكنها أن تلتصق على أيّ\N.جدارٍ أو شيءٍ دون أيّ موادٍّ لاصقة
Dialogue: 0,1:12:14.73,1:12:19.92,Default,SHINICHI,0,0,0,,.إستخدمتَ أوراق المُلاحظات التي استخدمَها نيشيكي سان لمُراجعة النّصّ
Dialogue: 0,1:12:21.36,1:12:25.15,Default,SHINICHI,0,0,0,,بدأتَ بالإقامة في تلك الغُرفة في اليوم السّابق
Dialogue: 0,1:12:25.62,1:12:29.49,Default,SHINICHI,0,0,0,,.و رسم رشق الدّم و آثار خُطى الأقدام على السّقف، ممّا سمحَ لها بأن تجفّ
Dialogue: 0,1:12:29.93,1:12:34.18,Default,SHINICHI,0,0,0,,.أخفيتَها بتغطية كامل السّقف بأوراق مُلاحظاتٍ إستاتيكيّة
Dialogue: 0,1:12:34.65,1:12:39.44,Default,SHINICHI,0,0,0,,.بطبيعة الحال، حجزتَ غُرفة المُدخّنين تلك لليوم التّالي أيضاً
Dialogue: 0,1:12:40.55,1:12:44.32,Default,SHINICHI,0,0,0,,،حجزتَ أيضاً جميع غُرف المُدخّنين الأُخرى
Dialogue: 0,1:12:44.81,1:12:47.53,Default,SHINICHI,0,0,0,,...و ألغيتَ حجزكَ للغُرفة المَدهونة بالدّم
Dialogue: 0,1:12:47.53,1:12:50.61,Default,SHINICHI,0,0,0,,،عندما اتّصل نيشيكي سان بالفُندق
Dialogue: 0,1:12:49.82,1:12:52.07,Title,TEXT,0,0,0,,إلغاء حجزك؟
Dialogue: 0,1:12:49.82,1:12:52.07,Title,TEXT,0,0,0,,كلّا    نعم
Dialogue: 0,1:12:52.84,1:12:56.86,Default,SHINICHI,0,0,0,,.ممّا سمح لكَ بإجبار نيشيكي سان على الإقامة في تلك الغُرفة
Dialogue: 0,1:12:58.06,1:13:00.23,Default,SHINICHI,0,0,0,,،بعد قتل نيشيكي سان
Dialogue: 0,1:13:00.23,1:13:03.96,Default,SHINICHI,0,0,0,,حرّكتَ عصىً على السّقف لإزالة أوراق المُلاحظات
Dialogue: 0,1:13:04.25,1:13:08.53,Default,SHINICHI,0,0,0,,.و نثرتَ نصّ نيشيكي سان بينها لإخفاء خِدعتك
Dialogue: 0,1:13:09.66,1:13:13.32,Default,SHINICHI,0,0,0,,بعدها سحبتَ بعضاً من دِماء نيشيكي سان بإبرةٍ
Dialogue: 0,1:13:13.32,1:13:17.72,Default,SHINICHI,0,0,0,,.و رشقتَها في مِنتصف رشق الدّماء الذي رسمتَه على السّقف
Dialogue: 0,1:13:18.97,1:13:20.39,Default,AGATA,0,0,0,,ما-ماذا عن التينغو إذاً؟
Dialogue: 0,1:13:20.79,1:13:24.82,Default,AGATA,0,0,0,,ماذا عن التينغو الضّخم الذي ظهرَ فجأةً
Dialogue: 0,1:13:24.82,1:13:26.40,Default,AGATA,0,0,0,,!و اختفى من غُرفتي؟
Dialogue: 0,1:13:26.72,1:13:32.15,Default,HEIJI,0,0,0,,.كنتَ الوَحيد المُفيد عندما ساعدتّ ديكوري سان برُسومه الهزليّة
Dialogue: 0,1:13:32.45,1:13:37.16,Default,HEIJI,0,0,0,,بالتّأكيد كنتَ فنّيّاً و بارعاً بما يكفي لبناء
Dialogue: 0,1:13:37.71,1:13:41.22,Default,HEIJI,0,0,0,,.تيغو من عجينة الوَرق بذلك الحجم
Dialogue: 0,1:13:42.39,1:13:45.32,Default,HEIJI,0,0,0,,،إن صنعتَه باستخدام الوَرق سريع الإشتعال الذي يستخدِمه السّحرَة
Dialogue: 0,1:13:45.32,1:13:49.20,Default,HEIJI,0,0,0,,.وقتها تعرّضه للَهب سيجارةٍ فقط سيجعله يشتعل
Dialogue: 0,1:13:49.86,1:13:54.93,Default,SHINICHI,0,0,0,,.حرق السّيجارة بطول 3سم الذي تُرِكَ في غُرفتكَ يُثبت هذا
Dialogue: 0,1:13:55.68,1:13:59.56,Default,SHINICHI,0,0,0,,إن صرختَ عندما لاحظتَ التيغو بعد إشعال سيجارةٍ
Dialogue: 0,1:13:59.86,1:14:05.96,Default,SHINICHI,0,0,0,,،و انتظرتَ لرَمي مِطفأة سجائركَ على التيغو بعد أن وَصلنا و فتحنا الباب
Dialogue: 0,1:14:06.88,1:14:09.84,Default,SHINICHI,0,0,0,,.إذاً لَيس مَنطقيّاً بقاء كلّ هذا من سيجارتك
Dialogue: 0,1:14:10.23,1:14:11.93,Default,SHINICHI,0,0,0,,،بمَعنىً آخر
Dialogue: 0,1:14:11.93,1:14:15.95,Default,SHINICHI,0,0,0,,،أشعلتَ سيجارتكَ قبل أن نفتح الباب مُباشرةً
Dialogue: 0,1:14:16.48,1:14:20.59,Default,SHINICHI,0,0,0,,.بالرّغم من أنّه يُفترض أن تكون مُتفاجئاً جدّاً بظُهور التيغو لتفعل ذلك
Dialogue: 0,1:14:20.59,1:14:24.04,Default,SERA,0,0,0,,أيضاً، رسمتَ آثار خُطى الأقدام
Dialogue: 0,1:14:24.04,1:14:27.57,Default,SERA,0,0,0,,،على الإينوياراي المَوجود في مَسرَح جريمة قتل إيهايا سان خلال المَساء
Dialogue: 0,1:14:27.57,1:14:31.96,Default,SERA,0,0,0,,.و وَضعتَ فوقه إينوياراي أضخم
Dialogue: 0,1:14:32.33,1:14:37.77,Default,SERA,0,0,0,,،بعد قتلِه، أزلتَ ذلك الإينوياراي، ممّا كشفَ عن آثار خُطى الأقدام
Dialogue: 0,1:14:37.77,1:14:40.22,Default,SERA,0,0,0,,.و وَضعتَه فوق إينوياراي آخر
Dialogue: 0,1:14:40.62,1:14:44.66,Default,SERA,0,0,0,,،يبدو بأنّهم وَجدوا مُختلَف أنواع الأشياء تحت ذلك الإينوياراي
Dialogue: 0,1:14:44.66,1:14:49.23,Default,SERA,0,0,0,,.مثل سلاح الجّريمة و مِعطفٌ وَاقٍ من المَطر مُغطّىً بدِماء الضّحيّة
Dialogue: 0,1:14:49.79,1:14:51.76,Default,SERA,0,0,0,,مَسحتَ عنها بصماتكَ على الأرجح
Dialogue: 0,1:14:51.76,1:14:55.73,Default,SERA,0,0,0,,.لتتمكّن من جعل الأمر يبدو كما لَو أنّ ماياما سان هو الجّاني مع ذلك
Dialogue: 0,1:14:55.73,1:14:57.11,Default,AGATA,0,0,0,,ما-ما الذي تتكلّمين عنه؟
Dialogue: 0,1:14:57.48,1:14:58.59,Default,AGATA,0,0,0,,ألَم تُشاهدي؟
Dialogue: 0,1:14:58.59,1:15:02.04,Default,AGATA,0,0,0,,!كان ماياما يُحاول تسلّق هذا السّور
Dialogue: 0,1:15:02.31,1:15:04.21,Default,AGATA,0,0,0,,...لابدّ من أنّه قد تلَبّسه
Dialogue: 0,1:15:04.21,1:15:05.41,Default,HEIJI,0,0,0,,.كلّا
Dialogue: 0,1:15:06.04,1:15:09.56,Default,HEIJI,0,0,0,,كلّ ما يُوجد هُنا هي أوراق مُلاحظاتٍ إستاتيكيّةٍ
Dialogue: 0,1:15:09.56,1:15:12.56,Default,HEIJI,0,0,0,,.بآثار خُطىً حمراء مَرسومةً عليها
Dialogue: 0,1:15:13.07,1:15:17.41,Default,HEIJI,0,0,0,,،إن وَضعتَ أوراق مُلاحظاتٍ بنفس لَون ألواح الأرضيّة عليها
Dialogue: 0,1:15:17.41,1:15:19.68,Default,HEIJI,0,0,0,,.يُمكنكَ إخفاء آثار خُطى الأقدام
Dialogue: 0,1:15:20.18,1:15:25.31,Default,HEIJI,0,0,0,,،لأنّكَ وَصلتَها بحبلٍ من النايلون لإزالتها في الوَقت المُناسب
Dialogue: 0,1:15:25.63,1:15:30.55,Default,HEIJI,0,0,0,,.بدَت لماياما سان على أنّها آثار خُطى أقدامٍ مُدمّيةٍ تقترب منه
Dialogue: 0,1:15:31.18,1:15:34.81,Default,SHINICHI,0,0,0,,أيضاً، إستخدمتَ مُكبّر الصّوت مُحدّد الإتّجاه هذا
Dialogue: 0,1:15:34.81,1:15:38.19,Default,SHINICHI,0,0,0,,.ليتمكّن ماياما سان فقط من سماع ذلك الصّوت المُرعب
Dialogue: 0,1:15:38.19,1:15:40.87,Default,VOICE,0,0,0,,{\an8}.لَن أُسامحكم أبداً. أبداً
Dialogue: 0,1:15:39.00,1:15:41.62,Default,SHINICHI,0,0,0,,.لا عجبَ بيأسه لمُحاولة الهرَب
Dialogue: 0,1:15:42.29,1:15:45.17,Default,SHINICHI,0,0,0,,بما أنّكَ خطّطتّ على الأرجح بأن تستعيد أوراق المُلاحظات
Dialogue: 0,1:15:45.17,1:15:48.87,Default,SHINICHI,0,0,0,,،و مُكبّر الصّوت خلال الجّلَبة التي تسبّب بها انتحاره
Dialogue: 0,1:15:49.15,1:15:52.75,Default,SHINICHI,0,0,0,,.ستكون عليه بصماتُك
Dialogue: 0,1:15:52.75,1:15:53.56,Default,AGATA,0,0,0,,!سُحقاً
Dialogue: 0,1:15:54.33,1:15:55.42,Default,AGATA,0,0,0,,!إبتعدوا، أيّها الأشقياء
Dialogue: 0,1:15:59.17,1:15:59.55,Default,AGATA,0,0,0,,ماذا؟
Dialogue: 0,1:16:01.55,1:16:03.25,Default,AYANOKOJI,0,0,0,,.أعتذر
Dialogue: 0,1:16:03.25,1:16:05.66,Default,AYANOKOJI,0,0,0,,طلبَ من أفراد شُرطة كيوتو ارتداء أزيائهم المدرسيّة القديمة
Dialogue: 0,1:16:05.66,1:16:08.31,Default,AYANOKOJI,0,0,0,,و التّظاهر بأنّهم تلاميذٌ في رحلةٍ مدرسيّةٍ
Dialogue: 0,1:16:08.35,1:16:12.21,Default,AYANOKOJI,0,0,0,,.حتّى لا تكون مُتأهّباً
Dialogue: 0,1:16:12.70,1:16:13.95,Default,AGATA,0,0,0,,...مُستحيل
Dialogue: 0,1:16:14.63,1:16:15.38,Default,AGATA,0,0,0,,.سُحقاً
Dialogue: 0,1:16:16.59,1:16:17.64,Default,AGATA,0,0,0,,!سُحقاً
Dialogue: 0,1:16:19.48,1:16:21.51,Default,HEIJI,0,0,0,,.لا أفهم مع ذلك
Dialogue: 0,1:16:21.51,1:16:24.48,Default,HEIJI,0,0,0,,لِمَ وَضعتَ كدمَتان على الجّثث؟
Dialogue: 0,1:16:25.00,1:16:26.70,Default,AGATA,0,0,0,,.إنّها حكاية كوبوتوري جيسان الشّعبيّة
Dialogue: 0,1:16:27.58,1:16:30.52,Default,AGATA,0,0,0,,تعرّض الرّجل الشرّير لغضب تيغو
Dialogue: 0,1:16:30.52,1:16:34.71,Default,AGATA,0,0,0,,.عندما قلّد الرّجل الجيّد و أُصيب بكدمَتين
Dialogue: 0,1:16:34.93,1:16:39.74,Default,AGATA,0,0,0,,،عندما رأيتُ الكدمات التي أُصيبَت بها كيكو خلال التّصوير
Dialogue: 0,1:16:39.74,1:16:42.72,Default,AGATA,0,0,0,,.قرّرتُ تضمينها بخُطّتي
Dialogue: 0,1:16:43.19,1:16:48.35,Default,SERA,0,0,0,,هل كان دافعكَ غياب إسم ديكوري من قائمة المُشاركين بالعمل؟
Dialogue: 0,1:16:48.95,1:16:49.92,Default,AGATA,0,0,0,,.نعم
Dialogue: 0,1:16:50.66,1:16:53.97,Default,AGATA,0,0,0,,عندما أخبرتُهم خلال الحفلة بعد العرض الأوّليّ
Dialogue: 0,1:16:53.97,1:16:57.60,Default,AGATA,0,0,0,,،بأنّ ديكوري جلَس مَذهولاً في المَسرَح، قالوا
Dialogue: 0,1:16:58.44,1:17:01.06,Default,AGATA,0,0,0,,"حقّاً؟ هل كان مُتفاجئاً لهذا المَدى؟"
Dialogue: 0,1:17:01.06,1:17:03.71,Default,AGATA,0,0,0,,".لَقد نجحنا. أحسنتُم جميعاً"
Dialogue: 0,1:17:04.08,1:17:07.05,Default,SHINICHI,0,0,0,,لكن ألَم يكُن هذا خطأً؟
Dialogue: 0,1:17:07.80,1:17:11.75,Default,AGATA,0,0,0,,.ظننتُ هذا أيضاً، لكنّني ارتبكتُ عندما سألتُ طاقم العمل
Dialogue: 0,1:17:12.81,1:17:15.55,Default,AGATA,0,0,0,,،قالوا بأنّهم عدّلوا قائمة المُشاركين بالعمل
Dialogue: 0,1:17:15.55,1:17:20.03,Default,AGATA,0,0,0,,.لكن بدلاً من إضافة إسم أحد، عدّلوا فقط الفراغات بين بعض الرّموز
Dialogue: 0,1:17:20.79,1:17:25.51,Default,AGATA,0,0,0,,!لَم ينووا تضمين إسم ديكوري أبداً
Dialogue: 0,1:17:25.76,1:17:28.96,Default,AGATA,0,0,0,,!دعوا ديكوري إلى العرض الأوّليّ فقط ليتمكّنوا من السّخرية منه
Dialogue: 0,1:17:28.96,1:17:31.08,Default,KEIKO,0,0,0,,!أنتَ مُخطئ، أغاتا كن
Dialogue: 0,1:17:31.85,1:17:35.11,Default,KEIKO,0,0,0,,!عدّلوا الفراغات بين الرّموز
Dialogue: 0,1:17:35.11,1:17:36.67,Default,AGATA,0,0,0,,.تأخّر الوَقت على هذا كثيراً
Dialogue: 0,1:17:36.67,1:17:37.52,Default,MAYAMA,0,0,0,,.أغاتا
Dialogue: 0,1:17:38.26,1:17:42.11,Default,MAYAMA,0,0,0,,.هذه هي قائمة المُشاركين بالعمل التي كان يُفترض أن تظهرَ بعد الفِلم
Dialogue: 0,1:17:43.97,1:17:46.73,Default,MAYAMA,0,0,0,,،جعلنا أسماءنا الـ5 بأكملها مَعروضةً دُفعةً وَاحدة
Dialogue: 0,1:17:46.73,1:17:49.69,Default,MAYAMA,0,0,0,,،غيّرنا أسماءنا
Dialogue: 0,1:17:49.69,1:17:52.04,Default,MAYAMA,0,0,0,,و وضعنا فراغاتٍ غير مُتماثلةٍ بين أسمائنا
Dialogue: 0,1:17:52.04,1:17:58.55,Title,TEXT,0,0,0,,ديكوري ميتشيو
Dialogue: 0,1:17:52.65,1:17:58.32,Default,MAYAMA,0,0,0,,.ليظهرَ إسم ديكوري ميتشيو مع أسمائنا
Dialogue: 0,1:18:01.16,1:18:03.55,Default,AGATA,0,0,0,,...كـ-كلّا
Dialogue: 0,1:18:03.77,1:18:07.77,Default,MAYAMA,0,0,0,,،أردنا أن يظهرَ إسمه كمُؤلّف العمل الأصليّ
Dialogue: 0,1:18:07.77,1:18:11.72,Default,MAYAMA,0,0,0,,،لكن قال المُنتجون بأنّه لا يُمكنهم الدّفع لفردٍ آخر من طاقم العمل
Dialogue: 0,1:18:11.72,1:18:13.30,Default,MAYAMA,0,0,0,,.لذا فعلنا هذا بدلاً من ذلك
Dialogue: 0,1:18:13.71,1:18:18.07,Default,KEIKO,0,0,0,,.بما أنّه أحبّ الشّيفرات كثيراً، ظننّا بأنّه سيُلاحظ
Dialogue: 0,1:18:18.54,1:18:22.15,Default,KEIKO,0,0,0,,.فعلنا نفس الشّيء في مَشروع تخرّجنا
Dialogue: 0,1:18:22.72,1:18:25.32,Default,KEIKO,0,0,0,,.أردنا التّعبير عن امتناننا له
Dialogue: 0,1:18:25.89,1:18:28.37,Default,MAYAMA,0,0,0,,.لَم نُخبركَ بما أنّكَ و ديكوري كنتُما صديقان
Dialogue: 0,1:18:28.37,1:18:31.86,Default,MAYAMA,0,0,0,,.أردنا أن تتفاجآ معاً
Dialogue: 0,1:18:31.86,1:18:33.16,Default,KEIKO,0,0,0,,.نعتذر
Dialogue: 0,1:18:33.98,1:18:35.33,Default,AGATA,0,0,0,,ماذا فعلت؟
Dialogue: 0,1:18:35.97,1:18:37.38,Default,AGATA,0,0,0,,ماذا فعلت؟
Dialogue: 0,1:18:43.75,1:18:48.40,Default,SHINICHI,0,0,0,,،إهتزّ مَعبد كيوميزو بنحيب القاتِل النّادِم
Dialogue: 0,1:18:49.10,1:18:52.74,Default,SHINICHI,0,0,0,,كما لَو أنّ أوراق الأشجار الحمراء المُحيطة به
Dialogue: 0,1:18:53.13,1:18:55.67,Default,SHINICHI,0,0,0,,.قد اشتعلَت و ذبلَت
Dialogue: 0,1:19:00.00,1:19:01.61,Default,SONOKO,0,0,0,,.لَقد تأخّرا
Dialogue: 0,1:19:01.78,1:19:02.91,Default,RAN,0,0,0,,.نعم
Dialogue: 0,1:19:03.41,1:19:05.70,Default,RAN,0,0,0,,!أوه، إنّهما هُنا. شينتشي
Dialogue: 0,1:19:07.95,1:19:09.76,Default,SHINICHI,0,0,0,,.أعتذر لتأخّري
Dialogue: 0,1:19:09.76,1:19:11.15,Default,RAN,0,0,0,,هل أمسكتَ بالجّاني؟
Dialogue: 0,1:19:11.15,1:19:12.37,Default,SHINICHI,0,0,0,,.نعم
Dialogue: 0,1:19:12.71,1:19:15.41,Default,SHINICHI,0,0,0,,.لكن لا حاجة لأن تقلَقي بشأن هذا
Dialogue: 0,1:19:15.41,1:19:16.53,Default,SONOKO,0,0,0,,ما مُشكلتك؟
Dialogue: 0,1:19:16.53,1:19:20.35,Default,SONOKO,0,0,0,,.غيّرنا خُططنا لنتمكّن من أن نلتقي بك
Dialogue: 0,1:19:20.86,1:19:22.38,Default,SHINICHI,0,0,0,,.كانت قضيّةً بشعة
Dialogue: 0,1:19:23.18,1:19:25.27,Default,SERA,0,0,0,,.على أيّة حال، مازال لَدينا بعض الوَقت
Dialogue: 0,1:19:25.27,1:19:26.51,Default,SERA,0,0,0,,هل نذهب إلى مكانٍ ما؟
Dialogue: 0,1:19:26.86,1:19:28.70,Default,RAN,0,0,0,,.لنذهب إلى كيتانو تينمانغو
Dialogue: 0,1:19:28.70,1:19:31.14,Default,RAN,0,0,0,,.ذكرَه أوكيتا كن سابقاً
Dialogue: 0,1:19:31.14,1:19:32.89,Default,SONOKO,0,0,0,,.جميل. لنذهب
Dialogue: 0,1:19:34.07,1:19:36.48,Default,SERA,0,0,0,,.إنّه بعيد
Dialogue: 0,1:19:36.48,1:19:37.64,Default,SERA,0,0,0,,كيف نصل إليه؟
Dialogue: 0,1:19:38.01,1:19:39.52,Default,SHINICHI,0,0,0,,.هاي
Dialogue: 0,1:19:40.78,1:19:42.47,Default,SHINICHI,0,0,0,,كيف تشعرين؟
Dialogue: 0,1:19:42.47,1:19:43.61,Default,RAN,0,0,0,,نحو ماذا؟
Dialogue: 0,1:19:43.61,1:19:45.24,Default,SHINICHI,0,0,0,,.نحوي
Dialogue: 0,1:19:45.24,1:19:48.03,Default,SHINICHI,0,0,0,,.سمعتُ بأنّكِ التقيتِ بأوكيتا البارحة
Dialogue: 0,1:19:50.18,1:19:55.25,Default,SHINICHI,0,0,0,,...لَم تنسي بأنّني اعترفتُ بمَشاعري لكِ في لندن
Dialogue: 0,1:20:10.11,1:20:13.01,Default,SHINICHI,0,0,0,,.سمعتُ بأنّكِ التقيتِ بأوكيتا البارحة
Dialogue: 0,1:20:13.57,1:20:17.18,Default,SHINICHI,0,0,0,,...لَم تنسي بأنّني اعترفتُ بمَشاعري لكِ في لندن
Dialogue: 0,1:20:29.73,1:20:31.62,Default,RAN,0,0,0,,.هذه هي إجابتي
Dialogue: 0,1:20:34.45,1:20:36.62,Default,RAN,0,0,0,,ألا يكفي هذا؟
Dialogue: 0,1:20:36.86,1:20:37.62,Default,SHINICHI,0,0,0,,...أنتِ
Dialogue: 0,1:20:40.08,1:20:41.52,Default,SHINICHI,0,0,0,,.لا يُمكنكِ فِعل ذلك
Dialogue: 0,1:20:45.30,1:20:46.55,Default,SHINICHI,0,0,0,,.لَيس على الخدّ
Dialogue: 0,1:21:02.17,1:21:04.90,Default,SHINICHI,0,0,0,,.لكن مع ذلك، قلبي
Dialogue: 0,1:21:06.74,1:21:09.15,Default,SHINICHI,0,0,0,,.إستمع لي، لهذه المرّة فقط
Dialogue: 0,1:21:12.40,1:21:14.41,Default,SHINICHI,0,0,0,,لَحظة، أيّها هو هذا؟
Dialogue: 0,1:21:14.75,1:21:17.91,Default,SHINICHI,0,0,0,,أيّ نبض قلبٍ هو هذا؟
Dialogue: 0,1:21:19.99,1:21:22.00,Default,SHINICHI,0,0,0,,!سُحقاً! عرفتُ بأنّه كان هذا
Dialogue: 0,1:21:23.20,1:21:24.00,Default,RAN,0,0,0,,شينتشي؟
Dialogue: 0,1:21:24.78,1:21:29.44,Default,SHINICHI,0,0,0,,.أعتذر، ران. تستدعيني قضيّة
Dialogue: 0,1:21:29.98,1:21:31.69,Default,SHINICHI,0,0,0,,.أراكِ لاحقاً
Dialogue: 0,1:21:31.93,1:21:33.31,Default,RAN,0,0,0,,!شينتشي
Dialogue: 0,1:21:35.98,1:21:39.60,Default,SONOKO,0,0,0,,.بجِدّ؟ جعلكِ تنتظرين قُبلةً حتّى
Dialogue: 0,1:21:39.80,1:21:41.37,Default,RAN,0,0,0,,كنتِ تُشاهدين؟
Dialogue: 0,1:21:41.37,1:21:42.63,Default,SONOKO,0,0,0,,.حسناً، نعم
Dialogue: 0,1:21:42.63,1:21:44.19,Default,SERA,0,0,0,,ماذا قال؟
Dialogue: 0,1:21:44.19,1:21:49.11,Default,RAN,0,0,0,,.هاه؟ قال بأنّ قضيّةً تستدعيه
Dialogue: 0,1:21:50.54,1:21:53.89,Default,RAN,0,0,0,,.لكنّه لَم يبدو بخير
Dialogue: 0,1:21:53.89,1:21:54.36,Default,SERA,0,0,0,,ماذا؟
Dialogue: 0,1:21:57.77,1:21:58.41,Default,RAN,0,0,0,,سيرا تشان؟
Dialogue: 0,1:22:00.10,1:22:03.42,Default,MAN,0,0,0,,ماذا؟ تِلميذٌ في الثّانويّة عانى من وَقتٍ عصيبٍ في السّير؟
Dialogue: 0,1:22:03.68,1:22:07.10,Default,SERA,0,0,0,,.نعم، تِلميذٌ في الثّانويّة بهذا الشّكل
Dialogue: 0,1:22:07.10,1:22:09.80,Default,SERA,0,0,0,,هل مرّ من التودوروكي مون؟
Dialogue: 0,1:22:10.13,1:22:11.62,Default,MAN,0,0,0,,.لَستُ وَاثقاً
Dialogue: 0,1:22:11.62,1:22:14.95,Default,MAN,0,0,0,,.لا أنظُر إلى كلّ تِلميذٍ يمرّ من هُنا
Dialogue: 0,1:22:14.95,1:22:16.45,Default,SERA,0,0,0,,.فهمت
Dialogue: 0,1:22:16.45,1:22:21.22,Default,HEIJI,0,0,0,,.إن كنتِ تبحثين عن كودو، فقد ذهبَ مُسرِعاً من هناك قبل قليل
Dialogue: 0,1:22:21.56,1:22:24.02,Default,HEIJI,0,0,0,,.رُبّما ذهبَ إلى دورة المياه
Dialogue: 0,1:22:24.02,1:22:26.59,Default,SERA,0,0,0,,حقّاً؟ دورة المياه؟
Dialogue: 0,1:22:28.16,1:22:30.77,Default,SERA,0,0,0,,بالمُناسبة، ما أمر حقيبة الظّهر؟
Dialogue: 0,1:22:30.77,1:22:33.23,Default,HEIJI,0,0,0,,لِمَ قد لا أحمل حقيبة ظهر؟
Dialogue: 0,1:22:33.23,1:22:35.02,Default,SERA,0,0,0,,.تبدو ثقيلة
Dialogue: 0,1:22:35.02,1:22:36.62,Default,SERA,0,0,0,,هل يُمكنني تفقّد ما بداخلها؟
Dialogue: 0,1:22:37.12,1:22:39.56,Default,HEIJI,0,0,0,,!أ-أيّتها الغبيّة! لَن أُريكِ
Dialogue: 0,1:22:39.56,1:22:42.66,Default,HEIJI,0,0,0,,!معي داخلها ملابس داخليّةً و أشياءً أُخرى لا يجدُر بكِ رُؤيتها
Dialogue: 0,1:22:42.66,1:22:44.08,Default,SERA,0,0,0,,كمَجلّاتٍ مُنحرفة؟
Dialogue: 0,1:22:44.40,1:22:48.24,Default,HEIJI,0,0,0,,.نعم، القذرة جدّاً
Dialogue: 0,1:22:48.92,1:22:50.25,Default,SERA,0,0,0,,.واو
Dialogue: 0,1:22:50.25,1:22:52.92,Default,SERA,0,0,0,,.هاه؟ يظهر زيّ تيتان خارج حقيبتك
Dialogue: 0,1:22:53.24,1:22:54.01,Default,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,1:22:55.50,1:22:56.93,Default,SERA,0,0,0,,.أمزَح فقط
Dialogue: 0,1:22:59.31,1:23:00.51,Default,HEIJI,0,0,0,,.هاي، كودو
Dialogue: 0,1:23:01.05,1:23:05.41,Default,HEIJI,0,0,0,,هل أنتَ وَاثقٌ من أنّ تلك الفتاة ذات السنّ النّاتئة لا تعرف هويّتكَ الحقيقيّة؟
Dialogue: 0,1:23:05.41,1:23:07.72,Default,CONAN,0,0,0,,.نعم، هذا لَيس جيّداً
Dialogue: 0,1:23:11.26,1:23:11.95,Default,KURAKI,0,0,0,,ماذا؟
Dialogue: 0,1:23:13.72,1:23:14.58,Default,KURAKI,0,0,0,,.أوه
Dialogue: 0,1:23:14.58,1:23:15.41,Default,SERA,0,0,0,,ما الأمر؟
Dialogue: 0,1:23:15.41,1:23:19.17,Default,KURAKI,0,0,0,,.أعتذر، لا شيء. وَداعاً
Dialogue: 0,1:23:23.28,1:23:24.93,Default,KURAKI,0,0,0,,.تفاجأتُ كثيراً
Dialogue: 0,1:23:25.34,1:23:27.97,Default,KURAKI,0,0,0,,.هي فتاةٌ بعد كلّ شيء
Dialogue: 0,1:23:30.65,1:23:35.26,Default,TEACHER,0,0,0,, وَصلَنا خبرٌ للتّوّ من كودو شينتشي كن من الصّفّ 2-بي
Dialogue: 0,1:23:35.26,1:23:40.72,Default,TEACHER,0,0,0,,.بأنّه لا يُمكنه إكمال الرّحلة المدرسيّة بسبب عملٍ طارئ
Dialogue: 0,1:23:40.72,1:23:41.94,Default,ALL,0,0,0,,ماذا؟
Dialogue: 0,1:23:41.94,1:23:47.77,Default,TEACHER,0,0,0,,،يرغب أيضاً بترك مُشاركته بالقضيّة سِرّاً
Dialogue: 0,1:23:47.77,1:23:50.26,Default,TEACHER,0,0,0,,!لذا يطلُب بألّا تذكُروا هذا لوَسائل الإعلام
Dialogue: 0,1:23:50.26,1:23:52.12,Default,ALL,0,0,0,,...حسناً
Dialogue: 0,1:23:52.98,1:23:57.59,Default,STUDENT,0,0,0,,.كنتُ سأسأله عن القضيّة في طريق العودة
Dialogue: 0,1:23:57.59,1:23:59.91,Default,STUDENT,0,0,0,,.أظنّ أنّه يُمكننا سؤال سيرا تشان
Dialogue: 0,1:24:00.13,1:24:03.38,Default,SONOKO,0,0,0,,.لا يُمكنني أن أُصدّق بأنّ ذلك الرّاغب بأن يكون مُتحرّياً قد غادرَ في الوَاقع
Dialogue: 0,1:24:03.38,1:24:05.83,Default,SONOKO,0,0,0,,.لَم يُقبّلكِ أبداً
Dialogue: 0,1:24:05.83,1:24:07.91,Default,RAN,0,0,0,,!لا تقولي ذلك
Dialogue: 0,1:24:08.50,1:24:13.06,Default,RAN,0,0,0,,.أيضاً، عرف شينتشي بأنّني التقيتُ بأوكينا كن
Dialogue: 0,1:24:13.06,1:24:17.92,Default,SONOKO,0,0,0,,.أرسلتُ لشينتشي كن صورةً للِقائكما السرّيّ
Dialogue: 0,1:24:19.85,1:24:23.15,Default,SONOKO,0,0,0,,إذاً، ما الذي كنتُما تتحدّثان عنه؟
Dialogue: 0,1:24:23.15,1:24:26.22,Default,RAN,0,0,0,,.كنّا نتحدّث بعد أن أوصلتُ شيئاً له
Dialogue: 0,1:24:27.18,1:24:30.21,Default,RAN,0,0,0,,.أعطتني المُتحرّية ساتو تعويذة الحظّ هذه
Dialogue: 0,1:24:30.72,1:24:33.64,Default,RAN,0,0,0,,.قالَت بأنّها سقطَت منكَ خلال بُطولة الكيندو
Dialogue: 0,1:24:33.64,1:24:37.69,Default,OKITA,0,0,0,,.كنتُ أبحث عنها. شُكراً
Dialogue: 0,1:24:38.03,1:24:40.06,Default,RAN,0,0,0,,...عـ-على أيّة حال، إذاً
Dialogue: 0,1:24:40.06,1:24:44.24,Default,RAN,0,0,0,,،تركتُ تلك التّعويذة على المَكتب في وكالة التّحرّيات
Dialogue: 0,1:24:44.50,1:24:46.10,Default,RAN,0,0,0,,...و أبي
Dialogue: 0,1:24:46.78,1:24:48.62,Default,KOGORO,0,0,0,,ما تعويذة الحظّ هذه؟
Dialogue: 0,1:24:49.12,1:24:50.53,Default,KOGORO,0,0,0,,هل هي لران؟
Dialogue: 0,1:24:52.00,1:24:53.50,Default,KOGORO,0,0,0,,.هناك شيءٌ داخلها
Dialogue: 0,1:24:54.22,1:24:58.21,Default,KOGORO,0,0,0,,...هي على الأرجح صورةٌ لذلك الطّفل المُتحرّي أو
Dialogue: 0,1:24:58.21,1:24:59.07,Default,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,1:24:59.07,1:25:01.51,Default,RAN,0,0,0,,أبي، ما الذي تنظُر إليه؟
Dialogue: 0,1:25:02.05,1:25:03.43,Default,OKITA,0,0,0,,نظرتِ إلى الصّورة؟
Dialogue: 0,1:25:03.73,1:25:06.41,Default,RAN,0,0,0,,.نعم، لَم أكُن أُفكّر
Dialogue: 0,1:25:06.41,1:25:08.43,Default,RAN,0,0,0,,...على أيّة حال، أمم
Dialogue: 0,1:25:09.17,1:25:14.69,Default,RAN,0,0,0,,هل تلك الفتاة في الصّورة حبيبتك؟
Dialogue: 0,1:25:14.69,1:25:15.44,Default,OKITA,0,0,0,,ماذا؟
Dialogue: 0,1:25:15.68,1:25:18.55,Default,RAN,0,0,0,,،أصابَني الفُضول
Dialogue: 0,1:25:18.55,1:25:21.39,Default,RAN,0,0,0,,.لذا فكّرتُ بالسّؤال عندما رأيتُك
Dialogue: 0,1:25:21.39,1:25:23.96,Default,OKITA,0,0,0,,.كلّا، لَيست حبيبتي
Dialogue: 0,1:25:23.96,1:25:26.20,Default,OKITA,0,0,0,,.لَيس الآن على أيّة حال
Dialogue: 0,1:25:26.54,1:25:29.58,Default,RAN,0,0,0,,تُحبّها إذاً؟
Dialogue: 0,1:25:29.58,1:25:31.34,Default,RAN,0,0,0,,.أظنّكما ستكونان ثُنائيّاً رائعاً
Dialogue: 0,1:25:32.62,1:25:36.28,Default,OKITA,0,0,0,,.إنّها أُخت خصمي
Dialogue: 0,1:25:36.28,1:25:40.59,Default,OKITA,0,0,0,,.لا يُمكنني إخبارها بمَشاعري حتّى أهزِمه
Dialogue: 0,1:25:40.59,1:25:42.02,Default,RAN,0,0,0,,حقّاً؟
Dialogue: 0,1:25:42.02,1:25:45.51,Default,OKITA,0,0,0,,.لا تُخبري ذات الصّدر هناك عن ذلك
Dialogue: 0,1:25:45.51,1:25:46.51,Default,RAN,0,0,0,,الصّدر؟
Dialogue: 0,1:25:46.51,1:25:50.29,Default,OKITA,0,0,0,,.لَن تترُكني و شأني إن اكتشفَت ذلك
Dialogue: 0,1:25:50.78,1:25:53.27,Default,RAN,0,0,0,,.هذا كلّ ما تكلّمنا عنه
Dialogue: 0,1:25:53.45,1:25:54.71,Default,SONOKO,0,0,0,,حقّاً؟
Dialogue: 0,1:25:54.71,1:25:56.80,Default,SONOKO,0,0,0,,إذاً لَم تخونيه مع شبيهه
Dialogue: 0,1:25:56.80,1:25:59.78,Default,SONOKO,0,0,0,,لأنّكِ مُحبطةٌ من زوجكِ الذي لا يُعتمَد عليه؟
Dialogue: 0,1:25:59.78,1:26:01.40,Default,RAN,0,0,0,,.لَيست خيانة
Dialogue: 0,1:26:01.60,1:26:06.14,Default,SONOKO,0,0,0,,.بفضل تلك الصّورة، كِدتّما أن تُقبّلا بعضكما
Dialogue: 0,1:26:06.14,1:26:08.03,Default,SONOKO,0,0,0,,.يجدُر بكِ أن تشعري بالإمتنان
Dialogue: 0,1:26:08.03,1:26:09.32,Default,RAN,0,0,0,,...إسمعي
Dialogue: 0,1:26:09.32,1:26:10.66,Default,NAKAMICHI,0,0,0,,.هاي، موري
Dialogue: 0,1:26:11.52,1:26:14.79,Default,NAKAMICHI,0,0,0,,كـ-كيف شعرتِ عند تـ-تقبيله؟
Dialogue: 0,1:26:15.01,1:26:16.02,Default,RAN,0,0,0,,كيف شعرت؟
Dialogue: 0,1:26:16.02,1:26:19.05,Default,SONOKO,0,0,0,,ألا تسأل الشّخص الخاطئ؟
Dialogue: 0,1:26:19.41,1:26:22.78,Default,RAN,0,0,0,,.قبّلتُه على خدّه فقط
Dialogue: 0,1:26:23.26,1:26:24.85,Default,RAN,0,0,0,,،كانت على الخدّ فقط
Dialogue: 0,1:26:24.85,1:26:28.61,Default,RAN,0,0,0,,.لكنّني قبّلتُه كما لَو أنّني كنتُ على استعدادٍ للقفز عن الكيوميزو بوتاي
Dialogue: 0,1:26:30.29,1:26:31.35,Default,RAN,0,0,0,,...لكنّه
Dialogue: 0,1:26:36.10,1:26:37.73,Default,RAN,0,0,0,,.إنّها من شينتشي
Dialogue: 0,1:26:40.07,1:26:53.96,Title,TEXT,0,0,0,,من: كودو شينتشي\Nالموضوع: لا موضوع
Dialogue: 0,1:26:40.49,1:26:42.25,Default,SHINICHI,0,0,0,,.أعتذر، ران
Dialogue: 0,1:26:42.25,1:26:44.65,Default,SHINICHI,0,0,0,,،أتمنّى لَو أمكنني البقاء معكِ لوَقتٍ أطول بقليل
Dialogue: 0,1:26:44.65,1:26:46.82,Default,SHINICHI,0,0,0,,.لكن لَم يسر الأمر بتلك الطّريقة
Dialogue: 0,1:26:47.51,1:26:51.67,Default,SHINICHI,0,0,0,,.لكنّني سعيدٌ جدّاً لتمكّني من سماع إجابتكِ على اعترافي
Dialogue: 0,1:26:52.11,1:26:53.20,Default,SHINICHI,0,0,0,,.شُكراً
Dialogue: 0,1:26:55.36,1:26:56.50,Default,RAN,0,0,0,,.يا إلهي
Dialogue: 0,1:26:57.15,1:26:59.58,Default,RAN,0,0,0,,.أظنّني سأُسامحه
Dialogue: 0,1:27:00.42,1:27:01.25,Default,SERA,0,0,0,,.نعم
Dialogue: 0,1:27:01.69,1:27:06.97,Default,SERA,0,0,0,,.يبدو بأنّه يُوجد دواءٌ يُمكنه إعادة جسدك، أُمّي
Dialogue: 0,1:27:07.64,1:27:11.15,Default,MARY,0,0,0,,،إذاً سنفعل كلّ ما بمَقدورنا لنجِد مُخترِع هذا الدّواء
Dialogue: 0,1:27:11.60,1:27:13.00,Default,MARY,0,0,0,,.و سنحصل على الدّواء
Dialogue: 0,1:27:13.60,1:27:17.26,Default,MARY,0,0,0,,.حال عودتي إلى جسدي، لَن يكون هناك المزيد من الهرَب
Dialogue: 0,1:27:19.53,1:27:21.15,Default,MARY,0,0,0,,.سنبدأ بهجمتنا المُضادّة
Dialogue: 0,1:27:21.47,1:27:23.41,Default,MARY,0,0,0,,.لا تُفسدي الأمر، ماسومي
Dialogue: 0,1:27:32.99,1:27:35.41,Default,HEIJI,0,0,0,,.لا تلعب بهاتفكَ بينما نقود
Dialogue: 0,1:27:35.41,1:27:36.75,Default,HEIJI,0,0,0,,.هذا خطِر
Dialogue: 0,1:27:36.75,1:27:38.35,Default,CONAN,0,0,0,,.سأنظُر فقط
Dialogue: 0,1:27:38.67,1:27:45.42,Title,TEXT,0,0,0,,من: ران
Dialogue: 0,1:27:38.67,1:27:45.42,Title,TEXT,0,0,0,,الموضوع: شُكراً على الرّسالة
Dialogue: 0,1:27:39.27,1:27:40.79,Default,RAN,0,0,0,,.شُكراً على الرّسالة
Dialogue: 0,1:27:41.28,1:27:45.42,Default,RAN,0,0,0,,هذا يعني بأنّنا نتوَاعد، صحيح؟
Dialogue: 0,1:27:45.80,1:27:48.50,Default,CONAN,0,0,0,,.أوه، يا إلهي. أتمنّى لَو أمكنني الإجابة الآن
Dialogue: 0,1:27:48.50,1:27:50.43,Default,HEIJI,0,0,0,,.على أيّة حال، أنا مَذعورٌ جدّاً
Dialogue: 0,1:27:50.88,1:27:56.43,Default,HEIJI,0,0,0,,.إضطّررتُ لحشركَ في حقيبتي بينما كنتَ تتقلّص أمام عيناي
Dialogue: 0,1:27:56.73,1:27:59.69,Default,HEIJI,0,0,0,,.كان يجدُر بكَ إخباري قبل حصول ذلك
Dialogue: 0,1:28:00.14,1:28:03.25,Default,CONAN,0,0,0,,.لَم يكُن هذا سهلاً عليّ أيضاً
Dialogue: 0,1:28:03.65,1:28:04.69,Default,HEIJI,0,0,0,,هل حصل شيءٌ ما؟
Dialogue: 0,1:28:04.99,1:28:07.45,Default,CONAN,0,0,0,,.إ-إن لَم تكُن تُشاهد، لا تقلَق بشأن هذا
Dialogue: 0,1:28:07.87,1:28:10.21,Default,HEIJI,0,0,0,,.نعم، لَم أرى أيّ شيء
Dialogue: 0,1:28:10.21,1:28:15.70,Default,HEIJI,0,0,0,,.لَم أركَ أنتَ و تلك الفتاة تُقبّلان بعضكما في الكيوميزو بوتاي بالتّأكيد
Dialogue: 0,1:28:15.70,1:28:17.89,Default,CONAN,0,0,0,,!إذاً كنتَ تُشاهد
Dialogue: 0,1:28:17.89,1:28:21.21,Default,CONAN,0,0,0,,{\an8}...إسمع، حصل هذا بعفويّة
Dialogue: 0,1:28:19.47,1:28:20.28,Default,HEIJI,0,0,0,,.سُحقاً
Dialogue: 0,1:28:20.28,1:28:25.25,Default,HEIJI,0,0,0,,.كان الكيوميزو بوتاي التّالي في قائمتي لأماكن الإعتراف بمَشاعري التي تخطِف الأنفاس
Dialogue: 0,1:28:25.92,1:28:27.97,Default,HEIJI,0,0,0,,هل قبّلا بعضهما حتّى؟
Dialogue: 0,1:28:29.74,1:28:30.97,Default,HEIJI,0,0,0,,.سُحقاً
Dialogue: 0,1:28:31.53,1:28:33.68,Default,HEIJI,0,0,0,,.يُصعّب الأُمور بينما لا يحتاج لذلك
Dialogue: 0,1:29:56.83,1:29:59.43,Default,YUKIKO,0,0,0,,.الأمر يشغل الأخبار هُنا أيضاً
Dialogue: 0,1:29:59.74,1:30:01.31,Default,YUSAKU,0,0,0,,.بالتّأكيد
Dialogue: 0,1:30:01.31,1:30:04.81,Default,YUSAKU,0,0,0,,.الضّحايا و القاتِل كانوا مَشهورين
Dialogue: 0,1:30:05.18,1:30:06.68,Default,YUKIKO,0,0,0,,.مُتفاجئةٌ مع ذلك
Dialogue: 0,1:30:06.68,1:30:11.73,Default,YUKIKO,0,0,0,,.كان دافع القاتِل هو انتحار الرّجل الذي أحبّته كيوكو تشان
Dialogue: 0,1:30:11.73,1:30:12.45,Default,YUSAKU,0,0,0,,.نعم
Dialogue: 0,1:30:12.85,1:30:16.95,Default,YUKIKO,0,0,0,,بالمُناسبة، كيف عرفتَ إسم ديكوري ميتشيو كن؟
Dialogue: 0,1:30:17.31,1:30:18.89,Default,YUSAKU,0,0,0,,.من مُلصق الفِلم
Dialogue: 0,1:30:18.89,1:30:19.60,Default,YUKIKO,0,0,0,,ماذا؟
Dialogue: 0,1:30:21.01,1:30:24.51,Default,YUKIKO,0,0,0,,.لَم يكُن إسم ديكوري كن على المُلصق
Dialogue: 0,1:30:27.36,1:30:33.59,Default,YUSAKU,0,0,0,,.ظننتُ أنّه قد يكون هناك سببٌ لتغيير صديقتكِ المُمثّلة لإسمها
Dialogue: 0,1:30:33.59,1:30:39.60,Title,TEXT,0,0,0,,المُخرِج: ماياما مينيتو\Nكاتب النّصّ: نيشيكي تاروبو\Nالمُمثّل: إيهايا شينيا\Nالمُمثّلة المُساعدة: كوراتشي كيكو\Nالموسيقى: أغاتا ريكي
Dialogue: 0,1:30:34.27,1:30:39.60,Default,YUSAKU,0,0,0,,...بتغطية أعلى و أسفل هذه الرّموز التي بينها فراغ
Dialogue: 0,1:30:41.73,1:30:43.10,Default,YUKIKO,0,0,0,,.أوه، أنتَ مُحقّ
Dialogue: 0,1:30:43.10,1:30:47.11,Title,TEXT,0,0,0,,ديكوري ميتشيو
Dialogue: 0,1:30:43.74,1:30:45.95,Default,YUKIKO,0,0,0,,.إنّها ديكوري ميتشيو
Dialogue: 0,1:30:47.72,1:30:51.85,Default,YUSAKU,0,0,0,,،بما أنّ المُلصق قد صُنِعَ بعد العرض الأوّليّ
Dialogue: 0,1:30:51.85,1:30:55.45,Default,YUSAKU,0,0,0,,،من المُمكن أنّ ديكوري كن لَم يكُن لينتحر
Dialogue: 0,1:30:55.45,1:30:59.75,Default,YUSAKU,0,0,0,,.و لَم يكُن أغاتا كن ليقتُل أيّ شخصٍ لَو قاما برُؤيته
Dialogue: 0,1:30:59.75,1:31:00.62,Default,YUKIKO,0,0,0,,.نعم
Dialogue: 0,1:31:01.16,1:31:07.50,Default,YUSAKU,0,0,0,,،المُشكلة هي كيف أنّ شينتشي، الصّبيّ الذي لا يُفترض أن يكون له وُجود
Dialogue: 0,1:31:07.86,1:31:11.00,Default,YUSAKU,0,0,0,,.قد حلّ بطريقةٍ ما هذه القضيّة ذات الإهتمام الإعلاميّ العالَميّ
Dialogue: 0,1:31:11.44,1:31:16.99,Default,YUSAKU,0,0,0,,.يُعلنون فقط بأنّ القضيّة قد حلّها مَجموعةٌ من مُتحرّي المدرسة الثّانويّة مع ذلك
Dialogue: 0,1:31:16.99,1:31:18.74,Default,YUKIKO,0,0,0,,.سيكون الأمر بخير
Dialogue: 0,1:31:18.74,1:31:21.01,Default,YUKIKO,0,0,0,,.شين تشان دقيقٌ جدّاً عندما يتعلّق الأمر بذلك
Dialogue: 0,1:31:21.21,1:31:23.18,Default,YUKIKO,0,0,0,,.وَاثقةٌ من أنّه قد طلَب منهم إبقاء الأمر سرّاً
Dialogue: 0,1:31:24.77,1:31:27.77,Title,SIGN,0,0,0,,وكالة موري للتّحرّيات
Dialogue: 0,1:31:28.28,1:31:29.70,Default,RAN,0,0,0,,!لَقد عُدتّ
Dialogue: 0,1:31:30.19,1:31:31.07,Default,RAN,0,0,0,,...هذا رائع
Dialogue: 0,1:31:33.39,1:31:36.58,Default,RAN,0,0,0,,.عادَت ابنتكَ من رحلتها المدرسيّة
Dialogue: 0,1:31:36.58,1:31:38.45,Default,RAN,0,0,0,,.يُفترض أن تُرحّب بها في المنزل
Dialogue: 0,1:31:40.28,1:31:42.00,Default,RAN,0,0,0,,هل كونان كن بالأعلى؟
Dialogue: 0,1:31:45.54,1:31:50.25,Title,TEXT,0,0,0,,لا رسائل جديدة
Dialogue: 0,1:31:45.85,1:31:47.47,Default,RAN,0,0,0,,.لَم يُجب بعد
Dialogue: 0,1:31:48.08,1:31:51.68,Default,RAN,0,0,0,,هل قرأ شينتشي رسالتي؟
Dialogue: 0,1:31:53.00,1:31:55.51,Title,TEXT,0,0,0,,هذا يعني بأنّنا نتوَاعد، صحيح؟\Nران
Dialogue: 0,1:31:56.11,1:31:58.38,Default,HEIJI,0,0,0,,هل تسمعني، كودو؟
Dialogue: 0,1:31:58.79,1:32:01.39,Default,HEIJI,0,0,0,,.عندما نصل طوكيو، ستشتري لي ستيك
Dialogue: 0,1:32:01.83,1:32:02.56,Default,CONAN,0,0,0,,.نعم
Dialogue: 0,1:32:02.56,1:32:04.25,Default,HEIJI,0,0,0,,.لَيست الرّخيصة أيضاً
Dialogue: 0,1:32:04.25,1:32:08.37,Default,HEIJI,0,0,0,,...وَاحدةٌ مليئةٌ بالعُصارة كما تعلَم
Dialogue: 0,1:32:10.31,1:32:11.90,Default,HEIJI,0,0,0,,.من النّخب الأوّل
Dialogue: 0,1:32:12.19,1:32:13.57,Default,CONAN,0,0,0,,.أعلَم
Dialogue: 0,1:32:13.57,1:32:15.65,Default,CONAN,0,0,0,,.سأعزمك. لا تقلَق بشأن ذلك
Dialogue: 0,1:32:17.61,1:32:20.89,Default,HEIJI,0,0,0,,.لَم يكُن يجدُر بي أن أعرض عليكَ إعادتكَ إلى طوكيو
Dialogue: 0,1:32:20.07,1:32:21.03,Title,TEXT,0,0,0,,إرسال    عرض
Dialogue: 0,1:32:21.03,1:32:21.41,Title,TEXT,0,0,0,,إرسال
Dialogue: 0,1:32:28.00,1:32:29.04,Default,RAN,0,0,0,,.رسالة
Dialogue: 0,1:32:30.75,1:32:31.92,Default,RAN,0,0,0,,من شينتشي؟
Dialogue: 0,1:32:38.17,1:32:40.43,Title,TEXT,0,0,0,,من: كودو شينتشي\N.الموضوع: أيّتها الغبيّة، بالتّأكيد نتوَاعد\Nشينتشي
Dialogue: 0,1:32:55.01,1:32:58.68,Default,RAN,0,0,0,,هذا يعني بأنّنا نتوَاعد، صحيح؟
Dialogue: 0,1:32:58.68,1:33:02.60,Default,SHINICHI,0,0,0,,.نحن نتوَاعد بالتّأكيد
Dialogue: 0,1:33:02.60,1:33:04.60,Default,,0,0,0,,
Dialogue: 0,0:44:29.63,0:44:31.58,Default,SHINICHI,0,0,0,,.لَم تكُن هذه العلامات هُنا
