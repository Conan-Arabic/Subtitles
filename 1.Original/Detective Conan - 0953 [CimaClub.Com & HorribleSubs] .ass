Dialogue: 0,0:00:01.41,0:00:05.99,Default,,0,0,0,,ترجمة :عبدالله جوده\N3abdellahgooda
Dialogue: 0,0:00:05.99,0:00:09.43,Default,,0,0,0,,لمقابلة عميل تلقى خطاب تهديد فى ملهى للفتيات
Dialogue: 0,0:00:09.43,0:00:12.98,Default,,0,0,0,,رجل غنى
Dialogue: 0,0:00:14.87,0:00:18.20,Default,,0,0,0,,العميل كان رجلا ثريا يدعى (موروكا.جونزو سان)
Dialogue: 0,0:00:15.03,0:00:17.37,Default,,0,0,0,,رجل غنى
Dialogue: 0,0:00:18.57,0:00:21.08,Default,,0,0,0,,احضر معه كبير خدمه \Nفوكماتشى
Dialogue: 0,0:00:18.74,0:00:21.08,Default,,0,0,0,,رجل مسن
Dialogue: 0,0:00:21.73,0:00:23.49,Default,,0,0,0,,قال المجرم فى خطابه
Dialogue: 0,0:00:23.49,0:00:28.30,Default,,0,0,0,,"اذا كنت تريد ان تعيش ..ابقى بعيدا عن مطعم الارنب الاسود"
Dialogue: 0,0:00:29.24,0:00:33.20,Default,,0,0,0,,حسنا؟هل ترى اى مشتبه بهم ؟
Dialogue: 0,0:00:33.63,0:00:35.54,Default,,0,0,0,,لا ليس على وجه التحديد
Dialogue: 0,0:00:35.54,0:00:38.03,Default,,0,0,0,,ماذا عن "امورو_كون"؟
Dialogue: 0,0:00:38.03,0:00:41.13,Default,,0,0,0,,لا اعرف \Nلا يبدو عليه انه يستطيع القتل
Dialogue: 0,0:00:44.02,0:00:46.40,Default,,0,0,0,,اساكورا يورى .."موظفه"
Dialogue: 0,0:00:52.71,0:00:53.79,Default,,0,0,0,,ماذا؟؟
Dialogue: 0,0:01:02.78,0:01:06.74,Default,,0,0,0,,هل وجدت زرنيخ فى مشروب يورى سان؟
Dialogue: 0,0:01:06.74,0:01:07.54,Default,,0,0,0,,نعم .
Dialogue: 0,0:01:07.54,0:01:09.12,Default,,0,0,0,,كنت انا المقصود
Dialogue: 0,0:01:09.69,0:01:13.46,Default,,0,0,0,,احدهم حاول ان يقتلنى بالسم
Dialogue: 0,0:01:13.46,0:01:16.21,Default,,0,0,0,,ولكن يورى سان شربته بدلا منى
Dialogue: 0,0:01:17.56,0:01:19.06,Default,,0,0,0,,حسنا ..فهمت
Dialogue: 0,0:01:19.84,0:01:22.65,Default,,0,0,0,,اذا انت تلقيت هذا الخطاب
Dialogue: 0,0:01:22.65,0:01:27.16,Default,,0,0,0,,نعم ...و لكن يورى \Nسان شربت مشروبى
Dialogue: 0,0:01:27.16,0:01:33.89,Default,,0,0,0,,ولكن كوبك  كان  مختلف الشكل تماما
Dialogue: 0,0:01:33.89,0:01:35.29,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:01:35.29,0:01:38.63,Default,,0,0,0,,كانت كوب يورى تشان نحيفه
Dialogue: 0,0:01:38.63,0:01:41.42,Default,,0,0,0,,و كوبك  كانت كرويه ثمينه
Dialogue: 0,0:01:41.42,0:01:43.78,Default,,0,0,0,,لا اظن انهم قد يختلطو
Dialogue: 0,0:01:44.09,0:01:47.96,Default,,0,0,0,,اذا يورى سان كان\Nضحية الجانى المقصوده
Dialogue: 0,0:01:49.26,0:01:53.87,Default,,0,0,0,,كان يمكن أن يكون فقط\Nتسمم من قبل موروكا سان ،
Dialogue: 0,0:01:53.87,0:01:57.71,Default,,0,0,0,,من التى مرت بجوار يورى سان\Nو هى تحمل كوبها  قبل ان تغادر الطاوله
Dialogue: 0,0:01:58.02,0:02:03.42,Default,,0,0,0,,او فوكا ماشى سان كان يجلس بجوارها و هى تضع كوبها
Dialogue: 0,0:02:03.42,0:02:06.75,Default,,0,0,0,,على الطاوله بينما كانت\Nمندهشه من  الانذار
Dialogue: 0,0:02:07.61,0:02:12.02,Default,,0,0,0,,او مورا كامى _سان الذى سكب النبيذ الاحمر غلى أسورتها الابيض
Dialogue: 0,0:02:12.02,0:02:17.37,Default,,0,0,0,,و صنع لها سببا لكى تغادر الطاوله
Dialogue: 0,0:02:18.51,0:02:21.27,Default,,0,0,0,,كما استطيع التذكر :
Dialogue: 0,0:02:21.27,0:02:26.99,Default,,0,0,0,,فقط هؤلاء الثلاثه هم من يستطيعوا تسميم كوب يورى _سان
Dialogue: 0,0:02:27.88,0:02:30.25,Default,,0,0,0,,الان ..فى هذه اللحظه ضوء يخترق الظلام
Dialogue: 0,0:02:30.25,0:02:32.09,Default,,0,0,0,,تتعدى  كل الحدود بمهارات  تفكيرك
Dialogue: 0,0:02:32.09,0:02:33.71,Default,,0,0,0,,بينما يحدد كيف تم تسميم الكوب
Dialogue: 0,0:02:33.71,0:02:35.71,Default,,0,0,0,,ذكرى غريبه تظهر فى راس امورو
Dialogue: 0,0:02:35.71,0:02:37.29,Default,,0,0,0,,دوما يتم تحديد الحقيقه
Dialogue: 0,0:02:37.29,0:02:39.04,Default,,0,0,0,,بواسطة جسد طفل و  عقل ررجل بالغ
Dialogue: 0,0:02:39.04,0:02:41.46,Default,,0,0,0,,و اسمه هو (المحقق كونان)
Dialogue: 0,0:04:22.99,0:04:28.99,Default,,0,0,0,,قضية المشروب  المسمم \N(الجزء الثانى)
Dialogue: 0,0:04:23.89,0:04:26.60,Default,,0,0,0,,"The Unsolved Cocktail Case, Part Two!"
Dialogue: 0,0:04:30.95,0:04:34.39,Default,,0,0,0,,هل ذهبت الى سيارتك لتحضر نظارته؟
Dialogue: 0,0:04:34.39,0:04:38.37,Default,,0,0,0,,انت !..سيد كبير خدمك ..فوكا ماتشى _سان
Dialogue: 0,0:04:38.37,0:04:42.03,Default,,0,0,0,,نعم ..انا الذى خطوت عليها دون قصد
Dialogue: 0,0:04:42.03,0:04:45.14,Default,,0,0,0,,و كسرت نظارته التى وقعت تحت الطاوله
Dialogue: 0,0:04:47.71,0:04:48.79,Default,,0,0,0,,نظارته؟!
Dialogue: 0,0:04:49.22,0:04:53.20,Default,,0,0,0,,كانت سلطة العجه بجوار فوكا ماتشى _سان
Dialogue: 0,0:04:54.28,0:04:56.06,Default,,0,0,0,,هذه العجه تبدو شهيه
Dialogue: 0,0:04:56.42,0:04:58.56,Default,,0,0,0,,دعنا ناكل
Dialogue: 0,0:04:58.87,0:05:00.14,Default,,0,0,0,,دعنا نرى
Dialogue: 0,0:05:00.78,0:05:04.63,Default,,0,0,0,,فوكا ماتشى _كون ..ناولنى سلطة العجه من فضلك
Dialogue: 0,0:05:04.63,0:05:06.06,Default,,0,0,0,,هااه؟\Nماذا؟
Dialogue: 0,0:05:06.40,0:05:07.70,Default,,0,0,0,,حسنا ..
Dialogue: 0,0:05:08.11,0:05:13.14,Default,,0,0,0,,ولكن عندما حاولت الوصول اليها ...كسرت النظاره؟؟اليس كذلك؟
Dialogue: 0,0:05:13.14,0:05:14.03,Default,,0,0,0,,اجل.
Dialogue: 0,0:05:14.03,0:05:17.53,Default,,0,0,0,,ولكن لماذا كانت نظارتك تحت الطاوله؟
Dialogue: 0,0:05:17.80,0:05:22.72,Default,,0,0,0,,انا اتذكر اننى مسحت العدسات و وضعتها على الطاوله
Dialogue: 0,0:05:23.21,0:05:27.84,Default,,0,0,0,,لا استطيع التركيز فى الاماكن المزدحمه
Dialogue: 0,0:05:28.20,0:05:32.68,Default,,0,0,0,,رربما اصطدمت بها بكوعى و  سقطت تحت الطاوله
Dialogue: 0,0:05:32.68,0:05:38.09,Default,,0,0,0,,قلت انه من الخطر عليه ان يحضر نظارته الاحتياطيه لان نظره ضعيف جدا
Dialogue: 0,0:05:38.49,0:05:41.12,Default,,0,0,0,,سوف احضرها لك.
Dialogue: 0,0:05:41.12,0:05:46.48,Default,,0,0,0,,شكرا لك ..انها فى علبة القفازات
Dialogue: 0,0:05:46.75,0:05:49.50,Default,,0,0,0,,فهمت ..اذا لهذا لسبب
Dialogue: 0,0:05:49.50,0:05:53.86,Default,,0,0,0,,لديك اذواق غريبه ...و ايضا سلطة العجه!
Dialogue: 0,0:05:54.14,0:05:56.26,Default,,0,0,0,,ماذا ؟؟انها رائغه
Dialogue: 0,0:05:56.26,0:06:00.74,Default,,0,0,0,,أتذكر أن  يورى سان  وضعت الصلصه على العجه الخاصه بها ايضا!
Dialogue: 0,0:06:00.74,0:06:04.62,Default,,0,0,0,,قالت انها اخذت هذه العاده من شخص  اخر..اترى؟
Dialogue: 0,0:06:04.63,0:06:06.63,Default,,0,0,0,,الصلصه
Dialogue: 0,0:06:06.83,0:06:09.62,Default,,0,0,0,,هههههه...الاخرون يحبونها ايضا
Dialogue: 0,0:06:09.93,0:06:14.72,Default,,0,0,0,,على اى حال ..ليس لدى سبب واحد كى اسممها
Dialogue: 0,0:06:14.72,0:06:17.72,Default,,0,0,0,,لقد كانت المفضله لدى
Dialogue: 0,0:06:17.72,0:06:23.85,Default,,0,0,0,,هذا ما تقوله انت\Nولكن يمكن انها كانت تضغط عليك لتتزوجها
Dialogue: 0,0:06:24.11,0:06:25.14,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:06:25.39,0:06:27.86,Default,,0,0,0,,ربما انها تحب الصلصه
Dialogue: 0,0:06:27.86,0:06:30.97,Default,,0,0,0,,لأنها أخذت هذه العاده منك أنت .....عشيقها
Dialogue: 0,0:06:30.97,0:06:32.46,Default,,0,0,0,,انا ....
Dialogue: 0,0:06:32.79,0:06:35.83,Default,,0,0,0,,انت زورت خطاب التهديد لنفسك ايضا!
Dialogue: 0,0:06:35.83,0:06:42.59,Default,,0,0,0,,كانت هذه خطتك لتجعلنا نصدق انها سممت بدلا  منك
Dialogue: 0,0:06:42.93,0:06:46.37,Default,,0,0,0,,و تقتلها قبل ان تكتشف زوجتك امرها
Dialogue: 0,0:06:46.37,0:06:47.98,Default,,0,0,0,,لا يمكن ان تكون جادا
Dialogue: 0,0:06:48.29,0:06:51.71,Default,,0,0,0,,كم تظن الفارق بيننا فى العمر ؟1
Dialogue: 0,0:06:51.71,0:06:56.19,Default,,0,0,0,,الى جانب ان زوجتى توفيت منذ 6 اشهر ...كانت مريضه
Dialogue: 0,0:06:56.19,0:06:57.11,Default,,0,0,0,,ماذا؟؟!!
Dialogue: 0,0:07:00.98,0:07:05.56,Default,,0,0,0,,انا ارى.انت بالصدفه ضغطت على منبه الهاتف
Dialogue: 0,0:07:05.56,0:07:09.23,Default,,0,0,0,,كل من فى المطعم بما فيهم الضحيه
Dialogue: 0,0:07:09.23,0:07:11.15,Default,,0,0,0,,ظنو انه انذار زلزال
Dialogue: 0,0:07:11.15,0:07:14.13,Default,,0,0,0,,و بالتالى وضعو اكوابهم على الطاوله ليتاكدو من هواتفهم
Dialogue: 0,0:07:14.13,0:07:15.32,Default,,0,0,0,,امم ..نعم
Dialogue: 0,0:07:15.32,0:07:21.34,Default,,0,0,0,,كنت اتفقد رسائلى بينما كان سيدى يحضر نظارتى
Dialogue: 0,0:07:23.09,0:07:24.03,Default,,0,0,0,,مستحيل.
Dialogue: 0,0:07:24.03,0:07:25.50,Default,,0,0,0,,زلزاال؟!
Dialogue: 0,0:07:28.00,0:07:29.91,Default,,0,0,0,,انا  اسف
Dialogue: 0,0:07:29.91,0:07:34.40,Default,,0,0,0,,لقد رن فجاه و انا اتفقد رسائلى
Dialogue: 0,0:07:34.40,0:07:35.25,Default,,0,0,0,,دعنى ارى  ذلك
Dialogue: 0,0:07:37.13,0:07:41.64,Default,,0,0,0,,مما يعنى انك لم تكن ترتدى نظارتك وقتها
Dialogue: 0,0:07:41.64,0:07:45.14,Default,,0,0,0,,لا ..لذلك لم ارى بوضوح
Dialogue: 0,0:07:45.41,0:07:50.57,Default,,0,0,0,,لم أعرف من وضع كوبه ...او اين وضعه
Dialogue: 0,0:07:50.57,0:07:53.04,Default,,0,0,0,,بجانب انهم جميعا كانو يرتدون ملابس متشابهه
Dialogue: 0,0:07:53.04,0:07:58.53,Default,,0,0,0,,هذا ما تقوله انت ..و لكن من االممكن  انك اجريت عمليه لتحسين نظرك
Dialogue: 0,0:07:58.53,0:08:02.90,Default,,0,0,0,,اذا كنت تظن ذلك ...حاول ان ترتدى نظارتى
Dialogue: 0,0:08:04.87,0:08:06.17,Default,,0,0,0,,هذا صعب للغايه!!
Dialogue: 0,0:08:07.43,0:08:10.92,Default,,0,0,0,,فى الحقبقه انا مندهش انك تستطيع رؤية اى شىء و انت ترتديها
Dialogue: 0,0:08:10.92,0:08:14.19,Default,,0,0,0,,أنا لا استخدم ابدا العدسات اللاصقه
Dialogue: 0,0:08:14.59,0:08:21.50,Default,,0,0,0,,حتى وان فعلت ..هذه النظاره  تكون معى اومع احد ما حولى
Dialogue: 0,0:08:21.50,0:08:24.81,Default,,0,0,0,,تستطيع ان تسأل عن ذلك
Dialogue: 0,0:08:24.81,0:08:29.21,Default,,0,0,0,,فى المقام الاول ..انا مثل سيدى ليس لدى دافع
Dialogue: 0,0:08:29.21,0:08:32.19,Default,,0,0,0,,نحن ناتى هنا فقط اثناء انتظارنا
Dialogue: 0,0:08:32.92,0:08:34.32,Default,,0,0,0,,اثناء انتظاركم؟!!
Dialogue: 0,0:08:34.77,0:08:40.33,Default,,0,0,0,,سيدى ييتعامل مع  متجر ملابس بجوار هذا
Dialogue: 0,0:08:40.58,0:08:46.57,Default,,0,0,0,,نحن ناتى هنا فقط لننتظر حتى يتم تصميم البدل التى اشتراها
Dialogue: 0,0:08:46.57,0:08:49.40,Default,,0,0,0,,اليس هذا صحيحا.سيدى؟
Dialogue: 0,0:08:49.40,0:08:50.84,Default,,0,0,0,,اجل
Dialogue: 0,0:08:51.82,0:08:57.71,Default,,0,0,0,,اخبرتك ..انا فقط اصطدمت بها و سكبت عليها بعض النبيذ
Dialogue: 0,0:08:57.89,0:09:01.31,Default,,0,0,0,,مورا كامى _سانا ...موظفه
Dialogue: 0,0:08:58.09,0:09:00.31,Default,,0,0,0,,انا لست جاسوسا خارق
Dialogue: 0,0:09:00.31,0:09:04.22,Default,,0,0,0,,لا استطيع تسميم  كوب "يورى:فى هذا الجزء من الثانيه
Dialogue: 0,0:09:05.94,0:09:08.02,Default,,0,0,0,,اووه...انا اسفه
Dialogue: 0,0:09:08.32,0:09:10.58,Default,,0,0,0,,فى هذه الحاله ..و لا انا استطيع ايضا
Dialogue: 0,0:09:10.58,0:09:14.03,Default,,0,0,0,,لا استطيع تسميم كوبها وانا امر فقط بجانبها
Dialogue: 0,0:09:14.03,0:09:19.40,Default,,0,0,0,,حسنا ..لم نكن هناك عندما حدث الامر..لا نستطيع اأن نحكم الان فى هذا الامر
Dialogue: 0,0:09:19.65,0:09:23.82,Default,,0,0,0,,بجانب ..ما الذى استفيده من تسميم يورى
Dialogue: 0,0:09:23.82,0:09:25.44,Default,,0,0,0,,اذا كانت هناك فائدة لى اخبرنى
Dialogue: 0,0:09:25.44,0:09:26.63,Default,,0,0,0,,حسنا....
Dialogue: 0,0:09:26.63,0:09:29.53,Default,,0,0,0,,لم تريدىها انت تاخذ منك المركز الاول
Dialogue: 0,0:09:29.53,0:09:30.29,Default,,0,0,0,,ماذا؟!
Dialogue: 0,0:09:30.29,0:09:32.98,Default,,0,0,0,,الفتيات الاخريات اخبرونى
Dialogue: 0,0:09:32.98,0:09:37.29,Default,,0,0,0,,انه كل ستة اشهر يتم اختيار الفتاه الاعلى ربحا
Dialogue: 0,0:09:37.29,0:09:42.31,Default,,0,0,0,,و تنال مكافاه كبيره
Dialogue: 0,0:09:42.60,0:09:46.31,Default,,0,0,0,,و انتى  كنت رقم واحد فى اخر سنتين
Dialogue: 0,0:09:46.31,0:09:50.18,Default,,0,0,0,,و لكنك كنت قلقه مؤخرا لان يورى كانت تلحق بك
Dialogue: 0,0:09:50.46,0:09:54.76,Default,,0,0,0,,ربما انتى بالفعل اشتريتى شيئا باهظ الثمن
Dialogue: 0,0:09:54.76,0:09:58.73,Default,,0,0,0,,على امل انك ستنالى المكافاه ..لذلك شعرتى انه يجب عليكى قتلها
Dialogue: 0,0:09:58.73,0:09:59.69,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:59.98,0:10:05.73,Default,,0,0,0,,فى هذه الحاله ..اخبرنى ى ما هو الشىء الثمين الذى اشتريته؟
Dialogue: 0,0:10:06.80,0:10:10.74,Default,,0,0,0,,كونان ...اتعرف من فعلها؟
Dialogue: 0,0:10:10.74,0:10:14.38,Default,,0,0,0,,انتظر..ماذا؟\Nلقد كان هنا منذ لحظات
Dialogue: 0,0:10:14.65,0:10:19.25,Default,,0,0,0,,هذا الفتى سال للتو عن باحة السيارات..ثم ذهب للخارج
Dialogue: 0,0:10:19.56,0:10:22.02,Default,,0,0,0,,مع هذا الرجل الاسمر الوسيم
Dialogue: 0,0:10:22.02,0:10:23.73,Default,,0,0,0,,مع امورو_سان؟
Dialogue: 0,0:10:24.26,0:10:30.51,Default,,0,0,0,,نعم ..الرئيس جاء  لياخذ نظارة كبير الخدم
Dialogue: 0,0:10:30.51,0:10:33.77,Default,,0,0,0,, لقد كان المحقق مورى كوجورا _سان
Dialogue: 0,0:10:34.08,0:10:38.75,Default,,0,0,0,,هل لاحظت اى شىء غريب وقتها؟
Dialogue: 0,0:10:38.75,0:10:40.36,Default,,0,0,0,,مثل ماذا؟
Dialogue: 0,0:10:40.36,0:10:45.00,Default,,0,0,0,,مثل انهم كانو يراقبون المطعم ..او يتفقدو ساعاتهم
Dialogue: 0,0:10:45.34,0:10:47.49,Default,,0,0,0,,ليس تحديدا
Dialogue: 0,0:10:49.46,0:10:53.76,Default,,0,0,0,,بمناسبة الاشياء الغريبه ...وزن الرئيس كان متغيرا ..اليس كذلك؟
Dialogue: 0,0:10:53.76,0:10:57.80,Default,,0,0,0,,نعم ...لقد فقد فجاة بعضا من وزنه ...ثم استعاده ثانية
Dialogue: 0,0:10:58.08,0:11:00.32,Default,,0,0,0,,ربما هناك شيئا ما يضايقه
Dialogue: 0,0:11:00.32,0:11:02.98,Default,,0,0,0,,كما انه اصبح يصاب كثيرا مؤخرا ايضا
Dialogue: 0,0:11:02.98,0:11:06.51,Default,,0,0,0,,نعم ..قال انه تعثر و هو يمشى
Dialogue: 0,0:11:06.51,0:11:07.42,Default,,0,0,0,,اصابه؟؟؟
Dialogue: 0,0:11:07.82,0:11:11.68,Default,,0,0,0,,المره القادمه التى تصاب فيها ...لن  استطيع معالجتك
Dialogue: 0,0:11:12.66,0:11:15.12,Default,,0,0,0,,انا ساذهب بعيدا ..بعيدا جدا
Dialogue: 0,0:11:15.12,0:11:16.70,Default,,0,0,0,,هذا هو الوداع
Dialogue: 0,0:11:17.05,0:11:18.24,Default,,0,0,0,,رى _كون
Dialogue: 0,0:11:18.68,0:11:21.06,Default,,0,0,0,,امورو _سان...امورو_سان
Dialogue: 0,0:11:21.06,0:11:22.33,Default,,0,0,0,,امورو سان!!
Dialogue: 0,0:11:24.66,0:11:27.32,Default,,0,0,0,,ما الامر؟؟\Nلقد كنت شاردا
Dialogue: 0,0:11:27.32,0:11:30.19,Default,,0,0,0,,لا شىء
Dialogue: 0,0:11:33.41,0:11:36.97,Default,,0,0,0,,لماذا افكر بها الان؟؟!!
Dialogue: 0,0:11:47.47,0:11:50.22,Default,,0,0,0,,طبقا  لشهادة امورو _كون
Dialogue: 0,0:11:50.64,0:11:54.24,Default,,0,0,0,,فان كوب الضحيه يورى سان يمكن ان يسمم فقط بواسطة
Dialogue: 0,0:11:54.54,0:12:00.43,Default,,0,0,0,,موروكا جونزو_سان الذى حطم نظارة كبير خدمه
Dialogue: 0,0:12:00.43,0:12:03.92,Default,,0,0,0,,وغادر  مقعده لكى يحضر النظارت الاحتياطيه من السياره ..و مر بجانب يورى سان
Dialogue: 0,0:12:03.92,0:12:06.15,Default,,0,0,0,,بينما كانت تمسك كوبها
Dialogue: 0,0:12:06.50,0:12:09.91,Default,,0,0,0,,فوكا ماتشى _سان  الذى قام ببتشغيل انذار هاتفه بالخطاء
Dialogue: 0,0:12:09.91,0:12:16.34,Default,,0,0,0,,و كان يجلس بجوار كوب يورى سان الذى وضعته على الطاوله
Dialogue: 0,0:12:16.34,0:12:20.78,Default,,0,0,0,,لكى تتفقد تقرير الزلازل على هاتفها
Dialogue: 0,0:12:21.67,0:12:25.81,Default,,0,0,0,,او مورا كامى _سان التى سكبت  نبيذا  احمر
Dialogue: 0,0:12:25.81,0:12:30.16,Default,,0,0,0,,على يورى _سان و جعلتها  تترك كوبها
Dialogue: 0,0:12:30.16,0:12:32.32,Default,,0,0,0,,لكى تنظف ملابسها
Dialogue: 0,0:12:32.32,0:12:35.97,Default,,0,0,0,,ولكن  كل ذلك يستغرق لحظات لكى يمر موروكا سان بجوارها
Dialogue: 0,0:12:35.97,0:12:39.67,Default,,0,0,0,,و لحظات ايضا لكى تسكب مورا كامى _سان النبيذ عليها
Dialogue: 0,0:12:39.67,0:12:42.83,Default,,0,0,0,,لم يكن لديهم وقت لتسميم كوبها
Dialogue: 0,0:12:42.83,0:12:47.50,Default,,0,0,0,,و فوكا ماتشى _سان لم يكن يرتدى نظارته عندمل قام بتشغيل الانذار
Dialogue: 0,0:12:47.50,0:12:51.95,Default,,0,0,0,,قال انه  لم يستطع ان يرى من وضع الكوب او اين
Dialogue: 0,0:12:53.32,0:12:57.57,Default,,0,0,0,,حسنا ..هكذا سنضطر لانتظار يورى سان لتستعيد وعيها
Dialogue: 0,0:12:57.57,0:12:58.32,Default,,0,0,0,,ايها المفتش ماجوير
Dialogue: 0,0:12:59.31,0:13:00.36,Default,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:13:00.36,0:13:03.21,Default,,0,0,0,,على ما يبدو ان طاقم العمل يريد ان يتحدث اليك
Dialogue: 0,0:13:03.55,0:13:06.30,Default,,0,0,0,,لقد تذكروا شيئا
Dialogue: 0,0:13:09.84,0:13:14.48,Default,,0,0,0,,ماذا؟كبير الخدم جاء الى هذا المتجر بمفرده
Dialogue: 0,0:13:19.59,0:13:21.48,Default,,0,0,0,,هل اتى ليرى يورى _سان
Dialogue: 0,0:13:21.48,0:13:26.43,Default,,0,0,0,,نعم .فى البدايه ظننا انه جاء ليطلب حجزا
Dialogue: 0,0:13:26.43,0:13:29.07,Default,,0,0,0,,قال انه اراد التحدث الى يورى سان ..ثم اتجهو عائدين الى الخارج سويا
Dialogue: 0,0:13:29.07,0:13:29.36,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:29.64,0:13:33.62,Default,,0,0,0,,فى البدايه كانت يورى سان تبتسم و هى تتحدث اليه
Dialogue: 0,0:13:34.57,0:13:39.82,Default,,0,0,0,,و لكن  عندما قدم كبير الخدم مظروف اصبحت الامور حرجه
Dialogue: 0,0:13:40.64,0:13:41.73,Default,,0,0,0,,مظروف؟!!
Dialogue: 0,0:13:41.73,0:13:43.79,Default,,0,0,0,,هل تعرف ما الذى كان فيه؟
Dialogue: 0,0:13:43.79,0:13:45.79,Default,,0,0,0,,لا اعرف
Dialogue: 0,0:13:46.68,0:13:49.18,Default,,0,0,0,,كان يدفع لها  لتقطع علاقتها به
Dialogue: 0,0:13:50.24,0:13:53.06,Default,,0,0,0,,كان يريد ان يتخلص منها
Dialogue: 0,0:13:53.40,0:13:59.33,Default,,0,0,0,,و قالت ..انها لن تأخذ النقود\Nو رفضت عرضه
Dialogue: 0,0:13:59.69,0:14:05.06,Default,,0,0,0,,هل هذا يعنى انها كانت عشيقة موروكا سان ..و كانت تضغط عليه ليتروجها
Dialogue: 0,0:14:05.34,0:14:10.06,Default,,0,0,0,,و لكن لماذا ياتى هنا ليشرب بينما هى جالسه هنا؟؟
Dialogue: 0,0:14:10.54,0:14:12.96,Default,,0,0,0,,ثم ربما انه كان العكس,
Dialogue: 0,0:14:12.96,0:14:18.83,Default,,0,0,0,,انه جاء هنا ليطلب منها ان تكون عشيقة سيده الوحيده مقابل المال
Dialogue: 0,0:14:18.83,0:14:21.83,Default,,0,0,0,,لذلك انتقم منها و قام بتسميمها
Dialogue: 0,0:14:21.83,0:14:24.17,Default,,0,0,0,,هذا لا يبدو من المرجح—
Dialogue: 0,0:14:25.56,0:14:29.32,Default,,0,0,0,,ابقى بعيدا عن حديث البالغين ى فتى
Dialogue: 0,0:14:29.32,0:14:30.79,Default,,0,0,0,,ابى
Dialogue: 0,0:14:30.79,0:14:35.55,Default,,0,0,0,,اذا ..متى بدا موروكا سان بالمجىء الى المتجر
Dialogue: 0,0:14:35.55,0:14:38.94,Default,,0,0,0,,منذ حوالى ستة اشهر
Dialogue: 0,0:14:39.32,0:14:42.24,Default,,0,0,0,,هذا بالضبط التوقيت  الذى توفت فيه زوجته وقتها
Dialogue: 0,0:14:42.24,0:14:43.28,Default,,0,0,0,,اجل
Dialogue: 0,0:14:44.43,0:14:48.57,Default,,0,0,0,,ولكنه لا يبدو من النوع الذى يكون لديه عشيقه
Dialogue: 0,0:14:48.57,0:14:51.94,Default,,0,0,0,,لا ..لقد كان رجل يحب النساء
Dialogue: 0,0:14:54.45,0:14:58.94,Default,,0,0,0,,على الارجح انه عبث كثيرا و هو شابا
Dialogue: 0,0:14:58.94,0:15:04.08,Default,,0,0,0,,اتذكر انه قال انه كان شابا مفتعل للمشاكل
Dialogue: 0,0:15:04.08,0:15:05.74,Default,,0,0,0,,عرفت ذلك!
Dialogue: 0,0:15:05.74,0:15:07.92,Default,,0,0,0,,مفتعل للمشاكل؟؟
Dialogue: 0,0:15:07.92,0:15:09.93,Default,,0,0,0,,كانت هناك  فتاه اعجب بها
Dialogue: 0,0:15:10.32,0:15:15.72,Default,,0,0,0,,لقد هربا معا وعاشا ف توتورى لاربعة سنوات
Dialogue: 0,0:15:15.72,0:15:17.96,Default,,0,0,0,,ه..هرب؟؟
Dialogue: 0,0:15:18.36,0:15:20.57,Default,,0,0,0,,ليس سيئا ايها العجوز
Dialogue: 0,0:15:20.57,0:15:25.73,Default,,0,0,0,,و لكن والديه اعادوه للمنزل رغما عنه و تزوج الفتاه التى كان يخطبها
Dialogue: 0,0:15:26.17,0:15:31.00,Default,,0,0,0,,و كبير الخدم جاء مع هذه الزوجه
Dialogue: 0,0:15:31.00,0:15:34.55,Default,,0,0,0,,فقد كان يعمل عند عائلة الزوجه
Dialogue: 0,0:15:34.55,0:15:38.99,Default,,0,0,0,,و لكن الزوجه اصرت ان ياتى معها.
Dialogue: 0,0:15:39.28,0:15:43.26,Default,,0,0,0,,و ماذا حدث للفتاه التى هرب معها؟؟
Dialogue: 0,0:15:43.26,0:15:47.13,Default,,0,0,0,,من يعلم ؟..من المحتمل انها حصلت على الكثير من المال  لكى تنفصل عنه
Dialogue: 0,0:15:47.13,0:15:51.27,Default,,0,0,0,,عائلة موروكا سان كانت غنيه منذ اجيال
Dialogue: 0,0:15:51.27,0:15:54.81,Default,,0,0,0,,اوووه...حسنا\Nيورى سان كانت من توتورى ايضا
Dialogue: 0,0:15:54.81,0:15:58.06,Default,,0,0,0,,لهذا السبب اندمج الاثنين سويا
Dialogue: 0,0:15:58.06,0:16:02.62,Default,,0,0,0,,انا اعتقد ان عائلة سانا سان من توتورى ايضا
Dialogue: 0,0:16:02.62,0:16:07.78,Default,,0,0,0,,هذا صحيح ...كانت تحاول ان تخفى ذلك\Nلكن لهجتها كانت تفضحها احيانا
Dialogue: 0,0:16:11.84,0:16:15.25,Default,,0,0,0,,ابى يتصل ...هل ارد عليه ؟
Dialogue: 0,0:16:15.25,0:16:16.65,Default,,0,0,0,,نعم ..بالطبع
Dialogue: 0,0:16:17.24,0:16:18.59,Default,,0,0,0,,مرحبا ابى
Dialogue: 0,0:16:19.14,0:16:21.59,Default,,0,0,0,,اسفه انا مشغوله قليلا حاليا
Dialogue: 0,0:16:21.87,0:16:24.07,Default,,0,0,0,,ماذا ؟ماذا تريد؟
Dialogue: 0,0:16:24.41,0:16:25.94,Default,,0,0,0,,الم اخبرك ..نعم
Dialogue: 0,0:16:25.94,0:16:27.76,Default,,0,0,0,,لا تقلق بخصوص المال
Dialogue: 0,0:16:27.76,0:16:31.01,Default,,0,0,0,,فقط ركز على ان تصبح بخير
Dialogue: 0,0:16:32.44,0:16:34.87,Default,,0,0,0,,سوف اتصرف فى نقود الجراحه
Dialogue: 0,0:16:35.21,0:16:39.13,Default,,0,0,0,,لاتقلق ..لن تموت بهذه السهوله يا ابى
Dialogue: 0,0:16:39.72,0:16:43.83,Default,,0,0,0,,لدينا قوه تجرى فى دماؤنا
Dialogue: 0,0:16:45.05,0:16:47.20,Default,,0,0,0,,نفس الدم الاحمر
Dialogue: 0,0:16:48.68,0:16:49.78,Default,,0,0,0,,احمر..!
Dialogue: 0,0:16:52.84,0:16:53.76,Default,,0,0,0,,دماء..؟
Dialogue: 0,0:16:54.95,0:16:58.48,Default,,0,0,0,,امورو سان ..ما الامر ..اانت تتصرف  بغرابه
Dialogue: 0,0:16:59.00,0:17:00.67,Default,,0,0,0,,اوووه ...اسف
Dialogue: 0,0:17:01.90,0:17:05.91,Default,,0,0,0,,مرة اخرى ...و لكن لماذا؟
Dialogue: 0,0:17:18.50,0:17:20.80,Default,,0,0,0,,معلومات عن كودو سينشى ..اسرع
Dialogue: 0,0:17:21.41,0:17:22.33,Default,,0,0,0,,رووم...
Dialogue: 0,0:17:25.67,0:17:28.70,Default,,0,0,0,,نعم.نعم اعرف
Dialogue: 0,0:17:39.57,0:17:41.47,Default,,0,0,0,,بالمناسبه مورا كامى سان
Dialogue: 0,0:17:41.47,0:17:48.09,Default,,0,0,0,,عندما رن الانذار ..و يورى سان وضعت كوبها على الطاوله
Dialogue: 0,0:17:48.09,0:17:50.75,Default,,0,0,0,,اين كنتى؟
Dialogue: 0,0:17:50.75,0:17:52.96,Default,,0,0,0,,انا...انا كنت على طاولة مختلفه
Dialogue: 0,0:17:52.96,0:17:56.07,Default,,0,0,0,,كان الجميع يصنع ضجه عارمه بسبب الانذار
Dialogue: 0,0:17:56.07,0:17:57.89,Default,,0,0,0,,لذلك اتيت لاتفحصه
Dialogue: 0,0:17:57.89,0:18:01.14,Default,,0,0,0,,كان ذلك عندما اصطدمت ب يورى سان و سكبت عليها النبيذ
Dialogue: 0,0:18:01.88,0:18:04.04,Default,,0,0,0,,اليس هذا صحيحا؟
Dialogue: 0,0:18:04.04,0:18:05.14,Default,,0,0,0,,انا...نهم
Dialogue: 0,0:18:05.60,0:18:09.11,Default,,0,0,0,,انا كنت فى الخارج احضر نظارة فوكا ماتشى _سان
Dialogue: 0,0:18:09.11,0:18:14.23,Default,,0,0,0,,انا اتذكر ان يورى سان ذهبت لتبديل اسورتها التى سكب عليها النبيذ
Dialogue: 0,0:18:14.23,0:18:17.79,Default,,0,0,0,,مباشرة بعد ما اطلق الانذار
Dialogue: 0,0:18:18.66,0:18:23.01,Default,,0,0,0,,لا استطيع تذكر اذا كنتى تقفين بجوارها عند انطلاق الانذار
Dialogue: 0,0:18:23.01,0:18:25.16,Default,,0,0,0,,اخبرتك ..لم  اكن هناك
Dialogue: 0,0:18:25.16,0:18:28.86,Default,,0,0,0,,انا لا اقول انك تكذبين
Dialogue: 0,0:18:28.86,0:18:32.57,Default,,0,0,0,,لكنه مجرد سؤال هل    كنتى هناك ام لا
Dialogue: 0,0:18:33.66,0:18:34.67,Default,,0,0,0,,هذه حقيقه
Dialogue: 0,0:18:34.95,0:18:37.92,Default,,0,0,0,,انا حقا كنت على طاوله مختلفه
Dialogue: 0,0:18:37.92,0:18:39.92,Default,,0,0,0,,يجب ان تصدقنى
Dialogue: 0,0:18:41.75,0:18:43.67,Default,,0,0,0,,ماذا؟يقلقها؟
Dialogue: 0,0:18:44.38,0:18:47.65,Default,,0,0,0,,كنتى تقولين ان موروكا سان كان قلقا من شىء ما
Dialogue: 0,0:18:47.65,0:18:52.06,Default,,0,0,0,,نعم ..هذا ما اخبرنى به حارسه الشخضى فى باحة السيارات
Dialogue: 0,0:18:52.51,0:18:55.57,Default,,0,0,0,,مؤخرا كان يتصرف بغرابه
Dialogue: 0,0:18:55.79,0:19:00.83,Default,,0,0,0,,و انه فجاه اصبح يخسر الوزن و يتعثر باستمرار ويصاب كثيرا
Dialogue: 0,0:19:02.18,0:19:06.33,Default,,0,0,0,,بالطبع كان قلقا ...لقد تلقى خطاب تهديد
Dialogue: 0,0:19:06.62,0:19:09.78,Default,,0,0,0,,و لكن مورى كون\Nخطاب التهديد وصل ...
Dialogue: 0,0:19:07.60,0:19:08.59,Default,,0,0,0,,اصابه؟
Dialogue: 0,0:19:10.42,0:19:12.84,Default,,0,0,0,,عيادة ميانو
Dialogue: 0,0:19:10.97,0:19:12.83,Default,,0,0,0,,اصابه..اصابه ..شخص مصاب هنا
Dialogue: 0,0:19:13.31,0:19:15.49,Default,,0,0,0,,امى ...احضرت لكى مريضا
Dialogue: 0,0:19:15.49,0:19:17.10,Default,,0,0,0,,دعنى اذهب
Dialogue: 0,0:19:16.68,0:19:18.44,Default,,0,0,0,,شكرا لك
Dialogue: 0,0:19:17.10,0:19:18.83,Default,,0,0,0,,اخبرتك ...ليس بالامر الجلل
Dialogue: 0,0:19:19.01,0:19:22.18,Default,,0,0,0,,{\ميانو 29 سنه\Nطبيبه
Dialogue: 0,0:19:19.20,0:19:21.00,Default,,0,0,0,,و لكنك تنزف
Dialogue: 0,0:19:21.00,0:19:23.86,Default,,0,0,0,,كل هذا يحتاج الى تضميد
Dialogue: 0,0:19:23.86,0:19:24.92,Default,,0,0,0,,لكن...
Dialogue: 0,0:19:24.92,0:19:26.36,Default,,0,0,0,,انت مرة اخرى
Dialogue: 0,0:19:26.71,0:19:28.37,Default,,0,0,0,,انتم اكيد تتشاجرون بدافع الحب
Dialogue: 0,0:19:28.37,0:19:29.78,Default,,0,0,0,,الامر ليس هكذا
Dialogue: 0,0:19:29.78,0:19:33.15,Default,,0,0,0,,لن يتوقفوا عن الضحك على لون شعرى
Dialogue: 0,0:19:33.58,0:19:38.34,Default,,0,0,0,,بالرغم من اننى ولدت و تربيت ف اليابان
Dialogue: 0,0:19:38.93,0:19:42.31,Default,,0,0,0,,هل احدا من والديك اجنبى؟
Dialogue: 0,0:19:42.31,0:19:43.54,Default,,0,0,0,,و ماالخطا فى ذلك؟
Dialogue: 0,0:19:43.94,0:19:47.89,Default,,0,0,0,,اذا اخبر اصدقاؤك هذا
Dialogue: 0,0:19:49.04,0:19:51.74,Default,,0,0,0,,بالرغم من اختلاف الناس فى الشكل
Dialogue: 0,0:19:51.74,0:19:55.94,Default,,0,0,0,,الا انه بمجرد ان تنزع حلودهم ستجدهم جميعا لحما و دم
Dialogue: 0,0:19:56.48,0:20:02.29,Default,,0,0,0,,و لاثبات ذلك ..كل جنس فى العالم يتكون من لحم و دم
Dialogue: 0,0:20:02.77,0:20:05.79,Default,,0,0,0,,تماما مثلك
Dialogue: 0,0:20:08.32,0:20:09.46,Default,,0,0,0,,هل فهمت؟
Dialogue: 0,0:20:09.97,0:20:11.02,Default,,0,0,0,,اجل...
Dialogue: 0,0:20:11.02,0:20:13.57,Default,,0,0,0,,حسنا  ...دعنا ننظفك ...هيا
Dialogue: 0,0:20:14.94,0:20:18.15,Default,,0,0,0,,ميانو اتوشى 35 سنه\Nطبيب و عالم
Dialogue: 0,0:20:18.68,0:20:20.32,Default,,0,0,0,,انتهينا
Dialogue: 0,0:20:20.81,0:20:23.87,Default,,0,0,0,,اكيمى .ضعى له الضماده
Dialogue: 0,0:20:23.87,0:20:26.01,Default,,0,0,0,,حسنا.تعالى معى
Dialogue: 0,0:20:26.01,0:20:27.18,Default,,0,0,0,,او..اووكى
Dialogue: 0,0:20:27.18,0:20:28.80,Default,,0,0,0,,ياللعجب
Dialogue: 0,0:20:28.80,0:20:29.82,Default,,0,0,0,,عزيزتى
Dialogue: 0,0:20:30.09,0:20:34.45,Default,,0,0,0,,انتى فى  العاده خجوله و نادرا ما تتحدثين مع المرضى
Dialogue: 0,0:20:34.72,0:20:36.98,Default,,0,0,0,,و لكنك ودوده جدا مع هذا الصبى
Dialogue: 0,0:20:34.88,0:20:36.75,Default,,0,0,0,,قف ثابتا
Dialogue: 0,0:20:36.75,0:20:37.59,Default,,0,0,0,,اووو..
Dialogue: 0,0:20:36.98,0:20:38.46,Default,,0,0,0,,هذا الصبى مميز
Dialogue: 0,0:20:37.59,0:20:38.46,Default,,0,0,0,,اسفه
Dialogue: 0,0:20:38.90,0:20:41.02,Default,,0,0,0,,انه يشبهنى
Dialogue: 0,0:20:41.02,0:20:42.25,Default,,0,0,0,,ارى ذلك
Dialogue: 0,0:20:42.25,0:20:44.84,Default,,0,0,0,,ع اى حال ...كيف سار الامر؟
Dialogue: 0,0:20:44.84,0:20:48.47,Default,,0,0,0,,هل سنقوم بنقل العياده؟\Nهذا سيؤخر ابحاثك
Dialogue: 0,0:20:49.89,0:20:52.10,Default,,0,0,0,,انا افكر فى تسليمها
Dialogue: 0,0:20:52.92,0:20:53.90,Default,,0,0,0,,ماذا؟!لماذا؟
Dialogue: 0,0:20:55.49,0:20:58.72,Default,,0,0,0,,انا اكره  ان  اترككم خلفى
Dialogue: 0,0:20:58.72,0:21:02.03,Default,,0,0,0,,و  اختك قالت ان الامر مشكوك فيه
Dialogue: 0,0:21:02.36,0:21:05.73,Default,,0,0,0,,و  لكن اليس مجموعة شركات كارا سوما ترعاه
Dialogue: 0,0:21:05.73,0:21:08.55,Default,,0,0,0,,اجل ...لكننى سمعت اشاعات عنهم
Dialogue: 0,0:21:08.84,0:21:13.28,Default,,0,0,0,,لا اريد ان ينادينى احد بالعالم المجنون ثانية
Dialogue: 0,0:21:13.52,0:21:19.18,Default,,0,0,0,,و لكن ابحاثك لا يمكن ان تتم على اجزاء
Dialogue: 0,0:21:19.18,0:21:22.05,Default,,0,0,0,,إذا كان الأجر جيدا ، فهو كذلك\Nسيء للغاية لمرضانا
Dialogue: 0,0:21:22.05,0:21:25.33,Default,,0,0,0,,لكنى لا امانع ان اغلق العياده كى اساعدك
Dialogue: 0,0:21:25.33,0:21:29.86,Default,,0,0,0,,لا بأس\Nنحن الثلاثه نقوم بعمل رائع هنا
Dialogue: 0,0:21:30.33,0:21:31.54,Default,,0,0,0,,نحن اربعه
Dialogue: 0,0:21:31.54,0:21:33.44,Default,,0,0,0,,هااه؟!ماذا؟ّ!!!
Dialogue: 0,0:21:34.48,0:21:35.93,Default,,0,0,0,,انا حامل منذ ثلاثة اشهر
Dialogue: 0,0:21:35.93,0:21:37.32,Default,,0,0,0,,حقا؟؟
Dialogue: 0,0:21:37.89,0:21:41.54,Default,,0,0,0,,اذا .ربما اعيد التفكير فى عرضهم
Dialogue: 0,0:21:41.54,0:21:45.25,Default,,0,0,0,,هذا حلمك\Nلا يجب عليك ان تتركه بهذه السهوله
Dialogue: 0,0:21:45.25,0:21:46.08,Default,,0,0,0,,نعم
Dialogue: 0,0:21:47.94,0:21:49.94,Default,,0,0,0,,حسنا .سأغادر الان
Dialogue: 0,0:21:51.03,0:21:53.57,Default,,0,0,0,,هل استطيع العوده\Nعندما   أصاب مرة اخرى
Dialogue: 0,0:21:54.93,0:21:57.96,Default,,0,0,0,,لا .نحن لا نعالج الفتيان التى تتشاجر
Dialogue: 0,0:21:58.23,0:21:59.28,Default,,0,0,0,,ماذا؟؟؟
Dialogue: 0,0:21:59.28,0:22:04.83,Default,,0,0,0,,و لكن اذا كانت اصابه نبيله بينما تتصالح مع اصدقاؤءك
Dialogue: 0,0:22:05.29,0:22:07.41,Default,,0,0,0,,اذا وقتها ساضع لك ضماده
Dialogue: 0,0:22:11.28,0:22:12.84,Default,,0,0,0,,فهمت
Dialogue: 0,0:22:13.58,0:22:15.61,Default,,0,0,0,,اذا.هكذا هو الامر
Dialogue: 0,0:23:44.98,0:24:09.01,Default,,0,0,0,,فى الحلقه القادمه
Dialogue: 0,0:23:45.50,0:23:47.47,Default,,0,0,0,,وجدت مسمارا مزيفا
Dialogue: 0,0:23:49.37,0:23:53.98,Default,,0,0,0,,لهذا السبب كان المتهم قادرا غلى تسميم مشروب يورى سان
Dialogue: 0,0:23:54.75,0:23:59.40,Default,,0,0,0,,سمعت انك تصارعين لكى تدفعى المال لجراحة والدك الحرجه
Dialogue: 0,0:23:59.40,0:24:04.17,Default,,0,0,0,,ماذا؟على الاقل لست عجوزا كان يحاول ان يدفع لها المال لكى يتخلص منها
Dialogue: 0,0:24:04.61,0:24:09.02,Default,,0,0,0,,من فضلك.لا تجعل زوجتك حزينة اكثر
Dialogue: 0,0:24:09.01,0:24:15.01,Default,,0,0,0,,قضية المشروب الغير محلوله\N(الجزر الثالث)
Dialogue: 0,0:24:09.64,0:24:13.98,Default,,0,0,0,,ترجمة؛عبدالله جوده
Dialogue: 0,0:24:30.03,0:24:34.95,Default,,0,0,0,,ذكرى امورى
Dialogue: 0,0:24:30.78,0:24:33.05,Default,,0,0,0,,تلميح كونان القادم
Dialogue: 0,0:24:33.05,0:24:34.96,Default,,0,0,0,,ذكرى(امورى)
Dialogue: 0,0:24:34.95,0:24:39.94,Default,,0,0,0,,لا تفوت الحلقه القاده
Dialogue: 0,0:24:34.96,0:24:36.50,Default,,0,0,0,,امورو _سان\Nهل انت بخير؟!
Dialogue: 0,0:24:36.50,0:24:38.10,Default,,0,0,0,,ستغلق القضيه
Dialogue: 0,0:24:38.10,0:24:39.62,Default,,0,0,0,,هناك شيئا غريبا عنه