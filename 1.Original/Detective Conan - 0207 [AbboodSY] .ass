Dialogue: 0,0:00:19.46,0:00:22.87,Default,,0,0,0,,أُخبر قلبي دائماً بأن يكون قوياٌ\Nو أن يتوصل لجوهر الأمور بإيقاعٍ متناغم
Dialogue: 0,0:00:22.97,0:00:24.64,Default,,0,0,0,,أصغوا جيداً إلى الحلقة اليوم
Dialogue: 0,0:00:24.80,0:00:26.54,Default,,0,0,0,,!فستحوي لغزاً فريداً من نوعه لا يُوجد إلا في كونان
Dialogue: 0,0:00:26.74,0:00:28.11,Default,,0,0,0,,يرى الحقيقة واحدةً كما هي
Dialogue: 0,0:00:28.31,0:00:29.88,Default,,0,0,0,,يبدو كطفل صغير و لكنه بعقل كبير
Dialogue: 0,0:00:30.11,0:00:32.14,Default,,0,0,0,,و اسمه هو،  المحقق كونان
Dialogue: 0,0:01:41.05,0:01:47.02,Alternative,Sign,0,0,0,,{\pos(442,192)}الإستنتاج الذي كان جيداً للغاية
Dialogue: 0,0:01:46.99,0:01:50.96,Italic,,0,0,0,,{\p1\pos(675,568)}m 0 0 l -27 0 l -27 14 l 0 14{\p0}
Dialogue: 0,0:01:46.99,0:01:50.96,Top,Sign,0,0,0,,{\pos(400,472)}شارع بيكا
Dialogue: 0,0:01:52.06,0:01:56.26,Default,,0,0,0,,!يا ران، من هنا، من هنا
Dialogue: 0,0:01:56.26,0:01:59.00,Default,,0,0,0,,تباً.. دائماً ما تسبب لي المتاعب عندما تفرط في الشرب
Dialogue: 0,0:01:59.03,0:02:01.87,Default,,0,0,0,,أرجوك لا تذهب المرة القادمة إلى محطة القطار إذا أسرفت بالشرب مجدداً
Dialogue: 0,0:02:02.03,0:02:03.30,Default,,0,0,0,,..ليس مجدداً
Dialogue: 0,0:02:03.57,0:02:05.80,Default,,0,0,0,,ما هذا الشيء؟
Dialogue: 0,0:02:08.11,0:02:11.51,Default,,0,0,0,,"من الثامنة مساءً و حتى العاشرة: كُل و اشرب بقدر ما تريد"
Dialogue: 0,0:02:12.24,0:02:14.71,Default,,0,0,0,,هذا مثيرٌ للسخرية
Dialogue: 0,0:02:14.71,0:02:16.45,Default,,0,0,0,,ما هذا الذي تقولينه!؟
Dialogue: 0,0:02:17.02,0:02:20.65,Default,,0,0,0,,لقد شربت ثلاثة زجاجات من الشراب و تناولت خمسة أطباق وجبات خفيفة فحسب
Dialogue: 0,0:02:28.23,0:02:31.46,Top Italic,,0,0,0,,{\p1\pos(732,516)}m 0 0 l -27 0 l -27 14 l 0 14{\p0}
Dialogue: 0,0:02:28.23,0:02:31.46,Top,Sign,0,0,0,,{\pos(410,480)}(تاكايوكي إري (٢٥
Dialogue: 0,0:02:28.36,0:02:30.33,Default,,0,0,0,,لا تقم برمي الأشياء هكذا
Dialogue: 0,0:02:30.76,0:02:31.53,Default,,0,0,0,,هيا أعدها
Dialogue: 0,0:02:31.66,0:02:34.57,Default,,0,0,0,,!تريد مني إعادتها؟ قم أنت بإعادتها
Dialogue: 0,0:02:34.90,0:02:38.20,Default,,0,0,0,,!ما الذي تقوم به! ستجعلني أسقط
Dialogue: 0,0:02:38.20,0:02:38.94,Default,,0,0,0,,!إخرس
Dialogue: 0,0:02:39.54,0:02:40.81,Default,,0,0,0,,ماذا يجب أن نفعل أبي؟
Dialogue: 0,0:02:40.97,0:02:44.84,Default,,0,0,0,,سيستمرون بإزعاجي حتى أوقفهم بنفسي
Dialogue: 0,0:02:45.48,0:02:48.61,Default,,0,0,0,,بي.. سأذهب أنا و أجعلهم يتوقفون
Dialogue: 0,0:02:50.02,0:02:51.15,Default,,0,0,0,,لا تقلقوا
Dialogue: 0,0:02:52.65,0:02:55.22,Default,,0,0,0,,فإنهم دائماً يتشاجرون هكذا
Dialogue: 0,0:02:55.55,0:02:58.62,Default,,0,0,0,,سينتهي الأمر قريباً، أليس كذلك؟
Dialogue: 0,0:03:02.69,0:03:04.80,Default,,0,0,0,,يبدو أننا كنا قلقين على لا شيء
Dialogue: 0,0:03:05.10,0:03:05.83,Default,,0,0,0,,لنذهب
Dialogue: 0,0:03:07.13,0:03:08.10,Default,,0,0,0,,!أبي
Dialogue: 0,0:03:08.17,0:03:11.07,Default,,0,0,0,,انتظر قليلاً
Dialogue: 0,0:03:11.07,0:03:12.14,Default,,0,0,0,,أنا بخير
Dialogue: 0,0:03:12.87,0:03:15.07,Default,,0,0,0,,ألا يمكنك أن ترى إلى أين أنت متجه؟
Dialogue: 0,0:03:16.71,0:03:20.21,Default,,0,0,0,,في اليوم التالي، لم نشعر براحةٍ عن ما حصل هناك\Nفعدنا لذلك المكان بالفعل كي نتفقدهم
Dialogue: 0,0:03:25.68,0:03:28.35,Default,,0,0,0,,جميع الأدلة تشير إلى أن هذه جريمة قتل
Dialogue: 0,0:03:28.69,0:03:33.29,Default,,0,0,0,,الوقت المقدر للوفاة هو بين العاشرة مساءً و الحادية عشرة
Dialogue: 0,0:03:33.79,0:03:35.93,Default,,0,0,0,,..هذا مستحيل
Dialogue: 0,0:03:38.60,0:03:40.00,Default,,0,0,0,,!أنت مجدداً
Dialogue: 0,0:03:40.00,0:03:41.30,Default,,0,0,0,,..في الواقع
Dialogue: 0,0:03:41.40,0:03:43.20,Default,,0,0,0,,الأمور السيئة دائماً ما تحصل حولك موري-كن
Dialogue: 0,0:03:44.57,0:03:45.40,Default,,0,0,0,,!مفتش ميغوري
Dialogue: 0,0:03:45.87,0:03:47.77,Default,,0,0,0,,الأمر تماماً كما قال السيد موري
Dialogue: 0,0:03:48.37,0:03:55.71,Default,,0,0,0,,نقلاً عن ما قاله صاحب الشقة، كان هناك شجارٌ بين الضحية و شخصٌ آخر
Dialogue: 0,0:03:57.25,0:03:59.68,Default,,0,0,0,,ألم يذكر لك أي شيء عن الشخص الآخر؟
Dialogue: 0,0:03:59.85,0:04:01.65,Default,,0,0,0,,سوف أقوم بسؤاله على الفور
Dialogue: 0,0:04:03.05,0:04:09.83,Default,,0,0,0,,ولكن مع أن المحقق الشهير موري كوغورو مرَّ هنا البارحة\Nإلا أنه لم يساهم في إيقاف هذا الشجار الذي حصل
Dialogue: 0,0:04:10.33,0:04:11.56,Default,,0,0,0,,أعتذر عن هذا
Dialogue: 0,0:04:12.43,0:04:18.90,Default,,0,0,0,,تباً! لولا لم يأتِ ذلك العجوز الخرف\N!لكنا قد أوقفنا ذلك الشجار من الحصول
Dialogue: 0,0:04:26.58,0:04:29.15,Default,,0,0,0,,..أرجوك ساعدني! سيد موري
Dialogue: 0,0:04:31.08,0:04:37.56,Top Italic,,0,0,0,,{\p1\pos(732,516)}m 0 0 l -27 0 l -27 14 l 0 14{\p0}
Dialogue: 0,0:04:31.08,0:04:37.56,Top,Sign,0,0,0,,{\\fs45\pos(408,492)}(هيروشي ناكاموتو (٢٦
Dialogue: 0,0:04:31.48,0:04:38.22,Default,,0,0,0,,كنا أنا و تاكايوكي إري نعمل سويةً في جامعة بيكا، اسمي هو ناكاموتو
Dialogue: 0,0:04:38.99,0:04:39.89,Default,,0,0,0,,ناكاموتو؟
Dialogue: 0,0:04:40.19,0:04:40.66,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:04:41.83,0:04:42.59,Default,,0,0,0,,!لقد كان أنت
Dialogue: 0,0:04:42.89,0:04:44.53,Default,,0,0,0,,أنت هو الذي قتل إري أليس كذلك!؟
Dialogue: 0,0:04:44.73,0:04:46.33,Default,,0,0,0,,!هذا ليس صحيحاً
Dialogue: 0,0:04:46.97,0:04:50.57,Default,,0,0,0,,!حتى لو اشتبهت الشرطة بي، أنا لم أفعلها
Dialogue: 0,0:04:51.14,0:04:54.07,Default,,0,0,0,,!في الليلة الماضية، أنا لم أكن في المنزل حتى
Dialogue: 0,0:04:54.44,0:04:55.34,Default,,0,0,0,,!هذه الحقيقة
Dialogue: 0,0:04:59.64,0:05:05.48,Default,,0,0,0,,انتظر، سمعناك تتشاجر معه الليلة الماضية
Dialogue: 0,0:05:06.05,0:05:07.29,Default,,0,0,0,,و الآن تقوم بإخبارنا بأنك لم تكن في المنزل
Dialogue: 0,0:05:07.79,0:05:08.99,Default,,0,0,0,,كيف تفسر لي هذا؟
Dialogue: 0,0:05:09.55,0:05:10.82,Default,,0,0,0,,كان هذا مسجلاً
Dialogue: 0,0:05:11.16,0:05:14.49,Default,,0,0,0,,لم يكن هذا أنا! لقد اعتاد على أن يجعل الناس تظن أنني في المنزل
Dialogue: 0,0:05:15.03,0:05:15.56,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:05:16.56,0:05:17.83,Default,,0,0,0,,قام بهذا كي يلفت الانتباه وحسب؟
Dialogue: 0,0:05:18.23,0:05:19.33,Default,,0,0,0,,صحيح
Dialogue: 0,0:05:20.00,0:05:24.54,Default,,0,0,0,,بعد أن أغلق الستائر، قام بتشغيل شريط التسجيل
Dialogue: 0,0:05:29.74,0:05:32.01,Default,,0,0,0,,لا تقم برمي الأشياء هكذا
Dialogue: 0,0:05:32.04,0:05:32.68,Default,,0,0,0,,هيا أعدها
Dialogue: 0,0:05:33.08,0:05:35.98,Italic,,0,0,0,,!تريد مني إعادتها؟  قم أنت بإعادتها
Dialogue: 0,0:05:37.62,0:05:39.42,Default,,0,0,0,,لقد قام بفعل كل هذا لوحده
Dialogue: 0,0:05:39.88,0:05:40.89,Default,,0,0,0,,نعم
Dialogue: 0,0:05:41.02,0:05:42.95,Default,,0,0,0,,للاسف لا أملك دليلاً يثبت برائتي
Dialogue: 0,0:05:43.25,0:05:44.42,Default,,0,0,0,,دليل؟
Dialogue: 0,0:05:45.99,0:05:47.56,Default,,0,0,0,,و لِمَ قد يفعل هذا هو؟
Dialogue: 0,0:05:48.66,0:05:56.23,Default,,0,0,0,,كي أتمكن من التخفي و التجسس على البروفسور\Nثم أنتظر الفرصة المناسبة لأقوم بقتله
Dialogue: 0,0:05:56.70,0:05:57.87,Default,,0,0,0,,ماذا قلت!؟
Dialogue: 0,0:05:58.67,0:06:03.81,Default,,0,0,0,,كان يقوم بسرقة نتائج أبحاثنا و يدّعي أنها له كي يكسب الشهرة و النجاح
Dialogue: 0,0:06:03.84,0:06:10.22,Default,,0,0,0,,و مع أننا كنا نعلم أنه يقوم بذلك، إلا أنه لم يكن هناك شيء يمكننا فعله
Dialogue: 0,0:06:10.42,0:06:17.82,Default,,0,0,0,,لذا قررنا.. قررنا القيام بقتله و جعل الأمر يبدو على أنها جريمة قتل عشوائية
Dialogue: 0,0:06:22.16,0:06:29.30,Default,,0,0,0,,..ولكنني لم أستطع القيام بهذا لأنه\Nلأنه عندما دخلت منزله، لم يكن هناك
Dialogue: 0,0:06:29.90,0:06:34.94,Default,,0,0,0,,فانتظرته في مكتبته لوقتٍ طويل، ولكنني انسحبت في النهاية و عدت للمنزل
Dialogue: 0,0:06:35.27,0:06:39.64,Default,,0,0,0,,دخلت منزل البروفسور في الساعة العاشرة مساءً\Nو عندما عدت كانت الساعة الحادية عشرة
Dialogue: 0,0:06:40.98,0:06:45.92,Default,,0,0,0,,إذا كان ما قلته صحيحاً، فإنه من غير الممكن لك أن تقوم بارتكاب هذه الجريمة حينها
Dialogue: 0,0:06:46.35,0:06:54.06,Default,,0,0,0,,البارحة كان دوري بمراقبة منزل البروفسور\Nولكن يبدو أنه كان يتناول العشاء في مطعمٍ ما
Dialogue: 0,0:06:55.76,0:06:57.56,Default,,0,0,0,,هذا غريبٌ حقاً
Dialogue: 0,0:06:58.96,0:07:02.80,Default,,0,0,0,,لا أعلم لِمَ قد يكذب البروفسور حول كونه متواجداً في المنزل بذلك الوقت
Dialogue: 0,0:07:03.00,0:07:06.20,Default,,0,0,0,,إذا استمر الوضع على هذا الحال، سأكون أنا القاتل بنظرهم
Dialogue: 0,0:07:07.01,0:07:11.14,Default,,0,0,0,,ستستعمل الشرطة أقوالك هذه بالتأكيد كي تزيل الشكوك عنك
Dialogue: 0,0:07:11.71,0:07:17.02,Default,,0,0,0,,سمعت أثناء التحقيقات أن المحقق موري كان شاهداً على الجريمة
Dialogue: 0,0:07:17.45,0:07:21.52,Default,,0,0,0,,لذا قررت أت آتي لرؤيتك، أرجوك ساعدني بهذا الأمر
Dialogue: 0,0:07:22.09,0:07:27.06,Default,,0,0,0,,..بالفعل لقد واجهت العديد من القضايا المشابهة ولكن
Dialogue: 0,0:07:27.93,0:07:31.50,Default,,0,0,0,,توقعت أنك لن تصدقني عندما أخبرك بهذا يا سيد موري
Dialogue: 0,0:07:32.16,0:07:34.50,Default,,0,0,0,,!أنا واثقٌ أنك ستصدقني إذا عثرنا على شريط التسجيل
Dialogue: 0,0:07:35.07,0:07:38.14,Default,,0,0,0,,أحقاً هذا الشيء موجود..؟
Dialogue: 0,0:07:38.77,0:07:45.91,Default,,0,0,0,,لم أكن قادراً على إيجاده في المنزل\Nلذا من المحتمل أن القاتل قد أخذه معه
Dialogue: 0,0:07:46.88,0:07:50.92,Default,,0,0,0,,إذا لم أستطع أن أجد الشريط، فستكون هذه نهايتي
Dialogue: 0,0:07:51.45,0:07:54.92,Default,,0,0,0,,ولكن كيف سنجده؟ أنا واثقٌ أن القاتل قد تخلص منه الآن
Dialogue: 0,0:07:56.52,0:08:00.36,Default,,0,0,0,,يا أبي، ألا يجب أن نحاول البحث عن ذلك الشريط؟
Dialogue: 0,0:08:01.99,0:08:06.00,Default,,0,0,0,,إذا استطعت حل هذه القضية، فسوف تزيد من شعبية\Nوكالة التحقيق هذه صحيح يا عمي؟
Dialogue: 0,0:08:08.93,0:08:12.74,Default,,0,0,0,,!ستزيد شعبيتنا؟ صحيح! لنذهب للعثور على ذلك الشريط
Dialogue: 0,0:08:15.74,0:08:20.58,Default,,0,0,0,,لنبدأ عبر البحث في المداخل و المخارج القريبة من المنزل
Dialogue: 0,0:08:22.88,0:08:24.78,Default,,0,0,0,,و الآن لنجرب البحث بجانب محطة القطار
Dialogue: 0,0:08:26.08,0:08:30.69,Default,,0,0,0,,لابد أن القاتل قد حاول التخلص من الشريط بأسرع وقتٍ ممكن
Dialogue: 0,0:08:35.93,0:08:38.96,Default,,0,0,0,,!أنت هناك! توقف للحظة
Dialogue: 0,0:08:41.87,0:08:43.47,Default,,0,0,0,,ما هذا الذي تفعله؟
Dialogue: 0,0:08:43.90,0:08:47.24,Default,,0,0,0,,مع أنه قال بأن المجرم قد تخلص من الشريط بأسرع وقتٍ ممكن
Dialogue: 0,0:08:48.44,0:08:49.54,Default,,0,0,0,,!وجدته
Dialogue: 0,0:08:50.01,0:08:51.94,Default,,0,0,0,,!ها هو! إنه الشريط
Dialogue: 0,0:08:54.98,0:08:56.92,Default,,0,0,0,,إيجاد هذا الشريط كان سهلاً للغاية
Dialogue: 0,0:08:56.98,0:08:58.65,Default,,0,0,0,,شكراً لمساعدتك على إيجاد الشريط
Dialogue: 0,0:08:59.55,0:09:00.62,Default,,0,0,0,,الشرطي تاكاغي!؟
Dialogue: 0,0:09:00.95,0:09:03.22,Default,,0,0,0,,سوف نقوم بأخذ هذا الدليل الهام جداً
Dialogue: 0,0:09:03.39,0:09:06.09,Default,,0,0,0,,بالتأكيد هذا الشيء جيدٌ جداً
Dialogue: 0,0:09:07.43,0:09:10.60,Default,,0,0,0,,انتظر قليلاً، سأسمح لك بأخذ الشريط معك إلى المركز
Dialogue: 0,0:09:14.37,0:09:17.07,Italic,,0,0,0,,!تريد مني إعادتها؟  قم أنت بإعادتها
Dialogue: 0,0:09:17.67,0:09:21.81,Default,,0,0,0,,هذا هو الصوت الذي سمعناه البارحة، صحيح كونان-كن؟
Dialogue: 0,0:09:23.98,0:09:24.94,Default,,0,0,0,,هكذا إذاً
Dialogue: 0,0:09:26.04,0:09:31.05,Default,,0,0,0,,هذا يمكنه أن يثبت بأن ناكاموتو-كن كان يقول الحقيقة
Dialogue: 0,0:09:31.38,0:09:32.45,Default,,0,0,0,,!هذا رائع
Dialogue: 0,0:09:32.75,0:09:38.99,Default,,0,0,0,,أخيراً وجدت أحداً ما يصدق ما أقول\Nولكن لماذا قام البروفسور بالكذب..؟
Dialogue: 0,0:09:39.32,0:09:40.26,Default,,0,0,0,,بالفعل
Dialogue: 0,0:09:40.89,0:09:46.73,Default,,0,0,0,,ذلك العجوز... لو لم يقم بالكذب، لما كنت قد تعرضت للشبهات منذ البداية
Dialogue: 0,0:09:47.10,0:09:47.97,Default,,0,0,0,,!هكذا إذاً
Dialogue: 0,0:09:48.23,0:09:50.23,Default,,0,0,0,,!أراد البروفسور إزاحتك من الطريق
Dialogue: 0,0:09:50.70,0:09:55.04,Default,,0,0,0,,ولكن لماذا قد يفعل هذا؟
Dialogue: 0,0:09:58.91,0:10:04.28,Default,,0,0,0,,هل من الممكن أنه كان يدّعي تواجده في المنزل بينما لم يكن هناك؟
Dialogue: 0,0:10:05.75,0:10:10.25,Default,,0,0,0,,إذا كانت القضية هكذا، فمن الممكن أنه هو القاتل الحقيقي
Dialogue: 0,0:10:13.36,0:10:14.49,Default,,0,0,0,,هذا محتمل
Dialogue: 0,0:10:15.06,0:10:15.69,Default,,0,0,0,,ولكن
Dialogue: 0,0:10:16.73,0:10:18.06,Default,,0,0,0,,هذا مستحيل
Dialogue: 0,0:10:18.60,0:10:26.44,Default,,0,0,0,,هل تفترض أن البروفسور كان يعلم مسبقاً بخطتنا بالتجسس في منزله؟
Dialogue: 0,0:10:26.67,0:10:29.31,Default,,0,0,0,,يعقل أنه كان يسترق السمع علينا بطريقةٍ ما؟
Dialogue: 0,0:10:30.04,0:10:31.28,Default,,0,0,0,,يسترق السمع..؟
Dialogue: 0,0:10:31.44,0:10:33.04,Default,,0,0,0,,!ربما الأمر هكذا
Dialogue: 0,0:10:36.41,0:10:39.12,Default,,0,0,0,,بالفعل، بعض المسامير مفقودة من هذا المقبس
Dialogue: 0,0:10:39.48,0:10:41.09,Default,,0,0,0,,من المحتمل أنه كان يتنصت عليكم
Dialogue: 0,0:10:42.85,0:10:45.56,Default,,0,0,0,,حقاً؟ شكراً على جهودك
Dialogue: 0,0:10:46.69,0:10:50.16,Default,,0,0,0,,كما توقعت لقد كان يتنصت على مكالماتكم الهاتفية
Dialogue: 0,0:10:51.16,0:10:52.90,Default,,0,0,0,,الأمور واضحة الآن
Dialogue: 0,0:10:53.43,0:10:57.84,Default,,0,0,0,,كان يستولي البروفسور على نتائج أبحاثكم و يدّعي\Nأنها له كي يكسب الشهرة و النجاح
Dialogue: 0,0:10:58.94,0:11:03.11,Default,,0,0,0,,بنفس الوقت كان يشعر بالقلق من أنكم قد تنوون الإنتقام منه
Dialogue: 0,0:11:03.71,0:11:08.08,Default,,0,0,0,,و هذا ما دفعه إلى التجسس على مكالماتكم الهاتفية
Dialogue: 0,0:11:08.98,0:11:11.08,Default,,0,0,0,,إذاً هو من قام بهذا ولكن كيف
Dialogue: 0,0:11:11.68,0:11:17.79,Default,,0,0,0,,من المحتمل أنه عندما كانوا في الجامعة، قام باستعمال نسخةٍ\Nمقلّدة من المفاتيح كي يدخل إلى المنزل
Dialogue: 0,0:11:18.72,0:11:20.02,Default,,0,0,0,,بالضبط
Dialogue: 0,0:11:20.29,0:11:27.00,Default,,0,0,0,,كان يقوم بالتجسس على مكالماتكم الهاتفية لفترة فقام\Nباكتشاف خطتكم عن القيام بقتله
Dialogue: 0,0:11:27.73,0:11:33.14,Default,,0,0,0,,و نتيجةً لهذا، قام باستعمال خطتكم ضدكم\Nقَلَبَها لتصب في صالحه، و جعلها دليل براءةٍ له
Dialogue: 0,0:11:34.47,0:11:41.78,Default,,0,0,0,,ثم و في الليلة الفائتة، بينما كانت الضحية و ناكاموتو يقومان بتنفيذ خطتهما
Dialogue: 0,0:11:42.65,0:11:49.02,Default,,0,0,0,,اقتحم البروفسور المنزل بشكلٍ مفاجئ و قام بقتله
Dialogue: 0,0:11:51.49,0:11:53.22,Default,,0,0,0,,ثم قام بأخذ الشريط من مسرح الجريمة
Dialogue: 0,0:11:53.49,0:12:04.60,Default,,0,0,0,,بهذه الطريقة عندما يتم اكتشاف الجثة\Nبالطبع ستكون أنت أول شخصٍ مشتبه به
Dialogue: 0,0:12:05.97,0:12:10.88,Default,,0,0,0,,باختصار، عبر قتله في غرفةٍ مغلقة هكذا، سيكون\Nناكاموتو-كن المتهم الوحيد بهذه الجريمة بلا شك
Dialogue: 0,0:12:11.38,0:12:13.75,Default,,0,0,0,,هذه كانت خطة البروفسور
Dialogue: 0,0:12:14.38,0:12:17.32,Default,,0,0,0,,قام بتطبيق خطتنا ضدنا
Dialogue: 0,0:12:17.95,0:12:25.36,Default,,0,0,0,,في الحقيقة، على الرغم من خطته الذكية هذه\Nإلا أنه لم يتوقع أن يصطدم بالمحقق الشهير موري كوغورو
Dialogue: 0,0:12:27.76,0:12:30.43,Default,,0,0,0,,لماذا تتصرف دائماً بهذا الشكل يا عمي..؟
Dialogue: 0,0:12:30.83,0:12:35.07,Default,,0,0,0,,ينتهي بك المطاف دائماً على خطأ، منتظراً أن آتي أنا و أُنقذ الموقف
Dialogue: 0,0:12:35.73,0:12:42.81,Default,,0,0,0,,لماذا أنت مسرورٌ هكذا؟ لو أنك سمعت نصحيتي البارحة\Nلكنت منعت هذه الجريمة من الحدوث قبل وقوعها
Dialogue: 0,0:12:44.64,0:12:46.01,Default,,0,0,0,,لقد نسيت
Dialogue: 0,0:12:47.11,0:12:53.55,Default,,0,0,0,,سمعت من المفتش ميغوري أنك التقيت برجلٍ عجوز معه كلب\Nليلة البارحة في الشارع
Dialogue: 0,0:12:54.02,0:12:57.72,Default,,0,0,0,,هذا صحيح، لو لم يتدخل بنا، لكانت الامور الآن مختلفةٌ تماماً
Dialogue: 0,0:12:58.59,0:13:03.36,Default,,0,0,0,,لكن و مع هذا، نوايا ذلك العجوز لم تكن تبدو سيئة أليس كذلك؟
Dialogue: 0,0:13:04.06,0:13:05.86,Default,,0,0,0,,أيعقل..!؟
Dialogue: 0,0:13:07.47,0:13:09.03,Default,,0,0,0,,كل شيءٍ أصبح منطقياً الآن
Dialogue: 0,0:13:10.03,0:13:12.60,Default,,0,0,0,,العم كان قد شرب كثيراً ولكنه أدى عمله على أكمل وجه
Dialogue: 0,0:13:19.48,0:13:26.75,Default,,0,0,0,,حسناً! سأذهب و أراهن المفتش ميغوري على سمعتي كمحقق
Dialogue: 0,0:13:27.45,0:13:28.39,Default,,0,0,0,,هذا ليس جيداً
Dialogue: 0,0:13:28.92,0:13:30.79,Default,,0,0,0,,ماذا؟ ما الذي ليس جيداً؟
Dialogue: 0,0:13:31.52,0:13:34.79,Default,,0,0,0,,كما ترى.. أعتقد أننا يجب أن ننتظرهم حتى يأتوا لعندنا
Dialogue: 0,0:13:34.83,0:13:38.86,Default,,0,0,0,,كي يسألوننا إذا كنا قد توصلنا لشيءٍ ما\Nحتى يمكننا مساعدتهم في تحقيقاتهم
Dialogue: 0,0:13:40.60,0:13:42.17,Default,,0,0,0,,قد تكون محقاً بهذا
Dialogue: 0,0:13:42.33,0:13:44.87,Default,,0,0,0,,سأذهب لألعب قليلاً قبل أن يأتوا
Dialogue: 0,0:13:49.44,0:13:52.64,Default,,0,0,0,,أتقول أنها جريمة مدبرة و لديه حجة براءة؟
Dialogue: 0,0:13:53.34,0:13:55.58,Default,,0,0,0,,فهمت، كما هو متوقع منك موري-كن
Dialogue: 0,0:13:55.88,0:13:58.18,Default,,0,0,0,,!الأمر هكذا بالطبع
Dialogue: 0,0:13:59.72,0:14:02.35,Default,,0,0,0,,أنت تشتبه بأن القاتل الحقيقي هو البروفسور صحيح سيد ناكاموتو؟
Dialogue: 0,0:14:02.62,0:14:04.52,Default,,0,0,0,,كلا، أنت لم تفهمني
Dialogue: 0,0:14:05.39,0:14:09.46,Default,,0,0,0,,كرهي تجاه البروفسور لا علاقة له بهذا
Dialogue: 0,0:14:09.79,0:14:11.96,Default,,0,0,0,,حسناً، سوف نتأكد من هذا
Dialogue: 0,0:14:12.46,0:14:17.13,Default,,0,0,0,,تاكاغي-كن! قم بإصدار مذكرة اعتقال بحق البروفسور الآن
Dialogue: 0,0:14:17.17,0:14:17.74,Default,,0,0,0,,حسناً
Dialogue: 0,0:14:25.04,0:14:27.25,Default,,0,0,0,,إنتظر قليلاً أيها المفتش
Dialogue: 0,0:14:28.78,0:14:31.95,Default,,0,0,0,,لقد خطر في بالي احتماليةٌ اخرى
Dialogue: 0,0:14:32.65,0:14:35.15,Default,,0,0,0,,!أعلم الآن من هو القاتل الحقيقي
Dialogue: 0,0:14:35.79,0:14:38.29,Default,,0,0,0,,القاتل الحقيقي؟
Dialogue: 0,0:14:38.36,0:14:40.42,Default,,0,0,0,,ما الذي تعنيه، موري-كن؟
Dialogue: 0,0:14:40.73,0:14:46.40,Default,,0,0,0,,حسناً، اجلس قليلاً من فضلك و دعني أشرح لك كل شيء
Dialogue: 0,0:14:48.00,0:14:52.57,Default,,0,0,0,,القصة التي ابتدعها ناكاموتو-كن عبارةٌ عن كذبةٍ لا أكثر
Dialogue: 0,0:14:52.94,0:14:56.84,Default,,0,0,0,,باختصار، هناك سخصان قاما بالكذب
Dialogue: 0,0:14:57.17,0:15:04.55,Default,,0,0,0,,شريط التسجيل بكل حال يبقى واقعاً غير قابلٍ للتغيير
Dialogue: 0,0:15:04.88,0:15:19.70,Default,,0,0,0,,بينما كان ناكاموتو-كن يقوم بتنفيذ خطته للإيقاع بالبروفسور\Nقام بارتكاب خطأٍ كبير
Dialogue: 0,0:15:20.13,0:15:21.10,Default,,0,0,0,,خطأ؟
Dialogue: 0,0:15:21.53,0:15:26.67,Default,,0,0,0,,إذاً هل تحاول القول بأن جميع إقراراته السابقة كان الهدف منها تضليلنا؟
Dialogue: 0,0:15:27.10,0:15:29.27,Default,,0,0,0,,هذا ما أحاول قوله بالضبط
Dialogue: 0,0:15:29.71,0:15:31.68,Default,,0,0,0,,و في ما يخص الشريط
Dialogue: 0,0:15:31.68,0:15:35.21,Default,,0,0,0,,ولكن كيف سنجده؟  أنا واثقٌ أن القاتل قد تخلص منه الآن
Dialogue: 0,0:15:36.08,0:15:42.62,Default,,0,0,0,,ما كان يحاول ناكاموتو-كن فعله هو إرشادنا للبحث في القمامة عن الشريط
Dialogue: 0,0:15:43.22,0:15:45.72,Default,,0,0,0,,..و أيضاً بالإضافة إلى
Dialogue: 0,0:15:46.42,0:15:47.39,Default,,0,0,0,,..ذلك العجوز الخرف
Dialogue: 0,0:15:47.63,0:15:52.23,Default,,0,0,0,,لو لم يقم بالكذب، لما كنت قد تعرضت للشبهات منذ البداية
Dialogue: 0,0:15:53.13,0:15:56.50,Default,,0,0,0,,..إذاً ما قاله ناكاموتو-كن قد يكون حقيقياً، و أيضاً
Dialogue: 0,0:15:58.54,0:16:04.24,Default,,0,0,0,,هل من المحتمل أنه كان يدّعي تواجده في المنزل بينما لم يكن هناك؟
Dialogue: 0,0:16:04.78,0:16:11.98,Default,,0,0,0,,بتلك العبارة، أنشأ احتمالية تورط البروفسور
Dialogue: 0,0:16:12.32,0:16:13.28,Default,,0,0,0,,..بالإضافة إلى
Dialogue: 0,0:16:14.29,0:16:16.89,Default,,0,0,0,,هل من الممكن أنه كان يسترق السمع علينا بطريقةٍ ما؟
Dialogue: 0,0:16:17.76,0:16:21.59,Default,,0,0,0,,لقد كان الأمر مستحيلاً أن يقوم بالتنصت على محادثاتهم الخاصة
Dialogue: 0,0:16:24.33,0:16:27.63,Default,,0,0,0,,أراد أن يقودني بهذا لأجد بعض الأدلة التي تثبت براءته
Dialogue: 0,0:16:27.93,0:16:36.34,Default,,0,0,0,,و في الوقت نفسه يقوم بوضع البروفسور في مسرح الجريمة وقت حدوثها
Dialogue: 0,0:16:36.87,0:16:39.54,Default,,0,0,0,,أراد استعمال هذه المعلومات كي يضع تحقيقاتي جميعها في صفه
Dialogue: 0,0:16:39.71,0:16:44.42,Default,,0,0,0,,في الواقع فإن هذه التحقيقات أنت من شخصٍ واحدٍ فقط\N!و هذا الشخص هو أنت، ناكاموتو-كن
Dialogue: 0,0:16:46.58,0:16:47.52,Default,,0,0,0,,فهمت
Dialogue: 0,0:16:48.39,0:16:53.82,Default,,0,0,0,,لا حاجة لنذكر أن القاتل دخل منزل الضحية
Dialogue: 0,0:16:54.79,0:17:00.77,Default,,0,0,0,,ثم و بينما كان الضحية يقوم بدوره قام أحدٌ بطعنه
Dialogue: 0,0:17:01.40,0:17:02.30,Default,,0,0,0,,..و هذا الشخص كان.. أنت
Dialogue: 0,0:17:05.00,0:17:08.51,Default,,0,0,0,,القاتل كان يعيش في الشقة نفسها التي تسكنها الضحية
Dialogue: 0,0:17:09.31,0:17:13.04,Default,,0,0,0,,و بالطبع، نتيجةً لهذا لم يكن هناك حاجةٌ لتركيب جهاز تنصت على الهاتف
Dialogue: 0,0:17:14.41,0:17:18.45,Default,,0,0,0,,كل ما كان عليك فعله هو فك مسامير مقبس الهاتف
Dialogue: 0,0:17:19.52,0:17:21.62,Default,,0,0,0,,أليس كذلك ناكاموتو-كن؟
Dialogue: 0,0:17:24.29,0:17:27.96,Default,,0,0,0,,لاحظت كيف أن الأمر غريب منذ البداية، عندما عثرنا على الشريط
Dialogue: 0,0:17:28.53,0:17:33.33,Default,,0,0,0,,لو أنه حقاً تم رميه في القمامة بعد ارتكاب الجريمة\Nلكان الأمر مستحيلاً أن نجد الشريط حيث وجدناه
Dialogue: 0,0:17:35.00,0:17:41.74,Default,,0,0,0,,لأن سلة القمامة هي ملكٌ لمطعم وجبات سريعة\Nو الذي بدوره يقوم بتفريغها في كل صباح
Dialogue: 0,0:17:42.51,0:17:45.98,Default,,0,0,0,,في الحقيقة فإن ذلك الشريط لم يكن هناك منذ البداية
Dialogue: 0,0:17:47.01,0:17:52.25,Default,,0,0,0,,ذلك الشريط لم يتم التخلص منه منذ الليلة الماضية \Nبل أنت من قمت برميه هناك تماماً قبل أن أقوم أنا بالعثور عليه
Dialogue: 0,0:17:52.65,0:17:58.02,Default,,0,0,0,,لو لم تقم برميه هناك، لما كنت قادراً من العثور عليه أليس كذلك ناكاموتو-كن؟
Dialogue: 0,0:17:59.99,0:18:02.86,Default,,0,0,0,,ما الذي تقوله سيد موري؟
Dialogue: 0,0:18:03.03,0:18:07.03,Default,,0,0,0,,كل ما قلته مجرد ترهات
Dialogue: 0,0:18:07.23,0:18:08.43,Default,,0,0,0,,ليس ترهات
Dialogue: 0,0:18:09.40,0:18:12.64,Default,,0,0,0,,أعتذر عن هذا ناكاموتو-كن ولكن لدي شاهد عيان
Dialogue: 0,0:18:12.94,0:18:13.77,Default,,0,0,0,,شاهد؟
Dialogue: 0,0:18:18.78,0:18:22.55,Default,,0,0,0,,المعذرة.. لقد دعاني كونان-كن للقدوم إلى هنا منذ قليل
Dialogue: 0,0:18:23.21,0:18:25.52,Default,,0,0,0,,أنا من طلبت منه إحضاركِ إلى هنا
Dialogue: 0,0:18:26.45,0:18:30.99,Default,,0,0,0,,حسناً، دعونا نصف الشخص الذي كان يلعب دور المحقق وفقاً لخطته
Dialogue: 0,0:18:31.79,0:18:37.83,Default,,0,0,0,,لو لم يكن معه أحدٌ آخر يساعده بلعب لعبة التحقيق هذه\Nلما كان قادراً على إكمال أداء خطته
Dialogue: 0,0:18:38.40,0:18:44.37,Default,,0,0,0,,لهذا قرر أن يستغل شخصاً شهيراً كالمحقق الشهير موري كوغورو
Dialogue: 0,0:18:45.00,0:18:49.34,Default,,0,0,0,,ولكن، لم يدع الأمر يحصل اعتماداً على حسن الصُدف
Dialogue: 0,0:18:50.24,0:18:59.95,Default,,0,0,0,,بل خطط بطريقةٍ اخرى يجعلني أقوم بها بالتحدث إليه بكل رغبتي
Dialogue: 0,0:19:00.22,0:19:02.02,Default,,0,0,0,,كيف قام بهذا؟
Dialogue: 0,0:19:02.69,0:19:12.03,Default,,0,0,0,,قام بوضع ورقةٍ في صندوق بريدي تحوي على إعلانٍ مضمونه هو\N"من الثامنة مساءً و حتى العاشرة: كُل و اشرب بقدر ما تريد"
Dialogue: 0,0:19:12.40,0:19:16.13,Default,,0,0,0,,فهمت! كان يعلم بأن موري-كن لن يستطيع مقاومة عرضٍ كهذا
Dialogue: 0,0:19:16.70,0:19:22.81,Default,,0,0,0,,و بفضل هذا، كان متأكداً أنني سوف أمر بجانب منزل الضحية
Dialogue: 0,0:19:23.61,0:19:26.81,Default,,0,0,0,,و في الوقت الذي أنت قمت بتحديده
Dialogue: 0,0:19:27.04,0:19:32.32,Default,,0,0,0,,قام الضحية بإلقاء نظرةٍ من النافذة كي يتأكد بأنني في\Nالأسفل ثم بدأ القيام بلعب دوره
Dialogue: 0,0:19:32.68,0:19:35.02,Default,,0,0,0,,و لسوء الحظ لم يكن لديه فكرةٌ بأنه سوف يتعرض للقتل بعد ذلك
Dialogue: 0,0:19:35.12,0:19:36.22,Default,,0,0,0,,لقد كان يقوم بلفت الإنتباه فقط
Dialogue: 0,0:19:38.66,0:19:41.96,Default,,0,0,0,,ولكن لماذا تقول بأن هذه السيدة شاهدةٌ عيان؟
Dialogue: 0,0:19:42.99,0:19:43.93,Default,,0,0,0,,..لأنه
Dialogue: 0,0:19:45.36,0:19:50.67,Default,,0,0,0,,ناكاموتو-كن، عندما قام شخصٌ ما بوضع ذلك الإعلان\Nفي صندوق بريدي البارحة
Dialogue: 0,0:19:50.83,0:19:54.04,Default,,0,0,0,,هذه المرأة رأت من يكون ذلك الشخص
Dialogue: 0,0:19:54.54,0:19:58.04,Default,,0,0,0,,اعذريني سيدة أزوسا، هل هذا هو الشخص الذي قام\Nبوضع ورقة الإعلان في صندوق بريدي البارحة؟
Dialogue: 0,0:19:58.44,0:20:00.11,Default,,0,0,0,,نعم إنه هو
Dialogue: 0,0:20:00.81,0:20:06.18,Default,,0,0,0,,البارحة و في طريقي إلى العمل، رأيته يقوم بوضع ورقة الإعلان في صندوق بريدك
Dialogue: 0,0:20:07.08,0:20:09.12,Default,,0,0,0,,يمكنني التعرف إلى ورقة الإعلان إذا رأيتها مجدداً
Dialogue: 0,0:20:09.89,0:20:13.66,Default,,0,0,0,,بالطبع سوف نقوم بفحص ورقة الإعلان، و سنجد بصمات يدك عليها
Dialogue: 0,0:20:14.49,0:20:18.63,Default,,0,0,0,,من غير الممكن أن صاحب المطعم ذاك هو الذي أرسل لي هذا الإعلان
Dialogue: 0,0:20:19.23,0:20:25.37,Default,,0,0,0,,لأنه كان موجوداً في صندوق بريدي فقط، ناكاموتو-كن
Dialogue: 0,0:20:30.81,0:20:35.88,Default,,0,0,0,,هذا كله صحيح، ولكن ما الذي قادك للشك بي؟
Dialogue: 0,0:20:36.45,0:20:38.42,Default,,0,0,0,,السبب كان ما قمت بقوله
Dialogue: 0,0:20:39.45,0:20:45.79,Default,,0,0,0,,سمعت من المفتش ميغوري أنك التقيت برجلٍ عجوز معه كلب ليلة البارحة في الشارع
Dialogue: 0,0:20:46.62,0:20:49.46,Default,,0,0,0,,مع أنني ذكرت للمفتش بالفعل أنه كان هناك رجلٌ عجوز أجبرني على الرحيل
Dialogue: 0,0:20:49.66,0:20:54.13,Default,,0,0,0,,إلا أنني لم أذكر له أنه كان هناك كلباً برفقته
Dialogue: 0,0:20:54.83,0:20:59.07,Default,,0,0,0,,لم يكن بمقدورك معرفة ذلك ما لم تكن في مسرح الجريمة وقتها
Dialogue: 0,0:21:01.31,0:21:02.74,Default,,0,0,0,,أهذا ما كشفني؟
Dialogue: 0,0:21:03.37,0:21:08.41,Default,,0,0,0,,لو أنني تدخلت لإيقاف الشجار، لكانت تدمرت خطتك كذلك
Dialogue: 0,0:21:08.75,0:21:12.18,Default,,0,0,0,,لذا كي تمنع هذا، قمت بالتنكر، و إيقافي عن التدخل في ذلك الشجار المصطنع
Dialogue: 0,0:21:13.15,0:21:16.85,Default,,0,0,0,,الرجل بصحبة الكلب ذاك.. كان أنت
Dialogue: 0,0:21:21.43,0:21:28.90,Default,,0,0,0,,بالفعل تستحق لقب محققٍ عظيم يا سيد موري\N..و أنا الذي كنت أعتقد أن المحققين حمقى
Dialogue: 0,0:23:04.60,0:23:10.43,Default,,0,0,0,,ناكاموتو-كن كان يخطط للإستيلاء على الأبحاث و أخذ ضوء الشهرة لوحده فقط
Dialogue: 0,0:23:10.73,0:23:19.61,Default,,0,0,0,,صديقه كان يقف في طريق نجاحه و شهرته، فقام بالتخلص منه\Nو ألصق التهمة بالبروفسور المسؤول عنهما
Dialogue: 0,0:23:22.65,0:23:23.68,Default,,0,0,0,,..إعلانٌ آخر
Dialogue: 0,0:23:24.18,0:23:25.02,Default,,0,0,0,,ماذا ماذا!؟
Dialogue: 0,0:23:25.35,0:23:27.72,Default,,0,0,0,,!لثلاثة أيامٍ فقط، كل و اشرب بقدر ما تشاء
Dialogue: 0,0:23:27.95,0:23:31.02,Default,,0,0,0,,تباً يا أبي.. ما مشكلتك؟؟
Dialogue: 0,0:23:31.29,0:23:35.36,Default,,0,0,0,,أعيدي هذه لي! إذا شربت مجاناً فسوف ندّخر بعض المصروف للمنزل أليس كذلك!؟
Dialogue: 0,0:23:35.36,0:23:37.36,Default,,0,0,0,,توقف عن الشرب قبل أن تتفوه بهذه الأمور
Dialogue: 0,0:23:37.39,0:23:39.73,Default,,0,0,0,,!غبية! عودي إلى هنا
Dialogue: 0,0:23:39.80,0:23:43.77,Default,,0,0,0,,ألا تشعر بالشبع أبداً..؟

