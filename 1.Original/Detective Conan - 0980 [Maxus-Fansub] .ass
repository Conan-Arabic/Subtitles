Dialogue: 0,0:01:03.04,0:01:03.75,Otanoshimi,CONAN,0,0,0,,{\fad(0,300)\c&HFFFFFF&\fs100\move(-68.4,713.2,553,708.8,30,364)\blur3\3c&H000000&}!كونان
Dialogue: 0,0:02:48.98,0:02:51.02,DCMain,TAKAGI,0,0,0,,نعم، صحيح
Dialogue: 0,0:02:51.28,0:02:55.52,DCMain,SATO,0,0,0,,حدثت عدة قضايا غامضة في المدينة مؤخرًا
Dialogue: 0,0:02:55.86,0:02:58.57,DCMain,KOGORO,0,0,0,,فهمت، ما هذه؟
Dialogue: 0,0:02:58.57,0:03:02.36,DCMain,KOGORO,0,0,0,,زواج مزيّف وسطو على بنك وسرقة
Dialogue: 0,0:03:02.57,0:03:08.06,DCMain,TAKAGI,0,0,0,,قد تبدو كل قضية منفصلة إلا إن بينهم قاسمًا مشتركًا
Dialogue: 0,0:03:08.53,0:03:10.16,DCMain,SATO,0,0,0,,هاك فألقِ نظرة على هذه الملاحظات
Dialogue: 0,0:03:11.48,0:03:12.56,DCMain,KOGORO,0,0,0,,ما هذا؟
Dialogue: 0,0:03:12.99,0:03:15.67,DCMain,CONAN,0,0,0,,يبدو أنها ككُتيِّبٍ إرشادي لارتكاب الجرائم
Dialogue: 0,0:03:16.13,0:03:23.93,DCMain,SATO,0,0,0,,وَفقًا للمجرمين المُعتَقَلين، قالوا إنهم اشتروا هذه\N الخطط من رجل يلقّب نفسه مستشارًا جنائيًا
Dialogue: 0,0:03:24.14,0:03:28.56,DCMain,KOGORO,0,0,0,,هل هذه صرعة جديدة في عالم الجريمة؟
Dialogue: 0,0:03:28.81,0:03:37.65,DCMain,SATO,0,0,0,,قيل إن هذا المستشار حذرٌ جدًا، وقد حددنا موقعه
Dialogue: 0,0:03:37.67,0:03:41.32,DCMain,TAKAGI,0,0,0,,نودّ أن نطلب إليك شيئًا
Dialogue: 0,0:03:41.54,0:03:43.31,DCMain,KOGORO,0,0,0,,ما الأمر؟ قُل
Dialogue: 0,0:03:44.91,0:03:46.40,DCMain,KOGORO,0,0,0,,عملية سرية إذًا؟
Dialogue: 0,0:03:47.30,0:03:50.58,DCMain,TAKAGI,0,0,0,,في الحقيقة ستكون مستشارًا
Dialogue: 0,0:03:50.89,0:03:56.59,DCMain,TAKAGI,0,0,0,,لأنها قضية استثنائية، فسنشكر لك مساعدتنا
Dialogue: 0,0:03:57.02,0:03:58.44,DCMain,KOGORO,0,0,0,,فهمت
Dialogue: 0,0:03:58.44,0:04:02.51,DCMain,KOGORO,0,0,0,,تحتاج هذه القضية إلى مستشارٍ موهوب كي يطيح بذلك المستشار
Dialogue: 0,0:04:02.81,0:04:05.55,DCItalic,CONAN,0,0,0,,أرجو أن تكون في جعبته بعض النصائح المفيدة
Dialogue: 0,0:04:05.79,0:04:08.75,DCMain,KOGORO,0,0,0,,!ماذا تفعل هنا؟
Dialogue: 0,0:04:08.75,0:04:14.40,DCMain,CONAN,0,0,0,,لأنها عملية سريّة، فلن يشك أحدٌ في أننا من الشرطة بوجودي
Dialogue: 0,0:04:14.65,0:04:18.07,DCMain,KOGORO,0,0,0,,!أي مستشارٍ يحضر طفلًا معه إلى العمل؟
Dialogue: 0,0:04:18.49,0:04:20.62,DCMain,SATO,0,0,0,,لمَ لا تسمح له بالقدوم يا موري-سان؟
Dialogue: 0,0:04:20.62,0:04:24.07,DCMain,SATO,0,0,0,,دومًا تجري التحقيقات بسرية تامة حيثما حلّ كونان-كن
Dialogue: 0,0:04:28.30,0:04:30.33,DCMain,KOGORO,0,0,0,,هل مكتبه في الداخل؟
Dialogue: 0,0:04:30.74,0:04:33.12,DCMain,TAKAGI,0,0,0,,نعم بالتأكيد
Dialogue: 0,0:04:33.12,0:04:34.29,DCMain,SATO,0,0,0,,هيا بنا
Dialogue: 0,0:04:34.29,0:04:37.20,DCMain,TAKAGI,0,0,0,,حاضر! نشكر لك مساعدتنا يا موري-سان
Dialogue: 0,0:04:38.92,0:04:41.34,DCMain,SATO,0,0,0,,اسمي ساتو، وقد حجزتُ موعدًا منذ مدة
Dialogue: 0,0:04:42.10,0:04:43.54,DCMain,HAMANAKA,0,0,0,,مرحبًا بك
Dialogue: 0,0:04:44.12,0:04:47.85,DCMain,HAMANAKA,0,0,0,,هذا المكان الوحيد حيث تحققين أمنيتكِ
Dialogue: 0,0:04:48.09,0:04:49.85,DCMain,TAKAGI,0,0,0,,هل أنت الرجل الذي سمعنا به؟
Dialogue: 0,0:04:50.15,0:04:51.18,DCMain,HAMANAKA,0,0,0,,نعم
Dialogue: 0,0:04:52.93,0:04:57.42,DCMain,HAMANAKA,0,0,0,,أنا بروفيسور العصر الحديث، جيمس موريارتي
Dialogue: 0,0:04:57.42,0:05:01.11,DCMain,HAMANAKA,0,0,0,,{\an8}أنا المستشار الجنائي، هاماناكا ميساو
Dialogue: 0,0:05:01.36,0:05:05.11,DCMain,SATO,0,0,0,,ما وظيفة المستشار الجنائي؟
Dialogue: 0,0:05:05.28,0:05:07.89,DCMain,HAMANAKA,0,0,0,,هل تمزحين؟
Dialogue: 0,0:05:07.89,0:05:11.12,DCMain,HAMANAKA,0,0,0,,أليس هذا ما تبحثين عنه؟
Dialogue: 0,0:05:11.63,0:05:14.62,DCMain,HAMANAKA,0,0,0,,في هذا المكتب جميع الوثائق المرتبطة بالجرائم
Dialogue: 0,0:05:14.81,0:05:18.87,DCMain,HAMANAKA,0,0,0,,وكذلك الأدوات اللازمة إذا أردتِ أن ترتكبي جريمة
Dialogue: 0,0:05:19.28,0:05:26.63,DCMain,HAMANAKA,0,0,0,,باختصار، إذا اتبعتم تعليماتي بدقة، فسترتكبون الجريمة الكاملة
Dialogue: 0,0:05:26.96,0:05:27.92,DCMain,HAMANAKA,0,0,0,,ماذا؟
Dialogue: 0,0:05:27.92,0:05:33.02,DCMain,HAMANAKA,0,0,0,,ألستَ المحقق المشهور موري كوغورو؟
Dialogue: 0,0:05:33.02,0:05:41.27,DCMain,HAMANAKA,0,0,0,,!هذا يعني أن مرافقَيك هذين من ضباط الشرطة
Dialogue: 0,0:05:41.46,0:05:43.40,DCItalic,CONAN,0,0,0,,لا شك في أن يكتشف الأمر
Dialogue: 0,0:05:43.91,0:05:47.57,DCMain,SATO,0,0,0,,هلّا نتحدث قليلًا يا هاماناكا-سان؟
Dialogue: 0,0:05:48.90,0:05:49.95,DCMain,HAMANAKA,0,0,0,,.بكل سرور
Dialogue: 0,0:05:50.40,0:05:55.76,DCMain,HAMANAKA,0,0,0,,لطالما أردتُ أن أحدّث محققًا أو ضابط شرطة
Dialogue: 0,0:05:56.81,0:06:00.03,DCMain,SATO,0,0,0,,لك أن تنظر إلى هذه الكتيّبات
Dialogue: 0,0:06:00.03,0:06:01.26,DCMain,HAMANAKA,0,0,0,,دعيني أرى
Dialogue: 0,0:06:01.89,0:06:04.71,DCMain,HAMANAKA,0,0,0,,نعم، أنا كتبتُها
Dialogue: 0,0:06:04.86,0:06:07.22,DCMain,TAKAGI,0,0,0,,ماذا؟ هل تعترف؟
Dialogue: 0,0:06:07.39,0:06:10.25,DCMain,HAMANAKA,0,0,0,,ولمَ أكذب؟
Dialogue: 0,0:06:10.25,0:06:12.70,DCMain,HAMANAKA,0,0,0,,أنا كتبتُ هذه التعليمات
Dialogue: 0,0:06:12.70,0:06:16.37,DCMain,HAMANAKA,0,0,0,,وهي مخططات لارتكاب الجرائم
Dialogue: 0,0:06:16.37,0:06:19.23,DCMain,HAMANAKA,0,0,0,,!تُسمى هذه حَبكة الرواية
Dialogue: 0,0:06:19.46,0:06:21.23,DCMain,SATO,0,0,0,,حَبكة الرواية؟
Dialogue: 0,0:06:21.39,0:06:25.73,DCMain,CONAN,0,0,0,,الحَبكة هي بناء شخوص وأحداث رواية أو عرض مسرحي، صحيح؟
Dialogue: 0,0:06:25.91,0:06:31.40,DCMain,TAKAGI,0,0,0,,نعم، إنها أساس بناء القصة
Dialogue: 0,0:06:31.40,0:06:32.41,DCMain,SATO,0,0,0,,...تعني
Dialogue: 0,0:06:32.71,0:06:34.58,DCMain,KOGORO,0,0,0,,!إنها خطة لارتكاب جريمة
Dialogue: 0,0:06:34.58,0:06:39.46,DCMain,HAMANAKA,0,0,0,,لأصدقكم القول، فقد بعتُ هذه الخطط
Dialogue: 0,0:06:39.46,0:06:42.08,DCMain,HAMANAKA,0,0,0,,خطط لروايات الجريمة
Dialogue: 0,0:06:43.45,0:06:44.45,DCMain,TAKAGI,0,0,0,,ما هذا؟
Dialogue: 0,0:06:44.45,0:06:45.59,DCMain,HAMANAKA,0,0,0,,لائحة الأسعار
Dialogue: 0,0:06:45.92,0:06:47.01,DCMain,KOGORO,0,0,0,,لائحة الأسعار؟
Dialogue: 0,0:06:47.25,0:06:50.90,DCMain,HAMANAKA,0,0,0,,رتبتُها وَفقًا لنوع الجريمة
Dialogue: 0,0:06:50.90,0:06:53.97,DCMain,HAMANAKA,0,0,0,,تنوّع خدماتي سرُّ نجاحي
Dialogue: 0,0:06:53.97,0:06:56.01,DCMain,HAMANAKA,0,0,0,,لدي خططٌ لأنواع الجرائم كافة
Dialogue: 0,0:06:56.22,0:07:00.12,DCMain,CONAN,0,0,0,,...قتل، سطو، احتيال
Dialogue: 0,0:07:00.12,0:07:03.11,DCMain,CONAN,0,0,0,,"وأخرى نوعها "زرع دبوس في الحذاء
Dialogue: 0,0:07:03.38,0:07:07.62,DCMain,HAMANAKA,0,0,0,,لدي قائمة تشمل أنواع الجرائم الكاملة \Nكافة سواء أكانت قتلًا أم جريمةً خفيفة
Dialogue: 0,0:07:07.62,0:07:12.11,DCMain,HAMANAKA,0,0,0,,ولدي نُسخ أخرى غير النسخة الكاملة\N كالنسخة الخفيفة والمختصرة والنصف الأول
Dialogue: 0,0:07:12.31,0:07:15.12,DCMain,TAKAGI,0,0,0,,ما نسخة النصف الأول هذه؟
Dialogue: 0,0:07:15.43,0:07:18.41,DCMain,HAMANAKA,0,0,0,,أنا ألبّي احتياجات عملائي كافة
Dialogue: 0,0:07:18.41,0:07:23.63,DCMain,HAMANAKA,0,0,0,,أخبرني بعضهم بأنهم يريدون خططي إلا إنهم لا يحبّونها
Dialogue: 0,0:07:24.05,0:07:27.63,DCMain,CONAN,0,0,0,,إذًا لمَ قُبض على هذا الشخص؟
Dialogue: 0,0:07:28.34,0:07:31.55,DCMain,HAMANAKA,0,0,0,,هذه خطة من النسخة الخفيفة لسرقة أحد البنوك
Dialogue: 0,0:07:34.12,0:07:38.93,DCMain,HAMANAKA,0,0,0,,أما هذا، فقد أخطأ لأنه لم يُحضر معه مشعل البلازما
Dialogue: 0,0:07:38.93,0:07:42.35,DCMain,HAMANAKA,0,0,0,,وقد اعتُقل لأنه وفّر المال ولم ينجح في التسلل إلى القبو
Dialogue: 0,0:07:42.72,0:07:44.23,DCMain,SATO,0,0,0,,وهذه الخطة؟
Dialogue: 0,0:07:44.67,0:07:49.18,DCMain,HAMANAKA,0,0,0,,أما هذه، فهي خطة من النسخة المُختصرة لسرقة محفظة نقود
Dialogue: 0,0:07:50.32,0:07:54.49,DCMain,HAMANAKA,0,0,0,,كان المجرمُ سمينًا ولهذا لم ينجح في الهرب
Dialogue: 0,0:07:54.70,0:07:58.74,DCMain,TAKAGI,0,0,0,,وهذه الخطة من نسخة النصف الأول لعملية سطو؟
Dialogue: 0,0:07:58.74,0:08:00.50,DCMain,TAKAGI,0,0,0,,اعتُقل المجرم بسهولة
Dialogue: 0,0:08:00.78,0:08:04.16,DCMain,HAMANAKA,0,0,0,,أتذكر تلك القضية جيدًا
Dialogue: 0,0:08:04.16,0:08:09.27,DCMain,HAMANAKA,0,0,0,,!لا أصدّق أنه سطا على بنك دون ارتداء قفازات
Dialogue: 0,0:08:09.27,0:08:10.51,DCMain,CONAN,0,0,0,,ألهذا السبب؟
Dialogue: 0,0:08:11.18,0:08:14.30,DCMain,CONAN,0,0,0,,يبدو أن كلّ من اتبع تعليماتك قد قُبض عليه
Dialogue: 0,0:08:14.60,0:08:17.42,DCMain,CONAN,0,0,0,,وقد كذبتَ حين قلتَ إنك تبيع خططًا لارتكاب جرائم كاملة
Dialogue: 0,0:08:17.42,0:08:19.44,DCMain,HAMANAKA,0,0,0,,!هـ- هذا ليس صحيحًا
Dialogue: 0,0:08:19.44,0:08:22.10,DCMain,HAMANAKA,0,0,0,,!يوجد العديد من المجرمين الذين نجحوا ولم يُقبض عليهم
Dialogue: 0,0:08:23.25,0:08:28.48,DCMain,HAMANAKA,0,0,0,,بعتُ خطة لارتكاب إحدى الجرائم، ولم تحل لسنوات
Dialogue: 0,0:08:28.86,0:08:32.49,DCMain,SATO,0,0,0,,هلّا تحدّثنا أكثر عن تلك القضية؟
Dialogue: 0,0:08:33.53,0:08:36.56,DCMain,HAMANAKA,0,0,0,,أعتذر من هذا
Dialogue: 0,0:08:36.56,0:08:40.49,DCMain,HAMANAKA,0,0,0,,لا أستطيع تسريب معلومات عملائي
Dialogue: 0,0:08:40.66,0:08:44.25,DCMain,TAKAGI,0,0,0,,نعم ولكن ما باليد حيلة
Dialogue: 0,0:08:44.54,0:08:50.67,DCMain,HAMANAKA,0,0,0,,وددتُ مساعدتك حقًا، لكنَّ الثقة مهمة في عملي
Dialogue: 0,0:08:50.67,0:08:52.42,DCMain,HAMANAKA,0,0,0,,فلا تحقدوا عليّ فضلًا
Dialogue: 0,0:08:55.32,0:08:56.86,DCMain,HAMANAKA,0,0,0,,على رسلك
Dialogue: 0,0:08:56.86,0:09:01.83,DCMain,HAMANAKA,0,0,0,,لا تنسي أنني مستشار في روايات الجريمة وحسب
Dialogue: 0,0:09:01.83,0:09:04.69,DCMain,HAMANAKA,0,0,0,,كلّ ما أفعله أنني أبيع أفكارًا للروايات
Dialogue: 0,0:09:04.86,0:09:07.69,DCMain,HAMANAKA,0,0,0,,إذًا فأنا لا أرتكب أي جريمة
Dialogue: 0,0:09:07.88,0:09:09.69,DCMain,HAMANAKA,0,0,0,,تفهمين هذا، صحيح؟
Dialogue: 0,0:09:09.97,0:09:14.70,DCMain,HAMANAKA,0,0,0,,وأيضًا أنا لا أشجّع عملائي على ارتكاب الجرائم
Dialogue: 0,0:09:14.90,0:09:20.21,DCMain,HAMANAKA,0,0,0,,الخطط التي أمامكم من وحي الخيال وحسب
Dialogue: 0,0:09:20.21,0:09:28.38,DCMain,HAMANAKA,0,0,0,,الشخصيات والمنظمات والأسماء من وحي خيالي\N ولا علاقة لها بأشخاص أو أحداث حقيقية
Dialogue: 0,0:09:28.38,0:09:29.38,DCMain,KOGORO,0,0,0,,...لماذا
Dialogue: 0,0:09:29.59,0:09:35.63,DCMain,HAMANAKA,0,0,0,,باختصار، لا تستطيع الشرطة إدانتي
Dialogue: 0,0:09:46.63,0:09:47.35,DCMain,HAMANAKA,0,0,0,,ماذا؟
Dialogue: 0,0:09:47.74,0:09:51.61,DCMain,SATO,0,0,0,,هاماناكا ميساو، أنت رهن الاعتقال بتهمة التحريض
Dialogue: 0,0:09:53.66,0:09:59.22,DCMain,SATO,0,0,0,,مهما قلت فلن ينفعك ذلك، لأن خططك سببت جرائم حقيقية
Dialogue: 0,0:09:59.22,0:10:01.12,DCMain,SATO,0,0,0,,أنت متّهم بالتحريض
Dialogue: 0,0:10:01.12,0:10:02.99,DCMain,HAMANAKA,0,0,0,,...و- ولكن
Dialogue: 0,0:10:03.40,0:10:07.51,DCMain,SATO,0,0,0,,!هل كنتَ تعمل مستشارًا جنائيًا وأنت تجهل النتائج؟
Dialogue: 0,0:10:07.51,0:10:08.92,DCMain,HAMANAKA,0,0,0,,...حسنًا.. أنا
Dialogue: 0,0:10:09.15,0:10:10.54,DCMain,SATO,0,0,0,,!اعترف حالًا
Dialogue: 0,0:10:10.54,0:10:11.17,DCMain,HAMANAKA,0,0,0,,ماذا؟
Dialogue: 0,0:10:11.34,0:10:13.17,DCMain,SATO,0,0,0,,!اعترف بالجرائم التي تورّطت فيها
Dialogue: 0,0:10:13.57,0:10:15.80,DCMain,SATO,0,0,0,,!أخبرنا بكل الجرائم التي حرّضت عليها
Dialogue: 0,0:10:15.80,0:10:17.80,DCMain,HAMANAKA,0,0,0,,!لـ- لا شك في أنكِ تمزحين
Dialogue: 0,0:10:17.98,0:10:19.21,DCMain,SATO,0,0,0,,حقًا؟
Dialogue: 0,0:10:19.21,0:10:22.68,DCMain,SATO,0,0,0,,!إن لم تعاوننا الآن، فستندم
Dialogue: 0,0:10:23.64,0:10:28.35,DCMain,SATO,0,0,0,,معاملتك بعد الخروج من السجن، وشهادتك خلال المحاكمة\N والانطباع الذي سيأخذه عنك القاضي في جلسات الكفالة
Dialogue: 0,0:10:28.92,0:10:33.61,DCMain,SATO,0,0,0,,أنت على شفا حفرةٍ من أشياء \Nستحدد كيف ستكون حياتك من الآن فصاعدًا
Dialogue: 0,0:10:36.17,0:10:40.24,DCMain,KOGORO,0,0,0,,يا تاكاغاي، هل حقًا تحتاجون إلى مستشار؟
Dialogue: 0,0:10:40.24,0:10:41.87,DCMain,,0,0,0,,...نعم
Dialogue: 0,0:10:42.07,0:10:44.87,DCMain,SATO,0,0,0,,إذًا؟ ما قرارك؟
Dialogue: 0,0:10:45.74,0:10:47.37,DCMain,TAKAGI,0,0,0,,نُقل بنجاح
Dialogue: 0,0:10:48.01,0:10:50.11,DCMain,SATO,0,0,0,,عُلم، أجرِ نسخًا احتياطيًا
Dialogue: 0,0:10:50.11,0:10:50.87,DCMain,TAKAGI,0,0,0,,مفهوم
Dialogue: 0,0:10:51.86,0:10:54.27,DCMain,SATO,0,0,0,,جمعنا معلومات عن خمس قضايا
Dialogue: 0,0:10:54.27,0:10:59.13,DCMain,SATO,0,0,0,,ثلاثةٌ منها لم تُحل، واثنتان نحقق فيهما الآن
Dialogue: 0,0:10:59.46,0:11:03.76,DCMain,SATO,0,0,0,,وجدنا معلومات مفصّلة عن المشتبه \Nبهم والطُرق التي ارتكبوا بها الجرائم
Dialogue: 0,0:11:04.01,0:11:07.30,DCItalic,SATO,0,0,0,,وقد أرسل إليكم تاكاغي-كن المعلومات للتو
Dialogue: 0,0:11:07.30,0:11:08.65,DCMain,MEGURE,0,0,0,,عُلم
Dialogue: 0,0:11:08.65,0:11:13.02,DCMain,MEGURE,0,0,0,,!وصلتنا معلومات مفصّلة عن قضايا عدة لم تُحل بعد
Dialogue: 0,0:11:13.02,0:11:15.43,DCMain,MEGURE,0,0,0,,!وهذه فُرصة نادرة لنا
Dialogue: 0,0:11:15.43,0:11:19.03,DCMain,MEGURE,0,0,0,,!استدعوا جميع الضباط واعتقلوا المشتبه بهم
Dialogue: 0,0:11:19.40,0:11:21.44,DCMain,MEGURE,0,0,0,,!توجهوا جميعًا إلى مكان الجريمة
Dialogue: 0,0:11:21.44,0:11:22.03,DCMain,ALL,0,0,0,,!حاضر
Dialogue: 0,0:11:27.93,0:11:28.70,DCMain,POLICE,0,0,0,,!لا تتحركوا
Dialogue: 0,0:11:29.02,0:11:30.25,DCMain,CRIMINAL,0,0,0,,من أنتم؟
Dialogue: 0,0:11:30.52,0:11:32.67,DCMain,POLICE,0,0,0,,!عُثر على المشتبه بهم! اعتقلوهم
Dialogue: 0,0:11:33.06,0:11:34.42,DCMain,POLICE,0,0,0,,!اعتُقل المشتبه به
Dialogue: 0,0:11:37.67,0:11:39.17,DCMain,POLICE,0,0,0,,!اعتُقل المشتبه به
Dialogue: 0,0:11:42.57,0:11:43.56,DCMain,POLICE,0,0,0,,!اعتُقل المشتبه به
Dialogue: 0,0:11:47.47,0:11:48.68,DCMain,POLICE,0,0,0,,!اعتُقل المشتبه به
Dialogue: 0,0:11:51.64,0:11:52.53,DCMain,MEGURE,0,0,0,,!حسنًا
Dialogue: 0,0:11:53.40,0:11:55.56,DCMain,ALL,0,0,0,,!بقيت قضية واحدة
Dialogue: 0,0:11:56.38,0:11:59.07,DCMain,TAKAGI,0,0,0,,خطة انتقام إيشيغامي تاكاشي
Dialogue: 0,0:11:59.58,0:12:03.57,DCMain,TAKAGI,0,0,0,,اسم المشتبه به، وادا تاتسومي وعمره 48 عامًا وهو عَزَبْ
Dialogue: 0,0:12:03.94,0:12:06.61,DCMain,TAKAGI,0,0,0,,ارتكب ثلاث جرائم من قبل وهو عاطل عن العمل الآن
Dialogue: 0,0:12:06.61,0:12:09.20,DCMain,TAKAGI,0,0,0,,وقد أُطلق سراحه من السجن منذ مدة قصيرة
Dialogue: 0,0:12:09.51,0:12:12.50,DCMain,SATO,0,0,0,,سيرتكب الجريمة اليوم عند الساعة الرابعة مساءً
Dialogue: 0,0:12:12.50,0:12:16.08,DCMain,SATO,0,0,0,,!لم يبقَ لدينا وقتٌ كافٍ لأن الساعة تجاوزت الثالثة
Dialogue: 0,0:12:16.59,0:12:19.80,DCMain,CONAN,0,0,0,,الخطة من النسخة الكاملة لارتكاب جريمة قتل
Dialogue: 0,0:12:19.80,0:12:25.53,DCMain,CONAN,0,0,0,,باستخدام غاز بلا رائحة لتفجير المبنى برمّته
Dialogue: 0,0:12:25.53,0:12:27.22,DCMain,KOGORO,0,0,0,,تفجيرٌ بالغاز؟
Dialogue: 0,0:12:27.88,0:12:31.22,DCItalic,CONAN,0,0,0,,!يوجد مخطط يظهر جهاز التفجير عن بعد
Dialogue: 0,0:12:31.82,0:12:34.42,DCItalic,CONAN,0,0,0,,هل يخطط للتخلص من الدليل أيضًا؟
Dialogue: 0,0:12:34.42,0:12:40.19,DCMain,HAMANAKA,0,0,0,,كان إيشيغامي تاكاشي رئيس وادا في شركةٍ عمل فيها منذ 10 سنوات
Dialogue: 0,0:12:40.19,0:12:43.99,DCMain,HAMANAKA,0,0,0,,ويبدو أنه يحمّل نفسه ذنب فصل وادا من العمل
Dialogue: 0,0:12:44.33,0:12:49.24,DCMain,SATO,0,0,0,,اتجه ضباط الشرطة إلى منزل المشتبه به ومكتب الرجل المُستهدَف
Dialogue: 0,0:12:49.93,0:12:52.24,DCMain,SATO,0,0,0,,!يجب أن تُحلَّ القضية قريبًا
Dialogue: 0,0:12:54.06,0:12:55.12,DCMain,POLICE,0,0,0,,!نحن الشرطة
Dialogue: 0,0:12:58.75,0:12:59.95,DCMain,MEGURE,0,0,0,,!ماذا؟
Dialogue: 0,0:12:59.95,0:13:03.20,DCItalic,POLICE,0,0,0,,شقة وادا خالية، لم نجد المشتبه به
Dialogue: 0,0:13:03.20,0:13:06.18,DCMain,MEGURE,0,0,0,,!تبًا! راقب المكان جيدًا
Dialogue: 0,0:13:06.91,0:13:07.93,DCItalic,MEGURE,0,0,0,,ما الأخبار عندك؟
Dialogue: 0,0:13:08.40,0:13:11.40,DCMain,CHIBA,0,0,0,,لم نجد المشتبه به
Dialogue: 0,0:13:11.40,0:13:16.85,DCMain,CHIBA,0,0,0,,نحن نحمي إيشيغامي-سان حاليًا، إلا إننا لم نلحظ أي فعلٍ مريب
Dialogue: 0,0:13:17.19,0:13:21.48,DCMain,MEGURE,0,0,0,,يخطط المشتبه به وادا لتفجير المبنى بالغاز
Dialogue: 0,0:13:21.48,0:13:25.30,DCItalic,MEGURE,0,0,0,,ابحث في كل مكان عن أسطوانات غاز مخفية
Dialogue: 0,0:13:25.30,0:13:26.24,DCMain,CHIBA,0,0,0,,مفهوم
Dialogue: 0,0:13:28.04,0:13:29.66,DCItalic,MEGURE,0,0,0,,صارت الساعة 3:30
Dialogue: 0,0:13:30.17,0:13:34.66,DCItalic,MEGURE,0,0,0,,وَفقًا للخطة، فإن الكثير من الناس معرَّضون للخطر بسبب الانفجار
Dialogue: 0,0:13:34.92,0:13:37.63,DCItalic,MEGURE,0,0,0,,!يجب أن نجتهد وسعنا لمنع حدوثه
Dialogue: 0,0:13:38.81,0:13:40.42,DCMain,SATO,0,0,0,,مفهوم
Dialogue: 0,0:13:41.07,0:13:45.42,DCMain,SATO,0,0,0,,لم يوجد شيءٌ في مكتب إيشيغامي-سان
Dialogue: 0,0:13:45.75,0:13:47.43,DCMain,KOGORO,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:13:48.09,0:13:51.23,DCMain,TAKAGI,0,0,0,,يبدو أنه لم يقرر تنفيذ خطته بعد؟
Dialogue: 0,0:13:51.23,0:13:52.93,DCMain,SATO,0,0,0,,اليوم موعد تنفيذها
Dialogue: 0,0:13:53.40,0:13:56.77,DCMain,SATO,0,0,0,,!زد على ذلك أننا لم نحدد مكان المشتبه به بعد
Dialogue: 0,0:13:57.28,0:14:00.44,DCMain,SATO,0,0,0,,!لا أرى شيئًا يجعلنا نتفاءل
Dialogue: 0,0:14:00.93,0:14:04.69,DCItalic,CONAN,0,0,0,,أين هو؟ أين جهاز التفجير؟
Dialogue: 0,0:14:24.55,0:14:26.05,DCMain,SATO,0,0,0,,!الوقت ينفدُ منا
Dialogue: 0,0:14:26.20,0:14:29.30,DCMain,SATO,0,0,0,,!يجب أن نجد الأدلة من هنا وبسرعة
Dialogue: 0,0:14:29.47,0:14:37.18,DCMain,HAMANAKA,0,0,0,,قلت لكِ ما دام عملائي يتبعون تعليماتي \N بدقة فإنهم سيرتكبون جرائم كاملة
Dialogue: 0,0:14:37.75,0:14:41.25,DCMain,SATO,0,0,0,,تذكّر! فيمَ ناقشتَ وادا؟
Dialogue: 0,0:14:41.25,0:14:42.53,DCMain,HAMANAKA,0,0,0,,فيمَ ناقشته؟
Dialogue: 0,0:14:42.53,0:14:45.46,DCMain,SATO,0,0,0,,أخبرني بكل حرفٍ دار بينكما، مفهوم؟
Dialogue: 0,0:14:45.46,0:14:51.37,DCMain,HAMANAKA,0,0,0,,حـ- حاضر، لكنني تحدثتُ أكثر منه
Dialogue: 0,0:14:51.37,0:14:53.37,DCMain,SATO,0,0,0,,هل لاحظتَ شيئًا غريبًا منه؟
Dialogue: 0,0:14:53.37,0:14:55.27,DCMain,HAMANAKA,0,0,0,,غريب؟
Dialogue: 0,0:14:55.27,0:14:56.95,DCMain,HAMANAKA,0,0,0,,...أمّا وقد قلتِ هذا
Dialogue: 0,0:14:57.47,0:15:00.22,DCItalic,HAMANAKA,0,0,0,,لا شك في أنك أتيت إلى هنا لأنك تعلم هذا
Dialogue: 0,0:15:00.22,0:15:02.80,DCItalic,HAMANAKA,0,0,0,,يجب أن تصدّقني
Dialogue: 0,0:15:02.80,0:15:05.21,DCItalic,HAMANAKA,0,0,0,,...إذا اتبعت تعليماتي بدقّة
Dialogue: 0,0:15:05.69,0:15:10.34,DCItalic,WADA,0,0,0,,فسأرتكب الجريمة الكاملة، صحيح؟...
Dialogue: 0,0:15:10.67,0:15:14.28,DCMain,HAMANAKA,0,0,0,,تفاجأتُ بأنه يعرف جملتي الشهيرة
Dialogue: 0,0:15:14.28,0:15:19.31,DCMain,KOGORO,0,0,0,,أتى ليشتري إحدى خططك\N !فلا عجب في أن يعرف تلك الجملة
Dialogue: 0,0:15:19.31,0:15:21.85,DCMain,HAMANAKA,0,0,0,,لا أظن هذا
Dialogue: 0,0:15:22.25,0:15:28.22,DCMain,HAMANAKA,0,0,0,,تذكرت، قال إنه يريد أن يفجّر المبنى\N بنفسه عن بعد بدلًا من التفجير التلقائي
Dialogue: 0,0:15:28.22,0:15:31.86,DCMain,TAKAGI,0,0,0,,ربما يريد أن يحدد القتلى بالضبط ثم يفجّر المكان
Dialogue: 0,0:15:32.13,0:15:35.37,DCMain,SATO,0,0,0,,هل يكره ذلك الرجل لهذه الدرجة؟
Dialogue: 0,0:15:35.87,0:15:37.87,DCMain,TAKAGI,0,0,0,,لا شك في هذا
Dialogue: 0,0:15:42.41,0:15:46.71,DCMain,SATO,0,0,0,,اعترفَ وادا بأن إيشيغامي-سان هدفه، صحيح؟
Dialogue: 0,0:15:46.96,0:15:48.65,DCMain,HAMANAKA,0,0,0,,نعم
Dialogue: 0,0:15:48.65,0:15:52.01,DCMain,HAMANAKA,0,0,0,,أنا أكتب الخطة وَفقًا لطلب العميل
Dialogue: 0,0:15:52.28,0:15:56.35,DCMain,TAKAGI,0,0,0,,!إذًا فلا شك في أن إيشيغامي-سان هو الهدف
Dialogue: 0,0:15:56.35,0:16:01.80,DCMain,TAKAGI,0,0,0,,أليس من الأفضل أن نحرس الهدف وننتظر وصول المشتبه به؟
Dialogue: 0,0:16:02.30,0:16:06.78,DCItalic,CONAN,0,0,0,,...المحقق تاكاغي على حقّ، لكن في الأمر إنَّ
Dialogue: 0,0:16:07.99,0:16:09.60,DCItalic,CONAN,0,0,0,,!يبدو أنني سأفعلها
Dialogue: 0,0:16:17.77,0:16:20.29,DCMain,KOGORO,0,0,0,,...أنام فجأةً كالعادة
Dialogue: 0,0:16:20.29,0:16:21.79,DCMain,TAKAGI,0,0,0,,...هـ- هذا
Dialogue: 0,0:16:22.06,0:16:23.29,DCMain,SATO,0,0,0,,!كوغورو النائم
Dialogue: 0,0:16:23.75,0:16:27.04,DCMain,KOGORO,0,0,0,,...لدي بضعة أسئلة
Dialogue: 0,0:16:33.50,0:16:38.56,DCMain,KOGORO,0,0,0,,أولًا، لمَ زارك برأيك؟
Dialogue: 0,0:16:38.56,0:16:42.08,DCMain,HAMANAKA,0,0,0,,!لماذا؟ لأنني محترف بالطبع
Dialogue: 0,0:16:42.08,0:16:43.18,DCMain,CONAN,0,0,0,,ماذا؟
Dialogue: 0,0:16:43.18,0:16:45.23,DCMain,KOGORO,0,0,0,,طيب
Dialogue: 0,0:16:45.23,0:16:48.06,DCMain,KOGORO,0,0,0,,لنفترض أنه سمع بسيرتك العطرة في مكانٍ ما
Dialogue: 0,0:16:48.43,0:16:53.46,DCMain,KOGORO,0,0,0,,فهل لاحظت شيئًا غريبًا حين تحدّثت إليه؟
Dialogue: 0,0:16:53.46,0:16:55.82,DCMain,HAMANAKA,0,0,0,,لستُ متأكدًا
Dialogue: 0,0:16:56.16,0:16:58.80,DCMain,KOGORO,0,0,0,,يبدو لي الأمرُ غريبًا
Dialogue: 0,0:16:58.80,0:17:05.46,DCMain,KOGORO,0,0,0,,ربما سُرِّح من عمله لكن لماذا يخطط لجريمة قتل بهذه الدقة؟
Dialogue: 0,0:17:05.68,0:17:07.45,DCMain,TAKAGI,0,0,0,,!أصبت
Dialogue: 0,0:17:07.45,0:17:12.59,DCMain,TAKAGI,0,0,0,,قد تكره الشخص الذي تسبب \Nبفصلك من العمل لكن هذا ليس سببًا لتقتله
Dialogue: 0,0:17:13.13,0:17:15.55,DCMain,SATO,0,0,0,,وقد دفع الكثير من المال أيضًا
Dialogue: 0,0:17:15.55,0:17:16.64,DCMain,TAKAGI,0,0,0,,أجل
Dialogue: 0,0:17:16.64,0:17:18.52,DCMain,HAMANAKA,0,0,0,,هل أنتِ متأكدة؟
Dialogue: 0,0:17:18.52,0:17:19.10,DCMain,SATO,0,0,0,,ماذا؟
Dialogue: 0,0:17:19.61,0:17:22.72,DCMain,HAMANAKA,0,0,0,,أنا أكتب الخطط منذ مدة طويلة
Dialogue: 0,0:17:22.72,0:17:27.73,DCMain,HAMANAKA,0,0,0,,وأؤكد لكِ أن أفعال المجرمين لا يمكن توقّعها البتة
Dialogue: 0,0:17:27.73,0:17:31.97,DCMain,SATO,0,0,0,,منذ مدة طويلة؟! منذ متى تكتب الخطط؟
Dialogue: 0,0:17:31.97,0:17:38.07,DCMain,HAMANAKA,0,0,0,,مـ- منذ 10 سنوات على الأقل
Dialogue: 0,0:17:40.43,0:17:41.33,DCMain,TAKAGI,0,0,0,,كونان-كن؟
Dialogue: 0,0:17:41.68,0:17:43.08,DCMain,TAKAGI,0,0,0,,ما الأمر؟
Dialogue: 0,0:17:43.08,0:17:44.46,DCMain,SATO,0,0,0,,هل اكتشفتَ شيئًا؟
Dialogue: 0,0:17:44.46,0:17:45.58,DCItalic,CONAN,0,0,0,,!لا شك في ذلك
Dialogue: 0,0:17:46.24,0:17:48.23,DCItalic,CONAN,0,0,0,,...إذا صحَّ استنتاجي
Dialogue: 0,0:17:48.23,0:17:49.33,DCMain,TAKAGI,0,0,0,,كونان-كن؟
Dialogue: 0,0:17:50.17,0:17:51.60,DCMain,CONAN,0,0,0,,أين الحمام؟
Dialogue: 0,0:17:51.60,0:17:54.67,DCMain,HAMANAKA,0,0,0,,الحمام في نهاية الرواق
Dialogue: 0,0:17:54.67,0:17:55.84,DCMain,CONAN,0,0,0,,شكرًا
Dialogue: 0,0:17:56.85,0:17:58.06,DCMain,SATO,0,0,0,,لا وقت لدينا
Dialogue: 0,0:17:58.06,0:17:59.09,DCMain,TAKAGI,0,0,0,,!موري-سان
Dialogue: 0,0:17:59.52,0:18:05.66,DCMain,KOGORO,0,0,0,,هل تتذكر الخطط التي كتبتَها منذ سبع سنوات؟
Dialogue: 0,0:18:05.66,0:18:06.60,DCMain,HAMANAKA,0,0,0,,ماذا؟
Dialogue: 0,0:18:07.04,0:18:14.48,DCMain,KOGORO,0,0,0,,وَفقًا لردة فعلك، فقد نسيتَ عملية السطو التي وقعت في مثل \Nهذا اليوم منذ سبع سنوات والتي اعتُقل وادا تاتسومي بسببها
Dialogue: 0,0:18:14.73,0:18:15.42,DCMain,SATO,0,0,0,,ماذا؟
Dialogue: 0,0:18:15.42,0:18:19.79,DCMain,TAKAGI,0,0,0,,هل هاماناكا له علاقة باعتقال وادا؟
Dialogue: 0,0:18:20.86,0:18:22.26,DCMain,HAMANAKA,0,0,0,,!تذكرتُ الآن
Dialogue: 0,0:18:22.26,0:18:25.31,DCMain,HAMANAKA,0,0,0,,!هاجمَ بعض دائني السوق السوداء في مدينة بيكا
Dialogue: 0,0:18:25.31,0:18:26.49,DCMain,KOGORO,0,0,0,,صحيح
Dialogue: 0,0:18:27.69,0:18:31.63,DCMain,KOGORO,0,0,0,,إنها خطة السطو التي كتبتَها منذ سبع سنوات
Dialogue: 0,0:18:31.77,0:18:33.38,DCMain,TAKAGI,0,0,0,,...هـ- هل تعني
Dialogue: 0,0:18:33.38,0:18:38.13,DCMain,KOGORO,0,0,0,,وَفقًا لتقرير الشرطة، بعد أن هاجمَ دائني السوق السوداء
Dialogue: 0,0:18:38.60,0:18:48.89,DCMain,KOGORO,0,0,0,,التقطت كاميرات المركز التجاري ذات الكفاءة العالية \Nمسار الهروب والمركبة التي هرب بها ولوحة السيارة
Dialogue: 0,0:18:49.10,0:18:53.89,DCMain,KOGORO,0,0,0,,وكذلك التقطَت الكاميرات صورته
Dialogue: 0,0:18:54.55,0:18:59.78,DCMain,KOGORO,0,0,0,,كان ذلك خطأك لأنك لم تنتبه إلى المركز التجاري
Dialogue: 0,0:19:01.56,0:19:06.54,DCMain,KOGORO,0,0,0,,وقد حمّلك وادا ذنب اعتقاله
Dialogue: 0,0:19:07.56,0:19:11.54,DCMain,KOGORO,0,0,0,,وذنب كتابة تلك الخطة القذرة
Dialogue: 0,0:19:13.93,0:19:17.55,DCMain,HAMANAKA,0,0,0,,أصبت، إنه خطئي
Dialogue: 0,0:19:17.77,0:19:20.23,DCMain,KOGORO,0,0,0,,هذا ما حدث باختصار يا سادة
Dialogue: 0,0:19:20.23,0:19:23.74,DCMain,KOGORO,0,0,0,,انتهت عقوبة وادا تاتسومي وأُطلق سراحه من السجن منذ مدة
Dialogue: 0,0:19:23.74,0:19:27.56,DCMain,KOGORO,0,0,0,,ومنذ عدة أيام، زاركَ لأول مرة منذ سبع سنوات
Dialogue: 0,0:19:27.92,0:19:32.55,DCMain,KOGORO,0,0,0,,ومع ذلك، لم تتذكر عملية السرقة ولا حتى وادا نفسه
Dialogue: 0,0:19:33.03,0:19:36.07,DCMain,KOGORO,0,0,0,,ولهذا قرر الانتقام
Dialogue: 0,0:19:36.60,0:19:39.57,DCMain,KOGORO,0,0,0,,تذكَّرَ جملتك الشهيرة
Dialogue: 0,0:19:40.24,0:19:44.64,DCMain,KOGORO,0,0,0,,كان يفكر فيك كثيرًا
Dialogue: 0,0:19:44.64,0:19:45.70,DCMain,KOGORO,0,0,0,,...باختصار
Dialogue: 0,0:19:45.70,0:19:47.74,DCMain,SATO,0,0,0,,!الهدف ليس إيشيغامي-سان
Dialogue: 0,0:19:47.74,0:19:48.49,DCMain,KOGORO,0,0,0,,لا
Dialogue: 0,0:19:48.49,0:19:50.30,DCMain,KOGORO,0,0,0,,!أنت الهدف
Dialogue: 0,0:19:50.30,0:19:51.42,DCMain,HAMASAKI,0,0,0,,ماذا؟
Dialogue: 0,0:19:52.33,0:19:54.71,DCMain,TAKAGI,0,0,0,,...إ- إذًا فجهاز التفجير
Dialogue: 0,0:19:55.00,0:19:56.10,DCMain,KOGORO,0,0,0,,نعم
Dialogue: 0,0:19:56.10,0:19:59.25,DCMain,KOGORO,0,0,0,,جهاز التفجير هنا
Dialogue: 0,0:20:10.61,0:20:12.42,DCItalic,HAMASAKI,0,0,0,,مـ- مرحبًا؟
Dialogue: 0,0:20:12.42,0:20:15.86,DCMain,WADA,0,0,0,,هاماناكا، أنت تعلم من أنا صحيح؟
Dialogue: 0,0:20:16.48,0:20:18.57,DCItalic,HAMASAKI,0,0,0,,أنت وادا تاتسومي-سان
Dialogue: 0,0:20:18.57,0:20:21.74,DCMain,WADA,0,0,0,,هل تعلم لمَ اتصلتُ بك؟
Dialogue: 0,0:20:21.74,0:20:23.36,DCItalic,HAMASAKI,0,0,0,,...لـ- لا، أنا
Dialogue: 0,0:20:23.55,0:20:26.80,DCMain,WADA,0,0,0,,أردتُ أن أسمع صوتك مرّةً أخيرة
Dialogue: 0,0:20:26.80,0:20:28.87,DCItalic,HAMASAKI,0,0,0,,!ماذا؟! ا- انتظر
Dialogue: 0,0:20:30.81,0:20:33.04,DCMain,WADA,0,0,0,,!الوداع أيها المحتال
Dialogue: 0,0:20:37.20,0:20:39.58,DCMain,WADA,0,0,0,,تبًا! لمَ لم تنفجر؟
Dialogue: 0,0:20:40.15,0:20:42.80,DCMain,CONAN,0,0,0,,لن تنفجر يا وادا-سان
Dialogue: 0,0:20:43.77,0:20:44.59,DCMain,WADA,0,0,0,,من أنت؟
Dialogue: 0,0:20:45.18,0:20:47.90,DCMain,CONAN,0,0,0,,أغلقنا أنبوب الغاز وحسب
Dialogue: 0,0:20:47.90,0:20:51.85,DCMain,CONAN,0,0,0,,أما جهاز التفجير الذي ثبّته على منقّي الهواء، فقد أُزيل
Dialogue: 0,0:20:52.88,0:20:56.96,DCMain,CONAN,0,0,0,,اعتُقلت أولًا بسبب عملية سطو، صحيح؟
Dialogue: 0,0:20:56.96,0:21:02.61,DCMain,CONAN,0,0,0,,حين فحصتُ مدخل مكتب هاماساكي-سان\N وجدتُ علامات تثبت أن أحدهم فتح القفل
Dialogue: 0,0:21:02.99,0:21:07.87,DCMain,CONAN,0,0,0,,مع العلم أنك لم تجد سوى المكتب لتخبّئ فيه جهاز التفجير
Dialogue: 0,0:21:08.53,0:21:14.87,DCMain,CONAN,0,0,0,,لجعل انفجار الغاز أثقل من انفجار الهواء فيجب \Nأن يكون جهاز التفجير قريبًا من الأرض قدر الإمكان
Dialogue: 0,0:21:15.10,0:21:16.19,DCMain,WADA,0,0,0,,تبًا
Dialogue: 0,0:21:17.21,0:21:19.88,DCMain,WADA,0,0,0,,لكن كيف علمتَ أنني هنا؟
Dialogue: 0,0:21:20.15,0:21:26.18,DCMain,CONAN,0,0,0,,لأنك طلبت أن تتحكم بالانفجار\N بنفسك عن بعد بدلًا من التفجير التلقائي
Dialogue: 0,0:21:26.18,0:21:28.39,DCMain,CONAN,0,0,0,,هكذا أردت أن تنتقم
Dialogue: 0,0:21:28.78,0:21:32.47,DCMain,CONAN,0,0,0,,لذا توقعتُ أن تكون في مكانٍ ما لتشاهد الانفجار
Dialogue: 0,0:21:36.33,0:21:37.49,DCMain,WADA,0,0,0,,.أنا خسرت
Dialogue: 0,0:21:37.49,0:21:41.62,DCMain,SATO,0,0,0,,!وادا تاتسومي! أنت رهن الاعتقال بتهمة الشروع في القتل
Dialogue: 0,0:23:07.88,0:23:11.76,DCMain,TAKAGI,0,0,0,,!أحسنت يا موري-سان
Dialogue: 0,0:23:11.76,0:23:13.78,DCMain,KOGORO,0,0,0,,...كما تعلم
Dialogue: 0,0:23:14.78,0:23:19.33,DCMain,SATO,0,0,0,,!بفضلك استطعنا حلّ خمس قضايا دفعةً واحدة
Dialogue: 0,0:23:19.64,0:23:25.92,DCMain,TAKAGI,0,0,0,,في النهاية، تبيّن أن قضايا هاماساكي كانت نظريات وحسب
Dialogue: 0,0:23:25.92,0:23:26.98,DCMain,SATO,0,0,0,,أعلم
Dialogue: 0,0:23:26.98,0:23:31.34,DCMain,SATO,0,0,0,,إذا كانت ستخلّف الحقد عليك في\N قلوب الناس كي يقتلوك فهي مهنة سخيفة
Dialogue: 0,0:23:31.51,0:23:38.52,DCMain,KOGORO,0,0,0,,أظن أنه أسِفَ على نفسه لأنكما \Nاستعنتما بمستشارٍ محترفٍ مثلي
Dialogue: 0,0:23:41.07,0:23:43.29,DCMain,CONAN,0,0,0,,ماذا تظن نفسك؟
Dialogue: 0,0:23:45.89,0:23:48.03,DCMain,CONAN,0,0,0,,مطعم بوكشان؟
Dialogue: 0,0:23:49.88,0:23:52.85,DCMain,MAN,0,0,0,,!يبدو أنك فعلتها يا ذا القميص الأحمر القذر
Dialogue: 0,0:23:52.85,0:23:54.66,DCMain,WOMAN,0,0,0,,!أرجوك يا ياماراشي-سان
Dialogue: 0,0:23:55.01,0:23:57.79,DCMain,MAN,0,0,0,,!هل تشك في الرئيس؟! أنت أحمق
Dialogue: 0,0:23:58.04,0:24:01.54,DCMain,MAN,0,0,0,,!لن أغفر لك ما حييت
Dialogue: 0,0:24:01.74,0:24:06.04,DCMain,WOMAN,0,0,0,,عدالة السيد الشاب هي فرح وفخر العجوز كيو
Dialogue: 0,0:24:06.49,0:24:08.68,DCItalic,CONAN,0,0,0,,السيد الشاب؟ كيو؟
Dialogue: 0,0:24:30.84,0:24:32.71,DCMain,SATO,0,0,0,,!تلميح الحلقة القادمة من المحقق كونان
Dialogue: 0,0:24:34.99,0:24:36.69,DCMain,KOGORO,0,0,0,,{\fad(300,300)\an7\fs70\fnAsmaa Font\bord10\blur10\3c&HEE8973&\b1}...نحن في إجازة الأسبوع القادم وأيضًا
Dialogue: 0,0:24:36.69,0:24:39.76,DCMain,CONAN,0,0,0,,{\fad(300,300)\an7\fs70\fnAsmaa Font\bord10\blur10\3c&H8372EE&\b1}العرض الترويجي يوم الجمعة، ثم سنعود بعد أسبوعين
