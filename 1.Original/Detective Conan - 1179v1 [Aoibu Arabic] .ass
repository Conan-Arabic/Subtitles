Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)}Iy nasan & ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS & @Iy_ nasan\NX : @Theconansign
Dialogue: 0,0:00:01.50,0:00:06.40,Default,,0,0,0,,..جئتُ مع (ران) و(هاتوري) و(كازوها) وعمي (كوغورو)
Dialogue: 0,0:00:06.70,0:00:10.60,Default,,0,0,0,,"إلى جبل "واشيوا" لرؤية غروب الشمس باتجاه جبل "فوجي
Dialogue: 0,0:00:11.70,0:00:17.30,Default,,0,0,0,,وفجأة هطل علينا المطر\Nفاحتمينا بمعبد قريب
Dialogue: 0,0:00:19.10,0:00:29.20,Default,,0,0,0,,{\an8}وفي ذلك المعبد أخبرنا (كينتيتسو) بأن راهبًا يدعى (كانتاتسو) \Nاختفى وجوده بسبب أن الجمجمة القرمزية اختطفته
Dialogue: 0,0:00:30.70,0:00:33.90,Default,,0,0,0,,ومن ثم اختفى عمي الذي ذهب إلى الحمام
Dialogue: 0,0:00:34.90,0:00:37.20,Default,,0,0,0,,..الصرخة وال"هيتوداما" اللتان سمعناهما فجأة
Dialogue: 0,0:00:38.10,0:00:40.10,Default,,0,0,0,,..والجثة في غرفة التأديب
Dialogue: 0,0:00:40.80,0:00:43.70,Default,,0,0,0,,هل أسطورة الجمجمة القرمزية صحيحة؟
Dialogue: 0,0:00:47.94,0:00:50.18,Default,,0,0,0,,مالذي تخفيه خلف قناعك المحطم؟
Dialogue: 0,0:00:50.18,0:00:52.22,Default,,0,0,0,,!اختفى كوغورو فجأة، ليظهر اللهب الروحي في المكان
Dialogue: 0,0:00:52.22,0:00:54.53,Default,,0,0,0,,إلى أين ستقوده مشاعر هيجي ومهارته في التحري؟
Dialogue: 0,0:00:54.53,0:00:56.29,Default,,0,0,0,,يسعى وراء الحقيقة دائما 
Dialogue: 0,0:00:56.29,0:00:57.95,Default,,0,0,0,,،بجسد طفل وعقل بالغ
Dialogue: 0,0:00:57.95,0:01:00.68,Default,,0,0,0,,!أسمه المحقق كونان
Dialogue: 0,0:02:42.27,0:02:45.83,Default,,0,0,0,,"جمجمة جبل واشيو القرمزية - الجزء الثاني"
Dialogue: 0,0:02:55.30,0:02:56.80,Default,,0,0,0,,أبي
Dialogue: 0,0:02:56.80,0:02:58.20,Default,,0,0,0,,أيها العم
Dialogue: 0,0:02:59.30,0:03:00.50,Default,,0,0,0,,أين أنت؟
Dialogue: 0,0:03:01.00,0:03:02.70,Default,,0,0,0,,أبي
Dialogue: 0,0:03:13.10,0:03:17.40,Default,,0,0,0,,بالمناسبة, هل عثرت على تميمتك؟
Dialogue: 0,0:03:17.42,0:03:19.90,Default,,0,0,0,,أجل, لقد كانت ملقاة في غرفة التأديب
Dialogue: 0,0:03:21.07,0:03:22.90,Default,,0,0,0,,في تلك الغرفة حيث وجدنا الجثة؟
Dialogue: 0,0:03:23.30,0:03:24.20,Default,,0,0,0,,..وأيضًا
Dialogue: 0,0:03:24.80,0:03:29.40,Default,,0,0,0,,لقد كانت ساقطة كخط رفيع بهذا الشكل
Dialogue: 0,0:03:30.30,0:03:33.50,Default,,0,0,0,,وبسبب ذلك لم انتبه لوجودها حتى دستُ عليها
Dialogue: 0,0:03:35.20,0:03:36.30,Default,,0,0,0,,لقد اسودّت قليلًا
Dialogue: 0,0:03:36.88,0:03:37.46,Default,,0,0,0,,لمَ؟
Dialogue: 0,0:03:38.46,0:03:40.46,Default,,0,0,0,,أليس لأنك دستَ عليها بقدمك؟
Dialogue: 0,0:03:40.96,0:03:45.46,Default,,0,0,0,,لقد كنتُ أتسائل منذ فترة, جاربك متسخ من الخلف
Dialogue: 0,0:03:47.36,0:03:49.26,Default,,0,0,0,,إن كان كذلك فأنت أيضًا
Dialogue: 0,0:03:50.06,0:03:51.16,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:03:52.06,0:03:52.86,Default,,0,0,0,,..ولكن أين
Dialogue: 0,0:03:53.56,0:03:55.16,Default,,0,0,0,,..قد يسودّ هكذا؟
Dialogue: 0,0:03:58.36,0:03:59.06,Default,,0,0,0,,!في ذاك الوقت
Dialogue: 0,0:03:59.56,0:04:02.36,Default,,0,0,0,,!عندما طاردنا "الهيتوداما" صاعدين الدرج
Dialogue: 0,0:04:15.96,0:04:16.66,Default,,0,0,0,,رسالة؟
Dialogue: 0,0:04:18.00,0:04:18.80,Default,,0,0,0,,إنها من العم
Dialogue: 0,0:04:19.30,0:04:19.96,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:04:20.46,0:04:21.86,Default,,0,0,0,,..الرسالة فارغة ولكن
Dialogue: 0,0:04:22.26,0:04:23.72,Default,,0,0,0,,لقد أرسل صورة
Dialogue: 0,0:04:24.92,0:04:26.42,Default,,0,0,0,,!هـ هذا
Dialogue: 0,0:04:28.32,0:04:29.02,Default,,0,0,0,,لا فائدة
Dialogue: 0,0:04:29.82,0:04:31.62,Default,,0,0,0,,أبي ليس موجودًا في أي مكان
Dialogue: 0,0:04:33.62,0:04:35.32,Default,,0,0,0,,في أي مكان
Dialogue: 0,0:04:37.72,0:04:38.42,Default,,0,0,0,,(ران)
Dialogue: 0,0:04:40.72,0:04:44.02,Default,,0,0,0,,لابد أن الجمجمة القرمزية أكلته
Dialogue: 0,0:04:45.42,0:04:48.12,Default,,0,0,0,,ألم يقل (كونان) أن لا وجود لشيء كهذا؟
Dialogue: 0,0:04:48.70,0:04:49.40,Default,,0,0,0,,(كازوها)
Dialogue: 0,0:04:50.10,0:04:50.70,Default,,0,0,0,,(هيجي)
Dialogue: 0,0:04:51.90,0:04:55.30,Default,,0,0,0,,لقد أحضرتِ معك جهاز لوحي صحيح؟
Dialogue: 0,0:04:56.00,0:04:57.10,Default,,0,0,0,,نعم
Dialogue: 0,0:04:57.30,0:04:59.60,Default,,0,0,0,,أظن أنه بداخل حقيبتي
Dialogue: 0,0:05:00.38,0:05:01.88,Default,,0,0,0,,سأستعيره قليلًا
Dialogue: 0,0:05:05.98,0:05:07.88,Default,,0,0,0,,(ران) كل شيء على ما يرام
Dialogue: 0,0:05:08.88,0:05:11.38,Default,,0,0,0,,والدك يا(ران) سيُعثر عليه بلا شك
Dialogue: 0,0:05:12.78,0:05:14.58,Default,,0,0,0,,لقد كان (هيجي) يلمع
Dialogue: 0,0:05:15.08,0:05:17.18,Default,,0,0,0,, فأكثر ما أحب
Dialogue: 0,0:05:21.68,0:05:24.58,Default,,0,0,0,,هو وجهه عندما يحل كل الغموض
Dialogue: 0,0:05:37.00,0:05:39.80,Default,,0,0,0,,أتقول أنك كشفت ملابسات القضية؟
Dialogue: 0,0:05:39.80,0:05:40.40,Default,,0,0,0,,أجل
Dialogue: 0,0:05:41.00,0:05:42.20,Default,,0,0,0,,كشفتها كلها
Dialogue: 0,0:05:43.00,0:05:45.80,Default,,0,0,0,,ظاهرة تسلق "الهيتوداما" للدرج
Dialogue: 0,0:05:46.20,0:05:52.80,Default,,0,0,0,,والسبب الذي جعل جثة السيد (كانتيتسو)\N تظهر فجأة في غرفة التأديب الموجودة أعلى الدرج
Dialogue: 0,0:05:53.40,0:06:00.36,Default,,0,0,0,,وأخيرًا, العم من مكتب التحقيق الذي اختفى فجأة\Nوما المكان الذي قد يكون محتجز به الآن
Dialogue: 0,0:06:02.06,0:06:05.66,Default,,0,0,0,,هل تريد أن تقول أن هذه جميعها سببها أحد ما؟
Dialogue: 0,0:06:05.66,0:06:09.26,Default,,0,0,0,,ولكني رأيت "الهيتوداما" من قبل أيضًا
Dialogue: 0,0:06:10.16,0:06:12.16,Default,,0,0,0,,شيء كهذا لا يبدو أنه من فعل البشر
Dialogue: 0,0:06:13.96,0:06:19.66,Default,,0,0,0,,طبعًا إن كنا سنعيد تمثيل الظاهرة\Nفلن نستطيع دون مساعدته
Dialogue: 0,0:06:25.56,0:06:30.96,Default,,0,0,0,,يا (هيجي) هل الشخص الذي تقصده بـ"مساعدته" والد (ران)؟
Dialogue: 0,0:06:31.86,0:06:32.56,Default,,0,0,0,,كلا كلا
Dialogue: 0,0:06:36.86,0:06:39.16,Default,,0,0,0,,ألن تقوما بعرض استنتاجتكما سوية؟
Dialogue: 0,0:06:39.66,0:06:40.26,Default,,0,0,0,,لا
Dialogue: 0,0:06:40.26,0:06:44.36,Default,,0,0,0,,من قصدتُ بكلامي هو من ذكرناه بحديثنا عدة مرات
Dialogue: 0,0:06:51.76,0:06:53.36,Default,,0,0,0,,!"السيد "الجمجمة القرمزية
Dialogue: 0,0:06:56.16,0:06:57.96,Default,,0,0,0,,!أتت
Dialogue: 0,0:07:08.09,0:07:11.09,Default,,0,0,0,,طبعًا تلك كذبة, إنها مجرد خدعة
Dialogue: 0,0:07:12.80,0:07:14.39,Default,,0,0,0,,أليس كذلك؟ أيها الولد
Dialogue: 0,0:07:15.49,0:07:16.19,Default,,0,0,0,,نعم
Dialogue: 0,0:07:17.00,0:07:17.99,Default,,0,0,0,,(كونان)
Dialogue: 0,0:07:18.39,0:07:20.39,Default,,0,0,0,,هذه "الهيتوداما" (كونان) من صنعها؟
Dialogue: 0,0:07:20.99,0:07:21.79,Default,,0,0,0,,هذا صحيح
Dialogue: 0,0:07:22.79,0:07:28.59,Default,,0,0,0,,بورقة "الهانشي" المطوية هذه\Nومُشعل نار كالذي نستخدمه في التخييم
Dialogue: 0,0:07:28.59,0:07:30.99,Default,,0,0,0,,تصبح خدعة سهلة الصنع
Dialogue: 0,0:07:31.49,0:07:32.29,Default,,0,0,0,,.."هانشي"
Dialogue: 0,0:07:32.69,0:07:33.59,Default,,0,0,0,,ومُشعل نار؟
Dialogue: 0,0:07:36.33,0:07:39.25,Default,,0,0,0,,إذًا, سنقوم بإعدادها من جديد
Dialogue: 0,0:07:40.43,0:07:47.13,Default,,0,0,0,,"أولًا, سنقوم بوضع لاصق في نهاية ورق "الهانشي\Nوعندما نلصقها بشكل دائري نضعها على الأرض
Dialogue: 0,0:07:47.83,0:07:50.33,Default,,0,0,0,,وعندما نشعلها بمُشعل النار
Dialogue: 0,0:07:53.53,0:07:58.93,Default,,0,0,0,,وبتدفئة الهواء المحيط بها\N"يصبح لدينا مايسمى بـ"التيار الهوائي الصاعد
Dialogue: 0,0:07:59.47,0:08:00.18,Default,,0,0,0,,ومن ثم
Dialogue: 0,0:08:03.38,0:08:06.08,Default,,0,0,0,,يصبح الرماد المحترق المتبقي خفيف للغاية
Dialogue: 0,0:08:06.58,0:08:08.78,Default,,0,0,0,,..فيقوم التيار الهوائي الصاعد
Dialogue: 0,0:08:09.28,0:08:12.38,Default,,0,0,0,,بحملها معه عاليًا أثناء احتراقه
Dialogue: 0,0:08:12.78,0:08:13.70,Default,,0,0,0,,!أنت محق
Dialogue: 0,0:08:13.98,0:08:15.20,Default,,0,0,0,,!مدهش
Dialogue: 0,0:08:15.80,0:08:21.20,Default,,0,0,0,,وعلى هذا فإن المجرم قام برص ورق "الهانشي" على الدرج
Dialogue: 0,0:08:21.90,0:08:23.60,Default,,0,0,0,,قام برصها؟
Dialogue: 0,0:08:23.90,0:08:24.30,Default,,0,0,0,,نعم
Dialogue: 0,0:08:25.30,0:08:31.30,Default,,0,0,0,,قام المجرم بإشعال هذه اللفافات\N بمُشعل النار أثناء صعوده للأعلى
Dialogue: 0,0:08:31.80,0:08:36.50,Default,,0,0,0,,لتحترق اللفافات بالترتيب بدءًا من أسفل الدرج
Dialogue: 0,0:08:37.60,0:08:42.00,Default,,0,0,0,,لتبدو وكأن "الهيتوداما" تصعد الدرج
Dialogue: 0,0:08:43.02,0:08:46.90,Default,,0,0,0,,ولكن إن كان كذلك فمن المفترض أن يبقى الرماد على الدرج
Dialogue: 0,0:08:47.50,0:08:50.10,Default,,0,0,0,,فحتى ما احترق الآن بقي أثره هنا
Dialogue: 0,0:08:50.30,0:08:50.90,Default,,0,0,0,,أنت محق
Dialogue: 0,0:08:51.80,0:08:57.70,Default,,0,0,0,,أنا أيضًا عندما طاردت "الهيتوداما" على الدرج\N ..سابقًا قمتُ بالدوس عليها لذا
Dialogue: 0,0:08:58.00,0:08:59.60,Default,,0,0,0,,انظر! إنها سوداء
Dialogue: 0,0:09:01.41,0:09:05.08,Default,,0,0,0,,..بعد ذلك قام السيد (كينتيتسو) بإسقاط الدلو لذا
Dialogue: 0,0:09:10.68,0:09:13.88,Default,,0,0,0,,غُسل ماتبقى من الرماد بالماء فلم يتبقى شيء 
Dialogue: 0,0:09:14.48,0:09:18.88,Default,,0,0,0,,لايُعقل! (كينتيتسو) هل قمت بإسقاط الدلو لتمحو الدليل؟
Dialogue: 0,0:09:19.58,0:09:21.88,Default,,0,0,0,,!لا! لقد تزحلقتُ حقًا
Dialogue: 0,0:09:22.48,0:09:32.28,Default,,0,0,0,,أو أن المجرم قام بوضع الدلو بذاك المكان متعمدًا\Nليقوم أحدهم بالتزحلق وإسقاطه
Dialogue: 0,0:09:33.88,0:09:37.98,Default,,0,0,0,,إنه استنتاج مثير للإهتمام ولكن هناك ثغرة كبيرة به
Dialogue: 0,0:09:39.48,0:09:46.88,Default,,0,0,0,,بحسب كلامك فهو قام بإشعال النار \Nأثناء صعوده الدرج ولكن أين اختفى بعد ذلك؟
Dialogue: 0,0:09:47.28,0:09:52.08,Default,,0,0,0,,فعند صعودنا لغرفة التأديب سابقًا\Nلم يكن هناك أي شئ ياستثناء جثة (كانتاتسو)
Dialogue: 0,0:09:52.08,0:09:58.18,Default,,0,0,0,,ربما كانت الخدعة التي أعددتماها \Nتؤدي الغرض بالفعل ولكن هذا لا يكفي
Dialogue: 0,0:09:58.38,0:10:00.18,Default,,0,0,0,,كلا أيها الراهب
Dialogue: 0,0:10:01.48,0:10:05.68,Default,,0,0,0,,بالعكس فحل خدعة "الهيتوداما" جعلني أتأكد
Dialogue: 0,0:10:06.39,0:10:14.28,Default,,0,0,0,,عدم وجود شيء عدى الجثة في الغرفة في \Nذاك الوقت معناه وجود غرفة مخفية هناك
Dialogue: 0,0:10:14.78,0:10:15.68,Default,,0,0,0,,غرفة مخفية؟
Dialogue: 0,0:10:17.68,0:10:19.78,Default,,0,0,0,,داخل غرفة التأديب؟
Dialogue: 0,0:10:19.78,0:10:20.78,Default,,0,0,0,,صحيح
Dialogue: 0,0:10:21.28,0:10:26.98,Default,,0,0,0,,بعد أن أشعل المجرم النار أثناء صعوده\N على الدرج اختبئ في الغرفة المخفية
Dialogue: 0,0:10:27.58,0:10:30.48,Default,,0,0,0,,فتميمتي التي أضعتها كانت ملقاة أيضًا
Dialogue: 0,0:10:31.08,0:10:32.58,Default,,0,0,0,,عثرت على تميمتك؟
Dialogue: 0,0:10:33.18,0:10:34.88,Default,,0,0,0,,داخل الغرفة المخفية؟
Dialogue: 0,0:10:35.18,0:10:36.08,Default,,0,0,0,,كلا كلا
Dialogue: 0,0:10:36.97,0:10:42.76,Default,,0,0,0,,بل على الأرضية أمام الغرفة المخفية \Nبوضع كان الخيط فيه ممتدًا على خط واحد
Dialogue: 0,0:10:43.30,0:10:50.36,Default,,0,0,0,,بالعادة إن وجدت شيئًا بخيط ملقى فالأرض\Nيكون بهذا الشكل عشوائي غير مرتب صحيح؟
Dialogue: 0,0:10:51.06,0:10:54.26,Default,,0,0,0,,..فإن كان الخيط مستقيمًا فهذا معناه
Dialogue: 0,0:10:55.26,0:11:00.76,Default,,0,0,0,,أن هناك شيء ما دفعه ليجعله مستقيمًا بهذه الطريقة
Dialogue: 0,0:11:01.16,0:11:03.56,Default,,0,0,0,,شيئ ما دفعه وجعله مستقيمًا..؟
Dialogue: 0,0:11:03.96,0:11:04.66,Default,,0,0,0,,..وهذا يكون
Dialogue: 0,0:11:06.16,0:11:07.46,Default,,0,0,0,,!الباب
Dialogue: 0,0:11:07.46,0:11:10.16,Default,,0,0,0,,!قام الباب بدفعه فأصبح مستقيمًا
Dialogue: 0,0:11:10.96,0:11:13.86,Default,,0,0,0,,!لا يعقل وجود باب في تلك الغرفة
Dialogue: 0,0:11:14.06,0:11:17.66,Default,,0,0,0,,إن كنت محقًا فتعال لنر ونتحقق بأنفسنا
Dialogue: 0,0:11:26.56,0:11:29.26,Default,,0,0,0,,هناك رماد متساقط فاحذروا
Dialogue: 0,0:11:39.06,0:11:43.86,Default,,0,0,0,,والآن أين الباب الذي تقولون أنه يؤدي لغرفة مخفية؟
Dialogue: 0,0:11:44.46,0:11:49.96,Default,,0,0,0,,لم نكن نعرف مكان الباب لأننا لم نكن نعلم كيفية فتجه
Dialogue: 0,0:11:50.46,0:11:51.76,Default,,0,0,0,,أختي (كازوها)
Dialogue: 0,0:11:53.06,0:11:56.76,Default,,0,0,0,,لم تعتقدين أن تميمة أخي (هيجي) سقطت هنا؟
Dialogue: 0,0:11:57.96,0:11:58.96,Default,,0,0,0,,لمَ ياترى؟
Dialogue: 0,0:11:59.26,0:12:03.93,Default,,0,0,0,,لأن المجرم كان يحمل شيئًا معينًا جعلها تلتصق به حتى هنا
Dialogue: 0,0:12:03.95,0:12:05.77,Default,,0,0,0,,مثل ماذا؟
Dialogue: 0,0:12:06.65,0:12:10.06,Default,,0,0,0,,هناك شيء داخل تميمة الحظ، أليس كذلك؟
Dialogue: 0,0:12:10.93,0:12:12.50,Default,,0,0,0,,.سلسلة معدنية
Dialogue: 0,0:12:12.50,0:12:16.51,Default,,0,0,0,,.لقد قُيدت أنا وهيجي معًا بالسلاسل عندما كنا أطفالًا. لقد كانت كارثة
Dialogue: 0,0:12:16.51,0:12:19.38,Default,,0,0,0,,.قطعة من تلك السلسلة موجودة بداخلها
Dialogue: 0,0:12:19.87,0:12:22.30,Default,,0,0,0,,.وعلقت بشيء ما
Dialogue: 0,0:12:22.30,0:12:24.22,Default,,0,0,0,,أيمكن أن يكون مغناطيسًا؟
Dialogue: 0,0:12:24.49,0:12:25.77,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:12:25.77,0:12:28.59,Default,,0,0,0,,من أجل فتح وإغلاق الباب السري
Dialogue: 0,0:12:28.59,0:12:32.98,Default,,0,0,0,,.وضع الجاني مغناطيسًا في كمه وحمله معه
Dialogue: 0,0:12:33.53,0:12:38.06,Default,,0,0,0,,.علقت تميمة حظي بذلك المغناطيس، وأخذها معه
Dialogue: 0,0:12:38.91,0:12:41.99,Default,,0,0,0,,.الجاني أتى إلى هنا دون أن يلاحظ ذلك
Dialogue: 0,0:12:41.99,0:12:47.80,Default,,0,0,0,,عندما أخرج المغناطيس لفتح باب الغرفة السرية
Dialogue: 0,0:12:47.80,0:12:51.76,Default,,0,0,0,,.سقطت تميمة الحظ الخاصة بي على الأرض
Dialogue: 0,0:12:52.13,0:12:58.49,Default,,0,0,0,,ولكن ألن يجد شخص ما أنه من المشبوه أن يحمل شخص مغناطيسًا معه طوال الوقت؟
Dialogue: 0,0:12:58.49,0:13:04.39,Default,,0,0,0,,.لتجنب ذلك، خدع الجميع بتغيير هيئته ليشبه شيئًا آخر
Dialogue: 0,0:13:04.39,0:13:08.99,Default,,0,0,0,,.هذا صحيح. شيء يحمله الرهبان معهم دائمًا
Dialogue: 0,0:13:08.99,0:13:10.47,Default,,0,0,0,,.مسبحتهم
Dialogue: 0,0:13:12.66,0:13:16.06,Default,,0,0,0,,تميمة الحظ لم تكن بإمكانها أن تعلق بالمغناطيس في كمه إلا
Dialogue: 0,0:13:16.06,0:13:19.65,Default,,0,0,0,,.في الفترة بين إخراجها من المجفف وإحضارها إلى هنا
Dialogue: 0,0:13:19.65,0:13:20.65,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:13:21.19,0:13:26.66,Default,,0,0,0,,الجاني الذي حبس السيد كانتيتسو في الغرفة السرية وقتله
Dialogue: 0,0:13:29.66,0:13:32.43,Default,,0,0,0,,...لا يمكن أن يكون سواك
Dialogue: 0,0:13:39.21,0:13:40.35,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:13:40.35,0:13:45.61,Default,,0,0,0,,الجاني الذي حبس السيد كانتيتسو في الغرفة السرية وقتله
Dialogue: 0,0:13:45.61,0:13:48.01,Default,,0,0,0,,لا يمكن أن يكون سواك
Dialogue: 0,0:13:48.01,0:13:50.02,Default,,0,0,0,,.يا سيد تونتيتسو
Dialogue: 0,0:13:52.52,0:13:54.41,Default,,0,0,0,,تـ-تونتيتسو هو الفاعل؟
Dialogue: 0,0:13:54.41,0:13:56.64,Default,,0,0,0,,هل هذا صحيح، تونتيتسو؟
Dialogue: 0,0:13:56.64,0:13:58.25,Default,,0,0,0,,...لـ-لا
Dialogue: 0,0:13:58.25,0:14:03.31,Default,,0,0,0,,أتتذكر ما قلته عندما أخرجت ملابسنا من المجفف
Dialogue: 0,0:14:03.31,0:14:04.98,Default,,0,0,0,,وأحضرتها إلينا؟
Dialogue: 0,0:14:05.66,0:14:08.37,Default,,0,0,0,,.اعتقدت أنني وضعتها في السلة
Dialogue: 0,0:14:09.03,0:14:12.20,Default,,0,0,0,,.لكن تميمة الحظ الخاصة بي كانت مفقودة
Dialogue: 0,0:14:12.20,0:14:16.45,Default,,0,0,0,,التفسير الوحيد هو أنها علقت بالمغناطيس في كمك
Dialogue: 0,0:14:16.45,0:14:19.61,Default,,0,0,0,,.أثناء إحضارك إياها لي
Dialogue: 0,0:14:19.61,0:14:22.92,Default,,0,0,0,,.لـ-ليس لدي أي مغناطيس
Dialogue: 0,0:14:22.92,0:14:24.95,Default,,0,0,0,,.لا تظاهر بالجهل
Dialogue: 0,0:14:24.95,0:14:29.05,Default,,0,0,0,,.كانت لديك المسبحة عندما صليت أمام تمثال بوذي سابقًا
Dialogue: 0,0:14:29.05,0:14:32.81,Default,,0,0,0,,.إحدى حباتها كانت بارزة وتلتصق بالباقي مثل المغناطيس
Dialogue: 0,0:14:34.06,0:14:37.75,Default,,0,0,0,,ولكن لماذا قد يقتل تونتيتسو كانتيتسو؟
Dialogue: 0,0:14:39.07,0:14:42.47,Default,,0,0,0,,على الأرجح لأن باب الغرفة السرية
Dialogue: 0,0:14:42.47,0:14:48.94,Default,,0,0,0,,لم يكن مغلقًا بشكل صحيح عندما أُرسل السيد كانتيتسو إلى هذه الغرفة
Dialogue: 0,0:14:49.29,0:14:50.95,Default,,0,0,0,,...لذلك لاحظ
Dialogue: 0,0:14:52.06,0:14:55.71,Default,,0,0,0,,.كل تماثيل بوذا المنحوتة في الغرفة
Dialogue: 0,0:14:55.71,0:14:59.52,Default,,0,0,0,,!هـ-هذه هي تماثيل كانون التابعة للمعبد
Dialogue: 0,0:14:59.52,0:15:01.46,Default,,0,0,0,,لماذا هناك الكثير منها؟
Dialogue: 0,0:15:01.81,0:15:07.85,Default,,0,0,0,,.لقد بحثت في الأمر، يبدو أنه كان يصنع نسخًا طبق الأصل ويبيعها عبر الإنترنت
Dialogue: 0,0:15:07.85,0:15:08.97,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:09.55,0:15:11.47,Default,,0,0,0,,من المرجح أنه أحضر التمثال الحقيقي
Dialogue: 0,0:15:11.47,0:15:15.92,Default,,0,0,0,,.إلى الغرفة وكان يستخدمه كقالب، ينحتهم ليلة تلو الأخرى
Dialogue: 0,0:15:15.92,0:15:22.23,Default,,0,0,0,,...نظرًا لأنه حصل على تقييمات جيدة من زبائنه، ربما اعتقد
Dialogue: 0,0:15:22.77,0:15:26.24,Default,,0,0,0,,.أن لا أحد سيلاحظ إذا عرض واحد كالتمثال الحقيقي
Dialogue: 0,0:15:27.29,0:15:28.87,Default,,0,0,0,,...تقصد
Dialogue: 0,0:15:29.22,0:15:34.25,Default,,0,0,0,,.هذا صحيح. التمثال المعروض الآن هو أحد نسخ السيد تونتيتسو المقلدة
Dialogue: 0,0:15:34.25,0:15:39.00,Default,,0,0,0,,...ولكن باحث تماثيل بوذا، موراتا، اكتشف الحقيقة
Dialogue: 0,0:15:42.00,0:15:46.76,Default,,0,0,0,,بعد أن حبسه في الغرفة السرية وتركه يجوع وفقًا للأسطورة
Dialogue: 0,0:15:47.04,0:15:50.01,Default,,0,0,0,,انتظر حتى يمر أحد السائحين
Dialogue: 0,0:15:50.01,0:15:55.15,Default,,0,0,0,,.وأشعل النار في الجثة، وألقى بها عند قمة الدرج الحجري في الغابة
Dialogue: 0,0:15:55.56,0:16:00.06,Default,,0,0,0,,وبما أن خدعة اللهب الروحي التي استخدمها نجحت بشكل جيد
Dialogue: 0,0:16:00.06,0:16:06.07,Default,,0,0,0,,استخدم نفس الخدعة عندما حبس السيد كانتيتسو لاكتشافه الغرفة السرية
Dialogue: 0,0:16:06.58,0:16:09.95,Default,,0,0,0,,.ليجعل الأمر يبدو وكأنها أسطورة الجمجمة القرمزية
Dialogue: 0,0:16:11.14,0:16:15.04,Default,,0,0,0,,هذه المرة، فكرت في جعلنا شهودًا
Dialogue: 0,0:16:15.77,0:16:18.46,Default,,0,0,0,,لذلك أطلقت صرخة مروعة
Dialogue: 0,0:16:18.90,0:16:22.61,Default,,0,0,0,,.واستخدمت خدعة اللهب الروحي لجذبنا إلى هنا
Dialogue: 0,0:16:22.61,0:16:25.35,Default,,0,0,0,,بينما كنا منشغلين بالجثة
Dialogue: 0,0:16:25.35,0:16:30.52,Default,,0,0,0,,.ثم غادرت الغرفة السرية وتسَللت خلفنا
Dialogue: 0,0:16:31.47,0:16:33.65,Default,,0,0,0,,ولكن لماذا اختطف أبي؟
Dialogue: 0,0:16:33.65,0:16:38.52,Default,,0,0,0,,.عندما فتح السيد تونتيتسو باب الغرفة السرية، سقطت حبته المغناطيسية
Dialogue: 0,0:16:40.67,0:16:44.62,Default,,0,0,0,,سقطت على الدرج وعثر عليها المسن
Dialogue: 0,0:16:44.62,0:16:47.31,Default,,0,0,0,,.الذي خرج من الحمام حينها
Dialogue: 0,0:16:49.52,0:16:55.41,Default,,0,0,0,,تركتك تتفوه بما تريد، ولكن أين هذه الغرفة السرية؟
Dialogue: 0,0:16:55.69,0:16:59.91,Default,,0,0,0,,.أستطيع أن أقول من نظرة عينيك أنك لا تعتقد أن لدي مغناطيس
Dialogue: 0,0:17:01.74,0:17:03.89,Default,,0,0,0,,...بالجهاز اللوحي مثل هذه
Dialogue: 0,0:17:04.57,0:17:07.92,Default,,0,0,0,,...من أجل تركيب لوحة المفاتيح القابلة للإزالة
Dialogue: 0,0:17:11.93,0:17:14.93,Default,,0,0,0,,.فالحافة مغناطيسية
Dialogue: 0,0:17:16.44,0:17:20.45,Default,,0,0,0,,.عندما تنزلق المغناطيس، ينزلق القفل معه
Dialogue: 0,0:17:20.45,0:17:22.19,Default,,0,0,0,,.هذا بسيط
Dialogue: 0,0:17:29.53,0:17:30.77,Default,,0,0,0,,!لقد هرب
Dialogue: 0,0:17:30.77,0:17:32.61,Default,,0,0,0,,!هيجي، علينا ملاحقته
Dialogue: 0,0:17:32.61,0:17:33.64,Default,,0,0,0,,.لا بأس
Dialogue: 0,0:17:33.64,0:17:34.45,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:17:34.88,0:17:40.21,Default,,0,0,0,,برأيك لماذا كانت لدينا إمكانية الوصول إلى الورقة والولاعة المستخدمتين في الخدعة؟
Dialogue: 0,0:17:40.91,0:17:44.06,Default,,0,0,0,,.لقد استخدمنا ما تبقى داخل هذه الغرفة السرية
Dialogue: 0,0:17:44.96,0:17:47.71,Default,,0,0,0,,.حتى أن هناك مسدس صعق كهربائي
Dialogue: 0,0:17:48.16,0:17:51.23,Default,,0,0,0,,...إذن، أبي الذي كان محبوسًا في الداخل
Dialogue: 0,0:17:51.23,0:17:53.72,Default,,0,0,0,,...نعم. في هذا الوقت تقريبًا
Dialogue: 0,0:18:00.84,0:18:02.61,Default,,0,0,0,,...على الأرجح أنه قبض على الجاني
Dialogue: 0,0:18:07.30,0:18:09.11,Default,,0,0,0,,.ويرميه
Dialogue: 0,0:18:10.35,0:18:11.89,Default,,0,0,0,,!أبي
Dialogue: 0,0:18:13.81,0:18:15.12,Default,,0,0,0,,.تبا
Dialogue: 0,0:18:15.98,0:18:19.01,Default,,0,0,0,,.لا أصدق أنك صعقتني بمسدس صعق كهربائي
Dialogue: 0,0:18:19.01,0:18:21.18,Default,,0,0,0,,.عمل رائع، أيها العم
Dialogue: 0,0:18:23.02,0:18:25.13,Default,,0,0,0,,.لقد توقف المطر
Dialogue: 0,0:18:25.39,0:18:27.63,Default,,0,0,0,,ماذا عن المطر؟
Dialogue: 0,0:18:28.14,0:18:30.57,Default,,0,0,0,,.كازوها، التفتي إلى ذلك الجانب
Dialogue: 0,0:18:30.57,0:18:32.01,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:18:32.01,0:18:33.58,Default,,0,0,0,,.انتظري
Dialogue: 0,0:18:33.58,0:18:34.90,Default,,0,0,0,,ران؟
Dialogue: 0,0:18:38.86,0:18:39.89,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:18:39.89,0:18:42.64,Default,,0,0,0,,انتِ انتظري! ماذا تفعلين؟
Dialogue: 0,0:19:03.04,0:19:06.63,Default,,0,0,0,,.إنه حقًا غروب شمس جميل
Dialogue: 0,0:19:06.63,0:19:08.09,Default,,0,0,0,,.فعلاً
Dialogue: 0,0:19:13.03,0:19:16.16,Default,,0,0,0,,.ممتاز. أحسنتِ الصنع، يا انا
Dialogue: 0,0:19:16.97,0:19:20.81,Default,,0,0,0,,.هيا يا هاتوري. المسرح معد
Dialogue: 0,0:19:22.88,0:19:23.99,Default,,0,0,0,,...كازوها
Dialogue: 0,0:19:26.01,0:19:27.18,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:19:34.58,0:19:36.89,Default,,0,0,0,,أتريدين العودة إلى البيت؟
Dialogue: 0,0:19:39.20,0:19:40.52,Default,,0,0,0,,.نعم
Dialogue: 0,0:19:47.86,0:19:49.08,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:19:49.48,0:19:51.68,Default,,0,0,0,,.من الأفضل أن نشتري تذكارات
Dialogue: 0,0:19:51.68,0:19:55.08,Default,,0,0,0,,.أحب كعكات برج الجرس كثيرًا
Dialogue: 0,0:19:55.96,0:19:57.85,Default,,0,0,0,,.ستسمنين مرة أخرى إذا أكلتِ كثيرًا
Dialogue: 0,0:19:57.85,0:19:59.94,Default,,0,0,0,,.اصمت، أيها الوغد
Dialogue: 0,0:21:27.47,0:21:33.86,Default,,0,0,0,,.وصلت الشرطة بعد 30 دقيقة، وتم أخذ السيد تونتيتسو إلى مركز الشرطة
Dialogue: 0,0:21:34.32,0:21:39.40,Default,,0,0,0,,.تم العثور على زجاجات وخوابر خمور قديمة داخل الغرفة السرية
Dialogue: 0,0:21:39.40,0:21:42.09,Default,,0,0,0,,يبدو أن شخصًا ما بناه منذ وقت طويل
Dialogue: 0,0:21:42.09,0:21:44.95,Default,,0,0,0,,.ليشرب في الخفاء داخل المعبد
Dialogue: 0,0:21:45.29,0:21:49.39,Default,,0,0,0,,.السيد تونتيتسو وجده بالصدفة واستخدمه لأغراضه
Dialogue: 0,0:21:49.87,0:21:54.34,Default,,0,0,0,,...بالإضافة إلى ذلك، كان رئيس الكهنة قد أصر على أن أسطورة الجمجمة القرمزية كاذبة
Dialogue: 0,0:21:57.86,0:22:01.38,Default,,0,0,0,,لسبب غبي بشكل لا يصدق وهو أن مدبرات المنازل
Dialogue: 0,0:22:01.38,0:22:07.39,Default,,0,0,0,,.المقرر أن يبدأن العمل الأسبوع القادم قد يفزعن ويلغين
Dialogue: 0,0:22:10.46,0:22:12.98,Default,,0,0,0,,لماذا لم تنجح؟
Dialogue: 0,0:22:13.47,0:22:15.58,Default,,0,0,0,,.لا، لن استسلم
Dialogue: 0,0:22:15.58,0:22:17.88,Default,,0,0,0,,.سأجبرهم على الاعتراف لبعضهم البعض في المرة القادمة
Dialogue: 0,0:22:18.98,0:22:23.06,Default,,0,0,0,,.يجب أن أجد مكانًا جديدًا بإطلالة رائعة وآخذهم إلى هناك
Dialogue: 0,0:22:24.88,0:22:28.96,Default,,0,0,0,,ألا ينبغي أن نأخذ المسن إلى المستشفى أولاً؟
Dialogue: 0,0:22:36.42,0:22:38.43,Default,,0,0,0,,.ليالي الصيف قصيرة
Dialogue: 0,0:22:38.43,0:22:40.98,Default,,0,0,0,,.بينما تبدو مبكرة، فقد لاح الفجر بالفعل
Dialogue: 0,0:22:41.49,0:22:44.59,Default,,0,0,0,,فأين يستريح القمر في السحاب؟
Dialogue: 0,0:22:45.43,0:22:48.60,Default,,0,0,0,,.هذه هي القصيدة التي ربحتِ بها اليوم
Dialogue: 0,0:22:49.04,0:22:53.40,Default,,0,0,0,,.إنها تتردد في رأسي
Dialogue: 0,0:22:54.05,0:23:01.36,Default,,0,0,0,,ليالي الصيف تنتهي دون أن تدري، فأين يستريح القمر؟
Dialogue: 0,0:23:02.24,0:23:08.40,Default,,0,0,0,,.أظن أن هذا يعني أن الوقت يمر سريعًا عندما لا تنتبه
Dialogue: 0,0:23:10.87,0:23:12.54,Default,,0,0,0,,!تبا
Dialogue: 0,0:23:13.02,0:23:14.87,Default,,0,0,0,,.لقد نسيت
Dialogue: 0,0:23:16.43,0:23:18.38,Default,,0,0,0,,ما الأمر، هيجي؟
Dialogue: 0,0:23:18.38,0:23:22.31,Default,,0,0,0,,...كنت مركزًا جدًا على حل القضية. كنت أنوي إخبار كازوها بمشاعري، ولكنني
Dialogue: 0,0:23:22.31,0:23:24.02,Default,,0,0,0,,!نسيت
Dialogue: 0,0:23:24.38,0:23:25.76,Default,,0,0,0,,نسيت ماذا؟
Dialogue: 0,0:23:27.91,0:23:32.39,Default,,0,0,0,,.إذا كنت تقصد التذكارات، فقد اشتريت الكثير
