Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS \NX : @Theconansign
Dialogue: 0,0:00:03.36,0:00:04.62,Default,,0,0,0,,.تبا
Dialogue: 0,0:00:04.62,0:00:07.99,Default,,0,0,0,,.أستطيع سماعهم، لكنني لا أرى شيئًا
Dialogue: 0,0:00:08.25,0:00:13.30,Default,,0,0,0,,أقصد، أليس من المفترض الذهاب لمراقبة الطيور في وقت مبكر؟
Dialogue: 0,0:00:13.30,0:00:15.19,Default,,0,0,0,,.إنها الحادية عشرة والنصف الان
Dialogue: 0,0:00:15.19,0:00:17.50,Default,,0,0,0,,.حسنًا، لقد ضللنا الطريق
Dialogue: 0,0:00:17.50,0:00:18.78,Default,,0,0,0,,!اصمتو
Dialogue: 0,0:00:20.45,0:00:21.86,Default,,0,0,0,,هل رأيت شيئًا؟
Dialogue: 0,0:00:21.86,0:00:23.29,Default,,0,0,0,,.لا
Dialogue: 0,0:00:23.29,0:00:24.93,Default,,0,0,0,,.مجرد رجل مريب
Dialogue: 0,0:00:33.65,0:00:35.26,Default,,0,0,0,,.يبدو وكأنه كهربائي
Dialogue: 0,0:00:35.26,0:00:37.01,Default,,0,0,0,,هل هذا كل شيء؟
Dialogue: 0,0:00:37.01,0:00:38.29,Default,,0,0,0,,.انتظر لحظة
Dialogue: 0,0:00:39.31,0:00:40.77,Default,,0,0,0,,.انظر جيدًا، يا عمي
Dialogue: 0,0:00:42.03,0:00:44.21,Default,,0,0,0,,.هناك شخص على الأرض في الداخل
Dialogue: 0,0:00:46.96,0:00:49.13,Default,,0,0,0,,ماذا تخفي خلف قناعك المحطم؟
Dialogue: 0,0:00:49.13,0:00:53.53,Default,,0,0,0,,!رُؤي رجل مريب وشخص ممدد على الأرض من خلال المنظار
Dialogue: 0,0:00:53.53,0:00:55.13,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:00:55.13,0:00:56.95,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:00:56.95,0:00:59.22,Default,,0,0,0,,!اسمه هو المحقق كونان
Dialogue: 0,0:02:41.58,0:02:43.99,Default,,0,0,0,,"!القط المرحب كان يراقب"
Dialogue: 0,0:02:48.57,0:02:50.82,Default,,0,0,0,,وفقًا للرخصة على الجثة
Dialogue: 0,0:02:51.17,0:02:54.57,Default,,0,0,0,,.الضحية هو السيد كوروتاكي شيرو، 29 عامًا
Dialogue: 0,0:02:55.05,0:03:00.40,Default,,0,0,0,,سبب الوفاة على الأرجح هو فقدان الدم نتيجة لتعرضه للطعن بسكين في صدره
Dialogue: 0,0:03:01.00,0:03:02.92,Default,,0,0,0,,ما هو الوقت المقدر للوفاة؟
Dialogue: 0,0:03:02.92,0:03:08.46,Default,,0,0,0,,.بناءً على حالة الجثة، على الأرجح بين الساعة التاسعة و العاشرة صباحًا
Dialogue: 0,0:03:09.71,0:03:10.96,Default,,0,0,0,,.مفتش ميغوري
Dialogue: 0,0:03:11.86,0:03:14.27,Default,,0,0,0,,.لقد أحضرت الأخ الأكبر للضحية
Dialogue: 0,0:03:14.27,0:03:16.38,Default,,0,0,0,,!شيرو؟ شيرو
Dialogue: 0,0:03:18.59,0:03:20.90,Default,,0,0,0,,كيف حدث هذا؟
Dialogue: 0,0:03:20.90,0:03:23.86,Default,,0,0,0,,هل أنت متأكد من أن هذا هو شقيقك الأصغر؟
Dialogue: 0,0:03:23.86,0:03:26.10,Default,,0,0,0,,.نعم، هذا هو بالتأكيد
Dialogue: 0,0:03:26.66,0:03:29.47,Default,,0,0,0,,.لقد كان يعيش في الولايات المتحدة منذ عامين
Dialogue: 0,0:03:29.47,0:03:33.36,Default,,0,0,0,,.لقد أخبرني فقط أمس أنه عاد
Dialogue: 0,0:03:33.92,0:03:36.52,Default,,0,0,0,,هل ذهب إلى الولايات المتحدة للعمل أو شيء من هذا القبيل؟
Dialogue: 0,0:03:36.52,0:03:38.69,Default,,0,0,0,,.لا، من أجل الموسيقى
Dialogue: 0,0:03:38.69,0:03:41.97,Default,,0,0,0,,.مع ذلك، كان مجرد هاوٍ يفعل ذلك من أجل المتعة
Dialogue: 0,0:03:42.39,0:03:45.50,Default,,0,0,0,,.ادعى أنه كان ينوي صقل مهاراته في العزف على الجيتار
Dialogue: 0,0:03:46.20,0:03:48.11,Default,,0,0,0,,هل هناك خطب ما؟
Dialogue: 0,0:03:48.11,0:03:50.38,Default,,0,0,0,,.بعض جيتاراته مفقودة
Dialogue: 0,0:03:51.08,0:03:54.35,Default,,0,0,0,,.كان لديه معروضة على الحائط بأكمله
Dialogue: 0,0:03:54.35,0:03:55.75,Default,,0,0,0,,لماذا ليست هناك؟
Dialogue: 0,0:03:55.75,0:03:57.06,Default,,0,0,0,,.مفتش ميغوري
Dialogue: 0,0:03:57.38,0:04:00.14,Default,,0,0,0,,.لقد حددنا موقع شركة شوياما للكهرباء
Dialogue: 0,0:04:00.14,0:04:02.04,Default,,0,0,0,,.إنها في مدينة بيكا
Dialogue: 0,0:04:03.14,0:04:04.74,Default,,0,0,0,,.موري، تعال معنا
Dialogue: 0,0:04:04.74,0:04:06.14,Default,,0,0,0,,.بالتأكيد
Dialogue: 0,0:04:13.02,0:04:15.22,Default,,0,0,0,,هناك دم هنا أيضًا؟
Dialogue: 0,0:04:15.22,0:04:17.07,Default,,0,0,0,,!كونان، أسرع
Dialogue: 0,0:04:17.07,0:04:18.33,Default,,0,0,0,,!أنا قادم
Dialogue: 0,0:04:21.59,0:04:23.41,Default,,0,0,0,,.لا أعرف
Dialogue: 0,0:04:23.41,0:04:26.10,Default,,0,0,0,,.لم أذهب إلى ذلك المنزل إطلاقًا
Dialogue: 0,0:04:26.10,0:04:31.42,Default,,0,0,0,,.لكن هذا الرجل يقول أنه رآك هناك
Dialogue: 0,0:04:31.42,0:04:33.45,Default,,0,0,0,,.لا بد أنك رأيت شخصًا آخر
Dialogue: 0,0:04:33.45,0:04:35.92,Default,,0,0,0,,.لا، كان أنت بالتأكيد
Dialogue: 0,0:04:36.19,0:04:38.42,Default,,0,0,0,,.لا أعرف ماذا أقول
Dialogue: 0,0:04:38.42,0:04:43.93,Default,,0,0,0,,حسنًا، أين كنت وماذا كنت تفعل بين التاسعة والعاشرة صباح اليوم؟
Dialogue: 0,0:04:44.24,0:04:47.56,Default,,0,0,0,,ماذا؟ بين التاسعة والعاشرة؟
Dialogue: 0,0:04:47.56,0:04:53.03,Default,,0,0,0,,.كنت أستبدل وحدة التكييف في المبنى ذي السقف الأحمر عبر الشارع
Dialogue: 0,0:04:53.03,0:04:54.00,Default,,0,0,0,,.تاكاغي
Dialogue: 0,0:04:54.00,0:04:54.80,Default,,0,0,0,,.نعم
Dialogue: 0,0:04:57.93,0:05:02.73,Default,,0,0,0,,.أيها العم. متجرك يبيع لوحات المفاتيح الموسيقية
Dialogue: 0,0:05:02.73,0:05:05.40,Default,,0,0,0,,هل تبيع الجيتارات أيضًا؟
Dialogue: 0,0:05:05.40,0:05:09.52,Default,,0,0,0,,.لا، الأشخاص الذين يريدون جيتارات لا يأتون إلى متجرنا
Dialogue: 0,0:05:10.15,0:05:11.90,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:05:11.90,0:05:13.96,Default,,0,0,0,,.أيها المفتش، لحظة
Dialogue: 0,0:05:15.08,0:05:17.30,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:05:17.30,0:05:19.47,Default,,0,0,0,,.إنه لص
Dialogue: 0,0:05:19.78,0:05:21.41,Default,,0,0,0,,لص؟
Dialogue: 0,0:05:21.41,0:05:23.97,Default,,0,0,0,,.الرجل قال أن بعض الجيتارات مفقودة
Dialogue: 0,0:05:24.50,0:05:29.48,Default,,0,0,0,,.على الأرجح كان يسرق جيتارات الضحية أثناء وجوده في الخارج
Dialogue: 0,0:05:29.87,0:05:35.96,Default,,0,0,0,,.لكنه اليوم، قابل الضحية عند عودته وقتله
Dialogue: 0,0:05:37.34,0:05:38.48,Default,,0,0,0,,!أيها المفتش
Dialogue: 0,0:05:38.48,0:05:41.98,Default,,0,0,0,,.شهادة السيد شوياما كانت دقيقة
Dialogue: 0,0:05:41.98,0:05:48.01,Default,,0,0,0,,.بين التاسعة والعاشرة والنصف صباحًا، كان يستبدل وحدة التكييف في ذلك المنزل
Dialogue: 0,0:05:48.01,0:05:49.62,Default,,0,0,0,,هل أنت متأكد من الوقت؟
Dialogue: 0,0:05:49.62,0:05:50.50,Default,,0,0,0,,.نعم
Dialogue: 0,0:05:50.50,0:05:53.10,Default,,0,0,0,,كان من المقرر أن يبدأ العمل في التاسعة
Dialogue: 0,0:05:53.10,0:05:57.13,Default,,0,0,0,,.وبرنامج الساعة والعاشرة والنصف صباحًا بدأ فوراً بعد أن انتهى
Dialogue: 0,0:05:57.38,0:06:01.62,Default,,0,0,0,,.إنها رحلة ساعة واحدة إلى مكان الجريمة من هنا حتى لو كنت اسرع
Dialogue: 0,0:06:02.02,0:06:04.61,Default,,0,0,0,,.لم يكن بإمكانه فعل ذلك
Dialogue: 0,0:06:04.61,0:06:10.77,Default,,0,0,0,,.أيضًا، تلقى السيد شوياما مكالمة فورية بعد أن انتهى من العمل
Dialogue: 0,0:06:11.29,0:06:13.99,Default,,0,0,0,,بدا مصدومًا عندما أجاب على المكالمة
Dialogue: 0,0:06:13.99,0:06:18.38,Default,,0,0,0,,يتكلم بإصرار، "أوري؟ هل هذا أنتِ، أوري؟"
Dialogue: 0,0:06:18.38,0:06:19.72,Default,,0,0,0,,أوري؟
Dialogue: 0,0:06:19.72,0:06:22.28,Default,,0,0,0,,من هي أوري؟
Dialogue: 0,0:06:25.25,0:06:27.40,Default,,0,0,0,,.أوري هي ابنتي
Dialogue: 0,0:06:27.40,0:06:29.28,Default,,0,0,0,,ماذا عنها؟
Dialogue: 0,0:06:29.28,0:06:33.19,Default,,0,0,0,,لماذا كنت مصدومًا لتلقي مكالمة من ابنتك؟
Dialogue: 0,0:06:33.19,0:06:34.79,Default,,0,0,0,,...لـ-لأن
Dialogue: 0,0:06:35.31,0:06:38.53,Default,,0,0,0,,.الحقيقة هي أن أوري وأنا لا نتوافق
Dialogue: 0,0:06:38.53,0:06:42.17,Default,,0,0,0,,.لم أتلقَ أي خبر عنها منذ أن انتقلت للعيش وحيدة قبل ست سنوات
Dialogue: 0,0:06:42.17,0:06:44.98,Default,,0,0,0,,لـ-لكن ما علاقة هذا؟
Dialogue: 0,0:06:44.98,0:06:47.31,Default,,0,0,0,,.أوري ليس لها علاقة بالقضية
Dialogue: 0,0:06:48.73,0:06:51.43,Default,,0,0,0,,إذن، أين الأنسة أوري الآن؟
Dialogue: 0,0:06:51.43,0:06:53.93,Default,,0,0,0,,.لا أعرف. لم أسمع عنها
Dialogue: 0,0:06:53.93,0:06:56.94,Default,,0,0,0,,هكذا إذن؟
Dialogue: 0,0:07:05.74,0:07:06.95,Default,,0,0,0,,.مساء الخير
Dialogue: 0,0:07:07.49,0:07:09.07,Default,,0,0,0,,.مساء الخير
Dialogue: 0,0:07:10.90,0:07:12.16,Default,,0,0,0,,سيد شوياما؟
Dialogue: 0,0:07:14.01,0:07:16.84,Default,,0,0,0,,يا أنسة شوياما أوري، هل أنتِ هناك؟
Dialogue: 0,0:07:18.22,0:07:19.50,Default,,0,0,0,,.المعذرة
Dialogue: 0,0:07:20.85,0:07:23.16,Default,,0,0,0,,.أوري ليست في المنزل الآن
Dialogue: 0,0:07:23.16,0:07:26.09,Default,,0,0,0,,.قالت أنها فقدت مفتاحها ولم تعد
Dialogue: 0,0:07:26.44,0:07:29.24,Default,,0,0,0,,متى حدث هذا؟
Dialogue: 0,0:07:30.20,0:07:32.62,Default,,0,0,0,,.حوالي الساعة العاشرة والنصف، أعتقد
Dialogue: 0,0:07:32.62,0:07:37.48,Default,,0,0,0,,.بدت في حالة ذعر وقالت، "ساعدني يا أبي!" على الهاتف
Dialogue: 0,0:07:41.08,0:07:47.99,Default,,0,0,0,,.أتساءل حقًا لماذا يخفي السيد شوياما حقيقة ذهابه إلى مكان الجريمة
Dialogue: 0,0:07:47.99,0:07:51.92,Default,,0,0,0,,.وابنته الأنسة أوري قالت، "ساعدني يا أبي"
Dialogue: 0,0:07:51.92,0:07:53.49,Default,,0,0,0,,على أي حال
Dialogue: 0,0:07:53.96,0:07:58.50,Default,,0,0,0,,.لم نجد صلة بين عائلة شوياما والضحية
Dialogue: 0,0:07:58.50,0:08:00.00,Default,,0,0,0,,...لكن
Dialogue: 0,0:08:00.00,0:08:04.52,Default,,0,0,0,,الأهم من ذلك، علمنا للتو أنه حوالي الساعة العاشرة والنصف
Dialogue: 0,0:08:04.52,0:08:09.81,Default,,0,0,0,,.شوهدت دراجة نارية صفراء تبتعد بسرعة عن مكان الجريمة
Dialogue: 0,0:08:09.81,0:08:11.26,Default,,0,0,0,,دراجة نارية صفراء؟
Dialogue: 0,0:08:11.80,0:08:15.72,Default,,0,0,0,,.الآن، تتبع تلك الدراجة النارية يأتي أولاً
Dialogue: 0,0:08:21.47,0:08:22.41,Default,,0,0,0,,.تبا
Dialogue: 0,0:08:22.41,0:08:24.96,Default,,0,0,0,,.لا يعجبني هذا
Dialogue: 0,0:08:24.96,0:08:28.40,Default,,0,0,0,,لماذا كذب السيد شوياما؟
Dialogue: 0,0:08:29.61,0:08:31.03,Default,,0,0,0,,.أحدهم قادم
Dialogue: 0,0:08:33.30,0:08:34.55,Default,,0,0,0,,من هذا؟
Dialogue: 0,0:08:35.35,0:08:36.96,Default,,0,0,0,,زبونة؟
Dialogue: 0,0:08:36.96,0:08:38.54,Default,,0,0,0,,.لقد خرجت مرة أخرى
Dialogue: 0,0:08:39.78,0:08:41.54,Default,,0,0,0,,!انتظري، أوري
Dialogue: 0,0:08:42.79,0:08:45.98,Default,,0,0,0,,.آسفة، أنا مستعجلة. سأتصل لاحقًا
Dialogue: 0,0:08:46.50,0:08:48.28,Default,,0,0,0,,هل هذه الأنسة أوري؟
Dialogue: 0,0:08:48.28,0:08:51.06,Default,,0,0,0,,هل لهذا علاقة بالقضية؟
Dialogue: 0,0:08:51.06,0:08:53.02,Default,,0,0,0,,.سنكتشف
Dialogue: 0,0:09:05.80,0:09:08.40,Default,,0,0,0,,.يبدو أنها تنتظر أحدًا
Dialogue: 0,0:09:08.40,0:09:09.19,Default,,0,0,0,,.نعم
Dialogue: 0,0:09:12.58,0:09:14.41,Default,,0,0,0,,!دراجة نارية صفراء
Dialogue: 0,0:09:15.20,0:09:18.33,Default,,0,0,0,,.ها هي صلَتنا بين الأنسة أوري والقضية
Dialogue: 0,0:09:20.93,0:09:22.86,Default,,0,0,0,,.أتساءل عما يناقشونه
Dialogue: 0,0:09:22.86,0:09:24.01,Default,,0,0,0,,.لا أعرف
Dialogue: 0,0:09:36.60,0:09:37.78,Default,,0,0,0,,!تبًا
Dialogue: 0,0:09:40.27,0:09:42.02,Default,,0,0,0,,.تبا
Dialogue: 0,0:09:48.94,0:09:51.03,Default,,0,0,0,,إلى أين ذهبوا؟
Dialogue: 0,0:09:55.92,0:09:57.03,Default,,0,0,0,,مـ-ما الذي يحدث؟
Dialogue: 0,0:09:57.59,0:09:58.66,Default,,0,0,0,,.لنتحقق من الأمر
Dialogue: 0,0:09:59.56,0:10:01.03,Default,,0,0,0,,!ليتصل أحد بالإسعاف
Dialogue: 0,0:10:01.03,0:10:03.04,Default,,0,0,0,,!لقد سقطت من الطابق الثاني
Dialogue: 0,0:10:03.61,0:10:05.04,Default,,0,0,0,,!أنسة أوري
Dialogue: 0,0:10:05.40,0:10:07.47,Default,,0,0,0,,!هل أنتِ بخير؟ تماسكِ
Dialogue: 0,0:10:07.47,0:10:09.48,Default,,0,0,0,,...سيد شيـ-شيرو
Dialogue: 0,0:10:10.78,0:10:15.05,Default,,0,0,0,,...السيد شيـ-شيرو لم يكن مـ-ميتًا
Dialogue: 0,0:10:15.05,0:10:16.05,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:10:27.62,0:10:32.27,Default,,0,0,0,,سيد كوروتاكي، هل أنت متأكد أن الجثة التي طلبنا منك التعرف عليها سابقًا
Dialogue: 0,0:10:32.27,0:10:35.35,Default,,0,0,0,,كان شقيقك الأصغر، السيد شيرو؟
Dialogue: 0,0:10:35.35,0:10:37.49,Default,,0,0,0,,.نعم، أنا متأكد
Dialogue: 0,0:10:38.16,0:10:41.36,Default,,0,0,0,,.هذه صورة التقطناها كعائلة
Dialogue: 0,0:10:42.75,0:10:44.18,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:10:44.18,0:10:47.73,Default,,0,0,0,,بالمناسبة، عندما توفي والدكم
Dialogue: 0,0:10:47.73,0:10:51.00,Default,,0,0,0,,.سمعنا أنك تشاجرت مع السيد شيرو حول الميراث
Dialogue: 0,0:10:51.36,0:10:53.73,Default,,0,0,0,,.لا، لم نتشاجر
Dialogue: 0,0:10:53.73,0:11:00.39,Default,,0,0,0,,.ببساطة طلبت منه أن يعطيني حصته في الشركة حتى تسير الأمور بسلاسة
Dialogue: 0,0:11:00.39,0:11:02.52,Default,,0,0,0,,.لكنه رفضني
Dialogue: 0,0:11:02.92,0:11:04.66,Default,,0,0,0,,.فهمت
Dialogue: 0,0:11:04.66,0:11:08.77,Default,,0,0,0,,بالمناسبة، هل تعرف شخصًا أنسة إسمها شوياما أوري؟
Dialogue: 0,0:11:09.11,0:11:11.43,Default,,0,0,0,,أنسة شوياما أوري؟
Dialogue: 0,0:11:11.43,0:11:13.28,Default,,0,0,0,,.لا أعرفها
Dialogue: 0,0:11:16.79,0:11:18.28,Default,,0,0,0,,ماذا حدث، أيها المفتش؟
Dialogue: 0,0:11:18.28,0:11:23.64,Default,,0,0,0,,.يبدو أن الضحية كان السيد كوروتاكي شيرو في النهاية
Dialogue: 0,0:11:23.64,0:11:25.45,Default,,0,0,0,,إذن لماذا قالت ذلك؟
Dialogue: 0,0:11:25.45,0:11:26.79,Default,,0,0,0,,!مفتش ميغوري
Dialogue: 0,0:11:28.21,0:11:34.22,Default,,0,0,0,,.أرقام لوحة الدراجة التي رآها السيد موري والدراجة التي غادرت المكان متطابقة
Dialogue: 0,0:11:34.22,0:11:35.42,Default,,0,0,0,,.كما توقعت
Dialogue: 0,0:11:35.73,0:11:37.92,Default,,0,0,0,,إذن، من هو المالك؟
Dialogue: 0,0:11:39.39,0:11:41.93,Default,,0,0,0,,أنت السيد يوميمورا سوسوكي؟
Dialogue: 0,0:11:41.93,0:11:43.15,Default,,0,0,0,,.نعم
Dialogue: 0,0:11:43.65,0:11:48.94,Default,,0,0,0,,حوالي الساعة العاشرة والنصف صباح اليوم، هل زرت منزل السيد كوروتاكي شيرو؟
Dialogue: 0,0:11:49.23,0:11:55.30,Default,,0,0,0,,.نعم، فعلت. طلب مني شيرو أن ألتقي به لأننا لم نلتقِ منذ مدة
Dialogue: 0,0:11:55.30,0:11:58.04,Default,,0,0,0,,في أي وقت حدث ذلك؟
Dialogue: 0,0:11:58.04,0:12:00.34,Default,,0,0,0,,.حوالي الساعة الثامنة والنصف صباحًا، أعتقد
Dialogue: 0,0:12:00.74,0:12:07.46,Default,,0,0,0,,.وصلت بعد ساعة تقريبًا، والأنسة أوري خرجت مسرعة من الباب
Dialogue: 0,0:12:09.04,0:12:13.66,Default,,0,0,0,,.اصطدمنا ببعضنا، وصادف أن هناك تمثال قطة محظوظة حيث سقطت
Dialogue: 0,0:12:13.66,0:12:17.97,Default,,0,0,0,,.اصطدمت رأسي وفقدت الوعي لبعض الوقت
Dialogue: 0,0:12:18.48,0:12:22.97,Default,,0,0,0,,.إذن كان هذا دَمَك على التمثال
Dialogue: 0,0:12:22.97,0:12:23.99,Default,,0,0,0,,.نعم
Dialogue: 0,0:12:24.44,0:12:27.99,Default,,0,0,0,,.عندما أفقت، كانت الأنسة أوري قد اختفت
Dialogue: 0,0:12:27.99,0:12:31.12,Default,,0,0,0,,.دخلت إلى المنزل، وكان شيرو ميتًا
Dialogue: 0,0:12:31.12,0:12:36.33,Default,,0,0,0,,.كان يجب أن أتصل بالشرطة فورأ، لكنني ذعرت وهربت
Dialogue: 0,0:12:36.33,0:12:37.99,Default,,0,0,0,,.أنا آسف
Dialogue: 0,0:12:37.99,0:12:40.52,Default,,0,0,0,,ماذا فعلت بعد ذلك؟
Dialogue: 0,0:12:40.52,0:12:43.49,Default,,0,0,0,,.ذهبت إلى المستشفى
Dialogue: 0,0:12:43.95,0:12:49.93,Default,,0,0,0,,.بعد أن انتهوا من علاجي، اتصلت بي الأنسة أوري وقالت أنها تريد التحدث
Dialogue: 0,0:12:49.93,0:12:52.00,Default,,0,0,0,,إذن ذهبت لمقابلتها؟
Dialogue: 0,0:12:52.00,0:12:53.27,Default,,0,0,0,,.نعم
Dialogue: 0,0:12:53.27,0:12:58.19,Default,,0,0,0,,كنت خائفًا من مقابلتها بنفسي بعد ما حدث لشيرو
Dialogue: 0,0:12:58.19,0:13:00.76,Default,,0,0,0,,.لكني أردت أن أعرف ما حدث
Dialogue: 0,0:13:01.07,0:13:06.89,Default,,0,0,0,,.قالت الأنسة أوري أنها قتلت السيد شيرو بالخطا بسبب علاقتهما المتوترة
Dialogue: 0,0:13:07.26,0:13:11.90,Default,,0,0,0,,تقصد أن السيد شيرو والأنسة أوري كانا يتواعدان؟
Dialogue: 0,0:13:12.32,0:13:17.65,Default,,0,0,0,,.نعم. اقترحت أن تُسلم أوري نفسها للشرطة
Dialogue: 0,0:13:18.04,0:13:22.11,Default,,0,0,0,,وافقت، وقدت بها إلى مركز الشرطة
Dialogue: 0,0:13:22.11,0:13:28.33,Default,,0,0,0,,.لكن في الطريق، قالت أن لديها شيء لتفعله وطلبت أن أنزلها
Dialogue: 0,0:13:32.39,0:13:34.99,Default,,0,0,0,,حسنًا، أيها المفتش؟ هل اعترف؟
Dialogue: 0,0:13:34.99,0:13:37.39,Default,,0,0,0,,...في الواقع
Dialogue: 0,0:13:38.94,0:13:40.19,Default,,0,0,0,,.مفتش ميغوري
Dialogue: 0,0:13:41.09,0:13:45.95,Default,,0,0,0,,.أصر السيد شوياما على إخباركم بشيء ما
Dialogue: 0,0:13:45.95,0:13:47.93,Default,,0,0,0,,هل يمكنني مساعدتك؟
Dialogue: 0,0:13:47.93,0:13:52.19,Default,,0,0,0,,.أود بالحقيقة أن يسمع بقيتكم هذا أيضًا
Dialogue: 0,0:13:52.70,0:13:56.37,Default,,0,0,0,,أردت أن أبقى هذا سرًا من أجل مصلحة ابنتي
Dialogue: 0,0:13:56.37,0:14:01.97,Default,,0,0,0,,.لكنني لم أستطع تحمل المتاعب التي تسببها للشرطة
Dialogue: 0,0:14:01.97,0:14:04.70,Default,,0,0,0,,.شعرت أنه يجب علي إخباركم في النهاية
Dialogue: 0,0:14:05.39,0:14:10.20,Default,,0,0,0,,.الحقيقة هي، أن أوري هي من قتلت السيد كوروتاكي
Dialogue: 0,0:14:10.20,0:14:11.45,Default,,0,0,0,,ماذا قلت؟
Dialogue: 0,0:14:12.17,0:14:16.70,Default,,0,0,0,,هذا الصباح، أنهى علاقته بها على الهاتف
Dialogue: 0,0:14:16.70,0:14:18.81,Default,,0,0,0,,.وقال لها ألا تأتي إلى منزله مرة أخرى أبدًا
Dialogue: 0,0:14:18.81,0:14:22.45,Default,,0,0,0,,ذهبت إلى منزله لتسأل لماذا، وتشاجرا
Dialogue: 0,0:14:22.45,0:14:25.08,Default,,0,0,0,,.ثم قتلته بالخطا
Dialogue: 0,0:14:25.64,0:14:31.41,Default,,0,0,0,,.قالت أنها أسقطت مفتاح شقتها حينها، لذا ذهبت لأحضره
Dialogue: 0,0:14:31.41,0:14:34.98,Default,,0,0,0,,.هذا عندما رأيتموني
Dialogue: 0,0:14:35.34,0:14:39.73,Default,,0,0,0,,.هكذا إذن. شكرًا لك على إخبارنا
Dialogue: 0,0:14:40.29,0:14:41.74,Default,,0,0,0,,.عفواً
Dialogue: 0,0:14:42.07,0:14:43.49,Default,,0,0,0,,.أيها العم
Dialogue: 0,0:14:44.62,0:14:45.74,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:14:45.74,0:14:51.24,Default,,0,0,0,,ماذا حدث للجيتارات التي اختفت من منزل السيد كوروتاكي؟
Dialogue: 0,0:14:51.64,0:14:55.75,Default,,0,0,0,,.لا بد أن السيد شيرو باعها أو أعطاها لشخص ما
Dialogue: 0,0:14:56.09,0:14:59.00,Default,,0,0,0,,إذن ماذا عن ما قالته الأنسة أوري؟
Dialogue: 0,0:14:59.59,0:15:04.01,Default,,0,0,0,,...السيد شيـ-شيرو لم يكن مـ-ميتًا
Dialogue: 0,0:15:04.50,0:15:07.51,Default,,0,0,0,,ماذا قصدت بذلك؟
Dialogue: 0,0:15:07.51,0:15:10.18,Default,,0,0,0,,.كانت تفقد الوعي
Dialogue: 0,0:15:10.18,0:15:11.88,Default,,0,0,0,,.فهمت
Dialogue: 0,0:15:11.88,0:15:16.14,Default,,0,0,0,,أيها السيد شوياما. أين كان مفتاح الأنسة أوري؟
Dialogue: 0,0:15:16.14,0:15:18.32,Default,,0,0,0,,.في المدخل
Dialogue: 0,0:15:18.32,0:15:20.52,Default,,0,0,0,,ألم تنظر داخل المنزل؟
Dialogue: 0,0:15:20.91,0:15:25.03,Default,,0,0,0,,.لا. بعد كل شيء، قالت أوري أنها أسقطته في المدخل
Dialogue: 0,0:15:26.58,0:15:29.53,Default,,0,0,0,,.لا بد أنها أسقطته عندما اصطدمت بالسيد يوميمورا
Dialogue: 0,0:15:29.53,0:15:31.07,Default,,0,0,0,,.أيها السيد يوميمورا
Dialogue: 0,0:15:31.07,0:15:32.54,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:15:32.54,0:15:35.35,Default,,0,0,0,,هل كانت الإصابة في رأسك سيئة؟
Dialogue: 0,0:15:35.35,0:15:36.51,Default,,0,0,0,,.لا
Dialogue: 0,0:15:36.51,0:15:40.61,Default,,0,0,0,,.لم تكن بهذا السوء، لكنها كانت إصابة في الرأس
Dialogue: 0,0:15:40.61,0:15:42.55,Default,,0,0,0,,.ذهبت إلى المستشفى من أجل العلاج
Dialogue: 0,0:15:42.82,0:15:44.45,Default,,0,0,0,,أي مستشفى؟
Dialogue: 0,0:15:44.45,0:15:46.23,Default,,0,0,0,,.مستشفى بيكا العام
Dialogue: 0,0:15:46.23,0:15:47.23,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:47.23,0:15:48.52,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,0:15:48.52,0:15:52.01,Default,,0,0,0,,.هذه هي نفس المستشفى الذي توجد فيها الأنسة أوري
Dialogue: 0,0:15:52.01,0:15:52.85,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:52.85,0:15:54.56,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:15:54.56,0:15:58.06,Default,,0,0,0,,.كونان، لا حاجة لذكر هذا
Dialogue: 0,0:15:58.06,0:16:00.26,Default,,0,0,0,,.آسف
Dialogue: 0,0:16:32.71,0:16:34.00,Default,,0,0,0,,ما الذي يحدث هنا؟
Dialogue: 0,0:16:37.98,0:16:39.54,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:16:39.54,0:16:41.98,Default,,0,0,0,,لماذا أتيت إلى غرفة المستشفى هذه؟
Dialogue: 0,0:16:42.36,0:16:43.98,Default,,0,0,0,,.يا سيد يوميمورا سوسوكي
Dialogue: 0,0:16:44.50,0:16:49.77,Default,,0,0,0,,.سمعت أن الأنسة أوري موجودة هنا، لذا جئت لرؤيتها
Dialogue: 0,0:16:49.77,0:16:51.49,Default,,0,0,0,,.لا تتظاهر بالجهل
Dialogue: 0,0:16:52.39,0:16:54.99,Default,,0,0,0,,...سيد يوميمورا. لا
Dialogue: 0,0:16:55.37,0:16:57.02,Default,,0,0,0,,.بل السيد كوروتاكي شيرو
Dialogue: 0,0:16:57.02,0:16:58.01,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:16:58.01,0:17:02.85,Default,,0,0,0,,.أثناء تتبع الجيتارات التي اختفت بعد وقوع الجريمة
Dialogue: 0,0:17:02.85,0:17:08.01,Default,,0,0,0,,.تم إخبارنا أن شخصًا ما اشترى عدة جيتارات دفعة واحدة آخر مرة
Dialogue: 0,0:17:08.89,0:17:13.01,Default,,0,0,0,,.تم جلبها بواسطة شخص يدعى كوروتاكي شيرو
Dialogue: 0,0:17:13.43,0:17:17.37,Default,,0,0,0,,.إذ-إذن لم تكن مفقودة؛ لقد باعها شيرو
Dialogue: 0,0:17:17.37,0:17:18.52,Default,,0,0,0,,!هذا مستحيل
Dialogue: 0,0:17:18.52,0:17:23.91,Default,,0,0,0,,!في ذلك الوقت، كان شيرو في مستشفى في الولايات المتحدة نتيجة حادث سير
Dialogue: 0,0:17:23.91,0:17:27.96,Default,,0,0,0,,أظهرنا لموظف المتجر صورة لوجهك للتأكيد
Dialogue: 0,0:17:27.96,0:17:31.93,Default,,0,0,0,,.وشهدوا بأنك أنت من أتيت لبيع الجيتارات
Dialogue: 0,0:17:33.00,0:17:34.72,Default,,0,0,0,,.لا أصدق أوري أيضًا
Dialogue: 0,0:17:34.72,0:17:37.99,Default,,0,0,0,,كيف تقع في خداع أكاذيب هذا الرجل؟
Dialogue: 0,0:17:39.61,0:17:41.99,Default,,0,0,0,,.هذا هو على الأرجح ما أدى إلى القتل
Dialogue: 0,0:17:42.49,0:17:45.79,Default,,0,0,0,,السيد شيرو الحقيقي، الذي عاد بعد عامين في الخارج
Dialogue: 0,0:17:46.19,0:17:51.80,Default,,0,0,0,,.أدرك أن جيتاراته الثمينة مفقودة واتصل بك للقاء
Dialogue: 0,0:17:52.41,0:17:58.93,Default,,0,0,0,,سواء كنت تخطط لذلك أم أنه كان حادثًا مع ذلك، خلال الجدال
Dialogue: 0,0:17:59.85,0:18:02.38,Default,,0,0,0,,.قتلت السيد شيرو
Dialogue: 0,0:18:03.39,0:18:08.85,Default,,0,0,0,,.أثناء الهروب، اصطدمت بالأنسة أوري في المدخل
Dialogue: 0,0:18:09.41,0:18:13.70,Default,,0,0,0,,تم دفعك أثناء محاولتك لإبعادها عن المنزل
Dialogue: 0,0:18:14.29,0:18:18.58,Default,,0,0,0,,.اصطدم رأسك بقطة الحظ في المدخل، وفقدت الوعي
Dialogue: 0,0:18:19.74,0:18:26.84,Default,,0,0,0,,.رأت الأنسة أوري بقع الدم من السيد شيرو على ملابسك وظنت أنها قتلتك
Dialogue: 0,0:18:26.84,0:18:28.62,Default,,0,0,0,,.أصيبت بالذعر وهربت
Dialogue: 0,0:18:30.09,0:18:35.11,Default,,0,0,0,,.في وقت لاحق، استعدت وعيك وهربت على دراجتك النارية
Dialogue: 0,0:18:35.11,0:18:40.15,Default,,0,0,0,,.غيرت ملابسك، وتلقيت العلاج في المستشفى، وتصلت بالأنسة أوري
Dialogue: 0,0:18:41.10,0:18:48.24,Default,,0,0,0,,شعرت بأنها ملزمة بلقائك لأنها اعتقدت أنها قتلتك
Dialogue: 0,0:18:48.24,0:18:52.30,Default,,0,0,0,,.ولم تكن تعلم أن جريمة قتل قد وقعت في ذلك المنزل
Dialogue: 0,0:18:53.24,0:18:58.74,Default,,0,0,0,,استفدت من ذلك ودفعت الأنسة أوري من الشرفة
Dialogue: 0,0:18:59.39,0:19:02.00,Default,,0,0,0,,.في محاولة للتخلص منها
Dialogue: 0,0:19:05.82,0:19:08.36,Default,,0,0,0,,.ليس لديك دليل!، هذه مجرد تخيلات
Dialogue: 0,0:19:08.65,0:19:13.03,Default,,0,0,0,,.أعترف أنني انتحلت شخصية شيرو وبعت جيتاراته
Dialogue: 0,0:19:13.38,0:19:16.89,Default,,0,0,0,,!لكني لم أقتله! أوري هي من فعلت ذلك
Dialogue: 0,0:19:16.89,0:19:19.77,Default,,0,0,0,,فحصنا هاتف الأنسة أوري ووجدنا
Dialogue: 0,0:19:19.77,0:19:25.15,Default,,0,0,0,,.أنها بدأت مواعدة شخص يُدعى كورتاكي شيرو منذ عام
Dialogue: 0,0:19:25.54,0:19:30.59,Default,,0,0,0,,.بمعنى آخر، بعد أن بدأ السيد شيرو الحقيقي العيش في الولايات المتحدة
Dialogue: 0,0:19:30.59,0:19:35.93,Default,,0,0,0,,!لم يكن لدى الأنسة أوري دافع لقتل السيد شيرو، الذي لم تلتقِ به أبدًا
Dialogue: 0,0:19:35.93,0:19:40.02,Default,,0,0,0,,.لا بد أن شيرو دعا أوري إلى منزله وتصرف بخشونة معها
Dialogue: 0,0:19:40.02,0:19:41.53,Default,,0,0,0,,!هذا هراء
Dialogue: 0,0:19:42.70,0:19:44.00,Default,,0,0,0,,.يا سيد يوميمورا
Dialogue: 0,0:19:44.54,0:19:49.01,Default,,0,0,0,,لماذا قالت الأنسة أوري أنها أسقطت مفاتيحها في المدخل؟
Dialogue: 0,0:19:49.01,0:19:50.77,Default,,0,0,0,,.أ-لا أعرف
Dialogue: 0,0:19:50.77,0:19:55.05,Default,,0,0,0,,.لأنها لم تجد مكانًا آخر لتضعهم فيه
Dialogue: 0,0:19:55.36,0:19:59.55,Default,,0,0,0,,.بمعنى آخر، أوري لم تدخل المنزل أبدًا
Dialogue: 0,0:20:01.93,0:20:06.12,Default,,0,0,0,,.لا يحق لك أن تقول أي شيء لمجرد أن الموتى صامتون
Dialogue: 0,0:20:17.85,0:20:20.25,Default,,0,0,0,,!لا يهم أين أسقطت مفاتيحها
Dialogue: 0,0:20:20.25,0:20:21.57,Default,,0,0,0,,!إنها الحقيقة
Dialogue: 0,0:20:22.08,0:20:26.08,Default,,0,0,0,,!لم أدفع بأوري، ولم أقتل شيرو
Dialogue: 0,0:20:26.42,0:20:28.28,Default,,0,0,0,,!أوري هي من فعلت ذلك
Dialogue: 0,0:20:28.28,0:20:29.28,Default,,0,0,0,,.تبا
Dialogue: 0,0:20:29.28,0:20:32.44,Default,,0,0,0,,.لو أن أوري اعترفت وسلمت نفسها بدلاً من إنهاء حياتها
Dialogue: 0,0:20:32.44,0:20:34.74,Default,,0,0,0,,.لكنت قد أثبتت براءتي
Dialogue: 0,0:20:34.74,0:20:37.00,Default,,0,0,0,,.الأنسة أوري ليست ميتة
Dialogue: 0,0:20:38.52,0:20:42.83,Default,,0,0,0,,بعد السقوط من الشرفة، توقف قلبها
Dialogue: 0,0:20:42.83,0:20:47.23,Default,,0,0,0,,.لكن الإجراءات السريعة من موري وعائلته أنقذنا حياتها
Dialogue: 0,0:20:47.65,0:20:49.80,Default,,0,0,0,,!تماسكِ يا أنسة أوري
Dialogue: 0,0:20:52.08,0:20:53.97,Default,,0,0,0,,!ليتصل أحد بالإسعاف
Dialogue: 0,0:20:53.97,0:20:55.23,Default,,0,0,0,,!لقد اتصلت
Dialogue: 0,0:20:55.23,0:20:56.93,Default,,0,0,0,,!نحتاج إلى جهاز الإنعاش القلبي
Dialogue: 0,0:20:56.93,0:20:58.11,Default,,0,0,0,,!سأذهب لإحضار واحد
Dialogue: 0,0:20:58.11,0:20:59.84,Default,,0,0,0,,!أنسة أوري، تماسكِ
Dialogue: 0,0:20:59.84,0:21:00.79,Default,,0,0,0,,!أنسة أوري
Dialogue: 0,0:21:00.79,0:21:02.24,Default,,0,0,0,,!أنسة أوري! أنسة أوري
Dialogue: 0,0:21:03.59,0:21:06.00,Default,,0,0,0,,.نعم. نعم، فهمت
Dialogue: 0,0:21:06.00,0:21:07.67,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:21:08.42,0:21:09.75,Default,,0,0,0,,.مفتش ميغوري
Dialogue: 0,0:21:10.33,0:21:14.25,Default,,0,0,0,,.الأنسة أوري استعادت وعيها للتو
Dialogue: 0,0:21:14.58,0:21:15.77,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:21:17.41,0:21:18.55,Default,,0,0,0,,...الآن
Dialogue: 0,0:21:19.12,0:21:24.14,Default,,0,0,0,,.بعد أن استيقظت الأنسة أوري، أتطلع إلى سماع شهادتها
Dialogue: 0,0:21:25.28,0:21:27.01,Default,,0,0,0,,أليس كذلك يا سيد يوميمورا سوسوكي؟
Dialogue: 0,0:22:50.97,0:22:54.04,Default,,0,0,0,,.جيد. حصلت على واحدة جيدة
Dialogue: 0,0:22:54.98,0:22:56.63,Default,,0,0,0,,.ثم سأفعل هذا
Dialogue: 0,0:22:56.63,0:22:58.15,Default,,0,0,0,,.أبي
Dialogue: 0,0:22:58.57,0:23:01.19,Default,,0,0,0,,أي لعبة تلعب؟
Dialogue: 0,0:23:07.99,0:23:10.69,Default,,0,0,0,,.دعني أرى ذلك
Dialogue: 0,0:23:27.01,0:23:30.82,Default,,0,0,0,,مهلا! لماذا تستخدم اسمي؟
Dialogue: 0,0:23:30.82,0:23:34.30,Default,,0,0,0,,آسف! لم أستطع التفكير في شيء أفضل!
Dialogue: 0,0:23:34.30,0:23:35.36,Default,,0,0,0,,لمَ فعلت ذلك؟
Dialogue: 0,0:23:35.36,0:23:36.06,Default,,0,0,0,,!آسف
Dialogue: 0,0:23:36.06,0:23:38.29,Default,,0,0,0,,!لا تستخدم اسمي مجدداً
Dialogue: 0,0:23:38.29,0:23:39.27,Default,,0,0,0,,!لن أفعل
Dialogue: 0,0:23:39.27,0:23:41.47,Default,,0,0,0,,!هذه لعبة ماجونغ
Dialogue: 0,0:23:41.47,0:23:44.06,Default,,0,0,0,,.لا ينبغي عليك انتحال شخصية الآخرين أيضًا
Dialogue: 0,0:23:45.03,0:23:50.27,Default,,0,0,0,,.يبدو أن رجلًا يُدعى بوتشي حاول الاتصال بي
Dialogue: 0,0:23:51.53,0:23:53.79,Default,,0,0,0,,.هذه المذكرة كانت في جيبه
Dialogue: 0,0:23:54.07,0:23:56.54,Default,,0,0,0,,.الـ13؟ هذا غدًا
Dialogue: 0,0:23:56.87,0:23:59.79,Default,,0,0,0,,لا يمكننا ببساطة الانتظار حتى يحدث، أليس كذلك؟
Dialogue: 0,0:24:00.20,0:24:05.30,Default,,0,0,0,,...تحقيق الأمس لم يسفر عن أي شيء، لكن إذا كمنّا هنا
Dialogue: 0,0:24:05.30,0:24:09.05,Default,,0,0,0,,!لا توجد أي ألغاز ليحلها المحقق هذه المرة
Dialogue: 0,0:24:09.46,0:24:13.32,Default,,0,0,0,,"!الحلقة القادمة من كونان هي "بوتشي يرد الجميل
Dialogue: 0,0:24:30.07,0:24:32.65,Default,,0,0,0,,!تلميح كونان القادم
Dialogue: 0,0:24:32.65,0:24:34.10,Default,,0,0,0,,!سلحفاة
Dialogue: 0,0:24:35.31,0:24:38.47,Default,,0,0,0,,.كونان، لا تستخدم أسماء الناس بدون إذنهم
