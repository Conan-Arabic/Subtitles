Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS \NX : @Theconansign
Dialogue: 0,0:00:05.99,0:00:07.74,Default,,0,0,0,,!لقد تأخرنا
Dialogue: 0,0:00:07.74,0:00:10.24,Default,,0,0,0,,!تأخرنا !تأخرنا
Dialogue: 0,0:00:16.91,0:00:18.37,Default,,0,0,0,,.لقد وصلنا
Dialogue: 0,0:00:35.64,0:00:37.53,Default,,0,0,0,,!هذا رائع
Dialogue: 0,0:00:41.22,0:00:44.60,Default,,0,0,0,,.لم يكن موجوداً في المرة السابقة التي جئت فيها
Dialogue: 0,0:00:44.60,0:00:50.40,Default,,0,0,0,,على ما يبدو، صمم هذه الساعة الدمى صانع ساعات مشهور
Dialogue: 0,0:00:50.40,0:00:54.53,sign_1189_onscreen_article,SIGN,0,0,0,,{\an6\frz26\move(483,79,547,90)\fs20\t(\fs20,\fs23)}إيوابوتشي\Nماساتو
Dialogue: 0,0:00:51.17,0:00:54.53,Default,,0,0,0,,عميل اليوم هو تلميذ هذا الرجل، أليس كذلك؟
Dialogue: 0,0:00:54.86,0:00:56.97,Default,,0,0,0,,!أنت
Dialogue: 0,0:00:56.97,0:01:03.60,Default,,0,0,0,,!لا تبدو متفاجئًا على الإطلاق، فالأمر لا يكلفك شيئًا
Dialogue: 0,0:01:05.74,0:01:08.95,Default,,0,0,0,,!!انظر، ابتهج مثلها
Dialogue: 0,0:01:08.95,0:01:11.32,Default,,0,0,0,,!إنه موري كوغورو
Dialogue: 0,0:01:11.32,0:01:12.79,Default,,0,0,0,,من، أنا؟
Dialogue: 0,0:01:12.79,0:01:13.76,Default,,0,0,0,,.أنا آسف
Dialogue: 0,0:01:14.84,0:01:17.56,Default,,0,0,0,,ابنتي من أشد المعجبين بك
Dialogue: 0,0:01:17.85,0:01:21.50,Default,,0,0,0,,{\an8}.عندما أكبر، سأصبح محققة عظيمة
Dialogue: 0,0:01:18.06,0:01:22.56,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(377,292)}(5) ساساكاوا ناتسومي
Dialogue: 0,0:01:21.50,0:01:23.56,Default,,0,0,0,,{\an8}.حتى أنني حصلت على الأصفاد الخاصة بي
Dialogue: 0,0:01:23.56,0:01:26.61,Default,,0,0,0,,،جميل .هذا رائع جداً
Dialogue: 0,0:01:26.61,0:01:29.57,Default,,0,0,0,,.لكن المحققين لا يستخدمون الأصفاد
Dialogue: 0,0:01:30.11,0:01:33.25,Default,,0,0,0,,.أنا أتدرب على النوم أيضاً
Dialogue: 0,0:01:38.31,0:01:40.62,Default,,0,0,0,,.الآن يمكنني أن أصبح محققة عظيمة
Dialogue: 0,0:01:48.92,0:01:49.92,Default,,0,0,0,,سيد مورِي
Dialogue: 0,0:01:52.12,0:01:53.84,Default,,0,0,0,,آسف لإبقائك تنتظر
Dialogue: 0,0:01:54.09,0:01:57.43,Default,,0,0,0,,{\an8}.مرحباً اسمي تانو ريوتا
Dialogue: 0,0:01:54.09,0:01:57.93,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\pos(397,256)}(34) تانو ريوتا
Dialogue: 0,0:01:54.09,0:01:57.93,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(397,273)}صانع الساعات
Dialogue: 0,0:01:57.93,0:02:00.04,Default,,0,0,0,,.أهلا أنا مورِي
Dialogue: 0,0:02:02.31,0:02:04.46,Default,,0,0,0,,.لقد دعوتك إلى هنا لمناقشة شيء ما
Dialogue: 0,0:02:07.06,0:02:08.48,Default,,0,0,0,,.هذا هو
Dialogue: 0,0:02:09.04,0:02:12.11,Default,,0,0,0,,ساعتك ستتوقف قريباً"؟"
Dialogue: 0,0:02:12.11,0:02:13.11,Default,,0,0,0,,.هذا؟
Dialogue: 0,0:02:18.49,0:02:20.42,Default,,0,0,0,,في مواجهة لغز غير متوقع
Dialogue: 0,0:02:20.42,0:02:22.35,Default,,0,0,0,,!الحل الوحيد هو مهارات الاستنتاج الفائقة
Dialogue: 0,0:02:22.35,0:02:24.20,Default,,0,0,0,,!تهديد غامض وحجة لا تُقهر
Dialogue: 0,0:02:24.20,0:02:25.92,Default,,0,0,0,,كيف يتم التلاعب بالوقت؟
Dialogue: 0,0:02:25.92,0:02:27.54,Default,,0,0,0,,يسعى وراء الحقيقة دائماً
Dialogue: 0,0:02:27.54,0:02:29.46,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:02:29.46,0:02:31.76,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:02:33.61,0:02:37.37,DC-OP,,0,0,0,,‫ليس بوسعي تغييره بنفسي
Dialogue: 0,0:02:37.55,0:02:40.60,DC-OP,,0,0,0,,‫ما كان منك وما أصابك، فقد مضى وانتهى
Dialogue: 0,0:02:41.08,0:02:44.85,DC-OP,,0,0,0,,‫لا يُعرف من أين جاء ولا ما هو
Dialogue: 0,0:02:44.94,0:02:48.57,DC-OP,,0,0,0,,‫كأن يهاجمك أحد الوحوش
Dialogue: 0,0:02:48.86,0:02:52.64,DC-OP,,0,0,0,,‫أركض كي لا يلحقوا بي
Dialogue: 0,0:02:52.64,0:02:55.90,DC-OP,,0,0,0,,‫ربما يحدث خيراً، من يعلم؟
Dialogue: 0,0:02:56.30,0:03:00.20,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:03:00.20,0:03:04.21,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:03:04.21,0:03:07.92,DC-OP,,0,0,0,,‫أجعل عمق الليل يلمع باللون الوردي
Dialogue: 0,0:03:07.92,0:03:11.64,DC-OP,,0,0,0,,‫مهما طال الزمن، كل ما علي فعله هو المحاولة
Dialogue: 0,0:03:19.34,0:03:23.14,DC-OP,,0,0,0,,‫أبحث عن سعادة جديدة
Dialogue: 0,0:03:23.14,0:03:26.43,DC-OP,,0,0,0,,‫أين يكمن؟، لا احد يعلم
Dialogue: 0,0:03:26.76,0:03:30.86,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:03:30.86,0:03:34.27,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:03:34.46,0:03:37.87,DC-OP,,0,0,0,,‫أضيء على الذكريات المظلمة
Dialogue: 0,0:03:38.15,0:03:41.85,DC-OP,,0,0,0,,‫احدق فيها حتى يزول خوفها
Dialogue: 0,0:03:42.11,0:03:45.83,DC-OP,,0,0,0,,‫في لحظة تلتفت فيها إلى الماضي
Dialogue: 0,0:03:45.93,0:03:49.57,DC-OP,,0,0,0,,‫لم يكن سوى أن أطلقت أعظم دموعك
Dialogue: 0,0:04:14.11,0:04:19.99,sign_episode_title,SIGN,0,0,0,,{\fad(400,1)}حجة الغياب المزدوجة
Dialogue: 0,0:04:14.23,0:04:16.44,Default,,0,0,0,,"!حجة الغياب المزدوجة"
Dialogue: 0,0:04:21.46,0:04:22.99,Default,,0,0,0,,...هكذا إذن
Dialogue: 0,0:04:23.37,0:04:26.87,Default,,0,0,0,,...إذن هذه الساعة التي ستتوقف
Dialogue: 0,0:04:26.87,0:04:31.75,Default,,0,0,0,,.نعم أعتقد أنهم يخططون لكسر الساعة التي صممتها
Dialogue: 0,0:04:32.10,0:04:35.75,Default,,0,0,0,,!أو أنهم يحاولون قتلك
Dialogue: 0,0:04:36.53,0:04:38.05,Default,,0,0,0,,مـ-مستحيل
Dialogue: 0,0:04:40.33,0:04:41.65,Default,,0,0,0,,.لا تقلق
Dialogue: 0,0:04:41.65,0:04:49.35,Default,,0,0,0,,.أنا موري كوغورو، سأحمي الساعة التي صممتها وكذلك حياتك
Dialogue: 0,0:04:50.71,0:04:52.27,Default,,0,0,0,,.شكراً لك
Dialogue: 0,0:04:52.27,0:04:55.36,Default,,0,0,0,,.على أي حال هل تعرف من قد يكون أرسل هذا
Dialogue: 0,0:04:55.79,0:04:58.49,Default,,0,0,0,,.كان هذا في صندوق بريد مكتبك أليس كذلك
Dialogue: 0,0:04:58.49,0:05:01.43,Default,,0,0,0,,.ربما هو ثأر متعلق بالعمل
Dialogue: 0,0:05:01.43,0:05:03.28,Default,,0,0,0,,ثأر؟
Dialogue: 0,0:05:03.28,0:05:06.31,Default,,0,0,0,,.عندما تمت مقابلتك على التلفاز مؤخرًا
Dialogue: 0,0:05:06.31,0:05:08.49,Default,,0,0,0,,.أطلقوا عليك اسم صانع الساعات الواعد
Dialogue: 0,0:05:08.49,0:05:11.67,Default,,0,0,0,,.أنت تصنع ساعة دمى لمدينة ملاهي أليس كذلك
Dialogue: 0,0:05:11.67,0:05:15.59,Default,,0,0,0,,.بالضبط ربما أحدهم يشعر بالحسد تجاه ذلك
Dialogue: 0,0:05:15.59,0:05:19.80,Default,,0,0,0,,حسد؟ لكنني ما زلت مبتدئاً
Dialogue: 0,0:05:19.80,0:05:24.09,Default,,0,0,0,,.على الرغم من أنني أتخيل أن الناس سيحسدونني بمجرد وصولي لمستوى معلمي
Dialogue: 0,0:05:24.44,0:05:27.01,Default,,0,0,0,,.تقصد الشخص الذي صنع تلك الساعة
Dialogue: 0,0:05:27.54,0:05:29.77,Default,,0,0,0,,.تستخدم تقنية مذهلة أليس كذلك
Dialogue: 0,0:05:30.09,0:05:34.26,Default,,0,0,0,,.نعم إنها تستخدم آلية جديدة لا تشبه أي شيء آخر
Dialogue: 0,0:05:34.26,0:05:37.44,Default,,0,0,0,,...حتى معلمي لم يكن ليستطيع ابتكارها، أعني
Dialogue: 0,0:05:38.73,0:05:43.63,Default,,0,0,0,,.إنني مندهش من أن شخصاً ما استطاع ابتكار تلك الآلية الرائعة
Dialogue: 0,0:05:45.20,0:05:48.08,sign_suspect,SIGN,0,0,0,,{\pos(320,292)}بحيرة أوكوهو
Dialogue: 0,0:05:47.09,0:05:48.68,Default,,0,0,0,,{\an8}!تبا
Dialogue: 0,0:05:48.68,0:05:52.08,Default,,0,0,0,,.لقد أغرقت نفسك في طاولة الإفطار
Dialogue: 0,0:05:52.08,0:05:55.58,Default,,0,0,0,,.لكن كل شيء بدا شهياً
Dialogue: 0,0:05:56.83,0:05:58.98,Default,,0,0,0,,.لا يزال هناك وقت قبل المؤتمر
Dialogue: 0,0:05:58.98,0:06:00.89,Default,,0,0,0,,.اركض هيا اركض
Dialogue: 0,0:06:00.89,0:06:03.30,Default,,0,0,0,,.أعتقد أنه حان وقت الاستراحة
Dialogue: 0,0:06:03.30,0:06:04.33,Default,,0,0,0,,لا
Dialogue: 0,0:06:04.33,0:06:08.18,Default,,0,0,0,,.البحيرة جميلة الآن دعنا لا نضيع هذه الفرصة
Dialogue: 0,0:06:16.40,0:06:18.64,Default,,0,0,0,,!هذا رائع
Dialogue: 0,0:06:19.18,0:06:19.98,Default,,0,0,0,,مهلًا؟
Dialogue: 0,0:06:21.47,0:06:24.49,Default,,0,0,0,,هل جرفت هذه القارب إلى هنا؟
Dialogue: 0,0:06:24.49,0:06:27.62,Default,,0,0,0,,.هذا طبيعي فالرياح هبت بقوة ليلة أمس
Dialogue: 0,0:06:32.72,0:06:34.87,Default,,0,0,0,,...بطني تؤلمني
Dialogue: 0,0:06:36.30,0:06:37.79,Default,,0,0,0,,!أمسكت بها
Dialogue: 0,0:06:43.76,0:06:45.05,Default,,0,0,0,,...بـ-بروفيسور
Dialogue: 0,0:06:45.39,0:06:46.72,Default,,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:06:55.75,0:06:59.59,Default,,0,0,0,,.لقد قُتل نتيجة ضربة على مؤخرة رأسه بأداة صلبة
Dialogue: 0,0:06:59.59,0:07:01.61,Default,,0,0,0,,.لا توجد بقع دم في المنطقة
Dialogue: 0,0:07:01.61,0:07:03.98,Default,,0,0,0,,ولم نجد المجاديف أيضاً
Dialogue: 0,0:07:03.98,0:07:09.37,Default,,0,0,0,,.مما يعني أن الجاني تقريباً قام بوضعه في القارب بعد قتله
Dialogue: 0,0:07:09.37,0:07:12.66,Default,,0,0,0,,.لكن لماذا يكلف نفسه عناء استخدام القارب
Dialogue: 0,0:07:12.66,0:07:16.93,Default,,0,0,0,,الوقت المقدر للوفاة هو بين الساعة السابعة والنصف والثامنة والنصف صباحاً
Dialogue: 0,0:07:16.93,0:07:19.52,Default,,0,0,0,,بناءً على تذكرة الوقوف الموجودة في جيب الضحية
Dialogue: 0,0:07:19.52,0:07:23.69,Default,,0,0,0,,.من المحتمل أنه قُتل بعد الساعة السابعة وأربعون دقيقة
Dialogue: 0,0:07:23.69,0:07:29.04,Default,,0,0,0,,.أيضاً لسبب ما كان هناك مسدس صعق كهربائي في جيب الضحية أيضاً
Dialogue: 0,0:07:30.02,0:07:33.38,Default,,0,0,0,,وفي ذلك الوقت كان سيد أغاسا يتناول الإفطار
Dialogue: 0,0:07:33.38,0:07:36.02,Default,,0,0,0,,.على الشرفة في ذلك النزل
Dialogue: 0,0:07:36.34,0:07:38.31,Default,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:07:38.31,0:07:40.23,Default,,0,0,0,,نعم هذا صحيح
Dialogue: 0,0:07:40.23,0:07:44.15,Default,,0,0,0,,هل سمعت أي أصوات مشبوهة في ذلك الوقت؟
Dialogue: 0,0:07:44.15,0:07:48.23,Default,,0,0,0,,.لا لا شيء أليس كذلك يا آي
Dialogue: 0,0:07:48.23,0:07:49.16,Default,,0,0,0,,صحيح
Dialogue: 0,0:07:50.67,0:07:51.58,Default,,0,0,0,,أيها المفتش
Dialogue: 0,0:07:52.27,0:07:54.39,Default,,0,0,0,,.وجدنا رخصة قيادة في سيارة الضحية
Dialogue: 0,0:07:55.97,0:07:59.04,Default,,0,0,0,,.أعتقد أنني رأيت هذا الشخص من قبل
Dialogue: 0,0:07:59.53,0:08:03.89,Default,,0,0,0,,.إنه صانع ساعات حصل مؤخراً على جائزة
Dialogue: 0,0:08:03.89,0:08:06.38,Default,,0,0,0,,إذن كان يعيش هنا في الجوار
Dialogue: 0,0:08:06.38,0:08:10.17,Default,,0,0,0,,.اعتقدت أن هذا قد يحدث في النهاية
Dialogue: 0,0:08:10.17,0:08:12.93,Default,,0,0,0,,.كانت شخصيته سيئة للغاية بعد كل شيء
Dialogue: 0,0:08:13.26,0:08:17.02,Default,,0,0,0,,.لقد تشاجر مع تلميذه القديم الأسبوع الماضي
Dialogue: 0,0:08:17.02,0:08:21.69,Default,,0,0,0,,.نعم ذلك الشاب الذي أطلق عليه الخبر اسم صانع الساعات الواعد
Dialogue: 0,0:08:21.69,0:08:25.51,Default,,0,0,0,,"!لقد صرخ "سأقتلك، أيها الجحود
Dialogue: 0,0:08:25.51,0:08:28.70,Default,,0,0,0,,...مهلاً ذلك صانع الساعات الواعد
Dialogue: 0,0:08:28.70,0:08:30.70,sign_1189_onscreen_headlines,SIGN,0,0,0,,{\an2\frz-6.5\fax-0.1\pos(196,239)}تانو ريوتا\Nصانع الساعات الواعد في الصناعة
Dialogue: 0,0:08:29.22,0:08:30.70,Default,,0,0,0,,أهذا هو؟
Dialogue: 0,0:08:31.13,0:08:34.83,Default,,0,0,0,,.موقع مكتبي عام وأنا خائف من البقاء في المنزل
Dialogue: 0,0:08:34.83,0:08:38.08,Default,,0,0,0,,.لذا أقيم في هذا الفندق منذ ثلاثة أيام
Dialogue: 0,0:08:38.64,0:08:40.54,Default,,0,0,0,,هكذا إذن
Dialogue: 0,0:08:44.92,0:08:46.34,Default,,0,0,0,,المعذرة
Dialogue: 0,0:08:47.73,0:08:49.24,Default,,0,0,0,,ما الأمر هايبرا؟
Dialogue: 0,0:08:49.24,0:08:53.76,Default,,0,0,0,,أليس تانوريوتا هو العميل الذي سيلتقي به المحقق موري اليوم؟
Dialogue: 0,0:08:53.76,0:08:56.22,Default,,0,0,0,,نعم
Dialogue: 0,0:08:56.22,0:09:00.13,Default,,0,0,0,,كانت هناك جريمة قتل بالقرب من النزل الذي أقمت فيه مع البروفيسور
Dialogue: 0,0:09:03.73,0:09:07.36,Default,,0,0,0,,إذن سيد تانو تشاجر قبل عدة أيام
Dialogue: 0,0:09:07.36,0:09:10.07,Default,,0,0,0,,مع سيد فوروبوتشي الضحية؟
Dialogue: 0,0:09:11.41,0:09:13.41,Default,,0,0,0,,ماذا فعل السيد تانو؟
Dialogue: 0,0:09:13.74,0:09:15.53,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:16.24,0:09:19.25,Default,,0,0,0,,إذن هذا هو الأمر
Dialogue: 0,0:09:23.65,0:09:26.42,Default,,0,0,0,,أنت من كتب هذه الرسالة أليس كذلك؟
Dialogue: 0,0:09:27.51,0:09:31.88,Default,,0,0,0,,لقد دعوتنا إلى هنا لتفبرك حجة لنفسك أليس كذلك؟
Dialogue: 0,0:09:31.88,0:09:34.30,Default,,0,0,0,,أ-أنا لا أعرف ما الذي تتحدث عنه
Dialogue: 0,0:09:35.09,0:09:38.82,Default,,0,0,0,,.تم العثور على جثة سيد فوروبوتشي في بحيرة أوكوهو
Dialogue: 0,0:09:39.28,0:09:44.03,Default,,0,0,0,,الوقت المقدر للوفاة هو بين السابعة وأربعين دقيقة والثامنة والنصف صباح اليوم
Dialogue: 0,0:09:44.44,0:09:48.94,Default,,0,0,0,,سمعنا أنك وسيد فوروبوتشي لم تكونا على وفاق
Dialogue: 0,0:09:49.30,0:09:53.70,Default,,0,0,0,,لماذا لا تخبرنا بما كنت تفعله قبل أن تقابلنا في الردهة؟
Dialogue: 0,0:09:56.59,0:10:00.20,Default,,0,0,0,,.كنت في غرفتي بالفندق أعمل
Dialogue: 0,0:10:00.54,0:10:04.88,Default,,0,0,0,,.لكنني تلقيت خدمة الغرف قبل الساعة السابعة والنصف
Dialogue: 0,0:10:04.88,0:10:06.88,Default,,0,0,0,,خدمة الغرف؟
Dialogue: 0,0:10:06.88,0:10:10.63,Default,,0,0,0,,.سيد تانو في الغرفة 305، أليس كذلك
Dialogue: 0,0:10:10.95,0:10:15.39,Default,,0,0,0,,.نعم أحضرت له سندويشات وقهوة حوالي الساعة السابعة والنصف
Dialogue: 0,0:10:16.01,0:10:19.01,Default,,0,0,0,,.جيد حجتي قد اكتملت
Dialogue: 0,0:10:19.01,0:10:21.09,Default,,0,0,0,,المعذرة إذن
Dialogue: 0,0:10:23.55,0:10:26.32,Default,,0,0,0,,لا يمكنك تسمية هذا حجة
Dialogue: 0,0:10:26.32,0:10:27.30,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:10:27.30,0:10:29.02,Default,,0,0,0,,.إنها خدعة بسيطة
Dialogue: 0,0:10:29.02,0:10:33.11,Default,,0,0,0,,.يمكنك الهروب من النافذة بعد استلامك لخدمة الغرفة
Dialogue: 0,0:10:33.53,0:10:36.78,Default,,0,0,0,,.لكن غرفتي في الطابق الثالث
Dialogue: 0,0:10:37.30,0:10:40.43,Default,,0,0,0,,.إنها في الخلف بجوار موقف السيارات أليس كذلك
Dialogue: 0,0:10:40.43,0:10:46.26,Default,,0,0,0,,في الساعة السابعة والنصف يركن شاحنة تحت نافذة تلك الغرفة لجمع المناشف المستعملة
Dialogue: 0,0:10:46.26,0:10:48.54,Default,,0,0,0,,.سيكون من السهل القفز عليها
Dialogue: 0,0:10:48.54,0:10:50.80,Default,,0,0,0,,لماذا تعرف ذلك؟
Dialogue: 0,0:10:50.80,0:10:54.17,Default,,0,0,0,,.لقد جربت ذلك بنفسي في المرة السابقة
Dialogue: 0,0:10:54.84,0:10:56.93,Default,,0,0,0,,من ماذا كان يهرب؟
Dialogue: 0,0:10:57.55,0:11:02.02,Default,,0,0,0,,.لقد ذهبت وعُدت بالسيارة إلى مكان الجريمة
Dialogue: 0,0:11:02.02,0:11:05.78,Default,,0,0,0,,.ثم تسلقت مجرى المياه عائداً إلى غرفتك
Dialogue: 0,0:11:05.78,0:11:08.86,Default,,0,0,0,,.نافذتي مرئية من موقف السيارات
Dialogue: 0,0:11:08.86,0:11:11.36,Default,,0,0,0,,.كان سيراني أحدهم
Dialogue: 0,0:11:11.36,0:11:16.36,Default,,0,0,0,,.بالضبط لهذا انتظرت لحظة عرض ساعة الدمى
Dialogue: 0,0:11:17.89,0:11:22.66,Default,,0,0,0,,عرض ساعة الدمى ذلك يحدث في نفس الوقت كل يوم
Dialogue: 0,0:11:22.66,0:11:29.54,Default,,0,0,0,,خلال ذلك الوقت حتى النزلاء في موقف السيارات يهرعون إلى الردهة
Dialogue: 0,0:11:30.22,0:11:32.75,Default,,0,0,0,,إذن يمكنك حل الألغاز دون نوم
Dialogue: 0,0:11:34.46,0:11:39.22,Default,,0,0,0,,.أنت محق تسللت من غرفتي باستخدام الطريقة التي وصفتها
Dialogue: 0,0:11:39.22,0:11:40.32,Default,,0,0,0,,كما توقعت
Dialogue: 0,0:11:40.32,0:11:43.18,Default,,0,0,0,,لكنني لم أذهب إلى البحيرة
Dialogue: 0,0:11:43.18,0:11:48.78,Default,,0,0,0,,لقد خرجت فقط لأتنفس بعض الهواء النقي دون أن يراني من أرسل الرسالة
Dialogue: 0,0:11:48.78,0:11:51.51,Default,,0,0,0,,وكأنني سأصدق ذلك
Dialogue: 0,0:11:51.51,0:11:52.69,Default,,0,0,0,,يا عمي
Dialogue: 0,0:11:52.69,0:11:53.69,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:11:53.69,0:11:59.45,Default,,0,0,0,,.هايبرا أخبرتني أن القيادة إلى البحيرة من هنا تستغرق ساعة
Dialogue: 0,0:11:59.98,0:12:01.49,Default,,0,0,0,,إذن ماذا؟
Dialogue: 0,0:12:01.49,0:12:04.89,Default,,0,0,0,,إذا غادر بعد استلام خدمة الغرفة
Dialogue: 0,0:12:04.89,0:12:07.87,Default,,0,0,0,,.لن يعود قبل الساعة التاسعة والنصف على أقرب تقدير
Dialogue: 0,0:12:09.27,0:12:12.14,Default,,0,0,0,,إذن استقل طائرة هليكوبتر أو شيئاً من هذا القبيل
Dialogue: 0,0:12:12.14,0:12:14.18,Default,,0,0,0,,.بهذه الطريقة سيعود في الوقت المناسب
Dialogue: 0,0:12:14.18,0:12:18.38,Default,,0,0,0,,لا أعتقد أن هذا الفندق لديه مهبط للطائرات العمودية
Dialogue: 0,0:12:18.38,0:12:23.39,Default,,0,0,0,,.والبروفيسور وهايبرا كانا سيلاحظان طائرة هليكوبتر
Dialogue: 0,0:12:24.57,0:12:27.10,Default,,0,0,0,,إذن لم أعد مشتبهاً به
Dialogue: 0,0:12:28.78,0:12:30.32,Default,,0,0,0,,.آسف على ذلك
Dialogue: 0,0:12:30.32,0:12:33.14,Default,,0,0,0,,غريزتي الاستنتاجية خذلتني
Dialogue: 0,0:12:35.53,0:12:39.20,Default,,0,0,0,,!لا بأس لكنك محققاً بارعاً
Dialogue: 0,0:12:39.20,0:12:41.41,Default,,0,0,0,,.أنا سعيد لأنني وظفتك سيد موري
Dialogue: 0,0:12:45.04,0:12:47.04,sign_1189_phone_text_messages,SIGN,0,0,0,,{\an8\frz12\3c&HF4F3F1&\blur0.3\pos(413,51)\xshad-1}!أيها البروفيسور، أسرفتَ في الطعام
Dialogue: 0,0:12:45.04,0:12:47.04,sign_1189_phone_text_messages,SIGN,0,0,0,,{\an2\frz12\fs14\3c&HF4F3F1&\shad0\bord0\blur0.3\pos(173,112)}هايبرا
Dialogue: 0,0:12:45.04,0:12:47.04,sign_1189_phone_text_messages,SIGN,0,0,0,,{\an8\frz12\3c&HF4F3F1&\blur0.3\pos(279,173)}سأكون هناك قريبًا
Dialogue: 0,0:12:47.04,0:12:50.65,Default,,0,0,0,,.حالما أُحدد من قد أرسل الرسالة...
Dialogue: 0,0:12:50.65,0:12:51.98,Default,,0,0,0,,!أنت تحت القبض
Dialogue: 0,0:12:53.18,0:12:55.62,Default,,0,0,0,,هل هذا الرجل فعل شيئاً سيئاً أليس كذلك؟
Dialogue: 0,0:12:55.62,0:12:57.93,Default,,0,0,0,,.لقد قبضت عليه من أجلك
Dialogue: 0,0:12:57.93,0:13:00.25,Default,,0,0,0,,...في الواقع ناتسومي
Dialogue: 0,0:13:10.81,0:13:13.23,Default,,0,0,0,,لحظة من فضلك ناتسومي
Dialogue: 0,0:13:13.93,0:13:16.48,Default,,0,0,0,,.هذا الرجل ليس رجلاً سيئاً
Dialogue: 0,0:13:16.81,0:13:17.98,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:13:18.30,0:13:23.68,Default,,0,0,0,,!نعم أؤكد لك لقد ارتكبت خطأ فادحاً في الاستنتاج
Dialogue: 0,0:13:23.68,0:13:27.91,Default,,0,0,0,,فهل يمكنكِ إعطائنا مفتاح الأصفاد؟
Dialogue: 0,0:13:28.92,0:13:30.11,Default,,0,0,0,,بالتأكيد
Dialogue: 0,0:13:30.51,0:13:31.64,Default,,0,0,0,,.شكراً لك
Dialogue: 0,0:13:31.64,0:13:32.56,Default,,0,0,0,,سأفتحها
Dialogue: 0,0:13:32.56,0:13:33.30,Default,,0,0,0,,لا سأفعل ذلك أنا
Dialogue: 0,0:13:33.30,0:13:34.50,Default,,0,0,0,,لا أنا سأفعل
Dialogue: 0,0:13:34.50,0:13:36.55,Default,,0,0,0,,!سأفعلها أنا
Dialogue: 0,0:13:41.50,0:13:44.37,Default,,0,0,0,,.تذكرت للتو أن لدي شيء لأفعله
Dialogue: 0,0:13:45.00,0:13:46.73,Default,,0,0,0,,مهلاً انتظر
Dialogue: 0,0:13:47.22,0:13:50.23,Default,,0,0,0,,.التقط المفتاح
Dialogue: 0,0:13:51.50,0:13:52.98,Default,,0,0,0,,.آسف أيها البروفيسور
Dialogue: 0,0:13:52.98,0:13:57.48,Default,,0,0,0,,شيء ما يقلقني لذلك أريد أن أتفقد مسرح الجريمة
Dialogue: 0,0:13:57.48,0:14:02.24,Default,,0,0,0,,تقصد أنك تشتبه في تانو ذلك؟
Dialogue: 0,0:14:02.24,0:14:04.49,Default,,0,0,0,,...نعم الحقيقة هي
Dialogue: 0,0:14:08.47,0:14:12.25,Default,,0,0,0,,من يتسلل من النافذة ليحمي نفسه؟
Dialogue: 0,0:14:12.52,0:14:15.63,Default,,0,0,0,,أليس كذلك؟ شيء ما مريب
Dialogue: 0,0:14:15.63,0:14:17.61,Default,,0,0,0,,لكن لديه حجة أليس كذلك؟
Dialogue: 0,0:14:17.61,0:14:18.75,Default,,0,0,0,,نعم
Dialogue: 0,0:14:18.75,0:14:21.03,Default,,0,0,0,,إذن لا يمكن أن يكون هو
Dialogue: 0,0:14:21.03,0:14:25.23,Default,,0,0,0,,لا يمكنه التلاعب بالوقت من العدم لمجرد أنه صانع ساعات
Dialogue: 0,0:14:28.97,0:14:31.56,Default,,0,0,0,,!وجدته وجدت المفتاح
Dialogue: 0,0:14:37.37,0:14:39.04,Default,,0,0,0,,.كاد أن نصل
Dialogue: 0,0:14:41.32,0:14:45.61,Default,,0,0,0,,.حتى بدون أي عقبات لا تزال الرحلة تستغرق ساعة
Dialogue: 0,0:14:46.22,0:14:51.24,Default,,0,0,0,,.إذن سيد فوروبوتشي غادر الاستوديو بعد السابعة
Dialogue: 0,0:14:51.24,0:14:54.53,Default,,0,0,0,,{\an8}.نعم قال إنه ذاهب لصيد السمك
Dialogue: 0,0:14:51.75,0:14:56.25,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(309,255)}(28)سوزويدا آوي 
Dialogue: 0,0:14:51.75,0:14:56.25,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(309,272)}تلميذة فوروبوتشي
Dialogue: 0,0:14:54.96,0:14:57.75,Default,,0,0,0,,{\an8}.ذكر أنه سيعود بحلول الساعة التاسعة
Dialogue: 0,0:14:57.75,0:15:01.31,Default,,0,0,0,,هل كان سيد فوروبوتشي يذهب لصيد السمك غالباً؟
Dialogue: 0,0:15:01.31,0:15:03.93,Default,,0,0,0,,.نعم غالباً في البحر مع ذلك
Dialogue: 0,0:15:03.93,0:15:06.69,Default,,0,0,0,,.فهمت شكراً لكِ
Dialogue: 0,0:15:06.69,0:15:08.76,Default,,0,0,0,,لا بدّ أن هذا يشكل صعوبة على طلابه
Dialogue: 0,0:15:09.10,0:15:11.15,Default,,0,0,0,,...صحيح
Dialogue: 0,0:15:11.76,0:15:16.83,Default,,0,0,0,,.الجميع يقولون إنها فرصة جيدة لإعادة تقييم حياتنا
Dialogue: 0,0:15:17.24,0:15:21.98,Default,,0,0,0,,.معلمنا كان غالباً يعاملنا بشكل غير عادل
Dialogue: 0,0:15:26.32,0:15:28.04,Default,,0,0,0,,يا آنسة
Dialogue: 0,0:15:30.43,0:15:34.29,Default,,0,0,0,,أي نوع من الأشياء الغير العادلة كان يفعلها معلمكم؟
Dialogue: 0,0:15:40.67,0:15:45.51,Default,,0,0,0,,إذا عانى سيد تانو من نفس المعاملة...
Dialogue: 0,0:15:46.07,0:15:49.47,Default,,0,0,0,,...حتى معلمي لم يكن ليستطيع ابتكارها أعني
Dialogue: 0,0:15:50.03,0:15:52.60,Default,,0,0,0,,.هذا سيفسر لماذا قال ذلك...
Dialogue: 0,0:15:52.60,0:15:55.85,sign_note,,0,0,0,,{\an5\pos(109,83)\fad(1,1)\fscx100\fscy100\p1\shad0\bord2\c&HE2AC6E&\3c&H645589&\4c&HA66921&}m 190 20 l 0 20 0 0 190 0
Dialogue: 1,0:15:52.60,0:15:55.85,sign_1189_fishing_shop,SIGN,0,0,0,,{\pos(109,83)\an5}معدات الصيد
Dialogue: 0,0:15:52.60,0:15:55.85,sign_note,,0,0,0,,{\an5\fad(1,1)\fscx100\fscy100\p1\shad0\bord2\c&HE2AC6E&\3c&H927653&\4c&H895736&\pos(325,230)}m 70 30 l 0 30 0 0 70 0
Dialogue: 1,0:15:52.60,0:15:55.85,sign_1189_fishing_shop,SIGN,0,0,0,,{\fs12\fnTrebuchet MS\c&H746057&\3c&HE2C7B9&\pos(325,230)}صنارات الصيد\N للإيجار
Dialogue: 1,0:15:57.60,0:16:03.11,sign_1189_fishing_shop,SIGN,0,0,0,,{\fs26\b1\bord2.5\blur0.3\fnTrebuchet MS\c&H604532&\3c&HEBCFCD&\shad0\pos(503,153)}صنارات الصيد\N للإيجار
Dialogue: 0,0:15:57.60,0:16:03.11,sign_note,,0,0,0,,{\an5\fad(1,1)\fscx100\fscy100\p1\xshad-7\yshad2\bord0.1\c&HE2AC6E&\3c&H927653&\4c&H895637&\pos(503,153)}m 150 60 l 0 60 0 0 150 0
Dialogue: 0,0:15:59.50,0:16:03.11,Default,,0,0,0,,أخبريني أيتها الجدة ليس لديكِ أي صنارات صيد بالخارج
Dialogue: 0,0:16:03.11,0:16:07.86,Default,,0,0,0,,.لا لا يمكنك صيد أي شيء في هذا الوقت من السنة
Dialogue: 0,0:16:08.22,0:16:09.61,Default,,0,0,0,,لا يمكنني؟
Dialogue: 0,0:16:12.70,0:16:17.37,Default,,0,0,0,,.إذن لماذا جاء سيد فوروبوتشي إلى هذه البحيرة بينما لا يوجد سمك للصيد
Dialogue: 0,0:16:22.10,0:16:23.25,Default,,0,0,0,,!أنت
Dialogue: 0,0:16:23.67,0:16:25.76,Default,,0,0,0,,.لا يمكنك الدخول هناك
Dialogue: 0,0:16:25.76,0:16:27.70,Default,,0,0,0,,.أنا آسف...
Dialogue: 0,0:16:27.70,0:16:30.26,Default,,0,0,0,,كونان أنت هنا أيضاً؟
Dialogue: 0,0:16:31.69,0:16:33.19,Default,,0,0,0,,نعم...
Dialogue: 0,0:16:33.81,0:16:35.14,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:16:35.14,0:16:39.12,Default,,0,0,0,,.هذه بتلات زهور كانت في القارب
Dialogue: 0,0:16:39.12,0:16:42.52,Default,,0,0,0,,.لا نعرف إن كانت مرتبطة بالقضية مع ذلك
Dialogue: 0,0:16:43.70,0:16:45.82,Default,,0,0,0,,.كانت هذه بتلات زهرة إيرانثيس بيناتيفيدا
Dialogue: 0,0:16:45.82,0:16:47.15,Default,,0,0,0,,إيرانثيس بيناتيفيدا؟
Dialogue: 0,0:16:47.15,0:16:53.45,Default,,0,0,0,,.نعم لكنها تفضل التربة القلوية لذلك لا تزهر هنا في الجوار
Dialogue: 0,0:16:53.45,0:16:54.95,Default,,0,0,0,,أنتِ تعرفين الكثير عنها
Dialogue: 0,0:16:54.95,0:16:58.49,Default,,0,0,0,,.كنت أفكر في الذهاب إلى هناك لرؤيتها
Dialogue: 0,0:16:59.16,0:17:02.92,sign_1189_map,SIGN,0,0,0,,{\an8\frz-18\fax-0.1\move(320,150,309,287)\fs9\t(\fs9,\fs16)} ساحة إرانثيس بيناتافيفيدا
Dialogue: 0,0:16:59.58,0:17:02.92,Default,,0,0,0,,هنا في الجوار هذا هو المكان الوحيد الذي تزهر فيه
Dialogue: 0,0:17:02.92,0:17:06.15,Default,,0,0,0,,.مما يعني أن سيد فوروبوتشي ذهب إلى هناك
Dialogue: 0,0:17:07.15,0:17:11.43,Default,,0,0,0,,.فهمت سيد تانو لم يتلاعب بالوقت
Dialogue: 0,0:17:11.43,0:17:12.93,Default,,0,0,0,,.لقد كانت المسافة
Dialogue: 0,0:17:15.18,0:17:18.85,Default,,0,0,0,,!تبا يا لها من كارثة
Dialogue: 0,0:17:18.85,0:17:20.39,Default,,0,0,0,,.أنت محق
Dialogue: 0,0:17:22.33,0:17:25.04,Default,,0,0,0,,.حسناً سأذهب لأغير ملابسي
Dialogue: 0,0:17:25.04,0:17:28.99,Default,,0,0,0,,.سأكون في المقهى
Dialogue: 0,0:17:31.89,0:17:33.26,Default,,0,0,0,,.لقد وصلت
Dialogue: 0,0:17:44.26,0:17:45.92,Default,,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:17:47.87,0:17:51.93,Default,,0,0,0,,أنت ذاهب لإخفاء دليل جريمة قتل سيد فوروبوتشي أليس كذلك؟
Dialogue: 0,0:17:51.93,0:17:54.13,Default,,0,0,0,,عـ-عم تتحدث؟
Dialogue: 0,0:17:54.13,0:17:55.43,Default,,0,0,0,,لدي حجة
Dialogue: 0,0:17:55.76,0:18:00.58,Default,,0,0,0,,.صحيح بما أنك شوهدت في الفندق في السابعة والنصف والتاسعة
Dialogue: 0,0:18:00.58,0:18:04.44,Default,,0,0,0,,.فمن المستحيل أنك قد قمت برحلة الذهاب والعودة إلى البحيرة التي تستغرق ساعة
Dialogue: 0,0:18:05.10,0:18:08.41,Default,,0,0,0,,!لكن ماذا عن مكان يبعد نصف ساعة من هنا
Dialogue: 0,0:18:08.85,0:18:11.69,Default,,0,0,0,,مثل جبال أوكوهو
Dialogue: 0,0:18:13.33,0:18:18.09,Default,,0,0,0,,.لقد دعوت سيد فوروبوتشي إلى الجبال لقتله
Dialogue: 0,0:18:18.09,0:18:22.56,Default,,0,0,0,,.على الأرجح هددت بكشف أنك صممت ساعة الدمى
Dialogue: 0,0:18:22.56,0:18:25.61,Default,,0,0,0,,ما لم يدفع لك فدية
Dialogue: 0,0:18:26.10,0:18:30.36,Default,,0,0,0,,.الطلاب الآخرون اشتكوا من أنه كان يعلن المشاريع باسمه الخاص
Dialogue: 0,0:18:30.36,0:18:33.72,Default,,0,0,0,,.عندما ينتجون عملاً جيداً
Dialogue: 0,0:18:33.72,0:18:37.47,Default,,0,0,0,,.لكن معلمي تم اكتشافه في بحيرة أوكوهو
Dialogue: 0,0:18:37.86,0:18:40.47,Default,,0,0,0,,.نعم مع معدات صيد
Dialogue: 0,0:18:40.86,0:18:41.94,Default,,0,0,0,,إذن...
Dialogue: 0,0:18:41.94,0:18:46.37,Default,,0,0,0,,.لكن ماذا لو أحضر سيد فوروبوتشي تلك المعدات عمداً
Dialogue: 0,0:18:46.37,0:18:49.73,Default,,0,0,0,,...ليوهم بأنه ذهب لصيد السمك في البحيرة
Dialogue: 0,0:18:50.47,0:18:54.24,Default,,0,0,0,,.على ما يبدو لا يمكن صيد أي شيء في تلك البحيرة في هذا الوقت من السنة
Dialogue: 0,0:18:54.76,0:18:59.78,Default,,0,0,0,,م-معلمي يمكن أن يكون غافلًا لا بد أنه ارتكب خطأ
Dialogue: 0,0:18:59.78,0:19:03.25,Default,,0,0,0,,بالإضافة إلى ذلك لم يكن هناك سبب له ليفعل ذلك
Dialogue: 0,0:19:03.25,0:19:05.20,Default,,0,0,0,,لكن كان هناك
Dialogue: 0,0:19:06.19,0:19:10.17,Default,,0,0,0,,لو كان سيد فوروبوتشي قد خطط لقتلك
Dialogue: 0,0:19:10.90,0:19:13.45,Default,,0,0,0,,خوفاً من اكتشاف انتحاله لأعمالك
Dialogue: 0,0:19:13.45,0:19:17.75,Default,,0,0,0,,على الأرجح كان قد خطط لصعقك ثم دفعك إلى الوادي
Dialogue: 0,0:19:18.18,0:19:21.39,Default,,0,0,0,,!كان هناك مسدس صعق كهربائي في جيب سيد فوروبوتشي
Dialogue: 0,0:19:23.39,0:19:27.76,Default,,0,0,0,,.لقد أعددتما كل منكما حجة لتستطيعا قتل بعضكما
Dialogue: 0,0:19:27.76,0:19:30.11,Default,,0,0,0,,.وجعل الأمر يبدو وكأنه حادث
Dialogue: 0,0:19:31.06,0:19:34.36,Default,,0,0,0,,.حجتك كانت أنك مقيّد في غرفتك بالفندق
Dialogue: 0,0:19:34.85,0:19:39.62,Default,,0,0,0,,وججة سيد فوروبوتشي كانت أنه ذهب لصيد السمك
Dialogue: 0,0:19:40.01,0:19:44.57,Default,,0,0,0,,.من الممكن أن تكون أنت من قُتل بدلاً منه
Dialogue: 0,0:19:44.57,0:19:48.49,Default,,0,0,0,,لكننك نجحت في قتله
Dialogue: 0,0:19:48.49,0:19:52.43,Default,,0,0,0,,ومع ذلك كان من المفترض أن يكون سيد فوروبوتشي عند البحيرة
Dialogue: 0,0:19:52.43,0:19:56.38,Default,,0,0,0,,موته لن يبدو كحادث إذا دفعته إلى الوادي
Dialogue: 0,0:19:56.88,0:20:02.39,Default,,0,0,0,,.لذا فقد حيرت عقلك بشدة وابتكرت فكرة
Dialogue: 0,0:20:03.01,0:20:06.06,Default,,0,0,0,,.عن طريق إعادة جثة سيد فوروبوتشي إلى البحيرة
Dialogue: 0,0:20:06.06,0:20:11.11,Default,,0,0,0,,.حتى لو انهارت حجتك سيصبح مسرح الجريمة
Dialogue: 0,0:20:11.11,0:20:16.40,Default,,0,0,0,,في مكان بعيد لساعة لا يمكنك زيارته
Dialogue: 0,0:20:16.73,0:20:23.41,Default,,0,0,0,,لـ-لكن إذا نقلت الجثة إلى البحيرة لم أكن لأستطيع العودة إلى الفندق بحلول الساعة التاسعة
Dialogue: 0,0:20:23.77,0:20:25.79,Default,,0,0,0,,أنت لم تنقل الجثة إلى هناك
Dialogue: 0,0:20:26.91,0:20:28.55,Default,,0,0,0,,.لقد كان النهر
Dialogue: 0,0:20:28.55,0:20:32.67,Default,,0,0,0,,.لقد وضعت جثة سيد فوروبوتشي في القارب وأرسلتها عبر النهر
Dialogue: 0,0:20:34.53,0:20:40.90,Default,,0,0,0,,.طوال هذا الوقت كنت أتساءل لماذا وضع الجاني الجثة في قارب
Dialogue: 0,0:20:40.90,0:20:45.09,Default,,0,0,0,,لكن عندما رأيت النهر يتدفق إلى البحيرة أدركت الأمر
Dialogue: 0,0:20:45.74,0:20:50.46,Default,,0,0,0,,.استخدم الجاني القارب الذي أحضره الضحية لتفبرك حجته
Dialogue: 0,0:20:50.46,0:20:53.56,Default,,0,0,0,,.لتفبرك حجته الخاصة الأكثر ثباتًا
Dialogue: 0,0:20:53.56,0:20:56.62,Default,,0,0,0,,لكن الهواء سريع جداً
Dialogue: 0,0:20:56.62,0:20:59.20,Default,,0,0,0,,.قارب بحيرة لا يمكنه الإبحار في ذلك النهر
Dialogue: 0,0:20:59.50,0:21:01.82,Default,,0,0,0,,ماذا لو كان لديه محرك؟
Dialogue: 0,0:21:01.82,0:21:04.99,Default,,0,0,0,,لكن هناك فقط قوارب تجديف في البحيرة!
Dialogue: 0,0:21:04.99,0:21:09.64,Default,,0,0,0,,!نعم لهذا أزلت المحرك الذي ركبه سيد فوروبوتشي
Dialogue: 0,0:21:09.64,0:21:14.00,Default,,0,0,0,,لأن قاربًا مزودًا بمحرك في هذه البحيرة\Nكان ليثير الشكوك
Dialogue: 0,0:21:16.11,0:21:20.17,Default,,0,0,0,,بعد العودة إلى الفندق قضيت معظم وقتك معي
Dialogue: 0,0:21:20.17,0:21:23.83,Default,,0,0,0,,لم يكن لديك وقت للتخلص من المحرك
Dialogue: 0,0:21:23.83,0:21:28.27,Default,,0,0,0,,.هل تمانع في فتح الغطاء الموضوع على مقعد الراكب
Dialogue: 0,0:21:31.59,0:21:32.56,Default,,0,0,0,,!تبا
Dialogue: 0,0:21:33.62,0:21:34.87,Default,,0,0,0,,!توقف مكانك
Dialogue: 0,0:21:36.01,0:21:37.65,Default,,0,0,0,,!لا تحاول المقاومة
Dialogue: 0,0:21:42.59,0:21:48.07,DC-ED,,0,0,0,,‫الوقت يمضي، مرة أخرى
Dialogue: 0,0:21:48.47,0:21:52.65,DC-ED,,0,0,0,,‫أن أصادف أزهار الكرز
Dialogue: 0,0:21:53.46,0:21:58.77,DC-ED,,0,0,0,,‫قلبي يترقّب قدومك بفارغ الصبر
Dialogue: 0,0:21:58.96,0:22:03.81,DC-ED,,0,0,0,,‫كالزهرة المتفتحة
Dialogue: 0,0:22:04.36,0:22:10.20,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:22:16.08,0:22:25.19,DC-ED,,0,0,0,,‫مشاعر الاشتياق التي لا تُقابل باللقاء
Dialogue: 0,0:22:26.74,0:22:30.63,DC-ED,,0,0,0,,‫تستمر بلا نهاية
Dialogue: 0,0:22:30.78,0:22:36.16,DC-ED,,0,0,0,,‫رغم محاولاتي المتكررة للنسيان
Dialogue: 0,0:22:37.52,0:22:39.57,DC-ED,,0,0,0,,‫أخبرتني
Dialogue: 0,0:22:39.57,0:22:42.63,DC-ED,,0,0,0,,‫كل المشاعر الدافئة
Dialogue: 0,0:22:42.63,0:22:47.03,DC-ED,,0,0,0,,‫لا تفارقني
Dialogue: 0,0:22:55.31,0:23:01.21,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:23:05.53,0:23:10.41,Default,,0,0,0,,.على أي حال لا أصدق أن سيد تانو هو من صنع هذه الساعة بالفعل
Dialogue: 0,0:23:10.87,0:23:16.87,Default,,0,0,0,,.لا بد أنه لم يستطع مسامحة سيد فوروبوتشي بعد أن فاز بتلك الجائزة
Dialogue: 0,0:23:16.87,0:23:21.67,Default,,0,0,0,,.أظن أن الوقت لا يشفي كل شيء
Dialogue: 0,0:23:23.57,0:23:25.14,Default,,0,0,0,,!لقد أبليتِ حسناً
Dialogue: 0,0:23:25.14,0:23:28.93,Default,,0,0,0,,.الجاني لم يهرب بفضل أصفادك
Dialogue: 0,0:23:29.23,0:23:32.68,Default,,0,0,0,,.هذا في الواقع أبطأه
Dialogue: 0,0:23:35.94,0:23:38.44,Default,,0,0,0,,!أنتما تحت القبض
Dialogue: 0,0:23:41.37,0:23:43.11,Default,,0,0,0,,رائع
Dialogue: 0,0:23:44.94,0:24:08.97,sign_episode_preview,SIGN,0,0,0,,في الحلقة القادمة 
Dialogue: 0,0:23:45.32,0:23:46.94,Default,,0,0,0,,يا كونان
Dialogue: 0,0:23:46.57,0:23:49.99,sign_1189_bridge_pont_koitani,SIGN,0,0,0,,{\an7\xshad5\yshad5\frz90\fnGeorgia\move(305,131,305,271)}فصل كويتاني
Dialogue: 0,0:23:46.94,0:23:49.99,Default,,0,0,0,,.هذا الجسر يُسمى جسر كويتاني
Dialogue: 0,0:23:49.99,0:23:53.49,Default,,0,0,0,,!لن أسمح لكِ أبداً بالزواج من ذلك الرجل
Dialogue: 0,0:23:53.84,0:23:57.33,Default,,0,0,0,,!لقد نفد صبري يا عمتي
Dialogue: 0,0:23:57.33,0:23:59.58,Default,,0,0,0,,الأنسة ساشييو مختفية؟
Dialogue: 0,0:23:59.86,0:24:04.34,Default,,0,0,0,,هل تعرفين أين قد تكون ذهبت الأنسة ساشييو؟
Dialogue: 0,0:24:04.34,0:24:08.97,Default,,0,0,0,,عليكِ أن تجعلي الأمر يبدو حقيقياً
Dialogue: 0,0:24:08.97,0:24:14.97,sign_next_episode,SIGN,0,0,0,,{\pos(320,35)}الحبيب الذي اختفى عند جسر كويتاني\Nفصل جولة توتوري
Dialogue: 0,0:24:09.24,0:24:10.74,Default,,0,0,0,,.الحلقة القادمة من كونان هي
Dialogue: 0,0:24:10.74,0:24:14.50,Default,,0,0,0,,"!الحبيب الذي اختفى عند جسر كويتاني - فصل جولة توتوري"
Dialogue: 0,0:24:29.99,0:24:34.91,sign_hint_label,SIGN,0,0,0,,{\an2\fnImpact\pos(320,300)}{\3c&HB2AEAB&}الضفدع
Dialogue: 0,0:24:30.36,0:24:32.50,Default,,0,0,0,,{\an8}.تلميح كونان القادم
Dialogue: 0,0:24:32.50,0:24:34.09,Default,,0,0,0,,{\an8}!الضفدع
Dialogue: 0,0:24:34.91,0:24:39.92,sign_dont_miss,SIGN,0,0,0,,{\an3\pos(603,314)} لا تفوتوا الحلقة القادمة 
Dialogue: 0,0:24:35.27,0:24:36.53,Default,,0,0,0,,{\an8}!الأسبوع القادم نحن في توتوري
Dialogue: 0,0:24:36.53,0:24:37.74,Default,,0,0,0,,{\an8}.احضروا هدايا تذكارية
