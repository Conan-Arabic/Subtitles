Dialogue: 0,0:14:26.80,0:14:31.00,عنوان,,0,0,0,,{\pos(699.666,634.667)}كوماي كينو ( ٣٥ ) \Nمرشدة الحافلة
Dialogue: 0,0:14:31.00,0:14:31.00,عنوان,,0,0,0,,
Dialogue: 0,0:14:26.80,0:14:31.00,Default,,0,0,0,,{\an7\pos(0,0)\fscx100\fscy100\p1}m 117 516 l 442 520 449 656 118 642
Dialogue: 0,0:14:26.80,0:14:31.00,عنوان,,0,0,0,,{\pos(273.333,634)} تيزوكا يوإيتشي ( ٢٩ )\N ضيف
Dialogue: 0,0:14:31.70,0:14:33.52,Default,,0,0,0,,
Dialogue: 0,0:14:31.31,0:14:33.48,Default,,0,0,0,,لا تترددي هكذا
Dialogue: 0,0:14:33.52,0:14:34.81,Default,,0,0,0,,فليوقفه أحد ما
Dialogue: 0,0:14:34.85,0:14:35.52,Default,,0,0,0,,أرجوكم
Dialogue: 0,0:14:35.56,0:14:36.85,Default,,0,0,0,,ساعدوني
Dialogue: 0,0:14:38.06,0:14:40.27,Default,,0,0,0,,{\pos(455.667,64.333)}أنت! أوقف ذلك حالاً
Dialogue: 0,0:14:40.27,0:14:40.41,Default,,0,0,0,,
Dialogue: 0,0:14:38.00,0:14:41.61,Default,,0,0,0,,{\an7\pos(0,0)\fscx100\fscy100\p1}m 122 524 l 468 520 472 664 128 644
Dialogue: 0,0:14:38.00,0:14:41.61,عنوان,,0,0,0,,{\pos(295,647)}موريتسوجو كوهي\N ( ٥٥ ) ضيف
Dialogue: 0,0:14:42.01,0:14:42.15,عنوان,,0,0,0,,
Dialogue: 0,0:14:40.41,0:14:42.15,Default,,0,0,0,,{\pos(395.667,278)}ذلك يهينها
Dialogue: 0,0:14:42.15,0:14:43.57,Default,,0,0,0,,ما الذي قلته ؟
Dialogue: 0,0:14:43.65,0:14:46.66,Default,,0,0,0,,أحاول أن أحصل على بعض المتعة هنا
Dialogue: 0,0:14:46.70,0:14:47.99,Default,,0,0,0,,توقف عن مضايقتي
Dialogue: 0,0:14:57.96,0:14:59.59,Default,,0,0,0,,الأشخاص الذين لقوا حتفهم في ذلك الحادث
Dialogue: 0,0:15:00.30,0:15:02.21,Default,,0,0,0,,الرجل الذي تحرش بها
Dialogue: 0,0:15:02.92,0:15:05.30,Default,,0,0,0,,و الضيف الذي حاول مساعدتها
Dialogue: 0,0:15:06.18,0:15:09.72,Default,,0,0,0,,و الأشخاص الذين نجوا بأعجوبة كانوا القرويون الثمانية
Dialogue: 0,0:15:13.02,0:15:14.14,Default,,0,0,0,,في نهاية الأمر
Dialogue: 0,0:15:14.14,0:15:15.81,Default,,0,0,0,,تكتم الجميع على الأمر
Dialogue: 0,0:15:16.69,0:15:20.06,Default,,0,0,0,,و السبب الرئيسي في الحادثة أنهما تعاركا بعنف هنا
Dialogue: 0,0:15:20.48,0:15:23.40,Default,,0,0,0,,و نسيا قوانين العنف في الحافلة
Dialogue: 0,0:15:23.65,0:15:25.24,Default,,0,0,0,,و المسافرون الذين رأوه يموت
Dialogue: 0,0:15:27.45,0:15:29.20,Default,,0,0,0,,و الكل يجب أن يعلم أنني بعد أن قلت هذا الكلام
Dialogue: 0,0:15:29.82,0:15:31.95,Default,,0,0,0,,المجرم في هذه القضية
Dialogue: 0,0:15:32.41,0:15:34.95,Default,,0,0,0,,عائلة ذلك الشجاع
Dialogue: 0,0:15:34.95,0:15:36.87,Default,,0,0,0,,السيد [ موريتسوجو كوهي ]
Dialogue: 0,0:15:37.87,0:15:38.83,Default,,0,0,0,,الدافع كان الانتقام
Dialogue: 0,0:15:39.38,0:15:41.34,Default,,0,0,0,,أليس كذلك... آنسة [ توكو ] ؟
Dialogue: 0,0:15:43.05,0:15:45.46,Default,,0,0,0,,اسم [ ناتسومي ] سمتك به والدتك ، صحيح ؟
Dialogue: 0,0:15:46.09,0:15:48.01,Default,,0,0,0,,اسمك الحقيقي هو [ موريتسوجو توكو ]
Dialogue: 0,0:15:48.97,0:15:49.97,Default,,0,0,0,,ماذا ؟ الآنسة [ توكو ] هي
Dialogue: 0,0:15:50.30,0:15:51.93,Default,,0,0,0,,من عائلة ذلك المسافر ؟
Dialogue: 0,0:15:52.85,0:15:54.18,Default,,0,0,0,,ما الذي تقوله ؟
Dialogue: 0,0:15:54.22,0:15:58.35,Default,,0,0,0,,قاتل السيد [ أوكومورا ] و رئيس القرية [ فوناكي ] على الحافلة ؟
Dialogue: 0,0:15:58.69,0:16:00.85,Default,,0,0,0,,إذا من هو القاتل الحقيقي ؟
Dialogue: 0,0:16:01.02,0:16:02.48,Default,,0,0,0,,لا أعلم ذلك
Dialogue: 0,0:16:02.65,0:16:06.11,Default,,0,0,0,,و لكنني أعلم أن الحافلة على حافة الخطر و المكابح معطلة به
Dialogue: 0,0:16:06.65,0:16:09.15,Default,,0,0,0,,أنت اتصل بالقسم حالاً
Dialogue: 0,0:16:09.24,0:16:09.53,Default,,0,0,0,,حاضر سيدي
Dialogue: 0,0:16:10.16,0:16:11.03,Default,,0,0,0,,عذراً
Dialogue: 0,0:16:11.03,0:16:13.08,Default,,0,0,0,,ذلك الولد على تلك الحافلة أيضاً
Dialogue: 0,0:16:14.16,0:16:15.66,Default,,0,0,0,,ماذا ؟ لماذا [ كونان ] ؟
Dialogue: 0,0:16:19.75,0:16:24.29,Default,,0,0,0,,الآنسة [ توكو ] أتت إلى هذه القرية لمعرفة سبب وفاة والدها
Dialogue: 0,0:16:24.46,0:16:27.01,Default,,0,0,0,,تابعت تحرياتها و تحقيقاتها إلى أن وصلت إلى النتيجة
Dialogue: 0,0:16:27.80,0:16:32.47,Default,,0,0,0,,من الممكن أن وصلت إليها من زميلها ، السيد [ كاجيتا ] ، عندما زلَّ لسانهِ
Dialogue: 0,0:16:35.89,0:16:37.47,Default,,0,0,0,,فجأة ودون سابق إنذار
Dialogue: 0,0:16:37.48,0:16:38.98,Default,,0,0,0,,واحد من المسافرين
Dialogue: 0,0:16:38.98,0:16:43.65,Default,,0,0,0,,تم اتهام السيد [ يابي ] بجريمة القتل التي حدثت بالقرية و تم حبسهِ
Dialogue: 0,0:16:44.36,0:16:50.20,Default,,0,0,0,,الآنسة [ توكو ] علمت أن ركاب الحافلة اليوم هم فيه إما لتسوق أو عمل
Dialogue: 0,0:16:50.57,0:16:53.53,Default,,0,0,0,,فعبثت بالمكابح لقتلهم جميعاً
Dialogue: 0,0:16:54.78,0:16:56.24,Default,,0,0,0,,في موقع الحادثة ذاتها منذ سبعة سنين مضت
Dialogue: 0,0:16:59.62,0:17:01.46,Default,,0,0,0,,أليس كذلك ، آنسة [ توكو ] ؟
Dialogue: 0,0:17:04.17,0:17:05.04,Default,,0,0,0,,مستحيل
Dialogue: 0,0:17:06.59,0:17:08.96,Default,,0,0,0,,لا أعلم عما تتحدث
Dialogue: 0,0:17:09.38,0:17:10.92,Default,,0,0,0,,التصرف كالبلهاء لن ينفع
Dialogue: 0,0:17:11.51,0:17:13.84,Default,,0,0,0,,لماذا أنت هادئة هكذا ؟
Dialogue: 0,0:17:14.80,0:17:16.68,Default,,0,0,0,,لقد أيقنت بالأمر مسبقا ً صحيح ؟
Dialogue: 0,0:17:17.27,0:17:18.68,Default,,0,0,0,,أنك أنت و مع الجميع
Dialogue: 0,0:17:32.24,0:17:33.53,Default,,0,0,0,,يالك من طفل
Dialogue: 0,0:17:33.91,0:17:35.20,Default,,0,0,0,,اخرج من الحافلة [ كونان ]
Dialogue: 0,0:17:35.49,0:17:37.87,Default,,0,0,0,,فمن المتوقع أن تنخفض سرعتها عن المنعطف التالي بسهولة
Dialogue: 0,0:17:37.91,0:17:38.74,Default,,0,0,0,,إن فعلتها صحيحاً
Dialogue: 0,0:17:38.75,0:17:39.79,Default,,0,0,0,,فستصاب فقط
Dialogue: 0,0:17:40.46,0:17:43.62,Default,,0,0,0,,إذا أنت تعترفين بجريمتك ؟
Dialogue: 0,0:17:44.08,0:17:45.63,Default,,0,0,0,,نعم أعترف
Dialogue: 0,0:17:45.71,0:17:49.59,Default,,0,0,0,,أنا هي من قتلت السيد [ أوكومورا ] و السيد [ فوناكي ]
Dialogue: 0,0:17:51.76,0:17:56.51,Default,,0,0,0,,حقنت سما في عبوة السيد [ أوكومورا ] ، و بعد ذلك انتظرت
Dialogue: 0,0:17:57.18,0:17:59.93,Default,,0,0,0,,و طعنت السيد [ فوناكي ] في الظلام عند المعبد
Dialogue: 0,0:18:01.89,0:18:03.02,Default,,0,0,0,,هذا صحيح
Dialogue: 0,0:18:03.02,0:18:08.02,Default,,0,0,0,,لقد عدت لأثأر من كل شخص كان على هذه الحافلة
Dialogue: 0,0:18:08.98,0:18:11.36,Default,,0,0,0,,والدي كان أشجع من الرجل العادي
Dialogue: 0,0:18:11.65,0:18:16.53,Default,,0,0,0,,مساعدة شخص كان في أمس الحاجة كانت من صفاته المعتادة
Dialogue: 0,0:18:17.37,0:18:19.24,Default,,0,0,0,,و لكن في تلك الأثناء
Dialogue: 0,0:18:19.29,0:18:22.08,Default,,0,0,0,,إن وقف أحدكم وساعد والدي
Dialogue: 0,0:18:25.08,0:18:27.25,Default,,0,0,0,,أسرع واقفز من الحافلة
Dialogue: 0,0:18:28.46,0:18:29.75,Default,,0,0,0,,لقد تأخرت بالفعل
Dialogue: 0,0:18:30.09,0:18:31.80,Default,,0,0,0,,حتى إن تركتني أذهب
Dialogue: 0,0:18:32.26,0:18:35.80,Default,,0,0,0,,لن يغير حقيقة أنك قتلت الشخص الخطأ
Dialogue: 0,0:18:37.51,0:18:39.97,Default,,0,0,0,,الضحية الأولى كانت السيد [ أوكومورا ]
Dialogue: 0,0:18:39.97,0:18:43.68,Default,,0,0,0,,لم يكن موجودًا في الحادثة قبل سبعة سنين
Dialogue: 0,0:18:44.06,0:18:45.44,Default,,0,0,0,,ماذا ؟
Dialogue: 0,0:18:45.85,0:18:46.90,Default,,0,0,0,,لا يمكن
Dialogue: 0,0:18:47.77,0:18:50.36,Default,,0,0,0,,کمرشدة للحافلة عندما تراه كل يوم
Dialogue: 0,0:18:50.36,0:18:52.19,Default,,0,0,0,,كان يجب عليك أن تعلمي
Dialogue: 0,0:18:52.86,0:18:56.07,Default,,0,0,0,,هذا المقعد كان لي الأربعين عامًا الماضية
Dialogue: 0,0:18:57.12,0:19:01.87,Default,,0,0,0,,إن كان الشخص يقول أن الناس يسألونه عن الحادث الذي كان منذ سبعة أعوام مضت
Dialogue: 0,0:19:02.95,0:19:03.66,Default,,0,0,0,,فسألته أنت ، صحيح ؟
Dialogue: 0,0:19:03.91,0:19:06.12,Default,,0,0,0,,بالطبع ، فقد تأكدت بذلك منه شخصياً
Dialogue: 0,0:19:06.92,0:19:08.58,Default,,0,0,0,,سبع سنوات مضت ؟
Dialogue: 0,0:19:08.67,0:19:11.34,Default,,0,0,0,,كنت و بلا شك جالسًا هنا
Dialogue: 0,0:19:11.55,0:19:13.21,Default,,0,0,0,,"فهذا مقعدي " أنا
Dialogue: 0,0:19:13.84,0:19:15.67,Default,,0,0,0,,لقد أكد على ذلك
Dialogue: 0,0:19:16.13,0:19:17.47,Default,,0,0,0,,و لكن في ذلك اليوم
Dialogue: 0,0:19:17.47,0:19:21.14,Default,,0,0,0,,السيد [ أوكومورا ] كان يعاني من الحمّى و نائما ًبالمنزل
Dialogue: 0,0:19:21.89,0:19:24.35,Default,,0,0,0,,واسمه لم يذكر في الصحف أيضاً
Dialogue: 0,0:19:25.19,0:19:25.85,Default,,0,0,0,,مست.... مستحيل
Dialogue: 0,0:19:26.48,0:19:28.81,Default,,0,0,0,,لقد راجعت الصحف أيضاً
Dialogue: 0,0:19:29.15,0:19:32.90,Default,,0,0,0,,لقد كنت واثقة مما جعلك تظنين أن اسمه كان مذكورًا
Dialogue: 0,0:19:33.99,0:19:36.49,Default,,0,0,0,,إذا... المسافر العاشر كان
Dialogue: 0,0:19:36.99,0:19:40.12,Default,,0,0,0,,المسافر العاشر توفي منذ عامين بسبب مرض ما كان يعاني منه
Dialogue: 0,0:19:40.74,0:19:45.87,Default,,0,0,0,,مما يعني ، السيد [ أوكومورا ] لم يكن له أي سبب في وفاة والدك
Dialogue: 0,0:19:52.13,0:19:55.13,Default,,0,0,0,,لقد سامحت المضيفة من فندق [ كوماي ] ، صحيح ؟
Dialogue: 0,0:19:57.43,0:19:58.38,Default,,0,0,0,,صحيح... ذلك الشخص
Dialogue: 0,0:20:02.01,0:20:03.26,Default,,0,0,0,,أنا آسفة جداً
Dialogue: 0,0:20:07.35,0:20:08.89,Default,,0,0,0,, بعد أن رأيت ذلك
Dialogue: 0,0:20:09.86,0:20:12.11,Default,,0,0,0,,لم أستطع أن ألحق أذى بها
Dialogue: 0,0:20:13.19,0:20:14.90,Default,,0,0,0,,ليس المضيفة فقط
Dialogue: 0,0:20:15.19,0:20:17.36,Default,,0,0,0,,بل كل من يتعلق بالحادثة
Dialogue: 0,0:20:17.65,0:20:21.07,Default,,0,0,0,,كانوا يعيشون في ندم مما حدث ولا يستطيعون إخبار أحد عنه
Dialogue: 0,0:20:25.41,0:20:27.20,Default,,0,0,0,,نحن آسفون ، [ توكو ]
Dialogue: 0,0:20:27.33,0:20:29.79,Default,,0,0,0,,و كله لأنه لم تكن لدينا الشجاعة لـ
Dialogue: 0,0:20:30.58,0:20:31.42,Default,,0,0,0,,كما ترين
Dialogue: 0,0:20:31.42,0:20:32.54,Default,,0,0,0,,سامحينا
Dialogue: 0,0:20:38.63,0:20:41.64,Default,,0,0,0,,إن اصطدمنا في الموقع هذا
Dialogue: 0,0:20:42.18,0:20:44.72,Default,,0,0,0,,والد [ توكو ] سيرتاح أخيرًا بسلام
Dialogue: 0,0:20:47.23,0:20:48.77,Default,,0,0,0,,كلا! لا علاقة لـ [ كونان ] بما حدث
Dialogue: 0,0:20:48.85,0:20:49.69,Default,,0,0,0,,افعل شيئاً
Dialogue: 0,0:20:50.15,0:20:51.35,Default,,0,0,0,,مستحيل
Dialogue: 0,0:20:51.44,0:20:52.98,Default,,0,0,0,,حتى إن استطعت المرور من المنعطف القادم
Dialogue: 0,0:20:53.02,0:20:54.86,Default,,0,0,0,,فلن أستطيع أبدًا أن أعبر قرب منعطف الحادثة
Dialogue: 0,0:20:55.86,0:20:57.74,Default,,0,0,0,,لا تستطيع الاستسلام إلا في النهاية
Dialogue: 0,0:20:59.53,0:20:59.78,Default,,0,0,0,,لابد من وجود طريقة ما لإيقاف هذا الشيء
Dialogue: 0,0:21:04.49,0:21:05.49,Default,,0,0,0,,الطريق الوعر
Dialogue: 0,0:21:05.54,0:21:07.12,Default,,0,0,0,,دع العجلات على الطريق الوعر
Dialogue: 0,0:21:10.96,0:21:11.83,Default,,0,0,0,,لا فائدة
Dialogue: 0,0:21:11.96,0:21:13.50,Default,,0,0,0,,فسنظل نسرع هكذا
Dialogue: 0,0:21:14.09,0:21:14.84,Default,,0,0,0,,صحيح
Dialogue: 0,0:21:14.84,0:21:18.80,Default,,0,0,0,,حزام الطاقة الذي صنعه البروفيسور... لابد أن يكون مفيدًا
Dialogue: 0,0:21:32.35,0:21:33.85,Default,,0,0,0,,أظن أن عشرة أطنان كثيرة جداً
Dialogue: 0,0:21:49.37,0:21:50.91,Default,,0,0,0,,لقد توقف
Dialogue: 0,0:21:59.34,0:22:00.51,Default,,0,0,0,,[ كونان ]
Dialogue: 0,0:22:00.51,0:22:01.72,Default,,0,0,0,,من في العالم كان يتوقع
Dialogue: 0,0:22:02.43,0:22:04.39,Default,,0,0,0,,أنا متحر أزعج البعض فقط
Dialogue: 0,0:22:05.64,0:22:07.10,Default,,0,0,0,,شكرًا لك
Dialogue: 0,0:22:07.10,0:22:08.68,Default,,0,0,0,,أيها المتحر الصغير
Dialogue: 0,0:22:10.23,0:22:12.44,Default,,0,0,0,,توقف عن إثارة قلقنا
Dialogue: 0,0:22:12.48,0:22:14.02,Default,,0,0,0,,ذلك مؤلم
Dialogue: 0,0:23:47.32,0:23:48.78,Default,,0,0,0,,تم حل القضية
Dialogue: 0,0:23:49.24,0:23:50.03,Default,,0,0,0,,و الآن
