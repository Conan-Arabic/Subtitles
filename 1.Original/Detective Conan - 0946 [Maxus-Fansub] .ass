Dialogue: 0,0:00:20.51,0:00:23.87,DCMain,UMEKI,0,0,0,,{\an8}إشارتي ضعيفة، لم أستطع للأسف
Dialogue: 0,0:00:24.04,0:00:27.45,DCMain,KAHO,0,0,0,,{\fad(250,250)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\pos(604,720)\clip(538,580,812,694)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:00:24.06,0:00:27.45,Names,TEXT,0,0,0,,{\fad(214,382)\fs33\pos(674,664)}ميزوساوا شو - 25 عامًا\Nموظف بشركة (نونوغاكي) للعقارات
Dialogue: 0,0:00:24.31,0:00:26.30,DCMain,UMEKI,0,0,0,,{\an8}هي يمكنك تجربة هاتفك؟
Dialogue: 0,0:00:26.30,0:00:27.65,DCMain,MIZUSAWA,0,0,0,,{\an8}حسنًا
Dialogue: 0,0:00:29.86,0:00:31.68,DCMain,UMEKI,0,0,0,,احذر، الأرض زلقة
Dialogue: 0,0:00:31.68,0:00:33.07,DCMain,MIZUSAWA,0,0,0,,أجل، أجل يا سيدي
Dialogue: 0,0:00:36.68,0:00:39.51,DCMain,UMEKI,0,0,0,,أسوأ جفاف منذ خمسين عامًا، أليس كذلك؟
Dialogue: 0,0:02:50.02,0:02:56.01,DCEpTitle,EPTITLE,0,0,0,,{\fad(400,1)}دموع (بورجيا) الملعونة\N\N\N\N\N\N\N الجزء الأول
Dialogue: 0,0:02:56.84,0:03:02.53,DCFlashback,ANNOUNCER,0,0,0,,هل تتذكرون قضية دموع بورجيا الملعونة؟
Dialogue: 0,0:03:03.81,0:03:07.12,DCMain,ANNOUNCER,0,0,0,,{\an8}منذ أربعين عامًا، بمدينة (بيكا) التي تواجدت بها شركة تلفاز (ياماتو)
Dialogue: 0,0:03:06.08,0:03:10.61,DCMain,KAHO,0,0,0,,{\fad(250,250)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\pos(604,720)\clip(504,580,726,696)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:03:06.31,0:03:10.61,Names,TEXT,0,0,0,,{\fad(167,295)\pos(616,672)}مقر تلفاز (ياماتو) القديم \N حوالي عام 1975
Dialogue: 0,0:03:07.12,0:03:11.04,DCFlashback,,0,0,0,,{\an8}حيث قرروا عمل دراما تلفاز احتفالًا بعيدهم الخامس
Dialogue: 0,0:03:11.04,0:03:17.06,DCFlashback,ANNOUNCER,0,0,0,,اختفت واحدة من طاقم العمل وهي تحمل الخاتم معها
Dialogue: 0,0:03:17.06,0:03:21.05,DCFlashback,,0,0,0,,وبداخله جوهرة تعرف باسم (دموع بورجيا)
Dialogue: 0,0:03:21.20,0:03:28.30,Suspect is,TEXT,0,0,0,,المتهمة هي [سايكي يوري] - 30 عامًا -، مساعدة الممثلة [آساهينا ناغيسا]؟
Dialogue: 0,0:03:21.20,0:03:28.30,Newspaper Right Side,TEXT,0,0,0,,{\frz90.37\pos(960,206)}هربت مع دموع بورجيا؟
Dialogue: 0,0:03:21.20,0:03:28.30,Newspaper Left Side,TEXT,0,0,0,,{\frz89.8\pos(130,526)}جعلت الصدمة  [آساهينا ناغيسا] منهارة تمامًا
Dialogue: 0,0:03:21.66,0:03:28.31,DCFlashback,ANNOUNCER,0,0,0,,والآن، تم إيجاد المتهمة بعد أربعين عامًا
Dialogue: 0,0:03:29.38,0:03:33.38,DCFlashback,ANNOUNCER,0,0,0,,في هيئة هيكل عظمي، بقاع سدّ جاف
Dialogue: 0,0:03:35.27,0:03:37.32,DCMain,SUMIRE,0,0,0,,"لقد قتلتهم"
Dialogue: 0,0:03:37.32,0:03:38.53,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:03:39.10,0:03:42.42,DCMain,SUMIRE,0,0,0,,{\pos(640,80)}إنه عنوان المسلسل الذي كانوا يمثلوه
Dialogue: 0,0:03:39.19,0:03:42.66,DCMain,KAHO,0,0,0,,{\fad(250,250)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\clip(504,580,770,696)\pos(626,714)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:03:39.21,0:03:42.60,Names,TEXT,0,0,0,,{\fad(217,378)\pos(638,665)}سايكي سوميري - 20 عامًا\Nحفيدة سايكي يوري
Dialogue: 0,0:03:42.42,0:03:47.03,DCMain,,0,0,0,,{\an8}عندما ادعوا أن جدتي هربت مع الخاتم
Dialogue: 0,0:03:47.89,0:03:49.37,DCMain,KOGORO,0,0,0,,فهمت
Dialogue: 0,0:03:49.37,0:03:53.84,DCMain,SUMIRE,0,0,0,,في ذاك الوقت، كانت جدتي تعيش هنا في (بيكا)
Dialogue: 0,0:03:53.84,0:03:57.29,DCMain,,0,0,0,,لكن بعد الذي حدث، هجرت العائلة المدينة
Dialogue: 0,0:03:57.29,0:04:01.47,DCMain,,0,0,0,,وذلك ليلًا، بسبب الضجة التي أحدثها الإعلام
Dialogue: 0,0:04:01.89,0:04:09.89,DCMain,SUMIRE,0,0,0,,!لكن لم يكن الخاتم في السيارة مع جدتي
Dialogue: 0,0:04:09.89,0:04:11.48,DCMain,SUMIRE,0,0,0,,..بالإضافة إلى أنها
Dialogue: 0,0:04:11.80,0:04:15.15,DCMain,KOGORO,0,0,0,,ماتت إثر طعنة بسكين تقطيع فاكهة
Dialogue: 0,0:04:15.15,0:04:17.09,DCMain,RAN,0,0,0,,ماذا؟ حقًا؟
Dialogue: 0,0:04:17.09,0:04:20.04,DCMain,CONAN,0,0,0,,لم يذكروا هذا بالأخبار
Dialogue: 0,0:04:20.04,0:04:20.90,DCMain,KOGORO,0,0,0,,أجل
Dialogue: 0,0:04:21.38,0:04:25.80,DCMain,KOGORO,0,0,0,,[ميزوساوا] الذي وجدها؛ يشرب معي من حين لآخر
Dialogue: 0,0:04:26.71,0:04:29.53,DCMain,SUMIRE,0,0,0,,!جدتي ضحية
Dialogue: 0,0:04:29.53,0:04:32.75,DCMain,SUMIRE,0,0,0,,!أحدهم سرق الخاتم منها ثم طعنها وتركها لتموت
Dialogue: 0,0:04:35.27,0:04:38.99,DCMain,SUMIRE,0,0,0,,بالتأكيد كان هذا منذ أربعين عامًا
Dialogue: 0,0:04:39.45,0:04:41.56,DCMain,,0,0,0,,لذلك أعلم أن الوضع صعب
Dialogue: 0,0:04:42.14,0:04:45.26,DCMain,SUMIRE,0,0,0,,..لكن على الأقل إذا يمكنك تبرئة ساحة جدتي
Dialogue: 0,0:04:47.96,0:04:49.14,DCMain,KOGORO,0,0,0,,حسنًا
Dialogue: 0,0:04:51.16,0:04:55.88,Mori Detective Agency,SIGN,0,0,0,,وكالة موري للتحريات
Dialogue: 0,0:04:51.59,0:04:52.54,DCMain,KOGORO,0,0,0,,أجل
Dialogue: 0,0:04:53.12,0:04:55.89,DCMain,,0,0,0,,أجل، توقعت ذلك أيضًا
Dialogue: 0,0:04:55.89,0:04:57.38,DCMain,KOGORO,0,0,0,,أتفهم ذلك
Dialogue: 0,0:04:57.88,0:05:00.18,DCMain,,0,0,0,,شكرًا أيها المفتش
Dialogue: 0,0:05:00.70,0:05:01.84,DCMain,KOGORO,0,0,0,,وداعًا
Dialogue: 0,0:05:03.31,0:05:05.44,DCMain,SUMIRE,0,0,0,,ماذا قالت الشرطة؟
Dialogue: 0,0:05:05.44,0:05:09.66,DCMain,KOGORO,0,0,0,,إنها قضية قديمة منذ أربعين عامًا
Dialogue: 0,0:05:09.66,0:05:13.19,DCMain,KOGORO,0,0,0,,وليس هذا فقط، وقتها كانت الجثة أسفل المياه
Dialogue: 0,0:05:13.19,0:05:15.79,DCMain,KOGORO,0,0,0,,مما يعني أن الأدلة شحيحة جدًا هنا
Dialogue: 0,0:05:17.30,0:05:22.58,DCMain,KOGORO,0,0,0,,ونظرًا لذلك، لن يستطيعوا تحديد إذا تم
Dialogue: 0,0:05:22.58,0:05:25.80,DCMain,,0,0,0,,قتل جدتك [سايكي يوري-سان] أم لا
Dialogue: 0,0:05:25.80,0:05:28.18,DCMain,SUMIRE,0,0,0,,..لكن السكين
Dialogue: 0,0:05:28.44,0:05:34.43,DCMain,KOGORO,0,0,0,,بالتأكيد قضت السكين على حياتها
Dialogue: 0,0:05:34.43,0:05:38.19,DCMain,KOGORO,0,0,0,,..لكن من الممكن، مثلًا
Dialogue: 0,0:05:38.19,0:05:41.94,DCMain,,0,0,0,,أنها ندمت على سرقة الخاتم، وقررت الانتحار
Dialogue: 0,0:05:42.21,0:05:43.19,DCMain,SUMIRE,0,0,0,,..مستحيل
Dialogue: 0,0:05:43.54,0:05:44.74,DCMain,KOGORO,0,0,0,,آسف جدًا
Dialogue: 0,0:05:50.45,0:05:54.67,DCMain,RAN,0,0,0,,آسفة أننا لم نستطع المساعدة يا [سوميري-سان]
Dialogue: 0,0:05:54.67,0:05:58.74,DCMain,SUMIRE,0,0,0,,لا بأس، أنا أتفهم [موري-سان]
Dialogue: 0,0:05:58.74,0:06:02.24,DCMain,SUMIRE,0,0,0,,..لكن بالتفكير في مدى حزن والدتي
Dialogue: 0,0:06:03.20,0:06:04.78,DCMain,CONAN,0,0,0,,[سوميري-سان]
Dialogue: 0,0:06:05.68,0:06:11.01,DCMain,CONAN,0,0,0,,لماذا شكّوا في جدتك أنها هربت بالخاتم؟
Dialogue: 0,0:06:11.22,0:06:13.34,DCMain,RAN,0,0,0,,![كونان-كن]
Dialogue: 0,0:06:13.34,0:06:18.30,DCMain,SUMIRE,0,0,0,,كانت مهمتها هي نقل الخاتم من مركز (ياماتو)
Dialogue: 0,0:06:18.30,0:06:22.09,DCMain,,0,0,0,,في مدينة (بيكا)، إلى السد حيث كان يتم التصوير
Dialogue: 0,0:06:22.53,0:06:27.03,DCMain,SUMIRE,0,0,0,,فُقدت بعد أن تركت الاستوديو مباشرة
Dialogue: 0,0:06:27.32,0:06:30.66,DCMain,CONAN,0,0,0,,كان مقر المحطة بداخل مبنى المنارة الجوية
Dialogue: 0,0:06:30.66,0:06:34.13,DCMain,,0,0,0,,الذي يتم هدمه الآن، صحيح؟
Dialogue: 0,0:06:34.13,0:06:35.54,DCMain,CONAN,0,0,0,,لماذا لا نتجه هناك الآن؟
Dialogue: 0,0:06:37.54,0:06:40.04,Safety First,SIGN,0,0,0,,{\pos(461,277)}الأمان أولًا
Dialogue: 0,0:06:37.54,0:06:40.04,Beika Tower Building,SIGN,0,0,0,,{\pos(501,521)}مشروع تطوير مبنى برج (بيكا)
Dialogue: 0,0:06:44.01,0:06:46.85,DCMain,SUMIRE,0,0,0,,لا يوجد أثر لها
Dialogue: 0,0:06:46.85,0:06:48.05,DCMain,RAN,0,0,0,,أجل
Dialogue: 0,0:06:48.33,0:06:51.55,DCMain,SUMIRE,0,0,0,,ستحزن أمي إذا علمت ذلك
Dialogue: 0,0:06:52.69,0:06:54.44,DCMain,SUMIRE,0,0,0,,آسفة
Dialogue: 0,0:06:54.96,0:06:56.17,DCMain,FEDORA,0,0,0,,![يوري-تشان]
Dialogue: 0,0:06:56.17,0:06:56.81,DCMain,SUMIRE,0,0,0,,ماذا؟
Dialogue: 0,0:06:57.17,0:07:01.57,DCMain,FEDORA,0,0,0,,معذرة، تشبهين إحدى معارفي القدامى
Dialogue: 0,0:07:01.57,0:07:06.04,DCMain,SUMIRE,0,0,0,,هل تقصد [سايكي يوري]؟
Dialogue: 0,0:07:06.04,0:07:06.69,DCMain,FEDORA,0,0,0,,ماذا؟
Dialogue: 0,0:07:07.07,0:07:10.07,DCMain,SUMIRE,0,0,0,,إنها جدتي
Dialogue: 0,0:07:10.36,0:07:13.07,DCMain,KAHO,0,0,0,,{\fad(250,0)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\pos(604,720)\clip(530,582,788,692)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:07:10.38,0:07:13.06,Names,TEXT,0,0,0,,{\fad(216,1)\pos(668,666)}كانويا تاتسوما - 72 عامًا\Nمستشار وكالة كانويا للبناء
Dialogue: 0,0:07:14.33,0:07:16.83,DCMain,CONAN,0,0,0,,يا لها من صدفة
Dialogue: 0,0:07:16.83,0:07:21.32,DCMain,CONAN,0,0,0,,لا أصدق أننا صادفنا أحد معارف جدتك
Dialogue: 0,0:07:21.32,0:07:22.35,DCMain,SUMIRE,0,0,0,,أجل
Dialogue: 0,0:07:22.35,0:07:25.66,DCMain,TATSUMA,0,0,0,,..جثمان [يوري-تشان].. أعني
Dialogue: 0,0:07:25.66,0:07:31.19,DCMain,,0,0,0,,جثمان جدتك تم اكتشافه من قبل ابن أخي، [يوميكي]
Dialogue: 0,0:07:31.71,0:07:34.22,DCMain,TATSUMA,0,0,0,,أعتقد أنه القدر فعلًا
Dialogue: 0,0:07:34.22,0:07:38.73,DCMain,,0,0,0,,لذا أتيت هنا لأرى مقر (ياماتو) يُهدم
Dialogue: 0,0:07:38.73,0:07:40.51,DCMain,SUMIRE,0,0,0,,كيف تعرفت على جدتي؟
Dialogue: 0,0:07:40.51,0:07:44.23,DCMain,TATSUMA,0,0,0,,في الواقع عملت لدى (ياماتو) في الماضي
Dialogue: 0,0:07:45.03,0:07:46.33,DCMain,SUMIRE,0,0,0,,هكذا إذن
Dialogue: 0,0:07:46.33,0:07:49.94,DCMain,TATSUMA,0,0,0,,كانت [يوري-تشان] مساعدة مذهلة
Dialogue: 0,0:07:49.94,0:07:51.02,DCMain,CONAN,0,0,0,,معذرة
Dialogue: 0,0:07:51.92,0:07:56.22,DCMain,CONAN,0,0,0,,هل تتذكر المسلسل الدرامي "لقد قتلتهم"؟
Dialogue: 0,0:07:58.83,0:08:00.55,DCMain,RAN,0,0,0,,![كونان-كن]
Dialogue: 0,0:08:00.55,0:08:05.61,DCMain,CONAN,0,0,0,,لكن ألا تريد [سوميري-تشان] أن تتأكد من براءة جدتها؟
Dialogue: 0,0:08:05.61,0:08:07.16,DCMain,RAN,0,0,0,,..أجل، لكن
Dialogue: 0,0:08:09.22,0:08:16.30,DCMain,TATSUMA,0,0,0,,لا بأس، لا أحد من الطاقم صدق أن جدتك سارقة
Dialogue: 0,0:08:16.30,0:08:17.10,DCMain,SUMIRE,0,0,0,,ماذا؟
Dialogue: 0,0:08:17.39,0:08:20.84,DCMain,TATSUMA,0,0,0,,لقد كنت فردًا من الطاقم الأصلي للمسلسل
Dialogue: 0,0:08:20.84,0:08:22.60,DCMain,,0,0,0,,لا شك في هذا
Dialogue: 0,0:08:26.56,0:08:28.61,DCMain,CONAN,0,0,0,,ماذا؟ كان بثًا مباشرًا؟
Dialogue: 0,0:08:29.06,0:08:32.40,DCMain,RAN,0,0,0,,كيف يمكن للمسلسلات أن تُبث مباشرة؟
Dialogue: 0,0:08:32.90,0:08:36.90,DCMain,TATSUMA,0,0,0,,في هذه الوقت، محطة صغيرة كـ (ياماتو)
Dialogue: 0,0:08:36.90,0:08:40.62,DCMain,,0,0,0,,لم تكن تعلم عن تسجيل الفيديو
Dialogue: 0,0:08:41.16,0:08:44.86,DCMain,TATSUMA,0,0,0,,لذلك قرروا جعل العمل دراما مباشرة احتفالًا
Dialogue: 0,0:08:44.86,0:08:50.25,DCMain,,0,0,0,,"بمرور خمسة أعوام على الإنشاء، وأسموه "قتلتهم
Dialogue: 0,0:08:50.25,0:08:52.20,DCMain,RAN,0,0,0,,قتلتهم؟
Dialogue: 0,0:08:52.20,0:08:54.76,DCMain,CONAN,0,0,0,,"بالتأكيد هو اسم مختصر لـ "لقد قتلتهم
Dialogue: 0,0:08:56.18,0:08:58.00,DCMain,TATSUMA,0,0,0,,أجل، لقد فهمتها
Dialogue: 0,0:08:58.00,0:09:01.77,DCMain,TATSUMA,0,0,0,,هذه الصناعة تحب اختصار كل شيء
Dialogue: 0,0:09:02.64,0:09:05.59,Yamato TV,TEXT,0,0,0,,تلفاز ياماتو
Dialogue: 0,0:09:03.60,0:09:06.43,DCMain,TATSUMA,0,0,0,,هكذا تم تصوير المسلسل
Dialogue: 0,0:09:06.43,0:09:09.06,DCMain,TATSUMA,0,0,0,,لقد كنت أنا الرجل خلف الكاميرا
Dialogue: 0,0:09:09.06,0:09:10.27,DCMain,RAN,0,0,0,,!كنتم شبابًا
Dialogue: 0,0:09:11.08,0:09:13.80,DCMain,SUMIRE,0,0,0,,!هذه هي! إنها جدتي
Dialogue: 0,0:09:13.80,0:09:16.28,DCMain,CONAN,0,0,0,,إنها تشبهك تمامًا
Dialogue: 0,0:09:16.51,0:09:24.23,DCMain,TATSUMA,0,0,0,,كانت [يوري-تشان] بمثابة أخت لـ [ناغيسا-تشان]
Dialogue: 0,0:09:24.23,0:09:29.58,DCMain,SUMIRE,0,0,0,,إلى أي مدى ظلت [ناغيسا-سان] تظهر على التلفاز؟
Dialogue: 0,0:09:29.58,0:09:32.80,DCMain,TATSUMA,0,0,0,,لقد اختفت عن الأضواء تمامًا بعد المسلسل
Dialogue: 0,0:09:33.81,0:09:37.55,DCMain,TATSUMA,0,0,0,,تم اختيارها للدور لكونها ابنة المنتج فقط
Dialogue: 0,0:09:38.07,0:09:43.93,DCMain,TATSUMA,0,0,0,,لم تكن فتاة سيئة، لكن عانت من رهاب الكاميرا
Dialogue: 0,0:09:43.95,0:09:48.68,I Killed Them,TEXT,0,0,0,,{\frz89.23\pos(316,320)}لقد قتلتهم
Dialogue: 0,0:09:44.55,0:09:48.69,DCFlashback,NAGISA,0,0,0,,...أنا... أنا
Dialogue: 0,0:09:48.69,0:09:53.37,DCFlashback,NAGISA,0,0,0,,{\pos(566,684)}..أنا قتلتهم.. أنا قتلتهم
Dialogue: 0,0:09:48.81,0:09:52.32,DCMain,KAHO,0,0,0,,{\fad(250,250)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\pos(936,728)\clip(752,582,1030,698)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:09:48.81,0:09:52.31,Names,TEXT,0,0,0,,{\fad(208,386)\pos(893,676)}آساهينا ناغيسا - 22 عامًا\Nممثلة
Dialogue: 0,0:09:53.37,0:09:55.24,DCItalic,YURI,0,0,0,,تفضلي يا [ناغيسا-تشان]
Dialogue: 0,0:09:56.45,0:09:59.19,DCMain,KAHO,0,0,0,,{\fad(250,250)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\clip(354,580,624,700)\pos(528,700)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:09:56.51,0:09:59.19,Names,TEXT,0,0,0,,{\fad(211,1)\pos(503,674)}سايكي يوري - 30 عامًا\Nمساعدة ناغيسا
Dialogue: 0,0:09:59.42,0:10:00.95,DCMain,CONAN,0,0,0,,ما الأمر بخصوص التفاح؟
Dialogue: 0,0:10:00.95,0:10:05.84,DCMain,TATSUMA,0,0,0,,جعلتها تقشر التفاح كي ترخي أعصابها
Dialogue: 0,0:10:05.84,0:10:08.75,DCMain,TATSUMA,0,0,0,,قشور قصيرة تعني أنها ما زالت متوترة
Dialogue: 0,0:10:08.75,0:10:12.21,DCMain,TATSUMA,0,0,0,,قشور طويلة تعني أنها بدأت ترتاح
Dialogue: 0,0:10:12.62,0:10:15.71,DCMain,SUMIRE,0,0,0,,كانت جدتي مساعدة جيدة فعلًا
Dialogue: 0,0:10:16.19,0:10:21.22,DCMain,TATSUMA,0,0,0,,لكن في هذا اليوم، فارقت [ناغيسا-تشان]
Dialogue: 0,0:10:21.84,0:10:24.60,DCMain,,0,0,0,,لتذهب وتنقل الخاتم
Dialogue: 0,0:10:25.14,0:10:27.60,DCMain,CONAN,0,0,0,,كيف حدث ذلك؟
Dialogue: 0,0:10:28.00,0:10:32.28,DCMain,TATSUMA,0,0,0,,بسبب وجود إشاعات عن شراء عائلة [آساهينا]
Dialogue: 0,0:10:32.28,0:10:35.08,DCMain,,0,0,0,,لجوهرة دموع بورجيا
Dialogue: 0,0:10:41.49,0:10:46.39,DCMain,TATSUMA,0,0,0,,قررت أن يعلن أستاذ التاريخ الغربي [سينجو]
Dialogue: 0,0:10:46.39,0:10:48.75,DCMain,,0,0,0,,أنها أصلية قبل بدء التصوير
Dialogue: 0,0:10:49.41,0:10:55.00,DCMain,TATSUMA,0,0,0,,كان يجب ترك الجوهرة بالاستوديو ليأتي الخبير [سينجو]
Dialogue: 0,0:10:55.53,0:11:00.62,DCMain,TATSUMA,0,0,0,,ثم تأتي بها [يوري-تشان] لمقر التصوير بعد شهادته بجودتها
Dialogue: 0,0:11:00.62,0:11:03.93,DCMain,RAN,0,0,0,,كان بإمكانهم تغيير موعد التصوير
Dialogue: 0,0:11:03.93,0:11:06.26,DCMain,CONAN,0,0,0,,لا يمكن لهم ذلك يا [ران-نيتشان]
Dialogue: 0,0:11:06.26,0:11:08.80,DCMain,TATSUMA,0,0,0,,هذا صحيح، لأنه بث مباشر
Dialogue: 0,0:11:11.71,0:11:14.98,DCMain,TATSUMA,0,0,0,,لقد كنت في مقر التصوير خلف الكاميرا
Dialogue: 0,0:11:15.00,0:11:17.18,Yamato TV Camera,TEXT,0,0,0,,{\fscx100\fscy100\frz359.7\frx2\fry40\pos(614,198)}تلفاز ياماتو
Dialogue: 0,0:11:15.88,0:11:18.49,DCMain,TATSUMA,0,0,0,,كانت [ناغيسا-تشان] الممثلة الوحيدة هناك
Dialogue: 0,0:11:19.22,0:11:25.49,DCMain,TATSUMA,0,0,0,,عندما تصل الجوهرة في الساعة 20 و 20 دقيقة، نصل للنهاية
Dialogue: 0,0:11:25.79,0:11:27.75,DCMain,CONAN,0,0,0,,بالتأكيد هي هامة في التصوير
Dialogue: 0,0:11:28.20,0:11:34.63,DCMain,TATSUMA,0,0,0,,بالتأكيد، وكان يجب أن تصل عند نهاية الحلقة
Dialogue: 0,0:11:36.65,0:11:43.50,Yamato TV Camera,TEXT,0,0,0,,{\fs75\pos(424,114)}تلفاز ياماتو
Dialogue: 0,0:11:36.63,0:11:39.26,DCMain,KAHO,0,0,0,,{\fad(250,250)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\pos(860,718)\clip(676,580,948,698)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:11:36.69,0:11:39.25,Names,TEXT,0,0,0,,{\fad(214,386)\pos(822,674)}كانويا تاتسوما - 32 عامًا\Nالرجل خلف الكاميرا
Dialogue: 0,0:11:36.75,0:11:42.26,DCFlashback,TATSUMA,0,0,0,,{\pos(360,710)}الانتقال من الاستوديو إلى مقر التصوير في \N..ثلاثة .. اثنان .. واحد
Dialogue: 0,0:11:57.64,0:11:59.70,DCMain,TATSUMA,0,0,0,,صورنا بكاميرا واحدة فقط
Dialogue: 0,0:12:00.09,0:12:02.86,DCMain,TATSUMA,0,0,0,,كانت فرصة لإبراز مواهبي الفذة
Dialogue: 0,0:12:03.53,0:12:06.91,DCMain,TATSUMA,0,0,0,,وفجأة بدأت في تقشير التفاح بروية
Dialogue: 0,0:12:07.29,0:12:10.04,DCMain,CONAN,0,0,0,,قشرت التفاح في البث؟
Dialogue: 0,0:12:10.31,0:12:15.53,DCMain,TATSUMA,0,0,0,,أجل، كانت فكرة [يوري-تشان] لتهدئتها أثناء التصوير
Dialogue: 0,0:12:16.14,0:12:19.03,DCMain,SUMIRE,0,0,0,,أن تكون مساعدًا هو عمل شاق
Dialogue: 0,0:12:19.03,0:12:23.34,DCMain,TATSUMA,0,0,0,,بعض الممثلين يستعينون بهم أيضًا أثناء التصوير
Dialogue: 0,0:12:23.34,0:12:25.93,DCMain,RAN,0,0,0,,..من أجل تلقين السيناريو؟ لماذا قد
Dialogue: 0,0:12:26.85,0:12:28.68,DCMain,RAN,0,0,0,,أجل، لأنه بث مباشر
Dialogue: 0,0:12:30.75,0:12:36.31,DCMain,TATSUMA,0,0,0,,لم يكن لدينا وقت لعمل بروفات، تذكر النص كان صعبًا
Dialogue: 0,0:12:36.31,0:12:40.61,DCMain,CONAN,0,0,0,,لكن في النهاية لم يصل الخاتم أبدًا، صحيح؟
Dialogue: 0,0:12:41.79,0:12:47.06,DCMain,NAGISA,0,0,0,,قمنا بعمل نسخة احتياطية
Dialogue: 0,0:12:47.06,0:12:48.45,DCMain,,0,0,0,,بالتأكيد كانت رخيصة كذلك
Dialogue: 0,0:12:48.45,0:12:49.95,DCMain,CONAN,0,0,0,,أجل
Dialogue: 0,0:12:50.25,0:12:52.45,DCMain,SUMIRE,0,0,0,,لكن فُقدت جدتي منذ ذلك الوقت
Dialogue: 0,0:12:53.87,0:12:57.14,DCMain,TATSUMA,0,0,0,,لقد جذبت انتباهنا الفوضى الإعلامية بعدها
Dialogue: 0,0:12:57.14,0:13:01.35,DCMain,,0,0,0,,لذلك قررنا ترك موضوع [يوري-تشان]
Dialogue: 0,0:13:01.35,0:13:02.46,DCMain,TATSUMA,0,0,0,,أنا آسف
Dialogue: 0,0:13:02.88,0:13:04.29,DCMain,CONAN,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:13:04.63,0:13:07.85,DCMain,TATSUMA,0,0,0,,انهارت [ناغيسا-تشان] على الأرض مباشرة بعد التصوير
Dialogue: 0,0:13:07.85,0:13:09.22,DCMain,RAN,0,0,0,,لماذا؟
Dialogue: 0,0:13:09.67,0:13:13.23,DCMain,TATSUMA,0,0,0,,كانت مصابة بالحمى ووصلت حرارتها إلى أربعين درجة مئوية
Dialogue: 0,0:13:13.23,0:13:15.23,DCMain,CONAN,0,0,0,,ماذا؟ تابعت التصوير في تلك الحالة؟
Dialogue: 0,0:13:15.65,0:13:19.73,DCMain,TATSUMA,0,0,0,,لا يجب قطع بث مباشر لأعذار مرضية
Dialogue: 0,0:13:20.04,0:13:23.09,DCMain,TATSUMA,0,0,0,,علمت ذلك عندما تم اختيارها
Dialogue: 0,0:13:23.09,0:13:25.74,DCMain,TATSUMA,0,0,0,,كان الأمر غير شائع وقتها
Dialogue: 0,0:13:25.74,0:13:29.76,DCMain,SUMIRE,0,0,0,,هل ما زالت [ناغيسا-سان] مقيمة هنا؟
Dialogue: 0,0:13:29.76,0:13:33.62,DCMain,TATSUMA,0,0,0,,في مصحة نفسية
Dialogue: 0,0:13:34.34,0:13:36.61,DCMain,TATSUMA,0,0,0,,"اسمها "غراند لايت
Dialogue: 0,0:13:38.10,0:13:39.63,DCMain,ATTENDANT,0,0,0,,أنا آسفة
Dialogue: 0,0:13:39.98,0:13:42.46,DCMain,ATTENDANT,0,0,0,,[آساهينا-سان] بالخارج الآن
Dialogue: 0,0:13:42.86,0:13:46.83,DCMain,ATTENDANT,0,0,0,,ولا نعلم متى ستأتي
Dialogue: 0,0:13:47.80,0:13:48.86,DCMain,ATTENDANT,0,0,0,,معذرة
Dialogue: 0,0:13:49.64,0:13:51.29,DCMain,ATTENDANT,0,0,0,,أجل، مكتب الاستقبال
Dialogue: 0,0:13:51.73,0:13:53.64,DCMain,ATTENDANT,0,0,0,,ماذا؟ افترقتما؟
Dialogue: 0,0:13:54.11,0:13:56.39,DCMain,ATTENDANT,0,0,0,,أتى أحدهم لرؤيتها الآن
Dialogue: 0,0:13:57.63,0:13:59.17,DCMain,ATTENDANT,0,0,0,,أنا آسفة
Dialogue: 0,0:14:06.80,0:14:08.77,Asahina,TEXT,0,0,0,,آساهينا
Dialogue: 0,0:14:07.20,0:14:10.50,DCMain,ATTENDANT,0,0,0,,نظرت بعيدًا لدقيقة، ثم اختفت؟
Dialogue: 0,0:14:11.57,0:14:15.52,DCMain,ATTENDANT,0,0,0,,لقد أخبرت طبيبها، صحيح؟ فهمت
Dialogue: 0,0:14:21.69,0:14:26.33,DCMain,DOCTOR,0,0,0,,في العادة تُصاب بالذعر نظرًا لعقدة قديمة
Dialogue: 0,0:14:26.33,0:14:27.73,DCMain,DOCTOR,0,0,0,,يجب أن تكوني حذرة
Dialogue: 0,0:14:28.16,0:14:32.05,DCMain,DOCTOR,0,0,0,,إنها تخلط ذكريات الماضي بالحاضر
Dialogue: 0,0:14:32.70,0:14:34.56,DCMain,DOCTOR,0,0,0,,على كل حال، أنا سعيد لأنهم وجدوها
Dialogue: 0,0:14:34.56,0:14:36.31,Room 312,SIGN,0,0,0,,{\pos(1164,216)}غرفة 312
Dialogue: 0,0:14:34.56,0:14:36.31,Asahina Room Plate,SIGN,0,0,0,,{\pos(1146,428)}آساهينا
Dialogue: 0,0:14:59.04,0:15:01.99,DCMain,KAHO,0,0,0,,{\fad(250,250)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\clip(596,580,864,704)\pos(678,720)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:14:59.04,0:15:01.99,Names,TEXT,0,0,0,,{\fad(215,423)\pos(730,672)}آساهينا ناغيسا - 62 عامًا\Nممثلة سابقة
Dialogue: 0,0:15:06.36,0:15:08.27,DCMain,CONAN,0,0,0,,![ران-نيتشان]
Dialogue: 0,0:15:10.17,0:15:13.05,DCMain,SUMIRE,0,0,0,,[كونان-كن] هناك، في الطابق الثالث
Dialogue: 0,0:15:13.74,0:15:15.50,DCMain,NAGISA,0,0,0,,"قل "آه ه ه
Dialogue: 0,0:15:15.50,0:15:16.79,DCMain,CONAN,0,0,0,,آه ه ه
Dialogue: 0,0:15:18.29,0:15:20.77,DCMain,NAGISA,0,0,0,,لنقشّر المزيد
Dialogue: 0,0:15:23.48,0:15:25.84,DCMain,ATTENDANT,0,0,0,,[آساهينا-سان]، أتى ضيوف لزيارتك
Dialogue: 0,0:15:26.33,0:15:28.24,DCMain,,0,0,0,,سيدتان يافعتان
Dialogue: 0,0:15:32.37,0:15:34.77,DCMain,NAGISA,0,0,0,,..[يوري-تشان]
Dialogue: 0,0:15:43.96,0:15:47.36,DCMain,NAGISA,0,0,0,,![يوري-تشان]! أنا آسفة! سامحيني
Dialogue: 0,0:15:48.01,0:15:50.00,DCMain,NAGISA,0,0,0,,!سامحيني
Dialogue: 0,0:15:56.41,0:16:00.06,DCMain,NAGISA,0,0,0,,![يوري-تشان]! أنا آسفة! سامحيني
Dialogue: 0,0:16:00.06,0:16:01.64,DCMain,SUMIRE,0,0,0,,..أنا
Dialogue: 0,0:16:01.64,0:16:03.15,DCMain,NAGISA,0,0,0,,!لا
Dialogue: 0,0:16:10.27,0:16:13.06,DCMain,SUMIRE,0,0,0,,اعتقدت أنها صديقة جدتي
Dialogue: 0,0:16:13.06,0:16:15.78,DCMain,RAN,0,0,0,,لماذا صرخت هكذا؟
Dialogue: 0,0:16:16.07,0:16:21.65,DCMain,CONAN,0,0,0,,حدث شيء بينهما أصابها بصدمة
Dialogue: 0,0:16:23.92,0:16:27.19,DCMain,CONAN,0,0,0,,هذا على الأغلب ما كان سيقوله [شينتشي-نيتشان]
Dialogue: 0,0:16:27.19,0:16:29.43,DCMain,RAN,0,0,0,,فقط إذا كان هنا
Dialogue: 0,0:16:29.43,0:16:33.43,DCMain,RAN,0,0,0,,كان لعلم أين الجوهرة بسهولة
Dialogue: 0,0:16:33.73,0:16:40.06,DCMain,CONAN,0,0,0,,[سوميري-تشان]، أتعلمين فكرة مسلسل "لقد قتلتهم"؟
Dialogue: 0,0:16:40.06,0:16:44.40,DCMain,SUMIRE,0,0,0,,أجل، يتحدث عن عائلة قديمة احتفظت
Dialogue: 0,0:16:44.40,0:16:48.25,DCMain,,0,0,0,,"بالجوهرة التاريخية "دموع بورجيا
Dialogue: 0,0:16:48.96,0:16:54.94,DCMain,SUMIRE,0,0,0,,"وقتها كان يوجد مجرم معروف بـ "الرداء الأحمر
Dialogue: 0,0:16:55.48,0:17:00.80,DCMain,SUMIRE,0,0,0,,أعلن أنه سوف يسرق الجوهرة منهم
Dialogue: 0,0:17:01.93,0:17:04.54,DCMain,SUMIRE,0,0,0,,ولم تستطع الشرطة فعل شيء بخصوص الأمر
Dialogue: 0,0:17:02.14,0:17:10.08,Red Hood Note,TEXT,0,0,0,,دموع بورجيا ستكون ملكي\N{\c&H6B60A5&}الرداء الأحمر
Dialogue: 0,0:17:04.54,0:17:07.36,DCMain,,0,0,0,,ولم يعلم أحدهم شكله الحقيقي أسفل القناع
Dialogue: 0,0:17:07.97,0:17:09.52,DCMain,SUMIRE,0,0,0,,هذه هي القصة
Dialogue: 0,0:17:13.52,0:17:16.94,DCMain,RAN,0,0,0,,ماذا حدث للجوهرة بعد ذلك؟
Dialogue: 0,0:17:16.94,0:17:19.87,DCMain,SUMIRE,0,0,0,,أتت الخادمة بفكرة جهنمية
Dialogue: 0,0:17:19.87,0:17:22.98,DCMain,SUMIRE,0,0,0,,كانت [ناغيسا-سان] تقوم بدور الخادمة وقتها
Dialogue: 0,0:17:23.87,0:17:29.58,DCMain,SUMIRE,0,0,0,,سيجدها إذا كانت مخبأة، لذلك قررت وضعها أمام العيان
Dialogue: 0,0:17:29.58,0:17:33.60,DCMain,SUMIRE,0,0,0,,تم وضع جوهرة مزيفة في الخزنة
Dialogue: 0,0:17:33.60,0:17:37.24,DCMain,,0,0,0,,بينما الحقيقية ارتدتها الخادمة
Dialogue: 0,0:17:37.95,0:17:45.50,DCMain,SUMIRE,0,0,0,,لكن هوية الرداء الأحمر الحقيقية هي صديقها، كبير الخدم
Dialogue: 0,0:17:45.86,0:17:47.62,DCItalic,CONAN,0,0,0,,قصة تقليدية جدًا
Dialogue: 0,0:17:48.01,0:17:50.62,DCMain,SUMIRE,0,0,0,,بينما انتظر السارق فرصة للهجوم
Dialogue: 0,0:17:50.62,0:17:55.53,DCMain,,0,0,0,,تم إرسال الخادمة إلى مكان بعيد بأوامر المالك
Dialogue: 0,0:17:56.06,0:17:57.12,DCMain,ATTENDANT,0,0,0,,معذرة
Dialogue: 0,0:17:58.31,0:18:00.17,DCMain,ATTENDANT,0,0,0,,شكرًا على الانتظار
Dialogue: 0,0:18:00.55,0:18:03.37,DCMain,ATTENDANT,0,0,0,,..بخصوص [آساهينا-سان]
Dialogue: 0,0:18:03.37,0:18:04.27,DCMain,SUMIRE,0,0,0,,أجل؟
Dialogue: 0,0:18:04.56,0:18:09.37,DCMain,ATTENDANT,0,0,0,,..آسفة، لكن [آساهينا-سان] لا تبلي حسنًا الآن
Dialogue: 0,0:18:09.37,0:18:11.71,DCMain,ATTENDANT,0,0,0,,هل يمكنكم المجيء في يوم آخر؟
Dialogue: 0,0:18:16.27,0:18:18.91,DCMain,SUMIRE,0,0,0,,إنهم قلقون أن أعراضها ربما تتصاعد
Dialogue: 0,0:18:18.91,0:18:22.55,DCMain,RAN,0,0,0,,إذا وضعنا تلك الاحتمالية؛ فلا فرصة لدينا
Dialogue: 0,0:18:22.55,0:18:23.71,DCMain,SENJU,0,0,0,,!مرحبًا، أنتِ
Dialogue: 0,0:18:23.71,0:18:24.83,DCMain,SENJU,0,0,0,,!أجل، أنتِ
Dialogue: 0,0:18:25.11,0:18:27.08,DCMain,SENJU,0,0,0,,!أنتِ [سايكي يوري-تشان]
Dialogue: 0,0:18:27.08,0:18:30.08,DCMain,SUMIRE,0,0,0,,لقد كانت جدتي
Dialogue: 0,0:18:30.08,0:18:32.89,DCMain,SENJU,0,0,0,,يا لها من مصادفة
Dialogue: 0,0:18:32.89,0:18:36.84,DCMain,SENJU,0,0,0,,أنا خبير التاريخ الغربي، [سينجو]
Dialogue: 0,0:18:37.15,0:18:38.94,DCMain,CONAN,0,0,0,,غرور واضح
Dialogue: 0,0:18:39.35,0:18:40.91,DCMain,CONAN,0,0,0,,ماذا؟ [سينجوٍ]؟
Dialogue: 0,0:18:40.91,0:18:42.60,DCMain,CONAN,0,0,0,,أليست له علاقة بالتلفاز؟
Dialogue: 0,0:18:42.81,0:18:47.03,DCMain,RAN,0,0,0,,أجل، بالتأكيد يعلم عن جدتك
Dialogue: 0,0:18:48.94,0:18:52.48,DCMain,SENJU,0,0,0,,{\pos(658,88)}آه، أنتِ بالضبط نوعي المفضل
Dialogue: 0,0:18:50.23,0:18:53.64,DCMain,KAHO,0,0,0,,{\fad(250,250)\p1\c&H9F4760&\bord0\fscx2123\fscy1500\pos(604,720)\clip(504,580,776,698)}m 0 0 l 20 0 l 20 11 l 0 11 l 0 0
Dialogue: 0,0:18:50.25,0:18:53.64,Names,TEXT,0,0,0,,{\fad(212,383)\pos(642,665)}سينجو هيديو - 88 عامًا\Nأستاذ التاريخ الغربي
Dialogue: 0,0:18:52.48,0:18:54.78,DCMain,SENJU,0,0,0,,{\pos(630,84)}أنا سعيد برؤيتك ثانية، [يوري-سان]
Dialogue: 0,0:18:56.47,0:18:58.11,DCMain,SUMIRE,0,0,0,,إنها جدتي
Dialogue: 0,0:18:59.58,0:19:05.15,DCMain,SENJU,0,0,0,,كنتِ الحسنة الوحيدة في ذلك البرنامج الممل
Dialogue: 0,0:19:05.15,0:19:08.87,DCMain,SENJU,0,0,0,,كنتِ حقًا المرأة المثالية بالنسبة لي
Dialogue: 0,0:19:09.15,0:19:10.79,DCMain,SUMIRE,0,0,0,,لم أكن أنا
Dialogue: 0,0:19:10.79,0:19:13.17,DCMain,SENJU,0,0,0,,لا تخجلي، [يوري-سان]
Dialogue: 0,0:19:19.30,0:19:22.01,DCMain,RAN,0,0,0,,ألا يجدر بنا الذهاب، [سوميري-سان]؟
Dialogue: 0,0:19:22.01,0:19:25.81,DCMain,SENJU,0,0,0,,هذه وقاحة! ألا توافقني الرأي أيها الفتى؟
Dialogue: 0,0:19:26.08,0:19:26.76,DCMain,CONAN,0,0,0,,ماذا؟
Dialogue: 0,0:19:29.19,0:19:31.29,DCMain,SENJU,0,0,0,,ألا تتذكرين؟
Dialogue: 0,0:19:31.29,0:19:34.32,DCMain,SENJU,0,0,0,,الذي قالته شركة (ياماتو) عن البرنامج؟
Dialogue: 0,0:19:34.63,0:19:36.44,DCMain,SUMIRE,0,0,0,,لا أعلم
Dialogue: 0,0:19:36.44,0:19:39.62,DCMain,SENJU,0,0,0,,!أجل! أخبرتك لأنهم لم يخبروكِ
Dialogue: 0,0:19:39.62,0:19:42.64,DCMain,SENJU,0,0,0,,!الجوهرة مزيفة
Dialogue: 0,0:19:42.64,0:19:45.33,DCMain,,0,0,0,,!لم توجد من الأساس
Dialogue: 0,0:19:46.68,0:19:50.58,DCMain,SENJU,0,0,0,,لكن لم يهتموا بالحقيقة
Dialogue: 0,0:19:50.58,0:19:53.87,DCMain,,0,0,0,,طلبوا أن أعترف بكونها أصلية
Dialogue: 0,0:19:53.87,0:19:56.46,DCMain,SENJU,0,0,0,,طلب المُنتج؟
Dialogue: 0,0:19:56.46,0:19:58.46,DCMain,,0,0,0,,!إنهم لا يعلمون حقيقة التاريخ
Dialogue: 0,0:19:58.78,0:20:03.72,DCMain,SUMIRE,0,0,0,,ماذا قلت وقتها؟
Dialogue: 0,0:20:05.20,0:20:07.66,DCMain,SENJU,0,0,0,,قلت أنني سأترك الموضوع لأنها أسطورة فقط
Dialogue: 0,0:20:07.66,0:20:12.23,DCMain,,0,0,0,,لكن المُلّاك أحرجوا أنفسهم وأصروا على أنها حقيقية
Dialogue: 0,0:20:12.23,0:20:13.73,DCMain,CONAN,0,0,0,,حقًا؟
Dialogue: 0,0:20:13.73,0:20:19.13,DCMain,SENJU,0,0,0,,كرهت محطة التلفاز نكراني لوجودها
Dialogue: 0,0:20:19.13,0:20:21.81,DCMain,SENJU,0,0,0,,أنتِ الوحيدة التي استمعت لي يا [يوري-تشان]
Dialogue: 0,0:20:22.28,0:20:24.99,DCMain,SENJU,0,0,0,,ولهذا وقعت في حبك
Dialogue: 0,0:20:24.99,0:20:25.99,DCMain,RAN,0,0,0,,ماذا؟
Dialogue: 0,0:20:25.99,0:20:26.99,DCMain,CONAN,0,0,0,,ماذا؟
Dialogue: 0,0:20:27.44,0:20:28.66,DCMain,SUMIRE,0,0,0,,ماذا؟
Dialogue: 0,0:20:31.00,0:20:35.49,Nonogaki Real Estate,SIGN,0,0,0,,نونوغاكي للعقارات
Dialogue: 0,0:20:38.67,0:20:40.30,DCMain,KOGORO,0,0,0,,لقد أتيت في الموعد
Dialogue: 0,0:20:40.79,0:20:43.31,DCMain,KOGORO,0,0,0,,![ميزوساوا-كن]، مرحبًا
Dialogue: 0,0:20:43.31,0:20:45.96,DCMain,KOGORO,0,0,0,,!ماذا! اصمت أيها الأحمق
Dialogue: 0,0:20:46.37,0:20:49.39,DCMain,KOGORO,0,0,0,,![ميزوساوا-كن]، مرحبًا [ميزوساوا]
Dialogue: 0,0:20:50.01,0:20:52.02,DCMain,KOGORO,0,0,0,,ألم ترد التحدث إلي؟
Dialogue: 0,0:20:53.96,0:20:55.94,DCMain,KOGORO,0,0,0,,!افتح الباب
Dialogue: 0,0:20:56.93,0:20:58.23,DCMain,KOGORO,0,0,0,,إنه مفتوح
Dialogue: 0,0:20:59.28,0:21:02.24,DCMain,KOGORO,0,0,0,,مرحبًا، [ميزوساوا-كن]
Dialogue: 0,0:21:02.76,0:21:05.74,DCMain,KOGORO,0,0,0,,ألم تقل شيئًا عن تلك الجوهرة الغريبة؟
Dialogue: 0,0:21:06.18,0:21:07.37,DCMain,KOGORO,0,0,0,,[ميزوساوا]
Dialogue: 0,0:21:11.61,0:21:12.75,DCMain,KOGORO,0,0,0,,هناك شيء يحترق
Dialogue: 0,0:21:19.06,0:21:20.48,DCMain,KOGORO,0,0,0,,!ماذا
Dialogue: 0,0:21:20.48,0:21:21.96,DCMain,KOGORO,0,0,0,,إنه هاتف [ميزوساوا]
Dialogue: 0,0:21:24.92,0:21:26.68,DCMain,KOGORO,0,0,0,,حريق؟ أيعقل؟
Dialogue: 0,0:21:27.37,0:21:28.26,DCMain,KOGORO,0,0,0,,![ميزوساوا]
Dialogue: 0,0:21:28.26,0:21:29.89,DCMain,KOGORO,0,0,0,,!ساخن! ساخن! ساخن
Dialogue: 0,0:21:30.75,0:21:33.11,DCMain,KOGORO,0,0,0,,!ساخن! ساخن! ساخن
Dialogue: 0,0:21:33.11,0:21:34.11,DCMain,KOGORO,0,0,0,,![ميزوساوا]
Dialogue: 0,0:21:34.11,0:21:36.00,DCMain,KOGORO,0,0,0,,![ميزوساوا]
Dialogue: 0,0:21:37.86,0:21:45.11,DCMain,SENJU,0,0,0,,قلت لعائلة [آساهينا] التي وظفتكِ، ألا يُهينوا أنفسهم
Dialogue: 0,0:21:45.11,0:21:48.24,DCMain,SENJU,0,0,0,,قلت لعائلة [آساهينا] التي قامت بتوظيفك، ألّا يُهينوا أنفسهم
Dialogue: 0,0:21:48.63,0:21:52.49,DCMain,SENJU,0,0,0,,نظرتِ لي بعينيكِ الواسعتين وهززتِ رأسك
Dialogue: 0,0:21:52.84,0:21:55.00,DCMain,SENJU,0,0,0,,كان قلبي يخفق فعلًا
Dialogue: 0,0:21:56.09,0:21:57.93,DCMain,RAN,0,0,0,,معذرة أيها الأستاذ
Dialogue: 0,0:21:57.93,0:21:59.71,DCMain,SENJU,0,0,0,,!آلة حقيرة
Dialogue: 0,0:21:59.71,0:22:01.67,DCMain,RAN,0,0,0,,ماذا؟ المفتش [ميغوري]؟
Dialogue: 0,0:22:02.00,0:22:03.88,DCMain,RAN,0,0,0,,مرحبًا؟ أجل
Dialogue: 0,0:22:04.35,0:22:06.68,DCMain,RAN,0,0,0,,ماذا؟ انخرط أبي في حريق؟
Dialogue: 0,0:22:07.06,0:22:09.30,DCMain,RAN,0,0,0,,كيف حاله الآن؟
Dialogue: 0,0:22:09.72,0:22:11.32,DCMain,RAN,0,0,0,,هل هو بخير؟
Dialogue: 0,0:23:45.02,0:24:09.04,DCEpPreview,TEXT,0,0,0,,{\c&HE6DDD5&}عرض مسبق للحلقة القادمة
Dialogue: 0,0:23:46.99,0:23:49.95,DCMain,AGASA,0,0,0,,إلى أين نحن ذاهبان؟
Dialogue: 0,0:23:50.44,0:23:52.20,DCMain,CONAN,0,0,0,,السد
Dialogue: 0,0:23:52.20,0:23:54.95,DCMain,,0,0,0,,هناك شيء أريد التأكد منه بمقر التصوير
Dialogue: 0,0:23:57.97,0:24:00.15,DCMain,AGASA,0,0,0,,أنا لا أرى أي شيء
Dialogue: 0,0:24:00.15,0:24:01.37,DCMain,CONAN,0,0,0,,ليس الآن
Dialogue: 0,0:24:01.37,0:24:01.96,DCMain,AGASA,0,0,0,,ماذا؟
Dialogue: 0,0:24:01.96,0:24:03.77,DCMain,CONAN,0,0,0,,كنت أعرف
Dialogue: 0,0:24:03.77,0:24:06.67,DCMain,AGASA,0,0,0,,!تعرف ماذا؟ [شينتشي]؟
Dialogue: 0,0:24:09.05,0:24:15.05,DCNextEp,TEXT,0,0,0,,{\pos(646,114)}دموع (بورجيا) الملعونة  \N\N\N\N\N\N\N\N\Nالجزء الثاني
Dialogue: 0,0:24:09.44,0:24:14.57,DCMain,CONAN,0,0,0,,{\pos(652,734)}في الحلقة القادمة من كونان \N"دموع (بورجيا) الملعونة - الجزء الثاني"
Dialogue: 0,0:24:30.09,0:24:34.98,Hint,TEXT,0,0,0,,منارة جوية
Dialogue: 0,0:24:30.47,0:24:32.76,DCMain,KOGORO,0,0,0,,تلميح كونان القادم
Dialogue: 0,0:24:32.76,0:24:34.99,DCMain,CONAN,0,0,0,,!منارة جوية
Dialogue: 0,0:24:34.99,0:24:36.36,DCMain,RAN,0,0,0,,{\an8}أبي، هل أنت بخير؟
Dialogue: 0,0:24:34.99,0:24:41.08,Don'tMiss,TEXT,0,0,0,,لا تفوتوا الحلقة القادمة
