Dialogue: 0,0:00:00.83,0:00:03.16,Default conan,,0,0,0,,‫سوشي إيروها يحييكم
Dialogue: 0,0:00:04.87,0:00:05.83,Default conan,,0,0,0,,‫يبدو شهياً
Dialogue: 0,0:00:06.08,0:00:09.13,Default conan,,0,0,0,,‫التحقيق في قضية خيانة زوجية جلب لي أرباحًا طائلة
Dialogue: 0,0:00:09.30,0:00:10.92,Default conan,,0,0,0,,‫دعوني أُهدي أنفسنا هذه اللحظة من المتعة
Dialogue: 0,0:00:11.97,0:00:14.43,Default conan,,0,0,0,,‫نفذت أوراق الشاي لذا سأحضر المزيد
Dialogue: 0,0:00:17.10,0:00:17.69,Default conan,,0,0,0,,‫عجيب؟
Dialogue: 0,0:00:18.22,0:00:20.10,Default conan,,0,0,0,,‫كونان ليس هنا؟
Dialogue: 0,0:00:20.43,0:00:22.98,Default conan,,0,0,0,,‫جاءه اتصال مفاجئ منذ لحظات فخرج
Dialogue: 0,0:00:23.52,0:00:26.19,Default conan,,0,0,0,,‫قال إنه غادر مع أصدقائه
Dialogue: 0,0:00:26.35,0:00:28.19,Default conan,,0,0,0,,‫ليشجع شخص ما على البطولة.
Dialogue: 0,0:00:30.03,0:00:33.41,Default conan,,0,0,0,,‫برفقة المعلمة المسؤولة عن صفهم والمعلمة المساعدة لها
Dialogue: 0,0:00:35.36,0:00:37.87,Default conan,,0,0,0,,‫أي بطولة يا ترى ؟
Dialogue: 0,0:00:38.64,0:00:42.17,Default conan,,0,0,0,,‫على ما أذكر، تُقام في مبنى نيشي توبيا.
Dialogue: 0,0:00:42.54,0:00:45.37,Default conan,,0,0,0,,‫اللعبة الأجنبية الممثالة  لعبة الشوغي
Dialogue: 0,0:00:50.38,0:00:53.76,Default conan,,0,0,0,,‫بطولة الشطرنج ...
Dialogue: 0,0:00:54.96,0:00:58.72,Default conan,,0,0,0,,‫{\fad(300,300}سبعة عشر عامًا مضت، وها هو سيناريو المصير يُكشف أخيرًا!
Dialogue: 0,0:00:58.89,0:01:02.27,Default conan,,0,0,0,,‫{\fad(300,300}فارس ملطخ بالدماء... يعيد إلى الأذهان مباراة شطرنجٍ غامضة، تستقطب أعورًا إلى اللعبة
Dialogue: 0,0:01:02.43,0:01:05.69,Default conan,,0,0,0,,‫{\fad(300,300}عقل ناضج وذكاء حاد... محبوس في جسد صبي صغير.
Dialogue: 0,0:01:05.85,0:01:08.23,Default conan,,0,0,0,,‫{\fad(300,300}يدعى المحقق كونان
Dialogue: 0,0:01:09.01,0:01:12.56,DCOpening,,0,0,0,,‫لقد تجاوزنا بالفعل النقطة الحرجة، لكن المعركة الحقيقية تبدأ الآن.
Dialogue: 0,0:01:12.64,0:01:16.69,DCOpening,,0,0,0,,‫إنها ليست لعبة طفولية مثل لعبة الغميضة
Dialogue: 0,0:01:16.77,0:01:22.02,DCOpening,,0,0,0,,‫لنجعل من الحب جسرًا بين الحقيقة والخداع
Dialogue: 0,0:01:22.11,0:01:31.24,DCOpening,,0,0,0,,‫إذا كشفت نفسك، فإن الإجابة ستكون أسهل مما تظن
Dialogue: 0,0:01:31.37,0:01:38.92,DCOpening,,0,0,0,,‫أنا أغرق في واقع بعيد كل البعد عن أفكاري
Dialogue: 0,0:01:39.04,0:01:42.54,DCOpening,,0,0,0,,‫عمري 16 عامًا ولكن لا أحب، لا أحتاج إلى أي شيء آخر
Dialogue: 0,0:01:42.71,0:01:45.84,DCOpening,,0,0,0,,‫حتى أمنيتي الوحيدة لن تتحقق
Dialogue: 0,0:01:45.92,0:01:50.22,DCOpening,,0,0,0,,‫لا تسع يدي هذا الإحساس إنه أضخم من أن يُحتمل
Dialogue: 0,0:01:50.30,0:01:53.97,DCOpening,,0,0,0,,‫هل يمكن لهذه المشاعر أن تكون بهذا العمق؟
Dialogue: 0,0:01:54.18,0:02:00.77,DCOpening,,0,0,0,,‫في هذه اللحظة، لا يزال هناك ضوء صغير يسكن قلبي
Dialogue: 0,0:02:00.85,0:02:04.90,DCOpening,,0,0,0,,‫عمري 16 عامًا ولكن لا أحب، سأكون أقوى وأقوى  
Dialogue: 0,0:02:04.98,0:02:08.44,DCOpening,,0,0,0,,‫وأمسكها بقوتك الخاصة
Dialogue: 0,0:02:08.57,0:02:10.45,DCOpening,,0,0,0,,‫لكنني...لا أحبك
Dialogue: 0,0:02:10.53,0:02:12.95,DCOpening,,0,0,0,,‫ولكنني أعرف حبك الحقيقي
Dialogue: 0,0:02:15.87,0:02:17.66,DCOpening,,0,0,0,,‫لكنني...لا أحبك
Dialogue: 0,0:02:17.74,0:02:19.83,DCOpening,,0,0,0,,‫ولكنني أعرف حبك الحقيقي
Dialogue: 0,0:02:23.37,0:02:25.12,DCOpening,,0,0,0,,‫لكنني...لا أحبك
Dialogue: 0,0:02:25.21,0:02:27.25,DCOpening,,0,0,0,,‫ولكنني أعرف حبك الحقيقي
Dialogue: 0,0:02:50.58,0:02:55.93,Default conan,,0,0,0,,‫حقيقة مضت عليها 17 عامً - الفارس الملطخ بالدم
Dialogue: 0,0:02:56.37,0:02:59.20,Default conan,,0,0,0,,‫"مبنى نيشي توبيا"
Dialogue: 0,0:02:59.67,0:03:02.39,Default conan,,0,0,0,,‫ميدالية قطعة الفارس لي أنا ؟
Dialogue: 0,0:03:03.35,0:03:04.39,Default conan,,0,0,0,,‫شكراً جزيلاً !
Dialogue: 0,0:03:04.85,0:03:07.81,Default conan,,0,0,0,,‫رأيتُ أنها تميمة تتناسب مع هذه البطولة
Dialogue: 0,0:03:08.24,0:03:12.28,Default conan,,0,0,0,,‫ضع هذا الفارس قريباً من قلبك واحمِ الملكة من فضلك
Dialogue: 0,0:03:13.23,0:03:13.86,Default conan,,0,0,0,,‫حسناً
Dialogue: 0,0:03:14.52,0:03:16.40,Default conan,,0,0,0,,‫الملك هو من يجب حمايته
Dialogue: 0,0:03:16.94,0:03:19.32,Default conan,,0,0,0,,‫المعلمة كوباياشي لا تفهم في الشطرنج تماماً في نهاية الأمر
Dialogue: 0,0:03:19.61,0:03:21.57,Default conan,,0,0,0,,‫هل قطعة الفارس قوية ؟
Dialogue: 0,0:03:21.98,0:03:24.30,Default conan,,0,0,0,,‫تمامًا كحصان الشوغي
Dialogue: 0,0:03:24.41,0:03:26.62,Default conan,,0,0,0,,‫يذهب إلى جميع الاتجاهات.
Dialogue: 0,0:03:26.79,0:03:27.95,Default conan,,0,0,0,,‫نعم
Dialogue: 0,0:03:28.33,0:03:30.08,Default conan,,0,0,0,,‫أي أنها الأقوى
Dialogue: 0,0:03:30.25,0:03:30.87,Default conan,,0,0,0,,‫كلا
Dialogue: 0,0:03:31.21,0:03:35.71,Default conan,,0,0,0,,‫القطعة الأقوى هي  التي تستطيع السير رأسياً وأفقياً وقطرياً وبشكل غير محدود هي قطعة الملكة
Dialogue: 0,0:03:36.25,0:03:40.55,Default conan,,0,0,0,,‫لذلك الملكة لا تحمَى بل تحمي
Dialogue: 0,0:03:41.05,0:03:43.01,Default conan,,0,0,0,,‫يا لها من مفاجأة ، هايبارا ...
Dialogue: 0,0:03:43.26,0:03:45.55,Default conan,,0,0,0,,‫يبدو أنك ملمة بلعبة الشطرنج كذلك
Dialogue: 0,0:03:46.72,0:03:50.27,Default conan,,0,0,0,,‫هل علمك إياها والدكِ يا ترى ؟
Dialogue: 0,0:03:50.89,0:03:53.19,Default conan,,0,0,0,,‫معلمتك يتملكها الفضول؟
Dialogue: 0,0:03:53.77,0:03:58.15,Default conan,,0,0,0,,‫كلا ، مات والداي بعد ولادتي.
Dialogue: 0,0:03:58.83,0:04:01.25,Default conan,,0,0,0,,‫إذن هل علمتِ نفسك؟
Dialogue: 0,0:04:02.37,0:04:06.63,Default conan,,0,0,0,,‫إنه البروفيسور أغاسا أنه يعشق الشطرنج
Dialogue: 0,0:04:08.16,0:04:09.79,Default conan,,0,0,0,,‫هكذا إذن
Dialogue: 0,0:04:12.90,0:04:15.87,Default conan,,0,0,0,,‫أصابني التوجّس حين علمت أن المعلمة واكاسا ستكون هناك
Dialogue: 0,0:04:16.21,0:04:17.88,Default conan,,0,0,0,,‫حسنًا فعلتُ عندما قررت الحضور
Dialogue: 0,0:04:18.49,0:04:21.34,Default conan,,0,0,0,,‫آه ميدالية لقطعة شطرنج
Dialogue: 0,0:04:21.63,0:04:22.80,Default conan,,0,0,0,,‫أنا أيضاً لدي واحده
Dialogue: 0,0:04:23.79,0:04:27.55,Default conan,,0,0,0,,‫قلادة لقطعة القلعة إذ إن اسمي هو شيروي
Dialogue: 0,0:04:23.79,0:04:27.55,Note,,0,0,0,,‫شيرو هو كانجي لكلمة قلعة وهو جزء من اسمها
Dialogue: 0,0:04:28.97,0:04:33.06,Default conan,,0,0,0,,‫ارتداؤها يمدني بالقوة والجرأة لمحاربة خصومي
Dialogue: 0,0:04:33.39,0:04:34.48,Default conan,,0,0,0,,‫أما بالنسبة لي
Dialogue: 0,0:04:34.89,0:04:38.77,Default conan,,0,0,0,,‫فلدي هذا الكأس ذو حرف الـ kمن كلمة king في أسفله
Dialogue: 0,0:04:39.48,0:04:43.70,Default conan,,0,0,0,,‫عندما أسكب به الشاي المثلج وأشربه يصفو ذهني خلال المبارة
Dialogue: 0,0:04:44.28,0:04:48.83,Default conan,,0,0,0,,‫إذ إن إسمي هو الملك أوغاوارا
Dialogue: 0,0:04:44.28,0:04:48.83,Note,,0,0,0,,‫تلاعب بالكانجي حيث يكتب " كين من(كينجي) بالروماجي "kin" ويضاف له "G"  فصيبح كلمة "king" الملك
Dialogue: 0,0:04:49.24,0:04:51.66,Default conan,,0,0,0,,‫لست وحدك... لدي أنا أيضًا وسيلتي لطرد النحس
Dialogue: 0,0:04:52.08,0:04:55.92,Default conan,,0,0,0,,‫ حيث أجعل اتجاه وجه قطعة الفارس مقابلاً لوجهي...
Dialogue: 0,0:04:56.92,0:04:58.46,Default conan,,0,0,0,,‫أنا جبان لذلك لا أستطيع...
Dialogue: 0,0:04:58.63,0:05:01.92,Default conan,,0,0,0,,‫أن أهدأ ما لم يراقبني الحصان...
Dialogue: 0,0:05:03.72,0:05:08.01,Default conan,,0,0,0,,‫هنا تدور المعركة! النصر لا يُنتزع بالقوة، بل بالعقل!
Dialogue: 0,0:05:08.60,0:05:12.56,Default conan,,0,0,0,,‫التشاؤم والخرافات لا تجلب أي خير
Dialogue: 0,0:05:13.14,0:05:15.89,Default conan,,0,0,0,,‫هذا يذكرني بشخص من العام الماضي
Dialogue: 0,0:05:16.80,0:05:18.44,Default conan,,0,0,0,,‫أحمق يُدعى على ما اعتقد ريوتشيرو ساسُو.
Dialogue: 0,0:05:18.61,0:05:21.82,Default conan,,0,0,0,,‫ جعل أغنية "Amazing Grace" نغمة رنين لهاتفه
Dialogue: 0,0:05:21.98,0:05:23.86,Default conan,,0,0,0,,‫تلك الموسيقى كانت تهزّ كيانه من الأعماق.
Dialogue: 0,0:05:24.16,0:05:26.81,Default conan,,0,0,0,,‫وتجلب له الفأل الجيد
Dialogue: 0,0:05:27.35,0:05:28.71,Default conan,,0,0,0,,‫أجل أجل
Dialogue: 0,0:05:29.77,0:05:30.84,Default conan,,0,0,0,,‫لقد فوجئت بذلك
Dialogue: 0,0:05:31.35,0:05:33.77,Default conan,,0,0,0,,‫من كان ليظن أن ذلك سيسبب خسارته
Dialogue: 0,0:05:34.00,0:05:36.12,Default conan,,0,0,0,,‫كفوا عن الحديث في هذا الأمر
Dialogue: 0,0:05:36.37,0:05:38.92,Default conan,,0,0,0,,‫أنت تعرفون ماذا حدث له ، أليس كذلك؟
Dialogue: 0,0:05:39.63,0:05:41.84,Default conan,,0,0,0,,‫- نعم. - آسف...
Dialogue: 0,0:05:44.84,0:05:47.38,Default conan,,0,0,0,,‫الآن ستبدأ الجولة الأولى ،
Dialogue: 0,0:05:47.55,0:05:49.47,Default conan,,0,0,0,,‫يرجى من الجميع الجلوس في مقاعدهم
Dialogue: 0,0:05:50.10,0:05:52.76,Default conan,,0,0,0,,‫لقد أخذت إجازة لهذه البطولة
Dialogue: 0,0:05:53.06,0:05:55.43,Default conan,,0,0,0,,‫من الأفضل لي أن أتألق هنا
Dialogue: 0,0:05:57.21,0:06:00.15,Default conan,,0,0,0,,‫لم أتوقع أن تكون خضمي في الجولة الأولى
Dialogue: 0,0:06:02.02,0:06:03.32,Default conan,,0,0,0,,‫المفوض كورودا!
Dialogue: 0,0:06:04.36,0:06:05.99,Default conan,,0,0,0,,‫أرجو أن تكون متساهلاً معي
Dialogue: 0,0:06:06.61,0:06:08.24,Default conan,,0,0,0,,‫المفتش شيراتوري.
Dialogue: 0,0:06:10.39,0:06:14.54,Default conan,,0,0,0,,‫وبعد كل هذا العناء ومجيئنا لدعمه يمنع علينا الدخول لقاعة المباريات
Dialogue: 0,0:06:14.75,0:06:16.26,Default conan,,0,0,0,,‫ما هذا الهراء؟
Dialogue: 0,0:06:17.58,0:06:19.83,Default conan,,0,0,0,,‫لن تفهموا شيئاً على أية حالة أليس كذلك ؟
Dialogue: 0,0:06:20.21,0:06:23.55,Default conan,,0,0,0,,‫كما أنه يمنع إصدار أي نوع من الضوضاء خلال المباراة
Dialogue: 0,0:06:24.13,0:06:27.85,Default conan,,0,0,0,,‫رنين الهاتف المحمول يعني الإقصاء الفوري
Dialogue: 0,0:06:32.64,0:06:33.81,Default conan,,0,0,0,,‫هذه الموسيقى ...
Dialogue: 0,0:06:40.69,0:06:43.23,Default conan,,0,0,0,,‫لقد هزمت بالفعل ، المفتش شيراتوري؟
Dialogue: 0,0:06:44.26,0:06:46.27,Default conan,,0,0,0,,‫كان خصمي صعباً.
Dialogue: 0,0:06:46.65,0:06:48.95,Default conan,,0,0,0,,‫الحادثة المفاجئة
Dialogue: 0,0:06:49.15,0:06:51.49,Default conan,,0,0,0,,‫ليس أمراً تلام عليه
Dialogue: 0,0:06:52.03,0:06:53.95,Default conan,,0,0,0,,‫المفورض كورودا!
Dialogue: 0,0:06:54.99,0:06:57.04,Default conan,,0,0,0,,‫أنا أيضًا من محبي الشطرنج.
Dialogue: 0,0:06:57.41,0:07:01.12,Default conan,,0,0,0,,‫هل يعقل أنك سمعت عن الحادثة غير المتوقعة في قاعة البطولة؟
Dialogue: 0,0:07:01.62,0:07:05.38,Default conan,,0,0,0,,‫أجل يبدو أن أحداً ما جعل نغمة رنين لهاتفه
Dialogue: 0,0:07:06.09,0:07:08.38,Default conan,,0,0,0,,‫على أي حال وجدنه خلف الستاره
Dialogue: 0,0:07:08.66,0:07:14.01,Default conan,,0,0,0,,‫فخلصنا إلى أن الهاتف قد نسيُ هناك من طرف ليس له علاقة بالمباريات
Dialogue: 0,0:07:14.55,0:07:16.14,Default conan,,0,0,0,,‫ولكن يا للخيبة
Dialogue: 0,0:07:16.31,0:07:19.27,Default conan,,0,0,0,,‫رغم أنك حصلت على تميمة من المعلمة كوباياشي
Dialogue: 0,0:07:19.86,0:07:20.54,Default conan,,0,0,0,,‫لا عليكِ
Dialogue: 0,0:07:24.61,0:07:25.11,Default conan,,0,0,0,,‫عجباً
Dialogue: 0,0:07:25.77,0:07:27.73,Default conan,,0,0,0,,‫لقد اختفت ميدالية الفارس ؟
Dialogue: 0,0:07:28.93,0:07:29.30,Default conan,,0,0,0,,‫غريب
Dialogue: 0,0:07:29.83,0:07:30.24,Default conan,,0,0,0,,‫غريب
Dialogue: 0,0:07:30.53,0:07:37.08,Default conan,,0,0,0,,‫لا تحبط! فكّر في المشروب الذي سنحتسيه بانتظار مباراتك القادمة!
Dialogue: 0,0:07:37.33,0:07:38.62,Default conan,,0,0,0,,‫مـ.. معك حق
Dialogue: 0,0:07:38.94,0:07:41.14,Default conan,,0,0,0,,‫أين يمكن أنني أسقطته !؟
Dialogue: 0,0:07:43.00,0:07:45.75,Default conan,,0,0,0,,‫لقد نسيت شيئًاما في قاعة المباريات
Dialogue: 0,0:07:46.63,0:07:48.42,Default conan,,0,0,0,,‫لذا انتظروني رجاءً بالغرفة
Dialogue: 0,0:07:49.38,0:07:49.92,Default conan,,0,0,0,,‫حسناً
Dialogue: 0,0:07:50.51,0:07:53.64,Default conan,,0,0,0,,‫هل أسقطتها عندما أخرجت منديلي في الحمام بعد الجولة ؟
Dialogue: 0,0:07:54.20,0:07:58.77,Default conan,,0,0,0,,‫أم حين أخرجتُ هاتفي في السلالم لأُخبر كاموي بخسارتي؟
Dialogue: 0,0:07:59.89,0:08:03.15,Default conan,,0,0,0,,‫أم عندما أخرجت محفظتي أمام آلة بيع المشروبات لشراء القهوة ؟
Dialogue: 0,0:08:03.60,0:08:05.11,Default conan,,0,0,0,,‫أين يمكن أن يكون
Dialogue: 0,0:08:06.04,0:08:06.67,Default conan,,0,0,0,,‫أيـــــــن ؟
Dialogue: 0,0:08:09.99,0:08:11.16,Default conan,,0,0,0,,‫دعوني أقدم نفسي من جديد
Dialogue: 0,0:08:11.40,0:08:13.66,Default conan,,0,0,0,,‫كوردا هيوي من  شرطة طوكيو
Dialogue: 0,0:08:14.03,0:08:17.61,Default conan,,0,0,0,,‫أنا المشرفة على فصل كونان ورفاقه كوباياشي سوميكو
Dialogue: 0,0:08:18.26,0:08:21.64,Default conan,,0,0,0,,‫لقد التقينا سابقاً بالفعل المعلمة واكاسا أليس كذلك ؟
Dialogue: 0,0:08:21.91,0:08:24.83,Default conan,,0,0,0,,‫بالتأكيد ، التقينا بمناسبة التخييم!
Dialogue: 0,0:08:25.25,0:08:25.92,Default conan,,0,0,0,,‫كلا
Dialogue: 0,0:08:26.71,0:08:29.67,Default conan,,0,0,0,,‫يبدو لي أن التقينا قبل حتى قبل التخييم
Dialogue: 0,0:08:30.76,0:08:34.09,Default conan,,0,0,0,,‫وعلاوة على هذا في إحداى جَوْلات لعبة الشطرنج
Dialogue: 0,0:08:35.51,0:08:37.43,Default conan,,0,0,0,,‫أليس كذلك؟
Dialogue: 0,0:08:39.29,0:08:40.07,Default conan,,0,0,0,,‫كلا
Dialogue: 0,0:08:40.53,0:08:41.29,Default conan,,0,0,0,,‫أرجح أنهُ
Dialogue: 0,0:08:41.81,0:08:46.10,Default conan,,0,0,0,,‫أنك تخلط بيني وبين شخص آخر
Dialogue: 0,0:08:48.89,0:08:51.66,Default conan,,0,0,0,,‫سحقاً من ... من يكون؟
Dialogue: 0,0:08:52.16,0:08:53.99,Default conan,,0,0,0,,‫من الذي أرسل لي هذه البريد
Dialogue: 0,0:08:58.87,0:08:59.37,Default conan,,0,0,0,,‫ هذه ...
Dialogue: 0,0:08:59.85,0:09:02.19,Default conan,,0,0,0,,‫ميدالية الفارس إنها تنتمي إلى ذلك الرجل.
Dialogue: 0,0:09:09.10,0:09:11.37,Default conan,,0,0,0,,‫ماذا ؟ أنتما أيضاً انتيهيتما
Dialogue: 0,0:09:11.59,0:09:14.09,Default conan,,0,0,0,,‫نعم ! لقد تغلبت أخيرًا على السيد أوغاوارا!
Dialogue: 0,0:09:14.67,0:09:16.72,Default conan,,0,0,0,,‫لن يحدث ذلك مرة أخرى!
Dialogue: 0,0:09:18.89,0:09:20.26,Default conan,,0,0,0,,‫ماذا كان هذا الصوت؟
Dialogue: 0,0:09:20.81,0:09:21.60,Default conan,,0,0,0,,‫لا أعرف.
Dialogue: 0,0:09:22.06,0:09:25.19,Default conan,,0,0,0,,‫بالحديث عن الأصوات رنة الهاتف تلك التي شغلت في الجولة
Dialogue: 0,0:09:25.35,0:09:27.02,Default conan,,0,0,0,,‫كانت أغنيته.
Dialogue: 0,0:09:27.31,0:09:29.77,Default conan,,0,0,0,,‫لابد أن ذلك من قبل شبحه
Dialogue: 0,0:09:29.94,0:09:31.15,Default conan,,0,0,0,,‫لا يمكن ذلك
Dialogue: 0,0:09:34.65,0:09:36.49,Default conan,,0,0,0,,‫بطولة الشطرنج غرفة الانتظار
Dialogue: 0,0:09:55.38,0:09:56.55,Default conan,,0,0,0,,‫هل أنت بخير ؟؟
Dialogue: 0,0:09:57.09,0:09:58.47,Default conan,,0,0,0,,‫ما هذا الشيء؟
Dialogue: 0,0:09:58.64,0:10:01.56,Default conan,,0,0,0,,‫انغرز سهم  ، على إطار الحقيبة!
Dialogue: 0,0:10:01.74,0:10:02.61,Default conan,,0,0,0,,‫مستحيل !!
Dialogue: 0,0:10:03.89,0:10:04.81,Default conan,,0,0,0,,‫إنه مفتوح!
Dialogue: 0,0:10:06.77,0:10:09.27,Default conan,,0,0,0,,‫أُطلق السهم من خلال الباب إذن
Dialogue: 0,0:10:09.53,0:10:10.24,Default conan,,0,0,0,,‫سحقاً
Dialogue: 0,0:10:10.61,0:10:12.98,Default conan,,0,0,0,,‫ابقوا هنا وأغلقوا الباب!
Dialogue: 0,0:10:14.02,0:10:14.57,Default conan,,0,0,0,,‫إلى أين ؟
Dialogue: 0,0:10:15.74,0:10:17.15,Default conan,,0,0,0,,‫إلى أين هرب !؟
Dialogue: 0,0:10:18.15,0:10:19.74,Note,,0,0,0,,‫حمام قيد التنظيف
Dialogue: 0,0:10:20.37,0:10:22.49,Default conan,,0,0,0,,‫هذه اللوحة تختلف عن مارأيت في الطابق الآخر
Dialogue: 0,0:10:21.78,0:10:22.99,Note,,0,0,0,,‫حمام قيد التنظيف
Dialogue: 0,0:10:23.16,0:10:25.33,Note,,0,0,0,,‫حمام قيد التنظيف
Dialogue: 0,0:10:23.20,0:10:24.04,Default conan,,0,0,0,,‫أيعقل؟
Dialogue: 0,0:10:28.41,0:10:29.08,Default conan,,0,0,0,,‫دم !؟
Dialogue: 0,0:10:41.97,0:10:43.51,Default conan,,0,0,0,,‫نشابة سهام ؟
Dialogue: 0,0:10:45.81,0:10:47.43,Note,,0,0,0,,‫يونداي الأسبوعية
Dialogue: 0,0:10:48.02,0:10:50.10,Default conan,,0,0,0,,‫ميدالة قطعة... الفارس؟
Dialogue: 0,0:10:58.70,0:10:59.90,Default conan,,0,0,0,,‫جـ...جريمة قتل؟
Dialogue: 0,0:11:00.24,0:11:03.16,Default conan,,0,0,0,,‫لقد ارتكبت الجريمة في الطابق السابع عشر
Dialogue: 0,0:11:03.95,0:11:07.79,Default conan,,0,0,0,,‫الضحية هو شاب مشارك في بطولة الشطرنج
Dialogue: 0,0:11:08.72,0:11:11.33,Default conan,,0,0,0,,‫كان في حالة جلوس على المرحاض بينما يحمل حقيبته
Dialogue: 0,0:11:11.58,0:11:15.17,Default conan,,0,0,0,,‫ومات على إثر تلقيه السهام على ساقيه وصدره
Dialogue: 0,0:11:16.25,0:11:19.30,Default conan,,0,0,0,,‫عند أقدامه نشابة السهام ومجلة
Dialogue: 0,0:11:18.63,0:11:19.30,Default conan,,0,0,0,,‫يونداي الأسبوعية
Dialogue: 0,0:11:19.63,0:11:21.80,Default conan,,0,0,0,,‫ بالإضافة إلى ميدالية لقطعة الفارس الأبيض
Dialogue: 0,0:11:22.71,0:11:23.72,Default conan,,0,0,0,,‫تلك
Dialogue: 0,0:11:24.05,0:11:25.35,Default conan,,0,0,0,,‫تحدث لي كونان.
Dialogue: 0,0:11:25.89,0:11:28.27,Default conan,,0,0,0,,‫أعطتك أيها المعلمة كوباياشي كهدية أليس كذلك ؟
Dialogue: 0,0:11:29.06,0:11:32.31,Default conan,,0,0,0,,‫كنت قد تكون قد تواجدت في
Dialogue: 0,0:11:32.56,0:11:35.40,Default conan,,0,0,0,,‫مسرح الجريمة وعليه سنعاملك كمشتبه به
Dialogue: 0,0:11:35.75,0:11:36.57,Default conan,,0,0,0,,‫لا تمانع ؟
Dialogue: 0,0:11:37.19,0:11:37.86,Default conan,,0,0,0,,‫نعم.
Dialogue: 0,0:11:38.39,0:11:41.60,Default conan,,0,0,0,,‫حينما ذهبت معك إلى الحمام بعد المباراة
Dialogue: 0,0:11:41.86,0:11:44.57,Default conan,,0,0,0,,‫على الأرجح أنها وقعت أثناء إخراجي لمنديلي
Dialogue: 0,0:11:45.20,0:11:46.39,Default conan,,0,0,0,,‫ما باليد حيلة
Dialogue: 0,0:11:47.22,0:11:50.43,Default conan,,0,0,0,,‫كنت أبحث عن تلك الميدالية للتو
Dialogue: 0,0:11:50.58,0:11:52.67,Default conan,,0,0,0,,‫لقد بحثت في دورة المياه أولاً
Dialogue: 0,0:11:52.90,0:11:55.82,Default conan,,0,0,0,,‫لكنني لم أجدها قرب المغاسل
Dialogue: 0,0:11:56.20,0:11:58.95,Default conan,,0,0,0,,‫لم يكن هناك لوحة مكتوب عليها الحمام قيد التنظيف؟
Dialogue: 0,0:11:59.46,0:12:06.22,Default conan,,0,0,0,,‫نعم عندما دخلت، كان أحد حجرات المراحيض مغلقة، ربما من قبل الضحية
Dialogue: 0,0:12:07.14,0:12:08.88,Default conan,,0,0,0,,‫لم أجد ميداليتي
Dialogue: 0,0:12:09.27,0:12:11.73,Default conan,,0,0,0,,‫ربما أوقعتها في تلك الحجرة
Dialogue: 0,0:12:12.23,0:12:14.79,Default conan,,0,0,0,,‫ما لم يكن المجني عليه هو من التقطها بنفسه
Dialogue: 0,0:12:15.58,0:12:21.53,Default conan,,0,0,0,,‫وبعد أن خرجت من دوراة المياه خالي الوفاض، توجهت لتفقد تلك السلالم
Dialogue: 0,0:12:21.74,0:12:23.53,Default conan,,0,0,0,,‫لماذا هذا المكان؟
Dialogue: 0,0:12:24.01,0:12:26.06,Default conan,,0,0,0,,‫لقد وعدت كبيرالخدم
Dialogue: 0,0:12:26.24,0:12:28.54,Default conan,,0,0,0,,‫بأن أبلغه بنتائجي.
Dialogue: 0,0:12:30.45,0:12:32.33,Default conan,,0,0,0,,‫آسف، لدي مكالمة يجب أن أجريها.
Dialogue: 0,0:12:32.79,0:12:36.42,Default conan,,0,0,0,,‫هل ظننت أنك فقدته عندما أخرجت هاتفك هنا؟
Dialogue: 0,0:12:37.00,0:12:40.67,Default conan,,0,0,0,,‫هل مر أي شخص هنا أثناء بحثك؟
Dialogue: 0,0:12:41.17,0:12:42.17,Default conan,,0,0,0,,‫لا ، لماذا؟
Dialogue: 0,0:12:43.55,0:12:47.93,Default conan,,0,0,0,,‫شارك الضحية في بطولة الشطرنج المنظمة هنا.
Dialogue: 0,0:12:48.72,0:12:51.10,Default conan,,0,0,0,,‫إنه ناوتو كيشيتاني ، 32 سنة.
Dialogue: 0,0:12:51.85,0:12:52.77,Default conan,,0,0,0,,‫سلاح الجريمة هو السهم 
Dialogue: 0,0:12:53.10,0:12:56.44,Default conan,,0,0,0,,‫المقاطع الموجود عند قدميه.
Dialogue: 0,0:12:57.44,0:12:59.77,Default conan,,0,0,0,,‫أما بالنسبة لسلسلة المفاتيح القريبة
Dialogue: 0,0:13:00.03,0:13:02.61,Default conan,,0,0,0,,‫هل هو حقًا خاص بشيراتوري؟
Dialogue: 0,0:13:03.11,0:13:06.45,Default conan,,0,0,0,,‫نعم ، هو نفسه حددها.
Dialogue: 0,0:13:07.41,0:13:10.33,Default conan,,0,0,0,,‫حسنًا ، دعنا نلخص الموقف.
Dialogue: 0,0:13:10.70,0:13:12.91,Default conan,,0,0,0,,‫اليوم، حوالي الساعة 11:30،
Dialogue: 0,0:13:13.08,0:13:16.58,Default conan,,0,0,0,,‫السيد إيغاوارا، الذي مثل الضحية، يشارك في هذه البطولة،
Dialogue: 0,0:13:16.88,0:13:20.59,Default conan,,0,0,0,,‫كان يشرب الشاي في الغرفة بعد مباراته،
Dialogue: 0,0:13:20.80,0:13:23.01,Default conan,,0,0,0,,‫تعرض لإطلاق سهم من القوس النشاب.
Dialogue: 0,0:13:23.30,0:13:25.34,Default conan,,0,0,0,,‫بما أن الباب كان مفتوحًا قليلاً،
Dialogue: 0,0:13:25.51,0:13:28.80,Default conan,,0,0,0,,‫استنتجو الرئيس كورودا وكونان أن الإطلاق
Dialogue: 0,0:13:28.97,0:13:30.10,Default conan,,0,0,0,,‫ جاء من هناك،
Dialogue: 0,0:13:30.39,0:13:34.56,Default conan,,0,0,0,,‫وانطلق كلاهما في مطاردة الجاني.
Dialogue: 0,0:13:34.89,0:13:36.06,Default conan,,0,0,0,,‫أثناء المطاردة،
Dialogue: 0,0:13:36.27,0:13:42.61,Note,,0,0,0,,‫دورات المياه قيد التنظيف
Dialogue: 0,0:13:36.52,0:13:38.61,Default conan,,0,0,0,,‫لافتة تنظيف دورات المياه
Dialogue: 0,0:13:38.86,0:13:42.23,Default conan,,0,0,0,,‫تختلف عن تلك في الطوابق الأخرى،
Dialogue: 0,0:13:42.78,0:13:43.90,Default conan,,0,0,0,,‫فدخلوا دورات المياه.
Dialogue: 0,0:13:44.53,0:13:48.20,Default conan,,0,0,0,,‫واكتشفوا جثة السيد كيشيتاني.
Dialogue: 0,0:13:49.16,0:13:51.03,Default conan,,0,0,0,,‫تعرض للهجوم في الغرفة،
Dialogue: 0,0:13:51.28,0:13:54.41,Default conan,,0,0,0,,‫ألم ترَ المهاجم يهرب؟
Dialogue: 0,0:13:55.08,0:13:57.12,Default conan,,0,0,0,,‫لا، كنت في حالة صدمة.
Dialogue: 0,0:13:58.58,0:14:02.67,Default conan,,0,0,0,,‫أستنتج أنه غادر المبنى.
Dialogue: 0,0:14:02.84,0:14:03.42,Default conan,,0,0,0,,‫خطأ!
Dialogue: 0,0:14:03.96,0:14:05.26,Default conan,,0,0,0,,‫أربعة أشخاص
Dialogue: 0,0:14:05.67,0:14:08.18,Default conan,,0,0,0,,‫يمكنهم قتل كيشيتاني باستخدام القوس النشاب.
Dialogue: 0,0:14:09.26,0:14:10.05,Default conan,,0,0,0,,‫أربعة؟
Dialogue: 0,0:14:10.76,0:14:13.39,Default conan,,0,0,0,,‫عندما أُطلق على السيد إيغاوارا في الغرفة،
Dialogue: 0,0:14:13.77,0:14:17.06,Default conan,,0,0,0,,‫لم يكن أحد يستخدم المصعد في هذا الطابق.
Dialogue: 0,0:14:17.23,0:14:17.94,Default conan,,0,0,0,,‫بالضبط.
Dialogue: 0,0:14:18.31,0:14:20.98,Default conan,,0,0,0,,‫أكد لي ذلك مركز الأمن.
Dialogue: 0,0:14:21.15,0:14:24.82,Default conan,,0,0,0,,‫بعد الجريمة، لم يستخدم أحد المصعد
Dialogue: 0,0:14:24.98,0:14:25.94,Default conan,,0,0,0,,‫في هذا الطابق.
Dialogue: 0,0:14:26.57,0:14:29.03,Default conan,,0,0,0,,‫السلالم هي المخرج الوحيد المتبقي،
Dialogue: 0,0:14:29.20,0:14:32.62,Default conan,,0,0,0,,‫لكن المفتش شيراتوري كان يبحث عن ميدالية،
Dialogue: 0,0:14:32.78,0:14:34.20,Default conan,,0,0,0,,‫لذا كان الأمر ميؤوسًا منه.
Dialogue: 0,0:14:34.70,0:14:37.46,Default conan,,0,0,0,,‫أشير إلى أن المفتش هو أحد المشتبه بهم.
Dialogue: 0,0:14:39.62,0:14:41.84,Default conan,,0,0,0,,‫هل هناك شكوك حوله أيضًا؟
Dialogue: 0,0:14:42.00,0:14:42.75,Default conan,,0,0,0,,‫هذا جنون!
Dialogue: 0,0:14:42.92,0:14:44.38,Default conan,,0,0,0,,‫هل قتلته؟
Dialogue: 0,0:14:44.55,0:14:46.01,Default conan,,0,0,0,,‫بالطبع لا!
Dialogue: 0,0:14:46.17,0:14:47.72,Default conan,,0,0,0,,‫لنهدأ!
Dialogue: 0,0:14:48.34,0:14:51.30,Default conan,,0,0,0,,‫إذن؟ من هم المشتبه بهم الثلاثة الآخرون؟
Dialogue: 0,0:14:51.80,0:14:52.72,Default conan,,0,0,0,,‫أثناء الجريمة،
Dialogue: 0,0:14:53.22,0:14:56.93,Default conan,,0,0,0,,‫باستثناء الرئيس كورودا ونحن، الأشخاص الذين يمكنهم التحرك بحرية
Dialogue: 0,0:14:57.18,0:14:59.48,Default conan,,0,0,0,,‫في هذا الطابق هم:
Dialogue: 0,0:15:00.02,0:15:03.02,Default conan,,0,0,0,,‫الرجل الذي لعب مباراة خاطفة ضد الضحية،
Dialogue: 0,0:15:03.19,0:15:06.23,Default conan,,0,0,0,,‫ثم غادر قاعة البطولة: السيد كيساكي.
Dialogue: 0,0:15:06.69,0:15:09.82,Default conan,,0,0,0,,‫السيد إيغاوارا، الذي تعرض لإطلاق سهم في الغرفة،
Dialogue: 0,0:15:10.57,0:15:12.91,Default conan,,0,0,0,,‫وأخيرًا، خصمه،
Dialogue: 0,0:15:13.07,0:15:16.79,Default conan,,0,0,0,,‫الآنسة شيروي، التي حققت أيضًا انتصارًا سريعًا.
Dialogue: 0,0:15:17.37,0:15:21.29,Default conan,,0,0,0,,‫لكن يجب النظر في فرضية الانتحار، أليس كذلك؟
Dialogue: 0,0:15:21.46,0:15:23.79,Default conan,,0,0,0,,‫يمكنه استخدام القوس النشاب ضد نفسه.
Dialogue: 0,0:15:24.00,0:15:25.00,Default conan,,0,0,0,,‫لا.
Dialogue: 0,0:15:25.71,0:15:29.05,Default conan,,0,0,0,,‫درجة حرارة الجثة، وشحوب الوجه
Dialogue: 0,0:15:29.22,0:15:31.38,Default conan,,0,0,0,,‫والتخشب الرمحي تشير
Dialogue: 0,0:15:31.84,0:15:33.89,Default conan,,0,0,0,,‫إلى أن الضحية عُثر عليها بعد وفاتها بقليل،
Dialogue: 0,0:15:34.14,0:15:37.64,Default conan,,0,0,0,,‫لكن كمية الدم المتدفقة تثبت أن السهام
Dialogue: 0,0:15:37.81,0:15:39.89,Default conan,,0,0,0,,‫لم تقتله على الفور.
Dialogue: 0,0:15:40.27,0:15:43.65,Default conan,,0,0,0,,‫لماذا كانت أداة الجريمة بجانب الجثة إذن؟
Dialogue: 0,0:15:43.81,0:15:45.65,Default conan,,0,0,0,,‫لمحاكاة الانتحار،
Dialogue: 0,0:15:45.82,0:15:49.03,Default conan,,0,0,0,,‫تركها القاتل عمدًا قبل الهروب.
Dialogue: 0,0:15:49.82,0:15:50.95,Default conan,,0,0,0,,‫لحظة!
Dialogue: 0,0:15:51.11,0:15:54.53,Default conan,,0,0,0,,‫لماذا أنا مشتبه به، بينما أُطلق عليّ سهم؟
Dialogue: 0,0:15:54.87,0:15:56.16,Default conan,,0,0,0,,‫فقط كإجراء احترازي.
Dialogue: 0,0:15:56.53,0:16:00.96,Default conan,,0,0,0,,‫قد نجد لاحقًا نشابة سهام !
Dialogue: 0,0:16:01.33,0:16:02.37,Default conan,,0,0,0,,‫سادتي!
Dialogue: 0,0:16:02.67,0:16:05.38,Default conan,,0,0,0,,‫هل تعتمد الشرطة على طفل؟
Dialogue: 0,0:16:06.54,0:16:08.63,Default conan,,0,0,0,,‫ما خطبكم؟
Dialogue: 0,0:16:08.96,0:16:10.01,Default conan,,0,0,0,,‫وما خطبك؟
Dialogue: 0,0:16:10.38,0:16:13.84,Default conan,,0,0,0,,‫هناك تمزق على ظهر سترتك.
Dialogue: 0,0:16:14.64,0:16:15.39,Default conan,,0,0,0,,‫تمزق؟
Dialogue: 0,0:16:16.30,0:16:19.06,Default conan,,0,0,0,,‫أشك أن يكون هذا الموضة.
Dialogue: 0,0:16:20.35,0:16:22.06,Default conan,,0,0,0,,‫أي تمزق؟
Dialogue: 0,0:16:24.48,0:16:27.57,Default conan,,0,0,0,,‫لم ألاحظ! كيف حدث هذا؟
Dialogue: 0,0:16:28.78,0:16:31.19,Default conan,,0,0,0,,‫ربما قرب آلات البيع؟
Dialogue: 0,0:16:31.57,0:16:34.36,Default conan,,0,0,0,,‫بعد مبارياتنا، كنا نتحدث نحن الثلاثة،
Dialogue: 0,0:16:34.70,0:16:36.99,Default conan,,0,0,0,,‫عندما سمعنا صوتًا غريبًا.
Dialogue: 0,0:16:40.04,0:16:41.08,Default conan,,0,0,0,,‫كنت أعرف!
Dialogue: 0,0:16:41.29,0:16:43.87,Default conan,,0,0,0,,‫هناك سهم مغروس!
Dialogue: 0,0:16:44.33,0:16:48.34,Default conan,,0,0,0,,‫إذن هذا السهم خدش ظهري، في تلك اللحظة؟
Dialogue: 0,0:16:49.05,0:16:51.01,Default conan,,0,0,0,,‫ربما كنت الهدف!
Dialogue: 0,0:16:51.55,0:16:55.84,Default conan,,0,0,0,,‫لا! ثم أُطلق عليّ أنا!
Dialogue: 0,0:16:57.80,0:17:01.81,Default conan,,0,0,0,,‫سيخبر كل منكم أين كنتم وماذا كنتم تفعلون
Dialogue: 0,0:17:02.02,0:17:04.02,Default conan,,0,0,0,,‫بعد مبارياتكم.
Dialogue: 0,0:17:04.56,0:17:06.31,Default conan,,0,0,0,,‫ابدأ أنت، شيراتوري.
Dialogue: 0,0:17:06.73,0:17:07.40,Default conan,,0,0,0,,‫حسنًا.
Dialogue: 0,0:17:08.02,0:17:10.48,Default conan,,0,0,0,,‫بعد مغادرة القاعة، ذهبت إلى المرحاض.
Dialogue: 0,0:17:10.82,0:17:12.99,Default conan,,0,0,0,,‫شربت قهوة أمام آلات البيع،
Dialogue: 0,0:17:13.15,0:17:15.61,Default conan,,0,0,0,,‫وبعد مكالمة على السلالم،
Dialogue: 0,0:17:15.78,0:17:19.41,Default conan,,0,0,0,,‫بقيت مع الرئيس كورودا قبل الالتحاق بالآنسة كوباياشي.
Dialogue: 0,0:17:19.95,0:17:23.58,Default conan,,0,0,0,,‫ثم لاحظت أنني فقدت حامل مفاتيحي.
Dialogue: 0,0:17:23.79,0:17:26.04,Default conan,,0,0,0,,‫كنت أبحث عنه بمفردي، على السلالم،
Dialogue: 0,0:17:26.21,0:17:28.67,Default conan,,0,0,0,,‫عندما أخبرني الرئيس بالجريمة.
Dialogue: 0,0:17:28.96,0:17:30.00,Default conan,,0,0,0,,‫أفهم...
Dialogue: 0,0:17:30.71,0:17:32.30,Default conan,,0,0,0,,‫والآن، السيد كيساكي.
Dialogue: 0,0:17:32.63,0:17:33.21,Default conan,,0,0,0,,‫حسنًا.
Dialogue: 0,0:17:33.80,0:17:38.05,Default conan,,0,0,0,,‫غادرت القاعة مع كيشيتاني واشتريت علبة عصير،
Dialogue: 0,0:17:38.30,0:17:40.22,Default conan,,0,0,0,,‫عندما وصل السيد إيغاوارا وشيروي.
Dialogue: 0,0:17:40.93,0:17:43.73,Default conan,,0,0,0,,‫بعد سماع الصوت الغريب،
Dialogue: 0,0:17:44.18,0:17:45.69,Default conan,,0,0,0,,‫لعبت على هاتفي
Dialogue: 0,0:17:45.85,0:17:48.73,Default conan,,0,0,0,,‫أمام آلات البيع، قبل وقوع الحادث.
Dialogue: 0,0:17:49.27,0:17:52.69,Default conan,,0,0,0,,‫ماذا كان يفعل السيد كيشيتاني، خصمك؟
Dialogue: 0,0:17:54.11,0:17:58.57,Default conan,,0,0,0,,‫كان ينوي شراء مشروب معي من الآلة،
Dialogue: 0,0:17:59.03,0:18:02.41,Default conan,,0,0,0,,‫لكنه تلقى بريدًا إلكترونيًا،
Dialogue: 0,0:18:02.58,0:18:05.54,Default conan,,0,0,0,,‫وبعد قراءته، أصبح شاحبًا وركض إلى مكان مجهول.
Dialogue: 0,0:18:05.91,0:18:10.50,Default conan,,0,0,0,,‫لم يكن هناك هاتف ذكي بين ممتلكاته الشخصية...
Dialogue: 0,0:18:11.50,0:18:14.46,Default conan,,0,0,0,,‫حقًا؟ ربما سرقه القاتل؟
Dialogue: 0,0:18:16.30,0:18:17.34,Default conan,,0,0,0,,‫الآنسة شيروي؟
Dialogue: 0,0:18:17.80,0:18:21.01,Default conan,,0,0,0,,‫كما قلت سابقًا، غادرت قاعة البطولة،
Dialogue: 0,0:18:21.18,0:18:23.47,Default conan,,0,0,0,,‫وقبل لقاء كيساكي،
Dialogue: 0,0:18:23.64,0:18:26.73,Default conan,,0,0,0,,‫كنت دائمًا مع السيد إيغاوارا، خصمي.
Dialogue: 0,0:18:27.06,0:18:30.69,Default conan,,0,0,0,,‫افترقنا أنا وهو أمام المرحاض.
Dialogue: 0,0:18:30.86,0:18:32.86,Default conan,,0,0,0,,‫إذن ذهبتِ إلى المرحاض؟
Dialogue: 0,0:18:33.02,0:18:33.61,Default conan,,0,0,0,,‫نعم.
Dialogue: 0,0:18:33.94,0:18:34.94,Default conan,,0,0,0,,‫وماذا بعد؟
Dialogue: 0,0:18:35.40,0:18:36.99,Default conan,,0,0,0,,‫بقيت هناك لبعض الوقت.
Dialogue: 0,0:18:37.53,0:18:41.87,Default conan,,0,0,0,,‫كنت أستعيد نتيجة مباراتي ضد السيد إيغاوارا.
Dialogue: 0,0:18:42.58,0:18:45.12,Default conan,,0,0,0,,‫كان هذا أول انتصار لي عليه.
Dialogue: 0,0:18:45.91,0:18:48.46,Default conan,,0,0,0,,‫بينما كنتِ في المرحاض،
Dialogue: 0,0:18:48.62,0:18:52.67,Default conan,,0,0,0,,‫هل سمعتِ أصواتًا أو ضوضاء غريبة في حمام الرجال؟
Dialogue: 0,0:18:52.96,0:18:54.88,Default conan,,0,0,0,,‫من الممكن،
Dialogue: 0,0:18:55.38,0:18:59.22,Default conan,,0,0,0,,‫لكنني كنت أستمع إلى الموسيقى بسماعات الأذن.
Dialogue: 0,0:18:59.84,0:19:03.47,Default conan,,0,0,0,,‫بالمناسبة، افترقتِ عن الآنسة شيروي أمام المرحاض،
Dialogue: 0,0:19:03.64,0:19:05.68,Default conan,,0,0,0,,‫هل ذهبتَ أنت أيضًا؟
Dialogue: 0,0:19:05.97,0:19:07.02,Default conan,,0,0,0,,‫بالفعل.
Dialogue: 0,0:19:07.64,0:19:11.10,Default conan,,0,0,0,,‫كانت إحدى الكبائن مشغولة في ذلك الوقت،
Dialogue: 0,0:19:11.40,0:19:14.36,Default conan,,0,0,0,,‫لكن لا أعرف إذا كان كيشيتاني.
Dialogue: 0,0:19:14.98,0:19:16.90,Default conan,,0,0,0,,‫بعد أن قضيت حاجتي،
Dialogue: 0,0:19:17.19,0:19:19.32,Default conan,,0,0,0,,‫دخلت الغرفة المشغولة مسبقًا
Dialogue: 0,0:19:19.57,0:19:21.78,Default conan,,0,0,0,,‫وعندما كنت أشرب الشاي،
Dialogue: 0,0:19:22.32,0:19:25.04,Default conan,,0,0,0,,‫أُطلق عليّ سهم من القوس النشاب.
Dialogue: 0,0:19:25.37,0:19:28.29,Default conan,,0,0,0,,‫أفهم... بالمناسبة، في المرحاض،
Dialogue: 0,0:19:28.83,0:19:31.33,Default conan,,0,0,0,,‫هل رأيتِ هذا حامل المفاتيح؟
Dialogue: 0,0:19:31.62,0:19:32.50,Default conan,,0,0,0,,‫لا...
Dialogue: 0,0:19:34.59,0:19:36.59,Default conan,,0,0,0,,‫هل تسمح لي بفحصه عن قرب؟
Dialogue: 0,0:19:40.34,0:19:41.47,Default conan,,0,0,0,,‫كنت أظن ذلك.
Dialogue: 0,0:19:41.84,0:19:45.72,Default conan,,0,0,0,,‫لم ألحظه في مسرح الجريمة، لأن الجزء الأيسر فقط كان مرئيًا،
Dialogue: 0,0:19:46.60,0:19:50.89,Default conan,,0,0,0,,‫لكن يدًا ملطخة بالدماء أمسكت الجهة اليمنى من هذه القطعة.
Dialogue: 0,0:20:16.96,0:20:17.59,Default conan,,0,0,0,,‫أليس كذلك،
Dialogue: 0,0:20:18.09,0:20:19.09,Default conan,,0,0,0,,‫الرئيس كورودا؟
Dialogue: 0,0:20:20.67,0:20:23.22,Default conan,,0,0,0,,‫آسف، كنت غارقًا في أفكاري.
Dialogue: 0,0:20:23.59,0:20:27.18,Default conan,,0,0,0,,‫إذا أمسك السيد كيشيتاني القطعة بيده الملطخة بالدماء
Dialogue: 0,0:20:27.35,0:20:29.81,Default conan,,0,0,0,,‫بعد تعرضه لإطلاق السهم،
Dialogue: 0,0:20:30.39,0:20:34.48,Default conan,,0,0,0,,‫ربما ترك رسالة أخيرة قبل وفاته.
Dialogue: 0,0:20:35.02,0:20:36.61,Default conan,,0,0,0,,‫يبدو ذلك معقولًا.
Dialogue: 0,0:20:37.19,0:20:38.02,Default conan,,0,0,0,,‫رئيس!
Dialogue: 0,0:20:38.94,0:20:41.74,Default conan,,0,0,0,,‫عند إعادة فحص المجلة القريبة من الجثة،
Dialogue: 0,0:20:41.95,0:20:45.49,Default conan,,0,0,0,,‫عثرنا على صفحة كلمات متقاطعة ملطخة بالدماء.
Dialogue: 0,0:20:46.07,0:20:48.87,Default conan,,0,0,0,,‫يبدو أن أثر اليد هو رسالة مشفرة!
Dialogue: 0,0:20:49.04,0:20:51.62,Note,,0,0,0,,‫منشورات جديدة
Dialogue: 0,0:20:49.62,0:20:51.62,Default conan,,0,0,0,,‫بين البنصر والخنصر،
Dialogue: 0,0:20:52.16,0:20:54.96,Default conan,,0,0,0,,‫بقعة دم تشكل ياماغاتا.
Dialogue: 0,0:20:55.63,0:21:00.05,Default conan,,0,0,0,,‫وضع المتوفى دمه على الجزء السفلي من حامل المفاتيح، ثم وضعه.
Dialogue: 0,0:21:00.21,0:21:01.84,Default conan,,0,0,0,,‫للإشارة إلى اتجاهه!
Dialogue: 0,0:21:02.34,0:21:03.13,Default conan,,0,0,0,,‫في هذه الحالة،
Dialogue: 0,0:21:03.38,0:21:06.14,Default conan,,0,0,0,,‫إذا وضعناه كما يجبةعلى البقعة...
Dialogue: 0,0:21:09.18,0:21:10.52,Default conan,,0,0,0,,‫على ما يبدو،
Dialogue: 0,0:21:11.35,0:21:13.52,Default conan,,0,0,0,,‫تم وضعه كما في الافتتاح.
Dialogue: 0,0:21:14.35,0:21:16.10,Default conan,,0,0,0,,‫لكن حتى بناءً على ذلك،
Dialogue: 0,0:21:16.60,0:21:19.02,Default conan,,0,0,0,,‫معنى يد الدماء لا يزال لغزًا.
Dialogue: 0,0:21:19.94,0:21:21.23,Default conan,,0,0,0,,‫بماذا يتناغم هذا؟
Dialogue: 0,0:21:21.53,0:21:23.15,Default conan,,0,0,0,,‫مهلاً، كونان...
Dialogue: 0,0:21:23.74,0:21:26.99,Default conan,,0,0,0,,‫عثرنا على أشياء غريبة في سلة المهملات.
Dialogue: 0,0:21:27.16,0:21:28.12,Default conan,,0,0,0,,‫ماذا؟
Dialogue: 0,0:21:28.62,0:21:32.12,Default conan,,0,0,0,,‫حافظتا نظارات، بنفس اللون والشكل.
Dialogue: 0,0:21:32.58,0:21:36.83,Default conan,,0,0,0,,‫إحداهما كانت فارغة، بينما الأخرىزتحتوي على شظايا زجاج.
Dialogue: 0,0:21:37.00,0:21:40.80,Default conan,,0,0,0,,‫ربما هناك صلة بالجريمة؟
Dialogue: 0,0:21:42.59,0:21:43.59,Default conan,,0,0,0,,‫فهمت!
Dialogue: 0,0:21:44.13,0:21:45.38,Default conan,,0,0,0,,‫إذا كنت محقًا،
Dialogue: 0,0:21:45.76,0:21:47.97,Default conan,,0,0,0,,‫هذه اليد تكشف كل شيء!
Dialogue: 0,0:21:51.56,0:21:52.72,Default conan,,0,0,0,,‫لا شك،
Dialogue: 0,0:21:53.64,0:21:54.48,Default conan,,0,0,0,,‫الجاني،
Dialogue: 0,0:21:55.48,0:21:56.56,Default conan,,0,0,0,,‫هذا الشخص.
Dialogue: 0,0:21:55.48,0:21:56.56,Note,,0,0,0,,مشهد بعد الإيندنق
Dialogue: 0,0:21:58.70,0:22:00.00,DCEnding,,0,0,0,,هيا بنا
Dialogue: 0,0:22:01.86,0:22:03.61,DCEnding,,0,0,0,,{\pos(982,958)}‫مرح! مرح! مرح!
Dialogue: 0,0:22:05.67,0:22:11.88,DCEnding,,0,0,0,,{\pos(982,958)}‫قلبي ينبض بقوة قلبي ينبض بقوة أنا حقًا فضولي بشأن الحقيقة
Dialogue: 0,0:22:12.08,0:22:18.68,DCEnding,,0,0,0,,{\pos(982,958)}‫هل تحاول؟ من الصعب الكذب، أليس كذلك؟ يا! يا
Dialogue: 0,0:22:18.73,0:22:24.97,DCEnding,,0,0,0,,{\pos(982,958)}‫لاااا، أنا أفقد صوابي! هل من أحد يساعدني؟
Dialogue: 0,0:22:25.17,0:22:30.34,DCEnding,,0,0,0,,{\pos(982,958)}‫(كذبة أم حقيقة؟ لا أستطيع أن أقول (كل شيء أو لا شيء
Dialogue: 0,0:22:30.95,0:22:38.02,DCEnding,,0,0,0,,{\pos(982,958)}‫أنا في غاية الحب معك، أنا في غاية الحب معك
Dialogue: 0,0:22:38.17,0:22:44.71,DCEnding,,0,0,0,,{\pos(982,958)}‫يحب! هذا صحيح! سوف أتعرض لحروق شديدة
Dialogue: 0,0:22:44.87,0:22:52.04,DCEnding,,0,0,0,,{\pos(982,958)}‫تألق، ارقص معي، ارقص، ارقص، ارقص بابتسامة مبهرة
Dialogue: 0,0:22:53.21,0:22:59.38,DCEnding,,0,0,0,,{\pos(982,958)}‫أنسى الأشياء السيئة وأحبها، لا يمكن مساعدتها
Dialogue: 0,0:22:59.67,0:23:05.61,DCEnding,,0,0,0,,{\pos(982,958)}‫أنت وأنا وتلك الفتاة، إذا رقصنا، سنكون جميعًا سعداء
Dialogue: 0,0:23:06.05,0:23:12.22,DCEnding,,0,0,0,,{\pos(982,958)}‫تعال! تعال! أنت تتألق بشكل مشرق اليوم أيضًا
Dialogue: 0,0:23:12.87,0:23:17.86,DCEnding,,0,0,0,,{\pos(982,958)}‫إنه أمر ممتع عندما يكون الجميع هناك، لذلك دعونا نذهب!
Dialogue: 0,0:23:45.05,0:23:52.84,NEXT,,0,0,0,,{\pos(299,263)}‫الحلقة القادمة
Dialogue: 0,0:23:45.38,0:23:47.51,Default conan,,0,0,0,,‫الجاني ليس لديه حجة...
Dialogue: 0,0:23:47.67,0:23:49.34,Default conan,,0,0,0,,‫وهو هذا المفتش!
Dialogue: 0,0:23:50.18,0:23:53.43,Default conan,,0,0,0,,‫قبل وفاته، ترك السيد كيشيتاني
Dialogue: 0,0:23:53.85,0:23:55.68,Default conan,,0,0,0,,‫هذه الرسالة الأخيرة.
Dialogue: 0,0:23:56.47,0:23:58.85,Default conan,,0,0,0,,‫قد يستغرق هذا وقتًا،
Dialogue: 0,0:23:59.23,0:24:00.39,Default conan,,0,0,0,,‫هل أنت مستعد؟
Dialogue: 0,0:24:01.85,0:24:04.61,Default conan,,0,0,0,,‫أرسلوا كيانتي وكورن.
Dialogue: 0,0:24:05.65,0:24:08.61,Default conan,,0,0,0,,‫يجب التخلص من جميع المشتبه بهم.
Dialogue: 0,0:24:09.49,0:24:10.74,Default conan,,0,0,0,,‫في الحلقة القادمة
Dialogue: 0,0:24:10.90,0:24:14.53,Default conan,,0,0,0,,‫حقيقة مضت عليها 17 عامً: الشيطان المبصر
Dialogue: 0,0:24:30.08,0:24:34.83,Default conan,,0,0,0,,‫حافظة النظارات
Dialogue: 0,0:24:30.37,0:24:31.87,Default conan,,0,0,0,,‫تلميح كونان القادم،
Dialogue: 0,0:24:32.29,0:24:34.00,Default conan,,0,0,0,,‫حافظة النظارات!
Dialogue: 0,0:24:35.00,0:24:39.96,Default conan,,0,0,0,,‫لا تفوتوا في الحلقة القادمة
Dialogue: 0,0:24:35.25,0:24:36.79,Default conan,,0,0,0,,‫قبل 17 عامًا...
Dialogue: 0,0:24:36.96,0:24:39.29,Default conan,,0,0,0,,‫فلاش باك آخر لرجل أعور...
