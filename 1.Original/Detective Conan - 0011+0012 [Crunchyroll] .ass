Dialogue: 0,0:00:00.45,0:00:01.80,Default,,0000,0000,0000,,اسمي إيدوغاوا كونان
Dialogue: 0,0:00:01.80,0:00:04.60,Default,,0000,0000,0000,,أُجبر طالب الثانوية شينتشي على تجرّع\Nعقار قلّص جسده
Dialogue: 0,0:00:05.03,0:00:06.49,Default,,0000,0000,0000,,رغم صغر بنيتي، لا يزال دماغي كما هو
Dialogue: 0,0:00:06.49,0:00:08.36,Default,,0000,0000,0000,,!أحلّ قضايا تستعصي على البالغين حتى
Dialogue: 0,0:00:08.36,0:00:11.24,Default,,0000,0000,0000,,!نعتذر على التأخير! حلقة اليوم هي حلقة خاصة بساعة كاملة
Dialogue: 0,0:00:11.24,0:00:12.95,Default,,0000,0000,0000,,قضية جرائم قتل تسلسلية في جزيرة جنوبية
Dialogue: 0,0:00:12.95,0:00:15.00,Default,,0000,0000,0000,,!وحقيقة سوناتا البيانو الحزينة
Dialogue: 0,0:01:27.28,0:01:33.32,Title,,0000,0000,0000,,{\fad(300,0)}جرائم قتل سوناتا بيانو ضوء القمر
Dialogue: 0,0:01:28.40,0:01:31.30,Default,,0000,0000,0000,,جرائم قتل سوناتا بيانو ضوء القمر
Dialogue: 0,0:01:41.92,0:01:45.99,Default,,0000,0000,0000,,يا إلهي، لمَ على المتحري الشهير موري كوغورو\N الذهاب لجزيرة كتلك
Dialogue: 0,0:01:45.99,0:01:51.41,Default,,0000,0000,0000,,بينما يمكنه قضاء وقته في حفلة مشاهدة أزهار؟
Dialogue: 0,0:01:51.90,0:01:55.30,Default,,0000,0000,0000,,كلّه بسبب الرسالة التي وصلتني قبل أسبوع
Dialogue: 0,0:01:55.58,0:01:57.11,Default,,0000,0000,0000,,،في ليلة البدر التالي
Dialogue: 0,0:01:57.11,0:02:00.07,Default,,0000,0000,0000,,ستبدأ الظلال بالاختفاء مُجدداً من جزيرة تسوكيكاغي
Dialogue: 0,0:02:00.07,0:02:02.38,Default,,0000,0000,0000,,تحرَّ. أسو كيجي
Dialogue: 0,0:02:04.53,0:02:06.40,Default,,0000,0000,0000,,أجل، وكالة موري للتحري
Dialogue: 0,0:02:06.40,0:02:08.86,Default,,0000,0000,0000,,تبقى يومان حتّى البدر التالي
Dialogue: 0,0:02:08.86,0:02:11.76,Default,,0000,0000,0000,,حوّلتُ نصف مليون لحسابك البنكي
Dialogue: 0,0:02:12.11,0:02:13.11,Default,,0000,0000,0000,,عليك أن تأتي
Dialogue: 0,0:02:13.11,0:02:15.99,Default,,0000,0000,0000,,!لـ-لحظة! من أنت؟
Dialogue: 0,0:02:15.99,0:02:19.80,Default,,0000,0000,0000,,أسو كيجي من جزيرة تسوكيكاغي
Dialogue: 0,0:02:20.07,0:02:22.81,Default,,0000,0000,0000,,!أنت! انتظر! أتسمعني؟ مرحباً؟
Dialogue: 0,0:02:22.89,0:02:26.06,Default,,0000,0000,0000,,يا إلهي، لم يهتم لقبولي طلبه من عدمه حتى
Dialogue: 0,0:02:26.47,0:02:27.72,Default,,0000,0000,0000,,أين المشكلة؟
Dialogue: 0,0:02:27.72,0:02:30.51,Default,,0000,0000,0000,,يمكننا الاسترخاء في جزيرة صغيرة قرب إيزو
Dialogue: 0,0:02:30.51,0:02:32.27,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:02:32.80,0:02:36.18,Title,,0000,0050,15,,{\fad(200,0)}جزيرة تسوكيكاغي
Dialogue: 0,0:02:36.68,0:02:39.11,Default,,0000,0000,0000,,...أسو كيجي
Dialogue: 0,0:02:39.47,0:02:42.10,Default,,0000,0000,0000,,لا أرى شخصاً بهذا الاسم هنا
Dialogue: 0,0:02:42.10,0:02:44.68,Default,,0000,0000,0000,,هلّا بحثت جيّداً؟
Dialogue: 0,0:02:44.68,0:02:46.87,Default,,0000,0000,0000,,فقد استلمتُ رسالةً منه
Dialogue: 0,0:02:47.30,0:02:50.30,Default,,0000,0000,0000,,لكنه ليس في لائحة السكان
Dialogue: 0,0:02:50.30,0:02:53.47,Default,,0000,0000,0000,,وأنا انتقلتُ لهذه الجزيرة مؤخراً، فلا أعرف الكثير
Dialogue: 0,0:02:53.47,0:02:54.85,Default,,0000,0000,0000,,أهناك خطبٌ ما؟
Dialogue: 0,0:02:54.85,0:03:00.22,Default,,0000,0000,0000,,رئيس، يبدو أنّ ساكناً هنا عيّن خدمة هؤلاء الأشخاص
Dialogue: 0,0:03:00.55,0:03:01.35,Default,,0000,0000,0000,,عيّن خدمتهم؟
Dialogue: 0,0:03:01.35,0:03:04.72,Default,,0000,0000,0000,,أجل، اسمه أسو كيجي
Dialogue: 0,0:03:04.72,0:03:08.72,Default,,0000,0000,0000,,!ماذا؟ أقلت أسو كيجي؟
Dialogue: 0,0:03:13.89,0:03:20.40,Default,,0000,0000,0000,,!ذلك مُحال! فهو ميت منذ أكثر من 10 سنوات
Dialogue: 0,0:03:26.30,0:03:31.55,Default,,0000,0000,0000,,كان عازف بيانو مشهور وُلد وترعرع في هذه الجزيرة
Dialogue: 0,0:03:32.55,0:03:34.71,Default,,0000,0000,0000,,وقعت الحادثة في ليلة بدر قبل 12 عاماً
Dialogue: 0,0:03:35.72,0:03:37.76,Default,,0000,0000,0000,,كانت أول مرة يعود لموطنه منذ وقت طويل
Dialogue: 0,0:03:37.76,0:03:41.11,Default,,0000,0000,0000,,فأقام حفلةً في مركز البلدة الاجتماعي
Dialogue: 0,0:03:41.55,0:03:45.34,Default,,0000,0000,0000,,لكن بعدها، أقفل على نفسه وعائلته في منزلهم فجأةً
Dialogue: 0,0:03:45.34,0:03:46.28,Default,,0000,0000,0000,,!وأحرق المكان
Dialogue: 0,0:03:47.76,0:03:51.10,Default,,0000,0000,0000,,قِيل أنّه قتل زوجته وابنته طعناً
Dialogue: 0,0:03:51.10,0:03:54.44,Default,,0000,0000,0000,,ثمّ واصل العزف بالبيانو وألسنة اللهب تحيطه
Dialogue: 0,0:03:54.97,0:03:57.61,Default,,0000,0000,0000,,كما لو كان هناك شيء يتلبسه
Dialogue: 0,0:03:58.22,0:04:02.04,Default,,0000,0000,0000,,"سوناتا البيانو لبيتهوفين... "ضوء القمر
Dialogue: 0,0:04:07.64,0:04:09.47,Default,,0000,0000,0000,,...رسالة من رجل ميت
Dialogue: 0,0:04:09.47,0:04:11.47,Default,,0000,0000,0000,,يا للمقلب الفظيع
Dialogue: 0,0:04:11.47,0:04:13.14,Default,,0000,0000,0000,,قد لا يكون كذلك
Dialogue: 0,0:04:13.14,0:04:18.22,Default,,0000,0000,0000,,فأجرك قد دُفع، كما أنّ الرسالة حملت\Nخاتم بريد هذه الجزيرة
Dialogue: 0,0:04:18.50,0:04:24.16,Default,,0000,0000,0000,,يريد أحد أهل الجزيرة منك التحري\Nفي أمر أسو كيجي حتماً
Dialogue: 0,0:04:24.60,0:04:25.57,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:04:25.79,0:04:29.91,Default,,0000,0000,0000,,كان العمدة هنا صديقاً مقرّباً منه
Dialogue: 0,0:04:29.91,0:04:32.00,Default,,0000,0000,0000,,فربما يمكنه إخبارنا بشيء إذا سألناه
Dialogue: 0,0:04:32.00,0:04:33.16,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:04:33.16,0:04:36.63,Default,,0000,0000,0000,,قالوا أنّ العمدة في المركز الاجتماعي، أليس كذلك؟
Dialogue: 0,0:04:37.04,0:04:40.54,Default,,0000,0000,0000,,اسمع يا كينتا-كن، احرص على أن تتدفأ عند النوم
Dialogue: 0,0:04:40.54,0:04:42.25,Default,,0000,0000,0000,,!أجل، فهمت! إلى اللقاء
Dialogue: 0,0:04:42.25,0:04:43.16,Default,,0000,0000,0000,,مع السلامة
Dialogue: 0,0:04:44.29,0:04:45.60,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:04:46.20,0:04:48.12,Default,,0000,0000,0000,,أين المركز الاجتماعي؟
Dialogue: 0,0:04:48.12,0:04:52.94,Default,,0000,0000,0000,,أجل، اسلكوا ذاك المنعطف ثمّ واصلوا المشي
Dialogue: 0,0:04:53.20,0:04:55.70,Default,,0000,0000,0000,,لحظة، هل أنتم الجماعة من طوكيو؟
Dialogue: 0,0:04:55.70,0:04:57.36,Default,,0000,0000,0000,,أجل، وصلنا من السفينة للتو
Dialogue: 0,0:04:58.66,0:05:01.00,Default,,0000,0000,0000,,!أنا من طوكيو أيضاً
Dialogue: 0,0:05:01.00,0:05:04.08,Default,,0000,0000,0000,,لكن هذه الجزيرة أروع بكثير، ألا تتفقون؟
Dialogue: 0,0:05:04.08,0:05:07.41,Default,,0000,0000,0000,,!الهواء منعش، وهي هادئة جداً
Dialogue: 0,0:05:07.41,0:05:11.50,Default,,0000,0000,0000,,!احموا تجارة الصيد للجزيرة! صوّتوا لشيميزو ماساتو
Dialogue: 0,0:05:11.91,0:05:13.41,Default,,0000,0000,0000,,ربما ليس كثيراً
Dialogue: 0,0:05:13.41,0:05:15.75,Default,,0000,0000,0000,,فانتخابات العمدة تقترب
Dialogue: 0,0:05:16.85,0:05:17.71,Default,,0000,0000,0000,,انتخابات العمدة؟
Dialogue: 0,0:05:17.71,0:05:21.79,Default,,0000,0000,0000,,المرشّحون هم شيميزو-سان الذي يمثل صيّادي السمك
Dialogue: 0,0:05:21.79,0:05:25.62,Default,,0000,0000,0000,,والعمدة الحالي الذي يعاني انخفاضاً\Nفي شعبيته مؤخراً، كوريوا-سان
Dialogue: 0,0:05:25.62,0:05:28.68,Default,,0000,0000,0000,,كما كاواشيما-سان، أكثر رجال الجزيرة ثراءً
Dialogue: 0,0:05:29.37,0:05:31.64,Default,,0000,0000,0000,,...أخبرني مرضاي أنّ كاواشيما-سان غالباً من
Dialogue: 0,0:05:31.88,0:05:36.19,Default,,0000,0000,0000,,لا بأس يا ممرضة، لسنا مهتمين بالانتخابات حقاً
Dialogue: 0,0:05:36.41,0:05:39.25,Default,,0000,0000,0000,,{\a6}أنا الطبيبة أساي نارومي
Dialogue: 0,0:05:36.41,0:05:40.90,CharCard,,0000,0000,0005,,{\fad(300,0)}(أساي نارومي    (26\Nطبيبة
Dialogue: 0,0:05:39.25,0:05:40.90,Default,,0000,0000,0000,,{\a6}!لديّ رخصة حقيقية
Dialogue: 0,0:05:41.12,0:05:43.58,Default,,0000,0000,0000,,كنتِ دكتورة إذاً
Dialogue: 0,0:05:43.68,0:05:45.85,Default,,0000,0000,0000,,إن كنتم متجهون للمركز الاجتماعي
Dialogue: 0,0:05:45.85,0:05:48.09,Default,,0000,0000,0000,,فيمكنكم لقاء أولئك الثلاثة هناك
Dialogue: 0,0:05:48.68,0:05:52.14,Default,,0000,0000,0000,,فستُعقد الليلة مناسبة ذكرى العام الثالث للعمدة السابق
Dialogue: 0,0:05:52.14,0:05:53.60,Default,,0000,0000,0000,,كامياما-سان
Dialogue: 0,0:05:53.60,0:05:54.99,Default,,0000,0000,0000,,العمدة السابق؟
Dialogue: 0,0:05:55.97,0:05:57.56,Default,,0000,0000,0000,,ذكرى العام الثالث؟
Dialogue: 0,0:05:57.56,0:05:59.47,Default,,0000,0000,0000,,!لا تدعوا العمدة يواصل اضطهاده
Dialogue: 0,0:06:00.14,0:06:03.00,Default,,0000,0000,0000,,!لا تدعوا العمدة يواصل اضطهاده
Dialogue: 0,0:06:03.05,0:06:04.70,Default,,0000,0000,0000,,يا إلهي
Dialogue: 0,0:06:05.34,0:06:09.39,CharCard,,0000,0000,0004,,{\fad(300,0)}(كوريوا تاتسوجي   (56\Nعمدة جزيرة تسوكيكاغي
Dialogue: 0,0:06:05.39,0:06:09.49,Default,,0000,0000,0000,,{\a6}كيف يجرؤون على فعل هذا في ليلة \N!ذكرى العمدة السابق؟ يا لوقاحتهم
Dialogue: 0,0:06:09.80,0:06:12.85,Default,,0000,0000,0000,,{\a6}إنّهم مزعجون حقاً
Dialogue: 0,0:06:09.95,0:06:13.60,CharCard,,0000,0000,0010,,{\fad(300,0)}(كوريوا ريكو   (27\Nابنة كوريوا الوحيدة
Dialogue: 0,0:06:12.85,0:06:16.90,Default,,0000,0000,0000,,{\a6}!هيراتا! ما الذي تفعله؟\N!أغلق أفواههم فوراً
Dialogue: 0,0:06:17.39,0:06:18.71,Default,,0000,0000,0000,,{\a6}!حاضر سيّدتي
Dialogue: 0,0:06:17.44,0:06:19.86,CharCard,,0000,0000,0010,,{\fad(300,0)}(هيراتا كازواكي   (31\Nسكرتير العمدة الشخصي
Dialogue: 0,0:06:20.18,0:06:23.14,On Top,,0000,0000,0000,,!لا تدعوا العمدة يواصل اضطهاده
Dialogue: 0,0:06:23.14,0:06:24.85,Default,,0000,0000,0000,,هل الأمور بخير؟
Dialogue: 0,0:06:24.85,0:06:25.84,Default,,0000,0000,0000,,ما قصدك يا شويتشي؟
Dialogue: 0,0:06:26.72,0:06:30.84,Default,,0000,0000,0000,,{\a6}يقولون أنّ الانتخابات المقبلة\Nلن تكون في صالح والدك
Dialogue: 0,0:06:26.90,0:06:30.84,CharCard,,0000,0000,0004,,{\fad(300,0)}(موراساوا شويتشي   (27\Nخاطب ريكو
Dialogue: 0,0:06:31.18,0:06:36.22,Default,,0000,0000,0000,,{\a6}فعلاً، يبدو أنّ المواطنين يميلون لي الأكثر بينكم{\a6}
Dialogue: 0,0:06:32.00,0:06:36.16,CharCard,,0000,0000,0005,,{\fad(300,0)}(كاواشيما هيديو   (56\Nأثرى رجال البلدة
Dialogue: 0,0:06:37.43,0:06:40.52,Default,,0000,0000,0000,,هذا لأنّك تعرف كيف تستعمل المال فقط
Dialogue: 0,0:06:40.60,0:06:42.64,Default,,0000,0000,0000,,ما تعلّمتُه منك بالطبع
Dialogue: 0,0:06:43.22,0:06:45.91,Default,,0000,0000,0000,,سيّدي العمدة، هناك من يريد رؤيتك
Dialogue: 0,0:06:46.18,0:06:47.85,Default,,0000,0000,0000,,من يكون في وقت كهذا؟
Dialogue: 0,0:06:47.85,0:06:50.68,Default,,0000,0000,0000,,...يقول أنّه مُتحرٍّ من طوكيو
Dialogue: 0,0:06:50.68,0:06:53.07,Default,,0000,0000,0000,,!ماذا؟ مُتحرٍّ؟
Dialogue: 0,0:06:54.89,0:06:58.35,Default,,0000,0000,0000,,يا إلهي، إلى متى سيجعلونني أنتظر؟
Dialogue: 0,0:06:58.35,0:07:00.00,Default,,0000,0000,0000,,ماذا؟ أين كونان-كن؟
Dialogue: 0,0:07:02.76,0:07:03.92,Default,,0000,0000,0000,,بيانو؟
Dialogue: 0,0:07:05.55,0:07:07.80,Default,,0000,0000,0000,,!كونان-كن! توقف
Dialogue: 0,0:07:07.80,0:07:11.05,Default,,0000,0000,0000,,!ماذا؟ يا للغرفة الكبيرة
Dialogue: 0,0:07:12.56,0:07:15.37,Default,,0000,0000,0000,,طرف الشاطئ على الجانب الخلفي \Nللمركز الاجتماعي إذاً
Dialogue: 0,0:07:16.22,0:07:18.68,Default,,0000,0000,0000,,هذا البيانو متسخ
Dialogue: 0,0:07:18.68,0:07:21.02,Default,,0000,0000,0000,,...بمقدورهم تنظيفه بين الحين والآخر على الأقل
Dialogue: 0,0:07:22.22,0:07:24.23,Default,,0000,0000,0000,,!كلا! لا تلمسيه
Dialogue: 0,0:07:24.72,0:07:31.32,Default,,0000,0000,0000,,!إنّه البيانو الملعون الذي عزف أسو-سان عليه يوم موته
Dialogue: 0,0:07:31.68,0:07:34.48,Default,,0000,0000,0000,,...ملعون؟ لا تبالغ
Dialogue: 0,0:07:34.80,0:07:36.80,Default,,0000,0000,0000,,لم يكن أسو-سان الوحيد
Dialogue: 0,0:07:36.80,0:07:39.21,Default,,0000,0000,0000,,!حلّ الأمر نفسه بالعمدة السابق
Dialogue: 0,0:07:39.76,0:07:41.14,Default,,0000,0000,0000,,،تقصد كامياما إيسامو-سان
Dialogue: 0,0:07:41.14,0:07:43.62,Default,,0000,0000,0000,,الذي يعقدون تذكاراً له اليوم؟
Dialogue: 0,0:07:43.97,0:07:47.64,Default,,0000,0000,0000,,أجل، حدث الأمر قبل عامين
Dialogue: 0,0:07:49.30,0:07:51.64,Default,,0000,0000,0000,,كانت ليلة بدر
Dialogue: 0,0:07:51.64,0:07:56.05,Default,,0000,0000,0000,,كنتُ أمرّ بالمركز الاجتماعي الذي يفترض\Nأنّ لا أحد به
Dialogue: 0,0:07:56.05,0:07:58.71,Default,,0000,0000,0000,,حين سمعت صوت عزف بيانو من الداخل
Dialogue: 0,0:07:59.55,0:08:03.80,Default,,0000,0000,0000,,عندما سألتُ إن كان هناك أحد، توقف العزف
Dialogue: 0,0:08:05.35,0:08:08.50,Default,,0000,0000,0000,,!وفي الداخل، وجدت كامياما-ساما
Dialogue: 0,0:08:08.97,0:08:10.97,Default,,0000,0000,0000,,مات من نوبة قلبية
Dialogue: 0,0:08:10.97,0:08:13.89,Default,,0000,0000,0000,,والمقطوعة التي كان يعزفها قبيل موته
Dialogue: 0,0:08:13.89,0:08:19.18,Default,,0000,0000,0000,,"كانت نفس التي عزفها أسو-سان داخل النار، "ضوء القمر
Dialogue: 0,0:08:20.89,0:08:25.82,Default,,0000,0000,0000,,بعدها أصبح هذا البيانو معروفاً بالبيانو الملعون
Dialogue: 0,0:08:28.72,0:08:29.64,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:08:29.64,0:08:32.59,Default,,0000,0000,0000,,لا أرى خطباً غريباً بهذا البيانو
Dialogue: 0,0:08:34.01,0:08:37.42,Default,,0000,0000,0000,,بأيّ حال، انتظروا عند الباب الأمامي لحين\N!انتهاء المناسبة التذكارية رجاءً
Dialogue: 0,0:08:38.64,0:08:41.01,Default,,0000,0000,0000,,لا تزالون هنا؟
Dialogue: 0,0:08:41.68,0:08:43.55,Default,,0000,0000,0000,,نارومي-سان، أستحضرين المناسبة؟
Dialogue: 0,0:08:43.55,0:08:49.30,Default,,0000,0000,0000,,أجل، كان كامياما-سان أوّل من\Nشرّحته عندما أتيت هنا
Dialogue: 0,0:08:49.30,0:08:51.02,Default,,0000,0000,0000,,لذا خطر لي أن أحرق بخوراً لتكريمه
Dialogue: 0,0:08:52.10,0:08:55.11,Default,,0000,0000,0000,,هذا شيميزو-سان، التقيته في طريقي
Dialogue: 0,0:08:55.39,0:08:58.95,On Top,,0000,0000,0000,,،مرحباً، اسمي شيميزو\Nيسرّني لقاؤكم
Dialogue: 0,0:08:55.55,0:08:59.60,CharCard,,0000,0000,0004,,{\fad(300,400)}(شيميزو ماساهيتو   (49\Nمرشح عمدة
Dialogue: 0,0:09:03.12,0:09:06.04,CharCard,,0000,0000,0004,,{\fad(300,0)}(نيشيموتو كين   (55\Nعاطل
Dialogue: 0,0:09:06.43,0:09:07.89,Default,,0000,0000,0000,,كاواشيما
Dialogue: 0,0:09:07.89,0:09:12.30,Default,,0000,0000,0000,,عيّنت مُتحرياً للتنقيب عن أسراري، صحيح؟
Dialogue: 0,0:09:12.30,0:09:12.96,Default,,0000,0000,0000,,سخافة
Dialogue: 0,0:09:14.55,0:09:15.59,Default,,0000,0000,0000,,!تهرب؟
Dialogue: 0,0:09:16.39,0:09:17.79,Default,,0000,0000,0000,,الحمام
Dialogue: 0,0:09:22.26,0:09:24.22,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:09:24.22,0:09:27.39,Default,,0000,0000,0000,,يُفترض أن ذاك البيانو غير مستعمل لأعوام
Dialogue: 0,0:09:27.39,0:09:29.26,Default,,0000,0000,0000,,لكنه أصدر صوتاً مثالياً
Dialogue: 0,0:09:29.60,0:09:32.43,Default,,0000,0000,0000,,كان أحدهم يضبطه سرّاً بالتأكيد
Dialogue: 0,0:09:32.43,0:09:34.01,Default,,0000,0000,0000,,...لغرض ما
Dialogue: 0,0:09:34.55,0:09:39.04,Default,,0000,0000,0000,,وما كان معنى تلك الرسالة بالتحديد؟
Dialogue: 0,0:09:47.43,0:09:49.17,Default,,0000,0000,0000,,!هـ-هذه المعزوفة
Dialogue: 0,0:09:50.85,0:09:53.10,Default,,0000,0000,0000,,!ضوء القمر! كلا
Dialogue: 0,0:09:53.10,0:09:53.68,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:09:56.59,0:09:58.12,Default,,0000,0000,0000,,!أنت! أيها الصبي
Dialogue: 0,0:10:02.93,0:10:03.94,Default,,0000,0000,0000,,!كاواشيما-سان
Dialogue: 0,0:10:04.30,0:10:05.68,Default,,0000,0000,0000,,!تأخرت
Dialogue: 0,0:10:10.18,0:10:10.94,Default,,0000,0000,0000,,إنّه ميت
Dialogue: 0,0:10:11.35,0:10:12.65,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:10:13.01,0:10:15.89,Default,,0000,0000,0000,,ران، استدعي رجال مركز الشرطة المحلي فوراً
Dialogue: 0,0:10:15.89,0:10:16.69,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:10:16.89,0:10:20.14,Default,,0000,0000,0000,,طبيبة نارومي، افحصي الجثة رجاءً
Dialogue: 0,0:10:20.14,0:10:20.73,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:10:21.80,0:10:23.22,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:10:23.22,0:10:26.51,Default,,0000,0000,0000,,حذّرتنا تلك الرسالة من موت شخص\Nمرّة أخرى في جزيرة تسوكيكاغي
Dialogue: 0,0:10:26.51,0:10:29.49,Default,,0000,0000,0000,,!في ليلة البدر
Dialogue: 0,0:10:30.01,0:10:34.73,Default,,0000,0000,0000,,!إ-إنها اللعنة! إنها لعنة البيانو
Dialogue: 0,0:10:35.97,0:10:41.06,Default,,0000,0000,0000,,لا لعنة هناك، هذا المسجّل هو ما يشغل الموسيقى
Dialogue: 0,0:10:42.55,0:10:48.00,Default,,0000,0000,0000,,!هذه جريمة قتل أُعدّت لتشبه الحادثتين السابقتين
Dialogue: 0,0:10:48.47,0:10:50.06,Default,,0000,0000,0000,,!جريمة قتل؟
Dialogue: 0,0:10:50.06,0:10:52.60,Default,,0000,0000,0000,,مهلك، لا تتفوه بالهراء
Dialogue: 0,0:10:52.60,0:10:54.77,Default,,0000,0000,0000,,!من تكون بالأصل؟
Dialogue: 0,0:10:55.64,0:10:59.97,Default,,0000,0000,0000,,!أنا المتحرّي الشهير من طوكيو، موري كوغورو
Dialogue: 0,0:10:59.97,0:11:02.16,Default,,0000,0000,0000,,رائد الفضاء ذاك؟
Dialogue: 0,0:11:02.76,0:11:05.68,Default,,0000,0000,0000,,كلا، إنّه من يظهر في روايات التحرّي
Dialogue: 0,0:11:05.68,0:11:07.35,Default,,0000,0000,0000,,ذاك أكيتشي
Dialogue: 0,0:11:07.35,0:11:09.03,Default,,0000,0000,0000,,من يكون هذا الشخص إذاً؟
Dialogue: 0,0:11:12.97,0:11:14.75,Default,,0000,0000,0000,,ماء بحر
Dialogue: 0,0:11:15.97,0:11:19.26,Default,,0000,0000,0000,,وقت الموت المقدر هو قبل نصف ساعة لساعة
Dialogue: 0,0:11:19.26,0:11:21.17,Default,,0000,0000,0000,,مات اختناقاً غالباً
Dialogue: 0,0:11:21.64,0:11:25.10,Default,,0000,0000,0000,,أعتقد أنّ كاواشيما-سان قد أُغرق
Dialogue: 0,0:11:25.10,0:11:26.64,Default,,0000,0000,0000,,أغرقه أحدهم؟
Dialogue: 0,0:11:27.10,0:11:30.18,Default,,0000,0000,0000,,لا يمكنني الجزم دون إجراء تشريح
Dialogue: 0,0:11:30.18,0:11:32.48,Default,,0000,0000,0000,,أظنّ الطبيبة نارومي محقّة
Dialogue: 0,0:11:32.93,0:11:35.18,Default,,0000,0000,0000,,انظروا، يوجد معطف بدلة على الشاطئ خارجاً
Dialogue: 0,0:11:35.18,0:11:37.41,Default,,0000,0000,0000,,لا بد أنّه لكاواشيما-سان
Dialogue: 0,0:11:38.18,0:11:42.39,Default,,0000,0000,0000,,يوجد أثر ماء بحر يمتد من الباب للبيانو
Dialogue: 0,0:11:42.39,0:11:45.22,Default,,0000,0000,0000,,وهناك وحل ورمل على ظهر كاواشيما-سان
Dialogue: 0,0:11:45.64,0:11:49.72,Default,,0000,0000,0000,,،كما من كون باب ونوافذ هذه الغرفة مغلقة
Dialogue: 0,0:11:49.72,0:11:53.81,Default,,0000,0000,0000,,...وفراغ الدقائق الأولى من شريط المسجّل
Dialogue: 0,0:11:54.00,0:11:56.77,Default,,0000,0000,0000,,...مـ-منذ متى بدأ
Dialogue: 0,0:11:57.05,0:12:01.10,Default,,0000,0000,0000,,أخذ المجرم كاواشيما-سان للمحيط\Nأثناء المناسبة التذكارية غالباً
Dialogue: 0,0:12:01.10,0:12:02.51,Default,,0000,0000,0000,,وأغرقه
Dialogue: 0,0:12:02.51,0:12:04.39,Default,,0000,0000,0000,,ثمّ سحب الجثّة لهذه الغرفة
Dialogue: 0,0:12:04.39,0:12:05.51,Default,,0000,0000,0000,,أقفل الباب
Dialogue: 0,0:12:05.51,0:12:08.33,Default,,0000,0000,0000,,شغّل مسجّل الأشرطة ثم خرج للرواق
Dialogue: 0,0:12:08.60,0:12:09.93,Default,,0000,0000,0000,,صحيح يا عمّ؟
Dialogue: 0,0:12:09.93,0:12:12.75,Default,,0000,0000,0000,,أ-أجل، معك حق
Dialogue: 0,0:12:15.26,0:12:18.01,Default,,0000,0000,0000,,بافتراض أنّ باب هذه الغرفة كان مقفلاً
Dialogue: 0,0:12:18.89,0:12:21.55,Default,,0000,0000,0000,,،هناك احتمال كبير أن القاتل رجع لقاعة المناسبة
Dialogue: 0,0:12:21.55,0:12:24.72,Default,,0000,0000,0000,,بما أنّنا كنا عند الباب الأمامي طوال الوقت
Dialogue: 0,0:12:25.05,0:12:26.80,Default,,0000,0000,0000,,!ا-انتظر
Dialogue: 0,0:12:26.80,0:12:29.31,Default,,0000,0000,0000,,!أتقصد أن القاتل لا يزال بيننا؟
Dialogue: 0,0:12:37.39,0:12:40.24,Default,,0000,0000,0000,,صحيح، المجرم هنا
Dialogue: 0,0:12:40.80,0:12:44.59,Default,,0000,0000,0000,,هل رأى أحدكم كاواشيما-سان يترك مقعده؟
Dialogue: 0,0:12:44.72,0:12:49.12,Default,,0000,0000,0000,,أنا رأيته، قال أنه سيذهب للحمّام
Dialogue: 0,0:12:49.51,0:12:53.01,Default,,0000,0000,0000,,هل رأى أحدكم شخصاً آخر غادر مقعده؟
Dialogue: 0,0:12:53.01,0:12:56.14,Default,,0000,0000,0000,,كأن بإمكاننا تذكر كلّ تفصيل حدث
Dialogue: 0,0:12:56.14,0:13:00.77,Default,,0000,0000,0000,,في هذه الحالة، أكان أحدٌ يكنّ ضغينة لكاواشيما-سان؟
Dialogue: 0,0:13:01.10,0:13:02.47,Default,,0000,0000,0000,,ليست ضغينة تماماً
Dialogue: 0,0:13:02.47,0:13:06.89,Default,,0000,0000,0000,,،لكن أكثر شخص سيسرّ بموته هو شيميزو-سان
Dialogue: 0,0:13:06.89,0:13:09.51,Default,,0000,0000,0000,,خصمه في انتخابات العمدة
Dialogue: 0,0:13:09.51,0:13:13.47,Default,,0000,0000,0000,,!مـ-ماذا؟! ينطبق الأمر عليك يا عمدة كوريوا
Dialogue: 0,0:13:13.80,0:13:15.51,Default,,0000,0000,0000,,أجل، دون كاواشيما-سان
Dialogue: 0,0:13:15.51,0:13:18.10,Default,,0000,0000,0000,,كان نصر أبي ليكون مضموناً
Dialogue: 0,0:13:18.10,0:13:19.76,Default,,0000,0000,0000,,طالما لم يكن أحدهم يخطط
Dialogue: 0,0:13:19.76,0:13:23.30,Default,,0000,0000,0000,,لسرقة أصوات كاواشيما-سان بالطبع
Dialogue: 0,0:13:23.30,0:13:24.14,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:13:24.14,0:13:25.03,Default,,0000,0000,0000,,!سيّدتي
Dialogue: 0,0:13:25.39,0:13:27.30,Default,,0000,0000,0000,,...اهدؤوا
Dialogue: 0,0:13:27.30,0:13:31.64,Default,,0000,0000,0000,,لكن لمَ وضع القاتلُ الجثّةَ في هذه الغرفة؟
Dialogue: 0,0:13:31.64,0:13:36.47,Default,,0000,0000,0000,,ذلك لأنّ القاتل أراد توجيه اللوم للبيانو الملعون
Dialogue: 0,0:13:36.47,0:13:38.91,Default,,0000,0000,0000,,بالمناسبة، منذ متى والبيانو هنا؟
Dialogue: 0,0:13:38.98,0:13:44.36,Default,,0000,0000,0000,,كان هنا لخمسة عشر عاماً مذ تبرع به أسو-سان
Dialogue: 0,0:13:44.64,0:13:47.47,Default,,0000,0000,0000,,أسو-سان ذاك إذاً؟
Dialogue: 0,0:13:47.47,0:13:51.03,Default,,0000,0000,0000,,أجل، اسمه على غطاء لوحة المفاتيح
Dialogue: 0,0:13:52.51,0:13:54.03,Default,,0000,0000,0000,,ما-ما هذا؟
Dialogue: 0,0:13:56.89,0:13:58.47,Default,,0000,0000,0000,,قطعة موسيقية
Dialogue: 0,0:13:58.47,0:14:02.23,Default,,0000,0000,0000,,غريب، لم تكن موجودةً عندما تفقدناه في الظهيرة
Dialogue: 0,0:14:08.85,0:14:10.51,Default,,0000,0000,0000,,من كان ذاك؟
Dialogue: 0,0:14:10.51,0:14:11.93,Default,,0000,0000,0000,,نيشيموتو-سان
Dialogue: 0,0:14:12.35,0:14:14.43,Default,,0000,0000,0000,,كان بحالٍ ممتازة في السابق
Dialogue: 0,0:14:14.43,0:14:18.35,Default,,0000,0000,0000,,وأنفق الكثير من المال على الشراب والنساء والقمار كما سمعت
Dialogue: 0,0:14:18.35,0:14:21.47,Default,,0000,0000,0000,,،لكن بعد موت العمدة السابق قبل عامين
Dialogue: 0,0:14:21.47,0:14:25.26,Default,,0000,0000,0000,,توقف عن الخروج كما لو كان يخشى شيئاً
Dialogue: 0,0:14:25.36,0:14:26.30,Default,,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:14:26.30,0:14:29.51,Default,,0000,0000,0000,,كان صديق طفولة لك أيها العمدة، صحيح؟
Dialogue: 0,0:14:30.47,0:14:33.20,Default,,0000,0000,0000,,أ-أجل، معك حق
Dialogue: 0,0:14:34.93,0:14:36.01,Default,,0000,0000,0000,,!إنّه شرطي
Dialogue: 0,0:14:36.01,0:14:37.22,Default,,0000,0000,0000,,تأخّرتِ يا ران
Dialogue: 0,0:14:37.22,0:14:41.18,Default,,0000,0000,0000,,لكن كان عليّ البحث عنه، لم يكن في مركز الشرطة
Dialogue: 0,0:14:41.68,0:14:43.97,Default,,0000,0000,0000,,حسناً، من طلبني؟
Dialogue: 0,0:14:43.97,0:14:46.88,Default,,0000,0000,0000,,هذا الشخص، اسمه موري كوغورو
Dialogue: 0,0:14:47.89,0:14:48.85,Default,,0000,0000,0000,,...ذاك المشهور
Dialogue: 0,0:14:48.85,0:14:49.51,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:14:49.51,0:14:50.80,Default,,0000,0000,0000,,!رائد الفضاء
Dialogue: 0,0:14:50.80,0:14:52.74,Default,,0000,0000,0000,,...كلا
Dialogue: 0,0:14:53.22,0:14:55.72,Default,,0000,0000,0000,,بأيّ حال، تأخر الوقت
Dialogue: 0,0:14:55.72,0:14:58.57,Default,,0000,0000,0000,,يمكننا تأجيل جمع المعلومات لصباح الغد
Dialogue: 0,0:14:59.10,0:15:03.14,Default,,0000,0000,0000,,لم تكن جريمة قتل، بل لعنة أسو-سان
Dialogue: 0,0:15:03.14,0:15:04.52,Default,,0000,0000,0000,,...يا للرعب
Dialogue: 0,0:15:05.47,0:15:09.37,Default,,0000,0000,0000,,كان عليهم حرق ذاك البيانو القديم المريب
Dialogue: 0,0:15:10.05,0:15:14.53,Default,,0000,0000,0000,,أجل، قد نكون أفضل حالاً دون ذاك الشيء
Dialogue: 0,0:15:15.76,0:15:16.95,Default,,0000,0000,0000,,شويتشي؟
Dialogue: 0,0:15:18.91,0:15:22.10,Default,,0000,0000,0000,,!أدهشتني استنتاجاتك يا كونان-كن
Dialogue: 0,0:15:22.10,0:15:24.60,Default,,0000,0000,0000,,يحب لعب لعبة المُتحري
Dialogue: 0,0:15:24.60,0:15:28.20,Default,,0000,0000,0000,,كان الجميع يتكلمون عن قوّة إقناعه
Dialogue: 0,0:15:28.55,0:15:30.68,Default,,0000,0000,0000,,!كنتُ أقلد عمّي فقط
Dialogue: 0,0:15:30.68,0:15:33.43,Default,,0000,0000,0000,,!فأنا أراه في عمله دوماً
Dialogue: 0,0:15:34.30,0:15:37.52,Default,,0000,0000,0000,,لكنّه مجرد فرخ مقارنةً بي
Dialogue: 0,0:15:38.47,0:15:41.02,Default,,0000,0000,0000,,حسنٌ، سنرجع للنُزل الآن
Dialogue: 0,0:15:41.47,0:15:45.39,Default,,0000,0000,0000,,أراكم لاحقاً إذاً، آمل أن تحلّ القضية بأسرع ما يمكن
Dialogue: 0,0:15:45.39,0:15:48.35,Default,,0000,0000,0000,,أفضّل ألا أفحص جثثاً أكثر
Dialogue: 0,0:15:48.44,0:15:52.40,Default,,0000,0000,0000,,!لا تقلقي! سيكون هذا لقمةً سائغة بين يديّ
Dialogue: 0,0:15:54.05,0:15:57.81,Default,,0000,0000,0000,,يا للادّعاء، حتّى أنا لا أعرف ما يجري
Dialogue: 0,0:15:56.19,0:16:00.05,Default,,0000,0000,0000,,لحظة
Dialogue: 0,0:16:01.30,0:16:04.31,Default,,0000,0000,0000,,..."قالت الرسالة "ستبدأ بالاختفاء
Dialogue: 0,0:16:04.64,0:16:08.50,Default,,0000,0000,0000,,!أي أنّ هذه ليست النهاية
Dialogue: 0,0:16:08.50,0:16:12.15,Default,,0000,0000,0000,,!ماذا؟ لن تتوقف جرائم القتل؟
Dialogue: 0,0:16:12.22,0:16:15.06,Default,,0000,0000,0000,,هذه الرسالة تحذرنا من ذلك؟
Dialogue: 0,0:16:15.22,0:16:18.85,Default,,0000,0000,0000,,اختفاء الظلال يعني تطويق الضوء لها
Dialogue: 0,0:16:18.85,0:16:23.07,Default,,0000,0000,0000,,يرمز الضوء للمقطوعة في مسارح الجرائم، ضوء القمر
Dialogue: 0,0:16:23.14,0:16:24.68,Default,,0000,0000,0000,,!فهمت
Dialogue: 0,0:16:24.68,0:16:28.00,Default,,0000,0000,0000,,المقطوعة التي عزفها السيّد أسو بين \N،ألسنة النار قبل 12 عاماً
Dialogue: 0,0:16:28.68,0:16:32.08,Default,,0000,0000,0000,,والتي عزفها العمدة قبل وفاته منذ عامين
Dialogue: 0,0:16:32.68,0:16:35.35,Default,,0000,0000,0000,,كانت سوناتا بيانو بيتهوفين، ضوء القمر
Dialogue: 0,0:16:35.35,0:16:39.53,Default,,0000,0000,0000,,وكلّ الحوادث الثلاث وقعت بجوار البيانو
Dialogue: 0,0:16:39.85,0:16:41.55,Default,,0000,0000,0000,,!ارجعا للنُزل
Dialogue: 0,0:16:41.55,0:16:42.33,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:16:44.43,0:16:47.46,Default,,0000,0000,0000,,!لنذهب يا ران-نيتشان للمركز الاجتماعي أيضاً
Dialogue: 0,0:16:50.89,0:16:53.47,Default,,0000,0000,0000,,أنتَ لست بعقلك حقاً
Dialogue: 0,0:16:53.47,0:16:55.68,Default,,0000,0000,0000,,تقضي الليلة مع جثّة هكذا
Dialogue: 0,0:16:55.68,0:16:57.79,Default,,0000,0000,0000,,!كما مع طفل
Dialogue: 0,0:16:58.18,0:17:00.89,Default,,0000,0000,0000,,!أخبرتكما أن ترجعا
Dialogue: 0,0:17:00.89,0:17:02.80,Default,,0000,0000,0000,,...لكن كونان-كن
Dialogue: 0,0:17:02.80,0:17:06.15,Default,,0000,0000,0000,,أخبرني، من حرّك الجثة دون إذني؟
Dialogue: 0,0:17:06.68,0:17:07.89,Default,,0000,0000,0000,,أنا
Dialogue: 0,0:17:07.89,0:17:12.19,Default,,0000,0000,0000,,شعرت بالأسف للمسكين في وضعيته
Dialogue: 0,0:17:12.55,0:17:14.22,Default,,0000,0000,0000,,هذه مشكلة
Dialogue: 0,0:17:14.22,0:17:16.01,Default,,0000,0000,0000,,لم ننته من التحقيق في مسرح الجريمة بعد
Dialogue: 0,0:17:16.01,0:17:18.03,Default,,0000,0000,0000,,ماذا؟ اختفت القطعة الموسيقية
Dialogue: 0,0:17:18.03,0:17:19.28,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:19.68,0:17:23.33,Default,,0000,0000,0000,,أخذتها معي كيلا تضيع، انظر
Dialogue: 0,0:17:23.68,0:17:24.80,Default,,0000,0000,0000,,...هذا العجوز
Dialogue: 0,0:17:24.80,0:17:26.10,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:17:26.10,0:17:28.05,Default,,0000,0000,0000,,!هذه مقطوعة ضوء القمر
Dialogue: 0,0:17:28.05,0:17:28.42,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:17:28.42,0:17:29.80,Default,,0000,0000,0000,,ضوء القمر؟
Dialogue: 0,0:17:37.89,0:17:39.64,Default,,0000,0000,0000,,!ما الذي تفعلينه؟! فاشلة العزف
Dialogue: 0,0:17:39.64,0:17:43.35,Default,,0000,0000,0000,,كلا، هذه الفاصلة الرابعة غريبة
Dialogue: 0,0:17:43.68,0:17:45.14,Default,,0000,0000,0000,,الفاصلة الرابعة؟
Dialogue: 0,0:17:45.14,0:17:46.69,Default,,0000,0000,0000,,...أيمكن أنّ هذه القطعة الموسيقية
Dialogue: 0,0:17:47.64,0:17:49.54,Default,,0000,0000,0000,,رسالة احتضار كاواشيما-سان؟
Dialogue: 0,0:17:50.01,0:17:53.05,Default,,0000,0000,0000,,!في تلك الحالة، قد يرجع القاتل لها
Dialogue: 0,0:17:53.05,0:17:54.64,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:17:55.05,0:17:58.47,Default,,0000,0000,0000,,عندما سألت عنكم في النُزل قالوا أنّكم هنا
Dialogue: 0,0:17:58.47,0:18:00.05,Default,,0000,0000,0000,,طبيبة نارومي
Dialogue: 0,0:18:00.05,0:18:01.85,Default,,0000,0000,0000,,أحضرتُ عشاءً
Dialogue: 0,0:18:02.93,0:18:04.60,Default,,0000,0000,0000,,...صحيح
Dialogue: 0,0:18:04.60,0:18:06.37,Default,,0000,0000,0000,,نتضور جوعاً
Dialogue: 0,0:18:09.60,0:18:13.10,Default,,0000,0000,0000,,لستِ من أهل الجزيرة إذاً؟
Dialogue: 0,0:18:13.10,0:18:16.43,Default,,0000,0000,0000,,كلا، أعود لطوكيو نهاية كلّ أسبوع
Dialogue: 0,0:18:16.43,0:18:18.42,Default,,0000,0000,0000,,كأنّي أعمل طبيبة بدوام جزئي هنا
Dialogue: 0,0:18:18.51,0:18:21.43,Default,,0000,0000,0000,,،لطالما أردت أن أعمل في جزيرة صغيرة كهذه
Dialogue: 0,0:18:21.43,0:18:25.55,Default,,0000,0000,0000,,...محاطةً بالطبيعة
Dialogue: 0,0:18:25.55,0:18:27.56,Default,,0000,0000,0000,,أكملت عامين هذه السنة
Dialogue: 0,0:18:28.14,0:18:29.47,Default,,0000,0000,0000,,طبيبة نارومي
Dialogue: 0,0:18:29.47,0:18:35.53,Default,,0000,0000,0000,,هل مات العمدة السابق كامياما \Nمن نوبة قلبية قبل عامين حقاً؟
Dialogue: 0,0:18:35.80,0:18:39.26,Default,,0000,0000,0000,,أجل، كان يعاني مشاكل قلبية باستمرار
Dialogue: 0,0:18:39.36,0:18:42.39,Default,,0000,0000,0000,,لكن كان وجهه متشنّجاً
Dialogue: 0,0:18:42.39,0:18:45.27,Default,,0000,0000,0000,,كما لو رأى شيئاً مرعباً
Dialogue: 0,0:18:45.68,0:18:48.80,Default,,0000,0000,0000,,هل لاحظتِ أمراً غريباً آنذاك؟
Dialogue: 0,0:18:48.80,0:18:50.32,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:18:50.85,0:18:51.80,Default,,0000,0000,0000,,تذكرت
Dialogue: 0,0:18:51.80,0:18:52.54,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:18:52.97,0:18:54.97,Default,,0000,0000,0000,,أظن أن إحدى النوافذ كانت مفتوحة
Dialogue: 0,0:18:54.97,0:18:56.09,Default,,0000,0000,0000,,نافذة؟
Dialogue: 0,0:18:57.14,0:19:02.34,Default,,0000,0000,0000,,...اعتقدنا أن أحداً نسي إغلاقها فقط آنذاك، لكن
Dialogue: 0,0:19:02.34,0:19:04.01,Default,,0000,0000,0000,,أيّ نافذة كانت؟
Dialogue: 0,0:19:04.01,0:19:05.17,Default,,0000,0000,0000,,...وفقما أتذكر
Dialogue: 0,0:19:09.01,0:19:10.23,Default,,0000,0000,0000,,كانت هذه النافذة
Dialogue: 0,0:19:10.23,0:19:10.94,Default,,0000,0000,0000,,!من هناك؟
Dialogue: 0,0:19:12.80,0:19:13.85,Default,,0000,0000,0000,,!توقف
Dialogue: 0,0:19:13.85,0:19:15.22,Default,,0000,0000,0000,,!لن تهرب
Dialogue: 0,0:19:19.97,0:19:22.21,Default,,0000,0000,0000,,!تبّاً! فقدناه
Dialogue: 0,0:19:22.68,0:19:27.20,Default,,0000,0000,0000,,كنتُ محقاً! رجع لأخذ هذه القطعة الموسيقية
Dialogue: 0,0:19:28.01,0:19:30.55,Default,,0000,0000,0000,,!حسنٌ! سنسهر طوال الليلة ونحرس المكان
Dialogue: 0,0:19:30.55,0:19:31.35,Default,,0000,0000,0000,,!واضح؟
Dialogue: 0,0:19:31.35,0:19:32.46,Default,,0000,0000,0000,,!أجل
Dialogue: 0,0:19:33.97,0:19:35.31,Default,,0000,0000,0000,,أنت، موري-كن
Dialogue: 0,0:19:36.47,0:19:37.71,Default,,0000,0000,0000,,!موري-كن
Dialogue: 0,0:19:38.85,0:19:40.18,Default,,0000,0000,0000,,إنّها الظهيرة
Dialogue: 0,0:19:40.18,0:19:42.68,Default,,0000,0000,0000,,حضرة المفتش ميغوري، ماذا تفعل هنا؟
Dialogue: 0,0:19:43.14,0:19:45.60,Default,,0000,0000,0000,,هذه الجزيرة تعتبر جزءاً من طوكيو
Dialogue: 0,0:19:46.01,0:19:47.76,Default,,0000,0000,0000,,صحيح، أين وضعت تلك؟
Dialogue: 0,0:19:48.30,0:19:51.12,Default,,0000,0000,0000,,،إن كنت تقصد القطعة الموسيقية\Nفكونان-كن أعطاني إياها
Dialogue: 0,0:19:51.51,0:19:53.91,Default,,0000,0000,0000,,شرح لي تفاصيل القضيّة أيضاً
Dialogue: 0,0:19:54.02,0:19:57.55,Default,,0000,0000,0000,,كان ثلاثتهم مستيقظين عند وصولنا
Dialogue: 0,0:19:57.55,0:20:00.51,Default,,0000,0000,0000,,أنت وذاك العجوز كنتما وحدكما النائمين
Dialogue: 0,0:20:01.68,0:20:04.05,Default,,0000,0000,0000,,إنّهم يجرون استجوابات في دار البلدية
Dialogue: 0,0:20:04.05,0:20:05.89,Default,,0000,0000,0000,,اذهب وساعدهم
Dialogue: 0,0:20:05.89,0:20:06.75,Default,,0000,0000,0000,,حسناً
Dialogue: 0,0:20:16.97,0:20:20.80,Default,,0000,0000,0000,,كان علينا ألّا ننام هناك
Dialogue: 0,0:20:20.80,0:20:23.80,Default,,0000,0000,0000,,أبي، كيف جرى الأمر؟ هل عرفت المجرم؟
Dialogue: 0,0:20:23.80,0:20:28.43,Default,,0000,0000,0000,,لا تكوني سخيفة، كان هناك 38 شخصاً\Nفي المناسبة التذكارية
Dialogue: 0,0:20:28.43,0:20:30.13,Default,,0000,0000,0000,,لن يكون الأمر بتلك السهولة
Dialogue: 0,0:20:30.68,0:20:34.10,Default,,0000,0000,0000,,آسفة، لكن متى سيحين دوري؟
Dialogue: 0,0:20:34.10,0:20:37.64,Default,,0000,0000,0000,,تبدين مرهقة، لذا ترتيبك الأخير
Dialogue: 0,0:20:37.64,0:20:40.37,Default,,0000,0000,0000,,سأذهب لغسل وجهي في دورة مياه\Nالسيدات قبل ذلك إذاً
Dialogue: 0,0:20:41.85,0:20:44.78,Default,,0000,0000,0000,,كم استجواباً بقي لديكم؟
Dialogue: 0,0:20:45.10,0:20:47.97,Default,,0000,0000,0000,,بإضافة الطبيبة نارومي يكونون ستّة
Dialogue: 0,0:20:47.97,0:20:52.18,Default,,0000,0000,0000,,إنّهم ابنة العمدة هناك، كوريوا ريكو
Dialogue: 0,0:20:52.18,0:20:54.80,Default,,0000,0000,0000,,وخطيبها موراساوا شويتشي
Dialogue: 0,0:20:54.80,0:20:56.64,Default,,0000,0000,0000,,المرشّح للعمدة شيميزو ماساتو
Dialogue: 0,0:20:56.64,0:20:58.33,Default,,0000,0000,0000,,وسكرتير العمدة هيراتا كازواكي
Dialogue: 0,0:20:58.93,0:21:02.43,Default,,0000,0000,0000,,ونيشيموتو كين الذي نستجوبه حالياً
Dialogue: 0,0:21:02.43,0:21:04.30,Default,,0000,0000,0000,,لكنه يهدر وقتنا حقاً
Dialogue: 0,0:21:04.89,0:21:07.10,Default,,0000,0000,0000,,لا ينبس ببنت شفة مهما سألناه
Dialogue: 0,0:21:07.10,0:21:09.50,Default,,0000,0000,0000,,تخبرني غريزتي أنّه كان الفاعل
Dialogue: 0,0:21:09.76,0:21:12.22,Default,,0000,0000,0000,,!أحمق! أي لعنة بيانو تتحدث عنها؟
Dialogue: 0,0:21:12.89,0:21:16.43,Default,,0000,0000,0000,,تحصل هذه القضايا باستمرار لوجود ذاك الشيء
Dialogue: 0,0:21:16.43,0:21:17.94,Default,,0000,0000,0000,,...لكن أيّها العمدة
Dialogue: 0,0:21:17.94,0:21:20.64,Default,,0000,0000,0000,,!تخلّص منه فوراً! واضح يا هيراتا؟
Dialogue: 0,0:21:20.64,0:21:21.65,Default,,0000,0000,0000,,!حـ-حاضر
Dialogue: 0,0:21:21.65,0:21:23.40,Default,,0000,0000,0000,,...تبّاً
Dialogue: 0,0:21:26.70,0:21:28.82,Default,,0000,0000,0000,,!يكفي هذا
Dialogue: 0,0:21:28.82,0:21:32.12,Default,,0000,0000,0000,,!لا دافع لديّ لقتل كاواشيما-سان
Dialogue: 0,0:21:32.51,0:21:33.55,Default,,0000,0000,0000,,!يا إلهي
Dialogue: 0,0:21:33.55,0:21:35.68,Default,,0000,0000,0000,,ريكو-سان مذهلة
Dialogue: 0,0:21:35.68,0:21:37.61,Default,,0000,0000,0000,,لم تتوقف عن الصراخ لعشر دقائق
Dialogue: 0,0:21:37.67,0:21:39.14,Default,,0000,0000,0000,,هذا غريب
Dialogue: 0,0:21:39.14,0:21:44.30,Default,,0000,0000,0000,,انتهوا من استجوابه، فلمَ لم\Nيغادر نيشيموتو-سان؟
Dialogue: 0,0:21:44.30,0:21:44.97,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:21:46.51,0:21:48.64,Default,,0000,0000,0000,,سـ-سأذهب لدورة المياه
Dialogue: 0,0:21:57.26,0:22:00.05,Default,,0000,0000,0000,,ماذا؟ ألم يدخل نيشيموتو-سان هنا للتو؟
Dialogue: 0,0:22:00.47,0:22:01.61,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:22:02.01,0:22:03.71,Default,,0000,0000,0000,,!تبّاً! صعد الأدراج
Dialogue: 0,0:22:08.80,0:22:09.95,Default,,0000,0000,0000,,...هذه المقطوعة
Dialogue: 0,0:22:11.80,0:22:13.92,Default,,0000,0000,0000,,...إنّها الحركة الثانية لضوء القمر
Dialogue: 0,0:22:14.68,0:22:17.28,Default,,0000,0000,0000,,!أين مصدر الصوت؟
Dialogue: 0,0:22:17.37,0:22:18.97,Default,,0000,0000,0000,,!غرفة البثّ
Dialogue: 0,0:22:20.51,0:22:21.77,Default,,0000,0000,0000,,!نيشيموتو-سان
Dialogue: 0,0:22:26.85,0:22:28.35,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:22:30.18,0:22:31.81,Default,,0000,0000,0000,,!كلا، لا تدخلي
Dialogue: 0,0:22:34.01,0:22:36.35,Default,,0000,0000,0000,,!استدعوا المحلّلين وفريق التشريح فوراً
Dialogue: 0,0:22:36.35,0:22:37.05,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:22:37.05,0:22:40.62,Default,,0000,0000,0000,,غادر فريق التشريح لطوكيو مساءً\Nلفحص جثّة كاواشيما-سان
Dialogue: 0,0:22:40.73,0:22:42.05,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:22:42.05,0:22:43.89,Default,,0000,0000,0000,,...تبّاً! في هذا الوقت
Dialogue: 0,0:22:43.89,0:22:44.83,Default,,0000,0000,0000,,المعذرة
Dialogue: 0,0:22:45.68,0:22:46.97,Default,,0000,0000,0000,,يمكنني فعلها
Dialogue: 0,0:22:46.97,0:22:48.40,Default,,0000,0000,0000,,...الطبيبة نارومي
Dialogue: 0,0:22:48.68,0:22:51.85,Default,,0000,0000,0000,,لكن هذا يقلّص عدد المشتبه بهم لفئة محدودة
Dialogue: 0,0:22:51.99,0:22:54.35,Default,,0000,0000,0000,,...لا يزال القاتل إذاً
Dialogue: 0,0:22:54.35,0:22:57.74,Default,,0000,0000,0000,,تحرس الشرطة كافة مخارج هذا المبنى
Dialogue: 0,0:22:57.83,0:22:59.30,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:22:59.30,0:23:02.96,Default,,0000,0000,0000,,!من هو؟! من القاتل؟
Dialogue: 0,0:23:07.39,0:23:11.63,Default,,0000,0000,0000,,يبدو أنّه مضت بضع دقائق فقط\Nعلى موت الضحية
Dialogue: 0,0:23:12.43,0:23:17.35,Default,,0000,0000,0000,,بالفعل، يبدو أنّ أول خمس دقائق ونصف\Nلهذا الشريط فارغة
Dialogue: 0,0:23:17.60,0:23:18.80,Default,,0000,0000,0000,,!مفتش ميغوري
Dialogue: 0,0:23:18.80,0:23:20.76,Default,,0000,0000,0000,,!كان هناك شيءٌ غريب أسفل الجثة
Dialogue: 0,0:23:20.76,0:23:21.56,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:23:24.43,0:23:25.46,Default,,0000,0000,0000,,قطعة موسيقية؟
Dialogue: 0,0:23:26.26,0:23:29.15,Default,,0000,0000,0000,,أهذه رسالة احتضار أخرى من الضحية؟
Dialogue: 0,0:23:29.43,0:23:30.86,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:23:31.18,0:23:35.39,Default,,0000,0000,0000,,،لو كان لديه وقت وقوّة لكتابة كلّ هذا بدمه
Dialogue: 0,0:23:35.39,0:23:36.83,Default,,0000,0000,0000,,لطلب المساعدة
Dialogue: 0,0:23:37.14,0:23:40.04,Default,,0000,0000,0000,,...ترك القاتل هذه غالباً
Dialogue: 0,0:23:40.30,0:23:41.21,Default,,0000,0000,0000,,!لا تتدخل
Dialogue: 0,0:23:42.36,0:23:44.96,Default,,0000,0000,0000,,!أحمق! الدليل الثمين
Dialogue: 0,0:23:45.76,0:23:46.88,Default,,0000,0000,0000,,!إنّه بخير
Dialogue: 0,0:23:48.01,0:23:51.05,Default,,0000,0000,0000,,!أنت تعترض عملنا! اخرج
Dialogue: 0,0:23:53.26,0:23:59.30,Default,,0000,0000,0000,,بما أنّ سوناتا ضوء القمر لبيتهوفين عُزفت\N،بعد كلّ جريمة قتل
Dialogue: 0,0:23:59.30,0:24:08.27,Default,,0000,0000,0000,,يمكننا استنتاج أنّ قاتل كاواشيما-سان في الجريمة الأولى\Nوقاتل كوريوا-سان في الثانية هو الشخص نفسه
Dialogue: 0,0:24:08.27,0:24:11.35,Default,,0000,0000,0000,,،وبناءً على جزء الشريط الفارغ
Dialogue: 0,0:24:11.35,0:24:12.97,Default,,0000,0000,0000,,قُتل كوريوا-سان
Dialogue: 0,0:24:12.97,0:24:16.72,Default,,0000,0000,0000,,عند السادسة ونصف، قبل دقائق فقط من اكتشاف جثته
Dialogue: 0,0:24:16.78,0:24:19.76,Default,,0000,0000,0000,,أي أنّ القاتل أحدكم بما أنّكم
Dialogue: 0,0:24:19.76,0:24:22.71,Default,,0000,0000,0000,,!كنتم الوحيدين في المركز الاجتماعي في هذا الوقت
Dialogue: 0,0:24:23.39,0:24:25.10,Default,,0000,0000,0000,,{\a6}،باستثناء موري-كن والبقية
Dialogue: 0,0:24:25.10,0:24:27.35,Default,,0000,0000,0000,,{\a6}يبقى المكتشف الأول للجثة، نيشيموتو كين-سان{\a6}
Dialogue: 0,0:24:27.35,0:24:30.22,Default,,0000,0000,0000,,{\a6}والطبيبة أساي نارومي التي تفضّلت بتشريح الجثة{\a6}
Dialogue: 0,0:24:30.80,0:24:34.26,Default,,0000,0000,0000,,{\a6}وهيراتا كازواكي-سان، سكرتير العمدة كوريوا المتوفى{\a6}
Dialogue: 0,0:24:34.26,0:24:37.47,Default,,0000,0000,0000,,{\a6}وابنة العمدة، كوريوا ريكو-سان {\a6}
Dialogue: 0,0:24:37.47,0:24:39.72,Default,,0000,0000,0000,,{\a6}وخطيبها موراساوا شويتشي-سان
Dialogue: 0,0:24:39.72,0:24:43.68,Default,,0000,0000,0000,,{\a6}وأخيراً شيميزو ماساتو-سان، المرشح في انتخابات العمدة{\a6}
Dialogue: 0,0:24:43.73,0:24:47.35,Default,,0000,0000,0000,,!انتظر! لمَ أنا ضمن المشتبه بهم؟
Dialogue: 0,0:24:47.35,0:24:51.32,Default,,0000,0000,0000,,!كنتَ تستجوبني منذ السادسة والثلث
Dialogue: 0,0:24:51.47,0:24:54.61,Default,,0000,0000,0000,,...معك حق، لم يكن بإمكانك ارتكاب الجريمة
Dialogue: 0,0:24:54.91,0:24:57.43,Default,,0000,0000,0000,,يمكنكم استثناء الطبيبة نارومي أيضاً إذاً
Dialogue: 0,0:24:57.43,0:25:00.22,Default,,0000,0000,0000,,فقد كانت رفقتنا منذ السادسة
Dialogue: 0,0:25:00.22,0:25:01.51,Default,,0000,0000,0000,,صحيح يا كونان-كن؟
Dialogue: 0,0:25:01.51,0:25:02.33,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:25:02.33,0:25:06.54,Default,,0000,0000,0000,,يبقى أربعة رجال مشتبه بهم إذاً
Dialogue: 0,0:25:07.01,0:25:11.35,Default,,0000,0000,0000,,المعذرة، لكني كنت على هذا الطابق منذ السادسة
Dialogue: 0,0:25:11.35,0:25:13.14,Default,,0000,0000,0000,,ألديك شاهد؟
Dialogue: 0,0:25:14.01,0:25:17.22,Default,,0000,0000,0000,,يمكنكم أن تشهدوا بوجودي، صحيح؟
Dialogue: 0,0:25:17.22,0:25:20.59,Default,,0000,0000,0000,,آسف، لكني ذهبت لدورة المياه عند السادسة والنصف
Dialogue: 0,0:25:20.97,0:25:23.14,Default,,0000,0000,0000,,أخبرني يا نيشيموتو-سان
Dialogue: 0,0:25:23.47,0:25:27.43,Default,,0000,0000,0000,,كنتَ أوّل من وجد جثّة كوريوا-سان
Dialogue: 0,0:25:27.43,0:25:30.11,Default,,0000,0000,0000,,ماذا كنت تفعل هناك؟
Dialogue: 0,0:25:30.43,0:25:33.76,Default,,0000,0000,0000,,قال كوريوا أنّه يريد رؤيتي
Dialogue: 0,0:25:33.76,0:25:36.05,Default,,0000,0000,0000,,!ألم تكن من استدعاه وقتله؟
Dialogue: 0,0:25:36.05,0:25:37.35,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:25:37.35,0:25:38.95,Default,,0000,0000,0000,,!كان شيميزو
Dialogue: 0,0:25:38.95,0:25:41.80,Default,,0000,0000,0000,,،باختفاء كاواشيما وأبي من الانتخابات
Dialogue: 0,0:25:41.80,0:25:45.44,Default,,0000,0000,0000,,!سيفوز بمنصب العمدة تلقائياً
Dialogue: 0,0:25:46.39,0:25:48.96,Default,,0000,0000,0000,,ماذا؟ ما الذي تنظر له يا كونان-كن؟
Dialogue: 0,0:25:47.20,0:25:51.03,On Top,,0000,0000,0000,,لا تكوني حمقاء! لن أقتلهما الاثنين\N!لأخذ منصب العمدة فقط
Dialogue: 0,0:25:48.96,0:25:52.38,Default,,0000,0000,0000,,القطعة الموسيقية التي تركها القاتل في مسرح الجريمة
Dialogue: 0,0:25:51.03,0:25:52.36,On Top,,0000,0000,0000,,!يا للسخافة
Dialogue: 0,0:25:53.01,0:25:57.45,Default,,0000,0000,0000,,أظنّها رسالة مشفرة من القاتل
Dialogue: 0,0:25:58.10,0:26:00.90,Default,,0000,0000,0000,,أتساءل إن كان هناك شيء مميز في هذه\Nالنغمات الحادة والمنخفضة
Dialogue: 0,0:26:01.30,0:26:06.60,Default,,0000,0000,0000,,هذه المفاتيح السوداء على لوحة المفاتيح، صحيح؟
Dialogue: 0,0:26:06.60,0:26:07.60,Default,,0000,0000,0000,,لوحة المفاتيح؟
Dialogue: 0,0:26:08.43,0:26:11.80,Default,,0000,0000,0000,,...اعتقلوا هذا القاتل فوراً! وإلّا سيموت المزيد
Dialogue: 0,0:26:11.80,0:26:14.31,Default,,0000,0000,0000,,احترس، دورك التالي
Dialogue: 0,0:26:14.93,0:26:15.97,Default,,0000,0000,0000,,كونان-كن؟
Dialogue: 0,0:26:15.97,0:26:18.74,Default,,0000,0000,0000,,هذه الشفرة سهلة إذا عرفتِ كيف تقرئينها
Dialogue: 0,0:26:19.72,0:26:24.10,Default,,0000,0000,0000,,إنها مبنية على النغمات المتوافقة \Nمع مفاتيح بيانو محددة
Dialogue: 0,0:26:24.10,0:26:28.21,Default,,0000,0000,0000,,إن رتبت أحرف الأبجدية على لوحة مفاتيح بيانو\Nمن اليسار لليمين
Dialogue: 0,0:26:28.76,0:26:33.04,Default,,0000,0000,0000,,باستعمال هذا، تقول القطعة الموسيقية\N:حيث قُتل كاواشيما-سان
Dialogue: 0,0:26:33.55,0:26:40.08,Default,,0000,0000,0000,,"احترس، دورك التالي"
Dialogue: 0,0:26:33.55,0:26:40.08,On Top,,0000,0000,0000,,"وا كا تّ إي رو نا تسو غي وا أوماي إي نو با ن دا"
Dialogue: 0,0:26:40.18,0:26:41.02,Default,,0000,0000,0000,,هكذا
Dialogue: 0,0:26:41.02,0:26:42.85,Default,,0000,0000,0000,,!مذهل يا كونان-كن
Dialogue: 0,0:26:42.85,0:26:45.72,Default,,0000,0000,0000,,!ماذا تقول القطعة الموسيقية الأخرى إذاً؟
Dialogue: 0,0:26:45.72,0:26:47.35,Default,,0000,0000,0000,,...حسناً
Dialogue: 0,0:26:47.35,0:26:51.56,Default,,0000,0000,0000,,"أُخمد غضب نار الجحيم هنا"
Dialogue: 0,0:26:52.14,0:26:55.11,Default,,0000,0000,0000,,...غـ-غضب نار الجحيم؟! أيمكن
Dialogue: 0,0:26:55.55,0:26:59.80,Default,,0000,0000,0000,,عازف البيانو الذي انتحر في حريق قبل 12 عاماً؟
Dialogue: 0,0:27:03.14,0:27:07.76,Default,,0000,0000,0000,,!إنّه هو! أسو كيجي حيّ
Dialogue: 0,0:27:07.76,0:27:09.54,Default,,0000,0000,0000,,ليس هو
Dialogue: 0,0:27:09.76,0:27:13.39,Default,,0000,0000,0000,,أثار العظام التي وجدناها في الرماد\Nوافقت سجّل أسنانه
Dialogue: 0,0:27:13.39,0:27:14.91,Default,,0000,0000,0000,,لا شكّ أنه ميت
Dialogue: 0,0:27:15.76,0:27:18.80,Default,,0000,0000,0000,,كان كلّ شيء محروقاً تماماً
Dialogue: 0,0:27:18.80,0:27:22.93,Default,,0000,0000,0000,,ما تبقى كانت قطعةً موسيقية في خزنة \Nمضادة للحرائق فقط
Dialogue: 0,0:27:22.93,0:27:24.39,Default,,0000,0000,0000,,!قطعة موسيقية؟
Dialogue: 0,0:27:25.76,0:27:28.47,Default,,0000,0000,0000,,!أين هي؟ أين تلك القطعة الموسيقية؟
Dialogue: 0,0:27:28.47,0:27:30.68,Default,,0000,0000,0000,,في مخزن المركز الاجتماعي
Dialogue: 0,0:27:30.68,0:27:33.35,Default,,0000,0000,0000,,...لكن مفتاح المخزن في المحطة
Dialogue: 0,0:27:33.35,0:27:35.44,Default,,0000,0000,0000,,!اذهب واجلبه إذاً
Dialogue: 0,0:27:35.68,0:27:37.02,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:27:37.51,0:27:39.80,Default,,0000,0000,0000,,!انتظر أيّها الضابط! سأرافقك
Dialogue: 0,0:27:39.80,0:27:40.79,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:27:41.54,0:27:42.88,Default,,0000,0000,0000,,...يا إلهي
Dialogue: 0,0:27:43.18,0:27:47.41,Default,,0000,0000,0000,,أخبرني، هل أحرق أسو-سان منزله حقاً؟
Dialogue: 0,0:27:47.64,0:27:51.51,Default,,0000,0000,0000,,أجل، كان هناك أربعة شهود
Dialogue: 0,0:27:51.51,0:27:53.43,Default,,0000,0000,0000,,العمدة السابق كامياما-سان
Dialogue: 0,0:27:53.43,0:27:57.71,Default,,0000,0000,0000,,والعمدة كوريوا ونيشيموتو-سان وكاواشيما-سان
Dialogue: 0,0:27:57.71,0:27:59.46,Default,,0000,0000,0000,,أكانت هناك صلة بينهم؟
Dialogue: 0,0:27:59.46,0:28:02.93,Default,,0000,0000,0000,,كانوا زملاء دراسة جميعاً، بالإضافة لأسو-سان
Dialogue: 0,0:28:03.97,0:28:06.51,Default,,0000,0000,0000,,ماذا عن موراساوا ذاك إذاً؟
Dialogue: 0,0:28:06.76,0:28:10.84,Default,,0000,0000,0000,,ظهر على تلك الجزيرة قبل 3 أعوام
Dialogue: 0,0:28:11.85,0:28:15.64,Default,,0000,0000,0000,,خطب ابنة العمدة ريكو-سان قبل فترة قصيرة
Dialogue: 0,0:28:15.64,0:28:17.44,Default,,0000,0000,0000,,مع أنّ العمدة عارض ذلك
Dialogue: 0,0:28:18.01,0:28:20.40,Default,,0000,0000,0000,,ماذا عن سكرتير العمدة، هيراتا؟
Dialogue: 0,0:28:20.85,0:28:23.14,Default,,0000,0000,0000,,ذاك الشخص مثير للشبهة
Dialogue: 0,0:28:23.14,0:28:25.18,Default,,0000,0000,0000,,لا أعرف ما قصته بالضبط
Dialogue: 0,0:28:25.18,0:28:27.47,Default,,0000,0000,0000,,لكنه كان يتسلل مع كاواشيما-سان
Dialogue: 0,0:28:27.47,0:28:29.08,Default,,0000,0000,0000,,للمركز الاجتماعي دوماً
Dialogue: 0,0:28:29.55,0:28:31.29,Default,,0000,0000,0000,,ماذا عن شيميزو؟
Dialogue: 0,0:28:31.72,0:28:35.15,Default,,0000,0000,0000,,لديه حسّ قوي بالعدالة، ويملك شعبية\Nكبيرة بين الصيادين
Dialogue: 0,0:28:39.39,0:28:42.22,Default,,0000,0000,0000,,هل انتهت أسئلتك يا أكيتشي-كن؟
Dialogue: 0,0:28:39.39,0:28:42.22,Thoughts,,0000,0000,15,,أكيتشي: اسم شخصية متحرٍّ
Dialogue: 0,0:28:43.07,0:28:44.51,Default,,0000,0000,0000,,...نعم
Dialogue: 0,0:28:45.17,0:28:47.61,Default,,0000,0000,0000,,!ماذا؟ هذا غريب
Dialogue: 0,0:28:48.01,0:28:50.90,Default,,0000,0000,0000,,...كان هنا حتماً
Dialogue: 0,0:28:50.97,0:28:54.84,Default,,0000,0000,0000,,يا إلهي، مضت ساعة وأنت تبحث
Dialogue: 0,0:28:56.35,0:28:59.29,Default,,0000,0000,0000,,!ها هو! إنّه هذا المفتاح
Dialogue: 0,0:29:00.43,0:29:01.76,Default,,0000,0000,0000,,!أيّها الضابط
Dialogue: 0,0:29:01.76,0:29:03.39,Default,,0000,0000,0000,,ران-نيتشان
Dialogue: 0,0:29:03.39,0:29:04.60,Default,,0000,0000,0000,,!تأخّرتما
Dialogue: 0,0:29:04.60,0:29:06.45,Default,,0000,0000,0000,,سئم الجميع من الانتظار وغادروا
Dialogue: 0,0:29:07.05,0:29:08.87,Default,,0000,0000,0000,,!غادر كلّ المشتبه بهم؟
Dialogue: 0,0:29:09.39,0:29:10.39,Default,,0000,0000,0000,,أجل
Dialogue: 0,0:29:10.39,0:29:15.47,Default,,0000,0000,0000,,:قالت رسالة القاتل الأخيرة \N"أُخمد غضب نار الجحيم هنا"
Dialogue: 0,0:29:15.47,0:29:17.83,Default,,0000,0000,0000,,لذا ظنّوا أنه لن تقع المزيد من الجرائم
Dialogue: 0,0:29:17.83,0:29:19.35,Default,,0000,0000,0000,,!لا يمكن
Dialogue: 0,0:29:19.35,0:29:21.60,Default,,0000,0000,0000,,عُزفت أول حركتين فقط لضوء القمر
Dialogue: 0,0:29:21.60,0:29:24.60,Default,,0000,0000,0000,,!في مسرح كلّ جريمة حتى الآن
Dialogue: 0,0:29:24.60,0:29:27.68,Default,,0000,0000,0000,,!تبقى لضوء القمر حركة أخيرة
Dialogue: 0,0:29:28.10,0:29:30.26,Default,,0000,0000,0000,,!سأذهب لتفقد المركز الاجتماعي
Dialogue: 0,0:29:31.60,0:29:34.31,Default,,0000,0000,0000,,!انتظر! كونان-كن
Dialogue: 0,0:29:37.26,0:29:39.64,Default,,0000,0000,0000,,يا لفضولك يا كونان-كن
Dialogue: 0,0:29:39.64,0:29:41.14,Default,,0000,0000,0000,,!أسرع
Dialogue: 0,0:29:41.14,0:29:42.11,Default,,0000,0000,0000,,لا تعجلني
Dialogue: 0,0:29:44.85,0:29:47.28,Default,,0000,0000,0000,,ألم تسمعا صوتاً غريباً من غرفة البيانو؟
Dialogue: 0,0:29:48.30,0:29:49.24,Default,,0000,0000,0000,,كلا
Dialogue: 0,0:29:50.87,0:29:51.49,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:29:55.76,0:29:56.91,Default,,0000,0000,0000,,!انتظر
Dialogue: 0,0:30:00.47,0:30:03.30,Default,,0000,0000,0000,,!موراساوا-سان
Dialogue: 0,0:30:03.30,0:30:04.21,Default,,0000,0000,0000,,!ران
Dialogue: 0,0:30:04.51,0:30:05.09,Default,,0000,0000,0000,,!المخزن
Dialogue: 0,0:30:09.76,0:30:10.80,Default,,0000,0000,0000,,نيشيموتو-سان
Dialogue: 0,0:30:11.39,0:30:14.10,Default,,0000,0000,0000,,!حضرة الضابط، اتّصل بالمفتش ميغوري
Dialogue: 0,0:30:14.10,0:30:14.77,Default,,0000,0000,0000,,!حسناً
Dialogue: 0,0:30:18.89,0:30:20.69,Default,,0000,0000,0000,,هل عُزفت الحركة الثالثة؟
Dialogue: 0,0:30:21.26,0:30:23.18,Default,,0000,0000,0000,,توجد 30 دقيقة لكلّ جانب لهذا الشريط
Dialogue: 0,0:30:23.18,0:30:26.69,Default,,0000,0000,0000,,مما يعني أنّ نيشيموتو-سان مات\Nخلال النصف ساعة الماضية
Dialogue: 0,0:30:27.14,0:30:28.18,Default,,0000,0000,0000,,!انظر يا كونان-كن
Dialogue: 0,0:30:28.18,0:30:30.62,Default,,0000,0000,0000,,!توجد قطعة موسيقية أخرى عند أقدام نيشيموتو-سان
Dialogue: 0,0:30:35.89,0:30:37.68,Default,,0000,0000,0000,,ما تقول هذه المرة؟
Dialogue: 0,0:30:37.68,0:30:38.62,Default,,0000,0000,0000,,"وصيّة"
Dialogue: 0,0:30:39.01,0:30:39.97,Default,,0000,0000,0000,,وصيّة؟
Dialogue: 0,0:30:40.76,0:30:41.66,Default,,0000,0000,0000,,...إذاً
Dialogue: 0,0:30:43.18,0:30:44.80,Default,,0000,0000,0000,,كان انتحاراً؟
Dialogue: 0,0:30:45.18,0:30:46.51,Default,,0000,0000,0000,,،وفقاً للوصيّة
Dialogue: 0,0:30:46.51,0:30:50.01,Default,,0000,0000,0000,,فقد شعر بالندم على قتل السيّد كاواشيما\Nوالسيّد كوريوا
Dialogue: 0,0:30:50.01,0:30:51.18,Default,,0000,0000,0000,,!نيشيموتو من قتلهما؟
Dialogue: 0,0:30:51.68,0:30:57.05,Default,,0000,0000,0000,,يبدو أنّه لم يرد أن يُكشف خطأ\Nقديم ارتكبوه
Dialogue: 0,0:30:57.05,0:31:00.35,Default,,0000,0000,0000,,والمشار لهم هم السيّد كامياما الذي مات قبل عامين
Dialogue: 0,0:31:00.35,0:31:03.30,Default,,0000,0000,0000,,والسيّد كاواشيما والسيّد كوريوا اللذان ماتا مؤخراً
Dialogue: 0,0:31:03.30,0:31:05.30,Default,,0000,0000,0000,,والسيّد نيشيموتو الذي شنق نفسه
Dialogue: 0,0:31:05.30,0:31:08.08,Default,,0000,0000,0000,,وأخيراً السيّد أسو الذي انتحر قبل 12 عاماً
Dialogue: 0,0:31:08.47,0:31:10.28,Default,,0000,0000,0000,,عازف البيانو أيضاً؟
Dialogue: 0,0:31:10.64,0:31:14.55,Default,,0000,0000,0000,,أتوقع أنّهم قاموا بشيء باستعمال هذه الشفرة
Dialogue: 0,0:31:14.55,0:31:19.01,Default,,0000,0000,0000,,هكذا إذاً، كان نيشيموتو يخشى\Nفضح سرّهم القديم
Dialogue: 0,0:31:19.01,0:31:21.61,Default,,0000,0000,0000,,فاقتحم المخزن للتخلص من القطعة الموسيقية
Dialogue: 0,0:31:22.22,0:31:25.05,Default,,0000,0000,0000,,،لكن عجزه عن العثور عليها حاصره نفسياً
Dialogue: 0,0:31:25.05,0:31:26.97,Default,,0000,0000,0000,,فقام بالانتحار
Dialogue: 0,0:31:26.97,0:31:28.51,Default,,0000,0000,0000,,لا أظنّه كان انتحاراً
Dialogue: 0,0:31:29.97,0:31:33.09,Default,,0000,0000,0000,,من المُحال أن تشنق نفسك\Nدون ما يسندك تحتك، صحيح؟
Dialogue: 0,0:31:33.39,0:31:35.72,Default,,0000,0000,0000,,ألم تكن أنت من أبعده؟
Dialogue: 0,0:31:35.72,0:31:37.31,Default,,0000,0000,0000,,لم أفعل ذلك
Dialogue: 0,0:31:37.64,0:31:42.77,Default,,0000,0000,0000,,كما أشك أن يكتب أحدهم وصيته باستخدام شفرة
Dialogue: 0,0:31:43.18,0:31:46.72,Default,,0000,0000,0000,,أتقصد أنّ القاتل شخص آخر؟
Dialogue: 0,0:31:46.72,0:31:48.53,Default,,0000,0000,0000,,رأيتُ شخصاً مريباً
Dialogue: 0,0:31:48.53,0:31:49.11,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:31:49.43,0:31:51.22,Default,,0000,0000,0000,,اثنان في غرفة البيانو
Dialogue: 0,0:31:51.22,0:31:53.07,Default,,0000,0000,0000,,أحدهما حطّم النافذة وهرب
Dialogue: 0,0:31:53.43,0:31:55.43,Default,,0000,0000,0000,,بينما الآخر كان موراساوا-نيتشان
Dialogue: 0,0:31:55.43,0:31:56.80,Default,,0000,0000,0000,,ضربه أحدهم
Dialogue: 0,0:31:56.80,0:32:00.58,Default,,0000,0000,0000,,وتعالجه الطبيبة نارومي في غرفة البيانو الآن
Dialogue: 0,0:32:03.64,0:32:04.97,Default,,0000,0000,0000,,!لمَ لم تقل ذلك قبلاً؟
Dialogue: 0,0:32:04.97,0:32:06.34,Default,,0000,0000,0000,,!أبي
Dialogue: 0,0:32:07.26,0:32:10.30,Default,,0000,0000,0000,,لم تجد قطعة السيّد أسو الموسيقية بعد؟
Dialogue: 0,0:32:10.97,0:32:15.20,Default,,0000,0000,0000,,حدث ذلك قبل 12 عاماً، من المستحيل\Nأن أتذكر أين وضعناها
Dialogue: 0,0:32:17.89,0:32:19.85,Default,,0000,0000,0000,,لا يزال فاقداً للوعي؟
Dialogue: 0,0:32:19.85,0:32:22.80,Default,,0000,0000,0000,,أجل، أظنّه تلقى ارتجاجاً دماغياً
Dialogue: 0,0:32:23.30,0:32:24.89,Default,,0000,0000,0000,,بالمناسبة يا كوريوا-سان
Dialogue: 0,0:32:24.89,0:32:28.82,Default,,0000,0000,0000,,ما الذي كان يفعله موراساوا-سان هنا\Nفي هذا الوقت المتأخر؟
Dialogue: 0,0:32:30.63,0:32:30.69,Default,,0000,0000,0000,,!كيف لي أن أعرف؟
Dialogue: 0,0:32:33.82,0:32:34.76,Default,,0000,0000,0000,,...هـ-هذا
Dialogue: 0,0:32:34.82,0:32:36.89,Default,,0000,0000,0000,,!لا تلمس أغراض شويتشي
Dialogue: 0,0:32:37.30,0:32:38.68,Default,,0000,0000,0000,,ما ذاك الشيء؟
Dialogue: 0,0:32:38.68,0:32:41.92,Default,,0000,0000,0000,,!لا أدري! لكنه كان مهماً لشويتشي
Dialogue: 0,0:32:42.64,0:32:46.15,Default,,0000,0000,0000,,إنّها مطرقة تنغيم تُستعمل لضبط البيانو
Dialogue: 0,0:32:46.68,0:32:48.22,Default,,0000,0000,0000,,...أي أنه كان من
Dialogue: 0,0:32:49.13,0:32:53.18,Default,,0000,0000,0000,,حسنٌ، اجلبوا كافة المشتبه بهم لدار البلدية فوراً
Dialogue: 0,0:32:53.18,0:32:53.88,Default,,0000,0000,0000,,!حاضر
Dialogue: 0,0:33:00.26,0:33:01.76,Default,,0000,0000,0000,,ما الذي تفعله يا كونان-كن؟
Dialogue: 0,0:33:01.76,0:33:02.72,Default,,0000,0000,0000,,سنذهب لدار البلدية
Dialogue: 0,0:33:03.05,0:33:05.72,Default,,0000,0000,0000,,كان الشخص المريب الذي هرب\Nمن هذه الغرفة يبحث
Dialogue: 0,0:33:05.72,0:33:07.77,Default,,0000,0000,0000,,عن شيءٍ أسفل البيانو
Dialogue: 0,0:33:09.26,0:33:10.61,Default,,0000,0000,0000,,!هنا! وجدته
Dialogue: 0,0:33:12.35,0:33:15.56,Default,,0000,0000,0000,,!مُذهل، لوح خفيّ! رائع
Dialogue: 0,0:33:19.80,0:33:20.77,Default,,0000,0000,0000,,!مخدرات
Dialogue: 0,0:33:24.54,0:33:26.01,On Top,,0000,0000,0000,,دار  بلدية جزيرة تسوكيكاغي
Dialogue: 0,0:33:26.43,0:33:28.80,Default,,0000,0000,0000,,بناءً على أساليب الحوادث الثلاثة\N،التي وقعت على هذه الجزيرة
Dialogue: 0,0:33:28.80,0:33:31.46,Default,,0000,0000,0000,,فالفاعل هو نفس الشخص بلا شك
Dialogue: 0,0:33:31.80,0:33:35.55,Default,,0000,0000,0000,,للطبيبة نارومي وكوريوا ريكو-سان حجّتا غياب مؤكدتان
Dialogue: 0,0:33:35.55,0:33:37.19,Default,,0000,0000,0000,,فخرجا عن لائحة المشتبه بهم
Dialogue: 0,0:33:37.30,0:33:40.22,Default,,0000,0000,0000,,لكن لا حجّة غياب هناك للسكرتير هيراتا-سان
Dialogue: 0,0:33:40.22,0:33:42.93,Default,,0000,0000,0000,,وللمرشح للعمدة شيميزو-سان
Dialogue: 0,0:33:42.93,0:33:46.55,Default,,0000,0000,0000,,ولا لموراساوا-سان الذي يرقد في عيادة حالياً
Dialogue: 0,0:33:46.55,0:33:48.79,Default,,0000,0000,0000,,!القاتل أحد هؤلاء الثلاثة
Dialogue: 0,0:33:49.72,0:33:52.01,Default,,0000,0000,0000,,طبيبة نارومي، لا يزال موراساوا-سان فاقداً للوعي؟
Dialogue: 0,0:33:52.01,0:33:56.05,Default,,0000,0000,0000,,أجل، ريكو-سان تعتني به لكنه\Nلم يستعد وعيه بعد
Dialogue: 0,0:33:56.05,0:33:59.97,Default,,0000,0000,0000,,هناك شيءٌ يضايقني، لكن ما هو؟
Dialogue: 0,0:34:00.55,0:34:04.68,Default,,0000,0000,0000,,...مُذ رأيت شفرة الدم في مسرح الجريمة
Dialogue: 0,0:34:04.68,0:34:06.11,Default,,0000,0000,0000,,...كان هناك ما
Dialogue: 0,0:34:06.76,0:34:07.51,Default,,0000,0000,0000,,حضرة المفتش
Dialogue: 0,0:34:07.51,0:34:10.43,Default,,0000,0000,0000,,صور مسرح جريمة قتل السيّد كوريوا جاهزة
Dialogue: 0,0:34:10.43,0:34:13.00,Default,,0000,0000,0000,,حسنٌ، ضعها على تلك الطاولة
Dialogue: 0,0:34:13.00,0:34:13.67,Default,,0000,0000,0000,,حاضر
Dialogue: 0,0:34:18.72,0:34:22.35,Default,,0000,0000,0000,,ما هذا الضوء عند عنق السيّد كوريوا؟
Dialogue: 0,0:34:22.35,0:34:24.95,Default,,0000,0000,0000,,ليس موجوداً في الصورة بعد تحريكه
Dialogue: 0,0:34:25.64,0:34:30.13,Default,,0000,0000,0000,,أيمكنني الذهاب لشراء عصير؟ أشعر بالعطش
Dialogue: 0,0:34:31.22,0:34:32.69,Default,,0000,0000,0000,,لا مشكلة
Dialogue: 0,0:34:33.47,0:34:34.55,Default,,0000,0000,0000,,مُصاب؟
Dialogue: 0,0:34:39.22,0:34:40.95,Default,,0000,0000,0000,,يا عمّ
Dialogue: 0,0:34:40.95,0:34:43.35,Default,,0000,0000,0000,,يوجد مسحوق أبيض على كمّيك
Dialogue: 0,0:34:43.41,0:34:45.51,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:34:46.43,0:34:48.72,Default,,0000,0000,0000,,!نقود من كلّ أرجاء العالم
Dialogue: 0,0:34:49.43,0:34:52.22,Default,,0000,0000,0000,,أُحب البلدان الأجنبية
Dialogue: 0,0:34:55.55,0:34:56.30,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:35:00.43,0:35:02.30,Default,,0000,0000,0000,,ما الخطب أيّها الشرطي؟
Dialogue: 0,0:35:02.30,0:35:06.31,Default,,0000,0000,0000,,وجدتُ أخيراً القطعة الموسيقية \N!التي تركها أسو-سان
Dialogue: 0,0:35:06.76,0:35:07.73,Default,,0000,0000,0000,,!دعني أرى
Dialogue: 0,0:35:10.14,0:35:14.77,On Top,,0000,0000,0000,,"و ا غام وسو كو س ي جي إيه"
Dialogue: 0,0:35:10.14,0:35:14.77,Default,,0000,0000,0000,,"إلى ابني سيجي"
Dialogue: 0,0:35:15.14,0:35:16.35,Default,,0000,0000,0000,,ا-ابن؟
Dialogue: 0,0:35:16.35,0:35:21.84,Default,,0000,0000,0000,,صحيح، كان لأسو-سان ابنٌ \Nبالإضافة لابنته
Dialogue: 0,0:35:22.72,0:35:26.80,Default,,0000,0000,0000,,أصابه مرض شديد في صغره وتمّ إسعافه للمشفى
Dialogue: 0,0:35:26.80,0:35:30.09,Default,,0000,0000,0000,,أظنّ اسمه كان سيجي
Dialogue: 0,0:35:30.47,0:35:31.89,Default,,0000,0000,0000,,!سيجي؟
Dialogue: 0,0:35:31.89,0:35:33.42,Default,,0000,0000,0000,,...لا-لا يمكن
Dialogue: 0,0:35:39.68,0:35:42.97,Default,,0000,0000,0000,,!أنت! انتظر أيّها الصبي! أين تذهب؟
Dialogue: 0,0:35:48.55,0:35:50.99,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:35:51.80,0:35:53.93,Default,,0000,0000,0000,,سبب استدراج القاتل كاواشيما-سان لغرفة البيانو
Dialogue: 0,0:35:53.93,0:35:55.99,Default,,0000,0000,0000,,!بعد إغراقه له
Dialogue: 0,0:35:56.27,0:35:58.73,Default,,0000,0000,0000,,ومعنى المعزوفة التي شُغلت في مسارح الجريمة
Dialogue: 0,0:35:58.73,0:36:01.35,Default,,0000,0000,0000,,ولغز الشفرة المكتوبة بالدم
Dialogue: 0,0:36:02.68,0:36:06.31,Default,,0000,0000,0000,,!لا شكّ في الأمر، ذاك الشخص هو المجرم
Dialogue: 0,0:36:11.68,0:36:14.25,Default,,0000,0000,0000,,تلقّى العم موري رسالةً من رجل مُتوفى
Dialogue: 0,0:36:14.25,0:36:16.42,Default,,0000,0000,0000,,وتوجه لجزيرة تسوكيكاغي
Dialogue: 0,0:36:16.42,0:36:20.09,Default,,0000,0000,0000,,كان المُرسل أسو كيجي، عازف بيانو قتل عائلته
Dialogue: 0,0:36:20.09,0:36:24.48,Default,,0000,0000,0000,,وأحرق منزله ومات وهو يعزف سوناتا بيانو ضوء القمر
Dialogue: 0,0:36:25.01,0:36:27.85,Default,,0000,0000,0000,,،وقعت أوّل جريمة في ليلة ذكرى العمدة السابق
Dialogue: 0,0:36:27.85,0:36:29.85,Default,,0000,0000,0000,,السيّد كامياما
Dialogue: 0,0:36:29.85,0:36:32.14,Default,,0000,0000,0000,,وُجد كاواشيما هيديو ميتاً في غرفة البيانو
Dialogue: 0,0:36:32.14,0:36:34.88,Default,,0000,0000,0000,,مع تسجيل عزف الحركة الأولى لضوء القمر
Dialogue: 0,0:36:35.39,0:36:38.81,Default,,0000,0000,0000,,ووقعت الجريمة الثانية مع تسجيل الحركة الثانية
Dialogue: 0,0:36:39.35,0:36:41.97,Default,,0000,0000,0000,,كان الضحية العمدة الحالي كوريوا تاتسوجي
Dialogue: 0,0:36:41.97,0:36:44.40,Default,,0000,0000,0000,,وتقلّص عدد المشتبه بهم إلى ستّة أشخاص
Dialogue: 0,0:36:44.40,0:36:47.39,Default,,0000,0000,0000,,وضحيّة الجريمة الثالثة كان نيشيموتو كين
Dialogue: 0,0:36:47.39,0:36:49.42,Default,,0000,0000,0000,,الذي قُتل بأسلوب يجعله يبدو انتحاراً
Dialogue: 0,0:36:51.31,0:36:55.50,Default,,0000,0000,0000,,"إلى ابني سيجي"
Dialogue: 0,0:36:56.30,0:36:58.13,Default,,0000,0000,0000,,!هكذا إذاً! فهمت
Dialogue: 0,0:36:58.76,0:37:00.89,Default,,0000,0000,0000,,سبب استدراج القاتل لكاواشيما-سان لغرفة البيانو
Dialogue: 0,0:37:00.89,0:37:03.05,Default,,0000,0000,0000,,!بعد إغراقه له
Dialogue: 0,0:37:03.43,0:37:05.76,Default,,0000,0000,0000,,ومعنى المعزوفة التي شُغلت في مسارح الجريمة
Dialogue: 0,0:37:06.01,0:37:08.72,Default,,0000,0000,0000,,ولغز الشفرة المكتوبة بالدم
Dialogue: 0,0:37:09.93,0:37:13.76,Default,,0000,0000,0000,,!لا شكّ في الأمر، ذاك الشخص هو المجرم
Dialogue: 0,0:37:16.32,0:37:20.44,Default,,0000,0000,0000,,يا إلهي، لمَ ركضت لغرفة البثّ هكذا فجأةً؟
Dialogue: 0,0:37:20.44,0:37:22.43,Default,,0000,0000,0000,,!أيوجد شيء هنا؟
Dialogue: 0,0:37:22.43,0:37:24.19,Default,,0000,0000,0000,,كلا، ليس تماماً
Dialogue: 0,0:37:24.55,0:37:28.66,Default,,0000,0000,0000,,لا خيار لديّ، عليّ استعمال صوت العمّ\Nمجدداً وحلّ القضية
Dialogue: 0,0:37:28.82,0:37:30.78,Default,,0000,0000,0000,,بطلقة واحدة من مسدّس الساعة المخدّر
Dialogue: 0,0:37:33.08,0:37:37.26,Default,,0000,0000,0000,,بأيّ حال، سيرافقنا هيراتا-سان وشيميزو-سان لليابسة
Dialogue: 0,0:37:37.26,0:37:38.21,Default,,0000,0000,0000,,صباح الغد
Dialogue: 0,0:37:38.21,0:37:39.84,Default,,0000,0000,0000,,!لـ-لكن
Dialogue: 0,0:37:40.05,0:37:43.01,Default,,0000,0000,0000,,الحادثة الأولى حيث أُغرق السيّد كاواشيما
Dialogue: 0,0:37:43.01,0:37:46.68,Default,,0000,0000,0000,,وسُحبت جثته لغرفة بيانو المركز الاجتماعي ليلة الأمس
Dialogue: 0,0:37:46.68,0:37:49.14,Default,,0000,0000,0000,,والحادثة الثانية حيث قُتل السيّد كوريوا
Dialogue: 0,0:37:49.14,0:37:52.10,Default,,0000,0000,0000,,في غرفة البثّ هذه الليلة
Dialogue: 0,0:37:52.10,0:37:55.14,Default,,0000,0000,0000,,والحادثة الثالثة التي وقعت الليلة نفسها
Dialogue: 0,0:37:55.14,0:37:56.93,Default,,0000,0000,0000,,حيث قُتل السيّد نيشيموتو في المخزن
Dialogue: 0,0:37:56.93,0:37:58.81,Default,,0000,0000,0000,,بأسلوب يجعله يبدو انتحاراً
Dialogue: 0,0:37:59.47,0:38:02.80,Default,,0000,0000,0000,,أنتما الوحيدان اللذان لا يملكان\Nحجّة غياب لهذه الحوادث الثلاث
Dialogue: 0,0:38:02.80,0:38:06.07,Default,,0000,0000,0000,,بالإضافة لموراساوا-سان الذي يرقد في العيادة
Dialogue: 0,0:38:07.01,0:38:10.14,Default,,0000,0000,0000,,يؤسفني فعل ذلك، لكن علينا حراستكم اليوم
Dialogue: 0,0:38:10.14,0:38:12.11,Default,,0000,0000,0000,,!حللتُ الأمر سيّدي المفتش
Dialogue: 0,0:38:13.14,0:38:16.22,Default,,0000,0000,0000,,!كلّ ما يخصّ جرائم القتل على هذه الجزيرة
Dialogue: 0,0:38:16.22,0:38:18.14,Default,,0000,0000,0000,,أبي! أنت في غرفة البثّ؟
Dialogue: 0,0:38:18.25,0:38:22.76,Default,,0000,0000,0000,,بدايةً، الشخص الذي ضرب موراساوا-سان\Nوأفقده وعيه في غرفة البيانو
Dialogue: 0,0:38:22.76,0:38:25.46,Default,,0000,0000,0000,,ذاك أنت يا هيراتا-سان
Dialogue: 0,0:38:26.64,0:38:27.76,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:38:27.76,0:38:30.10,Default,,0000,0000,0000,,أُصيبت يد هيراتا-سان اليسرى
Dialogue: 0,0:38:30.10,0:38:32.97,Default,,0000,0000,0000,,عندما حطّم النافذة وهرب
Dialogue: 0,0:38:32.97,0:38:36.01,Default,,0000,0000,0000,,كنتَ الشخص المشبوه الذي رأيناه ليلة الأمس أيضاً
Dialogue: 0,0:38:36.01,0:38:37.82,Default,,0000,0000,0000,,لكن ما الذي كان يفعله؟
Dialogue: 0,0:38:38.14,0:38:42.55,Default,,0000,0000,0000,,كان يعقد صفقات مع السيّد كاواشيما في تلك الغرفة\Nالتي تحوي البيانو
Dialogue: 0,0:38:42.55,0:38:43.48,Default,,0000,0000,0000,,صفقات مخدرات
Dialogue: 0,0:38:43.72,0:38:44.96,Default,,0000,0000,0000,,!مـ-مخدرات؟
Dialogue: 0,0:38:45.60,0:38:48.26,Default,,0000,0000,0000,,استعمل هيراتا-سان لوحاً مخفياً في البيانو
Dialogue: 0,0:38:48.26,0:38:53.45,Default,,0000,0000,0000,,للمتاجرة بمخدرات اشتراها خارج البلاد\Nمقابل كمية كبيرة من النقود
Dialogue: 0,0:38:53.45,0:38:59.14,Default,,0000,0000,0000,,!هكذا إذاً! لذا كانا في المركز الاجتماعي كلّ ليلة
Dialogue: 0,0:38:59.68,0:39:03.76,Default,,0000,0000,0000,,سبب ادّعاء هيراتا-سان الدائم أنّ البيانو ملعون
Dialogue: 0,0:39:03.76,0:39:06.37,Default,,0000,0000,0000,,هو لإبعاد الناس عن مسرح صفقاته
Dialogue: 0,0:39:06.76,0:39:08.80,Default,,0000,0000,0000,,اعتدى على موراساوا-سان وهرب
Dialogue: 0,0:39:08.80,0:39:13.14,Default,,0000,0000,0000,,لأنّه رآه يأخذ المخدرات التي تركها هناك غالباً
Dialogue: 0,0:39:13.14,0:39:14.42,Default,,0000,0000,0000,,أي أنّك قتلت السيّد كاواشيما
Dialogue: 0,0:39:14.42,0:39:17.39,Default,,0000,0000,0000,,!لأنّكما تشاجرتما بشأن الصفقات؟
Dialogue: 0,0:39:17.39,0:39:18.43,Default,,0000,0000,0000,,!كـ-كلا
Dialogue: 0,0:39:18.43,0:39:21.79,Default,,0000,0000,0000,,لا علاقة لهيراتا-سان بالجرائم الثلاث
Dialogue: 0,0:39:22.47,0:39:26.55,Default,,0000,0000,0000,,لو كان القاتل، فلم يكن ليرتكب جرائمه في غرفة البيانو
Dialogue: 0,0:39:26.55,0:39:29.71,Default,,0000,0000,0000,,فهي الغرفة التي خبّأ المخدرات فيها
Dialogue: 0,0:39:30.86,0:39:33.10,Default,,0000,0000,0000,,التالي هو موراساوا-سان
Dialogue: 0,0:39:33.10,0:39:34.89,Default,,0000,0000,0000,,!هو القاتل؟
Dialogue: 0,0:39:34.89,0:39:36.64,Default,,0000,0000,0000,,ليس القاتل أيضاً
Dialogue: 0,0:39:36.94,0:39:37.98,Default,,0000,0000,0000,,ماذا؟
Dialogue: 0,0:39:38.39,0:39:41.76,Default,,0000,0000,0000,,سبب كتابة القاتل وصيّةً لجعل الأمر يبدو انتحاراً
Dialogue: 0,0:39:41.76,0:39:43.72,Default,,0000,0000,0000,,وعدم وضعه لمسند أقدام في الغرفة
Dialogue: 0,0:39:43.72,0:39:46.18,Default,,0000,0000,0000,,هو هلعه عندما أتت ران والبقية ولوذه بالفرار
Dialogue: 0,0:39:46.18,0:39:48.92,Default,,0000,0000,0000,,سيكون من المستحيل دخول غرفة البيانو بعدها
Dialogue: 0,0:39:48.92,0:39:50.59,Default,,0000,0000,0000,,مـ-معك حق
Dialogue: 0,0:39:51.10,0:39:53.55,Default,,0000,0000,0000,,حتّى الآن، صورتنا عن القاتل هي رجل
Dialogue: 0,0:39:53.55,0:39:56.89,Default,,0000,0000,0000,,لأنّ الجرائم الثلاث تطلبت قوّةً بدنية
Dialogue: 0,0:39:56.89,0:39:59.29,Default,,0000,0000,0000,,كما شخص دون حجّة غياب
Dialogue: 0,0:40:00.01,0:40:02.85,Default,,0000,0000,0000,,المشتبه الوحيد المتبقي هو شيميزو-سان
Dialogue: 0,0:40:03.10,0:40:05.68,Default,,0000,0000,0000,,الآن علينا إمعان النظر في الجريمة الثانية
Dialogue: 0,0:40:06.43,0:40:10.80,Default,,0000,0000,0000,,افترضنا أنّ كوريوا-سان قُتل قبيل\Nدقائق من العثور على جثته
Dialogue: 0,0:40:10.80,0:40:12.89,Default,,0000,0000,0000,,...لكن تذكروا
Dialogue: 0,0:40:12.89,0:40:18.35,Default,,0000,0000,0000,,لم تزل شفرة الدم عندما سقط كونان عليها آنذاك
Dialogue: 0,0:40:19.89,0:40:25.05,Default,,0000,0000,0000,,يستغرق دم الإنسان 15 إلى 30 دقيقة\Nليجفّ في درجة حرارة الغرفة
Dialogue: 0,0:40:25.05,0:40:28.30,Default,,0000,0000,0000,,لكن كان ذاك الدم جافاً
Dialogue: 0,0:40:28.55,0:40:31.14,Default,,0000,0000,0000,,رغم أنّه قُتل قبيل دقائق وفقما يُفترض
Dialogue: 0,0:40:31.55,0:40:38.22,Default,,0000,0000,0000,,صحيح، كانت حيلة استعملها المجرم\Nللتلاعب بوقت الوفاة المقدر
Dialogue: 0,0:40:38.22,0:40:40.14,Default,,0000,0000,0000,,!ما-ماذا؟
Dialogue: 0,0:40:40.14,0:40:44.06,Default,,0000,0000,0000,,لكن كانت أوّل خمس دقائق ونصف\Nهي الفارغة فقط في التسجيل
Dialogue: 0,0:40:44.47,0:40:45.97,Default,,0000,0000,0000,,قلب الشريط الآلي
Dialogue: 0,0:40:45.97,0:40:49.18,Default,,0000,0000,0000,,شغّل القاتل الجانب الثاني للشريط\Nالذي لم يحتو عزفاً
Dialogue: 0,0:40:49.18,0:40:53.03,Default,,0000,0000,0000,,وحصل على 30 دقيقة إضافية باستعمال القلب الآلي
Dialogue: 0,0:40:53.15,0:40:55.24,Default,,0000,0000,0000,,انظروا للصور رجاءً
Dialogue: 0,0:40:55.24,0:40:58.47,Default,,0000,0000,0000,,يوجد مفتاح مُضاء قرب عنق كوريوا-سان
Dialogue: 0,0:40:58.47,0:41:01.70,Default,,0000,0000,0000,,لكن الضوء اختفى بعدما حُركت جثته
Dialogue: 0,0:41:01.70,0:41:06.32,Default,,0000,0000,0000,,هذا دليل على أنّ القاتل أطفأه\Nعندما ابتعدت أنظار الشرطة
Dialogue: 0,0:41:06.76,0:41:09.77,Default,,0000,0000,0000,,...لكن وفقما أتذكر، من اقترب من الجثة آنذاك
Dialogue: 0,0:41:10.14,0:41:11.43,Default,,0000,0000,0000,,صحيح
Dialogue: 0,0:41:11.43,0:41:13.80,Default,,0000,0000,0000,,الشخص الوحيد الذي اقترب من الجثّة مع الشرطة
Dialogue: 0,0:41:13.80,0:41:16.14,Default,,0000,0000,0000,,ومن زيّف وقت الوفاة المقدر
Dialogue: 0,0:41:16.14,0:41:17.85,Default,,0000,0000,0000,,...هو من فحص الجثة
Dialogue: 0,0:41:18.54,0:41:21.06,Default,,0000,0000,0000,,!أنت أيّتها الطبيبة نارومي
Dialogue: 0,0:41:23.68,0:41:26.35,Default,,0000,0000,0000,,!هذا ليس صحيحاً، أليس كذلك أيّتها الطبيبة نارومي؟
Dialogue: 0,0:41:26.68,0:41:32.26,Default,,0000,0000,0000,,أغرقتِ كاواشيما-سان وسحبته لغرفة البيانو\Nفي الحادثة الأولى
Dialogue: 0,0:41:32.26,0:41:34.47,Default,,0000,0000,0000,,لإعادة محقّقي الوفاة لليابسة
Dialogue: 0,0:41:34.47,0:41:37.93,Default,,0000,0000,0000,,بما أنّهم لن يتمكنوا من تحليل موت غير طبيعي هنا
Dialogue: 0,0:41:37.93,0:41:41.64,Default,,0000,0000,0000,,وسبب وضعك للمساحة الفارغة في بداية كلّ تسجيل
Dialogue: 0,0:41:41.64,0:41:46.01,Default,,0000,0000,0000,,هو كي تستطيعي تضليلنا بتزييف وقت الجريمة الثانية
Dialogue: 0,0:41:46.01,0:41:50.14,Default,,0000,0000,0000,,وهكذا، تلاعبتِ بوقت موت كوريوا-سان
Dialogue: 0,0:41:50.14,0:41:52.18,Default,,0000,0000,0000,,وصنعتِ حجّة غياب لنفسك
Dialogue: 0,0:41:52.64,0:41:57.01,Default,,0000,0000,0000,,!لكن يا موري-كن، قلتَ أن المجرم رجل
Dialogue: 0,0:41:57.01,0:41:59.89,Default,,0000,0000,0000,,دافع الجرائم يعود لاثني عشر عاماً مضى
Dialogue: 0,0:41:59.89,0:42:01.42,Default,,0000,0000,0000,,أتسمعني؟
Dialogue: 0,0:42:01.80,0:42:05.62,Default,,0000,0000,0000,,لحادثة مقتل عازف البيانو أسو كيجي وعائلته
Dialogue: 0,0:42:06.01,0:42:07.56,Default,,0000,0000,0000,,!مقتل؟
Dialogue: 0,0:42:07.89,0:42:10.72,Default,,0000,0000,0000,,كاواشيما-سان ونيشيموتو-سان وكوريوا-سان
Dialogue: 0,0:42:10.72,0:42:13.53,Default,,0000,0000,0000,,والعمدة السابق كامياما-سان
Dialogue: 0,0:42:13.53,0:42:15.64,Default,,0000,0000,0000,,استغلوا عروض عزف أسو-سان العالمية
Dialogue: 0,0:42:15.64,0:42:18.95,Default,,0000,0000,0000,,كفرصة للمتاجرة بالمخدرات
Dialogue: 0,0:42:18.95,0:42:22.72,Default,,0000,0000,0000,,لكن قال أسو-سان عندها أنّه لن يتعاون معهم مجدداً
Dialogue: 0,0:42:23.47,0:42:26.10,Default,,0000,0000,0000,,خشيةً من فضح سرّهم
Dialogue: 0,0:42:26.10,0:42:29.80,Default,,0000,0000,0000,,احتجزوه وعائلته في منزلهم وأحرقوهم
Dialogue: 0,0:42:32.22,0:42:37.10,Default,,0000,0000,0000,,كلّ هذا مكتوب في القطعة الموسيقية التي نجت من النار
Dialogue: 0,0:42:37.10,0:42:40.58,Default,,0000,0000,0000,,في رسالة الاعتراف التي كتبها أسو-سان لطفله
Dialogue: 0,0:42:41.14,0:42:42.14,Default,,0000,0000,0000,,!ابنه؟
Dialogue: 0,0:42:42.43,0:42:46.89,Default,,0000,0000,0000,,كان لديه ابن في مشفى في طوكيو
Dialogue: 0,0:42:46.89,0:42:48.08,Default,,0000,0000,0000,,اسمه سيجي
Dialogue: 0,0:42:48.76,0:42:51.15,Default,,0000,0000,0000,,...سيجي؟ أيمكن
Dialogue: 0,0:42:51.76,0:42:54.93,Default,,0000,0000,0000,,اسم الطبيبة نارومي الحقيقي هو سيجي
Dialogue: 0,0:42:54.93,0:42:58.50,Default,,0000,0000,0000,,!كانت ابن أسو كيجي، أسو سيجي
Dialogue: 0,0:42:58.61,0:43:00.68,Default,,0000,0000,0000,,!مـ-محال
Dialogue: 0,0:43:01.10,0:43:04.99,Default,,0000,0000,0000,,أساي هو اسم عائلته المتبناة غالباً
Dialogue: 0,0:43:05.93,0:43:09.79,Default,,0000,0000,0000,,كان كلّ هذا انتقاماً لأبيه إذاً
Dialogue: 0,0:43:10.35,0:43:12.09,Default,,0000,0000,0000,,!سيدي المفتش! اختفى المجرم
Dialogue: 0,0:43:12.17,0:43:12.89,Default,,0000,0000,0000,,!ماذا؟
Dialogue: 0,0:43:12.89,0:43:14.50,Default,,0000,0000,0000,,!ابحثوا عنه
Dialogue: 0,0:43:15.35,0:43:16.43,Default,,0000,0000,0000,,إنّه هناك
Dialogue: 0,0:43:16.43,0:43:19.92,Default,,0000,0000,0000,,المكان الذي يوجد فيه البيانو الذي\N!تبرع به أسو كيجي، المركز الاجتماعي
Dialogue: 0,0:43:28.01,0:43:31.03,Default,,0000,0000,0000,,انتهى الأمر يا أبي
Dialogue: 0,0:43:32.89,0:43:34.44,Default,,0000,0000,0000,,!لم ينته بعد
Dialogue: 0,0:43:34.80,0:43:36.28,Default,,0000,0000,0000,,!انظر لهذه
Dialogue: 0,0:43:37.35,0:43:40.33,Default,,0000,0000,0000,,هناك رسالة لك في القطعة الموسيقية التي تركها والدك
Dialogue: 0,0:43:40.80,0:43:44.09,Default,,0000,0000,0000,,!يقول أنّه يريدك أن تعيش حياةً صالحة
Dialogue: 0,0:43:44.85,0:43:47.37,Default,,0000,0000,0000,,أتمنى لو عرفت ذلك أبكر
Dialogue: 0,0:43:47.93,0:43:51.88,Default,,0000,0000,0000,,لم تقرأها؟ كيف عرفت ما حلّ بأبيك إذاً؟
Dialogue: 0,0:43:52.76,0:43:56.64,Default,,0000,0000,0000,,راودتني الشكوك باستمرار عن أبي بالتبني
Dialogue: 0,0:43:56.64,0:43:58.14,Default,,0000,0000,0000,,،فبعد تخرجي من كلية الطب
Dialogue: 0,0:43:58.14,0:44:00.84,Default,,0000,0000,0000,,أتيتُ لهذه الجزيرة كطبيبة
Dialogue: 0,0:44:02.14,0:44:06.60,Default,,0000,0000,0000,,فنطق اسمي ليس مكتوباً على رخصتي الطبية
Dialogue: 0,0:44:07.68,0:44:11.01,Default,,0000,0000,0000,,لكني كنت متوتراً عندما بدؤوا الاستجواب
Dialogue: 0,0:44:11.01,0:44:12.68,Default,,0000,0000,0000,,كانوا ليكتشفوا أنّي ذكر
Dialogue: 0,0:44:13.10,0:44:17.18,Default,,0000,0000,0000,,هكذا إذاً، لذا بقيت معنا تلك الليلة
Dialogue: 0,0:44:17.18,0:44:20.09,Default,,0000,0000,0000,,كي تؤجل استجوابك للنهاية
Dialogue: 0,0:44:20.68,0:44:25.55,Default,,0000,0000,0000,,عندما أخبرت العمدة السابق كامياما أنّي ابن أسو
Dialogue: 0,0:44:25.55,0:44:28.48,Default,,0000,0000,0000,,هلع فجأةً وأفصح لي عن كلّ شيء
Dialogue: 0,0:44:28.48,0:44:31.46,Default,,0000,0000,0000,,وفارق الحياة بعدها بنوبة قلبية
Dialogue: 0,0:44:32.51,0:44:37.68,Default,,0000,0000,0000,,،وعندما عزفت مقطوعة أبي المفضلة، ضوء القمر\Nكلحن وداع له
Dialogue: 0,0:44:37.68,0:44:40.20,Default,,0000,0000,0000,,خطرت لي فكرة هذه الجرائم
Dialogue: 0,0:44:42.80,0:44:45.05,Default,,0000,0000,0000,,!لنخرج يا سيجي! لا يزال بإمكاننا النجاة
Dialogue: 0,0:44:45.05,0:44:47.20,Default,,0000,0000,0000,,فات الأوان لي
Dialogue: 0,0:44:48.18,0:44:53.08,Default,,0000,0000,0000,,فيداي ملطّختان بالدم مثل أولئك الأربعة
Dialogue: 0,0:44:58.35,0:44:59.43,Default,,0000,0000,0000,,!كونان-كن
Dialogue: 0,0:44:59.43,0:45:00.11,Default,,0000,0000,0000,,!تبّاً
Dialogue: 0,0:45:00.11,0:45:00.97,Default,,0000,0000,0000,,!كلا
Dialogue: 0,0:45:00.97,0:45:02.20,Default,,0000,0000,0000,,!دعيني
Dialogue: 0,0:45:03.76,0:45:06.89,Default,,0000,0000,0000,,ما هذا الصوت؟
Dialogue: 0,0:45:06.89,0:45:08.78,Default,,0000,0000,0000,,إنّها الشفرة
Dialogue: 0,0:45:09.10,0:45:13.75,Default,,0000,0000,0000,,إنّه يعزف، بين ألسنة النار
Dialogue: 0,0:45:23.35,0:45:27.30,Default,,0000,0000,0000,,افتقد موراساوا-سان عازف البيانو أسو كيجي
Dialogue: 0,0:45:27.30,0:45:29.74,Default,,0000,0000,0000,,فكان يضبط البيانو خاصته من حين لآخر وفقما يبدو
Dialogue: 0,0:45:30.55,0:45:32.60,Default,,0000,0000,0000,,في ليلة تعرضه للاعتداء أيضاً
Dialogue: 0,0:45:34.47,0:45:37.60,Default,,0000,0000,0000,,لمَ أرسل لنا الطبيب نارومي تحذيراً عن الجرائم؟
Dialogue: 0,0:45:38.68,0:45:41.81,Default,,0000,0000,0000,,ربما كانت رسالة تحدّي لأبي
Dialogue: 0,0:45:42.35,0:45:46.10,Default,,0000,0000,0000,,أظنّه أراد أن يوقفه أحد عن القتل
Dialogue: 0,0:45:46.10,0:45:50.64,Default,,0000,0000,0000,,أخبرني، ما تحليل الشفرة التي عزفها الطبيب نارومي؟
Dialogue: 0,0:45:50.64,0:45:52.58,Default,,0000,0000,0000,,نسيت ذلك
Dialogue: 0,0:45:52.58,0:45:55.36,Default,,0000,0000,0000,,!تعابيرك لا توحي بذلك
Dialogue: 0,0:45:57.93,0:46:07.76,Title,,0000,0000,0010,,{\fad(0,500)}شكراً لك أيّها المتحري الصغير
Dialogue: 0,0:47:42.89,0:47:45.05,Default,,0000,0000,0000,,أيمكن أنّ السيارة التي صعدتها أيومي-تشان
Dialogue: 0,0:47:45.05,0:47:47.47,Default,,0000,0000,0000,,!هي لمجرمي اختطاف الفتيات وقتلهن؟
Dialogue: 0,0:47:49.01,0:47:51.67,Default,,0000,0000,0000,,!انتظري يا أيومي-تشان! سنأتي لإنقاذك فوراً
Dialogue: 0,0:47:51.90,0:47:53.39,Default,,0000,0000,0000,,في الحلقة القادمة من كونان
Dialogue: 0,0:47:53.39,0:47:55.20,Default,,0000,0000,0000,,اختطاف أيومي-تشان
Dialogue: 0,0:47:59.05,0:48:01.39,Default,,0000,0000,0000,,تلميح الحلقة القادمة
Dialogue: 0,0:48:01.39,0:48:02.91,Default,,0000,0000,0000,,مهرجان مدرسيّ
Dialogue: 0,0:48:02.91,0:48:04.91,Default,,0000,0000,0000,,
