Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS \NX : @Theconansign
Dialogue: 0,0:00:01.20,0:00:03.48,Default,,0,0,0,,أتيت لشكري على ذلك؟
Dialogue: 0,0:00:03.75,0:00:07.42,Default,,0,0,0,,.لم يكن عليك فعل ذلك. كان بإمكانك الاتصال فحسب
Dialogue: 0,0:00:07.42,0:00:09.49,Default,,0,0,0,,.لم أستطع فعل ذلك
Dialogue: 0,0:00:09.49,0:00:12.15,Default,,0,0,0,,.المحقق تاكاغي مخلص في عمله
Dialogue: 0,0:00:12.15,0:00:14.49,Default,,0,0,0,,.هذه إحدى نقاط قوته
Dialogue: 0,0:00:19.05,0:00:20.34,Default,,0,0,0,,ما الأمر، تشيبا؟
Dialogue: 0,0:00:20.34,0:00:22.88,Default,,0,0,0,,.لقد تلقينا للتو مكالمة لك
Dialogue: 0,0:00:24.46,0:00:26.87,Default,,0,0,0,,.فهمت، شكرًا لك
Dialogue: 0,0:00:29.22,0:00:30.72,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:00:30.72,0:00:35.58,Default,,0,0,0,,.يبدو أن رجلًا يدعى بوتشي حاول الاتصال بي
Dialogue: 0,0:00:35.58,0:00:39.54,Default,,0,0,0,,يريد رد جميل قديم بمعلومات مثيرة
Dialogue: 0,0:00:39.54,0:00:42.25,Default,,0,0,0,,.لذا يريد مني مقابلته في حديقة تودوروكي
Dialogue: 0,0:00:42.25,0:00:45.48,Default,,0,0,0,,.أتساءل من يكون بوتشي، مع ذلك
Dialogue: 0,0:00:46.11,0:00:48.24,Default,,0,0,0,,.ستعرفه بمجرد أن تقابله
Dialogue: 0,0:00:50.73,0:00:52.99,Default,,0,0,0,,ألم يحضر بعد؟
Dialogue: 0,0:01:05.00,0:01:07.51,Default,,0,0,0,,.إنه ميت بالفعل
Dialogue: 0,0:01:11.79,0:01:14.01,Default,,0,0,0,,.إيوابوتشي كاتسويا
Dialogue: 0,0:01:14.68,0:01:18.14,Default,,0,0,0,,أيمكن أن يكون هذا هو "بوتشي" الذي اتصل بي؟
Dialogue: 0,0:01:18.50,0:01:20.77,Default,,0,0,0,,ألا يذكرك وجهه بشيء؟
Dialogue: 0,0:01:29.89,0:01:32.24,Default,,0,0,0,,ماذا تخفي وراء ذلك الوجه المحطم؟
Dialogue: 0,0:01:32.24,0:01:33.99,Default,,0,0,0,,.رجل يرد جميلًا لا يتذكره تاكاغي
Dialogue: 0,0:01:33.99,0:01:36.51,Default,,0,0,0,,!هذا لا يمنعه من فعل الصواب
Dialogue: 0,0:01:36.51,0:01:38.09,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:01:38.09,0:01:39.91,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:01:39.91,0:01:42.50,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:03:24.23,0:03:26.60,Default,,0,0,0,,"!بوتشي يرد الجميل"
Dialogue: 0,0:03:36.28,0:03:42.08,Default,,0,0,0,,.إذن هذا السيد إيوابوتشي كاتسويا حاول تقديم معلومات لتاكاغي
Dialogue: 0,0:03:42.08,0:03:45.93,Default,,0,0,0,,...وشخص ما لم يرد حدوث ذلك أخرسه
Dialogue: 0,0:03:45.93,0:03:52.42,Default,,0,0,0,,.رغم أنه من الممكن أن لا علاقة له بالمعلومات، إلا أن هذا يبدو محتملًا
Dialogue: 0,0:03:53.92,0:03:57.26,Default,,0,0,0,,ما هي تلك المعلومات بالضبط؟
Dialogue: 0,0:03:57.26,0:04:00.43,Default,,0,0,0,,.إذا اكتشفنا ذلك، قد يساعدنا في تحديد الجاني
Dialogue: 0,0:04:01.00,0:04:02.93,Default,,0,0,0,,.كان هذا على الأرجح
Dialogue: 0,0:04:03.36,0:04:05.43,Default,,0,0,0,,.هذه الورقة كانت في جيبه
Dialogue: 0,0:04:05.43,0:04:08.69,Default,,0,0,0,,.الـ13؟ هذا غدًا
Dialogue: 0,0:04:09.05,0:04:13.83,Default,,0,0,0,,ربما هناك مؤامرة لثلاثة يستخدمون رذاذ الدب
Dialogue: 0,0:04:13.83,0:04:19.82,Default,,0,0,0,,.لسرق متجر كاميو للمجوهرات في كاميوداي في العاشرة صباح الغد
Dialogue: 0,0:04:20.24,0:04:25.63,Default,,0,0,0,,.السيد يابوتشي ذكر كاميوداي على الهاتف، لذا يبدو الأمر محتملًا
Dialogue: 0,0:04:25.63,0:04:27.72,Default,,0,0,0,,...في كاميوداي
Dialogue: 0,0:04:27.72,0:04:32.21,Default,,0,0,0,,.في الحقيقة، أفضل إخبار السيد تاكاغي وجهًا لوجه
Dialogue: 0,0:04:32.21,0:04:37.02,Default,,0,0,0,,الجاني، على الأرجح قائد المجموعة
Dialogue: 0,0:04:37.02,0:04:41.40,Default,,0,0,0,,لم يتوقع أن يكتب السيد إيوابوتشي تلك الورقة
Dialogue: 0,0:04:41.40,0:04:45.47,Default,,0,0,0,,.لذا اعتقدوا أن قتله سيكون كافيًا
Dialogue: 0,0:04:50.42,0:04:53.50,Default,,0,0,0,,.أنا آسف لأنني لا أتذكرك، يا سيد بوتشي
Dialogue: 0,0:04:53.50,0:04:55.86,Default,,0,0,0,,.لكن أعدك أنني سأقبض على الجاني
Dialogue: 0,0:04:56.14,0:04:59.36,Default,,0,0,0,,.سأعين ضباطًا لهذا التحقيق في جريمة القتل
Dialogue: 0,0:04:59.36,0:05:03.37,Default,,0,0,0,,.الجاني سيظهر في كاميوداي غدًا
Dialogue: 0,0:05:03.37,0:05:07.12,Default,,0,0,0,,لكن لا يمكننا الانتظار فقط حتى يحدث هذا، أليس كذلك؟
Dialogue: 0,0:05:12.19,0:05:17.25,Default,,0,0,0,,...تحقيق الأمس لم يسفر عن شيء، لكن إذا نصبنا كمينًا هنا
Dialogue: 0,0:05:17.95,0:05:19.26,Default,,0,0,0,,.حان الوقت تقريبًا
Dialogue: 0,0:05:21.51,0:05:26.39,Default,,0,0,0,,.السيد إيوابوتشي زودنا بمعلومات قيمة على حساب حياته
Dialogue: 0,0:05:26.39,0:05:27.89,Default,,0,0,0,,.لن نهدر ذلك
Dialogue: 0,0:05:28.43,0:05:30.89,Default,,0,0,0,,.سنوقف السرقة قبل أن تحدث
Dialogue: 0,0:05:30.89,0:05:33.40,Default,,0,0,0,,.وسنقبض على الجناة
Dialogue: 0,0:05:41.89,0:05:44.41,Default,,0,0,0,,لماذا لم يظهروا؟
Dialogue: 0,0:05:44.90,0:05:46.41,Default,,0,0,0,,!ماذا قلت؟
Dialogue: 0,0:05:46.79,0:05:53.04,Default,,0,0,0,,متجر مجوهرات في مدينة تسوروي سرق... من قبل ثلاثة رجال يحملون رذاذ دب؟
Dialogue: 0,0:05:53.30,0:05:54.54,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:05:55.25,0:05:57.54,Default,,0,0,0,,.هذه الطريقة المذكورة في الورقة
Dialogue: 0,0:05:57.91,0:06:02.55,Default,,0,0,0,,.لكن مدينة تسوروي وكاميوداي في اتجاهين متعاكسين
Dialogue: 0,0:06:02.55,0:06:05.55,Default,,0,0,0,,.معلومات بوتشي كانت خاطئة
Dialogue: 0,0:06:05.55,0:06:08.18,Default,,0,0,0,,.على أي حال، يجب أن نذهب إلى هناك
Dialogue: 0,0:06:09.06,0:06:10.17,Default,,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:06:10.17,0:06:11.18,Default,,0,0,0,,!نعم
Dialogue: 0,0:06:11.18,0:06:13.10,Default,,0,0,0,,هل تم خداعكم حقًا بمعلومات كاذبة
Dialogue: 0,0:06:13.10,0:06:16.69,Default,,0,0,0,,لحراسة متجر مجوهرات مختلف تمامًا؟
Dialogue: 0,0:06:18.14,0:06:20.57,Default,,0,0,0,,متجر في الجهة المقابلة من المدينة في كاميوداي؟
Dialogue: 0,0:06:20.57,0:06:24.45,Default,,0,0,0,,.يبدو أن الجناة كانوا يسخرون من الشرطة
Dialogue: 0,0:06:24.92,0:06:27.45,Default,,0,0,0,,كيف عرفت الصحافة عن كاميوداي؟
Dialogue: 0,0:06:27.72,0:06:31.45,Default,,0,0,0,,.كل وسيلة إخبارية تلقت معلومات مجهولة المصدر
Dialogue: 0,0:06:32.75,0:06:34.46,Default,,0,0,0,,.إذن هكذا يكون الأمر
Dialogue: 0,0:06:34.85,0:06:36.96,Default,,0,0,0,,.سنقدم تعليقًا لاحقًا
Dialogue: 0,0:06:40.31,0:06:43.47,Default,,0,0,0,,.الجناة هم من أعطوا تلك المعلومات
Dialogue: 0,0:06:45.43,0:06:49.25,Default,,0,0,0,,لقد علموا بالورقة
Dialogue: 0,0:06:49.25,0:06:55.53,Default,,0,0,0,,وتعمدوا تركها لكي نشاهد المتجر في كاميوداي
Dialogue: 0,0:06:55.53,0:07:01.48,Default,,0,0,0,,.بينما غيروا خططهم بسرعة لسرقة متجر المجوهرات هذا في مدينة تسوروي
Dialogue: 0,0:07:03.49,0:07:07.39,Default,,0,0,0,,لم ينجحوا فقط في سرقة المتجر
Dialogue: 0,0:07:07.39,0:07:13.12,Default,,0,0,0,,.بل وبإعلام الصحافة، جعلوا الشرطة محط سخرية
Dialogue: 0,0:07:13.41,0:07:17.34,Default,,0,0,0,,ألا تظن أن هذا مبالغ فيه لتغيير الخطط، مع ذلك؟
Dialogue: 0,0:07:17.34,0:07:23.88,Default,,0,0,0,,.متجر المجوهرات في كاميوداي كان من الدرجة الأولى، لكن هذا المتجر ليس كذلك، حقًا
Dialogue: 0,0:07:24.32,0:07:26.11,Default,,0,0,0,,...انت محق
Dialogue: 0,0:07:26.84,0:07:28.75,Default,,0,0,0,,.لهذا اختاروه
Dialogue: 0,0:07:28.75,0:07:31.08,Default,,0,0,0,,.المتاجر الرخيصة لها أمن متراخ
Dialogue: 0,0:07:31.08,0:07:32.64,Default,,0,0,0,,.يسهل سرقتها
Dialogue: 0,0:07:32.64,0:07:37.27,Default,,0,0,0,,.ربما كذلك، لكن المجوهرات لا يمكن أن تكون قيمتها كبيرة أيضًا
Dialogue: 0,0:07:37.27,0:07:40.27,Default,,0,0,0,,.سننقسم لتحديد هوية الجناة
Dialogue: 0,0:07:40.65,0:07:44.53,Default,,0,0,0,,.تشيبا، تحقق في سرقة متجر تسوروي للمجوهرات
Dialogue: 0,0:07:44.80,0:07:49.55,Default,,0,0,0,,.تاكاغي، أعد التحقيق بدقة في جريمة قتل السيد إيوابوتشي كاتسويا
Dialogue: 0,0:07:52.39,0:07:55.27,Default,,0,0,0,,.يجب أن أكون قادرًا على إيجاد شيء
Dialogue: 0,0:07:55.27,0:07:58.91,Default,,0,0,0,,.لا بد أن هناك صلة بين السيد إيوابوتشي والجناة
Dialogue: 0,0:07:58.91,0:08:00.92,Default,,0,0,0,,.نحن متورطون بالفعل
Dialogue: 0,0:08:00.92,0:08:03.57,Default,,0,0,0,,.من الأفضل أن نجد طريقة لنكون مفيدين
Dialogue: 0,0:08:06.55,0:08:10.55,Default,,0,0,0,,.يا سيد كاميغاموري، سمعت أنك كنت قريبًا من السيد إيوابوتشي
Dialogue: 0,0:08:10.93,0:08:17.74,Default,,0,0,0,,{\an8}.لا أعرف إذا كان هذا مرتبطًا، لكن منذ نصف شهر، كان بوتشي مرتعبًا
Dialogue: 0,0:08:17.74,0:08:20.44,Default,,0,0,0,,{\an8}.قال إن أحدًا ما يبحث عنه
Dialogue: 0,0:08:20.72,0:08:24.57,Default,,0,0,0,,السيد إيوابوتشي كان مرتعبًا لأن أحدًا ما كان يبحث عنه؟
Dialogue: 0,0:08:24.57,0:08:26.81,Default,,0,0,0,,.كان يهرب من الجناة
Dialogue: 0,0:08:27.39,0:08:32.76,Default,,0,0,0,,.إذن لكان أعطاني المعلومات منذ أسابيع
Dialogue: 0,0:08:32.76,0:08:34.95,Default,,0,0,0,,.لا بد أنها غير مرتبطة، إذن
Dialogue: 0,0:08:37.45,0:08:40.14,Default,,0,0,0,,أيها الضابط، كيف عرفت بوتشي؟
Dialogue: 0,0:08:40.95,0:08:47.46,Default,,0,0,0,,.كان يكره الشرطة منذ أن أُخطئ التعرف عليه كسارق دراجة العام الماضي
Dialogue: 0,0:08:47.46,0:08:49.34,Default,,0,0,0,,كان يكره الشرطة؟
Dialogue: 0,0:08:49.34,0:08:52.29,Default,,0,0,0,,.أعتقد أن تاكاغي كان مميزًا
Dialogue: 0,0:08:53.19,0:08:55.20,Default,,0,0,0,,.كان يرد جميلاً
Dialogue: 0,0:08:55.20,0:08:58.85,Default,,0,0,0,,.أتساءل ماذا فعلت من أجله
Dialogue: 0,0:09:07.93,0:09:12.36,Default,,0,0,0,,السيد إيوابوتشي كان يقترض منك المال؟
Dialogue: 0,0:09:12.36,0:09:14.08,Default,,0,0,0,,أهذه إقرار دين؟
Dialogue: 0,0:09:14.08,0:09:18.50,Default,,0,0,0,,.قلت أنه ليس ضروريًا لأنه كان 30 ألف فقط
Dialogue: 0,0:09:18.50,0:09:20.42,Default,,0,0,0,,.لا بد أنه كان شريفاً
Dialogue: 0,0:09:21.80,0:09:22.92,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:09:24.47,0:09:25.57,Default,,0,0,0,,نعم؟
Dialogue: 0,0:09:26.00,0:09:27.87,Default,,0,0,0,,.فهمت
Dialogue: 0,0:09:27.87,0:09:32.63,Default,,0,0,0,,.تم التعرف على شخصين مشبوهين من تقارير المواطنين
Dialogue: 0,0:09:33.43,0:09:38.91,Default,,0,0,0,,{\an8}إذن أنتما لا تعرفان شيئًا عن جريمة القتل
Dialogue: 0,0:09:38.91,0:09:43.60,Default,,0,0,0,,{\an8}لكنكما تعترفان بسرقة متجر تسوروي للمجوهرات
Dialogue: 0,0:09:43.60,0:09:46.90,Default,,0,0,0,,{\an8}السيد ناكاتاكي جون والأنسة كومي مينايو؟
Dialogue: 0,0:09:47.28,0:09:49.35,Default,,0,0,0,,.سمعنا أن المال جيد
Dialogue: 0,0:09:49.35,0:09:51.65,Default,,0,0,0,,.لذا انضممنا إلى العمل المشبوه
Dialogue: 0,0:09:52.35,0:09:54.66,Default,,0,0,0,,ماذا لو انضم بوتشي أيضًا؟
Dialogue: 0,0:09:55.91,0:09:59.77,Default,,0,0,0,,.ربما لم يعلم بالسرقة بالصدفة
Dialogue: 0,0:09:59.77,0:10:03.79,Default,,0,0,0,,.ربما ذهب متخفيًا للتحقيق في مؤامرة إجرامية
Dialogue: 0,0:10:04.14,0:10:06.52,Default,,0,0,0,,...إنه ليس مستحيلاً، لكن
Dialogue: 0,0:10:06.90,0:10:09.30,Default,,0,0,0,,من هو زعيمكم الذي جندكم؟
Dialogue: 0,0:10:09.30,0:10:10.88,Default,,0,0,0,,.لا نعرف
Dialogue: 0,0:10:10.88,0:10:12.99,Default,,0,0,0,,."قالوا فقط أنهم "الملوك
Dialogue: 0,0:10:12.99,0:10:17.93,Default,,0,0,0,,ألم يخبروكم حتى أي سيارة تستخدمون في السرقة؟
Dialogue: 0,0:10:18.44,0:10:21.68,Default,,0,0,0,,.كان رجلاً قاسيًا يبلغ قرابة الأربعين
Dialogue: 0,0:10:22.25,0:10:25.44,Default,,0,0,0,,.قال إنه خرج من السجن منذ نصف شهر
Dialogue: 0,0:10:32.67,0:10:33.70,Default,,0,0,0,,!إنه هو
Dialogue: 0,0:10:36.44,0:10:38.33,Default,,0,0,0,,!دايماستو ماسايوشي
Dialogue: 0,0:10:38.65,0:10:40.50,Default,,0,0,0,,هل تعرفه؟
Dialogue: 0,0:10:40.50,0:10:43.83,Default,,0,0,0,,.قبل أربع سنوات، سرق متجر رهونات
Dialogue: 0,0:10:43.83,0:10:49.09,Default,,0,0,0,,{\an8}.قبضت عليه بناءً على معلومات مجهولة المصدر
Dialogue: 0,0:10:49.09,0:10:51.03,Default,,0,0,0,,أنت فعلت؟
Dialogue: 0,0:10:51.03,0:10:54.15,Default,,0,0,0,,.افعل ما بوسعك للعثور على مخبئه
Dialogue: 0,0:10:54.15,0:10:58.51,Default,,0,0,0,,.سأضع كل مركز في المدينة في حالة استنفار للبحث عن دايماستو ماسايوشي
Dialogue: 0,0:10:59.10,0:11:02.94,Default,,0,0,0,,يا موري، حتى متى ستبقى هنا؟
Dialogue: 0,0:11:02.94,0:11:06.15,Default,,0,0,0,,.هذه جريمة قتل وسرقة بسيطة
Dialogue: 0,0:11:06.15,0:11:09.61,Default,,0,0,0,,!لا توجد ألغاز ليحلها محقق هذه المرة
Dialogue: 0,0:11:10.34,0:11:11.73,Default,,0,0,0,,.بالتأكيد
Dialogue: 0,0:11:13.59,0:11:15.11,Default,,0,0,0,,.اعذرنا
Dialogue: 0,0:11:15.11,0:11:18.62,Default,,0,0,0,,...بخصوص أدلتنا على دايماستو ماسايوشي
Dialogue: 0,0:11:23.84,0:11:25.80,Default,,0,0,0,,لماذا، أيها المفتش؟
Dialogue: 0,0:11:26.33,0:11:27.72,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:11:28.13,0:11:30.14,Default,,0,0,0,,!ظننت أنك غادرت
Dialogue: 0,0:11:30.14,0:11:32.38,Default,,0,0,0,,.إنه يتصرف بشكل مختلف عن المعتاد
Dialogue: 0,0:11:33.44,0:11:37.40,Default,,0,0,0,,الليلة الماضية، أخبر رئيس القسم أنه بنصب الكمين في كاميوداي
Dialogue: 0,0:11:37.40,0:11:43.64,Default,,0,0,0,,يمكنه إيقاف السرقة وحل جريمة قتل السيد إيوابوتشي
Dialogue: 0,0:11:43.64,0:11:46.02,Default,,0,0,0,,.لكن لم يحدث أي من ذلك
Dialogue: 0,0:11:46.02,0:11:49.02,Default,,0,0,0,,.لذلك تعرّض المفتش للإحراج
Dialogue: 0,0:11:49.32,0:11:53.02,Default,,0,0,0,,.ولم يرد منا أن ندرك كم يشعر بالإحباط
Dialogue: 0,0:11:53.41,0:11:56.72,Default,,0,0,0,,.إذن من الأفضل أن نحل القضية بسرعة
Dialogue: 0,0:11:56.72,0:11:59.03,Default,,0,0,0,,إذن أنت تتبعني مرة أخرى؟
Dialogue: 0,0:11:59.03,0:12:02.03,Default,,0,0,0,,.كما قلت، نحن متورطون بالفعل
Dialogue: 0,0:12:02.03,0:12:04.76,Default,,0,0,0,,.هذا ما قلته أنا، في الواقع
Dialogue: 0,0:12:04.76,0:12:08.20,Default,,0,0,0,,.هناك الكثير من الغرائب في هذه القضية
Dialogue: 0,0:12:13.49,0:12:16.51,Default,,0,0,0,,أين س يذهب دايماستو؟
Dialogue: 0,0:12:16.51,0:12:21.97,Default,,0,0,0,,{\an8}.يا سيد كيدو، سمعت أنك كنت قريبًا من السيد دايماستو في السجن
Dialogue: 0,0:12:23.01,0:12:24.06,Default,,0,0,0,,.ربما المستشفى
Dialogue: 0,0:12:24.40,0:12:26.56,Default,,0,0,0,,سيد دايماستو مريض؟
Dialogue: 0,0:12:26.89,0:12:29.79,Default,,0,0,0,,...لا، لكنه قال أحيانًا
Dialogue: 0,0:12:30.22,0:12:32.56,Default,,0,0,0,,!هذا الوغد
Dialogue: 0,0:12:32.85,0:12:38.82,Default,,0,0,0,,.أثناء هروبه من الضابط الذي قبض عليه قبل أربع سنوات، كسر ساقه
Dialogue: 0,0:12:38.82,0:12:41.82,Default,,0,0,0,,وهذه الإصابة القديمة لا تزال تؤلمه؟
Dialogue: 0,0:12:44.66,0:12:46.65,Default,,0,0,0,,.نال ما يستحق
Dialogue: 0,0:12:46.65,0:12:49.83,Default,,0,0,0,,.لست متأكدًا من أنه سيزور مستشفى الآن
Dialogue: 0,0:12:52.82,0:12:54.84,Default,,0,0,0,,إلى أين نحن ذاهبون بعد ذلك؟
Dialogue: 0,0:12:56.31,0:12:57.43,Default,,0,0,0,,!لا تزال؟
Dialogue: 0,0:12:57.43,0:12:58.88,Default,,0,0,0,,.لا تقلق
Dialogue: 0,0:12:58.88,0:13:03.93,Default,,0,0,0,,إذا قال المفتش أي شيء، سنقول أنك طلبت مساعدتنا. أليس كذلك؟
Dialogue: 0,0:13:03.93,0:13:05.15,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:05.15,0:13:07.40,Default,,0,0,0,,ما خطب هذه القضية؟
Dialogue: 0,0:13:07.91,0:13:12.36,Default,,0,0,0,,المفتش ميغوري قال إنها قضية بسيطة بدون ألغاز لحلها
Dialogue: 0,0:13:12.36,0:13:14.71,Default,,0,0,0,,.لكن كل شيء يبدو غريبًا جدًا
Dialogue: 0,0:13:14.71,0:13:17.55,Default,,0,0,0,,.أولاً، هناك بوتشي، ضحية القتل
Dialogue: 0,0:13:17.55,0:13:22.86,Default,,0,0,0,,.تغلب على كرهه للشرطة ليقدم معلومات للمحقق تاكاغي
Dialogue: 0,0:13:22.86,0:13:25.37,Default,,0,0,0,,.إيوابوتشي كاتسويا
Dialogue: 0,0:13:26.11,0:13:29.50,Default,,0,0,0,,أيمكن أن يكون هذا هو "بوتشي" الذي اتصل بي؟
Dialogue: 0,0:13:29.79,0:13:32.25,Default,,0,0,0,,ألا يذكرك وجهه بشيء؟
Dialogue: 0,0:13:32.63,0:13:34.48,Default,,0,0,0,,.كان يرد جميلاً
Dialogue: 0,0:13:34.87,0:13:38.19,Default,,0,0,0,,.أتساءل ماذا فعلت من أجله
Dialogue: 0,0:13:39.15,0:13:43.10,Default,,0,0,0,,لماذا لا يستطيع المحقق تاكاغي تذكر أي شيء عنه؟
Dialogue: 0,0:13:43.49,0:13:45.51,Default,,0,0,0,,.ثم، هناك الجاني
Dialogue: 0,0:13:46.72,0:13:48.52,Default,,0,0,0,,!دايماستو ماسايوشي
Dialogue: 0,0:13:49.10,0:13:52.43,Default,,0,0,0,,.لديه تاريخ مع المفتش ميغوري
Dialogue: 0,0:13:52.43,0:13:55.12,Default,,0,0,0,,المحقق تاكاغي يعمل تحت إمرة المفتش ميغوري
Dialogue: 0,0:13:55.12,0:13:57.52,Default,,0,0,0,,لذا الأربعة مرتبطون
Dialogue: 0,0:13:57.52,0:13:59.46,Default,,0,0,0,,لكن هل هذه صدفة؟
Dialogue: 0,0:14:00.49,0:14:02.40,Default,,0,0,0,,أهذه حقًا صدفة أيضًا؟
Dialogue: 0,0:14:02.69,0:14:06.91,Default,,0,0,0,,.منذ نصف شهر، كان بوتشي مرتعبًا
Dialogue: 0,0:14:07.21,0:14:09.92,Default,,0,0,0,,.قال إن أحدًا ما يبحث عنه
Dialogue: 0,0:14:10.29,0:14:14.04,Default,,0,0,0,,...والجاني، دايماستو ماسايوشي
Dialogue: 0,0:14:14.67,0:14:17.79,Default,,0,0,0,,.قال إنه خرج من السجن منذ نصف شهر
Dialogue: 0,0:14:17.79,0:14:20.03,Default,,0,0,0,,...هل هذا يعني
Dialogue: 0,0:14:20.51,0:14:23.15,Default,,0,0,0,,لكن لماذا كان مرتعبًا؟
Dialogue: 0,0:14:23.85,0:14:25.05,Default,,0,0,0,,أيمكن أن يكون؟
Dialogue: 0,0:14:25.55,0:14:28.92,Default,,0,0,0,,.قبل أربع سنوات، سرق متجر رهونات
Dialogue: 0,0:14:28.92,0:14:33.81,Default,,0,0,0,,.قبضت عليه بناءً على معلومات مجهولة المصدر
Dialogue: 0,0:14:33.81,0:14:35.44,Default,,0,0,0,,...في هذه الحالة
Dialogue: 0,0:14:35.44,0:14:37.48,Default,,0,0,0,,!هذا الوغد
Dialogue: 0,0:14:38.39,0:14:39.58,Default,,0,0,0,,...هل قصد
Dialogue: 0,0:14:40.22,0:14:42.74,Default,,0,0,0,,لكن كيف يرتبط هذا بهذه القضية؟
Dialogue: 0,0:14:43.25,0:14:45.27,Default,,0,0,0,,.إذن هكذا هو الأمر
Dialogue: 0,0:14:45.27,0:14:48.05,Default,,0,0,0,,.كل شيء كان مُخططًا له من البداية
Dialogue: 0,0:14:48.05,0:14:50.67,Default,,0,0,0,,.لا عجب أن المحقق تاكاغي لا يستطيع التذكر
Dialogue: 0,0:14:50.67,0:14:52.35,Default,,0,0,0,,.هذه هي الثغرة في الخطة
Dialogue: 0,0:14:52.83,0:14:54.81,Default,,0,0,0,,.لا بد أنه كان شريفاً
Dialogue: 0,0:14:56.11,0:14:59.96,Default,,0,0,0,,.هذا يفسر أيضًا لماذا سرقوا ذلك المتجر
Dialogue: 0,0:15:01.96,0:15:04.56,Default,,0,0,0,,.كل ذلك كان لتحقيق ذلك الهدف
Dialogue: 0,0:15:05.08,0:15:07.34,Default,,0,0,0,,إنه أنا. أين أنت، يا عمي؟
Dialogue: 0,0:15:11.23,0:15:14.42,Default,,0,0,0,,...مرحبًا، يا عمي. هذه القضية
Dialogue: 0,0:15:15.35,0:15:16.86,Default,,0,0,0,,نعم؟
Dialogue: 0,0:15:16.86,0:15:19.74,Default,,0,0,0,,وجدتم مخبأ دايماستو ماسايوشي؟
Dialogue: 0,0:15:27.18,0:15:33.33,Default,,0,0,0,,.لم تتعلم الدرس يا دايماستو. سرقت متجر مجوهرات آخر في مدينة تسوروي
Dialogue: 0,0:15:33.33,0:15:35.00,Default,,0,0,0,,.هذا خبر جديد بالنسبة لي
Dialogue: 0,0:15:35.00,0:15:39.10,Default,,0,0,0,,.إذا كنت بريئًا، قدم عينة شعر
Dialogue: 0,0:15:39.10,0:15:41.13,Default,,0,0,0,,.سنرى إذا كانت متطابقة
Dialogue: 0,0:15:42.88,0:15:45.63,Default,,0,0,0,,.قبضنا بالفعل على شريكيك
Dialogue: 0,0:15:46.06,0:15:51.64,Default,,0,0,0,,.تم جمع عدة أنواع من الشعر من داخل السيارة المستخدمة في السرقة
Dialogue: 0,0:15:51.64,0:15:54.65,Default,,0,0,0,,ربما حصل الجاني على شعري
Dialogue: 0,0:15:54.65,0:15:59.52,Default,,0,0,0,,.ووضعه في السيارة ليتهمني
Dialogue: 0,0:15:59.52,0:16:04.53,Default,,0,0,0,,.لقد جندت شركاء لعمل مشبوه
Dialogue: 0,0:16:06.03,0:16:11.05,Default,,0,0,0,,.بوتشي "السيد إيوابوتشي كاتسويا" حقق أيضًا
Dialogue: 0,0:16:11.05,0:16:15.56,Default,,0,0,0,,.اكتشف خطتك ليخبرني عنها
Dialogue: 0,0:16:15.56,0:16:19.66,Default,,0,0,0,,.عندما اكتشفت ذلك، قتلت بوتشي
Dialogue: 0,0:16:20.17,0:16:24.87,Default,,0,0,0,,...وعندما اكتشفت ورقة السيد إيوابوتشي
Dialogue: 0,0:16:27.28,0:16:28.47,Default,,0,0,0,,موري؟
Dialogue: 0,0:16:31.47,0:16:34.60,Default,,0,0,0,,.أخبرتك، لا نحتاج محققًا هذه المرة
Dialogue: 0,0:16:34.96,0:16:40.57,Default,,0,0,0,,سرقة متجر المجوهرات لم تكن مهمة، أليس كذلك، يا سيد دايماستو ماسايوشي؟
Dialogue: 0,0:16:40.57,0:16:45.04,Default,,0,0,0,,: هدفك كان الانتقام من الرجلين اللذين تكرههما
Dialogue: 0,0:16:45.46,0:16:49.36,Default,,0,0,0,,.السيد إيوابوتشي كاتسويا والمفتش ميغوري
Dialogue: 0,0:16:50.86,0:16:52.37,Default,,0,0,0,,انتقام؟
Dialogue: 0,0:16:52.37,0:16:54.87,Default,,0,0,0,,عليّ وعلى السيد إيوابوتشي؟
Dialogue: 0,0:16:55.20,0:17:00.87,Default,,0,0,0,,.والسيد إيوابوتشي لم يحاول أبدًا رد جميل، يا تاكاغي
Dialogue: 0,0:17:00.87,0:17:02.50,Default,,0,0,0,,...لكن
Dialogue: 0,0:17:02.83,0:17:05.25,Default,,0,0,0,,...لكن المكالمة
Dialogue: 0,0:17:05.63,0:17:10.81,Default,,0,0,0,,.رجل يكره الشرطة لن يقدم معلومات أبدًا
Dialogue: 0,0:17:11.25,0:17:17.86,Default,,0,0,0,,.رغم أنه قدم معلومات مجهولة المصدر قبل أربع سنوات قبل أن يكرههم
Dialogue: 0,0:17:18.37,0:17:20.52,Default,,0,0,0,,أليس هذا صحيحًا، يا سيد دايماستو؟
Dialogue: 0,0:17:20.85,0:17:23.27,Default,,0,0,0,,.يبدو أنك تعرف كل شيء
Dialogue: 0,0:17:23.61,0:17:25.75,Default,,0,0,0,,.ما عدا شيء واحد
Dialogue: 0,0:17:25.75,0:17:29.28,Default,,0,0,0,,كيف عرف أنك أنت قبل أربع سنوات؟
Dialogue: 0,0:17:29.28,0:17:33.68,Default,,0,0,0,,انتقل لاحقًا لأنه خاف أن ننتقم
Dialogue: 0,0:17:33.68,0:17:37.41,Default,,0,0,0,,.لكن في ذلك الوقت، كنا جيران
Dialogue: 0,0:17:37.41,0:17:40.17,Default,,0,0,0,,.كنا نكره بعضنا
Dialogue: 0,0:17:40.17,0:17:44.42,Default,,0,0,0,,...ظننت أنني نجوت من سرقة متجر الرهونات، لكن
Dialogue: 0,0:17:51.79,0:17:57.76,Default,,0,0,0,,ظهر هذا المفتش ميغوري بعد ذلك بوقت قصير
Dialogue: 0,0:17:57.76,0:18:01.18,Default,,0,0,0,,!لذا لا بد أنه أبلغ الشرطة
Dialogue: 0,0:18:01.18,0:18:03.19,Default,,0,0,0,,.إذن هذا ما حدث
Dialogue: 0,0:18:03.48,0:18:08.19,Default,,0,0,0,,السيد إيوابوتشي هو من أبلغ بالمعلومات المجهولة قبل أربع سنوات؟
Dialogue: 0,0:18:08.54,0:18:12.20,Default,,0,0,0,,!ارجوك تحقق في ذلك الرجل دايماستو
Dialogue: 0,0:18:12.92,0:18:17.48,Default,,0,0,0,,.إذن لا بد أن دايماستو فكر في الأمر لفترة طويلة
Dialogue: 0,0:18:17.48,0:18:20.14,Default,,0,0,0,,!هذا الوغد! والآخر أيضًا
Dialogue: 0,0:18:20.14,0:18:24.69,Default,,0,0,0,,كيف يجعل المفتش ميغوري يحتفظ بهدوئه لاعتقاله
Dialogue: 0,0:18:24.69,0:18:27.92,Default,,0,0,0,,.وكيف يقتل السيد إيوابوتشي لتسببه في اعتقاله
Dialogue: 0,0:18:28.44,0:18:32.80,Default,,0,0,0,,: لذا جاء بخطته ضد المفتش
Dialogue: 0,0:18:32.80,0:18:37.60,Default,,0,0,0,,.استخدام مؤامرة إجرامية مزيفة ليجعله يرتكب خطأ فادح
Dialogue: 0,0:18:37.88,0:18:41.85,Default,,0,0,0,,مؤامرة إجرامية مزيفة؟ أيمكن أن يكون؟
Dialogue: 0,0:18:42.26,0:18:48.19,Default,,0,0,0,,.نعم. هو لم ينوي سرقة متجر كاميو للمجوهرات أبدًا
Dialogue: 0,0:18:48.73,0:18:52.20,Default,,0,0,0,,لكي يفشل المفتش
Dialogue: 0,0:18:52.20,0:18:56.10,Default,,0,0,0,,.احتاج فقط لإقناع الشرطة أن تلك كانت الخطة
Dialogue: 0,0:18:56.10,0:19:02.25,Default,,0,0,0,,.لهذا، اخترع قصة خيالية عن بوشي يرد يرد جميلاً
Dialogue: 0,0:19:02.86,0:19:04.75,Default,,0,0,0,,قصة خيالية؟
Dialogue: 0,0:19:05.01,0:19:07.21,Default,,0,0,0,,.استخدم ذلك أمس
Dialogue: 0,0:19:07.21,0:19:10.58,Default,,0,0,0,,تتبع السيد إيوابوتشي، وقتله
Dialogue: 0,0:19:10.58,0:19:15.51,Default,,0,0,0,,.وترك الورقة ذات الخطة المزيفة على جثته
Dialogue: 0,0:19:15.88,0:19:17.48,Default,,0,0,0,,.اسمي بوتشي
Dialogue: 0,0:19:18.18,0:19:20.83,Default,,0,0,0,,السيد تاكاغي ليس موجودًا؟
Dialogue: 0,0:19:21.26,0:19:25.29,Default,,0,0,0,,.أود رد جميل قديم بمعلومات مثيرة
Dialogue: 0,0:19:25.29,0:19:27.40,Default,,0,0,0,,...في كاميوداي
Dialogue: 0,0:19:27.81,0:19:31.53,Default,,0,0,0,,بعد التأكد من غياب المحقق تاكاغي
Dialogue: 0,0:19:31.53,0:19:37.36,Default,,0,0,0,,اتصل باسم بوتشي، مقودًا لاكتشافنا جثة السيد إيوابوتشي
Dialogue: 0,0:19:36.10,0:19:37.36,Default,,0,0,0,,.لهذا، اخترع قصة خيالية عن بوتشي يرد جميلاً
Dialogue: 0,0:19:37.36,0:19:40.13,Default,,0,0,0,,.بالإضافة إلى وصول الورقة إلى المفتش
Dialogue: 0,0:19:41.03,0:19:47.34,Default,,0,0,0,,.لا أحد يشك في معلومات من رجل بذل حياته لتقديمها
Dialogue: 0,0:19:48.02,0:19:53.27,Default,,0,0,0,,بمعنى آخر، دايماستو لم يقتل السيد إيوابوتشي فقط لأنه يكرهه
Dialogue: 0,0:19:53.27,0:20:00.43,Default,,0,0,0,,.بل أيضًا لاستخدام جثته لإعطاء مصداقية لخطة السرقة المزيفة
Dialogue: 0,0:20:00.81,0:20:06.89,Default,,0,0,0,,الغرض من سرقة متجر تسوروي للمجوهرات كان السرقة نفسها
Dialogue: 0,0:20:06.89,0:20:10.38,Default,,0,0,0,,.لأنها في الجهة المقابلة من المدينة عن كاميوداي
Dialogue: 0,0:20:11.22,0:20:16.92,Default,,0,0,0,,بما أنه لم يكن يريد المجوهرات، اختار ذلك المتجر لأمنه المتراخي؟
Dialogue: 0,0:20:17.30,0:20:22.26,Default,,0,0,0,,الليلة الماضية، أخبرت رئيسي بنصب الكمين في كاميوداي
Dialogue: 0,0:20:22.26,0:20:27.33,Default,,0,0,0,,.يمكنني حل كل شيء. هكذا تعرضت للإحراج
Dialogue: 0,0:20:27.33,0:20:30.21,Default,,0,0,0,,كنت تعلم أن هذا سيحدث، أليس كذلك؟
Dialogue: 0,0:20:30.21,0:20:34.86,Default,,0,0,0,,.بالطبع، وكنت تكبّت غضبك كما رغبت بالضبط
Dialogue: 0,0:20:35.32,0:20:41.84,Default,,0,0,0,,لكن كيف عرفت أن إيوابوتشي لم يجري المكالمة أو يكتب الورقة؟
Dialogue: 0,0:20:41.84,0:20:46.10,Default,,0,0,0,,.علمت أن المكالمة يجب أن تكون مزيفة إذا كانت الورقة مزيفة
Dialogue: 0,0:20:46.41,0:20:50.09,Default,,0,0,0,,!لكنني نسخت خط يده في الورقة
Dialogue: 0,0:20:50.09,0:20:51.93,Default,,0,0,0,,.لم تكن هذه هي المشكلة
Dialogue: 0,0:20:51.93,0:20:54.48,Default,,0,0,0,,.حرف "كامي" كان مكتوبًا بشكل صحيح
Dialogue: 0,0:20:58.49,0:21:00.80,Default,,0,0,0,,.ولكنه فشل
Dialogue: 0,0:21:01.22,0:21:03.49,Default,,0,0,0,,.لقد تذكره بشكل خاطئ، كما ترى
Dialogue: 0,0:21:06.49,0:21:11.89,Default,,0,0,0,,...يجب أن أحتفل بانتصاري، لكن لأن هذا المحقق ظهر
Dialogue: 0,0:21:12.87,0:21:16.56,Default,,0,0,0,,.الشرطة هي التي وجدتك، أيها الجاني
Dialogue: 0,0:21:16.95,0:21:20.51,Default,,0,0,0,,.أنا فقط حللت اللغز
Dialogue: 0,0:21:22.89,0:21:27.48,Default,,0,0,0,,اخترت تاكاغي لأنه بدا الأكثر ترجيحًا
Dialogue: 0,0:21:27.48,0:21:31.52,Default,,0,0,0,,.أن يكون مستحقًا لجميل من بين أتباع المفتش
Dialogue: 0,0:21:31.52,0:21:34.25,Default,,0,0,0,,.لا عجب أنني لم أستطع التذكر
Dialogue: 0,0:21:34.25,0:21:36.44,Default,,0,0,0,,.لم نلتقِ أبدًا
Dialogue: 0,0:21:37.04,0:21:39.50,Default,,0,0,0,,.لكنني ما زلت أشعر بالأسف لبوتشي
Dialogue: 0,0:21:39.50,0:21:43.91,Default,,0,0,0,,.حتى بعد قتله، تم استخدامه في هذه المؤامرة
Dialogue: 0,0:21:45.91,0:21:49.58,Default,,0,0,0,,.تعال معنا، يا سيد دايماستو ماسايوشي
Dialogue: 0,0:21:52.12,0:21:53.57,Default,,0,0,0,,.أحسنت عملاً
Dialogue: 0,0:23:18.59,0:23:22.17,Default,,0,0,0,,.ليس من الشائع أن يزعج الناس أنفسهم برد الجميل
Dialogue: 0,0:23:22.17,0:23:24.76,Default,,0,0,0,,ألم يحدث لك هذا أبدًا يا عمي؟
Dialogue: 0,0:23:25.35,0:23:28.30,Default,,0,0,0,,...لا تكن أحمق. لدي عدد لا يحصى
Dialogue: 0,0:23:28.30,0:23:30.35,Default,,0,0,0,,.لا أستطيع تذكر أي منها
Dialogue: 0,0:23:30.98,0:23:32.88,Default,,0,0,0,,.هذا محزن بعض الشيء
Dialogue: 0,0:23:33.56,0:23:34.99,Default,,0,0,0,,.افعلها
Dialogue: 0,0:23:34.99,0:23:38.44,Default,,0,0,0,,.أنت ستوفي. أعد الجميل الذي تدين به لي. هيا
Dialogue: 0,0:23:40.33,0:23:44.99,Default,,0,0,0,,...أهذا حقًا شيء من المفترض أن تطلبه
Dialogue: 0,0:23:48.18,0:23:49.37,Default,,0,0,0,,!إنه هو
Dialogue: 0,0:23:49.80,0:23:51.87,Default,,0,0,0,,.لا أستطيع رؤية وجهه
Dialogue: 0,0:23:52.28,0:23:54.87,Default,,0,0,0,,أأنتم أطفال تتلصصون على شخص ما؟
Dialogue: 0,0:23:54.87,0:23:57.12,Default,,0,0,0,,.يا له من مكان محزن
Dialogue: 0,0:23:57.12,0:24:02.50,Default,,0,0,0,,.علموا أين يحاصرونهم ليبدو الأمر كحادث
Dialogue: 0,0:24:04.26,0:24:05.59,Default,,0,0,0,,!تبا
Dialogue: 0,0:24:09.79,0:24:13.88,Default,,0,0,0,,"!الحلقة القادمة من كونان هي "اقبض على ذلك الوجه
Dialogue: 0,0:24:30.32,0:24:32.60,Default,,0,0,0,,!تلميح كونان القادم
Dialogue: 0,0:24:32.60,0:24:34.95,Default,,0,0,0,,!حلوى التاكوياكي
Dialogue: 0,0:24:34.95,0:24:37.95,Default,,0,0,0,,{\an8}.لا تتردد في رد الجميل لي لسماحي لك بالإقامة معنا مجانًا
Dialogue: 0,0:24:37.95,0:24:39.92,Default,,0,0,0,,{\an8}...يمكنني قول الشيء نفسه
