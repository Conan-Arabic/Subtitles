Dialogue: 0,0:24:34.91,0:24:40.00,Don'tMiss,TEXT,0,0,0,,{\shad0\bord5\3c&HF3F6F2&\2c&HEAEEE7&\3a&H28&\c&HFEFEFE&\fscx73\fscy97\pos(614.822,637.111)}لا تفوّتوا مشاهدة الحلقة القادمة
Dialogue: 0,0:24:34.91,0:24:40.00,Don'tMiss,TEXT,0,0,0,,{\shad1.15\4c&H141615&\3c&H010202&\fscx73\fscy97\pos(614.822,637.111)}لا تفوّتوا مشاهدة الحلقة القادمة
Dialogue: 0,0:00:01.88,0:00:04.98,DCMain,CONAN,0,0,0,,،تمكنا من حل قضيتي القتل التي وقعتا معًا في الوقت نفسه مصادفةً
Dialogue: 0,0:00:06.09,0:00:09.19,DCMain,CONAN,0,0,0,,وقد أُقيمت محاضرة العم على خير ما يُرام
Dialogue: 0,0:00:10.10,0:00:16.24,DCMain,CONAN,0,0,0,,ضيفة الحدث كيساكي إيري، وباقي من سيظهر على المسرح كانوا على وشك البدء
Dialogue: 0,0:00:17.06,0:00:23.41,DCMain,CONAN,0,0,0,,..إلا أن ثمة ضيف مُفاجئ ظهر في اللحظة الأخيرة
Dialogue: 0,0:00:24.54,0:00:25.86,DCMain,MEI,0,0,0,,أنا تسكوبا مي
Dialogue: 0,0:00:26.75,0:00:28.27,DCMain,MEI,0,0,0,,!يُشرفني العمل معكم
Dialogue: 0,0:02:32.63,0:02:34.05,DCMain,MEI,0,0,0,,أنا تسكوبا مي
Dialogue: 0,0:02:34.05,0:02:35.64,DCMain,MEI,0,0,0,,!يُشرفني العمل معكم
Dialogue: 0,0:02:39.53,0:02:42.24,DCMain,RAN,0,0,0,,ستظهرين على المسرح أيضًا؟
Dialogue: 0,0:02:42.24,0:02:43.06,DCMain,MEI,0,0,0,,أجل
Dialogue: 0,0:02:43.06,0:02:47.02,DCMain,MEI,0,0,0,,فأنا فعليًا أُدرس علم النفس الجنائي في الجامعة
Dialogue: 0,0:02:48.14,0:02:49.26,DCMain,HIABARA,0,0,0,,لهذا السبب إذًا
Dialogue: 0,0:02:49.26,0:02:50.64,DCMain,CONAN,0,0,0,,فهمت
Dialogue: 0,0:02:51.01,0:02:54.54,DCMain,MEI,0,0,0,,طلبتُ من الرئيس والمدير أن يسمحا لي باعتلاء المسرح
Dialogue: 0,0:02:54.54,0:02:57.15,DCMain,MEI,0,0,0,,إذ أنه على ما يبدو أن عدد الضيوف قد قل
Dialogue: 0,0:02:57.50,0:02:59.61,DCMain,UJIMORI,0,0,0,,{\an8}ما رأيك، يا موري-سينسي؟
Dialogue: 0,0:02:59.61,0:03:02.58,DCMain,UJIMORI,0,0,0,,،آسف على هذا التغيير الاضطراري
Dialogue: 0,0:03:02.58,0:03:04.76,DCMain,UJIMORI,0,0,0,,،لكن بصفتي منظم الفعالية
Dialogue: 0,0:03:04.76,0:03:09.36,DCMain,UJIMORI,0,0,0,,سأبذل كل ما بوسعي لأُبدّد تلك الشائعات التي ستنتشر عن الجريمتين
Dialogue: 0,0:03:10.43,0:03:12.67,DCMain,TSUNOHAZU,0,0,0,,كيساكي-سينسي، ما رأيك؟
Dialogue: 0,0:03:14.81,0:03:16.51,DCMain,ERI,0,0,0,,يبدو مثيرًا للاهتمام
Dialogue: 0,0:03:16.51,0:03:18.55,DCMain,ERI,0,0,0,,لا أمانع إطلاقًا
Dialogue: 0,0:03:21.33,0:03:24.16,DCMain,KOGORO,0,0,0,,!حسنًا، اسأليني كما يحلو لك
Dialogue: 0,0:03:24.16,0:03:27.68,DCMain,KOGORO,0,0,0,,..فأنا أعظم المحققين
Dialogue: 0,0:03:27.68,0:03:30.42,DCMain,KOGORO,0,0,0,,موري كوغورو، سأكشف كل أسراري
Dialogue: 0,0:03:32.94,0:03:34.81,DCMain,MEI,0,0,0,,!شكرًا لك
Dialogue: 0,0:03:34.81,0:03:36.46,DCMain,UJIMORI,0,0,0,,!إذًا لنستعد
Dialogue: 0,0:03:36.94,0:03:38.19,DCMain,TSUNOHAZU,0,0,0,,حسنًا
Dialogue: 0,0:03:39.22,0:03:40.99,DCMain,AMAGI,0,0,0,,{\an8}!تفضلي يا سيدتي
Dialogue: 0,0:03:40.99,0:03:44.05,DCMain,ERI,0,0,0,,{\an8}!شكرًا لك \N هل لي بكوب قهوة؟
Dialogue: 0,0:03:44.05,0:03:45.51,DCMain,FURUI,0,0,0,,بالطبع، على الفور
Dialogue: 0,0:03:51.48,0:03:52.96,DCMain,ERI,0,0,0,,ما هذا؟
Dialogue: 0,0:03:54.32,0:03:55.96,DCMain,AMAGI,0,0,0,,!معذرةً
Dialogue: 0,0:03:57.57,0:04:02.78,DCMain,AMAGI,0,0,0,,غريب لم تكن هذه البقايا من الأوراق هنا حينما نظفتُ سابقًا
Dialogue: 0,0:04:04.52,0:04:05.36,DCMain,CONAN,0,0,0,,!انتظر
Dialogue: 0,0:04:05.36,0:04:06.17,DCMain,HAIBARA,0,0,0,,!لا ترمِها
Dialogue: 0,0:04:06.17,0:04:06.86,DCMain,AMAGI,0,0,0,,ماذا؟
Dialogue: 0,0:04:10.23,0:04:11.97,DCMain,RIKA,0,0,0,,{\an8}شكرًا لانتظاركم
Dialogue: 0,0:04:11.97,0:04:16.05,DCMain,RIKA,0,0,0,,{\an8}حانت الآن فقرتنا التالية
Dialogue: 0,0:04:16.05,0:04:18.86,DCMain,RIKA,0,0,0,,بسبب ظروف معينة، غيرنا كليًا المحتوى المقرر للحدث
Dialogue: 0,0:04:19.80,0:04:24.59,DCMain,RIKA,0,0,0,,ماهية أسرار المحقق العظيم؟" \N"!استفسارات بطلة جديدة
Dialogue: 0,0:04:24.59,0:04:26.64,DCMain,RIKA,0,0,0,,هو عنوان فقرتنا التالية
Dialogue: 0,0:04:27.29,0:04:29.93,DCMain,RIKA,0,0,0,,..دعوني أُقدم لكم ضيوف فقرتنا هذه
Dialogue: 0,0:04:29.93,0:04:33.14,DCMain,RIKA,0,0,0,,،أولهم الرجل الذي أمتعنا بقصصه الشيقة
Dialogue: 0,0:04:33.14,0:04:35.37,DCMain,RIKA,0,0,0,,المحقق العظيم، موري كوغورو
Dialogue: 0,0:04:37.59,0:04:38.35,DCMain,KOGORO,0,0,0,,!شكرًا
Dialogue: 0,0:04:39.23,0:04:42.76,DCMain,RIKA,0,0,0,,ثانيًا، المحامية كيساكي إيري-سينسي
Dialogue: 0,0:04:43.62,0:04:45.09,DCMain,ERI,0,0,0,,!مرحبًا
Dialogue: 0,0:04:45.09,0:04:50.49,DCMain,RIKA,0,0,0,,!نأمل سماع آرائك ذات اللمحة القانونية
Dialogue: 0,0:04:50.49,0:04:51.89,DCMain,ERI,0,0,0,,يسعدني ذلك
Dialogue: 0,0:04:52.23,0:04:54.39,DCMain,RAN,0,0,0,,!أبي، أمي
Dialogue: 0,0:04:54.62,0:04:57.76,DCMain,RIKA,0,0,0,,وأخيرًا، ممثلتنا نحن كضيفة خاصة
Dialogue: 0,0:04:57.76,0:05:01.68,DCMain,RIKA,0,0,0,,،فتاة من جيل المحققين الجُدد
Dialogue: 0,0:05:01.68,0:05:06.41,DCMain,RIKA,0,0,0,,وطالبة علم النفس الجنائي، تسوكابا مي-سان
Dialogue: 0,0:05:07.80,0:05:09.41,DCMain,MEI,0,0,0,,!مرحبًا
Dialogue: 0,0:05:13.19,0:05:16.92,DCMain,HAIBARA,0,0,0,,!يُفترض أن المباراة انتهت الآن، إلا إذا لعبوا أشواطًا إضافية
Dialogue: 0,0:05:17.29,0:05:19.93,DCMain,CONAN,0,0,0,,..حسنًا، الخطوة التالية هي
Dialogue: 0,0:05:22.23,0:05:24.42,DCMain,MITSUHIKO,0,0,0,,!كانت مباراة مذهلة
Dialogue: 0,0:05:24.42,0:05:29.30,DCMain,GENTA,0,0,0,,ظننتُ أنهم سيلعبون شوطين إضافيين، إلا أنهم عادوا بضربة رأسية
Dialogue: 0,0:05:29.60,0:05:31.05,DCMain,GENTA,0,0,0,,!كم كانت رائعة
Dialogue: 0,0:05:33.31,0:05:37.57,DCMain,AYUMI,0,0,0,,لكن كونان-كن، وآي-تشان لم يظهرا للآن
Dialogue: 0,0:05:37.57,0:05:38.60,DCMain,AYUMI,0,0,0,,أتساءل ما السبب؟
Dialogue: 0,0:05:38.77,0:05:42.11,DCMain,MITSUHIKO,0,0,0,,أصبتِ، ولم يتصلا بنا حتى
Dialogue: 0,0:05:43.21,0:05:47.11,DCMain,GENTA,0,0,0,,!إذًا سوف يدعواننا إلى أطباق الإنقليس
Dialogue: 0,0:05:49.42,0:05:50.37,DCMain,GENTA,0,0,0,,ماذا؟ لا
Dialogue: 0,0:05:56.97,0:05:59.17,DCMain,CONAN,0,0,0,,كنا بانتظاركم يا فريق المحققين الصغار
Dialogue: 0,0:05:59.17,0:06:00.63,DCMain,AYUMI,0,0,0,,كونان-كن، آي-تشان
Dialogue: 0,0:06:00.83,0:06:02.38,DCMain,MITSUHIKO,0,0,0,,ما الذي يجري؟
Dialogue: 0,0:06:02.38,0:06:06.18,DCMain,MITSUIHKO,0,0,0,,أحقيقي ما يُشاع حول وقوع جريمتي قتل هنا؟
Dialogue: 0,0:06:06.18,0:06:09.35,DCMain,GENTA,0,0,0,,!بناءً على إجابتكما، فقد تصبحان مدينَين لنا بوجبات لحم ضخمة
Dialogue: 0,0:06:09.35,0:06:12.06,DCMain,HAIBARA,0,0,0,,!اهدؤوا فحسب، ولنتحدث بالداخل
Dialogue: 0,0:06:16.86,0:06:21.05,DCMain,CONAN,0,0,0,,!عثرنا على مثل هذه في ثلاثة أماكن مختلفة
Dialogue: 0,0:06:21.05,0:06:25.42,DCMain,CONAN,0,0,0,,اثنتان منهم كانتا في مسرح الجريمة والأخرى كانت في غرفة تغيير الملابس الخاصة بـكيساكي-سان
Dialogue: 0,0:06:26.31,0:06:28.64,DCMain,AYUMI,0,0,0,,والدة ران؟
Dialogue: 0,0:06:28.64,0:06:30.28,DCMain,GENTA,0,0,0,,ماذا يعني هذا يا تُرى؟
Dialogue: 0,0:06:30.52,0:06:33.24,DCMain,HAIBARA,0,0,0,,من المرجح أنها إما رسالة من نوع ما أو شفرة
Dialogue: 0,0:06:33.24,0:06:34.28,DCMain,MITSUHIKO,0,0,0,,شفرة؟
Dialogue: 0,0:06:34.59,0:06:38.38,DCMain,CONAN,0,0,0,,مما يعني أنه لا بد من وجود دفتر شفرات لحلها
Dialogue: 0,0:06:38.38,0:06:39.79,DCMain,AYUMI,0,0,0,,دفتر شفرات؟
Dialogue: 0,0:06:38.38,0:06:39.79,Code,AYUMI,0,0,0,,{\an8\fs40\fnBahij Janna}توضيح: دفتر الشفرات هو نوع من المستندات المستخدمة في تجميع وتخزين الرموز\N غالبًا ما تكون دفاتر الشفرات في الأصل عبارة عن كتب، لكن حاليًا يعد دفتر الشفرات مثالًا لسجل شامل لسلسلة من الكلمات، بغض النظر عن التنسيق الفعلي
Dialogue: 0,0:06:39.79,0:06:41.36,DCMain,MITSUHIKO,0,0,0,,..أعرفه
Dialogue: 0,0:06:41.36,0:06:44.54,DCMain,MITSUHIKO,0,0,0,,إنه كتاب لمجموعة قواعد متعلقة بحروف وجمل
Dialogue: 0,0:06:44.54,0:06:49.06,DCMain,MITSUHIKO,0,0,0,,تظهر مرتبة بشكل عشوائي يبين كيفية إعادة ترتيبها وفقًا لقواعد معينة
Dialogue: 0,0:06:49.06,0:06:52.46,DCMain,MITSUHIKO,0,0,0,,وإذا قمنا بحذف مقاطع معينة نحصل على رسائل ذات معانٍ ما، صحيح؟
Dialogue: 0,0:06:52.46,0:06:53.80,DCMain,HAIBARA,0,0,0,,صحيح
Dialogue: 0,0:06:54.15,0:06:56.06,DCMain,GENTA,0,0,0,,لم أفهم شيئًا
Dialogue: 0,0:06:56.31,0:07:01.80,DCMain,MITSUHIKO,0,0,0,,على سيبل المثال، إن كانت قائمة الوجبات الخاصة بمطعم الأسماك المفضلة لدى غيتنا-كن دفتر شفرات
Dialogue: 0,0:07:01.80,0:07:05.44,DCMain,MITSUHIKO,0,0,0,,إذًا، لو قمنا بحذف كلمة "أوناجييو = أطباق السمك" فقط
Dialogue: 0,0:07:05.44,0:07:08.82,DCMain,MITSUHIKO,0,0,0,,..أو "كيموسوي = حساء الكبد" من جملة تظهر عشوائيًا
Dialogue: 0,0:07:08.82,0:07:10.26,DCMain,AYUMI,0,0,0,,فهمت
Dialogue: 0,0:07:10.26,0:07:14.08,DCMain,GENTA,0,0,0,,بمعنًى آخر، يجدر بنا العثور على قائمة مطعم السمك
Dialogue: 0,0:07:14.08,0:07:15.41,DCMain,GENTA,0,0,0,,!اعتمدوا علي
Dialogue: 0,0:07:15.41,0:07:17.08,DCMain,BOTH,0,0,0,,!كلا
Dialogue: 0,0:07:17.43,0:07:20.33,DCMain,HAIBARA,0,0,0,,نحن نبحث عن المجلة التي اقتُطعت منها هذه الصفحات
Dialogue: 0,0:07:20.84,0:07:23.33,DCMain,HAIBARA,0,0,0,,لا بد أنها في مكان مكشوف
Dialogue: 0,0:07:23.75,0:07:25.09,DCMain,MITSUHIKO,0,0,0,,لماذا؟
Dialogue: 0,0:07:25.39,0:07:27.76,DCMain,CONAN,0,0,0,,!إنها قصة يطول شرحها
Dialogue: 0,0:07:27.76,0:07:31.52,DCMain,CONAN,0,0,0,,إن لم نسرع؛ أُحس أن شيئًا مريعًا سيحصل
Dialogue: 0,0:07:31.52,0:07:33.09,DCMain,CONAN,0,0,0,,!لذا، لنعثر على المجلة أولًا
Dialogue: 0,0:07:33.38,0:07:34.66,DCMain,MITSUHIKO,0,0,0,,!عُلم
Dialogue: 0,0:07:34.66,0:07:36.59,DCMain,AYUMI,0,0,0,,سيتولى فريق المحققين الصغار القضية
Dialogue: 0,0:07:36.59,0:07:39.73,DCMain,GENTA,0,0,0,,!حسنًا، رغم أني لستُ مُلمًّا بما يجري جيدًا، لكن لنقم بهذا
Dialogue: 0,0:07:39.99,0:07:41.73,DCMain,ALL,0,0,0,,!أجل
Dialogue: 0,0:07:52.89,0:07:56.62,DCMain,RIKA,0,0,0,,تاليًا، الفتاة التي من جيل المحققين الجدد تسوكابا مي-سان
Dialogue: 0,0:07:57.17,0:08:00.51,DCMain,RIKA,0,0,0,,يبدو أن لديك بعض التساؤلات للمحقق النائم كوغورو
Dialogue: 0,0:08:00.51,0:08:02.01,DCMain,MEI,0,0,0,,!أجل
Dialogue: 0,0:08:02.50,0:08:05.96,DCMain,MEI,0,0,0,,..سألتني صديقتي عن جريمة قتل
Dialogue: 0,0:08:05.96,0:08:10.63,DCMain,MEI,0,0,0,,وقعت في كلية ما منذ عام
Dialogue: 0,0:08:10.95,0:08:11.76,DCMain,ERI,0,0,0,,ماذا؟
Dialogue: 0,0:08:11.96,0:08:15.37,DCMain,KOGORI,0,0,0,,!حسنًا، أعطيني التفاصيل
Dialogue: 0,0:08:15.37,0:08:16.26,DCMain,MEI,0,0,0,,حسنًا
Dialogue: 0,0:08:19.81,0:08:22.66,DCMain,MEI,0,0,0,,كانت الضحية أستاذًا جامعيًا في الكلية
Dialogue: 0,0:08:22.66,0:08:26.12,DCMain,MEI,0,0,0,,وقد ألقت الشرطة القبض على مساعد الأستاذ الجامعي
Dialogue: 0,0:08:26.12,0:08:28.45,DCMain,MEI,0,0,0,,والذي كان شقيق صديقتي تلك أيضًا
Dialogue: 0,0:08:28.45,0:08:33.28,DCMain,MEI,0,0,0,,{\an8}دافعه كان ادعاء الأستاذ الجامعي أنه سرق ورقة تخصصه
Dialogue: 0,0:08:33.28,0:08:36.03,DCMain,MEI,0,0,0,,{\an8}وهدده بأنه سوف يشوّه سمعته المهنية
Dialogue: 0,0:08:36.30,0:08:38.03,DCMain,ERI,0,0,0,,..أنتِ
Dialogue: 0,0:08:38.23,0:08:39.03,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:08:39.03,0:08:40.24,DCMain,ERI,0,0,0,,لا شيء
Dialogue: 0,0:08:40.24,0:08:43.46,DCMain,KOGORO,0,0,0,,بالتفكير في الأمر، أجل حدث ذلك فعلًا
Dialogue: 0,0:08:43.46,0:08:48.40,DCMain,KOGORO,0,0,0,,اعترف المتهم، وحُكم عليه في المحكمة
Dialogue: 0,0:08:48.40,0:08:50.55,DCMain,KOGORO,0,0,0,,لا أعتقد أن ثمة أي مشكلة في القضية
Dialogue: 0,0:08:50.55,0:08:52.03,DCMain,MEI,0,0,0,,!بل هناك مشكلة فيها
Dialogue: 0,0:08:52.64,0:08:54.42,DCMain,MITSUHIKO,0,0,0,,!عثرتُ عليها! ها هي
Dialogue: 0,0:08:54.93,0:08:56.96,DCMain,MITSUHIKO,0,0,0,,!انظروا
Dialogue: 0,0:09:01.49,0:09:03.18,DCMain,CONAN,0,0,0,,لا شك أنها المجلة ذاتها فعلًا
Dialogue: 0,0:09:03.58,0:09:04.86,DCMain,HAIBARA,0,0,0,,كيسويك" = حدث الأسبوع؟"
Dialogue: 0,0:09:04.86,0:09:06.94,DCMain,MITSUHIKO,0,0,0,,كيسويك؟
Dialogue: 0,0:09:06.94,0:09:10.19,DCMain,MITSUIHKO,0,0,0,,هذه مجلة أخبار أمريكية شهيرة
Dialogue: 0,0:09:10.48,0:09:12.94,DCMain,GENTA,0,0,0,,لكنها باللغة اليابانية
Dialogue: 0,0:09:12.94,0:09:15.21,DCMain,AYUMI,0,0,0,,أيعني ذلك أنها النسخة اليابانية؟
Dialogue: 0,0:09:15.21,0:09:17.20,DCMain,CONAN,0,0,0,,..الطبعة الأمريكية والطبعة اليابانية
Dialogue: 0,0:09:18.28,0:09:20.48,DCMain,CONAN,0,0,0,,...الإنجليزية واليابانية
Dialogue: 0,0:09:23.89,0:09:26.21,DCItalic,CONAN,0,0,0,,فهمت، هكذا إذًا
Dialogue: 0,0:09:26.43,0:09:28.19,DCMain,CONAN,0,0,0,,!حللتُ الشفرة
Dialogue: 0,0:09:28.19,0:09:29.64,DCMain,MITSUHIKO,0,0,0,,حقًا؟
Dialogue: 0,0:09:29.64,0:09:32.08,DCMain,HAIBARA,0,0,0,,!حسنًا، انظروا هنا
Dialogue: 0,0:09:37.96,0:09:39.97,DCMain,HAIBARA,0,0,0,,!أنصتوا جيدًا
Dialogue: 0,0:09:38.46,0:09:39.97,DCItalic,MEI,0,0,0,,!ثمة مشكلة كبيرة
Dialogue: 0,0:09:40.31,0:09:42.08,DCItalic,KOGORO,0,0,0,,مشكلة كبيرة؟
Dialogue: 0,0:09:42.08,0:09:43.41,DCItalic,MEI,0,0,0,,أجل
Dialogue: 0,0:09:43.41,0:09:46.48,DCItalic,MEI,0,0,0,,جريمة قتل الأستاذ الجامعي لم تنتهِ بعد
Dialogue: 0,0:09:46.97,0:09:50.86,DCItalic,MEI,0,0,0,,لا شك أن آشيدا هيروتو المسجون الآن، هو المجرم فعلًا
Dialogue: 0,0:09:52.05,0:09:53.73,DCMain,MEI,0,0,0,,حتى وفقًا لاستنتاجي
Dialogue: 0,0:09:54.11,0:09:58.64,DCMain,MEI,0,0,0,,لكن صديقتي يصعب عليها تصديق أنه سرق بحث أحدهم
Dialogue: 0,0:09:58.64,0:10:03.74,DCMain,MEI,0,0,0,,!فما بالكم بالقتل
Dialogue: 0,0:10:04.25,0:10:07.25,DCMain,KOGORO,0,0,0,,أجل، إذًا الأمر كذلك؟
Dialogue: 0,0:10:10.01,0:10:13.25,DCMain,KOGORO,0,0,0,,تاكاغي، لدي طلب طارئ
Dialogue: 0,0:10:13.68,0:10:17.97,DCMain,MEI,0,0,0,,لكنه في النهاية لم يقدّم أي شهادة أخرى في محاكمته
Dialogue: 0,0:10:17.97,0:10:21.17,DCMain,MEI,0,0,0,,ولم تُستأنف القضية ولا مرة
Dialogue: 0,0:10:21.66,0:10:23.26,DCMain,MEI,0,0,0,,لِم فعل ذلك؟
Dialogue: 0,0:10:23.74,0:10:26.55,DCMain,MEI,0,0,0,,أريد معرفة ذلك، يا موري-سان
Dialogue: 0,0:10:26.55,0:10:27.19,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:10:28.22,0:10:30.52,DCMain,KOGORO,0,0,0,,لا أفهم ما تريدين مني القيام به
Dialogue: 0,0:10:31.16,0:10:32.79,DCMain,MEI,0,0,0,,!بالطبع
Dialogue: 0,0:10:32.79,0:10:35.03,DCMain,MEI,0,0,0,,بالتأكيد لن تفهم
Dialogue: 0,0:10:35.03,0:10:35.92,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:10:36.59,0:10:40.74,DCMain,MEI,0,0,0,,..فعلى كلٍّ، أنت محض هاوٍ لم يستطع حل الرسالة المشفرة
Dialogue: 0,0:10:40.74,0:10:42.78,DCMain,MEI,0,0,0,,!المتروكة في مسرح الجريمة
Dialogue: 0,0:10:55.40,0:10:56.88,DCMain,KOGORO,0,0,0,,أهذا صحيح، يا تاكاغي؟
Dialogue: 0,0:10:56.88,0:10:59.97,DCItalic,TAKAGI,0,0,0,,أجل، كنت محقًا يا موري-سان
Dialogue: 0,0:11:00.25,0:11:03.19,DCMain,KOGORO,0,0,0,,!فهمت، اتصل بالمفتش
Dialogue: 0,0:11:03.19,0:11:05.03,DCMain,KOGORO,0,0,0,,أبلغه بأن يعود على الفور
Dialogue: 0,0:11:05.03,0:11:07.25,DCMain,KOGORO,0,0,0,,!فالقضية لم تنتهِ بعد
Dialogue: 0,0:11:07.25,0:11:09.23,DCItalic,TAKAGI,0,0,0,,ماذا؟
Dialogue: 0,0:11:09.64,0:11:13.15,DCMain,KOGORO,0,0,0,,أيضًا، هلا قمت بشيء ما لأجلي، يا تاكاغي؟
Dialogue: 0,0:11:13.49,0:11:16.19,DCMain,MITSUIHKO,0,0,0,,إلى أين ذهب كونان-كن؟
Dialogue: 0,0:11:16.19,0:11:17.11,DCMain,HAIBARA,0,0,0,,!ها هو هناك
Dialogue: 0,0:11:17.80,0:11:19.40,DCMain,GENTA,0,0,0,,ما الأمر يا كونان؟
Dialogue: 0,0:11:20.24,0:11:21.85,DCMain,MITSUHIKO,0,0,0,,هايبرا-سان؟
Dialogue: 0,0:11:21.85,0:11:23.41,DCMain,AYUMI,0,0,0,,!مهلًا، آي-تشان
Dialogue: 0,0:11:23.98,0:11:26.41,DCMain,MEI,0,0,0,,لِم لم يقم بتقديم طلب استئناف؟
Dialogue: 0,0:11:26.68,0:11:29.91,DCMain,MEI,0,0,0,,لأنه تعرض للخيانة، وفقد الأمل
Dialogue: 0,0:11:30.44,0:11:33.04,DCMain,KOGORO,0,0,0,,تعرض للخيانة؟ من قِبل مَن؟
Dialogue: 0,0:11:33.40,0:11:38.93,DCMain,MEI,0,0,0,,!من قِبل محاميته غير المسؤولة التي عينتها المحكمة وتركت القضية
Dialogue: 0,0:11:38.93,0:11:40.30,DCItalic,CONAN,0,0,0,,!علمتُ ذلك
Dialogue: 0,0:11:40.62,0:11:42.08,DCMain,KOGORO,0,0,0,,محاميته؟
Dialogue: 0,0:11:43.00,0:11:44.05,DCMain,KOGORO,0,0,0,,أيُعقل ذلك؟
Dialogue: 0,0:11:47.31,0:11:50.39,DCMain,ERI,0,0,0,,أجل، إنها تتحدث عني
Dialogue: 0,0:11:50.39,0:11:53.30,DCMain,ERI,0,0,0,,..وأنت هي مي-سان
Dialogue: 0,0:11:53.30,0:11:57.82,DCMain,ERI,0,0,0,,الشقيقة الصغرى للسجين آشيدا هيروتو-سان
Dialogue: 0,0:11:58.17,0:11:59.57,DCMain,KOGORO,0,0,0,,!ماذا؟
Dialogue: 0,0:12:01.00,0:12:04.53,DCMain,ERI,0,0,0,,مما يعني أنك لا تتحدثين بلسان صديقتك
Dialogue: 0,0:12:04.53,0:12:07.08,DCMain,ERI,0,0,0,,!بل تتحدّثين عن نفسك، يا مي-سان
Dialogue: 0,0:12:07.28,0:12:08.67,DCMain,MEI,0,0,0,,صحيح
Dialogue: 0,0:12:08.67,0:12:13.17,DCMain,ERI,0,0,0,,أعتقد أن تسوكوبا كان اسم والدتك قبل الزواج
Dialogue: 0,0:12:13.68,0:12:18.59,DCMain,ERI,0,0,0,,وأنتِ تدرسين علم النفس الجنائي في جامعة أمريكية
Dialogue: 0,0:12:18.90,0:12:23.11,DCMain,ERI,0,0,0,,وأذكر أنك كنت تدرسين بالخارج منذ عامين
Dialogue: 0,0:12:23.11,0:12:24.72,DCMain,ERI,0,0,0,,متى عدت؟
Dialogue: 0,0:12:25.27,0:12:26.72,DCMain,MEI,0,0,0,,منذ أسبوع
Dialogue: 0,0:12:26.92,0:12:29.38,DCMain,ERI,0,0,0,,لِم لم تتصلي بي؟
Dialogue: 0,0:12:29.38,0:12:34.15,DCMain,MEI,0,0,0,,!لأني لا أريد سماع أعذار منك
Dialogue: 0,0:12:34.15,0:12:35.35,DCMain,KOGORO,0,0,0,,!مهلًا
Dialogue: 0,0:12:35.81,0:12:37.06,DCMain,KOGORO,0,0,0,,ما الذي تقدمين على فعله؟
Dialogue: 0,0:12:45.39,0:12:49.49,DCMain,KOGORO,0,0,0,,حللت الشفرة، يا مي-سان
Dialogue: 0,0:12:49.94,0:12:52.04,DCMain,KOGORO,0,0,0,,!إياك وفعل أي شيء طائش
Dialogue: 0,0:12:52.75,0:12:53.52,DCMain,AUDIENCE,0,0,0,,!مرحى
Dialogue: 0,0:12:53.52,0:12:54.75,DCMain,AUDIENCE,0,0,0,,!ها هو نائم
Dialogue: 0,0:12:54.75,0:12:57.08,DCMain,AUDIENCE,0,0,0,,!إنه كوغورو النائم
Dialogue: 0,0:12:59.32,0:13:01.09,DCMain,RAN,0,0,0,,..أبي
Dialogue: 0,0:13:01.33,0:13:04.25,DCMain,MEI,0,0,0,,!إذًا، اشرح لي أيها المحقق
Dialogue: 0,0:13:04.25,0:13:05.73,DCMain,KOGORO,0,0,0,,!من دواعي سروري
Dialogue: 0,0:13:05.73,0:13:10.60,DCMain,KOGORO,0,0,0,,تلقيت رسالة لتوي من شخص عثر على دفتر شفرة
Dialogue: 0,0:13:11.14,0:13:15.98,DCMain,KOGORO,0,0,0,,تلك الصفحات المقطوعة من النسخة اليابانية من مجلة كيسويك
Dialogue: 0,0:13:16.20,0:13:19.32,DCMain,KOGORO,0,0,0,,،كانت الصفحات؛ 11 و9
Dialogue: 0,0:13:19.32,0:13:25.49,DCMain,KOGORO,0,0,0,,و19 و1، و11 و9 مكررة
Dialogue: 0,0:13:26.34,0:13:28.75,DCMain,KOGORO,0,0,0,,،وحين نطبق تلك الأعداد على الأبجدية
Dialogue: 0,0:13:28.75,0:13:33.06,DCMain,KOGORO,0,0,0,,K سنجد أن 11 يقابلها حرف \N I و9 يقابلها حرف \N ويُنطقان كآي
Dialogue: 0,0:13:33.49,0:13:37.12,DCMain,KOGORO,0,0,0,, S ويقابل 19 حرف \NA و1 يقابله \N وينطقان سا
Dialogue: 0,0:13:37.12,0:13:40.16,DCMain,KOGORO,0,0,0,,وأخيرًا، الشفرة الأخيرة مثل الأولى، وتنطق كآي
Dialogue: 0,0:13:40.77,0:13:41.97,DCMain,KOGORO,0,0,0,,..حينما نجمع الحروف كافة
Dialogue: 0,0:13:41.97,0:13:46.84,DCMain,KOGORO,0,0,0,,سنجدها مكونة لاسم كيساكي
Dialogue: 0,0:13:47.10,0:13:48.34,DCMain,RAN,0,0,0,,أيُعقل؟
Dialogue: 0,0:13:48.54,0:13:51.04,DCMain,ERI,0,0,0,,أي أني كنتُ هدفها
Dialogue: 0,0:13:51.52,0:13:53.35,DCMain,ERI,0,0,0,,..لكن، في هذه الحالة
Dialogue: 0,0:13:53.54,0:13:54.20,DCMain,KOGORO,0,0,0,,أجل
Dialogue: 0,0:13:54.20,0:13:56.35,DCMain,KOGORO,0,0,0,,كانت ستُقدم على فعل شيء ما
Dialogue: 0,0:14:04.46,0:14:06.14,DCMain,KOGORO,0,0,0,,لكنها لم تفعل
Dialogue: 0,0:14:07.13,0:14:12.59,DCMain,KOGORO,0,0,0,,تركت عن عمد رسالة، وجعلتنا نعثر على دفتر الشفرة
Dialogue: 0,0:14:13.29,0:14:14.74,DCMain,KOGORO,0,0,0,,والذي تضمّن مقالًا عن القضية
Dialogue: 0,0:14:15.22,0:14:17.62,DCMain,KOGORO,0,0,0,,كونان، أين عثرت على دفتر الشفرة؟
Dialogue: 0,0:14:17.91,0:14:19.12,DCMain,CONAN,0,0,0,,!أجل
Dialogue: 0,0:14:19.12,0:14:22.08,DCMain,CONAN,0,0,0,,فريق المحققين الصغار سيُجيب على ذلك
Dialogue: 0,0:14:22.08,0:14:23.25,DCMain,CONAN,0,0,0,,!ميتسوهيكو
Dialogue: 0,0:14:29.93,0:14:32.42,DCMain,MITSUHIKO,0,0,0,,..حسنًا
Dialogue: 0,0:14:32.42,0:14:34.97,DCMain,GENTA,0,0,0,,عثرنا عليه في خزانتها
Dialogue: 0,0:14:34.97,0:14:37.09,DCMain,AYUMI,0,0,0,,!عثر عليه ميتسوهيكو-كن
Dialogue: 0,0:14:37.09,0:14:38.39,DCMain,MITSUHIKO,0,0,0,,صحيح
Dialogue: 0,0:14:39.39,0:14:40.62,DCItalic,MITSUHIKO,0,0,0,,!عثرت عليه
Dialogue: 0,0:14:44.11,0:14:48.51,DCMain,KOGORO,0,0,0,,لِم عساها تتركه في مكان واضحٍ هكذا؟
Dialogue: 0,0:14:48.51,0:14:51.48,DCMain,KOGORO,0,0,0,,..لأنها أرادت مني
Dialogue: 0,0:14:51.48,0:14:56.66,DCMain,KOGORO,0,0,0,,اكتشاف الدافع الحقيقي وراء فعلة أخيها
Dialogue: 0,0:14:56.98,0:14:59.55,DCMain,KOGORO,0,0,0,,..ومن المرجح أيضًا
Dialogue: 0,0:14:59.55,0:15:04.02,DCMain,KOGORO,0,0,0,,لأحاول ردعها مما ستُقدم على فعله
Dialogue: 0,0:15:04.78,0:15:08.67,DCMain,MEI,0,0,0,,!إذًا عرفت دافعه الحقيقي
Dialogue: 0,0:15:09.19,0:15:12.80,DCMain,KOGORO,0,0,0,,لا إطلاقًا
Dialogue: 0,0:15:12.99,0:15:15.06,DCMain,MEI,0,0,0,,!ماذا؟ لا تتحامق
Dialogue: 0,0:15:15.29,0:15:19.56,DCMain,KOGORO,0,0,0,,لكني أستطيع معرفة شخص يعرف ذلك
Dialogue: 0,0:15:20.86,0:15:21.77,DCMain,MEI,0,0,0,,من؟
Dialogue: 0,0:15:22.28,0:15:26.53,DCMain,KOGORO,0,0,0,,،أولًا، حسب علمي هي لم تُعين من قِبل المحكمة
Dialogue: 0,0:15:26.53,0:15:30.57,DCMain,KOGORO,0,0,0,,لكن كيساكي-سينسي لم تتخلَّ عن القضية إطلاقًا
Dialogue: 0,0:15:31.05,0:15:35.47,DCMain,KOGORO,0,0,0,,ربما كان أخاك السبب وراء ذلك
Dialogue: 0,0:15:36.30,0:15:38.08,DCMain,MEI,0,0,0,,ماذا؟ لماذا؟
Dialogue: 0,0:15:38.32,0:15:42.53,DCMain,KOGORO,0,0,0,,لأنها اكتشفت دافعه الحقيقي وراء فعلته
Dialogue: 0,0:15:44.28,0:15:45.46,DCMain,ERI,0,0,0,,!اصمت
Dialogue: 0,0:15:45.74,0:15:47.11,DCMain,MEI,0,0,0,,ماذا تقصد؟
Dialogue: 0,0:15:47.11,0:15:52.21,DCMain,KOGORO,0,0,0,,من أجل نيل حكم مخفف، كان لا بد من كشف دافعه الحقيقي في المحكمة
Dialogue: 0,0:15:52.67,0:15:55.22,DCMain,KOGORO,0,0,0,,،لكن أخاك رفض ذلك
Dialogue: 0,0:15:56.20,0:15:58.37,DCMain,KOGORO,0,0,0,,مُجبرًا إياها على التخلي عن القضية
Dialogue: 0,0:15:58.37,0:16:00.37,DCMain,ERI,0,0,0,,!اصمت يا موري كوغورو
Dialogue: 0,0:16:00.37,0:16:02.55,DCMain,ERI,0,0,0,,!سأُقاضيك إن تفوهت بكلمة أخرى عن الموضوع
Dialogue: 0,0:16:02.55,0:16:04.10,DCMain,KOGORO,0,0,0,,!لا تؤاخذيني
Dialogue: 0,0:16:04.10,0:16:06.92,DCMain,KOGORO,0,0,0,,!لكن اسمحي لي بقول ذلك
Dialogue: 0,0:16:08.02,0:16:11.70,DCMain,KOGORO,0,0,0,,،حتى بعدما أُجبرت على ترك القضية، بدلًا من المضي قدمًا
Dialogue: 0,0:16:11.70,0:16:13.43,DCMain,KOGORO,0,0,0,,لم تكفَّ عن البحث فيها
Dialogue: 0,0:16:15.88,0:16:18.03,DCMain,MEI,0,0,0,,لكن لماذا؟
Dialogue: 0,0:16:18.61,0:16:22.42,DCMain,KOGORO,0,0,0,,كانت تبحث عن أي مستندات
Dialogue: 0,0:16:22.42,0:16:25.88,DCMain,KOGORO,0,0,0,,توضح أي سبيل لتخفيف العقوبة، مستعينة بحقيقة دافعه للقيام بذلك
Dialogue: 0,0:16:25.88,0:16:28.55,DCMain,MEI,0,0,0,,!كاذب، هذا محض عذر
Dialogue: 0,0:16:35.97,0:16:37.97,DCMain,RAN,0,0,0,,!أبي! أمي
Dialogue: 0,0:16:43.40,0:16:44.23,DCItalic,CONAN,0,0,0,,!هذا سيئ
Dialogue: 0,0:16:52.40,0:16:53.61,DCMain,MEGURE,0,0,0,,ماذا يجري؟
Dialogue: 0,0:16:53.61,0:16:55.74,DCMain,CHIBA,0,0,0,,!الزموا الهدوء جميعًا
Dialogue: 0,0:17:02.08,0:17:06.45,DCMain,KOGORO,0,0,0,,..كيساكي-سينسي، إن لم تُفصحي عن الدافع الحقيقي الآن
Dialogue: 0,0:17:06.45,0:17:08.57,DCMain,KOGORO,0,0,0,,!فلن تتطرح السكين أرضًا
Dialogue: 0,0:17:09.86,0:17:16.48,DCMain,KOGORO,0,0,0,,،في البداية، انضمت لفريق عمل تنظيم الفعاليات
Dialogue: 0,0:17:16.48,0:17:18.34,DCMain,KOGORO,0,0,0,,!لكي تنمكن من الاقتراب منك
Dialogue: 0,0:17:19.27,0:17:22.12,DCMain,KOGORO,0,0,0,,،لكن، بالصدفة البحتة، وقعت جريمتي قتل
Dialogue: 0,0:17:22.12,0:17:28.21,DCMain,KOGORO,0,0,0,,،مما جعلها تستغل ذلك لمواجهتك بشكل أبرز
Dialogue: 0,0:17:29.02,0:17:34.50,DCMain,KOGORO,0,0,0,,..لذا قطعت الصفحات من مجلة كانت معها دائمًا تتضمن مقالًا
Dialogue: 0,0:17:34.50,0:17:37.44,DCMain,KOGORO,0,0,0,,،عن قضية أخيها، ثم تركت لنا رسالة مشفرة
Dialogue: 0,0:17:38.01,0:17:44.29,DCMain,KOGORO,0,0,0,,كل هذا بُغية جعلي أكتشف حقيقة القضية، وأُجهرها للعالم أجمع
Dialogue: 0,0:17:46.25,0:17:47.54,DCMain,ERI,0,0,0,,أهذا صحيح؟
Dialogue: 0,0:17:49.47,0:17:51.80,DCMain,MEI,0,0,0,,إنك محقق عظيم حقًا
Dialogue: 0,0:17:54.08,0:17:56.53,DCMain,ERI,0,0,0,,..لكنني محامية
Dialogue: 0,0:17:56.53,0:18:00.64,DCMain,ERI,0,0,0,,ما كنتُ لأفعل أي شيء يؤذي موكلي
Dialogue: 0,0:18:00.64,0:18:03.31,DCMain,KOGORO,0,0,0,,بالطبع، رغم ذلك
Dialogue: 0,0:18:03.57,0:18:07.89,DCMain,KOGORO,0,0,0,,لا بد للحقيقة أن تنجلي يومًا
Dialogue: 0,0:18:08.45,0:18:12.07,DCMain,KOGORO,0,0,0,,أليس هذا بديهيًا يا سينسي؟
Dialogue: 0,0:18:33.90,0:18:38.59,DCMain,ERI,0,0,0,,!كان دافع أخاك الحقيقي هو أنت، يا مي-سان
Dialogue: 0,0:18:38.98,0:18:39.84,DCMain,MEI,0,0,0,,ماذا؟
Dialogue: 0,0:18:40.97,0:18:45.73,DCMain,CONAN,0,0,0,,الحقيقية التي اكتشفتها كيساكي كانت مروّعة
Dialogue: 0,0:18:45.73,0:18:49.85,DCMain,CONAN,0,0,0,,إذ أنَّ الانتحال الذي كان الدافع وراء ارتكابه الجريمة لم يكن على ذلك النحو المُعتَقد
Dialogue: 0,0:18:50.63,0:18:56.31,DCMain,CONAN,0,0,0,,فقد كان الأستاذ الجامعي من سرق بحث أخ مي-سان لا العكس
Dialogue: 0,0:18:56.86,0:18:58.71,DCMain,CONAN,0,0,0,,،وحينما احتج على ذلك
Dialogue: 0,0:18:58.71,0:19:02.37,DCMain,CONAN,0,0,0,,كشف الأستاذ الجامعي السر المكتوم حول برنامج دراسة مي-سان بالخارج
Dialogue: 0,0:19:02.97,0:19:07.22,DCMain,CONAN,0,0,0,,،فقد كانت والدتها هي من دفعت لأجل توصيتها
Dialogue: 0,0:19:07.22,0:19:09.24,DCMain,CONAN,0,0,0,,والتي تُوفيت العام الماضي بسبب المرض
Dialogue: 0,0:19:09.73,0:19:11.83,DCMain,CONAN,0,0,0,,هدده بالفضيحة
Dialogue: 0,0:19:12.37,0:19:16.00,DCMain,MEI,0,0,0,,مستحيل، أمي؟
Dialogue: 0,0:19:16.35,0:19:18.42,DCMain,ERI,0,0,0,,!إياك لوم أمك
Dialogue: 0,0:19:18.72,0:19:22.55,DCMain,ERI,0,0,0,,كانت تبذل قصارى جهدها لأجلك
Dialogue: 0,0:19:24.16,0:19:27.81,DCMain,CONAN,0,0,0,,وأخذت كيساكي في كشف باقي مجريات الأمور
Dialogue: 0,0:19:28.84,0:19:33.81,DCMain,CONAN,0,0,0,,إذ أوضحت أن الأم دفعت الرشوة، لأن الأستاذ الجامعي أجبرها على ذلك
Dialogue: 0,0:19:34.26,0:19:37.57,DCMain,CONAN,0,0,0,,فضلًا عن أنه طلب المزيد من الأمول، لئلا يُفشي ذلك
Dialogue: 0,0:19:37.82,0:19:42.03,DCMain,CONAN,0,0,0,,بعد إتمامها لدراستها خارجًا
Dialogue: 0,0:19:42.84,0:19:45.07,DCMain,MEI,0,0,0,,!أخي
Dialogue: 0,0:19:45.28,0:19:48.98,DCMain,ERI,0,0,0,,لقد تكتّم أخوك عن الأمر، ليحميك
Dialogue: 0,0:19:48.98,0:19:52.59,DCMain,ERI,0,0,0,,ويحمي أمك مهملًا نفسه
Dialogue: 0,0:19:57.52,0:20:01.09,DCMain,,0,0,0,,لم يكن لدي أدنى فكرة
Dialogue: 0,0:20:04.57,0:20:07.86,DCMain,MEI,0,0,0,,..أنا، أنا
Dialogue: 0,0:20:17.06,0:20:17.86,DCMain,KOGORO,0,0,0,,...مؤلم
Dialogue: 0,0:20:19.77,0:20:21.53,DCMain,KOGORO,0,0,0,,!توقفي
Dialogue: 0,0:20:25.94,0:20:28.12,DCMain,MEI,0,0,0,,!دعني! دعني أموت
Dialogue: 0,0:20:29.66,0:20:31.08,DCMain,CONAN,0,0,0,,!استمعي لهذا، يا مي-سان
Dialogue: 0,0:20:31.08,0:20:32.83,DCItalic,TAKAGI,0,0,0,,!موري-سان، معك تاكاغي
Dialogue: 0,0:20:33.13,0:20:33.79,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:20:36.08,0:20:40.55,DCMain,TAKAGI,0,0,0,,..كما طلبت، يا موري-سان، قابلتُ آشيدا هيروتو
Dialogue: 0,0:20:40.55,0:20:45.09,DCMain,TAKAGI,0,0,0,,ويريد إيكال كيساكي-سان كمحامية له مجددًا \N معتذرًا عما فعله سابقًا
Dialogue: 0,0:20:45.53,0:20:46.29,DCMain,MEI,0,0,0,,ماذا؟
Dialogue: 0,0:20:46.86,0:20:49.35,DCItalic,TAKAGI,0,0,0,,،حينما أخبرته بمجريات الأمور
Dialogue: 0,0:20:49.77,0:20:54.49,DCItalic,TAKAGI,0,0,0,,اعتذر بشدة عما تسببه من قلق لأخته
Dialogue: 0,0:20:56.32,0:20:57.60,DCMain,MEI,0,0,0,,..أخي
Dialogue: 0,0:21:03.88,0:21:05.27,DCMain,BOTH,0,0,0,,!موري-كن
Dialogue: 0,0:21:04.29,0:21:05.61,DCMain,BOTH,0,0,0,,!موري-سان
Dialogue: 0,0:21:05.96,0:21:08.81,DCMain,MEI,0,0,0,,!أنا آسفة، آسفة حقًا
Dialogue: 0,0:21:10.46,0:21:14.36,DCMain,ERI,0,0,0,,الآن يمكننا تقديم طلب إعادة محاكمة
Dialogue: 0,0:21:15.43,0:21:16.62,DCMain,ERI,0,0,0,,..بالمناسبة
Dialogue: 0,0:21:17.43,0:21:19.94,DCMain,ERI,0,0,0,,!أنت محقق، ما كان عليك أن تتدخل في هذا
Dialogue: 0,0:21:19.94,0:21:21.00,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:21:21.36,0:21:24.01,DCItalic,CONAN,0,0,0,,هذا سيئ
Dialogue: 0,0:21:25.90,0:21:28.08,DCMain,KOGORO,0,0,0,,!الأمر ليس متعلقًا بكوني محض محقق
Dialogue: 0,0:21:28.08,0:21:31.26,DCMain,KOGORO,0,0,0,,إذ أني قمتُ بذلك بدافع غريزي
Dialogue: 0,0:21:36.48,0:21:39.02,DCMain,RAN,0,0,0,,..أبي، أمي
Dialogue: 0,0:23:06.76,0:23:08.99,DCMain,CONAN,0,0,0,,،إعادة المحاكمة أخذت مجراها
Dialogue: 0,0:23:08.99,0:23:13.95,DCMain,CONAN,0,0,0,,لكن، لم يكن جليًّا ما إذا كان سيُمنح المتهم عقوبة مخففة أما لا
Dialogue: 0,0:23:15.85,0:23:17.91,DCMain,RAN,0,0,0,,واثقة أنه سيكون على ما يُرام
Dialogue: 0,0:23:18.07,0:23:20.54,DCMain,RAN,0,0,0,,بطبيعة الحال، ستترافع عنه أكثر المحامين كفاءة
Dialogue: 0,0:23:19.00,0:23:22.04,eri,,0,0,0,,{\fad(1,724)\blur5}كيساكي إيري\Nأكفأ محامية
Dialogue: 0,0:23:20.54,0:23:21.78,DCMain,CONAN,0,0,0,,.أجل
Dialogue: 0,0:23:22.86,0:23:25.35,DCMain,KOGORO,0,0,0,,ما زلت لا أستطيع تذكر ما حدث
Dialogue: 0,0:23:28.95,0:23:32.93,DCMain,KOGORO,0,0,0,,حسنًا أيًّا يكن، ما من جديد، وما زال مذاق الجعة عظيمًا
Dialogue: 0,0:23:36.20,0:23:39.82,DCMain,CONAN,0,0,0,,!لا تُقارن التحقيق بالشراب
Dialogue: 0,0:23:39.82,0:23:42.46,DCMain,CONAN,0,0,0,,على كل حال، أنقذتُه في النهاية
Dialogue: 0,0:23:46.06,0:23:47.41,DCMain,YONEKURA,0,0,0,,!مرحبًا بالجميع
Dialogue: 0,0:23:47.41,0:23:55.95,DCMain,YONEKURA,0,0,0,,"شكرًا لحضوركم الحدث الإعلاني لفلم "كايجو غوميرا ضد كامين يايبا
Dialogue: 0,0:23:56.22,0:23:57.70,DCMain,KAZUHA,0,0,0,,!هيجي
Dialogue: 0,0:23:57.70,0:23:58.58,DCMain,HEIJI,0,0,0,,ماذا؟
Dialogue: 0,0:23:58.82,0:24:01.46,DCMain,KAZUHA,0,0,0,,!لنأخذ صورة مع غوميرا
Dialogue: 0,0:24:01.46,0:24:02.58,DCMain,HEIJI,0,0,0,,!بئسًا
Dialogue: 0,0:24:07.17,0:24:08.72,DCMain,KOGORO,0,0,0,,!ما هذا؟
Dialogue: 0,0:24:09.37,0:24:14.54,DCMain,CONAN,0,0,0,,"!في الحلقة القادمة من كونان "كايجو غوميرا ضد كامين يايبا، الافتتاح
Dialogue: 0,0:24:30.38,0:24:32.85,DCMain,BOTH,0,0,0,,!تلميح كونان التالي
Dialogue: 0,0:24:32.85,0:24:34.50,DCMain,CONAN,0,0,0,,!أخبار الإنترنت
Dialogue: 0,0:24:34.91,0:24:36.39,DCMain,CONAN,0,0,0,,{\fad(300,300)\fnAsmaa Font\an7\bord5\blur10\shad0\c&HFFFFFF&\3c&H2AC82F&}!موسم الإجازة سينتهي بيايبا الشهير
Dialogue: 0,0:24:36.39,0:24:37.59,DCMain,RAN,0,0,0,,{\fad(300,300)\fnAsmaa Font\an7\bord5\blur10\shad0\c&HFFFFFF&\3c&HC86F2A&}!جميعنا معًا الآن
