Dialogue: 0,0:09:21.12,0:09:23.05,DCMain,RAN,0,0,0,,!كونان] في الداخل]
Dialogue: 0,0:09:23.55,0:09:25.96,DCMain,RAN,0,0,0,,يوجد طفل داخل ذلك التابوت
Dialogue: 0,0:09:28.30,0:09:31.55,DCMain,KOGORO,0,0,0,,يبدو أنكم تعرفون ما نتحدث عنه
Dialogue: 0,0:09:32.93,0:09:34.13,DCMain,KOZO,0,0,0,,!مستحيل
Dialogue: 0,0:09:34.13,0:09:36.15,DCMain,MITSUYO,0,0,0,,!هذا غير صحيح
Dialogue: 0,0:09:36.15,0:09:38.60,DCMain,EISUKE,0,0,0,,!أجل، لا يمكن أن يكون هذا صحيحًا
Dialogue: 0,0:09:38.60,0:09:42.14,DCMain,MEGURE,0,0,0,,أتسمحون لنا بفتح التابوت إذن؟
Dialogue: 0,0:09:42.80,0:09:45.34,DCMain,KOGORO,0,0,0,,كنت أنتظر وصولك يا حضرة المفتش
Dialogue: 0,0:09:45.84,0:09:47.90,DCMain,MEGURE,0,0,0,,نحن من القسم الأول لشرطة العاصمة
Dialogue: 0,0:09:47.90,0:09:51.35,DCMain,MEGURE,0,0,0,,قد تكون هذه حادثة اختطاف
Dialogue: 0,0:09:51.35,0:09:52.77,DCMain,MEGURE,0,0,0,,![تاكاغي] و[تشيبا]
Dialogue: 0,0:09:52.77,0:09:53.52,DCMain,BOTH,0,0,0,,!حاضر يا سيدي
Dialogue: 0,0:09:58.74,0:10:01.03,DCMain,KOZO,0,0,0,,!حتى إن كنتم من الشرطة، لا يمكنكم فعل هذا
Dialogue: 0,0:10:01.45,0:10:03.55,DCMain,MEGURE,0,0,0,,ألديك اعتراض؟
Dialogue: 0,0:10:04.42,0:10:06.29,DCMain,KOZO,0,0,0,,لا، ليس تمامًا
Dialogue: 0,0:10:09.33,0:10:11.64,DCMain,RAN,0,0,0,,هل [كونان] تحت تلك الجثة؟
Dialogue: 0,0:10:13.39,0:10:14.63,DCMain,BOTH,0,0,0,,المعذرة
Dialogue: 0,0:10:14.05,0:10:16.47,DCSPNotes,,0,0,0,,{\fad(500,0)}{\c&H8EE1EC&\3c&HAE716D&\b0}ملحق قاعة جنازات بيكا{\b1}
Dialogue: 0,0:10:23.49,0:10:24.22,DCMain,TAKAGI,0,0,0,,!إنه ليس هنا
Dialogue: 0,0:10:24.43,0:10:25.35,DCMain,RAN,0,0,0,,ماذا؟
Dialogue: 0,0:10:25.91,0:10:27.03,DCMain,CHIBA,0,0,0,,في الواقع
Dialogue: 0,0:10:27.52,0:10:30.61,DCMain,CHIBA,0,0,0,,هذا التابوت ليس به قاع مزيف
Dialogue: 0,0:10:31.62,0:10:32.98,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:10:33.34,0:10:34.42,DCMain,RAN,0,0,0,,لا يمكن
Dialogue: 0,0:10:40.52,0:10:42.69,DCMain,MEGURE,0,0,0,,ما الذي يحدث هنا يا [موري]؟
Dialogue: 0,0:10:42.69,0:10:45.39,DCMain,KOGORO,0,0,0,,كان من المفروض أن نجده
Dialogue: 0,0:10:45.39,0:10:47.75,DCMain,KOGORO,0,0,0,,أنتم، ما الذي يحدث هنا؟
Dialogue: 0,0:10:48.02,0:10:50.80,DCMain,KOZO,0,0,0,,لا تسألنا
Dialogue: 0,0:10:50.80,0:10:53.58,DCMain,EISUKE,0,0,0,,أليست هذه مشكلة؟
Dialogue: 0,0:10:53.58,0:10:55.96,DCMain,MITSUYO,0,0,0,,من الأفضل أن تتحمل مسؤولية ما حدث
Dialogue: 0,0:10:56.14,0:10:59.72,DCMain,MEGURE,0,0,0,,سنفعل هذا في وقت لاحق
Dialogue: 0,0:11:00.22,0:11:01.40,DCMain,HAIBARA,0,0,0,,إيدوغاوا]؟]
Dialogue: 0,0:11:01.40,0:11:04.14,DCMain,HAIBARA,0,0,0,,أين أنت يا [إيدوغاوا]؟
Dialogue: 0,0:11:06.02,0:11:07.79,DCMain,MITSUHIKO,0,0,0,,هل انقطع الاتصال؟
Dialogue: 0,0:11:07.79,0:11:09.73,DCMain,GENTA,0,0,0,,أين ذهب؟
Dialogue: 0,0:11:10.16,0:11:11.40,DCMain,AYUMI,0,0,0,,[كونان]
Dialogue: 0,0:11:11.93,0:11:13.01,DCMain,CONAN,0,0,0,,هايبرا]؟]
Dialogue: 0,0:11:13.78,0:11:14.86,DCMain,CONAN,0,0,0,,![هايبرا]
Dialogue: 0,0:11:15.43,0:11:16.80,DCMain,CONAN,0,0,0,,تبًا
Dialogue: 0,0:11:16.80,0:11:18.53,DCMain,CONAN,0,0,0,,إلى أين سنذهب؟
Dialogue: 0,0:11:23.62,0:11:26.01,DCMain,MURAKAMI,0,0,0,,يا لها من خردة
Dialogue: 0,0:11:26.01,0:11:28.41,DCMain,MURAKAMI,0,0,0,,لقد أضعت الكثير من الوقت
Dialogue: 0,0:11:32.45,0:11:33.66,DCMain,CONAN,0,0,0,,وجدتها
Dialogue: 0,0:11:34.01,0:11:37.17,DCMain,CONAN,0,0,0,,...هذا يعني أنها قد تكون
Dialogue: 0,0:11:41.34,0:11:43.42,DCMain,CONAN,0,0,0,,هل تسمعينني يا [هايبرا]؟
Dialogue: 0,0:11:44.10,0:11:45.73,DCMain,KOGORO,0,0,0,,ماذا؟
Dialogue: 0,0:11:46.08,0:11:48.93,DCMain,KOGORO,0,0,0,,توجد سيارة أخرى؟
Dialogue: 0,0:11:49.27,0:11:52.51,DCMain,RAN,0,0,0,,[أجل، هذا ما قاله [كونان
Dialogue: 0,0:11:52.51,0:11:56.48,DCMain,RAN,0,0,0,,من المحتمل أنها كانت مركونة في المواقف تحت مكان تشييع الجنازة
Dialogue: 0,0:11:56.48,0:11:58.94,DCMain,RAN,0,0,0,,ماذا؟ أين ذهب الأطفال؟
Dialogue: 0,0:11:59.79,0:12:00.84,DCMain,KOGORO,0,0,0,,!يا حضرة المفتش
Dialogue: 0,0:12:01.25,0:12:02.17,DCMain,MEGURE,0,0,0,,[تاكاغي]
Dialogue: 0,0:12:02.17,0:12:02.86,DCMain,TAKAGI,0,0,0,,حاضر يا سيدي
Dialogue: 0,0:12:08.13,0:12:10.29,DCMain,TAKAGI,0,0,0,,مرحبًا؟ أهذا مكان تشييع الجنازات؟
Dialogue: 0,0:12:12.30,0:12:13.47,DCMain,KOGORO,0,0,0,,قفوا مكانكم
Dialogue: 0,0:12:14.48,0:12:17.02,DCMain,KOGORO,0,0,0,,إلى أين تنوون الذهاب؟
Dialogue: 0,0:12:17.02,0:12:17.80,DCMain,MEGURE,0,0,0,,[تشيبا]
Dialogue: 0,0:12:18.02,0:12:18.72,DCMain,CHIBA,0,0,0,,حسنٌ يا سيدي
Dialogue: 0,0:12:19.33,0:12:22.38,DCMain,CHIBA,0,0,0,,ستبقون هنا حتى نعرف ما حدث
Dialogue: 0,0:12:27.72,0:12:31.48,DCMain,TAKAGI,0,0,0,,حضرة المفتش، يبدو أن هناك سيارة أخرى
Dialogue: 0,0:12:31.90,0:12:33.29,DCMain,MEGURE,0,0,0,,حقًا؟
Dialogue: 0,0:12:33.29,0:12:39.60,DCMain,TAKAGI,0,0,0,,إنها سيارة قديمة الطراز، وقد أرسلوها صباح اليوم للتخلص منها
Dialogue: 0,0:12:39.60,0:12:42.36,DCMain,TAKAGI,0,0,0,,وقد كانت مركونة في المواقف قبل ذلك
Dialogue: 0,0:12:42.67,0:12:44.06,DCMain,RAN,0,0,0,,!كما توقعت
Dialogue: 0,0:12:44.06,0:12:46.03,DCMain,KOGORO,0,0,0,,أين ستُرمَى؟
Dialogue: 0,0:12:46.03,0:12:48.95,DCMain,TAKAGI,0,0,0,,قالوا إن الشخص الذي رتب  عملية التخلص منها في إجازة اليوم
Dialogue: 0,0:12:48.95,0:12:50.75,DCMain,MEGURE,0,0,0,,أتعني أنك لم تعرف المكان؟
Dialogue: 0,0:12:54.77,0:12:56.26,DCMain,RAN,0,0,0,,[مرحبًا يا [آي
Dialogue: 0,0:12:56.26,0:12:57.77,DCMain,RAN,0,0,0,,أين ذهبتم؟
Dialogue: 0,0:12:58.17,0:12:58.91,DCMain,RAN,0,0,0,,ماذا؟
Dialogue: 0,0:12:59.49,0:13:01.63,DCMain,RAN,0,0,0,,!أنتم تتبعون السيارة التي وُضِع [كونان] فيها؟
Dialogue: 0,0:13:01.92,0:13:03.38,DCMain,BOTH,0,0,0,,!ماذا؟
Dialogue: 0,0:13:08.27,0:13:09.86,DCMain,CONAN,0,0,0,,فهمت
Dialogue: 0,0:13:09.86,0:13:12.48,DCMain,CONAN,0,0,0,,!إذن هذه السيارة خردة
Dialogue: 0,0:13:13.62,0:13:15.30,DCMain,CONAN,0,0,0,,انعطفنا يمينًا
Dialogue: 0,0:13:17.53,0:13:18.84,DCMain,CONAN,0,0,0,,ثم يسارًا
Dialogue: 0,0:13:19.41,0:13:21.16,DCMain,CONAN,0,0,0,,ونسير الآن في طريق مستقيم
Dialogue: 0,0:13:24.57,0:13:26.07,DCMain,CONAN,0,0,0,,بعده منعطف آخر يسارًا
Dialogue: 0,0:13:26.47,0:13:28.22,DCMain,AYUMI,0,0,0,,انعطف يمينًا، ثم يسارًا
Dialogue: 0,0:13:28.22,0:13:30.87,DCMain,AYUMI,0,0,0,,تابع السير نحو الأمام، ثم انعطف يسارًا
Dialogue: 0,0:13:30.87,0:13:31.91,DCMain,MITSUHIKO,0,0,0,,اتبع ما قالته
Dialogue: 0,0:13:32.50,0:13:33.74,DCMain,GENTA,0,0,0,,نحن نعتمد عليك
Dialogue: 0,0:13:34.78,0:13:43.05,DCMain,HAIBARA,0,0,0,,هذا يعني أن البخور والثلج الجاف واللوح الخشبي جميعها نفايات أيضًا
Dialogue: 0,0:13:43.43,0:13:48.18,DCMain,HAIBARA,0,0,0,,وأنك لست داخل تابوت
Dialogue: 0,0:13:48.57,0:13:51.99,DCItalic,HAIBARA,0,0,0,,...كما أن سبب توقف السيارة عدة مرات هو
Dialogue: 0,0:13:52.67,0:13:55.35,DCMain,CONAN,0,0,0,,توقف محرك السيارة القديم
Dialogue: 0,0:13:56.02,0:13:58.19,DCMain,CONAN,0,0,0,,كانت محض مصادفة
Dialogue: 0,0:13:58.45,0:14:02.74,DCMain,CONAN,0,0,0,,وساعد ذلك في تضليل الحقيقة
Dialogue: 0,0:14:03.54,0:14:05.95,DCMain,CONAN,0,0,0,,أظن أني فهمت أخيرًا ما حدث
Dialogue: 0,0:14:07.01,0:14:11.36,DCMain,CONAN,0,0,0,,تعاون أكثر من شخص على ارتكاب الجريمة
Dialogue: 0,0:14:12.90,0:14:14.07,DCMain,HAIBARA,0,0,0,,فهمت
Dialogue: 0,0:14:14.59,0:14:15.62,DCMain,HAIBARA,0,0,0,,...لهذا
Dialogue: 0,0:14:16.22,0:14:16.89,DCMain,HAIBARA,0,0,0,,ماذا؟
Dialogue: 0,0:14:17.33,0:14:19.65,DCMain,HAIBARA,0,0,0,,لكنهم يملكون حجج غياب
Dialogue: 0,0:14:20.60,0:14:22.38,DCMain,CONAN,0,0,0,,...من المحتمل أنهم
