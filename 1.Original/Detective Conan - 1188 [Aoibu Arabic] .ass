Dialogue: 0,0:05:32.14,0:05:34.52,Default,,0,0,0,,!قطعة شرائح اللحم المفروم المجمدة
Dialogue: 0,0:05:34.52,0:05:36.90,Default,,0,0,0,,!قطعة الكروكيت المجمد
Dialogue: 0,0:05:37.19,0:05:40.13,Default,,0,0,0,,.لا تنسيا الابتسامة أنتما الاثنان
Dialogue: 0,0:05:41.59,0:05:42.78,Default,,0,0,0,,.أبتسامة
Dialogue: 0,0:05:43.05,0:05:44.41,Default,,0,0,0,,...أبتسامة
Dialogue: 0,0:05:49.41,0:05:52.63,Default,,0,0,0,,.وبهذا يختتم الاستعراض
Dialogue: 0,0:05:52.63,0:05:54.75,Default,,0,0,0,,.لنحيي بالتصفيق
Dialogue: 0,0:05:54.75,0:05:59.76,Default,,0,0,0,,.قطعة شرائح اللحم المفروم المجمدة" و"قطعة الكروكيت المجمد" لهذا اليوم"
Dialogue: 0,0:06:02.96,0:06:05.94,Default,,0,0,0,,.سأتصل بتاكسي إيشيكاوا جينكي وأعود إلى البيت
Dialogue: 0,0:06:05.94,0:06:08.11,Default,,0,0,0,,.يا لها من مهمة ضيف شرف سخيفة
Dialogue: 0,0:06:08.11,0:06:10.54,Default,,0,0,0,,.كنت أفضل مهرجان "سيد شيتشي-غو" في غير موسمه
Dialogue: 0,0:06:10.54,0:06:14.79,Default,,0,0,0,,قطعة شرائح اللحم المفروم المجمدة" و"قطعة الكروكيت المجمد" لهذا اليوم"
Dialogue: 0,0:06:14.79,0:06:18.57,Default,,0,0,0,,!سيشاركان في مسابقة أزياء المجمدات المصنوعة يدويًا
Dialogue: 0,0:06:18.57,0:06:19.57,Default,,0,0,0,,!ماذا
Dialogue: 0,0:06:19.57,0:06:21.89,Default,,0,0,0,,كحكام أو شيء من هذا القبيل؟
Dialogue: 0,0:06:21.89,0:06:23.65,Default,,0,0,0,,!لا كمقدمي الحفل
Dialogue: 0,0:06:23.65,0:06:24.77,Default,,0,0,0,,...مقدمي
Dialogue: 0,0:06:24.77,0:06:25.78,Default,,0,0,0,,!الحفل
Dialogue: 0,0:06:26.78,0:06:30.29,Default,,0,0,0,,!هيا هيا دور المنافس التالي
Dialogue: 0,0:06:31.35,0:06:33.16,Default,,0,0,0,,!هيا بنا
Dialogue: 0,0:06:33.16,0:06:35.58,Default,,0,0,0,,!نحن لسنا فنانين
Dialogue: 0,0:06:35.58,0:06:37.50,Default,,0,0,0,,.المعذرة
Dialogue: 0,0:06:37.50,0:06:41.30,Default,,0,0,0,,.سمعت أن العمدة كان هنا
Dialogue: 0,0:06:41.30,0:06:42.26,Default,,0,0,0,,!ران
Dialogue: 0,0:06:42.26,0:06:43.88,Default,,0,0,0,,.نحن مرتدون هذه الأزياء السخيفة
Dialogue: 0,0:06:43.88,0:06:45.88,Default,,0,0,0,,!لا يمكننا السماح لها برؤيتنا بهذا الشكل
Dialogue: 0,0:06:45.88,0:06:48.65,Default,,0,0,0,,.أنا العمدة من أنتِ
Dialogue: 0,0:06:48.65,0:06:51.91,Default,,0,0,0,,.أنا ابنة موري كوغورو ضيف الشرف
Dialogue: 0,0:06:51.91,0:06:54.84,Default,,0,0,0,,.رائع ما اسمك
Dialogue: 0,0:06:54.84,0:06:56.22,Default,,0,0,0,,.إنه موري ران
Dialogue: 0,0:06:56.22,0:06:58.52,Default,,0,0,0,,.اسمكِ رائع أيضًا
Dialogue: 0,0:06:58.90,0:07:00.61,Default,,0,0,0,,.أنسة ران ستكونين وجه الإعلان
Dialogue: 0,0:07:00.61,0:07:04.55,Default,,0,0,0,,.للقريدس المقلي المجمد الذي سنطلقه الشهر المقبل
