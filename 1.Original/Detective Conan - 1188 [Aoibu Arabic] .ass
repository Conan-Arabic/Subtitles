Dialogue: 0,0:00:03.39,0:00:05.81,Default,,0,0,0,,!أبي، كونان
Dialogue: 0,0:00:05.81,0:00:08.90,Default,,0,0,0,,!تاكسي سيد إيشيكاوا جينكي هنا
Dialogue: 0,0:00:14.94,0:00:17.75,Default,,0,0,0,,.تبدوان وسيمان جداً
Dialogue: 0,0:00:18.98,0:00:22.63,Default,,0,0,0,,.المحقق العظيم يبدو أنيقًا مهما ارتدى
Dialogue: 0,0:00:23.00,0:00:26.63,Default,,0,0,0,,...أنت تبدو فخوراً بشكلٍ خاص فقط عندما تنام
Dialogue: 0,0:00:27.08,0:00:31.68,Default,,0,0,0,,.سألتحق بكم بعد أن أنهي ما أفعله حظًا موفقًا يا كونان
Dialogue: 0,0:00:32.62,0:00:34.58,Default,,0,0,0,,،حسنًا أراكما لاحقًا
Dialogue: 0,0:00:36.60,0:00:39.86,Default,,0,0,0,,{\an8}!إذا أليس هذا المحقق العظيم موري كوغورو
Dialogue: 0,0:00:36.60,0:00:41.10,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(341,257)}(25)إيشيكاوا جينكي
Dialogue: 0,0:00:36.60,0:00:41.10,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(341,274)}سائق تاكسي
Dialogue: 0,0:00:39.86,0:00:41.52,Default,,0,0,0,,{\an8}إلى أين أنت متجه اليوم؟
Dialogue: 0,0:00:47.14,0:00:49.29,Default,,0,0,0,,إلى مهرجان "سيد شيتشي-غو" في غير موسمه؟
Dialogue: 0,0:00:49.29,0:00:51.50,Default,,0,0,0,,!أنا مرتدي زيّ رسميٌ لمناسبة، يا غبي
Dialogue: 0,0:00:51.50,0:00:53.20,Default,,0,0,0,,.آسف
Dialogue: 0,0:00:53.57,0:00:57.12,Default,,0,0,0,,.إذن، إلى أين أخذكم اليوم
Dialogue: 0,0:00:57.12,0:00:58.53,Default,,0,0,0,,هنا، من فضلك
Dialogue: 0,0:00:58.53,0:01:00.66,Default,,0,0,0,,.دعني ألقِ نظرة
Dialogue: 0,0:01:00.66,0:01:02.73,Default,,0,0,0,,.لنرى
Dialogue: 0,0:01:02.73,0:01:06.53,Default,,0,0,0,,"إلى المحقق العظيم موري كوغورو
Dialogue: 0,0:01:06.53,0:01:08.67,Default,,0,0,0,,أنت مدعو رسميًا لحضور مناسبة
Dialogue: 0,0:01:08.08,0:01:15.97,sign_1188_invitation,SIGN,0,0,0,,{\an7\pos(106,41)}"،إلى المحقق العظيم موري كوغورو\N.أنت مدعو رسميًا لحضور مناسبة تقيمها مدينة فوراي كضيف شرف\N.بإخلاص، أوغاوا ماساهارو، عمدة مدينة فوراي
Dialogue: 0,0:01:08.67,0:01:12.21,Default,,0,0,0,,.تقيمها مدينة فوراي كضيف شرف
Dialogue: 0,0:01:12.21,0:01:15.97,Default,,0,0,0,,.بإخلاص، أوغاوا ماساهارو، عمدة مدينة فوراي"
Dialogue: 0,0:01:16.69,0:01:18.35,Default,,0,0,0,,في مواجهة لغز غير متوقع
Dialogue: 0,0:01:18.35,0:01:20.15,Default,,0,0,0,,!الحل الوحيد هو مهارات الاستنتاج الفائقة
Dialogue: 0,0:01:20.15,0:01:23.69,Default,,0,0,0,,!بالسرعة القصوى، يحب كوغورو يندفع نحو الجاني
Dialogue: 0,0:01:24.04,0:01:25.61,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:01:25.61,0:01:27.71,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:01:27.71,0:01:30.57,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:01:31.51,0:01:35.27,DC-OP,,0,0,0,,‫ليس بوسعي تغييره بنفسي
Dialogue: 0,0:01:35.45,0:01:38.50,DC-OP,,0,0,0,,‫ما كان منك وما أصابك، فقد مضى وانتهى
Dialogue: 0,0:01:38.98,0:01:42.75,DC-OP,,0,0,0,,‫لا يُعرف من أين جاء ولا ما هو
Dialogue: 0,0:01:42.84,0:01:46.47,DC-OP,,0,0,0,,‫كأن يهاجمك أحد الوحوش
Dialogue: 0,0:01:46.76,0:01:50.54,DC-OP,,0,0,0,,‫أركض كي لا يلحقوا بي
Dialogue: 0,0:01:50.54,0:01:53.80,DC-OP,,0,0,0,,‫ربما يحدث خيراً، من يعلم؟
Dialogue: 0,0:01:54.20,0:01:58.10,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:01:58.10,0:02:02.11,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:02:02.11,0:02:05.82,DC-OP,,0,0,0,,‫أجعل عمق الليل يلمع باللون الوردي
Dialogue: 0,0:02:05.82,0:02:09.54,DC-OP,,0,0,0,,‫مهما طال الزمن، كل ما علي فعله هو المحاولة
Dialogue: 0,0:02:17.24,0:02:21.04,DC-OP,,0,0,0,,‫أبحث عن سعادة جديدة
Dialogue: 0,0:02:21.04,0:02:24.33,DC-OP,,0,0,0,,‫أين يكمن؟، لا احد يعلم
Dialogue: 0,0:02:24.66,0:02:28.76,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:02:28.76,0:02:32.17,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:02:32.36,0:02:35.77,DC-OP,,0,0,0,,‫أضيء على الذكريات المظلمة
Dialogue: 0,0:02:36.05,0:02:39.75,DC-OP,,0,0,0,,‫احدق فيها حتى يزول خوفها
Dialogue: 0,0:02:40.01,0:02:43.73,DC-OP,,0,0,0,,‫في لحظة تلتفت فيها إلى الماضي
Dialogue: 0,0:02:43.83,0:02:47.47,DC-OP,,0,0,0,,‫لم يكن سوى أن أطلقت أعظم دموعك
Dialogue: 0,0:03:12.09,0:03:17.97,sign_episode_title,SIGN,0,0,0,,{\fad(400,1)}الحقهم! يا تاكسي المحقق 3
Dialogue: 0,0:03:12.21,0:03:15.39,Default,,0,0,0,,"!الحقهم! يا تاكسي المحقق 3"
Dialogue: 0,0:03:24.85,0:03:27.98,Default,,0,0,0,,!إذن أنت المحقق الشهير
Dialogue: 0,0:03:27.98,0:03:30.86,Default,,0,0,0,,...نعم. أنا المحقق العظيم
Dialogue: 0,0:03:30.86,0:03:34.99,Default,,0,0,0,,!موري كوغورو، مرحبًا بك في مدينة فوراي
Dialogue: 0,0:03:34.99,0:03:37.14,Default,,0,0,0,,{\an8}.أنا العمدة أوغاوا ماساهارو
Dialogue: 0,0:03:35.24,0:03:39.74,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(320,255)}(61)أوغاوا ماساهارو
Dialogue: 0,0:03:35.24,0:03:39.74,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(320,272)}عمدة مدينة فوراي
Dialogue: 0,0:03:37.14,0:03:39.57,Default,,0,0,0,,{\an8}نشعر بالفخر للاحتفال
Dialogue: 0,0:03:39.57,0:03:45.95,Default,,0,0,0,,{\an8}باكتمال مصنع شرائح اللحم المفروم المجمدة والكروكيت المتخصص لمدينة فوراي
Dialogue: 0,0:03:45.95,0:03:47.87,Default,,0,0,0,,!بوجودك كضيف شرف لدينا
Dialogue: 0,0:03:49.49,0:03:51.13,Default,,0,0,0,,شرائح لحم مفروم مجمدة؟
Dialogue: 0,0:03:51.13,0:03:54.66,Default,,0,0,0,,.وبهذه الصفة أعلن تعيينك المحقق العظيم موري كوغورو
Dialogue: 0,0:03:54.66,0:03:59.09,Default,,0,0,0,,!كقطعة شرائح اللحم المفروم المجمدة الفخري" لهذا اليوم"
Dialogue: 0,0:04:00.79,0:04:03.22,Default,,0,0,0,,قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم؟"
Dialogue: 0,0:04:04.52,0:04:07.43,Default,,0,0,0,,!مهلا ماذا تفعل؟ أتركني
Dialogue: 0,0:04:07.43,0:04:09.85,sign_1188_costume,SIGN,0,0,0,,{\an2\move(320,10,320,230)\yshad-1\3c&HE5E6E4&} مدينة فوراي
Dialogue: 0,0:04:09.19,0:04:12.38,Default,,0,0,0,,.تبدو رائعًا
Dialogue: 0,0:04:09.85,0:04:11.61,sign_1188_costume,SIGN,0,0,0,,{\an2\move(320,230,320,360)\yshad-1\fad(1,500)}مدينة فوراي
Dialogue: 0,0:04:13.96,0:04:17.03,Default,,0,0,0,,!ما هذا الزي؟
Dialogue: 0,0:04:17.82,0:04:20.04,Default,,0,0,0,,!كونان أيها الشقي
Dialogue: 0,0:04:20.98,0:04:26.58,Default,,0,0,0,,.لا بد أنك مساعده الشهير، كونان
Dialogue: 0,0:04:27.20,0:04:32.16,Default,,0,0,0,,.سمعت عنك من الشخص الذي رشح المحقق العظيم موري كوغورو
Dialogue: 0,0:04:32.16,0:04:34.53,Default,,0,0,0,,.ليكون "قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:04:34.53,0:04:36.13,Default,,0,0,0,,مـ-من؟
Dialogue: 0,0:04:36.13,0:04:41.19,Default,,0,0,0,,!أعلن تعيينك "قطعة الكروكيت المجمد الفخري" لهذا اليوم
Dialogue: 0,0:04:45.33,0:04:48.64,Default,,0,0,0,,.تبدو رائعًا
