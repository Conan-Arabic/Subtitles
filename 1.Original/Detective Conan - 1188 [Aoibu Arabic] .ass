Dialogue: 0,0:07:43.38,0:07:46.71,Default,,0,0,0,,.أنا "قطعة القريدس المقلي المجمد" لهذا اليوم"
Dialogue: 0,0:07:47.32,0:07:49.07,Default,,0,0,0,,!لن أسمح بذلك
Dialogue: 0,0:07:49.82,0:07:51.33,Default,,0,0,0,,!توقف
Dialogue: 0,0:07:51.91,0:07:54.42,Default,,0,0,0,,...أتفهم غضبه لكن
Dialogue: 0,0:07:54.42,0:07:55.70,Default,,0,0,0,,...بالتفكير في الأمر
Dialogue: 0,0:07:56.51,0:08:01.52,Default,,0,0,0,,.سمعت عنك من الشخص الذي رشح المحقق العظيم موري كوغورو
Dialogue: 0,0:08:01.52,0:08:04.21,Default,,0,0,0,,.ليكون "قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:08:04.55,0:08:06.61,Default,,0,0,0,,.من رشحه يا ترى
Dialogue: 0,0:08:07.04,0:08:08.84,Default,,0,0,0,,.أعتقد أنني سأسأل العمدة
Dialogue: 0,0:08:08.84,0:08:11.47,Default,,0,0,0,,.أين ذهبتَ أيها العمدة
Dialogue: 0,0:08:12.93,0:08:14.31,Default,,0,0,0,,ر-ران؟
Dialogue: 0,0:08:14.31,0:08:16.03,Default,,0,0,0,,أ-أبي؟
Dialogue: 0,0:08:16.03,0:08:18.19,Default,,0,0,0,,.أنا في الواقع...
Dialogue: 0,0:08:18.57,0:08:20.56,Default,,0,0,0,,!لماذا أنت مرتدٍ هكذا
Dialogue: 0,0:08:20.56,0:08:23.07,Default,,0,0,0,,...هناك سبب لهذا
Dialogue: 0,0:08:24.46,0:08:27.58,Default,,0,0,0,,؟هل ناديت "بقطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:08:27.58,0:08:29.53,Default,,0,0,0,,!نادني بالمحقق العظيم موري كوغورو
Dialogue: 0,0:08:29.53,0:08:31.97,Default,,0,0,0,,!المحقق العظيم موري كوغورو
Dialogue: 0,0:08:32.78,0:08:34.95,Default,,0,0,0,,.ران سنخرج من هنا
Dialogue: 0,0:08:34.95,0:08:38.25,Default,,0,0,0,,ماذا لكن ماذا عن عملك؟
Dialogue: 0,0:08:38.25,0:08:40.33,Default,,0,0,0,,.لقد انتهيت من العمل لهذا اليوم
Dialogue: 0,0:08:40.33,0:08:42.83,Default,,0,0,0,,.أين كونان
Dialogue: 0,0:08:42.83,0:08:46.10,Default,,0,0,0,,.لا تسأليني لا بد أنه يلعب دور المحقق في مكان ما مرة أخرى
Dialogue: 0,0:08:46.10,0:08:47.80,Default,,0,0,0,,!انتظر أبي
Dialogue: 0,0:08:49.26,0:08:52.34,Default,,0,0,0,,!"قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:08:52.75,0:08:56.00,Default,,0,0,0,,."قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم غادر
Dialogue: 0,0:08:56.00,0:08:57.67,Default,,0,0,0,,.أيها السيد العمدة
Dialogue: 0,0:08:57.67,0:09:01.39,Default,,0,0,0,,!إذا أليس هذا "قطعة الكروكيت المجمد" لهذا اليوم
Dialogue: 0,0:09:02.14,0:09:08.62,Default,,0,0,0,,.من رشح المحقق العظيم موري كوغورو ليكون "قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:09:08.62,0:09:13.56,Default,,0,0,0,,.تم الاتصال بي من قبل المفتش ميغوري من شرطة العاصمة
Dialogue: 0,0:09:13.56,0:09:18.25,Default,,0,0,0,,.هو من رشح المحقق العظيم موري كوغورو لهذا المنصب
Dialogue: 0,0:09:18.25,0:09:19.86,Default,,0,0,0,,.كان المفتش ميغوري
Dialogue: 0,0:09:19.86,0:09:22.17,Default,,0,0,0,,.شكرًا لك حسنًا إلى اللقاء
Dialogue: 0,0:09:22.87,0:09:24.50,Default,,0,0,0,,!يا قطعة الكروكيت المجمد
Dialogue: 0,0:09:24.91,0:09:28.85,Default,,0,0,0,,!من فضلك عد للمسابقة
Dialogue: 0,0:09:30.71,0:09:33.64,Default,,0,0,0,,مرحبًا ، موري؟
Dialogue: 0,0:09:33.64,0:09:39.35,Default,,0,0,0,,.أيها المفتش آسف على السؤال الغريب لكن هل أخبرت عمدة مدينة فوراي أن يرشحني
Dialogue: 0,0:09:39.35,0:09:42.28,Default,,0,0,0,,.لأكون "قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:09:42.28,0:09:44.52,Default,,0,0,0,,قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم؟"
Dialogue: 0,0:09:44.83,0:09:46.50,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:09:46.50,0:09:48.60,Default,,0,0,0,,ماذا إذن من فعل ذلك؟
Dialogue: 0,0:09:48.60,0:09:50.97,Default,,0,0,0,,.في الواقع جيد لأنك اتصلت
Dialogue: 0,0:09:50.97,0:09:52.92,Default,,0,0,0,,ماذا تقصد؟
Dialogue: 0,0:09:52.92,0:09:56.99,Default,,0,0,0,,.كنت أفكر في الاتصال بك
Dialogue: 0,0:09:56.99,0:09:58.57,Default,,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:09:59.04,0:10:02.79,Default,,0,0,0,,.نحن في الواقع نتعامل مع قضية غريبة
Dialogue: 0,0:10:02.79,0:10:04.79,Default,,0,0,0,,قضية غريبة؟
Dialogue: 0,0:10:04.79,0:10:09.56,Default,,0,0,0,,.أنت تعرف عن سلسلة سرقات محلات المجوهرات في المدينة أليس كذلك
Dialogue: 0,0:10:09.56,0:10:12.05,Default,,0,0,0,,.نعم مع لصوص يستأجرون
Dialogue: 1,0:10:12.05,0:10:13.18,sign_1188_onscreen_headlines,SIGN,0,0,0,,{\pos(517,145)\fscx80}متجر مجوهرات آخر\Nسرقة بواسطة\Nلصوص مأجورون؟
Dialogue: 0,0:10:12.05,0:10:13.18,sign_note,SIGN,0,0,0,,{\an9\p1\shad0\bord3\c&HF5F5F3&\3c&H875CC0&\4c&H8B5E42&\pos(607,90)}m 225 15 l 15 15 15 100 225 100
Dialogue: 0,0:10:13.18,0:10:14.30,sign_note,SIGN,0,0,0,,{\an2\p1\shad0\bord3\c&HF5F5F3&\3c&H875CC0&\4c&H8B5E42&\pos(303,235)}m 560 15 l 15 15 15 70 560 70
Dialogue: 1,0:10:13.18,0:10:14.30,sign_1188_onscreen_headlines,SIGN,0,0,0,,{\pos(320,223)}لصوص المجوهرات يستخدمون وسائل التواصل لجذب شركاء؟
Dialogue: 1,0:10:14.30,0:10:15.43,sign_1188_onscreen_headlines,SIGN,0,0,0,,{\pos(480,218)\fscx85}لقطات كاميرات المراقبة\Nمقدمة من مشاهد
Dialogue: 0,0:10:14.30,0:10:15.43,sign_note,SIGN,0,0,0,,{\an3\p1\shad0\bord3\c&HF5F5F3&\3c&H875CC0&\4c&H8B5E42&\pos(590,235)}m 260 15 l 15 15 15 80 260 80
Dialogue: 0,0:10:15.76,0:10:18.80,Default,,0,0,0,,زعيم عصابة الجرائم المؤجرة
Dialogue: 0,0:10:18.80,0:10:24.13,Default,,0,0,0,,.لا بد أنه حصل على كثير من الخواتم والقلائد والتيجان باهظة الثمن
Dialogue: 0,0:10:24.75,0:10:27.52,Default,,0,0,0,,.لكن لا يوجد أي دليل على بيعها داخل البلاد
Dialogue: 0,0:10:27.52,0:10:31.94,Default,,0,0,0,,.إذن هل يخططون لتهريبها خارج البلاد
Dialogue: 0,0:10:31.94,0:10:38.46,Default,,0,0,0,,.أنشأنا أمنًا في كل مطار وميناء في البلاد لوقفهم
Dialogue: 0,0:10:38.46,0:10:41.47,Default,,0,0,0,,.وانتظرنا للإمساك بزعيمهم
Dialogue: 0,0:10:42.07,0:10:48.96,Default,,0,0,0,,.لكن اليوم تمت سرقة محل مجوهرات آخر
Dialogue: 0,0:10:48.96,0:10:52.13,Default,,0,0,0,,.توجهنا إلى هناك على الفور
Dialogue: 0,0:10:52.60,0:10:58.70,Default,,0,0,0,,!لكن لدهشتنا تم القبض على اللصوص من قبل الموظفات
Dialogue: 0,0:10:59.14,0:11:02.27,Default,,0,0,0,,.ومن المذهل أنه لم يكن هناك أي ضرر
Dialogue: 0,0:11:02.59,0:11:04.74,Default,,0,0,0,,!إنه أمر فوضوي للغاية
Dialogue: 0,0:11:05.18,0:11:10.65,Default,,0,0,0,,موري هل نتعامل مع شخص يستمتع باللعب بالشرطة من أجل المتعة؟
Dialogue: 0,0:11:10.65,0:11:12.46,Default,,0,0,0,,من أجل المتعة؟
Dialogue: 0,0:11:12.46,0:11:16.34,Default,,0,0,0,,.فهمت سأخبرك إذا عرفت أي شيء
Dialogue: 0,0:11:16.34,0:11:18.31,Default,,0,0,0,,.سأنتظر
Dialogue: 0,0:11:24.31,0:11:29.21,Default,,0,0,0,,.إذن من رشح المسن ليكون قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:11:29.21,0:11:35.16,Default,,0,0,0,,...قضيتان في نفس الوقت هل هي محض صدفة
Dialogue: 0,0:11:35.16,0:11:39.82,Default,,0,0,0,,.وأين المجوهرات المسروقة
Dialogue: 0,0:11:47.23,0:11:50.89,Default,,0,0,0,,هل هاتان القضيتان مرتبطتان؟
Dialogue: 0,0:11:55.02,0:11:57.35,Default,,0,0,0,,.ظننت أنك عدت إلى الييت يا عمي
Dialogue: 0,0:11:57.35,0:12:01.17,Default,,0,0,0,,."قالت ران إن "قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم لطيفة
Dialogue: 0,0:12:01.17,0:12:03.99,Default,,0,0,0,,!أعتقد أنه لطيف أيضًا
Dialogue: 0,0:12:04.85,0:12:08.00,Default,,0,0,0,,!بطبيعة الحال أعتقد أنه لطيف أيضًا
Dialogue: 0,0:12:08.00,0:12:13.13,Default,,0,0,0,,.حالما ترى المصنع المكتمل سيتم حل أي سوء تفاهم
Dialogue: 0,0:12:13.13,0:12:17.02,Default,,0,0,0,,.سترى مدى أهمية هذا الحدث لمدينة فوراي
Dialogue: 0,0:12:17.02,0:12:17.92,Default,,0,0,0,,!مهم أليس كذلك
Dialogue: 0,0:12:17.92,0:12:21.00,Default,,0,0,0,,.المصنع يستخدم روبوتات متطورة
Dialogue: 0,0:12:21.00,0:12:24.76,Default,,0,0,0,,.لفرم اللحم والخضروات تلقائيًا وبشكل ناعم و...
Dialogue: 0,0:12:24.76,0:12:28.14,Default,,0,0,0,,فرم ناعم؟
Dialogue: 0,0:12:32.48,0:12:34.48,Default,,0,0,0,,!إنها ليست صدفة
Dialogue: 0,0:12:35.48,0:12:39.11,Default,,0,0,0,,!لقد وجدت الخيط الرابط بين القضيتين
Dialogue: 0,0:12:39.11,0:12:42.23,Default,,0,0,0,,.كمدينة للأطعمة المقلية
Dialogue: 0,0:12:42.23,0:12:46.12,Default,,0,0,0,,.تأمل مدينة فوراي في إنشاء متحف للأطعمة المجمدة و...
Dialogue: 0,0:12:44.04,0:12:46.12,Default,,0,0,0,,{\an8}!حسنًا حسنًا فهمت
Dialogue: 0,0:12:48.88,0:12:51.37,Default,,0,0,0,,مرحبًا، موري؟
Dialogue: 0,0:12:51.37,0:12:56.38,Default,,0,0,0,,...!يا مفتش ميغوري لقد كشفت في الواقع الحقيقة وراء؟
Dialogue: 0,0:12:57.21,0:12:58.52,Default,,0,0,0,,موري؟
Dialogue: 0,0:12:57.72,0:12:59.79,Default,,0,0,0,,{\an8}!ها هو نعم هذا هو
Dialogue: 0,0:12:59.79,0:13:02.26,Default,,0,0,0,,.تقصد شيئك المعتاد
Dialogue: 0,0:13:02.26,0:13:05.84,Default,,0,0,0,,...كوغورو النائم مستعد للكشف عن استنتاجاته النائمة
Dialogue: 0,0:13:05.84,0:13:10.27,Default,,0,0,0,,...لا إنها استنتاجات كوغورو النائم غير المرئية وهو نائم
Dialogue: 0,0:13:10.75,0:13:17.43,Default,,0,0,0,,.كلاً انا وأنت كنا ضحيتين لحوادث غريبة ظنّا أنها مجرد مزاح
Dialogue: 0,0:13:17.43,0:13:22.27,Default,,0,0,0,,.ومع ذلك كانت هذه في الواقع تحويلات للانتباه جعلت لتظهر بهذا الشكل
Dialogue: 0,0:13:22.27,0:13:25.16,Default,,0,0,0,,.لا أفهم
Dialogue: 0,0:13:25.16,0:13:32.34,Default,,0,0,0,,!لقد جذبت إلى سرقة محل مجوهرات لم تُسرق فيه أي شيء
Dialogue: 0,0:13:33.09,0:13:37.61,Default,,0,0,0,,.بينما رشحني شخص يدعي أنه أنت
Dialogue: 0,0:13:37.61,0:13:40.55,Default,,0,0,0,,.لأكون "قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:13:40.55,0:13:42.78,Default,,0,0,0,,ادع أنه أنا؟
Dialogue: 0,0:13:42.78,0:13:46.04,Default,,0,0,0,,وما هو "قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم؟
Dialogue: 0,0:13:46.46,0:13:53.20,Default,,0,0,0,,!زعيم عصابة الجرائم المؤجرة المسؤولة عن سلسلة السرقات
Dialogue: 0,0:13:53.20,0:13:59.32,Default,,0,0,0,,.فعل كل هذا لتثبيتنا في مكاننا
Dialogue: 0,0:14:00.39,0:14:03.82,Default,,0,0,0,,ماذا خطط الزعيم أن يفعل خلال ذلك الوقت؟
Dialogue: 0,0:14:04.17,0:14:06.16,Default,,0,0,0,,!استخدام مصنع الأطعمة المجمدة
Dialogue: 0,0:14:06.16,0:14:07.95,Default,,0,0,0,,مصنع الأطعمة المجمدة؟
Dialogue: 0,0:14:08.36,0:14:14.15,Default,,0,0,0,,.لا يمكن فرم الخواتم والقلائد والتيجان المسروقة بشكل ناعم
Dialogue: 0,0:14:14.95,0:14:18.96,Default,,0,0,0,,.لكن يمكن إزالة كل حجر كريم فردي
Dialogue: 0,0:14:19.59,0:14:24.97,Default,,0,0,0,,.على الأرجح تسللوا إلى المصنع الذي كان مغلقًا بسبب حدث مدينة فوراي
Dialogue: 0,0:14:25.42,0:14:30.41,Default,,0,0,0,,.ووضعوا الأحجار الكريمة في اللحم المفروم والخضروات
Dialogue: 0,0:14:30.41,0:14:32.99,Default,,0,0,0,,.وشكلوها على هيئة كتل وكروكيت غير مطبوخة
Dialogue: 0,0:14:32.99,0:14:37.97,Default,,0,0,0,,.وأنتجوا شرائح لحم مفروم وكروكيت مجمدة تحتوي على أحجار كريمة
Dialogue: 0,0:14:37.97,0:14:39.23,Default,,0,0,0,,.ووضعوها في صناديق
Dialogue: 0,0:14:40.95,0:14:46.89,Default,,0,0,0,,!يحاول الزعيم تهريب شرائح اللحم والكروكيت التي تحتوي على أحجار كريمة
Dialogue: 0,0:14:47.57,0:14:50.98,Default,,0,0,0,,!من فضلك توجه إلى مصنع الأطعمة المجمدة في مدينة فوراي على الفور
Dialogue: 0,0:14:52.12,0:14:57.60,Default,,0,0,0,,.لنلملم قوانا ونلتقط صورة تذكارية لضيوفنا
Dialogue: 0,0:14:58.25,0:15:00.49,Default,,0,0,0,,.ابتسموا جميعًا
Dialogue: 0,0:15:00.49,0:15:02.76,Default,,0,0,0,,!يا معلمي موري أرني ابتسامة أوسع
Dialogue: 0,0:15:02.76,0:15:06.13,Default,,0,0,0,,."ها نحن ذا قولوا "تشيز
Dialogue: 0,0:15:06.62,0:15:08.99,Default,,0,0,0,,ماذا الصورة مشوشة؟
Dialogue: 0,0:15:08.99,0:15:10.64,Default,,0,0,0,,.لنجرب التقاط أخرى
Dialogue: 0,0:15:10.64,0:15:12.95,Default,,0,0,0,,.أعطني ابتسامة أخرى
Dialogue: 0,0:15:12.95,0:15:16.12,Default,,0,0,0,,!هيا يا معلم موري انظر إلى هنا
Dialogue: 0,0:15:16.12,0:15:19.48,Default,,0,0,0,,!وقت مستقطع مرحبًا
Dialogue: 0,0:15:19.48,0:15:22.35,Default,,0,0,0,,!كنت محقًا يا موري
Dialogue: 0,0:15:22.35,0:15:23.74,Default,,0,0,0,,أيها المفتش؟
Dialogue: 0,0:15:23.74,0:15:24.81,Default,,0,0,0,,.نعم
Dialogue: 0,0:15:26.15,0:15:29.61,Default,,0,0,0,,!نعم ماذا مصنع الأطعمة المجمدة
Dialogue: 0,0:15:30.13,0:15:32.79,Default,,0,0,0,,.فهمت أيها المفتش
Dialogue: 0,0:15:33.11,0:15:34.73,Default,,0,0,0,,.إلى اللقاء
Dialogue: 0,0:15:34.73,0:15:36.04,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:15:36.04,0:15:41.03,Default,,0,0,0,,.لست متأكدًا لكن المفتش قال أن نسرع إلى مصنع الأطعمة المجمدة
Dialogue: 0,0:15:41.03,0:15:43.68,Default,,0,0,0,,!لكن ماذا عن تقديم المسابقة
Dialogue: 0,0:15:43.68,0:15:46.28,Default,,0,0,0,,.أيها العمدة هل يمكنك الانحناء
Dialogue: 0,0:15:46.28,0:15:47.30,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:47.30,0:15:51.68,Default,,0,0,0,,.الآن أنت قطعة الكروكيت المجمد" لهذا اليوم
Dialogue: 0,0:15:51.68,0:15:54.00,Default,,0,0,0,,.وأيضًا...
Dialogue: 0,0:15:54.00,0:15:56.06,Default,,0,0,0,,.الآن أنت "قطعة شرائح اللحم المفروم المجمدة" لهذا اليوم
Dialogue: 0,0:15:56.06,0:15:57.56,Default,,0,0,0,,.وأيضًا...
Dialogue: 0,0:15:57.56,0:15:59.94,Default,,0,0,0,,.يمكنك أن تكون "قطعة القريدس المقلي المجمد" لهذا اليوم أيضًا
Dialogue: 0,0:16:01.61,0:16:04.10,Default,,0,0,0,,!الآن يمكنك تقديم الحفل كجميعهم
Dialogue: 0,0:16:04.10,0:16:07.45,Default,,0,0,0,,...أبدو مثل تشكيلة أطعمة مقلية
Dialogue: 0,0:16:10.07,0:16:11.57,Default,,0,0,0,,!هذا هو المبنى
Dialogue: 0,0:16:11.57,0:16:13.48,Default,,0,0,0,,.عفوا
Dialogue: 0,0:16:14.10,0:16:16.53,Default,,0,0,0,,.الشرطة لم تصل بعد
Dialogue: 0,0:16:16.53,0:16:18.54,Default,,0,0,0,,.لننتظر حتى يصل المفتش
Dialogue: 0,0:16:24.42,0:16:25.54,Default,,0,0,0,,!موري
Dialogue: 0,0:16:25.54,0:16:26.68,Default,,0,0,0,,أيها المفتش؟
Dialogue: 0,0:16:26.68,0:16:28.30,Default,,0,0,0,,!لقد نالوا منا
Dialogue: 0,0:16:28.30,0:16:29.49,Default,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:16:29.49,0:16:34.47,Default,,0,0,0,,.اللصوص الذين اعتقلناهم في محل المجوهرات كانوا جميعًا مسنين
Dialogue: 0,0:16:34.47,0:16:36.77,Default,,0,0,0,,لصوص مسنون يؤجرون أنفسهم؟
Dialogue: 0,0:16:36.77,0:16:37.98,Default,,0,0,0,,.نعم
Dialogue: 0,0:16:37.98,0:16:42.33,Default,,0,0,0,,...أثناء الاستجواب الأصغر بينهم
Dialogue: 0,0:16:43.41,0:16:46.48,Default,,0,0,0,,!أصيب بنوبة قلبية فجأة
Dialogue: 0,0:16:46.95,0:16:49.96,Default,,0,0,0,,.أخذناه للتو إلى مستشفى الشرطة
Dialogue: 0,0:16:49.96,0:16:51.42,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:16:51.42,0:16:52.72,Default,,0,0,0,,.انظروا
Dialogue: 0,0:16:56.37,0:16:57.37,Default,,0,0,0,,!هذا هو
Dialogue: 0,0:16:57.37,0:16:59.59,Default,,0,0,0,,!ألقوا القبض عليهم
Dialogue: 0,0:17:16.06,0:17:17.10,Default,,0,0,0,,!طائرات
Dialogue: 0,0:17:19.35,0:17:21.14,Default,,0,0,0,,من أين يتم التحكم بها؟
Dialogue: 0,0:17:22.30,0:17:25.36,Default,,0,0,0,,!الزعيم ليس هنا
Dialogue: 0,0:17:25.36,0:17:26.62,Default,,0,0,0,,!تبًا
Dialogue: 0,0:17:28.47,0:17:29.49,Default,,0,0,0,,!اركب
Dialogue: 0,0:17:40.42,0:17:42.72,Default,,0,0,0,,!يستخدمون المبنى كوسيلة تمويه للهروب
Dialogue: 0,0:17:42.72,0:17:46.41,Default,,0,0,0,,.حسنًا سأتصل بسائقي التاكسي الآخرين في المنطقة
Dialogue: 0,0:17:46.41,0:17:50.94,Default,,0,0,0,,.أطلب المساعدة في تتبع حاوية تنقلها أربع طائرات
Dialogue: 0,0:17:50.94,0:17:51.88,Default,,0,0,0,,.أكرر
Dialogue: 0,0:17:51.88,0:17:56.82,Default,,0,0,0,,.أطلب المساعدة في تتبع حاوية تنقلها أربع طائرات
Dialogue: 0,0:17:58.79,0:18:01.26,Default,,0,0,0,,!إنها فوق تقاطع في الشارع الثالث
Dialogue: 0,0:18:01.63,0:18:02.56,Default,,0,0,0,,الشارع الثالث؟
Dialogue: 0,0:18:07.82,0:18:09.03,Default,,0,0,0,,!ها هي
Dialogue: 0,0:18:09.03,0:18:10.52,Default,,0,0,0,,!سيد إيشيكاوا من هذا الطريق
Dialogue: 0,0:18:10.52,0:18:11.15,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:18:11.15,0:18:13.28,Default,,0,0,0,,!تبًا اختبأوا خلف مبنى آخر
Dialogue: 0,0:18:13.28,0:18:17.43,Default,,0,0,0,,.أطلب المساعدة في تتبع حاوية تنقلها أربع طائرات
Dialogue: 0,0:18:17.43,0:18:20.16,Default,,0,0,0,,!أرى حاوية غريبة فوق مطعم توكيوا
Dialogue: 0,0:18:22.79,0:18:24.44,Default,,0,0,0,,!ذهبت من هذا الطريق
Dialogue: 0,0:18:22.79,0:18:26.54,sign_1188_restaurant,SIGN,0,0,0,,{\pos(317,40)\an2\yshad1\3c&H5F5F75&}مطعم توكيوا
Dialogue: 0,0:18:24.86,0:18:26.54,Default,,0,0,0,,!شكرًا على المساعدة
Dialogue: 0,0:18:27.10,0:18:29.17,Default,,0,0,0,,ما ذلك المبنى الكبير أمامنا؟
Dialogue: 0,0:18:29.48,0:18:33.17,Default,,0,0,0,,!أعتقد أن هذا مستشفى الشرطة
Dialogue: 0,0:18:31.17,0:18:33.17,sign_1188_onscreen_gps,SIGN,0,0,0,,{\an9\move(305,30,305,51)}مستشفى شرطة توتو فوراي
Dialogue: 0,0:18:33.17,0:18:34.88,Default,,0,0,0,,مستشفى الشرطة؟
Dialogue: 0,0:18:36.12,0:18:39.75,Default,,0,0,0,,...الأصغر بينهم أصيب بنوبة قلبية فجأة
Dialogue: 0,0:18:39.75,0:18:42.43,Default,,0,0,0,,.أخذناه إلى مستشفى الشرطة
Dialogue: 0,0:18:45.69,0:18:47.47,Default,,0,0,0,,!الجاني موجود هناك
Dialogue: 0,0:18:47.47,0:18:48.84,Default,,0,0,0,,!فهمت
Dialogue: 0,0:18:57.20,0:19:00.23,Default,,0,0,0,,ماذا لص مسن صغير يؤجر نفسه؟
Dialogue: 0,0:19:00.23,0:19:04.96,Default,,0,0,0,,.المحقق العظيم موري كوغورو والمفتش ميغوري من شرطة العاصمة طلبا مني أن أطمئن عليه
Dialogue: 0,0:19:08.29,0:19:10.47,Default,,0,0,0,,!الطابق الخامس عشر من فضلك
Dialogue: 0,0:19:25.31,0:19:26.56,Default,,0,0,0,,!لن تفلت
Dialogue: 0,0:19:41.93,0:19:43.83,Default,,0,0,0,,!لا يمكنك الهروب الآن
Dialogue: 0,0:19:44.54,0:19:49.40,Default,,0,0,0,,!لا بد أنك زعيم عصابة الجرائم المؤجرة ولصوص المجوهرات
Dialogue: 0,0:19:55.07,0:19:56.30,Default,,0,0,0,,!توقف
Dialogue: 0,0:19:59.22,0:20:00.22,Default,,0,0,0,,!تبًا
Dialogue: 0,0:20:14.52,0:20:16.03,Default,,0,0,0,,إلى أين يتجه؟
Dialogue: 0,0:20:18.20,0:20:19.78,Default,,0,0,0,,!هناك
Dialogue: 0,0:20:19.78,0:20:24.54,Default,,0,0,0,,!سيد إيشيكاوا الزعيم يخطط للمرور تحت ذلك الجسر الكبير
Dialogue: 0,0:20:24.80,0:20:27.07,Default,,0,0,0,,.سيستخدم القارب المشبوه الراسي على الماء
Dialogue: 0,0:20:27.07,0:20:32.04,Default,,0,0,0,,!لتهريب شرائح اللحم والكروكيت المجمدة التي تحتوي على المجوهرات
Dialogue: 0,0:20:32.04,0:20:37.05,sign_1188_onscreen_diagram,SIGN,0,0,0,,{\an3\pos(620,118)}\hالجاني\h\h
Dialogue: 0,0:20:32.04,0:20:37.05,sign_1188_onscreen_diagram,SIGN,0,0,0,,{\an3\pos(612,230)}\hتاكسي\h
Dialogue: 0,0:20:32.04,0:20:37.05,sign_1188_onscreen_diagram,SIGN,0,0,0,,{\an1\pos(64,269)}قارب مشبوه\h
Dialogue: 0,0:20:32.48,0:20:37.05,Default,,0,0,0,,!إذا واصلنا المسار سنصطدم مباشرة بطائرات الجاني
Dialogue: 0,0:20:37.05,0:20:39.69,Default,,0,0,0,,.حسنًا اترك الباقي لي
Dialogue: 0,0:20:41.30,0:20:43.00,Default,,0,0,0,,!انطلقي
Dialogue: 0,0:21:11.24,0:21:15.46,Default,,0,0,0,,!تم القبض على زعيم الجريمة في الساعة 4:15 مساءً
Dialogue: 0,0:21:18.09,0:21:19.28,Default,,0,0,0,,!لقد فعلتها
Dialogue: 0,0:21:19.28,0:21:22.31,Default,,0,0,0,,!تم القبض على زعيم عصابة جريمة دولية
Dialogue: 0,0:21:22.31,0:21:25.10,Default,,0,0,0,,!من المؤكد أنهم سيمنحونني جائزة على هذا
Dialogue: 0,0:21:25.49,0:21:27.95,Default,,0,0,0,,...كان ذلك تصرفًا فادحًا لمبدأ المسؤولية
Dialogue: 0,0:21:29.09,0:21:34.57,DC-ED,,0,0,0,,‫الوقت يمضي، مرة أخرى
Dialogue: 0,0:21:34.97,0:21:39.15,DC-ED,,0,0,0,,‫أن أصادف أزهار الكرز
Dialogue: 0,0:21:39.96,0:21:45.27,DC-ED,,0,0,0,,‫قلبي يترقّب قدومك بفارغ الصبر
Dialogue: 0,0:21:45.46,0:21:50.31,DC-ED,,0,0,0,,‫كالزهرة المتفتحة
Dialogue: 0,0:21:50.86,0:21:56.70,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:22:02.58,0:22:11.69,DC-ED,,0,0,0,,‫مشاعر الاشتياق التي لا تُقابل باللقاء
Dialogue: 0,0:22:13.24,0:22:17.13,DC-ED,,0,0,0,,‫تستمر بلا نهاية
Dialogue: 0,0:22:17.28,0:22:22.66,DC-ED,,0,0,0,,‫رغم محاولاتي المتكررة للنسيان
Dialogue: 0,0:22:24.02,0:22:26.07,DC-ED,,0,0,0,,‫أخبرتني
Dialogue: 0,0:22:26.07,0:22:29.13,DC-ED,,0,0,0,,‫كل المشاعر الدافئة
Dialogue: 0,0:22:29.13,0:22:33.53,DC-ED,,0,0,0,,‫لا تفارقني
Dialogue: 0,0:22:41.81,0:22:47.71,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:22:49.83,0:22:55.12,Default,,0,0,0,,.بغض النظر عن الجائزة المحتملة للسيد إيشيكاوا جينكي مقابل جهوده
Dialogue: 0,0:22:55.12,0:22:59.74,Default,,0,0,0,,.بعد أن تم إنقاذه وإعادته إلى الشاطئ بمساعدة شرطة النهر
Dialogue: 0,0:22:59.74,0:23:02.65,Default,,0,0,0,,...وتلقي توبيخًا من المفتش ميغوري
Dialogue: 0,0:23:03.90,0:23:07.91,Default,,0,0,0,,!الساعة متأخرة لكننا لم ننتهِ بعد
Dialogue: 0,0:23:07.91,0:23:12.97,Default,,0,0,0,,!المتسابق التالي في مسابقة أزياء المجمدات المصنوعة يدويًا يقدم
Dialogue: 0,0:23:12.97,0:23:20.42,Default,,0,0,0,,...شاهدنا عمدة تشكيلة الأطعمة المقلية يقدم مسابقة أزياء المجمدات المصنوعة يدويًا
Dialogue: 0,0:23:22.60,0:23:26.77,Default,,0,0,0,,.سيارة سائق التاكسي المتوقفة تحت الأضواء
Dialogue: 0,0:23:27.80,0:23:31.36,Default,,0,0,0,,.سيارتك تعيق الطريق من فضلك أرجو نقلها
Dialogue: 0,0:23:31.36,0:23:36.88,Default,,0,0,0,,.أكرر سيارة سائق التاكسي المتوقفة تحت الأضواء
Dialogue: 0,0:23:35.11,0:23:36.14,Default,,0,0,0,,{\an8}!تبًا
Dialogue: 0,0:23:44.99,0:24:09.01,sign_episode_preview,SIGN,0,0,0,, في الحلقة القادمة 
