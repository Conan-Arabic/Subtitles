Dialogue: 0,0:00:20.69,0:00:22.59,Default,,0,0,0,,‫قلبٌ قويّ، مع استنتاجٍ وقوّة.
Dialogue: 0,0:00:22.59,0:00:24.49,Default,,0,0,0,,‫وخُطوةٌ إلى الجوهر… بإيقاعٍ صاخب.
Dialogue: 0,0:00:24.49,0:00:26.19,Default,,0,0,0,,‫قضيةُ اليوم استثنائية… مليئةٌ بالحيل.
Dialogue: 0,0:00:26.19,0:00:28.09,Default,,0,0,0,,‫حلقةٌ ضخمة… ممتعةٌ حتى الامتلاء.
Dialogue: 0,0:00:28.09,0:00:29.59,Default,,0,0,0,,‫يرى الحقيقةَ الوحيدةَ… دون سواها.
Dialogue: 0,0:00:29.59,0:00:31.49,Default,,0,0,0,,‫طفلٌ في المظهر… بعقلِ بالغٍ.
Dialogue: 0,0:00:31.49,0:00:33.79,Default,,0,0,0,,‫اسمه: المحقّق كونان!
Dialogue: 0,0:01:54.53,0:01:56.23,Default,,0,0,0,,‫"مدخلُ المتاهة:"
Dialogue: 0,0:01:58.18,0:01:59.42,Default,,0,0,0,,‫"غضبُ تمثالِ الإلهةِ العملاق"
Dialogue: 0,0:01:59.53,0:02:01.83,Default,,0,0,0,,‫"جبلُ تنبو، تمثالُ الإلهة" — على مدى مئات السنين،
Dialogue: 0,0:02:01.83,0:02:03.63,Default,,0,0,0,,‫كانت إلهةُ جبلِ تنبو،
Dialogue: 0,0:02:03.63,0:02:06.13,Default,,0,0,0,,‫تُعبَدُ من أهلِ القرية،
Dialogue: 0,0:02:06.13,0:02:09.23,Default,,0,0,0,,‫وتحمي سلامَها.
Dialogue: 0,0:02:09.83,0:02:12.13,Default,,0,0,0,,‫لكنّ من أغضبَ الإلهة…
Dialogue: 0,0:02:12.13,0:02:15.13,Default,,0,0,0,,‫ماتَ ميتةً قاسية.
Dialogue: 0,0:02:15.13,0:02:16.53,Default,,0,0,0,,‫هكذا تقول الحكايات!
Dialogue: 0,0:02:22.83,0:02:24.73,Default,,0,0,0,,‫يا له من فعلٍ مُروِّع…
Dialogue: 0,0:02:24.73,0:02:27.83,Default,,0,0,0,,‫أن يحفروا نفقًا في جبلٍ صخري،
Dialogue: 0,0:02:27.83,0:02:29.63,Default,,0,0,0,,‫تقوم عليه الإلهة!
Dialogue: 0,0:02:29.63,0:02:32.33,Default,,0,0,0,,‫لعنةُ السماء…
Dialogue: 0,0:02:32.33,0:02:35.83,Default,,0,0,0,,‫ستحلّ بهم لا محالة!
Dialogue: 0,0:02:38.33,0:02:40.03,Default,,0,0,0,,‫ذاك… تمثالُ الإلهة، أليس كذلك؟
Dialogue: 0,0:02:40.03,0:02:41.23,Default,,0,0,0,,‫نعم!
Dialogue: 0,0:02:41.23,0:02:45.33,Default,,0,0,0,,‫وحتى ذلك التلفريكُ البشعُ واضحٌ للعيان.
Dialogue: 0,0:02:45.33,0:02:48.13,Default,,0,0,0,,‫إلى أين أنتم ذاهبون؟
Dialogue: 0,0:02:48.13,0:02:51.63,Default,,0,0,0,,‫حسنًا… لسنا متأكدين تمامًا…
Dialogue: 0,0:02:51.63,0:02:55.13,Default,,0,0,0,,‫لكننا ذاهبون إلى ذلك التلفريكِ البشع.
Dialogue: 0,0:02:58.83,0:03:01.63,Default,,0,0,0,,‫"محطّة تنبو"
Dialogue: 0,0:03:05.43,0:03:08.23,Default,,0,0,0,,‫أنتَ السيد كوغورو موري، أليس كذلك؟
Dialogue: 0,0:03:08.23,0:03:10.73,Default,,0,0,0,,‫نعم! يا لها من فاتنة.
Dialogue: 0,0:03:10.73,0:03:12.63,Default,,0,0,0,,‫إذًا… جئتِ لاستقبالِنا؟
Dialogue: 0,0:03:12.63,0:03:14.73,Default,,0,0,0,,‫نعم، كنّا بانتظاركم.
Dialogue: 0,0:03:14.73,0:03:17.53,Default,,0,0,0,,‫"آياكا يوشينو (23)" — أنا سكرتيرةُ نائبِ رئيسِ شركة دوموتو تورز،
Dialogue: 0,0:03:17.53,0:03:19.63,Default,,0,0,0,,‫آياكا يوشينو.
Dialogue: 0,0:03:19.63,0:03:23.23,Default,,0,0,0,,‫أعتذر حقًا لأنني أحضرتُ الأطفالَ معي.
Dialogue: 0,0:03:23.23,0:03:27.13,Default,,0,0,0,,‫أنا ران موري، وهذا كونان… يقيمُ معنا الآن.
Dialogue: 0,0:03:27.13,0:03:28.33,Default,,0,0,0,,‫مرحبًا.
Dialogue: 0,0:03:28.33,0:03:31.43,Default,,0,0,0,,‫أهلًا! تشرفتُ بك يا كونان.
Dialogue: 0,0:03:36.53,0:03:37.93,Default,,0,0,0,,‫إنها مزدحمةٌ فعلًا.
Dialogue: 0,0:03:37.93,0:03:41.73,Default,,0,0,0,,‫نعم… إنهم يحاولون إنعاشَ البلدة عبر السياحة.
Dialogue: 0,0:03:48.03,0:03:50.43,Default,,0,0,0,,‫إنه لشرفٌ كبيرٌ أن تحضروا،
Dialogue: 0,0:03:50.43,0:03:54.03,Default,,0,0,0,,‫أيها المحقّق موري الشهير،
Dialogue: 0,0:03:54.03,0:03:55.33,Default,,0,0,0,,‫حفلَ الافتتاح غدًا.
Dialogue: 0,0:03:55.33,0:03:57.93,Default,,0,0,0,,‫لا بأس، يا آنسة… بَني.
Dialogue: 0,0:04:02.23,0:04:05.93,Default,,0,0,0,,‫يبدو أن هناك من يعارضُ التلفريك.
Dialogue: 0,0:04:05.93,0:04:08.23,Default,,0,0,0,,‫ويبدو أنك لم تدعُني
Dialogue: 0,0:04:08.23,0:04:12.83,Default,,0,0,0,,‫لأجل الحفل فقط… أليس كذلك؟
Dialogue: 0,0:04:12.83,0:04:17.13,Default,,0,0,0,,‫نعم، سيخبرك الرئيسُ بالتفاصيل.
Dialogue: 0,0:04:19.23,0:04:21.93,Default,,0,0,0,,‫"استراحةُ تلفريك جبل تنبو"
Dialogue: 0,0:04:21.93,0:04:24.03,Default,,0,0,0,,‫اسمُ المحقّق موري الذائعُ الصيت
Dialogue: 0,0:04:24.03,0:04:27.13,Default,,0,0,0,,‫معروفٌ حتى في هذه القرية الريفية.
Dialogue: 0,0:04:27.13,0:04:29.43,Default,,0,0,0,,‫"إيزو دوموتو (65)" — وأنا واثقٌ بأن
Dialogue: 0,0:04:29.43,0:04:31.93,Default,,0,0,0,,‫حفلَ الافتتاح سيكون حدثًا عظيمًا.
Dialogue: 0,0:04:31.93,0:04:35.53,Default,,0,0,0,,‫لا مشكلة. إن استطعتُ أن أكونَ عونًا، فهذا يسعدني.
Dialogue: 0,0:04:35.53,0:04:38.53,Default,,0,0,0,,‫"ياسونوري دوموتو (40)" — في الحقيقة، ثمة سببٌ آخر
Dialogue: 0,0:04:38.53,0:04:40.33,Default,,0,0,0,,‫دعوناك من أجله يا سيد موري.
Dialogue: 0,0:04:40.33,0:04:43.73,Default,,0,0,0,,‫هناك كثيرون يعارضون افتتاح التلفريك،
Dialogue: 0,0:04:43.73,0:04:47.63,Default,,0,0,0,,‫لذا تريد أن تضمن سيرَ الحفل بأمان… صحيح؟
Dialogue: 0,0:04:47.63,0:04:49.63,Default,,0,0,0,,‫"جونبي دوموتو (30)" — كما توقعتُ منك تمامًا.
Dialogue: 0,0:04:49.63,0:04:51.63,Default,,0,0,0,,‫الذين سيفرحون به حقًا
Dialogue: 0,0:04:51.63,0:04:55.13,Default,,0,0,0,,‫هم أصحابُ المتاجر… ومن سيجنون الأرباح.
Dialogue: 0,0:04:55.13,0:04:57.63,Default,,0,0,0,,‫أبي يتعاملُ بأسلوبٍ هجوميّ،
Dialogue: 0,0:04:57.63,0:04:59.13,Default,,0,0,0,,‫وله أعداءٌ كُثر.
Dialogue: 0,0:04:59.13,0:05:00.93,Default,,0,0,0,,‫ولهذا استقللتُ مبكرًا،
Dialogue: 0,0:05:00.93,0:05:03.53,Default,,0,0,0,,‫وأسستُ تجارةَ استيرادٍ وتصديرٍ للسلع المتنوعة.
Dialogue: 0,0:05:03.53,0:05:06.03,Default,,0,0,0,,‫وبما أن تجارتك لا تسيرُ جيدًا،
Dialogue: 0,0:05:06.03,0:05:09.43,Default,,0,0,0,,‫ألَم تأتِ اليوم لتطلبَ من أبي مساعدةً ماليةً مجددًا؟
Dialogue: 0,0:05:09.43,0:05:10.43,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:05:10.43,0:05:13.73,Default,,0,0,0,,‫أنا في البيت! اشتقتُ إليك يا أبي!
Dialogue: 0,0:05:13.73,0:05:15.53,Default,,0,0,0,,‫أوصلتِ للتوّ من طوكيو؟
Dialogue: 0,0:05:15.53,0:05:18.23,Default,,0,0,0,,‫نعم! إنه حدثٌ كبيرٌ لك في النهاية.
Dialogue: 0,0:05:18.23,0:05:20.83,Default,,0,0,0,,‫"رينا دوموتو (24)" — كنتُ سأأتي مهما كان.
Dialogue: 0,0:05:20.83,0:05:22.43,Default,,0,0,0,,‫أوه، هيا…
Dialogue: 0,0:05:22.43,0:05:23.63,Default,,0,0,0,,‫بعد أن غادرتِ البيت،
Dialogue: 0,0:05:23.63,0:05:24.93,Default,,0,0,0,,‫عشتِ كما تشتهين
Dialogue: 0,0:05:24.93,0:05:26.33,Default,,0,0,0,,‫لسنةٍ كاملة.
Dialogue: 0,0:05:26.33,0:05:29.43,Default,,0,0,0,,‫أراهن أنك جئتِ لتطلبي قرضًا أو شيئًا من هذا!
Dialogue: 0,0:05:29.43,0:05:30.73,Default,,0,0,0,,‫يا لوقاحتك!
Dialogue: 0,0:05:30.73,0:05:32.03,Default,,0,0,0,,‫وأنتَ ماذا عنك؟
Dialogue: 0,0:05:32.03,0:05:35.23,Default,,0,0,0,,‫"سياحة"؟ هراء! بعد كل هذا التهكّم والجدال!
Dialogue: 0,0:05:35.23,0:05:39.43,Default,,0,0,0,,‫كفى! بالمناسبة يا رينا… من هذا؟
Dialogue: 0,0:05:39.43,0:05:42.53,Default,,0,0,0,,‫إنه تيتسويا أوياغي، صحفيٌّ حرّ.
Dialogue: 0,0:05:42.53,0:05:44.13,Default,,0,0,0,,‫يقول إنه يريد كتابةَ تقريرٍ عن هذا.
Dialogue: 0,0:05:44.13,0:05:45.83,Default,,0,0,0,,‫"تيتسويا أوياغي (28)" — أنا أوياغي.
Dialogue: 0,0:05:45.83,0:05:47.83,Default,,0,0,0,,‫سمعتُ ما مررتم به
Dialogue: 0,0:05:47.83,0:05:49.73,Default,,0,0,0,,‫بخصوص افتتاح التلفريك… من رينا.
Dialogue: 0,0:05:50.83,0:05:52.33,Default,,0,0,0,,‫وسمعتُ أن أمورًا كثيرةً حدثت
Dialogue: 0,0:05:52.33,0:05:54.73,Default,,0,0,0,,‫أثناء حفر النفق.
Dialogue: 0,0:05:54.93,0:05:57.23,Default,,0,0,0,,‫أأنتَ السيد أوياغي؟
Dialogue: 0,0:05:57.23,0:05:59.83,Default,,0,0,0,,‫إذًا أنتَ من يحاول التقرّب من رينا، أليس كذلك؟
Dialogue: 0,0:05:59.83,0:06:01.53,Default,,0,0,0,,‫نعم، أظنني تحدثتُ إليك هاتفيًا.
Dialogue: 0,0:06:01.53,0:06:04.13,Default,,0,0,0,,‫لحظة… ما قصة هذا؟
Dialogue: 0,0:06:06.13,0:06:10.03,Default,,0,0,0,,‫هل يُخفي شيئًا لا يريدُ لأحدٍ أن يعرفه؟
Dialogue: 0,0:06:10.03,0:06:11.13,Default,,0,0,0,,‫سيدي نائب الرئيس،
Dialogue: 0,0:06:11.13,0:06:14.13,Default,,0,0,0,,‫ما رأيك أن نجعل السيد موري ومرافقيه
Dialogue: 0,0:06:14.13,0:06:16.93,Default,,0,0,0,,‫يجرّبون التلفريك… استعدادًا لحفل الغد؟
Dialogue: 0,0:06:16.93,0:06:19.33,Default,,0,0,0,,‫فكرةٌ جيدة! لنفعلها!
Dialogue: 0,0:06:19.33,0:06:22.03,Default,,0,0,0,,‫دعونا نُريكم المنظرَ البديع من المحطة العليا،
Dialogue: 0,0:06:22.03,0:06:25.33,Default,,0,0,0,,‫فخرِ شركة دوموتو تورز واعتزازها.
Dialogue: 0,0:06:25.33,0:06:27.53,Default,,0,0,0,,‫هذا رائعٌ فعلًا.
Dialogue: 0,0:06:27.53,0:06:30.13,Default,,0,0,0,,‫آه… تذكرتُ أن أبي…
Dialogue: 0,0:06:36.83,0:06:40.63,Default,,0,0,0,,‫خروفٌ واحد… خروفان…
Dialogue: 0,0:06:40.63,0:06:44.43,Default,,0,0,0,,‫سيد موري… لا تقل إنك تخافُ المرتفعات؟
Dialogue: 0,0:06:44.43,0:06:47.03,Default,,0,0,0,,‫أنا بخير… ما دمتُ لا أنظرُ إلى الأسفل.
Dialogue: 0,0:06:47.03,0:06:48.43,Default,,0,0,0,,‫يا للروعة.
Dialogue: 0,0:06:48.43,0:06:50.83,Default,,0,0,0,,‫المسافة إلى القمة نحو ثلاثة آلاف متر،
Dialogue: 0,0:06:50.83,0:06:53.13,Default,,0,0,0,,‫وسنصلُ خلال عشر دقائق تقريبًا.
Dialogue: 0,0:06:53.13,0:06:54.33,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:06:55.33,0:06:56.93,Default,,0,0,0,,‫إنها ساحةُ تنزّه.
Dialogue: 0,0:06:56.93,0:06:59.03,Default,,0,0,0,,‫مغلقةٌ حتى الافتتاح للعامة.
Dialogue: 0,0:06:59.03,0:07:01.23,Default,,0,0,0,,‫بعد الصعود بالتلفريك إلى القمة،
Dialogue: 0,0:07:01.23,0:07:03.73,Default,,0,0,0,,‫سيهبط الجميع سيرًا،
Dialogue: 0,0:07:03.73,0:07:06.43,Default,,0,0,0,,‫وهم يستنشقون هواءَ الخضرةِ النقي.
Dialogue: 0,0:07:06.43,0:07:07.43,Default,,0,0,0,,‫أي إن…
Dialogue: 0,0:07:07.43,0:07:12.33,Default,,0,0,0,,‫احتجاجَ السكان حُلّ بتعويضٍ مالي؟
Dialogue: 0,0:07:12.33,0:07:15.83,Default,,0,0,0,,‫ومع ذلك، ما زلنا نتلقى ابتزازًا ومكالماتٍ مزعجة،
Dialogue: 0,0:07:15.83,0:07:18.03,Default,,0,0,0,,‫تطالب بإلغاء افتتاح التلفريك.
Dialogue: 0,0:07:18.03,0:07:20.63,Default,,0,0,0,,‫هل لديكم فكرةٌ عمّن يفعل ذلك؟
Dialogue: 0,0:07:21.63,0:07:24.83,Default,,0,0,0,,‫ليس شخصًا أو اثنين… لذا…
Dialogue: 0,0:07:24.83,0:07:26.23,Default,,0,0,0,,‫ثم إن هناك كاهنةً تُدعى
Dialogue: 0,0:07:26.23,0:07:29.43,Default,,0,0,0,,‫شيزو كامييا… تعيش في معبدٍ قريب،
Dialogue: 0,0:07:29.43,0:07:32.93,Default,,0,0,0,,‫وتُثير ضجةً قائلةً إن الآلهة ستغضب.
Dialogue: 0,0:07:32.93,0:07:35.03,Default,,0,0,0,,‫وكتبت الصحفُ المحلية مقالًا:
Dialogue: 0,0:07:35.03,0:07:37.13,Default,,0,0,0,,‫"هل لعنةُ الإلهة حقيقية؟"
Dialogue: 0,0:07:37.13,0:07:39.03,Default,,0,0,0,,‫وهذا أثار خوفَ السكان،
Dialogue: 0,0:07:39.03,0:07:40.73,Default,,0,0,0,,‫وأوقعنا في مأزق.
Dialogue: 0,0:07:45.93,0:07:49.53,Default,,0,0,0,,‫هاه؟ عربةُ التلفريك الهابطة فارغة، أليس كذلك؟
Dialogue: 0,0:07:49.53,0:07:53.03,Default,,0,0,0,,‫عندما تتحرك واحدة… تتحرك الأخرى.
Dialogue: 0,0:07:53.03,0:07:57.03,Default,,0,0,0,,‫تعمل كدلوِ بئرٍ يصعدُ ويهبط على سلكين،
Dialogue: 0,0:07:57.03,0:07:58.73,Default,,0,0,0,,‫ويُسمّى "ذهابًا وإيابًا".
Dialogue: 0,0:07:58.73,0:08:00.73,Default,,0,0,0,,‫آه، فهمت.
Dialogue: 0,0:08:11.43,0:08:12.93,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:08:12.93,0:08:15.03,Default,,0,0,0,,‫تماثيلُ خمسمئةِ تلميذٍ لبوذا… بلغوا النيرفانا.
Dialogue: 0,0:08:15.03,0:08:16.93,Default,,0,0,0,,‫أي أننا سنقوم بجولةٍ
Dialogue: 0,0:08:16.93,0:08:19.83,Default,,0,0,0,,‫داخل رحمِ الإلهة… من هنا في الأعلى.
Dialogue: 0,0:08:19.83,0:08:21.53,Default,,0,0,0,,‫جولةٌ داخل الرحم؟
Dialogue: 0,0:08:21.53,0:08:23.23,Default,,0,0,0,,‫يعني سننالُ الحظ
Dialogue: 0,0:08:23.23,0:08:25.33,Default,,0,0,0,,‫إن عبرنا جسدَ الإلهة؟
Dialogue: 0,0:08:25.33,0:08:27.23,Default,,0,0,0,,‫يمكن قول ذلك.
Dialogue: 0,0:08:27.23,0:08:30.33,Default,,0,0,0,,‫بالمناسبة… ذلك الرجل أوياغي ذكر شيئًا
Dialogue: 0,0:08:30.33,0:08:33.53,Default,,0,0,0,,‫عن أعمالِ حفرِ هذا النفق… أليس كذلك؟
Dialogue: 0,0:08:33.53,0:08:36.03,Default,,0,0,0,,‫أراهن أنه يحاول صنعَ فضيحةٍ ما
Dialogue: 0,0:08:36.03,0:08:39.13,Default,,0,0,0,,‫ليبتزَّ شركتنا ويأخذ المال.
Dialogue: 0,0:08:39.13,0:08:41.33,Default,,0,0,0,,‫كان على أختي أن تكونَ أكثر حذرًا أيضًا.
Dialogue: 0,0:08:41.33,0:08:43.53,Default,,0,0,0,,‫لماذا أخبرته عن ذلك أصلًا؟
Dialogue: 0,0:08:43.53,0:08:45.13,Default,,0,0,0,,‫عن ذلك؟
Dialogue: 0,0:08:45.13,0:08:46.73,Default,,0,0,0,,‫عن ماذا تحديدًا؟
Dialogue: 0,0:08:46.73,0:08:50.13,Default,,0,0,0,,‫لا شيء… مجرد أمرٍ عائلي لا يستحق الذكر.
Dialogue: 0,0:08:50.13,0:08:52.93,Default,,0,0,0,,‫سنخرج من النفق بعد نحو ثلاثين ثانية.
Dialogue: 0,0:08:58.93,0:09:01.83,Default,,0,0,0,,‫انظروا… عندما يصل التلفريك إلى هنا،
Dialogue: 0,0:09:01.83,0:09:05.23,Default,,0,0,0,,‫يظهر النصفُ العلوي من تمثالِ الإلهة.
Dialogue: 0,0:09:05.23,0:09:06.83,Default,,0,0,0,,‫هذا الجبلُ الصخري نُحت
Dialogue: 0,0:09:06.83,0:09:09.63,Default,,0,0,0,,‫على هيئةِ الإلهة قبل نحو ثمانمئة عام.
Dialogue: 0,0:09:09.63,0:09:14.13,Default,,0,0,0,,‫وذراعُها اليمنى الممتدة تُسمّى "هيئة اليوغانين".
Dialogue: 0,0:09:14.13,0:09:16.73,Default,,0,0,0,,‫وفي يدِها اليسرى تمسك "نيويهوغيو"،
Dialogue: 0,0:09:16.73,0:09:20.13,Default,,0,0,0,,‫كرةً بلوريةً تطرد الكوارثَ وسوء الحظ.
Dialogue: 0,0:09:20.13,0:09:22.13,Default,,0,0,0,,‫ومن أراد التمعّن أكثر،
Dialogue: 0,0:09:22.13,0:09:26.13,Default,,0,0,0,,‫فهناك مرصدٌ يمكن الوصولُ إليه عبر الممرّ.
Dialogue: 0,0:09:28.53,0:09:32.53,Default,,0,0,0,,‫أفهم الآن… لماذا كانت الكاهنةُ غاضبة.
Dialogue: 0,0:09:33.23,0:09:35.93,Default,,0,0,0,,‫"محطّة جبل تنبو"
Dialogue: 0,0:09:39.33,0:09:41.53,Default,,0,0,0,,‫يا له من منظرٍ رائع!
Dialogue: 0,0:09:41.53,0:09:44.03,Default,,0,0,0,,‫لا ترى مشهدًا كهذا كل يوم.
Dialogue: 0,0:09:44.03,0:09:47.83,Default,,0,0,0,,‫يبدو الناسُ صغارًا أمام هذا الاتساع.
Dialogue: 0,0:09:47.83,0:09:50.43,Default,,0,0,0,,‫نعم… لكن هؤلاء الصغار هم من يعملون
Dialogue: 0,0:09:50.43,0:09:52.23,Default,,0,0,0,,‫وسط عظمةِ الطبيعة،
Dialogue: 0,0:09:52.23,0:09:55.03,Default,,0,0,0,,‫ويحوّلونها إلى وجهاتٍ سياحية.
Dialogue: 0,0:10:01.33,0:10:02.43,Default,,0,0,0,,‫هذا؟
Dialogue: 0,0:10:02.43,0:10:03.63,Default,,0,0,0,,‫تذكارٌ من والدتي.
Dialogue: 0,0:10:03.63,0:10:06.63,Default,,0,0,0,,‫إنها بروشٌ من خرزِ اليشم.
Dialogue: 0,0:10:06.63,0:10:09.23,Default,,0,0,0,,‫ليس هذا… بروشك جميل أيضًا.
Dialogue: 0,0:10:09.23,0:10:12.63,Default,,0,0,0,,‫لكنني ظننتُ أنك تشبهين تمثالَ الإلهة كثيرًا.
Dialogue: 0,0:10:12.63,0:10:15.73,Default,,0,0,0,,‫-أنا؟ -نعم… لطيفةٌ وراقية.
Dialogue: 0,0:10:15.73,0:10:18.93,Default,,0,0,0,,‫شكرًا… يسعدني ذلك حتى لو كان مجاملة.
Dialogue: 0,0:10:18.93,0:10:21.93,Default,,0,0,0,,‫لستُ أجاملك. أليس كذلك يا كونان؟
Dialogue: 0,0:10:21.93,0:10:23.03,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:10:23.03,0:10:24.73,Default,,0,0,0,,‫-آنسة يوشينو. -نعم؟
Dialogue: 0,0:10:24.73,0:10:27.83,Default,,0,0,0,,‫هل توصلين السيد موري إلى فندقه؟
Dialogue: 0,0:10:27.83,0:10:28.93,Default,,0,0,0,,‫حاضر سيدي.
Dialogue: 0,0:10:28.93,0:10:30.23,Default,,0,0,0,,‫وأنتَ… ماذا ستفعل؟
Dialogue: 0,0:10:30.23,0:10:32.53,Default,,0,0,0,,‫سأنزل عبر الممرّ لأجري الفحصَ الأخير
Dialogue: 0,0:10:32.53,0:10:34.33,Default,,0,0,0,,‫على حالةِ المرافق… ثم أعود.
Dialogue: 0,0:10:34.33,0:10:38.03,Default,,0,0,0,,‫إذًا أراك غدًا بعد الظهر في الحفل.
Dialogue: 0,0:10:38.03,0:10:40.73,Default,,0,0,0,,‫هو نائبُ الرئيس… ومع ذلك مجتهدٌ جدًا، أليس كذلك؟
Dialogue: 0,0:10:40.73,0:10:42.23,Default,,0,0,0,,‫بالطبع!
Dialogue: 0,0:10:42.23,0:10:44.83,Default,,0,0,0,,‫مصيرُ الشركة على كتفيه.
Dialogue: 0,0:10:50.33,0:10:52.73,Default,,0,0,0,,‫"فندق دوموتو"
Dialogue: 0,0:10:56.23,0:10:57.93,Default,,0,0,0,,‫رائع!
Dialogue: 0,0:10:57.93,0:11:00.53,Default,,0,0,0,,‫أبي، أظنّك بالغتَ قليلًا.
Dialogue: 0,0:11:00.53,0:11:04.53,Default,,0,0,0,,‫لكنهم حجزوا لنا جناحًا، هل تفهمين؟!
Dialogue: 0,0:11:04.53,0:11:08.43,Default,,0,0,0,,‫أريد أن أستمتع به بكل قلبي… فلا تفسدي عليّ.
Dialogue: 0,0:11:08.43,0:11:11.53,Default,,0,0,0,,‫حسنًا… يبدو أنه جناحٌ فاخر.
Dialogue: 0,0:11:11.53,0:11:12.63,Default,,0,0,0,,‫أتُرى الأمر مناسبًا؟
Dialogue: 0,0:11:12.63,0:11:14.53,Default,,0,0,0,,‫لا بد أنهم يسبحون في المال!
Dialogue: 0,0:11:14.53,0:11:15.73,Default,,0,0,0,,‫لا داعي للقلق!
Dialogue: 0,0:11:15.73,0:11:18.03,Default,,0,0,0,,‫لكن بدا أن الابنَ الثاني جونبي،
Dialogue: 0,0:11:18.03,0:11:21.73,Default,,0,0,0,,‫والابنةَ الكبرى رينا… لديهما مشاكلُ مالية.
Dialogue: 0,0:11:21.73,0:11:23.53,Default,,0,0,0,,‫نعم… يبدو ذلك.
Dialogue: 0,0:11:23.53,0:11:26.43,Default,,0,0,0,,‫ولم يبدُ أنهما على وفاقٍ أيضًا.
Dialogue: 0,0:11:26.43,0:11:28.13,Default,,0,0,0,,‫وعندما يحينُ وقتُ الإرث…
Dialogue: 0,0:11:28.13,0:11:30.23,Default,,0,0,0,,‫أظنّ الأمور ستسوء أكثر.
Dialogue: 0,0:11:30.23,0:11:33.03,Default,,0,0,0,,‫إلى درجةٍ قد تمطرُ دمًا!
Dialogue: 0,0:11:33.03,0:11:36.93,Default,,0,0,0,,‫توقف يا أبي! ما هذا الكلام!
Dialogue: 0,0:11:36.93,0:11:40.53,Default,,0,0,0,,‫ترى لماذا سيُقام حفلُ الافتتاح
Dialogue: 0,0:11:40.53,0:11:42.83,Default,,0,0,0,,‫بعد الظهر؟
Dialogue: 0,0:12:00.56,0:12:03.26,Default,,0,0,0,,‫سيد ماشيدا، ألا يجدر بنا إجراء المقابلات…
Dialogue: 0,0:12:03.26,0:12:05.16,Default,,0,0,0,,‫بدل الجلوس هنا؟
Dialogue: 0,0:12:05.16,0:12:06.96,Default,,0,0,0,,‫تمهّل.
Dialogue: 0,0:12:06.96,0:12:09.96,Default,,0,0,0,,‫لم آتِ لأكتب تقريرًا فاشلًا.
Dialogue: 0,0:12:10.86,0:12:12.76,Default,,0,0,0,,‫أين كونان بحقّ السماء؟
Dialogue: 0,0:12:12.76,0:12:14.46,Default,,0,0,0,,‫قال إنه سيذهب إلى دورة المياه.
Dialogue: 0,0:12:15.66,0:12:18.26,Default,,0,0,0,,‫كونان، سيبدأ الأمر قريبًا.
Dialogue: 0,0:12:18.26,0:12:19.66,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:12:19.66,0:12:21.36,Default,,0,0,0,,‫التحضيراتُ مثالية.
Dialogue: 0,0:12:21.36,0:12:24.16,Default,,0,0,0,,‫لم يلحظ أحدٌ شيئًا.
Dialogue: 0,0:12:24.16,0:12:26.56,Default,,0,0,0,,‫"مثالية"؟ لا يُعتمد على مثاليّتك أبدًا!
Dialogue: 0,0:12:26.56,0:12:31.46,Default,,0,0,0,,‫لم تستطع حتى إسكات مبتزٍّ وضيع مثل أوياغي!
Dialogue: 0,0:12:31.46,0:12:32.96,Default,,0,0,0,,‫لكن…
Dialogue: 0,0:12:32.96,0:12:34.66,Default,,0,0,0,,‫لا تُجادلني!
Dialogue: 0,0:12:34.66,0:12:37.06,Default,,0,0,0,,‫في الأعمال… لا يهمّ إلا النتائج!
Dialogue: 0,0:12:37.06,0:12:39.96,Default,,0,0,0,,‫بهذا الأسلوب… لن أترك الشركة بين يديك!
Dialogue: 0,0:12:41.36,0:12:44.36,Default,,0,0,0,,‫سيدي الرئيس… لنبدأ الاستعدادات.
Dialogue: 0,0:12:51.66,0:12:55.36,Default,,0,0,0,,‫أيها السادة والسيدات، الشخصيةُ المحورية في الافتتاح الرسمي
Dialogue: 0,0:12:55.36,0:12:58.76,Default,,0,0,0,,‫لتلفريك جبل تنبو، رئيسُ شركة دوموتو تورز، إيزو دوموتو،
Dialogue: 0,0:12:58.76,0:13:01.26,Default,,0,0,0,,‫سيلقي كلمتَه الآن.
Dialogue: 0,0:13:10.86,0:13:13.06,Default,,0,0,0,,‫أيها السادة والسيدات، شكرًا لحضوركم اليوم
Dialogue: 0,0:13:13.06,0:13:15.16,Default,,0,0,0,,‫في هذه المناسبةِ العزيزة.
Dialogue: 0,0:13:15.16,0:13:18.06,Default,,0,0,0,,‫نحنُ في شركة دوموتو تورز، روّادَ قطاع السياحة،
Dialogue: 0,0:13:18.06,0:13:21.86,Default,,0,0,0,,‫لطالما سعينا إلى صون التراث الثقافي منذ…
Dialogue: 0,0:13:21.86,0:13:24.46,Default,,0,0,0,,‫أيها العصاةُ اللعناء!
Dialogue: 0,0:13:24.46,0:13:26.36,Default,,0,0,0,,‫ستحلّ لعنةُ السماء
Dialogue: 0,0:13:26.36,0:13:28.96,Default,,0,0,0,,‫عليكم جميعًا… أنتم الحاضرين هنا اليوم!
Dialogue: 0,0:13:28.96,0:13:30.16,Default,,0,0,0,,‫أيتها الحمقاء! ما الذي تفعلينه؟!
Dialogue: 0,0:13:30.16,0:13:32.66,Default,,0,0,0,,‫-صوّروا! -تبًّا!
Dialogue: 0,0:13:32.66,0:13:35.26,Default,,0,0,0,,‫أن يحفروا نفقًا بهذا الجحود
Dialogue: 0,0:13:35.26,0:13:37.06,Default,,0,0,0,,‫تحت قاعدةِ اللوتس للإلهة المقدّسة…
Dialogue: 0,0:13:37.06,0:13:38.66,Default,,0,0,0,,‫فعلٌ مشينٌ ووضيع!
Dialogue: 0,0:13:38.66,0:13:41.36,Default,,0,0,0,,‫اخجلوا من أنفسكم!
Dialogue: 0,0:13:41.36,0:13:44.86,Default,,0,0,0,,‫ولتسقط لعنةُ السماء على إيزو دوموتو!
Dialogue: 0,0:13:44.86,0:13:48.46,Default,,0,0,0,,‫يبدو أن لدينا ضيفةً لم تُدعَ،
Dialogue: 0,0:13:48.46,0:13:50.66,Default,,0,0,0,,‫لكن لا تشغلوا بالكم بها.
Dialogue: 0,0:13:50.66,0:13:53.26,Default,,0,0,0,,‫حتى الصحفُ كتبت بلا مسؤولية هراءً
Dialogue: 0,0:13:53.26,0:13:55.16,Default,,0,0,0,,‫عن تمثالِ الإلهة ذاك!
Dialogue: 0,0:13:55.16,0:13:57.66,Default,,0,0,0,,‫لكنني أنا، إيزو دوموتو،
Dialogue: 0,0:13:57.66,0:14:02.36,Default,,0,0,0,,‫سأبدّد هذا الهراء كلّه أمامكم!
Dialogue: 0,0:14:02.36,0:14:04.56,Default,,0,0,0,,‫ولهذا استضفنا اليوم،
Dialogue: 0,0:14:04.56,0:14:06.46,Default,,0,0,0,,‫ضمن ضيوفنا الكرام،
Dialogue: 0,0:14:06.46,0:14:09.96,Default,,0,0,0,,‫المحقّق الشهير كوغورو موري!
Dialogue: 0,0:14:13.36,0:14:16.96,Default,,0,0,0,,‫مرحبًا. أنا كوغورو موري!
Dialogue: 0,0:14:16.96,0:14:19.26,Default,,0,0,0,,‫شكرًا، شكرًا لكم!
Dialogue: 0,0:14:19.26,0:14:21.36,Default,,0,0,0,,‫سيد ماشيدا، هذا مذهل!
Dialogue: 0,0:14:21.36,0:14:23.56,Default,,0,0,0,,‫كوغورو موري هنا!
Dialogue: 0,0:14:23.56,0:14:25.86,Default,,0,0,0,,‫ألا تشمّ رائحةَ أمرٍ مريب؟
Dialogue: 0,0:14:25.86,0:14:29.26,Default,,0,0,0,,‫ماذا؟ تقصد أنه ليس هو… بل شبيه؟
Dialogue: 0,0:14:29.26,0:14:31.66,Default,,0,0,0,,‫لا، لا… انسَ الأمر.
Dialogue: 0,0:14:31.66,0:14:35.46,Default,,0,0,0,,‫لماذا استدعانا إيزو دوموتو إلى هنا أصلًا؟
Dialogue: 0,0:14:43.06,0:14:47.06,Default,,0,0,0,,‫سيبدأ الآن التشغيلُ التجريبي الأول لتلفريك جبل تنبو.
Dialogue: 0,0:14:47.06,0:14:50.46,Default,,0,0,0,,‫وستصعد المجموعةُ الثانية في العربة الأخرى،
Dialogue: 0,0:14:50.46,0:14:54.36,Default,,0,0,0,,‫بعد وصولِ العربة الأولى إلى القمة.
Dialogue: 0,0:15:01.06,0:15:02.16,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:15:02.16,0:15:04.26,Default,,0,0,0,,‫هذانِ هناك صحفيّان من "توكاي نيبّو"،
Dialogue: 0,0:15:04.26,0:15:07.56,Default,,0,0,0,,‫الجهة التي تهاجم شركة دوموتو تورز.
Dialogue: 0,0:15:07.56,0:15:09.66,Default,,0,0,0,,‫لماذا يأتون قبل بقية الوكالات
Dialogue: 0,0:15:09.66,0:15:12.16,Default,,0,0,0,,‫ويحصلون على تجربة التشغيل التجريبي؟
Dialogue: 0,0:15:23.76,0:15:25.96,Default,,0,0,0,,‫يا حمقى…
Dialogue: 0,0:15:31.96,0:15:34.96,Default,,0,0,0,,‫انظر يا أوياغي… المنظر خرافي!
Dialogue: 0,0:15:34.96,0:15:36.46,Default,,0,0,0,,‫ما رأيك يا سيد ماشيدا؟
Dialogue: 0,0:15:36.46,0:15:39.86,Default,,0,0,0,,‫لمَ لا تكتب عنا شيئًا جيدًا هذه المرة؟
Dialogue: 0,0:15:39.86,0:15:42.06,Default,,0,0,0,,‫أتُحاول رشوتي؟
Dialogue: 0,0:15:42.06,0:15:46.16,Default,,0,0,0,,‫إن فعلت… سأكتب مقالًا عن هذا أيضًا.
Dialogue: 0,0:15:46.16,0:15:49.66,Default,,0,0,0,,‫ترى إلى متى ستبقى وقحًا هكذا؟
Dialogue: 0,0:16:10.26,0:16:14.06,Default,,0,0,0,,‫هيه، سيد ماشيدا… انظر إلى ذاك!
Dialogue: 0,0:16:14.06,0:16:16.26,Default,,0,0,0,,‫تماثيلُ خمسمئةِ تلميذٍ لبوذا الذين بلغوا النيرفانا؟
Dialogue: 0,0:16:16.26,0:16:19.86,Default,,0,0,0,,‫يعني صنعتُم أشياء كهذه بقوة المال؟
Dialogue: 0,0:16:19.86,0:16:23.46,Default,,0,0,0,,‫أفضل أن تعتبرني رجلَ دين.
Dialogue: 0,0:16:23.46,0:16:25.86,Default,,0,0,0,,‫أنا واثقٌ أن هذا سيصبح حديثَ البلدة،
Dialogue: 0,0:16:25.86,0:16:28.16,Default,,0,0,0,,‫وسيتدفق الزوارُ كالسيل.
Dialogue: 0,0:16:28.16,0:16:29.96,Default,,0,0,0,,‫يريدون العبادةَ والدعاءَ لتمثال الإلهة،
Dialogue: 0,0:16:29.96,0:16:31.86,Default,,0,0,0,,‫وكذلك لتماثيل التلاميذ الخمسمئة.
Dialogue: 0,0:16:31.86,0:16:34.36,Default,,0,0,0,,‫وبمعنى آخر… لديّ كل سببٍ لأن تنالني الإلهة بالامتنان،
Dialogue: 0,0:16:34.36,0:16:38.26,Default,,0,0,0,,‫ولا سبب لديها لتلعنني!
Dialogue: 0,0:16:39.86,0:16:41.86,Default,,0,0,0,,‫ما الأمر؟
Dialogue: 0,0:16:41.86,0:16:44.16,Default,,0,0,0,,‫ما الأمر؟ هل انقطع التيار؟
Dialogue: 0,0:16:44.16,0:16:45.96,Default,,0,0,0,,‫مهلًا! ماذا تظن أنك تفعل؟ لا تفعل!
Dialogue: 0,0:16:45.96,0:16:47.06,Default,,0,0,0,,‫أنتَ…
Dialogue: 0,0:16:47.06,0:16:48.96,Default,,0,0,0,,‫أحدٌ ما! أحدٌ ما… أعطِنا ضوءًا!
Dialogue: 0,0:16:50.36,0:16:51.86,Default,,0,0,0,,‫استخدم فلاش الكاميرا!
Dialogue: 0,0:16:51.86,0:16:53.36,Default,,0,0,0,,‫آه، صحيح!
Dialogue: 0,0:16:57.96,0:16:59.06,Default,,0,0,0,,‫استخدم الفلاش مرةً أخرى!
Dialogue: 0,0:16:59.06,0:17:00.66,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:17:06.76,0:17:08.06,Default,,0,0,0,,‫ما الذي…
Dialogue: 0,0:17:08.06,0:17:09.16,Default,,0,0,0,,‫هذا…
Dialogue: 0,0:17:09.16,0:17:11.06,Default,,0,0,0,,‫هذا جنون!
Dialogue: 0,0:17:11.06,0:17:12.86,Default,,0,0,0,,‫الرئيس…
Dialogue: 0,0:17:12.86,0:17:15.16,Default,,0,0,0,,‫اختفى!
Dialogue: 0,0:17:15.16,0:17:16.86,Default,,0,0,0,,‫النوافذ لا يمكن فتحها!
Dialogue: 0,0:17:16.86,0:17:19.66,Default,,0,0,0,,‫الصحفيّان عند باب اليسار!
Dialogue: 0,0:17:19.66,0:17:21.56,Default,,0,0,0,,‫وعند باب اليمين الآنسة آياكا!
Dialogue: 0,0:17:21.56,0:17:24.36,Default,,0,0,0,,‫وفي السقف فتحةُ تهويةٍ صغيرة فقط!
Dialogue: 0,0:17:24.36,0:17:25.56,Default,,0,0,0,,‫وماذا عن مخرج الطوارئ؟
Dialogue: 0,0:17:25.56,0:17:27.16,Default,,0,0,0,,‫لم يُستخدم بعد!
Dialogue: 0,0:17:27.16,0:17:29.46,Default,,0,0,0,,‫إذًا… إلى أين اختفى؟
Dialogue: 0,0:17:29.46,0:17:31.86,Default,,0,0,0,,‫وما قصة هذه التعويذة؟
Dialogue: 0,0:17:31.86,0:17:33.46,Default,,0,0,0,,‫"مبدأ السبب والنتيجة"؟
Dialogue: 0,0:17:33.46,0:17:35.06,Default,,0,0,0,,‫"السبب والنتيجة"؟
Dialogue: 0,0:17:35.06,0:17:37.66,Default,,0,0,0,,‫"ستدفع ثمن خطاياك"؟
Dialogue: 0,0:17:37.66,0:17:39.56,Default,,0,0,0,,‫أبي هناك!
Dialogue: 0,0:17:40.56,0:17:42.16,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:17:45.66,0:17:47.76,Default,,0,0,0,,‫إنه فعلًا السيد إيزو دوموتو!
Dialogue: 0,0:17:47.76,0:17:49.66,Default,,0,0,0,,‫يبدو أن شيئًا قد غُرس في صدره!
Dialogue: 0,0:17:49.66,0:17:51.86,Default,,0,0,0,,‫اتصلوا بأحدٍ بالهاتف حالًا!
Dialogue: 0,0:17:51.86,0:17:54.56,Default,,0,0,0,,‫لا نستطيع… فلا توجد تغطية هنا بعد!
Dialogue: 0,0:17:54.56,0:17:56.76,Default,,0,0,0,,‫لكن هناك هاتفٌ عندما نصلُ للقمة.
Dialogue: 0,0:17:56.76,0:17:58.36,Default,,0,0,0,,‫هذا عبث!
Dialogue: 0,0:17:58.36,0:18:00.26,Default,,0,0,0,,‫هل يمكن أن يحدث شيءٌ كهذا حقًا؟
Dialogue: 0,0:18:15.29,0:18:17.19,Default,,0,0,0,,‫حدث شيءٌ للرئيس!
Dialogue: 0,0:18:17.19,0:18:19.89,Default,,0,0,0,,‫أحضروا الشرطة وأبلغوا من في الأسفل فورًا!
Dialogue: 0,0:18:19.89,0:18:21.79,Default,,0,0,0,,‫-حاضر! -سننزل…
Dialogue: 0,0:18:21.79,0:18:23.79,Default,,0,0,0,,‫إلى تمثال الإلهة عبر مسار المشي!
Dialogue: 0,0:18:23.79,0:18:24.89,Default,,0,0,0,,‫معكم ماشيدا!
Dialogue: 0,0:18:24.89,0:18:26.69,Default,,0,0,0,,‫اتركوا صفحةً كاملة لنسخة المساء!
Dialogue: 0,0:18:26.69,0:18:28.49,Default,,0,0,0,,‫حدثت لعنة!
Dialogue: 0,0:18:28.49,0:18:30.09,Default,,0,0,0,,‫إيزو دوموتو طُعن
Dialogue: 0,0:18:30.09,0:18:32.19,Default,,0,0,0,,‫فوق كفِّ تمثال الإلهة!
Dialogue: 0,0:18:35.29,0:18:38.29,Default,,0,0,0,,‫آنسة آياكا… ما بكِ؟ هل أنتِ بخير؟
Dialogue: 0,0:18:38.29,0:18:39.89,Default,,0,0,0,,‫شعرتُ بدوارٍ بسيط.
Dialogue: 0,0:18:39.89,0:18:41.69,Default,,0,0,0,,‫لا تهتموا بي… اطمئنوا على الرئيس.
Dialogue: 0,0:18:41.69,0:18:43.49,Default,,0,0,0,,‫حسنًا… سأسبقكم إذًا.
Dialogue: 0,0:18:43.49,0:18:45.69,Default,,0,0,0,,‫-هيا يا كونان! -حسنًا.
Dialogue: 0,0:18:59.59,0:19:02.99,Default,,0,0,0,,‫سيد موري… تمثالُ الإلهة من أعلى هذه الدرجات!
Dialogue: 0,0:19:16.29,0:19:18.19,Default,,0,0,0,,‫يستغرق الصعودُ إلى هنا 15 دقيقة!
Dialogue: 0,0:19:33.49,0:19:36.69,Default,,0,0,0,,‫لقد طُعن في صدره مباشرةً… وهو ميت.
Dialogue: 0,0:19:36.69,0:19:38.49,Default,,0,0,0,,‫أبي!
Dialogue: 0,0:19:38.49,0:19:40.49,Default,,0,0,0,,‫مستحيل! لا بد أنك تمزح…
Dialogue: 0,0:19:40.49,0:19:43.59,Default,,0,0,0,,‫تقول إنه مات… صحيح يا سيد موري؟
Dialogue: 0,0:19:43.59,0:19:47.29,Default,,0,0,0,,‫أفهم شعورك… لكنه ميت.
Dialogue: 0,0:19:47.29,0:19:49.99,Default,,0,0,0,,‫لا يمكن…
Dialogue: 0,0:19:49.99,0:19:52.89,Default,,0,0,0,,‫لم يكن من المفترض أن ينتهي الأمر هكذا.
Dialogue: 0,0:19:56.29,0:19:58.08,Default,,0,0,0,,‫سيدي نائب الرئيس، تماسك رجاءً!
Dialogue: 0,0:19:58.29,0:20:00.89,Default,,0,0,0,,‫هاه؟ آنسة آياكا… هل أنتِ بخير؟
Dialogue: 0,0:20:00.89,0:20:02.69,Default,,0,0,0,,‫نعم، أنا بخير.
Dialogue: 0,0:20:02.69,0:20:04.29,Default,,0,0,0,,‫لا يمكنني أداء عملي كسكرتيرة
Dialogue: 0,0:20:04.29,0:20:06.09,Default,,0,0,0,,‫إن انهرتُ في وقتٍ كهذا.
Dialogue: 0,0:20:19.09,0:20:20.49,Default,,0,0,0,,‫أخيرًا وصلت!
Dialogue: 0,0:20:21.99,0:20:23.99,Default,,0,0,0,,‫ها؟ إذًا أنتَ؟
Dialogue: 0,0:20:23.99,0:20:27.29,Default,,0,0,0,,‫أوه، سيد موري! أنتَ مجددًا؟!
Dialogue: 0,0:20:27.29,0:20:29.69,Default,,0,0,0,,‫ما الذي تقصدينه؟ هل يُفترض أن أكون إله الموت؟
Dialogue: 0,0:20:29.69,0:20:33.49,Default,,0,0,0,,‫إن كان كذلك… فليساعدكِ تمثالُ الإلهة هذه المرة!
Dialogue: 0,0:20:33.49,0:20:35.09,Default,,0,0,0,,‫لا، لا!
Dialogue: 0,0:20:35.09,0:20:38.79,Default,,0,0,0,,‫أنا فقط سعيدةٌ لأنني سأسمع استنتاجاتك العبقرية مرةً أخرى.
Dialogue: 0,0:20:38.79,0:20:41.69,Default,,0,0,0,,‫لكن لا تقل لي إن هذا نوعٌ من اللعنة.
Dialogue: 0,0:20:41.69,0:20:43.99,Default,,0,0,0,,‫هناك إشاعاتٌ من هذا النوع.
Dialogue: 0,0:20:43.99,0:20:45.19,Default,,0,0,0,,‫لا شيء من هذا!
Dialogue: 0,0:20:45.19,0:20:48.89,Default,,0,0,0,,‫القاتل بين من كانوا في التلفريك!
Dialogue: 0,0:20:48.89,0:20:50.69,Default,,0,0,0,,‫ماذا؟ أحقًا؟
Dialogue: 0,0:20:50.69,0:20:52.89,Default,,0,0,0,,‫يعني أن القاتل بينهم… صحيح؟
Dialogue: 0,0:20:52.89,0:20:55.79,Default,,0,0,0,,‫قبل أن يختفي إيزو من داخل العربة،
Dialogue: 0,0:20:55.79,0:20:58.09,Default,,0,0,0,,‫سُمِع صوتُ عراكٍ بين شخصين.
Dialogue: 0,0:20:58.09,0:21:01.39,Default,,0,0,0,,‫وفوق ذلك، وُجدت تعويذةٌ غريبة ملصوقة على النافذة.
Dialogue: 0,0:21:01.39,0:21:04.09,Default,,0,0,0,,‫لابد أن القاتل دفع إيزو بطريقةٍ ما
Dialogue: 0,0:21:04.09,0:21:07.99,Default,,0,0,0,,‫من التلفريك إلى النفق أسفله.
Dialogue: 0,0:21:07.99,0:21:11.59,Default,,0,0,0,,‫لكن لا أحد ممن كان في التلفريك نزل
Dialogue: 0,0:21:11.59,0:21:14.49,Default,,0,0,0,,‫حتى وصلنا إلى القمة… صحيح؟
Dialogue: 0,0:21:14.49,0:21:17.89,Default,,0,0,0,,‫إذًا… من المحتمل أن هناك شريكًا داخل النفق.
Dialogue: 0,0:21:17.89,0:21:20.19,Default,,0,0,0,,‫أظن أن هذا مستبعدٌ جدًا.
Dialogue: 0,0:21:20.19,0:21:23.39,Default,,0,0,0,,‫أنتَ! أطبِق فمك الكبير!
Dialogue: 0,0:21:23.39,0:21:24.99,Default,,0,0,0,,‫انتظر يا سيد موري.
Dialogue: 0,0:21:24.99,0:21:27.19,Default,,0,0,0,,‫كونان… ماذا تقصد؟
Dialogue: 0,0:21:27.19,0:21:30.79,Default,,0,0,0,,‫حسنًا… التلفريك يستغرق ثلاثين ثانية فقط
Dialogue: 0,0:21:30.79,0:21:32.49,Default,,0,0,0,,‫ليعبر النفق.
Dialogue: 0,0:21:32.49,0:21:33.99,Default,,0,0,0,,‫حتى لو وُجد شريك،
Dialogue: 0,0:21:33.99,0:21:36.69,Default,,0,0,0,,‫هل يمكن نقل الضحية من داخل النفق
Dialogue: 0,0:21:36.69,0:21:39.09,Default,,0,0,0,,‫إلى كفِّ تمثال الإلهة خلال ثلاثين ثانية؟
Dialogue: 0,0:21:40.39,0:21:43.49,Default,,0,0,0,,‫آنسة آياكا… ألا توجد مصاعد سرية مثلًا
Dialogue: 0,0:21:43.49,0:21:45.59,Default,,0,0,0,,‫تنقلكِ من النفق إلى هذا المرصد؟
Dialogue: 0,0:21:45.59,0:21:47.79,Default,,0,0,0,,‫لا يوجد شيءٌ كهذا.
Dialogue: 0,0:21:47.79,0:21:49.99,Default,,0,0,0,,‫لكن بالطبع… ولأغراض الصيانة،
Dialogue: 0,0:21:49.99,0:21:52.49,Default,,0,0,0,,‫هناك طريقٌ يؤدي من النفق
Dialogue: 0,0:21:52.49,0:21:53.99,Default,,0,0,0,,‫إلى منتصفِ درج المرصد تقريبًا.
Dialogue: 0,0:21:53.99,0:21:57.29,Default,,0,0,0,,‫هذا هو! القاتل استخدم ذلك الطريق وقتل إيزو.
Dialogue: 0,0:21:57.29,0:22:00.09,Default,,0,0,0,,‫لكن الوصول من النفق إلى المرصد
Dialogue: 0,0:22:00.09,0:22:03.69,Default,,0,0,0,,‫سيستغرق حتى لرجلٍ يركض… ثلاث دقائق على الأقل.
Dialogue: 0,0:22:03.69,0:22:05.19,Default,,0,0,0,,‫ثلاث دقائق؟
Dialogue: 0,0:22:05.19,0:22:06.89,Default,,0,0,0,,‫انتظر لحظة…
Dialogue: 0,0:22:06.89,0:22:10.09,Default,,0,0,0,,‫من لحظة انقطاع الضوء إلى لحظة العثور على إيزو
Dialogue: 0,0:22:10.09,0:22:11.29,Default,,0,0,0,,‫في كفِّ تمثال الإلهة،
Dialogue: 0,0:22:11.29,0:22:14.09,Default,,0,0,0,,‫لم يستغرق الأمر سوى نحو ثلاثين ثانية.
Dialogue: 0,0:22:14.09,0:22:17.29,Default,,0,0,0,,‫فإذا كان الطريق ثلاث دقائق…
Dialogue: 0,0:22:17.29,0:22:19.99,Default,,0,0,0,,‫لا… أظنه يستغرق أكثر من ذلك.
Dialogue: 0,0:22:19.99,0:22:21.49,Default,,0,0,0,,‫ومن غير المعقول أن السيد إيزو دوموتو
Dialogue: 0,0:22:21.49,0:22:24.19,Default,,0,0,0,,‫سيسكت وهو يُختطف.
Dialogue: 0,0:22:24.19,0:22:27.19,Default,,0,0,0,,‫ما يعني أنه كان لا بد أن يُقتل فورًا.
Dialogue: 0,0:22:27.19,0:22:29.49,Default,,0,0,0,,‫لكن إن حمل أحدهم الجثة على ظهره
Dialogue: 0,0:22:29.49,0:22:31.29,Default,,0,0,0,,‫وسلك الطريق من النفق إلى المرصد،
Dialogue: 0,0:22:31.29,0:22:33.29,Default,,0,0,0,,‫فسيحتاج ضعف الوقت… أي ست دقائق، لا ثلاثًا.
Dialogue: 0,0:22:33.29,0:22:35.79,Default,,0,0,0,,‫بل ربما أكثر من ذلك.
Dialogue: 0,0:22:35.79,0:22:36.89,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:22:36.89,0:22:38.49,Default,,0,0,0,,‫الأعجب حتى من اختفاء الضحية داخل التلفريك…
Dialogue: 0,0:22:38.49,0:22:41.79,Default,,0,0,0,,‫هو هذا الأمر.
Dialogue: 0,0:22:41.79,0:22:44.19,Default,,0,0,0,,‫إنها لعنة!
Dialogue: 0,0:22:45.59,0:22:47.89,Default,,0,0,0,,‫يا له من مشهد… أن تُعرض جثةٌ
Dialogue: 0,0:22:47.89,0:22:50.39,Default,,0,0,0,,‫على كفِّ تمثال الإلهة.
Dialogue: 0,0:22:50.39,0:22:52.99,Default,,0,0,0,,‫إنه عقابٌ سماويٌّ مستحق
Dialogue: 0,0:22:52.99,0:22:56.99,Default,,0,0,0,,‫لإيزو دوموتو الذي أصابه جشعُ المال!
Dialogue: 0,0:23:08.59,0:23:13.29,Default,,0,0,0,,‫الأمر مستحيلٌ لدرجة لا تُسمّى جريمة قتل.
Dialogue: 0,0:23:13.29,0:23:19.39,Default,,0,0,0,,‫لا تقل لي… إنها فعلًا لعنة؟
Dialogue: 0,0:23:19.39,0:23:23.29,Default,,0,0,0,,‫غضبُ الإلهة حقًا؟
Dialogue: 0,0:23:34.64,0:23:36.34,Default,,0,0,0,,‫المفتش يوكوميزو.
Dialogue: 0,0:23:36.34,0:23:38.54,Default,,0,0,0,,‫وصلت نتائجُ التشريح.
Dialogue: 0,0:23:38.54,0:23:40.44,Default,,0,0,0,,‫سبب الوفاة طعنةٌ
Dialogue: 0,0:23:40.44,0:23:42.14,Default,,0,0,0,,‫اخترقت صدره بخنجرٍ حتى النهاية.
Dialogue: 0,0:23:42.14,0:23:43.84,Default,,0,0,0,,‫نعتقد أنه مات فورًا.
Dialogue: 0,0:23:43.84,0:23:47.84,Default,,0,0,0,,‫ولم تُعثر على بصمات أصابع أو كفّ على الخنجر.
Dialogue: 0,0:23:47.84,0:23:49.44,Default,,0,0,0,,‫الوقتُ التقريبي للوفاة
Dialogue: 0,0:23:49.44,0:23:53.14,Default,,0,0,0,,‫هو مباشرةً بعد اختفائه من التلفريك.
Dialogue: 0,0:23:53.14,0:23:55.74,Default,,0,0,0,,‫حسنًا… كما افترضنا تمامًا.
Dialogue: 0,0:23:55.74,0:23:59.54,Default,,0,0,0,,‫حسنًا، أغلقوا ساحةَ التنزّه بالكامل.
Dialogue: 0,0:23:59.54,0:24:02.64,Default,,0,0,0,,‫واجعلوا ذلك العجوز يهبط إلى أسفل الجبل أيضًا.
Dialogue: 0,0:24:02.64,0:24:03.74,Default,,0,0,0,,‫حاضر.
Dialogue: 0,0:24:09.04,0:24:12.84,Default,,0,0,0,,‫سيدي… ما ذلك الكوخ هناك في الأسفل؟
Dialogue: 0,0:24:12.84,0:24:15.84,Default,,0,0,0,,‫إنها استراحة كان عمالُ البناء يستخدمونها
Dialogue: 0,0:24:15.84,0:24:17.04,Default,,0,0,0,,‫حين كانوا يحفرون النفق.
Dialogue: 0,0:24:17.04,0:24:19.44,Default,,0,0,0,,‫ومن المفترض أن تُهدم غدًا.
Dialogue: 0,0:24:19.44,0:24:21.74,Default,,0,0,0,,‫إذًا لماذا يخرج منها دخان؟
Dialogue: 0,0:24:22.84,0:24:25.34,Default,,0,0,0,,‫لستُ أزعجه.
Dialogue: 0,0:24:25.34,0:24:26.94,Default,,0,0,0,,‫سيد ياسونوري دوموتو…
Dialogue: 0,0:24:26.94,0:24:29.54,Default,,0,0,0,,‫لديّ أمرٌ أودّ أن تتحقق منه لي.
Dialogue: 0,0:24:29.54,0:24:33.34,Default,,0,0,0,,‫هل تتذكر هذا الخنجر؟
Dialogue: 0,0:24:33.34,0:24:37.64,Default,,0,0,0,,‫إنه واحدٌ من مجموعةِ خناجر والدي.
Dialogue: 0,0:24:37.64,0:24:41.94,Default,,0,0,0,,‫يعني أن شخصًا سرق الخنجر.
Dialogue: 0,0:24:41.94,0:24:44.14,Default,,0,0,0,,‫هل كان تحت حراسةٍ مشددة؟
Dialogue: 0,0:24:44.14,0:24:48.24,Default,,0,0,0,,‫لا… كان بوسع أيّ شخصٍ أن يأخذه إن أراد.
Dialogue: 0,0:24:48.24,0:24:50.24,Default,,0,0,0,,‫لكن هذا ليس المهم… المشكلة هي…
Dialogue: 0,0:24:50.24,0:24:52.34,Default,,0,0,0,,‫نعم؟
Dialogue: 0,0:24:52.34,0:24:53.94,Default,,0,0,0,,‫لا…
Dialogue: 0,0:24:53.94,0:24:56.44,Default,,0,0,0,,‫لا شيء.
Dialogue: 0,0:24:56.44,0:24:59.24,Default,,0,0,0,,‫إنه يُخفي شيئًا.
Dialogue: 0,0:24:59.24,0:25:01.24,Default,,0,0,0,,‫ما هو؟
Dialogue: 0,0:25:01.24,0:25:04.64,Default,,0,0,0,,‫إذًا، هذه القضية عن السيد إيزو دوموتو…
Dialogue: 0,0:25:04.64,0:25:08.44,Default,,0,0,0,,‫الذي تعرّض لهجومٍ واختفى داخل التلفريك.
Dialogue: 0,0:25:08.44,0:25:11.64,Default,,0,0,0,,‫وهناك التعويذةُ الملصقة على النافذة.
Dialogue: 0,0:25:11.64,0:25:13.74,Default,,0,0,0,,‫لا يسعني إلا أن أستنتج
Dialogue: 0,0:25:13.74,0:25:15.84,Default,,0,0,0,,‫أن القاتل بينكم جميعًا هنا.
Dialogue: 0,0:25:15.84,0:25:17.64,Default,,0,0,0,,‫وأولًا… أودّ التحقق من الدافع للقتل.
Dialogue: 0,0:25:17.64,0:25:23.34,Default,,0,0,0,,‫من أكثرُ من سيستفيد من موت السيد دوموتو؟
Dialogue: 0,0:25:23.34,0:25:25.74,Default,,0,0,0,,‫إن كنت تقصد أموالَ أبينا،
Dialogue: 0,0:25:25.74,0:25:27.74,Default,,0,0,0,,‫فالمستفيدون نحن… أبناؤه.
Dialogue: 0,0:25:27.74,0:25:30.54,Default,,0,0,0,,‫ليس تمامًا… ياسونوري هو الأكثر استفادة.
Dialogue: 0,0:25:30.54,0:25:34.24,Default,,0,0,0,,‫خصوصًا الآن… إذ يستطيع تولّي سلطة دوموتو تورز كاملة.
Dialogue: 0,0:25:34.24,0:25:35.54,Default,,0,0,0,,‫جونبي!
Dialogue: 0,0:25:35.54,0:25:39.74,Default,,0,0,0,,‫ياسونوري… ألستَ سعيدًا الآن بعدما مات الأب؟
Dialogue: 0,0:25:39.74,0:25:42.94,Default,,0,0,0,,‫لم تعد تُوبَّخ في العمل أيضًا.
Dialogue: 0,0:25:42.94,0:25:44.64,Default,,0,0,0,,‫ومن ناحية الدافع…
Dialogue: 0,0:25:44.64,0:25:46.94,Default,,0,0,0,,‫أظنّ أن لكم من الدافع بقدر ما لديّ يا رينا.
Dialogue: 0,0:25:46.94,0:25:50.54,Default,,0,0,0,,‫"لكم"؟ تقصد أوياغي وأنا؟
Dialogue: 0,0:25:50.54,0:25:52.14,Default,,0,0,0,,‫لماذا أنا؟
Dialogue: 0,0:25:52.14,0:25:54.84,Default,,0,0,0,,‫أنتَ لفّقت فضائح لشركتنا وابتززت أبي
Dialogue: 0,0:25:54.84,0:25:58.24,Default,,0,0,0,,‫بالرسائل والمكالمات المزعجة قبلها.
Dialogue: 0,0:25:58.24,0:26:01.34,Default,,0,0,0,,‫لكن أبي تجاهلك… ولهذا أنتَ…
Dialogue: 0,0:26:01.34,0:26:02.84,Default,,0,0,0,,‫تمهّل!
Dialogue: 0,0:26:02.84,0:26:03.94,Default,,0,0,0,,‫لا تقل لي إنك…
Dialogue: 0,0:26:03.94,0:26:06.44,Default,,0,0,0,,‫كنت تبتز أبي بسبب تلك القصة؟
Dialogue: 0,0:26:06.44,0:26:09.54,Default,,0,0,0,,‫سيد أوياغي… ما المقصود بتلك القصة؟
Dialogue: 0,0:26:09.54,0:26:12.44,Default,,0,0,0,,‫لكي يجهّزوا هذا النفق في الوقت المحدد،
Dialogue: 0,0:26:12.44,0:26:14.94,Default,,0,0,0,,‫بدأ البناء وفق جدولٍ جنوني.
Dialogue: 0,0:26:14.94,0:26:17.94,Default,,0,0,0,,‫وهذا تسبب بحادثٍ في النفق،
Dialogue: 0,0:26:17.94,0:26:21.04,Default,,0,0,0,,‫دُفن فيه شخصٌ حيًّا…
Dialogue: 0,0:26:21.04,0:26:24.84,Default,,0,0,0,,‫وتُرك ليموت.
Dialogue: 0,0:26:24.84,0:26:26.94,Default,,0,0,0,,‫وخوفًا على سمعة تلفريك جبل تنبو،
Dialogue: 0,0:26:26.94,0:26:32.64,Default,,0,0,0,,‫استخدم إيزو دوموتو المال لإسكات عائلة الضحية وكل من له صلة،
Dialogue: 0,0:26:32.64,0:26:34.64,Default,,0,0,0,,‫ولمحو آثار الحادث.
Dialogue: 0,0:26:34.64,0:26:38.74,Default,,0,0,0,,‫لقد خيّب أبي أملي… لذلك غادرتُ المنزل.
Dialogue: 0,0:26:38.74,0:26:41.74,Default,,0,0,0,,‫يعني أن لديك الجرأة لتبتز أبي بسببها؟
Dialogue: 0,0:26:41.74,0:26:44.34,Default,,0,0,0,,‫لا تجعلني أبدو حقيرًا لهذه الدرجة.
Dialogue: 0,0:26:44.34,0:26:47.64,Default,,0,0,0,,‫كل ما فعلته أنني طلبت مقابلةً حول الموضوع.
Dialogue: 0,0:26:47.64,0:26:50.14,Default,,0,0,0,,‫لكن إن افترض أنه ابتزاز…
Dialogue: 0,0:26:50.14,0:26:52.54,Default,,0,0,0,,‫فلا بد أنه كان يشعر بالذنب تجاه شيءٍ ما.
Dialogue: 0,0:26:52.54,0:26:56.84,Default,,0,0,0,,‫أنتَ اقتربت مني لهذا الغرض أصلًا، أليس كذلك؟
Dialogue: 0,0:26:56.84,0:26:58.44,Default,,0,0,0,,‫حسنًا… أنتِ في النهاية
Dialogue: 0,0:26:58.44,0:27:01.34,Default,,0,0,0,,‫أفضلُ شاهدٍ على ما حدث وقتها.
Dialogue: 0,0:27:01.34,0:27:03.24,Default,,0,0,0,,‫يا له من شخص!
Dialogue: 0,0:27:03.24,0:27:06.34,Default,,0,0,0,,‫أنتَ بارعٌ في قيادة رينا من أنفها.
Dialogue: 0,0:27:06.34,0:27:09.14,Default,,0,0,0,,‫لكن يبدو أنك لم تستطع فعل ذلك مع أبي.
Dialogue: 0,0:27:09.14,0:27:11.14,Default,,0,0,0,,‫ولأنك لم تحصل على المال الذي تريده،
Dialogue: 0,0:27:11.14,0:27:13.34,Default,,0,0,0,,‫غضبت وقتلت أبي… صحيح؟
Dialogue: 0,0:27:13.34,0:27:15.14,Default,,0,0,0,,‫لم أقتله!
Dialogue: 0,0:27:15.14,0:27:17.84,Default,,0,0,0,,‫تحدث عن نفسك يا جونبي.
Dialogue: 0,0:27:17.84,0:27:21.64,Default,,0,0,0,,‫أبي ظل يرفض مساعدتك ماليًا.
Dialogue: 0,0:27:21.64,0:27:23.74,Default,,0,0,0,,‫أراهن أنك كنت غاضبًا بسبب ذلك، أليس كذلك؟
Dialogue: 0,0:27:23.74,0:27:26.34,Default,,0,0,0,,‫وماذا عنكِ أنتِ إذًا؟
Dialogue: 0,0:27:26.34,0:27:27.54,Default,,0,0,0,,‫كفى!
Dialogue: 0,0:27:27.54,0:27:31.04,Default,,0,0,0,,‫إلى متى ستعرضون فضائح العائلة أمام الناس؟
Dialogue: 0,0:27:31.04,0:27:32.24,Default,,0,0,0,,‫سيد ماشيدا…
Dialogue: 0,0:27:32.24,0:27:36.24,Default,,0,0,0,,‫صحيفتكم "توكاي نيبّو" كانت تقود حملة ضد التلفريك.
Dialogue: 0,0:27:38.24,0:27:42.44,Default,,0,0,0,,‫كيف تمكّنت "توكاي نيبّو" من ركوب أول تجربة تشغيل
Dialogue: 0,0:27:42.44,0:27:45.24,Default,,0,0,0,,‫للتلفريك دون بقية الوكالات؟
Dialogue: 0,0:27:45.24,0:27:46.54,Default,,0,0,0,,‫من يدري؟
Dialogue: 0,0:27:46.54,0:27:49.94,Default,,0,0,0,,‫نحن أيضًا نتساءل عن ذلك.
Dialogue: 0,0:27:49.94,0:27:53.54,Default,,0,0,0,,‫ألا ترى أنه من الأفضل سؤال نائب الرئيس عن هذا؟
Dialogue: 0,0:27:53.54,0:27:56.44,Default,,0,0,0,,‫سيد ياسونوري… هل تشرح لنا؟
Dialogue: 0,0:27:56.44,0:27:57.74,Default,,0,0,0,,‫أشرح؟
Dialogue: 0,0:27:57.74,0:28:00.54,Default,,0,0,0,,‫حسنًا… الرئيس أراد أن يكون المعارضون
Dialogue: 0,0:28:00.54,0:28:03.44,Default,,0,0,0,,‫لتطوير التلفريك أولَ من يركبه،
Dialogue: 0,0:28:03.44,0:28:07.74,Default,,0,0,0,,‫كي يفهموا مدى روعته.
Dialogue: 0,0:28:07.74,0:28:09.94,Default,,0,0,0,,‫أترى أن هذا هو السبب فعلًا؟
Dialogue: 0,0:28:09.94,0:28:12.74,Default,,0,0,0,,‫أم أن هناك سببًا آخر؟
Dialogue: 0,0:28:12.74,0:28:14.44,Default,,0,0,0,,‫بالمناسبة يا سيد ماشيدا،
Dialogue: 0,0:28:14.44,0:28:18.04,Default,,0,0,0,,‫كنتم عند باب التلفريك طوال الوقت… أليس كذلك؟
Dialogue: 0,0:28:18.04,0:28:22.74,Default,,0,0,0,,‫أتلمّح إلى أننا دفعنا إيزو دوموتو من النافذة؟
Dialogue: 0,0:28:22.74,0:28:24.94,Default,,0,0,0,,‫لا أظن ذلك ممكنًا.
Dialogue: 0,0:28:26.44,0:28:30.34,Default,,0,0,0,,‫لأن الباب من جهة السيد ماشيدا… كان مقفلًا.
Dialogue: 0,0:28:30.34,0:28:32.34,Default,,0,0,0,,‫وفوق ذلك… هو قفلٌ مزدوج،
Dialogue: 0,0:28:32.34,0:28:36.74,Default,,0,0,0,,‫والمفاتيح كانت معي، لذلك لا يمكن أن يكون قد فُتح.
Dialogue: 0,0:28:36.74,0:28:38.84,Default,,0,0,0,,‫وهذا يعني أنكِ كنتِ تتحكمين بالباب
Dialogue: 0,0:28:38.84,0:28:41.04,Default,,0,0,0,,‫ويمكنك فتحه إن أردتِ.
Dialogue: 0,0:28:41.04,0:28:44.64,Default,,0,0,0,,‫لا… هي أيضًا لا يمكن أن تكون ارتكبت الجريمة.
Dialogue: 0,0:28:44.64,0:28:46.64,Default,,0,0,0,,‫مع أنه كان الظلام دامسًا،
Dialogue: 0,0:28:46.64,0:28:47.94,Default,,0,0,0,,‫أظن أنه كان مستحيلًا عليها
Dialogue: 0,0:28:47.94,0:28:49.64,Default,,0,0,0,,‫أن تسحب رجلًا يقاوم إلى الباب
Dialogue: 0,0:28:49.64,0:28:52.34,Default,,0,0,0,,‫ثم تدفعه للخارج بقوتها.
Dialogue: 0,0:28:52.34,0:28:53.94,Default,,0,0,0,,‫أحقًا؟
Dialogue: 0,0:28:53.94,0:28:55.84,Default,,0,0,0,,‫أنا لا أظنه مستحيلًا.
Dialogue: 0,0:28:55.84,0:28:58.24,Default,,0,0,0,,‫كنتُ جالسًا بجانب الباب تمامًا،
Dialogue: 0,0:28:58.24,0:29:01.34,Default,,0,0,0,,‫ولم أسمع صوتَ فتحِ الباب أو ارتجاجه.
Dialogue: 0,0:29:01.34,0:29:04.04,Default,,0,0,0,,‫ومع ذلك… لا يمكن فتح النافذة أيضًا.
Dialogue: 0,0:29:04.04,0:29:07.84,Default,,0,0,0,,‫ومخرج الطوارئ لا يبدو أنه استُخدم.
Dialogue: 0,0:29:07.84,0:29:09.64,Default,,0,0,0,,‫إذًا كيف…
Dialogue: 0,0:29:17.64,0:29:21.04,Default,,0,0,0,,‫على أي حال… هل يمكنكم جميعًا النزول إلى سفح الجبل؟
Dialogue: 0,0:29:21.04,0:29:23.44,Default,,0,0,0,,‫لنتحدث هناك بتفاصيل أكثر.
Dialogue: 0,0:29:23.64,0:29:25.54,Default,,0,0,0,,‫آه… سيد ياسونوري.
Dialogue: 0,0:29:25.54,0:29:29.54,Default,,0,0,0,,‫هل يمكننا استخدام غرفة الضيوف الخاصة؟
Dialogue: 0,0:29:29.54,0:29:31.24,Default,,0,0,0,,‫نعم، بالطبع… تفضّلوا.
Dialogue: 0,0:29:33.84,0:29:36.64,Default,,0,0,0,,‫سيد ياسونوري يتصرف بغرابة قليلًا.
Dialogue: 0,0:29:36.64,0:29:39.44,Default,,0,0,0,,‫نعم… أنا متأكد أنه يُخفي شيئًا.
Dialogue: 0,0:29:39.44,0:29:43.14,Default,,0,0,0,,‫لا… هو يريد قول شيء، لكنه متردد في ذكره.
Dialogue: 0,0:29:43.14,0:29:45.24,Default,,0,0,0,,‫ترى ما الذي يريد قوله؟
Dialogue: 0,0:29:45.24,0:29:47.04,Default,,0,0,0,,‫الآن وقد ذكرت… وقتها…
Dialogue: 0,0:29:47.94,0:29:49.64,Default,,0,0,0,,‫كل الاستعدادات مثالية.
Dialogue: 0,0:29:49.64,0:29:52.04,Default,,0,0,0,,‫ولا أحد لاحظ شيئًا.
Dialogue: 0,0:29:52.04,0:29:53.54,Default,,0,0,0,,‫حديث ذلك الوقت…
Dialogue: 0,0:29:53.54,0:29:55.74,Default,,0,0,0,,‫ولحظة العثور على جثة السيد إيزو…
Dialogue: 0,0:29:57.04,0:29:59.44,Default,,0,0,0,,‫لا يمكن أن يكون…
Dialogue: 0,0:29:59.44,0:30:02.74,Default,,0,0,0,,‫لم يكن من المفترض أن ينتهي الأمر هكذا.
Dialogue: 0,0:30:02.74,0:30:06.74,Default,,0,0,0,,‫ربما كان يتوقع نتيجةً أخرى؟
Dialogue: 0,0:30:06.74,0:30:09.84,Default,,0,0,0,,‫هل توجد حقًا لعنة تمثال الإلهة؟
Dialogue: 0,0:30:09.84,0:30:13.34,Default,,0,0,0,,‫جئنا لنكتب مقالًا عنها… وانتهى بنا الأمر مشتبهًا بنا!
Dialogue: 0,0:30:13.34,0:30:15.14,Default,,0,0,0,,‫هل يمكن أن يكون هذا لعنة فعلًا؟
Dialogue: 0,0:30:15.14,0:30:17.74,Default,,0,0,0,,‫لا تكن سخيفًا! نحن محظوظون.
Dialogue: 0,0:30:17.74,0:30:19.74,Default,,0,0,0,,‫هذه سبقٌ صحفي حقيقي!
Dialogue: 0,0:30:20.84,0:30:24.34,Default,,0,0,0,,‫النتيجة الأخرى ربما تكون…
Dialogue: 0,0:30:25.64,0:30:27.24,Default,,0,0,0,,‫حتى لو طلبنا من السيد ياسونوري
Dialogue: 0,0:30:27.24,0:30:29.04,Default,,0,0,0,,‫أن يأتي معنا إلى المركز بمحض إرادته،
Dialogue: 0,0:30:29.04,0:30:30.84,Default,,0,0,0,,‫فعلينا أولًا أن نعرف كيف
Dialogue: 0,0:30:30.84,0:30:32.64,Default,,0,0,0,,‫اختفى السيد إيزو من التلفريك
Dialogue: 0,0:30:32.64,0:30:34.74,Default,,0,0,0,,‫ثم عُثر عليه في كف تمثال الإلهة
Dialogue: 0,0:30:34.74,0:30:36.84,Default,,0,0,0,,‫خلال سبع ثوانٍ فقط.
Dialogue: 0,0:30:36.84,0:30:39.04,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:30:39.04,0:30:42.44,Default,,0,0,0,,‫وهذا هو أكبرُ إشكال.
Dialogue: 0,0:30:42.44,0:30:44.34,Default,,0,0,0,,‫الجثة لا يمكن أن تمشي
Dialogue: 0,0:30:44.34,0:30:47.64,Default,,0,0,0,,‫وحدها حتى تمثال الإلهة.
Dialogue: 0,0:30:48.94,0:30:50.54,Default,,0,0,0,,‫هل يُعقل أن…
Dialogue: 0,0:30:50.54,0:30:54.24,Default,,0,0,0,,‫لا… لكن إن كان الأمر كذلك…
Dialogue: 0,0:30:54.24,0:30:56.54,Default,,0,0,0,,‫فلا بد أنه ذلك الكوخ…
Dialogue: 0,0:31:10.84,0:31:12.34,Default,,0,0,0,,‫وجدتها!
Dialogue: 0,0:31:16.54,0:31:19.74,Default,,0,0,0,,‫ما هذا؟ هناك شيءٌ ملتصق به.
Dialogue: 0,0:31:19.74,0:31:21.34,Default,,0,0,0,,‫هذا…
Dialogue: 0,0:31:32.34,0:31:35.64,Default,,0,0,0,,‫بنطالُ عمّال… ممتاز!
Dialogue: 0,0:31:35.64,0:31:37.64,Default,,0,0,0,,‫لم يبقَ إلا…
Dialogue: 0,0:31:37.64,0:31:40.64,Default,,0,0,0,,‫حسنًا… يمكنني استخدام تلك الممسحة.
Dialogue: 0,0:31:44.24,0:31:45.34,Default,,0,0,0,,‫تمّ الأمر.
Dialogue: 0,0:31:45.34,0:31:47.04,Default,,0,0,0,,‫هيه!
Dialogue: 0,0:31:47.04,0:31:49.44,Default,,0,0,0,,‫ماذا تفعل هنا أصلًا؟
Dialogue: 0,0:31:49.44,0:31:51.24,Default,,0,0,0,,‫كدتَ تُفزعني!
Dialogue: 0,0:31:51.24,0:31:53.54,Default,,0,0,0,,‫ماذا تقصد أنني أفزعتك؟
Dialogue: 0,0:31:53.54,0:31:56.64,Default,,0,0,0,,‫تُقلق الناس حين تختفي فجأةً.
Dialogue: 0,0:31:56.64,0:31:58.54,Default,,0,0,0,,‫آسف.
Dialogue: 0,0:31:58.54,0:32:00.44,Default,,0,0,0,,‫صحيح يا ران!
Dialogue: 0,0:32:00.44,0:32:01.74,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:32:01.74,0:32:06.44,Default,,0,0,0,,‫أنا أشعر بالبرد قليلًا… هل تُعيرينني سترتكِ؟
Dialogue: 0,0:32:06.44,0:32:08.24,Default,,0,0,0,,‫حسنًا، طبعًا.
Dialogue: 0,0:32:09.34,0:32:11.34,Default,,0,0,0,,‫-تفضّل. -شكرًا!
Dialogue: 0,0:32:11.34,0:32:12.94,Default,,0,0,0,,‫سأنتظركم عند سفح الجبل إذًا.
Dialogue: 0,0:32:12.94,0:32:14.34,Default,,0,0,0,,‫آه… كونان!
Dialogue: 0,0:32:16.34,0:32:19.74,Default,,0,0,0,,‫ماذا؟ ستتركني هنا هكذا؟
Dialogue: 0,0:32:41.84,0:32:44.04,Default,,0,0,0,,‫تمامًا كما توقعت.
Dialogue: 0,0:32:48.94,0:32:52.34,Default,,0,0,0,,‫سيد ياسونوري… في التلفريك،
Dialogue: 0,0:32:52.34,0:32:54.84,Default,,0,0,0,,‫كنتَ جالسًا بجانب السيد إيزو.
Dialogue: 0,0:32:54.84,0:32:58.54,Default,,0,0,0,,‫غريبٌ أنك لم تلاحظ شيئًا.
Dialogue: 0,0:32:58.54,0:33:00.84,Default,,0,0,0,,‫ما الذي تُخفيه؟
Dialogue: 0,0:33:00.84,0:33:03.74,Default,,0,0,0,,‫لا أخفي شيئًا.
Dialogue: 0,0:33:03.74,0:33:07.14,Default,,0,0,0,,‫تتحدث وكأنني القاتل!
Dialogue: 0,0:33:07.14,0:33:10.34,Default,,0,0,0,,‫أرِني الدليل إذًا!
Dialogue: 0,0:33:10.34,0:33:12.34,Default,,0,0,0,,‫لا… لم أقل إنك القاتل.
Dialogue: 0,0:33:12.34,0:33:14.64,Default,,0,0,0,,‫بما أن القضية غامضة،
Dialogue: 0,0:33:14.64,0:33:16.74,Default,,0,0,0,,‫فنحاول التقاط أي خيط بسؤال الجميع.
Dialogue: 0,0:33:16.74,0:33:19.04,Default,,0,0,0,,‫إذًا… لماذا لا تسألون الآخرين أيضًا؟
Dialogue: 0,0:33:19.04,0:33:21.44,Default,,0,0,0,,‫حسنًا… بالطبع.
Dialogue: 0,0:33:21.44,0:33:23.64,Default,,0,0,0,,‫كونان!
Dialogue: 0,0:33:23.64,0:33:25.34,Default,,0,0,0,,‫أنت نزلت قبلي،
Dialogue: 0,0:33:25.34,0:33:27.94,Default,,0,0,0,,‫فلماذا أراك هنا بعدي؟
Dialogue: 0,0:33:27.94,0:33:30.24,Default,,0,0,0,,‫ضللتُ الطريق قليلًا.
Dialogue: 0,0:33:30.24,0:33:33.24,Default,,0,0,0,,‫ألن تتركنا نذهب أخيرًا؟
Dialogue: 0,0:33:33.24,0:33:37.24,Default,,0,0,0,,‫لا دافع لديّ لقتل إيزو دوموتو.
Dialogue: 0,0:33:37.24,0:33:39.64,Default,,0,0,0,,‫إذًا لا تريد أن تتعامل مع أحد هنا
Dialogue: 0,0:33:39.64,0:33:42.34,Default,,0,0,0,,‫لأنك لم تعد تستطيع الابتزاز… صحيح؟
Dialogue: 0,0:33:42.34,0:33:44.04,Default,,0,0,0,,‫لا أطيق مشاهدة
Dialogue: 0,0:33:44.04,0:33:46.24,Default,,0,0,0,,‫هذا الخلاف القبيح على أمور العائلة أكثر!
Dialogue: 0,0:33:46.24,0:33:47.84,Default,,0,0,0,,‫احذر كلامك!
Dialogue: 0,0:33:47.84,0:33:50.24,Default,,0,0,0,,‫حسنًا، حسنًا… اهدؤوا جميعًا.
Dialogue: 0,0:33:50.24,0:33:51.44,Default,,0,0,0,,‫لن يطول الأمر.
Dialogue: 0,0:33:51.44,0:33:54.34,Default,,0,0,0,,‫المفتش يوكوميزو!
Dialogue: 0,0:33:54.34,0:33:57.94,Default,,0,0,0,,‫لماذا لا نجرب جميعًا ركوب التلفريك مرةً أخرى؟
Dialogue: 0,0:33:57.94,0:33:59.54,Default,,0,0,0,,‫التلفريك؟
Dialogue: 0,0:33:59.54,0:34:02.34,Default,,0,0,0,,‫هيه… لا تتدخل!
Dialogue: 0,0:34:02.34,0:34:04.04,Default,,0,0,0,,‫نعم! لنركبه!
Dialogue: 0,0:34:04.04,0:34:05.74,Default,,0,0,0,,‫يقولون: الأفضل أن تزور الموقع مئة مرة.
Dialogue: 0,0:34:05.74,0:34:09.64,Default,,0,0,0,,‫قد نكتشف شيئًا جديدًا.
Dialogue: 0,0:34:09.64,0:34:12.54,Default,,0,0,0,,‫سنركب ذلك الشيء مجددًا؟
Dialogue: 0,0:34:12.54,0:34:16.24,Default,,0,0,0,,‫لا توجد لعنةٌ ولا شيء من هذا في هذه القضية.
Dialogue: 0,0:34:16.24,0:34:17.84,Default,,0,0,0,,‫لقد عرفتُ لماذا تمت دعوة صحفيّي "توكاي نيبّو"
Dialogue: 0,0:34:17.84,0:34:20.74,Default,,0,0,0,,‫إلى رحلة الاختبار.
Dialogue: 0,0:34:20.74,0:34:23.24,Default,,0,0,0,,‫وعرفتُ خدعة اختفاء السيد إيزو،
Dialogue: 0,0:34:23.24,0:34:25.64,Default,,0,0,0,,‫وكذلك ملاحظة السيد ياسونوري الغريبة،
Dialogue: 0,0:34:25.64,0:34:28.14,Default,,0,0,0,,‫ومسألة المعصم في المحرقة.
Dialogue: 0,0:34:28.14,0:34:31.84,Default,,0,0,0,,‫سأكشف اللغز كله داخل التلفريك.
Dialogue: 0,0:34:50.19,0:34:52.99,Default,,0,0,0,,‫سيد موري… لا تقل إنك…
Dialogue: 0,0:34:52.99,0:34:54.99,Default,,0,0,0,,‫اصمت! هل يضايقك هذا؟
Dialogue: 0,0:34:54.99,0:34:56.49,Default,,0,0,0,,‫لا، لا!
Dialogue: 0,0:34:56.49,0:34:57.89,Default,,0,0,0,,‫أنا مرتاح لأنني عرفت
Dialogue: 0,0:34:57.89,0:35:01.69,Default,,0,0,0,,‫أن المحقق الشهير بشرٌ مثلنا.
Dialogue: 0,0:35:01.69,0:35:04.09,Default,,0,0,0,,‫هيه… ران.
Dialogue: 0,0:35:04.09,0:35:05.29,Default,,0,0,0,,‫أتعلمين…
Dialogue: 0,0:35:07.79,0:35:10.79,Default,,0,0,0,,‫ماذا؟ لماذا تفعل شيئًا كهذا؟
Dialogue: 0,0:35:10.79,0:35:13.19,Default,,0,0,0,,‫أبي قال أن أفعلها سرًا.
Dialogue: 0,0:35:13.19,0:35:16.29,Default,,0,0,0,,‫أبي قال ذلك؟
Dialogue: 0,0:35:16.29,0:35:17.49,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:35:20.39,0:35:22.79,Default,,0,0,0,,‫عشرة خراف… أحد عشر خروفًا…
Dialogue: 0,0:35:22.79,0:35:25.49,Default,,0,0,0,,‫أبي… هل تحاول أن تنام أو ماذا؟
Dialogue: 0,0:35:25.49,0:35:28.89,Default,,0,0,0,,‫لا تكلمني! سأنسى العدّ!
Dialogue: 0,0:35:28.89,0:35:30.79,Default,,0,0,0,,‫-كم وصلنا؟ -حسنًا.
Dialogue: 0,0:35:30.79,0:35:33.29,Default,,0,0,0,,‫سأدعك تنام كما تريد.
Dialogue: 0,0:35:35.19,0:35:37.09,Default,,0,0,0,,‫إنها قادمة…
Dialogue: 0,0:35:37.29,0:35:40.19,Default,,0,0,0,,‫سيد موري… ما الأمر؟
Dialogue: 0,0:35:40.19,0:35:42.19,Default,,0,0,0,,‫وأخيرًا… إنها قادمة!
Dialogue: 0,0:35:42.19,0:35:43.79,Default,,0,0,0,,‫أبي!
Dialogue: 0,0:35:43.79,0:35:44.89,Default,,0,0,0,,‫التقط له صورة.
Dialogue: 0,0:35:44.89,0:35:46.69,Default,,0,0,0,,‫لقد أصبح "كوجورو النائم"!
Dialogue: 0,0:35:46.69,0:35:48.79,Default,,0,0,0,,‫حاضر.
Dialogue: 0,0:35:48.79,0:35:53.59,Default,,0,0,0,,‫سيد ياسونوري… أعذرني على كلامي الوقح سابقًا.
Dialogue: 0,0:35:53.59,0:35:57.19,Default,,0,0,0,,‫لكنني كنت أعلم منذ البداية
Dialogue: 0,0:35:57.19,0:35:59.49,Default,,0,0,0,,‫أنك لست من قتل السيد إيزو.
Dialogue: 0,0:35:59.49,0:36:01.89,Default,,0,0,0,,‫كما يُتوقع منك يا سيد موري.
Dialogue: 0,0:36:01.89,0:36:04.09,Default,,0,0,0,,‫ألم تكن لديكم خطة مع السيد إيزو
Dialogue: 0,0:36:04.09,0:36:06.29,Default,,0,0,0,,‫لفعل شيءٍ يُفاجئ الجميع
Dialogue: 0,0:36:06.29,0:36:11.49,Default,,0,0,0,,‫في حفل الافتتاح اليوم؟
Dialogue: 0,0:36:13.89,0:36:16.49,Default,,0,0,0,,‫خطةٌ كبيرة لإزالة شائعة لعنة تمثال الإلهة
Dialogue: 0,0:36:16.49,0:36:20.19,Default,,0,0,0,,‫التي تسيء لسمعة التلفريك،
Dialogue: 0,0:36:20.19,0:36:22.09,Default,,0,0,0,,‫وفي الوقت نفسه…
Dialogue: 0,0:36:22.09,0:36:24.09,Default,,0,0,0,,‫تكون إعلانًا قويًا للتلفريك.
Dialogue: 0,0:36:25.39,0:36:29.09,Default,,0,0,0,,‫سأحاول الآن إعادة تمثيل خطتكم.
Dialogue: 0,0:36:33.29,0:36:34.59,Default,,0,0,0,,‫ماذا يحدث هنا؟
Dialogue: 0,0:36:35.59,0:36:38.49,Default,,0,0,0,,‫(ترتيل)
Dialogue: 0,0:36:38.49,0:36:40.99,Default,,0,0,0,,‫إنه نفس ما حدث وقتها.
Dialogue: 0,0:36:40.99,0:36:43.79,Default,,0,0,0,,‫ماذا سيحدث؟ كفّوا عن هذا!
Dialogue: 0,0:36:52.19,0:36:54.39,Default,,0,0,0,,‫ران اختفت؟
Dialogue: 0,0:36:54.39,0:36:56.89,Default,,0,0,0,,‫تمامًا كما اختفى أبي حينها.
Dialogue: 0,0:36:56.89,0:36:59.49,Default,,0,0,0,,‫كيف يمكن…
Dialogue: 0,0:36:59.49,0:37:01.69,Default,,0,0,0,,‫هل يمكن لشيء كهذا أن يحدث؟
Dialogue: 0,0:37:01.69,0:37:04.39,Default,,0,0,0,,‫سيد موري… إلى أين اختفت ابنتك؟
Dialogue: 0,0:37:04.39,0:37:06.79,Default,,0,0,0,,‫انظروا إلى تمثال الإلهة.
Dialogue: 0,0:37:06.79,0:37:07.99,Default,,0,0,0,,‫لا يمكن…
Dialogue: 0,0:37:11.69,0:37:13.89,Default,,0,0,0,,‫انظروا… فوق كف تمثال الإلهة!
Dialogue: 0,0:37:16.49,0:37:19.09,Default,,0,0,0,,‫ران؟ لا…
Dialogue: 0,0:37:19.09,0:37:22.79,Default,,0,0,0,,‫دمية ترتدي سترة ران؟
Dialogue: 0,0:37:22.79,0:37:26.49,Default,,0,0,0,,‫بالضبط! صُنعت من ممسحة وبعض الأغصان.
Dialogue: 0,0:37:26.49,0:37:29.89,Default,,0,0,0,,‫اخرجي يا ران.
Dialogue: 0,0:37:29.89,0:37:31.89,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:37:34.39,0:37:36.49,Default,,0,0,0,,‫تحت المقعد؟
Dialogue: 0,0:37:36.49,0:37:42.69,Default,,0,0,0,,‫سيد ياسونوري… أنت من ابتكر هذه الخطة الكبيرة والبسيطة في آنٍ واحد،
Dialogue: 0,0:37:42.69,0:37:44.59,Default,,0,0,0,,‫وكان السيد إيزو يؤدي الدور.
Dialogue: 0,0:37:44.59,0:37:46.29,Default,,0,0,0,,‫أليس كذلك؟
Dialogue: 0,0:37:47.79,0:37:49.09,Default,,0,0,0,,‫نعم… هذا صحيح.
Dialogue: 0,0:37:49.09,0:37:51.29,Default,,0,0,0,,‫طلبتُ من شخصٍ أعرفه يصنع الدمى
Dialogue: 0,0:37:51.29,0:37:56.49,Default,,0,0,0,,‫أن يصنع سرًا دميةً مطاطية تشبه والدي تمامًا.
Dialogue: 0,0:37:56.49,0:37:59.59,Default,,0,0,0,,‫في اليوم السابق لحفل الافتتاح…
Dialogue: 0,0:37:59.59,0:38:04.69,Default,,0,0,0,,‫وبعد أن غادرتُ حفلتكم وبدأتُ النزول من الساحة،
Dialogue: 0,0:38:04.69,0:38:06.59,Default,,0,0,0,,‫توقفتُ عند المرصد
Dialogue: 0,0:38:06.59,0:38:09.89,Default,,0,0,0,,‫لآخذ الدمية التي طلبت صنعها مسبقًا،
Dialogue: 0,0:38:09.89,0:38:12.09,Default,,0,0,0,,‫ووضعتها على كف تمثال الإلهة.
Dialogue: 0,0:38:13.19,0:38:14.79,Default,,0,0,0,,‫كف تمثال الإلهة
Dialogue: 0,0:38:14.79,0:38:16.79,Default,,0,0,0,,‫لا يمكن رؤيته إلا من داخل التلفريك
Dialogue: 0,0:38:16.79,0:38:18.39,Default,,0,0,0,,‫بعد خروجه من النفق.
Dialogue: 0,0:38:19.69,0:38:23.99,Default,,0,0,0,,‫ولهذا لم أقلق من أن يراني أحد.
Dialogue: 0,0:38:23.99,0:38:25.69,Default,,0,0,0,,‫ثم نفّذتَ خطتك
Dialogue: 0,0:38:25.69,0:38:29.89,Default,,0,0,0,,‫في اليوم التالي أثناء حفل الافتتاح.
Dialogue: 0,0:38:29.89,0:38:33.09,Default,,0,0,0,,‫نعم… بعد دخولنا النفق،
Dialogue: 0,0:38:33.09,0:38:36.69,Default,,0,0,0,,‫قطعتُ سلك دائرة إنارة المصابيح.
Dialogue: 0,0:38:36.69,0:38:38.99,Default,,0,0,0,,‫وبعد أن انطفأت الأنوار، فورًا
Dialogue: 0,0:38:38.99,0:38:41.89,Default,,0,0,0,,‫أخرجتُ جهاز التسجيل وشغّلتُ الترتيل.
Dialogue: 0,0:38:41.89,0:38:44.99,Default,,0,0,0,,‫وبعد أن تظاهر أبي بالخوف،
Dialogue: 0,0:38:44.99,0:38:48.09,Default,,0,0,0,,‫اختبأ في الفراغ تحت المقعد.
Dialogue: 0,0:38:49.69,0:38:52.59,Default,,0,0,0,,‫وأنا لصقتُ التعويذة على زجاج النافذة.
Dialogue: 0,0:38:54.79,0:38:58.69,Default,,0,0,0,,‫وأنا من أسقط كاميرا الصحفي ناكانو على الأرض،
Dialogue: 0,0:38:58.69,0:39:02.69,Default,,0,0,0,,‫لأني لا أريد أن ينكشف الخداع بفلاش الكاميرا.
Dialogue: 0,0:39:02.69,0:39:06.09,Default,,0,0,0,,‫المساحة تحت المقعد مخصصة لأدوات الطوارئ،
Dialogue: 0,0:39:06.09,0:39:09.99,Default,,0,0,0,,‫وللأوزان اللازمة عند اشتداد الريح،
Dialogue: 0,0:39:09.99,0:39:12.99,Default,,0,0,0,,‫لكنني أخرجتُ كل شيءٍ منها مسبقًا.
Dialogue: 0,0:39:12.99,0:39:15.59,Default,,0,0,0,,‫وبينما كان الجميع متجهين إلى المرصد،
Dialogue: 0,0:39:15.59,0:39:17.29,Default,,0,0,0,,‫كان المفترض بأبي أن يعود إلى النفق
Dialogue: 0,0:39:17.29,0:39:18.99,Default,,0,0,0,,‫باستخدام التلفريك الفارغ،
Dialogue: 0,0:39:18.99,0:39:20.69,Default,,0,0,0,,‫ثم يقفز إلى الأسفل.
Dialogue: 0,0:39:22.19,0:39:24.39,Default,,0,0,0,,‫وبعد الوصول إلى المرصد،
Dialogue: 0,0:39:24.39,0:39:28.79,Default,,0,0,0,,‫كان عليه أن يزيل الدمية من فوق التمثال،
Dialogue: 0,0:39:28.79,0:39:31.09,Default,,0,0,0,,‫ثم يصعد مكانها هو.
Dialogue: 0,0:39:31.09,0:39:32.79,Default,,0,0,0,,‫وكان من المفترض أن يستقبلنا جميعًا
Dialogue: 0,0:39:32.79,0:39:34.49,Default,,0,0,0,,‫نحن الذين صعدنا لنتحقق منه… بابتسامة.
Dialogue: 0,0:39:34.49,0:39:35.59,Default,,0,0,0,,‫أليس كذلك؟
Dialogue: 0,0:39:35.59,0:39:37.39,Default,,0,0,0,,‫لا يوجد في هذا العالم
Dialogue: 0,0:39:37.39,0:39:40.99,Default,,0,0,0,,‫ما يُسمّى لعناتٍ أو سحرًا شريرًا!
Dialogue: 0,0:39:40.99,0:39:43.09,Default,,0,0,0,,‫وكان هدفه أن يقنع الجميع أنه لا أساس للشائعة،
Dialogue: 0,0:39:43.09,0:39:46.29,Default,,0,0,0,,‫ويقضي عليها دفعةً واحدة.
Dialogue: 0,0:39:46.29,0:39:47.89,Default,,0,0,0,,‫إذًا لهذا دعوتمونا؟
Dialogue: 0,0:39:47.89,0:39:50.79,Default,,0,0,0,,‫لا… ليس هذا السبب الوحيد!
Dialogue: 0,0:39:50.79,0:39:55.59,Default,,0,0,0,,‫السيد إيزو كان ينوي توريط "توكاي نيبّو"!
Dialogue: 0,0:39:55.59,0:39:58.79,Default,,0,0,0,,‫ماذا تقصد بأنه كان ينوي توريطنا؟
Dialogue: 0,0:39:58.79,0:40:00.59,Default,,0,0,0,,‫هل تعرفون
Dialogue: 0,0:40:00.59,0:40:03.79,Default,,0,0,0,,‫لماذا بدأ حفل الافتتاح بعد الظهر؟
Dialogue: 0,0:40:03.79,0:40:06.39,Default,,0,0,0,,‫ربما نزوة من صاحب الحفل.
Dialogue: 0,0:40:06.39,0:40:10.29,Default,,0,0,0,,‫سيد ماشيدا… لقد أرسلتَ خبرًا من قمة الجبل، صحيح؟
Dialogue: 0,0:40:10.29,0:40:11.39,Default,,0,0,0,,‫معكم ماشيدا!
Dialogue: 0,0:40:11.39,0:40:13.39,Default,,0,0,0,,‫اتركوا صفحةً كاملة لنسخة المساء!
Dialogue: 0,0:40:13.39,0:40:14.99,Default,,0,0,0,,‫حدثت لعنة!
Dialogue: 0,0:40:14.99,0:40:16.89,Default,,0,0,0,,‫إيزو دوموتو طُعن
Dialogue: 0,0:40:16.89,0:40:18.79,Default,,0,0,0,,‫فوق كف تمثال الإلهة!
Dialogue: 0,0:40:18.79,0:40:21.69,Default,,0,0,0,,‫لو لم يُطعن إيزو…
Dialogue: 0,0:40:21.69,0:40:24.29,Default,,0,0,0,,‫هل كان بإمكانك تعديل المقال إلى شيءٍ آخر؟
Dialogue: 0,0:40:25.29,0:40:27.59,Default,,0,0,0,,‫آخر موعدٍ لنسخة المساء هو 1:30 ظهرًا!
Dialogue: 0,0:40:27.59,0:40:31.59,Default,,0,0,0,,‫بالضبط! كانت صحيفتكم ستنشر معلوماتٍ كاذبة!
Dialogue: 0,0:40:31.59,0:40:32.69,Default,,0,0,0,,‫وبعبارةٍ أخرى،
Dialogue: 0,0:40:32.69,0:40:34.99,Default,,0,0,0,,‫كان هدف السيد إيزو من هذه الخدعة
Dialogue: 0,0:40:34.99,0:40:37.19,Default,,0,0,0,,‫هو إثبات أنه لا وجود لعنة،
Dialogue: 0,0:40:37.19,0:40:41.89,Default,,0,0,0,,‫وفي الوقت نفسه تشويه سمعة "توكاي نيبّو".
Dialogue: 0,0:40:41.89,0:40:43.09,Default,,0,0,0,,‫فهمت…
Dialogue: 0,0:40:43.09,0:40:45.49,Default,,0,0,0,,‫ولهذا قال لك ذلك وقتها:
Dialogue: 0,0:40:45.89,0:40:49.89,Default,,0,0,0,,‫"ترى إلى متى ستبقى وقحًا هكذا؟"
Dialogue: 0,0:40:49.89,0:40:52.09,Default,,0,0,0,,‫يا له من تصرفٍ قذر!
Dialogue: 0,0:40:52.29,0:40:53.49,Default,,0,0,0,,‫وبالمناسبة…
Dialogue: 0,0:40:53.69,0:40:55.69,Default,,0,0,0,,‫بعيدًا عن اللعنات والتعاويذ،
Dialogue: 0,0:40:55.69,0:40:57.79,Default,,0,0,0,,‫هناك مأساةٌ حزينة أخرى مخبأة
Dialogue: 0,0:40:57.79,0:41:01.69,Default,,0,0,0,,‫خلف نفق هذا التلفريك… أليس كذلك؟
Dialogue: 0,0:41:01.69,0:41:03.49,Default,,0,0,0,,‫وفاة العامل بالخطأ.
Dialogue: 0,0:41:03.49,0:41:05.69,Default,,0,0,0,,‫سمعتُ بها من رينا.
Dialogue: 0,0:41:05.69,0:41:08.99,Default,,0,0,0,,‫هل يمكنك إخبارنا عنها يا سيد ياسونوري؟
Dialogue: 0,0:41:08.99,0:41:13.09,Default,,0,0,0,,‫الشخص الذي توفي كان اسمه تاكاهاتا.
Dialogue: 0,0:41:13.09,0:41:15.09,Default,,0,0,0,,‫كانت أمه مريضةً باستمرار،
Dialogue: 0,0:41:15.09,0:41:17.29,Default,,0,0,0,,‫وفوق ذلك كانت تشعر بديْنٍ ثقيل تجاه عائلة دوموتو منذ سنوات،
Dialogue: 0,0:41:17.29,0:41:20.99,Default,,0,0,0,,‫لذا أجبرهم أبي على الموافقة على عدم نشر الأمر
Dialogue: 0,0:41:20.99,0:41:22.99,Default,,0,0,0,,‫مقابل المال.
Dialogue: 0,0:41:22.99,0:41:27.39,Default,,0,0,0,,‫هل كان للراحل تاكاهاتا أيُّ أقاربٍ آخرين على قيد الحياة؟
Dialogue: 0,0:41:27.39,0:41:31.39,Default,,0,0,0,,‫سمعتُ أن والده الذي طلّق قبل عشر سنوات
Dialogue: 0,0:41:31.39,0:41:33.99,Default,,0,0,0,,‫اصطحب أخته الصغرى إلى طوكيو.
Dialogue: 0,0:41:33.99,0:41:37.29,Default,,0,0,0,,‫وقد يكون أن أخته…
Dialogue: 0,0:41:37.29,0:41:40.79,Default,,0,0,0,,‫موجودةٌ معنا في التلفريك الآن.
Dialogue: 0,0:41:40.79,0:41:41.79,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:41:41.79,0:41:43.69,Default,,0,0,0,,‫لكن الموجودين هنا هم فقط…
Dialogue: 0,0:41:43.69,0:41:46.49,Default,,0,0,0,,‫آنسة يوشينو… لا تقولي إن…
Dialogue: 0,0:41:46.49,0:41:50.89,Default,,0,0,0,,‫نعم… من قتل السيد إيزو دوموتو
Dialogue: 0,0:41:50.89,0:41:53.69,Default,,0,0,0,,‫هي أنتِ… آنسة آياكا يوشينو!
Dialogue: 0,0:41:55.69,0:41:57.59,Default,,0,0,0,,‫هي قتلت أبي؟
Dialogue: 0,0:41:57.59,0:41:59.39,Default,,0,0,0,,‫لا يُصدَّق…
Dialogue: 0,0:41:59.39,0:42:01.39,Default,,0,0,0,,‫الآنسة آياكا هي القاتلة؟
Dialogue: 0,0:42:01.39,0:42:02.49,Default,,0,0,0,,‫مستحيل…
Dialogue: 0,0:42:06.89,0:42:08.69,Default,,0,0,0,,‫لا بد أن القاتل كان شخصًا
Dialogue: 0,0:42:08.69,0:42:11.79,Default,,0,0,0,,‫يستطيع التحرك سرًا بالتنسيق مع السيد إيزو،
Dialogue: 0,0:42:11.79,0:42:15.89,Default,,0,0,0,,‫وشخصًا لن يشك به.
Dialogue: 0,0:42:15.89,0:42:19.69,Default,,0,0,0,,‫الآنسة آياكا بقيت في محطة التلفريك لأنها لم تكن بخير.
Dialogue: 0,0:42:19.69,0:42:23.09,Default,,0,0,0,,‫ثم ركبت التلفريك المتجه نزولًا.
Dialogue: 0,0:42:23.09,0:42:26.39,Default,,0,0,0,,‫وبما أن محطة القمة كانت في فوضى
Dialogue: 0,0:42:26.39,0:42:29.59,Default,,0,0,0,,‫بسبب ما حدث للرئيس،
Dialogue: 0,0:42:29.59,0:42:32.09,Default,,0,0,0,,‫لم يلاحظ أحدٌ أنها ركبت التلفريك المتجه نزولًا.
Dialogue: 0,0:42:33.59,0:42:36.59,Default,,0,0,0,,‫وبما أنكِ كنتِ ترافقين الرئيس دائمًا،
Dialogue: 0,0:42:36.59,0:42:39.99,Default,,0,0,0,,‫طعنتِه فوق كف تمثال الإلهة.
Dialogue: 0,0:42:39.99,0:42:43.09,Default,,0,0,0,,‫ثم أحرقتِ دميتَه في المحرقة.
Dialogue: 0,0:42:43.09,0:42:45.29,Default,,0,0,0,,‫وبعد التأكد من احتراق كل شيء،
Dialogue: 0,0:42:45.29,0:42:48.49,Default,,0,0,0,,‫عدتِ إلى المرصد حيث كان الجميع.
Dialogue: 0,0:42:49.89,0:42:55.39,Default,,0,0,0,,‫الوحيدة القادرة على ارتكاب هذه الجريمة هي أنتِ
Dialogue: 0,0:42:55.39,0:42:57.89,Default,,0,0,0,,‫لأنكِ تعرفين السر بين السيد إيزو والسيد ياسونوري.
Dialogue: 0,0:42:57.89,0:43:01.99,Default,,0,0,0,,‫كل ما قلته مجرد افتراضات!
Dialogue: 0,0:43:01.99,0:43:03.49,Default,,0,0,0,,‫سيد ياسونوري…
Dialogue: 0,0:43:03.49,0:43:06.79,Default,,0,0,0,,‫هل تفتح الطرد الموجود بجانبي من فضلك؟
Dialogue: 0,0:43:06.79,0:43:08.39,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:43:09.79,0:43:11.09,Default,,0,0,0,,‫هذا هو، صحيح؟
Dialogue: 0,0:43:13.49,0:43:15.59,Default,,0,0,0,,‫هذا…
Dialogue: 0,0:43:15.59,0:43:16.89,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:43:16.89,0:43:19.39,Default,,0,0,0,,‫أيمكن أن يكون… معصم الدمية؟
Dialogue: 0,0:43:19.39,0:43:22.89,Default,,0,0,0,,‫هذا عُثر عليه متروكًا داخل المحرقة.
Dialogue: 0,0:43:22.89,0:43:25.69,Default,,0,0,0,,‫عندما أحرقت الآنسة آياكا الدمية،
Dialogue: 0,0:43:25.69,0:43:28.69,Default,,0,0,0,,‫أسقطت شيئًا مهمًا جدًا
Dialogue: 0,0:43:28.69,0:43:31.59,Default,,0,0,0,,‫على يدها!
Dialogue: 0,0:43:31.59,0:43:32.79,Default,,0,0,0,,‫وما هذا؟
Dialogue: 0,0:43:32.79,0:43:35.49,Default,,0,0,0,,‫يبدو كقطعةِ حُليّ أو شيءٍ كهذا.
Dialogue: 0,0:43:35.49,0:43:36.89,Default,,0,0,0,,‫أوه لا… لا تقل لي…
Dialogue: 0,0:43:36.89,0:43:37.99,Default,,0,0,0,,‫بلى.
Dialogue: 0,0:43:37.99,0:43:41.59,Default,,0,0,0,,‫إنه حجر اليَشم الذي يجب أن يكون في بروشِكِ على صدرك.
Dialogue: 0,0:43:41.59,0:43:42.79,Default,,0,0,0,,‫إذا كبّرنا الصورة التي التُقطت
Dialogue: 0,0:43:42.79,0:43:44.89,Default,,0,0,0,,‫خلال حفل الافتتاح،
Dialogue: 0,0:43:44.89,0:43:48.69,Default,,0,0,0,,‫فسنرى بوضوح أن بروشَكِ كان سليمًا
Dialogue: 0,0:43:48.69,0:43:50.49,Default,,0,0,0,,‫قبل أن تركبي التلفريك.
Dialogue: 0,0:43:53.39,0:43:57.09,Default,,0,0,0,,‫الأمر تمامًا كما قال السيد موري.
Dialogue: 0,0:43:57.09,0:43:59.79,Default,,0,0,0,,‫هل تخبريننا لماذا فعلتِ ذلك؟
Dialogue: 0,0:43:59.79,0:44:01.69,Default,,0,0,0,,‫رغم أن والدينا كانا مطلّقين،
Dialogue: 0,0:44:01.69,0:44:04.59,Default,,0,0,0,,‫كنتُ على تواصلٍ دائم مع أخي،
Dialogue: 0,0:44:04.59,0:44:06.79,Default,,0,0,0,,‫وكنا نشجّع بعضنا دائمًا.
Dialogue: 0,0:44:06.79,0:44:09.19,Default,,0,0,0,,‫في العام الماضي… حين تدهورت حالة أمي كثيرًا،
Dialogue: 0,0:44:09.19,0:44:11.09,Default,,0,0,0,,‫ذهبتُ لزيارتها في المستشفى.
Dialogue: 0,0:44:11.09,0:44:14.49,Default,,0,0,0,,‫فأخبرتني وهي تبكي عن موت أخي المُهين،
Dialogue: 0,0:44:14.49,0:44:18.39,Default,,0,0,0,,‫وعن الكراهية التي كانت تحملها لإيزو دوموتو قبل أن تموت.
Dialogue: 0,0:44:18.39,0:44:23.29,Default,,0,0,0,,‫فأخفيتُ هويتي والتحقتُ بشركة دوموتو تورز
Dialogue: 0,0:44:23.29,0:44:25.19,Default,,0,0,0,,‫كي أنتقم لموت أخي
Dialogue: 0,0:44:25.19,0:44:27.19,Default,,0,0,0,,‫الذي دُفع إلى الموت بسبب إيزو دوموتو،
Dialogue: 0,0:44:27.19,0:44:30.79,Default,,0,0,0,,‫وكذلك أنتقم لأمي التي عانت بسببه.
Dialogue: 0,0:46:00.29,0:46:01.59,Default,,0,0,0,,‫آنسة آياكا…
Dialogue: 0,0:46:01.59,0:46:04.89,Default,,0,0,0,,‫كانت لطيفة وطيبة جدًا… ومع ذلك…
Dialogue: 0,0:46:04.89,0:46:08.89,Default,,0,0,0,,‫ربما انتقلت قصة لعنة تمثال الإلهة عبر الأجيال
Dialogue: 0,0:46:08.89,0:46:13.59,Default,,0,0,0,,‫لتُعلّم أن من يخطئ أو يرتكب جريمةً لا تُغتفر،
Dialogue: 0,0:46:13.59,0:46:17.89,Default,,0,0,0,,‫فإن نهايةً مرعبة قد تنتظره…
Dialogue: 0,0:46:17.89,0:46:20.49,Default,,0,0,0,,‫تمامًا كما حدث في هذه القضية.
Dialogue: 0,0:46:20.49,0:46:22.49,Default,,0,0,0,,‫مثل هذه المرة.
Dialogue: 0,0:46:27.29,0:46:29.39,Default,,0,0,0,,‫أوه لا… لقد نمتُ!
Dialogue: 0,0:46:29.39,0:46:30.69,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:46:30.69,0:46:34.19,Default,,0,0,0,,‫هيه! أين الجميع؟
Dialogue: 0,0:46:34.19,0:46:36.69,Default,,0,0,0,,‫مرحبًا يا "كوجورو النائم"!
