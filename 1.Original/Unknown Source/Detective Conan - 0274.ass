Dialogue: 0,0:10:26.45,0:10:31.49,Default,,0,0,0,,أخبرت من في السكن ولم يصدقوني
Dialogue: 0,0:10:31.53,0:10:35.33,Default,,0,0,0,,لكن بعدها تحولت المياه في المرحاض إلى لون أحمر فجأة
Dialogue: 0,0:10:35.37,0:10:39.83,Default,,0,0,0,,و أطياف مريبة تختلص النظر إلينا عبر النافذة
Dialogue: 0,0:10:39.83,0:10:47.67,Default,,0,0,0,,و الأدهى من ذلك الشبح الذي يظهر في التلفاز
Dialogue: 0,0:10:47.68,0:10:51.85,Default,,0,0,0,,التلفزة والصحافة نقلت الخبر
Dialogue: 0,0:10:52.81,0:10:55.97,Default,,0,0,0,,لكن جدي لم بقيت هنا
Dialogue: 0,0:10:57.56,0:11:00.35,Default,,0,0,0,,أنا على حافة قبري
Dialogue: 0,0:11:00.35,0:11:02.23,Default,,0,0,0,,لا شيء أخاف منه
Dialogue: 0,0:11:02.27,0:11:06.99,Default,,0,0,0,,ولا أحب أن أرحل من السكن الذي عشت فيه سنوات طوال
Dialogue: 0,0:11:07.03,0:11:09.49,Default,,0,0,0,,أنتظر بصبر
Dialogue: 0,0:11:09.57,0:11:13.78,Default,,0,0,0,,الأشباح لن تظهر إلا ليلاً
Dialogue: 0,0:11:13.91,0:11:16.16,Default,,0,0,0,,كفى هيا لنعد
Dialogue: 0,0:11:17.25,0:11:18.96,Default,,0,0,0,,ماذا ؟
Dialogue: 0,0:11:19.96,0:11:22.38,Default,,0,0,0,,هل أنت بخير ؟
Dialogue: 0,0:11:22.42,0:11:24.71,Default,,0,0,0,,الأمر ممتع جدا
Dialogue: 0,0:11:24.71,0:11:26.84,Default,,0,0,0,,أف
Dialogue: 0,0:11:28.97,0:11:31.18,Default,,0,0,0,,سأظل حتى السابعة
Dialogue: 0,0:11:45.36,0:11:50.45,Default,,0,0,0,,غادروا.. غادروا
Dialogue: 0,0:11:51.53,0:11:57.54,Default,,0,0,0,,بسرعة غادروا هذا المكان
Dialogue: 0,0:12:06.17,0:12:11.34,Default,,0,0,0,,ايم لايم
Dialogue: 0,0:12:11.38,0:12:13.09,Default,,0,0,0,,ما الخطب [ ران ] ؟ ་ ་
Dialogue: 0,0:12:13.14,0:12:14.59,Default,,0,0,0,,ماذا حدث لك ؟
Dialogue: 0,0:12:14.64,0:12:18.35,Default,,0,0,0,,هناك..في التلفاز ، إمرأة
Dialogue: 0,0:12:22.31,0:12:25.40,Default,,0,0,0,,لا يوجد شيء ؟
Dialogue: 0,0:12:26.98,0:12:28.57,Default,,0,0,0,,كيف ذلك ؟
Dialogue: 0,0:12:29.86,0:12:32.90,Default,,0,0,0,,ألم يأنك كابوس أثناء نومك ؟
Dialogue: 0,0:12:32.95,0:12:36.28,Default,,0,0,0,,بل حقيقة شاهدتها
Dialogue: 0,0:12:36.28,0:12:39.62,Default,,0,0,0,,تأخرنا
Dialogue: 0,0:12:39.62,0:12:43.04,Default,,0,0,0,,مازلت نائماً
Dialogue: 0,0:12:44.83,0:12:47.25,Default,,0,0,0,,سأذهب للحمام أولاً
Dialogue: 0,0:12:47.29,0:12:50.26,Default,,0,0,0,,أيقظ العجوز و أخبره أننا سنرحل
Dialogue: 0,0:12:53.59,0:12:57.10,Default,,0,0,0,,ياربي! أي أشباح هذه ؟ بالفعل مغفل
Dialogue: 0,0:12:57.18,0:13:00.81,Default,,0,0,0,,حسناً في النهاية لم يظهر شيء ، مضيعة للوقت ؟
Dialogue: 0,0:13:03.19,0:13:05.15,Default,,0,0,0,,ما هذا المرحاض ؟
Dialogue: 0,0:13:05.19,0:13:07.77,Default,,0,0,0,,أنه صدأ و وقذر!
Dialogue: 0,0:13:07.82,0:13:10.61,Default,,0,0,0,,وفراش العث
Dialogue: 0,0:13:10.65,0:13:11.53,Default,,0,0,0,,أوف
Dialogue: 0,0:13:11.57,0:13:15.57,Default,,0,0,0,,لو علمت بهذا لوافقت على الرجوع سريعا كما أرادت ران
Dialogue: 0,0:13:16.45,0:13:18.12,Default,,0,0,0,,أبتاه
Dialogue: 0,0:13:18.16,0:13:19.78,Default,,0,0,0,,تعال هنا
Dialogue: 0,0:13:19.83,0:13:22.50,Default,,0,0,0,,لم تقدر أن توقظ العجوز رغم محاولاتنا
Dialogue: 0,0:13:22.58,0:13:25.04,Default,,0,0,0,,لحظة ساني قريبا
Dialogue: 0,0:13:33.92,0:13:35.47,Default,,0,0,0,,ما الخطب ؟
Dialogue: 0,0:13:35.51,0:13:37.34,Default,,0,0,0,,دماء...
Dialogue: 0,0:13:37.35,0:13:40.14,Default,,0,0,0,,الماء في المرحاض تحول كليا "!
Dialogue: 0,0:13:40.18,0:13:41.68,Default,,0,0,0,,مستحيل
Dialogue: 0,0:13:41.72,0:13:43.14,Default,,0,0,0,,ماذا جرى ؟
Dialogue: 0,0:13:43.18,0:13:45.23,Default,,0,0,0,,ما هذه الجلبة التي تحدثوها
Dialogue: 0,0:13:45.27,0:13:47.27,Default,,0,0,0,,ماء المرحاض تحول لدماء قانية
Dialogue: 0,0:13:54.20,0:13:55.90,Default,,0,0,0,,حماقة!
Dialogue: 0,0:13:56.03,0:13:58.11,Default,,0,0,0,,لابد أنها ألاعيب أحدهم
Dialogue: 0,0:13:58.20,0:14:01.41,Default,,0,0,0,,لابد أنه لون أضيف إلى خزان المرحاض
Dialogue: 0,0:14:03.20,0:14:05.58,Default,,0,0,0,,لكن لا يوجد شيء
Dialogue: 0,0:14:08.50,0:14:10.63,Default,,0,0,0,,تكن الدماء موجودة قبل دخولك ؟
Dialogue: 0,0:14:12.63,0:14:15.67,Default,,0,0,0,,عندما ضغطت الشفاط تحولت المياه إلى دم
Dialogue: 0,0:14:18.05,0:14:21.93,Default,,0,0,0,,فجأة ظهر الشبح في التلفاز و نحن نيام
Dialogue: 0,0:14:21.97,0:14:24.22,Default,,0,0,0,,المياه أصبحت حمراء
Dialogue: 0,0:14:24.23,0:14:28.02,Default,,0,0,0,,بقي الطيف مخيف على النافذة
Dialogue: 0,0:14:28.98,0:14:31.31,Default,,0,0,0,,ها هو ذا
Dialogue: 0,0:14:32.61,0:14:33.86,Default,,0,0,0,,ماذا ؟
Dialogue: 0,0:14:48.33,0:14:50.21,Default,,0,0,0,,0 0
Dialogue: 0,0:14:50.75,0:14:51.08,Default,,0,0,0,,ما هذا الشي المخيف ؟
Dialogue: 0,0:14:54.30,0:14:57.22,Default,,0,0,0,,ومن يعرف ماذا بعد هذا ؟
Dialogue: 0,0:14:57.26,0:14:59.34,Default,,0,0,0,,هل ظهر الشبح فعلا ؟
Dialogue: 0,0:15:01.18,0:15:05.77,Default,,0,0,0,,شبح المرأة التي قتلت في الحديقة ؟
Dialogue: 0,0:15:09.90,0:15:12.02,Default,,0,0,0,,اختفى
Dialogue: 0,0:15:12.11,0:15:13.48,Default,,0,0,0,,بالتأكيد
Dialogue: 0,0:15:13.52,0:15:21.24,Default,,0,0,0,,ربما سكن الشبح هذا المسكن
Dialogue: 0,0:15:22.58,0:15:25.54,Default,,0,0,0,,ماذا أشباح ؟
Dialogue: 0,0:15:25.58,0:15:28.54,Default,,0,0,0,,أنا متأكد أن أحدهم قد دبر هذا على الشرفة
Dialogue: 0,0:15:28.58,0:15:30.67,Default,,0,0,0,,الوجه ظهر على نافذة الطابق الثاني
Dialogue: 0,0:15:30.71,0:15:33.17,Default,,0,0,0,,أبتعد دعني أتحقق
Dialogue: 0,0:15:33.84,0:15:35.80,Default,,0,0,0,,لكن لا يوجد
Dialogue: 0,0:15:42.47,0:15:44.76,Default,,0,0,0,,وحدها الأشباح تفعل هذا!
Dialogue: 0,0:15:44.81,0:15:48.35,Default,,0,0,0,,لا توجد شرفات نهائياً
Dialogue: 0,0:15:49.14,0:15:51.60,Default,,0,0,0,,الأمر كما قلت
Dialogue: 0,0:15:53.15,0:15:56.78,Default,,0,0,0,,إذا لم يكن قبلا مصطنعاً
Dialogue: 0,0:15:56.82,0:15:59.61,Default,,0,0,0,,إنه يضي بالنار
Dialogue: 0,0:15:59.65,0:16:04.03,Default,,0,0,0,,واختفى تدريجياً عند فتح النافذة
Dialogue: 0,0:16:04.16,0:16:04.99,Default,,0,0,0,,ماذا لو
Dialogue: 0,0:16:04.99,0:16:10.12,Default,,0,0,0,,الشبح يتلاشى مع ضوء الشمس
Dialogue: 0,0:16:11.50,0:16:12.96,Default,,0,0,0,,عماه
Dialogue: 0,0:16:13.00,0:16:16.34,Default,,0,0,0,,لقد رأيت هذا من قبل على النافذة
Dialogue: 0,0:16:16.34,0:16:18.84,Default,,0,0,0,,الشبح يختفي
Dialogue: 0,0:16:18.92,0:16:21.63,Default,,0,0,0,,و بريقه كذلك
Dialogue: 0,0:16:21.68,0:16:25.43,Default,,0,0,0,,أعتقد أنه شيح الفتاة المذبوحة
Dialogue: 0,0:16:25.47,0:16:30.31,Default,,0,0,0,,إنها ( ريو تابوجي ( التي أحرقت قبل أربع سنوات
Dialogue: 0,0:16:30.52,0:16:32.06,Default,,0,0,0,,اريو تابوجي )
Dialogue: 0,0:16:32.10,0:16:32.48,Default,,0,0,0,,وجدنا رخصة قيادة تحت جثمانها المحترق
Dialogue: 0,0:16:36.86,0:16:39.28,Default,,0,0,0,,by l a s an olin mo
Dialogue: 0,0:16:39.32,0:16:39.69,Default,,0,0,0,,الاثنان اللذان ذبحاها ولم يتم أمساكهما
Dialogue: 0,0:16:44.82,0:16:45.53,Default,,0,0,0,,لذا لن ترتاح روحها
Dialogue: 0,0:16:48.79,0:16:50.70,Default,,0,0,0,,رجلان قتلاها ؟
Dialogue: 0,0:16:50.71,0:16:53.21,Default,,0,0,0,,إذا لابد من وجود شهود
Dialogue: 0,0:17:03.38,0:17:07.60,Default,,0,0,0,,يمكنك أن تشاهد رسما لأحدهم من الثافية
Dialogue: 0,0:17:07.97,0:17:12.56,Default,,0,0,0,,ذلك الرجل في الملصق هو أحد القاتلين 事件
Dialogue: 0,0:17:13.35,0:17:18.40,Default,,0,0,0,,بتلك الندبة على وجهه يبدو مقرفا
Dialogue: 0,0:17:18.48,0:17:24.15,Default,,0,0,0,,القاتل الآخر كان في الظلام لذلك لم يتعرفوا عليه
Dialogue: 0,0:17:24.24,0:17:30.49,Default,,0,0,0,,لكن تلك الحادثة حدثت عندما كان العجوز وحده من يسكن هنا
Dialogue: 0,0:17:36.00,0:17:38.67,Default,,0,0,0,,هل ظهر مجددًا
Dialogue: 0,0:17:38.71,0:17:43.63,Default,,0,0,0,,فراش العث على ذراعك أب
Dialogue: 0,0:17:47.51,0:17:50.51,Default,,0,0,0,,العث مألوف في هذه النواحي لا
Dialogue: 0,0:17:50.60,0:17:53.22,Default,,0,0,0,,يأتينا من النافذة عادة
Dialogue: 0,0:17:53.31,0:17:57.60,Default,,0,0,0,,أنه يأتينا من ناحية الحديقة التي حدثت فيها الجريمة!
Dialogue: 0,0:17:57.65,0:18:02.28,Default,,0,0,0,,لذا فهو يطير قريبا من السكن
Dialogue: 0,0:18:02.32,0:18:03.32,Default,,0,0,0,,رباه
Dialogue: 0,0:18:03.36,0:18:06.49,Default,,0,0,0,,ليست أكثر من مجرد عث لم الجبلة ؟
Dialogue: 0,0:18:06.53,0:18:10.28,Default,,0,0,0,,لقد طبخت ( الأودن ) و أخاف أن أرجع إليه و قد تعفن
Dialogue: 0,0:18:10.33,0:18:10.74,Default,,0,0,0,,حقا
Dialogue: 0,0:18:11.54,0:18:14.08,Default,,0,0,0,,لقد أصبت با صاح
Dialogue: 0,0:18:15.08,0:18:19.04,Default,,0,0,0,,على أية حال لا تزعجوني بالجلية مرة أخرى
Dialogue: 0,0:18:19.09,0:18:21.29,Default,,0,0,0,,على كل الشبح على النافذة
Dialogue: 0,0:18:21.34,0:18:26.76,Default,,0,0,0,,كان إنعكاسا لأحدنا على النافذة كالمرآة
Dialogue: 0,0:18:26.80,0:18:28.18,Default,,0,0,0,,أخرق
Dialogue: 0,0:18:28.22,0:18:30.14,Default,,0,0,0,,أنا متأكد أنه الشيخ
Dialogue: 0,0:18:30.18,0:18:32.06,Default,,0,0,0,,lnb lab
Dialogue: 0,0:18:32.10,0:18:33.97,Default,,0,0,0,,لقد أخبرتكم
Dialogue: 0,0:18:33.97,0:18:37.23,Default,,0,0,0,,المجيء لهذا المكان مجلية للمشاكل
Dialogue: 0,0:18:37.27,0:18:40.40,Default,,0,0,0,,هيا أبتاه لترحل
Dialogue: 0,0:18:41.57,0:18:44.57,Default,,0,0,0,,أسرع كونان ، سنرحل
Dialogue: 0,0:18:46.86,0:18:49.74,Default,,0,0,0,,ما الذي تفعله كونان ؟
Dialogue: 0,0:18:49.78,0:18:55.37,Default,,0,0,0,,عماه ، هل تحولت المياه إلى دماء حقاً ؟
Dialogue: 0,0:18:55.45,0:18:56.71,Default,,0,0,0,,أجل
Dialogue: 0,0:18:56.79,0:19:01.21,Default,,0,0,0,,لست واثقا أنها دماء لكن الماء تحول إلى اللون الأحمر
Dialogue: 0,0:19:01.71,0:19:08.34,Default,,0,0,0,,و أنت تقدر أن تشم الرائحة من المدخل
Dialogue: 0,0:19:11.18,0:19:12.55,Default,,0,0,0,,غریب
Dialogue: 0,0:19:12.60,0:19:16.52,Default,,0,0,0,,لقد تلاشت الرائحة التي كانت منتشرة
Dialogue: 0,0:19:16.52,0:19:18.64,Default,,0,0,0,,المكان كان مغلقا
Dialogue: 0,0:19:18.69,0:19:20.85,Default,,0,0,0,,و الباب للتو تم فتحه
Dialogue: 0,0:19:20.90,0:19:22.94,Default,,0,0,0,,محتمل
Dialogue: 0,0:19:26.90,0:19:30.07,Default,,0,0,0,,ما هذه الرائحة.. كحول ؟
Dialogue: 0,0:19:31.87,0:19:32.66,Default,,0,0,0,,( 66 ୬୭ ଖ୍ରୀ ||
Dialogue: 0,0:19:32.70,0:19:37.66,Default,,0,0,0,,أريد أن أقوم بالتحري و أخبر زملائي بالأمر
Dialogue: 0,0:19:37.71,0:19:43.08,Default,,0,0,0,,سأخبرهم بأن المتحري الشهير [ كوغورو! موري ] خاف الأشباح وهرب
Dialogue: 0,0:19:43.13,0:19:43.42,Default,,0,0,0,,ماذا ؟
Dialogue: 0,0:19:45.63,0:19:46.71,Default,,0,0,0,,ران
Dialogue: 0,0:19:46.71,0:19:48.09,Default,,0,0,0,,لن نعود الآن
Dialogue: 0,0:19:48.84,0:19:50.55,Default,,0,0,0,,لماذا ؟
Dialogue: 0,0:19:50.59,0:19:53.68,Default,,0,0,0,,من المستحيل أن أصدق بوجود الأشباح
Dialogue: 0,0:19:57.81,0:20:00.27,Default,,0,0,0,,أوهام..لابد أنها أوهام
Dialogue: 0,0:20:00.31,0:20:03.90,Default,,0,0,0,,الشيح على النافذة لابد أنه أنعكاس لأحدهم
Dialogue: 0,0:20:03.98,0:20:07.90,Default,,0,0,0,,الدم عبارة عن لون أضيف إلى ماء الشفاط
Dialogue: 0,0:20:07.99,0:20:12.61,Default,,0,0,0,,عندما تتأثر بالقصة لا تقرأ المعطيات جيدا
Dialogue: 0,0:20:12.66,0:20:16.41,Default,,0,0,0,,ما قولك في المرأة التي شاهدتها كذلك ؟
Dialogue: 0,0:20:16.45,0:20:19.83,Default,,0,0,0,,لقد ظهرت حقا على شاشة التلفاز
Dialogue: 0,0:20:19.87,0:20:25.00,Default,,0,0,0,,و المرأة المحترقة كانت تقول ( أخرجوا.. أخرجوا )
Dialogue: 0,0:20:27.09,0:20:33.55,Default,,0,0,0,,حسب جدول البرامة أمامي ، التلفاز لا يعرض برامج رعب في ذلك الوقت
Dialogue: 0,0:20:35.47,0:20:35.76,Default,,0,0,0,,والسؤال الأبرة
Dialogue: 0,0:20:39.06,0:20:42.14,Default,,0,0,0,,هل القاطنين في السكن
Dialogue: 0,0:20:42.19,0:20:46.15,Default,,0,0,0,,هم من فبرك قصة المرأة في التلفاز عبر الفيديو ؟
Dialogue: 0,0:20:46.19,0:20:47.86,Default,,0,0,0,,هل تقصدني ؟
Dialogue: 0,0:20:48.48,0:20:52.11,Default,,0,0,0,,غير صحيح ، لقد تفحصت الفيديو -
Dialogue: 0,0:20:52.15,0:20:55.66,Default,,0,0,0,,ولم يكن في قلب الجهاز شريط
Dialogue: 0,0:20:55.70,0:20:57.95,Default,,0,0,0,,لكني لا أفهم جل الأمر!
Dialogue: 0,0:20:57.99,0:21:02.50,Default,,0,0,0,,الجميع غط في النوم في وقت واحد
Dialogue: 0,0:21:02.54,0:21:04.29,Default,,0,0,0,,بالطبع أنها لعنة
Dialogue: 0,0:21:04.33,0:21:05.58,Default,,0,0,0,,حمقاء
Dialogue: 0,0:21:05.63,0:21:07.59,Default,,0,0,0,,مستحيل
Dialogue: 0,0:21:10.30,0:21:13.76,Default,,0,0,0,,أي شخص يحاول التسلل إلى هنا سيسقط حتماً
Dialogue: 0,0:21:14.18,0:21:17.76,Default,,0,0,0,,أعلى قسم في السكن هو هذا الطابق
Dialogue: 0,0:21:17.81,0:21:20.52,Default,,0,0,0,,و هو يواجه البناء غير المكتمل
Dialogue: 0,0:21:21.56,0:21:25.40,Default,,0,0,0,,كونان لماذا فتحت النافذة ؟
Dialogue: 0,0:21:25.44,0:21:27.81,Default,,0,0,0,,العث سيدخل إلينا
Dialogue: 0,0:21:28.61,0:21:34.70,Default,,0,0,0,,كنت أتساءل في أي جهة رأى الجد النار في ذلك المبنى
Dialogue: 0,0:21:34.74,0:21:39.78,Default,,0,0,0,,رأيتها في وسط الجهة المقابلة للسكن حيث الظلمة
Dialogue: 0,0:21:39.83,0:21:44.12,Default,,0,0,0,,كانت بقعة ضوء حمراء بعيدة خافتة
Dialogue: 0,0:21:44.17,0:21:49.00,Default,,0,0,0,,و أحيانا يكون الضوء خافتا بلون أزرق
Dialogue: 0,0:21:50.55,0:21:53.05,Default,,0,0,0,,من وراء هذا ؟
Dialogue: 0,0:21:55.18,0:21:59.30,Default,,0,0,0,,الصورة التي ظهرت على الشاشة و نحن نيام
Dialogue: 0,0:21:59.35,0:21:59.76,Default,,0,0,0,,و الماء الأحمر في المرحاض
