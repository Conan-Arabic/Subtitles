Dialogue: 0,0:00:20.64,0:00:22.54,Default,,0,0,0,,‫قلبٌ قويّ، مع الاستنتاج والقوة.
Dialogue: 0,0:00:22.54,0:00:24.54,Default,,0,0,0,,‫والولوجُ إلى الجوهر بإيقاعٍ قوي.
Dialogue: 0,0:00:24.54,0:00:26.24,Default,,0,0,0,,‫مبنىً منفصلٌ غامضٌ عند البركة الأسطورية.
Dialogue: 0,0:00:26.24,0:00:28.14,Default,,0,0,0,,‫تدورُ الطاحونةُ ويتبدّل لونُ الماء.
Dialogue: 0,0:00:28.14,0:00:29.64,Default,,0,0,0,,‫إنه يرى الحقيقةَ الوحيدة.
Dialogue: 0,0:00:29.64,0:00:31.44,Default,,0,0,0,,‫طفلٌ في المظهر، بذكاء رجلٍ بالغ.
Dialogue: 0,0:00:31.44,0:00:33.84,Default,,0,0,0,,‫اسمه المحقّق كونان!
Dialogue: 0,0:01:59.09,0:02:01.79,Default,,0,0,0,,‫السيد موري؟ أتقصد ذلك المحقّق الشهير؟
Dialogue: 0,0:02:01.79,0:02:03.79,Default,,0,0,0,,‫نعم، في الواقع...
Dialogue: 0,0:02:03.79,0:02:06.59,Default,,0,0,0,,‫وصلني إشعارٌ من السيد شيرو سوزوكي، من مجموعة سوزوكي المالية،
Dialogue: 0,0:02:06.59,0:02:09.49,Default,,0,0,0,,‫بأن شخصًا آخر سيحضر بدلًا منه،
Dialogue: 0,0:02:09.49,0:02:11.49,Default,,0,0,0,,‫لكنني لم أتخيّل أن يكون ذلك أنت.
Dialogue: 0,0:02:11.49,0:02:13.89,Default,,0,0,0,,‫لا تكن قاسيًا عليّ، رجاءً.
Dialogue: 0,0:02:17.89,0:02:20.19,Default,,0,0,0,,‫كما هو متوقَّعٌ من سيّدٍ في فنّ الشاي.
Dialogue: 0,0:02:20.19,0:02:22.49,Default,,0,0,0,,‫يا له من منزلٍ رائع!
Dialogue: 0,0:02:23.39,0:02:27.19,Default,,0,0,0,,‫حفلُ شاي… ما أثقله.
Dialogue: 0,0:02:27.19,0:02:30.49,Default,,0,0,0,,‫لا أدري لماذا جئتُ معهم.
Dialogue: 0,0:02:30.49,0:02:32.79,Default,,0,0,0,,‫كونان، هيا بنا.
Dialogue: 0,0:02:32.79,0:02:34.39,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:02:36.59,0:02:38.69,Default,,0,0,0,,‫لا بدّ أن أتمّه على أيّ حال.
Dialogue: 0,0:02:39.99,0:02:45.99,Default,,0,0,0,,‫"أسطورةُ قصرِ المياهِ الخمسِ الألوان (الجزء الأوّل)"
Dialogue: 0,0:02:48.09,0:02:51.89,Default,,0,0,0,,‫ما أجمله! مدهش!
Dialogue: 0,0:02:51.89,0:02:54.59,Default,,0,0,0,,‫يا له من منظرٍ طبيعيٍّ بديع!
Dialogue: 0,0:02:54.59,0:02:58.09,Default,,0,0,0,,‫ويا للعجب… إنه يتوهّج بلونٍ ذهبي.
Dialogue: 0,0:02:58.09,0:02:59.39,Default,,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:02:59.39,0:03:01.79,Default,,0,0,0,,‫أهذه أوّل مرة ترى فيها بركةً؟
Dialogue: 0,0:03:01.79,0:03:05.39,Default,,0,0,0,,‫في مثل هذا الوقت من السنة، وبحسب زاوية الشمس،
Dialogue: 0,0:03:05.39,0:03:08.09,Default,,0,0,0,,‫يتبدّل سطحُ الماء إلى خمسة ألوانٍ مختلفة.
Dialogue: 0,0:03:08.09,0:03:09.39,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:03:09.39,0:03:11.69,Default,,0,0,0,,‫لهذا إذن يُسمّى منزلكم
Dialogue: 0,0:03:11.69,0:03:15.09,Default,,0,0,0,,‫"قصرَ المياهِ الخمسِ الألوان".
Dialogue: 0,0:03:15.09,0:03:16.19,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:03:16.19,0:03:18.09,Default,,0,0,0,,‫وبالمناسبة، هل لي أن أعرف أسماءكم؟
Dialogue: 0,0:03:18.09,0:03:20.19,Default,,0,0,0,,‫يا لسوء أدبي.
Dialogue: 0,0:03:20.19,0:03:21.89,Default,,0,0,0,,‫هؤلاء من تلاميذ السيّد.
Dialogue: 0,0:03:21.89,0:03:24.79,Default,,0,0,0,,‫"موريو ياكورا (42)" — هذا السيد ياكورا، تاجرُ تحفٍ.
Dialogue: 0,0:03:24.79,0:03:27.89,Default,,0,0,0,,‫"يوكاري ميمورا (33)" — وهذه مالكةُ شركة، السيدة ميمورا.
Dialogue: 0,0:03:27.89,0:03:29.99,Default,,0,0,0,,‫تشرفنا.
Dialogue: 0,0:03:29.99,0:03:33.59,Default,,0,0,0,,‫وهذا المحقّق الشهير السيد كوغورو موري وعائلته.
Dialogue: 0,0:03:34.79,0:03:36.29,Default,,0,0,0,,‫أتقصد ذلك المحقّق المعروف؟
Dialogue: 0,0:03:36.29,0:03:38.09,Default,,0,0,0,,‫يا لشرفٍ عظيم.
Dialogue: 0,0:03:38.09,0:03:40.29,Default,,0,0,0,,‫"يوشيكو هاناساكي (40)" — ما دمتم جميعًا هنا،
Dialogue: 0,0:03:40.29,0:03:42.89,Default,,0,0,0,,‫فسأذهب لأُبلغ السيّد.
Dialogue: 0,0:03:46.79,0:03:48.89,Default,,0,0,0,,‫السيّد؟
Dialogue: 0,0:03:48.89,0:03:51.09,Default,,0,0,0,,‫سيّدُ مراسم الشاي.
Dialogue: 0,0:03:52.79,0:03:54.59,Default,,0,0,0,,‫هذا مثيرٌ للاهتمام.
Dialogue: 0,0:03:54.59,0:03:56.79,Default,,0,0,0,,‫ترى أيّ استقبالٍ
Dialogue: 0,0:03:56.79,0:04:00.99,Default,,0,0,0,,‫سيوجّهه ذلك السيّد المتشدّد إلى "المحقّق الشهير"؟
Dialogue: 0,0:04:00.99,0:04:04.79,Default,,0,0,0,,‫ولهذا لم أرد أن آتي بدلًا منه.
Dialogue: 0,0:04:04.79,0:04:08.19,Default,,0,0,0,,‫أعتذر، لكن سونوكو ألحّت عليّ.
Dialogue: 0,0:04:11.69,0:04:14.99,Default,,0,0,0,,‫هاه؟ إنها الخادمة.
Dialogue: 0,0:04:14.99,0:04:19.79,Default,,0,0,0,,‫وهذا يعني أن السيّد هناك.
Dialogue: 0,0:04:20.79,0:04:24.79,Default,,0,0,0,,‫أذلك المبنى في وسط البركة هو غرفة الشاي؟
Dialogue: 0,0:04:24.79,0:04:27.79,Default,,0,0,0,,‫هاه؟ أجل، أظن ذلك.
Dialogue: 0,0:04:27.79,0:04:29.39,Default,,0,0,0,,‫إنّ هذا الجوّ المهيب رائعٌ حقًا!
Dialogue: 0,0:04:29.39,0:04:32.29,Default,,0,0,0,,‫إنه بحقّ عالمُ "وابي-سابي"!
Dialogue: 0,0:04:32.29,0:04:33.89,Default,,0,0,0,,‫أنا واثقٌ أنها غرفة الشاي!
Dialogue: 0,0:04:33.89,0:04:36.39,Default,,0,0,0,,‫نعم، هذا صحيح.
Dialogue: 0,0:04:36.39,0:04:39.29,Default,,0,0,0,,‫وتُسمّى "المعتكفَ الخماسيَّ الألوان"
Dialogue: 0,0:04:39.29,0:04:41.79,Default,,0,0,0,,‫لأنها مبنيةٌ فوق البركة التي يتبدّل لونُها.
Dialogue: 0,0:04:41.79,0:04:43.99,Default,,0,0,0,,‫وقد بُنيت للابتعاد عن شواغل الدنيا
Dialogue: 0,0:04:43.99,0:04:45.49,Default,,0,0,0,,‫وكذلك لنسيان الزمن.
Dialogue: 0,0:04:45.49,0:04:47.49,Default,,0,0,0,,‫"المعتكف الخماسي الألوان"؟
Dialogue: 0,0:04:47.49,0:04:49.69,Default,,0,0,0,,‫يا لها من غرفة شاي رائعة.
Dialogue: 0,0:04:49.69,0:04:51.39,Default,,0,0,0,,‫مرحبًا يا ريوئيتشي.
Dialogue: 0,0:04:51.39,0:04:54.09,Default,,0,0,0,,‫إنه ابنُ السيّد.
Dialogue: 0,0:04:54.09,0:04:55.79,Default,,0,0,0,,‫"ريوئيتشي آونوغي (28)" — السيد موري.
Dialogue: 0,0:04:55.79,0:04:57.19,Default,,0,0,0,,‫شكرًا لقدومك من هذا البعيد.
Dialogue: 0,0:04:57.19,0:04:59.59,Default,,0,0,0,,‫أوه، هل سمعتم عنه مسبقًا؟
Dialogue: 0,0:04:59.59,0:05:01.39,Default,,0,0,0,,‫وبما أنك هنا،
Dialogue: 0,0:05:01.39,0:05:04.29,Default,,0,0,0,,‫لماذا لا تذكر له حكاية الوحش أيضًا؟
Dialogue: 0,0:05:04.29,0:05:07.49,Default,,0,0,0,,‫وحش؟ وما قصته؟
Dialogue: 0,0:05:07.49,0:05:11.69,Default,,0,0,0,,‫حسنًا… إنها خرافةٌ تتعلّق بهذه البركة.
Dialogue: 0,0:05:11.69,0:05:14.69,Default,,0,0,0,,‫لا، دعونا لا نتحدث عنها.
Dialogue: 0,0:05:14.69,0:05:17.69,Default,,0,0,0,,‫جئتُ لأُسلّم فقط، فاسمحوا لي بالانصراف.
Dialogue: 0,0:05:22.29,0:05:23.49,Default,,0,0,0,,‫يا للهول.
Dialogue: 0,0:05:23.49,0:05:27.69,Default,,0,0,0,,‫سيدة ميمورا، أظنّكِ ضايقتِ ريوئيتشي.
Dialogue: 0,0:05:27.69,0:05:29.89,Default,,0,0,0,,‫حسنًا، دعوني أحكي لكم الأمر
Dialogue: 0,0:05:29.89,0:05:31.99,Default,,0,0,0,,‫هناك مع ماءٍ ساخنٍ صِرف.
Dialogue: 0,0:05:34.19,0:05:37.99,Default,,0,0,0,,‫يُقال إن ذلك كان في أواخر عصر إيدو.
Dialogue: 0,0:05:37.99,0:05:42.29,Default,,0,0,0,,‫كانت هذه البركة ممتلئة بماءٍ نابعٍ باردٍ صافٍ،
Dialogue: 0,0:05:42.29,0:05:44.79,Default,,0,0,0,,‫وكانت أكبر بكثير مما هي عليه الآن.
Dialogue: 0,0:05:47.69,0:05:52.19,Default,,0,0,0,,‫وذاتَ يومٍ ظهرت قرب البركة امرأةٌ جميلة.
Dialogue: 0,0:05:52.19,0:05:55.19,Default,,0,0,0,,‫كانت تعزف الناي فتغيّر لونَ البركة،
Dialogue: 0,0:05:55.19,0:05:58.19,Default,,0,0,0,,‫ممتّعةً كلَّ من يأتي لرؤيتها.
Dialogue: 0,0:05:59.89,0:06:04.59,Default,,0,0,0,,‫وفي يومٍ ما، هام بها تاجرٌ ثريّ.
Dialogue: 0,0:06:04.59,0:06:07.89,Default,,0,0,0,,‫فبنى منزلًا قرب البركة.
Dialogue: 0,0:06:07.89,0:06:11.29,Default,,0,0,0,,‫وقبلت المرأة الزواج منه بشرطٍ واحد.
Dialogue: 0,0:06:11.29,0:06:16.49,Default,,0,0,0,,‫قالت: "البركة لي، ولا يجوز لأحدٍ أن يطأها".
Dialogue: 0,0:06:16.49,0:06:19.09,Default,,0,0,0,,‫لكن التاجرَ ينقض هذا الوعد،
Dialogue: 0,0:06:19.09,0:06:22.29,Default,,0,0,0,,‫ويبني غرفةَ النوم في وسط البركة.
Dialogue: 0,0:06:22.29,0:06:24.29,Default,,0,0,0,,‫ثم لا يكتفي بأن يغضب من زوجته
Dialogue: 0,0:06:24.29,0:06:27.89,Default,,0,0,0,,‫التي تعلّقت به وتوسّلت إليه أن ينقل غرفة النوم،
Dialogue: 0,0:06:27.89,0:06:29.59,Default,,0,0,0,,‫بل يقتلها...
Dialogue: 0,0:06:31.89,0:06:33.89,Default,,0,0,0,,‫ويُغرق جثمانها في البركة.
Dialogue: 0,0:06:35.29,0:06:38.89,Default,,0,0,0,,‫غير أنّ أفعى ضخمة ظهرت ذات ليلةٍ من البركة،
Dialogue: 0,0:06:38.89,0:06:41.39,Default,,0,0,0,,‫وهاجمت التاجر.
Dialogue: 0,0:06:43.49,0:06:46.19,Default,,0,0,0,,‫واتّضح أن الأفعى هي المرأة نفسها.
Dialogue: 0,0:06:46.19,0:06:48.69,Default,,0,0,0,,‫لقد تحوّلت إلى وحشٍ يسكن البركة.
Dialogue: 0,0:06:48.69,0:06:51.49,Default,,0,0,0,,‫ورغم أن التاجر أُصيب إصاباتٍ بالغة،
Dialogue: 0,0:06:51.49,0:06:54.89,Default,,0,0,0,,‫فإنه عاد بطريقةٍ ما إلى غرفة النوم.
Dialogue: 0,0:06:54.89,0:06:56.69,Default,,0,0,0,,‫ولأن في الغرفة تعويذةً لطرد الأرواح الشريرة
Dialogue: 0,0:06:56.69,0:06:57.89,Default,,0,0,0,,‫كانت معلّقةً فيها،
Dialogue: 0,0:06:57.89,0:07:00.79,Default,,0,0,0,,‫لم يعد في خطر التعرض للهجوم.
Dialogue: 0,0:07:01.99,0:07:04.39,Default,,0,0,0,,‫لكن الوحش ظلّ ينتظر ليلًا ونهارًا
Dialogue: 0,0:07:04.39,0:07:07.19,Default,,0,0,0,,‫خروجَ التاجر.
Dialogue: 0,0:07:08.59,0:07:11.39,Default,,0,0,0,,‫ونهك التاجر حتى تجاوز طاقته،
Dialogue: 0,0:07:11.39,0:07:15.09,Default,,0,0,0,,‫ويُقال إنه شنقَ نفسه داخل ذلك المبنى.
Dialogue: 0,0:07:19.59,0:07:21.99,Default,,0,0,0,,‫ولا يزال يُقال حتى اليوم إن البركة تغيّر لونها
Dialogue: 0,0:07:21.99,0:07:25.39,Default,,0,0,0,,‫لأن الوحش يتخذ هيئة المرأة
Dialogue: 0,0:07:25.39,0:07:29.09,Default,,0,0,0,,‫ويظهر نافخًا في الناي.
Dialogue: 0,0:07:29.09,0:07:32.39,Default,,0,0,0,,‫لم أتخيل أن للبركة حكايةً كهذه...
Dialogue: 0,0:07:32.39,0:07:34.39,Default,,0,0,0,,‫أيها الجميع!
Dialogue: 0,0:07:34.39,0:07:36.19,Default,,0,0,0,,‫شكرًا جزيلًا لانتظاركم.
Dialogue: 0,0:07:36.19,0:07:38.39,Default,,0,0,0,,‫تفضّلوا واتبعوني إلى غرفة الشاي.
Dialogue: 0,0:07:42.39,0:07:45.89,Default,,0,0,0,,‫هاه؟ ألن ينضم ريوئيتشي إلينا؟
Dialogue: 0,0:07:46.89,0:07:49.89,Default,,0,0,0,,‫مع أنه ابنُ سيّد مراسم الشاي،
Dialogue: 0,0:07:49.89,0:07:51.79,Default,,0,0,0,,‫فهو لا يهتمّ بهذا الأمر إطلاقًا.
Dialogue: 0,0:07:51.79,0:07:54.59,Default,,0,0,0,,‫آه، هذه مشكلة حقًا.
Dialogue: 0,0:07:54.59,0:07:59.39,Default,,0,0,0,,‫على أيّ حال، لم أقدّم تحيتي للسيّد بعد.
Dialogue: 0,0:07:59.39,0:08:03.09,Default,,0,0,0,,‫أرجو المعذرة على قلة الأدب.
Dialogue: 0,0:08:03.09,0:08:07.49,Default,,0,0,0,,‫نادرًا ما يخرج السيّد مؤخرًا.
Dialogue: 0,0:08:07.49,0:08:12.49,Default,,0,0,0,,‫وهو لا يعبر هذا الجسر وحده على وجه الخصوص.
Dialogue: 0,0:08:19.39,0:08:23.09,Default,,0,0,0,,‫سيّدي، لقد أحضرتُ الضيوف.
Dialogue: 0,0:08:24.39,0:08:26.39,Default,,0,0,0,,‫سيّدي؟
Dialogue: 0,0:08:26.39,0:08:29.29,Default,,0,0,0,,‫لعلّ الوحشَ قد التهمه؟
Dialogue: 0,0:08:34.19,0:08:35.69,Default,,0,0,0,,‫ما الذي تفعلونه؟
Dialogue: 0,0:08:35.69,0:08:37.29,Default,,0,0,0,,‫وحشٌ!
Dialogue: 0,0:08:39.99,0:08:43.79,Default,,0,0,0,,‫يا لسوء أدبكم… تنظرون إلى الداخل هكذا!
Dialogue: 0,0:08:43.79,0:08:46.69,Default,,0,0,0,,‫هذه غرفةُ شايٍ مقدّسة، أفهمتم؟
Dialogue: 0,0:08:46.69,0:08:50.89,Default,,0,0,0,,‫اخرجوا! اخرجوا من غرفة الشاي هذه حالًا!
Dialogue: 0,0:08:50.89,0:08:53.59,Default,,0,0,0,,‫سيّدي، أرجوك اهدأ.
Dialogue: 0,0:08:53.59,0:08:56.19,Default,,0,0,0,,‫إنه ضيفُنا اليوم… السيد موري!
Dialogue: 0,0:08:56.19,0:08:58.29,Default,,0,0,0,,‫ماذا؟ ضيف؟
Dialogue: 0,0:08:58.29,0:09:01.29,Default,,0,0,0,,‫أتقصد ذلك الشخص الذي جاء نيابةً عن...
Dialogue: 0,0:09:01.29,0:09:03.79,Default,,0,0,0,,‫يا للعجب.
Dialogue: 0,0:09:03.79,0:09:06.49,Default,,0,0,0,,‫هاه؟ طاحونةُ هواءٍ في مكانٍ كهذا؟
Dialogue: 0,0:09:06.49,0:09:09.09,Default,,0,0,0,,‫عفوًا، أهذه الطاحونة للزينة فقط؟
Dialogue: 0,0:09:09.09,0:09:12.19,Default,,0,0,0,,‫تُستخدم لضخّ الماء إلى نهر الحديقة.
Dialogue: 0,0:09:12.19,0:09:14.09,Default,,0,0,0,,‫سمعتُ أنها تعمل كهربائيًا الآن.
Dialogue: 0,0:09:14.09,0:09:17.19,Default,,0,0,0,,‫يُضبط لها مؤقّت فتتحرك وفقه.
Dialogue: 0,0:09:17.19,0:09:20.09,Default,,0,0,0,,‫وكان ماءُ هذه البركة مشهورًا لاستعماله في الشاي.
Dialogue: 0,0:09:20.09,0:09:21.69,Default,,0,0,0,,‫لكن منذ بُنيت غرفة الشاي هذه،
Dialogue: 0,0:09:21.69,0:09:24.39,Default,,0,0,0,,‫انخفض مقدار الماء انخفاضًا شديدًا.
Dialogue: 0,0:09:24.39,0:09:27.09,Default,,0,0,0,,‫سيدة ميمورا، سيّدي سيسمعكِ.
Dialogue: 0,0:09:32.69,0:09:34.99,Default,,0,0,0,,‫أعتذر عن وقاحتي قبل قليل،
Dialogue: 0,0:09:34.99,0:09:37.69,Default,,0,0,0,,‫رغم أنك قطعتَ كل هذه المسافة.
Dialogue: 0,0:09:37.69,0:09:42.39,Default,,0,0,0,,‫شكرًا لتفضّلك بقضاء وقتك معي اليوم.
Dialogue: 0,0:09:42.39,0:09:45.49,Default,,0,0,0,,‫نشكركم على دعوتكم لنا.
Dialogue: 0,0:09:50.49,0:09:52.69,Default,,0,0,0,,‫تعويذاتٌ لطرد الأرواح الشريرة...
Dialogue: 0,0:09:54.69,0:09:57.19,Default,,0,0,0,,‫إنها معلّقة في كل مكان.
Dialogue: 0,0:09:57.19,0:10:00.29,Default,,0,0,0,,‫أهو خائفٌ من وحش البركة فعلًا؟
Dialogue: 0,0:10:00.29,0:10:05.09,Default,,0,0,0,,‫سيّدي، هل اطّلعتَ على القطعة التي طلبتُ من السيدة هاناساكي
Dialogue: 0,0:10:05.09,0:10:07.79,Default,,0,0,0,,‫أن تسلّمها لك قبل قليل؟
Dialogue: 0,0:10:07.79,0:10:08.89,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:10:08.89,0:10:10.19,Default,,0,0,0,,‫إنها قطعةٌ توارثتها الأجيال،
Dialogue: 0,0:10:10.19,0:10:13.89,Default,,0,0,0,,‫وقد أهداها إليّ خزّافٌ عظيم من كيوشو.
Dialogue: 0,0:10:13.89,0:10:15.89,Default,,0,0,0,,‫"ريوزو آونوغي (65)" — يدهشني أنك حصلتَ عليها.
Dialogue: 0,0:10:15.89,0:10:17.89,Default,,0,0,0,,‫مع أن ذلك متوقَّعٌ
Dialogue: 0,0:10:17.89,0:10:20.09,Default,,0,0,0,,‫ممن يدير تجارةً كبيرة في التحف.
Dialogue: 0,0:10:20.09,0:10:21.89,Default,,0,0,0,,‫سأستخدمُ وعاءَ الشاي ذاك
Dialogue: 0,0:10:21.89,0:10:25.09,Default,,0,0,0,,‫في مراسم الشاي التي ستقام مساء اليوم.
Dialogue: 0,0:10:25.09,0:10:27.29,Default,,0,0,0,,‫شكرًا جزيلًا لكم.
Dialogue: 0,0:10:30.79,0:10:33.49,Default,,0,0,0,,‫يبدو أن ذلك الوعاء مناسبٌ جدًا.
Dialogue: 0,0:10:33.49,0:10:36.59,Default,,0,0,0,,‫سيضفي بريقًا على ممارستي الأخيرة لمراسم الشاي.
Dialogue: 0,0:10:36.59,0:10:38.99,Default,,0,0,0,,‫ماذا تقصد بـ"الأخيرة"؟
Dialogue: 0,0:10:40.29,0:10:42.59,Default,,0,0,0,,‫سيد موري، لدينا اليوم سمكٌ رائع
Dialogue: 0,0:10:42.59,0:10:45.19,Default,,0,0,0,,‫يلائم شرب الساكي،
Dialogue: 0,0:10:45.19,0:10:48.29,Default,,0,0,0,,‫ونودّ أن تتذوّقه.
Dialogue: 0,0:10:48.29,0:10:49.89,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:10:49.89,0:10:52.79,Default,,0,0,0,,‫سيدة هاناساكي، هل تُسخّنين الساكي لنا؟
Dialogue: 0,0:10:52.79,0:10:54.29,Default,,0,0,0,,‫-سيّدي! -سيّدي!
Dialogue: 0,0:10:54.29,0:10:56.89,Default,,0,0,0,,‫سيّدي...
Dialogue: 0,0:10:56.89,0:10:59.09,Default,,0,0,0,,‫مراسم الشاي الأخيرة؟
Dialogue: 0,0:10:59.09,0:11:00.59,Default,,0,0,0,,‫ما الذي يعنيه بذلك؟
Dialogue: 0,0:11:14.19,0:11:16.29,Default,,0,0,0,,‫قدماي مخدَّرتان!
Dialogue: 0,0:11:16.29,0:11:18.99,Default,,0,0,0,,‫أبي، ما هذا الإحراج!
Dialogue: 0,0:11:18.99,0:11:21.59,Default,,0,0,0,,‫سأستعدّ لليلة،
Dialogue: 0,0:11:21.59,0:11:24.39,Default,,0,0,0,,‫فلا تدعوا أحدًا يقترب من غرفة الشاي.
Dialogue: 0,0:11:24.39,0:11:26.39,Default,,0,0,0,,‫نعم، سيّدي.
Dialogue: 0,0:11:37.99,0:11:40.19,Default,,0,0,0,,‫إلى أين تذهبين يا سيدة ميمورا؟
Dialogue: 0,0:11:40.19,0:11:42.79,Default,,0,0,0,,‫لديّ التزامٌ آخر.
Dialogue: 0,0:11:42.79,0:11:44.19,Default,,0,0,0,,‫وما الذي تقصدينه؟
Dialogue: 0,0:11:45.19,0:11:46.79,Default,,0,0,0,,‫سأعود حالًا!
Dialogue: 0,0:11:48.29,0:11:49.99,Default,,0,0,0,,‫ما أشدَّ أنانيتها!
Dialogue: 0,0:11:49.99,0:11:53.09,Default,,0,0,0,,‫لقد دعانا السيّد بنفسه، ومع ذلك...
Dialogue: 0,0:11:54.09,0:11:57.59,Default,,0,0,0,,‫السيد ياكورا، لقد جُهّز الحمّام.
Dialogue: 0,0:11:57.59,0:11:59.69,Default,,0,0,0,,‫شكرًا جزيلًا.
Dialogue: 0,0:12:03.39,0:12:05.79,Default,,0,0,0,,‫لقد تغيّر لونُ ماء البركة!
Dialogue: 0,0:12:05.79,0:12:07.99,Default,,0,0,0,,‫اختفى انعكاس الضوء،
Dialogue: 0,0:12:07.99,0:12:11.19,Default,,0,0,0,,‫وبات يمكن رؤيةُ داخل البركة، لذلك يبدو أخضر.
Dialogue: 0,0:12:11.19,0:12:14.79,Default,,0,0,0,,‫ثم سيتحوّل إلى القرمزي عندما تميل الشمس بزاويتها.
Dialogue: 0,0:12:17.59,0:12:21.29,Default,,0,0,0,,‫سيدة هاناساكي، ما الذي حدث لهذه القصبة؟
Dialogue: 0,0:12:21.29,0:12:23.59,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:12:23.59,0:12:27.29,Default,,0,0,0,,‫أمرني السيّد بإحراقها.
Dialogue: 0,0:12:27.29,0:12:29.79,Default,,0,0,0,,‫كنتُ أظن ذلك.
Dialogue: 0,0:12:30.79,0:12:32.99,Default,,0,0,0,,‫كلا يا سيد ريوئيتشي!
Dialogue: 0,0:12:32.99,0:12:34.29,Default,,0,0,0,,‫ريوئيتشي!
Dialogue: 0,0:12:34.29,0:12:36.09,Default,,0,0,0,,‫لدينا ضيوفٌ الليلة،
Dialogue: 0,0:12:36.09,0:12:39.59,Default,,0,0,0,,‫لذا أنصحك أن تنتظر حتى تنتهي مراسم الشاي.
Dialogue: 0,0:12:39.59,0:12:43.09,Default,,0,0,0,,‫أعلم، سأضع قصبة الصيد جانبًا فحسب.
Dialogue: 0,0:12:44.39,0:12:47.79,Default,,0,0,0,,‫الصيد هو هواية ريوئيتشي الوحيدة.
Dialogue: 0,0:12:47.79,0:12:51.79,Default,,0,0,0,,‫يا له من تصرّفٍ قاسٍ من السيّد.
Dialogue: 0,0:12:51.79,0:12:54.19,Default,,0,0,0,,‫لكن أن يندفع فجأةً في نوبة غضب،
Dialogue: 0,0:12:54.19,0:12:55.99,Default,,0,0,0,,‫ويُحرق أدوات الصيد بلا مقدّمات؟
Dialogue: 0,0:12:55.99,0:12:58.59,Default,,0,0,0,,‫لا أدري إن كان يمكن تسميته مجرّد سوء طبع.
Dialogue: 0,0:12:58.59,0:13:00.29,Default,,0,0,0,,‫لقد توفّيت زوجته
Dialogue: 0,0:13:00.29,0:13:04.09,Default,,0,0,0,,‫تمامًا عند اكتمال بناء غرفة الشاي تلك في العام الماضي.
Dialogue: 0,0:13:05.19,0:13:07.39,Default,,0,0,0,,‫كانت تأخذ الأسطورة بجديةٍ كبيرة
Dialogue: 0,0:13:07.39,0:13:10.99,Default,,0,0,0,,‫وكانت تعارض بناء غرفة الشاي حتى النهاية.
Dialogue: 0,0:13:12.09,0:13:14.49,Default,,0,0,0,,‫يبدو ذلك مألوفًا جدًا.
Dialogue: 0,0:13:14.49,0:13:16.59,Default,,0,0,0,,‫نعم… إلى حدٍّ ما.
Dialogue: 0,0:13:16.59,0:13:18.49,Default,,0,0,0,,‫ويُشاع فيما بيننا
Dialogue: 0,0:13:18.49,0:13:21.79,Default,,0,0,0,,‫أن بعضهم رأى ظلَّ الوحش.
Dialogue: 0,0:13:21.79,0:13:23.29,Default,,0,0,0,,‫أفهم.
Dialogue: 0,0:13:23.29,0:13:24.49,Default,,0,0,0,,‫أي إنك تقول
Dialogue: 0,0:13:24.49,0:13:25.79,Default,,0,0,0,,‫إن السيّد صار صعبَ المعاشرة
Dialogue: 0,0:13:25.79,0:13:27.69,Default,,0,0,0,,‫بسبب خوفه من الوحش؟
Dialogue: 0,0:13:27.69,0:13:30.19,Default,,0,0,0,,‫ليس تمامًا. إنه يضحك قائلًا
Dialogue: 0,0:13:30.19,0:13:32.69,Default,,0,0,0,,‫إنها خرافة لا أساس لها.
Dialogue: 0,0:13:32.69,0:13:35.19,Default,,0,0,0,,‫سأذهب لأجهّز الحمّام.
Dialogue: 0,0:13:36.19,0:13:39.69,Default,,0,0,0,,‫إذن سأذهب للاستحمام أنا أيضًا.
Dialogue: 0,0:13:39.69,0:13:41.39,Default,,0,0,0,,‫أرجو المعذرة.
Dialogue: 0,0:13:44.69,0:13:48.09,Default,,0,0,0,,‫ترى… هل يوجد وحشٌ حقًا؟
Dialogue: 0,0:13:48.09,0:13:50.19,Default,,0,0,0,,‫لا تقل هراءً!
Dialogue: 0,0:14:12.79,0:14:14.99,Default,,0,0,0,,‫من الطارق؟
Dialogue: 0,0:14:23.68,0:14:26.18,Default,,0,0,0,,‫هاه؟ أنت…
Dialogue: 0,0:14:26.18,0:14:27.68,Default,,0,0,0,,‫هل تشعر بالملل؟
Dialogue: 0,0:14:27.68,0:14:29.48,Default,,0,0,0,,‫إلى حدٍّ ما.
Dialogue: 0,0:14:29.48,0:14:33.08,Default,,0,0,0,,‫هل اصطدتَ تلك السمكة الكبيرة؟
Dialogue: 0,0:14:33.08,0:14:34.38,Default,,0,0,0,,‫نعم، صحيح.
Dialogue: 0,0:14:34.38,0:14:39.08,Default,,0,0,0,,‫كونان، ها أنت هنا!
Dialogue: 0,0:14:39.08,0:14:40.58,Default,,0,0,0,,‫أعتذر.
Dialogue: 0,0:14:40.58,0:14:44.18,Default,,0,0,0,,‫هل نذهب إلى غرفة الضيوف ونأكل بعض الحلوى؟
Dialogue: 0,0:14:44.18,0:14:45.68,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:14:47.28,0:14:50.28,Default,,0,0,0,,‫هيه! كونان، أين كنت؟
Dialogue: 0,0:14:50.28,0:14:52.38,Default,,0,0,0,,‫كان في غرفة ريوئيتشي لبعض الوقت.
Dialogue: 0,0:14:52.38,0:14:55.48,Default,,0,0,0,,‫كانت هناك طبعةُ سمكةٍ كبيرة تزيّن غرفته.
Dialogue: 0,0:14:55.48,0:14:58.08,Default,,0,0,0,,‫حسنًا، ريوئيتشي مدهشٌ حقًا.
Dialogue: 0,0:14:58.08,0:15:00.48,Default,,0,0,0,,‫إنه يدعوني أحيانًا لصيد الليل معه،
Dialogue: 0,0:15:00.48,0:15:03.58,Default,,0,0,0,,‫لكنني لا أقاربه في مهارته في صيد السمك.
Dialogue: 0,0:15:04.88,0:15:06.48,Default,,0,0,0,,‫إنه جهازُ إنذار السرقة.
Dialogue: 0,0:15:06.48,0:15:08.78,Default,,0,0,0,,‫ربما جاء أحدهم.
Dialogue: 0,0:15:17.18,0:15:19.18,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:15:19.18,0:15:22.68,Default,,0,0,0,,‫لماذا تتلفّت هكذا؟
Dialogue: 0,0:15:24.98,0:15:26.18,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:15:27.58,0:15:30.48,Default,,0,0,0,,‫انظروا، لقد صار لونُ البركة أحمر!
Dialogue: 0,0:15:30.48,0:15:33.98,Default,,0,0,0,,‫إنه ساطعٌ جدًا حتى إنني لا أحتمل النظر إليه.
Dialogue: 0,0:15:33.98,0:15:35.18,Default,,0,0,0,,‫إنها الرابعة مساءً.
Dialogue: 0,0:15:35.18,0:15:38.88,Default,,0,0,0,,‫في مثل هذا الوقت تقريبًا، يتشتّت ضوء الشمس المنعكس…
Dialogue: 0,0:15:40.88,0:15:43.88,Default,,0,0,0,,‫أشعر بحرٍّ شديد.
Dialogue: 0,0:15:43.88,0:15:46.78,Default,,0,0,0,,‫سيدة هاناساكي، هل لديكِ شيءٌ باردٌ نشربه؟
Dialogue: 0,0:15:43.88,0:15:46.78,Default,,0,0,0,,‫سيدة ميمورا، أين كنتِ؟
Dialogue: 0,0:15:46.78,0:15:49.58,Default,,0,0,0,,‫ماذا؟ هذا ليس من شأنك، أليس كذلك؟
Dialogue: 0,0:15:50.88,0:15:54.38,Default,,0,0,0,,‫ملابسُها مبعثرة وهي تتصبّب عرقًا بغزارة.
Dialogue: 0,0:15:54.38,0:15:57.08,Default,,0,0,0,,‫لا بدّ أنها كانت في عجلةٍ شديدة.
Dialogue: 0,0:15:57.08,0:15:59.58,Default,,0,0,0,,‫سيدة ميمورا، ما هذه الوقاحة!
Dialogue: 0,0:15:59.58,0:16:01.58,Default,,0,0,0,,‫لقد دعاكِ بنفسه، بعد كل شيء.
Dialogue: 0,0:16:03.68,0:16:05.98,Default,,0,0,0,,‫ومن تظنّين نفسكِ؟
Dialogue: 0,0:16:05.98,0:16:08.48,Default,,0,0,0,,‫إنها مراسم شاي سيقيمها السيّد!
Dialogue: 0,0:16:08.48,0:16:11.48,Default,,0,0,0,,‫من الوقاحة الشديدة أن تنسحبي هكذا!
Dialogue: 0,0:16:11.48,0:16:14.68,Default,,0,0,0,,‫هيا الآن، كلاكما.
Dialogue: 0,0:16:14.68,0:16:16.28,Default,,0,0,0,,‫سمعتُ أن هذه ستكون مراسم الشاي الأخيرة
Dialogue: 0,0:16:16.28,0:16:18.08,Default,,0,0,0,,‫التي سيقيمها.
Dialogue: 0,0:16:19.08,0:16:20.28,Default,,0,0,0,,‫هذا هو الأمر إذن!
Dialogue: 0,0:16:20.28,0:16:23.98,Default,,0,0,0,,‫أراهن أنكِ كنتِ تتمنّين استقالة السيّد!
Dialogue: 0,0:16:24.98,0:16:27.38,Default,,0,0,0,,‫وما الذي تقصده بهذا يا سيدة ميمورا؟
Dialogue: 0,0:16:27.38,0:16:30.58,Default,,0,0,0,,‫أتمنّى ألا تُطلق افتراضاتٍ قبيحة!
Dialogue: 0,0:16:30.58,0:16:31.78,Default,,0,0,0,,‫حسنًا، حسنًا…
Dialogue: 0,0:16:32.18,0:16:35.48,Default,,0,0,0,,‫حسنًا… أنا آسفةٌ جدًا.
Dialogue: 0,0:16:38.08,0:16:39.68,Default,,0,0,0,,‫آه، ما أغيظ هذا!
Dialogue: 0,0:16:39.68,0:16:41.98,Default,,0,0,0,,‫حتى لونُ البركة يبدو حارًّا.
Dialogue: 0,0:16:48.78,0:16:50.08,Default,,0,0,0,,‫ما الأمر؟
Dialogue: 0,0:16:51.98,0:16:53.88,Default,,0,0,0,,‫ذلك…
Dialogue: 0,0:16:53.88,0:16:55.78,Default,,0,0,0,,‫إنه السيّد!
Dialogue: 0,0:16:57.48,0:16:58.88,Default,,0,0,0,,‫أبي؟
Dialogue: 0,0:17:08.88,0:17:10.78,Default,,0,0,0,,‫أبي؟
Dialogue: 0,0:17:10.78,0:17:12.48,Default,,0,0,0,,‫ما كل هذا الدم؟
Dialogue: 0,0:17:12.48,0:17:14.68,Default,,0,0,0,,‫لا فائدة… البابُ مُغلق!
Dialogue: 0,0:17:14.68,0:17:16.28,Default,,0,0,0,,‫هل يوجد مدخلٌ آخر؟
Dialogue: 0,0:17:16.28,0:17:17.58,Default,,0,0,0,,‫مدخلُ موضع الاغتسال من الخلف.
Dialogue: 0,0:17:17.58,0:17:18.88,Default,,0,0,0,,‫ريوئيتشي!
Dialogue: 0,0:17:18.88,0:17:21.08,Default,,0,0,0,,‫بابُ موضع الاغتسال مُغلقٌ أيضًا!
Dialogue: 0,0:17:21.08,0:17:23.48,Default,,0,0,0,,‫لا خيار لنا… لنكسر الباب!
Dialogue: 0,0:17:23.48,0:17:24.78,Default,,0,0,0,,‫تفضّلوا وابتعدوا.
Dialogue: 0,0:17:30.88,0:17:32.68,Default,,0,0,0,,‫سيّدي؟
Dialogue: 0,0:17:32.68,0:17:34.58,Default,,0,0,0,,‫سيّدي!
Dialogue: 0,0:17:38.88,0:17:41.88,Default,,0,0,0,,‫لا جدوى… لقد مات.
Dialogue: 0,0:17:41.88,0:17:43.58,Default,,0,0,0,,‫أبي…
Dialogue: 0,0:17:45.58,0:17:46.98,Default,,0,0,0,,‫إنها الأسطورة!
Dialogue: 0,0:17:46.98,0:17:50.98,Default,,0,0,0,,‫كما في الأسطورة تمامًا… لقد قتله الوحش!
Dialogue: 0,0:17:53.18,0:17:54.88,Default,,0,0,0,,‫أبي!
Dialogue: 0,0:17:59.98,0:18:01.48,Default,,0,0,0,,‫شكرًا لك.
Dialogue: 0,0:18:02.38,0:18:05.08,Default,,0,0,0,,‫هاه؟ أهلًا يا كونان.
Dialogue: 0,0:18:05.08,0:18:06.88,Default,,0,0,0,,‫الضابط يوكوميزو؟
Dialogue: 0,0:18:06.88,0:18:09.38,Default,,0,0,0,,‫وهذا يعني أن السيد موري هنا أيضًا، صحيح؟
Dialogue: 0,0:18:09.38,0:18:11.88,Default,,0,0,0,,‫نعم، إنه هناك.
Dialogue: 0,0:18:13.48,0:18:17.48,Default,,0,0,0,,‫مرحبًا بك يا سيد موري. يسعدني أن أراك مجددًا.
Dialogue: 0,0:18:17.48,0:18:21.18,Default,,0,0,0,,‫أما أنا فلا يسعدني رؤيتك.
Dialogue: 0,0:18:21.18,0:18:24.18,Default,,0,0,0,,‫لا حاجة لإخفاء حرجك.
Dialogue: 0,0:18:24.18,0:18:25.58,Default,,0,0,0,,‫أيها الضابط يوكوميزو.
Dialogue: 0,0:18:25.58,0:18:27.98,Default,,0,0,0,,‫ما توصّلنا إليه حتى الآن هو أن
Dialogue: 0,0:18:27.98,0:18:29.68,Default,,0,0,0,,‫هذا البابَ الصغير كان مُغلقًا
Dialogue: 0,0:18:29.68,0:18:32.08,Default,,0,0,0,,‫من الداخل بعصًا خشبية طويلة.
Dialogue: 0,0:18:32.08,0:18:35.78,Default,,0,0,0,,‫أما النافذة، فالبابُ المنزلق كان مواربًا قليلًا.
Dialogue: 0,0:18:35.78,0:18:38.38,Default,,0,0,0,,‫لكن كما ترى، إنه محجوبٌ بشبكةٍ خشبية.
Dialogue: 0,0:18:38.38,0:18:41.58,Default,,0,0,0,,‫وفي الجهة الشرقية يوجد مدخلُ موضع الاغتسال،
Dialogue: 0,0:18:41.58,0:18:44.28,Default,,0,0,0,,‫لكن هذا أيضًا كان مُغلقًا من الداخل.
Dialogue: 0,0:18:44.28,0:18:46.98,Default,,0,0,0,,‫أتقصد أن جميع الأبواب كانت مُغلقة؟
Dialogue: 0,0:18:46.98,0:18:48.58,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:18:48.58,0:18:52.38,Default,,0,0,0,,‫والوقتُ المقدّر للوفاة بين الثالثة والنصف والرابعة عصرًا.
Dialogue: 0,0:18:52.38,0:18:54.18,Default,,0,0,0,,‫كانت الجثة تنزف…
Dialogue: 0,0:18:54.18,0:18:55.58,Default,,0,0,0,,‫غير أن السبب المباشر للوفاة
Dialogue: 0,0:18:55.58,0:18:59.48,Default,,0,0,0,,‫يُعتقد أنه الاختناقُ بالخنق.
Dialogue: 0,0:18:59.48,0:19:01.18,Default,,0,0,0,,‫إنه انتحار.
Dialogue: 0,0:19:01.18,0:19:04.18,Default,,0,0,0,,‫انظروا إلى بقع الدم.
Dialogue: 0,0:19:04.18,0:19:06.18,Default,,0,0,0,,‫حاول السيّد أولًا الانتحار
Dialogue: 0,0:19:06.18,0:19:08.98,Default,,0,0,0,,‫بشقّ معصمه عند الرواق.
Dialogue: 0,0:19:08.98,0:19:12.48,Default,,0,0,0,,‫لكنه فشل، ثم ربما حاول شقّ عنقه.
Dialogue: 0,0:19:12.48,0:19:14.68,Default,,0,0,0,,‫إن صحّ ذلك، فهذا يفسّر آثار الدم
Dialogue: 0,0:19:14.68,0:19:18.38,Default,,0,0,0,,‫التي تمتدّ من هنا حتى غرفة الشاي.
Dialogue: 0,0:19:20.38,0:19:22.48,Default,,0,0,0,,‫لو أنه فشل في الانتحار عند الرواق
Dialogue: 0,0:19:22.48,0:19:24.18,Default,,0,0,0,,‫ثم حاول أن يشنق نفسه،
Dialogue: 0,0:19:24.18,0:19:26.78,Default,,0,0,0,,‫لما وجد الوقت ليُحكم إغلاق الغرفة.
Dialogue: 0,0:19:29.18,0:19:31.18,Default,,0,0,0,,‫الطاحونة تدور.
Dialogue: 0,0:19:32.48,0:19:33.58,Default,,0,0,0,,‫يا للعجب.
Dialogue: 0,0:19:33.58,0:19:35.78,Default,,0,0,0,,‫يا له من مدخلٍ صغير!
Dialogue: 0,0:19:40.48,0:19:42.58,Default,,0,0,0,,‫توجد بقايا دبوس تثبيتٍ أو ما شابه،
Dialogue: 0,0:19:42.58,0:19:44.68,Default,,0,0,0,,‫كان مغروزًا في مؤخرة الباب.
Dialogue: 0,0:19:54.48,0:19:56.78,Default,,0,0,0,,‫لقد قُطع الحبل بطريقةٍ غريبة.
Dialogue: 0,0:19:56.78,0:19:58.38,Default,,0,0,0,,‫يبدو أنه قُطع جزئيًا،
Dialogue: 0,0:19:58.38,0:20:00.38,Default,,0,0,0,,‫ثم مُزّق في النهاية.
Dialogue: 0,0:20:06.68,0:20:09.88,Default,,0,0,0,,‫اللفافةُ المعلّقة مفروشةٌ على الأرض.
Dialogue: 0,0:20:09.88,0:20:11.38,Default,,0,0,0,,‫لا بدّ أنه كان يتهيّأ لمراسم الشاي
Dialogue: 0,0:20:11.38,0:20:12.98,Default,,0,0,0,,‫التي ستقام مساء اليوم.
Dialogue: 0,0:20:12.98,0:20:14.78,Default,,0,0,0,,‫رغم أنه كان يستعدّ،
Dialogue: 0,0:20:14.78,0:20:17.38,Default,,0,0,0,,‫فقد اختار الموتَ بدافعٍ مفاجئ.
Dialogue: 0,0:20:17.38,0:20:19.98,Default,,0,0,0,,‫أظنّ أن هذا ما حدث.
Dialogue: 0,0:20:19.98,0:20:22.38,Default,,0,0,0,,‫الكتابة لم تكتمل إلا إلى النصف.
Dialogue: 0,0:20:22.38,0:20:23.38,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:20:23.38,0:20:26.78,Default,,0,0,0,,‫ما هذا الحطام؟ نشارةُ خشب؟
Dialogue: 0,0:20:26.78,0:20:29.38,Default,,0,0,0,,‫حتى على حصير التاتامي…
Dialogue: 0,0:20:29.38,0:20:30.48,Default,,0,0,0,,‫فهمت!
Dialogue: 0,0:20:30.48,0:20:32.98,Default,,0,0,0,,‫إنه خشبٌ من العمود الذي رُبط به الحبل.
Dialogue: 0,0:20:32.98,0:20:36.78,Default,,0,0,0,,‫هاه؟ لكن هناك خدشًا على الخشب الذي استُخدم كدعامة.
Dialogue: 0,0:20:38.08,0:20:40.28,Default,,0,0,0,,‫لا أستطيع الرؤية جيدًا.
Dialogue: 0,0:20:42.78,0:20:44.68,Default,,0,0,0,,‫هيه، متى دخلتَ إلى هنا أصلًا؟
Dialogue: 0,0:20:44.68,0:20:46.28,Default,,0,0,0,,‫توقّف عن إعاقة الطريق!
Dialogue: 0,0:20:49.48,0:20:51.18,Default,,0,0,0,,‫هل تحملني على ظهرك؟
Dialogue: 0,0:20:51.18,0:20:52.88,Default,,0,0,0,,‫ما الذي تقوله؟
Dialogue: 0,0:20:52.88,0:20:54.88,Default,,0,0,0,,‫اخرج من هنا!
Dialogue: 0,0:20:54.88,0:20:56.78,Default,,0,0,0,,‫هيه، ماذا تحاول أن تفعل؟
Dialogue: 0,0:20:58.78,0:20:59.88,Default,,0,0,0,,‫كما توقّعت!
Dialogue: 0,0:20:59.88,0:21:01.38,Default,,0,0,0,,‫هناك آثارُ احتكاكٍ على مواضع
Dialogue: 0,0:21:01.38,0:21:04.58,Default,,0,0,0,,‫غير الموضع الذي عُلّق فيه الحبل.
Dialogue: 0,0:21:04.58,0:21:07.18,Default,,0,0,0,,‫وفوق ذلك، فهي ما تزال جديدة.
Dialogue: 0,0:21:08.18,0:21:09.48,Default,,0,0,0,,‫أبي!
Dialogue: 0,0:21:09.48,0:21:11.98,Default,,0,0,0,,‫كما تشاء!
Dialogue: 0,0:21:11.98,0:21:14.88,Default,,0,0,0,,‫قتله الوحش الأسطوري؟
Dialogue: 0,0:21:14.88,0:21:18.88,Default,,0,0,0,,‫أتتوقّع مني، وأنا ضابطُ شرطة، أن أصدق ذلك؟
Dialogue: 0,0:21:19.88,0:21:22.08,Default,,0,0,0,,‫لا شكّ في ذلك!
Dialogue: 0,0:21:22.08,0:21:23.68,Default,,0,0,0,,‫من بقع الدم على الرواق
Dialogue: 0,0:21:23.68,0:21:25.08,Default,,0,0,0,,‫إلى كونه شنق نفسه،
Dialogue: 0,0:21:25.08,0:21:28.08,Default,,0,0,0,,‫كلّ شيءٍ يشبه الأسطورة كثيرًا!
Dialogue: 0,0:21:28.08,0:21:30.28,Default,,0,0,0,,‫قد لا يكون هناك وحش،
Dialogue: 0,0:21:30.28,0:21:33.58,Default,,0,0,0,,‫لكنّه قُتل كما تقول الأسطورة.
Dialogue: 0,0:21:33.58,0:21:36.58,Default,,0,0,0,,‫كأنما قتله الوحش فعلًا.
Dialogue: 0,0:21:36.58,0:21:40.98,Default,,0,0,0,,‫كان ينبغي ألّا تُبنى غرفة الشاي هذه أصلًا.
Dialogue: 0,0:21:40.98,0:21:42.88,Default,,0,0,0,,‫مباشرةً بعد اكتمال غرفة الشاي،
Dialogue: 0,0:21:42.88,0:21:45.28,Default,,0,0,0,,‫ماتت زوجته بسكتةٍ قلبية.
Dialogue: 0,0:21:45.28,0:21:48.48,Default,,0,0,0,,‫والآن السيّد أيضًا.
Dialogue: 0,0:21:48.48,0:21:51.78,Default,,0,0,0,,‫هذا بلا شك من فعل الوحش.
Dialogue: 0,0:21:52.98,0:21:54.78,Default,,0,0,0,,‫ما يعني أن…
Dialogue: 0,0:21:54.78,0:21:58.18,Default,,0,0,0,,‫يبدو أنه كان مرهقًا نفسيًا إلى حدٍّ كبير،
Dialogue: 0,0:21:58.18,0:22:01.08,Default,,0,0,0,,‫لذا أنا واثقٌ أنه انتحر.
Dialogue: 0,0:22:01.08,0:22:02.38,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:22:05.18,0:22:08.88,Default,,0,0,0,,‫لا… هذا ليس انتحارًا.
Dialogue: 0,0:22:10.38,0:22:13.08,Default,,0,0,0,,‫إنه قتلٌ عمد!
Dialogue: 0,0:22:13.08,0:22:14.98,Default,,0,0,0,,‫أنا متأكدٌ أن أحد الموجودين هنا
Dialogue: 0,0:22:14.98,0:22:17.98,Default,,0,0,0,,‫دبّر حيلةً شديدةَ الإحكام وقتل السيّد،
Dialogue: 0,0:22:17.98,0:22:20.18,Default,,0,0,0,,‫بعد أن جعل الأمر يبدو وكأنه انتحر!
Dialogue: 0,0:22:22.68,0:22:25.48,Default,,0,0,0,,‫من الذي يمكن أن يفعل هذا؟
Dialogue: 0,0:22:25.48,0:22:28.78,Default,,0,0,0,,‫من الذي يتقمّص دور الوحش؟
Dialogue: 0,0:24:03.48,0:24:05.48,Default,,0,0,0,,‫تلميح كونان القادم:
Dialogue: 0,0:24:05.74,0:24:07.30,Default,,0,0,0,,‫"طاحونة الهواء
