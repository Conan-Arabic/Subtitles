Dialogue: 0,0:00:00.00,0:00:05.00,DCMain,,0,0,0,,
Dialogue: 0,0:00:04.65,0:00:07.65,Amamiya,SIGN,0,0,0,,اماميا شو وماساكي
Dialogue: 0,0:00:08.20,0:00:09.50,DCMain,SKINNY,0,0,0,,.هذا سي
Dialogue: 0,0:00:09.50,0:00:11.28,DCMain,SKINNY,0,0,0,,ماذا نفعل الان يااخي ؟
Dialogue: 0,0:00:11.72,0:00:13.73,DCMain,BRO,0,0,0,,,انا افكر
Dialogue: 0,0:00:13.73,0:00:15.07,DCMain,BRO,0,0,0,,!اخرس للحظه
Dialogue: 0,0:00:21.22,0:00:22.83,DCMain,MITSUHIKO,0,0,0,,!اعذرونا
Dialogue: 0,0:00:22.83,0:00:24.58,DCMain,MITSUHIKO,0,0,0,,ايوجد احد في البيت ؟
Dialogue: 0,0:00:24.58,0:00:25.98,DCMain,GENTA,0,0,0,,!اسرع
Dialogue: 0,0:00:25.98,0:00:26.96,DCMain,GENTA,0,0,0,,!انا على وشك ان ابلل ملابسي
Dialogue: 0,0:00:27.59,0:00:29.29,DCMain,AYUMI,0,0,0,,!يمكنك ان تفعلها ياغينتا
Dialogue: 0,0:00:29.29,0:00:30.82,DCMain,AYUMI,0,0,0,,!فقط اصبر قليلاً
Dialogue: 0,0:00:30.82,0:00:32.60,DCMain,MITSUHIKO,0,0,0,,ايوجد احدً هنا ؟
Dialogue: 0,0:00:32.99,0:00:33.55,DCMain,CONAN,0,0,0,,ها ؟
Dialogue: 0,0:00:33.55,0:00:34.28,DCMain,CONAN,0,0,0,,!انهو مفتوح
Dialogue: 0,0:00:34.28,0:00:34.97,DCMain,GENTA,0,0,0,,!حسناً
Dialogue: 0,0:00:35.64,0:00:37.23,DCMain,GENTA,0,0,0,,!اعذرونا على التطفل
Dialogue: 0,0:00:37.23,0:00:38.68,DCMain,CONAN,0,0,0,,!جينتا
Dialogue: 0,0:00:37.76,0:00:39.47,DCMain,GENTA,0,0,0,,,الحمام, الحمام
Dialogue: 0,0:00:42.19,0:00:46.60,DCMain,AYUMI,0,0,0,,!واو, يوجد كثير من الالعاب هنا
Dialogue: 0,0:00:46.60,0:00:49.11,DCMain,MITSUHIKO,0,0,0,,.ان هذا المكان بالفعل متحف للالعاب
Dialogue: 0,0:00:50.20,0:00:51.25,DCMain,GENTA,0,0,0,,اين هو ؟
Dialogue: 0,0:00:52.74,0:00:55.32,DCMain,GENTA,0,0,0,,!يوجد شيً هنا 
Dialogue: 0,0:00:57.01,0:01:00.84,DCMain,GENTA,0,0,0,,!ارجوكم دعوني استخدم الحمام
Dialogue: 0,0:01:00.84,0:01:02.45,DCMain,BRO,0,0,0,,!بالتاكيد, تفضلوا
Dialogue: 0,0:01:07.50,0:01:09.56,DCMain,CONAN,0,0,0,,.قماش ملطخ بالسواد في مسرح جريمه
Dialogue: 0,0:01:09.56,0:01:11.53,DCMain,CONAN,0,0,0,,!مع براعه في التحقيق, لونها سيتغير
Dialogue: 0,0:01:11.95,0:01:14.14,DCMain,CONAN,0,0,0,,.انهو نوعاً ما متحف من الالعاب  كل شخص يحلم به
Dialogue: 0,0:01:14.14,0:01:16.18,DCMain,CONAN,0,0,0,,!لكن يبدو ان هنالك خطباً ما
Dialogue: 0,0:01:16.18,0:01:19.97,DCMain,CONAN,0,0,0,,,ودائماً اكتشف الحقيه بجسد طفل صغير وعقل شخص كبير
Dialogue: 0,0:01:19.97,0:01:22.43,DCMain,CONAN,0,0,0,,واسمي المحقق كونان
Dialogue: 0,0:03:01.95,0:03:07.95,DCEpTitle,EPTITLE,0,0,0,,الاطفال المحققون يختبون من المطر
Dialogue: 0,0:03:02.73,0:03:05.88,DCMain,CONAN,0,0,0,,
Dialogue: 0,0:03:10.27,0:03:12.85,DCMain,AYUMI,0,0,0,,انظر ! اليس هذا كوميرا ؟
Dialogue: 0,0:03:13.93,0:03:16.16,DCMain,MITSUHIKO,0,0,0,,!انهو ضخم 
Dialogue: 0,0:03:16.78,0:03:19.59,DCMain,SKINNY,0,0,0,,اخي, لماذا ادخلتهم ؟
Dialogue: 0,0:03:19.59,0:03:21.04,DCMain,BRO,0,0,0,,.لم استطع ايقافهم
Dialogue: 0,0:03:21.04,0:03:24.18,DCMain,BRO,0,0,0,,.في كل الاحوال, فل ندعهم يستدخمون الحمام  وثم نطردهم
Dialogue: 0,0:03:27.18,0:03:28.15,DCMain,CONAN,0,0,0,,.انت
Dialogue: 0,0:03:28.71,0:03:30.37,DCMain,CONAN,0,0,0,,اليس هذا هو الحمام؟ 
Dialogue: 0,0:03:30.37,0:03:31.19,DCMain,GENTA,0,0,0,,! حقاً 
Dialogue: 0,0:03:32.10,0:03:33.19,DCMain,GENTA,0,0,0,,.حسناً
Dialogue: 0,0:03:38.64,0:03:40.86,DCMain,BRO,0,0,0,,!هذا ليس الحمام
Dialogue: 0,0:03:41.63,0:03:44.29,DCMain,CONAN,0,0,0,,سيدي, انت اماميا مساكي سان, اليس كذالك ؟
Dialogue: 0,0:03:44.29,0:03:44.95,DCMain,SKINNY,0,0,0,,ماذا ؟
Dialogue: 0,0:03:44.95,0:03:47.45,Amamiya2,SIGN,0,0,0,,اماميا شو و مساكي
Dialogue: 0,0:03:45.43,0:03:47.45,DCMain,CONAN,0,0,0,,!كانت مكتوبه في الخارج عند الباب
Dialogue: 0,0:03:47.74,0:03:50.45,DCMain,CONAN,0,0,0,,وهذا اخوك شو سان, اليس كذالك ؟
Dialogue: 0,0:03:50.96,0:03:52.86,DCMain,CONAN,0,0,0,,.قبل قليل كنت تقول له اخي
Dialogue: 0,0:03:54.52,0:03:55.64,DCMain,BRO,0,0,0,,.اه, اجل صحيح
Dialogue: 0,0:03:55.64,0:03:57.91,DCMain,BRO,0,0,0,,.انا اماميا شو, الاخ الاكبر
Dialogue: 0,0:03:57.91,0:04:00.84,DCMain,SKINNY,0,0,0,,.وانا اخوه الاصغر, اماميا مساكي
Dialogue: 0,0:04:01.10,0:04:03.35,DCMain,CONAN,0,0,0,,وانتما الاثنان تعيشان هنا؟
Dialogue: 0,0:04:03.35,0:04:04.46,DCMain,BRO,0,0,0,,!نعم
Dialogue: 0,0:04:04.46,0:04:07.98,DCMain,BRO,0,0,0,,.نحن اصدقاء واخوان ايضاً ونحب الالعاب 
Dialogue: 0,0:04:08.92,0:04:10.60,DCMain,SKINNY,0,0,0,,!الالعاب هيه الاحلى
Dialogue: 0,0:04:10.87,0:04:11.91,DCMain,GENTA,0,0,0,,!انسى ذالك
Dialogue: 0,0:04:11.91,0:04:13.06,DCMain,GENTA,0,0,0,,اين الحمام؟
Dialogue: 0,0:04:13.29,0:04:14.88,DCMain,SKINNY,0,0,0,,.اه, اسف 
Dialogue: 0,0:04:17.00,0:04:18.31,DCMain,SKINNY,0,0,0,,.هذا هو
Dialogue: 0,0:04:18.31,0:04:20.57,DCMain,BRO,0,0,0,,....ايها الغبي, ان هذا حوض الاستحمام
Dialogue: 0,0:04:22.01,0:04:22.95,DCMain,BRO,0,0,0,,.اسف
Dialogue: 0,0:04:23.65,0:04:25.65,DCMain,BRO,0,0,0,,.لقد انتقلنا حديثاً الى هذا البيت
Dialogue: 0,0:04:25.65,0:04:27.95,DCMain,BRO,0,0,0,,اين الحمام؟
Dialogue: 0,0:04:28.27,0:04:31.34,DCMain,MITSUHIKO,0,0,0,,.ولهذا السبب ترتدون قفازات
Dialogue: 0,0:04:31.34,0:04:33.21,DCMain,MITSUHIKO,0,0,0,,.واعذرنا على ازعاجكم بينما انتم تنتقلون
Dialogue: 0,0:04:33.43,0:04:34.27,DCMain,SKINNY,0,0,0,,.حسناً
Dialogue: 0,0:04:34.55,0:04:36.67,DCMain,SKINNY,0,0,0,,...حسنا, انت تعرف
Dialogue: 0,0:04:37.43,0:04:38.60,DCMain,BRO,0,0,0,,.اه, لقد وجدته
Dialogue: 0,0:04:38.60,0:04:39.63,DCMain,BRO,0,0,0,,.هذا هو
Dialogue: 0,0:04:41.37,0:04:42.98,DCMain,GENTA,0,0,0,,.الحمدلله
Dialogue: 0,0:04:49.32,0:04:51.22,DCMain,GENTA,0,0,0,,.لقد ارتحت
Dialogue: 0,0:04:51.38,0:04:55.36,DCMain,AYUMI,0,0,0,,طالما نحن هنا, لماذا لا نبقى هنا حتى يقف المطر ؟
Dialogue: 0,0:04:55.36,0:04:56.46,DCMain,MITSUHIKO,0,0,0,,.فكره جيده
Dialogue: 0,0:04:56.46,0:04:58.11,DCMain,MITSUHIKO,0,0,0,,....ربما نساعدها في نقل
Dialogue: 0,0:04:58.11,0:04:58.69,DCMain,CONAN,0,0,0,,لا
Dialogue: 0,0:04:58.69,0:04:59.15,DCMain,ALL,0,0,0,,ها ؟
Dialogue: 0,0:05:00.03,0:05:01.07,DCMain,CONAN,0,0,0,,!دعنا نرجع حالاً
Dialogue: 0,0:05:01.34,0:05:02.85,DCMain,ALL,0,0,0,,ماذا ؟
Dialogue: 0,0:05:02.85,0:05:05.98,DCMain,CONAN,0,0,0,,البروفيسور سيقلق اذا لم نرجع قريباً
Dialogue: 0,0:05:05.98,0:05:06.99,DCMain,CONAN,0,0,0,,.دعنا نذهب الان
Dialogue: 0,0:05:06.99,0:05:08.57,DCMain,ALL,0,0,0,,....حسنا
Dialogue: 0,0:05:09.76,0:05:11.08,DCMain,ALL,0,0,0,,.اعذرونا على الازعاج
Dialogue: 0,0:05:11.69,0:05:12.64,DCMain,SKINNY,0,0,0,,....لا مشكله
Dialogue: 0,0:05:12.64,0:05:14.08,DCMain,SKINNY,0,0,0,,.مع السلامه
Dialogue: 0,0:05:16.98,0:05:19.28,DCMain,WOMAN,0,0,0,,!انقذوني
Dialogue: 0,0:05:21.16,0:05:21.99,DCMain,SKINNY,0,0,0,,.اللعنه
Dialogue: 0,0:05:21.99,0:05:24.34,DCMain,SKINNY,0,0,0,,لقد استيقضت الامرأه
Dialogue: 0,0:05:24.69,0:05:25.67,DCMain,CONAN,0,0,0,,!هذا ليس جيداً
Dialogue: 0,0:05:25.67,0:05:26.79,DCMain,CONAN,0,0,0,,!هيا اسرعوا
Dialogue: 0,0:05:27.18,0:05:28.59,DCMain,SKINNY,0,0,0,,!انتضروا
Dialogue: 0,0:05:30.85,0:05:32.96,DCMain,GENTA,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:05:35.82,0:05:36.69,DCMain,BRO,0,0,0,,!لن تذهبوا الى اي مكان
Dialogue: 0,0:05:38.62,0:05:39.32,DCMain,CONAN,0,0,0,,!اركضوا
Dialogue: 0,0:05:39.32,0:05:40.40,DCMain,CONAN,0,0,0,,!انهم لصوص
Dialogue: 0,0:05:40.65,0:05:42.32,DCMain,ALL,0,0,0,,ماذا ؟
Dialogue: 0,0:05:46.16,0:05:47.01,DCItalic,CONAN,0,0,0,,.اللعنه
Dialogue: 0,0:05:47.01,0:05:49.77,DCItalic,CONAN,0,0,0,,.حذائي وساعتي المخدره عند الدكتور اغاسا
Dialogue: 0,0:05:53.72,0:05:54.45,DCMain,BRO,0,0,0,,.اللعنه
Dialogue: 0,0:05:57.45,0:05:58.93,DCMain,SKINNY,0,0,0,,.فلننسهم, يااخي
Dialogue: 0,0:05:59.18,0:06:01.13,DCMain,SKINNY,0,0,0,,!يجب ان نترك الاطفال ونهرب
Dialogue: 0,0:06:01.13,0:06:02.13,DCMain,BRO,0,0,0,,!ايها الغبي
Dialogue: 0,0:06:02.13,0:06:04.84,DCMain,BRO,0,0,0,,!يجب ان يكن هنالك ذهبً في هذا البيت
Dialogue: 0,0:06:05.36,0:06:08.64,DCMain,BRO,0,0,0,,!ولن ارحل قبل ان اراه
Dialogue: 0,0:06:08.64,0:06:09.34,DCMain,BRO,0,0,0,,.دعنا نذهب
Dialogue: 0,0:06:10.44,0:06:11.72,DCMain,SKINNY,0,0,0,,....حسنا
Dialogue: 0,0:06:12.54,0:06:15.49,DCMain,MITSUHIKO,0,0,0,,؟ k و m بدايه الاحرف على القمصان كانت 
Dialogue: 0,0:06:15.49,0:06:19.10,DCMain,CONAN,0,0,0,,وكان يود ثوبً لامرأه ايضاً
Dialogue: 0,0:06:19.45,0:06:22.00,DCMain,CONAN,0,0,0,,....والساكنون الحقيقيون ربما قد 
Dialogue: 0,0:06:20.65,0:06:25.36,Kakeru,TEXT,0,0,0,,كاكورو
Dialogue: 0,0:06:20.65,0:06:25.36,Maki,TEXT,0,0,0,,ماكي
Dialogue: 0,0:06:22.00,0:06:25.36,DCMain,CONAN,0,0,0,,رجل اسمه كاكورو وامرأه اسمها ماكي
Dialogue: 0,0:06:25.67,0:06:27.73,DCMain,AYUMI,0,0,0,,....اذا الصوت الذي سمعناه قبل قليل كان
Dialogue: 0,0:06:29.90,0:06:31.07,DCMain,GENTA,0,0,0,,!دعنا نذهب
Dialogue: 0,0:06:31.07,0:06:32.34,DCMain,BOTH,0,0,0,,!جينتا
Dialogue: 0,0:06:32.34,0:06:33.38,DCMain,CONAN,0,0,0,,.اللعنه
Dialogue: 0,0:06:33.38,0:06:34.73,DCMain,CONAN,0,0,0,,اليوجد شي يمكن ان نستخدمه ؟
Dialogue: 0,0:06:35.82,0:06:37.54,DCMain,GENTA,0,0,0,,!دعنا نذهب
Dialogue: 0,0:06:37.54,0:06:38.98,DCMain,CONAN,0,0,0,,!اخفض راسك, جينتا
Dialogue: 0,0:06:47.17,0:06:48.19,DCMain,BOTH,0,0,0,,حسناً
Dialogue: 0,0:06:48.19,0:06:49.19,DCMain,CONAN,0,0,0,,!جينتا, اسرع
Dialogue: 0,0:06:49.19,0:06:50.78,DCMain,GENTA,0,0,0,,.حسنا
Dialogue: 0,0:06:50.78,0:06:52.47,DCMain,WOMAN,0,0,0,,!انقذوني
Dialogue: 0,0:06:53.55,0:06:54.94,DCMain,WOMAN,0,0,0,,!انا هنا
Dialogue: 0,0:06:57.37,0:06:58.25,DCMain,CONAN,0,0,0,,.انها هنا
Dialogue: 0,0:06:59.11,0:07:00.41,DCMain,AYUMI,0,0,0,,اانتي بخير؟
Dialogue: 0,0:07:00.41,0:07:01.23,DCMain,MAKI,0,0,0,,.اجل
Dialogue: 0,0:07:01.23,0:07:03.61,Maki2,TEXT,0,0,0,,اماميا ماكي
Dialogue: 0,0:07:01.85,0:07:03.61,DCMain,MAKI,0,0,0,,لقد فقدت الوعي
Dialogue: 0,0:07:04.03,0:07:05.86,DCMain,CONAN,0,0,0,,اانت اماميا ماكي ؟
Dialogue: 0,0:07:06.10,0:07:07.48,DCMain,MAKI,0,0,0,,من انتم ؟
Dialogue: 0,0:07:09.41,0:07:10.78,DCMain,MAKI,0,0,0,,مجموعه من الاطفال  ؟
Dialogue: 0,0:07:10.99,0:07:12.59,DCMain,MITSUHIKO,0,0,0,,.نحن لسنا اطفالاً فحسب
Dialogue: 0,0:07:12.88,0:07:14.80,DCMain,AYUMI,0,0,0,,.نحن محققون
Dialogue: 0,0:07:14.80,0:07:15.41,DCMain,MAKI,0,0,0,,ماذا ؟
Dialogue: 0,0:07:15.41,0:07:16.58,DCMain,GENTA,0,0,0,,!اللعنه, انهم هنا
Dialogue: 0,0:07:20.22,0:07:21.08,DCMain,BRO,0,0,0,,!اللعنه
Dialogue: 0,0:07:21.51,0:07:24.84,DCMain,BRO,0,0,0,,لقد هربوا لانك استغرقت وقتً طويلاً في امساكهم
Dialogue: 0,0:07:28.48,0:07:29.60,DCMain,BRO,0,0,0,,ماذا تفعل ايها الغبي؟
Dialogue: 0,0:07:29.60,0:07:31.00,DCMain,BRO,0,0,0,,!اسرع وابحث عنه
Dialogue: 0,0:07:31.57,0:07:33.61,DCMain,SKINNY,0,0,0,,!اعرف ذالك
Dialogue: 0,0:07:41.28,0:07:42.23,DCMain,BRO,0,0,0,,.اللعنه
Dialogue: 0,0:07:42.23,0:07:43.48,DCMain,BRO,0,0,0,,اين يختبئون ؟
Dialogue: 0,0:07:45.26,0:07:47.58,DCMain,GENTA,0,0,0,,على كل حال, هذا البيت كبير فعلاً
Dialogue: 0,0:07:47.58,0:07:48.23,DCMain,AYUMI,0,0,0,,.اعرف
Dialogue: 0,0:07:48.23,0:07:49.48,DCMain,AYUMI,0,0,0,,.انهو ممتلى بالالعاب
Dialogue: 0,0:07:49.97,0:07:53.95,DCMain,MAKI,0,0,0,,.زوجي طفل في عقل شخصً بالغ
Dialogue: 0,0:07:53.95,0:07:55.74,DCMain,MAKI,0,0,0,,.هو جامع للالعاب
Dialogue: 0,0:07:56.04,0:07:57.74,DCMain,GENTA,0,0,0,,واين هو زوجك الان ؟
Dialogue: 0,0:07:58.29,0:07:59.41,DCMain,MAKI,0,0,0,,.لا اعرف
Dialogue: 0,0:07:59.41,0:08:02.76,DCMain,MAKI,0,0,0,,!كان يجب ان يكون في البيت الان, لكني كنت اغتسل
Dialogue: 0,0:08:03.00,0:08:03.98,DCMain,CONAN,0,0,0,,.اه, حسناً
Dialogue: 0,0:08:03.98,0:08:05.27,DCMain,CONAN,0,0,0,,اين هو هاتفكي ؟
Dialogue: 0,0:08:06.58,0:08:09.24,DCMain,MAKI,0,0,0,,.لقد قالوا انهم قطعوا اسلاك الهاتف
Dialogue: 0,0:08:09.48,0:08:11.63,DCMain,MAKI,0,0,0,,.ولقد اخذوا هاتفي المحمول ايضاً
Dialogue: 0,0:08:12.00,0:08:15.94,DCMain,MITSUHIKO,0,0,0,,.ولقد تركنا هواتفنا المحموله في موقع المخيم
Dialogue: 0,0:08:15.94,0:08:18.39,DCMain,CONAN,0,0,0,,.فلن نستطيع الاتصال باحد من الخارج
Dialogue: 0,0:08:19.07,0:08:20.29,DCMain,MAKI,0,0,0,,....انها غرييه حقاً
Dialogue: 0,0:08:20.61,0:08:24.76,DCMain,MAKI,0,0,0,,.في العاده يمر شرطي الدوريه من هنا
Dialogue: 0,0:08:24.76,0:08:26.95,DCMain,CONAN,0,0,0,,!انها تمطر بغزاره اليوم
Dialogue: 0,0:08:26.95,0:08:29.38,DCMain,CONAN,0,0,0,,قد يكون متاخراً
Dialogue: 0,0:08:29.38,0:08:32.75,DCMain,CONAN,0,0,0,,او قد يكونٌ مشغولاً في انهيار صخري في مكان ما
Dialogue: 0,0:08:32.75,0:08:33.93,DCMain,MAKI,0,0,0,,!لا
Dialogue: 0,0:08:34.39,0:08:35.91,DCMain,BRO,0,0,0,,!لقد سمتع صوتاً هناك
Dialogue: 0,0:08:45.58,0:08:47.53,DCMain,CONAN,0,0,0,,الا يوجد شي يمكن ان نستخدمه كسلاح ؟
Dialogue: 0,0:08:57.80,0:08:59.02,DCMain,MAKI,0,0,0,,.انا اسفه
Dialogue: 0,0:08:59.76,0:09:01.68,DCMain,MAKI,0,0,0,,.لوضعكم بهذا الموقف
Dialogue: 0,0:09:02.27,0:09:04.21,DCMain,CONAN,0,0,0,,.انها ليست غلطتكي, ماكي سان
Dialogue: 0,0:09:06.39,0:09:07.91,DCMain,SKINNY,0,0,0,,ماذا نفعل بهم يااخي ؟
Dialogue: 0,0:09:07.91,0:09:09.62,DCMain,BRO,0,0,0,,اليس هذا واضحاً ؟
Dialogue: 0,0:09:11.88,0:09:13.60,DCMain,BRO,0,0,0,,....سوف نشد اياديهم. وسوف
Dialogue: 0,0:09:13.60,0:09:14.90,DCMain,MAKI,0,0,0,,.قف هناك
Dialogue: 0,0:09:18.22,0:09:19.74,DCMain,SKINNY,0,0,0,,حقاً ؟
Dialogue: 0,0:09:20.08,0:09:21.96,DCMain,BRO,0,0,0,,.ايها الغبي, انها مجرد لعبه
Dialogue: 0,0:09:21.96,0:09:24.22,DCMain,MAKI,0,0,0,,.اجل, لقد كان لعبه في الماضي
Dialogue: 0,0:09:24.22,0:09:28.25,DCMain,MAKI,0,0,0,,.لكن زوجي يستمتع بتعديل هكذا العاب
Dialogue: 0,0:09:30.16,0:09:31.50,DCMain,MAKI,0,0,0,,اتريد ان اجربها؟
Dialogue: 0,0:09:34.82,0:09:35.68,DCMain,CONAN,0,0,0,,.الان
Dialogue: 0,0:09:38.24,0:09:39.43,DCMain,SKINNY,0,0,0,,.لقد اصابتني
Dialogue: 0,0:09:40.09,0:09:41.37,DCMain,CONAN,0,0,0,,هل انتم بخير ؟
Dialogue: 0,0:09:41.37,0:09:41.93,DCMain,ALL,0,0,0,,.اجل
Dialogue: 0,0:09:42.30,0:09:44.03,DCMain,SKINNY,0,0,0,,.لقد اصابتني في صدري
Dialogue: 0,0:09:44.03,0:09:45.63,DCMain,SKINNY,0,0,0,,!سوف اموت
Dialogue: 0,0:09:45.63,0:09:48.19,DCMain,BRO,0,0,0,,!ايها الاحمق, لاتمت وتتركني
Dialogue: 0,0:09:48.79,0:09:51.11,DCMain,BRO,0,0,0,,!لحظه, انت لاتنزف حتى
Dialogue: 0,0:09:54.99,0:09:56.32,DCMain,BRO,0,0,0,,!اللعنه
Dialogue: 0,0:09:56.32,0:09:58.34,DCMain,SKINNY,0,0,0,,.اسف, اخي
Dialogue: 0,0:09:59.41,0:10:01.28,DCMain,BRO,0,0,0,,.لقد خدعونا
Dialogue: 0,0:10:01.61,0:10:03.39,DCMain,BRO,0,0,0,,....قف هناك , اللعنه
Dialogue: 0,0:10:04.15,0:10:05.33,DCMain,CONAN,0,0,0,,!اسرع
Dialogue: 0,0:10:27.68,0:10:29.56,DCMain,BRO,0,0,0,,!!سوف اقتلهم
Dialogue: 0,0:10:37.31,0:10:38.74,DCMain,CONAN,0,0,0,,!هنا
Dialogue: 0,0:10:39.90,0:10:41.66,DCMain,BRO,0,0,0,,!هولاء الاطفال اللعينون
Dialogue: 0,0:10:48.75,0:10:49.66,DCMain,BRO,0,0,0,,!لن تفروا بهذا
Dialogue: 0,0:11:03.93,0:11:05.51,DCMain,SKINNY,0,0,0,,!ايها الصبي الشقي
Dialogue: 0,0:11:15.93,0:11:17.88,DCMain,SKINNY,0,0,0,,اللعنه, ماهذا ؟
Dialogue: 0,0:11:17.88,0:11:21.52,DCMain,MITSUHIKO,0,0,0,,.انها ماده لاصقه تستخدم في بناء النماذج
Dialogue: 0,0:11:21.52,0:11:22.99,DCMain,MITSUHIKO,0,0,0,,!الان, ياجينتا
Dialogue: 0,0:11:29.00,0:11:31.12,DCMain,SKINNY,0,0,0,,!فليساعدني احدهم
Dialogue: 0,0:11:37.52,0:11:38.47,DCMain,BRO,0,0,0,,!انهم عالقون
Dialogue: 0,0:11:38.47,0:11:41.63,DCMain,BRO,0,0,0,,!ان السلالم ممتلئه بالكرات التي قذفوها
Dialogue: 0,0:11:41.84,0:11:43.34,DCMain,AYUMI,0,0,0,,!ياهوو
Dialogue: 0,0:11:46.56,0:11:48.45,DCMain,BRO,0,0,0,,!!اانت جاد 
Dialogue: 0,0:11:48.99,0:11:51.08,DCMain,SKINNY,0,0,0,,!انها خطره ياخي
Dialogue: 0,0:11:51.08,0:11:51.91,DCMain,BRO,0,0,0,,!اخرس
Dialogue: 0,0:11:51.91,0:11:53.41,DCMain,BRO,0,0,0,,!تعال معي
Dialogue: 0,0:11:55.42,0:11:56.57,DCMain,SKINNY,0,0,0,,.اخي, ساكون امامك
Dialogue: 0,0:11:56.57,0:11:58.32,DCMain,SKINNY,0,0,0,,!لا, خلفك
Dialogue: 0,0:12:00.65,0:12:01.99,DCMain,BRO,0,0,0,,اانت تمزح معي ؟
Dialogue: 0,0:12:05.91,0:12:08.60,DCMain,SKINNY,0,0,0,,!اخي
Dialogue: 0,0:12:21.84,0:12:22.71,DCMain,CONAN,0,0,0,,!انها فرصتنا
Dialogue: 0,0:12:22.71,0:12:23.33,DCMain,CONAN,0,0,0,,!اسرع
Dialogue: 0,0:12:23.33,0:12:24.63,DCMain,ALL,0,0,0,,!هيا
Dialogue: 0,0:12:29.86,0:12:30.77,DCItalic,CONAN,0,0,0,,....هذا 
Dialogue: 0,0:12:31.17,0:12:31.89,DCItalic,CONAN,0,0,0,,....ايمكن ان تكون
Dialogue: 0,0:12:33.15,0:12:34.29,DCMain,AYUMI,0,0,0,,كونان ؟
Dialogue: 0,0:12:34.29,0:12:35.81,DCMain,CONAN,0,0,0,,!ارحلوا بدوني
Dialogue: 0,0:12:43.79,0:12:44.70,DCItalic,CONAN,0,0,0,,....هذا 
Dialogue: 0,0:12:46.71,0:12:48.00,DCMain,MAKI,0,0,0,,....كاكورو سان
Dialogue: 0,0:12:49.29,0:12:51.36,DCItalic,CONAN,0,0,0,,....هل  هم
Dialogue: 0,0:13:02.54,0:13:04.47,DCMain,MITSUHIKO,0,0,0,,....هل نحن 
Dialogue: 0,0:13:05.11,0:13:07.72,DCMain,MITSUHIKO,0,0,0,,سينتهي بنا المطاف مثل زوجها ؟
Dialogue: 0,0:13:08.58,0:13:10.84,DCMain,BRO,0,0,0,,.هذا يعتمد عليكم
Dialogue: 0,0:13:10.84,0:13:11.73,DCMain,BRO,0,0,0,,حقاً ؟
Dialogue: 0,0:13:19.16,0:13:21.86,DCMain,BRO,0,0,0,,"شخصً ما يدعى " الرب
Dialogue: 0,0:13:21.86,0:13:24.99,DCMain,BRO,0,0,0,,قال انهو يوجد ذهبً في هذا البيت
Dialogue: 0,0:13:25.34,0:13:26.22,DCMain,CONAN,0,0,0,,الرب ؟
Dialogue: 0,0:13:26.22,0:13:28.91,DCMain,MITSUHIKO,0,0,0,,هل تقول بان "الرب" قال لك بان تسرق هذا البيت ؟
Dialogue: 0,0:13:29.11,0:13:31.33,DCMain,GENTA,0,0,0,,هل انت مجانين ؟
Dialogue: 0,0:13:31.45,0:13:32.62,DCMain,BRO,0,0,0,,ماذا قلت ؟
Dialogue: 0,0:13:35.32,0:13:36.98,DCMain,BRO,0,0,0,,اين الذهب ؟
Dialogue: 0,0:13:36.98,0:13:38.96,DCMain,BRO,0,0,0,,.اذا لم تقولي لن, سنقتلكم
Dialogue: 0,0:13:43.39,0:13:45.04,DCMain,BRO,0,0,0,,حسناً, انها هنا
Dialogue: 0,0:13:45.56,0:13:47.97,DCMain,SKINNY,0,0,0,,والان نستطيع ان ندفع ديوننا
Dialogue: 0,0:13:48.18,0:13:49.93,DCMain,BRO,0,0,0,,.بالطبع
Dialogue: 0,0:13:51.19,0:13:54.52,DCMain,BRO,0,0,0,,.والان نستطيع القول وداعاً للدين
Dialogue: 0,0:13:54.81,0:13:58.38,DCMain,SKINNY,0,0,0,,لكن, الن يقبض رجال الشرطة علينا ؟
Dialogue: 0,0:13:58.38,0:14:00.48,DCMain,BRO,0,0,0,,.سادع رجال الشرطه تاتي اليهم في اي يوم
Dialogue: 0,0:14:00.70,0:14:04.79,DCMain,BRO,0,0,0,,,واذا قتلنا الامرأه والاطفال
Dialogue: 0,0:14:04.79,0:14:07.24,DCMain,BRO,0,0,0,,.سوف لن يجدونا
Dialogue: 0,0:14:07.56,0:14:09.44,DCMain,MITSUHIKO,0,0,0,,.يوجد الكثير هنا
Dialogue: 0,0:14:09.44,0:14:11.02,DCMain,AYUMI,0,0,0,,.ان هذا جميل
Dialogue: 0,0:14:11.02,0:14:13.25,DCMain,CONAN,0,0,0,,.اجل, قد تنفع الفكره
Dialogue: 0,0:14:14.69,0:14:16.37,DCMain,GENTA,0,0,0,,ماذا عن هذا ياكونان ؟
Dialogue: 0,0:14:17.24,0:14:18.35,DCMain,CONAN,0,0,0,,.ليس سيئاً
Dialogue: 0,0:14:18.35,0:14:20.21,DCMain,MITSUHIKO,0,0,0,,.تبدو وسيماً اكثر من العاده
Dialogue: 0,0:14:20.79,0:14:21.85,DCMain,GENTA,0,0,0,,ماذا تقولين ؟
Dialogue: 0,0:14:21.85,0:14:24.14,DCMain,MITSUHIKO,0,0,0,,.انا امزح
Dialogue: 0,0:14:25.26,0:14:29.00,DCMain,MAKI,0,0,0,,كيف تكونون سعيدين في هكذا وقت ؟
Dialogue: 0,0:14:29.00,0:14:31.34,DCMain,AYUMI,0,0,0,,!لان كونان يوجد هنا
Dialogue: 0,0:14:31.85,0:14:34.85,DCMain,AYUMI,0,0,0,,.هو يتغلب على المصاعب مهما كانت سيئه
Dialogue: 0,0:14:40.44,0:14:41.90,DCMain,SKINNY,0,0,0,,..اخي
Dialogue: 0,0:14:41.90,0:14:43.86,DCMain,SKINNY,0,0,0,,هل سنقتل الاطفال حقاً ؟
Dialogue: 0,0:14:44.22,0:14:46.36,DCMain,SKINNY,0,0,0,,يجب ان نسئل " الرب" ؟
Dialogue: 0,0:14:47.42,0:14:49.11,DCMain,BRO,0,0,0,,لايوجد وقتً لهذا 
Dialogue: 0,0:14:49.54,0:14:50.99,DCMain,BRO,0,0,0,,....لقد شاهدوا وجوهنا
Dialogue: 0,0:14:50.99,0:14:52.37,DCMain,BRO,0,0,0,,!يجب ان نقتلهم
Dialogue: 0,0:15:03.90,0:15:06.25,DCMain,SKINNY,0,0,0,,!انها وحشيه
Dialogue: 0,0:15:07.24,0:15:09.38,DCMain,BRO,0,0,0,,!لاتهرب ايها الغبي
Dialogue: 0,0:15:10.42,0:15:11.54,DCMain,SKINNY,0,0,0,,!اخرس
Dialogue: 0,0:15:11.54,0:15:13.61,DCMain,SKINNY,0,0,0,,كل ماتفعله هو ان تامرني بطلباتك
Dialogue: 0,0:15:13.61,0:15:15.51,DCMain,SKINNY,0,0,0,,!لقد تعبت من هذا 
Dialogue: 0,0:15:16.38,0:15:20.14,DCMain,BRO,0,0,0,,ماذا قلت ايها اللعين ؟
Dialogue: 0,0:15:25.56,0:15:27.23,DCMain,BOTH,0,0,0,,.حسناً 
Dialogue: 0,0:15:29.85,0:15:31.11,DCMain,CONAN,0,0,0,,!دعونا نهرب الان
Dialogue: 0,0:15:38.83,0:15:40.22,DCMain,SKINNY,0,0,0,,ها ؟
Dialogue: 0,0:15:41.06,0:15:42.87,DCMain,SKINNY,0,0,0,,!لقد خدعوني 
Dialogue: 0,0:15:43.06,0:15:44.25,DCMain,SKINNY,0,0,0,,....ايها الاطفال الاشقياء
Dialogue: 0,0:15:49.21,0:15:50.58,DCMain,CONAN,0,0,0,,!ايومي
Dialogue: 0,0:15:53.47,0:15:54.47,DCMain,MITSUHIKO,0,0,0,,!امومي شان
Dialogue: 0,0:16:02.83,0:16:04.15,DCMain,GENTA,0,0,0,,!ايومي
Dialogue: 0,0:16:04.15,0:16:05.60,DCMain,AYUMI,0,0,0,,!جينتا كن
Dialogue: 0,0:16:06.49,0:16:07.32,DCMain,MITSUHIKO,0,0,0,,!كونان
Dialogue: 0,0:16:07.50,0:16:08.89,DCMain,CONAN,0,0,0,,....اه
Dialogue: 0,0:16:12.96,0:16:16.08,DCMain,BRO,0,0,0,,!لن تهرب هذه المره ايها الشقي
Dialogue: 0,0:16:25.45,0:16:26.83,DCMain,GENTA,0,0,0,,.اه
Dialogue: 0,0:16:27.24,0:16:29.88,DCMain,GENTA,0,0,0,,!انه هولاء الاشخاص مقرفون
Dialogue: 0,0:16:29.88,0:16:32.50,DCMain,BRO,0,0,0,,!!لم نغتسل منذ فتره
Dialogue: 0,0:16:32.77,0:16:34.22,DCMain,AYUMI,0,0,0,,..ياللاسف
Dialogue: 0,0:16:34.22,0:16:35.98,DCMain,AYUMI,0,0,0,,.يبدو ان هذا كان صعباً
Dialogue: 0,0:16:35.98,0:16:37.76,DCMain,SKINNY,0,0,0,,.لقد كان بالفعل
Dialogue: 0,0:16:40.56,0:16:43.98,DCMain,MAKI,0,0,0,,.سياتي رجال الشرطه قريباً
Dialogue: 0,0:16:45.30,0:16:47.20,DCMain,BRO,0,0,0,,.انتضر لحظه
Dialogue: 0,0:16:47.20,0:16:49.60,DCMain,BRO,0,0,0,,نحن لم نقتل احداً
Dialogue: 0,0:16:49.60,0:16:51.36,DCMain,AYUMI,0,0,0,,!لاتنفع الاعذار الان
Dialogue: 0,0:16:51.55,0:16:53.35,DCMain,SKINNY,0,0,0,,.ن نحن لانكذب
Dialogue: 0,0:16:53.35,0:16:57.13,DCMain,SKINNY,0,0,0,,.نحن كنا ندعي اننا قتلنا لكي نخيفكم
Dialogue: 0,0:16:57.13,0:16:58.74,DCMain,GENTA,0,0,0,,.لن تخدعونا بعد الان
Dialogue: 0,0:16:59.06,0:16:59.97,DCMain,MAKI,0,0,0,,ماذا ؟
Dialogue: 0,0:16:59.97,0:17:00.91,DCMain,MAKI,0,0,0,,اين الصبي الاخر ؟
Dialogue: 0,0:17:01.16,0:17:02.09,DCMain,AYUMI,0,0,0,,ماذا ؟
Dialogue: 0,0:17:02.09,0:17:03.09,DCMain,MITSUHIKO,0,0,0,,كونان ؟
Dialogue: 0,0:17:03.09,0:17:05.29,DCMain,GENTA,0,0,0,,.لقد كان هنا قبل دقيقه
Dialogue: 0,0:17:05.56,0:17:07.16,DCMain,AYUMI,0,0,0,,اين ذهب ؟
Dialogue: 0,0:17:12.85,0:17:13.86,DCMain,MAKI,0,0,0,,ماذا تفعل ؟
Dialogue: 0,0:17:13.86,0:17:14.59,DCMain,CONAN,0,0,0,,ماذا ؟
Dialogue: 0,0:17:19.73,0:17:22.21,DCMain,MAKI,0,0,0,,ماذا تفعل ياكونان ؟
Dialogue: 0,0:17:28.06,0:17:29.46,DCMain,CONAN,0,0,0,,....
Dialogue: 0,0:17:29.91,0:17:33.02,DCMain,CONAN,0,0,0,,!انت التي قتلتي زوجك
Dialogue: 0,0:17:33.32,0:17:34.32,DCMain,CONAN,0,0,0,,.ماكي سان
Dialogue: 0,0:17:36.51,0:17:37.41,DCMain,CONAN,0,0,0,,,وبالاصح
Dialogue: 0,0:17:37.41,0:17:41.60,DCMain,CONAN,0,0,0,,.الشخص الذي خطط للسرقه والجريمه ايضاً
Dialogue: 0,0:17:41.97,0:17:43.11,DCMain,CONAN,0,0,0,,"المزعوم ب "الرب
Dialogue: 0,0:17:44.15,0:17:46.15,DCMain,MAKI,0,0,0,,من اين تقول هذا  الكلام ؟
Dialogue: 0,0:17:46.15,0:17:48.08,DCMain,CONAN,0,0,0,,في ذاك الوقت
Dialogue: 0,0:17:48.49,0:17:53.32,DCMain,CONAN,0,0,0,,عندما اتى اسم "الرب" , لم يكن يدل على انهما من الاشخاص المتدينين
Dialogue: 0,0:17:53.79,0:17:56.42,DCItalic,BRO,0,0,0,,....شخصً ما يدعى "الرب" قال 
Dialogue: 0,0:17:56.42,0:17:59.63,DCItalic,BRO,0,0,0,,انه يوجد ذهبً هنا
Dialogue: 0,0:18:00.44,0:18:01.91,DCItalic,SKINNY,0,0,0,,.اخي
Dialogue: 0,0:18:01.91,0:18:04.20,DCItalic,SKINNY,0,0,0,,هل سنقتل هولاء الاطفال حقاً ؟
Dialogue: 0,0:18:04.20,0:18:06.28,DCItalic,SKINNY,0,0,0,,"يجي ان نسال "الرب
Dialogue: 0,0:18:06.15,0:18:16.32,God,TEXT,0,0,0,,.الرب 
Dialogue: 0,0:18:06.28,0:18:08.84,DCMain,CONAN,0,0,0,,....فلنفرض ان "الرب" الذي كانوا يشيرون اليه
Dialogue: 0,0:18:08.84,0:18:12.06,DCMain,CONAN,0,0,0,,.هو المسئول عن هذه الجريمه
Dialogue: 0,0:18:12.53,0:18:16.32,DCMain,CONAN,0,0,0,,.فالان تبدو كلها منطقيه
Dialogue: 0,0:18:16.32,0:18:20.83,God2,TEXT,0,0,0,,الرب
Dialogue: 0,0:18:16.57,0:18:20.02,DCMain,CONAN,0,0,0,,.كانوا يأمرون من قبل شخص اسمه الرب
Dialogue: 0,0:18:20.34,0:18:23.86,DCMain,CONAN,0,0,0,,وذا استرتب اللفظ للحرف الاتينيه
Dialogue: 0,0:18:24.18,0:18:25.87,DCMain,CONAN,0,0,0,,"ستجدها تصبح" ماكي
Dialogue: 0,0:18:26.33,0:18:29.33,DCMain,CONAN,0,0,0,,واسمكي هو ماكي سان
Dialogue: 0,0:18:29.73,0:18:34.12,DCMain,CONAN,0,0,0,,الناس في الغالب ترتب احرف اسمائها
Dialogue: 0,0:18:34.12,0:18:36.34,DCMain,CONAN,0,0,0,,وتعيد ترتيب الاحرف عندما يضعه اسمه على الانترنت
Dialogue: 0,0:18:36.65,0:18:38.84,DCMain,MAKI,0,0,0,,ان هذا  لايصدق
Dialogue: 0,0:18:39.10,0:18:42.10,DCMain,CONAN,0,0,0,,....اجل, لكن
Dialogue: 0,0:18:42.10,0:18:44.89,DCMain,CONAN,0,0,0,,...انت , ماكي سان, الوحيده 
Dialogue: 0,0:18:44.89,0:18:46.97,DCMain,CONAN,0,0,0,,.التي كانت قادره على قتل زوجها
Dialogue: 0,0:18:48.01,0:18:49.48,DCMain,MAKI,0,0,0,,ماذا تقصد ؟
Dialogue: 0,0:18:50.31,0:18:53.73,DCMain,CONAN,0,0,0,,.جثة زوجكي فقدت الكثير من الدم
Dialogue: 0,0:18:54.64,0:18:55.95,DCMain,CONAN,0,0,0,,...وبالنظر الى مظهره
Dialogue: 0,0:18:55.95,0:18:58.57,DCMain,CONAN,0,0,0,,.على الارجح ان القاتل تلطخ بالدماء ايضاً
Dialogue: 0,0:18:59.18,0:19:03.99,DCMain,CONAN,0,0,0,,.الى درجة انهو اضطر الى ان يغتسل ايضاً
Dialogue: 0,0:19:04.96,0:19:08.41,DCMain,CONAN,0,0,0,,.لكن لايبدو على كلاهما انهو يوجد عليها دم الضحيه
Dialogue: 0,0:19:08.76,0:19:11.67,DCMain,MAKI,0,0,0,,.لربما اغتسلا اذا
Dialogue: 0,0:19:12.45,0:19:13.41,DCMain,CONAN,0,0,0,,!هذا صحيح
Dialogue: 0,0:19:13.41,0:19:16.63,DCMain,CONAN,0,0,0,,انهما لم يغتسلا ماخراً
Dialogue: 0,0:19:16.94,0:19:20.63,DCMain,CONAN,0,0,0,,.وبطبيعه الحال, لم يغتسلا في الحمام ايضاً
Dialogue: 0,0:19:20.86,0:19:22.97,DCMain,CONAN,0,0,0,,...وحتى انهم اخطؤا بغرفه الاستحمام من الحمام
Dialogue: 0,0:19:23.76,0:19:27.14,DCMain,CONAN,0,0,0,,.ومن المحتمل انهم لم يدركوا اين هيه اصلاً
Dialogue: 0,0:19:27.69,0:19:30.94,DCMain,CONAN,0,0,0,,.وبعباره اخرى, ليس هناك سوى شخص واحد قد استحم هنا
Dialogue: 0,0:19:31.69,0:19:34.95,DCMain,MAKI,0,0,0,,.هذا لايثبت شيً
Dialogue: 0,0:19:34.95,0:19:37.08,DCMain,CONAN,0,0,0,,لم يكن دم الضحية قد ذهب الى جسدكي فحسب
Dialogue: 0,0:19:37.08,0:19:39.75,DCMain,CONAN,0,0,0,,بل ملابسكي التي كنت ترتدينها ايضاً
Dialogue: 0,0:19:40.39,0:19:42.33,DCMain,CONAN,0,0,0,,!لقد شعرت انها غريبه
Dialogue: 0,0:19:42.33,0:19:45.21,DCMain,CONAN,0,0,0,,ولم يكن سوى الثوب مبللً
Dialogue: 0,0:19:46.07,0:19:48.50,DCMain,CONAN,0,0,0,,ولقد غسلتي الدماء في عجله
Dialogue: 0,0:19:49.35,0:19:50.91,DCMain,CONAN,0,0,0,,.وانا متاكد من انكي تعرفين
Dialogue: 0,0:19:50.91,0:19:53.41,DCMain,CONAN,0,0,0,,....ومهما غسلتي شيئاً, فحص الدماء سيثبت
Dialogue: 0,0:19:53.41,0:19:54.65,DCMain,MAKI,0,0,0,,!هذا يكفي
Dialogue: 0,0:19:55.79,0:19:56.81,DCMain,MAKI,0,0,0,,!انت على حق
Dialogue: 0,0:19:56.81,0:19:59.30,DCMain,MAKI,0,0,0,,!لقد قتلته
Dialogue: 0,0:19:59.58,0:20:01.64,DCMain,MAKI,0,0,0,,.لقد كان يبذر في ثروته
Dialogue: 0,0:20:01.64,0:20:05.05,DCMain,MAKI,0,0,0,,!ولقد كان سيعطيني الورث من الالعاب
Dialogue: 0,0:20:10.65,0:20:13.79,DCMain,MAKI,0,0,0,,وكنت ساضع التهمه عليهما
Dialogue: 0,0:20:13.79,0:20:16.44,DCMain,MAKI,0,0,0,,عندما اتيا لسرقه البيت
Dialogue: 0,0:20:17.08,0:20:19.45,DCMain,MAKI,0,0,0,,في ذاك الوقت حددت لهم 
Dialogue: 0,0:20:19.74,0:20:22.40,DCMain,MAKI,0,0,0,,.اين سيجدون الذهب المزيف
Dialogue: 0,0:20:22.94,0:20:24.87,DCMain,MAKI,0,0,0,,!وكنت ساجعل الشرطي يعتقلهم
Dialogue: 0,0:20:24.87,0:20:27.66,DCMain,MAKI,0,0,0,,عندما يصل , فيما هما يضيعون الوقت
Dialogue: 0,0:20:28.05,0:20:29.32,DCMain,MAKI,0,0,0,,,وتحت هذه  الملابسات
Dialogue: 0,0:20:29.32,0:20:31.66,DCMain,MAKI,0,0,0,,,ستكون وكانما هما من قتلا زوجي
Dialogue: 0,0:20:31.66,0:20:34.11,DCMain,MAKI,0,0,0,,.وكاني انا الضحيه البائسه     
Dialogue: 0,0:20:36.21,0:20:38.06,DCMain,MAKI,0,0,0,,اليس هذا ماسيفكر به الاخرون ؟
Dialogue: 0,0:20:38.37,0:20:41.42,DCMain,MAKI,0,0,0,,وتغيرت الحاله بسبب هذا المطر الللعبن
Dialogue: 0,0:20:41.84,0:20:43.47,DCMain,MAKI,0,0,0,,.لكن لايهم
Dialogue: 0,0:20:46.63,0:20:48.97,DCMain,MAKI,0,0,0,,لانك ستموت ايضاً
Dialogue: 0,0:20:49.70,0:20:51.52,DCMain,MAKI,0,0,0,,على يد اللصوص 
Dialogue: 0,0:20:54.47,0:20:55.07,DCMain,GENTA,0,0,0,,ها ؟
Dialogue: 0,0:20:55.07,0:20:56.02,DCMain,GENTA,0,0,0,,كونان ؟
Dialogue: 0,0:20:56.02,0:20:57.10,DCMain,AYUMI,0,0,0,,كونان كو ؟
Dialogue: 0,0:20:57.24,0:20:58.23,DCMain,CONAN,0,0,0,, !اركضوا
Dialogue: 0,0:20:58.50,0:20:59.23,DCMain,ALL,0,0,0,,ماذا ؟
Dialogue: 0,0:21:01.43,0:21:02.34,DCMain,AYUMI,0,0,0,,ماكي سان ؟
Dialogue: 0,0:21:02.34,0:21:03.52,DCMain,GENTA,0,0,0,,ماذا يحدث ؟
Dialogue: 0,0:21:03.52,0:21:05.99,DCMain,MITSUHIKO,0,0,0,,!كونان في ورطه
Dialogue: 0,0:21:16.93,0:21:17.69,DCMain,CONAN,0,0,0,,!اغبياء 
Dialogue: 0,0:21:17.69,0:21:18.79,DCMain,CONAN,0,0,0,,!اهربوا
Dialogue: 0,0:21:23.00,0:21:25.51,DCMain,MAKI,0,0,0,,!سابداً بقتلك
Dialogue: 0,0:21:27.29,0:21:28.11,DCMain,CONAN,0,0,0,,!اللعنه
Dialogue: 0,0:21:28.11,0:21:28.80,DCMain,CONAN,0,0,0,,ها ليس جيداً
Dialogue: 0,0:21:34.67,0:21:35.14,DCItalic,CONAN,0,0,0,,حسناً
Dialogue: 0,0:21:37.61,0:21:38.77,DCMain,CONAN,0,0,0,,!!انطلقي
Dialogue: 0,0:21:42.09,0:21:43.11,DCMain,CONAN,0,0,0,,!ابتعدوا عن المكان
Dialogue: 0,0:23:23.34,0:23:26.09,DCMain,GENTA,0,0,0,,.لا اريد ان انظر الى الالعاب  مره اخرى
Dialogue: 0,0:23:26.23,0:23:27.45,DCMain,AYUMI,0,0,0,,.ولا انا حتى
Dialogue: 0,0:23:27.45,0:23:28.78,DCMain,MITSUHIKO,0,0,0,,.اجل
Dialogue: 0,0:23:30.11,0:23:31.68,DCMain,TAKAGI,0,0,0,,.احسنت يااطفال
Dialogue: 0,0:23:32.29,0:23:33.23,DCMain,TAKAGI,0,0,0,,مارئيكم ؟
Dialogue: 0,0:23:33.23,0:23:35.82,DCMain,TAKAGI,0,0,0,,.كمكافأه لكم, ساشتري لكم بعض الالعاب
Dialogue: 0,0:23:40.60,0:23:42.25,DCItalic,CONAN,0,0,0,,!!لانريد 
Dialogue: 0,0:23:44.94,0:24:08.96,DCEpPreview,TEXT,0,0,0,,
Dialogue: 0,0:23:45.63,0:23:47.82,DCMain,DETECTIVE,0,0,0,,كميشيما رايوجي سان - عمره 40 سنه
Dialogue: 0,0:23:48.14,0:23:51.36,DCMain,DETECTIVE,0,0,0,,الرئيس في المرتبه الثانيه لشركه تصنيه الغذاء
Dialogue: 0,0:23:52.01,0:23:55.41,DCMain,WOMAN,0,0,0,,لماذا مت وتركتني ؟
Dialogue: 0,0:23:55.95,0:23:57.28,DCMain,KOGORO,0,0,0,,ماذا تعني ؟
Dialogue: 0,0:23:57.76,0:24:00.58,DCMain,MAN,0,0,0,,رايوجي لايستطيع السباحه
Dialogue: 0,0:24:00.81,0:24:03.47,DCMain,KOGORO,0,0,0,,....لقد كانت جريمة بواسطه السكين
Dialogue: 0,0:24:03.47,0:24:04.96,DCMain,DETECTIVE,0,0,0,,موري سان ؟
Dialogue: 0,0:24:05.90,0:24:08.15,DCMain,KOGORO,0,0,0,,....هنالك شخصً اخر
Dialogue: 0,0:24:08.96,0:24:14.97,DCNextEp,TEXT,0,0,0,,.قضية عوده الامواج في المتنزه
Dialogue: 0,0:24:09.61,0:24:13.83,DCMain,CONAN,0,0,0,,.الحلقه القادمه من كونان, .قضية عوده الامواج في المتنزه
Dialogue: 0,0:24:29.98,0:24:34.99,Hint,TEXT,0,0,0,,.المد والجزر في الامواج
Dialogue: 0,0:24:30.19,0:24:32.70,DCMain,ALL,0,0,0,,تلميح للحلقه القادمه
Dialogue: 0,0:24:32.70,0:24:34.99,DCMain,CONAN,0,0,0,,!المد والجزر في الامواج
Dialogue: 0,0:24:34.99,0:24:36.57,DCMain,MITSUHIKO,0,0,0,,ايها المحقق تكاجي, اعطنا جائزه
Dialogue: 0,0:24:34.99,0:24:39.98,Don'tMiss,TEXT,0,0,0,,!لاتفوتوا الحلقه القادمه
Dialogue: 0,0:24:36.57,0:24:37.52,DCMain,AYUMI,0,0,0,,!لانريد العاب
Dialogue: 0,0:24:37.52,0:24:38.12,DCMain,GENTA,0,0,0,,!نريد سمكً مع الرز
Dialogue: 0,0:24:38.12,0:24:39.76,DCMain,CONAN,0,0,0,,!ا!نهم يمزحون
Dialogue: 0,0:24:39.76,0:24:41.76,DCMain,,0,0,0,,
