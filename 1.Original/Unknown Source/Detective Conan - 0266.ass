Dialogue: 0,0:15:15.28,0:15:17.69,Default,,0,0,0,,نيكاجي كن
Dialogue: 0,0:15:20.74,0:15:22.20,Default,,0,0,0,,طلقة بندقية ؟
Dialogue: 0,0:15:23.66,0:15:24.99,Default,,0,0,0,,أمر سيء
Dialogue: 0,0:15:26.24,0:15:28.70,Default,,0,0,0,,هل قتله قبلي ؟
Dialogue: 0,0:15:29.29,0:15:31.00,Default,,0,0,0,,من تكون ؟
Dialogue: 0,0:15:31.37,0:15:36.67,Default,,0,0,0,,أنا ؟ أنا مجرد ضيف على منزل ساتو
Dialogue: 0,0:15:36.67,0:15:37.59,Default,,0,0,0,,しゅくはく きゃく ロッジ 宿泊 客
Dialogue: 0,0:15:41.84,0:15:42.59,Default,,0,0,0,,اللعنة
Dialogue: 0,0:15:43.64,0:15:45.39,Default,,0,0,0,,أين أنت نيكاجي سان ؟
Dialogue: 0,0:15:49.02,0:15:50.43,Default,,0,0,0,,هيه سابورو
Dialogue: 0,0:15:52.06,0:15:53.48,Default,,0,0,0,,نيكاجي سان! ؟؟
Dialogue: 0,0:16:01.15,0:16:05.24,Default,,0,0,0,,لا فائدة لقد لفظ أنفاسه الأخيرة
Dialogue: 0,0:16:07.37,0:16:08.66,Default,,0,0,0,,ما هذا ؟
Dialogue: 0,0:16:12.29,0:16:13.29,Default,,0,0,0,,هذه ؟؟
Dialogue: 0,0:16:13.29,0:16:14.79,Default,,0,0,0,,شوكولاه
Dialogue: 0,0:16:16.13,0:16:19.25,Default,,0,0,0,,يوشتاكا.. أجبني رجاء
Dialogue: 0,0:16:20.30,0:16:23.05,Default,,0,0,0,,كارثة العاصفة تزداد قوة
Dialogue: 0,0:16:23.26,0:16:25.22,Default,,0,0,0,,ماذا عسانا نفعل ؟
Dialogue: 0,0:16:25.22,0:16:31.10,Default,,0,0,0,,إذا واصلنا البحث سنلقي بأيدينا إلى التهلكة
Dialogue: 0,0:16:31.14,0:16:34.27,Default,,0,0,0,,لكننا لا نقدر أن نترك نيكاجي في هذه العاصفة
Dialogue: 0,0:16:35.69,0:16:36.98,Default,,0,0,0,,كلب
Dialogue: 0,0:16:36.98,0:16:39.02,Default,,0,0,0,,إذا في عمق الجبال -
Dialogue: 0,0:16:39.03,0:16:40.57,Default,,0,0,0,,هل يعقل أنه سابورو
Dialogue: 0,0:16:40.57,0:16:44.24,Default,,0,0,0,,حمقاء! سابورو في المنتجع الآن
Dialogue: 0,0:16:45.45,0:16:47.03,Default,,0,0,0,,هل يعقل أن كونان ؟؟
Dialogue: 0,0:16:52.83,0:16:54.25,Default,,0,0,0,,كونان
Dialogue: 0,0:16:54.25,0:16:59.55,Default,,0,0,0,,ماذا تفعل هنا ؟ ألم أخبرك أن تبقى في المنتجع ؟
Dialogue: 0,0:16:59.55,0:17:01.21,Default,,0,0,0,,متأسف
Dialogue: 0,0:17:01.34,0:17:02.59,Default,,0,0,0,,إليك ما حدث
Dialogue: 0,0:17:02.59,0:17:12.31,Default,,0,0,0,,ألم تخبرنا ميكا سان أن سابورو وجد المالك السابق تحت الثلج ؟
Dialogue: 0,0:17:12.31,0:17:13.64,Default,,0,0,0,,أجل
Dialogue: 0,0:17:13.64,0:17:20.94,Default,,0,0,0,,لذا أعتقد أني أساعدكم بإيجاد نيكاجي بواسطة سابورو
Dialogue: 0,0:17:20.94,0:17:27.45,Default,,0,0,0,,نيكاجي سان أتى للمنتجع أكثر من مرة لذا فسابورو يعرف رائحته
Dialogue: 0,0:17:27.74,0:17:30.53,Default,,0,0,0,,إذا ، هل وجدت نيكاجي سان ؟
Dialogue: 0,0:17:31.08,0:17:33.20,Default,,0,0,0,,أجل وجدته
Dialogue: 0,0:17:34.58,0:17:36.42,Default,,0,0,0,,لكني تأخرت
Dialogue: 0,0:17:36.88,0:17:37.58,Default,,0,0,0,,ماذا ؟
Dialogue: 0,0:17:43.63,0:17:47.22,Default,,0,0,0,,مستحيل ، هذه كذبة... صح يوشتاكا
Dialogue: 0,0:17:47.22,0:17:48.47,Default,,0,0,0,,يوشتاكا
Dialogue: 0,0:17:48.47,0:17:49.60,Default,,0,0,0,,أبقي حيث أنت
Dialogue: 0,0:17:49.60,0:17:52.68,Default,,0,0,0,,أنظروا الدماء على الوجه
Dialogue: 0,0:17:52.68,0:17:57.35,Default,,0,0,0,,وهذه الخشبة المغطاة بالدم بجانبه
Dialogue: 0,0:17:57.35,0:17:59.06,Default,,0,0,0,,لا ريب في الأمر
Dialogue: 0,0:17:59.06,0:18:00.81,Default,,0,0,0,,إنها جريمة قتل
Dialogue: 0,0:18:00.82,0:18:05.65,Default,,0,0,0,,حتى نجد القاتل ، لا يجب أن نعبث بساحة الجريمة
Dialogue: 0,0:18:05.65,0:18:07.49,Default,,0,0,0,,آه قتل
Dialogue: 0,0:18:07.49,0:18:08.41,Default,,0,0,0,,معقول
Dialogue: 0,0:18:08.41,0:18:13.24,Default,,0,0,0,,تتصرف بتعجرف ، لست من الشرطة ؟؟؟
Dialogue: 0,0:18:13.24,0:18:20.75,Default,,0,0,0,,صحيح لست منهم لكني شرطي سابق أنا المتحري الشهير موري كوغورو
Dialogue: 0,0:18:21.84,0:18:23.67,Default,,0,0,0,,هل أنت موري ؟
Dialogue: 0,0:18:23.67,0:18:25.67,Default,,0,0,0,,المحقق
Dialogue: 0,0:18:25.92,0:18:29.47,Default,,0,0,0,,إذا من المجرم ، هل عرفته ؟
Dialogue: 0,0:18:29.47,0:18:30.43,Default,,0,0,0,,لا
Dialogue: 0,0:18:30.43,0:18:35.89,Default,,0,0,0,,بهذا الطقس السيء لن نعرف وقت الوفاة
Dialogue: 0,0:18:35.89,0:18:39.35,Default,,0,0,0,,كذلك بصمات المجرم أختفت بفعل الثلج
Dialogue: 0,0:18:39.35,0:18:45.82,Default,,0,0,0,,جل ما نستطيع فعله هو العثور على ملابس المجرم وعليها دماء نيكاجي
Dialogue: 0,0:18:45.82,0:18:50.86,Default,,0,0,0,,ويبدو أن نيكاجي توفي في المساء غالباً
Dialogue: 0,0:18:50.87,0:18:58.37,Default,,0,0,0,,دماء نيكاجي مسحت من هذه الجهة
Dialogue: 0,0:18:58.37,0:19:06.34,Default,,0,0,0,,ووضعه النظارات يدل على أنه قتل قبل غروب الشمس
Dialogue: 0,0:19:06.34,0:19:12.51,Default,,0,0,0,,بعد غروب الشمس من الخطر أن ترتدي نظارة شمسية لأن الظلام حالك
Dialogue: 0,0:19:12.51,0:19:13.72,Default,,0,0,0,,فهمت
Dialogue: 0,0:19:13.72,0:19:15.76,Default,,0,0,0,,متحر شهير بحق
Dialogue: 0,0:19:15.77,0:19:18.56,Default,,0,0,0,,هه ، هذا لا شيء
Dialogue: 0,0:19:18.56,0:19:20.89,Default,,0,0,0,,هذه إستنتاجات بسيطة لا تدل على قدري
Dialogue: 0,0:19:20.90,0:19:22.94,Default,,0,0,0,,هل أنت واثق ؟
Dialogue: 0,0:19:22.94,0:19:24.90,Default,,0,0,0,,الرحمة.. الصغير ثانية!! ؟
Dialogue: 0,0:19:24.90,0:19:28.57,Default,,0,0,0,,يجب أن تمعن النظر في النظارة الشمسية
Dialogue: 0,0:19:29.40,0:19:32.41,Default,,0,0,0,,ستجد أن العدسة متحركة من مكانها
Dialogue: 0,0:19:32.41,0:19:36.45,Default,,0,0,0,,أخرق لابد أنها تحركت بفعل الضربة
Dialogue: 0,0:19:36.45,0:19:41.92,Default,,0,0,0,,لكن لا توجد عدسة لاصقة على العين اليمنى ولا على النظارة كذلك ؟؟
Dialogue: 0,0:19:42.63,0:19:44.25,Default,,0,0,0,,أنت محق
Dialogue: 0,0:19:44.25,0:19:45.59,Default,,0,0,0,,فهمت
Dialogue: 0,0:19:45.59,0:19:49.42,Default,,0,0,0,,عندما ضرب سقطت العدسة اللاصقة والنظارة الشمسية كذلك
Dialogue: 0,0:19:49.42,0:19:53.22,Default,,0,0,0,,لكن المجرم لم يلتفت للعدسات وأعاد النظارة فقط
Dialogue: 0,0:19:53.80,0:19:57.51,Default,,0,0,0,,فهمت لابد أنه تصرف المجرم
Dialogue: 0,0:19:57.64,0:19:59.89,Default,,0,0,0,,هي لا تسيء فهمي
Dialogue: 0,0:20:00.10,0:20:03.90,Default,,0,0,0,,ألا يعقل أن المجرم فعل ذلك متعمداً ؟
Dialogue: 0,0:20:04.86,0:20:06.61,Default,,0,0,0,,أجل أجل
Dialogue: 0,0:20:06.61,0:20:09.57,Default,,0,0,0,,ما الغاية من هذا الفعل ؟
Dialogue: 0,0:20:09.57,0:20:12.53,Default,,0,0,0,,أجل.. وجدت شيئا غريبا آخر
Dialogue: 0,0:20:13.07,0:20:14.95,Default,,0,0,0,,إنها الشوكولاه
Dialogue: 0,0:20:15.33,0:20:18.49,Default,,0,0,0,,كانت في حضن الضحية
Dialogue: 0,0:20:19.50,0:20:22.25,Default,,0,0,0,,كتب ( يوشي ) على الشوكولاه
Dialogue: 0,0:20:22.83,0:20:23.29,Default,,0,0,0,,ماذا ؟
Dialogue: 0,0:20:23.29,0:20:26.96,Default,,0,0,0,,مهلا هذه الشوكولاه صنعتها أكو ] اليوم ؟
Dialogue: 0,0:20:26.96,0:20:30.76,Default,,0,0,0,,لماذا شوكولاي هنا ؟؟
Dialogue: 0,0:20:31.80,0:20:34.76,Default,,0,0,0,,ألم تضعيها بجانب الجثة ؟
Dialogue: 0,0:20:34.76,0:20:40.81,Default,,0,0,0,,مستحيل أن تفعلها | أكو سان ] فلقد ترك الجميع الشوكولاه في المنتجع
Dialogue: 0,0:20:40.81,0:20:45.19,Default,,0,0,0,,وقبل ذلك كانت أكوا معنا
Dialogue: 0,0:20:45.69,0:20:48.90,Default,,0,0,0,,إذا من جلب الشوكولاه إلى هنا ؟
Dialogue: 0,0:20:48.90,0:20:51.11,Default,,0,0,0,,على الأغلب المجرم نفسه
Dialogue: 0,0:20:51.11,0:20:54.15,Default,,0,0,0,,لأنه يعرف أننا سنسأل عن الوقت
Dialogue: 0,0:20:54.16,0:20:59.91,Default,,0,0,0,,لذا وضع الشوكولاه ليتهم أكو
Dialogue: 0,0:21:00.45,0:21:04.50,Default,,0,0,0,,الآن لنعد إلى المنتجع و لنتصل بالشرطة
Dialogue: 0,0:21:04.50,0:21:07.42,Default,,0,0,0,,الشرطة ستكون عاجزة عن القدوم لفترة
Dialogue: 0,0:21:08.54,0:21:11.51,Default,,0,0,0,,ساجامي سان كيف عرفت أننا هنا ؟؟
Dialogue: 0,0:21:12.01,0:21:14.63,Default,,0,0,0,,لقد تتبعت صوت نباح الكلب
Dialogue: 0,0:21:14.63,0:21:19.14,Default,,0,0,0,,قلت أن الشرطة عاجزة عن القدوم ، لماذا ؟
Dialogue: 0,0:21:19.14,0:21:28.06,Default,,0,0,0,,النفق المؤدي للشارع الموصل للمنتجع أغلقته الانهيارات الثلجية قبل ٣٠ دقيقة
Dialogue: 0,0:21:28.73,0:21:32.57,Default,,0,0,0,,سيحتاجون ليوم على الأقل لفتحه
Dialogue: 0,0:21:32.57,0:21:33.61,Default,,0,0,0,,معقول!! ؟
Dialogue: 0,0:21:33.61,0:21:34.36,Default,,0,0,0,,هل أنت جاد ؟
Dialogue: 0,0:21:34.70,0:21:40.45,Default,,0,0,0,,هل تعني أننا سنقضي الليلة في المنتجع والمجرم حر طليق يحوم حولنا ؟
Dialogue: 0,0:21:40.49,0:21:45.54,Default,,0,0,0,,ربما يكون قاتل نيكاجي واحد منا
Dialogue: 0,0:21:47.29,0:21:49.71,Default,,0,0,0,,لا مشكلة لدي
Dialogue: 0,0:21:49.71,0:21:52.09,Default,,0,0,0,,ستكون ليلة مرعبة أكثر
Dialogue: 0,0:21:52.76,0:21:59.22,Default,,0,0,0,,إذا لم تأتوا معنا يمكنك البقاء بقرب الجثة طوال الليلة
Dialogue: 0,0:22:00.22,0:22:05.39,Default,,0,0,0,,لكن بحلول الصباح ستكونون متجمدين كسيدة الثلج
Dialogue: 0,0:22:14.65,0:22:17.36,Default,,0,0,0,,النظارة التي أعيدت لمكانها
Dialogue: 0,0:22:19.20,0:22:22.41,Default,,0,0,0,,و شوكولاه [ أكو سان ]
Dialogue: 0,0:22:23.37,0:22:28.58,Default,,0,0,0,,لماذا تكبد المجرم عبء إحضار شوكولاه [ أكوسان من المنتجع
Dialogue: 0,0:22:30.46,0:22:33.21,Default,,0,0,0,,لو أعرف لماذا ؟
Dialogue: 0,0:22:33.30,0:22:36.17,Default,,0,0,0,,wow i a ترجمة أبوعلي حسن محمد
Dialogue: 0,0:22:37.22,0:22:38.05,Default,,0,0,0,,朝 が 来る たび 君 の こと を 想う أفكر فيك كل يوم عند إستيقاظي من النوم
Dialogue: 0,0:22:42.56,0:22:48.14,Default,,0,0,0,,ただ 傍 に いれ ば 幸せ だっ た عندما تكون جنبي أكون سعيدا
Dialogue: 0,0:22:48.77,0:22:49.39,Default,,0,0,0,,時 が 経つ こと に 怯え て 泣い て た كنت أبكي لأني أخاف من مضي الوقت
Dialogue: 0,0:22:54.90,0:22:55.15,Default,,0,0,0,,كنت أبكي لأني أخاف من مضي الوقت
Dialogue: 0,0:22:55.15,0:22:56.78,Default,,0,0,0,,変わり ゆく 人 の 心 に وأخاف من تغير القلوب
Dialogue: 0,0:23:09.04,0:23:13.71,Default,,0,0,0,,望ま なけれ ば 失わ ない のに 、 حتى لو أعتقدت أني لا أريدك ، لن أتركك
Dialogue: 0,0:23:15.55,0:23:17.26,Default,,0,0,0,,求め ず に はい られ ない よ لو لم أحتاجك لم أطلبك إذاً
Dialogue: 0,0:23:20.76,0:23:24.22,Default,,0,0,0,,どんな 未来 が この 先 に あっ て も لا يهمني سأنتظرك مهما كان المستقبل
Dialogue: 0,0:23:28.73,0:23:29.60,Default,,0,0,0,,ユメヲミタアトデ 君 は まだ 遠く て حتى بعد الحلم مازالت بعيداً
Dialogue: 0,0:23:35.19,0:23:36.15,Default,,0,0,0,,気持ち だけ 先走っ て 空回り من غير المجدي تتحرك بمشاعرك فقط
Dialogue: 0,0:23:40.49,0:23:40.74,Default,,0,0,0,,من غير المجدي تتحرك بمشاعرك فقد
Dialogue: 0,0:23:40.78,0:23:41.36,Default,,0,0,0,,花 の 雨 が 降る この 道 は 変わら ず الأزهار تسقط كالمطر ، وهذا الطريق لن يتغير
Dialogue: 0,0:23:48.37,0:23:52.46,Default,,0,0,0,,腕 を 絡め 歩き たい な أريد أن نمشي يداً بيد
