Dialogue: 0,0:00:20.24,0:00:22.24,Default,,0,0,0,,‫قلبٌ قوي… مع استنتاجٍ وقوة.
Dialogue: 0,0:00:22.24,0:00:24.24,Default,,0,0,0,,‫ويخوض إلى جوهر الحقيقة بإيقاعٍ ثابت.
Dialogue: 0,0:00:24.24,0:00:26.04,Default,,0,0,0,,‫اليوم نسير ببطء على طريقٍ جبلي.
Dialogue: 0,0:00:26.04,0:00:28.04,Default,,0,0,0,,‫وفي قاع الوادي… تفوح رائحة جريمة.
Dialogue: 0,0:00:28.04,0:00:29.54,Default,,0,0,0,,‫يرى الحقيقة الوحيدة.
Dialogue: 0,0:00:29.54,0:00:31.54,Default,,0,0,0,,‫طفلٌ في المظهر… بعقلِ راشد.\N‫\N‫7\N‫00:00:00:31,541 --> 00:00:33,940\N‫اسمه: المحقق كونان.
Dialogue: 0,0:01:56.59,0:02:00.39,Default,,0,0,0,,‫"جبل ريوجين في مقاطعة غرب تاما"
Dialogue: 0,0:02:00.59,0:02:04.39,Default,,0,0,0,,‫"ممر تسوزورا أوري"
Dialogue: 0,0:02:05.59,0:02:07.69,Default,,0,0,0,,‫يا له من طريقٍ شاق!
Dialogue: 0,0:02:07.69,0:02:10.19,Default,,0,0,0,,‫لقد صعدنا كثيرًا.
Dialogue: 0,0:02:10.19,0:02:12.39,Default,,0,0,0,,‫وما زال أمامنا طريق طويل.
Dialogue: 0,0:02:12.39,0:02:14.99,Default,,0,0,0,,‫لم نصل إلا لنصف الطريق تقريبًا.
Dialogue: 0,0:02:14.99,0:02:17.99,Default,,0,0,0,,‫لا… مستحيل!
Dialogue: 0,0:02:17.99,0:02:19.69,Default,,0,0,0,,‫ما بك؟
Dialogue: 0,0:02:19.69,0:02:21.29,Default,,0,0,0,,‫يا رجل…
Dialogue: 0,0:02:21.29,0:02:23.99,Default,,0,0,0,,‫من كثرة اليمين واليسار…
Dialogue: 0,0:02:23.99,0:02:25.99,Default,,0,0,0,,‫رأسي يدور.
Dialogue: 0,0:02:25.99,0:02:27.99,Default,,0,0,0,,‫هيا… يا ضعيف!
Dialogue: 0,0:02:29.69,0:02:33.09,Default,,0,0,0,,‫هذا المكان اسمه ممر تسوزورا أوري،
Dialogue: 0,0:02:33.09,0:02:37.09,Default,,0,0,0,,‫وفيه 99 منعطفًا… كبيرًا وصغيرًا.
Dialogue: 0,0:02:38.39,0:02:42.19,Default,,0,0,0,,‫يكفيني سماع ذلك حتى أشعر بالغثيان.
Dialogue: 0,0:02:42.19,0:02:45.09,Default,,0,0,0,,‫أين ميتسوهيكو؟
Dialogue: 0,0:02:45.09,0:02:48.59,Default,,0,0,0,,‫ميتسوهيكو يقرأ كتابًا في السيارة.
Dialogue: 0,0:02:48.59,0:02:50.49,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:02:50.49,0:02:52.19,Default,,0,0,0,,‫ميتسوهيكو!
Dialogue: 0,0:02:52.19,0:02:54.89,Default,,0,0,0,,‫الجو رائع هنا!
Dialogue: 0,0:02:54.89,0:02:58.49,Default,,0,0,0,,‫لا شكرًا… وصلت لأفضل جزء الآن!
Dialogue: 0,0:03:00.19,0:03:03.89,Default,,0,0,0,,‫دكتور أغاسا… آي لم تأتِ معنا مرة أخرى؟
Dialogue: 0,0:03:05.79,0:03:09.39,Default,,0,0,0,,‫قالت إن لديها شيئًا تفعله.
Dialogue: 0,0:03:11.29,0:03:13.49,Default,,0,0,0,,‫دكتور أغاسا… أراهن أنها قالت…
Dialogue: 0,0:03:13.49,0:03:14.89,Default,,0,0,0,,‫"لا يهمني التخييم."
Dialogue: 0,0:03:14.89,0:03:20.49,Default,,0,0,0,,‫"أنا لست مهتمة بالتخييم."
Dialogue: 0,0:03:20.49,0:03:23.99,Default,,0,0,0,,‫أحسنت يا غينتا! كأنها هي فعلًا.
Dialogue: 0,0:03:23.99,0:03:25.39,Default,,0,0,0,,‫أصبت الهدف.
Dialogue: 0,0:03:27.49,0:03:28.49,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:03:35.89,0:03:36.89,Default,,0,0,0,,‫لاا!
Dialogue: 0,0:03:36.89,0:03:38.79,Default,,0,0,0,,‫دكتور أغاسا! اتصل بالشرطة والإسعاف!
Dialogue: 0,0:03:38.79,0:03:39.99,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:03:50.99,0:03:56.39,Default,,0,0,0,,‫"سقوطٌ كبير من جبل ريوجين"
Dialogue: 0,0:03:58.49,0:04:02.09,Default,,0,0,0,,‫قلت إنك كنت تستريح عند نقطة المشاهدة،
Dialogue: 0,0:04:02.09,0:04:04.49,Default,,0,0,0,,‫وشاهدت السيارة تسقط من الجرف،
Dialogue: 0,0:04:04.49,0:04:07.59,Default,,0,0,0,,‫فجريت إلى هنا، صحيح؟ -نعم.
Dialogue: 0,0:04:08.99,0:04:10.29,Default,,0,0,0,,‫ذلك الانبعاج؟
Dialogue: 0,0:04:11.09,0:04:12.69,Default,,0,0,0,,‫إذاً…
Dialogue: 0,0:04:12.69,0:04:14.89,Default,,0,0,0,,‫سأسألك مرة أخرى…
Dialogue: 0,0:04:14.89,0:04:18.49,Default,,0,0,0,,‫هل لاحظت شيئًا مريبًا آخر؟ سيارة أو شخص؟
Dialogue: 0,0:04:18.49,0:04:21.29,Default,,0,0,0,,‫لا… لم أرَ شيئًا أبدًا.
Dialogue: 0,0:04:21.29,0:04:23.39,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:04:23.39,0:04:25.59,Default,,0,0,0,,‫هذا كل شيء.
Dialogue: 0,0:04:25.59,0:04:27.39,Default,,0,0,0,,‫أيها الشرطي.
Dialogue: 0,0:04:28.39,0:04:29.89,Default,,0,0,0,,‫ماذا يا صغيري؟
Dialogue: 0,0:04:29.89,0:04:33.49,Default,,0,0,0,,‫هل يمكنني الذهاب لأرى ما يفعله الرجال هناك بالأعلى؟
Dialogue: 0,0:04:33.49,0:04:36.19,Default,,0,0,0,,‫لا لا… هذا ليس شيئًا لطفلٍ ليراه!
Dialogue: 0,0:04:36.19,0:04:39.19,Default,,0,0,0,,‫أظنهم أوشكوا على الانتهاء هناك.
Dialogue: 0,0:04:39.19,0:04:40.59,Default,,0,0,0,,‫لا بأس.
Dialogue: 0,0:04:40.59,0:04:42.39,Default,,0,0,0,,‫لكن…
Dialogue: 0,0:04:42.39,0:04:43.59,Default,,0,0,0,,‫اسمع يا صغيري،
Dialogue: 0,0:04:43.59,0:04:47.79,Default,,0,0,0,,‫لا تعق عملهم وأنت تراقبهم.
Dialogue: 0,0:04:47.79,0:04:50.09,Default,,0,0,0,,‫نعم، سيدي!
Dialogue: 0,0:04:53.69,0:04:55.39,Default,,0,0,0,,‫هيه، ميتسوهيكو،
Dialogue: 0,0:04:55.39,0:04:57.59,Default,,0,0,0,,‫ألا يجب أن نذهب نحن أيضًا؟
Dialogue: 0,0:04:58.59,0:05:01.99,Default,,0,0,0,,‫كونان سيذهب وحده كعادته، أتعرف؟
Dialogue: 0,0:05:01.99,0:05:03.89,Default,,0,0,0,,‫ومن يهتم؟
Dialogue: 0,0:05:03.89,0:05:05.79,Default,,0,0,0,,‫دعه يفعل ما يشاء.
Dialogue: 0,0:05:05.79,0:05:09.29,Default,,0,0,0,,‫لدينا شيء أفضل هنا.
Dialogue: 0,0:05:09.29,0:05:11.49,Default,,0,0,0,,‫شيء أفضل؟
Dialogue: 0,0:05:18.89,0:05:20.29,Default,,0,0,0,,‫حسنًا… هنا!
Dialogue: 0,0:05:20.29,0:05:21.79,Default,,0,0,0,,‫تمام!
Dialogue: 0,0:05:21.79,0:05:25.69,Default,,0,0,0,,‫16.33 مترًا.
Dialogue: 0,0:05:25.69,0:05:27.59,Default,,0,0,0,,‫16.33…
Dialogue: 0,0:05:27.59,0:05:29.19,Default,,0,0,0,,‫ها هي!
Dialogue: 0,0:05:29.19,0:05:30.79,Default,,0,0,0,,‫إنها قطعة طلاءٍ احتكت وسقطت!
Dialogue: 0,0:05:30.79,0:05:32.79,Default,,0,0,0,,‫حقًا؟
Dialogue: 0,0:05:35.09,0:05:37.69,Default,,0,0,0,,‫انظر… لونها أزرق داكن!
Dialogue: 0,0:05:37.69,0:05:39.09,Default,,0,0,0,,‫أزرق داكن…
Dialogue: 0,0:05:39.09,0:05:40.49,Default,,0,0,0,,‫يعني…
Dialogue: 0,0:05:40.49,0:05:41.89,Default,,0,0,0,,‫نعم!
Dialogue: 0,0:05:43.69,0:05:45.49,Default,,0,0,0,,‫إذن هذا ما حصل.
Dialogue: 0,0:05:47.49,0:05:50.69,Default,,0,0,0,,‫جئنا للنزهة…
Dialogue: 0,0:05:50.69,0:05:53.49,Default,,0,0,0,,‫ونتورط بحادثٍ كهذا.
Dialogue: 0,0:05:53.49,0:05:55.39,Default,,0,0,0,,‫ليس حادثًا.
Dialogue: 0,0:05:56.59,0:05:58.89,Default,,0,0,0,,‫ماذا تقصد ليس حادثًا؟
Dialogue: 0,0:05:58.89,0:06:04.09,Default,,0,0,0,,‫الشرطي سأل الرجل إن كان رأى سيارات أخرى، صحيح؟
Dialogue: 0,0:06:04.09,0:06:05.39,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:06:05.39,0:06:10.39,Default,,0,0,0,,‫السيارة سقطت لأنها دُفعت من الخلف بسيارة أخرى.
Dialogue: 0,0:06:10.39,0:06:11.39,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:06:11.39,0:06:12.99,Default,,0,0,0,,‫كان هناك انبعاج في الخلف،
Dialogue: 0,0:06:12.99,0:06:15.99,Default,,0,0,0,,‫دليل على أنها اصطُدمت من الخلف.
Dialogue: 0,0:06:15.99,0:06:17.89,Default,,0,0,0,,‫وفوق ذلك… وجدنا طلاءً
Dialogue: 0,0:06:17.89,0:06:21.49,Default,,0,0,0,,‫يبدو أنه احتك من السيارة الأخرى.
Dialogue: 0,0:06:21.49,0:06:22.49,Default,,0,0,0,,‫بل أكثر من ذلك…
Dialogue: 0,0:06:22.49,0:06:26.29,Default,,0,0,0,,‫السيارة التي اصطدمت من الخلف فعلت ذلك عمدًا على الأرجح.
Dialogue: 0,0:06:26.29,0:06:29.19,Default,,0,0,0,,‫إذن… جريمة قتل؟
Dialogue: 0,0:06:29.19,0:06:30.69,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:06:30.69,0:06:33.89,Default,,0,0,0,,‫ألا يجب أن نساعد الشرطة؟
Dialogue: 0,0:06:33.89,0:06:37.39,Default,,0,0,0,,‫لا بأس… لديهم أدلة كثيرة.
Dialogue: 0,0:06:37.39,0:06:41.99,Default,,0,0,0,,‫لكن كل ما لديهم طلاءٌ وانبعاج فقط.
Dialogue: 0,0:06:41.99,0:06:45.49,Default,,0,0,0,,‫الشرطة اليابانية عادةً فعّالة جدًا.
Dialogue: 0,0:06:45.49,0:06:47.39,Default,,0,0,0,,‫إذا وجدوا قطعة طلاء،
Dialogue: 0,0:06:47.39,0:06:50.39,Default,,0,0,0,,‫فمن اللون والمادة يعرفون طراز السيارة أيضًا.
Dialogue: 0,0:06:50.39,0:06:52.59,Default,,0,0,0,,‫ثم يسألون الناس…
Dialogue: 0,0:06:52.59,0:06:54.39,Default,,0,0,0,,‫حتى يصلوا للجاني.
Dialogue: 0,0:06:54.89,0:06:57.09,Default,,0,0,0,,‫فهمت…
Dialogue: 0,0:06:58.89,0:07:00.09,Default,,0,0,0,,‫ميتسوهيكو…
Dialogue: 0,0:07:00.09,0:07:01.49,Default,,0,0,0,,‫ما قصدك بـ "شيء أفضل"؟
Dialogue: 0,0:07:02.09,0:07:05.89,Default,,0,0,0,,‫اسكت… سيسمعنا كونان.
Dialogue: 0,0:07:10.29,0:07:12.79,Default,,0,0,0,,‫ها هو يا غينتا.
Dialogue: 0,0:07:13.79,0:07:15.29,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:07:15.29,0:07:16.69,Default,,0,0,0,,‫إنها شِفرة.
Dialogue: 0,0:07:16.69,0:07:17.69,Default,,0,0,0,,‫شفرة؟
Dialogue: 0,0:07:21.09,0:07:25.09,Default,,0,0,0,,‫التقطتها قرب مكان الحادث قبل قليل.
Dialogue: 0,0:07:25.99,0:07:29.39,Default,,0,0,0,,‫إذن كان يجب أن تخبر الشرطة بها.
Dialogue: 0,0:07:29.39,0:07:32.59,Default,,0,0,0,,‫لكن ما رأيناه كان حادثًا فقط، أليس كذلك؟
Dialogue: 0,0:07:32.59,0:07:36.09,Default,,0,0,0,,‫يصعب تصديق أن للشفرة علاقة بذلك.
Dialogue: 0,0:07:36.09,0:07:37.29,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:07:37.29,0:07:40.09,Default,,0,0,0,,‫الشفرة عادةً تُستخدم لمعرفة
Dialogue: 0,0:07:40.09,0:07:41.59,Default,,0,0,0,,‫مكان إخفاء الكنوز، صحيح؟
Dialogue: 0,0:07:41.59,0:07:43.49,Default,,0,0,0,,‫بالضبط!
Dialogue: 0,0:07:43.49,0:07:45.79,Default,,0,0,0,,‫كنز…
Dialogue: 0,0:07:45.79,0:07:48.49,Default,,0,0,0,,‫إذن انظروا جيدًا!
Dialogue: 0,0:07:48.49,0:07:53.19,Default,,0,0,0,,‫في الأعلى داخل المربع مكتوب: "100 ناقص 1".
Dialogue: 0,0:07:53.19,0:07:55.69,Default,,0,0,0,,‫حسنًا يا غينتا… كم يساوي 100 ناقص 1؟
Dialogue: 0,0:07:56.69,0:07:59.19,Default,,0,0,0,,‫تسعة…
Dialogue: 0,0:07:59.19,0:08:00.99,Default,,0,0,0,,‫تسعة وتسعون؟
Dialogue: 0,0:08:00.99,0:08:02.69,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:08:03.79,0:08:06.09,Default,,0,0,0,,‫هل يخطر ببالك شيء
Dialogue: 0,0:08:06.09,0:08:08.29,Default,,0,0,0,,‫عندما تسمع الرقم 99؟
Dialogue: 0,0:08:09.29,0:08:12.09,Default,,0,0,0,,‫99…
Dialogue: 0,0:08:12.09,0:08:14.19,Default,,0,0,0,,‫تسع…
Dialogue: 0,0:08:14.19,0:08:15.39,Default,,0,0,0,,‫911… الإسعاف!
Dialogue: 0,0:08:15.39,0:08:17.09,Default,,0,0,0,,‫لا.
Dialogue: 0,0:08:18.09,0:08:22.69,Default,,0,0,0,,‫من أين جاءتك فكرة 911 الآن؟
Dialogue: 0,0:08:22.69,0:08:24.69,Default,,0,0,0,,‫ضماد إسعاف أولي إذن؟
Dialogue: 0,0:08:24.69,0:08:26.49,Default,,0,0,0,,‫عرفت!
Dialogue: 0,0:08:26.49,0:08:28.39,Default,,0,0,0,,‫إنه ممر تسوزورا أوري، صحيح؟
Dialogue: 0,0:08:28.39,0:08:29.59,Default,,0,0,0,,‫الدكتور أغاسا شرح للتو
Dialogue: 0,0:08:29.59,0:08:32.89,Default,,0,0,0,,‫أن فيه 99 منعطفًا، أليس كذلك؟
Dialogue: 0,0:08:32.89,0:08:34.79,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:08:34.79,0:08:36.39,Default,,0,0,0,,‫يعني أن هذه الشفرة تشير
Dialogue: 0,0:08:36.39,0:08:40.39,Default,,0,0,0,,‫إلى مكانٍ ما داخل منطقة الممر.
Dialogue: 0,0:08:40.39,0:08:43.09,Default,,0,0,0,,‫وهل عرفت أين هو يا ميتسوهيكو؟
Dialogue: 0,0:08:43.09,0:08:47.69,Default,,0,0,0,,‫لا… لكن هذه الشفرة تبدو مألوفة جدًا.
Dialogue: 0,0:08:47.69,0:08:49.89,Default,,0,0,0,,‫أين رأيتها يا ميتسوهيكو؟
Dialogue: 0,0:08:51.69,0:08:53.29,Default,,0,0,0,,‫هيه أنتم!
Dialogue: 0,0:08:54.29,0:08:57.09,Default,,0,0,0,,‫ما كل هذه الجلبة؟
Dialogue: 0,0:08:57.09,0:08:58.49,Default,,0,0,0,,‫لا شيء!
Dialogue: 0,0:08:58.49,0:09:01.29,Default,,0,0,0,,‫نعم نعم… لا نتحدث عن أي شفرات!
Dialogue: 0,0:09:01.29,0:09:02.39,Default,,0,0,0,,‫شفرات؟
Dialogue: 0,0:09:02.39,0:09:06.49,Default,,0,0,0,,‫آه… رواية كنت أقرأها…
Dialogue: 0,0:09:06.49,0:09:07.89,Default,,0,0,0,,‫وكانت فيها شفرات…
Dialogue: 0,0:09:07.89,0:09:11.69,Default,,0,0,0,,‫سهلة عليك يا كونان، لذا…
Dialogue: 0,0:09:11.69,0:09:14.59,Default,,0,0,0,,‫هاه… إذن لعب أطفال.
Dialogue: 0,0:09:17.79,0:09:19.19,Default,,0,0,0,,‫عرفت.
Dialogue: 0,0:09:23.99,0:09:25.19,Default,,0,0,0,,‫حسنًا يا جماعة…
Dialogue: 0,0:09:25.19,0:09:27.59,Default,,0,0,0,,‫أنا والدكتور أغاسا سنذهب للصيد،
Dialogue: 0,0:09:27.59,0:09:29.19,Default,,0,0,0,,‫ولا تنسوا تقطيع الحطب.
Dialogue: 0,0:09:29.19,0:09:30.99,Default,,0,0,0,,‫حسنًا…
Dialogue: 0,0:09:30.99,0:09:32.29,Default,,0,0,0,,‫وداعًا.
Dialogue: 0,0:09:34.49,0:09:36.69,Default,,0,0,0,,‫انطلقنا!
Dialogue: 0,0:09:36.69,0:09:39.59,Default,,0,0,0,,‫ميتسوهيكو… هل فككتها فعلًا؟
Dialogue: 0,0:09:39.59,0:09:41.89,Default,,0,0,0,,‫كانت في الكتاب الذي أقرأه!
Dialogue: 0,0:09:41.89,0:09:43.29,Default,,0,0,0,,‫حقًا؟
Dialogue: 0,0:09:43.29,0:09:45.39,Default,,0,0,0,,‫هذه!
Dialogue: 0,0:09:45.39,0:09:47.09,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:09:47.09,0:09:49.19,Default,,0,0,0,,‫لوحة مفاتيح كمبيوتر؟
Dialogue: 0,0:09:49.19,0:09:50.59,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:09:50.59,0:09:53.09,Default,,0,0,0,,‫الأرقام مرتبة من أعلى اليسار،
Dialogue: 0,0:09:53.09,0:09:57.09,Default,,0,0,0,,‫وتطابق أزرار الهيراغانا نفسها!
Dialogue: 0,0:09:57.09,0:09:59.39,Default,,0,0,0,,‫مثلًا: 1 و4 تساوي "تا".
Dialogue: 0,0:09:59.39,0:10:02.39,Default,,0,0,0,,‫و2 و7 تساوي "تو"، وهكذا…
Dialogue: 0,0:10:02.39,0:10:03.39,Default,,0,0,0,,‫رائع!
Dialogue: 0,0:10:03.39,0:10:05.49,Default,,0,0,0,,‫لنجرّب!
Dialogue: 0,0:10:05.49,0:10:08.99,Default,,0,0,0,,‫غينتا… اقرأ أرقام الشفرة.
Dialogue: 0,0:10:08.99,0:10:10.59,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:10:10.59,0:10:13.89,Default,,0,0,0,,‫0 و4، 2 و3، 3 و8.
Dialogue: 0,0:10:13.89,0:10:15.79,Default,,0,0,0,,‫0 و4 تساوي "أو".
Dialogue: 0,0:10:15.79,0:10:17.59,Default,,0,0,0,,‫2 و3 تساوي "سي".
Dialogue: 0,0:10:17.59,0:10:20.29,Default,,0,0,0,,‫3 و8 تساوي "تسو".
Dialogue: 0,0:10:20.29,0:10:22.29,Default,,0,0,0,,‫انعطف يمينًا؟
Dialogue: 0,0:10:22.29,0:10:25.89,Default,,0,0,0,,‫وما معنى هذه العلامة؟
Dialogue: 0,0:10:27.79,0:10:31.09,Default,,0,0,0,,‫ربما تمثل شكل الطريق؟
Dialogue: 0,0:10:31.09,0:10:33.59,Default,,0,0,0,,‫نعم! هذا منطقي.
Dialogue: 0,0:10:33.59,0:10:35.39,Default,,0,0,0,,‫إذًا أول جملة معناها:
Dialogue: 0,0:10:35.39,0:10:38.49,Default,,0,0,0,,‫"انعطف يمينًا عند التقاطع."
Dialogue: 0,0:10:38.49,0:10:41.09,Default,,0,0,0,,‫أنت مذهل يا ميتسوهيكو!
Dialogue: 0,0:10:41.09,0:10:42.09,Default,,0,0,0,,‫لنُكمل.
Dialogue: 0,0:10:42.09,0:10:43.79,Default,,0,0,0,,‫سأكتبها.
Dialogue: 0,0:10:50.69,0:10:52.29,Default,,0,0,0,,‫هذا ممل…
Dialogue: 0,0:10:54.19,0:10:55.49,Default,,0,0,0,,‫تمت!
Dialogue: 0,0:10:55.49,0:10:57.99,Default,,0,0,0,,‫اقرأها الآن.
Dialogue: 0,0:10:57.99,0:10:59.59,Default,,0,0,0,,‫سأتابع على الخريطة.
Dialogue: 0,0:10:59.59,0:11:00.69,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:11:00.69,0:11:04.09,Default,,0,0,0,,‫انعطف يمينًا عند التقاطع بعد المرور بممر تسوزورا أوري.
Dialogue: 0,0:11:04.09,0:11:06.19,Default,,0,0,0,,‫انعطف يمينًا عند تفرع الطريق،
Dialogue: 0,0:11:06.19,0:11:08.49,Default,,0,0,0,,‫ثم انعطف يسارًا عند التفرع التالي.
Dialogue: 0,0:11:08.49,0:11:10.69,Default,,0,0,0,,‫اعبر جسرين،
Dialogue: 0,0:11:10.69,0:11:13.69,Default,,0,0,0,,‫انعطف يسارًا بعد الجسر الثاني… والوصول.
Dialogue: 0,0:11:13.69,0:11:15.99,Default,,0,0,0,,‫حسنًا… إنها هنا.
Dialogue: 0,0:11:15.99,0:11:20.49,Default,,0,0,0,,‫الـ"بنسيون" (بيت الضيافة) هناك، إذن المكان قريب.
Dialogue: 0,0:11:20.49,0:11:22.29,Default,,0,0,0,,‫لنذهب لنتحقق.
Dialogue: 0,0:11:22.29,0:11:24.09,Default,,0,0,0,,‫ربما نعثر على الكنز.
Dialogue: 0,0:11:24.09,0:11:26.59,Default,,0,0,0,,‫وأنا متأكد أن كونان سيغتاظ.
Dialogue: 0,0:11:34.79,0:11:36.59,Default,,0,0,0,,‫لقد وصلنا.
Dialogue: 0,0:11:38.09,0:11:41.39,Default,,0,0,0,,‫مرحبًا! هل أنتم في الأعلى؟
Dialogue: 0,0:11:41.39,0:11:44.29,Default,,0,0,0,,‫لقد اصطدنا صيدًا وفيرًا!
Dialogue: 0,0:11:45.39,0:11:46.49,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:11:49.29,0:11:51.59,Default,,0,0,0,,‫مرحبًا... لديّ خبر سيئ.
Dialogue: 0,0:11:51.59,0:11:53.99,Default,,0,0,0,,‫الأطفال ليسوا هنا في أي مكان!
Dialogue: 0,0:11:53.99,0:11:55.19,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:12:02.79,0:12:05.09,Default,,0,0,0,,‫يا ميتسوهيكو!
Dialogue: 0,0:12:06.49,0:12:09.19,Default,,0,0,0,,‫أما زلنا لم نصل بعد؟
Dialogue: 0,0:12:09.19,0:12:13.79,Default,,0,0,0,,‫لم يبقَ إلا القليل، فاصمد يا غينتا.
Dialogue: 0,0:12:13.79,0:12:17.29,Default,,0,0,0,,‫نحن نعبر الجسر الثاني الآن.
Dialogue: 0,0:12:17.29,0:12:21.19,Default,,0,0,0,,‫بعد أن ننعطف يمينًا عند التفرع التالي سنصل!
Dialogue: 0,0:12:21.19,0:12:23.39,Default,,0,0,0,,‫ما زال أمامنا كل هذا؟
Dialogue: 0,0:12:23.39,0:12:25.39,Default,,0,0,0,,‫اصمد يا غينتا!
Dialogue: 0,0:12:25.39,0:12:28.19,Default,,0,0,0,,‫إن وجدنا الكنز، فستحصل على وجبة فاخرة من ثعبان البحر مع الأرز!
Dialogue: 0,0:12:28.19,0:12:30.19,Default,,0,0,0,,‫ثعبان البحر مع الأرز...
Dialogue: 0,0:12:30.19,0:12:31.99,Default,,0,0,0,,‫حسنًا! إن وجدنا الكنز،
Dialogue: 0,0:12:31.99,0:12:34.09,Default,,0,0,0,,‫فسآكل من ثعبان البحر مع الأرز بقدر ما أستطيع!
Dialogue: 0,0:12:34.09,0:12:37.49,Default,,0,0,0,,‫هيا يا ميتسوهيكو! من أجل مئة ألف وجبة من ثعبان البحر مع الأرز!
Dialogue: 0,0:12:37.49,0:12:39.39,Default,,0,0,0,,‫حسنًا، هذه هي الروح!
Dialogue: 0,0:12:42.49,0:12:45.09,Default,,0,0,0,,‫هذا سيئ... هل يُعقل أن...
Dialogue: 0,0:12:46.09,0:12:47.69,Default,,0,0,0,,‫هل توصلت إلى شيء؟
Dialogue: 0,0:12:47.69,0:12:50.09,Default,,0,0,0,,‫يا دكتور أغاسا، اتصل بالشرطة فورًا!
Dialogue: 0,0:12:50.09,0:12:51.19,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:12:51.19,0:12:53.39,Default,,0,0,0,,‫لقد ذهبوا إلى مخبأ الشخص
Dialogue: 0,0:12:53.39,0:12:55.49,Default,,0,0,0,,‫الذي دفع السيارة من الجرف قبل قليل!
Dialogue: 0,0:12:55.49,0:12:57.29,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:12:57.29,0:13:01.79,Default,,0,0,0,,‫إذًا هذه هي الشفرة التي كانوا يتحدثون عنها في السيارة قبل قليل.
Dialogue: 0,0:13:01.79,0:13:03.29,Default,,0,0,0,,‫تبًا!
Dialogue: 0,0:13:13.68,0:13:16.28,Default,,0,0,0,,‫لقد نجحنا! وصلنا أخيرًا يا غينتا!
Dialogue: 0,0:13:16.28,0:13:17.58,Default,,0,0,0,,‫إنه هناك!
Dialogue: 0,0:13:22.08,0:13:23.98,Default,,0,0,0,,‫يا ميتسوهيكو،
Dialogue: 0,0:13:23.98,0:13:26.08,Default,,0,0,0,,‫هل أنت متأكد أن هذا هو المكان الصحيح؟
Dialogue: 0,0:13:26.08,0:13:29.88,Default,,0,0,0,,‫لا يبدو أن له علاقة بالكنز، أليس كذلك؟
Dialogue: 0,0:13:29.88,0:13:31.38,Default,,0,0,0,,‫يا لك من قائلٍ هذا الكلام!
Dialogue: 0,0:13:31.38,0:13:35.18,Default,,0,0,0,,‫لقد جئنا تمامًا كما قالت الشفرة، فلا بد أنه صحيح!
Dialogue: 0,0:13:35.18,0:13:40.38,Default,,0,0,0,,‫ثم إن الكنوز عادةً ما تُخفى في أماكن كهذه.
Dialogue: 0,0:13:40.38,0:13:42.58,Default,,0,0,0,,‫حسنًا، فلندخل إذن!
Dialogue: 0,0:13:49.88,0:13:52.78,Default,,0,0,0,,‫نعم، شكرًا لك.
Dialogue: 0,0:13:53.98,0:13:57.28,Default,,0,0,0,,‫ستتوجه الشرطة فورًا إلى موقع الحادث.
Dialogue: 0,0:13:57.28,0:13:59.38,Default,,0,0,0,,‫لنسرع ونذهب نحن أيضًا.
Dialogue: 0,0:13:59.38,0:14:00.38,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:14:01.78,0:14:04.38,Default,,0,0,0,,‫يبدو أنه لا أحد في الداخل...
Dialogue: 0,0:14:04.38,0:14:08.38,Default,,0,0,0,,‫يا ميتسوهيكو، أين الكنز؟
Dialogue: 0,0:14:15.08,0:14:17.08,Default,,0,0,0,,‫المبنى الأبعد هناك...
Dialogue: 0,0:14:18.48,0:14:19.88,Default,,0,0,0,,‫انظروا!
Dialogue: 0,0:14:19.88,0:14:23.68,Default,,0,0,0,,‫ذلك المبنى هناك يمكن إقفاله.
Dialogue: 0,0:14:23.68,0:14:25.98,Default,,0,0,0,,‫-أنا متأكد أنه هناك. -نعم.
Dialogue: 0,0:14:25.98,0:14:27.88,Default,,0,0,0,,‫لنذهب ونتحقق منه!
Dialogue: 0,0:14:35.98,0:14:37.98,Default,,0,0,0,,‫هذا...
Dialogue: 0,0:14:37.98,0:14:39.88,Default,,0,0,0,,‫مذهل!
Dialogue: 0,0:14:44.08,0:14:47.08,Default,,0,0,0,,‫انظروا إلى كل تلك السيارات الأجنبية!
Dialogue: 0,0:14:47.08,0:14:49.48,Default,,0,0,0,,‫يا ميتسوهيكو،
Dialogue: 0,0:14:49.48,0:14:52.38,Default,,0,0,0,,‫لا يوجد كنز هنا على الإطلاق.
Dialogue: 0,0:14:53.98,0:14:55.48,Default,,0,0,0,,‫غريب...
Dialogue: 0,0:14:55.48,0:14:57.98,Default,,0,0,0,,‫أيها الاثنان!
Dialogue: 0,0:14:57.98,0:15:00.28,Default,,0,0,0,,‫هناك شيء مريب في هذه السيارة.
Dialogue: 0,0:15:00.28,0:15:01.28,Default,,0,0,0,,‫انظروا.
Dialogue: 0,0:15:01.28,0:15:03.98,Default,,0,0,0,,‫لا تحمل لوحة أرقام.
Dialogue: 0,0:15:03.98,0:15:06.38,Default,,0,0,0,,‫أنت محق.
Dialogue: 0,0:15:06.38,0:15:08.08,Default,,0,0,0,,‫يا ميتسوهيكو،
Dialogue: 0,0:15:08.08,0:15:10.18,Default,,0,0,0,,‫هذه أيضًا لا تحمل لوحة.
Dialogue: 0,0:15:10.88,0:15:14.18,Default,,0,0,0,,‫ربما تكون كلها سيارات مسروقة.
Dialogue: 0,0:15:15.38,0:15:19.28,Default,,0,0,0,,‫لا بد أنهم يخططون لبيعها إلى دولة أجنبية.
Dialogue: 0,0:15:19.28,0:15:23.28,Default,,0,0,0,,‫لقد وصلنا إلى مخبأ مهربي السيارات!
Dialogue: 0,0:15:23.28,0:15:25.18,Default,,0,0,0,,‫بالضبط!
Dialogue: 0,0:15:33.28,0:15:36.58,Default,,0,0,0,,‫أنتم الصغار الذين كنتم في موقع الحادث...
Dialogue: 0,0:15:39.58,0:15:41.68,Default,,0,0,0,,‫ومن يهتم!
Dialogue: 0,0:15:41.68,0:15:45.08,Default,,0,0,0,,‫أين الرجل ذو الشارب والطفل الآخر؟
Dialogue: 0,0:15:45.08,0:15:47.48,Default,,0,0,0,,‫من تقصد تحديدًا؟
Dialogue: 0,0:15:47.48,0:15:49.38,Default,,0,0,0,,‫لا تتظاهر بالجهل!
Dialogue: 0,0:15:50.98,0:15:53.08,Default,,0,0,0,,‫ما كان ذلك الصوت؟
Dialogue: 0,0:15:53.08,0:15:55.28,Default,,0,0,0,,‫-صوت إطلاق نار! -ماذا؟!
Dialogue: 0,0:15:55.28,0:15:57.08,Default,,0,0,0,,‫أسرع يا دكتور أغاسا!
Dialogue: 0,0:15:57.08,0:15:58.88,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:16:04.88,0:16:06.58,Default,,0,0,0,,‫سأسألك مرة أخرى.
Dialogue: 0,0:16:06.58,0:16:10.98,Default,,0,0,0,,‫أين الرجل ذو الشارب والطفل الآخر؟
Dialogue: 0,0:16:10.98,0:16:13.28,Default,,0,0,0,,‫لا أعلم عمّا تتحدث.
Dialogue: 0,0:16:13.28,0:16:14.48,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:16:14.48,0:16:16.28,Default,,0,0,0,,‫يا ميتسوهيكو...
Dialogue: 0,0:16:16.28,0:16:18.08,Default,,0,0,0,,‫ميتسوهيكو...
Dialogue: 0,0:16:18.08,0:16:21.08,Default,,0,0,0,,‫لا، لا أستطيع أن أُورّط كونان ودكتور أغاسا
Dialogue: 0,0:16:21.08,0:16:23.68,Default,,0,0,0,,‫في أمر تورطتُ فيه بسبب تصرفاتي.
Dialogue: 0,0:16:24.78,0:16:25.88,Default,,0,0,0,,‫إنه محق.
Dialogue: 0,0:16:25.88,0:16:27.08,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:16:28.68,0:16:31.48,Default,,0,0,0,,‫يبدو أنكم ترغبون في الموت حقًا.
Dialogue: 0,0:16:39.78,0:16:41.48,Default,,0,0,0,,‫أنا.
Dialogue: 0,0:16:41.48,0:16:44.38,Default,,0,0,0,,‫آسف، لم أحصل إلا على خمسٍ حتى الآن.
Dialogue: 0,0:16:44.38,0:16:48.28,Default,,0,0,0,,‫سادا جبن وفرّ ومعه واحدة.
Dialogue: 0,0:16:48.28,0:16:50.78,Default,,0,0,0,,‫نعم، لقد تكفلتُ به.
Dialogue: 0,0:16:50.78,0:16:52.68,Default,,0,0,0,,‫صدمته من الخلف عند الحافة،
Dialogue: 0,0:16:52.68,0:16:55.18,Default,,0,0,0,,‫فسقط رأسًا على عقب إلى الأسفل.
Dialogue: 0,0:16:56.18,0:16:58.58,Default,,0,0,0,,‫لستُ أحمق.
Dialogue: 0,0:16:58.58,0:17:01.38,Default,,0,0,0,,‫سأفكك السيارة قبل أن تصل الشرطة.
Dialogue: 0,0:17:01.38,0:17:04.98,Default,,0,0,0,,‫حين تُفكك، لن يبقى دليل.
Dialogue: 0,0:17:08.48,0:17:09.68,Default,,0,0,0,,‫هذا...
Dialogue: 0,0:17:16.48,0:17:18.38,Default,,0,0,0,,‫ما بكم أنتم؟
Dialogue: 0,0:17:18.38,0:17:20.08,Default,,0,0,0,,‫بل ما بك أنت؟
Dialogue: 0,0:17:20.08,0:17:22.48,Default,,0,0,0,,‫تلوّح ببندقية في وجه أطفال!
Dialogue: 0,0:17:22.48,0:17:24.78,Default,,0,0,0,,‫دكتور أغاسا...
Dialogue: 0,0:17:24.78,0:17:26.78,Default,,0,0,0,,‫أنت الذي كنتَ في موقع الحادث.
Dialogue: 0,0:17:26.78,0:17:29.08,Default,,0,0,0,,‫لا توقيت أفضل من هذا. وفّرت عليّ عناء البحث عنك!
Dialogue: 0,0:17:29.08,0:17:31.08,Default,,0,0,0,,‫لا فائدة يا سيدي.
Dialogue: 0,0:17:31.08,0:17:32.88,Default,,0,0,0,,‫اسمع... أتعرف ما هذا؟
Dialogue: 0,0:17:33.88,0:17:35.78,Default,,0,0,0,,‫إنها سيارة الشرطة متجهة إلى هنا.
Dialogue: 0,0:17:35.78,0:17:37.28,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:17:37.28,0:17:40.58,Default,,0,0,0,,‫إنهم قادمون إلى هنا
Dialogue: 0,0:17:40.58,0:17:43.28,Default,,0,0,0,,‫ليلقوا القبض عليك يا سيدي!
Dialogue: 0,0:17:43.28,0:17:44.68,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:17:48.08,0:17:49.68,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:17:51.28,0:17:53.88,Default,,0,0,0,,‫أيها الضباط...
Dialogue: 0,0:17:53.88,0:17:56.88,Default,,0,0,0,,‫لم أفعل شيئًا خاطئًا.
Dialogue: 0,0:17:56.88,0:18:00.48,Default,,0,0,0,,‫قبل أن نستمع إليك، سلّمنا سلاحك.
Dialogue: 0,0:18:00.48,0:18:02.88,Default,,0,0,0,,‫أوه، تقصدون هذا السلاح؟
Dialogue: 0,0:18:02.88,0:18:06.98,Default,,0,0,0,,‫كنتُ أحاول فقط تخويف الأطفال
Dialogue: 0,0:18:06.98,0:18:09.18,Default,,0,0,0,,‫لأنهم تعدّوا على ممتلكاتي.
Dialogue: 0,0:18:09.18,0:18:11.48,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:18:11.48,0:18:14.48,Default,,0,0,0,,‫وبالمناسبة، هل تلك سيارتك؟
Dialogue: 0,0:18:14.48,0:18:17.28,Default,,0,0,0,,‫نعم، إنها سيارتي. هل هناك مشكلة؟
Dialogue: 0,0:18:17.28,0:18:23.08,Default,,0,0,0,,‫حسنًا، هناك سيارة سقطت من الجرف عند ممر تسوزورا أوري،
Dialogue: 0,0:18:23.08,0:18:25.98,Default,,0,0,0,,‫ويبدو أن سيارة من نفس طراز سيارتك
Dialogue: 0,0:18:25.98,0:18:28.38,Default,,0,0,0,,‫دفعتها من الخلف وأسقطتها.
Dialogue: 0,0:18:28.38,0:18:32.48,Default,,0,0,0,,‫كما أن في سيارتك انبعاجًا، ويبدو أنها اصطدمت بشيء.
Dialogue: 0,0:18:32.48,0:18:35.88,Default,,0,0,0,,‫ماذا؟ هل تشكون بي؟
Dialogue: 0,0:18:35.88,0:18:38.68,Default,,0,0,0,,‫هناك مئات السيارات من هذا الطراز، أليس كذلك؟
Dialogue: 0,0:18:38.68,0:18:40.78,Default,,0,0,0,,‫فكم واحدة من تلك المئات تظنون
Dialogue: 0,0:18:40.78,0:18:43.68,Default,,0,0,0,,‫كانت في موقع الحادث؟
Dialogue: 0,0:18:43.68,0:18:46.98,Default,,0,0,0,,‫وأين كنتَ في ذلك الوقت؟
Dialogue: 0,0:18:46.98,0:18:50.48,Default,,0,0,0,,‫آسف، لقد كان حادثًا.
Dialogue: 0,0:18:50.48,0:18:52.08,Default,,0,0,0,,‫كان المنظر جميلًا جدًا،
Dialogue: 0,0:18:52.08,0:18:54.88,Default,,0,0,0,,‫فشغلتُ نظري عن الطريق.
Dialogue: 0,0:18:54.88,0:18:57.18,Default,,0,0,0,,‫ثم فجأة... اصطدمت!
Dialogue: 0,0:18:57.18,0:18:58.58,Default,,0,0,0,,‫إنه يكذب يا حضرة الشرطي!
Dialogue: 0,0:18:58.58,0:19:00.68,Default,,0,0,0,,‫اصمت! لا تتدخل أيها الصغير!
Dialogue: 0,0:19:00.68,0:19:01.78,Default,,0,0,0,,‫كلا، لن أصمت!
Dialogue: 0,0:19:01.78,0:19:03.18,Default,,0,0,0,,‫لقد قلتَ للتو في الهاتف
Dialogue: 0,0:19:03.18,0:19:06.08,Default,,0,0,0,,‫إنك صدمت السيارة ودفعتهـا من الجرف!
Dialogue: 0,0:19:06.08,0:19:07.78,Default,,0,0,0,,‫لقد سمعتك تقول ذلك!
Dialogue: 0,0:19:07.78,0:19:09.48,Default,,0,0,0,,‫وأنا أيضًا!
Dialogue: 0,0:19:09.48,0:19:14.58,Default,,0,0,0,,‫أيها الشرطي، هل ستصدق كلام هؤلاء الصغار؟
Dialogue: 0,0:19:14.58,0:19:17.58,Default,,0,0,0,,‫كيف يمكنني دفع سيارة من الجرف
Dialogue: 0,0:19:17.58,0:19:18.98,Default,,0,0,0,,‫بالاصطدام من الخلف عند منعطف حاد كهذا؟
Dialogue: 0,0:19:18.98,0:19:20.38,Default,,0,0,0,,‫لقد فعلت ذلك تمامًا!
Dialogue: 0,0:19:20.38,0:19:23.88,Default,,0,0,0,,‫ونجحت نجاحًا كاملًا!
Dialogue: 0,0:19:23.88,0:19:26.18,Default,,0,0,0,,‫أيها العجوز! كُفَّ عن هرائك!
Dialogue: 0,0:19:26.18,0:19:28.38,Default,,0,0,0,,‫هل لديك دليل أم لا؟ دليل!
Dialogue: 0,0:19:28.38,0:19:29.98,Default,,0,0,0,,‫بالطبع لديّ دليل.
Dialogue: 0,0:19:29.98,0:19:32.88,Default,,0,0,0,,‫أمام المنعطف الذي سقطت عنده السيارة،
Dialogue: 0,0:19:32.88,0:19:35.58,Default,,0,0,0,,‫كانت هناك علامتا انزلاق للإطارات،
Dialogue: 0,0:19:35.58,0:19:39.68,Default,,0,0,0,,‫تُركتا عندما صدمت السيارة من الخلف.
Dialogue: 0,0:19:39.68,0:19:43.78,Default,,0,0,0,,‫أي أنك اصطدمت مرتين.
Dialogue: 0,0:19:43.78,0:19:45.48,Default,,0,0,0,,‫وماذا في ذلك؟
Dialogue: 0,0:19:45.48,0:19:49.08,Default,,0,0,0,,‫لم أكن أنظر إلى الطريق، فاصطدمت مرتين.
Dialogue: 0,0:19:49.08,0:19:53.08,Default,,0,0,0,,‫قد يكون ذلك ممكنًا... ولكن...
Dialogue: 0,0:19:53.08,0:19:58.48,Default,,0,0,0,,‫هل تعرف المسافة بين آثار إطارات السيارة التي سقطت؟
Dialogue: 0,0:19:58.48,0:20:01.98,Default,,0,0,0,,‫نعم، 16.33 مترًا.
Dialogue: 0,0:20:01.98,0:20:07.58,Default,,0,0,0,,‫وبأي سرعة كنت تسير على ذلك الطريق؟
Dialogue: 0,0:20:08.68,0:20:11.18,Default,,0,0,0,,‫حوالي 30 كيلومترًا!
Dialogue: 0,0:20:11.18,0:20:14.58,Default,,0,0,0,,‫كما توقعت...
Dialogue: 0,0:20:14.58,0:20:18.38,Default,,0,0,0,,‫سرعة 30 كيلومترًا تعني
Dialogue: 0,0:20:18.38,0:20:21.78,Default,,0,0,0,,‫أنك تسير بنحو 8.3 أمتار في الثانية.
Dialogue: 0,0:20:21.78,0:20:27.48,Default,,0,0,0,,‫ولكي تكون المسافة بين آثار الانزلاق 16.33 مترًا،
Dialogue: 0,0:20:27.48,0:20:29.68,Default,,0,0,0,,‫فهذا يستغرق قرابة ثانيتين.
Dialogue: 0,0:20:29.68,0:20:32.28,Default,,0,0,0,,‫بعد اصطدامك بالسيارة أول مرة،
Dialogue: 0,0:20:32.28,0:20:33.58,Default,,0,0,0,,‫ولمدة ثانيتين كاملتين،
Dialogue: 0,0:20:33.58,0:20:35.68,Default,,0,0,0,,‫لم تُدر المقود لتتفادى الاصطدام،
Dialogue: 0,0:20:35.68,0:20:37.58,Default,,0,0,0,,‫ولم تضغط على المكابح أيضًا.
Dialogue: 0,0:20:37.58,0:20:40.38,Default,,0,0,0,,‫بل اصطدمت مرة ثانية!
Dialogue: 0,0:20:40.38,0:20:41.68,Default,,0,0,0,,‫إن لم يكن هذا اصطدامًا متعمدًا،
Dialogue: 0,0:20:41.68,0:20:43.28,Default,,0,0,0,,‫فماذا تسميه إذن؟
Dialogue: 0,0:20:44.28,0:20:47.48,Default,,0,0,0,,‫إن كان لديك ما تريد قوله،
Dialogue: 0,0:20:47.48,0:20:50.48,Default,,0,0,0,,‫فسنستمع إليك في المركز.
Dialogue: 0,0:20:50.48,0:20:51.78,Default,,0,0,0,,‫تبًا!
Dialogue: 0,0:20:51.78,0:20:53.48,Default,,0,0,0,,‫أيها الشرطي...
Dialogue: 0,0:20:54.48,0:20:58.98,Default,,0,0,0,,‫هناك سيارات فاخرة بلا لوحات في المبنى الواقع خلف ذلك.
Dialogue: 0,0:20:58.98,0:21:01.98,Default,,0,0,0,,‫وأنا متأكد أنها جميعًا سيارات مسروقة.
Dialogue: 0,0:21:01.98,0:21:05.38,Default,,0,0,0,,‫أحسنتم جميعًا!
Dialogue: 0,0:21:06.48,0:21:07.88,Default,,0,0,0,,‫لكن اسمعوا...
Dialogue: 0,0:21:07.88,0:21:10.78,Default,,0,0,0,,‫لا تفعلوا شيئًا خطيرًا كهذا مرة أخرى!
Dialogue: 0,0:21:10.78,0:21:13.18,Default,,0,0,0,,‫نعم، سيدي...
Dialogue: 0,0:22:49.48,0:22:53.38,Default,,0,0,0,,‫تبًا... يبدو أني لا أُحسن تقطيع الحطب.
Dialogue: 0,0:22:54.48,0:22:56.18,Default,,0,0,0,,‫تبًا... تبًا!
Dialogue: 0,0:22:56.18,0:22:59.28,Default,,0,0,0,,‫مرحبًا! نحتاج إلى حطب أكثر!
Dialogue: 0,0:22:59.28,0:23:03.98,Default,,0,0,0,,‫يا كونان، لماذا لا تساعدنا قليلًا هنا أيضًا؟
Dialogue: 0,0:23:03.98,0:23:05.68,Default,,0,0,0,,‫مستحيل!
Dialogue: 0,0:23:05.68,0:23:08.08,Default,,0,0,0,,‫هذا خطؤكم لأنكم تكاسلتم ولم تقطعوا الحطب
Dialogue: 0,0:23:08.08,0:23:11.88,Default,,0,0,0,,‫كما كان ينبغي لكم، تستحقون ذلك.
Dialogue: 0,0:23:11.88,0:23:14.28,Default,,0,0,0,,‫نعم نعم، حسنًا.
Dialogue: 0,0:23:14.28,0:23:15.88,Default,,0,0,0,,‫يكفي "نعم" واحدة!
Dialogue: 0,0:23:15.88,0:23:17.18,Default,,0,0,0,,‫نعم!
Dialogue: 0,0:23:17.18,0:23:21.18,Default,,0,0,0,,‫آمل أن يتعلموا الدرس ويتوقفوا عن فعل الأشياء الخطيرة.
Dialogue: 0,0:23:22.88,0:23:25.58,Default,,0,0,0,,‫لكن الأمر مخيب للآمال.
Dialogue: 0,0:23:25.58,0:23:26.88,Default,,0,0,0,,‫ما الذي هو مخيب؟
Dialogue: 0,0:23:26.88,0:23:31.18,Default,,0,0,0,,‫كونان فكّ تلك الشفرة بسرعة كبيرة!
Dialogue: 0,0:23:31.18,0:23:33.58,Default,,0,0,0,,‫وأنت أيضًا كنت رائعًا يا ميتسوهيكو!
Dialogue: 0,0:23:33.58,0:23:35.18,Default,,0,0,0,,‫لم تكتفِ بفك الشفرة،
Dialogue: 0,0:23:35.18,0:23:37.38,Default,,0,0,0,,‫بل كنت على صواب بشأن المهربين أيضًا.
Dialogue: 0,0:23:37.38,0:23:41.48,Default,,0,0,0,,‫أنا فقط ظننت ذلك لأنها كانت في الكتاب الذي أقرأه.
Dialogue: 0,0:23:42.18,0:23:45.58,Default,,0,0,0,,‫رائع... ربما ينبغي لي أن أقرأه أنا أيضًا.
Dialogue: 0,0:23:45.58,0:23:49.08,Default,,0,0,0,,‫أوه، لديّ ما يناسبك يا غينتا!
Dialogue: 0,0:23:49.08,0:23:51.88,Default,,0,0,0,,‫عنوانه: "قضية قتل وجبة الأطفال".
Dialogue: 0,0:23:51.88,0:23:53.08,Default,,0,0,0,,‫يا له من عنوان مضحك!
Dialogue: 0,0:23:53.08,0:23:57.18,Default,,0,0,0,,‫أفضل ثعبان البحر مع الأرز على وجبة الأطفال.
Dialogue: 0,0:23:57.78,0:24:00.28,Default,,0,0,0,,‫مهلًا، ألم تتعلموا الدرس بعد؟
Dialogue: 0,0:24:03.14,0:24:05.34,Default,,0,0,0,,‫تلميح كونان القادم:
Dialogue: 0,0:24:05.60,0:24:07.10,Default,,0,0,0,,‫"اللفافة المعلّقة"
Dialogue: 0,0:24:07.60,0:24:09.44,Default,,0,0,0,,‫الحلقة القادمة عمل أصلي يصعب حلّه.
Dialogue: 0,0:24:09.58,0:24:12.28,Default,,0,0,0,,‫مهما شاهدتها، لا أستطيع فهمها.
