Dialogue: 0,0:00:03.00,0:00:05.80,Default,,0,0,0,,{\pos(729.333,69)}Chatgpt Sub +You1988
Dialogue: 0,0:00:14.77,0:00:16.80,op,,0,0,0,,
Dialogue: 0,0:00:16.80,0:00:17.80,op,,0,0,0,,{\pos(305.5,235.5)}FaGeem ترجمة الشارة
Dialogue: 0,0:00:16.80,0:00:19.00,op,,0,0,0,,لا أستطيعُ إيقاف حبي لكّ
Dialogue: 0,0:00:19.20,0:00:28.70,op,,0,0,0,,تكلمنا سوية حول المستقبل كما لو أن هناك مكان لنا
Dialogue: 0,0:00:29.50,0:00:32.60,op,,0,0,0,,ياحُبيّ أنا لا أستطيعُ إيقاف حُبي لكّ
Dialogue: 0,0:00:32.60,0:00:36.20,op,,0,0,0,,سوف أكون لك كل شيئ
Dialogue: 0,0:00:36.70,0:00:44.60,op,,0,0,0,,سأصُدق وعدكّ لي بأنكّ لن تترك يُدي عندما نمُشي سوية
Dialogue: 0,0:00:45.90,0:00:51.40,op,,0,0,0,,أكُرهك عندما تكذب بأنك لا تستطيع إخباري
Dialogue: 0,0:00:52.30,0:00:58.30,op,,0,0,0,, حتى لو كان حُبك كذبة فلن أستطيع البُوح لكّ
Dialogue: 0,0:01:00.30,0:01:06.70,op,,0,0,0,,لا تبدأ حياتك بالتهُرب مني بالأكاذيبّ
Dialogue: 0,0:01:06.70,0:01:12.30,op,,0,0,0,,لأن قلبي مُلك وحُدك
Dialogue: 0,0:01:13.90,0:01:16.10,op,,0,0,0,,لا أستطيعُ إيقاف حبي لكّ
Dialogue: 0,0:01:16.20,0:01:25.90,op,,0,0,0,,نحن يجب أن نتمسك بحُبنا حتى يستُمر
Dialogue: 0,0:01:26.70,0:01:32.90,op,,0,0,0,,في تلك الليلة عندما بدأ الشُكّ يعُتريكّ
Dialogue: 0,0:01:34.30,0:01:41.90,op,,0,0,0,,تمتلئ حبنا في إمبراطوريتك وتمسك به
Dialogue: 0,0:20:44.60,0:20:45.03,ED,,0,0,0,,
Dialogue: 0,0:21:45.93,0:21:51.93,Ed,,0,0,0,,{\pos(493.014,574)}ترجمة النهاية  أبو علي حسن محمد
Dialogue: 0,0:21:40.33,0:21:45.50,Ed,,0,0,0,,أفكر فيكّ كل يوم عند إستيقاضي من النوم
Dialogue: 0,0:21:45.50,0:21:51.55,Ed,,0,0,0,,عندما تكون جُنبيّ أكون سعيداً
Dialogue: 0,0:21:51.55,0:21:58.22,Ed,,0,0,0,,كُنت ابكي لأني أخاف من مضي الوقتّ
Dialogue: 0,0:21:58.22,0:22:03.20,Ed,,0,0,0,,وأخُاف من تغير القلوب
Dialogue: 0,0:22:05.90,0:22:19.60,Ed,,0,0,0,,حتى لو أعتقدت أني لا أريدكّ لم أترككّ
Dialogue: 0,0:22:19.60,0:22:23.90,Ed,,0,0,0,,لو لم أحتاجك لِمَ أطلبكّ إذاً
Dialogue: 0,0:22:23.90,0:22:31.00,Ed,,0,0,0,,لا يٌهمنيّ سأنتظركّ مهما كان المستقبلّ
Dialogue: 0,0:22:31.60,0:22:38.07,Ed,,0,0,0,,حتى بعد الحلُم مازلتُ بعيداً
Dialogue: 0,0:22:38.07,0:22:43.65,Ed,,0,0,0,,من غير المجُدي تتحرك بمشاعرك فقط
Dialogue: 0,0:22:43.65,0:22:50.90,Ed,,0,0,0,,الأزهارّ تسقُط كالمُطر وهذا الطريق لن يتغُير
Dialogue: 0,0:22:51.60,0:22:56.70,Ed,,0,0,0,,أريدُ أن نمُشي يداً بُيدّ
Dialogue: 0,0:01:41.00,0:01:44.00,op,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:01.67,Default,,0,0,0,,
Dialogue: 0,0:00:01.67,0:00:03.67,Default,,0,0,0,,‫يجتمع الحبّ والكراهية معًا.
Dialogue: 0,0:00:03.67,0:00:05.47,Default,,0,0,0,,‫من خلال الاستنتاج والتشويق معًا.
Dialogue: 0,0:00:05.47,0:00:06.97,Default,,0,0,0,,‫في شقّةٍ تبدو مخيفة
Dialogue: 0,0:00:06.97,0:00:08.97,Default,,0,0,0,,‫تُخفي خدعةً غير متوقعة.
Dialogue: 0,0:00:08.97,0:00:10.77,Default,,0,0,0,,‫هو يرى الحقيقة الوحيدة.
Dialogue: 0,0:00:10.77,0:00:12.67,Default,,0,0,0,,‫طفلٌ في المظهر… بذكاء رجلٍ بالغ.
Dialogue: 0,0:00:12.67,0:00:15.17,Default,,0,0,0,,‫اسمه: المحقق كونان!
Dialogue: 0,0:01:59.71,0:02:02.41,Default,,0,0,0,,‫التقينا عجوزًا في عيادة أرايدي
Dialogue: 0,0:02:02.41,0:02:06.01,Default,,0,0,0,,‫وحكى لنا قصة أشباحٍ غريبة.
Dialogue: 0,0:02:06.01,0:02:08.11,Default,,0,0,0,,‫ثم جئنا إلى بنايته القديمة الصغيرة
Dialogue: 0,0:02:08.11,0:02:10.21,Default,,0,0,0,,‫التي قال إنها مسكونة.
Dialogue: 0,0:02:13.41,0:02:15.21,Default,,0,0,0,,‫وبالمناسبة، يوجد مبنى بجوار بنايته.
Dialogue: 0,0:02:15.21,0:02:17.01,Default,,0,0,0,,‫المالك انتحر
Dialogue: 0,0:02:17.01,0:02:18.41,Default,,0,0,0,,‫بعد انفجار الفقاعة المالية.
Dialogue: 0,0:02:20.21,0:02:24.91,Default,,0,0,0,,‫وأمام البناية توجد حديقة أيضًا،
Dialogue: 0,0:02:24.91,0:02:27.51,Default,,0,0,0,,‫حيث عُثر سابقًا على جثة امرأةٍ شابة محترقة.
Dialogue: 0,0:02:28.51,0:02:29.91,Default,,0,0,0,,‫تحيط بهذا المكان قصصٌ مرعبة كثيرة،
Dialogue: 0,0:02:29.91,0:02:31.41,Default,,0,0,0,,‫ونمنا بينما كنا ننتظر في غرفة العجوز
Dialogue: 0,0:02:31.41,0:02:33.31,Default,,0,0,0,,‫ظهورَ الشبح.
Dialogue: 0,0:02:37.81,0:02:39.31,Default,,0,0,0,,‫عودوا إلى البيت.
Dialogue: 0,0:02:40.51,0:02:42.71,Default,,0,0,0,,‫عودوا إلى البيت.
Dialogue: 0,0:02:43.71,0:02:48.31,Default,,0,0,0,,‫اخرجوا…
Dialogue: 0,0:02:48.31,0:02:50.31,Default,,0,0,0,,‫حالًا!
Dialogue: 0,0:02:51.31,0:02:52.81,Default,,0,0,0,,‫ثم…
Dialogue: 0,0:02:52.81,0:02:55.51,Default,,0,0,0,,‫تحوّل ماء المرحاض إلى الأحمر.
Dialogue: 0,0:02:55.51,0:02:57.81,Default,,0,0,0,,‫وظهرت هيئةٌ مخيفة تنظر من النافذة من الخارج.
Dialogue: 0,0:02:58.81,0:03:02.11,Default,,0,0,0,,‫كما شوهدت "شمعة موت" طافية
Dialogue: 0,0:03:02.11,0:03:04.31,Default,,0,0,0,,‫في المبنى المجاور.
Dialogue: 0,0:03:08.31,0:03:10.61,Default,,0,0,0,,‫ماذا يعني هذا كله؟
Dialogue: 0,0:03:11.91,0:03:15.91,Default,,0,0,0,,‫شبحٌ يظهر على شاشة التلفاز بعد شعورٍ مفاجئ بالإغماء،
Dialogue: 0,0:03:15.91,0:03:19.61,Default,,0,0,0,,‫وماء المرحاض يتحول فجأة إلى الأحمر…
Dialogue: 0,0:03:19.61,0:03:22.31,Default,,0,0,0,,‫كلاهما يمكن تفسيره علميًا،
Dialogue: 0,0:03:23.81,0:03:26.71,Default,,0,0,0,,‫لكن ماذا عن الظاهرتين الأخريين:
Dialogue: 0,0:03:26.71,0:03:28.31,Default,,0,0,0,,‫شمعة الموت… والهيئة عند النافذة؟
Dialogue: 0,0:03:28.31,0:03:30.51,Default,,0,0,0,,‫لا أستطيع فهمهما أبدًا.
Dialogue: 0,0:03:31.71,0:03:35.51,Default,,0,0,0,,‫كيف نفّذ الجاني ذلك؟
Dialogue: 0,0:03:35.51,0:03:38.81,Default,,0,0,0,,‫وهل يوجد جاني من الأساس؟
Dialogue: 0,0:03:38.81,0:03:42.01,Default,,0,0,0,,‫إن كان موجودًا… فمن يكون؟
Dialogue: 0,0:03:42.01,0:03:44.21,Default,,0,0,0,,‫ولأي غرضٍ يفعل كل هذا؟
Dialogue: 0,0:03:50.81,0:03:56.31,Default,,0,0,0,,‫"حقيقة المنزل المسكون (الجزء الثاني)"
Dialogue: 0,0:03:59.41,0:04:01.51,Default,,0,0,0,,‫كونان…
Dialogue: 0,0:04:01.51,0:04:04.01,Default,,0,0,0,,‫لماذا تنظر والنافذة مفتوحة؟
Dialogue: 0,0:04:04.01,0:04:06.01,Default,,0,0,0,,‫ستدخل الحشرات مجددًا.
Dialogue: 0,0:04:07.11,0:04:09.21,Default,,0,0,0,,‫كنت أتساءل فقط: أين بالضبط
Dialogue: 0,0:04:09.21,0:04:12.51,Default,,0,0,0,,‫رأى ذلك العجوز شمعة الموت في ذلك المبنى؟
Dialogue: 0,0:04:13.51,0:04:16.81,Default,,0,0,0,,‫المكان الذي رأيتها فيه
Dialogue: 0,0:04:16.81,0:04:18.41,Default,,0,0,0,,‫كان في الظلام قرب وسط ذلك المبنى.
Dialogue: 0,0:04:18.41,0:04:22.81,Default,,0,0,0,,‫كان الضوء الأحمر وحده يلوح ويتحرك في الهواء.
Dialogue: 0,0:04:22.81,0:04:26.01,Default,,0,0,0,,‫وأحيانًا كان يتحول إلى ضوءٍ أبيض مزرق.
Dialogue: 0,0:04:27.01,0:04:28.61,Default,,0,0,0,,‫إن لم تصدقني،
Dialogue: 0,0:04:28.61,0:04:33.91,Default,,0,0,0,,‫فاسأل السيد يوتسويا من الغرفة 2 والسيد بانتشو من الغرفة 4.
Dialogue: 0,0:04:33.91,0:04:37.91,Default,,0,0,0,,‫كلٌ منهما قال إنه رأى شمعة الموت مرة أيضًا.
Dialogue: 0,0:04:37.91,0:04:40.01,Default,,0,0,0,,‫أجل… لقد رأيت…
Dialogue: 0,0:04:40.01,0:04:42.81,Default,,0,0,0,,‫شمعة موت حمراء وزرقاء أيضًا،
Dialogue: 0,0:04:42.81,0:04:45.51,Default,,0,0,0,,‫عندما زرت الغرفة التي كان يسكنها زميلي الأكبر في المدرسة.
Dialogue: 0,0:04:45.51,0:04:46.51,Default,,0,0,0,,‫زميلك الأكبر؟
Dialogue: 0,0:04:46.51,0:04:47.51,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:04:49.01,0:04:52.01,Default,,0,0,0,,‫هناك في الأعلى… الغرفة فوق هذه مباشرة.
Dialogue: 0,0:04:52.01,0:04:55.01,Default,,0,0,0,,‫كانت الغرفة 6 حيث كان يسكن زميلي.
Dialogue: 0,0:04:58.11,0:04:59.41,Default,,0,0,0,,‫لكن منذ ذلك الحين،
Dialogue: 0,0:04:59.41,0:05:01.41,Default,,0,0,0,,‫لم يعد يستطيع النوم جيدًا
Dialogue: 0,0:05:01.41,0:05:03.01,Default,,0,0,0,,‫بسبب خوفه من شموع الموت.
Dialogue: 0,0:05:03.01,0:05:05.51,Default,,0,0,0,,‫وفي النهاية انتقل من هنا.
Dialogue: 0,0:05:06.51,0:05:07.91,Default,,0,0,0,,‫أما أنا فلم أستطع النوم أيضًا،
Dialogue: 0,0:05:07.91,0:05:09.41,Default,,0,0,0,,‫ليس خوفًا… بل من شدة الحماس.
Dialogue: 0,0:05:10.41,0:05:11.41,Default,,0,0,0,,‫آه صحيح.
Dialogue: 0,0:05:12.51,0:05:15.51,Default,,0,0,0,,‫هيه… هذا جهاز عرض أفلام 8 مم، أليس كذلك؟
Dialogue: 0,0:05:15.51,0:05:16.51,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:05:16.51,0:05:20.81,Default,,0,0,0,,‫أستخدمه الآن لتحرير فيلم صوّره نادينا السينمائي في الجامعة.
Dialogue: 0,0:05:20.81,0:05:23.41,Default,,0,0,0,,‫لكن هذه الغرفة بشعةٌ جدًا،
Dialogue: 0,0:05:23.41,0:05:26.11,Default,,0,0,0,,‫مليئةٌ بمجلّات وملصقات رعبٍ مريضة.
Dialogue: 0,0:05:26.11,0:05:27.21,Default,,0,0,0,,‫إنها مخيفة حقًا.
Dialogue: 0,0:05:27.21,0:05:29.51,Default,,0,0,0,,‫أشعر أنني سأرى كوابيس لمجرد وجودي هنا.
Dialogue: 0,0:05:29.51,0:05:31.81,Default,,0,0,0,,‫ومع ذلك، فهذا لا شيء مقارنةً بالغرفة 4
Dialogue: 0,0:05:31.81,0:05:34.91,Default,,0,0,0,,‫حيث يسكن السيد بانتشو.
Dialogue: 0,0:05:34.91,0:05:36.11,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:05:36.11,0:05:38.91,Default,,0,0,0,,‫"الغرفة 4، بانتشو"
Dialogue: 0,0:05:38.91,0:05:41.61,Default,,0,0,0,,‫هذه الغرفة شيءٌ آخر فعلًا.
Dialogue: 0,0:05:41.61,0:05:44.41,Default,,0,0,0,,‫هناك عدد هائل من مجسّمات الأشباح والوحوش!
Dialogue: 0,0:05:44.41,0:05:47.61,Default,,0,0,0,,‫"كيكوجي بانتشو (34)" -لم ترَ شيئًا بعد.
Dialogue: 0,0:05:47.61,0:05:50.21,Default,,0,0,0,,‫أطفئ النور هكذا.
Dialogue: 0,0:05:52.51,0:05:56.41,Default,,0,0,0,,‫المجسّمات تتوهّج بألوانٍ مختلفة في الظلام!
Dialogue: 0,0:05:56.41,0:05:58.91,Default,,0,0,0,,‫وذلك بسبب هذا الضوء الأسود.
Dialogue: 0,0:05:58.91,0:06:03.01,Default,,0,0,0,,‫الطلاء الفلوري الخاص على المجسّمات
Dialogue: 0,0:06:03.01,0:06:05.41,Default,,0,0,0,,‫يتفاعل مع الضوء الأسود فيتوهّج كأنبوب نيون.
Dialogue: 0,0:06:06.41,0:06:07.91,Default,,0,0,0,,‫أنت تعرف كثيرًا يا فتى.
Dialogue: 0,0:06:07.91,0:06:10.81,Default,,0,0,0,,‫صاحب متجر ألعاب أخبرني بذلك.
Dialogue: 0,0:06:10.81,0:06:13.51,Default,,0,0,0,,‫بالمناسبة… أنت رأيت شمعة الموت أيضًا، صحيح؟
Dialogue: 0,0:06:13.51,0:06:15.51,Default,,0,0,0,,‫نعم، رأيتها،
Dialogue: 0,0:06:15.51,0:06:16.81,Default,,0,0,0,,‫لكنني رأيتها من خلال تلك النافذة،
Dialogue: 0,0:06:16.81,0:06:18.81,Default,,0,0,0,,‫لا النافذة المواجهة لذلك المبنى.
Dialogue: 0,0:06:20.21,0:06:22.51,Default,,0,0,0,,‫هذه النافذة…
Dialogue: 0,0:06:22.51,0:06:26.61,Default,,0,0,0,,‫تقع قطريًا أسفل النافذة التي ظهرت فيها الهيئة.
Dialogue: 0,0:06:26.61,0:06:28.01,Default,,0,0,0,,‫هيه، أيها الفتى.
Dialogue: 0,0:06:28.01,0:06:30.11,Default,,0,0,0,,‫أظن من الأفضل أن تغلق النافذة الآن.
Dialogue: 0,0:06:30.11,0:06:32.71,Default,,0,0,0,,‫افعل ذلك من أجل أختك.
Dialogue: 0,0:06:32.71,0:06:36.01,Default,,0,0,0,,‫لكن… في الحقيقة دخلت بالفعل عثّتان.
Dialogue: 0,0:06:38.41,0:06:41.31,Default,,0,0,0,,‫إن لم تصدق قصة الأشباح التي رويتها لك،
Dialogue: 0,0:06:41.31,0:06:44.01,Default,,0,0,0,,‫فاذهب وتحدث مع بوتان في الغرفة 1!
Dialogue: 0,0:06:44.01,0:06:47.21,Default,,0,0,0,,‫ذلك الطالب الجامعي المتزمت ذو الرأس المربع!
Dialogue: 0,0:06:47.21,0:06:51.01,Default,,0,0,0,,‫نعم… أنا لم أرَه من قبل.
Dialogue: 0,0:06:51.01,0:06:55.61,Default,,0,0,0,,‫لا أؤمن إلا بما أستطيع فهمه علميًا.
Dialogue: 0,0:06:55.61,0:06:57.21,Default,,0,0,0,,‫"تسويهيكو بوتان (27)" -لكن هل تعرف ما الذي أكرهه أكثر من ذلك الآن؟
Dialogue: 0,0:06:57.21,0:07:01.81,Default,,0,0,0,,‫ذلك المبنى المقابل الذي ما يزال نصف مكتمل.
Dialogue: 0,0:07:01.81,0:07:04.21,Default,,0,0,0,,‫وماذا يعني ذلك؟
Dialogue: 0,0:07:04.21,0:07:06.41,Default,,0,0,0,,‫انظر إلى هذا.
Dialogue: 0,0:07:06.41,0:07:08.41,Default,,0,0,0,,‫ذلك المبنى يحجب ضوء الشمس،
Dialogue: 0,0:07:08.41,0:07:11.31,Default,,0,0,0,,‫لذا نادرًا ما تدخل الشمس إلى الغرفة.
Dialogue: 0,0:07:11.31,0:07:14.01,Default,,0,0,0,,‫هذا صحيح فعلًا.
Dialogue: 0,0:07:14.01,0:07:16.51,Default,,0,0,0,,‫غرفة السيد أوتوناشي التي تقع قطريًا فوقي أفضل بكثير من غرفتي،
Dialogue: 0,0:07:16.51,0:07:20.01,Default,,0,0,0,,‫لأن لديها نافذة مواجهة للشارع.
Dialogue: 0,0:07:20.01,0:07:22.71,Default,,0,0,0,,‫إذًا لماذا لا تنتقل؟
Dialogue: 0,0:07:22.71,0:07:24.41,Default,,0,0,0,,‫لأن الإيجار رخيص جدًا،
Dialogue: 0,0:07:24.41,0:07:27.61,Default,,0,0,0,,‫وجدتي قالت إن هذا المكان طالعُه جيد (فينغ شوي).
Dialogue: 0,0:07:28.81,0:07:32.71,Default,,0,0,0,,‫قلت إنك لا تؤمن إلا بما تفهمه علميًا؟
Dialogue: 0,0:07:32.71,0:07:35.61,Default,,0,0,0,,‫عذرًا…
Dialogue: 0,0:07:35.61,0:07:37.31,Default,,0,0,0,,‫هل يمكنني التدخين هنا؟
Dialogue: 0,0:07:37.31,0:07:39.01,Default,,0,0,0,,‫أوه، نعم تفضل.
Dialogue: 0,0:07:39.01,0:07:42.31,Default,,0,0,0,,‫لكن رجاءً غادر فور انتهائك من السيجارة!
Dialogue: 0,0:07:42.31,0:07:43.41,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:07:43.41,0:07:44.51,Default,,0,0,0,,‫سيجارة؟
Dialogue: 0,0:07:47.81,0:07:50.51,Default,,0,0,0,,‫أبي! ذراعك!
Dialogue: 0,0:07:50.51,0:07:51.91,Default,,0,0,0,,‫عثّةٌ مجددًا!
Dialogue: 0,0:07:52.91,0:07:55.31,Default,,0,0,0,,‫تبًّا! لماذا أنا دائمًا؟
Dialogue: 0,0:07:55.31,0:07:57.21,Default,,0,0,0,,‫أخرِجوها من الغرفة بسرعة! الآن!
Dialogue: 0,0:07:57.21,0:07:59.51,Default,,0,0,0,,‫هذا ما أحاول فعله الآن!
Dialogue: 0,0:08:10.71,0:08:12.11,Default,,0,0,0,,‫أفهم الآن…
Dialogue: 0,0:08:13.31,0:08:15.41,Default,,0,0,0,,‫كان الجناة خائفين
Dialogue: 0,0:08:15.41,0:08:17.91,Default,,0,0,0,,‫من أن تُكشف جريمتهم.
Dialogue: 0,0:08:17.91,0:08:19.31,Default,,0,0,0,,‫لذلك حاولوا تدمير الدليل الحاسم
Dialogue: 0,0:08:19.31,0:08:21.01,Default,,0,0,0,,‫الذي يخص المرأة التي أحرقوها حتى الموت قبل أربع سنوات.
Dialogue: 0,0:08:22.21,0:08:27.61,Default,,0,0,0,,‫استخدموا الأشباح للتستر على فعلتهم.
Dialogue: 0,0:08:29.31,0:08:30.81,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:08:30.81,0:08:32.41,Default,,0,0,0,,‫هل ستغادرون الآن؟
Dialogue: 0,0:08:32.41,0:08:34.71,Default,,0,0,0,,‫ما زال الليل في بدايته.
Dialogue: 0,0:08:34.71,0:08:35.81,Default,,0,0,0,,‫قد تفوتون رؤية
Dialogue: 0,0:08:35.81,0:08:38.41,Default,,0,0,0,,‫أحد أكثر الأشباح رعبًا في حياتكم.
Dialogue: 0,0:08:38.41,0:08:40.31,Default,,0,0,0,,‫سيئٌ أنكم سترحلون.
Dialogue: 0,0:08:40.31,0:08:42.61,Default,,0,0,0,,‫حسنًا… لا مشكلة لدي إن رحلتم الآن.
Dialogue: 0,0:08:42.61,0:08:45.81,Default,,0,0,0,,‫بهذا أستطيع أن أتابع كتابة بحثي.
Dialogue: 0,0:08:45.81,0:08:49.51,Default,,0,0,0,,‫حسنًا يا صديقي، اعتنِ بنفسك… وبلّغ الشبح سلامي.
Dialogue: 0,0:08:49.51,0:08:52.41,Default,,0,0,0,,‫يا لهم من غير اجتماعيين…
Dialogue: 0,0:08:54.41,0:08:55.61,Default,,0,0,0,,‫مسكونٌ بشبح؟ يا سلام!
Dialogue: 0,0:08:55.61,0:08:58.41,Default,,0,0,0,,‫يثيرون كل هذه الضجة بسبب أوهام.
Dialogue: 0,0:08:58.41,0:09:00.41,Default,,0,0,0,,‫أين كونان؟
Dialogue: 0,0:09:00.41,0:09:02.11,Default,,0,0,0,,‫ها هو هناك.
Dialogue: 0,0:09:02.11,0:09:03.61,Default,,0,0,0,,‫هيه! سنعود للبيت الآن!
Dialogue: 0,0:09:03.61,0:09:06.71,Default,,0,0,0,,‫أريد أن أتبول،
Dialogue: 0,0:09:06.71,0:09:09.51,Default,,0,0,0,,‫لكنني خائف قليلًا أن أذهب وحدي.
Dialogue: 0,0:09:09.51,0:09:11.81,Default,,0,0,0,,‫يا أبي… هل ترافقني من فضلك؟
Dialogue: 0,0:09:11.81,0:09:13.81,Default,,0,0,0,,‫يا إلهي…
Dialogue: 0,0:09:13.81,0:09:15.41,Default,,0,0,0,,‫هيا، ولماذا أفعل ذلك؟
Dialogue: 0,0:09:15.41,0:09:16.71,Default,,0,0,0,,‫حسنًا، حسنًا.
Dialogue: 0,0:09:16.71,0:09:18.51,Default,,0,0,0,,‫سأنتظر في الخارج إذًا.
Dialogue: 0,0:09:24.91,0:09:28.91,Default,,0,0,0,,‫أظنني رأيته في مكانٍ ما من قبل.
Dialogue: 0,0:09:34.01,0:09:35.31,Default,,0,0,0,,‫من هناك؟
Dialogue: 0,0:09:37.11,0:09:39.01,Default,,0,0,0,,‫يا فتى…
Dialogue: 0,0:09:39.01,0:09:40.61,Default,,0,0,0,,‫ظننت أنك ذهبت إلى البيت.
Dialogue: 0,0:09:41.11,0:09:43.01,Default,,0,0,0,,‫لدينا مشكلة.
Dialogue: 0,0:09:43.01,0:09:44.21,Default,,0,0,0,,‫مشكلة؟
Dialogue: 0,0:09:44.21,0:09:47.81,Default,,0,0,0,,‫انظر… ذلك المرحاض ملعون، لا شك في ذلك.
Dialogue: 0,0:09:49.31,0:09:52.01,Default,,0,0,0,,‫إنه كريه الرائحة جدًا ولا أستطيع سحب السيفون.
Dialogue: 0,0:09:55.71,0:09:58.11,Default,,0,0,0,,‫إنه فعلًا نتن… لكن…
Dialogue: 0,0:10:00.21,0:10:02.11,Default,,0,0,0,,‫لا يبدو أن هناك مشكلة في السيفون.
Dialogue: 0,0:10:06.41,0:10:07.71,Default,,0,0,0,,‫الماء…
Dialogue: 0,0:10:07.71,0:10:09.91,Default,,0,0,0,,‫الماء يتحول إلى الأحمر…
Dialogue: 0,0:10:09.91,0:10:11.21,Default,,0,0,0,,‫هذا…
Dialogue: 0,0:10:11.21,0:10:12.71,Default,,0,0,0,,‫هذا غير ممكن!
Dialogue: 0,0:10:12.71,0:10:17.01,Default,,0,0,0,,‫يا فتى… الآن تلفاز غرفتك ملعون أيضًا.
Dialogue: 0,0:10:18.01,0:10:20.91,Default,,0,0,0,,‫-ماذا؟ -انظر… هناك.
Dialogue: 0,0:10:20.91,0:10:22.71,Default,,0,0,0,,‫عودوا إلى البيت… عودوا إلى البيت…
Dialogue: 0,0:10:22.71,0:10:25.11,Default,,0,0,0,,‫الشبح! إنه الشبح! ماذا سنفعل؟
Dialogue: 0,0:10:26.21,0:10:29.41,Default,,0,0,0,,‫-اخرجوا حالًا! -هذا لا يُعقل…
Dialogue: 0,0:10:29.41,0:10:32.21,Default,,0,0,0,,‫-عودوا إلى البيت… -هذا لا يُعقل…
Dialogue: 0,0:10:32.21,0:10:33.61,Default,,0,0,0,,‫ماذا تفعل؟
Dialogue: 0,0:10:33.61,0:10:36.11,Default,,0,0,0,,‫لا يوجد شريط داخل الجهاز.
Dialogue: 0,0:10:36.11,0:10:38.01,Default,,0,0,0,,‫من هذا؟
Dialogue: 0,0:10:38.01,0:10:40.91,Default,,0,0,0,,‫من الذي يفعل هذا بحق الجحيم؟
Dialogue: 0,0:10:59.56,0:11:00.56,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:11:02.56,0:11:05.36,Default,,0,0,0,,‫إذًا ظهرت مرة أخرى… الشبح.
Dialogue: 0,0:11:05.36,0:11:06.76,Default,,0,0,0,,‫لا… لا يمكن.
Dialogue: 0,0:11:06.76,0:11:08.36,Default,,0,0,0,,‫لا بد أن هناك شيئًا غير صحيح.
Dialogue: 0,0:11:08.36,0:11:09.86,Default,,0,0,0,,‫لأن كل شيء كان…
Dialogue: 0,0:11:10.96,0:11:12.46,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:11:12.46,0:11:17.76,Default,,0,0,0,,‫كلها خدعٌ لجعل الأمر يبدو كأنه من فعل الشبح.
Dialogue: 0,0:11:17.76,0:11:20.16,Default,,0,0,0,,‫وتقول إنه لا أحد سواك
Dialogue: 0,0:11:20.16,0:11:23.66,Default,,0,0,0,,‫يمكنه إعداد هذه الخدع لأنك أنت من صنعها،
Dialogue: 0,0:11:23.66,0:11:26.96,Default,,0,0,0,,‫أليس كذلك يا سيد بانتشو؟
Dialogue: 0,0:11:29.76,0:11:31.76,Default,,0,0,0,,‫خدع؟ كيف تقول ذلك؟
Dialogue: 0,0:11:31.76,0:11:33.86,Default,,0,0,0,,‫يا رجل… تتصرف كمحقق أو شيء كهذا…
Dialogue: 0,0:11:33.86,0:11:36.16,Default,,0,0,0,,‫محقق؟
Dialogue: 0,0:11:36.16,0:11:39.76,Default,,0,0,0,,‫لا تقل إنك المحقق الشهير "كوغورو النائم"!
Dialogue: 0,0:11:39.76,0:11:41.66,Default,,0,0,0,,‫نعم، هذا صحيح.
Dialogue: 0,0:11:41.66,0:11:44.96,Default,,0,0,0,,‫والآن سأفكّ
Dialogue: 0,0:11:44.96,0:11:49.46,Default,,0,0,0,,‫ألغاز كثير من الظواهر الخارقة.
Dialogue: 0,0:11:49.46,0:11:53.06,Default,,0,0,0,,‫أولًا… بخصوص تحوّل ماء المرحاض إلى الأحمر.
Dialogue: 0,0:11:53.06,0:11:56.56,Default,,0,0,0,,‫ما لاحظته هو أنه عندما دخلتُ دورة المياه،
Dialogue: 0,0:11:56.56,0:11:59.46,Default,,0,0,0,,‫كانت رائحته نفّاذة جدًا كرائحة الأمونيا،
Dialogue: 0,0:11:59.46,0:12:04.06,Default,,0,0,0,,‫كما أن خزان المرحاض كانت تفوح منه رائحة كحول خفيفة.
Dialogue: 0,0:12:04.06,0:12:06.36,Default,,0,0,0,,‫أمونيا… وكحول؟
Dialogue: 0,0:12:06.36,0:12:09.36,Default,,0,0,0,,‫ربما أجريتَ تجربة في حصص العلوم
Dialogue: 0,0:12:09.36,0:12:12.06,Default,,0,0,0,,‫أيام المرحلة الابتدائية، أتذكر؟
Dialogue: 0,0:12:12.06,0:12:16.16,Default,,0,0,0,,‫عندما تُضيف قطرةً واحدة من محلول الأمونيا القلوي
Dialogue: 0,0:12:16.16,0:12:20.56,Default,,0,0,0,,‫إلى محلول الفينولفثالين عديم اللون المذاب في الكحول،
Dialogue: 0,0:12:20.56,0:12:24.36,Default,,0,0,0,,‫يظهر اللون الأحمر وكأنه سحر.
Dialogue: 0,0:12:24.36,0:12:27.36,Default,,0,0,0,,‫نعم، لكن هل سيعمل بهذه الدرجة من الإتقان؟
Dialogue: 0,0:12:27.36,0:12:30.96,Default,,0,0,0,,‫لون التجربة ليس أحمرَ فاقعًا بل أحمرَ مائلًا للوردي.
Dialogue: 0,0:12:30.96,0:12:32.86,Default,,0,0,0,,‫لا يمكن أن يلتبس اللون على أحد.
Dialogue: 0,0:12:32.86,0:12:33.86,Default,,0,0,0,,‫نعم، صحيح.
Dialogue: 0,0:12:33.86,0:12:39.06,Default,,0,0,0,,‫لكنّه سيبدو كالدم في دورة مياهٍ خافتة الإضاءة كهذه.
Dialogue: 0,0:12:39.06,0:12:43.56,Default,,0,0,0,,‫ومع ذلك، لن يحدث تفاعلٌ كيميائي مع البول
Dialogue: 0,0:12:43.56,0:12:50.06,Default,,0,0,0,,‫لأن الأمونيا في بولنا تكون حمضية أو متعادلة،
Dialogue: 0,0:12:50.06,0:12:52.26,Default,,0,0,0,,‫وليست قلوية.
Dialogue: 0,0:12:52.26,0:12:56.26,Default,,0,0,0,,‫نعم، ولهذا كان يحتاج إلى…
Dialogue: 0,0:12:56.26,0:12:58.26,Default,,0,0,0,,‫هذا السائل من الأمونيا.
Dialogue: 0,0:12:58.26,0:13:00.26,Default,,0,0,0,,‫إنه…
Dialogue: 0,0:13:00.26,0:13:03.36,Default,,0,0,0,,‫يُسكَب في ماء حوض المرحاض،
Dialogue: 0,0:13:03.36,0:13:06.16,Default,,0,0,0,,‫ثم يُسكَب الفينولفثالين في ماء خزان المرحاض.
Dialogue: 0,0:13:06.16,0:13:08.46,Default,,0,0,0,,‫وعندها يحدث التفاعل الكيميائي،
Dialogue: 0,0:13:08.46,0:13:11.36,Default,,0,0,0,,‫ولن يشك أحدٌ برائحة الأمونيا القوية
Dialogue: 0,0:13:11.36,0:13:13.26,Default,,0,0,0,,‫مع رؤية هذه الحمّام القذر.
Dialogue: 0,0:13:13.26,0:13:15.16,Default,,0,0,0,,‫بالضبط.
Dialogue: 0,0:13:15.16,0:13:18.76,Default,,0,0,0,,‫لكن من أين حصلتَ على تلك المادة الكيميائية يا فتى؟
Dialogue: 0,0:13:18.76,0:13:20.96,Default,,0,0,0,,‫أبي طلب مني أن أبحث عنها.
Dialogue: 0,0:13:20.96,0:13:23.66,Default,,0,0,0,,‫لذا عندما كنتم تودّعون عند المدخل،
Dialogue: 0,0:13:23.66,0:13:26.56,Default,,0,0,0,,‫تسللتُ إلى الغرفة ووجدتها…
Dialogue: 0,0:13:26.56,0:13:28.56,Default,,0,0,0,,‫في هذه الغرفة يا سيد بانتشو.
Dialogue: 0,0:13:29.56,0:13:31.76,Default,,0,0,0,,‫ووجدتُ أيضًا أشياء أخرى مثيرة للاهتمام
Dialogue: 0,0:13:31.76,0:13:36.06,Default,,0,0,0,,‫مثل الفينولفثالين والكلوروفورم.
Dialogue: 0,0:13:36.06,0:13:39.06,Default,,0,0,0,,‫بل وحتى شريط فيديو لفيلمٍ مرعب.
Dialogue: 0,0:13:39.06,0:13:40.96,Default,,0,0,0,,‫شريط فيلمٍ مرعب؟
Dialogue: 0,0:13:40.96,0:13:42.06,Default,,0,0,0,,‫نعم!
Dialogue: 0,0:13:42.06,0:13:48.16,Default,,0,0,0,,‫الشريط الذي تظهر فيه امرأة شبح تقول: "عودوا إلى البيت… عودوا إلى البيت."
Dialogue: 0,0:13:48.16,0:13:49.46,Default,,0,0,0,,‫هيه…
Dialogue: 0,0:13:49.46,0:13:51.26,Default,,0,0,0,,‫لا تقل لي أن…
Dialogue: 0,0:13:51.26,0:13:59.06,Default,,0,0,0,,‫نعم. الشبح الذي رأته ابنتي ران على شاشة التلفاز…
Dialogue: 0,0:13:59.06,0:14:04.26,Default,,0,0,0,,‫كان لقطات بثّها السيد بانتشو من جهاز الفيديو في غرفته.
Dialogue: 0,0:14:04.26,0:14:07.26,Default,,0,0,0,,‫بثَّ اللقطات؟ كيف؟
Dialogue: 0,0:14:07.26,0:14:08.86,Default,,0,0,0,,‫الأمر بسيط وسهل
Dialogue: 0,0:14:08.86,0:14:12.26,Default,,0,0,0,,‫إذا استخدمتَ هوائي البناية المشترك.
Dialogue: 0,0:14:13.46,0:14:18.76,Default,,0,0,0,,‫تُوصل سلك الهوائي بمنفذ الإخراج في جهاز الفيديو بغرفته
Dialogue: 0,0:14:18.76,0:14:22.36,Default,,0,0,0,,‫ثم تُرسل الصورة إلى الهوائي.
Dialogue: 0,0:14:22.36,0:14:26.26,Default,,0,0,0,,‫وبالتالي يرسل الهوائي الصورة إلى التلفاز
Dialogue: 0,0:14:26.26,0:14:29.26,Default,,0,0,0,,‫في غرفة السيد أوتوناشي.
Dialogue: 0,0:14:29.26,0:14:32.26,Default,,0,0,0,,‫لكن لكي تفعل ذلك،
Dialogue: 0,0:14:32.26,0:14:34.16,Default,,0,0,0,,‫يجب أن تتمكن من ضبط قناة التلفاز
Dialogue: 0,0:14:34.16,0:14:37.36,Default,,0,0,0,,‫على القناة المناسبة لاستقبال الصورة.
Dialogue: 0,0:14:37.36,0:14:39.96,Default,,0,0,0,,‫ويجب أيضًا تشغيل التلفاز أولًا، فكيف تظن…؟
Dialogue: 0,0:14:39.96,0:14:41.86,Default,,0,0,0,,‫إنه جهاز تحكم متعدد القنوات.
Dialogue: 0,0:14:42.86,0:14:44.66,Default,,0,0,0,,‫سيد أوتوناشي…
Dialogue: 0,0:14:44.66,0:14:47.66,Default,,0,0,0,,‫بمجرد إدخال اسم شركة التلفاز أو الفيديو في الجهاز،
Dialogue: 0,0:14:47.66,0:14:51.26,Default,,0,0,0,,‫يمكنك التحكم بأي تلفاز أو جهاز فيديو من نفس الشركة.
Dialogue: 0,0:14:51.26,0:14:52.86,Default,,0,0,0,,‫وبذلك تستطيع تشغيل تلفاز شخصٍ آخر
Dialogue: 0,0:14:52.86,0:14:54.66,Default,,0,0,0,,‫من دون أن يلاحظ المالك شيئًا.
Dialogue: 0,0:14:54.66,0:14:57.26,Default,,0,0,0,,‫وبعد أن عرفتُ كيف تعمل الخدعة،
Dialogue: 0,0:14:57.26,0:14:58.96,Default,,0,0,0,,‫صار الأمر سهلًا جدًا حتى بالنسبة لي.
Dialogue: 0,0:14:58.96,0:15:00.56,Default,,0,0,0,,‫لا تقل لي…
Dialogue: 0,0:15:00.56,0:15:02.36,Default,,0,0,0,,‫أن هذا العجوز هو من بثّ الصور
Dialogue: 0,0:15:02.36,0:15:04.26,Default,,0,0,0,,‫على شاشة تلفازي قبل قليل؟
Dialogue: 0,0:15:04.26,0:15:08.96,Default,,0,0,0,,‫نعم، جعلته يساعدني في بثّ الفيديو الذي "استعرته" منك للتو.
Dialogue: 0,0:15:09.96,0:15:13.36,Default,,0,0,0,,‫لقد استخدمتَ جهاز التحكم
Dialogue: 0,0:15:13.36,0:15:15.96,Default,,0,0,0,,‫من خارج نافذة غرفة السيد أوتوناشي،
Dialogue: 0,0:15:15.96,0:15:20.06,Default,,0,0,0,,‫المواجهة للمبنى قيد الإنشاء.
Dialogue: 0,0:15:21.06,0:15:22.46,Default,,0,0,0,,‫وباستخدام الجدار كنقطة ارتكاز،
Dialogue: 0,0:15:22.46,0:15:28.76,Default,,0,0,0,,‫يمكنك بسهولة إرسال الإشارات إلى جهاز تلفازه من هناك.
Dialogue: 0,0:15:28.76,0:15:31.16,Default,,0,0,0,,‫ولم تكن بحاجة حتى لرؤية شاشة التلفاز
Dialogue: 0,0:15:31.16,0:15:34.06,Default,,0,0,0,,‫لأنك تستطيع سماع الصوت وضبط القناة.
Dialogue: 0,0:15:34.06,0:15:36.96,Default,,0,0,0,,‫وبينما كانت الشمس لا تزال في السماء،
Dialogue: 0,0:15:36.96,0:15:40.46,Default,,0,0,0,,‫سكبتَ الكلوروفورم على حافة النافذة
Dialogue: 0,0:15:40.46,0:15:43.86,Default,,0,0,0,,‫كي ننام جميعًا نحن الذين كنا في الغرفة.
Dialogue: 0,0:15:43.86,0:15:45.36,Default,,0,0,0,,‫ظننتَ أنك ستجعل
Dialogue: 0,0:15:45.36,0:15:48.86,Default,,0,0,0,,‫أحدَنا الذي يُغمى عليه فجأة
Dialogue: 0,0:15:48.86,0:15:53.86,Default,,0,0,0,,‫ويستيقظ في الغرفة المظلمة وهو لا يزال مُشوَّش الذهن
Dialogue: 0,0:15:53.86,0:15:56.76,Default,,0,0,0,,‫يرى وَهْمًا مرعبًا… أليس كذلك؟
Dialogue: 0,0:15:56.76,0:15:58.96,Default,,0,0,0,,‫أفهم…
Dialogue: 0,0:15:58.96,0:16:01.76,Default,,0,0,0,,‫لكن ذلك كان حقيقيًا، أليس كذلك؟
Dialogue: 0,0:16:01.76,0:16:05.86,Default,,0,0,0,,‫أعني هيئةَ الشخص التي كانت تنظر نحونا.
Dialogue: 0,0:16:05.86,0:16:09.46,Default,,0,0,0,,‫أوه، هذا ليس شخصًا أصلًا!
Dialogue: 0,0:16:09.46,0:16:10.96,Default,,0,0,0,,‫-ماذا؟ -اقترب وانظر جيدًا،
Dialogue: 0,0:16:10.96,0:16:12.66,Default,,0,0,0,,‫وسترى ما هو.
Dialogue: 0,0:16:16.56,0:16:19.76,Default,,0,0,0,,‫هذا…
Dialogue: 0,0:16:19.76,0:16:21.06,Default,,0,0,0,,‫عثّة!
Dialogue: 0,0:16:21.06,0:16:23.16,Default,,0,0,0,,‫عثٌّ متجمع بأعدادٍ كبيرة.
Dialogue: 0,0:16:23.16,0:16:24.66,Default,,0,0,0,,‫أو بالأدق،
Dialogue: 0,0:16:24.66,0:16:27.06,Default,,0,0,0,,‫تجمّعٌ لعثٍّ ذكور.
Dialogue: 0,0:16:27.06,0:16:28.66,Default,,0,0,0,,‫لقد طلى الشبّاك على هيئة إنسان
Dialogue: 0,0:16:28.66,0:16:30.16,Default,,0,0,0,,‫بفيرومون أنثى العثّ،
Dialogue: 0,0:16:30.16,0:16:32.86,Default,,0,0,0,,‫وهو يُستخدم أيضًا كمبيدٍ حشري،
Dialogue: 0,0:16:32.86,0:16:37.16,Default,,0,0,0,,‫ثم ألصق عليه عينين وفمًا من ورقٍ أسود.
Dialogue: 0,0:16:37.16,0:16:40.26,Default,,0,0,0,,‫فاجتذبت رائحة الفيرومون ذكورَ العثّ،
Dialogue: 0,0:16:40.26,0:16:41.96,Default,,0,0,0,,‫فتجمّعت عليه ليبدو وكأن ظلَّ إنسان
Dialogue: 0,0:16:41.96,0:16:44.26,Default,,0,0,0,,‫ينظر إلى الداخل عبر النافذة.
Dialogue: 0,0:16:44.26,0:16:49.26,Default,,0,0,0,,‫في الحقيقة، ظل العثّ يقترب من ذراعي عدة مرات.
Dialogue: 0,0:16:50.46,0:16:52.66,Default,,0,0,0,,‫عندما كدتُ أسقط من النافذة
Dialogue: 0,0:16:52.66,0:16:55.46,Default,,0,0,0,,‫التي رأيتُ منها الهيئة أول مرة،
Dialogue: 0,0:16:56.86,0:17:01.26,Default,,0,0,0,,‫وجدتُ نفسي أمسك بالشبّاك،
Dialogue: 0,0:17:01.26,0:17:04.06,Default,,0,0,0,,‫فعلِق الفيرومون بذراعي وجذب العثّ إليّ.
Dialogue: 0,0:17:04.06,0:17:05.26,Default,,0,0,0,,‫إذًا هذا يعني…
Dialogue: 0,0:17:05.26,0:17:07.76,Default,,0,0,0,,‫لقد نزعتُ الشبّاك من الطابق الثاني
Dialogue: 0,0:17:07.76,0:17:11.86,Default,,0,0,0,,‫ووضعته عند نافذة الطابق الأول. هذا كل ما في الأمر.
Dialogue: 0,0:17:11.86,0:17:16.16,Default,,0,0,0,,‫وبالمناسبة، سبب اختفاء الهيئة من تلقاء نفسها
Dialogue: 0,0:17:16.16,0:17:20.66,Default,,0,0,0,,‫هو أن الضوء الأسود لدى السيد بانتشو
Dialogue: 0,0:17:20.66,0:17:25.06,Default,,0,0,0,,‫اشتغل بمؤقّتٍ زمني وأضاء من نافذة غرفته الواقعة قطريًا بالأسفل.
Dialogue: 0,0:17:26.06,0:17:27.86,Default,,0,0,0,,‫فالعيـثّ ينجذب أكثر
Dialogue: 0,0:17:27.86,0:17:32.96,Default,,0,0,0,,‫للأشعة فوق البنفسجية الصادرة من الضوء الأسود، أكثر من الفيرومون.
Dialogue: 0,0:17:32.96,0:17:37.96,Default,,0,0,0,,‫لكن الخدعة ستنكشف إن بقيت عثّةٌ واحدة.
Dialogue: 0,0:17:37.96,0:17:40.26,Default,,0,0,0,,‫لذلك أسرع السيد بانتشو إلى النافذة
Dialogue: 0,0:17:40.26,0:17:43.76,Default,,0,0,0,,‫حالما بدأت العثّات تطير مبتعدة،
Dialogue: 0,0:17:43.76,0:17:45.76,Default,,0,0,0,,‫ثم فتح النافذة والشبّاك معًا.
Dialogue: 0,0:17:45.76,0:17:51.46,Default,,0,0,0,,‫فقوة الصدمة أطاحت بالعثّ عن الشبّاك تمامًا.
Dialogue: 0,0:17:51.46,0:17:55.36,Default,,0,0,0,,‫سيد بانتشو… لقد تظاهرتَ بعدم ملاحظة العثّ
Dialogue: 0,0:17:55.36,0:17:58.86,Default,,0,0,0,,‫حتى عندما اقتربتَ من النافذة، صحيح؟
Dialogue: 0,0:17:58.86,0:18:04.56,Default,,0,0,0,,‫لأنك أنت من افتعل هذه الضجة عمدًا حول الشبح!
Dialogue: 0,0:18:04.56,0:18:07.76,Default,,0,0,0,,‫لكنني ما زلت لا أفهم…
Dialogue: 0,0:18:07.76,0:18:13.36,Default,,0,0,0,,‫كل المواد الكيميائية عدا الكلوروفورم يمكن الحصول عليها بسهولة، لكن لماذا…
Dialogue: 0,0:18:13.36,0:18:14.96,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:18:14.96,0:18:18.86,Default,,0,0,0,,‫كان بإمكان السيد بانتشو أن يصنع الفيديو بسهولة،
Dialogue: 0,0:18:18.86,0:18:20.96,Default,,0,0,0,,‫مستخدمًا مجسّماته المخيفة وصوته المصطنع…
Dialogue: 0,0:18:20.96,0:18:25.46,Default,,0,0,0,,‫لماذا تكلّف عناء اختلاق قصة شبح؟
Dialogue: 0,0:18:25.46,0:18:29.16,Default,,0,0,0,,‫لقد حاول إخافتنا نحن ضيوف السيد أوتوناشي،
Dialogue: 0,0:18:29.16,0:18:31.16,Default,,0,0,0,,‫كي يقرر السيد أوتوناشي الذي رفض الانتقال من هنا
Dialogue: 0,0:18:31.16,0:18:34.66,Default,,0,0,0,,‫أن يرحل أخيرًا بعد كل هذا الرعب.
Dialogue: 0,0:18:34.66,0:18:39.26,Default,,0,0,0,,‫ربما… للتستر على جريمةٍ وقعت قبل أربع سنوات.
Dialogue: 0,0:18:41.56,0:18:42.96,Default,,0,0,0,,‫جريمة قبل أربع سنوات؟
Dialogue: 0,0:18:42.96,0:18:44.76,Default,,0,0,0,,‫تقصد جريمة قتل المرأة التي أُحرقت حتى الموت
Dialogue: 0,0:18:44.76,0:18:47.16,Default,,0,0,0,,‫في الحديقة أمامنا مباشرة؟
Dialogue: 0,0:18:47.16,0:18:52.56,Default,,0,0,0,,‫قلت إنك رأيت شمعة الموت في ذلك المبنى قيد الإنشاء؟
Dialogue: 0,0:18:52.56,0:18:54.46,Default,,0,0,0,,‫نعم، هذا صحيح.
Dialogue: 0,0:18:54.46,0:18:56.46,Default,,0,0,0,,‫ما كان يطفو في الهواء لم يكن "شمعة موت"،
Dialogue: 0,0:18:56.46,0:18:59.26,Default,,0,0,0,,‫بل سيجارةً مشتعلة.
Dialogue: 0,0:19:00.66,0:19:03.06,Default,,0,0,0,,‫وما كان يتوهّج بالأبيض المزرق
Dialogue: 0,0:19:03.06,0:19:07.76,Default,,0,0,0,,‫كان ضوء تلفازٍ محمول كان يشاهده أحدهم خِفية.
Dialogue: 0,0:19:08.76,0:19:12.46,Default,,0,0,0,,‫لا تقل إن هناك شخصًا داخل ذلك المبنى؟
Dialogue: 0,0:19:12.46,0:19:14.66,Default,,0,0,0,,‫نعم… مستغلًا أن المبنى لا يزال قيد الإنشاء،
Dialogue: 0,0:19:14.66,0:19:17.16,Default,,0,0,0,,‫كان يعيش مختبئًا هناك.
Dialogue: 0,0:19:17.16,0:19:20.06,Default,,0,0,0,,‫إنه أحد الرجلين اللذين شهدهما الناس قبل أربع سنوات
Dialogue: 0,0:19:20.06,0:19:22.26,Default,,0,0,0,,‫وقت الجريمة…
Dialogue: 0,0:19:22.26,0:19:24.86,Default,,0,0,0,,‫صاحب الندبة على خدّه.
Dialogue: 0,0:19:24.86,0:19:28.46,Default,,0,0,0,,‫ربما… السيد بانتشو هو الرجل الآخر من القاتلين،
Dialogue: 0,0:19:29.86,0:19:33.06,Default,,0,0,0,,‫الذي لم يتمكن الشاهد من رؤية وجهه بسبب الظلام.
Dialogue: 0,0:19:33.06,0:19:35.86,Default,,0,0,0,,‫…
Dialogue: 0,0:19:37.36,0:19:39.76,Default,,0,0,0,,‫وبما أن ضوء السيجارة شوهد،
Dialogue: 0,0:19:39.76,0:19:42.56,Default,,0,0,0,,‫وكان أمر وجود شخص هناك سيفتضح،
Dialogue: 0,0:19:42.56,0:19:44.76,Default,,0,0,0,,‫فافتعلتَ ودفعتَ قصة "فتاة الشبح" لتنتشر،
Dialogue: 0,0:19:44.76,0:19:47.36,Default,,0,0,0,,‫وطردتَ سكان الطابق الثاني من هذه البناية
Dialogue: 0,0:19:47.36,0:19:49.56,Default,,0,0,0,,‫واحدًا تلو الآخر… لأنهم الوحيدون
Dialogue: 0,0:19:49.56,0:19:51.46,Default,,0,0,0,,‫الذين يمكنهم رؤية داخل المبنى من غرفهم!
Dialogue: 0,0:19:52.46,0:19:53.96,Default,,0,0,0,,‫لو أُلقي القبض عليه،
Dialogue: 0,0:19:53.96,0:19:57.46,Default,,0,0,0,,‫لسَمّى شريكه في جريمة قبل أربع سنوات،
Dialogue: 0,0:19:57.46,0:20:01.06,Default,,0,0,0,,‫وكنتَ ستدخل السجن.
Dialogue: 0,0:20:01.06,0:20:03.06,Default,,0,0,0,,‫ولهذا تعيش هنا،
Dialogue: 0,0:20:03.06,0:20:06.76,Default,,0,0,0,,‫لتجلب لذلك الرجل ذي الندبة طعامه وشرابه،
Dialogue: 0,0:20:06.76,0:20:10.16,Default,,0,0,0,,‫لأن الندبة ستفضحه إن ظهر.
Dialogue: 0,0:20:11.16,0:20:13.46,Default,,0,0,0,,‫كنتَ تخطط للتسلل والهرب
Dialogue: 0,0:20:13.46,0:20:16.96,Default,,0,0,0,,‫بعد أن تهدأ الأمور قليلًا… لكن فات الأوان الآن.
Dialogue: 0,0:20:16.96,0:20:19.86,Default,,0,0,0,,‫اسمع… أنت تسمعه، أليس كذلك؟
Dialogue: 0,0:20:19.86,0:20:22.56,Default,,0,0,0,,‫خطوات الهلاك…
Dialogue: 0,0:20:22.56,0:20:26.06,Default,,0,0,0,,‫إنه صوت صفّارة سيارة الشرطة التي اتصلتُ بها.
Dialogue: 0,0:20:31.06,0:20:32.96,Default,,0,0,0,,‫تبًّا!
Dialogue: 0,0:20:32.96,0:20:34.46,Default,,0,0,0,,‫ابتعدوا عن طريقي! تحرّكوا!
Dialogue: 0,0:20:34.46,0:20:36.26,Default,,0,0,0,,‫انتظر…
Dialogue: 0,0:20:36.26,0:20:38.36,Default,,0,0,0,,‫ران، لا تدعيه يمرّ!
Dialogue: 0,0:20:38.36,0:20:39.36,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:20:39.36,0:20:41.16,Default,,0,0,0,,‫ابتعدي عن طريقي يا امرأة،
Dialogue: 0,0:20:41.16,0:20:43.86,Default,,0,0,0,,‫وإلا لعنتُك حتى الموت!
Dialogue: 0,0:20:43.86,0:20:45.06,Default,,0,0,0,,‫ماذا قلتَ للتو؟
Dialogue: 0,0:20:58.76,0:21:01.66,Default,,0,0,0,,‫إن لم تكن شبحًا… فلن تُخيفني أبدًا!
Dialogue: 0,0:21:05.26,0:21:07.06,Default,,0,0,0,,‫لكمةٌ خلفية.
Dialogue: 0,0:21:09.36,0:21:12.56,Default,,0,0,0,,‫وصلت الشرطة بعد ذلك بوقتٍ قصير.
Dialogue: 0,0:21:12.56,0:21:15.36,Default,,0,0,0,,‫صاحب هذا "البيت المسكون"
Dialogue: 0,0:21:15.36,0:21:19.26,Default,,0,0,0,,‫ورجل "شمعة الموت" المختبئ في المبنى تم اعتقالهما.
Dialogue: 0,0:21:19.26,0:21:20.56,Default,,0,0,0,,‫وهكذا انتهت قضية ترويع البيت المسكون
Dialogue: 0,0:21:20.56,0:21:22.16,Default,,0,0,0,,‫ومعها قضية القتل التي حدثت قبل أربع سنوات،
Dialogue: 0,0:21:22.16,0:21:23.56,Default,,0,0,0,,‫وأُغلقت الملفات.
Dialogue: 0,0:21:25.76,0:21:27.36,Default,,0,0,0,,‫وبالمناسبة، جريمة القتل قبل أربع سنوات وقعت
Dialogue: 0,0:21:27.36,0:21:30.56,Default,,0,0,0,,‫بسبب مشاكل مالية.
Dialogue: 0,0:21:30.56,0:21:35.66,Default,,0,0,0,,‫يا لها من قضية دنيوية بسبب المال خلف قضية شبحٍ تبدو غير دنيوية.
Dialogue: 0,0:23:07.26,0:23:10.46,Default,,0,0,0,,‫إذًا كل تلك الأشباح كانت خدعًا في النهاية.
Dialogue: 0,0:23:10.46,0:23:13.36,Default,,0,0,0,,‫نعم… لم أعد أبالي بها.
Dialogue: 0,0:23:13.36,0:23:15.16,Default,,0,0,0,,‫لا وجود لها أصلًا.
Dialogue: 0,0:23:18.16,0:23:19.36,Default,,0,0,0,,‫ما بكِ يا سونوكو؟
Dialogue: 0,0:23:23.76,0:23:25.36,Default,,0,0,0,,‫هيه، سونوكو.
Dialogue: 0,0:23:25.36,0:23:28.26,Default,,0,0,0,,‫هل تبكين؟ لماذا؟
Dialogue: 0,0:23:28.26,0:23:29.26,Default,,0,0,0,,‫لأن…
Dialogue: 0,0:23:29.26,0:23:31.26,Default,,0,0,0,,‫لأنك عندما تتكلم هكذا،
Dialogue: 0,0:23:31.26,0:23:33.96,Default,,0,0,0,,‫لا أستطيع أن أُظهر حقيقتي، أليس كذلك؟
Dialogue: 0,0:23:35.96,0:23:38.56,Default,,0,0,0,,‫لا!
Dialogue: 0,0:23:41.36,0:23:43.96,Default,,0,0,0,,‫أعطي نفسي حقًا الفضل على هذا المكياج المتقن!
Dialogue: 0,0:23:43.96,0:23:47.06,Default,,0,0,0,,‫خوف ران من الأشباح إحدى نقاط سحرها،
Dialogue: 0,0:23:47.06,0:23:49.66,Default,,0,0,0,,‫فمن المؤسف معالجته.
Dialogue: 0,0:23:49.66,0:23:52.36,Default,,0,0,0,,‫-ألا تظن ذلك؟ -بلى.
Dialogue: 0,0:23:52.36,0:23:55.76,Default,,0,0,0,,‫أظن أنك أنت يجب أن تُصلح شخصيتك أولًا.
Dialogue: 0,0:24:02.78,0:24:05.10,Default,,0,0,0,,‫تلميح كونان القادم:
Dialogue: 0,0:24:05.34,0:24:07.16,Default,,0,0,0,,‫"بوفيه مفتوح"
