Dialogue: 0,0:00:03.03,0:00:04.73,Default,,0,0,0,,‫إن ما يكمن في قلب الإنسان يظل لغزًا علينا جميعًا.
Dialogue: 0,0:00:04.73,0:00:06.73,Default,,0,0,0,,‫النجوم والثلج يتلألآن فوق الاثنين.
Dialogue: 0,0:00:06.73,0:00:10.33,Default,,0,0,0,,‫نانيوَا هي مسرح مواجهة ثنائية بين كونان وهيجي.
Dialogue: 0,0:00:10.33,0:00:11.83,Default,,0,0,0,,‫إنه يرى الحقيقة الوحيدة بوضوح.
Dialogue: 0,0:00:11.83,0:00:13.63,Default,,0,0,0,,‫طفل في مظهره، بعقل رجل بالغ.
Dialogue: 0,0:00:13.63,0:00:15.53,Default,,0,0,0,,‫اسمه المحقق كونان!
Dialogue: 0,0:01:52.43,0:01:55.13,Default,,0,0,0,,‫«لغز أوساكا المزدوج:»
Dialogue: 0,0:01:55.13,0:01:58.13,Default,,0,0,0,,‫«سيف نانيوَا وقلعة تويوتومي هيديوشي»
Dialogue: 0,0:01:58.53,0:02:01.73,Default,,0,0,0,,‫«صالة نانيوَا المركزية»
Dialogue: 0,0:02:03.33,0:02:05.23,Default,,0,0,0,,‫ضربة على القناع!
Dialogue: 0,0:02:05.23,0:02:06.63,Default,,0,0,0,,‫انتهت المباراة!
Dialogue: 0,0:02:06.63,0:02:09.03,Default,,0,0,0,,‫أحسنت! ثلاث انتصارات وتعادل واحد،
Dialogue: 0,0:02:09.03,0:02:11.43,Default,,0,0,0,,‫وبهذا يتأهل للتصفيات!
Dialogue: 0,0:02:11.43,0:02:15.33,Default,,0,0,0,,‫صحيح، جميع أعضاء فريق ثانوية كايهو هذا العام أقوياء.
Dialogue: 0,0:02:15.33,0:02:18.53,Default,,0,0,0,,‫لم يُهزموا حتى الآن في منافسات المجموعة.
Dialogue: 0,0:02:18.53,0:02:20.63,Default,,0,0,0,,‫سيدة هاتوري، لا تتحمسي كثيرًا
Dialogue: 0,0:02:20.63,0:02:22.03,Default,,0,0,0,,‫حتى تشاهدي قائد فريقنا.
Dialogue: 0,0:02:22.03,0:02:24.83,Default,,0,0,0,,‫هيجي أصبح أقوى من الشيطان.
Dialogue: 0,0:02:24.83,0:02:27.63,Default,,0,0,0,,‫أوه؟ هل هيجي قائد فريق كايهو؟
Dialogue: 0,0:02:27.63,0:02:30.53,Default,,0,0,0,,‫إنه لا يخبرنا بشيء في المنزل.
Dialogue: 0,0:02:30.53,0:02:33.03,Default,,0,0,0,,‫قائد فريق ثانوية كايهو، تقدم!
Dialogue: 0,0:02:33.03,0:02:34.03,Default,,0,0,0,,‫نعم سيدي.
Dialogue: 0,0:02:35.93,0:02:38.53,Default,,0,0,0,,‫هاه؟ هذا ليس هيجي.
Dialogue: 0,0:02:38.53,0:02:41.13,Default,,0,0,0,,‫أليس هو هناك؟
Dialogue: 0,0:02:41.13,0:02:45.13,Default,,0,0,0,,‫هناك، محاطًا بكل تلك الفتيات ويتحدث بلا توقف.
Dialogue: 0,0:02:45.83,0:02:46.93,Default,,0,0,0,,‫هيجي!
Dialogue: 0,0:02:46.93,0:02:48.43,Default,,0,0,0,,‫ما الذي تفعله هنا؟ تكف عن العبث!
Dialogue: 0,0:02:48.43,0:02:51.83,Default,,0,0,0,,‫المباراة بدأت بالفعل! عليك أن تسرع!
Dialogue: 0,0:02:51.83,0:02:53.83,Default,,0,0,0,,‫ما بك؟ تبدو شاحبًا.
Dialogue: 0,0:02:56.03,0:02:57.43,Default,,0,0,0,,‫مرحبًا.
Dialogue: 0,0:02:57.43,0:02:59.83,Default,,0,0,0,,‫أعرفك، أنت طالب في الصف الثاني، أليس كذلك؟
Dialogue: 0,0:02:59.83,0:03:02.53,Default,,0,0,0,,‫هيجي طلب مني أن أُنوب عنه.
Dialogue: 0,0:03:02.53,0:03:05.53,Default,,0,0,0,,‫قال إننا على الأرجح لن نحتاجه حتى نصف النهائي،
Dialogue: 0,0:03:05.53,0:03:06.63,Default,,0,0,0,,‫لذا طلب مني أن أرتدي معداته
Dialogue: 0,0:03:06.63,0:03:09.03,Default,,0,0,0,,‫وأن أُرهب الفريق الآخر فقط.
Dialogue: 0,0:03:09.03,0:03:13.03,Default,,0,0,0,,‫لكن هيجي مشهور جدًا، فاجتمعت الفتيات حولي
Dialogue: 0,0:03:13.03,0:03:14.63,Default,,0,0,0,,‫حالما رأين اسمه على الزي.
Dialogue: 0,0:03:15.73,0:03:17.93,Default,,0,0,0,,‫إذن، إلى أين ذهب هيجي؟
Dialogue: 0,0:03:17.93,0:03:19.83,Default,,0,0,0,,‫أظنه ذهب إلى دورة المياه.
Dialogue: 0,0:03:19.83,0:03:22.73,Default,,0,0,0,,‫رأيته يتجه نحو المبنى الآخر.
Dialogue: 0,0:03:22.73,0:03:23.83,Default,,0,0,0,,‫«الملحق» — اسمع جيدًا.
Dialogue: 0,0:03:23.83,0:03:25.03,Default,,0,0,0,,‫سأقول لك مرة أخرى.
Dialogue: 0,0:03:25.03,0:03:26.73,Default,,0,0,0,,‫للوصول إلى صالة نانيوَا المركزية،
Dialogue: 0,0:03:26.73,0:03:28.53,Default,,0,0,0,,‫استقل الحافلة المتجهة إلى توجيري
Dialogue: 0,0:03:28.53,0:03:31.03,Default,,0,0,0,,‫وانزل في المحطة السابعة.
Dialogue: 0,0:03:31.03,0:03:34.33,Default,,0,0,0,,‫إن لم تعرف أي حافلة، اسأل السائق.
Dialogue: 0,0:03:34.33,0:03:38.13,Default,,0,0,0,,‫واسأله عن الصالة التي تُقام فيها بطولة كينكي للكندو
Dialogue: 0,0:03:38.13,0:03:41.23,Default,,0,0,0,,‫التي يشارك فيها هيجي هاتوري، وسيعرفها!
Dialogue: 0,0:03:41.23,0:03:43.43,Default,,0,0,0,,‫حسنًا، فهمت.
Dialogue: 0,0:03:43.43,0:03:47.03,Default,,0,0,0,,‫لست طفلًا صغيرًا، لا داعي لتكرار الأمر.
Dialogue: 0,0:03:47.03,0:03:50.83,Default,,0,0,0,,‫آسف، تبدو كطفل صغير فأنسى أحيانًا.
Dialogue: 0,0:03:50.83,0:03:54.13,Default,,0,0,0,,‫لا بأس، فقط لا تتصل بي مجددًا.
Dialogue: 0,0:03:54.13,0:03:57.33,Default,,0,0,0,,‫أعاني أصلًا في الإفلات من ران والعجوز.
Dialogue: 0,0:03:57.33,0:03:59.13,Default,,0,0,0,,‫وأمر آخر، نحن ذاهبون إلى أوساكا
Dialogue: 0,0:03:59.13,0:04:00.83,Default,,0,0,0,,‫لأنك دعوتنا إلى عشاء تتشيرِي
Dialogue: 0,0:04:00.83,0:04:01.93,Default,,0,0,0,,‫بعد أن لم نتمكن من تناوله المرة الماضية
Dialogue: 0,0:04:01.93,0:04:05.03,Default,,0,0,0,,‫ولا التي قبلها في منزلك.
Dialogue: 0,0:04:05.03,0:04:06.03,Default,,0,0,0,,‫والسبب الوحيد لحضورنا منافستك
Dialogue: 0,0:04:06.03,0:04:07.73,Default,,0,0,0,,‫هو أنها في اليوم نفسه.
Dialogue: 0,0:04:07.73,0:04:10.13,Default,,0,0,0,,‫أنت دائمًا تعاملني ببرود.
Dialogue: 0,0:04:10.13,0:04:13.23,Default,,0,0,0,,‫بالمناسبة، هذا القطار السريع غادر المحطة للتو،
Dialogue: 0,0:04:13.23,0:04:16.03,Default,,0,0,0,,‫وسنصل بعد الساعة الثانية.
Dialogue: 0,0:04:16.03,0:04:17.93,Default,,0,0,0,,‫ألن تكون مباراتك قد انتهت حينها؟
Dialogue: 0,0:04:17.93,0:04:19.53,Default,,0,0,0,,‫لا تقلق.
Dialogue: 0,0:04:19.53,0:04:21.53,Default,,0,0,0,,‫نصف النهائي لا يبدأ قبل الثانية ظهرًا.
Dialogue: 0,0:04:21.53,0:04:23.83,Default,,0,0,0,,‫ستصلون في الوقت المناسب للنهائي.
Dialogue: 0,0:04:23.83,0:04:25.33,Default,,0,0,0,,‫آه، حسنًا.
Dialogue: 0,0:04:25.33,0:04:27.13,Default,,0,0,0,,‫إذن سأنتظركم.
Dialogue: 0,0:04:28.23,0:04:29.33,Default,,0,0,0,,‫كازوها؟
Dialogue: 0,0:04:29.33,0:04:31.83,Default,,0,0,0,,‫ماذا تفعلين هناك؟
Dialogue: 0,0:04:31.83,0:04:33.13,Default,,0,0,0,,‫هذا ما أود سؤالك عنه!
Dialogue: 0,0:04:33.13,0:04:34.63,Default,,0,0,0,,‫هذا مرحاض الرجال، ألا تعلمين؟
Dialogue: 0,0:04:34.63,0:04:37.33,Default,,0,0,0,,‫حقًا؟ لم أنتبه لذلك.
Dialogue: 0,0:04:37.33,0:04:39.33,Default,,0,0,0,,‫ظننته مكانًا للاختباء
Dialogue: 0,0:04:39.33,0:04:42.53,Default,,0,0,0,,‫للجبناء الذين لا يريدون المنافسة.
Dialogue: 0,0:04:42.53,0:04:43.93,Default,,0,0,0,,‫أنا أُخطط لتحركاتي.
Dialogue: 0,0:04:43.93,0:04:46.53,Default,,0,0,0,,‫كي أتمكن من هزيمة ذلك الرجل في النهائي.
Dialogue: 0,0:04:46.53,0:04:48.13,Default,,0,0,0,,‫تقصد ذاك الذي
Dialogue: 0,0:04:48.13,0:04:50.03,Default,,0,0,0,,‫يشبه كودو كثيرًا؟
Dialogue: 0,0:04:50.03,0:04:53.53,Default,,0,0,0,,‫نعم، أوكيتا من ثانوية سينشين في كيوتو.
Dialogue: 0,0:04:53.53,0:04:56.03,Default,,0,0,0,,‫في العام الماضي، أصابني بضربات في العنق.
Dialogue: 0,0:04:56.03,0:04:59.63,Default,,0,0,0,,‫وسأرد له هذا الجرح خلف أذني.
Dialogue: 0,0:04:59.63,0:05:01.83,Default,,0,0,0,,‫لمجرد أنه تغلب عليك سابقًا،
Dialogue: 0,0:05:01.83,0:05:03.83,Default,,0,0,0,,‫ألا تعتقد أنك تتصرف بدهاء؟
Dialogue: 0,0:05:03.83,0:05:06.23,Default,,0,0,0,,‫لا تكوني سخيفة! لم يهزمني.
Dialogue: 0,0:05:06.23,0:05:08.73,Default,,0,0,0,,‫جرحت عنقي حين تفاديت الضربة،
Dialogue: 0,0:05:08.73,0:05:10.03,Default,,0,0,0,,‫ولما لم يتوقف النزيف،
Dialogue: 0,0:05:10.03,0:05:12.83,Default,,0,0,0,,‫أوقف الطبيب المباراة.
Dialogue: 0,0:05:12.83,0:05:15.23,Default,,0,0,0,,‫ثم إن ذلك الرجل تخلف عن المباراتين الأولى والثانية،
Dialogue: 0,0:05:15.23,0:05:17.23,Default,,0,0,0,,‫وكان نائمًا خلف الصالة،
Dialogue: 0,0:05:17.23,0:05:18.93,Default,,0,0,0,,‫ثم واجهني مباشرة.
Dialogue: 0,0:05:18.93,0:05:20.63,Default,,0,0,0,,‫لا داعي للقلق، يمكنك هزيمته.
Dialogue: 0,0:05:20.63,0:05:22.93,Default,,0,0,0,,‫لقد أحضرت تميمتك، أليس كذلك؟
Dialogue: 0,0:05:22.93,0:05:24.93,Default,,0,0,0,,‫لكن هذا ليس السبب الوحيد
Dialogue: 0,0:05:24.93,0:05:27.63,Default,,0,0,0,,‫لتغيبي عن المباراتين الأولى والثانية.
Dialogue: 0,0:05:27.63,0:05:31.33,Default,,0,0,0,,‫الحقيقة أن الأمر يتعلق بيدي اليمنى…
Dialogue: 0,0:05:31.33,0:05:34.23,Default,,0,0,0,,‫أتذكرين ما حدث في جزيرة بيكوني؟
Dialogue: 0,0:05:36.23,0:05:37.63,Default,,0,0,0,,‫إنها تحكني بشدة، سأجنّ!
Dialogue: 0,0:05:37.63,0:05:40.63,Default,,0,0,0,,‫لا أستطيع التركيز في المباراة!
Dialogue: 0,0:05:40.63,0:05:43.23,Default,,0,0,0,,‫أهكذا؟ حسنًا إذن!
Dialogue: 0,0:05:44.33,0:05:46.53,Default,,0,0,0,,‫سأذهب لأتحدث مع والدتك.
Dialogue: 0,0:05:46.53,0:05:48.33,Default,,0,0,0,,‫ولتغرس فيك بعض الحزم والروح!
Dialogue: 0,0:05:48.33,0:05:50.13,Default,,0,0,0,,‫ماذا؟ أمي هنا؟
Dialogue: 0,0:05:50.13,0:05:51.13,Default,,0,0,0,,‫كازوها، انتظري!
Dialogue: 0,0:05:51.13,0:05:53.83,Default,,0,0,0,,‫ما بك؟ أيها الأحمق!
Dialogue: 0,0:05:53.83,0:05:57.13,Default,,0,0,0,,‫– أحمق؟ – لا، لم أكن أنا.
Dialogue: 0,0:05:57.13,0:05:59.63,Default,,0,0,0,,‫هل قلت إنك لا تستطيع المنافسة بسبب صداع الخمر؟
Dialogue: 0,0:05:59.63,0:06:01.23,Default,,0,0,0,,‫لم يكن بيدي حيلة.
Dialogue: 0,0:06:01.23,0:06:03.33,Default,,0,0,0,,‫الشركة التي وعدتني بالعمل أفلست.
Dialogue: 0,0:06:03.33,0:06:05.33,Default,,0,0,0,,‫انهرت تمامًا، فاضطررت للشرب.
Dialogue: 0,0:06:05.33,0:06:08.63,Default,,0,0,0,,‫يا أحمق! كان عليك التفكير بالعواقب!
Dialogue: 0,0:06:08.63,0:06:10.23,Default,,0,0,0,,‫دعونا نهدأ جميعًا.
Dialogue: 0,0:06:10.23,0:06:12.83,Default,,0,0,0,,‫ما زال أمامنا أكثر من ساعة في البطولة.
Dialogue: 0,0:06:12.83,0:06:14.03,Default,,0,0,0,,‫إنه محق.
Dialogue: 0,0:06:14.03,0:06:16.63,Default,,0,0,0,,‫فلنهدأ ونضع خطة.
Dialogue: 0,0:06:21.43,0:06:24.33,Default,,0,0,0,,‫تعلمون؟ يمكنني إخبار الجميع بذلك.
Dialogue: 0,0:06:24.33,0:06:25.63,Default,,0,0,0,,‫ماذا قلت؟
Dialogue: 0,0:06:25.63,0:06:27.83,Default,,0,0,0,,‫على عكسكم جميعًا الذين تنتظركم وظائف،
Dialogue: 0,0:06:27.83,0:06:30.63,Default,,0,0,0,,‫ليس لدي ما أخسره.
Dialogue: 0,0:06:30.63,0:06:32.53,Default,,0,0,0,,‫لا أدري عما تتحدث،
Dialogue: 0,0:06:32.53,0:06:34.13,Default,,0,0,0,,‫لكن إن لم ترغب بالمنافسة،
Dialogue: 0,0:06:34.13,0:06:36.13,Default,,0,0,0,,‫فسنضطر لإشراك أحد الطلاب الكبار،
Dialogue: 0,0:06:36.13,0:06:38.33,Default,,0,0,0,,‫رغم أنهم ليسوا بمستواك.
Dialogue: 0,0:06:38.33,0:06:39.83,Default,,0,0,0,,‫لا يمكننا إحراج الفريق بأكمله
Dialogue: 0,0:06:39.83,0:06:43.33,Default,,0,0,0,,‫بسببك وحدك.
Dialogue: 0,0:06:43.33,0:06:46.33,Default,,0,0,0,,‫لشخص سرق صديقة غيره، كلامك كبير جدًا.
Dialogue: 0,0:06:46.33,0:06:50.03,Default,,0,0,0,,‫أنت أحمق، هي من قررت تركك بنفسها.
Dialogue: 0,0:06:50.03,0:06:52.33,Default,,0,0,0,,‫لم أسرقها منك.
Dialogue: 0,0:06:52.33,0:06:56.03,Default,,0,0,0,,‫اسمع، من الأفضل أن تصحو وتفكر
Dialogue: 0,0:06:56.03,0:06:58.23,Default,,0,0,0,,‫في التخلص من هذا الحقد،
Dialogue: 0,0:06:58.23,0:07:01.53,Default,,0,0,0,,‫وفيما ستفعله ببقية حياتك.
Dialogue: 0,0:07:03.93,0:07:06.73,Default,,0,0,0,,‫سأقتل…
Dialogue: 0,0:07:06.73,0:07:08.23,Default,,0,0,0,,‫سأقتلك.
Dialogue: 0,0:07:08.23,0:07:11.53,Default,,0,0,0,,‫ما الذي تفعله يا هيجي؟ هيا، أسرع!
Dialogue: 0,0:07:11.53,0:07:13.23,Default,,0,0,0,,‫نعم… حسنًا.
Dialogue: 0,0:07:21.53,0:07:23.03,Default,,0,0,0,,‫ضربة في الصدر، نقطة!
Dialogue: 0,0:07:23.03,0:07:25.03,Default,,0,0,0,,‫نعم! حركة رائعة!
Dialogue: 0,0:07:25.03,0:07:27.93,Default,,0,0,0,,‫مرحبًا، لا أجد تارومي في أي مكان.
Dialogue: 0,0:07:27.93,0:07:30.33,Default,,0,0,0,,‫ربما عاد إلى المنزل؟
Dialogue: 0,0:07:30.33,0:07:33.93,Default,,0,0,0,,‫يا للعجب، اذهبوا وابحثوا هناك.
Dialogue: 0,0:07:33.93,0:07:35.53,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:07:39.33,0:07:41.63,Default,,0,0,0,,‫هيه! لماذا لا تركزون على المباراة؟
Dialogue: 0,0:07:41.63,0:07:43.23,Default,,0,0,0,,‫أحرزوا النقاط بسرعة!
Dialogue: 0,0:07:43.23,0:07:45.23,Default,,0,0,0,,‫وتأهلوا إلى الأربعة الأوائل!
Dialogue: 0,0:07:45.83,0:07:47.73,Default,,0,0,0,,‫«الملحق» — هل وجدتموه؟
Dialogue: 0,0:07:47.73,0:07:50.33,Default,,0,0,0,,‫لا، لم يكن في المرحاض ولا في صالة التدريب.
Dialogue: 0,0:07:50.33,0:07:52.53,Default,,0,0,0,,‫هل بحثتم في غرفة التخزين؟
Dialogue: 0,0:07:52.53,0:07:54.83,Default,,0,0,0,,‫لا، ليس بعد.
Dialogue: 0,0:07:54.83,0:07:58.33,Default,,0,0,0,,‫لكنه لا يمكن أن يكون هنا أثناء المنافسة.
Dialogue: 0,0:08:02.63,0:08:05.33,Default,,0,0,0,,‫تا… تارومي؟
Dialogue: 0,0:08:05.33,0:08:07.13,Default,,0,0,0,,‫يا له من منظر مروّع!
Dialogue: 0,0:08:07.13,0:08:09.13,Default,,0,0,0,,‫أحدكم، أحضروا سيارة إسعاف!
Dialogue: 0,0:08:09.13,0:08:12.03,Default,,0,0,0,,‫حسنًا، سأذهب للاتصال بالإسعاف!
Dialogue: 0,0:08:12.03,0:08:15.03,Default,,0,0,0,,‫أوموتاني، اذهب إلى مخفر الشرطة وأحضرهم!
Dialogue: 0,0:08:15.03,0:08:17.13,Default,,0,0,0,,‫حسنًا، سأعود إلى الصالة
Dialogue: 0,0:08:17.13,0:08:19.03,Default,,0,0,0,,‫وأخبر هاكاماتا بالأمر.
Dialogue: 0,0:08:19.03,0:08:21.43,Default,,0,0,0,,‫حسنًا! أسرع وأحضره إلى هنا!
Dialogue: 0,0:08:21.43,0:08:22.93,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:08:24.83,0:08:27.03,Default,,0,0,0,,‫ياهو! وصلنا إلى الأربعة الأوائل!
Dialogue: 0,0:08:27.03,0:08:29.33,Default,,0,0,0,,‫أظننا سنفوز بالبطولة!
Dialogue: 0,0:08:29.33,0:08:31.63,Default,,0,0,0,,‫تارومي ميت؟ هل أنت متأكد؟
Dialogue: 0,0:08:31.63,0:08:34.43,Default,,0,0,0,,‫شبه متأكد، لم أعرف إن كان يتنفس،
Dialogue: 0,0:08:34.43,0:08:35.83,Default,,0,0,0,,‫لكن كان مغطى بالدماء!
Dialogue: 0,0:08:35.83,0:08:37.33,Default,,0,0,0,,‫أين هو؟
Dialogue: 0,0:08:37.33,0:08:38.93,Default,,0,0,0,,‫من أنت بحق الجحيم؟
Dialogue: 0,0:08:38.93,0:08:41.33,Default,,0,0,0,,‫سألتك أين هو!
Dialogue: 0,0:08:51.23,0:08:53.43,Default,,0,0,0,,‫ما هذا؟ لا يوجد شيء هنا.
Dialogue: 0,0:08:55.33,0:08:56.93,Default,,0,0,0,,‫هذا غريب.
Dialogue: 0,0:08:56.93,0:09:00.63,Default,,0,0,0,,‫وجدناه هنا، متكئًا على حصان القفز.
Dialogue: 0,0:09:02.43,0:09:04.23,Default,,0,0,0,,‫ما هذه الدمية؟
Dialogue: 0,0:09:04.23,0:09:07.33,Default,,0,0,0,,‫أظنها دمية تُستخدم لتدريب الإسعافات الأولية.
Dialogue: 0,0:09:07.33,0:09:11.13,Default,,0,0,0,,‫كما في الإنعاش من فم إلى فم.
Dialogue: 0,0:09:11.13,0:09:14.73,Default,,0,0,0,,‫أمتأكدون أنكم لم تخلطوا بين هذه الدمية وصديقكم؟
Dialogue: 0,0:09:14.73,0:09:16.13,Default,,0,0,0,,‫هذا سخيف!
Dialogue: 0,0:09:16.13,0:09:18.83,Default,,0,0,0,,‫مرحبًا! الشرطة وصلت!
Dialogue: 0,0:09:19.63,0:09:22.73,Default,,0,0,0,,‫ستصل سيارة الإسعاف بعد نحو عشر دقائق.
Dialogue: 0,0:09:22.73,0:09:25.83,Default,,0,0,0,,‫لكن المشكلة أننا لا نجد تارومي.
Dialogue: 0,0:09:25.83,0:09:27.23,Default,,0,0,0,,‫ماذا قلت؟
Dialogue: 0,0:09:30.23,0:09:33.23,Default,,0,0,0,,‫ألا تظنون أن تارومي خدعنا؟
Dialogue: 0,0:09:33.23,0:09:34.43,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:09:34.43,0:09:37.43,Default,,0,0,0,,‫هيا، لنتفرق ونبحث عنه!
Dialogue: 0,0:09:37.43,0:09:40.23,Default,,0,0,0,,‫إن كان هذا مزاحًا، فسألقنه درسًا!
Dialogue: 0,0:09:40.23,0:09:41.93,Default,,0,0,0,,‫عذرًا.
Dialogue: 0,0:09:41.93,0:09:44.23,Default,,0,0,0,,‫هل أنتم من جامعة شينّاي؟
Dialogue: 0,0:09:44.23,0:09:46.73,Default,,0,0,0,,‫نعم، هذا صحيح. ما الأمر؟
Dialogue: 0,0:09:46.73,0:09:52.43,Default,,0,0,0,,‫ورد اتصال إلى مكتب الاستقبال من رجل غريب.
Dialogue: 0,0:09:52.43,0:09:54.23,Default,,0,0,0,,‫قال أن أبلغ طلاب جامعة شينّاي
Dialogue: 0,0:09:54.23,0:09:56.33,Default,,0,0,0,,‫الموجودين حاليًا في غرفة التخزين
Dialogue: 0,0:09:56.33,0:09:59.83,Default,,0,0,0,,‫أن يتوجهوا إلى غرفة الملابس بجانب المسبح.
Dialogue: 0,0:09:59.83,0:10:01.43,Default,,0,0,0,,‫لا بد أنه تارومي!
Dialogue: 0,0:10:01.43,0:10:03.83,Default,,0,0,0,,‫ذلك الماكر! يا له من وغد!
Dialogue: 0,0:10:03.83,0:10:05.53,Default,,0,0,0,,‫هيا بنا ونتحقق.
Dialogue: 0,0:10:06.03,0:10:09.03,Default,,0,0,0,,‫«غرفة الاستحمام»
Dialogue: 0,0:10:20.13,0:10:21.53,Default,,0,0,0,,‫تا… تارومي!
Dialogue: 0,0:10:21.53,0:10:23.53,Default,,0,0,0,,‫هل هذا حقيقي؟
Dialogue: 0,0:10:24.43,0:10:26.13,Default,,0,0,0,,‫إنه ميت فعلًا.
Dialogue: 0,0:10:29.03,0:10:31.13,Default,,0,0,0,,‫لا أصدق ذلك.
Dialogue: 0,0:10:43.07,0:10:45.87,Default,,0,0,0,,‫الجثة التي كانت في غرفة التخزين
Dialogue: 0,0:10:45.87,0:10:48.57,Default,,0,0,0,,‫نُقلت إلى غرفة الملابس قرب المسبح دون أن يلاحظها أحد.
Dialogue: 0,0:10:48.57,0:10:50.67,Default,,0,0,0,,‫هل يعني هذا أن شخصًا ما نقلها؟
Dialogue: 0,0:10:51.77,0:10:55.17,Default,,0,0,0,,‫لكن لو كنت تحمل جثة مضرجة بالدماء هكذا،
Dialogue: 0,0:10:55.17,0:10:57.07,Default,,0,0,0,,‫فلا بد أن أحدًا كان سيلحظ ذلك.
Dialogue: 0,0:10:57.07,0:10:58.97,Default,,0,0,0,,‫هناك فريق من إحدى المدارس
Dialogue: 0,0:10:58.97,0:11:02.77,Default,,0,0,0,,‫كانوا جالسين عند مدخل الملحق يتناولون غداءهم.
Dialogue: 0,0:11:02.77,0:11:04.67,Default,,0,0,0,,‫لماذا كل هذا العناء؟
Dialogue: 0,0:11:06.27,0:11:07.67,Default,,0,0,0,,‫هيجي!
Dialogue: 0,0:11:07.67,0:11:10.47,Default,,0,0,0,,‫ماذا تفعل؟ لم تأكل غداءك حتى!
Dialogue: 0,0:11:10.47,0:11:13.17,Default,,0,0,0,,‫لم يبقَ على نصف النهائي سوى أقل من ساعة!
Dialogue: 0,0:11:13.17,0:11:15.77,Default,,0,0,0,,‫اصمتي. أنا في قضية!
Dialogue: 0,0:11:15.77,0:11:18.37,Default,,0,0,0,,‫حدثت جريمة قتل في غرفة الملابس هناك.
Dialogue: 0,0:11:18.37,0:11:20.27,Default,,0,0,0,,‫ماذا؟ أتتكلم بجد؟
Dialogue: 0,0:11:20.27,0:11:21.97,Default,,0,0,0,,‫لكن هناك أمر لا أفهمه،
Dialogue: 0,0:11:21.97,0:11:23.77,Default,,0,0,0,,‫ولهذا لا أستطيع التركيز في المباراة.
Dialogue: 0,0:11:23.77,0:11:26.97,Default,,0,0,0,,‫إذًا، لمَ لا تطلب نصيحة كودو؟
Dialogue: 0,0:11:26.97,0:11:28.87,Default,,0,0,0,,‫أليسوا قادمين إلى هنا أصلًا؟
Dialogue: 0,0:11:28.87,0:11:32.17,Default,,0,0,0,,‫صحيح، كودو! سأتصل به فحسب.
Dialogue: 0,0:11:32.17,0:11:34.67,Default,,0,0,0,,‫كودو سيحل القضية في لمح البصر.
Dialogue: 0,0:11:34.67,0:11:36.87,Default,,0,0,0,,‫لن تضطر للقلق بشأنها إطلاقًا.
Dialogue: 0,0:11:38.97,0:11:41.07,Default,,0,0,0,,‫دعي كودو يتولى التحقيق،
Dialogue: 0,0:11:41.07,0:11:43.47,Default,,0,0,0,,‫وأنتِ عودي إلى المباراة، هيا!
Dialogue: 0,0:11:43.47,0:11:44.87,Default,,0,0,0,,‫اسمعي يا كازوها.
Dialogue: 0,0:11:44.87,0:11:46.67,Default,,0,0,0,,‫إياكِ أن تخبري كودو عن جريمة القتل.
Dialogue: 0,0:11:46.67,0:11:48.67,Default,,0,0,0,,‫-ماذا؟ -لا تنسي ما قلته!
Dialogue: 0,0:11:48.67,0:11:50.07,Default,,0,0,0,,‫هيجي!
Dialogue: 0,0:11:51.67,0:11:53.57,Default,,0,0,0,,‫كودو لن يصل قبل ساعة ونصف.
Dialogue: 0,0:11:53.57,0:11:55.97,Default,,0,0,0,,‫عليّ أن أحل هذه القضية قبل ذلك!
Dialogue: 0,0:12:02.17,0:12:04.57,Default,,0,0,0,,‫لقد علِق الأرز عليك مجددًا.
Dialogue: 0,0:12:05.37,0:12:07.57,Default,,0,0,0,,‫ماذا؟ هل قلتِ جريمة قتل؟
Dialogue: 0,0:12:07.57,0:12:10.07,Default,,0,0,0,,‫إذًا تقصدين أن هاتوري…
Dialogue: 0,0:12:10.07,0:12:12.77,Default,,0,0,0,,‫نعم. قال إنه لا وقت لديه للمنافسة.
Dialogue: 0,0:12:12.77,0:12:15.67,Default,,0,0,0,,‫إنه يركض في كل مكان بحثًا عن أدلة.
Dialogue: 0,0:12:15.67,0:12:17.27,Default,,0,0,0,,‫وماذا سنفعل؟
Dialogue: 0,0:12:17.27,0:12:19.67,Default,,0,0,0,,‫نصف النهائي سيبدأ الآن.
Dialogue: 0,0:12:19.67,0:12:21.07,Default,,0,0,0,,‫لا خيار أمامنا.
Dialogue: 0,0:12:21.07,0:12:24.37,Default,,0,0,0,,‫علينا أن نأخذ البطولة من دون هيجي.
Dialogue: 0,0:12:24.37,0:12:29.17,Default,,0,0,0,,‫ثم سنكسر أنف ذلك الأحمق المهووس بالألغاز إلى نصفين!
Dialogue: 0,0:12:30.57,0:12:33.77,Default,,0,0,0,,‫عذرًا. نحن من سنخوض المباراة.
Dialogue: 0,0:12:38.37,0:12:41.77,Default,,0,0,0,,‫أأنت متأكد أنه أحد زملائك في الفريق؟
Dialogue: 0,0:12:41.77,0:12:43.07,Default,,0,0,0,,‫نعم، هذا صحيح.
Dialogue: 0,0:12:43.07,0:12:45.87,Default,,0,0,0,,‫اسمه تارومي. نحن زملاء في الجامعة نفسها.
Dialogue: 0,0:12:45.87,0:12:49.67,Default,,0,0,0,,‫لا بد أن القاتل وضعه تحت الدش الساخن
Dialogue: 0,0:12:49.67,0:12:52.27,Default,,0,0,0,,‫لإخفاء وقت الوفاة.
Dialogue: 0,0:12:52.27,0:12:54.67,Default,,0,0,0,,‫حسنًا، من الواضح تمامًا
Dialogue: 0,0:12:54.67,0:12:56.97,Default,,0,0,0,,‫أن أداة الجريمة هي هذا السيف.
Dialogue: 0,0:12:56.97,0:12:58.17,Default,,0,0,0,,‫حالما نعرف لمن يعود،
Dialogue: 0,0:12:58.17,0:12:59.77,Default,,0,0,0,,‫سنقبض على القاتل…
Dialogue: 0,0:12:59.77,0:13:02.37,Default,,0,0,0,,‫أنت مخطئ يا مفتش أوتاكي.
Dialogue: 0,0:13:03.27,0:13:06.67,Default,,0,0,0,,‫مدرب «السحب السريع» أحضره إلى البطولة
Dialogue: 0,0:13:06.67,0:13:09.07,Default,,0,0,0,,‫لأنه كان سيقدم عرضًا بسيف حقيقي.
Dialogue: 0,0:13:09.07,0:13:12.97,Default,,0,0,0,,‫لا بد أن أحدهم رآه متروكًا في غرفة تبديل الملابس،
Dialogue: 0,0:13:12.97,0:13:14.77,Default,,0,0,0,,‫فسرقه واستخدمه لارتكاب الجريمة.
Dialogue: 0,0:13:14.77,0:13:17.27,Default,,0,0,0,,‫هيجي، ماذا تفعل هنا؟
Dialogue: 0,0:13:17.27,0:13:20.47,Default,,0,0,0,,‫ألا ترى بعينيك؟ أنا أشارك في المنافسة.
Dialogue: 0,0:13:20.47,0:13:23.27,Default,,0,0,0,,‫آه، تذكرت الآن! اليوم هو يوم البطولة الكبرى
Dialogue: 0,0:13:23.27,0:13:25.17,Default,,0,0,0,,‫بين فرق الثانويات والجامعات في كينكي.
Dialogue: 0,0:13:25.17,0:13:28.57,Default,,0,0,0,,‫إذًا هل لديك فكرة عمّن سرق هذا السيف؟
Dialogue: 0,0:13:28.57,0:13:29.77,Default,,0,0,0,,‫إلى حد ما.
Dialogue: 0,0:13:29.77,0:13:31.97,Default,,0,0,0,,‫القاتل شخص يحضر هذه البطولة كثيرًا
Dialogue: 0,0:13:31.97,0:13:34.87,Default,,0,0,0,,‫ويعرف عن عرض السحب السريع.
Dialogue: 0,0:13:34.87,0:13:37.67,Default,,0,0,0,,‫كما يعرف مخطط المكان أيضًا،
Dialogue: 0,0:13:37.67,0:13:39.97,Default,,0,0,0,,‫الصالة والملحق وغرفة الملابس.
Dialogue: 0,0:13:39.97,0:13:43.97,Default,,0,0,0,,‫أي إن القاتل شخصٌ يشبهكم تمامًا.
Dialogue: 0,0:13:44.57,0:13:47.07,Default,,0,0,0,,‫أفهم ضرورة معرفة العرض
Dialogue: 0,0:13:47.07,0:13:49.37,Default,,0,0,0,,‫وسرقة السيف،
Dialogue: 0,0:13:49.37,0:13:51.77,Default,,0,0,0,,‫لكن ما علاقة معرفة الصالة والملحق وغرفة الملابس بالأمر؟
Dialogue: 0,0:13:51.77,0:13:52.97,Default,,0,0,0,,‫وما شأنها بذلك؟
Dialogue: 0,0:13:52.97,0:13:55.67,Default,,0,0,0,,‫لأنه لو لم يعرف القاتل مواقع هذه الأماكن،
Dialogue: 0,0:13:55.67,0:13:57.37,Default,,0,0,0,,‫لما استطاع نقل السيد تارومي
Dialogue: 0,0:13:57.37,0:13:59.27,Default,,0,0,0,,‫من الملحق إلى غرفة الملابس هذه دون أن يُرى.
Dialogue: 0,0:13:59.27,0:14:02.57,Default,,0,0,0,,‫ما يزعجني ليس لماذا نُقل… بل كيف.
Dialogue: 0,0:14:03.47,0:14:05.67,Default,,0,0,0,,‫لأنه في ذلك الوقت كان هناك جماعة من الناس
Dialogue: 0,0:14:05.67,0:14:08.57,Default,,0,0,0,,‫جالسين أمام الملحق يتناولون غداءهم.
Dialogue: 0,0:14:08.57,0:14:10.57,Default,,0,0,0,,‫وكان من المستحيل ألا يلاحظوا
Dialogue: 0,0:14:10.57,0:14:13.77,Default,,0,0,0,,‫رجلًا مغطى بالدماء يُحمل إلى الخارج.
Dialogue: 0,0:14:14.57,0:14:16.87,Default,,0,0,0,,‫إلا إذا بالطبع…
Dialogue: 0,0:14:16.87,0:14:19.47,Default,,0,0,0,,‫بعد أن وجدتم السيد تارومي في غرفة التخزين،
Dialogue: 0,0:14:19.47,0:14:21.97,Default,,0,0,0,,‫كان آخر من غادر المكان
Dialogue: 0,0:14:21.97,0:14:25.07,Default,,0,0,0,,‫قد تمكن بدهاء شديد من إخراجه.
Dialogue: 0,0:14:25.07,0:14:27.37,Default,,0,0,0,,‫هل تتذكرون ما الذي حدث؟
Dialogue: 0,0:14:27.37,0:14:30.67,Default,,0,0,0,,‫أول من خرج كان كوتيغاوا هنا.
Dialogue: 0,0:14:32.27,0:14:35.17,Default,,0,0,0,,‫قال إنه سيذهب للاتصال بالإسعاف.
Dialogue: 0,0:14:35.17,0:14:36.47,Default,,0,0,0,,‫ثم خرجت أنا.
Dialogue: 0,0:14:36.47,0:14:39.77,Default,,0,0,0,,‫كوتيغاوا طلب مني الذهاب إلى مخفر الشرطة لإحضارهم.
Dialogue: 0,0:14:40.37,0:14:43.17,Default,,0,0,0,,‫هذا يعني يا سيد دوغوتشي،
Dialogue: 0,0:14:43.17,0:14:44.97,Default,,0,0,0,,‫أنك كنت آخر من غادر، أليس كذلك؟
Dialogue: 0,0:14:44.97,0:14:50.47,Default,,0,0,0,,‫لكنني خرجت فورًا لإحضار هاكاماتا الذي كان في الصالة.
Dialogue: 0,0:14:50.47,0:14:52.17,Default,,0,0,0,,‫ومن يضمن لي أنك لا تكذب؟
Dialogue: 0,0:14:52.17,0:14:54.27,Default,,0,0,0,,‫أ… ألم أقل إنني ذاهب؟
Dialogue: 0,0:14:54.27,0:14:55.77,Default,,0,0,0,,‫بلى.
Dialogue: 0,0:14:55.77,0:14:59.67,Default,,0,0,0,,‫ثم إن دوغوتشي لم يكن آخر من غادر… بل كنت أنا.
Dialogue: 0,0:14:59.67,0:15:00.77,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:15:00.77,0:15:04.07,Default,,0,0,0,,‫كنت أعلم أننا بحاجة إلى الإسعاف بأسرع ما يمكن،
Dialogue: 0,0:15:04.07,0:15:05.27,Default,,0,0,0,,‫وحين رأيت مجموعة من طلاب الثانوية
Dialogue: 0,0:15:05.27,0:15:06.67,Default,,0,0,0,,‫واقفِين عند المدخل،
Dialogue: 0,0:15:06.67,0:15:08.77,Default,,0,0,0,,‫استعرت هاتفهم المحمول.
Dialogue: 0,0:15:08.77,0:15:10.47,Default,,0,0,0,,‫لكن الشخص الذي كنت أكلمه
Dialogue: 0,0:15:10.47,0:15:13.47,Default,,0,0,0,,‫طلب مني وصف حالة المصاب،
Dialogue: 0,0:15:13.47,0:15:16.67,Default,,0,0,0,,‫فعُدت ووصفت حالة تارومي.
Dialogue: 0,0:15:16.67,0:15:18.87,Default,,0,0,0,,‫وبالطبع، لم يكن هناك أحد غيري.
Dialogue: 0,0:15:19.87,0:15:22.37,Default,,0,0,0,,‫وبمجرد أن انتهيت،
Dialogue: 0,0:15:22.37,0:15:24.07,Default,,0,0,0,,‫عدت لأُعيد الهاتف
Dialogue: 0,0:15:24.07,0:15:26.17,Default,,0,0,0,,‫ثم اتجهت إلى مخفر الشرطة.
Dialogue: 0,0:15:26.17,0:15:28.27,Default,,0,0,0,,‫هل هذا صحيح؟
Dialogue: 0,0:15:28.27,0:15:30.97,Default,,0,0,0,,‫نعم، لقد جاء إلى مخفر الشرطة.
Dialogue: 0,0:15:30.97,0:15:33.77,Default,,0,0,0,,‫ولست بارعًا في شرح الأمور، فارتحت حين جاء.
Dialogue: 0,0:15:33.77,0:15:36.97,Default,,0,0,0,,‫وكم استغرق الذهاب من الملحق
Dialogue: 0,0:15:36.97,0:15:38.97,Default,,0,0,0,,‫إلى مخفر الشرطة ثم العودة مجددًا؟
Dialogue: 0,0:15:38.97,0:15:41.67,Default,,0,0,0,,‫هناك تقاطع كبير أمام المخفر،
Dialogue: 0,0:15:41.67,0:15:44.37,Default,,0,0,0,,‫وعلقنا عند الإشارة…
Dialogue: 0,0:15:44.37,0:15:47.07,Default,,0,0,0,,‫أظنه استغرق نحو أربع عشرة إلى خمس عشرة دقيقة.
Dialogue: 0,0:15:47.07,0:15:49.07,Default,,0,0,0,,‫قلتَ أربع عشرة إلى خمس عشرة دقيقة؟
Dialogue: 0,0:15:49.07,0:15:51.17,Default,,0,0,0,,‫ألا ترى أن هذا غريب يا سيد دوغوتشي؟
Dialogue: 0,0:15:51.17,0:15:52.77,Default,,0,0,0,,‫أوموتاني وكوتيغاوا
Dialogue: 0,0:15:52.77,0:15:57.07,Default,,0,0,0,,‫عادا مع الشرطة فور وصولنا تقريبًا.
Dialogue: 0,0:15:57.07,0:15:59.47,Default,,0,0,0,,‫الصالة ملاصقة للملحق،
Dialogue: 0,0:15:59.47,0:16:04.37,Default,,0,0,0,,‫ألا تعتقد أن إحضار السيد هاكاماتا استغرق وقتًا طويلًا على نحو غير معتاد؟
Dialogue: 0,0:16:04.37,0:16:07.77,Default,,0,0,0,,‫ربما واجه صعوبة في العثور عليّ.
Dialogue: 0,0:16:07.77,0:16:12.97,Default,,0,0,0,,‫فالمكان كان ممتلئًا بأشخاص يرتدون الملابس نفسها.
Dialogue: 0,0:16:12.97,0:16:18.07,Default,,0,0,0,,‫وهذا يعني أن لديك أنت أيضًا وقتًا غير محسوب.
Dialogue: 0,0:16:18.07,0:16:20.37,Default,,0,0,0,,‫لا بأس إن اشتبهتم بنا،
Dialogue: 0,0:16:20.37,0:16:23.07,Default,,0,0,0,,‫لكن هل تخبرني بشيء أولًا؟
Dialogue: 0,0:16:23.07,0:16:27.17,Default,,0,0,0,,‫اشرح كيف يمكن إخراج تارومي، وهو بتلك الحالة،
Dialogue: 0,0:16:27.17,0:16:28.67,Default,,0,0,0,,‫من غرفة التخزين في الملحق
Dialogue: 0,0:16:28.67,0:16:30.87,Default,,0,0,0,,‫إلى غرفة الملابس دون أن يراه أحد؟
Dialogue: 0,0:16:30.87,0:16:31.87,Default,,0,0,0,,‫نعم، هذا صحيح!
Dialogue: 0,0:16:31.87,0:16:33.77,Default,,0,0,0,,‫إن لم تستطع شرح ذلك،
Dialogue: 0,0:16:33.77,0:16:35.67,Default,,0,0,0,,‫فلن تستطيع إثبات ذنبنا!
Dialogue: 0,0:16:35.67,0:16:38.87,Default,,0,0,0,,‫لا تخترعوا القصص.
Dialogue: 0,0:16:38.87,0:16:41.97,Default,,0,0,0,,‫حسنًا أيها المحقق، سنذهب لرؤية والدة تارومي
Dialogue: 0,0:16:41.97,0:16:44.47,Default,,0,0,0,,‫ونخبرها بما حدث اليوم.
Dialogue: 0,0:16:44.47,0:16:48.87,Default,,0,0,0,,‫هاكاماتا، أنت الوحيد بلا وشاح… لماذا؟
Dialogue: 0,0:16:48.87,0:16:52.97,Default,,0,0,0,,‫ظننت أنني أحضرته معي، لكن يبدو أنني أضعته.
Dialogue: 0,0:16:52.97,0:16:55.27,Default,,0,0,0,,‫يبدو أننا سننسحب من المباراة على أي حال،
Dialogue: 0,0:16:55.27,0:16:56.97,Default,,0,0,0,,‫لذا أظنني لن أحتاجه.
Dialogue: 0,0:17:00.27,0:17:03.67,Default,,0,0,0,,‫وبالحديث عن المباراة، هيجي، كيف كان أداؤك اليوم؟
Dialogue: 0,0:17:03.67,0:17:05.87,Default,,0,0,0,,‫هل فزت؟ أم خسرت؟
Dialogue: 0,0:17:07.87,0:17:08.97,Default,,0,0,0,,‫هيجي؟
Dialogue: 0,0:17:11.47,0:17:13.07,Default,,0,0,0,,‫ضربة على الساعد، نقطة واحدة!
Dialogue: 0,0:17:13.07,0:17:15.47,Default,,0,0,0,,‫أحسنتم! لقد سجلنا!
Dialogue: 0,0:17:15.47,0:17:16.87,Default,,0,0,0,,‫كل ما علينا هو الصمود حتى النهاية
Dialogue: 0,0:17:16.87,0:17:18.07,Default,,0,0,0,,‫وسنكون في النهائي!
Dialogue: 0,0:17:18.07,0:17:19.17,Default,,0,0,0,,‫صحيح!
Dialogue: 0,0:17:19.17,0:17:21.37,Default,,0,0,0,,‫لا نحتاج هيجي للفوز بالبطولة!
Dialogue: 0,0:17:26.27,0:17:28.07,Default,,0,0,0,,‫طعنة في العنق، نقطة واحدة!
Dialogue: 0,0:17:28.07,0:17:31.57,Default,,0,0,0,,‫أربع مقابل واحد، والفوز لثانوية كيوتو سينشين!
Dialogue: 0,0:17:31.57,0:17:33.77,Default,,0,0,0,,‫ثانوية كيوتو سينشين؟
Dialogue: 0,0:17:33.77,0:17:36.57,Default,,0,0,0,,‫إنه أوكيتا، تمامًا كما قال هيجي.
Dialogue: 0,0:17:36.57,0:17:38.37,Default,,0,0,0,,‫هذا ليس جيدًا!
Dialogue: 0,0:17:38.37,0:17:41.27,Default,,0,0,0,,‫من دون هيجي، لا فرصة لنا.
Dialogue: 0,0:17:52.77,0:17:55.67,Default,,0,0,0,,‫نوافذ الجهة الخلفية من الملحق لا تُفتح،
Dialogue: 0,0:17:55.67,0:17:58.27,Default,,0,0,0,,‫أما التي في الأمام فملفتة جدًا.
Dialogue: 0,0:17:58.27,0:18:02.17,Default,,0,0,0,,‫المدخل الأمامي هو الطريق الوحيد.
Dialogue: 0,0:18:02.17,0:18:06.87,Default,,0,0,0,,‫لكن لكي أحمله إلى غرفة الملابس قرب المسبح،
Dialogue: 0,0:18:06.87,0:18:08.27,Default,,0,0,0,,‫سأضطر للمرور أمام الصالة
Dialogue: 0,0:18:08.27,0:18:11.87,Default,,0,0,0,,‫حيث يوجد الكثير من الناس.
Dialogue: 0,0:18:11.87,0:18:13.27,Default,,0,0,0,,‫هذا مستحيل.
Dialogue: 0,0:18:13.27,0:18:15.57,Default,,0,0,0,,‫لا بد أن أحدًا سيلاحظ رجلًا مغطى بالدماء
Dialogue: 0,0:18:15.57,0:18:18.97,Default,,0,0,0,,‫يُحمل ويمر أمامهم.
Dialogue: 0,0:18:18.97,0:18:20.27,Default,,0,0,0,,‫يا إلهي!
Dialogue: 0,0:18:20.27,0:18:23.37,Default,,0,0,0,,‫كودو سيصل خلال أقل من عشر دقائق.
Dialogue: 0,0:18:25.07,0:18:26.67,Default,,0,0,0,,‫أنت! انتظر!
Dialogue: 0,0:18:28.47,0:18:30.77,Default,,0,0,0,,‫لقد خرجت من الملحق للتو، أليس كذلك؟
Dialogue: 0,0:18:30.77,0:18:32.17,Default,,0,0,0,,‫ماذا كنت تفعل هناك؟
Dialogue: 0,0:18:32.17,0:18:35.47,Default,,0,0,0,,‫لم أفعل شيئًا سوى الذهاب إلى الحمام.
Dialogue: 0,0:18:35.47,0:18:38.67,Default,,0,0,0,,‫آسف، لكن لدي سؤال أريد طرحه عليك.
Dialogue: 0,0:18:38.67,0:18:40.37,Default,,0,0,0,,‫وما هو؟
Dialogue: 0,0:18:40.37,0:18:44.07,Default,,0,0,0,,‫قبل مقتل السيد تارومي، سمعته يقول:
Dialogue: 0,0:18:44.07,0:18:46.47,Default,,0,0,0,,‫«تعلمون؟ يمكنني إخبار الجميع بذلك.»
Dialogue: 0,0:18:46.47,0:18:48.37,Default,,0,0,0,,‫ماذا كان يقصد؟
Dialogue: 0,0:18:48.37,0:18:52.47,Default,,0,0,0,,‫كيف لي أن أعرف؟ أنا لا أعرف شيئًا!
Dialogue: 0,0:18:52.47,0:18:54.87,Default,,0,0,0,,‫حسنًا إذن، هل الفتاة التي كان تارومي وهاكاماتا
Dialogue: 0,0:18:54.87,0:18:58.27,Default,,0,0,0,,‫يتشاجران بشأنها اليوم هي تلك الفتاة؟
Dialogue: 0,0:18:58.27,0:19:00.17,Default,,0,0,0,,‫بالطبع لا!
Dialogue: 0,0:19:00.17,0:19:04.47,Default,,0,0,0,,‫بعد تلك الحادثة، تركت هاوري إدارة فريق الكندو!
Dialogue: 0,0:19:04.47,0:19:07.27,Default,,0,0,0,,‫تلك الحادثة؟ ماذا تقصد؟
Dialogue: 0,0:19:07.27,0:19:09.17,Default,,0,0,0,,‫هل رأيت طعنة أوكيتا؟
Dialogue: 0,0:19:09.17,0:19:11.97,Default,,0,0,0,,‫نعم… يمكن أن تقتل أحدًا بها.
Dialogue: 0,0:19:14.27,0:19:15.47,Default,,0,0,0,,‫هيه، عد إلى هنا!
Dialogue: 0,0:19:17.27,0:19:19.37,Default,,0,0,0,,‫هاه؟ إنه ذلك الرجل.
Dialogue: 0,0:19:19.37,0:19:22.27,Default,,0,0,0,,‫إنه يركض مجددًا كما كان حين كنا نتغدى.
Dialogue: 0,0:19:22.27,0:19:23.47,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:19:23.47,0:19:28.27,Default,,0,0,0,,‫هل كنتم تتناولون الغداء عند باب الملحق؟
Dialogue: 0,0:19:28.27,0:19:29.97,Default,,0,0,0,,‫نعم، كنا نحن.
Dialogue: 0,0:19:29.97,0:19:32.17,Default,,0,0,0,,‫وكان هناك ثلاثة طلاب جامعة غريبين.
Dialogue: 0,0:19:32.17,0:19:33.77,Default,,0,0,0,,‫طلبوا استعارة هاتف محمول،
Dialogue: 0,0:19:33.77,0:19:37.27,Default,,0,0,0,,‫ثم أحضروا الشرطة والناس… وكانت فوضى كاملة.
Dialogue: 0,0:19:37.27,0:19:40.47,Default,,0,0,0,,‫حسنًا إذن، بعد أن غادر الثلاثة الملحق،
Dialogue: 0,0:19:40.47,0:19:42.57,Default,,0,0,0,,‫هل دخل أي شخص مشبوه إلى هناك؟
Dialogue: 0,0:19:42.57,0:19:43.97,Default,,0,0,0,,‫نعم، كان هناك رجل واحد!
Dialogue: 0,0:19:43.97,0:19:45.27,Default,,0,0,0,,‫أنت!
Dialogue: 0,0:19:45.27,0:19:47.27,Default,,0,0,0,,‫أحمق! أقصد قبلَك!
Dialogue: 0,0:19:47.27,0:19:50.07,Default,,0,0,0,,‫كان هناك شخص مشبوه خرج من الملحق.
Dialogue: 0,0:19:50.07,0:19:51.07,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:19:51.07,0:19:53.87,Default,,0,0,0,,‫كان يحمل معدات شخص آخر داخل حقيبة.
Dialogue: 0,0:19:53.87,0:19:55.97,Default,,0,0,0,,‫وكيف عرفتَ أنها ليست معداته؟
Dialogue: 0,0:19:55.97,0:19:57.47,Default,,0,0,0,,‫ذلك كان سهلًا.
Dialogue: 0,0:19:57.47,0:19:58.97,Default,,0,0,0,,‫كان يحمل الحقيبة
Dialogue: 0,0:19:58.97,0:20:01.27,Default,,0,0,0,,‫وهو يرتدي قناعه ودرعه الواقي.
Dialogue: 0,0:20:01.27,0:20:04.47,Default,,0,0,0,,‫إذًا هكذا فعلها! حقيبة المعدات!
Dialogue: 0,0:20:04.47,0:20:06.17,Default,,0,0,0,,‫لو وضع الجثة بداخلها وحملها إلى الخارج،
Dialogue: 0,0:20:06.17,0:20:07.97,Default,,0,0,0,,‫فلن يشكّ أحد في الأمر.
Dialogue: 0,0:20:07.97,0:20:11.37,Default,,0,0,0,,‫السيد هاكاماتا هو الوحيد الذي كان يمكنه فعل ذلك.
Dialogue: 0,0:20:11.37,0:20:13.27,Default,,0,0,0,,‫لقد قتل السيد تارومي مسبقًا،
Dialogue: 0,0:20:13.27,0:20:15.37,Default,,0,0,0,,‫وأخفى الجثة في غرفة التخزين.
Dialogue: 0,0:20:15.37,0:20:18.67,Default,,0,0,0,,‫وبينما يجعل الآخرين يبحثون عن السيد تارومي،
Dialogue: 0,0:20:18.67,0:20:20.37,Default,,0,0,0,,‫يعود إلى غرفة التخزين،
Dialogue: 0,0:20:20.37,0:20:23.57,Default,,0,0,0,,‫وبعد أن يجد الثلاثة الآخرون الجثة ويذهبون لطلب المساعدة،
Dialogue: 0,0:20:23.57,0:20:25.97,Default,,0,0,0,,‫يضع السيد تارومي داخل حقيبة المعدات،
Dialogue: 0,0:20:25.97,0:20:28.37,Default,,0,0,0,,‫ويتسلّل باتجاه غرفة الملابس.
Dialogue: 0,0:20:28.37,0:20:30.87,Default,,0,0,0,,‫لا، هذا غير ممكن.
Dialogue: 0,0:20:30.87,0:20:32.37,Default,,0,0,0,,‫حتى لو كنت مختبئًا في غرفة التخزين،
Dialogue: 0,0:20:32.37,0:20:34.17,Default,,0,0,0,,‫فلا ضمان أن أحدًا سيفتش فيها.
Dialogue: 0,0:20:34.17,0:20:36.07,Default,,0,0,0,,‫ثم إن الأمر كان مجرد مصادفة
Dialogue: 0,0:20:36.07,0:20:38.47,Default,,0,0,0,,‫أن الثلاثة جميعًا خرجوا من غرفة التخزين.
Dialogue: 0,0:20:38.47,0:20:39.77,Default,,0,0,0,,‫ولو قرر أحدهم البقاء،
Dialogue: 0,0:20:39.77,0:20:41.27,Default,,0,0,0,,‫لما استطاع الخروج.
Dialogue: 0,0:20:41.27,0:20:43.27,Default,,0,0,0,,‫مهلًا!
Dialogue: 0,0:20:43.27,0:20:44.57,Default,,0,0,0,,‫انتبه لنفسك يا فتى،
Dialogue: 0,0:20:44.57,0:20:46.77,Default,,0,0,0,,‫وإلا ستقع في ورطة كبيرة.
Dialogue: 0,0:20:46.77,0:20:48.87,Default,,0,0,0,,‫سمعت أنك تسأل عن هاوري أيضًا.
Dialogue: 0,0:20:48.87,0:20:50.97,Default,,0,0,0,,‫لقد أخبرته إذًا؟
Dialogue: 0,0:20:50.97,0:20:52.27,Default,,0,0,0,,‫بالطبع أخبره!
Dialogue: 0,0:20:52.27,0:20:54.67,Default,,0,0,0,,‫دوغوتشي وأنا بيننا معرفة قديمة.
Dialogue: 0,0:20:54.67,0:20:57.17,Default,,0,0,0,,‫كلما وقع في مشكلة جاء وأخبرني فورًا.
Dialogue: 0,0:20:57.17,0:20:59.57,Default,,0,0,0,,‫لقد عقدنا عهدًا ونحن صغار.
Dialogue: 0,0:20:59.57,0:21:02.67,Default,,0,0,0,,‫لكنّك مخطئ تمامًا في الاشتباه به.
Dialogue: 0,0:21:02.67,0:21:05.67,Default,,0,0,0,,‫إنه جبان… لا يحتمل رؤية الدم.
Dialogue: 0,0:21:05.67,0:21:07.47,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:21:07.47,0:21:10.17,Default,,0,0,0,,‫اسمع جيدًا! لا تكن مزعجًا!
Dialogue: 0,0:21:15.57,0:21:16.97,Default,,0,0,0,,‫مرحبًا؟
Dialogue: 0,0:21:16.97,0:21:18.57,Default,,0,0,0,,‫هاتوري، أنا هنا.
Dialogue: 0,0:21:18.57,0:21:20.17,Default,,0,0,0,,‫كودو، أنت؟
Dialogue: 0,0:21:20.17,0:21:22.17,Default,,0,0,0,,‫أين أنت؟ في الحافلة؟
Dialogue: 0,0:21:22.17,0:21:24.77,Default,,0,0,0,,‫لا، أبي لم يُرِد انتظار الحافلة
Dialogue: 0,0:21:24.77,0:21:26.67,Default,,0,0,0,,‫فركبنا سيارة أجرة.
Dialogue: 0,0:21:26.67,0:21:28.97,Default,,0,0,0,,‫حسنًا، خذوا وقتكم!
Dialogue: 0,0:21:28.97,0:21:31.07,Default,,0,0,0,,‫بل لماذا لا تنزلون وتأكلون طبق نودلز؟
Dialogue: 0,0:21:31.07,0:21:34.17,Default,,0,0,0,,‫وربما تتمشون قليلًا وتقومون بجولة سياحية.
Dialogue: 0,0:21:34.17,0:21:37.17,Default,,0,0,0,,‫لا تكن سخيفًا. نحن أخبرنا السائق بوجهتنا بالفعل.
Dialogue: 0,0:21:37.17,0:21:38.87,Default,,0,0,0,,‫ونحن في الطريق إليكم.
Dialogue: 0,0:21:38.87,0:21:39.87,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:21:39.87,0:21:43.07,Default,,0,0,0,,‫بالمناسبة… أنت في النهائي، أليس كذلك؟
Dialogue: 0,0:21:44.07,0:21:46.67,Default,,0,0,0,,‫هيه، هاتوري… هل أنت هناك؟
Dialogue: 0,0:21:47.87,0:21:49.37,Default,,0,0,0,,‫يا جماعة…
Dialogue: 0,0:21:49.37,0:21:53.37,Default,,0,0,0,,‫هل تعرفون دمى تدريب الإسعاف الموجودة في غرفة التخزين؟
Dialogue: 0,0:21:53.37,0:21:56.57,Default,,0,0,0,,‫طبعًا، لأننا كنا نأتي كثيرًا للتدريب هنا.
Dialogue: 0,0:21:56.57,0:21:58.87,Default,,0,0,0,,‫كم دمية موجودة هناك؟
Dialogue: 0,0:21:58.87,0:22:01.27,Default,,0,0,0,,‫اثنتان… واحدة نحيفة وواحدة كبيرة.
Dialogue: 0,0:22:01.27,0:22:02.87,Default,,0,0,0,,‫هذا هو!
Dialogue: 0,0:22:06.37,0:22:09.07,Default,,0,0,0,,‫أليس هذا هاتوري من ثانوية كايهو؟
Dialogue: 0,0:22:09.07,0:22:12.07,Default,,0,0,0,,‫ماذا يفعل هنا؟ النهائي سيبدأ الآن.
Dialogue: 0,0:22:15.87,0:22:18.97,Default,,0,0,0,,‫إن كانت فرضيتي صحيحة… فيجب أن يكون هنا.
Dialogue: 0,0:22:20.07,0:22:22.57,Default,,0,0,0,,‫لا بد أنه ما زال هنا داخل غرفة التخزين.
Dialogue: 0,0:22:26.37,0:22:28.87,Default,,0,0,0,,‫كنت أعلم!
Dialogue: 0,0:22:28.87,0:22:31.37,Default,,0,0,0,,‫هذا ما استخدمه القاتل لنقل الجثة!
Dialogue: 0,0:22:32.47,0:22:35.17,Default,,0,0,0,,‫هيجي! هيجي، أين أنت؟
Dialogue: 0,0:22:37.07,0:22:39.97,Default,,0,0,0,,‫ذلك الأحمق! أين اختفى بحق الجحيم؟
Dialogue: 0,0:22:39.97,0:22:42.57,Default,,0,0,0,,‫كازوها!
Dialogue: 0,0:22:42.57,0:22:44.07,Default,,0,0,0,,‫جئنا لنشجّع هيجي!
Dialogue: 0,0:22:44.07,0:22:45.97,Default,,0,0,0,,‫ران!
Dialogue: 0,0:22:45.97,0:22:48.27,Default,,0,0,0,,‫هل فريق هاتوري في النهائي؟
Dialogue: 0,0:22:48.27,0:22:51.27,Default,,0,0,0,,‫نعم! وسيبدأ قريبًا،
Dialogue: 0,0:22:51.27,0:22:53.97,Default,,0,0,0,,‫-لكن هيجي ذهب إلى مكان ما. -ماذا؟
Dialogue: 0,0:22:53.97,0:22:56.57,Default,,0,0,0,,‫كل ما أعرفه أنه يركض في كل مكان
Dialogue: 0,0:22:56.57,0:22:59.37,Default,,0,0,0,,‫محاولًا حل جريمة القتل التي حدثت قبل قليل.
Dialogue: 0,0:22:59.37,0:23:02.27,Default,,0,0,0,,‫جريمة قتل؟
Dialogue: 0,0:23:42.35,0:23:43.55,Default,,0,0,0,,‫السؤال هو…
Dialogue: 0,0:23:43.55,0:23:47.15,Default,,0,0,0,,‫من هو القاتل، وكيف نُقل السيد تارومي.
Dialogue: 0,0:23:47.15,0:23:49.85,Default,,0,0,0,,‫نحن نعرف كيف.
Dialogue: 0,0:23:49.85,0:23:51.45,Default,,0,0,0,,‫أحد رجالي استجوب بعض الأطفال
Dialogue: 0,0:23:51.45,0:23:53.85,Default,,0,0,0,,‫الذين كانوا يتجمعون عند مدخل الملحق،
Dialogue: 0,0:23:53.85,0:23:55.05,Default,,0,0,0,,‫ويبدو أنهم رأوا القاتل.
Dialogue: 0,0:23:55.05,0:23:56.65,Default,,0,0,0,,‫خرج شخص مريب من هنا
Dialogue: 0,0:23:56.65,0:24:01.75,Default,,0,0,0,,‫مرتديًا قناعًا ودرعًا واقيًا، ويحمل حقيبة معدات.
Dialogue: 0,0:24:02.65,0:24:04.95,Default,,0,0,0,,‫قناع ودرع وحقيبة معدات؟
Dialogue: 0,0:24:04.95,0:24:08.75,Default,,0,0,0,,‫أفهم! وضع القاتل السيد تارومي داخل حقيبة المعدات
Dialogue: 0,0:24:08.75,0:24:10.05,Default,,0,0,0,,‫وارتدى القناع ليخفي وجهه
Dialogue: 0,0:24:10.05,0:24:11.55,Default,,0,0,0,,‫حتى لا يتعرف عليه أحد وهو يخرج.
Dialogue: 0,0:24:11.55,0:24:15.35,Default,,0,0,0,,‫ومتى خرج ذلك الرجل المقنّع؟
Dialogue: 0,0:24:15.35,0:24:17.65,Default,,0,0,0,,‫يبدو أنه كان بعد أن غادر الثلاثة
Dialogue: 0,0:24:17.65,0:24:20.15,Default,,0,0,0,,‫الملحق بعد أن وجدوا الجثة.
Dialogue: 0,0:24:20.15,0:24:22.45,Default,,0,0,0,,‫إذًا الشخص الذي نقل الجثة
Dialogue: 0,0:24:22.45,0:24:26.65,Default,,0,0,0,,‫لم يكن واحدًا من الثلاثة الذين وجدوها.
Dialogue: 0,0:24:26.65,0:24:27.65,Default,,0,0,0,,‫بالضبط.
Dialogue: 0,0:24:27.65,0:24:30.15,Default,,0,0,0,,‫من المحتمل أن القاتل كان مختبئًا في غرفة التخزين
Dialogue: 0,0:24:30.15,0:24:32.15,Default,,0,0,0,,‫حين دخل الثلاثة ووجدوا جثة السيد تارومي.
Dialogue: 0,0:24:32.15,0:24:35.65,Default,,0,0,0,,‫لم يتوقع أن تُكتشف الجثة بهذه السرعة،
Dialogue: 0,0:24:35.65,0:24:37.65,Default,,0,0,0,,‫لذلك نقلها إلى هنا.
Dialogue: 0,0:24:37.65,0:24:39.55,Default,,0,0,0,,‫عذرًا يا مفتش أوتاكي…
Dialogue: 0,0:24:39.55,0:24:41.85,Default,,0,0,0,,‫هل جاء هيجي إلى هنا؟
Dialogue: 0,0:24:41.85,0:24:43.65,Default,,0,0,0,,‫نعم، كان هنا لبعض الوقت،
Dialogue: 0,0:24:43.65,0:24:46.15,Default,,0,0,0,,‫لكنّه اندفع مسرعًا إلى مكان ما.
Dialogue: 0,0:24:55.25,0:24:56.85,Default,,0,0,0,,‫لا فائدة.
Dialogue: 0,0:24:58.05,0:25:00.05,Default,,0,0,0,,‫مهما فعلت،
Dialogue: 0,0:25:00.05,0:25:01.55,Default,,0,0,0,,‫لن تستطيع أن تجعل الأمر يبدو وكأن السيد تارومي
Dialogue: 0,0:25:01.55,0:25:05.05,Default,,0,0,0,,‫قُتل في غرفة التخزين هذه.
Dialogue: 0,0:25:05.05,0:25:06.95,Default,,0,0,0,,‫السيد كوتيغاوا.
Dialogue: 0,0:25:09.25,0:25:13.65,Default,,0,0,0,,‫صحيح… هذا ليس المكان الذي قُتل فيه السيد تارومي.
Dialogue: 0,0:25:13.65,0:25:16.15,Default,,0,0,0,,‫لقد قُتل في غرفة الملابس بجانب المسبح.
Dialogue: 0,0:25:16.15,0:25:18.35,Default,,0,0,0,,‫بعد أن وجدتم جثة السيد تارومي،
Dialogue: 0,0:25:18.35,0:25:21.15,Default,,0,0,0,,‫غادر السيد أوموتاني والسيد دوغوتشي.
Dialogue: 0,0:25:21.15,0:25:23.25,Default,,0,0,0,,‫وأنت وحدك عدت
Dialogue: 0,0:25:23.25,0:25:24.65,Default,,0,0,0,,‫وأخبرته أن يذهب إلى غرفة الملابس،
Dialogue: 0,0:25:24.65,0:25:27.65,Default,,0,0,0,,‫وهناك قتلته.
Dialogue: 0,0:25:27.65,0:25:30.05,Default,,0,0,0,,‫أليس كذلك؟
Dialogue: 0,0:25:30.05,0:25:31.25,Default,,0,0,0,,‫يا للسخف.
Dialogue: 0,0:25:31.25,0:25:34.25,Default,,0,0,0,,‫لقد كانت مصادفة محضة أنهم غادروا غرفة التخزين.
Dialogue: 0,0:25:34.25,0:25:35.65,Default,,0,0,0,,‫ولو بقي أحدهم،
Dialogue: 0,0:25:35.65,0:25:36.65,Default,,0,0,0,,‫لما استطعت العودة
Dialogue: 0,0:25:36.65,0:25:38.15,Default,,0,0,0,,‫وفعل ما تزعم أنني فعلته، أليس كذلك؟
Dialogue: 0,0:25:38.15,0:25:40.35,Default,,0,0,0,,‫لا، لم تكن مصادفة.
Dialogue: 0,0:25:40.35,0:25:43.85,Default,,0,0,0,,‫كل ما كان عليك فعله هو أن تطلب من السيد أوموتاني أن يذهب لإحضار الشرطة
Dialogue: 0,0:25:43.85,0:25:46.45,Default,,0,0,0,,‫لتضمن ألا يبقى أحد.
Dialogue: 0,0:25:46.45,0:25:47.95,Default,,0,0,0,,‫أنت تعرف طبع السيد دوغوتشي.
Dialogue: 0,0:25:47.95,0:25:49.15,Default,,0,0,0,,‫كلما حدث شيء،
Dialogue: 0,0:25:49.15,0:25:50.85,Default,,0,0,0,,‫كان يبلغ السيد هاكاماتا به دائمًا.
Dialogue: 0,0:25:50.85,0:25:52.45,Default,,0,0,0,,‫وفوق ذلك، هو لا يحتمل رؤية الدم.
Dialogue: 0,0:25:52.45,0:25:53.65,Default,,0,0,0,,‫كنت تعلم أنه لن يلمس الجثة،
Dialogue: 0,0:25:53.65,0:25:57.35,Default,,0,0,0,,‫وأنه سيذهب فورًا للبحث عن السيد هاكاماتا.
Dialogue: 0,0:25:57.35,0:26:01.85,Default,,0,0,0,,‫قدّمت للسيد تارومي خمرًا ممزوجًا بمنومات،
Dialogue: 0,0:26:01.85,0:26:05.25,Default,,0,0,0,,‫ثم لطختَ عليه طلاءً أحمر ليبدو ميتًا،
Dialogue: 0,0:26:05.25,0:26:09.55,Default,,0,0,0,,‫حتى لا يظن أحد أنه ما زال حيًا.
Dialogue: 0,0:26:09.55,0:26:10.75,Default,,0,0,0,,‫هذه غرفة التخزين مظلمة،
Dialogue: 0,0:26:10.75,0:26:13.05,Default,,0,0,0,,‫لذا سيبدو الطلاء الأحمر كأنه دم حقيقي.
Dialogue: 0,0:26:14.35,0:26:16.85,Default,,0,0,0,,‫كان هناك الكثير من الناس أمام الملحق.
Dialogue: 0,0:26:16.85,0:26:18.75,Default,,0,0,0,,‫لو خرج أحد مغطى بالطلاء الأحمر من هنا،
Dialogue: 0,0:26:18.75,0:26:20.15,Default,,0,0,0,,‫ألا تظن أن أحدًا كان سيلحظه؟
Dialogue: 0,0:26:20.15,0:26:21.95,Default,,0,0,0,,‫بلى، لقد لاحظوا.
Dialogue: 0,0:26:21.95,0:26:23.35,Default,,0,0,0,,‫رأوا شخصًا مريبًا يرتدي قناعًا
Dialogue: 0,0:26:23.35,0:26:26.15,Default,,0,0,0,,‫ودرعًا واقيًا يخرج من الملحق حاملًا حقيبة معدات.
Dialogue: 0,0:26:26.15,0:26:30.55,Default,,0,0,0,,‫هيا… لا تقل إنك تقصد أن ذلك كان تارومي؟
Dialogue: 0,0:26:30.55,0:26:32.45,Default,,0,0,0,,‫ما الذي يجعلك تظن أنه سيتنكر هكذا
Dialogue: 0,0:26:32.45,0:26:36.05,Default,,0,0,0,,‫ليذهب إلى غرفة الملابس لمجرد أنني طلبت منه ذلك؟
Dialogue: 0,0:26:36.05,0:26:38.85,Default,,0,0,0,,‫لم يكن الأمر مجرد ما قلته.
Dialogue: 0,0:26:46.75,0:26:49.55,Default,,0,0,0,,‫لو أُريك شيء كهذا وأنت شبه فاقد للوعي،
Dialogue: 0,0:26:49.55,0:26:51.55,Default,,0,0,0,,‫فقد يُقنعونك بفعل أي شيء.
Dialogue: 0,0:26:52.65,0:26:55.65,Default,,0,0,0,,‫لقد قال: «سأقتلك»؟
Dialogue: 0,0:26:55.65,0:26:58.55,Default,,0,0,0,,‫هل كان السيد تارومي يقول ذلك دائمًا؟
Dialogue: 0,0:26:58.55,0:27:02.15,Default,,0,0,0,,‫نعم. يبدو أنه كان يحمل حقدًا على السيد هاكاماتا،
Dialogue: 0,0:27:02.15,0:27:04.15,Default,,0,0,0,,‫هذا ما أخبرني به أعضاء الفريق الآخرون.
Dialogue: 0,0:27:04.15,0:27:06.95,Default,,0,0,0,,‫إذًا هناك احتمال
Dialogue: 0,0:27:06.95,0:27:10.35,Default,,0,0,0,,‫أن السيد هاكاماتا هو من قتل السيد تارومي بدلًا من ذلك.
Dialogue: 0,0:27:12.85,0:27:14.55,Default,,0,0,0,,‫لا، هذا خطأ.
Dialogue: 0,0:27:14.55,0:27:18.45,Default,,0,0,0,,‫القاتل استغل غضب السيد تارومي على الأرجح.
Dialogue: 0,0:27:18.45,0:27:21.85,Default,,0,0,0,,‫صحيح. عندما عدت إلى هنا وحدك،
Dialogue: 0,0:27:21.85,0:27:25.25,Default,,0,0,0,,‫وضعت السيف الياباني في يد السيد تارومي.
Dialogue: 0,0:27:25.25,0:27:26.65,Default,,0,0,0,,‫وأيقظته ثم أريته
Dialogue: 0,0:27:26.65,0:27:28.85,Default,,0,0,0,,‫الدمية التي أخفيتها مسبقًا داخل حصان القفز.
Dialogue: 0,0:27:28.85,0:27:30.85,Default,,0,0,0,,‫ثم غالبًا قلت له:
Dialogue: 0,0:27:30.85,0:27:33.85,Default,,0,0,0,,‫«ما الذي فعلته بحق السماء؟!»
Dialogue: 0,0:27:34.95,0:27:37.35,Default,,0,0,0,,‫كان السيد تارومي يكره السيد هاكاماتا،
Dialogue: 0,0:27:37.35,0:27:39.15,Default,,0,0,0,,‫وكان لا يزال في حالة ذهول.
Dialogue: 0,0:27:40.15,0:27:41.95,Default,,0,0,0,,‫لذلك لم ينتبه أنها مجرد دمية
Dialogue: 0,0:27:41.95,0:27:43.85,Default,,0,0,0,,‫تُستخدم لتعليم تقنيات الإسعاف
Dialogue: 0,0:27:43.85,0:27:47.65,Default,,0,0,0,,‫وترتدي زي السيد هاكاماتا.
Dialogue: 0,0:27:47.65,0:27:50.85,Default,,0,0,0,,‫ولهذا ظن أن الطلاء الأحمر على واقي صدره
Dialogue: 0,0:27:50.85,0:27:52.65,Default,,0,0,0,,‫هو دم السيد هاكاماتا،
Dialogue: 0,0:27:52.65,0:27:56.45,Default,,0,0,0,,‫وأنه قتله وهو ثمل.
Dialogue: 0,0:27:57.45,0:27:58.55,Default,,0,0,0,,‫وعندها على الأرجح قلت له
Dialogue: 0,0:27:58.55,0:28:00.55,Default,,0,0,0,,‫أنك ستسمح له بالهرب
Dialogue: 0,0:28:00.55,0:28:04.35,Default,,0,0,0,,‫قبل وصول الشرطة، وعليه أن يضع القناع
Dialogue: 0,0:28:04.35,0:28:08.05,Default,,0,0,0,,‫ويتسلل إلى غرفة الملابس بجانب المسبح ويختبئ هناك.
Dialogue: 0,0:28:08.05,0:28:10.45,Default,,0,0,0,,‫واقترحتَ عليه أيضًا أن يبدّل ملابسه الملطخة،
Dialogue: 0,0:28:10.45,0:28:11.75,Default,,0,0,0,,‫ويرتدي الدرع الواقي
Dialogue: 0,0:28:11.75,0:28:13.65,Default,,0,0,0,,‫ويضع السيف داخل حقيبة سيف الخيزران.
Dialogue: 0,0:28:13.65,0:28:16.15,Default,,0,0,0,,‫ثم طلبتَ منه أن يأخذها معه، أليس كذلك؟
Dialogue: 0,0:28:17.85,0:28:20.15,Default,,0,0,0,,‫كنت قد وضعت الملابس الإضافية والدرع الواقي في حقيبة المعدات
Dialogue: 0,0:28:20.15,0:28:22.95,Default,,0,0,0,,‫وأخفيتها مسبقًا في غرفة التخزين.
Dialogue: 0,0:28:22.95,0:28:25.15,Default,,0,0,0,,‫وذلك ليبدو وكأن شخصًا آخر غيرك
Dialogue: 0,0:28:25.15,0:28:29.45,Default,,0,0,0,,‫هو من أخرج الجثة من غرفة التخزين مرتديًا القناع.
Dialogue: 0,0:28:30.35,0:28:33.55,Default,,0,0,0,,‫ثم سلكتَ طريقًا مختصرًا إلى غرفة الملابس
Dialogue: 0,0:28:33.55,0:28:36.05,Default,,0,0,0,,‫وانتظرت وصول السيد تارومي،
Dialogue: 0,0:28:36.05,0:28:38.15,Default,,0,0,0,,‫وحين وصل… قتلته فعلًا.
Dialogue: 0,0:28:39.25,0:28:43.45,Default,,0,0,0,,‫بعد ذلك غسلتَ الطلاء عن جسده في الدش،
Dialogue: 0,0:28:43.45,0:28:46.85,Default,,0,0,0,,‫ووضعتَ القناع والدرع الواقي في حقيبة المعدات.
Dialogue: 0,0:28:46.85,0:28:48.65,Default,,0,0,0,,‫وبعد أن أخفيتها في مكان ما،
Dialogue: 0,0:28:48.65,0:28:52.05,Default,,0,0,0,,‫ذهبتَ إلى مخفر الشرطة حيث أرسلتَ السيد أوموتاني.
Dialogue: 0,0:28:52.05,0:28:53.35,Default,,0,0,0,,‫هناك فعلتها، صحيح؟
Dialogue: 0,0:28:53.35,0:28:55.05,Default,,0,0,0,,‫هناك علِق دم السيد تارومي
Dialogue: 0,0:28:55.05,0:28:57.55,Default,,0,0,0,,‫على المنشفة التي تمسكها الآن.
Dialogue: 0,0:28:57.55,0:29:00.45,Default,,0,0,0,,‫وعندما ذهبتَ لتحضر الدمية من داخل حصان القفز،
Dialogue: 0,0:29:00.45,0:29:02.65,Default,,0,0,0,,‫قررتَ أن تلطخها بدمه
Dialogue: 0,0:29:02.65,0:29:07.05,Default,,0,0,0,,‫لتبدو وكأنه قُتل هنا حقًا، أليس كذلك؟
Dialogue: 0,0:29:07.85,0:29:10.85,Default,,0,0,0,,‫تلك المنشفة الملطخة بالدم في يدك
Dialogue: 0,0:29:10.85,0:29:14.15,Default,,0,0,0,,‫تثبت أنك أنت من قتله!
Dialogue: 0,0:29:18.85,0:29:21.25,Default,,0,0,0,,‫إن كنت تعرف كل هذا،
Dialogue: 0,0:29:21.25,0:29:23.25,Default,,0,0,0,,‫فلا بد أنك تعرف أيضًا لماذا فعلتُ ذلك.
Dialogue: 0,0:29:23.25,0:29:28.05,Default,,0,0,0,,‫نعم. اتصلتُ بالجامعة التي تدرس فيها وتحققت من أمرك.
Dialogue: 0,0:29:28.05,0:29:29.05,Default,,0,0,0,,‫وعرفتُ أنه في العام الماضي،
Dialogue: 0,0:29:29.05,0:29:31.55,Default,,0,0,0,,‫أحد الأعضاء الجدد في فريق الكندو لديكم
Dialogue: 0,0:29:31.55,0:29:35.85,Default,,0,0,0,,‫فقد وعيه أثناء التدريب وتوفي.
Dialogue: 0,0:29:37.45,0:29:40.15,Default,,0,0,0,,‫الجامعة ادّعت أنه حادث،
Dialogue: 0,0:29:40.15,0:29:41.45,Default,,0,0,0,,‫لكن الحقيقة هي…
Dialogue: 0,0:29:41.45,0:29:45.55,Default,,0,0,0,,‫نعم… كنا نقيم طقوس «الاستقبال» للأعضاء الجدد.
Dialogue: 0,0:29:45.55,0:29:48.95,Default,,0,0,0,,‫تارومي لم يعرف حدود قوته… فتمادى.
Dialogue: 0,0:29:48.95,0:29:53.35,Default,,0,0,0,,‫هاكاماتا كان المفترض أن يكون الحكم، لكنه كان غائبًا ذلك اليوم.
Dialogue: 0,0:29:53.35,0:29:55.15,Default,,0,0,0,,‫وهذا ما قاله تارومي:
Dialogue: 0,0:29:55.15,0:29:56.75,Default,,0,0,0,,‫«صحيح أنني أنا من فعلها،
Dialogue: 0,0:29:56.75,0:30:00.25,Default,,0,0,0,,‫لكن كل من كان حاضرًا هنا اليوم والمديرة مذنبون مثلي.
Dialogue: 0,0:30:00.25,0:30:02.55,Default,,0,0,0,,‫وإن تكلم أحد… فسأسقطكم جميعًا معي.»
Dialogue: 0,0:30:02.55,0:30:04.95,Default,,0,0,0,,‫إذًا قررتَ إسكاتَه
Dialogue: 0,0:30:04.95,0:30:07.55,Default,,0,0,0,,‫كي لا يفسد الأمر على الجميع،
Dialogue: 0,0:30:07.55,0:30:10.55,Default,,0,0,0,,‫خصوصًا وأن لديك مسارًا مهنيًا جديدًا.
Dialogue: 0,0:30:10.55,0:30:12.85,Default,,0,0,0,,‫يبدو أنك تعرف كل شيء،
Dialogue: 0,0:30:12.85,0:30:15.15,Default,,0,0,0,,‫لكن بما أنك غير مسلح،
Dialogue: 0,0:30:15.15,0:30:17.45,Default,,0,0,0,,‫فأنت لم تكن تعرف بهذا، أليس كذلك؟
Dialogue: 0,0:30:18.45,0:30:22.75,Default,,0,0,0,,‫عارض «السحب السريع» كان معه شريك.
Dialogue: 0,0:30:22.75,0:30:24.55,Default,,0,0,0,,‫ومن الطبيعي… حين دخلتُ
Dialogue: 0,0:30:24.55,0:30:26.65,Default,,0,0,0,,‫غرفة تبديل ملابس العارض لأسرق السيف،
Dialogue: 0,0:30:26.65,0:30:28.15,Default,,0,0,0,,‫كنت قد...
Dialogue: 0,0:30:28.15,0:30:30.35,Default,,0,0,0,,‫جرّبتُ بضع ضربات تدريبية به!
Dialogue: 0,0:30:34.05,0:30:35.05,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:30:35.05,0:30:38.65,Default,,0,0,0,,‫اتصل بك رجل غريب وأخبرك أن تأتي إلى غرفة الملابس؟
Dialogue: 0,0:30:38.65,0:30:40.15,Default,,0,0,0,,‫حقًا؟
Dialogue: 0,0:30:40.15,0:30:42.25,Default,,0,0,0,,‫نعم. وعندما وصلوا جميعًا،
Dialogue: 0,0:30:42.25,0:30:45.75,Default,,0,0,0,,‫وجدوا أن السيد تارومي قد نُقل إلى هنا.
Dialogue: 0,0:30:45.75,0:30:50.05,Default,,0,0,0,,‫والسبب الذي جعل القاتل يتصل ليبلغ عن مكان السيد تارومي هو
Dialogue: 0,0:30:50.05,0:30:52.85,Default,,0,0,0,,‫أنه لم يُرِد أن يتم تفتيش غرفة التخزين.
Dialogue: 0,0:30:52.85,0:30:55.75,Default,,0,0,0,,‫وهذا يعني أن هناك شيئًا لا يريد أن يُعثر عليه… وما زال في الداخل.
Dialogue: 0,0:30:57.55,0:30:59.85,Default,,0,0,0,,‫هيه… أين غرفة التخزين؟
Dialogue: 0,0:30:59.85,0:31:02.65,Default,,0,0,0,,‫في الملحق بجانب الصالة الرياضية. لماذا؟
Dialogue: 0,0:31:03.75,0:31:05.75,Default,,0,0,0,,‫-أرِني! -مهلًا، تمهّل!
Dialogue: 0,0:31:05.75,0:31:07.35,Default,,0,0,0,,‫كونان، إلى أين تذهب؟
Dialogue: 0,0:31:10.55,0:31:11.55,Default,,0,0,0,,‫لا تكن أحمقًا!
Dialogue: 0,0:31:11.55,0:31:13.25,Default,,0,0,0,,‫لن تفلت من العقاب هذه المرة
Dialogue: 0,0:31:13.25,0:31:15.05,Default,,0,0,0,,‫إذا قتلتني هنا!
Dialogue: 0,0:31:15.05,0:31:16.95,Default,,0,0,0,,‫لا تقلقني.
Dialogue: 0,0:31:16.95,0:31:19.55,Default,,0,0,0,,‫ستظن الشرطة أنه القاتل نفسه،
Dialogue: 0,0:31:19.55,0:31:20.95,Default,,0,0,0,,‫وبما أنهم قرروا مسبقًا
Dialogue: 0,0:31:20.95,0:31:23.65,Default,,0,0,0,,‫أنني لا يمكن أن أكون من نقل جثة تارومي،
Dialogue: 0,0:31:23.65,0:31:26.45,Default,,0,0,0,,‫فلن يشكّوا بي أصلًا.
Dialogue: 0,0:31:27.75,0:31:29.35,Default,,0,0,0,,‫لقد اكتشفتُ كل شيء بالفعل!
Dialogue: 0,0:31:40.05,0:31:41.95,Default,,0,0,0,,‫لقد اخترت الشخص الخطأ لتتشاجر معه.
Dialogue: 0,0:31:41.95,0:31:43.15,Default,,0,0,0,,‫ما هذا بحق…؟
Dialogue: 0,0:31:44.55,0:31:46.55,Default,,0,0,0,,‫هاتّوري؟
Dialogue: 0,0:31:46.55,0:31:48.15,Default,,0,0,0,,‫لا تقل إنك…
Dialogue: 0,0:31:48.15,0:31:50.05,Default,,0,0,0,,‫ذلك الفتى الثانوي الذي صدم الجميع
Dialogue: 0,0:31:50.05,0:31:52.55,Default,,0,0,0,,‫بفوزه على فريق شرطة أوساكا بالكامل،
Dialogue: 0,0:31:52.55,0:31:54.75,Default,,0,0,0,,‫مع أنهم مدرَّبون جيدًا.
Dialogue: 0,0:31:54.75,0:31:58.05,Default,,0,0,0,,‫صحيح… لكنك أدركت ذلك متأخرًا.
Dialogue: 0,0:31:59.05,0:32:00.75,Default,,0,0,0,,‫يورانوسكي!
Dialogue: 0,0:32:07.05,0:32:08.75,Default,,0,0,0,,‫يو! سعيد برؤيتك!
Dialogue: 0,0:32:08.75,0:32:10.65,Default,,0,0,0,,‫هيجي؟
Dialogue: 0,0:32:16.65,0:32:19.75,Default,,0,0,0,,‫حسنًا يا أوتاكي… سأترك الأمر لك من هنا.
Dialogue: 0,0:32:19.75,0:32:22.65,Default,,0,0,0,,‫اعتمد عليّ. وبالتوفيق لك أنت أيضًا يا هيجي.
Dialogue: 0,0:32:22.65,0:32:25.25,Default,,0,0,0,,‫كدت أنسى! المباراة!
Dialogue: 0,0:32:25.25,0:32:27.25,Default,,0,0,0,,‫لا يمكننا إضاعة الوقت هنا!
Dialogue: 0,0:32:27.25,0:32:29.05,Default,,0,0,0,,‫هل أنت بخير؟
Dialogue: 0,0:32:31.55,0:32:35.15,Default,,0,0,0,,‫أوه، لا… أظن أنها انتهت بالفعل.
Dialogue: 0,0:32:35.15,0:32:36.45,Default,,0,0,0,,‫حسنًا، لم يكن هناك مفر.
Dialogue: 0,0:32:36.45,0:32:39.65,Default,,0,0,0,,‫خسرنا البطولة لكننا حللنا القضية.
Dialogue: 0,0:32:39.65,0:32:41.05,Default,,0,0,0,,‫أليس كذلك؟
Dialogue: 0,0:32:41.05,0:32:42.35,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:32:44.05,0:32:46.65,Default,,0,0,0,,‫متى دور هيجي؟
Dialogue: 0,0:32:57.65,0:32:59.25,Default,,0,0,0,,‫هذا لذيذ جدًا!
Dialogue: 0,0:32:59.25,0:33:01.25,Default,,0,0,0,,‫إنه الأفضل!
Dialogue: 0,0:33:01.25,0:33:02.75,Default,,0,0,0,,‫طبعًا هو كذلك.
Dialogue: 0,0:33:02.75,0:33:05.45,Default,,0,0,0,,‫لا أحد يصنع «تيتشيري» أفضل من أمي.
Dialogue: 0,0:33:06.95,0:33:10.05,Default,,0,0,0,,‫انظري إليها… نامت دون أن تذوق لقمة واحدة.
Dialogue: 0,0:33:10.05,0:33:11.65,Default,,0,0,0,,‫كل هذا بسببك!
Dialogue: 0,0:33:11.65,0:33:15.05,Default,,0,0,0,,‫كانت تركض في كل مكان تبحث عنك!
Dialogue: 0,0:33:15.05,0:33:16.55,Default,,0,0,0,,‫حسنًا… لم يكن بيدي.
Dialogue: 0,0:33:16.55,0:33:19.05,Default,,0,0,0,,‫كان عليّ أن أحل جريمة القتل، أليس كذلك؟
Dialogue: 0,0:33:19.05,0:33:21.95,Default,,0,0,0,,‫يمكنك أن ترى أنه ابن قائد الشرطة.
Dialogue: 0,0:33:21.95,0:33:25.05,Default,,0,0,0,,‫حل القضية بسرعة كبيرة.
Dialogue: 0,0:33:25.05,0:33:26.35,Default,,0,0,0,,‫شكرًا لك.
Dialogue: 0,0:33:26.35,0:33:29.25,Default,,0,0,0,,‫هذا الصغير يحل القضايا بالحدس فقط.
Dialogue: 0,0:33:29.25,0:33:31.15,Default,,0,0,0,,‫إنه فقط يتقمص دور المحقق.
Dialogue: 0,0:33:31.15,0:33:32.65,Default,,0,0,0,,‫ولا يقترب حتى
Dialogue: 0,0:33:32.65,0:33:34.65,Default,,0,0,0,,‫من أن يكون محققًا حقيقيًا مثلك، يا سيد موري.
Dialogue: 0,0:33:34.65,0:33:36.45,Default,,0,0,0,,‫وماذا يُفترض أن يعني هذا؟
Dialogue: 0,0:33:36.45,0:33:38.75,Default,,0,0,0,,‫أن كودو أفضل مني أيضًا؟
Dialogue: 0,0:33:41.45,0:33:43.75,Default,,0,0,0,,‫لكن يا هيزو… إنه يشبهك تمامًا
Dialogue: 0,0:33:43.75,0:33:45.15,Default,,0,0,0,,‫حين كنت في سنه.
Dialogue: 0,0:33:45.15,0:33:47.25,Default,,0,0,0,,‫لا أريد أن أتخيل كيف سيكون عندما يكبر.
Dialogue: 0,0:33:48.15,0:33:50.55,Default,,0,0,0,,‫هيه يا توياما… خفّف من الشراب.
Dialogue: 0,0:33:50.55,0:33:52.35,Default,,0,0,0,,‫أنت ستقود، أليس كذلك؟
Dialogue: 0,0:33:52.35,0:33:56.75,Default,,0,0,0,,‫لا تقلق… سأجعلك تقودني إلى البيت.
Dialogue: 0,0:34:01.45,0:34:02.75,Default,,0,0,0,,‫بماذا أردت أن تتحدث؟
Dialogue: 0,0:34:02.75,0:34:06.05,Default,,0,0,0,,‫أليس لهذا السبب أردتني أن أوصلك إلى البيت؟
Dialogue: 0,0:34:06.05,0:34:07.35,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:34:07.35,0:34:09.85,Default,,0,0,0,,‫الأمر يتعلق بهيجي وابنتي كازوها.
Dialogue: 0,0:34:09.85,0:34:12.25,Default,,0,0,0,,‫ما رأيك في علاقتهما؟
Dialogue: 0,0:34:13.25,0:34:14.85,Default,,0,0,0,,‫كازوها أصبحت في السابعة عشرة.
Dialogue: 0,0:34:14.85,0:34:16.15,Default,,0,0,0,,‫ستذهب إلى الجامعة قريبًا.
Dialogue: 0,0:34:16.15,0:34:17.65,Default,,0,0,0,,‫وعندما تعود… ستكون في العشرين.
Dialogue: 0,0:34:17.65,0:34:22.05,Default,,0,0,0,,‫على أي حال، سيأتي يوم ويأخذها مني شخص لا فائدة منه…
Dialogue: 0,0:34:22.05,0:34:24.15,Default,,0,0,0,,‫فقلت لنفسي: فليكن إذًا ذلك الابن عديم القيمة لديك.
Dialogue: 0,0:34:24.15,0:34:27.55,Default,,0,0,0,,‫توياما… ادخل في صلب الموضوع.
Dialogue: 0,0:34:29.35,0:34:32.85,Default,,0,0,0,,‫ما زلت لا تتحمل المزاح، أليس كذلك؟
Dialogue: 0,0:34:32.85,0:34:35.95,Default,,0,0,0,,‫إذًا كنت تمزح فقط؟
Dialogue: 0,0:34:35.95,0:34:39.85,Default,,0,0,0,,‫هل تذكر ما حدث في قلعة أوساكا قبل 13 سنة؟
Dialogue: 0,0:34:39.85,0:34:44.25,Default,,0,0,0,,‫تقصد الجثة المتفحمة المجهولة التي وُجدت في الخندق الداخلي؟
Dialogue: 0,0:34:44.25,0:34:47.05,Default,,0,0,0,,‫وتلك القطعة الفخارية التي كان الضحية
Dialogue: 0,0:34:47.05,0:34:49.45,Default,,0,0,0,,‫يخفيها في جيبه.
Dialogue: 0,0:34:51.35,0:34:52.65,Default,,0,0,0,,‫كانت تلك القطعة الفخارية
Dialogue: 0,0:34:52.65,0:34:55.65,Default,,0,0,0,,‫هي محور حديثنا الرئيسي وقتها.
Dialogue: 0,0:34:55.65,0:34:57.95,Default,,0,0,0,,‫ألّفنا حولها قصصًا كثيرة.
Dialogue: 0,0:34:57.95,0:35:01.15,Default,,0,0,0,,‫لكن يبدو… أنها ربما لم تكن مجرد قصص.
Dialogue: 0,0:35:02.65,0:35:04.65,Default,,0,0,0,,‫لقد وجدنا قطعة أخرى.
Dialogue: 0,0:35:04.65,0:35:07.65,Default,,0,0,0,,‫كانت على الجثة المتفحمة التي عثرنا عليها في الخندق الشرقي منذ وقت غير طويل.
Dialogue: 0,0:35:07.65,0:35:10.45,Default,,0,0,0,,‫وتبدو تمامًا مثل هذه.
Dialogue: 0,0:35:10.45,0:35:12.85,Default,,0,0,0,,‫المعمل يفحصها الآن،
Dialogue: 0,0:35:12.85,0:35:16.75,Default,,0,0,0,,‫لكنهم شبه متأكدين أنها صُنعت في الحقبة نفسها.
Dialogue: 0,0:35:16.75,0:35:19.25,Default,,0,0,0,,‫وهناك أمر آخر… على القطعة التي وجدناها للتو،
Dialogue: 0,0:35:19.25,0:35:23.25,Default,,0,0,0,,‫يمكنك تمييز الرقم «848» عليها.
Dialogue: 0,0:35:25.15,0:35:29.55,Default,,0,0,0,,‫قد تسير الأمور كما ظننا قبل 13 سنة.
Dialogue: 0,0:35:30.35,0:35:33.25,Default,,0,0,0,,‫قد يكون ما نبحث عنه ما زال ملقىً في مكان ما.
Dialogue: 0,0:35:33.25,0:35:38.45,Default,,0,0,0,,‫نعم… الثروة الهائلة التي تركها ذلك الرجل العظيم.
Dialogue: 0,0:35:48.43,0:35:51.03,Default,,0,0,0,,‫ذلك المبنى الدائري هو «قاعة أوساكا».
Dialogue: 0,0:35:51.03,0:35:54.03,Default,,0,0,0,,‫و«منتزه أعمال أوساكا» هناك
Dialogue: 0,0:35:54.03,0:35:56.03,Default,,0,0,0,,‫حيث كل تلك المباني.
Dialogue: 0,0:35:56.03,0:36:00.53,Default,,0,0,0,,‫ولا يمكنك رؤيتها من هنا لأنها خلف المبنى،
Dialogue: 0,0:36:00.53,0:36:04.23,Default,,0,0,0,,‫لكن محطة التلفزيون الأكثر إثارة في أوساكا تقع خلفه!
Dialogue: 0,0:36:05.23,0:36:08.03,Default,,0,0,0,,‫وهناك رمز المدينة… قلعة أوساكا.
Dialogue: 0,0:36:09.23,0:36:11.73,Default,,0,0,0,,‫إذًا؟ الآن عرفتَ كم أوساكا عظيمة!
Dialogue: 0,0:36:11.73,0:36:12.93,Default,,0,0,0,,‫هذا نفس الكلام الذي قلته
Dialogue: 0,0:36:12.93,0:36:15.73,Default,,0,0,0,,‫عندما أخذناهم في جولة آخر مرة.
Dialogue: 0,0:36:15.73,0:36:18.63,Default,,0,0,0,,‫-ماذا؟ -وفوق ذلك، نحن أريناهُم
Dialogue: 0,0:36:18.63,0:36:22.03,Default,,0,0,0,,‫منظر المدينة من الأعلى عند تسوتينكاكو في المرة الماضية.
Dialogue: 0,0:36:22.03,0:36:24.03,Default,,0,0,0,,‫ما كان ينبغي أن أسمح لك بأن تكون المرشد.
Dialogue: 0,0:36:24.03,0:36:27.03,Default,,0,0,0,,‫أعلم، لكن مهرجان تينجين ومهرجان غيون
Dialogue: 0,0:36:27.03,0:36:29.33,Default,,0,0,0,,‫وحتى مهرجان دانجيري في كيشيوادا انتهت كلها،
Dialogue: 0,0:36:29.33,0:36:31.43,Default,,0,0,0,,‫ولم يبقَ إلا قلعة أوساكا.
Dialogue: 0,0:36:31.43,0:36:35.73,Default,,0,0,0,,‫إذًا لو كان الأمر بيدك… أين كنت ستأخذنا؟
Dialogue: 0,0:36:35.73,0:36:38.93,Default,,0,0,0,,‫دعني أفكر… لو كنت أنا،
Dialogue: 0,0:36:38.93,0:36:41.33,Default,,0,0,0,,‫فهو أمام هذه القلعة مباشرة.
Dialogue: 0,0:36:41.33,0:36:45.73,Default,,0,0,0,,‫كنت سأعطيكم جولة فخمة في مقر شرطة أوساكا.
Dialogue: 0,0:36:45.73,0:36:48.23,Default,,0,0,0,,‫وأُدخلكم إلى المبنى الجديد
Dialogue: 0,0:36:48.23,0:36:50.23,Default,,0,0,0,,‫الذي شارف على الانتهاء.
Dialogue: 0,0:36:51.93,0:36:52.93,Default,,0,0,0,,‫يا لغبائك.
Dialogue: 0,0:36:52.93,0:36:56.73,Default,,0,0,0,,‫أنت وحدك من سيستمتع بشيء كهذا.
Dialogue: 0,0:36:56.73,0:36:59.03,Default,,0,0,0,,‫هذا يبدو ممتعًا.
Dialogue: 0,0:36:59.03,0:37:00.63,Default,,0,0,0,,‫قلعة أوساكا أجمل بكثير
Dialogue: 0,0:37:00.63,0:37:03.73,Default,,0,0,0,,‫من رؤيتها على التلفاز أو في الصور.
Dialogue: 0,0:37:03.73,0:37:06.03,Default,,0,0,0,,‫لاحظتِ؟ لقد انتهوا لتوهم من ترميمها،
Dialogue: 0,0:37:06.03,0:37:07.63,Default,,0,0,0,,‫فصارت نظيفة وجميلة.
Dialogue: 0,0:37:07.63,0:37:11.03,Default,,0,0,0,,‫لم يجروا أي أعمال عليها
Dialogue: 0,0:37:11.03,0:37:13.53,Default,,0,0,0,,‫منذ أن رمموا البرج قبل نحو 60 عامًا.
Dialogue: 0,0:37:13.53,0:37:15.53,Default,,0,0,0,,‫بل قبل 70 عامًا.
Dialogue: 0,0:37:15.53,0:37:17.03,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:37:17.03,0:37:22.13,Default,,0,0,0,,‫هيديوشي تويوتومي بناها أول مرة عام 1599.
Dialogue: 0,0:37:22.13,0:37:26.03,Default,,0,0,0,,‫ثم أعاد توكوغاوا بناءها عام 1629.
Dialogue: 0,0:37:26.03,0:37:30.63,Default,,0,0,0,,‫وأهل أوساكا رمموها قبل 70 عامًا… عام 1931،
Dialogue: 0,0:37:30.63,0:37:34.63,Default,,0,0,0,,‫وهذا هو البرج الثالث.
Dialogue: 0,0:37:35.93,0:37:37.93,Default,,0,0,0,,‫يبدو أنك تعرف معلوماتك جيدًا.
Dialogue: 0,0:37:37.93,0:37:43.03,Default,,0,0,0,,‫طبعًا أعرف! هيديوشي تويوتومي بطلي.
Dialogue: 0,0:37:43.63,0:37:46.43,Default,,0,0,0,,‫تقول ذلك، لكن الشارة التي ترتديها
Dialogue: 0,0:37:46.43,0:37:49.83,Default,,0,0,0,,‫تشبه شعار توكوغاوا… زهرة الخباز ثلاثية الأوراق.
Dialogue: 0,0:37:49.83,0:37:51.73,Default,,0,0,0,,‫حسنًا… الأمر كالتالي.
Dialogue: 0,0:37:51.73,0:37:54.03,Default,,0,0,0,,‫هيه يا إيئه-ياسو، ماذا تفعل؟
Dialogue: 0,0:37:54.03,0:37:55.83,Default,,0,0,0,,‫السيد ينتظرك.
Dialogue: 0,0:37:55.83,0:37:58.33,Default,,0,0,0,,‫آسف يا ميتسوهيده.
Dialogue: 0,0:37:58.33,0:38:01.03,Default,,0,0,0,,‫-إيئه-ياسو؟ -ميتسوهيده؟
Dialogue: 0,0:38:01.03,0:38:02.23,Default,,0,0,0,,‫السيد؟
Dialogue: 0,0:38:04.63,0:38:07.83,Default,,0,0,0,,‫«جولة بحثية لمدة 8 أيام عن هيديوشي تويوتومي»؟
Dialogue: 0,0:38:07.83,0:38:11.33,Default,,0,0,0,,‫نعم، هذا اسم جولتنا.
Dialogue: 0,0:38:11.33,0:38:13.93,Default,,0,0,0,,‫كل أفراد الجولة من معجبي هيديوشي،
Dialogue: 0,0:38:13.93,0:38:16.73,Default,,0,0,0,,‫وتعرّفنا على بعض عبر الإنترنت.
Dialogue: 0,0:38:16.73,0:38:20.73,Default,,0,0,0,,‫بدأنا من ناغويا إلى كيوتو نزور الأماكن المشهورة عنه
Dialogue: 0,0:38:20.73,0:38:22.83,Default,,0,0,0,,‫والآن نحن في أوساكا.
Dialogue: 0,0:38:22.83,0:38:26.73,Default,,0,0,0,,‫وماذا عن الأسماء التي تنادون بها بعضكم وتلك الشارات؟
Dialogue: 0,0:38:26.73,0:38:29.43,Default,,0,0,0,,‫إنها أشبه بعقوبة في لعبة.
Dialogue: 0,0:38:29.43,0:38:30.73,Default,,0,0,0,,‫كل يوم بعد الإفطار،
Dialogue: 0,0:38:30.73,0:38:32.83,Default,,0,0,0,,‫نُجري قرعة لتحديد الأدوار التي سنلعبها
Dialogue: 0,0:38:32.83,0:38:34.63,Default,,0,0,0,,‫ثم نضع الشارات
Dialogue: 0,0:38:34.63,0:38:39.53,Default,,0,0,0,,‫التي تحمل شعارات نوبوناغا، هيديوشي، إيئه-ياسو وميتسوهيده.
Dialogue: 0,0:38:39.53,0:38:41.13,Default,,0,0,0,,‫وطوال اليوم،
Dialogue: 0,0:38:41.13,0:38:44.03,Default,,0,0,0,,‫من تقع عليه أدوار هيديوشي وإيئه-ياسو وميتسوهيده
Dialogue: 0,0:38:44.03,0:38:46.43,Default,,0,0,0,,‫عليه أن يلعب دوره
Dialogue: 0,0:38:46.43,0:38:50.53,Default,,0,0,0,,‫ويخدم من يكون دوره نوبوناغا.
Dialogue: 0,0:38:50.53,0:38:52.63,Default,,0,0,0,,‫مثلًا… نلتقط له صورًا تذكارية
Dialogue: 0,0:38:52.63,0:38:54.63,Default,,0,0,0,,‫أو نذهب لقضاء حاجاته… أشياء كهذه.
Dialogue: 0,0:38:55.53,0:38:57.43,Default,,0,0,0,,‫ومن جهة أخرى…
Dialogue: 0,0:38:57.43,0:38:59.63,Default,,0,0,0,,‫نوبوناغا عليه أن يعطي هيديوشي وإيئه-ياسو
Dialogue: 0,0:38:59.63,0:39:02.43,Default,,0,0,0,,‫مالًا للعشاء.
Dialogue: 0,0:39:02.43,0:39:05.53,Default,,0,0,0,,‫-أليس كذلك؟ -نعم، صحيح يا نيني.
Dialogue: 0,0:39:05.53,0:39:07.73,Default,,0,0,0,,‫تقصدون أن لديكم شخصًا يلعب دور «نيني» أيضًا؟
Dialogue: 0,0:39:07.73,0:39:11.43,Default,,0,0,0,,‫بالضبط. من يسحب ورقة القرعة الفارغة يصبح «نيني».
Dialogue: 0,0:39:11.43,0:39:12.53,Default,,0,0,0,,‫وعليه أن يراقب الجميع
Dialogue: 0,0:39:12.53,0:39:14.53,Default,,0,0,0,,‫ويمرر الأمور بابتسامة.
Dialogue: 0,0:39:14.53,0:39:17.63,Default,,0,0,0,,‫لكنني أشفق على من يلعب دور ميتسوهيده.
Dialogue: 0,0:39:17.63,0:39:18.63,Default,,0,0,0,,‫عليه أن يدفع عشاءه بنفسه
Dialogue: 0,0:39:18.63,0:39:20.83,Default,,0,0,0,,‫مع أنه يتعب طوال اليوم، أليس كذلك؟
Dialogue: 0,0:39:20.83,0:39:23.33,Default,,0,0,0,,‫لكن لعب دور ميتسوهيده له مكافآته أيضًا.
Dialogue: 0,0:39:23.33,0:39:25.73,Default,,0,0,0,,‫يحصل على فرصة لعب دور نوبوناغا لمدة 3 دقائق
Dialogue: 0,0:39:25.73,0:39:27.73,Default,,0,0,0,,‫وهو يختار التوقيت.
Dialogue: 0,0:39:27.73,0:39:30.33,Default,,0,0,0,,‫أفهم… بدلًا من «سيد» لثلاثة أيام،
Dialogue: 0,0:39:30.33,0:39:32.43,Default,,0,0,0,,‫إنه «سيد» لثلاث دقائق.
Dialogue: 0,0:39:32.43,0:39:33.83,Default,,0,0,0,,‫يبدو سخيفًا.
Dialogue: 0,0:39:33.83,0:39:35.63,Default,,0,0,0,,‫بل يبدو ممتعًا.
Dialogue: 0,0:39:35.63,0:39:37.33,Default,,0,0,0,,‫إنه ممتع فعلًا.
Dialogue: 0,0:39:37.33,0:39:39.83,Default,,0,0,0,,‫إذًا أنتم هنا جميعًا.
Dialogue: 0,0:39:39.83,0:39:42.93,Default,,0,0,0,,‫لم أجدكم… فظللت أبحث في كل مكان.
Dialogue: 0,0:39:42.93,0:39:45.43,Default,,0,0,0,,‫يا سيدي نوبوناغا… سامحنا رجاءً.
Dialogue: 0,0:39:45.43,0:39:49.03,Default,,0,0,0,,‫هذا شاي أولونغ الذي طلبته.
Dialogue: 0,0:39:49.03,0:39:52.63,Default,,0,0,0,,‫وهذه بطاقة بريدية لقلعة أوساكا.
Dialogue: 0,0:39:52.63,0:39:54.93,Default,,0,0,0,,‫شكرًا… هذا لطفٌ منك.
Dialogue: 0,0:39:54.93,0:39:57.93,Default,,0,0,0,,‫إنه نوبوناغا متواضع جدًا.
Dialogue: 0,0:39:57.93,0:39:59.73,Default,,0,0,0,,‫لكن هناك شيء غير صحيح…
Dialogue: 0,0:39:59.73,0:40:02.73,Default,,0,0,0,,‫الشخصية الرئيسية «هيديوشي» مفقودة.
Dialogue: 0,0:40:02.73,0:40:05.83,Default,,0,0,0,,‫صحيح. ظننتُ أنه معكم.
Dialogue: 0,0:40:05.83,0:40:08.63,Default,,0,0,0,,‫كان معي حتى قبل قليل،
Dialogue: 0,0:40:08.63,0:40:10.73,Default,,0,0,0,,‫لكن وصله اتصال على هاتفه المحمول
Dialogue: 0,0:40:10.73,0:40:13.03,Default,,0,0,0,,‫فانطلق إلى مكانٍ ما.
Dialogue: 0,0:40:13.03,0:40:15.13,Default,,0,0,0,,‫هل تعرف أين ذهب؟
Dialogue: 0,0:40:15.13,0:40:19.73,Default,,0,0,0,,‫لا… لكنه قال لنا أن نتغدّى بدونه.
Dialogue: 0,0:40:19.73,0:40:22.53,Default,,0,0,0,,‫إذًا لا بد أنه ذهب ليتغدّى وحده.
Dialogue: 0,0:40:23.13,0:40:25.03,Default,,0,0,0,,‫هيا، لا تشغل نفسك بهم.
Dialogue: 0,0:40:25.03,0:40:26.13,Default,,0,0,0,,‫إنهم غريبو الأطوار نوعًا ما.
Dialogue: 0,0:40:26.13,0:40:28.73,Default,,0,0,0,,‫لماذا لا نذهب ونتغدّى نحن أيضًا؟
Dialogue: 0,0:40:35.53,0:40:39.23,Default,,0,0,0,,‫أخيرًا! أخيرًا أستطيع أن أراه.
Dialogue: 0,0:40:39.23,0:40:41.33,Default,,0,0,0,,‫استسلمتُ قبل 13 سنة،
Dialogue: 0,0:40:41.33,0:40:45.73,Default,,0,0,0,,‫لكن هذا الكنز المتلألئ صار أخيرًا بين يديّ.
Dialogue: 0,0:40:45.73,0:40:52.13,Default,,0,0,0,,‫«التنين»
Dialogue: 0,0:40:56.73,0:40:58.13,Default,,0,0,0,,‫كيف يمكن أن تكون غبيًا إلى هذا الحد؟
Dialogue: 0,0:40:58.13,0:41:00.73,Default,,0,0,0,,‫علينا أن نعود إلى قلعة أوساكا مرة أخرى.
Dialogue: 0,0:41:00.73,0:41:02.93,Default,,0,0,0,,‫وفوق ذلك… كيف تُضيّع محفظتك
Dialogue: 0,0:41:02.93,0:41:04.23,Default,,0,0,0,,‫وأنت وضعتها في حقيبتك؟
Dialogue: 0,0:41:04.23,0:41:06.63,Default,,0,0,0,,‫كنتَ تكرر «أسرع، أسرع»،
Dialogue: 0,0:41:06.63,0:41:08.83,Default,,0,0,0,,‫فلا بد أنني تركتها في مكانٍ ما.
Dialogue: 0,0:41:08.83,0:41:10.93,Default,,0,0,0,,‫كم كان فيها؟
Dialogue: 0,0:41:10.93,0:41:12.33,Default,,0,0,0,,‫خمسة آلاف ين.
Dialogue: 0,0:41:12.33,0:41:14.63,Default,,0,0,0,,‫إذًا انساها. ثم إن الظلام بدأ يحلّ.
Dialogue: 0,0:41:14.63,0:41:18.03,Default,,0,0,0,,‫لا! محفظتي فيها تعويذتي المفضّلة!
Dialogue: 0,0:41:18.03,0:41:20.33,Default,,0,0,0,,‫لا يستحق الأمر أن تبكي عليه!
Dialogue: 0,0:41:20.33,0:41:22.23,Default,,0,0,0,,‫أنا لا أبكي.
Dialogue: 0,0:41:23.83,0:41:25.23,Default,,0,0,0,,‫إنها تمطر.
Dialogue: 0,0:41:25.23,0:41:28.23,Default,,0,0,0,,‫ولا يبدو أنها ستتوقف قريبًا.
Dialogue: 0,0:41:28.23,0:41:30.73,Default,,0,0,0,,‫تفضّل، لدي مظلة.
Dialogue: 0,0:41:34.43,0:41:37.93,Default,,0,0,0,,‫-هذا سيئ جدًا. -ماذا سنفعل؟
Dialogue: 0,0:41:37.93,0:41:42.53,Default,,0,0,0,,‫هيه… ربما تركتَ محفظتك في ذلك المتجر.
Dialogue: 0,0:41:42.53,0:41:46.53,Default,,0,0,0,,‫أتذكر؟ يا كازوها، اشتريتِ كاميرا للاستخدام مرة واحدة من هناك.
Dialogue: 0,0:41:46.53,0:41:48.13,Default,,0,0,0,,‫أظنك محقًا.
Dialogue: 0,0:41:48.13,0:41:51.03,Default,,0,0,0,,‫حسنًا إذًا، سنذهب ونسأل.
Dialogue: 0,0:41:52.53,0:41:54.13,Default,,0,0,0,,‫يا للهول.
Dialogue: 0,0:41:55.03,0:41:58.13,Default,,0,0,0,,‫أظن أننا يجب أن نبحث هناك.
Dialogue: 0,0:41:58.13,0:42:00.03,Default,,0,0,0,,‫لقد فعلنا ذلك بالفعل.
Dialogue: 0,0:42:00.03,0:42:02.23,Default,,0,0,0,,‫هل هناك مشكلة؟
Dialogue: 0,0:42:02.23,0:42:06.63,Default,,0,0,0,,‫نعم. لا نستطيع العثور على صديقنا الذي يلعب دور «هيديوشي».
Dialogue: 0,0:42:06.63,0:42:08.63,Default,,0,0,0,,‫بحثنا عنه في قلعة أوساكا والمتاجر حول هنا،
Dialogue: 0,0:42:08.63,0:42:10.93,Default,,0,0,0,,‫حتى في دورات المياه...
Dialogue: 0,0:42:10.93,0:42:12.93,Default,,0,0,0,,‫ولا أثر له.
Dialogue: 0,0:42:12.93,0:42:14.93,Default,,0,0,0,,‫ترى إلى أين يمكن أن يكون قد ذهب؟
Dialogue: 0,0:42:17.43,0:42:18.63,Default,,0,0,0,,‫ما ذلك؟
Dialogue: 0,0:42:18.63,0:42:20.33,Default,,0,0,0,,‫انظروا! ما هذا؟
Dialogue: 0,0:42:24.33,0:42:26.33,Default,,0,0,0,,‫هناك شخص يحترق!
Dialogue: 0,0:42:40.63,0:42:42.43,Default,,0,0,0,,‫يا سيد موري، اتصل بالإسعاف!
Dialogue: 0,0:42:42.43,0:42:44.03,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:42:44.03,0:42:46.93,Default,,0,0,0,,‫هيه، هل تسمعني؟ ماذا حدث لك؟
Dialogue: 0,0:42:50.73,0:42:51.93,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:42:59.43,0:43:02.23,Default,,0,0,0,,‫هيه، تمسّك! هل تسمعني؟
Dialogue: 0,0:43:08.24,0:43:11.64,Default,,0,0,0,,‫نعم! هذا هو! هذه محفظتي!
Dialogue: 0,0:43:11.64,0:43:13.04,Default,,0,0,0,,‫أنت محظوظ جدًا.
Dialogue: 0,0:43:13.04,0:43:15.74,Default,,0,0,0,,‫توقعت أنك قد تعود بسرعة،
Dialogue: 0,0:43:15.74,0:43:18.74,Default,,0,0,0,,‫فاحتفظت بها هنا بدلًا من تسليمها للشرطة.
Dialogue: 0,0:43:18.74,0:43:20.54,Default,,0,0,0,,‫إنها محفظة ثمينة جدًا، أليس كذلك؟
Dialogue: 0,0:43:20.54,0:43:22.44,Default,,0,0,0,,‫كانت مليئة بالتعاويذ.
Dialogue: 0,0:43:22.44,0:43:24.64,Default,,0,0,0,,‫بالتأكيد! شكرًا جزيلًا لكِ سيدتي!
Dialogue: 0,0:43:24.64,0:43:27.84,Default,,0,0,0,,‫أتقصد أن لديك أكثر من تعويذة واحدة في المحفظة؟
Dialogue: 0,0:43:27.84,0:43:30.24,Default,,0,0,0,,‫اشتريتُ أيضًا حرزًا لطرد الشر.
Dialogue: 0,0:43:30.24,0:43:31.94,Default,,0,0,0,,‫حتى لا نتورط في قضية أخرى
Dialogue: 0,0:43:31.94,0:43:34.84,Default,,0,0,0,,‫وتفسد زيارتكم لأوساكا مثل المرة الماضية.
Dialogue: 0,0:43:34.84,0:43:35.94,Default,,0,0,0,,‫يا لها من لفتة لطيفة!
Dialogue: 0,0:43:35.94,0:43:39.64,Default,,0,0,0,,‫ماذا؟ رجلٌ مشتعل سقط من البرج؟
Dialogue: 0,0:43:39.64,0:43:40.74,Default,,0,0,0,,‫أأنت متأكد من ذلك؟
Dialogue: 0,0:43:40.74,0:43:44.54,Default,,0,0,0,,‫نعم. الشرطة هناك وكل شيء في فوضى!
Dialogue: 0,0:43:48.04,0:43:49.64,Default,,0,0,0,,‫لم ينجح… ولا واحدٌ منها.
Dialogue: 0,0:43:49.64,0:43:50.64,Default,,0,0,0,,‫يبدو ذلك.
Dialogue: 0,0:43:54.64,0:43:57.94,Default,,0,0,0,,‫أيها المفتش أوتاكي… تبدو مشغولًا جدًا.
Dialogue: 0,0:43:57.94,0:44:00.54,Default,,0,0,0,,‫جريمتا قتل في يومين متتاليين.
Dialogue: 0,0:44:00.54,0:44:02.74,Default,,0,0,0,,‫حسنًا… هذا عملي.
Dialogue: 0,0:44:02.74,0:44:04.84,Default,,0,0,0,,‫لكنه أمر مدهش.
Dialogue: 0,0:44:04.84,0:44:08.04,Default,,0,0,0,,‫كيف عرفت أن اسم الضحية «يوجي كاتو»؟
Dialogue: 0,0:44:08.04,0:44:09.74,Default,,0,0,0,,‫قرأتُ اسمه على شارتِه.
Dialogue: 0,0:44:09.74,0:44:11.24,Default,,0,0,0,,‫على شارتِه؟
Dialogue: 0,0:44:11.24,0:44:13.54,Default,,0,0,0,,‫تقصد الشعار على صدره؟
Dialogue: 0,0:44:13.54,0:44:16.34,Default,,0,0,0,,‫هذا شعار هيديوشي… بولونيا «غوشيتشي».
Dialogue: 0,0:44:16.34,0:44:18.84,Default,,0,0,0,,‫بمجرد أن رأيته،
Dialogue: 0,0:44:18.84,0:44:21.24,Default,,0,0,0,,‫عرفتُ أنه الشخص الذي يلعب دور هيديوشي في مجموعتهم،
Dialogue: 0,0:44:21.24,0:44:23.04,Default,,0,0,0,,‫فطلبتُ منهم القدوم لتأكيد هوية الجثة.
Dialogue: 0,0:44:23.04,0:44:26.04,Default,,0,0,0,,‫ماذا تقصد بدور هيديوشي؟
Dialogue: 0,0:44:26.04,0:44:27.94,Default,,0,0,0,,‫كجزء من ترفيه الجولة،
Dialogue: 0,0:44:27.94,0:44:29.44,Default,,0,0,0,,‫نجعل كل عضو يؤدي دور
Dialogue: 0,0:44:29.44,0:44:32.24,Default,,0,0,0,,‫شخصية مشهورة من عصر الولايات المتحاربة،
Dialogue: 0,0:44:32.24,0:44:35.14,Default,,0,0,0,,‫ولدينا أيضًا لعبة عقوبات.
Dialogue: 0,0:44:35.14,0:44:39.24,Default,,0,0,0,,‫مثلًا… أنا ميتسوهيده، وكاسويا هو إيئه-ياسو.
Dialogue: 0,0:44:39.24,0:44:43.14,Default,,0,0,0,,‫واكيساكا هو نوبوناغا، وكاتاغيري هي نيني.
Dialogue: 0,0:44:43.14,0:44:47.04,Default,,0,0,0,,‫وكاتو هناك كان هيديوشي.
Dialogue: 0,0:44:47.04,0:44:50.04,Default,,0,0,0,,‫أفهم… يبدو ذلك ممتعًا جدًا.
Dialogue: 0,0:44:50.04,0:44:52.84,Default,,0,0,0,,‫لكنني لا أفهم كيف يمكن أن تفقدوا أثر
Dialogue: 0,0:44:52.84,0:44:54.64,Default,,0,0,0,,‫أحد أعضاء الجولة وينتهي به الأمر هكذا.
Dialogue: 0,0:44:54.64,0:44:55.94,Default,,0,0,0,,‫حسنًا…
Dialogue: 0,0:44:55.94,0:44:57.24,Default,,0,0,0,,‫لقد اختفى فجأةً
Dialogue: 0,0:44:57.24,0:44:59.64,Default,,0,0,0,,‫وكنا نبحث عنه طوال هذا الوقت.
Dialogue: 0,0:44:59.64,0:45:02.14,Default,,0,0,0,,‫وكان يرتدي لباس «فليس» لافتًا،
Dialogue: 0,0:45:02.14,0:45:04.54,Default,,0,0,0,,‫فحسبنا أننا سنراه فورًا.
Dialogue: 0,0:45:04.54,0:45:09.74,Default,,0,0,0,,‫من كان يتوقع أن يسقط من هناك وهو كرة من النار؟
Dialogue: 0,0:45:09.74,0:45:12.44,Default,,0,0,0,,‫بالمناسبة… هل تستطيع أن تتخيل سببًا
Dialogue: 0,0:45:12.44,0:45:14.04,Default,,0,0,0,,‫يدفع السيد كاتو للانتحار؟
Dialogue: 0,0:45:14.04,0:45:15.84,Default,,0,0,0,,‫لا… لا أملك أدنى فكرة.
Dialogue: 0,0:45:15.84,0:45:18.64,Default,,0,0,0,,‫وكيف عرفتَ أنه انتحار؟
Dialogue: 0,0:45:18.64,0:45:20.74,Default,,0,0,0,,‫أولًا… المطر غزير جدًا.
Dialogue: 0,0:45:20.74,0:45:22.84,Default,,0,0,0,,‫لا أحد سيخرج إلى السطح في هذا الطقس.
Dialogue: 0,0:45:22.84,0:45:25.34,Default,,0,0,0,,‫ثم إنه كان يرتدي ملابس من الفليس،
Dialogue: 0,0:45:25.34,0:45:26.84,Default,,0,0,0,,‫وهي شديدة الاشتعال.
Dialogue: 0,0:45:26.84,0:45:28.74,Default,,0,0,0,,‫وهذا يثبت أنه صعد إلى السطح بنفسه
Dialogue: 0,0:45:28.74,0:45:31.14,Default,,0,0,0,,‫وأشعل النار في نفسه.
Dialogue: 0,0:45:31.14,0:45:34.34,Default,,0,0,0,,‫لكنكم تصادفون جرائم قتل كثيرًا، أليس كذلك؟
Dialogue: 0,0:45:34.34,0:45:37.14,Default,,0,0,0,,‫ربما أنتم ملعونون أو شيء من هذا القبيل؟
Dialogue: 0,0:45:37.14,0:45:38.24,Default,,0,0,0,,‫ليس حقًا.
Dialogue: 0,0:45:38.24,0:45:41.94,Default,,0,0,0,,‫ابن قائد الشرطة يصادفها أكثر.
Dialogue: 0,0:45:41.94,0:45:45.64,Default,,0,0,0,,‫ماذا؟ هل هيجي هنا أيضًا؟
Dialogue: 0,0:45:45.64,0:45:50.24,Default,,0,0,0,,‫نعم. هو وكونان دخلا القلعة قبل قليل.
Dialogue: 0,0:45:52.24,0:45:53.24,Default,,0,0,0,,‫هيه يا كودو…
Dialogue: 0,0:45:53.24,0:45:55.44,Default,,0,0,0,,‫انتبه، فالطريق زلق هناك بسبب المطر.
Dialogue: 0,0:45:55.44,0:45:59.04,Default,,0,0,0,,‫يا للإحراج… أشعر وكأنني قردٌ مُدرَّب.
Dialogue: 0,0:46:03.94,0:46:06.04,Default,,0,0,0,,‫هل وجدت شيئًا؟
Dialogue: 0,0:46:06.04,0:46:09.04,Default,,0,0,0,,‫هناك الكثير من الشظايا الصغيرة جدًا لشيءٍ ما هنا.
Dialogue: 0,0:46:12.84,0:46:14.14,Default,,0,0,0,,‫إنها ولاعة.
Dialogue: 0,0:46:15.64,0:46:17.74,Default,,0,0,0,,‫هل يمكن أن تكون هذه هي الولاعة التي استخدمها؟
Dialogue: 0,0:46:19.04,0:46:21.44,Default,,0,0,0,,‫لكن الأمر لا يبدو منطقيًا… لماذا هي هنا؟
Dialogue: 0,0:46:24.24,0:46:26.14,Default,,0,0,0,,‫ما هذه العلامة؟
Dialogue: 0,0:46:28.04,0:46:29.74,Default,,0,0,0,,‫لا أصدق ذلك.
Dialogue: 0,0:46:29.74,0:46:32.14,Default,,0,0,0,,‫لماذا قد ينتحر كاتو؟
Dialogue: 0,0:46:32.14,0:46:34.14,Default,,0,0,0,,‫ولا أنا أصدق ذلك.
Dialogue: 0,0:46:34.14,0:46:37.54,Default,,0,0,0,,‫كان متحمسًا جدًا للقدوم إلى أوساكا.
Dialogue: 0,0:46:37.54,0:46:42.24,Default,,0,0,0,,‫يبدو أننا لا نعرف أبدًا ما الذي يفكر فيه الناس حقًا.
Dialogue: 0,0:46:42.24,0:46:44.84,Default,,0,0,0,,‫ربما كان يخطط منذ البداية
Dialogue: 0,0:46:44.84,0:46:48.64,Default,,0,0,0,,‫للانتحار هنا… في أرض هيديوشي تويوتومي.
Dialogue: 0,0:46:48.64,0:46:50.84,Default,,0,0,0,,‫كل ما علينا فعله هو العثور على ما استخدمه لإشعال نفسه.
Dialogue: 0,0:46:50.84,0:46:52.94,Default,,0,0,0,,‫صحيح… هذا كل ما نحتاج لإيجاده.
Dialogue: 0,0:46:52.94,0:46:55.44,Default,,0,0,0,,‫وجدناه!
Dialogue: 0,0:46:55.44,0:46:58.94,Default,,0,0,0,,‫كان على سطح البرج… إنها ولاعة.
Dialogue: 0,0:46:58.94,0:47:02.54,Default,,0,0,0,,‫أليست هذه هي الولاعة التي كانت مع كاتو؟
Dialogue: 0,0:47:02.54,0:47:03.64,Default,,0,0,0,,‫نعم… أظن أنها هي.
Dialogue: 0,0:47:03.64,0:47:05.84,Default,,0,0,0,,‫إذًا انتهى الأمر! كان انتحارًا!
Dialogue: 0,0:47:05.84,0:47:07.54,Default,,0,0,0,,‫لا أظن أن الأمر بهذه البساطة.
Dialogue: 0,0:47:07.54,0:47:08.54,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:47:08.54,0:47:11.04,Default,,0,0,0,,‫غطاء هذه الولاعة كان مغلقًا.
Dialogue: 0,0:47:11.04,0:47:12.54,Default,,0,0,0,,‫هل تظن أن شخصًا ينتحر
Dialogue: 0,0:47:12.54,0:47:14.44,Default,,0,0,0,,‫سيأخذ وقتًا ليغلق الغطاء؟
Dialogue: 0,0:47:14.44,0:47:19.34,Default,,0,0,0,,‫لكن يا هيجي… ربما أُغلق الغطاء عندما سقطت من يده.
Dialogue: 0,0:47:19.34,0:47:20.44,Default,,0,0,0,,‫لو كان الأمر كذلك،
Dialogue: 0,0:47:20.44,0:47:23.54,Default,,0,0,0,,‫لكنا وجدناها أسفل على السطح.
Dialogue: 0,0:47:23.54,0:47:25.64,Default,,0,0,0,,‫وفوق ذلك… بدا كأن شيئًا آخر كان هنا
Dialogue: 0,0:47:25.64,0:47:28.24,Default,,0,0,0,,‫قبل أن توضع الولاعة في مكانها.
Dialogue: 0,0:47:28.24,0:47:30.14,Default,,0,0,0,,‫ماذا تقصد… شيء آخر؟
Dialogue: 0,0:47:30.14,0:47:32.24,Default,,0,0,0,,‫عندما وجدنا الولاعة،
Dialogue: 0,0:47:32.24,0:47:35.44,Default,,0,0,0,,‫كان تحتها موضع جاف بشكلٍ غريب.
Dialogue: 0,0:47:35.44,0:47:37.64,Default,,0,0,0,,‫لم يكن مستطيلاً مثل الولاعة،
Dialogue: 0,0:47:37.64,0:47:39.64,Default,,0,0,0,,‫بل كان على شكل مروحة جميلة.
Dialogue: 0,0:47:40.94,0:47:43.64,Default,,0,0,0,,‫أنا متأكد أن شيئًا دائريًا وُضع هناك
Dialogue: 0,0:47:43.64,0:47:46.14,Default,,0,0,0,,‫قبل أن يبدأ المطر.
Dialogue: 0,0:45:47.44,0:47:51.14,Default,,0,0,0,,‫استُبدل ذلك الشيء الدائري بالولاعة.
Dialogue: 0,0:47:51.14,0:47:53.24,Default,,0,0,0,,‫-أليس كذلك يا فتى؟ -نعم.
Dialogue: 0,0:47:53.24,0:47:57.54,Default,,0,0,0,,‫لكن يا هيجي… ما الذي تظنه ذلك الشيء الدائري؟
Dialogue: 0,0:47:57.54,0:47:59.54,Default,,0,0,0,,‫لا أدري… لم أصل لذلك بعد.
Dialogue: 0,0:47:59.54,0:48:01.54,Default,,0,0,0,,‫لكنني أظن أنه مرتبط
Dialogue: 0,0:48:01.54,0:48:03.84,Default,,0,0,0,,‫بالشظايا الصغيرة المنتشرة في كل مكان.
Dialogue: 0,0:48:03.84,0:48:05.14,Default,,0,0,0,,‫أيها المفتش أوتاكي.
Dialogue: 0,0:48:05.14,0:48:07.84,Default,,0,0,0,,‫لقد رتبنا جميع مقتنيات الضحية الشخصية.
Dialogue: 0,0:48:10.54,0:48:13.04,Default,,0,0,0,,‫محفظة، ساعة، هاتف محمول،
Dialogue: 0,0:48:13.04,0:48:16.04,Default,,0,0,0,,‫مفاتيح، سجائر… وقطعة من شيء ما.
Dialogue: 0,0:48:16.04,0:48:18.24,Default,,0,0,0,,‫هاه؟ لفافة.
Dialogue: 0,0:48:20.24,0:48:21.74,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:48:21.74,0:48:24.44,Default,,0,0,0,,‫مكتوب عليها فقط كلمة «التنين».
Dialogue: 0,0:48:26.44,0:48:28.44,Default,,0,0,0,,‫وهذه القطعة… من ماذا هي؟
Dialogue: 0,0:48:28.44,0:48:30.64,Default,,0,0,0,,‫تبدو كقطعة فخار.
Dialogue: 0,0:48:30.64,0:48:33.24,Default,,0,0,0,,‫هاه؟ تلك القطعة...
Dialogue: 0,0:48:33.24,0:48:35.54,Default,,0,0,0,,‫أليس من الممكن أن تكون مثل القطع
Dialogue: 0,0:48:35.54,0:48:38.54,Default,,0,0,0,,‫التي وُجدت مع الجثث المحترقة الأخرى؟
Dialogue: 0,0:48:38.54,0:48:44.04,Default,,0,0,0,,‫أبي ووالدك كانا يتحدثان عن هذا في السيارة ليلة أمس.
Dialogue: 0,0:48:44.04,0:48:47.14,Default,,0,0,0,,‫واحدة وُجدت في الخندق الداخلي قبل 13 سنة،
Dialogue: 0,0:48:47.14,0:48:49.84,Default,,0,0,0,,‫وأخرى وُجدت مؤخرًا في الخندق الخارجي.
Dialogue: 0,0:48:49.84,0:48:52.14,Default,,0,0,0,,‫وكان لدى الضحيتين قطع فخار تبدو متشابهة.
Dialogue: 0,0:48:52.14,0:48:53.84,Default,,0,0,0,,‫وسمعتُهما يقولان إن
Dialogue: 0,0:48:53.84,0:48:58.34,Default,,0,0,0,,‫القطعة التي وُجدت مؤخرًا كان مكتوبًا عليها «848».
Dialogue: 0,0:48:58.34,0:49:01.44,Default,,0,0,0,,‫848؟ ماذا يعني ذلك؟
Dialogue: 0,0:49:01.44,0:49:04.54,Default,,0,0,0,,‫لم يكن أحد متأكدًا،
Dialogue: 0,0:49:04.54,0:49:07.04,Default,,0,0,0,,‫لكن يبدو أن تلك القطع جزء من كنزٍ ما.
Dialogue: 0,0:49:07.04,0:49:08.64,Default,,0,0,0,,‫كنز؟
Dialogue: 0,0:49:08.64,0:49:09.94,Default,,0,0,0,,‫أنا لا أختلق هذا!
Dialogue: 0,0:49:09.94,0:49:12.14,Default,,0,0,0,,‫كانا يهمسان وكأنه سر!
Dialogue: 0,0:49:12.14,0:49:15.74,Default,,0,0,0,,‫قالا شيئًا عن ثروة هائلة تركها رجل عظيم.
Dialogue: 0,0:49:15.74,0:49:17.94,Default,,0,0,0,,‫قلتِ ثروة هائلة؟
Dialogue: 0,0:49:17.94,0:49:21.34,Default,,0,0,0,,‫هل أنتِ متأكدة أنكِ لا تختلقين هذا كله؟
Dialogue: 0,0:49:21.34,0:49:23.64,Default,,0,0,0,,‫هيه يا هاتّوري…
Dialogue: 0,0:49:23.64,0:49:26.64,Default,,0,0,0,,‫انظر إلى قطعة الفخار هذه.
Dialogue: 0,0:49:26.64,0:49:30.84,Default,,0,0,0,,‫هناك شيء لامع عالق في داخلها.
Dialogue: 0,0:49:30.84,0:49:32.94,Default,,0,0,0,,‫هيه… أليس هذا ذهبًا؟
Dialogue: 0,0:49:32.94,0:49:34.84,Default,,0,0,0,,‫أظن ذلك… لكنه قليل جدًا،
Dialogue: 0,0:49:34.84,0:49:37.44,Default,,0,0,0,,‫فلا أعتقد أنه «كنز» كبير.
Dialogue: 0,0:49:37.44,0:49:40.74,Default,,0,0,0,,‫يا إلهي… أنا لا أفهم هذه القضية.
Dialogue: 0,0:49:40.74,0:49:43.44,Default,,0,0,0,,‫من الغريب أصلًا أن السيد كاتو ترك الجولة
Dialogue: 0,0:49:43.44,0:49:46.44,Default,,0,0,0,,‫وصعد إلى السطح،
Dialogue: 0,0:49:46.44,0:49:49.04,Default,,0,0,0,,‫لكن الأصعب تفسيرًا هو لماذا اشتعل فجأة!
Dialogue: 0,0:49:49.04,0:49:51.14,Default,,0,0,0,,‫وأكبر سؤال...
Dialogue: 0,0:49:51.14,0:49:53.74,Default,,0,0,0,,‫لماذا أمسك السيد كاتو بالمظلة...
Dialogue: 0,0:49:56.14,0:49:57.64,Default,,0,0,0,,‫قبل أن يموت مباشرة.
Dialogue: 0,0:49:57.64,0:50:00.84,Default,,0,0,0,,‫كلمة «مظلة» قد تشير إلى المطر.
Dialogue: 0,0:50:00.84,0:50:02.34,Default,,0,0,0,,‫والمطر يذكّرني بـ
Dialogue: 0,0:50:02.34,0:50:05.64,Default,,0,0,0,,‫صخرة «ريوكو» هنا في قلعة أوساكا.
Dialogue: 0,0:50:05.64,0:50:06.94,Default,,0,0,0,,‫وما هي؟
Dialogue: 0,0:50:06.94,0:50:08.54,Default,,0,0,0,,‫أتعني أنك لا تعرف؟
Dialogue: 0,0:50:08.54,0:50:10.44,Default,,0,0,0,,‫هنا في قلعة أوساكا،
Dialogue: 0,0:50:10.44,0:50:13.54,Default,,0,0,0,,‫تقف على جانبي بوابة «ساكورا» لتحمي البرج،
Dialogue: 0,0:50:13.54,0:50:16.94,Default,,0,0,0,,‫صخرتان تُسمَّيان «صخرتي ريوكو».
Dialogue: 0,0:50:16.94,0:50:18.14,Default,,0,0,0,,‫وهكذا سُمّيتا منذ زمن بعيد،
Dialogue: 0,0:50:18.14,0:50:20.04,Default,,0,0,0,,‫لأنه يُقال إنه عندما تمطر،
Dialogue: 0,0:50:20.04,0:50:22.74,Default,,0,0,0,,‫تظهر عليهما هيئة تنينٍ ونمر.
Dialogue: 0,0:50:22.74,0:50:24.24,Default,,0,0,0,,‫مطر…
Dialogue: 0,0:50:26.04,0:50:27.44,Default,,0,0,0,,‫أعرني هذا قليلًا!
Dialogue: 0,0:50:28.04,0:50:30.84,Default,,0,0,0,,‫-ما الذي يحدث؟ -هذا دليل!
Dialogue: 0,0:50:41.04,0:50:43.54,Default,,0,0,0,,‫قد تكون قصتها صحيحة فعلًا.
Dialogue: 0,0:50:43.54,0:50:44.54,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:50:44.54,0:50:48.04,Default,,0,0,0,,‫وما زالت هناك إمكانية أنه مخبأ في مكانٍ ما.
Dialogue: 0,0:50:48.04,0:50:51.54,Default,,0,0,0,,‫كنز هيديوشي… الرجل الملقّب بـ «سيد الذهب»...
Dialogue: 0,0:50:51.54,0:50:54.44,Default,,0,0,0,,‫إنه في مكانٍ ما داخل قلعة أوساكا.
Dialogue: 0,0:50:54.44,0:50:58.94,Default,,0,0,0,,‫وهذا يعني أن كنز هيديوشي...
Dialogue: 0,0:51:01.84,0:51:03.34,Default,,0,0,0,,‫نعم، أنا.
Dialogue: 0,0:51:03.34,0:51:05.64,Default,,0,0,0,,‫لا تتحرك بعد.
Dialogue: 0,0:51:05.64,0:51:08.34,Default,,0,0,0,,‫لا يبدو أن الشرطة ستغادر قريبًا.
Dialogue: 0,0:51:08.34,0:51:09.74,Default,,0,0,0,,‫لا تقلق بشأن ذلك.
Dialogue: 0,0:51:09.74,0:51:11.94,Default,,0,0,0,,‫الشيء الذي نريده أمامي مباشرة.
Dialogue: 0,0:51:11.94,0:51:14.14,Default,,0,0,0,,‫تأكد أن كل شيء جاهز.
Dialogue: 0,0:51:29.42,0:51:34.22,Default,,0,0,0,,‫ماذا؟ أنت تعرف ما هو الكنز الذي تركه هيديوشي؟
Dialogue: 0,0:51:34.22,0:51:35.82,Default,,0,0,0,,‫هل أنت متأكد؟
Dialogue: 0,0:51:35.82,0:51:37.82,Default,,0,0,0,,‫نعم، أنا شبه متأكد.
Dialogue: 0,0:51:37.82,0:51:42.22,Default,,0,0,0,,‫والدليل هو قطعة الفخار التي كانت مع السيد كاتو.
Dialogue: 0,0:51:42.22,0:51:43.22,Default,,0,0,0,,‫انظروا إليها جيدًا.
Dialogue: 0,0:51:43.22,0:51:45.52,Default,,0,0,0,,‫هناك القليل هنا وهناك،
Dialogue: 0,0:51:45.52,0:51:47.62,Default,,0,0,0,,‫لكن يمكنكم رؤية ذهبٍ عالق في الداخل.
Dialogue: 0,0:51:47.62,0:51:49.02,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:51:49.02,0:51:50.72,Default,,0,0,0,,‫لكن كيف عرفت أن هناك كنزًا كبيرًا
Dialogue: 0,0:51:50.72,0:51:52.62,Default,,0,0,0,,‫فقط من هذه القطعة؟
Dialogue: 0,0:51:52.62,0:51:55.72,Default,,0,0,0,,‫الآن ضعوها مع هذه اللفافة التي كانت مع السيد كاتو
Dialogue: 0,0:51:55.72,0:51:56.82,Default,,0,0,0,,‫وانظروا مرة أخرى بتأنٍّ.
Dialogue: 0,0:51:56.82,0:51:59.32,Default,,0,0,0,,‫لكن هذه اللفافة لا يوجد عليها إلا كلمة «تنين»
Dialogue: 0,0:51:59.32,0:52:02.52,Default,,0,0,0,,‫مكتوبة في الزاوية العليا اليمنى.
Dialogue: 0,0:52:02.52,0:52:04.32,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:52:04.32,0:52:05.52,Default,,0,0,0,,‫لقد لُصقت عدة أوراق
Dialogue: 0,0:52:05.52,0:52:08.92,Default,,0,0,0,,‫فوق الكلمة التي كانت مكتوبة هنا.
Dialogue: 0,0:52:08.92,0:52:11.22,Default,,0,0,0,,‫تمامًا مثل صخرتي ريوكو في قلعة أوساكا،
Dialogue: 0,0:52:11.22,0:52:14.72,Default,,0,0,0,,‫عندما تُبلّل الورق تظهر الكلمة التي تحتها.
Dialogue: 0,0:52:14.72,0:52:17.62,Default,,0,0,0,,‫لكن معظم الكلمات احترقت،
Dialogue: 0,0:52:17.62,0:52:18.82,Default,,0,0,0,,‫ولا يمكنك قراءتها.
Dialogue: 0,0:52:18.82,0:52:21.72,Default,,0,0,0,,‫وماذا عن هذا؟ ما هذا الرسم على اليسار؟
Dialogue: 0,0:52:21.72,0:52:23.72,Default,,0,0,0,,‫أليست هذه قرعة؟
Dialogue: 0,0:52:23.72,0:52:26.72,Default,,0,0,0,,‫القرعة هي الرمز على راية هيديوشي… شِعاره الحربي.
Dialogue: 0,0:52:26.72,0:52:28.82,Default,,0,0,0,,‫-ماذا؟ -إذًا… هل يعني هذا
Dialogue: 0,0:52:28.82,0:52:32.62,Default,,0,0,0,,‫أن هذه القطعة قد تكون من فخارٍ على شكل قرعة؟
Dialogue: 0,0:52:32.62,0:52:36.02,Default,,0,0,0,,‫وأنها كانت ممتلئة بالذهب؟
Dialogue: 0,0:52:36.02,0:52:38.92,Default,,0,0,0,,‫لكن بحسب هذا المخطط،
Dialogue: 0,0:52:38.92,0:52:40.12,Default,,0,0,0,,‫كان ارتفاعها نحو «شاكّ» واحد،
Dialogue: 0,0:52:40.12,0:52:43.12,Default,,0,0,0,,‫أي حوالي 30 سنتيمترًا فقط.
Dialogue: 0,0:52:43.12,0:52:44.62,Default,,0,0,0,,‫مهما حشوتَ فيها من مال،
Dialogue: 0,0:52:44.62,0:52:47.02,Default,,0,0,0,,‫فهي صغيرة ولن تساوي الكثير.
Dialogue: 0,0:52:47.02,0:52:49.82,Default,,0,0,0,,‫هل نسيت؟
Dialogue: 0,0:52:49.82,0:52:52.92,Default,,0,0,0,,‫يُقال إن الجنرال هيديوشي كلما انتصر في معركة،
Dialogue: 0,0:52:52.92,0:52:56.12,Default,,0,0,0,,‫أضاف «قرعة» صغيرة،
Dialogue: 0,0:52:56.12,0:52:57.92,Default,,0,0,0,,‫وهكذا تكوَّن شِعاره الذهبي.
Dialogue: 0,0:52:58.82,0:53:01.12,Default,,0,0,0,,‫قِرَع الزجاجة!
Dialogue: 0,0:53:01.12,0:53:03.02,Default,,0,0,0,,‫تعني قِرَع الزجاجة؟
Dialogue: 0,0:53:03.02,0:53:04.52,Default,,0,0,0,,‫لا تقل إن...
Dialogue: 0,0:53:04.52,0:53:07.32,Default,,0,0,0,,‫بالضبط. لو وُجد ألفٌ من الشيء نفسه،
Dialogue: 0,0:53:07.32,0:53:09.12,Default,,0,0,0,,‫فهذا سيكون كنزًا بالفعل!
Dialogue: 0,0:53:09.12,0:53:10.52,Default,,0,0,0,,‫ولو أخذت تاريخها بعين الاعتبار،
Dialogue: 0,0:53:10.52,0:53:13.02,Default,,0,0,0,,‫فستكون بلا ثمن.
Dialogue: 0,0:53:13.02,0:53:15.92,Default,,0,0,0,,‫الجثة المحترقة قبل 13 سنة كانت معها قطعة،
Dialogue: 0,0:53:15.92,0:53:17.62,Default,,0,0,0,,‫وكذلك الجثة الأخرى التي وُجدت مؤخرًا،
Dialogue: 0,0:53:17.62,0:53:21.02,Default,,0,0,0,,‫والآن السيد كاتو… قد يعني هذا أن
Dialogue: 0,0:53:21.02,0:53:24.62,Default,,0,0,0,,‫ربما كانوا يطاردون الكنز،
Dialogue: 0,0:53:24.62,0:53:29.12,Default,,0,0,0,,‫لكنهم قُتلوا على يد شخصٍ أراد الاستئثار به لنفسه.
Dialogue: 0,0:53:30.22,0:53:32.02,Default,,0,0,0,,‫لكنني لا أفهم…
Dialogue: 0,0:53:32.02,0:53:35.62,Default,,0,0,0,,‫كيف عرف قائد الشرطة ووالدك
Dialogue: 0,0:53:35.62,0:53:38.52,Default,,0,0,0,,‫أنه كنزٌ هائل بمجرد النظر إلى القطعتين؟
Dialogue: 0,0:53:38.52,0:53:41.22,Default,,0,0,0,,‫لم يكونا قد رأيا اللفافة بعد.
Dialogue: 0,0:53:41.22,0:53:44.22,Default,,0,0,0,,‫ربما عرفا من شكل القطعة.
Dialogue: 0,0:53:44.22,0:53:46.92,Default,,0,0,0,,‫القطعة التي كان والدي ينظر إليها في السيارة
Dialogue: 0,0:53:46.92,0:53:49.32,Default,,0,0,0,,‫بدت كأنها من أعلى القرعة،
Dialogue: 0,0:53:49.32,0:53:52.92,Default,,0,0,0,,‫وقال إن الرقم «848» كان مكتوبًا عليها.
Dialogue: 0,0:53:52.92,0:53:58.82,Default,,0,0,0,,‫فهمت… 848 رقم بين 1 و1000.
Dialogue: 0,0:53:58.82,0:54:03.22,Default,,0,0,0,,‫إذا كانت القطعتان فيهما ذهب عالق من الداخل،
Dialogue: 0,0:54:03.22,0:54:06.22,Default,,0,0,0,,‫فقد تكون تلك النظرية صحيحة.
Dialogue: 0,0:54:06.22,0:54:09.02,Default,,0,0,0,,‫لكن هذا يبدو كحكاية خرافية.
Dialogue: 0,0:54:09.02,0:54:11.92,Default,,0,0,0,,‫لكنها ليست مستحيلة تمامًا.
Dialogue: 0,0:54:11.92,0:54:13.52,Default,,0,0,0,,‫يُقال إنه حتى بعد موت هيديوشي،
Dialogue: 0,0:54:13.52,0:54:15.22,Default,,0,0,0,,‫كان إيئه-ياسو يخشاه،
Dialogue: 0,0:54:15.22,0:54:19.42,Default,,0,0,0,,‫بسبب كل الذهب والفضة التي خزّنها في قلعة أوساكا.
Dialogue: 0,0:54:19.42,0:54:22.02,Default,,0,0,0,,‫وهناك أسطورة تقول إن هيديوشي عندما أراد
Dialogue: 0,0:54:22.02,0:54:24.62,Default,,0,0,0,,‫تنقية ماء البئر،
Dialogue: 0,0:54:24.62,0:54:27.02,Default,,0,0,0,,‫وضع كميةً هائلة من الذهب في «كينمي-سوي»
Dialogue: 0,0:54:27.02,0:54:28.02,Default,,0,0,0,,‫الموجودة مباشرة أمام البرج.
Dialogue: 0,0:54:28.02,0:54:29.52,Default,,0,0,0,,‫حتى لو كان ذلك صحيحًا،
Dialogue: 0,0:54:29.52,0:54:32.02,Default,,0,0,0,,‫فما الذي يجعلك تظن أن هذا يشير إلى كنزٍ مخبأ؟
Dialogue: 0,0:54:32.02,0:54:35.62,Default,,0,0,0,,‫قد تكون هذه اللفافة مجرد مخطط فحسب.
Dialogue: 0,0:54:35.62,0:54:37.72,Default,,0,0,0,,‫سخيف… إخفاء الذهب داخل الفخار
Dialogue: 0,0:54:37.72,0:54:40.62,Default,,0,0,0,,‫ولصق طبقات من الورق فوق اللفافة
Dialogue: 0,0:54:40.62,0:54:43.72,Default,,0,0,0,,‫هو الدليل على أن أحدهم تعمّد إخفاء شيء.
Dialogue: 0,0:54:43.72,0:54:46.02,Default,,0,0,0,,‫هذه اللفافة هي «فصل التنين».
Dialogue: 0,0:54:46.02,0:54:47.72,Default,,0,0,0,,‫وهذا يعني أن الأمر واضح جدًا...
Dialogue: 0,0:54:47.72,0:54:50.32,Default,,0,0,0,,‫بالنسبة لـ «النمر».
Dialogue: 0,0:54:50.32,0:54:53.72,Default,,0,0,0,,‫إذا كانت لفافة «التنين» مثل صخرة ريوكو،
Dialogue: 0,0:54:53.72,0:54:57.02,Default,,0,0,0,,‫وكان رسم القرعة يظهر عندما تبتل،
Dialogue: 0,0:54:57.02,0:54:59.92,Default,,0,0,0,,‫فلا بد أن هناك لفافة «نمر» في مكانٍ ما أيضًا.
Dialogue: 0,0:54:59.92,0:55:01.32,Default,,0,0,0,,‫وفوق ذلك،
Dialogue: 0,0:55:01.32,0:55:03.42,Default,,0,0,0,,‫هناك احتمال كبير أن تلك اللفافة ستُرينا
Dialogue: 0,0:55:03.42,0:55:05.12,Default,,0,0,0,,‫مكان إخفاء القِرَع.
Dialogue: 0,0:55:05.12,0:55:07.82,Default,,0,0,0,,‫أليس كذلك يا هيجي؟
Dialogue: 0,0:55:07.82,0:55:09.72,Default,,0,0,0,,‫السيد توياما!
Dialogue: 0,0:55:09.72,0:55:11.52,Default,,0,0,0,,‫ما الذي جاء بك إلى هنا؟
Dialogue: 0,0:55:11.52,0:55:13.32,Default,,0,0,0,,‫لقد اتصلتُ به.
Dialogue: 0,0:55:13.32,0:55:15.42,Default,,0,0,0,,‫مقر قيادة شرطة المحافظة قريب من هنا.
Dialogue: 0,0:55:15.42,0:55:16.42,Default,,0,0,0,,‫هاه؟
Dialogue: 0,0:55:16.42,0:55:19.82,Default,,0,0,0,,‫وبدا الأمر مرتبطًا بقضية كان والدي متورطًا فيها من قبل.
Dialogue: 0,0:55:19.82,0:55:20.82,Default,,0,0,0,,‫ثم لو لم أفعل شيئًا كهذا،
Dialogue: 0,0:55:20.82,0:55:24.12,Default,,0,0,0,,‫فلن تنتزع نفسك من هذا المكان أبدًا، أليس كذلك؟
Dialogue: 0,0:55:24.12,0:55:26.72,Default,,0,0,0,,‫ها هي تتدخل مرة أخرى.
Dialogue: 0,0:55:26.72,0:55:30.02,Default,,0,0,0,,‫كازوها محقّة. دعونا نتولى الأمر هنا.
Dialogue: 0,0:55:30.02,0:55:31.62,Default,,0,0,0,,‫نعم، اسمع كلامه.
Dialogue: 0,0:55:31.62,0:55:35.62,Default,,0,0,0,,‫أعرف مكانًا رائعًا باتجاه «شيمباشي» قرب قلعة أوساكا.
Dialogue: 0,0:55:35.62,0:55:37.52,Default,,0,0,0,,‫هيا نتعشى هناك!
Dialogue: 0,0:55:37.52,0:55:41.22,Default,,0,0,0,,‫اصمت! لقد مات شخص أمام أعيننا للتو!
Dialogue: 0,0:55:41.22,0:55:43.22,Default,,0,0,0,,‫كيف تستطيع أن تملأ بطنك...
Dialogue: 0,0:55:43.22,0:55:46.12,Default,,0,0,0,,‫أعني… أن تتعشى؟ لن يكون ذلك لائقًا، أليس كذلك؟
Dialogue: 0,0:55:46.12,0:55:48.42,Default,,0,0,0,,‫لذا… انسا أمري فقط
Dialogue: 0,0:55:48.42,0:55:52.32,Default,,0,0,0,,‫وتعشَّ مع ران. لن أمانع يا كازوها.
Dialogue: 0,0:55:53.12,0:55:54.82,Default,,0,0,0,,‫انساك إذًا!
Dialogue: 0,0:55:54.82,0:55:57.12,Default,,0,0,0,,‫هيا يا ران! سنذهب بدونهما!
Dialogue: 0,0:55:58.52,0:56:00.62,Default,,0,0,0,,‫انتظري يا كازوها!
Dialogue: 0,0:56:11.72,0:56:13.12,Default,,0,0,0,,‫هيا بنا!
Dialogue: 0,0:56:13.12,0:56:15.72,Default,,0,0,0,,‫إنه مطعم إيطالي لذيذ جدًا!
Dialogue: 0,0:56:15.72,0:56:20.12,Default,,0,0,0,,‫عفوًا… هل يمكننا أن نأكل شيئًا نحن أيضًا؟
Dialogue: 0,0:56:20.12,0:56:23.32,Default,,0,0,0,,‫لم نأكل شيئًا منذ الغداء.
Dialogue: 0,0:56:23.32,0:56:25.92,Default,,0,0,0,,‫ملابسي ابتلّت بالمطر،
Dialogue: 0,0:56:25.92,0:56:27.72,Default,,0,0,0,,‫لذا سأعود إلى الفندق أولًا لأبدّل.
Dialogue: 0,0:56:27.72,0:56:30.32,Default,,0,0,0,,‫-انتظر! -سنعود حالًا.
Dialogue: 0,0:56:30.32,0:56:32.82,Default,,0,0,0,,‫الفندق الذي نقيم فيه قريب.
Dialogue: 0,0:56:33.92,0:56:36.32,Default,,0,0,0,,‫حسنًا إذًا… لكن لا تتأخروا!
Dialogue: 0,0:56:39.62,0:56:42.52,Default,,0,0,0,,‫ذلك الصوت… أيمكن أن يكون…؟
Dialogue: 0,0:56:47.62,0:56:50.12,Default,,0,0,0,,‫-هيه يا أوتاكي. -نعم سيدي!
Dialogue: 0,0:56:50.12,0:56:51.42,Default,,0,0,0,,‫اسمع.
Dialogue: 0,0:56:53.72,0:56:57.12,Default,,0,0,0,,‫نعم سيدي. سأخبر رجالي فورًا.
Dialogue: 0,0:56:57.12,0:56:59.62,Default,,0,0,0,,‫-انتبه. -نعم سيدي!
Dialogue: 0,0:57:05.92,0:57:08.22,Default,,0,0,0,,‫هيزو… أنا.
Dialogue: 0,0:57:11.52,0:57:13.02,Default,,0,0,0,,‫فعلتِها لأجل هيجي، أليس كذلك؟
Dialogue: 0,0:57:13.02,0:57:15.32,Default,,0,0,0,,‫اتصلتِ بوالدك بهذه الطريقة.
Dialogue: 0,0:57:15.32,0:57:18.62,Default,,0,0,0,,‫كنتِ تعرفين أن والدك متورط بعمق في تلك القضية،
Dialogue: 0,0:57:18.62,0:57:21.12,Default,,0,0,0,,‫فقلتِ إنك لو استدعيتِه
Dialogue: 0,0:57:21.12,0:57:23.52,Default,,0,0,0,,‫فسيعطي هيجي كل المعلومات التي يتلهف لمعرفةها.
Dialogue: 0,0:57:23.52,0:57:25.72,Default,,0,0,0,,‫لكن لم تريدي أن يفهم ذلك،
Dialogue: 0,0:57:25.72,0:57:27.02,Default,,0,0,0,,‫لذا استخدمتِ ذلك الأسلوب معه.
Dialogue: 0,0:57:27.02,0:57:30.32,Default,,0,0,0,,‫وماذا لو فعلت؟ أنا أحب أن أرى ذلك.
Dialogue: 0,0:57:30.32,0:57:32.32,Default,,0,0,0,,‫أحب رؤية وجهه وهو يلمع
Dialogue: 0,0:57:32.32,0:57:34.82,Default,,0,0,0,,‫كلما حلّ قضية.
Dialogue: 0,0:57:34.82,0:57:36.92,Default,,0,0,0,,‫أنا حمقاء، أليس كذلك؟
Dialogue: 0,0:57:36.92,0:57:38.82,Default,,0,0,0,,‫نعم… حمقاء جدًا!
Dialogue: 0,0:57:38.82,0:57:41.42,Default,,0,0,0,,‫حمقاء جدًا؟
Dialogue: 0,0:57:41.42,0:57:43.32,Default,,0,0,0,,‫وأنا كذلك.
Dialogue: 0,0:57:46.22,0:57:47.62,Default,,0,0,0,,‫إنه أمر محبط جدًا،
Dialogue: 0,0:57:47.62,0:57:49.92,Default,,0,0,0,,‫لكن هناك شيئًا رائعًا في شينيتشي
Dialogue: 0,0:57:49.92,0:57:52.02,Default,,0,0,0,,‫عندما يكون هكذا.
Dialogue: 0,0:57:54.72,0:57:56.92,Default,,0,0,0,,‫لكن فقط عندما يكون هكذا.
Dialogue: 0,0:57:56.92,0:57:59.52,Default,,0,0,0,,‫أليس كذلك يا كونان؟ أنت توافق، أليس كذلك؟
Dialogue: 0,0:57:59.52,0:58:03.52,Default,,0,0,0,,‫أوه لا! نسيت أن آخذ كونان معي!
Dialogue: 0,0:58:03.52,0:58:05.22,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:58:10.02,0:58:12.02,Default,,0,0,0,,‫يا هاتّوري.
Dialogue: 0,0:58:12.02,0:58:13.12,Default,,0,0,0,,‫انظر إلى هذا.
Dialogue: 0,0:58:13.12,0:58:15.32,Default,,0,0,0,,‫وجدت شيئًا غريبًا في مكانٍ غريب.
Dialogue: 0,0:58:15.32,0:58:16.92,Default,,0,0,0,,‫بطارية؟
Dialogue: 0,0:58:16.92,0:58:18.22,Default,,0,0,0,,‫انتظر لحظة…
Dialogue: 0,0:58:18.22,0:58:21.42,Default,,0,0,0,,‫إن كانت هذه من حادثة احتراق السيد كاتو...
Dialogue: 0,0:58:21.42,0:58:24.42,Default,,0,0,0,,‫بالضبط. لم يكن انتحارًا.
Dialogue: 0,0:58:24.42,0:58:26.32,Default,,0,0,0,,‫كان جريمة قتل.
Dialogue: 0,0:58:27.82,0:58:29.72,Default,,0,0,0,,‫لا تقلق بشأنه.
Dialogue: 0,0:58:29.72,0:58:33.92,Default,,0,0,0,,‫هيجي ووالدك معه.
Dialogue: 0,0:58:33.92,0:58:37.62,Default,,0,0,0,,‫وفوق ذلك، هناك الكثير من الشرطة هنا.
Dialogue: 0,0:58:37.62,0:58:39.62,Default,,0,0,0,,‫لن يحدث شيء.
Dialogue: 0,0:59:18.16,0:59:22.96,Default,,0,0,0,,‫اسم الضحية «ماهو كاتاغيري»، وهي من أعضاء تلك الجولة.
Dialogue: 0,0:59:22.96,0:59:26.56,Default,,0,0,0,,‫وبحسب كازوها، اشتعل معطفها بالنار
Dialogue: 0,0:59:26.56,0:59:29.26,Default,,0,0,0,,‫وسقطت في الخندق وكأنها تنهار.
Dialogue: 0,0:59:29.26,0:59:33.56,Default,,0,0,0,,‫لكن سبب الوفاة هو ضربة في مؤخرة رأسها.
Dialogue: 0,0:59:34.76,0:59:38.76,Default,,0,0,0,,‫ربما حدث ذلك عندما سقطت.
Dialogue: 0,0:59:38.76,0:59:41.06,Default,,0,0,0,,‫أظن أنها ارتطمت رأسها بالعارضة هناك.
Dialogue: 0,0:59:41.06,0:59:42.36,Default,,0,0,0,,‫هل كان انتحارًا؟
Dialogue: 0,0:59:42.36,0:59:45.36,Default,,0,0,0,,‫يبدو كذلك… على الأقل حتى الآن.
Dialogue: 0,0:59:45.36,0:59:47.76,Default,,0,0,0,,‫يا كازوها، هل أنت متأكدة أنها لم تكن تمسك شيئًا آخر
Dialogue: 0,0:59:47.76,0:59:49.36,Default,,0,0,0,,‫غير الولاعة؟
Dialogue: 0,0:59:49.36,0:59:51.76,Default,,0,0,0,,‫نعم، أنا متأكدة… هكذا بدا لي.
Dialogue: 0,0:59:51.76,0:59:55.16,Default,,0,0,0,,‫هل كان هناك أحدٌ بالقرب منها؟
Dialogue: 0,0:59:55.16,0:59:57.56,Default,,0,0,0,,‫لا… ليس بقربها،
Dialogue: 0,0:59:57.56,1:00:00.26,Default,,0,0,0,,‫لكن كان هناك شخص قرب مدخل الجسر، أليس كذلك؟
Dialogue: 0,1:00:00.26,1:00:02.16,Default,,0,0,0,,‫-نعم. -هذا هو!
Dialogue: 0,1:00:02.16,1:00:03.66,Default,,0,0,0,,‫هو من أشعلها!
Dialogue: 0,1:00:03.66,1:00:05.66,Default,,0,0,0,,‫لا أظن أن ذلك كان ممكنًا.
Dialogue: 0,1:00:05.66,1:00:08.76,Default,,0,0,0,,‫ذلك الشخص كان في نفس الجهة التي كنا فيها.
Dialogue: 0,1:00:08.76,1:00:11.06,Default,,0,0,0,,‫لكنني ما زلت أعتقد أنه انتحار.
Dialogue: 0,1:00:11.06,1:00:13.16,Default,,0,0,0,,‫لا تكوني سخيفة! مستحيل أن يكون انتحارًا!
Dialogue: 0,1:00:14.86,1:00:15.86,Default,,0,0,0,,‫لا بد أن هناك شيئًا هنا!
Dialogue: 0,1:00:15.86,1:00:17.86,Default,,0,0,0,,‫شيئًا يثبت أنها جريمة قتل! لا بدّ!
Dialogue: 0,1:00:17.86,1:00:19.66,Default,,0,0,0,,‫توقف يا هيجي!
Dialogue: 0,1:00:31.36,1:00:33.06,Default,,0,0,0,,‫أبي؟
Dialogue: 0,1:00:33.06,1:00:36.06,Default,,0,0,0,,‫يا هيجي، كفّ عن التصرف وكأنك تعرف كل شيء!
Dialogue: 0,1:00:36.06,1:00:37.66,Default,,0,0,0,,‫ألا تفهم؟
Dialogue: 0,1:00:37.66,1:00:40.36,Default,,0,0,0,,‫هل تعرف كم تُسبّب من المتاعب
Dialogue: 0,1:00:40.36,1:00:42.56,Default,,0,0,0,,‫كلما تدخلت في شؤون الشرطة؟
Dialogue: 0,1:00:42.56,1:00:44.56,Default,,0,0,0,,‫اهدأ يا سيدي!
Dialogue: 0,1:00:44.56,1:00:48.26,Default,,0,0,0,,‫هيجي يحاول فقط حل الجريمة بطريقته.
Dialogue: 0,1:00:48.96,1:00:50.36,Default,,0,0,0,,‫عذرًا.
Dialogue: 0,1:00:50.36,1:00:53.76,Default,,0,0,0,,‫يا سيد موري، قد ترى الأمر هكذا.
Dialogue: 0,1:00:53.76,1:00:54.86,Default,,0,0,0,,‫لكن حين يتعلق الأمر بهذا الفتى،
Dialogue: 0,1:00:54.86,1:00:56.46,Default,,0,0,0,,‫لا يمكن تسمية أساليبه «عمل شرطة».
Dialogue: 0,1:00:56.46,1:00:58.46,Default,,0,0,0,,‫إنه مُزعِج.
Dialogue: 0,1:00:58.46,1:01:00.66,Default,,0,0,0,,‫الناس يجامِلونه وينادونه «محققًا ثانويًا»
Dialogue: 0,1:01:00.66,1:01:02.86,Default,,0,0,0,,‫فانتفخت نفسه.
Dialogue: 0,1:01:02.86,1:01:05.06,Default,,0,0,0,,‫يتدخل في تحقيقاتنا لأنه يعبث بالأدلة
Dialogue: 0,1:01:05.06,1:01:07.56,Default,,0,0,0,,‫وبجثث الضحايا… فقط لأنه يعتبرها هواية!
Dialogue: 0,1:01:07.56,1:01:11.56,Default,,0,0,0,,‫إنه ليس إلا مُعتدٍ على مسرح الجريمة.
Dialogue: 0,1:01:11.56,1:01:13.06,Default,,0,0,0,,‫ولكي أثبت كلامي، انظر حولك…
Dialogue: 0,1:01:13.06,1:01:14.86,Default,,0,0,0,,‫شخصان ماتا أمام عينيه
Dialogue: 0,1:01:14.86,1:01:16.96,Default,,0,0,0,,‫ولم يفعل شيئًا ليمنع ذلك.
Dialogue: 0,1:01:16.96,1:01:18.76,Default,,0,0,0,,‫كان واثقًا جدًا ألا يحدث شيء آخر
Dialogue: 0,1:01:18.76,1:01:22.46,Default,,0,0,0,,‫لأن الشرطة طوّقت المكان.
Dialogue: 0,1:01:22.46,1:01:26.66,Default,,0,0,0,,‫والحقيقة… يمكن القول إننا نحن أيضًا نتحمل جزءًا من الخطأ.
Dialogue: 0,1:01:26.66,1:01:27.76,Default,,0,0,0,,‫على أي حال…
Dialogue: 0,1:01:27.76,1:01:29.86,Default,,0,0,0,,‫الهواة المتطفلون عليهم أن يرحلوا.
Dialogue: 0,1:01:29.86,1:01:32.16,Default,,0,0,0,,‫اختفِ عن وجهي فورًا!
Dialogue: 0,1:01:32.16,1:01:33.86,Default,,0,0,0,,‫سيدي!
Dialogue: 0,1:01:33.86,1:01:35.66,Default,,0,0,0,,‫أنت قاسٍ عليه أكثر من اللازم.
Dialogue: 0,1:01:35.66,1:01:36.86,Default,,0,0,0,,‫أوتاكي.
Dialogue: 0,1:01:36.86,1:01:41.36,Default,,0,0,0,,‫هل نسيت؟ قلت لك أن تراقب ذلك الرجل، أليس كذلك؟
Dialogue: 0,1:01:41.36,1:01:44.56,Default,,0,0,0,,‫صحيح! لا عجب أن الرئيس كان…
Dialogue: 0,1:01:44.56,1:01:48.76,Default,,0,0,0,,‫نعم… هذه طريقته في إظهار اهتمامه بابنه.
Dialogue: 0,1:01:54.06,1:01:56.86,Default,,0,0,0,,‫أوتاكي… هل هاتان الحادثتان جريمتا قتل؟
Dialogue: 0,1:01:56.86,1:01:58.36,Default,,0,0,0,,‫لا.
Dialogue: 0,1:01:58.36,1:01:59.46,Default,,0,0,0,,‫بالنسبة لقضية السيد كاتو،
Dialogue: 0,1:01:59.46,1:02:01.56,Default,,0,0,0,,‫سقط من البرج وهو يحترق،
Dialogue: 0,1:02:01.56,1:02:03.66,Default,,0,0,0,,‫وعثرنا على ولاعة على السطح
Dialogue: 0,1:02:03.66,1:02:07.16,Default,,0,0,0,,‫وعليها بصمات الضحية.
Dialogue: 0,1:02:07.16,1:02:09.06,Default,,0,0,0,,‫أما الآنسة كاتاغيري،
Dialogue: 0,1:02:09.06,1:02:13.56,Default,,0,0,0,,‫فقد أشعلت النار بنفسها وسقطت في الخندق.
Dialogue: 0,1:02:13.56,1:02:16.26,Default,,0,0,0,,‫وكازوها شهدت ذلك بنفسها.
Dialogue: 0,1:02:16.26,1:02:18.66,Default,,0,0,0,,‫هناك أمور عديدة لا نستطيع تفسيرها،
Dialogue: 0,1:02:18.66,1:02:21.86,Default,,0,0,0,,‫لكنني شبه متأكد أن الأمرين كانا انتحارًا.
Dialogue: 0,1:02:21.86,1:02:24.56,Default,,0,0,0,,‫إذا كان الأمر كذلك… فاثنان أو ثلاثة رجال
Dialogue: 0,1:02:24.56,1:02:26.06,Default,,0,0,0,,‫يكفون لتغطية العمل هنا.
Dialogue: 0,1:02:26.06,1:02:27.56,Default,,0,0,0,,‫هاه؟
Dialogue: 0,1:02:27.56,1:02:30.56,Default,,0,0,0,,‫-توياما، هيا بنا. -هاه؟
Dialogue: 0,1:02:31.66,1:02:33.76,Default,,0,0,0,,‫لدى الشرطة عمل أهمّ.
Dialogue: 0,1:02:33.76,1:02:36.76,Default,,0,0,0,,‫لا يمكننا إضاعة كل هذا الوقت في قضية تافهة كهذه.
Dialogue: 0,1:02:37.66,1:02:39.76,Default,,0,0,0,,‫سيدي الرئيس!
Dialogue: 0,1:02:42.76,1:02:44.46,Default,,0,0,0,,‫هيزو…
Dialogue: 0,1:02:44.46,1:02:46.76,Default,,0,0,0,,‫ما الذي تخطط له؟
Dialogue: 0,1:02:56.16,1:02:59.26,Default,,0,0,0,,‫لا تبدُ محبطًا يا هيجي.
Dialogue: 0,1:02:59.26,1:03:01.76,Default,,0,0,0,,‫الرئيس ربما غضِب
Dialogue: 0,1:03:01.76,1:03:05.36,Default,,0,0,0,,‫لأن شخصين ماتا بالقرب من المقر.
Dialogue: 0,1:03:05.36,1:03:07.96,Default,,0,0,0,,‫ومع ذلك… لم يكن عليه أن يضربه.
Dialogue: 0,1:03:07.96,1:03:12.16,Default,,0,0,0,,‫ربما اللوم كله على القاتل.
Dialogue: 0,1:03:12.16,1:03:13.86,Default,,0,0,0,,‫أتذكرون القصة؟
Dialogue: 0,1:03:13.86,1:03:16.96,Default,,0,0,0,,‫عن والد هيجي عندما أوصلنا بالسيارة
Dialogue: 0,1:03:16.96,1:03:19.06,Default,,0,0,0,,‫وكانوا يتحدثون عن قطعة فخار؟
Dialogue: 0,1:03:19.06,1:03:21.76,Default,,0,0,0,,‫حسنًا… هناك تكملة لذلك.
Dialogue: 0,1:03:22.86,1:03:23.96,Default,,0,0,0,,‫قالوا إنه من الممكن
Dialogue: 0,1:03:23.96,1:03:26.56,Default,,0,0,0,,‫أنه عندما عُثر على الجثة المحترقة قبل 13 سنة
Dialogue: 0,1:03:26.56,1:03:28.96,Default,,0,0,0,,‫كانت هناك سلسلة سرقات مسلحة
Dialogue: 0,1:03:28.96,1:03:32.06,Default,,0,0,0,,‫وأن اللص قد يُكشف بالصدفة.
Dialogue: 0,1:03:33.06,1:03:34.46,Default,,0,0,0,,‫سرقات مسلحة؟
Dialogue: 0,1:03:34.46,1:03:36.16,Default,,0,0,0,,‫نعم، كانت خمس حوادث متتالية.
Dialogue: 0,1:03:36.16,1:03:37.56,Default,,0,0,0,,‫قُتل سبعة أشخاص،
Dialogue: 0,1:03:37.56,1:03:39.86,Default,,0,0,0,,‫وما زال القاتل الوحشي طليقًا.
Dialogue: 0,1:03:39.86,1:03:42.76,Default,,0,0,0,,‫هل تقصد أن والد هاتّوري يظن
Dialogue: 0,1:03:42.76,1:03:46.26,Default,,0,0,0,,‫أن قاتل هذه القضايا الأخيرة هو الشخص نفسه؟
Dialogue: 0,1:03:46.26,1:03:47.86,Default,,0,0,0,,‫الآن فهمت!
Dialogue: 0,1:03:47.86,1:03:50.46,Default,,0,0,0,,‫هيزو لم يُرد تعريض ابنه للخطر،
Dialogue: 0,1:03:50.46,1:03:53.06,Default,,0,0,0,,‫فتصرّف ببرود ليُبعده عن القضية.
Dialogue: 0,1:03:53.06,1:03:56.36,Default,,0,0,0,,‫هذا مؤثر جدًا… يجعلني أريد البكاء.
Dialogue: 0,1:03:56.36,1:03:58.86,Default,,0,0,0,,‫نعم… يجعلني أريد البكاء أيضًا.
Dialogue: 0,1:04:00.06,1:04:03.56,Default,,0,0,0,,‫من كان يظن أن والدي سيصبح لينًا هكذا؟
Dialogue: 0,1:04:03.56,1:04:05.06,Default,,0,0,0,,‫هيجي…
Dialogue: 0,1:04:05.06,1:04:08.46,Default,,0,0,0,,‫أنا لا أتلقى الأوامر بسهولة.
Dialogue: 0,1:04:08.46,1:04:10.86,Default,,0,0,0,,‫إذا دفعني أحد… سأدفعه بالمقابل.
Dialogue: 0,1:04:10.86,1:04:12.16,Default,,0,0,0,,‫سأحل القضية
Dialogue: 0,1:04:12.16,1:04:14.56,Default,,0,0,0,,‫وأضع القاتل تحت أنف أبي!
Dialogue: 0,1:04:17.26,1:04:20.76,Default,,0,0,0,,‫يعني أنه أغبى من أن يطيع.
Dialogue: 0,1:04:21.86,1:04:24.26,Default,,0,0,0,,‫لكن هذا غريب…
Dialogue: 0,1:04:24.26,1:04:26.16,Default,,0,0,0,,‫كان ينبغي لوالده
Dialogue: 0,1:04:26.16,1:04:30.06,Default,,0,0,0,,‫أن يعرف أن ابنه لن يستسلم بهذه السهولة.
Dialogue: 0,1:04:38.20,1:04:39.40,Default,,0,0,0,,‫تعرف يا هيجي…
Dialogue: 0,1:04:39.40,1:04:41.30,Default,,0,0,0,,‫أنت تكرر كلامك عن قاتل،
Dialogue: 0,1:04:41.30,1:04:43.80,Default,,0,0,0,,‫لكن هذا لا يبدو إلا انتحارًا.
Dialogue: 0,1:04:43.80,1:04:45.20,Default,,0,0,0,,‫حسنًا… انظر إلى هذا.
Dialogue: 0,1:04:45.20,1:04:47.50,Default,,0,0,0,,‫انظر إلى الجانب الأيمن من الآنسة كاتاغيري.
Dialogue: 0,1:04:47.50,1:04:49.70,Default,,0,0,0,,‫هي باهتة لأنها مبتلة… لكن يمكنك رؤيتها.
Dialogue: 0,1:04:49.70,1:04:52.50,Default,,0,0,0,,‫هناك علامتان أو ثلاث علامات غريبة.
Dialogue: 0,1:04:52.50,1:04:55.20,Default,,0,0,0,,‫صحيح! هناك علامات غريبة هنا.
Dialogue: 0,1:04:55.20,1:04:57.70,Default,,0,0,0,,‫وكلها متشابهة.
Dialogue: 0,1:04:57.70,1:04:59.40,Default,,0,0,0,,‫أليس هذا دمًا؟
Dialogue: 0,1:04:59.40,1:05:01.50,Default,,0,0,0,,‫نعم… على الأرجح من الضحية.
Dialogue: 0,1:05:01.50,1:05:03.00,Default,,0,0,0,,‫من الضحية؟
Dialogue: 0,1:05:03.00,1:05:06.70,Default,,0,0,0,,‫نعم. الآنسة كاتاغيري ماتت بسبب ضربة على الرأس،
Dialogue: 0,1:05:06.70,1:05:07.70,Default,,0,0,0,,‫لكنها لم تُصب بها عندما سقطت
Dialogue: 0,1:05:07.70,1:05:10.30,Default,,0,0,0,,‫واصطدم رأسها بعارضة الجسر.
Dialogue: 0,1:05:10.30,1:05:13.50,Default,,0,0,0,,‫ربما ضربها أحدهم على رأسها بشيء صلب.
Dialogue: 0,1:05:14.60,1:05:18.60,Default,,0,0,0,,‫فتناثر الدم على القاتل،
Dialogue: 0,1:05:18.60,1:05:22.20,Default,,0,0,0,,‫ثم انتقل الدم إليها عندما حملها القاتل.
Dialogue: 0,1:05:22.80,1:05:24.20,Default,,0,0,0,,‫ما أقوله هو…
Dialogue: 0,1:05:24.20,1:05:26.70,Default,,0,0,0,,‫عندما رأت كازوها وران شخصًا على الجسر،
Dialogue: 0,1:05:26.70,1:05:28.40,Default,,0,0,0,,‫كانت بالفعل قد ماتت.
Dialogue: 0,1:05:28.40,1:05:30.40,Default,,0,0,0,,‫وهناك أمر آخر: الشخص الذي رأيتِه
Dialogue: 0,1:05:30.40,1:05:32.00,Default,,0,0,0,,‫اشتعل فجأة وسقط في الخندق،
Dialogue: 0,1:05:32.00,1:05:33.70,Default,,0,0,0,,‫ولهذا وصلتِ إلى استنتاج خاطئ
Dialogue: 0,1:05:33.70,1:05:35.80,Default,,0,0,0,,‫واعتقدتِ أنه انتحار.
Dialogue: 0,1:05:35.80,1:05:38.00,Default,,0,0,0,,‫لكن عندما اشتعلت النيران،
Dialogue: 0,1:05:38.00,1:05:40.40,Default,,0,0,0,,‫بدا وكأنها تتلوّى من الألم.
Dialogue: 0,1:05:40.40,1:05:44.00,Default,,0,0,0,,‫نعم… هذا صحيح. كانت بالتأكيد على قيد الحياة.
Dialogue: 0,1:05:44.00,1:05:45.70,Default,,0,0,0,,‫هذا ما ظننتِ أنك رأيتِه.
Dialogue: 0,1:05:45.70,1:05:47.70,Default,,0,0,0,,‫كان الظلام شديدًا… ولم تري جيدًا، صحيح؟
Dialogue: 0,1:05:47.70,1:05:50.00,Default,,0,0,0,,‫نعم، لكن…
Dialogue: 0,1:05:50.00,1:05:53.20,Default,,0,0,0,,‫على أي حال… هؤلاء الرجال يبدون مشبوهين بالنسبة لي.
Dialogue: 0,1:05:53.20,1:05:55.70,Default,,0,0,0,,‫عليّ أن أجد الرجال الثلاثة الذين كانوا في نفس الجولة
Dialogue: 0,1:05:55.70,1:05:58.30,Default,,0,0,0,,‫مع الشخصين المتوفيين… وأستجوبهم.
Dialogue: 0,1:05:58.30,1:06:01.20,Default,,0,0,0,,‫هل تقصدنا نحن؟
Dialogue: 0,1:06:01.20,1:06:03.00,Default,,0,0,0,,‫عدنا فورًا كما قلتَ لنا،
Dialogue: 0,1:06:03.00,1:06:04.40,Default,,0,0,0,,‫ولاحظنا هذه الجلبة الكبيرة.
Dialogue: 0,1:06:04.40,1:06:07.70,Default,,0,0,0,,‫يبدو أن الحشد يكبر.
Dialogue: 0,1:06:07.70,1:06:09.70,Default,,0,0,0,,‫ماذا حدث هنا؟
Dialogue: 0,1:06:11.80,1:06:13.40,Default,,0,0,0,,‫ماذا؟ لا أصدق!
Dialogue: 0,1:06:13.40,1:06:16.80,Default,,0,0,0,,‫الآنسة كاتاغيري سقطت من الجسر وهي تحترق؟
Dialogue: 0,1:06:16.80,1:06:18.80,Default,,0,0,0,,‫من «جسر جوكوراكو» هذا؟
Dialogue: 0,1:06:18.80,1:06:19.80,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:06:19.80,1:06:22.10,Default,,0,0,0,,‫لكن لماذا تنتحر بإشعال النار في نفسها؟
Dialogue: 0,1:06:22.10,1:06:25.10,Default,,0,0,0,,‫لم يُعلن رسميًا أنه انتحار بعد.
Dialogue: 0,1:06:25.10,1:06:27.90,Default,,0,0,0,,‫ولهذا نحتاج أن تجيبوا عن بعض الأسئلة.
Dialogue: 0,1:06:27.90,1:06:29.90,Default,,0,0,0,,‫أولًا… أنتم والآنسة كاتاغيري غادرتم هذه المنطقة،
Dialogue: 0,1:06:29.90,1:06:31.20,Default,,0,0,0,,‫إلى أين ذهبتم
Dialogue: 0,1:06:31.20,1:06:34.90,Default,,0,0,0,,‫وماذا كنتم تفعلون قبل أن تعودوا؟
Dialogue: 0,1:06:34.90,1:06:38.40,Default,,0,0,0,,‫ذهبتُ لأتناول شيئًا في مطعم صغير قريب من هنا.
Dialogue: 0,1:06:38.40,1:06:39.90,Default,,0,0,0,,‫وأنا كذلك.
Dialogue: 0,1:06:39.90,1:06:42.20,Default,,0,0,0,,‫لكنني ذهبتُ إلى مطعمٍ آخر.
Dialogue: 0,1:06:42.20,1:06:44.30,Default,,0,0,0,,‫أما أنا فعدتُ إلى الفندق في «نانايا-ري»،
Dialogue: 0,1:06:44.30,1:06:48.70,Default,,0,0,0,,‫حيث نقيم جميعًا… وبدّلت ملابسي.
Dialogue: 0,1:06:48.70,1:06:51.50,Default,,0,0,0,,‫إذًا كنتَ مع الآنسة كاتاغيري، صحيح؟
Dialogue: 0,1:06:51.50,1:06:54.20,Default,,0,0,0,,‫نعم… حتى وصلنا إلى الفندق.
Dialogue: 0,1:06:54.20,1:06:55.70,Default,,0,0,0,,‫لو كنتُ أعلم أن شيئًا كهذا سيحدث،
Dialogue: 0,1:06:55.70,1:06:57.70,Default,,0,0,0,,‫لبقيتُ معها طوال الوقت.
Dialogue: 0,1:06:57.70,1:07:01.70,Default,,0,0,0,,‫لكن لماذا اختار السيد كاتو والآنسة كاتاغيري «النار»؟
Dialogue: 0,1:07:01.70,1:07:05.50,Default,,0,0,0,,‫يكاد يبدو وكأن شخصًا أمرهما بذلك.
Dialogue: 0,1:07:05.50,1:07:07.00,Default,,0,0,0,,‫أمرهما؟
Dialogue: 0,1:07:09.00,1:07:10.90,Default,,0,0,0,,‫بالمناسبة يا سيد واكيساكا…
Dialogue: 0,1:07:10.90,1:07:15.40,Default,,0,0,0,,‫كنتَ تؤدي دور «نوبوناغا»، أليس كذلك؟
Dialogue: 0,1:07:15.40,1:07:16.80,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:07:16.80,1:07:19.30,Default,,0,0,0,,‫هذا يعني… لو أمرتهم بشيء،
Dialogue: 0,1:07:19.30,1:07:21.50,Default,,0,0,0,,‫فعليهم أن يطيعوا، أليس كذلك؟
Dialogue: 0,1:07:21.50,1:07:22.50,Default,,0,0,0,,‫حسنًا… إن كان الأمر كذلك،
Dialogue: 0,1:07:22.50,1:07:25.20,Default,,0,0,0,,‫فإن «فوكوشيما» الذي يمكنه تقمص دور نوبوناغا لثلاث دقائق
Dialogue: 0,1:07:25.20,1:07:27.20,Default,,0,0,0,,‫-كان يمكنه فعل ذلك أيضًا. -ماذا؟
Dialogue: 0,1:07:27.20,1:07:31.50,Default,,0,0,0,,‫أنا كنتُ ألعب دور «إيئه-ياسو»، لذا أنا خارج دائرة الشبهات.
Dialogue: 0,1:07:31.50,1:07:34.80,Default,,0,0,0,,‫إذًا… واحدٌ منكم لا بد أنه فعلها.
Dialogue: 0,1:07:34.80,1:07:38.10,Default,,0,0,0,,‫كانت مهمتهم تسلية «نوبوناغا»،
Dialogue: 0,1:07:38.10,1:07:40.10,Default,,0,0,0,,‫لا تلقي الأوامر!
Dialogue: 0,1:07:40.10,1:07:42.10,Default,,0,0,0,,‫ثم إن أحدًا لن يطيع أمرًا
Dialogue: 0,1:07:42.10,1:07:44.30,Default,,0,0,0,,‫بأن يشعل النار في نفسه.
Dialogue: 0,1:07:44.30,1:07:47.00,Default,,0,0,0,,‫وأيضًا… الآنسة كاتاغيري كانت تؤدي دور «نيني»،
Dialogue: 0,1:07:47.00,1:07:49.00,Default,,0,0,0,,‫وكان دورًا إشرافيًا فقط.
Dialogue: 0,1:07:49.00,1:07:52.30,Default,,0,0,0,,‫وفوق ذلك، عندما مات أول فردٍ من مجموعتنا،
Dialogue: 0,1:07:52.30,1:07:54.90,Default,,0,0,0,,‫لن نكون قساة لدرجة أن نواصل لعبة تقمص الأدوار!
Dialogue: 0,1:07:54.90,1:07:58.30,Default,,0,0,0,,‫نعم… أفهم ما تقصده.
Dialogue: 0,1:07:58.30,1:07:59.70,Default,,0,0,0,,‫أيها المفتش أوتاكي.
Dialogue: 0,1:07:59.70,1:08:03.70,Default,,0,0,0,,‫عثرنا على قطعة فخار أخرى على جثة الآنسة كاتاغيري.
Dialogue: 0,1:08:03.70,1:08:05.60,Default,,0,0,0,,‫ماذا… مرة أخرى؟
Dialogue: 0,1:08:07.00,1:08:10.60,Default,,0,0,0,,‫أتساءل لماذا كان الجميع يحملون قطع فخار كهذه.
Dialogue: 0,1:08:10.60,1:08:12.60,Default,,0,0,0,,‫وعثرنا على هذه الصورة أيضًا.
Dialogue: 0,1:08:15.60,1:08:17.40,Default,,0,0,0,,‫الزوجان الشابان في الزاوية اليمنى…
Dialogue: 0,1:08:17.40,1:08:19.80,Default,,0,0,0,,‫أليس هذان السيد كاتو والآنسة كاتاغيري؟
Dialogue: 0,1:08:21.50,1:08:24.90,Default,,0,0,0,,‫صحيح… إذًا كانا يعرفان بعضهما من قبل.
Dialogue: 0,1:08:24.90,1:08:28.10,Default,,0,0,0,,‫لكن… من هم الأشخاص الثلاثة الآخرون؟
Dialogue: 0,1:08:28.90,1:08:31.40,Default,,0,0,0,,‫أوه… هذا «هيرانو».
Dialogue: 0,1:08:31.40,1:08:34.30,Default,,0,0,0,,‫هنا… هذا هو.
Dialogue: 0,1:08:34.30,1:08:35.40,Default,,0,0,0,,‫صحيح.
Dialogue: 0,1:08:35.40,1:08:37.80,Default,,0,0,0,,‫يبدو أصغر بكثير… لكن أظن أنه هو.
Dialogue: 0,1:08:37.80,1:08:40.40,Default,,0,0,0,,‫ومن هو هذا «هيرانو»؟
Dialogue: 0,1:08:40.40,1:08:43.10,Default,,0,0,0,,‫هو من خطط لهذه الجولة.
Dialogue: 0,1:08:43.10,1:08:47.40,Default,,0,0,0,,‫تجمعنا كلنا بسبب صفحة هيرانو على الإنترنت.
Dialogue: 0,1:08:47.40,1:08:51.50,Default,,0,0,0,,‫هو من اقترح أن نقوم بهذه الرحلة.
Dialogue: 0,1:08:51.50,1:08:54.70,Default,,0,0,0,,‫وفكرة لعبة تقمص الأدوار كانت فكرته أيضًا.
Dialogue: 0,1:08:54.70,1:08:56.60,Default,,0,0,0,,‫للأسف… قبل أن ننطلق بالرحلة مباشرة،
Dialogue: 0,1:08:56.60,1:08:59.40,Default,,0,0,0,,‫طرأ أمرٌ مهم ولم يستطع الحضور.
Dialogue: 0,1:08:59.40,1:09:00.90,Default,,0,0,0,,‫فهمت.
Dialogue: 0,1:09:00.90,1:09:02.80,Default,,0,0,0,,‫إذًا الرجل الذي خطط هذه الرحلة
Dialogue: 0,1:09:02.80,1:09:06.30,Default,,0,0,0,,‫وانتهت بوفيات غريبة… ليس موجودًا معهم؟
Dialogue: 0,1:09:06.30,1:09:09.50,Default,,0,0,0,,‫هل أنتم متأكدون تمامًا أن الآنسة كاتاغيري لم تنتحر؟
Dialogue: 0,1:09:09.50,1:09:12.90,Default,,0,0,0,,‫نعم… حسنًا، لا نستطيع الجزم بعد.
Dialogue: 0,1:09:12.90,1:09:18.00,Default,,0,0,0,,‫حسنًا… إن كان القاتل يستخدم هذه الجولة لارتكاب جرائم،
Dialogue: 0,1:09:18.00,1:09:20.90,Default,,0,0,0,,‫فأول ما يجب فعله هو التحدث إلى السيد هيرانو.
Dialogue: 0,1:09:22.20,1:09:23.30,Default,,0,0,0,,‫يكفي أن
Dialogue: 0,1:09:23.30,1:09:26.80,Default,,0,0,0,,‫تدخلوا إلى صفحة «أسطورة سيد الذهب» على الإنترنت.
Dialogue: 0,1:09:31.70,1:09:34.10,Default,,0,0,0,,‫-هذا هو. -هاه؟
Dialogue: 0,1:09:34.10,1:09:37.10,Default,,0,0,0,,‫عندما احترقت الآنسة كاتاغيري وسقطت من الجسر،
Dialogue: 0,1:09:37.10,1:09:40.70,Default,,0,0,0,,‫هذا هو الشخص المريب الذي كان خلف ران وكازوها.
Dialogue: 0,1:09:40.70,1:09:43.20,Default,,0,0,0,,‫نعم، وأنا أيضًا ظننت ذلك،
Dialogue: 0,1:09:43.20,1:09:45.20,Default,,0,0,0,,‫لكن هناك شيء لا أفهمه.
Dialogue: 0,1:09:45.20,1:09:48.80,Default,,0,0,0,,‫القاتل استدرج الآنسة كاتاغيري إلى الجسر وقتلها،
Dialogue: 0,1:09:48.80,1:09:51.40,Default,,0,0,0,,‫ثم ربط حبلًا حولها وأسندها إلى الدرابزين،
Dialogue: 0,1:09:51.40,1:09:53.20,Default,,0,0,0,,‫وانتظر من بعيد حتى يمرّ أحد.
Dialogue: 0,1:09:53.20,1:09:55.60,Default,,0,0,0,,‫وحين حانت اللحظة، شدّ الحبل
Dialogue: 0,1:09:55.60,1:09:58.40,Default,,0,0,0,,‫فسقطت في الخندق… هذه الخدعة سهلة.
Dialogue: 0,1:09:58.40,1:10:00.50,Default,,0,0,0,,‫لكن إشعالها بالنار في التوقيت المناسب تمامًا
Dialogue: 0,1:10:00.50,1:10:03.20,Default,,0,0,0,,‫ليبدو وكأنها تتلوّى من الألم وهي تسقط…
Dialogue: 0,1:10:03.20,1:10:05.30,Default,,0,0,0,,‫هذا ليس سهلًا.
Dialogue: 0,1:10:05.30,1:10:07.10,Default,,0,0,0,,‫وهناك شيء آخر يزعجني أيضًا.
Dialogue: 0,1:10:07.10,1:10:11.20,Default,,0,0,0,,‫تلك البقعة الغريبة من الدم على جانبها.
Dialogue: 0,1:10:11.20,1:10:14.90,Default,,0,0,0,,‫أنا متأكد تقريبًا أنها من دمٍ كان على سحّاب.
Dialogue: 0,1:10:14.90,1:10:20.30,Default,,0,0,0,,‫لكن… لا أحد من الثلاثة كان يرتدي ملابس بسحّاب.
Dialogue: 0,1:10:20.30,1:10:21.60,Default,,0,0,0,,‫لا بد أن هناك سببًا جعل القاتل
Dialogue: 0,1:10:21.60,1:10:23.50,Default,,0,0,0,,‫يتكبّد عناء تبديل ملابسه إلى زيٍّ كهذا،
Dialogue: 0,1:10:23.50,1:10:27.10,Default,,0,0,0,,‫ثم يستدعي الآنسة كاتاغيري إلى الجسر.
Dialogue: 0,1:10:37.60,1:10:39.00,Default,,0,0,0,,‫عرفت ما هو.
Dialogue: 0,1:10:39.00,1:10:40.00,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:10:40.00,1:10:43.40,Default,,0,0,0,,‫الآن فهمنا لماذا كان القاتل يرتدي زيًا خاصًا فيه سحّاب.
Dialogue: 0,1:10:44.40,1:10:47.80,Default,,0,0,0,,‫والسؤال الآن: من الذي استخدم تلك الحيلة؟
Dialogue: 0,1:10:47.80,1:10:52.30,Default,,0,0,0,,‫حسنًا… أيّ واحدٍ من الثلاثة يمكنه فعل ذلك.
Dialogue: 0,1:10:52.30,1:10:54.30,Default,,0,0,0,,‫هيه يا هيجي، هيا بنا.
Dialogue: 0,1:10:54.30,1:10:56.90,Default,,0,0,0,,‫الريح تشتد أيضًا!
Dialogue: 0,1:10:59.60,1:11:00.60,Default,,0,0,0,,‫مظلّتي!
Dialogue: 0,1:11:08.10,1:11:09.70,Default,,0,0,0,,‫مرحبًا يا هاتّوري.
Dialogue: 0,1:11:09.70,1:11:11.60,Default,,0,0,0,,‫أظن أننا…
Dialogue: 0,1:11:11.60,1:11:14.30,Default,,0,0,0,,‫أظن أننا ارتكبنا خطأً كبيرًا.
Dialogue: 0,1:11:19.80,1:11:22.20,Default,,0,0,0,,‫آه… مظلتي تلفت.
Dialogue: 0,1:11:22.20,1:11:25.40,Default,,0,0,0,,‫يمكنك دائمًا شراء واحدة رخيصة من ذلك المتجر القريب.
Dialogue: 0,1:11:27.60,1:11:30.00,Default,,0,0,0,,‫هاه؟ أين هيجي؟
Dialogue: 0,1:11:30.00,1:11:32.10,Default,,0,0,0,,‫أخذ كونان وذهب إلى مكانٍ ما.
Dialogue: 0,1:11:32.10,1:11:33.70,Default,,0,0,0,,‫يبدو أنهما توصّلا إلى هوية القاتل.
Dialogue: 0,1:11:33.70,1:11:36.00,Default,,0,0,0,,‫هاه؟
Dialogue: 0,1:11:36.00,1:11:39.20,Default,,0,0,0,,‫كان وجهه يلمع حماسًا.
Dialogue: 0,1:11:47.30,1:11:50.20,Default,,0,0,0,,‫يا إلهي… لا يمكن أنهما ذهبا بعيدًا،
Dialogue: 0,1:11:50.20,1:11:51.70,Default,,0,0,0,,‫لكنني لا أراهما.
Dialogue: 0,1:11:51.70,1:11:54.70,Default,,0,0,0,,‫لا فائدة! واحدٌ منهم فقط في الفندق.
Dialogue: 0,1:11:54.70,1:11:57.10,Default,,0,0,0,,‫والآخران لم يعودا بعد.
Dialogue: 0,1:11:57.10,1:12:00.50,Default,,0,0,0,,‫ربما ستكون هناك جريمة قتل أخرى.
Dialogue: 0,1:12:00.50,1:12:03.70,Default,,0,0,0,,‫بعد أن يتم التحقيق في القضيتين الأولى والثانية جيدًا،
Dialogue: 0,1:12:03.70,1:12:08.10,Default,,0,0,0,,‫لا بد أن تنكشف الحيلة.
Dialogue: 0,1:12:08.10,1:12:11.40,Default,,0,0,0,,‫لذلك… على القاتل أن يُنهي الأمر الليلة.
Dialogue: 0,1:12:12.10,1:12:13.80,Default,,0,0,0,,‫إلى أين يمكن أن يكونا قد ذهبا؟
Dialogue: 0,1:12:15.30,1:12:17.30,Default,,0,0,0,,‫هناك! هذا السيد كاسويا!
Dialogue: 0,1:12:17.30,1:12:21.10,Default,,0,0,0,,‫لا يبدو أنه متجهٌ إلى الفندق.
Dialogue: 0,1:12:22.00,1:12:25.10,Default,,0,0,0,,‫يبدو أنه ذاهبٌ لينهي كل شيء.
Dialogue: 0,1:12:25.10,1:12:27.30,Default,,0,0,0,,‫حسنًا! سأبلغ الشرطة.
Dialogue: 0,1:12:27.30,1:12:30.20,Default,,0,0,0,,‫توقفي. إن جاءت الشرطة،
Dialogue: 0,1:12:30.20,1:12:33.10,Default,,0,0,0,,‫ستحدث جلبة وقد يهرب.
Dialogue: 0,1:12:33.10,1:12:35.90,Default,,0,0,0,,‫لنفتح أنا وأنتِ هذه القضية بأنفسنا.
Dialogue: 0,1:12:35.90,1:12:38.30,Default,,0,0,0,,‫أقصد… باب الحقيقة.
Dialogue: 0,1:12:41.90,1:12:43.20,Default,,0,0,0,,‫انتظر يا هاتّوري!
Dialogue: 0,1:13:07.10,1:13:10.50,Default,,0,0,0,,‫ذلك الرجل العجوز دخل مستودعًا يبدو مريبًا.
Dialogue: 0,1:13:10.50,1:13:13.10,Default,,0,0,0,,‫هاتّوري… ألا تشعر بشيء؟
Dialogue: 0,1:13:13.10,1:13:15.60,Default,,0,0,0,,‫لديّ إحساس غريب بأن أحدًا يراقبنا.
Dialogue: 0,1:13:18.20,1:13:20.80,Default,,0,0,0,,‫هيه، ماذا تفعل؟ سندخل!
Dialogue: 0,1:13:20.80,1:13:22.40,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,1:13:32.50,1:13:34.70,Default,,0,0,0,,‫إنه مظلم جدًا هنا… لا أرى شيئًا.
Dialogue: 0,1:13:35.70,1:13:36.80,Default,,0,0,0,,‫إنه هناك.
Dialogue: 0,1:13:36.80,1:13:38.90,Default,,0,0,0,,‫يبدو أنه يصعد للأعلى.
Dialogue: 0,1:13:38.90,1:13:41.60,Default,,0,0,0,,‫كودو… ذلك المخدّر في ساعتك،
Dialogue: 0,1:13:41.60,1:13:44.20,Default,,0,0,0,,‫-جهّزه. -نعم، أعلم.
Dialogue: 0,1:13:48.10,1:13:49.90,Default,,0,0,0,,‫هيه يا كودو… ما بك؟
Dialogue: 0,1:13:49.90,1:13:51.60,Default,,0,0,0,,‫تريد الذهاب إلى الحمّام؟
Dialogue: 0,1:13:53.20,1:13:56.90,Default,,0,0,0,,‫أوه لا… سأفقد أثره إن لم أتحرك.
Dialogue: 0,1:13:56.90,1:13:58.80,Default,,0,0,0,,‫اسمع يا كودو… عندما تنتهي من الحمّام،
Dialogue: 0,1:13:58.80,1:14:00.90,Default,,0,0,0,,‫الحق بي فورًا.
Dialogue: 0,1:14:24.41,1:14:26.91,Default,,0,0,0,,‫هيه… آسف على الانتظار.
Dialogue: 0,1:14:26.91,1:14:28.11,Default,,0,0,0,,‫واكيساكا.
Dialogue: 0,1:14:28.11,1:14:29.91,Default,,0,0,0,,‫لا مشكلة.
Dialogue: 0,1:14:29.91,1:14:32.01,Default,,0,0,0,,‫هل أحضرته معك؟
Dialogue: 0,1:14:32.01,1:14:35.21,Default,,0,0,0,,‫هناك… داخل ذلك الصندوق.
Dialogue: 0,1:14:35.21,1:14:37.31,Default,,0,0,0,,‫أرى… جيد!
Dialogue: 0,1:14:37.31,1:14:40.21,Default,,0,0,0,,‫لكن هناك الكثير من الأشياء هنا
Dialogue: 0,1:14:40.21,1:14:43.31,Default,,0,0,0,,‫والمكان مظلم… لا أستطيع تمييز شيء.
Dialogue: 0,1:14:43.31,1:14:46.31,Default,,0,0,0,,‫وضعتُ مصباحًا يدويًا إلى جانب الصندوق.
Dialogue: 0,1:14:46.31,1:14:48.61,Default,,0,0,0,,‫لمَ لا تستخدمه؟
Dialogue: 0,1:14:49.21,1:14:50.71,Default,,0,0,0,,‫ها هو!
Dialogue: 0,1:14:51.61,1:14:54.91,Default,,0,0,0,,‫باستخدامه ستجد ما تبحث عنه.
Dialogue: 0,1:14:54.91,1:14:56.71,Default,,0,0,0,,‫لفافة النمر.
Dialogue: 0,1:14:56.71,1:14:58.31,Default,,0,0,0,,‫لو كنتُ مكانك… لما شغّلته.
Dialogue: 0,1:15:00.01,1:15:03.01,Default,,0,0,0,,‫إن شغّلته… ستحترق حتى الرماد.
Dialogue: 0,1:15:03.91,1:15:08.91,Default,,0,0,0,,‫تمامًا مثل السيد كاتو فوق برج قلعة أوساكا.
Dialogue: 0,1:15:09.61,1:15:11.91,Default,,0,0,0,,‫أليس كذلك يا سيد واكيساكا؟
Dialogue: 0,1:15:13.51,1:15:17.11,Default,,0,0,0,,‫أتقصد أن الآنسة كاتاغيري والسيد كاتو كانا…
Dialogue: 0,1:15:17.11,1:15:21.81,Default,,0,0,0,,‫بالضبط… السيد واكيساكا هو من قتلهما.
Dialogue: 0,1:15:21.81,1:15:25.21,Default,,0,0,0,,‫استخدم نفس الحيلة التي حاول استخدامها معك.
Dialogue: 0,1:15:25.21,1:15:26.41,Default,,0,0,0,,‫استدرجكم أنتم الثلاثة
Dialogue: 0,1:15:26.41,1:15:29.31,Default,,0,0,0,,‫بزعم أنه وجد لفافة النمر.
Dialogue: 0,1:15:29.31,1:15:31.81,Default,,0,0,0,,‫كان الأمر سهلًا مع السيد كاتو.
Dialogue: 0,1:15:31.81,1:15:34.41,Default,,0,0,0,,‫كل ما فعله أنه أخبره
Dialogue: 0,1:15:34.41,1:15:38.31,Default,,0,0,0,,‫أنه أخفى اللفافة تحت إحدى بلاطات سطح البرج.
Dialogue: 0,1:15:38.31,1:15:39.61,Default,,0,0,0,,‫ولكي تصعد إلى السطح،
Dialogue: 0,1:15:39.61,1:15:41.51,Default,,0,0,0,,‫ستتجنب الذهاب عصرًا
Dialogue: 0,1:15:41.51,1:15:43.91,Default,,0,0,0,,‫حين يكون المكان مكتظًا… وتنتظر حتى الليل.
Dialogue: 0,1:15:43.91,1:15:46.81,Default,,0,0,0,,‫الخروج ليلًا ممكن… لكن من دون ضوء،
Dialogue: 0,1:15:46.81,1:15:49.01,Default,,0,0,0,,‫لن تعرف تحت أي بلاطة خبأها.
Dialogue: 0,1:15:50.11,1:15:51.51,Default,,0,0,0,,‫لم يكن أمام السيد كاتو خيارٌ آخر،
Dialogue: 0,1:15:51.51,1:15:52.71,Default,,0,0,0,,‫فأخرج الولاعة التي معه
Dialogue: 0,1:15:52.71,1:15:55.11,Default,,0,0,0,,‫وأشعلها ليتمكن من البحث.
Dialogue: 0,1:15:55.11,1:15:59.91,Default,,0,0,0,,‫ثم رأى مصباحًا يدويًا ملقى هناك
Dialogue: 0,1:15:59.91,1:16:02.71,Default,,0,0,0,,‫وكأنه ينتظر من يعثر عليه.
Dialogue: 0,1:16:03.91,1:16:09.41,Default,,0,0,0,,‫وكان السيد واكيساكا قد تركه هناك مسبقًا.
Dialogue: 0,1:16:09.41,1:16:11.21,Default,,0,0,0,,‫وكان مفخخًا لينفجر عند تشغيله.
Dialogue: 0,1:16:11.21,1:16:13.41,Default,,0,0,0,,‫فهمت.
Dialogue: 0,1:16:13.41,1:16:15.31,Default,,0,0,0,,‫يعني أن السيد كاتو اختار استخدام المصباح
Dialogue: 0,1:16:15.31,1:16:18.91,Default,,0,0,0,,‫لأنه أسهل… لكن عندما شغّله انفجر.
Dialogue: 0,1:16:18.91,1:16:20.01,Default,,0,0,0,,‫بالضبط.
Dialogue: 0,1:16:20.01,1:16:23.11,Default,,0,0,0,,‫المصباح انفجر إلى قطع صغيرة،
Dialogue: 0,1:16:23.11,1:16:27.11,Default,,0,0,0,,‫وبقيت الولاعة التي عليها بصماته على السطح،
Dialogue: 0,1:16:27.11,1:16:30.61,Default,,0,0,0,,‫فبدا وكأنه أشعل النار في نفسه.
Dialogue: 0,1:16:31.61,1:16:34.51,Default,,0,0,0,,‫وهذا يفسر الأثر الجاف
Dialogue: 0,1:16:34.51,1:16:37.51,Default,,0,0,0,,‫الذي بقي تحت الولاعة.
Dialogue: 0,1:16:37.51,1:16:39.61,Default,,0,0,0,,‫لن يظهر أثر كهذا
Dialogue: 0,1:16:39.61,1:16:41.41,Default,,0,0,0,,‫إلا إذا وضعت ولاعة على سطحٍ مبتل بشكل دائري.
Dialogue: 0,1:16:41.41,1:16:43.41,Default,,0,0,0,,‫وفوق ذلك… عثرنا على بطارية محترقة
Dialogue: 0,1:16:43.41,1:16:45.61,Default,,0,0,0,,‫على الأرض قرب القلعة.
Dialogue: 0,1:16:46.91,1:16:49.91,Default,,0,0,0,,‫لكن… كيف قتل الآنسة كاتاغيري؟
Dialogue: 0,1:16:51.21,1:16:53.61,Default,,0,0,0,,‫بحسب الفتاتين اللتين شهدتا ذلك،
Dialogue: 0,1:16:53.61,1:16:56.61,Default,,0,0,0,,‫عندما أشعلت النار في نفسها،
Dialogue: 0,1:16:56.61,1:16:59.41,Default,,0,0,0,,‫لم يكن هناك أحدٌ غيرها حولها.
Dialogue: 0,1:16:59.41,1:17:01.31,Default,,0,0,0,,‫وكانت تتلوّى من الألم
Dialogue: 0,1:17:01.31,1:17:04.61,Default,,0,0,0,,‫وهي تسقط في الخندق.
Dialogue: 0,1:17:04.61,1:17:07.21,Default,,0,0,0,,‫وكل ما كان في يدها… ولاعة.
Dialogue: 0,1:17:07.21,1:17:10.11,Default,,0,0,0,,‫الانتحار هو الاستنتاج الوحيد.
Dialogue: 0,1:17:10.11,1:17:13.11,Default,,0,0,0,,‫لا ألومك على التفكير بهذه الطريقة.
Dialogue: 0,1:17:13.11,1:17:15.71,Default,,0,0,0,,‫لكن… لم تكن هي من أشعلت النار في نفسها
Dialogue: 0,1:17:15.71,1:17:17.01,Default,,0,0,0,,‫وسقطت في الخندق.
Dialogue: 0,1:17:17.01,1:17:21.61,Default,,0,0,0,,‫بل كان السيد واكيساكا.
Dialogue: 0,1:17:21.61,1:17:23.91,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,1:17:23.91,1:17:27.21,Default,,0,0,0,,‫بعد أن انفضّ الحشد المتجمع قرب البرج
Dialogue: 0,1:17:27.21,1:17:31.91,Default,,0,0,0,,‫وقلّ المارّة حول الجسر،
Dialogue: 0,1:17:31.91,1:17:35.61,Default,,0,0,0,,‫استدعاها بعد أن جعلها ترتدي معطفًا.
Dialogue: 0,1:17:35.61,1:17:39.81,Default,,0,0,0,,‫ثم قتلها بضربها بجسمٍ صلب،
Dialogue: 0,1:17:39.81,1:17:42.81,Default,,0,0,0,,‫ثم رماها في الخندق.
Dialogue: 0,1:17:42.81,1:17:45.31,Default,,0,0,0,,‫وجثتها طفت على سطح الماء،
Dialogue: 0,1:17:45.31,1:17:48.61,Default,,0,0,0,,‫فصبّ عليها الكيروسين… وجهّز المسرح.
Dialogue: 0,1:17:48.61,1:17:50.91,Default,,0,0,0,,‫لم يبقَ عليه إلا أن ينتظر مرور أحد على الجسر،
Dialogue: 0,1:17:50.91,1:17:53.31,Default,,0,0,0,,‫ثم يشعل النار في معطفه،
Dialogue: 0,1:17:53.31,1:17:54.51,Default,,0,0,0,,‫ويمثل أنه يتلوّى من الألم،
Dialogue: 0,1:17:54.51,1:17:56.31,Default,,0,0,0,,‫ثم يُسقط الولاعة في الخندق.
Dialogue: 0,1:17:56.31,1:17:59.51,Default,,0,0,0,,‫عندها ستشعل الولاعة جثة الآنسة كاتاغيري الطافية في الماء.
Dialogue: 0,1:17:59.51,1:18:01.11,Default,,0,0,0,,‫وبعد ذلك قفز في الخندق
Dialogue: 0,1:18:01.11,1:18:03.11,Default,,0,0,0,,‫وغاص تحت الماء.
Dialogue: 0,1:18:03.11,1:18:06.01,Default,,0,0,0,,‫والشيء الوحيد الذي سيُرى هو
Dialogue: 0,1:18:06.01,1:18:10.61,Default,,0,0,0,,‫جثة الآنسة كاتاغيري وهي تحترق فوق الماء.
Dialogue: 0,1:18:11.91,1:18:13.61,Default,,0,0,0,,‫يعني… حتى عندما تُرفع جثتها
Dialogue: 0,1:18:13.61,1:18:16.71,Default,,0,0,0,,‫من الماء وتُفحص،
Dialogue: 0,1:18:16.71,1:18:19.11,Default,,0,0,0,,‫ستبدو إصابة الرأس—وهي سبب الوفاة الحقيقي—
Dialogue: 0,1:18:19.11,1:18:21.31,Default,,0,0,0,,‫كأنها نتيجة ارتطامها بعارضة الجسر،
Dialogue: 0,1:18:21.31,1:18:23.31,Default,,0,0,0,,‫لأن الشهود سيشهدون
Dialogue: 0,1:18:23.31,1:18:28.81,Default,,0,0,0,,‫أنها أشعلت النار في نفسها وسقطت من الجسر.
Dialogue: 0,1:18:28.81,1:18:29.81,Default,,0,0,0,,‫بالضبط.
Dialogue: 0,1:18:29.81,1:18:31.71,Default,,0,0,0,,‫لكن الأمور سارت بسلاسة
Dialogue: 0,1:18:31.71,1:18:35.11,Default,,0,0,0,,‫فقط لأن تلك الفتاتين مرّتا صدفة في اللحظة المناسبة.
Dialogue: 0,1:18:35.11,1:18:37.31,Default,,0,0,0,,‫لو مرّ وقت طويل قبل أن يمرّ أحد،
Dialogue: 0,1:18:37.31,1:18:40.71,Default,,0,0,0,,‫لاختلّ وقت الوفاة… أليس كذلك؟
Dialogue: 0,1:18:40.71,1:18:41.71,Default,,0,0,0,,‫ليس تمامًا.
Dialogue: 0,1:18:41.71,1:18:45.31,Default,,0,0,0,,‫لأن السيد واكيساكا كان قد جهّز شاهدًا أصلًا.
Dialogue: 0,1:18:45.31,1:18:46.71,Default,,0,0,0,,‫كانت مجرد مصادفة
Dialogue: 0,1:18:46.71,1:18:48.61,Default,,0,0,0,,‫أن كازوها وران رأتا ما حدث أولًا،
Dialogue: 0,1:18:48.61,1:18:52.11,Default,,0,0,0,,‫لكن يبدو أن الشاهد المقصود هرب من المكان.
Dialogue: 0,1:18:53.11,1:18:55.51,Default,,0,0,0,,‫لا تقل إنه كان…
Dialogue: 0,1:18:55.51,1:18:57.61,Default,,0,0,0,,‫كان السيد فوكوشيما.
Dialogue: 0,1:18:57.61,1:19:00.21,Default,,0,0,0,,‫لم يكن يعرف شيئًا عن الحادثة،
Dialogue: 0,1:19:00.21,1:19:03.51,Default,,0,0,0,,‫لكن عندما سمع أن جسدًا مشتعلًا سقط في الخندق،
Dialogue: 0,1:19:03.51,1:19:06.21,Default,,0,0,0,,‫قال فورًا إنه انتحار.
Dialogue: 0,1:19:06.21,1:19:07.81,Default,,0,0,0,,‫فكر في الأمر.
Dialogue: 0,1:19:07.81,1:19:08.91,Default,,0,0,0,,‫لو أراد أحد أن ينتحر
Dialogue: 0,1:19:08.91,1:19:10.41,Default,,0,0,0,,‫بإشعال النار في نفسه،
Dialogue: 0,1:19:10.41,1:19:13.61,Default,,0,0,0,,‫فلن يقفز إلى الماء… لأنه سيطفئ النار.
Dialogue: 0,1:19:13.61,1:19:16.71,Default,,0,0,0,,‫ومن الطبيعي أن تظن أن القفز في الماء
Dialogue: 0,1:19:16.71,1:19:19.41,Default,,0,0,0,,‫لا يحدث إلا إذا أشعل شخصٌ آخر النار بك… صحيح؟
Dialogue: 0,1:19:19.41,1:19:21.81,Default,,0,0,0,,‫كلامه يثبت أنه شاهدها
Dialogue: 0,1:19:21.81,1:19:24.21,Default,,0,0,0,,‫تقفز في الخندق بعد أن أشعلت النار في نفسها.
Dialogue: 0,1:19:24.21,1:19:25.91,Default,,0,0,0,,‫وبالقياس على أحداث اليوم،
Dialogue: 0,1:19:25.91,1:19:27.51,Default,,0,0,0,,‫يكفي أن يتنكر أحدهم بصوته
Dialogue: 0,1:19:27.51,1:19:29.41,Default,,0,0,0,,‫ويتظاهر بأنه شرطي ويستدعيه إلى الجسر،
Dialogue: 0,1:19:29.41,1:19:32.51,Default,,0,0,0,,‫ليذهب إليه فورًا.
Dialogue: 0,1:19:32.51,1:19:34.91,Default,,0,0,0,,‫لكن الأمر غريب جدًا.
Dialogue: 0,1:19:34.91,1:19:36.31,Default,,0,0,0,,‫بعد ما حدث،
Dialogue: 0,1:19:36.31,1:19:38.91,Default,,0,0,0,,‫لم يكن شعر السيد واكيساكا وملابسه مبللين كثيرًا.
Dialogue: 0,1:19:38.91,1:19:40.01,Default,,0,0,0,,‫ولو حدث خطأٌ ما،
Dialogue: 0,1:19:40.01,1:19:41.31,Default,,0,0,0,,‫كان يمكن أن يحترق بشدة.
Dialogue: 0,1:19:41.31,1:19:45.61,Default,,0,0,0,,‫كان يرتدي بدلةً عازلة للماء
Dialogue: 0,1:19:45.61,1:19:48.21,Default,,0,0,0,,‫تحت معطفه وفوق ملابسه.
Dialogue: 0,1:19:49.71,1:19:51.41,Default,,0,0,0,,‫ولو وضع القناع قبل أن يشعل النار في نفسه،
Dialogue: 0,1:19:51.41,1:19:53.31,Default,,0,0,0,,‫فلن يحترق،
Dialogue: 0,1:19:53.31,1:19:55.41,Default,,0,0,0,,‫ولن يبتل شعره أو ملابسه،
Dialogue: 0,1:19:55.41,1:19:57.61,Default,,0,0,0,,‫وبذلك يستطيع السباحة تحت الماء.
Dialogue: 0,1:19:57.61,1:19:58.71,Default,,0,0,0,,‫حتى يبتعد عن الجسر،
Dialogue: 0,1:19:58.71,1:20:00.71,Default,,0,0,0,,‫ثم يتسلق الجدار الحجري،
Dialogue: 0,1:20:00.71,1:20:03.81,Default,,0,0,0,,‫وبعد أن يُخفي البدلة والمعطف في مكان ما،
Dialogue: 0,1:20:03.81,1:20:05.31,Default,,0,0,0,,‫يعود وينضم إلى الحشد
Dialogue: 0,1:20:05.31,1:20:07.61,Default,,0,0,0,,‫حتى لا يثير الشكوك حوله.
Dialogue: 0,1:20:07.61,1:20:11.11,Default,,0,0,0,,‫وبالمناسبة… الفليس القابل للاشتعال الذي كان يرتديه السيد كاتو،
Dialogue: 0,1:20:11.11,1:20:15.91,Default,,0,0,0,,‫ومعطف الآنسة كاتاغيري… أنت من أعطيتهما إياهما، صحيح؟
Dialogue: 0,1:20:16.81,1:20:19.01,Default,,0,0,0,,‫على الأرجح قلتَ لهما إنه سيكون من السهل عليهما…
Dialogue: 0,1:20:19.01,1:20:21.31,Default,,0,0,0,,‫لكي يتعرّفا على بعضهما عندما كانا يتسللان للقاءٍ سري.
Dialogue: 0,1:20:21.31,1:20:24.91,Default,,0,0,0,,‫هل كنت تعلم أن على معطف الآنسة كاتاغيري دمًا؟
Dialogue: 0,1:20:24.91,1:20:26.91,Default,,0,0,0,,‫دمُها تناثر على ملابسك،
Dialogue: 0,1:20:26.91,1:20:29.01,Default,,0,0,0,,‫ثم نقلته أنتَ إلى معطفها.
Dialogue: 0,1:20:29.01,1:20:32.41,Default,,0,0,0,,‫انتقل إليها عندما حملتَها.
Dialogue: 0,1:20:33.31,1:20:35.91,Default,,0,0,0,,‫وكانت آثار الدم على شكل سحّاب بدلةٍ جافة
Dialogue: 0,1:20:35.91,1:20:39.41,Default,,0,0,0,,‫وحافة ذلك الشعار الذي على صدرك.
Dialogue: 0,1:20:39.41,1:20:40.41,Default,,0,0,0,,‫وهذا يعني أنه
Dialogue: 0,1:20:40.41,1:20:43.91,Default,,0,0,0,,‫لو فحصنا شعار نوبوناغا الذي ترتديه،
Dialogue: 0,1:20:43.91,1:20:47.01,Default,,0,0,0,,‫فسيكون لدينا الدليل لإدانتك.
Dialogue: 0,1:20:47.01,1:20:49.81,Default,,0,0,0,,‫لكن… لماذا أراد قتلي أنا والاثنين الآخرين؟
Dialogue: 0,1:20:49.81,1:20:52.01,Default,,0,0,0,,‫لم تكونوا أنتم الثلاثة فقط.
Dialogue: 0,1:20:52.01,1:20:55.71,Default,,0,0,0,,‫لقد قتل أيضًا الرجل الذي خطّط لهذه الرحلة… السيد هيرانو.
Dialogue: 0,1:20:55.71,1:21:00.21,Default,,0,0,0,,‫طلبتُ من أستاذ أعرفه أن يدخل إلى صفحة السيد هيرانو،
Dialogue: 0,1:21:00.21,1:21:02.81,Default,,0,0,0,,‫فاكتشف أنه كان يكتب تدوينات يوميًا،
Dialogue: 0,1:21:02.81,1:21:05.11,Default,,0,0,0,,‫لكنه توقف منذ ثلاثة أسابيع.
Dialogue: 0,1:21:05.71,1:21:08.71,Default,,0,0,0,,‫أتتذكر الجثة المتفحمة التي عُثر عليها مؤخرًا في الخندق الخارجي؟
Dialogue: 0,1:21:08.71,1:21:10.51,Default,,0,0,0,,‫كانت على الأرجح…
Dialogue: 0,1:21:10.51,1:21:12.51,Default,,0,0,0,,‫نعم… صحيح.
Dialogue: 0,1:21:12.51,1:21:17.11,Default,,0,0,0,,‫لقد قتلتُ هيرانو وكاتو وكاتاغيري
Dialogue: 0,1:21:17.11,1:21:20.01,Default,,0,0,0,,‫وفاءً لجدّي ماساكيو
Dialogue: 0,1:21:20.01,1:21:23.01,Default,,0,0,0,,‫الذي أحبّ هيديوشي وقُتل بسبب ذلك!
Dialogue: 0,1:21:23.01,1:21:25.11,Default,,0,0,0,,‫جدّك؟
Dialogue: 0,1:21:25.11,1:21:27.61,Default,,0,0,0,,‫لقد رأيت الصورة، أليس كذلك؟
Dialogue: 0,1:21:27.61,1:21:30.01,Default,,0,0,0,,‫العجوز في الوسط، الذي كان يمسك اللفافة مفتوحة،
Dialogue: 0,1:21:30.01,1:21:32.11,Default,,0,0,0,,‫كان جدّي.
Dialogue: 0,1:21:32.11,1:21:35.31,Default,,0,0,0,,‫كان يخبرني دائمًا
Dialogue: 0,1:21:35.31,1:21:37.81,Default,,0,0,0,,‫عن اللفافة التي عثر عليها،
Dialogue: 0,1:21:37.81,1:21:40.81,Default,,0,0,0,,‫وعن الأدلة التي تقود إلى كنز هيديوشي.
Dialogue: 0,1:21:41.51,1:21:43.61,Default,,0,0,0,,‫وقال لي إنه يريد التوقف عن البحث عن الكنز
Dialogue: 0,1:21:43.61,1:21:47.61,Default,,0,0,0,,‫وأن يهب اللفافة للدولة.
Dialogue: 0,1:21:47.61,1:21:49.81,Default,,0,0,0,,‫لكن الآخرين لم يوافقوا،
Dialogue: 0,1:21:49.81,1:21:52.41,Default,,0,0,0,,‫وبدأوا يتجادلون حول ذلك.
Dialogue: 0,1:21:52.41,1:21:56.61,Default,,0,0,0,,‫ثم قبل 13 عامًا أخبرنا أنه ذاهب إلى أوساكا
Dialogue: 0,1:21:56.61,1:21:58.81,Default,,0,0,0,,‫ليحاول إقناعهم بالموافقة،
Dialogue: 0,1:21:58.81,1:22:01.21,Default,,0,0,0,,‫ولم يعد بعدها أبدًا.
Dialogue: 0,1:22:01.21,1:22:06.11,Default,,0,0,0,,‫أتقصد أن الجثة المتفحمة التي عُثر عليها في الخندق قبل 13 عامًا…
Dialogue: 0,1:22:06.11,1:22:09.41,Default,,0,0,0,,‫كانت جدّي. لقد قتله شركاؤه.
Dialogue: 0,1:22:09.41,1:22:13.51,Default,,0,0,0,,‫جدّي عثر على تلك القطعة من الفخار مع اللفافة،
Dialogue: 0,1:22:13.51,1:22:16.31,Default,,0,0,0,,‫لكنه لم يُخبر الآخرين بها.
Dialogue: 0,1:22:16.31,1:22:18.41,Default,,0,0,0,,‫تلك الصورة كانت الدليل الوحيد لديّ
Dialogue: 0,1:22:18.41,1:22:21.11,Default,,0,0,0,,‫لمعرفة من هم شركاؤه،
Dialogue: 0,1:22:21.11,1:22:23.41,Default,,0,0,0,,‫ولذلك عانيت كثيرًا حتى أعثر عليهم.
Dialogue: 0,1:22:23.41,1:22:25.61,Default,,0,0,0,,‫ولم أتخيل أبدًا أن أحدهم
Dialogue: 0,1:22:25.61,1:22:28.01,Default,,0,0,0,,‫سيغيّر شكله.
Dialogue: 0,1:22:29.21,1:22:33.51,Default,,0,0,0,,‫تقصد أن ذلك العجوز على اليسار هو…
Dialogue: 0,1:22:37.01,1:22:38.21,Default,,0,0,0,,‫أنا.
Dialogue: 0,1:22:38.21,1:22:41.81,Default,,0,0,0,,‫حدث شيء… واضطررت لتغيير مظهري.
Dialogue: 0,1:22:41.81,1:22:43.81,Default,,0,0,0,,‫بدت الآنسة كاتاغيري وكأنها تشكّ
Dialogue: 0,1:22:43.81,1:22:47.11,Default,,0,0,0,,‫بأني أحد أفراد جماعتهم السابقة.
Dialogue: 0,1:22:50.91,1:22:52.21,Default,,0,0,0,,‫لا يهمني ما سيحدث لي،
Dialogue: 0,1:22:52.21,1:22:54.81,Default,,0,0,0,,‫لكن… هل ستقتل السيد واكيساكا أيضًا؟
Dialogue: 0,1:22:54.81,1:22:57.91,Default,,0,0,0,,‫عندها لن تعرف أبدًا مكان الكنز.
Dialogue: 0,1:22:57.91,1:23:02.51,Default,,0,0,0,,‫أفترض أنك لم تُحضر لفافة النمر معك.
Dialogue: 0,1:23:02.51,1:23:05.21,Default,,0,0,0,,‫لقد عرفتُ بالفعل أين يسكن السيد واكيساكا،
Dialogue: 0,1:23:05.21,1:23:07.51,Default,,0,0,0,,‫وسأقلب منزله رأسًا على عقب.
Dialogue: 0,1:23:07.51,1:23:10.01,Default,,0,0,0,,‫أنتما… إلى الخلف فورًا!
Dialogue: 0,1:23:10.01,1:23:13.11,Default,,0,0,0,,‫التقطا ذلك المصباح وشغّلاه.
Dialogue: 0,1:23:13.11,1:23:15.51,Default,,0,0,0,,‫سأجعلكما تسقطان أرضًا.
Dialogue: 0,1:23:15.51,1:23:18.11,Default,,0,0,0,,‫وسيبدو الأمر وكأن القاتل والمحقق المراهق
Dialogue: 0,1:23:18.11,1:23:21.31,Default,,0,0,0,,‫سقطا لحتفهما وهما تلتهمهما النيران!
Dialogue: 0,1:23:21.31,1:23:25.01,Default,,0,0,0,,‫وبالمناسبة… قبل أن تموت، أجبني.
Dialogue: 0,1:23:25.01,1:23:28.51,Default,,0,0,0,,‫كيف عرفتَ أن السيد واكيساكا هو القاتل؟
Dialogue: 0,1:23:28.51,1:23:32.51,Default,,0,0,0,,‫أيّ واحدٍ كان يمكنه استخدام تلك الحيلة التي شرحتها.
Dialogue: 0,1:23:32.51,1:23:34.91,Default,,0,0,0,,‫ما الذي جعلك تشكّ به؟
Dialogue: 0,1:23:35.81,1:23:37.41,Default,,0,0,0,,‫ولماذا أخبرك؟
Dialogue: 0,1:23:37.41,1:23:39.31,Default,,0,0,0,,‫كانت المظلّة.
Dialogue: 0,1:23:41.61,1:23:45.01,Default,,0,0,0,,‫في لحظة السيد كاتو الأخيرة، أمسك بمظلّة…
Dialogue: 0,1:23:45.01,1:23:47.11,Default,,0,0,0,,‫كانت رسالته الأخيرة.
Dialogue: 0,1:23:47.11,1:23:50.71,Default,,0,0,0,,‫كان يشير إلى راية نوبوناغا… المظلّة الذهبية.
Dialogue: 0,1:23:50.71,1:23:55.91,Default,,0,0,0,,‫وهكذا عرفوا أن السيد واكيساكا هو القاتل.
Dialogue: 0,1:23:55.91,1:23:58.31,Default,,0,0,0,,‫أيها الشقي! متى صعدتَ إلى هناك؟
Dialogue: 0,1:23:58.31,1:24:00.01,Default,,0,0,0,,‫انزل حالًا!
Dialogue: 0,1:24:00.01,1:24:03.11,Default,,0,0,0,,‫وإلا سأفرغ الرصاص في صديقك هنا!
Dialogue: 0,1:24:03.11,1:24:04.51,Default,,0,0,0,,‫لا! لا تنزل!
Dialogue: 0,1:24:04.51,1:24:06.51,Default,,0,0,0,,‫يبدو أنه لا خيار أمامي.
Dialogue: 0,1:24:06.51,1:24:07.91,Default,,0,0,0,,‫يا أحمق!
Dialogue: 0,1:24:07.91,1:24:10.11,Default,,0,0,0,,‫يا لك من ولدٍ مطيع.
Dialogue: 0,1:24:15.21,1:24:17.51,Default,,0,0,0,,‫أنتَ… هيزو هاتّوري!
Dialogue: 0,1:24:18.91,1:24:20.61,Default,,0,0,0,,‫أبي؟
Dialogue: 0,1:24:20.61,1:24:23.71,Default,,0,0,0,,‫ربما غيّرتَ شكلك قبل 13 عامًا،
Dialogue: 0,1:24:23.71,1:24:25.11,Default,,0,0,0,,‫لكن يبدو أنك لا تستطيع تغيير
Dialogue: 0,1:24:25.11,1:24:27.91,Default,,0,0,0,,‫ذلك الصوت المقزّز ولا تلك النفسية المعوجّة.
Dialogue: 0,1:24:32.31,1:24:35.41,Default,,0,0,0,,‫أنتَ رهن الاعتقال لحيازتك سلاحًا غير قانوني
Dialogue: 0,1:24:35.41,1:24:37.81,Default,,0,0,0,,‫ومحاولة القتل!
Dialogue: 0,1:24:37.81,1:24:41.91,Default,,0,0,0,,‫وكذلك لجرائم السطو الخمس التي ارتكبتها
Dialogue: 0,1:24:41.91,1:24:44.91,Default,,0,0,0,,‫حين فشلتَ في العثور على الكنز!
Dialogue: 0,1:24:44.91,1:24:47.31,Default,,0,0,0,,‫ستدفع ثمن ما فعلته!
Dialogue: 0,1:24:47.31,1:24:49.21,Default,,0,0,0,,‫جرائم سطو؟
Dialogue: 0,1:24:49.21,1:24:50.51,Default,,0,0,0,,‫لا أعرف عمّا تتحدث!
Dialogue: 0,1:24:50.51,1:24:52.81,Default,,0,0,0,,‫لا فائدة من التمثيل!
Dialogue: 0,1:24:52.81,1:24:55.61,Default,,0,0,0,,‫لدينا صوتك مسجّلًا… بالصدفة،
Dialogue: 0,1:24:55.61,1:24:57.41,Default,,0,0,0,,‫إذ سجّلته الضحية على جهاز الردّ الآلي،
Dialogue: 0,1:24:57.41,1:24:59.31,Default,,0,0,0,,‫ولدينا أيضًا بصمة يدك على الهاتف
Dialogue: 0,1:24:59.31,1:25:02.01,Default,,0,0,0,,‫عندما أغلقتَ السماعة!
Dialogue: 0,1:25:02.01,1:25:04.61,Default,,0,0,0,,‫لا شفقة لمن خان أصدقاءه.
Dialogue: 0,1:25:04.61,1:25:06.41,Default,,0,0,0,,‫إن كنت لا تريد أن تُصاب…
Dialogue: 0,1:25:06.41,1:25:08.91,Default,,0,0,0,,‫فامشِ بهدوء ودعنا نضع القيود في يديك!
Dialogue: 0,1:25:21.41,1:25:25.71,Default,,0,0,0,,‫وهكذا… القضية التي امتدت 13 عامًا
Dialogue: 0,1:25:25.71,1:25:30.31,Default,,0,0,0,,‫حُلّت شخصيًا على يد قائد شرطة محافظة أوساكا
Dialogue: 0,1:25:30.31,1:25:33.11,Default,,0,0,0,,‫بينما كنا ننظر بدهشة،
Dialogue: 0,1:25:33.11,1:25:35.81,Default,,0,0,0,,‫كل شيء حدث في لمح البصر.
Dialogue: 0,1:27:20.61,1:27:23.11,Default,,0,0,0,,‫لا بد أنك تشعر بالرضا عن هذا.
Dialogue: 0,1:27:23.11,1:27:25.01,Default,,0,0,0,,‫أرسلتَ لكلّ واحدٍ منا قطعةً من ذلك الفخار،
Dialogue: 0,1:27:25.01,1:27:27.91,Default,,0,0,0,,‫واصطدتنا بحديثك عن لفافة النمر،
Dialogue: 0,1:27:27.91,1:27:31.21,Default,,0,0,0,,‫وكنت تعلم أن ذلك سيدفعنا للانضمام إلى الرحلة.
Dialogue: 0,1:27:31.21,1:27:36.01,Default,,0,0,0,,‫نجحتَ في الثأر لجدّك بضربة واحدة.
Dialogue: 0,1:27:36.01,1:27:37.01,Default,,0,0,0,,‫وفوق هذا،
Dialogue: 0,1:27:37.01,1:27:41.61,Default,,0,0,0,,‫صار كنز هيديوشي ملكًا لعائلتك وحدها.
Dialogue: 0,1:27:42.71,1:27:46.21,Default,,0,0,0,,‫لم تكن تلك خريطة كنز أصلًا.
Dialogue: 0,1:27:46.21,1:27:47.71,Default,,0,0,0,,‫ماذا تقصد؟
Dialogue: 0,1:27:47.71,1:27:51.11,Default,,0,0,0,,‫هذا ما كان مكتوبًا على لفافة النمر.
Dialogue: 0,1:27:51.11,1:27:52.81,Default,,0,0,0,,‫"أُقرّ بموجب هذا بأنني استلمتُ
Dialogue: 0,1:27:52.81,1:27:55.81,Default,,0,0,0,,‫الألف قطعة المرسومة على لفافة التنّين،
Dialogue: 0,1:27:55.81,1:27:57.31,Default,,0,0,0,,‫من كاجيسوكي."
Dialogue: 0,1:27:57.31,1:28:01.31,Default,,0,0,0,,‫كاجيسوكي؟ أليس هو اللص الذي كان يطارد ذهب هيديوشي،
Dialogue: 0,1:28:01.31,1:28:04.61,Default,,0,0,0,,‫الذي نزل إلى بئر كينمييسوي؟
Dialogue: 0,1:28:04.61,1:28:05.81,Default,,0,0,0,,‫نعم، هو.
Dialogue: 0,1:28:05.81,1:28:09.71,Default,,0,0,0,,‫كاجيسوكي ترك تلك الرسالة على سبيل المزاح.
Dialogue: 0,1:28:09.71,1:28:15.01,Default,,0,0,0,,‫إذًا لماذا لم يخبرنا جدّك بذلك؟
Dialogue: 0,1:28:15.01,1:28:17.61,Default,,0,0,0,,‫لم يستطع.
Dialogue: 0,1:28:17.61,1:28:19.01,Default,,0,0,0,,‫ليس لأصدقائه الذين كانوا متحمسين جدًا
Dialogue: 0,1:28:19.01,1:28:21.31,Default,,0,0,0,,‫للعثور على الكنز…
Dialogue: 0,1:28:21.31,1:28:25.81,Default,,0,0,0,,‫وخاصةً أنتَ الذي استثمرتَ الكثير من المال في المشروع.
Dialogue: 0,1:28:29.01,1:28:31.51,Default,,0,0,0,,‫هذا سخيف.
Dialogue: 0,1:28:43.81,1:28:47.01,Default,,0,0,0,,‫ماذا؟ كنّا طُعمًا؟
Dialogue: 0,1:28:47.01,1:28:50.31,Default,,0,0,0,,‫نعم… هذا ما قاله والدك.
Dialogue: 0,1:28:50.31,1:28:52.21,Default,,0,0,0,,‫آسف يا كونان…
Dialogue: 0,1:28:52.21,1:28:55.61,Default,,0,0,0,,‫لكن رجاله محترفون… يميّزون الشرطي من بعيد.
Dialogue: 0,1:28:55.61,1:28:57.31,Default,,0,0,0,,‫ولكي نحل القضية بأسرع ما يمكن،
Dialogue: 0,1:28:57.31,1:29:01.31,Default,,0,0,0,,‫رأيتُ أن الأفضل هو مراقبة هيجي فقط،
Dialogue: 0,1:29:01.31,1:29:05.01,Default,,0,0,0,,‫لأنه دائمًا يتهوّر ويخاطر.
Dialogue: 0,1:29:05.01,1:29:06.21,Default,,0,0,0,,‫والآن فهمتَ.
Dialogue: 0,1:29:06.21,1:29:08.11,Default,,0,0,0,,‫يعني ضربني ليُغضبني
Dialogue: 0,1:29:08.11,1:29:11.11,Default,,0,0,0,,‫لأنه يعرف أنني سأخاطر؟
Dialogue: 0,1:29:11.11,1:29:12.21,Default,,0,0,0,,‫نعم.
Dialogue: 0,1:29:12.21,1:29:16.01,Default,,0,0,0,,‫قال إنه كان يعرف أن كثيرًا من أعوان السيد كاسويا سيأتون إلى هنا،
Dialogue: 0,1:29:16.01,1:29:18.41,Default,,0,0,0,,‫لأنك تحتاج إلى عدد كبير من الرجال
Dialogue: 0,1:29:18.41,1:29:20.21,Default,,0,0,0,,‫لنقل ألف قرعة ذهبية.
Dialogue: 0,1:29:20.21,1:29:22.41,Default,,0,0,0,,‫لكن قبل أن أتورّط،
Dialogue: 0,1:29:22.41,1:29:24.01,Default,,0,0,0,,‫المفتش أوتاكي، الذي كان يراقب المكان،
Dialogue: 0,1:29:24.01,1:29:26.11,Default,,0,0,0,,‫أدخلني تحت الحماية.
Dialogue: 0,1:29:26.11,1:29:28.91,Default,,0,0,0,,‫مهلًا! قلتَ "يراقب"…
Dialogue: 0,1:29:28.91,1:29:31.81,Default,,0,0,0,,‫هل يعني هذا أن أبي كان يعرف أن السيد واكيساكا هو القاتل؟
Dialogue: 0,1:29:31.81,1:29:34.71,Default,,0,0,0,,‫نعم. عندما استجوب الناس في موقع الحادث
Dialogue: 0,1:29:34.71,1:29:36.01,Default,,0,0,0,,‫وعرف أن السيد كاتو أمسك بالمظلّة،
Dialogue: 0,1:29:36.01,1:29:39.61,Default,,0,0,0,,‫أمر أحدهم بتعقّب السيد واكيساكا.
Dialogue: 0,1:29:39.61,1:29:42.81,Default,,0,0,0,,‫يا له من أبٍ ماكرٍ بعينين ضيّقتين!
Dialogue: 0,1:29:43.71,1:29:45.51,Default,,0,0,0,,‫إن حاول حركة كهذه مرة أخرى،
Dialogue: 0,1:29:45.51,1:29:47.01,Default,,0,0,0,,‫سأدخل إصبعي في أذنه
Dialogue: 0,1:29:47.01,1:29:49.61,Default,,0,0,0,,‫وأحرّكه حتى لا يستطيع الكلام!
Dialogue: 0,1:29:50.81,1:29:52.21,Default,,0,0,0,,‫آه!
Dialogue: 0,1:29:52.21,1:29:55.81,Default,,0,0,0,,‫شيزو… ألا تستطيعين أن تفعليها بلطفٍ قليلًا؟
Dialogue: 0,1:29:55.81,1:29:58.01,Default,,0,0,0,,‫لا تتذمّر.
Dialogue: 0,1:29:58.01,1:30:01.11,Default,,0,0,0,,‫أنا أردّ لك الصاع… لأنك سببتَ لهيجي الكثير.
Dialogue: 0,1:30:04.36,1:30:06.48,Default,,0,0,0,,‫تلميح كونان القادم:
Dialogue: 0,1:30:06.78,1:30:08.46,Default,,0,0,0,,‫"الهاتف المحمول"
