Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,100)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NX : @ABOODY_SUBS\NX : @Theconansign
Dialogue: 0,0:00:06.35,0:00:09.53,Default,,0,0,0,,تاكيشي! تاكيشي، هل أنت هناك؟
Dialogue: 0,0:00:09.53,0:00:12.03,Default,,0,0,0,,!تاكيشي! أين أنت؟
Dialogue: 0,0:00:14.61,0:00:16.54,Default,,0,0,0,,إذن؟ هل وجدته؟
Dialogue: 0,0:00:16.54,0:00:19.33,Default,,0,0,0,,.لا. لم يكن هنا
Dialogue: 0,0:00:19.33,0:00:21.04,Default,,0,0,0,,!يا رفاق
Dialogue: 0,0:00:22.28,0:00:23.54,Default,,0,0,0,,.سيدي الكاهن
Dialogue: 0,0:00:23.54,0:00:27.05,Default,,0,0,0,,.لا فائدة. لم يكن في الأعلى أيضًا
Dialogue: 0,0:00:27.05,0:00:30.61,Default,,0,0,0,,تبًا. إلى أين ذهب تاكيشي؟
Dialogue: 0,0:00:33.34,0:00:35.06,Default,,0,0,0,,...هذا الصوت
Dialogue: 0,0:00:35.45,0:00:37.43,Default,,0,0,0,,أوراشيما تارو؟
Dialogue: 0,0:00:37.93,0:00:39.56,Default,,0,0,0,,مهلا! ما هذا؟
Dialogue: 0,0:00:41.60,0:00:42.81,Default,,0,0,0,,.إنه قارب
Dialogue: 0,0:00:49.01,0:00:50.79,Default,,0,0,0,,تـ-تاكيشي؟
Dialogue: 0,0:00:51.56,0:00:53.19,Default,,0,0,0,,!تاكيشي
Dialogue: 0,0:00:53.68,0:00:57.70,Default,,0,0,0,,{\an8}لـ-لماذا شعره أبيض كالثلج؟
Dialogue: 0,0:00:55.70,0:00:57.70,sign_suspect,SIGN,0,0,0,,{\pos(321,256)}(25)ياماوكا تاكيشي 
Dialogue: 0,0:00:55.70,0:00:57.70,sign_suspect,SIGN,0,0,0,,{\fs14\pos(321,273)}صياد سمك
Dialogue: 0,0:00:57.70,0:01:00.65,Default,,0,0,0,,.انظر قرب قدميه. هناك صندوق مجوهرات
Dialogue: 0,0:01:03.21,0:01:07.71,Default,,0,0,0,,!تـ-تاكيشي فتح صندوق المجوهرات
Dialogue: 0,0:01:16.90,0:01:19.31,Default,,0,0,0,,ماذا تخفي تحت ذلك الوجه البارد؟
Dialogue: 0,0:01:19.31,0:01:20.98,Default,,0,0,0,,!صندوق المجوهرات لا يجب أن يُفتح أبدًا
Dialogue: 0,0:01:20.98,0:01:23.48,Default,,0,0,0,,!لحن يعبر عبر بحر هادئ
Dialogue: 0,0:01:23.48,0:01:24.98,Default,,0,0,0,,يسعى وراء الحقيقة دائما
Dialogue: 0,0:01:24.98,0:01:26.90,Default,,0,0,0,,،بجسد طفل وعقل بالغ
Dialogue: 0,0:01:26.90,0:01:29.31,Default,,0,0,0,,!اسمه المحقق كونان
Dialogue: 0,0:01:29.85,0:01:32.94,DCOpening,,0,0,0,,!جدي، فضولي، غامض، يقودنا نحو المستقبل
Dialogue: 0,0:01:32.94,0:01:36.26,DCOpening,,0,0,0,,بالتأكيد يمكنك كشف هذه الأجزاء الملونة التي تحوم حول قلبي ، أليس كذلك؟
Dialogue: 0,0:01:36.26,0:01:37.93,DCOpening,,0,0,0,,هذا الوجه البارد
Dialogue: 0,0:01:37.93,0:01:39.47,DCOpening,,0,0,0,,لا يمكنك خداع عيناي
Dialogue: 0,0:01:39.47,0:01:40.74,DCOpening,,0,0,0,,لا يمكنك الهروب من قدرك
Dialogue: 0,0:01:40.74,0:01:42.74,DCOpening,,0,0,0,,...لذا اتبعني اتبعني اتبعني
Dialogue: 0,0:01:42.74,0:01:43.60,DCOpening,,0,0,0,,لكنك بطريق الخطأ وبخبث
Dialogue: 0,0:01:43.60,0:01:45.94,DCOpening,,0,0,0,,,أمسكت بالدليل، انظر
Dialogue: 0,0:01:45.94,0:01:49.36,DCOpening,,0,0,0,,لا أستطيع التوقف الآن، أريد أن أتعقبه حتى النهاية
Dialogue: 0,0:01:49.36,0:01:52.45,DCOpening,,0,0,0,,لن أخيب ظن أحد لا تستخف بي كمجرد صبي
Dialogue: 0,0:01:52.44,0:01:55.61,DCOpening,,0,0,0,,هذه المفاهيم المسبقة ليست سوى خدع طفولية
Dialogue: 0,0:01:55.82,0:01:58.67,DCOpening,,0,0,0,,أعلم أنك تريدني، ولن أخذلك أبدًا
Dialogue: 0,0:01:58.68,0:02:01.66,DCOpening,,0,0,0,,في الحقيقة...
Dialogue: 0,0:02:02.16,0:02:05.40,DCOpening,,0,0,0,,أعلم أنك تكرهني ومع ذلك، لم أستطع لن أتركك أبدًا
Dialogue: 0,0:02:05.40,0:02:09.04,DCOpening,,0,0,0,,أرني مشاعرك الحقيقية؟
Dialogue: 0,0:02:09.87,0:02:10.75,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:02:16.40,0:02:17.89,DCOpening,,0,0,0,,!انطلق
Dialogue: 0,0:02:23.01,0:02:26.56,DCOpening,,0,0,0,,النهاية السعيدة المثالية
Dialogue: 0,0:02:26.56,0:02:29.65,DCOpening,,0,0,0,,ابتسامة لتجنب الألم، قلبي ينفتح عند 4869
Dialogue: 0,0:02:29.64,0:02:33.19,DCOpening,,0,0,0,,قبلة سرية أطلقت في البحر مشاعر ما زالت تحتل قلبي
Dialogue: 0,0:02:33.19,0:02:36.48,DCOpening,,0,0,0,,افتح قلبي أيضًا أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:41.30,0:02:43.62,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:47.77,0:02:49.77,DCOpening,,0,0,0,,أخبرني أسرارك، وجهك البارد
Dialogue: 0,0:02:53.99,0:02:54.66,DCOpening,,0,0,0,,!لننطلق
Dialogue: 0,0:03:10.96,0:03:16.97,sign_episode_title,SIGN,0,0,0,,{\fad(400,1)}السطح الزجاجي للماء - الجزء الأول
Dialogue: 0,0:03:11.38,0:03:14.21,Default,,0,0,0,,"!السطح الزجاجي للماء، الجزء الأول"
Dialogue: 0,0:03:16.97,0:03:19.97,sign_1174_agency,SIGN,0,0,0,,{\pos(250,235)\an8\frz14\t(\frz14,\frz17)\frx15\fry-5\fscx100\fax-0.5}وكالة موري للتحقيقات
Dialogue: 0,0:03:18.01,0:03:19.97,Default,,0,0,0,,{\an8}،أنت مجددًا
Dialogue: 0,0:03:19.97,0:03:21.77,Default,,0,0,0,,{\an8}أيها المحامي؟
Dialogue: 0,0:03:20.47,0:03:24.48,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(320,255)}(36) أوى هيروكي
Dialogue: 0,0:03:20.47,0:03:24.48,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(320,272)}محامي
Dialogue: 0,0:03:21.77,0:03:24.62,Default,,0,0,0,,{\an8}.سررت بلقائك مجددًا، أيها المحقق موري
Dialogue: 0,0:03:24.62,0:03:28.54,Default,,0,0,0,,.أهلاً بالمحقق الصغير وابنتك أيضًا
Dialogue: 0,0:03:28.54,0:03:30.36,Default,,0,0,0,,.سررنا بلقائك مجددًا
Dialogue: 0,0:03:30.80,0:03:35.99,Default,,0,0,0,,.من الأفضل ألا تجلب المتاعب إلى عتبة داري مجددًا
Dialogue: 0,0:03:35.99,0:03:39.99,Default,,0,0,0,,...لا أعرف إن كانت متاعب، لكن
Dialogue: 0,0:03:39.99,0:03:41.99,sign_1174_book,SIGN,0,0,0,,{\fad(500,1)\frz-65\fax-0.2\pos(410,155)\3c&HEBEAE2&}أوراشيما تارو
Dialogue: 0,0:03:42.70,0:03:44.51,Default,,0,0,0,,أوراشيما تارو؟
Dialogue: 0,0:03:44.51,0:03:45.65,Default,,0,0,0,,.نعم
Dialogue: 0,0:03:45.65,0:03:50.89,Default,,0,0,0,,.لقد جئت بخصوص قضية يُشاع أن سببها لعنة أوراشيما تارو
Dialogue: 0,0:03:55.08,0:04:00.39,Default,,0,0,0,,.موكلي هو السيد تسوجي كانتا، مقيم في بلدة مينائية في شمال كيوتو
Dialogue: 0,0:04:01.05,0:04:06.48,Default,,0,0,0,,.يريد منك حل جريمة قتل وقعت قبل أسبوعين
Dialogue: 0,0:04:08.66,0:04:14.40,Default,,0,0,0,,ألم يُؤخذ أوراشيما تارو إلى قصر روح التنين من قبل السلحفاة التي أنقذها؟
Dialogue: 0,0:04:14.81,0:04:19.68,Default,,0,0,0,,.لكي يشكروه، أقاموا مأدبة بالفرح والغناء
Dialogue: 0,0:04:20.86,0:04:25.14,Default,,0,0,0,,،عندما عاد إلى قريته، لسبب ما، مرت قرون
Dialogue: 0,0:04:25.14,0:04:27.66,Default,,0,0,0,,.وكل عائلته وأصدقاؤه كانوا قد رحلوا
Dialogue: 0,0:04:27.66,0:04:29.42,Default,,0,0,0,,.هكذا تسير الحكاية الخرافية
Dialogue: 0,0:04:29.81,0:04:34.80,Default,,0,0,0,,ولكن ما هي لعنة أوراشيما تارو؟
Dialogue: 0,0:04:37.80,0:04:40.38,sign_1174_inn,SIGN,0,0,0,,{\xshad-2\fad(1,500)\frz-11\fry5\fax0.2\an7\pos(420,150)\fnGeorgia}ياماتويا
Dialogue: 0,0:04:38.75,0:04:42.80,Default,,0,0,0,,.أهلاً بك، أيها المحقق العظيم السيد موري كوغورو
Dialogue: 0,0:04:43.18,0:04:44.76,Default,,0,0,0,,.من هنا
Dialogue: 0,0:04:47.39,0:04:49.44,Default,,0,0,0,,!رائع
Dialogue: 0,0:04:49.99,0:04:52.06,Default,,0,0,0,,.المحيط على مقربة منا
Dialogue: 0,0:04:53.03,0:05:00.50,Default,,0,0,0,,.هذا المبنى هو مركب مُعاد تجديده حيث كانت تُخزن القوارب سابقًا
Dialogue: 0,0:05:00.50,0:05:02.44,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:05:02.44,0:05:06.87,Default,,0,0,0,,.على أي حال، كل المباني في هذه المنطقة بُنيت بشكل مشابه
Dialogue: 0,0:05:06.87,0:05:09.05,Default,,0,0,0,,ألا تصطدم الأمواج بها؟
Dialogue: 0,0:05:09.05,0:05:10.19,Default,,0,0,0,,.لا
Dialogue: 0,0:05:10.19,0:05:15.98,Default,,0,0,0,,.البحر هنا محاط بجبال من ثلاث جهات، ولا تكاد توجد أي رياح
Dialogue: 0,0:05:15.98,0:05:20.10,Default,,0,0,0,,،بالاضافة الى ذلك، تلك الجزيرة المهجورة تؤدي دور سور بحري طبيعي
Dialogue: 0,0:05:20.10,0:05:22.47,Default,,0,0,0,,.لذلك فإن الماء هادئ جدًا
Dialogue: 0,0:05:22.47,0:05:27.10,Default,,0,0,0,,لهذا تمكنوا من بناء منازل ملاصقة للماء مباشرة، أليس كذلك؟
Dialogue: 0,0:05:27.10,0:05:28.51,Default,,0,0,0,,.نعم
Dialogue: 0,0:05:28.51,0:05:31.06,Default,,0,0,0,,،لأنه لا يوجد الكثير من الأرض المسطحة هنا
Dialogue: 0,0:05:31.06,0:05:37.48,Default,,0,0,0,,.انتهى الأمر بالناس لبناء هذه المراكب ذات التصميم الفريد
Dialogue: 0,0:05:38.17,0:05:40.82,Default,,0,0,0,,.لكن الأمر ليس فقط الخط الساحلي
Dialogue: 0,0:05:40.82,0:05:44.56,Default,,0,0,0,,المدينة بأكملها لها سحرها، ألا تظن ذلك؟
Dialogue: 0,0:05:45.76,0:05:47.37,Default,,0,0,0,,.والآن يا سيد موري
Dialogue: 0,0:05:47.87,0:05:51.87,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\pos(333,231)}(25) تسوجي كانتا 
Dialogue: 0,0:05:47.87,0:05:51.87,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(333,248)}مدير النزل
Dialogue: 0,0:05:47.87,0:05:51.87,Default,,0,0,0,,{\an8}.لا تتردد في استخدام هذه الغرفة حتى تحل القضية
Dialogue: 0,0:05:51.87,0:05:53.92,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:05:53.92,0:05:57.00,Default,,0,0,0,,هل كنت في مكان الجريمة عندما حدثت؟
Dialogue: 0,0:05:57.00,0:05:59.51,Default,,0,0,0,,.ماذا؟ نعم، كنت هناك
Dialogue: 0,0:05:59.87,0:06:04.26,Default,,0,0,0,,هل يمكنك إخبارنا بما حدث، إذن؟
Dialogue: 0,0:06:04.26,0:06:05.46,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:06:06.06,0:06:11.98,Default,,0,0,0,,.بدأ الأمر عندما اختفى صديقي، ياماوكا تاكيشي
Dialogue: 0,0:06:13.77,0:06:17.02,Default,,0,0,0,,.لا فائدة. لم يكن في الأعلى أيضًا
Dialogue: 0,0:06:17.02,0:06:20.87,Default,,0,0,0,,تبًا. إلى أين ذهب تاكيشي؟
Dialogue: 0,0:06:23.38,0:06:25.03,Default,,0,0,0,,...هذا الصوت
Dialogue: 0,0:06:25.43,0:06:27.85,Default,,0,0,0,,أوراشيما تارو؟
Dialogue: 0,0:06:27.85,0:06:29.54,Default,,0,0,0,,مهلا! ما هذا؟
Dialogue: 0,0:06:31.66,0:06:33.79,Default,,0,0,0,,تـ-تاكيشي؟
Dialogue: 0,0:06:34.22,0:06:35.79,Default,,0,0,0,,!تاكيشي
Dialogue: 0,0:06:37.91,0:06:42.30,Default,,0,0,0,,!تـ-تاكيشي فتح صندوق المجوهرات
Dialogue: 0,0:06:46.55,0:06:52.05,sign_1174_uniform,SIGN,0,0,0,,{\pos(370,234)}ياماتويا
Dialogue: 0,0:06:46.99,0:06:49.32,Default,,0,0,0,,أصبح شعره أبيض كالثلج؟
Dialogue: 0,0:06:49.32,0:06:52.06,Default,,0,0,0,,أهذه هي لعنة أوراشيما تارو؟
Dialogue: 0,0:06:52.06,0:06:55.68,Default,,0,0,0,,.أيتها الغبية! هذا غير ممكن
Dialogue: 0,0:06:55.68,0:06:58.87,Default,,0,0,0,,لكن شعره أصبح أبيض كالثلج، صحيح؟
Dialogue: 0,0:06:58.87,0:07:00.82,Default,,0,0,0,,.وكأنه فتح صندوق المجوهرات
Dialogue: 0,0:07:00.82,0:07:05.16,Default,,0,0,0,,.انه الشخص على الأرجح أراد أن يجعل الجميع يصدقون أنها اللعنة
Dialogue: 0,0:07:05.16,0:07:06.82,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:07:07.12,0:07:13.70,Default,,0,0,0,,إذن، سيد تسوجي، هل لديك أي فكرة لماذا قُتل سيد ياماوكا؟
Dialogue: 0,0:07:14.64,0:07:16.46,Default,,0,0,0,,.ليس بالضبط
Dialogue: 0,0:07:17.14,0:07:19.96,Default,,0,0,0,,.هناك أربعة أشخاص أعتقد أنهم مثيرون للشك
Dialogue: 0,0:07:21.13,0:07:22.09,Default,,0,0,0,,أربعة؟
Dialogue: 0,0:07:22.62,0:07:26.22,Default,,0,0,0,,.أولاً، هناك الصياد، السيد ماتسوياما هيرونوبو
Dialogue: 0,0:07:27.09,0:07:30.85,sign_suspect,SIGN,0,0,0,,{\fad(1,500)\pos(251,230)}(28) ماتسوياما هيرونوبو 
Dialogue: 0,0:07:27.09,0:07:30.85,sign_suspect,SIGN,0,0,0,,{\fad(1,500)\fs14\pos(251,247)}صياد سمك
Dialogue: 0,0:07:27.59,0:07:29.76,Default,,0,0,0,,{\an8}تظن أن أنا من قتل تاكيشي؟
Dialogue: 0,0:07:29.76,0:07:31.10,Default,,0,0,0,,{\an8}.لابد أنك تمزح
Dialogue: 0,0:07:31.10,0:07:35.60,Default,,0,0,0,,.لكننا سمعنا أنكما تتشاجران كثيرًا
Dialogue: 0,0:07:35.88,0:07:37.84,Default,,0,0,0,,.نحن صيادون
Dialogue: 0,0:07:37.84,0:07:42.98,Default,,0,0,0,,.نحن دائمًا نفكر بجدية في صناعة الصيد في هذه البلدة
Dialogue: 0,0:07:42.98,0:07:46.29,Default,,0,0,0,,لذا كان من الطبيعي أن تتصادما؟
Dialogue: 0,0:07:46.29,0:07:51.37,Default,,0,0,0,,.ربما كان اتجاهه مختلفًا عن اتجاهي، لكنه ما زال يهتم بالبلدة
Dialogue: 0,0:07:52.34,0:07:57.87,Default,,0,0,0,,.أهل هذه البلدة دائمًا يبتكرون طرقًا جديدة للبقاء حتى الآن
Dialogue: 0,0:07:57.87,0:08:03.92,Default,,0,0,0,,.هذه المراكب هي ما توصلوا إليه بسبب نقص الأرض المسطحة
Dialogue: 0,0:08:03.92,0:08:07.88,Default,,0,0,0,,حسنًا إذن، لماذا لا تطورون تلك الجزيرة غير المأهولة؟
Dialogue: 0,0:08:08.24,0:08:10.64,Default,,0,0,0,,!تلك الجزيرة كانت دائمًا محظورة
Dialogue: 0,0:08:10.64,0:08:12.07,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:08:13.59,0:08:16.98,Default,,0,0,0,,.منذ فترة إيدو، تلك الجزيرة اعتُبرت مقدسة
Dialogue: 0,0:08:16.98,0:08:19.05,Default,,0,0,0,,.لا يُسمح لأحد بالاقتراب منها
Dialogue: 0,0:08:19.05,0:08:24.65,Default,,0,0,0,,.فهمت. إذن تلك الجزيرة هي مثل المعبد الحامي للبلدة
Dialogue: 0,0:08:24.65,0:08:30.16,Default,,0,0,0,,.نعم. إنها الجزيرة التي تحمينا من الأمواج
Dialogue: 0,0:08:30.16,0:08:32.39,Default,,0,0,0,,هل هناك شيء على الجزيرة؟
Dialogue: 0,0:08:32.39,0:08:38.54,Default,,0,0,0,,.لم أزرها أبدًا، لكن يجب أن يكون هناك نصب تذكاري لتكريم الصيادين الذين ماتوا في البحر
Dialogue: 0,0:08:40.04,0:08:47.05,Default,,0,0,0,,إن لم تكن أنت، فهل تعرف أي شخص آخر تجادل مع السيد ياماوكا؟
Dialogue: 0,0:08:47.41,0:08:50.63,Default,,0,0,0,,.هذه المراكب صُنعت للصيد
Dialogue: 0,0:08:52.28,0:08:54.20,Default,,0,0,0,,.هذا لا يجب أن يُنسى
Dialogue: 0,0:08:56.42,0:08:58.83,Default,,0,0,0,,.التالي، هناك نيشينو ميكو
Dialogue: 0,0:08:58.83,0:09:01.44,Default,,0,0,0,,.إنها تدير نزل أكاتسوكي
Dialogue: 0,0:09:01.44,0:09:04.02,Default,,0,0,0,,{\an8}بعدد سكان يبلغ 2000 فقط
Dialogue: 0,0:09:04.02,0:09:09.07,Default,,0,0,0,,{\an8}.وبدون محطة قطار، ازدهار هذه البلدة يعتمد على السياحة
Dialogue: 0,0:09:05.82,0:09:09.07,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\pos(320,255)}(26) نيشينو ميكو
Dialogue: 0,0:09:05.82,0:09:09.07,sign_suspect,SIGN,0,0,0,,{\fad(500,1)\fs14\pos(320,272)}مديرة نزل
Dialogue: 0,0:09:09.07,0:09:10.23,Default,,0,0,0,,.فهمت
Dialogue: 0,0:09:10.23,0:09:12.70,Default,,0,0,0,,.هذا نزل فاخر إلى حد ما
Dialogue: 0,0:09:12.96,0:09:16.72,Default,,0,0,0,,.إنه أشبه بفندق أجنبي أكثر من كونه نزل
Dialogue: 0,0:09:16.72,0:09:18.27,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:09:18.27,0:09:20.72,Default,,0,0,0,,.لا تترددون في النظر داخل المكان
Dialogue: 0,0:09:22.03,0:09:23.71,Default,,0,0,0,,!حمام مفتوح
Dialogue: 0,0:09:23.71,0:09:25.71,Default,,0,0,0,,!إنه فاخر جدًا
Dialogue: 0,0:09:26.46,0:09:28.96,Default,,0,0,0,,.نحن فخورون جدًا بحمامنا المفتوح
Dialogue: 0,0:09:29.54,0:09:35.01,Default,,0,0,0,,.هذا الحمام صممه معماري حديث ماهر
Dialogue: 0,0:09:35.01,0:09:38.47,Default,,0,0,0,,.تعالو واسترخو في مياهه في وقت ما
Dialogue: 0,0:09:38.47,0:09:41.62,Default,,0,0,0,,.لا أعرف إن كان لدينا المال لذلك
Dialogue: 0,0:09:41.62,0:09:44.98,Default,,0,0,0,,.لا بد أنك تجنين الكثير من المال هنا
Dialogue: 0,0:09:45.24,0:09:49.58,Default,,0,0,0,,.لحسن الحظ، هذه البلدة تتلقى الكثير من الاهتمام من العالم
Dialogue: 0,0:09:49.58,0:09:52.43,Default,,0,0,0,,.عدد السياح في تزايد
Dialogue: 0,0:09:52.43,0:09:55.24,Default,,0,0,0,,.هذه فرصة عمل
Dialogue: 0,0:09:55.24,0:09:58.24,sign_note,,0,0,0,,{\an7\pos(0,0)\fad(1,1)\fscx100\fscy100\p1\xshad-2\yshad2\bord0\c&HEAEBEB&\3c&HEAEBEB&\4c&H82917D&}m 460 10 l 630 10 630 70 460 70
Dialogue: 1,0:09:55.24,0:09:58.24,sign_1174_notice,SIGN,0,0,0,,{\pos(545,40)}.من فضلك لا تلمس
Dialogue: 0,0:09:55.24,0:09:58.24,Default,,0,0,0,,.لا يمكننا أن ندع ذلك يفوتنا
Dialogue: 0,0:09:58.24,0:10:02.47,Default,,0,0,0,,ألهذا السبب كنتِ أنتِ و السيد ياماوكا على خلاف مع بعضكما؟
Dialogue: 0,0:10:02.47,0:10:04.68,Default,,0,0,0,,...هو وأنا لم نكن حقًا
Dialogue: 0,0:10:04.68,0:10:06.75,Default,,0,0,0,,لم تكوني حقًا ماذا؟
Dialogue: 0,0:10:07.77,0:10:10.04,Default,,0,0,0,,.لم نكن على خلاف
Dialogue: 0,0:10:10.04,0:10:13.92,Default,,0,0,0,,.هو فقط كان زوج أختي سابقًا
Dialogue: 0,0:10:14.51,0:10:18.51,Default,,0,0,0,,.الثالثة هي توغاشي هيتومي، حبيبة تاكيشي السابقة
Dialogue: 0,0:10:19.06,0:10:22.17,Default,,0,0,0,,{\an8}رائع! أنت محقق؟
Dialogue: 0,0:10:21.77,0:10:25.77,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(309,231)}(24) توغاشي هيتومي 
Dialogue: 0,0:10:21.77,0:10:25.77,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(309,248)}مديرة مقهى
Dialogue: 0,0:10:22.17,0:10:24.06,Default,,0,0,0,,{\an8}!هذا رائع جدًا
Dialogue: 0,0:10:24.06,0:10:26.02,Default,,0,0,0,,{\an8}.إنه محفّز نوعًا ما
Dialogue: 0,0:10:26.75,0:10:31.09,Default,,0,0,0,,.رغم ما أبدو عليه، كنت أحلم بأن أصبح محققة عندما كنت طفلة
Dialogue: 0,0:10:31.50,0:10:33.53,Default,,0,0,0,,.يسعدني التعرف عليكِ
Dialogue: 0,0:10:34.02,0:10:39.47,Default,,0,0,0,,.تاكيشي وأنا كنا نتواعد، لكن ذلك كان منذ وقت طويل
Dialogue: 0,0:10:39.47,0:10:43.42,Default,,0,0,0,,...بالتأكيد، أنا حزينة جدًا الآن لأنه رحل، لكن
Dialogue: 0,0:10:43.42,0:10:46.80,Default,,0,0,0,,.آسفة. دعوني أنهي هذه
Dialogue: 0,0:10:48.57,0:10:50.80,Default,,0,0,0,,ما هذه ؟
Dialogue: 0,0:10:51.18,0:10:54.83,Default,,0,0,0,,.حلوى شرائح ذيل الصفاح والمحار الذي أطوره حاليًا
Dialogue: 0,0:10:54.83,0:10:59.68,Default,,0,0,0,,.إنها حلوى خاصة مصنوعة من المحار المقلي، شرائح ذيل الصفاح، والبطاطس المهروسة
Dialogue: 0,0:11:01.68,0:11:05.58,Default,,0,0,0,,.الشرائح والشوكولاتة يتماشيان جيدًا معًا، في الواقع
Dialogue: 0,0:11:09.26,0:11:12.94,Default,,0,0,0,,بالمناسبة، لماذا انفصلتما؟
Dialogue: 0,0:11:14.04,0:11:15.76,Default,,0,0,0,,.فقط لأن
Dialogue: 0,0:11:15.76,0:11:18.45,Default,,0,0,0,,.أو ربما كان بسبب الأجواء في هذه البلدة
Dialogue: 0,0:11:18.74,0:11:20.07,Default,,0,0,0,,ماذا تعنين؟
Dialogue: 0,0:11:20.07,0:11:25.96,Default,,0,0,0,,.صناعتي الصيد والسياحة قسمتا البلدة بأكملها إلى نصفين
Dialogue: 0,0:11:26.54,0:11:32.09,Default,,0,0,0,,.نحن لسنا روميو وجوليت، لكننا انفصلنا بسبب تلك الأجواء
Dialogue: 0,0:11:32.09,0:11:34.84,Default,,0,0,0,,الأجواء؟
Dialogue: 0,0:11:36.23,0:11:38.72,Default,,0,0,0,,.أخيرًا، هناك كاميكاوا أكيهيديه
Dialogue: 0,0:11:38.72,0:11:41.47,Default,,0,0,0,,.إنه الكاهن الرئيسي لمعبد أوراساوا
Dialogue: 0,0:11:39.18,0:11:41.47,sign_1174_shrine,SIGN,0,0,0,,{\fnGeorgia\b1\xshad-2\yshad-2\frz-6\fax0.1\an7\pos(339,157)\fad(800,500)}معبد أوراساوا
Dialogue: 0,0:11:43.47,0:11:47.98,Default,,0,0,0,,.كانت تلك بالتأكيد لعنة أوراشيما تارو
Dialogue: 0,0:11:47.98,0:11:52.48,Default,,0,0,0,,{\an8}.كان الأمر واضحًا من طريقة تغير مظهر تاكيشي
Dialogue: 0,0:11:48.23,0:11:52.23,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\pos(320,255)}(53)كاميكاوا أكيهيديه 
Dialogue: 0,0:11:48.23,0:11:52.23,sign_suspect,SIGN,0,0,0,,{\fad(500,500)\fs14\pos(320,272)}كاهن 
Dialogue: 0,0:11:52.85,0:11:55.42,Default,,0,0,0,,أوراشيما تارو؟
Dialogue: 0,0:11:55.42,0:12:01.80,Default,,0,0,0,,.صندوق المجوهرات ودرع السلحفاة الذي كان يرتديه تاكيشي سُرقا من هذا المعبد
Dialogue: 0,0:12:01.80,0:12:04.49,Default,,0,0,0,,.هذا وحده كان مشكلة كافية
Dialogue: 0,0:12:04.94,0:12:09.00,Default,,0,0,0,,هل لهذا المعبد صلة ما بأوراشيما تارو؟
Dialogue: 0,0:12:09.00,0:12:10.20,Default,,0,0,0,,.بالتأكيد
Dialogue: 0,0:12:10.20,0:12:15.94,Default,,0,0,0,,.معبد أوراساوا هو معبد قديم ومهيبًا مخصصًا لأوراشيما تارو
Dialogue: 0,0:12:15.94,0:12:21.51,Default,,0,0,0,,.يُقال إن أسطورة أوراشيما تارو نشأت في هذه الأرض
Dialogue: 0,0:12:21.51,0:12:26.02,Default,,0,0,0,,إذن، متى حدثت السرقة؟
Dialogue: 0,0:12:26.40,0:12:30.47,Default,,0,0,0,,قبل ثلاثة أيام من مقتل تاكيشي، لاحظت أن العناصر مفقودة
Dialogue: 0,0:12:30.47,0:12:32.85,Default,,0,0,0,,.وأبلغت الشرطة على الفور
Dialogue: 0,0:12:32.85,0:12:35.70,Default,,0,0,0,,.ظننت أنها مجرد مزحة
Dialogue: 0,0:12:35.70,0:12:39.15,Default,,0,0,0,,.لم أعتقد أبدًا أنها ستُستخدم بهذه الطريقة
Dialogue: 0,0:12:39.15,0:12:41.67,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:12:41.67,0:12:46.91,Default,,0,0,0,,هل لديك أي فكرة عمن قد يكون وراء السرقة أو القتل؟
Dialogue: 0,0:12:47.70,0:12:51.42,Default,,0,0,0,,هل يُعقل أنه لم يُخبرك أحد؟
Dialogue: 0,0:12:52.03,0:12:53.43,Default,,0,0,0,,ماذا تعني؟
Dialogue: 0,0:12:54.92,0:13:01.43,Default,,0,0,0,,.قبل أن يموت، كان تاكيشي يقول أن نيشينو ميكو ستقتله
Dialogue: 0,0:13:02.24,0:13:03.43,Default,,0,0,0,,!قال ماذا؟
Dialogue: 0,0:13:03.43,0:13:08.29,Default,,0,0,0,,.الأخ الأكبر لتاكيشي، كازؤو، كان متزوجًا ذات مرة من نيشينو ميكو
Dialogue: 0,0:13:08.29,0:13:14.94,Default,,0,0,0,,.لكن في يوم شتوي قبل أربع سنوات، ذهب كازؤو للصيد ولم يعد أبدًا
Dialogue: 0,0:13:15.37,0:13:19.77,Default,,0,0,0,,.اعتقدت الشرطة أنه يتعقّب سمكة ضخمة في مياه الخليج العاصفة
Dialogue: 0,0:13:19.77,0:13:24.85,Default,,0,0,0,,.وتعرض لحادث، لكن تاكيشي لم يصدق ذلك
Dialogue: 0,0:13:24.85,0:13:27.58,Default,,0,0,0,,.كازؤو كان يعرف هذه المياه مثل ظهر يده
Dialogue: 0,0:13:27.58,0:13:30.46,Default,,0,0,0,,.أصر على أنه لن يرتكب خطأً مثل ذلك
Dialogue: 0,0:13:30.85,0:13:32.31,Default,,0,0,0,,.لكن هذا ليس كل شيء
Dialogue: 0,0:13:32.31,0:13:35.84,Default,,0,0,0,,.بدأ يقول أن نيشينو ميكو فعلت ذلك
Dialogue: 0,0:13:35.84,0:13:38.84,Default,,0,0,0,,بمعنى آخر، قتلت أخاه الأكبر؟
Dialogue: 0,0:13:40.06,0:13:45.92,Default,,0,0,0,,.على الأرجح لم تعجبه الأشياء اليائسة التي قالتها في الجنازة
Dialogue: 0,0:13:45.92,0:13:49.85,Default,,0,0,0,,.منذ ذلك الحين، أصبحا لا يطيقان بعضهما البعض
Dialogue: 0,0:13:49.85,0:13:52.60,Default,,0,0,0,,ماذا تعني بيائسة؟
Dialogue: 0,0:13:52.60,0:13:56.01,Default,,0,0,0,,.قالت أن زوجها ذهب إلى قصر روح التنين
Dialogue: 0,0:13:56.01,0:13:57.42,Default,,0,0,0,,قصر روح التنين؟
Dialogue: 0,0:13:58.11,0:14:01.44,Default,,0,0,0,,،بصفتي كاهنًا
Dialogue: 0,0:14:01.44,0:14:07.62,Default,,0,0,0,,.أعتقد أن لعنة أوراشيما تارو تسببت في هذه الحادثة المؤسفة
Dialogue: 0,0:14:10.26,0:14:12.87,Default,,0,0,0,,.فهمت. هكذا إذن
Dialogue: 0,0:14:13.15,0:14:15.44,Default,,0,0,0,,.أقدر تعاونك
Dialogue: 0,0:14:15.44,0:14:16.88,Default,,0,0,0,,.انتظر لحظة
Dialogue: 0,0:14:17.13,0:14:18.61,Default,,0,0,0,,هل هناك شيء آخر؟
Dialogue: 0,0:14:19.21,0:14:24.51,Default,,0,0,0,,.صناديق المجوهرات المسروقة تأتي في مجموعة متطابقة: واحدة كبيرة وأخرى صغيرة
Dialogue: 0,0:14:24.51,0:14:28.08,Default,,0,0,0,,.الصغيرة لم نُعثر عليها بعد
Dialogue: 0,0:14:36.17,0:14:41.13,Default,,0,0,0,,،ذلك الكاهن دعاها لعنة
Dialogue: 0,0:14:41.13,0:14:44.78,Default,,0,0,0,,.لكنه ما زال يتصرف وكأن الأنسة ميكو هي الجانية
Dialogue: 0,0:14:44.78,0:14:46.12,Default,,0,0,0,,صحيح؟
Dialogue: 0,0:14:46.12,0:14:51.29,Default,,0,0,0,,هل ستفعل الأنسة ميكو شيئًا مثل ذلك عندما هذا ما يعتقده الناس عنها؟
Dialogue: 0,0:14:52.49,0:14:57.29,Default,,0,0,0,,.لكن هذا قد يعني أن شخصًا ما يحاول إلصاق التهمة بها
Dialogue: 0,0:14:57.79,0:15:02.42,Default,,0,0,0,,.لعنة أوراشيما تارو و نزاع يقسم البلدة إلى نصفين
Dialogue: 0,0:15:02.99,0:15:04.30,Default,,0,0,0,,.لا أرجو حدوث ذلك
Dialogue: 0,0:15:09.08,0:15:10.96,Default,,0,0,0,,.عمي، اختي ران
Dialogue: 0,0:15:10.96,0:15:12.86,Default,,0,0,0,,.لا تلتفتا، واستمعا فقط
Dialogue: 0,0:15:12.86,0:15:15.11,Default,,0,0,0,,.نعم، أحدهم يتبعنا
Dialogue: 0,0:15:15.11,0:15:16.31,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:15:16.31,0:15:18.31,Default,,0,0,0,,ماذا علينا أن نفعل يا عمي؟
Dialogue: 0,0:15:18.89,0:15:22.82,Default,,0,0,0,,.طبعًا، لاحظت ذلك من البداية، أيضًا
Dialogue: 0,0:15:23.14,0:15:24.82,Default,,0,0,0,,...ليس ما أقصده
Dialogue: 0,0:15:25.85,0:15:29.32,Default,,0,0,0,,.لندور حول تلك الزاوية ونمسك به
Dialogue: 0,0:15:30.29,0:15:31.33,Default,,0,0,0,,!الآن
Dialogue: 0,0:15:40.03,0:15:41.34,Default,,0,0,0,,!ها أنت ذا
Dialogue: 0,0:15:43.42,0:15:44.84,sign_1174_syrup,SIGN,0,0,0,,{\fs10\frz0\pos(393,135)\fad(500,1)}شراب الشوكولاتة
Dialogue: 0,0:15:44.84,0:15:46.84,Default,,0,0,0,,...هذا مؤلم
Dialogue: 0,0:15:47.25,0:15:48.70,Default,,0,0,0,,أنسة توغاشي؟
Dialogue: 0,0:15:49.46,0:15:50.84,Default,,0,0,0,,.لقد أخفتوني
Dialogue: 0,0:15:50.84,0:15:53.10,Default,,0,0,0,,.نحن من يجب أن يقول ذلك
Dialogue: 0,0:15:53.62,0:15:55.94,Default,,0,0,0,,لماذا كنتِ تتبعيننا؟
Dialogue: 0,0:15:55.94,0:15:59.10,Default,,0,0,0,,هل كنتِ تفعلين شيئًا مشبوهًا؟
Dialogue: 0,0:15:59.10,0:16:02.89,Default,,0,0,0,,.لا، لا. بالتأكيد لا
Dialogue: 0,0:16:02.89,0:16:04.36,Default,,0,0,0,,إذن، ما الذي كنتِ تفعلينه؟
Dialogue: 0,0:16:04.91,0:16:09.21,Default,,0,0,0,,.ظننت أنني قد أتمكن من المساعدة
Dialogue: 0,0:16:09.21,0:16:12.62,Default,,0,0,0,,.رغم ما أبدو عليه، أنا ماهرة جدًا في التخفي
Dialogue: 0,0:16:12.94,0:16:17.51,Default,,0,0,0,,إذن كنتِ تتجسسين على محادثتنا؟
Dialogue: 0,0:16:17.51,0:16:20.63,Default,,0,0,0,,.حسنًا، لأنني أردت مساعدتكم
Dialogue: 0,0:16:20.63,0:16:24.91,Default,,0,0,0,,.على الهواة الابتعاد عن شؤون المحققين
Dialogue: 0,0:16:24.91,0:16:26.32,Default,,0,0,0,,.ستتأذين إذا فعلت ذلك
Dialogue: 0,0:16:26.32,0:16:27.51,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:16:27.51,0:16:28.79,Default,,0,0,0,,.لنذهب
Dialogue: 0,0:16:31.39,0:16:32.86,Default,,0,0,0,,.أنا أمزح
Dialogue: 0,0:16:32.86,0:16:36.15,Default,,0,0,0,,.عليك أن تصدق أنني سأنتقم لحبيبي السابق
Dialogue: 0,0:16:36.89,0:16:37.64,sign_1174_syrup,SIGN,0,0,0,,{\fs14\frz-15\fax-0.1\pos(326,103)\fad(1,500)}شراب الشوكولاتة
Dialogue: 0,0:16:45.81,0:16:48.90,sign_1174_syrup,SIGN,0,0,0,,{\fs10\frz0\pos(163,168)\fad(500,1)}شراب الشوكولاتة
Dialogue: 0,0:16:46.62,0:16:48.90,Default,,0,0,0,,.تم رصد المشتبه به
Dialogue: 0,0:16:55.48,0:16:57.71,Default,,0,0,0,,أين كونان؟
Dialogue: 0,0:16:57.71,0:16:59.66,Default,,0,0,0,,.غالبًا في الحمام
Dialogue: 0,0:17:00.03,0:17:02.41,Default,,0,0,0,,مرحبا؟ أيها المحامي؟
Dialogue: 0,0:17:02.41,0:17:04.17,Default,,0,0,0,,.أهلاً، أيها المحقق
Dialogue: 0,0:17:04.17,0:17:06.05,Default,,0,0,0,,هل التحقيق يسير على ما يرام؟
Dialogue: 0,0:17:06.05,0:17:08.01,Default,,0,0,0,,.نحن نحقق بعض التقدم
Dialogue: 0,0:17:08.01,0:17:11.05,Default,,0,0,0,,.على أي حال، هناك شيء أريد معرفته
Dialogue: 0,0:17:11.05,0:17:13.80,Default,,0,0,0,,.حسنًا. اسألني أي شيء
Dialogue: 0,0:17:14.46,0:17:17.47,Default,,0,0,0,,أولاً، ما هو سبب وفاة السيد ياماوكا؟
Dialogue: 0,0:17:17.47,0:17:20.10,Default,,0,0,0,,.تسمم بواسطة سم عصبي
Dialogue: 0,0:17:20.10,0:17:24.27,Default,,0,0,0,,.وجدنا سم ضفدع داخل جسده
Dialogue: 0,0:17:24.27,0:17:26.44,Default,,0,0,0,,أي حمض نووي أو بصمات؟
Dialogue: 0,0:17:26.44,0:17:31.45,Default,,0,0,0,,.لسوء الحظ، وجدت فقط بصمات الضحية
Dialogue: 0,0:17:31.45,0:17:32.70,Default,,0,0,0,,.هذا متوقع
Dialogue: 0,0:17:32.70,0:17:36.06,Default,,0,0,0,,بالمناسبة، شعره صُبغ بالأبيض، صحيح؟
Dialogue: 0,0:17:36.06,0:17:39.72,Default,,0,0,0,,.أجل. تم تبييضه باستخدام شمع الشعر
Dialogue: 0,0:17:39.72,0:17:43.08,Default,,0,0,0,,هل تعتقد الشرطة أن الأنسة نيشينو فعلت ذلك؟
Dialogue: 0,0:17:43.08,0:17:48.91,Default,,0,0,0,,.نعم، لكن لا يوجد دليل، ولديها دليل براءة
Dialogue: 0,0:17:48.91,0:17:51.44,Default,,0,0,0,,هل دليل براءتها قاطع؟
Dialogue: 0,0:17:51.44,0:17:57.03,Default,,0,0,0,,شهد الناس بأنها كانت في النزل في كل من الوقت المقدر للوفاة
Dialogue: 0,0:17:57.03,0:18:00.60,Default,,0,0,0,,.وعندما عُثر على القارب الذي يحمل جثة السيد ياماوكا
Dialogue: 0,0:18:00.89,0:18:03.17,Default,,0,0,0,,،لكنها كانت شهادة موظفيها
Dialogue: 0,0:18:03.17,0:18:07.01,Default,,0,0,0,,.لذا من الممكن أنهم يحمون صاحبة العمل
Dialogue: 0,0:18:07.01,0:18:08.15,Default,,0,0,0,,...هكذا إذن
Dialogue: 0,0:18:08.15,0:18:09.41,Default,,0,0,0,,!يا كونان
Dialogue: 0,0:18:10.24,0:18:11.86,Default,,0,0,0,,.حان وقت العشاء
Dialogue: 0,0:18:11.86,0:18:13.36,Default,,0,0,0,,.حسنًا. سأأتي الآن
Dialogue: 0,0:18:13.86,0:18:16.02,Default,,0,0,0,,.سأتصل بك لاحقًا
Dialogue: 0,0:18:16.02,0:18:17.30,Default,,0,0,0,,.فهمت
Dialogue: 0,0:18:19.23,0:18:21.71,Default,,0,0,0,,.هذه شرائح ومحار نيء محلي
Dialogue: 0,0:18:21.71,0:18:24.12,Default,,0,0,0,,.كلو ما تريدون
Dialogue: 0,0:18:24.12,0:18:26.63,Default,,0,0,0,,!شكرًا على الطعام
Dialogue: 0,0:18:30.34,0:18:33.38,Default,,0,0,0,,!ماذا؟ هذه المحارات النيئة ممتلئة جدًا
Dialogue: 0,0:18:33.69,0:18:37.89,Default,,0,0,0,,!هذا الشرائح المسلوقة دهنية ومتماسكة
Dialogue: 0,0:18:37.89,0:18:40.14,Default,,0,0,0,,!إنه لذيذ جدًا
Dialogue: 0,0:18:44.67,0:18:46.40,Default,,0,0,0,,!لقد شبعت
Dialogue: 0,0:18:46.75,0:18:50.90,Default,,0,0,0,,بالمناسبة، سيد تسوجي، هل كنت تعرف الإشاعات حول الأنسة نيشينو؟
Dialogue: 0,0:18:50.90,0:18:53.10,Default,,0,0,0,,.ماذا؟، نعم
Dialogue: 0,0:18:53.10,0:18:57.04,Default,,0,0,0,,.كنت أعرف عن خصومتها مع تاكيشي
Dialogue: 0,0:18:57.04,0:18:59.41,Default,,0,0,0,,.كانت مشهورة في هذه البلدة
Dialogue: 0,0:18:59.71,0:19:03.41,Default,,0,0,0,,هل تعتقد أيضًا أن الأنسة نيشينو هي الجانية؟
Dialogue: 0,0:19:03.73,0:19:05.95,Default,,0,0,0,,.لا أعرف
Dialogue: 0,0:19:06.32,0:19:11.17,Default,,0,0,0,,،إذا قتلت الأنسة ميكو كازؤو كما ادعى تاكيشي
Dialogue: 0,0:19:11.58,0:19:14.95,Default,,0,0,0,,،فربما تريد إسكاته
Dialogue: 0,0:19:14.95,0:19:21.26,Default,,0,0,0,,.لكن نظرًا لمدى انتشار الإشاعات، ستكون المشتبه بها الرئيسية إذا مات تاكيشي
Dialogue: 0,0:19:21.67,0:19:27.68,Default,,0,0,0,,لماذا كان السيد ماتسوياما والسيد ياماوكا  يتشاجران؟
Dialogue: 0,0:19:28.62,0:19:31.69,Default,,0,0,0,,.بسبب المحار والشرائح الذي أكلتموه للتو
Dialogue: 0,0:19:32.21,0:19:35.35,Default,,0,0,0,,قال ماتسوياما أن الصيادين يحتاجون دخل مستقر
Dialogue: 0,0:19:35.35,0:19:40.83,Default,,0,0,0,,.وكان يخطط لزراعة المحار والشرائح لإنشاء علامته التجارية الخاصة
Dialogue: 0,0:19:41.47,0:19:44.79,Default,,0,0,0,,لكن تاكيشي أصر بعناد على المأكولات البحرية البرية
Dialogue: 0,0:19:44.79,0:19:48.42,Default,,0,0,0,,.ورفض المشاركة في الزراعة
Dialogue: 0,0:19:48.42,0:19:51.87,Default,,0,0,0,,.في النهاية، كان مشروع الزراعة نجاحًا كبيرًا
Dialogue: 0,0:19:51.87,0:19:55.84,Default,,0,0,0,,.تاكيشي كان الوحيد المُستبعد منه
Dialogue: 0,0:19:55.84,0:19:57.67,Default,,0,0,0,,.فهمت
Dialogue: 0,0:19:57.67,0:20:02.85,Default,,0,0,0,,.لكن من الصعب تصديق أن الجانب الذي نجح سيلجأ إلى الجريمة
Dialogue: 0,0:20:02.85,0:20:04.69,Default,,0,0,0,,.بالضبط
Dialogue: 0,0:20:04.69,0:20:07.75,Default,,0,0,0,,.أيضًا، الكاهن مثير للشك أيضًا
Dialogue: 0,0:20:07.75,0:20:13.11,Default,,0,0,0,,.صندوق المجوهرات ودرع السلحفاة الذي كان يرتديه تاكيشي كانا يخصان المعبد
Dialogue: 0,0:20:13.11,0:20:16.12,Default,,0,0,0,,.بمجرد أن تبدأ في البحث عن المشتبه بهم، فلا نهاية لهم
Dialogue: 0,0:20:18.11,0:20:19.52,Default,,0,0,0,,مرحبا؟
Dialogue: 0,0:20:19.52,0:20:22.28,Default,,0,0,0,,!إنها أنا، توغاشي. توغاشي هيتومي
Dialogue: 0,0:20:22.28,0:20:25.15,Default,,0,0,0,,.أوه، الفتاة من قبل
Dialogue: 0,0:20:25.15,0:20:27.00,Default,,0,0,0,,هل تحتاجين شيئًا؟
Dialogue: 0,0:20:27.00,0:20:30.93,Default,,0,0,0,,،بعد التطفل على محادثتكم من قبل
Dialogue: 0,0:20:30.93,0:20:34.00,Default,,0,0,0,,.انتابني شعور حدسي
Dialogue: 0,0:20:34.00,0:20:38.57,Default,,0,0,0,,،بحثت في بعض الاحتمالات، وبالصدفة المحضة
Dialogue: 0,0:20:38.57,0:20:40.76,Default,,0,0,0,,!يبدو أنني وجدت شيئًا
Dialogue: 0,0:20:40.76,0:20:43.92,Default,,0,0,0,,تقولين أنكِ وجدتِ شيئًا؟ ماذا وجدتِ؟
Dialogue: 0,0:20:43.92,0:20:45.77,Default,,0,0,0,,أليس واضحًا؟
Dialogue: 0,0:20:45.77,0:20:47.96,Default,,0,0,0,,!دليل إدانة
Dialogue: 0,0:20:47.96,0:20:50.89,Default,,0,0,0,,...رأيتهم يواجهون حائطًا ويتحدثون إلى
Dialogue: 0,0:20:53.92,0:20:55.89,Default,,0,0,0,,مرحبا، أنسة توغاشي؟
Dialogue: 0,0:20:55.89,0:20:58.28,Default,,0,0,0,,!هل هناك خطب ما؟ أنسة توغاشي
Dialogue: 0,0:20:58.28,0:21:00.02,Default,,0,0,0,,.تبًا. قطعت الخط
Dialogue: 0,0:21:00.02,0:21:01.11,Default,,0,0,0,,أبي؟
Dialogue: 0,0:21:01.11,0:21:02.28,Default,,0,0,0,,هل حدث شيء؟
Dialogue: 0,0:21:02.73,0:21:06.04,Default,,0,0,0,,.لست متأكدًا، لكن يبدو أن شيئًا حدث لأنسة توغاشي
Dialogue: 0,0:21:06.34,0:21:07.34,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:21:07.79,0:21:13.79,Default,,0,0,0,,!أنسة توغاشي! أنسة توغاشي! أنسة توغاشي
Dialogue: 0,0:21:13.79,0:21:15.46,Default,,0,0,0,,!أنسة توغاشي
Dialogue: 0,0:21:15.46,0:21:17.80,Default,,0,0,0,,أنسة توغاشي! أين أنتِ؟
Dialogue: 0,0:21:17.80,0:21:20.05,Default,,0,0,0,,!أنسة توغاشي
Dialogue: 0,0:21:22.41,0:21:24.76,Default,,0,0,0,,سيد ماتسوياما، هل وجدتها؟
Dialogue: 0,0:21:24.76,0:21:26.56,Default,,0,0,0,,لا. ماذا عنك؟
Dialogue: 0,0:21:26.56,0:21:30.81,Default,,0,0,0,,.لم نجدها بعد، لكنها لا يمكن أن تكون ذهبت بعيدًا
Dialogue: 0,0:21:33.31,0:21:34.79,Default,,0,0,0,,...هذا هو
Dialogue: 0,0:21:34.79,0:21:36.82,Default,,0,0,0,,.أوراشيما تارو
Dialogue: 0,0:21:37.12,0:21:38.19,Default,,0,0,0,,!هناك
Dialogue: 0,0:21:46.17,0:21:48.95,Default,,0,0,0,,!أنسة توغاشي! إذا كنتِ هناك، قولي شيئًا
Dialogue: 0,0:21:48.95,0:21:49.90,Default,,0,0,0,,!أنسة توغاشي
Dialogue: 0,0:21:49.90,0:21:50.78,Default,,0,0,0,,!أنسة توغاشي
Dialogue: 0,0:21:50.78,0:21:52.14,Default,,0,0,0,,!أنسة توغاشي
Dialogue: 0,0:21:52.14,0:21:53.05,Default,,0,0,0,,...توغا
Dialogue: 0,0:21:54.96,0:21:56.84,Default,,0,0,0,,!أنسة توغاشي
Dialogue: 0,0:21:57.29,0:21:58.21,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:21:58.21,0:21:59.46,Default,,0,0,0,,!تبًا
Dialogue: 0,0:22:08.25,0:22:10.04,DCEnding,,0,0,0,,!مرح! مرح! مرح
Dialogue: 0,0:22:12.43,0:22:18.64,DCEnding,,0,0,0,,قلبي ينبض بقوة قلبي ينبض بقوة أنا حقًا فضولي بشأن الحقيقة
Dialogue: 0,0:22:18.84,0:22:25.44,DCEnding,,0,0,0,,هل تحاول؟ من الصعب الكذب، أليس كذلك؟ يا! يا
Dialogue: 0,0:22:25.49,0:22:31.73,DCEnding,,0,0,0,,لاااا، أنا أفقد صوابي! هل من أحد يساعدني؟
Dialogue: 0,0:22:31.93,0:22:37.10,DCEnding,,0,0,0,,(كذبة أم حقيقة؟ لا أستطيع أن أقول (كل شيء أو لا شيء
Dialogue: 0,0:22:37.71,0:22:44.78,DCEnding,,0,0,0,,أنا في غاية الحب معك، أنا في غاية الحب معك
Dialogue: 0,0:22:44.93,0:22:51.47,DCEnding,,0,0,0,,يحب! هذا صحيح! سوف أتعرض لحروق شديدة
Dialogue: 0,0:22:51.63,0:22:58.80,DCEnding,,0,0,0,,تألق، ارقص معي، ارقص، ارقص، ارقص بابتسامة مبهرة
Dialogue: 0,0:22:59.97,0:23:06.14,DCEnding,,0,0,0,,أنسى الأشياء السيئة وأحبها، لا يمكن مساعدتها
Dialogue: 0,0:23:06.43,0:23:12.37,DCEnding,,0,0,0,,أنت وأنا وتلك الفتاة، إذا رقصنا، سنكون جميعًا سعداء
Dialogue: 0,0:23:12.81,0:23:18.98,DCEnding,,0,0,0,,تعال! تعال! أنت تتألق بشكل مشرق اليوم أيضًا
Dialogue: 0,0:23:19.63,0:23:24.62,DCEnding,,0,0,0,,!إنه أمر ممتع عندما يكون الجميع هناك، لذلك دعونا نذهب
Dialogue: 0,0:23:29.91,0:23:31.36,Default,,0,0,0,,.أبي، انظر
Dialogue: 0,0:23:31.36,0:23:35.39,Default,,0,0,0,,.هذا قارب شرطة محافظة كيوتو
Dialogue: 0,0:23:39.78,0:23:41.44,Default,,0,0,0,,!المفتش أيانوكوجي
Dialogue: 0,0:23:44.90,0:24:08.93,sign_episode_preview,SIGN,0,0,0,,في الحلقة القادمة 
Dialogue: 0,0:23:48.97,0:23:53.41,Default,,0,0,0,,إذن، هل تعلمت أي شيء جديد؟
Dialogue: 0,0:23:53.41,0:23:58.79,Default,,0,0,0,,.السيد ياماوكا تاكيشي أخبر الجميع أنكِ قد تقتلينه
Dialogue: 0,0:23:58.79,0:24:02.01,Default,,0,0,0,,.يُزعم أن الجزيرة كانت مغلقة لفترة طويلة
Dialogue: 0,0:24:02.01,0:24:05.17,Default,,0,0,0,,إنها المكان المثالي لفعل شيء سري، ألا تظن ذلك؟
Dialogue: 0,0:24:05.51,0:24:08.93,Default,,0,0,0,,.لنذهب لنرى ما هناك
Dialogue: 0,0:24:08.93,0:24:14.93,sign_next_episode,SIGN,0,0,0,,{\pos(320,45)}السطح الزجاجي للماء - الجزءا الثاني
Dialogue: 0,0:24:09.48,0:24:13.77,Default,,0,0,0,,"!الحلقة القادمة من كونان هي "السطح الزجاجي للماء، الجزء الثاني
Dialogue: 0,0:24:29.95,0:24:32.43,Default,,0,0,0,,: تلميح كونان القادم
Dialogue: 0,0:24:29.95,0:24:34.87,sign_hint,SIGN,0,0,0,,{\pos(325,225)}‏كائنات البحر المضيئة
Dialogue: 0,0:24:32.43,0:24:34.34,Default,,0,0,0,,!‏كائنات البحر المضيئة
Dialogue: 0,0:24:34.87,0:24:36.69,Default,,0,0,0,,{\an8}أجلت ذلك السنجاب معك مجددًا؟
Dialogue: 0,0:24:34.87,0:24:39.87,sign_dont_miss,SIGN,0,0,0,,{\pos(245,304)}لا تفوتوا الحلقة القادمة
Dialogue: 0,0:24:36.69,0:24:37.98,Default,,0,0,0,,{\an8}.اسمه مارو
Dialogue: 0,0:24:37.98,0:24:38.75,Default,,0,0,0,,{\an8}.بالفعل
Dialogue: 0,0:24:38.75,0:24:39.83,Default,,0,0,0,,{\an8}.أهلاً
