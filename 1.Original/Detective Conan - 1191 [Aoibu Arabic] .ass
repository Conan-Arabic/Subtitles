Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs20\pos(100,130)} ABOODY SUBS | ترجمة \NTheconansign : محاكاة\NCodeSubs : تنظيم ملف الترجمة \N X : @ABOODY_SUBS \NX : @Theconansign\NX :CodeSubs
Dialogue: 0,0:00:01.87,0:00:05.07,Default,,0,0,0,,جئنا إلى ينابيع ميساسا الساخنة في محافظة توتوري
Dialogue: 0,0:00:05.07,0:00:07.67,Default,,0,0,0,,في جولة لمناطق الينابيع الساخنة في منطقة سانين
Dialogue: 0,0:00:08.10,0:00:10.87,Default,,0,0,0,,‫حيث صادفنا حبيبين ينتميان للمنطقة.
Dialogue: 0,0:00:10.87,0:00:13.49,sign_suspect,SIGN,0000,0000,0000,,{\pos(180,290)}(22) أوتسوبوكي ياسوتو 
Dialogue: 0,0:00:10.87,0:00:13.49,sign_suspect,SIGN,0000,0000,0000,,{\pos(475,290)}(22) يوميميا ساتشيو 
Dialogue: 0,0:00:11.64,0:00:14.13,Default,,0,0,0,,{\an8}كانا قد أقسما على الزواج من بعضهما البعض
Dialogue: 0,0:00:14.13,0:00:16.87,Default,,0,0,0,,‫لكن عمتها وأبوه كانا يعارضان ذلك بشدة.{\an8}
Dialogue: 0,0:00:14.79,0:00:16.20,sign_suspect,SIGN,0000,0000,0000,,{\pos(390,269)\fad(1,500)}(58) أوتسوبوكي هيساو 
Dialogue: 0,0:00:17.54,0:00:20.37,Default,,0,0,0,,‫في صباح اليوم التالي، في النُزل...
Dialogue: 0,0:00:18.54,0:00:20.37,sign_suspect,SIGN,0000,0000,0000,,{\pos(404,184)}(27) يوميميا تيروكي
Dialogue: 0,0:00:20.37,0:00:22.54,Default,,0,0,0,,{\an8}الأنسة ساتشيو مفقودة؟
Dialogue: 0,0:00:20.37,0:00:22.54,sign_suspect,SIGN,0000,0000,0000,,{\pos(455,268)}(59) يوميميا كازوكو 
Dialogue: 0,0:00:23.26,0:00:27.51,Default,,0,0,0,,‫بحثنا عن الأنسة ساتشيو في كل مكان، وبعد ذلك...
Dialogue: 0,0:00:27.51,0:00:29.88,Default,,0,0,0,,هي في الحقيقة ليست مفقودة، أليس كذلك؟
Dialogue: 0,0:00:30.23,0:00:32.18,Default,,0,0,0,,‫أنا آسف.
Dialogue: 0,0:00:32.18,0:00:35.14,Default,,0,0,0,,‫أردنا فقط من الأنسة كازوكو ووالدي أن يفهمنا.
Dialogue: 0,0:00:35.45,0:00:40.10,Default,,0,0,0,,‫ومع ذلك، فإن الأنسة ساتشيو المفقودة والمفترض أنها مختبئة...
Dialogue: 0,0:00:40.51,0:00:43.42,Default,,0,0,0,,‫أنا آسفة. لقد تم اختطافي.
Dialogue: 0,0:00:43.42,0:00:46.32,Default,,0,0,0,,‫إنه يؤلمني. توقف.
Dialogue: 0,0:00:46.32,0:00:48.75,Default,,0,0,0,,‫لدي يوميميا ساتشيو.
Dialogue: 0,0:00:46.40,0:00:52.03,sign_1191_ransom,SIGN,0000,0000,0000,,{\fs20\fnGeorgia\an6\move(190,420,190,250,0,5985)}لدينا\N\N.يوميميا ساتشيو\N\Nحضروا 100 مليون ين\N\Nخلال ساعتين
Dialogue: 0,0:00:48.75,0:00:52.03,Default,,0,0,0,,‫احضروا مئة مليون ين خلال ساعتين.
Dialogue: 0,0:00:52.39,0:00:55.03,Default,,0,0,0,,‫تحولت تمثيلية اختفائها إلى عملية اختطاف حقيقية...
Dialogue: 0,0:00:55.53,0:00:57.48,Default,,0,0,0,,في مواجهة لغز غير متوقع
Dialogue: 0,0:00:57.48,0:00:59.30,Default,,0,0,0,,‫الحل الوحيد هو مهارات الاستنتاج الفائقة!
Dialogue: 0,0:00:59.30,0:01:00.97,Default,,0,0,0,,‫لم يكن من المفترض أن يكون اختفاء حبيبته حقيقيًا!
Dialogue: 0,0:01:00.97,0:01:03.12,Default,,0,0,0,,ما المصير الذي ينتظر علاقتهما؟
Dialogue: 0,0:01:03.12,0:01:04.73,Default,,0,0,0,,يسعى وراء الحقيقة دائماً 
Dialogue: 0,0:01:04.73,0:01:06.43,Default,,0,0,0,,بجسد طفل وعقل بالغ
Dialogue: 0,0:01:06.43,0:01:08.80,Default,,0,0,0,,‫اسمه المحقق كونان!
Dialogue: 0,0:01:10.61,0:01:14.37,DC-OP,,0,0,0,,‫ليس بوسعي تغييره بنفسي
Dialogue: 0,0:01:14.55,0:01:17.60,DC-OP,,0,0,0,,‫ما كان منك وما أصابك، فقد مضى وانتهى
Dialogue: 0,0:01:18.08,0:01:21.85,DC-OP,,0,0,0,,‫لا يُعرف من أين جاء ولا ما هو
Dialogue: 0,0:01:21.94,0:01:25.57,DC-OP,,0,0,0,,‫كأن يهاجمك أحد الوحوش
Dialogue: 0,0:01:25.86,0:01:29.64,DC-OP,,0,0,0,,‫أركض كي لا يلحقوا بي
Dialogue: 0,0:01:29.64,0:01:32.90,DC-OP,,0,0,0,,‫ربما يحدث خيراً، من يعلم؟
Dialogue: 0,0:01:33.30,0:01:37.20,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:01:37.20,0:01:41.21,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:01:41.21,0:01:44.92,DC-OP,,0,0,0,,‫أجعل عمق الليل يلمع باللون الوردي
Dialogue: 0,0:01:44.92,0:01:48.64,DC-OP,,0,0,0,,‫مهما طال الزمن، كل ما علي فعله هو المحاولة
Dialogue: 0,0:01:56.34,0:02:00.14,DC-OP,,0,0,0,,‫أبحث عن سعادة جديدة
Dialogue: 0,0:02:00.14,0:02:03.43,DC-OP,,0,0,0,,‫أين يكمن؟، لا احد يعلم
Dialogue: 0,0:02:03.76,0:02:07.86,DC-OP,,0,0,0,,‫أمرٌ غير متوقع سيقع
Dialogue: 0,0:02:07.86,0:02:11.27,DC-OP,,0,0,0,,‫لا شيء مسلّمًا به، وهذا هو الطبيعي
Dialogue: 0,0:02:11.46,0:02:14.87,DC-OP,,0,0,0,,‫أضيء على الذكريات المظلمة
Dialogue: 0,0:02:15.15,0:02:18.85,DC-OP,,0,0,0,,‫احدق فيها حتى يزول خوفها
Dialogue: 0,0:02:19.11,0:02:22.83,DC-OP,,0,0,0,,‫في لحظة تلتفت فيها إلى الماضي
Dialogue: 0,0:02:22.93,0:02:26.57,DC-OP,,0,0,0,,‫لم يكن سوى أن أطلقت أعظم دموعك
Dialogue: 0,0:02:51.15,0:02:57.03,sign_episode_title,SIGN,0000,0000,0000,,{\fad(400,1)}الحبيب الذي اختفى على جسر كويتاني\Nجزء ميساسا 
Dialogue: 0,0:02:51.28,0:02:54.96,Default,,0,0,0,,‫"الحبيب الذي اختفى على جسر كويتاني، جزء ميساسا!"
Dialogue: 0,0:03:00.49,0:03:04.50,Default,,0,0,0,,‫لقد فحصنا لقطات كاميرا الأمان في متحف الكمان.
Dialogue: 0,0:03:04.50,0:03:09.34,Default,,0,0,0,,‫في الساعة الثالثة صباحًا، خرجت الأنسة ساتشيو وتوجهت نحو الجبال.
Dialogue: 0,0:03:09.34,0:03:12.70,Default,,0,0,0,,‫لا بدّ أن هذا هو المكان الذي اختطفتها السيارة السوداء.
Dialogue: 0,0:03:09.84,0:03:13.84,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,500)\pos(102,255)}(25) أوكاموتو ريو 
Dialogue: 0,0:03:09.84,0:03:13.84,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,500)\fs14\pos(102,272)}محقق من شرطة كورايوشي
Dialogue: 0,0:03:09.84,0:03:13.84,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,500)\pos(538,255)}(36) ياماني كاتسوهـيكو
Dialogue: 0,0:03:09.84,0:03:13.84,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,500)\fs14\pos(538,272)}محقق من شرطة كورايوشي
Dialogue: 0,0:03:13.45,0:03:17.09,Default,,0,0,0,,‫والآن، دعونا نسمع حججكم.
Dialogue: 0,0:03:17.09,0:03:19.38,Default,,0,0,0,,حججنا؟
Dialogue: 0,0:03:19.75,0:03:23.95,Default,,0,0,0,,‫كـ-كنا في قاعة الاحتفالات في ذلك الوقت.
Dialogue: 0,0:03:23.95,0:03:25.64,Default,,0,0,0,,أليس كذلك يا سيد كاسوغا؟
Dialogue: 0,0:03:25.64,0:03:31.61,Default,,0,0,0,,‫نعم. كنا مع سيد موري وضباط الشرطة حتى حوالي الساعة الثالثة والنصف صباحًا.{\an8}
Dialogue: 0,0:03:25.73,0:03:28.73,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\pos(527,264)}(48) كاسوغا ماساميتشي
Dialogue: 0,0:03:25.73,0:03:28.73,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,1)\fs14\pos(527,281)}عم ساتشيو
Dialogue: 0,0:03:31.61,0:03:32.75,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:03:33.24,0:03:35.48,Default,,0,0,0,,‫يمكننا أن نشهد على ذلك.
Dialogue: 0,0:03:35.48,0:03:37.22,Default,,0,0,0,,‫يبدو أن الأمر كذلك.
Dialogue: 0,0:03:37.84,0:03:39.11,Default,,0,0,0,,وأنت يا سيد كيتامي؟
Dialogue: 0,0:03:39.11,0:03:42.96,Default,,0,0,0,,‫كنت أبحث عن ضفادع كاجيكا وأصورها.{\an8}
Dialogue: 0,0:03:39.62,0:03:43.62,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,500)\pos(455,255)}(31) كيتامي توشيهيرو
Dialogue: 0,0:03:39.62,0:03:43.62,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,500)\fs14\pos(455,272)}مصور فوتوغرافي
Dialogue: 0,0:03:42.96,0:03:46.71,Default,,0,0,0,,‫تحقق من الأوقات. سترى أنني كنت عند النهر حتى الصباح.{\an8}
Dialogue: 0,0:03:55.09,0:03:58.85,Default,,0,0,0,,{\an8}ويا أنسة كازوكو وأنسة يوشيمي، أين كنتما في تلك الساعة؟
Dialogue: 0,0:03:55.63,0:03:59.13,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,500)\pos(330,265)}(35) كوموري يوشيمي
Dialogue: 0,0:03:55.63,0:03:59.13,sign_suspect,SIGN,0000,0000,0000,,{\fad(500,500)\fs14\pos(330,282)}نادلة
Dialogue: 0,0:03:58.85,0:04:01.22,Default,,0,0,0,,‫كنتُ نائمة في غرفتي.{\an8}
Dialogue: 0,0:04:01.22,0:04:02.79,Default,,0,0,0,,‫وأنا أيضًا.
Dialogue: 0,0:04:02.79,0:04:06.21,Default,,0,0,0,,‫إذن ليس لديكما حجة.
Dialogue: 0,0:04:07.78,0:04:09.84,Default,,0,0,0,,‫لقد تلقينا رسالة ثالثة.
Dialogue: 0,0:04:12.61,0:04:15.92,Default,,0,0,0,,‫إنها أنا، ساتشيو! ما زلتُ حية!
Dialogue: 0,0:04:15.92,0:04:17.71,Default,,0,0,0,,ماذا تفعلون؟
Dialogue: 0,0:04:17.71,0:04:22.74,Default,,0,0,0,,‫أ-أسرعوا وأنقذوني! إذا مت، سيكون خطأكم كله!
Dialogue: 0,0:04:22.74,0:04:25.09,Default,,0,0,0,,‫"الرسالة التالية ستكون بعد ساعة.{\an8}
Dialogue: 0,0:04:22.74,0:04:30.25,sign_1191_ransom,SIGN,0000,0000,0000,,{\fs20\frz5\fnGeorgia\an9\move(200,400,178,114,0,5600)}الرسالة التالية\N\N.ستكون خلال ساعة\N\Nاحضروا مئة مليون ين \N\N.بحلول ذلك الوقت\N\Nسأخبركم كيف.\N\Nتسليم\N\Nالمال
Dialogue: 0,0:04:25.09,0:04:27.88,Default,,0,0,0,,‫احضروا مئة مليون ين بحلول ذلك الوقت.{\an8}
Dialogue: 0,0:04:27.88,0:04:30.25,Default,,0,0,0,,‫سأخبركم كيف تسلمون المال."{\an8}
Dialogue: 0,0:04:30.73,0:04:33.97,Default,,0,0,0,,‫بعد ساعة من الآن... هذا ليس وقتًا طويلاً.
Dialogue: 0,0:04:34.57,0:04:35.74,Default,,0,0,0,,‫أنسة كازوكو!
Dialogue: 0,0:04:37.29,0:04:40.22,Default,,0,0,0,,‫يمكنني الحصول على مئة مليون ين.
Dialogue: 0,0:04:41.22,0:04:45.01,Default,,0,0,0,,بين مستحقات نهاية السنة وأجور الموظفين
Dialogue: 0,0:04:45.51,0:04:47.44,Default,,0,0,0,,‫لدي هذا المبلغ بالضبط في حسابي.
Dialogue: 0,0:04:47.44,0:04:49.37,Default,,0,0,0,,‫ولكن إذا فعلتِ ذلك...
Dialogue: 0,0:04:49.37,0:04:51.27,Default,,0,0,0,,‫فإن هذا النُزل سينتهي!
Dialogue: 0,0:04:52.00,0:04:53.28,Default,,0,0,0,,‫هذا غريب.
Dialogue: 0,0:04:53.62,0:04:55.77,Default,,0,0,0,,ما الغريب؟
Dialogue: 0,0:04:55.77,0:05:04.28,sign_1191_ransom,SIGN,0000,0000,0000,,{\fs10\fnGeorgia\an1\move(386,188,435,240,6500,6900)}.الرسالة التالية ستكون خلال ساعة\N\N.احضروا مئة مليون ين بحلول ذلك الوقت\N\N.سأخبركم كيف تسليم المال
Dialogue: 0,0:04:56.27,0:04:57.72,Default,,0,0,0,,‫هذا الفيديو.{\an8}
Dialogue: 0,0:04:57.72,0:05:02.39,Default,,0,0,0,,‫ساتشيو يمكن أن تكون أنانية، لكنها لن تلوم الآخرين أبدًا.{\an8}
Dialogue: 0,0:05:02.39,0:05:05.21,Default,,0,0,0,,{\an8}هل ستلوم الجميع على موتها؟
Dialogue: 0,0:05:06.75,0:05:08.80,Default,,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:05:08.80,0:05:11.11,Default,,0,0,0,,‫ليس هذا ما سمعناه.
Dialogue: 0,0:05:11.11,0:05:12.30,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:05:12.30,0:05:13.46,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:05:13.46,0:05:18.26,Default,,0,0,0,,‫على ما يبدو، لم يرَ أحد سيارة سوداء في الجبال أمس.
Dialogue: 0,0:05:18.26,0:05:22.39,Default,,0,0,0,,‫كما تعلم، تلك السيارة التي يُعتقد أنها للخاطف الذي خطف الأنسة ساتشيو.
Dialogue: 0,0:05:23.55,0:05:24.98,Default,,0,0,0,,‫كونان!
Dialogue: 0,0:05:29.72,0:05:33.91,Default,,0,0,0,,هل تم اختطاف الأنسة ساتشيو حقًا بعد خروجها من المستودع؟
Dialogue: 0,0:05:35.70,0:05:39.53,Default,,0,0,0,,‫لقد خرجت من المستودع وتوجهت صعودًا على هذا الطريق...
Dialogue: 0,0:05:41.43,0:05:42.99,Default,,0,0,0,,هناك طريقان؟
Dialogue: 0,0:05:45.74,0:05:47.64,Default,,0,0,0,,‫انتظر يا كونان!
Dialogue: 0,0:05:51.92,0:05:54.50,Default,,0,0,0,,هل هذا يعني أن الأنسة ساتشيو ذَهبت من هذا الطريق؟
Dialogue: 0,0:05:54.50,0:05:58.89,Default,,0,0,0,,نعم. الجميع يفترض أنها اختُطفت في الجبال
Dialogue: 0,0:05:58.89,0:06:01.26,Default,,0,0,0,,ولكن ماذا لو لم تكن؟
Dialogue: 0,0:06:04.10,0:06:06.58,Default,,0,0,0,,‫لقد عدنا إلى ينابيع ميساسا الساخنة.
Dialogue: 0,0:06:06.58,0:06:08.39,Default,,0,0,0,,هل هذا جسر كويتاني؟
Dialogue: 0,0:06:08.39,0:06:09.54,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:06:10.39,0:06:14.35,Default,,0,0,0,,‫ذلك هو جسر ميساسا، وما بعده هو جسر كاجيكا.
Dialogue: 0,0:06:18.79,0:06:20.48,Default,,0,0,0,,‫سيد كيتامي!
Dialogue: 0,0:06:22.52,0:06:24.61,Default,,0,0,0,,ما الأمر، أيها الفتى؟
Dialogue: 0,0:06:25.20,0:06:29.49,Default,,0,0,0,,كنتَ هنا حوالي الساعة الثالثة صباحًا، أليس كذلك؟
Dialogue: 0,0:06:29.49,0:06:30.49,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:06:30.49,0:06:32.25,Default,,0,0,0,,هل لاحظت أي شيء غريب؟
Dialogue: 0,0:06:32.57,0:06:34.19,Default,,0,0,0,,أي شيء غريب؟
Dialogue: 0,0:06:35.94,0:06:39.04,Default,,0,0,0,,‫بالتفكير في الأمر، سمعت أحدهم يعبر النهر.
Dialogue: 0,0:06:39.38,0:06:42.98,Default,,0,0,0,,يعبر النهر؟ هل لديك صورة من ذلك الوقت؟
Dialogue: 0,0:06:42.98,0:06:44.68,Default,,0,0,0,,‫نعم، لدي.
Dialogue: 0,0:06:44.68,0:06:45.81,Default,,0,0,0,,‫انظر.
Dialogue: 0,0:06:49.70,0:06:50.81,Default,,0,0,0,,‫هذه!
Dialogue: 0,0:06:51.21,0:06:53.75,Default,,0,0,0,,‫إنها ساتشيو بالتأكيد.
Dialogue: 0,0:06:54.17,0:06:57.90,Default,,0,0,0,,‫لم تذهب إلى الجبال. لقد عادت إلى ينابيع ميساسا الساخنة.
Dialogue: 0,0:06:57.90,0:07:01.76,Default,,0,0,0,,ماذا يوجد على الجانب الآخر من هذا الجسر؟
Dialogue: 0,0:07:01.76,0:07:03.76,Default,,0,0,0,,‫موقف سيارات يوميميا.
Dialogue: 0,0:07:06.42,0:07:07.67,Default,,0,0,0,,‫لنتحقق منه.
Dialogue: 0,0:07:11.06,0:07:12.29,Default,,0,0,0,,‫لحظة.
Dialogue: 0,0:07:15.12,0:07:17.89,Default,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:07:18.60,0:07:21.88,Default,,0,0,0,,ألم تجدوا ساتشيو بعد؟
Dialogue: 0,0:07:21.88,0:07:22.98,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:07:22.98,0:07:25.13,Default,,0,0,0,,‫هذا فظيع. أنسة ساتشيو...
Dialogue: 0,0:07:25.44,0:07:29.64,Default,,0,0,0,,‫لكن الخاطف سيظهر عندما نسلم الفدية.
Dialogue: 0,0:07:29.64,0:07:31.54,Default,,0,0,0,,‫سنقبض عليه حينها.
Dialogue: 0,0:07:31.54,0:07:34.05,Default,,0,0,0,,عذراً للمقاطعة.
Dialogue: 0,0:07:34.05,0:07:34.85,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:07:35.28,0:07:37.38,Default,,0,0,0,,وفقًا لفريق الطب الشرعي
Dialogue: 0,0:07:37.38,0:07:41.12,Default,,0,0,0,,‫يمكن سماع صوت الأمواج بشكل خافت في كلا الفيديوهين.
Dialogue: 0,0:07:41.12,0:07:42.65,Default,,0,0,0,,‫اسمع هذا.
Dialogue: 0,0:07:48.97,0:07:50.56,Default,,0,0,0,,‫أنت محق.
Dialogue: 0,0:07:50.91,0:07:57.66,sign_1191_parking_lot,SIGN,0000,0000,0000,,{\c&H413F3D&\fnGeorgia\fs24\an2\pos(176,170)}نُزل
Dialogue: 0,0:07:50.91,0:07:57.66,sign_1191_parking_lot,SIGN,0000,0000,0000,,{\c&H413F3D&\fnGeorgia\fs16\pos(164,41)\an4}يوميميا
Dialogue: 0,0:07:50.91,0:07:57.66,sign_1191_parking_lot,SIGN,0000,0000,0000,,{\c&H413F3D&\fs36\pos(394,72)\an1}موقف السيارات
Dialogue: 0,0:07:52.31,0:07:55.38,Default,,0,0,0,,‫إذن هذا هو موقف سيارات يوميميا.
Dialogue: 0,0:07:59.83,0:08:01.50,Default,,0,0,0,,ما الأمر يا كونان؟
Dialogue: 0,0:08:01.97,0:08:04.13,Default,,0,0,0,,‫هناك رمل على هذه السيارة.
Dialogue: 0,0:08:04.42,0:08:05.88,Default,,0,0,0,,رمل؟
Dialogue: 0,0:08:10.27,0:08:12.39,Default,,0,0,0,,أين كنتم أنتم الثلاثة؟
Dialogue: 0,0:08:12.39,0:08:15.64,Default,,0,0,0,,‫لقد تلقينا رسالة ثالثة من الخاطف!
Dialogue: 0,0:08:20.06,0:08:21.69,Default,,0,0,0,,يا كونان؟
Dialogue: 0,0:08:21.69,0:08:26.94,Default,,0,0,0,,أخبرني يا سيد تيروكي. أين هو اليوكاتا الملطخ من الليلة الماضية؟
Dialogue: 0,0:08:26.94,0:08:30.47,Default,,0,0,0,,اليوكاتا؟ لـ-لماذا تسأل عن ذلك الآن؟
Dialogue: 0,0:08:30.47,0:08:32.70,Default,,0,0,0,,‫ربما يكون في غرفة الغسيل.
Dialogue: 0,0:08:32.70,0:08:34.70,Default,,0,0,0,,‫خذني إلى هناك.
Dialogue: 0,0:08:37.35,0:08:40.25,Default,,0,0,0,,‫أبي، سمعنا أن فيديو ثالثًا وصل.
Dialogue: 0,0:08:40.25,0:08:43.88,Default,,0,0,0,,‫نعم. تبا لهذا المهرج!
Dialogue: 0,0:08:43.88,0:08:54.05,sign_1191_ransom,SIGN,0000,0000,0000,,{\fs10\fnGeorgia\an1\pos(272,49)}خلال عشر دقائق، سأرسل عشرة أرقام حسابات. وخلال خمس دقائق من استلام الأرقام، أودِعوا عشرة ملايين ين في كل حساب.
Dialogue: 0,0:08:45.25,0:08:48.17,Default,,0,0,0,,‫"خلال عشر دقائق، سأرسل عشرة أرقام حسابات.
Dialogue: 0,0:08:48.17,0:08:51.07,Default,,0,0,0,,خلال خمس دقائق بعد استلام الأرقام
Dialogue: 0,0:08:51.07,0:08:53.01,Default,,0,0,0,,‫قوموا بإيداع عشرة ملايين ين في كل حساب."
Dialogue: 0,0:08:53.01,0:08:54.05,Default,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:08:54.32,0:08:56.49,Default,,0,0,0,,‫إنه يشبه احتيال الأقارب المزيفين.
Dialogue: 0,0:08:56.49,0:09:00.31,Default,,0,0,0,,‫يقومون بإعداد حسابات وهمية متعددة ويقوم الضحية بإيداع المال في كل منها.
Dialogue: 0,0:09:00.31,0:09:03.39,Default,,0,0,0,,‫يسحبون المال على الفور، ويهربون.
Dialogue: 0,0:09:03.39,0:09:05.89,Default,,0,0,0,,‫لا يهتمون إذا فشل حسابان أو ثلاثة.
Dialogue: 0,0:09:05.89,0:09:08.09,Default,,0,0,0,,‫إنهم أذكياء.
Dialogue: 0,0:09:08.09,0:09:11.82,Default,,0,0,0,,‫لا بد أنهم مجموعة إجرامية ليست لها علاقة بالنُزل.
Dialogue: 0,0:09:11.82,0:09:14.32,Default,,0,0,0,,ألم تجدوا ساتشيو بعد؟
Dialogue: 0,0:09:17.16,0:09:19.45,Default,,0,0,0,,‫ليس لدينا أي فكرة عن مكانها.
Dialogue: 0,0:09:19.45,0:09:22.46,Default,,0,0,0,,هل دفع الفدية هو خيارنا الوحيد؟
Dialogue: 0,0:09:27.07,0:09:29.67,Default,,0,0,0,,‫يا أنسة كازوكو، من فضلك.
Dialogue: 0,0:09:29.67,0:09:31.72,Default,,0,0,0,,‫أعدكِ بأنني سأردها لكِ.
Dialogue: 0,0:09:32.42,0:09:34.60,Default,,0,0,0,,‫أؤيدهُ، أرجوكِ.
Dialogue: 0,0:09:35.99,0:09:37.65,Default,,0,0,0,,‫وأنا أيضًا.
Dialogue: 0,0:09:38.02,0:09:39.52,Default,,0,0,0,,‫أبي.
Dialogue: 0,0:09:41.61,0:09:43.38,Default,,0,0,0,,‫أخبريني يا أنسة كازوكو.
Dialogue: 0,0:09:45.30,0:09:51.28,Default,,0,0,0,,‫إذا لم نكن نتشاجر، لما حدث هذا من الأساس.
Dialogue: 0,0:10:02.26,0:10:04.65,Default,,0,0,0,,عندما تحصلون على أرقام الحسابات من الجناة
Dialogue: 0,0:10:04.65,0:10:06.84,Default,,0,0,0,,‫أرجو إرسالها إلى حسابي.
Dialogue: 0,0:10:06.84,0:10:12.17,Default,,0,0,0,,‫سأتيع تعليماتهم بإرسال عشرة ملايين ين إلى كل حساب.
Dialogue: 0,0:10:13.68,0:10:17.12,Default,,0,0,0,,‫هل أنتِ متأكدة؟ سينتهي هذا النُزل.
Dialogue: 0,0:10:17.12,0:10:21.11,Default,,0,0,0,,‫طلبت مني أختي الصغرى أن أعتني بهذه الفتاة الثمينة.
Dialogue: 0,0:10:21.11,0:10:23.48,Default,,0,0,0,,‫يجب أن أنقذها.
Dialogue: 0,0:10:24.05,0:10:25.99,Default,,0,0,0,,‫شكرًا لكِ.
Dialogue: 0,0:10:25.99,0:10:28.76,Default,,0,0,0,,‫لقد تلقينا رسالة من الجناة.
Dialogue: 0,0:10:29.40,0:10:31.90,Default,,0,0,0,,‫اتصل بالبنك. سأعطي الأمر.
Dialogue: 0,0:10:31.90,0:10:33.25,Default,,0,0,0,,‫مفهوم.
Dialogue: 0,0:10:33.25,0:10:35.07,Default,,0,0,0,,‫أسرعوا. ليس لدينا سوى خمس دقائق.
Dialogue: 0,0:10:35.07,0:10:36.29,Default,,0,0,0,,‫حسناً!
Dialogue: 0,0:10:36.81,0:10:41.67,Default,,0,0,0,,‫أخبرني، كيف كان الفيديو الثالث للأنسة ساتشيو.
Dialogue: 0,0:10:41.67,0:10:43.72,Default,,0,0,0,,‫أنت محق. دعنا نتحقق منه.
Dialogue: 0,0:10:45.08,0:10:50.03,Default,,0,0,0,,‫ماذا تفعلون جميعاً؟، ياساتو، هذا خطؤك!
Dialogue: 0,0:10:50.50,0:10:53.23,Default,,0,0,0,,‫عــ-على أي حال، أسرعوا وادفعوا لهم!
Dialogue: 0,0:10:53.23,0:10:55.25,Default,,0,0,0,,‫سيقتلونني!
Dialogue: 0,0:10:55.25,0:10:57.75,Default,,0,0,0,,ما رأيك يا ياساتو؟
Dialogue: 0,0:10:57.75,0:11:00.28,Default,,0,0,0,,‫كما توقعت، ساتشيو لا تتصرف كعادتها.
Dialogue: 0,0:11:00.28,0:11:05.31,Default,,0,0,0,,‫نعم. لا أعتقد أنني سأقول ذلك لشخص أحبه.
Dialogue: 0,0:11:05.31,0:11:07.56,Default,,0,0,0,,لن تقولي ذلك؟
Dialogue: 0,0:11:07.56,0:11:12.67,Default,,0,0,0,,‫افحص الفيديو. ربما يكون صوت الأمواج موجودًا فيه مرة أخرى.
Dialogue: 0,0:11:14.06,0:11:15.32,Default,,0,0,0,,صوت الأمواج؟
Dialogue: 0,0:11:15.32,0:11:18.20,Default,,0,0,0,,‫نعم. كان في الفيديوهات السابقة.
Dialogue: 0,0:11:18.46,0:11:19.62,Default,,0,0,0,,أمواج؟
Dialogue: 0,0:11:21.27,0:11:22.20,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:11:23.43,0:11:25.08,Default,,0,0,0,,‫هكذا هو الأمر.
Dialogue: 0,0:11:26.58,0:11:30.63,Default,,0,0,0,,‫ماذا تفعلون جميعاً؟، ياساتو، هذا خطؤك!
Dialogue: 0,0:11:30.63,0:11:31.66,Default,,0,0,0,,‫عفواً، رفعت الصوت.
Dialogue: 0,0:11:31.66,0:11:33.88,Default,,0,0,0,,‫عـ-على أي حال، أسرعوا وادفعوا لهم!{\an8}
Dialogue: 0,0:11:33.88,0:11:35.00,Default,,0,0,0,,‫أيها الشقي! اذهب إلى مكان آخر!
Dialogue: 0,0:11:35.00,0:11:36.61,Default,,0,0,0,,‫سيقتلونني!{\an8}
Dialogue: 0,0:11:36.61,0:11:38.47,Default,,0,0,0,,‫أخبرني يا عمي.
Dialogue: 0,0:11:38.97,0:11:41.85,Default,,0,0,0,,‫يوناغو، دايسن، وتوتوري.
Dialogue: 0,0:11:41.85,0:11:45.71,Default,,0,0,0,,لقد وجدت إجابة واحدة من ثلاثة مصادر للمعلومات، أليس كذلك؟
Dialogue: 0,0:11:45.71,0:11:48.23,Default,,0,0,0,,‫ربما تكون الفيديوهات هي نفسها.
Dialogue: 0,0:11:48.23,0:11:50.83,Default,,0,0,0,,ماذا؟، نفسها؟
Dialogue: 0,0:11:52.96,0:11:57.11,Default,,0,0,0,,‫سيد موري، صوت الأمواج كان في هذا الفيديو أيضًا.
Dialogue: 0,0:11:57.11,0:11:58.41,Default,,0,0,0,,أمواج؟
Dialogue: 0,0:12:00.91,0:12:02.03,Default,,0,0,0,,‫هكذا إذن!
Dialogue: 0,0:12:02.03,0:12:04.49,Default,,0,0,0,,‫توقفوا! لا تدفعوا مئة مليون ين!
Dialogue: 0,0:12:05.75,0:12:08.12,Default,,0,0,0,,‫أعرف مكان الأنسة ساتشيو.
Dialogue: 0,0:12:08.12,0:12:10.38,Default,,0,0,0,,ماذا تقصد يا أبي؟
Dialogue: 0,0:12:10.38,0:12:13.13,Default,,0,0,0,,‫عليك إعادة ترتيب الكلمات المتكررة.
Dialogue: 0,0:12:13.13,0:12:15.51,Default,,0,0,0,,إعادة ترتيب؟
Dialogue: 0,0:12:15.51,0:12:19.26,Default,,0,0,0,,‫الأنسة ساتشيو كانت تخبرنا عن مكانها.
Dialogue: 0,0:12:19.26,0:12:22.41,Default,,0,0,0,,‫إنه يؤلمني. توقف من فضلك.
Dialogue: 0,0:12:19.26,0:12:28.06,sign_1191_onscreen_quotation,SIGN,0000,0000,0000,,{\an6\pos(355,35)\fad(1,200)}إنه يؤلمني"
Dialogue: 0,0:12:19.26,0:12:28.06,sign_1191_onscreen_quotation,SIGN,0000,0000,0000,,{\an6\pos(446,82)\fad(1,200)}"!توقّف
Dialogue: 0,0:12:22.41,0:12:25.27,Default,,0,0,0,,‫أ-أسرعوا وأنقذوني!
Dialogue: 0,0:12:22.64,0:12:28.06,sign_1191_onscreen_quotation,SIGN,0000,0000,0000,,{\an6\pos(355,141)\fad(1,200)}أسرعوا"
Dialogue: 0,0:12:22.64,0:12:28.06,sign_1191_onscreen_quotation,SIGN,0000,0000,0000,,{\an6\pos(503,189)\fad(1,200)}"!وأنقذوني"
Dialogue: 0,0:12:25.27,0:12:28.36,Default,,0,0,0,,‫عـ-على أي حال، أسرعوا وادفعوا لهم!
Dialogue: 0,0:12:25.52,0:12:28.06,sign_1191_onscreen_quotation,SIGN,0000,0000,0000,,{\an6\pos(596,224)\fad(1,200)}"!عـ-على أي حال، أسرعوا وادفعوا لهم"
Dialogue: 0,0:12:29.35,0:12:31.35,Default,,0,0,0,,‫كو... ها...
Dialogue: 0,0:12:38.78,0:12:42.28,sign_suspect,SIGN,0000,0000,0000,,{\pos(320,290)}شاطئ هاكوتو
Dialogue: 0,0:12:39.95,0:12:44.66,Default,,0,0,0,,‫فهمت. لم يتم إيداع المال.{\an8}
Dialogue: 0,0:12:45.12,0:12:46.41,Default,,0,0,0,,‫لقد فشلنا.
Dialogue: 0,0:12:46.71,0:12:48.12,Default,,0,0,0,,‫أنا آسف.
Dialogue: 0,0:12:48.66,0:12:50.63,Default,,0,0,0,,‫اهرب بأسرع ما يمكنك.
Dialogue: 0,0:12:50.63,0:12:52.88,Default,,0,0,0,,‫سأتولى الباقي.
Dialogue: 0,0:12:53.21,0:12:55.80,sign_1191_parking_lot,SIGN,0000,0000,0000,,{\c&H4A3040&\3c&H585B82&\4c&H1D141C&\frz2\shad0\fry-10\an9\move(750,201,555,201,0,1600)\fs24}السيارات العادية
Dialogue: 0,0:12:53.21,0:12:55.80,sign_1191_parking_lot,SIGN,0000,0000,0000,,{\c&H4A3040&\3c&H585B82&\4c&H1D141C&\frz10\shad0\fax-0.1\fry-10\an3\fs20\move(740,83,536,83,0,1600)}السيارات الكبيرة
Dialogue: 0,0:12:57.96,0:13:01.07,Default,,0,0,0,,‫أنا آسف. ليس لدي خيارا أخر.
Dialogue: 0,0:13:04.33,0:13:05.60,Default,,0,0,0,,‫توقف مكانك!
Dialogue: 0,0:13:06.97,0:13:09.03,Default,,0,0,0,,‫إذن كان أنت في النهاية.
Dialogue: 0,0:13:09.43,0:13:12.85,Default,,0,0,0,,‫شككت فيك منذ أن اختفيت فجأة...
Dialogue: 0,0:13:14.78,0:13:16.52,Default,,0,0,0,,‫يا سيد كاسوغا ماساميتشي.
Dialogue: 0,0:13:17.40,0:13:23.99,Default,,0,0,0,,‫أنا معجب بأنك تتبعتني إلى شاطئ هاكوتو، أيها المحقق.
Dialogue: 0,0:13:23.99,0:13:26.62,Default,,0,0,0,,‫كان حبهما هو الذي أخبرنا عن مكانك.
Dialogue: 0,0:13:23.99,0:13:26.62,sign_1191_sanctuary,SIGN,0000,0000,0000,,{\an8\frz7.5\pos(519,102)}ملجأ العشاق
Dialogue: 0,0:13:29.44,0:13:32.42,Default,,0,0,0,,‫يبدو أنك فعلت أكثر مما يجب.
Dialogue: 0,0:13:33.12,0:13:37.88,Default,,0,0,0,,‫لكن لا يوجد دليل على أنني خطفت هذه الفتاة.
Dialogue: 0,0:13:38.89,0:13:40.69,Default,,0,0,0,,‫الأمر واضح.
Dialogue: 0,0:13:40.69,0:13:44.26,Default,,0,0,0,,‫أنت تحاول قتلها. هذا دليلك.
Dialogue: 0,0:13:44.26,0:13:46.82,Default,,0,0,0,,‫أملك دليلًا يثبت وجودي في مكان آخر.
Dialogue: 0,0:13:46.82,0:13:49.81,Default,,0,0,0,,‫كنتُ في قاعة الاحتفالات حتى الثالثة والنصف صباحًا.
Dialogue: 0,0:13:49.81,0:13:51.94,Default,,0,0,0,,‫لقد شهدتم جميعًا لي.
Dialogue: 0,0:13:51.94,0:13:55.96,Default,,0,0,0,,ماذا؟... أنتما تعلمان ماذا حدث، أليس كذلك؟
Dialogue: 0,0:14:06.21,0:14:07.70,Default,,0,0,0,,‫تبًا! دعني أذهب!
Dialogue: 0,0:14:13.29,0:14:15.54,Default,,0,0,0,,ساتشيو، هل أنتِ بخير؟
Dialogue: 0,0:14:15.54,0:14:17.47,Default,,0,0,0,,‫شكرًا لك، ياساتو.
Dialogue: 0,0:14:18.10,0:14:22.40,Default,,0,0,0,,عمي، لقد أخبرتك، أليس كذلك؟
Dialogue: 0,0:14:23.10,0:14:24.41,Default,,0,0,0,,تختفين؟
Dialogue: 0,0:14:24.41,0:14:28.49,Default,,0,0,0,,‫إنها الطريقة الوحيدة لجعل هذين الاثنين يفهمان.
Dialogue: 0,0:14:28.49,0:14:32.17,Default,,0,0,0,,‫سأختبئ في مستودع متحف الكمان لفترة.
Dialogue: 0,0:14:33.06,0:14:36.73,Default,,0,0,0,,أنت من ترك تلك الرسالة، أليس كذلك؟
Dialogue: 0,0:14:36.73,0:14:41.48,Default,,0,0,0,,‫هل فعلت؟ ليس لدي أي فكرة عما تتحدثين عنه.
Dialogue: 0,0:14:41.77,0:14:45.74,Default,,0,0,0,,‫لقد خططت الابتعاد من هذا من البداية.
Dialogue: 0,0:14:46.76,0:14:48.91,Default,,0,0,0,,‫"كوني حذرة.
Dialogue: 0,0:14:48.91,0:14:53.46,Default,,0,0,0,,‫خذي الطريق الخلفي واعبري نهر ميساسا لتأتي إلى موقف السيارات.
Dialogue: 0,0:14:54.26,0:14:57.46,Default,,0,0,0,,‫سأنتظرك في الساعة الثالثة والنصف صباحًا."
Dialogue: 0,0:14:57.46,0:15:01.97,Default,,0,0,0,,‫لقد صورتُ الأنسة ساتشيو وهي تفعل ذلك.
Dialogue: 0,0:15:02.30,0:15:04.32,Default,,0,0,0,,‫هكذا إذن. لقد فهمت.
Dialogue: 0,0:15:04.32,0:15:07.93,Default,,0,0,0,,‫يا سيد كاسوغا، من أجل تلفيق دليل حضورك في مكان آخر...
Dialogue: 0,0:15:09.56,0:15:12.52,Default,,0,0,0,,‫يجب أن أذهب. المعذرة.
Dialogue: 0,0:15:13.66,0:15:15.69,Default,,0,0,0,,‫بجدية! لا تذهب بعد!
Dialogue: 0,0:15:25.45,0:15:29.95,Default,,0,0,0,,‫لقد استخدمت اختفاء الأنسة ساتشيو و وسيد ياساتو المزيفة.
Dialogue: 0,0:15:29.95,0:15:31.70,Default,,0,0,0,,‫هذه هي الحقيقة.
Dialogue: 0,0:15:33.20,0:15:35.08,Default,,0,0,0,,‫هذا هو المسن.
Dialogue: 0,0:15:35.39,0:15:38.18,Default,,0,0,0,,لقد قدتها إلى هنا إلى شاطئ هاكوتو
Dialogue: 0,0:15:38.18,0:15:42.26,Default,,0,0,0,,‫ودفعت الأنسة إلى السيارة التي أوقفتها هنا.
Dialogue: 0,0:15:42.26,0:15:43.84,Default,,0,0,0,,‫هذا حين رأت...
Dialogue: 0,0:15:47.47,0:15:50.22,Default,,0,0,0,,‫أنت مخطئ! ، هذا كذب!
Dialogue: 0,0:15:50.22,0:15:54.03,Default,,0,0,0,,‫كان هناك رمل على سيارتك في موقف السيارات يا سيد كاسوغا.
Dialogue: 0,0:15:54.03,0:15:58.23,Default,,0,0,0,,‫فحصٌ على الأرجح سيظهر أنه يتطابق مع الرمل هنا.
Dialogue: 0,0:16:01.40,0:16:02.23,Default,,0,0,0,,مرحبًا؟
Dialogue: 0,0:16:02.49,0:16:06.99,Default,,0,0,0,,‫ثم صورت ثلاثة فيديوهات وعدتَ إلى النُزل.
Dialogue: 0,0:16:07.94,0:16:11.55,Default,,0,0,0,,بعد ذلك، ادعيت أن سيارة مشبوهة شوهدت في الجبال
Dialogue: 0,0:16:11.55,0:16:13.23,Default,,0,0,0,,لإلصاق تهمة الاختطاف بأطراف خارجية
Dialogue: 0,0:16:13.23,0:16:17.60,Default,,0,0,0,,‫وانتظرت الفرص لإرسال تهديدات إلى النُزل كل ساعة.
Dialogue: 0,0:16:17.60,0:16:19.37,Default,,0,0,0,,‫أ-أنت مخطئ.
Dialogue: 0,0:16:22.60,0:16:25.62,Default,,0,0,0,,‫لقد سمعنا للتو من شرطة العاصمة.
Dialogue: 0,0:16:25.62,0:16:28.40,Default,,0,0,0,,‫تم القبض على أحد شركائه.
Dialogue: 0,0:16:28.40,0:16:30.68,Default,,0,0,0,,إنه أحد زملائك في العمل، أليس كذلك؟
Dialogue: 0,0:16:31.48,0:16:38.31,Default,,0,0,0,,‫قال إنه خطط للهرب مؤقتًا إلى الخارج بعد سحب الفدية.
Dialogue: 0,0:16:40.21,0:16:42.64,Default,,0,0,0,,‫لقد انتهى الأمر ٱذن.
Dialogue: 0,0:16:43.70,0:16:45.68,Default,,0,0,0,,‫وأخيرا.
Dialogue: 0,0:16:47.09,0:16:49.20,Default,,0,0,0,,‫كان ذلك مذهلاً يا أبي!
Dialogue: 0,0:16:49.20,0:16:50.95,Default,,0,0,0,,‫كان ذلك استنتاجًا مثيرًا للإعجاب!
Dialogue: 0,0:16:50.95,0:16:53.70,Default,,0,0,0,,‫لا عجب أنك أفضل محقق في اليابان!
Dialogue: 0,0:16:53.70,0:16:56.99,Default,,0,0,0,,‫من فضلك. أنا مجرد سائح.
Dialogue: 0,0:16:56.99,0:17:00.46,Default,,0,0,0,,‫والآن دعونا نعود ونحتفل بالمشروبات.
Dialogue: 0,0:17:00.46,0:17:02.96,Default,,0,0,0,,‫ليس بعد، أيها المسن.
Dialogue: 0,0:17:02.96,0:17:05.36,Default,,0,0,0,,‫لنستمتع قليلاً!
Dialogue: 0,0:17:09.63,0:17:13.26,Default,,0,0,0,,‫يـ-يا سيد موري؟ لقد تم حل القضية بالفعل، رغم ذلك...
Dialogue: 0,0:17:13.26,0:17:16.43,Default,,0,0,0,,‫انتظر. قد يكون هذا...
Dialogue: 0,0:17:16.84,0:17:21.06,Default,,0,0,0,,‫الخطوة الثالثة: كن صامتًا، وستظهر الحقيقة.
Dialogue: 0,0:17:23.70,0:17:27.19,Default,,0,0,0,,‫يا سيد كاسوغا، لقد كنتَ مجرد طُعم.
Dialogue: 0,0:17:27.92,0:17:30.71,Default,,0,0,0,,كنتُ طُعم؟
Dialogue: 0,0:17:30.71,0:17:31.72,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:17:32.27,0:17:33.49,Default,,0,0,0,,يا أنسة يوشيمي
Dialogue: 0,0:17:33.49,0:17:36.40,Default,,0,0,0,,‫من أجل التحريض على الأنسة كازوكو والأنسة ساتشيو.
Dialogue: 0,0:17:36.40,0:17:38.58,Default,,0,0,0,,لقد أسقطتِ طبقًا عمدًا، أليس كذلك؟
Dialogue: 0,0:17:41.88,0:17:43.77,Default,,0,0,0,,‫لقد قلتِ أيضًا هذا لسيد كاسوغا.
Dialogue: 0,0:17:44.51,0:17:48.71,Default,,0,0,0,,‫الأمر يُصبح أسهل بكثير عندما تأتي إلي، كما تعلم.
Dialogue: 0,0:17:48.71,0:17:52.59,Default,,0,0,0,,‫صحيح. هكذا خطرت لي حيلتي.
Dialogue: 0,0:17:52.59,0:17:57.35,Default,,0,0,0,,‫بعد ذلك، قالت لي أن أفعل ما يلزم لحماية شركتي.
Dialogue: 0,0:17:57.60,0:17:59.68,Default,,0,0,0,,‫لقد تأثرت.
Dialogue: 0,0:18:00.05,0:18:03.24,Default,,0,0,0,,فيما بعد، راقبت الأنسة يوشيمي، سيد كاسوغا
Dialogue: 0,0:18:03.24,0:18:05.90,Default,,0,0,0,,‫لفهم خطة اختطافه بشكل واضح.
Dialogue: 0,0:18:05.90,0:18:10.42,Default,,0,0,0,,جمعت الرمل من هذا الشاطئ ودلكته على سيارة السيد كاسوغا
Dialogue: 0,0:18:10.42,0:18:13.36,Default,,0,0,0,,‫ليتحمل هو اللوم كله.
Dialogue: 0,0:18:14.04,0:18:15.99,Default,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:18:15.99,0:18:18.67,Default,,0,0,0,,‫وجد كونان شيئًا في غرفة الغسيل.
Dialogue: 0,0:18:19.05,0:18:23.62,Default,,0,0,0,,‫كان هناك رمل على بقع الطعام على مئزرك.
Dialogue: 0,0:18:28.02,0:18:29.46,Default,,0,0,0,,‫ذلك الرمل لا بد أن يكون من هنا.
Dialogue: 0,0:18:29.46,0:18:31.59,Default,,0,0,0,,‫أرسله إلى الطب الشرعي فورًا.
Dialogue: 0,0:18:31.59,0:18:35.01,Default,,0,0,0,,انتظر لحظة! لماذا أفعل شيئًا كهذا؟
Dialogue: 0,0:18:35.01,0:18:38.76,Default,,0,0,0,,‫أردتِ أن تضعي نهاية لنُزل يوميميا.
Dialogue: 0,0:18:40.14,0:18:42.27,Default,,0,0,0,,‫غير صحيح، أ-أنت تكذب!
Dialogue: 0,0:18:42.27,0:18:47.27,Default,,0,0,0,,‫السيد كاسوغا ارتكب جريمته في الساعة الثالثة والحادية والثلاثون دقيقة صباحًا.
Dialogue: 0,0:18:49.27,0:18:52.15,Default,,0,0,0,,‫موقف السيارات له إطلالة واضحة على ذلك المكان.
Dialogue: 0,0:19:00.27,0:19:03.71,Default,,0,0,0,,‫هذا دليل قاطع على أنكِ كنتِ وراء كل شيء!
Dialogue: 0,0:19:09.04,0:19:10.00,Default,,0,0,0,,‫ساتشيو!
Dialogue: 0,0:19:10.00,0:19:12.39,Default,,0,0,0,,‫تراجع للخلف! للخلف!
Dialogue: 0,0:19:23.39,0:19:25.94,Default,,0,0,0,,أنسة يوشيمي، لماذا تفعلين هذا؟
Dialogue: 0,0:19:26.31,0:19:30.51,Default,,0,0,0,,‫كان والداي حرفيين في صناعة الكيمونو.
Dialogue: 0,0:19:30.51,0:19:34.31,Default,,0,0,0,,‫لكنهم خسروا متجرهم، ومنتجاتهم، كل شيء...
Dialogue: 0,0:19:34.31,0:19:37.20,Default,,0,0,0,,‫عندما جُرّوا إلى نزاعكم على الممتلكات.
Dialogue: 0,0:19:38.20,0:19:40.66,Default,,0,0,0,,هل يبدو اسم يوميزاكورا مألوفًا؟
Dialogue: 0,0:19:40.66,0:19:42.33,Default,,0,0,0,,‫إنه كيمونو النُزل.
Dialogue: 0,0:19:43.00,0:19:49.58,Default,,0,0,0,,‫قضيا سنوات في صنعه حتى أتمكن من ارتدائه.
Dialogue: 0,0:19:49.98,0:19:53.96,Default,,0,0,0,,‫لكن، يا أنسة كازوكو أنتِ حتى أخذتِ ذلك الكيمونو مني.
Dialogue: 0,0:19:59.33,0:20:00.97,Default,,0,0,0,,‫لا تتحركوا!
Dialogue: 0,0:20:01.33,0:20:03.27,Default,,0,0,0,,‫والداي ميتان.
Dialogue: 0,0:20:03.27,0:20:05.80,Default,,0,0,0,,‫لا يمكنني أن أسامح أيًا منكم.
Dialogue: 0,0:20:05.80,0:20:08.85,Default,,0,0,0,,بالإضافة إلى ذلك، هذه الفتاة أرادت ارتداء يوميزاكورا
Dialogue: 0,0:20:08.85,0:20:11.23,Default,,0,0,0,,لعودتها المجيدة كفتاة الفن؟
Dialogue: 0,0:20:11.57,0:20:14.37,Default,,0,0,0,,‫لن أسمح بذلك أبدًا!
Dialogue: 0,0:20:14.37,0:20:15.99,Default,,0,0,0,,‫لكن لا بأس الآن.
Dialogue: 0,0:20:15.99,0:20:17.86,Default,,0,0,0,,‫بمجرد أن تختفي...
Dialogue: 0,0:20:23.29,0:20:24.80,Default,,0,0,0,,‫انطلقي!
Dialogue: 0,0:20:34.83,0:20:35.97,Default,,0,0,0,,‫ساتشيو.
Dialogue: 0,0:20:36.70,0:20:38.05,Default,,0,0,0,,‫انتظر!
Dialogue: 0,0:20:39.83,0:20:42.71,Default,,0,0,0,,‫أنسة يوشيمي، أنا آسف.
Dialogue: 0,0:20:42.71,0:20:45.53,Default,,0,0,0,,‫سأقضي حياتي في تعويضك.
Dialogue: 0,0:20:45.53,0:20:49.50,Default,,0,0,0,,‫صحيح. أعدكِ أننا أنا وياساتو سنفعل.
Dialogue: 0,0:20:50.38,0:20:52.69,Default,,0,0,0,,‫لذا أرجوكِ سامحينا..
Dialogue: 0,0:20:54.34,0:20:56.65,Default,,0,0,0,,‫هما ليس لهما علاقة بهذا.
Dialogue: 0,0:20:56.65,0:21:00.26,Default,,0,0,0,,‫الخطأ كله خطأنا. نحن آسفون.
Dialogue: 0,0:21:00.26,0:21:02.70,Default,,0,0,0,,‫نعم. نحن آسفون.
Dialogue: 0,0:21:03.35,0:21:07.87,Default,,0,0,0,,‫ربما يكون الأوان قد فات، لكننا سنفعل أي شيء نستطيع.
Dialogue: 0,0:21:19.39,0:21:24.87,DC-ED,,0,0,0,,‫الوقت يمضي، مرة أخرى
Dialogue: 0,0:21:25.27,0:21:29.45,DC-ED,,0,0,0,,‫أن أصادف أزهار الكرز
Dialogue: 0,0:21:30.26,0:21:35.57,DC-ED,,0,0,0,,‫قلبي يترقّب قدومك بفارغ الصبر
Dialogue: 0,0:21:35.76,0:21:40.61,DC-ED,,0,0,0,,‫كالزهرة المتفتحة
Dialogue: 0,0:21:41.16,0:21:47.00,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:21:52.88,0:22:01.99,DC-ED,,0,0,0,,‫مشاعر الاشتياق التي لا تُقابل باللقاء
Dialogue: 0,0:22:03.54,0:22:07.43,DC-ED,,0,0,0,,‫تستمر بلا نهاية
Dialogue: 0,0:22:07.58,0:22:12.96,DC-ED,,0,0,0,,‫رغم محاولاتي المتكررة للنسيان
Dialogue: 0,0:22:14.32,0:22:16.37,DC-ED,,0,0,0,,‫أخبرتني
Dialogue: 0,0:22:16.37,0:22:19.43,DC-ED,,0,0,0,,‫كل المشاعر الدافئة
Dialogue: 0,0:22:19.43,0:22:23.83,DC-ED,,0,0,0,,‫لا تفارقني
Dialogue: 0,0:22:32.11,0:22:38.01,DC-ED,,0,0,0,,‫أطير على الرياح إلى الأبد
Dialogue: 0,0:22:40.90,0:22:44.47,Default,,0,0,0,,هل ستعيدين اليوميزاكورا إلى الأنسة يوشيمي؟
Dialogue: 0,0:22:44.47,0:22:47.72,Default,,0,0,0,,‫نعم، بعد خروجها من السجن.
Dialogue: 0,0:22:47.72,0:22:50.97,Default,,0,0,0,,‫سأشتري لكِ كيمونو جديدًا يا ساتشيو.
Dialogue: 0,0:22:50.97,0:22:52.92,Default,,0,0,0,,‫شكرًا.
Dialogue: 0,0:22:52.92,0:22:54.85,Default,,0,0,0,,‫لن أسمح بذلك!
Dialogue: 0,0:22:57.98,0:23:03.96,Default,,0,0,0,,‫يا أنسة ساتشيو، لن أسمح لكِ بالزواج من أي شخص آخر غير ياساتو.
Dialogue: 0,0:23:03.96,0:23:05.27,Default,,0,0,0,,‫وأنت أيضًا، ياساتو.
Dialogue: 0,0:23:05.27,0:23:07.87,Default,,0,0,0,,‫لا يمكنك الزواج من أي شخص آخر.
Dialogue: 0,0:23:10.74,0:23:14.38,Default,,0,0,0,,‫شكرًا لكم على جميع حسن ضيافتكم.
Dialogue: 0,0:23:14.38,0:23:16.00,Default,,0,0,0,,‫حان وقت العودة إلى ديارنا.
Dialogue: 0,0:23:16.00,0:23:17.66,Default,,0,0,0,,‫لنذهب، أيها الفتى.
Dialogue: 0,0:23:17.66,0:23:18.75,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:23:18.75,0:23:21.00,Default,,0,0,0,,أختي ران؟
Dialogue: 0,0:23:30.64,0:23:34.76,Default,,0,0,0,,‫هيا! لنلحق بالحافلة!
Dialogue: 0,0:23:34.76,0:23:36.52,Default,,0,0,0,,‫لنذهب يا اختي ران.
Dialogue: 0,0:23:36.77,0:23:38.67,Default,,0,0,0,,‫حسنًا، لنعد.
Dialogue: 0,0:23:40.02,0:23:44.69,sign_1191_wish,SIGN RIGHT,0000,0000,0000,,{\an8\fad(1,1644)\frz93\pos(288,238)\c&H0F0F17&}شينيتشي
Dialogue: 0,0:23:40.02,0:23:44.69,sign_1191_wish,SIGN,0000,0000,0000,,{\an7\fad(1,1644)\pos(415,113)\c&H0F0F17&}هل لنا أن نأتي إلى هنا سويًا؟
Dialogue: 0,0:23:40.02,0:23:44.69,sign_1191_wish,SIGN RIGHT,0000,0000,0000,,{\an2\fad(1,1644)\frz93\pos(216,238)\c&H0F0F17&}ران
