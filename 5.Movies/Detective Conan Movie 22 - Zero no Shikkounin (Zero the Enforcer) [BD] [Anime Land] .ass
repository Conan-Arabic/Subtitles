Dialogue: 0,1:35:41.79,1:35:43.30,Title,TS,0,0,0,Conan's Call Log,{\fs50}قبل 15 دقيقة               موري ران
Dialogue: 0,1:35:41.79,1:35:43.30,Title,TS,0,0,0,Conan's Call Log,{\fs50}قبل 20 دقيقة               موري ران
Dialogue: 0,1:35:41.79,1:35:43.30,Title,TS,0,0,0,Conan's Call Log,{\fs50}البريد الصّوتيّ
Dialogue: 0,1:35:41.79,1:35:43.30,Title,TS,0,0,0,Conan's Call Log,{\fs50}السّجلّ
Dialogue: 0,1:35:41.79,1:35:43.30,Title,TS,0,0,0,Conan's Call Log,{\fs50}قبل 5 دقائق               موري ران
Dialogue: 0,1:35:41.79,1:35:43.30,Title,TS,0,0,0,Conan's Call Log,{\fs50}قبل 20 دقيقة            بروفيسور أغاسا
Dialogue: 0,1:35:41.79,1:35:43.30,Title,TS,0,0,0,Conan's Call Log,{\fs50}قبل 20 دقيقة            موري ران
Dialogue: 0,1:35:46.34,1:35:47.90,Default,,0,0,0,,أوه، شينتشي؟
Dialogue: 0,1:35:47.90,1:35:51.35,Default,,0,0,0,,.قُمتُ باللّجوء إلى بُرج الكازينو في حافّة المُحيط الآن
Dialogue: 0,1:35:51.35,1:35:52.13,Default,,0,0,0,,نعم؟
Dialogue: 0,1:35:52.13,1:35:53.83,Default,,0,0,0,,.إتّصل بي عندما تصلكَ هذه الرّسالة
Dialogue: 0,1:35:54.51,1:35:56.74,Default,,0,0,0,,!ماذا؟\N!إلى أين تتّجه الكبسولة؟
Dialogue: 0,1:35:59.59,1:36:01.87,Default,,0,0,0,,...بسبب انفجارٍ مَجهول الأصل
Dialogue: 0,1:36:01.87,1:36:05.17,Default,,0,0,0,,!بهذا المُعدّل، ستصطدِم بالأرض المُستصلَحة بالقُرب من خليج طوكيو
Dialogue: 0,1:36:05.17,1:36:07.17,Default,,0,0,0,,...و على جُزءٍ من تلك الأرض المُستصلَحة
Dialogue: 0,1:36:07.17,1:36:10.73,Default,,0,0,0,,!يُوجد "حافّة المُحيط" حيث قام 30.000 شخصاً باتّخاذ مَلجأٍ هناك
Dialogue: 0,1:36:10.73,1:36:12.99,Default,,0,0,0,,!لَم يعُد بإمكاننا اعتراضها
Dialogue: 0,1:36:13.09,1:36:14.07,Default,,0,0,0,,!إهدأوا
Dialogue: 0,1:36:14.07,1:36:15.15,Default,,0,0,0,,!مازال هناك وَقت
Dialogue: 0,1:36:15.15,1:36:16.10,Default,,0,0,0,,!أرجوكم لا تذعروا
Dialogue: 0,1:36:16.10,1:36:18.60,Default,,0,0,0,,!جميعكم، حافظوا على الهُدوء رجاءً
Dialogue: 0,1:36:19.41,1:36:22.38,Default,,0,0,0,,!ستتمكّنون جميعاً من صعود المَركبات كما حصل عندما أتينا إلى هُنا
Dialogue: 0,1:36:23.21,1:36:23.85,Default,,0,0,0,,!مُفتّش
Dialogue: 0,1:36:24.58,1:36:28.86,Default,,0,0,0,,!بسبب التّقارير المُتناقضة، أحضرَ مَدنيّون مَركباتهم إلى هُنا لاتّخاذ مَلجأ
Dialogue: 0,1:36:28.86,1:36:29.92,Default,,0,0,0,,!ماذا؟
Dialogue: 0,1:36:29.92,1:36:32.71,Default,,0,0,0,,!و بوُجود جِسرين فقط، حركة المُرور مُزدحمةٌ بالكامل
Dialogue: 0,1:36:38.16,1:36:39.62,Default,,0,0,0,,.هذا سيّءٌ جدّاً
Dialogue: 0,1:36:39.62,1:36:41.73,Default,,0,0,0,,!الجّميع مَذعورون
Dialogue: 0,1:36:43.00,1:36:44.33,Default,,0,0,0,,...شينتشي
Dialogue: 0,1:36:46.10,1:36:47.66,Default,,0,0,0,,!سُحقاً\N!لا يتّصل
Dialogue: 0,1:36:47.66,1:36:49.44,Default,,0,0,0,,!!لا يُمكنني الإتّصال بران
Dialogue: 0,1:36:49.44,1:36:51.71,Default,,0,0,0,,ماذا يجب أن نفعل؟\N!لا يُوجد المزيد من الوَقت
Dialogue: 0,1:36:51.71,1:36:55.97,Default,,0,0,0,,!أمورو سان، سأجعلكَ مُعاوني هذه المرّة
Dialogue: 0,1:37:08.46,1:37:10.09,Default,,0,0,0,,.يُوجد ازدحامٌ مُروريٌّ أمامنا
Dialogue: 0,1:37:11.07,1:37:13.67,Default,,0,0,0,,!ألَم يُعطوا تعليمات إخلاءٍ مُلائمة؟
Dialogue: 0,1:38:17.55,1:38:19.53,Default,,0,0,0,,إذاً هذا هو بُرج الكازينو؟
Dialogue: 0,1:38:19.53,1:38:20.67,Default,,0,0,0,,!فورويا سان
Dialogue: 0,1:38:21.97,1:38:25.47,Default,,0,0,0,,!خُلِعَت المِظلّة عن الكبسولة، و هي تتسارع
Dialogue: 0,1:38:25.47,1:38:26.47,Default,,0,0,0,,!و...؟
Dialogue: 0,1:38:26.54,1:38:29.71,Default,,0,0,0,,!وَصلَتنا إحداثيّات نُقطة الهُبوط المُقدّرة من نازو
Dialogue: 0,1:38:29.71,1:38:33.82,Default,,0,0,0,,!بهذا المُعدّل، ستصطدِم ببُرج الكازينو خلال أقلّ من 5 دقائق
Dialogue: 0,1:38:34.82,1:38:36.15,Default,,0,0,0,,!...ران
Dialogue: 0,1:38:36.15,1:38:39.25,Default,,0,0,0,,!سُحقاً\N!ماذا نفعل؟! ماذا نفعل؟
Dialogue: 0,1:38:42.30,1:38:43.42,Default,,0,0,0,,!أمورو سان
Dialogue: 0,1:38:44.80,1:38:46.60,Default,,0,0,0,,!تمسّك جيّداً
Dialogue: 0,1:38:51.73,1:38:53.29,Default,,0,0,0,,!ماذا تفعل، أمورو سان؟
Dialogue: 0,1:39:16.38,1:39:17.25,Default,,0,0,0,,!إنّه هُنا
Dialogue: 1,1:39:32.77,1:39:35.70,Default,,0,0,0,,.ظننتُني كنتُ سأموت هناك
Dialogue: 1,1:39:35.79,1:39:37.92,Default,,0,0,0,,.مع ذلك، كان ذلك مُذهلاً
Dialogue: 0,1:39:37.92,1:39:39.67,Default,,0,0,0,,إذاً؟\Nماذا نفعل؟
Dialogue: 0,1:39:39.67,1:39:41.22,Default,,0,0,0,,.أ-أوه، إنتظر لَحظة
Dialogue: 0,1:39:45.23,1:39:47.43,Default,,0,0,0,,!إتّجه نحو المَبنى الذي تحت الإنشاء
Dialogue: 0,1:39:50.29,1:39:51.29,Default,,0,0,0,,!حسناً
Dialogue: 0,1:39:59.28,1:40:01.46,Default,,0,0,0,,.إيّاكنّ أن تنفصِلن
Dialogue: 0,1:40:01.46,1:40:02.78,Default,,0,0,0,,!لَن نفعل
Dialogue: 0,1:40:02.78,1:40:05.01,Default,,0,0,0,,تحوّل هذا إلى وَضعٍ فوضويٍّ جدّاً، صحيح؟
Dialogue: 0,1:40:16.15,1:40:17.81,Default,,0,0,0,,هل يُمكننا النّجاح بالوُصول؟
Dialogue: 0,1:40:17.81,1:40:22.15,Default,,0,0,0,,...نظراً لارتفاع هذا المَبنى و بُعده عن بُرج الكازينو
Dialogue: 0,1:40:22.15,1:40:25.49,Default,,0,0,0,,.يُفترض أن نتمكّن، إن أسرَعنا من هُنا خلال دقيقة
Dialogue: 0,1:40:23.70,1:40:25.20,Title,TS,0,0,0,Timer,مُؤقّت
Dialogue: 0,1:40:27.22,1:40:28.81,Default,,0,0,0,,!إمّا النّجاح أو الموت
Dialogue: 0,1:40:31.14,1:40:32.98,Default,,0,0,0,Shinichi Mirage,!لنَصِل بالوَقت المُناسب رجاءً
Dialogue: 0,1:40:32.98,1:40:33.98,Default,,0,0,0,Shinichi Mirage,!...ران
Dialogue: 0,1:40:37.07,1:40:38.27,Default,,0,0,0,,ما-ماذا؟
Dialogue: 0,1:40:38.33,1:40:40.32,Default,,0,0,0,,قوّة الحُبّ عظيمةٌ بالتّأكيد، صحيح؟
Dialogue: 0,1:40:40.50,1:40:41.50,Default,,0,0,0,,هاه...؟
Dialogue: 0,1:40:52.07,1:40:54.08,Default,,0,0,0,,...كنتُ بانتظار أن أسألكَ عن هذا منذ فترة
Dialogue: 0,1:40:54.08,1:40:56.33,Default,,0,0,0,,لكن هل لَديكَ حبيبة، أمورو سان؟
Dialogue: 0,1:41:03.32,1:41:06.59,Default,,0,0,0,,...حبيبتي هي
Dialogue: 0,1:41:08.05,1:41:09.87,Default,,0,0,0,,!هذه الدّولة بذاتها
Dialogue: 0,1:41:14.73,1:41:16.23,Default,,0,0,0,,!لننطلِق، أمورو سان
Dialogue: 0,1:41:16.33,1:41:18.98,Default,,0,0,0,,هل يُمكننا تحريكها و لَو لملمترٍ وَاحدٍ فقط؟
Dialogue: 0,1:41:18.98,1:41:20.98,Default,,0,0,0,,!هذا ما أنوي فِعله
Dialogue: 0,1:41:22.55,1:41:24.40,Default,,0,0,0,,...4-5
Dialogue: 0,1:41:24.40,1:41:27.66,Default,,0,0,0,,...1-2-3
Dialogue: 0,1:41:27.66,1:41:28.90,Default,,0,0,0,,!زيرو
Dialogue: 0,1:41:35.83,1:41:37.75,Default,,0,0,0,,!لا فائدة، لَسنا بالإرتفاع الكافي
Dialogue: 0,1:41:37.75,1:41:39.23,Default,,0,0,0,,!هاتِ ما لَديكِ
Dialogue: 0,1:42:13.83,1:42:19.44,Default,,0,0,0,,!إنطلِقي
Dialogue: 0,1:42:32.45,1:42:33.28,Default,,0,0,0,,!ران
Dialogue: 0,1:42:33.28,1:42:34.94,Default,,0,0,0,,!أبي
Dialogue: 0,1:42:35.91,1:42:36.99,Default,,0,0,0,,...ران
Dialogue: 0,1:43:36.51,1:43:38.04,Default,,0,0,0,,.سأعتني بالبقيّة
Dialogue: 0,1:43:38.64,1:43:40.35,Default,,0,0,0,,!تحتاج للذّهاب الآن أيضاً
Dialogue: 0,1:43:40.35,1:43:42.65,Default,,0,0,0,,.مازال هناك شيءٌ وَاحدٌ لَم أكتشفه
Dialogue: 0,1:43:42.99,1:43:46.29,Default,,0,0,0,,لِمَ جررتَ العمّ كوغورو إلى هذا؟
Dialogue: 0,1:43:48.14,1:43:52.18,Default,,0,0,0,,.لا يُمكنني التّحرّي بالأُمور علَنيّاً بسبب مَركزي
Dialogue: 0,1:43:52.18,1:43:57.18,Default,,0,0,0,,.لكن إن توَرّطَ بالحادثة، ستُصبح مُعاوني بالتّأكيد
Dialogue: 0,1:43:58.68,1:44:00.12,Default,,0,0,0,,...و إن حصل ذلك
Dialogue: 0,1:44:00.12,1:44:03.44,Default,,0,0,0,,ألا يعني ذلك بأنّه يُمكنني استعارة بعضٍ من قوّتكَ الحقيقيّة؟
Dialogue: 0,1:44:07.00,1:44:09.30,Default,,0,0,0,,.أنتَ تُبالِغ بتقديري حقّاً
Dialogue: 0,1:44:15.82,1:44:22.79,Song-S,Karaoke,0,0,0,,.تُوجد دائماً حقيقةٌ وَاحدةٌ فقط
Dialogue: 0,1:44:22.79,1:44:37.93,Song-S,Karaoke,0,0,0,,{\fad(0,934)}...لكن أشكال العدالة لا تُعدّ و لا تُحصى كدُموعي
Dialogue: 0,1:44:45.98,1:44:50.23,Song-S,Karaoke,0,0,0,,...ضائعٌ في الظّلام
Dialogue: 0,1:44:51.31,1:44:55.82,Song-S,Karaoke,0,0,0,,.أمسكتُ بسيف الخير و الشّرّ
Dialogue: 0,1:44:56.19,1:44:58.86,Song-S,Karaoke,0,0,0,,...لكن السّيف الذي لَوّحتُ به
Dialogue: 0,1:44:58.86,1:45:04.29,Song-S,Karaoke,0,0,0,,.عاد و جرَحَني
Dialogue: 0,1:45:04.29,1:45:08.04,Song-S,Karaoke,0,0,0,,..."لأنّني بالفِعل، لَديّ "خيرٌ" و "شرّ
Dialogue: 0,1:45:09.34,1:45:10.84,Song-S,Karaoke,0,0,0,,.و "طيشٌ" أيضاً
Dialogue: 0,1:45:11.88,1:45:18.26,Song-S,Karaoke,0,0,0,,.يُوجد حتّى جانبٌ منّي يخدَعني
Dialogue: 0,1:45:20.14,1:45:23.51,Song-S,Karaoke,0,0,0,,...العدالة التي أتصوّرها الآن
Dialogue: 0,1:45:23.51,1:45:26.56,Song-S,Karaoke,0,0,0,,..و المِثاليّات التي تُمثّلني
Dialogue: 0,1:45:26.56,1:45:28.56,Song-S,Karaoke,0,0,0,,...ستُزيل ما يُخيفكِ
Dialogue: 0,1:45:28.56,1:45:31.15,Song-S,Karaoke,0,0,0,,...و ما يُحزنكِ
Dialogue: 0,1:45:31.15,1:45:33.27,Song-S,Karaoke,0,0,0,,.حتّى لا تُؤذي تلك الأشياء أيّ أحد
Dialogue: 0,1:45:33.27,1:45:37.36,Song-S,Karaoke,0,0,0,,.ليبقى الجّميع دون أذى
Dialogue: 0,1:45:37.36,1:45:39.53,Song-S,Karaoke,0,0,0,,...أعرف الآن جيّداً بأنّني
Dialogue: 0,1:45:39.53,1:45:41.99,Song-S,Karaoke,0,0,0,,.لا يُمكنني حمايتكِ أو أيّ شيء
Dialogue: 0,1:45:42.74,1:45:49.62,Song-S,Karaoke,0,0,0,,..."لأنّ مثل حالات "العدالة الكاملة
Dialogue: 0,1:45:50.21,1:45:52.38,Song-S,Karaoke,0,0,0,,.تصل بالمُجمل إلى زيرو
Dialogue: 0,1:45:55.53,1:45:56.78,Title,TS,0,0,0,TV News Sign 17,!!إعتقال مُدّعي أمنٍ عامّ سابق
Dialogue: 0,1:46:02.38,1:46:06.47,Song-S,Karaoke,0,0,0,,...عندما تضيعين في الظّلام
Dialogue: 0,1:46:04.67,1:46:07.67,Title,TS,0,0,0,Finally; Shinichi,من: كودو شينتشي\Nإلى: موري ران\Nالموضوع: لا موضوع\N!سعيدٌ لأنّكِ و المُسنّ سالِمان\N!!شُكراً لإبلاغي\Nشينتشي
Dialogue: 0,1:46:07.77,1:46:11.98,Song-S,Karaoke,0,0,0,,...و لا يعود بإمكانكِ الثّقة بنفسكِ حتّى
Dialogue: 0,1:46:12.48,1:46:17.44,Song-S,Karaoke,0,0,0,,...هناك عددٌ لا يُحصى من الكلِمات و الرّوائع
Dialogue: 0,1:46:17.78,1:46:20.53,Song-S,Karaoke,0,0,0,,...في جميع أرجاء العالَم
Dialogue: 0,1:46:20.53,1:46:24.24,Song-S,Karaoke,0,0,0,,.التي تُحاول استغلال قلبكِ الخائف
Dialogue: 0,1:46:25.70,1:46:27.53,Song-S,Karaoke,0,0,0,,.هي في كلّ مكان
Dialogue: 0,1:46:28.29,1:46:34.80,Song-S,Karaoke,0,0,0,,.تُوجد حتّى روائع تخدعكِ
Dialogue: 0,1:46:36.54,1:46:38.67,Song-S,Karaoke,0,0,0,,.أُريد أن أُدافع عنكِ
Dialogue: 0,1:46:38.67,1:46:42.84,Song-S,Karaoke,0,0,0,,.لكنّني أُريد حماية ابتسامتكِ تلك أيضاً
Dialogue: 0,1:46:42.84,1:46:44.68,Song-S,Karaoke,0,0,0,,...لذا حتّى لَو أحياناً
Dialogue: 0,1:46:44.68,1:46:47.51,Song-S,Karaoke,0,0,0,,...أظهرتُ جانبي الشّرّير لفِعل ذلك
Dialogue: 0,1:46:47.51,1:46:49.52,Song-S,Karaoke,0,0,0,,...هذا لا يهمّ، بإسم الحُبّ
Dialogue: 0,1:46:49.52,1:46:53.64,Song-S,Karaoke,0,0,0,,...سيُقيّد أحدٌ قلبكِ
Dialogue: 0,1:46:53.64,1:46:55.73,Song-S,Karaoke,0,0,0,,.بروابط الحُبّ
Dialogue: 0,1:46:55.73,1:47:01.57,Song-S,Karaoke,0,0,0,,...إن انتهى الأمر بقلبكِ بأن يتأذّى
Dialogue: 0,1:47:01.57,1:47:06.16,Song-S,Karaoke,0,0,0,,...سأستخدِم هذا السّيف
Dialogue: 0,1:47:06.62,1:47:08.66,Song-S,Karaoke,0,0,0,,.لأُنهي ذلك الحُبّ
Dialogue: 0,1:47:33.73,1:47:35.94,Song-S,Karaoke,0,0,0,,.أُريد أن أُدافع عنكِ
Dialogue: 0,1:47:35.94,1:47:40.07,Song-S,Karaoke,0,0,0,,.لكنّني أُريد حماية المُستقبل أيضاً
Dialogue: 0,1:47:40.07,1:47:42.15,Song-S,Karaoke,0,0,0,,...لذا حتّى لَو أحياناً
Dialogue: 0,1:47:42.15,1:47:44.65,Song-S,Karaoke,0,0,0,,...أظهرتُ جانبي الشّرّير لفِعل ذلك
Dialogue: 0,1:47:44.65,1:47:46.86,Song-S,Karaoke,0,0,0,,.سيكون هذا بإسم الحُبّ
Dialogue: 0,1:47:46.86,1:47:50.91,Song-S,Karaoke,0,0,0,,...لأنّه حتّى لَو خسرَ الجّميع طريقهم في الحُبّ
Dialogue: 0,1:47:50.91,1:47:53.00,Song-S,Karaoke,0,0,0,,.تُوجد دائماً حقيقةٌ وَاحدةٌ فقط
Dialogue: 0,1:47:53.00,1:47:55.71,Song-S,Karaoke,0,0,0,,...لكن لا يُوجد دائماً شكلٌ وَاحدٌ فقط
Dialogue: 0,1:47:56.54,1:47:58.84,Song-S,Karaoke,0,0,0,,.للعدالة
Dialogue: 0,1:47:58.84,1:48:03.42,Song-S,Karaoke,0,0,0,,.تُوجد أعدادٌ لا نهاية لها
Dialogue: 0,1:48:03.80,1:48:05.84,Song-S,Karaoke,0,0,0,,.لا يصل مُجملها إلى زيرو
Dialogue: 0,1:48:09.14,1:48:11.31,Song-S,Karaoke,0,0,0,,...لهذا سأبحث
Dialogue: 0,1:48:12.64,1:48:18.82,Song-S,Karaoke,0,0,0,,{\fad(0,854)}...عن زيرو... لما تكون احتماليّته زيرو
Dialogue: 0,1:48:27.98,1:48:33.82,Title,TS,0,0,0,Agasa Nameplate,{=166}أغاسا
Dialogue: 0,1:48:30.50,1:48:34.81,Default,,0,0,0,,".مثل كُتيّبٍ عن الجّريمة، تمّ التّلاعب بعيّنات اختبار الشّرطة"
Dialogue: 0,1:48:33.82,1:48:36.58,Title,,0,0,0,,كوساكابي ماكوتو (40) عاماً
Dialogue: 0,1:48:34.81,1:48:38.55,Default,,0,0,0,,...بارتكابه سِلسلة هجماته الإرهابيّة مع مثل هذا الدّافع الغريب، المُدّعي العامّ السّابق
Dialogue: 0,1:48:36.69,1:48:38.45,Title,,0,0,0,,مَركز المُؤتمرات الدّوليّ المُفجّر
Dialogue: 0,1:48:38.55,1:48:41.88,Default,,0,0,0,,...كوساكابي ماكوتو، سيتعامل معه مَركز شُرطة العاصمة كمُشتبهٍ به
Dialogue: 0,1:48:43.15,1:48:45.55,Default,,0,0,0,,.يبدو بأنّ "الأمن العامّ" قد اختفى من دافعه
Dialogue: 0,1:48:45.45,1:48:49.33,Title,,0,0,0,,الكبسولة سالِمة
Dialogue: 0,1:48:45.55,1:48:49.43,Default,,0,0,0,,.وَاثقٌ من أنّ ذلك كان قرار مَكتب الأمن العامّ
Dialogue: 0,1:48:49.93,1:48:52.43,Default,,0,0,0,,...هبطَت بسلامٍ في خليج طوكيو
Dialogue: 0,1:48:52.33,1:48:55.34,Title,,0,0,0,,إسترجاع الكبسولة من المِسبار الفضائيّ
Dialogue: 0,1:48:52.43,1:48:55.44,Default,,0,0,0,,...و داخل الكبسولة التي تمّ استرجاعها من مِسبار "البجعة" الفضائيّ
Dialogue: 0,1:48:55.34,1:48:56.05,Up,,0,0,0,,!لَذيذ
Dialogue: 0,1:48:55.44,1:48:57.83,Default,,0,0,0,,.كانت مادّةً مَنشأها كوكب مارس
Dialogue: 0,1:48:57.83,1:49:02.08,Default,,0,0,0,,.تمّ تقديمها وَسط الكثير من التّوَقّعات بأنّها ستُساعد بتوضيح بعض ألغاز الكون
Dialogue: 0,1:49:03.61,1:49:04.81,Default,,0,0,0,,!هذا مُذهل
Dialogue: 0,1:49:05.01,1:49:07.42,Default,,0,0,0,,.لكنّني أردتّ أن أرى ذلك بالدرون
Dialogue: 0,1:49:07.68,1:49:10.38,Default,,0,0,0,,...لَو لَم نحمل رُزمة البروفيسور فقط
Dialogue: 0,1:49:12.83,1:49:19.38,Default,,0,0,0,,.لا يملك هؤلاء الأطفال فِكرةً بشأن كيفيّة مُساعدتهم في استعادة الكبسولة
Dialogue: 0,1:49:19.38,1:49:20.39,Default,,0,0,0,,...نعم
Dialogue: 0,1:49:20.39,1:49:23.34,Default,,0,0,0,,.و ساعدوا اليابان للخُروج من أزمةٍ حتّى
Dialogue: 0,1:49:23.34,1:49:26.04,Default,,0,0,0,,.إنّهم مُذهلون حقّاً
Dialogue: 0,1:49:26.34,1:49:27.27,Default,,0,0,0,,!حسناً
Dialogue: 0,1:49:27.27,1:49:30.97,Default,,0,0,0,,!لنستخدِم درون البروفيسور لاستكشاف كوكب مارس أيضاً
Dialogue: 0,1:49:30.97,1:49:32.82,Default,,0,0,0,,!هذا يبدو رائعاً
Dialogue: 0,1:49:32.82,1:49:33.64,Default,,0,0,0,,!نعم، لنفعل ذلك
Dialogue: 0,1:49:33.64,1:49:36.47,Default,,0,0,0,,!أرجوكَ اصنع وَاحدةً جديدة، بروفيسور
Dialogue: 0,1:49:36.47,1:49:38.71,Default,,0,0,0,,!إصنع لنا وَاحدةً أكبر
Dialogue: 0,1:49:39.48,1:49:40.15,Default,,0,0,0,,أوه؟
Dialogue: 0,1:49:40.15,1:49:42.38,Default,,0,0,0,,...حسناً، أظنّني سأبذل جهدي
Dialogue: 0,1:49:44.21,1:49:46.66,Default,,0,0,0,,!أنا مُتحمّسٌ جدّاً لرُؤية لكوكب مارس
Dialogue: 0,1:49:46.66,1:49:48.01,Default,,0,0,0,,!مِثلي! مِثلي
Dialogue: 1,1:49:48.01,1:49:52.49,Default,,0,0,0,,.كلّا، هذا مُستحيل
Dialogue: 0,1:50:02.52,1:50:04.57,Default,,0,0,0,,...لنلتقي ثانيةً
Dialogue: 0,1:50:05.57,1:50:09.01,Default,,0,0,0,,.على السّفينة التي تطفو فوق سماء المَساء
Dialogue: 0,1:50:11.64,1:50:14.68,Title,TS,0,0,0,Movie 23,خلال الأُسبوع الذّهبيّ للسّينما عام 2019
Dialogue: 0,1:50:14.68,1:50:16.68,Title,,0,0,0,,