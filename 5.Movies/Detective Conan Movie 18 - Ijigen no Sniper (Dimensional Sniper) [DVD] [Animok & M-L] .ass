Dialogue: Marked=0,1:17:45.11,1:17:48.74,Default,NTP,0000,0000,0000,!Effect,. . . أوه، حقا؟ حسنا، آسف على ذلك
Dialogue: Marked=0,1:17:48.99,1:17:52.76,Default,NTP,0000,0000,0000,!Effect,يا ربي. . . يا له من مثير لشغب
Dialogue: Marked=0,1:17:52.76,1:17:53.92,Default,NTP,0000,0000,0000,!Effect,! عمّي
Dialogue: Marked=0,1:17:54.10,1:17:56.72,Default,NTP,0000,0000,0000,!Effect,على ما يبدو أن سيرا ني شان استيقظت
Dialogue: Marked=0,1:17:57.14,1:17:59.89,Default,NTP,0000,0000,0000,!Effect,. . .كلنا سنزورها
Dialogue: Marked=0,1:17:59.89,1:18:05.59,Default,NTP,0000,0000,0000,!Effect,. . .آسف، لكنّكم يجب أن تذهبوا بدوني. يجب أن أفكر بشان هذا
Dialogue: Marked=0,1:18:05.59,1:18:08.90,Default,NTP,0000,0000,0000,!Effect,{\pos(424470)}أيها الرجل العجوز، لقد كنت تفكر طوال اللّيل بشأن هذه القضيه؟
Dialogue: Marked=0,1:18:06.08,1:18:08.90,Default,NTP,0000,0000,0000,!Effect,{\pos(42147)}وإذا نظريتي بشأن النرد الأخير الأخير كانت صحيحة
Dialogue: Marked=0,1:18:08.90,1:18:11.15,Default,NTP,0000,0000,0000,!Effect,سأكون قد حللتُ لغز النرد
Dialogue: Marked=0,1:18:11.15,1:18:12.27,Default,NTP,0000,0000,0000,!Effect,ماذا؟ ! حقا؟
Dialogue: Marked=0,1:18:12.27,1:18:18.07,Default,NTP,0000,0000,0000,!Effect,!هاه؟ نعم! ليله واحده من التفكير أكثر من اللازم لمحقق عظيم مثلي لحلّ هذا لغز
Dialogue: Marked=0,1:18:18.29,1:18:20.74,Default,NTP,0000,0000,0000,!Effect,إذا ماذا تعني؟
Dialogue: Marked=0,1:18:20.74,1:18:23.49,Default,NTP,0000,0000,0000,!Effect,!أنهم. . . عدّ تنازلي
Dialogue: Marked=0,1:18:23.49,1:18:24.00,Default,NTP,0000,0000,0000,!Effect,هاه؟
Dialogue: Marked=0,1:18:24.16,1:18:31.50,Default,NTP,0000,0000,0000,!Effect,!لابد أن الجسر اهتز. ولذا النرد تغيّرا من واحد إلى خمسة
Dialogue: Marked=0,1:18:31.50,1:18:35.07,Default,NTP,0000,0000,0000,!Effect,هل ترى؟ عندما تدرك ذلك، تفهم كلّ شيء
Dialogue: Marked=0,1:18:35.07,1:18:38.49,Default,NTP,0000,0000,0000,!Effect,هاه؟ ! أين ذهب ذلك الطفل المشاغب؟
Dialogue: Marked=0,1:18:38.91,1:18:42.93,Default,NTP,0000,0000,0000,!Effect,ذلك ليس عدّ تنازلي. هناك معنى آخر إليه
Dialogue: Marked=0,1:18:43.77,1:18:47.85,Default,NTP,0000,0000,0000,!Effect,يجب أن أصل هناك بسرعة وأراجع ما حدث بالأمس مع سيرا
Dialogue: Marked=0,1:18:54.19,1:18:57.45,Default,NTP,0000,0000,0000,!Effect,. . .هنا! أنه خط إطلاق نار واضح
Dialogue: Marked=0,1:18:57.45,1:19:00.20,Default,NTP,0000,0000,0000,!Effect,! نعم، لقد وجدته
Dialogue: Marked=0,1:19:00.20,1:19:04.39,Default,NTP,0000,0000,0000,!Effect,. . .الموقع المثالي لاستهداف شيغسا
Dialogue: Marked=0,1:19:05.64,1:19:08.42,Default,NTP,0000,0000,0000,!Effect,!هاه !هذه لعبه لي
Dialogue: Marked=0,1:19:11.46,1:19:13.85,Default,NTP,0000,0000,0000,!Effect,! أنت
Dialogue: Marked=0,1:19:13.85,1:19:17.98,Default,NTP,0000,0000,0000,!Effect,لقد اهتمت بشأن ميرفي. والآن حان دورك
Dialogue: Marked=0,1:19:17.98,1:19:20.59,Default,NTP,0000,0000,0000,!Effect,لماذا؟ لماذا أنت تفعل هذا؟
Dialogue: Marked=0,1:19:20.59,1:19:22.50,Default,NTP,0000,0000,0000,!Effect,هل المال السبب؟
Dialogue: Marked=0,1:19:22.50,1:19:25.22,Default,NTP,0000,0000,0000,!Effect,! ما مقدار ما دفعه لك؟  سأضاعفه
Dialogue: Marked=0,1:19:25.22,1:19:27.38,Default,NTP,0000,0000,0000,!Effect,أنت أبدا لا تتغيّر، والتز
Dialogue: Marked=0,1:19:27.38,1:19:28.84,Default,NTP,0000,0000,0000,!Effect,أنا. . . أو ه ه. . .
Dialogue: Marked=0,1:19:28.84,1:19:36.17,Default,NTP,0000,0000,0000,!Effect,دعنا نعقد اتفاق. أنت، هنا في بلد أجنبي. . . يمكنك أن تستخدم بعض المال، أليس كذلك؟
Dialogue: Marked=0,1:19:36.17,1:19:42.46,Default,NTP,0000,0000,0000,!Effect,ليلة الغد، تعال إلى شيغا في اوساكا في الساعة 8 مساء ثم سوف نتناقش
Dialogue: Marked=0,1:19:42.46,1:19:47.31,Default,NTP,0000,0000,0000,!Effect,. . .أوه، نعم، موافق. شيغا في اوساكا
Dialogue: Marked=0,1:19:47.31,1:19:53.00,Default,NTP,0000,0000,0000,!Effect,إذا اعترفت بكلّ شيء. . . اعترف بذنبك. . . سأتركك حيّ
Dialogue: Marked=0,1:19:53.00,1:19:59.79,Default,NTP,0000,0000,0000,!Effect,! على أية حال، حتى لو هذا متأخر جدا، قل وداعا لعائلتك
Dialogue: Marked=0,1:19:59.79,1:20:00.99,Default,NTP,0000,0000,0000,!Effect,هل فهمت؟
Dialogue: Marked=0,1:20:01.69,1:20:04.63,Default,NTP,0000,0000,0000,!Effect,. . .مرحبا؟ مرحبا؟ مهلا، انا
Dialogue: Marked=0,1:20:04.63,1:20:06.35,Default,NTP,0000,0000,0000,!Effect,! لعنه
Dialogue: Marked=0,1:20:08.17,1:20:11.05,Default,NTP,0000,0000,0000,!Effect,. . .هيلين. . . ساره
Dialogue: Marked=0,1:20:11.05,1:20:11.84,Default,NTP,0000,0000,0000,!Effect,! والتز سان
Dialogue: Marked=0,1:20:11.84,1:20:13.19,Default,NTP,0000,0000,0000,!Effect,! لدينا مشكلة
Dialogue: Marked=0,1:20:13.19,1:20:17.06,Default,NTP,0000,0000,0000,!Effect,لقد تمت رؤية غرين في محطة شين أوساكا
Dialogue: Marked=0,1:20:17.39,1:20:19.81,Default,NTP,0000,0000,0000,!Effect,!أنه خطر جدا حتى تذهب إلى مطار كبنسي الدولي في الوقت الحاضر
Dialogue: Marked=0,1:20:19.81,1:20:22.81,Default,NTP,0000,0000,0000,!Effect,أنا آسف، لكنّك يجب أن لا تغادر اليابان غدا
Dialogue: Marked=0,1:20:24.08,1:20:28.32,Default,NTP,0000,0000,0000,!Effect,لعنة! إما تقتل أو يتم قتلك
Dialogue: Marked=0,1:20:31.02,1:20:34.54,Default,NTP,0000,0000,0000,!Effect,هنا، الموقع المثالي لاستهداف شيغسا
Dialogue: Marked=0,1:20:34.54,1:20:37.25,Default,NTP,0000,0000,0000,!Effect,! سوف يختار هذا المكان – هذا ما تدرب عليه
Dialogue: Marked=0,1:20:37.25,1:20:38.55,Default,NTP,0000,0000,0000,!Effect,! حلم أي قنّاص
Dialogue: Marked=0,1:20:38.55,1:20:43.80,Default,NTP,0000,0000,0000,!Effect,! لكن اللّيلة ليس أنا من سيكون الهدف – بل هو
Dialogue: Marked=0,1:20:44.25,1:20:47.72,Default,NTP,0000,0000,0000,!Effect,. . .ضع قنّاص لهزيمة قنّاص
Dialogue: Marked=0,1:20:50.69,1:20:53.51,Default,NTP,0000,0000,0000,!Effect,. . .كلّ شيء عباره عن توقع
Dialogue: Marked=0,1:20:53.51,1:20:58.32,Default,NTP,0000,0000,0000,!Effect,. . .توقّع، حركات خصمك، تكسب فائدة تقنيه
Dialogue: Marked=0,1:20:58.32,1:21:02.74,Default,NTP,0000,0000,0000,!Effect,الأهمّ من ذلك، يضمن موقع متفوّق لنصر
Dialogue: Marked=0,1:21:02.74,1:21:06.07,Default,NTP,0000,0000,0000,!Effect,. . .الحقيقة إيجادي لهذا الموقع
Dialogue: Marked=0,1:21:06.07,1:21:09.08,Default,NTP,0000,0000,0000,!Effect,! نصر لي
Dialogue: Marked=0,1:21:09.08,1:21:12.11,Default,NTP,0000,0000,0000,!Effect,! تتحدّاني، تخسر
Dialogue: Marked=0,1:21:12.11,1:21:15.03,Default,NTP,0000,0000,0000,!Effect,! قل "مرحبا" إلى هنتر في الجحيم
Dialogue: Marked=0,1:21:17.45,1:21:20.59,Default,NTP,0000,0000,0000,!Effect,هاه؟ كونان كون، هل جئت هنا لوحدك؟
Dialogue: Marked=0,1:21:20.59,1:21:23.21,Default,NTP,0000,0000,0000,!Effect,نعم، الآخرون قادمين عبر السيارة
Dialogue: Marked=0,1:21:23.21,1:21:24.59,Default,NTP,0000,0000,0000,!Effect,آه.
Dialogue: Marked=0,1:21:24.59,1:21:28.51,Default,NTP,0000,0000,0000,!Effect,ال كنت على وشك الذهاب إلى الدكان، هل تريد المجيء معي؟
Dialogue: Marked=0,1:21:28.51,1:21:30.21,Default,NTP,0000,0000,0000,!Effect,لا، سأنتظر هنا
Dialogue: Marked=0,1:21:31.38,1:21:32.77,Default,NTP,0000,0000,0000,!Effect,! حسنا، دعينا نذهب، سونكو
Dialogue: Marked=0,1:21:32.77,1:21:35.79,Default,NTP,0000,0000,0000,!Effect,صحيح! سيرا سان، سوف نخرج قليلا
Dialogue: Marked=0,1:21:35.79,1:21:36.40,Default,NTP,0000,0000,0000,!Effect,حسنا، شكرا لكم
Dialogue: Marked=0,1:21:36.40,1:21:38.31,Default,NTP,0000,0000,0000,!Effect,سوف نعود بسرعه
Dialogue: Marked=0,1:21:38.31,1:21:39.97,Default,NTP,0000,0000,0000,!Effect,أعلمنا إذا حدث شيء
Dialogue: Marked=0,1:21:39.97,1:21:41.43,Default,NTP,0000,0000,0000,!Effect,! بالطبع
Dialogue: Marked=0,1:21:42.44,1:21:44.03,Default,NTP,0000,0000,0000,!Effect,مرحبا، كونان كون
Dialogue: Marked=0,1:21:44.03,1:21:47.53,Default,NTP,0000,0000,0000,!Effect,يبدو أن الرصاصة لم تصيبك
Dialogue: Marked=0,1:21:50.30,1:21:52.87,Default,NTP,0000,0000,0000,!Effect,. . .لم اجد فرصه لشكرك
Dialogue: Marked=0,1:21:52.87,1:21:57.29,Default,NTP,0000,0000,0000,!Effect,لا تقلق، كُنت فقط أحافظ على وعدي مع ران كون
Dialogue: Marked=0,1:21:57.29,1:21:58.88,Default,NTP,0000,0000,0000,!Effect,لكن ماذا عن القنّاص. . . ؟
Dialogue: Marked=0,1:21:59.28,1:22:02.86,Default,NTP,0000,0000,0000,!Effect,. . . المشتبه بهم ما زالوا مختفين
Dialogue: Marked=0,1:22:02.86,1:22:03.55,Default,NTP,0000,0000,0000,!Effect,حقا؟
Dialogue: Marked=0,1:22:04.42,1:22:08.14,Default,NTP,0000,0000,0000,!Effect,. . .بالأمس، لاحظت شيئا عندما أصبت
Dialogue: Marked=0,1:22:08.99,1:22:12.64,Default,NTP,0000,0000,0000,!Effect,القنّاص كان يستخدم ليزر
Dialogue: Marked=0,1:22:12.64,1:22:15.01,Default,NTP,0000,0000,0000,!Effect,أليس ذلك الغريب؟
Dialogue: Marked=0,1:22:15.01,1:22:21.13,Default,NTP,0000,0000,0000,!Effect,القنّاصون لا يستخدمون ليزر حتى لا يعرف الهدف أن أحدهم سيطلق النار عليه وحتى لا يعلم أحدهم مكانه
Dialogue: Marked=0,1:22:21.58,1:22:26.54,Default,NTP,0000,0000,0000,!Effect,. . .فهمت. لهذا هنتر زيّف أطلاق النار عليه بدلا من أن ينتحر
Dialogue: Marked=0,1:22:26.54,1:22:28.32,Default,NTP,0000,0000,0000,!Effect,هاه؟ ماذا تعني؟
Dialogue: Marked=0,1:22:28.32,1:22:31.61,Default,NTP,0000,0000,0000,!Effect,إذا أنتحر، التحقيق سوف يلغى بالكامل
Dialogue: Marked=0,1:22:31.61,1:22:34.25,Default,NTP,0000,0000,0000,!Effect,ميرفي و والتز سان سوف يتخلون عن حذرهم ؟
Dialogue: Marked=0,1:22:35.35,1:22:37.20,Default,NTP,0000,0000,0000,!Effect,لكنّه لم بفعل ذلك
Dialogue: Marked=0,1:22:37.20,1:22:45.81,Default,NTP,0000,0000,0000,!Effect,!فهمت. ذلك كان الاختبار النهائي للقاتل، حتى يجعله إلى قنّاص وحشي حقيقي
Dialogue: Marked=0,1:22:46.24,1:22:47.28,Default,NTP,0000,0000,0000,!Effect,نعم
Dialogue: Marked=0,1:22:47.93,1:22:52.11,Default,NTP,0000,0000,0000,!Effect,القنص الأول كان المدى الأقصى لإم كي 11
Dialogue: Marked=0,1:22:52.11,1:22:55.08,Default,NTP,0000,0000,0000,!Effect,القنص الثانية كان لهدف متحرك أثناء ليل
Dialogue: Marked=0,1:22:55.08,1:22:59.77,Default,NTP,0000,0000,0000,!Effect,والقنص الثلث كان أختبار إذا مشاعره لن تغيّر أبدا رأيه
Dialogue: Marked=0,1:23:00.40,1:23:05.73,Default,NTP,0000,0000,0000,!Effect,! هنتر كان يحول قاتله إلى قنّاص محترف، حتى بعد موته
