Dialogue: 0,0:00:01.10,0:00:09.90,Default,,0,0,0,,{\an8}Aoibu_Arabic
Dialogue: 0,0:00:34.95,0:00:35.95,Default,,0,0,0,,!انتظر
Dialogue: 0,0:00:39.54,0:00:40.37,Default,,0,0,0,,من يكون؟
Dialogue: 0,0:00:40.67,0:00:44.67,Default,,0,0,0,,!أنت!، ماذا تفعل هناك؟، ابتعد من هنا
Dialogue: 0,0:02:13.68,0:02:15.14,Default,,0,0,0,,!من هناك
Dialogue: 0,0:02:38.28,0:02:40.49,Default,,0,0,0,,.أنا أويهارا من شرطة محافظة ناغانو
Dialogue: 0,0:02:40.58,0:02:41.87,Default,,0,0,0,,من أبلغنا؟
Dialogue: 0,0:02:42.00,0:02:43.46,Default,,0,0,0,,.إنه أنا
Dialogue: 0,0:02:43.58,0:02:45.54,Default,,0,0,0,,...طلب مني البروفيسور أوتشي
Dialogue: 0,0:02:45.67,0:02:48.71,Default,,0,0,0,,...حينها سمعت صراخها
Dialogue: 0,0:02:48.84,0:02:51.22,Default,,0,0,0,,.عندما تعرّضتُ للهجوم داخل برج المراقبة
Dialogue: 0,0:02:51.34,0:02:53.76,Default,,0,0,0,,.جاء السيد أوتشي لمساعدتي على الفور
Dialogue: 0,0:02:53.88,0:02:57.47,Default,,0,0,0,,هل رأيت وجه المهاجم الذي اعتدى عليكِ!؟
Dialogue: 0,0:02:57.72,0:03:01.47,Default,,0,0,0,,...لا، لأنه كان يرتدي قلنسوة
Dialogue: 0,0:03:05.73,0:03:09.03,Default,,0,0,0,,.هذا تلسكوب لاسلكي بطول 45 مترًا
Dialogue: 0,0:03:09.15,0:03:12.57,Default,,0,0,0,,.إنه يجري عمليات المراقبة حاليَا
Dialogue: 0,0:03:15.90,0:03:18.32,Default,,0,0,0,,!يا مفتش ياماتو!، ‏كان-تشان
Dialogue: 0,0:03:18.53,0:03:21.07,Default,,0,0,0,,ماخطبك؟، هل أنت بخير؟
Dialogue: 0,0:03:21.33,0:03:22.62,Default,,0,0,0,,!كان-تشان
Dialogue: 0,0:03:32.21,0:03:34.34,Default,,0,0,0,,أيتها السماء العظيمة ذات الرعد الثلجي
Dialogue: 0,0:03:35.55,0:03:39.60,Default,,0,0,0,,!امنحيني قوتك في نصلي
Dialogue: 0,0:03:39.72,0:03:44.93,Default,,0,0,0,,!الضربة القاضية! صاعقة يايبا
Dialogue: 0,0:03:47.64,0:03:50.44,Default,,0,0,0,,لماذا لماذا!؟
Dialogue: 0,0:03:50.56,0:03:53.56,Default,,0,0,0,,!لماذا اختفى في أروع مشهد؟
Dialogue: 0,0:03:53.69,0:03:55.44,Default,,0,0,0,,...طقس اليوم
Dialogue: 0,0:03:55.57,0:03:57.66,Default,,0,0,0,,.كل القنوات تعمل باستثناء القمر الصناعي
Dialogue: 0,0:03:57.78,0:03:58.57,Default,,0,0,0,,.لا فائدة إذن
Dialogue: 0,0:03:58.70,0:04:00.99,Default,,0,0,0,,!أيها البروفيسور! أجب من فضلك أيها البروفيسور
Dialogue: 0,0:04:01.45,0:04:03.79,Default,,0,0,0,,.لا فائدة كما توقعت
Dialogue: 0,0:04:03.91,0:04:06.25,Default,,0,0,0,,.يبدو أن السبب هو الهوائي اللاقط
Dialogue: 0,0:04:06.37,0:04:08.21,Default,,0,0,0,,!تبًا، لقد كان في أفضل مشهد
Dialogue: 0,0:04:08.33,0:04:11.33,Default,,0,0,0,,!لماذا يعمل كل شيء باستثناء القمر الصناعي؟
Dialogue: 0,0:04:12.59,0:04:13.72,Default,,0,0,0,,...ذلك لأنه
Dialogue: 0,0:04:13.84,0:04:15.68,Default,,0,0,0,,.سأشرح لكم
Dialogue: 0,0:04:15.80,0:04:20.22,Default,,0,0,0,,،البث الفضائي يُستقبل بواسطة الهوائي اللاقط
Dialogue: 0,0:04:20.34,0:04:22.38,Default,,0,0,0,,يستقبل الموجات من أين؟
Dialogue: 0,0:04:22.51,0:04:24.60,Default,,0,0,0,,من الفضاء، أليس كذلك يا بروفيسور؟
Dialogue: 0,0:04:24.72,0:04:26.39,Default,,0,0,0,,نعم، من الفضاء!
Dialogue: 0,0:04:26.64,0:04:28.64,Default,,0,0,0,,!هذا رائع
Dialogue: 0,0:04:28.77,0:04:30.27,Default,,0,0,0,,.صحيح!، لقد نسيت
Dialogue: 0,0:04:30.90,0:04:33.19,Default,,0,0,0,,أترون! ما هذا؟
Dialogue: 0,0:04:33.32,0:04:35.45,Default,,0,0,0,,أهذه تذكار مرصد نوبياما الوطني؟
Dialogue: 0,0:04:36.57,0:04:38.45,Default,,0,0,0,,إنه مرصد في محافظة ناغانو. صحيح؟
Dialogue: 0,0:04:38.57,0:04:41.66,Default,,0,0,0,,.زميل لي من أيام الجامعة وهو بروفيسور هناك
Dialogue: 0,0:04:41.78,0:04:44.66,Default,,0,0,0,,.دعاني لزيارته
Dialogue: 0,0:04:44.79,0:04:48.92,Default,,0,0,0,,إنه أمر مفاجئ، لكن ماذا عن الاثنين القادم؟\N.إنها عطلة شتوية، بعد كل شيء
Dialogue: 0,0:04:49.04,0:04:53.84,Default,,0,0,0,,.فإذا ذهبنا بخمسة أشخاص أو أكثر، فسينظم لنا جولة مراقبة فلكية
Dialogue: 0,0:04:53.96,0:04:55.63,Default,,0,0,0,,.آسف، لا أستطيع الذهاب
Dialogue: 0,0:04:55.75,0:04:58.46,Default,,0,0,0,,لماذا!؟
Dialogue: 0,0:04:58.59,0:05:00.84,Default,,0,0,0,,.لأنني سأحضر في ذلك اليوم مباراة كرة قدم
Dialogue: 0,0:05:00.97,0:05:02.56,Default,,0,0,0,,.وقد حصلت على التذاكر بالفعل
Dialogue: 0,0:05:02.68,0:05:04.35,Default,,0,0,0,,مع من ستذهب؟
Dialogue: 0,0:05:05.10,0:05:07.10,Default,,0,0,0,,...مع أختي ران
Dialogue: 0,0:05:07.35,0:05:09.06,Default,,0,0,0,,.إذن لا خيار لدينا
Dialogue: 0,0:05:09.18,0:05:11.10,Default,,0,0,0,,!إذا لم نكن خمسة، فلا يمكننا القيام بالجولة
Dialogue: 0,0:05:11.35,0:05:12.73,Default,,0,0,0,,!لا بأس
Dialogue: 0,0:05:12.85,0:05:15.73,Default,,0,0,0,,.بإدخالي كمرافق سنصبح خمسة
Dialogue: 0,0:05:15.86,0:05:17.45,Default,,0,0,0,,!رائع
Dialogue: 0,0:05:17.57,0:05:20.57,Default,,0,0,0,,!سنرى النجوم
Dialogue: 0,0:05:28.45,0:05:31.45,Default,,0,0,0,,...أبي... العشاء سيكون جاهزًا قريبًا
Dialogue: 0,0:05:32.79,0:05:33.79,Default,,0,0,0,,!تبًا
Dialogue: 0,0:05:33.92,0:05:37.84,Default,,0,0,0,,كم مرة أخبرتك بألا تشرب الكحول قبل الطعام!؟
Dialogue: 0,0:05:37.96,0:05:40.34,Default,,0,0,0,,.والتلفاز ما يزال مفتوحًا
Dialogue: 0,0:05:40.47,0:05:42.76,Default,,0,0,0,,أين جهاز التحكم؟
Dialogue: 0,0:05:42.88,0:05:44.17,Default,,0,0,0,,.لقد عدت
Dialogue: 0,0:05:44.30,0:05:47.39,Default,,0,0,0,,.يا كونان، هل تعرف أين جهاز تحكم التلفاز؟
Dialogue: 0,0:05:48.89,0:05:51.77,Default,,0,0,0,,.القدر يفور! آسفة، ابحث عن جهاز التحكم
Dialogue: 0,0:05:51.89,0:05:53.23,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:05:53.44,0:05:58.40,Default,,0,0,0,,.توسع حد أحكام صفقة الإقرار بالذنب ، وبدأ تطبيق قانون التقاضي
Dialogue: 0,0:05:59.32,0:06:02.45,Default,,0,0,0,,!شبعت! شبعت
Dialogue: 0,0:06:02.61,0:06:04.65,Default,,0,0,0,,.هذا مريح حقًا
Dialogue: 0,0:06:04.78,0:06:08.45,Default,,0,0,0,,!الآن يمكننا استخدام هواتفنا الذكية بوصفها أجهزة تحكم
Dialogue: 0,0:06:08.58,0:06:09.79,Default,,0,0,0,,!أتعلمان ما يعنيه ذلك؟
Dialogue: 0,0:06:10.33,0:06:13.92,Default,,0,0,0,,!الهواتف تفعل كل شيء؛ لذا لم نعد بحاجة إلى أجهزة التحكم بعد الآن
Dialogue: 0,0:06:15.54,0:06:18.29,Default,,0,0,0,,.مستحيل، كل ما فعلته هو استخدام تطبيق لذلك
Dialogue: 0,0:06:18.42,0:06:21.17,Default,,0,0,0,,.لذلك من الأفضل أن تبحث عن جهاز التحكم
Dialogue: 0,0:06:21.30,0:06:22.97,Default,,0,0,0,,.مرحبًا، منزل موري
Dialogue: 0,0:06:23.09,0:06:25.18,Default,,0,0,0,,.أختي ران كانت غاضبة من ذلك
Dialogue: 0,0:06:25.30,0:06:28.43,Default,,0,0,0,,.لا يهمني
Dialogue: 0,0:06:28.56,0:06:32.44,Default,,0,0,0,,.أبي، هناك مكالمة هاتفية من شخص اسمه السيد ساميتاني
Dialogue: 0,0:06:32.56,0:06:35.52,Default,,0,0,0,,.ساميتاني؟، لا أعرفه
Dialogue: 0,0:06:35.65,0:06:39.32,Default,,0,0,0,,.يقول إنه عمل معك أيام عملك في شرطة العاصمة
Dialogue: 0,0:06:39.44,0:06:41.82,Default,,0,0,0,,.هيا رد بسرعة
Dialogue: 0,0:06:41.94,0:06:43.40,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:06:43.95,0:06:46.08,Default,,0,0,0,,.نعم، معك موري
Dialogue: 0,0:06:48.91,0:06:51.20,Default,,0,0,0,,!واني
Dialogue: 0,0:06:51.33,0:06:52.87,Default,,0,0,0,,واني؟
Dialogue: 0,0:06:53.00,0:06:55.59,Default,,0,0,0,,هل ما تزال تعمل بذلك العمل؟
Dialogue: 0,0:06:55.71,0:06:57.88,Default,,0,0,0,,.لا، أنا الآن في ‏وظيفة مكتبية
Dialogue: 0,0:06:58.38,0:07:00.88,Default,,0,0,0,,."أعمل فيما يسمى بـ "غرفة إعداد الإصلاحات
Dialogue: 0,0:07:01.00,0:07:04.63,Default,,0,0,0,,...أرى كل يوم العديد من ملفات الجرائم السابقة
Dialogue: 0,0:07:04.76,0:07:07.89,Default,,0,0,0,,.لأعثر على البيانات التي يمكن استخدامها لإصلاح الشرطة
Dialogue: 0,0:07:11.47,0:07:14.26,Default,,0,0,0,,.وكتابة تقارير عنها كي تُتجاهَل
Dialogue: 0,0:07:14.39,0:07:17.77,Default,,0,0,0,,ماذا؟ ألم تُهمّش سابقًا؟
Dialogue: 0,0:07:18.36,0:07:20.45,Default,,0,0,0,,.لا تكن صريحًا هكذا
Dialogue: 0,0:07:20.86,0:07:26.03,Default,,0,0,0,,!لا أصدق كيف انتهى الحال بمحقق بارعٍ مثلك إلى هذا الوضع
Dialogue: 0,0:07:26.15,0:07:28.28,Default,,0,0,0,,!بارعً إذن
Dialogue: 0,0:07:28.82,0:07:34.16,Default,,0,0,0,,لكن... لم أستطع منافستك في مهارة استخدام السلاح، ليس كذلك؟
Dialogue: 0,0:07:34.29,0:07:37.17,Default,,0,0,0,,.أشعر بالحنين لأيام التحقيق معًا
Dialogue: 0,0:07:37.29,0:07:38.88,Default,,0,0,0,,.نعم، هذا يذكرني بالماضي
Dialogue: 0,0:07:39.00,0:07:43.00,Default,,0,0,0,,.كنا ندفع ثمن الشراب لمن يحل القضية أولاً
Dialogue: 0,0:07:43.13,0:07:46.18,Default,,0,0,0,,.دعني أرى هيأتك وأنت تطلق النار يومًا ما
Dialogue: 0,0:07:46.30,0:07:47.68,Default,,0,0,0,,هل تحمل مسدسًا؟
Dialogue: 0,0:07:47.80,0:07:50.22,Default,,0,0,0,,!ما هذا الكلام السخيف؟، طبعا لا
Dialogue: 0,0:07:50.35,0:07:53.06,Default,,0,0,0,,!بالمناسبة يا كوغورو
Dialogue: 0,0:07:53.18,0:07:56.52,Default,,0,0,0,,هل تعرف المفتش ياماتو كانسوكي من شرطة محافظة ناغانو؟
Dialogue: 0,0:07:56.64,0:07:57.93,Default,,0,0,0,,ياماتو كانسوكي؟
Dialogue: 0,0:07:58.40,0:08:01.65,Default,,0,0,0,,.نعم، قمنا بحل قضية معًا مرة
Dialogue: 0,0:08:01.77,0:08:03.19,Default,,0,0,0,,.هكذا إذن
Dialogue: 0,0:08:03.32,0:08:05.70,Default,,0,0,0,,...بالمناسبة، هل تعلم عن
Dialogue: 0,0:08:05.82,0:08:10.91,Default,,0,0,0,,الانهيار الجليدي الذي حدث قبل 10 أشهر في ميتاكاراداكي في ناغانو؟
Dialogue: 0,0:08:11.03,0:08:13.91,Default,,0,0,0,,.المرة التي أصيب فيها المفتش ياماتو
Dialogue: 0,0:08:16.29,0:08:22.80,Default,,0,0,0,,.سمعت أنه علق في انهيار جليدي أثناء مطاردته لشخص ما
Dialogue: 0,0:08:23.00,0:08:24.63,Default,,0,0,0,,كوغورو، هل يمكنني مقابلتك الآن!؟
Dialogue: 0,0:08:26.13,0:08:28.63,Default,,0,0,0,,.مهلاً، هل أنت بخير؟ اهدأ
Dialogue: 0,0:08:29.05,0:08:30.64,Default,,0,0,0,,بوقت كهذا؟
Dialogue: 0,0:08:30.76,0:08:32.93,Default,,0,0,0,,آسف. ماذا عن الغد...؟
Dialogue: 0,0:08:33.05,0:08:36.68,Default,,0,0,0,,.لا، انتظر!، غدًا لا أستطيع؛ فإن علي أن أذهب إلى ناغانو
Dialogue: 0,0:08:36.81,0:08:38.94,Default,,0,0,0,,هل يمكنني مقابلتك يوم الاثنين؟
Dialogue: 0,0:08:39.06,0:08:41.81,Default,,0,0,0,,حسنًا، لكن ما الأمر؟
Dialogue: 0,0:08:41.94,0:08:49.16,Default,,0,0,0,,إذن، هل نلتقي في تمام التاسعة صباحًا في مركز\Nالشرطة... لا، ذلك ليس جيدًا.. ماذا عن حديقة هيبيا؟
Dialogue: 0,0:08:49.28,0:08:50.49,Default,,0,0,0,,.نعم، فهمت
Dialogue: 0,0:08:51.07,0:08:53.82,Default,,0,0,0,,.آسف ، أنا ممتن لك، كوغورو
Dialogue: 0,0:08:53.95,0:08:55.74,Default,,0,0,0,,!‏إنه طلب "واني" بعد كل شيء
Dialogue: 0,0:08:57.00,0:09:03.13,Default,,0,0,0,,إذا كنت ممتنًا لهذه الدرجة، فكما كان في\N.الماضي، يبدو أنك ستدفع ثمن شرابي
Dialogue: 0,0:09:03.25,0:09:05.17,Default,,0,0,0,,.أفا عليك يا أبي
Dialogue: 0,0:09:05.30,0:09:06.84,Default,,0,0,0,,إذن، هل أنت متزوج؟
Dialogue: 0,0:09:06.96,0:09:09.92,Default,,0,0,0,,!ما أزال أعزب
Dialogue: 0,0:09:16.51,0:09:19.22,Default,,0,0,0,,لماذا أنتم تتبعونني؟
Dialogue: 0,0:09:19.35,0:09:21.14,Default,,0,0,0,,.لأننا نريد مقابلته
Dialogue: 0,0:09:21.27,0:09:23.81,Default,,0,0,0,,.أعني المحقق الذي كان صديقًا لك يا أبي
Dialogue: 0,0:09:23.94,0:09:25.86,Default,,0,0,0,,ألستما ذاهبين لمشاهدة مباراة كرة قدم لاحقًا؟
Dialogue: 0,0:09:25.98,0:09:28.90,Default,,0,0,0,,.قضاء العطلة بالتجوال مع طفل يثبت مدى الفراغ الكبير
Dialogue: 0,0:09:29.11,0:09:30.99,Default,,0,0,0,,.لا بأس في ذلك
Dialogue: 0,0:09:31.11,0:09:34.03,Default,,0,0,0,,...في الواقع، كنت قد دعوت شينيتشي
Dialogue: 0,0:09:34.16,0:09:37.08,Default,,0,0,0,,...لكنه قال إن لديه عمل ولن يستطيع الحضور
Dialogue: 0,0:09:37.20,0:09:39.29,Default,,0,0,0,,.يا له من أحمق مهووس بالتحقيقات
Dialogue: 0,0:09:40.00,0:09:42.92,Default,,0,0,0,,!الأحمق المهووس بالتحقيقات نفسه موجود بجانبكِ
Dialogue: 0,0:10:14.36,0:10:15.34,Default,,0,0,0,,ما هذا الصوت؟
Dialogue: 0,0:10:15.34,0:10:16.82,Default,,0,0,0,,!طلقة نارية
Dialogue: 0,0:10:18.58,0:10:20.58,Default,,0,0,0,,!انتظر يا كونان
Dialogue: 0,0:10:21.66,0:10:23.54,Default,,0,0,0,,!لا تلمسه
Dialogue: 0,0:10:25.04,0:10:25.73,Default,,0,0,0,,!توقف
Dialogue: 0,0:10:25.73,0:10:27.17,Default,,0,0,0,,!ماذا حدث يا واني؟
Dialogue: 0,0:10:27.29,0:10:28.90,Default,,0,0,0,,!إذن هذا هو واني؟
Dialogue: 0,0:10:34.51,0:10:35.68,Default,,0,0,0,,!أيها الوغد
Dialogue: 0,0:10:47.61,0:10:50.61,Default,,0,0,0,,.ذاك هو المجرم، لا شك بذلك
Dialogue: 0,0:11:00.41,0:11:03.16,Default,,0,0,0,,.أين تظن أنك ستهرب
Dialogue: 0,0:11:33.86,0:11:35.78,Default,,0,0,0,,!انطلقي
Dialogue: 0,0:11:52.80,0:11:53.55,Default,,0,0,0,,!تبًا
Dialogue: 0,0:11:59.47,0:12:01.31,Default,,0,0,0,,.هذه الدراجة التي رأيتها في وقت سابق
Dialogue: 0,0:12:02.10,0:12:04.06,Default,,0,0,0,,!لقد هرب
Dialogue: 0,0:12:33.46,0:12:36.13,Default,,0,0,0,,انا كودو شينيتشي، محقق الثانوية
Dialogue: 0,0:12:36.58,0:12:40.59,Default,,0,0,0,,ذهبت إلى مدينة الملاهي مع صديقة طفولتي وزميلتي ران موري
Dialogue: 0,0:12:40.71,0:12:44.97,Default,,0,0,0,,.وشهدت بالصدفة صفقة مشبوهة بين رجال يرتدون ملابس سوداء
Dialogue: 0,0:12:45.43,0:12:47.64,Default,,0,0,0,, ..عندما كنت مشغولاً بمشاهدة الصفقة
Dialogue: 0,0:12:47.76,0:12:51.31,Default,,0,0,0,,.لم الاحظ رجلًا آخر يتسلل نحوي من الخلف
Dialogue: 0,0:12:52.52,0:12:55.06,Default,,0,0,0,,ذلك الرجل أعطاني عقارًا سامًا
Dialogue: 0,0:12:55.19,0:12:56.77,Default,,0,0,0,,...وعندما استيقظتُ
Dialogue: 0,0:12:58.82,0:13:00.98,Default,,0,0,0,,!كان جسدي قد تقلص
Dialogue: 0,0:13:01.44,0:13:03.99,Default,,0,0,0,,إذا اكتشف الأشرار أن شينيتشي كودو ما يزال على قيد الحياة
Dialogue: 0,0:13:04.11,0:13:07.74,Default,,0,0,0,,.سيحاولون قتلي مرة أخرى، وسيصاب الأشخاص من حولي بالأذى
Dialogue: 0,0:13:09.12,0:13:12.50,Default,,0,0,0,,نصحني الدكتور أغاسا بالحفاظ على سرية هويتي
Dialogue: 0,0:13:12.62,0:13:15.46,Default,,0,0,0,,...وعندما سألتني ران عن اسمي
Dialogue: 0,0:13:15.83,0:13:18.13,Default,,0,0,0,,سميتُ نفسي إيدوغاوا كونان
Dialogue: 0,0:13:18.25,0:13:25.05,Default,,0,0,0,,.لجمع معلومات عن الرجال ذوي اللباس الأسود، انتقلت للعيش مع ران التي يعمل والدها كوغورو موري محققًا خاصًا
Dialogue: 0,0:13:27.51,0:13:32.18,Default,,0,0,0,,.هذا رجل يدعى تورو أمورو يعمل في مقهى بوارو أسفل وكالة موري للتحقيقات
Dialogue: 0,0:13:32.77,0:13:34.23,Default,,0,0,0,,....ولكن هويته الحقيقية
Dialogue: 0,0:13:34.35,0:13:39.52,Default,,0,0,0,,... ري فورويا، الذي يعمل في قسم زيرو، المنظمة التي تدير مكتب السلامة العامة
Dialogue: 0,0:13:39.65,0:13:43.78,Default,,0,0,0,,.يويا كازامي يعمل لدى فورويا، في قسم الأمن العام في شرطة العاصمة
Dialogue: 0,0:13:44.19,0:13:46.82,Default,,0,0,0,,وبالطبع، هيروميتسو موروفوشي
Dialogue: 0,0:13:47.03,0:13:50.83,Default,,0,0,0,,...لقد كان زميلاً لفورويا في مدرسة الشرطة، ومن المرجح أنه كان يعمل في جهاز الأمن العام
Dialogue: 0,0:13:51.16,0:13:53.95,Default,,0,0,0,,.لكن على ما يبدو.. إنه مات أثناء العمل
Dialogue: 0,0:13:55.16,0:14:00.88,Default,,0,0,0,,."والأخ الأكبر لهيروميتسو هو موروفوشي تاكاكي، والذي يسمى "كومي
Dialogue: 0,0:14:01.04,0:14:05.92,Default,,0,0,0,,.إنه ضابط في قسم التحقيقات الأول في ناغانو، إلى جانب كانسوكي ياماتو ويوي أويهارا
Dialogue: 0,0:14:07.13,0:14:12.31,Default,,0,0,0,,.ويبدو أن هذه القضية الضخمة ستشملهم أيضًا
Dialogue: 0,0:14:13.72,0:14:16.02,Default,,0,0,0,,.حتى مع جسدٍ أصغر، يظل عقلي كما هو عليه
Dialogue: 0,0:14:16.14,0:14:18.02,Default,,0,0,0,,!المحقق العظيم لا يترك أي قضية دون حل
Dialogue: 0,0:14:18.14,0:14:21.15,Default,,0,0,0,, !فالحقيقة دوماً واحدة
Dialogue: 0,0:14:38.88,0:14:39.92,Default,,0,0,0,,!سيد موري
Dialogue: 0,0:14:41.01,0:14:42.68,Default,,0,0,0,,.محقق تاكاغي
Dialogue: 0,0:14:42.80,0:14:44.68,Default,,0,0,0,,.سنتولى الأمر من الآن
Dialogue: 0,0:14:45.68,0:14:48.18,Default,,0,0,0,,هل فحصت دراجة الجاني؟
Dialogue: 0,0:14:48.30,0:14:51.43,Default,,0,0,0,,.نحن نتحقق من المالك من خلال رقم اللوحة
Dialogue: 0,0:14:51.56,0:14:54.44,Default,,0,0,0,,،تلك الدراجة النارية كانت عند مدخل المترو
Dialogue: 0,0:14:54.56,0:14:57.23,Default,,0,0,0,,هل هرب الجاني بالمترو؟
Dialogue: 0,0:14:57.36,0:14:59.07,Default,,0,0,0,,...هذا ما اعتقدته لكن
Dialogue: 0,0:15:00.69,0:15:01.98,Default,,0,0,0,,.لم أعثر عليه
Dialogue: 0,0:15:02.65,0:15:03.78,Default,,0,0,0,,.يا سيد موري
Dialogue: 0,0:15:03.90,0:15:07.20,Default,,0,0,0,,...يبدو أنك كنت تعرف المفتش ساميتاني الذي قُتل
Dialogue: 0,0:15:07.32,0:15:08.82,Default,,0,0,0,,المفتش؟
Dialogue: 0,0:15:09.66,0:15:10.87,Default,,0,0,0,,...إذن واني
Dialogue: 0,0:15:12.08,0:15:14.58,Default,,0,0,0,,.أصبح مفتشًا
Dialogue: 0,0:15:19.17,0:15:21.13,Default,,0,0,0,,...وها هو قد
Dialogue: 0,0:15:24.26,0:15:25.47,Default,,0,0,0,,واني...؟
Dialogue: 0,0:15:25.80,0:15:27.22,Default,,0,0,0,,من واني؟
Dialogue: 0,0:15:27.34,0:15:29.76,Default,,0,0,0,,.يبدو أنه لقب المفتش ساميتاني
Dialogue: 0,0:15:33.52,0:15:34.77,Default,,0,0,0,,!واني
Dialogue: 0,0:15:35.48,0:15:38.15,Default,,0,0,0,,!أنت! ألم تكن تريد أن تسألني شيئًا
Dialogue: 0,0:15:38.27,0:15:39.34,Default,,0,0,0,,!سيد موري
Dialogue: 0,0:15:39.34,0:15:40.90,Default,,0,0,0,,ماذا كنت تريد أن تخبرني؟
Dialogue: 0,0:15:41.02,0:15:42.52,Default,,0,0,0,,!تبا
Dialogue: 0,0:15:42.65,0:15:44.44,Default,,0,0,0,,!اهدأ
Dialogue: 0,0:15:44.57,0:15:46.95,Default,,0,0,0,,!ألم تكن تريد أن تخبرني شيئًا
Dialogue: 0,0:15:47.36,0:15:48.90,Default,,0,0,0,,أليس كذلك يا واني؟
Dialogue: 0,0:15:50.66,0:15:51.70,Default,,0,0,0,,!واني
Dialogue: 0,0:15:51.83,0:15:53.21,Default,,0,0,0,,!هيا أجبني
Dialogue: 0,0:15:53.33,0:15:55.92,Default,,0,0,0,,!واني!، واني
Dialogue: 0,0:15:59.08,0:16:01.17,Default,,0,0,0,,.يا مفتش ميغوري
Dialogue: 0,0:16:01.71,0:16:04.42,Default,,0,0,0,,.هذا هو مكتب المفتش ساميتاني
Dialogue: 0,0:16:04.59,0:16:06.88,Default,,0,0,0,,غرفة إعداد الإصلاحات؟
Dialogue: 0,0:16:07.01,0:16:10.18,Default,,0,0,0,,.أنا في نفس القسم، ولم أسمع به من قبل
Dialogue: 0,0:16:10.30,0:16:11.68,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:16:11.80,0:16:15.05,Default,,0,0,0,,.أُنشئ هذا ‏بالخصوص للضباط الذين لا فائدة منهم
Dialogue: 0,0:16:15.22,0:16:16.39,Default,,0,0,0,,من هذا؟
Dialogue: 0,0:16:16.52,0:16:18.98,Default,,0,0,0,,.هذا رئيس القسم، المفتش سوغا
Dialogue: 0,0:16:19.31,0:16:21.31,Default,,0,0,0,,.انا ميغوري من قسم التحقيقات الأولى
Dialogue: 0,0:16:21.86,0:16:25.53,Default,,0,0,0,,.أعتقد أن المفتش ساميتاني كان في قسم التحقيقات الأولى
Dialogue: 0,0:16:25.65,0:16:27.57,Default,,0,0,0,,.لقد نُقل إلى هنا مؤخرًا
Dialogue: 0,0:16:28.07,0:16:32.07,Default,,0,0,0,,.نُقل؟، لكنه كان محققًا ممتازًا
Dialogue: 0,0:16:32.20,0:16:33.37,Default,,0,0,0,,.أيها المفتش
Dialogue: 0,0:16:33.49,0:16:36.12,Default,,0,0,0,,.هذا هو الملف الذي فتحه آخر مرة
Dialogue: 0,0:16:38.00,0:16:40.84,Default,,0,0,0,,...حادث انهيار جليدي وقع في ناغانو
Dialogue: 0,0:16:42.29,0:16:45.46,Default,,0,0,0,,.بالمناسبة، قال واني إنه ذاهب إلى ناغانو
Dialogue: 0,0:16:45.59,0:16:46.57,Default,,0,0,0,,.نعم
Dialogue: 0,0:16:46.57,0:16:51.64,Default,,0,0,0,,لكن شرطة محافظة ناغانو أكدت\N.أن المفتش ساميتاني لم يذهب إلى هناك
Dialogue: 0,0:16:51.76,0:16:52.84,Default,,0,0,0,,!ماذا قلت؟
Dialogue: 0,0:16:52.97,0:16:54.35,Default,,0,0,0,,.يا مفتش شيراتوري
Dialogue: 0,0:16:54.47,0:16:57.68,Default,,0,0,0,,،لقد فحصنا الدراجة النارية التي يُعتقد أنها للمشتبه به
Dialogue: 0,0:16:57.81,0:17:00.36,Default,,0,0,0,,.لكنها كانت مسروقة ولا يمكن تتبعها
Dialogue: 0,0:17:00.48,0:17:02.32,Default,,0,0,0,,ماذا يفعل مكتب الأمن العام هنا؟
Dialogue: 0,0:17:02.44,0:17:04.98,Default,,0,0,0,,ربما لأن ضابط شرطة قُتل في هذه القضية؟
Dialogue: 0,0:17:05.11,0:17:06.36,Default,,0,0,0,,.كما توقعت
Dialogue: 0,0:17:06.48,0:17:09.36,Default,,0,0,0,,.على أي حال، سيُنشَأ مقر للتحقيق قريبًا
Dialogue: 0,0:17:09.49,0:17:12.03,Default,,0,0,0,,سأذهب إلى هناك، وأنتم؟
Dialogue: 0,0:17:12.16,0:17:14.16,Default,,0,0,0,,.سنذهب إلى ناغانو
Dialogue: 0,0:17:14.28,0:17:15.37,Default,,0,0,0,,.فهمت
Dialogue: 0,0:17:15.49,0:17:18.83,Default,,0,0,0,,.أرسلوا معلومات محافظة ناغانو إلى مقر التحقيق الرئيسي
Dialogue: 0,0:17:18.96,0:17:19.69,Default,,0,0,0,,!حاضر
Dialogue: 0,0:17:19.69,0:17:20.96,Default,,0,0,0,,!سأذهب أيضًا
Dialogue: 0,0:17:21.37,0:17:24.71,Default,,0,0,0,,.يا سيد موري، لا يمكننا إشراك مواطن في هذا التحقيق
Dialogue: 0,0:17:24.84,0:17:26.53,Default,,0,0,0,,!لقد قُتل صديقي
Dialogue: 0,0:17:26.53,0:17:27.34,Default,,0,0,0,,!مهلًا لحظة
Dialogue: 0,0:17:27.46,0:17:30.51,Default,,0,0,0,,.كنت أنا أيضًا في مكان الجريمة ولمحت الجاني
Dialogue: 0,0:17:31.05,0:17:35.97,Default,,0,0,0,,!أساسًا قد يكون لدى الجاني شيءٌ لا يريدني أن أعرفه؛ ولهذا قتله
Dialogue: 0,0:17:36.10,0:17:37.06,Default,,0,0,0,,.أبي
Dialogue: 0,0:17:37.18,0:17:39.81,Default,,0,0,0,,!إذا لم أذهب، لن تُحل هذه القضية
Dialogue: 0,0:17:39.93,0:17:41.20,Default,,0,0,0,,!صحيح
Dialogue: 0,0:17:41.21,0:17:43.47,Default,,0,0,0,,.نعول عليك في مساعدتنا في التحقيق
Dialogue: 0,0:17:43.48,0:17:45.44,Default,,0,0,0,,!إذن سأذهب أيضًا، أنا أيضًا رأيت الجاني
Dialogue: 0,0:17:45.57,0:17:47.20,Default,,0,0,0,,!لا تتبعني
Dialogue: 0,0:17:47.78,0:17:49.91,Default,,0,0,0,,!هذا ليس وقتًا للعب
Dialogue: 0,0:17:55.07,0:17:57.16,Default,,0,0,0,,.إذن، سأذهب الآن
Dialogue: 0,0:17:57.29,0:17:58.58,Default,,0,0,0,,.حسناً
Dialogue: 0,0:17:58.87,0:18:00.08,Default,,0,0,0,,.يا كونان
Dialogue: 0,0:18:03.33,0:18:06.08,Default,,0,0,0,,...بخصوص تذاكر مباراة كرة القدم هذه
Dialogue: 0,0:18:07.63,0:18:09.17,Default,,0,0,0,,ماذا سنفعل بها؟
Dialogue: 0,0:18:09.30,0:18:10.84,Default,,0,0,0,,!آسف يا أختي ران
Dialogue: 0,0:18:13.18,0:18:14.47,Default,,0,0,0,,!رائع
Dialogue: 0,0:18:14.59,0:18:16.01,Default,,0,0,0,,!لنذهب إلى هناك
Dialogue: 0,0:18:16.14,0:18:17.47,Default,,0,0,0,,!لنذهب
Dialogue: 0,0:18:21.06,0:18:22.10,Default,,0,0,0,,!الثلج جميل
Dialogue: 0,0:18:22.23,0:18:23.57,Default,,0,0,0,,!المنظر رائع
Dialogue: 0,0:18:23.69,0:18:24.73,Default,,0,0,0,,!يبدو لذيذًا
Dialogue: 0,0:18:25.10,0:18:27.06,Default,,0,0,0,,!أيها البروفيسور
Dialogue: 0,0:18:27.19,0:18:28.40,Default,,0,0,0,,!مرحبًا
Dialogue: 0,0:18:28.52,0:18:29.81,Default,,0,0,0,,هل هذا أنت؟
Dialogue: 0,0:18:31.32,0:18:33.11,Default,,0,0,0,,!مرحبًا يا أوتشي
Dialogue: 0,0:18:33.24,0:18:35.99,Default,,0,0,0,,!لم أرك منذ مدة يا اغاسا
Dialogue: 0,0:18:36.41,0:18:38.04,Default,,0,0,0,,!هؤلاء هم الأطفال
Dialogue: 0,0:18:38.16,0:18:39.79,Default,,0,0,0,,!مرحبًا
Dialogue: 0,0:18:40.54,0:18:43.75,Default,,0,0,0,,.مرحبًا! أنا أوتشي من المرصد الفلكي
Dialogue: 0,0:18:43.87,0:18:45.79,Default,,0,0,0,,!تشرفنا
Dialogue: 0,0:18:45.92,0:18:48.05,Default,,0,0,0,,.المعذرة، سأرد على الهاتف
Dialogue: 0,0:18:48.88,0:18:50.05,Default,,0,0,0,,شينيتشي؟
Dialogue: 0,0:18:55.93,0:18:59.27,Default,,0,0,0,,.فهمت. إذن سأذهب مباشرة إلى المرصد الفلكي
Dialogue: 0,0:18:59.39,0:19:01.39,Default,,0,0,0,,!شكرًا لك، أراك لاحقًا
Dialogue: 0,0:19:03.14,0:19:05.93,Default,,0,0,0,,.لم أتوقع أن نذهب إلى ناغانو
Dialogue: 0,0:19:06.06,0:19:07.37,Default,,0,0,0,,لا بأس، سأذهب وحدـ
Dialogue: 0,0:19:07.40,0:19:08.32,Default,,0,0,0,,!ممنوع
Dialogue: 0,0:19:08.40,0:19:12.78,Default,,0,0,0,,بالإضافة إلى أنني قلقة على أبي \N.ولم أعد في مزاج لمشاهدة مباراة كرة القدم
Dialogue: 0,0:19:12.90,0:19:14.82,Default,,0,0,0,,...لكن ٱشعر بالسوء لإهدار التذاكر
Dialogue: 0,0:19:14.95,0:19:16.12,Default,,0,0,0,,!صحيح
Dialogue: 0,0:19:16.61,0:19:18.82,Default,,0,0,0,,مباراة كرة القدم؟
Dialogue: 0,0:19:18.95,0:19:23.12,Default,,0,0,0,,.لا، غير مهتم. أنا ذاهبة في موعد سينمائي مع السيد ماكوتو اليوم
Dialogue: 0,0:19:23.25,0:19:25.42,Default,,0,0,0,,،يمكننكِ مشاهدة الفيلم في أي وقت
Dialogue: 0,0:19:25.54,0:19:27.79,Default,,0,0,0,,.إذا لم تحضري مباراة اليوم فسوف تضيع عليكِ
Dialogue: 0,0:19:27.92,0:19:31.13,Default,,0,0,0,,.لا أعرف عما إذا كان السيد ماكوتو مهتمًا بكرة القدم
Dialogue: 0,0:19:31.25,0:19:33.34,Default,,0,0,0,,لكنكِ مهتمة بكرة القدم، أليس كذلك؟
Dialogue: 0,0:19:33.46,0:19:35.88,Default,,0,0,0,,!ذاك الشاب هيدا من فريق السبيريتس رائع
Dialogue: 0,0:19:36.30,0:19:37.89,Default,,0,0,0,,أهي مباراة فريق السبيريتس؟
Dialogue: 0,0:19:38.01,0:19:40.64,Default,,0,0,0,,...هذا صحيح! إذا هتفتِ له
Dialogue: 0,0:19:41.18,0:19:43.35,Default,,0,0,0,,...السيد كيوغوكو سيصبح غيورًا جدًا
Dialogue: 0,0:19:43.47,0:19:46.72,Default,,0,0,0,,!وربما تشتعل نيران غيرته في الحب
Dialogue: 0,0:19:49.40,0:19:51.90,Default,,0,0,0,,!هيدا! ، هيا سدد هدفًا
Dialogue: 0,0:19:52.02,0:19:52.73,Default,,0,0,0,,!يا آنسة سونوكو
Dialogue: 0,0:19:52.84,0:19:53.74,Default,,0,0,0,,!نعم
Dialogue: 0,0:19:53.86,0:19:56.24,Default,,0,0,0,,!لو كنت مكانه، لما سمحت بأي تسديدة
Dialogue: 0,0:19:56.74,0:19:59.62,Default,,0,0,0,,.أنتِ هدفي، ولن أسمح بتسجيل أي هدف
Dialogue: 0,0:20:00.16,0:20:01.87,Default,,0,0,0,,!سيد ماكوتو
Dialogue: 0,0:20:01.99,0:20:06.45,Default,,0,0,0,,!أحسنتِ يا ران، أنتِ أفضل مخططة في الحب
Dialogue: 0,0:20:06.79,0:20:10.09,Default,,0,0,0,,!بكل سرور سآخذ هذه التذاكر منك
Dialogue: 0,0:20:10.84,0:20:13.34,Default,,0,0,0,,...الانهيار الجليدي الذي حدث منذ 10 أشهر
Dialogue: 0,0:20:13.75,0:20:17.75,Default,,0,0,0,,أليس ذلك عندما كان المفتش ياماتو يطارد شخصًا في الجبال؟
Dialogue: 0,0:20:17.88,0:20:21.84,Default,,0,0,0,,.نعم، كان يطارد الهارب ساداكوني ميكوريا
Dialogue: 0,0:20:21.97,0:20:30.31,Default,,0,0,0,,.قبل ثماني سنوات، اقتحم لصان متجر أسلحة في ناغانو لسرقة بنادق الصيد والذخيرة
Dialogue: 0,0:20:36.72,0:20:43.16,Default,,0,0,0,,،على الرغم من أن الوقت كان متأخرًا في الليل\N.كانت موظفة المتجر الأنسة فوناكوبو ماكي موجودة داخل المتجر
Dialogue: 0,0:20:43.28,0:20:46.58,Default,,0,0,0,,.أصيبت ساقها أثناء هروب الجناة
Dialogue: 0,0:20:47.83,0:20:52.92,Default,,0,0,0,,.بعد استلام مكالمة من المتجر، ضابط الدورية في ذلك الوقت والذي يدعى كاي كوروتو
Dialogue: 0,0:20:53.04,0:20:57.80,Default,,0,0,0,,.عثر على "تاكاشي واشيزو" واعتقله، والذي كان أحد اللصين
Dialogue: 0,0:20:57.92,0:21:00.59,Default,,0,0,0,,...بفضل شهادة الضابط واشيزو، في اليوم التالي
Dialogue: 0,0:21:00.97,0:21:08.85,Default,,0,0,0,,.عُثِر على اللص الآخر الذي كان مختبئًا في الجبال، ميكوريا ساداكوني، وقد اعتُقل أيضًا
Dialogue: 0,0:21:09.52,0:21:11.56,Default,,0,0,0,,حسنًا، لذا عندما نصل إلى ناغانو
Dialogue: 0,0:21:11.69,0:21:14.61,Default,,0,0,0,,!عليّ التحدث إلى ذلك الضابط الذي قبض عليهما
Dialogue: 0,0:21:15.11,0:21:16.61,Default,,0,0,0,,.هذا غير ممكن
Dialogue: 0,0:21:16.94,0:21:20.86,Default,,0,0,0,,.الضابط كاي سقط و مات في الجبال قبل ست سنوات
Dialogue: 0,0:21:22.24,0:21:28.29,Default,,0,0,0,,.وفقًا للملاحظات، ساعدت أنت يا سيد موري شرطة ناغانو في حل تلك القضية
Dialogue: 0,0:21:28.41,0:21:30.95,Default,,0,0,0,,هل فعلت؟
Dialogue: 0,0:21:31.08,0:21:36.17,Default,,0,0,0,,...لا أتذكر حقًا أنني حللت تلك القضية
Dialogue: 0,0:21:36.30,0:21:40.05,Default,,0,0,0,,.قبل ست سنوات، كان ميكوريا قد أُطلق سراحه المشروط
Dialogue: 0,0:21:40.17,0:21:42.30,Default,,0,0,0,,.لكنه اختفى بعد ذلك فورًا
Dialogue: 0,0:21:42.43,0:21:43.26,Default,,0,0,0,,اختفى؟
Dialogue: 0,0:21:43.39,0:21:44.12,Default,,0,0,0,,نعم.
Dialogue: 0,0:21:44.12,0:21:51.69,Default,,0,0,0,,.قبل 10 أشهر، عثر المفتش ياماتو على ميكوريا وطارده لكنه علق في الانهيار الجليدي، واختفى ميكوريا
Dialogue: 0,0:21:52.06,0:21:57.36,Default,,0,0,0,,لم يدرك أحد أن المفتش علق في الانهيار \N.الجليدي؛ لذلك لم يُعثَر عليه إلا في وقت لاحق
Dialogue: 0,0:21:57.48,0:22:00.27,Default,,0,0,0,,يا كونان، هل أحذية التنزه هذه جديدة؟
Dialogue: 0,0:22:00.40,0:22:03.36,Default,,0,0,0,,.نعم، البروفيسور أعطانيها
Dialogue: 0,0:22:03.49,0:22:04.74,Default,,0,0,0,,!إنها رائعة
Dialogue: 0,0:22:06.08,0:22:09.25,Default,,0,0,0,,...بينما كان الجميع مشغولين بالقلق على المفتش ياماتو
Dialogue: 0,0:22:09.75,0:22:17.17,Default,,0,0,0,,.نجا ساداكوني ميكوريا من الانهيار الجليدي، وبقي مختبئًا في الجبال
Dialogue: 0,0:22:26.85,0:22:35.32,Default,,0,0,0,,عُثِر على ميكوريا واعتُقل مرةً أخرى من قبل\N.المفتش موروفوشي تاكاكي من شرطة ناغانو
Dialogue: 0,0:22:35.81,0:22:45.57,Default,,0,0,0,,بعد معرفة اتجاه الانهيار الجليدي، قرر المفتش\N.موروفوشي البحث في ياماناشي بدلًا من ناغانو
Dialogue: 0,0:22:45.74,0:22:52.96,Default,,0,0,0,,.لذا زار عيادة عند سفح الجبل في ياماناشي، ووجد المفتش ياماتو فاقدًا للوعي هناك أخيرًا
Dialogue: 0,0:23:04.50,0:23:05.71,Default,,0,0,0,,!لقد مضت مدّة
Dialogue: 0,0:23:06.34,0:23:07.34,Default,,0,0,0,,أيها المتحري (موري)
Dialogue: 0,0:23:08.71,0:23:10.91,Default,,0,0,0,,هذان زوجان من شرطة العاصمة
Dialogue: 0,0:23:11.93,0:23:12.91,Default,,0,0,0,,زوجان"؟"
Dialogue: 0,0:23:13.64,0:23:14.59,Default,,0,0,0,,إنها كلمة قديمة
Dialogue: 0,0:23:15.18,0:23:16.11,Default,,0,0,0,,أهذا صحيح؟
Dialogue: 0,0:23:16.76,0:23:19.20,Default,,0,0,0,,إذن، هذا الثنائي من شرطة (ناغانو)ـ
Dialogue: 0,0:23:19.20,0:23:19.68,Default,,0,0,0,,!تمهل
Dialogue: 0,0:23:19.81,0:23:22.04,Default,,0,0,0,,!نحن لسنا بثنائي
Dialogue: 0,0:23:22.69,0:23:24.52,Default,,0,0,0,,أـ أهذا صحيح؟
Dialogue: 0,0:23:25.06,0:23:27.60,Default,,0,0,0,,"إذن, سنكون تحت رعايتكم في قضية "واني
Dialogue: 0,0:23:27.69,0:23:28.48,Default,,0,0,0,,واني"؟"
Dialogue: 0,0:23:28.61,0:23:31.54,Default,,0,0,0,,إنه كاللقب, للمفتش (ساميتاني)
Dialogue: 0,0:23:31.81,0:23:33.85,Default,,0,0,0,,يبدو أنه كان صديق السيد (موري)
Dialogue: 0,0:23:35.37,0:23:37.20,Default,,0,0,0,,بالمناسبة, أين ذاك الطفل؟
Dialogue: 0,0:23:37.60,0:23:40.35,Default,,0,0,0,,أعني ذلك الطفل ذا الحدس الجيد والذي دائمًا ما يرافقك؟
Dialogue: 0,0:23:40.55,0:23:41.25,Default,,0,0,0,,.أتيتُ بدونه
Dialogue: 0,0:23:43.19,0:23:44.49,Default,,0,0,0,,!إنها ليست بلعبة
Dialogue: 0,0:23:45.46,0:23:47.09,Default,,0,0,0,,.إذن، سأركب أنا في الأمام
Dialogue: 0,0:23:50.01,0:23:51.34,Default,,0,0,0,,هل أنت بخير يا (كونان)؟
Dialogue: 0,0:23:53.18,0:23:54.71,Default,,0,0,0,,الجو بارد قليلًا صحيح؟
Dialogue: 0,0:23:55.18,0:23:57.01,Default,,0,0,0,,يجب ألا تصاب بالزكام
Dialogue: 0,0:23:58.26,0:23:59.60,Default,,0,0,0,,!ها أنت ذا! لقد انتهيت
Dialogue: 0,0:24:01.10,0:24:01.93,Default,,0,0,0,,!شكرًا
Dialogue: 0,0:24:04.74,0:24:05.46,Default,,0,0,0,,!آسف
Dialogue: 0,0:24:05.52,0:24:06.75,Default,,0,0,0,,هل أنت بخير أيها الولد؟
Dialogue: 0,0:24:07.69,0:24:08.09,Default,,0,0,0,,أجل
Dialogue: 0,0:24:08.75,0:24:09.75,Default,,0,0,0,,أنا حقًا آسف
Dialogue: 0,0:24:11.28,0:24:12.78,Default,,0,0,0,,هل أنت بخير يا(كونان)؟
Dialogue: 0,0:24:13.07,0:24:14.17,Default,,0,0,0,,!نعم! أنا على ما يرام
Dialogue: 0,0:24:14.40,0:24:14.90,Default,,0,0,0,,!لنذهب
Dialogue: 0,0:24:16.37,0:24:18.70,Default,,0,0,0,,(كونان)، أتريد الذهاب إلى المرصد الفلكي حقًا؟
Dialogue: 0,0:24:19.16,0:24:22.89,Default,,0,0,0,,نعم، فحتى إن ذهبت الآن إلى شرطة المحافظة\N فلن أنال إلا غضب العم
Dialogue: 0,0:24:24.11,0:24:27.04,Default,,0,0,0,,إلى المرصد الفلكي الوطني في "نوبياما" من فضلك
Dialogue: 0,0:24:27.33,0:24:27.65,Default,,0,0,0,,حاضر
Dialogue: 0,0:24:30.98,0:24:31.83,Default,,0,0,0,,أداة تنصت!؟
Dialogue: 0,0:24:33.13,0:24:34.17,Default,,0,0,0,,!..هل يعقل
Dialogue: 0,0:24:34.47,0:24:35.63,Default,,0,0,0,,..ذاك الرجل منذ قليل
Dialogue: 0,0:24:37.01,0:24:38.05,Default,,0,0,0,,من يكون؟
Dialogue: 0,0:24:38.72,0:24:40.05,Default,,0,0,0,,لم أنا؟
Dialogue: 0,0:24:41.46,0:24:43.76,Default,,0,0,0,,نعم, فعلتُ كما أمرت
Dialogue: 0,0:24:44.28,0:24:48.68,Default,,0,0,0,,ولكن ما الحاجة لوضع جهاز تنصت على طفل مثله؟
Dialogue: 0,0:24:49.42,0:24:50.82,Default,,0,0,0,,أيها المفتش (كازامي)
Dialogue: 0,0:24:54.74,0:25:00.99,Default,,0,0,0,,أيها المفتش (ياماتو)، كيف انتهى بك الحال في مستشفى\N ياماناشي" بعد حادثة الانهيارالجليدي قبل عشرة أشهر؟"
Dialogue: 0,0:25:01.58,0:25:03.71,Default,,0,0,0,,ذاك ما كنتُ أفكر به طوال الوقت
Dialogue: 0,0:25:05.12,0:25:08.84,Default,,0,0,0,,يبدو أن شخصًا ما أنقذ المفتش (ياماتو) من ذلك الانهيار
Dialogue: 0,0:25:09.13,0:25:11.46,Default,,0,0,0,,شخص ما؟ ألا تعرفونه؟
Dialogue: 0,0:25:11.75,0:25:16.19,Default,,0,0,0,,أجل, يبدو أنه طلب الإسعاف من الهاتف العمومي على سفح الجبل
Dialogue: 0,0:25:16.51,0:25:18.24,Default,,0,0,0,,ولكن لم تظهر أي بصمات
Dialogue: 0,0:25:19.64,0:25:23.77,Default,,0,0,0,,وماذا يفعل الآن ذلك الرجل المسمّى (ميكوريا)\N الذي ألقى المفتش (موروفوشي) القبض عليه؟
Dialogue: 0,0:25:24.06,0:25:26.59,Default,,0,0,0,,بالطبع عاد إلى مركز الشرطة
Dialogue: 0,0:25:26.64,0:25:31.18,Default,,0,0,0,,ألا يزال (واشيزو تاكاشي) الذي قُبض علبه قبل ثمانية أعوام في السجن؟
Dialogue: 0,0:25:32.28,0:25:35.71,Default,,0,0,0,,(واشيزو) غير مسجون
Dialogue: 0,0:25:36.62,0:25:42.75,Default,,0,0,0,,كلا (ميكوريا) و(واشيزو) حُكِم عليهما بالسجن لمدة\Nثلاث سنين، ولكن (واشيزو) حصل على حكم مع وقف التنفيذ
Dialogue: 0,0:25:39.74,0:25:41.57,Default,,0,0,0,,انظري! ترينه صحيح؟
Dialogue: 0,0:25:43.49,0:25:45.13,Default,,0,0,0,,!جبل فوجي
Dialogue: 0,0:25:45.50,0:25:47.29,Default,,0,0,0,,هذا رائع، أليس كذلك؟
Dialogue: 0,0:25:47.25,0:25:50.17,Default,,0,0,0,,لم حُكم عليهما بهذا الشكل المختلف؟
Dialogue: 0,0:25:50.13,0:25:51.96,Default,,0,0,0,,...لهذا (واشيزو)
Dialogue: 0,0:25:53.50,0:25:54.94,Default,,0,0,0,,..هذا حد النطاق إذن
Dialogue: 0,0:25:56.55,0:25:57.88,Default,,0,0,0,,سأرسل رسالة لـ
Dialogue: 0,0:25:58.75,0:26:02.09,Default,,0,0,0,,لا, المحقق (تاكاجي) مع العم الآن
Dialogue: 0,0:26:09.40,0:26:11.43,Default,,0,0,0,,آنسة (أزوسا)، تعالي من فضلك
Dialogue: 0,0:26:11.86,0:26:12.89,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:26:14.48,0:26:15.75,Default,,0,0,0,,!عذرًا على الانتظار
Dialogue: 0,0:26:15.78,0:26:17.71,Default,,0,0,0,,هذا مزيج القهوة الخاصة بنا
Dialogue: 0,0:26:18.65,0:26:19.99,Default,,0,0,0,,اشربوا على مهلكم
Dialogue: 0,0:26:26.50,0:26:29.13,Default,,0,0,0,, أطباق الاستقبال ممتدة على الطريق -
Dialogue: 0,0:26:28.13,0:26:29.16,Default,,0,0,0,,!هناك الكثير -
Dialogue: 0,0:26:29.29,0:26:30.92,Default,,0,0,0,,!!رائع
Dialogue: 0,0:26:31.08,0:26:33.82,Default,,0,0,0,,!هناك أطباق استقبال أكثر مما يوجد في منزل البروفيسور
Dialogue: 0,0:26:33.84,0:26:35.25,Default,,0,0,0,,هذا طبيعي
Dialogue: 0,0:26:35.71,0:26:36.80,Default,,0,0,0,,!انظروا
Dialogue: 0,0:26:37.63,0:26:40.17,Default,,0,0,0,,!ذاك الطبق ضخم
Dialogue: 0,0:26:40.23,0:26:41.12,Default,,0,0,0,,!انظر من فضلك
Dialogue: 0,0:26:41.34,0:26:43.98,Default,,0,0,0,,!ذاك الطبق أكبر
Dialogue: 0,0:26:44.47,0:26:45.32,Default,,0,0,0,,أين؟
Dialogue: 0,0:26:46.02,0:26:47.44,Default,,0,0,0,,!أنت محق! ما أضخمه
Dialogue: 0,0:26:47.60,0:26:48.77,Default,,0,0,0,,مهلًا يا (غينتا)
Dialogue: 0,0:26:49.23,0:26:49.86,Default,,0,0,0,,!أعتذر
Dialogue: 0,0:26:49.89,0:26:51.53,Default,,0,0,0,,!يا لضخامته
Dialogue: 0,0:26:58.36,0:26:59.09,Default,,0,0,0,,!اصمت
Dialogue: 0,0:26:59.36,0:27:00.45,Default,,0,0,0,,!هذا ليس ما أريده
Dialogue: 0,0:27:00.57,0:27:02.90,Default,,0,0,0,,!!أخبرتك أن تستدعي المحقق (ياماتو)
Dialogue: 0,0:27:02.82,0:27:04.96,Default,,0,0,0,,!مهلًا, فلتهدأ من فضلك
Dialogue: 0,0:27:05.08,0:27:05.81,Default,,0,0,0,,!أنت
Dialogue: 0,0:27:07.12,0:27:08.25,Default,,0,0,0,,!انتظر من فضلك
Dialogue: 0,0:27:09.75,0:27:10.58,Default,,0,0,0,,لا مشكلة
Dialogue: 0,0:27:10.75,0:27:11.82,Default,,0,0,0,,أشكرك
Dialogue: 0,0:27:12.04,0:27:12.77,Default,,0,0,0,,نعم
Dialogue: 0,0:27:14.04,0:27:16.98,Default,,0,0,0,,ألم تعثر بعد على (واشيزو تاكاشي)؟
Dialogue: 0,0:27:17.21,0:27:19.75,Default,,0,0,0,,(واشيزو)؟ المجرم قبل ثمانية أعوام؟
Dialogue: 0,0:27:19.84,0:27:22.07,Default,,0,0,0,,نعم, لقد حُكِم عليه مع وقف التنفيذ
Dialogue: 0,0:27:22.11,0:27:26.04,Default,,0,0,0,,!أجل! ومن ثم اختفى بكل جبنٍ ووهن
Dialogue: 0,0:27:26.06,0:27:27.39,Default,,0,0,0,,اختفى؟
Dialogue: 0,0:27:27.68,0:27:30.22,Default,,0,0,0,,.بعد أن أنهى حكمه فورًا
Dialogue: 0,0:27:30.39,0:27:34.43,Default,,0,0,0,,..أخبرتك عدة مرات, الشرطة لا تستطيع البحث عن (واشيزو)
Dialogue: 0,0:27:34.52,0:27:37.56,Default,,0,0,0,,فبمجرد انتهاء محكوميته يكون قد دفع ثمن جُرمه ـ
Dialogue: 0,0:27:37.56,0:27:38.24,Default,,0,0,0,,!لا تعبث معي
Dialogue: 0,0:27:38.57,0:27:41.60,Default,,0,0,0,,أتقول إنه دفع ثمن قتله (ماكي)؟
Dialogue: 0,0:27:42.16,0:27:43.09,Default,,0,0,0,,قتل؟
Dialogue: 0,0:27:43.66,0:27:47.59,Default,,0,0,0,,أتقصد الضحية قبل ثمانية أعوام (فوناكوبو ماكي)؟
Dialogue: 0,0:27:47.99,0:27:51.53,Default,,0,0,0,,.إنه يكون والدها السيد (فوناكوبو إيزو)
Dialogue: 0,0:27:53.00,0:27:56.29,Default,,0,0,0,,ألم تمت الآنسة (ماكي) بسبب إصابتها فحسب؟
Dialogue: 0,0:27:56.29,0:27:56.78,Default,,0,0,0,,كلا
Dialogue: 0,0:27:57.38,0:28:00.51,Default,,0,0,0,,.لقد توفيت في تلك السنة
Dialogue: 0,0:28:02.88,0:28:05.12,Default,,0,0,0,,."(ماكي) كانت لاعبة "بياثلون
Dialogue: 0,0:28:05.76,0:28:06.99,Default,,0,0,0,,بياثلون"؟"
Dialogue: 0,0:28:07.26,0:28:11.10,Default,,0,0,0,,.إنها منافسة تربط بين التزلج على الجليد والتصويب
Dialogue: 0,0:28:11.43,0:28:13.67,Default,,0,0,0,,.إنها مسجلة في الألعاب الأولومبية أيضًا
Dialogue: 0,0:28:15.48,0:28:22.31,Default,,0,0,0,,.بسبب تلك الإصابة تراجع تقدم (ماكي) وتم استبعادها من المنافسة الأولومبية
Dialogue: 0,0:28:22.95,0:28:31.08,Default,,0,0,0,,واللذان سببا إصابة (ماكي) حكم على أحدهما بثلاث سنوات والآخر بوقف التنفيذ
Dialogue: 0,0:28:32.00,0:28:35.23,Default,,0,0,0,,!كيف لها أن تقبل بحكم بسيط كهذا
Dialogue: 0,0:28:39.71,0:28:41.05,Default,,0,0,0,,.. حادث سقوط
Dialogue: 0,0:28:41.63,0:28:43.66,Default,,0,0,0,,.لا, بل تعمدت ذلك
Dialogue: 0,0:28:44.26,0:28:45.88,Default,,0,0,0,,.مستحيل! انتحرت
Dialogue: 0,0:28:45.89,0:28:47.02,Default,,0,0,0,,!لم تنتحر
Dialogue: 0,0:28:47.22,0:28:48.85,Default,,0,0,0,,هذا تمامًا كالقتل
Dialogue: 0,0:28:49.18,0:28:50.91,Default,,0,0,0,,!لقد قتلوا (ماكي)
Dialogue: 0,0:28:51.85,0:28:54.38,Default,,0,0,0,,لهذا أتيتُ إلى هنا
Dialogue: 0,0:28:55.06,0:28:59.19,Default,,0,0,0,,..للحصول على دليل يخص مكان (واشيزو) لأعثر عليه
Dialogue: 0,0:28:59.61,0:29:02.44,Default,,0,0,0,,!ولأتسبب بمثل مافعل لها
Dialogue: 0,0:29:02.57,0:29:07.40,Default,,0,0,0,,!أخبرتك عدة مرات, حتى وإن كان لدي دليل فلن أخبرك به
Dialogue: 0,0:29:09.03,0:29:10.47,Default,,0,0,0,,!سأعود مجددًا
Dialogue: 0,0:29:16.71,0:29:20.24,Default,,0,0,0,,إن أرادَ كريم النّفسِ انتقامًا\N ..فلن يَتراجعَ حتى ولو مضت عشرُ أعوام طِوال
Dialogue: 0,0:29:20.85,0:29:25.39,Default,,0,0,0,,مهما مرّتِ الأعوام وتَوَالَت، فإن الحقدَ لن يَخبُو\N.هذا ما توارثه الصّينيّون وسطروه في تراثهم
Dialogue: 0,0:29:27.05,0:29:28.88,Default,,0,0,0,,.لقد مضت مدة سيد (موري)
Dialogue: 0,0:29:30.10,0:29:32.13,Default,,0,0,0,,.هذا هو المفتش (موروفوشي)
Dialogue: 0,0:29:33.81,0:29:36.94,Default,,0,0,0,,."إنه بخصوص المفتش (ساميتناي) الذي قُتل في "طوكيو
Dialogue: 0,0:29:37.10,0:29:41.04,Default,,0,0,0,,عرفتُ بضعة أشياء من (ميكوريا)\N."الذي قابلته في سجن شرطة "يامانشي
Dialogue: 0,0:29:43.82,0:29:47.05,Default,,0,0,0,,.هناك اختراق في صدر المفتش (ساميتاني)
Dialogue: 0,0:29:47.41,0:29:49.30,Default,,0,0,0,,.وقد عُثِر على الرصاصة أيضًا في مسرح الجريمة
Dialogue: 0,0:29:49.81,0:29:52.04,Default,,0,0,0,,.بندقية من عيار ثلاثين
Dialogue: 0,0:29:52.37,0:29:54.00,Default,,0,0,0,,!بندقية
Dialogue: 0,0:29:54.79,0:29:55.12,Default,,0,0,0,,.أجل
Dialogue: 0,0:29:56.12,0:30:00.26,Default,,0,0,0,,.إنها رصاصة بندقية من عيار كبير تستخدم كثيرًا في صيد الجبال
Dialogue: 0,0:30:00.54,0:30:02.18,Default,,0,0,0,,هل يوجد استخدام سابق للبندقية؟
Dialogue: 0,0:30:02.55,0:30:03.59,Default,,0,0,0,,.لا يوجد
Dialogue: 0,0:30:04.09,0:30:05.30,Default,,0,0,0,,.مفهوم
Dialogue: 0,0:30:05.42,0:30:06.06,Default,,0,0,0,,.التالي
Dialogue: 0,0:30:06.42,0:30:08.26,Default,,0,0,0,,ماذا عن تحركات الضحية؟
Dialogue: 0,0:30:08.38,0:30:14.92,Default,,0,0,0,,في سبت الأسبوع الماضي قام المفتش (ساميتاني)\N ."بمقابلة (ميكوريا) السجين في مركز شرطة "ياماناشي
Dialogue: 0,0:30:15.56,0:30:17.69,Default,,0,0,0,,.بعد ذلك كانت تحركاته مجهولة
Dialogue: 0,0:30:18.23,0:30:23.06,Default,,0,0,0,,ولكنه كان على موعد صباح اليوم لمقابلة \N..(موري كوغورو)، الضابط السابق في مركز شرطة العاصمة
Dialogue: 0,0:30:23.19,0:30:26.72,Default,,0,0,0,,.ولكنه قُتل قبل مقابلته
Dialogue: 0,0:30:27.24,0:30:29.97,Default,,0,0,0,,ماهو سبب لقائهما؟
Dialogue: 0,0:30:30.05,0:30:31.28,Default,,0,0,0,,.ذلك مجهول
Dialogue: 0,0:30:31.95,0:30:38.98,Default,,0,0,0,,ولكن وفقًا لكلام (موري) فيظن أنه كان يريد التحدث\N."عن شيء ما بخصوص المفتش (ياماتو) من شرطة "ناغانو
Dialogue: 0,0:30:39.75,0:30:45.38,Default,,0,0,0,,تقصد أن السبب الأساسي في مقتل\N .المفتش (ساميتاني) له علاقة بالمفتش (ياماتو)
Dialogue: 0,0:30:45.38,0:30:46.81,Default,,0,0,0,,.أظن أن هناك احتمالية لهذا
Dialogue: 0,0:30:47.63,0:30:48.76,Default,,0,0,0,,.مفهوم
Dialogue: 0,0:30:48.88,0:30:51.72,Default,,0,0,0,,بخصوص هذا فلننتظر تقارير شرطة "ناغانوـ
Dialogue: 0,0:30:51.80,0:30:53.24,Default,,0,0,0,,..أيها القائد العام (كورودا)
Dialogue: 0,0:30:54.14,0:30:58.57,Default,,0,0,0,,..لا تظن أن الانتظار لوحده سيجلب لنا كل التقارير بصغيرها وكبيرها
Dialogue: 0,0:30:59.02,0:31:02.95,Default,,0,0,0,,.سأذهب إلى شرطة "ناغانو" وأستلم قيادة الموقع
Dialogue: 0,0:31:03.23,0:31:04.26,Default,,0,0,0,,...المدعي (أسوبي)
Dialogue: 0,0:31:04.82,0:31:09.35,Default,,0,0,0,,أنت المدعي العام من مكتب النيابة العامة\N .التابع لمقر التحقيق هذا في طوكيو
Dialogue: 0,0:31:09.53,0:31:11.16,Default,,0,0,0,,.عليك أن تتواجد هنا
Dialogue: 0,0:31:11.41,0:31:15.74,Default,,0,0,0,,..لا وجود لمثل هذه القيود القانونية على المدعين العامين التابعين لمقر التحقيق
Dialogue: 0,0:31:16.56,0:31:17.66,Default,,0,0,0,,..أيها القائد العام
Dialogue: 0,0:31:17.80,0:31:21.33,Default,,0,0,0,,..حتى إن كنتَ المسؤول عن مقر التحقيق هذا
Dialogue: 0,0:31:21.62,0:31:26.96,Default,,0,0,0,,فلا تنسَ أنكم أنتم الشرطة تعملون\N ..تحت إشرافنا نحن النيابة العامة
Dialogue: 0,0:31:28.13,0:31:29.56,Default,,0,0,0,,هل فهمت؟
Dialogue: 0,0:31:33.68,0:31:35.31,Default,,0,0,0,,.اعذرني على التأخير يا(كونان)
Dialogue: 0,0:31:36.64,0:31:38.57,Default,,0,0,0,,.قال إن الجميع ينتظرنا بعد هذا
Dialogue: 0,0:31:46.48,0:31:47.72,Default,,0,0,0,,!لقد فُتحت
Dialogue: 0,0:31:48.15,0:31:49.54,Default,,0,0,0,,!مثل الزهرة
Dialogue: 0,0:31:50.69,0:31:53.03,Default,,0,0,0,,!(كونان)! والأخت (ران)
Dialogue: 0,0:31:53.20,0:31:54.33,Default,,0,0,0,,!كان ذلك سريعًا
Dialogue: 0,0:31:54.76,0:31:55.16,Default,,0,0,0,,!نعم
Dialogue: 0,0:31:55.28,0:31:57.52,Default,,0,0,0,,!من الرائع قدومك أيضًا يا(كونان)
Dialogue: 0,0:31:57.74,0:31:59.58,Default,,0,0,0,,(كونان) والآنسة (ران) صحيح؟
Dialogue: 0,0:32:00.00,0:32:01.00,Default,,0,0,0,,.أنا (أوتشي)
Dialogue: 0,0:32:01.16,0:32:02.37,Default,,0,0,0,,.سررت بالتعرف عليك
Dialogue: 0,0:32:02.50,0:32:05.23,Default,,0,0,0,,!اعذرنا على الانضمام فجأة
Dialogue: 0,0:32:05.42,0:32:06.54,Default,,0,0,0,,!لا مشكلة
Dialogue: 0,0:32:06.67,0:32:10.50,Default,,0,0,0,,.لقد كنتُ على وشك شرح مركبة المراقبة المتنقلة هذه
Dialogue: 0,0:32:10.76,0:32:13.49,Default,,0,0,0,,هل من الممكن القيام بالمراقبة الفلكية أثناء التنقل؟
Dialogue: 0,0:32:13.63,0:32:15.97,Default,,0,0,0,,لأكون أكثر دقة ــ
Dialogue: 0,0:32:15.97,0:32:16.54,Default,,0,0,0,,.. والآن
Dialogue: 0,0:32:17.14,0:32:18.73,Default,,0,0,0,,"لقد وصلنا إلى سجن "ياماناشي
Dialogue: 0,0:32:18.74,0:32:19.88,Default,,0,0,0,,السجن؟
Dialogue: 0,0:32:20.81,0:32:22.74,Default,,0,0,0,,هل سمعت ذلك، (كونان)؟
Dialogue: 0,0:32:23.81,0:32:24.96,Default,,0,0,0,,(كونان)؟
Dialogue: 0,0:32:26.23,0:32:27.86,Default,,0,0,0,,!واو, هذا رائع
Dialogue: 0,0:32:27.98,0:32:31.72,Default,,0,0,0,,.إذن سأشرح لكم عن مركبة المراقبة المتنقلة هذه
Dialogue: 0,0:32:32.00,0:32:33.10,Default,,0,0,0,,!أجل
Dialogue: 0,0:32:33.13,0:32:34.95,Default,,0,0,0,,..تم الانتهاء من إجراءات المقابلة
Dialogue: 0,0:32:35.03,0:32:37.76,Default,,0,0,0,,.والآن بإمكانكم مقابلة (ميكوريا ساداكو)
Dialogue: 0,0:32:36.49,0:32:37.57,Default,,0,0,0,,..هذا الصوت
Dialogue: 0,0:32:38.41,0:32:39.04,Default,,0,0,0,,!آسف
Dialogue: 0,0:32:39.08,0:32:40.41,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:32:41.04,0:32:42.20,Default,,0,0,0,,!إنه ذاك الرجل
Dialogue: 0,0:32:42.33,0:32:44.06,Default,,0,0,0,,..أجل, دعوني أعرفكم عليه
Dialogue: 0,0:32:44.33,0:32:46.06,Default,,0,0,0,,.إنه (يا-سان)
Dialogue: 0,0:32:46.13,0:32:47.21,Default,,0,0,0,,(يا-سان)؟
Dialogue: 0,0:32:47.67,0:32:48.50,Default,,0,0,0,,..مهلًا
Dialogue: 0,0:32:48.67,0:32:49.80,Default,,0,0,0,,..طريقة التعريف به
Dialogue: 0,0:32:50.67,0:32:53.10,Default,,0,0,0,,."إنه المحقق (هاياشي) من شرطة "ياماناشي
Dialogue: 0,0:32:54.43,0:32:57.26,Default,,0,0,0,,.أنا (هاياشي) من شرطة "ياماناشي" قسم الشؤون العامة
Dialogue: 0,0:32:57.47,0:32:59.90,Default,,0,0,0,,.(ساتو) من قسم التحقيقات الأول للمقر الرئيسي
Dialogue: 0,0:33:00.14,0:33:01.57,Default,,0,0,0,,.أنا (تاكاجي) من نفس القسم
Dialogue: 0,0:33:01.77,0:33:04.30,Default,,0,0,0,,.سنكون تحت رعايتكم بما يخص قضية (واني)
Dialogue: 0,0:33:04.48,0:33:06.61,Default,,0,0,0,,إذن أنت أيضًا من المقر الرئيسي؟
Dialogue: 0,0:33:06.62,0:33:09.25,Default,,0,0,0,,.كلا, أنا متحرٍّ أدعى (موري)
Dialogue: 0,0:33:09.32,0:33:12.15,Default,,0,0,0,,.السيد (موري) تربطه صداقة بالمفتش (ساميتاني)
Dialogue: 0,0:33:12.19,0:33:14.73,Default,,0,0,0,,.سيتعاون معنا في مجريات التحقيق
Dialogue: 0,0:33:14.90,0:33:16.34,Default,,0,0,0,,!هكذا إذًا
Dialogue: 0,0:33:16.95,0:33:20.38,Default,,0,0,0,,.يبدو أن المحقق (هاياشي) مقرب من المفتش (ياماتو)
Dialogue: 0,0:33:20.83,0:33:23.76,Default,,0,0,0,,.لأني كنتُ تحت رعايته عندما كنتُ في المستشفى
Dialogue: 0,0:33:24.62,0:33:29.16,Default,,0,0,0,,.لقد اعتنى بي إلى أن عاد وعيي واستعدتُ قوتي
Dialogue: 0,0:33:29.34,0:33:35.37,Default,,0,0,0,,عذرًا, بما أنه كان فاقد الوعي  \Nألم تكن تعلم أن المفتش (ياماتو) شرطي؟
Dialogue: 0,0:33:35.67,0:33:38.91,Default,,0,0,0,,.كل أغراضي جُرفت مع الانهيار الجليدي
Dialogue: 0,0:33:38.93,0:33:45.56,Default,,0,0,0,,وأيضًا لديه مثل هذا الوجه؛ لذا تحسبًا من كونه مجرمًا سابقًا قمتُ\N.بالتحقق من بصماته
Dialogue: 0,0:33:46.27,0:33:50.40,Default,,0,0,0,,!ولكن بوجه كهذا لم أكن لأتصور أن يكون شرطيًا
Dialogue: 0,0:33:50.61,0:33:52.10,Default,,0,0,0,,!وجهك وجهك" فلتصمت"
Dialogue: 0,0:33:57.91,0:34:01.54,Default,,0,0,0,,!كم هو مدهش تحريك طبق بهذا الحجم
Dialogue: 0,0:34:01.58,0:34:05.02,Default,,0,0,0,,!أيها البروفيسور أنا أيضًا أريد تحريكها! اسمح لي
Dialogue: 0,0:34:05.45,0:34:07.69,Default,,0,0,0,,.أخشى أن ذلك غير ممكن
Dialogue: 0,0:34:08.21,0:34:11.54,Default,,0,0,0,,ولكن انظر إلى ذاك أتعرف ما هو؟
Dialogue: 0,0:34:12.75,0:34:14.29,Default,,0,0,0,,ماذا يكون؟
Dialogue: 0,0:34:14.42,0:34:15.45,Default,,0,0,0,,أهو مدفع؟
Dialogue: 0,0:34:15.92,0:34:18.96,Default,,0,0,0,,!أنت مخطئ! إنه عدسة تكبير
Dialogue: 0,0:34:18.98,0:34:20.62,Default,,0,0,0,,!كلاكما مخطئ
Dialogue: 0,0:34:20.76,0:34:26.09,Default,,0,0,0,,.في الواقع، من هناك تُطلَق أشعة ليزر لترسم نجوم في السماء
Dialogue: 0,0:34:26.52,0:34:27.85,Default,,0,0,0,,!مدهش
Dialogue: 0,0:34:28.02,0:34:28.85,Default,,0,0,0,,!أريد رؤيتها
Dialogue: 0,0:34:28.98,0:34:30.31,Default,,0,0,0,,..عندما يحل الليل
Dialogue: 0,0:34:30.60,0:34:33.64,Default,,0,0,0,,.قد يكون هناك ما يمكنك المساعدة به
Dialogue: 0,0:34:34.36,0:34:35.44,Default,,0,0,0,,!أجل
Dialogue: 0,0:34:35.57,0:34:37.60,Default,,0,0,0,,!هذا غير عادل! لم (غينتا) فقط
Dialogue: 0,0:34:37.64,0:34:38.70,Default,,0,0,0,,!(آيومي) أيضًا تريد التجربة
Dialogue: 0,0:34:38.74,0:34:40.07,Default,,0,0,0,,!أريد رسم نجمة
Dialogue: 0,0:34:40.20,0:34:43.33,Default,,0,0,0,,.هذه مشكلة, لا أستطيع جعل الجميع يجرب
Dialogue: 0,0:34:43.33,0:34:46.16,Default,,0,0,0,,!إذن فلنقرر ذلك باختبار
Dialogue: 0,0:34:47.04,0:34:50.57,Default,,0,0,0,,.هناك الكثير من النجوم والكواكب في الفضاء
Dialogue: 0,0:34:50.58,0:34:56.42,Default,,0,0,0,,من بين الخيارات التالية، أين يوجد المجرم \Nالذي تبحث عنه الشرطة؟
Dialogue: 0,0:34:57.17,0:34:59.31,Default,,0,0,0,,.الخيار الأول : الشمس
Dialogue: 0,0:35:00.26,0:35:02.49,Default,,0,0,0,,.الخيار الثاني : الزُّهرة
Dialogue: 0,0:35:03.18,0:35:05.11,Default,,0,0,0,,.الخيار الثالث : الأرض
Dialogue: 0,0:35:06.31,0:35:07.84,Default,,0,0,0,,.الخيار الرابع : القمر
Dialogue: 0,0:35:09.02,0:35:10.65,Default,,0,0,0,,إذن أيهم يا ترى؟
Dialogue: 0,0:35:11.44,0:35:13.97,Default,,0,0,0,,.لم أعرف الحل على غير العادة
Dialogue: 0,0:35:14.57,0:35:16.40,Default,,0,0,0,,.أعطنا تلميحًا أيها البروفيسور
Dialogue: 0,0:35:16.55,0:35:18.38,Default,,0,0,0,,.لابد أنها تلاعب بالكلمات كالعادة
Dialogue: 0,0:35:18.49,0:35:20.52,Default,,0,0,0,,.ليس تلاعبًا بالكلمات, إنها العامية
Dialogue: 0,0:35:20.82,0:35:22.40,Default,,0,0,0,,كلمة عامية تخص الشرطة؟
Dialogue: 0,0:35:22.82,0:35:25.76,Default,,0,0,0,,المجرم يقال عنه نجمة لذا هل هو الزُّهرة ياترى؟
Dialogue: 0,0:35:25.99,0:35:29.50,Default,,0,0,0,,.لقد أصبتِ يا (آي)
Dialogue: 0,0:35:30.41,0:35:31.46,Default,,0,0,0,,.تبًا
Dialogue: 0,0:35:33.08,0:35:35.12,Default,,0,0,0,,.إذن فلنذهب إلى مبنى الليزر
Dialogue: 0,0:35:35.54,0:35:37.08,Default,,0,0,0,,!حاضر
Dialogue: 0,0:35:37.09,0:35:39.22,Default,,0,0,0,,.كان من المفترض أن أقوم بها أنا
Dialogue: 0,0:35:39.35,0:35:40.85,Default,,0,0,0,,.لا بأس، سأدعك تفعلها
Dialogue: 0,0:35:40.86,0:35:41.33,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:35:41.43,0:35:44.39,Default,,0,0,0,,!ممنوع! لقد تحدد ذلك باختبار البروفيسور
Dialogue: 0,0:35:45.64,0:35:48.27,Default,,0,0,0,,!أنت! الهاتف ممنوع هنا
Dialogue: 0,0:35:48.76,0:35:49.52,Default,,0,0,0,,.أعتذر
Dialogue: 0,0:35:54.10,0:35:56.04,Default,,0,0,0,,أيمكنني إرسالها برسالة؟
Dialogue: 0,0:35:56.11,0:35:59.60,Default,,0,0,0,,أيوجد من لا تريده أن يستمع بالقرب منك؟
Dialogue: 0,0:35:59.94,0:36:01.24,Default,,0,0,0,,.هذا أيضًا سبب آخر
Dialogue: 0,0:36:01.36,0:36:02.50,Default,,0,0,0,,سبب آخر؟
Dialogue: 0,0:36:02.70,0:36:03.74,Default,,0,0,0,,!لا يعقل
Dialogue: 0,0:36:04.32,0:36:05.86,Default,,0,0,0,,هل هناك من يتنصت عليك؟
Dialogue: 0,0:36:05.96,0:36:06.50,Default,,0,0,0,,.أجل
Dialogue: 0,0:36:06.83,0:36:08.06,Default,,0,0,0,,!يا للمفاجأة
Dialogue: 0,0:36:08.66,0:36:09.89,Default,,0,0,0,,ألا مشكلة بهذا الاتصال؟
Dialogue: 0,0:36:10.41,0:36:11.25,Default,,0,0,0,,.لا مشكلة
Dialogue: 0,0:36:11.37,0:36:13.61,Default,,0,0,0,,.إذن فلتنصت دون أن تتكلم
Dialogue: 0,0:36:14.63,0:36:18.26,Default,,0,0,0,,..في اليوم الذي تمت فيه قضية السرقة قبل ثمانية أعوام
Dialogue: 0,0:36:18.63,0:36:23.16,Default,,0,0,0,,..كان هناك مجرمان اثنان، وقد ألقي القبض على أحدهما في ذاك اليوم
Dialogue: 0,0:36:23.80,0:36:28.07,Default,,0,0,0,,..ولكن الآخر هرب بالمسدس والطلقات التي سرقها
Dialogue: 0,0:36:28.35,0:36:34.58,Default,,0,0,0,,أراد المدعي العام حل القضية بسرعة؛ لذا قام باتفاقية\N ..إقرار الذنب مع (واشيزو تاكاشي) الذي قبضوا عليه أولًا
Dialogue: 0,0:36:35.35,0:36:38.39,Default,,0,0,0,,..فمقابل تخفيف الحكم عن (واشيزو)
Dialogue: 0,0:36:38.65,0:36:43.88,Default,,0,0,0,,اعترف لهم باسم شريكه (ميكوريا) وهيأته وهويته ومكان ..اختبائه
Dialogue: 0,0:36:44.40,0:36:46.99,Default,,0,0,0,,.وبفضل ذلك تم القبض على (ميكوريا) في اليوم التالي
Dialogue: 0,0:36:47.37,0:36:50.50,Default,,0,0,0,,.هذا كل شيء, أرجو أن أكون قد أجبت عن كل استفساراتك
Dialogue: 0,0:36:50.95,0:36:53.09,Default,,0,0,0,,.أجل, أشكرك سيد (أمورو)
Dialogue: 0,0:37:03.42,0:37:05.26,Default,,0,0,0,,..سيد (فورويا)
Dialogue: 0,0:37:05.30,0:37:06.13,Default,,0,0,0,,(كازامي)
Dialogue: 0,0:37:06.55,0:37:10.08,Default,,0,0,0,,قمتَ بوضع جهاز تنصت في (إيدوغاوا)، صحيح؟
Dialogue: 0,0:37:11.38,0:37:12.18,Default,,0,0,0,,كيف؟
Dialogue: 0,0:37:12.31,0:37:17.54,Default,,0,0,0,,.أنا من أمرك بالتحقيق في قضية قتل المفتش (ساميتاني)
Dialogue: 0,0:37:17.90,0:37:24.73,Default,,0,0,0,,"أرسل لي (كونان) استفسارًا يخص قضية "ناغانو\N .التي كان المفتش (ساميتاني) يحقق بها
Dialogue: 0,0:37:25.08,0:37:27.71,Default,,0,0,0,,.علاوة على ذلك، كان هناك من يتنصت عليه
Dialogue: 0,0:37:28.32,0:37:34.16,Default,,0,0,0,,.وباللحظة نفسها التي أنهى بها الاتصال وردني اتصال منك
Dialogue: 0,0:37:35.00,0:37:40.73,Default,,0,0,0,,طلبتُ من عضو أمن عام متخفٍّ في \N.شرطة "يامانشي" أن يزرع أداة تنصت على الصبي
Dialogue: 0,0:37:40.96,0:37:42.49,Default,,0,0,0,,عضو أمن متخفّ؟
Dialogue: 0,0:37:42.67,0:37:46.50,Default,,0,0,0,,تعني أحد أعضاء الأمن العام الذين\N .يساهمون في أقسام أخرى غير الشرطة
Dialogue: 0,0:37:46.53,0:37:48.33,Default,,0,0,0,,لم قمت بزرع أداة التنصت به؟
Dialogue: 0,0:37:48.51,0:37:52.04,Default,,0,0,0,,."المفتش (ساميتاني) كان يحقق بقضية "ناغانو
Dialogue: 0,0:37:52.18,0:37:56.81,Default,,0,0,0,,.ذاك الفتى أيضًا ذاهب إلى "ناغانو" لذا فكرتُ بالاستعانة بقدراته
Dialogue: 0,0:37:56.85,0:38:00.00,Default,,0,0,0,,.سيد (فورويا), كما فعلت أنت من قبل
Dialogue: 0,0:38:04.00,0:38:05.43,Default,,0,0,0,,.الهاتف ممنوع
Dialogue: 0,0:38:05.90,0:38:07.44,Default,,0,0,0,,أهو أمر مستعجل؟
Dialogue: 0,0:38:07.57,0:38:08.70,Default,,0,0,0,,.أجل
Dialogue: 0,0:38:13.29,0:38:14.82,Default,,0,0,0,,ألهذا علاقة؟
Dialogue: 0,0:38:15.20,0:38:16.00,Default,,0,0,0,,.نعم
Dialogue: 0,0:38:16.21,0:38:18.24,Default,,0,0,0,,.تم وضعها علي من قبل الأمن العام
Dialogue: 0,0:38:19.50,0:38:21.23,Default,,0,0,0,,تمهل! ألن تزيلها؟
Dialogue: 0,0:38:21.84,0:38:23.57,Default,,0,0,0,,..أجل, لأنه
Dialogue: 0,0:38:24.38,0:38:28.21,Default,,0,0,0,,.إن أبقيتها فسيكون بإمكاني تبادل المعلومات مع السيد (أمورو)
Dialogue: 0,0:38:28.38,0:38:29.72,Default,,0,0,0,,لأنه ماذا؟
Dialogue: 0,0:38:30.14,0:38:37.27,Default,,0,0,0,,لأن وجود عضو من الأمن العام في مدى أداة التنصت\N .هذه طوال الوقت لأمرٌ يبعث الطمأنينة
Dialogue: 0,0:38:37.98,0:38:39.41,Default,,0,0,0,,أليس كذلك سيد (كازامي)؟
Dialogue: 0,0:38:42.31,0:38:43.35,Default,,0,0,0,,!يا له من صبي
Dialogue: 0,0:38:56.60,0:38:57.49,Default,,0,0,0,,ما بك؟
Dialogue: 0,0:38:57.79,0:38:59.92,Default,,0,0,0,,مفتش (ياماتو) أعادت تلك النوبة؟
Dialogue: 0,0:39:00.25,0:39:01.25,Default,,0,0,0,,نوبة؟
Dialogue: 0,0:39:01.38,0:39:03.21,Default,,0,0,0,,.عفوًا, اعذرونا قليلًا
Dialogue: 0,0:39:03.96,0:39:06.39,Default,,0,0,0,,.لا بأس, فلتسترح هناك قليلًا
Dialogue: 0,0:39:09.09,0:39:10.52,Default,,0,0,0,,..المعذرة
Dialogue: 0,0:39:10.76,0:39:12.39,Default,,0,0,0,,..هناك وقت محدد للمقابلة لذا
Dialogue: 0,0:39:12.59,0:39:14.63,Default,,0,0,0,,.أجل, لندخل في صلب الموضوع
Dialogue: 0,0:39:15.01,0:39:16.56,Default,,0,0,0,,.أنتِ على حق
Dialogue: 0,0:39:16.59,0:39:20.12,Default,,0,0,0,,سيد (ميكوريا), في السبت الماضي زارك هذا الرجل صحيح؟
Dialogue: 0,0:39:20.23,0:39:21.96,Default,,0,0,0,,..نعم, شرطي العاصمة
Dialogue: 0,0:39:21.98,0:39:23.41,Default,,0,0,0,,ما الذي سألك عنه (واني)؟
Dialogue: 0,0:39:23.61,0:39:24.34,Default,,0,0,0,,(واني)؟
Dialogue: 0,0:39:24.90,0:39:26.15,Default,,0,0,0,,!أجب فحسب
Dialogue: 0,0:39:26.98,0:39:29.22,Default,,0,0,0,,.عن الانهيار الجليدي
Dialogue: 0,0:39:29.49,0:39:31.72,Default,,0,0,0,,.سألني إن كنتُ قد رأيت شخصًا ما حينها
Dialogue: 0,0:39:32.03,0:39:33.46,Default,,0,0,0,,من يكون "شخص ما"؟
Dialogue: 0,0:39:33.47,0:39:34.47,Default,,0,0,0,,!وما أدراني
Dialogue: 0,0:39:34.70,0:39:37.73,Default,,0,0,0,,!لم أكن أفكر إلا بالهرب من الشرطي الذي خرج منذ قليل
Dialogue: 0,0:39:37.76,0:39:38.79,Default,,0,0,0,,.هذا ما أجبته به
Dialogue: 0,0:39:39.00,0:39:40.04,Default,,0,0,0,,.هذا كل شيء
Dialogue: 0,0:39:46.92,0:39:53.15,Default,,0,0,0,,بتسليط ضوء الليزر في السماء سيتوهج الصوديوم\N .حيث أن الليزر يسبب عدم استقرار
Dialogue: 0,0:39:53.43,0:39:56.36,Default,,0,0,0,,.وهكذا نستطيع صنع نجوم صناعية
Dialogue: 0,0:39:59.43,0:40:00.00,Default,,0,0,0,,!جميلة
Dialogue: 0,0:40:01.52,0:40:02.65,Default,,0,0,0,,!أنتِ ماهرة
Dialogue: 0,0:40:02.79,0:40:07.59,Default,,0,0,0,,.صحيح! اجعلي شعاعَي الليزر متزامنين ووجهيهما نحو طبقة الصوديوم
Dialogue: 0,0:40:07.86,0:40:11.29,Default,,0,0,0,,.أغلب الظن أن هذه نظرية البصريات غير الخطية
Dialogue: 0,0:40:11.30,0:40:15.57,Default,,0,0,0,,..إن كان كذلك فبإضافة شعاع ليزر في هذه المنطقة
Dialogue: 0,0:40:16.19,0:40:17.62,Default,,0,0,0,,!لقد ازدادت واحدة
Dialogue: 0,0:40:17.73,0:40:18.49,Default,,0,0,0,,!رائع
Dialogue: 0,0:40:19.08,0:40:22.81,Default,,0,0,0,,!حتى نحن الخبراء لم ننجح بها من أول محاولة
Dialogue: 0,0:40:23.25,0:40:26.58,Default,,0,0,0,,!أظنكِ ستصبحين عالمة متميزة
Dialogue: 0,0:40:27.25,0:40:30.19,Default,,0,0,0,,!إنه يقول عالمة! هذا رائع يا(آي)
Dialogue: 0,0:40:30.34,0:40:32.47,Default,,0,0,0,,!أهذا صحيح؟ يا لسعادتي
Dialogue: 0,0:40:32.84,0:40:34.67,Default,,0,0,0,,!ولكنكِ عالمة بالفعل
Dialogue: 0,0:40:36.89,0:40:43.92,Default,,0,0,0,,نثرَ كل ما مَلَكَ من ثَروات\N ..وجَازى من ساعَدَه في تَخطّي العقبات
Dialogue: 0,0:40:44.27,0:40:49.40,Default,,0,0,0,,سيجزي صَاحِب الفضل وإن كانت رُزّة\N.وسيصل انتِقامُهُ ممن أسَاءَ ولو بِقشّة
Dialogue: 0,0:40:50.23,0:40:52.27,Default,,0,0,0,,أهذه حكمة أخرى؟
Dialogue: 0,0:40:52.49,0:40:59.32,Default,,0,0,0,,أجل, إنه مَثَل صيني يخبرنا بأن نتخلص من كل \N..متعلقاتنا وحياتنا ونرد الجميل لمن كانوا معنا في أوقات الشدة
Dialogue: 0,0:40:59.66,0:41:03.89,Default,,0,0,0,,..وبأن نعيد العطايا التي حصلنا عليها مهما صغرت
Dialogue: 0,0:41:04.08,0:41:07.51,Default,,0,0,0,,.والثأر ممن أساء لنا ولو كانت نظرة غضب
Dialogue: 0,0:41:08.51,0:41:12.34,Default,,0,0,0,,حُكم عليك بالسجن ثلاثة أعوام، بينما\N..(واشيزو تاكاشي) حصل على وقف التنفيذ
Dialogue: 0,0:41:12.38,0:41:14.61,Default,,0,0,0,,هل تظن أنه ظلم؟
Dialogue: 0,0:41:15.43,0:41:18.76,Default,,0,0,0,,..قبل ستة أعوام اختفيت أثناء إفراجك المشروط
Dialogue: 0,0:41:18.93,0:41:22.16,Default,,0,0,0,,..وقبل عشرة أشهر عُثر عليك من قبل المفتش (ياماتو)
Dialogue: 0,0:41:22.39,0:41:25.42,Default,,0,0,0,,..عندما قبضتُ عليك كنتَ تحمل بندقية
Dialogue: 0,0:41:25.56,0:41:28.59,Default,,0,0,0,,.بدا ذلك بالنسبة لي كما لو كنت تتمرن
Dialogue: 0,0:41:29.28,0:41:30.11,Default,,0,0,0,,!هكذا إذًا
Dialogue: 0,0:41:30.32,0:41:33.35,Default,,0,0,0,,..قام (واشيزو) بصفقة إقرار الذنب ليخفف عقوبته
Dialogue: 0,0:41:33.61,0:41:37.44,Default,,0,0,0,,.وعندما انتهى إفراجك المشروط عدت إلى "ناغانو" لتثأر
Dialogue: 0,0:41:37.61,0:41:40.25,Default,,0,0,0,,..هكذا إذن! فموطن (واشيزو) هو "ناغانو" لذا
Dialogue: 0,0:41:40.45,0:41:43.00,Default,,0,0,0,,أكنت تنوي قتل (واشيزو)؟
Dialogue: 0,0:41:43.04,0:41:47.07,Default,,0,0,0,,..ولكن وجدك المفتش (ياماتو) قبل ذلك وطاردك
Dialogue: 0,0:41:47.37,0:41:49.31,Default,,0,0,0,,هل أنا مخطئ؟
Dialogue: 0,0:41:49.46,0:41:50.67,Default,,0,0,0,,ماخطبكم!؟
Dialogue: 0,0:41:50.79,0:41:55.33,Default,,0,0,0,,قمتُ بهذه المقابلة لأعاونكم في التحقيقات \N!!فلم تتحدثون عن هذه الأشياء؟
Dialogue: 0,0:41:55.72,0:41:56.72,Default,,0,0,0,,!(ميكوريا)
Dialogue: 0,0:41:57.00,0:41:58.68,Default,,0,0,0,,!أنا الآن أصلح ما أفسدت
Dialogue: 0,0:41:59.14,0:42:00.77,Default,,0,0,0,,!على عكس (واشيزو) الذي باعني
Dialogue: 0,0:42:00.77,0:42:01.78,Default,,0,0,0,,!انتهى وقت المقابلة
Dialogue: 0,0:42:02.18,0:42:02.96,Default,,0,0,0,,!عد إلى زنزانتك
Dialogue: 0,0:42:02.99,0:42:04.82,Default,,0,0,0,,!أجل, أردتُ قتله
Dialogue: 0,0:42:05.06,0:42:06.19,Default,,0,0,0,,!يا لذكائك
Dialogue: 0,0:42:06.26,0:42:07.60,Default,,0,0,0,,!لقد أصبت بكل شيء
Dialogue: 0,0:42:07.60,0:42:08.06,Default,,0,0,0,,!اصمت
Dialogue: 0,0:42:08.06,0:42:11.69,Default,,0,0,0,,!أقسم أني سأقتله لا محالة
Dialogue: 0,0:42:16.07,0:42:19.30,Default,,0,0,0,,."موقع التخييم الذي سنتوجه إليه الآن يوجد في "ميتاكاراداكي
Dialogue: 0,0:42:19.45,0:42:21.28,Default,,0,0,0,,.."ميتاكاراداكي"
Dialogue: 0,0:42:21.30,0:42:23.58,Default,,0,0,0,,.إنه حيث تعرض المفتش (ياماتو) للانهيار الجليدي على ما أذكر
Dialogue: 0,0:42:23.59,0:42:24.53,Default,,0,0,0,,..مما يعني أنه
Dialogue: 0,0:42:25.12,0:42:25.95,Default,,0,0,0,,.كما توقعت
Dialogue: 0,0:42:26.12,0:42:28.25,Default,,0,0,0,,."إنه بالقرب من مركز شرطة "ياماناشي
Dialogue: 0,0:42:28.58,0:42:30.82,Default,,0,0,0,,.أختي (ران)، رجاءً ساعديني
Dialogue: 0,0:42:31.88,0:42:34.71,Default,,0,0,0,,!بروفيسور (أوتشي) أريد الحمام
Dialogue: 0,0:42:35.67,0:42:37.01,Default,,0,0,0,,!هذه ورطة
Dialogue: 0,0:42:37.22,0:42:38.85,Default,,0,0,0,,!ما يزال هناك أكثر من نصف ساعة
Dialogue: 0,0:42:38.88,0:42:40.18,Default,,0,0,0,,ألا تستطيع التحمل؟
Dialogue: 0,0:42:41.26,0:42:42.69,Default,,0,0,0,,!سأبلل نفسي
Dialogue: 0,0:42:42.97,0:42:45.60,Default,,0,0,0,,!طوال الطريق كنا نصعد ونهبط
Dialogue: 0,0:42:45.85,0:42:47.58,Default,,0,0,0,,!لن أفعلها في الجبال
Dialogue: 0,0:42:47.89,0:42:51.73,Default,,0,0,0,,"عذرًا, سنمر قريبًا أمام مركز شرطة "ياماناشي
Dialogue: 0,0:42:51.98,0:42:54.71,Default,,0,0,0,,..بالقرب من هناك يوجد متجر هدايا
Dialogue: 0,0:42:54.86,0:42:57.69,Default,,0,0,0,,.قد يسمحون لنا باستخدام حمامهم
Dialogue: 0,0:42:57.94,0:42:59.07,Default,,0,0,0,,!أنت محقة
Dialogue: 0,0:42:59.49,0:43:02.82,Default,,0,0,0,,."إذن لنتوقف قليلًا أمام مركز شرطة "ياماناشي
Dialogue: 0,0:43:02.87,0:43:04.22,Default,,0,0,0,,!شكرًا جزيلًا
Dialogue: 0,0:43:04.49,0:43:06.53,Default,,0,0,0,,!أختي (ران)، أنتِ رائعة
Dialogue: 0,0:43:06.91,0:43:08.45,Default,,0,0,0,,كيف تعرفين هذه التفاصيل؟
Dialogue: 0,0:43:09.08,0:43:11.31,Default,,0,0,0,,هل كنتِ في مركز الشرطة من قبل؟
Dialogue: 0,0:43:11.50,0:43:12.73,Default,,0,0,0,,!تمهلوا
Dialogue: 0,0:43:13.71,0:43:16.04,Default,,0,0,0,,ولكن كيف عرفت هذا؟
Dialogue: 0,0:43:16.55,0:43:18.58,Default,,0,0,0,,!إنها معلومات من أخي (شينتشي)
Dialogue: 0,0:43:21.89,0:43:23.22,Default,,0,0,0,,هل أنت بخير الآن؟
Dialogue: 0,0:43:23.64,0:43:25.67,Default,,0,0,0,,.أعتذر لأني سببتُ لكم المتاعب
Dialogue: 0,0:43:30.44,0:43:32.67,Default,,0,0,0,,!إنه العم! يالها من صدفة
Dialogue: 0,0:43:33.51,0:43:34.05,Default,,0,0,0,,!أنت
Dialogue: 0,0:43:34.25,0:43:34.90,Default,,0,0,0,,لم؟
Dialogue: 0,0:43:35.02,0:43:37.66,Default,,0,0,0,,!نحن جميعًا في جولة في المرصد الفلكي
Dialogue: 0,0:43:37.73,0:43:39.87,Default,,0,0,0,,!والآن سنذهب إلى الجبل لنخيم
Dialogue: 0,0:43:42.07,0:43:44.61,Default,,0,0,0,,!(كونان) لا فائدة ,المتجر مغلق
Dialogue: 0,0:43:44.87,0:43:48.00,Default,,0,0,0,,.ولا يبدو أن هناك مكانًا آخر يمكننا استخدامه
Dialogue: 0,0:43:48.08,0:43:50.81,Default,,0,0,0,,!لا بأس, لم أعد بحاجته
Dialogue: 0,0:43:51.95,0:43:53.08,Default,,0,0,0,,..فهمت
Dialogue: 0,0:43:54.54,0:43:57.48,Default,,0,0,0,,.إذًا فلنعد إلى السيارة ونسرع إلى موقع التخييم
Dialogue: 0,0:43:57.59,0:44:00.72,Default,,0,0,0,,.لا, لا نعلم متى قد تعود حاجتك للحمام
Dialogue: 0,0:44:00.76,0:44:03.49,Default,,0,0,0,,.تعال معنا أيها الصبي إلى شرطة المحافظة
Dialogue: 0,0:44:03.55,0:44:05.39,Default,,0,0,0,,.أنا أيضًا أرجو منك ذلك
Dialogue: 0,0:44:06.81,0:44:07.14,Default,,0,0,0,,.أجل
Dialogue: 0,0:44:07.34,0:44:08.87,Default,,0,0,0,,!سأفعل ذلك
Dialogue: 0,0:44:09.64,0:44:12.57,Default,,0,0,0,,."إذن سأعود إلى شرطة "ياماناشي
Dialogue: 0,0:44:13.45,0:44:14.48,Default,,0,0,0,,.أشكر حسن رعايتك
Dialogue: 0,0:44:14.91,0:44:15.95,Default,,0,0,0,,.بوركت جهودك
Dialogue: 0,0:44:17.65,0:44:17.98,Default,,0,0,0,,.عذرًا
Dialogue: 0,0:44:19.75,0:44:21.88,Default,,0,0,0,,ياعم، أنت أحد أعضاء الأمن العام صحيح؟
Dialogue: 0,0:44:22.86,0:44:25.20,Default,,0,0,0,,!لا تقلق، فلن أخبر أحدًا
Dialogue: 0,0:44:25.41,0:44:26.26,Default,,0,0,0,,!وداعًا
Dialogue: 0,0:44:27.12,0:44:28.55,Default,,0,0,0,,..كدتُ أنسى
Dialogue: 0,0:44:28.62,0:44:30.35,Default,,0,0,0,,..سأترك هذه على حالها
Dialogue: 0,0:44:31.04,0:44:33.07,Default,,0,0,0,,!يمكنك أن تستمع متى ما تحب
Dialogue: 0,0:44:33.79,0:44:35.00,Default,,0,0,0,,!وداعًا
Dialogue: 0,0:44:36.50,0:44:38.33,Default,,0,0,0,,ماذا يكون ذلك الفتى؟
Dialogue: 0,0:44:40.55,0:44:45.98,Default,,0,0,0,,على مايبدو أن المفتش (ساميتاني) سأل (ميكوريا) \N .إن كان قد رأى شخصًا ما قبل وقوع الانهيار الجليدي
Dialogue: 0,0:44:46.29,0:44:49.32,Default,,0,0,0,,أكان ينوي سؤال المفتش (ياماتو) ذات الشيء يا ترى؟
Dialogue: 0,0:44:49.59,0:44:50.92,Default,,0,0,0,,.لكني لم أقابله
Dialogue: 0,0:44:51.35,0:44:53.28,Default,,0,0,0,,..بمعنى آخر لم يكن بإمكانه مقابلتك
Dialogue: 0,0:44:53.35,0:44:55.48,Default,,0,0,0,,.أو لم يعد بحاجة لمقابلتك
Dialogue: 0,0:44:56.15,0:45:00.00,Default,,0,0,0,,.ولكنه كان من المفترض به أن يقابل العم (موري) في اليوم التالي
Dialogue: 0,0:45:00.78,0:45:03.70,Default,,0,0,0,,.ولكن قبل أن يحدث ذلك، اغتُيل ببندقية قنص
Dialogue: 0,0:45:03.83,0:45:05.04,Default,,0,0,0,,!بندقية؟
Dialogue: 0,0:45:05.16,0:45:08.41,Default,,0,0,0,,.نعم، وجدنا طلقات بندقية من عيار 30
Dialogue: 0,0:45:08.62,0:45:12.75,Default,,0,0,0,,.لكنني لا أتذكر أنه كان يحمل بندقية
Dialogue: 0,0:45:13.17,0:45:16.42,Default,,0,0,0,,.هذا يخبرنا بالكثير عن الجاني
Dialogue: 0,0:45:17.30,0:45:23.43,Default,,0,0,0,,.صحيح، الجاني الذي قتل المفتش ساميتاني كان هناك عندما وقع الانهيار الجليدي
Dialogue: 0,0:45:23.55,0:45:26.68,Default,,0,0,0,,.وكانوا يفعلون شيئًا لا يمكنهم السماح للآخرين برؤيته
Dialogue: 0,0:45:26.81,0:45:28.27,Default,,0,0,0,,...هذا يعني
Dialogue: 0,0:45:28.39,0:45:31.60,Default,,0,0,0,,.أن الجاني موجود في مكان ما في ذاكرتي المفقودة
Dialogue: 0,0:45:31.73,0:45:34.19,Default,,0,0,0,,.هذا احتمال مؤكد
Dialogue: 0,0:45:44.03,0:45:46.12,Default,,0,0,0,,.أنا هاسيب من مكتب النيابة في طوكيو
Dialogue: 0,0:45:46.79,0:45:49.71,Default,,0,0,0,,.سمعت عنك من المشرف كورودا
Dialogue: 0,0:45:49.83,0:45:53.13,Default,,0,0,0,,.إنه المدعي المعين في هذه القضية
Dialogue: 0,0:45:53.42,0:45:57.30,Default,,0,0,0,,هل عادة ما يأتي المدعي إلى هنا؟
Dialogue: 0,0:45:57.76,0:46:00.68,Default,,0,0,0,,.بالطبع سنأتي، إذا تطلب الأمر
Dialogue: 0,0:46:01.34,0:46:07.30,Default,,0,0,0,,.السيد موري كوغورو، المحقق السابق في قسم التحقيقات الأول لشرطة طوكيو
Dialogue: 0,0:46:15.56,0:46:16.69,Default,,0,0,0,,يا سيد أمورو؟
Dialogue: 0,0:46:17.15,0:46:21.95,Default,,0,0,0,,لماذا بدأ المفتش ساميتاني التحقيق في حادثة الانهيار الجليدي منذ 10 أشهر؟
Dialogue: 0,0:46:22.07,0:46:25.57,Default,,0,0,0,,لماذا كان يبحث عن شخص كان في مكان الحادث؟
Dialogue: 0,0:46:26.03,0:46:27.45,Default,,0,0,0,,.أخبرني يا سيد أمورو
Dialogue: 0,0:46:27.58,0:46:31.46,Default,,0,0,0,,غرفة تخطيط الإصلاحات. ما هو نوع هذا القسم؟
Dialogue: 0,0:46:33.96,0:46:36.84,Default,,0,0,0,,.إذا لم تخبرني، سأسأل السيد كازامي
Dialogue: 0,0:46:37.13,0:46:41.63,Default,,0,0,0,,أم يجب أن أسأل السيد هاياشي، عميل الأمن العام السري؟
Dialogue: 0,0:46:43.68,0:46:45.60,Default,,0,0,0,,.كعادتك، ما تزال ذلك الفتى المشاكس
Dialogue: 0,0:46:46.35,0:46:51.06,Default,,0,0,0,,.أخبرتك عن اتفاقيات الإقرار بالذنب، أليس كذلك؟ هذا النظام على وشك التغيير
Dialogue: 0,0:46:51.18,0:46:56.35,Default,,0,0,0,,نعم، قُدّم اقتراح خطة تعديل إلى البرلمان، لكن لم يكن هناك تقدم. إذن؟
Dialogue: 0,0:46:58.27,0:46:59.90,Default,,0,0,0,,!يا لك من فتى
Dialogue: 0,0:47:00.03,0:47:03.87,Default,,0,0,0,,.إنه قسم يُعد الشرطة للتغييرات القادمة
Dialogue: 0,0:47:04.28,0:47:06.62,Default,,0,0,0,,هل هذه نهاية استجوابك؟
Dialogue: 0,0:47:06.74,0:47:08.37,Default,,0,0,0,,.شكرًا. سأتواصل معك
Dialogue: 0,0:47:13.75,0:47:21.09,Default,,0,0,0,,إذن كان السيد ساميتاني يبحث عن شخص في مسرح الجريمة استعدادًا للقوانين الجديدة؟
Dialogue: 0,0:47:21.21,0:47:29.39,Default,,0,0,0,,.نعم، إذا كان هذا هو سبب مقتله؛ فقد يكون الجاني معارضًا لقوانين اتفاقيات الإقرار بالذنب الجديدة
Dialogue: 0,0:47:29.51,0:47:32.39,Default,,0,0,0,,!ولكن القانون الجديد تم إقراره في البرلمان بالفعل
Dialogue: 0,0:47:32.52,0:47:36.65,Default,,0,0,0,,مقتل أحد ضباط الشرطة ليس كافيًا لإيقاف القانون
Dialogue: 0,0:47:36.77,0:47:38.52,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:47:38.86,0:47:44.70,Default,,0,0,0,,إذا تمت الموافقة على تلك القوانين فستبدأ برامج مثل حماية الشهود أيضًا، صحيح؟
Dialogue: 0,0:47:49.66,0:47:51.25,Default,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:47:51.37,0:47:54.04,Default,,0,0,0,,.لا, لا شيء
Dialogue: 0,0:47:55.66,0:47:56.95,Default,,0,0,0,,..لا
Dialogue: 0,0:48:03.46,0:48:06.51,Default,,0,0,0,,.إن مكان علوقك في الانهيار الجليدي على بعد مسافة قصيرة
Dialogue: 0,0:48:07.30,0:48:11.01,Default,,0,0,0,,من الذي رأيتُه في ذلك الوقت؟
Dialogue: 0,0:48:13.14,0:48:16.02,Default,,0,0,0,,لقد بدأت الثلوج تتساقط، أتريد فعل هذا غدًا بدلًا من ذلك؟
Dialogue: 0,0:48:16.14,0:48:20.14,Default,,0,0,0,,.اذهبِي إلى المنزل إذا أردتِ. سأذهب وحدي إذا اضطررت لذلك
Dialogue: 0,0:48:22.07,0:48:23.91,Default,,0,0,0,,.كنت تمامًا هكذا في ذلك الوقت
Dialogue: 0,0:48:24.49,0:48:27.74,Default,,0,0,0,,..كان-شان، لقد قلت إنك وجدت ميكوريا
Dialogue: 0,0:48:27.86,0:48:31.95,Default,,0,0,0,,..وطاردته وحيدًا، واختفيت
Dialogue: 0,0:48:32.08,0:48:33.92,Default,,0,0,0,,...ولم نتمكن من الاتصال بك لأشهر
Dialogue: 0,0:48:34.04,0:48:35.13,Default,,0,0,0,,ما هذا الكلام؟
Dialogue: 0,0:48:36.53,0:48:38.12,Default,,0,0,0,,..ظننت أنك قد قُتلت
Dialogue: 0,0:48:38.25,0:48:40.42,Default,,0,0,0,,.مستحيل، أيتها الغبية
Dialogue: 0,0:48:40.54,0:48:43.33,Default,,0,0,0,,!لكننا جميعًا ظننا ذلك
Dialogue: 0,0:48:43.46,0:48:46.13,Default,,0,0,0,,...!شرطة ناغانو بأكملها
Dialogue: 0,0:48:46.88,0:48:50.68,Default,,0,0,0,,..لهذا وبينما كنتُ في غيبوبة، استقلتِ من الشرطة
Dialogue: 0,0:48:50.80,0:48:54.39,Default,,0,0,0,,.وتزوجتِ من شخصية محلية كبيرة
Dialogue: 0,0:48:59.98,0:49:01.48,Default,,0,0,0,,.أعلم
Dialogue: 0,0:49:01.73,0:49:05.73,Default,,0,0,0,,.فعلتِ ذلك لحل قضية السيد كاي
Dialogue: 0,0:49:06.65,0:49:10.74,Default,,0,0,0,,.حسنًا، لو كنت مكانك لما ذهبت إلى حد الزواج
Dialogue: 0,0:49:13.28,0:49:14.61,Default,,0,0,0,,...!حسنًا، لو كنت مكاني
Dialogue: 0,0:49:14.74,0:49:18.79,Default,,0,0,0,,...إذا اختفيتُ إلى الأبد، ولم يكن لديك أي وسيلة للعثور عليّ
Dialogue: 0,0:49:18.91,0:49:21.04,Default,,0,0,0,,ماذا كنت ستفعل؟
Dialogue: 0,0:49:21.58,0:49:23.08,Default,,0,0,0,,!أجبني
Dialogue: 0,0:49:36.60,0:49:39.02,Default,,0,0,0,,!لقد سمعنا للتو ما يشبه طلقة نارية
Dialogue: 0,0:49:39.52,0:49:41.44,Default,,0,0,0,,هل هناك شخص يخرج للصيد؟
Dialogue: 0,0:49:41.56,0:49:43.40,Default,,0,0,0,,.ليس في هذا الوقت من الليل
Dialogue: 0,0:49:44.82,0:49:46.16,Default,,0,0,0,,!هذه بالتأكيد طلقات نارية
Dialogue: 0,0:49:46.28,0:49:49.45,Default,,0,0,0,,!أراهن أن شخصًا ما يخالف القواعد ويصطاد الحيوانات
Dialogue: 0,0:49:49.57,0:49:50.86,Default,,0,0,0,,!لنذهب ونوقفهم
Dialogue: 0,0:49:50.99,0:49:52.62,Default,,0,0,0,,!مهلا، توقفوا، انتظروا
Dialogue: 0,0:49:52.74,0:49:56.16,Default,,0,0,0,,!أيها البروفيسور، من فضلك اعتنِ بآي وأيومي
Dialogue: 0,0:49:56.33,0:49:57.83,Default,,0,0,0,,!ران
Dialogue: 0,0:50:02.12,0:50:04.25,Default,,0,0,0,,!لنهرب من هنا
Dialogue: 0,0:50:11.84,0:50:13.34,Default,,0,0,0,,!لنسرع
Dialogue: 0,0:50:43.33,0:50:44.52,Default,,0,0,0,,!السيارة تشتعل
Dialogue: 0,0:50:44.52,0:50:45.58,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:50:45.71,0:50:48.17,Default,,0,0,0,,!غينتا، اذهب لإحضار الطبيب والجميع
Dialogue: 0,0:50:48.30,0:50:50.47,Default,,0,0,0,,!سأتفقد المصابين
Dialogue: 0,0:50:50.59,0:50:51.68,Default,,0,0,0,,!فهمت
Dialogue: 0,0:50:53.55,0:50:54.91,Default,,0,0,0,,!إنه حار جدًا
Dialogue: 0,0:50:54.91,0:50:57.27,Default,,0,0,0,,...لا يبدو هذا حادثًا
Dialogue: 0,0:51:01.18,0:51:02.39,Default,,0,0,0,,!ميتسوهيكو
Dialogue: 0,0:51:02.85,0:51:04.85,Default,,0,0,0,,!اتركه
Dialogue: 0,0:51:14.51,0:51:15.49,Default,,0,0,0,,!غينتا
Dialogue: 0,0:51:15.86,0:51:17.36,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:51:28.38,0:51:30.09,Default,,0,0,0,,!ران
Dialogue: 0,0:51:53.65,0:51:56.45,Default,,0,0,0,,!هناك شخص سيئٌ يهاجم ران
Dialogue: 0,0:51:56.57,0:51:59.41,Default,,0,0,0,,!تعالوا فورًا! سأرسل صورة
Dialogue: 0,0:52:05.70,0:52:07.33,Default,,0,0,0,,!!أختي (ران)
Dialogue: 0,0:52:07.87,0:52:09.35,Default,,0,0,0,,هل أنتما بخير؟
Dialogue: 0,0:52:09.35,0:52:10.33,Default,,0,0,0,,!أجل
Dialogue: 0,0:52:11.04,0:52:14.21,Default,,0,0,0,,(ميتسيهيكو) هل قمتَ بالإبلاغ عنه؟
Dialogue: 0,0:52:15.54,0:52:18.55,Default,,0,0,0,,.لقد كان الهاتف خارج التغطية
Dialogue: 0,0:52:18.88,0:52:21.88,Default,,0,0,0,,إذًا أكان ذلك تمثيلًا؟
Dialogue: 0,0:52:22.18,0:52:24.26,Default,,0,0,0,,!أنتما الاثنان رائعان
Dialogue: 0,0:52:26.68,0:52:29.68,Default,,0,0,0,,!لقد كان مخيفًا صحيح؟ أشكركم
Dialogue: 0,0:52:31.77,0:52:33.77,Default,,0,0,0,,(أويهارا) هل أنتِ بخير؟
Dialogue: 0,0:52:33.90,0:52:36.07,Default,,0,0,0,,.نعم, بطريقة ما
Dialogue: 0,0:52:36.19,0:52:38.28,Default,,0,0,0,,.علينا الاحتماء بمكان ما
Dialogue: 0,0:52:42.80,0:52:44.28,Default,,0,0,0,,.المعذرة, إنها الشرطة
Dialogue: 0,0:52:50.08,0:52:51.91,Default,,0,0,0,,ألا يوجد أحد؟
Dialogue: 0,0:52:53.05,0:52:56.25,Default,,0,0,0,,.أتملكين جهاز ال"ب3"؟ لقد أسقطت خاصتي منذ قليل
Dialogue: 0,0:52:56.38,0:52:58.05,Default,,0,0,0,,.ولكننا خارج التغطية
Dialogue: 0,0:52:58.17,0:53:00.38,Default,,0,0,0,,.قد نتمكن من إرسال إشارة طوارئ
Dialogue: 0,0:53:00.51,0:53:01.67,Default,,0,0,0,,.صحيح
Dialogue: 0,0:53:06.68,0:53:09.56,Default,,0,0,0,,.تم استقبال إشارة طوارئ من أحد خطوط الشرطة
Dialogue: 0,0:53:10.02,0:53:14.52,Default,,0,0,0,,مرسل الإشارة اللاسلكية هي (أويهارا يوي)\N.من قسم التحقيقات الأول
Dialogue: 0,0:53:14.65,0:53:20.57,Default,,0,0,0,,وفقًا لمعلومات الموقع فقد تم إرسال الإشارة من كوخ \N.الفحم "بوبا" الواقع في جبل "ميتاكاراداكي" الخط الخامس
Dialogue: 0,0:53:20.69,0:53:21.76,Default,,0,0,0,,.فلنذهب
Dialogue: 0,0:53:21.76,0:53:22.86,Default,,0,0,0,,.أجل
Dialogue: 0,0:53:24.32,0:53:25.82,Default,,0,0,0,,!ابقَ أنت هنا
Dialogue: 0,0:53:28.35,0:53:29.54,Default,,0,0,0,,هايبرا؟
Dialogue: 0,0:53:29.66,0:53:31.37,Default,,0,0,0,,!..(ران) والبقية قد
Dialogue: 0,0:53:32.04,0:53:36.54,Default,,0,0,0,,سيد (كازامي) تمت مهاجمة أصحابي من قبل\N!شخص يحمل سلاح في الجبل
Dialogue: 0,0:53:37.42,0:53:38.79,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:53:38.92,0:53:41.26,Default,,0,0,0,,لم تلتقط أي صورة كما ينبغي صحيح؟
Dialogue: 0,0:53:41.38,0:53:43.30,Default,,0,0,0,,!لا يمكن لهذا أن يحصل
Dialogue: 0,0:53:43.67,0:53:47.51,Default,,0,0,0,,!الأهم من أي شيء أنكم عدتم بخير
Dialogue: 0,0:53:48.74,0:53:50.64,Default,,0,0,0,,!لقد أتى
Dialogue: 0,0:53:51.56,0:53:54.06,Default,,0,0,0,,!لقد أصبح الوضع كارثي
Dialogue: 0,0:53:58.36,0:54:01.36,Default,,0,0,0,,.يبدو أنكم التقطتم إشارة الطوارئ إذن
Dialogue: 0,0:54:03.28,0:54:05.61,Default,,0,0,0,,.إنه صاحب هذا المكان والذي أنقذنا
Dialogue: 0,0:54:05.95,0:54:08.28,Default,,0,0,0,,.نعم, أدعى (أوتوموتو)
Dialogue: 0,0:54:09.55,0:54:10.62,Default,,0,0,0,,.نعم, المعذرة
Dialogue: 0,0:54:11.16,0:54:12.64,Default,,0,0,0,,.. كوخ الفحم هذا 
Dialogue: 0,0:54:12.64,0:54:13.37,Default,,0,0,0,,.إنه ضيق
Dialogue: 0,0:54:13.50,0:54:14.87,Default,,0,0,0,,إنه جديد صحيح؟
Dialogue: 0,0:54:15.29,0:54:19.00,Default,,0,0,0,,.نعم, أنا أعمل به منذ خمس سنوات
Dialogue: 0,0:54:19.92,0:54:21.75,Default,,0,0,0,,.. منذ خمس سنوات 
Dialogue: 0,0:54:24.59,0:54:30.18,Default,,0,0,0,,بسبب حادثة الهجوم قامت الشرطة\N .بإصدار أوامر لإغلاق الطرق المؤدية للجبل
Dialogue: 0,0:54:30.30,0:54:32.68,Default,,0,0,0,,إذًا سنبيتُ الليلة هنا؟
Dialogue: 0,0:54:32.81,0:54:37.21,Default,,0,0,0,,لم يكن هناك شيء كهذا في الخطة \N.. لذا لم أحجز غرفة
Dialogue: 0,0:54:37.74,0:54:39.23,Default,,0,0,0,,إذًا مالذي علينا فعله؟
Dialogue: 0,0:54:39.35,0:54:41.23,Default,,0,0,0,,سنبيتُ في السيارة؟
Dialogue: 0,0:54:41.36,0:54:44.74,Default,,0,0,0,,. فلنذهب إلى كوخ الفحم القريب من هنا
Dialogue: 0,0:54:45.36,0:54:48.24,Default,,0,0,0,,.من المفترض بأن العم (كوجورو) ومن معه موجودون هناك
Dialogue: 0,0:54:48.95,0:54:50.74,Default,,0,0,0,,!ياله من سلاح غريب
Dialogue: 0,0:54:51.03,0:54:53.12,Default,,0,0,0,,.لا, إنه لا يبدو كسلاح
Dialogue: 0,0:54:53.49,0:54:56.25,Default,,0,0,0,,.إنها أحد معدات الصوت
Dialogue: 0,0:54:56.37,0:54:59.12,Default,,0,0,0,,.أما شكلها الشبيه بالسلاح فيمكنك القول أنه على سبيل المزاح
Dialogue: 0,0:54:59.67,0:55:05.80,Default,,0,0,0,,بسبب شكل الجبل ,فهذه المنطقة\N.تحدث بها الانهيارات الجليدية من الشمال والغرب
Dialogue: 0,0:55:05.92,0:55:11.97,Default,,0,0,0,,ولهذا أحيانًا نُحدث انهيار جليدي صغير\N .عمدًا ليمنع انهيارًا جليديًا أكبر
Dialogue: 0,0:55:12.30,0:55:17.85,Default,,0,0,0,,إن وجّهت هذه الأداة نحو أحد مكبّرات الصوت المثبّتة \N..في الموقع المراد إحداث الانهيار الجليدي فيه
Dialogue: 0,0:55:17.98,0:55:22.02,Default,,0,0,0,,.فسيُصدر المكبر صوتًا يسبب الانهيار الجليدي
Dialogue: 0,0:55:22.15,0:55:25.36,Default,,0,0,0,,.إنه أحد طرق التحكم بالانهيارات الجليدية 
Dialogue: 0,0:55:25.90,0:55:28.24,Default,,0,0,0,,.لقد فهمت كلامك عن الانهيارات
Dialogue: 0,0:55:28.36,0:55:31.43,Default,,0,0,0,,هل رأيت وجه المجرم الذي أطلقت عليه؟
Dialogue: 0,0:55:31.43,0:55:32.20,Default,,0,0,0,,..كلا
Dialogue: 0,0:55:32.41,0:55:33.95,Default,,0,0,0,,.. لقد كان يرتدي قلنسوة
Dialogue: 0,0:55:34.08,0:55:36.50,Default,,0,0,0,,.. كلا, لقد كان يرتدي قلنسوة لذا
Dialogue: 0,0:55:37.00,0:55:39.33,Default,,0,0,0,,.لم أستطع رؤية وجهه
Dialogue: 0,0:55:39.46,0:55:40.46,Default,,0,0,0,,خوذة؟
Dialogue: 0,0:55:40.71,0:55:46.26,Default,,0,0,0,,نعم, ذاك النوع الذي يرتديه سائقي \N.الدراجات والذي يغطي الرأس بالكامل
Dialogue: 0,0:55:46.96,0:55:49.34,Default,,0,0,0,,بالمناسبة, لقد كان يحمل سلاحًا صحيح؟
Dialogue: 0,0:55:49.47,0:55:52.30,Default,,0,0,0,,!نعم, سلاح بهذا الطول
Dialogue: 0,0:55:52.43,0:55:54.47,Default,,0,0,0,,!لقد كان السلاح مغطى
Dialogue: 0,0:55:55.06,0:55:56.64,Default,,0,0,0,,هذا بحجم بندقية صحيح؟
Dialogue: 0,0:55:56.77,0:56:04.11,Default,,0,0,0,,صحيح أنه كان يُغطي السلاح ولكني لم\N.أشعر بالسلاح عندما ركلته
Dialogue: 0,0:56:04.69,0:56:05.90,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:56:06.19,0:56:10.15,Default,,0,0,0,,إذًا هل تم الإطلاق عليك من سلاح مغطى بغطاء بندقية؟
Dialogue: 0,0:56:10.28,0:56:10.90,Default,,0,0,0,,.نعم
Dialogue: 0,0:56:11.70,0:56:15.41,Default,,0,0,0,,.أغلب الظن أن المُستهدف كان أنت يا (كانسوكي)
Dialogue: 0,0:56:15.53,0:56:16.70,Default,,0,0,0,,.على الأرجح نعم
Dialogue: 0,0:56:16.83,0:56:20.33,Default,,0,0,0,,على ما أظن فالمجرم هو الشخص \N.الذي كان موجودًا في الانهيار الجليدي منذ عشرة أشهر
Dialogue: 0,0:56:20.46,0:56:23.50,Default,,0,0,0,,.نعم, وهو يظن أنك رأيته
Dialogue: 0,0:56:23.63,0:56:26.42,Default,,0,0,0,,.ولكن المفتش (ياماتو) لايذكر هذا
Dialogue: 0,0:56:26.80,0:56:29.59,Default,,0,0,0,,.هذا يعني أن المجرم لا يعلم ذلك بعد
Dialogue: 0,0:56:29.84,0:56:33.61,Default,,0,0,0,,أو أنه يريد القضاء على المفتش (ياماتو)\N.قبل أن تعود ذاكرته
Dialogue: 0,0:56:34.72,0:56:37.16,Default,,0,0,0,,.المعذرة, هناك رجال من الشرطة
Dialogue: 0,0:56:37.18,0:56:39.93,Default,,0,0,0,,!لسنا من الشرطة! بل النيابة العامة
Dialogue: 0,0:56:41.94,0:56:43.92,Default,,0,0,0,,.. بعد تلقي إشارة الطوارئ 
Dialogue: 0,0:56:44.24,0:56:50.82,Default,,0,0,0,,قامت شرطة "ناغانو" و"ياماناشي" بسد الطرق \N.وإقامة نقاط تفتيش عند قاعدة الجبل
Dialogue: 0,0:56:52.91,0:56:57.70,Default,,0,0,0,,!بمعنى أن المجرم حتمًا موجود على هذا الجبل
Dialogue: 0,0:57:00.83,0:57:02.96,Default,,0,0,0,,.. لم على مواطنين مثل السيد (موري) المساعدة أيضًا
Dialogue: 0,0:57:03.08,0:57:08.46,Default,,0,0,0,,.لقد طلبنا من مجموعة الصيادين المحليين المساعدة أيضًا
Dialogue: 0,0:57:08.59,0:57:10.15,Default,,0,0,0,,.المعذرة
Dialogue: 0,0:57:10.15,0:57:11.34,Default,,0,0,0,,!إنه دافئ
Dialogue: 0,0:57:11.51,0:57:14.09,Default,,0,0,0,,.نعتذر على القدوم فجأة
Dialogue: 0,0:57:14.22,0:57:18.51,Default,,0,0,0,,.خذوا راحتكم, سأكون بالقرب من الفرن
Dialogue: 0,0:57:20.90,0:57:22.85,Default,,0,0,0,,إنها كقاعدة سرية أليس كذلك؟
Dialogue: 0,0:57:23.44,0:57:26.36,Default,,0,0,0,,(غينتا) مالذي تفعله؟
Dialogue: 0,0:57:26.48,0:57:29.36,Default,,0,0,0,,.هناك شيء عالق في أسناني منذ مدة
Dialogue: 0,0:57:29.48,0:57:31.07,Default,,0,0,0,,أهو لحم مشوي؟
Dialogue: 0,0:57:31.79,0:57:32.28,Default,,0,0,0,,!أزلتها
Dialogue: 0,0:57:32.61,0:57:34.11,Default,,0,0,0,,ماهذا؟
Dialogue: 0,0:57:34.24,0:57:36.28,Default,,0,0,0,,.تبدو كقطعة من جلد
Dialogue: 0,0:57:36.74,0:57:39.03,Default,,0,0,0,,هل من الممكن أن يكون هذا من قفاز المجرم؟
Dialogue: 0,0:57:40.45,0:57:42.24,Default,,0,0,0,,!صحيح لقد عضضته
Dialogue: 0,0:57:42.24,0:57:42.66,Default,,0,0,0,,ياللقرـ
Dialogue: 0,0:57:42.66,0:57:43.26,Default,,0,0,0,,!مهلًا
Dialogue: 0,0:57:43.79,0:57:44.92,Default,,0,0,0,,!(غينتا) ابقى على حالك
Dialogue: 0,0:57:44.92,0:57:47.29,Default,,0,0,0,,!دعني أخذ هذه ياولد
Dialogue: 0,0:57:47.63,0:57:49.75,Default,,0,0,0,,.سأحضر كيسًا بلاستيكيًا أو ماشابه وأعود
Dialogue: 0,0:57:49.88,0:57:51.88,Default,,0,0,0,,!لا تذهب وحدك
Dialogue: 0,0:57:54.84,0:57:56.51,Default,,0,0,0,,لا أملك عدا هذا
Dialogue: 0,0:57:56.80,0:57:59.51,Default,,0,0,0,,.شكرًا جزيلًا
Dialogue: 0,0:58:00.18,0:58:01.77,Default,,0,0,0,,.إنه مناسب
Dialogue: 0,0:58:02.31,0:58:04.06,Default,,0,0,0,,!يالها من حرارة عالية
Dialogue: 0,0:58:04.18,0:58:07.27,Default,,0,0,0,,.إن الفرن حار للغاية لذا لا تقتربي كثيرًا من فضلك
Dialogue: 0,0:58:08.11,0:58:09.75,Default,,0,0,0,,.حسنٌ
Dialogue: 0,0:58:10.42,0:58:10.77,Default,,0,0,0,,!هاه
Dialogue: 0,0:58:11.02,0:58:14.03,Default,,0,0,0,,أيها  العم, ما قصة تلك الندبة؟
Dialogue: 0,0:58:16.59,0:58:19.83,Default,,0,0,0,,.هذا من تقطيع الأخشاب لصنع الفحم
Dialogue: 0,0:58:19.95,0:58:21.99,Default,,0,0,0,,.ياله من عمل صعب
Dialogue: 0,0:58:24.08,0:58:25.46,Default,,0,0,0,,.كلا
Dialogue: 0,0:58:25.58,0:58:29.17,Default,,0,0,0,,.هذه ندبة تنشأ من آلية الترباس في البنادق والمسدسات
Dialogue: 0,0:58:30.38,0:58:33.01,Default,,0,0,0,,.وتلك ندبة من ارتداد البندقية
Dialogue: 0,0:58:37.47,0:58:39.64,Default,,0,0,0,,سيد (كازامي) هل تسمعني؟
Dialogue: 0,0:58:39.76,0:58:44.77,Default,,0,0,0,,بإمكان الأمن العام الإطلاع على سجل\Nمالكي المسدسات والبندقيات صحيح؟
Dialogue: 0,0:58:45.10,0:58:50.52,Default,,0,0,0,,.أريدك أن تتأكد من وجود اسم (أوتومو تاكاشي) بها
Dialogue: 0,0:58:50.65,0:58:53.15,Default,,0,0,0,,!ياله من طفل متحكم
Dialogue: 0,0:58:55.19,0:58:56.47,Default,,0,0,0,,ندوب؟
Dialogue: 0,0:58:56.47,0:58:56.90,Default,,0,0,0,,.نعم
Dialogue: 0,0:58:57.20,0:58:59.03,Default,,0,0,0,,.هنا وهنا
Dialogue: 0,0:58:59.36,0:59:02.28,Default,,0,0,0,,.فهمت, حامل بندقية إذًا
Dialogue: 0,0:59:02.83,0:59:07.04,Default,,0,0,0,,ذاك يبدو كبندقية ولكنه أداة تسبب انهيار ثلجي صحيح؟
Dialogue: 0,0:59:07.16,0:59:09.29,Default,,0,0,0,,.هذا ماقاله صاحب الكوخ
Dialogue: 0,0:59:09.79,0:59:11.84,Default,,0,0,0,,مستحيل, أتظنه سلاح؟
Dialogue: 0,0:59:11.96,0:59:19.30,Default,,0,0,0,,منذ عدة سنوات تمت مصادرة عدة أسلحة نادرة\N .."بالقرب من معبر الحدود بين "ناغانو" و"ياماناشي
Dialogue: 0,0:59:19.80,0:59:26.68,Default,,0,0,0,,مسدسات صغيرة وأسلحة أوتوماتيكية سريعة بشكل غيرعادي\N .ومسدسات يمكنك إضافة مخازن البنادق عليها
Dialogue: 0,0:59:26.81,0:59:30.77,Default,,0,0,0,,.لابد وأنهم تخلصوا من تلك الأسلحة منذ زمن بعيد
Dialogue: 0,0:59:30.90,0:59:34.48,Default,,0,0,0,,السلاح الذي هاجمكما كانت بندقية عادية صحيح؟
Dialogue: 0,0:59:34.61,0:59:39.57,Default,,0,0,0,,.لقد كان يغطيها لذا لم نعرف مانوع البندقية
Dialogue: 0,0:59:39.95,0:59:43.95,Default,,0,0,0,,!بمعنى آخر شكل السلاح...مجهول
Dialogue: 0,0:59:50.37,0:59:51.58,Default,,0,0,0,,.يالسرعتهم
Dialogue: 0,0:59:51.71,0:59:55.21,Default,,0,0,0,,.كما هو متوقع, من اعتاد الجبال يختلف عنا
Dialogue: 0,1:00:05.31,1:00:09.48,Default,,0,0,0,,.الآنسة (ران) و(غينتا) و(ميتسيهكو) اركبوا هذه السيارة من فضلكم
Dialogue: 0,1:00:09.89,1:00:13.52,Default,,0,0,0,,.أنتم شهداء على المجرم, سنأخذ إفادتكم في المركز
Dialogue: 0,1:00:13.65,1:00:15.57,Default,,0,0,0,,.سنعود نحن من طريق آخر
Dialogue: 0,1:00:15.69,1:00:21.57,Default,,0,0,0,,عذرًا, أريد أن أجمع (كونان) و(آيومي) و(آي) \N.أيضًا مع بقية الأطفال
Dialogue: 0,1:00:21.70,1:00:25.20,Default,,0,0,0,,.أنتِ محقة, إذًا فلتركبوا معًا
Dialogue: 0,1:00:25.33,1:00:26.33,Default,,0,0,0,,!حاضر
Dialogue: 0,1:00:26.45,1:00:28.75,Default,,0,0,0,,لم تجدوا المجرم فالنهاية؟
Dialogue: 0,1:00:28.87,1:00:33.63,Default,,0,0,0,,.نعم, رغم أن الشرطة أغلقت كل الطرق المؤدية إلى الجبل
Dialogue: 0,1:00:33.92,1:00:37.46,Default,,0,0,0,,كيف أخفى المجرم نفسه؟
Dialogue: 0,1:00:37.59,1:00:40.38,Default,,0,0,0,,.لم يعد هناك متسع في السيارة لذا سأبقى معكم
Dialogue: 0,1:00:40.51,1:00:43.59,Default,,0,0,0,,.بروفيسور (أغاسا), اركب عوضًا عني
Dialogue: 0,1:00:43.72,1:00:45.76,Default,,0,0,0,,..ولكن يا(موري)
Dialogue: 0,1:00:45.89,1:00:48.47,Default,,0,0,0,,.أنا سأعود معهم
Dialogue: 0,1:00:48.60,1:00:51.64,Default,,0,0,0,,.سيارتنا موجودة بالقرب من المنحدر
Dialogue: 0,1:00:51.77,1:00:53.65,Default,,0,0,0,,.إذًا أنا أيضًا سأعود معكم
Dialogue: 0,1:00:53.77,1:00:56.90,Default,,0,0,0,,!أنت! فلتركب مع بقية الأطفال
Dialogue: 0,1:00:57.02,1:01:00.44,Default,,0,0,0,,!لأنه إن ركب البروفيسور فسيلزمه مقعدان
Dialogue: 0,1:01:00.57,1:01:02.82,Default,,0,0,0,,!لذا فكرتُ أنه من الأفضل ألا أركب أيضًا
Dialogue: 0,1:01:02.95,1:01:05.28,Default,,0,0,0,,!ياله من كلام قاسي
Dialogue: 0,1:01:05.41,1:01:07.78,Default,,0,0,0,,.يا إلهي, فلنذهب أيها البروفيسور
Dialogue: 0,1:01:07.99,1:01:10.66,Default,,0,0,0,,.أبي, أعتمد عليك بكونان
Dialogue: 0,1:01:10.79,1:01:13.21,Default,,0,0,0,,.سيكون بخير معنا
Dialogue: 0,1:01:13.33,1:01:16.42,Default,,0,0,0,,!فهمت, تبًا
Dialogue: 0,1:01:25.93,1:01:29.81,Default,,0,0,0,,سيد (فوناكوبو) أشكر جهودك في البحث\N.معنا طيلة الليل
Dialogue: 0,1:01:29.93,1:01:32.39,Default,,0,0,0,,أهذا قبر الآنسة (ماكي)؟
Dialogue: 0,1:01:32.52,1:01:33.66,Default,,0,0,0,,.نعم
Dialogue: 0,1:01:33.66,1:01:35.44,Default,,0,0,0,,.اليوم ذكرى وفاتها على ما أعتقد
Dialogue: 0,1:01:36.23,1:01:37.73,Default,,0,0,0,,.إنه خطأي
Dialogue: 0,1:01:38.32,1:01:40.32,Default,,0,0,0,,.. في ذاك اليوم قبل ثمانية أعوام
Dialogue: 0,1:01:40.44,1:01:45.07,Default,,0,0,0,,.عندما سألتها كم تبقى من ذخيرة الصيد قالت انها ستتحقق وتعود
Dialogue: 0,1:01:45.20,1:01:47.12,Default,,0,0,0,,.رغم أنه كان في وقت متأخر من الليل
Dialogue: 0,1:01:47.82,1:01:53.00,Default,,0,0,0,,:قبل مغادرتها (ماكي) قالت \N(عندما أعود من المتجر فهناك ما أريد إخبارك به)
Dialogue: 0,1:01:53.71,1:01:57.13,Default,,0,0,0,,.علمتُ أن (ماكي) كانت تواعد أحدهم 
Dialogue: 0,1:01:57.25,1:02:00.63,Default,,0,0,0,,.ربما كانت تريد التحدث معي عن الزواج
Dialogue: 0,1:02:01.17,1:02:07.14,Default,,0,0,0,,تلك الكلمات التي قالتها بنبرة سعيدة وخجولة\N.لا تبارح أذناي حتى الآن
Dialogue: 0,1:02:07.93,1:02:14.14,Default,,0,0,0,,.والآن أنا لم أعد قادر على سماع ما أرادت قوله إلى الأبد
Dialogue: 0,1:02:14.64,1:02:19.02,Default,,0,0,0,,.منذ ذاك الحين وأنا آتي كل عام لوضع الزهور
Dialogue: 0,1:02:19.15,1:02:21.98,Default,,0,0,0,,.ولكن زهور ذكرى الوفاة هذه ذابلة
Dialogue: 0,1:02:22.11,1:02:28.03,Default,,0,0,0,,نعم, زهور "الزازينسو" البيضاء هذه\N.توضع على قبرها كل عام قبل ذكرى وفاتها بفترة قصيرة
Dialogue: 0,1:02:28.32,1:02:30.28,Default,,0,0,0,,من قد يكون؟
Dialogue: 0,1:02:30.58,1:02:33.29,Default,,0,0,0,,.(زازينسو) ياله من اسم غريب 
Dialogue: 0,1:02:33.41,1:02:37.67,Default,,0,0,0,,تبدو الزهور مثل رهبان الزن الذين يمارسون \N.تأمل الزازن، لذلك يطلق عليها اسم زازن سو
Dialogue: 0,1:02:38.25,1:02:41.63,Default,,0,0,0,,.إنها زهرة تُزهر في الثلج موجودة في هذا الجبل أيضًا
Dialogue: 0,1:02:41.75,1:02:44.26,Default,,0,0,0,,أليست التربة حول القبر دافئة؟
Dialogue: 0,1:02:44.38,1:02:46.38,Default,,0,0,0,,.وأيضًا الثلج ذائب قليلًا
Dialogue: 0,1:02:46.51,1:02:49.39,Default,,0,0,0,,.إذًا ربما هذه الزهرة قُطفت من هذا الجبل
Dialogue: 0,1:02:49.51,1:02:52.56,Default,,0,0,0,,.إن كان كذلك فسيكون شخص على معرفة جيدة بالجبل
Dialogue: 0,1:02:52.89,1:02:58.14,Default,,0,0,0,,العثور على "زازينسو" بيضاء\N .في وسط هذا الثلج لأمر شديد الاستحالة
Dialogue: 0,1:03:01.27,1:03:04.36,Default,,0,0,0,,.توقفي عن ملاحقتي, عودي إلى مركز الشرطة
Dialogue: 0,1:03:04.48,1:03:07.90,Default,,0,0,0,,.أعلم أنك تنوي استدراج المجرم لوحدك
Dialogue: 0,1:03:08.03,1:03:10.70,Default,,0,0,0,,.لايمكنني تركك وحدك وأنت تتمنى الموت
Dialogue: 0,1:03:10.82,1:03:14.20,Default,,0,0,0,,.أنا لا أنوي الموت
Dialogue: 0,1:03:14.62,1:03:17.46,Default,,0,0,0,,إذًا, اثنان أفضل من واـ
Dialogue: 0,1:03:20.71,1:03:23.30,Default,,0,0,0,,كومي! أرأيت ذاك؟
Dialogue: 0,1:03:23.42,1:03:31.09,Default,,0,0,0,,نعم, عندما أطلق ظهر وميض البندقية \Nباتجاه الساعة الثامنة 
Dialogue: 0,1:03:31.22,1:03:32.51,Default,,0,0,0,,!فلنحاصرهم
Dialogue: 0,1:03:39.44,1:03:40.75,Default,,0,0,0,,.. طلقة الرصاص هذه
Dialogue: 0,1:03:40.75,1:03:41.77,Default,,0,0,0,,!من هنا
Dialogue: 0,1:04:23.52,1:04:24.56,Default,,0,0,0,,!فلنطارده
Dialogue: 0,1:04:34.37,1:04:35.30,Default,,0,0,0,,!مفرقعات نارية؟
Dialogue: 0,1:04:35.30,1:04:36.33,Default,,0,0,0,,!انبطحي
Dialogue: 0,1:04:44.83,1:04:45.75,Default,,0,0,0,,!ابتعدي
Dialogue: 0,1:04:59.39,1:05:00.06,Default,,0,0,0,,!سحقًا
Dialogue: 0,1:05:00.43,1:05:02.52,Default,,0,0,0,,!كان-تشان! اهرب
Dialogue: 0,1:05:14.45,1:05:15.58,Default,,0,0,0,,!كومي
Dialogue: 0,1:05:22.25,1:05:23.46,Default,,0,0,0,,...!كومي
Dialogue: 0,1:05:23.59,1:05:24.95,Default,,0,0,0,,!كومي
Dialogue: 0,1:05:24.94,1:05:25.92,Default,,0,0,0,,...لا
Dialogue: 0,1:05:26.71,1:05:27.65,Default,,0,0,0,,أين أنت؟
Dialogue: 0,1:05:27.65,1:05:29.71,Default,,0,0,0,,!المفتش ياماتو
Dialogue: 0,1:05:37.93,1:05:40.02,Default,,0,0,0,,المفتش ياماتو! هل أنت بخير؟!
Dialogue: 0,1:05:40.15,1:05:42.65,Default,,0,0,0,,!كومي سقط هناك
Dialogue: 0,1:05:47.32,1:05:48.70,Default,,0,0,0,,..أكرر
Dialogue: 0,1:05:48.82,1:05:54.08,Default,,0,0,0,,.إشارة الطوارئ المستلمة من موروفوشي تاكاكي  من قسم التحقيقات الأول قد اختفت
Dialogue: 0,1:05:54.20,1:05:56.24,Default,,0,0,0,,.لقد فقدنا الاتصال
Dialogue: 0,1:05:56.45,1:05:58.08,Default,,0,0,0,,...المفتش موروفوشي
Dialogue: 0,1:06:10.05,1:06:13.18,Default,,0,0,0,,..في الحياة هناك دائمًا موت
Dialogue: 0,1:06:13.30,1:06:17.18,Default,,0,0,0,,..وطول العمر يعتمد على القدر
Dialogue: 0,1:06:17.31,1:06:21.31,Default,,0,0,0,,!أين أنت! كومي! كلمني
Dialogue: 0,1:06:21.44,1:06:24.19,Default,,0,0,0,,!لا أستطيع رؤيته بالقرب من الحفرة
Dialogue: 0,1:06:24.31,1:06:25.56,Default,,0,0,0,,هل هو تحت الثلج؟
Dialogue: 0,1:06:25.98,1:06:27.57,Default,,0,0,0,,!إنه نهر متجمد
Dialogue: 0,1:06:27.69,1:06:29.53,Default,,0,0,0,,هل جرفته المياه؟
Dialogue: 0,1:06:30.40,1:06:33.03,Default,,0,0,0,,ماذا عن نظام تحديد المواقع الخاص بالمفتش موروفوشي؟
Dialogue: 0,1:06:33.16,1:06:34.27,Default,,0,0,0,,.خارج النطاق
Dialogue: 0,1:06:34.26,1:06:35.28,Default,,0,0,0,,!تبا
Dialogue: 0,1:06:36.20,1:06:38.70,Default,,0,0,0,,!تبًا لكل شيء
Dialogue: 0,1:06:43.75,1:06:45.29,Default,,0,0,0,,...أخي
Dialogue: 0,1:06:47.09,1:06:49.34,Default,,0,0,0,,...أخي
Dialogue: 0,1:06:50.42,1:06:51.21,Default,,0,0,0,,!أخي
Dialogue: 0,1:07:00.39,1:07:01.64,Default,,0,0,0,,...مستحيل
Dialogue: 0,1:07:02.56,1:07:05.10,Default,,0,0,0,,هل هذا أنت، هيروميتسو؟
Dialogue: 0,1:07:05.40,1:07:07.65,Default,,0,0,0,,!نعم, أدركتك قبل فوات الأوان
Dialogue: 0,1:07:07.98,1:07:09.94,Default,,0,0,0,,...هيروميتسو... أنت
Dialogue: 0,1:07:10.28,1:07:12.78,Default,,0,0,0,,ألست ميتًا؟
Dialogue: 0,1:07:12.90,1:07:15.19,Default,,0,0,0,,لقد انضممت إلى الأمن العام، أليس كذلك؟
Dialogue: 0,1:07:15.32,1:07:19.78,Default,,0,0,0,,.لقد كوّنت صداقة مع شخص ذكي جدًا في المنظمة التي كنت أتسلل إليها
Dialogue: 0,1:07:20.25,1:07:23.67,Default,,0,0,0,,.ساعدني في تزوير موتي
Dialogue: 0,1:07:24.71,1:07:27.76,Default,,0,0,0,,...ثم عدت إلى ناغانو وسمعت أنك مفقود
Dialogue: 0,1:07:27.88,1:07:31.18,Default,,0,0,0,,.لذا تابعت راديو الشرطة إلى هنا
Dialogue: 0,1:07:32.38,1:07:34.97,Default,,0,0,0,,.لقد اشتقت إليك حقًا، يا أخي
Dialogue: 0,1:07:35.09,1:07:37.09,Default,,0,0,0,,.هيا، لنعُد إلى البيت
Dialogue: 0,1:07:37.22,1:07:38.81,Default,,0,0,0,,!لا, أنت مخطئ
Dialogue: 0,1:07:38.93,1:07:43.60,Default,,0,0,0,,.إذا تابعت راديو الشرطة، لما كنت وحدك
Dialogue: 0,1:07:44.60,1:07:49.27,Default,,0,0,0,,يبدو أن هذا المكان ليس الواقع
Dialogue: 0,1:07:53.36,1:07:54.74,Default,,0,0,0,,...هيروميتسو
Dialogue: 0,1:07:59.08,1:08:00.79,Default,,0,0,0,,.. للأسف ولكن
Dialogue: 0,1:08:02.91,1:08:03.87,Default,,0,0,0,,!هناك
Dialogue: 0,1:08:04.54,1:08:05.62,Default,,0,0,0,,!إنه هنا
Dialogue: 0,1:08:05.75,1:08:06.69,Default,,0,0,0,,!إنه سميك
Dialogue: 0,1:08:06.69,1:08:07.59,Default,,0,0,0,,ماذا يمكننا أن نفعل؟
Dialogue: 0,1:08:07.71,1:08:08.67,Default,,0,0,0,,!ابتعدوا
Dialogue: 0,1:08:14.22,1:08:15.18,Default,,0,0,0,,!المفتش موروفوشي
Dialogue: 0,1:08:15.59,1:08:16.97,Default,,0,0,0,,!سأدخل
Dialogue: 0,1:08:21.93,1:08:23.85,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,1:08:25.31,1:08:26.17,Default,,0,0,0,,!إنه على قيد الحياة
Dialogue: 0,1:08:26.17,1:08:26.98,Default,,0,0,0,,.أحضروه إلى هنا
Dialogue: 0,1:08:27.10,1:08:28.10,Default,,0,0,0,,!من فضلك
Dialogue: 0,1:08:28.23,1:08:29.94,Default,,0,0,0,,.لسنا بعيدين عن كوخ الفحم
Dialogue: 0,1:08:30.06,1:08:31.77,Default,,0,0,0,,.يمكننا طلب المساعدة هناك
Dialogue: 0,1:08:31.90,1:08:33.19,Default,,0,0,0,,!سنسبقكم
Dialogue: 0,1:08:33.94,1:08:35.44,Default,,0,0,0,,...هيرو... ميتسو
Dialogue: 0,1:08:38.41,1:08:40.08,Default,,0,0,0,,هيروميتسو؟
Dialogue: 0,1:08:52.63,1:08:54.80,Default,,0,0,0,,تفضلوا وارتاحوا في منزلي من فضلكم
Dialogue: 0,1:08:54.92,1:08:57.72,Default,,0,0,0,,.سأعود بعد أن أنهي تنظيف الموقد
Dialogue: 0,1:09:00.84,1:09:03.15,Default,,0,0,0,,.فكرة جيدة، ثم إنّ كونان-كن معنا أيضًا
Dialogue: 0,1:09:03.30,1:09:04.67,Default,,0,0,0,,‫أنا بخير.
Dialogue: 0,1:09:04.73,1:09:08.05,Default,,0,0,0,,ولكن.. ما هي غاية الجاني؟
Dialogue: 0,1:09:08.22,1:09:10.33,Default,,0,0,0,,أنا المستهدف‫.
Dialogue: 0,1:09:10.42,1:09:14.00,Default,,0,0,0,,ليتني أتذكر شيئاً من ذلك المشهد‫..‫
Dialogue: 0,1:09:17.39,1:09:18.68,Default,,0,0,0,,ما كان هذا؟
Dialogue: 0,1:09:27.59,1:09:30.85,Default,,0,0,0,,شخص ما شغًل مكبّر الصوت الذي\Nيسبب إنهياراً ثلجياً‫!
Dialogue: 0,1:09:30.91,1:09:33.68,Default,,0,0,0,,علينا الابتعاد من هنا حالاً‫!
Dialogue: 0,1:09:33.93,1:09:34.95,Default,,0,0,0,,كونان-كن‫.
Dialogue: 0,1:09:37.41,1:09:39.56,Default,,0,0,0,,لم يعد هنا! ذاك السلاح اختفى‫!
Dialogue: 0,1:09:39.59,1:09:41.92,Default,,0,0,0,,ما الذي تفعله هنا؟\N!اخرج بسرعة
Dialogue: 0,1:09:41.94,1:09:43.32,Default,,0,0,0,,سينهار الكوخ فوراً‫!
Dialogue: 0,1:09:43.34,1:09:45.31,Default,,0,0,0,,لا يوجد مهرب من هنا‫!
Dialogue: 0,1:09:45.34,1:09:48.45,Default,,0,0,0,,سأحدث انهياراً ثلجياً آخر لأوقف هذا الانهيار‫!
Dialogue: 0,1:09:48.48,1:09:52.79,Default,,0,0,0,,فهمت، انهيارٌ ثلجيٌ\Nمن الغرب لإيقاف الانهيار الشمالي‫.
Dialogue: 0,1:09:52.94,1:09:55.62,Default,,0,0,0,,هل يوجد شيء نستطيع استخدامه؟ -\Nذلك الجهاز -
Dialogue: 0,1:09:55.66,1:09:59.25,Default,,0,0,0,,أحتاج شيئاً لتنشيط الجهاز الغربي‫.
Dialogue: 0,1:10:01.52,1:10:04.60,Default,,0,0,0,,هل هذا مناسب يا كونان؟- \Nنعم  -‫
Dialogue: 0,1:10:07.45,1:10:12.35,Default,,0,0,0,,.مفتش ياماتو، أطلق النار على هذه الزجاجة
Dialogue: 0,1:10:15.04,1:10:17.26,Default,,0,0,0,,أوه! حسناً‫.
Dialogue: 0,1:10:23.43,1:10:24.83,Default,,0,0,0,,ألم تصبها؟‫!
Dialogue: 0,1:10:24.87,1:10:26.40,Default,,0,0,0,,حاول مرة أخرى -\Nحسناً -
Dialogue: 0,1:10:32.42,1:10:34.24,Default,,0,0,0,,تباً، أخطأت؟
Dialogue: 0,1:10:34.26,1:10:37.57,Default,,0,0,0,,.هذه الأخيرة يا كونان
Dialogue: 0,1:10:50.69,1:10:53.97,Default,,0,0,0,,..الأن يا مفتش ياماتو
Dialogue: 0,1:11:05.58,1:11:07.89,Default,,0,0,0,,لقد نجح وبدأ الإنهيار‫!
Dialogue: 0,1:11:07.92,1:11:10.51,Default,,0,0,0,,تباً، لن يوقفه في الوقت المناسب‫!
Dialogue: 0,1:11:10.56,1:11:12.42,Default,,0,0,0,,تباً، هل كنت متأخراً؟
Dialogue: 0,1:11:12.45,1:11:16.69,Default,,0,0,0,,!تعال يا طفل، سنحتمي في الفرن
Dialogue: 0,1:11:35.93,1:11:38.91,Default,,0,0,0,,انتظر، المفتش ياماتو لم يأتِ بعد‫!
Dialogue: 0,1:11:59.66,1:12:02.93,Default,,0,0,0,,توقف النهيار الثلجي ولكن أين المفتش ياماتو؟
Dialogue: 0,1:12:05.75,1:12:08.58,Default,,0,0,0,,مستحيل! هل يعقل؟
Dialogue: 0,1:12:08.69,1:12:11.79,Default,,0,0,0,,وأين هو رجل الفحم أوتومو؟
Dialogue: 0,1:12:11.83,1:12:14.38,Default,,0,0,0,,.يجب أن نحضر فريق الإنقاذ -\Nحسناً -
Dialogue: 0,1:12:15.86,1:12:17.36,Default,,0,0,0,,مفتش ياماتو‫!
Dialogue: 0,1:12:17.54,1:12:21.33,Default,,0,0,0,,!أجبني رجاءً\Nمفتش ياماتو‫!
Dialogue: 0,1:12:21.40,1:12:23.35,Default,,0,0,0,,مفتش ياماتو‫!
Dialogue: 0,1:12:33.86,1:12:34.71,Default,,0,0,0,,!كونان
Dialogue: 0,1:12:34.74,1:12:35.87,Default,,0,0,0,,!كونان-كن
Dialogue: 0,1:12:35.89,1:12:38.39,Default,,0,0,0,,أعتذر على إقلاقكم‫.
Dialogue: 0,1:12:38.50,1:12:39.61,Default,,0,0,0,,أبي‫!‫
Dialogue: 0,1:12:39.68,1:12:41.37,Default,,0,0,0,,نحن بخير‫.
Dialogue: 0,1:12:41.49,1:12:43.68,Default,,0,0,0,,أعتذر على التأخير‫.
Dialogue: 0,1:12:43.77,1:12:45.66,Default,,0,0,0,,{\b1}{\c&HB469FF&}تفضل، هل تريد شايًا أسود؟{\c}{\b0}
Dialogue: 0,1:12:45.69,1:12:47.32,Default,,0,0,0,,نعم، شكراً لك
Dialogue: 0,1:12:47.37,1:12:48.38,Default,,0,0,0,,{\b1}{\c&HB469FF&}.انتبه!، إنه ساخن{\c}{\b0}
Dialogue: 0,1:12:48.40,1:12:49.69,Default,,0,0,0,,كيف حال المفتش موروفوشي؟
Dialogue: 0,1:12:49.76,1:12:52.95,Default,,0,0,0,,.إنه بخير\N.لا يوجد خطر على حياته
Dialogue: 0,1:12:53.96,1:12:56.96,Default,,0,0,0,,ماذا عن كاتشا-.. المفتش ياماتو؟
Dialogue: 0,1:12:57.21,1:12:59.25,Default,,0,0,0,,.فرق الإنقاذ تبحث عنه الآن
Dialogue: 0,1:12:59.30,1:13:03.14,Default,,0,0,0,,..بالمناسبة‫, هذه قفازات المجرم التي عضها ذلك الطفل
Dialogue: 0,1:13:03.59,1:13:05.77,Default,,0,0,0,,.أظهرت نتيجة الفحص أنه جلد غزال
Dialogue: 0,1:13:06.05,1:13:08.41,Default,,0,0,0,,.لقد طلبنا من الطب الشرعي التحقق منها
Dialogue: 0,1:13:08.69,1:13:10.44,Default,,0,0,0,,..الآن
Dialogue: 0,1:13:10.64,1:13:14.54,Default,,0,0,0,,الآن‫.. تلقيت اتصالاً من فريق الإنقاذ‫..
Dialogue: 0,1:13:14.72,1:13:19.21,Default,,0,0,0,,.لقد عُثِر على المفتش ياماتو
Dialogue: 0,1:13:19.64,1:13:20.95,Default,,0,0,0,,..لكن
Dialogue: 0,1:13:21.38,1:13:26.24,Default,,0,0,0,,لكن قبل نقله إلى المستشفى‫..
Dialogue: 0,1:13:26.35,1:13:28.01,Default,,0,0,0,,..المفتش ياماتو
Dialogue: 0,1:13:28.21,1:13:31.82,Default,,0,0,0,,!تم تأكيد وفاته
Dialogue: 0,1:13:34.63,1:13:36.70,Default,,0,0,0,,.مسـ..ـتحيل
Dialogue: 0,1:13:39.94,1:13:41.05,Default,,0,0,0,,كلّا‫..
Dialogue: 0,1:13:42.75,1:13:45.18,Default,,0,0,0,,!هذه كذبة
Dialogue: 0,1:13:46.34,1:13:47.54,Default,,0,0,0,,!كاتشان
Dialogue: 0,1:13:47.58,1:13:48.90,Default,,0,0,0,,!كاتشان
Dialogue: 0,1:13:49.50,1:13:51.23,Default,,0,0,0,,كاتشان‫!
Dialogue: 0,1:13:54.57,1:13:55.63,Default,,0,0,0,,!تباً
Dialogue: 0,1:13:56.06,1:13:58.25,Default,,0,0,0,,!المفتش ياماتو أيضاً
Dialogue: 0,1:14:04.82,1:14:07.08,Default,,0,0,0,,..ذلك الانهيار قبل عشرة أشهر
Dialogue: 0,1:14:07.50,1:14:12.29,Default,,0,0,0,,!لا بدّ أن الجاني كان يفعل هناك شيئًا لا يريد لأحدٍ أن يراه
Dialogue: 0,1:14:12.44,1:14:18.75,Default,,0,0,0,,لهذا قتلوا المفتش ياماتو والمفتش\Nساميتاني، لأنهم شهدوا وحققوا بجريمتهم‫.
Dialogue: 0,1:14:18.89,1:14:21.92,Default,,0,0,0,,تباً، كل شيء يسير كما خطط له القاتل‫!
Dialogue: 0,1:14:22.07,1:14:26.48,Default,,0,0,0,,أتيت لأنتقم لواني، والآن يوجد ضحية أخرى‫!
Dialogue: 0,1:14:27.14,1:14:28.21,Default,,0,0,0,,أبي‫..
Dialogue: 0,1:14:28.29,1:14:31.42,Default,,0,0,0,,لطالما تساءلت عن سبب دعوتك إياه بـ"واني"؟
Dialogue: 0,1:14:31.49,1:14:34.66,Default,,0,0,0,,بالفعل، اسمه ساميتاني؛ فلماذا إذن؟
Dialogue: 0,1:14:34.72,1:14:37.86,Default,,0,0,0,,على ما يبدو، في مسقط رأسه، يُطلقون على أسماك القرش اسم واني‫.
Dialogue: 0,1:14:38.00,1:14:40.21,Default,,0,0,0,,أين كان مسقط رأسه؟
Dialogue: 0,1:14:40.26,1:14:43.79,Default,,0,0,0,,لا أدري, لقد نسيت
Dialogue: 0,1:14:44.28,1:14:49.90,Default,,0,0,0,,بحثت عن اسم "تاكاشيي اوتومو" في سجلات\Nترخيص حمل سلاح الصيد، لكنني لم أجده
Dialogue: 0,1:14:49.97,1:14:54.15,Default,,0,0,0,,لكن وجدتُ اسمًا سيثير اهتمامك في سجلات محافظة ناغانو‫.
Dialogue: 0,1:14:54.19,1:14:55.45,Default,,0,0,0,,!كما توقعت
Dialogue: 0,1:14:55.49,1:14:58.44,Default,,0,0,0,,هل يُمكنك البحث في سجل عائلة هذا الشخص؟
Dialogue: 0,1:14:58.83,1:15:02.10,Default,,0,0,0,,!أنت شخصٌ يطلب كثيراً
Dialogue: 0,1:15:04.97,1:15:06.54,Default,,0,0,0,,ألا تمانع الحديث بوجود جهاز التنصت؟
Dialogue: 0,1:15:06.58,1:15:14.60,Default,,0,0,0,,من كان يستمع إلى جهاز التنصت هو السيد (كازامي) \N.ويبدو أنه بدأ التحقيق بالقضية بعد موت المفتش (ساميتاني)
Dialogue: 0,1:15:14.73,1:15:18.93,Default,,0,0,0,,آمورو-سان، أنت من أمرت بالتحقيق عن\Nالإنهيار الجليدي قبل عشرة أشهر، أليس كذلك؟
Dialogue: 0,1:15:19.11,1:15:21.77,Default,,0,0,0,,ومن كلفته بالمهمة كان العميل المتخفي\N.للأمن العام، المفتش ساميتاني
Dialogue: 0,1:15:21.80,1:15:23.96,Default,,0,0,0,,..إذن أخبرك كازامي
Dialogue: 0,1:15:24.12,1:15:26.06,Default,,0,0,0,,!كما توقعت إذن
Dialogue: 0,1:15:26.09,1:15:31.99,Default,,0,0,0,,!اطمئن, فرغم إلحاحي الشديد إلا أن السيد (كازامي) رفض أن يجيبني ليحميك
Dialogue: 0,1:15:32.24,1:15:39.18,Default,,0,0,0,,السؤال هو : لماذا كًّلفت أنت والشرطة الوطنية\Nوالمفتش ساميتاني بالتحقيق في هذه القضية؟
Dialogue: 0,1:15:39.43,1:15:42.37,Default,,0,0,0,,ربما السبب هو غاية المجرم، أليس كذلك؟
Dialogue: 0,1:15:42.39,1:15:47.67,Default,,0,0,0,,وربما كل هذا مرتبط بصفقة الإقرار بالذنب\N.الجديدة التي يناقشها البرلمان الآن
Dialogue: 0,1:15:47.75,1:15:50.13,Default,,0,0,0,,ما الذي يحدث في اليابان الآن؟
Dialogue: 0,1:15:50.59,1:15:53.17,Default,,0,0,0,,!لا داعي لمعرفة ذلك
Dialogue: 0,1:15:53.30,1:15:56.52,Default,,0,0,0,,حتى لو عثرتُ على الجاني؟
Dialogue: 0,1:15:57.23,1:15:58.80,Default,,0,0,0,,!كونان-كن
Dialogue: 0,1:15:59.07,1:16:01.32,Default,,0,0,0,,أوه، أين ذهب؟
Dialogue: 0,1:16:04.80,1:16:05.82,Default,,0,0,0,,ماذا حدث؟
Dialogue: 0,1:16:05.96,1:16:08.55,Default,,0,0,0,,مستحيل‫!.. إنها من شينتشي‫!
Dialogue: 0,1:16:18.61,1:16:22.43,Default,,0,0,0,,أعتذر عن استدعائك إلى هنا يا إيزو فانوكوبو‫.
Dialogue: 0,1:16:22.45,1:16:24.65,Default,,0,0,0,,أوه، أنت
Dialogue: 0,1:16:24.80,1:16:26.18,Default,,0,0,0,,لماذا دعوتني إلى هنا؟
Dialogue: 0,1:16:26.54,1:16:30.32,Default,,0,0,0,,لأنني وجدت الشخص\Nالذي تبحث عنه، تاكاشي واشيزو
Dialogue: 0,1:16:30.50,1:16:31.64,Default,,0,0,0,,وجدته‫؟!
Dialogue: 0,1:16:32.00,1:16:38.15,Default,,0,0,0,,أنت من قدمت زنبقة الوادي البيضاء لقبر\Nماكي سان، أليس كذلك؟
Dialogue: 0,1:16:39.74,1:16:41.22,Default,,0,0,0,,..أوه.. هو؟
Dialogue: 0,1:16:41.36,1:16:42.89,Default,,0,0,0,,تاكاشي اوتومو
Dialogue: 0,1:16:42.91,1:16:46.10,Default,,0,0,0,,..سمعت أن لديك كدمات على ذراعك وكتفك الأيسر
Dialogue: 0,1:16:46.15,1:16:47.16,Default,,0,0,0,,هاه؟
Dialogue: 0,1:16:47.19,1:16:48.19,Default,,0,0,0,,.المعذرة
Dialogue: 0,1:16:48.62,1:16:49.62,Default,,0,0,0,,!انتظروا
Dialogue: 0,1:16:49.85,1:16:52.64,Default,,0,0,0,,إن ارتداد البندقية هو ما يشكل\Nهذه العلامة، أليس كذلك؟
Dialogue: 0,1:16:53.12,1:16:55.51,Default,,0,0,0,,تلك الموجودة على إبطه الأيمن\N.وأعلى ذراعه اليسرى
Dialogue: 0,1:16:55.67,1:16:57.71,Default,,0,0,0,,!كلّا، هذه العلامات بسبب قطع الأشجار
Dialogue: 0,1:16:57.82,1:16:58.99,Default,,0,0,0,,!لقد فهمت
Dialogue: 0,1:16:59.08,1:17:01.48,Default,,0,0,0,,..مثل يو رانج من مملكة الجن
Dialogue: 0,1:17:01.69,1:17:03.98,Default,,0,0,0,,.الذي غطى جسمه بالورنيش وابتلع الفحم
Dialogue: 0,1:17:04.00,1:17:05.10,Default,,0,0,0,,مفتش مابوروشي‫!
Dialogue: 0,1:17:05.53,1:17:07.23,Default,,0,0,0,,هل خرجت من المستشفى؟
Dialogue: 0,1:17:07.27,1:17:08.20,Default,,0,0,0,,.نعم
Dialogue: 0,1:17:08.22,1:17:11.03,Default,,0,0,0,,همم. يو رانج من مملكة جن؟
Dialogue: 0,1:17:11.10,1:17:14.27,Default,,0,0,0,,أوه، هذه قصة من "سيرة مدربي القتلة‫"\N..في سجلات المؤرخين
Dialogue: 0,1:17:14.33,1:17:18.49,Default,,0,0,0,,يقال إن رجلًا اسمه يو رانج من مملكة الجن\N..غطى جلده بالورنيش لادعاء مرض جلدي
Dialogue: 0,1:17:18.62,1:17:20.32,Default,,0,0,0,,..ثم ابتلع الفحم لتغيير صوته
Dialogue: 0,1:17:20.49,1:17:24.06,Default,,0,0,0,,.واختبأ حتى لا تُكشف هويته
Dialogue: 0,1:17:24.12,1:17:30.59,Default,,0,0,0,,ما نعنيه يا تاكاشي اوتومو-سان هو أنك\Nغيرت اسمك ووجهك، أليس كذلك؟
Dialogue: 0,1:17:31.13,1:17:35.54,Default,,0,0,0,,وجدنا أن اسم تاكاشي واشيزو غير موجود في\N.سجلات حمل السلاح
Dialogue: 0,1:17:35.87,1:17:40.20,Default,,0,0,0,,!أنا أعرف بأن لديه رخصة صيد
Dialogue: 0,1:17:40.40,1:17:42.41,Default,,0,0,0,,واشيزو..تاكاشي..؟
Dialogue: 0,1:17:42.49,1:17:45.23,Default,,0,0,0,,تماماً.. واشيزو تاكاشي تُبُنّي\Nمن عائلة أخرى
Dialogue: 0,1:17:45.38,1:17:47.36,Default,,0,0,0,,..وغير اسم عائلته إلى أوتومو
Dialogue: 0,1:17:47.69,1:17:49.78,Default,,0,0,0,,.لقد اكتشفنا ذلك من سجلات عائلته
Dialogue: 0,1:17:49.85,1:17:54.05,Default,,0,0,0,,‫ -لا أصدق أنك كنت هنا، طوال هذا الوقت‫!\N!أوتوما سان اهدأ -
Dialogue: 0,1:17:54.09,1:17:55.05,Default,,0,0,0,,أوتوما-سان
Dialogue: 0,1:17:55.07,1:17:59.07,Default,,0,0,0,,لقد أُدِنت بالجريمة قبل ثماني سنوات\N!وحكم عليك بالإيقاف
Dialogue: 0,1:17:59.16,1:18:01.91,Default,,0,0,0,,واختفيت بعد انتهاء فترة إيقافك التي استمرت ثلاثة سنين
Dialogue: 0,1:18:02.03,1:18:07.29,Default,,0,0,0,,ثم عدت إلى ناغانو\N!على ذلك الجبل حيث قبر ماكي-سان
Dialogue: 0,1:18:07.85,1:18:13.04,Default,,0,0,0,,..بسبب حصولي على حكم بالإيقاف انتحرت (ماكي)
Dialogue: 0,1:18:13.64,1:18:15.77,Default,,0,0,0,,!لم أعد أحتمل نفسي
Dialogue: 0,1:18:15.94,1:18:18.92,Default,,0,0,0,,!علمت أنني يجب أن أعتذر لوالديها
Dialogue: 0,1:18:19.34,1:18:22.62,Default,,0,0,0,,!لكن .. لم تكن لدي الشجاعة الكافية
Dialogue: 0,1:18:23.06,1:18:26.60,Default,,0,0,0,,!على الأقل استطعت أن أعتذر عند قبرها
Dialogue: 0,1:18:26.63,1:18:28.24,Default,,0,0,0,,..أو هكذا شعرت
Dialogue: 0,1:18:28.37,1:18:29.57,Default,,0,0,0,,.لهذا تركت لها ورداً
Dialogue: 0,1:18:29.72,1:18:34.99,Default,,0,0,0,,تركت الورد مبكراً قبل ذكرى وفاتها\N.وغيرت وجهك واسمك حتى لا يعرفك أحد
Dialogue: 0,1:18:35.22,1:18:39.31,Default,,0,0,0,,هل لهذا السبب افتتحت كوخاً للفحم\Nعلى ذلك الجبل؟
Dialogue: 0,1:18:39.46,1:18:43.08,Default,,0,0,0,,هنالك سبب لتسميته "بوبا"، أليس كذلك؟
Dialogue: 0,1:18:43.37,1:18:45.33,Default,,0,0,0,,.إنه لقبي
Dialogue: 0,1:18:45.55,1:18:46.93,Default,,0,0,0,,لقب؟
Dialogue: 0,1:18:47.12,1:18:50.15,Default,,0,0,0,,.ميكوريا فقط من يعرف عن هذا اللقب
Dialogue: 0,1:18:50.42,1:18:55.07,Default,,0,0,0,,فهمت، لهذا السبب أدرك ميكوريا أنك\N!كنت على هذا الجبل
Dialogue: 0,1:18:55.58,1:18:59.69,Default,,0,0,0,,المفتش ياماتو وجد ميكوري\Nوتعرض للانهيار الجليدي‫.
Dialogue: 0,1:19:00.08,1:19:03.31,Default,,0,0,0,,!لقد رأيت ذلك الانهيار الجليدي أيضًا
Dialogue: 0,1:19:18.71,1:19:21.75,Default,,0,0,0,,إذن أنت هو من ساعد كان-تشان؟
Dialogue: 0,1:19:22.14,1:19:24.60,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,1:19:24.80,1:19:29.36,Default,,0,0,0,,لقد خنت ميكورا بصفقة الإقرار\N..بالذنب وصدر علي حكم إيقاف
Dialogue: 0,1:19:29.47,1:19:31.01,Default,,0,0,0,,بات من المؤكد أنه سيحمل ضغينة لي
Dialogue: 0,1:19:31.04,1:19:36.30,Default,,0,0,0,,ألهذا كنت ستنتظره\Nحتى يخرج من السجن ويقتلك؟
Dialogue: 0,1:19:36.44,1:19:38.53,Default,,0,0,0,,لن أسامحك‫!
Dialogue: 0,1:19:38.57,1:19:39.57,Default,,0,0,0,,أنا‫..
Dialogue: 0,1:19:39.73,1:19:44.61,Default,,0,0,0,,أنا لن أسامحك أنت و ميكوريا أبداً‫.
Dialogue: 0,1:19:45.47,1:19:46.47,Default,,0,0,0,,لكن‫..
Dialogue: 0,1:19:46.91,1:19:51.40,Default,,0,0,0,,لكن.. أن يقتلك ميكوريا هو أمر\N!لن أغفره أكثر
Dialogue: 0,1:19:52.10,1:19:56.67,Default,,0,0,0,,لانني أنا من يريد قتلك‫!
Dialogue: 0,1:19:56.91,1:20:01.52,Default,,0,0,0,,لمدة ثماني سنوات! كل هذه السنين‫!
Dialogue: 0,1:20:01.90,1:20:04.88,Default,,0,0,0,,هكذا قضيت هذه الثمان سنين
Dialogue: 0,1:20:05.28,1:20:08.79,Default,,0,0,0,,ماذا عنك؟ كيف قضيتها أنت؟
Dialogue: 0,1:20:08.95,1:20:13.43,Default,,0,0,0,,كيف استطعت العيش بعد قتلك ماكي؟
Dialogue: 0,1:20:14.50,1:20:17.55,Default,,0,0,0,,لماذا احضرت الورود إلى قبرها؟‫!
Dialogue: 0,1:20:18.13,1:20:22.07,Default,,0,0,0,,أخبرني كيف قضيت هذه الثمان سنوات؟
Dialogue: 0,1:20:23.14,1:20:24.74,Default,,0,0,0,,!أنا أسف
Dialogue: 0,1:20:25.93,1:20:27.75,Default,,0,0,0,,أنا أسف جداً حقاً‫!
Dialogue: 0,1:20:30.68,1:20:33.67,Default,,0,0,0,,!أنتما هنا يا ران وكونان
Dialogue: 0,1:20:33.79,1:20:37.15,Default,,0,0,0,,بسبب كل ما حدث بالأمس، لم\N..نستطع أن نراقب النجوم
Dialogue: 0,1:20:37.66,1:20:42.44,Default,,0,0,0,,لقد جهزت كل شيء حتى نستطيع صنع نجوم\N!بواسطة الليزر ومشاهدة السماء
Dialogue: 0,1:20:42.72,1:20:46.64,Default,,0,0,0,,!قبل ذلك، سنقوم بالتحقيق في الموقع
Dialogue: 0,1:20:51.32,1:20:57.70,Default,,0,0,0,,إذن، لنبدأ التحقيق في قضية قتل المفتشان\N..ساميتاني وياماتو
Dialogue: 0,1:20:57.98,1:21:00.54,Default,,0,0,0,,قتل..؟\Nلماذا نحقق في ذلك هنا؟
Dialogue: 0,1:21:00.85,1:21:06.69,Default,,0,0,0,,ذلك لأن من قام بقتل الشرطة ومهاجمة\N!الباحثين كان المجرم نفسه
Dialogue: 0,1:21:07.15,1:21:09.19,Default,,0,0,0,,هل هذا ما تقترحه؟
Dialogue: 0,1:21:09.23,1:21:10.15,Default,,0,0,0,,.نعم
Dialogue: 0,1:21:10.32,1:21:14.80,Default,,0,0,0,,لابد أن (واني) كان عميل أمن عام متخفيًا؛ ولذلك تورط في القضية
Dialogue: 0,1:21:15.25,1:21:17.47,Default,,0,0,0,,!لابد أن ذاك الشخص أيضًا عميل متخفٍّ
Dialogue: 0,1:21:17.57,1:21:18.53,Default,,0,0,0,,هاه؟
Dialogue: 0,1:21:21.93,1:21:23.38,Default,,0,0,0,,أليس كذلك يا عم؟
Dialogue: 0,1:21:23.60,1:21:25.63,Default,,0,0,0,,لقد وعدت بأنك لن تخبر أحداً‫!
Dialogue: 0,1:21:25.65,1:21:26.97,Default,,0,0,0,,!كلا، هذا يكفي
Dialogue: 0,1:21:28.90,1:21:30.71,Default,,0,0,0,,مفتش كازامي؟
Dialogue: 0,1:21:31.06,1:21:32.02,Default,,0,0,0,,..أنت
Dialogue: 0,1:21:32.04,1:21:33.05,Default,,0,0,0,,من هذا؟
Dialogue: 0,1:21:33.07,1:21:34.18,Default,,0,0,0,,.شرطي من الأمن العام
Dialogue: 0,1:21:34.21,1:21:38.82,Default,,0,0,0,,.."مفتش (هاياتي), بعد أن تم تعيينك كضابط في قسم الأمن بشرطة "ياماناشي
Dialogue: 0,1:21:39.01,1:21:43.36,Default,,0,0,0,,.قامت شرطة الأمن العام بتجنيدك لها وعينتك في القسم الإقليمي ضابطًا سريًا
Dialogue: 0,1:21:43.93,1:21:45.06,Default,,0,0,0,,هذا صحيح‫..
Dialogue: 0,1:21:45.58,1:21:50.89,Default,,0,0,0,,.هذا المنصب مكنك من التخلص من أسلحة ومتفجرات
Dialogue: 0,1:21:51.67,1:21:53.68,Default,,0,0,0,,أخبرني المفتش ياماتو بأنه قبل عدة سنين‫..
Dialogue: 0,1:21:53.78,1:21:59.92,Default,,0,0,0,,صودر مسدس بإمكانه إطلاق رصاصات بنادق\N..الصيد بالقرب من حدود ياماناشي وناغانو
Dialogue: 0,1:22:00.25,1:22:02.31,Default,,0,0,0,,..وبالإمكان إخفاؤه داخل الملابس
Dialogue: 0,1:22:02.74,1:22:07.55,Default,,0,0,0,,.وإن غطيته فسيبدو كأنه بندقية صيد
Dialogue: 0,1:22:08.53,1:22:11.88,Default,,0,0,0,,وهكذا.. أطلق على واني‫..
Dialogue: 0,1:22:12.34,1:22:13.39,Default,,0,0,0,,..هكذا إذن
Dialogue: 0,1:22:13.49,1:22:17.72,Default,,0,0,0,,بعدها وضعت دراجتك النارية\N.عند مدخل القطار وهربت
Dialogue: 0,1:22:17.99,1:22:22.74,Default,,0,0,0,,على ذكرك هذا, فبالشارع نفسه يوجد مركز\Nإدارة الشرطة ووكالة الشرطة، أليس كذلك؟
Dialogue: 0,1:22:22.86,1:22:25.39,Default,,0,0,0,,.إن كان ضابط شرطة فسيتمكن من الهرب والاختباء هناك
Dialogue: 0,1:22:25.75,1:22:30.09,Default,,0,0,0,,.أغلقنا كل الطرق المؤدية إلى الجبل حالاً بعد استقبال إشارة الطوارئ
Dialogue: 0,1:22:30.79,1:22:33.91,Default,,0,0,0,,..والسبب الذي جعلنا نفقد المجرم رغم كل مافعلناه هو
Dialogue: 0,1:22:33.91,1:22:36.92,Default,,0,0,0,,.أن المجرم كان بين مجموعة البحث
Dialogue: 0,1:22:37.20,1:22:41.73,Default,,0,0,0,,.وإشارة الطوارئ التي أرسلتها قطعت مباشرة بسببك
Dialogue: 0,1:22:41.82,1:22:46.78,Default,,0,0,0,,الجاني كان يعرف عن إشارة طوارئ الشرطة \N.وكيفية قطعها بسرعة
Dialogue: 0,1:22:46.90,1:22:48.87,Default,,0,0,0,,أشياء لا يمكن إلا لشرطي أن يعرف عنها
Dialogue: 0,1:22:48.93,1:22:50.73,Default,,0,0,0,,كلا, أنا حقاً‫..
Dialogue: 0,1:22:50.92,1:22:51.92,Default,,0,0,0,,واني
Dialogue: 0,1:22:52.84,1:22:56.59,Default,,0,0,0,,أول مرة التقينا، قلت لك التالي‫..
Dialogue: 0,1:22:57.18,1:22:59.63,Default,,0,0,0,,..شكراً لك على مساعدتنا بقضية واني اليوم
Dialogue: 0,1:22:59.87,1:23:01.79,Default,,0,0,0,,هل أنت أيضاً من شرطة العاصمة؟
Dialogue: 0,1:23:01.90,1:23:05.57,Default,,0,0,0,,..لم تمتلك أي تساؤل حول اسم (واني)
Dialogue: 0,1:23:05.78,1:23:07.42,Default,,0,0,0,,لكن الباقين؟
Dialogue: 0,1:23:07.60,1:23:09.72,Default,,0,0,0,,!شكراً لكم على المساعدة في قضية واني
Dialogue: 0,1:23:10.07,1:23:10.94,Default,,0,0,0,,واني؟
Dialogue: 0,1:23:11.11,1:23:12.26,Default,,0,0,0,,واني؟
Dialogue: 0,1:23:12.48,1:23:13.49,Default,,0,0,0,,واني؟
Dialogue: 0,1:23:14.07,1:23:15.35,Default,,0,0,0,,هل واني هو..؟
Dialogue: 0,1:23:15.51,1:23:16.49,Default,,0,0,0,,واني؟
Dialogue: 0,1:23:16.51,1:23:19.09,Default,,0,0,0,,لا يعرف هذا اللقب أحد عداي
Dialogue: 0,1:23:20.32,1:23:21.29,Default,,0,0,0,,لكن‫..
Dialogue: 0,1:23:21.34,1:23:22.59,Default,,0,0,0,,ماذا حصل لك يا واني؟\Nواني‫!
Dialogue: 0,1:23:22.61,1:23:25.64,Default,,0,0,0,,إذن هذا هو واني؟‫!
Dialogue: 0,1:23:25.85,1:23:28.79,Default,,0,0,0,,هكذا إذن! لقد عرف لأنه كان موجوداً بموقع الجريمة‫!
Dialogue: 0,1:23:29.26,1:23:32.68,Default,,0,0,0,,!صحيح، لذلك عرفت بأن ساميتاني كان واني
Dialogue: 0,1:23:33.16,1:23:34.25,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,1:23:35.14,1:23:37.24,Default,,0,0,0,,!هذا مجرد دليل ظرفي
Dialogue: 0,1:23:37.69,1:23:40.36,Default,,0,0,0,,!هل تقول بأني الجاني بناءً على هذا فقط؟
Dialogue: 0,1:23:40.38,1:23:43.36,Default,,0,0,0,,!هذه القفازات تبدو دافئة
Dialogue: 0,1:23:43.84,1:23:45.50,Default,,0,0,0,,هل هي مصنوعة من جلد الغزال؟
Dialogue: 0,1:23:45.73,1:23:46.90,Default,,0,0,0,,هذه‫..
Dialogue: 0,1:23:46.96,1:23:53.34,Default,,0,0,0,,..بالمناسبة، قام الطب الشرعي هنا بالعثور على أثر من جلد الغزال في مسرح الجريمة
Dialogue: 0,1:23:53.53,1:23:55.49,Default,,0,0,0,,..في هذه المفاتيح التي سقطت في موقع الجريمة
Dialogue: 0,1:23:55.51,1:23:57.93,Default,,0,0,0,,.ومن مركبة الرادار المتنقلة
Dialogue: 0,1:23:58.31,1:24:07.55,Default,,0,0,0,,وهذه قطعة من جلد القفاز الذي قضمها جينتا-كن من الجاني الذي\N.هاجم المفتش ياماتو والضابطة أويهارا
Dialogue: 0,1:24:07.60,1:24:12.64,Default,,0,0,0,,التحليلات تظهر أنها القفازات نفسها\N.التي استخدمها الجاني
Dialogue: 0,1:24:12.82,1:24:14.01,Default,,0,0,0,,مما يعني أنك‫..
Dialogue: 0,1:24:14.03,1:24:18.44,Default,,0,0,0,,!تركت جبلاً من الأدلة التي تدينك
Dialogue: 0,1:24:22.82,1:24:24.84,Default,,0,0,0,,ماذ-؟
Dialogue: 0,1:24:25.53,1:24:28.15,Default,,0,0,0,,"كل المعارك تكسب بالمكيدة"
Dialogue: 0,1:24:28.91,1:24:30.55,Default,,0,0,0,,مفتش ياماتو‫!
Dialogue: 0,1:24:31.78,1:24:34.13,Default,,0,0,0,,هل كان استخدامي للمقولة صحيحاً؟
Dialogue: 0,1:24:34.45,1:24:35.81,Default,,0,0,0,,!أخبرني يا كومي
Dialogue: 0,1:24:35.91,1:24:36.77,Default,,0,0,0,,.نعم
Dialogue: 0,1:24:36.79,1:24:39.05,Default,,0,0,0,,بالطبع، لتكسب معركة، يجب أن تخدع عدوك‫.
Dialogue: 0,1:24:39.34,1:24:41.21,Default,,0,0,0,,.هذه كلمات سون تزو
Dialogue: 0,1:24:41.77,1:24:43.03,Default,,0,0,0,,أهلاً، يا-سان
Dialogue: 0,1:24:43.05,1:24:47.74,Default,,0,0,0,,.الانهيار الثلجي الذي سبببتَه أعاد إلي ذاكرتي
Dialogue: 0,1:24:47.86,1:24:53.19,Default,,0,0,0,,أتذكر تماماً من رأته\N.عيني قبل 10 أشهر
Dialogue: 0,1:25:25.30,1:25:27.28,Default,,0,0,0,,مفتش ياماتو‫!
Dialogue: 0,1:25:27.46,1:25:29.46,Default,,0,0,0,,مفتش ياماتو‫!
Dialogue: 0,1:25:29.56,1:25:30.73,Default,,0,0,0,,!أنا هنا
Dialogue: 0,1:25:32.52,1:25:34.11,Default,,0,0,0,,مفتش ياماتو‫!
Dialogue: 0,1:25:35.38,1:25:38.11,Default,,0,0,0,,..أنا أنظر إليك من فتحة مدخنة فرن الفحم
Dialogue: 0,1:25:38.62,1:25:40.76,Default,,0,0,0,,.أوتومو-سان أنقذني
Dialogue: 0,1:25:42.07,1:25:44.29,Default,,0,0,0,,.الحمد لله، سأطلب المساعدة حالاً
Dialogue: 0,1:25:44.32,1:25:45.52,Default,,0,0,0,,!كلّا، انتظر
Dialogue: 0,1:25:45.61,1:25:47.30,Default,,0,0,0,,.عرفتُ كل شيء
Dialogue: 0,1:25:47.44,1:25:54.41,Default,,0,0,0,,.الشخص الذي رأيتُ قبل عشرة أشهر, وهوية المجرم الذي هاجمني أنا و (ساميتاني)
Dialogue: 0,1:25:54.46,1:26:00.86,Default,,0,0,0,,.ومن ثم أخبرت الأشخاص الذين أنقذوني أولاً بكل شيء
Dialogue: 0,1:26:01.04,1:26:02.04,Default,,0,0,0,,وبعد ذلك‫..
Dialogue: 0,1:26:02.44,1:26:08.52,Default,,0,0,0,,إن أعلنّا أن المفتش ياماتو ما يزال حياً\N.فسيعرض نفسه ومن حوله للخطر
Dialogue: 0,1:26:09.22,1:26:12.85,Default,,0,0,0,,ولهذا تظاهرنا بأنه مات؛ حتى نكون قادرين\N.على أن نعتقل المفتش هاياشي
Dialogue: 0,1:26:13.51,1:26:16.58,Default,,0,0,0,,.ثم طلبنا من الأمن العام المساعدة
Dialogue: 0,1:26:16.67,1:26:20.46,Default,,0,0,0,,!طلبنا عميلاً موثوقاً على عكسك أنت
Dialogue: 0,1:26:21.70,1:26:23.59,Default,,0,0,0,,قبل عشرة أشهر‫..
Dialogue: 0,1:26:23.67,1:26:28.04,Default,,0,0,0,,المفتش ياماتو رأك أنت أيها المفتش (هاياشي)، أليس كذلك؟
Dialogue: 0,1:26:28.30,1:26:33.31,Default,,0,0,0,,.في ذلك الوقت، كان لديك جهاز استقبال عملاق فوق سيارتك
Dialogue: 0,1:26:33.36,1:26:35.49,Default,,0,0,0,,مركبة الرادار المتنقلة؟
Dialogue: 0,1:26:35.53,1:26:38.92,Default,,0,0,0,,.كذلك حاولت سرقتها مجدداً قبل عدة أيام
Dialogue: 0,1:26:39.01,1:26:41.72,Default,,0,0,0,,!لفعل نفس الشيء
Dialogue: 0,1:26:41.86,1:26:46.03,Default,,0,0,0,,ماذا كنت تفعل  قبل عشرة\Nأشهر في جبل "ميتاكاراداكي"؟
Dialogue: 0,1:26:46.30,1:26:49.70,Default,,0,0,0,,في الغالب كان عملاً إجرامياً
Dialogue: 0,1:26:50.02,1:26:51.97,Default,,0,0,0,,أجب يا هاياشي‫!
Dialogue: 0,1:26:52.27,1:26:55.10,Default,,0,0,0,,كنت تتلقى رسائل عبر الأقمار الصناعية
Dialogue: 0,1:26:55.15,1:26:59.24,Default,,0,0,0,,ولم تجمع معلومات يابانية فقط‫..
Dialogue: 0,1:26:59.34,1:27:04.46,Default,,0,0,0,,كذلك جمعت معلومات عسكرية عن\N.حليفنا الولايات المتحدة الأمريكية
Dialogue: 0,1:27:04.84,1:27:11.21,Default,,0,0,0,,وأنت من هددت الحكومة اليابانية بمشاركة\N!هذه المعلومات حول العالم
Dialogue: 0,1:27:11.38,1:27:14.90,Default,,0,0,0,,إذن يا هاسيبي-سان، أنت كنت تبحث\Nعن  المجرم طوال الوقت؟
Dialogue: 0,1:27:15.10,1:27:18.19,Default,,0,0,0,,!ظننت أنك المدعي العام لقضية سامنتاني-سان
Dialogue: 0,1:27:18.31,1:27:24.53,Default,,0,0,0,,أعتذر عن التأخر بتعريفكم بنفسي، أنا هاسيبي\N.من مركز استخبارات الأقمار الصناعية
Dialogue: 0,1:27:25.18,1:27:30.16,Default,,0,0,0,,لقد لويت يد المشرف العام كورودا وكذبت\N.بكوني مدعياً عاماً لأشارك بالتحقيق
Dialogue: 0,1:27:31.00,1:27:36.76,Default,,0,0,0,, فهمت، التهديد الذي أتى الحكومة اليابانية أجبر\N.الاستخبارات والأمن العام على العمل معاً
Dialogue: 0,1:27:37.06,1:27:38.44,Default,,0,0,0,,استخبارات؟
Dialogue: 0,1:27:38.47,1:27:40.91,Default,,0,0,0,,.مكتب الاستخبارات والبحوث
Dialogue: 0,1:27:40.93,1:27:44.75,Default,,0,0,0,,هذا المركز يشرف عليه رئيس\Nالوزراء مباشرة، صحيح؟
Dialogue: 0,1:27:44.86,1:27:46.15,Default,,0,0,0,,.بالضبط
Dialogue: 0,1:27:46.18,1:27:53.99,Default,,0,0,0,,حددنا تاريخ وموعد ومكان المعلومات التي\N.تلقيناها قبل عشرة أشهر من جبل ميتاكاراداكي
Dialogue: 0,1:27:54.10,1:27:57.28,Default,,0,0,0,,.المفتش ساميتاني كان يحقق في هذا الملف
Dialogue: 0,1:27:57.39,1:27:59.84,Default,,0,0,0,,.صحيح، كان مكلفاً بذلك من الأمن العام
Dialogue: 0,1:27:59.92,1:28:04.22,Default,,0,0,0,,وأنت كنت عميلاً متخفيًا للأمن العام كذلك\Nولاحظت هذا، أليس كذلك؟
Dialogue: 0,1:28:06.82,1:28:11.78,Default,,0,0,0,,عرفت أن المفتش ساميتاني\N.التقى مع ميكوريا في السجن
Dialogue: 0,1:28:14.08,1:28:19.78,Default,,0,0,0,,لأني كنت زميله بوصفي عميلًا سريًا في الأمن العام\N.فلم يكتم عني شيئاً وقال لي كل شيء
Dialogue: 0,1:28:19.92,1:28:29.29,Default,,0,0,0,,أراد مني أن ألتقي بالمفتش ياماتو، وأخبرته\N.أني مهتم به، وبأنه فقد ذاكرته
Dialogue: 0,1:28:30.25,1:28:35.27,Default,,0,0,0,,لهذا السبب لم يتعب نفسه\N.بمقابلة المشرف ياماتو وعاد إلى طوكيو
Dialogue: 0,1:28:35.35,1:28:37.38,Default,,0,0,0,,لكنك أطلقت النار على واني
Dialogue: 0,1:28:37.51,1:28:40.77,Default,,0,0,0,,كان يحقق بالقضية و‫اضطُررت إلى إسكاته‫!
Dialogue: 0,1:28:40.87,1:28:47.21,Default,,0,0,0,,لهذا تواصلت معي أنا من أوكل التحقيق إليك\N.وتعاونت معنا في التحقيقات
Dialogue: 0,1:28:47.31,1:28:53.54,Default,,0,0,0,,.وذهبت معنا إلى السجن لمراقبة تحقيقاتنا
Dialogue: 0,1:28:53.63,1:28:55.78,Default,,0,0,0,,.أنا سعيد بأني ذهبت معكم
Dialogue: 0,1:28:55.81,1:28:59.82,Default,,0,0,0,,.بدوت كأنك تذكرت شيئاً ما عن القضية
Dialogue: 0,1:28:59.89,1:29:07.20,Default,,0,0,0,,..عندها حاولت قتل المفتش ياماتو بسلاحك\N!وعندما فشلت، أحدثت انهياراً جليدياً لقتله
Dialogue: 0,1:29:23.35,1:29:25.16,Default,,0,0,0,,لماذا بالغت إلى هذا الحد؟
Dialogue: 0,1:29:25.38,1:29:27.31,Default,,0,0,0,,هذا لأنك حتماً‫..
Dialogue: 0,1:29:27.55,1:29:31.83,Default,,0,0,0,,حبيب ماكي-سان التي انتحرت
Dialogue: 0,1:29:31.92,1:29:32.94,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:29:33.07,1:29:37.25,Default,,0,0,0,,!هذا ما قاله أخي شينتشي في الإيميل
Dialogue: 0,1:29:37.87,1:29:41.87,Default,,0,0,0,,.انتحار ماكي كان خطأ ميكوريا وواشيزو
Dialogue: 0,1:29:41.98,1:29:47.27,Default,,0,0,0,,لكن بطريقة ما، استطاع واشيزو\N.أن يكسب صفقة إقرار بالذنب
Dialogue: 0,1:29:47.38,1:29:50.49,Default,,0,0,0,,وماذا في ذلك؟.. أنت شرطي‫!
Dialogue: 0,1:29:50.55,1:29:54.30,Default,,0,0,0,,.نعم أنا شرطي؛ ولهذا صبرت على ذلك
Dialogue: 0,1:29:54.38,1:29:56.81,Default,,0,0,0,,.لكن واشيزو اختفى
Dialogue: 0,1:29:56.95,1:30:00.13,Default,,0,0,0,,!الجبان غير اسمه ووجهه
Dialogue: 0,1:30:00.67,1:30:03.16,Default,,0,0,0,,..لقد صبرت.. وصبرت
Dialogue: 0,1:30:03.70,1:30:09.76,Default,,0,0,0,,لكن قرارات صفقات الإقرار بالذنب الجديدة\N!ستطلق صراح المزيد من المجرمين مثل واشيزو
Dialogue: 0,1:30:10.29,1:30:15.02,Default,,0,0,0,,والضحايا مثل ماكي‫!
Dialogue: 0,1:30:19.69,1:30:23.34,Default,,0,0,0,,لقد اكتفيت من ذلك! لا أستطيع التحمل أكثر‫!
Dialogue: 0,1:30:23.50,1:30:25.37,Default,,0,0,0,,يجب على المجرمين دفع ثمن جرائمهم‫!
Dialogue: 0,1:30:25.40,1:30:28.58,Default,,0,0,0,,أن تحصل على حكم أخف لأنك وشيت بآخرين؟
Dialogue: 0,1:30:28.61,1:30:32.64,Default,,0,0,0,,لن أسمح بذلك! هذا النظام يجب أن يلغى‫!
Dialogue: 0,1:30:32.80,1:30:35.21,Default,,0,0,0,,!ما زلت أملك معلومات الأقمار الصناعية
Dialogue: 0,1:30:35.25,1:30:38.06,Default,,0,0,0,,!ما زلت أستطيع تهديد الحكومة
Dialogue: 0,1:30:46.50,1:30:47.51,Default,,0,0,0,,!توقف مكانك
Dialogue: 0,1:30:54.54,1:30:55.75,Default,,0,0,0,,توقف‫!
Dialogue: 0,1:31:02.43,1:31:04.97,Default,,0,0,0,,إنه يتوجه إلى مركبة الرادار‫.
Dialogue: 0,1:31:09.72,1:31:12.04,Default,,0,0,0,,تبًا، مركبة الرادار‫ المتنقلة!
Dialogue: 0,1:31:27.12,1:31:28.25,Default,,0,0,0,,!هذا خطر
Dialogue: 0,1:31:28.57,1:31:30.38,Default,,0,0,0,,!جميعكم تراجعوا
Dialogue: 0,1:31:35.79,1:31:37.90,Default,,0,0,0,,!اخرج ويداك مرفوعتان
Dialogue: 0,1:31:40.80,1:31:42.82,Default,,0,0,0,,!توقفي يا أويهارا
Dialogue: 0,1:31:59.62,1:32:01.83,Default,,0,0,0,,‫أبي
Dialogue: 0,1:32:02.46,1:32:05.25,Default,,0,0,0,,‫ران اركبي السيارة مع المفتشين
Dialogue: 0,1:32:05.38,1:32:06.75,Default,,0,0,0,,‫ولكن
Dialogue: 0,1:32:06.88,1:32:09.13,Default,,0,0,0,,‫سآتي لأخذكِ بمجرد انتهاء هذا الأمر
Dialogue: 0,1:32:11.63,1:32:14.72,Default,,0,0,0,,‫هل يمكننا تغيير اتجاه جهاز الليزر؟
Dialogue: 0,1:32:15.05,1:32:16.72,Default,,0,0,0,,‫نعم نستطيع
Dialogue: 0,1:32:16.85,1:32:19.31,Default,,0,0,0,,‫سنستخدمه لحجب طريقه
Dialogue: 0,1:32:19.43,1:32:20.37,Default,,0,0,0,,‫اسرع
Dialogue: 0,1:32:23.30,1:32:24.46,Default,,0,0,0,,‫سيد موري؟
Dialogue: 0,1:32:25.02,1:32:28.65,Default,,0,0,0,,‫قدها خذني إلى حيث هو
Dialogue: 0,1:32:28.94,1:32:31.86,Default,,0,0,0,,‫كان ذلك صوتًا عاليًا للغاية
Dialogue: 0,1:32:31.99,1:32:33.41,Default,,0,0,0,,‫ماذا يمكن أن يكن ذلك؟
Dialogue: 0,1:32:33.53,1:32:35.20,Default,,0,0,0,,‫أوتشي
Dialogue: 0,1:32:35.33,1:32:43.33,Default,,0,0,0,,‫الحمد لله… لقد طلب مني كونان أن أنقل الليزر\N‫هل يمكنك مساعدتي؟
Dialogue: 0,1:32:43.46,1:32:45.75,Default,,0,0,0,,‫لكنني لا
Dialogue: 0,1:32:47.42,1:32:48.40,Default,,0,0,0,,‫سأفعلها
Dialogue: 0,1:33:05.27,1:33:06.52,Default,,0,0,0,,‫لا تطلقي
Dialogue: 0,1:33:06.65,1:33:07.90,Default,,0,0,0,,‫إنهم في الداخل
Dialogue: 0,1:33:13.24,1:33:14.49,Default,,0,0,0,,‫سحقاً
Dialogue: 0,1:34:02.16,1:34:04.21,Default,,0,0,0,,‫هايبارا هل تسمعينني هايبارا ؟
Dialogue: 0,1:34:05.12,1:34:06.96,Default,,0,0,0,,‫إيدغاوا كن هل أنت بخير ؟
Dialogue: 0,1:34:07.08,1:34:07.96,Default,,0,0,0,,‫نعم أنا بخير
Dialogue: 0,1:34:08.38,1:34:10.84,Default,,0,0,0,,‫أريدك أن توجه الليزر إلى الزجاج الأمامي لسيارة الجاني
Dialogue: 0,1:34:10.96,1:34:12.30,Default,,0,0,0,,‫اعتمد عليكِ هايبارا
Dialogue: 0,1:34:12.96,1:34:15.47,Default,,0,0,0,,‫سحقاً لا مفرّ من ذلك
Dialogue: 0,1:34:15.88,1:34:18.43,Default,,0,0,0,,‫ما الذي يفعله كونان ؟
Dialogue: 0,1:34:18.55,1:34:20.72,Default,,0,0,0,,‫دعوا آي كن تركز
Dialogue: 0,1:34:32.40,1:34:33.74,Default,,0,0,0,,‫انطلقي
Dialogue: 0,1:34:43.93,1:34:45.10,Default,,0,0,0,,‫ما ذاك ؟
Dialogue: 0,1:34:52.30,1:34:54.05,Default,,0,0,0,,‫على هذا الوضع لن يصيب الهدف
Dialogue: 0,1:34:54.15,1:34:55.51,Default,,0,0,0,,‫هل يمكنك خفضه أكثر؟
Dialogue: 0,1:34:55.63,1:34:57.88,Default,,0,0,0,,‫هذا أقصى ما يمكن أن يصل إليه الأمر
Dialogue: 0,1:34:58.01,1:35:00.76,Default,,0,0,0,,‫هذا الجهاز مخصص للتوجيه نحو السماء
Dialogue: 0,1:35:16.40,1:35:18.61,Default,,0,0,0,,‫يعرف السماء ويعرف الأرض
Dialogue: 0,1:35:16.40,1:35:18.61,Default,,0,0,0,,‫حكمة صينية قصيرة المعنى منها: شخص واسع المعرفة، يفهم في كل الجوانب، ولا يغُفل شيء
Dialogue: 0,1:35:18.74,1:35:21.41,Default,,0,0,0,,‫انتصاره لا ينفد، ولا يعرف الفتور
Dialogue: 0,1:35:18.74,1:35:21.41,Default,,0,0,0,,‫حكمة صينية آخرى ومعناها :\N‫إذا كان الأسلوب صحيحًا، والعقل ثابتًا، والخطة محكمة فإن النصر يصبح بلا نهاية
Dialogue: 0,1:35:22.20,1:35:28.29,Default,,0,0,0,,‫إذا فهمت الجغرافيا والطقس فستحقق النصر الكامل كلمات الجنرال الصيني سون تزو؟
Dialogue: 0,1:35:30.00,1:35:31.42,Default,,0,0,0,,‫كونان كن
Dialogue: 0,1:35:31.51,1:35:32.77,Default,,0,0,0,,‫أوي هذا خطر
Dialogue: 0,1:35:32.77,1:35:33.67,Default,,0,0,0,,‫كونان كن
Dialogue: 0,1:35:33.92,1:35:36.34,Default,,0,0,0,,‫استفد من الجغرافيا والطقس
Dialogue: 0,1:35:38.47,1:35:41.05,Default,,0,0,0,,‫الجغرافيا والطقس؟
Dialogue: 0,1:35:42.43,1:35:43.68,Default,,0,0,0,,‫هايبارا
Dialogue: 0,1:35:43.81,1:35:46.27,Default,,0,0,0,,‫اضرب أكبر قطع مكافئ بالليزر
Dialogue: 0,1:35:46.39,1:35:47.98,Default,,0,0,0,,‫ذلك مستحيل
Dialogue: 0,1:35:48.10,1:35:51.69,Default,,0,0,0,,‫دعونا نحاول خفض القطع المكافئ للتلسكوب إلى أدنى مستوى ممكن
Dialogue: 0,1:35:52.06,1:35:53.44,Default,,0,0,0,,‫هايبارا سان
Dialogue: 0,1:35:55.48,1:35:57.03,Default,,0,0,0,,‫سأجرب ذلك
Dialogue: 0,1:35:59.86,1:36:01.91,Default,,0,0,0,,‫أنا أعتمد عليك يا هايبرا
Dialogue: 0,1:36:08.29,1:36:09.37,Default,,0,0,0,,‫هل يمكنك التصويب على المحرك؟
Dialogue: 0,1:36:30.02,1:36:32.40,Default,,0,0,0,,‫هاياشي توقف عن هذا الآن
Dialogue: 0,1:36:33.23,1:36:34.33,Default,,0,0,0,,‫هذا لن يحدث فرقًا
Dialogue: 0,1:36:34.33,1:36:35.15,Default,,0,0,0,,‫اخرسي
Dialogue: 0,1:36:37.23,1:36:40.53,Default,,0,0,0,,‫أنتِ لا تفهمين لن تفهمي أبداً
Dialogue: 0,1:36:40.65,1:36:41.82,Default,,0,0,0,,‫أنا عزمٌ على ذلك
Dialogue: 0,1:36:43.45,1:36:50.46,Default,,0,0,0,,‫لقد فات الأوان لقد فات الأوان ماكي لقد  رحلت 
Dialogue: 0,1:36:51.71,1:36:56.17,Default,,0,0,0,,‫إذا رحل شخص ما إلى الأبد، ولم تكن لديك أي طريقة للعثور عليه
Dialogue: 0,1:36:56.46,1:36:58.34,Default,,0,0,0,,‫ماذا كنتِ لتفعلين
Dialogue: 0,1:36:59.42,1:37:01.59,Default,,0,0,0,,‫أخبريني ؟
Dialogue: 0,1:37:04.22,1:37:05.72,Default,,0,0,0,,‫أوهارا
Dialogue: 0,1:37:06.35,1:37:07.60,Default,,0,0,0,,‫أوهارا
Dialogue: 0,1:37:14.81,1:37:15.56,Default,,0,0,0,,‫هَلُمّي إليَّ
Dialogue: 0,1:37:32.16,1:37:33.29,Default,,0,0,0,,‫سحقاً
Dialogue: 0,1:37:33.90,1:37:35.61,Default,,0,0,0,,‫سيد موري
Dialogue: 0,1:37:37.29,1:37:40.71,Default,,0,0,0,,‫فقط قل أنك أطلقتها
Dialogue: 0,1:37:45.72,1:37:49.10,Default,,0,0,0,,‫يا كومي، ما الذي تفعله؟
Dialogue: 0,1:37:55.98,1:37:57.86,Default,,0,0,0,,‫إيدغاوا كن
Dialogue: 0,1:38:18.79,1:38:23.51,Default,,0,0,0,,‫هذه المرّة… حتمًا لن نسمح له بالهرب
Dialogue: 0,1:39:24.28,1:39:26.86,Default,,0,0,0,,‫حتى الحظ السعيد أدار ظهره لي
Dialogue: 0,1:39:27.28,1:39:30.87,Default,,0,0,0,,‫لا ليس ما ينقصك هو الحظ
Dialogue: 0,1:39:32.12,1:39:40.08,Default,,0,0,0,,‫ألم يُجبرُوك في أكاديمية الشرطة على حفظه عن ظهر قلب؟ ميثاقُ أخلاقيّات موظّفي الشرطة
Dialogue: 0,1:39:42.63,1:39:49.76,Default,,0,0,0,,‫أن اخدم الوطن وشعبه بعزّةٍ وغاية، ودون أن ارضخ للخوف أو انزلق نحو الكراهية
Dialogue: 0,1:39:49.88,1:39:52.89,Default,,0,0,0,,‫مع صون حقوق الإنسان واحترامها
Dialogue: 0,1:39:53.42,1:39:56.55,Default,,0,0,0,,‫وأن أُؤدّي مهامي الشرطيّة بإنصافٍ في جميع الظروف
Dialogue: 0,1:39:58.02,1:39:59.27,Default,,0,0,0,,‫أليس كذلك ؟
Dialogue: 0,1:39:59.39,1:39:59.78,Default,,0,0,0,,‫بالتأكيد
Dialogue: 0,1:40:00.85,1:40:09.78,Default,,0,0,0,,‫حتى والد ماكي لقد بذل قصارى جهده ليعفو عنه
Dialogue: 0,1:40:09.90,1:40:15.28,Default,,0,0,0,,‫أن يعفو عن أولئك الذين دفعوا ابنته إلى الانتحار… مع أنه ليس شرطيًّا أصلاً
Dialogue: 0,1:40:16.04,1:40:20.71,Default,,0,0,0,,‫ما كان ينقصك هو الشجاعة لتسامح وليس الحظ
Dialogue: 0,1:40:25.84,1:40:27.09,Default,,0,0,0,,‫يا إلهي
Dialogue: 0,1:40:27.25,1:40:29.47,Default,,0,0,0,,‫قلتُ لك إنّ هذه ليست لعبة
Dialogue: 0,1:40:29.59,1:40:31.55,Default,,0,0,0,,‫دع هذا الأمر للكبار
Dialogue: 0,1:40:31.68,1:40:33.30,Default,,0,0,0,,‫اعتذر عن ذلك
Dialogue: 0,1:40:38.10,1:40:43.85,Default,,0,0,0,,‫ يا عماه أنت من أوقف الانهيار الجليدي، أليس كذلك؟
Dialogue: 0,1:40:45.86,1:40:48.48,Default,,0,0,0,,‫يا أحمق… مستحيل، أيّ كلام هذا؟
Dialogue: 0,1:40:58.29,1:41:02.42,Default,,0,0,0,,‫هل كنت تشاهد هذا، واني؟
Dialogue: 0,1:44:51.39,1:44:59.30,Default,,0,0,0,,‫لقد تسبّبتَ في حادثةٍ كبرى كهذه، بل وقتلتَ أحد رجال الشرطة… وعليه، فالحكم بالإعدام ليس مستبعدًا
Dialogue: 0,1:45:00.19,1:45:02.07,Default,,0,0,0,,‫من تكن ؟
Dialogue: 0,1:45:02.19,1:45:04.52,Default,,0,0,0,,‫أنا هنا لأقدّم لك صفقة لتخفيف العقوبة لك
Dialogue: 0,1:45:04.66,1:45:13.50,Default,,0,0,0,,‫إن لم تذكر قسم الأمن العام أثناء المحاكمة، فسأوجّه جهة الادّعاء للمطالبة بالسجن المؤبّد بدلًا من الإعدام
Dialogue: 0,1:45:13.62,1:45:15.83,Default,,0,0,0,,‫إذن أنت أيضًا من الأمن العام
Dialogue: 0,1:45:15.96,1:45:16.55,Default,,0,0,0,,‫أرفض
Dialogue: 0,1:45:17.59,1:45:21.76,Default,,0,0,0,,‫سأكشف عن جميع آثام هذه البلاد أثناء المحاكمة
Dialogue: 0,1:45:21.88,1:45:28.43,Default,,0,0,0,,‫القيام بذلك سيؤدي إلى الكشف عن أنك صديق ماكي فوناكوبو
Dialogue: 0,1:45:28.56,1:45:34.14,Default,,0,0,0,,‫تخيل ماذا سيقول الناس عنها وعن عائلتها
Dialogue: 0,1:45:34.27,1:45:35.15,Default,,0,0,0,,‫كيف تجرؤ
Dialogue: 0,1:45:35.27,1:45:37.90,Default,,0,0,0,,‫حسناً، اتخذ قرارك
Dialogue: 0,1:45:38.02,1:45:41.03,Default,,0,0,0,,‫هذا مقرف للغاية أهكذا تسيرون الأمور؟
Dialogue: 0,1:45:41.15,1:45:46.03,Default,,0,0,0,,‫نعم هكذا تسير الأمور في جهاز الأم العام الذي كنت تنتمي إليه
Dialogue: 0,1:45:46.41,1:45:48.74,Default,,0,0,0,,‫ألم تكن تعرف ذلك ؟
Dialogue: 0,1:46:06.18,1:46:12.81,Default,,0,0,0,,‫أمّا بخصوص إطلاق كوغورو موري للسلاح… فقد حرصتُ على ألّا يشكّل ذلك أيّ مشكلة
Dialogue: 0,1:46:13.27,1:46:21.82,Default,,0,0,0,,‫وأيضًا… بخصوص المفتّش موروفوشي… فعندما جرى إنقاذه من عند الشلّال، همس باسم هيروميتسو
Dialogue: 0,1:46:23.57,1:46:24.95,Default,,0,0,0,,‫هيرو ميتسو
Dialogue: 0,1:46:25.48,1:46:32.57,Default,,0,0,0,,‫إن لم تخنّي الذاكرة… فقد التحقتَ بالأكاديمية مع رجلٍ يُدعى هيروميتسو موروفوشي، أليس كذلك؟
Dialogue: 0,1:46:35.08,1:46:43.42,Default,,0,0,0,,‫وبعد توقّفٍ طويل، استؤنفَت المداولات حول النسخة المُعدَّلة من قانون الإجراءات الجزائية، والتي تتضمّن نظامًا جديدًا لعقد الصفقات القضائية (الصفقة مع المتّهم) وسيُرافِق ذلكــ
Dialogue: 0,1:46:44.47,1:46:46.88,Default,,0,0,0,,‫أوه لقد عثرت على جهاز التحكم
Dialogue: 0,1:46:47.01,1:46:49.97,Default,,0,0,0,,‫نعم ولكن لم يكن أنا الذي عثر عليه
Dialogue: 0,1:46:50.10,1:46:52.06,Default,,0,0,0,,‫أين العم
Dialogue: 0,1:46:52.18,1:46:53.43,Default,,0,0,0,,‫توتوري
Dialogue: 0,1:46:53.56,1:46:54.68,Default,,0,0,0,,‫توتوري؟
Dialogue: 0,1:46:54.85,1:46:58.44,Default,,0,0,0,,‫قال إنه سيقوم أخيرًا بدفن رماد واني
Dialogue: 0,1:46:58.56,1:47:01.57,Default,,0,0,0,,‫إذن مسقط رأس المفتش ساميتاني هو
Dialogue: 0,1:47:01.69,1:47:03.57,Default,,0,0,0,,‫يبدو ذلك
Dialogue: 0,1:47:08.82,1:47:15.00,Default,,0,0,0,,‫حقًا… لقد تهوّرتَ كثيرًا  لم أتخيّل… في ذلك الوقت خرجتَ من المستشفى قسرًا وأتيت إلينا
Dialogue: 0,1:47:15.12,1:47:17.21,Default,,0,0,0,,‫نحن لسنا مختلفين كثيرًا
Dialogue: 0,1:47:17.71,1:47:23.55,Default,,0,0,0,,‫كومي، ألم تعرف أنني زيفت موتي؟
Dialogue: 0,1:47:23.66,1:47:25.29,Default,,0,0,0,,‫نعم… لا شيء البتّة.
Dialogue: 0,1:47:25.42,1:47:28.51,Default,,0,0,0,,‫إذن كان عليك على الأقل أن تذرف دمعة من أجلي
Dialogue: 0,1:47:28.63,1:47:33.81,Default,,0,0,0,,‫لا، كنت في حالة صدمة، لأنني لم أكن أعرف أن أشخاصاً مثلك يمكن أن يموتوا
Dialogue: 0,1:47:33.93,1:47:37.48,Default,,0,0,0,,‫كونان-كن أخبرني بذلك، لذا كنت أعلم، لكن
Dialogue: 0,1:47:37.81,1:47:38.94,Default,,0,0,0,,‫هذا صحيح
Dialogue: 0,1:47:39.06,1:47:43.98,Default,,0,0,0,,‫ذلك الفتى لم يكلف نفسه عناء إخبار كومي، فلماذا أخبرك أنت؟
Dialogue: 0,1:47:44.11,1:47:51.41,Default,,0,0,0,,‫أعتقد أن السبب هو أن الفتى لم يكن يريد أن يحزنك
Dialogue: 0,1:47:52.28,1:47:54.70,Default,,0,0,0,,‫إنه ليس مثلنا نحن الشرطة
Dialogue: 0,1:47:55.20,1:47:59.96,Default,,0,0,0,,‫علّها طريقته الخاصة… طريقةٌ تختلف حتى عن أساليب الأمن العام
Dialogue: 0,1:48:00.08,1:48:01.83,Default,,0,0,0,,‫لا أفهم ذلك
Dialogue: 0,1:48:02.21,1:48:06.96,Default,,0,0,0,,‫انتظر، أوهارا إذا كنت تعلمين، فهذا كان مبالغًا فيه
Dialogue: 0,1:48:07.30,1:48:08.72,Default,,0,0,0,,‫كان تشان
Dialogue: 0,1:48:08.88,1:48:11.22,Default,,0,0,0,,‫كان تشــــــــان
Dialogue: 0,1:48:15.68,1:48:23.98,Default,,0,0,0,,‫أوي أوي تبكي كثيرًا لن يصدقوك سوف يكتشفون الأمر كان ذلك رد فعل مبالغ فيه
Dialogue: 0,1:48:24.11,1:48:26.98,Default,,0,0,0,,‫لم يكن مبالغاً فيه أبداً
Dialogue: 0,1:48:27.19,1:48:32.72,Default,,0,0,0,,‫أنا مجرد زميل لكِ في العمل لا أحد يبكي كثيرًا على هذا النوع من الموت، أيتها الحمقاء
Dialogue: 0,1:48:32.74,1:48:36.49,Default,,0,0,0,,‫ماذا لو لم نكن مجرد زملاء عمل؟
Dialogue: 0,1:48:39.62,1:48:40.50,Default,,0,0,0,,‫هاه ؟
Dialogue: 0,1:49:07.86,1:49:10.24,Default,,0,0,0,,‫إنها حاكمة الرياح
Dialogue: 0,1:49:10.36,1:49:13.61,Default,,0,0,0,,‫إنها ليست حاكمة بل قرصانة
Dialogue: 0,1:49:14.11,1:49:15.78,Default,,0,0,0,,‫اخرس، أنت
Dialogue: 0,1:41:05.16,1:41:07.43,Default,,0,0,0,,‫لا تذهب، لا تذهب، لا تبتعد
Dialogue: 0,1:41:07.43,1:41:09.44,Default,,0,0,0,,‫(أوه-أوه)
Dialogue: 0,1:41:09.44,1:41:11.59,Default,,0,0,0,,‫أحتاج، أحتاج، أحتاجك أكثر
Dialogue: 0,1:41:11.59,1:41:13.58,Default,,0,0,0,,‫(أوه-أحتاجك أكثر)
Dialogue: 0,1:41:13.58,1:41:15.55,Default,,0,0,0,,‫لا تبكي، لا تبكي، لا تبكي
Dialogue: 0,1:41:15.55,1:41:17.76,Default,,0,0,0,,‫(أوه-لا تبكي)
Dialogue: 0,1:41:17.76,1:41:19.80,Default,,0,0,0,,‫الليل طويل لا يجد النهار أبداً، لا يجد النهار أبداً
Dialogue: 0,1:41:19.80,1:41:21.29,Default,,0,0,0,,‫كيف سريع الزوال هو مرور الفصول الأربعة
Dialogue: 0,1:41:21.29,1:41:22.47,Default,,0,0,0,,‫شفق!!!
Dialogue: 0,1:41:25.08,1:41:27.88,Default,,0,0,0,,‫أضيئوا الأنوار!!! (أوه-أوه)
Dialogue: 0,1:41:27.88,1:41:30.25,Default,,0,0,0,,‫أنا أتوسل، أتوسل إليك (!!!الشفق)
Dialogue: 0,1:41:33.39,1:41:36.64,Default,,0,0,0,,‫أضيئوا الأنوار!!! (أوه-أوه)
Dialogue: 0,1:41:36.64,1:41:39.30,Default,,0,0,0,,‫الفصول الأربعة الزائلة (!!!الشفق)
Dialogue: 0,1:41:39.30,1:41:43.31,Default,,0,0,0,,‫صل النقاط واربط سماء الليل
Dialogue: 0,1:41:43.31,1:41:47.20,Default,,0,0,0,,‫كي تصبح الهوية الحقيقية الزائلة مرئية
Dialogue: 0,1:41:47.20,1:41:49.53,Default,,0,0,0,,‫إنه صغير جداً، بغض النظر عن من تكون
Dialogue: 0,1:41:49.53,1:41:51.59,Default,,0,0,0,,‫إنه غطاء بريء
Dialogue: 0,1:41:51.59,1:41:53.13,Default,,0,0,0,,‫"ماذا تريد أن تفعل؟"
Dialogue: 0,1:41:53.13,1:41:54.96,Default,,0,0,0,,‫الوجهة تعود إليك
Dialogue: 0,1:41:54.96,1:41:55.80,Default,,0,0,0,,‫(!!!الشفق)
Dialogue: 0,1:41:55.80,1:41:59.10,Default,,0,0,0,,‫هذا ليس صادقاً، الدموع جفّت، عين جافة
Dialogue: 0,1:41:59.10,1:41:59.98,Default,,0,0,0,,‫(!!!الشفق)
Dialogue: 0,1:41:59.98,1:42:03.40,Default,,0,0,0,,‫إن لم تعد رغم الندم، مع السلامة
Dialogue: 0,1:42:03.40,1:42:04.33,Default,,0,0,0,,‫(!!!الشفق)
Dialogue: 0,1:42:04.33,1:42:07.69,Default,,0,0,0,,‫في القدر غير العادي للأبد
Dialogue: 0,1:42:07.69,1:42:08.30,Default,,0,0,0,,‫(!!!الشفق)
Dialogue: 0,1:42:08.30,1:42:11.80,Default,,0,0,0,,‫الماضي الذي لا يُدرك سيبقى ذكرى
Dialogue: 0,1:42:11.80,1:42:12.30,Default,,0,0,0,,‫(!!!الشفق)
Dialogue: 0,1:42:12.30,1:42:13.89,Default,,0,0,0,,‫مهلاً، لا عودة إلى الوراء
Dialogue: 0,1:42:13.89,1:42:16.16,Default,,0,0,0,,‫أنت وأنا، إنها رحلتنا الليلية!!!
Dialogue: 0,1:42:16.16,1:42:18.32,Default,,0,0,0,,‫لا توقظ، لا توقظ، لا توقظني
Dialogue: 0,1:42:18.32,1:42:20.25,Default,,0,0,0,,‫لا أحتاج أي أغانٍ حزينة
Dialogue: 0,1:42:20.25,1:42:22.80,Default,,0,0,0,,‫أحتاج، أحتاج، أحتاجك أكثر
Dialogue: 0,1:42:22.80,1:42:24.44,Default,,0,0,0,,‫(أوه-أوه)
Dialogue: 0,1:42:24.44,1:42:26.48,Default,,0,0,0,,‫لا تنهي، لا تنهي، لا تنهي الأمر
Dialogue: 0,1:42:26.48,1:42:28.38,Default,,0,0,0,,‫مهما كان نوع القدر
Dialogue: 0,1:42:28.38,1:42:30.57,Default,,0,0,0,,‫الليل طويل لا يجد النهار أبداً، لا يجد النهار أبداً
Dialogue: 0,1:42:30.57,1:42:33.80,Default,,0,0,0,,‫الفصولُ الزائلة… تتناثر كضوءٍ يذوب في الشفق
Dialogue: 0,1:42:33.80,1:42:37.04,Default,,0,0,0,,‫!!!الشفق!!!-الشفق!!!-الشفق
Dialogue: 0,1:42:37.04,1:42:38.08,Default,,0,0,0,,‫!!!أضيئوا الأنوار
Dialogue: 0,1:42:38.08,1:42:40.20,Default,,0,0,0,,‫(!!!أوه-أوه-أضيئوا الأنوار)
Dialogue: 0,1:42:40.20,1:42:42.20,Default,,0,0,0,,‫أنا أتوسل، أتوسل إليك (الشفق!!!)
Dialogue: 0,1:42:42.20,1:42:45.30,Default,,0,0,0,,‫الشفق!!!-الشفق!!!-الشفق!!!
Dialogue: 0,1:42:45.30,1:42:46.37,Default,,0,0,0,,‫أضيئوا الأنوار!!!
Dialogue: 0,1:42:46.37,1:42:48.48,Default,,0,0,0,,‫(أوه-أوه-أضيئوا الأنوار!!!)
Dialogue: 0,1:42:48.48,1:42:51.15,Default,,0,0,0,,‫الفصول الأربعة الزائلة (الشفق!!!)
Dialogue: 0,1:42:53.31,1:42:55.34,Default,,0,0,0,,‫أرجوك، أريد رؤيتك
Dialogue: 0,1:42:55.34,1:42:57.40,Default,,0,0,0,,‫أحتاجك أكثر
Dialogue: 0,1:42:57.40,1:42:59.36,Default,,0,0,0,,‫أي نوع من الكلمات
Dialogue: 0,1:42:59.36,1:43:01.71,Default,,0,0,0,,‫سوف تصل إليك؟
Dialogue: 0,1:43:01.71,1:43:03.80,Default,,0,0,0,,‫أرجوك، لا تبكي
Dialogue: 0,1:43:03.80,1:43:05.60,Default,,0,0,0,,‫مهما كان نوع القدر
Dialogue: 0,1:43:05.60,1:43:07.80,Default,,0,0,0,,‫الليل طويل لا يجد النهار أبداً
Dialogue: 0,1:43:07.80,1:43:10.19,Default,,0,0,0,,‫سيكون هناك دائماً، شفق!!!
Dialogue: 0,1:43:10.19,1:43:12.13,Default,,0,0,0,,‫استمع جيداً
Dialogue: 0,1:43:12.13,1:43:14.09,Default,,0,0,0,,‫الحياة قصيرة جداً
Dialogue: 0,1:43:14.09,1:43:16.15,Default,,0,0,0,,‫ضوء قرمزي لشمس الصباح المشرقة
Dialogue: 0,1:43:16.15,1:43:18.19,Default,,0,0,0,,‫إنه حلم لا ينتهي
Dialogue: 0,1:43:18.19,1:43:20.29,Default,,0,0,0,,‫أرجوك، لا توقظني
Dialogue: 0,1:43:20.29,1:43:22.30,Default,,0,0,0,,‫مهما كان نوع القدر
