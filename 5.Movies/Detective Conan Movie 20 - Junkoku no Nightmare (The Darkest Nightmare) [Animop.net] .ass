Dialogue: 0,0:00:58.25,0:00:59.38,Default,,0,0,0,,!ستتوَقّفين هُنا
Dialogue: 0,0:00:59.88,0:01:02.01,Default,,0,0,0,,!إرفعي يداكِ، و لا تتحرّكي على الإطلاق
Dialogue: 0,0:01:04.95,0:01:07.21,Default,,0,0,0,,!لَم تعودي تتصرّفين بغُرورٍ بعد الآن
Dialogue: 0,0:01:32.38,0:01:33.95,Default,,0,0,0,,فورويا، هل أنتَ بخير؟
Dialogue: 0,0:01:33.98,0:01:35.00,Default,,0,0,0,,!نعم
Dialogue: 0,0:01:38.05,0:01:39.31,Default,,0,0,0,,!تلك العينان\N...لا تُخبرني
Dialogue: 0,0:01:39.35,0:01:40.48,Default,,0,0,0,,!فورويا! تنحّى
Dialogue: 0,0:01:40.81,0:01:41.71,Default,,0,0,0,,!لا تتحرّكي
Dialogue: 0,0:01:43.75,0:01:44.35,Default,,0,0,0,,!إنتظري
Dialogue: 0,0:01:54.28,0:01:55.38,Default,,0,0,0,,!إ... إنتظري
Dialogue: 0,0:01:55.75,0:01:56.45,Title,,0,0,0,,{\c&H7CBAAC&\3c&H362723&\fs60\pos(1095.204,41.431)}مركز شُرطة الأمن العام
Dialogue: 0,0:02:00.71,0:02:01.81,Default,,0,0,0,,!إنتظريييي
Dialogue: 0,0:02:01.95,0:02:03.51,Default,,0,0,0,,!هاي، هذا خطِر
Dialogue: 0,0:02:19.75,0:02:20.35,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:02:45.61,0:02:48.68,Title,,0,0,0,,{\fs55\c&H652D13&\4c&HFFFFFF&\3c&HFFFFFF&\pos(1000.805,39.364)}رسالةٌ جديدة: ستاوت، أكوافيت، ريسلينغ
Dialogue: 0,0:03:09.54,0:03:10.91,Title,,0,0,0,,{\fs55\c&HED9264&\4c&HFFFFFF&\3c&HFFFFFF&\pos(1155.436,37.933)}...جاري الإرسال
Dialogue: 0,0:03:10.95,0:03:11.46,Title,,0,0,0,,{\fs55\c&HED9264&\4c&HFFFFFF&\3c&HFFFFFF&\pos(1176.913,40.796)}تمّ الإرسال
Dialogue: 0,0:03:23.78,0:03:24.70,Default,,0,0,0,,!أوه لا
Dialogue: 0,0:03:26.55,0:03:27.31,Default,,0,0,0,,!أكاي
Dialogue: 0,0:03:37.98,0:03:40.85,Default,,0,0,0,,!تراجع أكاي، إنّها مِلك مكتب الأمن العام
Dialogue: 0,0:04:36.61,0:04:37.65,Default,,0,0,0,,!...ما هذا بحقّ الله
Dialogue: 0,0:04:54.15,0:04:55.75,Default,,0,0,0,,!تبّاً! لَن تهربي
Dialogue: 0,0:05:06.20,0:05:06.78,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:05:18.61,0:05:21.55,Default,,0,0,0,,!إن هربَت، سيغرق العالَم و سيملؤه الهلَع
Dialogue: 0,0:05:27.60,0:05:28.35,Default,,0,0,0,,!...لا تُخبروني
Dialogue: 0,0:05:29.11,0:05:30.18,Default,,0,0,0,,أصبحَت خلفي؟
Dialogue: 0,0:05:55.31,0:05:56.15,Default,,0,0,0,,!...راي
Dialogue: 0,0:05:58.01,0:06:00.75,Default,,0,0,0,,...هذا مُثيرٌ للإهتمام\N!سأقتلك
Dialogue: 0,0:07:23.00,0:07:23.80,Default,,0,0,0,,!أكاي
Dialogue: 0,0:07:24.40,0:07:25.50,Default,,0,0,0,,!أيّها الوَغد
Dialogue: 0,0:07:44.51,0:07:45.41,Default,,0,0,0,,!هذا أنا
Dialogue: 0,0:07:45.95,0:07:48.91,Default,,0,0,0,,.هرب الطّائر. سأُبقيكم على اطّلاع
Dialogue: 0,0:07:49.05,0:07:50.05,Default,,0,0,0,,!عُلِم
Dialogue: 0,0:08:38.85,0:08:40.87,Title - 1,,0,0,0,,{\blur5\fad(600,10)\frz11.53\pos(295.387,318.433)}{\pos(1100,56)\c&H44FF47&\4c&HFFFFFF&\fs90}الكابوس\N{\c&HBABABC&\3c&H000000&\4c&H44FF47&}المُظلِم
Dialogue: 0,0:08:46.18,0:08:50.10,Title,,0,0,0,,{\fad(400,10)\fs80\c&H280CBF&\3c&H28DFE6&\4c&H000000&\pos(608,62)}المُحقّق كونان
Dialogue: 0,0:08:46.18,0:08:50.10,Title - 1,,0,0,0,,{\blur5\fad(400,10)\c&H36DE65&\3c&H652D13&\4c&H0700BF&\pos(276.774,633.746)}الكابوس المُظلِم
Dialogue: 0,0:08:52.75,0:08:54.90,Default,,0,0,0,,،أنا كودو شينتشي، مُتحرٍّ في المرحلة الثّانويّة
Dialogue: 0,0:08:55.15,0:08:58.98,Default,,0,0,0,,،بينما كنتُ في مدينة ملاهٍ مع صديقة طُفولتي، ران موري
Dialogue: 0,0:08:59.21,0:09:03.20,Default,,0,0,0,,،لاحظتُ صفقةً مَشبوهةً بين بعض الرّجال المُرتدين الأسود
Dialogue: 0,0:09:05.48,0:09:07.50,Default,,0,0,0,,لانشغالي بهذا المَشهد، لَم أرى
Dialogue: 0,0:09:07.55,0:09:11.00,Default,,0,0,0,,،الرّجل الثّالث الذي كان يقترب من خلفي
Dialogue: 0,0:09:13.20,0:09:16.20,Default,,0,0,0,,،أجبرَني على أخذ سُمّ
Dialogue: 0,0:09:16.31,0:09:17.41,Default,,0,0,0,,،و عندما استيقظت
Dialogue: 0,0:09:21.55,0:09:23.80,Default,,0,0,0,,!كان جسدي قد تقلّص
Dialogue: 0,0:09:27.01,0:09:29.65,Default,,0,0,0,,،لَو عرفوا بأنّ كودو شينتشي مازال على قيد الحياة
Dialogue: 0,0:09:29.75,0:09:33.70,Default,,0,0,0,,.هذا سيضع أقاربي و معارفي في خطَر
Dialogue: 0,0:09:35.45,0:09:38.51,Default,,0,0,0,,،أخفيتُ هويّتي الحقيقيّة اتّباعاً لنصيحة البروفيسور أغاسا
Dialogue: 0,0:09:38.75,0:09:40.78,Default,,0,0,0,,،عندما سألَتني ران عن إسمي
Dialogue: 0,0:09:41.48,0:09:43.40,Default,,0,0,0,,."خطَرَ ببالي إسم "إيدوغاوا كونان
Dialogue: 0,0:09:43.48,0:09:49.01,Default,,0,0,0,,.لأعرف المزيد عن المُنظمة السّوداء، قرّرت العيش مع وَالِد ران، الذي يعمل مُتحرّياً
Dialogue: 0,0:09:50.98,0:09:56.20,Default,,0,0,0,,،هويّتي الحقيقيّة يعرفها شخصٌ آخر عدا عن البروفيسور
Dialogue: 0,0:09:56.80,0:09:59.71,Default,,0,0,0,,.هايبارا آي، إسمها الحقيقيّ هو ميانو شيهو
Dialogue: 0,0:10:00.35,0:10:03.55,Default,,0,0,0,,،كانت من أعضاء المُنظّمة السّوداء
Dialogue: 0,0:10:03.90,0:10:10.51,Default,,0,0,0,,.لكن لإنهاء حياتها، أخذَت نفس العقار مِثلي، و تقلّصَت أيضاً
Dialogue: 0,0:10:19.11,0:10:21.58,Default,,0,0,0,,...و هذه المُنظّمة الغامضة
Dialogue: 0,0:10:22.01,0:10:26.70,Default,,0,0,0,,.كلّ ما نعرفه عنها هو أنّ لأعضائها أسماءً رمزيّةً لها علاقةٌ بالمشروبات الكُحوليّة
Dialogue: 0,0:10:27.18,0:10:32.88,Default,,0,0,0,,.لتدميرها، تغلغل الكثير من العُملاء إلى داخل هذه المُنظّمة
Dialogue: 0,0:10:33.78,0:10:38.75,Default,,0,0,0,,."عميلة السي آي أي، ميزوناشي رينا، إسمها المُستعار "كير
Dialogue: 0,0:10:39.45,0:10:45.61,Default,,0,0,0,,."من مكتب الأمن العام، أمورو تورو، إسمه المُستعار "بوربون"، لَقبه "زيرو
Dialogue: 0,0:10:46.00,0:10:52.00,Default,,0,0,0,,.يسعى عُملاء الإف بي آي إلى سحق هذه المُنظّمة أيضاً
Dialogue: 0,0:10:52.00,0:10:55.96,Default,,0,0,0,,...جميس بلاك، أندري كاميل ، جودي ستارلينغ
Dialogue: 0,0:10:56.11,0:10:58.35,Default,,0,0,0,,.و أكاي شويتشي
Dialogue: 0,0:10:59.05,0:11:02.35,Default,,0,0,0,,.هو أفضل عميلٍ و أمهر قنّاصٍ في الإف بي آي
Dialogue: 0,0:11:02.55,0:11:06.40,Default,,0,0,0,,.يبدو بأنّ بينه و بين أمورو بعض الخِلافات لها علاقةٌ بماضيهما المُشترك
Dialogue: 0,0:11:07.38,0:11:09.71,Default,,0,0,0,,،تقلّص جسدي، لكن عقلي لَم يتغيّر
Dialogue: 0,0:11:09.91,0:11:11.95,Default,,0,0,0,,.أنا المُتحرّي الذي لا يُقهر
Dialogue: 0,0:11:12.55,0:11:15.85,Default,,0,0,0,,!هناك حقيقةٌ وَاحدةٌ فقط
Dialogue: 0,0:11:29.88,0:11:33.50,Default,,0,0,0,,!بروفيسور، لَم يبقى بوشار
Dialogue: 0,0:11:33.51,0:11:37.05,Default,,0,0,0,,إيه؟ هل أكلتَ كلّ شيء؟-\Nماذا عنّا؟-
Dialogue: 0,0:11:37.59,0:11:38.78,Default,,0,0,0,,!أعتذر، أعتذر
Dialogue: 0,0:11:38.90,0:11:42.18,Default,,0,0,0,,.تبدو مُنشغلاً بشيءٍ ما
Dialogue: 0,0:11:42.65,0:11:46.55,Default,,0,0,0,,.حصلَت مُلاحقةٌ لَيلة البارحة، يبدو بأنّ المُشتبه به مايزال هارباً
Dialogue: 0,0:11:46.68,0:11:48.48,Default,,0,0,0,,.لكن هناك ما يُزعجني
Dialogue: 0,0:11:46.68,0:11:49.81,up,,0,0,0,,...إكتمال تجديد حوض أسماك سوزوكي الجّديد
Dialogue: 0,0:11:49.80,0:11:53.00,Default,,0,0,0,,!يتحدّثون عن حوض الأسماك على التّلفاز
Dialogue: 0,0:11:53.01,0:11:54.85,Default,,0,0,0,,!هاه؟ دَعني أرى، كونان
Dialogue: 0,0:11:55.60,0:11:56.30,Default,,0,0,0,,!حسناً
Dialogue: 0,0:11:56.35,0:12:00.45,Default,,0,0,0,,!أنا أيضاً، أُريد أن أرى... هاي، هذا يُؤلِم
Dialogue: 0,0:12:00.45,0:12:02.78,Default,,0,0,0,,!هيّا الآن، لا يُمكننا فِعل كلّ شيءٍ بنفس الوَقت
Dialogue: 0,0:12:03.11,0:12:05.25,Default,,0,0,0,,!بفف، هذا مُزعج
Dialogue: 0,0:12:05.31,0:12:08.88,Default,,0,0,0,,!كُن صبوراً غينتا، لَقد بدأ للتّوّ
Dialogue: 0,0:12:09.45,0:12:11.75,Default,,0,0,0,,!أه، إنّه يبدأ
Dialogue: 0,0:12:09.51,0:12:16.58,up,,0,0,0,,!لَقد اقترب افتتاح حوض أسماك توتو و دُولاب فيريس الضّخم\N.سنعرض لكم المَشروع الآن
Dialogue: 0,0:12:12.48,0:12:16.84,Title,,0,0,0,,{\fad(300,000)\c&HFBC141&\3c&HFFFFFF&\fs55\pos(1036.6,680.636)}!!إفتتاح المُنتزه الجّديد بعد التّجديد
Dialogue: 0,0:12:17.21,0:12:21.35,Default,,0,0,0,,.هذا المُنتزه الذي تمّ تجديده سيُقسّم إلى ثلاثة مناطق
Dialogue: 0,0:12:21.68,0:12:28.72,Default,,0,0,0,,.في الأُولى، ستستمتعون بالمُنتزه و مطاعمه، بينما تتمتّعون بجمال مَشهد المُحيط
Dialogue: 0,0:12:29.20,0:12:37.65,Default,,0,0,0,,،الموقع يسمح لكم بالإستمتاع بالمُنتزه عامل الجّذب مع أطفالكم\N.بينما لاتزالون في بيئةٍ بحريّة
Dialogue: 0,0:12:38.08,0:12:42.95,Default,,0,0,0,,،المنطقة الثّانية ستكون لعوامل جذب البيئة البحريّة
Dialogue: 0,0:12:43.00,0:12:44.95,Default,,0,0,0,,.إضافةً إلى عُروض الحيوانات
Dialogue: 0,0:12:45.75,0:12:50.38,Default,,0,0,0,,.سيتمّ عقد هذه العُروض باستمرارٍ و بالمَجّان
Dialogue: 0,0:12:50.48,0:12:56.95,Default,,0,0,0,,.إضافةً إلى المُشاهدة، ستحصلون على امتياز التّواصل مع الحيوانات و اللّعب معها
Dialogue: 0,0:12:56.95,0:12:58.18,Default,,0,0,0,,!وَداعاً
Dialogue: 0,0:12:58.18,0:12:59.15,Default,,0,0,0,,!واه، الدّولفين
Dialogue: 0,0:12:59.16,0:13:04.15,Default,,0,0,0,,و المُفاجأة الضّخمة و المُذهلة بهذا التّجديد
Dialogue: 0,0:13:04.15,0:13:07.38,Default,,0,0,0,,،هو أضخم دُولاب فيريس في العالَم
Dialogue: 0,0:13:08.28,0:13:12.05,Default,,0,0,0,,،إرتفاعه 200 مترٍ و بأعلى التّقنيّات التّكنولوجيّة
Dialogue: 0,0:13:12.05,0:13:15.95,Default,,0,0,0,,.سيكون من المُمكن الصّعود إليه بفضل مقصوراته
Dialogue: 0,0:13:16.31,0:13:22.75,Default,,0,0,0,,،دُولاب فيريس الضّخم سيكون عامل جذبٍ بحدّ ذاته، بفضل أنواره المُبهرة
Dialogue: 0,0:13:22.75,0:13:26.45,Default,,0,0,0,,.و سيطغى بحجمه على المُنتزه بأكمله
Dialogue: 0,0:13:26.85,0:13:28.91,Default,,0,0,0,,!ياه، نتطلّع لزيارته
Dialogue: 0,0:13:29.28,0:13:31.95,Default,,0,0,0,,!أُريد أن أركب دُولاب فيريس الضّخم-\N!أنا أيضاً-
Dialogue: 0,0:13:32.01,0:13:34.58,Default,,0,0,0,,أتينا لأجل حوض الأسماك، صحيح؟
Dialogue: 0,0:13:34.68,0:13:37.05,Default,,0,0,0,,!لكن سيكون من الجيّد زيارة كامل المُنتزه
Dialogue: 0,0:13:37.35,0:13:39.88,Default,,0,0,0,,!نعم-\N!نعم، لنَذهب-
Dialogue: 0,0:13:39.88,0:13:40.67,Default,,0,0,0,,.أيّها البروفيسور
Dialogue: 0,0:13:40.67,0:13:41.21,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:41.22,0:13:42.81,Default,,0,0,0,,.شُكراً لكَ على شراء التّذاكر
Dialogue: 0,0:13:44.71,0:13:46.95,Default,,0,0,0,,!هواه، يُمكننا بالفِعل رُؤية عامل الجّذب
Dialogue: 0,0:13:47.05,0:13:49.30,Default,,0,0,0,,!بالفِعل-\N!هذا مُدهش-
Dialogue: 0,0:13:49.30,0:13:51.15,Default,,0,0,0,,!بقيَت خمس دقائق، إهدأوا
Dialogue: 0,0:14:20.15,0:14:21.91,Default,,0,0,0,,!لَقد وَصلنا أخيراً
Dialogue: 0,0:14:23.85,0:14:26.28,Default,,0,0,0,,!لنَذهب-\N!رائع-
Dialogue: 0,0:14:26.28,0:14:30.88,Default,,0,0,0,,!إنتظرني، غينتا-\N!بسرعة-\N!هايبارا-
Dialogue: 0,0:14:30.90,0:14:33.08,Default,,0,0,0,,!أنتَ أيضاً كونان، علينا شراء التّذاكر
Dialogue: 0,0:14:33.65,0:14:37.35,Default,,0,0,0,,إن أردتّم التّذاكر للصّعود على متن دُولاب فيريس، سيكون\N.عليكم الإجابة على سؤالٍ صغير
Dialogue: 0,0:14:37.51,0:14:41.48,Default,,0,0,0,,هيه؟-\Nعن ماذا تتحدّث؟-\N!قلتَ بأنّكَ ستشتريها-
Dialogue: 0,0:14:42.35,0:14:43.78,Default,,0,0,0,,!لنَفعل هذا إذاً
Dialogue: 0,0:14:43.85,0:14:47.35,Default,,0,0,0,,!سأشتري التّذاكر إن حللتُم الأُحجية
Dialogue: 0,0:14:48.35,0:14:49.70,Default,,0,0,0,,:دعونا نَبدأ
Dialogue: 0,0:14:50.10,0:14:57.00,Default,,0,0,0,,من بين كلّ هذه الألوان، من منها يختلف عندما يُخلَط بقوّة؟
Dialogue: 0,0:14:57.30,0:15:03.30,Default,,0,0,0,,.وَاحد: أحمر، إثنان: أزرق، ثلاثة: بُنّي، أربعة: أسود
Dialogue: 0,0:15:03.98,0:15:05.61,Default,,0,0,0,,...هذا مُعقّدٌ جدّاً
Dialogue: 0,0:15:05.71,0:15:07.91,Default,,0,0,0,,كيف يُفترض بنا أن نُخمّن أيّ لون؟
Dialogue: 0,0:15:07.98,0:15:10.81,Default,,0,0,0,,!أه، لا أفهم أيّ شيء
Dialogue: 0,0:15:11.00,0:15:11.98,Default,,0,0,0,,!أيّها البروفيسور
Dialogue: 0,0:15:12.58,0:15:13.91,Default,,0,0,0,,!لا تتصرّف بهذا الشّكل الصّبيانيّ
Dialogue: 0,0:15:14.05,0:15:18.31,Default,,0,0,0,,....هذا سهلٌ في الوَاقع، إن ركّزنا الألوان
Dialogue: 0,0:15:18.78,0:15:20.20,Default,,0,0,0,,!بتركيزها
Dialogue: 0,0:15:18.68,0:15:21.00,up,,0,0,0,,!هاي! لَم أكن أتحدّث إليك
Dialogue: 0,0:15:21.68,0:15:24.61,Default,,0,0,0,,،)على سبيل المِثال، أكا (أحمر)، تُصبح ماتشا (القُرمزيّ
Dialogue: 0,0:15:24.61,0:15:26.08,Default,,0,0,0,,.(و أو (أزرق)، يُصبح ماساو (أزرق اللّازورد
Dialogue: 0,0:15:26.23,0:15:28.56,Default,,0,0,0,,!آي كن، هذا غِشّ-\N!فهمت-
Dialogue: 0,0:15:28.95,0:15:31.20,Default,,0,0,0,,!"اللّون البُنّيّ الغامق يُعرف بإسم "ماتشا
Dialogue: 0,0:15:31.25,0:15:32.75,Default,,0,0,0,,!أوه، أنتَ مُحقّ
Dialogue: 0,0:15:32.86,0:15:33.45,Default,,0,0,0,,!نعم
Dialogue: 0,0:15:33.46,0:15:35.03,Default,,0,0,0,,ماذا تعنيان؟
Dialogue: 0,0:15:35.78,0:15:41.58,Default,,0,0,0,,.الأحمر يُصبح قُرمزيّاً، و الأزرق لازورديّ، و البُنّيّ داكن، و الأسود فحميّاً، هذا كلّ شيء
Dialogue: 0,0:15:41.60,0:15:44.11,Default,,0,0,0,,!لَيس هكذا، غينتا
Dialogue: 0,0:15:44.11,0:15:46.68,Default,,0,0,0,,!"البُنّيّ الدّاكن "ماتشا" كلَفظ الشّاي الأخضر "ماتشا
Dialogue: 0,0:15:46.88,0:15:49.98,Default,,0,0,0,,!"أوه، صحيح، تُصبح "شاي
Dialogue: 0,0:15:49.98,0:15:52.85,Default,,0,0,0,,!لَحظة، لَقد ساعداكم، هذا غِشّ
Dialogue: 0,0:15:52.85,0:15:54.81,Default,,0,0,0,,!من هُنا تشتري التّذاكر
Dialogue: 0,0:15:55.00,0:15:55.88,Default,,0,0,0,,!!نعم
Dialogue: 0,0:15:56.18,0:15:57.40,Default,,0,0,0,,!إنتظروا
Dialogue: 0,0:15:57.51,0:15:59.41,Default,,0,0,0,,!سنصعد على متن دُولاب فيريس الضّخم
Dialogue: 0,0:15:59.41,0:16:02.11,Default,,0,0,0,,!سنراه قريباً
Dialogue: 0,0:15:59.35,0:16:02.25,up,,0,0,0,,!هـ... هذا لا يُحتسب
Dialogue: 0,0:16:07.31,0:16:11.48,Default,,0,0,0,,!لأحببتُ أن ألمس الدّلافين-\Nكان العرض رائعاً، صحيح؟-
Dialogue: 0,0:16:12.05,0:16:13.05,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:16:13.31,0:16:14.55,Default,,0,0,0,,!هاي، إنتظر
Dialogue: 0,0:16:16.38,0:16:18.58,Default,,0,0,0,,هل أنتِ بخير، أيّتها الآنسة؟
Dialogue: 0,0:16:19.54,0:16:20.58,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:16:21.08,0:16:22.78,Default,,0,0,0,,!وَجهكِ مَجروح
Dialogue: 0,0:16:24.10,0:16:28.31,Default,,0,0,0,,!واه، عيناكِ مُختلفتان باللّون، هذا نادر
Dialogue: 0,0:16:28.71,0:16:30.71,Default,,0,0,0,,.رُبّما لا تتحدّث اليابانيّة
Dialogue: 0,0:16:30.71,0:16:32.51,Default,,0,0,0,,.كلّا... أعرفها
Dialogue: 0,0:16:32.55,0:16:35.05,Default,,0,0,0,,أنتِ وَحيدةٌ في مكانٍ كهذا، ماذا حصل لكِ؟
Dialogue: 0,0:16:35.41,0:16:37.35,Default,,0,0,0,,!لا أحد معكِ على ما يبدو
Dialogue: 0,0:16:37.51,0:16:41.45,Default,,0,0,0,,...إضافةً إلى أنّكِ مُصابةٌ في رُكبتيكِ و يديكِ
Dialogue: 0,0:16:41.65,0:16:43.58,Default,,0,0,0,,!تأذّيتِ بشدّة
Dialogue: 0,0:16:44.55,0:16:45.75,Default,,0,0,0,,هل يُمكنني رُؤيته؟
Dialogue: 0,0:16:45.88,0:16:47.08,Default,,0,0,0,,.نعم
Dialogue: 0,0:16:47.18,0:16:49.68,Default,,0,0,0,,منذ متى و أنتِ هُنا؟
Dialogue: 0,0:16:49.81,0:16:50.95,Default,,0,0,0,,...إيه، حسناً
Dialogue: 0,0:16:51.58,0:16:53.68,Default,,0,0,0,,لكن من أين أتيتِ؟
Dialogue: 0,0:16:54.38,0:16:55.55,Default,,0,0,0,,...لَيست لَديّ فِكرة
Dialogue: 0,0:16:57.78,0:16:59.61,Default,,0,0,0,,ما اسمك؟
Dialogue: 0,0:16:59.61,0:17:00.68,Default,,0,0,0,,إسمي؟
Dialogue: 0,0:17:01.88,0:17:04.01,Default,,0,0,0,,.أعتذر، لا أعرف
Dialogue: 0,0:17:04.68,0:17:06.51,Default,,0,0,0,,.أريني رأسكِ رجاءً
Dialogue: 0,0:17:09.21,0:17:12.18,Default,,0,0,0,,.لَيس جُرحاً خطيراً، لكنّه عميق
Dialogue: 0,0:17:12.45,0:17:15.75,Default,,0,0,0,,.لابدّ من أنّها قد ضرَبت رأسها بسيّارةٍ قديمة
Dialogue: 0,0:17:16.05,0:17:19.41,Default,,0,0,0,,...هناك بعض الكدمات في مُختلف أجزاء جسدها
Dialogue: 0,0:17:20.18,0:17:22.55,Default,,0,0,0,,لكن كيف عرفتَ بشأن السيّارة القديمة؟
Dialogue: 0,0:17:22.81,0:17:27.58,Default,,0,0,0,,.أُنظري هُنا، هناك بعض الشّظايا من الزّجاج الأماميّ
Dialogue: 0,0:17:28.28,0:17:31.18,Default,,0,0,0,,.لكن... المُصمّمة جديداً تملك طبقةً ضدّ الشّظايا
Dialogue: 0,0:17:31.71,0:17:34.18,Default,,0,0,0,,.لذا، ضرَبت رأسها بداخل سيّارة
Dialogue: 0,0:17:34.41,0:17:37.15,Default,,0,0,0,,.كان طِلاء تلك السيّارة أزرق
Dialogue: 0,0:17:37.61,0:17:42.11,Default,,0,0,0,,.هذه الشّظايا جديدة، و أتت من سيّارةٍ زرقاء، لذا فقد كانت السّائقة أو الرّاكبة
Dialogue: 0,0:17:42.91,0:17:46.75,Default,,0,0,0,,.إضافةً إلى هذا، رائحتها تعبق برائحة الوَقود
Dialogue: 0,0:17:48.31,0:17:49.25,Default,,0,0,0,,!هذا صحيح
Dialogue: 0,0:17:49.68,0:17:52.61,Default,,0,0,0,,ألا تحملين شيئاً آخر بحوزتك، أيّتها الآنسة؟
Dialogue: 0,0:17:59.08,0:18:00.08,Default,,0,0,0,,!هذا
Dialogue: 0,0:18:00.08,0:18:00.98,Default,,0,0,0,,!دعيني أراه
Dialogue: 0,0:18:02.68,0:18:03.78,Default,,0,0,0,,ما هو؟
Dialogue: 0,0:18:04.01,0:18:06.55,Default,,0,0,0,,...تبدو كحافظة بطاقات
Dialogue: 0,0:18:07.25,0:18:09.41,Default,,0,0,0,,.لكنّها تبدو غريبة الشّكل نوعاً ما
Dialogue: 0,0:18:09.68,0:18:10.91,Default,,0,0,0,,أيّ نوعٍ من البطاقات يُوضع فيها؟
Dialogue: 0,0:18:10.91,0:18:11.98,Default,,0,0,0,,!هاي
Dialogue: 0,0:18:12.55,0:18:14.51,Default,,0,0,0,,!كونان، هايبارا
Dialogue: 0,0:18:14.61,0:18:17.11,Default,,0,0,0,,!حصلنا على التّذاكر
Dialogue: 0,0:18:17.21,0:18:19.75,Default,,0,0,0,,!و ستبدأ المتاعب
Dialogue: 0,0:18:20.38,0:18:22.45,Default,,0,0,0,,أوه، من هذه؟
Dialogue: 0,0:18:23.71,0:18:26.25,Default,,0,0,0,,!عيناها مُختلفتا اللّون
Dialogue: 0,0:18:26.25,0:18:27.31,Default,,0,0,0,,!إنّها جميلة
Dialogue: 0,0:18:27.41,0:18:29.55,Default,,0,0,0,,هل هي مُزيّفة؟
Dialogue: 0,0:18:29.58,0:18:33.21,Default,,0,0,0,,.أخطأت، غينتا، هذه الآنسة لَديها جدار عينين
Dialogue: 0,0:18:33.51,0:18:34.41,Default,,0,0,0,,جدار عينين؟
Dialogue: 0,0:18:34.48,0:18:37.18,Default,,0,0,0,,!هذه الآنسة إسمها غريب
Dialogue: 0,0:18:38.15,0:18:40.51,Default,,0,0,0,,!كلّا، لا علاقة لهذا بإسمها
Dialogue: 0,0:18:40.55,0:18:41.01,Default,,0,0,0,,!فهمت
Dialogue: 0,0:18:41.28,0:18:42.90,Default,,0,0,0,,!تُدرّب الفقمات
Dialogue: 0,0:18:42.90,0:18:44.35,Default,,0,0,0,,!مُدرّبة فقمات
Dialogue: 0,0:18:45.41,0:18:47.45,Default,,0,0,0,,ألَيس هذا صحيحاً، كونان؟
Dialogue: 0,0:18:48.30,0:18:49.35,Default,,0,0,0,,...نعم
Dialogue: 0,0:18:49.55,0:18:51.48,Default,,0,0,0,,!أوه، أعتذر
Dialogue: 0,0:18:51.71,0:18:53.78,Default,,0,0,0,,!لا حاجة للإعتذار بسبب الضّحك
Dialogue: 0,0:18:54.78,0:18:58.28,Default,,0,0,0,,بالحديث بجدّيّةٍ الآن، ماذا نفعل هُنا؟
Dialogue: 0,0:18:58.48,0:18:59.71,Default,,0,0,0,,!أتيتَ في الوَقت المُناسب، بروفيسور
Dialogue: 0,0:18:59.80,0:19:05.00,Default,,0,0,0,,!يبدو بأنّ هذه المرأة قد فقدت ذاكرتها بسبب حادث
Dialogue: 0,0:19:05.18,0:19:06.31,Default,,0,0,0,,...حقّاً، شينـ
Dialogue: 0,0:19:06.58,0:19:07.95,Default,,0,0,0,,!أعني، كونان
Dialogue: 0,0:19:08.18,0:19:11.75,Default,,0,0,0,,!نعم، أظنّ بأنّ علينا الإتّصال بالشّرطة
Dialogue: 0,0:19:11.85,0:19:13.75,Default,,0,0,0,,الشّرطة، لكن لماذا؟
Dialogue: 0,0:19:13.75,0:19:14.51,Default,,0,0,0,,!توَقّفوا
Dialogue: 0,0:19:16.45,0:19:19.48,Default,,0,0,0,,أيّتها الآنسة، هل ستحصل مُشكلةٌ إن اتّصلنا بالشّرطة؟
Dialogue: 0,0:19:20.30,0:19:21.55,Default,,0,0,0,,...لا أعلَم
Dialogue: 0,0:19:21.95,0:19:24.85,Default,,0,0,0,,.حسناً... لنَلتقط صورتها إذاً
Dialogue: 0,0:19:26.48,0:19:28.68,Default,,0,0,0,,!أه، لا تتحرّكي
Dialogue: 0,0:19:28.71,0:19:31.65,Default,,0,0,0,,.إنتظري أيّتها الآنسة، لَن نتّصل بالشّرطة
Dialogue: 0,0:19:33.41,0:19:37.31,Default,,0,0,0,,.سنبحث عن أحد معارفكِ فقط، و نحتاج لصورة
Dialogue: 0,0:19:37.41,0:19:38.78,Default,,0,0,0,,مـ... معارفي؟
Dialogue: 0,0:19:38.91,0:19:42.15,Default,,0,0,0,,.نعم، سنُريهم صورتكِ
Dialogue: 0,0:19:42.15,0:19:43.78,Default,,0,0,0,,حقّاً، كونان؟
Dialogue: 0,0:19:43.81,0:19:45.25,Default,,0,0,0,,!نُريد المُساعدة أيضاً
Dialogue: 0,0:19:45.88,0:19:50.78,Default,,0,0,0,,~بإسم المُتحرّين الصّغار~
Dialogue: 0,0:19:52.75,0:19:57.18,Default,,0,0,0,,!سنُساعدكِ في البحث عن أصدقائكِ و ذاكرتك
Dialogue: 0,0:19:57.40,0:19:59.58,Default,,0,0,0,,!أرجوكِ ثقي بنا
Dialogue: 0,0:20:00.81,0:20:02.05,Default,,0,0,0,,!شُكراً جزيلاً لكم
Dialogue: 0,0:20:02.38,0:20:05.26,Default,,0,0,0,,.لنُحاول إيجاد شخصٍ تعرفه
Dialogue: 0,0:20:05.31,0:20:05.85,Default,,0,0,0,,.حسناً
Dialogue: 0,0:20:05.91,0:20:07.85,Default,,0,0,0,,لكن كيف ستفعلون هذا؟
Dialogue: 0,0:20:07.85,0:20:09.61,Default,,0,0,0,,!هذا وَاضح، بروفيسور
Dialogue: 0,0:20:09.78,0:20:12.06,Default,,0,0,0,,!سنبحث في الأرجاء
Dialogue: 0,0:20:12.58,0:20:14.58,up,,0,0,0,,و إلى أين ستذهبون؟
Dialogue: 0,0:20:12.58,0:20:14.75,Default,,0,0,0,,!لنَذهب إلى هناك أوّلاً
Dialogue: 0,0:20:14.78,0:20:16.18,Default,,0,0,0,,!نعم، لنَذهب
Dialogue: 0,0:20:17.65,0:20:20.18,Default,,0,0,0,,!سنَذهب أوّلاً
Dialogue: 0,0:20:20.48,0:20:22.08,Default,,0,0,0,,!هيّا، بسرعة، بسرعة
Dialogue: 0,0:20:22.45,0:20:26.01,Default,,0,0,0,,!هاي، أيّها الأطفال، هذا لَيس وَقت اللّعب في الأرجاء
Dialogue: 0,0:20:26.38,0:20:29.25,Default,,0,0,0,,ألَن تتّصل بالشّرطة حقّاً؟
Dialogue: 0,0:20:29.31,0:20:31.05,Default,,0,0,0,,...لَيس باليَد حيلة
Dialogue: 0,0:20:37.70,0:20:39.78,Default,,0,0,0,,!أغلقيه، اللّعنة
Dialogue: 0,0:20:42.61,0:20:43.58,Default,,0,0,0,,!أبي
Dialogue: 0,0:20:44.88,0:20:46.58,Default,,0,0,0,,...هاي، يوكو تشان
Dialogue: 0,0:20:54.05,0:20:55.50,Default,,0,0,0,,!أبي
Dialogue: 0,0:20:56.31,0:20:59.01,Default,,0,0,0,,حتّى متى تنوي الإستمرار بالنّوم؟
Dialogue: 0,0:20:59.08,0:21:04.35,Default,,0,0,0,,!إخرسي، النّوم مُهمٌّ جدّاً للمُتحرّي
Dialogue: 0,0:21:04.35,0:21:07.28,Default,,0,0,0,,.بمعنىً آخر، تُعاني من دوار الثّمالة و صُداع
Dialogue: 0,0:21:07.48,0:21:11.71,Default,,0,0,0,,.كلّا، هذا لَيس صحيحاً... على الإطلاق
Dialogue: 0,0:21:12.61,0:21:14.01,Default,,0,0,0,,.إنّه من كونان
Dialogue: 0,0:21:14.11,0:21:17.71,Default,,0,0,0,,.يقول بأنّ هذه المرأة قد فقدَت ذاكرتها، و لا تُريد الإتّصال بالشّرطة
Dialogue: 0,0:21:17.85,0:21:20.55,Default,,0,0,0,,...أظنّ بأنّه علينا الإتّصال بالضّابط تاكاغي، لكن على أيّة حال
Dialogue: 0,0:21:20.55,0:21:22.00,Default,,0,0,0,,هل يُمكنكَ الإعتناء بهذا؟
Dialogue: 0,0:21:22.78,0:21:24.45,Default,,0,0,0,,!يال جمالها
Dialogue: 0,0:21:24.45,0:21:25.61,Default,,0,0,0,,هل تسمعني؟
Dialogue: 0,0:21:26.05,0:21:28.61,Default,,0,0,0,,!سأعتني بهذا الأمر، يُمكنكِ الإعتماد عليّ
Dialogue: 0,0:21:28.78,0:21:30.48,Default,,0,0,0,,ما خطبك؟
Dialogue: 0,0:21:30.61,0:21:31.31,Default,,0,0,0,,!عرفت
Dialogue: 0,0:21:31.91,0:21:33.31,Default,,0,0,0,,!إنتظر، أبي
Dialogue: 0,0:21:33.35,0:21:36.60,Default,,0,0,0,,!عمل المُتحرّي لا ينتظر
Dialogue: 0,0:21:36.68,0:21:38.30,Default,,0,0,0,,...لكن لَيس لهذا السّبب
Dialogue: 0,0:21:38.65,0:21:40.05,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:21:41.91,0:21:42.98,Default,,0,0,0,,.أيّها المُفتّش
Dialogue: 0,0:21:43.05,0:21:46.48,Default,,0,0,0,,.هذه هي آخر صُور موقع الحادث
Dialogue: 0,0:21:47.55,0:21:51.68,Default,,0,0,0,,.من الوَاضح بأنّ هذا التّكدّس لَيس عشوائيّاً
Dialogue: 0,0:21:51.91,0:21:53.45,Default,,0,0,0,,...تكدّس، همم
Dialogue: 0,0:21:53.88,0:21:55.85,Default,,0,0,0,,.حصلَت بعض الأضرار الضّخمة
Dialogue: 0,0:21:56.10,0:21:58.85,Default,,0,0,0,,إذاً هذه هي المرأة التي يُفترض بأنّها قد فقدَت ذاكرتها؟
Dialogue: 0,0:21:58.91,0:22:04.45,Default,,0,0,0,,.لَدينا القليل من المعلومات عن أسباب هذا الحادث
Dialogue: 0,0:22:04.78,0:22:05.78,Default,,0,0,0,,...في تلك الحال
Dialogue: 0,0:22:06.50,0:22:08.50,Default,,0,0,0,,.نحتاج للنّظر بعُمقٍ أكبر قليلاً في هذه القضيّة
Dialogue: 0,0:22:09.55,0:22:10.48,Default,,0,0,0,,!أيّها المُفتّش ميغوري
Dialogue: 0,0:22:10.75,0:22:11.78,Default,,0,0,0,,إذاً؟
Dialogue: 0,0:22:13.18,0:22:16.58,Default,,0,0,0,,!وَجدنا دليلاً لجريمة كسرٍ و اقتحامٍ في الجّناح الشّماليّ لَيلة البارحة
Dialogue: 0,0:22:16.95,0:22:17.91,Default,,0,0,0,,...فهمت
Dialogue: 0,0:22:18.50,0:22:19.35,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:22:19.85,0:22:24.25,Default,,0,0,0,,!هناك بعض الأُمور التي لا يُفترض بنا الحديث عنها في هذا المَقرّ
Dialogue: 0,0:22:24.41,0:22:25.78,Default,,0,0,0,,ممّا يعني؟
Dialogue: 0,0:22:25.88,0:22:29.85,Default,,0,0,0,,!مع هذا، يبدو بأنّ بعض المعلومات المُهمّة قد تمّ سرقتها
Dialogue: 0,0:22:30.48,0:22:31.65,Default,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:22:33.58,0:22:37.71,Default,,0,0,0,,!هذا شيءٌ خارجٌ عن نِطاقنا
Dialogue: 0,0:22:59.18,0:22:59.85,Default,,0,0,0,,!وَجدتّها
Dialogue: 0,0:23:01.98,0:23:03.48,Default,,0,0,0,,.وَجدتّها، جين
Dialogue: 0,0:23:04.05,0:23:04.50,Default,,0,0,0,,أين؟
Dialogue: 0,0:23:04.88,0:23:06.10,Default,,0,0,0,,.حوض أسماك توتو
Dialogue: 0,0:23:06.25,0:23:07.25,Default,,0,0,0,,حوض الأسماك؟
Dialogue: 0,0:23:07.45,0:23:08.10,Default,,0,0,0,,!نعم
Dialogue: 0,0:23:08.65,0:23:11.51,Default,,0,0,0,,.لا تقلَق، سأُعيدها في الحال
Dialogue: 0,0:23:13.75,0:23:18.54,Default,,0,0,0,,!مرحباً بكم في مُنتزه سوزوكي البحريّ، شُكراً لكم على حُضوركم
Dialogue: 0,0:23:23.61,0:23:26.68,Default,,0,0,0,,هل تظنّ بأنّ إحضارها إلى هُنا سيُساعدها بتذكّر شيءٍ ما؟
Dialogue: 0,0:23:27.01,0:23:30.68,Default,,0,0,0,,!نعم، قد تتعرّف على أحدٍ في هذا الجّمع
Dialogue: 0,0:23:30.88,0:23:34.08,Default,,0,0,0,,!لكن مازال من الغريب قليلاً عدم تذكّرها لأيّ شيء
Dialogue: 0,0:23:35.35,0:23:37.58,Default,,0,0,0,,نعم، لكن إلى أين سنَذهب الآن؟
Dialogue: 0,0:23:38.11,0:23:40.58,Default,,0,0,0,,!لَيست لَديّ فِكرة
Dialogue: 0,0:23:40.61,0:23:42.11,Default,,0,0,0,,نعم، لماذا لا تُجرّبين هذا؟
Dialogue: 0,0:23:42.15,0:23:44.94,Default,,0,0,0,,لماذا لا تُحاولين لَعبها؟
Dialogue: 0,0:23:44.95,0:23:46.38,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:23:56.08,0:23:57.01,Default,,0,0,0,,!مُدهش
Dialogue: 0,0:23:57.01,0:24:00.95,Default,,0,0,0,,!مُبارك، حصلتِ على أعلى نتيجة
Dialogue: 0,0:24:02.38,0:24:04.25,Default,,0,0,0,,!هيّا، لنُصفّق بأيدينا
Dialogue: 0,0:24:04.31,0:24:06.18,Default,,0,0,0,,!هيّا، تصفيقٌ صغير
Dialogue: 0,0:24:07.68,0:24:09.86,Default,,0,0,0,,!لنَفعلها أيضاً-\N!أنا أيضاً-
Dialogue: 0,0:24:11.30,0:24:12.10,Default,,0,0,0,,!رائع
Dialogue: 0,0:24:12.35,0:24:13.31,Default,,0,0,0,,!أُريد هذا أيضاً
Dialogue: 0,0:24:13.91,0:24:15.75,Default,,0,0,0,,!إبتسمتِ أخيراً، أيّتها الآنسة
Dialogue: 0,0:24:16.75,0:24:19.70,Default,,0,0,0,,!بالتّأكيد، أنتِ أكثر جمالاً بكثيرٍ عندما تبتسمين
Dialogue: 0,0:24:19.70,0:24:20.15,Default,,0,0,0,,!بالفِعل
Dialogue: 0,0:24:20.21,0:24:21.38,Default,,0,0,0,,ألَيس هذا صحيحاً؟
Dialogue: 0,0:24:21.38,0:24:22.41,Default,,0,0,0,,حقّاً؟
Dialogue: 0,0:24:22.41,0:24:23.78,Default,,0,0,0,,!بِلا شكّ
Dialogue: 0,0:24:24.08,0:24:26.88,Default,,0,0,0,,أيّها ترغبون بالإختيار؟
Dialogue: 0,0:24:27.11,0:24:28.88,Default,,0,0,0,,!أوه، رائع
Dialogue: 0,0:24:29.45,0:24:30.81,Default,,0,0,0,,أيّها سنأخذ؟
Dialogue: 0,0:24:30.88,0:24:31.75,Default,,0,0,0,,!هذه
Dialogue: 0,0:24:31.91,0:24:33.86,Default,,0,0,0,,أيّها نأخذ؟-\N!أُفضّل هذه أو هذه-
Dialogue: 0,0:24:33.86,0:24:35.38,Default,,0,0,0,,!نعم، خُذوها
Dialogue: 0,0:24:35.45,0:24:36.80,Default,,0,0,0,,كيف تشعرين، هل أنتِ بخير؟
Dialogue: 0,0:24:37.00,0:24:39.51,Default,,0,0,0,,!كلّا، لا تقلَقوا، أنا بخير
Dialogue: 0,0:24:39.85,0:24:40.91,Default,,0,0,0,,...لكن
Dialogue: 0,0:24:41.08,0:24:43.25,Default,,0,0,0,,.عليكِ أن تختاري أيضاً
Dialogue: 0,0:24:43.25,0:24:44.95,Default,,0,0,0,,!هاي، يا رفاق
Dialogue: 0,0:24:45.21,0:24:46.78,Default,,0,0,0,,!هاي، كونان، آي
Dialogue: 0,0:24:47.25,0:24:51.75,Default,,0,0,0,,.لَن تعود ذاكرتها هكذا، دعوا الآنسة ترتاح قليلاً
Dialogue: 0,0:24:51.85,0:24:52.95,Default,,0,0,0,,!...لكن
Dialogue: 0,0:24:52.98,0:24:55.55,Default,,0,0,0,,!هذه المرّة الأُولى التي أرى فيها شيئاً كهذا في لُعبة
Dialogue: 0,0:24:55.61,0:24:59.31,Default,,0,0,0,,!إن سألتَني، أظنّ بأنّ هذه الآنسة يُمكنها رِبح كلّ شيءٍ هُنا
Dialogue: 0,0:24:59.40,0:25:01.39,Default,,0,0,0,,!لا يفهمون شيئاً
Dialogue: 0,0:25:01.65,0:25:05.11,Default,,0,0,0,,ماذا ستفعل؟\N.يبدو بأنّ الأُمور ستكون مُعقّدةً قليلاً هُنا
Dialogue: 0,0:25:06.30,0:25:08.51,Default,,0,0,0,,!هاي، جميعكم
Dialogue: 0,0:25:08.61,0:25:11.65,up,,0,0,0,,!عليكم البقاء معاً
Dialogue: 0,0:25:11.15,0:25:12.20,Default,,0,0,0,,!إنّه البروفيسور
Dialogue: 0,0:25:12.00,0:25:12.85,up,,0,0,0,,!أنا هُنا
Dialogue: 0,0:25:12.70,0:25:15.10,Default,,0,0,0,,!ماذا تفعل هناك، بروفيسور
Dialogue: 0,0:25:15.18,0:25:20.15,Default,,0,0,0,,!يُوجد عددٌ قليلٌ داخل دُولاب فيريس الضّخم، هذه فُرصتنا
Dialogue: 0,0:25:20.35,0:25:21.51,Default,,0,0,0,,حقّاً؟
Dialogue: 0,0:25:21.55,0:25:24.01,Default,,0,0,0,,!لنَذهب إذاً
Dialogue: 0,0:25:24.05,0:25:28.15,Default,,0,0,0,,!فكرةٌ جيّدة، قد تذكر شيئاً ما
Dialogue: 0,0:25:28.15,0:25:28.95,Default,,0,0,0,,!حسناً
Dialogue: 0,0:25:29.61,0:25:33.71,Default,,0,0,0,,!لنَذهب معاً، أيّتها الآنسة-\N!أسرعي-\N!من هُنا، هيّا، هيّا-
Dialogue: 0,0:25:33.95,0:25:34.95,Default,,0,0,0,,!...يا إلهي
Dialogue: 0,0:25:35.01,0:25:38.38,Default,,0,0,0,,!قد يكون هذا مُفيداً في الوَاقع
Dialogue: 0,0:25:40.55,0:25:43.68,Default,,0,0,0,,!إن سألتِني، لابدّ من أنّها خِدعةٌ من البروفيسور
Dialogue: 0,0:25:44.58,0:25:45.78,Default,,0,0,0,,...تمّ اكتشاف أمري
Dialogue: 0,0:25:45.88,0:25:50.28,Default,,0,0,0,,عُذراً، هل رأيتَ تلك الآنسة بالقُرب من كُشككَ سابقاً؟
Dialogue: 0,0:25:50.91,0:25:53.65,Default,,0,0,0,,الآنسة ذات الشّعر الفضّيّ؟
Dialogue: 0,0:25:53.68,0:25:55.41,Default,,0,0,0,,نعم، هل تعرفها؟
Dialogue: 0,0:25:55.75,0:25:58.18,Default,,0,0,0,,...لا أذكر
Dialogue: 0,0:25:58.55,0:26:02.20,Default,,0,0,0,,.لا أظنّني قد رأيتُ زبوناً بمهارتها سابقاً
Dialogue: 0,0:26:03.31,0:26:05.05,Default,,0,0,0,,...علامةٌ كاملة
Dialogue: 0,0:26:05.41,0:26:07.01,Default,,0,0,0,,...هذا غير طبيعيّ
Dialogue: 0,0:26:07.78,0:26:09.38,Default,,0,0,0,,!شُكراً لك، سيّدي
Dialogue: 0,0:26:09.65,0:26:10.50,Default,,0,0,0,,!أه، نعم
Dialogue: 0,0:26:11.35,0:26:14.15,Default,,0,0,0,,هل يُمكنكَ إعطاء هذه لصديقتك؟
Dialogue: 0,0:26:14.68,0:26:16.21,Default,,0,0,0,,!...ماذا؟ هذه
Dialogue: 0,0:26:16.48,0:26:18.91,Default,,0,0,0,,.إنّه دولفينٌ أبيض، لَيس عليه أيّ ألوانٍ بعد
Dialogue: 0,0:26:19.31,0:26:22.80,Default,,0,0,0,,.ظننتُ بأنّ تلك الآنسة قد تُحبّه
Dialogue: 0,0:26:23.25,0:26:26.95,Default,,0,0,0,,.يُمكنها طليُه باللّون الذي يُعجبها
Dialogue: 0,0:26:26.98,0:26:29.11,Default,,0,0,0,,.نعم، وَاثقٌ من أنّها ستُسعد بهذا
Dialogue: 0,0:26:29.28,0:26:30.85,Default,,0,0,0,,!شُكراً، سيّدي
Dialogue: 0,0:26:31.21,0:26:33.28,Default,,0,0,0,,!على الرّحب و السّعة، إستمتعوا
Dialogue: 0,0:26:33.68,0:26:34.61,Default,,0,0,0,,!لنَذهب، هايبارا
Dialogue: 0,0:26:35.35,0:26:37.61,Default,,0,0,0,,إلى أين؟
Dialogue: 0,0:26:38.05,0:26:42.71,Default,,0,0,0,,.تركتُ الآنسة مع البروفيسور، يُمكنه مُراقبتها، و يُمكنني التّفكير بحُرّيّة
Dialogue: 0,0:26:43.45,0:26:49.61,Default,,0,0,0,,!علينا جمع المزيد من المعلومات عن الآنسة
Dialogue: 0,0:27:06.85,0:27:08.65,Default,,0,0,0,,!أشعر بالكثير من الإثارة
Dialogue: 0,0:27:08.78,0:27:11.15,Default,,0,0,0,,أتسائل كيف سيكون المَشهد هُناك؟
Dialogue: 0,0:27:11.15,0:27:13.10,up,,0,0,0,,!رُبّما يُمكننا رُؤية بُرج شجرة الجّرس
Dialogue: 0,0:27:12.25,0:27:15.61,Default,,0,0,0,,!ماذا تفعلين هُنا؟ سنعود
Dialogue: 0,0:27:13.40,0:27:15.10,up,,0,0,0,,!أه، بالفِعل
Dialogue: 0,0:27:17.05,0:27:20.35,Default,,0,0,0,,!أيّتها الآنسة، سيضيع دورك
Dialogue: 0,0:27:20.55,0:27:24.98,Default,,0,0,0,,!أعتذر، ظننتُ بأنّ إحداهنّ كانت تُحدّثني
Dialogue: 0,0:27:25.05,0:27:26.88,Default,,0,0,0,,هل تعرفينها؟
Dialogue: 0,0:27:26.88,0:27:29.55,Default,,0,0,0,,.كلّا، لابدّ من أنّها قد أخطأتني بشخصٍ آخر
Dialogue: 0,0:27:29.98,0:27:31.60,Default,,0,0,0,,حسناً، هل جميعكم مُستعدّون؟
Dialogue: 0,0:27:32.05,0:27:33.10,Default,,0,0,0,,!نعم
Dialogue: 0,0:27:33.25,0:27:34.40,Default,,0,0,0,,!من هُنا لَو سمحتُم
Dialogue: 0,0:27:35.40,0:27:39.10,Default,,0,0,0,,!هناك خطبٌ ما، يبدو بأنّها قد فقدَت ذاكرتها
Dialogue: 0,0:27:39.38,0:27:40.15,Default,,0,0,0,,!أسرعي
Dialogue: 0,0:27:40.55,0:27:42.45,Default,,0,0,0,,.تأكّدي من أنّها ستتذكّر كلّ شيء
Dialogue: 0,0:27:42.85,0:27:43.88,Default,,0,0,0,,!عُلِم
Dialogue: 0,0:27:48.65,0:27:51.45,Default,,0,0,0,,...قد يكون من الحِكمة إعلام الشّرطة
Dialogue: 0,0:27:51.71,0:27:54.95,Default,,0,0,0,,عليّ الإتّصال بالبروفيسور لأسأله عن مكانهم، ألا تظنّين هذا، هايبارا؟
Dialogue: 0,0:27:55.80,0:27:56.50,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:27:56.95,0:27:59.10,Default,,0,0,0,,!تتصرّفين بغرابةٍ منذ أن كنّا هناك
Dialogue: 0,0:27:59.15,0:28:00.40,Default,,0,0,0,,.لا تقلَق
Dialogue: 0,0:28:00.40,0:28:03.00,Default,,0,0,0,,!هاي، كونان، هايبارا
Dialogue: 0,0:28:03.15,0:28:04.48,Default,,0,0,0,,.نحن هُنا
Dialogue: 0,0:28:04.55,0:28:06.05,Default,,0,0,0,,!بالأعلى، بالأعلى
Dialogue: 0,0:28:06.41,0:28:08.05,Default,,0,0,0,,هل رأيتمونا؟
Dialogue: 0,0:28:08.40,0:28:10.25,Default,,0,0,0,,!هُنا
Dialogue: 0,0:28:10.29,0:28:11.33,Default,,0,0,0,,ما رأيكما؟
Dialogue: 0,0:28:10.98,0:28:12.38,up,,0,0,0,,!غينتا، إحذر
Dialogue: 0,0:28:12.48,0:28:13.90,Default,,0,0,0,,هاه، لكن لماذا؟
Dialogue: 0,0:28:13.90,0:28:14.35,Default,,0,0,0,,!غينتا
Dialogue: 0,0:28:16.85,0:28:17.51,Default,,0,0,0,,!غينتا
Dialogue: 0,0:28:20.01,0:28:21.08,Default,,0,0,0,,!غينتا
Dialogue: 0,0:28:21.28,0:28:22.08,Default,,0,0,0,,!سأسقط
Dialogue: 0,0:28:22.08,0:28:23.48,Default,,0,0,0,,ماذا عليّ أن أفعل؟
Dialogue: 0,0:28:23.89,0:28:25.05,Default,,0,0,0,,...لا يُمكنني الإحتمال أكثر
Dialogue: 0,0:28:25.45,0:28:26.51,Default,,0,0,0,,!كلّا
Dialogue: 0,0:28:26.51,0:28:27.41,Default,,0,0,0,,!بسرعة-\N!غينتا-
Dialogue: 0,0:28:53.45,0:28:54.71,Default,,0,0,0,,هل أنتَ بخير، غينتا؟
Dialogue: 0,0:28:54.91,0:28:57.58,Default,,0,0,0,,!هل أنتَ بخير، غينتا؟ إستيقظ
Dialogue: 0,0:29:04.31,0:29:06.88,Default,,0,0,0,,لكن، ماذا تفعلين هُنا؟
Dialogue: 0,0:29:06.98,0:29:07.98,Default,,0,0,0,,!حمداً لله
Dialogue: 0,0:29:12.05,0:29:13.55,Default,,0,0,0,,!أه، أيّتها الآنسة
Dialogue: 0,0:29:13.95,0:29:16.48,Default,,0,0,0,,!صحيح، كنتُ على وَشك السّقوط
Dialogue: 0,0:29:16.91,0:29:19.20,Default,,0,0,0,,هل أنتُما بخير؟ هل الجّميع بخير؟
Dialogue: 0,0:29:19.25,0:29:22.28,Default,,0,0,0,,!أنقذَتني الآنسة، كلّ شيءٍ بخير
Dialogue: 0,0:29:22.28,0:29:23.00,Default,,0,0,0,,!حمداً لله
Dialogue: 0,0:29:23.15,0:29:25.91,Default,,0,0,0,,!دعاني أقوم باصطحابكما إلى المَشفى
Dialogue: 0,0:29:31.35,0:29:32.48,Default,,0,0,0,,لكن كيف...؟
Dialogue: 0,0:29:34.21,0:29:36.75,Default,,0,0,0,,!ستكون بخيرٍ الآن
Dialogue: 0,0:29:36.98,0:29:39.18,Default,,0,0,0,,!شُكراً جزيلاً
Dialogue: 0,0:29:39.38,0:29:40.58,Default,,0,0,0,,!حسناً، لنَقِف
Dialogue: 0,0:29:40.78,0:29:42.28,Default,,0,0,0,,!هذا مُؤلِم
Dialogue: 0,0:29:42.38,0:29:45.28,Default,,0,0,0,,كيف أُصيب؟
Dialogue: 0,0:29:45.45,0:29:46.88,Default,,0,0,0,,!هذا لا يُصدّق
Dialogue: 0,0:29:46.88,0:29:48.61,Default,,0,0,0,,.طُفوليٌّ بالفِعل
Dialogue: 0,0:29:48.80,0:29:51.15,Default,,0,0,0,,!سترون عندما تكبرون لتُصبحوا بعُمري
Dialogue: 0,0:29:51.21,0:29:54.70,Default,,0,0,0,,!الآن بما أنّ كلّ شيءٍ بخير، لنَذهب إلى دُولاب فيريس الضّخم
Dialogue: 0,0:29:54.70,0:29:56.15,Default,,0,0,0,,!شُكراً، أيّتها الآنسة
Dialogue: 0,0:29:56.15,0:29:57.01,Default,,0,0,0,,ما رأيكِ؟
Dialogue: 0,0:29:57.01,0:29:57.95,Default,,0,0,0,,.لنَذهب
Dialogue: 0,0:29:58.71,0:30:00.21,Default,,0,0,0,,...نعم، لكن
Dialogue: 0,0:30:00.88,0:30:03.05,Default,,0,0,0,,.يجب أن يُشرف أحدٌ عليكم
Dialogue: 0,0:30:03.08,0:30:05.28,Default,,0,0,0,,ماذا تقولين؟
Dialogue: 0,0:30:05.28,0:30:07.88,Default,,0,0,0,,!أنتِ وَصيّتنا
Dialogue: 0,0:30:07.88,0:30:08.85,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:30:08.85,0:30:10.35,Default,,0,0,0,,.حسناً إذاً، لنَذهب
Dialogue: 0,0:30:10.45,0:30:11.25,Default,,0,0,0,,!إنتظروا
Dialogue: 0,0:30:11.41,0:30:13.75,Default,,0,0,0,,!إيدوغاوا، أحتاج للحديث معك
Dialogue: 0,0:30:14.15,0:30:14.83,Default,,0,0,0,,!حسناً
Dialogue: 0,0:30:15.30,0:30:17.18,Default,,0,0,0,,...في هذه الحال، لنَذهب، و أنتِ
Dialogue: 0,0:30:17.21,0:30:17.91,Default,,0,0,0,,!كلّا
Dialogue: 0,0:30:18.56,0:30:19.80,Default,,0,0,0,,.إعتني بهم رجاءً
Dialogue: 0,0:30:20.30,0:30:21.01,Default,,0,0,0,,!حسناً
Dialogue: 0,0:30:22.45,0:30:23.58,Default,,0,0,0,,ما سبب كلّ هذا؟
Dialogue: 0,0:30:23.71,0:30:25.18,Default,,0,0,0,,!كم هذا مُملّ
Dialogue: 0,0:30:32.81,0:30:33.91,Default,,0,0,0,,ماذا، ماذا؟
Dialogue: 0,0:30:34.11,0:30:39.01,Default,,0,0,0,,هل أنتُما مُستعدّان؟ ما رأيكما؟\N!لنُبقي الأمر سرّاً عن كونان و هايبارا
Dialogue: 0,0:30:40.50,0:30:43.81,Default,,0,0,0,,!...هل أنتِ وَاثقة؟ هذه الآنسة، هل يُمكن أنّها منهم حقّاً
Dialogue: 0,0:30:44.18,0:30:48.75,Default,,0,0,0,,لَستُ وَاثقة، لكن... ألَم تشعر بأيّ شيء؟
Dialogue: 0,0:30:50.25,0:30:54.15,Default,,0,0,0,,!تلك العين اليُمنى... هذا يُذكّرني بما أخبرتكَ به سابقاً
Dialogue: 0,0:30:54.75,0:30:56.81,Default,,0,0,0,,!تلك القصّة التي قُمتِ... مُستحيل
Dialogue: 0,0:30:57.05,0:31:01.21,Default,,0,0,0,,!صحيح، الشّخص #2 في المُنظّمة
Dialogue: 0,0:31:05.01,0:31:05.70,Default,,0,0,0,,!رم
Dialogue: 0,0:31:11.08,0:31:13.18,Default,,0,0,0,,!أيّتها الآنسة، أيّتها الآنسة
Dialogue: 0,0:31:14.25,0:31:15.11,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:31:22.40,0:31:24.28,Default,,0,0,0,,...إن كانت تلك المرأة هي رم بالفِعل
Dialogue: 0,0:31:24.65,0:31:27.31,Default,,0,0,0,,...إذاً فُقدان الذّاكرة هذا الذي يبدو غريباً بالنّسبة لي
Dialogue: 0,0:31:27.65,0:31:31.21,Default,,0,0,0,,.رم بالفِعل لا يملك وَصفاً دقيقاً
Dialogue: 0,0:31:32.88,0:31:36.15,Default,,0,0,0,,!عدا عن عيناه، لا يبدو بأنّ أحداً من المُنظّمة يتّفق على مَظهره
Dialogue: 0,0:31:36.41,0:31:42.78,Default,,0,0,0,,!رجلٌ ذا بُنيةٍ قويّة، رجلٌ أُنثويّ المَظهر، أو رجلٌ مُسنّ
Dialogue: 0,0:31:43.05,0:31:43.78,Default,,0,0,0,,...و أيضاً
Dialogue: 0,0:31:45.28,0:31:49.78,Default,,0,0,0,,!حقيقة أنّ إحدى عينيه مُصابة...
Dialogue: 0,0:31:52.18,0:31:55.60,Default,,0,0,0,,...إن كانت عين تلك المرأة اصطناعيّة، إذاً من المُمكن أن
Dialogue: 0,0:31:55.90,0:31:59.35,Default,,0,0,0,,!فهمت، قد يكون أمر فُقدانها للذّاكرة خِدعة
Dialogue: 0,0:32:00.71,0:32:04.25,Default,,0,0,0,,لكن لماذا لم تعتني بأمر رِفاقنا بالفِعل؟
Dialogue: 0,0:32:05.31,0:32:06.11,Default,,0,0,0,,...حسناً
Dialogue: 0,0:32:06.18,0:32:09.25,Default,,0,0,0,,.يبدو لي بأنّها قد فقدَت الذّاكرة بالفِعل
Dialogue: 0,0:32:09.55,0:32:12.05,Default,,0,0,0,,.الرّجال المُرتدين الأسود، رُبّما لا يعرفون شيئاً عن هذا
Dialogue: 0,0:32:12.80,0:32:16.85,Default,,0,0,0,,...لكن إن ساعدناها على استعادة ذكرياتها، يُمكننا
Dialogue: 0,0:32:17.05,0:32:20.50,Default,,0,0,0,,!كلّا، بالتّأكيد لَيس هذا
Dialogue: 0,0:32:20.70,0:32:21.95,Default,,0,0,0,,...لا تُخبرني بأنّكَ
Dialogue: 0,0:32:22.35,0:32:25.98,Default,,0,0,0,,!تُريد استخدام ذكرياتها لجمع بعض المعلومات عن المُنظّمة
Dialogue: 0,0:32:26.11,0:32:28.28,Default,,0,0,0,,!إيّاكَ و التّفكير بهذا حتّى
Dialogue: 0,0:32:28.68,0:32:32.11,Default,,0,0,0,,!لَم يبقى معي أحدٌ سواك
Dialogue: 0,0:32:32.41,0:32:35.15,Default,,0,0,0,,...و لَو أنّ أولئكَ الأطفال قد
Dialogue: 0,0:32:36.95,0:32:37.61,Default,,0,0,0,,لَقد اختفوا؟...
Dialogue: 0,0:32:37.85,0:32:39.41,Default,,0,0,0,,!كان يُفترض بأنّ البروفيسور يُراقبهم
Dialogue: 0,0:32:40.70,0:32:41.75,Default,,0,0,0,,!يال ظرافتكم
Dialogue: 0,0:32:41.85,0:32:42.88,Default,,0,0,0,,!بروفيسور
Dialogue: 0,0:32:45.00,0:32:45.81,Default,,0,0,0,,!هاه
Dialogue: 0,0:32:46.30,0:32:48.18,Default,,0,0,0,,!لَقد أفزعتها
Dialogue: 0,0:32:48.18,0:32:49.81,Default,,0,0,0,,أين هُم، بروفيسور؟
Dialogue: 0,0:32:50.18,0:32:51.58,Default,,0,0,0,,أين ذهب الأطفال؟
Dialogue: 0,0:32:52.25,0:32:53.58,Default,,0,0,0,,همم... ماذا؟
Dialogue: 0,0:32:54.43,0:32:56.03,Default,,0,0,0,,!أه، إنّه كونان
Dialogue: 0,0:32:56.10,0:32:58.03,Default,,0,0,0,,...لا تُجب، تعلَم ماذا
Dialogue: 0,0:32:58.08,0:32:59.98,Default,,0,0,0,,!سيُوَبّخنا إن فعلنا
Dialogue: 0,0:33:00.18,0:33:00.98,Default,,0,0,0,,!هذا صحيح
Dialogue: 0,0:33:01.18,0:33:04.45,Default,,0,0,0,,!أوه، أُنظروا! نحن نرتفع
Dialogue: 0,0:33:05.10,0:33:06.00,Default,,0,0,0,,!بالفِعل
Dialogue: 0,0:33:06.15,0:33:07.50,Default,,0,0,0,,هل ترين هذا، أيّتها الآنسة؟
Dialogue: 0,0:33:07.55,0:33:09.05,Default,,0,0,0,,!هذا جميلٌ جدّاً
Dialogue: 0,0:33:09.20,0:33:11.20,Default,,0,0,0,,...لا يُمكن إجراء هذا الإتّصال
Dialogue: 0,0:33:11.21,0:33:12.45,Default,,0,0,0,,...اللّعنة، أولئكَ الحمقى
Dialogue: 0,0:33:12.45,0:33:13.75,Default,,0,0,0,,.لنَهدأ و نُفكّر
Dialogue: 0,0:33:14.21,0:33:16.25,Default,,0,0,0,,ماذا كانوا يُحاولون أن يفعلوا؟
Dialogue: 0,0:33:16.41,0:33:17.60,Default,,0,0,0,,!نعم، لنَذهب
Dialogue: 0,0:33:17.90,0:33:20.10,Default,,0,0,0,,!إنتظراني
Dialogue: 0,0:33:21.45,0:33:25.50,Default,,0,0,0,,لابدّ من أنّكِ تُمارسين بعض الرّياضات الخطِرة، صحيح؟
Dialogue: 0,0:33:25.60,0:33:26.30,Default,,0,0,0,,إيه؟
Dialogue: 0,0:33:26.45,0:33:30.30,Default,,0,0,0,,!بالفِعل، برُؤية كيف أنقذتِ غينتا، و رشاقتكِ لا مثيل لها
Dialogue: 0,0:33:30.31,0:33:33.65,Default,,0,0,0,,!صحيح، لَديكِ أُسلوبكِ الخاصّ
Dialogue: 0,0:33:33.68,0:33:34.58,Default,,0,0,0,,أُسلوب؟
Dialogue: 0,0:33:35.40,0:33:36.78,Default,,0,0,0,,حقّاً؟
Dialogue: 0,0:33:36.95,0:33:37.65,Default,,0,0,0,,!نعم
Dialogue: 0,0:33:37.78,0:33:39.45,Default,,0,0,0,,!طريقتكِ مُميّزة
Dialogue: 0,0:33:40.35,0:33:42.78,Default,,0,0,0,,!يُمكننا رُؤية سطح حوض الأسماك
Dialogue: 0,0:33:43.08,0:33:44.88,Default,,0,0,0,,!إنّه جميل
Dialogue: 0,0:33:44.91,0:33:46.25,Default,,0,0,0,,!رائعٌ جدّاً
Dialogue: 0,0:33:46.35,0:33:47.61,Default,,0,0,0,,ألا ترين؟
Dialogue: 0,0:33:47.65,0:33:49.31,Default,,0,0,0,,!نعم، إنّه جميل
Dialogue: 0,0:33:50.31,0:33:53.98,Default,,0,0,0,,!أوه، أُنظر إلى هناك، على الألوان، هناك الكثير منها
Dialogue: 0,0:33:54.01,0:33:55.91,Default,,0,0,0,,!تعالي، أيّتها الآنسة، إقتربي أكثر
Dialogue: 0,0:33:56.00,0:33:57.35,Default,,0,0,0,,.إيه؟ حسناً
Dialogue: 0,0:34:06.31,0:34:07.68,Default,,0,0,0,,هل أنتِ بخير؟
Dialogue: 0,0:34:07.88,0:34:09.08,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,0:34:09.15,0:34:11.90,Default,,0,0,0,,!أوه، لا بأس، أشعر بالدّوار فقط
Dialogue: 0,0:34:11.95,0:34:15.30,Default,,0,0,0,,!بالفِعل، إرتفعنا كثيراً
Dialogue: 0,0:34:16.41,0:34:19.60,Default,,0,0,0,,!واه، القليل فقط و سنصل إلى القِمّة
Dialogue: 0,0:34:19.70,0:34:20.66,Default,,0,0,0,,!بالفِعل
Dialogue: 0,0:34:21.50,0:34:23.58,Default,,0,0,0,,!هناك نافورة
Dialogue: 0,0:34:23.58,0:34:25.88,Default,,0,0,0,,!أوه، نافثات مياه
Dialogue: 0,0:34:27.18,0:34:29.00,Default,,0,0,0,,!هذا مُدهش
Dialogue: 0,0:34:34.25,0:34:36.05,Default,,0,0,0,,هل أنتِ بخير، أيّتها الآنسة؟
Dialogue: 0,0:34:36.05,0:34:36.78,Default,,0,0,0,,!هاي
Dialogue: 0,0:34:36.85,0:34:38.31,Default,,0,0,0,,!تماسكي
Dialogue: 0,0:34:38.59,0:34:39.31,Default,,0,0,0,,ماذا نفعل؟
Dialogue: 0,0:34:39.36,0:34:41.90,Default,,0,0,0,,.إنتظري، سنتّصل بكونان
Dialogue: 0,0:34:41.93,0:34:43.50,Default,,0,0,0,,!أيومي، ميتسوهيكو
Dialogue: 0,0:34:43.85,0:34:46.78,Default,,0,0,0,,!لا يبدو بأنّ هذه الآنسة بخير
Dialogue: 0,0:34:46.93,0:34:49.00,Default,,0,0,0,,هل تذكر شيئاً رُبّما؟
Dialogue: 0,0:34:49.60,0:34:52.70,Default,,0,0,0,,!أيومي، إتّصلي بكونان بسرعة
Dialogue: 0,0:34:52.70,0:34:53.40,Default,,0,0,0,,!حسناً
Dialogue: 0,0:34:53.40,0:34:55.53,Default,,0,0,0,,غينتا، ماذا تقول الآنسة؟
Dialogue: 0,0:34:56.45,0:34:58.20,Default,,0,0,0,,!تقول أشياءً غريبة
Dialogue: 0,0:34:58.28,0:34:59.18,Default,,0,0,0,,مثل ماذا؟
Dialogue: 0,0:34:59.18,0:34:59.74,Default,,0,0,0,,...كير
Dialogue: 0,0:34:59.85,0:35:00.98,Default,,0,0,0,,...بوربون
Dialogue: 0,0:35:01.45,0:35:03.28,Default,,0,0,0,,!إنّها تفعلها ثانيةً
Dialogue: 0,0:35:03.38,0:35:05.81,Default,,0,0,0,,!أُسكت، غينتا
Dialogue: 0,0:35:05.48,0:35:07.51,up,,0,0,0,,...ستاوت... أكوافيت
Dialogue: 0,0:35:07.71,0:35:08.95,Default,,0,0,0,,!ريسلينغ
Dialogue: 0,0:35:11.11,0:35:13.38,Default,,0,0,0,,...أرجوك، رُدّ بسرعة
Dialogue: 0,0:35:14.58,0:35:15.38,Default,,0,0,0,,!...أه، أخيراً
Dialogue: 0,0:35:17.88,0:35:18.88,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:35:18.98,0:35:22.18,Default,,0,0,0,,...إنّه الهاتف، كنتُ مُتأكّداً
Dialogue: 0,0:35:23.11,0:35:24.58,Default,,0,0,0,,!...ميتسوهيكو، أخيراً
Dialogue: 0,0:35:24.88,0:35:26.35,Default,,0,0,0,,!كونان، ساعدنا
Dialogue: 0,0:35:26.75,0:35:28.21,Default,,0,0,0,,أيومي، ماذا يحصل؟
Dialogue: 0,0:35:28.25,0:35:32.25,Default,,0,0,0,,!لا أعرف، الآنسة تُعاني من أزمة
Dialogue: 0,0:35:32.35,0:35:34.38,Default,,0,0,0,,ماذا تعنين؟\Nما الذي تفعله؟
Dialogue: 0,0:35:34.95,0:35:39.55,Default,,0,0,0,,!حسناً، يُؤلمها رأسها، و تقول بعض الأُمور الغريبة
Dialogue: 0,0:35:39.55,0:35:40.91,Default,,0,0,0,,!لا أفهمها
Dialogue: 0,0:35:40.91,0:35:42.15,Default,,0,0,0,,!دوّنتُ الكلمات
Dialogue: 0,0:35:42.38,0:35:44.78,Default,,0,0,0,,!قام ميتسوهيكو بتدوينها
Dialogue: 0,0:35:44.78,0:35:45.31,Default,,0,0,0,,.فهمت
Dialogue: 0,0:35:45.78,0:35:48.78,Default,,0,0,0,,!كونان، أرجوك، تعال لمُساعدتنا بسرعة
Dialogue: 0,0:35:55.38,0:35:57.68,Default,,0,0,0,,كونان، أين تلك الشّابّة؟
Dialogue: 0,0:35:58.01,0:36:00.31,Default,,0,0,0,,!في المُستوصف الآن
Dialogue: 0,0:36:00.45,0:36:02.25,Default,,0,0,0,,!تاكاغي، لنَذهب
Dialogue: 0,0:36:02.41,0:36:02.85,Default,,0,0,0,,.حسناً
Dialogue: 0,0:36:02.88,0:36:05.51,Default,,0,0,0,,!هايبارا، بروفيسور، أعتمد عليكما
Dialogue: 0,0:36:05.71,0:36:07.28,Default,,0,0,0,,!حسناً، لنتبعه
Dialogue: 0,0:36:07.28,0:36:09.81,Default,,0,0,0,,!كلّا، لا تُفكّروا بالأمر حتّى
Dialogue: 0,0:36:19.98,0:36:20.88,Default,,0,0,0,,!عُذراً
Dialogue: 0,0:36:21.38,0:36:22.78,Default,,0,0,0,,!أه، تفضّلا رجاءً
Dialogue: 0,0:36:23.38,0:36:28.95,Default,,0,0,0,,كجرءٍ من تحقيق، هل يُمكنكَ أن تُقدّم لنا بعض المعلومات عن المرأة؟
Dialogue: 0,0:36:29.31,0:36:30.91,Default,,0,0,0,,!حسناً، لا أُمانع
Dialogue: 0,0:36:31.01,0:36:36.11,Default,,0,0,0,,!تمّ نقلها للتّوّ إلى مَشفى الشّرطة، لكنّنا لا نعلَم عنها أيّ شيء
Dialogue: 0,0:36:36.78,0:36:42.65,Default,,0,0,0,,.يُمكنني تأكيد بأنّها قد فقدَت ذاكرتها بسبب إصابةٍ دماغيّة
Dialogue: 0,0:36:42.98,0:36:50.41,Default,,0,0,0,,.إضافةً إلى هذا... وَجدنا إصاباتٍ مُميّزةً بالفِعل في دماغها
Dialogue: 0,0:36:50.71,0:36:52.98,Default,,0,0,0,,هل يُمكن أنّها بسبب حادث سيّارة؟
Dialogue: 0,0:36:53.21,0:36:56.48,Default,,0,0,0,,!نعم، يبدو بأنّ الإصابات الدّماغيّة تتوَافق مع هذا
Dialogue: 0,0:36:56.58,0:36:59.10,Default,,0,0,0,,لابدّ من أنّ سيّارتها كانت سريعةً جدّاً لتحصل على هذا الجّرح البليغ، صحيح؟
Dialogue: 0,0:36:59.11,0:37:04.08,Default,,0,0,0,,.نعم، مثل هذه الإصابة تشرح أمر فقدان الذّاكرة بالكامل
Dialogue: 0,0:37:04.08,0:37:06.50,Default,,0,0,0,,.حسناً، شُكراً على مُساعدتك
Dialogue: 0,0:37:06.95,0:37:08.51,Default,,0,0,0,,...إذاً-\N...أه، إنتظروا-
Dialogue: 0,0:37:08.85,0:37:10.35,Default,,0,0,0,,.هنالك أمرٌ آخر
Dialogue: 0,0:37:10.85,0:37:15.48,Default,,0,0,0,,.وجدنا عدسةً في عينها اليُمنى
Dialogue: 0,0:37:15.81,0:37:17.31,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:37:17.68,0:37:19.18,Default,,0,0,0,,هل هي مادّةٌ زُجاجيّة؟
Dialogue: 0,0:37:19.28,0:37:24.21,Default,,0,0,0,,.نعم، إنّها عدسة عينٍ ارتدتها على عينها
Dialogue: 0,0:37:25.15,0:37:30.15,Default,,0,0,0,,.إذاً عندما كانت معنا، كان هدفها الإعتناء بنا
Dialogue: 0,0:37:30.35,0:37:33.20,Default,,0,0,0,,.من الأفضل إزالتها لمصلحتها
Dialogue: 0,0:37:34.21,0:37:38.55,Default,,0,0,0,,.عُذراً، أتيتُ للبحث عن المريضة
Dialogue: 0,0:37:38.58,0:37:40.05,Default,,0,0,0,,!حسناً إذاً، سنعتني بهذا الأمر
Dialogue: 0,0:37:40.45,0:37:41.00,Default,,0,0,0,,!حسناً
Dialogue: 0,0:37:41.58,0:37:42.98,Default,,0,0,0,,.شُكراً جزيلاً
Dialogue: 0,0:37:45.11,0:37:48.58,Default,,0,0,0,,أنت، ألَن تغادر معهم؟
Dialogue: 0,0:37:48.70,0:37:49.41,Default,,0,0,0,,!كلّا
Dialogue: 0,0:37:49.41,0:37:52.15,Default,,0,0,0,,!لَديّ سؤالٌ إضافيٌّ لك
Dialogue: 0,0:37:52.61,0:37:53.41,Default,,0,0,0,,ما هو؟
Dialogue: 0,0:37:53.41,0:37:58.70,Default,,0,0,0,,.إنّها العدسة اليُمنى، ظننّاها كانت تملك جدار عينين
Dialogue: 0,0:37:58.70,0:38:01.98,Default,,0,0,0,,إذاً، عيناها زرقاوتان في الوَاقع؟
Dialogue: 0,0:38:02.28,0:38:04.98,Default,,0,0,0,,.نعم، إنّها عدسةٌ بلون الكروم
Dialogue: 0,0:38:05.48,0:38:06.41,Default,,0,0,0,,بلون الكروم؟
Dialogue: 0,0:38:06.51,0:38:10.08,Default,,0,0,0,,.نعم، إنّها عمَليّةٌ جدّاً
Dialogue: 0,0:38:10.25,0:38:17.08,Default,,0,0,0,,{\move(58.832,245.14,155.357,247.121,13,6819)}{\fad(100,100)\c&H000000&\3c&HFFFFFF&}القرنيّة
Dialogue: 0,0:38:10.25,0:38:17.08,Default,,0,0,0,,{\move(478.171,230.903,574.787,232.878,13,6819)}{\fad(100,100)\c&H000000&\3c&HFFFFFF&}صلبة العين
Dialogue: 0,0:38:10.51,0:38:16.55,Default,,0,0,0,,.بوَضعها على القرنيّة، تُغيّر لونها لتُماثل شبكة العين عبر الصّلبة
Dialogue: 0,0:38:16.81,0:38:18.85,Default,,0,0,0,,.يُمكنكَ شراؤها بأيّ لَونٍ ترغب به
Dialogue: 0,0:38:19.31,0:38:25.00,Default,,0,0,0,,لكن إذاً، ماذا يُمكن أن يكون هدفها من وَضعها؟
Dialogue: 0,0:38:25.11,0:38:29.40,Default,,0,0,0,,!أيّها الطّبيب، شُكراً على المعلومات
Dialogue: 0,0:38:29.45,0:38:30.66,Default,,0,0,0,,هذا يكفيك؟
Dialogue: 0,0:38:30.66,0:38:31.25,Default,,0,0,0,,!نعم
Dialogue: 0,0:38:31.81,0:38:32.88,Default,,0,0,0,,!وَداعاً
Dialogue: 0,0:38:32.88,0:38:34.68,Default,,0,0,0,,!حسناً، إعتني بنفسك
Dialogue: 0,0:38:34.68,0:38:35.88,Default,,0,0,0,,!أنا هُنا
Dialogue: 0,0:38:36.08,0:38:38.58,Default,,0,0,0,,أين العميلة التي يُفترض بي مُساعدتها؟
Dialogue: 0,0:38:39.38,0:38:42.65,Default,,0,0,0,,!لَديّ أوامر بعدم السّماح لأحدٍ بالدّخول
Dialogue: 0,0:38:42.71,0:38:46.81,Default,,0,0,0,,!أنا المسؤول عن هذه القضيّة
Dialogue: 0,0:38:46.85,0:38:48.08,Default,,0,0,0,,!عمّي
Dialogue: 0,0:38:49.05,0:38:50.61,Default,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:38:50.61,0:38:52.45,Default,,0,0,0,,!أيّها الشّقيّ، توقيتٌ مِثاليّ
Dialogue: 0,0:38:52.65,0:38:55.78,Default,,0,0,0,,إذاً، أين تلك الجّميلة؟
Dialogue: 0,0:38:55.85,0:38:57.45,Default,,0,0,0,,.لَم تعُد هُنا
Dialogue: 0,0:38:58.11,0:39:01.28,Default,,0,0,0,,.تمّ نقلها إلى مَشفى الشّرطة
Dialogue: 0,0:39:01.48,0:39:04.28,Default,,0,0,0,,.إضافةً إلى هذا، لَن تُساعدها هكذا
Dialogue: 0,0:39:04.31,0:39:05.18,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:39:05.28,0:39:07.98,Default,,0,0,0,,.لَم تُنصت لنصيحة ران إذاً
Dialogue: 0,0:39:09.08,0:39:11.28,Default,,0,0,0,,أمازال لَديكَ ما تُريد فِعله؟
Dialogue: 0,0:39:11.51,0:39:13.15,Default,,0,0,0,,...كلّا
Dialogue: 0,0:39:20.25,0:39:21.45,Default,,0,0,0,,ماذا أصابها؟
Dialogue: 0,0:39:21.65,0:39:22.65,Default,,0,0,0,,كيف لي أن أعلَم؟
Dialogue: 0,0:39:23.31,0:39:27.95,Default,,0,0,0,,.كان هناك خطبٌ ما بالفِعل... فُقدان ذاكرة
Dialogue: 0,0:39:28.08,0:39:30.45,Default,,0,0,0,,إذاً؟ أين هي؟
Dialogue: 0,0:39:30.95,0:39:32.65,Default,,0,0,0,,.مَشفى الشّرطة
Dialogue: 0,0:39:33.41,0:39:35.78,Default,,0,0,0,,.لا يُفترض أن تحرسها الشّرطة
Dialogue: 0,0:39:36.45,0:39:39.41,Default,,0,0,0,,أه، ألا يُثير شيءٌ فُضولكَ بشأن كلّ هذا؟
Dialogue: 0,0:39:39.51,0:39:40.08,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:39:40.58,0:39:44.98,Default,,0,0,0,,.بينما كانت تتحرّى بأمر الجّواسيس في المرّة الأخيرة، نَجَحَت
Dialogue: 0,0:39:45.15,0:39:46.08,Default,,0,0,0,,جواسيس؟
Dialogue: 0,0:39:46.21,0:39:46.81,Default,,0,0,0,,.نعم
Dialogue: 0,0:39:47.01,0:39:50.31,Default,,0,0,0,,.فهمت، إعتني بأمر البُنية التّحتيّة لمُنشأة سوزوكي
Dialogue: 0,0:39:50.51,0:39:51.58,Default,,0,0,0,,.عُلِم
Dialogue: 0,0:39:52.58,0:39:55.41,Default,,0,0,0,,...لائحة الجّواسيس... هل هذا مُمكن
Dialogue: 0,0:39:57.05,0:40:00.51,Default,,0,0,0,,لماذا تظنّون بأنّ هايبارا قد غضبَت؟ ما رأيكما؟
Dialogue: 0,0:40:00.65,0:40:04.15,Default,,0,0,0,,.بالفِعل، هذا نادر
Dialogue: 0,0:40:04.71,0:40:07.28,Default,,0,0,0,,هل تعلَم إن كانت لاتزال غاضبة؟
Dialogue: 0,0:40:07.48,0:40:09.35,Default,,0,0,0,,...حسناً
Dialogue: 0,0:40:09.35,0:40:13.48,Default,,0,0,0,,.تمّ نقلها و سيتمّ إجراء الفُحوص عليها
Dialogue: 0,0:40:13.68,0:40:16.68,Default,,0,0,0,,.لا تُضيّعي وَقتكِ، أيومي، لا يستمع لكِ
Dialogue: 0,0:40:16.88,0:40:20.98,Default,,0,0,0,,.نعم، لكن البروفيسور لا يغضب أبداً
Dialogue: 0,0:40:21.05,0:40:22.08,Default,,0,0,0,,.بالفِعل
Dialogue: 0,0:40:23.75,0:40:27.31,Default,,0,0,0,,.أه، بالمُناسبة، خُذوا هذه، إنّها من كونان
Dialogue: 0,0:40:27.65,0:40:29.61,Default,,0,0,0,,...أوه، هذه
Dialogue: 0,0:40:29.61,0:40:32.75,Default,,0,0,0,,!نفس التّمثال الصّغير الذي حصلنا عليه
Dialogue: 0,0:40:33.35,0:40:35.95,Default,,0,0,0,,لكن لماذا لا يملك لوناً؟
Dialogue: 0,0:40:36.41,0:40:40.08,Default,,0,0,0,,.أخبرَني كونان، لكنّني نسيت
Dialogue: 0,0:40:40.45,0:40:43.51,Default,,0,0,0,,.يالها من مضيعةٍ للوَقت، سأسأله
Dialogue: 0,0:40:44.48,0:40:45.28,Default,,0,0,0,,من يكون؟
Dialogue: 0,0:40:46.61,0:40:48.58,Default,,0,0,0,,!أوه، إنّه كونان
Dialogue: 0,0:40:49.68,0:40:50.58,Default,,0,0,0,,مرحباً؟
Dialogue: 0,0:40:50.95,0:40:53.38,Default,,0,0,0,,بروفيسور، مازال الأطفال معك، صحيح؟
Dialogue: 0,0:40:53.51,0:40:56.45,Default,,0,0,0,,.نعم، نأكل في مقهى بويروت
Dialogue: 0,0:40:57.05,0:40:59.25,Default,,0,0,0,,.أُريد أن أطلب منكَ معروفاً
Dialogue: 0,0:40:59.65,0:41:02.28,Default,,0,0,0,,حسناً، كيف حال الآنسة؟
Dialogue: 0,0:41:03.71,0:41:06.38,Default,,0,0,0,,.تُريد الشّرطة التّحقيق معها، تمّ نقلها إلى مَشفاهم
Dialogue: 0,0:41:07.15,0:41:08.28,Default,,0,0,0,,!لكنّها بخير
Dialogue: 0,0:41:08.58,0:41:09.41,Default,,0,0,0,,!حمداً لله
Dialogue: 0,0:41:09.48,0:41:12.30,Default,,0,0,0,,و ماذا تُريد أن تطلب منّي؟
Dialogue: 0,0:41:12.41,0:41:16.20,Default,,0,0,0,,.حصلتُ على هاتفها، أرغب منكَ استخراج البيانات منه
Dialogue: 0,0:41:16.65,0:41:20.98,Default,,0,0,0,,.لا يُمكنني إن كان مُتضرّراً جدّاً، لكنّني سأُحاول
Dialogue: 0,0:41:22.08,0:41:27.20,Default,,0,0,0,,.شُكراً، أُريد أيضاً معرفة ما قالته عندما كانت في دُولاب فيريس
Dialogue: 0,0:41:27.55,0:41:29.01,Default,,0,0,0,,هل يُمكنكم إخباري؟
Dialogue: 0,0:41:29.11,0:41:33.55,Default,,0,0,0,,.نعم، دوّنتُ كلّ شيءٍ على وَرقة، إنتظر دقيقة
Dialogue: 0,0:41:33.81,0:41:40.78,Default,,0,0,0,,.إذاً... ستاوت... أكوافيت... و أخيراً، ريسلينغ
Dialogue: 0,0:41:42.15,0:41:44.71,Default,,0,0,0,,...مشروباتٌ كحوليّة؟ هل من المُمكن أن
Dialogue: 0,0:41:44.91,0:41:47.18,Default,,0,0,0,,بروفيسور، أنتُم في بويروت، صحيح؟
Dialogue: 0,0:41:47.78,0:41:49.20,Default,,0,0,0,,!بالفِعل
Dialogue: 0,0:41:49.20,0:41:51.13,Default,,0,0,0,,!أخبر أمورو بالقدوم
Dialogue: 0,0:41:52.11,0:41:53.28,Default,,0,0,0,,أمورو؟
Dialogue: 0,0:41:53.63,0:41:56.03,Default,,0,0,0,,.لا أظنّه هُنا اليوم
Dialogue: 0,0:41:56.25,0:41:58.68,Default,,0,0,0,,.لقد أخذ اليوم إجازة
Dialogue: 0,0:42:00.10,0:42:04.20,Default,,0,0,0,,.خرج فجأةً عندما اتّصلَت الشّرطة
Dialogue: 0,0:42:04.55,0:42:07.95,Default,,0,0,0,,.كان الأمر غريباً، كان قلِقاً
Dialogue: 0,0:42:09.15,0:42:10.25,Default,,0,0,0,,.كما سمعت
Dialogue: 0,0:42:11.10,0:42:13.96,Default,,0,0,0,,.سأتّصل بكَ إن ظهَر
Dialogue: 0,0:42:16.13,0:42:18.30,Default,,0,0,0,,...أوه، لا... أمورو
Dialogue: 0,0:42:23.22,0:42:26.81,Title - 1,,0,0,0,,{\fad(300,000)\pos(645.667,507.333)}لندن
Dialogue: 0,0:42:35.30,0:42:37.70,up,,0,0,0,,.هذا ستاوت. أنا على متن الباص
Dialogue: 0,0:42:37.70,0:42:40.06,up,,0,0,0,,.إنتظر التّعليمات
Dialogue: 0,0:42:40.06,0:42:41.30,up,,0,0,0,,.عُلِم
Dialogue: 0,0:42:51.06,0:42:52.26,Default,,0,0,0,,...ستاوت
Dialogue: 0,0:42:53.03,0:42:56.53,Default,,0,0,0,,.كنتُ أثق بك. هذا مُؤسف
Dialogue: 0,0:42:58.56,0:43:00.53,Default,,0,0,0,,.تمّ القضاء على ستاوت
Dialogue: 0,0:43:00.53,0:43:02.23,Default,,0,0,0,,.حسناً، أسرع بالعودة
Dialogue: 0,0:43:02.33,0:43:03.23,Default,,0,0,0,,.عُلِم
Dialogue: 0,0:43:06.18,0:43:09.10,Title - 1,,0,0,0,,{\fad(300,000)\pos(642,502.333)}تورونتو
Dialogue: 0,0:43:10.38,0:43:15.48,up,,0,0,0,,!كان بُرج الـ"سي إن" الأعلى في العالَم لـ32 عاماً
Dialogue: 0,0:43:15.71,0:43:21.75,up,,0,0,0,,.يُمكننا السّير حوله من الطّابق الـ116 للبُرج
Dialogue: 0,0:43:21.81,0:43:25.75,up,,0,0,0,,!و هو على ارتفاع 356 متراً عن الأرض
Dialogue: 0,0:43:26.65,0:43:27.78,up,,0,0,0,,...هذه الأيّام
Dialogue: 0,0:43:27.75,0:43:29.46,Default,,0,0,0,,{\c&H2DC7D6&\pos(635,611.667)}...أُنظر إلى تلك المِروحيّة
Dialogue: 0,0:43:30.98,0:43:33.11,up,,0,0,0,,...تلك المِروحيّة... كلّا... هذا مُستحيل
Dialogue: 0,0:43:48.25,0:43:52.11,Default,,0,0,0,,!أعتذر، لا نُحبّ الجّواسيس هُنا
Dialogue: 0,0:43:52.98,0:43:55.28,Default,,0,0,0,,.تمّ القضاء على أكوافيت
Dialogue: 0,0:43:55.38,0:43:57.31,Default,,0,0,0,,!إستلَمت، يُمكنكِ العودة الآن
Dialogue: 0,0:43:58.01,0:44:00.35,Default,,0,0,0,,!لا حاجة لإخباري بهذا
Dialogue: 0,0:44:01.71,0:44:04.01,Title - 1,,0,0,0,,{\fad(300,000)\pos(636.667,502)}برلين
Dialogue: 0,0:44:09.18,0:44:11.35,Default,,0,0,0,,إلى أين تظنّين نفسكِ ذاهبة؟
Dialogue: 0,0:44:11.98,0:44:14.80,Default,,0,0,0,,.لَديكِ دقيقةٌ لتفسير نفسك
Dialogue: 0,0:44:14.88,0:44:17.71,Default,,0,0,0,,!أخبرتك، لَستُ جاسوسة
Dialogue: 0,0:44:17.71,0:44:20.55,Default,,0,0,0,,.توَقّفي عن العبث. يُمكننا اشتمام رائحة جاسوس
Dialogue: 0,0:44:24.45,0:44:26.61,Default,,0,0,0,,!هيه، ريسلينغ
Dialogue: 0,0:44:27.70,0:44:28.31,Default,,0,0,0,,!جين
Dialogue: 0,0:44:28.96,0:44:33.10,Default,,0,0,0,,.حصلنا على معلوماتٍ عنكِ مُؤخّراً
Dialogue: 0,0:44:34.46,0:44:38.76,Default,,0,0,0,,.إسمكِ على لائحة الجّواسيس لَدينا
Dialogue: 0,0:44:40.03,0:44:42.95,Default,,0,0,0,,.لنَفعلها الآن، نحن نُضيّع الوَقت
Dialogue: 0,0:44:43.30,0:44:46.00,Default,,0,0,0,,.أُتركاني أذهب، أُخبركما بأنّني لَستُ إحداهم
Dialogue: 0,0:44:46.18,0:44:48.20,Default,,0,0,0,,!يُمكنكَ الثّقة بي، جين
Dialogue: 0,0:44:48.60,0:44:52.75,Default,,0,0,0,,.أثق بكِ؟ لَستُ بالغباء الكافي لفِعل شيءٍ كهذا
Dialogue: 0,0:44:53.75,0:44:54.48,Default,,0,0,0,,...5
Dialogue: 0,0:44:55.65,0:44:56.48,Default,,0,0,0,,...4
Dialogue: 0,0:44:57.55,0:44:58.31,Default,,0,0,0,,...3
Dialogue: 0,0:44:59.15,0:45:00.18,Default,,0,0,0,,...2
Dialogue: 0,0:45:01.08,0:45:01.70,Default,,0,0,0,,...1
Dialogue: 0,0:45:02.86,0:45:03.65,Default,,0,0,0,,!0
Dialogue: 0,0:45:22.23,0:45:23.90,Default,,0,0,0,,!لنَذهب، بسرعة
Dialogue: 0,0:45:24.73,0:45:25.80,Default,,0,0,0,,إلى أين؟
Dialogue: 0,0:45:25.90,0:45:26.66,Default,,0,0,0,,.اليابان
Dialogue: 0,0:45:27.23,0:45:28.16,Default,,0,0,0,,...لا تُخبرني بأنّكَ
Dialogue: 0,0:45:29.03,0:45:30.73,Default,,0,0,0,,.بقيَ إثنان فقط
Dialogue: 0,0:45:38.01,0:45:39.91,Default,,0,0,0,,،الإستخبارات البريطانيّة
Dialogue: 0,0:45:40.10,0:45:42.10,Default,,0,0,0,,،و الإستخبارات الكنديّة
Dialogue: 0,0:45:42.40,0:45:43.95,Default,,0,0,0,,!و أيضاً الإستخبارات الألمانيّة
Dialogue: 0,0:45:44.03,0:45:47.30,Default,,0,0,0,,.تمّ تأكيد أمر اغتيال جواسيسهم
Dialogue: 0,0:45:47.65,0:45:48.50,Default,,0,0,0,,...هل من المُمكن
Dialogue: 0,0:45:48.50,0:45:49.18,Default,,0,0,0,,!نعم
Dialogue: 0,0:45:49.35,0:45:53.30,Default,,0,0,0,,.حصلَت المُنظّمة على لائحة الجّواسيس، و اعتنوا بأمرهم
Dialogue: 0,0:45:53.45,0:45:55.95,Default,,0,0,0,,...لكن بهذه الحال، المُنظّمة
Dialogue: 0,0:45:56.11,0:46:01.41,Default,,0,0,0,,.نعم، لابدّ من أنّهم قد عرفوا عن هذا بفضل لائحة الجّواسيس
Dialogue: 0,0:46:01.61,0:46:03.50,Default,,0,0,0,,.علينا إبلاغ أكاي
Dialogue: 0,0:46:04.56,0:46:06.20,Default,,0,0,0,,...تملك المُنظّمة المعلومات
Dialogue: 0,0:46:07.31,0:46:08.51,Default,,0,0,0,,!جودي سينساي
Dialogue: 0,0:46:08.55,0:46:13.48,Default,,0,0,0,,لَم تتوَصّلوا بعد لهويّة مُفتعل التّكدّس، صحيح؟
Dialogue: 0,0:46:13.90,0:46:14.53,Default,,0,0,0,,!بالفِعل
Dialogue: 0,0:46:14.88,0:46:15.85,Default,,0,0,0,,!كنتُ مُحقّاً
Dialogue: 0,0:46:16.03,0:46:18.13,Default,,0,0,0,,.تلك المرأة قد فقدَت ذاكرتها
Dialogue: 0,0:46:18.33,0:46:20.90,Default,,0,0,0,,!لكن كيف ستتصرّف حالَما تستعيدها؟
Dialogue: 0,0:46:21.23,0:46:24.43,Default,,0,0,0,,!لابدّ من أنّ هاتفها يحوي بعض البيانات المُهمّة
Dialogue: 0,0:46:24.75,0:46:28.10,Default,,0,0,0,,!نعم، تضرّره لَيس كبيراً، يُمكننا دُخولها
Dialogue: 0,0:46:28.23,0:46:31.66,Default,,0,0,0,,.من الأفضل إعطاؤه للإف بي آي إذاً
Dialogue: 0,0:46:32.10,0:46:32.75,Default,,0,0,0,,!بالفِعل
Dialogue: 0,0:46:32.85,0:46:33.60,Default,,0,0,0,,!إنتظروا
Dialogue: 0,0:46:34.00,0:46:38.73,Default,,0,0,0,,.سيكون أسرع و أكثر أماناً إعطاؤه للبروفيسور
Dialogue: 0,0:46:39.51,0:46:42.08,Default,,0,0,0,,.حسناً، لنَفعل هذا
Dialogue: 0,0:46:42.41,0:46:46.61,Default,,0,0,0,,...إن استعادت ذاكرتها و حاولَت الإتّصال بهم
Dialogue: 0,0:46:46.90,0:46:48.90,Default,,0,0,0,,!سيقع العالم في فوضى عارمة
Dialogue: 0,0:46:49.91,0:46:51.98,Default,,0,0,0,,لكن ما البيانات التي سرَقتها؟
Dialogue: 0,0:46:52.15,0:46:53.90,Default,,0,0,0,,!العُملاء المُتخفّون الغير رسميّين
Dialogue: 0,0:46:54.75,0:46:55.58,Default,,0,0,0,,!...هذا
Dialogue: 0,0:46:55.93,0:46:57.85,Default,,0,0,0,,.نعم، لائحة الجّواسيس المُتخفّين
Dialogue: 0,0:46:58.00,0:47:01.73,Default,,0,0,0,,.لائحةٌ طويلةٌ بأسماء الجّواسيس المُتغلغلين في المُنظّمة الآن
Dialogue: 0,0:47:01.81,0:47:02.78,Default,,0,0,0,,...إذاً
Dialogue: 0,0:47:03.31,0:47:06.75,Default,,0,0,0,,...إن حصلوا عليها كاملة، سنخسر فُرصتنا
Dialogue: 0,0:47:06.83,0:47:07.96,Default,,0,0,0,,...هذا لَيس كلّ شيء
Dialogue: 0,0:47:08.76,0:47:10.80,Default,,0,0,0,,،إضافةً لكونها لائحةً بالجّواسيس
Dialogue: 0,0:47:10.85,0:47:14.00,Default,,0,0,0,,!تذكر بعض البيانات عن وكالاتهم الأصليّة
Dialogue: 0,0:47:14.06,0:47:14.93,Default,,0,0,0,,...هذا يعني
Dialogue: 0,0:47:15.25,0:47:18.98,Default,,0,0,0,,.سيُواجهون مصاعب أكبر بالإختباء من أعين المُنظّمة، و الهرب من الإغتيال
Dialogue: 0,0:47:19.41,0:47:24.05,Default,,0,0,0,,...بالضبط، حوادث الإغتيال الثّلاثة تلك
Dialogue: 0,0:47:24.38,0:47:26.68,Default,,0,0,0,,!لَم تكن سوى بداية الكابوس
Dialogue: 0,0:47:36.41,0:47:38.08,Default,,0,0,0,,هل سنَذهب حقّاً لزيارتها؟
Dialogue: 0,0:47:38.25,0:47:42.38,Default,,0,0,0,,.من المُؤسف عدم تمكّن كونان و آي من القدوم
Dialogue: 0,0:47:42.41,0:47:46.45,Default,,0,0,0,,!كلّا، سيُخبراننا بألّا نذهب
Dialogue: 0,0:47:46.46,0:47:48.20,Default,,0,0,0,,!هيّا، لنَدخل
Dialogue: 0,0:47:48.40,0:47:50.20,Default,,0,0,0,,!سنُخبرهما بأنّنا لَم نعلَم
Dialogue: 0,0:47:50.20,0:47:50.80,Default,,0,0,0,,!حسناً
Dialogue: 0,0:47:51.35,0:47:51.97,Default,,0,0,0,,!نعم
Dialogue: 0,0:47:52.60,0:47:53.55,Default,,0,0,0,,!حسناً، فهمت
Dialogue: 0,0:47:53.95,0:47:55.46,Default,,0,0,0,,.مَشفى شُرطة توتو
Dialogue: 0,0:47:56.28,0:47:59.85,Default,,0,0,0,,!إن اقترب أحدٌ منها، يُمكنني الإعتماد عليك، كازامي
Dialogue: 0,0:47:59.95,0:48:00.40,Default,,0,0,0,,!عُلِم
Dialogue: 0,0:48:09.18,0:48:11.88,Default,,0,0,0,,بوربون، ماذا تفعل هُنا؟
Dialogue: 0,0:48:12.08,0:48:14.71,Default,,0,0,0,,.هذا وَاضح، أُحاول إيقافها
Dialogue: 0,0:48:15.80,0:48:20.28,Default,,0,0,0,,تقصد، إسكاتها حالما تعود لها قُدرتها على الحديث؟
Dialogue: 0,0:48:20.71,0:48:22.71,Default,,0,0,0,,ماذا تعنين بقولكِ هذا؟
Dialogue: 0,0:48:23.25,0:48:25.35,Default,,0,0,0,,!لا أفهم ما تُحاولين قوله
Dialogue: 0,0:48:25.81,0:48:27.91,Default,,0,0,0,,كيف تُريدني أن أقولها؟
Dialogue: 0,0:48:28.61,0:48:31.98,Default,,0,0,0,,!تملك هذه المرأة بعض المعلومات عنك
Dialogue: 0,0:48:32.31,0:48:35.88,Default,,0,0,0,,!سيكون جيّداً بالنّسبة لكَ إن لَم تكشف عن أيّ شيء
Dialogue: 0,0:48:36.45,0:48:40.00,Default,,0,0,0,,.كعلاقتكَ بمكتب الأمن العام اليابانيّ مثلاً
Dialogue: 0,0:48:40.48,0:48:43.21,Default,,0,0,0,,ما الذي تتحدّثين عنه؟
Dialogue: 0,0:48:43.65,0:48:44.58,Default,,0,0,0,,!إنسى الأمر
Dialogue: 0,0:48:45.20,0:48:47.01,Default,,0,0,0,,.دعنا لا نُهدر المزيد من الوَقت
Dialogue: 0,0:48:47.05,0:48:48.80,Default,,0,0,0,,!سنعود
Dialogue: 0,0:48:49.91,0:48:53.75,Default,,0,0,0,,.إن كانت أوامر المُنظّمة، لا أظنّني أملك خياراً
Dialogue: 0,0:48:58.51,0:48:59.58,Default,,0,0,0,,إذاً؟
Dialogue: 0,0:48:59.61,0:49:02.38,Default,,0,0,0,,...لا فائدة، لا يُمكننا رُؤيتها
Dialogue: 0,0:49:02.38,0:49:03.65,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:49:03.71,0:49:05.88,Default,,0,0,0,,!حالتُها بهذه الخُطورة
Dialogue: 0,0:49:05.88,0:49:08.75,Default,,0,0,0,,!نحتاج لاستخدام طريقةٍ أُخرى
Dialogue: 0,0:49:08.85,0:49:10.58,Default,,0,0,0,,هيه، لكن كيف؟
Dialogue: 0,0:49:10.85,0:49:11.70,Default,,0,0,0,,!هذا
Dialogue: 0,0:49:12.25,0:49:13.25,Default,,0,0,0,,!فهمت
Dialogue: 0,0:49:13.51,0:49:16.08,Default,,0,0,0,,!سأتّصل بأفضل حليفٍ لنا
Dialogue: 0,0:49:23.05,0:49:23.88,Default,,0,0,0,,!بروفيسور
Dialogue: 0,0:49:24.85,0:49:26.00,Default,,0,0,0,,!البيانات
Dialogue: 0,0:49:26.51,0:49:30.58,Default,,0,0,0,,!مازلتُ أُحاول فكّ شيفرة آخر البيانات من القُرص الصّلب
Dialogue: 0,0:49:30.65,0:49:32.08,Default,,0,0,0,,!أسرع، أعتمد عليك
Dialogue: 0,0:49:32.15,0:49:33.21,Default,,0,0,0,,!حسناً
Dialogue: 0,0:49:33.78,0:49:36.45,Default,,0,0,0,,!و... خُذ هذه
Dialogue: 0,0:49:36.45,0:49:38.71,Default,,0,0,0,,.غينتا، لا يُمكنكَ وَضعها هُنا
Dialogue: 0,0:49:38.78,0:49:40.61,Default,,0,0,0,,!أوه، أعتذر
Dialogue: 0,0:49:40.68,0:49:42.25,Default,,0,0,0,,!أه، الضّابط تاكاغي
Dialogue: 0,0:49:42.60,0:49:44.45,Default,,0,0,0,,!لَقد أتيتَ حقّاً
Dialogue: 0,0:49:44.58,0:49:45.48,Default,,0,0,0,,إذاً كيف حال الآنسة؟
Dialogue: 0,0:49:45.48,0:49:46.61,Default,,0,0,0,,هل هي بخير؟
Dialogue: 0,0:49:47.28,0:49:48.61,Default,,0,0,0,,!إخرسوا
Dialogue: 0,0:49:48.68,0:49:50.78,Default,,0,0,0,,أنتُم هُنا بسرّيّة، صحيح؟
Dialogue: 0,0:49:50.85,0:49:52.45,Default,,0,0,0,,مع من تتحدّث؟
Dialogue: 0,0:49:52.91,0:49:55.81,Default,,0,0,0,,...عُذراً، لَم يكن لَديّ خيار
Dialogue: 0,0:49:56.05,0:49:57.31,Default,,0,0,0,,!أيّتها الآنسة
Dialogue: 0,0:49:57.68,0:49:59.58,Default,,0,0,0,,!حمداً لله، أنتِ بخير
Dialogue: 0,0:49:59.61,0:50:01.55,Default,,0,0,0,,أمازال رأسكِ يُؤلمكِ؟
Dialogue: 0,0:50:01.75,0:50:05.11,Default,,0,0,0,,.كلّا، أصبحتُ أفضل بكثيرٍ الآن، شُكراً
Dialogue: 0,0:50:05.31,0:50:08.78,Default,,0,0,0,,.حصلَت على بعض الفُحوصات، لكنّها لَم تستعد ذاكرتها بعد
Dialogue: 0,0:50:08.98,0:50:15.41,Default,,0,0,0,,.يُمكنكم البقاء معها حتّى نعرف أكثر عن حالة ذاكرتها
Dialogue: 0,0:50:15.55,0:50:18.08,Default,,0,0,0,,حقّاً؟-\N!هذا رائع-\N!شُكراً-
Dialogue: 0,0:50:18.25,0:50:21.25,Default,,0,0,0,,!لكن إن حصلَت مُشكلة، إتّصلوا بنا في الحال
Dialogue: 0,0:50:21.55,0:50:22.98,Default,,0,0,0,,!حسناً
Dialogue: 0,0:50:24.45,0:50:25.21,Default,,0,0,0,,!ها نحن ذا
Dialogue: 0,0:50:26.75,0:50:28.88,Default,,0,0,0,,...أين يُمكنني وَضع التّالية
Dialogue: 0,0:50:28.95,0:50:31.48,Default,,0,0,0,,حسناً... هُنا؟
Dialogue: 0,0:50:31.98,0:50:33.15,Default,,0,0,0,,!ها أنا ذا
Dialogue: 0,0:50:34.35,0:50:35.41,Default,,0,0,0,,ما رأيكما؟
Dialogue: 0,0:50:35.75,0:50:37.00,Default,,0,0,0,,ماذا نفعل؟
Dialogue: 0,0:50:37.20,0:50:38.51,Default,,0,0,0,,...هذا مُزعج
Dialogue: 0,0:50:38.68,0:50:40.25,Default,,0,0,0,,!لَقد فعلتُها
Dialogue: 0,0:50:40.28,0:50:41.11,Default,,0,0,0,,!نعم
Dialogue: 0,0:50:41.41,0:50:42.78,Default,,0,0,0,,!تذكّرت
Dialogue: 0,0:50:43.71,0:50:45.88,Default,,0,0,0,,!تفضّلي، هذا لكِ
Dialogue: 0,0:50:46.68,0:50:48.20,Default,,0,0,0,,...لكن هذا
Dialogue: 0,0:50:48.28,0:50:50.98,Default,,0,0,0,,!الرّجل في الكُشك أعطاه لكِ
Dialogue: 0,0:50:51.05,0:50:53.35,Default,,0,0,0,,!إطليه بلونكِ المُفضّل
Dialogue: 0,0:50:53.61,0:50:55.75,Default,,0,0,0,,حقّاً، يُمكنني الإحتفاظ به؟
Dialogue: 0,0:50:55.81,0:50:59.68,Default,,0,0,0,,!بالتّأكيد، لَقد أنقذتِ حياتي بعد كلّ شيء
Dialogue: 0,0:50:59.88,0:51:03.05,Default,,0,0,0,,!أيّتها الآنسة، لَدينا مثله أيضاً
Dialogue: 0,0:51:03.31,0:51:04.35,Default,,0,0,0,,!أُنظري
Dialogue: 0,0:51:04.48,0:51:06.55,Default,,0,0,0,,إذاً، أيّ لونٍ اخترتِ؟
Dialogue: 0,0:51:06.58,0:51:08.00,Default,,0,0,0,,الأحمر، الزّهري؟
Dialogue: 0,0:51:08.00,0:51:10.78,Default,,0,0,0,,!إطليه بالأبيض و الأسود
Dialogue: 0,0:51:10.81,0:51:14.31,Default,,0,0,0,,!بالنّظر إلى أنّ لون شعركِ فِضّيّ، سيكون مِثاليّاً
Dialogue: 0,0:51:14.38,0:51:18.98,Default,,0,0,0,,!رُبّما يكون أكثر مِثاليّةً مع الأسود و بعدها الأبيض، سيتباين مع لَمعان شعرك
Dialogue: 0,0:51:19.21,0:51:21.48,Default,,0,0,0,,.غينتا، هذا غباء
Dialogue: 0,0:51:21.48,0:51:23.70,Default,,0,0,0,,...غباءٌ حقيقيّ
Dialogue: 0,0:51:23.88,0:51:25.85,Default,,0,0,0,,ماذا، ألَيس هذا ذكيّاً؟
Dialogue: 0,0:51:28.40,0:51:30.85,Default,,0,0,0,,!إحذر. هل أنتَ بخير، غينتا
Dialogue: 0,0:51:31.65,0:51:33.50,Default,,0,0,0,,!أوه، أعتذر! أعتذر
Dialogue: 0,0:51:33.58,0:51:34.98,Default,,0,0,0,,هل أنتُم بخير؟
Dialogue: 0,0:51:34.98,0:51:35.98,Default,,0,0,0,,!نعم
Dialogue: 0,0:51:36.91,0:51:39.05,Default,,0,0,0,,!كنتُ أفوز في اللّعبة
Dialogue: 0,0:51:39.05,0:51:41.00,Default,,0,0,0,,!نعم، لكن هذا بفضل الآنسة
Dialogue: 0,0:51:42.00,0:51:45.25,Default,,0,0,0,,!سألتَها دائماً قبل أن تلعب
Dialogue: 0,0:51:45.25,0:51:46.91,Default,,0,0,0,,!رُبّما... هذا صحيح
Dialogue: 0,0:51:48.05,0:51:49.35,Default,,0,0,0,,!عُذراً
Dialogue: 0,0:51:51.38,0:51:53.08,Default,,0,0,0,,.أنا كازامي من مكتب الأمن العام
Dialogue: 0,0:51:53.38,0:51:56.38,Default,,0,0,0,,.طلَب منّي المُفتّش ميغوري القدوم
Dialogue: 0,0:51:57.18,0:51:58.88,Default,,0,0,0,,هل هو أنت؟
Dialogue: 0,0:51:59.21,0:52:01.38,Default,,0,0,0,,!صحيح، إنّه أنا
Dialogue: 0,0:52:01.95,0:52:05.31,Default,,0,0,0,,.إذاً أنتَ من عليّ أن أطلب منه تسليمي تلك المرأة
Dialogue: 0,0:52:05.55,0:52:09.51,Default,,0,0,0,,.لماذا؟ نحن المسؤولون عن هذه القضيّة
Dialogue: 0,0:52:09.81,0:52:13.21,Default,,0,0,0,,.إنّها شاهدةٌ مُهمّةٌ في قضيّةٍ لمكتب الأمن العام
Dialogue: 0,0:52:13.28,0:52:15.91,Default,,0,0,0,,.علينا أخذها بأقصى سرعة
Dialogue: 0,0:52:16.95,0:52:21.75,Default,,0,0,0,,.سأكون مُمتنّاً لكَ إن سلّمتها لنا
Dialogue: 0,0:52:22.51,0:52:25.20,Default,,0,0,0,,.فلتتّخذ القرار الصّحيح
Dialogue: 0,0:52:27.70,0:52:28.55,Default,,0,0,0,,.فهمت
Dialogue: 0,0:52:29.75,0:52:32.71,Default,,0,0,0,,.في تلك الحال، حسناً، إتبعني
Dialogue: 0,0:52:34.81,0:52:37.08,Default,,0,0,0,,إلى أين ستذهبين؟
Dialogue: 0,0:52:37.28,0:52:37.95,Default,,0,0,0,,!من يدري
Dialogue: 0,0:52:38.41,0:52:40.65,Default,,0,0,0,,.ستُغادر الآن، وَدّعوها
Dialogue: 0,0:52:40.81,0:52:42.35,Default,,0,0,0,,.حسناً، حان وَقت العودة
Dialogue: 0,0:52:44.21,0:52:46.01,Default,,0,0,0,,.عليكِ مِلئ استمارة الخروج
Dialogue: 0,0:52:46.48,0:52:47.00,Default,,0,0,0,,!حسناً
Dialogue: 0,0:52:47.18,0:52:48.35,Default,,0,0,0,,!هاه، أيّتها الآنسة
Dialogue: 0,0:52:48.35,0:52:49.65,Default,,0,0,0,,هل ستذهبين حقّاً؟
Dialogue: 0,0:52:49.68,0:52:52.41,Default,,0,0,0,,!كلّا، أيّتها الآنسة
Dialogue: 0,0:52:53.31,0:52:56.91,Default,,0,0,0,,.شُكراً جزيلاً لكم، سأعتني به
Dialogue: 0,0:52:57.68,0:52:58.71,Default,,0,0,0,,!حسناً
Dialogue: 0,0:52:59.21,0:53:02.48,Default,,0,0,0,,في يومٍ ما، سنحصل على جولةٍ أُخرى على دُولاب فيريس الضّخم، صحيح؟
Dialogue: 0,0:53:02.58,0:53:04.68,Default,,0,0,0,,!نعم-\N!بالتّأكيد-\N!سنفعل-
Dialogue: 0,0:53:05.10,0:53:06.85,Default,,0,0,0,,!حسناً، لنَذهب
Dialogue: 0,0:53:13.48,0:53:15.78,Default,,0,0,0,,هل ستكون بخير؟
Dialogue: 0,0:53:15.88,0:53:17.91,Default,,0,0,0,,!أنا قلِقةٌ عليها
Dialogue: 0,0:53:17.91,0:53:18.70,Default,,0,0,0,,...نعم
Dialogue: 0,0:53:21.18,0:53:22.68,Default,,0,0,0,,.أوه، شينتشي
Dialogue: 0,0:53:22.98,0:53:24.41,Default,,0,0,0,,.قُمتُ بفكّ شيفرة البيانات
Dialogue: 0,0:53:24.50,0:53:25.55,Default,,0,0,0,,ماذا وَجدتّ؟
Dialogue: 0,0:53:26.45,0:53:26.85,Default,,0,0,0,,!أُنظر
Dialogue: 0,0:53:27.80,0:53:31.00,Default,,0,0,0,,...ستاوت، أكوافيت، ريسيلينغ
Dialogue: 0,0:53:31.68,0:53:32.78,Default,,0,0,0,,...و الأكثر إثارةً للإهتمام
Dialogue: 0,0:53:33.28,0:53:34.38,Default,,0,0,0,,!بوربون و كير
Dialogue: 0,0:53:34.88,0:53:36.08,Default,,0,0,0,,!عرفتُ هذا
Dialogue: 0,0:53:36.75,0:53:40.31,Default,,0,0,0,,!بروفيسور، تتبّع العنوان الذي تمّ إرسال الرّسالة إليه
Dialogue: 0,0:53:40.71,0:53:42.75,Default,,0,0,0,,!إتّصل بي عندما تنتهي
Dialogue: 0,0:53:48.38,0:53:49.25,Default,,0,0,0,,هايبارا؟
Dialogue: 0,0:53:50.41,0:53:51.11,Default,,0,0,0,,!لا تذهب
Dialogue: 0,0:53:52.15,0:53:52.75,Default,,0,0,0,,!أرجوك
Dialogue: 0,0:53:55.11,0:53:59.61,Default,,0,0,0,,.أخبرتكِ مُسبقاً... بألّا تهربي من قدَرِك
Dialogue: 0,0:54:00.81,0:54:02.61,Default,,0,0,0,,.و أنا أيضاً، لَن أهرب
Dialogue: 0,0:54:12.30,0:54:13.35,Default,,0,0,0,,...كودو
Dialogue: 0,0:54:14.21,0:54:16.05,Default,,0,0,0,,!شُكراً جزيلاً لك
Dialogue: 0,0:54:16.08,0:54:18.25,Default,,0,0,0,,.نعتذر على المتاعب التي سبّبناها
Dialogue: 0,0:54:18.48,0:54:20.95,Default,,0,0,0,,!أه، حسناً، إحذروا في طريق عودتكم
Dialogue: 0,0:54:20.95,0:54:21.81,Default,,0,0,0,,!حسناً
Dialogue: 0,0:54:23.58,0:54:25.98,Default,,0,0,0,,!غينتا، لا تحزن
Dialogue: 0,0:54:25.98,0:54:27.71,Default,,0,0,0,,!سنراها مُجدّداً
Dialogue: 0,0:54:27.78,0:54:29.61,Default,,0,0,0,,!نعم، لكن... حسناً
Dialogue: 0,0:54:29.65,0:54:30.45,Default,,0,0,0,,!أعلَم
Dialogue: 0,0:54:30.58,0:54:33.41,Default,,0,0,0,,لماذا لا نركب دُولاب فيريس ثانيةً؟
Dialogue: 0,0:54:33.50,0:54:36.61,Default,,0,0,0,,!نعم. قالت بأنّنا سنعود لركوبه معاً ثانيةً
Dialogue: 0,0:54:36.65,0:54:38.81,Default,,0,0,0,,!لكن يُمكننا الذّهاب الآن أيضاً
Dialogue: 0,0:54:39.18,0:54:42.00,Default,,0,0,0,,.لكن إن ذهبنا الآن، سيحلّ الظّلام عندما نصل
Dialogue: 0,0:54:42.20,0:54:45.15,Default,,0,0,0,,.لا أعلَم إن كان بإمكاننا العودة ثانيةً
Dialogue: 0,0:54:45.21,0:54:46.58,Default,,0,0,0,,!لا تقلَق
Dialogue: 0,0:54:46.61,0:54:50.58,Default,,0,0,0,,!نحن نتحدّث عن حوض أسماك سوزوكي
Dialogue: 0,0:54:50.91,0:54:51.85,Default,,0,0,0,,!أُنظر
Dialogue: 0,0:54:53.20,0:54:54.41,Default,,0,0,0,,!فهمت
Dialogue: 0,0:54:54.51,0:54:57.95,Default,,0,0,0,,!بالفِعل، هي حليفنا الثّاني
Dialogue: 0,0:54:59.55,0:55:02.21,Default,,0,0,0,,نحن هُنا بسبب لائحة الجّواسيس تلك، صحيح؟
Dialogue: 0,0:55:03.20,0:55:05.38,Default,,0,0,0,,.رأت كوراساو إسماكما على اللّائحة
Dialogue: 0,0:55:06.81,0:55:08.68,Default,,0,0,0,,.تعلمان جيّداً سبب وُجودكما هُنا
Dialogue: 0,0:55:09.91,0:55:12.58,Default,,0,0,0,,كوراساو؟ العميلة المُقرّبة إلى رم؟
Dialogue: 0,0:55:12.81,0:55:15.78,Default,,0,0,0,,.نعم، أخصّائيّتنا في جمع المعلومات
Dialogue: 0,0:55:15.88,0:55:17.25,Default,,0,0,0,,عرفتِ هذا؟
Dialogue: 0,0:55:18.11,0:55:21.51,Default,,0,0,0,,!أستمرّ بإخباركم بأنّ معلوماتكم خاطئة
Dialogue: 0,0:55:21.78,0:55:24.08,Default,,0,0,0,,.لرُبّما حصل خطأٌ عند إرسال الأسماء
Dialogue: 0,0:55:24.41,0:55:29.31,Default,,0,0,0,,كلّا، هذا مُستحيل، و لَقد ارتكبتُما خطأُ فادحاً، صحيح؟
Dialogue: 0,0:55:30.18,0:55:32.28,Default,,0,0,0,,.قتلُنا سيكون خطأً فادحاً
Dialogue: 0,0:55:32.51,0:55:35.71,Default,,0,0,0,,.لابدّ من أنّ الأمر قد اختلط على كوارساو
Dialogue: 0,0:55:36.31,0:55:37.31,Default,,0,0,0,,صحيح؟
Dialogue: 0,0:55:38.51,0:55:40.58,Default,,0,0,0,,!هذا من طِباعك، بوربون
Dialogue: 0,0:55:40.78,0:55:43.48,Default,,0,0,0,,!لحُسن حظّكما، لا نملك اللّائحة الآن
Dialogue: 0,0:55:43.81,0:55:47.21,Default,,0,0,0,,!وَجدتها الشّرطة، و قد هربَت
Dialogue: 0,0:55:47.51,0:55:50.38,Default,,0,0,0,,!من الأفضل أن تعترفا
Dialogue: 0,0:55:50.71,0:55:55.15,Default,,0,0,0,,!إذاً، أعيدوا كوراساو و اجعلوها تُؤكّد بأنّ أسماءنا لَيست في اللّائحة
Dialogue: 0,0:55:55.35,0:56:00.25,Default,,0,0,0,,!جين، إن لَم يكن إسمانا هناك، ستكون قد ارتكبتَ خطأً فادحاً
Dialogue: 0,0:56:01.31,0:56:02.78,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:56:03.11,0:56:03.98,Default,,0,0,0,,...مع ذلك
Dialogue: 0,0:56:08.61,0:56:09.11,Default,,0,0,0,,!جين
Dialogue: 0,0:56:09.11,0:56:09.78,Default,,0,0,0,,!أخي
Dialogue: 0,0:56:10.48,0:56:12.28,Default,,0,0,0,,.سواء كان خطأً أم لا، أنا من يُقرّر
Dialogue: 0,0:56:12.61,0:56:14.68,Default,,0,0,0,,!حان الوَقت للتّخلّص من تلك الحشرات
Dialogue: 0,0:56:15.25,0:56:16.35,Default,,0,0,0,,...حسناً، إذاً
Dialogue: 0,0:56:17.72,0:56:20.56,Default,,0,0,0,,!سنتقابل في الجّحيم
Dialogue: 0,0:56:21.91,0:56:23.15,Default,,0,0,0,,إذاً، بروفيسور؟
Dialogue: 0,0:56:23.25,0:56:24.18,Default,,0,0,0,,!لَيس بعد
Dialogue: 0,0:56:24.68,0:56:26.88,Default,,0,0,0,,.سيُفكّ التّشفير بعد 30 ثانية
Dialogue: 0,0:56:27.05,0:56:27.58,Default,,0,0,0,,!حسناً
Dialogue: 0,0:56:28.11,0:56:30.78,Default,,0,0,0,,!جِد المُستلم أوّلاً
Dialogue: 0,0:56:31.08,0:56:32.15,Default,,0,0,0,,!عُلِم
Dialogue: 0,0:56:32.58,0:56:36.28,Default,,0,0,0,,.سأُبقيكَ على اطّلاع، لَم يبقى الكثير من الوَقت
Dialogue: 0,0:56:36.41,0:56:39.08,Default,,0,0,0,,!نعم، الوَقت يُداهمنا
Dialogue: 0,0:56:39.71,0:56:41.18,Default,,0,0,0,,...أه، إنتهى
Dialogue: 0,0:56:42.21,0:56:43.48,Default,,0,0,0,,أنهى المُكالمة؟
Dialogue: 0,0:56:49.38,0:56:51.15,Default,,0,0,0,,!إلى هُنا، أيّها الطّفل الرّائع
Dialogue: 0,0:56:52.58,0:56:54.08,Default,,0,0,0,,!إقرأوا هذا، بسرعة
Dialogue: 0,0:56:56.75,0:56:57.95,Default,,0,0,0,,...لكن هذا
Dialogue: 0,0:57:02.15,0:57:02.65,Default,,0,0,0,,!كير
Dialogue: 0,0:57:04.71,0:57:06.68,Default,,0,0,0,,ما الأمر، يا كير؟
Dialogue: 0,0:57:06.85,0:57:08.11,Default,,0,0,0,,ألَديكِ ما تقولينه؟
Dialogue: 0,0:57:09.21,0:57:11.28,Default,,0,0,0,,الآن هو الوَقت المِثاليّ للتّحدّث، ألا تظنّين؟
Dialogue: 0,0:57:11.38,0:57:13.28,Default,,0,0,0,,!أخبرناكَ بأنّنا حُلفاؤكم
Dialogue: 0,0:57:13.98,0:57:17.75,Default,,0,0,0,,.لا تُضع وَقتك، أعلَم بأنّكما لَستُما كذلك
Dialogue: 0,0:57:18.41,0:57:20.61,Default,,0,0,0,,!سأمنحكما دقيقةً وَاحدة
Dialogue: 0,0:57:21.08,0:57:24.45,Default,,0,0,0,,...الفُرصة الأخيرة لإثبات برائتكما
Dialogue: 0,0:57:25.18,0:57:27.65,Default,,0,0,0,,!الفئران مُزعجة
Dialogue: 0,0:57:28.91,0:57:30.78,Default,,0,0,0,,.فودكا، العدّ التّنازليّ
Dialogue: 0,0:57:31.51,0:57:32.68,Default,,0,0,0,,.عُلِم
Dialogue: 0,0:57:33.71,0:57:34.81,Default,,0,0,0,,﻿60
Dialogue: 0,0:57:36.95,0:57:39.28,Default,,0,0,0,,نحن بجانبكم، ألا تفهم هذا؟
Dialogue: 0,0:57:39.51,0:57:43.78,Default,,0,0,0,,ماذا لَو وَضعت تلك الفتاة أسماءنا لتتخلّص منّا؟
Dialogue: 0,0:57:44.18,0:57:46.45,Default,,0,0,0,,!أحضروها إلى هُنا، لتأكيد خطأها
Dialogue: 0,0:57:46.58,0:57:47.41,Default,,0,0,0,,﻿50
Dialogue: 0,0:57:48.11,0:57:50.01,Default,,0,0,0,,!هذه طريقةٌ لرُؤية الأمور
Dialogue: 0,0:57:50.01,0:57:52.15,Default,,0,0,0,,.لكنّني لَن أكون بهذه الرّحمة
Dialogue: 0,0:57:52.61,0:57:53.75,Default,,0,0,0,,...كير
Dialogue: 0,0:57:55.10,0:57:56.35,Default,,0,0,0,,﻿40
Dialogue: 0,0:57:58.68,0:58:01.85,Default,,0,0,0,,.عِشتُما بما يكفي بالنّسبة للمُنظّمة
Dialogue: 0,0:58:02.31,0:58:06.30,Default,,0,0,0,,!لا أملك فِكرةً عن سبب وُجود إسمي في لائحة الجّواسيس
Dialogue: 0,0:58:06.30,0:58:07.20,Default,,0,0,0,,!أنا أيضاً
Dialogue: 0,0:58:07.51,0:58:10.95,up,,0,0,0,,30
Dialogue: 0,0:58:08.11,0:58:10.95,Default,,0,0,0,,!أُخبرك، لَستُ جاسوسة
Dialogue: 0,0:58:10.95,0:58:12.21,Default,,0,0,0,,!أنا أيضاً
Dialogue: 0,0:58:12.75,0:58:13.75,Default,,0,0,0,,...حسناً
Dialogue: 0,0:58:13.95,0:58:14.85,Default,,0,0,0,,﻿20
Dialogue: 0,0:58:15.15,0:58:16.70,Default,,0,0,0,,بمن عليّ أن أبدأ أوّلاً؟
Dialogue: 0,0:58:17.01,0:58:19.28,Default,,0,0,0,,جين، هل أنتَ جادّ؟
Dialogue: 0,0:58:19.58,0:58:21.78,Default,,0,0,0,,!سألتُ بمن عليّ أن أبدأ منكما
Dialogue: 0,0:58:22.15,0:58:25.41,up,,0,0,0,,...7-8-9-10
Dialogue: 0,0:58:24.90,0:58:25.90,Default,,0,0,0,,إذاً؟
Dialogue: 0,0:58:25.88,0:58:27.68,Default,,0,0,0,,بوربون، كير؟
Dialogue: 0,0:58:26.08,0:58:27.38,up,,0,0,0,,...5-6
Dialogue: 0,0:58:28.05,0:58:28.45,Default,,0,0,0,,4
Dialogue: 0,0:58:28.81,0:58:29.28,Default,,0,0,0,,3
Dialogue: 0,0:58:29.95,0:58:30.41,Default,,0,0,0,,2
Dialogue: 0,0:58:30.41,0:58:31.81,Default,,0,0,0,,...سأبدأ بـ
Dialogue: 0,0:58:30.95,0:58:31.28,up,,0,0,0,,1
Dialogue: 0,0:58:32.05,0:58:33.00,up,,0,0,0,,!0
Dialogue: 0,0:58:33.58,0:58:34.35,Default,,0,0,0,,!بوربون
Dialogue: 0,0:58:52.30,0:58:53.00,Default,,0,0,0,,ماذا يحصل؟
Dialogue: 0,0:58:53.00,0:58:53.51,Default,,0,0,0,,!المِصباح
Dialogue: 0,0:58:53.51,0:58:53.98,Default,,0,0,0,,!كير
Dialogue: 0,0:58:54.08,0:58:54.95,Default,,0,0,0,,!بوربون
Dialogue: 0,0:58:55.15,0:58:55.88,Default,,0,0,0,,!لا تتحرّكا
Dialogue: 0,0:58:58.95,0:58:59.98,Default,,0,0,0,,!لَم يعد بوربون هناك
Dialogue: 0,0:59:00.11,0:59:00.98,Default,,0,0,0,,!لقد هرب
Dialogue: 0,0:59:01.51,0:59:02.75,Default,,0,0,0,,لكن كيف؟
Dialogue: 0,0:59:05.88,0:59:06.65,Default,,0,0,0,,!جِده
Dialogue: 0,0:59:12.71,0:59:14.38,Default,,0,0,0,,...أعتذر، كير
Dialogue: 0,0:59:14.61,0:59:16.88,Default,,0,0,0,,.هرب الفأر الأوّل
Dialogue: 0,0:59:17.51,0:59:19.15,Default,,0,0,0,,.لكن لا تقلَقي
Dialogue: 0,0:59:19.40,0:59:22.45,Default,,0,0,0,,.سأعتني بأمركِ الآن
Dialogue: 0,0:59:23.31,0:59:24.45,Default,,0,0,0,,...وداعاً، كير
Dialogue: 0,0:59:24.45,0:59:25.30,Default,,0,0,0,,!توَقّف، جين
Dialogue: 0,0:59:26.11,0:59:26.88,Default,,0,0,0,,!كلّا، لا تقتلها
Dialogue: 0,0:59:27.25,0:59:28.35,Default,,0,0,0,,!هذه أوامر رم
Dialogue: 0,0:59:29.55,0:59:31.21,Default,,0,0,0,,...نعم، هذا ما سنفعله
Dialogue: 0,0:59:32.71,0:59:33.41,Default,,0,0,0,,.عُلِم
Dialogue: 0,0:59:35.81,0:59:38.08,Default,,0,0,0,,.إستلم رم بريداً إلكترونيّاً من كوراساو
Dialogue: 0,0:59:39.28,0:59:41.18,Default,,0,0,0,,.لا علاقة لهما بلائحة الجّواسيس
Dialogue: 0,0:59:41.98,0:59:43.55,Default,,0,0,0,,هل استعادت ذاكرتها؟
Dialogue: 0,0:59:43.58,0:59:44.78,Default,,0,0,0,,.أخبرناك
Dialogue: 0,0:59:45.01,0:59:48.18,Default,,0,0,0,,.نحن ضحايا مُؤامرة
Dialogue: 0,0:59:48.61,0:59:51.58,Default,,0,0,0,,هلّا قمتَ بفكّ الأصفاد عنّي؟
Dialogue: 0,0:59:52.01,0:59:53.01,Default,,0,0,0,,.كلّا
Dialogue: 0,0:59:54.01,0:59:56.15,Default,,0,0,0,,.هذا أمرٌ مُباشرٌ من رم
Dialogue: 0,0:59:56.61,1:00:01.65,Default,,0,0,0,,.علينا العثور على كوراساو لتأكيد إن كان البريد الإلكترونيّ منها بالفِعل
Dialogue: 0,1:00:02.11,1:00:06.50,Default,,0,0,0,,.لابدّ من أنّها في مَشفى الشّرطة، لكن تحت الحماية
Dialogue: 0,1:00:06.91,1:00:08.60,Default,,0,0,0,,هل أنتِ وَاثقةٌ من هذا؟
Dialogue: 0,1:00:09.35,1:00:13.51,Default,,0,0,0,,.إنّها حليفتنا بالتّأكيد، لكن يبدو بأنّها تنتقل
Dialogue: 0,1:00:17.70,1:00:19.50,Default,,0,0,0,,.توقيتٌ مُمتاز، جين
Dialogue: 0,1:00:19.90,1:00:23.45,Default,,0,0,0,,.نحن نتجسّس على عُملاء مكتب الأمن العام منذ بعض الوَقت
Dialogue: 0,1:00:23.51,1:00:24.70,Default,,0,0,0,,.وَاثقٌ من هذا
Dialogue: 0,1:00:25.01,1:00:27.90,Default,,0,0,0,,.أصابعي تحكّني للضّغط على الزّناد
Dialogue: 0,1:00:28.25,1:00:29.75,Default,,0,0,0,,أين الهدف؟
Dialogue: 0,1:00:30.65,1:00:33.25,Default,,0,0,0,,.كما قُلتَ أنت
Dialogue: 0,1:00:33.81,1:00:36.28,Default,,0,0,0,,.ستركب كوراساو سيّارة شُرطة
Dialogue: 0,1:00:36.58,1:00:38.15,Default,,0,0,0,,.لا تقتلوهم بعد
Dialogue: 0,1:00:38.88,1:00:39.78,Default,,0,0,0,,...لا تُخبرني أن
Dialogue: 0,1:00:40.48,1:00:42.88,Default,,0,0,0,,.سندَعهم يقومون بعملهم
Dialogue: 0,1:00:43.35,1:00:44.88,Default,,0,0,0,,.هذه فرصتنا
Dialogue: 0,1:00:45.30,1:00:48.38,Default,,0,0,0,,!بدأتُ أشعر بالإثارة حقّاً، معك، الأمر مثل الحرب
Dialogue: 0,1:00:48.50,1:00:50.20,Default,,0,0,0,,!هذه أوامر رم
Dialogue: 0,1:00:51.01,1:00:53.95,Default,,0,0,0,,...عليها أن تستعيد عافيتها
Dialogue: 0,1:00:53.95,1:00:54.75,Default,,0,0,0,,!حسناً
Dialogue: 0,1:00:57.01,1:00:58.50,Default,,0,0,0,,!رائع، هذا يُثير الحماس
Dialogue: 0,1:00:58.50,1:01:00.60,Default,,0,0,0,,!هذا الضّغط يُشعرني بالإثارة
Dialogue: 0,1:01:00.95,1:01:02.55,Default,,0,0,0,,...لكن مع هذا، هذا مُزعج
Dialogue: 0,1:01:02.68,1:01:05.45,Default,,0,0,0,,جين، هل يُمكن أن تكون جادّاً؟
Dialogue: 0,1:01:05.55,1:01:06.78,Default,,0,0,0,,.أخي، لَم أتمكّن من إيجاده
Dialogue: 0,1:01:07.15,1:01:08.35,Default,,0,0,0,,.لَقد هرب
Dialogue: 0,1:01:08.85,1:01:09.68,Default,,0,0,0,,.لا يهم
Dialogue: 0,1:01:11.11,1:01:13.58,Default,,0,0,0,,.سنعتني بأمر بوربون و كير لاحقاً
Dialogue: 0,1:01:14.00,1:01:15.91,Default,,0,0,0,,.كوراساو هي أولويّتنا القُصوى
Dialogue: 0,1:01:16.10,1:01:19.15,Default,,0,0,0,,!لكن الشّرطة مازالوا في المَشفى
Dialogue: 0,1:01:19.15,1:01:21.28,Default,,0,0,0,,.لم تعد كوراساو في المَشفى
Dialogue: 0,1:01:21.75,1:01:22.81,Default,,0,0,0,,أين هي إذاً؟
Dialogue: 0,1:01:23.41,1:01:26.81,Default,,0,0,0,,.تتّجه مُباشرةً إلى حوض أسماك توتو الآن
Dialogue: 0,1:01:27.01,1:01:31.11,Default,,0,0,0,,!جين، لَن تقوم... بفعل هذا في مكانٍ مثل ذلك
Dialogue: 0,1:01:32.20,1:01:33.95,Default,,0,0,0,,!فودكا، لنَذهب
Dialogue: 0,1:01:34.51,1:01:35.31,Default,,0,0,0,,.شغّل السيّارة
Dialogue: 0,1:01:35.31,1:01:35.80,Default,,0,0,0,,.حسناً
Dialogue: 0,1:01:39.00,1:01:40.30,Default,,0,0,0,,!أه، عُلِم
Dialogue: 0,1:01:40.48,1:01:42.48,Default,,0,0,0,,.أبلِغ المكتب
Dialogue: 0,1:01:42.70,1:01:44.50,Default,,0,0,0,,.سنبقى على اتّصال
Dialogue: 0,1:01:44.71,1:01:45.55,Default,,0,0,0,,!عُلِم
Dialogue: 0,1:01:46.00,1:01:47.98,Default,,0,0,0,,.إنّهما بأمان
Dialogue: 0,1:01:48.81,1:01:50.01,Default,,0,0,0,,!حمداً لله
Dialogue: 0,1:01:50.10,1:01:53.58,Default,,0,0,0,,!رائع. قمتَ بعملٍ جيّد، أيّها الطّفل الرّائع
Dialogue: 0,1:01:53.61,1:01:55.20,Default,,0,0,0,,!بالتّعاون
Dialogue: 0,1:01:55.58,1:01:58.45,Default,,0,0,0,,!هذا لأنّ هذا البريد الإلكترونيّ كان قد أُرسِل إليهم
Dialogue: 0,1:01:58.68,1:02:04.28,Default,,0,0,0,,.يُمكننا الإعتناء بالباقي، لَم يعودا في خطر
Dialogue: 0,1:02:04.58,1:02:06.41,Default,,0,0,0,,!حسناً، يُمكننا التّصرّف بحرّيّة
Dialogue: 0,1:02:06.51,1:02:06.99,Default,,0,0,0,,!نعم
Dialogue: 0,1:02:07.00,1:02:10.25,Default,,0,0,0,,!كلّا! لَم تُحلّ الأُمور بعد
Dialogue: 0,1:02:10.55,1:02:12.95,Default,,0,0,0,,.لابدّ من أنّ الأعداء قد زرعوا القنابل في المُنتزه
Dialogue: 0,1:02:13.15,1:02:15.45,Default,,0,0,0,,.رُبّما يُخطّطون لقتلها قريباً
Dialogue: 0,1:02:15.98,1:02:17.65,Default,,0,0,0,,ألَيست في مَشفى الشّرطة؟
Dialogue: 0,1:02:18.08,1:02:21.81,Default,,0,0,0,,.كلّا، طلبَت أن يتمّ إيصالها إلى حوض الأسماك
Dialogue: 0,1:02:22.01,1:02:23.15,Default,,0,0,0,,!حوض الأسماك؟
Dialogue: 0,1:02:23.35,1:02:24.25,Default,,0,0,0,,!لنَذهب إذاً
Dialogue: 0,1:02:24.50,1:02:27.95,Default,,0,0,0,,!كلّا! لنترك الأمر لأكاي ليعتني به
Dialogue: 0,1:02:28.21,1:02:32.01,Default,,0,0,0,,،لَن نُعرّض أنفسنا للخطر بِلا سبب
Dialogue: 0,1:02:32.31,1:02:34.08,Default,,0,0,0,,.لكنّنا سنستعيد بيانات لائحة التّجسّس
Dialogue: 0,1:02:34.11,1:02:34.58,Default,,0,0,0,,!حسناً
Dialogue: 0,1:02:34.81,1:02:37.41,Default,,0,0,0,,كونان، ألَديكَ ما تُريد إضافته؟
Dialogue: 0,1:02:37.61,1:02:40.18,Default,,0,0,0,,.أيّ شيءٍ رُبّما يكون قد فاتنا
Dialogue: 0,1:02:40.31,1:02:41.08,Default,,0,0,0,,...لكن
Dialogue: 0,1:02:41.31,1:02:42.01,Default,,0,0,0,,!لا تقلَق
Dialogue: 0,1:02:42.91,1:02:45.28,Default,,0,0,0,,.ستكون الإف بي آي هناك لحمايتك
Dialogue: 0,1:02:49.30,1:02:50.75,Default,,0,0,0,,.سأعتمد عليكم إذاً
Dialogue: 0,1:02:50.81,1:02:53.48,Default,,0,0,0,,.نعم، سنتّصل بكَ عندما نعرف المزيد
Dialogue: 0,1:02:54.78,1:02:56.38,Default,,0,0,0,,...أه، بالمناسبة
Dialogue: 0,1:02:56.78,1:03:00.25,Default,,0,0,0,,كيف عرف أكاي بشأن المعلومات الجّديدة؟
Dialogue: 0,1:03:00.48,1:03:02.28,Default,,0,0,0,,!نتبادل المعلومات بانتظام
Dialogue: 0,1:03:02.31,1:03:05.61,Default,,0,0,0,,.سمع بشأن كوراساو بفضل بوربون، عندما اخترق المُنظّمة
Dialogue: 0,1:03:05.71,1:03:07.88,Default,,0,0,0,,.لذا كان له علاقةٌ بهذه القضيّة
Dialogue: 0,1:03:08.38,1:03:10.05,Default,,0,0,0,,.شكراً، إعتنوا بأنفسكم
Dialogue: 0,1:03:14.41,1:03:16.95,Default,,0,0,0,,.إذاً الفتاة لَيست رم، بل كوراساو
Dialogue: 0,1:03:18.01,1:03:21.65,Default,,0,0,0,,.لكن يُمكن أن تكون لها علاقةٌ بمُختلف ألوان كوراساو
Dialogue: 0,1:03:21.98,1:03:23.55,Default,,0,0,0,,.تُوجد بألوانٍ مُتعدّدة
Dialogue: 0,1:03:23.55,1:03:28.78,Default,,0,0,0,,كوراساو أبيض، برتقالي، أزرق، و أخضر...؟
Dialogue: 0,1:03:29.21,1:03:30.75,Default,,0,0,0,,و كوراساو أحمر...؟
Dialogue: 0,1:03:34.40,1:03:36.30,Default,,0,0,0,,...لكن، هل يُمكن
Dialogue: 0,1:03:37.81,1:03:39.41,Default,,0,0,0,,!كما اعتقدتّ
Dialogue: 0,1:03:40.01,1:03:43.48,Default,,0,0,0,,لكن، أين رأيتُها سابقاً...؟
Dialogue: 0,1:03:43.85,1:03:45.15,Default,,0,0,0,,...حاول التّذكّر
Dialogue: 0,1:03:47.76,1:03:49.04,Default,,0,0,0,,!أه، نعم، وَقتها
Dialogue: 0,1:03:50.00,1:03:53.40,Default,,0,0,0,,.نعم، إنّها عدسات كروم
Dialogue: 0,1:03:53.40,1:03:57.40,Default,,0,0,0,,.أجب، أرجوك. تعال لمُساعدتنا
Dialogue: 0,1:03:58.21,1:04:00.20,Default,,0,0,0,,...ستاوت، أكوافيت
Dialogue: 0,1:04:00.61,1:04:02.15,Default,,0,0,0,,!ريسلينغ
Dialogue: 0,1:04:03.58,1:04:08.95,Default,,0,0,0,,!أوه، نعم، المُنظّمة بانتظار قيام مكتب الأمن العام بحلّ الغموض بأنفسهم
Dialogue: 0,1:04:09.25,1:04:11.65,Default,,0,0,0,,!لكن إذاً... اللّعنة
Dialogue: 0,1:04:12.00,1:04:15.40,Default,,0,0,0,,.إن لَم أُسرع، ستستعيد المُنظّمة اللّائحة
Dialogue: 0,1:04:20.55,1:04:21.00,Default,,0,0,0,,!نعم
Dialogue: 0,1:04:21.61,1:04:24.08,Default,,0,0,0,,.نعم، لَقد استعدتّها
Dialogue: 0,1:04:25.08,1:04:27.05,Default,,0,0,0,,ألَديكَ خُطّةٌ ما؟
Dialogue: 0,1:04:27.81,1:04:29.88,Default,,0,0,0,,.كلّا، لكن لا يُمكننا البقاء دون فِعل شيءٍ بعد الآن
Dialogue: 0,1:04:30.00,1:04:31.88,Default,,0,0,0,,.سأترك الأمر لك، أعِدها
Dialogue: 0,1:04:32.50,1:04:33.35,Default,,0,0,0,,!حظّاً طيّباً
Dialogue: 0,1:04:33.75,1:04:36.05,Default,,0,0,0,,.نعم، سأفعل بأقصى سرعة
Dialogue: 0,1:04:36.38,1:04:39.48,Default,,0,0,0,,.إحذر، أعين المُنظّمة في كلّ مكان
Dialogue: 0,1:04:40.11,1:04:41.68,Default,,0,0,0,,.سأُهاتفكَ لاحقاً
Dialogue: 0,1:04:42.11,1:04:42.58,Default,,0,0,0,,!وداعاً
Dialogue: 0,1:04:42.88,1:04:44.18,Default,,0,0,0,,.إنتظر، فورويا
Dialogue: 0,1:04:51.90,1:04:53.00,Default,,0,0,0,,!يا إلهي
Dialogue: 0,1:04:53.25,1:04:57.58,Default,,0,0,0,,!لماذا عليّ القُدوم؟ و مُجالسة بعض الأشقياء
Dialogue: 0,1:04:57.80,1:05:00.29,Default,,0,0,0,,!مع هؤلاء الأطفال حتّى
Dialogue: 0,1:05:01.21,1:05:02.41,Default,,0,0,0,,!أُخرجوا، بسرعة
Dialogue: 0,1:05:02.55,1:05:05.25,Default,,0,0,0,,!وَصلنا أخيراً-\N!نعم-\N!رائع-
Dialogue: 0,1:05:05.28,1:05:08.08,Default,,0,0,0,,!إنتظروا قليلاً، لا تبتعدوا كثيراً
Dialogue: 0,1:05:08.31,1:05:09.28,Default,,0,0,0,,!حسناً
Dialogue: 0,1:05:09.68,1:05:11.01,Default,,0,0,0,,ماذا تفعل، أبي؟
Dialogue: 0,1:05:11.15,1:05:14.18,Default,,0,0,0,,.لَقد أزعجتِ نومي، لذا آخذ قيلولةً الآن
Dialogue: 0,1:05:14.70,1:05:17.00,Default,,0,0,0,,!سأنتظر في السيّارة، إستمتعوا
Dialogue: 0,1:05:17.88,1:05:18.98,Default,,0,0,0,,!شُكراً
Dialogue: 0,1:05:28.55,1:05:29.75,Default,,0,0,0,,.سأذهب لتفقّد المكان
Dialogue: 0,1:05:29.95,1:05:30.35,Default,,0,0,0,,!حسناً
Dialogue: 0,1:05:33.21,1:05:34.55,Default,,0,0,0,,.تمّ إيجادها هناك بعد حادثة التكدّس
Dialogue: 0,1:05:34.75,1:05:38.01,Default,,0,0,0,,.لابدّ من أنّ لَديهم سبباً لإحضارها إلى هُنا
Dialogue: 0,1:05:38.15,1:05:41.08,Default,,0,0,0,,.هذا المكان كان تحت المُراقبة لبعض الوَقت
Dialogue: 0,1:05:41.58,1:05:43.98,Default,,0,0,0,,.لابدّ من أنّ لهذا المكان له علاقةٌ بسرٍّ مخفيٍّ عن ماضيها
Dialogue: 0,1:05:44.88,1:05:47.65,Default,,0,0,0,,.مهما يكن، لنَستمرّ بمُراقبة هذا المكان لبعض الوَقت
Dialogue: 0,1:05:47.85,1:05:48.28,Default,,0,0,0,,.حسناً
Dialogue: 0,1:05:48.80,1:05:51.20,Default,,0,0,0,,!لَم تصل سونوكو بعد
Dialogue: 0,1:05:51.48,1:05:54.10,Default,,0,0,0,,.نعم، ظننتُها ستكون هُنا بالفِعل
Dialogue: 0,1:05:54.11,1:05:55.20,Default,,0,0,0,,.أُريد أن أركب دُولاب فيريس الضّخم
Dialogue: 0,1:05:55.21,1:06:00.11,Default,,0,0,0,,.نعتذر، تمّ بيع جميع التّذاكر اليوم
Dialogue: 0,1:06:00.11,1:06:02.55,Default,,0,0,0,,.لكنّني... من مكتب الأمن العام
Dialogue: 0,1:06:02.58,1:06:05.75,Default,,0,0,0,,.من الأفضل أن تسمحي لي بالدّخول
Dialogue: 0,1:06:05.78,1:06:06.85,Default,,0,0,0,,!ران
Dialogue: 0,1:06:05.78,1:06:07.85,up,,0,0,0,,!عُذراً، سيّدي
Dialogue: 0,1:06:07.61,1:06:08.71,Default,,0,0,0,,!هُنا، هُنا
Dialogue: 0,1:06:09.88,1:06:11.05,Default,,0,0,0,,!أه، إنّها هُنا
Dialogue: 0,1:06:11.30,1:06:12.35,Default,,0,0,0,,.أعتذر على التّأخير
Dialogue: 0,1:06:12.35,1:06:15.28,Default,,0,0,0,,.كنتُ أتجوّل هُنا و لَم أنتبه إلى الوَقت
Dialogue: 0,1:06:15.35,1:06:18.70,Default,,0,0,0,,!هذه لَيست مُشكلة-\N!شُكراً على قُبول طلَبنا-
Dialogue: 0,1:06:18.91,1:06:21.48,Default,,0,0,0,,ستردّون لي المعروف، صحيح؟
Dialogue: 0,1:06:21.61,1:06:22.68,Default,,0,0,0,,!حسناً
Dialogue: 0,1:06:22.78,1:06:25.65,Default,,0,0,0,,.أعتذر لإجباركِ على القدوم إلى هُنا
Dialogue: 0,1:06:25.68,1:06:28.55,Default,,0,0,0,,.كلّا، لا تقلَقي بشأن هذا
Dialogue: 0,1:06:28.75,1:06:30.41,Default,,0,0,0,,ستعتنين بالأطفال، صحيح؟
Dialogue: 0,1:06:30.41,1:06:30.98,Default,,0,0,0,,!نعم
Dialogue: 0,1:06:31.35,1:06:35.15,Default,,0,0,0,,.حسناً، إتبعوني إلى دُولاب فيريس
Dialogue: 0,1:06:35.21,1:06:37.78,Default,,0,0,0,,!نعم-\N!حسناً-
Dialogue: 0,1:06:39.01,1:06:40.81,Default,,0,0,0,,ألا بأس بهذا معكِ؟
Dialogue: 0,1:06:40.91,1:06:44.21,Default,,0,0,0,,!أوه لا، تلك المرأة بمثابة ملاكي الحارس
Dialogue: 0,1:06:44.61,1:06:47.31,Default,,0,0,0,,بالمُناسبة، هل وَصلَتكِ أيّة أخبارٍ عن شينتشي؟
Dialogue: 0,1:06:47.70,1:06:48.75,Default,,0,0,0,,...هاه... كلّا
Dialogue: 0,1:06:48.81,1:06:49.45,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,1:06:49.48,1:06:51.41,Default,,0,0,0,,!كلّا، لَم يكن هناك شيء
Dialogue: 0,1:06:52.35,1:06:53.88,Default,,0,0,0,,ماذا؟ هل تعرفينهم؟
Dialogue: 0,1:06:53.90,1:06:58.55,Default,,0,0,0,,.كلّا، لكن لَديّ شعورٌ بأنّني قد رأيتُ تلك الآنسة سابقاً
Dialogue: 0,1:06:58.81,1:07:00.35,Default,,0,0,0,,...مع أنّني لا أعرف أين
Dialogue: 0,1:07:00.41,1:07:02.55,Default,,0,0,0,,ما خطب هؤلاء الأشخاص؟
Dialogue: 0,1:07:02.75,1:07:05.20,Default,,0,0,0,,.نعم، يبدو بأنّ شيئاً ما يحصل
Dialogue: 0,1:07:07.78,1:07:10.05,Default,,0,0,0,,هاي أنتُم، هل أنتِ بخير؟
Dialogue: 0,1:07:10.18,1:07:10.68,Default,,0,0,0,,!لنَذهب
Dialogue: 0,1:07:13.28,1:07:14.78,Default,,0,0,0,,...أعتذر، سونوكو
Dialogue: 0,1:07:15.21,1:07:18.01,Default,,0,0,0,,...لكن أظنّ بأنّ الأشخاص من قبل قليل
Dialogue: 0,1:07:18.11,1:07:21.35,Default,,0,0,0,,لماذا لا تستغلّين هذه الفرصة للإتّصال به؟
Dialogue: 0,1:07:32.75,1:07:34.58,Default,,0,0,0,,!اللّعنة، هذا هاتفي الآخر
Dialogue: 0,1:07:34.57,1:07:36.32,Title,,0,0,0,,{\fs55\pos(638,210)\3c&H7F4837&\4c&H7F4837&}ران موري
Dialogue: 0,1:07:35.31,1:07:36.28,Default,,0,0,0,,!كما ظننت
Dialogue: 0,1:07:37.61,1:07:38.45,Default,,0,0,0,,ما الأمر، ران؟
Dialogue: 0,1:07:38.65,1:07:39.71,Default,,0,0,0,,!أه، شينتشي
Dialogue: 0,1:07:39.81,1:07:41.48,Default,,0,0,0,,...الأمر لَيس مُهمّاً، لكن
Dialogue: 0,1:07:42.41,1:07:43.75,Default,,0,0,0,,!ماذا؟ لَيس لَديّ الكثير من الوَقت
Dialogue: 0,1:07:44.18,1:07:46.15,Default,,0,0,0,,...أوه، أعتذر، أنتَ مُستعجل
Dialogue: 0,1:07:46.15,1:07:46.95,Default,,0,0,0,,.يُمكن قول هذا
Dialogue: 0,1:07:47.28,1:07:48.68,Default,,0,0,0,,!توَقّفي، سونوكو
Dialogue: 0,1:07:48.68,1:07:49.81,Default,,0,0,0,,!أوه، تُحادثينه
Dialogue: 0,1:07:49.85,1:07:50.85,Default,,0,0,0,,!هيهيهي-\N!توَقّفي-
Dialogue: 0,1:07:49.85,1:07:50.85,up,,0,0,0,,!يا إلهي
Dialogue: 0,1:07:51.08,1:07:54.88,Default,,0,0,0,,!أعتذر، ران، عليّ الذّهاب. أراكِ لاحقاً
Dialogue: 0,1:07:55.71,1:07:56.90,Default,,0,0,0,,!إنتظر! شينتشي
Dialogue: 0,1:07:56.91,1:07:58.90,Default,,0,0,0,,!سأُهاتفكِ لاحقاً
Dialogue: 0,1:07:59.00,1:08:01.28,Default,,0,0,0,,لكن ماذا أنت... أين أنت؟
Dialogue: 0,1:08:02.41,1:08:06.15,Default,,0,0,0,,..."هذا الرّجل، بين قوله "أنا مُستعجل" و "سأُهاتفكِ لاحقاً
Dialogue: 0,1:08:07.25,1:08:09.55,Default,,0,0,0,,.على أيّة حال، لا يُمكنكِ فعل شيءٍ بشأن هذا
Dialogue: 0,1:08:09.75,1:08:11.75,Default,,0,0,0,,.لكن أظنّه هُنا
Dialogue: 0,1:08:11.75,1:08:12.15,Default,,0,0,0,,هيه؟
Dialogue: 0,1:08:12.65,1:08:13.61,Default,,0,0,0,,ماذا تعنين؟
Dialogue: 0,1:08:13.61,1:08:16.80,Default,,0,0,0,,.سمعتُ صوت شينتشي على المُكبّر
Dialogue: 0,1:08:17.48,1:08:18.68,Default,,0,0,0,,...أوه، بالتّأكيد
Dialogue: 0,1:08:19.15,1:08:21.15,Default,,0,0,0,,.إنّه يخونكِ
Dialogue: 0,1:08:21.85,1:08:25.88,Default,,0,0,0,,هل تظنّين بأنّ الرّجل قد يأتي إلى مكانٍ كهذا لوَحده؟
Dialogue: 0,1:08:26.11,1:08:28.65,Default,,0,0,0,,!حسناً، لنَبحث عن الوَغد
Dialogue: 0,1:08:28.71,1:08:30.75,Default,,0,0,0,,!هيه! سـ-سونوكو
Dialogue: 0,1:08:35.48,1:08:38.35,Default,,0,0,0,,...من المُؤسف اضطّرارنا لفِعل هذا
Dialogue: 0,1:08:39.10,1:08:41.21,Default,,0,0,0,,.عرفنا بعضنا لوَقتٍ طويل
Dialogue: 0,1:08:41.81,1:08:43.35,Default,,0,0,0,,.هذا مُؤسف
Dialogue: 0,1:08:50.10,1:08:54.35,Default,,0,0,0,,.إنتهيت. يعتمد الأمر عليكم الآن للتّأكّد من أنّ كلّ شيءٍ يسير بسلاسة
Dialogue: 0,1:08:54.70,1:08:55.65,Default,,0,0,0,,.أحسنتِ
Dialogue: 0,1:08:57.48,1:09:00.15,Default,,0,0,0,,.أسرَع. لا يُمكننا أن نرتكب أيّ خطأ
Dialogue: 0,1:09:00.40,1:09:02.11,Default,,0,0,0,,.عُلِم، لنَنطلق
Dialogue: 0,1:09:06.85,1:09:08.90,Default,,0,0,0,,هل تستمتعون اللّيلة؟
Dialogue: 0,1:09:09.00,1:09:12.75,Default,,0,0,0,,!نحن سعيدون للتّرحيب بكم في مُنتزه الحديقة المائيّة
Dialogue: 0,1:09:13.66,1:09:24.40,Default,,0,0,0,,.عرضٌ بَصريٌّ سيظهر على دُولاب فيريس خلال المساء\N.إصطفّوا في المنطقة الثّالثة لتأمين مكانٍ لكم لمُشاهدته
Dialogue: 0,1:09:26.25,1:09:27.70,Default,,0,0,0,,.حسناً، تفضّلوا
Dialogue: 0,1:09:28.20,1:09:31.10,Default,,0,0,0,,!واه-\N!رائع-\N!حصلنا على أماكن مُخصّصةً لنا-
Dialogue: 0,1:09:31.20,1:09:32.75,Default,,0,0,0,,!إحذروا، أيّها الأطفال
Dialogue: 0,1:09:32.79,1:09:34.30,Default,,0,0,0,,من هؤلاء الأطفال؟
Dialogue: 0,1:09:34.40,1:09:36.30,Default,,0,0,0,,.إنّهم ضُيوف سوزوكي ساما
Dialogue: 0,1:09:36.40,1:09:37.90,Default,,0,0,0,,.أوه، فهمت
Dialogue: 0,1:09:37.90,1:09:40.50,Default,,0,0,0,,هل يحتاج هؤلاء الأطفال لتعليماتٍ خاصّة؟
Dialogue: 0,1:09:40.50,1:09:42.06,Default,,0,0,0,,.لا حاجة لأن تقوم بفِعل الكثير
Dialogue: 0,1:09:49.55,1:09:52.73,Default,,0,0,0,,!اللّعنة، أبحث في كلّ مكانٍ لكن دون أن أنجح
Dialogue: 0,1:09:52.83,1:09:54.90,Default,,0,0,0,,!مهما يكن، عليّ أن أُسرع
Dialogue: 0,1:10:07.70,1:10:10.00,Default,,0,0,0,,لكن ماذا يحصل؟
Dialogue: 0,1:10:15.10,1:10:17.63,Default,,0,0,0,,!يال عددهم الكبير
Dialogue: 0,1:10:17.63,1:10:19.50,Default,,0,0,0,,ماذا يحصل بالضّبط؟
Dialogue: 0,1:10:19.50,1:10:20.50,Default,,0,0,0,,...هل مُمكن
Dialogue: 0,1:10:21.43,1:10:23.25,Default,,0,0,0,,كودو... أين أنت؟
Dialogue: 0,1:10:24.90,1:10:25.50,Default,,0,0,0,,...كما ظننت
Dialogue: 0,1:10:27.00,1:10:28.30,Default,,0,0,0,,!كنتُ وَاثقة
Dialogue: 0,1:10:29.40,1:10:31.05,Default,,0,0,0,,.شُكراً على انتظاركم
Dialogue: 0,1:10:31.05,1:10:34.15,Default,,0,0,0,,...إيه، هل يُمكن أن تكونوا
Dialogue: 0,1:10:34.15,1:10:36.00,Default,,0,0,0,,!نعم، إنّهم نحن
Dialogue: 0,1:10:36.20,1:10:38.00,Default,,0,0,0,,!أعتذر
Dialogue: 0,1:10:38.50,1:10:42.95,Default,,0,0,0,,.سمحنا بدخول بعض الأطفال، لذا سيتأخّر الدّور لـ10 دقائق
Dialogue: 0,1:10:44.20,1:10:44.95,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,1:10:45.30,1:10:46.95,Default,,0,0,0,,هل من مُشكلة؟
Dialogue: 0,1:10:46.95,1:10:49.20,Default,,0,0,0,,.كلّا، لَيسوا سوى أطفال، لذا لا بأس
Dialogue: 0,1:10:49.45,1:10:57.66,Default,,0,0,0,,.المُهمّ هو أخذها إلى قِمّة دُولاب فيريس قبل أن يحصلوا على فُرصة استعادتها
Dialogue: 0,1:10:57.66,1:10:59.53,Default,,0,0,0,,.علينا فِعل هذا
Dialogue: 0,1:10:59.53,1:11:00.30,Default,,0,0,0,,!نعم
Dialogue: 0,1:11:00.70,1:11:01.60,Default,,0,0,0,,.لنَذهب
Dialogue: 0,1:11:04.05,1:11:07.15,Default,,0,0,0,,!عُذراً، أصدقائي في الدّاخل
Dialogue: 0,1:11:07.15,1:11:08.70,Default,,0,0,0,,!تحرّكوا قليلاً، عُذراً
Dialogue: 0,1:11:10.30,1:11:10.70,Default,,0,0,0,,!إنتظري
Dialogue: 0,1:11:11.30,1:11:12.30,Default,,0,0,0,,!لا تدخلي
Dialogue: 0,1:11:12.30,1:11:14.45,Default,,0,0,0,,!خُذ حذركَ إلى حيث تذهب
Dialogue: 0,1:11:14.70,1:11:17.15,Default,,0,0,0,,!اللّعنة، تأخّرتُ كثيراً
Dialogue: 0,1:11:23.10,1:11:24.50,Default,,0,0,0,,!عُذراً، دعوني أمرّ
Dialogue: 0,1:11:32.55,1:11:34.53,Default,,0,0,0,,.لَم تحصل المُنظّمة على فُرصة القُدوم إلى هُنا بعد
Dialogue: 0,1:11:35.00,1:11:39.30,Default,,0,0,0,,...لكن إن فعلوا ما أظنّهم سيفعلونه بتلك المرأة
Dialogue: 0,1:11:39.86,1:11:42.15,Default,,0,0,0,,.من الأفضل أن أُسرع
Dialogue: 0,1:11:42.80,1:11:44.95,Default,,0,0,0,,!أحتاج لإبلاغ مكتب الأمن العام و الإف بي آي
Dialogue: 0,1:11:46.56,1:11:47.55,Default,,0,0,0,,!إنّه... أكاي
Dialogue: 0,1:11:48.93,1:11:49.55,Default,,0,0,0,,...إنتظر
Dialogue: 0,1:11:50.50,1:11:51.55,Default,,0,0,0,,!تلك الكيبلات
Dialogue: 0,1:11:52.55,1:11:54.55,Default,,0,0,0,,!لكن إذاً... هذا سيّءٌ جدّاً
Dialogue: 0,1:11:55.05,1:11:57.15,Default,,0,0,0,,!هذا لَيس جيّداً، أحتاج للذّهاب و رُؤيته
Dialogue: 0,1:12:00.25,1:12:02.30,Default,,0,0,0,,.ها أنتِ ذا
Dialogue: 0,1:12:03.70,1:12:05.65,Default,,0,0,0,,،كوراساو في المقصورة
Dialogue: 0,1:12:05.65,1:12:07.65,Default,,0,0,0,,.مكتب الأمن العام معها
Dialogue: 0,1:12:07.65,1:12:11.00,Default,,0,0,0,,.سيكونون في قمّة دُولاب فيريس بعد 10 دقائق
Dialogue: 0,1:12:11.15,1:12:13.40,Default,,0,0,0,,10دقائق... كيف الوَضع عندك؟
Dialogue: 0,1:12:13.80,1:12:15.20,Default,,0,0,0,,.كلّ شيءٍ بخير
Dialogue: 0,1:12:16.20,1:12:17.75,Default,,0,0,0,,و من جهتك؟
Dialogue: 0,1:12:18.00,1:12:21.10,Default,,0,0,0,,.لا يبدو بأنّ الشّرطة مُستعدّون للتّحرّك
Dialogue: 0,1:12:21.10,1:12:23.20,Default,,0,0,0,,.لكن سيكون من السيّء إن قرّروا الظّهور
Dialogue: 0,1:12:24.85,1:12:26.85,Default,,0,0,0,,.بتلك الحال، سأقول بأنّ هذا خطأكِ
Dialogue: 0,1:12:26.85,1:12:27.80,Default,,0,0,0,,.عُلِم
Dialogue: 0,1:12:28.73,1:12:29.88,Default,,0,0,0,,...أيّتها الحشرة
Dialogue: 0,1:12:30.60,1:12:32.96,Default,,0,0,0,,تُريدين دفعي لتصديق بأنّكِ قد فقدتّ ذاكرتكِ؟
Dialogue: 0,1:12:33.20,1:12:33.80,Default,,0,0,0,,...نعم
Dialogue: 0,1:12:35.30,1:12:36.30,Default,,0,0,0,,...لا تهتمّي إذاً
Dialogue: 0,1:12:36.55,1:12:39.60,Default,,0,0,0,,.أنا هُنا لاستعادة ما في عقلك
Dialogue: 0,1:12:39.75,1:12:41.60,Default,,0,0,0,,.أنتِ من سرق قائمة لائحة الجّواسيس
Dialogue: 0,1:12:41.60,1:12:44.60,Default,,0,0,0,,.لكن مُنظّمتكِ تُثير اهتمامي كثيراً
Dialogue: 0,1:12:48.80,1:12:51.10,Default,,0,0,0,,.بهذا، يُفترض أن يكون الوَضع بخير
Dialogue: 0,1:13:00.20,1:13:01.30,Default,,0,0,0,,.لَقد أتيت
Dialogue: 0,1:13:07.45,1:13:09.70,Default,,0,0,0,,.عانيتُ من وَقتٍ عصيب، أنتَ تُجيد الهرب
Dialogue: 0,1:13:09.70,1:13:13.10,Default,,0,0,0,,.من أتى للتّصرّف كمُشتّتٍ للإنتباه، إذاً فقد كان أنت
Dialogue: 0,1:13:20.20,1:13:21.55,Default,,0,0,0,,ماذا يحصل؟
Dialogue: 0,1:13:22.10,1:13:25.70,Default,,0,0,0,,...تمكّنتُ من تحرير نفسي بفضل دبّوس شعر
Dialogue: 0,1:13:26.23,1:13:27.50,Default,,0,0,0,,...كير، بوربون
Dialogue: 0,1:13:27.83,1:13:31.15,Default,,0,0,0,,...كنتُ أُخطّط للهرب عندما سمعتُ
Dialogue: 0,1:13:32.30,1:13:34.90,Default,,0,0,0,,.أحدهم يفتح الباب بشكلٍ وَاضح...
Dialogue: 0,1:13:35.10,1:13:37.85,Default,,0,0,0,,.أدركتُ رغبتكَ بعمل تشتيتٍ للإنتباه و جعل العدوّ  يبتعد
Dialogue: 0,1:13:40.35,1:13:43.10,Default,,0,0,0,,،إستغلّيتُ تلك الفُرصة للهرب إلى الظّلام
Dialogue: 0,1:13:43.65,1:13:46.30,Default,,0,0,0,,.و أدركتُ بأنّكَ كنتَ خلف كلّ هذا
Dialogue: 0,1:13:49.30,1:13:53.53,Default,,0,0,0,,.دَعني مع ذلك أطرح عليكَ بعض الأسئلة
Dialogue: 0,1:13:53.85,1:13:55.53,Default,,0,0,0,,...ماذا كان هدفكَ بإنقاذنا
Dialogue: 0,1:13:55.80,1:13:57.65,Default,,0,0,0,,أن تُحيّرَنا؟...
Dialogue: 0,1:13:58.40,1:14:00.25,Default,,0,0,0,,،أن تُساعدنا
Dialogue: 0,1:14:00.25,1:14:03.75,Default,,0,0,0,,أم هل هي فقط طريقةٌ لاسترجاع بعض المعلومات؟
Dialogue: 0,1:14:04.20,1:14:07.85,Default,,0,0,0,,هل هذا هو المكان المُناسب لمُناقشة كلّ هذا؟
Dialogue: 0,1:14:08.25,1:14:12.00,Default,,0,0,0,, .نعم. هذا هو السّبب الوَحيد ليكون الإف بي آي هُنا
Dialogue: 0,1:14:12.40,1:14:15.42,Default,,0,0,0,,.لأنّ كوراساو تنتمي إلى مكتب الأمن العام
Dialogue: 0,1:14:15.85,1:14:18.15,Default,,0,0,0,,.جوابي... هو كلّا
Dialogue: 0,1:14:18.46,1:14:21.20,Default,,0,0,0,,.بتلك الحال، لنحلّ هذا الأمر بقبضاتنا
Dialogue: 0,1:14:22.30,1:14:24.90,Default,,0,0,0,,!تعال إلى هُنا، أكاي شويتشي
Dialogue: 0,1:14:34.60,1:14:37.50,Default,,0,0,0,,.الشّيفرة هي السّبب بكلّ هذا بالتّأكيد
Dialogue: 0,1:14:37.90,1:14:39.50,Default,,0,0,0,,.لكن هذا مايزال غريباً
Dialogue: 0,1:14:39.90,1:14:41.50,Default,,0,0,0,,هل فاتني شيءٌ ما؟
Dialogue: 0,1:14:42.40,1:14:43.30,Default,,0,0,0,,ما هذا؟
Dialogue: 0,1:14:47.73,1:14:49.20,Default,,0,0,0,,!مُفجّر
Dialogue: 0,1:14:49.80,1:14:50.55,Default,,0,0,0,,...إذاً
Dialogue: 0,1:14:52.10,1:14:57.40,Default,,0,0,0,,!لابدّ من أنّهم قد وَضعوا بعض المُتفجّرات الأُخرى في أماكن مُختلفة
Dialogue: 0,1:14:57.60,1:14:58.40,Default,,0,0,0,,ماذا أفعل؟
Dialogue: 0,1:14:58.80,1:15:04.85,Default,,0,0,0,,!سواء القُنبلة أو أداة المُفجّر... إن ارتكبتُ خطأً مع أيٍّ منها، ستكون النّهاية
Dialogue: 0,1:15:05.70,1:15:08.27,Default,,0,0,0,,!أوه، نعم، أحتاج لإيجاد ذلك الشّخص
Dialogue: 0,1:15:14.20,1:15:16.40,Default,,0,0,0,,كيف يُمكن أن يكون هذا مُمكناً؟
Dialogue: 0,1:15:16.86,1:15:18.40,Default,,0,0,0,,...إيه، هل هذا مُمكن
Dialogue: 0,1:15:20.15,1:15:21.55,Default,,0,0,0,,!...لكن لماذا قام الأطفال
Dialogue: 0,1:15:40.50,1:15:42.55,Default,,0,0,0,,.ترتكب خطأً، أمورو
Dialogue: 0,1:15:42.70,1:15:45.65,Default,,0,0,0,,.على تلك المرأة ألّا تبقى في قبضتكم الآن
Dialogue: 0,1:15:45.85,1:15:48.50,Default,,0,0,0,,.نعم، بالفِعل، لتتمكّن من استخدام المعلومات ضدّ المُنظّمة
Dialogue: 0,1:15:48.60,1:15:50.50,Default,,0,0,0,,!لَن أسمح لك
Dialogue: 0,1:16:10.10,1:16:15.60,Default,,0,0,0,,و هكذا؟ ماذا ستفعل إن استعادت كوراساو ذاكرتها و تحدّثت إلى المُنظّمة؟
Dialogue: 0,1:16:15.60,1:16:17.15,Default,,0,0,0,,و ما علاقتكَ بهذا؟
Dialogue: 0,1:16:17.30,1:16:20.90,Default,,0,0,0,,!ستكون المعلومات في أيدي مكتب الأمن العام قبل أن تتمكّن من التّحرّك حتّى
Dialogue: 0,1:16:23.40,1:16:26.20,Default,,0,0,0,,اللّعنة، إلى أين ذهب أكاي؟
Dialogue: 0,1:16:27.13,1:16:28.60,Default,,0,0,0,,!إنّه لا يُجيب
Dialogue: 0,1:16:42.07,1:16:43.13,Default,,0,0,0,,!هناك في القِمّة
Dialogue: 0,1:16:44.90,1:16:45.55,Default,,0,0,0,,كيف؟
Dialogue: 0,1:17:05.75,1:17:06.70,Default,,0,0,0,,!لَن أستسلِم
Dialogue: 0,1:17:09.30,1:17:10.50,Default,,0,0,0,,هل تعِبتَ بالفِعل؟
Dialogue: 0,1:17:13.00,1:17:15.45,Default,,0,0,0,,!سأستمرّ حتّى النّهاية
Dialogue: 0,1:17:16.53,1:17:17.50,Default,,0,0,0,,!أكاي
Dialogue: 0,1:17:18.35,1:17:19.50,Default,,0,0,0,,!أنا في الأسفل
Dialogue: 0,1:17:19.50,1:17:21.50,Default,,0,0,0,,!أحتاجك! لا يُريدون إنقاذ كوراساو
Dialogue: 0,1:17:22.40,1:17:27.65,Default,,0,0,0,,!سيُفجّرون دُولاب فيريس
Dialogue: 0,1:17:28.15,1:17:30.80,Default,,0,0,0,,!أرجوك، أحتاج مُساعدتكَ هُنا
Dialogue: 0,1:17:31.00,1:17:34.30,Default,,0,0,0,,!علينا الإعتناء بالأمر قبل أن يُفجّروه
Dialogue: 0,1:17:34.30,1:17:35.65,Default,,0,0,0,,!هذا أمرٌ مُلِحٌّ جدّاً
Dialogue: 0,1:17:35.65,1:17:37.00,Default,,0,0,0,,حقّاً، كونان؟
Dialogue: 0,1:17:37.25,1:17:39.00,Default,,0,0,0,,أمورو، كيف وَصلتَ إلى هناك؟
Dialogue: 0,1:17:39.00,1:17:42.15,Default,,0,0,0,,لنتحدّث عن هذا لاحقاً. أين المُتفجّرات؟
Dialogue: 0,1:17:42.15,1:17:45.20,Default,,0,0,0,,!تمّ وَضعها في العديد من أماكن تخزين خراطيم المياه
Dialogue: 0,1:17:45.20,1:17:47.95,Default,,0,0,0,,،لا أعلَم كيف سيتمّ تفعيلها
Dialogue: 0,1:17:48.50,1:17:50.30,Default,,0,0,0,,!لكن علينا التّصرّف بسرعةٍ كبيرة
Dialogue: 0,1:17:52.77,1:17:55.60,Default,,0,0,0,,!فهمت! إتّصل بالإف بي آي و أبلِغهم
Dialogue: 0,1:17:59.13,1:18:01.70,Default,,0,0,0,,!أه، كان هذا جميلاً
Dialogue: 0,1:18:03.65,1:18:05.40,Default,,0,0,0,,!لا تفقدي الأمل، ران
Dialogue: 0,1:18:05.55,1:18:07.40,Default,,0,0,0,,!سنجده بالتّأكيد
Dialogue: 0,1:18:08.65,1:18:10.05,Default,,0,0,0,,.لكن هذه لَيست المُشكلة
Dialogue: 0,1:18:10.05,1:18:13.26,Default,,0,0,0,,ماذا سأفعل لَو أمسكتُ به يخونني مُتلَبّساً؟
Dialogue: 0,1:18:13.85,1:18:16.60,Default,,0,0,0,,!حقّاً ران، ألا تملكين أيّة صلابة؟
Dialogue: 0,1:18:16.75,1:18:20.50,Default,,0,0,0,,!تحتاجين لأن تغضبي و أن تقومي بتوبيخه
Dialogue: 0,1:18:20.50,1:18:22.50,Default,,0,0,0,,عن ماذا تتحدّثين، سونوكو؟
Dialogue: 0,1:18:22.50,1:18:26.40,Default,,0,0,0,,!لَم نبحث في أكثر الأماكن رومانسيّةً بعد
Dialogue: 0,1:18:26.75,1:18:28.33,Default,,0,0,0,,أين؟
Dialogue: 0,1:18:28.55,1:18:30.35,Default,,0,0,0,,.هناك! على يسارك
Dialogue: 0,1:18:32.43,1:18:33.65,Default,,0,0,0,,حوض الأسماك؟
Dialogue: 0,1:18:33.65,1:18:34.95,Default,,0,0,0,,!بالضّبط
Dialogue: 0,1:18:39.90,1:18:41.26,Default,,0,0,0,,إذاً، أمورو؟
Dialogue: 0,1:18:41.26,1:18:42.65,Default,,0,0,0,,.لَيس بعد
Dialogue: 0,1:18:47.70,1:18:49.36,Default,,0,0,0,,.بهذا، يُفترض أن يكون كلّ شيءٍ بخير
Dialogue: 0,1:18:50.55,1:18:53.00,Default,,0,0,0,,.إذاً فقد كان فخّاً بالفِعل
Dialogue: 0,1:18:53.00,1:18:57.00,Default,,0,0,0,,.نعم. كنتَ مُحقّاً بالبحث في هذه الأنحاء
Dialogue: 0,1:18:58.40,1:18:59.95,Default,,0,0,0,,أكاي، ماذا بشأن المُتفجّرات؟
Dialogue: 0,1:19:00.25,1:19:03.75,Default,,0,0,0,,.تُوجد بعض المُتفجّرات القويّة الموضوعة في بعض المَواقع الإستراتيجيّة
Dialogue: 0,1:19:04.25,1:19:08.80,Default,,0,0,0,,.تصنع نوراً بُرتقاليّاً عندما تنفجر
Dialogue: 0,1:19:08.80,1:19:10.25,Default,,0,0,0,,.هذا مُؤكّد
Dialogue: 0,1:19:11.40,1:19:14.66,Default,,0,0,0,,.لا شيء يكون مُفاجئاً عندما يتعلّق الأمر بهم
Dialogue: 0,1:19:16.13,1:19:16.66,Default,,0,0,0,,!هذه هي
Dialogue: 0,1:19:17.63,1:19:19.53,Default,,0,0,0,,إذاً، هل من مُشكلة؟
Dialogue: 0,1:19:19.83,1:19:22.50,Default,,0,0,0,,.لا مُشكلة، يُمكنني الإعتناء بهذا
Dialogue: 0,1:19:22.75,1:19:24.50,Default,,0,0,0,,.أفهم كيفيّة عملها
Dialogue: 0,1:19:24.60,1:19:27.20,Default,,0,0,0,,إيه، هل تعرف كيف تُعطّل المُتفجّرات، أمورو؟
Dialogue: 0,1:19:27.60,1:19:31.10,Default,,0,0,0,,.تعلّمتُ الكثير من الأُمور في أكاديميّة الشّرطة
Dialogue: 0,1:19:32.60,1:19:35.90,Default,,0,0,0,,.كنتُ تحت رعاية الأفضل في الأكاديميّة
Dialogue: 0,1:19:36.70,1:19:38.00,Default,,0,0,0,,،لكن على الرّغم من هذا
Dialogue: 0,1:19:38.53,1:19:42.10,Default,,0,0,0,,.إنتهى به الأمر بالموت خِلال إحدى مُحاولاته لتعطيل قُنبلة
Dialogue: 0,1:19:42.75,1:19:44.86,Default,,0,0,0,,مُعطّل قنابل يموت في انفجار...؟
Dialogue: 0,1:19:44.86,1:19:46.50,Default,,0,0,0,,.لا تقلَق
Dialogue: 0,1:19:46.50,1:19:48.50,Default,,0,0,0,,.كلّ شيءٍ تحت سيطرتي
Dialogue: 0,1:19:48.50,1:19:50.50,Default,,0,0,0,,.سترى هذا جيّداً
Dialogue: 0,1:19:50.85,1:19:51.75,Default,,0,0,0,,.إستخدم هذه
Dialogue: 0,1:19:54.43,1:19:56.05,Default,,0,0,0,,...من الآن فصاعداً
Dialogue: 0,1:19:56.35,1:19:57.95,Default,,0,0,0,,.سأسمح لكَ بالإعتناء بها
Dialogue: 0,1:19:58.10,1:19:59.10,Default,,0,0,0,,إلى أين ستذهب، أكاي؟
Dialogue: 0,1:19:59.40,1:20:04.30,Default,,0,0,0,,.هذا المبنى لَيس الوَحيد المليء بالمُتفجّرات على الأرجح
Dialogue: 0,1:20:04.80,1:20:07.50,Default,,0,0,0,,...هناك احتماليّة مُحاولتهم التّخلّص من كوراساو
Dialogue: 0,1:20:07.50,1:20:11.30,Default,,0,0,0,,.لذا قد يكون هناك البعض في دُولاب فيريس...
Dialogue: 0,1:20:11.60,1:20:12.90,Default,,0,0,0,,...بالتّأكيد
Dialogue: 0,1:20:13.30,1:20:17.10,Default,,0,0,0,,.نعم. سأُحاول اكتساب بعض الوَقت بالذّهاب إلى هناك
Dialogue: 0,1:20:17.60,1:20:19.85,Default,,0,0,0,,!إعتني بأمر المُتفجّرات
Dialogue: 0,1:20:21.25,1:20:22.70,Default,,0,0,0,,!القول أسهل من الفِعل
Dialogue: 0,1:20:23.15,1:20:24.65,Default,,0,0,0,,!أمورو، تفضّل، خُذه
Dialogue: 0,1:20:25.15,1:20:26.65,Default,,0,0,0,,.أه، شُكراً
Dialogue: 0,1:20:26.65,1:20:28.35,Default,,0,0,0,,...بالنّسبة له، يُمكنه الحديث
Dialogue: 0,1:20:28.65,1:20:30.93,Default,,0,0,0,,.لا نعلَم كم من الوَقت يُمكننا أن نكسب
Dialogue: 0,1:20:31.40,1:20:34.75,Default,,0,0,0,,.نعم، لا نعلَم متى سينفجرون
Dialogue: 0,1:20:35.00,1:20:36.45,Default,,0,0,0,,...لكن انتظر
Dialogue: 0,1:20:36.73,1:20:38.45,Default,,0,0,0,,!سيأتون بالتّأكيد
Dialogue: 0,1:20:40.45,1:20:41.65,Default,,0,0,0,,ما الأمر، كونان؟
Dialogue: 0,1:20:41.85,1:20:43.45,Default,,0,0,0,,!سأذهب لأحمي لائحة الجّواسيس
Dialogue: 0,1:20:44.15,1:20:46.04,Default,,0,0,0,,!هذان الإثنان مُتشابهان
Dialogue: 0,1:20:56.30,1:20:57.30,Default,,0,0,0,,...هذا
Dialogue: 0,1:20:57.50,1:20:58.70,Default,,0,0,0,,!كان لون الأضواء
Dialogue: 0,1:20:58.70,1:21:01.60,Default,,0,0,0,,!لهذا تذكّرت كوراساو قائمة الجّواسيس
Dialogue: 0,1:21:02.00,1:21:05.40,Default,,0,0,0,,!لهذا يُريدونها أن تكون على متن دُولاب فيريس
Dialogue: 0,1:21:06.70,1:21:12.40,Default,,0,0,0,,!إن كان استنتاجي صحيحاً، ستذكر لائحة الجّواسيس عندما ترى الألوان
Dialogue: 0,1:21:13.20,1:21:16.20,Default,,0,0,0,,.ذاكرَتُها أمرٌ مُهمٌّ بالنّسبة للمُنظّمة
Dialogue: 0,1:21:16.55,1:21:20.20,Default,,0,0,0,,،و... إن تذكّرَت كلّ المعلومات
Dialogue: 0,1:21:20.70,1:21:22.70,Default,,0,0,0,,!ستُفتح لها أبواب المُنظّمة ثانيةً
Dialogue: 0,1:21:23.15,1:21:25.36,Default,,0,0,0,,،لكن إن تذكّرَت
Dialogue: 0,1:21:25.52,1:21:28.60,Default,,0,0,0,,!جميع من حولها سيكونون في خطَر
Dialogue: 0,1:21:28.80,1:21:30.05,Default,,0,0,0,,.حان الوَقت تقريباً
Dialogue: 0,1:21:35.25,1:21:38.90,Default,,0,0,0,,.جين، إستعدّ. بقيَت 3 دقائق و 5 ثوانٍ
Dialogue: 0,1:21:38.90,1:21:40.00,Default,,0,0,0,,مُستعدّ؟
Dialogue: 0,1:21:40.00,1:21:42.50,Default,,0,0,0,,.مُستعدّون، يُمكننا التّنفيذ
Dialogue: 0,1:21:43.40,1:21:44.30,Default,,0,0,0,,!كيانتي
Dialogue: 0,1:21:44.80,1:21:48.83,Default,,0,0,0,,!زيدي السّرعة، إبدأي الإقتراب من الموقع
Dialogue: 0,1:21:49.10,1:21:49.75,Default,,0,0,0,,!حسناً
Dialogue: 0,1:21:54.50,1:21:58.05,Default,,0,0,0,,!أحتاج للإسراع، إن أبطأت، سيَنتهي الأمر
Dialogue: 0,1:21:58.90,1:22:00.40,Default,,0,0,0,,...بعد هذا، كلّ ما عليّ فِعله
Dialogue: 0,1:22:03.43,1:22:04.10,Default,,0,0,0,,!أه
Dialogue: 0,1:22:05.43,1:22:07.00,Default,,0,0,0,,!الأمر بخير، كان هذا قريباً
Dialogue: 0,1:22:09.20,1:22:11.10,Default,,0,0,0,,...عليكَ ألّا تتسرّع كثيراً
Dialogue: 0,1:22:12.05,1:22:14.80,Default,,0,0,0,,...تمكنتُ من تفادي أسوأ فخّ
Dialogue: 0,1:22:14.90,1:22:16.15,Default,,0,0,0,,.ماتسودا
Dialogue: 0,1:22:16.80,1:22:20.05,Default,,0,0,0,,.ماذا يعني هذا؟ إنّها لا تفعل أيّ شيء
Dialogue: 0,1:22:20.60,1:22:23.00,Default,,0,0,0,,.لا تُظهر أيّ ردّ فِعل
Dialogue: 0,1:22:23.20,1:22:26.10,Default,,0,0,0,,هل كان فورويا مُخطئاً إذاً؟
Dialogue: 0,1:22:39.40,1:22:40.50,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,1:22:42.40,1:22:44.25,Default,,0,0,0,,!هاي، تماسكي
Dialogue: 0,1:22:51.63,1:22:52.63,Default,,0,0,0,,ردّ فِعل؟
Dialogue: 0,1:22:52.90,1:22:54.63,Default,,0,0,0,,هل تعود ذاكرتها؟
Dialogue: 0,1:22:55.30,1:22:58.65,Default,,0,0,0,,...لا تُخبروني، البريد الإلكترونيّ الذي استلمه رم وَقتها
Dialogue: 0,1:22:58.65,1:23:00.65,Default,,0,0,0,,.إهدأي، إجلسي
Dialogue: 0,1:23:01.60,1:23:02.80,Default,,0,0,0,,!هاي، إبقي هادئة
Dialogue: 0,1:23:11.55,1:23:13.80,Default,,0,0,0,,.لا تُحاولي الهرب حتّى، كوراساو
Dialogue: 0,1:23:14.30,1:23:19.30,Default,,0,0,0,,.هذا ما يحصل عندما لا نُنجز مُهمّة المُنظّمة جيّداً
Dialogue: 0,1:23:20.00,1:23:22.65,Default,,0,0,0,,.عليّ الإعتراف بأنكِ أثرتِ إعجابي
Dialogue: 0,1:23:22.65,1:23:27.00,Default,,0,0,0,,.بارتكاب كلّ هذه الأخطاء، على الرّغم من امتلاك هذه الإمكانيّات العالية
Dialogue: 0,1:23:28.00,1:23:30.40,Default,,0,0,0,,.لكنّنا نفعل ما يجب فِعله
Dialogue: 0,1:23:30.40,1:23:34.65,Default,,0,0,0,,.لهذا السّبب لا خيار لَديّ. هذا هو قدَرُك
Dialogue: 0,1:23:35.40,1:23:37.85,Default,,0,0,0,,...وَداعاً، كوراساو
Dialogue: 0,1:23:39.90,1:23:40.80,Caracters,,0,0,0,,!إنتظري
Dialogue: 0,1:23:41.95,1:23:42.80,Default,,0,0,0,,...هل يُمكن
Dialogue: 0,1:23:46.90,1:23:48.75,Default,,0,0,0,,ماذا تفعل هُنا؟
Dialogue: 0,1:23:48.75,1:23:50.75,Caracters,,0,0,0,,.لا تُفكّري بهذا حتّى، فيرموث
Dialogue: 0,1:23:59.45,1:24:02.10,Caracters,,0,0,0,,...كوراساو، اللّون الذي يُناسبكِ
Dialogue: 0,1:24:03.10,1:24:05.33,Caracters,,0,0,0,,.هو أحلَك السّواد لوناً...
Dialogue: 0,1:24:05.75,1:24:07.05,Default,,0,0,0,,رم؟
Dialogue: 0,1:24:07.55,1:24:10.53,Caracters,,0,0,0,,.سأُبقيكِ هُنا لبعض الوَقت
Dialogue: 0,1:24:10.80,1:24:12.65,Caracters,,0,0,0,,...يُمكنكِ فِعل المُستحيل
Dialogue: 0,1:24:13.23,1:24:14.70,Caracters,,0,0,0,,...أنتِ أفضل رُسُلِنا
Dialogue: 0,1:24:14.70,1:24:16.95,Caracters,,0,0,0,,...حتّى أنا أُؤمن
Dialogue: 0,1:24:17.73,1:24:18.90,Caracters,,0,0,0,,.بهذا الشّيء ضِمنيّاً...
Dialogue: 0,1:24:19.13,1:24:20.63,Caracters,,0,0,0,,...تحرّري
Dialogue: 0,1:24:20.65,1:24:25.00,Caracters,,0,0,0,,!ستعملين تحت إمرَتي، كوراساو
Dialogue: 0,1:24:28.35,1:24:30.45,Default,,0,0,0,,!هاي، هل أنتِ بخير؟ تماسكي
Dialogue: 0,1:24:31.30,1:24:35.30,Default,,0,0,0,,.لا تتحرّكي، سأتّصل بالإسعاف
Dialogue: 0,1:24:35.95,1:24:37.10,Default,,0,0,0,,.هذا لَن يكون ضروريّاً
Dialogue: 0,1:24:46.35,1:24:48.20,Default,,0,0,0,,.أخيراً، لَقد عُدتّ
Dialogue: 0,1:24:49.40,1:24:51.95,Default,,0,0,0,,.كوراساو أمامي
Dialogue: 0,1:24:53.75,1:24:55.83,Default,,0,0,0,,.قبل دقيقتين من بِدء الخُطّة
Dialogue: 0,1:24:56.35,1:24:57.95,Default,,0,0,0,,ألا تظنّه الوَقت المُناسب للتّنفيذ؟
Dialogue: 0,1:24:59.55,1:25:00.95,Default,,0,0,0,,.فودكا، الرّافعة
Dialogue: 0,1:25:00.95,1:25:01.85,Default,,0,0,0,,!عُلِم
Dialogue: 0,1:25:04.25,1:25:05.50,Default,,0,0,0,,!تمّ فتح الباب
Dialogue: 0,1:25:21.10,1:25:24.55,Default,,0,0,0,,...صوت المُحرّك ذاك... إنّه يقترب
Dialogue: 0,1:25:32.00,1:25:35.50,Default,,0,0,0,,لكن، ما السّبب بوُجودهم في الأعلى؟
Dialogue: 0,1:25:46.40,1:25:47.40,Default,,0,0,0,,هل هذا مُمكن؟
Dialogue: 0,1:25:50.13,1:25:50.83,Default,,0,0,0,,من هذا؟
Dialogue: 0,1:25:51.65,1:25:53.25,Default,,0,0,0,,.مرّت فترةٌ طويلة، فيرموث
Dialogue: 0,1:25:54.15,1:25:56.40,Default,,0,0,0,,.كما توَقّعت، إستعدتّ ذاكرتك
Dialogue: 0,1:25:56.65,1:25:59.70,Default,,0,0,0,,...نعم، باستثناء أنّه
Dialogue: 0,1:26:00.13,1:26:02.73,Default,,0,0,0,,.يُخالِجني شُعورٌ بأنّه يتمّ التّجسّس عليّ
Dialogue: 0,1:26:02.73,1:26:06.05,Default,,0,0,0,,.لا مُشكلة، سيأتي جين في المِروحيّة لاستعادتك
Dialogue: 0,1:26:06.30,1:26:07.00,Default,,0,0,0,,جين؟
Dialogue: 0,1:26:07.40,1:26:10.60,Default,,0,0,0,,نعم، هل استعدتّ كامل ذكرياتك؟
Dialogue: 0,1:26:10.60,1:26:14.03,Default,,0,0,0,,...هل أرسلتِ بريداً إلكترونيّاً لرم
Dialogue: 0,1:26:14.76,1:26:17.95,Default,,0,0,0,,...إن ظهر بأنّ المُرسل لَم يكن أنتِ
Dialogue: 0,1:26:19.47,1:26:22.65,Default,,0,0,0,,.بالتّأكيد أنا من أرسلَه
Dialogue: 0,1:26:23.13,1:26:24.45,Default,,0,0,0,,هل من مُشكلة؟
Dialogue: 0,1:26:24.45,1:26:25.35,Default,,0,0,0,,أوه؟
Dialogue: 0,1:26:25.50,1:26:28.20,Default,,0,0,0,,.تمكّن كير و بوربون من الهرب بسبب هذا
Dialogue: 0,1:26:28.20,1:26:31.33,Default,,0,0,0,,.سيحين وَقتهما على أيّة حال
Dialogue: 0,1:26:32.83,1:26:35.05,Default,,0,0,0,,.لَقد حان الوَقت، ساندريلّا
Dialogue: 0,1:26:35.25,1:26:37.70,Default,,0,0,0,,.الآن إن سمحتِ، يُرجى انتظار عربة اليقطين
Dialogue: 0,1:26:37.80,1:26:38.60,Default,,0,0,0,,.حسناً
Dialogue: 0,1:26:39.75,1:26:44.55,Default,,0,0,0,,0 ...1 ،2 ،3 ،4
Dialogue: 0,1:26:58.20,1:26:58.95,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:27:00.00,1:27:01.30,Default,,0,0,0,,.اللّعنة. لَقد بدأوا بالفِعل
Dialogue: 0,1:27:02.40,1:27:06.15,Default,,0,0,0,,.بدأت فيرموث بتنفيذ الخُطّة
Dialogue: 0,1:27:06.65,1:27:07.35,Default,,0,0,0,,.حسناً
Dialogue: 0,1:27:08.05,1:27:11.20,Default,,0,0,0,,!سنبدأ بالخُطّة! أمسكي بكوراساو
Dialogue: 0,1:27:11.83,1:27:12.55,Default,,0,0,0,,!نعم، سيّدي
Dialogue: 0,1:27:14.90,1:27:16.85,Default,,0,0,0,,!حافظوا على هُدوئكم رجاءً
Dialogue: 0,1:27:16.85,1:27:19.75,Default,,0,0,0,,!رجاءً-\N!أنتُم تسخرون منّا-
Dialogue: 0,1:27:19.75,1:27:22.10,up,,0,0,0,,!حافظوا على الهُدوء
Dialogue: 0,1:27:22.00,1:27:23.70,Default,,0,0,0,,متى يُمكن أن نصل إلى هناك؟
Dialogue: 0,1:27:24.00,1:27:25.06,Default,,0,0,0,,!أشعر بالخوف
Dialogue: 0,1:27:25.06,1:27:26.00,Default,,0,0,0,,.سنَخرج
Dialogue: 0,1:27:26.00,1:27:27.45,Default,,0,0,0,,!جميعاً، لنَذهب إلى الأبواب
Dialogue: 0,1:27:27.45,1:27:29.90,Default,,0,0,0,,!كلّا، عليكم البقاء هُنا
Dialogue: 0,1:27:38.50,1:27:39.85,Default,,0,0,0,,لكن أين هُم بحقّ الله؟
Dialogue: 0,1:27:40.40,1:27:41.95,Default,,0,0,0,,!أحتاج لأن أجِدَهم
Dialogue: 0,1:27:42.55,1:27:45.15,Default,,0,0,0,,ماذا يحصل ثانيةً؟
Dialogue: 0,1:27:45.15,1:27:49.06,Default,,0,0,0,,...هذا مُقلِق، كلّ أولئكَ الأشخاص-\N!لا يُمكنني أن أرى جيّداً-
Dialogue: 0,1:27:49.06,1:27:51.43,Default,,0,0,0,,هل نقوم بالتّحرّك؟-\N!رُبّما لَيس بعد-
Dialogue: 0,1:27:51.65,1:27:53.65,Default,,0,0,0,,.هذا عقيم، لا يُمكننا فِعل الكثير في مثل هذا الوَضع
Dialogue: 0,1:27:55.40,1:27:56.85,Default,,0,0,0,,!ساتو، أكاغي
Dialogue: 0,1:27:57.73,1:28:01.23,Default,,0,0,0,,.كما توَقّعت، مكتب الأمن العام في مُهمّةٍ سرّيّة
Dialogue: 0,1:28:01.40,1:28:02.10,Default,,0,0,0,,!كنتُ وَاثقة
Dialogue: 0,1:28:02.10,1:28:03.70,Default,,0,0,0,,لكن ماذا يُفترض بنا أن نفعل؟
Dialogue: 0,1:28:04.13,1:28:05.70,Default,,0,0,0,,.ساعدوا المُواطنين هُنا
Dialogue: 0,1:28:06.00,1:28:07.45,Default,,0,0,0,,لكن ماذا عن مكتب الأمن العام؟
Dialogue: 0,1:28:07.45,1:28:10.55,Default,,0,0,0,,.لا وُجود لـ"لكن" علينا تحديد أولويّاتنا
Dialogue: 0,1:28:11.43,1:28:12.00,Default,,0,0,0,,هل هذا وَاضح؟
Dialogue: 0,1:28:12.10,1:28:12.67,Default,,0,0,0,,!نعم
Dialogue: 0,1:28:13.30,1:28:15.45,Default,,0,0,0,,.لا يبدو بأنّه هُنا بالفِعل
Dialogue: 0,1:28:16.50,1:28:17.73,Default,,0,0,0,,.أعتذر، سونوكو
Dialogue: 0,1:28:17.73,1:28:20.40,Default,,0,0,0,,.أضعتُ وَقتكِ بهذا
Dialogue: 0,1:28:20.75,1:28:23.40,Default,,0,0,0,,!هاي، نحتاج للخروج من هُنا، تُوجد مُشكلةٌ في الخارج
Dialogue: 0,1:28:26.20,1:28:28.50,Default,,0,0,0,,.إبتعدوا-\N.عُذراً، دعونا نمرّ-
Dialogue: 0,1:28:28.80,1:28:29.90,Default,,0,0,0,,!...أوه، هذا
Dialogue: 0,1:28:29.90,1:28:31.50,Default,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,1:28:32.40,1:28:34.75,Default,,0,0,0,,!من الصّعب تعطيل هذه المُتفجّرات
Dialogue: 0,1:28:35.55,1:28:37.83,Default,,0,0,0,,...إضافةً إلى أنّني أملك فقط القليل من الوَقت المُتبقّي
Dialogue: 0,1:28:37.83,1:28:39.95,Default,,0,0,0,,!عليّ ألّا أسمح لنَفسي بأن أشعر بالضّغط
Dialogue: 0,1:28:48.60,1:28:52.40,Default,,0,0,0,,هل ستنتظرين بهُدوءٍ هُنا قُدوم المُنظّمة؟
Dialogue: 0,1:28:59.00,1:29:01.40,Default,,0,0,0,,...أوه، لا، بالتّأكيد لَن يقوموا
Dialogue: 0,1:29:05.80,1:29:06.35,Default,,0,0,0,,...هذه
Dialogue: 0,1:29:09.35,1:29:10.85,Default,,0,0,0,,...إبدأ بالإقتراب
Dialogue: 0,1:29:11.05,1:29:13.75,Default,,0,0,0,,!سنحصل عليها قريباً، هيّا
Dialogue: 0,1:29:18.60,1:29:19.70,Default,,0,0,0,,عميل مكتب الأمن العام؟
Dialogue: 0,1:29:19.70,1:29:20.65,Default,,0,0,0,,...ممّا يعني
Dialogue: 0,1:29:20.95,1:29:23.30,Default,,0,0,0,,!كما ظننت، لَقد أتوا خلف كوراساو
Dialogue: 0,1:29:23.80,1:29:24.47,Default,,0,0,0,,!أوه، لا
Dialogue: 0,1:29:27.60,1:29:29.93,Default,,0,0,0,,!أيّها العم! إستيقظ، أيّها العم
Dialogue: 0,1:29:33.20,1:29:35.85,Default,,0,0,0,,...هذا القنّاص لَيس بالمهارة الكافية
Dialogue: 0,1:29:36.45,1:29:38.30,Default,,0,0,0,,.أحتاج مِنظاراً آخر
Dialogue: 0,1:29:45.70,1:29:46.85,Default,,0,0,0,,!اللّعنة
Dialogue: 0,1:29:58.40,1:30:00.25,Default,,0,0,0,,.لا يُمكنني فِعل شيءٍ من هُنا
Dialogue: 0,1:30:00.65,1:30:02.25,Default,,0,0,0,,!لنَذهب
Dialogue: 0,1:30:02.50,1:30:03.25,Default,,0,0,0,,!حسناً
Dialogue: 0,1:30:03.25,1:30:04.70,Default,,0,0,0,,.تُوجد مُشكلةٌ هُنا
Dialogue: 0,1:30:04.70,1:30:07.63,Default,,0,0,0,,.لا يبدو الهدف كما يُفترض أن يكون
Dialogue: 0,1:30:08.05,1:30:09.55,Default,,0,0,0,,هل حصل عليها مكتب الأمن العام بالفِعل؟
Dialogue: 0,1:30:10.05,1:30:11.55,Default,,0,0,0,,.قُم بعمل مَسحٍ للمُحيط
Dialogue: 0,1:30:11.55,1:30:12.16,Default,,0,0,0,,!عُلِم
Dialogue: 0,1:30:15.25,1:30:16.60,Default,,0,0,0,,...هناك فقط شخصٌ فاقدٌ الوَعي
Dialogue: 0,1:30:16.80,1:30:18.85,Default,,0,0,0,,!و معه طِفل...
Dialogue: 0,1:30:19.15,1:30:21.10,Default,,0,0,0,,!أخي! لَقد هربَت كوراساو
Dialogue: 0,1:30:21.25,1:30:21.90,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:30:23.15,1:30:24.10,Default,,0,0,0,,!كوراساو
Dialogue: 0,1:30:24.80,1:30:25.90,Default,,0,0,0,,.أسقِط تلك المقصورة
Dialogue: 0,1:30:25.90,1:30:27.10,Default,,0,0,0,,!عُـ... عُلِم
Dialogue: 0,1:30:28.23,1:30:28.86,Default,,0,0,0,,!هاي! هاي
Dialogue: 0,1:30:29.60,1:30:30.55,Default,,0,0,0,,هل تتحرّك؟
Dialogue: 0,1:30:44.30,1:30:45.76,Default,,0,0,0,,جين، ماذا يحصل؟
Dialogue: 0,1:30:46.03,1:30:47.43,Default,,0,0,0,,.إختفت كوراساو
Dialogue: 0,1:30:47.43,1:30:48.40,Default,,0,0,0,,إيه؟
Dialogue: 0,1:30:48.40,1:30:49.43,Default,,0,0,0,,.سنُغيّر الخُطّة
Dialogue: 0,1:30:49.43,1:30:50.80,Default,,0,0,0,,!سنبحث عن كوراساو
Dialogue: 0,1:30:51.05,1:30:52.25,Default,,0,0,0,,!كنتُ وَاثقة
Dialogue: 0,1:30:52.40,1:30:54.25,Default,,0,0,0,,.إذاً فقد خانتنا
Dialogue: 0,1:30:54.60,1:30:56.36,Default,,0,0,0,,.كان عليها التّفكير بالأمر قبل أن تهرب
Dialogue: 0,1:30:56.46,1:30:58.90,Default,,0,0,0,,.ستدفع الثّمن على هذا
Dialogue: 0,1:30:59.20,1:31:00.60,Default,,0,0,0,,!جِدها في الحال
Dialogue: 0,1:31:00.60,1:31:01.37,Default,,0,0,0,,!عُلِم
Dialogue: 0,1:31:01.37,1:31:03.80,Default,,0,0,0,,.كيانتي، إقتربي أكثر من القِمّة
Dialogue: 0,1:31:03.90,1:31:04.65,Default,,0,0,0,,!عُلِم
Dialogue: 0,1:31:04.85,1:31:07.20,Default,,0,0,0,,.كورن، صوّب على الهدف
Dialogue: 0,1:31:07.20,1:31:08.25,Default,,0,0,0,,.حسناً
Dialogue: 0,1:31:23.45,1:31:24.40,Default,,0,0,0,,...هل هذا مُمكن
Dialogue: 0,1:31:33.90,1:31:37.10,Default,,0,0,0,,ماذا، هل تُريدين أخذي إليهم؟
Dialogue: 0,1:31:37.70,1:31:40.20,Default,,0,0,0,,هُم"... هل تعنين المُنظّمة؟"
Dialogue: 0,1:31:40.20,1:31:42.40,Default,,0,0,0,,.لَقد عادت ذاكرتها بالفِعل
Dialogue: 0,1:31:43.20,1:31:46.40,Default,,0,0,0,,هل يُمكن أنّكِ الخائنة شيري؟
Dialogue: 0,1:31:48.40,1:31:50.20,Default,,0,0,0,,.سيكون الوَضع خطِراً هُنا
Dialogue: 0,1:31:50.50,1:31:51.80,Default,,0,0,0,,.عليكِ أن تهربي
Dialogue: 0,1:31:51.80,1:31:53.50,Default,,0,0,0,,ماذا تعنين بـ"الهرب"؟
Dialogue: 0,1:31:53.50,1:31:55.20,Default,,0,0,0,,!توَقّفي عن المُزاح
Dialogue: 0,1:31:55.20,1:31:56.15,Default,,0,0,0,,.جين سيأتي
Dialogue: 0,1:31:56.80,1:31:59.30,Default,,0,0,0,,.أظنّكِ تفهمين ما معنى هذا
Dialogue: 0,1:32:00.20,1:32:01.80,Default,,0,0,0,,...لكن لماذا أنتِ
Dialogue: 0,1:32:02.15,1:32:03.00,Default,,0,0,0,,،لا أعلَم
Dialogue: 0,1:32:03.50,1:32:05.60,Default,,0,0,0,,.لا أعلَم لماذا أُنقذكِ
Dialogue: 0,1:32:06.60,1:32:10.05,Default,,0,0,0,,.لكنّني كنتُ أتسائل عن ماهيّة لون كوراساو
Dialogue: 0,1:32:10.45,1:32:14.20,Default,,0,0,0,,لكن شخصي القديمة، هل كانت أفضل من شخصيّتي الآن؟
Dialogue: 0,1:32:14.60,1:32:16.40,Default,,0,0,0,,.هذا كلّ ما أرغب بمعرفته
Dialogue: 0,1:32:19.60,1:32:21.95,Default,,0,0,0,,.حسناً الآن، إبتعدي، شيري
Dialogue: 0,1:32:22.10,1:32:22.80,Default,,0,0,0,,!إنتظري
Dialogue: 0,1:32:23.53,1:32:25.63,Default,,0,0,0,,!الأطفال الذين كنتِ معهم في المقصورة
Dialogue: 0,1:32:25.85,1:32:27.60,Default,,0,0,0,,!علينا مُساعدتهم
Dialogue: 0,1:32:31.00,1:32:33.30,Default,,0,0,0,,.لا أفهم طبيعة صمّام أمان المُتفجّرات
Dialogue: 0,1:32:34.10,1:32:37.10,Default,,0,0,0,,.حسناً، يُفترض أن أتمكّن من فِعلها
Dialogue: 0,1:32:37.40,1:32:38.56,Default,,0,0,0,,...ركّز
Dialogue: 0,1:32:39.03,1:32:40.50,Default,,0,0,0,,.إفعل لأجله
Dialogue: 0,1:32:40.85,1:32:41.95,Default,,0,0,0,,!بسرعة، أسرَع
Dialogue: 0,1:32:44.70,1:32:45.45,Default,,0,0,0,,!أيّها العم
Dialogue: 0,1:32:47.05,1:32:48.40,Default,,0,0,0,,!أيّها العم، تماسك
Dialogue: 0,1:32:50.95,1:32:51.86,Default,,0,0,0,,!هذا خطِر
Dialogue: 0,1:32:56.85,1:32:57.60,Default,,0,0,0,,ألا شيء بعد؟
Dialogue: 0,1:32:58.10,1:33:00.15,Default,,0,0,0,,أمازلتَ لَم تجد كوراساو بعد؟
Dialogue: 0,1:33:00.55,1:33:05.10,Default,,0,0,0,,.كلّا، يتعذّر إيجادها، يُوجد فقط طِفلٌ و شخصان آخران
Dialogue: 0,1:33:05.40,1:33:07.40,Default,,0,0,0,,!هذا لَيس جيّداً، أخي
Dialogue: 0,1:33:07.75,1:33:09.70,Default,,0,0,0,,!إنّهم يُعطّلون المُتفجّرات
Dialogue: 0,1:33:09.90,1:33:10.83,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:33:10.83,1:33:11.75,Default,,0,0,0,,!هذا
Dialogue: 0,1:33:12.25,1:33:15.10,Default,,0,0,0,,!وَاثقٌ من أنّه لَم يكن هناك سابقاً
Dialogue: 0,1:33:17.05,1:33:18.75,Default,,0,0,0,,!مكتب الأمن العام يقوم بتحرّكه بالفِعل
Dialogue: 0,1:33:19.65,1:33:22.30,Default,,0,0,0,,...بقي كيبلان فقط
Dialogue: 0,1:33:26.20,1:33:28.30,Default,,0,0,0,,.بهذا، سينتهي الأمر
Dialogue: 0,1:33:36.30,1:33:37.20,Default,,0,0,0,,!يا إلهي
Dialogue: 0,1:33:39.65,1:33:41.23,Default,,0,0,0,,.كان هذا قريباً
Dialogue: 0,1:33:51.50,1:33:52.90,Default,,0,0,0,,.سأُسيطر على كلّ شيء، كورن
Dialogue: 0,1:33:53.40,1:33:54.95,Default,,0,0,0,,!أنت، أطلِق النّار في الحال
Dialogue: 0,1:33:58.53,1:34:01.40,Default,,0,0,0,,!فجّر كلّ ما في جانبك، كورن
Dialogue: 0,1:34:01.70,1:34:02.30,Default,,0,0,0,,!حسناً
Dialogue: 0,1:34:09.95,1:34:11.45,Default,,0,0,0,,ماذا يحصل بالضّبط؟
Dialogue: 0,1:34:14.00,1:34:15.76,Default,,0,0,0,,!اللّعنة، لابدّ من أن أفعل شيئاً ما
Dialogue: 0,1:34:20.63,1:34:22.15,Default,,0,0,0,,!هذا سيّء
Dialogue: 0,1:34:24.06,1:34:25.60,Default,,0,0,0,,.لَن أتمكّن من التّصويب
Dialogue: 0,1:34:29.00,1:34:30.06,Default,,0,0,0,,!الأطفال لا يُجيبون
Dialogue: 0,1:34:30.06,1:34:33.15,Default,,0,0,0,,.لا يُمكننا فِعل أيّ شيء، لا نعرف مكانهم
Dialogue: 0,1:34:34.06,1:34:35.86,Default,,0,0,0,,!آمل أن يكون الأطفال بخير
Dialogue: 0,1:34:36.43,1:34:37.90,Default,,0,0,0,,!بسرعة، إقفزي
Dialogue: 0,1:34:38.90,1:34:39.90,Default,,0,0,0,,!إنطلِقي
Dialogue: 0,1:34:55.90,1:35:00.25,Default,,0,0,0,,!اللّعنة! إن استمرّ الوَضع هكذا، لَن أتمكّن من إنقاذ الأطفال
Dialogue: 0,1:35:02.00,1:35:03.65,Default,,0,0,0,,.أُتركي أمرهم لي
Dialogue: 0,1:35:03.95,1:35:05.10,Default,,0,0,0,,...إيه، أنتِ
Dialogue: 0,1:35:05.80,1:35:06.80,Default,,0,0,0,,...لا تُخبريني بأنّكِ سوف
Dialogue: 0,1:35:07.15,1:35:08.90,Default,,0,0,0,,.أترك الأطفال تحت رعايتك
Dialogue: 0,1:35:09.20,1:35:11.15,Default,,0,0,0,,!لا تفعلي! سيقتلونك
Dialogue: 0,1:35:15.63,1:35:17.95,Default,,0,0,0,,...أخي، تلك الهيئة
Dialogue: 0,1:35:17.95,1:35:19.30,Default,,0,0,0,,!إنّها كوراساو
Dialogue: 0,1:35:24.55,1:35:26.63,Default,,0,0,0,,.أحتاج للتّركيز حتّى يحين الوَقت المُناسب
Dialogue: 0,1:35:27.80,1:35:29.20,Default,,0,0,0,,.لَقد توَقّف
Dialogue: 0,1:35:29.45,1:35:30.77,Default,,0,0,0,,!لابدّ من أنّ أحدهم قد شتّت انتباههم
Dialogue: 0,1:35:34.60,1:35:36.00,Default,,0,0,0,,!موتي، كوراساو
Dialogue: 0,1:35:59.20,1:36:00.50,Default,,0,0,0,,...هي
Dialogue: 0,1:36:03.40,1:36:05.40,Default,,0,0,0,,.لَقد أُصيبت كوراساو
Dialogue: 0,1:36:05.80,1:36:07.05,Default,,0,0,0,,!إكتملَت المُهمّة
Dialogue: 0,1:36:07.25,1:36:08.95,Default,,0,0,0,,.كلّا، رُبّما ماتزال على قيد الحياة
Dialogue: 0,1:36:09.80,1:36:11.90,Default,,0,0,0,,.فجّر القنابل
Dialogue: 0,1:36:12.60,1:36:14.10,Default,,0,0,0,,.علينا تفجير آكسيل دولاب فيريس
Dialogue: 0,1:36:14.10,1:36:16.30,Default,,0,0,0,,ا... الآكسيل؟
Dialogue: 0,1:36:16.75,1:36:23.60,Default,,0,0,0,,.نعم، إن كانت كوراساو ماتزل على قيد الحياة، لَن تبقى إن سحقها الدّولاب
Dialogue: 0,1:36:24.15,1:36:26.90,Default,,0,0,0,,.سيشعر مكتب الأمن العام بخيبة الأمل برؤية أنّها قد اختفت
Dialogue: 0,1:36:27.35,1:36:30.50,Default,,0,0,0,,!كورن، إبدأ بإطلاق النّار ثانيةً
Dialogue: 0,1:36:31.00,1:36:33.00,Default,,0,0,0,,.أسرِع و اسحقها إلى أشلاء
Dialogue: 0,1:36:33.10,1:36:34.90,Default,,0,0,0,,.نعم، عُلِم
Dialogue: 0,1:36:37.40,1:36:38.50,Default,,0,0,0,,!هايبارا
Dialogue: 0,1:36:39.90,1:36:41.05,Default,,0,0,0,,ألَم تُصابوا بأذى؟
Dialogue: 0,1:36:41.15,1:36:42.35,Default,,0,0,0,,.نعم
Dialogue: 0,1:36:42.35,1:36:45.10,Default,,0,0,0,,آي! ما الذي يحصل؟
Dialogue: 0,1:36:45.30,1:36:46.95,Default,,0,0,0,,.سأشرح لاحقاً
Dialogue: 0,1:36:47.20,1:36:48.65,Default,,0,0,0,,.لكن علينا المُحافظة على هدوئنا
Dialogue: 0,1:36:48.70,1:36:49.75,Default,,0,0,0,,!حسناً
Dialogue: 0,1:36:50.20,1:36:51.55,Default,,0,0,0,,!أكاي
Dialogue: 0,1:36:52.35,1:36:53.55,Default,,0,0,0,,!أمورو
Dialogue: 0,1:36:53.60,1:36:54.40,Default,,0,0,0,,هل أنتَ هناك؟
Dialogue: 0,1:36:55.40,1:36:56.10,Default,,0,0,0,,!أكاي
Dialogue: 0,1:36:59.05,1:37:00.63,Default,,0,0,0,,ألَم تتأذّى، أيّها الطّفل؟
Dialogue: 0,1:37:00.63,1:37:01.35,Default,,0,0,0,,.كلّا
Dialogue: 0,1:37:01.60,1:37:04.50,Default,,0,0,0,,.إنتظر، لَم أنتهي بعد
Dialogue: 0,1:37:06.05,1:37:07.00,Default,,0,0,0,,أين أمورو؟
Dialogue: 0,1:37:07.83,1:37:08.50,Default,,0,0,0,,.لا أملِك فِكرة
Dialogue: 0,1:37:08.50,1:37:11.90,Default,,0,0,0,,...لكن نظراً إلى كيفيّة قيامهم بتغيير استراتيجيّتهم
Dialogue: 0,1:37:11.90,1:37:14.37,Default,,0,0,0,,.لابدّ من أنّه قد قام بتعطيل المُتفجّرات...
Dialogue: 0,1:37:14.80,1:37:16.60,Default,,0,0,0,,ماذا سيفعلون الآن؟
Dialogue: 0,1:37:16.60,1:37:18.40,Default,,0,0,0,,هل رُبّما تُريد بُندقيتي؟
Dialogue: 0,1:37:20.40,1:37:21.15,Default,,0,0,0,,!أمورو
Dialogue: 0,1:37:21.60,1:37:25.10,Default,,0,0,0,,!علينا القيام بهُجومٍ مُضاد، أيّها الإف بي آي
Dialogue: 0,1:37:25.35,1:37:26.83,Default,,0,0,0,,!لا يُمكنني فِعل شيء
Dialogue: 0,1:37:27.25,1:37:29.70,Default,,0,0,0,,.مِنظار بُندقيّتي مُتضرّر
Dialogue: 0,1:37:29.75,1:37:33.55,Default,,0,0,0,,...مجال تصويبي الآخر لَيس جيّداً بما يكفي للتّصويب الدّقيق
Dialogue: 0,1:37:33.85,1:37:37.10,Default,,0,0,0,,.و المكان مُظلِمٌ جدّاً للتّصويب أيضاً...
Dialogue: 0,1:37:37.70,1:37:39.40,Default,,0,0,0,,هل يُمكنكَ التّصويب بوُجود نورٍ كافٍ؟
Dialogue: 0,1:37:39.70,1:37:39.90,Default,,0,0,0,,.نعم
Dialogue: 0,1:37:40.40,1:37:41.60,Default,,0,0,0,,لكن كيف نُجبرهم على الإنخفاض؟
Dialogue: 0,1:37:41.75,1:37:44.50,Default,,0,0,0,,.رُبّما باستخدام جُزء المِروحة الدّوّار الضّعيف
Dialogue: 0,1:37:44.65,1:37:46.50,Default,,0,0,0,,هل يُمكنكَ رُؤيته من هُنا؟
Dialogue: 0,1:37:46.90,1:37:49.00,Default,,0,0,0,,.بسماءٍ بهذه الظّلمة، كلّا
Dialogue: 0,1:37:49.74,1:37:55.30,Default,,0,0,0,,.لكن بالتّصويب على المِروحة، بنورٍ كافٍ، نعم
Dialogue: 0,1:37:55.80,1:37:57.60,Default,,0,0,0,,،يُمكنني أن أُنير السّماء
Dialogue: 0,1:37:58.03,1:38:00.93,Default,,0,0,0,,.لكنّني بحاجةٍ لمَصدر نورٍ للتّصويب جيّداً
Dialogue: 0,1:38:08.40,1:38:10.90,Default,,0,0,0,,هُم ثانيةً؟ إذاً يرغبون بتدمير كلّ شيء؟
Dialogue: 0,1:38:11.73,1:38:13.95,Default,,0,0,0,,.لابدّ من أنّ لَديهم هدفاً آخر
Dialogue: 0,1:38:15.50,1:38:19.25,Default,,0,0,0,,!هذا سيّء، يُمكن لنِصف المُتفجّرات أن تنفجر
Dialogue: 0,1:38:21.63,1:38:23.00,Default,,0,0,0,,!موتوا، جميعكم
Dialogue: 0,1:38:24.13,1:38:29.15,Default,,0,0,0,,!اللّعنة! لا أعلَم ماذا يُمكنني أن أفعل للمُساعدة
Dialogue: 0,1:38:29.15,1:38:31.60,Default,,0,0,0,,!إستخدمها لتُساعدكَ على التّصويب
Dialogue: 0,1:38:32.90,1:38:33.47,Default,,0,0,0,,!حسناً
Dialogue: 0,1:38:36.10,1:38:37.60,Default,,0,0,0,,!خُذ هذا
Dialogue: 0,1:38:46.20,1:38:47.00,Default,,0,0,0,,!يُمكنني رُؤيتها
Dialogue: 0,1:38:53.40,1:38:55.80,Default,,0,0,0,,!!!!إنطلِقي
Dialogue: 0,1:39:13.23,1:39:14.26,Default,,0,0,0,,...ذلك النّور
Dialogue: 0,1:39:14.26,1:39:15.50,Default,,0,0,0,,ما كان ذلك؟
Dialogue: 0,1:39:15.50,1:39:16.20,Default,,0,0,0,,...إيه، هذه
Dialogue: 0,1:39:16.20,1:39:17.40,Default,,0,0,0,,ألعابٌ ناريّة؟
Dialogue: 0,1:39:17.55,1:39:19.60,Default,,0,0,0,,!لَقد أُصِبنا-\Nما هذا؟-
Dialogue: 0,1:39:20.10,1:39:21.45,Default,,0,0,0,,من أين أتى هذا بحقّ الله؟
Dialogue: 0,1:39:25.50,1:39:26.35,Default,,0,0,0,,!الآن
Dialogue: 0,1:39:34.65,1:39:35.40,Default,,0,0,0,,!لَقد نجحنا
Dialogue: 0,1:39:35.55,1:39:36.20,Default,,0,0,0,,!نعم
Dialogue: 0,1:39:43.90,1:39:47.30,Default,,0,0,0,,!تبّاً! فقدتّ السّيطرة
Dialogue: 0,1:39:47.55,1:39:48.50,Default,,0,0,0,,!كورن، تحرّك
Dialogue: 0,1:39:52.60,1:39:53.60,Default,,0,0,0,,!اللّعنة
Dialogue: 0,1:39:55.90,1:39:58.30,Default,,0,0,0,,!سيُصبح الوَضع خطِراً إن استمرّوا بهذا
Dialogue: 0,1:40:38.10,1:40:39.75,Default,,0,0,0,,!هذا مُستحيل، سنتحطّم
Dialogue: 0,1:40:43.15,1:40:44.75,Default,,0,0,0,,!!أُهربوا
Dialogue: 0,1:40:51.70,1:40:52.46,Default,,0,0,0,,!هذا سيّء
Dialogue: 0,1:40:52.75,1:40:54.90,Default,,0,0,0,,!...بهذا المُعدّل، حوض الأسماك بأكمله سوف
Dialogue: 0,1:41:00.80,1:41:03.55,Default,,0,0,0,,لكن من كان هؤلاء؟
Dialogue: 0,1:41:03.90,1:41:08.40,Default,,0,0,0,,.همم، حاولوا قتلنا، لكن لَم يحن الوَقت بعد
Dialogue: 0,1:41:09.45,1:41:13.40,Default,,0,0,0,,!أيّها السيّدات و السّادة، أرجو التحرّك بسرعةٍ نحو الإستاد
Dialogue: 0,1:41:14.70,1:41:15.73,Default,,0,0,0,,...ماذا يحصل
Dialogue: 0,1:41:15.73,1:41:17.50,Default,,0,0,0,,!ران، علينا الذّهاب
Dialogue: 0,1:41:31.15,1:41:33.05,Default,,0,0,0,,!اللّعنة! لَن يتوَقّف دُولاب فيريس
Dialogue: 0,1:41:33.40,1:41:34.15,Default,,0,0,0,,!كونان
Dialogue: 0,1:41:36.60,1:41:37.40,Default,,0,0,0,,!أمورو
Dialogue: 0,1:41:37.70,1:41:39.05,Default,,0,0,0,,هل يُمكنكَ إيقافه؟
Dialogue: 0,1:41:39.05,1:41:41.05,Default,,0,0,0,,!لا أعلَم، سأُحاول
Dialogue: 0,1:41:47.30,1:41:47.95,Default,,0,0,0,,!أمورو
Dialogue: 0,1:41:48.10,1:41:49.73,Default,,0,0,0,,!الأمر على ما يُرام، لا تقلَق
Dialogue: 0,1:41:52.20,1:41:53.00,Default,,0,0,0,,!ها نحن ذا
Dialogue: 0,1:41:53.10,1:41:53.65,Default,,0,0,0,,!نعم
Dialogue: 0,1:42:01.10,1:42:05.50,Default,,0,0,0,,!ها أنا ذا
Dialogue: 0,1:42:09.95,1:42:10.75,Default,,0,0,0,,!أكاي
Dialogue: 0,1:42:10.90,1:42:12.60,Default,,0,0,0,,هل تحتاج للمُساعدة؟
Dialogue: 0,1:42:31.60,1:42:32.30,Default,,0,0,0,,كيف هذا؟
Dialogue: 0,1:42:35.05,1:42:35.85,Default,,0,0,0,,!نعم
Dialogue: 0,1:42:36.40,1:42:37.40,Default,,0,0,0,,كلّا... لَيس بعد؟
Dialogue: 0,1:42:39.60,1:42:40.70,Default,,0,0,0,,!سونوكو، أسرعي
Dialogue: 0,1:42:41.90,1:42:43.25,Default,,0,0,0,,هل أنتَ وَاثق؟
Dialogue: 0,1:42:43.60,1:42:45.30,Default,,0,0,0,,!لا تقلَق، سينجح الأمر
Dialogue: 0,1:42:49.00,1:42:49.70,Default,,0,0,0,,!كودو؟
Dialogue: 0,1:42:52.45,1:42:54.70,Default,,0,0,0,,!اللّعنة! لَن ينجح هذا
Dialogue: 0,1:42:56.70,1:42:57.90,Default,,0,0,0,,!أمسك بيدي
Dialogue: 0,1:42:58.70,1:43:00.45,Default,,0,0,0,,!أكاي
Dialogue: 0,1:43:09.10,1:43:10.40,Default,,0,0,0,,،و بعدها
Dialogue: 0,1:43:10.55,1:43:11.33,Default,,0,0,0,,ماذا عن هذا؟
Dialogue: 0,1:43:14.20,1:43:14.90,Default,,0,0,0,,!ران؟
Dialogue: 0,1:43:15.90,1:43:16.90,Default,,0,0,0,,!كُرة قدم؟
Dialogue: 0,1:43:17.50,1:43:20.00,Default,,0,0,0,,!المزيد، نحتاج للمزيد من القوّة
Dialogue: 0,1:43:20.80,1:43:22.20,Default,,0,0,0,,!هذا لا ينجح
Dialogue: 0,1:43:22.50,1:43:24.10,Default,,0,0,0,,!أُهربوا
Dialogue: 0,1:43:26.85,1:43:28.90,Default,,0,0,0,,!هذا سيّء، سُرعتنا تزداد
Dialogue: 0,1:43:53.20,1:43:54.30,Default,,0,0,0,,...جميعكم
Dialogue: 0,1:43:59.55,1:44:02.50,Default,,0,0,0,,!!!لَن أسمح بحُصول هذا
Dialogue: 0,1:44:20.55,1:44:22.25,Default,,0,0,0,,هل توَقّف عن الحركة؟
Dialogue: 0,1:44:22.25,1:44:24.20,Default,,0,0,0,,!نعم، لَقد تمّ إنقاذنا
Dialogue: 0,1:44:24.20,1:44:26.55,Default,,0,0,0,,!أنقذَنا كونان
Dialogue: 0,1:44:34.25,1:44:35.40,Default,,0,0,0,,...لكن كيف
Dialogue: 0,1:44:36.20,1:44:39.10,Default,,0,0,0,,كيف أوقفَت الحبال دُولاب فيريس؟
Dialogue: 0,1:44:40.50,1:44:41.70,Default,,0,0,0,,...لكن دُولاب فيريس
Dialogue: 0,1:44:42.35,1:44:43.80,Default,,0,0,0,,من أوقفه؟
Dialogue: 0,1:44:44.33,1:44:46.90,Default,,0,0,0,,.أحسنت، أيّها الطّفل
Dialogue: 0,1:44:48.30,1:44:49.30,Default,,0,0,0,,.نعم
Dialogue: 0,1:44:59.20,1:45:02.15,Default,,0,0,0,,.إنتظروا، سنقوم بتفحّصها
Dialogue: 0,1:45:02.60,1:45:04.16,Default,,0,0,0,,أوه، هل تبحثون عن أحدهم؟
Dialogue: 0,1:45:04.46,1:45:06.85,Default,,0,0,0,,.لكن أعتذر إن لَم تتمكّنوا من التّعرّف عليه بعد الآن
Dialogue: 0,1:45:07.30,1:45:10.30,Default,,0,0,0,,.حسناً، يُمكنكم الذّهاب الآن
Dialogue: 0,1:45:13.00,1:45:13.93,Default,,0,0,0,,...لكن هذا
Dialogue: 0,1:45:14.20,1:45:15.06,Default,,0,0,0,,...نعم
Dialogue: 0,1:45:16.10,1:45:16.63,Default,,0,0,0,,،أيّها الطّفل
Dialogue: 0,1:45:17.30,1:45:19.20,Default,,0,0,0,,هل يُمكنني رُؤيته؟
Dialogue: 0,1:45:21.10,1:45:22.60,Default,,0,0,0,,ما هذا؟
Dialogue: 0,1:45:22.70,1:45:24.40,Default,,0,0,0,,!رُبّما له علاقةٌ بفُقدان ذاكرتها
Dialogue: 0,1:45:24.90,1:45:25.50,Default,,0,0,0,,.كلّا
Dialogue: 0,1:45:26.80,1:45:27.90,Default,,0,0,0,,...لا علاقة له بفُقدان ذاكرتها
Dialogue: 0,1:45:28.40,1:45:29.45,Default,,0,0,0,,.لكن بذِكرياتها...
Dialogue: 0,1:45:32.20,1:45:34.75,Default,,0,0,0,,.ذِكرياتٌ قد تمّ التّعتيم عليها إلى الأبد
Dialogue: 0,1:49:55.95,1:49:59.50,Default,,0,0,0,,.آاااه... كِدتّ أنجح
Dialogue: 0,1:49:59.75,1:50:01.75,Default,,0,0,0,,!تستحقّ هذا
Dialogue: 0,1:50:02.15,1:50:05.67,Default,,0,0,0,,.غينتا، هل هذا قولك؟ لَستَ الشّخص المُناسب لقول هذا
Dialogue: 0,1:50:05.67,1:50:07.25,Default,,0,0,0,,!ماذا قُلت؟ سأُريك
Dialogue: 0,1:50:07.25,1:50:08.00,Default,,0,0,0,,...تلك المرأة
Dialogue: 0,1:50:08.50,1:50:12.05,Default,,0,0,0,,لَقد أنقذتنا، صحيح؟
Dialogue: 0,1:50:12.20,1:50:13.35,Default,,0,0,0,,...نعم
Dialogue: 0,1:50:14.10,1:50:17.45,Default,,0,0,0,,.لَم أتوَقّع لها الموت بهذه الطّريقة
Dialogue: 0,1:50:18.20,1:50:19.85,Default,,0,0,0,,...لكن، لماذا قامت
Dialogue: 0,1:50:20.40,1:50:21.65,Default,,0,0,0,,...بإنقاذنا...
Dialogue: 0,1:50:22.20,1:50:24.73,Default,,0,0,0,,.نعم، فُزنا بجائزة
Dialogue: 0,1:50:24.83,1:50:26.50,Default,,0,0,0,,!حصلنا على حاملات مفاتيحنا
Dialogue: 0,1:50:26.50,1:50:28.50,Default,,0,0,0,,.سعيدٌ لحُصولي على وَاحدة
Dialogue: 0,1:50:28.93,1:50:29.65,Default,,0,0,0,,صحيح؟
Dialogue: 0,1:50:29.80,1:50:33.10,Default,,0,0,0,,نعم، الجّميع قد حصل على خاصّته، صحيح؟
Dialogue: 0,1:50:33.13,1:50:33.72,Default,,0,0,0,,.ها هي خاصّتي
Dialogue: 0,1:50:33.72,1:50:34.90,Default,,0,0,0,,!و خاصّتي
Dialogue: 0,1:50:34.90,1:50:35.75,Default,,0,0,0,,...رائع
Dialogue: 0,1:50:36.00,1:50:37.20,Default,,0,0,0,,...لكن
Dialogue: 0,1:50:37.20,1:50:39.20,Default,,0,0,0,,.كلّ هذا يُشعرني بالحُزن
Dialogue: 0,1:50:39.35,1:50:42.93,Default,,0,0,0,,.الآن باستعادتها لذاكرتها، عادت لمنزلها
Dialogue: 0,1:50:43.00,1:50:46.45,Default,,0,0,0,,.أتسائل إن كنّا مانزال أصدقاءها
Dialogue: 0,1:50:46.55,1:50:47.50,Default,,0,0,0,,...نعم
Dialogue: 0,1:50:48.25,1:50:49.25,Default,,0,0,0,,...حسناً
Dialogue: 0,1:50:49.30,1:50:51.86,Default,,0,0,0,,.مازالت تذكركم من دون شكّ
Dialogue: 0,1:50:52.30,1:50:54.35,Default,,0,0,0,,أنتُم أصدقاؤها الحقيقيّون، صحيح؟
Dialogue: 0,1:50:54.35,1:50:56.35,Default,,0,0,0,,.أنتِ مُحقّة-\N.بالفِعل-
Dialogue: 0,1:50:56.90,1:50:57.35,Default,,0,0,0,,!صحيح
Dialogue: 0,1:50:57.65,1:51:01.40,Default,,0,0,0,,.مهما حصل... عليهم ألّا يعرفوا بالحقيقة أبداً
Dialogue: 0,1:51:01.45,1:51:02.10,Default,,0,0,0,,...نعم
Dialogue: 0,1:51:03.10,1:51:04.55,Default,,0,0,0,,...حتّى النّهاية
Dialogue: 0,1:51:04.75,1:51:06.70,Default,,0,0,0,,...كان لون تلك الآنسة
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,{\pos(225.442,85.333)}Ms.Vampire :ترجمة وإنتاج
