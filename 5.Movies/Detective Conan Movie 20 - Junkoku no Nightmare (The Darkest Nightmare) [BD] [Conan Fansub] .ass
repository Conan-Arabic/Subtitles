Dialogue: 0,0:00:41.08,0:00:42.31,TOP,,0000,0000,0000,,{\fad(20,50)}الإنتماء : مكتب الأمن العام، الاسم الحركي : بوربون\Nالاسم المستعار : أمورو تورو، الاسم الحقيقي : فورويا ري
Dialogue: 0,0:00:58.55,0:00:59.68,Default,,0000,0000,0000,,! هذا يكفي
Dialogue: 0,0:01:00.08,0:01:02.11,Default,,0000,0000,0000,,المكانُ محاصر، حريٌ بكِ الإستسلام
Dialogue: 0,0:01:05.15,0:01:07.31,Default,,0000,0000,0000,,.لقد أوقعنا بكِ في النهاية
Dialogue: 0,0:01:32.48,0:01:34.11,Default,,0000,0000,0000,,أأنتَ بخير، فوريا-سان؟
Dialogue: 0,0:01:34.18,0:01:35.28,Default,,0000,0000,0000,,أجل أنا بخير
Dialogue: 0,0:01:38.35,0:01:39.61,Default,,0000,0000,0000,,هذه الأعين، هل مِن المُمكن...؟
Dialogue: 0,0:01:39.65,0:01:40.78,Default,,0000,0000,0000,,تنحَ جانباً، فوريا-سان
Dialogue: 0,0:01:40.81,0:01:41.91,Default,,0000,0000,0000,,لا تُحركي ساكناً
Dialogue: 0,0:01:43.88,0:01:44.65,Default,,0000,0000,0000,,! تمهلي
Dialogue: 0,0:01:54.38,0:01:55.68,Default,,0000,0000,0000,,! تمهلي
Dialogue: 0,0:01:55.65,0:01:56.35,Title,,0000,0000,0000,,{\frz75.73\pos(644.362,398.318)}مكتب الأمن العام
Dialogue: 0,0:02:01.01,0:02:02.11,Default,,0000,0000,0000,,!توقفي
Dialogue: 0,0:02:02.15,0:02:03.81,Default,,0000,0000,0000,,إنتبهِ، فهذا خطِر
Dialogue: 0,0:02:19.95,0:02:20.51,Default,,0000,0000,0000,,! تباً
Dialogue: 0,0:02:45.91,0:02:48.98,TOP,,0000,0000,0000,,:رسالة جديدة\Nستاوت، أكوافيت،ريسلينغ
Dialogue: 0,0:03:09.48,0:03:11.01,TOP,,0000,0000,0000,,جاري الإرسال
Dialogue: 0,0:03:11.01,0:03:11.45,TOP,,0000,0000,0000,,تم الإرسال
Dialogue: 0,0:03:23.78,0:03:24.85,Default,,0000,0000,0000,,من تكون؟
Dialogue: 0,0:03:26.71,0:03:27.41,Default,,0000,0000,0000,,!أكاي
Dialogue: 0,0:03:38.08,0:03:40.95,Default,,0000,0000,0000,,تراجع يا آكاي، الأمر يخص الشرطة السرية
Dialogue: 0,0:04:36.71,0:04:37.75,Default,,0000,0000,0000,,هل من الممكن؟
Dialogue: 0,0:04:54.91,0:04:56.11,Default,,0000,0000,0000,,لن أدعكِ تفلتين
Dialogue: 0,0:05:06.55,0:05:07.08,Default,,0000,0000,0000,,! اللعنة
Dialogue: 0,0:05:18.91,0:05:21.81,Default,,0000,0000,0000,,! إن لم نقبض على تلك المرأة، فإن العالم سيعتريه الفوضى
Dialogue: 0,0:05:27.75,0:05:28.65,Default,,0000,0000,0000,,...مُحال
Dialogue: 0,0:05:28.91,0:05:29.98,Default,,0000,0000,0000,,اتخذت الطريق المُعاكس؟...
Dialogue: 0,0:05:55.41,0:05:56.25,Default,,0000,0000,0000,,راي
Dialogue: 0,0:05:58.11,0:06:00.85,Default,,0000,0000,0000,,هذا مثير، سوف أقتُلك
Dialogue: 0,0:07:23.21,0:07:24.08,Default,,0000,0000,0000,,أكاي
Dialogue: 0,0:07:24.58,0:07:25.71,Default,,0000,0000,0000,,أيها الوغد
Dialogue: 0,0:07:44.61,0:07:45.51,Default,,0000,0000,0000,,هذا أنا
Dialogue: 0,0:07:46.05,0:07:49.01,Default,,0000,0000,0000,,لقّد فقدتها، سأتصلُ بك لاحقاً
Dialogue: 0,0:07:49.15,0:07:50.15,Default,,0000,0000,0000,,عُلم
