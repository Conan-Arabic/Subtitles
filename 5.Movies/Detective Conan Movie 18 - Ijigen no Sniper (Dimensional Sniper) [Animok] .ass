Dialogue: 0,1:32:41.72,1:32:45.29,Default,NTP,0000,0000,0000,!Effect,لكن من أين لأحدهم ان يصيب احداً في هذا الارتفاع؟
Dialogue: 0,1:32:45.29,1:32:46.79,Default,NTP,0000,0000,0000,!Effect,من أين؟
Dialogue: 0,1:32:52.32,1:32:54.68,Default,NTP,0000,0000,0000,!Effect,قناصٌ اخر؟
Dialogue: 0,1:32:56.25,1:32:58.10,Default,NTP,0000,0000,0000,!Effect,لكن كيف؟
Dialogue: 0,1:32:58.10,1:33:03.56,Default,NTP,0000,0000,0000,!Effect,المكان الوحيد الذي يصلح لاطلاق انار هو المجمع السمائي...َ
Dialogue: 0,1:33:03.56,1:33:06.23,Default,NTP,0000,0000,0000,!Effect,لكن ذلك المبنى....َ
Dialogue: 0,1:33:06.23,1:33:09.58,Default,NTP,0000,0000,0000,!Effect,اخيراً, اذا اطلقت النار من شجرة الجرس, ستكون بأمان
Dialogue: 0,1:33:09.58,1:33:14.82,Default,NTP,0000,0000,0000,!Effect,لكن ماذا لو فهم والتز رسالة النجمة الفضية, وقام\Nبإستهدافي من المجمع السمائي؟
Dialogue: 0,1:33:14.82,1:33:16.46,Default,NTP,0000,0000,0000,!Effect,اهدأ...َ
Dialogue: 0,1:33:16.46,1:33:21.71,Default,NTP,0000,0000,0000,!Effect,القناص الوحيد القادر على اطلاق النار من\Nهذه المسافة قد قُتل
Dialogue: 0,1:33:22.61,1:33:25.88,Default,NTP,0000,0000,0000,!Effect,اه, صحيح, عيناك يا تيم...َ
Dialogue: 0,1:33:25.88,1:33:29.89,Default,NTP,0000,0000,0000,!Effect,لا, لم اكن الأستطيع اطلاق النار من هذه المسافة الكبيرة
Dialogue: 0,1:33:30.80,1:33:32.94,Default,NTP,0000,0000,0000,!Effect,هل تقول ان هنالك قناصٌ افضل منك؟
Dialogue: 0,1:33:32.94,1:33:34.89,Default,NTP,0000,0000,0000,!Effect,نعم, مع الشرطة الفيدرالية
Dialogue: 0,1:33:34.89,1:33:38.51,Default,NTP,0000,0000,0000,!Effect,عندهم قناص موهوب جداً, يلقب ب "الرصاصة الفضية"َ
Dialogue: 0,1:33:38.51,1:33:44.65,Default,NTP,0000,0000,0000,!Effect,لكن لا داعي للقلق, انه مفقودٌ ويعتبر ميتاً
Dialogue: 0,1:33:45.79,1:33:48.40,Default,NTP,0000,0000,0000,!Effect,مستحيل, هذا هو؟
Dialogue: 0,1:33:49.22,1:33:52.39,Default,NTP,0000,0000,0000,!Effect,الرصاصة الفضية ظهر حقاً؟
Dialogue: 0,1:33:54.08,1:33:55.41,Default,NTP,0000,0000,0000,!Effect,سوبارو-سان؟
Dialogue: 0,1:33:56.20,1:33:57.66,Default,NTP,0000,0000,0000,!Effect,لماذا هو هنا؟
Dialogue: 0,1:33:58.91,1:34:03.69,Default,NTP,0000,0000,0000,!Effect,فهمت, سوبارو سان فهم احجية حجر النرد ايضاً
Dialogue: 0,1:34:04.65,1:34:09.18,Default,NTP,0000,0000,0000,!Effect,كونان, نحن عند برج شجرة الجرس,َ \Nها نحن نطلب الصعود الى الاعلى الان
Dialogue: 0,1:34:09.18,1:34:14.18,Default,NTP,0000,0000,0000,!Effect,رائع, توجهوا الى سطح منصة المراقبة\Nستجدون يوشينو هناك
Dialogue: 0,1:34:14.18,1:34:16.43,Default,NTP,0000,0000,0000,!Effect,اذاً, لقد كان القناص بالفعل
Dialogue: 0,1:34:16.43,1:34:18.55,Default,NTP,0000,0000,0000,!Effect,نعم, اذا هل بإمكانكم الذهاب هناك؟
Dialogue: 0,1:34:19.89,1:34:23.06,Default,NTP,0000,0000,0000,!Effect,لا, يبدوا ان الملاك قاموا بحجز\Nتلك المنطقة اليوم, لن يدعونا نصعد!َ
Dialogue: 0,1:34:23.06,1:34:24.92,Default,NTP,0000,0000,0000,!Effect,لا, يبدوا ان الملاك قاموا بحجز\Nتلك المنطقة اليوم, لن يدعونا نصعد!َ
Dialogue: 0,1:34:24.92,1:34:26.06,Default,NTP,0000,0000,0000,!Effect,هذا صحيح
Dialogue: 0,1:34:26.06,1:34:29.06,Default,NTP,0000,0000,0000,!Effect,جودي! ران و اصدقائي في الاعلى!َ
Dialogue: 0,1:34:29.71,1:34:33.32,Default,NTP,0000,0000,0000,!Effect,اشرحي لهم ما الذي يحصل, اصعدي الى الاعلى \Nواعتقلي يوشينو
Dialogue: 0,1:34:33.55,1:34:37.24,Default,NTP,0000,0000,0000,!Effect,حسناً!َ سأجعل المفتش ميغوري يقنعهم بالسماح لنا بذلك
Dialogue: 0,1:34:38.32,1:34:40.76,Default,NTP,0000,0000,0000,!Effect,ها! انه جميلٌ حقاً
Dialogue: 0,1:34:40.76,1:34:44.09,Default,NTP,0000,0000,0000,!Effect,اليس كذلك؟ شجرة الجرس يملك افضل اطلالة في الليل ايضاً
Dialogue: 0,1:34:44.09,1:34:45.49,Default,NTP,0000,0000,0000,!Effect,رائعٌ جداً
Dialogue: 0,1:34:45.49,1:34:47.36,Default,NTP,0000,0000,0000,!Effect,انه اجمل بالليل
Dialogue: 0,1:34:47.36,1:34:49.12,Default,NTP,0000,0000,0000,!Effect,هذا صحيح
Dialogue: 0,1:34:49.12,1:34:52.28,Default,NTP,0000,0000,0000,!Effect,الان, لنذهب الى الجهة الاخرى التي لم نصورها بعد!َ
Dialogue: 0,1:34:52.28,1:34:53.02,Default,NTP,0000,0000,0000,!Effect,نعم!َ
Dialogue: 0,1:34:53.02,1:34:53.84,Default,NTP,0000,0000,0000,!Effect,هيا بنا!َ
Dialogue: 0,1:34:57.29,1:34:58.79,Default,NTP,0000,0000,0000,!Effect,سينشي-كودو؟
Dialogue: 0,1:35:01.53,1:35:03.85,Default,NTP,0000,0000,0000,!Effect,يبدو ان تلك الطلقة لم تُنهي عليه ؟
Dialogue: 0,1:35:08.28,1:35:11.02,Default,NTP,0000,0000,0000,!Effect,قطعت شوطاً طويلاً, لا يمكنني الاستسلام الان!َ
Dialogue: 0,1:35:11.02,1:35:13.76,Default,NTP,0000,0000,0000,!Effect,قطعت وعداً لهنتر...َ
Dialogue: 0,1:35:16.01,1:35:17.94,Default,NTP,0000,0000,0000,!Effect,جيد, لقد تطورت
Dialogue: 0,1:35:17.94,1:35:20.56,Default,NTP,0000,0000,0000,!Effect,الان كل ما تحتاجه هو الخبرة العملية
Dialogue: 0,1:35:20.56,1:35:25.68,Default,NTP,0000,0000,0000,!Effect,حسناً, سأبدأ ب براين وودز. سيدفع والتز الثمن غالياً
Dialogue: 0,1:35:25.68,1:35:27.20,Default,NTP,0000,0000,0000,!Effect,هل انت واثقٌ من هذا؟
Dialogue: 0,1:35:27.20,1:35:27.62,Default,NTP,0000,0000,0000,!Effect,ماذا؟
Dialogue: 0,1:35:27.84,1:35:32.26,Default,NTP,0000,0000,0000,!Effect,الوقت متأخرٌ الان على القلق, لكنني\Nنادمٌ على اشراكك بهذا الامر
Dialogue: 0,1:35:32.26,1:35:34.13,Default,NTP,0000,0000,0000,!Effect,ماذا تقول يا تيم؟
Dialogue: 0,1:35:34.13,1:35:38.01,Default,NTP,0000,0000,0000,!Effect,انقذت حياتي مراتٍ كثيرة في الخطوط الاولى من المعركة
Dialogue: 0,1:35:38.01,1:35:41.33,Default,NTP,0000,0000,0000,!Effect,والان, انا احصل اخيراً على فرصةٍ لرد الجميل
Dialogue: 0,1:35:41.33,1:35:42.43,Default,NTP,0000,0000,0000,!Effect,علاوةً على ذلك
Dialogue: 0,1:35:42.43,1:35:46.36,Default,NTP,0000,0000,0000,!Effect,لا يمكنني مسامحة والتز و مورفي
Dialogue: 0,1:35:46.36,1:35:53.96,Default,NTP,0000,0000,0000,!Effect,اتهمك زوراً وتسبب بسحب النجمة الفضية منك \Nفقط بسبب غيرته
Dialogue: 0,1:35:53.96,1:36:00.45,Default,NTP,0000,0000,0000,!Effect,وبعد ان طلبنا ان يعاد فتح القضية\Nطلب من مورفي ان يقتلك
Dialogue: 0,1:36:09.35,1:36:11.33,Default,NTP,0000,0000,0000,!Effect,نعم هذا صحيح
Dialogue: 0,1:36:11.70,1:36:17.80,Default,NTP,0000,0000,0000,!Effect,لو لم يكن لديك شكٌ بهم, مما جعلك تقوم بعمل\Nمقارنة بين الرصاصة المستخرجة منك و بندقية مورفي
Dialogue: 0,1:36:17.80,1:36:19.84,Default,NTP,0000,0000,0000,!Effect,لما كنا عرفنا الحقيقة ابداّ
Dialogue: 0,1:36:19.84,1:36:24.51,Default,NTP,0000,0000,0000,!Effect,و مع ذلك, قاموا بسرقة الدليل منا\Nولم يكن بإمكاننا عمل شيئ
Dialogue: 0,1:36:24.51,1:36:26.90,Default,NTP,0000,0000,0000,!Effect,كيفن, سأقول هذا للمرة الاخيرة
Dialogue: 0,1:36:26.90,1:36:33.35,Default,NTP,0000,0000,0000,!Effect,انتقم لزوجتي وابنتى, وارسل كل من ساعد\Nفي تدمير حياتي الى الجحيم
Dialogue: 0,1:36:33.35,1:36:35.35,Default,NTP,0000,0000,0000,!Effect,بالتأكيد, اعدك بذلك
Dialogue: 0,1:36:35.75,1:36:37.16,Default,NTP,0000,0000,0000,!Effect,سأفعلها
Dialogue: 0,1:36:37.16,1:36:39.91,Default,NTP,0000,0000,0000,!Effect,سوف أحرص على ارسالهم الى الجحيم
Dialogue: 0,1:36:41.08,1:36:42.06,Default,NTP,0000,0000,0000,!Effect,اعتمد عليك!َ
Dialogue: 0,1:36:42.53,1:36:46.18,Default,NTP,0000,0000,0000,!Effect,هذا صحيح, لا يمكننى الاستسلام الان
Dialogue: 0,1:36:46.18,1:36:49.20,Default,NTP,0000,0000,0000,!Effect,ما زال بإمكاني تطبيق خطة الهروب...!َ
Dialogue: 0,1:36:49.20,1:36:52.20,Default,NTP,0000,0000,0000,!Effect,يجب على والتز دفع الثمن!َ
Dialogue: 0,1:36:52.20,1:36:55.19,Default,NTP,0000,0000,0000,!Effect,صحيح! عليكي اخراج الجميع من هناك الان!َ
Dialogue: 0,1:36:56.13,1:36:57.28,Default,NTP,0000,0000,0000,!Effect,لكن ماذا عن القناص؟
Dialogue: 0,1:36:57.28,1:37:00.13,Default,NTP,0000,0000,0000,!Effect,لا تقلقي! ستتعامل الشرطة الفيدرالية معه
Dialogue: 0,1:37:00.13,1:37:02.08,Default,NTP,0000,0000,0000,!Effect,حسناً, فهمت!َ
Dialogue: 0,1:37:07.77,1:37:09.46,Default,NTP,0000,0000,0000,!Effect,درج الطوارئ من هنا!َ
Dialogue: 0,1:37:09.46,1:37:10.32,Default,NTP,0000,0000,0000,!Effect,صحيح
Dialogue: 0,1:37:12.31,1:37:14.09,Default,NTP,0000,0000,0000,!Effect,سونوكو!َ
Dialogue: 0,1:37:14.09,1:37:15.54,Default,NTP,0000,0000,0000,!Effect,من انت ؟
Dialogue: 0,1:37:15.54,1:37:16.73,Default,NTP,0000,0000,0000,!Effect,أعد لنا ايومي-شان!َ
Dialogue: 0,1:37:16.73,1:37:19.62,Default,NTP,0000,0000,0000,!Effect,ماذا تفعلان؟ اذهبا واختبئا
Dialogue: 0,1:37:19.62,1:37:20.43,Default,NTP,0000,0000,0000,!Effect,لكن...َ
Dialogue: 0,1:37:20.43,1:37:21.15,Default,NTP,0000,0000,0000,!Effect,لقد امسك ب ايومي!َ
Dialogue: 0,1:37:21.15,1:37:22.70,Default,NTP,0000,0000,0000,!Effect,ارجعوا يا اشقياء!َ
Dialogue: 0,1:37:24.62,1:37:26.02,Default,NTP,0000,0000,0000,!Effect,لا...َ
Dialogue: 0,1:37:26.02,1:37:27.16,Default,NTP,0000,0000,0000,!Effect,سونوكو!َ
Dialogue: 0,1:37:27.16,1:37:31.13,Default,NTP,0000,0000,0000,!Effect,لا تتسببوا بالمشاكل يا اشقياء!َ ابقوا بعيداً فقط
Dialogue: 0,1:37:31.34,1:37:33.25,Default,NTP,0000,0000,0000,!Effect,سأستعير الفتاة!َ
Dialogue: 0,1:37:34.56,1:37:35.97,Default,NTP,0000,0000,0000,!Effect,ابقوا بعيداً
Dialogue: 0,1:37:35.97,1:37:39.12,Default,NTP,0000,0000,0000,!Effect,نحن الاف بي اي!َ القي مسدسك ارضاً!َ
Dialogue: 0,1:37:39.12,1:37:43.31,Default,NTP,0000,0000,0000,!Effect,اخرسي! اذا تقدمتم خطوةً واحدة, سأقتل الفتاة
Dialogue: 0,1:37:44.71,1:37:45.98,Default,NTP,0000,0000,0000,!Effect,طلقات نارية....!َ
Dialogue: 0,1:37:45.98,1:37:48.41,Default,NTP,0000,0000,0000,!Effect,تباً, لم ييأس بعد
Dialogue: 0,1:37:48.41,1:37:50.65,Default,NTP,0000,0000,0000,!Effect,لا تدعه يلتف من الخلف
Dialogue: 0,1:37:50.65,1:37:52.38,Default,NTP,0000,0000,0000,!Effect,أحضره الى هذه الجهة...َ
Dialogue: 0,1:37:56.49,1:37:57.94,Default,NTP,0000,0000,0000,!Effect,توقفوا عن الحركة!َ
Dialogue: 0,1:37:57.94,1:37:59.97,Default,NTP,0000,0000,0000,!Effect,أتريدونني ان أقتل الفتاة؟
Dialogue: 0,1:37:59.97,1:38:00.62,Default,NTP,0000,0000,0000,!Effect,ألقوا اسلحتكم ودعوني أمر!َ
Dialogue: 0,1:38:00.62,1:38:01.94,Default,NTP,0000,0000,0000,!Effect,حسناً, علينا ان ننقذ ايومي-شان!َ
Dialogue: 0,1:38:01.94,1:38:02.49,Default,NTP,0000,0000,0000,!Effect,حسناً, علينا ان ننقذ ايومي-شان!َ
Dialogue: 0,1:38:02.49,1:38:03.53,Default,NTP,0000,0000,0000,!Effect,حسناً, إهدأ فقط, سفعل لك ماتريد!َ
Dialogue: 0,1:38:03.53,1:38:04.34,Default,NTP,0000,0000,0000,!Effect,حسناً!َ
Dialogue: 0,1:38:04.34,1:38:06.05,Default,NTP,0000,0000,0000,!Effect,لا تكن غبياً, لديه مسدس!َ
Dialogue: 0,1:38:06.05,1:38:07.70,Default,NTP,0000,0000,0000,!Effect,لا تكن غبياً, لديه مسدس!َ
Dialogue: 0,1:38:07.90,1:38:09.70,Default,NTP,0000,0000,0000,!Effect,لكن علينا انقاذها بطرقةٍ ما....!َ
Dialogue: 0,1:38:09.70,1:38:12.37,Default,NTP,0000,0000,0000,!Effect,سونوكو!َ هيا! سونوكو
Dialogue: 0,1:38:13.54,1:38:16.01,Default,NTP,0000,0000,0000,!Effect,ماذا علي ان أفعل يا سينشي؟
Dialogue: 0,1:38:16.01,1:38:16.87,Default,NTP,0000,0000,0000,!Effect,ساعدني....!َ
Dialogue: 0,1:38:17.11,1:38:19.88,Default,NTP,0000,0000,0000,!Effect,تباً, لا يمكنني فعل شيئ من هنا
Dialogue: 0,1:38:19.88,1:38:21.64,Default,NTP,0000,0000,0000,!Effect,هذا يكفي!َ
Dialogue: 0,1:38:21.64,1:38:24.01,Default,NTP,0000,0000,0000,!Effect,ابتعدوا الان وإلا سوف اقتلها
Dialogue: 0,1:38:24.23,1:38:28.50,Default,NTP,0000,0000,0000,!Effect,لنتأكد من انقاذ الرهينة, علينا ان نقوم\Nبإيقاف الهدف حالاً
Dialogue: 0,1:38:28.50,1:38:29.75,Default,NTP,0000,0000,0000,!Effect,ولفعل ذلك...َ
Dialogue: 0,1:38:29.75,1:38:37.34,Default,NTP,0000,0000,0000,!Effect,هنالك طريق واحدة لقتل احدهم بطلقة واحدة\Nبدون اية أخطاء
Dialogue: 0,1:38:37.69,1:38:39.01,Default,NTP,0000,0000,0000,!Effect,نخاع الدماغ...َ
Dialogue: 0,1:38:39.26,1:38:40.31,Default,NTP,0000,0000,0000,!Effect,صحيح
Dialogue: 0,1:38:40.81,1:38:42.53,Default,NTP,0000,0000,0000,!Effect,علي فعلها!َ
Dialogue: 0,1:38:42.53,1:38:45.53,Default,NTP,0000,0000,0000,!Effect,تباً لن يدعاني أمر
Dialogue: 0,1:38:46.55,1:38:47.94,Default,NTP,0000,0000,0000,!Effect,جودي-سان!َ
Dialogue: 0,1:38:50.64,1:38:51.62,Default,NTP,0000,0000,0000,!Effect,يوشينو!َ
Dialogue: 0,1:38:53.28,1:38:54.41,Default,NTP,0000,0000,0000,!Effect,تمكنت منك!َ
Dialogue: 0,1:39:10.08,1:39:12.06,Default,NTP,0000,0000,0000,!Effect,لا!َ ما الذي يحصل!َ
Dialogue: 0,1:39:12.71,1:39:14.31,Default,NTP,0000,0000,0000,!Effect,لاأرى شيئاً
Dialogue: 0,1:39:14.31,1:39:15.46,Default,NTP,0000,0000,0000,!Effect,انقطعت الكهرباء؟
Dialogue: 0,1:39:15.46,1:39:17.57,Default,NTP,0000,0000,0000,!Effect,اصمتا انتما الإثنين! تراجعا
Dialogue: 0,1:39:20.55,1:39:22.86,Default,NTP,0000,0000,0000,!Effect,تباً!َ لقد تخلص من الاضواء
Dialogue: 0,1:39:22.86,1:39:24.49,Default,NTP,0000,0000,0000,!Effect,لا يمكن لسوبارو-سان ان ....َ
Dialogue: 0,1:39:25.47,1:39:26.49,Default,NTP,0000,0000,0000,!Effect,انا أرى
Dialogue: 0,1:39:26.49,1:39:30.50,Default,NTP,0000,0000,0000,!Effect,يريد الهروب تحت غطاء الظلام
Dialogue: 0,1:39:31.36,1:39:32.48,Default,NTP,0000,0000,0000,!Effect,ماذا علي ان أفعل؟
Dialogue: 0,1:39:32.48,1:39:33.87,Default,NTP,0000,0000,0000,!Effect,هذه مشكلة!َ
Dialogue: 0,1:39:33.87,1:39:36.04,Default,NTP,0000,0000,0000,!Effect,سيتمكن من اخذ ايومي معه!َ
Dialogue: 0,1:39:36.09,1:39:36.10,Default,NTP,0000,0000,0000,!Effect, الرؤية الليلية
Dialogue: 0,1:39:36.10,1:39:36.12,Default,NTP,0000,0000,0000,!Effect, الرؤية الليلية
