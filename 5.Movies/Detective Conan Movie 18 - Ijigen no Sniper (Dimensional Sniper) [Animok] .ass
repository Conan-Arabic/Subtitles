Dialogue: 0,1:39:36.29,1:39:37.04,Default,NTP,0000,0000,0000,!Effect, الرؤية الليلية
Dialogue: 0,1:39:42.02,1:39:45.13,Default,NTP,0000,0000,0000,!Effect,لديه منظار للرؤية الليلية؟
Dialogue: 0,1:39:45.13,1:39:47.20,Default,NTP,0000,0000,0000,!Effect,اهربي يا جودي
Dialogue: 0,1:39:51.27,1:39:53.47,Default,NTP,0000,0000,0000,!Effect,يوشينو! لا يمكنك الفوز , استسلم الان!َ
Dialogue: 0,1:39:57.27,1:39:58.47,Default,NTP,0000,0000,0000,!Effect,كاميل!َ
Dialogue: 0,1:39:58.87,1:40:00.88,Default,NTP,0000,0000,0000,!Effect,قل شيئاً يا كاميل!َ
Dialogue: 0,1:40:01.76,1:40:05.78,Default,NTP,0000,0000,0000,!Effect,تباً, سوف يقتلهم جميعاً
Dialogue: 0,1:40:05.78,1:40:10.49,Default,NTP,0000,0000,0000,!Effect,لو تمكنت من تسليط ضوءٍ عليه بطريقة ما\Nسيتمكن سوبارو من اطلاق النار عليه
Dialogue: 0,1:40:10.87,1:40:12.97,Default,NTP,0000,0000,0000,!Effect,لكنني لا أستطيع ان افعل شيئاً بهذه القدم
Dialogue: 0,1:40:13.99,1:40:16.33,Default,NTP,0000,0000,0000,!Effect,كيف أُريه مكان يوشينو؟
Dialogue: 0,1:40:16.84,1:40:20.36,Default,NTP,0000,0000,0000,!Effect,انتظر قليلاً!َ هذه المناظير الليلية من النوع القديم....َ
Dialogue: 0,1:40:20.88,1:40:25.30,Default,NTP,0000,0000,0000,!Effect,هذا يعني ان علي ان اسلط الضوء على شجرة الجرس فقط
Dialogue: 0,1:40:25.30,1:40:26.45,Default,NTP,0000,0000,0000,!Effect,ماذا عن هذا؟
Dialogue: 0,1:40:27.74,1:40:31.04,Default,NTP,0000,0000,0000,!Effect,اذا تمكنت من استغلال الارتفاع, قد ينفع ذلك!َ
Dialogue: 0,1:40:31.04,1:40:34.14,Default,NTP,0000,0000,0000,!Effect,لا, يجب ان ينجح ذلك!َ
Dialogue: 0,1:40:37.21,1:40:38.71,Default,NTP,0000,0000,0000,!Effect,ايدوجاوا؟
Dialogue: 0,1:40:38.71,1:40:39.70,Default,NTP,0000,0000,0000,!Effect,ألو؟
Dialogue: 0,1:40:39.70,1:40:42.77,Default,NTP,0000,0000,0000,!Effect,ضوء!َ سلطي الضوء على القناص!َ
Dialogue: 0,1:40:43.22,1:40:46.19,Default,NTP,0000,0000,0000,!Effect,انه يلبس منظاراً ليلياً. سيفقده ذلك الرؤية!َ
Dialogue: 0,1:40:46.19,1:40:48.29,Default,NTP,0000,0000,0000,!Effect,لكن, اين هو؟
Dialogue: 0,1:40:48.92,1:40:50.68,Default,NTP,0000,0000,0000,!Effect,صحيح, استخدمي ذلك
Dialogue: 0,1:40:50.68,1:40:51.61,Default,NTP,0000,0000,0000,!Effect,فهمت
Dialogue: 0,1:40:51.61,1:40:53.50,Default,NTP,0000,0000,0000,!Effect,سيكون قريباً منك في أي لحظة
Dialogue: 0,1:40:53.50,1:40:56.78,Default,NTP,0000,0000,0000,!Effect,لا تتحركي بمدة ثلاثين ثانية. لكي لا يشك بالامر
Dialogue: 0,1:40:56.78,1:40:57.77,Default,NTP,0000,0000,0000,!Effect,انا أنتظر!
Dialogue: 0,1:40:58.20,1:41:01.87,Default,NTP,0000,0000,0000,!Effect,اسمعوا, عليكم ان تتوقفو عن الحركة لثلاثين ثانية!َ
