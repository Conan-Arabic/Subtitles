Dialogue: 0,0:27:03.26,0:27:05.61,DCMain,,0,0,0,,{\be1}!أعطاني إياها رجلٌ ذو لحية
Dialogue: 0,0:27:05.63,0:27:07.69,DCMain,,0,0,0,,{\be1}!قال إنها طائرة متفجّرة
Dialogue: 0,0:27:08.32,0:27:09.32,DCMain,,0,0,0,,{\be1}!طائرة متفجّرة؟
