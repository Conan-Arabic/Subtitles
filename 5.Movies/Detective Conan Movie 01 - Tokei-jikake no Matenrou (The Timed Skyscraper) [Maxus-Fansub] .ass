Dialogue: 0,0:27:15.81,0:27:18.10,DCMain,,0,0,0,,{\be1}!ماذا؟! أنا التالي
Dialogue: 0,0:27:18.51,0:27:20.19,DCMain,,0,0,0,,{\be1}!الطائرة مفخخة بقنبلة
Dialogue: 0,0:27:21.63,0:27:22.74,DCMain,,0,0,0,,{\be1}!أيها الحمقى
Dialogue: 0,0:27:23.30,0:27:24.33,DCMain,,0,0,0,,{\be1}!لا
