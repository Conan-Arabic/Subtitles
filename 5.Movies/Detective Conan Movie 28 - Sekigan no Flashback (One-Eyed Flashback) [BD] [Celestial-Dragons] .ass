Comment: 0,0:22:18.23,0:22:21.23,Main,,0,0,0,,
Dialogue: 10,0:00:34.95,0:00:35.95,Default,,0,0,0,,!انتظر
Dialogue: 10,0:00:39.54,0:00:40.37,Default,,0,0,0,,من هناك؟
Dialogue: 10,0:00:40.67,0:00:44.00,Default,,0,0,0,,!أنت! ماذا تفعل هناك؟ اهرب
Dialogue: 10,0:02:13.68,0:02:14.68,Default,,0,0,0,,!من هناك؟
Dialogue: 10,0:02:38.28,0:02:40.22,Default,,0,0,0,,.أنا أويهارا من شرطة ناغانو
Dialogue: 10,0:02:40.58,0:02:41.87,Default,,0,0,0,,...من قدّم البلاغ لنا
Dialogue: 10,0:02:42.30,0:02:43.46,Default,,0,0,0,,.أنا
Dialogue: 10,0:02:43.58,0:02:45.54,Default,,0,0,0,,...طلب مني الأستاذ المساعد أوتشي
Dialogue: 10,0:02:45.67,0:02:48.33,Default,,0,0,0,,{\an8}.طلبت لأنني سمعت صراخها
Dialogue: 10,0:02:48.84,0:02:51.21,Default,,0,0,0,,{\an8}،حين هوجمت في مبنى الرصد
Dialogue: 10,0:02:51.34,0:02:53.76,Default,,0,0,0,,.جاء أوتشي-سان لنجدتي على الفور
Dialogue: 10,0:02:53.88,0:02:57.57,Default,,0,0,0,,!هل رأيتِ وجه المجرم الذي هاجمكِ؟
Dialogue: 10,0:02:59.32,0:03:01.77,Default,,0,0,0,,...كلّا، كان يضع خوذة
Dialogue: 10,0:03:05.73,0:03:08.02,Default,,0,0,0,,.إنه التلسكوب اللاسلكي بقطر 45 مترًا
Dialogue: 10,0:03:09.15,0:03:11.87,Default,,0,0,0,,.يتحرّك لأننا نجري رصدًا الآن
Dialogue: 10,0:03:15.90,0:03:18.32,Default,,0,0,0,,!أيها المفتش ياماتو! كان-تشان
Dialogue: 10,0:03:18.53,0:03:20.75,Default,,0,0,0,,ما الأمر؟ هل أنت بخير؟
Dialogue: 10,0:03:21.33,0:03:22.32,Default,,0,0,0,,!كان-تشان
Dialogue: 10,0:03:32.21,0:03:34.34,Default,,0,0,0,,...أيتها السماء الهادرة بالرعود
Dialogue: 10,0:03:35.55,0:03:39.09,Default,,0,0,0,,!امنحي نصل قلبي القوة
Dialogue: 10,0:03:39.72,0:03:44.93,Default,,0,0,0,,!ها أنا ذا! الضربة القاضية! يايبا: ضربة إله الرعد
Dialogue: 10,0:03:47.64,0:03:50.44,Default,,0,0,0,,!عجبًا؟! لِمَ لِمَ؟
Dialogue: 10,0:03:50.56,0:03:53.57,Default,,0,0,0,,!وصل إلى أفضل لقطة، لِمَ اختفت الصورة؟
Dialogue: 10,0:03:53.69,0:03:55.44,Default,,0,0,0,,{\an8}...حالة الطقس لهذا اليوم
Dialogue: 10,0:03:55.57,0:03:57.65,Default,,0,0,0,,...البث الأرضي يعمل، ولكن
Dialogue: 10,0:03:57.78,0:03:58.57,Default,,0,0,0,,.لا فائدة
Dialogue: 10,0:03:58.70,0:04:01.09,Default,,0,0,0,,!بروفيسور، أجبنا يا بروفيسور
Dialogue: 10,0:04:02.15,0:04:03.39,Default,,0,0,0,,.لا فائدة
Dialogue: 10,0:04:03.91,0:04:06.25,Default,,0,0,0,,.يبدو أن الخلل في الهوائي كما توقعت
Dialogue: 10,0:04:06.37,0:04:08.21,Default,,0,0,0,,.وصل الفيلم إلى أفضل جزء
Dialogue: 10,0:04:08.33,0:04:11.33,Default,,0,0,0,,!لِمَ انقطع البث الفضائي فحسب؟
Dialogue: 10,0:04:12.59,0:04:13.71,Default,,0,0,0,,...السبب هو
Dialogue: 10,0:04:13.84,0:04:15.37,Default,,0,0,0,,.دعوني أشرح لكم
Dialogue: 10,0:04:15.80,0:04:20.22,Default,,0,0,0,,.لأن البث عبر الأقمار الصناعية يستقبل الموجات عبر الهوائي
Dialogue: 10,0:04:20.34,0:04:22.49,Default,,0,0,0,,ومن أين يستقبل الموجات؟
Dialogue: 10,0:04:22.51,0:04:24.60,Default,,0,0,0,,من الفضاء، أليس كذلك يا بروفيسور؟
Dialogue: 10,0:04:24.72,0:04:26.39,Default,,0,0,0,,!صحيح، من الفضاء
Dialogue: 10,0:04:27.64,0:04:28.77,Default,,0,0,0,,.هذا مذهل
Dialogue: 10,0:04:29.27,0:04:30.27,Default,,0,0,0,,.نسيت أمرًا
Dialogue: 10,0:04:30.90,0:04:33.19,Default,,0,0,0,,مفا~جأة! ما هذا برأيكم؟
Dialogue: 10,0:04:33.32,0:04:35.44,Default,,0,0,0,,مرصد نوبياما الفلكي الوطني؟
Dialogue: 10,0:04:36.57,0:04:38.45,Default,,0,0,0,,.إنه مرصد في ناغانو
Dialogue: 10,0:04:38.57,0:04:41.66,Default,,0,0,0,,.أحد زملائي الأصغر سنًا من أيام الجامعة يعمل أستاذًا هناك
Dialogue: 10,0:04:41.78,0:04:44.66,Default,,0,0,0,,.وقد دعاني لزيارته
Dialogue: 10,0:04:44.79,0:04:47.11,Default,,0,0,0,,الأمر مفاجئ، ولكن ما رأيكم بيوم الاثنين القادم؟
Dialogue: 10,0:04:47.22,0:04:48.91,Default,,0,0,0,,ألا يصادف عطلتكم الشتوية؟
Dialogue: 10,0:04:49.04,0:04:53.44,Default,,0,0,0,,.إن ذهبنا بخمسة أشخاص أو أكثر فسينظمون لنا جولة رصد فلكي
Dialogue: 10,0:04:53.96,0:04:55.77,Default,,0,0,0,,.آسف، لا أستطيع الذهاب
Dialogue: 10,0:04:57.41,0:04:58.57,Default,,0,0,0,,لِمَ؟
Dialogue: 10,0:04:58.59,0:05:00.84,Default,,0,0,0,,.لديّ مباراة كرة قدم في ذلك اليوم
Dialogue: 10,0:05:00.97,0:05:02.55,Default,,0,0,0,,.واشتريت التذاكر سلفًا
Dialogue: 10,0:05:02.68,0:05:04.35,Default,,0,0,0,,عجبًا! مع من ستذهب؟
Dialogue: 10,0:05:05.10,0:05:07.10,Default,,0,0,0,,.مع ران نيه-تشان
Dialogue: 10,0:05:07.35,0:05:09.06,Default,,0,0,0,,.إذن، ما باليد حيلة
Dialogue: 10,0:05:09.18,0:05:11.30,Default,,0,0,0,,!لن يأخذوننا في جولة إن قلّ عددنا عن خمسة
Dialogue: 10,0:05:11.35,0:05:12.73,Default,,0,0,0,,!لا تقلقوا
Dialogue: 10,0:05:12.85,0:05:15.73,Default,,0,0,0,,.عددنا خمسة باحتسابي أنا المشرف
Dialogue: 10,0:05:15.86,0:05:17.44,Default,,0,0,0,,!مرحى
Dialogue: 10,0:05:17.57,0:05:19.07,Default,,0,0,0,,!رصد فلكي
Dialogue: 10,0:05:19.77,0:05:21.57,Default,,0,0,0,,!سنأكل تيندون
Dialogue: 10,0:05:28.45,0:05:31.46,Default,,0,0,0,,...أبي، الطعام جاهز تقريبًا
Dialogue: 10,0:05:32.79,0:05:33.89,Default,,0,0,0,,!آهٍ منك
Dialogue: 10,0:05:33.92,0:05:37.84,Default,,0,0,0,,!كم مرّة قلت لك ألّا تشرب قبل الطعام؟
Dialogue: 10,0:05:37.96,0:05:40.00,Default,,0,0,0,,...والتلفاز يعمل بلا فائدة
Dialogue: 10,0:05:40.97,0:05:42.76,Default,,0,0,0,,أين جهاز التحكم؟
Dialogue: 10,0:05:42.88,0:05:44.00,Default,,0,0,0,,.عُدت
Dialogue: 10,0:05:44.60,0:05:47.39,Default,,0,0,0,,كونان-كن، ألم ترَ جهاز تحكم التلفاز؟
Dialogue: 10,0:05:48.89,0:05:51.77,Default,,0,0,0,,!الوعاء ساخن؟! أعتذر، ابحث لي عن جهاز التحكم
Dialogue: 10,0:05:51.89,0:05:52.63,Default,,0,0,0,,.حاضر
Dialogue: 10,0:05:53.44,0:05:55.52,Default,,0,0,0,,،مع توسع نطاق المساومة القضائية
Dialogue: 10,0:05:55.65,0:05:58.40,Default,,0,0,0,,.سيبدأ العمل ببرنامج حماية الشهود أيضًا
Dialogue: 10,0:06:00.32,0:06:01.99,Default,,0,0,0,,!شبعت وأتخمت
Dialogue: 10,0:06:02.61,0:06:04.66,Default,,0,0,0,,.لكن هذا نافع حقًا
Dialogue: 10,0:06:04.78,0:06:07.45,Default,,0,0,0,,.فالهاتف الذكي يحلّ محل جهاز التحكم الآن
Dialogue: 10,0:06:08.58,0:06:09.79,Default,,0,0,0,,...إذن
Dialogue: 10,0:06:10.33,0:06:14.02,Default,,0,0,0,,!يكفينا الهاتف الآن! لا حاجة لنا إلى جهاز التحكم
Dialogue: 10,0:06:15.54,0:06:18.30,Default,,0,0,0,,...لا يجوز هذا، فالتطبيق مجرد بديل مؤقت
Dialogue: 10,0:06:18.42,0:06:21.47,Default,,0,0,0,,.لذا من الأفضل البحث عن جهاز التحكم
Dialogue: 10,0:06:21.60,0:06:22.97,Default,,0,0,0,,.مرحبًا، هنا موري
Dialogue: 10,0:06:23.09,0:06:25.18,Default,,0,0,0,,.ثار غضب ران نيه-تشان
Dialogue: 10,0:06:25.90,0:06:26.53,Default,,0,0,0,,!وكأنني آبه
Dialogue: 10,0:06:26.40,0:06:28.00,Default,,0,0,0,,{\an8}.انتظر قليلًا رجاءً
Dialogue: 10,0:06:28.96,0:06:32.43,Default,,0,0,0,,.أبي، لديك اتصال من رجل يدعى ساميتاني-سان
Dialogue: 10,0:06:32.56,0:06:34.12,Default,,0,0,0,,ساميتاني؟
Dialogue: 10,0:06:34.46,0:06:35.52,Default,,0,0,0,,.لا أعرفه
Dialogue: 10,0:06:35.65,0:06:39.32,Default,,0,0,0,,.يقول إنه كان محققًا معك أيام عملك في شرطة العاصمة
Dialogue: 10,0:06:40.44,0:06:41.82,Default,,0,0,0,,.هيّا أسرع
Dialogue: 10,0:06:42.00,0:06:43.10,Default,,0,0,0,,.فهمت
Dialogue: 10,0:06:43.95,0:06:45.67,Default,,0,0,0,,.مرحبًا، هنا موري
Dialogue: 10,0:06:48.91,0:06:51.30,Default,,0,0,0,,تمساح! ما الخطب يا تمساح؟
Dialogue: 10,0:06:51.33,0:06:52.87,Default,,0,0,0,,تمساح؟
Dialogue: 10,0:06:51.33,0:06:52.87,Default,,0,0,0,,{\an8}.هذا يبعث على الحنين
Dialogue: 10,0:06:53.40,0:06:55.58,Default,,0,0,0,,أما زلت تعمل محققًا؟
Dialogue: 10,0:06:55.71,0:06:57.88,Default,,0,0,0,,.كلّا، أعمل في المكاتب الآن
Dialogue: 10,0:06:58.38,0:07:00.88,Note,,0,0,0,,.في قسم الإعداد للإصلاح
Dialogue: 10,0:07:02.30,0:07:04.63,Default,,0,0,0,,{\an8}...أطالع ملفات القضايا الماضية كل يوم
Dialogue: 10,0:07:04.76,0:07:07.89,Default,,0,0,0,,{\an8}...للاستفادة منها في إصلاح الشرطة
Dialogue: 10,0:07:11.47,0:07:14.27,Default,,0,0,0,,.وأكتب تقارير لن تُعتمد أبدًا
Dialogue: 10,0:07:14.39,0:07:17.97,Default,,0,0,0,,ما هذا؟ أليس هذا ما يسمى بالمقبرة الوظيفية؟
Dialogue: 10,0:07:18.36,0:07:20.44,Default,,0,0,0,,.لا ترمي الملح على الجرح
Dialogue: 10,0:07:20.86,0:07:23.03,Default,,0,0,0,,...لم أتوقع أن يؤول بمحقق بارع مثلك
Dialogue: 10,0:07:23.15,0:07:26.03,Default,,0,0,0,,.إلى هذا الحال
Dialogue: 10,0:07:26.15,0:07:28.28,Default,,0,0,0,,.قال بارع قال
Dialogue: 10,0:07:28.82,0:07:34.16,Default,,0,0,0,,.لكنني لم أضاهي براعتك قط في استخدام السلاح
Dialogue: 10,0:07:34.29,0:07:37.17,Default,,0,0,0,,.أحنّ لأيام مشاركتنا في التحقيق معًا
Dialogue: 10,0:07:37.29,0:07:38.88,Default,,0,0,0,,!هذا يبعث على الحنين
Dialogue: 10,0:07:39.00,0:07:43.00,Default,,0,0,0,,.اعتدنا المراهنة بحيث الشرب على حساب من يحلّ القضية أولًا
Dialogue: 10,0:07:43.13,0:07:45.48,Default,,0,0,0,,.أودّ رؤيتك تطلق النار مجددًا
Dialogue: 10,0:07:44.51,0:07:46.77,Default,,0,0,0,,{\an8}.هيا، لننظف المائدة
Dialogue: 10,0:07:46.30,0:07:47.68,Default,,0,0,0,,هل أحضر مسدسي المرة القادمة؟
Dialogue: 10,0:07:47.80,0:07:50.22,Default,,0,0,0,,!غبي! وكأن بإمكاني ذلك
Dialogue: 10,0:07:51.65,0:07:53.06,Default,,0,0,0,,.بالمناسبة يا كوغورو
Dialogue: 10,0:07:53.18,0:07:56.52,Default,,0,0,0,,هل تعرف المفتش ياماتو كانسكي من شرطة ناغانو؟
Dialogue: 10,0:07:56.64,0:07:57.94,Default,,0,0,0,,ياماتو كانسكي؟
Dialogue: 10,0:07:59.40,0:08:01.65,Default,,0,0,0,,.سبق أن حللنا قضية معًا
Dialogue: 10,0:08:01.77,0:08:03.19,Default,,0,0,0,,.كما توقعت
Dialogue: 10,0:08:03.32,0:08:05.69,Default,,0,0,0,,...بالمناسبة، قبل 10 أشهر تقريبًا
Dialogue: 10,0:08:05.82,0:08:10.00,Default,,0,0,0,,وقعت حادثة انهيار ثلجي في جبل ميتاكاراداكي\N.في ناغانو وأظنك تجهلها إن لم يخب ظني
Dialogue: 10,0:08:11.03,0:08:12.40,Default,,0,0,0,,...وهذا المفتش ياماتو
Dialogue: 10,0:08:12.43,0:08:13.61,Default,,0,0,0,,.وقع ضحية لذلك الحادث
Dialogue: 10,0:08:16.29,0:08:17.59,Default,,0,0,0,,.سمعت بذلك
Dialogue: 10,0:08:18.00,0:08:21.69,Default,,0,0,0,,قِيل إنه جُرف في أثناء مطاردته لأحدهم، أليس كذلك؟
Dialogue: 10,0:08:23.00,0:08:24.77,Default,,0,0,0,,!كوغورو، أيمكننا اللقاء حالًا؟
Dialogue: 10,0:08:24.85,0:08:26.01,Default,,0,0,0,,...كلا... مؤلم
Dialogue: 10,0:08:26.13,0:08:27.63,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 10,0:08:27.71,0:08:28.63,Default,,0,0,0,,.اهدأ
Dialogue: 10,0:08:29.05,0:08:30.34,Default,,0,0,0,,أتريد اللقاء في وقت كهذا؟
Dialogue: 10,0:08:30.76,0:08:32.93,Default,,0,0,0,,.آسف... لنلتقِ غدًا
Dialogue: 10,0:08:33.55,0:08:36.18,Default,,0,0,0,,.لا، غدًا لا يناسبني إذ عليّ الذهاب إلى ناغانو
Dialogue: 10,0:08:36.81,0:08:38.94,Default,,0,0,0,,أيمكننا اللقاء يوم الاثنين مطلع الأسبوع؟
Dialogue: 10,0:08:39.36,0:08:41.31,Default,,0,0,0,,لا بأس، ولكن ما الأمر؟
Dialogue: 10,0:08:41.94,0:08:44.10,Default,,0,0,0,,...إذن، الساعة التاسعة صباحًا في مقر شرطة العاصمة
Dialogue: 10,0:08:44.13,0:08:46.77,Default,,0,0,0,,.لا، المقر ليس مكانًا مناسبًا
Dialogue: 10,0:08:47.19,0:08:49.15,Default,,0,0,0,,هل يناسبك متنزه هيبيا القريب؟
Dialogue: 10,0:08:49.28,0:08:50.49,Default,,0,0,0,,.أجل، حسن
Dialogue: 10,0:08:51.07,0:08:53.83,Default,,0,0,0,,.آسف، أدين لك بمعروف يا كوغورو
Dialogue: 10,0:08:53.95,0:08:55.74,Default,,0,0,0,,.إنه طلب من تمساح دون سواه
Dialogue: 10,0:08:57.00,0:09:00.78,Default,,0,0,0,,...إن كنت تشعر بالامتنان هكذا... فدعنا كما في الأيام الخوالي
Dialogue: 10,0:09:00.87,0:09:02.87,Default,,0,0,0,,.نذهب للشرب على حسابك
Dialogue: 10,0:09:03.25,0:09:05.37,Default,,0,0,0,,!آهٍ منك يا أبي
Dialogue: 10,0:09:04.25,0:09:06.84,Default,,0,0,0,,{\an9}بالمناسبة يا تمساح، هل تزوجت؟
Dialogue: 10,0:09:06.96,0:09:09.52,Default,,0,0,0,,!ألم تتزوج بعد؟! يا إلهي
Dialogue: 10,0:09:10.05,0:09:13.14,Default,,0,0,0,,{\an8}!سقف توقعاتك عالٍ جدًا
Dialogue: 10,0:09:16.51,0:09:19.00,Default,,0,0,0,,مهلًا، لِمَ تتبعاني؟
Dialogue: 10,0:09:19.35,0:09:21.14,Default,,0,0,0,,.لأنني أريد مقابلته
Dialogue: 10,0:09:21.27,0:09:23.81,Default,,0,0,0,,.المحقق الذي كان صديقًا مقربًا لأبي
Dialogue: 10,0:09:23.94,0:09:25.86,Default,,0,0,0,,ألن تشاهدا مباراة كرة قدم بعد هذا؟
Dialogue: 10,0:09:25.98,0:09:28.90,Default,,0,0,0,,يا له من وقت فراغ لتقضيه\N!في موعد مع طفلين في يوم عطلة
Dialogue: 10,0:09:29.11,0:09:30.99,Default,,0,0,0,,.لا بأس في ذلك
Dialogue: 10,0:09:31.11,0:09:34.03,Default,,0,0,0,,،في الحقيقة، دعوت شينتشي
Dialogue: 10,0:09:34.16,0:09:36.88,Default,,0,0,0,,...لكنه قال إنه مشغول ولا يسعه المجيء
Dialogue: 10,0:09:37.20,0:09:39.29,Default,,0,0,0,,!بئسًا من ذلك المهووس بالتحقيق
Dialogue: 10,0:09:40.00,0:09:42.92,Default,,0,0,0,,.مهووس التحقيق حضر فعلًا
Dialogue: 10,0:10:14.36,0:10:15.33,Default,,0,0,0,,...كان ذلك للتو
Dialogue: 10,0:10:15.46,0:10:16.43,Default,,0,0,0,,!صوت طلق ناري
Dialogue: 10,0:10:18.58,0:10:20.11,Default,,0,0,0,,!انتظر يا كونان-كن
Dialogue: 10,0:10:21.66,0:10:23.00,Default,,0,0,0,,!لا تلمسه
Dialogue: 10,0:10:25.04,0:10:26.07,Default,,0,0,0,,!انتظر
Dialogue: 10,0:10:26.07,0:10:27.17,Default,,0,0,0,,!ما الخطب؟ تمساح؟
Dialogue: 10,0:10:27.29,0:10:28.78,Default,,0,0,0,,!أهذا صديقك تمساح؟
Dialogue: 10,0:10:29.00,0:10:30.00,Default,,0,0,0,,!لن تفلت مني
Dialogue: 10,0:10:34.51,0:10:35.68,Default,,0,0,0,,!أيها الوغد
Dialogue: 10,0:10:47.61,0:10:49.70,Default,,0,0,0,,.لا شكّ أنه المجرم
Dialogue: 10,0:11:00.41,0:11:02.00,Default,,0,0,0,,!إلى أين تنوي الهرب؟
Dialogue: 10,0:11:33.86,0:11:35.78,Default,,0,0,0,,!انطلقي
Dialogue: 10,0:11:52.80,0:11:53.55,Default,,0,0,0,,!تبًّا
Dialogue: 10,0:11:59.47,0:12:01.30,Default,,0,0,0,,.هذه الدراجة التي ركبها قبل قليل
Dialogue: 10,0:12:02.10,0:12:03.76,Default,,0,0,0,,هل هرب؟
Dialogue: 10,0:12:33.46,0:12:36.13,Default,,0,0,0,,{\an8}.أنا طالب الثانوية المتحري؛ كودو شينتشي
Dialogue: 10,0:12:36.59,0:12:40.59,Default,,0,0,0,,في أثناء ذهابي إلى مدينة الملاهي مع صديقة\N...طفولتي وزميلتي في الصف؛ موري ران
Dialogue: 10,0:12:40.72,0:12:44.57,Default,,0,0,0,,.شهدت صفقة مريبة لرجال يرتدون ملابس سوداء
Dialogue: 10,0:12:45.43,0:12:47.64,Default,,0,0,0,,...وفي أثناء انشغالي بمراقبة الصفقة
Dialogue: 10,0:12:47.77,0:12:51.00,Default,,0,0,0,,.باغتني شريك لهم اقترب مني من الخلف
Dialogue: 10,0:12:52.52,0:12:55.07,Default,,0,0,0,,...أجبرني ذلك الرجل على ابتلاع عقار سام
Dialogue: 10,0:12:55.19,0:12:56.48,Default,,0,0,0,,...وحين استيقظت
Dialogue: 10,0:12:58.82,0:13:00.99,Default,,0,0,0,,!كان جسدي قد تقلص
Dialogue: 10,0:13:01.45,0:13:03.99,Default,,0,0,0,,...إن علم أولئك الرجال أن كودو شينتشي لا يزال حيًا
Dialogue: 10,0:13:04.12,0:13:05.45,Default,,0,0,0,,،فسيستهدفون حياتي مجددًا
Dialogue: 10,0:13:05.54,0:13:07.75,Default,,0,0,0,,.وسيحيق الخطر بمن حولي
Dialogue: 10,0:13:09.12,0:13:12.50,Default,,0,0,0,,،قررت إخفاء هويتي اتباعًا لنصيحة البروفيسور أغاسا
Dialogue: 10,0:13:12.63,0:13:15.46,Default,,0,0,0,,...وحين سألتني ران عن اسمي، أجبت عفويًا
Dialogue: 10,0:13:15.84,0:13:18.13,Default,,0,0,0,,.أُدعى إيدوغاوا كونان
Dialogue: 10,0:13:18.26,0:13:19.97,Default,,0,0,0,,...ولكي أجمع المعلومات عنهم
Dialogue: 10,0:13:20.09,0:13:24.09,Default,,0,0,0,,انتقلت للعيش في وكالة التحريات\N.التي يديرها والدها، موري كوغورو
Dialogue: 10,0:13:27.52,0:13:32.19,Default,,0,0,0,,أمورو تورو، الذي يعمل في مقهى بوارو\N.الواقع أسفل وكالة موري للتحريات
Dialogue: 10,0:13:32.77,0:13:34.23,Default,,0,0,0,,...هويته الحقيقية هي
Dialogue: 10,0:13:34.36,0:13:39.03,Default,,0,0,0,,فورويا ري التابع لمنظمة زيرو السرية\N.التي تدير الشرطة السرية
Dialogue: 10,0:13:39.65,0:13:43.08,Default,,0,0,0,,وكازامي يويا؛ مرؤوس فورويا\N.في قسم الأمن العام في شرطة العاصمة
Dialogue: 10,0:13:44.20,0:13:46.43,Default,,0,0,0,,.ولدينا أيضًا موروفوشي هيروميتسو
Dialogue: 10,0:13:47.04,0:13:50.43,Default,,0,0,0,,،إنه زميل لفورويا وثمة مزاعم أنه محقق في الأمن العام
Dialogue: 10,0:13:51.16,0:13:53.11,Default,,0,0,0,,.ولكن يبدو أنه مات في أثناء تأدية الواجب
Dialogue: 10,0:13:55.17,0:13:56.77,Default,,0,0,0,,...شقيق هيروميتسو الأكبر
Dialogue: 10,0:13:57.55,0:14:00.28,Default,,0,0,0,,.موروفوشي تاكأكي، الملقب بكومي
Dialogue: 10,0:14:01.05,0:14:05.93,Default,,0,0,0,,وهو محقق في القسم الأول في شرطة ناغانو\N.مثل ياماتو كانسكي وأويهارا يوي
Dialogue: 10,0:14:07.14,0:14:08.68,Default,,0,0,0,,...يبدو أننا هذه المرة
Dialogue: 10,0:14:08.81,0:14:11.81,Default,,0,0,0,,.سنواجه قضية كبيرة تقحمهم جميعًا
Dialogue: 10,0:14:13.73,0:14:16.02,Default,,0,0,0,,.تقلّص الجسد، لكن العقل واحد
Dialogue: 10,0:14:16.15,0:14:18.02,Default,,0,0,0,,.المتحري العظيم الذي لا يستعصي عليه لغز
Dialogue: 10,0:14:18.15,0:14:20.85,Default,,0,0,0,,!الحقيقة واحدة دومًا
Dialogue: 10,0:14:34.25,0:14:36.75,Default,,0,0,0,,{\an8}!لا بأس! حاضر، سأفعل ذلك فورًا
Dialogue: 10,0:14:38.88,0:14:39.92,Default,,0,0,0,,!موري-سان
Dialogue: 10,0:14:41.01,0:14:42.47,Default,,0,0,0,,.المحقق تاكاغي
Dialogue: 10,0:14:42.80,0:14:44.48,Default,,0,0,0,,.سنتولى الأمر من هنا
Dialogue: 10,0:14:45.68,0:14:48.00,Default,,0,0,0,,هل تحريتم عن أمر دراجة المجرم؟
Dialogue: 10,0:14:48.30,0:14:51.00,Default,,0,0,0,,.نتحرى عن المالك عبر لوحة الأرقام
Dialogue: 10,0:14:51.56,0:14:54.44,Default,,0,0,0,,...كانت الدراجة عند مدخل قطار الأنفاق، ولكن
Dialogue: 10,0:14:54.56,0:14:57.00,Default,,0,0,0,,هل هرب المجرم عبر قطار الأنفاق؟
Dialogue: 10,0:14:57.36,0:14:59.07,Default,,0,0,0,,...هذا ما ظننته، ولكن
Dialogue: 10,0:15:00.69,0:15:01.98,Default,,0,0,0,,.لم أعثر عليه
Dialogue: 10,0:15:02.65,0:15:03.78,Default,,0,0,0,,.موري-سان
Dialogue: 10,0:15:03.90,0:15:07.00,Default,,0,0,0,,...سمعت أنك تعرف المفتش ساميتاني المقتول
Dialogue: 10,0:15:07.32,0:15:08.43,Default,,0,0,0,,المفتش؟
Dialogue: 10,0:15:09.66,0:15:10.87,Default,,0,0,0,,...تمساح
Dialogue: 10,0:15:12.08,0:15:14.00,Default,,0,0,0,,...أصبح مفتشًا إذن
Dialogue: 10,0:15:20.07,0:15:21.13,Default,,0,0,0,,!يا له من متعجرف
Dialogue: 10,0:15:24.26,0:15:25.00,Default,,0,0,0,,تمساح؟
Dialogue: 10,0:15:25.80,0:15:27.00,Default,,0,0,0,,ما قصده بتمساح؟
Dialogue: 10,0:15:27.34,0:15:29.76,Default,,0,0,0,,.يبدو أنه لقب المفتش ساميتاني
Dialogue: 10,0:15:33.52,0:15:34.47,Default,,0,0,0,,.تمساح
Dialogue: 10,0:15:35.48,0:15:38.25,Default,,0,0,0,,!أنت! ألم ترغب في سؤالي عن شيء؟
Dialogue: 10,0:15:38.47,0:15:39.30,Default,,0,0,0,,...موري-سان
Dialogue: 10,0:15:39.40,0:15:40.50,Default,,0,0,0,,...أردت شيئًا مني
Dialogue: 10,0:15:41.02,0:15:42.00,Default,,0,0,0,,!تبًّا
Dialogue: 10,0:15:42.65,0:15:43.74,Default,,0,0,0,,!اهدأ
Dialogue: 10,0:15:44.57,0:15:46.55,Default,,0,0,0,,!ألم ترغب في سؤالي عن شيء؟
Dialogue: 10,0:15:47.36,0:15:48.91,Default,,0,0,0,,!أجبني يا تمساح
Dialogue: 10,0:15:50.66,0:15:51.70,Default,,0,0,0,,!تمساح
Dialogue: 10,0:15:51.83,0:15:53.20,Default,,0,0,0,,!أجبني
Dialogue: 10,0:15:51.83,0:15:53.20,Default,,0,0,0,,{\an8}!موري-سان
Dialogue: 10,0:15:53.33,0:15:55.91,Default,,0,0,0,,!تمساح! تمساح
Dialogue: 10,0:15:59.08,0:16:00.00,Default,,0,0,0,,.مفتش ميغوري
Dialogue: 10,0:16:01.71,0:16:04.42,Default,,0,0,0,,.هذا مكتب المفتش ساميتاني
Dialogue: 10,0:16:04.59,0:16:06.88,Default,,0,0,0,,.قسم الإعداد للإصلاح
Dialogue: 10,0:16:07.01,0:16:10.18,Default,,0,0,0,,.فرع أجهله رغم أننا في نفس الإدارة الجنائية
Dialogue: 10,0:16:10.30,0:16:11.68,Default,,0,0,0,,.لا عجب في ذلك
Dialogue: 10,0:16:11.80,0:16:15.06,Default,,0,0,0,,.إنه مقبرة وظيفية لضباط الشرطة
Dialogue: 10,0:16:15.22,0:16:16.39,Default,,0,0,0,,من هذا؟
Dialogue: 10,0:16:16.52,0:16:18.48,Default,,0,0,0,,.إنه المفتش سوغا، رئيس القسم
Dialogue: 10,0:16:19.31,0:16:21.31,Default,,0,0,0,,.أنا ميغوري من القسم الأول
Dialogue: 10,0:16:21.86,0:16:25.53,Default,,0,0,0,,...كان المفتش ساميتاني في القسم الأول
Dialogue: 10,0:16:25.65,0:16:27.57,Default,,0,0,0,,.نُقل إلينا مؤخرًا
Dialogue: 10,0:16:28.07,0:16:29.60,Default,,0,0,0,,نُقل؟
Dialogue: 10,0:16:29.67,0:16:32.07,Default,,0,0,0,,...كان محققًا بارعًا
Dialogue: 10,0:16:32.20,0:16:33.00,Default,,0,0,0,,.حضرة المفتش
Dialogue: 10,0:16:33.49,0:16:35.82,Default,,0,0,0,,.هذا آخر ملف اطّلع عليه
Dialogue: 10,0:16:38.00,0:16:40.83,Default,,0,0,0,,...حادثة الانهيار الثلجي في ناغانو
Dialogue: 10,0:16:42.29,0:16:45.56,Default,,0,0,0,,.صحيح، قال تمساح إنه ذاهب إلى ناغانو
Dialogue: 10,0:16:45.59,0:16:49.01,Default,,0,0,0,,،أجل، ولكن حين راجعنا شرطة ناغانو
Dialogue: 10,0:16:49.13,0:16:51.44,Default,,0,0,0,,.أفادت بأن المفتش ساميتاني لم يأتِ
Dialogue: 10,0:16:51.76,0:16:52.65,Default,,0,0,0,,!ماذا قلت؟
Dialogue: 10,0:16:52.97,0:16:54.35,Default,,0,0,0,,.مفتش شيراتوري
Dialogue: 10,0:16:54.47,0:16:57.68,Default,,0,0,0,,،تحرينا أمر الدراجة المزعوم بأنها للمشتبه به
Dialogue: 10,0:16:57.81,0:17:00.35,Default,,0,0,0,,.لكن اتّضح أنها مسروقة وتعذّر تتبعها
Dialogue: 10,0:17:00.48,0:17:02.31,Default,,0,0,0,,لمَ يتدخل الأمن العام؟
Dialogue: 10,0:17:02.44,0:17:04.98,Default,,0,0,0,,هل لأن المقتول في الجريمة ضابط شرطة يا ترى؟
Dialogue: 10,0:17:05.11,0:17:06.36,Default,,0,0,0,,.كما توقعت
Dialogue: 10,0:17:06.48,0:17:09.36,Default,,0,0,0,,.على أيّ حال، سيُنشأ مقر للتحقيق قريبًا
Dialogue: 10,0:17:06.48,0:17:09.36,Note,,0,0,0,,.ملاحظة: لا يُنشأ مقر للتحقيق إلّا في الجرائم الكبيرة
Dialogue: 10,0:17:09.49,0:17:12.03,Default,,0,0,0,,سأذهب إلى هناك، ماذا عنكما؟
Dialogue: 10,0:17:12.16,0:17:14.16,Default,,0,0,0,,.نحن ذاهبان إلى ناغانو
Dialogue: 10,0:17:14.28,0:17:15.11,Default,,0,0,0,,.فهمت
Dialogue: 10,0:17:15.49,0:17:18.83,Default,,0,0,0,,.أرسلا أيّ معلومات من ناغانو إلى مقر التحقيق أولًا بأول
Dialogue: 10,0:17:18.96,0:17:19.87,Default,,0,0,0,,!حاضر
Dialogue: 10,0:17:19.90,0:17:20.96,Default,,0,0,0,,.سأذهب معكما
Dialogue: 10,0:17:21.37,0:17:24.71,Default,,0,0,0,,...موري-سان، لا يمكن إشراك مدني في تحقيق خارج المقاطعة
Dialogue: 10,0:17:24.84,0:17:26.34,Default,,0,0,0,,!قُتل صديقي
Dialogue: 10,0:17:26.34,0:17:27.34,Default,,0,0,0,,...تمهل
Dialogue: 10,0:17:27.46,0:17:30.51,Default,,0,0,0,,!كنت في مسرح الجريمة ورأيت المجرم ولو أنها لمحة
Dialogue: 10,0:17:31.05,0:17:34.39,Default,,0,0,0,,!وفي بادئ الأمر، ربما قتله المجرم لأنه أراد سماع شيء أعرفه
Dialogue: 10,0:17:34.51,0:17:36.07,Default,,0,0,0,,!ربما هذا السبب
Dialogue: 10,0:17:36.10,0:17:37.06,Default,,0,0,0,,.أبي
Dialogue: 10,0:17:37.18,0:17:39.81,Default,,0,0,0,,!ليس لديكم خيار سوى اصطحابي
Dialogue: 10,0:17:40.23,0:17:41.06,Default,,0,0,0,,.معه حق
Dialogue: 10,0:17:41.13,0:17:43.41,Default,,0,0,0,,.لنعدّه تعاونًا في التحقيق إذن
Dialogue: 10,0:17:43.48,0:17:45.44,Default,,0,0,0,,!وأنا أيضًا إذ رأيت المجرم
Dialogue: 10,0:17:45.57,0:17:46.59,Default,,0,0,0,,!لا تتبعني
Dialogue: 10,0:17:47.78,0:17:49.30,Default,,0,0,0,,!الأمر ليس لعبًا
Dialogue: 10,0:17:55.07,0:17:56.66,Default,,0,0,0,,.إذن، سأستأذن الآن
Dialogue: 10,0:17:57.29,0:17:58.18,Default,,0,0,0,,.حاضر
Dialogue: 10,0:17:59.17,0:18:00.08,Default,,0,0,0,,.كونان-كن
Dialogue: 10,0:18:03.33,0:18:05.89,Default,,0,0,0,,...بخصوص تذكرتي المباراة
Dialogue: 10,0:18:07.63,0:18:09.17,Default,,0,0,0,,ماذا نفعل بها؟
Dialogue: 10,0:18:09.30,0:18:10.84,Default,,0,0,0,,!آسف يا ران نيه-تشان
Dialogue: 10,0:18:13.18,0:18:14.47,Default,,0,0,0,,{\an8}.مذهل
Dialogue: 10,0:18:14.59,0:18:16.11,Default,,0,0,0,,!لنذهب إلى هناك
Dialogue: 10,0:18:16.14,0:18:17.47,Default,,0,0,0,,!لنذهب
Dialogue: 10,0:18:16.14,0:18:17.47,Default,,0,0,0,,{\an8}!لنذهب
Dialogue: 10,0:18:21.06,0:18:22.20,Default,,0,0,0,,!الثلج جميل
Dialogue: 10,0:18:22.23,0:18:23.66,Default,,0,0,0,,!منظر خلاب
Dialogue: 10,0:18:23.69,0:18:24.93,Default,,0,0,0,,!يبدو شهيًا
Dialogue: 10,0:18:25.10,0:18:27.06,Default,,0,0,0,,!بروفيسور
Dialogue: 10,0:18:28.52,0:18:29.62,Default,,0,0,0,,سينباي؟
Dialogue: 10,0:18:31.32,0:18:33.11,Default,,0,0,0,,!أهلًا يا أوتشي-كن
Dialogue: 10,0:18:33.24,0:18:35.99,Default,,0,0,0,,.لم نلتقِ منذ زمن يا أغاسا-سينباي
Dialogue: 10,0:18:36.41,0:18:38.03,Default,,0,0,0,,.هؤلاء هم الأطفال
Dialogue: 10,0:18:38.16,0:18:40.48,Default,,0,0,0,,!مرحبًا
Dialogue: 10,0:18:40.54,0:18:43.75,Default,,0,0,0,,.مرحبًا، أنا أوتشي من المرصد
Dialogue: 10,0:18:43.87,0:18:46.89,Default,,0,0,0,,{\an8}.سررنا بلقائك
Dialogue: 10,0:18:46.42,0:18:47.54,Default,,0,0,0,,.عذرًا للحظة
Dialogue: 10,0:18:48.88,0:18:50.05,Default,,0,0,0,,شينتشي؟
Dialogue: 10,0:18:55.93,0:18:58.93,Default,,0,0,0,,.فهمت، سأذهب إلى المرصد مباشرة
Dialogue: 10,0:18:59.39,0:19:01.00,Default,,0,0,0,,.شكرًا، إلى اللقاء
Dialogue: 10,0:19:03.14,0:19:05.94,Default,,0,0,0,,.لم أتوقع أن يؤول بنا بالذهاب إلى ناغانو
Dialogue: 10,0:19:06.46,0:19:07.47,Default,,0,0,0,,...يمكنني الذهاب وحدي
Dialogue: 10,0:19:07.50,0:19:08.31,Default,,0,0,0,,.كلا
Dialogue: 10,0:19:08.40,0:19:12.78,Default,,0,0,0,,.كما أنني قلقة على أبي ولن أستمتع بالمباراة
Dialogue: 10,0:19:12.90,0:19:14.82,Default,,0,0,0,,...خسارة التذاكر مؤسفة، ولكن
Dialogue: 10,0:19:15.35,0:19:16.11,Default,,0,0,0,,!وجدتها
Dialogue: 10,0:19:17.41,0:19:18.42,Default,,0,0,0,,كرة قدم؟
Dialogue: 10,0:19:19.45,0:19:23.12,Default,,0,0,0,,.لا بأس، لديّ موعد سينما مع ماكوتو-سان اليوم
Dialogue: 10,0:19:23.25,0:19:25.41,Default,,0,0,0,,،يمكنكِ الذهاب إلى السينما في أيّ وقت
Dialogue: 10,0:19:25.54,0:19:27.79,Default,,0,0,0,,.لكن المباراة لا تُعرض إلّا اليوم
Dialogue: 10,0:19:28.82,0:19:31.13,Default,,0,0,0,,هل يهتم ماكوتو-سان بكرة القدم يا ترى؟
Dialogue: 10,0:19:31.75,0:19:33.34,Default,,0,0,0,,ألستِ مهتمة؟
Dialogue: 10,0:19:33.56,0:19:35.48,Default,,0,0,0,,!هيدي من فريق سبيريتس وسيم جدًا
Dialogue: 10,0:19:36.30,0:19:37.89,Default,,0,0,0,,!أهي مباراة لفريق سبيريتس؟
Dialogue: 10,0:19:38.01,0:19:38.91,Default,,0,0,0,,!أجل
Dialogue: 10,0:19:38.99,0:19:40.84,Default,,0,0,0,,...إن هتفتِ لهيدي
Dialogue: 10,0:19:41.18,0:19:43.00,Default,,0,0,0,,...فربما يغار كيوغوكو-سان
Dialogue: 10,0:19:43.47,0:19:46.73,Default,,0,0,0,,!وتشتعل نيران الحب
Dialogue: 10,0:19:49.40,0:19:51.90,Default,,0,0,0,,!هيدي! سدد
Dialogue: 10,0:19:52.02,0:19:53.00,Default,,0,0,0,,!سونوكو-سان
Dialogue: 10,0:19:53.02,0:19:53.73,Default,,0,0,0,,!نعم
Dialogue: 10,0:19:53.86,0:19:56.24,Default,,0,0,0,,!لو كنت مكانه لما سمحت له بالتسديد
Dialogue: 10,0:19:56.74,0:19:59.62,Default,,0,0,0,,!لن أسمح بدخول هدف واحد في مرمى سونوكو-سان
Dialogue: 10,0:20:00.16,0:20:01.47,Default,,0,0,0,,!ماكوتو-سان
Dialogue: 10,0:20:01.99,0:20:06.46,Default,,0,0,0,,!ويلي! ران، أنتِ داهية! داهية في الحب
Dialogue: 10,0:20:06.79,0:20:10.08,Default,,0,0,0,,!أعطيني تلك التذكرتين
Dialogue: 10,0:20:10.84,0:20:13.00,Default,,0,0,0,,،بخصوص الانهيار الثلجي قبل 10 أشهر
Dialogue: 10,0:20:13.75,0:20:17.76,Default,,0,0,0,,جُرف المفتش ياماتو في أثناء مطاردته\Nلأحدهم في الجبل، أليس كذلك؟
Dialogue: 10,0:20:17.88,0:20:21.85,Default,,0,0,0,,.أجل، كان يطارد الهارب ميكوريا ساداكوني
Dialogue: 10,0:20:21.97,0:20:26.10,Default,,0,0,0,,...قبل 8 سنوات، اقتحم لصان متجر أسلحة في ناغانو
Dialogue: 10,0:20:26.35,0:20:29.41,Default,,0,0,0,,.لسرقة بنادق صيد وذخيرة
Dialogue: 10,0:20:36.77,0:20:37.57,Default,,0,0,0,,...في ذلك الوقت
Dialogue: 10,0:20:37.70,0:20:43.16,Default,,0,0,0,,عادت الموظفة فوناكوبو ماكي-سان\N،إلى المتجر رغم تأخر الوقت
Dialogue: 10,0:20:43.28,0:20:46.58,Default,,0,0,0,,.وأُصيبت قدمها أثناء هروب المجرمين
Dialogue: 10,0:20:47.83,0:20:49.33,Default,,0,0,0,,،بناءً على بلاغ من المتجر
Dialogue: 10,0:20:49.46,0:20:52.92,Default,,0,0,0,,،اكتشف الشرطي كاي كوروتو، الذي كان في دورية
Dialogue: 10,0:20:53.04,0:20:57.30,Default,,0,0,0,,.أحد اللصين ويدعى واشيزو تاكاشي واعتقله
Dialogue: 10,0:20:57.92,0:21:00.59,Default,,0,0,0,,،وفي اليوم التالي، وبناءً على اعتراف واشيزو
Dialogue: 10,0:21:00.97,0:21:03.61,Default,,0,0,0,,،عُثر على الشريك الآخر المختبئ في الجبل
Dialogue: 10,0:21:05.85,0:21:08.85,Default,,0,0,0,,.ميكوريا ساداكوني، واعتُقل
Dialogue: 10,0:21:09.52,0:21:10.26,Default,,0,0,0,,.حسن
Dialogue: 10,0:21:10.32,0:21:11.56,Default,,0,0,0,,،حين نصل إلى ناغانو
Dialogue: 10,0:21:11.69,0:21:14.61,Default,,0,0,0,,.علينا سؤال الشرطي الذي قبض عليهما
Dialogue: 10,0:21:15.31,0:21:16.61,Default,,0,0,0,,.هذا مستحيل
Dialogue: 10,0:21:16.94,0:21:20.86,Default,,0,0,0,,.لأن الشرطي كاي توفي إثر سقوطه في الجبل قبل 6 سنوات
Dialogue: 10,0:21:22.24,0:21:24.62,Default,,0,0,0,,...حسب السجلات، القضية المتعلقة بذلك
Dialogue: 10,0:21:24.95,0:21:28.00,Default,,0,0,0,,.حلّها موري-سان بالتعاون مع شرطة ناغانو
Dialogue: 10,0:21:29.71,0:21:30.56,Default,,0,0,0,,أنا؟
Dialogue: 10,0:21:31.08,0:21:32.34,Default,,0,0,0,,...وبالأحرى، تلك القضية
Dialogue: 10,0:21:33.00,0:21:36.17,Default,,0,0,0,,...أذكر أنها حُلّت دون أن أدري
Dialogue: 10,0:21:36.30,0:21:40.05,Default,,0,0,0,,،حصل ميكوريا على إفراج مشروط قبل 6 سنوات
Dialogue: 10,0:21:40.17,0:21:42.30,Default,,0,0,0,,.لكنه اختفى فورًا بعدها
Dialogue: 10,0:21:42.43,0:21:43.26,Default,,0,0,0,,اختفى؟
Dialogue: 10,0:21:43.39,0:21:45.76,Default,,0,0,0,,،أجل، وقبل 10 أشهر
Dialogue: 10,0:21:45.89,0:21:48.72,Default,,0,0,0,,،عثر عليه المفتش ياماتو وفي أثناء مطاردته
Dialogue: 10,0:21:48.85,0:21:51.00,Default,,0,0,0,,...جرفه الانهيار الثلجي وفُقد أثره
Dialogue: 10,0:21:52.06,0:21:55.48,Default,,0,0,0,,،لم نتوقع جرف الانهيار الثلجي للمفتش
Dialogue: 10,0:21:55.61,0:21:57.46,Default,,0,0,0,,.لذا لم يجده أحد لفترة طويلة
Dialogue: 10,0:21:57.48,0:22:00.28,Default,,0,0,0,,كونان-كن، هل هذا حذاء تسلق جديد؟
Dialogue: 10,0:22:00.40,0:22:03.36,Default,,0,0,0,,.أ-أجل، أعطاني إياه البروفيسور
Dialogue: 10,0:22:03.49,0:22:04.74,Default,,0,0,0,,.إنه رائع
Dialogue: 10,0:22:06.08,0:22:09.25,Default,,0,0,0,,،وبينما تضاءل الأمل في سلامة المفتش ياماتو
Dialogue: 10,0:22:09.75,0:22:13.92,Default,,0,0,0,,،نجا ميكوريا ساداكوني من الانهيار بأعجوبة
Dialogue: 10,0:22:14.04,0:22:16.97,Default,,0,0,0,,.وظلّ مختبئًا في الجبل
Dialogue: 10,0:22:26.85,0:22:28.47,Default,,0,0,0,,...وميكوريا ذاك
Dialogue: 10,0:22:28.60,0:22:32.73,Default,,0,0,0,,،عثر عليه مفتش من شرطة ناغانو يدعى موروفوشي تاكأكي
Dialogue: 10,0:22:32.85,0:22:34.71,Default,,0,0,0,,.واعتقله مجددًا
Dialogue: 10,0:22:35.81,0:22:38.90,Default,,0,0,0,,،حين علم المفتش موروفوشي بأمر الانهيار الثلجي
Dialogue: 10,0:22:39.02,0:22:42.44,Default,,0,0,0,,،استنتج من اتجاه الانهيار أنه ليس في محافظة ناغانو
Dialogue: 10,0:22:42.57,0:22:45.07,Default,,0,0,0,,،بل يحتمل وجوده في محافظة ياماناشي
Dialogue: 10,0:22:45.74,0:22:47.58,Default,,0,0,0,,،وفي مستشفى عند سفح الجبل في ياماناشي
Dialogue: 10,0:22:47.87,0:22:52.66,Default,,0,0,0,,.عثر أخيرًا على المفتش ياماتو فاقدًا للوعي
Dialogue: 10,0:23:04.51,0:23:07.34,Default,,0,0,0,,.لم نلتقِ منذ زمن أيها المتحري موري
Dialogue: 10,0:23:08.68,0:23:10.68,Default,,0,0,0,,.هذان متيّما شرطة العاصمة
Dialogue: 10,0:23:11.37,0:23:13.02,Default,,0,0,0,,مـ-متيّما؟
Dialogue: 10,0:23:13.31,0:23:14.89,Default,,0,0,0,,.هذا مصطلح قديم
Dialogue: 10,0:23:15.19,0:23:16.30,Default,,0,0,0,,حقًا؟
Dialogue: 10,0:23:16.77,0:23:19.02,Default,,0,0,0,,...إذن، هذان ثنائي شرطة ناغانو
Dialogue: 10,0:23:19.15,0:23:22.15,Default,,0,0,0,,.لحظة، لـ-لسنا ثنائيًا
Dialogue: 10,0:23:22.69,0:23:24.78,Default,,0,0,0,,مهـ... أحقًا؟
Dialogue: 10,0:23:25.07,0:23:27.57,Default,,0,0,0,,.على أيّ حال، سأعتمد عليكما في قضية تمساح
Dialogue: 10,0:23:27.70,0:23:28.49,Default,,0,0,0,,تمساح؟
Dialogue: 10,0:23:28.62,0:23:31.49,Default,,0,0,0,,.يبدو أنه لقب المفتش ساميتاني
Dialogue: 10,0:23:31.62,0:23:33.76,Default,,0,0,0,,.اتضح أنه صديق لموري-سان
Dialogue: 10,0:23:35.04,0:23:37.17,Default,,0,0,0,,بالمناسبة، أين ذلك الصبي؟
Dialogue: 10,0:23:37.39,0:23:40.21,Default,,0,0,0,,...الذي يرافقك دائمًا ويتمتع بحدس قوي
Dialogue: 10,0:23:40.34,0:23:41.34,Default,,0,0,0,,.تركته خلفي
Dialogue: 10,0:23:42.96,0:23:44.55,Default,,0,0,0,,.الأمر ليس لعبًا
Dialogue: 10,0:23:45.47,0:23:47.27,Default,,0,0,0,,.سأركب في الأمام إذن
Dialogue: 10,0:23:49.68,0:23:51.46,Default,,0,0,0,,هل أنت بخير يا كونان-كن؟
Dialogue: 10,0:23:53.18,0:23:55.06,Default,,0,0,0,,.بدأ الجو يبرد
Dialogue: 10,0:23:55.18,0:23:57.00,Default,,0,0,0,,.علينا الحرص كي لا تصاب بالزكام
Dialogue: 10,0:23:58.27,0:23:59.65,Default,,0,0,0,,.حسن، انتهيت
Dialogue: 10,0:23:59.77,0:24:02.22,Default,,0,0,0,,.شـ-شكرًا لكِ
Dialogue: 10,0:24:04.71,0:24:05.47,Default,,0,0,0,,.آسف
Dialogue: 10,0:24:05.53,0:24:07.03,Default,,0,0,0,,هل أنت بخير يا فتى؟
Dialogue: 10,0:24:08.66,0:24:09.82,Default,,0,0,0,,.آسف حقًا
Dialogue: 10,0:24:11.08,0:24:12.95,Default,,0,0,0,,هل أنت بخير يا كونان-كن؟
Dialogue: 10,0:24:12.99,0:24:14.95,Default,,0,0,0,,!أجل، أنا بخير! لنذهب
Dialogue: 10,0:24:16.37,0:24:18.50,Default,,0,0,0,,كونان-كن، سنتوجه إلى المرصد، أليس كذلك؟
Dialogue: 10,0:24:18.83,0:24:22.75,Default,,0,0,0,,أجل، إن ذهبت إلى الشرطة المحافظة\N.الآن فسيوبخني عمي لا أكثر
Dialogue: 10,0:24:23.88,0:24:27.01,Default,,0,0,0,,.إلى مرصد نوبياما الفلكي الوطني رجاءً
Dialogue: 10,0:24:27.13,0:24:27.76,Default,,0,0,0,,.حاضر
Dialogue: 10,0:24:30.68,0:24:31.64,Default,,0,0,0,,!جهاز تنصت؟
Dialogue: 10,0:24:33.14,0:24:35.64,Default,,0,0,0,,!أيعقل أن الرجل منذ قليل وضعه عليّ؟
Dialogue: 10,0:24:37.02,0:24:38.06,Default,,0,0,0,,...من يكون
Dialogue: 10,0:24:38.73,0:24:40.15,Default,,0,0,0,,ولمَ يضعه عليّ؟
Dialogue: 10,0:24:41.19,0:24:43.77,Default,,0,0,0,,.أجل، فعلت كما أمرت
Dialogue: 10,0:24:43.90,0:24:45.07,Default,,0,0,0,,...ولكن
Dialogue: 10,0:24:45.19,0:24:48.65,Default,,0,0,0,,...لمَ نحتاج إلى وضع جهاز تنصت على طفل كهذا
Dialogue: 10,0:24:49.24,0:24:50.69,Default,,0,0,0,,يا مساعد المفتش كازامي؟
Dialogue: 10,0:24:54.74,0:24:58.12,Default,,0,0,0,,،بعد تعرضك للانهيار الثلجي قبل 10 أشهر يا مفتش ياماتو
Dialogue: 10,0:24:58.25,0:25:00.86,Default,,0,0,0,,كيف نُقلت إلى مستشفى ياماناشي؟
Dialogue: 10,0:25:01.58,0:25:03.54,Default,,0,0,0,,.أفكّر في هذا طوال الوقت
Dialogue: 10,0:25:04.80,0:25:08.67,Default,,0,0,0,,.يبدو أن أحدهم أنقذ المفتش ياماتو من ذلك الانهيار
Dialogue: 10,0:25:09.30,0:25:11.34,Default,,0,0,0,,أحدهم؟ ألا تعرفان هويته؟
Dialogue: 10,0:25:11.76,0:25:15.96,Default,,0,0,0,,،أجل، يبدو أنه طلب الإسعاف من هاتف عمومي عند السفح
Dialogue: 10,0:25:16.52,0:25:18.25,Default,,0,0,0,,.لكننا لم نجد بصمات
Dialogue: 10,0:25:19.64,0:25:23.94,Default,,0,0,0,,ماذا حلّ بالمدعو ميكوريا\Nالذي قبض عليه المفتش موروفوشي؟
Dialogue: 10,0:25:24.06,0:25:26.53,Default,,0,0,0,,.عاد إلى السجن بالطبع
Dialogue: 10,0:25:26.65,0:25:29.32,Default,,0,0,0,,ماذا عن واشيزو تاكاشي الذي اعتُقل قبل 8 سنوات؟
Dialogue: 10,0:25:29.45,0:25:31.03,Default,,0,0,0,,ألا يزال يقضي محكوميته؟
Dialogue: 10,0:25:32.28,0:25:35.79,Default,,0,0,0,,.واشيزو... لا يقضي محكومية
Dialogue: 10,0:25:36.41,0:25:39.87,Default,,0,0,0,,،حُكم على كل من ميكوريا وواشيزو بالسجن 3 سنوات
Dialogue: 10,0:25:40.00,0:25:42.67,Default,,0,0,0,,.لكن حصل واشيزو على حكم مع وقف التنفيذ
Dialogue: 10,0:25:43.73,0:25:45.17,Default,,0,0,0,,{\an8}!جبل فوجي
Dialogue: 10,0:25:45.50,0:25:46.80,Default,,0,0,0,,{\an8}.إنه مذهل
Dialogue: 10,0:25:46.92,0:25:50.01,Default,,0,0,0,,لمَ هذا التفاوت في الحكم؟
Dialogue: 10,0:25:50.13,0:25:52.38,Default,,0,0,0,,...لذا لم يُسجن واشيزو
Dialogue: 10,0:25:53.51,0:25:55.05,Default,,0,0,0,,.بلغنا حدّ المسافة للاتصال
Dialogue: 10,0:25:56.56,0:25:57.83,Default,,0,0,0,,...ربما الرسائل
Dialogue: 10,0:25:58.76,0:25:59.39,Default,,0,0,0,,...كلا
Dialogue: 10,0:25:59.52,0:26:01.99,Default,,0,0,0,,.المحقق تاكاغي مع عمي الآن
Dialogue: 10,0:26:09.40,0:26:11.34,Default,,0,0,0,,.خذي هذا رجاءً يا أزوسا-سان
Dialogue: 10,0:26:11.86,0:26:12.90,Default,,0,0,0,,.حاضر
Dialogue: 10,0:26:14.49,0:26:15.66,Default,,0,0,0,,.عذرًا على التأخير
Dialogue: 10,0:26:15.78,0:26:17.88,Default,,0,0,0,,.سأترك خلطه لك
Dialogue: 10,0:26:18.66,0:26:20.00,Default,,0,0,0,,.استمتع بوقتك
Dialogue: 10,0:26:26.50,0:26:28.97,Default,,0,0,0,,!الكثير من الهوائيات
Dialogue: 10,0:26:29.00,0:26:30.96,Default,,0,0,0,,!مذهل
Dialogue: 10,0:26:31.09,0:26:33.72,Default,,0,0,0,,!أكثر من الهوائيات في منزل البروفيسور
Dialogue: 10,0:26:33.84,0:26:35.05,Default,,0,0,0,,.هذا طبيعي
Dialogue: 10,0:26:35.88,0:26:36.80,Default,,0,0,0,,!انظروا
Dialogue: 10,0:26:37.30,0:26:39.87,Default,,0,0,0,,!ذلك الهوائي ضخم
Dialogue: 10,0:26:40.10,0:26:41.23,Default,,0,0,0,,!انظروا رجاءً
Dialogue: 10,0:26:41.35,0:26:43.89,Default,,0,0,0,,!ذلك الصحن أكبر بكثير
Dialogue: 10,0:26:44.38,0:26:45.33,Default,,0,0,0,,أين؟ أين؟
Dialogue: 10,0:26:45.35,0:26:47.15,Default,,0,0,0,,{\an8}ميتسوهيكو-كن، هل أنت بخير؟
Dialogue: 10,0:26:45.35,0:26:47.15,Default,,0,0,0,,!إنه ضخم حقَّا
Dialogue: 10,0:26:47.27,0:26:48.77,Default,,0,0,0,,...مهلًا يا غينتا-كن
Dialogue: 10,0:26:48.90,0:26:51.00,Default,,0,0,0,,!آسف. ضخم
Dialogue: 10,0:26:58.37,0:27:00.45,Default,,0,0,0,,!اخرس! ليس هذا ما أعنيه
Dialogue: 10,0:27:00.58,0:27:02.70,Default,,0,0,0,,!قلت لك نادِ ياماتو كانسكي
Dialogue: 10,0:27:02.83,0:27:04.96,Default,,0,0,0,,.اهدأ قليلًا رجاءً
Dialogue: 10,0:27:05.08,0:27:06.03,Default,,0,0,0,,!أنت
Dialogue: 10,0:27:07.13,0:27:08.43,Default,,0,0,0,,!تمهل رجاءً
Dialogue: 10,0:27:09.75,0:27:11.77,Default,,0,0,0,,.لا بأس، شكرًا لك
Dialogue: 10,0:27:12.05,0:27:13.00,Default,,0,0,0,,.حاضر
Dialogue: 10,0:27:14.05,0:27:16.76,Default,,0,0,0,,ألم تعثروا على واشيزو تاكاشي بعد؟
Dialogue: 10,0:27:16.89,0:27:19.72,Default,,0,0,0,,واشيزو؟ المجرم قبل 8 سنوات؟
Dialogue: 10,0:27:19.85,0:27:21.99,Default,,0,0,0,,.أجل، من حصل على حكم مع وقف التنفيذ
Dialogue: 10,0:27:22.02,0:27:25.84,Default,,0,0,0,,.أجل، ذلك الجبان الذي توارى عن الأنظار بعدها
Dialogue: 10,0:27:26.06,0:27:27.56,Default,,0,0,0,,توارى عن الأنظار؟
Dialogue: 10,0:27:27.69,0:27:30.27,Default,,0,0,0,,.فور انتهاء فترة وقف التنفيذ
Dialogue: 10,0:27:30.40,0:27:34.40,Default,,0,0,0,,.قلت لك مرارًا، لا تستطيع الشرطة البحث عن واشيزو
Dialogue: 10,0:27:34.53,0:27:37.47,Default,,0,0,0,,...بانتهاء فترة وقف التنفيذ، يُعتبر أنه كفّر عن ذنبه
Dialogue: 10,0:27:37.47,0:27:38.45,Default,,0,0,0,,!لا تعبث معي
Dialogue: 10,0:27:38.57,0:27:41.70,Default,,0,0,0,,!قتل ماكي وتقول إنه كفّر عن ذنبه؟
Dialogue: 10,0:27:42.16,0:27:43.34,Default,,0,0,0,,قتلها؟
Dialogue: 10,0:27:43.66,0:27:47.48,Default,,0,0,0,,أتقصد فوناكوبو ماكي-سان؛ ضحية حادثة ما قبل 8 سنوات؟
Dialogue: 10,0:27:48.00,0:27:51.46,Default,,0,0,0,,{\an8}.هذا والدها؛ فوناكوبو إيزو-سان
Dialogue: 10,0:27:52.67,0:27:56.02,Default,,0,0,0,,...لكن ماكي-سان جُرحت فحسب ولم تفارق
Dialogue: 10,0:27:56.05,0:28:00.57,Default,,0,0,0,,.كلّا، توفيت في نفس العام
Dialogue: 10,0:28:02.89,0:28:05.48,Default,,0,0,0,,.كانت ماكي لاعبة بياثلون
Dialogue: 10,0:28:05.77,0:28:07.04,Default,,0,0,0,,بياثلون؟
Dialogue: 10,0:28:07.27,0:28:11.02,Default,,0,0,0,,أليست رياضة تجمع بين التزلج والرماية بالبندقية؟
Dialogue: 10,0:28:11.44,0:28:13.46,Default,,0,0,0,,.وهي رياضة أولمبية أيضًا
Dialogue: 10,0:28:15.49,0:28:18.91,Default,,0,0,0,,،تراجع أداء ماكي بسبب تلك الإصابة
Dialogue: 10,0:28:19.03,0:28:22.23,Default,,0,0,0,,{\an8}.واستُبعدت من قائمة المرشحين للأولمبياد
Dialogue: 10,0:28:22.95,0:28:26.62,Default,,0,0,0,,{\an8}...ورغم ذلك، من تسببوا في إصابتها
Dialogue: 10,0:28:26.75,0:28:30.00,Default,,0,0,0,,.الأول سُجن 3 سنوات والآخر حصل على حكم مع وقف تنفيذ
Dialogue: 10,0:28:32.00,0:28:35.00,Default,,0,0,0,,!كيف لي أرضى بحكم مخفف كهذا؟
Dialogue: 10,0:28:39.72,0:28:41.11,Default,,0,0,0,,...ماتت إثر حادث سقوط
Dialogue: 10,0:28:41.64,0:28:43.54,Default,,0,0,0,,.كلّا، وُجدت رسالة انتحار
Dialogue: 10,0:28:44.26,0:28:45.77,Default,,0,0,0,,أيعقل أنها انتحرت؟
Dialogue: 10,0:28:45.89,0:28:48.89,Default,,0,0,0,,!لم تنتحر! بل قُتلت
Dialogue: 10,0:28:49.19,0:28:51.00,Default,,0,0,0,,.أولئك الأوغاد قتلوا ماكي
Dialogue: 10,0:28:51.86,0:28:54.00,Default,,0,0,0,,.لهذا أتردد على هذا المكان
Dialogue: 10,0:28:55.07,0:28:59.00,Default,,0,0,0,,،كي أحصل على أيّ معلومة عن واشيزو وأعثر عليه
Dialogue: 10,0:28:59.61,0:29:02.45,Default,,0,0,0,,!وأذيقه من نفس الكأس
Dialogue: 10,0:29:02.57,0:29:04.28,Default,,0,0,0,,،قلت لك مرارًا
Dialogue: 10,0:29:04.41,0:29:07.48,Default,,0,0,0,,!حتى وإن توفرت معلومات فلن نخبرك بها
Dialogue: 10,0:29:09.04,0:29:10.58,Default,,0,0,0,,!سأعود مجددًا
Dialogue: 10,0:29:16.71,0:29:20.00,Default,,0,0,0,,".لا حرج في انتقام النبيل ولو بعد عشر سنين"
Dialogue: 10,0:29:20.76,0:29:25.51,Default,,0,0,0,,مقطع من كتاب تاريخ صيني يعني\N.أن الحقد لا يزول مهما مرت السنين
Dialogue: 10,0:29:27.06,0:29:28.93,Default,,0,0,0,,.مرّ وقت طويل يا موري-سان
Dialogue: 10,0:29:30.10,0:29:32.00,Default,,0,0,0,,.هذا المفتش موروفوشي
Dialogue: 10,0:29:33.81,0:29:36.68,Default,,0,0,0,,،بخصوص المفتش ساميتاني الذي قُتل في طوكيو
Dialogue: 10,0:29:37.11,0:29:41.00,Default,,0,0,0,,.تبين أنه زار ميكوريا في سجن ياماناشي
Dialogue: 10,0:29:43.82,0:29:46.99,Default,,0,0,0,,.وُجد جرح ناجم عن طلق ناري نافذ في صدر المفتش ساميتاني
Dialogue: 10,0:29:47.41,0:29:49.00,Default,,0,0,0,,.وعُثر على الرصاصة في موقع الجريمة
Dialogue: 10,0:29:49.71,0:29:52.00,Default,,0,0,0,,.إنها طلقة بندقية عيار 30
Dialogue: 10,0:29:52.37,0:29:53.57,Default,,0,0,0,,!بندقية؟
Dialogue: 10,0:29:54.79,0:29:58.09,Default,,0,0,0,,،أجل، تُصنف ضمن الذخائر ذات العيار الكبير
Dialogue: 10,0:29:58.21,0:30:00.09,Default,,0,0,0,,.وغالبًا ما تُستخدم في الصيد الجبلي
Dialogue: 10,0:30:00.22,0:30:02.21,Default,,0,0,0,,هل يوجد سجل سابق لطلقة البندقية؟
Dialogue: 10,0:30:02.62,0:30:03.59,Default,,0,0,0,,.كلا
Dialogue: 10,0:30:04.09,0:30:05.00,Default,,0,0,0,,.فهمت
Dialogue: 10,0:30:05.43,0:30:07.87,Default,,0,0,0,,التالي، ما تحركات الضحية؟
Dialogue: 10,0:30:08.39,0:30:11.99,Default,,0,0,0,,...زار المفتش ساميتاني السجين ميكوريا ساداكوني
Dialogue: 10,0:30:12.00,0:30:15.00,Default,,0,0,0,,.في سجن ياماناشي يوم السبت الماضي
Dialogue: 10,0:30:15.56,0:30:18.63,Default,,0,0,0,,...تحركاته بعدها مجهولة، ولكن صباح اليوم
Dialogue: 10,0:30:19.03,0:30:23.00,Default,,0,0,0,,.كان من المقرر التقاؤه بالضابط السابق موري كوغورو
Dialogue: 10,0:30:23.45,0:30:26.58,Default,,0,0,0,,.لكنه قُتل قبل اللقاء
Dialogue: 10,0:30:27.24,0:30:29.83,Default,,0,0,0,,ما سبب لقائهما؟
Dialogue: 10,0:30:29.95,0:30:33.66,Default,,0,0,0,,...السبب مجهول، ولكن حسب قول موري-سان
Dialogue: 10,0:30:33.96,0:30:38.96,Default,,0,0,0,,{\an8}.كان لديه ما يناقشه ويخص المفتش ياماتو من شرطة ناغانو
Dialogue: 10,0:30:39.42,0:30:45.26,Default,,0,0,0,,أيعني هذا إذن أن سبب مقتل المفتش\Nساميتاني له علاقة بالمفتش ياماتو؟
Dialogue: 10,0:30:45.39,0:30:47.00,Default,,0,0,0,,.أرى هذا احتمالًا واردًا
Dialogue: 10,0:30:47.64,0:30:48.76,Default,,0,0,0,,.فهمت
Dialogue: 10,0:30:48.89,0:30:51.78,Default,,0,0,0,,...بخصوص ذلك، سننتظر تقرير شرطة ناغانو
Dialogue: 10,0:30:51.81,0:30:53.53,Default,,0,0,0,,...أيها المسؤول كورودا
Dialogue: 10,0:30:54.13,0:30:58.57,Default,,0,0,0,,.لن يجلب لنا الانتظار فحسب تقريرًا ذا قيمة حسب رأيي
Dialogue: 10,0:30:59.02,0:31:02.82,Default,,0,0,0,,.سأذهب إلى شرطة ناغانو وأتولى القيادة ميدانيًا
Dialogue: 10,0:31:03.24,0:31:04.70,Default,,0,0,0,,.أيها المدعي العام هاسيبي
Dialogue: 10,0:31:04.82,0:31:09.11,Default,,0,0,0,,أنت المدعي العام الملحق بمقر التحقيق هذا\N.والموفد من النيابة العامة لمنطقة طوكيو
Dialogue: 10,0:31:09.53,0:31:10.95,Default,,0,0,0,,.عليك البقاء هنا
Dialogue: 10,0:31:11.08,0:31:15.46,Default,,0,0,0,,.لا يوجد قيد قانوني كهذا على المدعين الملحقين بمقر التحقيق
Dialogue: 10,0:31:16.17,0:31:17.37,Default,,0,0,0,,.أيها المسؤول
Dialogue: 10,0:31:17.80,0:31:21.02,Default,,0,0,0,,،حتى وإن كنت المسؤول عن مقر التحقيق هذا
Dialogue: 10,0:31:21.63,0:31:23.22,Default,,0,0,0,,...فلا تنسَ أنكم معشر الشرطة
Dialogue: 10,0:31:23.35,0:31:27.00,Default,,0,0,0,,.تعملون تحت إمرتنا نحن النيابة العامة
Dialogue: 10,0:31:28.14,0:31:29.51,Default,,0,0,0,,هل فهمت؟
Dialogue: 10,0:31:33.68,0:31:35.19,Default,,0,0,0,,.عذرًا على التأخير يا كونان-كن
Dialogue: 10,0:31:36.65,0:31:38.79,Default,,0,0,0,,.الجميع ينتظرون في الأمام
Dialogue: 10,0:31:42.50,0:31:43.33,Default,,0,0,0,,ماذا؟
Dialogue: 10,0:31:46.49,0:31:47.95,Default,,0,0,0,,!انفتح
Dialogue: 10,0:31:48.16,0:31:49.45,Default,,0,0,0,,!يشبه الزهرة
Dialogue: 10,0:31:50.73,0:31:53.08,Default,,0,0,0,,!كونان-كن! ران أونيه-سان
Dialogue: 10,0:31:53.20,0:31:54.46,Default,,0,0,0,,.وصلتما باكرًا
Dialogue: 10,0:31:55.29,0:31:57.29,Default,,0,0,0,,!أسعدني تمكنك من المجيء يا كونان-كن
Dialogue: 10,0:31:57.52,0:31:59.84,Default,,0,0,0,,أنتما كونان-كن وران-سان، أليس كذلك؟
Dialogue: 10,0:32:00.12,0:32:01.04,Default,,0,0,0,,.أنا أوتشي
Dialogue: 10,0:32:01.27,0:32:02.38,Default,,0,0,0,,.تشرفنا بمعرفتك
Dialogue: 10,0:32:02.50,0:32:05.30,Default,,0,0,0,,.نعتذر عن الانضمام المفاجئ
Dialogue: 10,0:32:05.42,0:32:06.55,Default,,0,0,0,,.لا تهتمي لذلك
Dialogue: 10,0:32:06.68,0:32:10.28,Default,,0,0,0,,.كنت أشرح عن سيارة الرصد المتنقلة هذه
Dialogue: 10,0:32:10.76,0:32:13.52,Default,,0,0,0,,أيمكنكم رصد الأجرام السماوية أثناء التنقل؟
Dialogue: 10,0:32:13.64,0:32:15.68,Default,,0,0,0,,...بل نستقبل الموجات من الفضاء
Dialogue: 10,0:32:15.81,0:32:18.74,Default,,0,0,0,,{\an8}.إذن، وصلنا إلى سجن ياماناشي
Dialogue: 10,0:32:18.75,0:32:19.69,Default,,0,0,0,,سجن؟
Dialogue: 10,0:32:21.05,0:32:23.00,Default,,0,0,0,,هل سمعت ما قاله يا كونان-كن؟
Dialogue: 10,0:32:23.99,0:32:25.07,Default,,0,0,0,,كونان-كن؟
Dialogue: 10,0:32:26.94,0:32:27.86,Default,,0,0,0,,.مذهل
Dialogue: 10,0:32:27.99,0:32:31.52,Default,,0,0,0,,.إذن، سأشرح لكم عن داخل سيارة الرصد
Dialogue: 10,0:32:31.83,0:32:32.91,Default,,0,0,0,,!حاضر
Dialogue: 10,0:32:33.03,0:32:36.47,Default,,0,0,0,,...انتهت إجراءات الزيارة، بوسعنا الآن مقابلة ميكوريا ساداكوني
Dialogue: 10,0:32:36.50,0:32:37.58,Default,,0,0,0,,...هذا الصوت
Dialogue: 10,0:32:38.35,0:32:40.42,Default,,0,0,0,,آسف، هل أنت بخير يا فتى؟
Dialogue: 10,0:32:40.99,0:32:42.21,Default,,0,0,0,,.إنه ذلك الرجل
Dialogue: 10,0:32:42.64,0:32:46.01,Default,,0,0,0,,.نسيت أن أعرفكم عليه، هذا يا-سان
Dialogue: 10,0:32:46.13,0:32:47.22,Default,,0,0,0,,يا-سان؟
Dialogue: 10,0:32:47.67,0:32:50.00,Default,,0,0,0,,!مهلًا، ما هذا التقديم؟
Dialogue: 10,0:32:50.68,0:32:52.85,Default,,0,0,0,,.إنه مساعد المفتش هاياشي من شرطة ياماناشي
Dialogue: 10,0:32:54.43,0:32:57.06,Default,,0,0,0,,{\an8}.أنا هاياشي من قسم الشؤون العامة في شرطة ياماناشي
Dialogue: 10,0:32:57.48,0:32:59.69,Default,,0,0,0,,.أنا ساتو من القسم الأول في شرطة العاصمة
Dialogue: 10,0:32:59.81,0:33:01.65,Default,,0,0,0,,.وأنا تاكاغي من نفس القسم
Dialogue: 10,0:33:01.77,0:33:04.36,Default,,0,0,0,,.سأعتمد عليك اليوم في قضية تمساح
Dialogue: 10,0:33:04.48,0:33:06.40,Default,,0,0,0,,إذن، أنت من شرطة العاصمة أيضًا؟
Dialogue: 10,0:33:06.53,0:33:09.20,Default,,0,0,0,,.كلّا، أنا المتحري موري
Dialogue: 10,0:33:09.32,0:33:12.07,Default,,0,0,0,,،موري-سان صديق للمفتش ساميتاني
Dialogue: 10,0:33:12.20,0:33:14.78,Default,,0,0,0,,.ويرافقنا للتعاون في التحقيق
Dialogue: 10,0:33:14.91,0:33:16.58,Default,,0,0,0,,.هكذا إذن
Dialogue: 10,0:33:16.95,0:33:20.33,Default,,0,0,0,,.مساعد المفتش هاياشي، تبدو مقربًا من المفتش ياماتو
Dialogue: 10,0:33:20.83,0:33:23.59,Default,,0,0,0,,.لطالما اعتنى بي في أثناء وجودي في المستشفى
Dialogue: 10,0:33:24.63,0:33:27.69,Default,,0,0,0,,اعتنى بي حتى استعدت وعيي\N.وبتّ قادرًا على المشي بالعكاز
Dialogue: 10,0:33:27.71,0:33:29.01,Default,,0,0,0,,.أدين له بالكثير
Dialogue: 10,0:33:29.34,0:33:30.08,Default,,0,0,0,,...لديّ تساؤل
Dialogue: 10,0:33:30.14,0:33:31.68,Default,,0,0,0,,،صحيح أنه فقد وعيه
Dialogue: 10,0:33:31.80,0:33:35.22,Default,,0,0,0,,ولكن ألم تدرك أن المفتش ياماتو ضابط شرطة؟
Dialogue: 10,0:33:35.35,0:33:38.81,Default,,0,0,0,,.لأن الانهيار جرف كل مقتنياتي
Dialogue: 10,0:33:38.93,0:33:41.44,Default,,0,0,0,,...وبسبب هذا الوجه
Dialogue: 10,0:33:41.56,0:33:45.40,Default,,0,0,0,,.طابقنا بصماته مع أصحاب السوابق والمطلوبين تحسبًا
Dialogue: 10,0:33:45.52,0:33:46.15,Default,,0,0,0,,!أنت
Dialogue: 10,0:33:46.27,0:33:50.15,Default,,0,0,0,,.لكن بهذا الوجه، لم نتوقع أبدًا أنه ضابط شرطة
Dialogue: 10,0:33:50.28,0:33:51.91,Default,,0,0,0,,!كفاك حديثًا عن وجهي
Dialogue: 10,0:33:57.91,0:34:01.16,Default,,0,0,0,,!تحريك هوائي ضخم كهذا مذهل
Dialogue: 10,0:34:01.29,0:34:04.92,Default,,0,0,0,,!يا أستاذ، أريد تحريكه أيضًا! دعني أجرب
Dialogue: 10,0:34:05.13,0:34:07.75,Default,,0,0,0,,.هـ-هذا غير ممكن
Dialogue: 10,0:34:08.58,0:34:11.17,Default,,0,0,0,,ولكن انظروا، هل تعرفون ما هذا؟
Dialogue: 10,0:34:12.76,0:34:15.40,Default,,0,0,0,,!ما هذا! أهو مدفع؟
Dialogue: 10,0:34:15.93,0:34:18.77,Default,,0,0,0,,.كلّا، إنه تلسكوب
Dialogue: 10,0:34:18.89,0:34:20.56,Default,,0,0,0,,.ولا أيًّا منهما
Dialogue: 10,0:34:20.97,0:34:26.06,Default,,0,0,0,,.في الواقع، سنطلق أشعة ليزر من هناك لنرسم نجمًا في السماء
Dialogue: 10,0:34:26.89,0:34:28.86,Default,,0,0,0,,!مذهل! أريد رؤيته
Dialogue: 10,0:34:28.98,0:34:30.49,Default,,0,0,0,,...حين يحلّ الليل
Dialogue: 10,0:34:30.61,0:34:33.57,Default,,0,0,0,,.قد أسمح لك بالمساعدة في ذلك
Dialogue: 10,0:34:34.60,0:34:35.45,Default,,0,0,0,,!مرحى
Dialogue: 10,0:34:35.57,0:34:37.48,Default,,0,0,0,,!هذا غير عادل! غينتا-كن وحده
Dialogue: 10,0:34:37.51,0:34:40.18,Default,,0,0,0,,!أريد ذلك أيضًا! أريد رسم نجمة
Dialogue: 10,0:34:40.20,0:34:43.08,Default,,0,0,0,,.هذه مشكلة، يستحيل السماح بذلك لعدّة أشخص
Dialogue: 10,0:34:43.33,0:34:46.08,Default,,0,0,0,,.حسن، لنقرر عبر مسابقة ألغار
Dialogue: 10,0:34:47.04,0:34:50.46,Default,,0,0,0,,،من بين الكواكب الكثيرة في الفضاء
Dialogue: 10,0:34:50.59,0:34:54.38,Default,,0,0,0,,أين يوجد المجرم الذي تبحث عنه الشرطة؟
Dialogue: 10,0:34:50.59,0:34:54.38,Note,,0,0,0,,.لها عدة معاني منها: نجم، كوكب، مجرم (星) "كلمة "هوشي
Dialogue: 10,0:34:50.59,0:34:54.38,Default,,0,0,0,,{\pos(1116,981)}(星)
Dialogue: 10,0:34:54.51,0:34:56.89,Default,,0,0,0,,:أيّ واحد من بين الخيارات التالية
Dialogue: 10,0:34:57.18,0:34:59.43,Default,,0,0,0,,.الشمس
Dialogue: 10,0:34:57.18,0:34:59.43,Default,,0,0,0,,{\pos(974,977)}(太陽)
Dialogue: 10,0:34:57.18,0:34:59.43,Default,,0,0,0,,{\pos(1078,1056)}-1
Dialogue: 10,0:35:00.27,0:35:02.60,Default,,0,0,0,,.الزهرة
Dialogue: 10,0:35:00.27,0:35:02.60,Default,,0,0,0,,{\pos(974,977)}(金星)
Dialogue: 10,0:35:00.27,0:35:02.60,Default,,0,0,0,,{\pos(1058,1053)}-2
Dialogue: 10,0:35:03.18,0:35:05.35,Default,,0,0,0,,.الأرض
Dialogue: 10,0:35:03.18,0:35:05.35,Default,,0,0,0,,{\pos(974,977)}(地球)
Dialogue: 10,0:35:03.18,0:35:05.35,Default,,0,0,0,,{\pos(1070,1053)}-3
Dialogue: 10,0:35:06.31,0:35:08.19,Default,,0,0,0,,.القمر
Dialogue: 10,0:35:06.31,0:35:08.19,Default,,0,0,0,,{\pos(974,977)}(月)
Dialogue: 10,0:35:06.31,0:35:08.19,Default,,0,0,0,,{\pos(1048,1055)}-4
Dialogue: 10,0:35:09.02,0:35:11.00,Default,,0,0,0,,{\an8}والآن، أيها يا ترى؟
Dialogue: 10,0:35:11.44,0:35:14.00,Default,,0,0,0,,.عجبًا، غريب أنك لم تعرف
Dialogue: 10,0:35:14.57,0:35:16.20,Default,,0,0,0,,.بروفيسور، هات تلميحًا
Dialogue: 10,0:35:16.32,0:35:18.37,Default,,0,0,0,,!لا بدّ أنه تلاعب آخر بالألفاظ
Dialogue: 10,0:35:18.49,0:35:20.45,Default,,0,0,0,,.ليس تلاعبًا بالألفاظ، بل مصطلح شرطي
Dialogue: 10,0:35:20.83,0:35:22.70,Default,,0,0,0,,مصطلح شرطي؟
Dialogue: 10,0:35:22.83,0:35:25.83,Default,,0,0,0,,ما دامت الشرطة تطلق لقب النجم\Nعلى المجرم، فهل هو كوكب الزهرة؟
Dialogue: 10,0:35:27.54,0:35:29.21,Default,,0,0,0,,.إجابة صحيحة يا آي-كن
Dialogue: 10,0:35:27.54,0:35:29.21,Note,,0,0,0,,.وهذا هو الحل ،(星) على كانجي (金星) يحوي كوكب الزهرة
Dialogue: 10,0:35:30.42,0:35:31.46,Default,,0,0,0,,.بئسًا
Dialogue: 10,0:35:31.59,0:35:32.66,Default,,0,0,0,,.خفّي علينا
Dialogue: 10,0:35:33.09,0:35:35.03,Default,,0,0,0,,.إذن، لنذهب إلى مبنى الليزر
Dialogue: 10,0:35:35.55,0:35:36.97,Default,,0,0,0,,.حاضر
Dialogue: 10,0:35:37.09,0:35:39.10,Default,,0,0,0,,.كان المفروض أن أفعلها أنا
Dialogue: 10,0:35:39.22,0:35:40.78,Default,,0,0,0,,!لا بأس، سأدعك تفعلها
Dialogue: 10,0:35:40.82,0:35:41.38,Default,,0,0,0,,!حقًا؟
Dialogue: 10,0:35:41.41,0:35:44.52,Default,,0,0,0,,!لا يجوز! قررنا بمسابقة ألغاز البروفيسور
Dialogue: 10,0:35:45.64,0:35:48.24,Default,,0,0,0,,.مهلًا، الهواتف ممنوعة هنا
Dialogue: 10,0:35:48.86,0:35:49.73,Default,,0,0,0,,.أعتذر
Dialogue: 10,0:35:54.11,0:35:55.99,Default,,0,0,0,,هل يمكنك إرسال رسالة نصية؟
Dialogue: 10,0:35:56.11,0:35:59.49,Default,,0,0,0,,أيوجد أحد بجوارك لا تريد منه سماعك؟
Dialogue: 10,0:35:59.95,0:36:01.24,Default,,0,0,0,,...هذا صحيح، ولكن
Dialogue: 10,0:35:59.95,0:36:01.24,Default,,0,0,0,,(...يوجد هذا الشيء، ولكن)
Dialogue: 10,0:36:01.37,0:36:02.75,Default,,0,0,0,,هذا صحيح؟
Dialogue: 10,0:36:01.37,0:36:02.75,Default,,0,0,0,,(يوجد هذا الشيء؟)
Dialogue: 10,0:36:02.99,0:36:06.00,Default,,0,0,0,,أيعقل أن أحدًا يتنصت عليك؟
Dialogue: 10,0:36:02.99,0:36:06.00,Note,,0,0,0,,سأله أمورو عن وجود شخص حوله، ولكن كونان ردّ عليه بالإيجاب بصياغة\N.تلمح إلى وجود جماد، لذا استنتج أمورو احتمالية وجود جهاز تنصت
Dialogue: 10,0:36:06.83,0:36:10.00,Default,,0,0,0,,فاجأني هذا! هل الاتصال بهذا الهاتف آمن؟
Dialogue: 10,0:36:10.42,0:36:11.25,Default,,0,0,0,,.آمن
Dialogue: 10,0:36:11.38,0:36:13.38,Default,,0,0,0,,.إذن، اصمت واستمع
Dialogue: 10,0:36:14.63,0:36:18.22,Default,,0,0,0,,،في يوم حادثة السطو على متجر الأسلحة قبل 8 سنوات
Dialogue: 10,0:36:18.94,0:36:23.00,Default,,0,0,0,,.قُبض على أحد اللصين في نفس اليوم
Dialogue: 10,0:36:23.81,0:36:24.97,Default,,0,0,0,,{\an8}...لكن الآخر
Dialogue: 10,0:36:25.10,0:36:27.52,Default,,0,0,0,,{\an8}.هرب ومعه البنادق والذخيرة المسروقة
Dialogue: 10,0:36:28.35,0:36:34.42,Default,,0,0,0,,{\an8}أراد الادعاء حلّ القضية بسرعة، فعقد مساومة\N.قضائية مع واشيزو تاكاشي الذي قُبض عليه أولًا
Dialogue: 10,0:36:35.36,0:36:38.53,Default,,0,0,0,,{\an8}،مقابل تخفيف العقوبة
Dialogue: 10,0:36:38.56,0:36:44.04,Default,,0,0,0,,{\an8}.أدلى واشيزو باسم شريكه ميكوريا وأوصافه ومكان اختبائه
Dialogue: 10,0:36:44.16,0:36:47.00,Default,,0,0,0,,.وبفضل ذلك قُبض على ميكوريا في اليوم التالي
Dialogue: 10,0:36:47.37,0:36:50.63,Default,,0,0,0,,هذا كل شيء، هل أجبت على استفسارك يا ترى؟
Dialogue: 10,0:36:50.96,0:36:53.04,Default,,0,0,0,,.أجل، شكرًا لك يا أمورو-سان
Dialogue: 10,0:37:03.43,0:37:05.18,Default,,0,0,0,,...فورويا-سان، في الواقع
Dialogue: 10,0:37:05.31,0:37:06.98,Default,,0,0,0,,...كازامي، أنت
Dialogue: 10,0:37:07.23,0:37:09.79,Default,,0,0,0,,وضعت جهاز تنصت على إيدوغاوا كونان، أليس كذلك؟
Dialogue: 10,0:37:11.02,0:37:12.19,Default,,0,0,0,,!كيف عرفت؟
Dialogue: 10,0:37:12.31,0:37:17.30,Default,,0,0,0,,.أنا من أمرك بالتحقيق في مقتل المفتش ساميتاني
Dialogue: 10,0:37:17.90,0:37:24.38,Default,,0,0,0,,وقد استفسر كونان-كن عن قضية شرطة ناغانو\N.التي كان يحقق فيها المفتش ساميتاني
Dialogue: 10,0:37:24.78,0:37:27.78,Default,,0,0,0,,.علاوة على ذلك، يتنصت عليه أحدهم
Dialogue: 10,0:37:28.33,0:37:30.58,Default,,0,0,0,,،وفور إنهاء المكالمة معه
Dialogue: 10,0:37:30.71,0:37:34.09,Default,,0,0,0,,.تلقيت اتصالًا منك وكأن لديك ما تقوله
Dialogue: 10,0:37:35.00,0:37:40.63,Default,,0,0,0,,طلبت من ضابط الأمن العام المتخفي في شرطة\N.ياماناشي وضع جهاز تنصت على الفتى
Dialogue: 10,0:37:40.97,0:37:42.55,Default,,0,0,0,,...الأمن العام المتخفي
Dialogue: 10,0:37:42.68,0:37:46.00,Default,,0,0,0,,.عناصر الأمن العام المندسون في أقسام الشرطة الأخرى
Dialogue: 10,0:37:46.31,0:37:48.39,Default,,0,0,0,,لمَ وضعت جهاز تنصت عليه؟
Dialogue: 10,0:37:48.52,0:37:52.06,Default,,0,0,0,,.كان المفتش ساميتاني يحقق في قضية في شرطة ناغانو
Dialogue: 10,0:37:52.19,0:37:56.53,Default,,0,0,0,,.وذلك الفتى توجه إلى ناغانو أيضًا، لذا فكرت في الاستعانة به
Dialogue: 10,0:37:56.86,0:37:59.78,Default,,0,0,0,,.كما فعلت أنت سابقًا يا فورويا-سان
Dialogue: 10,0:38:03.91,0:38:07.45,Default,,0,0,0,,الهواتف ممنوعة، هل الأمر عاجل؟
Dialogue: 10,0:38:13.29,0:38:14.88,Default,,0,0,0,,هل لهذا علاقة بما تريد؟
Dialogue: 10,0:38:15.21,0:38:18.18,Default,,0,0,0,,.أجل، وضعه الأمن العام
Dialogue: 10,0:38:19.51,0:38:21.32,Default,,0,0,0,,مهلًا! ألن تنزعه؟
Dialogue: 10,0:38:21.84,0:38:23.46,Default,,0,0,0,,...كلّا، لأن
Dialogue: 10,0:38:24.39,0:38:28.26,Default,,0,0,0,,.بوجوده يمكنني مشاركة المعلومات مع أمورو-سان
Dialogue: 10,0:38:28.39,0:38:29.82,Default,,0,0,0,,لأن ماذا؟
Dialogue: 10,0:38:30.14,0:38:33.23,Default,,0,0,0,,...لأن وجود محقق من الأمن العام في نطاق استقبال الجهاز
Dialogue: 10,0:38:33.35,0:38:37.02,Default,,0,0,0,,.أمر يبعث على الاطمئنان
Dialogue: 10,0:38:37.98,0:38:39.53,Default,,0,0,0,,أليس كذلك يا كازامي-سان؟
Dialogue: 10,0:38:41.99,0:38:43.63,Default,,0,0,0,,!يا له من فتى
Dialogue: 10,0:38:56.84,0:38:57.59,Default,,0,0,0,,ما الأمر؟
Dialogue: 10,0:38:57.79,0:38:59.88,Default,,0,0,0,,!مفتش ياماتو، هل أتتك تلك النوبة مجددًا؟
Dialogue: 10,0:39:00.26,0:39:01.26,Default,,0,0,0,,نوبة؟
Dialogue: 10,0:39:01.38,0:39:03.26,Default,,0,0,0,,.عذرًا، سأستأذن قليلًا
Dialogue: 10,0:39:03.97,0:39:06.26,Default,,0,0,0,,.لا بأس، ارتح قليلًا هناك
Dialogue: 10,0:39:09.10,0:39:12.27,Default,,0,0,0,,...أيها السادة... وقت الزيارة محدود
Dialogue: 10,0:39:12.60,0:39:14.89,Default,,0,0,0,,.أجل، لنبدأ الاستجواب
Dialogue: 10,0:39:15.02,0:39:16.00,Default,,0,0,0,,.معكِ حق
Dialogue: 10,0:39:16.40,0:39:19.98,Default,,0,0,0,,ميكوريا-سان، زارك هذا الرجل السبت الماضي، أليس كذلك؟
Dialogue: 10,0:39:20.23,0:39:21.86,Default,,0,0,0,,.أجل، من شرطة العاصمة
Dialogue: 10,0:39:21.99,0:39:23.45,Default,,0,0,0,,!ماذا سألك تمساح؟
Dialogue: 10,0:39:23.49,0:39:24.45,Default,,0,0,0,,تمساح؟
Dialogue: 10,0:39:24.77,0:39:26.00,Default,,0,0,0,,!أجب فحسب
Dialogue: 10,0:39:26.99,0:39:29.17,Default,,0,0,0,,.سألني عن وقت الانهيار الثلجي
Dialogue: 10,0:39:29.49,0:39:31.91,Default,,0,0,0,,.سألني إن رأيت أحدًا حينها أم لا
Dialogue: 10,0:39:32.04,0:39:33.43,Default,,0,0,0,,!من يقصد بـ"أحد"؟
Dialogue: 10,0:39:33.44,0:39:34.58,Default,,0,0,0,,!لا أعرف
Dialogue: 10,0:39:34.71,0:39:37.70,Default,,0,0,0,,كنت مطاردًا من المحقق الذي خرج للتو\N.وما كان وضعي يسمح لي بالتركيز
Dialogue: 10,0:39:37.77,0:39:39.77,Default,,0,0,0,,.هذا ما أجبته. هذا كل شيء
Dialogue: 10,0:39:46.93,0:39:50.64,Default,,0,0,0,,،يضيء الليزر طبقة الصوديوم في السماء
Dialogue: 10,0:39:46.93,0:39:50.64,Note,,0,0,0,,طبقة الصوديوم هي طبقة من ذرات الصوديوم في الغلاف الجوي بين ارتفاعي 80 و105 كيلومترات\Nوتتكوّن نتيجة لتحلل النيازك. تظهر هذه الطبقة باللون الأصفر المميز عندما تُثار بأشعة الشمس\N.أو الرياح الشمسية، وتفيد علماء الفلك في استخدام تقنية النجم الاصطناعي لتصحيح تشوه الصور في التلسكوبات
Dialogue: 10,0:39:50.76,0:39:52.81,Default,,0,0,0,,.فيتكوّن نجم دليل ليزري
Dialogue: 10,0:39:53.43,0:39:56.06,Default,,0,0,0,,.وهكذا نصنع نجمًا اصطناعيًا
Dialogue: 10,0:39:59.44,0:40:00.46,Default,,0,0,0,,!جميل
Dialogue: 10,0:40:01.52,0:40:02.40,Default,,0,0,0,,!أحسنتِ
Dialogue: 10,0:40:02.62,0:40:03.40,Default,,0,0,0,,.هكذا
Dialogue: 10,0:40:03.53,0:40:07.32,Default,,0,0,0,,بتوجيه نوعين من الليزر في نفس المسار\N...نحو طبقة الصوديوم في السماء
Dialogue: 10,0:40:07.86,0:40:11.12,Default,,0,0,0,,.هذه نظرية البصريات غير الخطية غالبًا
Dialogue: 10,0:40:11.24,0:40:15.50,Default,,0,0,0,,...في هذه الحالة، لو وجهنا الليزر هنا
Dialogue: 10,0:40:16.00,0:40:17.80,Default,,0,0,0,,!ازدادوا شعاعًا
Dialogue: 10,0:40:17.80,0:40:18.50,Default,,0,0,0,,!مذهل
Dialogue: 10,0:40:19.08,0:40:22.73,Default,,0,0,0,,...حتى نحن الخبراء لا ننجح من المرة الأولى
Dialogue: 10,0:40:23.25,0:40:26.67,Default,,0,0,0,,.قد تصبحين عالمة بارزة
Dialogue: 10,0:40:27.26,0:40:30.22,Default,,0,0,0,,!عالمة! هذا رائع يا آي-تشان
Dialogue: 10,0:40:30.35,0:40:31.23,Default,,0,0,0,,أحقًّا؟
Dialogue: 10,0:40:31.45,0:40:32.43,Default,,0,0,0,,.هذا يسعدني
Dialogue: 10,0:40:32.85,0:40:35.06,Default,,0,0,0,,.لكنها عالمة سلفًا
Dialogue: 10,0:40:36.89,0:40:39.02,Default,,0,0,0,,،بدد ثروته عن آخرها
Dialogue: 10,0:40:39.15,0:40:43.73,Default,,0,0,0,,،كي يكافئ كل من أعانه وقت الشدة
Dialogue: 10,0:40:44.28,0:40:46.55,Default,,0,0,0,,،فيردّ إحسان من أطعمه ولو وجبة
Dialogue: 10,0:40:46.78,0:40:49.22,Default,,0,0,0,,.ويقتصّ ممن أساء إليه ولو بنظرة حقد عابرة
Dialogue: 10,0:40:50.24,0:40:52.20,Default,,0,0,0,,هل هذا مثل آخر؟
Dialogue: 10,0:40:52.49,0:40:54.73,Default,,0,0,0,,،أجل، من الأدب الصيني القديم
Dialogue: 10,0:40:54.75,0:40:59.12,Default,,0,0,0,,يعني "التضحية بالمال والحياة لردّ\N".الإحسان والانتقام لأيام الشدة
Dialogue: 10,0:40:59.67,0:41:03.96,Default,,0,0,0,,"،ردّ الإحسان ولو كان وجبة طعام واحدة"
Dialogue: 10,0:41:04.09,0:41:07.48,Default,,0,0,0,,".والانتقام ولو لنظرة حقد عابرة"
Dialogue: 10,0:41:08.38,0:41:12.26,Default,,0,0,0,,حُكم عليك بالسجن 3 سنوات بينما حصل\N.واشيزو تاكاشي على حكم مع وقف التنفيذ
Dialogue: 10,0:41:12.39,0:41:14.00,Default,,0,0,0,,هل شعرت بالظلم؟
Dialogue: 10,0:41:15.43,0:41:18.81,Default,,0,0,0,,،اختفيت أثناء إفراجك المشروط قبل 6 سنوات
Dialogue: 10,0:41:18.94,0:41:21.15,Default,,0,0,0,,.وعثر عليك المفتش ياماتو قبل 10 أشهر
Dialogue: 10,0:41:22.40,0:41:25.04,Default,,0,0,0,,.حين قبضت عليك، كنت تطلق النار ببندقية
Dialogue: 10,0:41:25.57,0:41:28.54,Default,,0,0,0,,.بدا لي وكأنك تتدرب
Dialogue: 10,0:41:28.99,0:41:33.35,Default,,0,0,0,,.هكذا إذن، عقد واشيزو مساومة قضائية وخفف عقوبته
Dialogue: 10,0:41:33.62,0:41:37.50,Default,,0,0,0,,...فحقدت عليه وعدت إلى ناغانو بعد الإفراج المشروط
Dialogue: 10,0:41:37.62,0:41:40.33,Default,,0,0,0,,...هكذا إذن، لأن مسقط رأس واشيزو في ناغانو أيضًا
Dialogue: 10,0:41:40.46,0:41:42.58,Default,,0,0,0,,!كنت تنوي قتل واشيزو
Dialogue: 10,0:41:42.71,0:41:45.35,Default,,0,0,0,,،لكن عثر عليك المفتش ياماتو قبل ذلك
Dialogue: 10,0:41:45.38,0:41:47.00,Default,,0,0,0,,.فصرت مُطاردًا
Dialogue: 10,0:41:47.38,0:41:48.44,Default,,0,0,0,,أليس كذلك؟
Dialogue: 10,0:41:49.47,0:41:50.68,Default,,0,0,0,,!ما هذا الهراء؟
Dialogue: 10,0:41:50.80,0:41:53.80,Default,,0,0,0,,...قبلت مقابلتكم لأنكم طلبتم التعاون في التحقيق
Dialogue: 10,0:41:53.93,0:41:55.67,Default,,0,0,0,,!إلّا أنكم تثرثرون بأمور لا علاقة لها
Dialogue: 10,0:41:55.72,0:41:56.72,Default,,0,0,0,,!ميكوريا
Dialogue: 10,0:41:56.85,0:41:58.85,Default,,0,0,0,,!أكفّر عن ذنبي الآن
Dialogue: 10,0:41:59.14,0:42:00.77,Default,,0,0,0,,!على عكس واشيزو الذي باعني
Dialogue: 10,0:42:00.80,0:42:01.73,Default,,0,0,0,,!انتهت الزيارة
Dialogue: 10,0:42:02.05,0:42:03.27,Default,,0,0,0,,!عد إلى زنزانتك
Dialogue: 10,0:42:03.40,0:42:07.26,Default,,0,0,0,,!أردت قتله! أنت ذكي، إجابة صحيحة
Dialogue: 10,0:42:07.27,0:42:08.02,Default,,0,0,0,,!اصمت
Dialogue: 10,0:42:08.03,0:42:09.19,Default,,0,0,0,,...سأقتله
Dialogue: 10,0:42:09.32,0:42:12.06,Default,,0,0,0,,!سأقتله حتمًا
Dialogue: 10,0:42:15.94,0:42:19.00,Default,,0,0,0,,.يقع موقع التخييم المتوجهين إليه في جبل ميتاكاراداكي
Dialogue: 10,0:42:19.12,0:42:23.37,Default,,0,0,0,,.جبل ميتاكاراداكي... حيث تعرّض المفتش ياماتو للانهيار
Dialogue: 10,0:42:23.50,0:42:24.70,Default,,0,0,0,,...هذا يعني
Dialogue: 10,0:42:25.13,0:42:28.00,Default,,0,0,0,,.كما توقعت، سنمر قرب سجن ياماناشي
Dialogue: 10,0:42:28.59,0:42:30.76,Default,,0,0,0,,.ران نيه-تشان، أرجوكِ ساعديني
Dialogue: 10,0:42:31.88,0:42:34.55,Default,,0,0,0,,!أستاذ أوتشي! أريد الذهاب إلى الحمام
Dialogue: 10,0:42:35.88,0:42:37.10,Default,,0,0,0,,!هذه مشكلة
Dialogue: 10,0:42:37.22,0:42:38.88,Default,,0,0,0,,!تبقى حوالي نصف ساعة حتى نصل
Dialogue: 10,0:42:38.92,0:42:40.48,Default,,0,0,0,,يسعك التحمّل، أليس كذلك؟
Dialogue: 10,0:42:41.40,0:42:42.85,Default,,0,0,0,,!سيتسرب
Dialogue: 10,0:42:42.98,0:42:45.73,Default,,0,0,0,,...أشعر به يصعد وينزل
Dialogue: 10,0:42:45.86,0:42:47.04,Default,,0,0,0,,.مثل الجبل
Dialogue: 10,0:42:47.57,0:42:51.86,Default,,0,0,0,,،المعذرة، سنمر أمام سجن ياماناشي قريبًا
Dialogue: 10,0:42:51.99,0:42:54.74,Default,,0,0,0,,.ويوجد متجر قريب للوازم السجناء
Dialogue: 10,0:42:54.86,0:42:57.62,Default,,0,0,0,,.قد يسمحون لنا باستخدام الحمام هناك
Dialogue: 10,0:42:57.99,0:42:59.17,Default,,0,0,0,,.صحيح
Dialogue: 10,0:42:59.49,0:43:02.75,Default,,0,0,0,,.إذن، لنتوقف مؤقتًا أمام سجن ياماناشي
Dialogue: 10,0:43:02.87,0:43:04.32,Default,,0,0,0,,.شكرًا جزيلًا لك
Dialogue: 10,0:43:04.50,0:43:06.79,Default,,0,0,0,,!ران نيه-سان مذهلة
Dialogue: 10,0:43:06.92,0:43:08.96,Default,,0,0,0,,كيف تعرفين كل هذه التفاصيل؟
Dialogue: 10,0:43:09.09,0:43:11.17,Default,,0,0,0,,هل دخلتِ السجن من قبل؟
Dialogue: 10,0:43:11.51,0:43:13.01,Default,,0,0,0,,...اسمعوا
Dialogue: 10,0:43:13.72,0:43:16.00,Default,,0,0,0,,ولكن كيف عرفت أمرًا كهذا؟
Dialogue: 10,0:43:16.55,0:43:18.63,Default,,0,0,0,,.معلومات من شينتشي ني-تشان
Dialogue: 10,0:43:22.09,0:43:23.52,Default,,0,0,0,,هل أنت بخير الآن؟
Dialogue: 10,0:43:23.64,0:43:25.49,Default,,0,0,0,,.أعتذر عن الإزعاج
Dialogue: 10,0:43:30.79,0:43:32.64,Default,,0,0,0,,!إنه عمي! يا للصدفة
Dialogue: 10,0:43:33.32,0:43:34.90,Default,,0,0,0,,أنت، لماذا؟
Dialogue: 10,0:43:35.03,0:43:37.62,Default,,0,0,0,,.أنا في جولة رصد مع الجميع في هذه الأثناء
Dialogue: 10,0:43:37.74,0:43:40.08,Default,,0,0,0,,...سنذهب للتخييم في الجبل الآن
Dialogue: 10,0:43:42.08,0:43:43.75,Default,,0,0,0,,.لا فائدة يا كونان-كن
Dialogue: 10,0:43:43.75,0:43:44.75,Default,,0,0,0,,.المتجر مغلق
Dialogue: 10,0:43:44.87,0:43:47.96,Default,,0,0,0,,.ولا أرى مكانًا آخر
Dialogue: 10,0:43:48.08,0:43:50.84,Default,,0,0,0,,.لا بأس، لم أعد بحاجة إلى التبول
Dialogue: 10,0:43:54.21,0:43:56.22,Default,,0,0,0,,.إذن، لنعد إلى السيارة
Dialogue: 10,0:43:56.34,0:43:57.57,Default,,0,0,0,,.لنستعجل الذهاب إلى المخيم
Dialogue: 10,0:43:57.59,0:44:00.64,Default,,0,0,0,,.كلّا، لا تدري متى قد تحتاج الدخول إلى الحمام مجددًا
Dialogue: 10,0:44:00.76,0:44:03.43,Default,,0,0,0,,.تعال معنا إلى شرطة المحافظة أيها الشقي
Dialogue: 10,0:44:03.56,0:44:05.23,Default,,0,0,0,,.أوافقك الرأي
Dialogue: 10,0:44:06.81,0:44:09.00,Default,,0,0,0,,!أجل! سأفعل ذلك
Dialogue: 10,0:44:09.65,0:44:12.69,Default,,0,0,0,,.إذن، سأعود إلى شرطة محافظة ياماناشي
Dialogue: 10,0:44:13.42,0:44:14.60,Default,,0,0,0,,.شكرًا لك على المساعدة
Dialogue: 10,0:44:14.92,0:44:16.00,Default,,0,0,0,,.بوركت جهودك
Dialogue: 10,0:44:17.66,0:44:18.77,Default,,0,0,0,,!مهلًا
Dialogue: 10,0:44:19.66,0:44:21.84,Default,,0,0,0,,أنت من الأمن العام، أليس كذلك؟
Dialogue: 10,0:44:22.87,0:44:25.29,Default,,0,0,0,,.لا تقلق، لن أخبر أحدًا
Dialogue: 10,0:44:25.41,0:44:26.52,Default,,0,0,0,,!وداعًا
Dialogue: 10,0:44:26.99,0:44:28.50,Default,,0,0,0,,.صحيح صحيح
Dialogue: 10,0:44:28.62,0:44:30.57,Default,,0,0,0,,.سأبقي هذا كما هو
Dialogue: 10,0:44:31.04,0:44:33.00,Default,,0,0,0,,!يمكنك الاستماع في أيّ وقت
Dialogue: 10,0:44:33.80,0:44:35.00,Default,,0,0,0,,!وداعًا
Dialogue: 10,0:44:36.51,0:44:38.68,Default,,0,0,0,,من يكون هذا الفتى؟
Dialogue: 10,0:44:40.55,0:44:45.93,Default,,0,0,0,,سأل المفتش ساميتاني ميكوريا\N.إن رأى أحدًا قبل الانهيار أم لا
Dialogue: 10,0:44:46.06,0:44:49.19,Default,,0,0,0,,.ربما كان ينوي سؤال المفتش ياماتو عن الأمر ذاته
Dialogue: 10,0:44:49.40,0:44:51.00,Default,,0,0,0,,.لكنني لم أقابله
Dialogue: 10,0:44:51.36,0:44:55.69,Default,,0,0,0,,.بمعنى آخر، تعذر اللقاء فجأة أو لم تعد هناك حاجة إلى ذلك
Dialogue: 10,0:44:56.15,0:44:57.67,Default,,0,0,0,,،لكن في اليوم التالي
Dialogue: 10,0:44:57.70,0:45:00.20,Default,,0,0,0,,.كان المفروض أن يقابل العم كوغورو
Dialogue: 10,0:45:00.78,0:45:03.70,Default,,0,0,0,,.لكنه قُنص ببندقية قبل ذلك
Dialogue: 10,0:45:03.83,0:45:05.04,Default,,0,0,0,,!بندقية؟
Dialogue: 10,0:45:05.16,0:45:08.00,Default,,0,0,0,,.أجل، رصاصة بندقية عيار 30
Dialogue: 10,0:45:08.62,0:45:10.04,Default,,0,0,0,,،لكن في ذلك الوقت
Dialogue: 10,0:45:10.17,0:45:12.50,Default,,0,0,0,,.لم يكن يحمل بندقية
Dialogue: 10,0:45:13.17,0:45:16.42,Default,,0,0,0,,.يبدو أن صورة المجرم بدأت تتضح قليلًا
Dialogue: 10,0:45:17.30,0:45:20.64,Default,,0,0,0,,...أجل، المجرم الذي قتل المفتش ساميتاني
Dialogue: 10,0:45:20.76,0:45:23.23,Default,,0,0,0,,.كان موجودًا في موقع الانهيار الثلجي
Dialogue: 10,0:45:23.55,0:45:26.68,Default,,0,0,0,,.وفعل شيئًا سيوقعه المتاعب إن رآه أحد
Dialogue: 10,0:45:26.99,0:45:28.07,Default,,0,0,0,,...إن كان الأمر كذلك
Dialogue: 10,0:45:28.39,0:45:31.60,Default,,0,0,0,,.فالمجرم موجود في ذاكرتي المفقودة
Dialogue: 10,0:45:31.73,0:45:34.19,Default,,0,0,0,,.هذا الاحتمال وارد
Dialogue: 10,0:45:37.32,0:45:38.41,Default,,0,0,0,,.هذا سيئ
Dialogue: 10,0:45:44.03,0:45:46.12,Default,,0,0,0,,.أنا هاسيبي من النيابة العامة في طوكيو
Dialogue: 10,0:45:47.79,0:45:49.51,Default,,0,0,0,,.سمعت عنك من المسؤول كورودا
Dialogue: 10,0:45:49.83,0:45:53.00,Default,,0,0,0,,.إنه المدعي العام الملحق بمقر التحقيق في هذه القضية
Dialogue: 10,0:45:53.42,0:45:57.30,Default,,0,0,0,,هل يأتي مدعٍ عام من هذا النوع إلى مكان كهذا عادةً؟
Dialogue: 10,0:45:57.76,0:46:00.68,Default,,0,0,0,,...نأتي عند الضرورة
Dialogue: 10,0:46:01.34,0:46:07.00,Default,,0,0,0,,.يا موري كوغورو-سان؛ المحقق السابق في القسم الأول
Dialogue: 10,0:46:15.56,0:46:16.69,Default,,0,0,0,,.أمورو-سان
Dialogue: 10,0:46:17.15,0:46:21.75,Default,,0,0,0,,لمَ بدأ المفتش ساميتاني التحقيق\Nفي حادثة الانهيار قبل 10 أشهر؟
Dialogue: 10,0:46:22.07,0:46:25.00,Default,,0,0,0,,ولمَ كان يبحث عمن تواجد في الموقع؟
Dialogue: 10,0:46:26.03,0:46:27.45,Default,,0,0,0,,.أخبرني يا أمورو-سان
Dialogue: 10,0:46:27.98,0:46:31.06,Default,,0,0,0,,ما طبيعة قسم الإعداد للإصلاح\Nالذي عمل فيه المفتش ساميتاني؟
Dialogue: 10,0:46:33.96,0:46:36.54,Default,,0,0,0,,.إن كنت لا تريد إخباري فسأسأل كازامي-سان
Dialogue: 10,0:46:37.13,0:46:41.00,Default,,0,0,0,,أم أسأل هاياشي-سان من الأمن العام المتخفي؟
Dialogue: 10,0:46:43.68,0:46:45.59,Default,,0,0,0,,!إنك فتى مزعج كالمعتاد
Dialogue: 10,0:46:46.35,0:46:48.66,Default,,0,0,0,,تحدثنا عن نظام المساومة القضائية، أليس كذلك؟
Dialogue: 10,0:46:48.90,0:46:51.06,Default,,0,0,0,,.إنه على وشك التغيّر الآن
Dialogue: 10,0:46:51.18,0:46:54.08,Default,,0,0,0,,،أجل، يوجد مشروع تعديل في البرلمان
Dialogue: 10,0:46:54.10,0:46:55.56,Default,,0,0,0,,.لكن المداولات متوقفة
Dialogue: 10,0:46:55.60,0:46:56.36,Default,,0,0,0,,ماذا في ذلك؟
Dialogue: 10,0:46:58.27,0:46:59.90,Default,,0,0,0,,.نلت مني
Dialogue: 10,0:47:00.03,0:47:03.86,Default,,0,0,0,,إنه قسم يجهز تدابير مختلفة\N.للتعامل مع ذلك التعديل المقترح
Dialogue: 10,0:47:04.28,0:47:06.62,Default,,0,0,0,,هل أجبت على تساؤلاتك؟
Dialogue: 10,0:47:06.74,0:47:08.37,Default,,0,0,0,,.شكرًا، سأتصل بك لاحقًا
Dialogue: 10,0:47:13.75,0:47:17.42,Default,,0,0,0,,باختصار، كان ساميتاني-سان\N،يستعد للنظام القضائي الجديد
Dialogue: 10,0:47:17.54,0:47:20.89,Default,,0,0,0,,ويبحث عن أحد في موقع الانهيار؟
Dialogue: 10,0:47:22.00,0:47:24.23,Default,,0,0,0,,،وإن قُتل بسبب ذلك
Dialogue: 10,0:47:24.56,0:47:29.00,Default,,0,0,0,,فهل يُحتمل أن يكون المجرم معارضًا\Nلتعديل المساومة القضائية؟
Dialogue: 10,0:47:29.51,0:47:32.39,Default,,0,0,0,,.إنه قانون يُتداول في البرلمان سلفًا
Dialogue: 10,0:47:32.52,0:47:34.98,Default,,0,0,0,,...مقتل شرطي واحد
Dialogue: 10,0:47:35.10,0:47:36.65,Default,,0,0,0,,.لن يوقفه أبدًا
Dialogue: 10,0:47:36.77,0:47:38.22,Default,,0,0,0,,.هذا صحيح
Dialogue: 10,0:47:38.86,0:47:41.53,Default,,0,0,0,,...إن أُقر التعديل
Dialogue: 10,0:47:41.65,0:47:44.40,Default,,0,0,0,,فسيبدأ العمل ببرنامج حماية الشهود أيضًا، أليس كذلك؟
Dialogue: 10,0:47:49.66,0:47:50.80,Default,,0,0,0,,ما الأمر؟
Dialogue: 10,0:47:53.00,0:47:53.94,Default,,0,0,0,,.لا شيء
Dialogue: 10,0:47:55.66,0:47:56.56,Default,,0,0,0,,...لا شيء
Dialogue: 10,0:48:03.46,0:48:06.51,Default,,0,0,0,,.جرفني الانهيار الثلجي في المنطقة القادمة
Dialogue: 10,0:48:07.30,0:48:10.00,Default,,0,0,0,,...من الذي رأيته حينها
Dialogue: 10,0:48:13.14,0:48:14.52,Default,,0,0,0,,.بدأ الثلج يتساقط
Dialogue: 10,0:48:14.84,0:48:16.02,Default,,0,0,0,,لمَ لا نؤجل ذلك إلى الغد؟
Dialogue: 10,0:48:16.14,0:48:17.65,Default,,0,0,0,,.عودي إن شئتِ
Dialogue: 10,0:48:17.90,0:48:19.45,Default,,0,0,0,,.سأذهب وحدي
Dialogue: 10,0:48:22.07,0:48:23.90,Default,,0,0,0,,.فعلت ذلك المرة السابقة أيضًا
Dialogue: 10,0:48:24.49,0:48:27.74,Default,,0,0,0,,،قلت إنك وجدت ميكوريا
Dialogue: 10,0:48:27.86,0:48:31.55,Default,,0,0,0,,.وطاردته وحدك ثم أصبحت في عداد المفقودين
Dialogue: 10,0:48:32.08,0:48:33.91,Default,,0,0,0,,...انقطعت أخبارك لشهور
Dialogue: 10,0:48:34.04,0:48:35.32,Default,,0,0,0,,ما بالكِ فجأةً؟
Dialogue: 10,0:48:36.37,0:48:38.00,Default,,0,0,0,,.ظننت أنك قُتلت
Dialogue: 10,0:48:38.25,0:48:40.42,Default,,0,0,0,,.مستحيل يا غبية
Dialogue: 10,0:48:40.54,0:48:42.96,Default,,0,0,0,,!لكن الجميع ظنوا ذلك
Dialogue: 10,0:48:43.46,0:48:45.13,Default,,0,0,0,,!الجميع في شرطة ناغانو
Dialogue: 10,0:48:46.88,0:48:53.89,Default,,0,0,0,,لذا استقلتِ من الشرطة وتزوجتِ\N.من عائلة ثرية بينما كنت فاقدًا للوعي
Dialogue: 10,0:48:59.98,0:49:01.38,Default,,0,0,0,,.أعلم
Dialogue: 10,0:49:01.73,0:49:05.73,Default,,0,0,0,,.فعلتِ ذلك لحلّ لغز قضية كاي-سان
Dialogue: 10,0:49:06.65,0:49:10.74,Default,,0,0,0,,.لو كنت مكانك لما تزوجت
Dialogue: 10,0:49:13.28,0:49:14.62,Default,,0,0,0,,،إذن، في تلك الحالة
Dialogue: 10,0:49:14.74,0:49:18.49,Default,,0,0,0,,لو رحلت عن هذا العالم\N،ولم تجد وسيلة أخرى للبحث
Dialogue: 10,0:49:18.91,0:49:21.04,Default,,0,0,0,,!ماذا كنت ستفعل لو كنت مكاني؟
Dialogue: 10,0:49:21.58,0:49:22.59,Default,,0,0,0,,!أجبني
Dialogue: 10,0:49:36.60,0:49:39.02,Default,,0,0,0,,!سمعت صوتًا يشبه الطلق الناري
Dialogue: 10,0:49:39.52,0:49:41.44,Default,,0,0,0,,هل هناك من يصطاد؟
Dialogue: 10,0:49:41.56,0:49:43.40,Default,,0,0,0,,.لا أظن ذلك في هذا الوقت
Dialogue: 10,0:49:44.82,0:49:46.15,Default,,0,0,0,,!إنه طلق ناري كما توقعنا
Dialogue: 10,0:49:46.28,0:49:49.65,Default,,0,0,0,,!لا بدّ أن أحدهم يخالف القوانين ويصطاد الحيوانات
Dialogue: 10,0:49:49.67,0:49:50.96,Default,,0,0,0,,!لنوبخه
Dialogue: 10,0:49:50.99,0:49:52.62,Default,,0,0,0,,!أنتما، تمهلا
Dialogue: 10,0:49:52.74,0:49:55.96,Default,,0,0,0,,!اعتنِ بآي-تشان وأيومي-تشان أيها البروفيسور
Dialogue: 10,0:49:56.33,0:49:57.53,Default,,0,0,0,,!ران-كن
Dialogue: 10,0:50:02.72,0:50:03.80,Default,,0,0,0,,!لنهرب
Dialogue: 10,0:50:11.84,0:50:13.00,Default,,0,0,0,,!لنسرع
Dialogue: 10,0:50:43.33,0:50:44.54,Default,,0,0,0,,!السيارة تحترق
Dialogue: 10,0:50:44.55,0:50:45.58,Default,,0,0,0,,!ما هذا؟
Dialogue: 10,0:50:45.71,0:50:48.17,Default,,0,0,0,,.نادِ البروفيسور والآخرين يا غينتا-كن
Dialogue: 10,0:50:48.30,0:50:50.46,Default,,0,0,0,,.سأبحث عن أيّ مصابين
Dialogue: 10,0:50:53.55,0:50:57.26,Default,,0,0,0,,!ساخن! لا يبدو هذا مجرد حادث
Dialogue: 10,0:51:01.18,0:51:02.39,Default,,0,0,0,,!ميتسوهيكو
Dialogue: 10,0:51:02.85,0:51:04.85,Default,,0,0,0,,!توقف
Dialogue: 10,0:51:14.32,0:51:15.29,Default,,0,0,0,,!غينتا-كن
Dialogue: 10,0:51:15.86,0:51:17.00,Default,,0,0,0,,أأنت بخير؟
Dialogue: 10,0:51:28.38,0:51:29.65,Default,,0,0,0,,!ران أونيه-تشان
Dialogue: 10,0:51:53.65,0:51:56.45,Default,,0,0,0,,!شخص طالح يهاجم ران أونيه-سان
Dialogue: 10,0:51:56.57,0:51:59.41,Default,,0,0,0,,!أرجوكم تعالوا فورًا! سأرسل الصورة الآن
Dialogue: 10,0:52:05.71,0:52:07.33,Default,,0,0,0,,!ران أونيه-سان
Dialogue: 10,0:52:07.88,0:52:09.14,Default,,0,0,0,,هل أنتما بخير؟
Dialogue: 10,0:52:11.05,0:52:13.61,Default,,0,0,0,,ميتسوهيكو-كن، هل اتصلت بـ110؟
Dialogue: 10,0:52:15.55,0:52:18.00,Default,,0,0,0,,.الهاتف... كان خارج التغطية
Dialogue: 10,0:52:19.89,0:52:21.49,Default,,0,0,0,,أكانت تمثيلية إذن؟
Dialogue: 10,0:52:22.18,0:52:24.27,Default,,0,0,0,,!أنتما مذهلان
Dialogue: 10,0:52:26.69,0:52:28.00,Default,,0,0,0,,كان ذلك مخيفًا، أليس كذلك؟
Dialogue: 10,0:52:28.01,0:52:29.00,Default,,0,0,0,,.شكرًا لكما
Dialogue: 10,0:52:31.77,0:52:33.68,Default,,0,0,0,,أويهارا، هل أنتِ بخير؟
Dialogue: 10,0:52:33.90,0:52:35.70,Default,,0,0,0,,.أجل... نوعًا ما
Dialogue: 10,0:52:36.20,0:52:38.00,Default,,0,0,0,,.علينا الاحتماء في مكان ما
Dialogue: 10,0:52:42.81,0:52:44.49,Default,,0,0,0,,.عذرًا، نحن من الشرطة
Dialogue: 10,0:52:50.08,0:52:51.72,Default,,0,0,0,,.لعلهم غادروا إلى مكان
Dialogue: 10,0:52:52.96,0:52:54.16,Default,,0,0,0,,هل معكِ جهاز بي-3؟
Dialogue: 10,0:52:54.22,0:52:56.00,Default,,0,0,0,,.أسقطت جهازي قبل قليل
Dialogue: 10,0:52:56.38,0:52:57.88,Default,,0,0,0,,.لكننا خارج التغطية هنا
Dialogue: 10,0:52:58.18,0:53:00.22,Default,,0,0,0,,.قد ينجح إرسال الطوارئ
Dialogue: 10,0:53:00.51,0:53:01.48,Default,,0,0,0,,.صحيح
Dialogue: 10,0:53:06.98,0:53:09.56,Default,,0,0,0,,.تم استقبال إشارة طوارئ عبر موجات الشرطة
Dialogue: 10,0:53:10.02,0:53:14.53,Default,,0,0,0,,.معرف الجهاز يشير إلى أويهارا يوي من قسم التحقيقات الأول
Dialogue: 10,0:53:14.65,0:53:16.32,Default,,0,0,0,,...بناءً على بيانات الموقع الجغرافي
Dialogue: 10,0:53:16.44,0:53:20.67,Default,,0,0,0,,مصدر الإشارة هو كوخ فرن الفحم بوبا\N!في المحطة الخامسة بجبل ميتاكاراداكي
Dialogue: 10,0:53:20.70,0:53:21.57,Default,,0,0,0,,.لنذهب
Dialogue: 10,0:53:24.33,0:53:25.66,Default,,0,0,0,,!ابقَ أنت هنا
Dialogue: 10,0:53:28.34,0:53:29.11,Default,,0,0,0,,هايبارا؟
Dialogue: 10,0:53:30.03,0:53:31.08,Default,,0,0,0,,!ران والأولاد؟
Dialogue: 10,0:53:32.04,0:53:35.75,Default,,0,0,0,,.كازامي-سان، هاجم رجل مسلح رفاقي في الجبل
Dialogue: 10,0:53:37.42,0:53:38.60,Default,,0,0,0,,عجبًا؟
Dialogue: 10,0:53:38.92,0:53:41.26,Default,,0,0,0,,.لا توجد صورة واضحة
Dialogue: 10,0:53:42.19,0:53:43.40,Default,,0,0,0,,...ما كان ينبغي حصول هذا
Dialogue: 10,0:53:43.68,0:53:47.12,Default,,0,0,0,,.على أيّ حال، اطمأن قلبي لعودتكم سالمين
Dialogue: 10,0:53:48.94,0:53:50.04,Default,,0,0,0,,.يبدو أنهم وصلوا
Dialogue: 10,0:53:52.46,0:53:54.06,Default,,0,0,0,,!يا لها من ورطة كبيرة
Dialogue: 10,0:53:58.36,0:54:01.00,Default,,0,0,0,,.يبدو أنكم التقطتم إشارة الطوارئ
Dialogue: 10,0:54:03.28,0:54:05.72,Default,,0,0,0,,.هذا مالك المكان الذي أنقذنا
Dialogue: 10,0:54:06.85,0:54:08.21,Default,,0,0,0,,{\an8}.أُدعى أوتومو
Dialogue: 10,0:54:09.45,0:54:10.62,Default,,0,0,0,,{\an8}.أجل، أعتذر
Dialogue: 10,0:54:11.17,0:54:12.48,Default,,0,0,0,,...كوخ الفحم هذا
Dialogue: 10,0:54:12.49,0:54:13.38,Default,,0,0,0,,.ضيق
Dialogue: 10,0:54:13.50,0:54:14.88,Default,,0,0,0,,بنيته حديثًا، أليس كذلك؟
Dialogue: 10,0:54:15.29,0:54:18.01,Default,,0,0,0,,.أجل، أعمل هنا منذ 5 سنوات
Dialogue: 10,0:54:19.92,0:54:20.96,Default,,0,0,0,,...خمس سنوات
Dialogue: 10,0:54:24.60,0:54:26.31,Default,,0,0,0,,،بسبب حادثة إطلاق النار
Dialogue: 10,0:54:26.43,0:54:30.18,Default,,0,0,0,,.أصدرت الشرطة تعليمات بعدم النزول من الجبل دون إذن
Dialogue: 10,0:54:30.31,0:54:32.69,Default,,0,0,0,,هل سنبيت هنا الليلة؟
Dialogue: 10,0:54:33.81,0:54:37.02,Default,,0,0,0,,.لم نخطط لذلك، لذا لم نحجز غرفًا
Dialogue: 10,0:54:37.84,0:54:39.23,Default,,0,0,0,,ماذا سنفعل إذن؟
Dialogue: 10,0:54:39.36,0:54:41.24,Default,,0,0,0,,هل سننام في السيارة؟
Dialogue: 10,0:54:41.36,0:54:44.74,Default,,0,0,0,,.دعونا نذهب إذن إلى كوخ الفحم القريب
Dialogue: 10,0:54:45.37,0:54:48.00,Default,,0,0,0,,.لا بدّ أن العم كوغورو والآخرون هناك
Dialogue: 10,0:54:48.95,0:54:50.55,Default,,0,0,0,,.بندقية غريبة
Dialogue: 10,0:54:51.04,0:54:53.12,Default,,0,0,0,,.لا، يبدو أنها ليست بندقية
Dialogue: 10,0:54:53.50,0:54:56.25,Default,,0,0,0,,.إنها جهاز صوتي
Dialogue: 10,0:54:56.38,0:54:59.13,Default,,0,0,0,,.شكلها الشبيه بالبندقية مجرد لمسة جمالية من باب المرح
Dialogue: 10,0:54:59.67,0:55:01.30,Default,,0,0,0,,،بسبب تضاريس هذا الجبل
Dialogue: 10,0:55:01.42,0:55:05.40,Default,,0,0,0,,تحدث الانهيارات الثلجية من\N.الشمال والغرب، لذا تعدّ نقطة تقاطع
Dialogue: 10,0:55:05.93,0:55:08.47,Default,,0,0,0,,،لذا قبل حدوث انهيار كبير
Dialogue: 10,0:55:08.60,0:55:11.68,Default,,0,0,0,,.نفتعل انهيارات صغيرة عمدًا بين الحين والآخر
Dialogue: 10,0:55:12.31,0:55:13.69,Default,,0,0,0,,.هذا الجهاز الصوتي
Dialogue: 10,0:55:13.81,0:55:17.86,Default,,0,0,0,,عند توجيهه نحو مكبرات الصوت المثبتة\N،في المكان المراد إحداث الانهيار فيه وتشغيله
Dialogue: 10,0:55:17.98,0:55:21.63,Default,,0,0,0,,.يصدر صوت انفجار من المكبرات ويحدث انهيارًا
Dialogue: 10,0:55:22.15,0:55:25.15,Default,,0,0,0,,.إنه نوع من أنظمة التحكم في الانهيارات الثلجية
Dialogue: 10,0:55:25.91,0:55:27.91,Default,,0,0,0,,.فهمت أمر الانهيارات
Dialogue: 10,0:55:28.37,0:55:29.99,Default,,0,0,0,,ماذا عن المجرم الذي أطلق النار عليكما؟
Dialogue: 10,0:55:29.99,0:55:31.00,Default,,0,0,0,,هل رأيتما وجهه؟
Dialogue: 10,0:55:31.61,0:55:32.20,Default,,0,0,0,,.كلّا
Dialogue: 10,0:55:32.41,0:55:33.96,Default,,0,0,0,,...كان يضع خوذة
Dialogue: 10,0:55:34.08,0:55:36.50,Default,,0,0,0,,...كلّا، كان يضع خوذة
Dialogue: 10,0:55:37.00,0:55:38.64,Default,,0,0,0,,.لذا لم نميّز وجهه
Dialogue: 10,0:55:39.46,0:55:40.46,Default,,0,0,0,,خوذة دراجة؟
Dialogue: 10,0:55:40.71,0:55:43.97,Default,,0,0,0,,...أجل، كتلك التي يرتديها سائقو الدراجات النارية
Dialogue: 10,0:55:44.13,0:55:45.66,Default,,0,0,0,,.تلك التي تغطي الرأس بالكامل
Dialogue: 10,0:55:46.97,0:55:49.35,Default,,0,0,0,,على ذكر الأمر، كان يحمل بندقية، أليس كذلك؟
Dialogue: 10,0:55:49.47,0:55:52.41,Default,,0,0,0,,!كان يحمل واحدة وطويلة هكذا
Dialogue: 10,0:55:52.43,0:55:54.48,Default,,0,0,0,,.كانت البندقية مغطاة بغلاف
Dialogue: 10,0:55:55.06,0:55:56.65,Default,,0,0,0,,.بحجم بندقية القنص
Dialogue: 10,0:55:57.47,0:56:00.29,Default,,0,0,0,,...أذكر وجود غلاف عليها، ولكن
Dialogue: 10,0:56:00.45,0:56:03.31,Default,,0,0,0,,.حين ركلت البندقية، لم أشعر بملمس المعدن
Dialogue: 10,0:56:06.20,0:56:09.86,Default,,0,0,0,,إذن، أُطلق عليكم النار ببندقية مغطاة؟
Dialogue: 10,0:56:11.90,0:56:15.21,Default,,0,0,0,,.أغلب الظن أن المستهدف هو أنت يا كانسكي-كن
Dialogue: 10,0:56:15.54,0:56:16.71,Default,,0,0,0,,.لا شك في ذلك
Dialogue: 10,0:56:16.83,0:56:20.34,Default,,0,0,0,,المجرم هو الشخص الذي تواجد\N.في موقع الانهيار قبل 10 أشهر
Dialogue: 10,0:56:20.46,0:56:23.51,Default,,0,0,0,,.أجل، يظن أنك رأيته
Dialogue: 10,0:56:23.63,0:56:26.03,Default,,0,0,0,,.لكن المفتش ياماتو لا يذكر ذلك
Dialogue: 10,0:56:26.80,0:56:29.60,Default,,0,0,0,,.إذن، المجرم لا يعلم بذلك بعد
Dialogue: 10,0:56:29.85,0:56:33.82,Default,,0,0,0,,أو أنه أراد التخلص من المفتش\N.ياماتو قبل استعادته لذاكرته
Dialogue: 10,0:56:34.73,0:56:37.18,Default,,0,0,0,,...عذرًا... جاءت الشرطة
Dialogue: 10,0:56:37.19,0:56:39.94,Default,,0,0,0,,!لست شرطيًا، بل مدعٍ عام
Dialogue: 10,0:56:41.94,0:56:43.74,Default,,0,0,0,,،بعد تلقي إشارة الطوارئ
Dialogue: 10,0:56:44.07,0:56:46.45,Default,,0,0,0,,...بادرت شرطة محافظتي ناغانو وياماناشي
Dialogue: 10,0:56:46.57,0:56:50.42,Default,,0,0,0,,!بإغلاق الطرق عند السفح فورًا وبدأت في إقامة نقاط تفتيش
Dialogue: 10,0:56:52.91,0:56:57.51,Default,,0,0,0,,!بعبارة أخرى، المجرم في هذا الجبل حتمًا
Dialogue: 10,0:57:00.83,0:57:02.96,Default,,0,0,0,,لمَ موري-سان المدني موجود هنا حتى؟
Dialogue: 10,0:57:03.59,0:57:07.77,Default,,0,0,0,,.جمعية الصيد المحلية تساعدنا أيضًا
Dialogue: 10,0:57:08.69,0:57:09.85,Default,,0,0,0,,!عذرًا على الإزعاج
Dialogue: 10,0:57:10.20,0:57:11.35,Default,,0,0,0,,!مرتفع
Dialogue: 10,0:57:11.51,0:57:13.80,Default,,0,0,0,,.نعتذر عن المجيء فجأة
Dialogue: 10,0:57:14.22,0:57:18.02,Default,,0,0,0,,.خذوا راحتكم، ستجدونني عند الفرن إن احتجتم إليّ
Dialogue: 10,0:57:20.88,0:57:22.86,Default,,0,0,0,,.تبدو كقاعدة متخفية
Dialogue: 10,0:57:23.44,0:57:26.36,Default,,0,0,0,,غينتا-كن، ماذا تفعل منذ برهة؟
Dialogue: 10,0:57:26.49,0:57:29.36,Default,,0,0,0,,.علق شيء بين أسناني طيلة هذا الوقت
Dialogue: 10,0:57:29.49,0:57:31.17,Default,,0,0,0,,هل من لحم الشواء؟
Dialogue: 10,0:57:31.50,0:57:32.28,Default,,0,0,0,,.خرج
Dialogue: 10,0:57:32.62,0:57:33.92,Default,,0,0,0,,ما هذا؟
Dialogue: 10,0:57:34.24,0:57:36.29,Default,,0,0,0,,.تبدو كقطعة جلد
Dialogue: 10,0:57:36.75,0:57:39.24,Default,,0,0,0,,أيعقل أنها من قفاز المجرم؟
Dialogue: 10,0:57:40.86,0:57:42.44,Default,,0,0,0,,!صحيح، عضضته
Dialogue: 10,0:57:42.46,0:57:43.54,Default,,0,0,0,,{\an8}!هذا مقرف
Dialogue: 10,0:57:42.67,0:57:44.80,Default,,0,0,0,,!انتظر! ابقَ كما أنت يا غينتا
Dialogue: 10,0:57:44.92,0:57:46.90,Default,,0,0,0,,.سأحتفظ بهذه
Dialogue: 10,0:57:47.63,0:57:49.76,Default,,0,0,0,,!سأحضر كيسًا بلاستيكيًا أو ما شابه
Dialogue: 10,0:57:50.28,0:57:51.49,Default,,0,0,0,,!لا تذهب وحدك
Dialogue: 10,0:57:54.85,0:57:56.22,Default,,0,0,0,,.ليس لديّ سوى هذا
Dialogue: 10,0:57:56.81,0:57:58.66,Default,,0,0,0,,.شـ-شكرًا جزيلًا لك
Dialogue: 10,0:58:00.19,0:58:01.57,Default,,0,0,0,,.الأمور بخير هكذا
Dialogue: 10,0:58:02.31,0:58:04.06,Default,,0,0,0,,.الحرارة شديدة هنا
Dialogue: 10,0:58:04.19,0:58:07.00,Default,,0,0,0,,.الفرن ساخن جدًا، لذا لا تقتربوا منه
Dialogue: 10,0:58:11.03,0:58:13.63,Default,,0,0,0,,يا عم، ما سبب تلك الكدمة؟
Dialogue: 10,0:58:16.25,0:58:17.00,Default,,0,0,0,,...هذه
Dialogue: 10,0:58:17.01,0:58:19.03,Default,,0,0,0,,ألا تقطع الأشجار لصنع الفحم؟
Dialogue: 10,0:58:19.04,0:58:19.95,Default,,0,0,0,,.أُصبت بها حينها
Dialogue: 10,0:58:19.96,0:58:22.00,Default,,0,0,0,,.إنه عمل شاق
Dialogue: 10,0:58:24.08,0:58:25.26,Default,,0,0,0,,.كلّا
Dialogue: 10,0:58:25.59,0:58:29.00,Default,,0,0,0,,.تلك كدمة ناجمة عن بندقية كسر أو بندقية صيد
Dialogue: 10,0:58:25.59,0:58:29.00,Note,,0,0,0,,بندقية الكسر: بندقية ضغط هواء تُملأ بالرصاص عن طريق\N.ثني السبطانة لأسفل لضغط النابض وتلقيم الرصاصة
Dialogue: 10,0:58:30.38,0:58:32.76,Default,,0,0,0,,.هذه كدمة ناجمة عن ارتداد الإطلاق أيضًا
Dialogue: 10,0:58:37.47,0:58:38.80,Default,,0,0,0,,كازامي-سان، أتسمعني؟
Dialogue: 10,0:58:39.97,0:58:42.61,Default,,0,0,0,,...سجلات حاملي بنادق الصيد والقنص
Dialogue: 10,0:58:42.94,0:58:44.77,Default,,0,0,0,,يستطيع الأمن العام التحقق منها، أليس كذلك؟
Dialogue: 10,0:58:45.31,0:58:49.53,Default,,0,0,0,,.أريد منك التحقق من وجود اسم أوتومو تاكاشي فيها
Dialogue: 10,0:58:50.65,0:58:52.86,Default,,0,0,0,,!يا له من طفل متطلب
Dialogue: 10,0:58:55.20,0:58:56.01,Default,,0,0,0,,كدمة؟
Dialogue: 10,0:58:57.20,0:58:59.14,Default,,0,0,0,,.هنا... وهنا
Dialogue: 10,0:58:59.37,0:59:02.29,Default,,0,0,0,,.فهمت، بندقية قنص إذن
Dialogue: 10,0:59:02.83,0:59:04.58,Default,,0,0,0,,،تبدو تلك كبندقية
Dialogue: 10,0:59:04.71,0:59:06.74,Default,,0,0,0,,لكنها جهاز لإحداث الانهيارات، أليس كذلك؟
Dialogue: 10,0:59:07.17,0:59:09.30,Default,,0,0,0,,.أو هذا ما قاله صاحب المكان
Dialogue: 10,0:59:09.80,0:59:11.84,Default,,0,0,0,,أتظن أنها بندقية حقًا؟
Dialogue: 10,0:59:11.97,0:59:15.35,Default,,0,0,0,,،قبل سنوات، على الطريق الوطني بين ناغانو وياماناشي
Dialogue: 10,0:59:15.55,0:59:19.00,Default,,0,0,0,,.صُودرت عدّة أسلحة نارية بأشكال غير مألوفة
Dialogue: 10,0:59:19.81,0:59:23.10,Default,,0,0,0,,،مسدسات، وأسلحة آلية سريعة الإطلاق
Dialogue: 10,0:59:23.23,0:59:26.00,Default,,0,0,0,,.ومسدسات تستخدم مخازن البنادق
Dialogue: 10,0:59:26.81,0:59:30.38,Default,,0,0,0,,انتهت فترة حفظ تلك الأسلحة\N.والمفروض أنهم تخلصوا منها
Dialogue: 10,0:59:30.90,0:59:34.49,Default,,0,0,0,,كانت البندقية التي هاجمتكما عادية، أليس كذلك؟
Dialogue: 10,0:59:34.61,0:59:39.00,Default,,0,0,0,,.كانت مغطاة، لذا لم أميّز نوعها
Dialogue: 10,0:59:39.95,0:59:43.06,Default,,0,0,0,,.بعبارة أخرى، شكل البندقية... مجهول
Dialogue: 10,0:59:50.38,0:59:51.39,Default,,0,0,0,,.سريع
Dialogue: 10,0:59:51.71,0:59:55.22,Default,,0,0,0,,.المعتادون على الجبال مختلفون عنا
Dialogue: 10,1:00:05.31,1:00:09.28,Default,,0,0,0,,.ران-سان وغينتا-كن وميتسوهيكو-كن، اركبوا هذه السيارة
Dialogue: 10,1:00:10.10,1:00:13.43,Default,,0,0,0,,.أنتم شهود رؤوا المجرم، ستوفر شرطة المحافظة الحماية لكم
Dialogue: 10,1:00:13.65,1:00:15.57,Default,,0,0,0,,.أما نحن فسننزل عبر طريق آخر
Dialogue: 10,1:00:15.70,1:00:18.74,Default,,0,0,0,,المعذرة، ماذا عن كونان-كن وأيومي-تشان وآي-تشان؟
Dialogue: 10,1:00:18.87,1:00:21.58,Default,,0,0,0,,.أود لو يبقى الأطفال معًا
Dialogue: 10,1:00:21.70,1:00:25.21,Default,,0,0,0,,.معكِ حق في ذلك، اركبوا جميعًا إذن
Dialogue: 10,1:00:25.33,1:00:26.13,Default,,0,0,0,,.حاضر
Dialogue: 10,1:00:26.46,1:00:28.55,Default,,0,0,0,,ألم يعثروا على المجرم في النهاية؟
Dialogue: 10,1:00:28.88,1:00:33.33,Default,,0,0,0,,.أجل، رغم إغلاق الشرطة الطرق المؤدية إلى الجبل
Dialogue: 10,1:00:33.92,1:00:36.92,Default,,0,0,0,,كيف توارى المجرم عن الأنظار يا ترى؟
Dialogue: 10,1:00:37.59,1:00:40.00,Default,,0,0,0,,.السيارة ممتلئة، لذا سأبقى أنا
Dialogue: 10,1:00:40.51,1:00:43.60,Default,,0,0,0,,.بروفيسور أغاسا، اركب بدلًا مني
Dialogue: 10,1:00:44.12,1:00:45.77,Default,,0,0,0,,...لكن يا موري-كن
Dialogue: 10,1:00:45.89,1:00:48.48,Default,,0,0,0,,.سأنزل معهما
Dialogue: 10,1:00:48.60,1:00:51.65,Default,,0,0,0,,.إن نزلنا قليلًا فسنجد سيارتنا
Dialogue: 10,1:00:51.77,1:00:53.45,Default,,0,0,0,,.سأعود معهم أنا أيضًا
Dialogue: 10,1:00:53.78,1:00:56.90,Default,,0,0,0,,.أنت، سيركب الأطفال كلهم في سيارة واحدة
Dialogue: 10,1:00:57.03,1:01:00.65,Default,,0,0,0,,،لكن البروفيسور يأخذ مقعدين
Dialogue: 10,1:01:00.66,1:01:02.83,Default,,0,0,0,,.لذا رأيت أن عدم ركوبي أفضل
Dialogue: 10,1:01:02.95,1:01:05.00,Default,,0,0,0,,.تقول كلامًا قاسيًا بكل عفوية
Dialogue: 10,1:01:05.41,1:01:07.79,Default,,0,0,0,,.آهٍ من ذلك، لنذهب يا بروفيسور
Dialogue: 10,1:01:08.00,1:01:10.37,Default,,0,0,0,,.أبي، اعتنِ بكونان-كن
Dialogue: 10,1:01:10.79,1:01:12.79,Default,,0,0,0,,.سنرافقكما أيضًا
Dialogue: 10,1:01:13.34,1:01:14.42,Default,,0,0,0,,.فهمت
Dialogue: 10,1:01:14.94,1:01:15.72,Default,,0,0,0,,.يا إلهي
Dialogue: 10,1:01:26.33,1:01:29.81,Default,,0,0,0,,.فوناكوبو-سان، شكرًا على جهودك في البحث طوال الليل
Dialogue: 10,1:01:29.94,1:01:32.40,Default,,0,0,0,,أهذا قبر ماكي-سان؟
Dialogue: 10,1:01:33.72,1:01:35.44,Default,,0,0,0,,.اليوم ذكرى وفاتها على ما أذكر
Dialogue: 10,1:01:36.23,1:01:37.54,Default,,0,0,0,,.هذا خطئي
Dialogue: 10,1:01:38.32,1:01:40.00,Default,,0,0,0,,،في ذلك اليوم قبل 8 سنوات
Dialogue: 10,1:01:40.45,1:01:44.98,Default,,0,0,0,,.سألت عن مخزون ذخيرة الصيد، فقالت إنها ستتحقق منه
Dialogue: 10,1:01:45.20,1:01:46.82,Default,,0,0,0,,...في وقت متأخر كهذا
Dialogue: 10,1:01:47.83,1:01:52.83,Default,,0,0,0,,...قالت ماكي عند خروجها إن لديها ما تخبرني به عند عودتها
Dialogue: 10,1:01:53.71,1:01:57.13,Default,,0,0,0,,.لاحظت عليها أنها تواعد أحدهم
Dialogue: 10,1:01:57.26,1:02:00.63,Default,,0,0,0,,.ربما كانت ستحدثني عن الزواج
Dialogue: 10,1:02:01.18,1:02:04.97,Default,,0,0,0,,...كلماتها التي قالتها بسعادة وخجل
Dialogue: 10,1:02:05.10,1:02:07.00,Default,,0,0,0,,.لا تفارق أذني حتى الآن
Dialogue: 10,1:02:07.93,1:02:11.00,Default,,0,0,0,,...لن أتمكن من سماع ذلك الحديث
Dialogue: 10,1:02:11.81,1:02:13.45,Default,,0,0,0,,.إلى الأبد
Dialogue: 10,1:02:14.65,1:02:19.03,Default,,0,0,0,,.منذ ذلك الحين، آتي لوضع الزهور هنا في ذكرى وفاتها
Dialogue: 10,1:02:19.15,1:02:21.99,Default,,0,0,0,,.لكن هذه الزهرة في المقدمة بدأت تذبل
Dialogue: 10,1:02:23.41,1:02:25.11,Default,,0,0,0,,...زهرة ملفوف الظربان الشرقي البيضاء هذه
Dialogue: 10,1:02:23.41,1:02:25.01,Default,,0,0,0,,{\pos(1122,961)}(زازينسو)
Dialogue: 10,1:02:25.13,1:02:28.04,Default,,0,0,0,,.تُوضع هنا كل عام قبل ذكرى الوفاة
Dialogue: 10,1:02:28.33,1:02:29.89,Default,,0,0,0,,من يضعها؟
Dialogue: 10,1:02:30.58,1:02:33.29,Default,,0,0,0,,.زازينسو... اسم غريب
Dialogue: 10,1:02:33.42,1:02:37.77,Default,,0,0,0,,.سميت كذلك لأن شكلها يشبه راهبًا يمارس الزازين
Dialogue: 10,1:02:33.42,1:02:37.67,Note,,0,0,0,,،زازين: هي كلمة يابانية تعني حرفيًا "التأمل الجالس". إنها الممارسة الأساسية في بوذية الزن\N.وتهدف إلى تحقيق حالة من الراحة الجسدية والعقلية والوعي باللحظة الحالية دون أحكام أو أهداف
Dialogue: 10,1:02:38.26,1:02:41.63,Default,,0,0,0,,.تُزهر وسط الثلوج، وتوجد في هذا الجبل أيضًا
Dialogue: 10,1:02:41.76,1:02:44.10,Default,,0,0,0,,أيهيأ لي أم أن التربة حول القبر دافئة؟
Dialogue: 10,1:02:44.39,1:02:46.00,Default,,0,0,0,,.الثلج ذائب قليلًا
Dialogue: 10,1:02:46.51,1:02:49.00,Default,,0,0,0,,هل قُطفت هذه الزهرة من هذا الجبل إذن؟
Dialogue: 10,1:02:49.52,1:02:52.56,Default,,0,0,0,,.إن كانت كذلك فلا بدّ أن من قطفها خبير بالجبال
Dialogue: 10,1:02:52.89,1:02:58.00,Default,,0,0,0,,فإيجاد زهرة ملفوف ظربان شرقي بيضاء\N.وسط هذا الثلج أمر بالغ الصعوبة
Dialogue: 10,1:03:01.28,1:03:04.16,Default,,0,0,0,,.لا تتبعيني، عودي إلى شرطة المحافظة
Dialogue: 10,1:03:04.49,1:03:07.31,Default,,0,0,0,,ألست تحاول استدراج المجرم بالبقاء وحدك؟
Dialogue: 10,1:03:08.03,1:03:10.40,Default,,0,0,0,,.رجل تواق للموت هكذا لا يسعني تركه وشأنه
Dialogue: 10,1:03:10.83,1:03:14.21,Default,,0,0,0,,.لا أنوي... الموت
Dialogue: 10,1:03:14.62,1:03:17.67,Default,,0,0,0,,.إذن، اثنان أفضل من واحد
Dialogue: 10,1:03:20.71,1:03:22.71,Default,,0,0,0,,كومي! هل رأيت ذلك؟
Dialogue: 10,1:03:23.43,1:03:27.60,Default,,0,0,0,,.أجل، وميض فوهة السلاح عند الإطلاق
Dialogue: 10,1:03:27.72,1:03:30.70,Default,,0,0,0,,.كان في الساعة الثامنة من اتجاه سيرك
Dialogue: 10,1:03:31.22,1:03:32.52,Default,,0,0,0,,.لنستخدم هجوم الكماشة
Dialogue: 10,1:03:39.44,1:03:40.78,Default,,0,0,0,,!أكان هذا صوت إطلاق نار؟
Dialogue: 10,1:03:40.80,1:03:41.78,Default,,0,0,0,,!من هنا
Dialogue: 10,1:04:23.53,1:04:24.57,Default,,0,0,0,,!لنطارده
Dialogue: 10,1:04:34.37,1:04:35.33,Default,,0,0,0,,علبة مفرقعات نارية؟
Dialogue: 10,1:04:35.37,1:04:36.03,Default,,0,0,0,,!اجثمي
Dialogue: 10,1:04:44.84,1:04:45.76,Default,,0,0,0,,!ابتعدي
Dialogue: 10,1:04:59.40,1:05:00.06,Default,,0,0,0,,!تبًّا
Dialogue: 10,1:05:00.44,1:05:02.52,Default,,0,0,0,,!كان-تشان! اهرب
Dialogue: 10,1:05:14.45,1:05:15.58,Default,,0,0,0,,!كومي
Dialogue: 10,1:05:22.25,1:05:23.46,Default,,0,0,0,,...كومي
Dialogue: 10,1:05:23.59,1:05:24.92,Default,,0,0,0,,!كومي
Dialogue: 10,1:05:24.99,1:05:25.92,Default,,0,0,0,,!مستحيل
Dialogue: 10,1:05:26.71,1:05:27.62,Default,,0,0,0,,!من هنا
Dialogue: 10,1:05:27.66,1:05:28.76,Default,,0,0,0,,!مفتش ياماتو
Dialogue: 10,1:05:37.93,1:05:39.12,Default,,0,0,0,,!مفتش ياماتو
Dialogue: 10,1:05:39.20,1:05:40.02,Default,,0,0,0,,هل أصبتما؟
Dialogue: 10,1:05:40.15,1:05:42.00,Default,,0,0,0,,!كومي في الأسفل
Dialogue: 10,1:05:47.42,1:05:48.50,Default,,0,0,0,,،أكرر
Dialogue: 10,1:05:48.82,1:05:53.68,Default,,0,0,0,,اختفت إشارة الطوارئ الخاصة بموروفوشي\N!تاكأكي من قسم التحقيقات الأول
Dialogue: 10,1:05:54.20,1:05:55.80,Default,,0,0,0,,.انقطع الاتصال
Dialogue: 10,1:05:56.45,1:05:57.88,Default,,0,0,0,,...المفتش موروفوشي
Dialogue: 10,1:06:10.05,1:06:12.68,Default,,0,0,0,,.الحياة... فانية
Dialogue: 10,1:06:13.30,1:06:16.00,Default,,0,0,0,,...وما الآجال... إلّا
Dialogue: 10,1:06:16.31,1:06:17.18,Default,,0,0,0,, .مقدرة
Dialogue: 10,1:06:17.31,1:06:18.31,Default,,0,0,0,,!أين أنت؟
Dialogue: 10,1:06:19.21,1:06:21.31,Default,,0,0,0,,!كومي! أجبني
Dialogue: 10,1:06:21.84,1:06:24.19,Default,,0,0,0,,!لا أراه قرب الحفرة حيث سقط
Dialogue: 10,1:06:24.31,1:06:25.57,Default,,0,0,0,,ماذا يوجد تحت هذا الثلج؟
Dialogue: 10,1:06:25.98,1:06:27.00,Default,,0,0,0,,.نهر متجمد
Dialogue: 10,1:06:27.49,1:06:28.70,Default,,0,0,0,,!هل جرفه التيار؟
Dialogue: 10,1:06:30.40,1:06:32.73,Default,,0,0,0,,ماذا عن جهاز تتبع المفتش موروفوشي؟
Dialogue: 10,1:06:33.16,1:06:34.18,Default,,0,0,0,,.خارج التغطية
Dialogue: 10,1:06:34.26,1:06:35.28,Default,,0,0,0,,!تبًّا
Dialogue: 10,1:06:36.20,1:06:38.10,Default,,0,0,0,,!تبًّا
Dialogue: 10,1:06:43.75,1:06:45.00,Default,,0,0,0,,...ني-سان
Dialogue: 10,1:06:47.09,1:06:48.04,Default,,0,0,0,,...ني-سان
Dialogue: 10,1:06:50.42,1:06:51.22,Default,,0,0,0,,!ني-سان
Dialogue: 10,1:07:00.39,1:07:01.34,Default,,0,0,0,,...مستحيل
Dialogue: 10,1:07:02.56,1:07:04.40,Default,,0,0,0,,هيروميتسو... أهذا أنت؟
Dialogue: 10,1:07:06.40,1:07:07.65,Default,,0,0,0,,.وصلت في الوقت المناسب
Dialogue: 10,1:07:07.98,1:07:09.74,Default,,0,0,0,,...هيروميتسو، أنت
Dialogue: 10,1:07:10.28,1:07:11.81,Default,,0,0,0,,ألم تمت؟
Dialogue: 10,1:07:12.90,1:07:15.00,Default,,0,0,0,,انضممت... إلى الأمن العام، أليس كذلك؟
Dialogue: 10,1:07:15.32,1:07:19.59,Default,,0,0,0,,.كان لديّ رفيق حاد الذكاء سبقني إلى ذلك
Dialogue: 10,1:07:20.25,1:07:23.47,Default,,0,0,0,,.وهذا الرفيق زيّف موتي
Dialogue: 10,1:07:24.71,1:07:27.55,Default,,0,0,0,,.حين عدت إلى ناغانو، سمعت أنك مفقود
Dialogue: 10,1:07:27.88,1:07:30.67,Default,,0,0,0,,.فتتبعت موجات الشرطة حتى بلغت هذا المكان
Dialogue: 10,1:07:32.38,1:07:34.57,Default,,0,0,0,,.لكنني أردت رؤيتك يا ني-سان
Dialogue: 10,1:07:35.09,1:07:37.00,Default,,0,0,0,,.هيا، لنعد معًا
Dialogue: 10,1:07:37.22,1:07:38.41,Default,,0,0,0,,.كلّا، هذا غير صحيح
Dialogue: 10,1:07:38.93,1:07:43.30,Default,,0,0,0,,.لو تتبعت موجات الشرطة لما أتيت وحدك
Dialogue: 10,1:07:44.60,1:07:48.27,Default,,0,0,0,,.يبدو أن هذا ليس واقعًا
Dialogue: 10,1:07:53.36,1:07:54.44,Default,,0,0,0,,...هيروميتسو
Dialogue: 10,1:07:59.08,1:08:00.29,Default,,0,0,0,,...مع الأسف
Dialogue: 10,1:08:02.91,1:08:03.87,Default,,0,0,0,,!هناك
Dialogue: 10,1:08:04.54,1:08:05.62,Default,,0,0,0,,!في الأسفل
Dialogue: 10,1:08:05.75,1:08:06.65,Default,,0,0,0,,!الثلج سميك
Dialogue: 10,1:08:06.65,1:08:07.68,Default,,0,0,0,,ماذا علينا أن نفعل؟
Dialogue: 10,1:08:07.71,1:08:08.67,Default,,0,0,0,,!ابتعدا
Dialogue: 10,1:08:14.22,1:08:15.27,Default,,0,0,0,,!أيها المفتش موروفوشي
Dialogue: 10,1:08:15.59,1:08:16.70,Default,,0,0,0,,!سأذهب أنا
Dialogue: 10,1:08:21.93,1:08:23.45,Default,,0,0,0,,أنت! هل أنت بخير؟
Dialogue: 10,1:08:25.31,1:08:26.10,Default,,0,0,0,,!إنه حي
Dialogue: 10,1:08:26.11,1:08:27.08,Default,,0,0,0,,.تعال إلى هنا
Dialogue: 10,1:08:27.10,1:08:28.00,Default,,0,0,0,,.أعتمد عليك
Dialogue: 10,1:08:28.23,1:08:29.94,Default,,0,0,0,,!كوخ الفحم قريب من هنا
Dialogue: 10,1:08:30.06,1:08:31.77,Default,,0,0,0,,.سنطلب النجدة من هناك
Dialogue: 10,1:08:31.90,1:08:33.00,Default,,0,0,0,,!سأسبقكم
Dialogue: 10,1:08:33.94,1:08:35.45,Default,,0,0,0,,.هيرو... ميتسو
Dialogue: 10,1:08:38.41,1:08:39.91,Default,,0,0,0,,هيروميتسو؟
Dialogue: 10,1:08:52.63,1:08:54.30,Default,,0,0,0,,.تفضلوا بالراحة عندي
Dialogue: 10,1:08:54.92,1:08:57.72,Default,,0,0,0,,.سأعود فور انتهائي من تنظيف الفرن
Dialogue: 10,1:08:58.14,1:09:00.60,Default,,0,0,0,,هل نقبل عرضه ونرتاح؟
Dialogue: 10,1:09:00.72,1:09:02.85,Default,,0,0,0,,...أجل، كونان-كن معنا أيضًا
Dialogue: 10,1:09:03.14,1:09:04.52,Default,,0,0,0,,.أنا بخير
Dialogue: 10,1:09:04.64,1:09:07.64,Default,,0,0,0,,لكن ما هدف المجرم؟
Dialogue: 10,1:09:08.31,1:09:09.60,Default,,0,0,0,,.أنا المستهدف
Dialogue: 10,1:09:10.27,1:09:12.99,Default,,0,0,0,,...لو أتذكر شيئًا من ذلك المشهد
Dialogue: 10,1:09:17.24,1:09:18.31,Default,,0,0,0,,ما هذا؟
Dialogue: 10,1:09:27.46,1:09:30.58,Default,,0,0,0,,!شغّل أحدهم مكبرات الصوت المسببة للانهيار
Dialogue: 10,1:09:30.71,1:09:33.01,Default,,0,0,0,,!ابتعدوا من هنا بسرعة
Dialogue: 10,1:09:33.81,1:09:34.63,Default,,0,0,0,,كونان-كن؟
Dialogue: 10,1:09:37.11,1:09:39.34,Default,,0,0,0,,!اختفت! تلك البندقية غير موجودة
Dialogue: 10,1:09:39.47,1:09:41.39,Default,,0,0,0,,!ماذا تفعل؟! اخرج بسرعة
Dialogue: 10,1:09:41.51,1:09:43.31,Default,,0,0,0,,!سيتحطم هذا الكوخ فورًا
Dialogue: 10,1:09:43.33,1:09:45.01,Default,,0,0,0,,!لا مهرب أمامنا
Dialogue: 10,1:09:45.14,1:09:48.02,Default,,0,0,0,,!سأحدث انهيارًا آخر لإيقاف هذا الانهيار
Dialogue: 10,1:09:48.14,1:09:52.52,Default,,0,0,0,,فهمت، بانهيار من الغرب\N.نوقف الانهيار القادم من الشمال
Dialogue: 10,1:09:52.65,1:09:53.77,Default,,0,0,0,,أما من شيء؟
Dialogue: 10,1:09:53.81,1:09:55.00,Default,,0,0,0,,!ذلك الجهاز
Dialogue: 10,1:09:55.40,1:09:58.78,Default,,0,0,0,,...شيء يمكنه تفعيل جهاز الانهيار الثلجي في الغرب
Dialogue: 10,1:10:01.28,1:10:03.24,Default,,0,0,0,,هل هذا مناسب يا كونان-كن؟
Dialogue: 10,1:10:07.45,1:10:11.00,Default,,0,0,0,,!أيها المفتش ياماتو، أطلق النار على هذه العلبة
Dialogue: 10,1:10:15.88,1:10:16.60,Default,,0,0,0,,!حسن
Dialogue: 10,1:10:23.26,1:10:24.55,Default,,0,0,0,,ألم تصل؟
Dialogue: 10,1:10:24.68,1:10:25.90,Default,,0,0,0,,!لنعد الكرّة
Dialogue: 10,1:10:32.10,1:10:33.48,Default,,0,0,0,,!تبًّا! أخطأت
Dialogue: 10,1:10:34.11,1:10:36.68,Default,,0,0,0,,!كونان-كن، هذه فرصتنا الأخيرة
Dialogue: 10,1:10:50.54,1:10:52.62,Default,,0,0,0,,!الآن أيها المفتش ياماتو
Dialogue: 10,1:10:54.79,1:10:55.66,Default,,0,0,0,,ماذا؟
Dialogue: 10,1:11:05.60,1:11:07.64,Default,,0,0,0,,!نجحنا! حدث الانهيار
Dialogue: 10,1:11:07.76,1:11:10.35,Default,,0,0,0,,!سحقًا! لا فائدة! لن يلحق
Dialogue: 10,1:11:10.48,1:11:12.19,Default,,0,0,0,,تبًّا، هل تأخرنا؟
Dialogue: 10,1:11:12.51,1:11:15.28,Default,,0,0,0,,!تعال يا فتى! اهرب نحو الفرن
Dialogue: 10,1:11:35.79,1:11:37.92,Default,,0,0,0,,...انتظروا، لا يزال المفتش ياماتو
Dialogue: 10,1:11:59.52,1:12:02.58,Default,,0,0,0,,توقف الانهيار، ولكن أين المفتش ياماتو؟
Dialogue: 10,1:12:05.70,1:12:07.16,Default,,0,0,0,,...هذا مستحيل
Dialogue: 10,1:12:08.37,1:12:11.34,Default,,0,0,0,,.كان أوتومو-سان صانع الفحم هنا أيضًا
Dialogue: 10,1:12:11.66,1:12:13.41,Default,,0,0,0,,.سننزل من الجبل ونستدعي النجدة
Dialogue: 10,1:12:13.54,1:12:14.25,Default,,0,0,0,,!حاضر
Dialogue: 10,1:12:15.21,1:12:17.04,Default,,0,0,0,,!مـ-مفتش ياماتو
Dialogue: 10,1:12:17.50,1:12:20.96,Default,,0,0,0,,!أجبني أيها المفتش ياماتو
Dialogue: 10,1:12:21.21,1:12:23.00,Default,,0,0,0,,!مفتش ياماتو
Dialogue: 10,1:12:33.77,1:12:34.58,Default,,0,0,0,,!كونان
Dialogue: 10,1:12:34.60,1:12:35.85,Default,,0,0,0,,!كونان-كن
Dialogue: 10,1:12:35.98,1:12:37.98,Default,,0,0,0,,.آسف، أقلقناكم
Dialogue: 10,1:12:38.23,1:12:39.44,Default,,0,0,0,,.أبي
Dialogue: 10,1:12:39.56,1:12:41.00,Default,,0,0,0,,.نحن بخير
Dialogue: 10,1:12:41.36,1:12:43.00,Default,,0,0,0,,.أعتذر عن التأخير
Dialogue: 10,1:12:43.48,1:12:45.44,Default,,0,0,0,,تفضل، أتريد شايًا؟
Dialogue: 10,1:12:45.99,1:12:46.99,Default,,0,0,0,,.شكرًا
Dialogue: 10,1:12:47.11,1:12:48.33,Default,,0,0,0,,.إنه ساخن، لذا انتبه
Dialogue: 10,1:12:48.35,1:12:49.60,Default,,0,0,0,,كيف حال المفتش موروفوشي؟
Dialogue: 10,1:12:49.66,1:12:52.47,Default,,0,0,0,,.إنه بخير، حياته ليست في خطر
Dialogue: 10,1:12:53.83,1:12:56.47,Default,,0,0,0,,وماذا عن كان-تشان... المفتش ياماتو؟
Dialogue: 10,1:12:57.00,1:12:59.08,Default,,0,0,0,,.تبحث عنه فرق الإنقاذ الآن
Dialogue: 10,1:12:59.21,1:13:03.13,Default,,0,0,0,,،بالمناسبة، بخصوص قفاز المجرم الذي عضه الفتى
Dialogue: 10,1:13:03.45,1:13:05.56,Default,,0,0,0,,.أظهر التحليل أنه من جلد الغزال
Dialogue: 10,1:13:05.88,1:13:08.00,Default,,0,0,0,,.طلبنا من المختبر الجنائي مطابقته
Dialogue: 10,1:13:08.55,1:13:09.43,Default,,0,0,0,,!الآن
Dialogue: 10,1:13:10.47,1:13:13.26,Default,,0,0,0,,...تلقينا اتصالًا من فريق الإنقاذ الآن
Dialogue: 10,1:13:14.60,1:13:17.25,Default,,0,0,0,,.عثروا... على المفتش ياماتو
Dialogue: 10,1:13:19.52,1:13:20.40,Default,,0,0,0,,...لكن
Dialogue: 10,1:13:21.15,1:13:22.11,Default,,0,0,0,,...لكن
Dialogue: 10,1:13:22.69,1:13:25.61,Default,,0,0,0,,...قبل نقله إلى المستشفى، المفتش ياماتو
Dialogue: 10,1:13:26.19,1:13:27.61,Default,,0,0,0,,...المفتش ياماتو
Dialogue: 10,1:13:28.07,1:13:30.52,Default,,0,0,0,,.تأكدت... وفاته
Dialogue: 10,1:13:34.49,1:13:36.02,Default,,0,0,0,,...مـ-مستحيل
Dialogue: 10,1:13:39.87,1:13:41.17,Default,,0,0,0,,...كذب
Dialogue: 10,1:13:42.50,1:13:43.88,Default,,0,0,0,,...هذا كذب
Dialogue: 10,1:13:45.88,1:13:48.88,Default,,0,0,0,,...كان-تشان... كان-تشان
Dialogue: 10,1:13:49.34,1:13:51.76,Default,,0,0,0,,!كان-تشان
Dialogue: 10,1:13:54.39,1:13:55.36,Default,,0,0,0,,.تبًّا
Dialogue: 10,1:13:55.93,1:13:57.48,Default,,0,0,0,,...حتى المفتش ياماتو
Dialogue: 10,1:14:04.65,1:14:06.75,Default,,0,0,0,,،في انهيار ما قبل 10 أشهر
Dialogue: 10,1:14:07.36,1:14:11.86,Default,,0,0,0,,.لا بدّ أن المجرم فعل أمرًا لا يجب لأحد رؤيته هناك
Dialogue: 10,1:14:12.28,1:14:15.45,Default,,0,0,0,,،لذا قتل المفتش ياماتو الذي رآه
Dialogue: 10,1:14:15.58,1:14:18.70,Default,,0,0,0,,.والمفتش ساميتاني الذي بدأ التحقيق في ذلك
Dialogue: 10,1:14:18.83,1:14:21.59,Default,,0,0,0,,.سحقًا، سارت الأمور كما خطط المجرم
Dialogue: 10,1:14:21.92,1:14:26.64,Default,,0,0,0,,.جئت للانتقام لتمساح، ولكن سقطت ضحية أخرى
Dialogue: 10,1:14:26.92,1:14:28.09,Default,,0,0,0,,.أبي
Dialogue: 10,1:14:28.21,1:14:31.00,Default,,0,0,0,,أردت سؤالك، لمَ تسميه تمساح؟
Dialogue: 10,1:14:31.43,1:14:34.55,Default,,0,0,0,,اسمه ساميتاني (وادي القرش)، فلمَ تلك التسمية؟
Dialogue: 10,1:14:34.68,1:14:37.56,Default,,0,0,0,,.يبدو أنهم يسمون القرش تمساحًا في مسقط رأسه
Dialogue: 10,1:14:37.68,1:14:39.68,Default,,0,0,0,,أين مسقط رأسه؟
Dialogue: 10,1:14:40.10,1:14:41.19,Default,,0,0,0,,.لا أدري
Dialogue: 10,1:14:41.90,1:14:43.11,Default,,0,0,0,,.نسيت
Dialogue: 10,1:14:44.11,1:14:46.98,Default,,0,0,0,,،في سجلات حاملي رخص الصيد
Dialogue: 10,1:14:47.11,1:14:49.34,Default,,0,0,0,,.لم أجد اسم أوتومو تاكاشي
Dialogue: 10,1:14:49.86,1:14:53.74,Default,,0,0,0,,.لكن وجدت اسمًا مثيرًا للاهتمام في سجلات ناغانو
Dialogue: 10,1:14:54.03,1:14:55.24,Default,,0,0,0,,.كما توقعت
Dialogue: 10,1:14:55.37,1:14:57.54,Default,,0,0,0,,في هذه الحالة، أيمكنك التحقق من سجل هذا الشخص؟
Dialogue: 10,1:14:57.99,1:15:01.32,Default,,0,0,0,,.أنت كثير الطلبات بحق
Dialogue: 10,1:15:04.75,1:15:06.50,Default,,0,0,0,,ماذا عن جهاز التنصت؟
Dialogue: 10,1:15:06.63,1:15:09.64,Default,,0,0,0,,،اتضح أن كازامي-سان من يستمع عبر جهاز التنصت
Dialogue: 10,1:15:09.96,1:15:13.96,Default,,0,0,0,,ولكن يبدو أنه يحقق في هذه القضية\N.منذ مقتل المفتش ساميتاني
Dialogue: 10,1:15:14.51,1:15:18.51,Default,,0,0,0,,ألست من أمر بالتحقيق في حادثة الانهيار قبل 10 أشهر؟
Dialogue: 10,1:15:18.93,1:15:21.77,Default,,0,0,0,,من أمر المفتش ساميتاني؛ عميل الأمن العام المتخفي؟
Dialogue: 10,1:15:21.89,1:15:23.81,Default,,0,0,0,,هل أخبرك كازامي؟
Dialogue: 10,1:15:23.94,1:15:25.47,Default,,0,0,0,,.كما توقعت، الأمر كذلك
Dialogue: 10,1:15:25.90,1:15:28.46,Default,,0,0,0,,،اطمئن، مهما سألت كازامي-سان
Dialogue: 10,1:15:28.48,1:15:31.18,Default,,0,0,0,,.لم يجبني مراعاةً لك يا أمورو-سان
Dialogue: 10,1:15:32.07,1:15:34.11,Default,,0,0,0,,...المشكلة هي... لمَ جعلتَ
Dialogue: 10,1:15:34.24,1:15:39.00,Default,,0,0,0,,كلّا، لمَ جعلت وكالة الشرطة الوطنية\Nالمفتش ساميتاني يحقق في ذلك؟
Dialogue: 10,1:15:39.29,1:15:42.08,Default,,0,0,0,,ذاك دافع المجرم حتمًا... أليس كذلك؟
Dialogue: 10,1:15:42.20,1:15:47.50,Default,,0,0,0,,للأمر علاقة بنظام المساومة القضائية\N.الذي توقف مداولته في البرلمان الحالي
Dialogue: 10,1:15:47.63,1:15:49.60,Default,,0,0,0,,ماذا يحدث في اليابان الآن؟
Dialogue: 10,1:15:50.25,1:15:52.51,Default,,0,0,0,,.لا داعي كي تعرف أكثر من ذلك
Dialogue: 10,1:15:53.13,1:15:55.85,Default,,0,0,0,,حتى رغم توصلي إلى هوية المجرم؟
Dialogue: 10,1:15:57.09,1:15:58.80,Default,,0,0,0,,!كونان-كن
Dialogue: 10,1:15:58.93,1:16:01.00,Default,,0,0,0,,عجبًا، أين ذهب يا ترى؟
Dialogue: 10,1:16:04.58,1:16:05.64,Default,,0,0,0,,ما الأمر؟
Dialogue: 10,1:16:05.77,1:16:08.27,Default,,0,0,0,,{\an8}...محال... جاءت رسالة من شينتشي
Dialogue: 10,1:16:18.41,1:16:21.80,Default,,0,0,0,,.أعتذر عن إزعاجك بالمجيء يا فوناكوبو إيزو-سان
Dialogue: 10,1:16:22.99,1:16:24.00,Default,,0,0,0,,.هذا أنت
Dialogue: 10,1:16:24.66,1:16:26.29,Default,,0,0,0,,لمَ نحن في مكان كهذا؟
Dialogue: 10,1:16:26.42,1:16:28.75,Default,,0,0,0,,...لأن واشيزو تاكاشي الذي تبحث عنه
Dialogue: 10,1:16:28.88,1:16:30.25,Default,,0,0,0,,.قد عُثر عليه
Dialogue: 10,1:16:30.38,1:16:31.65,Default,,0,0,0,,عُثر عليه؟
Dialogue: 10,1:16:31.88,1:16:33.42,Default,,0,0,0,,،زهرة ملفوف الظربان الشرقي البيضاء تلك
Dialogue: 10,1:16:33.55,1:16:36.50,Default,,0,0,0,,ألست من وضعها على قبر ماكي-سان؟
Dialogue: 10,1:16:39.69,1:16:40.73,Default,,0,0,0,,هذا الرجل؟
Dialogue: 10,1:16:41.22,1:16:42.64,Default,,0,0,0,,.أوتومو تاكاشي-سان
Dialogue: 10,1:16:42.77,1:16:45.68,Default,,0,0,0,,لديك كدمات على ذراعك اليسرى وكتفك، أليس كذلك؟
Dialogue: 10,1:16:47.02,1:16:48.08,Default,,0,0,0,,.اعذرني
Dialogue: 10,1:16:48.12,1:16:48.98,Default,,0,0,0,,.مهلًا
Dialogue: 10,1:16:49.73,1:16:52.90,Default,,0,0,0,,أليست هذه كدمات ناجمة عن ارتداد البندقية؟
Dialogue: 10,1:16:53.03,1:16:55.11,Default,,0,0,0,,.تحت إبطك الأيمن وعلى عضدك الأيسر
Dialogue: 10,1:16:55.49,1:16:57.59,Default,,0,0,0,,...كلّا، هذه من قطع الأشجار
Dialogue: 10,1:16:57.61,1:16:58.56,Default,,0,0,0,,.هكذا إذن
Dialogue: 10,1:16:58.99,1:17:03.20,Default,,0,0,0,,تمامًا مثل يو رانغ من دولة جين\N.حين طلى جسده بالطلاء وابتلع الفحم
Dialogue: 10,1:17:03.87,1:17:05.37,Default,,0,0,0,,!أيها المفتش موروفوشي
Dialogue: 10,1:17:05.50,1:17:06.99,Default,,0,0,0,,هل أُخرجت من المستشفى؟
Dialogue: 10,1:17:09.22,1:17:10.75,Default,,0,0,0,,يو رانغ من جين؟
Dialogue: 10,1:17:11.38,1:17:14.09,Default,,0,0,0,,."قصة من "سجلات المؤرخ الكبير، سيرة القتلة
Dialogue: 10,1:17:14.21,1:17:18.34,Default,,0,0,0,,...رجل يدعى يو رانغ طلى جسده كي يتظاهر بالمرض الجلدي
Dialogue: 10,1:17:18.47,1:17:23.59,Default,,0,0,0,,وابتلع الفحم كي يغير صوته\N.واختبأ كي لا تُعرف هويته
Dialogue: 10,1:17:24.01,1:17:25.57,Default,,0,0,0,,،باختصار يا أوتومو تاكاشي-سان
Dialogue: 10,1:17:25.89,1:17:30.00,Default,,0,0,0,,غيّرت وجهك واسمك مثله، أليس كذلك؟
Dialogue: 10,1:17:31.02,1:17:35.57,Default,,0,0,0,,وجدنا اسم واشيزو تاكاشي\N.في سجلات رخص الصيد في ناغانو
Dialogue: 10,1:17:35.69,1:17:40.00,Default,,0,0,0,,...أعرف ذلك، كان يملك رخصة صيد
Dialogue: 10,1:17:40.28,1:17:42.12,Default,,0,0,0,,واشيزو... تاكاشي؟
Dialogue: 10,1:17:42.24,1:17:47.41,Default,,0,0,0,,.أجل، تُبنّي واشيزو تاكاشي وغيّر كنيته إلى أوتومو
Dialogue: 10,1:17:47.54,1:17:49.58,Default,,0,0,0,,.عرفنا ذلك من فحص السجلات
Dialogue: 10,1:17:49.71,1:17:53.09,Default,,0,0,0,,!أنت! كنت قريبًا هكذا! كيف تجرؤ؟
Dialogue: 10,1:17:53.21,1:17:54.00,Default,,0,0,0,,.اهدأ
Dialogue: 10,1:17:54.01,1:17:54.84,Default,,0,0,0,,.أوتومو-سان
Dialogue: 10,1:17:54.96,1:17:58.55,Default,,0,0,0,,.حُكم عليك بالسجن مع وقف التنفيذ قبل 8 سنوات
Dialogue: 10,1:17:58.80,1:18:01.80,Default,,0,0,0,,...وبعد انتهاء السنوات الثلاث، تواريت عن الأنظار
Dialogue: 10,1:18:01.93,1:18:03.40,Default,,0,0,0,,.وعدت إلى ناغانو
Dialogue: 10,1:18:03.93,1:18:06.56,Default,,0,0,0,,.إلى الجبل حيث يوجد قبر ماكي-سان
Dialogue: 10,1:18:07.77,1:18:08.99,Default,,0,0,0,,.حكم مع وقف التنفيذ
Dialogue: 10,1:18:09.47,1:18:11.69,Default,,0,0,0,,،بسبب حصولي على حكم مخفف كهذا
Dialogue: 10,1:18:11.81,1:18:13.00,Default,,0,0,0,,...أقدمت ماكي-سان
Dialogue: 10,1:18:13.56,1:18:15.46,Default,,0,0,0,,.لم أستطع التحمل
Dialogue: 10,1:18:15.98,1:18:18.47,Default,,0,0,0,,،أردت الاعتذار إلى والديها
Dialogue: 10,1:18:19.20,1:18:22.00,Default,,0,0,0,,.لكنني افتقرت إلى الشجاعة
Dialogue: 10,1:18:22.95,1:18:26.41,Default,,0,0,0,,.شعرت أن عليّ الاعتذار أمام قبرها على الأقل
Dialogue: 10,1:18:26.54,1:18:27.60,Default,,0,0,0,,...هذا ما فكرت فيه
Dialogue: 10,1:18:28.20,1:18:29.41,Default,,0,0,0,,...لهذا وضعت الزهرة
Dialogue: 10,1:18:29.54,1:18:32.88,Default,,0,0,0,,،غيّرت وجهك واسمك، وتجنبت لقاء الناس
Dialogue: 10,1:18:33.00,1:18:34.71,Default,,0,0,0,,.وتسبق الجميع قبل ذكرى الوفاة
Dialogue: 10,1:18:34.84,1:18:39.17,Default,,0,0,0,,!أيعقل أنك بنيت كوخ الفحم هناك لهذا السبب؟
Dialogue: 10,1:18:39.30,1:18:42.72,Default,,0,0,0,,يوجد سبب لتسميته بوبا، أليس كذلك؟
Dialogue: 10,1:18:43.14,1:18:44.78,Default,,0,0,0,,.إنه لقبي
Dialogue: 10,1:18:45.30,1:18:46.27,Default,,0,0,0,,لقب؟
Dialogue: 10,1:18:46.97,1:18:49.94,Default,,0,0,0,,.لقب لا يعرفه سواي وميكوريا
Dialogue: 10,1:18:50.27,1:18:54.83,Default,,0,0,0,,.هكذا إذن، لهذا السبب أدرك ميكوريا وجودك في الجبل
Dialogue: 10,1:18:55.36,1:18:59.34,Default,,0,0,0,,.عثر المفتش ياماتو على ميكوريا وحدث الانهيار
Dialogue: 10,1:18:59.86,1:19:02.70,Default,,0,0,0,,.رأيت ذلك الانهيار أيضًا
Dialogue: 10,1:19:18.63,1:19:21.09,Default,,0,0,0,,...إذن، من أنقذ كان-تشان
Dialogue: 10,1:19:21.47,1:19:24.01,Default,,0,0,0,,أ-أنت! هل أنت بخير؟
Dialogue: 10,1:19:24.68,1:19:28.35,Default,,0,0,0,,وشيت بميكوريا في مساومة قضائية\N،وأعطوني حكمًا مع وقف التنفيد
Dialogue: 10,1:19:29.31,1:19:30.60,Default,,0,0,0,,.من الطبيعي أن يحقد عليّ
Dialogue: 10,1:19:31.00,1:19:36.29,Default,,0,0,0,,ألهذا السبب ستبقى تنتظر خروج\Nميكوريا من السجن كي يقتلك؟
Dialogue: 10,1:19:36.31,1:19:37.61,Default,,0,0,0,,!لن أسامحك
Dialogue: 10,1:19:38.23,1:19:39.22,Default,,0,0,0,,...أنا
Dialogue: 10,1:19:39.61,1:19:43.75,Default,,0,0,0,,!لن أسامحك أنت أو ميكوريا أبدًا
Dialogue: 10,1:19:45.32,1:19:46.22,Default,,0,0,0,,...لكن
Dialogue: 10,1:19:46.82,1:19:50.82,Default,,0,0,0,,!لكن لن أسمح بأن يقتلك ذلك الوغد
Dialogue: 10,1:19:51.95,1:19:53.00,Default,,0,0,0,,...أنا
Dialogue: 10,1:19:53.75,1:19:56.67,Default,,0,0,0,,!أنا من أراد قتلك
Dialogue: 10,1:19:57.39,1:20:00.92,Default,,0,0,0,,!طوال السنوات الثماني الماضية... طوال الوقت
Dialogue: 10,1:20:01.76,1:20:05.01,Default,,0,0,0,,!كانت هذه... كانت هذه حياتي طيلة 8 سنوات
Dialogue: 10,1:20:05.13,1:20:08.00,Default,,0,0,0,,ماذا عنك... كيف كانت سنواتك الثماني؟
Dialogue: 10,1:20:08.80,1:20:13.31,Default,,0,0,0,,!كيف عشت بعد قتل ماكي؟
Dialogue: 10,1:20:14.44,1:20:17.24,Default,,0,0,0,,بأيّ نية كنت تضع الزهور؟
Dialogue: 10,1:20:18.11,1:20:21.69,Default,,0,0,0,,!أخبرني عن تلك السنوات
Dialogue: 10,1:20:22.99,1:20:24.60,Default,,0,0,0,,!أعتذر
Dialogue: 10,1:20:25.78,1:20:27.65,Default,,0,0,0,,!أعتذر بشدة
Dialogue: 10,1:20:30.99,1:20:33.20,Default,,0,0,0,,!ها هما! ران-سان، كونان-كن
Dialogue: 10,1:20:33.70,1:20:37.25,Default,,0,0,0,,نظرًا لما حدث البارحة وعدم تمكننا\N،من الرصد في المخيم البارحة
Dialogue: 10,1:20:37.54,1:20:42.00,Default,,0,0,0,,.صنعت نجومًا بالليزر وجهزتها كي يرصدها الجميع
Dialogue: 10,1:20:42.59,1:20:45.93,Default,,0,0,0,,.قبل ذلك، سنعاين مسرح الجريمة هنا
Dialogue: 10,1:20:51.10,1:20:57.44,Default,,0,0,0,,سنبدأ الآن التحقيق في مسرح الجريمة\N.المتعلق بمقتل المفتش ساميتاني والمفتش ياماتو
Dialogue: 10,1:20:57.76,1:21:00.61,Default,,0,0,0,,مقتل؟ لمَ هنا؟
Dialogue: 10,1:21:00.93,1:21:06.05,Default,,0,0,0,,هذا لأن جريمة القتل والهجوم على\N.الباحث هنا ارتكبهما الشخص ذاته
Dialogue: 10,1:21:07.07,1:21:08.95,Default,,0,0,0,,أليس كذلك؟
Dialogue: 10,1:21:10.07,1:21:12.45,Default,,0,0,0,,...كان تمساح عميلًا متخفيًا للأمن العام بلا شك
Dialogue: 10,1:21:12.58,1:21:14.70,Default,,0,0,0,,.لذا تورط في القضية
Dialogue: 10,1:21:15.12,1:21:17.29,Default,,0,0,0,,.ولا شكّ أن ذلك الشخص مثله
Dialogue: 10,1:21:21.71,1:21:23.30,Default,,0,0,0,,أليس كذلك يا عم؟
Dialogue: 10,1:21:23.42,1:21:25.23,Default,,0,0,0,,...مهلًا، وعدت ألّا تقول
Dialogue: 10,1:21:25.26,1:21:26.76,Default,,0,0,0,,.لا، لا بأس
Dialogue: 10,1:21:28.72,1:21:30.00,Default,,0,0,0,,...مساعد المفتش كازامي
Dialogue: 10,1:21:30.89,1:21:31.80,Default,,0,0,0,,...أنت
Dialogue: 10,1:21:31.93,1:21:32.70,Default,,0,0,0,,من هذا؟
Dialogue: 10,1:21:32.83,1:21:33.93,Default,,0,0,0,,.محقق من الأمن العام
Dialogue: 10,1:21:34.06,1:21:35.31,Default,,0,0,0,,.مساعد المفتش هاياشي
Dialogue: 10,1:21:35.43,1:21:38.77,Default,,0,0,0,,،بعد تعيينك في قسم الأمن في شرطة ياماناشي
Dialogue: 10,1:21:38.89,1:21:43.73,Default,,0,0,0,,جندك الأمن العام وعُيّنت عميلًا\N.متخفيًا في قسم الشرطة المجتمعية
Dialogue: 10,1:21:43.86,1:21:45.15,Default,,0,0,0,,...هذا صحيح، ولكن
Dialogue: 10,1:21:45.28,1:21:46.78,Default,,0,0,0,,،في ذلك الفرع
Dialogue: 10,1:21:46.90,1:21:51.01,Default,,0,0,0,,تتمتع بمنصب يخولك التخلص\N.من الأسلحة والمتفجرات المصادرة
Dialogue: 10,1:21:51.53,1:21:55.94,Default,,0,0,0,,سمعت من المفتش ياماتو أنه قبل بضع سنوات\N،على الطريق الوطني عند حدود المحافظة
Dialogue: 10,1:21:55.96,1:21:59.54,Default,,0,0,0,,.صُودر مسدس يستخدم رصاص البنادق
Dialogue: 10,1:22:00.12,1:22:02.00,Default,,0,0,0,,.يمكن إخفاؤه تحت الملابس هكذا
Dialogue: 10,1:22:02.58,1:22:04.00,Default,,0,0,0,,...وإن غطيته
Dialogue: 10,1:22:04.38,1:22:07.00,Default,,0,0,0,,.فيمكنك جعله يبدو كبندقية
Dialogue: 10,1:22:08.42,1:22:11.27,Default,,0,0,0,,هل قتلت تمساح بذلك السلاح؟
Dialogue: 10,1:22:12.09,1:22:13.18,Default,,0,0,0,,.هكذا إذن
Dialogue: 10,1:22:13.30,1:22:17.22,Default,,0,0,0,,.بعدها، تركت الدراجة عند مدخل قطار الأنفاق وهربت
Dialogue: 10,1:22:17.77,1:22:19.77,Default,,0,0,0,,...على ذكر الأمر، في ذلك الشارع
Dialogue: 10,1:22:19.89,1:22:22.26,Default,,0,0,0,,.يوجد مقر الشرطة ووكالة الشرطة الوطنية
Dialogue: 10,1:22:22.69,1:22:25.23,Default,,0,0,0,,.يستطيع ضابط شرطة الهروب إلى هناك
Dialogue: 10,1:22:25.76,1:22:29.84,Default,,0,0,0,,،رغم إغلاق الطرق فور تلقي إشارة الطوارئ
Dialogue: 10,1:22:30.36,1:22:33.66,Default,,0,0,0,,...لم نجد المجرم مهما بحثنا
Dialogue: 10,1:22:33.78,1:22:36.24,Default,,0,0,0,,.لأنه كان مندسًا بين فرق البحث
Dialogue: 10,1:22:36.99,1:22:41.00,Default,,0,0,0,,.وانقطاع إشارتي فورًا كان بسببك
Dialogue: 10,1:22:41.71,1:22:44.50,Default,,0,0,0,,...معرفة تردد طوارئ الشرطة
Dialogue: 10,1:22:44.63,1:22:46.63,Default,,0,0,0,,...وإيقافه بدقة
Dialogue: 10,1:22:46.75,1:22:48.41,Default,,0,0,0,,.أمر لا يتقنه إلّا شرطي
Dialogue: 10,1:22:48.84,1:22:50.79,Default,,0,0,0,,...كلّا، أنا حقًا
Dialogue: 10,1:22:50.82,1:22:51.51,Default,,0,0,0,,.تمساح
Dialogue: 10,1:22:52.72,1:22:56.51,Default,,0,0,0,,:حين التقيتك أول مرة، ألقيت عليك التحية قائلًا هذا
Dialogue: 10,1:22:56.97,1:22:59.39,Default,,0,0,0,,.سأعتمد عليك اليوم في قضية تمساح
Dialogue: 10,1:22:59.82,1:23:01.60,Default,,0,0,0,,إذن، أنت من شرطة العاصمة أيضًا؟
Dialogue: 10,1:23:01.73,1:23:04.82,Default,,0,0,0,,.لم تتساءل عن كلمة تمساح إطلاقًا
Dialogue: 10,1:23:05.65,1:23:07.00,Default,,0,0,0,,...بينما الآخرون
Dialogue: 10,1:23:07.40,1:23:09.86,Default,,0,0,0,,.إذن، سأعتمد عليكما في قضية تمساح
Dialogue: 10,1:23:09.99,1:23:10.65,Default,,0,0,0,,تمساح؟
Dialogue: 10,1:23:10.90,1:23:11.99,Default,,0,0,0,,تمساح؟
Dialogue: 10,1:23:12.36,1:23:13.23,Default,,0,0,0,,تمساح؟
Dialogue: 10,1:23:13.86,1:23:15.08,Default,,0,0,0,,ما قصده بتمساح؟
Dialogue: 10,1:23:15.24,1:23:16.03,Default,,0,0,0,,تمساح؟
Dialogue: 10,1:23:16.41,1:23:19.04,Default,,0,0,0,,.لم يفهم أحد اللقب الذي لا يعرفه غيري
Dialogue: 10,1:23:20.12,1:23:20.89,Default,,0,0,0,,...لكن
Dialogue: 10,1:23:21.21,1:23:23.04,Default,,0,0,0,,!ما بك يا تمساح؟! تمساح
Dialogue: 10,1:23:23.58,1:23:25.79,Default,,0,0,0,,أهذا صديقك تمساح؟
Dialogue: 10,1:23:25.92,1:23:29.00,Default,,0,0,0,,!هكذا إذن! لأنه المجرم الذي كان في الموقع
Dialogue: 10,1:23:29.13,1:23:30.07,Default,,0,0,0,,.أجل
Dialogue: 10,1:23:30.13,1:23:32.67,Default,,0,0,0,,.لهذا عرفت أن ساميتاني هو تمساح
Dialogue: 10,1:23:33.09,1:23:34.00,Default,,0,0,0,,أليس كذلك؟
Dialogue: 10,1:23:35.29,1:23:37.39,Default,,0,0,0,,.كل هذه أدلة ظرفية
Dialogue: 10,1:23:37.51,1:23:40.23,Default,,0,0,0,,...اتهامي بقتل شرطي بناءً عليها
Dialogue: 10,1:23:40.25,1:23:42.69,Default,,0,0,0,,.يبدو قفازك دافئًا
Dialogue: 10,1:23:43.69,1:23:45.00,Default,,0,0,0,,أهو من جلد الغزال يا ترى؟
Dialogue: 10,1:23:45.56,1:23:46.73,Default,,0,0,0,,...هـ-هذا
Dialogue: 10,1:23:46.86,1:23:50.32,Default,,0,0,0,,...بالمناسبة، من موقع الهجوم على الباحث هنا
Dialogue: 10,1:23:50.44,1:23:53.00,Default,,0,0,0,,.وجدنا آثار قفاز من جلد الغزال
Dialogue: 10,1:23:53.40,1:23:55.41,Default,,0,0,0,,،وعلى هذا المفتاح الذي سقط في موقع الجريمة
Dialogue: 10,1:23:55.53,1:23:57.60,Default,,0,0,0,,.وعلى سيارة الرصد المتنقلة أيضًا
Dialogue: 10,1:23:58.37,1:23:59.58,Default,,0,0,0,,...وهذه أيضًا
Dialogue: 10,1:23:59.70,1:24:03.12,Default,,0,0,0,,قطعة من قفاز المجرم الذي أطلق النار\N...على المفتش ياماتو والمحققة أويهارا
Dialogue: 10,1:24:03.25,1:24:06.63,Default,,0,0,0,,.علقت في فم غينتا-كن حين عضه
Dialogue: 10,1:24:07.51,1:24:08.71,Default,,0,0,0,,...نتيجة التحليل
Dialogue: 10,1:24:08.84,1:24:12.46,Default,,0,0,0,,.طابقت قفاز جلد الغزال للمجرم الذي اقتحم المكان
Dialogue: 10,1:24:12.59,1:24:13.88,Default,,0,0,0,,...بعبارة أخرى
Dialogue: 10,1:24:14.01,1:24:17.70,Default,,0,0,0,,.خلفت وراءك جبلًا من أدلة تُثبت أنك المجرم
Dialogue: 10,1:24:25.39,1:24:27.45,Default,,0,0,0,,."الحرب خدعة"
Dialogue: 10,1:24:28.77,1:24:30.11,Default,,0,0,0,,!مفتش ياماتو
Dialogue: 10,1:24:31.65,1:24:33.79,Default,,0,0,0,,ألا يقال هذا في مواقف كهذه؟
Dialogue: 10,1:24:34.32,1:24:35.54,Default,,0,0,0,,أليس كذلك يا كومي؟
Dialogue: 10,1:24:35.86,1:24:39.07,Default,,0,0,0,,."أجل، "أساس الحرب هو خداع العدو
Dialogue: 10,1:24:39.20,1:24:40.67,Default,,0,0,0,,.من أقوال سون تزو
Dialogue: 10,1:24:41.54,1:24:42.74,Default,,0,0,0,,.يا-سان
Dialogue: 10,1:24:42.87,1:24:44.96,Default,,0,0,0,,،حين رأيت الانهيار الذي أحدثته
Dialogue: 10,1:24:45.08,1:24:47.22,Default,,0,0,0,,...تذكرت بوضوح
Dialogue: 10,1:24:47.75,1:24:52.43,Default,,0,0,0,,.وجه من رأيته قبل 10 أشهر
Dialogue: 10,1:25:25.33,1:25:27.00,Default,,0,0,0,,!مفتش ياماتو
Dialogue: 10,1:25:27.33,1:25:29.21,Default,,0,0,0,,!مفتش ياماتو
Dialogue: 10,1:25:29.23,1:25:30.21,Default,,0,0,0,,!هنا
Dialogue: 10,1:25:32.38,1:25:33.77,Default,,0,0,0,,!مفتش ياماتو
Dialogue: 10,1:25:35.26,1:25:38.22,Default,,0,0,0,,.يبدو أنها مدخنة فرن الفحم
Dialogue: 10,1:25:38.64,1:25:40.26,Default,,0,0,0,,.أنقذني أوتومو-سان
Dialogue: 10,1:25:41.85,1:25:44.20,Default,,0,0,0,,!هذا مطمئن، سأطلب النجدة فورًا
Dialogue: 10,1:25:44.22,1:25:45.39,Default,,0,0,0,,.لا، انتظر
Dialogue: 10,1:25:45.52,1:25:46.98,Default,,0,0,0,,...عرفت كل شيء
Dialogue: 10,1:25:47.40,1:25:49.98,Default,,0,0,0,,،من رأيته قبل 10 أشهر
Dialogue: 10,1:25:50.10,1:25:53.60,Default,,0,0,0,,.ومن هاجمني أنا والمفتش ساميتاني
Dialogue: 10,1:25:54.32,1:25:55.73,Default,,0,0,0,,...وأخبرت
Dialogue: 10,1:25:56.11,1:26:00.11,Default,,0,0,0,,.أول شخص وجدنا بكل شيء
Dialogue: 10,1:26:00.86,1:26:01.99,Default,,0,0,0,,...فقال
Dialogue: 10,1:26:02.12,1:26:04.53,Default,,0,0,0,,...إن عُرف أن المفتش ياماتو حي
Dialogue: 10,1:26:04.66,1:26:08.50,Default,,0,0,0,,.فسيُستهدف مجددًا ويحوق الأذى بمن حوله
Dialogue: 10,1:26:09.00,1:26:13.25,Default,,0,0,0,,لهذا ادعيت الموت إلى أن قُبض\N.على مساعد المفتش هاياشي
Dialogue: 10,1:26:13.38,1:26:16.25,Default,,0,0,0,,.طلبنا من الأمن العام تدبير ذلك
Dialogue: 10,1:26:16.51,1:26:20.00,Default,,0,0,0,,.عضو جدير بالثقة من الأمن العام على عكسك
Dialogue: 10,1:26:21.55,1:26:23.17,Default,,0,0,0,,،قبل 10 أشهر
Dialogue: 10,1:26:23.60,1:26:27.77,Default,,0,0,0,,.من رآه المفتش ياماتو هو أنت يا مساعد المفتش هاياشي
Dialogue: 10,1:26:28.19,1:26:32.37,Default,,0,0,0,,.كنت تفتح هوائي تلك السيارة الضخم في ذلك الوقت
Dialogue: 10,1:26:33.19,1:26:34.83,Default,,0,0,0,,...سيارة الرصد المتنقلة
Dialogue: 10,1:26:35.36,1:26:38.41,Default,,0,0,0,,.وحاولت سرقتها مجددًا قبل أيام
Dialogue: 10,1:26:38.90,1:26:41.00,Default,,0,0,0,,.كي تكرر الشيء ذاته حتمًا
Dialogue: 10,1:26:41.82,1:26:45.38,Default,,0,0,0,,ماذا كنت تفعل في جبل ميتاكاراداكي الثلجي قبل 10 أشهر؟
Dialogue: 10,1:26:46.12,1:26:49.41,Default,,0,0,0,,.أغلب الظن أنه أمر سيوقعه المتاعب إن رآه أحد
Dialogue: 10,1:26:49.66,1:26:51.58,Default,,0,0,0,,!أجبني يا هاياشي
Dialogue: 10,1:26:52.50,1:26:54.54,Default,,0,0,0,,.استقبال إشارات الأقمار الصناعية
Dialogue: 10,1:26:55.09,1:26:58.85,Default,,0,0,0,,.وتحديدًا، إشارات أقمار جمع المعلومات اليابانية
Dialogue: 10,1:26:59.17,1:27:03.85,Default,,0,0,0,,وبالطبع، يشمل ذلك معلومات\N.الأقمار العسكرية الأمريكية الحليفة
Dialogue: 10,1:27:04.68,1:27:10.81,Default,,0,0,0,,أنت من هدد الحكومة اليابانية\Nبنشر تلك البيانات للعالم، أليس كذلك؟
Dialogue: 10,1:27:11.14,1:27:14.67,Default,,0,0,0,,إذن، هل كان هاسيبي-سان يبحث عن المجرم طوال الوقت؟
Dialogue: 10,1:27:15.02,1:27:18.00,Default,,0,0,0,,ألست مدعيًا عامًا مكلفًا بمقر التحقيق؟
Dialogue: 10,1:27:18.23,1:27:19.60,Default,,0,0,0,,.تأخرت في التعريف بنفسي
Dialogue: 10,1:27:20.00,1:27:24.11,Default,,0,0,0,,أنا هاسيبي من مركز استخبارات\N.الأقمار الصناعية التابع لمجلس الوزراء
Dialogue: 10,1:27:25.07,1:27:26.78,Default,,0,0,0,,...ألححت على المسؤول كورودا
Dialogue: 10,1:27:26.91,1:27:30.29,Default,,0,0,0,,.للمشاركة في التحقيق منتحلًا صفة مدعٍ عام
Dialogue: 10,1:27:30.91,1:27:34.33,Default,,0,0,0,,،هكذا إذن، بسبب تهديد كهذا للحكومة
Dialogue: 10,1:27:34.46,1:27:36.84,Default,,0,0,0,,.تحرّك مكتب الاستخبارات والأمن العام
Dialogue: 10,1:27:36.96,1:27:38.13,Default,,0,0,0,,مكتب الاستخبارات؟
Dialogue: 10,1:27:38.25,1:27:40.67,Default,,0,0,0,,.مكتب الاستخبارات والبحوث التابع لمجلس الوزراء
Dialogue: 10,1:27:40.80,1:27:44.68,Default,,0,0,0,,وكالة استخبارات تابعة لرئيس الوزراء مباشرة، أليس كذلك؟
Dialogue: 10,1:27:44.80,1:27:45.63,Default,,0,0,0,,.أجل
Dialogue: 10,1:27:46.05,1:27:50.02,Default,,0,0,0,,،حددت زمان ومكان استقبال البيانات المسربة
Dialogue: 10,1:27:50.14,1:27:53.69,Default,,0,0,0,,.وعرفت أنه جبل ميتاكاراداكي قبل 10 أشهر
Dialogue: 10,1:27:53.81,1:27:57.02,Default,,0,0,0,,.وحقق المفتش ساميتاني في ملف تلك القضية
Dialogue: 10,1:27:57.15,1:27:59.45,Default,,0,0,0,,.أجل، بأمر من الأمن العام
Dialogue: 10,1:27:59.78,1:28:01.69,Default,,0,0,0,,،وأنت بصفتك عميلًا متخفيًا
Dialogue: 10,1:28:01.82,1:28:03.70,Default,,0,0,0,,أدركت ذلك، أليس كذلك؟
Dialogue: 10,1:28:06.81,1:28:11.10,Default,,0,0,0,,.عرفت أن المفتش ساميتاني زار ميكوريا في السجن
Dialogue: 10,1:28:13.96,1:28:17.29,Default,,0,0,0,,،لم يحذر مني لأنني عميل متخفي من الأمن العام مثله
Dialogue: 10,1:28:17.62,1:28:19.67,Default,,0,0,0,,.لذا أخبرني بكل شيء
Dialogue: 10,1:28:19.80,1:28:21.80,Default,,0,0,0,,،حين أراد مقابلة المفتش ياماتو
Dialogue: 10,1:28:22.13,1:28:24.81,Default,,0,0,0,,،أخبرته أنني كنت أعتني بالمفتش
Dialogue: 10,1:28:25.13,1:28:29.30,Default,,0,0,0,,.وأن هذا المفتش فقد ذاكرته الآن حول تلك الفترة
Dialogue: 10,1:28:29.99,1:28:30.89,Default,,0,0,0,,...لهذا السبب
Dialogue: 10,1:28:31.01,1:28:34.51,Default,,0,0,0,,...عاد المفتش ساميتاني لطوكيو دون مقابلة المفتش ياماتو
Dialogue: 10,1:28:35.23,1:28:36.81,Default,,0,0,0,,.لكنك قتلت تمساح
Dialogue: 10,1:28:37.40,1:28:40.00,Default,,0,0,0,,.لتسكته عن التحقيق في هذا
Dialogue: 10,1:28:40.73,1:28:44.90,Default,,0,0,0,,،لذلك تواصلت معي حين كُلّفت بالتحقيق
Dialogue: 10,1:28:45.03,1:28:46.66,Default,,0,0,0,,.وانصعت لأوامري بكل طواعية
Dialogue: 10,1:28:47.22,1:28:52.65,Default,,0,0,0,,وكان ذهابك معنا إلى السجن لمراقبتنا، أليس كذلك؟
Dialogue: 10,1:28:53.37,1:28:59.00,Default,,0,0,0,,.كان ذهابي مفيدًا إذ عرفت أنك بدأت تتذكر شيئًا
Dialogue: 10,1:28:59.84,1:29:02.05,Default,,0,0,0,,،لهذا أطلقت النار على المفتش ياماتو
Dialogue: 10,1:29:02.17,1:29:06.15,Default,,0,0,0,,!وحين فشلت، حاولت قتله بالانهيار الثلجي
Dialogue: 10,1:29:23.19,1:29:24.57,Default,,0,0,0,,لمَ عساك تبالغ هكذا؟
Dialogue: 10,1:29:25.24,1:29:28.57,Default,,0,0,0,,...لا شكّ أن السبب يعود لأنك
Dialogue: 10,1:29:29.07,1:29:31.50,Default,,0,0,0,,.حبيب ماكي-سان التي انتحرت
Dialogue: 10,1:29:33.45,1:29:36.21,Default,,0,0,0,,.هذا ما كتبه شينتشي ني-تشان في رسالته
Dialogue: 10,1:29:37.75,1:29:41.39,Default,,0,0,0,,.انتحرت ماكي بسبب ميكوريا وواشيزو
Dialogue: 10,1:29:41.92,1:29:43.00,Default,,0,0,0,,،ورغم ذلك
Dialogue: 10,1:29:43.25,1:29:46.73,Default,,0,0,0,,حصل واشيزو على حكم مع وقف\N.التنفيذ بفضل المساومة القضائية
Dialogue: 10,1:29:47.26,1:29:48.30,Default,,0,0,0,,وماذا في ذلك؟
Dialogue: 10,1:29:48.56,1:29:50.00,Default,,0,0,0,,.أنت ضابط شرطة
Dialogue: 10,1:29:51.13,1:29:53.57,Default,,0,0,0,,.لأنني ضابط شرطة... تحمّلت
Dialogue: 10,1:29:54.10,1:29:56.24,Default,,0,0,0,,.لكن واشيزو توارى عن الأنظار
Dialogue: 10,1:29:56.77,1:29:59.20,Default,,0,0,0,,!غيّر اسمه ووجهه بخسة
Dialogue: 10,1:30:00.52,1:30:02.61,Default,,0,0,0,,...تحمّلت... وتحمّلت
Dialogue: 10,1:30:03.57,1:30:05.40,Default,,0,0,0,,،مع نظام المساومات القضائية الجديد
Dialogue: 10,1:30:05.53,1:30:08.75,Default,,0,0,0,,.سيزداد المجرمون أمثال واشيزو
Dialogue: 10,1:30:10.11,1:30:13.00,Default,,0,0,0,,.وكذلك الضحايا... مثل ماكي
Dialogue: 10,1:30:19.62,1:30:22.95,Default,,0,0,0,,!طفح كيلي! لن أتحمّل أكثر
Dialogue: 10,1:30:23.38,1:30:25.22,Default,,0,0,0,,!يجب التكفير عن الذنوب
Dialogue: 10,1:30:25.50,1:30:29.93,Default,,0,0,0,,!تخفيف العقوبة مقابل الوشاية بالآخرين أمر لا يغتفر أبدًا
Dialogue: 10,1:30:30.27,1:30:31.93,Default,,0,0,0,,!لا يجب أن يحدث أبدًا
Dialogue: 10,1:30:32.55,1:30:34.56,Default,,0,0,0,,.لا أزال أملك بيانات الأقمار الصناعية
Dialogue: 10,1:30:35.22,1:30:37.02,Default,,0,0,0,,!لا يزال بإمكاني تهديد الحكومة
Dialogue: 10,1:30:46.32,1:30:47.40,Default,,0,0,0,,!انتظر عندك
Dialogue: 10,1:30:54.41,1:30:55.25,Default,,0,0,0,,!توقف
Dialogue: 10,1:31:02.25,1:31:04.06,Default,,0,0,0,,!ينوي الهرب بسيارة الرصد المتنقلة
Dialogue: 10,1:31:09.46,1:31:11.38,Default,,0,0,0,,...تبًّا، سيارة الرصد
Dialogue: 10,1:31:26.98,1:31:27.77,Default,,0,0,0,,!احذروا
Dialogue: 10,1:31:28.44,1:31:29.57,Default,,0,0,0,,!تراجعوا أنتم أيضًا
Dialogue: 10,1:31:35.62,1:31:37.37,Default,,0,0,0,,!ارفع يديك واخرج
Dialogue: 10,1:31:40.66,1:31:42.00,Default,,0,0,0,,!توقفي يا أويهارا
Dialogue: 10,1:31:59.97,1:32:01.28,Default,,0,0,0,,!أبي
Dialogue: 10,1:32:02.31,1:32:05.22,Default,,0,0,0,,!ران، اركبي سيارة المحققين تلك
Dialogue: 10,1:32:05.99,1:32:06.90,Default,,0,0,0,,...لكن
Dialogue: 10,1:32:06.91,1:32:08.11,Default,,0,0,0,,.سآتي لأخذك حين أنتهي
Dialogue: 10,1:32:11.78,1:32:14.77,Default,,0,0,0,,أوتشي-سينسي، هل يمكنك تغيير اتجاه الليزر؟
Dialogue: 10,1:32:16.70,1:32:18.30,Default,,0,0,0,,!اقطع طريقه به
Dialogue: 10,1:32:19.28,1:32:20.25,Default,,0,0,0,,!بسرعة
Dialogue: 10,1:32:20.25,1:32:21.15,Default,,0,0,0,,!حـ-حاضر
Dialogue: 10,1:32:23.29,1:32:24.71,Default,,0,0,0,,!موري-سان
Dialogue: 10,1:32:24.87,1:32:25.75,Default,,0,0,0,,.انطلق
Dialogue: 10,1:32:26.17,1:32:28.50,Default,,0,0,0,,.خذني إليه أيضًا
Dialogue: 10,1:32:28.79,1:32:31.71,Default,,0,0,0,,.سمعت صوتًا قويًا
Dialogue: 10,1:32:31.84,1:32:33.26,Default,,0,0,0,,ما هو يا ترى؟
Dialogue: 10,1:32:33.78,1:32:35.05,Default,,0,0,0,,!أستاذ أوتشي
Dialogue: 10,1:32:35.98,1:32:40.49,Default,,0,0,0,,.هذا مطمئن، طلب مني كونان-كن تحريك الليزر
Dialogue: 10,1:32:41.01,1:32:43.00,Default,,0,0,0,,هل يمكنك مساعدتي؟
Dialogue: 10,1:32:43.31,1:32:45.00,Default,,0,0,0,,...لكنني
Dialogue: 10,1:32:47.27,1:32:48.61,Default,,0,0,0,,.سأفعلها أنا
Dialogue: 10,1:33:05.12,1:33:06.17,Default,,0,0,0,,!لا تطلق النار
Dialogue: 10,1:33:06.20,1:33:07.55,Default,,0,0,0,,!أويهارا معه
Dialogue: 10,1:33:13.09,1:33:14.00,Default,,0,0,0,,!تبًّا
Dialogue: 10,1:34:02.01,1:34:04.06,Default,,0,0,0,,!هايبارا، أتسمعينني؟ هايبارا
Dialogue: 10,1:34:04.97,1:34:06.81,Default,,0,0,0,,إيدوغاوا-كن! هل أنت بخير؟
Dialogue: 10,1:34:06.93,1:34:07.81,Default,,0,0,0,,.أنا بخير
Dialogue: 10,1:34:08.23,1:34:10.69,Default,,0,0,0,,.وجّهي الليزر نحو الزجاج الأمامي لسيارة المجرم
Dialogue: 10,1:34:10.81,1:34:11.81,Default,,0,0,0,,!أرجوكِ يا هايبارا
Dialogue: 10,1:34:12.81,1:34:15.15,Default,,0,0,0,,!يا إلهي، ما باليد حيلة
Dialogue: 10,1:34:15.73,1:34:18.00,Default,,0,0,0,,ماذا يفعل كونان؟
Dialogue: 10,1:34:18.40,1:34:20.57,Default,,0,0,0,,.دع آي-كن تركز
Dialogue: 10,1:34:32.25,1:34:33.00,Default,,0,0,0,,!انطلق
Dialogue: 10,1:34:43.93,1:34:45.00,Default,,0,0,0,,ما هذا؟
Dialogue: 10,1:34:52.15,1:34:53.60,Default,,0,0,0,,.لن يصل هكذا
Dialogue: 10,1:34:54.02,1:34:55.36,Default,,0,0,0,,ألا ينخفض أكثر؟
Dialogue: 10,1:34:55.48,1:34:57.33,Default,,0,0,0,,!هذه أقصى زاوية
Dialogue: 10,1:34:57.86,1:35:00.01,Default,,0,0,0,,!إنه جهاز يُوّجه إلى السماء أصلًا
Dialogue: 10,1:35:16.25,1:35:18.46,Default,,0,0,0,,...إذا عرفت الأرض وعرفت السماء
Dialogue: 10,1:35:18.59,1:35:21.26,Default,,0,0,0,,.نلت نصرًا تام الأركان
Dialogue: 10,1:35:22.05,1:35:24.39,Default,,0,0,0,,...إن أحطت بالتضاريس والطقس"
Dialogue: 10,1:35:24.51,1:35:26.14,Default,,0,0,0,,".فالنصر راسخ لا يتزعزع
Dialogue: 10,1:35:26.21,1:35:27.54,Default,,0,0,0,,...هذا من أقوال سون تزو
Dialogue: 10,1:35:29.85,1:35:31.27,Default,,0,0,0,,!كونان-كن
Dialogue: 10,1:35:31.39,1:35:32.72,Default,,0,0,0,,.أنتِ، هذا خطر
Dialogue: 10,1:35:32.74,1:35:33.52,Default,,0,0,0,,.كونان-كن
Dialogue: 10,1:35:33.77,1:35:35.77,Default,,0,0,0,,!استخدم التضاريس والطقس
Dialogue: 10,1:35:38.32,1:35:39.82,Default,,0,0,0,,التضاريس والطقس؟
Dialogue: 10,1:35:42.28,1:35:43.13,Default,,0,0,0,,.هايبارا
Dialogue: 10,1:35:43.66,1:35:46.00,Default,,0,0,0,,!وجّهي الليزر نحو أكبر طبق
Dialogue: 10,1:35:46.24,1:35:47.83,Default,,0,0,0,,...مستحيل أن
Dialogue: 10,1:35:47.95,1:35:51.00,Default,,0,0,0,,.لنخفض طبق التلسكوب لأقصى حد
Dialogue: 10,1:35:52.01,1:35:53.00,Default,,0,0,0,,...هايبارا-سان
Dialogue: 10,1:35:55.33,1:35:56.38,Default,,0,0,0,,.سأحاول
Dialogue: 10,1:35:59.71,1:36:01.26,Default,,0,0,0,,.أعتمد عليكِ يا هايبارا
Dialogue: 10,1:36:08.04,1:36:09.52,Default,,0,0,0,,هل يمكنك استهداف وحدة الطاقة؟
Dialogue: 10,1:36:29.87,1:36:31.25,Default,,0,0,0,,!هاياشي! توقف
Dialogue: 10,1:36:33.08,1:36:34.30,Default,,0,0,0,,...فعل هذا لن يفيد
Dialogue: 10,1:36:34.30,1:36:35.20,Default,,0,0,0,,!اخرسي
Dialogue: 10,1:36:37.08,1:36:38.38,Default,,0,0,0,,!لن تفهمي
Dialogue: 10,1:36:38.88,1:36:40.28,Default,,0,0,0,,...يستحيل أن تفهمي
Dialogue: 10,1:36:40.50,1:36:41.97,Default,,0,0,0,,!عزمي
Dialogue: 10,1:36:43.30,1:36:44.52,Default,,0,0,0,,!فات الأوان
Dialogue: 10,1:36:45.51,1:36:46.92,Default,,0,0,0,,!فات الأوان
Dialogue: 10,1:36:48.34,1:36:50.48,Default,,0,0,0,,،رحلت ماكي عن هذا العالم
Dialogue: 10,1:36:51.56,1:36:54.00,Default,,0,0,0,,.وما بقي أمامي سبيل آخر
Dialogue: 10,1:36:55.10,1:36:57.59,Default,,0,0,0,,لو كنتِ مكاني، ماذا كنت ستفعلين؟
Dialogue: 10,1:36:59.27,1:37:01.22,Default,,0,0,0,,!أجيبي
Dialogue: 10,1:37:06.20,1:37:07.25,Default,,0,0,0,,!أويهارا
Dialogue: 10,1:37:08.70,1:37:09.71,Default,,0,0,0,,!يوي
Dialogue: 10,1:37:10.70,1:37:13.66,Default,,0,0,0,,!يوي
Dialogue: 10,1:37:14.66,1:37:15.41,Default,,0,0,0,,!تعالي
Dialogue: 10,1:37:32.01,1:37:33.00,Default,,0,0,0,,!تبًّا
Dialogue: 10,1:37:33.35,1:37:35.06,Default,,0,0,0,,!مهـ... موري-سان
Dialogue: 10,1:37:37.14,1:37:39.56,Default,,0,0,0,,.قل إنك من أطلق النار
Dialogue: 10,1:37:45.57,1:37:48.45,Default,,0,0,0,,كومي! ماذا تفعل؟
Dialogue: 10,1:37:55.83,1:37:57.41,Default,,0,0,0,,!إيدوغاوا-كن
Dialogue: 10,1:38:18.64,1:38:21.19,Default,,0,0,0,,...هذه المرة
Dialogue: 10,1:38:21.31,1:38:22.80,Default,,0,0,0,,!لن أدعك تفلت مني حتمًا
Dialogue: 10,1:39:24.13,1:39:26.71,Default,,0,0,0,,...تخلى عني الحظ أيضًا
Dialogue: 10,1:39:27.13,1:39:30.72,Default,,0,0,0,,.كلّا، ما ينقصك ليس الحظ
Dialogue: 10,1:39:32.01,1:39:36.16,Default,,0,0,0,,ألم تجبر على حفظها أيضًا في أكاديمية الشرطة؟
Dialogue: 10,1:39:37.01,1:39:39.97,Default,,0,0,0,,.أخلاقيات المهنة لموظفي الشرطة
Dialogue: 10,1:39:42.48,1:39:47.15,Default,,0,0,0,,...أن أخدم الدولة والمواطنين بفخرٍ واستشعارٍ للمسؤولية
Dialogue: 10,1:39:47.27,1:39:49.21,Default,,0,0,0,,...وألّا أقع أسير الخوف أو الكراهية
Dialogue: 10,1:39:49.73,1:39:52.74,Default,,0,0,0,,...وأن أحترم حقوق الإنسان في شتى الظروف
Dialogue: 10,1:39:53.28,1:39:56.01,Default,,0,0,0,,!وأن أؤدي واجباتي بكل نزاهة
Dialogue: 10,1:39:57.87,1:39:59.12,Default,,0,0,0,,أليس كذلك؟
Dialogue: 10,1:40:00.70,1:40:02.71,Default,,0,0,0,,...حتى والد ماكي-سان من حقد على قاتلها
Dialogue: 10,1:40:02.83,1:40:05.79,Default,,0,0,0,,،وأقسم ألّا يغفر له أبدًا
Dialogue: 10,1:40:05.92,1:40:09.03,Default,,0,0,0,,.حاول جاهدًا كي يصفح عنه في النهاية
Dialogue: 10,1:40:09.75,1:40:12.62,Default,,0,0,0,,.أن يصفح عمّن ساق ابنته إلى الموت
Dialogue: 10,1:40:13.05,1:40:15.00,Default,,0,0,0,,.مع أنه ليس شرطيًا
Dialogue: 10,1:40:15.89,1:40:18.22,Default,,0,0,0,,،ما افتقرت إليه هو تلك الشجاعة
Dialogue: 10,1:40:18.64,1:40:20.26,Default,,0,0,0,,.وليس الحظ
Dialogue: 10,1:40:25.69,1:40:26.94,Default,,0,0,0,,.يا إلهي
Dialogue: 10,1:40:27.10,1:40:29.00,Default,,0,0,0,,.أخبرتك أن هذا ليس لعبًا
Dialogue: 10,1:40:29.44,1:40:31.20,Default,,0,0,0,,.اترك الأمر للكبار
Dialogue: 10,1:40:31.53,1:40:32.55,Default,,0,0,0,,.آسف
Dialogue: 10,1:40:37.95,1:40:38.70,Default,,0,0,0,,...قل لي
Dialogue: 10,1:40:39.45,1:40:43.30,Default,,0,0,0,,كنت من أوقف الانهيار الثلجي\Nفي ذلك الوقت، أليس كذلك يا عمي؟
Dialogue: 10,1:40:45.71,1:40:48.33,Default,,0,0,0,,.غبي، هذا مستحيل
Dialogue: 10,1:40:58.14,1:41:01.37,Default,,0,0,0,,هل رأيت ذلك يا تمساح؟
Dialogue: 10,1:44:51.24,1:44:54.99,Default,,0,0,0,,...في هذه القضية، قتلت ضابط شرطة
Dialogue: 10,1:44:55.29,1:44:59.41,Default,,0,0,0,,،وفضلًا عما اقترفته من جرائم\N.فإن احتمال تلقيك لحكم الإعدام مرتفع
Dialogue: 10,1:45:00.04,1:45:01.42,Default,,0,0,0,,من أنت؟
Dialogue: 10,1:45:02.05,1:45:03.98,Default,,0,0,0,,.هنا يأتي دور المساومة القضائية
Dialogue: 10,1:45:04.51,1:45:07.47,Default,,0,0,0,,...في حال لم تذكر اسم الأمن العام في المحكمة
Dialogue: 10,1:45:07.84,1:45:12.94,Default,,0,0,0,,.فسأوجه الادعاء لطلب السجن المؤبد بدلًا من الإعدام
Dialogue: 10,1:45:13.47,1:45:15.00,Default,,0,0,0,,أنت من الأمن العام أيضًا؟
Dialogue: 10,1:45:15.81,1:45:17.00,Default,,0,0,0,,.أرفض
Dialogue: 10,1:45:17.44,1:45:21.41,Default,,0,0,0,,.سأفضح جرائم هذه الدولة في المحكمة
Dialogue: 10,1:45:21.73,1:45:28.28,Default,,0,0,0,,حينها، سيعرف الجميع أنك\N.كنت حبيب فوناكوبو ماكي-سان
Dialogue: 10,1:45:28.41,1:45:30.49,Default,,0,0,0,,...دعك من الفتاة التي انتحرت
Dialogue: 10,1:45:30.62,1:45:33.99,Default,,0,0,0,,وقل لي بأيّ عينٍ سينظر المجتمع إلى والدها؟
Dialogue: 10,1:45:34.12,1:45:35.00,Default,,0,0,0,,!أنت
Dialogue: 10,1:45:35.12,1:45:37.75,Default,,0,0,0,,.والآن، اختر ما يحلو لك
Dialogue: 10,1:45:37.87,1:45:40.88,Default,,0,0,0,,!يا للقذارة! أهذا أسلوبكم؟
Dialogue: 10,1:45:41.00,1:45:45.78,Default,,0,0,0,,أجل، هذا أسلوب الأمن العام\N.الذي كنت تنتمي إليه طوال هذا الوقت
Dialogue: 10,1:45:46.26,1:45:48.09,Default,,0,0,0,,أما كنت تعلم بذلك؟
Dialogue: 10,1:46:06.03,1:46:09.00,Default,,0,0,0,,،بخصوص إطلاق موري كوغورو للنار بالمسدس
Dialogue: 10,1:46:09.49,1:46:12.00,Default,,0,0,0,,.دبرنا الأمر كي لا يسبب مشكلة
Dialogue: 10,1:46:13.12,1:46:15.99,Default,,0,0,0,,،وبخصوص المفتش موروفوشي
Dialogue: 10,1:46:16.41,1:46:21.67,Default,,0,0,0,,.تمتم باسم "هيروميتسو" عند إنقاذه من الشلال
Dialogue: 10,1:46:23.42,1:46:24.80,Default,,0,0,0,,.هيرو... ميتسو
Dialogue: 10,1:46:25.34,1:46:28.67,Default,,0,0,0,,...أذكر أن أحد زملاء فورويا-سان
Dialogue: 10,1:46:28.80,1:46:32.00,Default,,0,0,0,,.كان يدعى موروفوشي هيروميتسو
Dialogue: 10,1:46:34.93,1:46:37.98,Default,,0,0,0,,...وأخيرًا، استؤنفت مداولات تعديل قانون الإجراءات الجنائية
Dialogue: 10,1:46:38.10,1:46:42.06,Default,,0,0,0,,."والذي يتضمن نظامًا جديدًا لـ"المساومة القضائية
Dialogue: 10,1:46:42.19,1:46:43.27,Default,,0,0,0,,...وبناءً على ذلك
Dialogue: 10,1:46:44.32,1:46:46.53,Default,,0,0,0,,.وجدت جهاز التحكم إذن
Dialogue: 10,1:46:46.86,1:46:49.52,Default,,0,0,0,,...أجل، ولكن لست من وجده
Dialogue: 10,1:46:49.95,1:46:51.61,Default,,0,0,0,,بالمناسبة، أين العم؟
Dialogue: 10,1:46:52.03,1:46:53.00,Default,,0,0,0,,.توتوري
Dialogue: 10,1:46:53.41,1:46:54.53,Default,,0,0,0,,توتوري؟
Dialogue: 10,1:46:54.70,1:46:58.09,Default,,0,0,0,,.أجل، قال إنه سيدفن رفات تمساح أخيرًا
Dialogue: 10,1:46:58.41,1:47:01.22,Default,,0,0,0,,...إذن، مسقط رأس المفتش ساميتاني
Dialogue: 10,1:47:01.54,1:47:02.80,Default,,0,0,0,,.يبدو كذلك
Dialogue: 10,1:47:08.67,1:47:10.67,Default,,0,0,0,,!يا إلهي، يا لك من متهور
Dialogue: 10,1:47:11.22,1:47:14.55,Default,,0,0,0,,.هربت من المستشفى بالقوة في ذلك الوقت
Dialogue: 10,1:47:14.97,1:47:16.96,Default,,0,0,0,,.أنت مثلي تمامًا
Dialogue: 10,1:47:17.56,1:47:20.76,Default,,0,0,0,,،وفي بادئ الأمر، تظاهري بالموت
Dialogue: 10,1:47:20.81,1:47:23.40,Default,,0,0,0,,أكنت تجهله يا كومي؟
Dialogue: 10,1:47:23.52,1:47:25.15,Default,,0,0,0,,.أجل، تمامًا
Dialogue: 10,1:47:25.27,1:47:28.36,Default,,0,0,0,,.إذن، اذرف دمعة على الأقل
Dialogue: 10,1:47:28.48,1:47:33.36,Default,,0,0,0,,.في الواقع، ذُهلت لفكرة أن الموت وارد لرجل مثلك
Dialogue: 10,1:47:33.78,1:47:37.00,Default,,0,0,0,,...أنا علمت بالأمر من كونان-كن
Dialogue: 10,1:47:37.66,1:47:38.79,Default,,0,0,0,,.صحيح
Dialogue: 10,1:47:38.91,1:47:41.20,Default,,0,0,0,,...لمَ أخبر ذلك الفتى أويهارا
Dialogue: 10,1:47:41.33,1:47:43.83,Default,,0,0,0,,ولم يخبر كومي؟
Dialogue: 10,1:47:45.56,1:47:47.54,Default,,0,0,0,,...أغلب الظن أن ذلك الفتى
Dialogue: 10,1:47:48.34,1:47:51.26,Default,,0,0,0,,.لم يرد أن يحزنها
Dialogue: 10,1:47:52.13,1:47:54.55,Default,,0,0,0,,...هذا أسلوبه الخاص في فعل الأمور
Dialogue: 10,1:47:55.05,1:47:59.21,Default,,0,0,0,,.والمختلف عنا و المختلف حتمًا عن الأمن العام
Dialogue: 10,1:47:59.93,1:48:01.68,Default,,0,0,0,,.لا أفهم شيئًا
Dialogue: 10,1:48:02.06,1:48:03.06,Default,,0,0,0,,،وبالأحرى يا أويهارا
Dialogue: 10,1:48:03.39,1:48:06.61,Default,,0,0,0,,.بما أنكِ كنتِ تعلمين، فما فعلته كان مبالغًا فيه
Dialogue: 10,1:48:07.15,1:48:08.17,Default,,0,0,0,,...كان-تشان
Dialogue: 10,1:48:08.73,1:48:10.77,Default,,0,0,0,,!كان-تشان
Dialogue: 10,1:48:15.53,1:48:18.03,Default,,0,0,0,,!مهلًا مهلًا! هذا بكاء مبالغ فيه
Dialogue: 10,1:48:18.16,1:48:20.89,Default,,0,0,0,,!سينكشف الأمر! سينكشف الأمر! سينكشف حتمًا
Dialogue: 10,1:48:21.31,1:48:23.83,Default,,0,0,0,,.كانت تمثيلية مبالغًا فيها
Dialogue: 10,1:48:23.96,1:48:26.43,Default,,0,0,0,,.لم أبالغ فيها أو ما شابه
Dialogue: 10,1:48:27.04,1:48:32.00,Default,,0,0,0,,أيّ غبي سيبكي هكذا أمام الجميع لموت زميل عادي؟
Dialogue: 10,1:48:32.59,1:48:34.00,Default,,0,0,0,,...زميل عادي
Dialogue: 10,1:48:34.63,1:48:36.00,Default,,0,0,0,,وإن لم يكن كذلك؟
Dialogue: 10,1:49:07.71,1:49:09.79,Default,,0,0,0,,.إلهة... الرياح
Dialogue: 10,1:49:10.21,1:49:13.46,Default,,0,0,0,,.ليست إلهة، بل قرصانة
Dialogue: 10,1:49:13.96,1:49:15.33,Default,,0,0,0,,.اخرس
