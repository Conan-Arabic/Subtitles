Dialogue: 0,1:19:16.95,1:19:20.79,Default 2,,0,0,0,,"أفضل موقع لاستهداف "تشيغوسا
Dialogue: 0,1:19:23.25,1:19:24.54,Default 2,,0,0,0,,اللعبة من نصيبي
Dialogue: 0,1:19:28.25,1:19:29.96,Flashback - نسخة,,0,0,0,,أ-أنت
