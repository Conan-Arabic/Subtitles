Dialogue: 0,1:23:32.33,1:23:32.91,DCMain,,0,0,0,,!ماذا؟
Dialogue: 0,1:23:32.94,1:23:33.84,DCMain,,0,0,0,,!ماذا؟
Dialogue: 0,1:23:34.33,1:23:36.35,DCMain,,0,0,0,,!نفذوا كلامي بسرعة
