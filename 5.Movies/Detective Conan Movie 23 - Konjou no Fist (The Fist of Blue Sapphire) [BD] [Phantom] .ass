Dialogue: 0,1:47:12.73,1:47:14.74,Default,,0,0,0,,...لكن ألا تُمانعين حقّاً
Dialogue: 0,1:47:14.74,1:47:18.43,Default,,0,0,0,,السّماح لحبيبكِ القويّ بجُنونٍ بالذّهاب إلى الوِلايات المُتّحدة الأمريكيّة ثانيةً؟
Dialogue: 0,1:47:18.43,1:47:19.74,Default,,0,0,0,,!لا بأس! لا بأس
Dialogue: 0,1:47:19.74,1:47:23.24,Default,,0,0,0,,على ماكوتو سان أن يُقاتِل في مكانٍ ما بالفِعل، صحيح؟
Dialogue: 0,1:47:24.75,1:47:26.69,Default,,0,0,0,,!أوه، لَقد خرَجوا
Dialogue: 0,1:47:26.69,1:47:28.25,Default,,0,0,0,,...هاي\Nما ذلك؟
Dialogue: 0,1:47:28.25,1:47:30.96,Default,,0,0,0,,...هيّا الآن\N.لا تتعلّقي بي بهذه القوّة
Dialogue: 0,1:47:30.96,1:47:32.15,Default,,0,0,0,,ألا يُصعّب هذا السّير؟
Dialogue: 0,1:47:32.15,1:47:35.24,Default,,0,0,0,,.مُستحيل\N.لَن أُفلتكَ ثانيةً أبداً
Dialogue: 0,1:47:35.24,1:47:36.42,Default,,0,0,0,,أوه، حقّاً؟
Dialogue: 0,1:47:38.07,1:47:40.64,Default,,0,0,0,,...كنتُ أنتظر طوال هذا الوَقت
Dialogue: 0,1:47:40.64,1:47:41.81,Default,,0,0,0,,.هذه اللّحظة
Dialogue: 0,1:47:41.81,1:47:42.26,Default,,0,0,0,,هاه؟
Dialogue: 0,1:47:43.39,1:47:45.39,Default,,0,0,0,,!كيد\N!كنّا بانتظارك
Dialogue: 0,1:47:45.39,1:47:46.75,Default,,0,0,0,,...ماذا\N!هل أنتَ جادّ؟
Dialogue: 0,1:47:46.75,1:47:50.25,Default,,0,0,0,,!أمكنني مَعرفة بأنّكَ لَم تكُن شينتشي منذ البداية
Dialogue: 0,1:47:50.25,1:47:51.27,Default,,0,0,0,,...كما ترى، شينتشي
Dialogue: 0,1:47:51.27,1:47:54.28,Default,,0,0,0,,!"لَن يفعل أبداً شيئاً كدعوَة أبي بـ"عمّي
Dialogue: 0,1:47:54.28,1:47:56.28,Default,,0,0,0,,!ماذا؟\N...لكنّه دائماً
Dialogue: 0,1:47:57.07,1:47:57.78,Default,,0,0,0,,...بالتّفكير بالأمر
Dialogue: 0,1:47:57.78,1:48:00.66,Default,,0,0,0,,لَم أدعه "عمّي" أمام ران أبداً، صحيح؟
Dialogue: 0,1:48:00.66,1:48:03.83,Default,,0,0,0,,!لَن أجعلكَ تُفلِت بتظاهركَ أنّكَ شينتشي لَيس لمرّةٍ فقط، بل لمرّتين
Dialogue: 0,1:48:03.83,1:48:06.66,Default,,0,0,0,,!أيّتها الشّابّة، أرجوكِ تأكّدي من ألّا تُفلِتي ذِراعه أبداً
Dialogue: 0,1:48:06.66,1:48:08.54,Default,,0,0,0,,!قيّدوه
Dialogue: 0,1:48:11.44,1:48:12.54,Default,,0,0,0,,!كيد
Dialogue: 0,1:48:12.54,1:48:14.80,Default,,0,0,0,,!أمسكوه
Dialogue: 0,1:48:14.80,1:48:17.05,Default,,0,0,0,,!لَن أُفلِتَ بالتّأكيد
Dialogue: 0,1:48:17.05,1:48:18.80,Default,,0,0,0,,!لا تسمحوا له بالهرَب
Dialogue: 0,1:48:19.88,1:48:20.81,Default,,0,0,0,,...بروفيسور
Dialogue: 0,1:48:27.83,1:48:29.31,Default,,0,0,0,,!هو لَيس هُنا
Dialogue: 0,1:48:32.02,1:48:34.36,Default,,0,0,0,,!أرغه\N!لَقد هرَب
Dialogue: 0,1:48:34.36,1:48:35.37,Default,,0,0,0,,!سُحقاً
Dialogue: 0,1:48:35.37,1:48:37.07,Default,,0,0,0,,!لابدّ من أنّه مازال قريباً
Dialogue: 0,1:48:37.07,1:48:39.03,Default,,0,0,0,,!إذهبوا خلفه
Dialogue: 0,1:48:44.10,1:48:45.56,Default,,0,0,0,,!كونان كن
Dialogue: 0,1:48:45.56,1:48:48.33,Default,,0,0,0,,.مرحباً بعودتك، ران نيتشان
Dialogue: 0,1:48:49.27,1:48:50.33,Default,,0,0,0,,!من الجيّد العودة
Dialogue: 0,1:48:51.65,1:48:53.33,Default,,0,0,0,,لَم تشعر بالوِحدة دوني، صحيح؟
Dialogue: 0,1:48:53.86,1:48:55.40,Default,,0,0,0,,...أيّتها الغبيّة
Dialogue: 0,1:48:55.40,1:49:00.68,Default,,0,0,0,,.كنّا معاً طوال الوَقت
Dialogue: 0,1:49:15.50,1:49:17.13,Default,,0,0,0,,...فلتصل هذه
