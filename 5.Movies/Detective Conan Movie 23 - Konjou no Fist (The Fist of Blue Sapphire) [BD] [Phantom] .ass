Dialogue: 0,0:00:31.21,0:00:32.13,Default,,0,0,0,,.تفضّلي، يا فتاة
Dialogue: 0,1:05:27.19,1:05:31.44,Title,,0,0,0,,{\fs60\b1}قسيمة تسليم
Dialogue: 0,0:00:32.13,0:00:32.75,Default,,0,0,0,,!شُكراً
Dialogue: 0,0:00:57.47,0:00:59.28,Default - E,,0,0,0,,هل جعلتكِ تنتظرين؟
Dialogue: 0,0:00:59.28,0:01:01.91,Default - E,,0,0,0,,.هذا مكانٌ غريبٌ للّقاء
Dialogue: 0,0:01:02.04,0:01:04.12,Default - E,,0,0,0,,...هل يُمكننا التّكلّم باليابانيّة
Dialogue: 0,0:01:04.12,0:01:05.67,Default - E,,0,0,0,,حتّى لا يسمعنا الأشخاص من حولنا؟
Dialogue: 0,0:01:07.25,0:01:10.34,Caracters,,0,0,0,,{\fad(300,300)\pos(537,873)}شيريلين تان (40) عاماً\Nمُحامية
Dialogue: 0,0:01:07.35,0:01:10.65,Default,,0,0,0,,لا يُمكنكَ القيام بتصرّفكَ الغريب هذا إن كنتَ تجذِب الإنتباه، صحيح؟
Dialogue: 0,0:01:10.65,0:01:12.44,Default,,0,0,0,,.هذه طريقةٌ فظيعةٌ لقولها
Dialogue: 0,0:01:10.92,0:01:14.01,Caracters,,0,0,0,,{\fad(300,300)\pos(1257,867)}ليون لو  (43) عاماً\Nمُستشار أعمال
Dialogue: 0,0:01:12.44,0:01:15.24,Default,,0,0,0,,.تجعلين الأمر يبدو عمليّاً كما لَو أنّني مُهتمٌّ بأمرك
Dialogue: 0,0:01:15.24,0:01:16.18,Default,,0,0,0,,هل أنا مُخطئة؟
Dialogue: 0,0:01:16.18,0:01:20.01,Default,,0,0,0,,...أشعر بأنّني بنيتُ علاقةً جيّدةً معكِ كصديق
Dialogue: 0,0:01:20.01,0:01:22.62,Default,,0,0,0,,.توَقّف عن هذه الدّردشة التي بلا داعي
Dialogue: 0,0:01:22.62,0:01:25.77,Default,,0,0,0,,.أجِبني بشأن ترقيَتي فقط
Dialogue: 0,0:01:25.77,0:01:28.71,Default,,0,0,0,,نعم أو لا؟
Dialogue: 0,0:01:33.36,0:01:35.17,Default,,0,0,0,,...قبل أن أُجيب على ذلك
Dialogue: 0,0:01:35.17,0:01:38.39,Default,,0,0,0,,.إسمحي لي بتخمين ما طلَبتِه للتّوّ
Dialogue: 0,0:01:38.39,0:01:39.74,Default,,0,0,0,,.شايٌ مُثلّج
Dialogue: 0,0:01:39.74,0:01:42.35,Default,,0,0,0,,.كلّا، لَيس ذلك\Nشامبانيا...؟
Dialogue: 0,0:01:42.35,0:01:45.43,Default,,0,0,0,,.كلّا، نبيذ\N.لَيس أحمر، بل أبيض
Dialogue: 0,0:01:45.43,0:01:46.91,Default,,0,0,0,,.ميرسولت باردٌ جدّاً
Dialogue: 0,0:01:46.91,0:01:48.69,Default - E,,0,0,0,,.ها هو الميرسولت خاصّتكِ
Dialogue: 0,0:01:49.31,0:01:52.40,Default,,0,0,0,,كـ-كيف عرفت؟
Dialogue: 0,0:01:52.40,0:01:54.76,Default,,0,0,0,,.قرأتُ تفكيركِ
Dialogue: 0,0:01:54.76,0:01:55.34,Default - E,,0,0,0,,...أمم، عُذراً
Dialogue: 0,0:01:55.34,0:01:56.51,Default,,0,0,0,,!لا أحتاجه
Dialogue: 0,0:01:59.51,0:02:00.55,Default,,0,0,0,,.أوه، إنتظري
Dialogue: 0,0:02:01.99,0:02:03.06,Default,,0,0,0,,!ماذا تُريد؟
Dialogue: 0,0:02:03.06,0:02:04.97,Default,,0,0,0,,.إجابتي هي لا
Dialogue: 0,0:02:15.19,0:02:16.32,Default - E,,0,0,0,,.شُكراً على المُساعدة
Dialogue: 0,0:02:30.88,0:02:32.13,Default,,0,0,0,,.الطّابق الـ1
Dialogue: 0,0:02:53.02,0:02:54.52,Default - E,,0,0,0,,هاي، هل أنتِ بخير...؟
Dialogue: 0,0:03:12.63,0:03:13.46,Default - E,,0,0,0,,!مـ-ماذا؟
Dialogue: 0,0:03:21.43,0:03:22.80,Default - E,,0,0,0,,!إهدأوا رجاءً
Dialogue: 0,0:03:22.80,0:03:24.30,Default - E,,0,0,0,,...إتّبعوا تعليماتنا
Dialogue: 0,0:03:30.18,0:03:31.10,Default - E,,0,0,0,,!هاي، إنتظروا
Dialogue: 0,0:03:31.89,0:03:32.94,Default - E,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:03:33.94,0:03:35.82,Default - E,,0,0,0,,.أُحافظ على مَسرَح الجّريمة
Dialogue: 0,0:03:35.82,0:03:36.69,Default - E,,0,0,0,,...و إلّا
Dialogue: 0,0:03:36.69,0:03:39.49,Default - E,,0,0,0,,سيتمّ الدّهس على هذا، صحيح؟
Dialogue: 0,0:03:54.29,0:03:55.21,Default - E,,0,0,0,,.سيّدي
Dialogue: 0,0:03:55.46,0:03:57.09,Default - E,,0,0,0,,من استدعيتُه؟
Dialogue: 0,0:03:57.09,0:03:58.38,Default - E,,0,0,0,,.هو بالدّاخل بالفِعل
Dialogue: 0,0:03:58.63,0:03:59.46,Default - E,,0,0,0,,.شُكراً
Dialogue: 0,0:04:01.47,0:04:03.34,Default - E,,0,0,0,,!أعتذر لجعلكَ تنتظر، ريشي
Dialogue: 0,0:04:03.51,0:04:05.01,Default - E,,0,0,0,,!مُفتّش إيدان
Dialogue: 0,0:04:05.18,0:04:06.97,Default - E,,0,0,0,,.شُكراً لاتّصالكَ بي
Dialogue: 0,0:04:07.18,0:04:10.31,Up,,0,0,0,,.وَقعَت الحادثة في مركز التّسوّق في الأمام
Dialogue: 0,0:04:08.97,0:04:12.02,Caracters,,0,0,0,,{\fad(300,300)\pos(952,866)}مارك إيدان (38) عاماً\Nمُفتّشٌ مُساعدٌ في قوّات شُرطة سينغافورة
Dialogue: 0,0:04:10.64,0:04:13.27,Up,,0,0,0,,.يُمكن أن تكون هذه القضيّة مُعقّدةً قليلاً
Dialogue: 0,0:04:14.81,0:04:18.23,Default - E,,0,0,0,,.ليون لو ذاك هو أوّل من اكتشف الجُثّة
Dialogue: 0,0:04:18.61,0:04:18.98,Default,,0,0,0,,...أوه
Dialogue: 0,0:04:18.98,0:04:19.98,Default - E,,0,0,0,,!السيّد لو
Dialogue: 0,0:04:20.99,0:04:23.82,Default - E,,0,0,0,,كنتَ تِلميذه المُفضّل، صحيح؟
Dialogue: 0,0:04:23.82,0:04:26.82,Default - E,,0,0,0,,هل يُمكنكَ أن تطلُب منه ألّا يتدخّل كثيراً؟
Dialogue: 0,0:04:27.12,0:04:28.83,Default - E,,0,0,0,,.لا يُمكنني أن أطلُب منه ذلك
Dialogue: 0,0:04:28.83,0:04:30.29,Default - E,,0,0,0,,!سأذهب لتحيّته
Dialogue: 0,0:04:31.45,0:04:32.62,Default - E,,0,0,0,,!سيّد لو
Dialogue: 0,0:04:32.79,0:04:35.29,Default - E,,0,0,0,,.ريشي! لَقد مرّ زمنٌ طويل
Dialogue: 0,0:04:35.29,0:04:36.04,Default - E,,0,0,0,,!نعم
Dialogue: 0,0:04:38.99,0:04:40.68,Default,,0,0,0,,.لنتكلّم باليابانيّة
Dialogue: 0,0:04:40.68,0:04:41.55,Default,,0,0,0,,.بالتّأكيد
Dialogue: 0,0:04:41.55,0:04:45.72,Default,,0,0,0,,سمعتُ بأنّكَ تعمل كضابطٍ إحتياطيٍّ خاصٍّ الآن؟
Dialogue: 0,0:04:45.72,0:04:47.07,Default,,0,0,0,,.تقدّمتَ بالعالَم بالتّأكيد
Dialogue: 0,0:04:46.14,0:04:49.14,Caracters,,0,0,0,,{\fad(300,300)\pos(492,861)}ريشي راماناثان (29) عاماً\Nضابطٌ إحتياطيّ
Dialogue: 0,0:04:47.07,0:04:51.24,Default,,0,0,0,,...كمُعلّمي، أدخلتَ بعقلي سايكولوجيّة التّصرّف الإجراميّ بالقوّة
Dialogue: 0,0:04:51.24,0:04:52.81,Default,,0,0,0,,.لذا كلّ هذا بفضلك، ليون سينساي
Dialogue: 0,0:04:52.81,0:04:55.04,Default,,0,0,0,,.أرجوكَ توَقّف عن دعوَتي بسينساي
Dialogue: 0,0:04:55.04,0:04:56.90,Default,,0,0,0,,.أنا مُجرّد مَدنيٍّ الآن
Dialogue: 0,0:04:56.90,0:04:57.86,Default,,0,0,0,,...على أيّة حال
Dialogue: 0,0:04:57.86,0:05:00.82,Default,,0,0,0,,.لَم أكُن لأُفكّر أبداً بأنّ القاتِل قد زرع قنابل
Dialogue: 0,0:05:00.82,0:05:02.34,Default,,0,0,0,,...و السيّارة التي تمّ تفجيرها
Dialogue: 0,0:05:02.34,0:05:05.13,Default,,0,0,0,,.تنتمي للضّحيّة، شيريلين تان سان
Dialogue: 0,0:05:05.13,0:05:07.87,Default,,0,0,0,,...كانت مُحامية دِفاعٍ مُمتازةٍ بعد كلّ شيء
Dialogue: 0,0:05:07.87,0:05:09.87,Default,,0,0,0,,.لذا وَاثقٌ من وُجود من حملوا ضغينةً نحوَها
Dialogue: 0,0:05:09.87,0:05:11.74,Default,,0,0,0,,...رُبّما كانت تتعامل مع شخصٍ خطيرٍ أيضاً
Dialogue: 0,0:05:11.74,0:05:13.37,Default - E,,0,0,0,,!هل المُفتّش هناك؟
Dialogue: 0,0:05:14.21,0:05:16.25,Default - E,,0,0,0,,!عُذراً! أفسحوا الطّريق
Dialogue: 0,0:05:16.67,0:05:17.71,Default - E,,0,0,0,,ماذا يحصل؟
Dialogue: 0,0:05:17.71,0:05:19.84,Default - E,,0,0,0,,.هناك شيءٌ على جِدار المِصعد
Dialogue: 0,0:05:20.63,0:05:21.21,Default - E,,0,0,0,,!ماذا؟
Dialogue: 0,0:05:21.96,0:05:23.26,Default - E,,0,0,0,,ما هذا؟
Dialogue: 0,0:05:31.28,0:05:32.52,Default,,0,0,0,,!ماذا...؟
Dialogue: 0,0:05:56.60,0:05:57.83,Default,,0,0,0,,.كلّا على الإطلاق
Dialogue: 0,0:05:58.90,0:06:00.84,Default,,0,0,0,,!أرجوكِ، ألا يُمكنكِ فِعل هذا لأجلي فقط؟
Dialogue: 0,0:06:00.84,0:06:02.66,Default,,0,0,0,,.كلّا تعني كلّا
Dialogue: 0,0:06:02.66,0:06:03.15,Default,,0,0,0,,!أتوَسّل إليكِ
Dialogue: 0,0:06:03.15,0:06:04.76,Default,,0,0,0,,ماذا يحصل، كِلاكما؟
Dialogue: 0,0:06:04.76,0:06:08.78,Default,,0,0,0,,.يقول بأنّه يرغب باستخدام ذلك العقار ليعود إلى شكله الأصليّ ثانيةً
Dialogue: 0,0:06:08.78,0:06:12.62,Default,,0,0,0,,...مرّ بتجرُبةٍ فظيعةٍ خلال الرّحلة المدرسيّة مُؤخّراً أيضاً
Dialogue: 0,0:06:12.62,0:06:15.45,Default,,0,0,0,,.مع ذلك، تمكّنتُ من تجاوز ما حصل بطريقةٍ أو بأُخرى
Dialogue: 0,0:06:15.45,0:06:17.85,Default,,0,0,0,,!لذا سيكون الأمر بخير\N!أعطيني العقار رجاءً
Dialogue: 0,0:06:17.85,0:06:20.02,Default,,0,0,0,,!كلّا على الإطلاق
Dialogue: 0,0:06:20.88,0:06:22.52,Default,,0,0,0,,و إلى أين ينوي الذّهاب؟
Dialogue: 0,0:06:22.52,0:06:24.05,Default,,0,0,0,,.سينغافورة
Dialogue: 0,0:06:24.05,0:06:25.53,Default,,0,0,0,,!بسبب هذا، بروفيسور
Dialogue: 0,0:06:25.53,0:06:27.97,Default,,0,0,0,,!سيكون ذلك الشّخص في هذه البُطولة
Dialogue: 0,0:06:25.53,0:06:27.53,Title,,0,0,0,,{\fs60\b1\c&H94DCDB&\4c&H000000&}كأس زونهان\Nبُطولة العالَم للكراتيه في سينغافورة
Dialogue: 0,0:06:27.97,0:06:29.20,Default,,0,0,0,,!من لَم يخسر في 400 نِزال
Dialogue: 0,0:06:29.72,0:06:31.05,Default,,0,0,0,,!أوه
Dialogue: 0,0:06:31.05,0:06:32.95,Default,,0,0,0,,هل تعني كيوغوكو ماكوتو كن؟
Dialogue: 0,0:06:32.95,0:06:36.22,Default,,0,0,0,,.لذا اقترحَت سونوكو الذّهاب لمُشاهدة ذلك النّزال
Dialogue: 0,0:06:36.22,0:06:40.75,Default,,0,0,0,,...و تمّت دعوَتي لمُرافقتها مع العمّ كوغورو و ران
Dialogue: 0,0:06:40.75,0:06:42.96,Default,,0,0,0,,.لكن لا يُمكنني مُغادرة البِلاد بهذا المَظهر
Dialogue: 0,0:06:42.96,0:06:44.09,Default,,0,0,0,,...هذا صحيح
Dialogue: 0,0:06:44.09,0:06:46.46,Default,,0,0,0,,.لأنّ جواز سفركَ لشينتشي
Dialogue: 0,0:06:46.46,0:06:48.65,Default,,0,0,0,,!لذا أرجوكِ، هايبارا
Dialogue: 0,0:06:48.65,0:06:49.76,Default,,0,0,0,,.إستسلِم
Dialogue: 0,0:06:49.76,0:06:51.02,Default,,0,0,0,,...أوه، هيّا الآن
Dialogue: 0,0:06:51.02,0:06:53.58,Default,,0,0,0,,...رُبّما سيكون من الأفضل الإستسلام فقط هذه المرّة
Dialogue: 0,0:06:53.58,0:06:56.75,Default,,0,0,0,,...أووو\N.أردتّ الذّهاب حقّاً
Dialogue: 0,0:06:56.93,0:06:58.96,Default,,0,0,0,,!لا تكُن خائب الأمَل هكذا
Dialogue: 0,0:06:58.96,0:07:01.67,Default,,0,0,0,,!حسناً، هذه مُحاولتي الأُولى لإبهاجك
Dialogue: 0,0:07:01.67,0:07:03.38,Default,,0,0,0,,ماذا...؟\N!ستفعل هذا بهذا الوَقت المُبكّر؟
Dialogue: 0,0:07:03.38,0:07:06.67,Default,,0,0,0,,!تادا\N!ها هو السّؤال
Dialogue: 0,0:07:06.67,0:07:10.95,Default,,0,0,0,,ما الحدَث الأشهَر في سينغافورة؟
Dialogue: 0,0:07:10.95,0:07:21.67,Title,,0,0,0,,{\c&H151664&\3c&HFFFFFF&\4c&HC375C2&\fs65\b1}غناء النّشيد الوَطنيّ
Dialogue: 0,0:07:10.95,0:07:12.95,Default,,0,0,0,,.وَاحد: غناء النّشيد الوَطنيّ
Dialogue: 0,0:07:12.95,0:07:21.67,Title,,0,0,0,,{\c&H952624&\3c&HFFFFFF&\fs65\b1}الإحتفال بالعام القمَريّ الجّديد
Dialogue: 0,0:07:12.95,0:07:15.56,Default,,0,0,0,,.إثنان: الإحتفال بالعام القمَريّ الجّديد
Dialogue: 0,0:07:15.56,0:07:17.93,Default,,0,0,0,,.ثلاثة: تطيير العلَم الوَطنيّ
Dialogue: 0,0:07:15.66,0:07:21.67,Title,,0,0,0,,{=76}{\c&H0F7310&\3c&HFFFFFF&\4c&H94DC95&\fs65\b1}تطيير العلَم الوَطنيّ
Dialogue: 0,0:07:17.93,0:07:20.50,Default,,0,0,0,,.أربعة: عرض الألعاب النّاريّة في خليج مارينا
Dialogue: 0,0:07:18.04,0:07:21.67,Title,,0,0,0,,{=76}{\c&H7070C6&\3c&HFFFFFF&\4c&HB0B1E7&\fs65\b1}عرض الألعاب النّاريّة في خليج مارينا
Dialogue: 0,0:07:21.67,0:07:23.44,Default,,0,0,0,,ما أمر الزّيّ؟
Dialogue: 0,0:07:23.44,0:07:24.84,Default,,0,0,0,,.الإجابة على هذا بسيطة
Dialogue: 0,0:07:24.84,0:07:27.13,Title,,0,0,0,,{\fs60\b1}.وَاحد: غناء النّشيد الوَطنيّ
Dialogue: 0,0:07:24.84,0:07:27.13,Title,,0,0,0,,{\fs60\b1}.إثنان: الإحتفال بالعام القمَريّ الجّديد
Dialogue: 0,0:07:24.84,0:07:27.13,Title,,0,0,0,,{\fs60\b1}.ثلاثة: تطيير العلَم الوَطنيّ
Dialogue: 0,0:07:24.84,0:07:27.13,Title,,0,0,0,,{\fs60\b1}.أربعة: عرض الألعاب النّاريّة في خليج مارينا
Dialogue: 0,0:07:24.84,0:07:27.13,Default,,0,0,0,,ألَيسَت الإجابة هي الرّقم 3 "تطيير العلَم الوَطنيّ"؟
Dialogue: 0,0:07:27.13,0:07:29.09,Default,,0,0,0,,."بعد كلّ شيء، يُوجد "حبلٌ" يعتلي "عاموداً
Dialogue: 0,0:07:28.80,0:07:32.64,Title,,0,0,0,,{\fs60\b1\3c&H0000FF&\4c&H89C289&\pos(484,364)}حبل      عامود
Dialogue: 0,0:07:28.80,0:07:32.64,Title,,0,0,0,,{\fs60\b1\pos(484,432)}سين      غافورة
Dialogue: 0,0:07:29.11,0:07:31.07,Default,,0,0,0,,!هواه\N!هذا صحيح
Dialogue: 0,0:07:29.30,0:07:32.64,Title,,0,0,0,,{\pos(1500,606)}سينغافورة
Dialogue: 0,0:07:31.07,0:07:32.64,Default,,0,0,0,,.كان عليّ توَقّع هذا منك
Dialogue: 0,0:07:32.64,0:07:34.64,Default,,0,0,0,,!حسناً إذاً، ها هو سؤالٌ آخر
Dialogue: 0,0:07:34.64,0:07:35.35,Default,,0,0,0,,.كلّا، هذا يكفي
Dialogue: 0,0:07:35.35,0:07:35.84,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:07:37.91,0:07:41.14,Default,,0,0,0,,...المكان مُوحِشٌ حقّاً عندما لا يكون الأطفال هُنا
Dialogue: 0,0:07:49.90,0:07:51.90,Default,,0,0,0,,...يا إلهي\N.تبّاً لكِ، هايبارا
Dialogue: 0,0:08:17.53,0:08:18.30,Default,,0,0,0,,ران...؟
Dialogue: 0,0:08:18.30,0:08:19.87,Default,,0,0,0,,.أوه، ران نيتشان
Dialogue: 0,0:08:19.87,0:08:24.12,Default,,0,0,0,,ماذا... تفعلين... هُنا...؟
Dialogue: 0,0:08:25.33,0:08:28.02,Default,,0,0,0,,ران... نيتشان...؟
Dialogue: 0,0:08:28.02,0:08:31.53,Default,,0,0,0,,.كنتُ أنتظركَ منذ فترة
Dialogue: 0,0:08:37.39,0:08:39.20,Default,,0,0,0,,هـ-هاه؟
Dialogue: 0,0:08:39.20,0:08:40.91,Default,,0,0,0,,!ما هذا المكان؟
Dialogue: 0,0:08:40.68,0:08:42.62,Up,,0,0,0,,!إنّه كبيرٌ جدّاً
Dialogue: 0,0:08:42.06,0:08:43.38,Default,,0,0,0,,هل هذا صوت ران؟
Dialogue: 0,0:08:43.38,0:08:44.76,Default,,0,0,0,,أين أنا بحقّ الله...؟
Dialogue: 0,0:08:44.76,0:08:46.57,Default,,0,0,0,,!هل أنا مُحتجَزٌ في شيءٍ ما؟
Dialogue: 0,0:08:46.58,0:08:47.59,Default,,0,0,0,,!سُحقاً
Dialogue: 0,0:08:47.59,0:08:50.92,Default,,0,0,0,,أوه؟\N...ها هو، يُمكنني الآن
Dialogue: 0,0:08:55.86,0:08:56.72,Default,,0,0,0,,!هواه
Dialogue: 0,0:08:58.28,0:08:59.89,Default,,0,0,0,,هاه؟
Dialogue: 0,0:09:01.58,0:09:02.68,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:07.38,0:09:11.61,Default,,0,0,0,,الـ... ميرليون...؟
Dialogue: 0,0:09:17.80,0:09:19.62,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:09:19.62,0:09:23.37,Default,,0,0,0,,!أنا في سينغافورة؟
Dialogue: 0,0:09:26.29,0:09:31.04,Title,,0,0,0,,{\fad(1000,1000)\c&HC0C0CD&\3c&HCC6968&\pos(480,18)}قبضة الياقوتة الزّرقاء\N{\c&HBA433E&\3c&HFFFFFF&}المُتحرّي كونان
Dialogue: 0,0:09:26.29,0:09:31.04,Title,,0,0,0,,{\fad(1000,1000)\c&HE5B4B1&\3c&HFFFFFF&\fs90\fnWallowxenon\i0\pos(1898,982)}www.alphantom.com
Dialogue: 0,0:09:36.76,0:09:40.47,Title,,0,0,0,,{=250}{\fad(1000,0)\c&H3F40B2&\3c&H00FFFF&\pos(1886,498)\4c&H292A90&}المُتحرّي كونان\N{\c&H10F9F4&\3c&H0000FF&\fs60\b1\4c&H952624&}قبضة الياقوتة الزّرقاء
Dialogue: 0,0:09:36.76,0:09:40.47,Title,,0,0,0,,{=250}{\fad(1000,0)\fs70\fnWallowxenon\i0\c&H3F40B2&\3c&H10F9F4&\4c&H10F9F4&\pos(372,20)}www.alphantom.com
Dialogue: 0,0:09:43.97,0:09:46.58,Default,,0,0,0,,.أنا مُتحرّي الثّانويّة، كودو شينتشي
Dialogue: 0,0:09:44.89,0:09:46.10,Title,,0,0,0,,{\fad(300,300)\pos(1107,654)\c&H000000&\3c&HFFFFFF&\4c&HE5B4B1&}كودو شينتشي
Dialogue: 0,0:09:46.58,0:09:50.32,Default,,0,0,0,,...بينما كنتُ أزور مدينة ملاهي مع صديقة طُفولتي و زميلتي في الصّفّ، موري ران
Dialogue: 0,0:09:50.32,0:09:54.02,Default,,0,0,0,,.شاهدتّ رجلاً يرتدي الأسوَد يُجري صفقةً مُريبة
Dialogue: 0,0:09:55.90,0:09:58.16,Default,,0,0,0,,...بينما انشغلتُ بمُشاهدة الصّفقة
Dialogue: 0,0:09:58.16,0:10:01.74,Default,,0,0,0,,.لَم أُلاحظ شريكه الذي تسلّل من خلفي
Dialogue: 0,0:10:04.45,0:10:07.41,Default,,0,0,0,,...أجبرَني ذلك الرّجل على ابتلاع سُمّ
Dialogue: 0,0:10:07.41,0:10:08.70,Default,,0,0,0,,...و عندما استعدتّ وَعيي
Dialogue: 0,0:10:12.15,0:10:14.07,Default,,0,0,0,,.كان جسدي قد تقلّص
Dialogue: 0,0:10:16.34,0:10:18.93,Default,,0,0,0,,...إن اكتشف أولئكَ الرّجال بأنّ كودو شينتشي مازال حيّاً
Dialogue: 0,0:10:18.93,0:10:22.38,Default,,0,0,0,,.سيُلاحقوني ثانيةً، و يضعون الأشخاص من حولي في خطَر
Dialogue: 0,0:10:23.18,0:10:26.17,Default,,0,0,0,,.باقتراحٍ من البروفيسور أغاسا، قرّرتُ إخفاء هويّتي الحقيقيّة
Dialogue: 0,0:10:26.17,0:10:29.15,Default,,0,0,0,,...و لَحظة سؤال ران عن إسمي
Dialogue: 0,0:10:29.15,0:10:31.15,Default,,0,0,0,,.أصبحتُ إيدوغاوا كونان
Dialogue: 0,0:10:30.35,0:10:32.82,Title,,0,0,0,,{\fad(300,300)\c&H000000&\3c&HFFFFFF&\4c&HE5B4B1&\pos(1005,657)}إيدوغاوا كونان
Dialogue: 0,0:10:31.15,0:10:33.02,Default,,0,0,0,,...للحصول على معلوماتٍ عن أولئكَ الرّجال
Dialogue: 0,0:10:33.02,0:10:36.65,Default,,0,0,0,,.ذهبتُ لأعيش مع ران، الذي يعمل وَالِدها كمُتحرٍّ خاصّ
Dialogue: 0,0:10:38.63,0:10:41.55,Default,,0,0,0,,:على هذا النّحو، أحد أقوى خُصومي هو هذا الرّجل
Dialogue: 0,0:10:41.55,0:10:43.26,Default,,0,0,0,,.كايتو كيد
Dialogue: 0,0:10:43.26,0:10:46.72,Default,,0,0,0,,...هو لِصٌّ شبحٌ تبقى هويّته الحقيقيّة مَجهولة، خبير تنكّر
Dialogue: 0,0:10:46.72,0:10:49.98,Default,,0,0,0,,.و رجلٌ ماكرٌ يعرف هويّتي الحقيقيّة بطريقةٍ ما
Dialogue: 0,0:10:49.98,0:10:52.52,Default,,0,0,0,,!يوماً ما، سأُمسكه بيَداي
Dialogue: 0,0:10:52.52,0:10:55.36,Default,,0,0,0,,.خصم كيد هو كيوغوكو ماكوتو
Dialogue: 0,0:10:55.36,0:10:56.86,Default,,0,0,0,,...بالرّغم من أنّه مُجرّد تِلميذٍ بالثّانويّة
Dialogue: 0,0:10:56.86,0:10:59.53,Default,,0,0,0,,.هو خبير كراتيه فاز بـ400 نِزالٍ مُتتالٍ بلا خسارة
Dialogue: 0,0:10:59.53,0:11:03.40,Default,,0,0,0,,...و لسببٍ ما، يبدو بأنّه يُحبّ سوزوكي سونوكو بجُنون
Dialogue: 0,0:11:03.40,0:11:05.16,Default,,0,0,0,,.زميلة صفّ ران و إبنة مَجموعة سوزوكي الماليّة
Dialogue: 0,0:11:05.16,0:11:06.42,Default,,0,0,0,,!إلى ماذا تنظُر؟
Dialogue: 0,0:11:06.42,0:11:08.62,Default,,0,0,0,,.أسرِع و قُل ما تقوله دائماً
Dialogue: 0,0:11:09.94,0:11:11.85,Default,,0,0,0,,...بالرّغم من تقلّصي، يبقى تفكيري كما هو
Dialogue: 0,0:11:11.85,0:11:13.98,Default,,0,0,0,,.تفكير مُتحرٍّ عظيمٍ لَم يُهزَم أبداً
Dialogue: 0,0:11:14.92,0:11:19.45,Default,,0,0,0,,!تُوجد حقيقةٌ وَاحدةٌ دائماً
Dialogue: 0,0:11:25.05,0:11:27.47,Default,,0,0,0,,ماذا حصل ليَدي...؟
Dialogue: 0,0:11:27.47,0:11:29.68,Default,,0,0,0,,!و لَيس معي أيٌّ من أدوات البروفيسور
Dialogue: 0,0:11:29.68,0:11:32.27,Default,,0,0,0,,!أعلَم\N!وَاثقٌ من أنّ ران كانت هُنا
Dialogue: 0,0:11:33.54,0:11:36.05,Default,,0,0,0,,!إنتظريني، ران نيتشان
Dialogue: 0,0:11:37.69,0:11:39.97,Default,,0,0,0,,!أوه، شينتشي\N!نحن هُنا
Dialogue: 0,0:11:39.97,0:11:40.65,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:11:40.65,0:11:43.84,Default,,0,0,0,,.أعتذر لإبقائكما تنتظران
Dialogue: 0,0:11:43.84,0:11:46.76,Default,,0,0,0,,!إلى أين ذهبت؟\N.كنّا نبحث عنكَ في كلّ مكان
Dialogue: 0,0:11:46.76,0:11:50.27,Default,,0,0,0,,.كان العمّ يقول بأنّ الجوّ حارّ، لذا كنتُ أُرشده إلى شجرَةٍ مُظلّلة
Dialogue: 0,0:11:50.27,0:11:53.00,Default,,0,0,0,,!هيه، شُكراً
Dialogue: 0,0:11:53.00,0:11:55.93,Default,,0,0,0,,أوه... لا يتغيّر وَالِدكِ على الإطلاق، صحيح؟
Dialogue: 0,0:11:55.93,0:11:56.77,Default,,0,0,0,,!هاي، ران
Dialogue: 0,0:11:56.77,0:11:58.78,Default,,0,0,0,,!هل يُمكنكِ أن تشتري لي بعض الماء؟
Dialogue: 0,0:11:58.78,0:12:00.62,Default,,0,0,0,,...أظنّني سأُضطرّ لذلك
Dialogue: 0,0:12:00.62,0:12:03.22,Default,,0,0,0,,!هاي، لنذهب معاً
Dialogue: 0,0:12:03.22,0:12:04.09,Default,,0,0,0,,!تعال، أسرِع
Dialogue: 0,0:12:04.09,0:12:05.53,Default,,0,0,0,,...حـ-حسناً
Dialogue: 0,0:12:05.53,0:12:09.18,Default,,0,0,0,,.يا إلهي، الأجواء بينهما جيّدةٌ بالفِعل
Dialogue: 0,0:12:10.04,0:12:12.04,Default,,0,0,0,,...ذلك الوَغد
Dialogue: 0,0:12:15.34,0:12:16.62,Default,,0,0,0,,!أشعر بكثيرٍ من الإنتعاش الآن
Dialogue: 0,0:12:16.62,0:12:17.23,Default,,0,0,0,,أوه؟
Dialogue: 0,0:12:17.23,0:12:19.30,Default,,0,0,0,,ما هذا الذي يتدلّى من عُنقك، أبي؟
Dialogue: 0,0:12:19.30,0:12:20.13,Default,,0,0,0,,هاه؟
Dialogue: 0,0:12:20.13,0:12:23.22,Default,,0,0,0,,.وَضعتُ جواز سفري داخل هذا
Dialogue: 0,0:12:23.22,0:12:25.16,Default,,0,0,0,,.هكذا، لَن أفقِده أو تتمّ سرِقته
Dialogue: 0,0:12:25.16,0:12:26.40,Default,,0,0,0,,فِكرةٌ جيّدة، ألا تظنّين؟
Dialogue: 0,0:12:26.40,0:12:27.60,Default,,0,0,0,,.أوه، هيّا الآن، أبي
Dialogue: 0,0:12:27.60,0:12:30.31,Default,,0,0,0,,.لا تحتاج لفِعل هذا، لأنّ سينغافورة آمنةٌ بالكامل
Dialogue: 0,0:12:30.31,0:12:31.89,Up,,0,0,0,,!كما لَو أنّها كذلك
Dialogue: 0,0:12:30.31,0:12:32.04,Default,,0,0,0,,.مرحباً\Nإذاً فقد استيقظت؟
Dialogue: 0,0:12:32.04,0:12:33.60,Default,,0,0,0,,!كنتُ وَاثقاً من أنّه أنت
Dialogue: 0,0:12:34.60,0:12:37.56,Default,,0,0,0,,إنتظر، كيف خرجتَ من الحقيبة؟
Dialogue: 0,0:12:37.56,0:12:38.77,Default,,0,0,0,,.بهذا
Dialogue: 0,0:12:38.77,0:12:41.17,Default,,0,0,0,,...عندما دفعتُه برأس هذا القلَم
Dialogue: 0,0:12:41.17,0:12:44.28,Default,,0,0,0,,.فُتِحَ بسهولةٍ مُفاجئة، حتّى من الدّاخل
Dialogue: 0,0:12:44.28,0:12:46.22,Default,,0,0,0,,...ظننتُ بأنّ قلَم حِبرٍ عاديٍّ لَن يُشكّل مُشكلة
Dialogue: 0,0:12:46.22,0:12:48.66,Default,,0,0,0,,!لكن معك، أظنّ أنّه لا يُمكنني أن أكون شديد الحذَر
Dialogue: 0,0:12:48.66,0:12:51.37,Default,,0,0,0,,!هذا ما يجدُر بي قوله لك، كايتو كيد
Dialogue: 0,0:12:53.41,0:12:54.80,Default,,0,0,0,,.أوه، ها هي
Dialogue: 0,0:12:55.67,0:12:58.12,Default,,0,0,0,,!الأهمّ، ما أمر هذا؟
Dialogue: 0,0:12:58.12,0:13:01.67,Default,,0,0,0,,.هيه... الإجابة وَاضحةٌ أمامك
Dialogue: 0,0:13:01.67,0:13:03.03,Default,,0,0,0,,ما-ماذا؟
Dialogue: 0,0:13:03.80,0:13:06.09,Title,,0,0,0,,{\fs60\b1\c&H94DCDB&\4c&H000000&}كأس زونهان\Nبُطولة العالَم للكراتيه في سينغافورة
Dialogue: 0,0:13:06.09,0:13:07.82,Default,,0,0,0,,ألَيس ذلك لحبيب سونوكو...؟
Dialogue: 0,0:13:07.82,0:13:10.10,Default,,0,0,0,,...في نهاية القرن الـ19
Dialogue: 0,0:13:10.10,0:13:14.77,Default,,0,0,0,,...غرقَت سفينة قراصنةٍ خارج ساحل سينغافورة، بينما ظُنّ بأنّها كان تحمل
Dialogue: 0,0:13:14.77,0:13:17.40,Default,,0,0,0,,.كنزاً أُسطوريّاً مَخفيّاً
Dialogue: 0,0:13:17.40,0:13:19.97,Default,,0,0,0,,...كانت أجوَد ياقوتةٍ زرقاء في العالَم
Dialogue: 0,0:13:19.97,0:13:24.70,Default,,0,0,0,,."المَعروفة أيضاً بـ"قبضة الياقوتة الزّرقاء
Dialogue: 0,0:13:25.61,0:13:37.37,Title,,0,0,0,,{\fs60\b1}ساعة العالَم
Dialogue: 0,0:13:25.61,0:13:37.37,Title,,0,0,0,,{\fs60\b1}إستُعيدَ كنز سفينة قراصنةٍ في سينغافورة
Dialogue: 0,0:13:25.61,0:13:30.05,Default,,0,0,0,,.إنّها جوهرةٌ ضخمةٌ أنقذها السيّد زونهان تشين العام الماضي
Dialogue: 0,0:13:30.05,0:13:31.72,Default,,0,0,0,,...الآن بذِكركَ زونهان تشين
Dialogue: 0,0:13:30.41,0:13:37.37,Title,,0,0,0,,{\fs60\b1}"شخصيّةٌ نافذةٌ في العالَم الماليّ في سينغافورة"\Nالسيّد زونهان تشين
Dialogue: 0,0:13:31.72,0:13:34.16,Default,,0,0,0,,.هو أحد أكثر الأشخاص نُفوذاً في سينغافورة
Dialogue: 0,0:13:34.18,0:13:34.91,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:13:34.91,0:13:37.37,Default,,0,0,0,,.و هذا المُسنّ يُحبّ الفُنون القِتاليّة كثيراً
Dialogue: 0,0:13:37.37,0:13:39.81,Default,,0,0,0,,...ضمّ الجّوهرة إلى حِزام البُطولة
Dialogue: 0,0:13:39.81,0:13:43.23,Default,,0,0,0,,.و قرّر استضافة بُطولة كراتيه
Dialogue: 0,0:13:43.23,0:13:46.63,Default,,0,0,0,,سيحصل الفائز على الجّوهرة الأُسطوريّة، هاه؟
Dialogue: 0,0:13:46.63,0:13:48.66,Default,,0,0,0,,.هذه بالتّأكيد تسليةٌ للأثرياء
Dialogue: 0,0:13:48.66,0:13:50.01,Default,,0,0,0,,.بالضّبط
Dialogue: 0,0:13:50.01,0:13:54.75,Default,,0,0,0,,...لذا فكّرتُ بأنّه يُمكنني أخذ الجّوهرة ببساطةٍ في خِضمّ صخب البُطولة
Dialogue: 0,0:13:54.75,0:13:57.96,Default,,0,0,0,,لكن لا يُمكنني دُخول الدّولة ككيد، صحيح؟
Dialogue: 0,0:13:57.96,0:14:00.40,Default,,0,0,0,,...إن كنتَ تسعى خلف الجّوهرة فقط
Dialogue: 0,0:14:00.40,0:14:02.98,Default,,0,0,0,,!لَم تكُن بحاجةٍ لإحضاري معك
Dialogue: 0,0:14:03.88,0:14:06.49,Default,,0,0,0,,.هذه حالةٌ خاصّةٌ نوعاً ما
Dialogue: 0,0:14:06.49,0:14:09.24,Default,,0,0,0,,.حسناً، سأشرَح لكَ الوَضع تدريجيّاً بينما نتقدّم
Dialogue: 0,0:14:09.24,0:14:10.43,Default,,0,0,0,,!...أيّها الوَغد
Dialogue: 0,0:14:10.43,0:14:11.41,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:14:12.31,0:14:13.99,Default,,0,0,0,,أوه، شينتشي؟
Dialogue: 0,0:14:13.99,0:14:15.64,Default,,0,0,0,,.أه أوه\N.إنّها تُناديني
Dialogue: 0,0:14:15.64,0:14:16.58,Default,,0,0,0,,!إنتظر، كيد
Dialogue: 0,0:14:17.54,0:14:20.29,Default,,0,0,0,,!إن فعلتَ أيّ شيءٍ لران، سأجعلكَ تدفع الثّمن
Dialogue: 0,0:14:20.29,0:14:21.45,Default,,0,0,0,,ماذا...؟
Dialogue: 0,0:14:21.45,0:14:24.48,Default,,0,0,0,,.أ-أعتذر، لكنّني لا أضمن لكَ بأنّني لَن أفعل
Dialogue: 0,0:14:24.48,0:14:27.45,Default,,0,0,0,,!إذاً سأكشف هويّتكَ الحقيقيّة هُنا و الآن
Dialogue: 0,0:14:27.45,0:14:28.93,Default,,0,0,0,,.من الأفضل ألّا تفعل
Dialogue: 0,0:14:30.68,0:14:35.18,Default,,0,0,0,,.تمكّنتَ من دُخول هذه الدّولة بسبب هذه الحقيبة فقط
Dialogue: 0,0:14:36.37,0:14:40.04,Default,,0,0,0,,.إنّها مُجهّزةٌ خِصّيصاً حتّى أنّ الأشعّة السّينيّة في فاحِص الأمتعة لا يُمكنها الرّؤية عبرها
Dialogue: 0,0:14:40.04,0:14:43.98,Default,,0,0,0,,.داخلها، وَضعتُ مُوَلّد أوكسجين مَحمول يدوم لـ12 ساعة
Dialogue: 0,0:14:43.98,0:14:46.71,Default,,0,0,0,,...و حتّى لا يتألّم جسدكَ بالرّغم من بقائكَ داخلها لهذه الفترة الطّويلة
Dialogue: 0,0:14:46.71,0:14:50.30,Default,,0,0,0,,.تأكّدتّ من أنّها مُنتجٌ من الدّرجة الأولى مُبطّنةٌ ببطانةٍ من أعلى جودة
Dialogue: 0,0:14:50.30,0:14:54.45,Default,,0,0,0,,.وَاثقٌ من فهمكَ لما أعنيه\Nصحيح، أيّها "المُتحرّي العظيم"؟
Dialogue: 0,0:14:54.45,0:14:56.27,Default,,0,0,0,,...إن لَم أُساعدك
Dialogue: 0,0:14:56.27,0:14:59.35,Default,,0,0,0,,.لَن تتمكّن من مُغادرة هذه الدّولة، بما أنّكَ لا تملك جواز سفر
Dialogue: 0,0:14:59.35,0:15:01.71,Default,,0,0,0,,.ممّا يعني بأنّكَ لَن تتمكّن من العودة إلى اليابان
Dialogue: 0,0:15:02.69,0:15:04.52,Default,,0,0,0,,!ها أنتَ ذا، شينتشي
Dialogue: 0,0:15:04.52,0:15:07.71,Default,,0,0,0,,...يا إلهي. أشحتُ بناظِراي للَحظة، و ابتعدتّ إلى مكانٍ ما و اختفيت
Dialogue: 0,0:15:08.69,0:15:09.72,Default,,0,0,0,,أوه؟
Dialogue: 0,0:15:12.33,0:15:14.43,Default,,0,0,0,,!أ-ألَيس هذا هو الغبيّ؟
Dialogue: 0,0:15:14.43,0:15:16.45,Default,,0,0,0,,كيف وَصلتَ إلى هُنا؟
Dialogue: 0,0:15:16.45,0:15:17.77,Default,,0,0,0,,كونان كن؟
Dialogue: 0,0:15:17.77,0:15:19.62,Default,,0,0,0,,!أوه، لَقد هرَب
Dialogue: 0,0:15:19.62,0:15:21.85,Default,,0,0,0,,لَقد فاجأكما بالفِعل، صحيح؟
Dialogue: 0,0:15:21.85,0:15:24.09,Default,,0,0,0,,.يبدو بأنّه طِفلٌ من المنطقة
Dialogue: 0,0:15:24.09,0:15:25.69,Default,,0,0,0,,!ماذا؟! حقّاً؟
Dialogue: 0,0:15:25.69,0:15:28.40,Up,,0,0,0,,...مع ذلك، هذا الطّفل يُشبهه كثيراً
Dialogue: 0,0:15:25.69,0:15:28.40,Default,,0,0,0,,!تسمحان بأن يتمّ خِداعكما بسهولةٍ كبيرة
Dialogue: 0,0:15:28.40,0:15:29.32,Default,,0,0,0,,...أيّها الطّفل
Dialogue: 0,0:15:29.32,0:15:30.75,Default,,0,0,0,,ما اسمك؟
Dialogue: 0,0:15:30.75,0:15:33.57,Default,,0,0,0,,لَحظة، هل تعرف اليابانيّة؟
Dialogue: 0,0:15:34.05,0:15:35.83,Default,,0,0,0,,...أمم
Dialogue: 0,0:15:36.93,0:15:37.83,Default,,0,0,0,,...هذا الصّبيّ
Dialogue: 0,0:15:39.12,0:15:41.08,Title,,0,0,0,,{\fad(300,300)\fs60\b1\pos(496,12)}أعمال إيدوغاوا رانبو المُكتمِلة\Nأفضل أعمال كونان دويلي
Dialogue: 0,0:15:41.44,0:15:42.54,Default,,0,0,0,,!آرثر
Dialogue: 0,0:15:42.54,0:15:44.96,Default,,0,0,0,,!إسمي آرثر هيراي
Dialogue: 0,0:15:44.96,0:15:47.02,Default,,0,0,0,,آرثر هيراي؟
Dialogue: 0,0:15:47.02,0:15:49.88,Default,,0,0,0,,...أُمّي يابانيّة، لذا
Dialogue: 0,0:15:49.90,0:15:51.72,Default,,0,0,0,,.إسمي سوزوكي سونوكو
Dialogue: 0,0:15:51.72,0:15:53.57,Default,,0,0,0,,.إسمي موري ران
Dialogue: 0,0:15:53.57,0:15:59.43,Default,,0,0,0,,.و الذي هناك هو أبي، موري كوغورو
Dialogue: 0,0:15:59.43,0:16:00.87,Default,,0,0,0,,.سعيدةٌ بلِقائك
Dialogue: 0,0:16:00.87,0:16:02.87,Default,,0,0,0,,...نـ-نعم\N.سعيدٌ بلِقائكِ أيضاً
Dialogue: 0,0:16:02.87,0:16:05.96,Default,,0,0,0,,.أعتذر، ران\N.يجب أن أُغادر لبعض الوَقت
Dialogue: 0,0:16:05.96,0:16:07.07,Default,,0,0,0,,.أوه، حسناً
Dialogue: 0,0:16:08.15,0:16:09.13,Default,,0,0,0,,...هاي، أيّها الطّفل
Dialogue: 0,0:16:09.13,0:16:10.54,Default,,0,0,0,,أين وَالِداك؟
Dialogue: 0,0:16:10.54,0:16:14.20,Default,,0,0,0,,...أوه، أمم\N.يُسافران في اليابان
Dialogue: 0,0:16:14.20,0:16:15.17,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:16:15.17,0:16:17.56,Default,,0,0,0,,و تركاكَ في المنزل وَحدك، آرثر كن؟
Dialogue: 0,0:16:17.56,0:16:20.18,Default,,0,0,0,,.نعم، لكن لا بأس\N.أنا مُعتادٌ على ذلك
Dialogue: 0,0:16:20.18,0:16:21.21,Default,,0,0,0,,...فهمت
Dialogue: 0,0:16:21.21,0:16:23.71,Default,,0,0,0,,بتلك الحال، هل ترغب بمُرافقتنا؟
Dialogue: 0,0:16:23.71,0:16:25.00,Default,,0,0,0,,هل يُمكنني؟
Dialogue: 0,0:16:25.00,0:16:26.75,Default,,0,0,0,,.نعم، بالتّأكيد يُمكنك
Dialogue: 0,0:16:28.57,0:16:29.60,Default,,0,0,0,,!أوه، صحيح
Dialogue: 0,0:16:29.60,0:16:31.17,Default,,0,0,0,,.سأذهب لأطمئنّ على حالة أبي
Dialogue: 0,0:16:31.86,0:16:33.43,Default,,0,0,0,,.بـ-بالتّأكيد
Dialogue: 0,0:16:33.43,0:16:36.22,Default,,0,0,0,,.على أيّة حال، لَقد تأخّر كثيراً
Dialogue: 0,0:16:36.22,0:16:38.20,Default,,0,0,0,,.لأمكنه أن يُرسل لي رسالةً على الأقلّ
Dialogue: 0,0:16:38.20,0:16:41.43,Default,,0,0,0,,...و وَاثقةٌ من أنّه كان يُفترض بنا أن نلتقي في الأعلى هُنا أيضاً
Dialogue: 0,0:16:42.44,0:16:43.69,Default,,0,0,0,,!تحرّكوا\N!أنتُم في طريقنا جميعاً
Dialogue: 0,0:16:43.69,0:16:45.44,Default,,0,0,0,,!أفسِحوا الطّريق
Dialogue: 0,0:16:45.44,0:16:47.44,Default,,0,0,0,,!إلى ماذا تنظرون بحقّ الله؟
Dialogue: 0,0:16:47.44,0:16:49.05,Default,,0,0,0,,من هؤلاء؟
Dialogue: 0,0:16:49.05,0:16:51.96,Default,,0,0,0,,.الذي في الوَسط هو ناكاتومي ريجيرو
Dialogue: 0,0:16:51.96,0:16:53.42,Default,,0,0,0,,...ناكاتومي
Dialogue: 0,0:16:53.42,0:16:56.20,Default,,0,0,0,,.أوه، المُدير العامّ لشرِكة ناكاتومي للشّحن
Dialogue: 0,0:16:56.20,0:16:57.76,Default,,0,0,0,,...يُعرَف بالفِطنة و المَوهبة
Dialogue: 0,0:16:56.66,0:16:59.74,Caracters,,0,0,0,,{\fad(300,300)\pos(954,831)}ناكاتومي ريجيرو (39) عاماً\Nالمُدير العامّ لشرِكة ناكاتومي للشّحن
Dialogue: 0,0:16:57.76,0:17:00.20,Default,,0,0,0,,.لكن هناك بعض الشّائعات السيّئة بشأنه لا تتوَقّف أبداً
Dialogue: 0,0:17:01.12,0:17:04.81,Default,,0,0,0,,.هاي، أيّتها الجّميلة\Nهل أتيتِ إلى سينغافورة وَحدكِ؟
Dialogue: 0,0:17:04.81,0:17:06.50,Default,,0,0,0,,...إن أردتّ، ما رأيكِ بمُرافقتي
Dialogue: 0,0:17:06.50,0:17:08.17,Default,,0,0,0,,.لَيس لَديّ وَقتٌ لهذا الآن
Dialogue: 0,0:17:08.17,0:17:09.29,Default,,0,0,0,,!إبتعد
Dialogue: 0,0:17:10.36,0:17:12.40,Default,,0,0,0,,ألا تُمانعين بقول هذا لي حقّاً؟
Dialogue: 0,0:17:12.40,0:17:16.84,Default,,0,0,0,,.إن رغبت، حشر فتاةٍ وَحيدةٍ مثلكِ في سيّارتي سيكون سهلاً
Dialogue: 0,0:17:14.84,0:17:16.84,Title,,0,0,0,,{\fs60\b1}رسالةٌ جديدة
Dialogue: 0,0:17:14.84,0:17:16.84,Title,,0,0,0,,{\fs60\b1}:إلى
Dialogue: 0,0:17:14.84,0:17:16.84,Title,,0,0,0,,{\fs60\b1}:الموضوع
Dialogue: 0,0:17:14.84,0:17:16.84,Title,,0,0,0,,{\fs60\b1}أظنّكَ لَم تتمكّن من القُدوم بعد؟
Dialogue: 0,0:17:14.84,0:17:16.84,Title,,0,0,0,,{\fs60\b1}!أنتظركَ أمام الميرليون
Dialogue: 0,0:17:17.70,0:17:18.70,Default,,0,0,0,,!سونوكو
Dialogue: 0,0:17:19.60,0:17:21.16,Default,,0,0,0,,!شينتشي؟
Dialogue: 0,0:17:21.16,0:17:23.23,Default,,0,0,0,,.لا تتدخّلي
Dialogue: 0,0:17:23.23,0:17:23.73,Default,,0,0,0,,هاه؟
Dialogue: 0,0:17:24.60,0:17:25.87,Default,,0,0,0,,!هاي
Dialogue: 0,0:17:38.72,0:17:41.79,Default,,0,0,0,,.هي معي\Nماذا تُريد منها؟
Dialogue: 0,0:17:41.79,0:17:43.60,Default,,0,0,0,,!مـ-من أنتَ بحقّ الله؟
Dialogue: 0,0:17:43.60,0:17:45.79,Default,,0,0,0,,!ماكوتو سان! تحتاج لتفقّد رسائلكَ على الأقلّ
Dialogue: 0,0:17:45.79,0:17:48.83,Default,,0,0,0,,.أعتذر\N...لا أُجيد التّعامل مع التّكنولوجيا
Dialogue: 0,0:17:50.94,0:17:52.13,Default,,0,0,0,,!...هذا مُؤلِم
Dialogue: 0,0:17:52.94,0:17:56.22,Default,,0,0,0,,!سأنتقم منكَ على هذا\N!لَن أتساهل معكَ في المرّة القادِمة
Dialogue: 0,0:17:56.22,0:17:59.28,Default,,0,0,0,,!ماكوتو سان\N!لَقد خِفتُ كثيراً
Dialogue: 0,0:17:59.28,0:18:01.66,Default,,0,0,0,,.أعتذر بشدّةٍ على تأخّري
Dialogue: 0,0:18:01.66,0:18:03.70,Default,,0,0,0,,!أنتَ رائعٌ جدّاً، أيّها السيّد
Dialogue: 0,0:18:03.70,0:18:06.89,Default,,0,0,0,,!يُمكنني فِعل هذا أيضاً\N!هيا! هيا! هيا
Dialogue: 0,0:18:06.89,0:18:08.56,Default - E,,0,0,0,,!هاي، يا فتى الكراتيه
Dialogue: 0,0:18:08.73,0:18:10.19,Default - E,,0,0,0,,!يا لشجاعتك
Dialogue: 0,0:18:10.50,0:18:11.79,Default,,0,0,0,,!أوه
Dialogue: 0,0:18:18.16,0:18:20.07,Default - E,,0,0,0,,!هاي، هيّا الآن
Dialogue: 0,0:18:20.07,0:18:21.64,Default,,0,0,0,,هل أنتِ بخير، سونوكو؟
Dialogue: 0,0:18:21.64,0:18:22.16,Default,,0,0,0,,أوه؟
Dialogue: 0,0:18:22.16,0:18:24.91,Default,,0,0,0,,!نعم\N!لأنّ ماكوتو سان حماني
Dialogue: 0,0:18:24.91,0:18:27.31,Default,,0,0,0,,.لَقد مرّت فترةٌ طويلة، كيوغوكو سان
Dialogue: 0,0:18:27.31,0:18:28.81,Default,,0,0,0,,.نعم، بالفِعل
Dialogue: 0,0:18:28.81,0:18:29.92,Default,,0,0,0,,و من أنت؟
Dialogue: 0,0:18:29.92,0:18:32.71,Default,,0,0,0,,.سعيدٌ بلِقائك\N.إسمي كودو شينتشي
Dialogue: 0,0:18:32.71,0:18:34.94,Default,,0,0,0,,.إسمي كيوغوكو ماكوتو
Dialogue: 0,0:18:40.66,0:18:42.91,Default,,0,0,0,,ماكوتو سان، هل من خطب؟
Dialogue: 0,0:18:42.91,0:18:46.85,Default,,0,0,0,,.كلّا، شعرتُ فقط بأنّ هذا لَيس لِقائي الـ1 بكودو كن
Dialogue: 0,0:18:49.21,0:18:50.19,Default,,0,0,0,,...كلّا
Dialogue: 0,0:18:50.19,0:18:51.94,Default,,0,0,0,,!كلّا، وَاثقٌ من أنّكَ تتخيّل الأُمور فقط
Dialogue: 0,0:18:53.21,0:18:56.49,Default,,0,0,0,,الآن، رأينا الميرليون، لذا ماذا لَو ذهبنا إلى الفُندق؟
Dialogue: 0,0:18:56.49,0:18:59.07,Default,,0,0,0,,...أوه، بشأن هذا
Dialogue: 0,0:18:59.07,0:19:00.20,Default,,0,0,0,,هاه؟
Dialogue: 0,0:19:02.64,0:19:05.33,Default,,0,0,0,,!لَم يعُد بإمكانكَ المُشاركة في البُطولة؟
Dialogue: 0,0:19:05.33,0:19:08.33,Default,,0,0,0,,...قطعنا طوال هذه المَسافة لمُشاهدة نِزالكَ أيضاً
Dialogue: 0,0:19:08.33,0:19:10.05,Default,,0,0,0,,.أعتذر
Dialogue: 0,0:19:10.05,0:19:15.34,Default,,0,0,0,,...قبلتُ دعوَة أحدهم و شاركتُ في بُطولة اليوم
Dialogue: 0,0:19:15.34,0:19:17.05,Default,,0,0,0,,بمَعنىً آخر، راعٍ؟
Dialogue: 0,0:19:17.05,0:19:17.59,Default,,0,0,0,,.نعم
Dialogue: 0,0:19:17.59,0:19:21.41,Default,,0,0,0,,...شيريلين تان، إمرأةٌ تعمل كمُحامية
Dialogue: 0,0:19:21.41,0:19:24.91,Default,,0,0,0,,.سألَت إن أمكنني المُشاركة، و قالَت بأنّها ستُغطّي جميع نفقات سفري و إقامتي
Dialogue: 0,0:19:24.91,0:19:28.06,Default,,0,0,0,,.لكنّها ماتت فجأة
Dialogue: 0,0:19:29.18,0:19:31.75,Default,,0,0,0,,...و اليوم، شخصٌ له صِلةٌ بها
Dialogue: 0,0:19:31.75,0:19:34.63,Default,,0,0,0,,.أخبرَني بأن أتصرّف كما لَو أنّها لَم تُكلّمني بشأن أيّ شيء
Dialogue: 0,0:19:34.63,0:19:35.94,Default,,0,0,0,,!مُستحيل
Dialogue: 0,0:19:35.94,0:19:41.36,Default,,0,0,0,,.من يُقال بأنّهم أقوى خُبراء فُنونٍ قِتاليّةٍ في سينغافورة سيُشاركون في هذه البُطولة
Dialogue: 0,0:19:41.36,0:19:44.37,Default,,0,0,0,,...هُم خُصومٌ أردتّ بشدّةٍ مُحاولة قِتالهم، و لَو لمرّةٍ فقط
Dialogue: 0,0:19:44.37,0:19:45.89,Default,,0,0,0,,!حسناً
Dialogue: 0,0:19:45.89,0:19:48.58,Default,,0,0,0,,!سأكون راعيتك
Dialogue: 0,0:19:48.58,0:19:49.31,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:19:49.31,0:19:51.33,Default,,0,0,0,,!أُترك الأمر لي فقط
Dialogue: 0,0:19:51.33,0:19:55.50,Default,,0,0,0,,.هي بالفِعل إبنة عائلة مَجموعة سوزوكي الماليّة
Dialogue: 0,0:19:55.50,0:19:56.50,Title,,0,0,0,,{=274}{\fs60\b1}عمّي جيروكيتشي
Dialogue: 0,0:19:55.50,0:19:55.70,Title,,0,0,0,,{=275}{\fs60\b1}المُكالَمة جارية
Dialogue: 0,0:19:55.70,0:19:56.50,Title,,0,0,0,,{=275}{\fs60\b1}إنتهَت المُكالَمة
Dialogue: 0,0:19:57.34,0:19:59.13,Default,,0,0,0,,!تمّ التّكفّل بكلّ شيء
Dialogue: 0,0:19:59.13,0:20:02.66,Default,,0,0,0,,!ماكوتو سان، تمكّنتُ من إعادة إدخالكَ كمُنافسٍ مَدعوّ
Dialogue: 0,0:20:02.66,0:20:04.33,Default,,0,0,0,,!حقّاً، سونوكو سان؟
Dialogue: 0,0:20:04.33,0:20:05.46,Default,,0,0,0,,!نعم
Dialogue: 0,0:20:06.74,0:20:09.64,Default,,0,0,0,,.و جعلتُهم يجعلون فُندق ماكوتو سان نفس فُندقنا
Dialogue: 0,0:20:09.64,0:20:11.44,Default,,0,0,0,,!لذا فهذا مَوعدٌ مُزدوج
Dialogue: 0,0:20:13.12,0:20:14.65,Default,,0,0,0,,بالفِعل، صحيح؟
Dialogue: 0,0:20:14.65,0:20:17.65,Default,,0,0,0,,إن تكلّمتُم و قُمتُم بتسوية كلّ شيء، ماذا لَو عُدنا إلى الفُندق، هاه؟
Dialogue: 0,0:20:17.65,0:20:20.01,Default,,0,0,0,,!أُريد أن أُسرِع و أشرَب بعض البيرة
Dialogue: 0,0:20:20.01,0:20:21.40,Default,,0,0,0,,!موري سان
Dialogue: 0,0:20:22.01,0:20:24.72,Default,,0,0,0,,هل يُمكن أنّكَ موري كوغورو سان؟
Dialogue: 0,0:20:24.72,0:20:26.16,Default,,0,0,0,,...هاه؟ نعم
Dialogue: 0,0:20:26.16,0:20:29.42,Default,,0,0,0,,.إسمي ريشي، ضابطٌ إحتياطيّ
Dialogue: 0,0:20:29.42,0:20:30.83,Default,,0,0,0,,.يُشرّفني لِقاؤك
Dialogue: 0,0:20:30.83,0:20:33.08,Default,,0,0,0,,...أوه-هاه\N.أنا أيضاً
Dialogue: 0,0:20:33.08,0:20:36.77,Default,,0,0,0,,...أمم\Nضابطٌ إحتياطيّ؟
Dialogue: 0,0:20:36.77,0:20:37.34,Default,,0,0,0,,!هذا صحيح
Dialogue: 0,0:20:37.34,0:20:40.41,Default,,0,0,0,,...مُتخصّصٌ بسايكولوجيّة التّصرّف الإجراميّ
Dialogue: 0,0:20:40.41,0:20:43.61,Default,,0,0,0,,.حصلتُ على إذنٍ خاصٍّ لأُشارك في التّحقيقات
Dialogue: 0,0:20:43.61,0:20:45.11,Default,,0,0,0,,أوه، حقّاً؟
Dialogue: 0,0:20:45.11,0:20:46.09,Default,,0,0,0,,...في الوَاقع
Dialogue: 0,0:20:46.09,0:20:50.35,Default,,0,0,0,,.كنتُ بانتظاركَ منذ أن سمعتُ بدُخولكَ الدّولة، موري سان
Dialogue: 0,0:20:50.35,0:20:51.91,Default,,0,0,0,,كنتَ بانتظاري؟
Dialogue: 0,0:20:51.91,0:20:55.25,Default,,0,0,0,,.نعم، لأنّ مُعظم السّائحين يأتون إلى هُنا
Dialogue: 0,0:20:55.25,0:20:58.00,Default,,0,0,0,,لـ-لكن لِمَ أنا؟
Dialogue: 0,0:20:58.00,0:21:02.11,Default,,0,0,0,,.هناك في الوَاقع قضيّةٌ أرغب بأن تُساعد فيها، أيّها المُتحرّي موري
Dialogue: 0,0:21:02.11,0:21:02.86,Default,,0,0,0,,هاه؟
Dialogue: 0,0:21:02.86,0:21:04.32,Default,,0,0,0,,!مُستحيل
Dialogue: 0,0:21:04.32,0:21:06.16,Default,,0,0,0,,!أنا في مُنتصف إجازتي الآن
Dialogue: 0,0:21:06.16,0:21:06.89,Default,,0,0,0,,.هاي، إنتظر
Dialogue: 0,0:21:06.89,0:21:10.01,Default,,0,0,0,,.أظنّ أنّه سيكون من الأفضل مُجاراته هُنا
Dialogue: 0,0:21:10.01,0:21:11.50,Default,,0,0,0,,ماذا؟ لماذا؟
Dialogue: 0,0:21:11.50,0:21:14.83,Default,,0,0,0,,...إن كانت علاقتكَ مع ضابطٍ إحتياطيٍّ جيّدة
Dialogue: 0,0:21:14.83,0:21:17.75,Default,,0,0,0,,.قد تتمكّن من جعله يدلّكَ على أماكن مُمتازةٍ و رخيصةٍ جدّاً لزيارتها
Dialogue: 0,0:21:17.75,0:21:21.00,Default,,0,0,0,,...رُبّما كازينوهات حتّى\Nتفهمني، صحيح؟
Dialogue: 0,0:21:21.00,0:21:22.82,Default,,0,0,0,,...أوه، حسناً
Dialogue: 0,0:21:22.82,0:21:25.09,Default,,0,0,0,,.قد تكون مُحقّاً
Dialogue: 0,0:21:26.60,0:21:27.73,Default,,0,0,0,,!حسناً
Dialogue: 0,0:21:27.73,0:21:31.14,Default,,0,0,0,,!أنا، المُتحرّي العظيم موري كوغورو، سأقوم باستثناءٍ خاصٍّ و سأُساعدك
Dialogue: 0,0:21:31.14,0:21:33.14,Default,,0,0,0,,...أوه، يا إلهي
Dialogue: 0,0:21:31.14,0:21:33.14,Up,,0,0,0,,!ياله من شرَفٍ لي
Dialogue: 0,0:21:33.14,0:21:36.42,Default,,0,0,0,,...مُتحرّي موري، أنتَ بطلٌ في دولة أبي، اليابان
Dialogue: 0,0:21:36.42,0:21:38.15,Default,,0,0,0,,!و أنا من أشدّ مُعجبيكَ أيضاً
Dialogue: 0,0:21:39.38,0:21:43.32,Default,,0,0,0,,.تمّ تسليم هذه في الوَاقع إلى منزل رجل أعمالٍ مُحدّد
Dialogue: 0,0:21:44.63,0:21:46.20,Default,,0,0,0,,!هذا مُذهل
Dialogue: 0,0:21:46.20,0:21:49.62,Title,,0,0,0,,{\b1\fs60}إشعارٌ مُسبق
Dialogue: 0,0:21:46.20,0:21:49.62,Title,,0,0,0,,{\b1\fs60}،سآتي لأخذ الكنز الأُسطوريّ: الياقوتة الزّرقاء، التي يحميها الأسد\N.التي تُصدِر لَمعةً زرقاء سماويّة
Dialogue: 0,0:21:46.20,0:21:49.62,Title,,0,0,0,,{\b1\fs60}كايتو كيد
Dialogue: 0,0:21:46.20,0:21:49.30,Default,,0,0,0,,!كايتو كيد-\N!كايتو كيد ساما-
Dialogue: 0,0:21:51.28,0:21:54.12,Title,,0,0,0,,{\fad(300,300)\pos(1065,741)}منزل ليون
Dialogue: 0,0:21:54.20,0:21:57.54,Default - E,,0,0,0,,...وَصلَني تقريرٌ بأنّ مَجموعة سوزوكي أصبحَت الرّاعي
Dialogue: 0,0:21:57.54,0:21:58.79,Default - E,,0,0,0,,.لكيوغوكو...
Dialogue: 0,0:21:58.79,0:22:00.42,Default - E,,0,0,0,,هل يُمكنكَ هزيمته؟
Dialogue: 0,0:22:00.42,0:22:01.96,Default - E,,0,0,0,,.لا حاجة للقلَق
Dialogue: 0,0:22:01.96,0:22:03.51,Up,,0,0,0,,...مهمن كان
Dialogue: 0,0:22:02.21,0:22:05.22,Caracters,,0,0,0,,{\fad(300,300)\pos(957,856.5)}هيزري جمال الدّين (25) عاماً\Nرئيس أمن ليون
Dialogue: 0,0:22:03.51,0:22:05.97,Up,,0,0,0,,.سأهزِمه بضربةٍ وَاحدة
Dialogue: 0,0:22:05.97,0:22:07.43,Default - E,,0,0,0,,.من الجيّد مَعرفة ذلك
Dialogue: 0,0:22:08.59,0:22:09.64,Default - E,,0,0,0,,.تفضّل بالدّخول
Dialogue: 0,0:22:09.80,0:22:10.97,Default - E,,0,0,0,,.عُذراً
Dialogue: 0,0:22:11.39,0:22:14.14,Up,,0,0,0,,...وَصل السيّد راماناثان مع شخصٍ ما
Dialogue: 0,0:22:11.47,0:22:14.47,Caracters,,0,0,0,,{\fad(300,300)\pos(972,852)}رايتشل تشيونغ (29) عاماً\Nسكرتيرة ليون
Dialogue: 0,0:22:14.14,0:22:15.48,Up,,0,0,0,,.يرغب بتعريفكَ به...
Dialogue: 0,0:22:15.64,0:22:16.94,Default - E,,0,0,0,,.إنّه مُبكّر
Dialogue: 0,0:22:16.94,0:22:19.19,Default - E,,0,0,0,,.أرجوكِ خُذيه إلى الإستراحة
Dialogue: 0,0:22:19.19,0:22:20.61,Default - E,,0,0,0,,.عُلِم
Dialogue: 0,0:22:21.77,0:22:23.86,Default - E,,0,0,0,,إذاً، ماذا عن كيد؟
Dialogue: 0,0:22:24.07,0:22:26.99,Default - E,,0,0,0,,.أعتذر. مازلنا نتحرّى الأمر
Dialogue: 0,0:22:27.45,0:22:29.49,Default - E,,0,0,0,,...مع شيريلين تان
Dialogue: 0,0:22:29.49,0:22:32.66,Default - E,,0,0,0,,.هناك مَشاكل بالتّعامل مع المَعلومات
Dialogue: 0,0:22:32.66,0:22:34.87,Default - E,,0,0,0,,.لَديّ حدسٌ بهويّة من خلف الأمر
Dialogue: 0,0:22:34.87,0:22:36.75,Default - E,,0,0,0,,.إعتني بالأمر إذاً
Dialogue: 0,0:22:36.75,0:22:39.21,Default,,0,0,0,,!هواه\N!هذا مُذهل
Dialogue: 0,0:22:39.21,0:22:41.13,Default,,0,0,0,,!إهدأ، أبي
Dialogue: 0,0:22:41.13,0:22:42.98,Default,,0,0,0,,...أوه! حتّى هذه البذلة المُدرّعة
Dialogue: 0,0:22:42.98,0:22:44.80,Default,,0,0,0,,!هذا مُذهلٌ جدّاً
Dialogue: 0,0:22:47.36,0:22:47.72,Default,,0,0,0,,!هواه
Dialogue: 0,0:22:49.13,0:22:49.85,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:22:50.74,0:22:51.78,Default,,0,0,0,,هل أنتَ بخير؟
Dialogue: 0,0:22:51.78,0:22:52.89,Default,,0,0,0,,...نـ-نعم
Dialogue: 0,0:22:52.89,0:22:55.97,Default,,0,0,0,,!أبي\N.تمالك نفسك
Dialogue: 0,0:22:55.97,0:22:59.06,Up,,0,0,0,,.أعتذر\N.أعتذر بشأن أبي
Dialogue: 0,0:22:58.04,0:23:01.33,Default,,0,0,0,,إذاً من هو ليون لو بالضّبط؟
Dialogue: 0,0:23:01.33,0:23:05.46,Default,,0,0,0,,...كان ليون سينساي بالأساس عالِماً مَشهوراً في سايكولوجيّة التّصرّف الإجراميّ
Dialogue: 0,0:23:05.46,0:23:09.49,Default,,0,0,0,,.قبضَ على عددٍ لا يُحصى من القتلَة البشعين بتعاونه مع الشّرطة
Dialogue: 0,0:23:09.49,0:23:10.57,Default,,0,0,0,,...هيه
Dialogue: 0,0:23:10.57,0:23:13.58,Default,,0,0,0,,إذاً بالأساس، هو أعظم مُتحرٍّ في سينغافورة؟
Dialogue: 0,0:23:13.58,0:23:15.89,Default,,0,0,0,,...تركَ قوّات الشّرطة قبل عامين
Dialogue: 0,0:23:15.89,0:23:20.08,Default,,0,0,0,,.و هو حاليّاً ناجحٌ جدّاً كالمُدير العامّ لشرِكة أمن
Dialogue: 0,0:23:20.08,0:23:24.50,Default,,0,0,0,,.درستُ أيضاً سايكولوجيّة التّصرّف الإجراميّ من ليون سينساي
Dialogue: 0,0:23:24.50,0:23:25.84,Default,,0,0,0,,.أوه، فهمت
Dialogue: 0,0:23:25.84,0:23:28.61,Default,,0,0,0,,إذاً وَصل الإشعار المُسبق إلى ليون هذا؟
Dialogue: 0,0:23:28.61,0:23:31.09,Default,,0,0,0,,.كلّا، سأشرَح كلّ شيءٍ بالتّرتيب
Dialogue: 0,0:23:31.09,0:23:33.09,Default,,0,0,0,,.أوّلاً، أُنظُرا إلى هذا رجاءً
Dialogue: 0,0:23:33.09,0:23:37.95,Default,,0,0,0,,."يسعى كايتو كيد خلف جوهرةٍ تُدعى بـ"قبضة الياقوتة الزّرقاء
Dialogue: 0,0:23:37.95,0:23:40.77,Default,,0,0,0,,.إنّها ملك السيّد زونهان تشين، هو رجل أعمال
Dialogue: 0,0:23:40.77,0:23:44.13,Default,,0,0,0,,.وَصل الإشعار المُسبق من كيد إليه
Dialogue: 0,0:23:44.13,0:23:48.01,Default,,0,0,0,,بتلك الحال، ألا يجدُر بنا الذّهاب إلى منزل زونهان ذاك أو مهما كان اسمه...؟
Dialogue: 0,0:23:48.01,0:23:52.41,Default,,0,0,0,,.الجّوهرة مُخزّنةٌ في الوَاقع تحت الأرض تحت هذا المَبنى
Dialogue: 0,0:23:52.41,0:23:54.66,Default,,0,0,0,,الجّوهرة هُنا؟
Dialogue: 0,0:23:54.66,0:23:57.77,Default,,0,0,0,,.نعم\N.هذه رغبة مالِكها
Dialogue: 0,0:23:57.77,0:24:01.48,Default,,0,0,0,,...الخزنات هُنا تستخدِم أحدث تقنيّات أنظمة الأمن المُطوّرة بشكلٍ مُستقلّ
Dialogue: 0,0:24:01.48,0:24:02.92,Default,,0,0,0,,...ممّا يجعلها أءمن من خزينة بنك
Dialogue: 0,0:24:02.92,0:24:04.77,Default,,0,0,0,,أحدث تقنيّات، هاه؟
Dialogue: 0,0:24:04.77,0:24:08.30,Default,,0,0,0,,.يبدو بأنّ كيد اللّعين ذاك سيُعاني من وَقتٍ عصيبٍ هذه المرّة
Dialogue: 0,0:24:08.30,0:24:10.13,Default,,0,0,0,,.لا يحقّ لكَ أن تتكلّم
Dialogue: 0,0:24:10.13,0:24:11.42,Default,,0,0,0,,!ما الذي تتكلّم عنه؟
Dialogue: 0,0:24:11.42,0:24:13.76,Default,,0,0,0,,...مهما كانت الخزنة حديثة التّقنيّة
Dialogue: 0,0:24:13.76,0:24:16.14,Default,,0,0,0,,!ستكون سهلةً عندما يتعلّق الأمر بكيد ساما
Dialogue: 0,0:24:16.14,0:24:17.16,Default,,0,0,0,,...هاي، سونوكو
Dialogue: 0,0:24:17.16,0:24:21.89,Default,,0,0,0,,ألا تعرفين عن تقنيّات سرِقة كيد ساما الرّائعة، ران؟
Dialogue: 0,0:24:21.89,0:24:26.02,Default,,0,0,0,,...يُمكنه حتّى سرِقة قُلوب جميع نِساء العالَم
Dialogue: 0,0:24:26.02,0:24:27.63,Default,,0,0,0,,!توَقّفي، سونوكو
Dialogue: 0,0:24:27.63,0:24:28.65,Default,,0,0,0,,هاه؟
Dialogue: 0,0:24:30.63,0:24:31.28,Default,,0,0,0,,!أوه
Dialogue: 0,0:24:32.49,0:24:33.03,Default,,0,0,0,,...حسناً
Dialogue: 0,0:24:33.03,0:24:35.70,Default,,0,0,0,,...حسناً\N.أعني عداي أنا و ران
Dialogue: 0,0:24:35.70,0:24:36.87,Default,,0,0,0,,!صحيح، ران؟
Dialogue: 0,0:24:36.87,0:24:38.54,Default,,0,0,0,,.نـ-نعم، بالتّأكيد
Dialogue: 0,0:24:43.77,0:24:46.31,Default,,0,0,0,,.لَن تخرُج سالِماً إن كنتَ مُهمِلاً
Dialogue: 0,0:24:46.31,0:24:48.32,Default,,0,0,0,,...أوه، إرحمني
Dialogue: 0,0:24:49.15,0:24:51.07,Default,,0,0,0,,!يالها من حديقةٍ داخليّةٍ جميلة
Dialogue: 0,0:24:51.07,0:24:52.44,Default,,0,0,0,,.إنّها جيّدة
Dialogue: 0,0:24:52.44,0:24:54.18,Default,,0,0,0,,.سعيدٌ بلِقائكم جميعاً
Dialogue: 0,0:24:54.18,0:24:56.55,Default,,0,0,0,,.إسمي ليون لو
Dialogue: 0,0:24:56.55,0:25:01.14,Default,,0,0,0,,.و هذا الرّجل هو حارسي الشّخصيّ و مَسؤول الأمن، هيزري جمال الدّين
Dialogue: 0,0:25:01.14,0:25:03.46,Default,,0,0,0,,.أرجوكم اسمحوا له بأن ينضمّ إلينا
Dialogue: 0,0:25:08.77,0:25:10.23,Default - E,,0,0,0,,.سيّد كيوغوكو
Dialogue: 0,0:25:11.11,0:25:13.11,Default - E,,0,0,0,,.أملتُ بأن ألقاك
Dialogue: 0,0:25:13.40,0:25:14.36,Default - E,,0,0,0,,.شُكراً لك
Dialogue: 0,0:25:14.36,0:25:15.99,Default - E,,0,0,0,,.أُمارس الكراتيه أيضاً
Dialogue: 0,0:25:15.99,0:25:18.99,Default - E,,0,0,0,,.أردتّ أن أُنازلكَ دائماً
Dialogue: 0,0:25:19.58,0:25:22.09,Up,,0,0,0,,.يُشارك ناديّ في هذا النّزال
Dialogue: 0,0:25:20.14,0:25:20.99,Default,,0,0,0,,!أوه
Dialogue: 0,0:25:20.99,0:25:23.98,Default,,0,0,0,,إذاً أنتَ المُتحرّي الشّهير موري كوغورو سان؟
Dialogue: 0,0:25:22.09,0:25:24.77,Up,,0,0,0,,هل يُمكننا أن نتدرّب معاً اللّيلة؟
Dialogue: 0,0:25:23.98,0:25:26.42,Default,,0,0,0,,.أوه، بالتّأكيد، شُكراً لك
Dialogue: 0,0:25:24.77,0:25:28.29,Up,,0,0,0,,.يبدو هذا عظيماً\N.أرجوكَ اسمح لي بالإنضمام إليك
Dialogue: 0,0:25:26.42,0:25:30.50,Default,,0,0,0,,.لَم أتوَقّع أبداً رُؤية هذا العدد الكبير من الأشخاص في دولةٍ أجنبيّةٍ يعرفون إسمي
Dialogue: 0,0:25:31.15,0:25:32.23,Default - E,,0,0,0,,.هذا غريب
Dialogue: 0,0:25:33.03,0:25:34.86,Default - E,,0,0,0,,.لا أشعر بأيّ شيء
Dialogue: 0,0:25:34.86,0:25:36.34,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:25:40.51,0:25:41.77,Default - E,,0,0,0,,.مُستحيل
Dialogue: 0,0:25:41.77,0:25:45.27,Default,,0,0,0,,.و أنتَ مُتحرّي الثّانويّة، كودو شينتشي سان
Dialogue: 0,0:25:45.27,0:25:46.66,Default,,0,0,0,,.سعيدٌ بلِقائك
Dialogue: 0,0:25:47.27,0:25:50.69,Default,,0,0,0,,.تبدو أشبه بساحِرٍ عن كونكَ مُتحرٍّ
Dialogue: 0,0:25:50.69,0:25:51.57,Default,,0,0,0,,!ماذا...؟
Dialogue: 0,0:25:52.46,0:25:54.07,Default,,0,0,0,,.يُمكنني مَعرفة هذا من أصابعك
Dialogue: 0,0:25:54.07,0:25:55.97,Default,,0,0,0,,.هي نحيلةٌ و مرِنة
Dialogue: 0,0:25:55.97,0:25:59.01,Default,,0,0,0,,...أنا مُتحرٍّ مع ذلك، لذا بدلاً من القوّة البدنيّة
Dialogue: 0,0:25:59.01,0:26:01.08,Default,,0,0,0,,.أُفضّل التّحدّيات التي تُحرّك عقلي
Dialogue: 0,0:26:01.56,0:26:02.99,Default,,0,0,0,,.فهمت
Dialogue: 0,0:26:02.99,0:26:07.87,Default,,0,0,0,,أوه، أفترض بأنّ الشّابّة هناك هي سوزوكي سونوكو سان؟
Dialogue: 0,0:26:07.87,0:26:10.63,Default,,0,0,0,,.لا يُمكننا إخفاض دِفاعاتنا حول هذا الرّجل
Dialogue: 0,0:26:10.94,0:26:13.13,Default - E,,0,0,0,,!لا يُمكنكَ الدّخول! إنتظر رجاءً
Dialogue: 0,0:26:13.28,0:26:15.53,Default - E,,0,0,0,,.لا بأس. لا تُكلّفي نفسكِ العناء
Dialogue: 0,0:26:15.53,0:26:18.13,Default,,0,0,0,,!أوه\N!موري كوغورو سينساي
Dialogue: 0,0:26:18.13,0:26:21.16,Default,,0,0,0,,!أنا و زوجتي من أشدّ مُعجبيك
Dialogue: 0,0:26:18.59,0:26:21.68,Caracters,,0,0,0,,{\fad(300,300)\pos(1278,864)}زونهان تشين (70) عاماً\Nصاحب نُفوذٍ في العالَم الماليّ في سينغافورة
Dialogue: 0,0:26:21.16,0:26:22.39,Default,,0,0,0,,.حـ-حسناً
Dialogue: 0,0:26:22.39,0:26:24.64,Default,,0,0,0,,هل يُمكنني التقاط صورةٍ معك؟
Dialogue: 0,0:26:24.64,0:26:26.89,Up,,0,0,0,,صـ-صورة؟\N!أوه، تعني صورة
Dialogue: 0,0:26:25.02,0:26:27.98,Default - E,,0,0,0,,...أعتذر. دخل فجأة
Dialogue: 0,0:26:26.89,0:26:29.15,Up,,0,0,0,,!حسناً، حسناً\N!سيُسعدني ذلك
Dialogue: 0,0:26:27.98,0:26:29.10,Default - E,,0,0,0,,.لا بأس
Dialogue: 0,0:26:29.10,0:26:32.82,Default - E,,0,0,0,,.أرغب بأن أُري الجّميع غُرفتنا الآمنة
Dialogue: 0,0:26:32.82,0:26:33.61,Default - E,,0,0,0,,!هذا جيّد
Dialogue: 0,0:26:33.61,0:26:35.61,Default - E,,0,0,0,,!أرغب بالإنضمام إليكم
Dialogue: 0,0:26:35.61,0:26:39.99,Default,,0,0,0,,.و بأيّ وَسيلة، سأُحبّ أن ترى قبضة الياقوتة الزّرقاء عن قُرب
Dialogue: 0,0:26:41.64,0:26:45.79,Default,,0,0,0,,.الغُرفة الآمنة خلف هذا الباب، هي مَصدر فخري و اعتزازي
Dialogue: 0,0:26:45.79,0:26:50.29,Default,,0,0,0,,.فقط قِلّةٌ مُختارةٌ من الأشخاص يُمكنهم فتحها
Dialogue: 0,0:27:04.86,0:27:07.74,Default,,0,0,0,,...سطح الجّدران مَصنوعٌ من خام معادنٍ مُقاومةٍ للحرارة
Dialogue: 0,0:27:07.74,0:27:09.27,Default,,0,0,0,,.لذا بالتّأكيد لا يُمكن لأحدٍ تدميرها
Dialogue: 0,0:27:09.27,0:27:09.98,Default - E,,0,0,0,,!لماذا؟
Dialogue: 0,0:27:09.85,0:27:13.27,Up,,0,0,0,,.أيضاً، كلّ شيءٍ مَعزولٌ بالكامل عن الخارج
Dialogue: 0,0:27:10.85,0:27:12.61,Default - E,,0,0,0,,!أعتذر، أعتذر! لا شيء
Dialogue: 0,0:27:13.27,0:27:16.38,Default,,0,0,0,,.و مُعدٌّ ليتمّ نقل كلّ جُزءٍ من الحُمولة دوريّاً إلى مَوقعٍ مُختلِف
Dialogue: 0,0:27:16.38,0:27:19.22,Default,,0,0,0,,...هذه الخزنة مَصنوعةٌ خصّيصاً، مُدمَجةٌ بمفاهيمي الخاصّة
Dialogue: 0,0:27:19.22,0:27:22.51,Default,,0,0,0,,.ممّا يعني بأنّه لا مثيل لها في العالَم
Dialogue: 0,0:27:23.87,0:27:25.35,Default,,0,0,0,,!ما-ماذا يحصل؟
Dialogue: 0,0:27:25.35,0:27:28.41,Default,,0,0,0,,.جميعكم، تراجعوا قليلاً رجاءً
Dialogue: 0,0:27:30.48,0:27:35.80,Default,,0,0,0,,.تُدعى هذه الجّوهرة بـ"قبضة الياقوتة الزّرقاء"، يُقال بأنّها رمز ملِك جميع القراصنة
Dialogue: 0,0:27:36.30,0:27:38.88,Up,,0,0,0,,.إنّها كنزٌ ثقافيٌّ ضخم
Dialogue: 0,0:27:37.30,0:27:38.89,Default,,0,0,0,,هل يُمكنكَ رُؤيتها، آرثر كن؟
Dialogue: 0,0:27:38.89,0:27:40.80,Default,,0,0,0,,!نعم! شُكراً
Dialogue: 0,0:27:40.80,0:27:42.08,Default,,0,0,0,,.فهمت
Dialogue: 0,0:27:42.08,0:27:46.31,Default,,0,0,0,,.مادامت هُنا، وَاثقٌ أنّ كيد حتّى لَن يتمكّن من التّدخّل بأمرها
Dialogue: 0,0:27:46.31,0:27:48.87,Default,,0,0,0,,.لَن يستمرّ الوَضع هكذا
Dialogue: 0,0:27:48.87,0:27:51.14,Default,,0,0,0,,...بينما تُعقَد بُطولة الكراتيه التي ستبدأ غداً
Dialogue: 0,0:27:51.14,0:27:53.90,Default,,0,0,0,,.تقرّر عرض الحِزام في الإستاد
Dialogue: 0,0:27:53.90,0:27:56.77,Default,,0,0,0,,...بمَعنىً آخر، خلال فترة البُطولة
Dialogue: 0,0:27:56.77,0:27:59.78,Default,,0,0,0,,.ستُحفَظ بأمانٍ في غُرفةٍ في الإستاد
Dialogue: 0,0:27:59.78,0:28:03.57,Default,,0,0,0,,.ستُوضَع تحت إجراءاتٍ أمنيّةٍ مُشدّدة، لكنّها مع ذلك لا تُقارَن بالتي هُنا
Dialogue: 0,0:28:03.57,0:28:04.14,Default,,0,0,0,,.فهمت
Dialogue: 0,0:28:04.20,0:28:06.78,Default - E,,0,0,0,,...لكن يُوجد أيضاً أمنٌ يخصّ الإستاد
Dialogue: 0,0:28:07.74,0:28:10.79,Default - E,,0,0,0,,!نعم. سنحرسها مهما كلّف الأمر
Dialogue: 0,0:28:12.54,0:28:14.29,Default - E,,0,0,0,,...إن أصاب القبضة أيّ خطب
Dialogue: 0,0:28:14.29,0:28:18.55,Default - E,,0,0,0,,.ستدفع رُسوم تعويضٍ هائلة
Dialogue: 0,0:28:19.26,0:28:22.18,Default,,0,0,0,,...قلتَ بأنّ الإجراءات الأمنيّة ضعيفةٌ مُقارنةً بالتي هُنا
Dialogue: 0,0:28:22.18,0:28:27.31,Default,,0,0,0,,لكن هذا يعني أنّكَ تظنّ بأنّ كيد ينتظر حتّى تُنقَل الياقوتة الزّرقاء إلى الإستاد، صحيح؟
Dialogue: 0,0:28:27.31,0:28:28.51,Default,,0,0,0,,.بالضّبط
Dialogue: 0,0:28:28.51,0:28:31.12,Default,,0,0,0,,.ستكون مُخاطرةً كبيرةً جدّاً السّعي للحصول عليها هُنا
Dialogue: 0,0:28:31.12,0:28:32.19,Default,,0,0,0,,.هذا مُؤكّد
Dialogue: 0,0:28:32.19,0:28:36.19,Default,,0,0,0,,.إذاً بينما لا يُمكنني فِعل الكثير، أرجوكَ اسمح لي بالمُساعدة بحِراسة الجّوهرة
Dialogue: 0,0:28:36.19,0:28:38.69,Default,,0,0,0,,.أوه، شُكراً لك
Dialogue: 0,0:29:07.01,0:29:08.18,Default,,0,0,0,,!هذا سهل
Dialogue: 0,0:29:10.33,0:29:11.66,Default,,0,0,0,,!هواه
Dialogue: 0,0:29:24.70,0:29:26.74,Default,,0,0,0,,!شُكراً على البصمات
Dialogue: 0,0:29:40.11,0:29:41.84,Default,,0,0,0,,ألَيس هذا... سهلاً جدّاً؟
Dialogue: 0,0:29:47.16,0:29:48.26,Default,,0,0,0,,.كنتُ بانتظارك
Dialogue: 0,0:29:51.08,0:29:57.02,Default,,0,0,0,,.قطعكَ طوال المَسافة إلى هُنا هو ما توَقّعتُه منكَ بالضّبط، كايتو كيد
Dialogue: 0,0:29:57.02,0:29:59.27,Default,,0,0,0,,.أنتَ وَاثقٌ بنفسكَ بالتّأكيد
Dialogue: 0,0:29:59.27,0:30:03.86,Default,,0,0,0,,.أعتذر، لكن لا يُمكنني السّماح لكَ بأخذ الجّوهرة
Dialogue: 0,0:30:03.86,0:30:06.93,Default,,0,0,0,,.لأنّني لا أرغب بدَفع رُسوم التّعويض لزونهان تشين و ما إلى ذلك
Dialogue: 0,0:30:08.13,0:30:11.72,Default,,0,0,0,,.سرِقة مثل هذا الكنز هو عمَلي
Dialogue: 0,0:30:11.72,0:30:15.08,Default,,0,0,0,,...و كلّما كانت سرِقة شيءٍ أصعب
Dialogue: 0,0:30:15.08,0:30:18.02,Default,,0,0,0,,!كلّما تحمّستُ أكثر
Dialogue: 0,0:30:29.43,0:30:30.64,Default - E,,0,0,0,,.إنتهى الأمر
Dialogue: 0,0:30:37.73,0:30:40.52,Default - E,,0,0,0,,.آمَل أن يُعجبكَ مَذاق مياه سينغافورة
Dialogue: 0,0:31:01.98,0:31:05.90,Default,,0,0,0,,!لَم أتوَقّع أبداً أن يستخدِم الصّاعق عليّ
Dialogue: 0,0:31:39.54,0:31:40.71,Default,,0,0,0,,!كيد
Dialogue: 0,0:31:43.94,0:31:45.59,Default,,0,0,0,,!هل يحصل هذا حقّاً؟
Dialogue: 0,0:31:47.00,0:31:47.88,Default - E,,0,0,0,,!ماذا بحقّ الله...؟
Dialogue: 0,0:31:54.47,0:31:55.43,Default - E,,0,0,0,,ماذا حصل؟
Dialogue: 0,0:31:55.56,0:31:56.54,Default - E,,0,0,0,,!إنّه كيد
Dialogue: 0,0:31:57.06,0:31:59.43,Default - E,,0,0,0,,...لا تقلَق. أنا دائماً
Dialogue: 0,0:32:01.54,0:32:06.44,Default,,0,0,0,,!من في القِمّة يتصرّفون دائماً آخذين بعين الإعتبار أسوأ نتيجةٍ مُمكنة
Dialogue: 0,0:32:06.44,0:32:08.44,Default - E,,0,0,0,,.أتقدّم بخُطوة...
Dialogue: 0,0:32:08.44,0:32:11.20,Default,,0,0,0,,!يجب أن أخرُج من هُنا بسرعة
Dialogue: 0,0:32:20.75,0:32:21.62,Default - E,,0,0,0,,!إنّه هناك
Dialogue: 0,0:32:45.50,0:32:47.34,Default,,0,0,0,,!يالها من لَكمة
Dialogue: 0,0:32:47.34,0:32:49.65,Default,,0,0,0,,!لكنتُ في وَرطةٍ لَو لَم أطِر عكسياً
Dialogue: 0,0:32:49.65,0:32:53.65,Default,,0,0,0,,أنتَ تتعدّى على مُلكيّةٍ خاصّة، صحيح؟
Dialogue: 0,0:32:53.65,0:32:56.66,Default,,0,0,0,,إنتظر، ماذا تفعل هُنا؟
Dialogue: 0,0:32:56.66,0:33:00.29,Default,,0,0,0,,.دُعيتُ للقُدوم إلى هُنا إن أردتّ أن أتدرّب
Dialogue: 0,0:33:00.29,0:33:02.96,Default,,0,0,0,,.لَم أتوَقّع أبداً بأنّني سأتمكّن من مُنازلتكَ هُنا
Dialogue: 0,0:33:02.96,0:33:04.92,Default,,0,0,0,,...كلّا، كلّا، كلّا\N!لا أُريد نِزالاً
Dialogue: 0,0:33:04.92,0:33:06.13,Default,,0,0,0,,!لا تُحاول
Dialogue: 0,0:33:09.86,0:33:11.09,Default,,0,0,0,,!إستعدّ لهذه
Dialogue: 0,0:33:29.59,0:33:32.90,Default,,0,0,0,,كُرة قدَم...؟\Nمن أين أتت بحقّ الله؟
Dialogue: 0,0:33:32.90,0:33:35.36,Default,,0,0,0,,!شُكراً، أيّها المُتحرّي
Dialogue: 0,0:33:50.17,0:33:51.92,Default,,0,0,0,,!هذا الشّيء رائع
Dialogue: 0,0:33:51.92,0:33:54.02,Default,,0,0,0,,.يُمكنني الآن أن أطير بحُرّيّةٍ حتّى دون رياح
Dialogue: 0,0:33:54.02,0:33:55.93,Default,,0,0,0,,.يجب أن أشكر الجدّ
Dialogue: 0,0:33:56.28,0:33:57.93,Default,,0,0,0,,...لكن
Dialogue: 0,0:33:57.93,0:34:00.35,Default,,0,0,0,,لِمَ قد يصل إلى هذا المَدى؟
Dialogue: 0,0:34:18.86,0:34:20.22,Default,,0,0,0,,!أنقذتَني هناك
Dialogue: 0,0:34:20.22,0:34:23.35,Default,,0,0,0,,.يبدو بأنّني كنتُ مُحقّاً بإعادة مُعدّاتكَ للحيطة فقط
Dialogue: 0,0:34:23.35,0:34:25.58,Default,,0,0,0,,.لَيس كما لَو أنّني أردتّ إنقاذكَ مع ذلك
Dialogue: 0,0:34:26.58,0:34:29.40,Default,,0,0,0,,!الأهمّ، ألَم يحن الوَقت لتُخبرني؟
Dialogue: 0,0:34:29.40,0:34:31.88,Default,,0,0,0,,!ما السّبب الحقيقيّ لإحضاركَ لي إلى هُنا؟
Dialogue: 0,0:34:34.32,0:34:35.38,Default,,0,0,0,,!هواه
Dialogue: 0,0:34:38.18,0:34:42.74,Default,,0,0,0,,.كان ليون يبحث عن قبضة الياقوتة الزّرقاء منذ أعوام
Dialogue: 0,0:34:42.74,0:34:45.08,Default,,0,0,0,,...لكن عندما كان على بُعد خُطوةٍ فقط من استرجاعها
Dialogue: 0,0:34:45.08,0:34:48.19,Default,,0,0,0,,.سبقه إليها زونهان تشين
Dialogue: 0,0:34:48.19,0:34:52.90,Default,,0,0,0,,.على ما يبدو، سرّب أحدهم مَوقع السّفينة الغارقة له
Dialogue: 0,0:34:53.69,0:34:56.94,Default,,0,0,0,,.الأكثر شُبهةً هي شيريلين تان
Dialogue: 0,0:34:56.94,0:35:00.22,Default,,0,0,0,,...عملَت كمُستشارةٍ قانونيّةٍ لشرِكة ليون لفترة
Dialogue: 0,0:35:00.22,0:35:02.70,Default,,0,0,0,,.لكن العلاقة بين الإثنين ساءت
Dialogue: 0,0:35:02.70,0:35:06.33,Default,,0,0,0,,...وِفقاً للشّائعات، السّبب الذي جعلَها تُصبح راعية كيوغوكو
Dialogue: 0,0:35:06.33,0:35:08.70,Default,,0,0,0,,.هو لإعاقة نصر جمال الدّين
Dialogue: 0,0:35:08.70,0:35:12.34,Default,,0,0,0,,.بالأساس، أرادَت منع ليون من الحصول على الجّوهرة
Dialogue: 0,0:35:12.34,0:35:14.36,Default,,0,0,0,,...إن كان هذا صحيحاً
Dialogue: 0,0:35:14.36,0:35:19.07,Default,,0,0,0,,.إذاً الشّائعات عن تسريب مَوقع السّفينة الغارقة صحيحةٌ أيضاً
Dialogue: 0,0:35:19.07,0:35:21.84,Default,,0,0,0,,.و ثمّ تمّ قتل شيريلين تان
Dialogue: 0,0:35:21.84,0:35:24.66,Default,,0,0,0,,...إن افترضنا بأنّ الشّائعات عن المُسرّب صحيحة
Dialogue: 0,0:35:24.66,0:35:28.00,Default,,0,0,0,,.هذا سيعني أنّ ليون امتلكَ الدّافع لقتل شيريلين
Dialogue: 0,0:35:28.00,0:35:30.60,Default,,0,0,0,,ما رأي الشّرطة؟
Dialogue: 0,0:35:30.60,0:35:34.36,Default,,0,0,0,,.لسوء الحظّ، أُزيلَ ليون من قائمة المُشتبهين
Dialogue: 0,0:35:34.36,0:35:35.65,Default,,0,0,0,,لماذا؟
Dialogue: 0,0:35:35.65,0:35:38.76,Default,,0,0,0,,!بسبب وُجود مُشتبهٍ أكثر احتماليّةً بكثير
Dialogue: 0,0:35:38.76,0:35:40.63,Default,,0,0,0,,!مُشتبه؟
Dialogue: 0,0:35:43.41,0:35:45.83,Default,,0,0,0,,...لَم تُعلِن الشّرطة هذا بعد
Dialogue: 0,0:35:45.83,0:35:50.41,Default,,0,0,0,,.لكن تمّ ترك بطاقةٍ في مَسرَح جريمة قتل شيريلين تان
Dialogue: 0,0:35:50.41,0:35:52.29,Default,,0,0,0,,.إشعارٌ مُسبقٌ منّي
Dialogue: 0,0:35:53.02,0:35:55.01,Default,,0,0,0,,.إذاً هذا هو الأمر
Dialogue: 0,0:35:55.01,0:35:55.80,Default,,0,0,0,,...لكن
Dialogue: 0,0:35:55.80,0:35:59.80,Default,,0,0,0,,!لِمَ عليّ رُؤية هذا المَشهد المُذهل مع هذا الشّخص من بين الجّميع؟
Dialogue: 0,0:35:59.80,0:36:03.66,Default,,0,0,0,,...لَو كنتُ سأراه مع أحد، أتمنّى لَو كان مع
Dialogue: 0,0:36:12.56,0:36:15.75,Default,,0,0,0,,.حان الوَقت لكي تكون آرثر هيراي ثانيةً
Dialogue: 0,0:36:15.75,0:36:19.07,Default,,0,0,0,,...بالمُناسبة، وَاثقٌ من أنّ آرثر هو من إسم السيّد أرثر كونان دويلي
Dialogue: 0,0:36:19.07,0:36:20.80,Default,,0,0,0,,لكن من هو "هيراي" هذا؟
Dialogue: 0,0:36:20.80,0:36:22.45,Default,,0,0,0,,...أوه، حسناً
Dialogue: 0,0:36:22.45,0:36:26.26,Default,,0,0,0,,.أخذتُه من إسم إيدوغاوا رانبو الحقيقيّ، هيراي تارو
Dialogue: 0,0:36:22.70,0:36:25.87,Title,,0,0,0,,{=277}{\fad(300,300)\fs60\b1}إيدوغاوا رانبو\N(إسم الكِتابة)
Dialogue: 0,0:36:24.41,0:36:25.87,Title,,0,0,0,,{\fad(300,300)\pos(1878,489)\fs60\b1}هيراي تارو\N(الإسم الحقيقيّ)
Dialogue: 0,0:36:25.91,0:36:26.62,Title,,0,0,0,,{=279}{\fad(300,300)\fs60\b1\pos(1872,644)}السيّد آرثر كونان دويلي
Dialogue: 0,0:36:26.26,0:36:27.70,Default,,0,0,0,,.أوه، فهمت
Dialogue: 0,0:36:26.62,0:36:27.70,Title,,0,0,0,,{\fad(300,0)\pos(1767,351)\fs60\b1}إيدوغاوا كونان
Dialogue: 0,0:36:27.70,0:36:31.00,Default,,0,0,0,,!لكن الأهمّ، من الوَاضح أنّ هذا فخّ
Dialogue: 0,0:36:31.00,0:36:33.06,Default,,0,0,0,,.أعلَم
Dialogue: 0,0:36:33.06,0:36:36.86,Default,,0,0,0,,.لهذا أحضرتُكَ معي، أيّها المُتحرّي العظيم
Dialogue: 0,0:36:36.86,0:36:39.00,Default,,0,0,0,,ألَستَ بارعاً بمثل هذا النّوع من الأُمور؟
Dialogue: 0,0:36:39.00,0:36:43.01,Default,,0,0,0,,.أفهم سببكَ الآن، مع أنّه لا تُعجبني طريقتكَ بالتّعامل مع الأمر
Dialogue: 0,0:36:43.70,0:36:45.73,Default,,0,0,0,,...أنا، كيد ساما
Dialogue: 0,0:36:46.43,0:36:50.52,Default,,0,0,0,,لا يُمكنني ببساطةٍ عدَم فِعل شيءٍ بشأن هذا، صحيح؟
Dialogue: 0,0:36:56.17,0:36:59.90,Default,,0,0,0,,.أنتَ بطيءٌ جدّاً\N.إنتظرتكَ طوال هذا الوَقت
Dialogue: 0,0:36:59.90,0:37:01.88,Default,,0,0,0,,.أعتذر، أعتذر
Dialogue: 0,0:37:01.88,0:37:03.65,Default,,0,0,0,,.هاي، أُنظُر إلى هذا
Dialogue: 0,0:37:03.65,0:37:06.43,Default,,0,0,0,,.المَشهد المَسائيّ جميل
Dialogue: 0,0:37:06.43,0:37:08.66,Default,,0,0,0,,ألا تظنّه رومانسيّاً؟
Dialogue: 0,0:37:12.48,0:37:13.62,Default,,0,0,0,,ماذا...؟
Dialogue: 0,0:37:16.98,0:37:19.07,Default,,0,0,0,,.لا تكُن خجولاً هكذا
Dialogue: 0,0:37:19.07,0:37:21.48,Default,,0,0,0,,نحن نتوَاعد، صحيح؟
Dialogue: 0,0:37:21.48,0:37:22.63,Default,,0,0,0,,...نـ-نعم
Dialogue: 0,0:37:22.63,0:37:24.63,Default,,0,0,0,,!ماذا؟! حقّاً؟
Dialogue: 0,0:37:24.63,0:37:26.64,Default,,0,0,0,,...سُحقاً
Dialogue: 0,0:37:26.64,0:37:29.95,Default,,0,0,0,,!ألَم تُدرك ران بأنّه مُزيّفٌ حتّى؟
Dialogue: 0,0:37:29.95,0:37:33.02,Default,,0,0,0,,!...لكن إن أدركَت ذلك، لَن أتمكّن من العودة إلى اليابان
Dialogue: 0,0:37:38.23,0:37:41.03,Title,,0,0,0,,{\fad(300,300)\pos(1062,759)}فُندق رافيلز
Dialogue: 0,0:37:49.05,0:37:52.31,Default,,0,0,0,,!عندما يتعلّق الأمر بسينغافورة، يجب أن يكون شراب سينغافورة سلينغ
Dialogue: 0,0:37:52.31,0:37:53.54,Default,,0,0,0,,!أعطِني كأساً آخر
Dialogue: 0,0:37:54.33,0:37:55.20,Default,,0,0,0,,موري سان؟
Dialogue: 0,0:37:55.20,0:37:55.89,Default,,0,0,0,,هاه؟
Dialogue: 0,0:37:55.89,0:37:59.06,Default,,0,0,0,,و-و من أنتِ...؟
Dialogue: 0,0:37:59.06,0:38:01.67,Default,,0,0,0,,هل تُمانع لَو جلستُ هُنا؟
Dialogue: 0,0:38:02.67,0:38:06.68,Default,,0,0,0,,.كـ-كـ-كلّا على الإطلاق، على الإطلاق\N.لنَشرَب معاً
Dialogue: 0,0:38:07.45,0:38:09.14,Default,,0,0,0,,...في الوَاقع، أنا
Dialogue: 0,0:38:09.14,0:38:10.18,Default,,0,0,0,,أوه؟
Dialogue: 0,0:38:11.05,0:38:12.18,Default,,0,0,0,,!أه
Dialogue: 0,0:38:12.70,0:38:13.68,Default,,0,0,0,,...أه-أوه
Dialogue: 0,0:38:13.68,0:38:16.44,Default,,0,0,0,,!هذا فظيع\N!ماذا فعلت؟
Dialogue: 0,0:38:17.21,0:38:19.33,Default,,0,0,0,,!أعتذر بشدّة
Dialogue: 0,0:38:19.33,0:38:22.11,Default,,0,0,0,,.كلّا، كلّا... لا بأس\N.لا تقلَقي بشأن هذا
Dialogue: 0,0:38:24.11,0:38:26.45,Default - E,,0,0,0,,.سيّد موري... هناك اتّصالٌ لك
Dialogue: 0,0:38:26.45,0:38:28.34,Default,,0,0,0,,هاه؟ "إتّصال"؟
Dialogue: 0,0:38:28.34,0:38:31.01,Default,,0,0,0,,.يبدو بأنّ هناك اتّصالٌ لك، موري سان
Dialogue: 0,0:38:31.01,0:38:32.43,Default,,0,0,0,,لي؟
Dialogue: 0,0:38:32.43,0:38:33.97,Default,,0,0,0,,من يُمكن أن يكون؟
Dialogue: 0,0:38:33.97,0:38:35.32,Default,,0,0,0,,.موري سان
Dialogue: 0,0:38:35.32,0:38:36.12,Default,,0,0,0,,أوه؟
Dialogue: 0,0:38:36.56,0:38:38.87,Default,,0,0,0,,!هناك ما أرغب بأن أتكلّم معكَ بشأنه بشدّة
Dialogue: 0,0:38:40.06,0:38:41.73,Default,,0,0,0,,!تعال إلى هذا المكان في الغد
Dialogue: 0,0:38:41.73,0:38:43.32,Default,,0,0,0,,!هاه؟
Dialogue: 0,0:38:44.77,0:38:45.88,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:38:47.61,0:38:48.38,Default,,0,0,0,,...هاه
Dialogue: 0,0:38:49.73,0:38:51.39,Default,,0,0,0,,!ماذا بحقّ الله...؟\N!لَقد أغلَق الخطّ
Dialogue: 0,0:38:51.39,0:38:55.22,Default,,0,0,0,,!حان وَقت بِدء الشّرب ثانيةً
Dialogue: 0,0:39:00.98,0:39:04.02,Title,,0,0,0,,{\fad(300,300)\pos(1179,768)}إستاد سينغافورة الدّاخليّ
Dialogue: 0,0:39:04.02,0:39:06.38,Default,,0,0,0,,من تظنّانه سيفوز؟
Dialogue: 0,0:39:06.38,0:39:07.84,Default,,0,0,0,,!السيّد كيوغوكو
Dialogue: 0,0:39:07.84,0:39:09.32,Default,,0,0,0,,!لأنّه لَم يخسر أبداً
Dialogue: 0,0:39:09.32,0:39:12.55,Default,,0,0,0,,هواه، حقّاً؟\N.لَم أسمع بهذا سابقاً
Dialogue: 0,0:39:12.55,0:39:16.54,Default,,0,0,0,,...إذاً جُهوده الكبيرة الذي بذلَها إضافةً إلى الوَضع و الإرشاد المُناسبان
Dialogue: 0,0:39:16.54,0:39:18.48,Default,,0,0,0,,.لابدّ من أنّها تُظهِر ثِمارها حقّاً
Dialogue: 0,0:39:18.48,0:39:20.44,Default,,0,0,0,,هل تفهمان هذا؟
Dialogue: 0,0:39:20.44,0:39:21.79,Default,,0,0,0,,!نعم
Dialogue: 0,0:39:30.86,0:39:34.03,Default,,0,0,0,,من سيحصل على قبضة الياقوتة الزّرقاء؟
Dialogue: 0,0:39:51.57,0:39:52.70,Default,,0,0,0,,!كان ذلك سريعاً جدّاً
Dialogue: 0,0:39:52.70,0:39:55.95,Default,,0,0,0,,.يبدو جمال الدّين ذاك قويّاً بشكلٍ لا يُصدّق
Dialogue: 0,0:39:55.95,0:40:00.52,Default,,0,0,0,,.يملِك كِلا السّرعة و التّقنيّة إضافةً لقوّة الفِئة الثّقيلة
Dialogue: 0,0:40:00.52,0:40:01.71,Default,,0,0,0,,.يبدو خصماً قويّاً جدّاً
Dialogue: 0,0:40:02.73,0:40:05.38,Default,,0,0,0,,!هذا مُتوَقّعٌ من كابتنة نادي كراتيه ثانويّة تيتان
Dialogue: 0,0:40:05.38,0:40:08.07,Default,,0,0,0,,.تُلاحظين أُموراً لا يُلاحظها مُعظم الأشخاص
Dialogue: 0,0:40:08.07,0:40:09.45,Default,,0,0,0,,...هاي
Dialogue: 0,0:40:09.45,0:40:12.41,Default,,0,0,0,,...إن فاز كيوغوكو سان بالجّوهرة
Dialogue: 0,0:40:12.41,0:40:14.60,Default,,0,0,0,,ألَن يعني هذا بأنّكَ لَن تتمكّن من الحصول عليها بعد الآن؟
Dialogue: 0,0:40:14.60,0:40:16.42,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:40:16.42,0:40:19.14,Default,,0,0,0,,.لأنّني لا أُريد أن أكون حوله بقدر المُستطاع
Dialogue: 0,0:40:21.89,0:40:24.75,Default,,0,0,0,,!أوه، ماكوتو سان هُنا
Dialogue: 0,0:40:26.25,0:40:27.90,Default,,0,0,0,,!هيّا الآن\N!شجّعوه جميعاً أيضاً
Dialogue: 0,0:40:27.90,0:40:31.01,Default,,0,0,0,,إنتظر، لِمَ أحضرتَ الغبيّ معك؟
Dialogue: 0,0:40:31.01,0:40:33.41,Default,,0,0,0,,.تعلّقَ بي لسببٍ ما
Dialogue: 0,0:40:43.73,0:40:45.19,Default - E,,0,0,0,,!إنحنيا لبعضكما
Dialogue: 0,0:40:49.03,0:40:50.19,Default,,0,0,0,,أوه؟
Dialogue: 0,0:40:50.28,0:40:51.53,Default - E,,0,0,0,,!إبدءا
Dialogue: 0,0:41:01.20,0:41:02.39,Default,,0,0,0,,...هذا مُخيفٌ فقط
Dialogue: 0,0:41:01.74,0:41:02.33,Up,,0,0,0,,!أحسنت
Dialogue: 0,0:41:02.33,0:41:04.16,Up,,0,0,0,,!أنتَ رائعٌ جدّاً، ماكوتو سان
Dialogue: 0,0:41:04.16,0:41:06.92,Default,,0,0,0,,!أوه، كم أرغب بالذّهاب لرُؤيته الآن
Dialogue: 0,0:41:06.92,0:41:07.56,Default,,0,0,0,,أوه؟
Dialogue: 0,0:41:07.56,0:41:09.82,Title,,0,0,0,,{=286}{\fs60\b1}إتّصالٌ وَارد\Nأبي
Dialogue: 0,0:41:07.56,0:41:09.80,Default,,0,0,0,,.إنّه من أبي
Dialogue: 0,0:41:09.82,0:41:12.84,Default,,0,0,0,,!كنتُ أُخبركما، لَستُ مُريباً
Dialogue: 0,0:41:12.84,0:41:14.43,Default,,0,0,0,,!أبي
Dialogue: 0,0:41:14.43,0:41:16.05,Default,,0,0,0,,ماذا حصل؟
Dialogue: 0,0:41:16.05,0:41:19.24,Default,,0,0,0,,!ران\N!أرجوكِ إشرحي الأمر لهذان الشّخصان لأجلي
Dialogue: 0,0:41:19.24,0:41:22.00,Default,,0,0,0,,.أخرجتُ كلّ ما هو مَصنوعٌ من مَعدنٍ معي
Dialogue: 0,0:41:22.00,0:41:24.06,Default,,0,0,0,,...لكن مع ذلك
Dialogue: 0,0:41:25.42,0:41:26.54,Default - E,,0,0,0,,!الدّخول مَحظور
Dialogue: 0,0:41:26.54,0:41:27.75,Up,,0,0,0,,!ألَستُ جيّداً الآن؟
Dialogue: 0,0:41:27.75,0:41:28.50,Default - E,,0,0,0,,!كلّا
Dialogue: 0,0:41:28.50,0:41:32.26,Default,,0,0,0,,!سُحقاً\N!لَن أتمكّن من الدّخول أبداً بهذا المُعدّل
Dialogue: 0,0:41:32.26,0:41:34.63,Default,,0,0,0,,!موري سان، هل كلّ شيءٍ بخير؟
Dialogue: 0,0:41:34.63,0:41:35.51,Default,,0,0,0,,!أوه، ريشي سان
Dialogue: 0,0:41:35.51,0:41:38.35,Default - E,,0,0,0,,.هو مُوَظّف. أرجوكَ اسمح له بالدّخول
Dialogue: 0,0:41:38.64,0:41:39.64,Default - E,,0,0,0,,.نعم، سيّدي
Dialogue: 0,0:41:39.66,0:41:41.04,Default,,0,0,0,,!شُكراً لك، سيّد ريشي
Dialogue: 0,0:41:41.04,0:41:42.77,Default,,0,0,0,,.سعيدٌ لتمكّني من لِقائك
Dialogue: 0,0:41:42.77,0:41:45.67,Default,,0,0,0,,...بعد الكشف عن الحِزام خلال احتفال الإفتتاح
Dialogue: 0,0:41:45.67,0:41:48.42,Default,,0,0,0,,.يتمّ حِفظه الآن بالخزنة تحت الأرض
Dialogue: 0,0:41:48.42,0:41:50.77,Default,,0,0,0,,.إن رغبت، يُمكنني أن أُريه لكَ لاحقاً
Dialogue: 0,0:41:50.77,0:41:53.40,Default,,0,0,0,,لكن نظراً لكلّ شيء، أين كنتَ حتّى الآن؟
Dialogue: 0,0:41:53.40,0:41:56.66,Default,,0,0,0,,...أ-أوه، حسناً\N.كنتُ أقوم بدوريّة
Dialogue: 0,0:41:56.66,0:41:59.66,Default,,0,0,0,,هل أنتَ وَاثقٌ من أنّكَ لَم تتأخّر بالنّوم فقط بسبب أعراض ما بعد الثّمالة؟
Dialogue: 0,0:42:01.54,0:42:04.68,Default,,0,0,0,,.و تتغيّر كلِمة السّرّ كلّ 10 دقائق
Dialogue: 0,0:42:04.68,0:42:08.54,Default,,0,0,0,,.يُسيطر عليها حاسوب، الذي يُبلِغنا عبر البريد الإلكترونيّ
Dialogue: 0,0:42:08.54,0:42:11.52,Default,,0,0,0,,...الوَحيدون الذين تصلهم هُم المُفتّش إيدان و أنا
Dialogue: 0,0:42:11.52,0:42:15.65,Default,,0,0,0,,.و ليون سينساي أيضاً، الذي يُدير الخزنة، ممّا يجعلنا 3 أشخاص
Dialogue: 0,0:42:18.18,0:42:20.85,Default,,0,0,0,,.هواه، هذه الغُرفة فارِغة
Dialogue: 0,0:42:20.85,0:42:22.18,Default,,0,0,0,,.على الإطلاق
Dialogue: 0,0:42:22.18,0:42:25.68,Default,,0,0,0,,...يُوجد مُستشعر أوزانٍ على الأرض، و كاميرات أمنٍ في السّقف
Dialogue: 0,0:42:25.68,0:42:28.94,Default,,0,0,0,,.و ثمّ يُوجد ضُبّاطٌ في كلّ أرجاء الإستاد يُحيطون بها
Dialogue: 0,0:42:28.94,0:42:33.34,Default,,0,0,0,,.أوه! بهذا، وَاثقٌ من أنّ اللّصّ الشّبح حتّى لا يُمكنه فِعل شيء
Dialogue: 0,0:42:33.34,0:42:35.69,Default,,0,0,0,,.موري سان، التّدخين مَحظورٌ هُنا
Dialogue: 0,0:42:35.69,0:42:37.61,Default,,0,0,0,,.أوه، أعتذر بشأن هذا
Dialogue: 0,0:42:37.61,0:42:38.49,Default,,0,0,0,,هاه؟
Dialogue: 0,0:42:38.49,0:42:40.37,Title,,0,0,0,,{\fs60\b1}رايتشل تشيونغ
Dialogue: 0,0:42:41.99,0:42:45.10,Default,,0,0,0,,.كنتُ ثمِلاً جدّاً، نسيتُ هذا الأمر بالكامل
Dialogue: 0,0:42:45.10,0:42:48.62,Default,,0,0,0,,.أعطتني هذه في الحانة ليلة البارحة قائلةً بأنّها تحتاج للتّكلّم معي بشأن شيءٍ ما
Dialogue: 0,0:42:48.62,0:42:52.88,Title,,0,0,0,,{\fs60\b1}رايتشل تشيونغ
Dialogue: 0,0:42:50.44,0:42:52.88,Default,,0,0,0,,.هذه بطاقة عمل سكرتيرة ليون سان
Dialogue: 0,0:42:52.88,0:42:55.07,Default,,0,0,0,,ماذا؟! حقّاً؟
Dialogue: 0,0:42:55.07,0:42:58.15,Default,,0,0,0,,.لأكون صادقاً، كنتُ أثمَل من أن أتذكّر
Dialogue: 0,0:42:58.15,0:42:59.78,Default,,0,0,0,,كيف عرفت؟
Dialogue: 0,0:42:59.78,0:43:02.49,Default,,0,0,0,,.شِعار شرِكة ليون سان عليها
Dialogue: 0,0:43:02.49,0:43:03.97,Default,,0,0,0,,...أوه\Nشِعارها، هاه؟
Dialogue: 0,0:43:04.83,0:43:05.95,Default,,0,0,0,,".في الـ3 بعد الظّهر"
Dialogue: 0,0:43:05.95,0:43:09.79,Default,,0,0,0,,".قابلني خلف الإستاد الوَطنيّ عند البوّابة الـ3"
Dialogue: 0,0:43:09.79,0:43:11.46,Default,,0,0,0,,.هذا هو المَكتوب هُنا
Dialogue: 0,0:43:11.46,0:43:14.36,Default,,0,0,0,,...أوه\N."مَكتوبٌ أيضاً، "لا تُخبر أحداً
Dialogue: 0,0:43:14.36,0:43:18.38,Default,,0,0,0,,.فهمت\Nإذاً في الـ3 بعد الظّهر، هاه؟
Dialogue: 0,0:43:18.38,0:43:19.99,Default,,0,0,0,,!تكاد تكون السّاعة الـ3
Dialogue: 0,0:43:19.99,0:43:21.93,Default,,0,0,0,,!مـ-موري سان
Dialogue: 0,0:43:21.93,0:43:24.58,Default,,0,0,0,,!جعل آنسةٍ تنتظر هو أمرٌ مُخزٍ للرّجل
Dialogue: 0,0:43:39.32,0:43:41.34,Default,,0,0,0,,.كان ذلك نِزالاً رائعاً بالفِعل
Dialogue: 0,0:43:41.34,0:43:45.79,Default,,0,0,0,,.سأنتظر بحماسٍ نِزال الغد لنِصف النّهائيّات
Dialogue: 0,0:43:45.79,0:43:47.62,Default,,0,0,0,,.شُكراً جزيلاً لك
Dialogue: 0,0:43:47.62,0:43:49.60,Default,,0,0,0,,.قوّتكَ مُذهلة
Dialogue: 0,0:43:49.60,0:43:51.25,Default,,0,0,0,,ما رأيكَ إذاً؟
Dialogue: 0,0:43:51.25,0:43:53.11,Default,,0,0,0,,هل ترغب بأن تكون حارسي الشّخصيّ؟
Dialogue: 0,0:43:55.11,0:43:56.48,Default,,0,0,0,,.أُعذرني رجاءً
Dialogue: 0,0:44:01.01,0:44:02.51,Default,,0,0,0,,.الآن، إنتظر لَحظة
Dialogue: 0,0:44:02.51,0:44:04.37,Default,,0,0,0,,!كنتُ أمزح الآن فقط بالتّأكيد
Dialogue: 0,0:44:04.37,0:44:07.49,Default,,0,0,0,,.لكنّني أُريد أن أسألكَ شيئاً وَاحداً في الوَاقع
Dialogue: 0,0:44:08.87,0:44:09.75,Default,,0,0,0,,...إذاً أخبرني
Dialogue: 0,0:44:11.29,0:44:15.04,Default,,0,0,0,,ما سبب امتلاككَ لقبضتك؟
Dialogue: 0,0:44:15.04,0:44:19.86,Default,,0,0,0,,.يُوجد شيءٌ يدفعكَ للسّعي لامتلاك القوّة
Dialogue: 0,0:44:19.86,0:44:22.89,Default,,0,0,0,,ما هو بالضّبط، الذي يدفعكَ للتّقدّم؟
Dialogue: 0,0:44:25.05,0:44:27.37,Default,,0,0,0,,إذاً لا يُمكنكَ الإجابة؟
Dialogue: 0,0:44:27.37,0:44:30.68,Default,,0,0,0,,.قبضةٌ غير مُكتملةٍ بلا هدَفٍ تكون خطيرة
Dialogue: 0,0:44:30.68,0:44:32.79,Default,,0,0,0,,...لَيس نحو نفسكَ فقط
Dialogue: 0,0:44:32.79,0:44:35.69,Default,,0,0,0,,.لكنّها ستقود الأشخاص من حولكَ إلى سوء الحظّ و الحُزن
Dialogue: 0,0:44:35.69,0:44:38.09,Default,,0,0,0,,الأشخاص من حولي؟\Nسوء حظٍّ و حُزن؟
Dialogue: 0,0:44:38.09,0:44:39.29,Default,,0,0,0,,.نعم
Dialogue: 0,0:44:39.29,0:44:42.13,Default,,0,0,0,,.كمَن تُحبّها على سبيل المِثال
Dialogue: 0,0:44:42.13,0:44:44.93,Default,,0,0,0,,حتّى أنتَ لَديكَ شخصٌ كهذا، صحيح؟
Dialogue: 0,0:44:45.89,0:44:50.81,Default,,0,0,0,,.قبضتكَ خطيرة، و قد تُؤذي من تُحبّ
Dialogue: 0,0:44:50.81,0:44:54.81,Default,,0,0,0,,و ماذا ستفعل عندما يحصل ذلك؟
Dialogue: 0,0:44:58.88,0:45:01.59,Default,,0,0,0,,.أتحرّق لمُشاهدة نِزال الغد
Dialogue: 0,0:45:13.41,0:45:14.46,Default,,0,0,0,,أمازلتَ تحتاج شيئاً؟
Dialogue: 0,0:45:17.33,0:45:18.36,Default,,0,0,0,,.أحسنتَ هناك
Dialogue: 0,0:45:18.36,0:45:20.11,Default,,0,0,0,,.سونوكو سان
Dialogue: 0,0:45:20.11,0:45:20.94,Default,,0,0,0,,...أوه، أنت
Dialogue: 0,0:45:20.94,0:45:23.34,Default,,0,0,0,,.لَم تأتي، لذا أتينا لرُؤيتك
Dialogue: 0,0:45:23.34,0:45:25.36,Default,,0,0,0,,.أعتذر لجعلكِ تنتظرين
Dialogue: 0,0:45:25.36,0:45:27.89,Default,,0,0,0,,!إذاً لنذهب جميعاً للحصول على بعض الغداء
Dialogue: 0,0:45:27.89,0:45:29.95,Default,,0,0,0,,...هناك مكانٌ أرغب بالذّهاب إليه بشدّة
Dialogue: 0,0:45:29.95,0:45:31.06,Default,,0,0,0,,.أعتذر، سونوكو
Dialogue: 0,0:45:31.06,0:45:33.02,Default,,0,0,0,,.يُمكنكما الذّهاب للأكل من دوني
Dialogue: 0,0:45:33.02,0:45:34.37,Default,,0,0,0,,ماذا؟ لماذا؟
Dialogue: 0,0:45:34.37,0:45:36.27,Default,,0,0,0,,!أعتذر بشدّة
Dialogue: 0,0:45:36.27,0:45:40.38,Default,,0,0,0,,.لكن بما أنّ شينتشي يحرس الجّوهرة، لا يبدو بأنّه يُمكنه الإبتعاد عن هُنا
Dialogue: 0,0:45:40.38,0:45:42.11,Default,,0,0,0,,...فهمت
Dialogue: 0,0:45:42.11,0:45:44.61,Default,,0,0,0,,.إذاً أفترض أنّه لا يُمكنكِ فِعل شيءٍ بشأن هذا
Dialogue: 0,0:45:44.61,0:45:47.07,Default,,0,0,0,,ماذا لَو ذهبَ كِلانا، ماكوتو سان؟
Dialogue: 0,0:45:47.07,0:45:48.07,Default,,0,0,0,,.حسناً
Dialogue: 0,0:45:48.07,0:45:49.97,Default,,0,0,0,,.إلى اللّقاء، ران
Dialogue: 0,0:45:49.97,0:45:51.89,Default,,0,0,0,,.أرجوكِ اعذُرينا لمُغادرتنا قبلكِ
Dialogue: 0,0:45:51.89,0:45:54.33,Default,,0,0,0,,!أُريدكَ أن تأكل كثيراً الآن، ماكوتو سان
Dialogue: 0,0:45:54.33,0:45:55.84,Default,,0,0,0,,.شُكراً جزيلاً لكِ
Dialogue: 0,0:46:07.34,0:46:10.33,Default - E,,0,0,0,,!الآن، كونوا مُتأهّبين و فتّشوا كلّ مكان
Dialogue: 0,0:46:10.33,0:46:14.00,Default - E,,0,0,0,,.إن رأيتُم أيّ شيءٍ مُريب، بلّغوا عنه
Dialogue: 0,0:46:14.00,0:46:15.50,Default - E,,0,0,0,,!و تصرّفوا على الفور
Dialogue: 0,0:46:16.00,0:46:16.71,Default - E,,0,0,0,,...و
Dialogue: 0,0:46:18.67,0:46:20.00,Default - E,,0,0,0,,هل أنتِ بخير؟
Dialogue: 0,0:46:20.25,0:46:21.88,Default - E,,0,0,0,,.أعتذر بشدّة
Dialogue: 0,0:46:22.13,0:46:23.76,Default - E,,0,0,0,,.أعتذر بشدّةٍ أيضاً
Dialogue: 0,0:46:32.72,0:46:34.31,Default - E,,0,0,0,,!مُفتّش إيدان
Dialogue: 0,0:46:35.23,0:46:38.15,Default - E,,0,0,0,,.أعتذر، لَم أتمكّن إلّا من مُلاحظة ذلك
Dialogue: 0,0:46:38.40,0:46:40.52,Default - E,,0,0,0,,أ-أعتذر... ماذا...؟
Dialogue: 0,0:46:40.90,0:46:42.27,Default - E,,0,0,0,,!ها أنتَ ذا
Dialogue: 0,0:46:42.57,0:46:44.61,Default - E,,0,0,0,,.إستمرّ بالعمل الجيّد
Dialogue: 0,0:46:45.07,0:46:46.03,Default - E,,0,0,0,,!نعم، سيّدتي
Dialogue: 0,0:46:47.78,0:46:49.99,Default - E,,0,0,0,,هل كلّ شيءٍ جيّدٌ بالنّسبة للخزنة؟
Dialogue: 0,0:46:50.28,0:46:52.33,Default - E,,0,0,0,,.نعم، سيّدي. كلّ شيءٍ بخير
Dialogue: 0,0:46:52.53,0:46:54.66,Default - E,,0,0,0,,.عُذراً! أعتذر بشدّة
Dialogue: 0,0:46:54.66,0:46:55.41,Default - E,,0,0,0,,ما الخطب؟
Dialogue: 0,0:46:55.41,0:46:58.87,Default - E,,0,0,0,,!المُفتّش إيدان يستدعيكما للقُدوم بسرعة
Dialogue: 0,0:46:59.17,0:47:00.33,Default - E,,0,0,0,,...لـ-لكن
Dialogue: 0,0:47:00.58,0:47:02.13,Default - E,,0,0,0,,.سأحرُس هذا المكان
Dialogue: 0,0:47:02.46,0:47:03.42,Default - E,,0,0,0,,.حـ-حسناً
Dialogue: 0,0:47:03.59,0:47:05.71,Default - E,,0,0,0,,.سنعود قريباً. شُكراً لكِ
Dialogue: 0,0:47:10.28,0:47:11.53,Default,,0,0,0,,...الآن
Dialogue: 0,0:47:14.20,0:47:16.37,Default,,0,0,0,,!سآخذ الكنز
Dialogue: 0,0:47:35.48,0:47:37.22,Default,,0,0,0,,!سآخذ هذا
Dialogue: 0,0:47:39.64,0:47:41.98,Default,,0,0,0,,هاه؟ هل علِق هذا بشيءٍ ما؟
Dialogue: 0,0:47:41.98,0:47:42.75,Default,,0,0,0,,ماذا...؟
Dialogue: 0,0:47:49.36,0:47:51.34,Default,,0,0,0,,!جُثّة؟\N...و أسوأ حتّى
Dialogue: 0,0:47:52.82,0:47:54.85,Default,,0,0,0,,!إنّها جُثّة رايتشل؟
Dialogue: 0,0:47:54.85,0:47:55.98,Default,,0,0,0,,!هذا سيّء
Dialogue: 0,0:47:55.98,0:47:57.47,Default,,0,0,0,,!يجب أن أخرُج من هُنا بسرعة
Dialogue: 0,0:48:00.25,0:48:01.48,Default,,0,0,0,,أوه؟
Dialogue: 0,0:48:01.48,0:48:03.44,Default,,0,0,0,,هل هذه أحرفٌ من نوعٍ ما؟
Dialogue: 0,0:48:05.25,0:48:06.46,Default,,0,0,0,,!تبّاً
Dialogue: 0,0:48:11.99,0:48:13.12,Default - E,,0,0,0,,!!...لا تتحرّك
Dialogue: 0,0:48:18.29,0:48:19.62,Default - E,,0,0,0,,!إرمي المُسدّس الآن
Dialogue: 0,0:48:20.12,0:48:22.00,Default - E,,0,0,0,,!كيد، مَقبوضٌ عليك
Dialogue: 0,0:48:25.88,0:48:26.38,Default - E,,0,0,0,,ماذا؟
Dialogue: 0,0:48:31.78,0:48:32.67,Default,,0,0,0,,...بجِدّ
Dialogue: 0,0:48:32.67,0:48:35.39,Default,,0,0,0,,حتّى متى ستجعلنا رايتشل سان ننتظر؟
Dialogue: 0,0:48:35.39,0:48:38.04,Default,,0,0,0,,لننتظر 10 دقائق أُخرى... هاه؟
Dialogue: 0,0:48:38.04,0:48:39.83,Default,,0,0,0,,!ما-ماذا يحصل؟
Dialogue: 0,0:48:39.83,0:48:41.83,Default,,0,0,0,,!قد يكون كيد
Dialogue: 0,0:48:41.83,0:48:43.06,Default,,0,0,0,,!هاي، إنتظر
Dialogue: 0,0:48:46.86,0:48:48.02,Default - E,,0,0,0,,!إنّه هُنا
Dialogue: 0,0:48:48.34,0:48:51.05,Default,,0,0,0,,!هواه\N!هذا سيّءٌ حقّاً
Dialogue: 0,0:48:51.05,0:48:54.03,Default,,0,0,0,,!لكنّني سأنجح بالهُروب إن أمكنني الإبتعاد عن الأرض
Dialogue: 0,0:49:01.66,0:49:03.83,Default,,0,0,0,,!كان يُوجد هذا العدد الكبير منهم؟
Dialogue: 0,0:49:13.11,0:49:14.34,Default,,0,0,0,,!هاي، إنتظر
Dialogue: 0,0:49:19.10,0:49:19.76,Default - E,,0,0,0,,!سُحقاً
Dialogue: 0,0:49:20.06,0:49:22.85,Default - E,,0,0,0,,!إذهبوا! إقبضوا عليه مهما كلّف الأمر
Dialogue: 0,0:49:22.85,0:49:23.77,Default - E,,0,0,0,,!نعم، سيّدي
Dialogue: 0,0:49:24.33,0:49:26.54,Default,,0,0,0,,...أوه، هيّا الآن\Nألا بأس حقّاً من تركه يُغادر؟
Dialogue: 0,0:49:26.54,0:49:29.27,Default,,0,0,0,,!ها أنتَ ذا، موري سان\N!كنتُ أبحث عنك
Dialogue: 0,0:49:29.27,0:49:32.30,Default,,0,0,0,,.يا إلهي، تحوّل الأمر إلى مُشكلةٍ ضخمة
Dialogue: 0,0:49:32.30,0:49:35.26,Default,,0,0,0,,من كان ليظنّ بأنّ كيد سيظهر في وَضح النّهار هكذا؟
Dialogue: 0,0:49:35.26,0:49:37.39,Default,,0,0,0,,.لكن استرخي
Dialogue: 0,0:49:37.39,0:49:40.20,Default,,0,0,0,,...أنا، المُتحرّي العظيم موري كوغورو، سأبدأ بتتبّعه على الفور
Dialogue: 0,0:49:40.20,0:49:41.77,Default,,0,0,0,,!الآن لَيس الوَقت لهذا
Dialogue: 0,0:49:41.77,0:49:44.14,Default,,0,0,0,,!حصل شيءٌ فظيع
Dialogue: 0,0:49:44.14,0:49:46.15,Default,,0,0,0,,!أرجوكَ تعال إلى الغُرفة الآمنة على الفور
Dialogue: 0,0:49:46.15,0:49:46.92,Default,,0,0,0,,هاه؟
Dialogue: 0,0:49:50.05,0:49:50.71,Default - E,,0,0,0,,!أُنظُر
Dialogue: 0,0:49:51.09,0:49:53.72,Default - E,,0,0,0,,!يُوجد طائرٌ ضخمٌ في السّماء
Dialogue: 0,0:50:02.58,0:50:04.33,Default,,0,0,0,,...الآن بابتعادي لهذا المَدى
Dialogue: 0,0:50:14.05,0:50:15.97,Default,,0,0,0,,!ما-ما هذا...؟
Dialogue: 0,0:50:15.97,0:50:19.09,Default,,0,0,0,,.الضّحيّة هي سكرتيرة ليون سينساي، رايتشل سان
Dialogue: 0,0:50:19.09,0:50:20.58,Default,,0,0,0,,رايتشل سان؟
Dialogue: 0,0:50:22.18,0:50:23.20,Default,,0,0,0,,...فهمت
Dialogue: 0,0:50:23.20,0:50:25.35,Default,,0,0,0,,هل تفقّدتّم كاميرات الأمن؟
Dialogue: 0,0:50:25.35,0:50:26.33,Default,,0,0,0,,.لَم تُساعد
Dialogue: 0,0:50:26.33,0:50:32.21,Default,,0,0,0,,.تمّ اختراقها ليتمّ إرسال فيديو يُظهِر عدَم وُجود أحدٍ بشكلٍ مُتكرّر
Dialogue: 0,0:50:32.21,0:50:34.86,Default,,0,0,0,,إذاً هل حدّدتّم القاتِل؟
Dialogue: 0,0:50:34.86,0:50:36.61,Default,,0,0,0,,.بالتّأكيد
Dialogue: 0,0:50:36.61,0:50:39.07,Default,,0,0,0,,.و نُلاحقه الآن بكلّ قُدرتنا
Dialogue: 0,0:50:39.07,0:50:41.85,Default,,0,0,0,,تُلاحقونه حاليّاً؟\N...لا تعني
Dialogue: 0,0:50:41.85,0:50:45.16,Default,,0,0,0,,.بلا شكّ\N!كايتو كيد هو القاتِل
Dialogue: 0,0:50:45.16,0:50:50.36,Default,,0,0,0,,.على أيّة حال، عدَم تعطيل نِظام الإنذار مُسبقاً كان خطأك، كيد
Dialogue: 0,0:50:50.36,0:50:51.48,Default,,0,0,0,,...هاي، كما تعلَم
Dialogue: 0,0:50:51.48,0:50:53.25,Default,,0,0,0,,...إن كان ذلك صحيحاً، إذاً في ذلك الوَقت
Dialogue: 0,0:50:53.25,0:50:56.02,Default,,0,0,0,,...ألا يُفترض أنّ رايتشل سان كانت قادِمةً إلى الإستاد
Dialogue: 0,0:50:56.02,0:50:58.03,Default,,0,0,0,,لأجل مَوعِدها مع هذا الرّجل اللّطيف؟
Dialogue: 0,0:50:58.03,0:51:00.26,Default,,0,0,0,,لِمَ كانت في الغُرفة الآمنة؟
Dialogue: 0,0:51:00.26,0:51:02.49,Default,,0,0,0,,أوه؟\N.بالتّفكير بالأمر، هذا صحيح
Dialogue: 0,0:51:02.49,0:51:05.22,Default,,0,0,0,,...وِفقاً للضّابطين اللّذان كانا أمام الغُرفة الآمنة
Dialogue: 0,0:51:05.22,0:51:08.52,Default,,0,0,0,,.يبدو بأنّها أتت لتُخبرهما بأنّ المُفتّش إيدان احتاجَهما
Dialogue: 0,0:51:08.52,0:51:12.38,Default,,0,0,0,,رُبّما بدا الأمر عاجِلاً و أعطيا الأمر الأولويّة؟
Dialogue: 0,0:51:12.38,0:51:15.23,Default,,0,0,0,,...بعد كلّ شيء، وَقع ذلك الإضطّراب الكبير بعدها مُباشرةً
Dialogue: 0,0:51:15.23,0:51:18.94,Default,,0,0,0,,.لكنّني لَم أسمع أبداً بكَون كيد قاتِلاً
Dialogue: 0,0:51:20.99,0:51:23.58,Default,,0,0,0,,!أوه، هاي\N!لا تدخُل المكان ببساطة
Dialogue: 0,0:51:23.58,0:51:26.39,Default,,0,0,0,,.يا إلهي\N!ها هو يفعلها ثانيةً
Dialogue: 0,0:51:28.33,0:51:30.33,Default,,0,0,0,,...هاي، تُوجد أحرُفٌ مُدمّيةٌ هُنا
Dialogue: 0,0:51:30.33,0:51:31.34,Default,,0,0,0,,!هاي
Dialogue: 0,0:51:32.31,0:51:34.11,Default,,0,0,0,,!يجب على الأشقياء الخُروج
Dialogue: 0,0:51:39.15,0:51:40.51,Default,,0,0,0,,.نعم
Dialogue: 0,0:51:40.51,0:51:42.09,Default,,0,0,0,,.ألقي نظرةً على هذا
Dialogue: 0,0:51:42.09,0:51:43.14,Default,,0,0,0,,.فهمت
Dialogue: 0,0:51:44.18,0:51:48.71,Default,,0,0,0,,تمّ تلفيق التّهمة لكَ بالكامل، صحيح، كيد؟
Dialogue: 0,0:51:52.90,0:51:54.98,Default,,0,0,0,,.هـ-هاتوا ما لَديكم
Dialogue: 0,0:51:54.98,0:52:00.65,Default,,0,0,0,,أ-أصبح هذا... مُثيراً للإهتمام بالفِعل، صحيح...؟
Dialogue: 0,0:52:01.76,0:52:04.83,Default,,0,0,0,,...هذا ما قد أتوَقّعه من شيءٍ اخترتِه، سونوكو سان
Dialogue: 0,0:52:04.83,0:52:08.33,Default,,0,0,0,,.كِلا الأرزّ بالدّجاج و عصير البطّيخ كانا لَذيذان جدّاً
Dialogue: 0,0:52:08.33,0:52:09.64,Default,,0,0,0,,!أعلَم، صحيح؟
Dialogue: 0,0:52:11.39,0:52:13.15,Default,,0,0,0,,هل من شيءٍ آخر؟
Dialogue: 0,0:52:13.15,0:52:17.42,Default,,0,0,0,,...حـ-حسناً، الآن بعد امتلاء مَعِدَتينا
Dialogue: 0,0:52:17.42,0:52:20.92,Default,,0,0,0,,...هناك مكانٌ أرغب بالذّهاب إليه، ماكوتو سان
Dialogue: 0,0:52:20.92,0:52:22.66,Default,,0,0,0,,.سأُرافقكِ أينما كان
Dialogue: 0,0:52:28.20,0:52:29.79,Default - E,,0,0,0,,!يبدو هذا سيّئاً
Dialogue: 0,0:52:30.25,0:52:31.33,Default - E,,0,0,0,,!هاي، أيّتها الفتاة
Dialogue: 0,0:52:31.33,0:52:33.83,Default - E,,0,0,0,,ماذا ستفعلين بشأن هذا؟
Dialogue: 0,0:52:33.83,0:52:36.63,Default,,0,0,0,,!ألَم تكُن من اصطدَم بي؟
Dialogue: 0,0:52:36.63,0:52:39.21,Default - E,,0,0,0,,!هاه؟ لا أعرف ماذا تعنين
Dialogue: 0,0:52:39.46,0:52:40.51,Default - E,,0,0,0,,!تعالي
Dialogue: 0,0:52:47.47,0:52:48.14,Default - E,,0,0,0,,!!تبّاً
Dialogue: 0,0:52:56.52,0:52:59.55,Default,,0,0,0,,.قد يكون معه رِفاقٌ آخرون يترصّدون
Dialogue: 0,0:52:59.55,0:53:02.55,Default,,0,0,0,,.سونوكو سان، إبقي بقُربي رجاءً
Dialogue: 0,0:53:02.55,0:53:03.91,Default,,0,0,0,,!حـ-حسناً
Dialogue: 0,0:53:13.92,0:53:18.96,Default,,0,0,0,,.قبضتكَ خطيرة، و قد تُؤذي من تُحبّ
Dialogue: 0,0:53:32.91,0:53:34.33,Default,,0,0,0,,!سونوكو سان
Dialogue: 0,0:53:56.04,0:53:57.56,Default,,0,0,0,,...لَقد وَجدتّها
Dialogue: 0,0:53:57.56,0:53:59.09,Default,,0,0,0,,!أرجوكم ساعدوني
Dialogue: 0,0:54:28.14,0:54:29.20,Default,,0,0,0,,!سونوكو سان
Dialogue: 0,0:54:31.03,0:54:31.91,Default - E,,0,0,0,,هل هي بخير؟
Dialogue: 0,0:54:31.91,0:54:34.00,Default - E,,0,0,0,,.سأطلُب الإسعاف
Dialogue: 0,0:54:34.00,0:54:35.16,Default - E,,0,0,0,,هل هي أجنبيّة...؟
Dialogue: 0,0:54:37.69,0:54:39.10,Default,,0,0,0,,!سونوكو سان
Dialogue: 0,0:54:46.95,0:54:48.43,Default,,0,0,0,,.سونوكو سان
Dialogue: 0,0:54:48.43,0:54:50.12,Default,,0,0,0,,!سونوكو سان
Dialogue: 0,0:54:50.74,0:54:53.64,Default,,0,0,0,,!سونوكو سان! سونوكو سان
Dialogue: 0,0:55:02.54,0:55:04.71,Default,,0,0,0,,ماذا قالوا عن حالة جِراحها؟
Dialogue: 0,0:55:04.71,0:55:07.13,Default,,0,0,0,,.قال بأنّها لَيست مُهدّدةً للحياة
Dialogue: 0,0:55:07.13,0:55:10.07,Default,,0,0,0,,...إنّها نائمةٌ الآن، لذا سيُدخلونها للّيلة
Dialogue: 0,0:55:10.07,0:55:12.70,Default,,0,0,0,,.و يبدو بأنّهم سيفحصونها في الغد
Dialogue: 0,0:55:13.28,0:55:15.35,Default,,0,0,0,,.أنا سعيدةٌ جدّاً
Dialogue: 0,0:55:16.24,0:55:19.02,Default,,0,0,0,,...لكن مع ذلك، حادثة الصّدم و الهرَب الوَحشيّة هذه
Dialogue: 0,0:55:19.02,0:55:20.58,Default,,0,0,0,,.هذا خطأي
Dialogue: 0,0:55:20.58,0:55:24.32,Default,,0,0,0,,...بسببي، سونوكو سان
Dialogue: 0,0:55:26.11,0:55:27.59,Default,,0,0,0,,!أعتذر لإبقائكم تنتظرون
Dialogue: 0,0:55:27.59,0:55:29.74,Default,,0,0,0,,!أعتذر لتأخّري
Dialogue: 0,0:55:29.74,0:55:31.34,Default,,0,0,0,,.لا مُشكلة\N.أحسنتَ هناك
Dialogue: 0,0:55:31.34,0:55:33.33,Default,,0,0,0,,كيف يجري التّحقيق؟
Dialogue: 0,0:55:33.33,0:55:34.32,Default,,0,0,0,,...نعم، حسناً
Dialogue: 0,0:55:34.32,0:55:36.70,Default,,0,0,0,,...وَقعَ ذلك في زِقاقٍ خلفيٍّ حيث لا يمرّ عبره الكثير من الأشخاص
Dialogue: 0,0:55:36.70,0:55:38.37,Default,,0,0,0,,.لذا لا يُوجد الكثير من الشّهود
Dialogue: 0,0:55:38.37,0:55:41.38,Default,,0,0,0,,...لأكون أدقّ، كان يُوجد هناك أشخاص
Dialogue: 0,0:55:41.38,0:55:46.11,Default,,0,0,0,,.لكنّهم أُخِذوا على حين غرّةٍ عندما سُرِقَت سيّارة الدّوريّة و أُغميَ عليهم
Dialogue: 0,0:55:48.92,0:55:49.72,Default,,0,0,0,,!أوه
Dialogue: 0,0:55:50.97,0:55:52.74,Default,,0,0,0,,.آمَل ألّا أكون قد أزعجتكم
Dialogue: 0,0:55:52.74,0:55:55.47,Default,,0,0,0,,ليون سينساي؟\Nماذا تفعل هُنا؟
Dialogue: 0,0:55:55.47,0:55:57.77,Default,,0,0,0,,.سمعتُ عن الحادثة و أسرَعتُ إلى هُنا
Dialogue: 0,0:55:57.77,0:56:00.23,Default,,0,0,0,,...مازالَت سونوكو نائمة
Dialogue: 0,0:56:00.23,0:56:02.52,Default,,0,0,0,,بتلك الحال، هل يُمكنكِ إعطاؤها هذه بدلاً عنّي؟
Dialogue: 0,0:56:02.52,0:56:03.88,Default,,0,0,0,,.شُكراً لك
Dialogue: 0,0:56:07.78,0:56:11.38,Default,,0,0,0,,.يبدو بأنّ قلَقي كان صحيحاً
Dialogue: 0,0:56:11.38,0:56:15.91,Default,,0,0,0,,.سيّد القِتال يختبرك
Dialogue: 0,0:56:15.91,0:56:21.64,Default,,0,0,0,,.يقول بأنّكَ لا تملك العقل و الجّسد و الرّوح المُتطلّبة بعد لاستخدام قبضتك
Dialogue: 0,0:56:21.64,0:56:25.06,Default,,0,0,0,,.أعلَم\N.سأُعطيكَ تعويذة
Dialogue: 0,0:56:26.63,0:56:29.13,Default,,0,0,0,,.هي كسِوار تعويذة حظٍّ نوعاً ما
Dialogue: 0,0:56:29.13,0:56:31.05,Default,,0,0,0,,...إن قُطِعَت
Dialogue: 0,0:56:31.05,0:56:34.78,Default,,0,0,0,,.ستكون دلالةً على اعتراف السيّد بأنّكَ أصبحتَ تملك العقليّة و الجّسد و الرّوح المُلائمين
Dialogue: 0,0:56:34.78,0:56:38.47,Default,,0,0,0,,...لكن إن استخدمتَ قبضتكَ قبل أن تنقطِع
Dialogue: 0,0:56:38.47,0:56:39.54,Default,,0,0,0,,تعرف ما سيحصل، صحيح؟
Dialogue: 0,0:56:44.92,0:56:47.38,Default,,0,0,0,,...هذا مُؤلِم
Dialogue: 0,0:56:48.42,0:56:50.42,Default,,0,0,0,,.تعرّضتّ لضررٍ كبير
Dialogue: 0,0:56:50.42,0:56:52.74,Default,,0,0,0,,.خدشٌ كهذا لا يُعتبر شيئاً مُهمّاً
Dialogue: 0,0:56:52.74,0:56:53.42,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:56:53.42,0:56:55.45,Default,,0,0,0,,...إطلاقهم النّار عليّ دون تحفّظ
Dialogue: 0,0:56:55.45,0:56:58.06,Default,,0,0,0,,.تمّ التّغلّب عليّ بالدّهاء هذه المرّة بالفِعل
Dialogue: 0,0:56:58.06,0:57:02.06,Default,,0,0,0,,.يجعلون جريمة قتل رايتشل سان من ارتكابك
Dialogue: 0,0:57:02.06,0:57:06.94,Default,,0,0,0,,.كلّ هذا فخٌّ مُعَدٌّ لتلفيق التّهمة لكَ على الجّرائم
Dialogue: 0,0:57:06.94,0:57:09.18,Default,,0,0,0,,.كأنّه سِحر
Dialogue: 0,0:57:09.18,0:57:11.57,Default,,0,0,0,,...بالرّغم من عدَم وُجودي هناك
Dialogue: 0,0:57:11.57,0:57:18.08,Default,,0,0,0,,.بالنّسبة للجّماهير المُراقبة، أبدو بالتّأكيد كقاتِلٍ رُبّما كان هناك
Dialogue: 0,0:57:18.08,0:57:22.85,Default,,0,0,0,,لذا بالأساس، يُمكنكَ البِدء برُؤية كيف تمّ تنفيذ الخِدعة إن غيّرتَ طريقة رُؤيتكَ لها؟
Dialogue: 0,0:57:24.71,0:57:26.13,Default,,0,0,0,,...نعم
Dialogue: 0,0:57:26.13,0:57:31.30,Default,,0,0,0,,...يجعل السّاحر الشّخص يظنّ بأنّه قد يكون يحمل شيئاً في قبضته المُغلَقة
Dialogue: 0,0:57:31.30,0:57:36.66,Default,,0,0,0,,و يُخمّن المُتحرّي بشكلٍ صحيحٍ ماذا يُوجد في قبضته قبل أن تُفتَح، صحيح؟
Dialogue: 0,0:57:44.96,0:57:48.15,Default,,0,0,0,,...لذا خمّن ما هو بشكلٍ صحيح، أيّها المُتحرّي العظيم
Dialogue: 0,0:57:48.15,0:57:53.28,Default,,0,0,0,,."مُحتوى القبضة المُغلَقة الغامضة المَعروفة بـ"القاتِل
Dialogue: 0,0:57:53.80,0:57:54.90,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:58:06.35,0:58:07.42,Default,,0,0,0,,...أوه
Dialogue: 0,0:58:07.42,0:58:09.92,Default,,0,0,0,,ألَم تذهب إلى المنزل بعد، أيّها الطّفل؟
Dialogue: 0,0:58:09.92,0:58:12.99,Default,,0,0,0,,هاي، هل يُمكنني إمضاء اللّيلة عندكَ اللّيلة؟
Dialogue: 0,0:58:12.99,0:58:15.45,Default,,0,0,0,,...ماذا\Nفي منزلي؟
Dialogue: 0,0:58:15.45,0:58:18.68,Default,,0,0,0,,.سأكون وَحدي، حتّى لَو ذهبتُ إلى المنزل
Dialogue: 0,0:58:18.68,0:58:22.83,Default,,0,0,0,,...و أشعر بالخوف من كلّ الأُمور التي حصلَت مُؤخّراً
Dialogue: 0,0:58:22.83,0:58:24.75,Default,,0,0,0,,...لكن إن أمكنني إخبارهما بأنّني كنتُ معك، ريشي سان
Dialogue: 0,0:58:24.75,0:58:27.69,Default,,0,0,0,,!وَاثقٌ من أنّ وَالِداي سيشعران بالرّاحة أيضاً
Dialogue: 0,0:58:29.96,0:58:34.36,Default,,0,0,0,,.بعد كلّ شيء، إمضاء ليلتين مُتتاليتين في نفس الغُرفة مع ذلك الشّخص سيكون الأسوأ
Dialogue: 0,0:58:40.99,0:58:42.99,Default,,0,0,0,,!أوه، هذا مُذهل
Dialogue: 0,0:58:42.99,0:58:46.23,Default,,0,0,0,,هل حصلتَ على كلّ هذه من وَالِدك، ريشي سان؟
Dialogue: 0,0:58:46.23,0:58:47.50,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:58:47.50,0:58:49.15,Default,,0,0,0,,.كما ترى، وَالِدي أخصّائي عِلم مُحيطات
Dialogue: 0,0:58:49.15,0:58:51.44,Default,,0,0,0,,...للأسف، مات قبل 5 أعوام
Dialogue: 0,0:58:51.44,0:58:55.24,Default,,0,0,0,,.لكن خلال أبحاثه، وَجد أحافيراً و ما شابه غارقةً في المُحيط
Dialogue: 0,0:58:55.24,0:58:57.13,Default,,0,0,0,,أنتَ فخورٌ بوَالِدك، صحيح؟
Dialogue: 0,0:58:57.13,0:58:58.49,Default,,0,0,0,,!نعم
Dialogue: 0,0:58:58.49,0:59:00.99,Default,,0,0,0,,...حسناً، مازال لَديّ بعض العمل المُتبقّي لفِعله
Dialogue: 0,0:59:00.99,0:59:02.89,Default,,0,0,0,,.لذا نَم قبلي، آرثر كن
Dialogue: 0,0:59:02.89,0:59:04.75,Default,,0,0,0,,!حسناً
Dialogue: 0,0:59:05.37,0:59:07.27,Default,,0,0,0,,...أوه\N.هاي، ريشي سان
Dialogue: 0,0:59:07.27,0:59:10.38,Default,,0,0,0,,ما العلامات الحمراء على هذه الخريطة؟
Dialogue: 0,0:59:10.38,0:59:14.40,Default,,0,0,0,,.أوه، تُظهِر أماكن مُهاجمة القراصنة للسّفن
Dialogue: 0,0:59:14.40,0:59:16.76,Default,,0,0,0,,!يُوجد قراصنةٌ حتّى في هذه الأيّام؟
Dialogue: 0,0:59:16.76,0:59:17.92,Default,,0,0,0,,!بالتّأكيد
Dialogue: 0,0:59:17.92,0:59:21.41,Default,,0,0,0,,.في الماضي البعيد، كان الكثير منهم بالقُرب من سينغافورة
Dialogue: 0,0:59:21.41,0:59:26.66,Default,,0,0,0,,.لكنّني أكثر قلَقاً بشأن قضيّة القتل هذه من قلَقي من القراصنة الآن
Dialogue: 0,0:59:26.66,0:59:28.89,Default,,0,0,0,,.و ثمّ يُوجد كايتو كيد علاوةً على كلّ ذلك
Dialogue: 0,0:59:28.89,0:59:32.04,Default,,0,0,0,,...إستعرتُ بعض المُستندات من المُفتّش المُساعد إيدان
Dialogue: 0,0:59:33.54,0:59:36.11,Default,,0,0,0,,.لكن أظنّني سأعمل طوال اللّيلة اللّيلة
Dialogue: 0,0:59:41.18,0:59:43.49,Default,,0,0,0,,...أشعر بالسّوء لفِعل هذا لريشي سان
Dialogue: 0,0:59:43.49,0:59:45.31,Default,,0,0,0,,.لكنّني سأجعله يحصل على قيلولةٍ جيّدة
Dialogue: 0,1:00:06.64,1:00:08.96,Default,,0,0,0,,هاي، ما هذه؟
Dialogue: 0,1:00:08.96,1:00:10.71,Default,,0,0,0,,.لَم أعلَم بأنّ لَديكَ شيئاً كهذا
Dialogue: 0,1:00:10.71,1:00:12.85,Default,,0,0,0,,!سونوكو سان\N!هل استيقظتِ؟
Dialogue: 0,1:00:13.84,1:00:15.61,Default,,0,0,0,,.في الوَاقع، إستيقظتُ منذ فترة
Dialogue: 0,1:00:16.91,1:00:19.15,Default,,0,0,0,,.أنا سعيدٌ جدّاً بالفِعل
Dialogue: 0,1:00:19.15,1:00:21.59,Default,,0,0,0,,هاي، هل تلك تعويذة حظٍّ من نوعٍ ما؟
Dialogue: 0,1:00:21.59,1:00:24.60,Default,,0,0,0,,...نعم\N.هي شيءٌ من هذا القبيل
Dialogue: 0,1:00:29.45,1:00:31.52,Default,,0,0,0,,!كلّا، لا يُمكنكِ\N.أرجوكِ استرخي و ارتاحي
Dialogue: 0,1:00:33.38,1:00:36.00,Default,,0,0,0,,.لَستُ نعِسةً على الإطلاق
Dialogue: 0,1:00:36.00,1:00:39.03,Default,,0,0,0,,.هذا مُملٌّ جدّاً، حتّى بعد قطعنا طوال المَسافة إلى سينغافورة
Dialogue: 0,1:00:39.03,1:00:41.09,Default,,0,0,0,,.سيكون سيّئاً لجسدكِ إن حاولتِ فِعل الكثير
Dialogue: 0,1:00:41.09,1:00:42.91,Default,,0,0,0,,.لذا أرجوكِ استرخي و ارتاحي اللّيلة
Dialogue: 0,1:00:44.91,1:00:47.47,Default,,0,0,0,,...كما تعلَم، كنتُ أنتظر سؤالكَ عن هذا منذ فترة
Dialogue: 0,1:00:47.47,1:00:50.41,Default,,0,0,0,,لكن لِمَ لا تخلَع أبداً تلك الضّمادة عند حاجبكَ الأيسر؟
Dialogue: 0,1:00:50.41,1:00:51.56,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:00:51.56,1:00:55.17,Default,,0,0,0,,...كـ-كلّا\N.هذا لا شيء مُهمّ، حقّاً
Dialogue: 0,1:00:55.17,1:00:57.04,Default,,0,0,0,,هاه...؟
Dialogue: 0,1:01:14.52,1:01:16.27,Default - E,,0,0,0,,...ظننتُ بأنّه لَم يكُن يُفترض بنا أن نلتقي
Dialogue: 0,1:01:16.27,1:01:18.23,Default - E,,0,0,0,,حتّى انتهاء كلّ شيء؟...
Dialogue: 0,1:01:18.48,1:01:20.65,Default - E,,0,0,0,,...تفاخرتَ بأنّ خُطّتكَ كانت مِثاليّة
Dialogue: 0,1:01:20.65,1:01:22.82,Default - E,,0,0,0,,لكن هل أنتَ وَاثقٌ تماماً؟
Dialogue: 0,1:01:23.82,1:01:27.07,Default - E,,0,0,0,,.تبدو قويّاً، لكنّكَ جبانٌ في الوَاقع
Dialogue: 0,1:01:27.33,1:01:29.58,Default - E,,0,0,0,,...الآن، راقب ألفاظك
Dialogue: 0,1:01:38.59,1:01:40.46,Default - E,,0,0,0,,.أُحافظ على وُعودي دائماً
Dialogue: 0,1:01:40.46,1:01:41.59,Default - E,,0,0,0,,.أفعل
Dialogue: 0,1:01:47.70,1:01:49.66,Default,,0,0,0,,.إن خدعتَني، سأخدعكَ أيضاً
Dialogue: 0,1:01:49.66,1:01:52.02,Default,,0,0,0,,.هذا هو مَبدأي
Dialogue: 0,1:02:04.80,1:02:06.94,Default - E,,0,0,0,,.لَدينا إعلانٌ للقيام به
Dialogue: 0,1:02:04.78,1:02:10.78,Title,,0,0,0,,{\fs60\pos(1900,20)}تان لي                                                                                             ماكوتو كيوغوكو
Dialogue: 0,1:02:06.94,1:02:08.55,Default - E,,0,0,0,,...في نِزال نِصف النّهائيّات الـ2
Dialogue: 0,1:02:08.53,1:02:11.08,Default - E,,0,0,0,,...إنسحبَ ماكوتو كيوغوكو
Dialogue: 0,1:02:11.08,1:02:13.87,Default - E,,0,0,0,,!و سيتقدّم تان لي إلى النّهائيّات
Dialogue: 0,1:02:14.08,1:02:14.62,Default - E,,0,0,0,,!سُحقاً
Dialogue: 0,1:02:15.21,1:02:16.92,Default - E,,0,0,0,,!لَم أطلُب هذا
Dialogue: 0,1:02:17.54,1:02:19.54,Default,,0,0,0,,!إنسحبتَ من البُطولة؟
Dialogue: 0,1:02:19.54,1:02:21.82,Default,,0,0,0,,لماذا؟\Nهل هذا بسببي؟
Dialogue: 0,1:02:21.82,1:02:26.05,Default,,0,0,0,,...هناك فُرصة أن تعود العِصابة التي هاجمَتنا لمُهاجمَتنا ثانيةً
Dialogue: 0,1:02:26.05,1:02:28.93,Default,,0,0,0,,.لذا لا يُمكنني ترككِ، سونوكو سان
Dialogue: 0,1:02:29.80,1:02:31.93,Default,,0,0,0,,إذاً هذا بسببي حقّاً، صحيح؟
Dialogue: 0,1:02:31.93,1:02:33.51,Default,,0,0,0,,!إذهب و شارك في البُطولة
Dialogue: 0,1:02:33.51,1:02:35.94,Default,,0,0,0,,!ألا يُوجد خصمٌ ترغب بقِتاله؟
Dialogue: 0,1:02:35.94,1:02:37.44,Default,,0,0,0,,.نعم
Dialogue: 0,1:02:37.44,1:02:40.86,Default,,0,0,0,,...لكن بما أنّني لَم أتمكّن حتّى من حمايتكِ، سونوكو سان
Dialogue: 0,1:02:40.86,1:02:43.71,Default,,0,0,0,,.أشعر كما لَو أنّني مازلتُ أفتقر لشيءٍ ما
Dialogue: 0,1:02:45.11,1:02:47.28,Default,,0,0,0,,.تفتقر لشيءٍ ما بالتّأكيد
Dialogue: 0,1:02:47.28,1:02:49.76,Default,,0,0,0,,!كلّ ما تفعله هو إخفاء الأُمور عنّي، ماكوتو سان
Dialogue: 0,1:02:49.76,1:02:50.93,Default,,0,0,0,,أُخفي الأُمور؟
Dialogue: 0,1:02:50.93,1:02:55.29,Default,,0,0,0,,لَن تُخبرني عن السّوار أو الضّمادة، صحيح؟
Dialogue: 0,1:02:55.29,1:02:58.92,Default,,0,0,0,,...كلّا\N...هُما حقّاً، أمم
Dialogue: 0,1:02:59.79,1:03:00.54,Default,,0,0,0,,.أُخرُج
Dialogue: 0,1:03:00.54,1:03:01.42,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:03:01.42,1:03:05.80,Default,,0,0,0,,!لا أُريد أن يحميني رجلٌ تملأه الكذِبات هكذا
Dialogue: 0,1:03:08.24,1:03:10.80,Default,,0,0,0,,.كما تعلَم، شعرتُ بالقلَق جدّاً البارحة
Dialogue: 0,1:03:10.80,1:03:12.78,Default,,0,0,0,,.لَم أتمكّن من الإتّصال بكَ أبداً
Dialogue: 0,1:03:12.78,1:03:14.16,Default,,0,0,0,,.أعتذر، أعتذر
Dialogue: 0,1:03:14.16,1:03:16.96,Default,,0,0,0,,...إستغرقتُ جدّاً بمُلاحقة كيد فقط
Dialogue: 0,1:03:16.96,1:03:19.06,Default,,0,0,0,,.لكن هذا هو المُتوَقّع فقط من السّاحر تحت ضوء القمر
Dialogue: 0,1:03:19.06,1:03:22.50,Default,,0,0,0,,...القبض عليه سيكون مُستحيلاً حتّى بالنّسبة لي، كودو شينتشي
Dialogue: 0,1:03:25.26,1:03:26.72,Default,,0,0,0,,.أوه، آرثر كن
Dialogue: 0,1:03:26.72,1:03:27.95,Default,,0,0,0,,!مرحباً
Dialogue: 0,1:03:27.95,1:03:31.32,Default,,0,0,0,,هل صديقتكِ سونوكو أونيسان بخير؟
Dialogue: 0,1:03:31.32,1:03:32.22,Default,,0,0,0,,!نعم
Dialogue: 0,1:03:32.22,1:03:34.12,Default,,0,0,0,,...ذهبتُ إلى المَشفى قبل قليل
Dialogue: 0,1:03:34.12,1:03:36.08,Default,,0,0,0,,.و أظهرَت نتائج الفحص عدَم وُجود أيّ مَشاكل
Dialogue: 0,1:03:36.08,1:03:39.35,Default,,0,0,0,,.يبدو بأنّه سيتمّ إخراجها من المَشفى و ستعود إلى الفُندق بعد ظُهر اليوم
Dialogue: 0,1:03:39.35,1:03:40.90,Default,,0,0,0,,.هيه، هذا عظيم
Dialogue: 0,1:03:40.90,1:03:43.15,Default,,0,0,0,,.شُكراً لقلقكَ عليها
Dialogue: 0,1:03:43.15,1:03:45.11,Default,,0,0,0,,.لنعُد إلى الفُندق بسرعة
Dialogue: 0,1:03:45.11,1:03:47.19,Default,,0,0,0,,.أرغب بتوضيب أمتعتنا للعودة
Dialogue: 0,1:03:47.19,1:03:49.63,Default,,0,0,0,,ألا تُمانعين بترك سونوكو أونيسان و صديقها وَحدهما؟
Dialogue: 0,1:03:49.63,1:03:50.59,Default,,0,0,0,,...نعم
Dialogue: 0,1:03:50.59,1:03:52.74,Default,,0,0,0,,.فكّرتُ بتركهما وَحدهما لفترة
Dialogue: 0,1:03:52.74,1:03:55.24,Default,,0,0,0,,...يبدو بأنّهما كانا يمرّان بخِلافٍ من نوعٍ ما
Dialogue: 0,1:03:55.24,1:03:58.23,Default,,0,0,0,,.و انسحبَ كيوغوكو سان من البُطولة حتّى
Dialogue: 0,1:03:59.54,1:04:02.15,Default,,0,0,0,,إنتظر، شينتشي؟
Dialogue: 0,1:04:02.36,1:04:04.90,Title,,0,0,0,,{\fad(300,0)\pos(1077,735)}نافورة الثّروة
Dialogue: 0,1:04:04.90,1:04:08.51,Default,,0,0,0,,إذاً، أيّها المُتحرّي العظيم، هل تمكّنتَ من جمع أيّة مَعلوماتٍ ليلة البارحة؟
Dialogue: 0,1:04:08.51,1:04:11.66,Default,,0,0,0,,...وِفقاً لتقارير التّحقيق التي رأيتُها في منزل ريشي سان، كانت هكذا
Dialogue: 0,1:04:16.72,1:04:18.77,Default,,0,0,0,,...وِفقاً لشهادة الشّهود العيان
Dialogue: 0,1:04:18.77,1:04:22.40,Default,,0,0,0,,...لَم تُطعَن شيريلين سان في مركز التّسوّق حيث انهارَت
Dialogue: 0,1:04:22.40,1:04:25.67,Default,,0,0,0,,.لكن رُبّما وَقع ذلك في مِصعد البُرج الـ3
Dialogue: 0,1:04:19.08,1:04:22.12,Title,,0,0,0,,{\fs60\b1\pos(1886,610)}مركز التّسوّق
Dialogue: 0,1:04:22.12,1:04:25.67,Title,,0,0,0,,{\fs60\b1\pos(1344,48)}البُرج الـ1                     البُرج الـ2                     البُرج الـ3
Dialogue: 0,1:04:25.67,1:04:27.94,Default,,0,0,0,,لِمَ قد يُكلّف أحدٌ نفسه عناء فِعل ذلك في المِصعد؟
Dialogue: 0,1:04:27.94,1:04:30.56,Default,,0,0,0,,إن لَم ينجح الأمر، لَن يكون هناك مكانٌ للهرَب إليه، صحيح؟
Dialogue: 0,1:04:34.18,1:04:37.01,Default,,0,0,0,,...بسكّينٍ تمّ شِراؤه من المَتجر مازال مُنغرِساً في ظهرها
Dialogue: 0,1:04:37.01,1:04:38.85,Default,,0,0,0,,.إستمرّت بالتّقدّم إلى مركز التّسوّق
Dialogue: 0,1:04:42.00,1:04:43.44,Default,,0,0,0,,...ثمّ بعد انهيارها مُباشرةً
Dialogue: 0,1:04:43.44,1:04:48.17,Default,,0,0,0,,...إنفجرَت سيّارتها في مَوقِف السيّارات تحت الأرض
Dialogue: 0,1:04:48.17,1:04:51.20,Default,,0,0,0,,.ممّا تسبّب بانقطاعٍ في الكهرباء في جميع أرجاء الفُندق
Dialogue: 0,1:04:51.20,1:04:56.20,Default,,0,0,0,,و هكذا، تمّ قطع تغذية الفيديو من جميع كاميرات أمن الفُندق؟
Dialogue: 0,1:04:56.20,1:04:59.37,Default,,0,0,0,,.ما يُزعجني هو وُجود ليون في مَسرَح الجّريمة
Dialogue: 0,1:04:59.37,1:05:03.23,Default,,0,0,0,,.أعدّ غُرفةً له و أُخرى لشيريلين سان
Dialogue: 0,1:05:03.23,1:05:05.19,Default,,0,0,0,,...لكن عندما قُتِلَت
Dialogue: 0,1:05:05.19,1:05:08.78,Default,,0,0,0,,.رآى عددٌ ضخمٌ من الشّهود بأنّه كان يركب مِصعداً مُختلِفاً
Dialogue: 0,1:05:08.78,1:05:10.61,Default,,0,0,0,,...لذا بسبب تأكيد حُجّة غيابه
Dialogue: 0,1:05:10.61,1:05:13.43,Default,,0,0,0,,تمّ استبعاده من خطّ التّحقيق؟
Dialogue: 0,1:05:13.43,1:05:14.61,Default,,0,0,0,,.بالضّبط
Dialogue: 0,1:05:14.61,1:05:18.26,Default,,0,0,0,,بالتّفكير بالأمر، لِمَ كان ليون يحمل حقيبة؟
Dialogue: 0,1:05:18.26,1:05:21.06,Default,,0,0,0,,...أوه، فحصَت الشّرطة مُحتواها بالتّأكيد
Dialogue: 0,1:05:21.06,1:05:23.19,Default,,0,0,0,,.لكنّها كانت فارِغة
Dialogue: 0,1:05:23.19,1:05:27.19,Default,,0,0,0,,.أرسلَ الحقيبة لإصلاحها فقط، و ثمّ أتى لأخذها
Dialogue: 0,1:05:27.19,1:05:31.44,Default,,0,0,0,,.و تمّ تأكيد أنّ المَتجر بالقُرب من الفُندق قد استلَم طلَبه
Dialogue: 0,1:05:31.44,1:05:33.78,Default,,0,0,0,,إذاً يملك حُجّة الغِياب المِثاليّة، هاه؟
Dialogue: 0,1:05:33.78,1:05:34.99,Default,,0,0,0,,...هناك شيءٌ آخر
Dialogue: 0,1:05:34.99,1:05:36.74,Default,,0,0,0,,.هذه
Dialogue: 0,1:05:36.74,1:05:40.01,Default,,0,0,0,,لِمَ تمّ ترك هذه في مَسرَح الجّريمة؟
Dialogue: 0,1:05:40.01,1:05:42.18,Default,,0,0,0,,ما الحاجة لتوريطي في هذا؟
Dialogue: 0,1:05:42.18,1:05:45.23,Default,,0,0,0,,.و وَصل الأمر حتّى لتلطيخها بالدّم
Dialogue: 0,1:05:45.23,1:05:46.25,Default,,0,0,0,,...بهذا الوَضع
Dialogue: 0,1:05:48.36,1:05:51.94,Default,,0,0,0,,.هناك مُحاولة تحميلكَ اللّوم على جريمة قتل رايتشل سان
Dialogue: 0,1:05:51.94,1:05:55.51,Default,,0,0,0,,.السكّين المُستخدَم كسلاح القتل هو نفس نوع المُستخدَم بقتل شيريلين سان
Dialogue: 0,1:05:56.51,1:06:01.29,Default,,0,0,0,,.وُضِعَت رايتشل سان داخل القاعدة قبل دُخولي الغُرفة الآمنة
Dialogue: 0,1:06:01.29,1:06:03.08,Default,,0,0,0,,...لكن لدُخول الغُرفة
Dialogue: 0,1:06:03.08,1:06:06.83,Default,,0,0,0,,.على الشّخص تجاوز ضُبّاط الأمن و عدداً لا يُحصى من أنظمة الأمن
Dialogue: 0,1:06:06.83,1:06:11.28,Default,,0,0,0,,...من يُمكنه الإنسلال مُتجاوزاً أعيُن الأمن و الدّخول دون لَمس المُستشعرات
Dialogue: 0,1:06:12.23,1:06:13.53,Default,,0,0,0,,.لَيس أنا
Dialogue: 0,1:06:14.52,1:06:17.16,Default,,0,0,0,,.كما ظننت، ليون لو هو الأكثر ريبة
Dialogue: 0,1:06:17.16,1:06:19.77,Default,,0,0,0,,...بكَون ليون هو من يُدير الغُرفة الآمنة
Dialogue: 0,1:06:19.77,1:06:22.18,Default,,0,0,0,,.سيملك مَعرفةً كاملةً بأنظمة الأمن الموجودة
Dialogue: 0,1:06:22.18,1:06:26.35,Default,,0,0,0,,.أيضاً، تمّ جلب الحِزام إلى الإستاد صباح البارحة
Dialogue: 0,1:06:26.35,1:06:30.63,Default,,0,0,0,,.و تمّ تأكيد بأنّ رايتشل سان كانت على قيد الحياة قبل ليلتين
Dialogue: 0,1:06:30.63,1:06:35.30,Default,,0,0,0,,.بمَعنىً آخر، من المُرجّح وُقوع الجّريمة في تلك اللّيلة قبل نقل الحِزام
Dialogue: 0,1:06:36.26,1:06:37.74,Default,,0,0,0,,لكن لِمَ؟
Dialogue: 0,1:06:37.74,1:06:40.76,Default,,0,0,0,,لِمَ احتاج لقتل سكرتيرته؟
Dialogue: 0,1:06:40.76,1:06:43.43,Default,,0,0,0,,.قد يكون ذلك دافعه
Dialogue: 0,1:06:44.27,1:06:48.27,Default,,0,0,0,,.كانت رايتشل سان تُحاول إخبار العمّ شيئاً ما
Dialogue: 0,1:06:45.27,1:06:48.27,Title,,0,0,0,,{=309}{\fs60\b1}رايتشل
Dialogue: 0,1:06:48.27,1:06:51.52,Default,,0,0,0,,.و تلك الأحرُف المُدمّية هي الدّلائل التي تركَتها
Dialogue: 0,1:06:51.52,1:06:52.57,Default,,0,0,0,,..."هي"
Dialogue: 0,1:06:52.57,1:06:55.28,Default,,0,0,0,,يُشير هذا لامرأةٍ أُخرى، لكن من؟
Dialogue: 0,1:06:52.82,1:06:55.28,Title,,0,0,0,,{\b1\c&H000000&\3c&HFFFFFF&\4c&HE5B4B1&\pos(1759,299)}هي\N\N\N=
Dialogue: 0,1:06:52.82,1:06:55.28,Title,,0,0,0,,{\fad(300,300)\b1\c&H000000&\3c&HFFFFFF&\4c&HE5B4B1&\pos(1763,619)}إمرأةٌ أُخرى
Dialogue: 0,1:07:05.79,1:07:07.48,Default,,0,0,0,,.لا فائدة
Dialogue: 0,1:07:07.48,1:07:09.73,Default,,0,0,0,,...أشعر كما لَو أنّ شيئاً ضخماً سيحصل
Dialogue: 0,1:07:09.73,1:07:11.42,Default,,0,0,0,,.لكن لا تترتّب أفكاري ببساطة
Dialogue: 0,1:07:11.42,1:07:14.53,Default,,0,0,0,,حتّى المُتحرّي العظيم يستسلِم؟
Dialogue: 0,1:07:14.53,1:07:16.90,Default,,0,0,0,,.إذاً لنأخذ استراحةً للوَقت الحاليّ
Dialogue: 0,1:07:16.90,1:07:18.86,Default,,0,0,0,,...بالصّدفة، يُوجد شيءٌ في إحدى قبضتاي، و
Dialogue: 0,1:07:18.86,1:07:21.82,Default,,0,0,0,,.يُوجد ماء جوز هندٍ في قبضتكَ اليُسرى
Dialogue: 0,1:07:21.82,1:07:23.06,Default,,0,0,0,,!هذا صحيح
Dialogue: 0,1:07:23.06,1:07:24.62,Default,,0,0,0,,كيف عرفت؟
Dialogue: 0,1:07:24.62,1:07:26.23,Default,,0,0,0,,ألَم تشتريه للتّوّ؟
Dialogue: 0,1:07:26.23,1:07:27.64,Default,,0,0,0,,أوه، إذاً كنتَ تُراقبني؟
Dialogue: 0,1:07:28.27,1:07:29.90,Default,,0,0,0,,سِحر، هاه؟
Dialogue: 0,1:07:30.65,1:07:35.61,Default,,0,0,0,,...يجعل السّاحر الشّخص يظنّ بأنّه قد يكون يحمل شيئاً في قبضته المُغلَقة
Dialogue: 0,1:07:35.61,1:07:40.41,Default,,0,0,0,,و يُخمّن المُتحرّي بشكلٍ صحيحٍ ماذا يُوجد في قبضته قبل أن تُفتَح، صحيح؟
Dialogue: 0,1:07:40.41,1:07:42.93,Default,,0,0,0,,!أوه\N.فهمت
Dialogue: 0,1:07:42.93,1:07:47.87,Default,,0,0,0,,بالتّفكير بالأمر، هل سونوكو أوجيو ساما مُتشاجرةٌ مع رجل الكراتيه ذاك؟
Dialogue: 0,1:07:47.87,1:07:48.91,Default,,0,0,0,,.هذا ما سمعتُه
Dialogue: 0,1:07:48.91,1:07:52.42,Default,,0,0,0,,...حسناً، أفترض بأن يعلَق الشّخص في شِجارٍ و أيضاً في حادثة سيرٍ
Dialogue: 0,1:07:52.42,1:07:55.67,Default,,0,0,0,,.سيُشعره بفُقدان الثّقة و القلَق
Dialogue: 0,1:07:55.67,1:07:57.31,Default,,0,0,0,,.إذاً هذا هو الأمر
Dialogue: 0,1:07:57.31,1:07:57.82,Default,,0,0,0,,هاه؟
Dialogue: 0,1:07:57.82,1:08:02.20,Default,,0,0,0,,.تسبّبَ بأذيّة سونوكو، و صدَم كيوغوكو سان عاطفيّاً
Dialogue: 0,1:08:02.20,1:08:07.31,Default,,0,0,0,,.بعد كلّ شيء، كيوغوكو سان هو أكبر عائقٍ لفوز جمال الدّين
Dialogue: 0,1:08:07.31,1:08:08.58,Default,,0,0,0,,.فهمت
Dialogue: 0,1:08:08.58,1:08:11.17,Default,,0,0,0,,إذاً تعني بأنّ ليون رتّبَ تلك الحادثة؟
Dialogue: 0,1:08:11.17,1:08:14.29,Default,,0,0,0,,.و كما خطّط، إنسحبَ كيوغوكو سان من البُطولة
Dialogue: 0,1:08:14.29,1:08:17.59,Default,,0,0,0,,.و الآن سيحصل جمال الدّين بالتّأكيد على حِزام البُطولة
Dialogue: 0,1:08:17.59,1:08:21.20,Default,,0,0,0,,.بمَعنىً آخر، سيتمّ تسليمه إلى ربّ عمَله، ليون
Dialogue: 0,1:08:21.20,1:08:23.60,Default,,0,0,0,,.مع قبضة الياقوتة الزّرقاء
Dialogue: 0,1:08:23.60,1:08:27.81,Default,,0,0,0,,لكن لِمَ ليون مُصرٌّ على الحصول على قبضة الياقوتة الزّرقاء؟
Dialogue: 0,1:08:27.81,1:08:30.96,Default,,0,0,0,,.حصلتُ على شيءٍ قد يكون تلميحاً لهذا
Dialogue: 0,1:08:30.96,1:08:33.73,Default,,0,0,0,,.هذا رجلٌ كان يلتقيه ليون وَقت الفَجر
Dialogue: 0,1:08:33.73,1:08:35.88,Default,,0,0,0,,ألا يُمكننا تحديد هويّة هذا الرّجل؟
Dialogue: 0,1:08:35.88,1:08:39.38,Default,,0,0,0,,...حسناً، هذا لَيس مُستحيلاً
Dialogue: 0,1:08:39.38,1:08:40.38,Up,,0,0,0,,!لَمستُك، حان دورك
Dialogue: 0,1:08:39.38,1:08:41.13,Default,,0,0,0,,!إسمعني الآن
Dialogue: 0,1:08:41.13,1:08:44.26,Default,,0,0,0,,.إتّصلتَ بالبروفيسور فجأةً و قلتَ أنّه بعد تفكير، ستذهب إلى هوكايدو، ثمّ أغلَقتَ الخطّ
Dialogue: 0,1:08:44.26,1:08:45.91,Default,,0,0,0,,!إذاً ماذا تفعل الآن؟
Dialogue: 0,1:08:45.91,1:08:48.33,Default,,0,0,0,,.أعتذر، هايبارا\N...كان لَديّ بعض الأُمور التي احتجتُ للتّعامل معها هُنا أيضاً
Dialogue: 0,1:08:48.33,1:08:50.58,Default,,0,0,0,,!إهدأوا قليلاً، أيّها الرّفاق
Dialogue: 0,1:08:50.58,1:08:51.75,Default,,0,0,0,,...حسناً
Dialogue: 0,1:08:51.75,1:08:52.87,Default,,0,0,0,,.بجِدّ
Dialogue: 0,1:08:52.87,1:08:55.96,Default,,0,0,0,,أنتَ على الأرجح مُنشغلٌ فقط بقضيّةٍ في مكانٍ ما، صحيح؟
Dialogue: 0,1:08:55.96,1:08:57.44,Default,,0,0,0,,.بالوَاقع، الأمر هكذا بالضّبط
Dialogue: 0,1:08:57.44,1:08:58.07,Default,,0,0,0,,!ماذا؟
Dialogue: 0,1:08:58.07,1:09:01.63,Default,,0,0,0,,.أرسلتُ لكِ ملفّ بياناتٍ يحوي صورةً التقطَها كيد
Dialogue: 0,1:09:01.63,1:09:04.32,Default,,0,0,0,,!كيد؟\N...قلتَ "كيد" للتّوّ
Dialogue: 0,1:09:04.32,1:09:06.83,Default,,0,0,0,,!مُستحيل\N!هل ظهرَ كايتو كيد؟
Dialogue: 0,1:09:06.83,1:09:08.60,Default,,0,0,0,,تتكلّمين مع كونان كن، صحيح؟
Dialogue: 0,1:09:08.60,1:09:11.37,Default,,0,0,0,,هل قال كونان كن بأنّه في هوكايدو الآن؟
Dialogue: 0,1:09:11.37,1:09:13.75,Default,,0,0,0,,ما الذي قد يرغب كيد بسرِقته هناك؟
Dialogue: 0,1:09:13.75,1:09:15.44,Default,,0,0,0,,مَنحوتةٌ خشبيّةٌ لدُبٍّ أو ما شابه؟
Dialogue: 0,1:09:15.44,1:09:16.98,Default,,0,0,0,,رُبّما بعض رامين سابورو؟
Dialogue: 0,1:09:16.98,1:09:18.98,Default,,0,0,0,,.لَم يكُن ليسرِق شيئاً كهذا
Dialogue: 0,1:09:18.98,1:09:20.26,Default,,0,0,0,,!آي تشان
Dialogue: 0,1:09:20.26,1:09:21.82,Default,,0,0,0,,!أرجوكِ دعيني أُكلّمه
Dialogue: 0,1:09:21.82,1:09:22.63,Default,,0,0,0,,.أنا أيضاً
Dialogue: 0,1:09:24.70,1:09:27.20,Default,,0,0,0,,.أعتذر\N...الأطفال هُنا الآن للّعب
Dialogue: 0,1:09:27.20,1:09:28.45,Default,,0,0,0,,.أوه، حسناً
Dialogue: 0,1:09:28.45,1:09:30.54,Default,,0,0,0,,...سأُخبركِ بكلّ التّفاصيل بعد عودتي
Dialogue: 0,1:09:30.54,1:09:34.21,Default,,0,0,0,,.لكن للآن، أرغب بأن تبحثي عن هويّة الرّجل في تلك الصّورة
Dialogue: 0,1:09:34.21,1:09:36.17,Default,,0,0,0,,.بالتّأكيد، بالتّأكيد. فهمت
Dialogue: 0,1:09:36.17,1:09:38.69,Default,,0,0,0,,إذاً، هل أنتَ بخيرٍ حقّاً؟
Dialogue: 0,1:09:38.69,1:09:40.96,Default,,0,0,0,,.نعم، نوعاً ما
Dialogue: 0,1:09:40.96,1:09:43.34,Default,,0,0,0,,...وَاثقةٌ من أنّه لا فائدة من إخباركَ بهذا
Dialogue: 0,1:09:43.34,1:09:44.70,Default,,0,0,0,,.لكن لا تفعل أيّ شيءٍ مُستهتر
Dialogue: 0,1:09:44.70,1:09:46.05,Default,,0,0,0,,.شُكراً لكِ
Dialogue: 0,1:09:46.96,1:09:48.64,Default,,0,0,0,,.سيكون الأمر بخيرٍ الآن
Dialogue: 0,1:09:48.64,1:09:51.20,Default,,0,0,0,,إذاً، أيّها المُتحرّي العظيم، ماذا ستفعل الآن؟
Dialogue: 0,1:09:51.20,1:09:53.33,Default,,0,0,0,,.سأذهب لأُراقب مَجرى الأُمور
Dialogue: 0,1:09:53.33,1:09:57.06,Default,,0,0,0,,.سأرى أيّ تحرّكٍ سيقوم به ليون بعد حصوله على قبضة الياقوتة الزّرقاء
Dialogue: 0,1:09:57.06,1:09:58.71,Default,,0,0,0,,.لكن قبل ذلك سأرى العمّ
Dialogue: 0,1:09:59.36,1:10:01.40,Default,,0,0,0,,...ماذا\N!هاي، إنتظر
Dialogue: 0,1:10:06.28,1:10:09.37,Default - E,,0,0,0,,...الفائز بكأس زونهان هو
Dialogue: 0,1:10:04.97,1:10:06.97,Title,,0,0,0,,{\fs60}تان لي                                                                                                    هيزري جمال الدّين
Dialogue: 0,1:10:05.34,1:10:06.97,Title,,0,0,0,,{\fs60\c&H74DEE0&}خاسر                                                                                                        فائز
Dialogue: 0,1:10:09.97,1:10:13.35,Default - E,,0,0,0,,!!!جمال الدّين
Dialogue: 0,1:10:19.15,1:10:22.23,Default - E,,0,0,0,,إذاً، ما رأيكَ بخُطّة المدينة خاصّتي؟
Dialogue: 0,1:10:25.28,1:10:27.87,Default - E,,0,0,0,,.لا يُمكننا القُبول باقتراحك
Dialogue: 0,1:10:28.12,1:10:28.74,Default - E,,0,0,0,,لماذا؟
Dialogue: 0,1:10:28.87,1:10:31.41,Default - E,,0,0,0,,.لَن تخسرَ شيئاً بهذه الخُطّة
Dialogue: 0,1:10:31.41,1:10:33.58,Default - E,,0,0,0,,.ستُفيد الدّولة أيضاً
Dialogue: 0,1:10:34.08,1:10:35.62,Default - E,,0,0,0,,.إنّها مُتسرّعةٌ جدّاً
Dialogue: 0,1:10:35.62,1:10:38.13,Default - E,,0,0,0,,...إن أجرينا كلّ هذه التّطويرات
Dialogue: 0,1:10:38.13,1:10:40.46,Default - E,,0,0,0,,.قد يُجبَر البعض على إخلاء منازلهم
Dialogue: 0,1:10:40.63,1:10:42.63,Default - E,,0,0,0,,!يُمكننا أن نمنحهم مكاناً آخر
Dialogue: 0,1:10:42.63,1:10:44.47,Default - E,,0,0,0,,!خُطّتي مِثاليّة
Dialogue: 0,1:10:45.59,1:10:47.43,Default - E,,0,0,0,,.أنتَ صغيرٌ جدّاً
Dialogue: 0,1:10:47.43,1:10:49.76,Default - E,,0,0,0,,.تعلّم أكثر و عُد
Dialogue: 0,1:10:56.73,1:10:58.15,Default - E,,0,0,0,,...أيّها المُغفّل المُسنّ
Dialogue: 0,1:10:58.77,1:11:01.52,Default - E,,0,0,0,,.إنتهى عصركَ الآن
Dialogue: 0,1:11:02.23,1:11:04.90,Default - E,,0,0,0,,.سأبني مدينةً جديدة
Dialogue: 0,1:11:18.50,1:11:19.63,Default - E,,0,0,0,,!إرفع يَديك
Dialogue: 0,1:11:20.63,1:11:21.84,Default - E,,0,0,0,,...حـ-حسناً، حسناً
Dialogue: 0,1:11:25.51,1:11:28.01,Default,,0,0,0,,.أنا و أنتَ مُرتبطان بالقدَر
Dialogue: 0,1:11:28.01,1:11:32.51,Default,,0,0,0,,.عندما تنجح الخُطّة، سنكون شريكان
Dialogue: 0,1:11:32.51,1:11:34.29,Default,,0,0,0,,.أعتمد عليك
Dialogue: 0,1:11:34.29,1:11:36.56,Default,,0,0,0,,.أنا مدينٌ جدّاً لك
Dialogue: 0,1:11:36.56,1:11:41.02,Default,,0,0,0,,...أُشتُبهتُ بالسّرِقة، و بدا بأنّ الشّرطة كانت ستحتجِزني
Dialogue: 0,1:11:41.02,1:11:43.80,Default,,0,0,0,,.لكن إنقاذكَ لي بدأ كلّ هذا
Dialogue: 0,1:11:43.80,1:11:46.78,Default,,0,0,0,,.و أنقذتَني في كثيرٍ من الأحيان منذ وَقتها
Dialogue: 0,1:11:46.78,1:11:50.76,Default,,0,0,0,,...هذا لأنّني عرفتُ بأنّكَ ناكاتومي ريجيرو شخصيّاً
Dialogue: 0,1:11:50.76,1:11:55.04,Default,,0,0,0,,.إبن ناكاتومي جوزو، الذي دُعيَ بملِك قِطاع الشّحن اليابانيّ
Dialogue: 0,1:11:55.04,1:11:57.66,Default,,0,0,0,,.لا تذكُر إسم أبي
Dialogue: 0,1:11:57.66,1:12:00.08,Default,,0,0,0,,...أوه\N.أعتذر
Dialogue: 0,1:12:00.08,1:12:03.94,Default,,0,0,0,,.على أيّة حال، سيتغيّر كلّ شيءٍ اللّيلة
Dialogue: 0,1:12:03.94,1:12:07.05,Default,,0,0,0,,ماذا لَو شاهدتّ لَحظة حصول ذلك عن قُرب؟
Dialogue: 0,1:12:09.51,1:12:11.05,Default,,0,0,0,,...تعال، لنذهب معاً
Dialogue: 0,1:12:11.05,1:12:16.56,Default,,0,0,0,,!لنتمكّن من أن نشهَد ما سيُذكَر في تاريخ سينغافورة
Dialogue: 0,1:12:19.66,1:12:20.56,Default,,0,0,0,,هاه؟
Dialogue: 0,1:12:20.56,1:12:21.85,Default,,0,0,0,,!أعتذر بشأن هذا، أيّها العمّ
Dialogue: 0,1:12:21.85,1:12:22.44,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:12:22.44,1:12:24.44,Default,,0,0,0,,!ما-ما هذا فجأةً؟
Dialogue: 0,1:12:26.30,1:12:27.69,Default,,0,0,0,,!كلّا، توَقّف! أيّها المُنحرِف
Dialogue: 0,1:12:27.69,1:12:29.44,Default,,0,0,0,,!أوه، هذه هي
Dialogue: 0,1:12:30.61,1:12:33.03,Title,,0,0,0,,{\fs60\b1}تومي
Dialogue: 0,1:12:30.65,1:12:33.03,Title,,0,0,0,,{\fs60\b1}ناكا
Dialogue: 0,1:12:31.72,1:12:33.03,Default,,0,0,0,,ناكاتومي؟
Dialogue: 0,1:12:33.03,1:12:35.78,Default,,0,0,0,,!ناكاتومي"، كما في شرِكة ناكاتومي للشّحن؟"
Dialogue: 0,1:12:35.78,1:12:37.29,Default,,0,0,0,,.على الأرجح
Dialogue: 0,1:12:37.29,1:12:39.87,Default,,0,0,0,,!سأستعير هذه، أيّها العمّ
Dialogue: 0,1:12:42.21,1:12:46.40,Default,,0,0,0,,هل دعاني ذلك الشّقيّ بـ"العمّ" للتّوّ؟
Dialogue: 0,1:12:48.04,1:12:50.28,Default,,0,0,0,,لِمَ غادرتَ اليابان فجأة؟
Dialogue: 0,1:12:50.28,1:12:52.49,Default,,0,0,0,,.للعُطلَة\N.العُطلَة
Dialogue: 0,1:12:52.49,1:12:55.14,Default,,0,0,0,,ذهبتَ إلى سينغافورة أيضاً قبل 5 أعوام، صحيح؟
Dialogue: 0,1:12:55.14,1:12:59.77,Title,,0,0,0,,{\fs60\b1}المُجتمع
Dialogue: 0,1:12:55.14,1:12:59.77,Title,,0,0,0,,{\fs60\b1}إتّهام المُدير العامّ ناكاتومي بالإشتباه برَشوَة السّياسيّين
Dialogue: 0,1:12:55.14,1:12:58.33,Default,,0,0,0,,.نعم، كنتُ هناك منذ وَقتها\N!ماذا عن ذلك؟
Dialogue: 0,1:12:57.85,1:12:59.77,Title,,0,0,0,,{\fs50\b1}المُدير العامّ لشرِكة ناكاتومي للشّحن\Nناكاتومي ريجيرو (39) عاماً
Dialogue: 0,1:12:58.33,1:12:59.77,Default,,0,0,0,,...بشأن المُدير العامّ ناكاتومي
Dialogue: 0,1:12:59.77,1:13:01.91,Default,,0,0,0,,.إذاً هو ذلك الرّجل الذي كان في ساحة ميرليون
Dialogue: 0,1:13:01.91,1:13:04.75,Default,,0,0,0,,.بالرّغم من أنّ رجل الكراتيه ضرَبه
Dialogue: 0,1:13:07.34,1:13:08.65,Default,,0,0,0,,أوه، هايبارا؟
Dialogue: 0,1:13:08.65,1:13:11.01,Default,,0,0,0,,هل عرفتِ هويّة ذلك الرّجل؟
Dialogue: 0,1:13:11.01,1:13:12.91,Default,,0,0,0,,...نعم\N.تمكّنتُ من ذلك بطريقةٍ ما
Dialogue: 0,1:13:12.91,1:13:16.91,Title,,0,0,0,,{\fs60\b1}قراصنة سينغافورة
Dialogue: 0,1:13:12.91,1:13:14.87,Default,,0,0,0,,.إسمه يوجين ليم
Dialogue: 0,1:13:14.87,1:13:16.91,Default,,0,0,0,,.و من المُفاجئ، هو قُرصان
Dialogue: 0,1:13:16.91,1:13:17.76,Default,,0,0,0,,!قُرصان؟
Dialogue: 0,1:13:17.76,1:13:21.23,Default,,0,0,0,,.تُوجد تقاريرٌ من شُهود عيانٍ مُؤخّراً بشأنه في سينغافورة
Dialogue: 0,1:13:21.23,1:13:23.92,Default,,0,0,0,,.كنتُ وَاثقاً من أنّه يُمكنكِ فِعلها، هايبارا\N.يُمكنني الإعتماد عليكِ حقّاً
Dialogue: 0,1:13:23.92,1:13:25.81,Default,,0,0,0,,...وَاقع إطرائكَ لي
Dialogue: 0,1:13:25.81,1:13:28.48,Default,,0,0,0,,لابدّ من أنّ هذا يعني بأنّه مازال لَديكَ ما تُريدني أن أبحث بشأنه؟
Dialogue: 0,1:13:28.48,1:13:29.90,Default,,0,0,0,,...نـ-نعم
Dialogue: 0,1:13:30.92,1:13:34.08,Default,,0,0,0,,هل سمعتِ بإسم ناكاتومي ريجيرو سابقاً؟
Dialogue: 0,1:13:34.08,1:13:35.34,Default,,0,0,0,,.من شرِكة ناكاتومي للشّحن
Dialogue: 0,1:13:35.34,1:13:36.43,Default,,0,0,0,,.نعم، أعرفه
Dialogue: 0,1:13:37.18,1:13:40.87,Default,,0,0,0,,.أرغب بمَعرفة وَضع السّفن التي تملِكها شرِكة ناكاتومي للشّحن
Dialogue: 0,1:13:40.87,1:13:43.69,Default,,0,0,0,,.فقط السّفن في المنطقة المُحيطة بسينغافورة ستكون كافية
Dialogue: 0,1:13:46.69,1:13:50.96,Default,,0,0,0,,.تُوجد سفينتا شحنٍ و حاملة نِفطٍ في مُحيط سينغافورة
Dialogue: 0,1:13:50.96,1:13:55.45,Default,,0,0,0,,.ما يُثير فُضولي هو أنّ حاملة النّفط تنحرِف عن مَسارها المُحدّد
Dialogue: 0,1:13:55.45,1:13:58.39,Default,,0,0,0,,!هذه هي\N!أرسلي لي بيانات حاملة النّفط تلك
Dialogue: 0,1:13:58.39,1:14:00.64,Default,,0,0,0,,.حسناً\N.سأتّصل بكَ ثانيةً
Dialogue: 0,1:14:00.64,1:14:01.45,Default,,0,0,0,,.نعم، رجاءً
Dialogue: 0,1:14:02.48,1:14:04.21,Default,,0,0,0,,ماذا بشأن حاملة النّفط؟
Dialogue: 0,1:14:04.21,1:14:07.58,Default,,0,0,0,,.إنّها الأحرُف التي تُهجّأ "هي"، التي تركَتها رايتشل
Dialogue: 0,1:14:07.58,1:14:10.84,Default,,0,0,0,,.كلِمة "هي" يُمكن أن تُشير إلى سفينة
Dialogue: 0,1:14:08.00,1:14:10.84,Title,,0,0,0,,{\fs60\b1}ناكا
Dialogue: 0,1:14:08.00,1:14:10.84,Title,,0,0,0,,{\fs60\b1}تومي
Dialogue: 0,1:14:16.78,1:14:19.35,Default,,0,0,0,,هل ما أخبرتَني به على الهاتف صحيح؟
Dialogue: 0,1:14:19.35,1:14:23.60,Default,,0,0,0,,كيف يُمكن أن يكون كلّ ما يحصل الآن جُزءٌ من مُخطّط ليون سينساي؟
Dialogue: 0,1:14:23.60,1:14:26.23,Default,,0,0,0,,.أُريدكَ أن تُفسّر الأمر لأتمكّن من الفهم أيضاً
Dialogue: 0,1:14:26.23,1:14:30.21,Default,,0,0,0,,.بدأ كلّ شيءٍ بالياقوتة الزّرقاء التي وَجدها زونهان تشين
Dialogue: 0,1:14:30.21,1:14:31.73,Default,,0,0,0,,".قبضة الياقوتة الزّرقاء"
Dialogue: 0,1:14:31.73,1:14:35.05,Default,,0,0,0,,...ضمّها إلى حِزام بُطولة الكراتيه
Dialogue: 0,1:14:35.05,1:14:37.24,Default,,0,0,0,,.و قرّر مَنحها للبطل
Dialogue: 0,1:14:37.24,1:14:42.37,Default,,0,0,0,,.أجبرَ ليون سان جمال الدّين سان على المُشاركة ليتمكّن من الحصول على الجّوهرة
Dialogue: 0,1:14:42.37,1:14:45.77,Default,,0,0,0,,.مع ذلك، حصلَت مُداخلةٌ غير مُتوَقّعة
Dialogue: 0,1:14:45.77,1:14:50.31,Default,,0,0,0,,.شاركَ في البُطولة كيوغوكو ماكوتو، رجلٌ لَم يخسر في 400 نِزال كراتيه
Dialogue: 0,1:14:50.31,1:14:54.38,Default,,0,0,0,,.و شيريلين تان سان، التي قُتِلَت لاحقاً، كانت من دعَته
Dialogue: 0,1:14:54.38,1:14:58.86,Default,,0,0,0,,.حتّى لَو كان ذلك هو الدّافع، يملك ليون سينساي حُجّة غياب
Dialogue: 0,1:14:58.86,1:15:02.95,Default,,0,0,0,,.كان يركب مِصعداً مُختلِفاً عندما طُعِنَت
Dialogue: 0,1:15:02.95,1:15:04.64,Default,,0,0,0,,.هذا ما حصل حقّاً
Dialogue: 0,1:15:04.64,1:15:06.91,Default,,0,0,0,,...بعد لِقاء ليون عند البِركة
Dialogue: 0,1:15:06.91,1:15:11.02,Default,,0,0,0,,.ركبَت المِصعد للعودة إلى غُرفتها
Dialogue: 0,1:15:11.02,1:15:16.28,Default,,0,0,0,,.لكن الغُرفة التي كانت تُقيم فيها في الطّابق الـ16 في البُرج الـ3
Dialogue: 0,1:15:16.28,1:15:18.26,Default,,0,0,0,,...بسبب هيكل الفُندق
Dialogue: 0,1:15:18.26,1:15:22.03,Default,,0,0,0,,.لَم يكُن بإمكانها العودة دون الإنتقال إلى مِصعدٍ مُختلِفٍ في الطّابق الـ34
Dialogue: 0,1:15:22.03,1:15:25.20,Default,,0,0,0,,...عندما كانت في طريق عودتها إلى غُرفتها
Dialogue: 0,1:15:25.20,1:15:27.96,Default,,0,0,0,,...أُخِذَت عُنوةً إلى غُرفةٍ مُختلِفة
Dialogue: 0,1:15:27.96,1:15:30.71,Default,,0,0,0,,.من قِبل السّكرتيرة رايتشل
Dialogue: 0,1:15:30.71,1:15:34.09,Default,,0,0,0,,...مُستحيل\N!كانت رايتشل شريكة؟
Dialogue: 0,1:15:34.09,1:15:39.97,Default,,0,0,0,,...الغُرفة التي حجزَها ليون يومها لمُجرّد دخول مَطعم منطقة البِركة الخاصّة بالنّزلاء
Dialogue: 0,1:15:39.97,1:15:41.47,Default,,0,0,0,,.كانت في الطّابق الـ34
Dialogue: 0,1:15:42.83,1:15:48.52,Default,,0,0,0,,...ذهبَ ليون إلى تلك الغُرفة، و هناك طعنَ و قتلَ شيريلين سان
Dialogue: 0,1:15:49.44,1:15:51.52,Default,,0,0,0,,.ثمّ وَضع جُثّتها في حقيبته
Dialogue: 0,1:15:51.52,1:15:55.28,Default,,0,0,0,,...ثمّ، ركب كِلا رايتشل و ليون مِصعدان مُنفصلان
Dialogue: 0,1:15:55.28,1:15:59.55,Default,,0,0,0,,.و لخِدعتهما، إستخدمَت على الأرجح السكّينة التي تُطوى المُستخدَمة في السّحر عادةً
Dialogue: 0,1:15:59.55,1:16:02.28,Default,,0,0,0,,.مع ذلك، كانت الدّماء دِماء شيريلين سان
Dialogue: 0,1:16:03.08,1:16:04.33,Default,,0,0,0,,.الطّابق الـ1
Dialogue: 0,1:16:07.04,1:16:09.79,Default,,0,0,0,,.مُتظاهرةً بأنّها طُعِنَت، إنهارَت رايتشل
Dialogue: 0,1:16:11.29,1:16:12.58,Default,,0,0,0,,...و بعدها مُباشرةً
Dialogue: 0,1:16:16.07,1:16:21.43,Default,,0,0,0,,.حصل كلّ هذا دون عِلم الأشخاص المُنشغلين بانقطاع الكهرباء الذي تسبّبت به الإنفجارات
Dialogue: 0,1:16:35.94,1:16:37.82,Default,,0,0,0,,...هـ-هذا مُستحيل
Dialogue: 0,1:16:37.82,1:16:41.72,Default,,0,0,0,,...عالِمةً بخُطّة ليون الحقيقيّة
Dialogue: 0,1:16:41.72,1:16:46.22,Default,,0,0,0,,.ذهبَت رايتشل إلى المُتحرّي موري بداعي الخوف، مُستعدّةً لأن تعترِف له بكلّ شيء
Dialogue: 0,1:16:46.22,1:16:48.33,Default,,0,0,0,,.و أدركَ ليون هذا
Dialogue: 0,1:16:48.33,1:16:52.46,Default,,0,0,0,,.رايتشل سان التي دخلَت الغُرفة الآمنة كانت كيد مُتنكّراً
Dialogue: 0,1:16:52.46,1:16:56.46,Default,,0,0,0,,.تمّ استخدام كيد في خُطّة ليون سان أيضاً
Dialogue: 0,1:16:56.46,1:16:59.94,Default,,0,0,0,,...كان قد تمّ قتل رايتشل سان الحقيقيّة مُسبقاً
Dialogue: 0,1:16:59.94,1:17:01.93,Default,,0,0,0,,.ثمّ حشرها داخل القاعدة
Dialogue: 0,1:17:02.82,1:17:05.43,Default,,0,0,0,,...مُتوَقّعاً قُدوم كيد مُتنكّراً بهيئة رايتشل سان
Dialogue: 0,1:17:05.43,1:17:09.68,Default,,0,0,0,,.فعل هذا لإعداد حُجّة غيابٍ لنفسه، إضافةً لجعل الجّريمة تبدو من ارتكاب كيد
Dialogue: 0,1:17:09.68,1:17:11.79,Default,,0,0,0,,لكن لِمَ قد يفعل مثل هذا الشّيء...؟
Dialogue: 0,1:17:11.79,1:17:15.23,Default,,0,0,0,,إذاً لَو كان أنت، ريشي سان، من تظنّه سيكون من الآمن أن تتنكّر بهيئته؟
Dialogue: 0,1:17:15.23,1:17:17.21,Default,,0,0,0,,...أوه، حسناً
Dialogue: 0,1:17:17.21,1:17:19.12,Default,,0,0,0,,...مهما تنكّرتُ ببراعة
Dialogue: 0,1:17:19.12,1:17:21.99,Default,,0,0,0,,.سيكون الأمر بلا فائدةٍ إن ظهر الشّخص الحقيقيّ فجأة
Dialogue: 0,1:17:21.99,1:17:25.49,Default,,0,0,0,,إذاً سيكون الأمر بخيرٍ لَو عرفتَ الوَقت و المكان الذي سيكون فيه الشّخص مُقدّماً، صحيح؟
Dialogue: 0,1:17:25.49,1:17:26.51,Default,,0,0,0,,!فهمت
Dialogue: 0,1:17:26.51,1:17:29.83,Default,,0,0,0,,...كانت رايتشل تنتظر موري سان في الـ3 بعد الظّهر
Dialogue: 0,1:17:29.83,1:17:30.79,Default,,0,0,0,,...و لهذا
Dialogue: 0,1:17:30.79,1:17:31.77,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,1:17:31.77,1:17:35.35,Default,,0,0,0,,...تنكّرَ كيد كشخصٍ لا يُرجّح قُدومه إلى الغُرفة الآمنة
Dialogue: 0,1:17:35.35,1:17:39.34,Default,,0,0,0,,.و بفِعل هذا، سقطَ في فخّ ليون سان
Dialogue: 0,1:17:40.92,1:17:42.30,Default,,0,0,0,,.أخبراني رجاءً
Dialogue: 0,1:17:42.30,1:17:44.82,Default,,0,0,0,,!ما الذي يُحاول سينساي فِعله؟
Dialogue: 0,1:17:44.82,1:17:47.55,Default,,0,0,0,,.كلّ هذا لأجل خُطّةٍ غبيّة
Dialogue: 0,1:17:47.55,1:17:52.23,Default,,0,0,0,,...كان ليون على اتّصالٍ بيوجين ليم، زعيم أُسطول قراصنة
Dialogue: 0,1:17:52.23,1:17:56.73,Default,,0,0,0,,...كلِمة "هي" التي تمّ تركها في القاعدة في مَسرَح جريمة قتل رايتشل
Dialogue: 0,1:17:56.73,1:18:00.30,Default,,0,0,0,,...و ثمّ هناك الغرَض الذي تركَته رايتشل بالسّرّ مع المُتحرّي موري
Dialogue: 0,1:18:00.30,1:18:02.07,Default,,0,0,0,,.إحدى تِذكارات شرِكة ناكاتومي للشّحن
Dialogue: 0,1:18:02.07,1:18:04.47,Default,,0,0,0,,.كلّ هذه الأشياء تُشير لسفينة
Dialogue: 0,1:18:04.47,1:18:06.22,Default,,0,0,0,,ما علاقة هذا بأيّ شيء...؟
Dialogue: 0,1:18:06.22,1:18:07.16,Default,,0,0,0,,.ريشي سان
Dialogue: 0,1:18:08.20,1:18:11.35,Default,,0,0,0,,.جعلتُ مُتحرٍّ أكبر عُمراً من طوكيو يُرسل لي هذا
Dialogue: 0,1:18:11.35,1:18:15.04,Default,,0,0,0,,.إنّه تحليلٌ للمَسارات التي تستخدِمها السّفن التي يملِكها ناكاتومي في هذه المنطقة
Dialogue: 0,1:18:15.73,1:18:19.36,Default,,0,0,0,,.ناقلة نِفطٍ تنحرف بشدّةٍ عن مَسارها المُحدّد
Dialogue: 0,1:18:19.36,1:18:22.92,Default,,0,0,0,,.إن استمرّت على هذا المَسار، ستصل إلى خليج مارينا
Dialogue: 0,1:18:21.88,1:18:22.92,Title,,0,0,0,,{\fs60\b1}خليج مارينا
Dialogue: 0,1:18:22.92,1:18:27.93,Default,,0,0,0,,!يُخطّط ليون سان لاستخدام القراصنة لجعل ناقلة النّفط تصطدِم بالمدينة
Dialogue: 0,1:18:32.43,1:18:36.62,Default,,0,0,0,,بالأساس، لِمَ قد يحتاج سينساي لفِعل هذا؟
Dialogue: 0,1:18:36.62,1:18:37.73,Default,,0,0,0,,!لأيّ سبب؟
Dialogue: 0,1:18:37.73,1:18:41.27,Default,,0,0,0,,...لا أعرف ما سيقوله ليون سان
Dialogue: 0,1:18:41.27,1:18:44.76,Default,,0,0,0,,...لكن هذا لتدمير هذه المدينة و ثمّ إعادة بنائها
Dialogue: 0,1:18:44.76,1:18:47.91,Default,,0,0,0,,.إذاً نعرف بالتّأكيد على الأقلّ بأنّ لهذا علاقةً بتحريك قدرٍ هائلٍ من المال
Dialogue: 0,1:18:47.91,1:18:51.31,Default,,0,0,0,,...سبب إصرار ليون على الحصول على قبضة الياقوتة الزّرقاء
Dialogue: 0,1:18:51.31,1:18:55.16,Default,,0,0,0,,.هو حاجته لها كضمانةٍ ليتلاعب بالقراصنة لفِعل ما يشاء
Dialogue: 0,1:18:55.16,1:18:56.73,Default,,0,0,0,,...لـ-لكن
Dialogue: 0,1:18:56.73,1:19:00.44,Default,,0,0,0,,.القراصنة مُتشتّتون في كلّ مكانٍ لتفادي أعيُن الشّرطة
Dialogue: 0,1:19:00.44,1:19:02.00,Default,,0,0,0,,كيف توَاصل معهم؟
Dialogue: 0,1:19:02.00,1:19:04.01,Default,,0,0,0,,.بالميرليون
Dialogue: 0,1:19:04.01,1:19:07.57,Default,,0,0,0,,ألَم تقع حادثةٌ حيث بدأ الميرليون بقذف مياهٍ حمراء؟
Dialogue: 0,1:19:07.57,1:19:11.37,Default,,0,0,0,,.تمّ بثّ هذا الخبر حول العالَم، لذا وَاثقٌ من أنّه استرعى انتباه القراصنة
Dialogue: 0,1:19:11.37,1:19:14.02,Default,,0,0,0,,.لابدّ من أنّ ذلك كان الإشارة لبِدء تنفيذ الخُطّة
Dialogue: 0,1:19:14.02,1:19:15.79,Default,,0,0,0,,...لكن حاليّاً، نحتاج لأن
Dialogue: 0,1:19:15.79,1:19:18.14,Default,,0,0,0,,.صحيح\N.إن لَم نُسرِع، سيتأخّر الوَقت كثيراً
Dialogue: 0,1:19:18.14,1:19:20.96,Default,,0,0,0,,...يُمكنكما قول هذا، لكن لا يُوجد ما يُمكنني فِعله وَحدي
Dialogue: 0,1:19:20.96,1:19:24.03,Default,,0,0,0,,.و نحتاج للمزيد من الأدلّة لتتحرّك الشّرطة
Dialogue: 0,1:19:24.03,1:19:25.38,Default,,0,0,0,,!إن فعلنا ذلك، لَن ننجح بالوَقت المُناسب
Dialogue: 0,1:19:25.38,1:19:26.82,Default,,0,0,0,,ألا سبيل آخر؟
Dialogue: 0,1:19:26.82,1:19:29.59,Default,,0,0,0,,.أعلَم\N.لنطلُب مَشورة السيّد زونهان تشين
Dialogue: 0,1:19:29.59,1:19:32.03,Default,,0,0,0,,.نُفوذه قويٌّ على الجّيش و الشّرطة
Dialogue: 0,1:19:32.03,1:19:34.33,Default,,0,0,0,,!وَاثقٌ من أنّه سيُساعدنا
Dialogue: 0,1:19:34.33,1:19:36.04,Default,,0,0,0,,.ريشي سان، هناك شيءٌ آخر فقط
Dialogue: 0,1:19:36.04,1:19:37.54,Default,,0,0,0,,ما هو؟
Dialogue: 0,1:19:37.54,1:19:40.81,Default,,0,0,0,,...إن اصطدمَت ناقلة النّفط بالمدينة كما خطّط
Dialogue: 0,1:19:40.81,1:19:43.30,Default,,0,0,0,,أين تظنّ بأنّ ليون سان سيكون وَقتها؟
Dialogue: 0,1:19:43.30,1:19:47.11,Default,,0,0,0,,...حسناً، لنرى\N...سينساي حذِرٌ جدّاً
Dialogue: 0,1:19:47.11,1:19:49.70,Default,,0,0,0,,.لذا سيُراقب الأمر من مكانٍ بعيدٍ على الأرجح
Dialogue: 0,1:19:49.70,1:19:53.08,Default,,0,0,0,,.هناك احتماليّة ألّا يكون في الدّولة حتّى
Dialogue: 0,1:19:53.08,1:19:55.06,Default,,0,0,0,,!حسناً، يجب أن أُسرِع
Dialogue: 0,1:19:55.58,1:19:58.06,Default,,0,0,0,,.حسناً، شُكراً
Dialogue: 0,1:20:05.82,1:20:08.42,Default,,0,0,0,,...أوه، هيّا الآن\Nأين يُمكن أن يكون أبي؟
Dialogue: 0,1:20:08.42,1:20:10.63,Default,,0,0,0,,.سيبدأ العرض
Dialogue: 0,1:20:10.63,1:20:13.83,Default,,0,0,0,,...و شينتشي مايزال بعيداً في مكانٍ ما
Dialogue: 0,1:20:15.83,1:20:19.83,Default,,0,0,0,,يا إلهي، كيف توَرّطتّ في هذه القضيّة؟
Dialogue: 0,1:20:19.83,1:20:25.44,Default,,0,0,0,,هل كان ليون حقّاً هو من ترك بطاقتي في مَسرَح جريمة قتل شيريلين سان؟
Dialogue: 0,1:20:25.44,1:20:26.37,Default,,0,0,0,,.كلّا
Dialogue: 0,1:20:26.96,1:20:29.95,Default,,0,0,0,,...إيجاد البطاقة التي علِقَت في المِصعد
Dialogue: 0,1:20:29.95,1:20:32.97,Default,,0,0,0,,.حصل بعد بِدء تفحّص مَسرَح الجّريمة بفترة
Dialogue: 0,1:20:32.97,1:20:34.33,Default,,0,0,0,,لِمَ تظنّ ذلك؟
Dialogue: 0,1:20:35.26,1:20:36.49,Default,,0,0,0,,...أوه
Dialogue: 0,1:20:36.49,1:20:39.48,Default,,0,0,0,,.هذا أحدث تحليلٍ لمَسار ناقلة النّفط
Dialogue: 0,1:20:39.48,1:20:40.54,Default,,0,0,0,,!هاه؟
Dialogue: 0,1:20:41.39,1:20:42.60,Default,,0,0,0,,!ما-ماذا؟
Dialogue: 0,1:20:40.85,1:20:42.60,Title,,0,0,0,,{\fs60\b1}خليج مارينا
Dialogue: 0,1:20:42.60,1:20:43.69,Default,,0,0,0,,!هذا سيّءٌ جدّاً
Dialogue: 0,1:20:43.69,1:20:45.36,Default,,0,0,0,,!بهذا المُعدّل، ستصطدِم ناقلة النّفط بالفُندق مُباشرةً
Dialogue: 0,1:21:06.92,1:21:09.63,Default,,0,0,0,,...ران\N!أرجوكِ أجيبي على الهاتف
Dialogue: 0,1:21:52.63,1:21:54.05,Default - E,,0,0,0,,!إنّها تتّجه إلى هُنا
Dialogue: 0,1:22:39.10,1:22:41.82,Default,,0,0,0,,!هاي، ران\Nهل تستمتعينَ بوَقتك؟
Dialogue: 0,1:22:41.82,1:22:43.70,Default,,0,0,0,,!أبي\N!أين أنتَ الآن؟
Dialogue: 0,1:22:43.70,1:22:44.35,Default,,0,0,0,,هاه؟
Dialogue: 0,1:22:44.35,1:22:48.35,Default,,0,0,0,,.لا أعرف ما الأمر، لكن يُمكنني رُؤية سفينةٍ ضخمةٍ جدّاً
Dialogue: 0,1:22:48.35,1:22:50.88,Default,,0,0,0,,...هاي\N...لَحظة، أبي
Dialogue: 0,1:22:50.88,1:22:52.61,Default,,0,0,0,,!هل يُمكن أنّكَ في سطح الفُندق؟
Dialogue: 0,1:22:52.61,1:22:54.61,Title,,0,0,0,,{=275}{\fs60\b1}موري ران
Dialogue: 0,1:22:52.61,1:22:54.61,Title,,0,0,0,,{=275}{\fs60\b1}إتّصالٌ جاري
Dialogue: 0,1:22:52.61,1:22:54.61,Default,,0,0,0,,!مرحباً؟ مرحباً؟
Dialogue: 0,1:22:59.87,1:23:01.03,Default - E,,0,0,0,,هل يُمكننا النّجاح؟
Dialogue: 0,1:23:01.33,1:23:02.33,Default - E,,0,0,0,,.أظنّ ذلك
Dialogue: 0,1:23:02.62,1:23:04.95,Default,,0,0,0,,!سونوكو سان! سونوكو سان
Dialogue: 0,1:23:05.62,1:23:06.64,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:23:06.64,1:23:08.35,Default,,0,0,0,,.يبدو بأنّ شيئاً قد حصل في الخارج
Dialogue: 0,1:23:08.35,1:23:10.36,Default,,0,0,0,,.فكّرتُ بأنّه قد يكون من الأفضل أن نُغادر الفُندق
Dialogue: 0,1:23:14.40,1:23:15.88,Default,,0,0,0,,نعم؟
Dialogue: 0,1:23:15.88,1:23:17.78,Default,,0,0,0,,.حسناً، فهمت
Dialogue: 0,1:23:17.78,1:23:19.32,Default,,0,0,0,,ممّن كان الإتّصال؟
Dialogue: 0,1:23:19.32,1:23:20.64,Default,,0,0,0,,.أحد الشّرطة
Dialogue: 0,1:23:20.64,1:23:24.06,Default,,0,0,0,,...قال بأنّني قد أُستهدَف ثانيةً إن خرجتُ بإهمال
Dialogue: 0,1:23:24.06,1:23:25.64,Default,,0,0,0,,.لذا يجدُر بي التّأهّب و الإنتظار في غُرفتي
Dialogue: 0,1:23:25.64,1:23:27.98,Default,,0,0,0,,.يبدو بأنّ أحدهم قادِمٌ لمُرافقتي
Dialogue: 0,1:23:30.06,1:23:31.75,Default,,0,0,0,,...لـ-لكن
Dialogue: 0,1:23:31.75,1:23:34.36,Default,,0,0,0,,.سيكون الأمر بخيرٍ لأنّني هُنا
Dialogue: 0,1:23:36.13,1:23:37.32,Default,,0,0,0,,.فهمت
Dialogue: 0,1:23:47.02,1:23:47.81,Default,,0,0,0,,...هذا سيّء
Dialogue: 0,1:23:47.81,1:23:49.96,Default,,0,0,0,,!لا يُمكننا الإقتراب من الفُندق بوُجود هذا الحشد الكبير
Dialogue: 0,1:23:49.96,1:23:52.50,Default,,0,0,0,,!إمّا أن ننجح أو نموت، لذا أفترض بأنّني سأحتاج لفِعل هذا
Dialogue: 0,1:23:56.94,1:23:58.68,Default - E,,0,0,0,,!هواه، هذا كيد
Dialogue: 0,1:23:59.22,1:24:01.68,Default - E,,0,0,0,,!هذا كيد! كيد هُنا
Dialogue: 0,1:24:06.04,1:24:08.02,Default,,0,0,0,,!بهذا، كأنّ المكان مَحجوزٌ لنا فقط
Dialogue: 0,1:24:08.02,1:24:08.81,Default,,0,0,0,,هـ-هاه؟
Dialogue: 0,1:24:08.81,1:24:10.33,Default,,0,0,0,,!ما-ما المُشكلة؟
Dialogue: 0,1:24:10.33,1:24:11.81,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:24:11.81,1:24:14.94,Default,,0,0,0,,!كـ-كوغورو النّائم
Dialogue: 0,1:24:23.87,1:24:26.20,Default - E,,0,0,0,,...لا أعرف حقّاً، ما أمره ببساطة
Dialogue: 0,1:24:28.96,1:24:30.83,Default,,0,0,0,,.هذا سيّء\N.الخطّ لا يعلَق
Dialogue: 0,1:24:36.40,1:24:37.59,Default,,0,0,0,,!هواه، تبّاً
Dialogue: 0,1:24:45.41,1:24:48.31,Default,,0,0,0,,...أوه، هيّا الآن\N!أين أنت، أبي؟
Dialogue: 0,1:24:58.48,1:24:59.32,Default - E,,0,0,0,,!أُنظُرا
Dialogue: 0,1:24:59.99,1:25:02.16,Default - E,,0,0,0,,!ستُولَد هذه المدينة ثانيةً
Dialogue: 0,1:25:02.45,1:25:03.87,Default - E,,0,0,0,,!بيَداي
Dialogue: 0,1:25:06.87,1:25:08.37,Default - E,,0,0,0,,لِمَ... أنت...؟
Dialogue: 0,1:25:18.28,1:25:19.46,Default,,0,0,0,,!إ-إنتظر
Dialogue: 0,1:25:21.92,1:25:22.97,Default,,0,0,0,,.لَقد تفاجأت
Dialogue: 0,1:25:22.97,1:25:26.37,Default,,0,0,0,,.لَم أتوَقّع أبداً أنّكَ ستتمكّن من الوُصول إلى هذا المَدى
Dialogue: 0,1:25:26.37,1:25:28.26,Default,,0,0,0,,.حتّى أنا لَم أتمكّن من قِراءة تفكيركَ لهذا المَدى
Dialogue: 0,1:25:30.45,1:25:31.73,Default,,0,0,0,,.ريشي
Dialogue: 0,1:25:31.73,1:25:34.71,Default,,0,0,0,,.لكن بما أنّ الأمر قد وَصل إلى هذا الآن، سأعترف بنزاهتك
Dialogue: 0,1:25:34.71,1:25:37.23,Default,,0,0,0,,.هذا صحيح\N.كلّ هذا خُطّتي
Dialogue: 0,1:25:37.23,1:25:39.42,Default,,0,0,0,,لِمَ لا نتكلّم بالأمر قليلاً؟
Dialogue: 0,1:25:39.42,1:25:41.74,Default,,0,0,0,,.لذا أبعد ذلك الشّيء الخطير
Dialogue: 0,1:25:42.51,1:25:45.99,Default,,0,0,0,,ألَستَ من يُخطئ الفهم، ليون سينساي؟
Dialogue: 0,1:25:47.95,1:25:49.12,Default - E,,0,0,0,,!لا تتحرّكوا
Dialogue: 0,1:25:51.37,1:25:52.54,Default - E,,0,0,0,,...لا أحد هُنا
Dialogue: 0,1:25:52.54,1:25:54.00,Default - E,,0,0,0,,.لنُوقِف السّفينة الآن
Dialogue: 0,1:26:14.14,1:26:16.38,Default,,0,0,0,,!توَقّفَت حاملة النّفط، كيد
Dialogue: 0,1:26:16.38,1:26:18.09,Default,,0,0,0,,!لنترُك الأمر للشّرطة
Dialogue: 0,1:26:18.09,1:26:18.73,Default,,0,0,0,,.نعم
Dialogue: 0,1:26:19.48,1:26:20.53,Default - E,,0,0,0,,!النّاقلة
Dialogue: 0,1:26:20.82,1:26:22.07,Default - E,,0,0,0,,ماذا حصل...؟
Dialogue: 0,1:26:22.74,1:26:24.38,Default,,0,0,0,,...سأفعل ما تشاء
Dialogue: 0,1:26:24.38,1:26:25.76,Default,,0,0,0,,!لا تُطلِق عليّ رجاءً فقط
Dialogue: 0,1:26:26.95,1:26:28.24,Default,,0,0,0,,!...أوه، ساعدوني
Dialogue: 0,1:26:28.24,1:26:31.26,Default,,0,0,0,,!أرجوكَ لا تقتُلني
Dialogue: 0,1:26:31.99,1:26:35.25,Default,,0,0,0,,...ريشي كن\N.لَم أتوَقّع أبداً بأنّكَ ستُطلِق في الوَاقع
Dialogue: 0,1:26:35.25,1:26:36.25,Default - E,,0,0,0,,!جمال الدّين
Dialogue: 0,1:26:37.63,1:26:38.38,Default - E,,0,0,0,,!إنتظر
Dialogue: 0,1:26:39.04,1:26:40.75,Default - E,,0,0,0,,!جمال الدّين، بماذا تُفكّر؟
Dialogue: 0,1:26:41.05,1:26:42.96,Default - E,,0,0,0,,...السّبب الوَحيد لعملي عندك
Dialogue: 0,1:26:42.96,1:26:44.97,Default - E,,0,0,0,,.هو لكي أُقاتِل كيوغوكو
Dialogue: 0,1:26:44.97,1:26:47.30,Default - E,,0,0,0,,.لَم يعُد لَديّ سببٌ كهذا
Dialogue: 0,1:26:47.55,1:26:48.26,Default - E,,0,0,0,,!ماذا؟
Dialogue: 0,1:26:48.26,1:26:49.39,Default,,0,0,0,,...ليون سينساي
Dialogue: 0,1:26:49.39,1:26:52.89,Default,,0,0,0,,أعتذر على وَقاحتي، لكن هل ضعفَت مهاراتكَ قليلاً؟
Dialogue: 0,1:26:52.89,1:26:55.89,Default,,0,0,0,,...لَستَ من كان يُحرّك العالَم
Dialogue: 0,1:26:58.88,1:27:00.15,Default,,0,0,0,,.بل أنا
Dialogue: 0,1:27:00.15,1:27:03.15,Default,,0,0,0,,...هل يُمكن أنّكَ من
Dialogue: 0,1:27:03.78,1:27:04.90,Default,,0,0,0,,...إ-إنتظر
Dialogue: 0,1:27:04.90,1:27:06.61,Default,,0,0,0,,...أرجوكَ انتظر
Dialogue: 0,1:27:06.61,1:27:08.32,Default,,0,0,0,,.سأُعطيكَ هذه
Dialogue: 0,1:27:08.32,1:27:12.03,Default,,0,0,0,,.تُوجد جوهرةٌ داخلها\Nألَيست هذه صفقةً عادلة، ريشي كن؟
Dialogue: 0,1:27:25.11,1:27:26.80,Default,,0,0,0,,!كايتو كيد
Dialogue: 0,1:27:26.80,1:27:30.22,Default,,0,0,0,,!ما-ماذا يفعل آرثر كن هُنا؟
Dialogue: 0,1:27:30.72,1:27:31.64,Default,,0,0,0,,...لنرى
Dialogue: 0,1:27:31.64,1:27:34.47,Default,,0,0,0,,.للوُصول إلى السّطح، أظنّني بحاجةٍ للإنتقال عند الطّابق الـ34
Dialogue: 0,1:27:34.35,1:27:35.93,Up,,0,0,0,,.الطّابق الـ34
Dialogue: 0,1:27:36.10,1:27:36.89,Default - E,,0,0,0,,!هاي
Dialogue: 0,1:27:37.35,1:27:38.23,Default - E,,0,0,0,,.إنتظروا
Dialogue: 0,1:27:49.91,1:27:50.66,Default - E,,0,0,0,,...هل هُم
Dialogue: 0,1:27:50.66,1:27:53.08,Default - E,,0,0,0,,!مُتّجهون إلى رمال خليج مارينا؟
Dialogue: 0,1:27:57.08,1:27:58.31,Default,,0,0,0,,!ماذا تفعلان؟
Dialogue: 0,1:27:58.31,1:28:01.86,Default,,0,0,0,,!كنتُ أحاول القبض على أولئكَ الـ2 اللّذان كانا العقل المُدبّر خلف هذا
Dialogue: 0,1:28:01.86,1:28:04.59,Default,,0,0,0,,.أوقِف تمثيلكَ السيّء، ريشي راماناثان
Dialogue: 0,1:28:04.59,1:28:08.09,Default,,0,0,0,,.أعرف تماماً بأنّكَ العقل المُدبّر
Dialogue: 0,1:28:08.09,1:28:10.11,Default,,0,0,0,,...أوّل ما دفعني للشّكّ بأمرك
Dialogue: 0,1:28:10.11,1:28:13.07,Default,,0,0,0,,.كان إشعار كيد المُسبق الذي تُرِكَ في مَسرَح الجّريمة
Dialogue: 0,1:28:13.07,1:28:15.54,Default,,0,0,0,,...لَم تُلاحظ الشّرطة الإشعار المُسبق
Dialogue: 0,1:28:15.54,1:28:19.35,Default,,0,0,0,,إلّا بعد وُصولكَ إلى مَسرَح الجّريمة مُباشرةً، صحيح، ريشي؟
Dialogue: 0,1:28:19.35,1:28:22.79,Default,,0,0,0,,...و مُسبقاً، عندما سألتكَ عن أين يُمكن أن يكون ليون سان
Dialogue: 0,1:28:22.79,1:28:25.11,Default,,0,0,0,,.تأكّدَت شُكوكي نحوَك
Dialogue: 0,1:28:25.11,1:28:26.36,Default,,0,0,0,,!ماذا؟
Dialogue: 0,1:28:26.36,1:28:29.38,Default,,0,0,0,,...شخصٌ بغُرور و أنانيّة ليون سان
Dialogue: 0,1:28:29.38,1:28:32.87,Default,,0,0,0,,.لَن يُغادر الدّولة أبداً بينما نجاحه يكاد أن يكون بين مُتناوله
Dialogue: 0,1:28:32.87,1:28:37.70,Default,,0,0,0,,.وَاثقٌ من أنّه سيكون في مكانٍ حيث أفضل مَشهد، يُراقب كلّ ما يحصل
Dialogue: 0,1:28:37.70,1:28:40.25,Default,,0,0,0,,!و لا يُمكن ألّا تكون مُدركاً لذلك
Dialogue: 0,1:28:41.39,1:28:42.54,Default,,0,0,0,,.حسناً، هذا مُفاجئ
Dialogue: 0,1:28:42.54,1:28:44.52,Default,,0,0,0,,إذاً كنتَ تختبرني بهذا فقط، هاه؟
Dialogue: 0,1:28:44.52,1:28:46.25,Default,,0,0,0,,...بدأ كلّ ذلك قبل 5 أعوام
Dialogue: 0,1:28:46.25,1:28:49.76,Default,,0,0,0,,و كانت حادثة وَالِدكَ هي بداية خُطّتك، صحيح؟
Dialogue: 0,1:28:49.76,1:28:54.26,Default,,0,0,0,,".إعترف المُشتبه بقتل أخصّائي عِلم مُحيطاتٍ بعد إنكاره بالبداية"
Dialogue: 0,1:28:54.26,1:28:55.81,Default,,0,0,0,,...إن لَم أكُن مُخطئاً
Dialogue: 0,1:28:57.45,1:29:01.46,Default,,0,0,0,,ناكاتومي سان أتى أوّل مرّةٍ إلى سينغافورة قبل 5 أعوامٍ أيضاً، صحيح؟
Dialogue: 0,1:29:01.46,1:29:03.27,Default,,0,0,0,,...كـ-كلّا، أنا
Dialogue: 0,1:29:03.27,1:29:05.73,Default,,0,0,0,,...قبض ليون سان على القاتِل
Dialogue: 0,1:29:05.73,1:29:08.78,Default,,0,0,0,,.بينما عملَت شيريلين سان كمُحاميته و جعلَته يعترف بأنّه مُذنب
Dialogue: 0,1:29:08.78,1:29:11.28,Default,,0,0,0,,.لا يُمكنني التّفكير بأنّها مُجرّد مُصادفة
Dialogue: 0,1:29:11.28,1:29:13.05,Default,,0,0,0,,ماذا تعني؟
Dialogue: 0,1:29:13.05,1:29:17.54,Default,,0,0,0,,.كان فخّاً أُعِدّ للحصول على ناقلة النّفط التي تملكها شرِكة ناكاتومي للشّحن
Dialogue: 0,1:29:17.54,1:29:20.04,Default,,0,0,0,,.كان كلّ شيءٍ مُخطّطاً
Dialogue: 0,1:29:20.04,1:29:24.31,Default,,0,0,0,,...و ثمّ كان هناك فخٌّ آخر
Dialogue: 0,1:29:24.31,1:29:27.40,Default,,0,0,0,,الحقيقة التي أدركتَها، صحيح؟
Dialogue: 0,1:29:27.40,1:29:31.09,Default,,0,0,0,,...ظننتُها كانت حادثةً في البداية أيضاً، لكن
Dialogue: 0,1:29:31.09,1:29:34.05,Default,,0,0,0,,...بينما كنتُ أُنظّم مُمتلكات أبي الشّخصيّة، أدركت
Dialogue: 0,1:29:34.05,1:29:38.56,Default,,0,0,0,,...بأنّ أبي كان يُحقّق بأمر حُطامٍ تحت الماء اكتشفه بالصّدفة
Dialogue: 0,1:29:38.56,1:29:43.35,Default,,0,0,0,,.سفينةٌ غارقةٌ حيث على الأرجح تُوجد قبضة الياقوتة الزّرقاء، رمز ملِك جميع القراصنة
Dialogue: 0,1:29:43.35,1:29:46.71,Default,,0,0,0,,!لهذا بدأتَ بقتل أبي
Dialogue: 0,1:29:46.71,1:29:50.44,Default,,0,0,0,,!لمنعه من استرداد الجّوهرة أوّلاً
Dialogue: 0,1:29:50.82,1:29:51.82,Default - E,,0,0,0,,!ساعدوني
Dialogue: 0,1:29:51.82,1:29:53.45,Default - E,,0,0,0,,!دفعني أحدٌ من الخلف
Dialogue: 0,1:29:55.78,1:29:57.12,Default - E,,0,0,0,,!المُساعدة قادِمة
Dialogue: 0,1:29:57.12,1:29:57.91,Default - E,,0,0,0,,!بسرعة
Dialogue: 0,1:29:57.91,1:29:59.20,Default - E,,0,0,0,,!أنقِذوه
Dialogue: 0,1:29:59.20,1:30:01.22,Default,,0,0,0,,...بما أنّ حِسّ أبي بالعدالة كان قويّاً
Dialogue: 0,1:30:01.22,1:30:04.71,Default,,0,0,0,,.وَاثقٌ من توَقّعكَ بأنّه سيغوص لإنقاذه بالتّأكيد
Dialogue: 0,1:30:13.99,1:30:16.73,Default,,0,0,0,,!ما-ما مَعنى هذا، ليون؟
Dialogue: 0,1:30:16.73,1:30:17.66,Default,,0,0,0,,...أنت
Dialogue: 0,1:30:17.66,1:30:18.93,Default,,0,0,0,,!أفلِتني
Dialogue: 0,1:30:21.24,1:30:25.00,Default,,0,0,0,,.ريشي كن، أسأتَ الفهم
Dialogue: 0,1:30:25.00,1:30:27.40,Default,,0,0,0,,...تمّ إرسال قاتِل وَالِدكَ إلى السّجن
Dialogue: 0,1:30:27.40,1:30:29.65,Default,,0,0,0,,...لشكّي بأنّكَ المُتسبّب بموت أبي
Dialogue: 0,1:30:29.65,1:30:33.21,Default,,0,0,0,,.أتيتُ إلى هذه الدّولة، و أصبحتُ تِلميذك، و أصبحتُ ضابطاً احتياطيّاً
Dialogue: 0,1:30:33.21,1:30:36.18,Default,,0,0,0,,.ثمّ بدأتُ التّحرّي بأمر الحادثة
Dialogue: 0,1:30:36.18,1:30:39.28,Default,,0,0,0,,.تعرّفتُ على شيريلين تان، التي كانت مَسؤولةً عن الدّفاع عنه
Dialogue: 0,1:30:39.28,1:30:43.08,Default,,0,0,0,,عندما تقرّبتُ منها لسؤالها إن كانت تملك أيّة معلوماتٍ عن قضيّةٍ\N...تخصّ ريجيرو  يُمكنها إقلاق ليون
Dialogue: 0,1:30:43.08,1:30:45.02,Default,,0,0,0,,.أخبرَتني عنها بشكلٍ مُوجز
Dialogue: 0,1:30:45.02,1:30:46.52,Default,,0,0,0,,.و ثمّ كانت رايتشل
Dialogue: 0,1:30:46.52,1:30:47.46,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,1:30:47.46,1:30:52.09,Default,,0,0,0,,!تسرّبَت كلّ معلوماتكَ إليّ عبرها
Dialogue: 0,1:30:53.15,1:30:56.61,Default,,0,0,0,,بتلك الحال، لِمَ وَضعتَ إشعاراً مُسبقاً من كيد؟
Dialogue: 0,1:30:56.61,1:30:59.01,Default,,0,0,0,,ماذا لَو أخبرتَنا؟
Dialogue: 0,1:30:59.01,1:31:03.87,Default,,0,0,0,,.هناك قبضة الياقوتة الزّرقاء، و قضيّة القتل التي لا علاقة له بها
Dialogue: 0,1:31:03.87,1:31:07.37,Default,,0,0,0,,.إن علّقتُ هذان الشّيئان أمامه، كنتُ وَاثقاً من أنّ اللّصّ الشّبح سيأتي
Dialogue: 0,1:31:07.37,1:31:10.27,Default,,0,0,0,,.و ثمّ سيُعيق خُطّتكَ لأجلي
Dialogue: 0,1:31:11.40,1:31:14.65,Default,,0,0,0,,...لَم يظهر مُتحرّي الثّانويّة ذاك كما خطّطتّ
Dialogue: 0,1:31:14.65,1:31:17.66,Default,,0,0,0,,.لكنّكَ لعبتَ دوركَ جيّداً
Dialogue: 0,1:31:17.66,1:31:23.37,Default,,0,0,0,,...ناكاتومي سان، يبدو بأنّ ليون سان أنقذكَ لَحظة أن اشتُبهَ بكَ بالسّرِقة
Dialogue: 0,1:31:23.37,1:31:25.93,Default,,0,0,0,,لكن هل هذه مُجرّد صُدفةٍ حقّاً؟
Dialogue: 0,1:31:25.93,1:31:31.00,Default,,0,0,0,,.فكّر بالأمر جيّداً\N...ماذا لَو كان كلّ ذلك مُجرّد جُزءٍ من
Dialogue: 0,1:31:32.90,1:31:34.15,Default,,0,0,0,,!أيّها الوَغد
Dialogue: 0,1:31:35.21,1:31:38.32,Default,,0,0,0,,.قمتَ ببحثكَ جيّداً، ريشي كن
Dialogue: 0,1:31:42.58,1:31:44.56,Default,,0,0,0,,هاه؟\Nأين أنا؟
Dialogue: 0,1:31:44.56,1:31:46.08,Default,,0,0,0,,...إن كنتُ أذكُر جيّداً
Dialogue: 0,1:31:46.08,1:31:47.46,Default,,0,0,0,,!أبي
Dialogue: 0,1:31:47.46,1:31:48.52,Default,,0,0,0,,هاه؟
Dialogue: 0,1:31:48.52,1:31:49.12,Default,,0,0,0,,!أوه
Dialogue: 0,1:31:51.04,1:31:52.27,Default,,0,0,0,,!أ-أوه
Dialogue: 0,1:31:52.27,1:31:53.38,Default,,0,0,0,,!ران؟
Dialogue: 0,1:31:53.38,1:31:54.61,Default,,0,0,0,,!ماذا؟
Dialogue: 0,1:31:59.41,1:32:00.26,Default,,0,0,0,,!ما-ماذا بحقّ الله...؟
Dialogue: 0,1:32:00.26,1:32:01.62,Default,,0,0,0,,...أبي
Dialogue: 0,1:32:04.45,1:32:04.99,Default,,0,0,0,,...را
Dialogue: 0,1:32:06.91,1:32:07.79,Default - E,,0,0,0,,!إنسحاب
Dialogue: 0,1:32:07.79,1:32:10.17,Default - E,,0,0,0,,!و لنُعِد تنظيم صُفوفنا! أبلِغ المِروحيّة أيضاً
Dialogue: 0,1:32:14.07,1:32:15.92,Default,,0,0,0,,من أنتُم؟
Dialogue: 0,1:32:17.17,1:32:18.42,Default,,0,0,0,,...الآن إذاً، ريشي كن
Dialogue: 0,1:32:18.42,1:32:21.64,Default,,0,0,0,,.لسوء حظّك، إنقلبَ الوَضع ضدّك
Dialogue: 0,1:32:21.64,1:32:24.35,Default - E,,0,0,0,,.يوجين، يبدو بأنّ الخُطّة قد فشلَت
Dialogue: 0,1:32:24.64,1:32:26.31,Default - E,,0,0,0,,.يُمكنكَ أخذ هذه الجّوهرة
Dialogue: 0,1:32:26.52,1:32:29.10,Default - E,,0,0,0,,.إعتني بأمر أيّ شخصٍ هُنا
Dialogue: 0,1:32:34.23,1:32:35.65,Default - E,,0,0,0,,!ماذا تفعل؟
Dialogue: 0,1:32:36.19,1:32:37.19,Default - E,,0,0,0,,!لا تتحرّك
Dialogue: 0,1:32:39.07,1:32:41.07,Default,,0,0,0,,!سـ-ساعدوني
Dialogue: 0,1:32:41.07,1:32:44.78,Default - E,,0,0,0,,.الآن بحصولي على الجّوهرة، لَم أعُد بحاجتك
Dialogue: 0,1:32:44.78,1:32:45.62,Default - E,,0,0,0,,ماذا؟
Dialogue: 0,1:32:46.33,1:32:49.50,Default - E,,0,0,0,,.لَيس لَديّ وَقتٌ لهُرائك
Dialogue: 0,1:32:49.50,1:32:52.25,Default - E,,0,0,0,,.مَعروفٌ عنّي بأنّني أُخالِف وُعودي
Dialogue: 0,1:32:52.25,1:32:55.54,Default - E,,0,0,0,,.الأمر فقط هو أنّه كان هناك عرضٌ مُربحٌ أكثر
Dialogue: 0,1:32:56.13,1:32:58.46,Default,,0,0,0,,...هل يُمكن أنّكم تسعون خلف
Dialogue: 0,1:32:59.69,1:33:02.00,Default,,0,0,0,,.أنتَ قويّ المُلاحظة بالفِعل، أيّها الطّفل
Dialogue: 0,1:33:02.00,1:33:03.05,Default,,0,0,0,,.هذا هو الأمر بالضّبط
Dialogue: 0,1:33:03.05,1:33:06.66,Default,,0,0,0,,.إبنة عائلة مَجموعة سوزوكي الماليّة في هذا الفُندق
Dialogue: 0,1:33:06.66,1:33:09.56,Default,,0,0,0,,.و إن اختطفناها، الفِدية التي يُمكننا الحصول عليها ستكون هائلة
Dialogue: 0,1:33:09.56,1:33:12.75,Default,,0,0,0,,ألَم تأخذ الآنسة الصّغيرة مأوىً بالفِعل؟
Dialogue: 0,1:33:12.75,1:33:14.56,Default,,0,0,0,,.يُفترض أنّها مازالَت في جناحها
Dialogue: 0,1:33:14.56,1:33:18.57,Default,,0,0,0,,.لأنّني أخبرتُها على الهاتف ألّا تُغادر غُرفتها على الإطلاق
Dialogue: 0,1:33:21.82,1:33:23.59,Default,,0,0,0,,...إ-إنتظر\N!ماكوتو سان؟
Dialogue: 0,1:33:23.59,1:33:24.57,Default,,0,0,0,,!أُعذريني على فِعل هذا
Dialogue: 0,1:33:24.57,1:33:25.60,Default,,0,0,0,,!ماذا...؟
Dialogue: 0,1:33:25.60,1:33:27.52,Default,,0,0,0,,.تمّ إيقاف جميع المَصاعد
Dialogue: 0,1:33:27.54,1:33:28.20,Default,,0,0,0,,!ماذا؟
Dialogue: 0,1:33:28.20,1:33:29.66,Default,,0,0,0,,.لنخرُج من هُنا
Dialogue: 0,1:33:32.67,1:33:34.04,Default - E,,0,0,0,,!هناك! هيّا
Dialogue: 0,1:33:34.79,1:33:36.84,Default - E,,0,0,0,,!لا تُطلِقوا! ستُصيبونها
Dialogue: 0,1:33:36.84,1:33:40.15,Default,,0,0,0,,...ما-ماكوتو سان\Nماذا يحصل هُنا؟
Dialogue: 0,1:33:46.60,1:33:47.60,Default,,0,0,0,,.أُنظُر
Dialogue: 0,1:33:47.60,1:33:51.23,Default,,0,0,0,,.سيسير كلّ شيءٍ كما تخيّلتُ في نهاية المَطاف
Dialogue: 0,1:33:51.23,1:33:53.60,Default,,0,0,0,,!ستُحرَق هذه المدينة بالكامل، و ستُولَد ثانيةً
Dialogue: 0,1:34:02.05,1:34:04.28,Default,,0,0,0,,!لكنّكَ لَن تكون حيّاً لترى ذلك
Dialogue: 0,1:34:09.41,1:34:11.66,Default - E,,0,0,0,,ماذا؟! سيُطلِقون علينا صواريخ؟
Dialogue: 0,1:34:25.86,1:34:26.22,Default,,0,0,0,,...هواه
Dialogue: 0,1:34:29.93,1:34:30.81,Default - E,,0,0,0,,!تبّاً لهما
Dialogue: 0,1:34:34.85,1:34:36.00,Default,,0,0,0,,!خُذ هذه
Dialogue: 0,1:34:37.77,1:34:39.06,Default - E,,0,0,0,,!أمسكوا بهما، الآن
Dialogue: 0,1:34:40.17,1:34:41.23,Default,,0,0,0,,!ماكوتو سان
Dialogue: 0,1:34:48.47,1:34:51.08,Default,,0,0,0,,!ماذا؟\N!لـ-لـ-لماذا أنت...؟
Dialogue: 0,1:34:51.29,1:34:52.12,Default - E,,0,0,0,,!خلفهما
Dialogue: 0,1:34:56.83,1:34:57.88,Default - E,,0,0,0,,!إفتح
Dialogue: 0,1:34:57.44,1:34:59.59,Up,,0,0,0,,!إنّهم هُنا! إنّهم هُنا! إنّهم هُنا! إنّهم هُنا
Dialogue: 0,1:34:57.88,1:34:59.00,Default - E,,0,0,0,,!أيّها الشّقيّان
Dialogue: 0,1:35:04.65,1:35:06.62,Default - E,,0,0,0,,ماذا يحصل هُنا؟
Dialogue: 0,1:35:06.63,1:35:07.59,Default - E,,0,0,0,,.لا أعلَم
Dialogue: 0,1:35:07.59,1:35:09.89,Default - E,,0,0,0,,.مُعظم القراصنة في الفُندق الآن
Dialogue: 0,1:35:09.89,1:35:11.93,Default - E,,0,0,0,,ماذا يحصل في الدّاخل بالضّبط؟
Dialogue: 0,1:35:11.93,1:35:14.60,Default - E,,0,0,0,,.المكان خطِرٌ هُنا أيضاً. عُد رجاءً
Dialogue: 0,1:35:44.21,1:35:45.70,Default,,0,0,0,,هل أنتَ بخير؟
Dialogue: 0,1:35:45.70,1:35:46.86,Default,,0,0,0,,...نـ-نعم
Dialogue: 0,1:35:46.86,1:35:49.80,Default,,0,0,0,,!إن استمرّ هذا، ستُدمّر المدينة حقّاً
Dialogue: 0,1:35:51.18,1:35:53.68,Default,,0,0,0,,!سُحقاً\Nألا سبيل مُلائمٌ لإيقاف هذا؟
Dialogue: 0,1:35:55.68,1:35:58.41,Default,,0,0,0,,!إن أمكننا استخدام هذه، سنتمكّن إخماد هذا
Dialogue: 0,1:35:58.41,1:35:59.69,Default,,0,0,0,,!كيد
Dialogue: 0,1:36:01.38,1:36:03.32,Default,,0,0,0,,...إنتظر\N!هل أنتَ جادّ؟
Dialogue: 0,1:36:03.32,1:36:04.07,Default,,0,0,0,,!بالتّأكيد
Dialogue: 0,1:36:07.92,1:36:09.24,Default - E,,0,0,0,,!إنّه ذلك الرّجل ثانيةً
Dialogue: 0,1:36:09.24,1:36:10.41,Default - E,,0,0,0,,!أطلِقوا عليه و أسقِطوه
Dialogue: 0,1:36:12.07,1:36:13.41,Default - E,,0,0,0,,!أيّها الزّعيم، لا يُمكننا إصابته
Dialogue: 0,1:36:13.41,1:36:15.08,Default - E,,0,0,0,,!طائرٌ صغيرٌ مُزعج
Dialogue: 0,1:36:17.68,1:36:21.58,Default,,0,0,0,,...هاي، يجب أن نفعل شيئاً بشأن مَجموعة القراصنة تلك قبل أن نتمكّن من تنفيذ خُطّتك
Dialogue: 0,1:36:21.58,1:36:23.86,Default,,0,0,0,,!و مُسدّس وَرق اللّعب خاصّتي يحوي طلقةً وَاحدةً أُخرى فقط
Dialogue: 0,1:36:23.86,1:36:25.48,Default,,0,0,0,,ألَم يبقى سبيلٌ وَاحد؟
Dialogue: 0,1:36:25.48,1:36:26.21,Default,,0,0,0,,هاه؟
Dialogue: 0,1:36:29.86,1:36:32.22,Default,,0,0,0,,!بطاقةٌ رابحةٌ ستقلِب الوَضع لصالحنا بطلقةٍ وَاحدة
Dialogue: 0,1:36:32.22,1:36:33.85,Default,,0,0,0,,!فهمت
Dialogue: 0,1:36:34.53,1:36:35.56,Default,,0,0,0,,!سأنزِل و أقترِب
Dialogue: 0,1:36:36.64,1:36:37.22,Default - E,,0,0,0,,!إنتظرا
Dialogue: 0,1:36:56.41,1:36:57.66,Default,,0,0,0,,!ماكوتو سان...؟
Dialogue: 0,1:37:00.75,1:37:01.46,Default - E,,0,0,0,,!أمسكوا بهما
Dialogue: 0,1:37:03.92,1:37:05.09,Default - E,,0,0,0,,!إبتعدوا
Dialogue: 0,1:37:07.09,1:37:08.63,Default - E,,0,0,0,,...هو
Dialogue: 0,1:37:10.92,1:37:12.01,Default - E,,0,0,0,,!لي...
Dialogue: 0,1:37:12.59,1:37:13.33,Default,,0,0,0,,...كيد
Dialogue: 0,1:37:13.33,1:37:13.93,Default,,0,0,0,,أوه؟
Dialogue: 0,1:37:13.93,1:37:15.68,Default,,0,0,0,,!خُذني إلى قوس السّفينة
Dialogue: 0,1:37:16.39,1:37:18.06,Default,,0,0,0,,!لَستَ بحاجةٍ لإخباري ثانيةً
Dialogue: 0,1:37:18.06,1:37:18.81,Default,,0,0,0,,!هواه
Dialogue: 0,1:37:22.67,1:37:24.44,Default,,0,0,0,,!ران، تراجعي
Dialogue: 0,1:37:25.90,1:37:27.69,Default,,0,0,0,,!ران
Dialogue: 0,1:37:31.47,1:37:33.86,Default,,0,0,0,,!إنطلِقي
Dialogue: 0,1:37:48.82,1:37:50.40,Default,,0,0,0,,!ماذا يحصل هُنا بحقّ الله؟
Dialogue: 0,1:37:50.40,1:37:52.53,Default,,0,0,0,,...سمعتُ صوت شينتشي
Dialogue: 0,1:37:52.53,1:37:54.36,Default,,0,0,0,,هل أنتِ بخير، أيّتها الآنسة؟
Dialogue: 0,1:37:54.36,1:37:56.57,Default,,0,0,0,,...آرثر كن\Nماذا تفعل هُنا؟
Dialogue: 0,1:37:56.57,1:37:59.68,Default,,0,0,0,,...أوه\N.قلقتُ بشأنكِ، أيّتها الآنسة
Dialogue: 0,1:37:59.68,1:38:01.66,Default,,0,0,0,,.شُكراً لك
Dialogue: 0,1:38:02.41,1:38:05.19,Default,,0,0,0,,!أوه، هيّا الآن\N!أين هو؟
Dialogue: 0,1:38:07.69,1:38:09.11,Default,,0,0,0,,.سعيدٌ لأنّكِ سالِمة
Dialogue: 0,1:38:10.53,1:38:11.38,Default - E,,0,0,0,,ماذا؟
Dialogue: 0,1:38:14.97,1:38:16.87,Default,,0,0,0,,!شُكراً لك
Dialogue: 0,1:38:21.16,1:38:22.00,Default,,0,0,0,,!ماكوتو سان
Dialogue: 0,1:38:22.79,1:38:24.71,Default - E,,0,0,0,,.أخذَ كيد الجّوهرة
Dialogue: 0,1:38:24.71,1:38:26.50,Default - E,,0,0,0,,هل يُمكنكَ الإطلاق عليه و إسقاطه؟
Dialogue: 0,1:38:26.71,1:38:27.96,Default - E,,0,0,0,,.حسناً، أيّها الزّعيم
Dialogue: 0,1:38:34.80,1:38:37.01,Default - E,,0,0,0,,...سُحقاً! لا تتحرّك
Dialogue: 0,1:38:37.30,1:38:38.35,Default - E,,0,0,0,,!خُذ هذه
Dialogue: 0,1:38:41.66,1:38:42.50,Default,,0,0,0,,هاه؟
Dialogue: 0,1:38:44.16,1:38:45.02,Default,,0,0,0,,هل أصاب الهدَف؟
Dialogue: 0,1:38:46.94,1:38:48.40,Default,,0,0,0,,!سيكون الأمر بخير، سونوكو سان
Dialogue: 0,1:38:52.94,1:38:53.86,Default - E,,0,0,0,,...أوه، لا
Dialogue: 0,1:38:54.24,1:38:54.82,Default - E,,0,0,0,,ماذا؟
Dialogue: 0,1:38:55.61,1:38:56.19,Default - E,,0,0,0,,!كيد
Dialogue: 0,1:38:56.32,1:38:57.03,Default - E,,0,0,0,,!...أنت
Dialogue: 0,1:38:57.39,1:38:58.41,Default,,0,0,0,,!مرحباً
Dialogue: 0,1:38:58.95,1:38:59.58,Default - E,,0,0,0,,!!إنتظر
Dialogue: 0,1:39:07.21,1:39:08.38,Default - E,,0,0,0,,!ساعدني، يا رجل
Dialogue: 0,1:39:09.17,1:39:10.50,Default - E,,0,0,0,,!!!أنا أسقط
Dialogue: 0,1:39:11.98,1:39:13.51,Default,,0,0,0,,!ماكوتو سان، أنتَ تنزِف
Dialogue: 0,1:39:13.51,1:39:16.65,Default,,0,0,0,,!سونوكو سان، أرجوكِ اعذريني على هذا
Dialogue: 0,1:39:16.65,1:39:19.09,Default,,0,0,0,,!هاه؟\Nإنتظر، ماذا تفعل؟
Dialogue: 0,1:39:19.09,1:39:21.85,Default,,0,0,0,,!نحن في الخارج في مثل هذا المكان... ماكوتو سان؟
Dialogue: 0,1:39:21.85,1:39:23.31,Default,,0,0,0,,!أُخبركَ ألّا تفعل
Dialogue: 0,1:39:23.31,1:39:24.35,Default,,0,0,0,,!ماذا؟! أوه
Dialogue: 0,1:39:27.04,1:39:28.74,Default,,0,0,0,,.إنّها عُقدة حملٍ على الظّهر
Dialogue: 0,1:39:28.74,1:39:34.23,Default,,0,0,0,,!سونوكو سان، تأكّدي من البقاء بقُربي هذه المرّة
Dialogue: 0,1:39:35.57,1:39:39.24,Default,,0,0,0,,...لَن أتمكّن من الهرَب منكَ هكذا، حتّى لَو أردتّ ذلك
Dialogue: 0,1:40:22.66,1:40:23.91,Default - E,,0,0,0,,!أين هو؟
Dialogue: 0,1:40:52.42,1:40:53.48,Default,,0,0,0,,!كيوغوكو سان
Dialogue: 0,1:40:53.48,1:40:55.48,Default,,0,0,0,,!تمسّك بشيءٍ ما
Dialogue: 0,1:41:38.65,1:41:39.90,Default - E,,0,0,0,,هل أنتَ بخير؟
Dialogue: 0,1:41:50.73,1:41:51.96,Default,,0,0,0,,.يُمكنكَ استعادتها
Dialogue: 0,1:41:51.96,1:41:52.91,Default,,0,0,0,,هاه؟
Dialogue: 0,1:41:54.12,1:41:55.17,Default,,0,0,0,,...هذه
Dialogue: 0,1:41:55.17,1:41:57.92,Default,,0,0,0,,.لَم تكُن الجّوهرة التي أبحث عنها
Dialogue: 0,1:42:06.57,1:42:10.31,Default,,0,0,0,,...سونوكو سان\N.أرجوكِ اجلِسي هُنا لبعض الوَقت
Dialogue: 0,1:42:10.31,1:42:12.43,Default,,0,0,0,,.أعتذر
Dialogue: 0,1:42:12.43,1:42:14.94,Default,,0,0,0,,...عُقدَتها مَشدودةٌ جدّاً
Dialogue: 0,1:42:19.67,1:42:21.49,Default,,0,0,0,,.أوه، لَقد تحرّرَت
Dialogue: 0,1:42:22.72,1:42:26.14,Default,,0,0,0,,!أوه، كلّا\N...كلّا، هذه... أمم
Dialogue: 0,1:42:26.14,1:42:28.60,Default,,0,0,0,,...هذا شيءٌ\N.مثل تعويذة حظّ
Dialogue: 0,1:42:28.60,1:42:31.08,Default,,0,0,0,,هل كنتَ تضع هذه دائماً؟
Dialogue: 0,1:42:31.08,1:42:32.93,Default,,0,0,0,,...نـ-نعم
Dialogue: 0,1:42:32.93,1:42:36.42,Default,,0,0,0,,.بالرّغم من أنّني لَم أتمكّن من إخبارك، ظنّاً منّي بأنّني سأفقِد فَخري كرَجل
Dialogue: 0,1:42:37.40,1:42:38.73,Default,,0,0,0,,...إذاً هذا هو الأمر
Dialogue: 0,1:42:38.73,1:42:40.84,Default,,0,0,0,,...فكّرتُ دائماً بأنّه كان مَحميّاً
Dialogue: 0,1:42:40.84,1:42:44.84,Default,,0,0,0,,.لكن يبدو بأنّني من كان يحمي ماكوتو سان
Dialogue: 0,1:42:52.10,1:42:53.73,Default,,0,0,0,,!إذاً هذا هو الأمر! إذاً هذا هو الأمر
Dialogue: 0,1:42:53.73,1:42:55.41,Default,,0,0,0,,!أرجوكِ أعيدي لي ضِمادتي
Dialogue: 0,1:42:55.41,1:42:56.48,Default,,0,0,0,,!مُستحيل
Dialogue: 0,1:42:56.48,1:42:57.10,Default,,0,0,0,,!أرجوكِ
Dialogue: 0,1:42:57.10,1:42:59.25,Default,,0,0,0,,!سأعزّها لبقيّة حياتي
Dialogue: 0,1:42:59.25,1:43:00.86,Default,,0,0,0,,هُما ثُنائيٌّ لَطيف، صحيح؟
Dialogue: 0,1:43:09.01,1:43:12.12,Default,,0,0,0,,من أنتَ بحقّ الله؟
Dialogue: 0,1:43:12.12,1:43:14.87,Default,,0,0,0,,لَستَ طِفلاً عاديّاً، صحيح؟
