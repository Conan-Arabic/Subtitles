10
-00:00:00,334 --> 00:00:04,656


11
00:02:41,586 --> 00:02:42,966
{\be1}(كابي سوكو)

12
00:02:43,706 --> 00:02:45,416
{\be1}......إن اردتِ ان تلومي أحداً, فلومي

13
00:02:45,736 --> 00:02:47,186
{\be1}موهبتكِ الفذّة

14
00:02:55,476 --> 00:02:58,836
{\be1}سأفعل كل هذا من أجل الليلة الصامتةَ

15
00:03:02,428 --> 00:03:17,476
" فيلم (المحقق كونان) الـ12 "
" مدونة موسيقية من الرعب "

16
00:03:22,696 --> 00:03:24,676
{\be1}..أنا متحرٍ في المرحلة الثانوية وأدعى [كودو شينتشي]

17
00:03:26,056 --> 00:03:29,516
{\be1}أثناء زيارتي لمدينة الملاهي رفقةَ صديقة الطفولة وزميلتي في الفصل [موري ران]

18
00:03:29,996 --> 00:03:33,686
{\be1}شاهدتُ رجلاً بثياب سوداء يقوم بصفقة تبادل مشبوهة

19
00:03:34,816 --> 00:03:36,816
{\be1}..إنشغلتُ بمراقبة العملية

20
00:03:37,146 --> 00:03:39,646
{\be1}.ولم انتبه إلى شريكهُ الذّي باغتني من الخلف

21
00:03:40,886 --> 00:03:43,266
{\be1}أجبرني على إبتلاع عقارٍ سام

22
00:03:43,596 --> 00:03:44,776
{\be1}..وعندما استعدتُ وعيي

23
00:03:45,566 --> 00:03:47,786
{\be1}وجدتُ ان جسمي قد تقلص

24
00:03:48,336 --> 00:03:50,656
{\be1}..إذا اكتشف أُلئك الأشخاص ان [كودو شينتشي] لا يزال حياً

25
00:03:50,976 --> 00:03:52,346
{\be1}فسيسعون لقتلي ثانيةً

26
00:03:52,356 --> 00:03:54,046
{\be1}وكل من حولي سيكون في خطر

27
00:03:54,846 --> 00:03:57,966
 وعملاً بنصيحة البروفيسور [أغاسا], قررت إخفاء هويتي الحقيقية

28
00:03:58,216 --> 00:04:00,326
{\be1} ..ولما سأ,ني [ران] عن إسمي , أصبحت

29
00:04:00,326 --> 00:04:01,726
{\be1}[إدوغاوا كونان]

30
00:04:02,236 --> 00:04:03,936
{\be1}.ولكي احصل على معلومات بخصوص أُولئك الاشخاص

31
00:04:03,936 --> 00:04:06,766
{\be1}إنتقلت للعيش في منزل والد [ران] الذي يعمل متحرياً خاصاً

32
00:04:08,806 --> 00:04:10,146
{\be1}إستعد يا [ميستوهيكو]

33
00:04:10,566 --> 00:04:11,986
{\be1}دع الامر لي

34
00:04:15,806 --> 00:04:17,066
{\be1}حسنٌ

35
00:04:18,476 --> 00:04:19,236
{\be1}[ميستوهيكو]

36
00:04:19,416 --> 00:04:20,486
{\be1}[كونان]

37
00:04:20,956 --> 00:04:21,456
{\be1}ماذا؟

38
00:04:22,106 --> 00:04:23,326
{\be1}إنّها لكِ يا [أيومي]

39
00:04:24,536 --> 00:04:25,386
{\be1}لي؟

40
00:04:30,536 --> 00:04:31,296
{\be1}دعوها لي

41
00:04:38,386 --> 00:04:39,686
{\be1}مرحى

42
00:04:42,866 --> 00:04:45,416
{\be1}..هؤلاء هم زملائي في المدرسة الآن

43
00:04:45,756 --> 00:04:47,906
{\be1}غينتا…  ايومي…  وميتسوهيكو

44
00:04:48,626 --> 00:04:50,536
{\be1}ويشكلون معاً فريق المتحرين الصغار

45
00:04:50,546 --> 00:04:52,586
{\be1}وقد أجبروني عليى الانضمام إليهم

46
00:04:53,646 --> 00:04:55,206
{\be1}.. بقي عضو أخير

47
00:04:55,686 --> 00:04:57,356
{\be1}اسمها [هايبرا آي]

48
00:04:57,766 --> 00:04:59,376
{\be1}اسمها الحقيقي [ميانو شيهو]

49
00:05:01,176 --> 00:05:06,296
{\be1}كان والداها عالِمين يعملان لحساب المنظمة السوداء, وتُوفيا وهي لا تزال طفلة صغيرة

50
00:05:06,516 --> 00:05:09,556
{\be1}عملتْ معهم هي الأخرى أيضاً, تحتَ الاسم الحركي [شيري]

51
00:05:09,976 --> 00:05:11,266
{\be1}وقامت بتطوير ذلكَ العقار

52
00:05:11,366 --> 00:05:13,946
{\be1}Apotoxin 4869.

53
00:05:19,686 --> 00:05:25,076
{\be1}لكن ... قامت المنظمة بقتل أختها الوحيدة [ميانو اكيمي] بعد التمردّ عليهم

54
00:05:26,576 --> 00:05:29,916
{\be1} ..فأرادت الانتحار بتناول ذلك العقار

55
00:05:29,916 --> 00:05:31,746
{\be1}فتقلصَ جسدها هي الأُخرى

56
00:05:34,896 --> 00:05:36,766
{\be1}هكذا التقت بنا

57
00:05:36,766 --> 00:05:39,386
{\be1}ونعيش الآن حياة طفلين في المرحلة الابتدائية

58
00:05:39,736 --> 00:05:42,006
{\be1}ننتظر لحظة كشف حقيقة أُلئك الأشخاص

59
00:05:43,016 --> 00:05:48,676
{\be1}على الرغم من ذلك, فهذا المتحري الصغير دائماً ما يخرج عن طور حياته الجديدة كطفل صغير

60
00:05:48,676 --> 00:05:50,396
{\be1}..وبإجتماع إستنتاجاته الخارقة

61
00:05:50,546 --> 00:05:56,286
{\be1}مع اختراعات البروفيسور [اغاسا] .. قام بحل العديد من القضايا

62
00:05:59,586 --> 00:06:01,956
{\be1}عليَّ ان اشكرهُ, فبسببه أصاب دوماً بالرعشة

63
00:06:02,606 --> 00:06:04,876
{\be1}حسنٌ, لقد حان وقت درس الموسيقى

64
00:06:04,886 --> 00:06:07,746
{\be1}وها هو قد سبب لي الرعشة الآن, ولكن لسبب آخر

65
00:06:14,906 --> 00:06:16,736
{\be1}انظر, إنهم مشاهدو المسلسل

66
00:06:20,266 --> 00:06:22,516
{\be1}رغم ان جسدي قد تقلص, إلا ان عقلي ما زال كما هو

67
00:06:22,876 --> 00:06:24,946
{\be1}المتحري العظيم لا يُهزم

68
00:06:25,296 --> 00:06:28,106
{\be1}هناك دائماً حقيقةٌ واحدة

69
00:06:30,586 --> 00:06:32,076
{\be1}[دوموتو كازومي]؟

70
00:06:32,076 --> 00:06:33,676
{\be1}هل سمعت عنه يا [شينتشي] ؟

71
00:06:33,676 --> 00:06:34,196
{\be1}أجل

72
00:06:34,926 --> 00:06:38,486
{\be1}أليس هو مؤسس أكاديمية الموسيقى التي وقع فيها الانفجار الأسبوع الماضي ؟

73
00:06:39,936 --> 00:06:40,966
{\be1}.. في الواقع

74
00:06:41,486 --> 00:06:43,756
{\be1}أنا أقف الآن أمام هذا المكان

75
00:06:44,146 --> 00:06:47,116
{\be1}السيد [دوموتو] كان عازفَ "بيانو" دائعَ الصيت

76
00:06:47,116 --> 00:06:49,626
{\be1}"ولكنه حوّل أهتمامه بالعزف فجأة إلى آلة " الأروغَن

77
00:06:50,206 --> 00:06:52,916
{\be1}..وبسبب هذا, لم يبنو قاعة حفلات جديدة وحسب

78
00:06:52,916 --> 00:06:56,696
بل انهم احضروا أيضا آلة أورغن انبوبية من احدى كنائس المانيا القديمة

79
00:06:57,976 --> 00:07:00,816
{\be1}أتقصدين تلك التي عزف عليها [باخ] بنفسه ؟

80
00:07:02,186 --> 00:07:06,596
{\be1}لقد حضينا بشرف حضور حفل افتتاح قاعة [دموتو]

81
00:07:06,776 --> 00:07:09,776
{\be1}وفق ذلك, سنتمكن من حضور البروفة أيضاً

82
00:07:09,776 --> 00:07:10,956
{\be1}والفضل كلّهُ يعود لــ[سونوكو]

83
00:07:11,606 --> 00:07:15,256
{\be1}لا عجب, فلقد اشرفت شركة [سوزوكي] للإنشاءات على بناء تلك القاعة

84
00:07:21,766 --> 00:07:23,346
{\be1}مفاتح بيانو ؟

85
00:07:24,276 --> 00:07:26,816
{\be1}هل طار كلّ هذه المسافة يا ترى ؟

86
00:07:27,356 --> 00:07:29,386
{\be1}بالمناسبة, ما رأيك أن تأتي معنا يا [شينتشي] ؟

87
00:07:29,666 --> 00:07:32,146
{\be1}"ستتمكن من سماع العزف المباشر على كمان "الستراديفاريوس

88
00:07:32,756 --> 00:07:37,896
{\be1}ألم تخبرني مرة أنك تود سماع عزف أحدهم عليه كونك تجيد العزف ايضاً على الكمان

89
00:07:42,796 --> 00:07:44,306
{\be1}ماذا يفعل هذا الرجل ؟

90
00:07:57,246 --> 00:07:59,626
{\be1}[شينتشي] .. هل تصغي لما أقولهُ ؟

91
00:07:59,906 --> 00:08:01,526
{\be1}.. المعذرة

92
00:08:01,536 --> 00:08:03,856
{\be1}لسوء الحظ لن أتمكن من الحضور, لأني مشغول بالتحقيق في إحدى القضايا

93
00:08:04,496 --> 00:08:06,256
{\be1}ألا يمكنك أن تأتي ولو لبعض الوقت ؟

94
00:08:06,556 --> 00:08:08,256
{\be1}سيؤدون "البروفة" بعد غد

95
00:08:08,256 --> 00:08:09,956
{\be1}أسف حقاً, ولكنني لا استطيع المجيء فعلاً

96
00:08:09,966 --> 00:08:12,016
{\be1}سيُقام الحفل الرسمي يوم الثلاثاء من الأسبوع القادم

97
00:08:12,016 --> 00:08:13,096
{\be1}صدقيني لا استطيع القدوم

98
00:08:13,446 --> 00:08:14,956
{\be1} ..كما قلت, أنا أعمل على قضية و

99
00:08:14,956 --> 00:08:17,676
{\be1}لكن ربما تنتهي منها قبلل ذلك اليوم

100
00:08:17,676 --> 00:08:19,686
{\be1}..لقد طلبت من [سونوكو] أن تحجز مقعداً لــ

101
00:08:19,686 --> 00:08:22,926
{\be1}ألم أقل لكِ بأنني لا استطيع ؟ لا تحشري انفكِ في شؤوني

102
00:08:22,926 --> 00:08:23,216
{\be1}تباً

103
00:08:24,896 --> 00:08:26,386
{\be1}أحشر أنفي ؟

104
00:08:27,256 --> 00:08:28,176
{\be1}..لا, أعني

105
00:08:28,616 --> 00:08:30,506
{\be1}.. حسنٌ, لقد فهمت ما ترمي إليهِ

106
00:08:30,826 --> 00:08:34,636
{\be1}تعني أنني لست سوى لاعبة كاراتية حمقاء, تحب التدخل في شؤون الآخرين

107
00:08:35,646 --> 00:08:36,846
{\be1}الأمر ليس هكذا

108
00:08:37,416 --> 00:08:38,406
مهما يكن

109
00:08:38,416 --> 00:08:43,036
{\be1}حتى وأن استمعت إلى عزف الموسيقى مباشر على كمان "الستراديفاريوس" فلا تحلم ان تُصبح يوماً مثل [هولمز] يا [شينتشي]

110
00:08:43,306 --> 00:08:44,196
{\be1}ماذا؟

111
00:08:44,576 --> 00:08:45,966
{\be1}.. لأنك يا [شينتشي]

112
00:08:46,396 --> 00:08:47,416
{\be1}لا تملك أذناً موسيقية

113
00:08:48,136 --> 00:08:49,876
{\be1}  ..[ران] ايتها الـ

114
00:08:50,126 --> 00:08:53,916
{\be1}أبذل قصارى جهدك إذن يا حضرة المتحري صاحب الأذن اللاموسيقية

115
00:08:54,826 --> 00:08:55,556
{\be1}يا إلهي

116
00:08:55,956 --> 00:08:57,156
{\be1}مهووس التحريات ذاك

117
00:08:57,156 --> 00:08:58,816
{\be1}لن أدعوَه ثانية أبداً

118
00:09:00,916 --> 00:09:01,696
{\be1}تباً

119
00:09:09,386 --> 00:09:10,196
{\be1}مرحباً

120
00:09:10,676 --> 00:09:11,436
{\be1}كونان ؟

121
00:09:11,756 --> 00:09:13,566
{\be1}ماذا تريد ان تتعشى اليوم ؟

122
00:09:14,386 --> 00:09:14,816
{\be1}حسنٌ

123
00:09:15,166 --> 00:09:17,356
{\be1}هل يعجبك " الكاري" ام أنك تفضل شيئاً آخر ؟

124
00:09:17,776 --> 00:09:19,816
{\be1}"إطلاقاً, لا بأس بـ "الكاري

125
00:09:20,116 --> 00:09:21,276
{\be1}حسنٌ إذن

126
00:09:21,886 --> 00:09:24,206
{\be1}أنا سعيدة لأنك تسمع كلامي دائماً يا [كونان]

127
00:09:25,796 --> 00:09:28,926
{\be1}حسنٌ, كن حذراً, وعُد إلى البيت قبل أن يحب الظلام, مفهوم ؟

128
00:09:29,276 --> 00:09:30,316
{\be1}حاضر

129
00:09:30,316 --> 00:09:30,936
{\be1}إلى اللقاء

130
00:09:36,036 --> 00:09:39,096
{\be1}إذن, فكوني [كونان] يعني أنني شخصٌ مطيع ؟

131
00:11:50,206 --> 00:11:52,966
{\be1}في غاية الروعة,  عزفٌ رائع ليس له نظير

132
00:11:53,356 --> 00:11:55,126
{\be1}أجدتَ فعلاً يا سيد [دوموتو]

133
00:11:55,126 --> 00:11:57,646
{\be1}"هذا العزف له وقع من نوع آخر, إذا ما قارَناه بعزف "البيانو

134
00:12:00,506 --> 00:12:05,326
{\be1}كان هذا عزفاً رائعاً بحق’ تماماً كما توقعنا من [دوموتو كازوكي]

135
00:12:05,896 --> 00:12:07,586
{\be1}رأيت ذلك الرجل على التلفاز من قبل

136
00:12:08,426 --> 00:12:10,336
{\be1}هناك, الرجل ذو النظارات

137
00:12:10,886 --> 00:12:13,256
{\be1}إنه السيد [فوا تاكومي]

138
00:12:14,026 --> 00:12:17,716
{\be1\an8}"عمل مع السيد [دوموتو] ,لمدة نازهت الخمسة وثلاثين عاماً, كضابطٍ لإيقاع "البيانو

139
00:12:18,476 --> 00:12:21,096
{\be1}ويعمل الآن مديراً لقاعة [دوموتو]

140
00:12:22,246 --> 00:12:23,426
{\be1}ذلك الشخص ؟

141
00:12:24,756 --> 00:12:27,506
{\be1}الذي استدار للتو, يدعى السيد [هانز مولر], وهو ألمانيّ الجنسية

142
00:12:27,996 --> 00:12:29,596
{\be1}وهو من يضبط إيقان " الاروغَن" الأنبوبي

143
00:12:30,436 --> 00:12:32,426
{\be1\an8}.. قد يبدو هذا غريباً, ولكن

144
00:12:32,426 --> 00:12:34,786
{\be1\an8}لقد حدثت بينه وبين السيد[دوموتو] العديدُ من المشاحنات

145
00:12:35,656 --> 00:12:39,366
{\be1\an8}..أما الذي يترجم في جانبه, فهو  ابن السيد [دوموتو]

146
00:12:39,366 --> 00:12:40,786
{\be1\an8}عازف البيانو  السيد [غينيا]

147
00:12:41,426 --> 00:12:43,376
{\be1\an8}وهو أيضاً منظم الحفل المرتقب

148
00:12:44,526 --> 00:12:47,126
{\be1}.. ما الآنستان اللتان تقفان هناك

149
00:12:48,226 --> 00:12:50,386
{\be1}فهما تلميذات السيد [دوموتو]

150
00:12:51,006 --> 00:12:54,336
{\be1\an8}الآنسة على اليمين, هي إحدى خرّيجات الدفعة التاسعة لأكاديمية [دوموتو]

151
00:12:54,336 --> 00:12:56,306
{\be1\an8}مغنية "السويرانو" , الآنسة [تشيغوسل رارا]

152
00:12:58,026 --> 00:13:01,896
{\be1\an8}والتي تقف إلى جانبها ويبدو على ملامحها القلق, هي  إحدى خريجات الدفعة الثامنة لهذه الأكاديمية

153
00:13:01,896 --> 00:13:04,026
{\be1\an8}عازفة الكمان, الآنسة [يماني شيون]

154
00:13:05,266 --> 00:13:09,736
{\be1}إذن .. هي من ستحل مكان الآنسة [كابي سوكو] التي أصيبت في الأنفجار, أليس كذلك ؟

155
00:13:10,136 --> 00:13:10,926
{\be1}أجل .. أجل

156
00:13:11,626 --> 00:13:16,116
{\be1}ولحسن الحظ, لم يلحق أي ضرر بمكان "الستراديفاريوس" لأنه كان بعيداً عن مكان الأنفجار من أجل ضبط أوتاره

157
00:13:16,606 --> 00:13:19,036
{\be1}وهو الآن في عهدة الآنسة [شيون] من أجل العرض القادم

158
00:13:19,686 --> 00:13:22,956
{\be1}.. أما الآنسة التي تجلس في الصف الأول

159
00:13:22,956 --> 00:13:23,996
{\be1}.. الآنسة [أكيبا ريكو]

160
00:13:24,326 --> 00:13:25,486
{\be1}"مغنية " السوبرانو

161
00:13:26,416 --> 00:13:27,956
{\be1}كنت أعلم إنكِ تعرفينها

162
00:13:28,246 --> 00:13:30,486
{\be1\an8}فهي اشهر من نار على علم

163
00:13:33,876 --> 00:13:35,606
{\be1}حسنٌ يا [شيون] ,استعدي

164
00:13:36,166 --> 00:13:36,896
{\be1}حاضر

165
00:13:36,896 --> 00:13:39,226
{\be1}سنبدأ بالمقطوعة الاولى
" Ave Maria"

166
00:13:39,226 --> 00:13:39,766
{\be1}حسنٌ

167
00:13:48,046 --> 00:13:51,706
{\be1}أداؤكِ يؤكد انكِ لا تزالين غير مؤهلة بعدُ لتقديم "البروفة" معي

168
00:13:52,326 --> 00:13:54,806
{\be1}المعذرة, مرة أُخرى لو سمحتِ

169
00:13:56,006 --> 00:13:57,086
{\be1}أعتذر بشدة

170
00:13:59,176 --> 00:14:02,986
{\be1}أخيراً سنستمع إلى عزف مباشر على كمان "الستراديفاريوس" يا آنسة [ساتو]

171
00:14:03,256 --> 00:14:06,346
{\be1}"لو كان الآمر بيدي لأخترتُ كمان "الأماتي

172
00:14:07,526 --> 00:14:08,416
{\be1}أصمتا

173
00:14:47,536 --> 00:14:48,776
{\be1}هذا لا ينفع, لا ينفع

174
00:14:49,676 --> 00:14:50,916
{\be1}هذا مرفوض كلياً

175
00:14:51,496 --> 00:14:53,156
{\be1}ماذا كنت تفعلين طوال الأسبوع الماضي ؟

176
00:14:54,326 --> 00:14:55,496
{\be1}أنا آسفة

177
00:14:57,036 --> 00:14:58,266
{\be1}هل كان هناك خطأ في عزفها ؟

178
00:14:58,606 --> 00:15:01,296
{\be1}كلا , بدا لي ممتازاً للغاية

179
00:15:01,906 --> 00:15:02,626
{\be1}كلا

180
00:15:02,906 --> 00:15:05,756
{\be1}"العزفُ لم يكن كما هو مطلوب من عازف " الستراديفاريوس

181
00:15:06,146 --> 00:15:07,606
{\be1}مرة أُخرى, من البداية

182
00:15:07,606 --> 00:15:08,376
{\be1}حاضر

183
00:15:33,646 --> 00:15:34,636
{\be1}ماذا ؟

184
00:15:34,636 --> 00:15:35,736
{\be1}ما الذي حدث؟

185
00:15:35,746 --> 00:15:37,626
{\be1}يبدو ان أحد اوتار الكمان قد انقطع

186
00:15:38,166 --> 00:15:39,306
{\be1}أنا آسفة

187
00:15:39,306 --> 00:15:40,486
{\be1}سأستبدلهُ حالاً

188
00:15:41,386 --> 00:15:44,176
"كيف وجدت توافق النغمات لهذا " الأورغَن

189
00:15:44,176 --> 00:15:46,586
{\be1}ليست هناك أيّة مشاكل

190
00:15:46,586 --> 00:15:47,506
{\be1}يا إلهي

191
00:15:48,416 --> 00:15:50,356
{\be1}أتساءل إن كنت سأحضى بفرصة للغناء هذا اليوم

192
00:15:52,666 --> 00:15:54,906
{\be1}آنسة [اكيبا], من فضلكِ

193
00:15:55,756 --> 00:15:57,526
{\be1}هل تسمح لي بالذهاب إلى دورة المياه أولا ؟

194
00:16:05,326 --> 00:16:06,116
{\be1}[موري]

195
00:16:06,966 --> 00:16:09,786
{\be1}هل توصلتم إلى أيّ أدلة بخصوص مفتعل الأنفجار ؟

196
00:16:10,176 --> 00:16:11,506
{\be1}كلا, ليس بعد

197
00:16:12,096 --> 00:16:15,126
{\be1}أُسُخدمت متفجراتُ بلاستيكية في العلملية, صحيح ؟

198
00:16:15,136 --> 00:16:15,736
{\be1}أجل

199
00:16:16,066 --> 00:16:17,566
{\be1}كما عثرنا على مؤقت

200
00:16:18,266 --> 00:16:20,846
{\be1}ولقد تمّ ضبطُه لينفجر في نفس الوقت الذي كان الثلاثة يتدربون فيه

201
00:16:21,956 --> 00:16:23,726
{\be1}إذن, فهذا يعني

202
00:16:24,316 --> 00:16:25,476
{\be1}.. عذراً يا [موري]

203
00:16:25,806 --> 00:16:29,906
{\be1}الوقت والمكان ليسا مناسبين ابداً لمناقشة مثل هذه الأمور

204
00:16:30,356 --> 00:16:32,066
{\be1}لا سيما أن اطفالاً هنا

205
00:16:33,286 --> 00:16:33,906
{\be1}أطفال ؟

206
00:16:38,206 --> 00:16:40,876
{\be1}اذهب والعب مع أصدقائك

207
00:16:40,876 --> 00:16:41,826
{\be1}أجل .. أجل

208
00:16:43,536 --> 00:16:45,296
{\be1}ما أضخمه

209
00:16:45,776 --> 00:16:48,496
{\be1}ليس ضخماً فقط, بل جميل أيضاً

210
00:16:48,496 --> 00:16:49,456
{\be1}أليس مذهلاً ؟

211
00:16:49,956 --> 00:16:53,176
  "عفواً, كيف تصدر النغمات من أنابيب " الاورغَن

212
00:16:53,786 --> 00:16:58,546
{\be1}بنفس مبدأ النغمات من آلة "الريكوردر" التي تستخدمونها في المدرسة

213
00:16:59,106 --> 00:17:01,906
{\be1}أنظروا إلى تلك الانابيب المصفوفة بجانب بعضها

214
00:17:02,856 --> 00:17:07,906
{\be1}"تصدر النغمات بمجرد ان يرتطم الهواء بأسقف الأنابيب تماماً كما يحصل عندما تنفخون في "الريكوردر

215
00:17:08,306 --> 00:17:09,116
{\be1}الهواء ؟

216
00:17:09,116 --> 00:17:10,006
حقاً ؟

217
00:17:10,006 --> 00:17:13,666
{\be1}"ولماذا ليس هناك ثقوب على الانابيب كما في "الريكوردر

218
00:17:14,016 --> 00:17:15,116
{\be1}صحيح

219
00:17:15,116 --> 00:17:19,356
{\be1}فلكي تصدرَ النغمات من "الريكوردر", عليك أن تغلق الثقوب بأصابعك أولاً قبل ان تنفخ

220
00:17:19,356 --> 00:17:20,376
{\be1}أما في "الاورغَن" الانبوبيّ

221
00:17:23,376 --> 00:17:27,216
{\be1}فتصدر النغمة من الانبوب المتصل بكل مفتاح بمجرد الضغط عليه

222
00:17:27,826 --> 00:17:31,556
{\be1}علماً ان لكل أنبوب نغمة تميزة

223
00:17:33,776 --> 00:17:35,396
{\be1}وما تلك الشبيه بمفتاح التحويل ؟

224
00:17:36,106 --> 00:17:37,096
{\be1}هذه ؟

225
00:17:37,106 --> 00:17:39,506
{\be1}Stop إنها تسمى الـ

226
00:17:39,516 --> 00:17:43,416
{\be1}وسَحبُ كل واحدة منها يُعدّل من نغمة النوتة الصادرة

227
00:17:43,886 --> 00:17:46,006
{\be1}.. على سبيل المثال, إذا سحبتم هذه

228
00:17:49,406 --> 00:17:50,376
{\be1}"إنه صوت آلة "الترومبيت

229
00:17:56,106 --> 00:17:57,006
{\be1}"الفلوت"

230
00:17:57,996 --> 00:18:02,636
{\be1}عازفو "الاورغَن" دائما ما يخلطون بين هذه النغمات كي يُضيفوا جمالاً  على أدائهم الموسيقيّ

231
00:18:02,966 --> 00:18:04,036
{\be1}فهمت

232
00:18:04,036 --> 00:18:05,366
{\be1}لقد تعلمنا شيئاً جديداً اليوم

233
00:18:05,826 --> 00:18:07,056
{\be1}.. حان الوقت الآن

234
00:18:07,466 --> 00:18:09,436
{\be1}لِلّغز الذي لطالما إنتظرتموه

235
00:18:10,096 --> 00:18:11,276
{\be1}ليس هناك  من ينتظره

236
00:18:11,836 --> 00:18:16,096
{\be1}أصيبت احدى مغنيات "الاوبرا" بتقرحٍ في حلقها وكانت تستعد لإجراء عملية جراحية

237
00:18:16,636 --> 00:18:20,916
{\be1}لكنها صرفت النظر عن إجراء تلك العملية, بعدها تحسنت بفضل حبة دواءٍ حصلت عليها من رجل عجوز

238
00:18:21,676 --> 00:18:24,876
{\be1}والآن من هي مغنية "الأوبرا" المقصودة من بين الخيارات التالية؟

239
00:18:25,536 --> 00:18:26,836
{\be1}"أ - مغنية "السوبرانو

240
00:18:27,476 --> 00:18:28,796
{\be1}"بـ - مغنية "الآلتو

241
00:18:29,316 --> 00:18:30,756
{\be1}"جـ - مغنية "التينور

242
00:18:31,266 --> 00:18:32,326
{\be1}" د - مغنية " الباس

243
00:18:37,666 --> 00:18:39,756
{\be1}اللغز صعبٌ جداً هذه المرة

244
00:18:40,526 --> 00:18:41,856
{\be1}هلا اعطيتنا تلميحاً يا بروفيسور ؟

245
00:18:42,306 --> 00:18:44,646
{\be1} كيف تلفظ عملية جراحية بالإنجليزية ؟

246
00:18:45,206 --> 00:18:46,136
{\be1}Operation.

247
00:18:46,596 --> 00:18:47,756
{\be1}"OPE"لكنها يمكن ان تختصر إلى

248
00:18:48,106 --> 00:18:51,736
{\be1}كما ذكر في اللغز فإن المغنية أخذت حبة دواء من رجل عجوز

249
00:18:52,816 --> 00:18:54,156
{\be1}[كونان], هل تعرف الحل

250
00:18:54,696 --> 00:18:55,466
{\be1}بالطبع

251
00:18:55,476 --> 00:18:56,476
{\be1}اللغز سهل للغاية

252
00:18:57,166 --> 00:18:57,706
{\be1} .. أولاً

253
00:18:57,706 --> 00:18:58,496
{\be1}الخيار الاول

254
00:19:01,666 --> 00:19:03,946
{\be1}"الجواب هو الخيار الاول .. مغنية "السوبرانو

255
00:19:04,766 --> 00:19:06,806
{\be1}مغنية "الاوبرا"  تخلت عن العملية الجراحية

256
00:19:07,386 --> 00:19:09,246
{\be1}"يعني ان تحذف المقطع "أوبي"  من "اوبرا" فيبقى " را

257
00:19:10,446 --> 00:19:13,576
{\be1}و "حبة الدواء" هي شيء مستدير

258
00:19:13,576 --> 00:19:16,746
{\be1}والتي تعني رجلاً عجوزاً  "Sofu" عبارة " حبة دواء من رجل عجوز" تعني ان تستخدم دائرة صغيرة مع كلمة

259
00:19:17,596 --> 00:19:19,756
{\be1}"وبضم ذلك إلى المقطع السابق "را

260
00:19:20,396 --> 00:19:21,166
{\be1}"را"

261
00:19:21,436 --> 00:19:22,516
{\be1}''Sofu'' مع

262
00:19:22,826 --> 00:19:24,216
{\be1}.. دائرة صغيرة

263
00:19:26,416 --> 00:19:28,076
{\be1}"سوبرانو"

264
00:19:29,236 --> 00:19:30,246
{\be1}لغز سخبف

265
00:19:31,346 --> 00:19:34,746
{\be1}معكِ حق .. ولكن ليس من اللباقة ان تقولي عنه سخيفاً

266
00:19:36,816 --> 00:19:38,056
{\be1}معذرةٍ آنسة [أكيبا]

267
00:19:38,496 --> 00:19:39,686
{\be1}.. نحن نتظرك لنتحدث إليك

268
00:19:40,216 --> 00:19:41,326
{\be1}تباً

269
00:19:41,336 --> 00:19:42,716
{\be1}أرجو ان تنتهو بسرعة

270
00:19:45,916 --> 00:19:52,446
{\be1}نود أن نستفسر منك مجدداً عن البريد الإلكتروني الذي أرسَلته إليكِ الآنسة [ كابي سوكو] قُبَيل الانفجار

271
00:19:53,036 --> 00:19:57,446
{\be1}“من المستحيل أن أعمل مع زمرة من الهواة , لا يستطيعون التفريق بين النغمات”

272
00:19:58,106 --> 00:19:59,786
{\be1}ما تعني ؟

273
00:20:00,226 --> 00:20:01,016
{\be1}المعنى ؟

274
00:20:01,366 --> 00:20:02,746
{\be1} تماماً كما هو مكتوب

275
00:20:03,706 --> 00:20:06,806
{\be1}.. كما أخبرتكم من قبل, أنا والآنسة [كابي]

276
00:20:06,806 --> 00:20:10,086
{\be1}لقد التقيتما أول مرة خلال المؤتمر الصحفي
 الذي عُعد من أجل الحفلة العامة, صحيح ؟

277
00:20:10,506 --> 00:20:11,156
{\be1}أجل

278
00:20:11,636 --> 00:20:15,466
{\be1}أخبرتني في ذلك الوقت أنها ستستمع إلى عزف الاثنين اللذين قُتِلا في الانفجار

279
00:20:15,466 --> 00:20:17,696
{\be1}وأنها سترسل إلىّ بريداً إلكترونياً عن انطباعها عنهما

280
00:20:17,696 --> 00:20:21,376
{\be1} معنى كلامهة .. أنه ونظراً لاختلاف اسلوب هذين الشخصين عن إسلوب لاآنسة [أكابي]

281
00:20:21,936 --> 00:20:25,416
{\be1}وتعقيبها كموسيقية على كونهما لا يستطيعان تمييز الاختلاف بين الأساليب

282
00:20:25,956 --> 00:20:27,886
{\be1}فليس بإمكانهما العمل معهما, أليس كذلك؟

283
00:20:28,796 --> 00:20:29,946
{\be1}ربما

284
00:20:30,456 --> 00:20:31,966
{\be1}لما لا تستفسر منها شخصياً ؟

285
00:20:32,426 --> 00:20:33,616
{\be1}ألم تستعد وعيها بعد ؟

286
00:20:34,126 --> 00:20:36,126
{\be1}بلى, لقد استفاقت من الغيبوبة

287
00:20:36,126 --> 00:20:37,866
{\be1}.. ولكن بسبب صدمة الانفجار

288
00:20:37,866 --> 00:20:40,006
{\be1}فقدت ذاكرتها بشأن ما حصل في ذلك  الانفجار

289
00:20:41,176 --> 00:20:41,966
{\be1}أحقا ما تقولين

290
00:20:43,936 --> 00:20:45,046
{\be1}هناك شيء آخر

291
00:20:45,926 --> 00:20:48,306
{\be1}وجدنا هذا في مكان الانفجار

292
00:20:49,616 --> 00:20:50,886
{\be1}"انها قطعة الجسد في آلة "الفلوت

293
00:20:51,206 --> 00:20:51,986
{\be1}صحيح

294
00:20:52,406 --> 00:20:58,356
{\be1}تتركب آلة " الفلوت" من ثلاث قطع, وهي الرأس, الجسد والذيل

295
00:20:58,706 --> 00:21:01,846
{\be1}ألا يمكن أن يون أحد الطلاب قد تركها ؟

296
00:21:02,146 --> 00:21:05,856
{\be1}هذا محتمل , لكن وجود قطعة الجسد يثير الريبة

297
00:21:07,226 --> 00:21:09,696
{\be1}ألم يخطر شيء على بالك ؟

298
00:21:11,016 --> 00:21:11,826
{\be1}آنسة [أكيبا] ؟

299
00:21:13,296 --> 00:21:14,586
{\be1}لا, لم يخطر شيء

300
00:21:15,056 --> 00:21:16,256
{\be1}هذا يكفي

301
00:21:17,516 --> 00:21:18,846
{\be1}لحظة يا آنسة [أكيبا]

302
00:21:30,236 --> 00:21:31,356
{\be1}ما هذا ؟

303
00:21:32,326 --> 00:21:33,526
{\be1}ما هذا الذي تشربينه ؟

304
00:21:34,016 --> 00:21:34,666
{\be1}شاي

305
00:21:34,816 --> 00:21:36,606
{\be1}دعينا نشرب منه نحن ايضاً

306
00:21:36,916 --> 00:21:37,616
{\be1}لا

307
00:21:37,616 --> 00:21:38,406
{\be1}بخيلة

308
00:21:38,996 --> 00:21:42,406
{\be1}هل تشربين هذا الشاي لأنه مفيد للحلق ؟

309
00:21:42,406 --> 00:21:43,576
{\be1}إطلاقاً

310
00:21:44,096 --> 00:21:48,136
{\be1}إن كان هذا الشاي مفيد حقاً, فلربما نفوز بالمركز الأول
في مسابقة الغناء الجماعي إذا ما شربنا منه  جميعاً

311
00:21:48,676 --> 00:21:49,966
{\be1}مسابقة الغناء الجماعي ؟

312
00:21:49,966 --> 00:21:50,466
أجل

313
00:21:50,916 --> 00:21:53,826
{\be1}ستنظم مدرستنا مسابقة للغناء الجماعي

314
00:21:54,176 --> 00:21:55,146
{\be1}بالمناسبة

315
00:21:55,146 --> 00:21:57,266
{\be1}ما رأيكِ ان تشرفي على تدريبنا للمسابقة ؟

316
00:21:59,066 --> 00:22:03,846
{\be1}سنتدرب إبتداءً من يوم الغد, عند الساعة الثانية
ظهراً  في قاعة الموسيقى الخاصة بمدرستنا

317
00:22:03,846 --> 00:22:06,616
{\be1} .."صحيح ان الآنسة [ران] تتولى أمر العزف على "البيانو

318
00:22:07,306 --> 00:22:10,246
{\be1}لكن الشخص الذي يحاول تعليمنا طريقة الغناء هو  المشكلة

319
00:22:10,246 --> 00:22:11,416
{\be1}أيها الأشثياء

320
00:22:13,006 --> 00:22:14,826
{\be1}من هو المشكلة ؟

321
00:22:18,686 --> 00:22:19,806
{\be1}يا إلهي

322
00:22:19,806 --> 00:22:22,086
أرجو منك ألا تكترثي لكثلل هذه الحماقات

323
00:22:23,476 --> 00:22:25,766
{\be1}أتمنى ألا يكون ما ستؤدونه هو مقطوعة " دايكو" التاسعة

324
00:22:26,386 --> 00:22:28,056
{\be1}لأنني لا احب سماع تلك المقطوعة

325
00:22:28,586 --> 00:22:30,456
{\be1}ليست اغنية  "دايكو" النجار

326
00:22:30,456 --> 00:22:32,146
{\be1}بل أغنية مدرسة (تيتان) الابتدائية

327
00:22:33,416 --> 00:22:37,996
{\be1}لقد كانت تتكلم عن سيمفونية [بيتهوفين]
التاسعة عندما ذكؤت "الدايكو" التاسعة

328
00:22:38,606 --> 00:22:39,066
{\be1}هل هذا صحيح ؟

329
00:22:40,716 --> 00:22:41,746
{\be1}لا بأس

330
00:22:41,746 --> 00:22:43,106
{\be1}سأدربكم على الغناء الجماعي

331
00:22:43,856 --> 00:22:45,906
{\be1}اعتبروه وفاءً من إحدى خريجات مدرسة (تيتان) الابتدائية

332
00:22:47,006 --> 00:22:48,076
{\be1} هل هذا صحيح ؟

333
00:22:48,716 --> 00:22:50,976
{\be1}لهذا ارجو  أن تعودوا إلى منازلكم الآن

334
00:22:50,976 --> 00:22:52,076
لأنكم تزعجوننا

335
00:22:52,076 --> 00:22:53,536
{\be1}حاضر

336
00:22:56,446 --> 00:23:00,066
{\be1}رغم أنني سعيد لموافقتها على تدريبَنا على الغناء الجماعي

337
00:23:00,066 --> 00:23:02,156
{\be1}إلا ان تلك العجوز فضة بعض الشي

338
00:23:02,736 --> 00:23:03,506
{\be1}نوعاً ما

339
00:23:04,476 --> 00:23:07,246
{\be1}يبدو وكأنها اكتسبت غطرسة المشاهير التقليدية

340
00:23:07,666 --> 00:23:08,576
{\be1}أجل

341
00:23:08,576 --> 00:23:10,196
{\be1}انها تشبهكِ قليلاً يا [هايبر]

342
00:23:13,206 --> 00:23:16,406
{\be1}لا .. أعني انها جميلة

343
00:23:16,666 --> 00:23:20,456
{\be1}لا  اعرف كيف أصف الآنسة [أكيبا] .. مزاجية, طيبة, أم ماذا ؟

344
00:23:20,646 --> 00:23:22,576
{\be1}لكن

345
00:23:23,386 --> 00:23:27,916
{\be1}ربما طلبت منا أن نخرج لأنها متعاطفة مع
الآنسة [شيون] التي كانت في قمة التوتر اليوم

346
00:23:28,626 --> 00:23:30,256
إينكِ تبالغين في تبرير موقفها

347
00:23:30,256 --> 00:23:31,076
{\be1}حقاً ؟

348
00:24:00,696 --> 00:24:02,266
{\be1}ثلاثون مقابل لا شيء

349
00:24:02,266 --> 00:24:06,326
{\be1}يا إليهي, اتلعبين جدية مع لاعبة مبتدئة مثلي

350
00:24:09,496 --> 00:24:12,726
{\be1}الأسد يجري بأقصى سرعته حتى لو كان يطارد ارنباً

351
00:24:13,056 --> 00:24:14,196
{\be1}حسنٌ, حسنٌ

352
00:24:14,196 --> 00:24:16,086
تقصدين إنني أرنبة إذن

353
00:24:16,556 --> 00:24:18,976
{\be1}كدت أنسى, ما رأيك ان نلعب مبارة " زوجي مختلط" في المرة القادمة ؟

354
00:24:19,376 --> 00:24:21,066
{\be1}وسندعو [ماكوتو] , و[شينتشي]

355
00:24:24,766 --> 00:24:25,526
{\be1}؟ [شينتشي]

356
00:24:26,936 --> 00:24:28,996
{\be1}ذلك المهووس بالتحريات

357
00:24:46,216 --> 00:24:47,106
{\be1}غير معقول

358
00:24:51,266 --> 00:24:53,776
{\be1}إذن فقد تشاجرتِ مع [شينتشي]

359
00:24:54,556 --> 00:24:56,726
{\be1}كما تعلمين ليس بإمكاني اصلاح الخلافات الزوجية

360
00:24:56,726 --> 00:24:57,736
الامر ليس هكذا

361
00:24:58,546 --> 00:25:00,726
{\be1}لكنكما دائماً على هذا الحال

362
00:25:00,726 --> 00:25:03,186
{\be1}تتخاصمان ثم تتصالحان بعد فترة وجيزة

363
00:25:05,116 --> 00:25:06,776
{\be1}لكن خصامكما طال كثيراً في إحدى المرات

364
00:25:07,586 --> 00:25:09,916
{\be1}اذكر انكما تخاصمتما لمدة اسبوع, اليس كذلك ؟

365
00:25:10,646 --> 00:25:11,426
{\be1}متى كان ذلك ؟

366
00:25:11,896 --> 00:25:13,886
{\be1}ألا تذكرين؟ عندما بلغنا الثانية عشر من العمر

367
00:25:14,516 --> 00:25:16,346
{\be1}تذكرت الآن

368
00:25:16,346 --> 00:25:17,116
{\be1}كان ذلك عندما

369
00:25:17,716 --> 00:25:19,856
{\be1}لحظة, لماذا تخاصمنا وقتها ؟

370
00:25:20,236 --> 00:25:22,246
{\be1}وكيف تصالحتما

371
00:25:24,706 --> 00:25:26,096
{\be1}هل نسيتي ما حدث ؟

372
00:25:27,096 --> 00:25:28,106
{\be1}أظن انه كان

373
00:25:34,426 --> 00:25:35,856
{\be1}مهلاً..مهلاً, توقفي هنا

374
00:25:37,016 --> 00:25:39,416
{\be1}ولماذا كنتما تعودان سوية إلى المنزل رغم خصامكما ؟

375
00:25:40,876 --> 00:25:42,876
{\be1}هذا لأن منزلينا يقعان في نفس الاتجاه

376
00:25:46,016 --> 00:25:46,786
{\be1} أستسلم

377
00:25:46,786 --> 00:25:47,336
{\be1}أكملي

378
00:25:55,326 --> 00:25:57,066
{\be1}وقتها كان هناك شخص يغني

379
00:25:58,116 --> 00:26:00,896
{\be1}في ذلك الوقت , سمعنا أحداً ما يغني من على ضفة النهر

380
00:26:01,416 --> 00:26:04,326
{\be1}.. وبطريقة ما ونحن  غارقات في الاستمتاع

381
00:26:04,866 --> 00:26:06,456
{\be1}تصالحتما من دون ان تشعرا

382
00:26:06,936 --> 00:26:08,246
ماذا عن تلك الاغنية

383
00:26:09,486 --> 00:26:10,606
{\be1}ماذا كانت ؟

384
00:26:11,836 --> 00:26:15,316
{\be1}أعتقد انها اغنية مشهورة, ولكن

385
00:26:15,596 --> 00:26:16,166
{\be1}هيا, هيا

386
00:26:16,866 --> 00:26:19,256
{\be1} .. في الواقع لا اتذكر كلماتها

387
00:26:19,256 --> 00:26:21,736
{\be1}لكنها اغنية تغلغلت في أعماق قلبي

388
00:27:14,866 --> 00:27:15,986
{\be1}كيف كان؟

389
00:27:15,996 --> 00:27:17,196
{\be1}ما رأيك بغناء الاطفال ؟

390
00:27:19,016 --> 00:27:19,836
حسنٌ, لنرى

391
00:27:21,656 --> 00:27:22,626
{\be1}أنت أولا

392
00:27:23,506 --> 00:27:24,936
{\be1}كان صوتك عالياً جداً

393
00:27:24,936 --> 00:27:26,596
{\be1}عليك ان تنسجم مع البقية

394
00:27:28,146 --> 00:27:30,056
{\be1}وانت صاحب الوجه النَّمِش الذي تقف بجانبه

395
00:27:30,606 --> 00:27:34,596
{\be1}رغم أنك لم تخرج عن الايقاع, إلا ان افتقدتَ الاحساس المرهف

396
00:27:35,466 --> 00:27:38,606
{\be1}هل هذا بسبب تحديقك بوجه الفتاة التي تقف أمامك ؟

397
00:27:39,076 --> 00:27:40,356
{\be1}الفتاة التي أمامه ؟

398
00:27:40,646 --> 00:27:42,066
{\be1}إنها تقصد [هايبرا]

399
00:27:45,036 --> 00:27:46,526
اما انت يا فتاة

400
00:27:47,376 --> 00:27:48,406
{\be1}تغنين بشكل جيد

401
00:27:49,156 --> 00:27:50,926
{\be1}لكن يستحسن ان تغني كطفلة

402
00:27:51,276 --> 00:27:52,886
{\be1}أنا لست طفلة

403
00:27:53,186 --> 00:27:53,746
{\be1}هاي , هاي

404
00:27:55,406 --> 00:27:59,026
{\be1}طبقة صوتكِ مناسبة, وتغنين بشكل معبر, أحسنتِ

405
00:28:00,806 --> 00:28:03,666
أما انت فلا ادع اصوات الآخرين تطغي على صوتك

406
00:28:04,096 --> 00:28:06,046
{\be1}تحل بالثقة

407
00:28:04,706 --> 00:28:05,766
{\be1}كما توقعت

408
00:28:06,456 --> 00:28:10,236
{\be1}بإمكانها تمييز اصحاب الأصوات حتى وإن لم تكن تصغي إلينا بتركيز

409
00:28:10,476 --> 00:28:11,516
{\be1}أجل

410
00:28:11,516 --> 00:28:13,026
إنها أذن الموسقي

411
00:28:13,336 --> 00:28:14,266
{\be1}المشكلة الكبرى

412
00:28:15,006 --> 00:28:15,396
{\be1أنت

413
00:28:17,016 --> 00:28:17,596
نعم ؟

414
00:28:17,866 --> 00:28:20,006
{\be1}خرجت عن الايقاع منذ البداية وحتى النهاية

415
00:28:20,376 --> 00:28:21,616
{\be1}لم تقصد ذلك, صحيح ؟

416
00:28:22,606 --> 00:28:23,516
كلا

417
00:28:23,516 --> 00:28:24,956
لم يكن يقصد ذلك

418
00:28:24,956 --> 00:28:26,806
{\be1}مشكلة [كونان] انه لا يملك أذنا موسيقية

419
00:28:26,986 --> 00:28:28,326
{\be1}اي نوع من الدفاع هذا ؟

420
00:28:31,276 --> 00:28:33,746
{\be1}وما زاد الوضع سوءاً هو صوت "البياونو" الغريب

421
00:28:35,006 --> 00:28:37,076
{\be1}كان صوته منخفضاً طوال الوقت

422
00:28:37,766 --> 00:28:39,616
{\be1}ألم تضبط اوتاره جيداً يا ترى ؟

423
00:28:39,616 --> 00:28:40,546
{\be1}حقاً ؟

424
00:28:40,896 --> 00:28:42,576
{\be1}مستحيل, لم الحظ شيئاً كهذا

425
00:28:43,596 --> 00:28:45,066
{\be1}أظن ذلك ايضاً

426
00:28:45,706 --> 00:28:46,466
{\be1}هذه الآنسة

427
00:28:48,316 --> 00:28:49,096
{\be1}آنسة [أكيبا]

428
00:28:49,476 --> 00:28:51,116
{\be1}هل تمتلكين موهبة الحس الموسيقي الفائق ؟

429
00:28:51,486 --> 00:28:52,946
{\be1}أجل يمكنكِ قول هذا

430
00:28:53,756 --> 00:28:55,726
{\be1}ما هو الحس الموسيقي الفائق ؟

431
00:28:56,136 --> 00:29:01,206
{\be1}إنه مقدرة الشخص على تمييز النغمة الموسيقية بمجرد سماع اللحن الصوتي

432
00:29:01,486 --> 00:29:02,306
{\be1}على سبيل المثال

433
00:29:08,066 --> 00:29:09,406
{\be1}E5
مي

434
00:29:12,496 --> 00:29:14,996
{\be1}B3 و F5's
سي, و فا

435
00:29:14,996 --> 00:29:15,716
{\be1}هذا صحيح

436
00:29:15,986 --> 00:29:16,826
{\be1}مذهل

437
00:29:17,176 --> 00:29:19,066
{\be1}لهذا انتِ بارعة في الغناء

438
00:29:19,536 --> 00:29:20,896
{\be1}حسنٌ, ربما

439
00:29:21,476 --> 00:29:26,786
{\be1}ليس من الضروري أن يمتلك الموسيقيّ الموهبة ليكون بارعاً

440
00:29:27,556 --> 00:29:29,946
{\be1}لكن, اعتقد انها موهبة فطرية لدي

441
00:29:29,946 --> 00:29:32,126
{\be1}لقد سمعتُ انه يمكن اكتساب هذه الموهبة بالتمرين كذلك

442
00:29:32,776 --> 00:29:36,586
وهذا ما حصل تماما مع عازف "البيانو" السابق, السيد[فوا]

443
00:29:36,946 --> 00:29:39,226
{\be1}حسنٌ, هذا كل ماعندي من ملاحظات

444
00:29:39,606 --> 00:29:41,236
{\be1}تدربوا على باقي الأمور بمفردكم

445
00:29:41,926 --> 00:29:43,936
{\be1}وإذا تحسن غناؤكم في الأيام القادمة

446
00:29:43,936 --> 00:29:44,906
سأستمع إليكم مجدداً

447
00:29:45,856 --> 00:29:47,176
{\be1}ستغادرين بهذه السرعة ؟

448
00:29:48,096 --> 00:29:50,496
{\be1}نود ان نسمع منكِ شيئاً بسيطاً  قبل ان تغادري

449
00:29:50,496 --> 00:29:51,346
{\be1}أجل

450
00:29:53,246 --> 00:29:54,686
{\be1}كم ستدفعون بالمقابل ؟

451
00:29:57,146 --> 00:30:00,406
{\be1}فالمشاهير لا يغنون مجاناً للآخرين

452
00:30:00,586 --> 00:30:01,126
{\be1}أراكم لاحقاً

453
00:30:01,936 --> 00:30:02,866
هذا هو, هذا هو

454
00:30:04,696 --> 00:30:06,436
انت, هذا الشاي الخاص بي

455
00:30:06,786 --> 00:30:08,106
شكراً على الشاي

456
00:30:13,586 --> 00:30:14,406
ما بك يا [غينتا]؟

457
00:30:16,186 --> 00:30:17,096
ما الذي يجري ؟

458
00:30:17,096 --> 00:30:17,826
[غينتا]

459
00:30:18,166 --> 00:30:19,056
[غينتا]

460
00:30:19,796 --> 00:30:21,156
هل انت بخير يا [غينتا] ؟

461
00:30:23,986 --> 00:30:26,886
احدهم دسَّ شيئاً ما فيها

462
00:30:27,396 --> 00:30:28,356
هذا ما يبدو

463
00:30:28,866 --> 00:30:29,576
مستحيل

464
00:30:30,116 --> 00:30:31,006
كيف لهذا ان

465
00:30:32,436 --> 00:30:34,096
على كل حال, فالنأخذه إلى المشفى

466
00:30:36,486 --> 00:30:38,156
هل [غينتا], على ما يرام ؟

467
00:30:38,616 --> 00:30:40,506
بدا لي انه يتألم كثيراً

468
00:30:41,416 --> 00:30:42,716
عيناه كانتا شديدتي الاحمرار

469
00:30:43,306 --> 00:30:45,466
متى شربتي من تلك الحافظة آخر مرة

470
00:30:46,866 --> 00:30:48,216
قُبيل الظهيرة حسب ما أذكر

471
00:30:48,706 --> 00:30:49,346
أين ؟

472
00:30:49,946 --> 00:30:53,776
حجزتُ غرفة تدريب في اكاديمية دوموتو

473
00:30:53,776 --> 00:30:55,186
من اجل ان امرن صوتي

474
00:30:55,816 --> 00:30:57,246
وذهبتُ إلى دورة مياه السيدات قبل مغادرتي

475
00:30:57,726 --> 00:31:02,646
واثناء تلك الفترة تركت حافظة الشاي مع بقية اغراضي في غرفة التدريب

476
00:31:03,286 --> 00:31:05,656
الوقت الوحيد الذي كان يمكن اثناءه دس شيء في الحافظة

477
00:31:05,656 --> 00:31:06,626
كان في تلك الفترة

478
00:31:07,206 --> 00:31:08,656
ولكن من هو الفاعل؟

479
00:31:09,976 --> 00:31:11,346
شكراً جزيلاً لك

480
00:31:14,296 --> 00:31:15,086
[غينتا]

481
00:31:16,326 --> 00:31:17,286
هل انت بخير ؟

482
00:31:17,676 --> 00:31:19,126
في اسوأ حال

483
00:31:19,806 --> 00:31:21,206
ماذا قال الطبيب ؟

484
00:31:22,056 --> 00:31:23,846
قال ان حلقه ملتهب جداً

485
00:31:24,336 --> 00:31:26,106
لكنه سيشفى في غضون اربعة او خمسة ايام

486
00:31:26,106 --> 00:31:27,376
ستُشفى

487
00:31:27,376 --> 00:31:28,016
حمداً لله

488
00:31:28,476 --> 00:31:33,406
إذن, فهذا يعني انه لن يكون قادراً على الكلام خلال الاربعة ايام المقبلة

489
00:31:33,406 --> 00:31:34,426
اجل

490
00:31:34,426 --> 00:31:36,986
ولم يتبقى سوى ثلاثة ايام على حفل قاعة دوموتو

491
00:31:37,526 --> 00:31:38,896
لو أن الآنسة [ريبيكو] شربت منه

492
00:31:39,306 --> 00:31:40,886
لم تكن لتستطع الغناء

493
00:31:43,286 --> 00:31:44,566
أخبر المفتش [ميغوري]

494
00:31:45,026 --> 00:31:47,306
ان يفحصو محتويات تلك الحافظة

495
00:31:47,836 --> 00:31:49,346
سأذهب لإعلامهم حالاً

496
00:31:50,156 --> 00:31:51,206
ولكن قبل ان اذهب

497
00:31:51,686 --> 00:31:53,796
لا تقلقي ,سنرافق [غينتا] إلى منزله

498
00:31:54,186 --> 00:31:54,946
وانا ايضاً

499
00:31:54,946 --> 00:31:55,756
وانا ايضاً سأذهب

500
00:31:56,496 --> 00:31:58,506
اريد ان أرى والدي هذا الطفل لأخبرهما

501
00:31:59,326 --> 00:32:01,216
أن ابنهما شرب من اشياء الآخرين دون استئذان

502
00:32:01,216 --> 00:32:02,976
أية تربية تلقاها هذا الصغير

503
00:32:03,546 --> 00:32:04,806
أنا اسف

504
00:32:04,816 --> 00:32:06,046
غينتا

505
00:32:14,986 --> 00:32:16,456
تشجع يا [غينتا]

506
00:32:17,456 --> 00:32:18,646
كلها اربع ايام

507
00:32:18,646 --> 00:32:19,576
ستمر كلمح البصر

508
00:32:21,106 --> 00:32:25,546
انا اريد .. اريد ان اخذ... حبة دواء الرجل العجوز

509
00:32:26,326 --> 00:32:29,256
يبدو ان لغز البروفيسور قد اصبح حقيقة

510
00:32:39,286 --> 00:32:40,936
تنحو جانباً

511
00:32:40,936 --> 00:32:41,616
كلا

512
00:32:41,616 --> 00:32:42,276
اركضو

513
00:32:44,526 --> 00:32:45,146
بسرعة

514
00:32:50,246 --> 00:32:51,666
تباً, لا استطيع رؤية وجهه

515
00:32:55,156 --> 00:32:56,586
والآن انعطفوا إلى اليمين

516
00:33:18,706 --> 00:33:19,276
ماذا

517
00:33:33,626 --> 00:33:34,426
هل انت بخير

518
00:33:42,016 --> 00:33:42,636
تباً

519
00:33:45,946 --> 00:33:47,156
هل انت بخير ؟

520
00:33:47,156 --> 00:33:47,446
أجل

521
00:33:48,316 --> 00:33:50,016
ما بال سائق تلك الشاحنة ؟

522
00:33:50,016 --> 00:33:51,706
يسير باتجاه معاكس في شارعٍ احادي المسار

523
00:33:51,706 --> 00:33:52,596
معلمة [رييكو]

524
00:33:53,136 --> 00:33:54,066
ساقكٍ تنزف

525
00:33:55,766 --> 00:33:57,026
لا يهم

526
00:33:59,096 --> 00:34:01,886
هل توقف الهجوم بسبب سيارة الاجرة يا ترى

527
00:34:03,086 --> 00:34:04,246
ام لأن

528
00:34:04,566 --> 00:34:07,116
اعتذر منكِ, ولكنني مضطرة لترك الأطفال معكِ

529
00:34:08,516 --> 00:34:10,326
ساستقل سيارة الاجرة هذه واعود إلى منزلي

530
00:34:10,856 --> 00:34:13,306
أخبروا الشرطة عما حدث للتو

531
00:34:14,306 --> 00:34:15,346
هل ستغادرين ؟

532
00:34:16,096 --> 00:34:19,016
مرافقتكم جلبت لي الحظ السيء

533
00:34:19,616 --> 00:34:20,856
ماذا ؟

534
00:34:20,856 --> 00:34:21,816
يا لها من لئيمة

535
00:35:21,036 --> 00:35:21,586
سيدي المفتش

536
00:35:22,706 --> 00:35:24,086
كيف حدث الانفجار ؟

537
00:35:24,086 --> 00:35:24,896
أجل

538
00:35:24,906 --> 00:35:29,646
اتضح ان الغرفة كانت مليئة بغاز "البروبان" الذي
انفجر بمجرد إشعال الضحية لعود الثقاب

539
00:35:29,656 --> 00:35:33,696
كما اثبتت التحقيقات ان كاشف تسريب الغاز قد تم تعطيله عمداً

540
00:35:34,236 --> 00:35:36,446
مما يعني ان ما حدث كان جريمة قتل, وليس مجرد حادثة عرضية

541
00:35:36,836 --> 00:35:38,996
الضحية هو صاحب المتجر

542
00:35:39,326 --> 00:35:41,546
ويدعى السيد [شيدا اوسامو], وعمرة 36 عاماً

543
00:35:41,546 --> 00:35:45,956
السيد [شيدا] كان عازف كمان, وهو أحد
خريجي الدفعة الاولى لاكاديمية دوموتو

544
00:35:46,296 --> 00:35:47,486
الدفعة الاولى ؟

545
00:35:48,036 --> 00:35:50,886
الامر تفسه ينطبق على ضحيتي الانفجار السابق

546
00:35:51,556 --> 00:35:53,546
لا أظن الامر محض مصادفة

547
00:35:53,546 --> 00:35:54,016
أجل

548
00:35:54,376 --> 00:35:55,176
ليست مصادفة

549
00:35:55,986 --> 00:35:56,796
المفتشة [ساتو]

550
00:35:59,466 --> 00:36:00,596
وجدنا هذا داخل المتجر

551
00:36:01,666 --> 00:36:02,326
ماهذا

552
00:36:03,006 --> 00:36:04,626
 "قطعة الذيل لآلة "الفلوت

553
00:36:05,516 --> 00:36:06,406
لا مجال للشك

554
00:36:07,076 --> 00:36:08,936
إنها سلسلة جرائم قتل من تنفيذ شخص واحد

555
00:36:09,706 --> 00:36:12,786
إضافة إلى ذلك, فلقد ترك لنا القاتل رسالتين

556
00:36:13,236 --> 00:36:15,016
قطعة الربط وقطعة الذيل

557
00:36:15,676 --> 00:36:17,726
بقيت قطعة الرأس لم تظهر

558
00:36:19,306 --> 00:36:23,136
في هذه الحالة, فأن جريمة اخرى ستقع

559
00:36:58,716 --> 00:37:04,016
الرجل الذي غرق بعد سقوطه من طائرته الشراعية
يدعى السيد [سوني هياسو], أليس كذلك ؟

560
00:37:04,496 --> 00:37:05,256
أجل

561
00:37:05,256 --> 00:37:07,566
"ولقد كان عازف "فيولا

562
00:37:08,156 --> 00:37:11,486
وللأشارة, فقد كان من خريجي الدفعة الأولى لطلاب أكاديمية دوموتو

563
00:37:12,426 --> 00:37:13,656
إذن فإنه

564
00:37:13,656 --> 00:37:14,446
أجل

565
00:37:14,956 --> 00:37:17,746
كان زميلا لضحايا الاسبوع الماضي, السيد [ميزومي] والسيد [رينجو]

566
00:37:18,206 --> 00:37:21,736
وكذلك السيد [شيدا] الذي قضى نحبه في الانفجار الذي وقع قبل يومين

567
00:37:22,616 --> 00:37:26,916
وفق ذلك فقد كان اربعتهم يشكلون فرقة
رباعية الــ "بيانو" إلى ما قبل السنتين الماضيتين

568
00:37:29,426 --> 00:37:32,576
كما توقعت, انها سلسلة جرائم قتل من تنفيذ شخص واحد

569
00:37:32,586 --> 00:37:33,826
لا شك في ذلك

570
00:37:34,486 --> 00:37:37,276
وفقاً  لأقوال الشرطة المحلية لتلك المنطقة, فالأجنحة القماشية

571
00:37:37,766 --> 00:37:41,986
وقبة تلك الطائرة الشراعية, ظهرت عليها
علامات قطع صغيرة جداً بواسطة أداة حادة

572
00:37:41,986 --> 00:37:45,776
وفوق هذا, وجدنا اسفل مقعد سيارة السيد [سوني]

573
00:37:46,376 --> 00:37:50,156
وجدتم القطعة الاخيرة من "الفلوت" قطعة الرأس, اليس كذلك ؟

574
00:37:51,066 --> 00:37:51,946
أ...أجل

575
00:37:52,586 --> 00:37:56,086
بما ان اجزاء "الفلوت" الثلاثة قد ظهرت

576
00:37:56,086 --> 00:37:59,086
ألا يعني هذا ان سلسلة الجرائم قد انتهت ؟

577
00:37:59,396 --> 00:38:00,896
اتمنى ذلك

578
00:38:01,456 --> 00:38:02,456
بالمناسبة يا [ران]

579
00:38:02,456 --> 00:38:03,006
أجل

580
00:38:03,636 --> 00:38:07,196
لقد فحصنا حافظة الشاي التي احضرتيها  إلينا

581
00:38:07,776 --> 00:38:09,696
وقد اثبت التحليل الجنائي انها تحتوي

582
00:38:09,696 --> 00:38:12,456
مواد كيميائية مهيجة

583
00:38:13,456 --> 00:38:15,646
الأمر اخطر من ان يكون مجرد دعابة إذن

584
00:38:16,316 --> 00:38:18,106
ماذا عن الشاحنة التي هاجمتنا ؟

585
00:38:18,556 --> 00:38:21,326
يبدو انها سرقت من مكان قريب من موقع الحادث

586
00:38:22,036 --> 00:38:24,846
بعبارة اخرى, لان خطة وضع المواد الكيميائية في الحافظة

587
00:38:24,846 --> 00:38:27,286
لم تفلح في إلحاق الأذى بالآنسة [اكيبا]

588
00:38:27,976 --> 00:38:31,076
لجأ الفاعل إلى خطة أخرى, وهي ان يسرق الشاحنة ومن ثم يحاول دهسها

589
00:38:31,576 --> 00:38:34,006
وما كل هذا إلا لتحقيق هدف واحد

590
00:38:34,826 --> 00:38:41,846
وهو ان يمنع الانسة من الغناء في حفل افتتاح قاعة دوموتو

591
00:38:43,516 --> 00:38:46,726
عفواُ, في حال لم تتمكن الآنسة [رييكو] من الغناء في الحفل

592
00:38:46,726 --> 00:38:48,186
من سيكون بديلها ؟

593
00:38:48,776 --> 00:38:51,556
حسب ما اعتقد, فإن الآنسة [تشيغوسا رارا] ستكون بديلتها على الاجرح

594
00:38:52,936 --> 00:38:55,256
"لقد كانت في الاصل الخيار الاول لفقرة "السوبرانو

595
00:38:55,656 --> 00:39:00,616
كونها من طلاب الدفعة التاسعة لأكاديمية دوموتو
وتلميذة السيد [دوموتو] في الوقت نفسه

596
00:39:02,476 --> 00:39:03,426
لكن مؤخراً

597
00:39:03,786 --> 00:39:06,886
الانسة [كابي سوكو] التي تم اعتمادها للعرض مسبقاً

598
00:39:07,336 --> 00:39:12,336
أوصت بالآنسة [اكيبا] لأداء هذا الدور, وأشارت
إلى رغبتها في العمل معها في حفل رسمي

599
00:39:13,106 --> 00:39:15,466
ولهذا تم اسناد الدور إليها

600
00:39:16,076 --> 00:39:18,466
السؤال الذي يطرح نفسه الان

601
00:39:18,466 --> 00:39:20,596
ما القاسم المشترك بين الضحايا الاربع وهذا الموضوع ؟

602
00:39:21,176 --> 00:39:22,066


603
00:39:22,526 --> 00:39:25,436
حتى هذه اللحظة لم نجد ما يربط الأنسة [اكيبا] بالضحايا الاربع

604
00:39:26,056 --> 00:39:27,326
كل ما نعرفة فقط

605
00:39:27,326 --> 00:39:30,846
هو  ان العلاقة بين الآنسة [كابي سوكو]  وضحايا الانفجاريين الاول والثاني

606
00:39:31,736 --> 00:39:33,736
ما يزال هناك مسألة الغناء

607
00:39:34,386 --> 00:39:39,046
القنبلة زرعت تحت الواح البلاط القريبة من الضحيتين

608
00:39:39,506 --> 00:39:40,476
في هذه الحال

609
00:39:41,056 --> 00:39:44,386
فأن سوء حظ الآنسة [كابي] هو من جعلها تتواجد هناك

610
00:39:44,666 --> 00:39:47,516
لا يزال الوقت مبكراً على مثل هذا الاستنتاج

611
00:39:47,516 --> 00:39:50,766
فهناك آخرون لديهم دوافع لقتل الآنسة [كابي]

612
00:39:51,656 --> 00:39:55,186
اتعني المرشحة السابقة من قبل الآنسة [اكيبا], الآنسة [تشيغوسا رارا] ؟

613
00:39:55,796 --> 00:39:56,836
هناك شخص آخر

614
00:39:57,376 --> 00:40:00,896
بديلة الآنسة [اكابي] في العرض, الآنسة [يماني شيون]

615
00:40:03,896 --> 00:40:04,816
هي كذلك ؟

616
00:40:05,216 --> 00:40:05,876
أجل

617
00:40:06,336 --> 00:40:08,716
"لأنها لو اخذت مكان الانسىة [اكابي] في فقرة "التراديفاريوس

618
00:40:09,226 --> 00:40:12,896
لا سيما في هذه الحفلة الموسيقية التي يحضرها موسيقيون مرموقون ومشهورون

619
00:40:13,246 --> 00:40:15,026
وكان عرضها في غاية الروعة

620
00:40:15,526 --> 00:40:19,096
فإن هذا سيفتح لها باب الشهرة على مصراعيه

621
00:40:20,726 --> 00:40:22,466
على اية حال, هناك احتمال آخر

622
00:40:23,046 --> 00:40:25,436
فعلى الرغم من ان الانسة [كابي] هي افضلُ وأكثرُ تلميذات [دوموتو] تفوقاً

623
00:40:26,296 --> 00:40:29,176
إلا ان اختيارها لأداء العرض الموسيقي القادم

624
00:40:29,686 --> 00:40:34,206
 "لم يكن بسبب انه يفضلها, بل لانها كان يخطط للاسيلاء على كمان "التراديفاريوس
الخاص بها

625
00:40:34,846 --> 00:40:38,136
كانت نيته الدائمة ان يجعل الآنسة [شيون] تؤدي العرض

626
00:40:38,606 --> 00:40:41,816
ولهذا وكخطوة أولى, جعلها البديلة الرئيسية

627
00:40:42,506 --> 00:40:46,916
ثم حرص على أن تتعرض الآنسة [كابي] لإصابات
"بالغة ليستولي على كمان "التراديفاريوس

628
00:40:47,306 --> 00:40:49,456
هذا الاحتمال لا يمكن تجاهله ايضاً

629
00:40:50,776 --> 00:40:54,386
العلاقات الانسانية معقدة جدا لدرجة انها اصبحت صعبة الفهم

630
00:40:54,766 --> 00:40:55,466
الخلاصة

631
00:40:55,926 --> 00:41:00,586
الشخص الذي لديه الدافع لقتل الآنستين [كابي] و [رييكو] هو الانسة [تشيغوسا رارا] فقط

632
00:41:01,436 --> 00:41:05,386
واللذان لديهما الدافع لقتل الآنسة [كابي] هما السيد [دوموتو] والآنسة [شيون]

633
00:41:05,956 --> 00:41:10,256
لكننا ما زلنا نجهل سبب إقدام احد الثلاثة على قتل الاربعة الآخرون

634
00:41:11,486 --> 00:41:12,656
أليس هذا صحيحاً ؟

635
00:41:13,296 --> 00:41:14,826
نعم , صحيح

636
00:41:16,766 --> 00:41:20,486
بالمناسبة, "البيانو" الذي كان في غرفة التدريب التي وقع فيها الانفجار

637
00:41:20,866 --> 00:41:23,256
هل هناك ما يميزهُ ؟

638
00:41:23,696 --> 00:41:27,156
كلا, لم اسمع اي شيء يميزه

639
00:41:27,616 --> 00:41:29,046
لِمَ تظن ذلك ؟

640
00:41:29,386 --> 00:41:31,306
عندما ذهبتُ إلى هناك في ذلك اليوم

641
00:41:31,306 --> 00:41:35,656
رأيت السيد [فوا] يحمل حطام مفتاح "بيانو" في يده, كما لو انه شيء نفسي

642
00:41:36,166 --> 00:41:38,856
"فظننت ان هناك ما يميزه ذلك "البيانو

643
00:41:38,866 --> 00:41:39,996
ولد

644
00:41:40,006 --> 00:41:42,206
كم مرة أخبرتك ألا تتسكع في الجوار بمفردك ؟

645
00:41:42,696 --> 00:41:43,736
أسف

646
00:41:44,276 --> 00:41:49,536
عزف السيد [دوموتو] على ذلك البيانو لأكثر
من ثلاثين عاماً وكان يحتفظ به في منزله

647
00:41:50,346 --> 00:41:52,476
"وبعد ان اعتزل العزف على "البيانو

648
00:41:52,946 --> 00:41:56,546
قرر ان يضعه في الاكاديمية حتى يتمكن الموسيقيون المبتدئون من التدريب عليه

649
00:41:57,386 --> 00:41:59,796
والجدير بالذكر انه وعندما كان "البيانو" في بيت السيد [دوموتو]

650
00:41:59,796 --> 00:42:01,656
وحتى بعدما نُقِل لاحقاً إلى الأكاديمية

651
00:42:01,656 --> 00:42:03,966
كان السيد [فوا] هو المسؤول عن ضبط إيقاعه

652
00:42:05,566 --> 00:42:09,556
حسنٌ, ربما كان يعد ذلك "البيانو" مثل ولده الصغير

653
00:42:10,056 --> 00:42:11,336
هل فهمت ايها الشقي ؟

654
00:42:12,706 --> 00:42:14,156
على ذكر الموضوع

655
00:42:14,156 --> 00:42:17,326
السيد [فوا] كان ينتقد الضحايا الاربع كثيراً في ما مضى

656
00:42:17,946 --> 00:42:21,036
كان يقول ان مشكلتهم في الحياة هي منهجهم السطحي

657
00:42:21,046 --> 00:42:25,356
لكن ... يستحيل ان يكون ما قلته سبباً يدفعه لقتل الاربعة, اليس كذلك ؟

658
00:42:25,976 --> 00:42:27,006
أظن ذلك

659
00:42:27,476 --> 00:42:33,556
لنفترض ان الامر كما قلت, قتلهم بعد ان ضاق
ذرعاً بهم بسبب منهجهم السطحي في الحياة

660
00:42:33,946 --> 00:42:37,506
ولكن ليس لهذا صلة بما حصل مؤخراً مع الآنسة [اكيبا]

661
00:42:38,656 --> 00:42:39,856
حضرة المفتش

662
00:42:39,856 --> 00:42:44,366
اليس من الافضل لو فصلنا قضية الآنسة [اكيبا] عن قضية الاربعة الآخرين ؟

663
00:42:44,776 --> 00:42:49,586
لكن القضيتين كلتيهما تتمحورران حول شخص واحد الا وهو السيد [دوموتو]

664
00:42:49,586 --> 00:42:52,496
لا اظن ما حدث هو محض مصادفة فقط

665
00:42:53,096 --> 00:42:54,336
ربما

666
00:42:54,666 --> 00:42:55,616
على كل حال

667
00:42:56,216 --> 00:42:59,226
من الآن وحتى انتهاء الحفل الموسيقى بعد يومين

668
00:42:59,576 --> 00:43:02,646
علينا تشديد الحراسة على الآنسة [اكيبا]

669
00:43:03,266 --> 00:43:05,386
لقد ارسلت [تاكاغي] مسبقاً, ولكن

670
00:43:06,556 --> 00:43:09,846
لقد رفضت وجودي معها معللة ذلك بانني ازعجها

671
00:43:11,026 --> 00:43:11,776
!يا حبيبي

672
00:43:11,776 --> 00:43:13,896
ما هذا يا [تاكاغي] ؟

673
00:43:13,896 --> 00:43:16,256
اذا هوجمت الآنسة [رييكو ]مجدداً

674
00:43:16,256 --> 00:43:17,936
فلم يجدي الاعتذار نفعاً

675
00:43:17,936 --> 00:43:22,246
لكنها اخبرتني انها ستبقى اليوم وغداً ملازمة منزلها

676
00:43:22,246 --> 00:43:23,536
ايها الاحمق

677
00:43:23,536 --> 00:43:25,596
هل من المنطقى ان ترد عليها بقولك فهمت, ثم تغادر ؟

678
00:43:25,846 --> 00:43:26,736
انا اسف

679
00:43:29,816 --> 00:43:30,896
انا خارج

680
00:43:33,176 --> 00:43:34,376
كونان

681
00:43:35,076 --> 00:43:36,466
صباح الخير يا [كونان]

682
00:43:37,046 --> 00:43:38,166
صباح الخير

683
00:43:38,916 --> 00:43:39,916
ما بكم يا رفاق ؟

684
00:43:40,306 --> 00:43:41,436
اتيتم مبكراً هذا الصباح

685
00:43:41,786 --> 00:43:43,766
"نحن ذاهبون لمشاهدة " كامين يايبا

686
00:43:44,236 --> 00:43:45,226
كامين يايبا ؟

687
00:43:45,436 --> 00:43:49,756
سيصورون اليوم في متنزه (ريوكوتشي) بالقرب من نهر (تيموزو)

688
00:43:49,756 --> 00:43:51,306
وفقا للمعلومات السرية التي وصلتني

689
00:43:51,636 --> 00:43:55,016
ربما سيتحسن [غينتا] إذا ما ذهب هناك

690
00:43:56,066 --> 00:43:58,526
لا ادري كيف سيساعد ذلك في التحسن

691
00:43:58,966 --> 00:44:01,676
ولهذا اتينا لنصحبك معنا, ولكن

692
00:44:01,676 --> 00:44:02,876
يبدو  انك ذاهب إلى مكان ما

693
00:44:03,416 --> 00:44:04,616
نعم, تقريباً

694
00:44:05,006 --> 00:44:05,896
تقريباً؟

695
00:44:06,556 --> 00:44:08,086
ليس بالامر المهم

696
00:44:08,206 --> 00:44:10,916
اهو اكثر اهمية من صديقك [غينتا] ؟

697
00:44:12,516 --> 00:44:13,826
ما باليد حيلة

698
00:44:14,486 --> 00:44:15,716
ساذهب إلى منزل الآنسة [رييكو]

699
00:44:16,206 --> 00:44:17,136
المعملة [رييكو] ؟

700
00:44:17,486 --> 00:44:18,876
من الافضل ألا تذهب

701
00:44:19,266 --> 00:44:21,626
لأنها ستثور من الغذب ثانيةً

702
00:44:21,626 --> 00:44:25,566
ربما, ولكن يتوجب عليَّ حمايتها من الاشرار

703
00:44:25,966 --> 00:44:28,166
اتقصد بالاشرار أولئك الذين هاجموها ؟

704
00:44:28,476 --> 00:44:30,236
لما انت مهتم بحمايتها إلى هذه الدرجة ؟

705
00:44:31,686 --> 00:44:33,256
فعلاً, حتى انا اتساءل عن السبب

706
00:44:33,996 --> 00:44:35,856
انا نفسي لا اعرف لماذل, ولكن

707
00:44:36,516 --> 00:44:40,206
لم اتحمل نفسي ابداً إن لم افعل ذلك

708
00:44:49,106 --> 00:44:51,586
إنه يعني انكَ وقعت في حبها

709
00:44:51,966 --> 00:44:54,016
[كونان] يفضل النساء الكبيرات في السن

710
00:44:54,556 --> 00:44:56,006
ماهذا الهراء

711
00:44:56,626 --> 00:44:59,056
على كل حال, سأترك [غينتا] معكما

712
00:44:59,526 --> 00:44:59,976
اعتمد عليكما

713
00:45:00,376 --> 00:45:01,266
[كونان]

714
00:45:02,766 --> 00:45:05,556
هل يقصد بكلامه انه يثق بنا ؟

715
00:45:06,326 --> 00:45:07,096
ربما

716
00:45:41,286 --> 00:45:41,956
اجل

717
00:45:44,686 --> 00:45:46,166
صباح الخير آنسة [رييكو]

718
00:45:46,476 --> 00:45:47,396
اسمحي لي بالدخول

719
00:45:48,486 --> 00:45:49,296
انت ! انتظر

720
00:45:50,446 --> 00:45:51,836
يا لها من شقة جميلة

721
00:45:52,296 --> 00:45:54,196
وهذا الحي يبدو هادئاً للغاية

722
00:45:55,946 --> 00:45:56,926
لحظة ايها الصغير

723
00:45:57,736 --> 00:46:00,976
كيف تقتحم بيوت الناس من دون استئذان ؟

724
00:46:00,976 --> 00:46:01,686
ما الذي تريده ؟

725
00:46:02,226 --> 00:46:03,536
دروساً في الغناء

726
00:46:03,876 --> 00:46:05,396
اريد اخذ دروس مكثفة

727
00:46:07,326 --> 00:46:09,056
تذكرتك الآن

728
00:46:09,056 --> 00:46:10,366
انت الصبي صاحب الاذن اللاموسيقية

729
00:46:11,026 --> 00:46:12,116
لكنني لا استطيع اليوم

730
00:46:12,506 --> 00:46:13,906
هل انتِ ذاهبة للخارج ؟

731
00:46:15,076 --> 00:46:18,306
لقد سمعت انكِ تذهبين إلى الغابة في اليوم
الذي يسبق الحفلات الموسيقة أو التسجيل

732
00:46:18,306 --> 00:46:21,136
كيْ ترفهي عن نفسكِ وتعيدي نشاطكِ

733
00:46:21,646 --> 00:46:23,326
بما انك تعلم هذا, فما الذي يبقيكَ هنا ؟

734
00:46:23,946 --> 00:46:26,186
اريد الذهاب معكِ

735
00:46:26,186 --> 00:46:27,186
يا الهي

736
00:46:27,186 --> 00:46:28,476
الم اقل لكم مسبقاً ؟

737
00:46:29,376 --> 00:46:33,306
وجودكم معي يجلب لي الحظ السئ, ابقَ بعيداً عني من فضلك

738
00:46:34,116 --> 00:46:36,426
ولنقل انكِ بقيت بعيدة عنا

739
00:46:36,426 --> 00:46:38,286
فهل ستكوني في مأمن من الاشرار ؟

740
00:46:39,406 --> 00:46:42,446
السبب الحقيقي وراء تصرفاتكِ يا
آنسة [رييكو] هو تأكدك من انكِ هدف المجرم

741
00:46:44,516 --> 00:46:46,886
عندما قلتِ إنك تريدين الذهاب إلى منزل [غينتا] في ذلك اليوم

742
00:46:47,466 --> 00:46:49,866
لم يكن لأنك تريدين توبيخ والديه

743
00:46:49,866 --> 00:46:52,326
بل حتى تتأكدي ان [غينتا] سيصل سالماً إلى منزله, أليس كذلك ؟

744
00:46:53,366 --> 00:46:54,876
ما هذا الهراء الذي تهذي به ؟

745
00:46:55,486 --> 00:46:58,256
هلا احضرتِ لي كوباً من العصير من فضلكِ قبل ان تغادري ؟

746
00:46:58,256 --> 00:46:59,206
اشعر بالعطش

747
00:47:00,826 --> 00:47:01,876
ما باليد حيلة

748
00:47:04,706 --> 00:47:06,986
لدي عصير برتقال طبيعي فقط

749
00:47:07,366 --> 00:47:08,686
لا تطلب المستحيل إذن

750
00:47:09,016 --> 00:47:10,646
اجل , انه جيد

751
00:47:12,446 --> 00:47:13,316
فلوت

752
00:47:13,886 --> 00:47:15,396
وهذا الرجل في الصورة

753
00:47:16,476 --> 00:47:16,776
ولد

754
00:47:18,936 --> 00:47:22,156
لا تزال اماكَ عشر سنوات حتى تبدأ غرف السيدات بإثارة اهتمامك

755
00:47:22,586 --> 00:47:25,196
اخبريني يا آنسة [رييكو] هل تعزفين على "الفلوت" ايضاَ ؟

756
00:47:25,196 --> 00:47:26,746
هذا ليس من شأنك

757
00:47:27,326 --> 00:47:28,786
عد فوراً إلى منزلك بعد ان تشرب العصير

758
00:47:29,366 --> 00:47:30,646
لن اعطيك اي درس في الغناء

759
00:47:31,266 --> 00:47:32,856
كما انني لم آخذك معي إلى الغابة

760
00:47:35,756 --> 00:47:36,726
حاضر

761
00:47:49,296 --> 00:47:51,536
سأتبعكِ عن بعد, لا تعيريني أي اهتمام

762
00:47:52,786 --> 00:47:53,286
على العموم

763
00:47:54,046 --> 00:47:55,706
لن اتحمل المسؤولية ان ضعت

764
00:47:58,026 --> 00:47:59,196
لا تقلقي .. لا تقلقي

765
00:48:03,336 --> 00:48:04,026
ايها [المفتش ميغوري]

766
00:48:05,686 --> 00:48:07,886
وجدنا صلة تربط الآنسة [أكيبا] بالضحايا الاربعة

767
00:48:08,106 --> 00:48:08,706
ماذا؟

768
00:48:09,486 --> 00:48:10,466
قبل ثلاث سنوات, وتحديدا في شهر يناير

769
00:48:11,156 --> 00:48:14,416
وفي نُزلٍ تابع لأكاديمية (دوموتو) بمنطقة (إيزو)

770
00:48:14,416 --> 00:48:17,056
"كان يقيم معهم عازف للـ "فولت

771
00:48:17,486 --> 00:48:21,766
وذات ليلة, أسرف ذلك الشخص في الشرب
فسقط من اعلى جرف مجاورٍ لاقياً مصرعه

772
00:48:22,016 --> 00:48:24,646
انه يدعى السيد [سوما هيكارو], وكان وقتها في الثامنة والعشرين من العمر

773
00:48:24,886 --> 00:48:26,946
وهو من خريجي الدفعة السادسة للأكاديمية

774
00:48:27,826 --> 00:48:29,106
ايعقل ان تكون لديهم يد في مقتله ؟

775
00:48:29,586 --> 00:48:30,396
أجل

776
00:48:30,406 --> 00:48:34,176
لقد أجبروه على الشرب رغم كونه لا يحتمل تأثير الخمور ابداً

777
00:48:34,806 --> 00:48:39,836
 وحيث إن هذا لا يعد سبباً مباشراً لسقوطه, فقد أغلق ملف التحقيق على كونها حادثة قضاء وقدر

778
00:48:40,296 --> 00:48:41,586
فهمت

779
00:48:41,586 --> 00:48:43,966
وما علاقة الآنسة [اكيبا] بكل هذا

780
00:48:44,416 --> 00:48:48,346
ذلك السيد المدعو [سوما] كان خيب الآنسة [أكيبا] في الواقع

781
00:48:48,686 --> 00:48:49,276
ماذا ؟

782
00:48:49,686 --> 00:48:50,316
سيدي

783
00:48:51,566 --> 00:48:55,836
هذا يقودنا إلى احتمال ان الآنسة كانت تكنُ الضعينة للضحايا الأربع

784
00:48:56,966 --> 00:49:00,276
ولكن, لماذا تمت مهاجمتها هي الأخرى ؟

785
00:49:31,986 --> 00:49:32,956
مرحباً

786
00:49:33,466 --> 00:49:34,026
مرحباً

787
00:49:36,756 --> 00:49:37,196
مرحباً

788
00:49:41,186 --> 00:49:43,006
هل هي امه يا ترى ؟

789
00:49:43,286 --> 00:49:44,986
انهما لا يشبهان بعضهما ابداً

790
00:49:45,326 --> 00:49:47,526
لم يسيران بعيداً عن بعضهما ؟

791
00:49:48,096 --> 00:49:50,166
ربما فعل شيئاً أغضب والدته

792
00:49:52,546 --> 00:49:53,316
تباً

793
00:49:53,316 --> 00:49:53,906
أخبرني

794
00:49:54,696 --> 00:49:58,816
هل تعلم لماذا اتمشى في الغابة في اليوم الذي يسبق الحفل مباشرة ؟

795
00:50:00,926 --> 00:50:04,026
لأنني اريد ان احبس الطبيعية في جسدي

796
00:50:04,626 --> 00:50:09,926
فالموسيقى الاوروبية استوحت الفذ من الطبيعية الخلابة{\b1\b0}

797
00:50:20,496 --> 00:50:21,506
هل تفهم ما اعنيه ؟

798
00:50:22,166 --> 00:50:22,726
أجل

799
00:50:23,566 --> 00:50:24,766
أظنني فهمت

800
00:50:36,806 --> 00:50:38,066
هل انت بخير يا ىنسة [رييكو] ؟

801
00:50:38,656 --> 00:50:39,256
أجل

802
00:50:45,726 --> 00:50:46,256
أركضي

803
00:50:56,426 --> 00:50:57,086
بسرعة إلى الامام

804
00:50:58,186 --> 00:50:59,676
لقد هاجمها  كما توقعت

805
00:51:10,276 --> 00:51:11,016
تباً

806
00:51:15,456 --> 00:51:16,246
سيُطلق الآن

807
00:51:25,266 --> 00:51:26,546
آنسة [رييكو] من هنا

808
00:51:28,146 --> 00:51:28,966
لماذا ؟

809
00:51:29,186 --> 00:51:30,186
لماذا لم يطلق النار ؟

810
00:51:31,666 --> 00:51:33,046
ما الذي يسعى اليه ؟

811
00:51:40,556 --> 00:51:44,096
أخبريني, أليس من الافضل ان نخبر الشرطة بما جرى ؟

812
00:51:44,096 --> 00:51:45,076
لا يمكن

813
00:51:45,076 --> 00:51:47,736
سبقَ واخبرتك .. إذا اخبرنا الشرطة بما جرى

814
00:51:48,466 --> 00:51:53,296
فسيستغرق التحقيق وقتاً طويلا, وهو ما قد يعطلكم عن حفل الغد, أليس كذلك؟

815
00:51:53,296 --> 00:51:54,576
افهم ذلك ولكن

816
00:51:55,186 --> 00:51:56,656
ما دمت تفهم ذلك فالزم الصمت إذن

817
00:51:57,606 --> 00:52:00,246
سأخبرهم بكل شيء يعد انتهاء الحفل

818
00:52:00,996 --> 00:52:01,426
هل فهمت ؟

819
00:52:02,006 --> 00:52:02,816
نعم

820
00:52:07,626 --> 00:52:08,516
الضابط [تاغاكي] ؟

821
00:52:09,446 --> 00:52:10,706
آنسة [أكايببا] ؟

822
00:52:10,706 --> 00:52:11,636
و [كونان] أيضاً ؟

823
00:52:16,166 --> 00:52:18,836
اين كنت يا آنسة [أكيببا] ؟

824
00:52:18,836 --> 00:52:20,406
ألم تخبرينا انكِ لن تخرجي من منزلكِ اليوم ؟

825
00:52:20,406 --> 00:52:21,936
كان عندي موعد مع هذا الصبي

826
00:52:22,566 --> 00:52:23,656
مـ ... موعد ؟

827
00:52:24,046 --> 00:52:26,366
آنسة [اكيبا].. نود التحدث إليك عن موضوع مهم

828
00:52:26,366 --> 00:52:27,276
في وقت اخر

829
00:52:28,566 --> 00:52:30,696
ماذا لو كان بخصوص السيد [سوما هيكارو] ؟

830
00:52:33,056 --> 00:52:36,286
السيد [سوما هيكارو] كان خطيبك, اليس كذلك ؟

831
00:52:38,306 --> 00:52:38,976
حضرة المفتش

832
00:52:39,626 --> 00:52:41,666
سأخبرك بكل ما أعرفه

833
00:52:42,636 --> 00:52:45,656
لكن, كل ما اطلبه هو أن تؤجل ذلك إلى ما بعد حفل الغد

834
00:52:52,276 --> 00:52:53,346
عفواً حضرة المفتش

835
00:52:53,916 --> 00:52:56,866
هل كان للسيد [سوما] شامة هنا ؟

836
00:52:57,456 --> 00:52:59,706
أجل, كيف عرفت ذلك ؟

837
00:53:00,696 --> 00:53:03,376
رأيت صورة له في شقة الىنسة [رييكو]

838
00:53:04,616 --> 00:53:06,546
صورة له في شقة الآنسة [أكيبا] ؟

839
00:53:08,076 --> 00:53:09,956
ما رأيكم ان توصلوني إلى المنزل, وهناك سأخبركم بكل شيء

840
00:53:13,946 --> 00:53:16,716
وهكذا اوصلنا [كونان] إلى هنا

841
00:53:17,116 --> 00:53:24,066
اتضح في النهاية, ان كل ما يعرفه, هو انها تحتفظ
"في شقتها بصورة للسيد [سوما], إضافة إلى "الفلوت

842
00:53:25,126 --> 00:53:25,916
تباً

843
00:53:26,946 --> 00:53:28,076
ولكن حضرة المفتش

844
00:53:28,616 --> 00:53:32,476
حتى وان كان لديها دافع قوي لقتل أولئك الاربعة

845
00:53:32,476 --> 00:53:34,686
فهذا لا يكفي أبداً لوضعها في قفص الاتهام

846
00:53:34,686 --> 00:53:37,216
لا تنس انها هوجمت من قبل شاحنة

847
00:53:38,256 --> 00:53:39,166
بالمناسبة

848
00:53:39,166 --> 00:53:43,586
هل للسيد [سوما] أقارب ربما يفكرون بالانتقام له ؟

849
00:53:43,946 --> 00:53:45,846
كلا, لا أظن ذلك

850
00:53:46,806 --> 00:53:47,686
المعذرة

851
00:53:47,686 --> 00:53:49,056
لقد اعددت لكم الشاي

852
00:53:49,056 --> 00:53:49,766
شكراً لك

853
00:53:50,516 --> 00:53:51,406
معذرة لاتعابك معنا يا [ران]

854
00:53:51,826 --> 00:53:52,406
تفضل

855
00:53:57,236 --> 00:53:58,166
لنرَ

856
00:53:58,176 --> 00:54:01,616
والدته لن تتزوج غير والده, وقد وافتها المنية قبل خمس سنوات

857
00:54:02,336 --> 00:54:03,816
كما انه ليس لديه اشقاء

858
00:54:03,826 --> 00:54:04,696
ماذا عن والده ؟

859
00:54:05,106 --> 00:54:06,286
ليست لدينا أية معلومات عنه

860
00:54:06,816 --> 00:54:08,646
حتى إننا لا ندري إن كان لا يزال على قيد الحياة

861
00:54:10,276 --> 00:54:11,036
هذا

862
00:54:15,986 --> 00:54:20,056
هناك امرآخر مهم جداً يخص الضحايا الاربع

863
00:54:20,536 --> 00:54:24,246
لقد أدو حفلة ذات مرة وهم سُكارى

864
00:54:24,246 --> 00:54:27,016
فما كان من السيد [دوموتو] إلا ان وبخهم وبشدة

865
00:54:27,016 --> 00:54:28,326
ماذا تقول ؟

866
00:54:28,326 --> 00:54:29,726
متى حدث ذلك ؟

867
00:54:29,726 --> 00:54:30,896
حسنٌ

868
00:54:31,036 --> 00:54:31,996
لنرَ

869
00:54:33,026 --> 00:54:33,656
ها هي

870
00:54:34,256 --> 00:54:35,836
تلك الحفلة كانت في السنة الماضية

871
00:54:35,836 --> 00:54:38,986
وقد عزفو مقطوعة "بيانو" رباعية لــ بيتهوفن

872
00:54:41,696 --> 00:54:43,376
عرفت كل شيء ايها المفتش

873
00:54:44,176 --> 00:54:51,806
عرفت الدافع والمجرم الذي قتل الاربعة, وإصتبة [كابي]
بإصابات بالغة, حقيقة الهجوم على الآنسة [أكيبا]

874
00:54:53,056 --> 00:54:54,136
حقاً انت جاد يا [موري] ؟

875
00:54:54,796 --> 00:54:55,336
أجل

876
00:54:55,726 --> 00:54:57,086
المجرم هو

877
00:54:58,956 --> 00:55:00,226
سيد [دوموتو غينيا]

878
00:55:00,606 --> 00:55:01,516
إنه انت

879
00:55:05,816 --> 00:55:07,036
والسبب

880
00:55:07,036 --> 00:55:08,696
انك شديد الاعجاب ببتهوفن

881
00:55:09,476 --> 00:55:09,946
لدرجة

882
00:55:11,346 --> 00:55:14,866
لدرجة انك اصبحت متطرفاً

883
00:55:18,806 --> 00:55:19,576
هاي...هاي

884
00:55:20,096 --> 00:55:21,786
ما هذا الهراء الذي تهذي به ؟

885
00:55:22,446 --> 00:55:28,476
قتلت الاربعة لانهم أدو عملاً في غلية السوء لـ بيتهوفن نتيجة اسرافهم في الشرب

886
00:55:28,756 --> 00:55:32,866
اعتبرتها إهانة كبيرة في حق ملحن بحجمه

887
00:55:33,296 --> 00:55:41,616
كما تسببت بإصابات بالغة للآنسة [كابي], لأن أداءها
للمقطوعة في آخر مرة علمتُمها فيها سوية كان مغايراً كلياً لأدائك

888
00:55:43,336 --> 00:55:46,916
هذا ما ورد, وبأدق التفاصيل, في مذكرة الآنسة [كابي] اليومية

889
00:55:47,586 --> 00:55:51,416
"واخيراً, قمت بمهاجمة الآنسة [أكيبا] وذلك لانها قالت في "البروفة

890
00:55:53,206 --> 00:55:55,106
اتمنى ألا يكون ما ستؤدونه هو مقطوعة دايكو التاسعة

891
00:55:55,606 --> 00:55:57,376
لاني لا احب سماع تلك المقطوعة

892
00:55:58,436 --> 00:56:01,296
عددت كلاهمها إهانة لمقطوعة بيتهوفن التاسعة

893
00:56:03,186 --> 00:56:04,426
انتظر لحظة من فضلك

894
00:56:04,826 --> 00:56:06,396
صحيح انني معجب بــ بيتهوفن

895
00:56:06,656 --> 00:56:10,096
واكن له كل الاحترام .. لكنني لن اقوم بتصرف بشع كهذا

896
00:56:10,436 --> 00:56:11,776
كلا, لا شك في ذلك

897
00:56:12,666 --> 00:56:16,906
وتسريحة شعرك المشابه تماماً لتسريحة
شعر بيتهوفن هي الدليل القاطع على صحة استنتاجي

898
00:56:19,946 --> 00:56:20,746
مــ .. [موري] ؟

899
00:56:24,276 --> 00:56:25,796
لا بد انك تمزح ؟

900
00:56:25,796 --> 00:56:27,166
هذه تسريحة شعري الطبيعية

901
00:56:29,216 --> 00:56:30,766
كل ما في الامر انني اشبه والدتي الراحلة

902
00:56:31,306 --> 00:56:32,466
وان كنت لا تصدقني

903
00:56:34,686 --> 00:56:35,216
فأنظر من فضلك

904
00:56:38,066 --> 00:56:39,596
بالفعل

905
00:56:39,596 --> 00:56:40,846
انه يشببها كثيراً

906
00:56:42,516 --> 00:56:43,626
ما رأيك الآن ؟

907
00:56:43,626 --> 00:56:45,516
بالنسبة للضحايا الاربع والآنسة [اكيببا]

908
00:56:46,036 --> 00:56:49,476
فلا تربطني بهم أية علاقة سوى بيتهوفن

909
00:56:49,836 --> 00:56:52,206
ولا تنسى ايضاً  انني والآنسة [كابي] موسيقيان

910
00:56:52,396 --> 00:56:56,416
وغالبا ما تنشب خلافات بسبب اختلاف طريقة أدائنا

911
00:56:56,886 --> 00:56:59,456
الامر بطريقة الاداء ليس إلا

912
00:56:59,456 --> 00:57:01,786
لن نكره بعضنا لسبب تافه كهذا

913
00:57:02,156 --> 00:57:04,126
لا تكرر هذه السخافات مرة اخرى لو سمحت

914
00:57:04,726 --> 00:57:05,946
لا... اعني

915
00:57:05,946 --> 00:57:06,706
سيدي المفتش

916
00:57:07,306 --> 00:57:11,746
هل جئتم في هذا الوقت المتأخر لتسمعونا هذا الاستنتاج المضحك؟

917
00:57:12,846 --> 00:57:15,936
وفوق كل هذا لدينا حفل في غية الاهمية في الغد

918
00:57:17,486 --> 00:57:18,396
هذا صحيح

919
00:57:19,526 --> 00:57:21,436
على كل حال ارجو ان تغادروا الان

920
00:57:21,996 --> 00:57:26,686
وبعد انتهاء الحفل, سنجيب عن كل اسئلتكم بالشكل الذي يرضيكم

921
00:57:28,306 --> 00:57:31,796
يا الهاي ! كنت اظن انني على حق

922
00:57:32,296 --> 00:57:34,626
من اين اتيت بكل هذه الثقة

923
00:57:35,676 --> 00:57:37,036
عفواً أيها الضابط [تاكاغي]

924
00:57:37,366 --> 00:57:39,996
ألم تستعد الآنسة [كابي] ذاكرتها بعد ؟

925
00:57:39,996 --> 00:57:41,596
ليس بعد

926
00:57:41,596 --> 00:57:44,516
بدأت تستعيد قدراتها على التحدث عن بعض الاشياء

927
00:57:44,876 --> 00:57:49,286
ولكنها تقول اشياء مثل كونها تلاحظ طبقة الصوت
الصادر عن جهاز التكييف وان ذلك يمنعها من النوم

928
00:57:49,286 --> 00:57:51,976
لا شك انها تتحدث عن اشياء مبهمة

929
00:57:53,006 --> 00:57:55,036
طبقة الصوت الصادر عن جهاز التكييف ؟

930
00:57:55,806 --> 00:57:56,666
ايعقل انها...؟

931
00:58:00,576 --> 00:58:02,946
لا تأخذه الآن

932
00:58:03,086 --> 00:58:04,446
أسفة حقاً

933
00:58:04,446 --> 00:58:05,266
رجاءً, استخدموا هذه

934
00:58:05,606 --> 00:58:05,906
حسنٌ

935
00:58:07,566 --> 00:58:10,486
ستكون مثل الحفل الرسمي تماماً

936
00:58:10,496 --> 00:58:16,336
ما يجعل حضور "البروفة" النهائية أمر جديراً بالاهتمام, وهو حصولك على
فرصة لاختيار مقعدك في قاعة فارغة, ثم الاستماع إليهم وهم يعزفون

937
00:58:25,206 --> 00:58:27,316
سنجلس في مقاعد الطابق العلوي اثناء الحفل الرسمي

938
00:58:27,916 --> 00:58:29,446
لقد طلبت من ابي ان يحجزهل لنا

939
00:58:31,286 --> 00:58:32,686
اتعنين تلك الشرفة ؟

940
00:58:33,086 --> 00:58:36,576
يوجد فيها عشرة مقاعد وجميعها محجوزة لنا

941
00:58:37,436 --> 00:58:38,516
عشرة مقاعد لنا ؟

942
00:58:38,756 --> 00:58:41,166
لقد دعوت البروفسور [أغاسا] والاطفال ايضاً

943
00:58:41,706 --> 00:58:43,386
كما حجزت مقعداً لــ[شينتشي]

944
00:58:45,346 --> 00:58:46,406
اخبريه بذلك

945
00:58:46,916 --> 00:58:49,166
سنترك له التذكرة عند مكتب الاستقبال

946
00:58:49,666 --> 00:58:50,956
لا تقلقي بشأنه

947
00:58:51,316 --> 00:58:54,396
لا عليك, هيا اسرعي وأخبرية حتى لا يذهب مقعده سُدىً

948
00:58:54,596 --> 00:58:55,976
ما باليد حيلة

949
00:58:56,496 --> 00:58:57,896
لا أظنه سيأتي

950
00:59:00,106 --> 00:59:01,256
اسف حقاً يا [ران]

951
00:59:08,016 --> 00:59:11,206
يبدو انك كتمت ما حصل معنا البارحة عن الشرطة

952
00:59:11,896 --> 00:59:13,576
انا ممتنة لك

953
00:59:14,026 --> 00:59:15,636
ليس هذا هو الامر المهم

954
00:59:15,636 --> 00:59:17,076
كيف حال الجرح في ساقكِ ؟

955
00:59:18,226 --> 00:59:19,686
لن يؤثر اطلاقا على غنائي

956
00:59:20,876 --> 00:59:21,736
بالمناسبة

957
00:59:21,736 --> 00:59:24,846
الآنسة [كابي] تمتلك مثلكِ موهبة الحس الموسيقي الفائق, اليس كذلك ؟

958
00:59:25,416 --> 00:59:28,836
أجل, استنتجت ذلك عندما قابلتها اول مرة

959
00:59:28,836 --> 00:59:30,316
وبعدها اصبحنا صديقتين حميمتين

960
00:59:31,086 --> 00:59:31,906
هل يهمك ذلك ؟

961
00:59:33,226 --> 00:59:34,276
إطلاقاً

962
00:59:35,486 --> 00:59:35,946
حقاً ؟

963
00:59:37,686 --> 00:59:38,576
حسنٌ, سأذهب الآن

964
00:59:39,906 --> 00:59:41,296
حظاً طيباً في الحفل

965
00:59:45,476 --> 00:59:48,316
الانستان [ريكو و كابي] تمتلكان موهبة الحس الموسقي الفائق

966
00:59:49,186 --> 00:59:49,876
هذا يعني

967
00:59:50,846 --> 00:59:53,856
أرسلت له رسالة نصية, لكوني سأنزعج لو حادثته

968
00:59:54,206 --> 00:59:55,086
حقاً ؟

969
00:59:55,086 --> 00:59:56,716
سيكون أمراً رائعاً لو تمكن [شينتشي] من الحضور

970
00:59:57,686 --> 00:59:59,926
لا يهمني ان اتى ام لا

971
01:00:00,366 --> 01:00:01,936
كل ما في الامر ان مقعده سيذهب سدىً

972
01:00:02,456 --> 01:00:04,436
هذا ما قلته لكِ قبل قليل

973
01:00:04,436 --> 01:00:05,336
حقاً

974
01:00:06,066 --> 01:00:08,716
لا تشغلوا بالكم, سنبدأ من دونه

975
01:00:11,306 --> 01:00:12,366
هل من مشكلة ؟

976
01:00:13,106 --> 01:00:14,096
سيد [موري]

977
01:00:14,696 --> 01:00:16,456
لم يحضر السيد [مولر] بعد

978
01:00:17,236 --> 01:00:18,506
"اتقصد ضابط إقاع "الاروغن

979
01:00:19,186 --> 01:00:22,836
اتفقنا على ان يحضر "البروفة" النهائية ليقوم بما يلزم من الضبط النهائي

980
01:00:23,316 --> 01:00:24,856
يا إلهي ! هذا مزعج فعلاً

981
01:00:26,006 --> 01:00:30,716
لم يرد على أيّ من مكالماتي, كما اخبرني موظفو الفندق لم يعد منذ ليلة البارحة

982
01:00:31,906 --> 01:00:32,676
منذ ليلة البارحة ؟

983
01:00:33,566 --> 01:00:38,996
كل ما تبقى هو الضبط النهائي, أي ان عدم حضورة ليس بتلك المشكلة

984
01:00:39,336 --> 01:00:41,636
لكن, ألا يعني هذا أنه مفقود ؟

985
01:00:42,026 --> 01:00:43,646
هل اخبرتم الشرطة بالأمر ؟

986
01:00:44,206 --> 01:00:44,636
كلا

987
01:00:45,196 --> 01:00:48,636
التحقيق سيستغرق وقتاً طويلا مما قد يتسبب لنا بمشاكل

988
01:00:49,396 --> 01:00:52,506
كل ما يهمنا الآن هو التركيز على الحفل الموسيقي فقط

989
01:01:05,426 --> 01:01:07,346
وكأن التي امامي ليست الآنسة [شيون]

990
01:02:29,386 --> 01:02:30,586
صوتها

991
01:02:52,776 --> 01:02:55,226
عزف الأنسة [شيون] على الكمان كان في غاية الروعة

992
01:02:55,226 --> 01:02:58,336
فعلاً, كان مغايراً تماماً لأدائها في "البروفة" السابقة

993
01:02:59,076 --> 01:03:02,846
لقد جعلت "التراديفاريوس" ملكها

994
01:03:03,036 --> 01:03:04,126
ما دخلك بالموسيقى ايها الشقي ؟

995
01:03:04,906 --> 01:03:07,406
ناهيكم عن غناء الآنسة [رييكا] المذهل

996
01:03:12,446 --> 01:03:13,596
[كونان]

997
01:03:17,226 --> 01:03:18,696
لقد حضرتم مبكراً جداً يا رفاق

998
01:03:19,126 --> 01:03:21,716
بما انهم لن يسمحوا لأحد بالدخول اذا ما تأخر دقيقة واحدة

999
01:03:22,376 --> 01:03:24,396
طلبنا من البروفسور ان يحضرنا إلى هنا باكراً

1000
01:03:24,856 --> 01:03:26,726
مال الذي تحمله في يدك ؟

1001
01:03:28,236 --> 01:03:29,436
اليس هذا "ريكوردر" ؟

1002
01:03:29,976 --> 01:03:31,726
ايها الاحمق

1003
01:03:31,726 --> 01:03:35,066
كيف تحضر معك شيئاً كهذا إلى حفلٍ موسيقي كلاسيكي ؟

1004
01:03:35,066 --> 01:03:36,486
لا تصرخ عليه

1005
01:03:36,486 --> 01:03:40,536
[غينتا] يريد ان يصدر بعض النغمات فقط, كونة لا يستطيع الكلام

1006
01:03:40,546 --> 01:03:41,756
وان يكن

1007
01:03:42,316 --> 01:03:45,066
لن يستعمله بالطبع اثناء الحفل

1008
01:03:45,606 --> 01:03:46,616
اليس كذلك يا [غينتا] ؟

1009
01:03:48,926 --> 01:03:50,836
"هذا يعني "أجل

1010
01:03:52,456 --> 01:03:54,116
أخفِه عندما تدخل للقاعة

1011
01:03:55,296 --> 01:03:57,396
والهواتف النقالة ممنوعة ايضاً

1012
01:03:57,756 --> 01:03:59,096
يعلمون هذا

1013
01:03:59,096 --> 01:04:01,436
حتى انهم لم يحضروا شارات المحققين معهم

1014
01:04:01,696 --> 01:04:03,316
بالمناسبة انا جائعة جداً

1015
01:04:05,956 --> 01:04:07,786
اكل شيئاحسنُ بما اننا نشعر بالجوع., فلم لا نأكل شيئاً ؟

1016
01:04:08,306 --> 01:04:09,266
فكرة جيدة

1017
01:04:09,266 --> 01:04:12,696
سيبدأ الحفل في تمام الخامسة مساءً, ولن يكون موقفنا لطيفاً إذا ما تعالت اصوات معدتنا اثناء الحفل

1018
01:04:16,666 --> 01:04:18,326
"إنه يقول "اوناجو بالأرز

1019
01:04:19,196 --> 01:04:22,176
"يا ليته كان ممكناً إجراء حوارات بـ"الريكزردر

1020
01:04:22,186 --> 01:04:24,596
هذا بيس مستحيلاً

1021
01:04:25,416 --> 01:04:27,396
كل ما عليك فعله هو تحويل النغمات إلى احرف

1022
01:04:27,766 --> 01:04:28,676
تحويل النغمات

1023
01:04:28,976 --> 01:04:30,566
إلى احرف  ؟

1024
01:04:32,016 --> 01:04:35,606
أنا اتحدث هنا عن الأحرف الابجدية الإنجليزية
أي ان [كوجيما]   لا يمكنها فعل ذلك

1025
01:04:36,026 --> 01:04:37,866
تلك النغمة تقلقني

1026
01:04:38,256 --> 01:04:41,366
[ران] , تذكرت شيئاً عليَّ القيام به

1027
01:04:41,836 --> 01:04:44,006
أعِدك أن اكون على مقعدي قبل فتح الستارة

1028
01:04:45,606 --> 01:04:46,916
انتظر [كونان]

1029
01:04:47,436 --> 01:04:49,456
يا له من شقي اناني

1030
01:05:10,856 --> 01:05:12,176
تلك النوتة

1031
01:05:12,176 --> 01:05:13,486
أليس تلك النوتة خافضة بعد الشيء ؟

1032
01:05:13,746 --> 01:05:14,486
أجل

1033
01:05:14,486 --> 01:05:15,456
نفس الشعور يراودني

1034
01:05:16,156 --> 01:05:17,956
لاحظتها عندما كنت اغني

1035
01:05:18,526 --> 01:05:20,726
ورغم أنني اعرف المفتاح الذي أصدرها

1036
01:05:21,346 --> 01:05:23,626
stopإلا انني لا اعرف الجرس الموسيقي أو حتى الـ
المستخدم

1037
01:05:24,436 --> 01:05:26,256
فعدة انابيب كانت تصدر النوتة في الوقت نفسه

1038
01:05:32,256 --> 01:05:34,186
النوتة التي صدرت خافضة فعلاً

1039
01:05:34,186 --> 01:05:35,256
لا شك في ذلك

1040
01:05:35,586 --> 01:05:37,366
انها تصدر من تلك المنطقة

1041
01:05:37,866 --> 01:05:40,726
اغلب الظن انها تصدر من احد الانابيب الداخلية القصيرة

1042
01:05:41,436 --> 01:05:43,866
يبدو انه لم يعد مضبوطاً كما يجب

1043
01:05:44,526 --> 01:05:46,696
يجب ان يضبط قبل بدء الحفل

1044
01:05:47,266 --> 01:05:50,706
لكن مكان السيد [مولر] لا يزال مجهولاً بعد

1045
01:05:50,706 --> 01:05:51,446
هذا صحيح

1046
01:05:51,706 --> 01:05:52,916
على كل حال يجب ان نُعلم السيد [دوموتو] بالأمر

1047
01:06:01,476 --> 01:06:02,796
يبدو انه ليس في الداخل

1048
01:06:03,376 --> 01:06:04,046
معك حق

1049
01:06:04,566 --> 01:06:06,536
ربمما ذهب لأحتساء الشاي

1050
01:06:07,416 --> 01:06:09,016
او ربما في ذلك المكان

1051
01:06:09,576 --> 01:06:12,546
هل تعلم انني مندهشة لانك لاحظتَ تلك النوتة ؟

1052
01:06:14,306 --> 01:06:16,046
اذاني حادتا السمع

1053
01:06:16,626 --> 01:06:18,056
وصفهما بالحادتين لن يفيهما حقهما

1054
01:06:18,486 --> 01:06:21,306
أعتقد انك تمتلك موهبة الحس الموسيقي الفائق

1055
01:06:21,536 --> 01:06:22,666
أرجو ان يكون كلانك صحيحاً

1056
01:06:29,336 --> 01:06:31,416
يبدو ان السيد [دوموتو] ليس هنا ايضاً

1057
01:06:33,156 --> 01:06:35,466
هل عرفين اماكن أخرى قد يتواجد فيها ؟

1058
01:06:37,716 --> 01:06:38,896
لا ادري

1059
01:06:38,896 --> 01:06:41,016
ربما ذهب فعلاً لاحتساء الشاي كما قلت

1060
01:07:04,156 --> 01:07:06,756
ايتها السيدات والسادة, نرجو منكم الانتباه

1061
01:07:07,516 --> 01:07:11,486
رجاءً تذكروا ان التدخين ممنوع إلا في الاماكن المخصصة لذلك

1062
01:07:09,026 --> 01:07:10,676
ألم تحضر الآنسة [أكيببا] بعد ؟

1063
01:07:11,006 --> 01:07:11,536
كلا

1064
01:07:12,116 --> 01:07:13,936
اتصلت بها على هاتفها المحمو, ولكنها لا ترد

1065
01:07:14,626 --> 01:07:17,046
كما طلبت من الموظفين البحث عنها, ولكن

1066
01:07:17,046 --> 01:07:18,516
هل اختفت هي ايضاً ؟

1067
01:07:19,026 --> 01:07:19,836
لا ادري

1068
01:07:20,416 --> 01:07:22,466
السيد [مولر] اولاً والآن هي

1069
01:07:23,316 --> 01:07:24,816
لِمَ يحدث هذا بحق الله ؟

1070
01:07:25,206 --> 01:07:27,026
ما يزال هناك خمسة عشر دقيقة على بدء العرض

1071
01:07:27,756 --> 01:07:30,076
واذا لم تظهر قبل ذلك الحين

1072
01:07:30,076 --> 01:07:31,616
ارجوكم, دعوني اخذ مكانها

1073
01:07:33,676 --> 01:07:35,376
توقعت حصول هذا

1074
01:07:35,956 --> 01:07:39,166
نظراً لما حدث مع الآنسة [اكابي] مسبقاً

1075
01:07:39,846 --> 01:07:42,016
ولهذا كثفت من تدريباتي

1076
01:07:43,486 --> 01:07:44,296
ولكن

1077
01:07:46,096 --> 01:07:47,566
أرجوك يا معلمي

1078
01:07:47,876 --> 01:07:50,516
اعدك ان اغني افضل من الآنسة [اكيبا]

1079
01:07:50,516 --> 01:07:53,186
ليس هناك ما يدفعم للغناء افضل منها

1080
01:07:54,806 --> 01:07:57,786
فالموسيقى اشبه بحلقة وصل بين العقل والجسد

1081
01:07:59,096 --> 01:08:00,566
حاولي ان تجدي تلك الوصلة

1082
01:08:09,296 --> 01:08:11,576
لم يأتِ [شينتشي] إذن

1083
01:08:12,736 --> 01:08:15,016
والاهم من هذا, ماذا حل بـ [كونان] ؟

1084
01:08:15,206 --> 01:08:16,626
فالحفل على وشك ان يبدأ

1085
01:08:17,286 --> 01:08:20,076
فعلاً اين هو [كونان] الآن يا ترى ؟

1086
01:08:21,656 --> 01:08:23,596
لكن بما انه [كونان] فلا شك انه بخير

1087
01:08:23,966 --> 01:08:25,636
فأنا أثق به

1088
01:08:26,146 --> 01:08:26,966
انتِ معك حق

1089
01:08:27,456 --> 01:08:30,006
لقد وثق بنا [كونان]

1090
01:08:30,736 --> 01:08:31,486
علينا فعل الشيء نفسه

1091
01:08:33,526 --> 01:08:36,336
[كونان] سيكون بخير دون شك

1092
01:08:40,306 --> 01:08:42,586
سيداتي سادتي, نرجو الانتباه

1093
01:08:43,126 --> 01:08:46,876
نظراً لظروف غير متوقعة, فالآنسة [اكيبا رييكو]

1094
01:08:46,876 --> 01:08:48,796
لن تغني هذه الليلة

1095
01:08:51,506 --> 01:08:56,306
وستحل مكانها الآنسة [تشيغوسا رارا] خريجة الدفعة الناسعة لأكاديمية (دوموتو)

1096
01:08:57,156 --> 01:09:01,056
نرجو من حضارتكم تتفهم الامر

1097
01:09:01,836 --> 01:09:02,836
لماذا ؟

1098
01:09:03,126 --> 01:09:05,856
لقد غنت بشكل رائع جداً اثناء "البروفة" النهائية

1099
01:09:07,286 --> 01:09:09,846
أيعقل ان تكون هي و [شينتشي] في خطر ؟

1100
01:09:19,426 --> 01:09:20,426
غطاء من " الفينيل" ؟

1101
01:09:20,786 --> 01:09:21,376
ماذا ؟

1102
01:09:32,616 --> 01:09:33,226
آنسة [رييكو]

1103
01:09:33,406 --> 01:09:33,976
انسة [رييكو]

1104
01:09:40,826 --> 01:09:41,276
ماذا ؟

1105
01:09:42,676 --> 01:09:44,376
اين نحن الآن ؟

1106
01:09:44,796 --> 01:09:46,236
اعتقد اننا في مجرى القناة

1107
01:09:47,446 --> 01:09:49,376
المجرم الذي هاجمنا

1108
01:09:49,386 --> 01:09:52,516
وضعنا في قارب ثم جعله يطفو في البحيرة التي خلف
قاعة دوموتو بحيث تجرفة المياه إلى مجرى القناة

1109
01:09:53,136 --> 01:09:54,646
من فعلها يا ترى ؟

1110
01:09:55,266 --> 01:09:56,006
لا اعلم

1111
01:09:57,396 --> 01:10:01,226
وفوق ذلك, لماذا تكبد عناء وضعنا في القارب بعد ان افقدنا الوعي ؟

1112
01:10:01,646 --> 01:10:03,806
على كل حال علينا الإسراع في العودة

1113
01:10:03,806 --> 01:10:04,506
وإلا فأن الحفل

1114
01:10:04,966 --> 01:10:07,426
ولكن حتى لو سبحنا إلى هناك

1115
01:10:07,426 --> 01:10:09,436
فالسور إعلى من ان نستطيع تسلقه

1116
01:10:24,716 --> 01:10:26,146
لا احد في الجوار

1117
01:10:28,536 --> 01:10:29,506
لكن انظر هناك

1118
01:10:29,516 --> 01:10:31,386
هناك هاتف مثبت على ذلك الجدار

1119
01:10:33,406 --> 01:10:35,886
إذا تمكنا من الوصول إله, فسيكون بمقدورنا طلب المساعدة

1120
01:10:37,166 --> 01:10:37,976
لحظة

1121
01:10:38,696 --> 01:10:40,506
ليس مهماً ان نصل إلى الهاتف

1122
01:10:40,506 --> 01:10:42,606
إذا تمكنا من رفع السماعة فقط, فسيكون عندئذٍ قادرين على طلب المساعة

1123
01:10:43,176 --> 01:10:44,816
وكيف سنفعل ذلك ؟

1124
01:10:45,616 --> 01:10:47,836
عندما تضغطين أزرار الهاتف لطلب رقم ما

1125
01:10:47,836 --> 01:10:49,516
تصدر النغمات "بي" , "بو" , " با" من الازرار

1126
01:10:49,946 --> 01:10:52,816
DTMF تلك النغمات تعرف باشارة

1127
01:10:53,316 --> 01:10:56,136
وتستخدم فيها تركيبة من نغمة عالية وأخرة منخفضة, بترددات معينة

1128
01:10:56,136 --> 01:10:58,066
حتى يتم نقل رقم الهاتف المطلوب

1129
01:10:59,296 --> 01:11:01,916
إي اننا لو نجحنا في إصدار تلك الاصوات

1130
01:11:01,916 --> 01:11:03,626
يمكننا عندها اجراء المكالمة

1131
01:11:04,976 --> 01:11:10,006
الرقم 1 في هاتف الطوارئ 110 يتكون من نغمة
ترددها  المنخفض 697 هرتز والعالي 1209 هرتز

1132
01:11:10,546 --> 01:11:16,356
اما الرقم 0 فيتكون من نغمة ترددها 941 و 1336 هرتز على التوالي

1133
01:11:16,776 --> 01:11:17,456
حسنٌ

1134
01:11:17,826 --> 01:11:20,356
بأمكاني تذكر نغمات أزرار الهاتف

1135
01:11:21,086 --> 01:11:23,326
لكن قبل ذلك علينا رفع تلك السماعة

1136
01:11:23,836 --> 01:11:24,876
دعي الامر لي

1137
01:11:25,846 --> 01:11:29,426
لكن المشكلة  تكمن في ان هناك زمناً قصيراً لإجراء الاتصال بعد رفع السماعة

1138
01:11:29,746 --> 01:11:31,786
وبعدها لن نستطيع ابداً إجراء اية مكالمة

1139
01:11:32,616 --> 01:11:34,746
أي ان امانا فرصة واحدة فقط لطلب الرقم

1140
01:11:35,316 --> 01:11:39,296
وإذا فشلنا فسنضطر للانتظار إلى ان يجدنا احدهم

1141
01:11:39,976 --> 01:11:41,486
ليس لدينا وقت نضيعه

1142
01:11:41,946 --> 01:11:43,036
فلنفعل ذلك

1143
01:11:45,086 --> 01:11:46,226
بما اننا عرفنا الامر

1144
01:11:46,226 --> 01:11:47,886
دعينا نقم بتجربة سريعة اولاً

1145
01:11:50,756 --> 01:11:51,766
ما ذلك الصوت

1146
01:11:52,186 --> 01:11:52,796
إنفجار ؟

1147
01:11:53,486 --> 01:11:54,406
شيءٌ ما قد انفجر

1148
01:11:57,096 --> 01:11:58,456
الصوت قادمٌ من جهة قاعة (دوموتو)

1149
01:11:59,676 --> 01:12:00,226
هل يعقل

1150
01:12:10,436 --> 01:12:12,596
نحن الان في موقع الحدث وتحديداً عند غابات مدينة (نيشيتاما) الموسيقية

1151
01:12:13,176 --> 01:12:17,296
قبل لحظات وقع انفجارات عند قاعة (دوموتو) الموسيقية

1152
01:12:18,256 --> 01:12:20,236
{\be1}The explosions were at the innermost section on the left and…

1153
01:12:20,236 --> 01:12:22,516
وعند باب المسرح في القسم الاوسط من الناحية اليمنى

1154
01:12:22,726 --> 01:12:24,676
بدأ الحفل الموسيقي قبل خمس دقائق

1155
01:12:24,676 --> 01:12:25,396
والوضع بالداخل لا يزال

1156
01:12:31,486 --> 01:12:32,166
انفجار اخر

1157
01:12:32,486 --> 01:12:34,006
بسرعة نغمة الرقم 0

1158
01:12:41,676 --> 01:12:42,256
هذا سيفي بالغرض

1159
01:12:42,986 --> 01:12:43,756
لنحرك القارب اولاً

1160
01:12:53,426 --> 01:12:54,326
هذا يكفي

1161
01:12:54,326 --> 01:12:54,976
اوقفي القارب

1162
01:12:58,076 --> 01:13:00,396
والآن كيف سنرفع السماعة ؟

1163
01:13:00,776 --> 01:13:01,696
انتظري وسترين

1164
01:13:15,986 --> 01:13:16,636
رائع

1165
01:13:17,206 --> 01:13:17,806
هيا بنا

1166
01:13:26,716 --> 01:13:29,396
مرحبا, هنا مركز 110 لطلب النجدة

1167
01:13:34,216 --> 01:13:35,686
ماذا؟ الآنسة [اكيبا] و [كونان] ؟

1168
01:13:36,216 --> 01:13:36,446
أجل

1169
01:13:37,296 --> 01:13:41,656
يبدو ان احدهم قد افقدهما الوعي, ثم وضعهما
في قارب, فانجرفا بعدها إلى مجرى القناة

1170
01:13:42,256 --> 01:13:45,746
الموقع  هو مدينة (نيشيتاما), بالقرب من مركز (نيشيتاما) للتحكم بتصريف مياه السدود

1171
01:13:51,106 --> 01:13:51,796
ها قد اتو

1172
01:13:54,986 --> 01:13:56,076
ها هما هناك

1173
01:13:56,086 --> 01:13:56,766
في الاسفل

1174
01:14:05,786 --> 01:14:07,156
كما توقعنا, كانت قاعة (دوموتو) إذن

1175
01:14:08,336 --> 01:14:10,636
وقعت اكثر من عشرة انفجارات حتى الآن

1176
01:14:10,636 --> 01:14:12,946
وجميعها استهدفت الاعمدة الخارجية للقاعة

1177
01:14:12,946 --> 01:14:14,106
والفاعل لا يزال

1178
01:14:14,536 --> 01:14:16,506
احدهم زرع القنابل هناك

1179
01:14:17,196 --> 01:14:19,636
ورغم اننا ما نزال نجهل إن كانت تلك القنابلمؤقتة او تنفجر عن بعد

1180
01:14:20,366 --> 01:14:24,086
فهناك احتمال كبير بأننا نواجه نفس الشخص المسؤول عن مقتل الموسيقيين الاربعة

1181
01:14:24,556 --> 01:14:25,546
بالضبط

1182
01:14:25,546 --> 01:14:27,846
الحادثة الاولى كانت انفجاراً ايضاً

1183
01:14:28,926 --> 01:14:29,606
ولكن

1184
01:14:30,256 --> 01:14:33,606
لماذا لم يقتلنا نحن ايضاً عوضاً عن إرسالنا بعيداً عن قاعة الحفل ؟

1185
01:14:36,636 --> 01:14:37,606
ايعقل انها...؟

1186
01:14:43,596 --> 01:14:44,336
انفجار اخر

1187
01:14:44,876 --> 01:14:45,436
اخبروني

1188
01:14:46,226 --> 01:14:47,616
الا يمكنكم الاتصال باحد داخل القاعة ؟

1189
01:14:48,196 --> 01:14:49,796
[ران] العم والآخرون موجودين هناك

1190
01:14:50,036 --> 01:14:52,126
هذا غير ممكن الان

1191
01:14:52,666 --> 01:14:54,336
فقد قطع المجرم خطوط الهاتف

1192
01:14:54,756 --> 01:14:56,056
ماذا عن الهواتف المحمولة ؟

1193
01:14:56,056 --> 01:14:56,676
لا فائدة

1194
01:14:57,996 --> 01:15:00,546
فأصول اللباقة تحتم عليك إقفال الهاتف المحمول اثناء الحفل الموسيقي

1195
01:15:00,966 --> 01:15:03,306
ناهيكم عن كون الارسال داخل القاعة ممكنا في منطقة واحد فقط

1196
01:15:03,906 --> 01:15:07,096
اعتقد ان الوضع لا يزال آمنا في الداخل

1197
01:15:08,816 --> 01:15:12,286
فالقسم الداخلي لقاعة الحفل عازل للصوت ومقاوم للحرائق

1198
01:15:13,216 --> 01:15:16,036
وأغلب الظن, بأنهم لم يشعروا بالانفجارات بعد

1199
01:15:17,666 --> 01:15:19,856
إذ كان الامر كذلك فالحفل مايزال مستمر اذن

1200
01:15:20,266 --> 01:15:20,926
أجل

1201
01:15:20,926 --> 01:15:21,996
هذا ما اعتقده

1202
01:15:22,436 --> 01:15:25,456
لكن, من المستحيل ان تبقى الانفجارات مقتصرة على القسم الخارجي فقط

1203
01:15:26,576 --> 01:15:27,506
لانها ستطال القسم الداخلي

1204
01:15:28,336 --> 01:15:28,836
كلا

1205
01:15:29,636 --> 01:15:31,056
ربما تكون قد طالته فعلاً

1206
01:15:33,306 --> 01:15:33,806
[ران]

1207
01:17:02,356 --> 01:17:03,746
سيداتي سادتي, طاب مساؤكم

1208
01:17:04,246 --> 01:17:06,296
نرحب بكم ترحيباً حاراً

1209
01:17:07,036 --> 01:17:08,616
اسمي [دوموتو كازوكي]

1210
01:17:11,556 --> 01:17:15,546
كما تعلمون جميعاً, ففي هذه القاعة الخاصة في هذه الليلة
الاستثنائية, وفي حضرة هذه " الاروغَن" الانبوبي

1211
01:17:17,076 --> 01:17:17,996
اسرع

1212
01:17:17,996 --> 01:17:18,846
بسرعة إلى هنا

1213
01:17:19,356 --> 01:17:20,206
ماذا تفعل عندك ؟

1214
01:17:20,516 --> 01:17:21,926
اسرع واجلب الخراطيم إلى هنا

1215
01:17:32,666 --> 01:17:33,366
الوضع سيء

1216
01:17:33,776 --> 01:17:36,496
القسم الاوسط لم يتضرر بعد على ما يبدو

1217
01:17:37,066 --> 01:17:38,956
لا بد ان الناس هناك ما يزالون بخير

1218
01:17:39,386 --> 01:17:40,816
لا يزال الوقت مبكراً على تنفس الصعداء

1219
01:17:42,006 --> 01:17:44,756
جميع الممرات الموصلة للخارج قد انسدت

1220
01:17:45,226 --> 01:17:46,506
اي ان عملية الانقاذ مستحيلة

1221
01:17:46,786 --> 01:17:47,486
مستحيل

1222
01:17:47,906 --> 01:17:51,156
وفوق ذلك, لا نزال نجهل العمود المستهدف في الانفجار التالي

1223
01:17:51,776 --> 01:17:54,326
هناك ثلاثة وعشرون عموداً في الجهة الخارجية

1224
01:17:54,826 --> 01:17:56,936
ربما يخطط لتفجيرها كلها

1225
01:17:57,416 --> 01:17:59,156
تباً ! ماذا عليما ان نفعل إذن ؟

1226
01:18:00,126 --> 01:18:01,866
بإمكاننا الدخول من السطح فقط

1227
01:18:03,046 --> 01:18:03,756
هل هذا ممكن ؟

1228
01:18:04,106 --> 01:18:05,446
يبدو ممكناً حتى هذه اللحظة

1229
01:18:06,236 --> 01:18:08,966
ولكن ليس هناك مهبط مناسب للمروحية

1230
01:18:09,356 --> 01:18:11,876
ولا نعرف إذا كان السطح قادراً على تحمل وزن المروحية

1231
01:18:12,336 --> 01:18:13,036
حسنٌ إذن

1232
01:18:13,686 --> 01:18:15,736
جاول ان تهبط إلى اقل ارتفاع  ممكن عن السطح

1233
01:18:16,276 --> 01:18:17,356
ونحن سنقفز

1234
01:18:18,716 --> 01:18:20,026
سأدلكم على ا لطريق

1235
01:18:21,156 --> 01:18:24,306
لان الطريق من السطح إلى الطابق الرابع معقد للغاية

1236
01:18:24,516 --> 01:18:25,206
ولذلك

1237
01:18:25,866 --> 01:18:26,956
لكن هذا

1238
01:18:26,956 --> 01:18:28,536
ليس هذا وقتاً للجدال

1239
01:18:28,996 --> 01:18:31,466
علينا ان نسرع طالما  ان الانفجارات متوقفة الان

1240
01:18:37,466 --> 01:18:38,396
انخفض لأرتفاع أقل

1241
01:18:40,016 --> 01:18:40,696
انخفض اكثر

1242
01:18:41,696 --> 01:18:42,566
قليلاً بعد

1243
01:18:45,036 --> 01:18:45,926
قليلاً بعد

1244
01:18:47,396 --> 01:18:48,596
لا يمكنني الانخفاض اكثر

1245
01:18:48,946 --> 01:18:50,876
فالاتضطرابات الهوائية أسوأ مما كنت اتوقعه

1246
01:18:50,876 --> 01:18:51,916
لا استطيع ابقائها ثابتة

1247
01:18:53,466 --> 01:18:55,006
إذا ارتم الخروج, فأفعلوها الآن

1248
01:18:58,876 --> 01:19:00,096
هيا بنا آنسة [اكيبا]

1249
01:19:06,956 --> 01:19:09,656
وانت يا [كونان], ابقَ في المروحية و

1250
01:19:10,676 --> 01:19:11,526
[كونان]

1251
01:19:12,216 --> 01:19:13,476
سأبقى معكم

1252
01:19:13,786 --> 01:19:16,336
إلى ان يتم إنقاذ [ران] والآخرون ايضاً

1253
01:19:16,766 --> 01:19:17,486
[كونان]

1254
01:19:18,056 --> 01:19:19,956
كما أنني رأيت وجه المجرم

1255
01:19:21,656 --> 01:19:23,356
ورغم اننا لا نزال نجهل المسؤول عن هذه الانفجارات

1256
01:19:23,896 --> 01:19:25,536
إلا انني رأيت من هاجمنا

1257
01:19:26,306 --> 01:19:28,376
ألا يُحتمل ان يكون داخل القاعة الآن

1258
01:19:28,386 --> 01:19:28,716
لهذا

1259
01:19:32,276 --> 01:19:33,896
بسرعة لا يمكنني الصمود اكثر

1260
01:19:34,426 --> 01:19:36,576
لا خيار امامنا, نحن مضطرون لأخذه معنا

1261
01:19:37,156 --> 01:19:38,456
اسرع يا [تاكاغي]

1262
01:19:38,716 --> 01:19:39,106
حسنٌ

1263
01:19:57,876 --> 01:19:59,466
هذا احد ممرات الطابق الرابع الداخلية

1264
01:20:00,196 --> 01:20:03,216
ولكننا وصلنا مباشرة من السطح إلى هنا

1265
01:20:03,846 --> 01:20:06,086
لو لم اقل لكم ذلك لما سمحتم لي بالمجئ معكم

1266
01:20:06,556 --> 01:20:07,606
والحال نفسه ينطبق على هذا الصبي

1267
01:20:09,246 --> 01:20:11,816
هل رأيت وجه المجرم حقاً؟

1268
01:20:30,886 --> 01:20:31,966
يا لها من مفاجأة

1269
01:20:32,546 --> 01:20:36,216
حسبناه مجرد أحتمال, لكن ان يكونو فعلاً لم يشعروا بشيئ

1270
01:20:36,796 --> 01:20:37,336
أجل

1271
01:20:38,036 --> 01:20:39,966
على كل حال, فالنبحث عن القنابل

1272
01:20:40,546 --> 01:20:43,516
من الصعب إخلاء القاعة من كل هذا الجمع اغفير من الناس

1273
01:20:44,146 --> 01:20:46,966
وفوق هذا, إن كان تدمير هذه القاعة هو هدف المجرم الرئيسي

1274
01:20:47,496 --> 01:20:50,326
فلا بد ان القنابل مزروعة هنا ايضاً

1275
01:20:50,896 --> 01:20:51,636
فهمت

1276
01:20:52,246 --> 01:20:55,646
[كونان] ستبقى هنا مع الآنسة[اكيبا]

1277
01:20:55,856 --> 01:20:56,556
حسنٌ

1278
01:20:56,966 --> 01:20:57,666
فالنذهب

1279
01:20:57,666 --> 01:20:58,186
أجل

1280
01:21:07,616 --> 01:21:08,336
[ران]

1281
01:21:10,676 --> 01:21:11,656
انتظريني

1282
01:21:21,226 --> 01:21:22,026
ما الذي يجري ؟

1283
01:21:22,456 --> 01:21:23,936
كيف الوضع في الداخل  ؟

1284
01:22:02,806 --> 01:22:05,936
المجرم يعرف تصميم هذه القاعة جيداً

1285
01:22:06,286 --> 01:22:08,186
وعلى هذا الاساس زرع قنابله

1286
01:22:10,306 --> 01:22:12,756
ربما يكون احد العاملين هنا

1287
01:22:16,226 --> 01:22:18,106
تلك النوتة غريبة فعلاً

1288
01:22:19,276 --> 01:22:20,596
حتى السيد [دوموتو] لم يلاحظها

1289
01:22:21,086 --> 01:22:22,896
ربما كان سيلاحظها لو صدرت من البيانو

1290
01:22:23,436 --> 01:22:27,066
فهو يعزف على "الاورغن" من سنتين فقط ولهذا
هو غير قادر ربما على ملاحظة هذا الاختلاف

1291
01:22:28,786 --> 01:22:29,826
الاختلاف في النغمات

1292
01:22:30,446 --> 01:22:33,486
"زمرة من الهواة, لا يستطيعو التفريق بين النغمات"

1293
01:22:34,276 --> 01:22:35,546
هذا ما قصدته إذن

1294
01:22:36,206 --> 01:22:37,926
الآنسة [كابي] لاحظت الاختلاف

1295
01:22:38,346 --> 01:22:39,896
لانها تمتلك موهبة الحس الموسيقي الفائق

1296
01:22:40,516 --> 01:22:41,276
لحظة

1297
01:22:41,726 --> 01:22:42,986
لماذا اذن قام ذلك الشخص بــ .. ؟

1298
01:22:44,006 --> 01:22:45,786
ايعقل ان ذلك الشخص .. ؟

1299
01:22:47,176 --> 01:22:48,096
ان كانت القضية هكذا

1300
01:22:49,376 --> 01:22:50,226
لماذا هي

1301
01:22:55,366 --> 01:22:58,436
والدته لم تتزوج غير والده

1302
01:22:59,396 --> 01:23:01,866
فهمت هكذا إذن

1303
01:23:02,366 --> 01:23:05,846
لكن ما علاقة النوتة الغريبة بالانفجارات ؟

1304
01:23:09,136 --> 01:23:11,196
بالمناسبة تذكرت شيئاً

1305
01:23:11,846 --> 01:23:13,736
الوقت الذي توقفت فيه الانفجارات

1306
01:23:14,376 --> 01:23:17,166
كان عندما القى السيد [دوموتو] كلمته

1307
01:23:18,236 --> 01:23:21,186
ربما يُريد المجرم ان يلحظ الناس أمر الانفجارات

1308
01:23:22,066 --> 01:23:23,496
كلا ليس هذا هو السبب

1309
01:23:24,226 --> 01:23:26,276
الانفجارات لا تحدث إلا اثناء العرض الموسيقي

1310
01:23:27,366 --> 01:23:29,796
فهمت.. لهذا بدت تلك النوتة غريبة

1311
01:23:31,616 --> 01:23:32,466
تلك النوتة مجدداً

1312
01:23:33,926 --> 01:23:35,406
كم مرة صدرت تلك النوتة

1313
01:23:36,416 --> 01:23:38,036
منذ بداية الحفل حتى هذه اللحظة

1314
01:23:38,496 --> 01:23:40,366
هل تعرفين كم مرة صدرت تلك النوتة الغريبة ؟

1315
01:23:40,746 --> 01:23:42,096
اعتقد انها صدرت

1316
01:23:42,556 --> 01:23:44,326
 الاولى Ave Marai مرتين اثناء مقطوعة

1317
01:23:49,056 --> 01:23:50,596
التي تلتها Cantata كما صدرت اثناء مقطوعة

1318
01:23:51,926 --> 01:23:52,956
عشر مرات

1319
01:24:05,116 --> 01:24:07,886
وثمان مرات اثناء المقطوعة الحالية

1320
01:24:08,416 --> 01:24:09,726
مجموعها عشرون

1321
01:24:10,176 --> 01:24:12,226
هذا يعني انه مايزال هناك اربعة انفجارات

1322
01:24:14,146 --> 01:24:16,436
الانفجارات مرتبطة بتلك النوتة من دون شك

1323
01:24:16,936 --> 01:24:20,836
لهذا لم تحدث أي انفجارات أثناء كلمة السيد [دوموتو]

1324
01:24:32,296 --> 01:24:34,756
هناك ثلاثة وعشرون عموداً في الجهة الخارجية لقاعة الحفل

1325
01:24:35,246 --> 01:24:35,766
بعبارة أُخرى

1326
01:24:36,266 --> 01:24:38,256
فإن تدمير جميع الاعمدة

1327
01:24:38,256 --> 01:24:39,596
إضافة إلى القسم الداخلي لهذه القاعة

1328
01:24:40,026 --> 01:24:42,216
يستلزم 24 انفجاراً

1329
01:24:45,816 --> 01:24:46,666
هذا يعني

1330
01:24:48,776 --> 01:24:49,436
تماماً

1331
01:24:52,166 --> 01:24:55,446
إذا لم نوقف العرض قبل صدور النوتة الغريبة
للمرة الرابعة إبتداءً من المرة القادمة

1332
01:24:56,066 --> 01:24:58,556
فإن  القنبلة التي في داخل القاعة ستنفجر

1333
01:25:07,946 --> 01:25:08,756
تلك النوتة مجدداً

1334
01:25:09,106 --> 01:25:10,136
تباً

1335
01:25:10,136 --> 01:25:12,146
الانفجارات مرتبطة فعلاً بتلك النوتة

1336
01:25:13,226 --> 01:25:15,426
لا بد ان المجرم يتابع ما يجري هنا عن كثب

1337
01:25:24,936 --> 01:25:25,696
مجدداً

1338
01:25:26,296 --> 01:25:27,326
وجدته

1339
01:25:28,326 --> 01:25:29,786
انه ذلك الشخص فعلاً

1340
01:25:32,856 --> 01:25:35,396
حسنٌ سأصعد على خشبة المسرح لأوقف العرض

1341
01:25:35,396 --> 01:25:35,746
إنتظري

1342
01:25:36,766 --> 01:25:37,696
إذا لم تحسني التصرف

1343
01:25:38,126 --> 01:25:39,556
فسيفجر المجرم القنابل بواسطة جهاز التحكم

1344
01:25:40,126 --> 01:25:42,726
لقد رأيت المجرم وكان بحوزته جهاز التحكم

1345
01:25:43,446 --> 01:25:44,056
ولكن

1346
01:25:44,696 --> 01:25:46,076
تباً مال العمل

1347
01:25:46,576 --> 01:25:49,396
أما من وسيلة لإيقاف العرض ؟

1348
01:25:50,326 --> 01:25:52,766
كيف سنبطل مفعول القنابل ؟

1349
01:25:54,396 --> 01:25:55,046
ثلاث دقائق

1350
01:25:56,976 --> 01:25:58,236
هل تكفيك ثلاث دقائق ؟

1351
01:26:00,026 --> 01:26:00,646
ولكن

1352
01:26:05,776 --> 01:26:08,166
سأترك لك الباقي ايها المتحري

1353
01:26:56,686 --> 01:26:58,016
انها المعلمة [رييكو]

1354
01:26:58,386 --> 01:26:59,336
تلك الاغنية

1355
01:26:59,806 --> 01:27:01,406
''Amazing Grace,'' انها اغنبية

1356
01:27:25,336 --> 01:27:26,576
مالذي تنوين فعله الآن

1357
01:29:47,086 --> 01:29:48,376
الشخص الذي كان يغني الاغنية في ذلك الوقت

1358
01:29:48,866 --> 01:29:50,856
انها الآنسة [رييكو]

1359
01:30:00,856 --> 01:30:03,256
كان يجب ان اقضي عليها في ذلك الوقت

1360
01:30:03,646 --> 01:30:04,566
لن اسمح لك

1361
01:30:06,606 --> 01:30:09,466
هذا الصوت يصدح بغناء يبث الدفء في القلوب

1362
01:30:11,006 --> 01:30:13,016
هو ما جعلك تتردد, اليس كذلك ؟

1363
01:30:14,576 --> 01:30:15,836
علاوة على ذلك, فإن هذه الاغنية

1364
01:30:16,376 --> 01:30:20,596
كانت المفضلة لأبنك السيد [سوما هيكارو]

1365
01:30:21,556 --> 01:30:25,936
والآنسة التي تغني الآن, كانت المرأة التي أحبها

1366
01:30:27,826 --> 01:30:29,386
الاساس الذي بنيت عليه استنتاجي

1367
01:30:29,396 --> 01:30:30,796
كانت تلك النوتة الغريبة

1368
01:30:31,416 --> 01:30:35,146
في البداية, ظننا ان سبب تلك النوتة الغريبة هي أحد الانابيب غير مضبوطة

1369
01:30:35,686 --> 01:30:37,236
لكن اتضح ان هذا ليس هو السبب

1370
01:30:38,746 --> 01:30:40,556
"بل لأن في أحد انابيب "الاروغَن

1371
01:30:41,106 --> 01:30:44,816
يوجد مستشعر صغير يسجل التغير الدقيق في تدفق الهواء

1372
01:30:45,396 --> 01:30:49,106
ولهذا كانت النوتة الصادرة من ذلك الانبوب غريبة نوعاً ما

1373
01:30:50,086 --> 01:30:53,666
وعندما يسجل المستشعر تغيراً في التدفق الهوائي داخل الانبوب

1374
01:30:55,576 --> 01:31:00,026
يرسل على الفور إشارات متسلسلة إلى القنابل التي زرعها
مسبقاً والتي ستنفجر باترتيب بعد إشارة

1375
01:31:04,736 --> 01:31:07,566
وعندما تنفجر القنبلة الاخيرة

1376
01:31:08,146 --> 01:31:10,276
سيتحقق الحلم الذي طالما أنتظرته, وهو تدمير هذه القاعة

1377
01:31:11,506 --> 01:31:13,676
لم يحدث إيُ انفجار أثناء البروفة النهائية

1378
01:31:14,216 --> 01:31:16,766
لأن المفجر لم يفعل بعد

1379
01:31:17,426 --> 01:31:18,516
أليس كذلك

1380
01:31:19,546 --> 01:31:23,236
يا مدير قاعة (دوموتو), والضابط السابق لإيقاع البيانو

1381
01:31:23,636 --> 01:31:25,106
السيد [فوا تاكومي] ؟

1382
01:31:31,776 --> 01:31:32,786
لا شيء هنا ايضاً

1383
01:31:33,256 --> 01:31:34,556
هذا ليس جيداً

1384
01:31:34,936 --> 01:31:37,926
إن بقينا على هذا المنوال, فستنفجر القنبلة قبل ان نحدد مكانها

1385
01:31:38,576 --> 01:31:39,276
اصمت

1386
01:31:42,706 --> 01:31:44,096
أنصت ! ما هذا ؟

1387
01:32:07,856 --> 01:32:08,586
لا تتحرك

1388
01:32:08,936 --> 01:32:09,676
هذه الشرطة

1389
01:32:11,956 --> 01:32:12,946
السيد [مولر]

1390
01:32:21,876 --> 01:32:24,966
كيف عرفت انني المجرم ؟

1391
01:32:25,526 --> 01:32:26,726
الحس الموسيقي الفائق

1392
01:32:27,716 --> 01:32:30,196
مع انك تمتلك تلك الموهبة

1393
01:32:30,806 --> 01:32:33,696
إلا انك لم تشر إلى النوتة الغريبة اثناء البروفة النهائية

1394
01:32:35,036 --> 01:32:37,406
هذا ما أثار شكوكي نحوك

1395
01:32:40,696 --> 01:32:41,786
هكذا إذن

1396
01:32:42,866 --> 01:32:45,576
وكيف عرفت إنني والد [هيكارو] ؟

1397
01:32:46,156 --> 01:32:49,576
"لوحة سيارتك رقمها .. " 83-52

1398
01:32:50,176 --> 01:32:52,836
لقد استوحيته من تاريخ ميلاد أبنك, اليس كذلك ؟

1399
01:32:54,606 --> 01:32:57,866
استخدمته كإقرار على صلتك بولدك الحبيب

1400
01:32:58,476 --> 01:33:00,516
لأنك لم تكن لتبوح بذلك أمام الملأ

1401
01:33:01,366 --> 01:33:05,686
إضافة لهذا ... الصورة التي في منزل السيد [دوموتو] حين كنت شاباً

1402
01:33:06,326 --> 01:33:07,776
أبنك يشبهك فيها تماماً

1403
01:33:12,656 --> 01:33:15,096
قتلت أولئك الموسيقيين الاربع

1404
01:33:15,556 --> 01:33:17,956
انتقاماً لأبنك الذي توفي في الحادثة

1405
01:33:18,956 --> 01:33:20,936
وتركت اجزاء "الفلوت" في مسرح الجريمة

1406
01:33:21,556 --> 01:33:25,426
لتحمل الشرطة على الاعتقاد ان سلسلة الجرائم قد انتهت بارتكاب الجريمة الثالثة

1407
01:33:26,756 --> 01:33:30,546
وتسببت بجروح بالغة للآنسة [كابي سوكو]

1408
01:33:31,326 --> 01:33:35,886
لأنك خشيت من أنها ستلاحظ النوتة الغريبة
كونها تمتلك موهبة الحس الموسيقي الفائق

1409
01:33:36,426 --> 01:33:39,016
الشخص الذي يخاف ممن يمتلكون هذه الموهبة لسبب كهذا

1410
01:33:39,396 --> 01:33:41,296
لا بد أن يكون لديه هذه الموهبة هو أيضاً

1411
01:33:42,416 --> 01:33:45,356
واستناداً على هذه النقطة فقط, فالمجرم
لا يمكن ان يكون غيرك انت يا سيد [فوا]

1412
01:33:48,206 --> 01:33:49,326
شيء آخر

1413
01:33:50,176 --> 01:33:52,696
الآنسة [اكيبا رييكو] تمتلك هذه الموهبة هي ايضاً

1414
01:34:01,126 --> 01:34:04,956
ولكن .. بما انها خطيبة ابنك الراحل

1415
01:34:05,886 --> 01:34:11,046
فلم تطاوعك نفسك على تعريضها لخطر المتفجرات
كما فعلت مع الآنسة [سوكو ] من قبل

1416
01:34:14,116 --> 01:34:17,166
لذك .. اخترت وضع مادة مهيجة في شربها

1417
01:34:17,726 --> 01:34:20,236
وهاجمتها  لاحقاً بشاحنة, ثم ببندقية هوائية

1418
01:34:20,686 --> 01:34:23,056
وذلك كي تمنعها من الظهور على خشبة المسرح

1419
01:34:23,706 --> 01:34:25,066
أردت ان تفقدها صوتها مؤقتاً

1420
01:34:25,526 --> 01:34:27,996
أو ان تكسر ساقها على الاقل

1421
01:35:09,286 --> 01:35:10,176
ذلك التناغم

1422
01:35:14,406 --> 01:35:15,226
النوتة

1423
01:35:28,856 --> 01:35:29,616
لماذا

1424
01:35:30,156 --> 01:35:30,866
لماذا لم .. ؟

1425
01:35:31,326 --> 01:35:32,686
لن تنفجر

1426
01:35:33,956 --> 01:35:35,876
قبل أن اتي إليك

1427
01:35:35,876 --> 01:35:39,056
قمت بإستخراج المستشعر من الانبوب

1428
01:35:39,466 --> 01:35:40,256
ثلاث دقائق

1429
01:35:40,776 --> 01:35:42,506
لا, بل تطلب ذلك دقيقتين فقط

1430
01:35:46,896 --> 01:35:48,326
عمل مميز أيها الطفل الصغير

1431
01:35:48,736 --> 01:35:50,346
هلا أخبرتني بإسمك مرة ثانية ؟

1432
01:35:51,426 --> 01:35:53,816
[إيدوغاوا كونان] .. متحرٍ

1433
01:35:57,286 --> 01:35:58,386
برافو

1434
01:35:58,636 --> 01:36:00,146
برافو

1435
01:36:00,436 --> 01:36:02,706
برافو .. برافو

1436
01:36:05,786 --> 01:36:06,286
ها هو هناك

1437
01:36:06,756 --> 01:36:07,866
يحمل جهاز التحكم عن بعد

1438
01:36:08,526 --> 01:36:09,996
إذن فقد كان هو بالفعل

1439
01:36:10,806 --> 01:36:11,656
ماذا يجب ان نفعل الآن ؟

1440
01:36:12,356 --> 01:36:14,246
هل نهجم عليه قبل ان يُفجر القنابل ؟

1441
01:36:14,246 --> 01:36:14,886
لن ينفع

1442
01:36:15,526 --> 01:36:18,266
إذا هاجمناه, فسيُفجر القنابل بواسطة جهاز التحكم

1443
01:36:19,096 --> 01:36:20,496
ماذا علينا ان نفعل إذن ؟

1444
01:36:22,816 --> 01:36:23,726
تلك الغرفة

1445
01:36:24,486 --> 01:36:26,756
ربما نستطيع فعل شيء من تلك الغرفة

1446
01:36:27,006 --> 01:36:27,896
مثل ماذا ؟

1447
01:36:29,016 --> 01:36:29,946
نطلق عليه النار

1448
01:36:30,436 --> 01:36:32,286
قبل ان يضغط على زر التفجير

1449
01:36:38,336 --> 01:36:39,936
لسوء حظك ايها المتحري الصغير

1450
01:36:40,826 --> 01:36:43,296
يإمكان جهاز التحكم ان يُفجر القنابل

1451
01:36:43,856 --> 01:36:45,256
لقد خسرت

1452
01:36:45,456 --> 01:36:46,266
من يدري ؟

1453
01:36:46,776 --> 01:36:48,176
لا يمكننا معرفة ذلك بعد

1454
01:36:50,446 --> 01:36:51,876
ما الذي لا تعرفة بعد ؟

1455
01:36:52,926 --> 01:36:55,896
صحيح أنني لا اعلم كيف دخلت القاعة

1456
01:36:56,686 --> 01:36:59,446
إلا ان الشرطة لم تقتحم المكان بعد

1457
01:36:59,926 --> 01:37:04,526
والقاعة تسبح الآن على الارجح في بحر من اللهب
ويستحيل الدخول إليها .. تماماً كما خططت

1458
01:37:06,296 --> 01:37:08,896
موضوع إزالة المستشعر كان هفوة مني فقط , لكن

1459
01:37:10,426 --> 01:37:11,326
لايهم

1460
01:37:11,796 --> 01:37:15,276
بإمكاني الآن على الاقل, إختيار لحظة الانفجار

1461
01:37:17,476 --> 01:37:18,916
وكهدية وداعٍ مني إليك

1462
01:37:19,476 --> 01:37:22,096
سأقتلك بينما تؤدي عرضك

1463
01:37:28,766 --> 01:37:30,056
تبا ! في ذلك الوقت

1464
01:37:31,356 --> 01:37:35,396
وذلك حالما تبدأ بالعزفِ على " اورغنك" العزيز يا

1465
01:37:36,476 --> 01:37:37,776
[دوموتو  كازوكي]

1466
01:37:47,586 --> 01:37:48,356
[كونان] ؟

1467
01:37:49,106 --> 01:37:50,116
لا فائدة

1468
01:37:50,116 --> 01:37:51,246
من الصعب إطلاق النار

1469
01:38:01,556 --> 01:38:02,546
انتهى الامر

1470
01:38:02,556 --> 01:38:05,396
هيا اسرع وابدأ عرضك الموسيقي يا [دوموتو]

1471
01:38:05,646 --> 01:38:06,306
ما العمل ؟

1472
01:38:06,886 --> 01:38:08,816
ليس بمقدوري استخدام ساعة التخدير

1473
01:38:09,536 --> 01:38:10,776
أما من حل آخر ؟

1474
01:38:13,716 --> 01:38:14,746
تنحَ جانباً يا [كونان]

1475
01:38:15,706 --> 01:38:16,486
ارجوك

1476
01:38:25,276 --> 01:38:25,926
أعطني إياها

1477
01:38:25,926 --> 01:38:27,166
ريكوردري

1478
01:38:27,986 --> 01:38:28,756
لقد عاد صوتي

1479
01:38:32,246 --> 01:38:33,756
أجل, كذا تماماً

1480
01:38:34,126 --> 01:38:34,676
مشكلة

1481
01:38:43,806 --> 01:38:45,406
الوداع أيها المتحري الصغير

1482
01:38:45,836 --> 01:38:46,536
لن اسمح لك

1483
01:38:53,536 --> 01:38:56,366
" مي - لا - لا - فا " ؟

1484
01:38:58,126 --> 01:38:58,856
{\be1}''SHOOT''?
طلقة

1485
01:38:59,046 --> 01:38:59,626
ستُطلق النار

1486
01:39:00,586 --> 01:39:01,546
ما ذاك الصوت ؟

1487
01:39:02,136 --> 01:39:04,086
إنه اللحن الذي يعلن نهاية هذه اللعبة

1488
01:39:04,586 --> 01:39:05,006
ماذا ؟

1489
01:39:17,876 --> 01:39:18,796
هنا الشرطة

1490
01:39:18,796 --> 01:39:19,276
لا تتحرك

1491
01:39:21,526 --> 01:39:22,876
لقد هُزمت

1492
01:40:15,646 --> 01:40:16,336
سيد [فوا]

1493
01:40:16,766 --> 01:40:17,846
أين القنبلة الأخيرة ؟

1494
01:40:18,316 --> 01:40:20,816
داخل السقف الموجود أعلى خشبة المسرح

1495
01:40:21,596 --> 01:40:23,636
[تاكاغي], أعلم المفتش بالأمر

1496
01:40:23,876 --> 01:40:24,416
حالاً

1497
01:40:25,486 --> 01:40:26,836
معذرة من فضلك

1498
01:40:27,616 --> 01:40:31,156
هلا سمحتم لي أن اكمل ما تبقى من العرض ؟

1499
01:40:31,676 --> 01:40:34,336
سأخبركم بكل شيء بعدها

1500
01:40:45,916 --> 01:40:46,646
فهمت

1501
01:40:47,136 --> 01:40:49,406
تم إخماد النيران أخيراً في هذه الناحية

1502
01:40:49,756 --> 01:40:50,756
سنكون عندكم بعد برهة

1503
01:40:50,756 --> 01:40:51,416
سيدي المفتش

1504
01:40:52,786 --> 01:40:54,526
عثرنا على فتحة في القسم الشرقي

1505
01:40:55,146 --> 01:40:55,916
حسنٌ  فلنذهب

1506
01:40:56,656 --> 01:40:57,586
سنأتي في الحال

1507
01:41:03,566 --> 01:41:04,286
أخبرني

1508
01:41:04,866 --> 01:41:07,326
لماذا زرعت القنابل في هذه القاعة بالذات ؟

1509
01:41:08,786 --> 01:41:11,476
طوال خمس وثلاثين سنة الماضية

1510
01:41:12,606 --> 01:41:15,256
كنت الوحيد الذي يضبط " البيانو" للسيد [دوموتو كازوكي]

1511
01:41:15,676 --> 01:41:17,626
عشنا هذه التجربة سوية بحلوها ومرها

1512
01:41:20,966 --> 01:41:22,336
وقبل عامين

1513
01:41:22,686 --> 01:41:25,516
اعتزل العزف على "البيانو" من دون اية مقدمات

1514
01:41:29,676 --> 01:41:30,686
قال لي وقتها

1515
01:41:31,186 --> 01:41:35,746
انه يتمنى ان أصبح مدير قاعة (دوموتو) والتي
كان سيكمل بناؤها في غضون سنتين

1516
01:41:36,326 --> 01:41:38,836
وبالطبع كنت قادراً على رفض طلبه

1517
01:41:39,496 --> 01:41:42,916
"فقد كنت حراً في تحديد مصيري كضابط لإيقاع " البيانو

1518
01:41:43,436 --> 01:41:51,366
ولكن عملي لخمسة وثلاثين عاماً كضابط "البيانو" الوحيد للسيد [دوموتو كازوكي] العازف الذي وصلت شهرته عنان السماء

1519
01:41:51,796 --> 01:41:55,466
لم يسمح لي أن أعمل مع عازفِ "بيانو" آخر

1520
01:41:56,026 --> 01:41:58,336
لقد منعني كبريائي من ذلك

1521
01:41:59,036 --> 01:42:02,126
سبق وقلتها مراراً لستُ سوى ميكانيكي بسيط

1522
01:42:02,516 --> 01:42:05,066
فإمكاناتي لا تؤهلني ابداً لكي اصبح مديراً

1523
01:42:05,566 --> 01:42:08,406
ولكنني استسلمت لليأس في نهاية المطاف

1524
01:42:46,406 --> 01:42:49,466
توفيت زوجتي قبل سنتين بسبب المرض

1525
01:42:50,046 --> 01:42:52,916
وبعدها بسنة مات إبني في حادث

1526
01:42:53,486 --> 01:42:59,346
كما فقدت وظيفتي كضابط "للبيانو" , وهو الشيء
الوحيد الذي كان قد بقيَ له معنة في حياتي

1527
01:42:59,906 --> 01:43:02,806
لقد خسرتُ  كل شيئ في هذه الحياة

1528
01:43:03,806 --> 01:43:06,266
حتى الموسيقى التي كنت اعشقها كثيراً

1529
01:43:06,796 --> 01:43:10,776
اصبحت مجرد اصواتٍ ناشزة تسبب لي الآلام

1530
01:43:14,826 --> 01:43:15,676
أجل

1531
01:43:16,056 --> 01:43:17,776
حتى في أحلامي كنت أسمعها

1532
01:43:18,316 --> 01:43:21,366
كانت تحول احلامي إلى كوابيس, ثم ذات ليلة أتخذت قراري

1533
01:43:22,246 --> 01:43:23,746
سأزيلهم جميعاً عن الوجود

1534
01:43:24,156 --> 01:43:25,816
سأمحوا كل شيء عن هذا الوجود

1535
01:43:26,996 --> 01:43:29,796
حتى تعود إلى الهيمنه على هذه الليلة الصامتة

1536
01:43:30,386 --> 01:43:33,266
سأمحو الأربعة الذين سرقوا حياة ابني

1537
01:43:33,266 --> 01:43:34,736
وذلك الأناني [دوموتو]

1538
01:43:34,736 --> 01:43:38,646
الذي فقد اهتمامه بـ  "البيانو" بسبب هذه "الاورغن" الانبوبي
وسأمحو هذه القاعة أيضاً

1539
01:43:39,136 --> 01:43:42,846
"وحتى الناس الذين اتوا ليستمعو إلى "الاورغن

1540
01:43:43,196 --> 01:43:47,106
والموسيقيين الذين جاؤوا إلى هنا من شتى بقاع الارض

1541
01:43:48,006 --> 01:43:53,186
قبلت العمل مديراً لقاعة (دوموتو) حتى اصل  إلى مرادي

1542
01:43:53,186 --> 01:43:54,656
"هو الوصول إلى هذه " الاورغن

1543
01:43:55,466 --> 01:43:57,816
وليسهل عليَّ كذلك زرع المتفجرات في القاعة

1544
01:43:57,816 --> 01:44:00,836
لهذا فقط وافقت على ان اصبح مديراً لهذه القاعة

1545
01:44:01,246 --> 01:44:06,016
[ما ذلك " البيانو" الذي هجرناه انا و [دوموتو
على حد سواء

1546
01:44:06,016 --> 01:44:07,566
فقد شعرت اتجاه بالشفقة

1547
01:44:08,216 --> 01:44:09,046
هذا يعني

1548
01:44:09,726 --> 01:44:12,716
تفجير "البيانو" في غرفة التدريب

1549
01:44:12,726 --> 01:44:15,006
كان طريقتك في إظهار حبك له

1550
01:44:15,856 --> 01:44:18,756
حسنٌ .. هذا كل مالدي لأقوله

1551
01:44:19,456 --> 01:44:20,236
والآن

1552
01:44:23,946 --> 01:44:25,906
والان استعدوا (دوموتو) حالاً

1553
01:44:26,386 --> 01:44:27,956
سيد [فوا], إهدأ

1554
01:44:28,436 --> 01:44:29,366
لا تخافوا

1555
01:44:29,746 --> 01:44:31,226
سأقدم على الانتحار فقط

1556
01:44:31,646 --> 01:44:33,696
ليس لدي اية نية في إيذاء احد

1557
01:44:34,526 --> 01:44:36,916
[كونان] غادر هذه الغرفة بسرعة رجاءً

1558
01:44:37,116 --> 01:44:37,796
لن اغادر

1559
01:44:38,056 --> 01:44:39,486
ارتكبت تلك الافعال الشنيعة

1560
01:44:39,746 --> 01:44:41,636
وتريد الموت قبل ان تكفر عنها ؟

1561
01:44:41,986 --> 01:44:43,556
لن ادعك تتمادى في الظلم

1562
01:44:43,556 --> 01:44:44,566
[كونان]

1563
01:44:44,746 --> 01:44:46,766
لا تفعل شيئاً تندم عليه يا سيد [فوا]

1564
01:44:47,086 --> 01:44:48,066
أصمت

1565
01:44:48,076 --> 01:44:49,406
استدعوا[دوموتو] الآن

1566
01:44:49,826 --> 01:44:50,526
[فوا]

1567
01:44:52,586 --> 01:44:54,286
ها قد جئت لرؤيتك

1568
01:44:57,146 --> 01:44:57,996
سيد [دوموتو]

1569
01:45:02,246 --> 01:45:04,136
[فوا] انا اسف حقاً

1570
01:45:04,526 --> 01:45:07,666
لم أتخيل ابداً ان عدم إظهار امتنناي لك, سيجعلك تعاني كل هذه المعاناة

1571
01:45:08,076 --> 01:45:09,276
هل ادركت هذا اخيراً ؟

1572
01:45:09,626 --> 01:45:11,866
بسبب انانيتك كنت في غاية

1573
01:45:11,866 --> 01:45:13,596
الامر ليس كما نظن يا [فوا]

1574
01:45:14,036 --> 01:45:16,936
"اعتزلت مهنة العزف على "البيانو

1575
01:45:16,936 --> 01:45:21,226
لأنني لاحظت ان ضبطك له بدأ يفلت منك شيئاً فئيئاً

1576
01:45:22,936 --> 01:45:24,816
أخذت كبرياءك بالحسبان

1577
01:45:24,816 --> 01:45:26,786
ففضلت ان لا اخبرك بالأمر

1578
01:45:27,556 --> 01:45:31,856
وما زلت أرفض العمل مع ضابط آخر, حتى بعدما أخبرتك بالسبب

1579
01:45:32,716 --> 01:45:35,546
لهذا السبب فقط, اتزلت العزف على البيانو

1580
01:45:35,556 --> 01:45:36,586
هراء

1581
01:45:36,586 --> 01:45:38,386
انا امتلك حساً موسيقياً فائقاً

1582
01:45:38,386 --> 01:45:41,546
بالتأكيد, ولا احد ينكر امتلاكك لهذه الموهبة

1583
01:45:41,856 --> 01:45:45,466
لكن ومع تقدمك في السن ضعف سمعك

1584
01:45:46,116 --> 01:45:50,986
لدرجة ان اللحن خرج عن الايقاع مرات عديدة دون ان تلحظ ذلك

1585
01:45:53,766 --> 01:45:56,996
كذب

1586
01:45:57,606 --> 01:46:02,586
لو كنت أعلم ان هذا سيحصل,  لكنت أخبرتك بالحقيقة حينها

1587
01:46:02,936 --> 01:46:05,076
انا حقاً اسف

1588
01:46:05,076 --> 01:46:06,596
فات الاوان على تقديم الاعتذارات

1589
01:46:06,596 --> 01:46:08,166
كل ما حدث كان بسببك

1590
01:46:08,166 --> 01:46:08,936
هذا ليس صحيحاً

1591
01:46:10,676 --> 01:46:14,166
لو ان صديقة عزيزة علي فعلت الشيء نفسه معي

1592
01:46:14,706 --> 01:46:18,136
لالتمست لها مئة عذر على فعلتها

1593
01:46:19,016 --> 01:46:26,096
فلربما رأت في ذلك فائدة لم أرها أنا, فتكون بهذا قد أثرت
على نفسخا بتفضيل مصلحتي على مصلحتها الشخصية

1594
01:46:26,666 --> 01:46:28,356
هذا ما كنت سأفعله

1595
01:46:29,286 --> 01:46:30,316
والسبب

1596
01:46:31,666 --> 01:46:33,656
إنني أثِق بصديقتي

1597
01:46:35,436 --> 01:46:36,816
وأنا ايضاً ذلك

1598
01:47:05,806 --> 01:47:08,316
لا أصدق ان كل هذه الانفجارات قد وقعت في الخارج

1599
01:47:08,656 --> 01:47:10,596
لم أشعر بأس شيء على الإطلاق

1600
01:47:11,326 --> 01:47:13,996
ويبدو ان [كونان] قد لعب دوراً مهما مجدداً

1601
01:47:14,496 --> 01:47:17,746
كنت أعلم, الم اقل لكم ذلك ؟

1602
01:47:18,366 --> 01:47:23,246
انا مندهش حقاً من قدرة [شينتشي] على فهم شفرة " الريكوردر" بسرعة

1603
01:47:23,866 --> 01:47:26,176
استبدال النوتة باحرف من الابجدية

1604
01:47:26,516 --> 01:47:28,586
شيء تجده في كثير من روايات المتحرين

1605
01:47:29,026 --> 01:47:31,886
.."H" على الرغم من ان النوتة "سي" في التدوين الالماني ترمز إلى الحرف

1606
01:47:32,666 --> 01:47:36,616
إلا انه أخذ بالحسبان بأن بريطانية

1607
01:47:36,966 --> 01:47:40,996
في النوتة " سي" لانه علم أنني استخدم التدوين البريطاني "B" فأستخدم الحرف

1608
01:47:41,376 --> 01:47:43,326
عندما أعلم انه سيفهم ما اقصده فواً

1609
01:47:43,986 --> 01:47:47,796
لقد اعتمدت ايضاً على حسّه الموسيقي الفائق

1610
01:47:47,796 --> 01:47:48,996
هكذا إذن

1611
01:47:49,996 --> 01:47:52,626
والاهم من ذلك, فأنا أثق به

1612
01:47:53,706 --> 01:47:54,956
كوني شريكته

1613
01:47:57,596 --> 01:48:01,426
وانا الذي كنت متأكداً  ان المجرم هو شبيه (بيتهوفن)

1614
01:48:01,676 --> 01:48:03,616
أبي, أما زلت تقول هذا الكلام ؟

1615
01:48:04,226 --> 01:48:07,296
لم يأتِ في النهاية إذن

1616
01:48:07,296 --> 01:48:08,536
مهوس التحريات ذلك

1617
01:48:08,856 --> 01:48:10,116
تقصدين [شينتشبي]

1618
01:48:10,486 --> 01:48:12,116
لا يهمني أمره على الإطلاق

1619
01:48:12,736 --> 01:48:13,936
هيا بنا يا [كونان]

1620
01:48:14,726 --> 01:48:15,446
ماذا ؟

1621
01:48:15,456 --> 01:48:17,106
كان هنا قبل لحظات

1622
01:48:20,266 --> 01:48:20,796
ماذا ؟

1623
01:48:26,416 --> 01:48:26,946
اسمعي

1624
01:48:27,236 --> 01:48:28,046
هذا الصوت

1625
01:48:31,406 --> 01:48:32,296
صوت كمان

1626
01:48:32,836 --> 01:48:34,426
أليس كذلك ؟ ''Amazing Grace,'' لحن

1627
01:48:34,776 --> 01:48:36,976
ليس هذا ما اعنيه, بل اعني اسلوب العزف

1628
01:48:37,286 --> 01:48:37,926
اسلوب العزف ؟

1629
01:48:40,446 --> 01:48:41,356
[شينتشي]

1630
01:48:43,046 --> 01:48:43,726
انظري يا [ران]

1631
01:49:00,686 --> 01:49:01,656
[شينتشي]

1632
01:49:02,656 --> 01:49:03,776
[شينتشي]

1633
01:49:05,496 --> 01:49:07,466
غادر [شينتشي] منذ برهة

1634
01:49:09,016 --> 01:49:09,756
[كونان]

1635
01:49:10,136 --> 01:49:11,096
قال إن عنده قضيه مهمة

1636
01:49:11,916 --> 01:49:13,636
هل أتى [شينتشي]؟

1637
01:49:13,896 --> 01:49:14,526
أجل

1638
01:49:15,556 --> 01:49:17,426
بعجما سمع اغنية الآنسة [رييكو]

1639
01:49:17,426 --> 01:49:19,396
تذكر ما حدث معكما قبل ثلاث سنوات

1640
01:49:19,896 --> 01:49:24,816
واستعار هذا الكمان من المدرسة, ليعزف الاغنية التي سمعتها للتو

1641
01:49:25,426 --> 01:49:29,466
كي يسمعها هو و [ران] معاً

1642
01:49:31,756 --> 01:49:35,426
أخبرني [شينتشي] أنه أخطأ في حقك

1643
01:49:36,616 --> 01:49:37,816
هل تشاجرتما يا تُرى ؟

1644
01:49:39,566 --> 01:49:40,726
لم يحصل شيئاً من هذا

1645
01:49:42,786 --> 01:49:45,226
كنت سأسامحك حتى لو لم تأتِ

1646
01:49:49,886 --> 01:49:51,516
ايها الاحمق

1647
01:50:11,416 --> 01:50:11,546


1648
01:54:17,836 --> 01:54:20,156
لقد اعتدت ان آتي إلى هنا دوماً برفقته

1649
01:54:21,006 --> 01:54:22,936
كنا نتمشى هنا عند كل لقاء

1650
01:54:23,566 --> 01:54:25,436
هكذا اذن

1651
01:54:26,056 --> 01:54:27,896
في الربيع الذي تلا حادثة وفاته

1652
01:54:28,726 --> 01:54:30,606
وفي المكان الذي يفيض بذكرياتنا

1653
01:54:30,616 --> 01:54:32,626
غنيت اغنيته المفضلة

1654
01:54:33,096 --> 01:54:35,496
أليس كذلك ؟ ''Amazing Grace,' اغنية

1655
01:54:36,386 --> 01:54:36,996
أجل

1656
01:54:38,046 --> 01:54:38,966
بالنسبة لي

1657
01:54:39,646 --> 01:54:42,566
فلقد ضِقت ذرعاُ مما فعله اولئك الأربعة

1658
01:54:43,516 --> 01:54:46,066
إلى حد الذي جعلني أرغب بقتلهم

1659
01:54:46,916 --> 01:54:48,896
لكنني سامحتهم فيما بعد

1660
01:54:50,016 --> 01:54:53,856
 مضمونها التسامح ''Amazing Grace,' فأغنية

1661
01:54:56,686 --> 01:54:58,196
حسنٌ استأذنكم الآن

1662
01:54:58,966 --> 01:55:00,986
فلنغنِ بإنسجام مرة أخرى يا  [كونان]

1663
01:55:04,466 --> 01:55:05,086
إلى اللقاء

1664
01:55:06,116 --> 01:55:06,816
إلى اللقاء

1665
01:55:07,856 --> 01:55:08,746
إلى اللقاء

1666
01:55:12,176 --> 01:55:13,696
بالمناسبة يا  [ران]

1667
01:55:14,276 --> 01:55:17,506
كيف عرفتي ان الذي كان يعزف في ذلك الوقت هو  [شينتشي]

1668
01:55:19,666 --> 01:55:22,176
لديه عادة غريبة في العزف

1669
01:55:22,176 --> 01:55:23,476
يمكنني ملاحظتها مباشرة

1670
01:55:25,366 --> 01:55:26,186
حقاً ؟

1671
01:55:33,566 --> 01:55:36,196
ما هي تلك العادة الغريبة يا ترى ؟

1672
01:55:51,206 --> 01:55:54,186


1673
01:55:54,196 --> 01:55:56,716
لن ندعه وشأنه

1674
01:55:56,926 --> 01:55:59,956
هذا افضل يوم لقتل ذلك الشخص

1675
01:56:04,956 --> 01:56:09,956


1676
00:49:21,596 --> 00:49:24,486
لو ان الجميع يناديه باسمه

1677
00:49:28,456 --> 00:49:31,646
فسيأتي دائماً معنا

1678
00:26:25,396 --> 00:26:29,086
{\fad(100,100)\be1\1c&HFFF1F1&\t(100,3540,\1c&HD1C6B1&)}"على هذه التلة ذات الاخضر المتوهج"

1679
