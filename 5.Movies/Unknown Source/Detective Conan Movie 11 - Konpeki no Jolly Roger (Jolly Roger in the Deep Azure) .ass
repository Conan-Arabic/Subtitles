Dialogue: 0,0:00:19.61,0:00:20.41,bl,,0,0,0,,حالة طوارئ
Dialogue: 0,0:00:20.48,0:00:22.85,bl,,0,0,0,,هنا 503...حول
Dialogue: 0,0:00:22.92,0:00:23.75,bl,,0,0,0,,حالة طوارئ
Dialogue: 0,0:00:23.82,0:00:25.65,bl,,0,0,0,,إلى 503...حول
Dialogue: 0,0:00:25.72,0:00:29.05,bl,,0,0,0,,تم العثور على سيارة المجرمين في جريمة السطو المسلح
Dialogue: 0,0:00:29.12,0:00:31.72,bl,,0,0,0,,خرج الهدف هاربا من شارع هوري متجها نحو متحف ساتشيمي
Dialogue: 0,0:00:31.79,0:00:32.99,bl,,0,0,0,,علم
Dialogue: 0,0:00:33.06,0:00:34.99,bl,,0,0,0,,أرجو التحقق من السيارات المشتبهة،والتأكد من سجل السيارة
Dialogue: 0,0:00:35.06,0:00:37.39,bl,,0,0,0,,وكذلك ملامح ومواصفات المشتبه به
Dialogue: 0,0:00:37.46,0:00:38.95,bl,,0,0,0,,أرجو الرد
Dialogue: 0,0:00:39.03,0:00:40.52,bl,,0,0,0,,علم
Dialogue: 0,0:00:40.60,0:00:41.93,bl,,0,0,0,,السيارة المشتبهة هي شاحنة سوداء
Dialogue: 0,0:00:42.00,0:00:43.80,bl,,0,0,0,,500-SA-3255 رقم التسجيل هو
Dialogue: 0,0:00:43.87,0:00:46.40,bl,,0,0,0,,...تم التعرف على شخصية المجرمين
Dialogue: 0,0:00:46.47,0:00:48.91,bl,,0,0,0,,.إنهما يرتديان قناعي لوبين و فوجيكو
Dialogue: 0,0:00:50.84,0:00:51.71,bl,,0,0,0,,إلى 503
Dialogue: 0,0:00:51.78,0:00:52.91,bl,,0,0,0,,لا تتهور
Dialogue: 0,0:00:52.98,0:00:54.71,bl,,0,0,0,,...أنا لا أتصرف بتهور
Dialogue: 0,0:00:57.48,0:00:59.54,bl,,0,0,0,,هنا 503..حول
Dialogue: 0,0:00:59.62,0:01:02.65,bl,,0,0,0,,من متحف ساتشيمي..استدار إلى اليسار متجها إلى الشارع المركزي
Dialogue: 0,0:01:02.72,0:01:04.69,bl,,0,0,0,,إلى 503...أرجو استغلال الوقت وعدم التهور
Dialogue: 0,0:01:04.76,0:01:05.38,bl,,0,0,0,,أرجو الرد
Dialogue: 0,0:01:05.46,0:01:08.12,bl,,0,0,0,,!قلت لك،إنني لم أتهور
Dialogue: 0,0:01:10.26,0:01:11.89,bl,,0,0,0,,لحظة..آنسة ساتو
Dialogue: 0,0:01:11.97,0:01:13.80,bl,,0,0,0,,...أرجوك توخ الحذر أثناء القيادة
Dialogue: 0,0:01:13.87,0:01:15.39,bl,,0,0,0,,ألا يجب عليك الاتصال بالمركز؟
Dialogue: 0,0:01:15.47,0:01:16.70,bl,,0,0,0,,نعم
Dialogue: 0,0:01:17.10,0:01:19.04,bl,,0,0,0,,هنا 503..حول
Dialogue: 0,0:01:19.11,0:01:20.44,bl,,0,0,0,,لقد استدار المشتبه بهم إلى اليمين متجهين إلى البحر
Dialogue: 0,0:01:20.51,0:01:23.00,bl,,0,0,0,,كيف يجرؤ على لبس قناع لوبين أثناء السرقة؟
Dialogue: 0,0:01:23.08,0:01:24.20,bl,,0,0,0,,!هذه جريمة لا تغتفر
Dialogue: 0,0:01:30.82,0:01:32.55,bl,,0,0,0,,...مرحبا،مساء الخير
Dialogue: 0,0:01:41.30,0:01:43.86,bl,,0,0,0,,المجموع هو 1237 ين
Dialogue: 0,0:01:50.04,0:01:52.37,bl,,0,0,0,,!توقف في الحال
Dialogue: 0,0:01:57.71,0:01:59.27,bl,,0,0,0,,!يبدو أنها مطاردة
Dialogue: 0,0:01:59.35,0:02:00.47,bl,,0,0,0,,رائع
Dialogue: 0,0:02:01.52,0:02:04.08,bl,,0,0,0,,!أنت توقف في الحال
Dialogue: 0,0:02:04.72,0:02:05.84,bl,,0,0,0,,أكرر
Dialogue: 0,0:02:05.92,0:02:07.44,bl,,0,0,0,,لا يمكنك الفرار بعيدا
Dialogue: 0,0:02:07.52,0:02:10.01,bl,,0,0,0,,!خفف السرعة وتوقف على جانب الطريق
Dialogue: 0,0:02:17.43,0:02:18.30,bl,,0,0,0,,لم أتوقع هذا
Dialogue: 0,0:02:18.47,0:02:20.70,bl,,0,0,0,,سأرد الصاع صاعين
Dialogue: 0,0:03:04.65,0:03:07.27,bl,,0,0,0,,آنسة ساتو،سيتمكنون من الهرب بعيدا
Dialogue: 0,0:03:07.81,0:03:09.01,bl,,0,0,0,,تمسك جيدا
Dialogue: 0,0:03:13.42,0:03:15.29,bl,,0,0,0,,آنسة ساتو،ماذا تريدين أن تفعلي؟
Dialogue: 0,0:03:15.36,0:03:16.98,bl,,0,0,0,,!لا تتكلم مرة أخرى وإلا قطعت لسانك الوقح
Dialogue: 0,0:03:27.80,0:03:28.86,bl,,0,0,0,,آنسة ساتو...؟
Dialogue: 0,0:03:28.94,0:03:29.73,bl,,0,0,0,,اخرس
Dialogue: 0,0:03:35.64,0:03:37.30,bl,,0,0,0,,لحظة،آنسة ساتو؟
Dialogue: 0,0:03:48.59,0:03:50.42,bl,,0,0,0,,تاكاجي،اتصل بالمركز فورا
Dialogue: 0,0:03:50.49,0:03:51.18,bl,,0,0,0,,حسنا
Dialogue: 0,0:03:55.60,0:03:57.03,bl,,0,0,0,,!يا إلهي
Dialogue: 0,0:03:57.13,0:03:58.46,bl,,0,0,0,,آنسة ساتو
Dialogue: 0,0:03:58.63,0:04:02.16,bl,,0,0,0,,سيارات الدعم والإسعاف قادمة في الحال
Dialogue: 0,0:04:02.24,0:04:03.67,bl,,0,0,0,,كان عليه توقع عواقب تصرفاته
Dialogue: 0,0:04:04.67,0:04:08.27,bl,,0,0,0,,من سمح له بارتداء قناع الحب الأول؟
Dialogue: 0,0:04:08.98,0:04:11.04,bl,,0,0,0,,حب...أول؟
Dialogue: 0,0:04:11.11,0:04:12.51,bl,,0,0,0,,تحقق من فوجيكو
Dialogue: 0,0:04:13.05,0:04:13.81,bl,,0,0,0,,حسنا
Dialogue: 0,0:04:17.55,0:04:20.52,bl,,0,0,0,,لا بأس،سيصل الإسعاف بعد قليل
Dialogue: 0,0:04:20.59,0:04:21.49,bl,,0,0,0,,آنسة ساتو
Dialogue: 0,0:04:22.02,0:04:24.32,bl,,0,0,0,,لقد أغمي على فوجيكو فقط
Dialogue: 0,0:04:24.39,0:04:25.62,bl,,0,0,0,,وجروحه طفيفة
Dialogue: 0,0:04:25.69,0:04:26.78,bl,,0,0,0,,حقا؟
Dialogue: 0,0:04:26.86,0:04:28.16,bl,,0,0,0,,...أيا كان،لماذا يرتديان
Dialogue: 0,0:04:28.23,0:04:31.96,bl,,0,0,0,,هذه الأقنعة المضحكة أثناء السرقة؟
Dialogue: 0,0:04:32.23,0:04:34.63,bl,,0,0,0,,...جزيرة...جزيرة الإله
Dialogue: 0,0:04:34.70,0:04:36.07,bl,,0,0,0,,جزيرة الإله؟
Dialogue: 0,0:04:36.14,0:04:39.90,bl,,0,0,0,,تريد المال من أجل التنزه في تلك الجزيرة؟
Dialogue: 0,0:04:39.97,0:04:41.34,bl,,0,0,0,,لا
Dialogue: 0,0:04:41.41,0:04:42.97,bl,,0,0,0,,لا؟
Dialogue: 0,0:04:43.04,0:04:44.87,bl,,0,0,0,,ما بها تلك الجزيرة؟
Dialogue: 0,0:04:44.95,0:04:47.04,bl,,0,0,0,,...جولي
Dialogue: 0,0:04:47.11,0:04:51.05,bl,,0,0,0,,جولي روجر
Dialogue: 0,0:04:51.12,0:04:52.68,bl,,0,0,0,,جولي روجر؟
Dialogue: 0,0:04:52.95,0:04:53.98,bl,,0,0,0,,هل سمعت بهذا الاسم من قبل؟
Dialogue: 0,0:04:54.05,0:04:55.32,bl,,0,0,0,,لم أسمع به أبدا
Dialogue: 0,0:05:21.05,0:05:22.98,bl,,0,0,0,,أمي،بسرعة أسرعي
Dialogue: 0,0:05:23.05,0:05:23.98,bl,,0,0,0,,لنذهب للعب سوية
Dialogue: 0,0:05:24.05,0:05:25.18,bl,,0,0,0,,...انتظرني
Dialogue: 0,0:05:25.42,0:05:27.79,bl,,0,0,0,,كيف استعمل هذا؟
Dialogue: 0,0:05:27.85,0:05:28.88,bl,,0,0,0,,سأعلمك الطريقة
Dialogue: 0,0:05:29.02,0:05:31.75,bl,,0,0,0,,أستاذ،هل الأسماك كثيرة هنا؟
Dialogue: 0,0:05:37.26,0:05:40.29,bl,,0,0,0,,صباح الخير،أرجو أن تطلعني على الحجر من فضلك؟
Dialogue: 0,0:05:40.37,0:05:43.77,bl,,0,0,0,,أدعى موري كوجورو...متحر خاص
Dialogue: 0,0:05:43.84,0:05:45.83,bl,,0,0,0,,راشدان،طالبتان
Dialogue: 0,0:05:45.91,0:05:47.31,bl,,0,0,0,,وخمسة أطفال
Dialogue: 0,0:05:47.37,0:05:48.90,bl,,0,0,0,,من فضلك انتظر لحظة
Dialogue: 0,0:05:51.61,0:05:55.24,bl,,0,0,0,,في كل يوم اثنين تصدر في الصحيفة مسابقة لغز العمود
Dialogue: 0,0:05:55.32,0:05:57.61,bl,,0,0,0,,وهذه المرة كانت في غاية الصعوبة
Dialogue: 0,0:05:57.68,0:06:01.62,bl,,0,0,0,,ولم ينجح أحد في الحصول على الجائزة النقدية
Dialogue: 0,0:06:01.69,0:06:04.99,bl,,0,0,0,,وفي النهاية،أصبحت الجائزة 300000 ين
Dialogue: 0,0:06:05.06,0:06:06.29,bl,,0,0,0,,...من برأيك سيكون الحاصل على الـ 300000
Dialogue: 0,0:06:06.36,0:06:09.06,bl,,0,0,0,,ويفوز؟
Dialogue: 0,0:06:09.36,0:06:11.19,bl,,0,0,0,,لا أعلم
Dialogue: 0,0:06:11.26,0:06:12.79,bl,,0,0,0,,...ربما يكون
Dialogue: 0,0:06:13.10,0:06:14.53,bl,,0,0,0,,إجابة صحيحة
Dialogue: 0,0:06:14.60,0:06:16.40,bl,,0,0,0,,رغم لك هذا،فأنا متحر
Dialogue: 0,0:06:16.47,0:06:18.53,bl,,0,0,0,,وألغاز الغموض سهلة بالنسبة إلي
Dialogue: 0,0:06:18.61,0:06:21.13,bl,,0,0,0,,الوحيد الذي عرف الجواب هو أنا
Dialogue: 0,0:06:21.21,0:06:22.27,bl,,0,0,0,,إذا كنت تملك 300000
Dialogue: 0,0:06:22.34,0:06:25.64,bl,,0,0,0,,فيمكنك الذهاب إلى باريس وقضاء العطلة هناك
Dialogue: 0,0:06:25.71,0:06:29.24,bl,,0,0,0,,لأن أكثر ما يريحني ويعجبنب هو شوارع باريس
Dialogue: 0,0:06:29.32,0:06:30.65,bl,,0,0,0,,...ولكني فهمت مؤخرا
Dialogue: 0,0:06:30.72,0:06:33.88,bl,,0,0,0,,أن من الأنانية التفكير في نفسي فقط
Dialogue: 0,0:06:33.95,0:06:35.18,bl,,0,0,0,,ولهذا انتهزت هذه الفرصة النادرة
Dialogue: 0,0:06:35.26,0:06:38.19,bl,,0,0,0,,لأجعلهم يمضون بعض الوقت الممتع
Dialogue: 0,0:06:38.26,0:06:40.73,bl,,0,0,0,,يجب أن أفكر هكذا وإلا سأكون أنانيا
Dialogue: 0,0:06:40.79,0:06:42.13,bl,,0,0,0,,...حقا
Dialogue: 0,0:06:42.30,0:06:44.46,bl,,0,0,0,,إذا ما هي أرقام غرفنا؟
Dialogue: 0,0:06:44.53,0:06:45.83,bl,,0,0,0,,...يؤسفني إخبارك
Dialogue: 0,0:06:45.90,0:06:49.43,bl,,0,0,0,,!أنه ليس هنالك حجز باسمك
Dialogue: 0,0:06:49.50,0:06:50.90,bl,,0,0,0,,حقا؟
Dialogue: 0,0:06:50.97,0:06:51.96,bl,,0,0,0,,...يا حبيبي
Dialogue: 0,0:06:52.24,0:06:53.97,bl,,0,0,0,,...انتظر لحظة
Dialogue: 0,0:06:54.04,0:06:55.80,bl,,0,0,0,,أنا متأكد أنني حجزت هنا
Dialogue: 0,0:06:55.88,0:06:59.54,bl,,0,0,0,,ولكني لم أجد اسمك في قائمة الحجوزات
Dialogue: 0,0:06:59.61,0:07:01.91,bl,,0,0,0,,هل سننام في العراء؟
Dialogue: 0,0:07:01.98,0:07:03.78,bl,,0,0,0,,الجزيرة تقع على مقربة من الخط الاستوائي
Dialogue: 0,0:07:03.85,0:07:05.98,bl,,0,0,0,,والحرارة مرتفعة جدا
Dialogue: 0,0:07:06.05,0:07:08.02,bl,,0,0,0,,لم يكن علينا المجيء
Dialogue: 0,0:07:08.09,0:07:10.42,bl,,0,0,0,,هناك حل بالتأكيد
Dialogue: 0,0:07:10.69,0:07:13.99,bl,,0,0,0,,وخصوصا أن اللغة الأجنبية هنا ليست عائقا
Dialogue: 0,0:07:14.06,0:07:16.32,bl,,0,0,0,,تتكلمين كالكبار يا هايبرا
Dialogue: 0,0:07:16.40,0:07:19.42,bl,,0,0,0,,حتى الأطفال بدؤوا يشكون في طفولتك
Dialogue: 0,0:07:21.03,0:07:23.94,bl,,0,0,0,,لقد قال المكتب أنه اتصل بالمركز السياحي
Dialogue: 0,0:07:24.00,0:07:25.60,bl,,0,0,0,,فلا داعي للقلق حيال ذلك
Dialogue: 0,0:07:25.67,0:07:26.83,bl,,0,0,0,,أمر مؤسف
Dialogue: 0,0:07:26.91,0:07:28.64,bl,,0,0,0,,ولكن ذلك الشخص وعدني حقا
Dialogue: 0,0:07:28.71,0:07:32.11,bl,,0,0,0,,وقال بأنه قد حجز لنا
Dialogue: 0,0:07:32.18,0:07:34.11,bl,,0,0,0,,لا أعلم شيئا عن ذلك
Dialogue: 0,0:07:34.18,0:07:36.48,bl,,0,0,0,,مرحبا جميعا وآسف لأنني جعلتكم تنتظرون طويلا
Dialogue: 0,0:07:36.55,0:07:38.18,bl,,0,0,0,,إنه أنت...سيد موري
Dialogue: 0,0:07:38.25,0:07:39.65,bl,,0,0,0,,...المتحري الشهير
Dialogue: 0,0:07:45.76,0:07:49.09,bl,,0,0,0,,معذرة،اسمي أنوا ناجا وأنا المرشد السياحي
Dialogue: 0,0:07:49.16,0:07:52.93,bl,,0,0,0,,لقد زاد عدد السياح كثيرا هذا الشهر
Dialogue: 0,0:07:53.00,0:07:54.43,bl,,0,0,0,,جميع حجوزات الفنادق ممتلئة
Dialogue: 0,0:07:54.50,0:07:57.20,bl,,0,0,0,,ومع أن الأماكن مزدحمة جدا،إلا أنهم سعداء
Dialogue: 0,0:07:57.27,0:08:00.54,bl,,0,0,0,,أيا كان،سأبذل جهدي لأوفر لكم مقر الإقامة
Dialogue: 0,0:08:00.61,0:08:04.30,bl,,0,0,0,,فأنت المتحري الشهير موري كوجورو
Dialogue: 0,0:08:04.38,0:08:06.68,bl,,0,0,0,,أرجوكم تفضلوا معي لأرشدكم إلى الطريق
Dialogue: 0,0:08:08.11,0:08:09.14,bl,,0,0,0,,لن أستطيع التحمل أكثر من ذلك
Dialogue: 0,0:08:09.22,0:08:11.28,bl,,0,0,0,,لا تقف في منتصف الطريق
Dialogue: 0,0:08:13.95,0:08:15.85,bl,,0,0,0,,من يكون هؤلاء الأشخاص؟
Dialogue: 0,0:08:15.92,0:08:17.91,bl,,0,0,0,,إنهم صائدوا كنوز
Dialogue: 0,0:08:17.99,0:08:19.25,bl,,0,0,0,,صائدوا كنوز؟
Dialogue: 0,0:08:19.33,0:08:21.26,bl,,0,0,0,,هل هم من يصلحون الأنابيب؟
Dialogue: 0,0:08:21.93,0:08:24.90,bl,,0,0,0,,المرحاض الذي على اليمين كان يسرب الماء
Dialogue: 0,0:08:26.50,0:08:28.53,bl,,0,0,0,,.ليس الأمر كذلك يا جينتا
Dialogue: 0,0:08:28.60,0:08:32.40,bl,,0,0,0,,صائدوا الكنوز هم الأشخاص الذين يجولون العالم بحثا عن الكنوز الثمينة
Dialogue: 0,0:08:33.57,0:08:35.47,bl,,0,0,0,,لكن،كيف عرفت...؟
Dialogue: 0,0:08:35.54,0:08:36.94,bl,,0,0,0,,أنهم صائدوا كنوز؟
Dialogue: 0,0:08:37.01,0:08:39.27,bl,,0,0,0,,انظري إليهم بتمعن
Dialogue: 0,0:08:39.91,0:08:42.94,bl,,0,0,0,,لون بشرة هؤلاء الأشخاص يميل إلى السواد
Dialogue: 0,0:08:43.02,0:08:45.21,bl,,0,0,0,,وبالنظرة إلى اليدين والرقبة
Dialogue: 0,0:08:45.29,0:08:47.15,bl,,0,0,0,,فجميع المناطق الأخرى بيضاء
Dialogue: 0,0:08:47.22,0:08:50.25,bl,,0,0,0,,وهذا يدل على أنهم يرتدون ملابس الغوص في معظم الأوقات
Dialogue: 0,0:08:50.32,0:08:54.02,bl,,0,0,0,,وكذلك لون شعرهم باهت بسبب ماء البحر
Dialogue: 0,0:08:54.09,0:08:55.46,bl,,0,0,0,,ولكن،إذا كان الأمر كما قلت
Dialogue: 0,0:08:55.53,0:08:56.93,bl,,0,0,0,,فنستنتج أنهم غواصون فقط
Dialogue: 0,0:08:57.00,0:08:58.83,bl,,0,0,0,,هذا صحيح،بالتأكيد
Dialogue: 0,0:08:58.90,0:09:00.76,bl,,0,0,0,,ولكن إذا نظرت إلى اللوحة التي هناك
Dialogue: 0,0:09:00.83,0:09:02.56,bl,,0,0,0,,فعندها ستتأكد
Dialogue: 0,0:09:02.64,0:09:03.93,bl,,0,0,0,,(جزيرة بوسايدن ترقد على قصر الكنوز)
Dialogue: 0,0:09:04.00,0:09:05.37,bl,,0,0,0,,(تستطيعون الانضمام إلينا للبحث عن الكنوز المخبأة)
Dialogue: 0,0:09:06.47,0:09:07.44,bl,,0,0,0,,!كنوز-\N!كنوز-
Dialogue: 0,0:09:07.51,0:09:08.41,bl,,0,0,0,,نعم
Dialogue: 0,0:09:09.11,0:09:10.94,bl,,0,0,0,,على الأرجح أنهم بدؤوا بالغوص ليحققوا حلمهم
Dialogue: 0,0:09:11.95,0:09:14.85,bl,,0,0,0,,الحلم الموجود داخل أعماق البحر وهو الكنز
Dialogue: 0,0:09:31.30,0:09:34.66,1,,0,0,0,,{\pos(1059.999,1034.024)}علم القراصنة في عرض المحيط
Dialogue: 0,0:09:40.27,0:09:42.74,bl,,0,0,0,,أدعى كودو شينيتشي متحر في المرحلة الثانوية
Dialogue: 0,0:09:42.81,0:09:45.80,bl,,0,0,0,,هه؟هل أبدو حقا وكأني في المرحلة الثانوية؟
Dialogue: 0,0:09:49.75,0:09:51.05,bl,,0,0,0,,هذه هي صديقة طفولتي وزميلتي في الدراسة أيضا
Dialogue: 0,0:09:51.12,0:09:52.74,bl,,0,0,0,,وتدعى ران موري
Dialogue: 0,0:09:53.52,0:09:55.58,bl,,0,0,0,,في يوم ما،عندما ذهبت مع ران إلى مدينة الملاهي
Dialogue: 0,0:09:55.66,0:09:59.02,bl,,0,0,0,,شاهدت عملية ابتزاز يقودها رجل يرتدي ملابس سوداء
Dialogue: 0,0:09:59.96,0:10:01.95,bl,,0,0,0,,..وبينما كنت أراقب العملية
Dialogue: 0,0:10:02.03,0:10:05.09,bl,,0,0,0,,لم ألاحظ وجود رجل آخر خلفي من العصابة
Dialogue: 0,0:10:08.30,0:10:11.40,bl,,0,0,0,,وأرغموني على تناول عقار غريب
Dialogue: 0,0:10:11.47,0:10:12.60,bl,,0,0,0,,...وعندما استيقظت
Dialogue: 0,0:10:13.37,0:10:15.53,bl,,0,0,0,,كان جسدي قد تقلص بالكامل
Dialogue: 0,0:10:16.28,0:10:19.01,bl,,0,0,0,,إذا علموا بأن كودو شينيتشي مازال حيا
Dialogue: 0,0:10:19.08,0:10:20.34,bl,,0,0,0,,فالخطر لن يكون على حياتي فقط
Dialogue: 0,0:10:20.41,0:10:22.78,bl,,0,0,0,,بل على حياة جميع من حولي أيضا
Dialogue: 0,0:10:22.85,0:10:23.98,bl,,0,0,0,,...وبناء على اقتراح الدكتور أغاسا
Dialogue: 0,0:10:24.05,0:10:26.11,bl,,0,0,0,,أخفيت هويتي الحقيقية
Dialogue: 0,0:10:26.19,0:10:27.28,bl,,0,0,0,,...وعندما سألتني ران عن اسمي
Dialogue: 0,0:10:27.35,0:10:28.34,bl,,0,0,0,,قلت
Dialogue: 0,0:10:28.42,0:10:30.29,bl,,0,0,0,,أنني أدعى إيدوجاوا كونان
Dialogue: 0,0:10:30.36,0:10:32.09,bl,,0,0,0,,...ومن أجل أن أجمع معلومات عن المنظمة السوداء
Dialogue: 0,0:10:32.16,0:10:33.35,bl,,0,0,0,,قررت العيش في منزل ران
Dialogue: 0,0:10:33.43,0:10:35.26,bl,,0,0,0,,حيث أن والدها كان يعمل متحريا
Dialogue: 0,0:10:37.10,0:10:38.96,bl,,0,0,0,,هذا العم هو والد ران
Dialogue: 0,0:10:39.03,0:10:40.93,bl,,0,0,0,,ويدعى المتحر موري كوجورو
Dialogue: 0,0:10:42.64,0:10:44.93,bl,,0,0,0,,يلقبونه بـ كوجورو النائم
Dialogue: 0,0:10:46.87,0:10:48.00,bl,,0,0,0,,...وذلك بسبب
Dialogue: 0,0:10:48.41,0:10:49.77,bl,,0,0,0,,!هذا
Dialogue: 0,0:10:51.65,0:10:53.77,bl,,0,0,0,,هذه الفتاة تدعى سوزوكي سونوكو
Dialogue: 0,0:10:54.05,0:10:55.51,bl,,0,0,0,,وهي زميلة ران في الدرسة
Dialogue: 0,0:10:55.58,0:10:58.05,bl,,0,0,0,,وعلى الرغم من أنها ابنة عائلة غنية جدا
Dialogue: 0,0:10:58.12,0:10:59.31,bl,,0,0,0,,إلا أنها طيبة القلب معنا
Dialogue: 0,0:11:00.32,0:11:02.91,bl,,0,0,0,,هذا العم هو البروفيسور أغاسا
Dialogue: 0,0:11:03.89,0:11:05.86,bl,,0,0,0,,بعد تقلصي ساعدني البروفيسور كثيرا
Dialogue: 0,0:11:05.93,0:11:08.52,bl,,0,0,0,,باختراعه الكثير من الأشياء المفيدة والفريدة من نوعها
Dialogue: 0,0:11:11.90,0:11:13.76,bl,,0,0,0,,هذه الفتاة تدعى هايبرا آي
Dialogue: 0,0:11:14.90,0:11:16.89,bl,,0,0,0,,اسمها الحقيقي هو ميانو شيهو
Dialogue: 0,0:11:17.40,0:11:21.10,bl,,0,0,0,,كانت شريكة لرجال المنظمة السوداء
Dialogue: 0,0:11:21.17,0:11:22.73,bl,,0,0,0,,إلا أنها قررت الهرب من المنظمة
Dialogue: 0,0:11:22.81,0:11:25.11,bl,,0,0,0,,فتناولت العقار نفسه
Dialogue: 0,0:11:25.18,0:11:26.91,bl,,0,0,0,,لذلك تقلص جسدها أيضا
Dialogue: 0,0:11:28.65,0:11:32.05,bl,,0,0,0,,على الرغم من أنني لم أستطع التعرف على هوية رجال المنظمة السوداء بعد
Dialogue: 0,0:11:32.39,0:11:33.75,bl,,0,0,0,,ولكن،كمتحر سأوقع بهم وأكشف هويتهم يوما ما
Dialogue: 0,0:11:33.82,0:11:36.12,bl,,0,0,0,,بالرغم من أنني صغير الجسد،إلا أن عقلي مازال كما هو
Dialogue: 0,0:11:37.59,0:11:39.99,bl,,0,0,0,,يمكنني حل أصعب القضايا وحدي
Dialogue: 0,0:11:40.06,0:11:42.05,bl,,0,0,0,,!فهناك حقيقة واحدة فقط
Dialogue: 0,0:11:42.33,0:11:45.39,bl,,0,0,0,,لم تخبرني
Dialogue: 0,0:11:50.90,0:11:56.05,bl,,0,0,0,,لماذا يأتي صائدوا الكنوز إلى هنا؟
Dialogue: 0,0:11:56.27,0:11:59.86,bl,,0,0,0,,لأنهم قبل أسبوعين وجدوا كنزا
Dialogue: 0,0:12:00.42,0:12:01.37,bl,,0,0,0,,كنزا؟
Dialogue: 0,0:12:01.72,0:12:05.69,bl,,0,0,0,,وجدوا "أدوات المائدة الفضية" في قصر مغمور في قاع البحر
Dialogue: 0,0:12:05.70,0:12:06.01,bl,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:12:06.42,0:12:07.74,bl,,0,0,0,,صحيح
Dialogue: 0,0:12:08.12,0:12:09.36,bl,,0,0,0,,أين وجدوا القصر؟
Dialogue: 0,0:12:09.85,0:12:12.77,bl,,0,0,0,,انظر هناك،تلك الجزيرة الخالية من السكان
Dialogue: 0,0:12:13.70,0:12:15.15,bl,,0,0,0,,{\pos(968,131.667)}تدعى جزيرة يوروياتشي
Dialogue: 0,0:12:13.66,0:12:15.36,bl,,0,0,0,,وتبعد عن الجهة الشرقية للمرفأ حوالي 200 متر
Dialogue: 0,0:12:15.86,0:12:19.13,bl,,0,0,0,,وهناك غرقت الكثير من المباني
Dialogue: 0,0:12:19.20,0:12:22.79,bl,,0,0,0,,وفي الأعماق السحيقة لجزيرة الإله يرقد الكنز الثمين
Dialogue: 0,0:12:23.34,0:12:27.93,bl,,0,0,0,,كانت البداية منذ عشر سنين
Dialogue: 0,0:12:28.01,0:12:30.74,bl,,0,0,0,,ومع أن الكثير من الباحثين قد حققوا في هذا الأمر
Dialogue: 0,0:12:30.94,0:12:33.74,bl,,0,0,0,,واستغرقوا وقتا طويلا لذلك
Dialogue: 0,0:12:33.81,0:12:36.25,bl,,0,0,0,,فقد اكتشوفوا أخيرا أنها طبيعية وليست من صنع الإنسان
Dialogue: 0,0:12:36.32,0:12:38.88,bl,,0,0,0,,ولكن حتى الآن لم يجدوا دليلا على ذلك
Dialogue: 0,0:12:39.19,0:12:40.68,bl,,0,0,0,,لقد سمعت أن هذه الجزيرة من قبل
Dialogue: 0,0:12:40.75,0:12:43.55,bl,,0,0,0,,كانت فوق البحر
Dialogue: 0,0:12:43.62,0:12:46.09,bl,,0,0,0,,ولكنها بسبب الهزة الأرضية التي حدثت منذ 300 عام
Dialogue: 0,0:12:46.16,0:12:48.59,bl,,0,0,0,,غرقت
Dialogue: 0,0:12:48.66,0:12:50.19,bl,,0,0,0,,هل غرقت بسبب الهزة الأرضية؟
Dialogue: 0,0:12:50.26,0:12:51.92,bl,,0,0,0,,وهل انخفض سطحها كثيرا؟
Dialogue: 0,0:12:52.00,0:12:55.30,bl,,0,0,0,,نعم،سمعتهم يقولون ذلك في المرفأ
Dialogue: 0,0:12:55.37,0:12:58.46,bl,,0,0,0,,إنها مكونة من مادة تدعى ميثان هايد رايت
Dialogue: 0,0:12:58.54,0:13:01.06,bl,,0,0,0,,وقد تحللت بسبب الهزة الأرضية
Dialogue: 0,0:13:01.14,0:13:02.73,bl,,0,0,0,,مما أدى إلى غرق هذه الجزيرة
Dialogue: 0,0:13:02.81,0:13:04.17,bl,,0,0,0,,وهذا أرجح استنتاج حتى الآن
Dialogue: 0,0:13:05.75,0:13:06.91,bl,,0,0,0,,كونان
Dialogue: 0,0:13:07.45,0:13:10.44,bl,,0,0,0,,ما الذي تعنيه بنسبة هايدو؟
Dialogue: 0,0:13:11.22,0:13:13.01,bl,,0,0,0,,{\pos(960,1083.667)}كنت أقصد طبقة الـ ميثان هايد رايت
Dialogue: 0,0:13:13.52,0:13:15.99,bl,,0,0,0,,{\pos(957.333,1086.333)}في بيئة ما حيث درجة الحرارة منخفضة وتحت ضغط عال
Dialogue: 0,0:13:16.06,0:13:18.05,bl,,0,0,0,,{\pos(957.333,1086.333)}ذرات الماء ستندمج مع غاز الـ ميثان
Dialogue: 0,0:13:18.12,0:13:20.29,bl,,0,0,0,,{\pos(960,1086.333)}مما يؤدي إلى تكون شكل يدعى قفص الماء
Dialogue: 0,0:13:20.36,0:13:22.56,bl,,0,0,0,,ويسمى أيضا الجليد المحترق
Dialogue: 0,0:13:22.63,0:13:23.99,bl,,0,0,0,,الجليد المحترق؟
Dialogue: 0,0:13:24.06,0:13:25.72,bl,,0,0,0,,قفص الماء؟
Dialogue: 0,0:13:25.80,0:13:27.66,bl,,0,0,0,,لم نفهم شيئا
Dialogue: 0,0:13:28.87,0:13:30.56,bl,,0,0,0,,...بالمعنى البسيط
Dialogue: 0,0:13:30.64,0:13:33.13,bl,,0,0,0,,إذا صنعنا قلعة من أوراق اللعب
Dialogue: 0,0:13:33.21,0:13:36.51,bl,,0,0,0,,وأغرقنا هذه الأوراق بالماء ستتشكل على هيكل قاعة
Dialogue: 0,0:13:36.58,0:13:40.21,bl,,0,0,0,,وفي كل غرفة وضعنا جزءا من الـ مثيان
Dialogue: 0,0:13:40.81,0:13:43.87,bl,,0,0,0,,فإذا قمنا برفع درجة الحرارة وخفضنا الضغط
Dialogue: 0,0:13:43.95,0:13:45.14,bl,,0,0,0,,ستغدو القلعة غير مستقرة
Dialogue: 0,0:13:45.22,0:13:46.38,bl,,0,0,0,,وفي النهاية ستتحطم
Dialogue: 0,0:13:46.45,0:13:48.85,bl,,0,0,0,,مفسحة المجال لغاز الـ ميثان للخروج بحرية
Dialogue: 0,0:13:49.06,0:13:50.04,bl,,0,0,0,,!هكذا إذا
Dialogue: 0,0:13:50.12,0:13:52.39,bl,,0,0,0,,إذا فإذا أطلق ذلك الغاز
Dialogue: 0,0:13:52.46,0:13:56.05,bl,,0,0,0,,الذي يعتبر دعامة للقصر فسيؤدي ذلك إلى انهياره
Dialogue: 0,0:13:56.13,0:13:59.00,bl,,0,0,0,,ذلك صحيح تماما
Dialogue: 0,0:14:02.00,0:14:04.23,bl,,0,0,0,,هذا ما شادته على التلفاز في الآونة الاخيرة
Dialogue: 0,0:14:04.84,0:14:06.67,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:14:09.68,0:14:11.04,bl,,0,0,0,,أحمق
Dialogue: 0,0:14:12.31,0:14:14.30,bl,,0,0,0,,آسف لإزعاجك،سيد ميما
Dialogue: 0,0:14:14.38,0:14:16.37,bl,,0,0,0,,سنبدأ الجولة السياحية يا سيدي
Dialogue: 0,0:14:16.45,0:14:18.25,bl,,0,0,0,,سيد ميما؟
Dialogue: 0,0:14:18.32,0:14:19.75,bl,,0,0,0,,سيد ميما
Dialogue: 0,0:14:19.89,0:14:22.29,bl,,0,0,0,,هذه الاستراحة سيئة وبعيدة
Dialogue: 0,0:14:22.36,0:14:23.48,bl,,0,0,0,,صحيح
Dialogue: 0,0:14:26.49,0:14:29.09,bl,,0,0,0,,أشعر بالخجل،يبدو بأنه ليس هنا
Dialogue: 0,0:14:29.16,0:14:30.53,bl,,0,0,0,,في الحقيقة،لقد اتصلت به
Dialogue: 0,0:14:30.60,0:14:32.26,bl,,0,0,0,,ما هذا الإزعاج؟
Dialogue: 0,0:14:32.33,0:14:33.80,bl,,0,0,0,,سيد ميما
Dialogue: 0,0:14:33.87,0:14:34.80,bl,,0,0,0,,هؤلاء هم الأشخاص الذين أخبرتك بهم على الهاتف
Dialogue: 0,0:14:34.87,0:14:36.23,bl,,0,0,0,,مع السيد موري،أيضا
Dialogue: 0,0:14:36.30,0:14:38.86,bl,,0,0,0,,تكلفة الليلة الواحدة مع وجبتين،5000 ين
Dialogue: 0,0:14:38.94,0:14:40.30,bl,,0,0,0,,أو اذهبوا إلى مكان آخر
Dialogue: 0,0:14:40.37,0:14:41.86,bl,,0,0,0,,...سيد ميما،انتظر
Dialogue: 0,0:14:41.94,0:14:43.74,bl,,0,0,0,,هذا الرجل متكبر حقا
Dialogue: 0,0:14:43.81,0:14:45.90,bl,,0,0,0,,آسف،ولكن في الحقيقة هذا الرجل جيد
Dialogue: 0,0:14:45.98,0:14:48.31,bl,,0,0,0,,فقط مزاجه متقلب قليلا
Dialogue: 0,0:14:48.55,0:14:52.14,bl,,0,0,0,,من منكم سيشارك في لعبة صيد الكنز؟
Dialogue: 0,0:14:52.22,0:14:53.69,bl,,0,0,0,,أنا
Dialogue: 0,0:14:54.45,0:14:55.68,bl,,0,0,0,,أنا
Dialogue: 0,0:14:56.26,0:14:58.38,bl,,0,0,0,,هل ستغوصان يا آنستي؟
Dialogue: 0,0:14:58.46,0:14:59.62,bl,,0,0,0,,نعم
Dialogue: 0,0:14:59.69,0:15:02.49,bl,,0,0,0,,سأوصلكما بسيارتي ولكن يجب أن نذهب مباشرة
Dialogue: 0,0:15:02.56,0:15:03.86,bl,,0,0,0,,شكرا لك
Dialogue: 0,0:15:04.36,0:15:06.49,bl,,0,0,0,,ماذا عنكما؟
Dialogue: 0,0:15:06.57,0:15:08.73,bl,,0,0,0,,البحث عن الكنز ممتع ومسل
Dialogue: 0,0:15:08.80,0:15:11.90,bl,,0,0,0,,بالنسبة لي،فأريد أن أستريح قليلا،لا داعي للقلق بشأني
Dialogue: 0,0:15:11.97,0:15:13.50,bl,,0,0,0,,وأنت سيد موري؟
Dialogue: 0,0:15:13.57,0:15:14.27,bl,,0,0,0,,هل تود المشاركة في لعبة صيد الكنز
Dialogue: 0,0:15:14.34,0:15:14.90,bl,,0,0,0,,لا
Dialogue: 0,0:15:14.97,0:15:17.17,bl,,0,0,0,,لقد قلت لشيزيكا بأنني سأتناول معها الشراب
Dialogue: 0,0:15:17.24,0:15:20.14,bl,,0,0,0,,وسنخرج في نزهة مع رئيسها في العمل
Dialogue: 0,0:15:24.52,0:15:29.48,bl,,0,0,0,,الآنسة موري ران والآنسة سوزوكي سونوكو،أليس كذلك؟
Dialogue: 0,0:15:30.12,0:15:32.06,bl,,0,0,0,,تريدان استئجار أدوات غوص كاملة،صحيح؟
Dialogue: 0,0:15:32.13,0:15:33.15,bl,,0,0,0,,نعم-\Nنعم-
Dialogue: 0,0:15:33.23,0:15:34.12,bl,,0,0,0,,كيميكو
Dialogue: 0,0:15:34.19,0:15:35.46,bl,,0,0,0,,نعم
Dialogue: 0,0:15:37.13,0:15:40.22,bl,,0,0,0,,لقد أحضرت ملابس الغوص لشخصين
Dialogue: 0,0:15:40.30,0:15:42.89,bl,,0,0,0,,لا أدري إن كان المقاس مناسبا؟
Dialogue: 0,0:15:42.97,0:15:43.70,bl,,0,0,0,,جيد
Dialogue: 0,0:15:43.77,0:15:44.79,bl,,0,0,0,,لا مشكلة
Dialogue: 0,0:15:44.87,0:15:46.03,bl,,0,0,0,,جيد جدا
Dialogue: 0,0:15:46.11,0:15:49.51,bl,,0,0,0,,لأن عائلتنا ترتدي ملابس الغوص ذات الحجم الصغير
Dialogue: 0,0:15:49.58,0:15:51.87,bl,,0,0,0,,.لا يهم أبدا
Dialogue: 0,0:15:51.95,0:15:53.97,bl,,0,0,0,,البدلات تبدو رائعة جدا
Dialogue: 0,0:15:54.05,0:15:55.17,bl,,0,0,0,,حقا؟
Dialogue: 0,0:15:55.35,0:15:56.58,bl,,0,0,0,,ما هذا الإزعاج؟
Dialogue: 0,0:15:56.82,0:16:00.75,bl,,0,0,0,,سبق وأن طلبت منكم البقاء مع التنظيم
Dialogue: 0,0:16:01.65,0:16:02.68,bl,,0,0,0,,هذا ليس من شأنك
Dialogue: 0,0:16:06.43,0:16:09.22,bl,,0,0,0,,هل هما من صائدي الكنوز؟
Dialogue: 0,0:16:09.30,0:16:10.73,bl,,0,0,0,,هل يجب علينا أن نتبعهم في الغوص؟
Dialogue: 0,0:16:10.80,0:16:11.96,bl,,0,0,0,,لا
Dialogue: 0,0:16:12.03,0:16:14.80,bl,,0,0,0,,لقد استأجروا ضواغط الهواء فقط
Dialogue: 0,0:16:14.87,0:16:16.60,bl,,0,0,0,,في الآونة الاخيرة
Dialogue: 0,0:16:16.67,0:16:18.16,bl,,0,0,0,,أصبحوا مزعجين كثيرا
Dialogue: 0,0:16:18.24,0:16:21.10,bl,,0,0,0,,ألهذا علاقة باكتشاف أدوات المائدة الفضية؟
Dialogue: 0,0:16:21.81,0:16:24.50,bl,,0,0,0,,ولكن هناك إشاعات تقول بأنه قد تم تهريبها
Dialogue: 0,0:16:24.58,0:16:27.98,bl,,0,0,0,,وهي مخفية على هذه الجزيرة
Dialogue: 0,0:16:28.05,0:16:29.31,bl,,0,0,0,,ومن الفاعل؟
Dialogue: 0,0:16:29.38,0:16:30.35,bl,,0,0,0,,إنها هي
Dialogue: 0,0:16:31.55,0:16:36.51,bl,,0,0,0,,منذ 270 عاما كان هناك قرصانتين تجوبان البحار
Dialogue: 0,0:16:36.59,0:16:41.03,bl,,0,0,0,,بينما كان القصر ما يزال في أعماق البحر
Dialogue: 0,0:16:41.09,0:16:45.72,bl,,0,0,0,,وقد وجدت بعض الأدلة في داخله
Dialogue: 0,0:16:45.80,0:16:47.93,bl,,0,0,0,,وجدوا سيفا يسمى بسيف الملاحين
Dialogue: 0,0:16:48.00,0:16:49.23,bl,,0,0,0,,ومعه مسدس
Dialogue: 0,0:16:49.94,0:16:53.24,bl,,0,0,0,,ووفقا للحكم الأول على المسدس والسيف
Dialogue: 0,0:16:53.31,0:16:56.50,bl,,0,0,0,,فإنهما يعودان إلى عام 1730
Dialogue: 0,0:16:56.58,0:16:58.31,bl,,0,0,0,,لامرأتين من القراصنة
Dialogue: 0,0:16:58.38,0:17:02.41,bl,,0,0,0,,آن بوني وماري ريد
Dialogue: 0,0:17:03.28,0:17:05.25,bl,,0,0,0,,من قراصنة
Dialogue: 0,0:17:05.32,0:17:06.11,bl,,0,0,0,,الكابتن جاك
Dialogue: 0,0:17:06.32,0:17:09.29,bl,,0,0,0,,امرأتان من القراصنة؟
Dialogue: 0,0:17:09.36,0:17:10.19,bl,,0,0,0,,نعم
Dialogue: 0,0:17:10.26,0:17:12.62,bl,,0,0,0,,آن بوني وماري ريد
Dialogue: 0,0:17:12.69,0:17:16.92,bl,,0,0,0,,قرصانتا الكابتن جاك
Dialogue: 0,0:17:17.00,0:17:20.43,bl,,0,0,0,,...عندما واجهتهم القوات الإنجليزية
Dialogue: 0,0:17:20.50,0:17:23.73,bl,,0,0,0,,اختبأ جميع الرجال في الكهف
Dialogue: 0,0:17:23.80,0:17:27.76,bl,,0,0,0,,وقيل أنهما قاتلتا ظهرا لظهر وبكل ما يملكان من الشجاعة
Dialogue: 0,0:17:27.84,0:17:30.37,bl,,0,0,0,,ظهرا لظهر؟
Dialogue: 0,0:17:30.44,0:17:33.88,bl,,0,0,0,,ساندتا بعضها بعضا لقتال الأعداء
Dialogue: 0,0:17:33.95,0:17:37.01,bl,,0,0,0,,وكان كل تركيزهم على هزيمة الأعداء
Dialogue: 0,0:17:37.08,0:17:39.85,bl,,0,0,0,,ولولا ثقتهما ببعضهما البعض،لكان من المستحيل فعل هذا
Dialogue: 0,0:17:41.35,0:17:42.18,bl,,0,0,0,,ران
Dialogue: 0,0:17:42.32,0:17:47.76,bl,,0,0,0,,أنا مستعدة للقتال معك ظهرا لظهر إن واجهنا الخطر
Dialogue: 0,0:17:48.39,0:17:50.45,bl,,0,0,0,,سونوكو
Dialogue: 0,0:17:51.40,0:17:52.52,bl,,0,0,0,,.كنت أمزح فقط
Dialogue: 0,0:17:52.93,0:17:55.73,bl,,0,0,0,,أنت تريدين من شينيتشي أن يحميك في موقف كهذا
Dialogue: 0,0:17:56.14,0:17:57.73,bl,,0,0,0,,ومن يحتاج لذلك الشاب الأبله؟
Dialogue: 0,0:17:57.80,0:17:59.17,bl,,0,0,0,,هل أنت جادة؟
Dialogue: 0,0:17:59.24,0:18:00.67,bl,,0,0,0,,.نعم أنا جادة
Dialogue: 0,0:18:02.34,0:18:04.71,bl,,0,0,0,,لقد هربتا من السجن
Dialogue: 0,0:18:04.78,0:18:07.18,bl,,0,0,0,,ونقلتا جميع نشاطتهما إلى قاعدة المحيط الهادئ
Dialogue: 0,0:18:07.25,0:18:08.91,bl,,0,0,0,,وبينما كان القراصنة مستعدون
Dialogue: 0,0:18:08.98,0:18:11.78,bl,,0,0,0,,وينتظرون خبر هروب ماري
Dialogue: 0,0:18:11.85,0:18:14.08,bl,,0,0,0,,ثم تأكدوا حينها
Dialogue: 0,0:18:14.15,0:18:15.85,bl,,0,0,0,,أنهما قد أخذتا الكنز بعيدا
Dialogue: 0,0:18:15.92,0:18:19.36,bl,,0,0,0,,وخبأتاه في جزيرة الإله هنا
Dialogue: 0,0:18:19.63,0:18:23.89,bl,,0,0,0,,معا،سنكتشف أين خبأت ماري هذا الكنز الثمين
Dialogue: 0,0:18:25.23,0:18:27.67,bl,,0,0,0,,هل هذه القصة حقيقية؟
Dialogue: 0,0:18:27.73,0:18:28.76,bl,,0,0,0,,من يدري
Dialogue: 0,0:18:29.10,0:18:31.57,bl,,0,0,0,,إذا كانت حقيقية،فهذا مدهش
Dialogue: 0,0:18:32.67,0:18:34.23,bl,,0,0,0,,وماذا إن كانت الجزيرة قد صنعت من أجل الدعاية فقط
Dialogue: 0,0:18:34.31,0:18:35.40,bl,,0,0,0,,لكن تبدو القصة جدية حقا
Dialogue: 0,0:18:36.38,0:18:39.21,bl,,0,0,0,,إنها تثير أعصابي أكثر
Dialogue: 0,0:18:39.51,0:18:41.31,bl,,0,0,0,,بغض النظر عن هذا،هذا الأمر لا يبدو كلعبة
Dialogue: 0,0:18:41.88,0:18:42.94,bl,,0,0,0,,المعذرة
Dialogue: 0,0:18:43.25,0:18:45.11,bl,,0,0,0,,...آسف على التأخير
Dialogue: 0,0:18:46.05,0:18:47.18,bl,,0,0,0,,يا إلهي
Dialogue: 0,0:18:48.15,0:18:50.99,bl,,0,0,0,,هذه خريطة الكنز
Dialogue: 0,0:18:51.06,0:18:52.62,bl,,0,0,0,,سنبدأ من هنا
Dialogue: 0,0:18:52.69,0:18:56.65,bl,,0,0,0,,لقد أخفيت التلميحات في خمس أماكن مختلفة كما تقول الخريطة
Dialogue: 0,0:18:56.73,0:18:58.72,bl,,0,0,0,,يجب عليكم حل الألغاز أولا
Dialogue: 0,0:18:58.80,0:19:00.89,bl,,0,0,0,,عند اكتشافكم للمكان الأول
Dialogue: 0,0:19:01.10,0:19:01.93,bl,,0,0,0,,عندها ضعوا الختم
Dialogue: 0,0:19:02.00,0:19:03.97,bl,,0,0,0,,في المساحة التي في أسفل الخريطة
Dialogue: 0,0:19:04.04,0:19:05.80,bl,,0,0,0,,توجهوا نحو الشمس
Dialogue: 0,0:19:05.87,0:19:08.34,bl,,0,0,0,,وستجدون التلميحات على البطاقة لمعرفة المواقع الأخرى
Dialogue: 0,0:19:09.34,0:19:10.87,bl,,0,0,0,,إنهم يخدعون الأطفال
Dialogue: 0,0:19:10.94,0:19:12.43,bl,,0,0,0,,وإن يكن
Dialogue: 0,0:19:12.51,0:19:14.64,bl,,0,0,0,,حل الألغاز يجعلهم مفعمين بالنشاط
Dialogue: 0,0:19:14.71,0:19:16.44,bl,,0,0,0,,من 10 إلى 12
Dialogue: 0,0:19:16.52,0:19:19.14,bl,,0,0,0,,هذه المواقع الأساسية لمعرفة الكنز المدفون
Dialogue: 0,0:19:19.22,0:19:21.08,bl,,0,0,0,,...المكان التالي
Dialogue: 0,0:19:21.15,0:19:22.49,bl,,0,0,0,,"حتى وإن لم تغب الشمس"
Dialogue: 0,0:19:22.56,0:19:24.72,bl,,0,0,0,,"سيبقى القراصنة متألقين"
Dialogue: 0,0:19:24.79,0:19:26.05,bl,,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:19:26.13,0:19:27.89,bl,,0,0,0,,ابذلوا ما بوسعكم
Dialogue: 0,0:19:27.96,0:19:29.59,bl,,0,0,0,,إذا تم اكتشاف موقع الكنز المدفون
Dialogue: 0,0:19:29.66,0:19:31.46,bl,,0,0,0,,فستربحون جائزة خاصة
Dialogue: 0,0:19:31.53,0:19:34.83,bl,,0,0,0,,هل الجائزة عبارة عن طعام؟
Dialogue: 0,0:19:34.90,0:19:37.39,bl,,0,0,0,,ستعرف ذلك بعد حل اللغز
Dialogue: 0,0:19:37.47,0:19:39.30,bl,,0,0,0,,حسنا،سأبذل ما بوسعي
Dialogue: 0,0:19:39.37,0:19:42.14,bl,,0,0,0,,وأيضا ليس من الضروري أن تكون الجائزة طعاما
Dialogue: 0,0:19:42.21,0:19:43.27,bl,,0,0,0,,أيها العم
Dialogue: 0,0:19:43.34,0:19:44.90,bl,,0,0,0,,ما الأمر؟
Dialogue: 0,0:19:44.98,0:19:48.24,bl,,0,0,0,,كيف سنصل إلى هذه العلامات؟
Dialogue: 0,0:19:48.31,0:19:50.75,bl,,0,0,0,,بشأن هذا الموضوع
Dialogue: 0,0:19:50.82,0:19:52.04,bl,,0,0,0,,صحيح
Dialogue: 0,0:19:52.12,0:19:54.45,bl,,0,0,0,,يمكنكم استئجار دراجات هوائية
Dialogue: 0,0:19:54.52,0:19:55.82,bl,,0,0,0,,واستخدامها حتى تصلوا للعلامات
Dialogue: 0,0:19:55.89,0:19:58.05,bl,,0,0,0,,هذا إن كان من الصعب عليكم الذهاب إلى العلامات مشيا
Dialogue: 0,0:19:58.12,0:19:59.52,bl,,0,0,0,,جيد
Dialogue: 0,0:20:01.86,0:20:04.39,bl,,0,0,0,,أنت أيضا متشوق يا كودو؟
Dialogue: 0,0:20:23.38,0:20:25.35,bl,,0,0,0,,حسنا،نحن مستعدون تماما
Dialogue: 0,0:20:25.62,0:20:28.25,bl,,0,0,0,,إذا يجب عليكم اتباع تعليمات كيميكو
Dialogue: 0,0:20:28.32,0:20:30.29,bl,,0,0,0,,الغوص ممتع ولكن من أجل السلامة
Dialogue: 0,0:20:30.36,0:20:33.81,bl,,0,0,0,,عليكم توخي الحذر الشديد واتباع تعليماتها
Dialogue: 0,0:20:33.89,0:20:35.45,bl,,0,0,0,,خصوصا وأن المكان شديد العمق
Dialogue: 0,0:20:35.53,0:20:37.62,bl,,0,0,0,,أرجوك لا تخيفينا
Dialogue: 0,0:20:38.00,0:20:41.09,bl,,0,0,0,,لا داعي للقلق فأنا معكما
Dialogue: 0,0:20:41.17,0:20:42.13,bl,,0,0,0,,هذا صحيح
Dialogue: 0,0:20:42.20,0:20:43.83,bl,,0,0,0,,شكرا لك-\Nشكرا لك-
Dialogue: 0,0:22:58.47,0:22:59.46,bl,,0,0,0,,لماذا صعدتم بسرعة؟
Dialogue: 0,0:22:59.54,0:23:00.97,bl,,0,0,0,,مالذي يحدث؟
Dialogue: 0,0:23:01.04,0:23:01.94,bl,,0,0,0,,!أسماك قرش
Dialogue: 0,0:23:04.74,0:23:06.90,bl,,0,0,0,,إذا كان المقصود هو الغروب
Dialogue: 0,0:23:06.98,0:23:10.04,bl,,0,0,0,,فنحن الآن في غرب الجزيرة
Dialogue: 0,0:23:10.12,0:23:13.05,bl,,0,0,0,,إذا،أين يكون الصندوق الثمين؟
Dialogue: 0,0:23:14.49,0:23:16.18,bl,,0,0,0,,هكذ إذا،لقد عرفت
Dialogue: 0,0:23:16.79,0:23:18.98,bl,,0,0,0,,تقول الجملة:حتى وإن لم تغب الشمس
Dialogue: 0,0:23:19.06,0:23:21.99,bl,,0,0,0,,فسيبقى القراصنة متألقين،هذه هي
Dialogue: 0,0:23:22.06,0:23:23.43,bl,,0,0,0,,...إنها تعني بالتأكيد
Dialogue: 0,0:23:23.93,0:23:25.29,bl,,0,0,0,,!البحر
Dialogue: 0,0:23:25.36,0:23:26.66,bl,,0,0,0,,حقا؟
Dialogue: 0,0:23:26.73,0:23:28.06,bl,,0,0,0,,وماذا بعد؟
Dialogue: 0,0:23:29.47,0:23:32.37,bl,,0,0,0,,هل سيكون الختم في أعماق البحر؟
Dialogue: 0,0:23:32.64,0:23:35.57,bl,,0,0,0,,هذا أمر مستحيل
Dialogue: 0,0:23:36.44,0:23:37.50,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:23:38.61,0:23:40.34,bl,,0,0,0,,انظروا هناك
Dialogue: 0,0:23:40.41,0:23:41.71,bl,,0,0,0,,ماذا؟
Dialogue: 0,0:23:42.01,0:23:43.50,bl,,0,0,0,,إنها أسماك
Dialogue: 0,0:23:43.58,0:23:45.48,bl,,0,0,0,,هل يمكن أن تكون الإنقليس؟
Dialogue: 0,0:23:45.65,0:23:47.64,bl,,0,0,0,,.لا يمكن أن يتواجد هذا النوع هنا
Dialogue: 0,0:23:47.72,0:23:48.98,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:23:49.72,0:23:51.15,bl,,0,0,0,,هيي،كونان
Dialogue: 0,0:23:52.12,0:23:54.46,bl,,0,0,0,,مالذي فهمته؟
Dialogue: 0,0:23:54.53,0:23:56.29,bl,,0,0,0,,هل اكتشفت شيئا ما؟
Dialogue: 0,0:24:11.88,0:24:14.78,bl,,0,0,0,,هل تعلمون لم تجمعت الأسماك هناك؟
Dialogue: 0,0:24:14.85,0:24:16.14,bl,,0,0,0,,...حسنا
Dialogue: 0,0:24:16.21,0:24:18.08,bl,,0,0,0,,لكي تلعب مع بعضها البعض
Dialogue: 0,0:24:18.15,0:24:18.84,bl,,0,0,0,,وعندما نكون جائعين
Dialogue: 0,0:24:18.92,0:24:21.65,bl,,0,0,0,,نجتمع مع بعضنا لأكل الطعام
Dialogue: 0,0:24:21.72,0:24:22.85,bl,,0,0,0,,إجابة صحيحة
Dialogue: 0,0:24:22.92,0:24:25.19,bl,,0,0,0,,حسنا،ماذا تأكل الأسماك؟
Dialogue: 0,0:24:25.42,0:24:27.45,bl,,0,0,0,,العوالق؟
Dialogue: 0,0:24:27.59,0:24:28.49,bl,,0,0,0,,إجابة صحيحة
Dialogue: 0,0:24:32.26,0:24:33.66,bl,,0,0,0,,مدهش
Dialogue: 0,0:24:36.70,0:24:38.23,bl,,0,0,0,,ما هذا المكان؟
Dialogue: 0,0:24:38.37,0:24:39.27,bl,,0,0,0,,انظروا
Dialogue: 0,0:24:44.04,0:24:45.91,bl,,0,0,0,,إنها يرعات البحر
Dialogue: 0,0:24:45.98,0:24:46.91,bl,,0,0,0,,هكذا إذا،لقد فهمت
Dialogue: 0,0:24:46.98,0:24:47.91,bl,,0,0,0,,حتى وإن لم تغب الشمس
Dialogue: 0,0:24:47.98,0:24:49.88,bl,,0,0,0,,فسيبقى القراصنة متألقين
Dialogue: 0,0:24:49.95,0:24:51.64,bl,,0,0,0,,إذا هذا ما تعنيه هذه الجملة
Dialogue: 0,0:24:51.82,0:24:52.81,bl,,0,0,0,,وجدته
Dialogue: 0,0:24:58.82,0:25:01.52,bl,,0,0,0,,تقول البطاقة:القراصنة النحليون سوف يضحكون
Dialogue: 0,0:25:01.59,0:25:04.12,bl,,0,0,0,,ستضحك حتى وإن لم تكن نحيلا
Dialogue: 0,0:25:09.07,0:25:10.50,bl,,0,0,0,,ما الأمر،هايبارا؟
Dialogue: 0,0:25:10.87,0:25:13.57,bl,,0,0,0,,لقد رأيت الرجال الذين يرتدون لباس الغوص
Dialogue: 0,0:25:13.64,0:25:15.23,bl,,0,0,0,,وملابسهم ملطخة بالدماء
Dialogue: 0,0:25:15.31,0:25:16.17,bl,,0,0,0,,ماذا؟
Dialogue: 0,0:25:16.68,0:25:18.84,bl,,0,0,0,,ولا أدري إن كانت ران معهم أيضا
Dialogue: 0,0:25:18.94,0:25:20.07,bl,,0,0,0,,كونان
Dialogue: 0,0:25:20.91,0:25:23.18,bl,,0,0,0,,أخبرت كونان أن باستطاعته الرحيل
Dialogue: 0,0:25:23.25,0:25:25.27,bl,,0,0,0,,تابعوا بحثكم عن الكنز
Dialogue: 0,0:25:25.35,0:25:26.61,bl,,0,0,0,,ماذا عنك،هايبارا؟
Dialogue: 0,0:25:26.69,0:25:28.18,bl,,0,0,0,,.لا تقلقا
Dialogue: 0,0:25:28.25,0:25:29.74,bl,,0,0,0,,لدي فكرة
Dialogue: 0,0:25:30.02,0:25:32.79,bl,,0,0,0,,لنعتمد على أنفسنا في العثور على الكنز
Dialogue: 0,0:25:32.86,0:25:34.52,bl,,0,0,0,,كلامك صحيح
Dialogue: 0,0:25:49.67,0:25:51.70,bl,,0,0,0,,...ران
Dialogue: 0,0:25:51.78,0:25:53.18,bl,,0,0,0,,كونان
Dialogue: 0,0:25:53.25,0:25:54.44,bl,,0,0,0,,وهايبارا أيضا
Dialogue: 0,0:25:54.51,0:25:56.24,bl,,0,0,0,,هل أنتم بخير جميعا؟
Dialogue: 0,0:25:56.88,0:25:58.35,bl,,0,0,0,,نحن بخير
Dialogue: 0,0:26:01.49,0:26:03.25,bl,,0,0,0,,كيف حاله الآن،سيد أويهرا ؟
Dialogue: 0,0:26:03.32,0:26:04.69,bl,,0,0,0,,كيمي
Dialogue: 0,0:26:04.76,0:26:06.69,bl,,0,0,0,,هل كنتم متواجدين في مكان الحادثة؟
Dialogue: 0,0:26:06.76,0:26:11.13,bl,,0,0,0,,لا،لقد كنت أغوص مع هاتين الفتاتين ورأينا الحادثة مصافدة
Dialogue: 0,0:26:11.20,0:26:13.26,bl,,0,0,0,,ولكن،ما أرعبني جدا
Dialogue: 0,0:26:13.33,0:26:15.36,bl,,0,0,0,,أن أسماك القرش من الممكن أن تهاجم الإنسان
Dialogue: 0,0:26:15.43,0:26:17.16,bl,,0,0,0,,يبدو أنهما محظوظين
Dialogue: 0,0:26:17.24,0:26:19.80,bl,,0,0,0,,فواحد منهم فقط هو الذي هوجم
Dialogue: 0,0:26:19.87,0:26:21.46,bl,,0,0,0,,مالذي تقصدينه؟
Dialogue: 0,0:26:21.54,0:26:22.84,bl,,0,0,0,,لا شيء
Dialogue: 0,0:26:22.91,0:26:24.43,bl,,0,0,0,,لقد أصابني الصداع المزمن
Dialogue: 0,0:26:24.51,0:26:27.74,bl,,0,0,0,,لقد تسببت أسماك القرش بضرر كبير
Dialogue: 0,0:26:27.81,0:26:28.61,bl,,0,0,0,,هذا أمر فظيع
Dialogue: 0,0:26:28.68,0:26:31.41,bl,,0,0,0,,إنها المرة الأولى التي أرى فيها أسماك القرش الضخمة
Dialogue: 0,0:26:38.76,0:26:39.75,bl,,0,0,0,,ما الأمر؟
Dialogue: 0,0:26:39.82,0:26:43.02,bl,,0,0,0,,لقد قالت الآنسة كيميكو أن هناك 3 أشخاص كانوا يغوصون في البحر
Dialogue: 0,0:26:43.09,0:26:45.69,bl,,0,0,0,,.ولكن واحد منهم فقط هو الذي هوجم
Dialogue: 0,0:26:45.76,0:26:47.29,bl,,0,0,0,,هل تظن أن الأمر محض مصادفة؟
Dialogue: 0,0:26:47.37,0:26:48.76,bl,,0,0,0,,هؤلاء الرجال غواصون ماهرون
Dialogue: 0,0:26:48.83,0:26:52.00,bl,,0,0,0,,من المفترض أن تكون لديهم معرفة عن كيفية التعامل مع أسماك القرش
Dialogue: 0,0:26:56.01,0:26:57.17,bl,,0,0,0,,ماذا وجدت؟
Dialogue: 0,0:26:58.08,0:26:59.41,bl,,0,0,0,,أكياس من البلاستيك
Dialogue: 0,0:27:02.95,0:27:04.21,bl,,0,0,0,,دم أسماك؟
Dialogue: 0,0:27:04.72,0:27:06.27,bl,,0,0,0,,يبدو أنه السبب
Dialogue: 0,0:27:06.35,0:27:07.25,bl,,0,0,0,,نعم
Dialogue: 0,0:27:07.32,0:27:10.19,bl,,0,0,0,,وضع شخص دم أسماك في هذا الكيس
Dialogue: 0,0:27:10.26,0:27:13.69,bl,,0,0,0,,بعد أن تم حشو الكيس في سترة الأمان
Dialogue: 0,0:27:13.76,0:27:17.32,bl,,0,0,0,,سيزيد ضغط الدم في كل 10 أمتار بمقدار ضغط واحد
Dialogue: 0,0:27:17.40,0:27:19.76,bl,,0,0,0,,لأن ضغط الهواء على مستوى البحر يساوي 1
Dialogue: 0,0:27:19.83,0:27:21.96,bl,,0,0,0,,وكلما ينزل الغواص،يرتفع الضغط ليصبح 2
Dialogue: 0,0:27:22.03,0:27:24.63,bl,,0,0,0,,وينزل الغواص بمقدار 30 متر تحت الماء
Dialogue: 0,0:27:24.70,0:27:26.57,bl,,0,0,0,,وعندما يرتفع ضغط الماء
Dialogue: 0,0:27:26.64,0:27:30.90,bl,,0,0,0,,سيتمزق الكيس المحشو في السترة
Dialogue: 0,0:27:31.88,0:27:35.04,bl,,0,0,0,,يستطيع القرش شم رائحة الدم على بعد بضعة كيلو مترات
Dialogue: 0,0:27:35.11,0:27:38.08,bl,,0,0,0,,ويشم رائحة الهيمجولبين
Dialogue: 0,0:27:38.15,0:27:39.67,bl,,0,0,0,,فحاسة شمه قوية جدا
Dialogue: 0,0:27:50.96,0:27:52.26,bl,,0,0,0,,إنها جريمة قتل
Dialogue: 0,0:27:52.33,0:27:54.92,bl,,0,0,0,,وفاعلها هو شخص واحد
Dialogue: 0,0:27:55.13,0:27:57.50,bl,,0,0,0,,هيي،أيها الشيطان يا من يلبس النظارات
Dialogue: 0,0:27:57.57,0:28:01.27,bl,,0,0,0,,مالذي تقحم نفسك فيه إلى هذه الدرجة؟
Dialogue: 0,0:28:01.34,0:28:03.03,bl,,0,0,0,,إنها قضية يا عمي
Dialogue: 0,0:28:03.11,0:28:04.47,bl,,0,0,0,,ماذا؟
Dialogue: 0,0:28:04.54,0:28:07.48,bl,,0,0,0,,لماذا لم تخبرني بها من قبل؟
Dialogue: 0,0:28:13.15,0:28:17.05,bl,,0,0,0,,أنا المتحري الشهير موري كوجورو
Dialogue: 0,0:28:21.93,0:28:24.05,bl,,0,0,0,,فك القرش يبدو كبيرا جدا
Dialogue: 0,0:28:24.13,0:28:27.10,bl,,0,0,0,,ولكنها عضة قرش لا أكثر
Dialogue: 0,0:28:27.17,0:28:29.96,bl,,0,0,0,,ولا يمكننا اعتبارها جريمة قتل،إنها حادثة
Dialogue: 0,0:28:36.24,0:28:38.23,bl,,0,0,0,,مالذي تقصدينه بقول آه؟
Dialogue: 0,0:28:38.74,0:28:39.54,bl,,0,0,0,,ما هذا؟
Dialogue: 0,0:28:47.49,0:28:49.39,bl,,0,0,0,,كيف حاله الآن،أيها الطبيب؟
Dialogue: 0,0:28:49.89,0:28:51.52,bl,,0,0,0,,لقد عملنا بجد كبير
Dialogue: 0,0:28:51.59,0:28:54.02,bl,,0,0,0,,ولكن النزيف كان حادا جدا
Dialogue: 0,0:28:54.39,0:28:55.42,bl,,0,0,0,,لقد فارق الحياة
Dialogue: 0,0:28:55.63,0:28:56.56,bl,,0,0,0,,!تبا
Dialogue: 0,0:28:56.93,0:28:58.09,bl,,0,0,0,,كيف لشيء كهذا أن يحدث
Dialogue: 0,0:28:58.16,0:29:00.15,bl,,0,0,0,,لقد كان حادثا عرضيا فحسب
Dialogue: 0,0:29:00.23,0:29:02.89,bl,,0,0,0,,لا،هذا لم يكن حادثا
Dialogue: 0,0:29:06.47,0:29:08.44,bl,,0,0,0,,أنت المتحري الشهير...؟
Dialogue: 0,0:29:08.64,0:29:10.70,bl,,0,0,0,,موري كوجورو
Dialogue: 0,0:29:10.78,0:29:11.67,bl,,0,0,0,,أبي
Dialogue: 0,0:29:11.74,0:29:12.90,bl,,0,0,0,,عمي
Dialogue: 0,0:29:12.98,0:29:14.60,bl,,0,0,0,,هيي،أنت تقول بأنها لم تكن حادثة
Dialogue: 0,0:29:14.68,0:29:16.24,bl,,0,0,0,,بماذا تقصد بذلك؟
Dialogue: 0,0:29:16.31,0:29:21.15,bl,,0,0,0,,هناك طريقة تحرض بها أسماك القرش لكي تهاجمك
Dialogue: 0,0:29:21.22,0:29:23.62,bl,,0,0,0,,كيس من دم الأسماك يكفي لفعل ذلك
Dialogue: 0,0:29:23.69,0:29:27.09,bl,,0,0,0,,مثل الذي كان في هذه السترة
Dialogue: 0,0:29:27.96,0:29:32.23,bl,,0,0,0,,بالإضافة،سمعت أنكما صائدي كنوز
Dialogue: 0,0:29:32.30,0:29:34.82,bl,,0,0,0,,فهذا الأمر لن يكون صعبا عليكما
Dialogue: 0,0:29:37.74,0:29:39.07,bl,,0,0,0,,ران
Dialogue: 0,0:29:40.47,0:29:43.57,bl,,0,0,0,,أيت يتم وضع سترات الغوص في عادة؟
Dialogue: 0,0:29:43.64,0:29:44.63,bl,,0,0,0,,بخصوص هذا
Dialogue: 0,0:29:44.71,0:29:47.58,bl,,0,0,0,,ليس من الممكن أن تكون غرف الفنادق هي المكان المناسب
Dialogue: 0,0:29:47.65,0:29:50.91,bl,,0,0,0,,هذه السترات مكانها في متجر الغوص
Dialogue: 0,0:29:50.98,0:29:53.47,bl,,0,0,0,,قم بسؤالهم أيضا عن أسطوانتي الأوكسجين
Dialogue: 0,0:30:08.77,0:30:10.70,bl,,0,0,0,,هنا يتم بيع واستئجار سترات الغوص
Dialogue: 0,0:30:10.77,0:30:11.86,bl,,0,0,0,,ويتم حفظها هنا أيضا
Dialogue: 0,0:30:12.57,0:30:15.00,bl,,0,0,0,,ويستطيع من أراد الحصول عليها
Dialogue: 0,0:30:15.47,0:30:17.00,bl,,0,0,0,,كودو
Dialogue: 0,0:30:22.25,0:30:23.31,bl,,0,0,0,,ما الأمر،هايبارا؟
Dialogue: 0,0:30:24.65,0:30:25.78,bl,,0,0,0,,انظر إلى هذا
Dialogue: 0,0:30:26.42,0:30:29.22,bl,,0,0,0,,هذه المنطقة مبللة دائما
Dialogue: 0,0:30:29.29,0:30:31.12,bl,,0,0,0,,وأرى أن هذه الآثار حديثة جدا
Dialogue: 0,0:30:31.42,0:30:35.02,bl,,0,0,0,,أرجوا أن تأخذي هذا
Dialogue: 0,0:30:35.09,0:30:37.08,bl,,0,0,0,,فلدي بعض الأمور الأخرى لأتحرى عنها
Dialogue: 0,0:30:37.16,0:30:37.86,bl,,0,0,0,,،واو
Dialogue: 0,0:30:37.93,0:30:41.09,bl,,0,0,0,,منذ متى أصبحت مساعدتك؟
Dialogue: 0,0:30:41.17,0:30:43.29,bl,,0,0,0,,لست مساعدتي
Dialogue: 0,0:30:43.37,0:30:44.49,bl,,0,0,0,,بل شريكتي في العمل
Dialogue: 0,0:30:45.67,0:30:47.37,bl,,0,0,0,,تلاعب في الألفاظ فحسب
Dialogue: 0,0:30:47.64,0:30:48.87,bl,,0,0,0,,إذا بالتوفيق لك
Dialogue: 0,0:30:49.31,0:30:50.24,bl,,0,0,0,,حسنا
Dialogue: 0,0:30:58.85,0:31:00.11,bl,,0,0,0,,لو سمحت يا آنسة
Dialogue: 0,0:31:00.19,0:31:01.55,bl,,0,0,0,,ما الأمر؟
Dialogue: 0,0:31:01.62,0:31:03.88,bl,,0,0,0,,من الذي كان يعتني بالمتجر ليلة البارحة؟
Dialogue: 0,0:31:03.96,0:31:05.95,bl,,0,0,0,,هل تلعب دور المتحري؟
Dialogue: 0,0:31:07.33,0:31:09.32,bl,,0,0,0,,لقد عدت إلى المنزل مبكرا ليلة البارحة
Dialogue: 0,0:31:09.39,0:31:12.06,bl,,0,0,0,,وغادرت كيميكو إلى مكان ما قرب الميناء
Dialogue: 0,0:31:12.13,0:31:13.65,bl,,0,0,0,,لذا لم يكن هناك أحد في المساء
Dialogue: 0,0:31:13.73,0:31:14.86,bl,,0,0,0,,فهمت
Dialogue: 0,0:31:14.93,0:31:18.46,bl,,0,0,0,,ولكن هذه الجزيرة لا يوجد عليها لصوص
Dialogue: 0,0:31:18.54,0:31:21.03,bl,,0,0,0,,لذا من عادتنا ألا نغلق المتجر
Dialogue: 0,0:31:21.11,0:31:24.40,bl,,0,0,0,,كيميكو،ألم يكن دورك ليلة أمس لمراقبة المتجر؟
Dialogue: 0,0:31:24.74,0:31:27.21,bl,,0,0,0,,نعم،ولكن لماذا تسألين؟
Dialogue: 0,0:31:27.28,0:31:28.84,bl,,0,0,0,,بسبب هذا المتحري الصغير
Dialogue: 0,0:31:28.91,0:31:30.61,bl,,0,0,0,,إنه يسأل أسئلة كثيرة
Dialogue: 0,0:31:31.92,0:31:33.51,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:31:34.09,0:31:37.11,bl,,0,0,0,,إذا فأنت تقوم بالتحري عن قضية السترات وتريد معرفة ما جرى بالضبط
Dialogue: 0,0:31:37.96,0:31:41.05,bl,,0,0,0,,ولكني كنت قريبة ليلة البارحة
Dialogue: 0,0:31:41.13,0:31:43.15,bl,,0,0,0,,وفي الصباح،عندما وصلت
Dialogue: 0,0:31:43.23,0:31:44.99,bl,,0,0,0,,كان الباب مفتوحا
Dialogue: 0,0:31:45.06,0:31:47.46,bl,,0,0,0,,لذا من المحتمل أن يكون هناك شخص ما قد جاء إلى هنا
Dialogue: 0,0:31:51.04,0:31:51.97,bl,,0,0,0,,إذا
Dialogue: 0,0:31:52.37,0:31:54.43,bl,,0,0,0,,هل توصلت إلى دليل ما؟
Dialogue: 0,0:31:54.51,0:31:55.56,bl,,0,0,0,,لا
Dialogue: 0,0:31:56.17,0:31:58.40,bl,,0,0,0,,لم أتوصل إلى شيء بعد
Dialogue: 0,0:31:59.14,0:32:00.84,bl,,0,0,0,,إذا استطعت إيجاد خيوط فسيكون ذلك جيدا
Dialogue: 0,0:32:04.12,0:32:05.21,bl,,0,0,0,,ما الأمر؟
Dialogue: 0,0:32:05.32,0:32:06.81,bl,,0,0,0,,ما أمرك أنت؟
Dialogue: 0,0:32:06.89,0:32:08.48,bl,,0,0,0,,كونان،مالذي تحاول فعله؟
Dialogue: 0,0:32:08.55,0:32:12.25,bl,,0,0,0,,ألم تجد كنز القراصنة حتى الآن؟
Dialogue: 0,0:32:12.32,0:32:15.02,bl,,0,0,0,,إن لديكم حريتكم في التحرك والتخطيط
Dialogue: 0,0:32:15.09,0:32:17.22,bl,,0,0,0,,.لن نستطيع الإكمال بمفردنا
Dialogue: 0,0:32:19.73,0:32:21.56,bl,,0,0,0,,أين أنتم الآن؟
Dialogue: 0,0:32:21.63,0:32:23.69,bl,,0,0,0,,نحن نتحدث من فوق الجسر
Dialogue: 0,0:32:23.77,0:32:25.26,bl,,0,0,0,,من فوق الجسر؟
Dialogue: 0,0:32:25.34,0:32:27.67,bl,,0,0,0,,إنه موجود على خريطة الكنز
Dialogue: 0,0:32:27.74,0:32:29.54,bl,,0,0,0,,خريطة الكنز؟
Dialogue: 0,0:32:29.97,0:32:31.74,bl,,0,0,0,,فهمت
Dialogue: 0,0:32:31.98,0:32:33.64,bl,,0,0,0,,يجب أن تسرع
Dialogue: 0,0:32:33.71,0:32:34.94,bl,,0,0,0,,حسنا،حسنا
Dialogue: 0,0:32:35.81,0:32:37.28,bl,,0,0,0,,لا يعتمد عليهم
Dialogue: 0,0:32:38.15,0:32:39.78,bl,,0,0,0,,هيي،هايبارا ألا تريدين الذهاب؟
Dialogue: 0,0:32:39.85,0:32:41.18,bl,,0,0,0,,لا أريد
Dialogue: 0,0:32:41.25,0:32:42.74,bl,,0,0,0,,كما توقعت
Dialogue: 0,0:32:44.72,0:32:46.88,bl,,0,0,0,,مالذي يجري هنا؟
Dialogue: 0,0:32:46.96,0:32:48.82,bl,,0,0,0,,الطريق مغلق
Dialogue: 0,0:32:49.36,0:32:50.19,bl,,0,0,0,,تبا
Dialogue: 0,0:32:50.73,0:32:51.66,bl,,0,0,0,,عفوا
Dialogue: 0,0:32:52.40,0:32:53.63,bl,,0,0,0,,هل أنت تائه؟
Dialogue: 0,0:32:54.93,0:32:58.13,bl,,0,0,0,,من المفترض أن يكون أصدقاؤك فوق الجسر المحايد
Dialogue: 0,0:32:58.20,0:32:59.97,bl,,0,0,0,,أريد الذهاب إلى هناك
Dialogue: 0,0:33:00.04,0:33:02.27,bl,,0,0,0,,ولكن لا يوجد طريق سالكة هنا
Dialogue: 0,0:33:02.34,0:33:04.10,bl,,0,0,0,,حقا،آسف
Dialogue: 0,0:33:04.18,0:33:07.94,bl,,0,0,0,,تسبب زلزال الأسبوع الماضي بحطام تجويف المدخل
Dialogue: 0,0:33:08.01,0:33:11.50,bl,,0,0,0,,اتجه إلى آخر هذا الطريق عند المنعطف
Dialogue: 0,0:33:11.58,0:33:13.18,bl,,0,0,0,,هل تستطيع الذهاب لوحدك؟
Dialogue: 0,0:33:14.29,0:33:15.75,bl,,0,0,0,,شكرا لك،سيد أيوا ناجا
Dialogue: 0,0:33:16.65,0:33:18.28,bl,,0,0,0,,كن حذرا
Dialogue: 0,0:33:18.36,0:33:19.22,bl,,0,0,0,,حسنا
Dialogue: 0,0:33:27.17,0:33:30.03,bl,,0,0,0,,لا أستطيع المتابعة
Dialogue: 0,0:33:30.10,0:33:32.40,bl,,0,0,0,,عندما يصل كونان سيتكفل بالأمر
Dialogue: 0,0:33:32.47,0:33:34.84,bl,,0,0,0,,لا نريد أن نعتمد على كونان في كل الأوقات
Dialogue: 0,0:33:34.91,0:33:36.77,bl,,0,0,0,,يجب أن نعتمد على أنفسنا
Dialogue: 0,0:33:37.88,0:33:38.60,bl,,0,0,0,,هناك؟
Dialogue: 0,0:33:38.68,0:33:41.30,bl,,0,0,0,,هناك لافتة في آخر الجسر مكتوب عليها شيء ما
Dialogue: 0,0:33:43.68,0:33:44.94,bl,,0,0,0,,ماذا كتب عليها يا ترى؟
Dialogue: 0,0:33:45.02,0:33:45.95,bl,,0,0,0,,لنذهب ونرى ما فيها
Dialogue: 0,0:33:46.02,0:33:46.92,bl,,0,0,0,,آه
Dialogue: 0,0:33:51.62,0:33:53.32,bl,,0,0,0,,أنا جائع جدا
Dialogue: 0,0:33:54.59,0:33:57.06,bl,,0,0,0,,هيي،انتظراني
Dialogue: 0,0:34:12.48,0:34:13.41,bl,,0,0,0,,!أرجوك توقف مكانك
Dialogue: 0,0:34:14.45,0:34:15.84,bl,,0,0,0,,!لا تتمايل
Dialogue: 0,0:34:16.78,0:34:18.72,bl,,0,0,0,,لماذا؟
Dialogue: 0,0:34:18.78,0:34:20.38,bl,,0,0,0,,امم...امم
Dialogue: 0,0:34:20.45,0:34:22.42,bl,,0,0,0,,لأن هذا الجسر مخصص لمن تقل أجسامهم عن 40 كيلو جراما
Dialogue: 0,0:34:22.89,0:34:24.55,bl,,0,0,0,,ما الأمر؟
Dialogue: 0,0:34:24.62,0:34:26.39,bl,,0,0,0,,كم وزنك يا جينتا؟
Dialogue: 0,0:34:26.46,0:34:27.62,bl,,0,0,0,,وزني هو 39 كيلو جراما
Dialogue: 0,0:34:27.69,0:34:28.66,bl,,0,0,0,,!كاذب
Dialogue: 0,0:34:30.26,0:34:32.73,bl,,0,0,0,,في الحقيقة وزني هو 45 كيلو جراما
Dialogue: 0,0:34:32.80,0:34:34.20,bl,,0,0,0,,لا تتحرك
Dialogue: 0,0:34:34.27,0:34:35.25,bl,,0,0,0,,هذا الجسر
Dialogue: 0,0:34:35.33,0:34:38.20,bl,,0,0,0,,مخصص للناس الذين تقل أوزانهم عن 40 كيلو جراما
Dialogue: 0,0:34:38.27,0:34:40.64,bl,,0,0,0,,هل أنت متأكد؟
Dialogue: 0,0:34:40.71,0:34:42.50,bl,,0,0,0,,هكذا إذا،لقد فهمت
Dialogue: 0,0:34:42.57,0:34:44.34,bl,,0,0,0,,القراصنة النحيلون سيضحكون
Dialogue: 0,0:34:44.41,0:34:46.67,bl,,0,0,0,,لأنهم سيتمكنون من عبور الجسر بسهولة كبيرة
Dialogue: 0,0:34:46.74,0:34:48.08,bl,,0,0,0,,أنت محقة
Dialogue: 0,0:34:48.15,0:34:50.08,bl,,0,0,0,,سيضحك القرصان النحيل
Dialogue: 0,0:34:50.15,0:34:52.48,bl,,0,0,0,,على موقف القرصان السمين
Dialogue: 0,0:34:53.62,0:34:56.64,bl,,0,0,0,,أنقذوني أرجوكم،أمي
Dialogue: 0,0:34:57.76,0:34:58.59,bl,,0,0,0,,وجدته
Dialogue: 0,0:35:03.46,0:35:06.26,bl,,0,0,0,,بكاء قرصان"،ماذا يعني هذا؟"
Dialogue: 0,0:35:06.83,0:35:10.43,bl,,0,0,0,,بقيت أربع دقائق للتوقف،يجب علينا الرجوع والإكمال غدا
Dialogue: 0,0:35:11.20,0:35:13.17,bl,,0,0,0,,ولكن كيف سنعود؟
Dialogue: 0,0:35:13.24,0:35:14.70,bl,,0,0,0,,هذا صحيح
Dialogue: 0,0:35:14.77,0:35:17.04,bl,,0,0,0,,جينتا يجلس جلسة القرفصاء هناك
Dialogue: 0,0:35:17.11,0:35:18.51,bl,,0,0,0,,وإذا عبرنا الجسر وهو موجود
Dialogue: 0,0:35:18.58,0:35:20.48,bl,,0,0,0,,فسيتقطع هذا الجسر ويسقط بكل تأكيد
Dialogue: 0,0:35:20.88,0:35:23.51,bl,,0,0,0,,أنتم الثلاثة،هل وجدتم شيئا؟
Dialogue: 0,0:35:24.15,0:35:26.38,bl,,0,0,0,,كونان،لقد وجدنا الكنز
Dialogue: 0,0:35:26.45,0:35:28.39,bl,,0,0,0,,أحسنتما عملا
Dialogue: 0,0:35:28.45,0:35:31.42,bl,,0,0,0,,"التلميح القادم هو:"بكاء قرصان
Dialogue: 0,0:35:31.49,0:35:32.35,bl,,0,0,0,,لكن هذا الجسر
Dialogue: 0,0:35:32.42,0:35:34.45,bl,,0,0,0,,لا يتحمل أكثر من 40 كيلو جراما
Dialogue: 0,0:35:34.53,0:35:35.99,bl,,0,0,0,,وسيسقط
Dialogue: 0,0:35:36.06,0:35:37.89,bl,,0,0,0,,هل هذا ما كتب فقط؟
Dialogue: 0,0:35:37.96,0:35:40.36,bl,,0,0,0,,لا،لقد كتب في الأعلى
Dialogue: 0,0:35:40.43,0:35:42.80,bl,,0,0,0,,أن الأشخاص الذين يزيد وزنهم عن 40 كيلو جراما لن يسمح لهم بالمرور
Dialogue: 0,0:35:43.50,0:35:44.83,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:35:44.90,0:35:47.93,bl,,0,0,0,,لذلك كان القراصنة ذوو الوزن الخفيف يضحكون
Dialogue: 0,0:35:48.01,0:35:50.67,bl,,0,0,0,,حسنا لا مشكلة،اكملوا الطريق
Dialogue: 0,0:35:50.74,0:35:53.07,bl,,0,0,0,,البطاقة الأولى:مجرد تلميح
Dialogue: 0,0:35:53.14,0:35:55.04,bl,,0,0,0,,الأشخاص الذين يكون وزنهم أقل من 40 كيلو جراما
Dialogue: 0,0:35:55.11,0:35:57.38,bl,,0,0,0,,وأظن أنه تقدير وزن الأطفال والنساء حتى يتمكنوا من عبور هذا الجسر بحرية
Dialogue: 0,0:35:57.45,0:36:01.28,bl,,0,0,0,,هؤلاء الناس ليسوا هم فقط من يستطيعوا العبور،كما أنه لا يعقل بأنه لا يوجد من البالغين أحد قد عبر عليه
Dialogue: 0,0:36:27.88,0:36:30.04,bl,,0,0,0,,شكرا جزيلا لجهوك حضرة المفتش
Dialogue: 0,0:36:30.65,0:36:34.31,bl,,0,0,0,,لكن هل من الضروري أن توكل بهذا العمل؟
Dialogue: 0,0:36:34.39,0:36:36.55,bl,,0,0,0,,في الحقيقة لقد سمعنا أن جريمة غريبة جدا وقعت هنا ففضلنا المجيء
Dialogue: 0,0:36:36.75,0:36:37.98,bl,,0,0,0,,حضرة المفتش
Dialogue: 0,0:36:38.06,0:36:40.32,bl,,0,0,0,,لقد تم استلام الأمر هل لديك ما نفعله غير ذلك؟
Dialogue: 0,0:36:40.39,0:36:42.59,bl,,0,0,0,,حسنا،سأحاول تفهم الحالة أولا،ابذلوا ما بوسعكم الآن
Dialogue: 0,0:36:42.66,0:36:44.69,bl,,0,0,0,,حاضر
Dialogue: 0,0:36:47.73,0:36:50.33,bl,,0,0,0,,متى سنبقى سجناء هكذا؟
Dialogue: 0,0:36:50.40,0:36:52.89,bl,,0,0,0,,من المفترض أن نكون نحن الضحايا الآن،صحيح؟
Dialogue: 0,0:36:52.97,0:36:53.83,bl,,0,0,0,,إذا كنت ضحية حقا
Dialogue: 0,0:36:53.90,0:36:57.24,bl,,0,0,0,,كم إجابة أجبت عليها بصدق؟
Dialogue: 0,0:36:58.61,0:37:02.31,bl,,0,0,0,,أنتما،هل رأيتما هذان الاثنين من قبل؟
Dialogue: 0,0:37:05.48,0:37:07.85,bl,,0,0,0,,في الحقيقة،لم أرهما من قبل
Dialogue: 0,0:37:07.92,0:37:11.12,bl,,0,0,0,,هذان الاثنان قاما بسرقة المتجر الكبير في السوق المركزي
Dialogue: 0,0:37:11.19,0:37:12.78,bl,,0,0,0,,وأخذا منه المال نقدا
Dialogue: 0,0:37:13.09,0:37:15.79,bl,,0,0,0,,أما أنتما فنحن نعتقد بأن السارق أحد رفقائكم
Dialogue: 0,0:37:15.86,0:37:18.52,bl,,0,0,0,,وقد جعلتماه يقوم بهذا العمل من أجلكما،صحيح؟
Dialogue: 0,0:37:18.60,0:37:20.12,bl,,0,0,0,,أنا لا أعرف عن أي هراء تتحدثين
Dialogue: 0,0:37:20.20,0:37:22.83,bl,,0,0,0,,كما أن هذه التفاهات لا تهمني أبدا
Dialogue: 0,0:37:22.90,0:37:23.99,bl,,0,0,0,,!كاذب
Dialogue: 0,0:37:24.07,0:37:26.50,bl,,0,0,0,,هل لديك دليل على ذلك؟
Dialogue: 0,0:37:26.57,0:37:28.70,bl,,0,0,0,,شهادة اثنان فقط لا تكفي
Dialogue: 0,0:37:30.31,0:37:31.50,bl,,0,0,0,,حسنا...حسنا
Dialogue: 0,0:37:32.18,0:37:33.87,bl,,0,0,0,,أرجوا من الجميع الهدوء
Dialogue: 0,0:37:33.94,0:37:36.50,bl,,0,0,0,,أرجوا منكم تناول هذا العصير الرائع
Dialogue: 0,0:37:52.86,0:37:56.73,bl,,0,0,0,,إذا لم يكن لديكم أي سؤال آخر
Dialogue: 0,0:37:56.80,0:37:59.63,bl,,0,0,0,,سأعود إلى غرفتي حالا
Dialogue: 0,0:37:59.70,0:38:02.50,bl,,0,0,0,,هل أنتما حقا لا تعرفان هذان الشخصان؟
Dialogue: 0,0:38:02.57,0:38:04.73,bl,,0,0,0,,...هل هذا صحيح
Dialogue: 0,0:38:04.81,0:38:05.97,bl,,0,0,0,,سيد ماتسوموتو
Dialogue: 0,0:38:06.14,0:38:08.01,bl,,0,0,0,,صحيح نحن لا نعرفهما أبدا
Dialogue: 0,0:38:08.55,0:38:09.91,bl,,0,0,0,,وداعا
Dialogue: 0,0:38:10.05,0:38:11.67,bl,,0,0,0,,المعذرة
Dialogue: 0,0:38:11.75,0:38:13.51,bl,,0,0,0,,هل يمكنني أن أستعير قداحتك؟
Dialogue: 0,0:38:13.58,0:38:15.18,bl,,0,0,0,,لقد فقدت قداحتي
Dialogue: 0,0:38:16.12,0:38:17.21,bl,,0,0,0,,خذ
Dialogue: 0,0:38:17.29,0:38:18.72,bl,,0,0,0,,المعذرة
Dialogue: 0,0:38:26.26,0:38:28.09,bl,,0,0,0,,شكرا
Dialogue: 0,0:38:29.63,0:38:33.03,bl,,0,0,0,,إنها مضيعة للوقت
Dialogue: 0,0:38:34.70,0:38:38.27,bl,,0,0,0,,هل بإمكاني أن أشرب كأسا واحدا؟
Dialogue: 0,0:38:38.34,0:38:39.83,bl,,0,0,0,,فأنا عطش جدا
Dialogue: 0,0:38:39.91,0:38:43.40,bl,,0,0,0,,اشرب،للأسف لم يشرب أحدهما شيئا منه
Dialogue: 0,0:38:43.48,0:38:45.78,bl,,0,0,0,,حرصا منهما على عدم ترك بصمات أصابعهما في المكان أصلا
Dialogue: 0,0:38:47.58,0:38:50.02,bl,,0,0,0,,على كل حال،حتى لو طبعت بصمات الأصابع
Dialogue: 0,0:38:50.09,0:38:51.52,bl,,0,0,0,,سيستغرق فحصها وقتا طويلا على هذه الجزيرة،أليس كذلك؟
Dialogue: 0,0:38:51.59,0:38:53.85,bl,,0,0,0,,أعتقد أنه لو تم تفحصها فلن يؤدي ذلك إلى نتائج مهمة لنا
Dialogue: 0,0:38:53.92,0:38:55.32,bl,,0,0,0,,لأن المشكلة هي أننا في هذه الجزيرة ولا يمكننا فحص البصمات في الوقت المحدد
Dialogue: 0,0:38:55.39,0:38:57.33,bl,,0,0,0,,أو نعود إلى العاصمة
Dialogue: 0,0:38:57.96,0:38:59.66,bl,,0,0,0,,بالمناسبة تاكاجي
Dialogue: 0,0:38:59.73,0:39:01.46,bl,,0,0,0,,هل تدخن حقا؟
Dialogue: 0,0:39:02.43,0:39:03.42,bl,,0,0,0,,آسف
Dialogue: 0,0:39:04.63,0:39:07.16,bl,,0,0,0,,ربما نجد بصمات أصابعهما على هذه
Dialogue: 0,0:39:13.91,0:39:16.28,bl,,0,0,0,,خلال فترة الطعام هذه،مالذي تريدون فعله؟
Dialogue: 0,0:39:16.48,0:39:18.14,bl,,0,0,0,,!تخمين اللغز التافه
Dialogue: 0,0:39:19.18,0:39:20.38,bl,,0,0,0,,هذا صحيح
Dialogue: 0,0:39:20.45,0:39:21.58,bl,,0,0,0,,انسحب
Dialogue: 0,0:39:21.65,0:39:22.74,bl,,0,0,0,,سنفعلها
Dialogue: 0,0:39:22.82,0:39:25.25,bl,,0,0,0,,لقد حان الوقت للتخمين...صحيح؟
Dialogue: 0,0:39:27.46,0:39:30.89,bl,,0,0,0,,في قاع البحر وبجوار بقايا مملكة الأسماك
Dialogue: 0,0:39:30.96,0:39:33.56,bl,,0,0,0,,وجد الملك السابق وقد كان يعمل أعمال سيئة
Dialogue: 0,0:39:33.63,0:39:36.39,bl,,0,0,0,,إنه وريث الملك سمك الأبراميس والسؤال هو
Dialogue: 0,0:39:36.47,0:39:40.49,bl,,0,0,0,,خمن أي نوع من الأسماك كان الملك السابق؟
Dialogue: 0,0:39:40.57,0:39:41.80,bl,,0,0,0,,الحبار
Dialogue: 0,0:39:41.87,0:39:43.07,bl,,0,0,0,,الأخطبوط
Dialogue: 0,0:39:43.14,0:39:44.63,bl,,0,0,0,,السرطان
Dialogue: 0,0:39:44.71,0:39:46.51,bl,,0,0,0,,أي واحد منهم هو الصحيح؟
Dialogue: 0,0:39:50.51,0:39:52.31,bl,,0,0,0,,عرفت
Dialogue: 0,0:39:52.38,0:39:53.78,bl,,0,0,0,,إنه رقم ثلاثة السرطان
Dialogue: 0,0:39:53.85,0:39:55.04,bl,,0,0,0,,لماذا؟
Dialogue: 0,0:39:55.12,0:39:56.21,bl,,0,0,0,,لأنه يملك يدين كالمقص
Dialogue: 0,0:39:56.29,0:39:57.72,bl,,0,0,0,,فيمكنه بذلك قطع رقبة أي شخص يعصي أوامره
Dialogue: 0,0:39:57.79,0:40:00.09,bl,,0,0,0,,هذا فظيع
Dialogue: 0,0:40:01.16,0:40:02.62,bl,,0,0,0,,هيه أنت
Dialogue: 0,0:40:03.63,0:40:05.62,bl,,0,0,0,,هذا قاس جدا
Dialogue: 0,0:40:05.70,0:40:07.46,bl,,0,0,0,,آسف
Dialogue: 0,0:40:08.10,0:40:09.36,bl,,0,0,0,,إنه الأخطبوط،صحيح؟
Dialogue: 0,0:40:09.43,0:40:10.90,bl,,0,0,0,,لماذا؟
Dialogue: 0,0:40:10.97,0:40:15.20,bl,,0,0,0,,الملك الأخطبوط حدد مكان ملكية البلاد وربما يكون قد استولى على الكنز بمفرده أيضا
Dialogue: 0,0:40:15.27,0:40:17.71,bl,,0,0,0,,تخيلوا معي ذلك الأخطبوط وهو يقوم بذلك من فضلكم أخطبوط صغير وأصلع الرأس
Dialogue: 0,0:40:18.81,0:40:21.64,bl,,0,0,0,,بمعنى آخر الأخطبوط  الصغير هو الملك ،أليس كذلك؟
Dialogue: 0,0:40:21.71,0:40:22.91,bl,,0,0,0,,نعم وبكل تأكيد
Dialogue: 0,0:40:22.98,0:40:24.45,bl,,0,0,0,,إجابة خاطئة
Dialogue: 0,0:40:24.85,0:40:26.84,bl,,0,0,0,,حسنا،إذا الإجابة الصحيحة هي الحبار
Dialogue: 0,0:40:27.72,0:40:29.05,bl,,0,0,0,,لماذا؟
Dialogue: 0,0:40:30.05,0:40:31.54,bl,,0,0,0,,آسف على التأخير
Dialogue: 0,0:40:31.62,0:40:34.49,bl,,0,0,0,,سأقوم بالإجابة على هذا اللغز
Dialogue: 0,0:40:35.33,0:40:38.78,bl,,0,0,0,,والد الملك أو والدته جلالته أو جلالتها
Dialogue: 0,0:40:38.86,0:40:41.46,bl,,0,0,0,,أعتقد أن الملك هو
Dialogue: 0,0:40:41.53,0:40:43.33,bl,,0,0,0,,جلالة الحبار
Dialogue: 0,0:40:43.40,0:40:45.70,bl,,0,0,0,,نعم الإجابة هي الحبار
Dialogue: 0,0:40:45.77,0:40:47.53,bl,,0,0,0,,هذا صحيح
Dialogue: 0,0:40:48.57,0:40:49.97,bl,,0,0,0,,....إجابة صحيحة
Dialogue: 0,0:40:50.04,0:40:52.07,bl,,0,0,0,,هذا غريب فعلا
Dialogue: 0,0:40:54.08,0:40:56.44,bl,,0,0,0,,كونان
Dialogue: 0,0:40:58.82,0:41:00.21,bl,,0,0,0,,...إذا هو فعلا
Dialogue: 0,0:41:00.28,0:41:01.34,bl,,0,0,0,,الحبار،صحيح؟
Dialogue: 0,0:41:05.12,0:41:07.09,bl,,0,0,0,,القمر جميل جدا هذه الليلة
Dialogue: 0,0:41:07.16,0:41:08.35,bl,,0,0,0,,صحيح
Dialogue: 0,0:41:09.23,0:41:12.72,bl,,0,0,0,,لماذا تفضل البقاء هنا على البقاء في المدينة مع الجميع؟
Dialogue: 0,0:41:15.00,0:41:16.63,bl,,0,0,0,,حسنا،في الحقيقة لدينا هنا أسلوب واحد للعيش
Dialogue: 0,0:41:16.70,0:41:20.00,bl,,0,0,0,,وهو صيد الأسماك
Dialogue: 0,0:41:20.20,0:41:23.17,bl,,0,0,0,,وقد أخبرني اثنان من أقربائي يعملون في إدارة المرفأ
Dialogue: 0,0:41:23.24,0:41:25.57,bl,,0,0,0,,أنهم يريدون زيادة أعداد السياح في الإجازة القادمة
Dialogue: 0,0:41:25.64,0:41:26.87,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:41:27.18,0:41:28.47,bl,,0,0,0,,إذا ليس لديك عمل آخر تقوم به؟
Dialogue: 0,0:41:28.55,0:41:31.81,bl,,0,0,0,,عملي في حياتي هو
Dialogue: 0,0:41:32.78,0:41:35.88,bl,,0,0,0,,صيد الكنوز
Dialogue: 0,0:41:36.75,0:41:38.74,bl,,0,0,0,,بما أنك صائد كنوز
Dialogue: 0,0:41:38.82,0:41:41.66,bl,,0,0,0,,هل يوجد كنوز هنا حقا؟
Dialogue: 0,0:41:42.49,0:41:46.49,bl,,0,0,0,,حاليا لا أعرف مكانه وكما قيل الذئب لن يقف مكتوف الأيدي في غياب فريسته
Dialogue: 0,0:41:46.60,0:41:50.29,bl,,0,0,0,,لأنه لا يريد أن يكون فريسة بالضرورة
Dialogue: 0,0:41:50.37,0:41:52.16,bl,,0,0,0,,لم أفهم شيئا
Dialogue: 0,0:41:52.24,0:41:54.36,bl,,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:41:54.44,0:41:57.53,bl,,0,0,0,,.حاول أن تفكر فيها مرة أخرى يا جينتا
Dialogue: 0,0:41:57.61,0:41:58.94,bl,,0,0,0,,هيي،أيها الصغير
Dialogue: 0,0:41:59.21,0:42:01.91,bl,,0,0,0,,هل هذا تلميح؟
Dialogue: 0,0:42:01.98,0:42:03.74,bl,,0,0,0,,نعم
Dialogue: 0,0:42:03.81,0:42:05.75,bl,,0,0,0,,إذا بكاء القرصان
Dialogue: 0,0:42:05.82,0:42:07.18,bl,,0,0,0,,هل تعرف ما معنى هذا؟
Dialogue: 0,0:42:07.25,0:42:10.15,bl,,0,0,0,,بكاء قرصان؟
Dialogue: 0,0:42:10.22,0:42:12.69,bl,,0,0,0,,يبدو أن هناك شيئا غريبا لا نعرفه
Dialogue: 0,0:42:12.76,0:42:14.72,bl,,0,0,0,,دعونا نذهب لنلقي نظرة في الخارج الآن؟
Dialogue: 0,0:42:14.79,0:42:16.69,bl,,0,0,0,,نخرج الآن؟
Dialogue: 0,0:42:16.76,0:42:19.73,bl,,0,0,0,,إنها مظلمة في الخارج،لنذهب في الغد
Dialogue: 0,0:42:19.80,0:42:22.46,bl,,0,0,0,,نحن لا نعرف الطقس غدا هل سيكون جيدا أم متدهورا؟
Dialogue: 0,0:42:22.53,0:42:24.59,bl,,0,0,0,,ماذا تقصد بذلك؟
Dialogue: 0,0:42:25.20,0:42:29.14,bl,,0,0,0,,ربما تهب غدا رياح قادمة من الجنوب
Dialogue: 0,0:42:29.21,0:42:30.93,bl,,0,0,0,,وأشعر أنها ستكون قوية جدا
Dialogue: 0,0:42:31.01,0:42:33.48,bl,,0,0,0,,هذا ما يعرف بتنبؤات الطقس،صحيح؟
Dialogue: 0,0:42:33.54,0:42:35.03,bl,,0,0,0,,نعم،هيا لنذهب جميعا
Dialogue: 0,0:42:35.11,0:42:36.77,bl,,0,0,0,,وعندما نعود سنتناول الحبار
Dialogue: 0,0:42:36.85,0:42:38.07,bl,,0,0,0,,!جيد
Dialogue: 0,0:42:42.69,0:42:45.28,bl,,0,0,0,,تاكاجي،مالذي ستفعله الآن؟
Dialogue: 0,0:42:45.56,0:42:49.99,bl,,0,0,0,,قد نجد بصماتهم على هذه الأشياء بكل سهولة
Dialogue: 0,0:42:50.06,0:42:54.76,bl,,0,0,0,,أولا:سأضع السيانيد على البلاستيك
Dialogue: 0,0:42:54.83,0:42:58.13,bl,,0,0,0,,ثم أغلق عليه هذه العلبة مع الأدوات التي تحمل بصماتهم
Dialogue: 0,0:42:58.20,0:43:01.23,bl,,0,0,0,,ثانيا وهي آخر خطوة
Dialogue: 0,0:43:01.54,0:43:02.90,bl,,0,0,0,,هي أن نتركها لبعض الوقت حتى يتم التفاعل بين السيانيد والبلاستيك
Dialogue: 0,0:43:02.97,0:43:05.30,bl,,0,0,0,,وأخيرا ستبدأ البصمات بالظهور على السطح
Dialogue: 0,0:43:06.11,0:43:08.51,bl,,0,0,0,,كيف عرفت كل هذا؟
Dialogue: 0,0:43:08.58,0:43:09.60,bl,,0,0,0,,.لا
Dialogue: 0,0:43:09.68,0:43:11.81,bl,,0,0,0,,،لقد رأيت هذه الحركة في فلم وحفظتها
Dialogue: 0,0:43:11.88,0:43:14.15,bl,,0,0,0,,لأنها تبدو مثيرة للاهتمام
Dialogue: 0,0:43:14.52,0:43:18.15,bl,,0,0,0,,هكذا إذا،لقد كان الفلم ناجحا
Dialogue: 0,0:43:29.30,0:43:33.03,bl,,0,0,0,,هل جواب بكاء قرصان موجود هنا؟
Dialogue: 0,0:43:33.10,0:43:34.83,bl,,0,0,0,,مكان الجواب بالتحديد لا أعرفه
Dialogue: 0,0:43:34.90,0:43:36.80,bl,,0,0,0,,لكن صوت البكاء الصحيح هنا
Dialogue: 0,0:43:37.57,0:43:38.63,bl,,0,0,0,,بكاء
Dialogue: 0,0:43:39.34,0:43:41.24,bl,,0,0,0,,صوت هذه الرياح
Dialogue: 0,0:43:41.31,0:43:43.18,bl,,0,0,0,,يبدو وكأنه صوت بكاء
Dialogue: 0,0:43:43.25,0:43:44.54,bl,,0,0,0,,هذا صحيح
Dialogue: 0,0:43:44.61,0:43:47.48,bl,,0,0,0,,دائما نسمع هذا الصوت في البحار
Dialogue: 0,0:43:47.55,0:43:50.38,bl,,0,0,0,,أعرف ذلك
Dialogue: 0,0:43:52.69,0:43:56.25,bl,,0,0,0,,الرمال تتكون هنا من الكوارتز،أليس كذلك؟
Dialogue: 0,0:43:56.89,0:43:58.69,bl,,0,0,0,,إنها تندمج مع جزيئات رفيعة جدا
Dialogue: 0,0:44:05.13,0:44:06.23,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:44:08.74,0:44:09.90,bl,,0,0,0,,هيي،كونان
Dialogue: 0,0:44:09.97,0:44:11.87,bl,,0,0,0,,هل توصلت إلى شيء ما؟
Dialogue: 0,0:44:12.48,0:44:14.03,bl,,0,0,0,,استمعوا إلى هذه الأصوات بعناية
Dialogue: 0,0:44:17.01,0:44:18.38,bl,,0,0,0,,إنها تشبه صوت البكاء،أليس كذلك؟
Dialogue: 0,0:44:18.45,0:44:19.35,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:44:19.42,0:44:22.41,bl,,0,0,0,,إذا هذا هو المقصود ببكاء القراصنة
Dialogue: 0,0:44:22.49,0:44:25.08,bl,,0,0,0,,أما الباقي فعليكم الاعتماد على أنفسكم في حله
Dialogue: 0,0:44:25.15,0:44:26.09,bl,,0,0,0,,نعم
Dialogue: 0,0:44:26.86,0:44:30.02,bl,,0,0,0,,...إذا هذا هو المقصود ببكاء القراصنة
Dialogue: 0,0:44:31.93,0:44:32.95,bl,,0,0,0,,هناك؟
Dialogue: 0,0:44:37.30,0:44:39.46,bl,,0,0,0,,انظروا،إلى هنا ينتهي الصوت
Dialogue: 0,0:44:39.54,0:44:42.47,bl,,0,0,0,,لقد فهمنا المعنى الآن،أليس كذلك؟
Dialogue: 0,0:44:48.75,0:44:50.68,bl,,0,0,0,,لم أتوقع بأن تصميمهم سيكون بهذا الشكل المتقن
Dialogue: 0,0:44:55.75,0:44:59.92,bl,,0,0,0,,اللغز الجديد،روح القراصنة ستصعد إلى السماء
Dialogue: 0,0:44:59.99,0:45:02.18,bl,,0,0,0,,هذه أيضا محيرة
Dialogue: 0,0:45:02.26,0:45:05.52,bl,,0,0,0,,ولكني لم أفهم جيدا ما قاله ذلك الصياد
Dialogue: 0,0:45:06.23,0:45:08.66,bl,,0,0,0,,لقد ساعدنا في حل التلميح الأول
Dialogue: 0,0:45:08.73,0:45:12.46,bl,,0,0,0,,ولكنه أخبرنا بأن نعتمد على أنفسنا بعد ذلك
Dialogue: 0,0:45:13.30,0:45:16.60,bl,,0,0,0,,هذا لأن عمله أهم منا على ما أعتقد
Dialogue: 0,0:45:17.24,0:45:19.27,bl,,0,0,0,,توقعت ذلك أيضا من شخص كهذا
Dialogue: 0,0:45:21.44,0:45:22.41,bl,,0,0,0,,ما الأمر؟
Dialogue: 0,0:45:25.01,0:45:26.45,bl,,0,0,0,,كونان،ما الأمر؟
Dialogue: 0,0:45:29.62,0:45:31.28,bl,,0,0,0,,يبدو أن شيئا ممتعا سيحدث
Dialogue: 0,0:45:32.02,0:45:32.99,bl,,0,0,0,,كونان؟
Dialogue: 0,0:45:34.19,0:45:36.82,bl,,0,0,0,,آسف،سأنفصل عنكم الآن
Dialogue: 0,0:45:36.89,0:45:38.19,bl,,0,0,0,,أراكم لاحقا
Dialogue: 0,0:45:38.26,0:45:39.73,bl,,0,0,0,,مهلا،كونان
Dialogue: 0,0:45:39.80,0:45:41.23,bl,,0,0,0,,تبا لك
Dialogue: 0,0:45:41.56,0:45:43.93,bl,,0,0,0,,هكذا هم العفاريت لا يستطيعون البقاء مع الفريق
Dialogue: 0,0:45:44.00,0:45:45.30,bl,,0,0,0,,كونان
Dialogue: 0,0:45:57.38,0:45:58.57,bl,,0,0,0,,هنا
Dialogue: 0,0:45:59.15,0:46:00.67,bl,,0,0,0,,لقد ظهرت
Dialogue: 0,0:46:00.75,0:46:03.18,bl,,0,0,0,,لقد تبقى فقط أن نرسل هذه إلى الفحص وبعدها ستظهر النتائج فورا
Dialogue: 0,0:46:03.25,0:46:04.31,bl,,0,0,0,,تاكاجي،أنت رائع
Dialogue: 0,0:46:04.39,0:46:05.45,bl,,0,0,0,,لا،هذا أقل ما يمكنني فعله
Dialogue: 0,0:46:06.82,0:46:13.42,bl,,0,0,0,,لقد قلت أن فحصها سيستغرق وقتا طويلا ونحن في هذه الجزيرة البعيدة،هل تعتقد أننا نمزح؟
Dialogue: 0,0:46:13.60,0:46:16.06,bl,,0,0,0,,آسف على ذلك
Dialogue: 0,0:46:16.13,0:46:18.00,bl,,0,0,0,,على كل حال يجب أن نأخذ الأمر بجدية أكبر
Dialogue: 0,0:46:18.07,0:46:19.09,bl,,0,0,0,,مفهوم سيدي
Dialogue: 0,0:46:53.97,0:46:54.94,bl,,0,0,0,,مالذي تفعله هنا؟
Dialogue: 0,0:46:56.54,0:46:59.24,bl,,0,0,0,,لقد كنت أتمشى مع أصدقائي ولكني ضللت الطريق الآن
Dialogue: 0,0:46:59.48,0:47:01.24,bl,,0,0,0,,أين طريق البحر من فضلك؟
Dialogue: 0,0:47:01.71,0:47:02.58,bl,,0,0,0,,من هذا الاتجاه
Dialogue: 0,0:47:03.01,0:47:05.38,bl,,0,0,0,,شكرا جزيلا،ليلة سعيدة
Dialogue: 0,0:47:10.55,0:47:12.11,bl,,0,0,0,,كيف تجري الامور،تاكاجي؟
Dialogue: 0,0:47:12.19,0:47:13.95,bl,,0,0,0,,هل رد عليك المركز؟
Dialogue: 0,0:47:14.02,0:47:15.99,bl,,0,0,0,,لا،لم يردوا حتى الآن
Dialogue: 0,0:47:16.06,0:47:17.32,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:47:19.80,0:47:21.49,bl,,0,0,0,,مالذي يحدث؟
Dialogue: 0,0:47:24.33,0:47:26.16,bl,,0,0,0,,إنها شرطة سياحة المتحف
Dialogue: 0,0:47:31.77,0:47:34.94,bl,,0,0,0,,أخبرني،هل حدث شيء للمتحف من قبل؟
Dialogue: 0,0:47:35.01,0:47:37.61,bl,,0,0,0,,لا،ولكن ربما حدث خلل ما
Dialogue: 0,0:47:37.68,0:47:40.01,bl,,0,0,0,,على كل حال لنذهب ونلقي نظرة
Dialogue: 0,0:47:40.08,0:47:41.07,bl,,0,0,0,,أين موقعه؟
Dialogue: 0,0:47:41.15,0:47:43.08,bl,,0,0,0,,بالقرب من مكتب لجنة القرية
Dialogue: 0,0:47:43.15,0:47:44.28,bl,,0,0,0,,قم بإحضار السيارة
Dialogue: 0,0:47:44.35,0:47:45.22,bl,,0,0,0,,حسنا
Dialogue: 0,0:47:45.35,0:47:47.72,bl,,0,0,0,,ترقب رد المركز من فضلك
Dialogue: 0,0:47:47.79,0:47:48.48,bl,,0,0,0,,أعتمد عليك
Dialogue: 0,0:47:49.03,0:47:50.49,bl,,0,0,0,,حاضر
Dialogue: 0,0:48:05.54,0:48:08.64,bl,,0,0,0,,تبا،لماذا تتوالى علي القضايا بهذا الشكل؟
Dialogue: 0,0:48:09.75,0:48:10.91,bl,,0,0,0,,لقد وصل
Dialogue: 0,0:48:13.38,0:48:14.35,bl,,0,0,0,,....لنرى
Dialogue: 0,0:48:20.59,0:48:22.15,bl,,0,0,0,,...هذا...هذا
Dialogue: 0,0:48:50.19,0:48:50.91,bl,,0,0,0,,اركب بسرعة
Dialogue: 0,0:49:41.00,0:49:42.90,bl,,0,0,0,,ياله من عقاب فظيع
Dialogue: 0,0:49:42.97,0:49:46.81,bl,,0,0,0,,لا يوجد على هذه الجزيرة مطعم جيد
Dialogue: 0,0:49:46.88,0:49:47.90,bl,,0,0,0,,انظر إلى هذا
Dialogue: 0,0:49:54.18,0:49:56.28,bl,,0,0,0,,سحقا لهذا المكان
Dialogue: 0,0:49:56.35,0:49:58.51,bl,,0,0,0,,حتى الهدوء معدوم فيه ياله من مكان سيء
Dialogue: 0,0:49:58.59,0:49:59.95,bl,,0,0,0,,اهدؤوا أيها الأوغاد
Dialogue: 0,0:50:01.52,0:50:03.29,bl,,0,0,0,,هيي،اهدؤوا
Dialogue: 0,0:50:03.96,0:50:04.79,bl,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:50:06.30,0:50:07.29,bl,,0,0,0,,هيي،انتظر
Dialogue: 0,0:50:08.77,0:50:10.36,bl,,0,0,0,,ماذا تريد؟
Dialogue: 0,0:50:11.43,0:50:14.37,bl,,0,0,0,,هذا المكان لا يبدو أنه بخير
Dialogue: 0,0:50:14.44,0:50:15.80,bl,,0,0,0,,أخبرني ماذا يجري هنا؟
Dialogue: 0,0:50:15.87,0:50:17.40,bl,,0,0,0,,أنت من لا يبدو بخير
Dialogue: 0,0:50:17.47,0:50:18.70,bl,,0,0,0,,عندما تكون المدينة مظلمة
Dialogue: 0,0:50:18.78,0:50:20.04,bl,,0,0,0,,مثل هذه الليلة
Dialogue: 0,0:50:20.11,0:50:21.54,bl,,0,0,0,,!خذني معك الآن
Dialogue: 0,0:50:21.61,0:50:23.14,bl,,0,0,0,,.أنا الآن مشغول جدا
Dialogue: 0,0:50:23.21,0:50:24.01,bl,,0,0,0,,لماذا؟
Dialogue: 0,0:50:24.08,0:50:27.45,bl,,0,0,0,,لقد قام لصوص من السياح بسرقة المتحف
Dialogue: 0,0:50:27.52,0:50:28.58,bl,,0,0,0,,ماذا؟
Dialogue: 0,0:50:28.65,0:50:29.81,bl,,0,0,0,,لصوص؟
Dialogue: 0,0:50:29.89,0:50:30.72,bl,,0,0,0,,!ابتعد هيا
Dialogue: 0,0:50:31.55,0:50:32.78,bl,,0,0,0,,مهلا
Dialogue: 0,0:50:32.86,0:50:34.25,bl,,0,0,0,,اركب بسرعة
Dialogue: 0,0:50:34.76,0:50:36.05,bl,,0,0,0,,لا وقت لدينا للحديث الفارغ
Dialogue: 0,0:50:36.13,0:50:37.65,bl,,0,0,0,,انتظر أرجوك
Dialogue: 0,0:50:37.73,0:50:40.09,bl,,0,0,0,,أرشدني إلى مكانه في الحال
Dialogue: 0,0:50:40.16,0:50:43.00,bl,,0,0,0,,انتظر أيها السيد
Dialogue: 0,0:50:43.07,0:50:45.19,bl,,0,0,0,,سيدتي
Dialogue: 0,0:50:45.74,0:50:47.23,bl,,0,0,0,,سيدتي،ما الأمر؟
Dialogue: 0,0:50:47.47,0:50:49.40,bl,,0,0,0,,ذلك الشخص أكل الكثير وخرج ولم يدفع
Dialogue: 0,0:50:49.47,0:50:51.10,bl,,0,0,0,,أرجوك أمسك به
Dialogue: 0,0:50:51.17,0:50:53.84,bl,,0,0,0,,تبا،قضية أخرى
Dialogue: 0,0:50:56.08,0:50:58.91,bl,,0,0,0,,وكأن قتالا دار هنا
Dialogue: 0,0:50:59.52,0:51:00.81,bl,,0,0,0,,يالها من قضية
Dialogue: 0,0:51:05.79,0:51:06.81,bl,,0,0,0,,ماهي الأوضاع لديك،سيد ساتو؟
Dialogue: 0,0:51:07.22,0:51:11.06,bl,,0,0,0,,كما قال كونان
Dialogue: 0,0:51:11.13,0:51:12.75,bl,,0,0,0,,لقد وجدنا آثار دماء هنا
Dialogue: 0,0:51:12.83,0:51:14.56,bl,,0,0,0,,فهمت
Dialogue: 0,0:51:14.63,0:51:16.72,bl,,0,0,0,,هل تشير الدلائل إلى أشياء أخرى كموت أحدهم؟
Dialogue: 0,0:51:16.80,0:51:18.56,bl,,0,0,0,,من الصعب الجزم بهذا الكلام حتى الآن
Dialogue: 0,0:51:18.63,0:51:19.93,bl,,0,0,0,,معك حق
Dialogue: 0,0:51:20.14,0:51:22.00,bl,,0,0,0,,على كل حال قوموا بالتقاط صور لمسرح الجريمة
Dialogue: 0,0:51:22.07,0:51:23.47,bl,,0,0,0,,ثم عودوا إلى هنا
Dialogue: 0,0:51:23.54,0:51:24.47,bl,,0,0,0,,علم
Dialogue: 0,0:51:28.85,0:51:31.14,bl,,0,0,0,,لقد سرق السيف الثمين والمسدس الأثري
Dialogue: 0,0:51:31.21,0:51:32.74,bl,,0,0,0,,هل كلاهما ثمين؟
Dialogue: 0,0:51:33.08,0:51:35.71,bl,,0,0,0,,السيف ثمين
Dialogue: 0,0:51:36.25,0:51:37.72,bl,,0,0,0,,لأنه قد وجد في كنز بأعماق البحر
Dialogue: 0,0:51:37.79,0:51:40.02,bl,,0,0,0,,وكذلك المسدس أيضا
Dialogue: 0,0:51:40.09,0:51:43.79,bl,,0,0,0,,سأحضرهما ...لا تقلق
Dialogue: 0,0:51:44.79,0:51:47.16,bl,,0,0,0,,موري،وجهك أحمر
Dialogue: 0,0:51:47.23,0:51:48.89,bl,,0,0,0,,.لا
Dialogue: 0,0:51:48.97,0:51:50.96,bl,,0,0,0,,هذا لأني لم أعتد على الطقس البارد هنا
Dialogue: 0,0:51:51.03,0:51:53.76,bl,,0,0,0,,موري كوجورو،يجب أن أعتقلك
Dialogue: 0,0:51:53.84,0:52:04.41,bl,,0,0,0,,لقد شربت الكثير من المطعم دون أن تدفع وسرقه الدراجة أيضا
Dialogue: 0,0:52:05.01,0:52:06.81,bl,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:52:06.88,0:52:07.75,bl,,0,0,0,,نعم
Dialogue: 0,0:52:07.82,0:52:10.05,bl,,0,0,0,,لم يتهرب من الدفع بعد أن شرب فقط
Dialogue: 0,0:52:10.12,0:52:12.64,bl,,0,0,0,,بل سرق دراجة السيد أيوا ناجا
Dialogue: 0,0:52:12.72,0:52:13.92,bl,,0,0,0,,ليهرب من السيدة مالكة المطعم أيضا
Dialogue: 0,0:52:13.99,0:52:15.72,bl,,0,0,0,,.لم أهرب
Dialogue: 0,0:52:15.79,0:52:18.85,bl,,0,0,0,,لقد كنت أركب في المقعد الأمامي لدراجة السياحة فقط
Dialogue: 0,0:52:18.93,0:52:20.02,bl,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:52:20.10,0:52:21.26,bl,,0,0,0,,...نعم
Dialogue: 0,0:52:23.03,0:52:24.90,bl,,0,0,0,,صحيح،حضرة المفتش
Dialogue: 0,0:52:24.97,0:52:27.53,bl,,0,0,0,,لقد وصل فحص البصمات من المركز...تفضل
Dialogue: 0,0:52:28.77,0:52:31.07,bl,,0,0,0,,هيي،هل هذا حقيقي فعلا؟
Dialogue: 0,0:52:32.28,0:52:34.04,bl,,0,0,0,,حسب تحليل البصمات ماتسوموتو ماتسوشي
Dialogue: 0,0:52:34.11,0:52:36.10,bl,,0,0,0,,سارق متاحف الفنون
Dialogue: 0,0:52:36.18,0:52:38.51,bl,,0,0,0,,والمعروف في العالم بالخداع
Dialogue: 0,0:52:38.58,0:52:39.81,bl,,0,0,0,,.ويحب القتل أيضا
Dialogue: 0,0:52:39.88,0:52:49.32,bl,,0,0,0,,سحقا،كما توقعت،إنهم يريدون سيف ماري من أجل بحثهم
Dialogue: 0,0:52:49.39,0:52:51.02,bl,,0,0,0,,ماذا تعني بذلك؟
Dialogue: 0,0:52:51.09,0:52:54.62,bl,,0,0,0,,هل هناك ما هو أهم من المسدس المسروق؟
Dialogue: 0,0:52:54.70,0:52:56.26,bl,,0,0,0,,نعم
Dialogue: 0,0:52:56.33,0:52:59.79,bl,,0,0,0,,فماري كانت من القراصنة النشيطين
Dialogue: 0,0:53:00.37,0:53:03.67,bl,,0,0,0,,قبل 300 سنة ومنذ ظهورها
Dialogue: 0,0:53:03.74,0:53:07.54,bl,,0,0,0,,اختفت الكنوز من بعض الجزر
Dialogue: 0,0:53:08.14,0:53:10.54,bl,,0,0,0,,هل هم حقا من امتلك كل الكنوز التي هنا؟
Dialogue: 0,0:53:10.61,0:53:13.51,bl,,0,0,0,,نعم،المسدس والسيف كانا ملكا لهما
Dialogue: 0,0:53:13.58,0:53:14.81,bl,,0,0,0,,حسنا
Dialogue: 0,0:53:22.96,0:53:24.05,bl,,0,0,0,,عمي
Dialogue: 0,0:53:24.13,0:53:26.92,bl,,0,0,0,,ماذا عن سيدة المطعم ألم تكن جميلة؟
Dialogue: 0,0:53:29.23,0:53:31.46,bl,,0,0,0,,لم تكن جميلة أبدا
Dialogue: 0,0:53:31.53,0:53:33.93,bl,,0,0,0,,إنها مجرد عجوز شمطاء
Dialogue: 0,0:53:34.00,0:53:35.30,bl,,0,0,0,,كما توقعت
Dialogue: 0,0:53:35.61,0:53:36.83,bl,,0,0,0,,إنها نفس الرائحة
Dialogue: 0,0:53:39.68,0:53:41.54,bl,,0,0,0,,عمي،هناك مادة غريبة عليك
Dialogue: 0,0:53:42.65,0:53:43.63,bl,,0,0,0,,ما هذا؟
Dialogue: 0,0:53:44.88,0:53:46.18,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:53:48.42,0:53:50.61,bl,,0,0,0,,هل هنالك طريقة للهروب من هذه الجزيرة؟
Dialogue: 0,0:53:50.69,0:53:53.92,bl,,0,0,0,,أجل،عصر كل يوم هناك مركب واحد يتحرك
Dialogue: 0,0:53:53.99,0:53:55.96,bl,,0,0,0,,أو يمكنك الاعتماد على سفن الصيد
Dialogue: 0,0:53:56.03,0:53:59.12,bl,,0,0,0,,وفي الغالب لا توجد طريقة للإبحار غيرهما
Dialogue: 0,0:53:59.20,0:54:00.79,bl,,0,0,0,,أرجوا منك أن تراقب الأوضاع لكي نتفادى سرقة أي من سفن الصيد
Dialogue: 0,0:54:00.86,0:54:02.35,bl,,0,0,0,,علم
Dialogue: 0,0:54:03.43,0:54:05.23,bl,,0,0,0,,مالذي سأفعله بهذه القيود؟
Dialogue: 0,0:54:05.30,0:54:06.60,bl,,0,0,0,,....هيي
Dialogue: 0,0:54:06.94,0:54:08.56,bl,,0,0,0,,المعذرة حضرة المفتش
Dialogue: 0,0:54:09.54,0:54:11.63,bl,,0,0,0,,من ذلك المدعو ماتسوموتو؟
Dialogue: 0,0:54:11.71,0:54:17.01,bl,,0,0,0,,أليس هو من أخذ المال من المتجر وقتها؟
Dialogue: 0,0:54:17.08,0:54:17.81,bl,,0,0,0,,ماذا؟
Dialogue: 0,0:54:17.88,0:54:21.01,bl,,0,0,0,,مفتش ميغوري لقد انتهينا
Dialogue: 0,0:54:21.08,0:54:22.11,bl,,0,0,0,,مجهود عظيم
Dialogue: 0,0:54:22.18,0:54:23.65,bl,,0,0,0,,لكننا نعتذر منكم توجد مشكلة صغيرة
Dialogue: 0,0:54:23.72,0:54:29.68,bl,,0,0,0,,يبدو أننا عرفنا الهوية الحقيقية لماتسوموتو،لذا أرجوا منكم القبض عليه في أقرب وقت ممكن
Dialogue: 0,0:54:29.76,0:54:31.85,bl,,0,0,0,,نحن ننتظركم في الفندق
Dialogue: 0,0:54:31.93,0:54:32.83,bl,,0,0,0,,علم-\Nعلم-
Dialogue: 0,0:54:32.90,0:54:35.26,bl,,0,0,0,,حضرة المفتش،القيود
Dialogue: 0,0:54:48.54,0:54:50.21,bl,,0,0,0,,كيف يبدو الطقس؟
Dialogue: 0,0:54:50.28,0:54:51.94,bl,,0,0,0,,الرياح قوية
Dialogue: 0,0:54:52.38,0:54:54.94,bl,,0,0,0,,ولكن لا يوجد ارتفاع في درجة الحرارة إطلاقا
Dialogue: 0,0:54:56.19,0:54:57.48,bl,,0,0,0,,لنرى الآن
Dialogue: 0,0:55:00.59,0:55:02.65,bl,,0,0,0,,إطارات مختلفة
Dialogue: 0,0:55:03.53,0:55:05.79,bl,,0,0,0,,بالتأكيد،إنها ليست الدراجة المطلوبة
Dialogue: 0,0:55:05.86,0:55:07.52,bl,,0,0,0,,كونان
Dialogue: 0,0:55:07.76,0:55:08.70,bl,,0,0,0,,نعم
Dialogue: 0,0:55:09.77,0:55:11.70,bl,,0,0,0,,حان وقت الغداء،كونان
Dialogue: 0,0:55:11.77,0:55:13.03,bl,,0,0,0,,أنا قادم في الحال
Dialogue: 0,0:55:13.74,0:55:14.73,bl,,0,0,0,,ما الأمر؟
Dialogue: 0,0:55:15.40,0:55:17.24,bl,,0,0,0,,مثل أداة تعقب باستخدام القمر الصناعي
Dialogue: 0,0:55:17.31,0:55:19.10,bl,,0,0,0,,القمر الصناعي؟
Dialogue: 0,0:55:19.18,0:55:20.90,bl,,0,0,0,,لماذا هي موجودة في هذه الدراجة؟
Dialogue: 0,0:55:23.25,0:55:25.58,bl,,0,0,0,,مالذي يفعله كونان كل هذا الوقت؟
Dialogue: 0,0:55:25.65,0:55:28.28,bl,,0,0,0,,إنه قادم في الحال،انتظر قليلا فحسب
Dialogue: 0,0:55:28.35,0:55:28.94,bl,,0,0,0,,لقد أتى
Dialogue: 0,0:55:29.02,0:55:29.68,bl,,0,0,0,,آسف على التأخير
Dialogue: 0,0:55:29.75,0:55:31.19,bl,,0,0,0,,كونان،لقد تأخرت إني جائع
Dialogue: 0,0:55:31.25,0:55:32.72,bl,,0,0,0,,.سأموت قريبا من الجوع
Dialogue: 0,0:55:32.79,0:55:34.19,bl,,0,0,0,,آسف،آسف
Dialogue: 0,0:55:35.06,0:55:37.58,bl,,0,0,0,,ماهذا؟أين عمي؟
Dialogue: 0,0:55:37.66,0:55:40.36,bl,,0,0,0,,لقد قال لي أنه ذاهب
Dialogue: 0,0:55:40.43,0:55:42.16,bl,,0,0,0,,إلى اجتماع منذ الصباح
Dialogue: 0,0:55:43.23,0:55:44.86,bl,,0,0,0,,حسنا،مالذي تنتظرونه
Dialogue: 0,0:55:44.93,0:55:47.03,bl,,0,0,0,,شكرا للطعام
Dialogue: 0,0:56:02.05,0:56:04.28,bl,,0,0,0,,ألم تلتقوا بالسيد أيوا ناجا
Dialogue: 0,0:56:04.35,0:56:05.84,bl,,0,0,0,,بالأمس قرب الجسر؟
Dialogue: 0,0:56:05.92,0:56:07.25,bl,,0,0,0,,سيد أيوا ناجا؟
Dialogue: 0,0:56:07.76,0:56:09.52,bl,,0,0,0,,هل تقصد المرشد السياحي؟
Dialogue: 0,0:56:09.59,0:56:10.68,bl,,0,0,0,,نعم
Dialogue: 0,0:56:10.76,0:56:12.69,bl,,0,0,0,,لا،لم نلتقي به عند الجسر
Dialogue: 0,0:56:12.76,0:56:13.49,bl,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:56:13.56,0:56:14.72,bl,,0,0,0,,نعم؟
Dialogue: 0,0:56:14.80,0:56:17.86,bl,,0,0,0,,لقد قمنا بالبحث بأنفسنا في ذلك المكان
Dialogue: 0,0:56:17.93,0:56:18.83,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:56:22.97,0:56:24.80,bl,,0,0,0,,هل وجبة الطعام كافية؟
Dialogue: 0,0:56:24.87,0:56:28.54,bl,,0,0,0,,نعم،شكرا جزيلا
Dialogue: 0,0:56:29.48,0:56:31.78,bl,,0,0,0,,بالمناسبة،هل تريدون الغوص اليوم؟
Dialogue: 0,0:56:31.85,0:56:32.84,bl,,0,0,0,,لا أظن ذلك
Dialogue: 0,0:56:32.92,0:56:35.35,bl,,0,0,0,,ما حدث لنا بالأمس كان مخيفا حقا
Dialogue: 0,0:56:35.42,0:56:38.58,bl,,0,0,0,,لكن غدا ليس لدينا الوقت الكافي
Dialogue: 0,0:56:38.65,0:56:41.15,bl,,0,0,0,,لذلك سنركب اليوم المركب البحري
Dialogue: 0,0:56:41.22,0:56:44.28,bl,,0,0,0,,أفضل وقت لذلك هو الليل
Dialogue: 0,0:56:44.36,0:56:46.09,bl,,0,0,0,,لأن العواصف ليست قوية غدا
Dialogue: 0,0:56:46.16,0:56:48.06,bl,,0,0,0,,كما توقعت
Dialogue: 0,0:56:48.30,0:56:51.73,bl,,0,0,0,,.إذا يجب أن نسرع في البحث عن الكنز المفقود
Dialogue: 0,0:56:51.80,0:56:52.77,bl,,0,0,0,,معك حق
Dialogue: 0,0:56:52.84,0:56:55.10,bl,,0,0,0,,لقد بقي ختم واحد فقط
Dialogue: 0,0:56:55.17,0:56:57.33,bl,,0,0,0,,لنبذل جهدنا،كونان
Dialogue: 0,0:56:58.07,0:57:00.60,bl,,0,0,0,,أنا ذاهب إلى مكان بالجوار
Dialogue: 0,0:57:00.68,0:57:02.47,bl,,0,0,0,,على كل حال لن نستطيع إجباره على العمل معنا...فنحن سنبحث عن الكنز بأنفسنا
Dialogue: 0,0:57:13.56,0:57:14.96,bl,,0,0,0,,هذا جيد
Dialogue: 0,0:57:26.14,0:57:28.70,bl,,0,0,0,,الدراجات الأخرى ليست مجهزة بالتأكيد
Dialogue: 0,0:57:29.00,0:57:31.87,bl,,0,0,0,,أين المعلومات التي تحدثت عنها؟\Nهناك ضغط على الاستخبارات
Dialogue: 0,0:57:33.64,0:57:36.77,bl,,0,0,0,,غير معقول،يبدو أن هناك خطأ ما
Dialogue: 0,0:57:36.85,0:57:39.78,bl,,0,0,0,,على كل حال حاولي إخبار الفندق بذلك
Dialogue: 0,0:57:39.85,0:57:40.71,bl,,0,0,0,,حاضر
Dialogue: 0,0:57:40.78,0:57:42.48,bl,,0,0,0,,غير معقول
Dialogue: 0,0:57:52.19,0:57:55.72,bl,,0,0,0,,السيد ماتسوموتو لم يعد إلى الفندق وكذلك السيد وايزوماشي أيضا
Dialogue: 0,0:57:55.80,0:57:58.20,bl,,0,0,0,,يبدو أنهما مختبآن في مكان ما على هذه الجزيرة
Dialogue: 0,0:57:58.27,0:58:08.04,bl,,0,0,0,,إذا كان أحدهما قد أصيب بطلقة البندقية،فلابد أن يبحث عن العلاج بسرعة
Dialogue: 0,0:58:08.11,0:58:09.87,bl,,0,0,0,,لقد قمت بسؤال العيادة
Dialogue: 0,0:58:09.95,0:58:11.81,bl,,0,0,0,,ولكنهم أخبروني أنهم لم يروهم أبدا
Dialogue: 0,0:58:11.88,0:58:17.54,bl,,0,0,0,,صاحبة المتجر السيدة مابوتشي شاهدها كونان في ذلك الوقت،وهي تتحدث مع أحد المشتبه بهم
Dialogue: 0,0:58:17.62,0:58:20.78,bl,,0,0,0,,فذهبنا إليها لنسألها عن ذلك
Dialogue: 0,0:58:21.39,0:58:22.69,bl,,0,0,0,,سأخبركم بالحقيقة
Dialogue: 0,0:58:22.99,0:58:26.26,bl,,0,0,0,,أنا لا أعرف أين يختبئ ماتسوموتو وأتباعه
Dialogue: 0,0:58:26.33,0:58:29.70,bl,,0,0,0,,وأما حديثي معه فقد عرض المساعدة
Dialogue: 0,0:58:29.77,0:58:32.79,bl,,0,0,0,,فوافقت على مساعدته
Dialogue: 0,0:58:32.87,0:58:35.00,bl,,0,0,0,,لأن أرباح دكان الغوص ضئيلة جدا
Dialogue: 0,0:58:35.54,0:58:36.60,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:58:36.67,0:58:40.13,bl,,0,0,0,,الرصاص الذي جلبه تاكاجي بالأمس
Dialogue: 0,0:58:40.44,0:58:42.34,bl,,0,0,0,,يبدو قديما جدا
Dialogue: 0,0:58:42.41,0:58:44.90,bl,,0,0,0,,ويجب أن يبقى في الفحص لمدة طويلة،أليس كذلك؟
Dialogue: 0,0:58:44.98,0:58:49.82,bl,,0,0,0,,نعم،وسوف نقوم بإرسالها للفحص الآن
Dialogue: 0,0:58:50.82,0:58:51.65,bl,,0,0,0,,تفضل
Dialogue: 0,0:58:52.35,0:58:53.62,bl,,0,0,0,,أستأذنكم بالدخول
Dialogue: 0,0:58:53.96,0:58:55.75,bl,,0,0,0,,لقد وصلني اتصال
Dialogue: 0,0:58:55.83,0:58:59.63,bl,,0,0,0,,وأخبروني أن السيد مينيوو قد مات
Dialogue: 0,0:58:59.70,0:59:01.09,bl,,0,0,0,,هكذا إذا
Dialogue: 0,0:59:01.16,0:59:02.89,bl,,0,0,0,,من هو السيد مينوو؟
Dialogue: 0,0:59:02.97,0:59:06.33,bl,,0,0,0,,إنه أحد الرجال المسنين
Dialogue: 0,0:59:06.40,0:59:08.53,bl,,0,0,0,,وقد كان موظفا في دكان غوص السيدة مابوتشي
Dialogue: 0,0:59:08.60,0:59:12.04,bl,,0,0,0,,وقد شاهدته السيدة ميل من قبل
Dialogue: 0,0:59:14.61,0:59:17.44,bl,,0,0,0,,أسرع واسأل السيد ميل عن ذلك حالا
Dialogue: 0,0:59:17.51,0:59:20.24,bl,,0,0,0,,كما أريد منك أن تجد مكان السيدة مابوتشي
Dialogue: 0,0:59:20.32,0:59:21.31,bl,,0,0,0,,علم
Dialogue: 0,0:59:23.85,0:59:27.02,bl,,0,0,0,,أرجوا أن يعود السيف والمسدس إلينا في أقرب فرصة
Dialogue: 0,0:59:27.09,0:59:28.18,bl,,0,0,0,,نعتمد عليكم
Dialogue: 0,0:59:28.92,0:59:30.79,bl,,0,0,0,,سنبذل كل جهدنا
Dialogue: 0,0:59:31.23,0:59:34.66,bl,,0,0,0,,...ولكن،لماذا لم تتوقف هذه السرقات
Dialogue: 0,0:59:35.06,0:59:37.26,bl,,0,0,0,,مع أن رجال الشرطة هنا؟
Dialogue: 0,0:59:37.33,0:59:38.66,bl,,0,0,0,,معك حق
Dialogue: 0,0:59:38.73,0:59:46.77,bl,,0,0,0,,عادة ما يذهب السيد أويهدا إلى الجزر البسيطة،ولذلك لن يتم العثور على بصماته بهذه السهولة
Dialogue: 0,0:59:46.84,0:59:49.28,bl,,0,0,0,,وأغلب الظن أن هويتهم ستكشف عاجلا أم آجلا
Dialogue: 0,0:59:49.38,0:59:52.40,bl,,0,0,0,,المعذرة هل سيصلكم دعم من طوكيو؟
Dialogue: 0,0:59:53.02,0:59:54.68,bl,,0,0,0,,بسبب تأثير الضغط المنخفض
Dialogue: 0,0:59:54.75,0:59:57.12,bl,,0,0,0,,سمعنا أن المروحية لا تستطيع الاستمرار في التحليق،ولا وجود للمراكب أيضا
Dialogue: 0,0:59:58.15,1:00:00.28,bl,,0,0,0,,سنعتمد على أنفسنا في هذه الجريمة
Dialogue: 0,1:00:00.59,1:00:03.22,bl,,0,0,0,,يجب أن نبحث عن ماتسوموتو ورفيقه
Dialogue: 0,1:00:03.29,1:00:07.29,bl,,0,0,0,,للقبض عليهم ووضعهم في السجن
Dialogue: 0,1:00:15.91,1:00:16.80,bl,,0,0,0,,وجدته
Dialogue: 0,1:00:18.54,1:00:19.67,bl,,0,0,0,,لقد وجدته
Dialogue: 0,1:00:19.84,1:00:20.93,bl,,0,0,0,,ممتاز
Dialogue: 0,1:00:21.28,1:00:23.44,bl,,0,0,0,,لقد كان ذلك بمجرد نصائح بسيطة
Dialogue: 0,1:00:24.21,1:00:27.11,bl,,0,0,0,,روح القراصنة ستصعد إلى السماء
Dialogue: 0,1:00:27.18,1:00:29.12,bl,,0,0,0,,بطبع الختم سنجده بالتأكيد
Dialogue: 0,1:00:32.15,1:00:34.28,bl,,0,0,0,,هذا الطابع يحتوي على التلميح الأخير
Dialogue: 0,1:00:34.36,1:00:36.95,bl,,0,0,0,,إذا هيا بنا جميعا لنبحث عن الكنز
Dialogue: 0,1:00:38.09,1:00:40.86,bl,,0,0,0,,لقد ذهبت سيدتي لتشاهد حالة البحر
Dialogue: 0,1:00:40.93,1:00:42.19,bl,,0,0,0,,أرجوا أن تنتظروا قليلا
Dialogue: 0,1:00:42.26,1:00:43.09,bl,,0,0,0,,حاضر-\Nحاضر-
Dialogue: 0,1:00:43.23,1:00:44.39,bl,,0,0,0,,آسفة على التأخير
Dialogue: 0,1:00:45.00,1:00:46.40,bl,,0,0,0,,آسفة
Dialogue: 0,1:00:46.47,1:00:49.03,bl,,0,0,0,,ولكن يبدو أن الأمواج قد قذفت بالمركب بعيدا
Dialogue: 0,1:00:49.10,1:00:50.66,bl,,0,0,0,,لأنها قوية بعض الشيء
Dialogue: 0,1:00:50.74,1:00:52.17,bl,,0,0,0,,يالسوء حظنا
Dialogue: 0,1:00:52.24,1:00:53.73,bl,,0,0,0,,ليس لدينا خيار آخر
Dialogue: 0,1:00:53.91,1:00:57.40,bl,,0,0,0,,ما رأيكم بأن نذهب لنستمتع عند الشاطئ؟
Dialogue: 0,1:00:58.48,1:01:00.14,bl,,0,0,0,,صباح الخير،سيد أويهدا
Dialogue: 0,1:01:00.22,1:01:01.84,bl,,0,0,0,,صباح الخير
Dialogue: 0,1:01:01.92,1:01:03.48,bl,,0,0,0,,ملامح وجهك تبدو جدية
Dialogue: 0,1:01:03.55,1:01:05.35,bl,,0,0,0,,مالذي حدث؟
Dialogue: 0,1:01:05.42,1:01:08.39,bl,,0,0,0,,هل تستطيعين أن تأتي معي
Dialogue: 0,1:01:08.46,1:01:11.12,bl,,0,0,0,,فالمفتش ميغوري يريد التحدث إليك
Dialogue: 0,1:01:19.84,1:01:21.00,bl,,0,0,0,,عمي
Dialogue: 0,1:01:21.07,1:01:22.37,bl,,0,0,0,,ماذا؟
Dialogue: 0,1:01:24.47,1:01:31.58,bl,,0,0,0,,لماذا قام أولئك السياح بسرقة المسدس والسيف يا ترى؟
Dialogue: 0,1:01:33.55,1:01:37.58,bl,,0,0,0,,هدف صائدي الكنوز والسياح هو البحث عن كنز هذه الجزيرة،أليس كذلك؟
Dialogue: 0,1:01:38.29,1:01:41.55,bl,,0,0,0,,لكن من الغريب أن يقوموا بسرقة أشياء
Dialogue: 0,1:01:41.62,1:01:43.06,bl,,0,0,0,,كالمسدس والسيف
Dialogue: 0,1:01:43.13,1:01:45.09,bl,,0,0,0,,هذا يدل على أن لهما قيمة مع الكنز
Dialogue: 0,1:01:45.49,1:01:47.59,bl,,0,0,0,,ولذلك يبدو أن اللصوص
Dialogue: 0,1:01:47.66,1:01:50.56,bl,,0,0,0,,قد عرفوا مكانه حقا
Dialogue: 0,1:01:51.30,1:01:53.00,bl,,0,0,0,,عمي،هل تعرف أين مكان الكنز؟
Dialogue: 0,1:01:54.47,1:01:57.27,bl,,0,0,0,,ولماذا تسألني أنا عن هذا الأمر؟
Dialogue: 0,1:01:57.34,1:01:59.03,bl,,0,0,0,,عمي،الحقيقة هي
Dialogue: 0,1:01:59.61,1:02:01.80,bl,,0,0,0,,أنك لست صائد كنوز
Dialogue: 0,1:02:08.98,1:02:12.58,bl,,0,0,0,,أنا مجرد صائد كنوز بسيط
Dialogue: 0,1:02:12.65,1:02:16.82,bl,,0,0,0,,ولا أعرف مكان ذلك الكنز
Dialogue: 0,1:02:17.06,1:02:19.25,bl,,0,0,0,,ولكن ما قلته يا عمي ليلة البارحة
Dialogue: 0,1:02:19.80,1:02:22.16,bl,,0,0,0,,بما أنك صائد كنوز
Dialogue: 0,1:02:22.23,1:02:24.60,bl,,0,0,0,,فهل يوجد كنز هنا حقا؟
Dialogue: 0,1:02:25.80,1:02:29.40,bl,,0,0,0,,حاليا لا أعرف مكانه وكما قيل
Dialogue: 0,1:02:29.47,1:02:33.07,bl,,0,0,0,,الذئب لن يقف مكتوف الأيدي في غياب فريسته،لأنه لا يريد أن يكون فريسة بالضرورة
Dialogue: 0,1:02:33.84,1:02:36.54,bl,,0,0,0,,قولك:لأنه لا يريد أن يكون فريسة بالضرورة
Dialogue: 0,1:02:36.61,1:02:41.68,bl,,0,0,0,,تعني أنك تعرف شيئا مهما عنه
Dialogue: 0,1:02:46.16,1:02:47.14,bl,,0,0,0,,اتبعني
Dialogue: 0,1:02:54.60,1:02:58.03,bl,,0,0,0,,لماذا توجد هذه العلامات التي باللون الأزرق والأحمر ياترى؟
Dialogue: 0,1:03:00.80,1:03:01.46,bl,,0,0,0,,أعطني المقص
Dialogue: 0,1:03:02.60,1:03:03.16,bl,,0,0,0,,حسنا
Dialogue: 0,1:03:06.58,1:03:07.94,bl,,0,0,0,,هناك مشكلتان
Dialogue: 0,1:03:08.34,1:03:11.47,bl,,0,0,0,,ما معنى ألوان البطاقات الحمراء والزرقاء؟
Dialogue: 0,1:03:11.55,1:03:13.95,bl,,0,0,0,,وما معنى هذه الأرقام؟
Dialogue: 0,1:03:14.02,1:03:17.65,bl,,0,0,0,,ربما دلت هذه الأرقام على عناوين معينة في هذه الجزيرة
Dialogue: 0,1:03:18.69,1:03:19.92,bl,,0,0,0,,صحيح
Dialogue: 0,1:03:19.99,1:03:21.75,bl,,0,0,0,,لنسأل العم عن هذا الأمر
Dialogue: 0,1:03:21.82,1:03:23.26,bl,,0,0,0,,عمي
Dialogue: 0,1:03:31.07,1:03:35.66,bl,,0,0,0,,صحيح،ما الأمر الذي يريد المفتش ميغوري أن يسأل الآنسة مابوتشي عنه؟
Dialogue: 0,1:03:35.74,1:03:37.40,bl,,0,0,0,,ربما عن القضية؟
Dialogue: 0,1:03:37.77,1:03:39.76,bl,,0,0,0,,لابد أن هناك خطأ ما بالتأكيد
Dialogue: 0,1:03:39.84,1:03:40.77,bl,,0,0,0,,سوف أعود بعد قليل
Dialogue: 0,1:03:40.84,1:03:41.97,bl,,0,0,0,,حسنا-\Nحسنا-
Dialogue: 0,1:03:49.18,1:03:51.88,bl,,0,0,0,,ساعدونا في حمل هذه الأدوات
Dialogue: 0,1:03:51.95,1:03:53.35,bl,,0,0,0,,...أنت
Dialogue: 0,1:03:54.76,1:04:00.32,bl,,0,0,0,,لا تتحركي وإلا قتلت صديقتك
Dialogue: 0,1:04:25.79,1:04:28.59,bl,,0,0,0,,عمي هل كنت صائد كنوز؟
Dialogue: 0,1:04:28.66,1:04:31.63,bl,,0,0,0,,نعم،عندما كنت شابا
Dialogue: 0,1:04:31.69,1:04:33.85,bl,,0,0,0,,كنت أبحث عن كنز ماري
Dialogue: 0,1:04:33.93,1:04:35.16,bl,,0,0,0,,في هذه الجزيرة بتلهف
Dialogue: 0,1:04:35.23,1:04:37.89,bl,,0,0,0,,وعندما مضى وقت طويل على عملي
Dialogue: 0,1:04:37.97,1:04:40.49,bl,,0,0,0,,تزوجت بامرأة من هذه الجزيرة
Dialogue: 0,1:04:40.57,1:04:42.06,bl,,0,0,0,,وحينها كنت صيادا عاديا
Dialogue: 0,1:04:44.11,1:04:46.23,bl,,0,0,0,,هذه الخريطة كانت قبل 300 عام
Dialogue: 0,1:05:02.42,1:05:04.32,bl,,0,0,0,,لقد كان الأمر كذلك
Dialogue: 0,1:05:05.46,1:05:07.52,bl,,0,0,0,,هذه الخريطة
Dialogue: 0,1:05:07.96,1:05:10.26,bl,,0,0,0,,تبدو قديمة فعلا
Dialogue: 0,1:05:10.33,1:05:13.50,bl,,0,0,0,,بقيت الخريطة هكذا
Dialogue: 0,1:05:13.57,1:05:17.13,bl,,0,0,0,,،لأان لم يستطع أحد فك هذه الرموز
Dialogue: 0,1:05:17.54,1:05:20.53,bl,,0,0,0,,منذ 300 سنة كاملة
Dialogue: 0,1:05:20.61,1:05:23.10,bl,,0,0,0,,وانتظرت كل هذه المدة مع احتمال وجود تلميح ما
Dialogue: 0,1:05:23.58,1:05:24.77,bl,,0,0,0,,نعم
Dialogue: 0,1:05:24.85,1:05:27.44,bl,,0,0,0,,عمي،هل معنى ذلك أنه بإمكاننا أن نجد الكنوز الحقيقية
Dialogue: 0,1:05:27.52,1:05:29.61,bl,,0,0,0,,إذا حللنا هذه الرموز؟
Dialogue: 0,1:05:29.69,1:05:31.15,bl,,0,0,0,,نعم
Dialogue: 0,1:05:33.22,1:05:37.18,bl,,0,0,0,,ربما قبل 300 سنة كان يبحث عنه آلاف من الناس أيضا،ولعل لذلك علاقة بلغتهم
Dialogue: 0,1:05:37.26,1:05:40.35,bl,,0,0,0,,الخيار الأول هنا...والذي يجب أن يجرب هو الحروف الخاصة بهم
Dialogue: 0,1:05:40.43,1:05:42.26,bl,,0,0,0,,حسنا..لنبدأ بالرقم 5
Dialogue: 0,1:05:42.33,1:05:44.70,bl,,0,0,0,,5،ABCDE
Dialogue: 0,1:05:44.77,1:05:45.89,bl,,0,0,0,,-E\Nهذا صحيح-
Dialogue: 0,1:05:50.77,1:05:51.47,bl,,0,0,0,,....الذي يليه هو الرقم 12
Dialogue: 0,1:05:51.54,1:05:54.37,bl,,0,0,0,,ABCDEFGHIJK
Dialogue: 0,1:05:54.44,1:05:56.21,bl,,0,0,0,,...LM
Dialogue: 0,1:05:56.28,1:05:57.68,bl,,0,0,0,,L الرقم 12 حرفه
Dialogue: 0,1:05:57.75,1:05:58.87,bl,,0,0,0,,L
Dialogue: 0,1:06:12.76,1:06:14.46,bl,,0,0,0,,هذه كل الحروف
Dialogue: 0,1:06:14.53,1:06:15.89,bl,,0,0,0,,لقد كتبنا تحت جميع البطاقات
Dialogue: 0,1:06:15.96,1:06:19.63,bl,,0,0,0,,الحمراء والزرقاء أرقامها
Dialogue: 0,1:06:19.70,1:06:21.73,bl,,0,0,0,,بقي أن نعرف أسمائها
Dialogue: 0,1:06:21.80,1:06:23.20,bl,,0,0,0,,أسمائها؟
Dialogue: 0,1:06:23.27,1:06:26.30,bl,,0,0,0,,ربما كانت البطاقات الزرقاء خاصة بالأسماء،أما الأصناف في الحمراء
Dialogue: 0,1:06:26.38,1:06:27.71,bl,,0,0,0,,استنتاج جيد
Dialogue: 0,1:06:29.75,1:06:32.74,bl,,0,0,0,,من المتوقع أن القراصنة مهتمون بالأسماء
Dialogue: 0,1:06:32.81,1:06:34.04,bl,,0,0,0,,نعم
Dialogue: 0,1:06:34.45,1:06:37.94,bl,,0,0,0,,انظروا،ربما كان هناك اتصال بينها لتكون اسما
Dialogue: 0,1:06:40.92,1:06:42.98,bl,,0,0,0,,جولي
Dialogue: 0,1:06:44.03,1:06:45.22,bl,,0,0,0,,جولي
Dialogue: 0,1:06:58.61,1:06:59.70,bl,,0,0,0,,!اهربا أنتما الاثنان
Dialogue: 0,1:07:06.08,1:07:06.84,bl,,0,0,0,,لا تتحركي
Dialogue: 0,1:07:08.75,1:07:09.51,bl,,0,0,0,,ران
Dialogue: 0,1:07:10.19,1:07:13.38,bl,,0,0,0,,سيدتي،إياك أن ترمي الرمية الخاطئة
Dialogue: 0,1:07:13.46,1:07:16.89,bl,,0,0,0,,لابد أنك لا تريدين موت صديقتك بسبب خطأ فادح وصغير
Dialogue: 0,1:07:36.55,1:07:37.81,bl,,0,0,0,,إنه مركبي...مالذي أتى به إلى هنا؟
Dialogue: 0,1:07:38.81,1:07:40.21,bl,,0,0,0,,لماذا هو هنا؟
Dialogue: 0,1:07:40.62,1:07:43.41,bl,,0,0,0,,إذا أردت أن يعود إليك
Dialogue: 0,1:07:44.05,1:07:45.58,bl,,0,0,0,,فادفعي لي المال
Dialogue: 0,1:07:45.82,1:07:47.58,bl,,0,0,0,,....مستحيل
Dialogue: 0,1:07:47.92,1:07:49.52,bl,,0,0,0,,أنت ستبقين هنا
Dialogue: 0,1:07:52.46,1:07:54.22,bl,,0,0,0,,لأنك عديمة الفائدة وستقل أسطوانات الهواء بسببك
Dialogue: 0,1:07:54.30,1:07:55.16,bl,,0,0,0,,كيميكو
Dialogue: 0,1:07:55.23,1:07:56.25,bl,,0,0,0,,أنت
Dialogue: 0,1:07:56.33,1:07:58.30,bl,,0,0,0,,لا تحولي الاقتراب منها
Dialogue: 0,1:07:59.37,1:08:01.30,bl,,0,0,0,,اركبي في المركب بسرعة
Dialogue: 0,1:08:05.14,1:08:07.77,bl,,0,0,0,,هذا أعطاني مجرد تلميح بسيط
Dialogue: 0,1:08:07.84,1:08:10.21,bl,,0,0,0,,كيف هي الآن؟
Dialogue: 0,1:08:10.28,1:08:11.64,bl,,0,0,0,,مالذي تغير ؟
Dialogue: 0,1:08:11.71,1:08:14.38,bl,,0,0,0,,ربما كان اسمه غرو
Dialogue: 0,1:08:14.45,1:08:15.71,bl,,0,0,0,,جولي غرو؟
Dialogue: 0,1:08:15.78,1:08:16.68,bl,,0,0,0,,خطأ
Dialogue: 0,1:08:21.76,1:08:22.78,bl,,0,0,0,,روجر
Dialogue: 0,1:08:23.46,1:08:24.69,bl,,0,0,0,,جولي روجر
Dialogue: 0,1:08:26.03,1:08:27.26,bl,,0,0,0,,جولي روجر؟
Dialogue: 0,1:08:27.33,1:08:28.32,bl,,0,0,0,,من هذا؟
Dialogue: 0,1:08:28.40,1:08:30.56,bl,,0,0,0,,هل هو قرصان مشهور؟
Dialogue: 0,1:08:30.80,1:08:33.56,bl,,0,0,0,,والترجمة ىالحرفية هي:روجر السعيد
Dialogue: 0,1:08:34.34,1:08:36.27,bl,,0,0,0,,جولي روجر
Dialogue: 0,1:08:36.34,1:08:41.50,bl,,0,0,0,,كان يمتلك جولي روجر طاقما مؤلفا من أكثر من 1700 سفينة وقد عبر بها العديد من البحار
Dialogue: 0,1:08:41.58,1:08:42.94,bl,,0,0,0,,وكما يقال عنه
Dialogue: 0,1:08:43.01,1:08:45.81,bl,,0,0,0,,بأن علم سفينته كان لونه أحمر
Dialogue: 0,1:08:45.88,1:08:49.18,bl,,0,0,0,,وسمي بجولي روجر وكما سمي الشيطان روجر أيضا
Dialogue: 0,1:08:49.28,1:08:50.01,bl,,0,0,0,,علم أحمر؟
Dialogue: 0,1:08:50.09,1:08:51.38,bl,,0,0,0,,شيطان؟
Dialogue: 0,1:08:53.22,1:08:54.28,bl,,0,0,0,,نعم
Dialogue: 0,1:08:54.36,1:08:55.88,bl,,0,0,0,,جولي روجر
Dialogue: 0,1:08:55.96,1:08:59.05,bl,,0,0,0,,هذا يعني علم القرصان جولي روجر،وهو الموجود على ركن خريطة القراصنة
Dialogue: 0,1:08:59.43,1:09:01.26,bl,,0,0,0,,كونان،كم أنت رائع
Dialogue: 0,1:09:04.07,1:09:05.36,bl,,0,0,0,,إذا هل هذه هي الإجابة؟
Dialogue: 0,1:09:08.37,1:09:09.34,bl,,0,0,0,,هل هذه هي؟
Dialogue: 0,1:09:09.47,1:09:10.67,bl,,0,0,0,,رست سفينة إسبانية على هذه الجزيرة منذ 300 سنة
Dialogue: 0,1:09:10.74,1:09:17.61,bl,,0,0,0,,وقد سمعت أيضا بأن المغارة بها غاز الميثان الكيميائي
Dialogue: 0,1:09:17.68,1:09:20.88,bl,,0,0,0,,لكن السفينة غرقت في البحر
Dialogue: 0,1:09:20.95,1:09:24.48,bl,,0,0,0,,أما المغارة فقد سمعت أنه من الصعب دخولها وبها هذا الغاز المميت
Dialogue: 0,1:09:27.29,1:09:35.30,bl,,0,0,0,,في الحقيقة،قبل 300 سنة وقعت حادثة زلزلة البحر وكان ذلك بسبب هذه الجزيرة
Dialogue: 0,1:09:35.36,1:09:37.83,bl,,0,0,0,,والآن أصبحت هكذا
Dialogue: 0,1:09:46.07,1:09:47.44,bl,,0,0,0,,....جزيرة أوياجيما
Dialogue: 0,1:09:48.01,1:09:49.53,bl,,0,0,0,,إذا،فالكنز موجود على هذه الجزيرة؟
Dialogue: 0,1:09:49.61,1:09:51.55,bl,,0,0,0,,نعم،على أغلب الظن
Dialogue: 0,1:09:52.01,1:09:54.14,bl,,0,0,0,,ولكن مازالت هناك حلقة مفقودة
Dialogue: 0,1:09:54.22,1:09:57.98,bl,,0,0,0,,شيء ما لم أتأكد من صحة تلميحه لذلك المكان
Dialogue: 0,1:09:59.09,1:10:00.45,bl,,0,0,0,,كونان،ما الأمر؟
Dialogue: 0,1:10:00.52,1:10:01.89,bl,,0,0,0,,هل وجدت شيئا؟
Dialogue: 0,1:10:02.19,1:10:05.18,bl,,0,0,0,,هذه الرسمة الأثرية لعلم القراصنة
Dialogue: 0,1:10:06.26,1:10:08.25,bl,,0,0,0,,أسنان الجمجمة
Dialogue: 0,1:10:08.33,1:10:09.99,bl,,0,0,0,,ألا تبدو كالأحرف؟
Dialogue: 0,1:10:14.10,1:10:15.40,bl,,0,0,0,,حقا
Dialogue: 0,1:10:15.47,1:10:17.34,bl,,0,0,0,,تبدو وكأنها كاللغة الإنجليزية
Dialogue: 0,1:10:18.17,1:10:21.27,bl,,0,0,0,,DOS في الصف العلوي توجد كلمة
Dialogue: 0,1:10:21.34,1:10:26.47,bl,,0,0,0,,DlOSAS وفي السفلي توجد كلمة
Dialogue: 0,1:10:27.08,1:10:28.81,bl,,0,0,0,,ما معنى هذه الكلمات؟
Dialogue: 0,1:10:28.88,1:10:30.41,bl,,0,0,0,,DOSDlOSAS
Dialogue: 0,1:10:31.42,1:10:34.79,bl,,0,0,0,,بالإسبانية تعني إلهان
Dialogue: 0,1:10:35.46,1:10:37.15,bl,,0,0,0,,رائع
Dialogue: 0,1:10:37.23,1:10:39.28,bl,,0,0,0,,تستحقين بالفعل لقب الآنسة هايبارا
Dialogue: 0,1:10:39.36,1:10:40.92,bl,,0,0,0,,هذا يعني
Dialogue: 0,1:10:41.00,1:10:43.12,bl,,0,0,0,,.أن نذهب إلى الجزيرة لإلقاء نظرة
Dialogue: 0,1:10:43.57,1:10:46.97,bl,,0,0,0,,لكن صائدي الكنوز لا يبحثون عن الكنز في الجزيرة
Dialogue: 0,1:10:47.04,1:10:49.33,bl,,0,0,0,,إذا،فالكنز مدفون في البحر
Dialogue: 0,1:10:49.40,1:10:51.17,bl,,0,0,0,,لا،إن كان ذلك صحيحا
Dialogue: 0,1:10:51.24,1:10:54.30,bl,,0,0,0,,فيجب أن يذكر في التلميحات
Dialogue: 0,1:10:54.38,1:10:57.54,bl,,0,0,0,,لكن بوسايدن هو اسم مذكر
Dialogue: 0,1:10:57.78,1:11:01.65,bl,,0,0,0,,ربما يبحثون عمن يستورد منهم ما يأخذوه
Dialogue: 0,1:11:02.82,1:11:04.65,bl,,0,0,0,,لقد تدخل القدر في الأمر
Dialogue: 0,1:11:04.72,1:11:07.28,bl,,0,0,0,,قبل الزلزال الأرضي وانهيار القشرة
Dialogue: 0,1:11:07.36,1:11:10.65,bl,,0,0,0,,لم يتمكن أحد البالغين من العبور من خلال الفتحة
Dialogue: 0,1:11:10.99,1:11:13.22,bl,,0,0,0,,يبدو أنهم وجدوا المدخل الرئيسي للكنز
Dialogue: 0,1:11:13.60,1:11:16.39,bl,,0,0,0,,فحتى لو كانت الشرطة موجودة هنا للتحقيق
Dialogue: 0,1:11:16.46,1:11:17.62,bl,,0,0,0,,لن يترددوا أبدا في خوض المخاطرة
Dialogue: 0,1:11:17.70,1:11:20.29,bl,,0,0,0,,ولهذا سرقوا المسدس والسيف
Dialogue: 0,1:11:24.61,1:11:26.23,bl,,0,0,0,,المرأة من محل الغوص
Dialogue: 0,1:11:27.78,1:11:28.71,bl,,0,0,0,,ما الأمر؟
Dialogue: 0,1:11:29.48,1:11:31.95,bl,,0,0,0,,سيد موري؟
Dialogue: 0,1:11:32.01,1:11:33.14,bl,,0,0,0,,ليس هنا
Dialogue: 0,1:11:33.21,1:11:34.94,bl,,0,0,0,,لقد خرج ليبحث عن اللصوص
Dialogue: 0,1:11:35.02,1:11:37.99,bl,,0,0,0,,لقد تم اختطاف ران وسونوكو
Dialogue: 0,1:11:38.39,1:11:39.41,bl,,0,0,0,,...القارب
Dialogue: 0,1:11:39.49,1:11:41.92,bl,,0,0,0,,من؟من الذي أخذهم؟
Dialogue: 0,1:11:42.62,1:11:46.79,bl,,0,0,0,,...ماتسوموتو صائد الكنوز
Dialogue: 0,1:11:47.86,1:11:50.46,bl,,0,0,0,,لقد تأكدوا انها جزيرة يوروجيما
Dialogue: 0,1:11:51.00,1:11:54.40,bl,,0,0,0,,أنتم تأكدوا من إيصال الخبر إلى عمي بسرعة
Dialogue: 0,1:11:54.47,1:11:55.44,bl,,0,0,0,,حاضر
Dialogue: 0,1:12:02.48,1:12:03.64,bl,,0,0,0,,انتبه على نفسك
Dialogue: 0,1:12:03.71,1:12:04.64,bl,,0,0,0,,أعرف ذلك
Dialogue: 0,1:12:11.22,1:12:12.15,bl,,0,0,0,,عمي
Dialogue: 0,1:12:13.72,1:12:15.28,bl,,0,0,0,,هل تستطيع الإبحار؟
Dialogue: 0,1:12:15.36,1:12:17.76,bl,,0,0,0,,أريدك أن تأخذني إلى هذه الجزيرة
Dialogue: 0,1:12:17.83,1:12:18.92,bl,,0,0,0,,ماذا؟
Dialogue: 0,1:12:19.43,1:12:21.22,bl,,0,0,0,,أنا لا أبحث عن الكنوز
Dialogue: 0,1:12:21.30,1:12:23.16,bl,,0,0,0,,أريد إنقاذ ران فحسب
Dialogue: 0,1:12:24.93,1:12:25.92,bl,,0,0,0,,شينيتشي
Dialogue: 0,1:12:27.54,1:12:28.47,bl,,0,0,0,,كونان
Dialogue: 0,1:12:28.54,1:12:30.94,bl,,0,0,0,,سمعت أن ران قد اختطفت
Dialogue: 0,1:12:31.01,1:12:32.00,bl,,0,0,0,,نعم
Dialogue: 0,1:12:33.58,1:12:34.74,bl,,0,0,0,,حتى إن حاولت إيقافك
Dialogue: 0,1:12:34.81,1:12:36.83,bl,,0,0,0,,ستذهب لإنقاذهم
Dialogue: 0,1:12:37.75,1:12:40.37,bl,,0,0,0,,انتظر هنا أريدك أن تأخذ شيئا مهما
Dialogue: 0,1:12:40.45,1:12:43.25,bl,,0,0,0,,سأذهب لأحصل على قارب
Dialogue: 0,1:12:43.32,1:12:44.25,bl,,0,0,0,,جيد
Dialogue: 0,1:12:48.66,1:12:50.32,bl,,0,0,0,,هذا يأتيان معا
Dialogue: 0,1:12:50.69,1:12:52.75,bl,,0,0,0,,عبارة عن أسطوانتان مصغرتان للتنفس
Dialogue: 0,1:12:52.83,1:12:54.12,bl,,0,0,0,,يبدأ استعمالها هكذا
Dialogue: 0,1:12:54.20,1:12:57.03,bl,,0,0,0,,إن عضضت عليها بنواجذ أسنانك ستوفر لك الأوكسجين لمدة عشر دقائق
Dialogue: 0,1:12:57.10,1:12:59.16,bl,,0,0,0,,ولسوء الحظ لدي اثنتان فقط
Dialogue: 0,1:12:59.23,1:13:01.43,bl,,0,0,0,,ستفي بالغرض
Dialogue: 0,1:13:02.34,1:13:03.77,bl,,0,0,0,,شكرا،أغاسا
Dialogue: 0,1:13:10.78,1:13:13.37,bl,,0,0,0,,أنتما ستستخدمان أسطوانتين
Dialogue: 0,1:13:13.45,1:13:16.51,bl,,0,0,0,,في هذه المرحلة أنتما في غنى عنا
Dialogue: 0,1:13:16.58,1:13:20.28,bl,,0,0,0,,لازلتما تستطيعان مساعدتنا في بعض الأشياء
Dialogue: 0,1:13:21.92,1:13:23.45,bl,,0,0,0,,أسرعوا بالتجهيزات
Dialogue: 0,1:13:34.90,1:13:36.06,bl,,0,0,0,,...هل يمكن
Dialogue: 0,1:13:37.87,1:13:38.90,bl,,0,0,0,,سونوكو
Dialogue: 0,1:13:41.34,1:13:43.57,bl,,0,0,0,,إنها خدعة يا آنسة
Dialogue: 0,1:13:43.88,1:13:46.07,bl,,0,0,0,,مالذي تريدان أن نفعله؟
Dialogue: 0,1:13:46.15,1:13:49.38,bl,,0,0,0,,ستذهبان معنا
Dialogue: 0,1:13:52.65,1:13:53.92,bl,,0,0,0,,ماذا؟
Dialogue: 0,1:13:53.99,1:13:56.65,bl,,0,0,0,,اختطف ماتسوموتو ران؟
Dialogue: 0,1:13:56.73,1:13:58.35,bl,,0,0,0,,أين هم؟
Dialogue: 0,1:13:58.43,1:14:00.29,bl,,0,0,0,,إنهم في الجزيرة
Dialogue: 0,1:14:00.36,1:14:01.59,bl,,0,0,0,,جزيرة أوياجيما
Dialogue: 0,1:14:01.66,1:14:03.82,bl,,0,0,0,,لأنهم عرفوا مخبأ الكنز
Dialogue: 0,1:14:03.90,1:14:05.92,bl,,0,0,0,,فقد ذهبا للعثور عليه
Dialogue: 0,1:14:06.00,1:14:07.56,bl,,0,0,0,,جهز السفن حالا
Dialogue: 0,1:14:07.64,1:14:08.97,bl,,0,0,0,,أريدكم أن تنقذوا ران
Dialogue: 0,1:14:09.04,1:14:10.40,bl,,0,0,0,,حاضر
Dialogue: 0,1:14:14.91,1:14:18.47,bl,,0,0,0,,ولكن ما داعي احتجاز رهائن؟
Dialogue: 0,1:14:18.55,1:14:19.88,bl,,0,0,0,,إن كنت تبحث عن الكنز
Dialogue: 0,1:14:19.95,1:14:21.97,bl,,0,0,0,,فليس هناك أي فائدة من احتجاز رهائن
Dialogue: 0,1:14:22.05,1:14:23.48,bl,,0,0,0,,لأن لهم أهدافا أخرى
Dialogue: 0,1:14:23.55,1:14:24.95,bl,,0,0,0,,أهدافا أخرى؟
Dialogue: 0,1:14:25.29,1:14:28.52,bl,,0,0,0,,لقد تعطلت بنادقهم بالأمس
Dialogue: 0,1:14:29.02,1:14:31.65,bl,,0,0,0,,وإن كانوا سيغوصون
Dialogue: 0,1:14:31.73,1:14:33.79,bl,,0,0,0,,فإن أسماك القرش ستهاجمهم
Dialogue: 0,1:14:34.43,1:14:36.52,bl,,0,0,0,,يريدون استخدامهم كطعم
Dialogue: 0,1:14:36.60,1:14:37.57,bl,,0,0,0,,80% هذا وارد جدا بنسبة
Dialogue: 0,1:14:47.11,1:14:48.30,bl,,0,0,0,,هناك
Dialogue: 0,1:15:04.56,1:15:05.42,bl,,0,0,0,,كما توقعت
Dialogue: 0,1:15:06.59,1:15:07.46,bl,,0,0,0,,ما العمل الآن؟
Dialogue: 0,1:15:07.53,1:15:09.16,bl,,0,0,0,,لا وقت لدينا
Dialogue: 0,1:15:09.23,1:15:10.72,bl,,0,0,0,,توجه إلى جزيرة أوياجيما
Dialogue: 0,1:15:10.80,1:15:11.77,bl,,0,0,0,,ماذا؟
Dialogue: 0,1:15:12.33,1:15:15.56,bl,,0,0,0,,بجسدي هذا أستطيع الدخول إلى مخبأ الكنز
Dialogue: 0,1:17:24.57,1:17:25.62,bl,,0,0,0,,انتهى مخزون الأوكسجين
Dialogue: 0,1:18:10.31,1:18:11.64,bl,,0,0,0,,لقد كان ذلك مخيفا
Dialogue: 0,1:18:11.71,1:18:13.58,bl,,0,0,0,,مازلتما على قيد الحياة،أنتما مذهلتان
Dialogue: 0,1:18:13.65,1:18:16.62,bl,,0,0,0,,خذا حطبا ثم اشعلاه واحملاه
Dialogue: 0,1:18:16.68,1:18:18.78,bl,,0,0,0,,وإلا فلن تستطيعا رؤية الطريق
Dialogue: 0,1:18:19.02,1:18:22.72,bl,,0,0,0,,.وستبقيان هنا في طريق نهايته الموت
Dialogue: 0,1:18:26.43,1:18:27.99,bl,,0,0,0,,أسرعي
Dialogue: 0,1:18:28.06,1:18:30.55,bl,,0,0,0,,.لا تدفعني
Dialogue: 0,1:18:34.24,1:18:35.22,bl,,0,0,0,,...هذا هو
Dialogue: 0,1:18:35.94,1:18:38.84,bl,,0,0,0,,أتينا إلى هنا مرات عديدة
Dialogue: 0,1:18:38.91,1:18:40.00,bl,,0,0,0,,واليوم سنجده حتما
Dialogue: 0,1:18:40.07,1:18:43.70,bl,,0,0,0,,كنز ماري وبوني المخبأ بأمان هنا
Dialogue: 0,1:18:44.68,1:18:47.58,bl,,0,0,0,,بقؤكما هنا مؤقت فقط
Dialogue: 0,1:18:53.12,1:18:56.85,bl,,0,0,0,,اصعد فوق الصخرة وستجد قاعة الجحيم
Dialogue: 0,1:18:56.92,1:18:59.26,bl,,0,0,0,,وفي مدخل الكهف
Dialogue: 0,1:18:59.33,1:19:00.62,bl,,0,0,0,,ستجد المدخل الضيق
Dialogue: 0,1:19:00.70,1:19:01.99,bl,,0,0,0,,حاضر
Dialogue: 0,1:19:02.06,1:19:03.66,bl,,0,0,0,,سيستغرق الأمر 30 دقيقة
Dialogue: 0,1:19:03.73,1:19:05.46,bl,,0,0,0,,إن لم تحسب العودة
Dialogue: 0,1:19:05.53,1:19:07.19,bl,,0,0,0,,شكرا
Dialogue: 0,1:19:07.50,1:19:10.77,bl,,0,0,0,,سأنقذ ران وسونوكو بكل تأكيد
Dialogue: 0,1:19:17.71,1:19:19.94,bl,,0,0,0,,بوني وماري
Dialogue: 0,1:19:37.43,1:19:38.49,bl,,0,0,0,,غريب
Dialogue: 0,1:19:38.57,1:19:40.19,bl,,0,0,0,,البالغون يمكنهم المرور أيضا
Dialogue: 0,1:19:40.90,1:19:43.27,bl,,0,0,0,,تسبب زلزال الأسبوع الماضي حطام تجويف المدخل
Dialogue: 0,1:19:43.34,1:19:45.03,bl,,0,0,0,,فأغلقت الطرق
Dialogue: 0,1:19:45.71,1:19:46.67,bl,,0,0,0,,هكذا إذا
Dialogue: 0,1:19:46.74,1:19:49.11,bl,,0,0,0,,تسبب زلزال آخر بتوسيع المدخل هنا
Dialogue: 0,1:19:52.25,1:19:53.91,bl,,0,0,0,,...ربما ران
Dialogue: 0,1:19:53.98,1:19:56.18,bl,,0,0,0,,لا،طالما أنهم ليسوا هنا
Dialogue: 0,1:19:56.25,1:19:57.27,bl,,0,0,0,,فلا أظن أنهما قد قتلتا
Dialogue: 0,1:19:57.35,1:19:58.44,bl,,0,0,0,,....ولكن
Dialogue: 0,1:19:58.52,1:20:02.85,bl,,0,0,0,,في ليلة البارحة كانت هناك بندقية ماتسوموتو
Dialogue: 0,1:20:04.29,1:20:05.62,bl,,0,0,0,,ماداما غواصان
Dialogue: 0,1:20:05.69,1:20:08.49,bl,,0,0,0,,فرائحة الدماء سيتبعها القرش
Dialogue: 0,1:20:08.56,1:20:10.00,bl,,0,0,0,,وماذا سيحدث بعد ذلك؟
Dialogue: 0,1:20:10.97,1:20:14.90,bl,,0,0,0,,ربما سيجعلان ران طعما للقرش
Dialogue: 0,1:20:17.00,1:20:18.23,bl,,0,0,0,,انتظر من فضلك سيد موري
Dialogue: 0,1:20:18.31,1:20:19.17,bl,,0,0,0,,ماذا تظن نفسك فاعلا؟
Dialogue: 0,1:20:19.24,1:20:20.07,bl,,0,0,0,,اتركني
Dialogue: 0,1:20:20.14,1:20:21.80,bl,,0,0,0,,كيف لي أن أترك ران وحدها في موقف خطير كهذا
Dialogue: 0,1:20:21.88,1:20:23.21,bl,,0,0,0,,استسلم للواقع سيد موري
Dialogue: 0,1:20:23.28,1:20:25.44,bl,,0,0,0,,لن تستطيع تغيير الواقع إذا قفزت
Dialogue: 0,1:20:25.51,1:20:27.41,bl,,0,0,0,,اتركني حالا
Dialogue: 0,1:20:27.48,1:20:28.41,bl,,0,0,0,,أعتذر عن ذلك
Dialogue: 0,1:20:34.29,1:20:35.78,bl,,0,0,0,,ما العمل الآن؟
Dialogue: 0,1:20:36.59,1:20:38.42,bl,,0,0,0,,بداية سنعود أدراجنا إلى اليابسة
Dialogue: 0,1:20:38.66,1:20:39.96,bl,,0,0,0,,ولكنني أشعر بالندم
Dialogue: 0,1:20:46.23,1:20:49.36,bl,,0,0,0,,عودوا إلى الداخل فمن الخطر البقاء في الخارج لمدة طويلة
Dialogue: 0,1:20:49.44,1:20:51.70,bl,,0,0,0,,لكن البقية في موقف أخطر
Dialogue: 0,1:20:51.77,1:20:55.21,bl,,0,0,0,,كونان وران وسونوكو
Dialogue: 0,1:20:55.28,1:20:56.04,bl,,0,0,0,,نعم
Dialogue: 0,1:20:56.11,1:20:57.17,bl,,0,0,0,,ياللأسف
Dialogue: 0,1:21:05.02,1:21:06.51,bl,,0,0,0,,منسوب المياه يرتفع
Dialogue: 0,1:21:06.59,1:21:08.02,bl,,0,0,0,,صحيح
Dialogue: 0,1:21:08.49,1:21:09.82,bl,,0,0,0,,هل سندخله لنعبر إلى الكهف؟
Dialogue: 0,1:21:09.89,1:21:11.62,bl,,0,0,0,,أجل...لابد من ذلك
Dialogue: 0,1:21:11.93,1:21:14.79,bl,,0,0,0,,هذا الكهف هو طريق مختصر للوصول
Dialogue: 0,1:21:15.33,1:21:18.39,bl,,0,0,0,,حسنا،قوما بحمل هاتين الأسطوانتين واتبعاني
Dialogue: 0,1:21:36.28,1:21:39.34,bl,,0,0,0,,قصة القرصانتين حقيقية فعلا
Dialogue: 0,1:21:39.92,1:21:40.98,bl,,0,0,0,,يبدو ذلك
Dialogue: 0,1:21:56.34,1:21:58.27,bl,,0,0,0,,ضعوا الأوكسجين هنا،ستمرون أولا
Dialogue: 0,1:21:58.34,1:21:59.86,bl,,0,0,0,,...لكن
Dialogue: 0,1:21:59.94,1:22:01.37,bl,,0,0,0,,!تحركا هيا
Dialogue: 0,1:22:14.02,1:22:16.32,bl,,0,0,0,,!عظام!عظام!عظام
Dialogue: 0,1:22:17.73,1:22:20.06,bl,,0,0,0,,يبدو أن الإثارة قد بدأت
Dialogue: 0,1:22:20.86,1:22:21.85,bl,,0,0,0,,هنا الغاز إذا
Dialogue: 0,1:22:21.93,1:22:22.83,bl,,0,0,0,,غاز؟
Dialogue: 0,1:22:22.90,1:22:27.53,bl,,0,0,0,,واحدة من فتحات الهواء تدفع الغاز إلى هنا
Dialogue: 0,1:22:27.77,1:22:30.46,bl,,0,0,0,,ألهذا ذهبنا نحن أولا؟
Dialogue: 0,1:22:30.54,1:22:33.60,bl,,0,0,0,,ولماذا تتوقعون أننا اصطحبناكم؟
Dialogue: 0,1:22:33.74,1:22:35.27,bl,,0,0,0,,أسرعا
Dialogue: 0,1:22:43.62,1:22:44.55,bl,,0,0,0,,ماذا؟
Dialogue: 0,1:22:44.89,1:22:45.68,bl,,0,0,0,,هذا هو
Dialogue: 0,1:22:48.76,1:22:49.98,bl,,0,0,0,,وجدته
Dialogue: 0,1:22:53.53,1:22:54.65,bl,,0,0,0,,هراء بالفعل
Dialogue: 0,1:22:55.26,1:22:57.70,bl,,0,0,0,,تحدوا الذي يستطيع الوصول إلى هنا
Dialogue: 0,1:22:57.77,1:22:59.32,bl,,0,0,0,,إنه سوف يموت
Dialogue: 0,1:23:00.27,1:23:01.53,bl,,0,0,0,,...ها هو
Dialogue: 0,1:23:14.05,1:23:15.48,bl,,0,0,0,,افتحيه
Dialogue: 0,1:23:15.55,1:23:16.61,bl,,0,0,0,,أنا؟
Dialogue: 0,1:23:16.68,1:23:17.98,bl,,0,0,0,,دع الأمر لي
Dialogue: 0,1:23:29.46,1:23:30.40,bl,,0,0,0,,!ران
Dialogue: 0,1:23:30.60,1:23:32.86,bl,,0,0,0,,حدث ما توقعته
Dialogue: 0,1:23:41.98,1:23:43.57,bl,,0,0,0,,توقف عن هذه الأوهام
Dialogue: 0,1:23:45.25,1:23:47.81,bl,,0,0,0,,فهمت الآن،كان الأمر هكذا إذا
Dialogue: 0,1:23:47.88,1:23:49.28,bl,,0,0,0,,مالذي فهمته؟
Dialogue: 0,1:23:49.35,1:23:53.98,bl,,0,0,0,,قيل أن ماري كانت دائما تستخدم المواجهة ظهرا لظهر لحماية رفيقتها
Dialogue: 0,1:23:54.06,1:23:55.25,bl,,0,0,0,,...مما يعني
Dialogue: 0,1:23:56.32,1:23:57.81,bl,,0,0,0,,أنها تكون هكذا
Dialogue: 0,1:24:15.88,1:24:17.84,bl,,0,0,0,,وجدناه،وجدناه
Dialogue: 0,1:24:21.42,1:24:22.35,bl,,0,0,0,,أعطني النار
Dialogue: 0,1:24:42.77,1:24:43.79,bl,,0,0,0,,مذهل
Dialogue: 0,1:24:43.87,1:24:46.20,bl,,0,0,0,,الكنز؟أين هو الكنز؟
Dialogue: 0,1:24:49.31,1:24:50.90,bl,,0,0,0,,أترك لي بعضا منه
Dialogue: 0,1:24:52.18,1:24:54.01,bl,,0,0,0,,ران،ماذا سنفعل الآن؟
Dialogue: 0,1:24:54.08,1:24:56.11,bl,,0,0,0,,إنها فرصتنا لنحاول الهرب من هذا المكان
Dialogue: 0,1:24:56.18,1:24:56.81,bl,,0,0,0,,ولكن ليس هنالك أسطوانة تكفينا
Dialogue: 0,1:24:56.88,1:24:59.79,bl,,0,0,0,,تحت هذا الضغط الشديد
Dialogue: 0,1:24:59.85,1:25:00.98,bl,,0,0,0,,هكذا إذا
Dialogue: 0,1:25:01.29,1:25:03.81,bl,,0,0,0,,سننتظر مجيء أحدهم ليساعدنا
Dialogue: 0,1:25:04.53,1:25:05.36,bl,,0,0,0,,...إذا
Dialogue: 0,1:25:11.70,1:25:12.67,bl,,0,0,0,,رياح
Dialogue: 0,1:25:12.80,1:25:13.73,bl,,0,0,0,,توجد فجوة هناك
Dialogue: 0,1:25:14.60,1:25:16.97,bl,,0,0,0,,تبا،الوضع سيء
Dialogue: 0,1:25:17.04,1:25:18.77,bl,,0,0,0,,لم نعثر على الكنز في أي مكان
Dialogue: 0,1:25:18.84,1:25:22.54,bl,,0,0,0,,أرتك الكنز الآن،ليس هنالك أي أثر للمال هنا
Dialogue: 0,1:25:22.84,1:25:24.28,bl,,0,0,0,,لا أدري كيف حدث ذلك
Dialogue: 0,1:25:24.35,1:25:28.15,bl,,0,0,0,,لقد كنا أول الواصلين إلى هنا فكيف يضيع المال هكذا
Dialogue: 0,1:25:28.22,1:25:29.91,bl,,0,0,0,,هيي،ليس من الجيد أن تقول شيئا كهذا
Dialogue: 0,1:25:29.98,1:25:31.35,bl,,0,0,0,,لأنك أنت من قال أن هناك كنوزا كثيرة هنا
Dialogue: 0,1:25:31.42,1:25:32.89,bl,,0,0,0,,ولهذا لا تملك الحق لتلومني
Dialogue: 0,1:25:32.95,1:25:34.68,bl,,0,0,0,,!اصمت
Dialogue: 0,1:25:37.56,1:25:38.65,bl,,0,0,0,,والآن
Dialogue: 0,1:25:38.73,1:25:41.72,bl,,0,0,0,,يتوجب علينا أن نصفي حسابنا
Dialogue: 0,1:25:43.06,1:25:45.86,bl,,0,0,0,,وسنتخلص من أول شيء لا فائدة منه
Dialogue: 0,1:25:50.30,1:25:51.74,bl,,0,0,0,,المعذرة
Dialogue: 0,1:25:51.81,1:25:54.50,bl,,0,0,0,,مصيركما هو الهلاك لا محالة
Dialogue: 0,1:25:55.28,1:25:56.33,bl,,0,0,0,,لا تقترب
Dialogue: 0,1:25:56.51,1:25:58.50,bl,,0,0,0,,ران،أنا سأحميك ظهرا لظهر
Dialogue: 0,1:25:58.58,1:26:00.17,bl,,0,0,0,,سونوكو،كوني حذرة
Dialogue: 0,1:26:04.79,1:26:05.68,bl,,0,0,0,,!أنتما
Dialogue: 0,1:26:15.66,1:26:18.56,bl,,0,0,0,,تبا،هذه المرأة تقاتل بقوة
Dialogue: 0,1:26:18.63,1:26:20.86,bl,,0,0,0,,بالطبع تقاتل
Dialogue: 0,1:26:21.30,1:26:23.74,bl,,0,0,0,,لكن مهما قاتلتا بقوة
Dialogue: 0,1:26:23.80,1:26:27.30,bl,,0,0,0,,فيخفى وراء دفاعهما الثنائي نقطة ضعف ستوقفهما حتما
Dialogue: 0,1:26:29.54,1:26:32.44,bl,,0,0,0,,دائما ما أكون آخر شخص يموت
Dialogue: 0,1:26:41.06,1:26:42.42,bl,,0,0,0,,!انخفضا أرضا
Dialogue: 0,1:26:51.47,1:26:52.69,bl,,0,0,0,,أنتما بخير الآن
Dialogue: 0,1:26:53.97,1:26:55.96,bl,,0,0,0,,ران وسونوكو
Dialogue: 0,1:26:56.40,1:26:58.20,bl,,0,0,0,,وصلت في الوقت المناسب أيها الطفل
Dialogue: 0,1:26:58.27,1:27:00.83,bl,,0,0,0,,كيف عرفت أننا هنا؟
Dialogue: 0,1:27:00.91,1:27:03.21,bl,,0,0,0,,وجدت فتحة في جزيرة أوياجيما ولاحظت شيئا
Dialogue: 0,1:27:03.58,1:27:07.81,bl,,0,0,0,,بدا ككنز قراصنة حقيقي
Dialogue: 0,1:27:07.88,1:27:10.28,bl,,0,0,0,,لا وجود للكنوز هنا
Dialogue: 0,1:27:10.35,1:27:14.19,bl,,0,0,0,,قالا أنهما أول من جاء إلى هنا
Dialogue: 0,1:27:15.42,1:27:16.62,bl,,0,0,0,,هل سمعت ما قالته؟
Dialogue: 0,1:27:16.76,1:27:18.25,bl,,0,0,0,,لقد ندمت الآن بالتأكيد
Dialogue: 0,1:27:19.23,1:27:21.56,bl,,0,0,0,,يجب أن تستيقظ من أحلامك
Dialogue: 0,1:27:21.63,1:27:24.60,bl,,0,0,0,,وتكشف ماضيك الذي أخفيته عن الجميع
Dialogue: 0,1:27:33.27,1:27:36.54,bl,,0,0,0,,أيها المفتش ميغوري يبدو أن البحر قد هدأ هيجانه عما كان عليه سابقا
Dialogue: 0,1:27:36.61,1:27:38.67,bl,,0,0,0,,.والرياح تبدو أضعف أيضا
Dialogue: 0,1:27:38.75,1:27:39.91,bl,,0,0,0,,سيد موري
Dialogue: 0,1:27:39.98,1:27:44.42,bl,,0,0,0,,أخبرتنا الجهات المختصة بالطقس،أن علينا الانتظار حتى تتوقف هذه العاصفة تماما
Dialogue: 0,1:27:44.49,1:27:46.01,bl,,0,0,0,,...ولكنكم تستطيعون رؤية هذا
Dialogue: 0,1:27:46.09,1:27:48.35,bl,,0,0,0,,.العاصفة أصبحت أضعف حقا
Dialogue: 0,1:27:48.42,1:27:50.12,bl,,0,0,0,,أرجوا أن تتمالك نفسك سيد موري
Dialogue: 0,1:27:50.19,1:27:52.39,bl,,0,0,0,,أتمالك نفسي
Dialogue: 0,1:27:52.46,1:27:54.32,bl,,0,0,0,,بينما ران مختطفة في الخارج
Dialogue: 0,1:27:54.40,1:27:57.30,bl,,0,0,0,,والصعلوك الأبله فقط هو الذي ذهب إلى هناك لينقذها
Dialogue: 0,1:27:57.36,1:28:01.89,bl,,0,0,0,,وهؤلاء الرجال لا يمكنهم فعل أي شيء سوى التضليل
Dialogue: 0,1:28:01.97,1:28:03.20,bl,,0,0,0,,موري
Dialogue: 0,1:28:03.80,1:28:05.20,bl,,0,0,0,,أتفهم مشاعرك
Dialogue: 0,1:28:05.27,1:28:06.30,bl,,0,0,0,,إن لم يهدأ البحر
Dialogue: 0,1:28:06.37,1:28:08.93,bl,,0,0,0,,فلن نستطيع التحرك
Dialogue: 0,1:28:10.24,1:28:11.87,bl,,0,0,0,,وإن هدأت الرياح والأمطار
Dialogue: 0,1:28:11.95,1:28:14.54,bl,,0,0,0,,سنذهب بالتأكيد لإنقاذ ران
Dialogue: 0,1:28:14.62,1:28:16.28,bl,,0,0,0,,سنجلس هنا حتى ذلك الحين
Dialogue: 0,1:28:18.09,1:28:19.21,bl,,0,0,0,,اللعنة
Dialogue: 0,1:28:22.56,1:28:24.96,bl,,0,0,0,,يجب أن تستيقظ من أحلامك
Dialogue: 0,1:28:25.03,1:28:27.72,bl,,0,0,0,,وتكشف ماضيك الذي أخفيته عن الجميع
Dialogue: 0,1:28:28.10,1:28:29.43,bl,,0,0,0,,سيد أيوا ناجا
Dialogue: 0,1:28:34.23,1:28:35.72,bl,,0,0,0,,...ياللحظ
Dialogue: 0,1:28:35.80,1:28:38.33,bl,,0,0,0,,لقد كان الأمر سيئا جدا عندما كنت أستمع لهم سرا
Dialogue: 0,1:28:38.41,1:28:41.47,bl,,0,0,0,,لقد أردت إنقاذ هاتين الاثنتين
Dialogue: 0,1:28:41.54,1:28:43.94,bl,,0,0,0,,ألهذا السبب أحضرت معك البندقية؟
Dialogue: 0,1:28:44.01,1:28:47.50,bl,,0,0,0,,هذا لأني سمعت أنهم مطلوبون دوليا
Dialogue: 0,1:28:47.85,1:28:51.28,bl,,0,0,0,,هذه البندقية سرقتها من السيد ميناو
Dialogue: 0,1:28:51.52,1:28:53.04,bl,,0,0,0,,لا...لا
Dialogue: 0,1:28:53.12,1:28:54.78,bl,,0,0,0,,أحضرت معك البندقية
Dialogue: 0,1:28:54.86,1:28:56.29,bl,,0,0,0,,خوفا من أن يسرقوا الكنز كله
Dialogue: 0,1:28:56.36,1:28:58.99,bl,,0,0,0,,هذا الأمر ليس له علاقة بالكنز
Dialogue: 0,1:29:00.66,1:29:02.25,bl,,0,0,0,,سيد أيوا ناجا
Dialogue: 0,1:29:02.46,1:29:05.23,bl,,0,0,0,,،أرسلت لنا إشارة لخريطة الكنز
Dialogue: 0,1:29:05.30,1:29:07.53,bl,,0,0,0,,أخبرتنا أن هذا ما كنت تود الحصول عليه
Dialogue: 0,1:29:07.60,1:29:09.54,bl,,0,0,0,,هكذا إذا
Dialogue: 0,1:29:09.60,1:29:12.23,bl,,0,0,0,,عندما كنت في المنزل
Dialogue: 0,1:29:12.31,1:29:14.50,bl,,0,0,0,,رأيت أن الإشارة الرقمية هي ذاتها
Dialogue: 0,1:29:14.78,1:29:17.87,bl,,0,0,0,,وعندما سمعتها تيقنت
Dialogue: 0,1:29:18.35,1:29:20.91,bl,,0,0,0,,أنها خريطة الكنز قبل 300 عام
Dialogue: 0,1:29:22.88,1:29:27.55,bl,,0,0,0,,وأيضا يبدو أنك رأيت الخريطة،أليس كذلك؟
Dialogue: 0,1:29:27.62,1:29:28.45,bl,,0,0,0,,مما يعني
Dialogue: 0,1:29:28.52,1:29:31.62,bl,,0,0,0,,أنك تريد معرفة السر وراء خريطة الكنز تلك
Dialogue: 0,1:29:31.69,1:29:35.69,bl,,0,0,0,,وتطلب من السائحين المساعدة في حلها
Dialogue: 0,1:29:35.90,1:29:36.92,bl,,0,0,0,,ألهذا
Dialogue: 0,1:29:37.00,1:29:40.83,bl,,0,0,0,,أردت لوالدي أن ينضم لمسابقة صيد الكنز
Dialogue: 0,1:29:40.90,1:29:43.17,bl,,0,0,0,,إذا،عوضا أن يعتمد على أطفال صغار
Dialogue: 0,1:29:43.24,1:29:44.23,bl,,0,0,0,,قام باستدعاء متحر خاص
Dialogue: 0,1:29:44.30,1:29:46.80,bl,,0,0,0,,لتصبح إمكانية العثور على الكنز أكبر
Dialogue: 0,1:29:46.87,1:29:50.94,bl,,0,0,0,,ولتستطيع تحديد أماكنهم طوال الوقت
Dialogue: 0,1:29:51.01,1:29:51.94,bl,,0,0,0,,،قمت بتأجير الدراجات
Dialogue: 0,1:29:52.01,1:29:54.57,bl,,0,0,0,,ثم ألصقت تحتها مرسلا للإشارات لتحدد مكانها
Dialogue: 0,1:29:54.65,1:29:57.71,bl,,0,0,0,,هذا لأني كنت أخشى أن يتضرر أحد منهم
Dialogue: 0,1:29:57.79,1:30:01.41,bl,,0,0,0,,خريطة الكنز كان بها اسم باللغة الإنجليزية
Dialogue: 0,1:30:01.49,1:30:03.12,bl,,0,0,0,,جولي روجر
Dialogue: 0,1:30:03.19,1:30:05.66,bl,,0,0,0,,وتعني علم القراصنة
Dialogue: 0,1:30:05.73,1:30:06.66,bl,,0,0,0,,جزيرة أوياجيما هذه
Dialogue: 0,1:30:06.73,1:30:10.03,bl,,0,0,0,,كانت سابقا على شكل جمجمة
Dialogue: 0,1:30:10.10,1:30:13.00,bl,,0,0,0,,رأت بوني أن تترك هذا التلميح خلفها
Dialogue: 0,1:30:13.07,1:30:16.33,bl,,0,0,0,,أعتقد أن نطق كلمة أوياجيما مشابه
Dialogue: 0,1:30:16.40,1:30:19.13,bl,,0,0,0,,لكلمة جولي روجر بطريقة ما
Dialogue: 0,1:30:20.17,1:30:23.87,bl,,0,0,0,,توقعت أنك استنتجت هذا الأمر
Dialogue: 0,1:30:23.94,1:30:26.74,bl,,0,0,0,,وهو أن كلمة جولي روجر تعني علم القراصنة
Dialogue: 0,1:30:26.81,1:30:27.87,bl,,0,0,0,,ماذا؟
Dialogue: 0,1:30:28.78,1:30:34.19,bl,,0,0,0,,الرسم الحقيقي على خريطة الكنز،على علم القراصنة جولي روجر شكل جمجمة
Dialogue: 0,1:30:34.25,1:30:38.42,bl,,0,0,0,,الصف العلوي من أسنان الجمجمة كان له تكملة في الصف السفلي
Dialogue: 0,1:30:38.86,1:30:40.55,bl,,0,0,0,,DOSDlOSAS
Dialogue: 0,1:30:40.63,1:30:43.03,bl,,0,0,0,,وتعني إلهان
Dialogue: 0,1:30:43.10,1:30:45.16,bl,,0,0,0,,كونان؟
Dialogue: 0,1:30:46.03,1:30:48.63,bl,,0,0,0,,،وكنت تتبعني حتى أتيت إلى هنا
Dialogue: 0,1:30:48.70,1:30:49.96,bl,,0,0,0,,كان من الضروري أن تبحث عني
Dialogue: 0,1:30:50.40,1:30:53.53,bl,,0,0,0,,فالصنمان اللذان في قاعة الأجداد
Dialogue: 0,1:30:53.61,1:30:55.87,bl,,0,0,0,,هما اللذان عرفت منهما طريق المدخل
Dialogue: 0,1:30:56.28,1:30:58.14,bl,,0,0,0,,هكذا إذا
Dialogue: 0,1:30:58.68,1:31:00.67,bl,,0,0,0,,...كيف عرفت كل هذا؟
Dialogue: 0,1:31:00.91,1:31:01.85,bl,,0,0,0,,تبا
Dialogue: 0,1:31:01.92,1:31:04.65,bl,,0,0,0,,هل فشلت كل هذه الخطة بسهولة؟
Dialogue: 0,1:31:07.25,1:31:09.95,bl,,0,0,0,,السترتان والقفازان
Dialogue: 0,1:31:10.02,1:31:12.86,bl,,0,0,0,,مهاجمة صائدي الكنزو بالبندقية
Dialogue: 0,1:31:12.93,1:31:14.42,bl,,0,0,0,,كل ذلك كان من تدبيرك أنت
Dialogue: 0,1:31:15.10,1:31:17.06,bl,,0,0,0,,وفي الكهف الذي هناك
Dialogue: 0,1:31:17.13,1:31:19.76,bl,,0,0,0,,تركت أثرا يشير إليك
Dialogue: 0,1:31:19.83,1:31:23.23,bl,,0,0,0,,تركت دراجتك أثرا لعجلاتها على الأرض
Dialogue: 0,1:31:24.97,1:31:28.17,bl,,0,0,0,,حتى الطفل الصغير يكتشف هذه الأخطاء
Dialogue: 0,1:31:29.01,1:31:30.70,bl,,0,0,0,,ولكن الأمر لم يكن كذلك
Dialogue: 0,1:31:33.61,1:31:35.84,bl,,0,0,0,,إنه تحليل عمي كوجورو
Dialogue: 0,1:31:35.92,1:31:38.54,bl,,0,0,0,,كل هذا التحليل الذي قلته كان عمي هو الذي أخبرني به
Dialogue: 0,1:31:38.62,1:31:40.18,bl,,0,0,0,,وقال عمي أيضا
Dialogue: 0,1:31:40.25,1:31:43.85,bl,,0,0,0,,أن السيد أيوا ناجا كانت تفوح منه رائحة البارود
Dialogue: 0,1:31:43.92,1:31:45.72,bl,,0,0,0,,ربما كان ذلك بسبب البندقية المهترئة
Dialogue: 0,1:31:45.79,1:31:50.20,bl,,0,0,0,,عندما أطلع العيار الناري منها تركت خلفه أثرا كبيرا يسهل تتبعه
Dialogue: 0,1:31:50.26,1:31:51.36,bl,,0,0,0,,هكذا إذا
Dialogue: 0,1:31:51.43,1:31:52.96,bl,,0,0,0,,عرفت بهذا الأمر منذ وقت طويل
Dialogue: 0,1:31:53.70,1:31:56.43,bl,,0,0,0,,ياله من متحر بارع حقا موري كوجورو
Dialogue: 0,1:31:59.57,1:32:00.40,bl,,0,0,0,,زلزال؟
Dialogue: 0,1:32:03.61,1:32:04.51,bl,,0,0,0,,توقف
Dialogue: 0,1:32:07.11,1:32:08.64,bl,,0,0,0,,الوضع سيء،لابد أن نهرب حالا
Dialogue: 0,1:32:08.72,1:32:11.01,bl,,0,0,0,,لنسرع بالصعود إلى ظهر السفينة
Dialogue: 0,1:32:14.02,1:32:15.58,bl,,0,0,0,,ساعدني سيد أيوا ناجا في ربط المجرمين
Dialogue: 0,1:32:15.66,1:32:16.59,bl,,0,0,0,,حسنا
Dialogue: 0,1:32:23.90,1:32:24.76,bl,,0,0,0,,هذا سيء
Dialogue: 0,1:32:25.40,1:32:27.37,bl,,0,0,0,,كلا،المدخل قد أغلق تماما
Dialogue: 0,1:32:29.64,1:32:30.57,bl,,0,0,0,,رائحة غاز
Dialogue: 0,1:32:31.04,1:32:32.44,bl,,0,0,0,,يجب علينا أن نخرج من هنا حالا
Dialogue: 0,1:32:32.94,1:32:33.84,bl,,0,0,0,,أسرعوا بالصعود
Dialogue: 0,1:32:48.72,1:32:50.59,bl,,0,0,0,,....تبا،لو استمر الوضع هكذا
Dialogue: 0,1:32:51.06,1:32:53.89,bl,,0,0,0,,كونان،ماذا نفعل الآن؟
Dialogue: 0,1:32:53.96,1:32:57.06,bl,,0,0,0,,،أولا:أدخلوهم في غرفة القبطان
Dialogue: 0,1:32:57.13,1:32:57.72,bl,,0,0,0,,وذلك لكي لا تنتهي
Dialogue: 0,1:32:57.80,1:33:00.06,bl,,0,0,0,,أسطوانتا الهواء
Dialogue: 0,1:33:00.13,1:33:01.76,bl,,0,0,0,,وتجنبوا تعريضهم لرائحة الغاز
Dialogue: 0,1:33:02.20,1:33:04.97,bl,,0,0,0,,واستعملي يا ران هذه الأدوات
Dialogue: 0,1:33:05.04,1:33:07.13,bl,,0,0,0,,ما هذه؟
Dialogue: 0,1:33:07.37,1:33:10.07,bl,,0,0,0,,أسطوانتا أوكسجين صنعهما الدكتور أغاسا
Dialogue: 0,1:33:10.14,1:33:11.51,bl,,0,0,0,,وماذا عنك؟
Dialogue: 0,1:33:11.58,1:33:14.21,bl,,0,0,0,,لدي واحدة أخرى لا تقلقي
Dialogue: 0,1:33:15.85,1:33:16.75,bl,,0,0,0,,هكذا إذا
Dialogue: 0,1:33:26.09,1:33:27.89,bl,,0,0,0,,تبا،ماذا سنفعل؟
Dialogue: 0,1:33:27.96,1:33:29.29,bl,,0,0,0,,إن استمر الوضع هكذا...فسنختنق بالغاز
Dialogue: 0,1:33:30.70,1:33:31.79,bl,,0,0,0,,غاز؟
Dialogue: 0,1:33:34.64,1:33:37.16,bl,,0,0,0,,ربما يكون هذا الغاز هو الميثان
Dialogue: 0,1:33:37.24,1:33:38.90,bl,,0,0,0,,يجب أن يكون منتشرا بكثرة في السقف بقربنا
Dialogue: 0,1:33:39.91,1:33:41.57,bl,,0,0,0,,....ماذا لو تم استخدام الغاز
Dialogue: 0,1:33:42.38,1:33:44.74,bl,,0,0,0,,هل هناك ما يشعله؟
Dialogue: 0,1:33:46.78,1:33:47.58,bl,,0,0,0,,هذه هي
Dialogue: 0,1:33:48.72,1:33:50.88,bl,,0,0,0,,ران وسونوكو
Dialogue: 0,1:33:50.95,1:33:52.51,bl,,0,0,0,,أريدكما أن تستمعا إلي جيدا
Dialogue: 0,1:33:53.32,1:33:55.75,bl,,0,0,0,,بما أن الماء يتدفق إلى هنا
Dialogue: 0,1:33:55.82,1:33:57.92,bl,,0,0,0,,لا يمكن أن تكون الصخور صلبة الآن
Dialogue: 0,1:33:57.99,1:34:00.26,bl,,0,0,0,,وإن افتعلنا انفجارا غازيا
Dialogue: 0,1:34:00.33,1:34:01.52,bl,,0,0,0,,فسيرمي بنا بعيدا
Dialogue: 0,1:34:01.60,1:34:02.76,bl,,0,0,0,,وسنخرج هكذا
Dialogue: 0,1:34:03.30,1:34:06.66,bl,,0,0,0,,هل سنأخذ هذه السفينة لنهرب بها؟
Dialogue: 0,1:34:06.73,1:34:08.53,bl,,0,0,0,,هل شيء كهذا مسموح به قانونيا؟
Dialogue: 0,1:34:08.60,1:34:09.73,bl,,0,0,0,,لا أعرف
Dialogue: 0,1:34:09.80,1:34:12.77,bl,,0,0,0,,لكن إن لم نفعل شيئا فسنموت بسبب الغاز
Dialogue: 0,1:34:12.84,1:34:15.27,bl,,0,0,0,,وسنغرق بعدها في عرض المحيط
Dialogue: 0,1:34:15.34,1:34:16.64,bl,,0,0,0,,وسنموت لا محالة
Dialogue: 0,1:34:18.11,1:34:19.91,bl,,0,0,0,,يبدو أنها فرصتنا الوحيدة
Dialogue: 0,1:34:21.32,1:34:23.25,bl,,0,0,0,,كونان،ماذا نفعل الآن؟
Dialogue: 0,1:34:24.05,1:34:27.78,bl,,0,0,0,,سوف أضع قفلين فوق بعضهما
Dialogue: 0,1:34:27.85,1:34:29.75,bl,,0,0,0,,وسأركلهما بصخرة في السقف
Dialogue: 0,1:34:29.82,1:34:31.29,bl,,0,0,0,,وسترمي بشرر بسيط
Dialogue: 0,1:34:31.36,1:34:33.38,bl,,0,0,0,,مما سيسبب انفجارا للغاز
Dialogue: 0,1:34:33.46,1:34:37.29,bl,,0,0,0,,وأنتما ستستخدمان أسطوانتي الأوكسجين التي لديكما
Dialogue: 0,1:34:37.36,1:34:38.73,bl,,0,0,0,,وعند لحظة الانفجار
Dialogue: 0,1:34:38.80,1:34:41.67,bl,,0,0,0,,سيختفي الأوكسجين مباشرة
Dialogue: 0,1:34:42.44,1:34:43.66,bl,,0,0,0,,وماذا عنك؟
Dialogue: 0,1:34:43.74,1:34:45.00,bl,,0,0,0,,لا تقلقي
Dialogue: 0,1:34:45.07,1:34:46.77,bl,,0,0,0,,عندما أركل القفلين إلى السقف
Dialogue: 0,1:34:46.84,1:34:49.71,bl,,0,0,0,,سأقفز بعدها إلى غرفة القبطان
Dialogue: 0,1:34:58.05,1:34:59.02,bl,,0,0,0,,فهمت
Dialogue: 0,1:35:07.89,1:35:08.86,bl,,0,0,0,,أيها المفتش كيغوري
Dialogue: 0,1:35:09.96,1:35:11.33,bl,,0,0,0,,جهزوا السفن والقوارب
Dialogue: 0,1:35:11.40,1:35:12.52,bl,,0,0,0,,وتأهبوا لعملية الإنقاذ
Dialogue: 0,1:35:12.83,1:35:13.70,bl,,0,0,0,,علم
Dialogue: 0,1:35:32.02,1:35:34.08,bl,,0,0,0,,تم تجهيز الإعدادات يا كونان
Dialogue: 0,1:35:39.86,1:35:40.59,bl,,0,0,0,,حسنا
Dialogue: 0,1:36:40.52,1:36:41.51,bl,,0,0,0,,.سأغرق
Dialogue: 0,1:36:59.97,1:37:01.07,bl,,0,0,0,,كونان
Dialogue: 0,1:37:01.68,1:37:02.77,bl,,0,0,0,,كونان
Dialogue: 0,1:37:03.84,1:37:05.40,bl,,0,0,0,,تماسك،كونان
Dialogue: 0,1:37:08.42,1:37:09.51,bl,,0,0,0,,ران
Dialogue: 0,1:37:17.52,1:37:18.99,bl,,0,0,0,,ارفع سرعتك
Dialogue: 0,1:37:19.06,1:37:20.96,bl,,0,0,0,,!أسرع
Dialogue: 0,1:37:39.31,1:37:41.08,bl,,0,0,0,,سفينة قراصنة؟
Dialogue: 0,1:37:57.53,1:37:58.50,bl,,0,0,0,,!ران
Dialogue: 0,1:37:59.50,1:38:01.73,bl,,0,0,0,,ران،أأنت بخير؟
Dialogue: 0,1:38:01.80,1:38:03.83,bl,,0,0,0,,أنا بخير
Dialogue: 0,1:38:03.90,1:38:05.06,bl,,0,0,0,,نجونا
Dialogue: 0,1:38:18.15,1:38:19.35,bl,,0,0,0,,!ابتعدوا حالا
Dialogue: 0,1:38:20.39,1:38:21.35,bl,,0,0,0,,!الأمر خطر
Dialogue: 0,1:38:21.45,1:38:22.85,bl,,0,0,0,,!اقفزوا في البحر
Dialogue: 0,1:38:22.92,1:38:23.98,bl,,0,0,0,,سونوكو
Dialogue: 0,1:38:27.16,1:38:28.15,bl,,0,0,0,,أسرع
Dialogue: 0,1:38:51.12,1:38:53.61,bl,,0,0,0,,ما نتائج البحث عن الكنز؟
Dialogue: 0,1:38:53.69,1:38:54.65,bl,,0,0,0,,لم نجد الكنز
Dialogue: 0,1:38:54.72,1:38:57.35,bl,,0,0,0,,وجدنا حطام سفينة فحسب
Dialogue: 0,1:38:57.42,1:38:59.69,bl,,0,0,0,,ليس هذا ما قصدوه بالكنز
Dialogue: 0,1:39:00.06,1:39:03.62,bl,,0,0,0,,لتأمين الخريطة
Dialogue: 0,1:39:03.70,1:39:06.03,bl,,0,0,0,,ما كانت خريطة الكنز مبنية عليه ليس مكانا صحيحا
Dialogue: 0,1:39:06.10,1:39:11.80,bl,,0,0,0,,ولكنها رسالة تركتها ماري لمن بعدها في السجن
Dialogue: 0,1:39:11.87,1:39:13.10,bl,,0,0,0,,رسالة؟
Dialogue: 0,1:39:13.21,1:39:14.73,bl,,0,0,0,,كم أتمنى أن يحدث هذا
Dialogue: 0,1:39:14.81,1:39:19.11,bl,,0,0,0,,أن يترك لي شينيتشي رسالة بعد طول انتظار
Dialogue: 0,1:39:19.31,1:39:20.57,bl,,0,0,0,,.كنت أمزح
Dialogue: 0,1:39:20.65,1:39:21.84,bl,,0,0,0,,سونوكو
Dialogue: 0,1:39:24.12,1:39:27.58,bl,,0,0,0,,ما تقوم به يجعلك كالطفل فعلا
Dialogue: 0,1:39:27.65,1:39:31.49,bl,,0,0,0,,لا،بل ما قاله من الممكن أن يكون الحقيقة
Dialogue: 0,1:39:32.83,1:39:34.79,bl,,0,0,0,,أعتقد أن الأمر وما فيه ربما
Dialogue: 0,1:39:34.86,1:39:37.42,bl,,0,0,0,,كان المقدر في المستقبل أن تهرب ماري
Dialogue: 0,1:39:37.50,1:39:41.80,bl,,0,0,0,,أبحرتا في البحار السبعة مع بعضهما
Dialogue: 0,1:39:41.87,1:39:44.67,bl,,0,0,0,,وهذا ما بقي من سفينتهم
Dialogue: 0,1:39:44.74,1:39:48.90,bl,,0,0,0,,أيا كان،كانت ماري مريضة في السجن
Dialogue: 0,1:39:48.98,1:39:50.91,bl,,0,0,0,,وتوفيت فيه
Dialogue: 0,1:39:50.98,1:39:55.51,bl,,0,0,0,,ظلت ماري مناضلة إلى أن توفيت
Dialogue: 0,1:39:55.92,1:39:58.85,bl,,0,0,0,,وتركوا السفينة خلفهم
Dialogue: 0,1:39:58.92,1:40:01.55,bl,,0,0,0,,وظلت السفينة مدفونة في الكهوف
Dialogue: 0,1:40:01.62,1:40:05.99,bl,,0,0,0,,تنتظر اليوم الذي تبحر فيه في البحر
Dialogue: 0,1:40:06.06,1:40:08.03,bl,,0,0,0,,اليوم،وبعد 300 سنة
Dialogue: 0,1:40:08.09,1:40:11.00,bl,,0,0,0,,كان أول وآخر إبحار لها
Dialogue: 0,1:40:11.06,1:40:14.23,bl,,0,0,0,,وأنتم من أنهى أمرها
Dialogue: 0,1:40:14.30,1:40:18.80,bl,,0,0,0,,فلحقت ببحارتيها الاثنتين
Dialogue: 0,1:40:20.37,1:40:22.97,bl,,0,0,0,,اعذروني على الكلمات التي استخدمتها
Dialogue: 0,1:40:23.04,1:40:24.41,bl,,0,0,0,,أتمنى أن لا أكون قد أزعجتكم
Dialogue: 0,1:40:28.75,1:40:31.11,bl,,0,0,0,,أيا كان،حتى مرور 300 سنة
Dialogue: 0,1:40:31.18,1:40:34.18,bl,,0,0,0,,الحقيقة أنها كانت ستغرق لا محالة
Dialogue: 0,1:40:34.25,1:40:38.25,bl,,0,0,0,,لا،في الحقيقة أنها كانت تنتظر ماري لتقودها
Dialogue: 0,1:40:38.33,1:40:39.26,bl,,0,0,0,,عمي
Dialogue: 0,1:40:39.56,1:40:44.02,bl,,0,0,0,,تم العثور على الأدلة خلف علم القراصنة
Dialogue: 0,1:40:48.97,1:40:52.56,bl,,0,0,0,,وعثر أيضا على مسدس ماري وسيفها
Dialogue: 0,1:44:50.98,1:44:52.04,bl,,0,0,0,,ران
Dialogue: 0,1:44:52.58,1:44:55.14,bl,,0,0,0,,أريد أن أسألك سؤالا ياران
Dialogue: 0,1:44:55.21,1:45:00.62,bl,,0,0,0,,كيف عرفتي في ذلك الوقت أنني لا أملك أسطوانة أوكسجين؟
Dialogue: 0,1:45:03.02,1:45:06.42,bl,,0,0,0,,لأنكم متشابهون في ذلك الأمر أيها الشباب
Dialogue: 0,1:45:08.29,1:45:10.85,bl,,0,0,0,,أذكر أنني عندما كنت في الصف الثاني ثانوي
Dialogue: 0,1:45:10.93,1:45:14.89,bl,,0,0,0,,وكنت عائدة من المدرسة في يوم ماطر جدا
Dialogue: 0,1:45:22.58,1:45:23.87,bl,,0,0,0,,ما هذا؟
Dialogue: 0,1:45:24.98,1:45:26.41,bl,,0,0,0,,خذي هذه
Dialogue: 0,1:45:28.78,1:45:30.98,bl,,0,0,0,,يجب أن تعودي إلى المنزل بسرعة
Dialogue: 0,1:45:31.05,1:45:33.48,bl,,0,0,0,,شكرا
Dialogue: 0,1:45:33.55,1:45:35.11,bl,,0,0,0,,ولكن ماذا عنك أنت؟
Dialogue: 0,1:45:35.19,1:45:37.99,bl,,0,0,0,,حمقاء،أنا متحر مستعد مسبقا لمثل هذه الظروف
Dialogue: 0,1:45:38.06,1:45:40.65,bl,,0,0,0,,لقد توقعت أن المطر سيهطل اليوم
Dialogue: 0,1:45:42.13,1:45:44.29,bl,,0,0,0,,لذا أحضرت واحدة أخرى في حقيبتي
Dialogue: 0,1:45:44.53,1:45:45.69,bl,,0,0,0,,حقا؟
Dialogue: 0,1:45:45.77,1:45:46.56,bl,,0,0,0,,رائع
Dialogue: 0,1:45:46.63,1:45:48.69,bl,,0,0,0,,الحمدلله،أخبرتني أمي أنه يتوجب علي
Dialogue: 0,1:45:48.77,1:45:50.17,bl,,0,0,0,,أخذ المظلة لكي أحتمي بها من المطر
Dialogue: 0,1:45:50.24,1:45:51.33,bl,,0,0,0,,سأردها لك غدا
Dialogue: 0,1:45:51.40,1:45:52.34,bl,,0,0,0,,أوه
Dialogue: 0,1:45:53.64,1:45:57.84,bl,,0,0,0,,ولكن شينيتشي لم تكن لديه مظلة أخرى
Dialogue: 0,1:45:58.58,1:46:00.38,bl,,0,0,0,,تبلل جسده بالكامل حين عودته
Dialogue: 0,1:46:00.45,1:46:02.04,bl,,0,0,0,,وأصيب بالزكام والبرد
Dialogue: 0,1:46:03.15,1:46:03.88,bl,,0,0,0,,نعم
Dialogue: 0,1:46:03.95,1:46:07.11,bl,,0,0,0,,أفكر بأنكما متشابهان
Dialogue: 0,1:46:07.65,1:46:08.75,bl,,0,0,0,,تحبان التفاخر
Dialogue: 0,1:46:08.82,1:46:11.85,bl,,0,0,0,,!وهذا ما يجعلكما كالأحمقين الكبيرين
Dialogue: 0,1:46:15.33,1:46:16.49,bl,,0,0,0,,آسف جدا
Dialogue: 0,1:46:16.56,1:46:17.43,bl,,0,0,0,,...على حماقتي
