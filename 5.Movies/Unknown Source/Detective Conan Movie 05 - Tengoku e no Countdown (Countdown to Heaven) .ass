Dialogue: 0,0:00:02.00,0:00:10.00,bodi,,0,0,0,,{\fscx179\fscy232\pos(943.73,877.461)}شركة توهو المحدودة
Dialogue: 0,0:00:27.36,0:00:30.53,Default 2,,0,0,0,,!رائع! إنه جبل فوجي -\N!إنه جميلٌ جدًا -
Dialogue: 0,0:00:30.53,0:00:33.24,Default 2,,0,0,0,,!إنه حتمًا أفضل جبلٍ في اليابان
Dialogue: 0,0:00:33.24,0:00:34.86,Default 2,,0,0,0,,ما هذا؟
Dialogue: 0,0:00:36.57,0:00:41.37,Default 2,,0,0,0,,هذان هم البرجان التوأمان الجديدان\N"بمدينة غرب "تاما
Dialogue: 0,0:00:41.41,0:00:48.13,Default 2,,0,0,0,,ارتفاع أحدهما 319 مترًا والآخر 294 مترًا\N!وهما التوأمان الأطول في اليابان
Dialogue: 0,0:00:48.17,0:00:50.30,Default 2,,0,0,0,,!أتمنى لو أني أستطيع زيارتهما
Dialogue: 0,0:00:50.34,0:00:54.13,Default 2,,0,0,0,,بروفيسور! لما لا نزورهما غدًا\N!في طريق عودتنا من المخيم
Dialogue: 0,0:00:54.18,0:00:59.26,Default 2,,0,0,0,,إنه بعيدٌ عن طريق عودتنا قليلًا\Nولكن بالتأكيد سنفعل
Dialogue: 0,0:00:59.31,0:01:01.81,Thoughts - up,,0,0,0,,...مدينة غرب تاما
Dialogue: 0,0:01:01.85,0:01:05.14,Thoughts - up,,0,0,0,,هناك كشفت عن جريمة العمدة السابق
Dialogue: 0,0:01:05.19,0:01:09.23,Thoughts - up,,0,0,0,,{\i0}...وأيضًا حيث حاول [موريا تيجي] اختبار قدراتي{\i0}
Dialogue: 0,0:01:09.27,0:01:14.61,Thoughts,,0,0,0,,{\i0}...من الواضح أن هؤلاء الرفاق يحبون التخييم{\i0}
Dialogue: 0,0:01:14.65,0:01:17.78,Default 2,,0,0,0,,!مخيمٌ غدًا! مخيمٌ بعد الغد
Dialogue: 0,0:01:28.21,0:01:31.17,Default 2,,0,0,0,,!شكرًا لك على الطعام
Dialogue: 0,0:01:31.21,0:01:34.30,Default 2,,0,0,0,,!تمهل\N!لقد تبقى منك بعض الأرز
Dialogue: 0,0:01:34.34,0:01:38.64,Default 2,,0,0,0,,قالت أمي أن إهدار ولو حبة أرزٍ واحدة\N!أمرٌ يجلب الحظ السيئ
Dialogue: 0,0:01:38.64,0:01:44.93,Default 2,,0,0,0,,هذا صحيح! فمزارعي الأرز يعملون بجد\N!لثمانِ وثمانين مرة حتى يزرعوا الأرز
Dialogue: 0,0:01:44.98,0:01:46.48,Default 2,,0,0,0,,ثمانيةٌ وثمانون مرة؟
Dialogue: 0,0:01:46.52,0:01:47.85,Default 2,,0,0,0,,!أجل
Dialogue: 0,0:01:47.90,0:01:53.32,Default 2,,0,0,0,,إذا قطعت الحرف الدال على كلمة أرز\Nتحصل على الرقم "88"، أليس كذلك؟
Dialogue: 0,0:01:53.32,0:01:54.53,Default 2,,0,0,0,,حقًا؟
Dialogue: 0,0:01:54.57,0:01:56.82,Default 2,,0,0,0,,!أجل، صحيح -\N!أنت محق -
Dialogue: 0,0:01:56.82,0:02:00.95,Default 2,,0,0,0,,ولهذا يدعى سن الـ88 بسن الأرز
Dialogue: 0,0:02:00.95,0:02:04.37,Default 2,,0,0,0,,بينما يدعى سن الـ77 بسن السعادة
Dialogue: 0,0:02:04.41,0:02:07.25,Default 2,,0,0,0,,وسن الـ99 يدعى بسن الكهول
Dialogue: 0,0:02:07.29,0:02:10.33,Default 2,,0,0,0,,هل تعرف لم سن الـ77 يدعى بسن السعادة؟
Dialogue: 0,0:02:10.38,0:02:14.26,Default 2,,0,0,0,,لأن الحرف الدال على كلمة سعادة\Nيبدو كرقم 77 بالكتابة المتصلة
Dialogue: 0,0:02:14.30,0:02:15.30,Default 2,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:02:15.30,0:02:18.88,Default 2,,0,0,0,,سن الكهول هو 99 لأن كلمة كهل\Nهي رقم 100 ولكن ينقصه سطر
Dialogue: 0,0:02:18.93,0:02:23.39,Default 2,,0,0,0,,!رائع!  إنكما دائمًا ما تعرفان الكثير
Dialogue: 0,0:02:23.43,0:02:27.56,Default 2,,0,0,0,,أراهن أنكما في الواقع تكذبان\N!بشأن أعماركما
Dialogue: 0,0:02:27.60,0:02:29.31,Default 2,,0,0,0,,...أنت محقٌ في هذا
Dialogue: 0,0:02:29.35,0:02:31.69,Default 2,,0,0,0,,!والآن لدي لغزٌ لكم
Dialogue: 0,0:02:31.69,0:02:36.36,Default 2,,0,0,0,,!هل لكم أن تخمنوا ماذا يدعى سن الـ44؟
Dialogue: 0,0:02:36.36,0:02:39.28,Default 2,,0,0,0,,44؟
Dialogue: 0,0:02:39.32,0:02:42.37,Default 2,,0,0,0,,!إليكم تلميح\N!حرفٌ بنظام الكانجي وثلاثةٌ بنظام الكاتاكانا
Dialogue: 0,0:02:42.37,0:02:43.78,Default 2,,0,0,0,,!ولا تحتاجون لإضافة كلمة "سن" بالنهاية
Dialogue: 0,0:02:43.83,0:02:44.33,Default 2,,0,0,0,,44"\N!ولا تحتاجون لإضافة كلمة "سن" بالنهاية
Dialogue: 0,0:02:44.37,0:02:47.79,Default 2,,0,0,0,,44"\N...حرفٌ بنظام الكانجي وثلاثةٌ بنظام الكاتاكانا
Dialogue: 0,0:02:47.83,0:02:49.12,Default 2,,0,0,0,,44"\Nماذا يمكن أن تكون؟
Dialogue: 0,0:02:49.17,0:02:49.67,Default 2,,0,0,0,,ماذا يمكن أن تكون؟
Dialogue: 0,0:02:49.71,0:02:55.46,Default 2,,0,0,0,,44...88...\N!يا إلهي
Dialogue: 0,0:02:55.50,0:02:59.72,Default 2,,0,0,0,,!بروفيسور\Nلقد توصلت للحل، ولكن يا له من لغزٍ غبي
Dialogue: 0,0:02:59.72,0:03:01.55,Default 2,,0,0,0,,أتظن ذلك؟
Dialogue: 0,0:03:01.59,0:03:05.01,Default 2,,0,0,0,,ماذا عنك يا [آي]؟\Nهل عرفتِ الحل؟
Dialogue: 0,0:03:05.06,0:03:07.35,Default 2,,0,0,0,,!أنا لا أعرف أيضًا -\N!ولا أنا -
Dialogue: 0,0:03:07.35,0:03:08.73,Default 2,,0,0,0,,!بالمثل
Dialogue: 0,0:03:08.77,0:03:14.61,Default 2,,0,0,0,,!إذًا فها هي الإجابة\N44تساوي نصف 88 ،أليس كذلك؟
Dialogue: 0,0:03:14.65,0:03:21.91,Default 2,,0,0,0,,88هو سن الأرز وبما أن\N!هذا نصف ذاك، فيكون الحل نصف طبق أرز
Dialogue: 0,0:03:21.95,0:03:24.58,Default 2,,0,0,0,,...تمامًا كما ظننت
Dialogue: 0,0:03:24.62,0:03:27.29,Default 2,,0,0,0,,ماذا؟ ما خطبكم؟
Dialogue: 0,0:03:27.33,0:03:30.46,Default 2,,0,0,0,,!نصف طبق أرز \N !لنتناول اثنين منه
Dialogue: 0,0:03:30.50,0:03:31.46,Default 2,,0,0,0,,هل فهمتم؟
Dialogue: 0,0:03:41.97,0:03:43.39,Default 2,,0,0,0,,"الحمامات"
Dialogue: 0,0:03:43.43,0:03:45.60,Default 2,,0,0,0,,"الحمامات"\N...لقد بللت سروالي قليلًا
Dialogue: 0,0:03:45.60,0:03:46.26,Default 2,,0,0,0,,"الحمامات"
Dialogue: 0,0:03:52.65,0:03:54.36,Default 2,,0,0,0,,!يا إلهي
Dialogue: 0,0:03:54.40,0:03:55.36,Default 2,,0,0,0,,يبدو أني سأذهب
Dialogue: 0,0:03:55.40,0:03:59.07,Default 2,,0,0,0,,إلى البرجين التوأمين بمدينة غرب "تاما" غدًا
Dialogue: 0,0:03:59.07,0:04:01.70,Default 2,,0,0,0,,إنه قادم هو أيضًا بالتأكيد
Dialogue: 0,0:04:06.12,0:04:11.46,Default 2,,0,0,0,,!لقد عرفت يا زعيم\N!"البرجين التوأم بمدينة غرب "تاما
Dialogue: 0,0:04:14.38,0:04:18.46,Default 2,,0,0,0,,!يقولون أنه المكان الأقرب إلى الجنة حسبما أتذكر
Dialogue: 0,0:04:18.46,0:04:22.63,Default 2,,0,0,0,,ممتاز\Nإنه الأقرب لما بعد الحياة إذًا
Dialogue: 0,0:04:22.68,0:04:25.30,Default 2,,0,0,0,,!لنستخدمه في إعدام أحدهم
Dialogue: 0,0:04:52.25,0:04:54.87,Another,,0,0,0,,{\i0}أدعى [كودو شينتشي] وأنا متحر بالمرحلة الثانوية{\i0}
Dialogue: 0,0:04:54.92,0:04:58.88,Another,,0,0,0,,{\i0}عندما ذهبت مع صديقتي القديمة وزميلتي بالصف [ران موري] إلى مدينة الملاهي{\i0}
Dialogue: 0,0:04:58.92,0:05:03.42,Another,,0,0,0,,{\1}!التي شاهدت بها صفقة مريبة لرجال يرتدون لباسًا أسودًا{\i0}
Dialogue: 0,0:05:03.47,0:05:05.68,Another,,0,0,0,,{\1}كنت مندمجًا حقًا في مشاهدة تلك الصفقة{\i0}
Dialogue: 0,0:05:05.68,0:05:10.89,Another,,0,0,0,,{\}!لدرجة أنني لم ألحظ تسلل أحدهم خلفي{\i0}
Dialogue: 0,0:05:10.93,0:05:15.73,Another,,0,0,0,,{\i0}...وأجبرني ذاك الرجل على احتساء عقار ما، وعندما صحوت{\i0}
Dialogue: 0,0:05:15.77,0:05:18.86,Another,,0,0,0,,{\1}!وجدت جسدي متقلصًا{\i0}
Dialogue: 0,0:05:18.86,0:05:22.36,Another,,0,0,0,,{\1\pos(960,1080)}وإن علموا بأن [كودو شينتشي] ما يزال على قيد الحياة فلربما يسعون خلفي مجددًا{\i0}
Dialogue: 0,0:05:22.40,0:05:25.49,Another,,0,0,0,,{\i0}!مما يضع كافة من هم حولي في خطر محدق{\i0}
Dialogue: 0,0:05:25.49,0:05:29.28,Another,,0,0,0,,{\1}وبنصيحة من البروفيسور [أغاسا]، قررت إخفاء هويتي{\i0}
Dialogue: 0,0:05:29.33,0:05:33.33,Another,,0,0,0,,وعندما سألتني [ران] عن اسمي جاوبت مسرعًا بأن اسمي هو [إيدوغاوا كونان]{\i0}
Dialogue: 0,0:05:33.33,0:05:34.58,Another,,0,0,0,,{\1}وللحصول على معلومات عن هؤلاء الرجال{\i0}
Dialogue: 0,0:05:34.62,0:05:37.92,Another,,0,0,0,,{\1}انتهى بي المطاف بالعيش مع [ران] ووالدها المحقق{\i0}
Dialogue: 0,0:05:41.88,0:05:43.88,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,0:05:43.88,0:05:47.30,Default 2,,0,0,0,,أنا [أغاسا هيروشي]\N!مخترعٌ عبقري
Dialogue: 0,0:05:47.34,0:05:50.26,Default 2,,0,0,0,,دعوني أستغل هذه الفرصة\N!لأقدم رائعة عملي
Dialogue: 0,0:05:50.30,0:05:54.31,Default 2,,0,0,0,,{\pos(960,1076)}!ساعة مسدس التخدير رابطة العنق المغيرة للصوت
Dialogue: 0,0:05:54.35,0:05:56.39,Default 2,,0,0,0,,!حذاء تعزيز قوة الركلة
Dialogue: 0,0:05:56.39,0:05:58.90,Default 2,,0,0,0,,{\pos(960,1078)}!لوح التزلج المزود بمحرك-تربو
Dialogue: 0,0:05:58.90,0:06:02.27,Default 2,,0,0,0,,{\pos(960,1082)}!نظارة تحديد مواقع المجرمين
Dialogue: 0,0:06:02.32,0:06:07.28,Default 2,,0,0,0,,!واحدةٌ من العدسات بها أداةٌ أخرى أيضًا
Dialogue: 0,0:06:07.32,0:06:12.79,Default 2,,0,0,0,,!تلسكوب الآشعة تحت الحمراء
Dialogue: 0,0:06:12.83,0:06:17.33,Default 2,,0,0,0,,لقد صنعت كل تلك الأدوات\N!من أجل [شينتشي] الذي بات صغيرًا الآن
Dialogue: 0,0:06:17.37,0:06:22.59,Default 2,,0,0,0,,فهو يستخدم تلك الأدوات ليحل القضايا باستخدام صوت السيد [موري]
Dialogue: 0,0:06:22.59,0:06:24.84,Default 2,,0,0,0,,!وللقبض على الأشرار
Dialogue: 0,0:06:24.88,0:06:26.17,Default 2,,0,0,0,,!خذ هذه
Dialogue: 0,0:06:30.51,0:06:33.39,Default 2,,0,0,0,,!أجل، صحيح\N!كدت أنسى
Dialogue: 0,0:06:33.39,0:06:38.06,Default 2,,0,0,0,,أنا أيضًا اخترعت شارات المتحرين والساعة المزودة بمصباح
Dialogue: 0,0:06:38.06,0:06:41.77,Default 2,,0,0,0,,{\pos(960,1078)}والتى قد جعل زملائه في الفصل\N!يستخدمونها من أجل تحالف المحققين الصغار الخاص بهم
Dialogue: 0,0:06:41.81,0:06:47.36,Default 2,,0,0,0,,وبخلافي، ثمة أربعة أشخاص آخرين\Nيعرفون من هو
Dialogue: 0,0:06:47.40,0:06:51.37,Default 2,,0,0,0,,والده وكاتب قصص الغموض، [كودو ياساكو]
Dialogue: 0,0:06:51.41,0:06:54.41,Default 2,,0,0,0,,ووالدته الممثلة السابقة، [كودو يوكيكو]
Dialogue: 0,0:06:54.41,0:06:57.54,Default 2,,0,0,0,,ومتحر المرحلة الثانوية بالغرب، [هاتوري هيجي]
Dialogue: 0,0:06:57.58,0:07:01.46,Default 2,,0,0,0,,وزميلته في الفصل، [هايبرا آي]
Dialogue: 0,0:07:01.50,0:07:03.79,Default 2,,0,0,0,,اسمها الحقيقي هو [ميانو شيهو]
Dialogue: 0,0:07:03.84,0:07:06.55,Default 2,,0,0,0,,كانت تعمل مع الرجال ذوي الملابس السوداء
Dialogue: 0,0:07:06.59,0:07:11.68,Default 2,,0,0,0,,ولكن بعد أن قتلوا أختها\Nحاولت الهرب من المنظمة
Dialogue: 0,0:07:11.72,0:07:18.48,Default 2,,0,0,0,,...فتناولت نفس العقار الذي تناوله [شينتشي]\Nوانتهى بها المطاف متقلصةً
Dialogue: 0,0:07:18.48,0:07:23.40,Default 2,,0,0,0,,{\i0}!الرجال ذوي الملابس السوداء يطاردون [هايبرا] بلا هوادة{\i0}
Dialogue: 0,0:07:23.44,0:07:29.45,Default 2,,0,0,0,,{\i0}!والآن، الأمر غير جليّ بالنسبة إلي ولكن شيء ما على وشك الحدوث{\i0}
Dialogue: 0,0:07:29.49,0:07:33.82,Default 2,,0,0,0,,حتي وإن تقلص جسدي\N!فإني مازلت أمتلك عقل متحرٍ بارع
Dialogue: 0,0:07:33.82,0:07:36.79,Default 2,,0,0,0,,!ثمة حقيقة واحدة دائمًا
Dialogue: 0,0:07:42.42,0:07:44.54,Default 2,,0,0,0,,...أشعر بأنني مسحوقٌ هنا
Dialogue: 0,0:07:44.59,0:07:49.13,Default 2,,0,0,0,,!لأنك تجلس بالخلف\N!لقد جلست بالأمام في المرة الماضية
Dialogue: 0,0:07:49.17,0:07:52.01,Default 2,,0,0,0,,...بدا الأمر أكثر مرحًا في الخلف
Dialogue: 0,0:07:52.05,0:07:54.39,Default 2,,0,0,0,,هل يمكنك ان تتزحزح قليلًا يا [كونان]
Dialogue: 0,0:07:54.43,0:07:58.56,Default 2,,0,0,0,,هذا لأنك قد أكلت 5 أطباقٍ\N!من الأرز كأول شيء فعلته في صباحك
Dialogue: 0,0:07:58.60,0:08:01.23,Default 2,,0,0,0,,المعذرة يا [أيومي]، علي أن أتزحزح قليلًا
Dialogue: 0,0:08:02.52,0:08:05.40,Default 2,,0,0,0,,![ميتسوهيكو]\N!فلنلعب لعبة
Dialogue: 0,0:08:05.44,0:08:08.07,Default 2,,0,0,0,,!إذًا فلنلعب لعبة عد الثواني
Dialogue: 0,0:08:08.11,0:08:12.74,Default 2,,0,0,0,,تعد حتى ثلاثين في رأسك\Nثم توقف ساعة التوقيف
Dialogue: 0,0:08:12.78,0:08:15.57,Default 2,,0,0,0,,!رائع\N!فلنلعب كلنا
Dialogue: 0,0:08:15.62,0:08:18.16,Default 2,,0,0,0,,أنا مشغولٌ بالقيادة
Dialogue: 0,0:08:18.16,0:08:19.50,Default 2,,0,0,0,,لن ألعب أيضًا
Dialogue: 0,0:08:22.21,0:08:25.71,Default 2,,0,0,0,,28. 29. 30!
Dialogue: 0,0:08:25.75,0:08:28.88,Default 2,,0,0,0,,!أربعون ثانية! أي عشر ثوانٍ زائدة
Dialogue: 0,0:08:31.72,0:08:33.88,Default 2,,0,0,0,,29. 30!
Dialogue: 0,0:08:33.88,0:08:35.55,Default 2,,0,0,0,,!سبعةٌ و عشرون ثانية
Dialogue: 0,0:08:35.59,0:08:36.89,Default 2,,0,0,0,,!كان هذا قريبًا جدًا
Dialogue: 0,0:08:39.47,0:08:40.06,Default 2,,0,0,0,,!ثلاثون
Dialogue: 0,0:08:40.10,0:08:41.48,Default 2,,0,0,0,,!يا إلهي
Dialogue: 0,0:08:41.52,0:08:45.44,Default 2,,0,0,0,,تسعة وخمسون ثانية؟\Nأأنت متأكد ان هذا الشيء مازال يعمل؟
Dialogue: 0,0:08:45.48,0:08:47.44,Default 2,,0,0,0,,!أعتقد أنك أنت المخطئ يا [غينتا]
Dialogue: 0,0:08:50.03,0:08:53.11,Default 2,,0,0,0,,28! 29! 30!
Dialogue: 0,0:08:53.15,0:08:54.99,Default 2,,0,0,0,,!ثلاثون ثانيةً بالضبط
Dialogue: 0,0:08:55.03,0:08:58.58,Default 2,,0,0,0,,!رائعٌ يا [أيومي] -\N!لابد من أنك وسيطةٌ روحية -
Dialogue: 0,0:08:58.62,0:09:01.25,Default 2,,0,0,0,,...لقد كنت محظوظةً فقط
Dialogue: 0,0:09:01.25,0:09:06.67,Default 2,,0,0,0,,أخبريني يا [هايبرا]\Nبمن كنت تتصلين البارحة ليلًا؟
Dialogue: 0,0:09:06.71,0:09:10.50,Default 2,,0,0,0,,لم أتصل بأحد\Nأأنت واثقٌ من أنك لم تكن تحلم يا [كوجيما]؟
Dialogue: 0,0:09:10.55,0:09:12.51,Default 2,,0,0,0,,ماذا؟ هل كنت كذلك؟
Dialogue: 0,0:09:17.55,0:09:19.26,Default 2 - up,,0,0,0,,!إنه طويلٌ جدًا
Dialogue: 0,0:09:19.26,0:09:22.10,Default 2 - up,,0,0,0,,!لا أستطيع رؤية القمة
Dialogue: 0,0:09:22.14,0:09:24.60,Default 2,,0,0,0,,!يبدو كما لو أنه يتعدى السحاب
Dialogue: 0,0:09:31.28,0:09:32.82,Default 2,,0,0,0,,!أهذا أنت يا [كونان]؟
Dialogue: 0,0:09:32.86,0:09:35.61,Default 2,,0,0,0,,ماذا؟\N![ران]، ما الأمر؟
Dialogue: 0,0:09:35.65,0:09:38.66,Default 2,,0,0,0,,!يا هذا! ماذا تفعل هنا؟
Dialogue: 0,0:09:38.70,0:09:41.70,Default 2,,0,0,0,,لقد جئنا لتفقد المبنى\Nفي طريق عودتنا من التخييم
Dialogue: 0,0:09:41.74,0:09:43.70,Default 2,,0,0,0,,ماذا عنك؟
Dialogue: 0,0:09:44.87,0:09:48.29,Default 2,,0,0,0,,الآنسة [توكيوا ميو]، مالكة هذين التوأمين
Dialogue: 0,0:09:48.29,0:09:51.00,Default 2,,0,0,0,,كانت زميلةً لي أيام الدراسة
Dialogue: 0,0:09:51.04,0:09:55.51,Default 2,,0,0,0,,وقد دعتني خصيصًا من أجل\N!الافتتاح الكبير في الأسبوع القادم
Dialogue: 0,0:09:55.55,0:09:56.80,Default 2,,0,0,0,,ماذا؟ لم أسمع ابدًا بهذا الشأن
Dialogue: 0,0:09:56.80,0:10:00.89,Default 2,,0,0,0,,!أليس كذلك؟\N!هو حتى لم يخبرني أنا أيضًا
Dialogue: 0,0:10:00.93,0:10:03.85,Default 2,,0,0,0,,لقد اعترف فقط عندما قمت بلومه على\Nتصرفاته الغريبة
Dialogue: 0,0:10:03.89,0:10:06.56,Default 2,,0,0,0,,!اعترفت؟\N!لم أكن أخفي أي شيء
Dialogue: 0,0:10:06.60,0:10:10.94,Default 2,,0,0,0,,لقد فهمت! لقد جئتما كليكما\N!لتراقبانه
Dialogue: 0,0:10:10.94,0:10:14.99,Default 2,,0,0,0,,في النهاية، الآنسة [توكيوا ميو]\Nهي الابنة الغنية لـ[توكيوا زايباتسو]
Dialogue: 0,0:10:15.03,0:10:16.86,Default 2,,0,0,0,,!ومازالت عزباء
Dialogue: 0,0:10:16.90,0:10:20.53,Default 2,,0,0,0,,وحيث أن والدي [ران] منفصلان حاليًا\N!فهي قلقة
Dialogue: 0,0:10:22.62,0:10:25.70,Default 2,,0,0,0,,المعذرة، أأنت السيد [موري كوغورو]؟
Dialogue: 0,0:10:25.75,0:10:27.04,Default 2,,0,0,0,,أجل
Dialogue: 0,0:10:27.08,0:10:31.00,Default 2 - up,,0,0,0,,أنا [ساواغوتشي]، سكرتيرة الرئيس
Dialogue: 0,0:10:31.00,0:10:36.30,Default 2,,0,0,0,,إنها برفقة الضيوف حاليًا\Nولهذا سوف أريكم صالات العرض أولًا
Dialogue: 0,0:10:38.26,0:10:41.18,Default 2,,0,0,0,,المبنى "أ" يتكون من مكاتب عمل بالكامل
Dialogue: 0,0:10:41.22,0:10:46.02,Default 2,,0,0,0,,والطوابق الحادي والثلاثون وما فوقها\N"كلها تشغلها مؤسسة "توكيوا
Dialogue: 0,0:10:46.02,0:10:48.81,Default 2,,0,0,0,,صالات العرض تقع في الطابق\Nالثاني والثالث
Dialogue: 0,0:10:48.85,0:10:51.56,Default 2,,0,0,0,,أي نوعٍ من الشركات هي "توكيوا"؟
Dialogue: 0,0:10:51.61,0:10:53.73,Default 2,,0,0,0,,على الأغلب شركة برامج الحاسب
Dialogue: 0,0:10:53.77,0:10:57.07,Default 2,,0,0,0,,!ولكنهم يعملون بكافة ما يتعلق بالحواسيب
Dialogue: 0,0:10:57.11,0:11:01.07,Default 2,,0,0,0,,!أيعني هذا أنهم يمتلكون ألعاب فيديو أيضًا؟\N!لا يسعني الانتظار
Dialogue: 0,0:11:08.04,0:11:11.08,Default 2,,0,0,0,,!فقط انظر إلى كل هذه الأشياء المثيرة
Dialogue: 0,0:11:11.12,0:11:13.71,Default 2,,0,0,0,,!أهلًا بالجميع\N!مرحبًا
Dialogue: 0,0:11:13.71,0:11:16.09,Default 2,,0,0,0,,!هذا [هارا]، مدير الإدارة ومبرمج
Dialogue: 0,0:11:16.13,0:11:17.59,Default 2,,0,0,0,,!تشرفت بمقابلتكم
Dialogue: 0,0:11:17.63,0:11:20.38,Default 2,,0,0,0,,ما هذا؟ -\Nأهي لعبة أركاد؟ -
Dialogue: 0,0:11:20.38,0:11:21.76,Default 2,,0,0,0,,هل تريدون تجربتها؟
Dialogue: 0,0:11:21.80,0:11:26.06,Default 2 - up,,0,0,0,,إنها تستخدم الكمبيوتر لتخمّن\N!كيف ستبدون بعد عشر سنوات
Dialogue: 0,0:11:26.10,0:11:30.19,Default 2,,0,0,0,,ماذا؟ كيف ستبدو بعد عشر سنوات؟\N!هذا مذهل
Dialogue: 0,0:11:30.23,0:11:31.94,Default 2,,0,0,0,,!أيها البروفيسور\N!فلنجربها
Dialogue: 0,0:11:31.98,0:11:35.07,Default 2,,0,0,0,,رجاءً اجلسوا على المقاعد إذًا
Dialogue: 0,0:11:35.11,0:11:39.90,Default 2,,0,0,0,,لم أكن لأريد أن أرى وجهي العجوز\N...بعد عشر سنوات في المستقبل
Dialogue: 0,0:11:39.90,0:11:42.53,Default 2,,0,0,0,,هل أنتم مستعدون؟\N!ها نحن ذا
Dialogue: 0,0:11:56.71,0:12:01.68,Default 2,,0,0,0,,!إليكم النتائج بعد زمنٍ قدره عشر سنوات
Dialogue: 0,0:12:01.72,0:12:04.30,Default 2,,0,0,0,,...ماذا؟ لا فرق تمامًا
Dialogue: 0,0:12:04.34,0:12:06.72,Default 2,,0,0,0,,!تلك الآلة معطلة
Dialogue: 0,0:12:06.76,0:12:09.64,Default 2,,0,0,0,,{\1}لا، إنها ليست كذلك{\i0}
Dialogue: 0,0:12:09.68,0:12:11.81,Default 2,,0,0,0,,تفقدوا صورة [أيومي]
Dialogue: 0,0:12:17.77,0:12:19.69,Default 2,,0,0,0,,!لطيفةٌ جدًا
Dialogue: 0,0:12:19.74,0:12:23.66,Default 2,,0,0,0,,!أنت ألطف بكثيرٍ من تلك الفتاة
Dialogue: 0,0:12:23.70,0:12:26.32,Default 2,,0,0,0,,!لا يعرف الأطفال أي شيءٍ عن سحر النضج
Dialogue: 0,0:12:26.37,0:12:28.66,Default 2,,0,0,0,,!على أي حال، فلنجربها أيضًا -\N!أجل -
Dialogue: 0,0:12:31.16,0:12:34.17,Default 2,,0,0,0,,ماذا؟ -\N...ليس جميلًا -
Dialogue: 0,0:12:34.21,0:12:36.17,Default 2,,0,0,0,,أنا أعرف الكثير من هم بالمرحلة الثانوية\N!ويشبهون ذلك
Dialogue: 0,0:12:36.21,0:12:39.71,Default 2,,0,0,0,,!أعتقد أن كلاكما تبدوان لطيفين
Dialogue: 0,0:12:39.76,0:12:40.76,Default 2,,0,0,0,,!حقًا؟
Dialogue: 0,0:12:40.80,0:12:42.30,Default 2,,0,0,0,,!أجل
Dialogue: 0,0:12:42.34,0:12:44.30,Default 2,,0,0,0,,!فلنجرب هذا أيضًا
Dialogue: 0,0:12:48.81,0:12:50.77,Default 2,,0,0,0,,!أنا أعرف الكثير من العجوزات ممن يشبهون تلك
Dialogue: 0,0:12:50.77,0:12:52.02,Default 2,,0,0,0,,اخرس
Dialogue: 0,0:12:52.06,0:12:54.02,Default 2,,0,0,0,,!جميلة
Dialogue: 0,0:12:54.06,0:12:56.15,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:12:56.15,0:12:58.36,Default 2,,0,0,0,,!تبدو تمامًا كـ[إيري] عندما كانت صغيرة
Dialogue: 0,0:12:58.40,0:13:01.74,Default 2,,0,0,0,,!أجمل من أن تكون مع [شينتشي] -\N!ماذا؟ -
Dialogue: 0,0:13:01.78,0:13:05.16,Default 2,,0,0,0,,يغضبني التفكير بأن ذلك الأحمق\N!يخدع تلك الفتاة
Dialogue: 0,0:13:05.16,0:13:07.91,Default 2,,0,0,0,,!لا تقولي هذا يا [سونوكو]
Dialogue: 0,0:13:07.95,0:13:09.95,Default 2,,0,0,0,,...بحقكم
Dialogue: 0,0:13:09.99,0:13:11.83,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:13:11.87,0:13:17.33,Default 2,,0,0,0,,!لم أنت محرج؟ -\N...لا، ليس الأمر كذلك -
Dialogue: 0,0:13:17.33,0:13:19.88,Default 2,,0,0,0,,!...التاليان هما [كونان] و[هايبرا]
Dialogue: 0,0:13:19.92,0:13:20.80,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:13:20.80,0:13:22.71,Default 2,,0,0,0,,!يا [هايبرا]
Dialogue: 0,0:13:22.76,0:13:24.38,Default 2,,0,0,0,,اعفوني من هذا
Dialogue: 0,0:13:24.42,0:13:26.01,Default 2,,0,0,0,,سأنسحب أيضًا
Dialogue: 0,0:13:26.05,0:13:28.72,Thoughts,,0,0,0,,{\i0}فبالنهاية، بعد عشر سنواتٍ سأبدو مثل [شينتشي]{\i0}
Dialogue: 0,0:13:28.76,0:13:31.89,Thoughts,,0,0,0,,{\1}وستبدو [هايبرا] كـ[ميانو شيهو]{\i0}
Dialogue: 0,0:13:31.93,0:13:33.77,Default 2,,0,0,0,,!هيا يا هذا
Dialogue: 0,0:13:33.81,0:13:37.90,Default 2,,0,0,0,,سأرى أي نوعٍ من الحمقى\N!ستبدو بعد عشر سنوات
Dialogue: 0,0:13:37.94,0:13:39.73,Default 2,,0,0,0,,!أنت أيضًا يا [هايبرا]
Dialogue: 0,0:13:39.77,0:13:41.15,Default 2,,0,0,0,,!تمهلوا
Dialogue: 0,0:13:41.15,0:13:42.90,Thoughts,,0,0,0,,{i1}!اللعنة{\i0}
Dialogue: 0,0:13:42.94,0:13:45.24,Default 2,,0,0,0,,!أتساءل كيف ستبدو يا [كونان]
Dialogue: 0,0:13:51.79,0:13:54.25,Default 2,,0,0,0,,...خطأ؟! هذا غريب
Dialogue: 0,0:13:54.29,0:13:55.83,Thoughts,,0,0,0,,{\1}!يا للحظ{\i0}
Dialogue: 0,0:13:55.87,0:13:59.17,Default 2,,0,0,0,,قد يعني ذلك بأننا لربما لا نكون موجودين \N...بعد عشر سنواتٍ من الآن
Dialogue: 0,0:14:02.05,0:14:05.97,Default 2,,0,0,0,,!أجل! بالتأكيد
Dialogue: 0,0:14:06.01,0:14:10.22,Default 2,,0,0,0,,سأُري الجميع الطريق إلى قاعة الحفلات\N!بالطابق الخامس والسبعون
Dialogue: 0,0:14:10.26,0:14:12.89,Default 2,,0,0,0,,...رجاءً اتبعوني إلى المصاعد
Dialogue: 0,0:14:12.89,0:14:14.98,Default 2,,0,0,0,,!متأسفة -\N...لا مشكلة -
Dialogue: 0,0:14:15.02,0:14:16.39,Default 2,,0,0,0,,!اعذروها
Dialogue: 0,0:14:16.43,0:14:21.19,Default 2,,0,0,0,,لقد ولدت في سنة الخنزير\N!لهذا تميل إلى التسرع بتهور
Dialogue: 0,0:14:21.19,0:14:23.53,Default 2,,0,0,0,,لقد فهمت! تفعلين هذا كثيرًا؟
Dialogue: 0,0:14:34.08,0:14:37.79,Default 2,,0,0,0,,هل يذهب هذا المصعد إلى الطابق\Nالخامس والسبعين مباشرةً؟
Dialogue: 0,0:14:37.83,0:14:43.46,Default 2,,0,0,0,,أجل، هذا المصعد هو للشخصيات الهامة\Nلذا فهو يذهب مباشرةً إلى الطابق المقصود
Dialogue: 0,0:14:43.50,0:14:47.47,Default 2,,0,0,0,,المكان الوحيد الذي يمكن إيقافه منه قابع بالخارج
Dialogue: 0,0:14:47.51,0:14:50.34,Default 2,,0,0,0,,وهي  قاعة الحفلات الموسيقية بالطابق السادس والستون
Dialogue: 0,0:14:50.39,0:14:52.60,Default 2,,0,0,0,,!نحن على ارتفاعٍ شاهق
Dialogue: 0,0:14:52.60,0:14:54.85,Default 2,,0,0,0,,!يا له من منظرٍ رائع
Dialogue: 0,0:14:54.89,0:14:57.18,Default 2,,0,0,0,,!يبدو كما لو أننا نقترب من الجنة
Dialogue: 0,0:15:09.49,0:15:15.45,Default 2,,0,0,0,,نحن نحضر من أجل حفلة\Nالافتتاح الكبير، لذا فهناك زحامٌ بعض الشيء
Dialogue: 0,0:15:18.87,0:15:20.12,Default 2,,0,0,0,,!سيد [موري]
Dialogue: 0,0:15:20.12,0:15:21.83,Default 2,,0,0,0,,!آنسة [توكيوا]\N!لقد مضى الكثير من الوقت
Dialogue: 0,0:15:21.88,0:15:24.84,Default 2,,0,0,0,,!شكرًا على قدومك كل هذا الطريق إلى هنا
Dialogue: 0,0:15:24.88,0:15:27.34,Default 2,,0,0,0,,...أجل لقد كنت أنوي المجيء وحدي ولكن
Dialogue: 0,0:15:27.38,0:15:31.18,Default 2,,0,0,0,,!أنا ابنته [ران]\N!أمي ترسل تحياتها أيضًا
Dialogue: 0,0:15:31.22,0:15:32.64,Default 2,,0,0,0,,!مهلك يا [ران]
Dialogue: 0,0:15:32.64,0:15:34.01,Default 2,,0,0,0,,!دعيني أعرفك
Dialogue: 0,0:15:34.05,0:15:36.14,Default 2,,0,0,0,,!زميلتي بالدراسة [سوزوكي سونوكو] -\N!مرحبًا -
Dialogue: 0,0:15:36.18,0:15:38.14,Default 2,,0,0,0,,!البروفيسور [أغاسا]، مخترع\N!مرحبًا -
Dialogue: 0,0:15:38.14,0:15:42.94,Default 2,,0,0,0,,و[إيدوغاوا كونان]\N....[هايبرا آي]، و[يوشيدا أيومي]
Dialogue: 0,0:15:42.94,0:15:44.48,Default 2,,0,0,0,,...[تسوبورايا ميتسوهيكو] -\N!مرحبًا -
Dialogue: 0,0:15:44.48,0:15:47.07,Default 2,,0,0,0,,...و[كوجيما غينتا] -\Nأهلًا -
Dialogue: 0,0:15:47.11,0:15:50.36,Default 2,,0,0,0,,!تشرفت بلقائكم كلكم\Nأنا [توكيوا ميو]
Dialogue: 0,0:15:50.40,0:15:52.49,Default 2,,0,0,0,,!و الآن دعوني أعرفكم
Dialogue: 0,0:15:52.53,0:15:58.20,Default 2 - up,,0,0,0,,مدربي للفن ورسام ذي أسلوبٍ ياباني\Nالمعلم [كيساراجي هوسوي]
Dialogue: 0,0:15:58.24,0:16:02.96,Default 2,,0,0,0,,[كيساراجي هوسوي]؟ ذلك المشهور بلوحات\Nجبل فوجي الخاصة به؟
Dialogue: 0,0:16:02.96,0:16:05.54,Default 2,,0,0,0,,!أنا أعرف عنك أيضًا
Dialogue: 0,0:16:05.59,0:16:08.30,Default 2,,0,0,0,,!أنت المتحري [كوغورو] النعس، أليس كذلك؟
Dialogue: 0,0:16:08.34,0:16:11.09,Default 2,,0,0,0,,!"إنه "كوغورو النائم
Dialogue: 0,0:16:11.13,0:16:13.39,Thoughts,,0,0,0,,{\1}!تفوح من ذلك الرجل رائحة الخمر{\i0}
Dialogue: 0,0:16:13.43,0:16:17.39,Default 2 - up,,0,0,0,,هذا السيد [أوكي إيواماتسو]\N"عضوٌ بمجلس مدينة غرب "تاما
Dialogue: 0,0:16:17.43,0:16:22.52,Default 2 - up,,0,0,0,,وقد ساعد في بناء ذلك المبنى\Nبعدة طرق
Dialogue: 0,0:16:22.56,0:16:28.23,Default 2 - up,,0,0,0,,وهذا هو السيد [كازاما هيديهيكو]\N!المصمم المعماري لهذه المباني
Dialogue: 0,0:16:28.27,0:16:32.90,Default 2 - up,,0,0,0,,لدي صلة صغيرةٌ بك يا سيد [موري]
Dialogue: 0,0:16:32.95,0:16:37.03,Default 2,,0,0,0,,أنا في الواقع تلميذ [موريا تيجي]
Dialogue: 0,0:16:37.08,0:16:38.58,Thoughts,,0,0,0,,{\1}![موريا تيجي]؟{\i0}
Dialogue: 0,0:16:38.62,0:16:40.58,Default 2,,0,0,0,,ولكن لا داعي للقلق
Dialogue: 0,0:16:40.62,0:16:44.37,Default 2,,0,0,0,,لن أفجر تلك المباني كما فعل [موريا]
Dialogue: 0,0:16:44.37,0:16:47.00,Default 2,,0,0,0,,تفجر؟
Dialogue: 0,0:16:47.04,0:16:50.96,Default 2,,0,0,0,,لأنهما مختلفان في الارتفاعات\Nوغير متماثلين، أليس كذلك؟
Dialogue: 0,0:16:51.01,0:16:53.30,Default 2,,0,0,0,,ماذا؟\Nإنك تعرف الكثير يا فتى
Dialogue: 0,0:16:56.39,0:17:00.10,Default 2,,0,0,0,,!أسرعوا! أسرعوا! تستطيعون رؤيته جيدًا من هنا
Dialogue: 0,0:17:00.14,0:17:02.10,Default 2,,0,0,0,,!إنه جميلٌ جدًا -\N!إنه ضخم -
Dialogue: 0,0:17:07.65,0:17:11.57,Default 2,,0,0,0,,!رائع! هذا منظرٌ خلاب
Dialogue: 0,0:17:11.61,0:17:15.07,Default 2,,0,0,0,,يمكنك رؤية جبل "فوجي" ليلًا من هنا أيضًا
Dialogue: 0,0:17:15.11,0:17:16.36,Default 2,,0,0,0,,حتى بالليل؟
Dialogue: 0,0:17:16.41,0:17:19.12,Thoughts,,0,0,0,,{\1}ماذا يعني هذا؟{\i0}
Dialogue: 0,0:17:19.16,0:17:21.62,Default 2,,0,0,0,,!ما الذي نستطيع رؤيته من الناحية الأخرى؟
Dialogue: 0,0:17:25.54,0:17:29.17,Default 2,,0,0,0,,ما هذا؟ -\N...إنه يبدو كسطحٍ ذو قبة -
Dialogue: 0,0:17:29.21,0:17:31.50,Default 2,,0,0,0,,المبنى "ب" هو للتجارة
Dialogue: 0,0:17:31.55,0:17:36.09,Default 2,,0,0,0,,الجزء السفلي للمحلات التجارية\Nوالجزء الأعلى فندق
Dialogue: 0,0:17:36.09,0:17:38.97,Default 2,,0,0,0,,هناك حمام سباحة داخلي بالطبقة العليا
Dialogue: 0,0:17:39.01,0:17:41.72,Default 2,,0,0,0,,!والقبة يمكن فتحها و غلقها
Dialogue: 0,0:17:41.77,0:17:43.98,Default 2,,0,0,0,,!رائع! هذا حقًا يدعو للإعجاب
Dialogue: 0,0:17:44.02,0:17:49.02,Default 2,,0,0,0,,هل باستطاعتي البقاء في الفندق\Nفي عطلة نهاية الأسبوع يا آنسة [ميو]؟
Dialogue: 0,0:17:49.06,0:17:51.15,Default 2,,0,0,0,,...ولكننا لم نفتح أبوابنا بعد
Dialogue: 0,0:17:51.19,0:17:53.44,Default 2,,0,0,0,,لم يرق لي هذا الرد
Dialogue: 0,0:17:53.44,0:17:59.12,Default 2,,0,0,0,,حسنًا، سأحضر لك جناحًا بالطابق السادس والسبعون
Dialogue: 0,0:17:59.12,0:18:03.75,Default 2,,0,0,0,,...أريد تناول العشاء معك أيضًا إذا أمكن
Dialogue: 0,0:18:03.75,0:18:07.42,Default 2,,0,0,0,,هذا دبوسٌ غريب
Dialogue: 0,0:18:07.46,0:18:09.63,Default 2,,0,0,0,,أهو هديةٌ من شخص لطيف؟
Dialogue: 0,0:18:09.63,0:18:13.13,Default 2,,0,0,0,,لا، لقد أحضرته لنفسي
Dialogue: 0,0:18:13.17,0:18:16.05,Default 2,,0,0,0,,!آنسة [ميو]\N!سأغادر الآن
Dialogue: 0,0:18:16.09,0:18:17.63,Default 2,,0,0,0,,!سأصطحبك
Dialogue: 0,0:18:17.68,0:18:19.64,Default 2,,0,0,0,,!ليس عليك اصطحابي إلى الخارج
Dialogue: 0,0:18:22.10,0:18:25.14,Default 2,,0,0,0,,...يبدو غاضبًا من أمرٍ ما
Dialogue: 0,0:18:25.14,0:18:29.15,Default 2,,0,0,0,,آنسة [ميو] اشترت كل لوحاته\Nوباعتها بثمنٍ باهظ
Dialogue: 0,0:18:29.19,0:18:31.15,Default 2,,0,0,0,,...لم يكن مسرورًا بذلك
Dialogue: 0,0:18:37.24,0:18:38.86,Default 2,,0,0,0,,!شوكولاه
Dialogue: 0,0:18:40.82,0:18:45.20,Default 2,,0,0,0,,!لقد أمسكت بي! سأشارككم بعضًا منها
Dialogue: 0,0:18:45.25,0:18:47.21,Default 2,,0,0,0,,!رائع
Dialogue: 0,0:18:47.25,0:18:49.21,Default 2,,0,0,0,,!تفضلوا -\N!شكرًا لك -
Dialogue: 0,0:18:49.25,0:18:52.04,Default 2,,0,0,0,,!شكرًا -\N!شكرًا لك -
Dialogue: 0,0:18:52.09,0:18:55.80,Default 2,,0,0,0,,إنه مبرمجٌ عبقري\N...ولكنه أيضًا طفولي جدًا
Dialogue: 0,0:18:55.80,0:18:59.18,Default 2,,0,0,0,,!ولكن هكذا يمكنه صناعة ألعابٍ مسلية
Dialogue: 0,0:18:59.22,0:19:00.22,Default 2,,0,0,0,,!صحيح
Dialogue: 0,0:19:00.26,0:19:06.14,Default 2,,0,0,0,,أنا أعمل على لعبة فيديو جديدة\Nهل يمكنني سؤالكم عن رأيكم؟
Dialogue: 0,0:19:06.18,0:19:08.35,Default 2,,0,0,0,,!عن لعبة؟ -\N!بالطبع -
Dialogue: 0,0:19:08.35,0:19:11.10,Default 2,,0,0,0,,"أنا أعيش في "سوهو
Dialogue: 0,0:19:11.15,0:19:12.81,Default 2,,0,0,0,,!"نحن نعيش في "بيكا
Dialogue: 0,0:19:12.86,0:19:15.69,Default 2,,0,0,0,,!هذا ليس ببعيد إذًا\N!فقط مقدار رحلة قصيرةٍ بالأتوبيس
Dialogue: 0,0:19:15.69,0:19:18.24,Default 2,,0,0,0,,!هل تريدون أن تمروا عليّ الأحد القادم
Dialogue: 0,0:19:18.28,0:19:21.74,Default 2,,0,0,0,,!أجل! سنكون هناك
Dialogue: 0,0:19:21.78,0:19:23.53,Default 2,,0,0,0,,ما خطبك يا [آي]؟
Dialogue: 0,0:19:23.53,0:19:24.83,Default 2,,0,0,0,,لا شيء
Dialogue: 0,0:19:31.42,0:19:33.21,Default 2,,0,0,0,,آنسة [ران]
Dialogue: 0,0:19:33.21,0:19:37.21,Default 2,,0,0,0,,ثمة شيء أريد أن أحدثك\Nبشأنه على انفراد
Dialogue: 0,0:19:37.26,0:19:39.55,Default 2,,0,0,0,,هل يمكنك مقابلتي بالغد؟
Dialogue: 0,0:19:39.55,0:19:41.55,Default 2,,0,0,0,,بالطبع، لا مشكلة
Dialogue: 0,0:19:41.55,0:19:44.18,Default 2,,0,0,0,,سأعلمك بالوقت والمكان لاحقًا
Dialogue: 0,0:19:47.47,0:19:49.23,Default 2,,0,0,0,,آنسة [ران]
Dialogue: 0,0:19:49.27,0:19:51.52,Default 2,,0,0,0,,ثمة شيء أريد أن أحدثك\Nبشأنه على انفراد
Dialogue: 0,0:19:51.52,0:19:52.85,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:19:56.52,0:19:58.99,Default 2,,0,0,0,,...إنه الشعر، هو المشكلة
Dialogue: 0,0:20:02.28,0:20:04.74,Default 2,,0,0,0,,!ربما سأجرب تمويجه ايضًا
Dialogue: 0,0:20:07.29,0:20:10.79,Default 2,,0,0,0,,لم أظن انني أستطيع رؤية سيارةٍ مثلها\N!في هذه الأيام
Dialogue: 0,0:20:10.83,0:20:14.25,Default 2,,0,0,0,,ماذا كانت مجددًا؟ -\N!Aإنها بورش 365 -
Dialogue: 0,0:20:14.29,0:20:15.34,Thoughts,,0,0,0,,{\1}!ماذا؟{\i0}
Dialogue: 0,0:20:15.38,0:20:19.17,Default 2,,0,0,0,,!مهلكما! هذا المصعد للشخصيات الهامة فقط
Dialogue: 0,0:20:19.21,0:20:21.63,Default 2,,0,0,0,,!يستخدم الموظفون المصاعد العامة
Dialogue: 0,0:20:21.67,0:20:24.22,Default 2,,0,0,0,,!حسنًا يا سيدتي -\N!اعتذاراتنا -
Dialogue: 0,0:20:24.22,0:20:27.51,Default 2,,0,0,0,,أخبراني! أين رأيتما تلك السيارة؟\N!ما كان لونها؟
Dialogue: 0,0:20:27.56,0:20:31.85,Default 2,,0,0,0,,لقد كانت متوقفةً أمام المبنى\Nكانت سوداء
Dialogue: 0,0:20:31.89,0:20:33.85,Thoughts,,0,0,0,,{\1}!إنها سيارة [جين]{\i0}
Dialogue: 0,0:20:36.77,0:20:38.27,Default 2,,0,0,0,,!تمهل يا [كونان]
Dialogue: 0,0:20:38.32,0:20:40.28,Default 2,,0,0,0,,!يا هذا! إلى أين انت ذاهب؟
Dialogue: 0,0:20:50.29,0:20:51.91,Thoughts,,0,0,0,,{\i0}!أسرع! أسرع{\i0}
Dialogue: 0,0:20:54.33,0:20:55.96,Thoughts,,0,0,0,,{\1}!..ها هي{\i0}
Dialogue: 0,0:21:07.80,0:21:09.56,Thoughts,,0,0,0,,{\1}!اللعنة{\i0}
Dialogue: 0,0:21:09.60,0:21:12.89,Thoughts,,0,0,0,,{\1}!ولكن...لماذا أتوا إلى هذا المبنى؟{\i0}
Dialogue: 0,0:21:28.57,0:21:33.96,Default 2,,0,0,0,,الحقيقة أنني طالما كنت معجبًا بـ[أيومي] منذ الحضانة
Dialogue: 0,0:21:33.96,0:21:38.33,Default 2,,0,0,0,,...ولكنها تبدو معجبةً بـ[كونان]
Dialogue: 0,0:21:38.33,0:21:40.30,Default 2,,0,0,0,,!رجاءً أخبريني يا آنسة [ران]
Dialogue: 0,0:21:40.34,0:21:41.50,Default 2,,0,0,0,,كيف يمكننا الانتقال
Dialogue: 0,0:21:41.50,0:21:45.47,Default 2,,0,0,0,,من كوننا صديقين منذ الطفولة\Nإلى حبيبين مثلك أنت والسيد [شينتشي]؟
Dialogue: 0,0:21:45.47,0:21:49.47,Default 2,,0,0,0,,!مهلك! أنا و[شينتشي] لسنا كذلك
Dialogue: 0,0:21:49.51,0:21:55.31,Default 2,,0,0,0,,...وبدأت ألاحظ [هايبرا] مؤخرًا، أيضًا
Dialogue: 0,0:21:55.31,0:22:00.32,Default 2,,0,0,0,,هل أنا رجلٌ فظيعٌ لدرجة إعجابي\N!بفتاتين بنفس الوقت؟
Dialogue: 0,0:22:06.32,0:22:10.99,Default 2,,0,0,0,,!ليس فظيعًا بالمرة\Nالإعجاب بشخصٍ أمر جيد
Dialogue: 0,0:22:11.03,0:22:14.33,Default 2,,0,0,0,,!وأعتقد أن عليك اكتناز مثل تلك الأحاسيس
Dialogue: 0,0:22:14.33,0:22:15.46,Default 2,,0,0,0,,إذًا...؟
Dialogue: 0,0:22:15.50,0:22:18.67,Default 2,,0,0,0,,ولكن ربما عليكم فقط البقاء كأصدقاء مقربين الآن؟
Dialogue: 0,0:22:18.67,0:22:20.71,Default 2,,0,0,0,,مع [أيومي] و [آي]
Dialogue: 0,0:22:20.71,0:22:24.67,Default 2,,0,0,0,,{\i0}!و[كونان] و[غينتا] بالطبع{\i0}
Dialogue: 0,0:22:24.71,0:22:26.55,Default 2,,0,0,0,,!فهمت
Dialogue: 0,0:22:26.55,0:22:29.59,Default 2,,0,0,0,,!خصم نصف السعر عند شراء خمس كعكات
Dialogue: 0,0:22:29.64,0:22:31.01,Default 2,,0,0,0,,!مرحبًا
Dialogue: 0,0:22:31.05,0:22:35.27,Default 2,,0,0,0,,أنا حقًا معجبةٌ بـ[كونان]
Dialogue: 0,0:22:35.31,0:22:38.27,Default 2,,0,0,0,,ولكنه معجبٌ بشخصٍ آخر
Dialogue: 0,0:22:38.31,0:22:40.56,Default 2,,0,0,0,,هل تعنين [آي]؟
Dialogue: 0,0:22:40.56,0:22:43.48,Default 2,,0,0,0,,!لا، أنت يا آنسة [ران]
Dialogue: 0,0:22:43.52,0:22:45.32,Default 2,,0,0,0,,!لا تكوني سخيفة
Dialogue: 0,0:22:45.36,0:22:49.03,Default 2,,0,0,0,,![كونان]معجبٌ بك! أنا أعلم ذلك
Dialogue: 0,0:22:49.03,0:22:55.41,Default 2,,0,0,0,,لذا أريدك أن تقولي له\Nأنك بالفعل لديك [شينتشي]
Dialogue: 0,0:22:55.45,0:22:57.91,Default 2,,0,0,0,,!حتى يستسلم
Dialogue: 0,0:22:57.91,0:23:00.33,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:23:00.38,0:23:03.42,Default 2,,0,0,0,,...وإلا فسوف أشعر بالأسى تجاهه
Dialogue: 0,0:23:03.42,0:23:07.47,Default 2,,0,0,0,,ولكننا لا نعلم حتمًا أن [كونان]\N...معجبٌ بي
Dialogue: 0,0:23:07.51,0:23:09.34,Default 2,,0,0,0,,!أنا أعرف
Dialogue: 0,0:23:09.38,0:23:10.47,Default 2,,0,0,0,,كيف؟
Dialogue: 0,0:23:10.51,0:23:13.39,Default 2,,0,0,0,,!حاستي الأنثوية السادسة
Dialogue: 0,0:23:13.39,0:23:14.72,Default 2,,0,0,0,,...هكذا إذًا
Dialogue: 0,0:23:18.85,0:23:20.77,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:23:20.77,0:23:24.86,Default 2,,0,0,0,,!أقول لك، أن [كونان] قد يكون معجبًا بي
Dialogue: 0,0:23:24.90,0:23:28.65,Default 2,,0,0,0,,!ماذا؟! إنه لا يفعل\N!لا تكوني حمقاء
Dialogue: 0,0:23:28.69,0:23:31.95,Default 2,,0,0,0,,حقًا؟ وكيف تعرف ذلك؟
Dialogue: 0,0:23:31.99,0:23:38.45,Default 2,,0,0,0,,!لا، إن حب الطفولة كالحمى\N!لا داعي للقلق
Dialogue: 0,0:23:38.45,0:23:44.00,Another,,0,0,0,,!بحقك الآن! فكر بجدية
Dialogue: 0,0:23:44.04,0:23:48.51,Default 2,,0,0,0,,لا يجب عليك أن تقلقي من أمر كهذا، وكوني صادقةً مع نفسك
Dialogue: 0,0:23:48.55,0:23:50.88,Default 2,,0,0,0,,صادقةٌ مع نفسي؟
Dialogue: 0,0:23:50.93,0:23:55.47,Default 2,,0,0,0,,إذا فعلتِ هذا، فستُظهر الحقيقة نفسها
Dialogue: 0,0:23:55.51,0:23:57.47,Default 2,,0,0,0,,الوداع\N!سأتصل لاحقًا
Dialogue: 0,0:24:05.11,0:24:09.44,Default 2,,0,0,0,,...أنا من عليه أن يكون صادقًا
Dialogue: 0,0:24:21.75,0:24:23.71,Default 2,,0,0,0,,!ماذا تفعل؟
Dialogue: 0,0:24:32.43,0:24:35.51,Default 2,,0,0,0,,لقد طلبت حضوركم لسببٍ وحيد
Dialogue: 0,0:24:35.55,0:24:38.51,Default 2,,0,0,0,,الحقيقة أنه تم إيجاد رجل مطعونًا حتى الموت
Dialogue: 0,0:24:38.56,0:24:40.48,Default 2,,0,0,0,,بجناحٍ بالمبنى ذو البرجين التوأمين
Dialogue: 0,0:24:40.52,0:24:42.10,Default 2,,0,0,0,,!ماذا؟ -\N!...هذا -
Dialogue: 0,0:24:42.19,0:24:45.35,Default 2,,0,0,0,,"إنه عضو مجلس مدينة غرب "تاما\N![أوكي إيواماتسو]
Dialogue: 0,0:24:45.44,0:24:51.40,Default 2,,0,0,0,,سمعت بأنكم كنتم هناك عندما\Nطلب غرفةً من الآنسة [توكيوا ميو]
Dialogue: 0,0:24:51.49,0:24:53.40,Default 2,,0,0,0,,[شيبا] -\Nأجل، سيدي -
Dialogue: 0,0:24:53.45,0:24:58.53,Default 2,,0,0,0,,الوقت المتوقع لوفاة السيد [أوكي]\Nهو بين العاشرة مساءً ومنتصف الليل
Dialogue: 0,0:24:58.62,0:25:02.50,Default 2,,0,0,0,,نعتقد أن السلاح هو سكينٌ\Nولكنه لم يكن موجودًا بساحة الجريمة
Dialogue: 0,0:25:02.54,0:25:07.13,Default 2,,0,0,0,,ولكن كان هناك كوب "أو-شوكو" بجانب\Nيد السيد [أوكي] وكان مكسورًا لنصفين
Dialogue: 0,0:25:07.17,0:25:08.46,Default 2,,0,0,0,,أو-شوكو"؟"
Dialogue: 0,0:25:08.54,0:25:09.50,Default 2,,0,0,0,,هذا
Dialogue: 0,0:25:09.55,0:25:12.38,Default 2,,0,0,0,,هذا الـ"أو-شوكو" غالٍ جدًا
Dialogue: 0,0:25:12.47,0:25:17.43,Default 2,,0,0,0,,هناك احتمالٌ كبيرٌ بأن السيد [أوكي] المولع بالساكي\Nقد جلبه معه
Dialogue: 0,0:25:17.51,0:25:21.93,Default 2,,0,0,0,,وأن هذه رسالة احتضار تشير إلى هوية القاتل
Dialogue: 0,0:25:21.97,0:25:28.61,Default 2,,0,0,0,,بمعنىً آخر، تظن الشرطة أن المشتبه به\Nهو واحدٌ من هؤلاء الخمسة؟
Dialogue: 0,0:25:28.65,0:25:35.07,Default 2,,0,0,0,,المبنى ليس مفتوحًا للعامة بعد كما ترى
Dialogue: 0,0:25:35.07,0:25:40.74,Default 2,,0,0,0,,!لقد فهمت! الـ"أو-شوكو" تشير إلى الشوكولاه
Dialogue: 0,0:25:40.74,0:25:44.54,Default 2,,0,0,0,,القاتل كان\N!محب الشوكولاه [هارا يوشياكي]
Dialogue: 0,0:25:44.54,0:25:45.92,Default 2,,0,0,0,,!ماذا؟ -\N!محال -
Dialogue: 0,0:25:45.92,0:25:47.79,Default 2,,0,0,0,,!لم يكن السيد [هارا]
Dialogue: 0,0:25:47.83,0:25:52.00,Default 2,,0,0,0,,!إنه شخصٌ لطيف\N!لقد شارك الشوكولاه الخاصة به معنا
Dialogue: 0,0:25:52.05,0:25:52.76,Default 2,,0,0,0,,!أجل
Dialogue: 0,0:25:52.80,0:25:54.80,Default 2,,0,0,0,,!مهلكم\N!اهدأوا
Dialogue: 0,0:25:54.84,0:25:57.97,Default 2,,0,0,0,,السيد [هارا] على الأرجح مستبعد
Dialogue: 0,0:25:58.01,0:26:02.56,Default 2,,0,0,0,,من بين الخمسة الذين استجوبناهم\Nهو الوحيد الذي كان معه حجة غياب
Dialogue: 0,0:26:02.56,0:26:04.60,Default 2,,0,0,0,,حجة غياب؟
Dialogue: 0,0:26:04.64,0:26:08.94,Default 2,,0,0,0,,!هذا ليس لطيفًا أيها المفتش\N!كان عليك أن تخبرنا منذ البداية
Dialogue: 0,0:26:08.98,0:26:11.82,Default 2,,0,0,0,,هل يمكن أن تشير "أو-شوكو" إلى كلمة\Nأوشوكوشوف"؟"
Dialogue: 0,0:26:11.86,0:26:15.61,Default 2,,0,0,0,,إذا كان الأمر كذلك، فالسيد [موري]\Nهو أكثر المشتبه بهم
Dialogue: 0,0:26:15.61,0:26:17.49,Default 2,,0,0,0,,!مهلك يا [شيراتوري]
Dialogue: 0,0:26:17.53,0:26:19.12,Default 2,,0,0,0,,إنها مزحة
Dialogue: 0,0:26:19.16,0:26:20.78,Default 2,,0,0,0,,...الآن
Dialogue: 0,0:26:20.83,0:26:23.04,Default 2,,0,0,0,,ماذا عن الدافع؟
Dialogue: 0,0:26:23.08,0:26:25.16,Default 2,,0,0,0,,نحن نحقق بهذا الأمر بينما نتحدث
Dialogue: 0,0:26:25.20,0:26:31.59,Default 2,,0,0,0,,على الرغم من كونه عضو مجلس مدينة\Nقد حمل السيد [أوكي] مسؤولية أكبر من العمدة
Dialogue: 0,0:26:31.63,0:26:37.17,Default 2,,0,0,0,,ويقال أنه قد أمر بإعادة\Nالنظر في مرسوم المدينة
Dialogue: 0,0:26:37.22,0:26:39.84,Default 2,,0,0,0,,الذي يمنع بناء ناطحات السحاب في المنطقة
Dialogue: 0,0:26:39.89,0:26:41.85,Default 2,,0,0,0,,لهذا لم تستطع الآنسة [ميو] أن ترفض
Dialogue: 0,0:26:41.89,0:26:46.68,Default 2,,0,0,0,,عندما طلب منها السيد [أوكي] غرفةً\Nقبل الافتتاح الكبير
Dialogue: 0,0:26:46.73,0:26:50.86,Default 2,,0,0,0,,بالتفكير بالأمر، الدبوس الذي وضعته
Dialogue: 0,0:26:50.90,0:26:53.27,Default 2,,0,0,0,,بدى مثل ذلك الـ"أو-شوكو" المكسور
Dialogue: 0,0:26:53.32,0:26:55.99,Default 2,,0,0,0,,!مهلًا\N!...الآنسة [ميو] لم يكن باستطاعتها
Dialogue: 0,0:26:55.99,0:27:01.62,Default 2,,0,0,0,,لا، إن الأمر أسهل عليها\Nلترتكب الجريمة
Dialogue: 0,0:27:01.66,0:27:06.54,Default 2,,0,0,0,,ففي النهاية هي تعيش\N"بالطابق الثامن والستين بالمبنى "ب
Dialogue: 0,0:27:06.58,0:27:09.83,Default 2,,0,0,0,,أي فوق الغرفة التى نزل بها بطابق واحد
Dialogue: 0,0:27:09.83,0:27:12.13,Default 2,,0,0,0,,...ولكن
Dialogue: 0,0:27:12.17,0:27:14.55,Default 2,,0,0,0,,ألا يبدو ذلك الـ"أو-شوكو" مثل الطبق الصغير المستخدم
Dialogue: 0,0:27:14.59,0:27:17.97,Default 2,,0,0,0,,عند رسم لوحاتٍ بالأسلوب الياباني؟
Dialogue: 0,0:27:18.01,0:27:21.09,Default 2,,0,0,0,,يصنع والدي لوحاتٍ بالأسلوب الياباني كهواية
Dialogue: 0,0:27:21.14,0:27:25.97,Default 2,,0,0,0,,إنه يذكرني بقاعدة الهاون التي تستخدم\N!في طحن المسحوق
Dialogue: 0,0:27:26.02,0:27:29.19,Default 2,,0,0,0,,...إذًا فالـ"أو-شوكو" مرتبطٌ بالسيد [كيساراجي]
Dialogue: 0,0:27:29.19,0:27:35.73,Default 2,,0,0,0,,ولكن يبدو أن لا علاقة لها بالآنسة [ساواغوتشي]\Nأو السيد [كازاما]
Dialogue: 0,0:27:35.78,0:27:40.91,Default 2,,0,0,0,,سيد [شيراتوري]، أصحيحٌ أن السيد [كازاما]\Nهو تلميذ السيد [تيجي]؟
Dialogue: 0,0:27:40.95,0:27:42.24,Default 2,,0,0,0,,هذا صحيح
Dialogue: 0,0:27:42.28,0:27:46.99,Default 2,,0,0,0,,ولكنه من النوع التقني وليس الفني كـ[موريا]
Dialogue: 0,0:27:46.99,0:27:49.21,Default 2,,0,0,0,,لهذا لا يملك أسلوبًا مفضلًا
Dialogue: 0,0:27:49.25,0:27:53.67,Default 2,,0,0,0,,أما بالنسبة للآنسة [ساواغوتشي شينامي]\Nكان والدها صحفيٌ بجريدة
Dialogue: 0,0:27:53.67,0:27:57.25,Default 2,,0,0,0,,ومات بسبب ضغط العمل\Nعندما كانت بالسنة الرابعة من الجامعة
Dialogue: 0,0:27:57.30,0:28:00.76,Default 2,,0,0,0,,ولكننا مازلنا نبحث عن صلة بينه وبين السيد [أوكي]
Dialogue: 0,0:28:00.80,0:28:02.09,Default 2,,0,0,0,,أيها المفتش
Dialogue: 0,0:28:02.13,0:28:06.26,Default 2,,0,0,0,,...في رأيي هذه الحادثة كانت لتعطيل
Dialogue: 0,0:28:06.31,0:28:09.64,Thoughts,,0,0,0,,{\1}الجزء السفلي فقط من الخزانة\N...هو الملطخ ببقع الدماء{\i0}
Dialogue: 0,0:28:09.68,0:28:12.31,Thoughts,,0,0,0,,{\i0}...وله شكلٌ غريب{\i0}
Dialogue: 0,0:28:13.65,0:28:16.07,Default 2,,0,0,0,,هذا لا يناسب عيني طفل
Dialogue: 0,0:28:16.11,0:28:18.61,Default 2,,0,0,0,,...آسف
Dialogue: 0,0:28:18.65,0:28:23.36,Thoughts,,0,0,0,,{\1}ولكن ماذا كان يفعل [جين] و[فودكا]\Nبالبرجين التوأمين؟{\i0}
Dialogue: 0,0:28:23.36,0:28:24.74,Thoughts,,0,0,0,,{\i0}!مهلًا{\i0}
Dialogue: 0,0:28:24.78,0:28:28.41,Thoughts,,0,0,0,,{\1}!أكواب الـ"أو-شوكو" مصنوعةٌ للكحول{\i0}
Dialogue: 0,0:28:28.41,0:28:33.00,Default 2,,0,0,0,,يا [هايبرا]\N!أيعقل أن يكونوا هم
Dialogue: 0,0:28:33.04,0:28:35.96,Default 2,,0,0,0,,صحيحٌ أنهم يحملون أسماء رمزية\Nمتعلقةٌ بالكحول
Dialogue: 0,0:28:36.00,0:28:41.30,Default 2,,0,0,0,,ولكن بالتأكيد لن يكونوا أغبياء لدرجة\Nتركهم لمثل تلك الرسالة الواضحة
Dialogue: 0,0:28:44.09,0:28:46.05,Default 2,,0,0,0,,كما هو محتمل\Nفهمتم؟
Dialogue: 0,0:28:55.77,0:28:57.77,Default 2,,0,0,0,,!هنا يا [ميتسوهيكو]
Dialogue: 0,0:28:57.82,0:28:59.82,Default 2,,0,0,0,,!لقد جئتما باكرًا
Dialogue: 0,0:28:59.86,0:29:01.24,Default 2,,0,0,0,,!هذا مثيرٌ جدًا
Dialogue: 0,0:29:01.28,0:29:04.70,Default 2,,0,0,0,,!أنا سعيدٌ بأننا سنسبق [كونان] إلى الحل
Dialogue: 0,0:29:04.74,0:29:06.70,Default 2,,0,0,0,,ستسبقون من إلى الحل؟
Dialogue: 0,0:29:13.16,0:29:15.00,Default 2,,0,0,0,,!كيف عرفت؟
Dialogue: 0,0:29:15.04,0:29:18.92,Default 2,,0,0,0,,!من السهل توقع تصرفاتكم دائمًا يا رفاق
Dialogue: 0,0:29:18.92,0:29:23.34,Default 2,,0,0,0,,لقد ظننتم أنني سأمنعكم من التحقيق بالقضية بأنفسكم
Dialogue: 0,0:29:23.38,0:29:25.22,Default 2,,0,0,0,,لأنها خطرةٌ جدًا، أليس كذلك؟
Dialogue: 0,0:29:25.26,0:29:27.22,Default 2,,0,0,0,,!صحيح
Dialogue: 0,0:29:33.93,0:29:37.86,Default 2,,0,0,0,,لقد فات الأوان الآن، ولكن لا تفعلوا\N!شيئًا من تلقاء أنفسكم بعد الآن
Dialogue: 0,0:29:37.90,0:29:39.73,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,0:29:39.77,0:29:42.82,Thoughts,,0,0,0,,{\i0}هل يفهم هؤلاء أي شيء حقًا؟{\i0}
Dialogue: 0,0:29:42.86,0:29:45.70,Default 2,,0,0,0,,إذًا؟ فمن سنقابل اليوم؟
Dialogue: 0,0:29:45.74,0:29:49.37,Default 2,,0,0,0,,!السيد [كازاما] والسيد [كيساراجي]\N!وغدًا نقابل السيد [هارا]
Dialogue: 0,0:29:49.41,0:29:52.20,Default 2,,0,0,0,,"السيد [كازاما] يعيش في "ساتاجايا
Dialogue: 0,0:29:52.24,0:29:56.79,Default 2,,0,0,0,,"ولكن لديه ورشة عملٍ في "أساهينو\N!قبل مدينة غرب "تاما" قليلًا
Dialogue: 0,0:29:56.83,0:29:59.71,Default 2,,0,0,0,,إنه يعيش هناك حتى الافتتاح الكبير للمبنى
Dialogue: 0,0:29:59.75,0:30:01.34,Default 2,,0,0,0,,السيد [كيساراجي] أعزب
Dialogue: 0,0:30:01.38,0:30:05.88,Default 2,,0,0,0,,"وقد بنى منزلًا في "أساهينو\N!مع استوديو منذ ثلاث سنوات
Dialogue: 0,0:30:05.93,0:30:09.35,Thoughts,,0,0,0,,{\1}!رائع، لقد قاموا بتحريات جيدة {\i0}
Dialogue: 0,0:30:09.39,0:30:13.02,Default 2,,0,0,0,,إنه لأمرٌ سيئ أن [هايبرا] لم تأتِ أيضًا\N!بما أننا كلنا ذاهبون
Dialogue: 0,0:30:13.06,0:30:15.35,Default 2,,0,0,0,,ماذا؟ دعوتموها هي أيضًا؟
Dialogue: 0,0:30:15.35,0:30:16.27,Default 2,,0,0,0,,!أجل
Dialogue: 0,0:30:16.31,0:30:20.27,Default 2,,0,0,0,,!ولكنها قالت أنها مشغولةٌ بتنظيف المنزل اليوم
Dialogue: 0,0:30:34.54,0:30:36.75,Another,,0,0,0,,!أخي
Dialogue: 0,0:30:36.79,0:30:42.34,Another,,0,0,0,,...أظن أن هذا ما يناله الخونة
Dialogue: 0,0:30:42.38,0:30:46.22,Another,,0,0,0,,!أخي! أخي
Dialogue: 0,0:30:52.81,0:30:57.81,Default 2,,0,0,0,,أعتقد أن منزل السيد [كازاما]\Nيقع بجانب المحطة مباشرةً
Dialogue: 0,0:30:57.85,0:30:59.77,Default 2,,0,0,0,,...و منزل السيد [كيساراجي] يقع على
Dialogue: 0,0:30:59.81,0:31:03.23,Default 2,,0,0,0,,!أجل\N!فوق تلك التلة
Dialogue: 0,0:31:03.23,0:31:06.53,Default 2,,0,0,0,,!فلنذهب لرؤية السيد [كازاما] أولًا
Dialogue: 0,0:31:14.08,0:31:17.08,Default 2,,0,0,0,,رائع! هذا نظام "كاد"، أليس كذلك؟
Dialogue: 0,0:31:17.12,0:31:19.79,Default 2,,0,0,0,,كل المخططات تُصنع على الحاسوب\Nأليس كذلك؟
Dialogue: 0,0:31:19.83,0:31:22.88,Default 2,,0,0,0,,!أنت تعرف الكثير
Dialogue: 0,0:31:22.88,0:31:26.17,Default 2,,0,0,0,,لا أحد يستخدم ألواح الرسم هذه الأيام
Dialogue: 0,0:31:26.21,0:31:29.43,Default 2,,0,0,0,,ما هي لوحة الرسم؟
Dialogue: 0,0:31:29.43,0:31:32.93,Default 2,,0,0,0,,فهمت! أنتم في الواقع لم تسمعوا عنها قبلًا
Dialogue: 0,0:31:32.97,0:31:36.27,Default 2,,0,0,0,,فيما مضى، كان عليك أن تضع\Nقطعة من الورق فوق لوحةٍ كبيرة
Dialogue: 0,0:31:36.31,0:31:38.85,Default 2,,0,0,0,,وترسم باستخدام مسطرةٍ وقلم رصاص
Dialogue: 0,0:31:38.89,0:31:40.94,Default 2,,0,0,0,,حقًا؟
Dialogue: 0,0:31:40.98,0:31:44.06,Default 2,,0,0,0,,هل تريدون شيئًا أيها الأطفال؟
Dialogue: 0,0:31:44.11,0:31:45.94,Default 2,,0,0,0,,!هيا! أسرع واسأله
Dialogue: 0,0:31:45.98,0:31:50.15,Default 2,,0,0,0,,أنا؟ -\N!أنت اقترحت ذلك -
Dialogue: 0,0:31:50.20,0:31:52.82,Default 2,,0,0,0,,حسنًا
Dialogue: 0,0:31:52.87,0:31:56.49,Default 2,,0,0,0,,!في الواقع يا سيد [كازاما]\N...نحن
Dialogue: 0,0:31:56.54,0:31:59.96,Default 2,,0,0,0,,!نظن أن هذا منزلٌ لطيف
Dialogue: 0,0:32:00.00,0:32:03.83,Default 2,,0,0,0,,!"لديك هواءٌ طلق ويمكنك رؤية جبل "فوجي
Dialogue: 0,0:32:03.88,0:32:05.09,Thoughts,,0,0,0,,{\1}يا إلهي{\i0}
Dialogue: 0,0:32:05.09,0:32:07.59,Default 2,,0,0,0,,!نحن فرقة التحريات الصغير
Dialogue: 0,0:32:07.59,0:32:09.05,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:32:09.09,0:32:12.38,Default 2,,0,0,0,,!نحن نحقق بمقتل السيد [أوكي]
Dialogue: 0,0:32:14.30,0:32:16.47,Default 2,,0,0,0,,!من الجيد سماع هذا
Dialogue: 0,0:32:16.51,0:32:22.52,Default 2,,0,0,0,,!طبعًا\N!يمكنكم سؤال أي شيءٍ تريدونه أيها المتحرون الصغار
Dialogue: 0,0:32:22.56,0:32:27.52,Default 2,,0,0,0,,حسنًا إذًا\Nماذا كان رأيك في الراحل السيد [أوكي]؟
Dialogue: 0,0:32:27.57,0:32:30.19,Default 2,,0,0,0,,فهمت، تريدون الدخول في صلب الموضوع مباشرةً
Dialogue: 0,0:32:30.24,0:32:32.49,Default 2,,0,0,0,,عجوزٌ فظ على ما أعتقد
Dialogue: 0,0:32:32.53,0:32:37.20,Default 2,,0,0,0,,ولكني حصلت على هذه الوظيفة\Nلأنه أعاد النظر في مرسوم المدينة للبناء
Dialogue: 0,0:32:37.24,0:32:39.50,Default 2,,0,0,0,,وبهذا المنطق فأنا شاكرٌ له ذلك
Dialogue: 0,0:32:39.50,0:32:44.63,Default 2,,0,0,0,,هل تجادلت معه بشأن أي شيء خلال\Nفترة التصميم؟
Dialogue: 0,0:32:44.67,0:32:46.88,Default 2,,0,0,0,,...لا شيء مع السيد [أوكي]
Dialogue: 0,0:32:46.92,0:32:48.96,Default 2,,0,0,0,,هل تجادلت مع شخصٍ آخر إذًا؟
Dialogue: 0,0:32:49.00,0:32:52.30,Default 2,,0,0,0,,...ماذا؟ لا، ليس هذا ما عنيته
Dialogue: 0,0:32:54.97,0:32:57.18,Default 2,,0,0,0,,...ماذا؟ تلك الصورة
Dialogue: 0,0:32:57.22,0:33:01.98,Default 2,,0,0,0,,إنه ابني\Nلطيف، أليس كذلك؟
Dialogue: 0,0:33:02.02,0:33:06.94,Default 2,,0,0,0,,أفتقد صوته حقًا بينما أعمل وحدي بالليل
Dialogue: 0,0:33:06.98,0:33:11.28,Default 2,,0,0,0,,أتصل أحيانًا عندما أعرف أنه نائم\N!أنا أبٌ شغوفٌ فعلًا
Dialogue: 0,0:33:23.04,0:33:24.37,Default 2,,0,0,0,,...هيا
Dialogue: 0,0:33:27.17,0:33:31.17,Default 2,,0,0,0,,...نحن فرقة التحريات الصغير
Dialogue: 0,0:33:34.30,0:33:36.47,Default 2,,0,0,0,,فيما يتعلق بالسيد [أوكي]\N...نحن نحقق
Dialogue: 0,0:33:36.51,0:33:40.43,Default 2,,0,0,0,,ليس للأطفال مكان ليتصرفوا\N!كأنهم من السلطات
Dialogue: 0,0:33:40.47,0:33:42.10,Default 2,,0,0,0,,!...لا
Dialogue: 0,0:33:45.31,0:33:51.28,Default 2,,0,0,0,,ولكن سيكون من المؤسف أن ترحلوا\Nصفر اليدين
Dialogue: 0,0:33:57.45,0:33:59.95,Default 2,,0,0,0,,...أنا أقدر الرسومات ولكن
Dialogue: 0,0:33:59.99,0:34:02.29,Default 2,,0,0,0,,لم نحظ بفرصة السؤال عن الحادث
Dialogue: 0,0:34:02.33,0:34:05.46,Default 2,,0,0,0,,أعتقد أنه يجب أن\Nتتولى الشرطة الأمر، أليس كذلك؟
Dialogue: 0,0:34:05.50,0:34:08.08,Default 2,,0,0,0,,بالضبط
Dialogue: 0,0:34:08.08,0:34:10.04,Default 2,,0,0,0,,إنها السادسة\Nفلنعد إلى المنزل الآن
Dialogue: 0,0:34:22.39,0:34:25.23,Default 2,,0,0,0,,!ما كان هذا الصوت؟
Dialogue: 0,0:34:25.27,0:34:27.60,Default 2,,0,0,0,,لابد أنه صوت شخيري؟
Dialogue: 0,0:34:42.08,0:34:44.08,Default 2,,0,0,0,,[هايبرا] كانت تتحدث بالهاتف\Nفي منتصف الليل؟
Dialogue: 0,0:34:44.08,0:34:48.62,Default 2,,0,0,0,,أتذكر ما قاله [غينتا]\Nعندما ذهبنا للتخييم؟
Dialogue: 0,0:34:48.62,0:34:52.46,Default 2,,0,0,0,,...اعتقد أنها كانت حقًا تستخدم الهاتف
Dialogue: 0,0:34:52.46,0:34:56.55,Default 2,,0,0,0,,ولكن ليس لديها من تكلمه\Nأليس كذلك؟
Dialogue: 0,0:34:56.59,0:34:59.01,Default 2,,0,0,0,,أنا أثق بها
Dialogue: 0,0:34:59.05,0:35:03.31,Default 2,,0,0,0,,ولكن ثمة احتمال ضئيل بأن يكون\Nخوفها من الرجال ذوي الملابس السوداء
Dialogue: 0,0:35:03.31,0:35:06.27,Default 2,,0,0,0,,...قد دفعها للانضمام للمنظمة مجددًا
Dialogue: 0,0:35:08.14,0:35:11.44,Default 2,,0,0,0,,لا بأس يا بروفيسور\N!لا داعي للقلق، أراك لاحقًا
Dialogue: 0,0:35:17.11,0:35:19.03,Default 2,,0,0,0,,!مرحبًا! لقد جئتم باكرًا كلكم
Dialogue: 0,0:35:19.07,0:35:20.20,Default 2,,0,0,0,,!صباح الخير يا [كونان]
Dialogue: 0,0:35:20.24,0:35:23.03,Default 2,,0,0,0,,ما الذي أخرك؟ -\N!لقد كنا في انتظارك -
Dialogue: 0,0:35:23.08,0:35:25.45,Default 2,,0,0,0,,!تريد [هايبرا] زيارة السيد [هارا] أيضًا
Dialogue: 0,0:35:25.49,0:35:28.04,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:35:28.08,0:35:33.71,Default 2,,0,0,0,,ما الغريب في ذلك؟\Nأنا أيضًا مهتمةٌ بألعاب الفيديو
Dialogue: 0,0:35:41.14,0:35:45.10,Default 2,,0,0,0,,غرفة 407\N!هذا هو منزل السيد [هارا]
Dialogue: 0,0:35:47.60,0:35:50.64,Default 2,,0,0,0,,...ماذا؟ الباب مفتوح
Dialogue: 0,0:35:50.69,0:35:53.06,Default 2,,0,0,0,,!هذا إهمالٌ منه
Dialogue: 0,0:35:53.11,0:35:55.07,Default 2,,0,0,0,,!سيد [هارا]\N!نحن هنا
Dialogue: 0,0:35:57.73,0:36:00.36,Default 2,,0,0,0,,!...[كونان]، السيد [هارا] قد
Dialogue: 0,0:36:02.16,0:36:03.78,Default 2,,0,0,0,,!اتصلوا بالطوارئ
Dialogue: 0,0:36:10.12,0:36:13.71,Thoughts,,0,0,0,,{\1}!لقد تم إطلاق النار على صدره\N!ومات فورًا{\i0}
Dialogue: 0,0:36:13.75,0:36:16.17,Thoughts,,0,0,0,,{\1}!سكين؟{\i0}
Dialogue: 0,0:36:16.17,0:36:18.17,Thoughts,,0,0,0,,{\1}كان على وشك تناول الكعك؟{\i0}
Dialogue: 0,0:36:20.84,0:36:23.84,Thoughts,,0,0,0,,{\1}!"كوب "أو-شوكو{\i0}
Dialogue: 0,0:36:23.84,0:36:26.31,Thoughts,,0,0,0,,{\i0}!مما يعني أنه كان نفس القاتل{\i0}
Dialogue: 0,0:36:33.44,0:36:35.44,Default 2,,0,0,0,,حسنًا أيها الطبيب؟
Dialogue: 0,0:36:35.48,0:36:39.15,Default 2,,0,0,0,,سيكون علينا القيام بالتشريح للتأكد
Dialogue: 0,0:36:39.19,0:36:44.11,Default 2,,0,0,0,,ولكنه مات البارحة بين فترتي بعد الظهر والمساء
Dialogue: 0,0:36:44.16,0:36:48.12,Default 2,,0,0,0,,على ما يبدو أنه كان على وشك تناول\Nبعضًا من كعكة الشوكولاه
Dialogue: 0,0:36:48.16,0:36:54.63,Default 2,,0,0,0,,إذًا فهذا يعني أنه حاول قتال القاتل\N...بسكينه الفضية عندما دخل
Dialogue: 0,0:36:54.67,0:36:59.13,Default 2,,0,0,0,,ولكن ماذا يجب أن يعني\Nكوب "الأو-شوكو" ذلك؟
Dialogue: 0,0:36:59.17,0:37:04.22,Default 2,,0,0,0,,أليس ذلك واضحًا؟\Nإنها جريمة قتلٍ متسلسلة ارتكبها قاتل السيد [أوكي]
Dialogue: 0,0:37:04.22,0:37:09.64,Default 2,,0,0,0,,!إنه على الأرجح الآن، أن تلك الأكواب ليست رسالة الضحايا
Dialogue: 0,0:37:09.68,0:37:12.81,Default 2,,0,0,0,,ولكنها رسالة القاتل
Dialogue: 0,0:37:12.85,0:37:14.60,Default 2,,0,0,0,,!مرحبًا يا أطفال
Dialogue: 0,0:37:14.60,0:37:16.61,Default 2,,0,0,0,,هل انتهيت يا سيد [تومي]؟
Dialogue: 0,0:37:16.61,0:37:20.73,Default 2,,0,0,0,,أجل\Nلقد سمعت أنكم أنتم من وجدتموه؟
Dialogue: 0,0:37:20.78,0:37:23.24,Default 2,,0,0,0,,أجل، لقد صدمنا ذلك
Dialogue: 0,0:37:23.24,0:37:25.16,Default 2,,0,0,0,,أهذا هو كوب "الأو-شوكو"؟
Dialogue: 0,0:37:25.20,0:37:26.62,Default 2,,0,0,0,,هذا صحيح
Dialogue: 0,0:37:26.62,0:37:28.91,Thoughts,,0,0,0,,{\1}ماذا؟ ليس هناك دماء عليه{\i0}
Dialogue: 0,0:37:31.25,0:37:33.79,Default 2,,0,0,0,,أخبرني يا سيد [تومي]\Nأهذا كل الكوب؟
Dialogue: 0,0:37:33.83,0:37:37.71,Default 2,,0,0,0,,!بالطبع! لا شيء يهرب من المفتش [تومي]
Dialogue: 0,0:37:37.75,0:37:39.17,Default 2,,0,0,0,,!وداعًا الآن
Dialogue: 0,0:37:39.21,0:37:44.17,Default 2,,0,0,0,,والآن بات الأمر جليًا أنهم ليسوا الفاعلين\Nيستحيل أن يتركوا مثل هذه الأدلة خلفهم
Dialogue: 0,0:37:50.26,0:37:53.93,Default 2,,0,0,0,,بعد القيام بالتشريح\Nعرفنا أن وقت وفاته التقريبي
Dialogue: 0,0:37:53.98,0:37:56.65,Default 2,,0,0,0,,هو البارحة مساءً، بين الخامسة والسادسة
Dialogue: 0,0:37:56.65,0:38:01.69,Default 2,,0,0,0,,وأيضًا كل البيانات على حاسوب السيد [هارا]\Nقد تم محوها
Dialogue: 0,0:38:01.73,0:38:05.20,Default 2,,0,0,0,,من المحتمل أن يكون هذا الدافع
Dialogue: 0,0:38:05.24,0:38:07.70,Default 2,,0,0,0,,السيد [كيساراجي] كان مع [كونان] وأصدقائه
Dialogue: 0,0:38:07.74,0:38:10.37,Default 2,,0,0,0,,بين الخامسة والسادسة\Nلذا فهو مستبعد
Dialogue: 0,0:38:10.41,0:38:14.75,Default 2,,0,0,0,,ومن ناحية أخرى\Nالسيد [كازاما] كان باستطاعته القيادة إلى هناك
Dialogue: 0,0:38:14.79,0:38:16.83,Default 2,,0,0,0,,بعد أن غادر [كونان] والآخرين
Dialogue: 0,0:38:16.87,0:38:19.21,Default 2,,0,0,0,,ماذا عن الآنسة [ميو]؟
Dialogue: 0,0:38:19.25,0:38:23.30,Default 2,,0,0,0,,كلٌ من الآنسة [توكيوا] والآنسة [ساواجوتشي] \N لا يملكان حجة غيابٍ واضحة
Dialogue: 0,0:38:23.34,0:38:26.22,Default 2,,0,0,0,,آسفٌ يا سيد [موري]\Nولكني أعتقد أن القاتل هو
Dialogue: 0,0:38:26.26,0:38:32.22,Default 2,,0,0,0,,[توكيوا ميو]، أو [كازاما هيديهيكو]\Nأو [ساواجوتشي شينامي]
Dialogue: 0,0:38:32.26,0:38:36.85,Default 2,,0,0,0,,ومن المحتمل جدًا أن تستمر تلك الحوادث
Dialogue: 0,0:38:36.85,0:38:42.98,Default 2,,0,0,0,,لهذا اقترح المفتش [ميجوري]\Nتأجيل الحفل هذا السبت
Dialogue: 0,0:38:43.03,0:38:44.78,Default 2,,0,0,0,,ولكنها لم تستمع إليه
Dialogue: 0,0:38:44.82,0:38:47.78,Default 2,,0,0,0,,وليس هذا فقط\Nولكنها أعطتني هذا لأعطيه لك
Dialogue: 0,0:38:51.62,0:38:54.33,Default 2,,0,0,0,,...هذه دعوةٌ إلى الحفل
Dialogue: 0,0:38:54.33,0:38:58.92,Default 2,,0,0,0,,و[كونان] والأطفال وأنا\N!مدرجين أيضًا
Dialogue: 0,0:38:58.96,0:39:00.71,Default 2,,0,0,0,,!ماذا؟! نحن أيضًا؟
Dialogue: 0,0:39:00.75,0:39:04.05,Default 2,,0,0,0,,!حقًا\Nفيم تفكر؟
Dialogue: 0,0:39:31.62,0:39:33.41,Default 2,,0,0,0,,{\1}!يا زعيم{\i0}
Dialogue: 0,0:39:33.45,0:39:34.91,Default 2,,0,0,0,,أهذا هو المكان؟
Dialogue: 0,0:39:34.91,0:39:38.79,Default 2,,0,0,0,,قام المدير بالتأكيد على صورتها
Dialogue: 0,0:39:38.83,0:39:44.34,Default 2,,0,0,0,,ولتعتقد أنها تحصنت في مكب النفايات هذا\N...لتستتر من المنظمة
Dialogue: 0,0:39:44.38,0:39:46.88,Default 2,,0,0,0,,فقد دُفع الإيجار مقدمًا لمدة سنة
Dialogue: 0,0:39:46.92,0:39:49.30,Default 2,,0,0,0,,ولا أحد يجيب الهاتف أبدًا
Dialogue: 0,0:39:49.34,0:39:55.06,Default 2,,0,0,0,,يقول الجيران أن الرسائل تُسجل\Nعليه بعض الأحيان
Dialogue: 0,0:39:55.10,0:39:58.98,Default 2,,0,0,0,,...ولكن الغريب أني حين تفقدت الآلة
Dialogue: 0,0:39:59.02,0:40:01.98,Default 2,,0,0,0,,لم تكن هناك أي رسائل مسجلة
Dialogue: 0,0:40:02.02,0:40:07.61,Default 2,,0,0,0,,ماذا؟! أجل\Nما الهدف من كل ذلك؟
Dialogue: 0,0:40:07.65,0:40:11.49,Default 2,,0,0,0,,طباع النساء لا تتغير
Dialogue: 0,0:40:11.53,0:40:15.95,Default 2,,0,0,0,,هناك حاسوبٌ في السيارة\Nاذهب وأحضره
Dialogue: 0,0:40:15.99,0:40:19.33,Default 2,,0,0,0,,برنامج تعقب الهاتف الخاص بالمنظمة
Dialogue: 0,0:40:19.37,0:40:23.63,Default 2,,0,0,0,,بهذا نستطيع تعقب المكالمات في غضون\Nعشرين ثانية
Dialogue: 0,0:40:23.67,0:40:24.96,Default 2,,0,0,0,,!فهمتك
Dialogue: 0,0:41:08.09,0:41:11.92,Another,,0,0,0,,مرحبًا، معكم [ميانو]\Nأنا لست بالمنزل حاليًا
Dialogue: 0,0:41:11.97,0:41:15.93,Another,,0,0,0,,رجاءً اترك اسمك والرسالة بعد الصافرة
Dialogue: 0,0:41:17.72,0:41:20.77,Another,,0,0,0,,أختي؟ هذه أنا
Dialogue: 0,0:41:20.81,0:41:24.77,Another,,0,0,0,,...سأذهب إلى حفلة افتتاح مبنى البرجين التوأمين
Dialogue: 0,0:41:31.99,0:41:33.86,Default 2,,0,0,0,,...[كودو]
Dialogue: 0,0:41:33.86,0:41:36.91,Default 2,,0,0,0,,إذًا فقد كنتِ تتصلين بأختك
Dialogue: 0,0:41:36.95,0:41:42.41,Default 2,,0,0,0,,الهاتف الذي كان بشقتها\Nالتي كانت تستخدمه عندما كانت على قيد الحياة
Dialogue: 0,0:41:42.45,0:41:46.75,Default 2,,0,0,0,,!الآن فهمت\Nأردتِ أن تتحدثي مع أختك الراحلة
Dialogue: 0,0:41:49.50,0:41:52.21,Default 2,,0,0,0,,أستطيع تخيل ما تشعرين به\N...ولكن هذا خطرٌ جدًا
Dialogue: 0,0:41:52.21,0:41:54.84,Default 2,,0,0,0,,!لا أحد يعرف كيف أشعر
Dialogue: 0,0:41:56.76,0:41:59.64,Default 2,,0,0,0,,!يا [هايبرا] -\N!تمهل -
Dialogue: 0,0:41:59.68,0:42:01.64,Default 2,,0,0,0,,دعها الآن
Dialogue: 0,0:42:17.78,0:42:22.79,Default 2,,0,0,0,,اللعنة! كانت قد تبقت بضع ثوانٍ\N!حتى نتعقبها
Dialogue: 0,0:42:22.83,0:42:23.75,Default 2,,0,0,0,,{\i0}!...يا زعيم{\i0}
Dialogue: 0,0:42:23.79,0:42:29.58,Default 2,,0,0,0,,مرحبًا، معكم [ميانو]\N...أنا لست بالمنزل حاليًا، رجاءً
Dialogue: 0,0:42:29.58,0:42:31.75,Default 2,,0,0,0,,!لقد محت الرسالة
Dialogue: 0,0:42:31.75,0:42:35.67,Default 2,,0,0,0,,إنك لا تظن بأنها تعرف أننا هنا\N!أليس كذلك؟
Dialogue: 0,0:42:35.72,0:42:42.51,Default 2,,0,0,0,,لا، ليس الأمر كذلك\Nلقد مسحت الرسالة حتى لا يسمعها أحدٌ لاحقًا
Dialogue: 0,0:42:42.56,0:42:45.48,Default 2,,0,0,0,,ليس حتى بأحلامها أن تتخيل\Nأننا نجلس بجانب الهاتف
Dialogue: 0,0:42:45.52,0:42:48.77,Default 2,,0,0,0,,نستمع إليها
Dialogue: 0,0:42:48.81,0:42:51.31,Default 2,,0,0,0,,اتعتقد أنها ستتصل مجددًا؟
Dialogue: 0,0:42:51.36,0:42:53.86,Default 2,,0,0,0,,أشك في ذلك
Dialogue: 0,0:42:53.90,0:42:59.53,Default 2,,0,0,0,,ولكن يبدو أن السماء\N!تعرض علينا دعمها
Dialogue: 0,0:42:59.57,0:43:02.20,Default 2,,0,0,0,,...حفلة افتتاح مبنى البرجين التوأمين
Dialogue: 0,0:43:05.58,0:43:09.17,Default 2,,0,0,0,,أخيرًا سأتمكن من رؤيتها يا [شيري]
Dialogue: 0,0:43:09.21,0:43:12.84,Default 2,,0,0,0,,...تلك الرمقة البائسة على وجهك البارد الميت
Dialogue: 0,0:43:27.77,0:43:30.27,Default 2,,0,0,0,,آسفةٌ بشأن ليلة الأمس
Dialogue: 0,0:43:30.27,0:43:37.53,Default 2,,0,0,0,,علمت أن الأمر خطيرٌ أيضًا\Nوعرفت أن علي أن أتوقف في مرحلةٍ ما
Dialogue: 0,0:43:37.57,0:43:42.87,Default 2,,0,0,0,,بالرغم من ذلك، كلما شعرت بالوحدة والخوف
Dialogue: 0,0:43:42.91,0:43:45.70,Default 2,,0,0,0,,...أجد نفسي أرفع سماعة الهاتف بدون تفكير
Dialogue: 0,0:43:45.74,0:43:49.71,Default 2,,0,0,0,,فقط لأسمع العشر ثوان\N...من صوت أختي
Dialogue: 0,0:43:49.75,0:43:52.71,Default 2,,0,0,0,,لا تكوني حمقاء\Nأنتِ لست وحيدة
Dialogue: 0,0:43:56.63,0:44:01.68,Default 2,,0,0,0,,لقد عرفت أنه الوقت المناسب\Nلأتوقف عن ذلك؛ لذلك سأتوقف
Dialogue: 0,0:44:01.72,0:44:04.51,Default 2,,0,0,0,,لا تقلق\Nفقد محوت الرسائل
Dialogue: 0,0:44:07.72,0:44:12.02,Default 2,,0,0,0,,...ولكن مؤخرًا، أتساءل عن ماهيتي
Dialogue: 0,0:44:14.90,0:44:20.11,Default 2,,0,0,0,,...أتساءل من أنا، وإلى أين أنتمي
Dialogue: 0,0:44:20.15,0:44:23.03,Default 2,,0,0,0,,لا مكان لي لأكون به
Dialogue: 0,0:44:23.03,0:44:25.87,Default 2,,0,0,0,,!ماذا؟! لا مكان لكِ
Dialogue: 0,0:44:25.91,0:44:27.74,Default 2,,0,0,0,,عن ماذا تتحدثين يا [هايبرا]؟
Dialogue: 0,0:44:27.79,0:44:31.87,Default 2,,0,0,0,,!لكِ مقعدٌ هناك
Dialogue: 0,0:44:31.92,0:44:33.63,Default 2,,0,0,0,,!هذا لي
Dialogue: 0,0:44:33.67,0:44:35.09,Default 2,,0,0,0,,!وهذا مكاني
Dialogue: 0,0:44:35.13,0:44:37.09,Default 2,,0,0,0,,!وهذا لي
Dialogue: 0,0:44:39.17,0:44:42.13,Default 2,,0,0,0,,أترين؟\Nقلت لكِ أنتِ لست وحيدة
Dialogue: 0,0:45:25.22,0:45:28.97,Default 2,,0,0,0,,!بحقك\N!أين هي تلك الغنية المدللة؟
Dialogue: 0,0:45:29.01,0:45:30.77,Default 2,,0,0,0,,لقد قالت أنها في طريقها إلى هنا
Dialogue: 0,0:45:30.81,0:45:32.64,Default 2,,0,0,0,,!لا يسعني انتظار الحفل
Dialogue: 0,0:45:32.68,0:45:36.77,Default 2,,0,0,0,,!أراهن بأنه سيكون هناك الكثير من الطعام -\N!أريد وجبات إنقليس معلبة -
Dialogue: 0,0:45:36.77,0:45:39.77,Default 2,,0,0,0,,لا أظن ان لديهم هذا
Dialogue: 0,0:45:39.77,0:45:42.65,Default 2,,0,0,0,,أتعتقدين بأن السيد [هارا] مدير الإدارة
Dialogue: 0,0:45:42.69,0:45:46.70,Default 2,,0,0,0,,كان يعمل مع الرجال ذوي الملابس السوداء؟
Dialogue: 0,0:45:46.74,0:45:48.78,Default 2,,0,0,0,,ذلك محتمل
Dialogue: 0,0:45:48.83,0:45:51.66,Default 2,,0,0,0,,لقد كانوا يجلبون الكثير من الشباب\Nالواعد في شتى المجالات
Dialogue: 0,0:45:51.70,0:45:55.67,Default 2,,0,0,0,,بما فيهم من السياسين، رجال أعمال، أطباء علماء، وأكثر
Dialogue: 0,0:45:55.71,0:45:57.42,Default 2,,0,0,0,,حتى عضو المجلس [أوكي]؟
Dialogue: 0,0:45:57.42,0:46:00.96,Default 2,,0,0,0,,لم يكن لديه القوة الكافية ولكن ربما حين كان شابًا
Dialogue: 0,0:46:01.00,0:46:04.13,Default 2,,0,0,0,,على كل حال، حين الانضمام إلى المنظمة
Dialogue: 0,0:46:04.13,0:46:10.18,Default 2,,0,0,0,,من يحاول تركها أو خيانتها\Nيمكنه أن يتوقع أن يصدر حكمٌ بالموت عليه
Dialogue: 0,0:46:10.22,0:46:12.85,Default 2,,0,0,0,,تمامًا كما يحاولون قتلي
Dialogue: 0,0:46:12.89,0:46:17.23,Default 2,,0,0,0,,في مثل هذه الحالة، إذا كان القاتل\N...هو واحدٌ من أولئك الأربعة
Dialogue: 0,0:46:17.27,0:46:18.02,Default 2,,0,0,0,,أجل
Dialogue: 0,0:46:18.06,0:46:22.03,Default 2,,0,0,0,,هناك احتمالٌ أن يكونوا على صلةٍ بالمنظمةِ أيضًا
Dialogue: 0,0:46:22.07,0:46:24.82,Default 2,,0,0,0,,!مرحبًا! آسفةٌ على انتظاركم
Dialogue: 0,0:46:24.86,0:46:27.86,Default 2,,0,0,0,,![سونوكو]! ماذا حدث لشعرك؟
Dialogue: 0,0:46:27.91,0:46:30.78,Default 2,,0,0,0,,!إنه تغييرٌ في المظهر
Dialogue: 0,0:46:30.83,0:46:34.04,Default 2,,0,0,0,,قررت أن أحذو حذوها\N!وأجرب الشعر المموج
Dialogue: 0,0:46:34.08,0:46:36.71,Default 2,,0,0,0,,إذًا؟ هل يبدو جيدًا علي؟
Dialogue: 0,0:46:40.92,0:46:43.05,Default 2,,0,0,0,,!ماذا؟! يبدو أنك تريد قول شيءٍ ما
Dialogue: 0,0:46:43.09,0:46:44.84,Default 2,,0,0,0,,!لا، لا أريد
Dialogue: 0,0:46:44.84,0:46:48.34,Default 2,,0,0,0,,لقد وقعت في غرام الآنسة [سونوكو]\N!أليس كذلك؟
Dialogue: 0,0:46:48.34,0:46:49.72,Default 2,,0,0,0,,!أأنت جادٌ يا [كونان]؟
Dialogue: 0,0:46:49.76,0:46:51.72,Default 2,,0,0,0,,...ليس الأمر كذلك
Dialogue: 0,0:46:55.43,0:46:57.73,Default 2,,0,0,0,,...ربما علي أن أجرب ذلك أيضًا
Dialogue: 0,0:47:04.82,0:47:07.36,Default 2,,0,0,0,,!أيها المفتش\N!علينا أن نذهب إلى الحفل أيضًا
Dialogue: 0,0:47:07.40,0:47:14.24,Default 2,,0,0,0,,لا! بما أن الآنسة [توكيوا] قد رفضت\N!فكل ما باستطاعتنا فعله هو الانتظار هنا
Dialogue: 0,0:47:14.29,0:47:17.58,Default 2,,0,0,0,,...كل ما يمكن فعله هو الدعاء ألا يحصل شيء
Dialogue: 0,0:47:26.92,0:47:30.18,Default 2,,0,0,0,,رائع! كافيار، فوا جرا\N!والبط
Dialogue: 0,0:47:30.18,0:47:32.43,Default 2,,0,0,0,,!هذا كثيرٌ جدًا
Dialogue: 0,0:47:32.47,0:47:36.31,Default 2,,0,0,0,,!أعتقد اني سأتناول القليل أيضًا -\Nلا، أنت ستتناول الطعام الياباني -
Dialogue: 0,0:47:36.35,0:47:39.31,Default 2,,0,0,0,,سآتي لك ببعض الأطباق ذات السعر الحراري المنخفض
Dialogue: 0,0:47:40.94,0:47:43.40,Default 2,,0,0,0,,...إنها تتصرف كأنها زوجتك
Dialogue: 0,0:47:43.44,0:47:45.98,Default 2,,0,0,0,,أنا دائمًا أتضور جوعًا بسببها
Dialogue: 0,0:47:46.03,0:47:48.82,Default 2,,0,0,0,,!تلك السيارة رائعة
Dialogue: 0,0:47:48.86,0:47:51.45,Default 2,,0,0,0,,!إنها فورد موستانج ذات سقف قابل للطي
Dialogue: 0,0:47:51.49,0:47:54.83,Default 2,,0,0,0,,ولكن كيف أدخلوا شيئًا بمثل هذا الحجم هنا؟
Dialogue: 0,0:47:54.87,0:47:58.83,Default 2,,0,0,0,,قد جُمعت هنا على الأرجح
Dialogue: 0,0:47:58.87,0:48:01.96,Default 2,,0,0,0,,لا، لقد استخدموا مصعد شحن
Dialogue: 0,0:48:02.00,0:48:04.29,Default 2,,0,0,0,,مصعد شحن؟
Dialogue: 0,0:48:04.34,0:48:06.34,Default 2,,0,0,0,,!نملك واحدًا في المبنى السكني الخاص بنا
Dialogue: 0,0:48:06.38,0:48:09.09,Default 2,,0,0,0,,!إنه اكبر من تلك المصاعد العادية بكثير
Dialogue: 0,0:48:09.09,0:48:11.84,Default 2,,0,0,0,,!هل يمكنها رفع فيلٍ إذًا؟
Dialogue: 0,0:48:11.89,0:48:14.01,Default 2,,0,0,0,,...أعتقد ذلك
Dialogue: 0,0:48:14.05,0:48:17.02,Default 2,,0,0,0,,لا أعتقد بأن أحدهم يتخذ من الفيل\Nحيوانًا أليفًا
Dialogue: 0,0:48:24.15,0:48:27.03,Default 2,,0,0,0,,!إنه جميلٌ جدًا
Dialogue: 0,0:48:27.07,0:48:30.24,Default 2,,0,0,0,,إذا كان [شينتشي] هنا ليرى\Nذلك المنظر الخلاب معي
Dialogue: 0,0:48:30.28,0:48:32.82,Default 2,,0,0,0,,!فسأشعر كما لو كنت بالجنة
Dialogue: 0,0:48:32.86,0:48:33.95,Default 2,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:48:33.99,0:48:36.33,Default 2,,0,0,0,,أيًا يكن
Dialogue: 0,0:48:36.37,0:48:40.25,Default 2,,0,0,0,,لقد أردت جعل جبل "فوجي" ظاهرًا من كلا البرجين
Dialogue: 0,0:48:40.25,0:48:43.92,Default 2,,0,0,0,,ولكن الناخبين لم يسمحوا لي
Dialogue: 0,0:48:43.96,0:48:47.59,Thoughts,,0,0,0,,{\i0}"صحيح، جبل فوجي لا يمكن رؤيته من البرج "ب{\i0}
Dialogue: 0,0:48:53.09,0:48:59.97,Default 2,,0,0,0,,شكرًا لكم جميعًا على حضوركم هذا\Nالحفل للافتتاح الكبير
Dialogue: 0,0:49:00.02,0:49:02.14,Default 2,,0,0,0,,!لمبنى البرجين التوأمين
Dialogue: 0,0:49:02.14,0:49:05.90,Default 2,,0,0,0,,أود الاستفتاح بلعبةٍ بسيطة
Dialogue: 0,0:49:05.94,0:49:09.94,Default 2,,0,0,0,,لعبةٌ تشبه اسم الراحل والدي\N[توكيوا كانيناري]
Dialogue: 0,0:49:09.98,0:49:14.03,Default 2,,0,0,0,,والثلاثون عامًا المنصرمين على تأسيس\N!مجموعة [توكيوا]
Dialogue: 0,0:49:14.07,0:49:17.87,Default 2,,0,0,0,,!لعبة تخمين الثلاثين ثانية
Dialogue: 0,0:49:17.91,0:49:20.54,Default 2,,0,0,0,,!تمامًا مثل التى اخترعتها
Dialogue: 0,0:49:20.58,0:49:25.00,Default 2,,0,0,0,,من سيستطيع عد\Nثلاثون ثانية بالضبط أو بالقرب منها
Dialogue: 0,0:49:25.04,0:49:32.63,Default 2,,0,0,0,,سيتلقى تلك الموستانج\N!المعروضة هناك
Dialogue: 0,0:49:32.67,0:49:35.01,Default 2,,0,0,0,,!رائع -\N!سيارة -
Dialogue: 0,0:49:35.01,0:49:39.31,Default 2,,0,0,0,,!إنها سيارةٌ أجنبيةٌ ذات سقفٍ قابلٍ للطي -\N!هذا حقًا رائع -
Dialogue: 0,0:49:39.35,0:49:44.06,Default 2,,0,0,0,,وفي حال كان هناك فائزان\N"فسيتم عقد لعبة "حجر ورقة مقص
Dialogue: 0,0:49:44.10,0:49:50.65,Default 2,,0,0,0,,و الخاسر سوف يتم منحه\N!دراجةً جبلية وخوذة
Dialogue: 0,0:49:50.65,0:49:53.65,Default 2,,0,0,0,,!أفضل الحصول على دراجةٍ جبلية -\N!أنا أيضًا -
Dialogue: 0,0:49:53.65,0:49:56.20,Default 2,,0,0,0,,!لا يمكننا قيادة السيارات
Dialogue: 0,0:49:56.24,0:50:00.99,Default 2,,0,0,0,,!حسنًا يا [ميتسوهيكو] -\N!نحن نملك [أيومي] في صفنا -
Dialogue: 0,0:50:00.99,0:50:03.58,Default 2,,0,0,0,,!النصر بالكاد لنا
Dialogue: 0,0:50:03.62,0:50:06.25,Default 2,,0,0,0,,أين يمكن أن يكون [كونان]؟
Dialogue: 0,0:50:06.29,0:50:10.92,Default 2,,0,0,0,,أطلب من أولئك الذين سيشاركون باللعب\Nأن يسمحوا لنا بالاحتفاظ بساعاتهم
Dialogue: 0,0:50:10.96,0:50:16.93,Default 2,,0,0,0,,وسوف يتم إعادتها بعد قليل\N!بعد إضافة الأحجار الكريمة المناسبة لها
Dialogue: 0,0:50:16.97,0:50:20.60,Default 2,,0,0,0,,!رائع! أحجارٌ كريمة
Dialogue: 0,0:50:20.64,0:50:23.39,Default 2,,0,0,0,,...شركة [توكيوا زايباتسو] لا تعبث
Dialogue: 0,0:50:23.39,0:50:26.06,Default 2,,0,0,0,,!ها نحن ذا
Dialogue: 0,0:50:26.10,0:50:28.31,Default 2,,0,0,0,,!خذ علمًا إذا ما وضعت ساعتك
Dialogue: 0,0:50:28.35,0:50:29.65,Default 2,,0,0,0,,!تفضل
Dialogue: 0,0:50:32.32,0:50:34.40,Default 2,,0,0,0,,!تفضل -\N!لا، لا أريد المشاركة -
Dialogue: 0,0:50:34.40,0:50:36.07,Default 2,,0,0,0,,بالمثل هنا
Dialogue: 0,0:50:36.11,0:50:40.24,Default 2,,0,0,0,,لا أملك ساعة، وليس لدي أي رغبةٍ\Nفي لعب الألعاب
Dialogue: 0,0:50:40.24,0:50:43.87,Default 2,,0,0,0,,!الآن إذًا! هل يستطيع الأطفال التقدم إلى الأمام
Dialogue: 0,0:50:49.42,0:50:52.88,Default 2,,0,0,0,,ماذا؟ [كونان] و[هايبرا] لن يلعبا؟
Dialogue: 0,0:50:55.01,0:50:57.13,Default 2,,0,0,0,,!الآن دعونا نبدأ
Dialogue: 0,0:50:57.18,0:51:03.10,Default 2,,0,0,0,,بمجرد أن تعدوا ثلاثين ثانيةً\N!منذ إشارتها، ارفعوا أعلامكم
Dialogue: 0,0:51:03.14,0:51:05.02,Default 2,,0,0,0,,!أروني ما لديكم
Dialogue: 0,0:51:05.06,0:51:07.35,Default 2,,0,0,0,,!استعداد...ابدأ
Dialogue: 0,0:51:13.19,0:51:15.15,Default 2,,0,0,0,,--. 9. 10.\N--15. 16.
Dialogue: 0,0:51:15.19,0:51:17.15,Default 2,,0,0,0,,21. 22. 23.
Dialogue: 0,0:51:17.20,0:51:23.28,Default 2,,0,0,0,,--7. 8. 9. --8. 9. 10.\N--6... 7 . 8...
Dialogue: 0,0:51:23.28,0:51:28.00,Default 2,,0,0,0,,24. 25. 26. 27
Dialogue: 0,0:51:28.04,0:51:30.37,Default 2,,0,0,0,,!لا! لقد فقدت العدد
Dialogue: 0,0:51:30.42,0:51:31.71,Default 2,,0,0,0,,!هنا
Dialogue: 0,0:51:31.75,0:51:33.09,Default 2,,0,0,0,,!هنا -\N!هنا -
Dialogue: 0,0:51:33.09,0:51:36.51,Default 2,,0,0,0,,يا إلهي! سيكون علي أن أرفع يدي\N!عندما يفعل شخصٌ آخر
Dialogue: 0,0:51:36.55,0:51:37.47,Default 2,,0,0,0,,!هنا
Dialogue: 0,0:51:37.51,0:51:41.14,Default 2,,0,0,0,,!انتهى الوقت -\N!ذلك العلم الأزرق هناك -
Dialogue: 0,0:51:41.18,0:51:45.52,Default 2,,0,0,0,,!مبارك\N!أنت الفائز بالجائزة الكبرى
Dialogue: 0,0:51:45.56,0:51:47.14,Default 2,,0,0,0,,!أبي
Dialogue: 0,0:51:47.18,0:51:49.10,Default 2,,0,0,0,,أيعقل؟
Dialogue: 0,0:51:49.14,0:51:53.11,Default 2,,0,0,0,,!هذا أنت يا سيد [موري]\N!تعال إلى الأعلى
Dialogue: 0,0:51:53.11,0:51:55.78,Default 2,,0,0,0,,!المعذرة
Dialogue: 0,0:51:55.82,0:51:59.45,Default 2,,0,0,0,,أقدم لكم جميعًا المتحر الكبير\N!السيد [موري كوغورو]
Dialogue: 0,0:51:59.45,0:52:02.20,Default 2,,0,0,0,,هل يمكنك إلقاء كلمةٍ قصيرة؟
Dialogue: 0,0:52:02.24,0:52:05.87,Default 2,,0,0,0,,الآن أستطيع توديع\N!حياة السيارات المستأجرة
Dialogue: 0,0:52:07.66,0:52:10.33,Default 2,,0,0,0,,...يا إلهي، يا أبي
Dialogue: 0,0:52:10.37,0:52:15.09,Default 2,,0,0,0,,...لقد فشلت -\N...لقد كنت ما أزال في الثانية الخامسة والعشرين -
Dialogue: 0,0:52:15.13,0:52:16.75,Default 2,,0,0,0,,لقد كنت في الثانية عشر
Dialogue: 0,0:52:23.09,0:52:24.60,Default 2,,0,0,0,,...عظيم، سيسرني ذلك
Dialogue: 0,0:52:24.64,0:52:27.81,Default 2,,0,0,0,,...المعذرة يا سيد [كازاما]، إذا ما كان باستطاعتك
Dialogue: 0,0:52:27.81,0:52:29.14,Default 2,,0,0,0,,المعذرة
Dialogue: 0,0:52:36.44,0:52:40.24,Default 2,,0,0,0,,والآن مع ضيف عمل اليوم الرئيسي
Dialogue: 0,0:52:40.28,0:52:49.08,Default 2,,0,0,0,,سيد الرسم بالأسلوب الياباني\N!السيد [كيساراجي هوسوي]
Dialogue: 0,0:52:49.12,0:52:52.17,Default 2,,0,0,0,,السيد [كيساراجي] يحب جبل "فوجي" بشدة
Dialogue: 0,0:52:52.17,0:52:56.63,Default 2,,0,0,0,,وقد رسم منظره الساحر\N!طيلة ثلاثين عامًا
Dialogue: 0,0:52:56.67,0:53:00.63,Default 2,,0,0,0,,وهذه المرة قد تبرع بعمله الأخير\Nليحتفل بافتتاح
Dialogue: 0,0:53:00.67,0:53:05.72,Default 2,,0,0,0,,مبنى البرجين التوأمين\N!المملوك لتلميذته [توكيوا ميو]
Dialogue: 0,0:53:05.76,0:53:09.39,Default 2,,0,0,0,,!"أقدم لكم، "جبل فوجي في ثلوج الربيع
Dialogue: 0,0:53:15.44,0:53:16.52,Default 2,,0,0,0,,!أهذا...؟
Dialogue: 0,0:53:16.56,0:53:17.86,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:53:22.15,0:53:23.45,Default 2,,0,0,0,,!آنستي
Dialogue: 0,0:53:26.20,0:53:27.53,Default 2,,0,0,0,,!اللعنة
Dialogue: 0,0:53:29.45,0:53:32.12,Default 2,,0,0,0,,!أنزلوها\N!أنزلي الآنسة [ميو]
Dialogue: 0,0:53:32.16,0:53:33.87,Default 2,,0,0,0,,!وأغلقي الستائر
Dialogue: 0,0:53:33.87,0:53:35.21,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,0:53:47.18,0:53:49.14,Default 2,,0,0,0,,...لقد كنا متأخرين
Dialogue: 0,0:53:52.35,0:53:55.14,Thoughts,,0,0,0,,{\i0}!سلك البيانو متصل بالعقد؟{\i0}
Dialogue: 0,0:53:55.19,0:53:59.44,Thoughts,,0,0,0,,{\i0}!يقود ذلك السلك إلى الأعلى؟{\i0}
Dialogue: 0,0:53:59.48,0:54:01.15,Default 2,,0,0,0,,...هذا
Dialogue: 0,0:54:01.19,0:54:02.78,Default 2,,0,0,0,,{\i0}!"كوب "أو-شوكو{\i0}
Dialogue: 0,0:54:02.82,0:54:04.78,Thoughts,,0,0,0,,{\i0}!أيمكن أن يكون؟! هذا أيضًا...؟{\i0}
Dialogue: 0,0:54:06.45,0:54:08.57,Default 2,,0,0,0,,!ماذا تقول؟! الآنسة [توكيوا ميو]؟
Dialogue: 0,0:54:08.62,0:54:09.91,Default 2,,0,0,0,,!فلنذهب -\N!أجل يا سيدي -
Dialogue: 0,0:54:29.30,0:54:31.64,Thoughts,,0,0,0,,{\1}..."صورة جبل "فوجي{\i0}
Dialogue: 0,0:54:31.64,0:54:35.56,DCFlashback,,0,0,0,,يمكنك حتى رؤية جبل "فوجي" ليلًا من هنا
Dialogue: 0,0:54:35.60,0:54:38.69,Thoughts,,0,0,0,,{\i0}إذًا فهذا ما قد عنته؟{\i0}
Dialogue: 0,0:54:38.73,0:54:44.49,Default 2,,0,0,0,,ببساطةٍ قد تم ربط خطاف سلك البيانو ذلك\Nفي عقد الآنسة [ميو]
Dialogue: 0,0:54:44.53,0:54:46.53,Default 2,,0,0,0,,ثم مر السلك فوق المنصة
Dialogue: 0,0:54:46.57,0:54:50.37,Default 2,,0,0,0,,لهذا حين أُنزلت اللوحة تم رفعها لأعلى
Dialogue: 0,0:54:50.41,0:54:53.54,Default 2,,0,0,0,,فهمت، من كان على المسرح أيضًا؟
Dialogue: 0,0:54:53.58,0:54:56.25,Default 2,,0,0,0,,فقط أنا والسيد [كيساراجي]
Dialogue: 0,0:54:56.29,0:54:58.62,Default 2,,0,0,0,,رجاءً ابقيا مكانكما إذًا
Dialogue: 0,0:54:58.67,0:55:00.50,Default 2,,0,0,0,,اذهب وقف مكان الآنسة [توكيوا]\Nيا [شيبا]
Dialogue: 0,0:55:00.54,0:55:01.50,Default 2,,0,0,0,,علم
Dialogue: 0,0:55:01.50,0:55:04.80,Default 2,,0,0,0,,تلك الأضواء كانت علاماتنا\Nالضوء في الوسط كان للآنسة [ميو]
Dialogue: 0,0:55:06.67,0:55:08.76,Default 2,,0,0,0,,أنا كنت هنا
Dialogue: 0,0:55:08.80,0:55:11.76,Default 2,,0,0,0,,وفي ذلك الوقت كنتِ\Nبجانب المسرح يا آنسة [ساواجوتشي]؟
Dialogue: 0,0:55:11.80,0:55:15.93,Default 2,,0,0,0,,أجل، لقد كنت مسؤولةً عن رفع\N...وخفض اللوحة
Dialogue: 0,0:55:15.98,0:55:17.94,Default 2,,0,0,0,,ماذا عن عقد اللؤلؤ
Dialogue: 0,0:55:17.98,0:55:22.77,Default 2,,0,0,0,,قالت أنه كان هديةً من شخصٍ ما\N...ولكن لا أعرف من
Dialogue: 0,0:55:22.82,0:55:24.69,Default 2,,0,0,0,,متى تم إحضار هذه الصورة إلى هنا؟
Dialogue: 0,0:55:24.73,0:55:30.32,Default 2,,0,0,0,,البارحة\Nأنا أحضرتها إلى هنا بحضور السيد [كيساراجي]
Dialogue: 0,0:55:30.36,0:55:34.58,Default 2,,0,0,0,,مما يعني أن سلك البيانو\N...كان من السهل تركيبه بواسطة
Dialogue: 0,0:55:34.62,0:55:36.58,Default 2,,0,0,0,,أخشى أني لا أعلم عما تتحدثون
Dialogue: 0,0:55:36.62,0:55:39.00,Default 2,,0,0,0,,بالتفكير في الأمر يا سيد [كيساراجي]
Dialogue: 0,0:55:39.00,0:55:42.25,Default 2,,0,0,0,,سمعت أنك كنت غاضبًا\Nلأن الآنسة [ميو] اشترت كل لوحاتك
Dialogue: 0,0:55:42.29,0:55:44.80,Default 2,,0,0,0,,وباعتها بسعرٍ باهظ
Dialogue: 0,0:55:44.84,0:55:48.88,Default 2,,0,0,0,,أشك وبشدةٍ أن يكون هذا\N!دافعًا في قتل أحدهم
Dialogue: 0,0:55:48.88,0:55:55.89,Default 2,,0,0,0,,ولكن حسب ما قلته سابقًا\N...يبدو أن تلك جرائم متسلسلة
Dialogue: 0,0:55:55.89,0:56:04.02,Default 2,,0,0,0,,إذا كان الأمر كذلك ولأني أملك حجة غيابٍ\Nللجريمة الثانية، فلا يمكن أن يكون ذلك أنا
Dialogue: 0,0:56:04.02,0:56:07.61,Default 2,,0,0,0,,إننا لم نُرِ السيد [كيساراجي] كوبي "الأو-شوكو" الأخيرين
Dialogue: 0,0:56:07.65,0:56:11.61,Default 2,,0,0,0,,لذا فمن المستحيل أن يعرف أن عليه ترك\Nواحدٍ مماثل هنا ليخدعنا
Dialogue: 0,0:56:11.66,0:56:13.45,Default 2,,0,0,0,,...أنا
Dialogue: 0,0:56:13.49,0:56:14.83,Default 2,,0,0,0,,مباشرةً بعد انطفاء الأضواء
Dialogue: 0,0:56:14.87,0:56:19.37,Default 2,,0,0,0,,أحسست بأحدهم يقترب من\Nالآنسة [ميو] ويقول شيئًا
Dialogue: 0,0:56:19.41,0:56:22.71,Default 2,,0,0,0,,!حقًا؟ -\N!أكان رجلًا أم امرأة؟ -
Dialogue: 0,0:56:22.71,0:56:26.34,Default 2,,0,0,0,,...لقد شممت نفحة من العطر
Dialogue: 0,0:56:26.38,0:56:28.59,Default 2,,0,0,0,,!أجل\N!أنا تكلمت معها
Dialogue: 0,0:56:28.59,0:56:33.39,Default 2,,0,0,0,,...ولكنني ذهبت لأتأكد منها عن بعض الأشياء
Dialogue: 0,0:56:33.43,0:56:34.47,Default 2,,0,0,0,,!وجدتها
Dialogue: 0,0:56:34.51,0:56:37.31,Default 2,,0,0,0,,!أيها المفتش\N!لقد عرفت الفاعل
Dialogue: 0,0:56:37.35,0:56:39.48,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:56:39.52,0:56:44.65,Default 2,,0,0,0,,!القاتل هو أنت آنسة [ساواجوتشي شينامي]
Dialogue: 0,0:56:44.69,0:56:47.48,Default 2,,0,0,0,,!لا! كيف يمكنك قول شيءٍ كهذا؟
Dialogue: 0,0:56:47.53,0:56:49.32,Default 2,,0,0,0,,آنسة [ساواجوتشي]
Dialogue: 0,0:56:49.36,0:56:53.41,Default 2,,0,0,0,,قيل لي أن والدك كان صحفيًا\Nذو حسٍ عادل
Dialogue: 0,0:56:53.41,0:56:58.04,Default 2,,0,0,0,,وكان دائمًا يسعى خلف أفعال السياسيين الخاطئة
Dialogue: 0,0:56:58.08,0:57:01.41,Default 2,,0,0,0,,بعد وفاته، ذهبت إلى العمل\Nلصالح [توكيوا]
Dialogue: 0,0:57:01.41,0:57:03.42,Default 2,,0,0,0,,وأصبحتِ سكرتيرة الرئيس
Dialogue: 0,0:57:03.42,0:57:06.46,Default 2,,0,0,0,,وبينما كانت أعمال بناء البرجين التوأمين ماضية
Dialogue: 0,0:57:06.50,0:57:08.96,Default 2,,0,0,0,,من شأن الأفعال الخاطئة أن تحدث أيضًا
Dialogue: 0,0:57:09.00,0:57:13.47,Default 2,,0,0,0,,الآنسة [ميو] والسيد [هارا]\Nاجتمعا وسلما عضو المجلس [أوكي] المال
Dialogue: 0,0:57:13.51,0:57:17.51,Default 2,,0,0,0,,وطلبوا منه إعادة النظر في مرسوم المدينة للبناء
Dialogue: 0,0:57:17.56,0:57:21.85,Default 2,,0,0,0,,وكونك ورثت شخصية أبيكِ\Nلم تستطيعي التهاون في ذلك
Dialogue: 0,0:57:21.89,0:57:24.69,Default 2,,0,0,0,,!لذلك قتلتي ثلاثتهم
Dialogue: 0,0:57:24.73,0:57:27.69,Default 2,,0,0,0,,!لا
Dialogue: 0,0:57:27.73,0:57:29.40,Default 2,,0,0,0,,{\i0}ولكن يا [موري]{\i0}
Dialogue: 0,0:57:29.44,0:57:32.40,Default 2,,0,0,0,,لقد ظننت أنه لا صلة بينها
Dialogue: 0,0:57:32.45,0:57:35.49,Default 2,,0,0,0,,وبين أكواب "الأو-شوكو" المتروكة في كل جريمة
Dialogue: 0,0:57:35.49,0:57:40.37,Default 2,,0,0,0,,!لا أيها المفتش\N!أو-شوكو" تُكتب كما تكتب كلمة فم الخنزير"
Dialogue: 0,0:57:40.41,0:57:44.37,Default 2,,0,0,0,,الآنسة [ساواجوتشي] ولدت في سنة الخنزير
Dialogue: 0,0:57:44.42,0:57:47.79,Default 2,,0,0,0,,!وتحمل كلمة فم في اسمها
Dialogue: 0,0:57:47.84,0:57:54.84,Default 2,,0,0,0,,باختصارٍ قد تركت "الأو-شوكو" المحطم في الساحة كرسالة
Dialogue: 0,0:57:54.84,0:57:59.05,Default 2,,0,0,0,,على الغضب العارم\N!الذي ورثته من أبيها
Dialogue: 0,0:57:59.10,0:58:01.81,Default 2,,0,0,0,,!ذلك عبقري
Dialogue: 0,0:58:01.81,0:58:04.27,Default 2,,0,0,0,,!كلها أمورٌ منطقية، وأنت لست نائمًا حتى
Dialogue: 0,0:58:07.44,0:58:12.69,Default 2,,0,0,0,,هذا ليس إلا ادّعاء يبدو عليه الصواب
Dialogue: 0,0:58:12.69,0:58:13.82,Default 2,,0,0,0,,!ماذا تقول؟
Dialogue: 0,0:58:13.82,0:58:17.07,Default 2,,0,0,0,,!بالنهاية، ذلك الكوب الأخير لم ينكسر
Dialogue: 0,0:58:17.11,0:58:19.41,Default 2,,0,0,0,,...لو أرادت التعبير عن غضبها العارم
Dialogue: 0,0:58:19.45,0:58:22.08,Default 2,,0,0,0,,!اخرس يا هذا
Dialogue: 0,0:58:24.96,0:58:26.46,Default 2,,0,0,0,,!ذلك مؤلم
Dialogue: 0,0:58:26.50,0:58:28.46,Default 2,,0,0,0,,يبد أنك تحظى بوقتٍ عصيب
Dialogue: 0,0:58:28.50,0:58:30.92,Default 2,,0,0,0,,!إذا كنتِ تعرفين شيئًا أخبريني به
Dialogue: 0,0:58:30.96,0:58:32.51,Default 2,,0,0,0,,لا أعلم
Dialogue: 0,0:58:32.55,0:58:37.43,Default 2,,0,0,0,,كل ما أستطيع قوله هو أن الآنسة [ميو]\Nكانت حتمًا ثملةً جدًا في هذا الوقت
Dialogue: 0,0:58:37.47,0:58:38.84,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:58:38.89,0:58:42.22,Default 2,,0,0,0,,بخلاف ذلك، ألا تظن أنها كانت لتلاحظ\Nعندما تم
Dialogue: 0,0:58:42.22,0:58:44.85,Default 2,,0,0,0,,توصيل سلك البيانو بعقدها؟
Dialogue: 0,0:58:50.15,0:58:55.07,Thoughts,,0,0,0,,{\i0}!لؤلؤة! ماذا تفعل هذه هنا؟{\i0}
Dialogue: 0,0:58:55.07,0:58:57.99,Thoughts,,0,0,0,,{\1}!مهلًا! أيمكن أن يكون...؟{\i0}
Dialogue: 0,0:58:58.03,0:59:01.12,Default 2,,0,0,0,,!سيد [كازاما]\N!أنا لم أقم بأي شيء، أليس كذلك؟
Dialogue: 0,0:59:01.16,0:59:04.70,Default 2,,0,0,0,,...لا، لقد كان الظلام دامسًا فلم أر شيئًا
Dialogue: 0,0:59:04.75,0:59:07.37,Thoughts,,0,0,0,,{\i0}...إذا كان هذا الشخص هو القالت فإن{\i0}
Dialogue: 0,0:59:23.10,0:59:27.52,Thoughts,,0,0,0,,{\i0}!الآن فهمت! ذلك كان الدافع{\i0}
Dialogue: 0,0:59:27.56,0:59:30.19,Thoughts,,0,0,0,,{\1}...ولكن إن كان الأمر كذلك فإن تلك الحادثة{\i0}
Dialogue: 0,0:59:38.86,0:59:44.58,Thoughts,,0,0,0,,{\i0}!إذًا فهذا ما كان يعنيه{\i0}
Dialogue: 0,0:59:44.58,0:59:46.50,Thoughts,,0,0,0,,{\1}!لقد فهمت كل شيء{\i0}
Dialogue: 0,0:59:46.54,0:59:50.00,Thoughts,,0,0,0,,{\i0}!الصورة الكاملة للأحداث الثلاثة الغامضة{\i0}
Dialogue: 0,1:00:10.94,1:00:12.90,Default 2,,0,0,0,,!ما هذا؟
Dialogue: 0,1:00:21.74,1:00:24.87,Default 2,,0,0,0,,!ما هذا الاهتزاز؟ -\N!زلزال؟ -
Dialogue: 0,1:00:24.91,1:00:27.87,Default 2,,0,0,0,,!ما الذي يحدث؟
Dialogue: 0,1:00:27.91,1:00:29.66,Default 2,,0,0,0,,انفجار!؟ -\N!ماذا؟ -
Dialogue: 0,1:00:29.71,1:00:30.58,Default 2,,0,0,0,,!بأي مكان؟
Dialogue: 0,1:00:30.62,1:00:35.67,Default 2,,0,0,0,,"غرفة الكهرباء "الدور 4\N!والطابق الأربعون في حجرة الحاسوب
Dialogue: 0,1:00:35.67,1:00:38.05,Default 2,,0,0,0,,!حجرة الحاسوب؟\N!ماذا؟ -
Dialogue: 0,1:00:38.09,1:00:41.68,Default 2,,0,0,0,,!سيد [كازاما]! حاسوب [توكيوا] الرئيسي هناك
Dialogue: 0,1:00:41.72,1:00:44.09,Default 2,,0,0,0,,!كل المعلومات المهمة سيتم تدميرها
Dialogue: 0,1:00:44.14,1:00:46.97,Default 2,,0,0,0,,!لقد نشب حريقٌ في مؤخر الطابق الأربعون
Dialogue: 0,1:00:47.01,1:00:49.56,Default 2,,0,0,0,,!رجاءً أخلوا المبنى فورًا
Dialogue: 0,1:00:49.60,1:00:50.93,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,1:00:50.98,1:00:54.31,Default 2,,0,0,0,,!أيها المفتش\N!يبدو أنه يجدر بنا إخلاء المبنى حالًا
Dialogue: 0,1:00:54.31,1:00:59.15,Default 2,,0,0,0,,إذا كانت غرفة الكهرباء قد انفجرت\N! فلابد أن إمدادات الطاقة في حالة الطوارئ قد انقطعت أيضًا
Dialogue: 0,1:00:59.19,1:01:01.61,Default 2,,0,0,0,,!إذًا فلن تعمل المصاعد أيضًا؟
Dialogue: 0,1:01:01.65,1:01:02.86,Default 2,,0,0,0,,لا
Dialogue: 0,1:01:02.86,1:01:06.70,Default 2,,0,0,0,,!مهلًا\N!مصعد الرصد قد يعمل
Dialogue: 0,1:01:06.70,1:01:07.83,Default 2,,0,0,0,,!حقًا؟
Dialogue: 0,1:01:07.87,1:01:10.83,Default 2,,0,0,0,,له مصدر طاقةٍ مختلف في حال أرادت\N!الشخصيات الهامة الإخلاء
Dialogue: 0,1:01:14.83,1:01:16.59,Default 2,,0,0,0,,!إنه يعمل
Dialogue: 0,1:01:16.63,1:01:19.05,Default 2,,0,0,0,,ما هي سعته القصوى؟ -\Nتسع راشدين -
Dialogue: 0,1:01:19.09,1:01:21.67,Default 2,,0,0,0,,سيستغرق ذلك كثيرًا من الوقت\N!لإخراج الجميع
Dialogue: 0,1:01:21.72,1:01:23.80,Default 2,,0,0,0,,!هل هناك أي طرق خروج أخرى؟
Dialogue: 0,1:01:23.84,1:01:26.14,Default 2,,0,0,0,,إذا ما استقليت سلالم الطوارئ\Nحتى الطابق الستين
Dialogue: 0,1:01:26.18,1:01:29.35,Default 2,,0,0,0,,فيمكنك عبور الجسر لتعبر\N!"إلى البرج "ب
Dialogue: 0,1:01:29.35,1:01:33.73,Default 2,,0,0,0,,!حسنًا\N!النساء، الأطفال وكبار السن سيستقلون المصعد لأسفل
Dialogue: 0,1:01:33.77,1:01:36.73,Default 2,,0,0,0,,كل من غير ذلك سيستقلون\N!سلالم الطوارئ
Dialogue: 0,1:02:00.42,1:02:01.80,Default 2,,0,0,0,,!ما الموقف؟
Dialogue: 0,1:02:01.84,1:02:06.76,Default 2,,0,0,0,,انفجرت غرفة الكهرباء\N!ورشاشات المياه لا تعمل
Dialogue: 0,1:02:06.80,1:02:09.01,Default 2,,0,0,0,,!أبواب الحريق؟ -\N!مغلقة -
Dialogue: 0,1:02:09.05,1:02:11.97,Default 2,,0,0,0,,هل يمكننا الوصول إلى ذلك الجسر\N!من البرج "ب"؟
Dialogue: 0,1:02:12.02,1:02:13.39,Default 2,,0,0,0,,!هناك مصعدٌ مباشر إلى هناك
Dialogue: 0,1:02:13.39,1:02:17.23,Default 2,,0,0,0,,حسنًا! الفريقين "أ" و"ب" يذهبا\N!إلى غرفة الكهرباء
Dialogue: 0,1:02:17.23,1:02:20.19,Default 2,,0,0,0,,الفريق "ج" وأنا سوف نعبر الجسر من المبنى الآخر
Dialogue: 0,1:02:20.23,1:02:21.65,Default 2,,0,0,0,,!وسنذهب إلى الطابق الأربعين
Dialogue: 0,1:02:21.69,1:02:22.99,Default 2,,0,0,0,,!علم
Dialogue: 0,1:02:25.70,1:02:27.28,Default 2,,0,0,0,,!هيا يا [كونان]
Dialogue: 0,1:02:27.28,1:02:29.28,Default 2,,0,0,0,,اصعدي أنتِ أولا يا [ران]
Dialogue: 0,1:02:29.32,1:02:30.62,Default 2,,0,0,0,,!فقط اذهب
Dialogue: 0,1:02:34.00,1:02:35.79,Default 2,,0,0,0,,!تجاوز المصعد الوزن المسموح
Dialogue: 0,1:02:35.83,1:02:36.83,Default 2,,0,0,0,,{\1}![كونان]{\i0}
Dialogue: 0,1:02:36.87,1:02:39.71,Default 2,,0,0,0,,!سأكون بخير\N!سأستقل المصعد التالي
Dialogue: 0,1:02:39.75,1:02:41.71,Default 2,,0,0,0,,!رجاءً اذهبوا الآن
Dialogue: 0,1:02:43.30,1:02:47.18,Default 2,,0,0,0,,النساء الباقيات، [كونان] والسيد [كيساراجي]
Dialogue: 0,1:02:47.22,1:02:49.22,Default 2,,0,0,0,,!سيستقلون المصعد التالي لأسفل
Dialogue: 0,1:02:49.26,1:02:52.68,Default 2,,0,0,0,,سأستخدم السلالم
Dialogue: 0,1:02:52.72,1:02:55.81,Default 2,,0,0,0,,ولكن، ألست...؟
Dialogue: 0,1:02:55.85,1:02:57.90,Default 2,,0,0,0,,!لا تعاملني كهَرم
Dialogue: 0,1:02:57.94,1:03:00.69,Default 2,,0,0,0,,!حسنًا! كما تشاء
Dialogue: 0,1:03:00.73,1:03:03.19,Default 2,,0,0,0,,حسنًا يا سيد [كازاما]\Nرجاءً انطلق
Dialogue: 0,1:03:03.23,1:03:09.32,Default 2,,0,0,0,,!حسنًا جميعًا\N!سأقود الطريق! رجاءً اتبعوني
Dialogue: 0,1:03:09.36,1:03:13.99,Default 2,,0,0,0,,[شيراتوري]، أنتم اذهبوا أيضًا\Nسأوافيكم لاحقًا
Dialogue: 0,1:03:14.04,1:03:15.70,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,1:03:15.75,1:03:17.71,Default 2,,0,0,0,,...بروفيسور، أكره السؤال ولكن
Dialogue: 0,1:03:19.00,1:03:20.63,Default 2,,0,0,0,,حسنًا، لقد فهمت
Dialogue: 0,1:03:24.84,1:03:26.17,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,1:03:28.93,1:03:30.22,Default 2,,0,0,0,,!آسفة
Dialogue: 0,1:03:32.89,1:03:34.77,Default 2,,0,0,0,,!تفضلي -\N...ولكن -
Dialogue: 0,1:03:34.81,1:03:36.06,Default 2,,0,0,0,,!سنكون بخير
Dialogue: 0,1:03:36.10,1:03:40.73,Default 2,,0,0,0,,سنستخدم الجسر بالطابق الستين\N!لنذهب إلى المبنى المجاور
Dialogue: 0,1:03:40.77,1:03:43.48,Default 2,,0,0,0,,!نراكِ في الأسفل
Dialogue: 0,1:03:43.48,1:03:46.49,Default 2,,0,0,0,,!هيا الآن
Dialogue: 0,1:03:46.49,1:03:47.82,Default 2,,0,0,0,,!شكرًا لكم يا أطفال
Dialogue: 0,1:03:51.53,1:03:55.20,Default 2,,0,0,0,,!لا، إنه ظلامٌ دامس\N!لا أستطيع رؤية مكان أي شيء
Dialogue: 0,1:03:55.20,1:04:00.37,Default 2,,0,0,0,,ماذا الآن؟ لقد أعطيناهم\N...ساعاتنا المزودة بمصابيح سابقًا
Dialogue: 0,1:04:00.42,1:04:03.96,Default 2,,0,0,0,,!هذا سيئ
Dialogue: 0,1:04:04.00,1:04:08.38,Default 2,,0,0,0,,بصراحة، كان عليكم أن تفكروا\Nبذلك قبل أن تنزلوا
Dialogue: 0,1:04:08.38,1:04:12.85,Default 2,,0,0,0,,!صحيح! أنت و[كونان] لم تشاركا باللعبة
Dialogue: 0,1:04:12.89,1:04:14.51,Default 2,,0,0,0,,!فلنسرع إذًا
Dialogue: 0,1:04:14.51,1:04:19.18,Default 2,,0,0,0,,مهلًا\Nألا يمكننا انتظار المصعد القادم فقط؟
Dialogue: 0,1:04:19.23,1:04:22.77,Default 2,,0,0,0,,أيها الأحمق، سيكون التالي مليئ أيضًا
Dialogue: 0,1:04:22.81,1:04:25.44,Default 2,,0,0,0,,!على كل حال، فلنسرع إلى الطابق الستين
Dialogue: 0,1:04:54.43,1:04:55.76,Default 2,,0,0,0,,!ها نحن ذا
Dialogue: 0,1:05:06.44,1:05:09.82,Thoughts,,0,0,0,,{i1}مقدار وتوقيت تلك الانفجارات كان مخططًا{\i0}
Dialogue: 0,1:05:09.86,1:05:14.82,Thoughts,,0,0,0,,{\i0}أيعقل أن يكون الرجال ذوي الملابس السوداء\N!هم من وضعوا القنبلة؟{\i0}
Dialogue: 0,1:05:14.87,1:05:19.24,Thoughts,,0,0,0,,{\i0}إذا كان الأمر كذلك، فأستطيع أن أعي لم فجروا\N...غرفة الحاسوب{\i0}
Dialogue: 0,1:05:19.24,1:05:20.58,Thoughts,,0,0,0,,{\1}ولكن لم غرفة الكهرباء؟{\i0}
Dialogue: 0,1:05:23.33,1:05:24.63,Default 2,,0,0,0,,!اصعدوا من فضلكم
Dialogue: 0,1:05:26.92,1:05:30.51,Default 2,,0,0,0,,أنت أيضًا آنسة [تشينامي]\Nيمكننا التحدث بالتفصيل لاحقًا
Dialogue: 0,1:05:30.55,1:05:31.84,Default 2,,0,0,0,,حسنًا
Dialogue: 0,1:05:48.57,1:05:53.53,Thoughts,,0,0,0,,{\1}ليمنعوا رشاشات المياه من العمل؟ أم لسببٍ آخر؟{\i0}
Dialogue: 0,1:05:53.57,1:05:58.03,Default 2,,0,0,0,,!من الجيد أن ذلك المصعد له مصدر الطاقة الخاص به
Dialogue: 0,1:05:58.08,1:06:01.37,Default 2,,0,0,0,,!وإلا كان سيتوجب علينا نزول السلم كله
Dialogue: 0,1:06:03.41,1:06:04.71,Thoughts,,0,0,0,,{\1}!أيمكن هذا؟{\i0}
Dialogue: 0,1:06:13.92,1:06:15.22,Thoughts,,0,0,0,,{\1}!جين{\i0}
Dialogue: 0,1:06:31.36,1:06:34.82,Default 2,,0,0,0,,!ارقدي بسلامٍ يا [شيري]
Dialogue: 0,1:06:37.70,1:06:40.16,Default 2,,0,0,0,,!آنسة [سونوكو]\N!ملابسك الداخلية ظاهرة
Dialogue: 0,1:06:46.25,1:06:49.04,Default 2,,0,0,0,,!ماذا؟! ماذا؟\N!لم توقفنا؟
Dialogue: 0,1:06:52.25,1:06:55.22,Default 2,,0,0,0,,أيعقل أنها شخصٌ آخر؟
Dialogue: 0,1:06:55.26,1:06:59.55,Thoughts,,0,0,0,,{\1}لقد اختفى مؤشر الليزر! هل يمكن أن يكون\N!قد اكتشف أنه الشخص الخطأ؟{\i0}
Dialogue: 0,1:07:12.73,1:07:14.61,Default 2,,0,0,0,,!لا فائدة من ذلك\N!لن يتحرك
Dialogue: 0,1:07:14.65,1:07:16.95,Default 2,,0,0,0,,![ران]، ارفعيني على كتفيك\N!ماذا؟ حسنًا -
Dialogue: 0,1:07:27.58,1:07:29.21,Default 2,,0,0,0,,!ها أنت ذا
Dialogue: 0,1:07:31.75,1:07:33.71,Default 2,,0,0,0,,{\1}!دعني أفعل ذلك يا [كونان]{\i0}
Dialogue: 0,1:07:39.72,1:07:41.64,Default 2,,0,0,0,,!يمكنك فعلها يا [ران]
Dialogue: 0,1:07:41.68,1:07:42.97,Default 2,,0,0,0,,!رجاءً
Dialogue: 0,1:07:48.02,1:07:49.31,Default 2,,0,0,0,,!عملٌ رائعٌ يا [ران]
Dialogue: 0,1:08:03.24,1:08:06.75,Default 2,,0,0,0,,أي طابقٍ هذا؟ -\Nإنه الخامس والأربعون -
Dialogue: 0,1:08:06.75,1:08:09.37,Default 2,,0,0,0,,!ذلك الطابق به جسر
Dialogue: 0,1:08:09.41,1:08:11.04,Default 2,,0,0,0,,!لا! دخان
Dialogue: 0,1:08:13.38,1:08:16.17,Default 2,,0,0,0,,!لنعبر الجسر بسرعةٍ إلى المبنى الثاني
Dialogue: 0,1:08:22.09,1:08:24.05,Default 2,,0,0,0,,هذا أنا\Nهل حالفك الحظ هناك؟
Dialogue: 0,1:08:26.10,1:08:29.06,Default 2,,0,0,0,,لا، الرجال فقط هم من يعبرون
Dialogue: 0,1:08:32.52,1:08:36.11,Default 2,,0,0,0,,على الأرجح بقيت في الأعلى\Nعندما عرفت ما نسعى إليه
Dialogue: 0,1:08:36.11,1:08:39.15,Default 2,,0,0,0,,ولكنها لن تهرب
Dialogue: 0,1:08:39.15,1:08:41.07,Default 2,,0,0,0,,!أسقط الجسور
Dialogue: 0,1:08:41.11,1:08:44.07,Default 2,,0,0,0,,!يمكننا العبور جميعًا إلى المبنى الآخر من هنا
Dialogue: 0,1:08:53.13,1:08:55.42,Default 2,,0,0,0,,!انظروا\N!ها هو الجسر
Dialogue: 0,1:09:05.47,1:09:07.43,Default 2,,0,0,0,,{\1}!احترس يا [كونان]{\i0}
Dialogue: 0,1:09:20.24,1:09:24.07,Default 2,,0,0,0,,!ماذا حدث؟ -\N!لقد سقط الجسر -
Dialogue: 0,1:09:24.11,1:09:26.70,Default 2,,0,0,0,,!سيد [موري]\N!مصعد الرصد متوقف
Dialogue: 0,1:09:26.70,1:09:27.99,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:09:30.12,1:09:31.41,Default 2,,0,0,0,,![ران]
Dialogue: 0,1:09:39.59,1:09:42.63,Default 2,,0,0,0,,![ران]\N!هل أنت بخير؟
Dialogue: 0,1:09:42.67,1:09:46.43,Default 2,,0,0,0,,!نحن بخير
Dialogue: 0,1:09:46.47,1:09:48.35,Default 2,,0,0,0,,ماذا نفعل الآن يا [كونان]؟
Dialogue: 0,1:09:48.35,1:09:51.10,Default 2,,0,0,0,,!هذا سيئ! لقد قُطعت طرق هروبنا كلها
Dialogue: 0,1:09:51.14,1:09:51.77,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:09:51.81,1:09:53.77,Default 2,,0,0,0,,!الناحية الأخرى من باب الحريق ممتلئة بالدخان
Dialogue: 0,1:09:58.27,1:09:59.23,Default 2,,0,0,0,,...لا
Dialogue: 0,1:10:05.16,1:10:06.45,Default 2,,0,0,0,,ماذا الآن؟
Dialogue: 0,1:10:08.33,1:10:10.24,Default 2,,0,0,0,,لقد نفذت البطارية
Dialogue: 0,1:10:10.29,1:10:14.25,Default 2,,0,0,0,,من الخطير التصرف بتهور\Nلننتظر المساعدة
Dialogue: 0,1:10:18.17,1:10:19.63,Default 2,,0,0,0,,هل أنت بخيرٍ يا [كونان]؟
Dialogue: 0,1:10:34.27,1:10:36.23,Default 2,,0,0,0,,![ران]! أنت لا تفكرين في...؟
Dialogue: 0,1:10:37.44,1:10:40.40,Default 2,,0,0,0,,لا أعلم ما إذا كانت ستنجح كما بالأفلام\N...ولكن
Dialogue: 0,1:10:42.65,1:10:44.61,Default 2,,0,0,0,,!تمسك جيدًا يا [كونان]
Dialogue: 0,1:10:53.20,1:10:54.62,Default 2,,0,0,0,,!إنها الآنسة [ران]
Dialogue: 0,1:10:54.66,1:10:56.62,Default 2,,0,0,0,,!ماذا؟\N!أعطني هؤلاء
Dialogue: 0,1:10:59.92,1:11:02.21,Default 2,,0,0,0,,!ماذا تنوي أن تفعل؟
Dialogue: 0,1:11:16.39,1:11:19.60,Default 2,,0,0,0,,[ران]، ألست خائفة؟
Dialogue: 0,1:11:19.60,1:11:21.61,Default 2,,0,0,0,,!أنا خائفة
Dialogue: 0,1:11:21.65,1:11:27.61,Default 2,,0,0,0,,ولكنك معي\N...و[شينتشي] أخبرني أن أنتظره
Dialogue: 0,1:11:30.28,1:11:32.91,Default 2,,0,0,0,,يجدر بي العيش كي أتمكن من انتظاره
Dialogue: 0,1:11:37.91,1:11:42.29,Default 2,,0,0,0,,...[كونان]، أنا
Dialogue: 0,1:11:42.34,1:11:45.67,Default 2,,0,0,0,,!سيكون الأمر على ما يرام، يا [ران]
Dialogue: 0,1:11:45.67,1:11:48.97,Default 2,,0,0,0,,...أعرف كيف تشعرين، كم يؤلم ذلك
Dialogue: 0,1:12:25.46,1:12:27.42,Default 2,,0,0,0,,!لا! الخرطوم يحترق
Dialogue: 0,1:12:46.52,1:12:48.65,Default 2,,0,0,0,,!هل أنت بخيرٍ يا [كونان]؟
Dialogue: 0,1:12:48.65,1:12:51.65,Default 2,,0,0,0,,!أجل! إنك رائعةٌ يا [ران]
Dialogue: 0,1:12:56.33,1:12:57.45,Default 2,,0,0,0,,!سيد [موري]
Dialogue: 0,1:13:01.33,1:13:02.62,Default 2,,0,0,0,,![ران]
Dialogue: 0,1:13:03.63,1:13:06.29,Default 2,,0,0,0,,![سونوكو] -\N!حمدًا لله على سلامتك -
Dialogue: 0,1:13:06.34,1:13:08.30,Default 2,,0,0,0,,!يا إلهي\N!أكان عليكِ التصرف بجنون
Dialogue: 0,1:13:13.72,1:13:15.01,Default 2,,0,0,0,,!احترسوا
Dialogue: 0,1:13:18.01,1:13:19.97,Default 2,,0,0,0,,!انظروا! مصعد الرصد
Dialogue: 0,1:13:25.69,1:13:27.57,Default 2,,0,0,0,,!أيها البروفيسور\N!أين ذلك الشخص؟
Dialogue: 0,1:13:27.61,1:13:31.32,Default 2,,0,0,0,,!ماذا؟ آسف، لقد فقدته
Dialogue: 0,1:13:31.36,1:13:34.32,Default 2,,0,0,0,,!ولا أرى الأطفال أيضًا
Dialogue: 0,1:13:34.36,1:13:35.66,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:13:36.70,1:13:39.33,Default 2,,0,0,0,,![أيومي]، [غينتا]، [ميتسوهيكو]\N!أتسمعونني؟
Dialogue: 0,1:13:41.37,1:13:43.42,Default 2,,0,0,0,,!نسمعك يا [كونان]
Dialogue: 0,1:13:43.42,1:13:45.38,Default 2,,0,0,0,,!أين أنتم؟
Dialogue: 0,1:13:45.42,1:13:49.46,Default 2,,0,0,0,,...في الواقع أمام جسر الطابق الستون
Dialogue: 0,1:13:49.46,1:13:50.76,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:13:52.97,1:13:55.01,Default 2,,0,0,0,,!إنهم هناك بالأعلى؟
Dialogue: 0,1:13:55.05,1:13:57.51,Default 2,,0,0,0,,![تاكاغي] اتصل بمروحية انقاذ
Dialogue: 0,1:13:57.55,1:13:58.85,Default 2,,0,0,0,,!علم
Dialogue: 0,1:14:21.87,1:14:23.50,Default 2,,0,0,0,,!سيدي\N!سأستعير مصباحك
Dialogue: 0,1:14:23.54,1:14:24.83,Default 2,,0,0,0,,!توقف أيها الصغير
Dialogue: 0,1:14:28.13,1:14:29.13,Default 2,,0,0,0,,!ما هذا...؟
Dialogue: 0,1:14:29.13,1:14:31.55,Default 2,,0,0,0,,!هذا الصوت -\N!إنها زلاجته -
Dialogue: 0,1:14:31.59,1:14:32.88,Default 2,,0,0,0,,![كونان]؟
Dialogue: 0,1:14:46.48,1:14:47.56,Default 2,,0,0,0,,!كان ذلك مؤلمًا
Dialogue: 0,1:14:47.60,1:14:48.90,Default 2,,0,0,0,,!مذهل
Dialogue: 0,1:14:48.94,1:14:50.44,Default 2,,0,0,0,,!إنك رائع
Dialogue: 0,1:14:50.48,1:14:52.48,Default 2,,0,0,0,,!أنت منقذنا
Dialogue: 0,1:14:52.53,1:14:56.49,Default 2,,0,0,0,,!يا إلهي\N!ليس هذا وقت الانبهار
Dialogue: 0,1:14:59.03,1:14:59.95,Default 2,,0,0,0,,!ما هذا...؟
Dialogue: 0,1:14:59.99,1:15:02.49,Default 2,,0,0,0,,!لوح تزلج [كونان]
Dialogue: 0,1:15:02.54,1:15:05.91,Default 2,,0,0,0,,!لقد قفز [كونان] للتو عبر جسر الطابق الستين
Dialogue: 0,1:15:05.96,1:15:07.25,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:15:09.54,1:15:10.59,Default 2,,0,0,0,,![ميغوري] يتكلم
Dialogue: 0,1:15:10.63,1:15:13.42,Default 2,,0,0,0,,!أيها المفتش\N!سنتوجه إلى الأعلى
Dialogue: 0,1:15:13.46,1:15:14.96,Default 2,,0,0,0,,!دع المروحية تهبط فوق السطح
Dialogue: 0,1:15:15.01,1:15:16.97,Default 2,,0,0,0,,!سنتوجه"؟"\N!أين أنتم؟
Dialogue: 0,1:15:24.89,1:15:27.94,Default 2,,0,0,0,,صعود 15 طابق\N...إنه لأمر صعب
Dialogue: 0,1:15:27.98,1:15:30.86,Default 2,,0,0,0,,!تماسك يا [غينتا]\N!بالكاد وصلنا
Dialogue: 0,1:15:30.90,1:15:32.19,Default 2,,0,0,0,,...أجل
Dialogue: 0,1:15:35.78,1:15:37.70,Default 2,,0,0,0,,أنتم أكملوا يا رفاق
Dialogue: 0,1:15:37.70,1:15:40.03,Default 2,,0,0,0,,ماذا؟ إلى أين أنت ذاهبٌ يا [كونان]؟
Dialogue: 0,1:15:44.54,1:15:47.16,Default 2,,0,0,0,,!مهلًا! إلى أين أنت ذاهب؟ مهلًا
Dialogue: 0,1:15:48.83,1:15:50.08,Default 2,,0,0,0,,ما الأمر؟
Dialogue: 0,1:15:50.12,1:15:53.25,Default 2,,0,0,0,,!إنك تعرف [كونان]\N!لابد من أن لديه فكرة ما
Dialogue: 0,1:15:53.25,1:15:55.55,Default 2,,0,0,0,,!لنذهب إلى السطح
Dialogue: 0,1:15:57.26,1:15:59.22,Default 2,,0,0,0,,!دعوني أفكر لثانية
Dialogue: 0,1:16:11.90,1:16:13.15,Default 2,,0,0,0,,!ثمة أحد ما هنا
Dialogue: 0,1:16:13.19,1:16:15.82,Default 2,,0,0,0,,الشخص الذي قتل السيد [أوكي] وآنسة [ميو]
Dialogue: 0,1:16:19.86,1:16:22.95,Default 2,,0,0,0,,لقد قرر قتل الآنسة [ميو] لسببٍ معين
Dialogue: 0,1:16:22.95,1:16:25.95,Default 2,,0,0,0,,لذا أعطاها عقدًا من اللؤلؤ كهدية
Dialogue: 0,1:16:25.95,1:16:28.91,Default 2,,0,0,0,,قال لها أن ترتدي العقد\Nبحفلة الافتتاح
Dialogue: 0,1:16:28.96,1:16:32.29,Default 2,,0,0,0,,وتعرض اللوحة التى أهداها\Nإليها على المسرح
Dialogue: 0,1:16:32.29,1:16:34.25,Default 2,,0,0,0,,!...إذًا فالقاتل هو
Dialogue: 0,1:16:37.76,1:16:40.72,Default 2,,0,0,0,,...أجل، معلم الآنسة [ميو] للرسم
Dialogue: 0,1:16:43.22,1:16:45.18,Default 2,,0,0,0,,![كيساراجي هوسوي]
Dialogue: 0,1:16:57.90,1:16:59.69,Default 2,,0,0,0,,...حسبما أتذكر أنت
Dialogue: 0,1:16:59.74,1:17:03.62,Default 2,,0,0,0,,...[إيدوغاوا كونان]، متحر
Dialogue: 0,1:17:03.66,1:17:10.20,Default 2,,0,0,0,,العقد الذي أعطيته للآنسة [ميو]\Nكان مصنوعًا حتى لا يتم فكه بسهولة
Dialogue: 0,1:17:10.25,1:17:15.59,Default 2,,0,0,0,,وحضرت واحدًا آخر
Dialogue: 0,1:17:15.63,1:17:19.55,Default 2,,0,0,0,,وخلال الحفلة أخذت ذلك العقد الآخر
Dialogue: 0,1:17:19.59,1:17:21.55,Default 2,,0,0,0,,وربطته إلى خطاف سلك البيانو
Dialogue: 0,1:17:21.59,1:17:26.64,Default 2,,0,0,0,,المتدلي من لوحة جبل "فوجي" و المختفي\Nبين ثنايا الستار
Dialogue: 0,1:17:26.64,1:17:30.56,Default 2,,0,0,0,,ثم باستخدام الضوء على الأرض\Nمشيت نحو الآنسة [ميو]
Dialogue: 0,1:17:30.60,1:17:33.31,Default 2,,0,0,0,,وفككت عقدها
Dialogue: 0,1:17:33.31,1:17:38.69,Default 2,,0,0,0,,ثم قلت للآنسة [ميو] وهي مضطربة\N"لا بأس سأحضره لك"
Dialogue: 0,1:17:38.73,1:17:41.82,Default 2,,0,0,0,,...ثم وضعت العقد الآخر حول رقبتها
Dialogue: 0,1:17:41.82,1:17:45.57,Default 2,,0,0,0,,العقد المعلق بحبل البيانو...
Dialogue: 0,1:17:45.62,1:17:46.24,Default 2,,0,0,0,,...بمعنىً آخر
Dialogue: 0,1:17:46.28,1:17:50.24,Default 2,,0,0,0,,الخطاف لم يكن متصلًا بعقد الآنسة [ميو]
Dialogue: 0,1:17:50.29,1:17:53.96,Default 2,,0,0,0,,العقد كان يحمل خطافًا منذ البداية
Dialogue: 0,1:17:54.00,1:17:56.92,Default 2,,0,0,0,,لهذا لم تلحظ أبدًا
Dialogue: 0,1:17:56.96,1:18:03.84,Default 2,,0,0,0,,تلك اللؤلؤة التي وجدتها قد سقطت\Nعندما نزعت العقد الأول
Dialogue: 0,1:18:03.88,1:18:07.26,Default 2,,0,0,0,,كوب "الأو-شوكو" على المسرح\Nقد تُرك هناك عمدًا
Dialogue: 0,1:18:07.30,1:18:09.01,Default 2,,0,0,0,,ليبدو الأمر كما لو أنها جرائم متسلسلة
Dialogue: 0,1:18:09.06,1:18:13.60,Default 2,,0,0,0,,مهلًا، السيد [كيساراجي] لديه حجة غياب\Nفي مقتل السيد [هارا]
Dialogue: 0,1:18:13.64,1:18:18.61,Default 2,,0,0,0,,بالطبع لديه\Nلأنه ثمة آخر من قتل السيد [هارا]
Dialogue: 0,1:18:29.66,1:18:31.66,Default 2,,0,0,0,,!لقد وصل الحريق إلى الطابق السبعين
Dialogue: 0,1:18:31.66,1:18:34.00,Default 2,,0,0,0,,!بحقكم! أين مروحية الانقاذ؟
Dialogue: 0,1:18:34.04,1:18:36.04,Default 2,,0,0,0,,!سأتفقد الأمر يا سيدي
Dialogue: 0,1:18:36.08,1:18:37.38,Thoughts,,0,0,0,,{\i0}...[كونان]{\i0}
Dialogue: 0,1:18:38.71,1:18:41.21,Default 2,,0,0,0,,بتلك الليلة حين غادرنا
Dialogue: 0,1:18:41.25,1:18:45.38,Default 2,,0,0,0,,ذهبت إلى شقة السيد [هارا] لتقتله
Dialogue: 0,1:18:45.43,1:18:47.30,Thoughts,,0,0,0,,{\i0}...ولكن{\i0}
Dialogue: 0,1:18:47.34,1:18:51.43,Default 2,,0,0,0,,كان السيد [هارا] ميتًا بالفعل، أُطلق عليه النار
Dialogue: 0,1:18:51.43,1:18:55.31,Default 2,,0,0,0,,وقمت بالتفكير سريعًا\Nوجعلت الأمر يبدو كما لو أنه جريمةٌ متسلسلة
Dialogue: 0,1:18:55.35,1:18:58.94,Default 2,,0,0,0,,لتخلق لنفسك حجة غياب
Dialogue: 0,1:18:58.98,1:19:02.40,Default 2,,0,0,0,,لأنه في الجرائم المتسلسلة\Nإذا كانت لك حجة غيابٍ في أحد الحوادث
Dialogue: 0,1:19:02.40,1:19:04.99,Default 2,,0,0,0,,فأنت تخرج من دائرة الشبهات
Dialogue: 0,1:19:05.03,1:19:10.20,Default 2,,0,0,0,,لهذا كسرت الكوب هناك\Nتمامًا كما حدث مع السيد [أوكي]
Dialogue: 0,1:19:10.24,1:19:14.66,Default 2,,0,0,0,,وعندما فعلت ذلك، أوقعت بعض البقايا على\Nالدماء الجافة
Dialogue: 0,1:19:14.70,1:19:20.92,Default 2,,0,0,0,,ولهذا لم يكن هنالك دماء على البقايا\Nفي كيس أدلة السيد [تومي]
Dialogue: 0,1:19:20.92,1:19:25.30,Default 2,,0,0,0,,وفي صورة مسرح جريمة قتل السيد [أوكي] بالفندق
Dialogue: 0,1:19:25.34,1:19:29.14,Default 2,,0,0,0,,الجزء السفلي من الخزانة فقط كان عليه دماء
Dialogue: 0,1:19:29.18,1:19:34.14,Default 2,,0,0,0,,على الأرجح كان ذلك لأن لفيفة كنت قد رسمتها\Nكانت معلقةً هناك
Dialogue: 0,1:19:34.18,1:19:39.31,Default 2,,0,0,0,,أعطيت السيد [أوكي] تلك اللفيفة\Nكحجةٍ لتزور غرفته
Dialogue: 0,1:19:39.31,1:19:41.69,Default 2,,0,0,0,,وتنقض عليه من حيث لا يدري
Dialogue: 0,1:19:41.73,1:19:45.74,Default 2,,0,0,0,,تلك نظريةٌ مثيرة أيها المتحري الصغير
Dialogue: 0,1:19:45.78,1:19:47.74,Default 2,,0,0,0,,...ولكن ليس لنظريتك أي
Dialogue: 0,1:19:47.78,1:19:50.74,Default 2,,0,0,0,,لدي دليلٌ بالفعل\Nبداخل تلك العصا
Dialogue: 0,1:19:54.79,1:19:59.25,Default 2,,0,0,0,,العقد الأول الذي كان ترتديه الآنسة [ميو]\N!يجب ان يكون بالداخل
Dialogue: 0,1:20:12.39,1:20:16.43,Default 2,,0,0,0,,كيف عرفت أني خبأته هنا؟
Dialogue: 0,1:20:16.47,1:20:17.81,Default 2,,0,0,0,,الصوت
Dialogue: 0,1:20:17.81,1:20:23.48,Default 2,,0,0,0,,صوت العصا اختلف قليلًا\Nقبل وبعد موت الآنسة [ميو]
Dialogue: 0,1:20:23.48,1:20:25.44,Default 2,,0,0,0,,حقًا أذني متحرٍ
Dialogue: 0,1:20:31.36,1:20:33.32,Default 2,,0,0,0,,!ها هي آتية
Dialogue: 0,1:20:41.37,1:20:43.21,Default 2,,0,0,0,,ولكن ماذا كان الدافع؟
Dialogue: 0,1:20:43.25,1:20:46.84,Default 2,,0,0,0,,لأن الآنسة [ميو] قد اشترت لوحاته كلها\Nوباعتها بثمنٍ باهظ؟
Dialogue: 0,1:20:46.84,1:20:51.93,Default 2,,0,0,0,,لا، دافعه كان البرجين التوأمين على الأرجح
Dialogue: 0,1:20:51.97,1:20:56.81,Default 2,,0,0,0,,أما بالنسبة لسبب قتلك للسيد [أوكي]\N...ومحاولتك قتل السيد [هارا]
Dialogue: 0,1:20:56.85,1:21:00.27,Default 2,,0,0,0,,"في وقتٍ ما، كانت جميع لوحاتك لجبل "فوجي
Dialogue: 0,1:21:00.31,1:21:03.86,Default 2,,0,0,0,,كان لها نفس الزاوية والبنية
Dialogue: 0,1:21:03.86,1:21:06.44,Default 2,,0,0,0,,لقد رسمتها من نفس الموقع، أليس كذلك؟
Dialogue: 0,1:21:09.82,1:21:15.45,Default 2,,0,0,0,,من فوق تلةٍ وجدتها\N"على أطراف مدينة غرب "تاما
Dialogue: 0,1:21:15.49,1:21:20.79,Default 2,,0,0,0,,كنت أزرو تلك التلة لعقودٍ\Nلأرسم لوحاتي
Dialogue: 0,1:21:20.83,1:21:26.00,Default 2,,0,0,0,,ولكن كلما كنت أتقدم في العمر\Nتسلق التلة أصبح أصعب
Dialogue: 0,1:21:26.04,1:21:31.92,Default 2,,0,0,0,,لهذا منذ ثلاث سنوات\Nاشتريت التلة بأكملها وبنيت منزلًا هناك
Dialogue: 0,1:21:31.97,1:21:35.14,Default 2,,0,0,0,,"حتى أستطيع رسم جبل "فوجي\Nلبقية حياتي
Dialogue: 0,1:21:35.18,1:21:40.93,Default 2,,0,0,0,,بنيت ورشتي في أفضل موقع
Dialogue: 0,1:21:40.98,1:21:48.11,Default 2,,0,0,0,,من تلك النافذة\N"كان لدي مدى رؤية كبير لجبل "فوجي
Dialogue: 0,1:21:48.15,1:21:51.44,Default 2,,0,0,0,,!ثم دمرته تلك المرأة
Dialogue: 0,1:22:01.45,1:22:06.83,Default 2,,0,0,0,,إذًا فهل يعني ذلك أن تلك الأكواب المكسورة\Nكانت تمثل جبل "فوجي"؟
Dialogue: 0,1:22:06.88,1:22:08.84,Default 2,,0,0,0,,أجل، كانت رسالة غضبه
Dialogue: 0,1:22:08.88,1:22:12.97,Default 2,,0,0,0,,بأن البرجين التوأمين قد قسما\Nجبل "فوجي" إلى نصفين
Dialogue: 0,1:22:13.01,1:22:17.30,Default 2,,0,0,0,,ولكن الكوب لم يتم كسره\N!عندما قُتلت الآنسة [ميو]
Dialogue: 0,1:22:17.35,1:22:20.89,Default 2,,0,0,0,,تُرك هذا لجعل الأمر يبدو كجريمةٍ متسلسلة
Dialogue: 0,1:22:20.93,1:22:23.85,Default 2,,0,0,0,,ولكن لم يكن هناك داعٍ من ترك الرسالة هناك
Dialogue: 0,1:22:23.89,1:22:28.98,Default 2,,0,0,0,,لأن الآنسة [ميو] كانت قد قسمت\Nلوحة جبل "فوجي" إلى نصفين بالفعل
Dialogue: 0,1:22:29.02,1:22:32.15,Default 2,,0,0,0,,بما أن العقد قد انكشف أمره كدليل
Dialogue: 0,1:22:32.15,1:22:35.11,Default 2,,0,0,0,,فلن أستطيع التملص من الأمر بالكلام
Dialogue: 0,1:22:49.21,1:22:53.51,Default 2,,0,0,0,,عذرًا\Nكمتحرٍ لا أستطيع أن أسمح لك بالموت
Dialogue: 0,1:22:57.05,1:23:00.01,Default 2,,0,0,0,,!هنا بالأسفل
Dialogue: 0,1:23:00.97,1:23:05.48,Default 2,,0,0,0,,كيف عرفت بأمر دافع [كيساراجي هوسوي]؟
Dialogue: 0,1:23:05.52,1:23:09.56,Default 2,,0,0,0,,لقد كان الأمر يزعجني منذ\Nذهبنا إلى منزله
Dialogue: 0,1:23:09.61,1:23:11.94,Default 2,,0,0,0,,"عندما وصلنا إلى محطة "أساهينو
Dialogue: 0,1:23:11.94,1:23:16.36,Default 2,,0,0,0,,رأيت أن البرجين التوأمين\Nقد قسما جبل "فوجي" خلف [ميتسوهيكو]
Dialogue: 0,1:23:16.36,1:23:20.32,Default 2,,0,0,0,,ومنزل السيد [كيساراجي]\Nكان بالاتجاه المعاكس تمامًا
Dialogue: 0,1:23:20.37,1:23:25.50,Default 2,,0,0,0,,ولكن النافذة الكبيرة بورشته\Nكانت مغطاةً بالستائر
Dialogue: 0,1:23:25.54,1:23:31.96,Default 2,,0,0,0,,إذًا فهو لم يكن يريد ان يرى الناس\N...أن إطلالته على جبل "فوجي" قد عُرقلت
Dialogue: 0,1:23:31.96,1:23:36.05,Default 2,,0,0,0,,ولكن هناك شيءٌ آخر -\Nقاتل السيد [هارا]، أليس كذلك؟ -
Dialogue: 0,1:23:36.09,1:23:41.18,Default 2,,0,0,0,,أعتقد أن ماحدث كان كالتالي\Nكان يحمل سكينًا فضية
Dialogue: 0,1:23:41.18,1:23:44.68,Default 2 - up,,0,0,0,,"باليابانية، "فضي" تلفظ "غين\N"وتكتب "جـ ـيـ ـن
Dialogue: 0,1:23:44.72,1:23:46.18,Default 2 - up,,0,0,0,,انظري
Dialogue: 0,1:23:46.23,1:23:51.36,Default 2 - up,,0,0,0,,عندما تكون كلمة "غين" على زجاجة شراب\Nتنطق بشكلٍ مختلف
Dialogue: 0,1:23:51.36,1:23:52.69,Default 2,,0,0,0,,![جين]
Dialogue: 0,1:23:56.65,1:24:00.28,Default 2,,0,0,0,,[جين] على الأرجح كان يحمل مسدسًا موجهًا\Nإلى السيد [هارا]
Dialogue: 0,1:24:00.32,1:24:04.12,Default 2,,0,0,0,,والذي قد أخذ السكين الموجودة على الطاولة بسرعة
Dialogue: 0,1:24:04.16,1:24:08.37,Default 2,,0,0,0,,حتى [جين] ظن أنه فعل ذلك\N...ليدافع عن نفسه ويستخدمها في القتال
Dialogue: 0,1:24:08.41,1:24:11.96,Default 2,,0,0,0,,غير مدركٍ أبدًا أنها كان رسالة...
Dialogue: 0,1:24:12.00,1:24:14.09,Default 2,,0,0,0,,هل كان السيد [هارا] يعمل معهم؟
Dialogue: 0,1:24:14.13,1:24:20.43,Default 2,,0,0,0,,أجل، على الأرجح قد اخترق حواسيبهم\Nوسرق معلوماتٍ سرية
Dialogue: 0,1:24:20.47,1:24:24.97,Default 2,,0,0,0,,لهذا قتلوه، مسحوا جميع البيانات على حاسوبه
Dialogue: 0,1:24:25.01,1:24:32.35,Default 2,,0,0,0,,وفجروا حاسوب [توكيوا] الرئيسي\Nحيث من المحتمل أن يكون نقلها
Dialogue: 0,1:24:32.40,1:24:36.19,Default 2,,0,0,0,,...إذًا فهذا ما قد حدث
Dialogue: 0,1:24:36.23,1:24:38.65,Default 2,,0,0,0,,!لا! لقد نفذت البطاريات
Dialogue: 0,1:24:38.69,1:24:42.03,Default 2,,0,0,0,,سأذهب إلى الأعلى لأحضر أحدهم\N!ليساعد في حمل السيد [كيساراجي]
Dialogue: 0,1:24:42.03,1:24:43.49,Default 2,,0,0,0,,!انتظري أنتِ هنا
Dialogue: 0,1:25:13.31,1:25:16.69,Default 2,,0,0,0,,!رائع -\N!لقد تم إنقاذنا -
Dialogue: 0,1:25:16.73,1:25:19.69,Default 2,,0,0,0,,!لا توجد رياح\N!يجب أن يكون كل شيءٍ على ما يرام الآن
Dialogue: 0,1:25:36.13,1:25:38.42,Default 2,,0,0,0,,!عودوا يا رفاق\N!أسرعوا
Dialogue: 0,1:25:47.47,1:25:49.81,Default 2,,0,0,0,,!من قد يفعل ذلك؟
Dialogue: 0,1:25:52.39,1:25:55.40,Default 2,,0,0,0,,هذا جديرٌ بأن يبقي المروحية بعيدة
Dialogue: 0,1:25:55.44,1:26:01.15,Default 2,,0,0,0,,فحتى لو انتظروا حتى ينطفئ الحريق\N...فسيكون
Dialogue: 0,1:26:01.19,1:26:02.49,Default 2,,0,0,0,,الوقت قد نفذ
Dialogue: 0,1:26:05.16,1:26:06.45,Default 2,,0,0,0,,...أنا متعب
Dialogue: 0,1:26:10.66,1:26:13.83,Default 2,,0,0,0,,ما الذي يجري في هذا المبنى؟
Dialogue: 0,1:26:13.87,1:26:17.33,Default 2,,0,0,0,,سيكون علينا الانتظار حتى تنطفئ النار على السطح الآن
Dialogue: 0,1:26:17.38,1:26:19.67,Default 2,,0,0,0,,لا أعتقد أن لدينا وقتٌ لذلك
Dialogue: 0,1:26:26.14,1:26:27.43,Default 2,,0,0,0,,!قنبلة؟
Dialogue: 0,1:26:28.55,1:26:31.52,Default 2,,0,0,0,,إنها تحت كل الطاولات\N...المؤقت يشير إلى
Dialogue: 0,1:26:36.27,1:26:38.40,Default 2,,0,0,0,,!لم يتبق سوى أربع دقائق
Dialogue: 0,1:26:38.44,1:26:41.73,Thoughts,,0,0,0,,{\1}اللعنة! سيفجرون قاعة الحفل في نهاية المطاف{\i0}
Dialogue: 0,1:26:41.78,1:26:44.07,Thoughts,,0,0,0,,{\i0}!ليس جليًّا بالنسبة لي خلف من يسعون{\i0}
Dialogue: 0,1:26:57.21,1:26:58.54,Default 2,,0,0,0,,...[ران]
Dialogue: 0,1:26:58.58,1:26:59.88,Default 2,,0,0,0,,!أسرعوا
Dialogue: 0,1:27:09.22,1:27:10.85,Default 2,,0,0,0,,!كابتن! إنها لا تصل
Dialogue: 0,1:27:10.89,1:27:13.14,Default 2,,0,0,0,,!اللعنة! لا فائدة من ذلك
Dialogue: 0,1:27:13.18,1:27:15.81,Thoughts,,0,0,0,,{\i0}!مهلًا! ذاك السطح{\i0}
Dialogue: 0,1:27:24.90,1:27:26.65,Thoughts,,0,0,0,,{\1}!أجل المفتاح هناك{\i0}
Dialogue: 0,1:27:26.70,1:27:30.49,Default 2,,0,0,0,,لقد فهمت! سنستخدم تلك السيارة\N!للقفز إلى المبنى التالي
Dialogue: 0,1:27:30.53,1:27:32.16,Default 2,,0,0,0,,لن يجدي ذلك
Dialogue: 0,1:27:32.20,1:27:38.50,Default 2,,0,0,0,,تلك المبان تبعد عن بعضها 50 مترًا\Nو60 إذا ما كنا سنقفز
Dialogue: 0,1:27:38.54,1:27:41.79,Default 2,,0,0,0,,هناك فرقٌ في الارتفاع قدره 20 متر بين المبنيين
Dialogue: 0,1:27:41.84,1:27:46.80,Default 2,,0,0,0,,على الأرض، يمكن للجسم أن يتحرك أفقيًا بسرعةٍ واحدة
Dialogue: 0,1:27:46.80,1:27:52.60,Default 2,,0,0,0,,ولكن بسبب الجاذبية، ستزداد\Nالسرعة الرأسية بمعدلٍ معين
Dialogue: 0,1:27:52.64,1:27:55.93,Default 2,,0,0,0,,معادلة السقوط لـ20 مترًا
Dialogue: 0,1:27:55.93,1:27:59.19,Default 2,,0,0,0,,هي "ز" يساوي الجزر التربيعي\N"لـ "2م" مقسومةً على "ج
Dialogue: 0,1:27:59.23,1:28:00.77,Default 2,,0,0,0,,حيث أن "ز" هو الزمن
Dialogue: 0,1:28:00.81,1:28:06.24,Default 2,,0,0,0,,و"ج" هي العجلة الناتجة عن الجاذبية أو 9.80665مترًا/ثانية
Dialogue: 0,1:28:06.28,1:28:08.86,Default 2,,0,0,0,,و"م" هي المسافة الرأسية الـ20 مترًا
Dialogue: 0,1:28:08.90,1:28:13.74,Default 2,,0,0,0,,أدخلوا تلك الأرقام في المعادلة وستحصلون على 2.02 ثانية
Dialogue: 0,1:28:13.78,1:28:17.62,Default 2 - up,,0,0,0,,بمعنىً آخر\Nسيستغرق الأمر ما يقرب من الثانيتين للسقوط مسافة 20 مترًا
Dialogue: 0,1:28:17.66,1:28:21.42,Default 2,,0,0,0,,علينا أن نسير مسافة 60 مترًا\N...في ثانيتين، مما يعني
Dialogue: 0,1:28:21.46,1:28:26.38,Default 2,,0,0,0,,30مترًا بالثانية...\Nأو 108 كيلومترًا بالساعة
Dialogue: 0,1:28:26.42,1:28:30.88,Default 2,,0,0,0,,وبالنظر إلى مساحة تلك الغرفة\Nفسنصل فقط إلى 50 أو 60 كيلومترً بالساعة على الأكثر
Dialogue: 0,1:28:30.93,1:28:35.81,Default 2,,0,0,0,,...سنسقط عموديًا قبل أن نصل إلى المبنى الآخر
Dialogue: 0,1:28:35.85,1:28:37.64,Default 2,,0,0,0,,ولكن ماذا إن فعلنا ذلك؟
Dialogue: 0,1:28:37.68,1:28:40.39,Default 2,,0,0,0,,أيعقل أنك تفكر بالانطلاق أثناء الانفجار؟
Dialogue: 0,1:28:40.44,1:28:43.27,Default 2,,0,0,0,,!ماذا؟ ما الذي تتحدثان عنه؟
Dialogue: 0,1:28:43.31,1:28:48.24,Default 2,,0,0,0,,يفكر [كونان] في استخدام التيار الهوائي الناتج\N!من الانفجار ليطير مسافةً أبعد
Dialogue: 0,1:28:48.28,1:28:50.32,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:28:50.36,1:28:53.32,Default 2,,0,0,0,,!سنموت إذا انتظرنا على كل حال
Dialogue: 0,1:28:53.37,1:28:54.66,Default 2,,0,0,0,,!فلنفعلها
Dialogue: 0,1:28:57.75,1:29:00.00,Default 2,,0,0,0,,!فلنفعلها يا [كونان] -\N!لنفعلها -
Dialogue: 0,1:29:00.00,1:29:01.92,Default 2,,0,0,0,,!لنفعلها بالسرعة القصوى -
Dialogue: 0,1:29:01.96,1:29:05.25,Default 2,,0,0,0,,سيكون مفتاح النجاح في التوقيت
Dialogue: 0,1:29:05.29,1:29:10.26,Default 2,,0,0,0,,على القنابل أن تنفجر بمجرد أن تكسر السيارة الزجاج
Dialogue: 0,1:29:10.30,1:29:13.30,Default 2,,0,0,0,,أو سنفقد السرعة ونسقط رأسيًا لأسفل
Dialogue: 0,1:29:13.34,1:29:17.93,Default 2,,0,0,0,,أجل، المشكلة أنك لا تستطيعين\Nمشاهدة مؤقت القنبلة من السيارة
Dialogue: 0,1:29:17.97,1:29:21.56,Default 2,,0,0,0,,...وبطارية ساعتي قد نفذت أيضًا
Dialogue: 0,1:29:21.56,1:29:23.90,Default 2,,0,0,0,,!في هذه الحالة، لدينا [أيومي]
Dialogue: 0,1:29:23.94,1:29:26.90,Default 2,,0,0,0,,!يمكنها أن تعد 30 ثانيةً بالضبط
Dialogue: 0,1:29:26.94,1:29:29.53,Default 2,,0,0,0,,...ولكنها أخطأت في العد منذ قليل
Dialogue: 0,1:29:29.53,1:29:31.36,Default 2,,0,0,0,,أجل
Dialogue: 0,1:29:31.40,1:29:33.53,Default 2,,0,0,0,,ماذا تظنين يا [أيومي]؟\Nهل أنت قادرةٌ على فعلها؟
Dialogue: 0,1:29:33.57,1:29:38.37,Default 2,,0,0,0,,...أنا لست واثقةً، ولكن\N!...إذا كنت معي يا [كونان]
Dialogue: 0,1:29:38.37,1:29:39.75,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:29:39.79,1:29:44.29,Default 2,,0,0,0,,!أعتقد أن باستطاعتي فعلها، إذا كنت بجواري
Dialogue: 0,1:29:44.33,1:29:45.63,Default 2,,0,0,0,,...[أيومي]
Dialogue: 0,1:29:49.46,1:29:54.05,Default 2,,0,0,0,,في هذه الحالة، ماذا لو بقيت بجانب المؤقت\Nأعد حتى الثلاثين
Dialogue: 0,1:29:54.05,1:29:57.64,Default 2,,0,0,0,,ثم أصعد إلى السيارة
Dialogue: 0,1:29:57.68,1:30:00.81,Default 2,,0,0,0,,!لا وقت للتفكير\N!لنتبع ذلك
Dialogue: 0,1:30:00.85,1:30:04.60,Default 2,,0,0,0,,!ماذا؟! هناك قنابل في غرفة الحفلات؟
Dialogue: 0,1:30:04.65,1:30:06.94,Default 2,,0,0,0,,مرهم بأن يفتحوا\N!قبة السطح حالًا
Dialogue: 0,1:30:06.98,1:30:09.69,Default 2,,0,0,0,,!السطح؟ -\N!فقط أسرع -
Dialogue: 0,1:30:09.69,1:30:11.03,Default 2,,0,0,0,,!سيد [كازاما]
Dialogue: 0,1:30:13.03,1:30:17.66,Default 2,,0,0,0,,!مرحبًا؟! إنه أنا\N!افتحوا قبة السطح الآن! حالًا
Dialogue: 0,1:30:17.70,1:30:18.99,Default 2,,0,0,0,,!اعذرني
Dialogue: 0,1:30:19.03,1:30:21.87,Default 2,,0,0,0,,!ماذا تفعل يا [كونان]؟
Dialogue: 0,1:30:21.87,1:30:25.42,Default 2,,0,0,0,,أنا قادم إليك يا [ران]
Dialogue: 0,1:30:25.42,1:30:27.75,Default 2,,0,0,0,,!"فقط أسرع"\N!مرحبًا؟! [كونان]؟
Dialogue: 0,1:30:35.43,1:30:36.72,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,1:30:52.40,1:30:54.45,Default 2,,0,0,0,,55. 54
Dialogue: 0,1:30:54.49,1:30:55.95,Default 2,,0,0,0,,53. 52
Dialogue: 0,1:30:55.99,1:30:58.37,Default 2,,0,0,0,,51. 50
Dialogue: 0,1:30:58.41,1:30:59.70,Default 2,,0,0,0,,49. 48
Dialogue: 0,1:30:59.74,1:31:02.66,Default 2,,0,0,0,,47. 46. 45
Dialogue: 0,1:31:02.70,1:31:04.58,Default 2,,0,0,0,,44. 43
Dialogue: 0,1:31:04.62,1:31:06.62,Default 2,,0,0,0,,42. 41
Dialogue: 0,1:31:06.62,1:31:09.63,Default 2,,0,0,0,,40. 39. 38
Dialogue: 0,1:31:09.67,1:31:11.59,Default 2,,0,0,0,,37. 36
Dialogue: 0,1:31:11.63,1:31:14.63,Default 2,,0,0,0,,35. 34. 33
Dialogue: 0,1:31:14.67,1:31:16.68,Default 2,,0,0,0,,32. 31
Dialogue: 0,1:31:16.72,1:31:17.68,Default 2,,0,0,0,,30!
Dialogue: 0,1:31:17.72,1:31:18.51,Default 2,,0,0,0,,29!
Dialogue: 0,1:31:18.51,1:31:19.39,Default 2,,0,0,0,,28!
Dialogue: 0,1:31:19.43,1:31:20.51,Default 2,,0,0,0,,![هايبرا]
Dialogue: 0,1:31:20.55,1:31:21.60,Default 2,,0,0,0,,!ما الذي يجري؟
Dialogue: 0,1:31:21.64,1:31:24.68,Default 2,,0,0,0,,!إن [هايبرا] لا تتوقف عن العد
Dialogue: 0,1:31:24.73,1:31:25.68,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:31:25.73,1:31:28.60,Default 2,,0,0,0,,![هايبرا]! ماذا تفعلين؟\N!تعالي إلى هنا
Dialogue: 0,1:31:28.65,1:31:31.98,Default 2,,0,0,0,,لا تكونوا أغبياء\Nهذا أدق
Dialogue: 0,1:31:32.02,1:31:35.49,Thoughts,,0,0,0,,{\1}!لا تقل لي أنها تريد البقاء و التضحية بنفسها؟{\i0}
Dialogue: 0,1:31:35.49,1:31:36.49,Default 2,,0,0,0,,21!
Dialogue: 0,1:31:36.49,1:31:37.82,Default 2,,0,0,0,,20!
Dialogue: 0,1:31:44.45,1:31:45.16,Default 2,,0,0,0,,!ماذا تفعل؟
Dialogue: 0,1:31:45.20,1:31:50.46,Default 2,,0,0,0,,قالت أمي أن إهدار ولو حبة أرزٍ واحدة\N!يجلب الحظ السيئ
Dialogue: 0,1:31:50.50,1:31:51.59,Default 2,,0,0,0,,11!
Dialogue: 0,1:31:51.63,1:31:52.59,Default 2,,0,0,0,,10!
Dialogue: 0,1:31:52.63,1:31:53.88,Default 2,,0,0,0,,9! 8!
Dialogue: 0,1:31:53.88,1:31:55.42,Default 2,,0,0,0,,!أمسك -\N!7 -
Dialogue: 0,1:31:55.46,1:31:57.42,Default 2,,0,0,0,,!6 !5 -\N!ها نحن ذا -
Dialogue: 0,1:31:57.47,1:31:58.43,Default 2,,0,0,0,,4!
Dialogue: 0,1:31:58.47,1:31:59.43,Default 2,,0,0,0,,3!
Dialogue: 0,1:31:59.47,1:32:00.43,Default 2,,0,0,0,,2!
Dialogue: 0,1:32:00.47,1:32:01.01,Default 2,,0,0,0,,1 !
Dialogue: 0,1:32:01.01,1:32:02.35,Default 2,,0,0,0,,0!
Dialogue: 0,1:32:09.77,1:32:11.06,Default 2,,0,0,0,,![هايبرا]
Dialogue: 0,1:32:13.73,1:32:16.36,Default 2,,0,0,0,,!بالتأكيد لن أتركك تسقطين
Dialogue: 0,1:32:18.53,1:32:21.70,Thoughts,,0,0,0,,{\i0}!لا، بهذا المعدل ستصطدم بتلك الأعمدة{\i0}
Dialogue: 0,1:32:23.08,1:32:25.04,Default 2,,0,0,0,,!سأستعير هذا
Dialogue: 0,1:32:55.15,1:32:56.44,Default 2,,0,0,0,,{\1}![كونان]{\i0}
Dialogue: 0,1:32:59.24,1:33:00.65,Default 2,,0,0,0,,![ران]
Dialogue: 0,1:33:00.70,1:33:01.82,Default 2,,0,0,0,,!نحن بخير
Dialogue: 0,1:33:01.86,1:33:03.16,Default 2,,0,0,0,,!مرحى
Dialogue: 0,1:33:06.91,1:33:10.04,Default 2,,0,0,0,,!أخبرني يا [كونان]\N!أين تعلمت القيادة؟
Dialogue: 0,1:33:10.08,1:33:12.04,Default 2,,0,0,0,,...علمني والدي في هاواي
Dialogue: 0,1:33:20.55,1:33:25.26,Default 2,,0,0,0,,أيها الزعيم\Nلقد كان هناك خمسة أطفالٍ ورجلٍ مسنٍ بالسيارة
Dialogue: 0,1:33:25.30,1:33:29.64,Default 2,,0,0,0,,يبدو أنها لم تأت أبدًا إلى الحفل
Dialogue: 0,1:33:29.68,1:33:33.52,Default 2,,0,0,0,,لا يهم\Nفقد نفذنا هدفنا الأصلي
Dialogue: 0,1:33:33.56,1:33:38.07,Default 2,,0,0,0,,أجل، ولكن بالتفكير في أن يخوننا
Dialogue: 0,1:33:38.11,1:33:42.61,Default 2,,0,0,0,,...ويتسلل إلى حواسيب المنظمة
Dialogue: 0,1:33:42.61,1:33:44.62,DCFlashback,,0,0,0,,!لقد عرفت يا زعيم
Dialogue: 0,1:33:44.66,1:33:48.16,DCFlashback,,0,0,0,,!البرجين التوأم بمدينة "غرب تاما" هو حيث يختبئ المخترق
Dialogue: 0,1:33:48.16,1:33:50.58,DCFlashback,,0,0,0,,لابد من أنه [هارا] الذي يفعل ذلك بالنهاية
Dialogue: 0,1:33:50.62,1:33:55.54,Default 2,,0,0,0,,لقد اهتممنا بأمر [هارا]\Nوفجرنا حاسوب [توكيوا] الرئيسي
Dialogue: 0,1:33:55.58,1:33:58.55,Default 2,,0,0,0,,معلومات المنظمة لن تتسرب إلى الخارج
Dialogue: 0,1:34:02.84,1:34:07.89,Default 2,,0,0,0,,تمنيت أن أستخدم ذلك المبنى\Nكمكان إعدامها
Dialogue: 0,1:34:07.93,1:34:09.89,Default 2,,0,0,0,,ولكني سأوفر تلك المتعة لوقتٍ لاحق
Dialogue: 0,1:34:28.16,1:34:30.91,Default 2,,0,0,0,,لا أصدق أن السيد [كيساراجي]\N...كان المسؤول عن كل ذلك
Dialogue: 0,1:34:30.95,1:34:32.62,Default 2,,0,0,0,,...إنها صدمة
Dialogue: 0,1:34:32.62,1:34:36.88,Default 2,,0,0,0,,أتعتقدين؟\N!لقد شككت به منذ البداية
Dialogue: 0,1:34:36.92,1:34:39.96,Default 2,,0,0,0,,هذا على الأرجح أبعد ما ستفتش فيه الشرطة
Dialogue: 0,1:34:39.96,1:34:45.63,Default 2,,0,0,0,,أجل، على الأرجح لن يكتشوفوا أبدًا\Nأن [جين] قتل السيد [هارا] أيضًا
Dialogue: 0,1:34:45.68,1:34:48.64,Default 2,,0,0,0,,...والحقيقة وراء التفجير ستطمس في الظلام
Dialogue: 0,1:34:53.64,1:34:57.98,Default 2,,0,0,0,,شكرًا لك على ما فعلت لاحقًا\Nلقد أنقذت حياتي
Dialogue: 0,1:34:58.02,1:35:01.69,Default 2,,0,0,0,,!لا، لقد فعلت ما كان واجبًا علي كرجل
Dialogue: 0,1:35:01.69,1:35:05.15,Default 2,,0,0,0,,أنت أيضًا يا [كوجيما]\Nإذًا فأنا مثل حبة الأرز؟
Dialogue: 0,1:35:08.78,1:35:13.37,Default 2,,0,0,0,,!ولكن يا [أيومي]\N!كيف استطعت العد حتى الـ30 بالضبط؟
Dialogue: 0,1:35:13.41,1:35:14.71,Default 2,,0,0,0,,!حالفني الحظ
Dialogue: 0,1:35:18.42,1:35:22.21,Default 2,,0,0,0,,!الحقيقة أن الفضل لك يا [كونان]
Dialogue: 0,1:35:22.25,1:35:24.63,Default 2,,0,0,0,,عندما تكون بجانبي، أشعر بالابتهاج
Dialogue: 0,1:35:24.67,1:35:27.63,Default 2,,0,0,0,,!ويمكنني حساب الوقت باستخدام دقات قلبي
Dialogue: 0,1:35:27.68,1:35:30.93,Default 2,,0,0,0,,بالتفكير في الأمر\N...في المرة الأولى التي عددتِ فيها حتى 30 ثانية
Dialogue: 0,1:35:30.93,1:35:34.10,DCFlashback,,0,0,0,,28! 29! 30!
Dialogue: 0,1:35:34.14,1:35:37.27,Default 2,,0,0,0,,لهذا طلبتِ أن تكوني بجواري
Dialogue: 0,1:35:37.31,1:35:39.77,Default 2,,0,0,0,,!لقد كنت رائعًا يا [ميتسوهيكو]
Dialogue: 0,1:35:39.81,1:35:40.73,Default 2,,0,0,0,,...أجل
Dialogue: 0,1:35:40.77,1:35:42.15,Default 2,,0,0,0,,!أنت أيضًا يا [غينتا]
Dialogue: 0,1:35:42.19,1:35:43.23,Default 2,,0,0,0,,!أليس كذلك؟
Dialogue: 0,1:35:43.28,1:35:47.74,Default 2,,0,0,0,,ماذا ستفعل الآن؟ -\N!ماذا تعني؟ -
Dialogue: 0,1:35:47.74,1:35:51.45,Default 2,,0,0,0,,إذا جعلت [يوشيدا] تبكي\N!فسوف أجعلك تندم
Dialogue: 0,1:35:51.45,1:35:52.74,Default 2,,0,0,0,,!على مهلك
Dialogue: 0,1:39:04.89,1:39:07.90,Default 2,,0,0,0,,!مهلًا\Nلا تقل لي أن تلك السيارة هي...؟
Dialogue: 0,1:39:07.94,1:39:12.90,Default 2,,0,0,0,,هذا صحيح! إنها الموستانج ذات السقف القابل للطي\N!التي فزت بها
Dialogue: 0,1:39:14.57,1:39:16.86,Default 2,,0,0,0,,...سيارة أحلامي
Dialogue: 0,1:39:24.45,1:39:28.42,Thoughts,,0,0,0,,!لا، مهلًا\N!ربما تصبح قابلةً للاستخدام مجددًا، إذا ما جففتها
