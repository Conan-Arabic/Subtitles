Dialogue: 0,0:00:10.90,0:00:16.78,aaaa,,0,0,0,,{\pos(956.667,205.333)\fscx142\fscy143}Sleem Sama :ترجمة
Dialogue: 0,0:00:20.77,0:00:23.32,Default,,0,0,0,,.لا يُمكنك، فلا مهرب لكِ من هناك
Dialogue: 0,0:00:24.84,0:00:27.41,Default,,0,0,0,,! دعيني أُمسك بكِ على الأقل
Dialogue: 0,0:00:27.49,0:00:29.34,Default,,0,0,0,,ما الذي حدث يا "نينا" ؟
Dialogue: 0,0:00:29.35,0:00:30.59,Default,,0,0,0,,ما الذي يجري معكِ ؟
Dialogue: 0,0:00:30.94,0:00:34.54,Default,,0,0,0,,! يُطاردني الآن رفيق المُجرم الدخيل الذي قام بإقتحام المركز
Dialogue: 0,0:00:34.67,0:00:37.39,Default,,0,0,0,,دخيل ؟ .. ومن يكون ؟
Dialogue: 0,0:00:43.11,0:00:44.98,Default,,0,0,0,,هل أنتِ بخير يا "نينا" ؟
Dialogue: 0,0:00:54.66,0:00:56.00,Default,,0,0,0,,! "نينا"
Dialogue: 0,0:01:00.11,0:01:02.91,Default,,0,0,0,,! "ما الذي حدث معك للتو يا "نينا" ! .. "نينا
Dialogue: 0,0:01:03.07,0:01:05.92,Default,,0,0,0,,! اقفزي إلى النهر ! بسرعة
Dialogue: 0,0:01:08.36,0:01:10.70,Default,,0,0,0,,! اقفزي إلى النهر بسرعة، أرجوكِ
Dialogue: 0,0:01:32.86,0:01:34.33,Default,,0,0,0,,! "جين"
Dialogue: 0,0:01:35.89,0:01:38.87,Default,,0,0,0,,! "لا تُماطلي بعملك يا... "كير
Dialogue: 0,0:01:39.52,0:01:40.66,Default,,0,0,0,,...نعم
Dialogue: 0,0:01:57.90,0:01:59.68,Default,,0,0,0,,كيف صار الوضع الآن ؟
Dialogue: 0,0:01:59.69,0:02:03.16,Default,,0,0,0,,.يبدو أن الأمور تسير على ما يُرامٍ حتى الآن
Dialogue: 0,0:02:03.32,0:02:04.66,Default,,0,0,0,,...بقي لدينا
Dialogue: 0,0:02:04.67,0:02:08.13,Default,,0,0,0,,.أن نبحث عن هذا الرجل بإستخدام نفس النظام
Dialogue: 0,0:02:08.91,0:02:10.96,Default,,0,0,0,,ليسَ لدينا الكثير من الوقت، صحيح ؟
Dialogue: 0,0:02:13.76,0:02:15.98,Default,,0,0,0,,! واه ! هذا مُذهل
Dialogue: 0,0:02:15.98,0:02:20.70,Default,,0,0,0,,! الفائز بالمرتبة الأولى سيحصل على فرصة مشاهدة الحيتان، سنفوز حتمًا
Dialogue: 0,0:02:20.71,0:02:21.44,Default,,0,0,0,,! أجل
Dialogue: 0,0:02:21.44,0:02:24.31,Default,,0,0,0,,مسموحٌ لكل شخصٍ واحد سحب ورقة يانصيبٍ واحدة، صحيح ؟
Dialogue: 0,0:02:24.31,0:02:26.00,Default,,0,0,0,,! أُريد رؤية الحيتان
Dialogue: 0,0:02:26.01,0:02:28.38,Default,,0,0,0,,.وقد يكون هنالك دلافينٌ أيضًا
Dialogue: 0,0:02:28.80,0:02:30.55,Default,,0,0,0,,.انه البروفيسور
Dialogue: 0,0:02:31.37,0:02:33.63,Default,,0,0,0,,!أوي.. إلى أين ذاهبة ؟
Dialogue: 0,0:02:33.63,0:02:35.33,Default,,0,0,0,,.سأعود في الحال
Dialogue: 0,0:02:36.02,0:02:38.24,Default,,0,0,0,,.أشكركِ جزيل الشكر
Dialogue: 0,0:02:39.40,0:02:40.60,Default,,0,0,0,,.تفضلي
Dialogue: 0,0:02:40.60,0:02:41.98,Default,,0,0,0,,.أشكرك
Dialogue: 0,0:02:41.98,0:02:42.76,Default,,0,0,0,,.على الرحب
Dialogue: 0,0:02:42.76,0:02:47.06,Default,,0,0,0,,.وبذلك ينتهي تزويع تذاكر مبيعات قِطع الدبابيس المحدودة
Dialogue: 0,0:02:47.84,0:02:50.97,Default,,0,0,0,,! غير مقول-\N .ياللأسف-
Dialogue: 0,0:02:51.57,0:02:57.88,Default,,0,0,0,,،لقد استغرق الأمر مني قُرابة الساعة بالقطار\N فهل حقًا لم يعد بوسعي فعل شيء ؟
Dialogue: 0,0:02:57.89,0:03:00.16,Default,,0,0,0,,.أُقدم لكِ خالص اعتذاري
Dialogue: 0,0:03:00.16,0:03:03.10,Default,,0,0,0,,.كمية القطع محدودة هذه المرة
Dialogue: 0,0:03:03.51,0:03:05.40,Default,,0,0,0,,.لقد فهمت
Dialogue: 0,0:03:07.04,0:03:08.33,Default,,0,0,0,,! تمهلي
Dialogue: 0,0:03:09.32,0:03:10.90,Default,,0,0,0,,ما الأمر ؟
Dialogue: 0,0:03:10.96,0:03:12.64,Default,,0,0,0,,.تفضلي هذه
Dialogue: 0,0:03:13.68,0:03:16.51,Default,,0,0,0,,.حسنٌ، لا بأس، لم أعد أريدها
Dialogue: 0,0:03:17.28,0:03:21.85,Default,,0,0,0,,،في الواقع، لم أرى سعرها بشكلٍ صحيح\N.لذا هي باهظة الثمن بالنسبة لي
Dialogue: 0,0:03:22.24,0:03:23.57,Default,,0,0,0,,! حقًا
Dialogue: 0,0:03:28.38,0:03:31.47,Default,,0,0,0,,.يبدو أن اوضع يُشير على أنكم خسرتم
Dialogue: 0,0:03:31.48,0:03:33.72,Default,,0,0,0,,.جميعهم بلا استثناء
Dialogue: 0,0:03:34.04,0:03:37.48,Default,,0,0,0,,! لم تنجح هذه المحاولة أيضًا
Dialogue: 0,0:03:37.51,0:03:40.74,Default,,0,0,0,,.ظننتُ بأنني سأفعلها بالوقت المناسب بعد هذا التعب
Dialogue: 0,0:03:40.87,0:03:42.27,Default,,0,0,0,,...أتحدث عن هذه
Dialogue: 0,0:03:42.28,0:03:45.99,Default,,0,0,0,,،انها "سكوتر مائية" وهي مُختلفة عن التي تتواجد بالأسواق
Dialogue: 0,0:03:49.89,0:03:51.56,Default,,0,0,0,,! مُذهل=
Dialogue: 0,0:03:46.00,0:03:49.89,Default,,0,0,0,,.فبإستطاعتها السباحة آليًا، ويُمكنها الغوص لمسافة 30 مترًا
Dialogue: 0,0:03:52.57,0:03:56.12,Default,,0,0,0,,! أوي أوي، ولكن من الخطر الغوص لمسافة 30 مترًا
Dialogue: 0,0:03:56.12,0:03:58.59,Default,,0,0,0,,...لن تكون بمشكلة بعد ما ستراه
Dialogue: 0,0:03:58.84,0:04:01.92,Default,,0,0,0,,{\pos(992,856)}! مُفاجأة ! إنها سماعة الرأس البحرية
Dialogue: 0,0:04:02.04,0:04:07.08,Default,,0,0,0,,انه اختراعٌ ممتاز، فــ به أستطوانة مزدوجة لاسلكية\N.حيث تمنع التعرّض لضغط الماء
Dialogue: 0,0:04:07.08,0:04:11.35,Default,,0,0,0,,.وفوق ذلك، يمكن تغيير رأس "السكوتر المائي" متى شئت
Dialogue: 0,0:04:13.27,0:04:16.35,Default,,0,0,0,,! أنت مذهل يا بروفيسور- \N! هكذا سيصبح الدلفين لطيفًا-
Dialogue: 0,0:04:15.95,0:04:18.07,Default,,0,0,0,,{\pos(890,181)}.سأقوم بتجربته- \N ..وأنا كذلك-
Dialogue: 0,0:04:17.11,0:04:19.69,Default,,0,0,0,,.اوه، انكم صاخبين كعادتكم
Dialogue: 0,0:04:19.70,0:04:24.36,Default,,0,0,0,,"اسمعوا جمعيكم، ما رأيكم بمشاهدة الحيتان في "هاتشيوجيما\Nفأنتم تُريدون الذهاب أليسَ كذلك ؟
Dialogue: 0,0:04:24.80,0:04:27.47,Default,,0,0,0,,وكيف ذلك ؟- \N أخبرينا ؟-
Dialogue: 0,0:04:28.46,0:04:32.42,Default,,0,0,0,,"يملك والد "سونوكو" فُندقًا يقع في "هاتشيوجيما
Dialogue: 0,0:04:32.43,0:04:34.96,Default,,0,0,0,,! ومن هنا ستأتي تطورات الاحداث
Dialogue: 0,0:04:34.97,0:04:38.80,Default,,0,0,0,,هل يُعقل...   -أنّكِ سوفَ...   -تأخذيننا معكِ ؟-
Dialogue: 0,0:04:38.80,0:04:43.09,Default,,0,0,0,,.في الحقيقة، انها مكافأة لأجل هذه الطفلة
Dialogue: 0,0:04:44.65,0:04:50.05,Default,,0,0,0,,.على الرغم من أنكِ لاتزالين طفلة، إلّا أنَّ تصرفاتكِ لطيفة
Dialogue: 0,0:04:52.89,0:04:56.56,Default,,0,0,0,,المعذرة، هل هذه مكافأة لأجل الأطفال فقط ؟
Dialogue: 0,0:04:56.56,0:04:59.77,Default,,0,0,0,,.بالطبع ستأتي معنا يا بروفيسور لأنك ستكون مرشدًا لنا
Dialogue: 0,0:04:59.78,0:05:02.29,Default,,0,0,0,,! مرحى- \N! هذا جيد يا بروفيسور-
Dialogue: 0,0:05:02.32,0:05:04.84,Default,,0,0,0,,.نعم، كم أنتِ لطيفة يا سونوكو-سان
Dialogue: 0,0:05:04.84,0:05:05.94,Default,,0,0,0,,أليسَ كذلك ؟
Dialogue: 0,0:05:14.18,0:05:16.91,Default,,0,0,0,,"اوه، انني أرى "هاتشيوجيما
Dialogue: 0,0:05:16.91,0:05:19.76,Default,,0,0,0,,! مُذهل ! .. يا له من جبلٍ ضخم
Dialogue: 0,0:05:19.76,0:05:23.32,Default,,0,0,0,,"على الأرجح، أنه يُسمّى جبل "هاتشيجو فوجي
Dialogue: 0,0:05:24.12,0:05:25.60,Default,,0,0,0,,.انك مُحق
Dialogue: 0,0:05:25.60,0:05:27.68,Default,,0,0,0,,.مُتشوقة له
Dialogue: 0,0:05:36.37,0:05:39.56,Default,,0,0,0,,! جبل "هاتشيجو فوجي" ضخم- \N! مُذهل-
Dialogue: 0,0:05:39.75,0:05:42.07,Default,,0,0,0,,ماذا تُشاهدين ؟
Dialogue: 0,0:05:42.07,0:05:46.32,Default,,0,0,0,,.سمعتُ بأنهم بنوا منشأة جديدة "للأنتربول" بالقرب من هنا
Dialogue: 0,0:05:46.92,0:05:52.54,Default,,0,0,0,,.أجل، اِنها أوّل منشأة في عصرها تربط جميع كاميرات الشرطة حول العالم
Dialogue: 0,0:05:52.54,0:05:54.63,Default,,0,0,0,,"لهذا أُطلق عليها "عوامة المُحيط
Dialogue: 0,0:05:54.93,0:05:59.82,Default,,0,0,0,,إذًا يُمكن التعرّف على الوجوه بناءً على الصور\N المأخوذة من كاميرات المُراقبة حول العالم، صحيح ؟
Dialogue: 0,0:05:59.82,0:06:01.03,Default,,0,0,0,,.أجل
Dialogue: 0,0:06:01.03,0:06:05.92,Default,,0,0,0,,"هي مُطوّرة لهذا المجال، وقد انضمت لنا في "عوامة المُحيط
Dialogue: 0,0:06:05.92,0:06:08.11,Default,,0,0,0,,هذه الفتاة، أين التقيطتها ؟
Dialogue: 0,0:06:12.25,0:06:14.28,Default,,0,0,0,,.أوه ! هنا
Dialogue: 0,0:06:14.28,0:06:16.04,Default,,0,0,0,,! لقد وصلنا
Dialogue: 0,0:06:16.52,0:06:18.98,Default,,0,0,0,,.ياله من فُندقٍ ضخم
Dialogue: 0,0:06:18.98,0:06:22.15,Default,,0,0,0,,! انه جميل- \N! ورائع أيضًا-
Dialogue: 0,0:06:25.88,0:06:28.04,Default,,0,0,0,,لِمَ المُفتش "شيراتوري" هنا ؟
Dialogue: 0,0:06:30.15,0:06:31.96,Default,,0,0,0,,! انه حوتٌ ضخم
Dialogue: 0,0:06:31.96,0:06:33.58,Default,,0,0,0,,! ويوجد سُلحفاةٌ أيضًا
Dialogue: 0,0:06:33.59,0:06:35.45,Default,,0,0,0,,.الدلفين لطيف
Dialogue: 0,0:06:35.47,0:06:40.71,Default,,0,0,0,,حسنٌ يا جماعة، ان أردتم وضع حقائبكم بغُرفكم\N .فلنتقابل هنا مُجددًا بعد ساعة
Dialogue: 0,0:06:40.71,0:06:41.92,Default,,0,0,0,,! حاضر=
Dialogue: 0,0:06:42.99,0:06:44.69,Default,,0,0,0,,!أقلتَ المُفتش "شيراتوري" ؟
Dialogue: 0,0:06:44.69,0:06:46.33,Default,,0,0,0,,! رُبما كنت مُخطئًا برؤيتك
Dialogue: 0,0:06:47.20,0:06:49.64,Default,,0,0,0,,"على الأرجح أنه كان المُفتش "شيراتوري
Dialogue: 0,0:06:50.68,0:06:52.61,Default,,0,0,0,,...يبدو أن هنالك أمرٌ ما
Dialogue: 0,0:06:56.31,0:07:00.07,Default,,0,0,0,,"حان الوقت لكي أُخبرك بما أنك وصلت "لهاتشيوجيما
Dialogue: 0,0:07:00.76,0:07:07.57,Default,,0,0,0,,هل تعلم أيها الصبي، أن هنالك مركزًا لشبكة كاميرات\N المُراقبة في فرانكفورت بألمانيا وتابع "لليوروبول" ؟
Dialogue: 0,0:07:07.81,0:07:10.00,Default,,0,0,0,,نعم، وما المهم بالموضوع ؟
Dialogue: 0,0:07:10.00,0:07:13.27,Default,,0,0,0,,...اِقتحم دخيلٌ ما ذلك المكان مؤخرًا
Dialogue: 0,0:07:13.28,0:07:18.75,Default,,0,0,0,,"والموظفة التي شاهدت ذلك الدخيل، قُتلتْ على يد "جين
Dialogue: 0,0:07:18.75,0:07:20.02,Default,,0,0,0,,! "جين"
Dialogue: 0,0:07:20.02,0:07:24.15,Default,,0,0,0,,.هذه المعلومات تم أخذها من "كير" المُتسللة داخل منظمتهم
Dialogue: 0,0:07:24.16,0:07:27.71,Default,,0,0,0,,إذًا، هل تعتقد أن ذلك الدخيل من المُنظمة السوداء ؟
Dialogue: 0,0:07:28.24,0:07:29.47,Default,,0,0,0,,...أجل
Dialogue: 0,0:07:29.56,0:07:32.16,Default,,0,0,0,,.هو شخصٌ لديه شعرٌ على شكل ظفائر الذُرة
Dialogue: 0,0:07:32.16,0:07:35.41,Default,,0,0,0,,"واسمه الحركي هو "بينڠا
Dialogue: 0,0:07:35.55,0:07:38.69,Default,,0,0,0,,"سمعتُ بأنه المُفضّل لدى "رام
Dialogue: 0,0:07:38.71,0:07:40.52,Default,,0,0,0,,ولِمَ تُطلعني على ذلك ؟
Dialogue: 0,0:07:40.54,0:07:47.53,Default,,0,0,0,,اليوم سيتم وبشكلٍ فعلي تشغيل الخط \N.القريب من "عوامة المُحيط" بذلك المركز
Dialogue: 0,0:07:47.64,0:07:50.51,Default,,0,0,0,,.وقد ظننتُ بأن الأمر سيهمك
Dialogue: 0,0:07:51.17,0:07:52.75,Default,,0,0,0,,! آكاي-سان
Dialogue: 0,0:07:56.23,0:08:02.75,Default,,0,0,0,,"جين .. ڤودكا .. كورون .. آيرش .. بيسكو .. تيكيرا"
Dialogue: 0,0:08:03.07,0:08:04.92,Default,,0,0,0,,"وأيضًا "بينڠا
Dialogue: 0,0:08:05.64,0:08:09.65,Default,,0,0,0,,.كلهم أعضاءٌ من الرجال، ولديهم أسماء مشروباتٍ الكحولية
Dialogue: 0,0:08:10.42,0:08:14.16,Default,,0,0,0,,"ومشروب "بينڠا" مصنوعٌ من نفس مكونات مشروب "رام
Dialogue: 0,0:08:14.53,0:08:16.99,Default,,0,0,0,,.ينتابني شعورٌ سيءٌ حيال ذلك
Dialogue: 0,0:08:41.13,0:08:44.07,Default,,0,0,0,,.أنا مُحقق بالثانوية، وأُدعى كودو شينتشي
Dialogue: 0,0:08:45.49,0:08:50.12,Default,,0,0,0,,،بأثناء زيارتي لمدينة الملاهي برفقة موري ران، صديقة الطفولة وزميلتي بالمدرسة
Dialogue: 0,0:08:50.12,0:08:54.51,Default,,0,0,0,,...شاهدتُ رجلًا بملابسه السوداء يقوم بصفقة مشبوهة
Dialogue: 0,0:08:55.28,0:08:58.01,Default,,0,0,0,,،انشغلتُ بمراقبة الصفقة
Dialogue: 0,0:08:58.40,0:09:02.65,Default,,0,0,0,,.فلم أنتبه لشريكه الذي تسلل وضربني من الخلف
Dialogue: 0,0:09:05.75,0:09:08.46,Default,,0,0,0,,...ثم أجبرني ذلك الرجل على شُرب عقّارٍ سام
Dialogue: 0,0:09:08.49,0:09:10.36,Default,,0,0,0,,...وعندما اِستيقظت
Dialogue: 0,0:09:11.00,0:09:13.40,Default,,0,0,0,,كان جسدي متقلصًا
Dialogue: 0,0:09:14.26,0:09:17.18,Default,,0,0,0,,...لو عرفَ أولئك الرجال بأن كودو شينتشي لا يزال حيًّا
Dialogue: 0,0:09:17.18,0:09:20.81,Default,,0,0,0,,.فإنهم سيُحاولون قتلي مرة أخرى وسيتعرّض حياة من حولي للخطر
Dialogue: 0,0:09:24.30,0:09:27.96,Default,,0,0,0,,،وهكذا اتبعت نصيحة البروفيسور "آغاسا" لإخفاء هويتي
Dialogue: 0,0:09:28.21,0:09:30.90,Default,,0,0,0,,...وعندما سألتني ران عن اسمي، فأجبتها على الفور
Dialogue: 0,0:09:31.03,0:09:33.46,Default,,0,0,0,,"""بإسم أيدوغاوا كونان"""
Dialogue: 0,0:09:34.62,0:09:36.89,Default,,0,0,0,,،ومن أجل أن أحصل على معلوماتٍ تخصّ أولئك الرجال
Dialogue: 0,0:09:36.89,0:09:40.47,Default,,0,0,0,,.جئت للعيش في منزل ران والذي يعمل والدها مُتحريَّا
Dialogue: 0,0:09:42.94,0:09:48.51,Default,,0,0,0,,،هذه الفتاة تُدعى "هايبرا آي" والتي كانت عالمة أدوية في المنظمة السوداء
Dialogue: 0,0:09:48.51,0:09:51.46,Default,,0,0,0,,،وصانعة العقار " أبوتوكسين 4869" الذي تناولته
Dialogue: 0,0:09:52.17,0:09:57.18,Default,,0,0,0,,.ولكنها تمرّدت على المُنظمة بعد أن قاموا بإغتيال اختها
Dialogue: 0,0:09:57.38,0:10:03.38,Default,,0,0,0,,.ولتُنهي حياتها تناولت العقار ذاته .. فتقلّص جسدها عِوضًا عن ذلك
Dialogue: 0,0:10:03.95,0:10:08.45,Default,,0,0,0,,.وهي الآن تُقيم في منزل البروفيسور "آڠاسا" من أجل التخفي عنهم
Dialogue: 0,0:10:10.23,0:10:13.45,Default,,0,0,0,,...أما أعضاء المنظمة الذين يحيطهم الغموض، هم
Dialogue: 0,0:10:14.20,0:10:19.13,Default,,0,0,0,,.جين، ڤودكا، بليموت، كانتي وكورون
Dialogue: 0,0:10:19.48,0:10:22.27,Default,,0,0,0,,.وأيضًا باربون، كير
Dialogue: 0,0:10:23.14,0:10:25.78,Default,,0,0,0,,.كِلاهما عميلان لدى وكالات مُختلفة
Dialogue: 0,0:10:25.78,0:10:28.48,Default,,0,0,0,,.فوريا ري من قوات الأمن العام
Dialogue: 0,0:10:29.48,0:10:34.01,Default,,0,0,0,,.وميزوناشي رينا من وكالة الأستخبارات الأمريكية
Dialogue: 0,0:10:34.97,0:10:37.19,Default,,0,0,0,,...ويتشابه معهم في السعي خلف المنظمة
Dialogue: 0,0:10:37.19,0:10:40.27,Default,,0,0,0,,.آكاي شويتشي من مكتب التحقيقات الفدرالية الأمريكية
Dialogue: 0,0:10:41.39,0:10:43.89,Default,,0,0,0,,FBIيُعدُّ أحد أفضل القناصين لدى الــ
Dialogue: 0,0:10:45.02,0:10:51.98,Default,,0,0,0,,"أما الآن فهو مُتنكرٌ بشخصية الطالب الجامعي "أوكيا تسوبارو\N.ويُقيم في المنزل نفسه الذي كنتُ أعيش به
Dialogue: 0,0:10:54.08,0:10:56.71,Default,,0,0,0,,! تقلّص جسدي ولكن عقلي ظلَّ هو نفسه
Dialogue: 0,0:10:58.09,0:11:00.47,Default,,0,0,0,,! الـمُحقق العظيم الذي لا يـُقهر
Dialogue: 0,0:11:00.84,0:11:05.02,Default,,0,0,0,,! الحقيقة دائمًا هي واحدة
Dialogue: 0,0:11:09.68,0:11:11.47,Default,,0,0,0,,تمهلي قليلًا يا آيومي-تشان
Dialogue: 0,0:11:11.48,0:11:13.49,Default,,0,0,0,,.انتهيتُ من ربطها
Dialogue: 0,0:11:13.80,0:11:15.05,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:11:15.06,0:11:17.46,Default,,0,0,0,,.وهكذا ستكون على ما يُرام-\N.شكرًا لكِ-
Dialogue: 0,0:11:17.46,0:11:18.44,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,0:11:18.49,0:11:20.75,Default,,0,0,0,,...سمعتُ بأنكم تسعة أشخاص ولكن
Dialogue: 0,0:11:20.92,0:11:22.48,Default,,0,0,0,,! تبقى شخصٌ واحد
Dialogue: 0,0:11:22.79,0:11:25.25,Default,,0,0,0,,.لقد اِعتذر لنا عن غيابه
Dialogue: 0,0:11:25.27,0:11:27.55,Default,,0,0,0,,.سيكون ذلك أفضل لأنه سيُعيقنا
Dialogue: 0,0:11:29.21,0:11:32.05,Default,,0,0,0,,...إنه ثمل-\N.فِعلًا-
Dialogue: 0,0:11:32.07,0:11:32.60,Default,,0,0,0,,! ...بحق
Dialogue: 0,0:11:32.60,0:11:34.48,Default,,0,0,0,,! كما هو متوقعٌ من العم
Dialogue: 0,0:11:34.89,0:11:37.64,Default,,0,0,0,,.امم، إذًا تفضلوا في الدخول
Dialogue: 0,0:11:37.66,0:11:39.58,Default,,0,0,0,,! مرحى
Dialogue: 0,0:11:44.02,0:11:44.59,Default,,0,0,0,,{\pos(1008,117)}هل أنتِ بخير ؟
Dialogue: 0,0:11:44.59,0:11:46.70,Default,,0,0,0,,.الراكب التالي-\N! حاضر-
Dialogue: 0,0:11:45.38,0:11:46.69,Default,,0,0,0,,{\pos(1000,120)}.أشكرك
Dialogue: 0,0:11:57.31,0:11:59.18,Default,,0,0,0,,.المعذرة يا بروفيسور، تولّى أمرهم عني
Dialogue: 0,0:12:00.49,0:12:02.39,Default,,0,0,0,,ما الأمر يا بروفيسور ؟
Dialogue: 0,0:12:02.42,0:12:04.47,Default,,0,0,0,,...لا شيء
Dialogue: 0,0:12:04.47,0:12:07.90,Default,,0,0,0,,كُنتُ أتسائل، كيف تصرخ الحيتان ؟
Dialogue: 0,0:12:20.47,0:12:21.70,Default,,0,0,0,,!ماذا ؟=
Dialogue: 0,0:12:21.70,0:12:24.47,Default,,0,0,0,,أخطأ وركب في قاربٍ مُختلف ؟
Dialogue: 0,0:12:24.47,0:12:27.13,Default,,0,0,0,,.من عادة كونان أن يتغابى في بعض الأحيان
Dialogue: 0,0:12:27.13,0:12:28.48,Default,,0,0,0,,.لا أظن ذلك
Dialogue: 0,0:12:28.48,0:12:30.24,Default,,0,0,0,,! سيجعلنا نقلق عليه
Dialogue: 0,0:12:30.24,0:12:33.81,Default,,0,0,0,,...ولكنه الآن برفقة المُفتش "شيراتوري" لذا
Dialogue: 0,0:12:34.42,0:12:37.75,Default,,0,0,0,,.سيقوم بتوصيله إلى الفندق الذي تُقيمون به فيما بعد
Dialogue: 0,0:12:37.75,0:12:40.13,Default,,0,0,0,,! حتى أنت يا كونان-كن
Dialogue: 0,0:12:40.48,0:12:43.38,Default,,0,0,0,,...لا شك بأنه
Dialogue: 0,0:12:53.53,0:12:55.70,Default,,0,0,0,,! لا تظهر أي معلومة
Dialogue: 0,0:12:55.70,0:13:00.09,Default,,0,0,0,,"كما توقعت، هذا القارب مُتجهٌ إلى "عوامة المُحيط
Dialogue: 0,0:13:14.47,0:13:16.95,Default,,0,0,0,,! هذا مُدهل-\N! المياه باردة جدًا-
Dialogue: 0,0:13:16.95,0:13:18.06,Default,,0,0,0,,! فِعلًا
Dialogue: 0,0:13:24.47,0:13:26.46,Default,,0,0,0,,.كونوا حذرين عند نزولكم رجاءً
Dialogue: 0,0:13:26.46,0:13:27.48,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:13:31.87,0:13:34.31,Default,,0,0,0,,ياله من مكانٍ واسع، أليسَ كذك ؟
Dialogue: 0,0:13:36.11,0:13:38.42,Default,,0,0,0,,...ألم يحن الوقت لكي تُخبرنا
Dialogue: 0,0:13:39.63,0:13:42.85,Default,,0,0,0,,عن سبب لحاقكَ بنا ؟
Dialogue: 0,0:13:44.81,0:13:46.65,Default,,0,0,0,,!لماذا يا كونان-كن ؟
Dialogue: 0,0:13:48.90,0:13:51.68,Default,,0,0,0,,! جئت لأرى الحيتان ولكنني ركبت القارب الخطأ
Dialogue: 0,0:13:51.68,0:13:54.31,Default,,0,0,0,,إذًا لماذا لم تُخبرني عن ذلك فور صعودك ؟
Dialogue: 0,0:13:54.31,0:13:57.15,Default,,0,0,0,,! لأنني خِفتُ من أن تقوم بتوبيخي على ذلك
Dialogue: 0,0:13:57.15,0:13:59.00,Default,,0,0,0,,.سأتصل بأحد السُفن لكي تُعيدك
Dialogue: 0,0:13:59.00,0:14:02.71,Default,,0,0,0,,.توقف. لا أريد أن ينتظرنا أعضاء "الانتربول" أكثر من ذلك
Dialogue: 0,0:14:05.77,0:14:08.46,Default,,0,0,0,,.نشكركم على قطع كل هذه المسافة البعيدة
Dialogue: 0,0:14:08.82,0:14:12.98,Default,,0,0,0,,"سُررت بلقائكم، أنا مُدير مكتب "عوامة المُحيط" وأدعى "ماكينو
Dialogue: 0,0:14:12.98,0:14:16.15,Default,,0,0,0,,"أنا المهندسة وأُدعى "ناومي آرجينتو
Dialogue: 0,0:14:16.47,0:14:19.75,Default,,0,0,0,,"أُدعى "شيراتوري" وأنا ضابط شرطة العاصمة وهذا رئيسنا ويُدعى "كورودا
Dialogue: 0,0:14:19.95,0:14:21.68,Default,,0,0,0,,.سُررت بلقائكم
Dialogue: 0,0:14:21.96,0:14:24.67,Default,,0,0,0,,.في الواقع، إننا نتشرف بحضوركم اليوم
Dialogue: 0,0:14:24.67,0:14:28.67,Default,,0,0,0,,.حسنٌ، يبدو أن هذا الطفل ركب معكم بالخطأ
Dialogue: 0,0:14:28.78,0:14:31.68,Default,,0,0,0,,مرحبًا.. ما هو أسمك ؟
Dialogue: 0,0:14:31.68,0:14:34.67,Default,,0,0,0,,.أُدعى "إيدوڠاوا كونان" ... سُررت بلقائكم
Dialogue: 0,0:14:34.67,0:14:37.78,Default,,0,0,0,,.إذًا اِسمك هو كونان-كن ... سُررنا بلقاءك
Dialogue: 0,0:14:38.67,0:14:42.25,Default,,0,0,0,,"من هذا الطريق يُمكننا التوجّه مُباشرةً إلى "عوامة المُحيط
Dialogue: 0,0:14:45.42,0:14:48.00,Default,,0,0,0,,! تمهل يا كونان-كن- \N! يا له من مكانٍ واسع-
Dialogue: 0,0:14:53.07,0:14:55.55,Default,,0,0,0,,! يا له من مكانٍ ضخم
Dialogue: 0,0:14:55.73,0:14:58.46,Default,,0,0,0,,.إنه المدخل الرئيسي، فلتقي نظرةً عليه
Dialogue: 0,0:15:11.68,0:15:13.45,Default,,0,0,0,,! مُذهل
Dialogue: 0,0:15:15.33,0:15:17.66,Default,,0,0,0,,.هذا هو المدخل الرئيسي
Dialogue: 0,0:15:17.66,0:15:21.18,Default,,0,0,0,,،في الواقع، إن مُعظم المرافق قد تم بناءها تحت الماء
Dialogue: 0,0:15:21.44,0:15:26.45,Default,,0,0,0,,،لكي يتم ضبط التحكم بالطفو والغوص وتأثير الأمواج\N.وهذا يعتمد على خزانات سائل الرصّ في الأسفل أيضًا
Dialogue: 0,0:15:27.38,0:15:32.05,Default,,0,0,0,, .تِلك الخزانات يُعتمد عليها في تبريد المُحركات الضخمة تحت الماء
Dialogue: 0,0:15:32.32,0:15:35.14,Default,,0,0,0,,.تبدو وكأنها عوامة ضخمة للغاي
Dialogue: 0,0:15:35.14,0:15:38.71,Default,,0,0,0,,"لذلك يُطلق عليها اِسم "عوامة المُحيط
Dialogue: 0,0:15:44.07,0:15:45.18,Default,,0,0,0,,...إن هذا
Dialogue: 0,0:15:45.18,0:15:47.67,Default,,0,0,0,,.الغرفة الرئيسية موجوةٌ في أسفلها
Dialogue: 0,0:15:49.50,0:15:51.42,Default,,0,0,0,,!عُذرًا، ما ذلك الشيء ؟
Dialogue: 0,0:15:53.04,0:15:56.08,Default,,0,0,0,,.إنها عنفة توليد الكهرباء عن طريق تدفق التيار
Dialogue: 0,0:15:56.08,0:15:58.83,Default,,0,0,0,,.فتيار "كوروشيرو" قويٌ للغاي
Dialogue: 0,0:16:02.18,0:16:05.71,Default,,0,0,0,,.هذا الطابق مُخصصٌ لإقامة الموظفين
Dialogue: 0,0:16:06.06,0:16:08.68,Default,,0,0,0,,.أما الغُرفة الرئيسة فتقع بنهاية هذا الممر
Dialogue: 0,0:16:10.26,0:16:11.88,Default,,0,0,0,,...هاه ؟! اِنه
Dialogue: 0,0:16:11.88,0:16:13.88,Default,,0,0,0,,.صوت صرخة الحيتان
Dialogue: 0,0:16:13.88,0:16:16.65,Default,,0,0,0,,.بعض أنواع الحيتان تحب أن تصرخ
Dialogue: 0,0:16:17.30,0:16:19.28,Default,,0,0,0,,!هل تستعملون "السونار" لإكتشافها ؟
Dialogue: 0,0:16:17.30,0:16:21.29,aaaa,,0,0,0,,{\fscx121\fscy122\pos(978.333,127.666)}-السونار هو جِهاز كاشف صوتي يُستخدم تحت الماء لإكتشاف الأسماء والحيتان وغيرها-
Dialogue: 0,0:16:19.28,0:16:22.88,Default,,0,0,0,,! مُذهل ! لديكَ اِطلاعٌ واسعٌ بكثيرٍ من الأمور يا كونان-كن
Dialogue: 0,0:16:25.68,0:16:29.58,Default,,0,0,0,,.أشكركم على قطع كل هذه المسافة. لقد وصلنا إلى الغرفة الرئيسية
Dialogue: 0,0:16:39.04,0:16:40.31,Default,,0,0,0,,! إنها واسعة
Dialogue: 0,0:16:46.77,0:16:49.88,Default,,0,0,0,,.والآن، دعوني أُعرّفكم على الموظفين الأساسيين
Dialogue: 0,0:16:51.04,0:16:53.11,Default,,0,0,0,,.ڠريس" فرنسية الجنسية"
Dialogue: 0,0:16:53.11,0:16:54.68,Default,,0,0,0,,.مرحبًا
Dialogue: 0,0:16:55.68,0:16:58.14,Default,,0,0,0,,.ليونهارت" ألماني الجنسية"
Dialogue: 0,0:17:02.92,0:17:05.22,Default,,0,0,0,,.ايد" هندي الجنسية"
Dialogue: 0,0:17:05.27,0:17:06.69,Default,,0,0,0,,.تشرفت
Dialogue: 0,0:17:08.45,0:17:11.41,Default,,0,0,0,,"تيقيتُ أنا، أُدعى "ناومي آرجينتو
Dialogue: 0,0:17:11.51,0:17:14.41,Default,,0,0,0,,.أما الباقي فهم مُهندسون يقومون بعملهم
Dialogue: 0,0:17:14.41,0:17:20.35,Default,,0,0,0,,المعذرة، هل هذه جميع كاميرات المُراقبة الخاصة في اليابان ؟
Dialogue: 0,0:17:20.35,0:17:25.48,Default,,0,0,0,,"أجل. واليوم سنقوم بتوصيلها مع جميع كامرات المُراقبة في "أوروبا
Dialogue: 0,0:17:25.96,0:17:29.35,Default,,0,0,0,,.ونسعى بتوصيل جميع كاميرات المُراقبة بالعالم مع بعضها البعض
Dialogue: 0,0:17:29.35,0:17:32.12,Default,,0,0,0,,"كما هو متوقعٌ من منشأة تابعة "للانتربول
Dialogue: 0,0:17:32.12,0:17:34.91,Default,,0,0,0,,..."صحيح. وبما أنها مُنشأة تابعة "للانتربول
Dialogue: 0,0:17:34.91,0:17:37.45,Default,,0,0,0,,! أتسائل عن السبب الذي يجلب الشرطة اليابانية إلى هذا المكان
Dialogue: 0,0:17:37.45,0:17:40.55,Default,,0,0,0,,"من أجل التحقيق بحادثة "فرانكفورت
Dialogue: 0,0:17:42.20,0:17:46.58,Default,,0,0,0,,.لقد جائوا ليقوموا بمُساعدتنا، في حال حدوث أي أمرٍ مُفاجئ
Dialogue: 0,0:17:47.08,0:17:52.25,Default,,0,0,0,,! ليسَ عدلًا أن تكون الشرطة الياباية هي أول من يطلع على أحد الأنظمة
Dialogue: 0,0:17:52.41,0:17:55.24,Default,,0,0,0,,"اليايان" هي من دول الأعضاء في "الانتربول"
Dialogue: 0,0:17:55.50,0:17:58.98,Default,,0,0,0,,.ومن الطبيعي أن تتطلع على أحدث الأنظمة عندما يُضطر الأمر
Dialogue: 0,0:17:58.98,0:18:03.31,Default,,0,0,0,,.ولكنه يُعدُّ إنحيازًا منكَ "لليابان" بما أنك مُديرٌ ياباني
Dialogue: 0,0:18:04.09,0:18:05.60,Default,,0,0,0,,! هذا يكفي
Dialogue: 0,0:18:05.60,0:18:08.63,Default,,0,0,0,,.على هذا المنوال، فـــ أنا نصف يابانية
Dialogue: 0,0:18:08.63,0:18:11.49,Default,,0,0,0,,.وهذا يُفسر عدم اندماجي معكِ
Dialogue: 0,0:18:11.90,0:18:15.21,Default,,0,0,0,,! فلتسحب ما كُنتَ تقوله الآن لو سمحت\N! فهذا يُعدُّ تمييُز عنصري
Dialogue: 0,0:18:15.43,0:18:17.31,Default,,0,0,0,,—علاوةً على ذلك فإنكَ- \N ...المعذرة-
Dialogue: 0,0:18:17.31,0:18:18.93,Default,,0,0,0,,ألم يحن الوقت بعد ؟
Dialogue: 0,0:18:18.93,0:18:19.78,Default,,0,0,0,,.أجل
Dialogue: 0,0:18:19.78,0:18:22.10,Default,,0,0,0,,! ليلتزم الجميع بأماكنهم
Dialogue: 0,0:18:26.50,0:18:27.92,Default,,0,0,0,,.أعتذر منكم
Dialogue: 0,0:18:27.92,0:18:33.11,Default,,0,0,0,,.لقد عانى "ليونهارت" من الشرطة الوطنية الأوربية في أثناء مجيئه إلى هنا
Dialogue: 0,0:18:39.42,0:18:41.11,Default,,0,0,0,,! الإتصال الأول
Dialogue: 0,0:18:57.41,0:19:01.71,Default,,0,0,0,,على هذا الحال، يمكنهم رؤية جميع كاميرات المُراقبة في "أوروبا" أليسَ كذلك ؟
Dialogue: 0,0:19:01.71,0:19:04.76,Default,,0,0,0,,.وفوق ذلك، يستطيعون التعرّف على وجوههم أيضًا
Dialogue: 0,0:19:04.76,0:19:07.58,Default,,0,0,0,,.وأيضًا بإمكاننا استعمال تقنياتٍ كثيرةٍ غيرها
Dialogue: 0,0:19:07.83,0:19:12.45,Default,,0,0,0,,اِحدى هذه التقنيات، هي تقنية التعرّف العمري الشامل\N .والتي طروتها "ناومي" مُؤخرًا وسنقوم بتجربتها الآن
Dialogue: 0,0:19:15.65,0:19:17.55,Default,,0,0,0,,!التعرّف العمري الشامل ؟
Dialogue: 0,0:19:18.42,0:19:24.81,Default,,0,0,0,,."إنني من أبٍ إيطالي وأم يابانية وعشت وتربيت في "أمريكا
Dialogue: 0,0:19:25.27,0:19:28.30,Default,,0,0,0,,.سأجرّب التقنية على صورةٍ لي تم إلتقاتها في طفولتي
Dialogue: 0,0:19:35.28,0:19:40.85,Default,,0,0,0,,يتم حساب نمو الجمجمة وتقدمها بالعمر\N .ليتقوم التقنية بإنشاء صورة وجه أكبر سنًا بإستعمال الحاسوب
Dialogue: 0,0:19:40.85,0:19:44.41,Default,,0,0,0,,.وبذلك تبحث عن صورة الوجه التي تم إنشاءها لتجد من يُشبهها في الواقع بدقة
Dialogue: 0,0:19:48.04,0:19:50.58,Default,,0,0,0,,.هذه تقنية التعرّف العمري الشامل
Dialogue: 0,0:19:51.00,0:19:56.25,Default,,0,0,0,,.هذه الصور تم إلتقاتها لي اليوم عندما كُنتُ قادمة من مركز الشرطة إلى هنا
Dialogue: 0,0:20:00.29,0:20:05.71,Default,,0,0,0,,.يمكن لهذا النظام أن يُلاحق الهاربين والخاطفين والضحايا في أي مكانٍ بالعالم
Dialogue: 0,0:20:05.95,0:20:07.30,Default,,0,0,0,,! مُذهل
Dialogue: 0,0:20:07.79,0:20:09.74,Default,,0,0,0,,! يا له من نظامٍ مُذهلٍ حقًا
Dialogue: 0,0:20:09.89,0:20:12.35,Default,,0,0,0,,...لا شك بأنه نظامٌ مذهل، ومع ذلك
Dialogue: 0,0:20:13.42,0:20:18.08,Default,,0,0,0,,.سنكمل تجاربنا على باقي الأجهزة بعد ان نستريح لمدة ربع ساعة
Dialogue: 0,0:20:27.40,0:20:30.42,Default,,0,0,0,,يا جماعة، ما رأيكم في شرب القهوة ؟
Dialogue: 0,0:20:33.88,0:20:35.71,Default,,0,0,0,,.سأذهب لكي أسألهم
Dialogue: 0,0:20:36.02,0:20:37.85,Default,,0,0,0,,.شكرًا لك يا كونان-كن
Dialogue: 0,0:20:44.34,0:20:46.12,Default,,0,0,0,,.أريد قهوةً سادة
Dialogue: 0,0:20:46.12,0:20:48.62,Default,,0,0,0,,"اِصنعها بنفسك يا "ايد
Dialogue: 0,0:20:48.62,0:20:51.28,Default,,0,0,0,,."حسنٌ لا بأس. سأصنع لك قهوةً سادة يا "ايد
Dialogue: 0,0:20:51.88,0:20:53.86,Default,,0,0,0,,.أريد هذا العدد من القهوة بالسكر
Dialogue: 0,0:20:53.86,0:20:55.87,Default,,0,0,0,,حسنٌ، كوب قهوةٍ واحد صحيح ؟
Dialogue: 0,0:20:55.87,0:20:57.37,Default,,0,0,0,,.بل اِثنان
Dialogue: 0,0:20:57.37,0:20:59.43,Default,,0,0,0,,أتريد العصير يا كونان-كن ؟
Dialogue: 0,0:20:59.43,0:21:01.56,Default,,0,0,0,,هل لديكم قهوة مثلجة ؟
Dialogue: 0,0:21:01.77,0:21:04.25,Default,,0,0,0,,.هل تحب القهوة ؟ .. نعم لدينا
Dialogue: 0,0:21:04.25,0:21:05.88,Default,,0,0,0,,.أشكركم
Dialogue: 0,0:21:06.33,0:21:08.17,Default,,0,0,0,,.سأقوم بمُساعدتكم
Dialogue: 0,0:21:08.17,0:21:09.87,Default,,0,0,0,,.نشكرك على ذلك
Dialogue: 0,0:21:32.52,0:21:34.41,Default,,0,0,0,,!لِم هو موجودٌ في هذا المكان ؟
Dialogue: 0,0:21:34.41,0:21:36.41,Default,,0,0,0,,!الرصاصة الفضية ؟
Dialogue: 0,0:21:37.04,0:21:39.08,Default,,0,0,0,,!أين ناومي-سان ؟
Dialogue: 0,0:21:39.08,0:21:41.62,Default,,0,0,0,,.ذهبت إلى الحمام، لنسبقها بالعودة
Dialogue: 0,0:21:41.62,0:21:43.62,Default,,0,0,0,,! حـ حاضر
Dialogue: 0,0:21:57.41,0:22:00.45,Default,,0,0,0,,.نظام التعرّف العمري هذا مُذهلٌ جدًا
Dialogue: 0,0:22:00.45,0:22:05.86,Default,,0,0,0,,أتساءل كيف يتعرّف النظام على وجه الشخص \N حتى لو تغيرت ملامحه بعد تقدمه بالعمر ؟
Dialogue: 0,0:22:06.14,0:22:12.31,Default,,0,0,0,,.على الأرجح هو ذكاء اصطناعي يجمع بين التشريح والإحصاء العلمي
Dialogue: 0,0:22:12.63,0:22:14.97,Default,,0,0,0,,.ناومي لديها التفصيل الأدق
Dialogue: 0,0:22:14.97,0:22:19.71,Default,,0,0,0,,.عندما نحصل على التسجيل الحيّ، فإن الذكاء الصناعي يقوم بذلك بشكلٍ آلي
Dialogue: 0,0:22:19.71,0:22:20.75,Default,,0,0,0,,.لقد فهمت
Dialogue: 0,0:22:20.75,0:22:23.39,Default,,0,0,0,,.يا لها من تقنية رائعة
Dialogue: 0,0:22:23.87,0:22:28.05,Default,,0,0,0,,.سيد ماكينو، لقد انتهى وقت الإستراحة
Dialogue: 0,0:22:28.38,0:22:31.78,Default,,0,0,0,,!أجل. ولكن أين ناومي ؟
Dialogue: 0,0:22:31.78,0:22:34.00,Default,,0,0,0,,...هاه ؟ بالمناسبة
Dialogue: 0,0:22:34.00,0:22:37.15,Default,,0,0,0,, بحق، ما الذي تفعله تِلك المرأة ؟
Dialogue: 0,0:22:37.15,0:22:39.36,Default,,0,0,0,,التعرّف العمري الشامل إذًا... ؟
Dialogue: 0,0:22:39.36,0:22:41.36,Default,,0,0,0,,...هاهي
Dialogue: 0,0:22:41.96,0:22:43.99,Default,,0,0,0,,! هذا تسجيلٌ مرئي منذ 12 دقيقة
Dialogue: 0,0:22:46.56,0:22:49.88,Default,,0,0,0,,.هذه آخر مرةٍ قامت بها كاميرات المُراقبة بتصويرها
Dialogue: 0,0:22:50.12,0:22:54.51,Default,,0,0,0,,.دخلا بعدها عاملين النظافة ولكنهم خرجوا بعد 5 دقائق
Dialogue: 0,0:22:55.95,0:22:58.05,Default,,0,0,0,,تِلك العربة يمكن وضع شخصٍ ما بداخلها، صحيح ؟
Dialogue: 0,0:22:58.05,0:23:00.35,Default,,0,0,0,,.هاه ؟ لحظة، سنلقي نظرةً عليها
Dialogue: 0,0:23:00.77,0:23:03.11,Default,,0,0,0,,! لقد دخلا إلى غرفة الضغط
Dialogue: 0,0:23:05.63,0:23:07.51,Default,,0,0,0,,من يكون هؤلاء الأشخاص ؟
Dialogue: 0,0:23:10.36,0:23:12.65,Default,,0,0,0,,يمكن لأحدهم أن يخرج من هنا إلى البحر مُباشرةً، أليسَ كذلك ؟
Dialogue: 0,0:23:12.65,0:23:13.64,Default,,0,0,0,,.أجل
Dialogue: 0,0:23:13.64,0:23:17.85,Default,,0,0,0,,.نقوم بملئ هذه الغرفة بالماء، ليتعادل ضغط الماء فيها مع ضغط ماء البحر
Dialogue: 0,0:23:18.39,0:23:20.91,Default,,0,0,0,,.يُمكن لأي أحدٍ أن يخرج من هذه الغرفة إلى البحر مُباشرةً
Dialogue: 0,0:23:20.91,0:23:24.31,Default,,0,0,0,,جزيرة "هاتشيجوجيما" هي أقرب مكانٍ إلينا\N.على الرغم من أنها تبعد عنا مسافة الــ5 كيلو مترات
Dialogue: 0,0:23:25.48,0:23:27.84,Default,,0,0,0,,تُرى إلى أين قاموا بأخذ ناومي ؟
Dialogue: 0,0:23:28.00,0:23:30.91,Default,,0,0,0,,من لديه الصلاحية في التحكم بهذا الباب ؟
Dialogue: 0,0:23:33.82,0:23:39.78,Default,,0,0,0,,،يُمكن لأي أحدٍ فتح هذا الباب من الداخل \N ...ولكن ليسّ بإستطاعة أحدٍ فتحه من الخارج إلّا أنا
Dialogue: 0,0:23:40.04,0:23:43.81,Default,,0,0,0,,.والباقي الذين يستطيعون فتحه هم المُهندسون الذين قدمتهم لكم فيما سبق
Dialogue: 0,0:23:44.00,0:23:50.18,Default,,0,0,0,,.على هذه الحالة، سيكون بينكم من تواطئ مع الذين قاموا بخطف ناومي-سان
Dialogue: 0,0:23:50.61,0:23:51.82,Default,,0,0,0,,.أجل
Dialogue: 0,0:23:51.82,0:23:53.09,Default,,0,0,0,,...ولكن
Dialogue: 0,0:23:54.51,0:23:57.95,Default,,0,0,0,,.على كل حال، سأتصل بمركز العاصمة لكي يُرسلوا لنا الدعم
Dialogue: 0,0:23:59.39,0:24:01.51,Default,,0,0,0,,.ذلك الإختطاف حدث دون أي عقبات
Dialogue: 0,0:24:01.51,0:24:06.08,Default,,0,0,0,,.لا شك في ذلك، المجرمون كانوا يعلمون بأن ناومي-سان موجودةٌ في الحمام
Dialogue: 0,0:24:06.42,0:24:08.08,Default,,0,0,0,,ولكن إلى أين قاموا بأخذها ؟
Dialogue: 0,0:24:22.34,0:24:24.66,Default,,0,0,0,,.أوه يا له من لطيف
Dialogue: 0,0:24:32.44,0:24:34.74,Default,,0,0,0,,.يبدو أنه مُجرد ملفٍ للصور
Dialogue: 0,0:24:38.79,0:24:39.75,Default,,0,0,0,,...إنها
Dialogue: 0,0:24:39.75,0:24:41.07,Default,,0,0,0,,! شيري
Dialogue: 0,0:24:41.31,0:24:43.95,Default,,0,0,0,,! والطفلة التي في الصورة الثانية، تُشبهها تمامًا
Dialogue: 0,0:24:43.95,0:24:46.25,Default,,0,0,0,,!هل تم التقاط هذه الصورة لــ شيري عندما كانت طفلة ؟
Dialogue: 0,0:24:46.25,0:24:48.74,Default,,0,0,0,,.كلّا. لأن الصورة تبدو حديثةً تمامًا
Dialogue: 0,0:24:48.74,0:24:52.61,Default,,0,0,0,,.لو نظرنا إلى هاتف الرجل الذي بجانبها، لأرينا بأنه هاتفٌ من طِرازٍ حديث
Dialogue: 0,0:24:52.61,0:24:54.61,Default,,0,0,0,,...لقد فهمت
Dialogue: 0,0:24:54.61,0:24:56.78,Default,,0,0,0,,بمعنى آخر، ما الذي تقصده ؟
Dialogue: 0,0:24:56.78,0:24:59.41,Default,,0,0,0,,أيعقل أن تكون هذه الطفلة، هي "شيري" نفسها ؟
Dialogue: 0,0:25:03.00,0:25:06.35,Default,,0,0,0,,ما هذا المُزاح الذي تتفوه به يا "ڤودكا" ؟
Dialogue: 0,0:25:06.35,0:25:09.71,Default,,0,0,0,,.يُفترض بأن تكون "شيري" قد ماتت في قِطار "شجرة الجرس" بذلك الوقت
Dialogue: 0,0:25:14.18,0:25:18.08,Default,,0,0,0,,! أخبرتك بأنها حيّة وأعتقد بأنها تحولت بطريقةٍ ما إلى طفلة
Dialogue: 0,0:25:18.08,0:25:19.61,Default,,0,0,0,,!طفلة ؟
Dialogue: 0,0:25:19.61,0:25:24.41,Default,,0,0,0,,.لا أعلم ما هي الطريقة التي قامت بها، ولكنها طبيبة أدوية بعد كل شي
Dialogue: 0,0:25:24.41,0:25:25.93,Default,,0,0,0,,...أي أنها قد تكون
Dialogue: 0,0:25:25.93,0:25:28.08,Default,,0,0,0,,على كل حال، ما رأيك بأن أرسل لك ملف الصور ؟
Dialogue: 0,0:25:29.07,0:25:32.11,Default,,0,0,0,,.لا... بل سأراها بشكلٍ مُباشر
Dialogue: 0,0:25:32.29,0:25:35.08,Default,,0,0,0,,.إلى ذلك الحين، عليكَ أن تقوم بخطفها بأي وسيلة
Dialogue: 0,0:25:35.08,0:25:38.28,Default,,0,0,0,,! هاه ؟ ولكنني لا أملك أي معلومةٍ عن مكان إقامتها
Dialogue: 0,0:25:39.89,0:25:43.68,Default,,0,0,0,,...إذًا فلتستعمل ذلك النظام الغريب لكي
Dialogue: 0,0:25:47.45,0:25:49.38,Default,,0,0,0,,.تعثر على مكانها
Dialogue: 0,0:25:52.51,0:25:54.41,Default,,0,0,0,,.كما هو متوقعٌ من أخي الكبير
Dialogue: 0,0:25:54.41,0:25:55.96,Default,,0,0,0,,أتنوي سرقته ؟
Dialogue: 0,0:25:55.96,0:25:57.65,Default,,0,0,0,,.أرفض ذلك
Dialogue: 0,0:25:57.65,0:25:58.43,Default,,0,0,0,,هاه ؟
Dialogue: 0,0:25:58.43,0:26:01.41,Default,,0,0,0,,.يجب علينا أن لا نقوم بفعلٍ ما دون أن نخطط له جيدًا
Dialogue: 0,0:26:01.61,0:26:08.11,Default,,0,0,0,,سيتوجب علينا أولًا اختراق نظام التعرّف العمري لكي\N.نمسح صورنا من التسجيلات الماضية لكاميرات المُراقبة
Dialogue: 0,0:26:08.28,0:26:11.28,Default,,0,0,0,,.هذا أمرٌ من الزعيم
Dialogue: 0,0:26:11.28,0:26:13.28,Default,,0,0,0,,.أوافقها الرأي
Dialogue: 0,0:26:13.37,0:26:17.11,Default,,0,0,0,,.سنفشل في مهمتنا إن تحرّكنا دون تخطيطٍ مُسبق
Dialogue: 0,0:26:17.11,0:26:20.67,Default,,0,0,0,,.وأنا لن أُشارك معك، بسبب وضعي الحالي
Dialogue: 0,0:26:21.32,0:26:25.01,Default,,0,0,0,,.وأنا أيضًا لم أرغب بالعمل معكم منذ البداية
Dialogue: 0,0:26:25.82,0:26:27.51,Default,,0,0,0,,"سأعطي هذه المهمّة لــ "بينڠا
Dialogue: 0,0:26:27.77,0:26:32.31,Default,,0,0,0,,!وهل "بينڠا" هذا... سيُطيع أوامرك ؟
Dialogue: 0,0:26:32.31,0:26:34.92,Default,,0,0,0,,"بل سيُنفذ أي أمرٍ يُصدره "رام
Dialogue: 0,0:26:35.34,0:26:43.71,Default,,0,0,0,,"صار "بينڠا" ذراع "رام" اليُمنى بعد موت "كوراسو"\N .التي هي أيضًا كانت مثله الآن ذراعه اليُمنى فيما مضى
Dialogue: 0,0:26:44.25,0:26:48.27,Default,,0,0,0,,لماذا يُنفّذ ذلك المدعو "بينڠا" كل أوامر "رام" يا تُرى ؟
Dialogue: 0,0:26:48.27,0:26:52.35,Default,,0,0,0,,.أعتقد لأنه يُريد الحصول على مرتبةٍ أعلى عن طريق إعجاب "رام" به
Dialogue: 0,0:26:52.35,0:26:58.31,Default,,0,0,0,,أعرف هذا، فهو مُجرّد حُثالةٍ يسعى للحصول على مرتبةٍ أعلى\N .حتى لو كان على حِساب أذية الآخرين
Dialogue: 0,0:27:00.35,0:27:08.08,Default,,0,0,0,,إذًا هل تعرف، أن أول شخص يُخطط "بينڠا" للتخلص منه هو.. "جين" ؟
Dialogue: 0,0:27:09.18,0:27:17.18,Default,,0,0,0,,.وفوق ذلك، نظام التعرّف العمري هذا، هو بمثابة صندوقٍ يجب أن لا يُفتح
Dialogue: 0,0:27:17.44,0:27:19.32,Default,,0,0,0,,قاموا بإختطاف "ناومي" ؟
Dialogue: 0,0:27:19.32,0:27:23.85,Default,,0,0,0,,.كما أنه، على أرجح أن مساعد الخاطفين هو بيننا
Dialogue: 0,0:27:24.39,0:27:26.65,Default,,0,0,0,, !ما هذا الكلام الغبي الذي تتفوه به ؟
Dialogue: 0,0:27:26.65,0:27:29.88,Default,,0,0,0,,"نعم. ومع ذلك فنحن من "الانتربول
Dialogue: 0,0:27:29.88,0:27:33.58,Default,,0,0,0,,.أي أننا قادرون على أن نُزيل الشكوك التي أحاطت بنا متى شئنا
Dialogue: 0,0:27:33.58,0:27:37.30,Default,,0,0,0,,علينا أن نقوم بمُراجعة سجلّات البوابة الخارجية، صحيح ؟
Dialogue: 0,0:27:40.28,0:27:43.08,Default,,0,0,0,,! لا توجد أي سجلّات
Dialogue: 0,0:27:43.08,0:27:46.18,Default,,0,0,0,,إذًا ذلك يعني بأن أحدًا ما من الخارج قام بسرقتها، صحيح ؟
Dialogue: 0,0:27:47.56,0:27:49.18,Default,,0,0,0,,ما هذا الولد ؟
Dialogue: 0,0:27:49.18,0:27:57.12,Default,,0,0,0,,،هذا النظام يربط بين الشرطة اليابانية واليوربول\N .لذا يمكن ان يتم اختراقه بواسطة الباب الخلفي
Dialogue: 0,0:27:57.36,0:27:58.96,Default,,0,0,0,,...الباب الخلفي
Dialogue: 0,0:27:58.96,0:28:01.92,Default,,0,0,0,,.إنها ثغرة برمجية تُترك لكي يتم الاختراق عن طريقها
Dialogue: 0,0:28:02.04,0:28:04.31,Default,,0,0,0,,! وهذا يعني بأنهم يستهدفوننا
Dialogue: 0,0:28:05.12,0:28:06.36,Default,,0,0,0,,! أجل
Dialogue: 0,0:28:06.57,0:28:09.21,Default,,0,0,0,,"حادثة التسلل في "فرانكفورت
Dialogue: 0,0:28:09.21,0:28:16.17,Default,,0,0,0,,.كان هدف الجاني الحقيقي هو "عوامة المُحيط" التي اِتصلت بها "أوروبا" اليوم
Dialogue: 0,0:28:16.17,0:28:17.37,Default,,0,0,0,,...هكذا إذًا
Dialogue: 0,0:28:17.67,0:28:22.58,Default,,0,0,0,,.أمن الحواسيب ضعيفة أمام الهجوم الداخلي
Dialogue: 0,0:28:22.91,0:28:27.31,Default,,0,0,0,,في هذه الحالة، شركاء الخاطفين من "اليوروبول" الآن صحيح ؟
Dialogue: 0,0:28:27.38,0:28:33.21,Default,,0,0,0,,،لا. فالأشخاص الذين يُنشؤون الباب الخلفي\N .يُمكنهم الدخول إليه من أي مكانٍ في العالم
Dialogue: 0,0:28:33.36,0:28:40.98,Default,,0,0,0,,بمعنى آخر، فإن احتمالية أن يكون الشريك الخاطفين\N موجودٌ بينكم هو احتمالٌ واردٌ جدًا، صحيح ؟
Dialogue: 0,0:28:41.12,0:28:45.68,Default,,0,0,0,,...على الأرجح أنهم يسعون خلف نظام التعرّف العمري الشامل
Dialogue: 0,0:28:46.39,0:28:48.78,Default,,0,0,0,,.."اِسمه الحركي هو "بينڠا
Dialogue: 0,0:28:49.10,0:28:52.09,Default,,0,0,0,,هل للمظمة زُملاءٌ يعملون هنا أيضًا ؟
Dialogue: 0,0:28:52.57,0:28:54.21,Default,,0,0,0,,...أم أنه
Dialogue: 0,0:28:55.09,0:29:01.58,Default,,0,0,0,,والآن يا جماعة، أرجو منكم أن تُسلّموني هواتفكم\N .وحواسيبكم لكي نستمع لشهادتكم بعد ذلك
Dialogue: 0,0:29:02.08,0:29:04.41,Default,,0,0,0,,لا تُمانع ذلك، صحيح أيها المُدير "ماكينو" ؟
Dialogue: 0,0:29:04.62,0:29:06.30,Default,,0,0,0,,.نعم
Dialogue: 0,0:29:15.92,0:29:18.86,Default,,0,0,0,,لقد استمتعنا بمشاهدة الحيتان، صحيح ؟
Dialogue: 0,0:29:23.77,0:29:25.37,Default,,0,0,0,,متى سنذهب مرةً أُخرى ؟
Dialogue: 0,0:29:37.29,0:29:39.05,Default,,0,0,0,,...كُنتُ أنتظركم
Dialogue: 0,0:29:39.05,0:29:40.84,Default,,0,0,0,,.أُدعى "هانس" من اليوربول
Dialogue: 0,0:29:40.84,0:29:43.55,Default,,0,0,0,,.نشكر حضوركَ لأخذنا من الصباح الباكر
Dialogue: 0,0:29:43.55,0:29:46.11,Default,,0,0,0,,"سُررت بلقاءك، أُدعى "كامل
Dialogue: 0,0:29:46.11,0:29:47.52,Default,,0,0,0,,"وأنا "جيمس
Dialogue: 0,0:29:48.49,0:29:50.78,Default,,0,0,0,,..."يؤسفُنا ما حدث لــ "نينا
Dialogue: 0,0:29:50.78,0:29:52.38,Default,,0,0,0,,أكنتِ مُقربةً منها ؟
Dialogue: 0,0:29:53.07,0:29:54.38,Default,,0,0,0,,.أجل
Dialogue: 0,0:29:54.38,0:29:59.78,Default,,0,0,0,,.تبادلنا معلومات الإتصال عندما تعاونت مع "اليوربول" فيما سبق
Dialogue: 0,0:30:01.14,0:30:05.00,Default,,0,0,0,,.لنذهب إلى مركز شبكات التابع لليوربول
Dialogue: 0,0:30:05.00,0:30:06.10,Default,,0,0,0,,.حسنٌ
Dialogue: 0,0:30:16.17,0:30:18.85,Default,,0,0,0,,منذ متى وأنتِ تعملين هُنا يا ڠريس-سان ؟
Dialogue: 0,0:30:18.85,0:30:22.81,Default,,0,0,0,,.أعمل في هُنا في مجال التكنلوجيا منذ 5 سنوات
Dialogue: 0,0:30:23.70,0:30:31.45,Default,,0,0,0,,،عفوًا... في الوضع الذي نحن به الآن\N .يتوجب علينا أن نوقف النظام بالوقت الحالي
Dialogue: 0,0:30:32.18,0:30:35.11,Default,,0,0,0,,! لا فائدة.. لا يُمكننا القيام بذلك حتمًا
Dialogue: 0,0:30:35.11,0:30:36.48,Default,,0,0,0,,...لا.. ولكن
Dialogue: 0,0:30:36.48,0:30:40.28,Default,,0,0,0,,! سيفقد "الانتربول" ثتقهم بنا اِن أوقفنا النظام عند أول تشغيلٍ له
Dialogue: 0,0:30:40.45,0:30:43.09,Default,,0,0,0,,!لماذا يتوجب عليَّ أن أتحدث معكم ؟
Dialogue: 0,0:30:43.09,0:30:45.90,Default,,0,0,0,,متى بدأت العمل مع "الانتربول" ؟
Dialogue: 0,0:30:46.83,0:30:50.08,Default,,0,0,0,,! قد يكون شريك الخاطفين هو أحد رجال الشرطة اليابانية
Dialogue: 0,0:30:50.37,0:30:55.35,Default,,0,0,0,,! إنني أُمانع إيقافه أيضًا، لأننا نتعامل مع نظامٍ مُذهل بحق
Dialogue: 0,0:30:55.35,0:31:00.55,Default,,0,0,0,,حول العالم أليسَ كذلك ؟ IT لقد عملت فيما مضى بعديدٍ من شركات الــ
Dialogue: 0,0:31:01.98,0:31:04.82,Default,,0,0,0,,.ومع ذلك فإن العمل هُنا أعجبني أكثر
Dialogue: 0,0:31:04.82,0:31:08.48,Default,,0,0,0,,.يمكنني أن أرى كثيرًا من الحوادث المُثيرة كــ حادثة اليوم
Dialogue: 0,0:31:11.81,0:31:15.01,Default,,0,0,0,,.أنا جائعٌ يا أمي-\N .وأنا أيضًا-
Dialogue: 0,0:31:15.16,0:31:17.45,Default,,0,0,0,,! كان الطعام شهيًا
Dialogue: 0,0:31:17.45,0:31:21.25,Default,,0,0,0,,.المكان جميلٌ حقًا، والطعام به لذيذٌ جدًا
Dialogue: 0,0:31:21.46,0:31:23.31,Default,,0,0,0,,حتى الأجواء لطيفةٌ بشكلٍ عام، صحيح ؟
Dialogue: 0,0:31:23.31,0:31:24.75,Default,,0,0,0,,—أجل. كما أنه
Dialogue: 0,0:31:24.75,0:31:26.75,Default,,0,0,0,,! الأفضل
Dialogue: 0,0:31:27.10,0:31:28.91,Default,,0,0,0,,! إنه يُفسد كل شي
Dialogue: 0,0:31:28.91,0:31:33.46,Default,,0,0,0,,! أبي... أنت تُحرجنا بصوتك العالي لذا لا تصرخ
Dialogue: 0,0:31:35.02,0:31:38.55,Default,,0,0,0,,لذيذ ! .. ولكن طبق الأعشاب له مذاقٌ مُرّ بعض الشيء، صحيح ؟
Dialogue: 0,0:31:38.55,0:31:40.55,Default,,0,0,0,,.معك حق
Dialogue: 0,0:31:40.55,0:31:42.46,Default,,0,0,0,,.وطبق السوشي شهيّ أيضًا
Dialogue: 0,0:31:42.46,0:31:44.84,Default,,0,0,0,,وبعد... قُل لي أين ذهبت ؟
Dialogue: 0,0:31:44.84,0:31:46.61,Default,,0,0,0,,"إلى "عوامة المُحيط
Dialogue: 0,0:31:46.61,0:31:48.21,Default,,0,0,0,,! لقد توقعتُ ذلك
Dialogue: 0,0:31:48.21,0:31:49.60,Default,,0,0,0,,وماذا فعلت هناك ؟
Dialogue: 0,0:31:49.60,0:31:51.46,Default,,0,0,0,,...لا، لا شيء
Dialogue: 0,0:31:51.46,0:31:56.21,Default,,0,0,0,,! لقد كان منظر الحيتان رائعًا للغاية يا كونان-كن
Dialogue: 0,0:31:56.21,0:31:58.65,Default,,0,0,0,,.والعم صاحب الحيتان أخبرنا الكثير عنهم
Dialogue: 0,0:31:58.65,0:32:00.70,Default,,0,0,0,,.وبحثنا عن المعلومات حولها بالجهاز اللوحي أيضًا
Dialogue: 0,0:32:00.70,0:32:02.70,Default,,0,0,0,,العم صاحب الحيتان ؟
Dialogue: 0,0:32:02.70,0:32:05.95,Default,,0,0,0,,.أنظر... إلى هذا
Dialogue: 0,0:32:05.95,0:32:07.83,Default,,0,0,0,,!ما هذه الصورة ؟
Dialogue: 0,0:32:08.49,0:32:11.02,Default,,0,0,0,,.لقد انسجمعنا مع بعضنا كثيرًا
Dialogue: 0,0:32:11.02,0:32:16.58,Default,,0,0,0,,! تذكرت ! سأساعدكم على هضم الطعام بالمعلومات التي أملكها حول الحيتان
Dialogue: 0,0:32:17.48,0:32:19.11,Default,,0,0,0,,هل يُعقل أنه... ؟
Dialogue: 0,0:32:19.28,0:32:21.71,Default,,0,0,0,,! لُغز الحيتان
Dialogue: 0,0:32:21.71,0:32:24.11,Default,,0,0,0,,وهل اللُغز حول الحيتان سيُساعدنا على الهضم ؟
Dialogue: 0,0:32:24.11,0:32:26.63,Default,,0,0,0,,! إلى جميع من يحب الحيتان
Dialogue: 0,0:32:26.63,0:32:31.41,Default,,0,0,0,,!والآن، كيف تعرفون أن الحوت غاضبٌ أم لا ؟
Dialogue: 0,0:32:32.39,0:32:34.44,Default,,0,0,0,,أولًا: من أُذنيه ؟
Dialogue: 0,0:32:34.51,0:32:36.68,Default,,0,0,0,,ثانيًا: من أنفه ؟
Dialogue: 0,0:32:36.93,0:32:38.98,Default,,0,0,0,, ثالثًا: من فمه ؟
Dialogue: 0,0:32:38.98,0:32:41.35,Default,,0,0,0,,رابعًا: من عينيه ؟
Dialogue: 0,0:32:41.35,0:32:44.08,Default,,0,0,0,,حسنٌ، ما هي الإجابة الصحيحة ؟
Dialogue: 0,0:32:44.94,0:32:47.88,Default,,0,0,0,,!هاه ؟ أتقول عندما يكون الحوت غاضبًا ؟
Dialogue: 0,0:32:47.88,0:32:50.61,Default,,0,0,0,,....من أُذنيه أم من أنفه أم من فمه أم من عينيه
Dialogue: 0,0:32:50.61,0:32:54.15,Default,,0,0,0,,!لم نعرف الأجابة لذا هل لديك أيُّ تلميحٍ يا كونان ؟
Dialogue: 0,0:32:54.15,0:32:58.27,Default,,0,0,0,,حسنٌ، برأيكم ما هي التعابير التي تظهر عند الغضب ؟
Dialogue: 0,0:33:01.87,0:33:04.55,Default,,0,0,0,,.إنها نفس تعابير وجهك الغاضب يا ايشدا-سان
Dialogue: 0,0:33:04.55,0:33:06.55,Default,,0,0,0,,!وجهي الغاضب ؟
Dialogue: 0,0:33:06.55,0:33:08.33,Default,,0,0,0,,أتقصدين هكذا ؟
Dialogue: 0,0:33:08.47,0:33:10.51,Default,,0,0,0,,أين وضعتِ إصبعيكِ ؟
Dialogue: 0,0:33:10.51,0:33:13.16,Default,,0,0,0,,عند الزوايا الخارجية لعينيها، صحيح ؟
Dialogue: 0,0:33:13.18,0:33:15.91,Default,,0,0,0,,"قُلتَ "ميجيري" ويُصّطلح عليها بإسم "ميكوجيري
Dialogue: 0,0:33:13.18,0:33:15.91,aaaa,,0,0,0,,{\pos(970.667,116.333)\fscx120\fscy125}-ميجيري=زوايا العينين الخارجية ... ميكوجيري=تنزيل جفن العين عند الغضب أو النعاس-
Dialogue: 0,0:33:15.91,0:33:19.15,Default,,0,0,0,,! ميكوجيري ؟! .. لقد فهمت
Dialogue: 0,0:33:19.76,0:33:22.45,Default,,0,0,0,,.إذًا تِلك الكلمة جائت من هذا المفهوم
Dialogue: 0,0:33:22.58,0:33:24.45,Default,,0,0,0,,!ميكوجيري ؟
Dialogue: 0,0:33:24.58,0:33:28.81,Default,,0,0,0,,! فهمت !! .. إذًا تلميح "ميكوجيري" تعني الخِيار الرابع: من عينيه
Dialogue: 0,0:33:29.00,0:33:32.41,Default,,0,0,0,,! أصبت ! .. وبذلك يكون ميتسيهيكو-كن من فاز
Dialogue: 0,0:33:32.41,0:33:34.15,Default,,0,0,0,,! فعلتها
Dialogue: 0,0:33:34.15,0:33:37.51,Default,,0,0,0,,! ولكننا من قام بتسهيل الإجابة لك
Dialogue: 0,0:33:38.10,0:33:40.01,Default,,0,0,0,,...لقد شاركت معنا بالتلميح يا غينتا-كن
Dialogue: 0,0:33:38.83,0:33:40.58,Default,,0,0,0,,...اسمع يا بروفيسور
Dialogue: 0,0:33:41.29,0:33:43.15,Default,,0,0,0,,هل يُمكننا التحدث قليلًا فيما بعد ؟
Dialogue: 0,0:33:43.15,0:33:45.22,Default,,0,0,0,,!هل هنالكَ أمرٌ ما ؟
Dialogue: 0,0:33:45.22,0:33:46.51,Default,,0,0,0,,...لا فقط قليلًا
Dialogue: 0,0:33:49.89,0:33:52.47,Default,,0,0,0,,!ما الذي تقوله ؟-\N! اخفض صوتكَ رجاءً-
Dialogue: 0,0:33:54.02,0:33:57.07,Default,,0,0,0,,إذًا كان ذلك من أفعال المُنظمة السوداء ؟
Dialogue: 0,0:33:57.07,0:33:59.07,Default,,0,0,0,,...هذا ما أظنه
Dialogue: 0,0:33:59.07,0:34:03.01,Default,,0,0,0,,.لقد فهمت، إذًا هذا ما يحدث
Dialogue: 0,0:34:03.67,0:34:05.51,Default,,0,0,0,,!منذ متى وأنتِ تتنسطين علينا ؟
Dialogue: 0,0:34:05.51,0:34:08.61,Default,,0,0,0,,.منذ أن بدأت بالتحدث عن تِلك المُهندسة
Dialogue: 0,0:34:08.95,0:34:10.61,Default,,0,0,0,,! لقد سمعت كل شيء
Dialogue: 0,0:34:10.61,0:34:13.68,Default,,0,0,0,,هل حقًا هم من قاموا بإختطافها ؟
Dialogue: 0,0:34:13.68,0:34:15.68,Default,,0,0,0,,...هذا ما أظنه
Dialogue: 0,0:34:15.68,0:34:19.08,Default,,0,0,0,,.لذلك ستُغادرين هذا المكان مع الأولاد في صباح الغد
Dialogue: 0,0:34:19.08,0:34:22.05,Default,,0,0,0,,.أجل. سأفعل ذلك من دون أن تطلب مني
Dialogue: 0,0:34:22.05,0:34:24.50,Default,,0,0,0,,وبطيعة الحال ستكون معنا، صحيح ؟
Dialogue: 0,0:34:32.60,0:34:33.91,Default,,0,0,0,,ما معنى ذلك ؟
Dialogue: 0,0:34:33.91,0:34:36.25,Default,,0,0,0,,! إنني أحمل النظارات الإحتياطية بكل الأحوال
Dialogue: 0,0:34:36.25,0:34:39.88,Default,,0,0,0,,.إنها أول نظارةٍ اخترعها لي البروفيسور
Dialogue: 0,0:34:40.22,0:34:45.68,Default,,0,0,0,,! ألم أُخبركِ من قبل، أنكِ بمُجرد أن تضعيها فلن يكشف هويتكِ أحد
Dialogue: 0,0:34:47.74,0:34:52.28,Default,,0,0,0,,.فيما سبق، اختطفني "بيسكو" بكل سهولةٍ وقد كنتُ أضعها آن ذاك
Dialogue: 0,0:34:54.09,0:34:56.52,Default,,0,0,0,,ولكنني انقذتُكِ بعد ذلك، أليسَ كذلك ؟
Dialogue: 0,0:34:56.81,0:34:59.75,Default,,0,0,0,,.يُمكنُكِ أن تعتبريها كــ تميمة لكي تحميكِ
Dialogue: 0,0:35:01.81,0:35:04.68,Default,,0,0,0,,.سأقوم بأخذ النظارات الإحتياطية عوضًا عنها
Dialogue: 0,0:35:06.93,0:35:10.11,Default,,0,0,0,,.حسنٌ، لعند يا آي-كن-\N.حاضرة-
Dialogue: 0,0:35:14.66,0:35:16.53,Default,,0,0,0,,!تميمة، صحيح ؟
Dialogue: 0,0:35:29.62,0:35:32.91,Default,,0,0,0,,.يبدو أننا عثرنا على تِلك الطلفة عن طريق النظام
Dialogue: 0,0:35:40.70,0:35:43.31,Default,,0,0,0,,"وأنا أيضًا وجدتها يا "جين
Dialogue: 0,0:35:43.31,0:35:46.38,Default,,0,0,0,,! "أيُعقل أن تكون مُقيمةٌ في "هاتشيوجيما
Dialogue: 0,0:35:46.38,0:35:48.38,Default,,0,0,0,,.لقد حالفنا الحظ هذه المرة
Dialogue: 0,0:36:25.85,0:36:27.45,Default,,0,0,0,,! مرحبًا
Dialogue: 0,0:36:32.41,0:36:33.71,Default,,0,0,0,,...ايــ
Dialogue: 0,0:36:36.63,0:36:37.74,Default,,0,0,0,,!هايبرا.. ؟
Dialogue: 0,0:36:37.95,0:36:39.63,Default,,0,0,0,,...أ- أيُعقل أنها
Dialogue: 0,0:36:49.02,0:36:51.75,Default,,0,0,0,,! بروفيسور، لقد اختطفوا هايبرا
Dialogue: 0,0:36:51.75,0:36:53.36,Default,,0,0,0,,!ما الذي تقوله ؟
Dialogue: 0,0:36:54.29,0:36:55.61,Default,,0,0,0,,! ڤودكا
Dialogue: 0,0:36:55.61,0:36:57.48,Default,,0,0,0,,! سُحقًا، لن أصل بالوقت المُناسب
Dialogue: 0,0:36:57.48,0:37:00.98,Default,,0,0,0,,.ان نزلوا عبر مدخل الطوارئ، فيسكونون متواجدين عند صفّ السيارات
Dialogue: 0,0:37:00.98,0:37:03.86,Default,,0,0,0,,! قم بتشغيل السيارة يا بروفيسور- \N .سأقوم بذلك-
Dialogue: 0,0:37:08.03,0:37:10.37,Default,,0,0,0,,! "ضفائر ؟ .. ذلك الشخص هو "بينڠا
Dialogue: 0,0:37:12.05,0:37:13.66,Default,,0,0,0,,...عليّ الاسراع
Dialogue: 0,0:37:14.17,0:37:15.90,Default,,0,0,0,,...كم هذا سهل
Dialogue: 0,0:37:21.74,0:37:22.83,Default,,0,0,0,,!! ران
Dialogue: 0,0:37:27.92,0:37:29.14,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,0:37:31.52,0:37:32.78,Default,,0,0,0,,!من أنتِ يا هذا ؟
Dialogue: 0,0:37:32.78,0:37:34.91,Default,,0,0,0,,! أعيد إلينا آي-تشان
Dialogue: 0,0:37:36.89,0:37:38.07,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,0:37:41.26,0:37:43.12,Default,,0,0,0,,! سُحقًا ! .. هذا لا يُصدّق
Dialogue: 0,0:38:02.32,0:38:04.50,Default,,0,0,0,,! دعها وشأنها ولنذهب من هنا
Dialogue: 0,0:38:04.50,0:38:06.30,Default,,0,0,0,,! انتظر رجاءً
Dialogue: 0,0:38:06.30,0:38:09.96,Default,,0,0,0,,! لا أعلم من تكونين ولكن... ستموتين في الحال
Dialogue: 0,0:38:09.96,0:38:11.28,Default,,0,0,0,,! هذا سيء
Dialogue: 0,0:38:17.57,0:38:19.41,Default,,0,0,0,,!ما الذي حدث للتو ؟
Dialogue: 0,0:38:21.53,0:38:24.85,Default,,0,0,0,,..لنقم بمانادة أحدٍ ما يا كونان-\N! لا فائدة-
Dialogue: 0,0:38:24.85,0:38:28.51,Default,,0,0,0,,! لا تتحركي من مكانك، حتى أُخبركِ بذلك
Dialogue: 0,0:38:30.38,0:38:31.88,Default,,0,0,0,,.أجل
Dialogue: 0,0:38:38.52,0:38:40.87,Default,,0,0,0,,...على بعد 200 متر تقريبًا
Dialogue: 0,0:38:43.01,0:38:44.96,Default,,0,0,0,,! الآن... فلتركضي
Dialogue: 0,0:38:47.39,0:38:48.61,Default,,0,0,0,,! فلتموتي
Dialogue: 0,0:38:49.12,0:38:50.12,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,0:38:50.71,0:38:52.31,Default,,0,0,0,,!سُحقًا، من قام بذلك ؟
Dialogue: 0,0:38:52.31,0:38:53.84,Default,,0,0,0,,! عظيم
Dialogue: 0,0:38:55.64,0:38:57.51,Default,,0,0,0,,! اِصعد يا شينشي
Dialogue: 0,0:38:59.49,0:39:02.81,Default,,0,0,0,,! فلتستيقظ يا أبي، هنالك مُصيبةٌ قد حدثت
Dialogue: 0,0:39:02.81,0:39:05.86,Default,,0,0,0,,! ران، سأطلب منكِ معروفًا... اِجلي لي الجعة
Dialogue: 0,0:39:08.29,0:39:10.38,Default,,0,0,0,,! أيها الوغد
Dialogue: 0,0:39:14.32,0:39:17.45,Default,,0,0,0,,.هذا مُطمئن، إنها تحمل شارة المُتحريين
Dialogue: 0,0:39:18.29,0:39:19.98,Default,,0,0,0,,لما اختطفوا آي-كن يا تُرى ؟
Dialogue: 0,0:39:20.21,0:39:24.38,Default,,0,0,0,,! "على الأرجح بأنهم... قد اكتشفوا بأنها "شيري
Dialogue: 0,0:39:24.38,0:39:25.97,Default,,0,0,0,,!ماذا تقول ؟
Dialogue: 0,0:39:30.46,0:39:32.51,Default,,0,0,0,,.أجل. بعد 5 دقائق
Dialogue: 0,0:39:32.51,0:39:33.56,Default,,0,0,0,,! سُحقًا
Dialogue: 0,0:39:33.56,0:39:35.56,Default,,0,0,0,,...واجهنا عائقًا بسيطًا
Dialogue: 0,0:39:36.63,0:39:39.66,Default,,0,0,0,,.سأقتُلها بالمرة المُقبلة
Dialogue: 0,0:39:42.53,0:39:44.48,Default,,0,0,0,,!ما تِلك السيارة ؟
Dialogue: 0,0:39:45.89,0:39:47.95,Default,,0,0,0,,! هاهم .. إنهم هم بالتأكيد
Dialogue: 0,0:39:47.95,0:39:49.80,Default,,0,0,0,,! ليتحرّك كُلٌّ منا على حدى
Dialogue: 0,0:40:02.85,0:40:05.25,Default,,0,0,0,,! إنهم يسلكون طريقًا وعرًا
Dialogue: 0,0:40:05.25,0:40:08.61,Default,,0,0,0,,! قد يكون طريق الجبل فخًا لنا يا بروفيسور ! ... أياكَ أن تتهور
Dialogue: 0,0:40:08.61,0:40:09.75,Default,,0,0,0,,! أجل
Dialogue: 0,0:40:14.24,0:40:19.98,Default,,0,0,0,,يُريدون أن نلحق بهم وأن نكمل مسارنا بالطريق الجبلي\N.في حين أنهم سيقطعونه للعبور إلى الطريق الرئيسي
Dialogue: 0,0:40:19.98,0:40:22.97,Default,,0,0,0,,! لن يستطيعوا الهرب من خلال طريق "هاتشيجوفوجي" إلّا كما أخبرتك
Dialogue: 0,0:40:23.50,0:40:25.91,Default,,0,0,0,,! لنقم بالإلتفاف حولهم ثم مُحاصرتهم
Dialogue: 0,0:40:39.11,0:40:41.70,Default,,0,0,0,,! حدث كما توقعته يا شينتشي
Dialogue: 0,0:40:41.70,0:40:43.97,Default,,0,0,0,,! لقد خرجوا إلى الطريق الرئيسي
Dialogue: 0,0:40:43.97,0:40:45.73,Default,,0,0,0,,.أجل. إنني أراهم من هنا
Dialogue: 0,0:40:45.73,0:40:48.02,Default,,0,0,0,,! سأصطدم بهم لأقوم بإيقافهم
Dialogue: 0,0:40:51.75,0:40:54.51,Default,,0,0,0,,! يجب عليَّ فعل شيءٍ ما قبل البروفيسور
Dialogue: 0,0:40:54.51,0:40:56.51,Default,,0,0,0,,...خياري الوحيد هو أن أنومهم بالساعة
Dialogue: 0,0:41:01.54,0:41:02.75,Default,,0,0,0,,...هاقد جائوا
Dialogue: 0,0:41:04.69,0:41:07.97,Default,,0,0,0,,! لديّ فُرصةٌ واحدة فقط، إمّا أن تُصيب أو تُخيب
Dialogue: 0,0:41:15.19,0:41:15.98,Default,,0,0,0,,! سُحقًا
Dialogue: 0,0:41:19.97,0:41:21.65,Default,,0,0,0,,!إلى أين ينون الذهاب ؟
Dialogue: 0,0:41:21.65,0:41:23.65,Default,,0,0,0,,...هذه الطريق تُؤدي إلى
Dialogue: 0,0:41:24.29,0:41:25.34,Default,,0,0,0,,!أيُعقل... ؟
Dialogue: 0,0:41:30.06,0:41:31.66,Default,,0,0,0,,! لا أُصدّق
Dialogue: 0,0:41:31.66,0:41:33.17,Default,,0,0,0,,! آي-كن
Dialogue: 0,0:41:39.07,0:41:40.19,Default,,0,0,0,,! سُحقًا
Dialogue: 0,0:41:40.41,0:41:41.79,Default,,0,0,0,,! شينتشي
Dialogue: 0,0:42:27.18,0:42:29.32,Default,,0,0,0,,! سيء ! .. لم أعد أستطيع التنفس
Dialogue: 0,0:42:33.22,0:42:35.96,Default,,0,0,0,,! هايبرا ! .. هايبرا
Dialogue: 0,0:42:40.15,0:42:41.88,Default,,0,0,0,,ما هذه الضوضاء ؟
Dialogue: 0,0:43:01.85,0:43:03.55,Default,,0,0,0,,!بجدية ؟
Dialogue: 0,0:43:05.15,0:43:06.57,Default,,0,0,0,,! سيء
Dialogue: 0,0:43:32.16,0:43:33.18,Default,,0,0,0,,...مُستحيل
Dialogue: 0,0:43:33.35,0:43:36.21,Default,,0,0,0,,! لماذا... يا آي-كن
Dialogue: 0,0:43:49.06,0:43:50.31,Default,,0,0,0,,...يا بروفيسور
Dialogue: 0,0:43:51.15,0:43:52.31,Default,,0,0,0,,...هايبرا
Dialogue: 0,0:43:54.37,0:43:56.88,Default,,0,0,0,,! سأُعيدُها منهم بكل تأكيد
Dialogue: 0,0:44:00.80,0:44:02.37,Default,,0,0,0,,!غواصة ؟
Dialogue: 0,0:44:02.37,0:44:03.25,Default,,0,0,0,,.نعم
Dialogue: 0,0:44:03.25,0:44:04.77,Default,,0,0,0,,!معقول ؟
Dialogue: 0,0:44:05.14,0:44:07.04,Default,,0,0,0,,!هل رأيتها أنت أيضًا يا آڠاسا-سان ؟
Dialogue: 0,0:44:07.04,0:44:10.11,Default,,0,0,0,,.لا، فالمكان كان مُظلمًا للغاية
Dialogue: 0,0:44:11.96,0:44:15.31,Default,,0,0,0,,—رُبما لأنك كُنت خائفًا شعرتَ بأنها-\N! كلّا-
Dialogue: 0,0:44:15.41,0:44:18.38,Default,,0,0,0,,! لقد شاهدتها حقًا وأنا مُتأكدٌ من ذلك
Dialogue: 0,0:44:19.85,0:44:21.41,Default,,0,0,0,,.إهدأ من فضلك
Dialogue: 0,0:44:27.14,0:44:28.38,Default,,0,0,0,,...كونان-كن
Dialogue: 0,0:44:29.12,0:44:31.18,Default,,0,0,0,,أين رأيتها بالتحديد ؟
Dialogue: 0,0:44:34.40,0:44:36.45,Default,,0,0,0,,.هنا.. لا شك في ذلك
Dialogue: 0,0:44:37.38,0:44:38.73,Default,,0,0,0,,.عند المنارة
Dialogue: 0,0:44:39.01,0:44:42.41,Default,,0,0,0,,...هنالك كاميرات مُراقبةٍ تابعة للشرطة ولخفر السواحل
Dialogue: 0,0:44:42.91,0:44:44.85,Default,,0,0,0,,.لنلقي نظرةً على التسجيلات-\N.حاضرة-
Dialogue: 0,0:44:47.81,0:44:51.35,Default,,0,0,0,,تُرى هل آي-كن على ما يُرام ؟
Dialogue: 0,0:44:51.56,0:44:52.84,Default,,0,0,0,,! صحيح
Dialogue: 0,0:44:54.08,0:44:56.55,Default,,0,0,0,,! هايبرا ! .. هايبرا
Dialogue: 0,0:44:56.55,0:44:58.55,Default,,0,0,0,,.لا جدوى من المُحاولة
Dialogue: 0,0:44:59.89,0:45:03.35,Default,,0,0,0,,.وفوق ذلك، رُبما قد يسمعون صوتك
Dialogue: 0,0:45:05.40,0:45:06.65,Default,,0,0,0,,.معك حق
Dialogue: 0,0:45:07.92,0:45:10.01,Default,,0,0,0,,"يجب علينا البحث عن ذلك المدعو "بينڠا
Dialogue: 0,0:45:10.13,0:45:11.22,Default,,0,0,0,,!بينڠا ؟
Dialogue: 0,0:45:11.22,0:45:14.05,Default,,0,0,0,,.أجل. اِنه أحد أفراد العصابة
Dialogue: 0,0:45:15.75,0:45:17.71,Default,,0,0,0,,غواصة إذًا ؟
Dialogue: 0,0:45:17.71,0:45:20.38,Default,,0,0,0,,.لا يُمكن لأي بُندقيةٍ أن تواجه غواصة
Dialogue: 0,0:45:20.52,0:45:22.38,Default,,0,0,0,,ما العمل إذًا ؟
Dialogue: 0,0:45:22.56,0:45:25.05,Default,,0,0,0,,.سأفكر بحلٍ يجدي أمام الغواصة
Dialogue: 0,0:45:25.05,0:45:26.88,Default,,0,0,0,,كيف ستستعيد تِلك الطفلة ؟
Dialogue: 0,0:45:26.88,0:45:28.92,Default,,0,0,0,,.سأفكر أيضًا بحلٍ ما من أجل ذلك
Dialogue: 0,0:45:28.92,0:45:31.35,Default,,0,0,0,,سأدع أمر الغواصة لك يا آكاي-سان
Dialogue: 0,0:45:31.35,0:45:33.91,Default,,0,0,0,,.أجل، أعرف ذلك
Dialogue: 0,0:45:36.95,0:45:41.98,Default,,0,0,0,,.لا تقلقي، سأُحقق بالأمر وأتصل بالبروفيسور بما وصلتُ إليه
Dialogue: 0,0:45:42.46,0:45:45.28,Default,,0,0,0,,ألن تأتي إلى هنا يا شينشي ؟
Dialogue: 0,0:45:45.80,0:45:48.45,Default,,0,0,0,,.الطفلة التي اخطتفت هي أحد معارفي
Dialogue: 0,0:45:48.45,0:45:49.91,Default,,0,0,0,,.أعرف ذلك
Dialogue: 0,0:45:50.24,0:45:53.28,Default,,0,0,0,,.إن حدث أمرٌ ما يتطلب وجودي، فسأحضر في الحال
Dialogue: 0,0:45:53.52,0:45:56.05,Default,,0,0,0,,حقًا ؟ هل أعتبره وعدًا منك ؟
Dialogue: 0,0:45:56.36,0:45:57.38,Default,,0,0,0,,..أجل
Dialogue: 0,0:46:00.71,0:46:04.31,Default,,0,0,0,,.سأحضر إن تطلب الأمر ذلك
Dialogue: 0,0:46:58.72,0:47:03.88,Default,,0,0,0,,.لا شك بأن "كودو شينتشي" قد تقلّص جسده مثلي تمامًا
Dialogue: 0,0:47:09.01,0:47:11.05,Default,,0,0,0,,..."في تِلك الحالة فإن "كودو شينتشي
Dialogue: 0,0:47:15.79,0:47:17.18,Default,,0,0,0,,...عفوًا
Dialogue: 0,0:47:27.35,0:47:30.75,Default,,0,0,0,,! لقد اِشتقتُ لكِ يا... شيري
Dialogue: 0,0:47:44.62,0:47:46.15,Default,,0,0,0,,...هذا مُطمئن
Dialogue: 0,0:47:48.12,0:47:49.48,Default,,0,0,0,,!من تكونين ؟
Dialogue: 0,0:47:51.00,0:47:52.60,Default,,0,0,0,,تبدين خائفة، صحيح ؟
Dialogue: 0,0:47:55.29,0:47:58.01,Default,,0,0,0,,...لقد شاهدتكِ في الأخبار
Dialogue: 0,0:47:58.58,0:47:59.80,Default,,0,0,0,,ماذا قُلتِ ؟
Dialogue: 0,0:47:59.80,0:48:00.86,Default,,0,0,0,,...لا شيء
Dialogue: 0,0:48:01.04,0:48:02.62,Default,,0,0,0,,أين نحن بالضبط ؟
Dialogue: 0,0:48:02.62,0:48:07.32,Default,,0,0,0,,.أظن باننا داخل غواصةـ، ولكنني لستُ مُتأكدة من ذلك
Dialogue: 0,0:48:11.93,0:48:13.34,Default,,0,0,0,,...أحدهم قد
Dialogue: 0,0:48:13.56,0:48:15.34,Default,,0,0,0,,ما الأمر ؟
Dialogue: 0,0:48:15.60,0:48:19.55,Default,,0,0,0,,إنكِ تُشبهين حقًا "شيهو" بنسبةٍ عالية
Dialogue: 0,0:48:20.86,0:48:25.68,Default,,0,0,0,,.لا. "شيهو" كبيرة الآن، لذا أنتِ تُشبهينها عندما كانت صغيرة
Dialogue: 0,0:48:25.96,0:48:27.99,Default,,0,0,0,,.هاه ؟ لقد فهمت
Dialogue: 0,0:48:30.44,0:48:34.85,Default,,0,0,0,,!هاه ؟ .. أوي، لماذا هي غير مُقيّدة ؟
Dialogue: 0,0:48:34.85,0:48:37.26,Default,,0,0,0,,.إنها مُجرّد طفلة، لا داعي لتقييدها
Dialogue: 0,0:48:37.26,0:48:39.04,Default,,0,0,0,,.يجب علينا أخذ الحيطة في كل وقت
Dialogue: 0,0:48:39.04,0:48:41.20,Default,,0,0,0,,.لك ذلك، سأقيدها بنفسي
Dialogue: 0,0:48:41.20,0:48:44.32,Default,,0,0,0,,إنكَ تسعى لتحقيق هذا، صحيح ؟
Dialogue: 0,0:48:44.33,0:48:45.61,Default,,0,0,0,,.أجل
Dialogue: 0,0:48:46.54,0:48:47.98,Default,,0,0,0,,.اعطني قدميكِ
Dialogue: 0,0:48:56.29,0:48:57.40,Default,,0,0,0,,.ويديكِ أيضًا
Dialogue: 0,0:49:09.98,0:49:13.18,Default,,0,0,0,,...ولكني لا أصدق ذلك
Dialogue: 0,0:49:15.15,0:49:17.58,Default,,0,0,0,,أنتِ هي "شيري" أليسَ كذلك ؟
Dialogue: 0,0:49:22.06,0:49:25.61,Default,,0,0,0,,أوي، تُشير هذه الصورة أن الطفلة هي نفسها هذه المرأة، صحيح ؟
Dialogue: 0,0:49:25.61,0:49:27.23,Default,,0,0,0,,...انها
Dialogue: 0,0:49:31.82,0:49:36.01,Default,,0,0,0,,.حسنٌ لا يُهم، لأنكِ لن تظلي صامةً طول الوقت
Dialogue: 0,0:49:36.01,0:49:39.28,Default,,0,0,0,,"سنُبقي على حياتها حتى تُقابل "رام
Dialogue: 0,0:49:39.28,0:49:41.93,Default,,0,0,0,,.سيُقابلها أخي "جين" قبله بكل تأكيد
Dialogue: 0,0:49:50.59,0:49:52.25,Default,,0,0,0,,هاه ؟ آي-تشان مريضة ؟
Dialogue: 0,0:49:52.25,0:49:54.64,Default,,0,0,0,,! ولكن البارحة كانت بخير
Dialogue: 0,0:49:54.64,0:49:57.33,Default,,0,0,0,,! في تِلك الحالة، سنذهب لكي نطمئن عليها
Dialogue: 0,0:49:57.33,0:50:00.75,Default,,0,0,0,,! بالتأكيد ! .. وسنشتري وجبات ثُعبان البحر
Dialogue: 0,0:50:00.86,0:50:03.88,Default,,0,0,0,,! لا يُمكنكم ذلك، والّا ستنتقل عدوى الزكام إليكم
Dialogue: 0,0:50:04.09,0:50:06.57,Default,,0,0,0,,ألهذه الدرجة حالة آي-تشان سيئة ؟
Dialogue: 0,0:50:06.57,0:50:09.51,Default,,0,0,0,,.إنها بالمشفى حاليًا، لذا ستكون على ما يُرام
Dialogue: 0,0:50:09.63,0:50:10.56,Default,,0,0,0,,...ولكن
Dialogue: 0,0:50:10.56,0:50:14.85,Default,,0,0,0,,لقد حجزتُ لكم قاربًا كبيرًا، لذا استعدوا للرحيل، اتفقنا ؟
Dialogue: 0,0:50:15.08,0:50:16.57,Default,,0,0,0,,...حاضر=
Dialogue: 0,0:50:16.57,0:50:17.80,Default,,0,0,0,,...موري-كن
Dialogue: 0,0:50:17.80,0:50:18.97,Default,,0,0,0,, .حضرة المفتش
Dialogue: 0,0:50:18.97,0:50:22.40,Default,,0,0,0,,.المعذرة منك، أريد أن تأتي معي أنت وكونان-كن
Dialogue: 0,0:50:30.68,0:50:33.57,Default,,0,0,0,,.المعذرة، انتظروني قليلًا، سأُنهي المُكالمة وأعود بسرعة
Dialogue: 0,0:50:33.57,0:50:35.93,Default,,0,0,0,,ما الذي يفعله ذلك الولد ؟
Dialogue: 0,0:50:36.70,0:50:39.08,Default,,0,0,0,,...مـ مؤلم، مؤلم
Dialogue: 0,0:50:40.76,0:50:41.91,Default,,0,0,0,,...مرحبًا
Dialogue: 0,0:50:42.58,0:50:43.58,Default,,0,0,0,,.يا آمورو-سان
Dialogue: 0,0:50:43.58,0:50:47.31,Default,,0,0,0,,الفتاة التي تم اختطافها من الفُندق هي أحد معارفك صحيح ؟
Dialogue: 0,0:50:47.31,0:50:49.39,Default,,0,0,0,,هل يُعقل ان اتصال الأمس منك كان لأجل.. ؟
Dialogue: 0,0:50:49.39,0:50:51.78,Default,,0,0,0,,.سينضم "جين" إلينا عند حلول المساء
Dialogue: 0,0:50:52.28,0:50:54.18,Default,,0,0,0,,أي أنه سيركب معكم في الغواصة ؟
Dialogue: 0,0:50:54.18,0:50:57.13,Default,,0,0,0,,.وهل عرفت بأمرها ؟ .. كما هو متوقعٌ منك
Dialogue: 0,0:50:57.47,0:51:01.11,Default,,0,0,0,,...سيأتي إلى الغواصة من الجو، بمعنى آخر في ذلك الوقت سوفَ
Dialogue: 0,0:51:01.70,0:51:04.71,Default,,0,0,0,,تطفو إلى سطح البحر، صحيح ؟
Dialogue: 0,0:51:04.71,0:51:05.60,Default,,0,0,0,,...أجل
Dialogue: 0,0:51:06.01,0:51:08.28,Default,,0,0,0,,! أوي !! .. هيا بنا
Dialogue: 0,0:51:09.58,0:51:12.58,Default,,0,0,0,,.إن أردت انقاذ تِلك الفتاة، سيكون ذلك خيارك الوحيد
Dialogue: 0,0:51:15.58,0:51:17.91,Default,,0,0,0,,...أُريد أن أحقق معك بأمرٍ ما
Dialogue: 0,0:51:18.27,0:51:24.31,Default,,0,0,0,,.لقد بحثنا في كاميرات المُراقبة عند المنارة ولكن، لم نعثر على أي غواصة
Dialogue: 0,0:51:26.18,0:51:28.34,Default,,0,0,0,,.أظن أن الظلام الحالك قد منع الكاميرا من تصويرها
Dialogue: 0,0:51:28.34,0:51:30.57,Default,,0,0,0,,.دقة كاميرات المُراقبة التابعة للشرطة عالية جدًا
Dialogue: 0,0:51:30.78,0:51:35.55,Default,,0,0,0,,.المعذرة منكم، لقد أُقحمتم بأعمالٍ إضافية بسبب خطأ ظن هذا الفتى
Dialogue: 0,0:51:35.87,0:51:41.15,Default,,0,0,0,,هل الكاميرات المُتصلة بهذا النظام، هي كامرات المُراقبة التابعة للشرطة فحسب ؟
Dialogue: 0,0:51:41.15,0:51:42.57,Default,,0,0,0,,.صحيح
Dialogue: 0,0:51:42.76,0:51:44.01,Default,,0,0,0,,...لحظة
Dialogue: 0,0:51:46.16,0:51:48.15,Default,,0,0,0,,.انه الطريق الذي سلكه أولئك المُجرمون
Dialogue: 0,0:51:48.15,0:51:49.08,Default,,0,0,0,,!هاه ؟
Dialogue: 0,0:51:49.08,0:51:51.58,Default,,0,0,0,,.عليكم أن تبحثوا في تسجيلات كاميرات الشرطة لهذا الطريق
Dialogue: 0,0:51:51.58,0:51:53.12,Default,,0,0,0,,—أوي ! توقف عن
Dialogue: 0,0:51:53.12,0:51:55.57,Default,,0,0,0,,.ابحثوا خلال الساعة 11 من ليلة البارحة
Dialogue: 0,0:51:57.41,0:52:00.50,Default,,0,0,0,,.يا ليونهارت A6 اعرض لنا تسجيلات الكاميرا
Dialogue: 0,0:52:00.95,0:52:03.36,Default,,0,0,0,,! وهذه المرة يتبعون أوامر ذلك الطفل
Dialogue: 0,0:52:08.40,0:52:09.90,Default,,0,0,0,,.هذه تسجيلات الكاميرا
Dialogue: 0,0:52:13.47,0:52:16.68,Default,,0,0,0,,! هذا غريب، لم تُصوّر سيارة أولئك المُجرمين
Dialogue: 0,0:52:16.99,0:52:20.77,Default,,0,0,0,,!ولا أثر لوجود سيارة آڠاسا-سان أيضًا، ما معنى ذلك ؟
Dialogue: 0,0:52:21.11,0:52:23.48,Default,,0,0,0,,!أُعقل أن التسجيل قد تم استبداله ؟
Dialogue: 0,0:52:24.04,0:52:26.12,Default,,0,0,0,,! لا شك في ذلك
Dialogue: 0,0:52:30.31,0:52:33.31,Default,,0,0,0,,هل يُمكن أن تكوني، اِبنة "شيهو" ؟
Dialogue: 0,0:52:33.53,0:52:37.31,Default,,0,0,0,,ألم تقولي أنكِ لا تعرفين شيئًا عن "ميانو شيهو" ؟
Dialogue: 0,0:52:38.13,0:52:39.77,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:52:39.77,0:52:43.11,Default,,0,0,0,,.لا يُمكن أن يكون لــ "شيهو" طفلةً في مثل سنك
Dialogue: 0,0:52:43.76,0:52:47.78,Default,,0,0,0,,.ولكنكِ تُشبهينها عندما التقيتها فيما مضى
Dialogue: 0,0:52:48.39,0:52:50.98,Default,,0,0,0,,التقيتيها ؟ .. في أيّ مكان ؟
Dialogue: 0,0:52:51.77,0:52:54.95,Default,,0,0,0,,.لقد عشتُ بأمريكا عندما كُنت صغيرة
Dialogue: 0,0:52:56.77,0:53:01.51,Default,,0,0,0,,.ولقد كانوا يتنمّرون عليّ في كُلّ مرةٍ يرونني بها لأن ملامحي آسيوية
Dialogue: 0,0:53:16.30,0:53:19.85,Default,,0,0,0,,...في ذلك الوقت، من قام بالدفاع عني كانت
Dialogue: 0,0:53:21.33,0:53:23.77,Default,,0,0,0,,.شيهو" الفتاة اليابانية"
Dialogue: 0,0:53:24.35,0:53:25.92,Default,,0,0,0,,.اجلسي هنا
Dialogue: 0,0:53:29.78,0:53:35.25,Default,,0,0,0,,.عندها، صار الطُلّاب يتنمرون عليها عِوضًا عني
Dialogue: 0,0:53:37.76,0:53:41.25,Default,,0,0,0,,.في حين أنني لم أقم بمُساعدتها
Dialogue: 0,0:53:41.89,0:53:44.71,Default,,0,0,0,,.خِفتُ من أن أتعرّض للتنمّر مرةً أُخرى
Dialogue: 0,0:53:46.28,0:53:51.18,Default,,0,0,0,,.لذلك، قررت بناء عالمٍ لا وجود للعنصرية فيه إطلاقًا
Dialogue: 0,0:53:51.81,0:53:53.57,Default,,0,0,0,,لا تفهمين ما أقوله، صحيح ؟
Dialogue: 0,0:53:53.57,0:53:56.41,Default,,0,0,0,,لهذا السبب قُمتِ بصُنع التعرّف العمري الشامل، صحيح ؟
Dialogue: 0,0:53:56.42,0:53:57.54,Default,,0,0,0,,.نعم
Dialogue: 0,0:53:57.54,0:54:00.65,Default,,0,0,0,,...عندما درست العلوم البشرية والذكاء الاصطناعي
Dialogue: 0,0:54:00.79,0:54:05.65,Default,,0,0,0,,فكرت بصنع برنامجٍ يبحث عن صور الجميع\N .حتى لو كانوا من أعراقٍ أو أعمارٍ مُختلفة
Dialogue: 0,0:54:06.12,0:54:11.98,Default,,0,0,0,,"وبعد ذلك، تواصل معي "الانتربول\Nمن أجل أن أختبر فعالية برنامج التعرّف العمري الشامل
Dialogue: 0,0:54:11.98,0:54:15.75,Default,,0,0,0,,.على كاميرات المُراقبة اليابانية بعد ان سمحوا لي بالدخول عليها
Dialogue: 0,0:54:16.45,0:54:20.98,Default,,0,0,0,,"في ذلك الوقت، فإن أول من خطر على بالي كانت "شيهو
Dialogue: 0,0:54:22.07,0:54:24.21,Default,,0,0,0,,.لأنني اشتقتُ إليها مراتٍ عدّة
Dialogue: 0,0:54:24.21,0:54:28.51,Default,,0,0,0,,.وكنتُ دائمًا، دائمًا، أريد الإعتذار لها عن ما مضى
Dialogue: 0,0:54:42.51,0:54:45.78,Default,,0,0,0,,.وبعد ذلك، لم أفهم لِمَ ظهرت صوركِ بدلًا عنها
Dialogue: 0,0:54:47.66,0:54:51.75,Default,,0,0,0,,.لم أفهم ما سبب ذلك حتى الآن
Dialogue: 0,0:54:52.77,0:54:56.48,Default,,0,0,0,,.ولكن الذي أعرفه، هو أنكِ تورّطتِ بسبب خطأي
Dialogue: 0,0:54:57.22,0:55:01.11,Default,,0,0,0,,.لا.. بل أنا من ورّطكِ بهذا
Dialogue: 0,0:55:13.93,0:55:16.45,Default,,0,0,0,,...أهذا كل مافي الأمر
Dialogue: 0,0:55:34.37,0:55:36.38,Default,,0,0,0,,.لا تتدخّل
Dialogue: 0,0:55:46.30,0:55:48.55,Default,,0,0,0,,ما معنى كل الذي شاهدناه ؟
Dialogue: 0,0:55:49.14,0:55:51.31,Default,,0,0,0,,.عليكَ أن تُخبرني بما يجري
Dialogue: 0,0:55:53.14,0:55:57.01,Default,,0,0,0,,.ذلك التسجيل، لقد سُجّل عندما كُنتَ في الغُرفة الرئيسية
Dialogue: 0,0:55:58.50,0:56:00.29,Default,,0,0,0,,!ما الذي تفعله يا هذا ؟
Dialogue: 0,0:56:21.10,0:56:23.42,Default,,0,0,0,,هل حقًا ستظلين هنا يا "ران" ؟
Dialogue: 0,0:56:23.62,0:56:25.71,Default,,0,0,0,,.اِنني قلقة جدًا على آي-تشان
Dialogue: 0,0:56:25.71,0:56:26.97,Default,,0,0,0,,.إنكِ مُحقة
Dialogue: 0,0:56:26.97,0:56:30.61,Default,,0,0,0,,.ولكن سأكون على ما يُرام، فالبروفيسور سيظل معي
Dialogue: 0,0:56:30.61,0:56:33.71,Default,,0,0,0,,.نعتذر لأننا سنعهد بالأطفال إليكِ
Dialogue: 0,0:56:34.48,0:56:40.11,Default,,0,0,0,,.دعوا أمر أولئك الأطفال لي لأنني أعرف كيف أعاملهم، فقد اعتدّت عليهم
Dialogue: 0,0:56:40.11,0:56:42.78,Default,,0,0,0,,"شكرًا لكِ يا "سونوكو
Dialogue: 0,0:56:42.78,0:56:44.71,Default,,0,0,0,,! الوداع= \N إلى اللقاء-
Dialogue: 0,0:56:44.71,0:56:47.61,Default,,0,0,0,,! سنتشري الكثير من الهدايا لكم=
Dialogue: 0,0:56:47.61,0:56:49.31,Default,,0,0,0,,! وداعًا= \N! سنكون بإنتظاركم-
Dialogue: 0,0:56:49.31,0:56:50.96,Default,,0,0,0,,! أنتِ ! عليكَ أن تحذر
Dialogue: 0,0:56:50.96,0:56:51.98,Default,,0,0,0,,! ڠينتا-كن
Dialogue: 0,0:56:54.97,0:56:57.43,Default,,0,0,0,,...مهلًا ! إلى الجميع انظروا إلى هذا
Dialogue: 0,0:56:57.43,0:56:59.21,Default,,0,0,0,,! "إنها من "ليونهارت
Dialogue: 0,0:57:02.59,0:57:04.84,Default,,0,0,0,,!مُستحيل ! لماذا ؟
Dialogue: 0,0:57:04.84,0:57:06.43,Default,,0,0,0,,ماذا ؟ ماذا ؟
Dialogue: 0,0:57:06.43,0:57:11.68,Default,,0,0,0,,.يقول أنه أنشأ بابًا خلفيًا في النظام لكي يتمكّن المُجرمون من خطف ناومي-سان
Dialogue: 0,0:57:11.68,0:57:12.96,Default,,0,0,0,,هاه ؟
Dialogue: 0,0:57:13.69,0:57:15.95,Default,,0,0,0,,وهل ذكر شيئًا عن المُجرمين ؟
Dialogue: 0,0:57:16.11,0:57:18.98,Default,,0,0,0,,.يقول بأنهم مجهولون، وقد ساعدهم بعد أن دفعوا المال له
Dialogue: 0,0:57:19.69,0:57:21.97,Default,,0,0,0,,"لقد وجدت مكان "ليونهارت
Dialogue: 0,0:57:21.97,0:57:23.40,Default,,0,0,0,,! انه بالمقهى
Dialogue: 0,0:57:28.58,0:57:30.91,Default,,0,0,0,,هل هذا... دواء ؟
Dialogue: 0,0:57:30.91,0:57:31.96,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,0:57:36.40,0:57:38.45,Default,,0,0,0,,...يبدو، ان هنالك
Dialogue: 0,0:57:38.45,0:57:40.45,Default,,0,0,0,,! يتصرّف بغرابة
Dialogue: 0,0:57:45.58,0:57:46.97,Default,,0,0,0,,! "ليونهارت"
Dialogue: 0,0:57:46.97,0:57:48.97,Default,,0,0,0,,! بدّلوا الكاميرات، بسرعة
Dialogue: 0,0:57:53.97,0:57:54.97,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,0:57:55.98,0:57:58.11,Default,,0,0,0,,...هاه ؟ "ليونهارت" قد- \N! هذا كذب-
Dialogue: 0,0:57:59.28,0:58:01.85,Default,,0,0,0,,ألم يراه أحد من الموظفين ؟
Dialogue: 0,0:58:01.85,0:58:04.25,Default,,0,0,0,,.كلّا، فقد كان وقت التنظيف الاعتيادي
Dialogue: 0,0:58:04.44,0:58:07.48,Default,,0,0,0,,.أجل. أنت مُحقٌ في كلامك
Dialogue: 0,0:58:12.12,0:58:15.65,Default,,0,0,0,,.هنالك آثار للقيح على فمه، وهذا يُشير بأنه قد شرب شيئًا سامًّا
Dialogue: 0,0:58:16.17,0:58:18.01,Default,,0,0,0,,إذًا ما هذه الرائحة ؟
Dialogue: 0,0:58:18.01,0:58:20.01,Default,,0,0,0,,.أعتقد أنها رائحة القهوة
Dialogue: 0,0:58:20.01,0:58:23.91,Default,,0,0,0,,.ذلك صحيح ومع ذلك فإن هنالك رائحة غريبة تُشبه رائحة الغِراء
Dialogue: 0,0:58:25.06,0:58:29.18,Default,,0,0,0,,! تقول دائًما دائمًا أشياء غبية فتعقّد بها مسار الجريمة ومُلابساتها
Dialogue: 0,0:58:29.42,0:58:31.88,Default,,0,0,0,,! كما ترى إنها مُجرّد حادثة انتحار لا أكثر
Dialogue: 0,0:58:31.88,0:58:32.97,Default,,0,0,0,,.هدّئ من روعك
Dialogue: 0,0:58:32.97,0:58:34.67,Default,,0,0,0,,! ولكن أليسَ الأمر غريبًا
Dialogue: 0,0:58:34.67,0:58:35.71,Default,,0,0,0,,!ما هو بالضبط ؟
Dialogue: 0,0:58:35.71,0:58:39.42,Default,,0,0,0,,لقد كان ليونهارت-سان في غُرفته، أليسَ كذلك ؟
Dialogue: 0,0:58:39.64,0:58:42.25,Default,,0,0,0,,إذًا لماذا مات في المقهى ؟
Dialogue: 0,0:58:43.66,0:58:45.05,Default,,0,0,0,,...على أرجح أن هذا صحيح
Dialogue: 0,0:58:45.05,0:58:47.05,Default,,0,0,0,,.أستطيع أن أُجيبكَ على ذلك
Dialogue: 0,0:58:47.58,0:58:50.61,Default,,0,0,0,,.لأنه أراد أن يتلذذ بشرب القهوة قبل موته
Dialogue: 0,0:58:50.61,0:58:51.93,Default,,0,0,0,,! ...أوي، أوي
Dialogue: 0,0:58:52.56,0:58:55.48,Default,,0,0,0,,.انقلوا جُثته إلى المروحية واطلبوا تشريحها
Dialogue: 0,0:58:55.48,0:58:56.36,Default,,0,0,0,,! حاضر
Dialogue: 0,0:58:56.36,0:59:01.55,Default,,0,0,0,,.عُذرًا، ولكن الشرطة اليابانية لا تقوم بتشريح جُثث المنتحرين
Dialogue: 0,0:59:02.54,0:59:04.56,Default,,0,0,0,,...من باب الإحتياط فقط
Dialogue: 0,0:59:08.57,0:59:11.21,Default,,0,0,0,,لماذا قاموا بإختطافك وجلّبك إلى هنا ؟
Dialogue: 0,0:59:11.98,0:59:16.68,Default,,0,0,0,,عندما أتممت نظام التعرّف العمري الشامل\N ...تلقيتُ اتصالًا من شخصٍ مجهول
Dialogue: 0,0:59:17.27,0:59:18.51,Default,,0,0,0,,وهل تقابلتم ؟
Dialogue: 0,0:59:19.60,0:59:23.25,Default,,0,0,0,,"كُنا نتراسل فقط، ولكن كان يُسمي نفسه "بينڠا
Dialogue: 0,0:59:23.50,0:59:24.59,Default,,0,0,0,,بينڠا" ؟"
Dialogue: 0,0:59:24.99,0:59:27.15,Default,,0,0,0,,.يُشبه أولئك الأسماء التي أعرفاها
Dialogue: 0,0:59:27.28,0:59:29.90,Default,,0,0,0,,لقد عرض عليّ مبلغًا ضخمًا
Dialogue: 0,0:59:29.90,0:59:34.55,Default,,0,0,0,,.مُقابل احتكار النظام وتطويره لصالحه ولكني رفضت ذلك
Dialogue: 0,0:59:34.69,0:59:39.21,Default,,0,0,0,,"ففي ذلك الوقت كُنت قد قررت بأن يستعمله "الانتربول
Dialogue: 0,0:59:39.98,0:59:45.11,Default,,0,0,0,,.بمعنى آخر، ان نظام التعرّف العمري الشامل مُهم جدًا لهم
Dialogue: 0,0:59:45.11,0:59:46.34,Default,,0,0,0,,لهم ؟
Dialogue: 0,0:59:47.24,0:59:51.51,Default,,0,0,0,,.قولكِ لكلمة "لهم" ، تبدين حقًا وكأن "شيري" من قالتها
Dialogue: 0,0:59:51.98,0:59:55.81,Default,,0,0,0,,.لم أستطع الاندماج معها منذ أن عرفتها فيما مضى
Dialogue: 0,0:59:56.98,1:00:01.81,Default,,0,0,0,,وبعد ؟ هل قررتِ استعمال النظام لأجل صالحنا ؟
Dialogue: 0,1:00:03.85,1:00:05.60,Default,,0,0,0,,...ما باليد حيلة
Dialogue: 0,1:00:06.01,1:00:06.99,Default,,0,0,0,,! لا
Dialogue: 0,1:00:06.99,1:00:08.44,Default,,0,0,0,,! قفي- \N ! لا-
Dialogue: 0,1:00:09.41,1:00:10.97,Default,,0,0,0,,! ادخلي
Dialogue: 0,1:00:11.80,1:00:12.97,Default,,0,0,0,,..."ڤودكا"
Dialogue: 0,1:00:13.99,1:00:15.21,Default,,0,0,0,,.قال انتهى أمره
Dialogue: 0,1:00:15.21,1:00:16.53,Default,,0,0,0,,ماذا ؟
Dialogue: 0,1:00:16.53,1:00:20.45,Default,,0,0,0,,.ذلك المدعو "بينڠا" دائمًا ما يكون خارج الخطة
Dialogue: 0,1:00:21.18,1:00:22.45,Default,,0,0,0,,خارج الخُطة ؟
Dialogue: 0,1:00:22.45,1:00:23.87,Default,,0,0,0,,! تعالي بسرعة
Dialogue: 0,1:00:24.39,1:00:25.87,Default,,0,0,0,,...فلتنظري إلى هذا
Dialogue: 0,1:00:28.22,1:00:29.67,Default,,0,0,0,,! أبي
Dialogue: 0,1:00:30.18,1:00:31.91,Default,,0,0,0,,ماذا ستفعلون بأبي ؟
Dialogue: 0,1:00:31.91,1:00:35.21,Default,,0,0,0,,بما أنكِ ذكية، فأنتِ تُدركين ما سنفعله صحيح ؟
Dialogue: 0,1:00:36.18,1:00:41.95,Default,,0,0,0,,! لقد أراد أبي استعمال النظام من أجل أن يتحقق السلام العالمي
Dialogue: 0,1:00:41.95,1:00:45.81,Default,,0,0,0,,إذًا هل تُريدين التضحية بحياة والدك ؟
Dialogue: 0,1:00:45.81,1:00:47.81,Default,,0,0,0,,! يا لكِ من ابنةٍ فظيعة
Dialogue: 0,1:00:48.60,1:00:51.42,Default,,0,0,0,,! لن أعطيكم النظام قطعًا
Dialogue: 0,1:00:52.88,1:00:56.31,Default,,0,0,0,,.إذًا سنقوم بما يُمليه علينا واجبنا
Dialogue: 0,1:00:59.68,1:01:01.17,Default,,0,0,0,,! انه الباب الخلفي
Dialogue: 0,1:01:01.51,1:01:02.90,Default,,0,0,0,,ما الذي تقصده ؟
Dialogue: 0,1:01:02.90,1:01:07.45,Default,,0,0,0,,.وضعتُ فخًا لكي أُمسك بالمتورطين إن بحثوا داخل النظام
Dialogue: 0,1:01:08.58,1:01:10.18,Default,,0,0,0,,من يكون هذا الشخص ؟
Dialogue: 0,1:01:10.18,1:01:11.86,Default,,0,0,0,,"ماريو آرجينتو"
Dialogue: 0,1:01:12.02,1:01:14.16,Default,,0,0,0,,...انه أحد أعضاء برلمان الاتحاد الأوروبي
Dialogue: 0,1:01:14.16,1:01:16.16,Default,,0,0,0,,! "ووالد "ناومي
Dialogue: 0,1:01:17.03,1:01:18.58,Default,,0,0,0,,!ماذا تقول ؟
Dialogue: 0,1:01:18.85,1:01:23.35,Default,,0,0,0,,"بفضله استطعنا أن نوصل كاميرات المُراقبة بــ "اليوربول
Dialogue: 0,1:01:23.84,1:01:26.45,Default,,0,0,0,,!هل عرفت ما عليكَ فعله يا "ايد" ؟
Dialogue: 0,1:01:26.45,1:01:28.81,Default,,0,0,0,,! أجل. بالتأكيد سأفعلها
Dialogue: 0,1:01:28.81,1:01:31.55,Default,,0,0,0,,! اطلب من "اليوربول" أن يأمّنوا الحماية لهم
Dialogue: 0,1:01:34.61,1:01:36.68,Default,,0,0,0,,"تم العثور على موقع العضو "ماريو
Dialogue: 0,1:01:37.10,1:01:41.08,Default,,0,0,0,,إنه في نُزل "سيتي" القريب من بُرج "ايشنهايم" في الغرفة 401
Dialogue: 0,1:01:41.33,1:01:43.08,Default,,0,0,0,,! "انطلق يا "كاميل
Dialogue: 0,1:01:43.08,1:01:44.15,Default,,0,0,0,,.حاضر
Dialogue: 0,1:01:46.58,1:01:48.65,Default,,0,0,0,,.سأتصل بــ "ماريو" لكي أُحذره
Dialogue: 0,1:01:49.68,1:01:52.58,Default,,0,0,0,,.لم يتبقى الكثير من الوقت حتى تبدأ المعركة
Dialogue: 0,1:01:55.41,1:01:57.84,Default,,0,0,0,,"سأدع الأمر لك يا "كورون
Dialogue: 0,1:01:58.04,1:01:59.71,Default,,0,0,0,,.فهمت
Dialogue: 0,1:02:10.83,1:02:13.38,Default,,0,0,0,,"لقد وجدت.. "ماريو
Dialogue: 0,1:02:14.12,1:02:15.66,Default,,0,0,0,,.سأطلق متى شئتم
Dialogue: 0,1:02:16.05,1:02:18.55,Default,,0,0,0,,! أسرع بالهروب يا أبي
Dialogue: 0,1:02:18.55,1:02:21.11,Default,,0,0,0,,.الأجدر بكِ أن تتخذي القرار بسرعة
Dialogue: 0,1:02:21.11,1:02:24.27,Default,,0,0,0,,! أهرب يا أبي
Dialogue: 0,1:02:26.70,1:02:28.96,Default,,0,0,0,,"لا تستلمي يا "هيديني
Dialogue: 0,1:02:29.69,1:02:32.61,Default,,0,0,0,,.حتمًا سيأتي ذلك الوقت الذي تلتقين بحلفاء لكِ
Dialogue: 0,1:02:33.76,1:02:36.45,Default,,0,0,0,,.أكلمي المهمّة بدلًا عني
Dialogue: 0,1:02:41.18,1:02:42.64,Default,,0,0,0,,ما العمل ؟
Dialogue: 0,1:02:49.95,1:02:51.51,Default,,0,0,0,,.يبدو أنه قد لاحظني
Dialogue: 0,1:02:53.35,1:02:55.61,Default,,0,0,0,,.ولكنه، لن يُفلت
Dialogue: 0,1:03:25.98,1:03:29.25,Default,,0,0,0,,! لا
Dialogue: 0,1:03:29.61,1:03:32.36,Default,,0,0,0,,.ستكون والدتكِ هي الضحية التالية
Dialogue: 0,1:03:32.54,1:03:36.01,Default,,0,0,0,,هل مازلتِ ترفضين العرض الذي قدمناه لكِ ؟
Dialogue: 0,1:03:36.53,1:03:39.41,Default,,0,0,0,,.من الأفضل لكِ أن تُفكري مليًا فيما سيحدث
Dialogue: 0,1:03:43.38,1:03:44.88,Default,,0,0,0,,! سُحقًا
Dialogue: 0,1:03:47.20,1:03:50.45,Default,,0,0,0,,! أنا... أنا من قتلتُ أبي
Dialogue: 0,1:03:51.60,1:03:55.91,Default,,0,0,0,,.لقد تخليتُ عن أبي هذه المرة، كما فعلتُ في ما سبق
Dialogue: 0,1:03:55.91,1:03:57.48,Default,,0,0,0,,...ليسَ صحيحًا، فأنتِ
Dialogue: 0,1:03:57.48,1:04:00.38,Default,,0,0,0,,! سيقتلونكِ أنتِ أيضًا على هذه الحالة
Dialogue: 0,1:04:00.38,1:04:02.85,Default,,0,0,0,,...جميعكم بسببي سوف
Dialogue: 0,1:04:25.84,1:04:27.96,Default,,0,0,0,,.المعذرة منك يا أشيو-سان
Dialogue: 0,1:04:27.96,1:04:32.99,Default,,0,0,0,,.لا عليكِ، فــ أنا أيضًا أردت رؤية "عوامة المُحيط" عن قُرب
Dialogue: 0,1:04:33.11,1:04:35.77,Default,,0,0,0,,.وفوق ذلك، انه طلبٌ منه
Dialogue: 0,1:04:35.77,1:04:36.52,Default,,0,0,0,,هاه ؟
Dialogue: 0,1:04:36.52,1:04:39.68,Default,,0,0,0,,.لقد أراني أحدث ما قام بإختراعه حتى الآن
Dialogue: 0,1:04:39.85,1:04:43.15,Default,,0,0,0,,.آڠاسا-سان رجلٌ عظيمٌ بحق
Dialogue: 0,1:04:44.40,1:04:45.39,Default,,0,0,0,,.أجل
Dialogue: 0,1:04:47.96,1:04:50.31,Default,,0,0,0,,! فهمت ! .. لقد حددتُ الخادم
Dialogue: 0,1:04:50.31,1:04:51.85,Default,,0,0,0,,كم من الوقت تحتاج لتحجبه ؟
Dialogue: 0,1:04:51.85,1:04:54.27,Default,,0,0,0,,.ما يُقارب الساعتين أو الثلاث ساعات
Dialogue: 0,1:04:55.02,1:04:56.49,Default,,0,0,0,,"أعتمد عليك يا "ايد
Dialogue: 0,1:04:56.96,1:04:59.76,Default,,0,0,0,,! أيها المُدير، لقد رصد "السونار" شيئًا غريبًا
Dialogue: 0,1:04:59.76,1:05:00.70,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:05:00.70,1:05:03.12,Default,,0,0,0,,.إنه صوت دوران من على بعد 10 كيلومترات
Dialogue: 0,1:05:03.45,1:05:04.83,Default,,0,0,0,,دوران ؟
Dialogue: 0,1:05:06.08,1:05:09.78,Default,,0,0,0,,...سيأتي إلى الغواصة من الجو، بمعنى آخر في ذلك الوقت سوفَ
Dialogue: 0,1:05:18.27,1:05:19.71,Default,,0,0,0,,!هل نحن نطفو ؟
Dialogue: 0,1:05:19.71,1:05:21.11,Default,,0,0,0,,هل تسمعينني ؟
Dialogue: 0,1:05:21.11,1:05:22.71,Default,,0,0,0,,!هايبرا" ! هل تسمعينني" ؟"
Dialogue: 0,1:05:22.71,1:05:23.90,Default,,0,0,0,,! إيدوڠاوا-كن
Dialogue: 0,1:05:23.90,1:05:25.64,Default,,0,0,0,,!هايبرا" ! هل تسمعينني" ؟"
Dialogue: 0,1:05:25.64,1:05:27.64,Default,,0,0,0,,! أنا أسمعك يا إيدوڠاوا-كن
Dialogue: 0,1:05:27.64,1:05:29.64,Default,,0,0,0,,هل أنتِ الآن داخل الغواصة ؟
Dialogue: 0,1:05:29.64,1:05:31.24,Default,,0,0,0,,كيف عرفتَ بها ؟
Dialogue: 0,1:05:31.24,1:05:33.24,Default,,0,0,0,,..."اِسمعيني جيدًا يا "هايبرا
Dialogue: 0,1:05:33.24,1:05:37.01,Default,,0,0,0,,،بعد أن قاموا بإختطافك، سقطوا في البحر مع سيارتهم
Dialogue: 0,1:05:37.35,1:05:39.88,Default,,0,0,0,,،ولم تُفتح الحجرة الخاصة بالدخول في سطح الغواصة
Dialogue: 0,1:05:39.88,1:05:43.58,Default,,0,0,0,,! بل قاموا بإخراجكِ من السيارة وهم في الماء، ودخلوا إلى الغواصة مُباشرةً
Dialogue: 0,1:05:44.07,1:05:48.28,Default,,0,0,0,,.بمعنى آخر، يُمكن الخروج من الغواصة مُباشرةً إلى ماء البحر
Dialogue: 0,1:05:48.28,1:05:51.65,Default,,0,0,0,,.كُنت مُنومةً عندما اختطفوني وأدخلوني إلى الغواصة
Dialogue: 0,1:05:51.95,1:05:55.01,Default,,0,0,0,,.لا أذكر كيف ومن أين دخلنا إلى الغواصة
Dialogue: 0,1:06:00.43,1:06:03.23,Default,,0,0,0,,...بالمناسبة، أود أن أسألك سؤالًا
Dialogue: 0,1:06:03.23,1:06:03.95,Default,,0,0,0,,!هاه ؟
Dialogue: 0,1:06:03.95,1:06:06.35,Default,,0,0,0,,من أي مكانٍ سيدخل "جين" إلينا ؟
Dialogue: 0,1:06:06.35,1:06:09.31,Default,,0,0,0,,هل سيدخل مثل أمس عبر أنبوب الطوربيد ؟
Dialogue: 0,1:06:10.23,1:06:11.71,Default,,0,0,0,,!عبر أنبوب الطوربيد ؟
Dialogue: 0,1:06:11.71,1:06:12.37,Default,,0,0,0,,هاه ؟
Dialogue: 0,1:06:12.98,1:06:15.35,Default,,0,0,0,,.يبدو أنهم أدخلوني من هناك
Dialogue: 0,1:06:15.35,1:06:18.38,Default,,0,0,0,,أنابيب الطوربيد تسمح بالدخول إلى الغواصة ؟
Dialogue: 0,1:06:18.84,1:06:20.38,Default,,0,0,0,,...لدي سؤالٌ لك
Dialogue: 0,1:06:20.38,1:06:25.91,Default,,0,0,0,,.سيدخل أخي بأمانٍ من فتحة حجرة القيادة، ولأجل ذلك سنطفوا بعد قليل
Dialogue: 0,1:06:26.14,1:06:30.85,Default,,0,0,0,,! لن ندخل أو نخرج مُجددًا من هناك، لأنها طريقةٌ مُخيفة
Dialogue: 0,1:06:30.85,1:06:32.54,Default,,0,0,0,,...إذًا لماذا
Dialogue: 0,1:06:32.54,1:06:35.91,Default,,0,0,0,,،تضغط على الزر الأصفر لتصل إلى أنبوب الاطلاق
Dialogue: 0,1:06:35.91,1:06:40.55,Default,,0,0,0,,.فتُفتح الفُتحة بشكلٍ آلي لكي يتدفق ماء البحر من خلالها
Dialogue: 0,1:06:40.55,1:06:42.08,Default,,0,0,0,,! كم هذا سهل
Dialogue: 0,1:06:42.39,1:06:43.76,Default,,0,0,0,,...تُفتح بشكلٍ آلي
Dialogue: 0,1:06:43.76,1:06:47.51,Default,,0,0,0,,! غبية ! .. يُستعمل أنبوب الطوربيد لكي نُطلق من خلاله الصواريخ
Dialogue: 0,1:06:47.71,1:06:50.91,Default,,0,0,0,,...فإن أخطأ أحدٌ ما وسحب ذلك المقبض فعندها
Dialogue: 0,1:06:52.13,1:06:53.15,Default,,0,0,0,,!مقبض ؟
Dialogue: 0,1:06:53.15,1:06:54.23,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:06:54.23,1:06:56.96,Default,,0,0,0,,!عبرتي خلال الأنبوب ولا تعرفين كيف يتم ذلك ؟
Dialogue: 0,1:06:57.22,1:06:58.23,Default,,0,0,0,,...تعالي
Dialogue: 0,1:06:59.81,1:07:05.75,Default,,0,0,0,,عندما تسحبين هذا المقبض الأخضر فإن الهواء\Nالمضغوط يدخل إلى أنبوب الإطلاق
Dialogue: 0,1:07:05.75,1:07:08.92,Default,,0,0,0,,...فحينها لو كان أحدٌ ما بداخله فسوف
Dialogue: 0,1:07:08.92,1:07:10.86,Default,,0,0,0,,.سيفقد حياته
Dialogue: 0,1:07:10.86,1:07:12.28,Default,,0,0,0,,.لقد نسيتُ هذا الأمر
Dialogue: 0,1:07:12.28,1:07:14.59,Default,,0,0,0,,!هل أنتِ على ما يُرام ؟
Dialogue: 0,1:07:15.22,1:07:17.15,Default,,0,0,0,,.لقد عرفت أحد طُرق الخروج من هنا
Dialogue: 0,1:07:17.15,1:07:20.48,Default,,0,0,0,,،حقًا ؟! إذًا أنتِ وناومي-سان
Dialogue: 0,1:07:20.48,1:07:22.59,Default,,0,0,0,,.سأقوم بإنقاذكما بكل تأكيد
Dialogue: 0,1:07:23.78,1:07:25.91,Default,,0,0,0,,.سأستعمل هذا القارب المُتبقي
Dialogue: 0,1:07:26.94,1:07:28.98,Default,,0,0,0,,! كونان-كن
Dialogue: 0,1:07:31.14,1:07:32.37,Default,,0,0,0,,! ران
Dialogue: 0,1:07:34.37,1:07:36.31,Default,,0,0,0,,! ستصل المروحية قريبًا
Dialogue: 0,1:07:36.31,1:07:37.75,Default,,0,0,0,,.عظيم
Dialogue: 0,1:07:38.12,1:07:40.29,Default,,0,0,0,,.وصل أخي "جين" وأخيرًا
Dialogue: 0,1:07:48.21,1:07:49.40,Default,,0,0,0,,.جائت
Dialogue: 0,1:07:50.57,1:07:52.02,Default,,0,0,0,,.سنخرج من هنا
Dialogue: 0,1:07:53.30,1:07:54.48,Default,,0,0,0,,.مُحال
Dialogue: 0,1:07:58.79,1:08:01.55,Default,,0,0,0,,.لدي دراية بفك أكثر الرباطات وبسهولة
Dialogue: 0,1:08:01.80,1:08:04.04,Default,,0,0,0,,.هذه الطريقة يستعملها لاعبو الخفة
Dialogue: 0,1:08:04.04,1:08:06.04,Default,,0,0,0,,!أنتِ، من تكونين ؟
Dialogue: 0,1:08:06.04,1:08:08.04,Default,,0,0,0,,.لا وقت لدينا، دعينا نذهب
Dialogue: 0,1:08:08.04,1:08:10.75,Default,,0,0,0,,.هذا جنون، لايُمكننا ذلك حتمًا
Dialogue: 0,1:08:11.24,1:08:16.75,Default,,0,0,0,,عالمٍ خالٍ من التميّيز العنصري، انه حُلمكِ وحلم أبيكِ صحيح ؟
Dialogue: 0,1:08:17.16,1:08:19.21,Default,,0,0,0,,...ولكن والدي الآن قد
Dialogue: 0,1:08:19.57,1:08:22.20,Default,,0,0,0,,.عليكِ أن تُنجزي ما بدأتِ به
Dialogue: 0,1:08:22.20,1:08:25.81,Default,,0,0,0,,وماذا يُمكن لطفلين مثلك يا آي-تشان وكونان-كن أن يفعلا ؟
Dialogue: 0,1:08:26.69,1:08:29.08,Default,,0,0,0,,!ماذا يُمكنكم فعله ؟
Dialogue: 0,1:08:31.91,1:08:33.36,Default,,0,0,0,,...حسنٌ
Dialogue: 0,1:08:34.00,1:08:35.85,Default,,0,0,0,,وماذا يعني ان نكون أطفالًا ؟
Dialogue: 0,1:08:35.85,1:08:39.81,Default,,0,0,0,,أنتِ،  ألم يكن هدفكِ هو التخلّص من التميّيز العنصري ؟
Dialogue: 0,1:08:42.96,1:08:47.35,Default,,0,0,0,,-أقوال وأفعال الأطفال في بعض الأحيان، قد تُغيّر الحياة إلى الأفضل-
Dialogue: 0,1:08:51.32,1:08:52.59,Default,,0,0,0,,...انني
Dialogue: 0,1:08:53.88,1:08:59.78,Default,,0,0,0,,"تغيّرت بعد أن جرّبت ذلك، لذا ثقي بي يا "ناومي
Dialogue: 0,1:09:05.08,1:09:06.56,Default,,0,0,0,,...حان الوقت الآن
Dialogue: 0,1:09:06.56,1:09:07.59,Default,,0,0,0,,...آه
Dialogue: 0,1:09:09.48,1:09:12.58,Default,,0,0,0,,"آي-كن تعتمد عليكَ يا "شينتشي
Dialogue: 0,1:09:12.58,1:09:15.25,Default,,0,0,0,,.آه... سأذهب
Dialogue: 0,1:09:51.39,1:09:53.45,Default,,0,0,0,,.كنا ننتظرك
Dialogue: 0,1:09:53.77,1:09:59.11,Default,,0,0,0,,.والآن، لنرى تِلك الطفلة التي تُشبه "شيري" بأم أعيننا
Dialogue: 0,1:10:03.76,1:10:04.92,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:10:04.92,1:10:06.00,Default,,0,0,0,,! سُحقًا
Dialogue: 0,1:10:06.00,1:10:08.00,Default,,0,0,0,,!ما هذا ؟
Dialogue: 0,1:10:09.09,1:10:10.53,Default,,0,0,0,,..."أوي "ڤودكا
Dialogue: 0,1:10:11.47,1:10:13.05,Default,,0,0,0,,ما الذي يجري ؟
Dialogue: 0,1:10:13.05,1:10:15.05,Default,,0,0,0,,...انه، حسنٌ
Dialogue: 0,1:10:16.23,1:10:20.08,Default,,0,0,0,,! دخل أحدٌ ما إلى أنبوب الطوربيد وقام بتشغيله
Dialogue: 0,1:10:31.54,1:10:34.76,Default,,0,0,0,,!سُحقًا ! متى استطاعا أن يهربا ؟
Dialogue: 0,1:10:34.76,1:10:35.84,Default,,0,0,0,,...من هنا
Dialogue: 0,1:10:35.84,1:10:38.00,Default,,0,0,0,,! أوي ! هيا أُخرجا
Dialogue: 0,1:10:38.00,1:10:39.77,Default,,0,0,0,,! أوي ! أنتم
Dialogue: 0,1:10:40.39,1:10:43.31,Default,,0,0,0,,.لا يُمكننا فتحه فقد يكاد ان يمتلأ بمياه البحر
Dialogue: 0,1:10:43.31,1:10:46.74,Default,,0,0,0,,! من المُرجّح أنهم سيخرجا إلى مياه البحر بعد 70 ثانية من الآن
Dialogue: 0,1:10:46.98,1:10:50.41,Default,,0,0,0,,! على هذا الحال، سأقتل كِلاهما
Dialogue: 0,1:10:54.62,1:10:55.76,Default,,0,0,0,,...انه موجود
Dialogue: 0,1:10:56.09,1:10:57.76,Default,,0,0,0,,! سيصل إليَّ قريبًا
Dialogue: 0,1:11:01.02,1:11:02.45,Default,,0,0,0,,! "لا تفعل هذا يا "جين
Dialogue: 0,1:11:02.75,1:11:04.00,Default,,0,0,0,,..."كير"
Dialogue: 0,1:11:04.00,1:11:08.78,Default,,0,0,0,,.النظام التي صممته "ناومي" مُهمٌ لمُنظمتنا، لذا فلنقبض عليها حيّة
Dialogue: 0,1:11:09.42,1:11:12.28,Default,,0,0,0,,...أيّ شخصٍ يُعارض المُنظمة حتى لو كان أحد أعضائها
Dialogue: 0,1:11:12.28,1:11:14.77,Default,,0,0,0,,.لن أتراجع عن قتله مهما كان
Dialogue: 0,1:11:16.70,1:11:18.61,Default,,0,0,0,,! ...أبعدي يدكِ هذه
Dialogue: 0,1:11:25.88,1:11:27.58,Default,,0,0,0,,...كير" أيتها الوغدة"
Dialogue: 0,1:11:27.58,1:11:30.61,Default,,0,0,0,,...تتصرفين بتهورٍ وهذه ليست من عادتك
Dialogue: 0,1:11:31.08,1:11:34.15,Default,,0,0,0,,أيُعقل أن تكوني أحد فئرانهم ؟
Dialogue: 0,1:11:34.63,1:11:38.76,Default,,0,0,0,,"بل أنتَ الذي يتصرّف عن غير عادته يا "جين
Dialogue: 0,1:11:38.93,1:11:40.12,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:11:40.25,1:11:45.11,Default,,0,0,0,,إن كانت هذه الطفلة هي "شيري" التي ماتت \Nفي قِطار "شجرة الجرس" فلماذا هي حيّة الآن ؟
Dialogue: 0,1:11:45.11,1:11:47.51,Default,,0,0,0,,!وكيف أصبحت طفلة ؟
Dialogue: 0,1:11:47.66,1:11:51.15,Default,,0,0,0,,ألا تُريد تفسيراتٍ منها لكل هذه الأمور ؟
Dialogue: 0,1:11:51.45,1:11:56.91,Default,,0,0,0,,.أجل. كلامُها صحيحٌ على الأرجح يا أخي، لذا يجب أن نقبض عليها حيّة
Dialogue: 0,1:11:58.22,1:12:00.38,Default,,0,0,0,,! فُتحت فُوهة الإطلاق
Dialogue: 0,1:12:01.94,1:12:03.71,Default,,0,0,0,,! ...أخي
Dialogue: 0,1:12:24.78,1:12:27.05,Default,,0,0,0,,...رصدنا صوت خفيفًا لأحد المُحرّكات
Dialogue: 0,1:12:27.05,1:12:29.73,Default,,0,0,0,,."على الأرجح أنه صوت "سكوتر مائي
Dialogue: 0,1:12:29.73,1:12:32.50,Default,,0,0,0,,.انه يسيرُ بسرعة 5 عُقدٍ مائية بإتجاه الساعة 10 صباحًا
Dialogue: 0,1:12:29.73,1:12:32.50,aaaa,,0,0,0,,{\pos(632.001,962.666)\c&H1AB9D1&}اتجاه 60 درجة على الجانب الأيسر
Dialogue: 0,1:12:34.29,1:12:36.81,Default,,0,0,0,,.عظيم، لنُطاردهم
Dialogue: 0,1:13:03.76,1:13:05.77,Default,,0,0,0,,هل كِلاكُنا بخير ؟
Dialogue: 0,1:13:05.77,1:13:06.77,Default,,0,0,0,,.أجل
Dialogue: 0,1:13:07.28,1:13:08.77,Default,,0,0,0,,.أشكرك
Dialogue: 0,1:13:08.92,1:13:12.91,Default,,0,0,0,,ولكن من تكون وما هي حقيقتك ؟
Dialogue: 0,1:13:13.40,1:13:15.08,Default,,0,0,0,,—"أُدعى "إيدوڠاوا  كونان
Dialogue: 0,1:13:15.08,1:13:16.83,Default,,0,0,0,,انه مُتحرِّ
Dialogue: 0,1:13:21.77,1:13:23.04,Default,,0,0,0,,...هكذا إذًا
Dialogue: 0,1:13:27.80,1:13:29.77,Default,,0,0,0,,.البسي هذا بسرعة
Dialogue: 0,1:13:31.00,1:13:32.85,Default,,0,0,0,,.أشكرك
Dialogue: 0,1:13:33.25,1:13:35.31,Default,,0,0,0,,.هذا مُطمئن
Dialogue: 0,1:13:35.31,1:13:39.11,Default,,0,0,0,,.كم أنا سعيدةٌ لأنكِ بخيرٍ يا آي-تشان، هذا مُطمئنٌ حقًا
Dialogue: 0,1:13:39.97,1:13:42.01,Default,,0,0,0,,.ستكونين على ما يُرام من الآن وصاعدًا
Dialogue: 0,1:13:44.69,1:13:46.47,Default,,0,0,0,,.ستكونين على ما يُرام
Dialogue: 0,1:13:49.23,1:13:50.98,Default,,0,0,0,,...أختي
Dialogue: 0,1:13:52.95,1:13:55.20,Default,,0,0,0,,هل عثرتم على السكوتر المائي ؟
Dialogue: 0,1:13:55.20,1:13:56.07,Default,,0,0,0,,.أجل
Dialogue: 0,1:13:56.07,1:13:58.15,Default,,0,0,0,,.يبدو أنه توقف بعد أن نفذت طاقته
Dialogue: 0,1:13:58.36,1:14:00.15,Default,,0,0,0,,هل نقوم بجلبه ؟
Dialogue: 0,1:14:00.37,1:14:02.55,Default,,0,0,0,,.لا، لسنا بحاجته
Dialogue: 0,1:14:02.82,1:14:04.85,Default,,0,0,0,,.لقد كان فخًّا كما توقعت
Dialogue: 0,1:14:05.03,1:14:08.41,Default,,0,0,0,,أسمع صوت قمُحرّك قارب صيد، هل نقوم بمُطاردته ؟
Dialogue: 0,1:14:08.41,1:14:11.18,Default,,0,0,0,,.تمهل، أظن أنني أعرف إلى أين سيتجهون
Dialogue: 0,1:14:11.18,1:14:13.98,Default,,0,0,0,,! أخي، أُنظر إلى هذا رجاءً
Dialogue: 0,1:14:18.41,1:14:19.85,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:14:21.49,1:14:23.64,Default,,0,0,0,,ما معنى ذلك ؟
Dialogue: 0,1:14:24.08,1:14:26.55,Default,,0,0,0,,"هذه الصور تأتينا عبر "بليموت
Dialogue: 0,1:14:27.58,1:14:32.58,Default,,0,0,0,,.الملف الذي قُمنا بأخذه من "ناومي" كان ملفٍ تجريبي
Dialogue: 0,1:14:32.58,1:14:37.88,Default,,0,0,0,,،من أجل ذلك تحققتُ مُجددًا من وجه "شيري" بتقنية التعرّف العمري الشامل
Dialogue: 0,1:14:38.11,1:14:40.60,Default,,0,0,0,,.وهذا ما أظهرته نتائج البحث
Dialogue: 0,1:14:40.60,1:14:47.11,Default,,0,0,0,,يبدو أن النظام يرى كُل الذين يتشابهون في الملامح\N.هم شخصٌ واحد، لذا أعتقد أن هذه التقنية بها خلل كبير
Dialogue: 0,1:14:48.23,1:14:52.48,Default,,0,0,0,,! وماذا تعنيه تقنية التعرّف العمري الشامل ؟! انه نظامٌ لا جدوى منه
Dialogue: 0,1:14:56.80,1:15:03.48,Default,,0,0,0,,.سنعمل إذًا كما أمرنا الزعيم، لذا حان الوقت لنستعمل الخطة البديلة
Dialogue: 0,1:15:03.48,1:15:05.97,Default,,0,0,0,,هل ستتخلّى عن تقنية التعرّف العمري الشامل ؟
Dialogue: 0,1:15:05.97,1:15:10.31,Default,,0,0,0,,.يبدو أنه نظامٌ فاشل ولا قيمة له
Dialogue: 0,1:15:10.98,1:15:12.31,Default,,0,0,0,,.لقد فهمت
Dialogue: 0,1:15:13.59,1:15:18.98,Default,,0,0,0,,،لقد ظننت بأن تقنية التعرّف العمري الشامل ستُساعدني كثيرًا
Dialogue: 0,1:15:19.39,1:15:23.88,Default,,0,0,0,,.في تحديد مكان وجود الزعيم الذي لم يظهر منذ مدة طويلة
Dialogue: 0,1:15:27.83,1:15:30.75,Default,,0,0,0,,.أخي، إذًا أنت هنا
Dialogue: 0,1:15:31.11,1:15:32.27,Default,,0,0,0,,ما الأمر ؟
Dialogue: 0,1:15:32.27,1:15:36.25,Default,,0,0,0,,.يبدو أننا سنفذ الخطة الأخيرة التي وُضعت لأجل الحالات الطارئة
Dialogue: 0,1:15:37.23,1:15:39.35,Default,,0,0,0,,...أجل، فهمت
Dialogue: 0,1:15:39.35,1:15:46.31,Default,,0,0,0,,.سأُغرق هذا النظام وكل من لديه صلة به في ذلك القعر المُظلم
Dialogue: 0,1:15:50.53,1:15:51.95,Default,,0,0,0,,...توقعت ذلك
Dialogue: 0,1:15:51.95,1:15:54.22,Default,,0,0,0,,.أحل، لقد عرفوني
Dialogue: 0,1:15:54.58,1:15:57.65,Default,,0,0,0,,.في هذه الحالة، يجب أن أتخفّى عن الأنظار
Dialogue: 0,1:15:58.99,1:16:01.16,Default,,0,0,0,,.لا تزال لدي ورقة رابحة
Dialogue: 0,1:16:02.00,1:16:03.16,Default,,0,0,0,,ورقة رابحة ؟
Dialogue: 0,1:16:03.69,1:16:07.48,Default,,0,0,0,,"أقصد "بينڠا" .. فلا شك أنه في "عوامة المُحيط
Dialogue: 0,1:16:08.15,1:16:10.31,Default,,0,0,0,,.سأُقدّم له عرضًا
Dialogue: 0,1:16:10.31,1:16:12.15,Default,,0,0,0,,وهل عرفت من هو بينهم ؟
Dialogue: 0,1:16:12.15,1:16:15.05,Default,,0,0,0,,.لا... أحتاج لبعض الوقت
Dialogue: 0,1:16:16.58,1:16:22.95,Default,,0,0,0,,.وفوق ذلك، لم أتوقع أن تكون الغواصة موجودة حقًا كما قال ذلك الشقي
Dialogue: 0,1:16:22.95,1:16:26.85,Default,,0,0,0,,.لقد طلتُ من السُلطات ارسال قوات الدفاع البحرية
Dialogue: 0,1:16:27.06,1:16:29.68,Default,,0,0,0,,.حسنٌ، لنذهب إلى العيادة
Dialogue: 0,1:16:30.73,1:16:32.45,Default,,0,0,0,,تشعرون بالبرد صحيح ؟
Dialogue: 0,1:16:32.45,1:16:35.68,Default,,0,0,0,,.سأحضر لكم بعض الملابس وشيئًا دافئًا لتشربونه
Dialogue: 0,1:16:36.25,1:16:37.68,Default,,0,0,0,,.سأقوم بمساعدتك
Dialogue: 0,1:16:39.18,1:16:41.75,Default,,0,0,0,,هل تذكرين كيف تم اختطافك ؟
Dialogue: 0,1:16:41.75,1:16:44.75,Default,,0,0,0,,"أجل. لقد نوموني بمادة "إيثر
Dialogue: 0,1:16:41.75,1:16:45.78,aaaa,,0,0,0,,{\fscx137\fscy125\pos(984,127)}إيثر= محلول مُركّب من مجموعة أدوية ولديه رائحة مثل رائحة الغِراء
Dialogue: 0,1:16:44.75,1:16:46.07,Default,,0,0,0,,إيثر" ؟"
Dialogue: 0,1:16:46.07,1:16:49.98,Default,,0,0,0,,"أعتقد أن هذا المُخدر من صنع "بينڠا
Dialogue: 0,1:16:50.26,1:16:52.31,Default,,0,0,0,,هل له رائحة تُشبه رائحة الغِراء ؟
Dialogue: 0,1:16:52.31,1:16:55.16,Default,,0,0,0,,.نعم، كانت تبدو كذلك
Dialogue: 0,1:16:55.16,1:17:00.01,Default,,0,0,0,,.وذلك يعني بأن "ليونهارت" قد تم تنويمه قبل موته
Dialogue: 0,1:17:01.27,1:17:03.17,Default,,0,0,0,,هل سمعتي أشياء أُخرى عندما كُنتِ معهم ؟
Dialogue: 0,1:17:04.53,1:17:08.71,Default,,0,0,0,,.لقد كانوا غاضبين لأن أحدهم خالف الخطة
Dialogue: 0,1:17:08.71,1:17:10.71,Default,,0,0,0,,خالف الخطة ؟
Dialogue: 0,1:17:11.18,1:17:13.18,Default,,0,0,0,,! إذًا هي جريمة قتل
Dialogue: 0,1:17:13.18,1:17:14.47,Default,,0,0,0,,.أشكركم لانتظاركم
Dialogue: 0,1:17:14.78,1:17:16.27,Default,,0,0,0,,..تفضلي
Dialogue: 0,1:17:16.27,1:17:17.60,Default,,0,0,0,,.أشكرك
Dialogue: 0,1:17:17.60,1:17:20.55,Default,,0,0,0,,...كم هو دافئ- \N .سأضع لكم الثياب هنا-
Dialogue: 0,1:17:24.19,1:17:25.36,Default,,0,0,0,,.لذيذ
Dialogue: 0,1:17:30.19,1:17:33.18,Default,,0,0,0,,! فهمت، هذا كل ما في الأمر
Dialogue: 0,1:17:35.16,1:17:37.76,Default,,0,0,0,,"انتظريني هنا يا "هايبرا
Dialogue: 0,1:17:37.76,1:17:39.58,Default,,0,0,0,,...سأقوم حتمًا بحل هذا الأمر بطريقةٍ ما
Dialogue: 0,1:17:39.58,1:17:41.58,Default,,0,0,0,,! انتظر يا كونان-كن
Dialogue: 0,1:17:42.17,1:17:47.45,Default,,0,0,0,,.بحق، كم يُحب شينشي-كن أن ينتظره الناس
Dialogue: 0,1:17:50.22,1:17:51.19,Default,,0,0,0,,ما هذا ؟
Dialogue: 0,1:17:51.61,1:17:54.95,Default,,0,0,0,,.نتائج تحليل دم ليونهارت-سان
Dialogue: 0,1:17:56.53,1:17:57.75,Default,,0,0,0,,وبعد ؟
Dialogue: 0,1:17:57.75,1:18:00.91,Default,,0,0,0,,.كُشف أنه تعرّض لسُمّ قلويّ قوي جدًا
Dialogue: 0,1:18:00.91,1:18:04.28,Default,,0,0,0,,.أظنه نوعٌ من أنواع مواد التنظيف أو ما شابه ذلك
Dialogue: 0,1:18:04.28,1:18:07.11,Default,,0,0,0,,.لهذا السبب كانت آثار القيّح على فمه
Dialogue: 0,1:18:07.11,1:18:08.41,Default,,0,0,0,,—توقعت ذلك
Dialogue: 0,1:18:10.18,1:18:12.35,Default,,0,0,0,,! أبي
Dialogue: 0,1:18:12.70,1:18:14.75,Default,,0,0,0,,هل أنتَ بخيرٍ يا موري-كن ؟
Dialogue: 0,1:18:16.27,1:18:17.41,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:18:17.41,1:18:20.68,Default,,0,0,0,,! هـ هذه هي، وضعية: كوغورو النائم
Dialogue: 0,1:18:21.56,1:18:23.05,Default,,0,0,0,,...إلى الجميع
Dialogue: 0,1:18:23.32,1:18:25.65,Default,,0,0,0,,،كما توقعنا بأن الذي ساعد على اختطاف ناومي-سان
Dialogue: 0,1:18:25.65,1:18:31.01,Default,,0,0,0,,وقام بخطف آي-كن، وقتل ليونهارت-سان\N .هو مُجرمٌ موجودٌ بيننا الآن
Dialogue: 0,1:18:31.18,1:18:33.01,Default,,0,0,0,,أهذا يعني بأنه لم يكن انتحارًا ؟
Dialogue: 0,1:18:33.01,1:18:38.28,Default,,0,0,0,,.لا، لقد قُتل بمادةٍ سامّة بعد ان تم تخديره بشكلٍ كامل
Dialogue: 0,1:18:38.86,1:18:41.71,Default,,0,0,0,,ولِمَ قد يفعل شيئًا كهذا ؟
Dialogue: 0,1:18:41.71,1:18:47.01,Default,,0,0,0,,.لأن هذه الجريمة لم تكن ضمن خطته، بل حدثت بشكلٍ مُفاجئ
Dialogue: 0,1:18:48.18,1:18:54.18,Default,,0,0,0,,.لذلك، كان هو نفسه المُخدّر الذي أُستعمل لتنويم آي-كن
Dialogue: 0,1:18:54.75,1:18:57.51,Default,,0,0,0,,كانت له رائحة "الإيثر" أليسَ كذلك ؟
Dialogue: 0,1:18:57.98,1:18:59.16,Default,,0,0,0,,.أجل
Dialogue: 0,1:18:59.29,1:19:04.05,Default,,0,0,0,,.ثم سكب القهوة على الجثّة من أجل أن يخلط الرائحتين ببعضهما
Dialogue: 0,1:19:04.05,1:19:06.51,Default,,0,0,0,,...ولكن، لم نرى ذلك بالتسجيلات
Dialogue: 0,1:19:06.51,1:19:09.18,Default,,0,0,0,,...تم خِداعنا على أنها حادثة انتحار بتقنيةٍ تُدعى
Dialogue: 0,1:19:09.44,1:19:11.14,Default,,0,0,0,,"التزييف العميق"
Dialogue: 0,1:19:11.14,1:19:12.21,Default,,0,0,0,,!أحقًا ما تقوله ؟=
Dialogue: 0,1:19:12.21,1:19:14.10,Default,,0,0,0,,!التزييف العميق" ؟"
Dialogue: 0,1:19:14.10,1:19:16.68,Default,,0,0,0,,.بشكلٍ مُبسط، يعني أنه تسجيلٌ مُزيّيف
Dialogue: 0,1:19:16.68,1:19:18.16,Default,,0,0,0,,! هاه ؟ لا يُصدق
Dialogue: 0,1:19:18.16,1:19:21.08,Default,,0,0,0,,.لقد فهمت، لهذا السبب حدثت الجريمة بالمقهى
Dialogue: 0,1:19:21.18,1:19:22.19,Default,,0,0,0,,.أجل
Dialogue: 0,1:19:22.19,1:19:24.95,Default,,0,0,0,,،فكاميرات المُراقبة لا تتواجد بالغرف الخاصة
Dialogue: 0,1:19:25.18,1:19:29.25,Default,,0,0,0,,.لذا اختار المقهى وموعد التنظيف الاعتيادي لينفذ جريمته
Dialogue: 0,1:19:29.25,1:19:33.48,Default,,0,0,0,,.ومع ذلك، وقت التنظيم الاعتيادي لم يحدث آن ذاك
Dialogue: 0,1:19:33.48,1:19:36.95,Default,,0,0,0,,.أجل، لأنه اتصل بالمسؤولين وقام بإلغاءه
Dialogue: 0,1:19:37.61,1:19:40.91,Default,,0,0,0,,...وبعد ذلك تحرّك المُجرم على الشكل الآتي
Dialogue: 0,1:19:41.40,1:19:43.55,Default,,0,0,0,,...مثل ما تم اختطاف ناومي-سان
Dialogue: 0,1:19:43.92,1:19:47.08,Default,,0,0,0,,...وُضع ليونهارت-سان في عربة التنظيف وهو نائم
Dialogue: 0,1:19:47.30,1:19:50.38,Default,,0,0,0,,...وذهب به إلى المقهى في حين أنه كان مُتنكّرًا بملابس عُمّال التنظيف
Dialogue: 0,1:19:50.38,1:19:52.38,Default,,0,0,0,,.ومنع دخول أي أحد
Dialogue: 0,1:19:53.34,1:19:56.56,Default,,0,0,0,,.وبطيبعة الحال ستُسجّل كاميرات المُراقبة كل تحركاته
Dialogue: 0,1:19:57.23,1:20:01.88,Default,,0,0,0,,.بعد ذلك أعطى السُمّ لــ ليونهارت-سان لقوم بقتله
Dialogue: 0,1:20:02.40,1:20:05.12,Default,,0,0,0,,...وبقي معه حتى توفى بشكلٍ كامل
Dialogue: 0,1:20:05.80,1:20:08.61,Default,,0,0,0,,.لأجل أن يُمثّل طريقة موته
Dialogue: 0,1:20:09.50,1:20:10.61,Default,,0,0,0,,! فظيع
Dialogue: 0,1:20:10.61,1:20:16.39,Default,,0,0,0,,.لن يعرف كيف يستطيع تقليد طريقة موته، ما لم يراها مُسبقًا
Dialogue: 0,1:20:17.05,1:20:20.98,Default,,0,0,0,,،بعدها ارتدى المُجرم ملابس تشبه ملابس ليونهارت-سان
Dialogue: 0,1:20:20.98,1:20:23.65,Default,,0,0,0,,.وقام بتمثيل دور معاناته بعد أخذه للسُمّ
Dialogue: 0,1:20:24.38,1:20:26.98,Default,,0,0,0,,،ثم اِنهار تحت الطاولة
Dialogue: 0,1:20:27.18,1:20:34.78,Default,,0,0,0,,من أجل أن يتجنب أي اِختلافٍ بتسجيلات كاميرا\N.المقهى عند استبداله بالتسجيل المُزيّف
Dialogue: 0,1:20:34.78,1:20:36.78,Default,,0,0,0,,ارتدى ملابس مُشابهة تمامًا ؟
Dialogue: 0,1:20:36.78,1:20:37.80,Default,,0,0,0,,.أجل
Dialogue: 0,1:20:37.80,1:20:39.80,Default,,0,0,0,,...ففي التسجيل المُعدّل
Dialogue: 0,1:20:39.80,1:20:43.31,Default,,0,0,0,,CGالجسد كان للمُجرم أما الوجه فقد قام بتغييره بتقنية الــ
Dialogue: 0,1:20:43.31,1:20:44.84,Default,,0,0,0,,ماذا ؟=
Dialogue: 0,1:20:45.38,1:20:49.48,Default,,0,0,0,,CGلم يكن لديه الوقت الكافي لينشأ جسدًا بتقنية الــ
Dialogue: 0,1:20:49.99,1:20:52.68,Default,,0,0,0,,ولكن، كيف أمكنه فعل ذلك ؟
Dialogue: 0,1:20:52.96,1:20:57.95,Default,,0,0,0,,،لقد استعان بتقنية التعرّف العمري الشامل الذي صنعته ناومي-سان
Dialogue: 0,1:20:58.20,1:21:01.25,Default,,0,0,0,,CGبذلك تصبح تقنية لتصنيع الوجوه بواسطة الــ
Dialogue: 0,1:21:01.39,1:21:06.01,Default,,0,0,0,,.إذ بإمكانه أخذ أي صورة من سجلّات الموظفين
Dialogue: 0,1:21:06.01,1:21:10.18,Default,,0,0,0,,.ولكن يا موري-كن، لا أرى أمامي سوى تسجيل للضحية
Dialogue: 0,1:21:10.18,1:21:13.37,Default,,0,0,0,,ما هو دليلك على أنه تسجيلٌ مُزيّف ؟
Dialogue: 0,1:21:13.37,1:21:16.35,Default,,0,0,0,,...عندما رأيتُ التسجيل في بداية الأمر
Dialogue: 0,1:21:16.35,1:21:18.57,Default,,0,0,0,,! راودني وبقوة شعورٌ غريب
Dialogue: 0,1:21:18.87,1:21:20.57,Default,,0,0,0,,!شعور غريب ؟
Dialogue: 0,1:21:20.57,1:21:23.25,Default,,0,0,0,,.أمعنوا النظر بكفّ يده رجاءً
Dialogue: 0,1:21:30.45,1:21:31.75,Default,,0,0,0,,...انها
Dialogue: 0,1:21:31.75,1:21:34.95,Default,,0,0,0,,! تُشبه حركة النساء اللواتي يفعلنها عندما يضعن أحمر الشفاه
Dialogue: 0,1:21:35.14,1:21:37.24,Default,,0,0,0,,.أمي تفعلها دائمًا
Dialogue: 0,1:21:37.24,1:21:38.39,Default,,0,0,0,,.بالضبط
Dialogue: 0,1:21:38.72,1:21:42.11,Default,,0,0,0,,"هذه حركة مسح الكوب بعد الشرب منه"
Dialogue: 0,1:21:42.45,1:21:46.65,Default,,0,0,0,,...يبدو أنّكِ مُعتادةٌ على فعلها بإستمرار يا
Dialogue: 0,1:21:46.88,1:21:48.65,Default,,0,0,0,,.ڠريس-سان
Dialogue: 0,1:21:50.50,1:21:54.15,Default,,0,0,0,,.أعتقد أن هذه الحركة صارت عادة بالنسبة لك
Dialogue: 0,1:21:54.69,1:21:57.37,Default,,0,0,0,,.خاصةً أنك شخصٌ منتكرٌ بهيئة أُنثى
Dialogue: 0,1:21:57.37,1:21:59.37,Default,,0,0,0,,!متنكرٌ بهيئة أُنثى ؟
Dialogue: 0,1:21:59.37,1:22:04.18,Default,,0,0,0,,....أجل، وإن كان ما أفكر به صحيحًا، فهو على الأرجه
Dialogue: 0,1:22:04.60,1:22:07.00,Default,,0,0,0,,.ليسَ بأُنثى كما يُظهر لنا
Dialogue: 0,1:22:09.35,1:22:13.38,Default,,0,0,0,,...وبما أنّكَ لم تُعلّقي على ما أقوله، فأنت كما أتوقع
Dialogue: 0,1:22:14.46,1:22:16.81,Default,,0,0,0,,.لم أُعلّق على الموضوع لأنني مُتفاجأة
Dialogue: 0,1:22:16.81,1:22:19.38,Default,,0,0,0,,—لم أتوقع يومًا أن يُقال لي بأني لستُ مرأة
Dialogue: 0,1:22:19.38,1:22:21.16,Default,,0,0,0,,...سمعتُ أمرًا من "كونان" لذا
Dialogue: 0,1:22:21.16,1:22:23.16,Default,,0,0,0,,.."ران"-\Nنعم ؟-
Dialogue: 0,1:22:23.16,1:22:28.48,Default,,0,0,0,,لقد ركلتي رقبة أحد أولئك الذين قاموا بخطف آي-كن، صحيح ؟
Dialogue: 0,1:22:28.48,1:22:30.36,Default,,0,0,0,,...نـــ نعم
Dialogue: 0,1:22:30.36,1:22:31.64,Default,,0,0,0,,!ما الأمر ؟
Dialogue: 0,1:22:32.70,1:22:34.41,Default,,0,0,0,,! ...هذه الكدمة
Dialogue: 0,1:22:34.61,1:22:37.41,Default,,0,0,0,,! وفوقها... لديها تُفاحة آدم
Dialogue: 0,1:22:37.41,1:22:39.14,Default,,0,0,0,,!بجدية ؟
Dialogue: 0,1:22:50.80,1:22:52.81,Default,,0,0,0,,!رجلٌ يملك ظفائر ؟
Dialogue: 0,1:22:53.02,1:22:56.88,Default,,0,0,0,,! من تسلل إلى المقر في "فرانكفورت"... هو أنت
Dialogue: 0,1:22:56.88,1:22:58.08,Default,,0,0,0,,...آه
Dialogue: 0,1:22:58.08,1:23:02.05,Default,,0,0,0,,"في ذلك الوقت، وجدتك أحد موظفات "اليوروبول
Dialogue: 0,1:23:02.05,1:23:06.28,Default,,0,0,0,,.ظننت بأنها غادرت المكان ومع ذلك، كانت إمرأة مُزعجة
Dialogue: 0,1:23:12.69,1:23:14.01,Default,,0,0,0,,...عظيم
Dialogue: 0,1:23:15.56,1:23:18.17,Default,,0,0,0,,!من تكون ؟ وما الذي تفعله عندك ؟
Dialogue: 0,1:23:24.96,1:23:26.01,Default,,0,0,0,,هل أنتِ "كير" ؟
Dialogue: 0,1:23:26.01,1:23:27.38,Default,,0,0,0,,.أحدهم هرب
Dialogue: 0,1:23:27.38,1:23:30.28,Default,,0,0,0,,.أجل رأتني، تولّي أمرها
Dialogue: 0,1:23:33.38,1:23:36.71,Default,,0,0,0,,ما السبب الذي دفعك لقتل ليونهارت-سان ؟
Dialogue: 0,1:23:37.79,1:23:40.45,Default,,0,0,0,,.بسبب مهمة الاختطاف العشوائي
Dialogue: 0,1:23:40.70,1:23:44.57,Default,,0,0,0,,.اضطررنا حينها إلى تزييف المشاهد التي سجلتها كاميرات المُراقبة
Dialogue: 0,1:23:45.08,1:23:49.95,Default,,0,0,0,,...أردت مسح التسجيلات كلُيًا بعد أن عبثتُ بتوقيتها ولكن
Dialogue: 0,1:23:49.95,1:23:55.58,Default,,0,0,0,,.بعد أن أدلى ذلك الطفل بمُلاحظته، عرفَ حينها أن هنالك سرًّا أُخفيه عنه
Dialogue: 0,1:23:57.02,1:23:59.17,Default,,0,0,0,,ما معنى كل الذي شاهدناه ؟
Dialogue: 0,1:23:59.81,1:24:02.01,Default,,0,0,0,,.عليكَ أن تُخبرني بما يجري
Dialogue: 0,1:24:03.57,1:24:07.51,Default,,0,0,0,,.ذلك التسجيل، لقد سُجّل عندما كُنتَ في الغُرفة الرئيسية
Dialogue: 0,1:24:08.33,1:24:10.08,Default,,0,0,0,,!ما الذي تفعله يا هذا ؟
Dialogue: 0,1:24:20.58,1:24:25.41,Default,,0,0,0,,.لقد مسحت التسجيلات التي زيّفتُها، ولا دليل على أنني من قام بمسحها
Dialogue: 0,1:24:25.79,1:24:31.98,Default,,0,0,0,,...كان هو العقبة المُتبقية وستنجح الخطة بعد قتله ولكن
Dialogue: 0,1:24:34.73,1:24:35.85,Default,,0,0,0,,! لا تدعوه يهرب
Dialogue: 0,1:24:35.85,1:24:36.58,Default,,0,0,0,,! حاضر
Dialogue: 0,1:24:36.58,1:24:37.75,Default,,0,0,0,,! انتظر
Dialogue: 0,1:24:44.01,1:24:45.35,Default,,0,0,0,,!أنتِ مُجددًا ؟
Dialogue: 0,1:24:45.35,1:24:46.59,Default,,0,0,0,,.خذي هذه
Dialogue: 0,1:24:53.52,1:24:54.64,Default,,0,0,0,,! لا
Dialogue: 0,1:24:56.19,1:24:57.04,Default,,0,0,0,,! "ران"
Dialogue: 0,1:25:03.40,1:25:04.57,Default,,0,0,0,,أنتِ بخير ؟
Dialogue: 0,1:25:04.57,1:25:06.34,Default,,0,0,0,,.نعم
Dialogue: 0,1:25:06.34,1:25:12.61,Default,,0,0,0,,.تميلين بجسدكِ إلى اليسار بعد أن تضربي بيدكِ اليُمنى، عليكِ بالحذر
Dialogue: 0,1:25:12.73,1:25:13.59,Default,,0,0,0,,.حاضر
Dialogue: 0,1:25:14.65,1:25:16.41,Default,,0,0,0,,!إلى أين يُريد الذهاب ؟
Dialogue: 0,1:25:16.71,1:25:18.71,Default,,0,0,0,,! لن أسمح له بالهروب
Dialogue: 0,1:25:27.25,1:25:28.71,Default,,0,0,0,,! انعطف يمينًا
Dialogue: 0,1:25:28.71,1:25:29.57,Default,,0,0,0,,! حاضر
Dialogue: 0,1:25:31.77,1:25:34.35,Default,,0,0,0,,...لا.. ليسَ كذلك
Dialogue: 0,1:25:34.73,1:25:35.96,Default,,0,0,0,,...انه
Dialogue: 0,1:25:43.57,1:25:44.96,Default,,0,0,0,,! المعذرة
Dialogue: 0,1:25:55.23,1:25:56.59,Default,,0,0,0,,.انتظر
Dialogue: 0,1:25:57.75,1:26:00.95,Default,,0,0,0,,أنت مُجددًا ؟ .. كيف عرفت ؟
Dialogue: 0,1:26:01.20,1:26:04.88,Default,,0,0,0,,كاميرات المُراقبة في الممر معكوسة جزئيًا أليسَ كذلك ؟
Dialogue: 0,1:26:08.30,1:26:10.90,Default,,0,0,0,,.القرط الذي في أُذنك كان على الجهة الأخرى
Dialogue: 0,1:26:12.38,1:26:15.25,Default,,0,0,0,,متى بدأت تشك بأنني "ڠريس" ؟
Dialogue: 0,1:26:15.25,1:26:17.56,Default,,0,0,0,,.عندما طلبتُ القهوة
Dialogue: 0,1:26:17.56,1:26:22.95,Default,,0,0,0,,.لو أنك فرنسي، لكنت عرفت أن هذه الإشارة تعني رقم اثنان
Dialogue: 0,1:26:23.20,1:26:25.21,Default,,0,0,0,,حسنٌ، تُريد كوبًا واحدًا ؟
Dialogue: 0,1:26:26.02,1:26:28.31,Default,,0,0,0,,.ومع ذلك لم تعرف ما معنى تِلك الاشارة
Dialogue: 0,1:26:28.72,1:26:35.15,Default,,0,0,0,,...في ذلك الوقت أدركتُ بأنكَ شخصٌ غريب وتكذب لسببٍ ما
Dialogue: 0,1:26:35.44,1:26:37.15,Default,,0,0,0,,...كما هو متوقعٌ منك يا
Dialogue: 0,1:26:38.03,1:26:39.95,Default,,0,0,0,,"كودو شينتشي"
Dialogue: 0,1:26:40.92,1:26:42.08,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:26:42.28,1:26:45.18,Default,,0,0,0,,.أجريتُ بحثًا عنك بعد أن أثرتَ فضولي
Dialogue: 0,1:26:45.18,1:26:49.29,Default,,0,0,0,,!أيُعقل أنك تقلّصتَ ولاتزال حيًّا ؟
Dialogue: 0,1:26:49.29,1:26:52.31,Default,,0,0,0,,!هذا سيء ! .. ما العمل ؟ ما العمل ؟
Dialogue: 0,1:26:52.52,1:26:58.47,Default,,0,0,0,,تركتُ "ناومي" و "شيري" تهربان ولكن \N،لو أنني أريتُ ما لدي لــ"رام" فسوف ترتفع مرتبتي بالمُنظمة
Dialogue: 0,1:26:58.47,1:27:03.55,Default,,0,0,0,,.وعندها سأتمكن من تحطيم وجه "جين" الذي ظن بأنّه تخلّص منك
Dialogue: 0,1:27:05.90,1:27:11.18,Default,,0,0,0,,.على كل حال لا يُمكن لأيّ قاتلٍ أن يبقى مُتزنًا
Dialogue: 0,1:27:12.42,1:27:15.51,Default,,0,0,0,,.لهذا السبب يتصرّف على خلاف طبيعته المُعتادة
Dialogue: 0,1:27:15.89,1:27:17.51,Default,,0,0,0,,.ولكنك استثنائي
Dialogue: 0,1:27:18.12,1:27:21.23,Default,,0,0,0,,.أي أنك مُعتادٌ على رؤية الكثير من الناس وهم يموتون
Dialogue: 0,1:27:22.40,1:27:26.15,Default,,0,0,0,,..انكَ تُشبه "جين" كثيرًا ومع ذلك
Dialogue: 0,1:27:26.41,1:27:29.00,Default,,0,0,0,,...هو لا يرتكب أخطائًا فادحة مثلك
Dialogue: 0,1:27:29.00,1:27:32.75,Default,,0,0,0,,.انكَ مُجرّد سفاحٍ مُبتدئ يُحاول تقليد "جين" لا أكثر
Dialogue: 0,1:27:34.42,1:27:37.38,Default,,0,0,0,,! إياك وأن تستفزني بلفظ اسم ذلك الوغد
Dialogue: 0,1:27:41.00,1:27:45.98,Default,,0,0,0,,! "لقد أثرتَ غضبي عندما قُلت بأني أُشبه ذلك الوغد المدعو "جين
Dialogue: 0,1:27:45.98,1:27:50.05,Default,,0,0,0,,! أتقول بأنني أُقلّد ذلك اللعين
Dialogue: 0,1:27:51.36,1:27:55.15,Default,,0,0,0,,"سآخذك معي بطبيعة الحال يا "كودو شينتشي
Dialogue: 0,1:27:55.15,1:27:57.06,Default,,0,0,0,,،سأجعلك منك تذكارًا جميلًا
Dialogue: 0,1:27:57.06,1:28:00.88,Default,,0,0,0,, .بعد أن أجبرك على الاعتراف أمام "رام" بالطريقة التي جعلت بها جسدك يتقلّص
Dialogue: 0,1:28:07.86,1:28:09.17,Default,,0,0,0,,! أيها الوغد
Dialogue: 0,1:28:09.40,1:28:10.78,Default,,0,0,0,,! كونان-كن
Dialogue: 0,1:28:12.03,1:28:13.03,Default,,0,0,0,,! سُحقًا
Dialogue: 0,1:28:13.03,1:28:14.25,Default,,0,0,0,,! مؤلم
Dialogue: 0,1:28:14.77,1:28:15.97,Default,,0,0,0,,! كونان-كن
Dialogue: 0,1:28:15.97,1:28:17.97,Default,,0,0,0,,!ماذا فعل بك ذلك الشخص ؟
Dialogue: 0,1:28:17.97,1:28:19.29,Default,,0,0,0,,.أسرع بالذهاب إلى العيادة
Dialogue: 0,1:28:19.29,1:28:21.19,Default,,0,0,0,,..أنا بخير-\N! لا يمكن-
Dialogue: 0,1:28:21.19,1:28:24.95,Default,,0,0,0,,.على أيّ حال، أعتذر لأنني صرختُ عليكِ في ذلك الوقت
Dialogue: 0,1:28:25.27,1:28:28.01,Default,,0,0,0,,.لا عليك يا كونان-كن
Dialogue: 0,1:28:28.01,1:28:30.52,Default,,0,0,0,,.وأنا أعتذر منك لأنني لم أثق بك حينها
Dialogue: 0,1:28:30.92,1:28:32.72,Default,,0,0,0,,! أوي ! افتح الباب
Dialogue: 0,1:28:33.80,1:28:35.31,Default,,0,0,0,,! افتح الباب رجاءً
Dialogue: 0,1:28:36.01,1:28:37.58,Default,,0,0,0,,! لن أدعك تهرب
Dialogue: 0,1:28:39.43,1:28:40.68,Default,,0,0,0,,!آمورو-سان ؟
Dialogue: 0,1:28:40.97,1:28:42.97,Default,,0,0,0,,ألا تزال موجودًا في "عوامة المُحيط" ؟
Dialogue: 0,1:28:42.97,1:28:44.35,Default,,0,0,0,,..نـ نعم
Dialogue: 0,1:28:44.35,1:28:47.08,Default,,0,0,0,,! ما الذي تفعله ؟ عليكَ الهرب في الحال
Dialogue: 0,1:28:47.08,1:28:49.08,Default,,0,0,0,,...فالأمر هنالك قريبًا سوف
Dialogue: 0,1:28:50.78,1:28:53.91,Default,,0,0,0,,! ما الذي تقوله ؟! إذًا يجب عليَّ أن أخبر الجميع بسرعة
Dialogue: 0,1:28:54.12,1:28:55.28,Default,,0,0,0,,.لا
Dialogue: 0,1:28:55.60,1:28:57.47,Default,,0,0,0,,.لقد فات الأوان
Dialogue: 0,1:28:58.07,1:28:59.26,Default,,0,0,0,,! أُكرر
Dialogue: 0,1:28:59.26,1:29:04.18,Default,,0,0,0,,،يجب على الجميع إخلاء المكان في الحال\N .وعليكم الانتباه فرُبما تكون القوارب مستهدفة أيضًا
Dialogue: 0,1:29:05.08,1:29:08.78,Default,,0,0,0,,!أيُريد اِغراق هذا المكان بمن فيه مع النظام ؟
Dialogue: 0,1:29:08.97,1:29:11.28,Default,,0,0,0,,"سأعتمد عليكَ في توّلي الأمر يا "ميڠوري
Dialogue: 0,1:29:11.28,1:29:12.54,Default,,0,0,0,,! حاضر
Dialogue: 0,1:29:13.15,1:29:19.55,Default,,0,0,0,,.صدر أمرٌ بالإخلاء الفوري، لذا على الموظفين إخلاء المكان بسرعة رجاءً
Dialogue: 0,1:29:19.96,1:29:20.97,Default,,0,0,0,,...نُكرر
Dialogue: 0,1:29:20.97,1:29:23.13,Default,,0,0,0,,! استيقظ يا أبي
Dialogue: 0,1:29:26.25,1:29:27.58,Default,,0,0,0,,! أبي
Dialogue: 0,1:29:27.72,1:29:30.38,Default,,0,0,0,,.عدوّنا هي غواصة واحد لا أكثر
Dialogue: 0,1:29:30.38,1:29:32.38,Default,,0,0,0,,.والمعدات بيننا مختلفة
Dialogue: 0,1:29:32.52,1:29:33.98,Default,,0,0,0,,! لنُجهّز المُضادات
Dialogue: 0,1:29:33.98,1:29:34.99,Default,,0,0,0,,! حاضر
Dialogue: 0,1:29:34.99,1:29:36.03,Default,,0,0,0,,المُضادات ؟
Dialogue: 0,1:29:36.03,1:29:38.22,Default,,0,0,0,,.صاروخٌ مُضاد يُحرّف مسار طوربيد العدو
Dialogue: 0,1:29:38.24,1:29:40.11,Default,,0,0,0,,.على العموم، أسرع بالهروب من هناك
Dialogue: 0,1:29:40.11,1:29:41.63,Default,,0,0,0,,...آآ- انتظر قليلًا
Dialogue: 0,1:29:43.97,1:29:44.97,Default,,0,0,0,,آكاي-سان ؟
Dialogue: 0,1:29:45.99,1:29:47.52,Default,,0,0,0,,أتقول "آكاي" ؟
Dialogue: 0,1:29:48.97,1:29:51.28,Default,,0,0,0,,كيف يجري الوضع عندك أيها الصبي ؟
Dialogue: 0,1:29:51.43,1:29:52.57,Default,,0,0,0,,...تمهل
Dialogue: 0,1:29:53.85,1:29:56.55,Default,,0,0,0,,.يُحاول "بينڠا" الهرب إلى الغواصة
Dialogue: 0,1:29:56.81,1:30:01.31,Default,,0,0,0,,.حصلتُ من الجيش الأمريكي على سلاحٍ يُصيب الغواصات
Dialogue: 0,1:30:01.50,1:30:04.48,Default,,0,0,0,,!أتريد استعمال سلاحٍ أمريكي داخل الأراضي اليابانية ؟
Dialogue: 0,1:30:04.48,1:30:06.48,Default,,0,0,0,,!هل هذا صوت "آمورو" ؟
Dialogue: 0,1:30:06.48,1:30:08.66,Default,,0,0,0,,"لا، أقصد "فوريا ري
Dialogue: 0,1:30:08.88,1:30:15.08,Default,,0,0,0,,من واجب الجيش الأمريكي المُتمركز باليابان\N أن يقضي على أي خطر يُهدد أمنها، أليسَ كذلك ؟
Dialogue: 0,1:30:16.50,1:30:20.91,Default,,0,0,0,,.لا أعتقد أن كلامًا كهذا يصدر من عميل "أف بي آي" يعمل لوحده باليابان
Dialogue: 0,1:30:21.20,1:30:23.23,Default,,0,0,0,,.عليّنا أن لا نُهدر وقتنا من الآن فصاعدًا
Dialogue: 0,1:30:23.96,1:30:26.82,Default,,0,0,0,,تستطيع إيقافها بسلاحك صحيح ؟
Dialogue: 0,1:30:26.82,1:30:27.96,Default,,0,0,0,,.أجل
Dialogue: 0,1:30:27.96,1:30:30.41,Default,,0,0,0,,.ولكن عليّ معرفة مكان الغواصة أولًا
Dialogue: 0,1:30:30.70,1:30:32.64,Default,,0,0,0,,أيمكنك فعلها أيها الصبي ؟
Dialogue: 0,1:30:32.64,1:30:35.38,Default,,0,0,0,,! أجل. سأقوم بذلك
Dialogue: 0,1:30:35.88,1:30:38.41,Default,,0,0,0,,...أفضل قناص بالمنظمة
Dialogue: 0,1:30:38.74,1:30:42.25,Default,,0,0,0,,! "قم بذلك قبل وصول خفر السواحل يا "راي
Dialogue: 0,1:30:42.25,1:30:45.81,Default,,0,0,0,,"بالطبع سأفعل ذلك يا "باربون
Dialogue: 0,1:30:49.99,1:30:53.71,Default,,0,0,0,,.تبقى دقيقتان حتى وصول المشتبه به يا فوريا-سان
Dialogue: 0,1:30:54.88,1:30:56.18,Default,,0,0,0,,!فوريا-سان ؟
Dialogue: 0,1:30:56.50,1:30:58.18,Default,,0,0,0,,.أجل، فهمت
Dialogue: 0,1:31:03.22,1:31:08.15,Default,,0,0,0,,! ستصل قوارب الشرطة قريبًا، لذا أرجو منكم ركوبها لنخلي المكان
Dialogue: 0,1:31:08.15,1:31:09.81,Default,,0,0,0,,.لدي سفينتي الخاصة
Dialogue: 0,1:31:09.81,1:31:11.81,Default,,0,0,0,,.حسنٌ، أعتمد عليك
Dialogue: 0,1:31:23.02,1:31:25.18,Default,,0,0,0,,! هنالك مُجددًا من يتحكم بالبوابة عن بعد
Dialogue: 0,1:31:25.18,1:31:26.19,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:31:26.19,1:31:27.91,Default,,0,0,0,,ألا يجب أن تكون الثغرة مُغلقة ؟
Dialogue: 0,1:31:27.91,1:31:29.70,Default,,0,0,0,,.انه بابٌ خلفي جديد
Dialogue: 0,1:31:29.70,1:31:31.40,Default,,0,0,0,,...ڠريس" أيها الـــ"
Dialogue: 0,1:31:32.00,1:31:33.70,Default,,0,0,0,,متى فعلها ؟
Dialogue: 0,1:31:35.63,1:31:41.05,Default,,0,0,0,,.سأوقفها، سأوقفها، سأوقف غواصتهم مهما كلّف الأمر
Dialogue: 0,1:31:41.28,1:31:42.50,Default,,0,0,0,,! أطلق
Dialogue: 0,1:31:47.48,1:31:48.81,Default,,0,0,0,,! تم رصد صواريخ الطوربيد
Dialogue: 0,1:31:49.76,1:31:51.17,Default,,0,0,0,,! أطلقوا المُضادات
Dialogue: 0,1:31:51.17,1:31:52.18,Default,,0,0,0,,..اطلق المُضادات
Dialogue: 0,1:31:52.18,1:31:53.31,Default,,0,0,0,,! عُلم
Dialogue: 0,1:32:08.88,1:32:12.78,Default,,0,0,0,,! لقد تغيّر مسار صواريخ الطوربيد
Dialogue: 0,1:32:27.60,1:32:30.05,Default,,0,0,0,,! سُحقًا، فشلنا بسبب المضادات
Dialogue: 0,1:32:30.05,1:32:32.18,Default,,0,0,0,,! لا يُهمني، واصلوا الهجوم
Dialogue: 0,1:32:32.18,1:32:33.19,Default,,0,0,0,,! حاضر
Dialogue: 0,1:32:43.29,1:32:45.01,Default,,0,0,0,,.أشكرك يا بروفيسور
Dialogue: 0,1:32:56.88,1:32:58.48,Default,,0,0,0,,...لا تفعل ذلك
Dialogue: 0,1:32:58.48,1:33:04.41,Default,,0,0,0,,.يجب أن يغرق ذلك الصندوق هناك... في أعماق البحر
Dialogue: 0,1:33:10.55,1:33:12.18,Default,,0,0,0,,! أُغلقت فتحة اطلاق المُضادات
Dialogue: 0,1:33:12.18,1:33:13.19,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:33:13.19,1:33:14.27,Default,,0,0,0,,! ..."إيد"
Dialogue: 0,1:33:14.96,1:33:19.88,Default,,0,0,0,,...لا فائدة، لقد اخترقوا نظام الحماية أيضًا
Dialogue: 0,1:33:19.88,1:33:21.88,Default,,0,0,0,,!ماذا قُلت ؟
Dialogue: 0,1:33:24.36,1:33:26.09,Default,,0,0,0,,! اطلقوا صواريخ طوربيدية أُخرى
Dialogue: 0,1:33:26.09,1:33:28.75,Default,,0,0,0,,! "فلتحسم الأمر أيها المُدير "ماكينو
Dialogue: 0,1:33:28.75,1:33:30.75,Default,,0,0,0,,! لدينا 90 ثانية حتى تصل الصواريخ
Dialogue: 0,1:33:33.17,1:33:35.70,Default,,0,0,0,,! إلى الجميع، فلتخلوا المكان حالًا
Dialogue: 0,1:33:35.70,1:33:37.93,Default,,0,0,0,,! اخلوا كل الأقسام في المُنشأة
Dialogue: 0,1:33:37.93,1:33:39.19,Default,,0,0,0,,! أسرعوا
Dialogue: 0,1:33:42.92,1:33:45.98,Default,,0,0,0,,.ضغط الماء أعلى من ضغط الهواء
Dialogue: 0,1:33:45.98,1:33:49.89,Default,,0,0,0,,.تصل سرعة الموجات الصادم إلى 1500 متر في الثانية
Dialogue: 0,1:33:50.50,1:33:54.51,Default,,0,0,0,,الطريقة الوحيدة لتجنّب هجوم صواريخ الطوربيد\N.هي المكوث بين الصخور المرجانية
Dialogue: 0,1:33:59.04,1:34:00.88,Default,,0,0,0,,ألم يُطلقوا المُضادات ؟
Dialogue: 0,1:34:00.98,1:34:02.88,Default,,0,0,0,,هل اخلوا المنشأة في الوقت المناسب ؟
Dialogue: 0,1:34:03.09,1:34:04.09,Default,,0,0,0,,...عشر ثوانٍ على الأصطدام
Dialogue: 0,1:34:04.09,1:34:06.09,Default,,0,0,0,,{\pos(1018,122)}...9 ... 10
Dialogue: 0,1:34:04.96,1:34:08.09,Default,,0,0,0,,"وبهذا ستنتهي "عوامة المُحيط
Dialogue: 0,1:34:08.09,1:34:13.71,Default,,0,0,0,,1 ... 2 ... 3 ... 4 ... 5 ... 6
Dialogue: 0,1:34:13.84,1:34:15.19,Default,,0,0,0,,.صفر
Dialogue: 0,1:34:26.84,1:34:28.51,Default,,0,0,0,,.ياله من انفجار
Dialogue: 0,1:34:29.24,1:34:30.88,Default,,0,0,0,,...عوامة المُحيط" قد"
Dialogue: 0,1:34:34.90,1:34:40.51,Default,,0,0,0,,.كان بإمكانهم استغلال ذلك النظام لصالحهم لذا لم أتوقع أن يُدمروه
Dialogue: 0,1:34:40.51,1:34:45.38,Default,,0,0,0,,أم أن هنالك سببًا ما أجبرهم على تدميره ؟
Dialogue: 0,1:34:49.52,1:34:51.58,Default,,0,0,0,,.انه اتصالٌ من "بينڠا" يا أخي
Dialogue: 0,1:34:51.58,1:34:52.72,Default,,0,0,0,,.أعطني أياه
Dialogue: 0,1:34:53.32,1:34:55.98,Default,,0,0,0,,.يبدو أن اللمسات الأخيرة قد اكتملت
Dialogue: 0,1:34:56.19,1:35:00.05,Default,,0,0,0,,.عد إلينا بسرعة، يجب أن أريك شيئًا
Dialogue: 0,1:35:00.25,1:35:02.13,Default,,0,0,0,,.يا لها من مُصادفة
Dialogue: 0,1:35:02.13,1:35:08.10,Default,,0,0,0,,.وأنا أيضًا أحمل لك هديةً ستُسقط مكانتك وتسلّطك من بعدها
Dialogue: 0,1:35:08.10,1:35:10.38,Default,,0,0,0,,.كم أنا مُتشوقٌ للقائنا
Dialogue: 0,1:35:10.38,1:35:12.56,Default,,0,0,0,,.أجل، أراك فيما بعد
Dialogue: 0,1:35:14.51,1:35:16.25,Default,,0,0,0,,هل تسمعني يا آكاي-سان ؟
Dialogue: 0,1:35:16.25,1:35:18.07,Default,,0,0,0,,.وجدتُ الغواصة
Dialogue: 0,1:35:18.07,1:35:20.71,Default,,0,0,0,,.إنها في وسط منطقة الصخور المرجانية
Dialogue: 0,1:35:20.94,1:35:24.28,Default,,0,0,0,,...حددتُ مكان الصخور المرجانية على الخريطة ولكن
Dialogue: 0,1:35:25.13,1:35:27.01,Default,,0,0,0,,.انها منطقة واسعة جدًا
Dialogue: 0,1:35:27.21,1:35:30.31,Default,,0,0,0,,هل يُمكنك اصابة الغواصة إن رأيتها ؟
Dialogue: 0,1:35:30.99,1:35:33.15,Default,,0,0,0,,يمكنني ذلك، ولكن ما العمل ؟
Dialogue: 0,1:35:33.15,1:35:35.15,Default,,0,0,0,,...سأفعل شيئًا ما
Dialogue: 0,1:35:35.29,1:35:36.67,Default,,0,0,0,,...كودو-كن
Dialogue: 0,1:35:40.86,1:35:41.90,Default,,0,0,0,,! آي-كن
Dialogue: 0,1:35:43.63,1:35:46.28,Default,,0,0,0,,!ما الذي يفعله ذلك الغبي ؟
Dialogue: 0,1:35:46.43,1:35:49.61,Default,,0,0,0,,—لا تفعلي ذلك يا آي-كن، فمدخرته على وشك
Dialogue: 0,1:35:49.61,1:35:51.04,Default,,0,0,0,,! احذر يا بروفيسور
Dialogue: 0,1:35:55.13,1:35:58.28,Default,,0,0,0,,.لقد غرقت "عوامة المُحيط" بالكامل
Dialogue: 0,1:35:58.28,1:35:59.36,Default,,0,0,0,,.عظيم
Dialogue: 0,1:35:59.36,1:36:02.15,Default,,0,0,0,,"لنسرع إلى حيث سنرى "بينڠا
Dialogue: 0,1:36:36.64,1:36:38.38,Default,,0,0,0,,...ليسَ بعد
Dialogue: 0,1:36:38.62,1:36:41.21,Default,,0,0,0,,.أريد المزيد من الوقت
Dialogue: 0,1:36:45.26,1:36:48.51,Default,,0,0,0,,! هذا سيء، يداي قد تخدرتا
Dialogue: 0,1:36:54.35,1:36:56.41,Default,,0,0,0,,! ...الآن
Dialogue: 0,1:37:07.55,1:37:09.35,Default,,0,0,0,,! البحر يُضيء
Dialogue: 0,1:37:09.35,1:37:10.75,Default,,0,0,0,,!ماذا ؟
Dialogue: 0,1:37:15.02,1:37:16.75,Default,,0,0,0,,...تم الطقاتها
Dialogue: 0,1:37:18.72,1:37:20.37,Default,,0,0,0,,! فلتغرقي
Dialogue: 0,1:37:25.50,1:37:26.85,Default,,0,0,0,,! أُصيب المُحرّك
Dialogue: 0,1:37:26.85,1:37:28.70,Default,,0,0,0,,!ماذا ؟ ما الذي يحدث ؟
Dialogue: 0,1:37:28.70,1:37:31.55,Default,,0,0,0,,.سرعتنا تتناقص لأن المُحرّك بدأ ينغمر بالماء
Dialogue: 0,1:37:32.38,1:37:33.72,Default,,0,0,0,,.توقف المُحرّك
Dialogue: 0,1:37:33.72,1:37:35.28,Default,,0,0,0,,! استخدموا المُحرّك الاحتياطي
Dialogue: 0,1:37:35.28,1:37:37.28,Default,,0,0,0,,! لا يُمكن ذلك، انه لا يعمل
Dialogue: 0,1:37:37.60,1:37:39.88,Default,,0,0,0,,.أحسنت صنعًا أيها الصبي
Dialogue: 0,1:38:04.96,1:38:06.61,Default,,0,0,0,,.كودو-كن
Dialogue: 0,1:38:24.66,1:38:25.77,Default,,0,0,0,,! لا يُصدق
Dialogue: 0,1:38:25.96,1:38:28.65,Default,,0,0,0,,! لا يُصدق ...كودو-كن
Dialogue: 0,1:38:41.58,1:38:43.98,Default,,0,0,0,,! لا يُمكنك... لا يُمكنك
Dialogue: 0,1:39:03.79,1:39:05.71,Default,,0,0,0,,..كان ذلك وشيكًا
Dialogue: 0,1:39:05.71,1:39:07.94,Default,,0,0,0,,"لقد أنقذتيني يا "هايبرا
Dialogue: 0,1:39:09.09,1:39:12.01,Default,,0,0,0,,.حسنٌ، لنسبح إلى الأعلى
Dialogue: 0,1:39:12.67,1:39:16.38,Default,,0,0,0,,.ان صعدنا بسرعة إلى السطح، سنتأثر بضغط الماء
Dialogue: 0,1:39:28.61,1:39:30.58,Default,,0,0,0,,!ألا يُريدون مني أن أدخل ؟
Dialogue: 0,1:39:30.58,1:39:32.26,Default,,0,0,0,,! ذلك الوغد
Dialogue: 0,1:39:32.79,1:39:35.21,Default,,0,0,0,,...اسمع يا كودو-كن
Dialogue: 0,1:39:35.94,1:39:44.81,Default,,0,0,0,,.ان عرفت المُنظمة بأنني هي "شيري" .. فسيتورط الجميع على هذه الحالة
Dialogue: 0,1:39:45.34,1:39:46.47,Default,,0,0,0,,.صحيح
Dialogue: 0,1:39:46.89,1:39:50.75,Default,,0,0,0,,.لم يعد لي مكانٌ أعود إليه
Dialogue: 0,1:39:51.54,1:39:55.95,Default,,0,0,0,,.لذا، ستكون هذه المرة الأخيرة التي أبقى بها معك
Dialogue: 0,1:39:57.40,1:40:02.28,Default,,0,0,0,,.الوداع يا... إيدوڠاوا كونان-كن
Dialogue: 0,1:40:06.03,1:40:08.58,Default,,0,0,0,,.لا داعي لهذه التعابير التي على وجهك
Dialogue: 0,1:40:08.58,1:40:12.31,Default,,0,0,0,,.أخبرتكِ من قبل، أنني سأحّل الأمر بطريقةٍ ما حتمًا
Dialogue: 0,1:40:17.60,1:40:21.86,Default,,0,0,0,,.ومع ذلك، ستواجهنا الكثير من المشاكل في وقتٍ لاحق
Dialogue: 0,1:40:23.31,1:40:24.95,Default,,0,0,0,,لِمَ ؟
Dialogue: 0,1:40:25.92,1:40:28.53,Default,,0,0,0,,...لِمَ أنت دائمًا
Dialogue: 0,1:40:28.66,1:40:29.87,Default,,0,0,0,,...دائمًا
Dialogue: 0,1:40:30.07,1:40:32.88,Default,,0,0,0,,تُظهر هذه التعابير على وجهك ؟
Dialogue: 0,1:40:35.57,1:40:40.05,Default,,0,0,0,,...كودو-كن، أنت لا تعرف ولكن
Dialogue: 0,1:40:40.58,1:40:45.55,Default,,0,0,0,,.نحن قبل قليل، قبلّنا بعضنا
Dialogue: 0,1:40:55.14,1:40:57.08,Default,,0,0,0,,! الغواصة مُهشّمة
Dialogue: 0,1:41:05.66,1:41:08.71,Default,,0,0,0,,أهذا كل ما في الأمر يا "جين" ؟
Dialogue: 0,1:41:29.41,1:41:30.59,Default,,0,0,0,,! هذا سيء
Dialogue: 0,1:41:40.39,1:41:45.28,Default,,0,0,0,,! اِنــــــــطــــــــــــلـــــــــــــــــقــــــــــــــــــــــي
Dialogue: 0,1:42:06.48,1:42:08.61,Default,,0,0,0,,لِمَ دمرّتها ؟
Dialogue: 0,1:42:08.61,1:42:13.24,Default,,0,0,0,,.لأنّها تحتوي على كثيرٍ من أسرار مُنظمتنا
Dialogue: 0,1:42:13.24,1:42:15.54,Default,,0,0,0,,هل أخبرت "بينڠا" بذلك ؟
Dialogue: 0,1:42:15.93,1:42:18.60,Default,,0,0,0,,.حسنٌ، لا أدري ان فعلتُ ذلك
Dialogue: 0,1:42:26.38,1:42:29.30,Default,,0,0,0,,! كونان-كن
Dialogue: 0,1:42:29.43,1:42:30.50,Default,,0,0,0,,! "ران"
Dialogue: 0,1:42:30.50,1:42:33.28,Default,,0,0,0,,! سعيدةٌ لأنكما على ما يُرام
Dialogue: 0,1:42:33.80,1:42:35.96,Default,,0,0,0,,"لقد نجونا يا "هايبرا
Dialogue: 0,1:42:39.78,1:42:41.51,Default,,0,0,0,,! "أوي "هايبرا
Dialogue: 0,1:42:45.16,1:42:48.31,Default,,0,0,0,,! "هايبرا" ... أوي "هايبرا"
Dialogue: 0,1:42:48.31,1:42:50.42,Default,,0,0,0,,! سُحقًا هذه أعراض ضغط الماء
Dialogue: 0,1:42:55.07,1:42:57.31,Default,,0,0,0,,! مُشكلة ! .. آي-تشان
Dialogue: 0,1:42:57.31,1:42:59.00,Default,,0,0,0,,.ابتعد يا كونان-كن
Dialogue: 0,1:42:59.00,1:43:01.61,Default,,0,0,0,,!ما العمل الآن ؟
Dialogue: 0,1:43:12.77,1:43:15.08,Default,,0,0,0,,...رُبما هي نصف نائمة
Dialogue: 0,1:43:16.72,1:43:21.04,Default,,0,0,0,,.أرجعتُ لها شفتيك... بالشكل المُناسب
Dialogue: 0,1:46:48.45,1:46:52.80,Default,,0,0,0,,.فشلَ اعادة بناء "عوامة المحيط" في هاتشيوجيما
Dialogue: 0,1:46:52.78,1:46:59.21,Default,,0,0,0,,{\pos(1000,175.667)}في حين أنها ستُبنى مُنشأةٌ تصل كاميرات المُراقبة في العالم\N.وتابعة "للانتربول" ولكن في بلدٍ غير اليابان
Dialogue: 0,1:46:58.53,1:47:01.95,Default,,0,0,0,, ستذهبين إلى "عوامة المُحيط" الجديدة، صحيح ؟
Dialogue: 0,1:47:02.34,1:47:04.38,Default,,0,0,0,,أين سيبنونها هذه المرة ؟
Dialogue: 0,1:47:04.38,1:47:07.31,Default,,0,0,0,,.أعتذر منكِ، لا أستطيع اخبارك
Dialogue: 0,1:47:07.31,1:47:09.51,Default,,0,0,0,,...هكذا إذًا- \N! أعتذر إليكِ-
Dialogue: 0,1:47:09.78,1:47:11.12,Default,,0,0,0,,..لا عليكِ
Dialogue: 0,1:47:11.12,1:47:13.36,Default,,0,0,0,,القوانين تمنعكِ من ذلك صحيح ؟
Dialogue: 0,1:47:14.39,1:47:18.65,Default,,0,0,0,,-أقوال وأفعال الأطفال في بعض الأحيان، قد تُغيّر الحياة إلى الأفضل-
Dialogue: 0,1:47:19.80,1:47:26.01,Default,,0,0,0,,.وأنا ما عليه الآن حقًا، هو بفضلك
Dialogue: 0,1:47:26.84,1:47:28.37,Default,,0,0,0,,.أشكركِ
Dialogue: 0,1:47:30.20,1:47:31.98,Default,,0,0,0,,.حسنٌ، انا ذاهبة
Dialogue: 0,1:47:31.98,1:47:32.88,Default,,0,0,0,,.نعم
Dialogue: 0,1:47:42.00,1:47:46.78,Default,,0,0,0,,"سعيدةٌ بلقاءك مُجددًا يا... "شيهو
Dialogue: 0,1:47:56.92,1:47:59.07,Default,,0,0,0,,!هاه ؟ "بليموت" ؟
Dialogue: 0,1:47:59.07,1:48:00.01,Default,,0,0,0,,.أجل
Dialogue: 0,1:48:00.01,1:48:03.18,Default,,0,0,0,,.على الأرجح أن "بليموت" هي التي تنكّرت بهيئة "شيري" عدّة مرات
Dialogue: 0,1:48:03.25,1:48:07.08,Default,,0,0,0,,.وتحرّكت أمام الكاميرات بمناطق مختلفة لتُصوّرها
Dialogue: 0,1:48:07.61,1:48:11.91,Default,,0,0,0,,.وبفضلها، تخلّت المُنظمة عن فكرة التعرّف العمري الشامل
Dialogue: 0,1:48:11.91,1:48:13.91,Default,,0,0,0,,ولكن لِمَ فعلت "بليموت" ذلك ؟
Dialogue: 0,1:48:13.91,1:48:15.16,Default,,0,0,0,,.من يدري
Dialogue: 0,1:48:15.25,1:48:18.71,Default,,0,0,0,,.اعتقدتُ أن لديكَ اجابةً على ذلك
Dialogue: 0,1:48:19.25,1:48:24.84,Default,,0,0,0,,"من جهةٍ أُخرى، فإن عضو المنطمة المدعو "بينڠا\N .قد اختفى كُليًّا بدون أي أثرٍ له
Dialogue: 0,1:48:24.84,1:48:26.84,Default,,0,0,0,,هل تعرف أي شيءٍ عنه ؟
Dialogue: 0,1:48:27.01,1:48:28.37,Default,,0,0,0,,.من يدري
Dialogue: 0,1:48:29.38,1:48:33.14,Default,,0,0,0,,.هم لم يُبدو أي تحرّكٍ بعد الحادثة
Dialogue: 0,1:48:33.14,1:48:37.05,Default,,0,0,0,,.أعتقد أن ذلك المدعو "بينڠا" قد كان قريبًا من الغواصة عندما انفجرت
Dialogue: 0,1:48:37.39,1:48:38.69,Default,,0,0,0,,ما الأمر ؟
Dialogue: 0,1:48:39.05,1:48:40.85,Default,,0,0,0,,.لا، لا شيء
Dialogue: 0,1:48:40.85,1:48:44.68,Default,,0,0,0,,.إذًا، لنأكل ولعند إلى منزلنا
Dialogue: 0,1:48:44.68,1:48:46.13,Default,,0,0,0,,.لن نأكل الطعام المقلي
Dialogue: 0,1:48:46.13,1:48:49.70,Default,,0,0,0,,! ولِمَ لا، لا تكوني قاسيةً يا آي-كن
Dialogue: 0,1:48:49.70,1:48:52.44,Default,,0,0,0,,.بالطبع سأكون كذلك، فأنا أعرف أنك تأكل من وراء ظهري
Dialogue: 0,1:48:52.45,1:48:55.25,Default,,0,0,0,,.لقد فُضحَ أمرك يا بروفيسور
Dialogue: 0,1:48:56.36,1:49:04.15,Default,,0,0,0,,"انه عملك أن تعرف لِمَ قُمت بمساعدتكم يا أيها "الرصاصة الفضّية-كن
Dialogue: 0,1:49:25.48,1:49:28.45,Default,,0,0,0,,! "لن أُسامحك يا "كيد
Dialogue: 0,1:49:28.45,1:49:29.80,Default,,0,0,0,,هاه ؟! لِمَ ؟
Dialogue: 0,1:49:29.80,1:49:31.80,Default,,0,0,0,,.انها ليست قُبلة
