Dialogue: 0,0:00:49.97,0:00:54.28,Default 2,,0,0,0,,!مهلًا! انظر إلى هذا\N!هناك ديناصور
Dialogue: 0,0:00:54.28,0:00:55.44,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:00:58.02,0:01:01.47,Default 2,,0,0,0,,يا إلهي، دائمًا ما يختفي فجأة
Dialogue: 0,0:01:06.72,0:01:09.66,Default 2,,0,0,0,,!تفضلي\N!لابد أنك ظمآنة
Dialogue: 0,0:01:09.66,0:01:11.36,Default 2,,0,0,0,,...شكرًا
Dialogue: 0,0:01:11.36,0:01:15.03,Default 2,,0,0,0,,!...لا! تبقى ثلاث دقائق على
Dialogue: 0,0:01:15.03,0:01:16.66,Default 2,,0,0,0,,!تمهل يا [شينتشي]
Dialogue: 0,0:01:25.48,0:01:27.54,Default 2,,0,0,0,,حسنًا لقد وصلنا في الوقت المناسب
Dialogue: 0,0:01:27.54,0:01:30.58,Default 2,,0,0,0,,ما هذا المكان؟\N...إنها مجرد ساحةٍ عامةٍ عادية
Dialogue: 0,0:01:30.58,0:01:32.25,Default 2,,0,0,0,,!شاهدي فقط
Dialogue: 0,0:01:32.25,0:01:35.82,Default 2,,0,0,0,,عشرة. تسعة. ثمانية
Dialogue: 0,0:01:35.82,0:01:39.26,Default 2,,0,0,0,,سبعة. ستة. خمسة
Dialogue: 0,0:01:39.26,0:01:42.99,Default 2,,0,0,0,,!أربعة! ثلاثة! اثنان
Dialogue: 0,0:01:42.99,0:01:43.98,Default 2,,0,0,0,,!واحد
Dialogue: 0,0:01:46.23,0:01:47.22,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:01:52.20,0:01:55.27,Default 2,,0,0,0,,هذه النافورات تنطلق كل ساعتين
Dialogue: 0,0:01:55.27,0:01:58.04,Default 2,,0,0,0,,تحبين مثل هذه الأشياء، أليس كذلك؟
Dialogue: 0,0:01:58.04,0:02:00.01,Default 2,,0,0,0,,![شينتشي]
Dialogue: 0,0:02:00.01,0:02:04.78,Default 2,,0,0,0,,!إنها هدية فوزك ببطولة المدينة للكاراتيه
Dialogue: 0,0:02:04.78,0:02:06.28,Default 2,,0,0,0,,!اقبليها بامتنان
Dialogue: 0,0:02:06.28,0:02:08.58,Default 2,,0,0,0,,!أتظن نفسك شخصًا مهمًا
Dialogue: 0,0:02:16.56,0:02:17.56,Default 2,,0,0,0,,!قوس قزح
Dialogue: 0,0:02:17.56,0:02:20.20,Default 2,,0,0,0,,!حسنًا! لنشرب نخب ذلك
Dialogue: 0,0:02:20.20,0:02:21.19,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,0:02:26.14,0:02:27.26,Default 2,,0,0,0,,...يا إلهي
Dialogue: 0,0:02:29.41,0:02:31.20,Default 2,,0,0,0,,!أنت مضحكٌ جدًا
Dialogue: 0,0:03:01.77,0:03:05.24,Another,,0,0,0,,أدعى [كودو شينتشي] وأنا متحر بالمرحلة الثانوية
Dialogue: 0,0:03:05.24,0:03:09.41,Another,,0,0,0,,عندما ذهبت مع صديقتي القديمة وزميلتي بالصف [ران موري] إلى مدينة الملاهي
Dialogue: 0,0:03:09.41,0:03:13.68,Another,,0,0,0,,التي شاهدت بها صفقة مريبة لرجال يرتدون لباسًا أسودًا
Dialogue: 0,0:03:13.68,0:03:16.19,Another,,0,0,0,,كنت مندمجًا حقًا في مشاهدة تلك الصفقة
Dialogue: 0,0:03:16.19,0:03:19.31,Another,,0,0,0,,!لدرجة أنني لم ألحظ تسلل أحدهم خلفي
Dialogue: 0,0:03:21.63,0:03:27.43,Another,,0,0,0,,...وأجبرني ذاك الرجل على احتساء عقار ما، وعندما صحوت
Dialogue: 0,0:03:27.43,0:03:30.03,Another,,0,0,0,,!وجدت جسدي متقلصًا
Dialogue: 0,0:03:30.03,0:03:33.87,Another,,0,0,0,,وإن علموا بأن [كودو شينتشي] ما يزال على قيد الحياة فلربما يسعون خلفي مجددًا
Dialogue: 0,0:03:33.87,0:03:36.37,Another,,0,0,0,,!مما يضع كافة من هم حولي في خطر محدق
Dialogue: 0,0:03:36.37,0:03:39.94,Another,,0,0,0,,وبنصيحة من البروفيسور [أغاسا]، قررت إخفاء هويتي
Dialogue: 0,0:03:39.94,0:03:44.38,Another,,0,0,0,,وعندما سألتني [ران] عن اسمي جاوبت مسرعًا بأن اسمي هو [إيدوغاوا كونان]
Dialogue: 0,0:03:44.38,0:03:46.22,Another,,0,0,0,,وللحصول على معلومات عن هؤلاء الرجال
Dialogue: 0,0:03:46.22,0:03:49.31,Another,,0,0,0,,انتهى بي المطاف بالعيش مع [ران] ووالدها المتحري
Dialogue: 0,0:03:52.39,0:03:55.63,Default 2,,0,0,0,,!المتحري الشهير [موري]\N!ما كان مفتاح حل آخر قضية؟
Dialogue: 0,0:03:55.63,0:03:59.19,Default 2,,0,0,0,,...لا، أنا لا أتذكر حقًا
Dialogue: 0,0:04:01.47,0:04:02.76,Default 2,,0,0,0,,هذا أمرٌ طبيعي
Dialogue: 0,0:04:02.76,0:04:07.47,Default 2,,0,0,0,,لأني دائمًا ما أنوم ذلك العجوز بساعة التخدير خاصتي
Dialogue: 0,0:04:07.47,0:04:13.64,Default 2,,0,0,0,,وأستخدم رابطة العنق المغيرة للصوت لأحل القضايا بصوته
Dialogue: 0,0:04:13.64,0:04:17.18,Default 2,,0,0,0,,!اخترع البروفيسور [أغاسا] هاتين الأداتين
Dialogue: 0,0:04:17.18,0:04:18.48,Default 2,,0,0,0,,!مرحبًا
Dialogue: 0,0:04:18.48,0:04:23.32,Default 2,,0,0,0,,إنه دائمًا ما يصنع أدواتٍ فريدة من نوعها كلوح التزلج المزود بمحرك تربو
Dialogue: 0,0:04:23.32,0:04:30.32,Default 2,,0,0,0,,!نظارات تتبع، وحذاءٌ مقوى للركلات
Dialogue: 0,0:04:32.76,0:04:38.24,Default 2,,0,0,0,,على الرغم من ذلك\Nلم تعلم [ران] ولا والدها بهويتي الحقيقية
Dialogue: 0,0:04:38.24,0:04:40.54,Default 2,,0,0,0,,الوحيدون الذين يعرفون هم البروفيسور [أغاسا]
Dialogue: 0,0:04:40.54,0:04:43.44,Default 2,,0,0,0,,و[هاتوري هيجي]، متحر المرحلة الثانوية بالغرب
Dialogue: 0,0:04:43.44,0:04:47.34,Default 2,,0,0,0,,وزميلتي بالفصل [هايبرا آي]
Dialogue: 0,0:04:47.34,0:04:49.95,Default 2,,0,0,0,,حيث كانت تعمل بالأساس مع أولئك الرجال ذوي الملابس السوداء
Dialogue: 0,0:04:49.95,0:04:56.38,Default 2,,0,0,0,,!ولكن لتهرب منهم، تناولت نفس العقار الذي تناولته وتقلص جسدها
Dialogue: 0,0:04:58.29,0:05:01.29,Default 2,,0,0,0,,!المنظمة السوداء تظل لغزًا
Dialogue: 0,0:05:01.29,0:05:07.42,Default 2,,0,0,0,,!والآن هناك عائقٌ كبيرٌ على ولاشك أن يحول بيني وبين [ران]
Dialogue: 0,0:05:12.80,0:05:17.27,Default 2,,0,0,0,,!حتى وإن كان جسدي صغيرًا فعقلي يظل عقل متحرٍ بارع
Dialogue: 0,0:05:17.27,0:05:19.54,Default 2,,0,0,0,,!هناك دائمًا حقيقةٌ واحدة
Dialogue: 0,0:05:35.49,0:05:36.59,Default 2,,0,0,0,,نافورات؟
Dialogue: 0,0:05:36.59,0:05:40.30,Another,,0,0,0,,!أجل! لقد كانت جميلة مع وجود قوس القزح وما إلى ذلك
Dialogue: 0,0:05:40.30,0:05:42.30,Default 2,,0,0,0,,!أجل، لقد كانت جميلة
Dialogue: 0,0:05:42.30,0:05:45.94,Thoughts,,0,0,0,,...يا إلهي، إنها تتذكر أغبى الأشياء
Dialogue: 0,0:05:45.94,0:05:48.81,Default 2,,0,0,0,,!ما رأيك لو نذهب إلى (تروبيكال لاند) مجددًا
Dialogue: 0,0:05:45.94,0:05:48.81,خط - إعلانات روابط الموقع المترجم والعامل,,0,0,0,,تروبيكال لاند: الأرض الاستوائية
Dialogue: 0,0:05:48.81,0:05:49.61,Another,,0,0,0,,!ماذا؟
Dialogue: 0,0:05:49.61,0:05:54.41,Default 2,,0,0,0,,!لم نذهب إلى هناك أبدًا سويًا منذ ذلك اليوم
Dialogue: 0,0:05:54.41,0:05:59.15,Thoughts,,0,0,0,,!بالطبع لم نفعل! لقد تقلص جسدي منذ ذلك اليوم
Dialogue: 0,0:05:59.15,0:06:01.25,Another,,0,0,0,,إذًا، متى تريد الذهاب؟
Dialogue: 0,0:06:01.25,0:06:02.92,Default 2,,0,0,0,,...لا
Dialogue: 0,0:06:02.92,0:06:05.66,Default 2,,0,0,0,,أتعتقد أن [كونان] بالمنزل؟ -\N!سؤالٌ جيد -
Dialogue: 0,0:06:05.66,0:06:09.03,Default 2,,0,0,0,,!سيجب علينا إكتشاف ذلك
Dialogue: 0,0:06:09.03,0:06:15.67,Default 2,,0,0,0,,!متأسفٌ يا [ران]! أنا منهمكٌ بقضيةٍ أخرى\N!سأتصل بك مجددًا، أراك لاحقًا
Dialogue: 0,0:06:15.67,0:06:17.87,Default 2,,0,0,0,,!تمهل\N![شينتشي]
Dialogue: 0,0:06:17.87,0:06:21.50,Default 2,,0,0,0,,!يا إلهي\N!"الأمر دائمًا يتعلق بـ"قضية، قضية، قضية
Dialogue: 0,0:06:22.54,0:06:24.84,Default 2,,0,0,0,,!مهووس القضايا الأحمق
Dialogue: 0,0:06:26.34,0:06:30.28,Default 2,,0,0,0,,!حتى [كونان] لن يكتشف حل تلك
Dialogue: 0,0:06:30.28,0:06:33.84,Default 2,,0,0,0,,!لا يسعني الانتظار لأرى نظرة الاستسلام تعلوه
Dialogue: 0,0:06:34.85,0:06:37.29,Default 2,,0,0,0,,استسلام [كونان]، أليس كذلك؟
Dialogue: 0,0:06:37.29,0:06:39.62,Default 2,,0,0,0,,!أستسلم! لقد هزمتموني
Dialogue: 0,0:06:39.66,0:06:41.49,خط - إعلانات روابط الموقع المترجم والعامل,,0,0,0,,"النصر"
Dialogue: 0,0:06:41.56,0:06:44.06,Default 2,,0,0,0,,علام تبتسمون؟
Dialogue: 0,0:06:44.06,0:06:45.13,Default 2,,0,0,0,,![كونان]
Dialogue: 0,0:06:45.13,0:06:49.47,Default 2,,0,0,0,,!توقيتٌ ممتاز! لقد كنا متوجهين إلى منزلك حالًا
Dialogue: 0,0:06:49.47,0:06:53.57,Default 2,,0,0,0,,ثلاثتنا قد توصلنا إلى لغزٍ\N!مميز جدًا
Dialogue: 0,0:06:53.57,0:06:55.37,Default 2,,0,0,0,,لغز؟
Dialogue: 0,0:06:55.37,0:06:56.41,Default 2,,0,0,0,,مستعد؟
Dialogue: 0,0:06:56.41,0:07:00.08,Default 2,,0,0,0,,عندما سُئلت عن كيف هو [كونان]
Dialogue: 0,0:07:00.08,0:07:03.31,Default 2,,0,0,0,,نظرت [هايبرا] إلى القمر وأجابت\N"إنه ليس صيفًا"
Dialogue: 0,0:07:03.31,0:07:09.52,Default 2,,0,0,0,,هل كانت [هايبرا] أولًا: تمدح [كونان]\Nأم ثانيًا: كانت تهينه؟
Dialogue: 0,0:07:09.52,0:07:11.42,Default 2,,0,0,0,,!أيهما هي الإجابة؟
Dialogue: 0,0:07:11.42,0:07:16.03,Default 2,,0,0,0,,...ليس صيفًا...القمر
Dialogue: 0,0:07:16.03,0:07:18.50,Default 2,,0,0,0,,!وجدتها\N!الاختيار الثاني
Dialogue: 0,0:07:18.50,0:07:21.03,Default 2,,0,0,0,,!ماذا؟ -\N!ولم ذلك؟ -
Dialogue: 0,0:07:21.03,0:07:24.40,Default 2,,0,0,0,,شهور أو "أقمار" الصيف هي يونيو، يوليو وأغسطس
Dialogue: 0,0:07:24.40,0:07:28.07,Default 2,,0,0,0,,مجموعةٌ على بعضها\N!"تعطي أرقامها كلمة "لا شيء جيدٌ به
Dialogue: 0,0:07:28.07,0:07:30.87,Default 2,,0,0,0,,!أنت حقًا مذهلٌ يا [كونان]
Dialogue: 0,0:07:30.87,0:07:33.44,Default 2,,0,0,0,,!يا إلهي\Nأنت لست مرحًا
Dialogue: 0,0:07:33.44,0:07:36.41,Default 2,,0,0,0,,لا يهم ذلك\Nأخبروني علام كنتم تبتسمون سابقًا
Dialogue: 0,0:07:36.41,0:07:38.55,Default 2,,0,0,0,,حسنًا، هلّا قلت لنا أستسلم؟
Dialogue: 0,0:07:38.55,0:07:39.71,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:07:41.79,0:07:45.36,Default 2,,0,0,0,,!فلنعبر -\N!مهلكم! لا عبور -
Dialogue: 0,0:07:45.36,0:07:48.53,Default 2,,0,0,0,,الضوء الأخضر الوامض هو تمامًا كالضوء الأصفر
Dialogue: 0,0:07:48.53,0:07:51.29,Default 2,,0,0,0,,انتظروا حتى الضوء الأخضر القادم
Dialogue: 0,0:07:51.29,0:07:54.43,Default 2,,0,0,0,,...حسنًا
Dialogue: 0,0:07:54.43,0:07:55.77,Default 2,,0,0,0,,...لقد وقعنا في مشكلة
Dialogue: 0,0:07:55.77,0:07:59.60,Default 2,,0,0,0,,أجل، ولكنه محق
Dialogue: 0,0:08:04.31,0:08:06.71,Default 2,,0,0,0,,!والآن أنا لدي سؤال لكم
Dialogue: 0,0:08:06.71,0:08:09.55,Default 2,,0,0,0,,ما عمل هذا الشخص برأيكم؟
Dialogue: 0,0:08:09.55,0:08:10.74,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:08:12.38,0:08:14.92,Default 2,,0,0,0,,معلمٌ بمدرسة؟
Dialogue: 0,0:08:14.92,0:08:18.05,Default 2,,0,0,0,,رجل أعمال؟\N...لا إنه لا يحمل حقيبة يد
Dialogue: 0,0:08:18.05,0:08:19.82,Default 2,,0,0,0,,مالك مطعم إنقليس؟
Dialogue: 0,0:08:19.82,0:08:21.16,Default 2,,0,0,0,,"الإجابة هي "محقق شرطة
Dialogue: 0,0:08:21.16,0:08:23.39,Default 2,,0,0,0,,محقق شرطة؟
Dialogue: 0,0:08:23.39,0:08:25.56,Default 2,,0,0,0,,عندما يريد محققي الشرطة تدوين ملحوظةٍ عن شيءٍ ما
Dialogue: 0,0:08:25.56,0:08:29.23,Default 2,,0,0,0,,فإنهم يديرون دفتر ملاحظاتهم ويكتبون أفقيًا
Dialogue: 0,0:08:30.67,0:08:33.17,Default 2 - Copy,,0,0,0,,حقًا؟ -\N!أنت ذكيٌ جدًا يا [كونان] -
Dialogue: 0,0:08:33.17,0:08:35.60,Default 2 - Copy,,0,0,0,,!أنت تعرف كل شيء
Dialogue: 0,0:08:39.34,0:08:41.75,Default 2,,0,0,0,,!إنها خضراء! فلنعبر
Dialogue: 0,0:08:41.75,0:08:42.68,Default 2,,0,0,0,,!أجل
Dialogue: 0,0:09:12.18,0:09:14.64,Default 2,,0,0,0,,!لقد أُطلق النار على ذاك الرجل\N!ذلك هو الفاعل
Dialogue: 0,0:09:14.64,0:09:15.65,Default 2,,0,0,0,,!لا، أنت لن تهرب
Dialogue: 0,0:09:15.65,0:09:17.01,Default 2,,0,0,0,,!احترس يا [كونان]
Dialogue: 0,0:09:19.48,0:09:22.01,Default 2,,0,0,0,,!اتصلوا بسيارة إسعاف -\N!مفهوم -
Dialogue: 0,0:09:38.24,0:09:40.97,Thoughts,,0,0,0,,!اللعنة! لقد هرب
Dialogue: 0,0:09:46.54,0:09:50.17,Default 2,,0,0,0,,!تماسك أيها السيد\N!من أطلق النار عليك؟
Dialogue: 0,0:09:56.69,0:09:57.65,Thoughts,,0,0,0,,!ماذا؟
Dialogue: 0,0:10:21.21,0:10:24.41,Another,,0,0,0,,"قرابة الساعة الثانية اليوم بتقاطع حديقة "بيكا
Dialogue: 0,0:10:24.41,0:10:28.52,Another,,0,0,0,,لاقى المحقق المساعد [ناراساوا أوسامو] حتفه إثر إصابته بعيار ناري
Dialogue: 0,0:10:28.52,0:10:30.85,Another,,0,0,0,,وعلى ما يبدو أن القاتل قد هرب
Dialogue: 0,0:10:30.85,0:10:32.69,Another,,0,0,0,,أرسل الدعم من مركز الشرطة
Dialogue: 0,0:10:32.69,0:10:36.69,Another,,0,0,0,,وأعدت شرطة "بيكا" وحدة تنفيذ مهام
Dialogue: 0,0:10:36.69,0:10:42.90,Default 2,,0,0,0,,آسف لتكرار السؤال، ولكن هل لكم أن تخبرونا عن القاتل؟
Dialogue: 0,0:10:42.90,0:10:44.60,Default 2,,0,0,0,,!لقد كان شابًا
Dialogue: 0,0:10:44.60,0:10:47.30,Default 2,,0,0,0,,!لا، لقد كانت امرأةً جميلة
Dialogue: 0,0:10:47.30,0:10:49.87,Default 2,,0,0,0,,!لا! لقد كان رجلًا في منتصف عمره
Dialogue: 0,0:10:49.87,0:10:52.88,Default 2,,0,0,0,,ماذا عن مظلة هذا الشخص؟
Dialogue: 0,0:10:52.88,0:10:54.28,Default 2,,0,0,0,,!لقد كانت مظلةً سوداء
Dialogue: 0,0:10:54.28,0:10:56.71,Default 2,,0,0,0,,!لقد كانت خضراء! خضراء
Dialogue: 0,0:10:56.71,0:10:58.62,Default 2,,0,0,0,,...أظنها كانت زرقاء
Dialogue: 0,0:10:58.62,0:11:02.62,Default 2,,0,0,0,,مهلكم الآن\Nهل رأيتم أي شيءٍ حقًا؟
Dialogue: 0,0:11:02.62,0:11:04.32,Default 2,,0,0,0,,ماذا عنك يا [كونان]؟
Dialogue: 0,0:11:04.32,0:11:07.89,Default 2,,0,0,0,,المعطف والمظلة كانا رماديًا فاتحًا
Dialogue: 0,0:11:07.89,0:11:10.46,Default 2,,0,0,0,,ولكني لا أعرف إذا ما كانت امرأةً أو رجل
Dialogue: 0,0:11:10.46,0:11:13.00,Default 2,,0,0,0,,!ولكن المظلة كانت في يده اليمنى
Dialogue: 0,0:11:13.00,0:11:16.57,Default 2,,0,0,0,,مما يعني أنه أطلق النار بيده اليسرى
Dialogue: 0,0:11:16.57,0:11:18.80,Default 2,,0,0,0,,...إذًا فالقاتل أعسر
Dialogue: 0,0:11:18.80,0:11:20.74,Default 2,,0,0,0,,أيها المفتش
Dialogue: 0,0:11:20.74,0:11:25.84,Default 2,,0,0,0,,لم مات المحقق المساعد [ناراساوا]\Nممسكًا بالجهة اليسرى من صدره؟
Dialogue: 0,0:11:25.84,0:11:31.25,Default 2,,0,0,0,,نعتقد أنه كان يشير إلى دفتر ملاحظاته الشرطية الذي كان بجيبه
Dialogue: 0,0:11:32.25,0:11:37.58,Default 2,,0,0,0,,نحن حاليًا نبحث في كل ما قد كُتب بدفتر الملاحظات ذلك
Dialogue: 0,0:11:39.09,0:11:40.36,Default 2,,0,0,0,,مفتش [ميغوري]
Dialogue: 0,0:11:40.36,0:11:46.53,Default 2,,0,0,0,,الأعيرة التي وُجدت بمسرح الجريمة\Nأُطلقت من مسدس عيار 9 مليمترات أوتوماتيكي
Dialogue: 0,0:11:46.53,0:11:48.67,Default 2,,0,0,0,,عيار 9 مليمترات؟
Dialogue: 0,0:11:48.67,0:11:52.47,Default 2,,0,0,0,,هذا سلاحٌ شائع\N...وحتى المرأة تستطيع الإطلاق به
Dialogue: 0,0:11:52.47,0:11:55.51,Default 2,,0,0,0,,!ولكن من الجيد أنه لم يعلق أحدكم في وسط هذا كله
Dialogue: 0,0:11:55.51,0:11:56.77,Default 2,,0,0,0,,!أنت أيضًا يا [كونان]
Dialogue: 0,0:11:56.77,0:11:58.78,Default 2,,0,0,0,,!أجل
Dialogue: 0,0:11:58.78,0:12:00.38,Thoughts,,0,0,0,,!اللعنة
Dialogue: 0,0:12:00.38,0:12:04.78,Thoughts,,0,0,0,,!لو لم تتحول الإشارة إلى اللون الأحمر لما استطاع الإفلات
Dialogue: 0,0:12:39.75,0:12:41.95,Another,,0,0,0,,"!محققٌ آخر وُجد مقتولًا"
Dialogue: 0,0:12:41.95,0:12:43.25,Another,,0,0,0,,"فعل متطرفين؟"\N"عصاباتٌ تشن ثأرًا؟"
Dialogue: 0,0:12:43.25,0:12:44.52,Another,,0,0,0,,"اللغز يزداد تعقيدًا"\N"ضغينة شخصية؟"
Dialogue: 0,0:12:44.52,0:12:45.68,Another,,0,0,0,,"!تحدٍ للشرطة"
Dialogue: 0,0:12:53.03,0:12:54.56,Default 2,,0,0,0,,معك [ميغوري]
Dialogue: 0,0:12:54.56,0:12:56.07,Default 2,,0,0,0,, [موري]؟
Dialogue: 0,0:12:56.07,0:13:01.17,Default 2,,0,0,0,,...أيها المفتش، أود أن أعلم أكثر عن حادثة الأمس
Dialogue: 0,0:13:01.17,0:13:04.87,Default 2,,0,0,0,,متأسف، فأنا مشغول ربما بوقتٍ لاحق
Dialogue: 0,0:13:06.71,0:13:08.34,Default 2,,0,0,0,,!مرحبًا؟\N!أيها المفتش؟
Dialogue: 0,0:13:08.34,0:13:09.58,Default 2,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:13:09.58,0:13:11.85,Default 2,,0,0,0,,يقول أنه مشغول
Dialogue: 0,0:13:11.85,0:13:16.12,Default 2,,0,0,0,,بالطبع هو مشغول\Nفقد فقدوا اثنين من محققيهم
Dialogue: 0,0:13:16.12,0:13:22.52,Default 2,,0,0,0,,ومع ذلك قد بدا مختلفًا\N...عن طبيعة شخصيته
Dialogue: 0,0:13:24.63,0:13:26.43,Default 2,,0,0,0,,حسنًا يا [شيراتوري]
Dialogue: 0,0:13:26.43,0:13:29.60,Default 2,,0,0,0,,وحدنا أنا وأنت من سيعلم بشأن تلك الحادثة
Dialogue: 0,0:13:29.60,0:13:31.53,Default 2,,0,0,0,,لا تخبر أحدًا
Dialogue: 0,0:13:33.27,0:13:34.54,Default 2,,0,0,0,,مفهوم
Dialogue: 0,0:13:34.54,0:13:39.91,Another - Copy,,0,0,0,,بعد تطابق البصمات الباليستية للرصاصات المستخدمة في القتل
Dialogue: 0,0:13:39.91,0:13:44.87,Another - Copy,,0,0,0,,تظن السلطات الآن أن تلك الحوادث هي بفعل نفس الشخص
Dialogue: 0,0:13:45.82,0:13:51.05,Another - Copy,,0,0,0,,والآن ننتقل إلى أحوال الطقس\N...نظام ضغطٍ مرتفعٍ سوف
Dialogue: 0,0:13:57.06,0:14:02.17,Default 2,,0,0,0,,تُجيد شقيقة المحقق [شيراتوري] اختيار التوقيت السيئ للظهور
Dialogue: 0,0:14:02.17,0:14:02.73,Default 2,,0,0,0,,تُجيد شقيقة المحقق [شيراتوري] اختيار التوقيت السيئ للظهور
Dialogue: 0,0:14:02.73,0:14:06.67,Default 2,,0,0,0,,\N...لتعقد الاستقبال الخاص بالعرس
Dialogue: 0,0:14:06.67,0:14:07.00,Default 2,,0,0,0,,\N...لتعقد الاستقبال الخاص بالعرس
Dialogue: 0,0:14:07.00,0:14:10.74,Default 2,,0,0,0,,لا يعسها فعل شيء\Nفقد كان الأمر مخططًا سلفًا منذ شهر
Dialogue: 0,0:14:10.74,0:14:13.31,Default 2,,0,0,0,,وليس خطأها أن تلك الحوادث وقعت
Dialogue: 0,0:14:13.31,0:14:18.35,Default 2,,0,0,0,,!بجانب ذلك فإنه ليس استقبالًا للعرس إنه حفل زفاف
Dialogue: 0,0:14:18.35,0:14:21.25,Default 2,,0,0,0,,!أصدقاء العريس والعروس هم المسؤولون عن الأمر
Dialogue: 0,0:14:21.25,0:14:22.91,Default 2,,0,0,0,,!أجل، أعلم
Dialogue: 0,0:14:26.02,0:14:29.19,Default 2,,0,0,0,,كيف يبدو العريس، السيد [هاريتسوكي]؟
Dialogue: 0,0:14:29.19,0:14:31.53,Default 2,,0,0,0,,!على ما يبدو فهو رسام
Dialogue: 0,0:14:31.53,0:14:33.93,Default 2,,0,0,0,,أضيفي "مكافح" إلى هذا
Dialogue: 0,0:14:33.93,0:14:36.37,Default 2,,0,0,0,,رسامٌ مكافح، أليس كذلك؟
Dialogue: 0,0:14:36.37,0:14:39.93,Default 2,,0,0,0,,أعتقد أني لا أستطيع توقع كيف يبدو أصدقائه الرجال
Dialogue: 0,0:14:41.24,0:14:44.17,Default 2,,0,0,0,,[موري كوغورو]
Dialogue: 0,0:14:44.47,0:14:48.11,Default 2,,0,0,0,,...أرى أن خطك ما زال سيئًا كالعادة
Dialogue: 0,0:14:48.11,0:14:49.38,Default 2,,0,0,0,,!أمي
Dialogue: 0,0:14:49.38,0:14:51.38,Default 2,,0,0,0,,لقد تم دعوتك أنتِ أيضًا؟
Dialogue: 0,0:14:51.38,0:14:55.95,Default 2,,0,0,0,,أجل، آنسة [سارا] هي محامية واعدةٌ أعمل معها
Dialogue: 0,0:14:56.39,0:14:58.55,Default 2,,0,0,0,,[كيساكي إيري]
Dialogue: 0,0:14:59.52,0:15:01.96,Default 2,,0,0,0,,!رائع! خطك جميلٌ حقًا
Dialogue: 0,0:15:01.96,0:15:06.53,Thoughts,,0,0,0,,يا إلهي، لا توقعا بمكانين مختلفين طالما أنكما زوجان
Dialogue: 0,0:15:06.53,0:15:08.03,Default 2,,0,0,0,,!رجاءً احفظي هذه من أجلي
Dialogue: 0,0:15:08.03,0:15:10.69,Default 2,,0,0,0,,!رقمك هو 87
Dialogue: 0,0:15:13.57,0:15:15.41,Default 2,,0,0,0,,!تعال يا [كونان]
Dialogue: 0,0:15:15.41,0:15:16.57,Default 2,,0,0,0,,!أجل
Dialogue: 0,0:15:23.08,0:15:26.15,Default 2,,0,0,0,,!رائع! انظري لكل هؤلاء الناس
Dialogue: 0,0:15:26.15,0:15:29.05,Default 2,,0,0,0,,!المفتش هنا
Dialogue: 0,0:15:30.72,0:15:33.99,Default 2,,0,0,0,,من السهل ملاحظة عناصر الشرطة
Dialogue: 0,0:15:33.99,0:15:37.89,Default 2,,0,0,0,,لديهم نظرة الوعيد تلك على وجوههم\Nوالاكتئاب أيضًا
Dialogue: 0,0:15:37.89,0:15:43.03,Default 2,,0,0,0,,لا تستطيعين لومهم\Nفذلك ليس وقت احتفالٍ بعد كل ما حدث
Dialogue: 0,0:15:43.03,0:15:46.50,Default 2,,0,0,0,,!المحققة [ساتو] مبتهج دائمًا على الرغم من ذلك
Dialogue: 0,0:15:46.50,0:15:48.84,Default 2,,0,0,0,,إذًا؟ الريش الجميل يجعل الطائر جميلًا ألا توافقني الرأي؟
Dialogue: 0,0:15:48.84,0:15:52.61,Default 2,,0,0,0,,بالتأكيد! إنه يناسبكِ تمامًا
Dialogue: 0,0:15:52.61,0:15:57.05,Default 2,,0,0,0,,!إنه السيد [أوداغيري]\Nسأذهب لألقي التحية
Dialogue: 0,0:15:58.75,0:16:01.62,Default 2,,0,0,0,,من؟ -\Nرئيس شرطة العاصمة [أوداغيري] -
Dialogue: 0,0:16:01.62,0:16:05.46,Default 2,,0,0,0,,لقد كان رئيس المحققين عندما\Nكان ذلك المتحري الخاص الأحمق يعمل هناك
Dialogue: 0,0:16:05.46,0:16:08.52,Default 2,,0,0,0,,أعتقد أنه رئيس الشرطة الأن
Dialogue: 0,0:16:10.39,0:16:14.93,Default 2,,0,0,0,,!شكرًا لكم جميعًا على صبركم\N!ها هم العريس والعروس
Dialogue: 0,0:16:14.93,0:16:17.70,Default 2,,0,0,0,,!رجاءً فلتحيوهم بتصفيقٍ هائل
Dialogue: 0,0:16:22.04,0:16:24.03,Default 2,,0,0,0,,!يا للروعة
Dialogue: 0,0:16:35.22,0:16:38.09,Default 2,,0,0,0,,![كوتارو]! آنسة [سارا]\N!تهانينا
Dialogue: 0,0:16:42.23,0:16:44.23,Default 2,,0,0,0,,سيد [موري]
Dialogue: 0,0:16:44.23,0:16:46.46,Default 2,,0,0,0,,!مرحبًا! أقدم التهاني
Dialogue: 0,0:16:46.46,0:16:48.40,Default 2,,0,0,0,,شكرًا جزيلًا
Dialogue: 0,0:16:48.40,0:16:50.90,Default 2,,0,0,0,,حسنًا، دعني أعرفك
Dialogue: 0,0:16:50.90,0:16:52.90,Default 2 - Copy,,0,0,0,,هذا طبيبي، الدكتور [كازاتو]
Dialogue: 0,0:16:52.90,0:16:56.67,Default 2 - Copy,,0,0,0,,إنه طبيبٌ نفسي بمستشفى\N"بيكا ياكوشينو"
Dialogue: 0,0:16:56.67,0:16:58.98,Default 2,,0,0,0,,أدعى [كازاتو]، تشرفت بمعرفتك
Dialogue: 0,0:16:58.98,0:17:00.41,Default 2,,0,0,0,,أنا [موري]
Dialogue: 0,0:17:00.41,0:17:05.28,Default 2,,0,0,0,,هذه زوجتي [إيري]، و ابنتي [ران]\Nوهذا هو الطفيلي [كونان]
Dialogue: 0,0:17:05.28,0:17:07.42,Thoughts,,0,0,0,,توقف عن مناداتي بالطفيلي
Dialogue: 0,0:17:07.42,0:17:10.82,Default 2,,0,0,0,,ولكن يا سيد [شيراتوري]...طبيبٌ نفسي؟
Dialogue: 0,0:17:10.82,0:17:15.83,Default 2,,0,0,0,,أجل، فالمخاوف والقلق جزء من وظائف الإدارة
Dialogue: 0,0:17:15.83,0:17:17.29,Default 2,,0,0,0,,...ولهذا السبب
Dialogue: 0,0:17:19.63,0:17:23.93,Default 2,,0,0,0,,حري بك أن تدعه يلقي\Nنظرةً عليك يا سيد [موري]
Dialogue: 0,0:17:23.93,0:17:28.30,Default 2,,0,0,0,,...أجل...مؤخرًا بدت ذاكرتي
Dialogue: 0,0:17:28.30,0:17:30.77,Default 2,,0,0,0,,!يا هذا\N!ما الذي يفترض أن يعنيه هذا؟
Dialogue: 0,0:17:34.18,0:17:36.31,Default 2,,0,0,0,,!كفاك ضحكًا
Dialogue: 0,0:17:36.31,0:17:38.28,Default 2,,0,0,0,,!هذا مؤلم
Dialogue: 0,0:17:38.28,0:17:39.55,Default 2,,0,0,0,,!اعذرني
Dialogue: 0,0:17:39.55,0:17:41.32,Default 2,,0,0,0,,!أيها المفتش
Dialogue: 0,0:17:41.32,0:17:43.49,Default 2,,0,0,0,,أهلًا يا [موري]
Dialogue: 0,0:17:43.49,0:17:45.52,Default 2,,0,0,0,,أوجدت أي شيءٍ منذ الحين؟
Dialogue: 0,0:17:45.52,0:17:48.15,Default 2,,0,0,0,,متأسف، ولكن ليس باستطاعتي\Nالتكلم بهذا الأمر
Dialogue: 0,0:17:49.73,0:17:53.03,Default 2,,0,0,0,,لم لن يتحدث معي؟
Dialogue: 0,0:17:53.03,0:17:56.23,Default 2,,0,0,0,,لابد من وجود شيءٍ لا يستطيع إخبارك به
Dialogue: 0,0:17:56.23,0:17:58.87,Default 2,,0,0,0,,!أهذا صحيحٌ يا [تاكاغي]؟
Dialogue: 0,0:17:58.87,0:18:00.50,Default 2,,0,0,0,,!لا، ليس بالضبط
Dialogue: 0,0:18:00.50,0:18:05.20,Default 2,,0,0,0,,أخبرني يا سيد [تاكاغي]\Nأنت معجبٌ بالمحققة [ساتو]، أليس كذلك؟
Dialogue: 0,0:18:06.68,0:18:11.81,Default 2,,0,0,0,,!يا له من أمرٍ مشوق\N!سأذهب لأخبرها بطبيعة مشاعرك
Dialogue: 0,0:18:11.81,0:18:14.18,Default 2,,0,0,0,,!توقف\N!مهلًا
Dialogue: 0,0:18:14.18,0:18:15.55,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,0:18:16.69,0:18:19.16,Default 2,,0,0,0,,نحن نخفي الأمر عن الصحافة
Dialogue: 0,0:18:19.16,0:18:23.23,Default 2,,0,0,0,,...ولكن المحقق [شيبا] مات حاملًا لدفتر ملاحظاته الشرطية
Dialogue: 0,0:18:23.23,0:18:24.99,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:18:24.99,0:18:26.40,Default 2,,0,0,0,,...مما يعني
Dialogue: 0,0:18:26.40,0:18:31.00,Default 2,,0,0,0,,لا داع للتطفل أكثر من ذلك يا سيد [موري]
Dialogue: 0,0:18:31.00,0:18:35.56,Default 2 - Copy,,0,0,0,,"لا تحتاج للمعرفة"\Nيجب أن يكون هذا واضحًا بما فيه الكفاية
Dialogue: 0,0:18:40.38,0:18:45.58,Default 2 - Copy,,0,0,0,,"...لا تحتاج للمعرفة"\N!يبدو بأنهم ليسوا بحاجتي في هذه القضية
Dialogue: 0,0:18:45.58,0:18:47.21,Default 2 - Copy,,0,0,0,,!لا يمكن ذلك
Dialogue: 0,0:18:48.58,0:18:51.55,Thoughts,,0,0,0,,"لا تحتاج للمعرفة"
Dialogue: 0,0:18:51.55,0:18:55.19,Thoughts,,0,0,0,,جملةٌ مميزةٌ تستخدم بين\N...محققي الشرطة
Dialogue: 0,0:18:55.19,0:19:00.53,Thoughts,,0,0,0,,أيعني هذا أن القاتل هو شخصٌ\N!من داخل قسم الشرطة؟
Dialogue: 0,0:19:02.10,0:19:06.24,Thoughts,,0,0,0,,...وليس فقط أي شخص\N...وإنما هو شخصٌ ذو رتبةٍ عالية
Dialogue: 0,0:19:06.24,0:19:11.20,Thoughts,,0,0,0,,!أو من الممكن أن تكون المنظمة الشرطية نفسها بالكامل
Dialogue: 0,0:19:13.88,0:19:17.25,Default 2,,0,0,0,,إذًا فهو لم يقل شيئًا مميزًا ليعرض الزواج؟
Dialogue: 0,0:19:17.25,0:19:20.32,Default 2,,0,0,0,,لا، إنه ليس بهذه البراعة في مثل هذه الأشياء
Dialogue: 0,0:19:20.32,0:19:23.65,Default 2,,0,0,0,,من الأفضل أن يكون الرجال هكذا
Dialogue: 0,0:19:23.65,0:19:28.42,Default 2,,0,0,0,,أي شخصٍ يبالغ في الإطراء\Nليس جيدًا
Dialogue: 0,0:19:31.16,0:19:38.17,Default 2,,0,0,0,,أخبريني! لقد كنت أنوي سؤالك\Nكيف تقدم أبي للزواج منك؟
Dialogue: 0,0:19:38.17,0:19:41.34,Default 2,,0,0,0,,لقد كانت مجموعة من الإطرائات\Nالمبالغ فيها كما قلت
Dialogue: 0,0:19:41.34,0:19:44.24,Default 2,,0,0,0,,!معلمتي! رجاءً أخبرينا
Dialogue: 0,0:19:44.24,0:19:46.61,Default 2,,0,0,0,,ولكني نسيت
Dialogue: 0,0:19:46.61,0:19:49.68,Default 2,,0,0,0,,!أنت دائمًا ما تتظاهرين بعدم المعرفة
Dialogue: 0,0:19:49.68,0:19:55.35,Default 2,,0,0,0,,!رجاءً أخبرينا، كي نرجع إلى ذلك في المستقبل -\N!بحقك! توقفي عن مضايقتنا يا أمي
Dialogue: 0,0:19:55.35,0:19:57.35,Default 2,,0,0,0,,...دعوني أفكر
Dialogue: 0,0:19:57.35,0:20:02.46,Default 2,,0,0,0,,"أحبك. أكثر من أي شخصٍ على تلك الأرض"
Dialogue: 0,0:20:02.46,0:20:03.86,Default 2,,0,0,0,,!أو شيءٍ من هذا القبيل
Dialogue: 0,0:20:07.53,0:20:10.27,Thoughts,,0,0,0,,...مستحيل
Dialogue: 0,0:20:10.27,0:20:12.50,Default 2,,0,0,0,,!هذا لطيفٌ جدًا
Dialogue: 0,0:20:16.37,0:20:20.28,Default 2,,0,0,0,,"...إذا كان مقدرًا لـ[شينتشي] أن يقول لي ذلك"
Dialogue: 0,0:20:20.28,0:20:22.38,Default 2,,0,0,0,,!أبعدي تلك النظرة عن وجهك
Dialogue: 0,0:20:22.38,0:20:26.48,Default 2,,0,0,0,,!ليس لدي أي نظرة يا [سونوكو]
Dialogue: 0,0:20:26.48,0:20:29.19,Default 2,,0,0,0,,ما بك يا [ران]؟
Dialogue: 0,0:20:29.19,0:20:31.15,Default 2,,0,0,0,,!وجهك أحمر
Dialogue: 0,0:20:31.15,0:20:33.39,Default 2,,0,0,0,,!لا، لا شيء
Dialogue: 0,0:20:33.39,0:20:35.89,Default 2,,0,0,0,,![توشيا]\N!ماذا تفعل هنا؟
Dialogue: 0,0:20:35.89,0:20:42.50,Default 2 - Copy,,0,0,0,,!هذا ليس مكانًا لأمثالك\N!لم تتم دعوتك إلى هذا الحفل
Dialogue: 0,0:20:42.50,0:20:46.47,Default 2 - Copy,,0,0,0,,اصمت! لقد صادف وجودي هنا\N!في هذا الفندق من أجل العمل
Dialogue: 0,0:20:46.47,0:20:52.68,Default 2,,0,0,0,,!هذا ابنه [توشيا]\N...سمعت أنه انضم لفرقة روك
Dialogue: 0,0:20:52.68,0:20:56.35,Default 2,,0,0,0,,!مهلًا، مهلًا! كل شيءٍ على ما يرام يا سيدي الرئيس
Dialogue: 0,0:20:56.35,0:20:59.35,Default 2,,0,0,0,,سيد [توشيا]، استمتع بوقتك -\N!اخرج -
Dialogue: 0,0:20:59.35,0:21:01.92,Default 2,,0,0,0,,!توقف عن الطواف كأنك كلب ضال يبحث عن الطعام
Dialogue: 0,0:21:01.92,0:21:04.35,Default 2,,0,0,0,,!ماذا قُلت؟ -\N!سيد [توشيا] -
Dialogue: 0,0:21:09.43,0:21:11.33,Default 2,,0,0,0,,!المعذرة على الإزعاج
Dialogue: 0,0:21:11.33,0:21:13.16,Default 2,,0,0,0,,!سيد [توشيا]
Dialogue: 0,0:21:18.87,0:21:23.33,Default 2,,0,0,0,,ماذا؟ أين رأيتها من قبل؟
Dialogue: 0,0:21:34.35,0:21:35.54,Default 2,,0,0,0,,[ساتو]
Dialogue: 0,0:21:38.05,0:21:39.29,Default 2,,0,0,0,,...بخصوص ذلك الأمر
Dialogue: 0,0:21:39.29,0:21:41.96,Default 2,,0,0,0,,!كلا، لا بأس -\N...ولكن -
Dialogue: 0,0:21:41.96,0:21:45.02,Default 2,,0,0,0,,!لا داع للقلق -\N!على مهلك -
Dialogue: 0,0:21:52.90,0:21:55.46,Default 2,,0,0,0,,رقم 38 من فضلك -\N!بالطبع -
Dialogue: 0,0:22:17.39,0:22:20.23,Default 2,,0,0,0,,!مرحبًا! [ران] -\N!محققة [ساتو] -
Dialogue: 0,0:22:20.23,0:22:23.83,Default 2,,0,0,0,,يا لها من حفلة غريبة، أليس كذلك؟\N...بوجود عناصر الشرطة أولئك
Dialogue: 0,0:22:23.83,0:22:27.74,Default 2,,0,0,0,,ليس بالضبط، ولكن خذي حذرك، حسنًا؟
Dialogue: 0,0:22:27.74,0:22:28.94,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:22:28.94,0:22:32.41,Default 2,,0,0,0,,محققو الشرطة يتم إطلاق النار عليهم\N...واحدًا تلو الآخر
Dialogue: 0,0:22:32.41,0:22:35.47,Default 2,,0,0,0,,!سأكون بخير! أنا قوية
Dialogue: 0,0:22:44.75,0:22:46.02,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:22:46.02,0:22:47.82,Default 2,,0,0,0,,انقطاع في التيار؟
Dialogue: 0,0:22:47.82,0:22:51.03,Default 2,,0,0,0,,ما الذي حدث من وجهة نظرك؟ -\Nهذا غريب -
Dialogue: 0,0:22:51.03,0:22:53.43,Default 2,,0,0,0,,سأذهب للنظر في الأرجاء\Nابقي هنا
Dialogue: 0,0:22:59.04,0:23:02.47,Default 2,,0,0,0,,!محققة [ساتو]\N!هناك مصباحٌ يدوي هنا
Dialogue: 0,0:23:03.47,0:23:04.87,Default 2,,0,0,0,,انظري؟
Dialogue: 0,0:23:09.48,0:23:11.11,Default 2,,0,0,0,,![إنتبهي يا آنسة [ران
Dialogue: 0,0:23:13.12,0:23:14.61,Default 2,,0,0,0,,!محققة [ساتو]
Dialogue: 0,0:23:36.31,0:23:38.01,Default 2,,0,0,0,,...محققة [ساتو]
Dialogue: 0,0:23:38.01,0:23:40.57,Default 2,,0,0,0,,!محققة [ساتو]! قولي شيئًا
Dialogue: 0,0:23:48.25,0:23:53.24,Default 2,,0,0,0,,إنه...إنه بسبب استخدامي\N...لذلك المصباح اليدوي
Dialogue: 0,0:24:02.60,0:24:05.37,Default 2,,0,0,0,,![ران] -\N!آنسة [ساتو] -
Dialogue: 0,0:24:05.37,0:24:07.54,Default 2,,0,0,0,,![ران]! أأنت بخير؟
Dialogue: 0,0:24:07.54,0:24:11.23,Default 2,,0,0,0,,[ران] فاقدةٌ للوعي فقط\N...المصابة هي
Dialogue: 0,0:24:12.24,0:24:15.70,Default 2,,0,0,0,,!آنسة [ساتو]! آنسة [ساتو]\N!أرجوكِ قولي شيئًا
Dialogue: 0,0:24:16.71,0:24:17.85,Default 2,,0,0,0,,!ماذا بحق الـجحيم
Dialogue: 0,0:24:17.85,0:24:22.89,Default 2,,0,0,0,,!اتصل بالإسعاف يا [ميغوري]\N![شيراتوري]! أغلق جميع المخارج
Dialogue: 0,0:24:22.89,0:24:23.89,Default 2,,0,0,0,,!علم
Dialogue: 0,0:24:23.89,0:24:27.26,Default 2,,0,0,0,,مرحبًا؟! أنا بالطابق الخامس عشر\N!"بفندق "بيكا صان بلازا
Dialogue: 0,0:24:27.26,0:24:30.63,Default 2,,0,0,0,,!تم اطلاق النار على امرأة\N!أرسلوا الإسعاف في الحال رجاءً
Dialogue: 0,0:24:30.63,0:24:32.63,Thoughts,,0,0,0,,...لقد نفذ منه الرصاص
Dialogue: 0,0:24:32.63,0:24:37.70,Thoughts,,0,0,0,,!إنه سلاحٌ من عيار 9 مليمترات أوتوماتيكي\N!إنه نفس الشخص
Dialogue: 0,0:24:37.70,0:24:40.93,Thoughts,,0,0,0,,ولكن...لم هناك مصباحٌ يدوي؟
Dialogue: 0,0:24:42.94,0:24:44.21,Default 2,,0,0,0,,!أسرعوا
Dialogue: 0,0:24:44.21,0:24:45.94,Default 2,,0,0,0,,!أغلقوا كل المخارج
Dialogue: 0,0:25:03.59,0:25:06.43,Default 2,,0,0,0,,اختبروا كل الأشخاص فيما عدا\N!الأطفال بحثًا عن آثار بارود
Dialogue: 0,0:25:06.43,0:25:09.93,Default 2,,0,0,0,,!لا استثنائات\N!وذلك يشملني وكل شرطيٍ هنا
Dialogue: 0,0:25:09.93,0:25:12.92,Default 2,,0,0,0,,!وهذا الأحمق أيضًا، بالطبع
Dialogue: 0,0:25:17.57,0:25:20.51,Thoughts,,0,0,0,,هذا الشخص مازال هنا؟
Dialogue: 0,0:25:20.51,0:25:24.61,Thoughts,,0,0,0,,...ولكني لا أرى هذين الاثنين
Dialogue: 0,0:25:37.96,0:25:41.76,Default 2,,0,0,0,,أيها المفتش [ميغوري]\Nكيف هو حال الآنسة [ساتو]؟
Dialogue: 0,0:25:41.76,0:25:44.70,Default 2,,0,0,0,,استقرت إحدى الرصاصات مباشرة بجانب قلبها
Dialogue: 0,0:25:44.70,0:25:48.80,Default 2,,0,0,0,,يقولون أن لديها فرصةٌ بنسبة\N...خمسين بالمئة أن تنجو من ذلك
Dialogue: 0,0:25:48.80,0:25:51.64,Default 2,,0,0,0,,أيها المفتش، ماذا عن [ران]؟
Dialogue: 0,0:25:51.64,0:25:56.21,Default 2,,0,0,0,,لحسن الحظ لم تصب بأي إصاباتٍ\Nخارجية، ولكنها ما زالت فاقدةً للوعي
Dialogue: 0,0:25:56.21,0:25:58.65,Default 2,,0,0,0,,إنها بالغرفة في نهاية الرواق
Dialogue: 0,0:26:02.02,0:26:04.62,Thoughts,,0,0,0,,[ران] بخير على الأرجح
Dialogue: 0,0:26:04.62,0:26:08.45,Thoughts,,0,0,0,,...ولكن لدي فضولٌ تجاه ذلك المصباح اليدوي
Dialogue: 0,0:26:10.36,0:26:11.53,Thoughts,,0,0,0,,...أيمكن أن يكون
Dialogue: 0,0:26:11.53,0:26:13.73,Default 2,,0,0,0,,[شيراتوري]\Nكيف تجري التحقيقات؟
Dialogue: 0,0:26:13.73,0:26:17.67,Default 2,,0,0,0,,تفقدنا الجميع من أجل آثار بارود ولكننا لم نجد شيئًا
Dialogue: 0,0:26:17.67,0:26:19.64,Default 2,,0,0,0,,!لا شيء؟
Dialogue: 0,0:26:19.64,0:26:24.84,Default 2,,0,0,0,,نعتقد أن المطلق قد فر من المبنى قبل إغلاق المخارج
Dialogue: 0,0:26:24.84,0:26:28.58,Default 2,,0,0,0,,أي بصمات أصابع على السلاح؟ -\Nلا شيء هناك أيضًا -
Dialogue: 0,0:26:28.58,0:26:32.58,Default 2,,0,0,0,,[شيبا]\Nهل عرفتم كيف أُعدت لوحة مفاتيح الكهرباء لتنفجر؟
Dialogue: 0,0:26:32.58,0:26:38.15,Default 2 - Copy,,0,0,0,,أجل، يبدو أنها قد أُعدت لتنفجر عن طريق مكالمة هاتفٍ خلوي
Dialogue: 0,0:26:38.15,0:26:41.26,Default 2,,0,0,0,,هناك شيءٌ يثير فضولي
Dialogue: 0,0:26:41.26,0:26:46.70,Default 2,,0,0,0,,...المصباح اليدوي على أرضية الحمام\Nهل كان للآنسة [ساتو]؟
Dialogue: 0,0:26:46.70,0:26:49.20,Default 2,,0,0,0,,!لا أظن ذلك
Dialogue: 0,0:26:49.20,0:26:52.57,Default 2,,0,0,0,,أبواب الخزينة تحت حامل المرايا كانت مفتوحة
Dialogue: 0,0:26:52.57,0:26:56.34,Default 2,,0,0,0,,...على الأرجح تُركت هناك\Nوتركت مضائة
Dialogue: 0,0:26:56.34,0:26:58.91,Default 2,,0,0,0,,...ماذا؟! إذًا فالقاتل
Dialogue: 0,0:26:58.91,0:27:04.38,Default 2,,0,0,0,,فهمت! لا أحد كان ليلاحظه\N!بينما كانت الكهرباء موجودة
Dialogue: 0,0:27:04.38,0:27:09.89,Default 2,,0,0,0,,بالكاد يكون من المؤكد أن لذلك علاقة\Nبتلك" الحادثة إذًا"
Dialogue: 0,0:27:09.89,0:27:11.79,Default 2,,0,0,0,,!ما "تلك" الحادثة؟
Dialogue: 0,0:27:11.79,0:27:13.09,Default 2,,0,0,0,,...لا، إنه
Dialogue: 0,0:27:13.09,0:27:19.13,Default 2,,0,0,0,,!لم لا تخبرني؟\N!كانت [ران] على وشك أن تُصاب
Dialogue: 0,0:27:19.13,0:27:20.70,Default 2,,0,0,0,,!أيها المفتش
Dialogue: 0,0:27:20.70,0:27:23.27,Default 2,,0,0,0,,!لدي أخبار بشعة! إنها [ران] -\N!ماذا عنها؟ -
Dialogue: 0,0:27:23.27,0:27:26.80,Default 2,,0,0,0,,لقد استعادت وعيها مجددًا\N!ولكنها تتصرف بغرابة
Dialogue: 0,0:27:26.80,0:27:28.13,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:27:35.71,0:27:37.11,Default 2,,0,0,0,,![ران]
Dialogue: 0,0:27:40.82,0:27:43.55,Default 2,,0,0,0,,أأنت بخيرٍ يا [ران]؟
Dialogue: 0,0:27:45.82,0:27:48.12,Default 2,,0,0,0,,من أنت...أيها الفتى الصغير؟
Dialogue: 0,0:27:56.27,0:27:58.47,Default 2,,0,0,0,,...مهلًا، الآن
Dialogue: 0,0:27:58.47,0:28:05.07,Default 2,,0,0,0,,إنها لا تتذكر اسمها حتى\N...ما بالك بنا نحن
Dialogue: 0,0:28:05.07,0:28:09.58,Default 2,,0,0,0,,!لا يمكن هذا\N!أنا [موري كوغورو]، والدك
Dialogue: 0,0:28:09.58,0:28:12.57,Default 2,,0,0,0,,!هذه [كيساكي إيري]، والدتك
Dialogue: 0,0:28:14.28,0:28:18.08,Default 2,,0,0,0,,لا أعرف، لا أستطيع تذكر أي شيء
Dialogue: 0,0:28:21.16,0:28:22.45,Default 2,,0,0,0,,...[ران]
Dialogue: 0,0:28:31.97,0:28:35.77,Default 2,,0,0,0,,دكتور [كازاتو]، آسفٌ لإزعاجك هكذا
Dialogue: 0,0:28:35.77,0:28:38.76,Default 2,,0,0,0,,ولكن لم يكن هناك أي أطباء نفسيين\N...بالخدمة، لهذا
Dialogue: 0,0:28:41.94,0:28:44.50,Default 2,,0,0,0,,أتعرفين من أنتِ؟
Dialogue: 0,0:28:48.78,0:28:53.29,Default 2,,0,0,0,,إذًا، فهل تتذكرين ما جرى اليوم؟
Dialogue: 0,0:28:53.29,0:28:54.52,Default 2,,0,0,0,,لا
Dialogue: 0,0:28:54.52,0:28:56.79,Default 2,,0,0,0,,ما هي عاصمة الولايات المتحدة؟
Dialogue: 0,0:28:56.79,0:28:58.66,Default 2,,0,0,0,,واشنطن العاصمة
Dialogue: 0,0:28:58.66,0:29:00.50,Default 2,,0,0,0,,ما هو حاصل ضرب 5 و8؟
Dialogue: 0,0:29:00.50,0:29:02.00,Default 2,,0,0,0,,40
Dialogue: 0,0:29:02.00,0:29:04.80,Default 2,,0,0,0,,رجاءً أريني كيف تستخدمين هذا القلم؟
Dialogue: 0,0:29:15.84,0:29:17.45,Default 2,,0,0,0,,فقدان ذاكرة ارتجاعي؟
Dialogue: 0,0:29:17.45,0:29:17.75,Default 2,,0,0,0,,فقدان ذاكرة ارتجاعي؟
Dialogue: 0,0:29:17.75,0:29:21.75,Default 2,,0,0,0,,أجل، إنه نوعٌ من اضطراب الذاكرة\Nوالذي فيه يؤدي المرض أو الإصابة المفاجئة
Dialogue: 0,0:29:21.75,0:29:26.56,Default 2,,0,0,0,,إلى جعل المريض غير قادرٍ على تذكر أي شيءٍ قبل الحادث
Dialogue: 0,0:29:26.56,0:29:31.99,Default 2,,0,0,0,,في حالة ابنتك، أعتقد بأنها تلقت صدمةً ذهنيةً قوية
Dialogue: 0,0:29:31.99,0:29:35.86,Default 2,,0,0,0,,بعد مشاهدتها لإطلاق النار على المحققة [ساتو] أمام عينيها
Dialogue: 0,0:29:35.86,0:29:39.33,Default 2,,0,0,0,,!إذًا، فهل ستستعيد ابنتي الذاكرة؟
Dialogue: 0,0:29:39.33,0:29:42.17,Default 2,,0,0,0,,لا أستطيع قول أي شيءٍ\Nبهذا الوقت
Dialogue: 0,0:29:42.17,0:29:48.11,Default 2,,0,0,0,,ولكني لم أجد أي مشكلةٍ\Nبمعرفتها حول المعلومات العامة
Dialogue: 0,0:29:48.11,0:29:51.71,Default 2,,0,0,0,,إذًا فهل تستطيع عيش حياةٍ طبيعية ؟
Dialogue: 0,0:29:51.71,0:29:58.59,Default 2,,0,0,0,,أجل، ولكن أبقوها هنا للمراقبة لأيامٍ قليلة
Dialogue: 0,0:29:58.59,0:30:01.59,Thoughts,,0,0,0,,من الطبيعي أن تكون [ران] مصدومة
Dialogue: 0,0:30:01.59,0:30:06.06,Thoughts,,0,0,0,,إذا ما تم إطلاق النار على محققة تعرفها\N...أمام عينيها
Dialogue: 0,0:30:06.06,0:30:12.07,Thoughts,,0,0,0,,!ولكن يجب أن يكون الأمر أكبر من ذلك لتفقد ذاكرتها
Dialogue: 0,0:30:12.07,0:30:16.90,Thoughts,,0,0,0,,!شيءٌ باستطاعته اختراق عقلها أكثر من ذلك
Dialogue: 0,0:30:29.05,0:30:31.89,Default 2,,0,0,0,,لقد انتهوا من جراحة الآنسة [ساتو]
Dialogue: 0,0:30:31.89,0:30:34.49,Default 2,,0,0,0,,لقد تمكنوا من إزالة الرصاصة
Dialogue: 0,0:30:34.49,0:30:37.29,Default 2,,0,0,0,,ولكن يصعب القول إذا ما كانت\N...ستنجو أم لا
Dialogue: 0,0:30:38.99,0:30:40.63,Default 2,,0,0,0,,...فهمت
Dialogue: 0,0:30:40.63,0:30:45.93,Default 2,,0,0,0,,!أيها المفتش\N!أما زلت لن تقول شيئًا حتى بعد كل ذلك؟
Dialogue: 0,0:30:47.64,0:30:51.67,Default 2,,0,0,0,,![شيراتوري]\N!أنت أيضًا تعرف! أخبرني
Dialogue: 0,0:30:51.67,0:30:55.31,Default 2,,0,0,0,,سنقبض على الشخص المسؤول عن ذلك بأنفسنا
Dialogue: 0,0:30:55.31,0:30:57.28,Default 2,,0,0,0,,!اللعنة
Dialogue: 0,0:30:57.28,0:30:59.35,Default 2,,0,0,0,,أخبرني أيها المحقق [شيبا]
Dialogue: 0,0:30:59.35,0:31:02.92,Default 2,,0,0,0,,هل تفقدتم المصباح اليدوي الذي كان بالحمام بحثًا عن بصمات؟
Dialogue: 0,0:31:02.92,0:31:08.96,Default 2,,0,0,0,,أجل، ولكننا وجدنا فقط بصمات آنسة [ران]
Dialogue: 0,0:31:08.96,0:31:13.96,Default 2,,0,0,0,,افترضنا جميعًا أن آنسة [ساتو] هي من أمسكت بالمصباح
Dialogue: 0,0:31:13.96,0:31:16.53,Default 2,,0,0,0,,ولكن على ما يبدو كانت الآنسة [ران]
Dialogue: 0,0:31:16.53,0:31:22.04,Default 2,,0,0,0,,في هذه الحالة، شعرت [ران] أن\Nذلك خطأها بأن الآنسة [ساتو] قد أُطلق عليها النار
Dialogue: 0,0:31:22.04,0:31:27.53,Default 2,,0,0,0,,!وبسبب تلك الصدمة فقدت ذاكرتها؟
Dialogue: 0,0:31:28.68,0:31:29.94,Thoughts,,0,0,0,,...[ران]
Dialogue: 0,0:31:36.05,0:31:42.56,Default 2,,0,0,0,,حتى إذا لم تعد ذاكرتك أبدًا\N...فسأظل دائمًا
Dialogue: 0,0:31:42.56,0:31:44.65,Default 2,,0,0,0,,...صديقتك...
Dialogue: 0,0:31:52.00,0:31:53.99,Default 2,,0,0,0,,سأخبرك بكل شيء
Dialogue: 0,0:31:56.81,0:31:59.31,Default 2,,0,0,0,,...ولكن أيها المفتش [ميجوري]! هذا
Dialogue: 0,0:31:59.31,0:32:05.04,Default 2,,0,0,0,,لا بأس، إذا طُردت\Nفسأفتح وكالة تحرٍ كـ[موري]
Dialogue: 0,0:32:07.35,0:32:08.98,Default 2,,0,0,0,,...أيها المفتش
Dialogue: 0,0:32:08.98,0:32:11.39,Default 2,,0,0,0,,[تاكاغي]\Nراقب الآنسة [ساتو]
Dialogue: 0,0:32:11.39,0:32:13.39,Default 2,,0,0,0,,[شيبا]\Nأنت راقب الآنسة [ران]
Dialogue: 0,0:32:13.39,0:32:16.02,Default 2,,0,0,0,,إذا ما حدث أي شيء، أبلغوني فورًا
Dialogue: 0,0:32:16.02,0:32:17.05,Default 2,,0,0,0,,!علم
Dialogue: 0,0:32:22.53,0:32:24.93,Default 2,,0,0,0,,الصيف الماضي، جثة [جينو تاموتسو]
Dialogue: 0,0:32:24.93,0:32:29.54,Default 2 - Copy,,0,0,0,,طبيب بمستشفى جامعة "توتو" قسم الجراحة الأول
Dialogue: 0,0:32:29.54,0:32:32.27,Default 2 - Copy,,0,0,0,,قد وُجدت في شقته
Dialogue: 0,0:32:32.27,0:32:36.61,Default 2 - Copy,,0,0,0,,وترأس التحقيق المفتش [توموناري]
Dialogue: 0,0:32:36.61,0:32:40.18,Default 2 - Copy,,0,0,0,,رئيسي في شعبة التحقيق الأولى
Dialogue: 0,0:32:40.18,0:32:44.75,Default 2 - Copy,,0,0,0,,عمل تحت امرته\N[ناراساوا] و[شيبا] الذان قد قُتلا
Dialogue: 0,0:32:44.75,0:32:47.76,Default 2 - Copy,,0,0,0,,كانت الآنسة [ساتو] تعمل معهم أيضًا
Dialogue: 0,0:32:47.76,0:32:53.43,Default 2,,0,0,0,,شرب السيد [جينو] الكثير من الكحول وقطع وريده الوداجي الأيمن
Dialogue: 0,0:32:53.43,0:32:56.93,Default 2,,0,0,0,,بمشرطه الخاص
Dialogue: 0,0:32:56.93,0:32:58.77,Default 2,,0,0,0,,مات بسبب فقدان الدم
Dialogue: 0,0:32:58.77,0:33:01.77,Default 2 - Copy,,0,0,0,,وكان أول شخصٍ يجده\Nهي أخته الآنسة [تاماكي]
Dialogue: 0,0:33:01.77,0:33:05.44,Default 2 - Copy,,0,0,0,,مراسلة تحقيقاتٍ تعيش في بلدة مجاورة
Dialogue: 0,0:33:05.44,0:33:07.44,Default 2,,0,0,0,,...عمي! إنها
Dialogue: 0,0:33:07.44,0:33:09.48,Default 2,,0,0,0,,!لقد كانت في حفلة الفندق اليوم
Dialogue: 0,0:33:09.48,0:33:14.08,Default 2,,0,0,0,,!الآن تذكرت\N!لقد جاءت لتزورني مرة من قبل
Dialogue: 0,0:33:14.08,0:33:16.08,Default 2,,0,0,0,,ماذا؟ ذهبت إلى مكتبك؟
Dialogue: 0,0:33:16.08,0:33:19.59,Default 2,,0,0,0,,ماذا أخبرتك إذًا؟
Dialogue: 0,0:33:19.59,0:33:23.16,Default 2,,0,0,0,,في الواقع قد كنت تحت تأثير الشراب\Nقليلًا في ذلك الوقت
Dialogue: 0,0:33:23.16,0:33:29.43,Default 2,,0,0,0,,لهذا لا أستطيع تذكر\N...ما تحدثت معي بشأنه على الإطلاق
Dialogue: 0,0:33:29.43,0:33:33.07,Default 2,,0,0,0,,!أتذكر حادثة ذلك الشخص [جينو]
Dialogue: 0,0:33:33.07,0:33:36.07,Default 2,,0,0,0,,ألم تقاضه عائلة مريضٍ لإفساده عملية
Dialogue: 0,0:33:36.07,0:33:38.77,Default 2,,0,0,0,,قبل بضعة أيامٍ من موته؟
Dialogue: 0,0:33:38.77,0:33:40.48,Default 2,,0,0,0,,هذا صحيح
Dialogue: 0,0:33:40.48,0:33:45.48,Default 2,,0,0,0,,لقد ترك رسالةً أخيرة على معالج النصوص الخاص به معتذرًا عن ذلك
Dialogue: 0,0:33:45.48,0:33:50.29,Default 2,,0,0,0,,لهذا استنتج المفتش [توموناري]\Nأن ذلك على الأرجح كان انتحارًا
Dialogue: 0,0:33:50.29,0:33:55.49,Default 2,,0,0,0,,ولكن أخته الآنسة [تاماكي] خالفته الرأي
Dialogue: 0,0:33:55.49,0:34:00.93,Default 2,,0,0,0,,قالت أنه كان طبيبًا مريعًا ولم يكن يهتم أبدًا بمرضاه
Dialogue: 0,0:34:00.93,0:34:05.83,Default 2,,0,0,0,,وأنه لم يكن ليقتل نفسه أبدًا ليعتذر عن عملية فاشلة
Dialogue: 0,0:34:05.83,0:34:10.84,Default 2,,0,0,0,,وقبل أسبوع من ذلك\Nقد شاهدته على ما يبدو يتجادل
Dialogue: 0,0:34:10.84,0:34:15.68,Default 2,,0,0,0,,مع شابٍ ذو شعرٍ قرمزي أمام مستودع
Dialogue: 0,0:34:15.68,0:34:18.11,Thoughts,,0,0,0,,!شعر قرمزي
Dialogue: 0,0:34:18.11,0:34:23.05,Default 2,,0,0,0,,وللتأكد من الأمر، أخذ المفتش [توموناري]\N[ساتو]، [ناراساوا] و[شيبا]
Dialogue: 0,0:34:23.05,0:34:25.02,Default 2,,0,0,0,,إلى المستودع
Dialogue: 0,0:34:26.39,0:34:31.69,Default 2,,0,0,0,,وقد كان ذاك اليوم حارًا على وجه الخصوص\N35°C بدرجة حرارة تفوق
Dialogue: 0,0:34:36.06,0:34:37.53,Default 2,,0,0,0,,!إنه مغلق
Dialogue: 0,0:34:37.53,0:34:38.90,Default 2,,0,0,0,,!حسنًا! فلنراقب المكان
Dialogue: 0,0:34:38.90,0:34:41.13,Default 2,,0,0,0,,!اذهب أنت إلى هناك يا [شيبا] -\N!علم -
Dialogue: 0,0:34:49.31,0:34:51.71,Default 2,,0,0,0,,...لا أصدق هذه الحرارة
Dialogue: 0,0:34:53.35,0:34:55.98,Default 2,,0,0,0,,!ما الذي يجري أيها المفتش؟
Dialogue: 0,0:34:55.98,0:34:59.15,Default 2,,0,0,0,,!إنه يتعرض لنوبةٍ قلبية، اتصلي بالإسعاف
Dialogue: 0,0:34:59.15,0:35:00.14,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,0:35:01.89,0:35:04.09,Default 2,,0,0,0,,!لا تفعلي -\N!ماذا؟ -
Dialogue: 0,0:35:04.09,0:35:07.56,Default 2,,0,0,0,,!نحن في خضم عملية مراقبة -\N...ولكن -
Dialogue: 0,0:35:07.56,0:35:09.00,Default 2,,0,0,0,,!سأكون بخير
Dialogue: 0,0:35:09.00,0:35:12.03,Default 2,,0,0,0,,!سآخذ سيارة أجرةٍ إلى المستشفى
Dialogue: 0,0:35:12.03,0:35:15.09,Default 2,,0,0,0,,!استمروا...بمراقبة المكان
Dialogue: 0,0:35:19.04,0:35:23.20,Default 2,,0,0,0,,لكن بعد فترة ليست بطويلة\N...قلقت الآنسة [ساتو] و ذهبت لتنظر
Dialogue: 0,0:35:26.21,0:35:27.77,Default 2,,0,0,0,,!أيها المفتش [توموناري]
Dialogue: 0,0:35:33.26,0:35:39.39,Default 2 - Copy,,0,0,0,,أخذت الآنسة [ساتو] المفتش [توموناري]\N"مباشرة إلى مستشفى جامعة "توتو
Dialogue: 0,0:35:39.39,0:35:45.03,Default 2,,0,0,0,,...وعلى الرغم من ذلك، قد مات خلال الجراحة
Dialogue: 0,0:35:46.80,0:35:50.47,Default 2,,0,0,0,,...لقد غابت الآنسة [ساتو] طويلًا -\N...أجل -
Dialogue: 0,0:35:50.47,0:35:51.60,Default 2,,0,0,0,,!ها قد جاء
Dialogue: 0,0:35:55.61,0:35:59.24,Default 2,,0,0,0,,!اللعنة، إن الجو حارٌ اليوم
Dialogue: 0,0:36:00.25,0:36:01.88,Default 2,,0,0,0,,!فلنذهب -\N!انتظر -
Dialogue: 0,0:36:01.88,0:36:04.42,Default 2,,0,0,0,,!أتعرف من هو هذا الرجل؟
Dialogue: 0,0:36:04.42,0:36:05.94,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:36:08.49,0:36:12.15,Default 2,,0,0,0,,إنه ابن الرئيس [أوداغيري]\N!السيد [توشيا]
Dialogue: 0,0:36:15.23,0:36:18.80,Default 2,,0,0,0,,في النهاية وبموت المفتش [توموناري] المفاجئ
Dialogue: 0,0:36:18.80,0:36:24.51,Default 2,,0,0,0,,موت [جينو تاموتسو] اعتُبر انتحارًا\Nوأقفلت القضية
Dialogue: 0,0:36:24.51,0:36:28.11,Default 2,,0,0,0,,تفقدت أخته الآنسة [تاماكي] ذلك الشخص
Dialogue: 0,0:36:28.11,0:36:32.25,Default 2,,0,0,0,,ولكن المحقق [شيبا] أخبرها أنه غير مرتبطٍ بالقضية
Dialogue: 0,0:36:32.25,0:36:34.98,Default 2,,0,0,0,,إذًا فماذا حدث؟
Dialogue: 0,0:36:34.98,0:36:40.36,Default 2,,0,0,0,,كان للمفتش [توموناري] ابنًا\N...يدعى [ماكوتو]
Dialogue: 0,0:36:40.36,0:36:44.16,Default 2,,0,0,0,,!لقد كان في الحفل
Dialogue: 0,0:36:44.16,0:36:45.86,Default 2,,0,0,0,,...وقد اختفى بعد ذلك بقليل بالرغم من ذلك
Dialogue: 0,0:36:45.86,0:36:47.70,Default 2,,0,0,0,,أله علاقةٌ بهذا الأمر؟
Dialogue: 0,0:36:47.70,0:36:50.82,Default 2,,0,0,0,,أجل، لقد حدث ذلك في ليلة الجنازة
Dialogue: 0,0:36:54.30,0:36:57.81,Default 2,,0,0,0,,لم لم تتصلوا بالإسعاف؟
Dialogue: 0,0:36:57.81,0:37:01.68,Default 2,,0,0,0,,كان من شأن والدي أن يبقى حيًا إذا ما فعلتم
Dialogue: 0,0:37:01.68,0:37:04.81,Default 2,,0,0,0,,...لا، لقد فعلنا فقط ما أمرنا به
Dialogue: 0,0:37:04.81,0:37:10.45,Default 2,,0,0,0,,!أنتم من قتلتم أبي\N!لن أسامحكم لهذا أبدًا
Dialogue: 0,0:37:14.69,0:37:17.33,Default 2,,0,0,0,,تفضل يا [كونان] -\Nشكرًا -
Dialogue: 0,0:37:17.33,0:37:20.33,Default 2,,0,0,0,,بعد ذلك بقليل، كلٌ من\Nالمحقق [ناراساوا] والمحقق [شيبا]
Dialogue: 0,0:37:20.33,0:37:22.33,Default 2,,0,0,0,,قد تم نقلهما\Nإلى مركز شرطة المنطقة
Dialogue: 0,0:37:22.33,0:37:27.30,Default 2,,0,0,0,,ولكن [شيراتوري] لاحظ أن الآنسة [ساتو] بدأت تحقق
Dialogue: 0,0:37:27.30,0:37:29.91,Default 2,,0,0,0,,في شيءٍ بمفردها مؤخرًا
Dialogue: 0,0:37:29.91,0:37:34.64,Default 2,,0,0,0,,هي والمحقق [ناراساوا] والمحقق [شيبا]
Dialogue: 0,0:37:34.64,0:37:37.34,Default 2,,0,0,0,,بدؤوا في إعادة التحقيق في تلك القضية منذ عام مضى
Dialogue: 0,0:37:45.75,0:37:50.33,Default 2,,0,0,0,,ولكن يبدو أن الآنسة [ساتو] لم تكن على علمٍ بالعلاقة
Dialogue: 0,0:37:50.33,0:37:52.89,Default 2,,0,0,0,,ما بين [توشيا] و[جينو]
Dialogue: 0,0:37:52.89,0:37:59.27,Default 2,,0,0,0,,تم إطلاق النار على [ناراساوا] ولقى مصرعه بعد ذلك بفترة وجيزة
Dialogue: 0,0:37:59.27,0:38:02.34,Default 2,,0,0,0,,ثم المحقق [شيبا] قُتل أيضًا
Dialogue: 0,0:38:02.34,0:38:08.51,Default 2,,0,0,0,,وقد أدركنا أنهم مستهدفون بسبب تلك القضية منذ عام
Dialogue: 0,0:38:08.51,0:38:10.28,Default 2,,0,0,0,,من دفاتر ملاحظاتهم الشرطية
Dialogue: 0,0:38:10.28,0:38:13.45,Default 2,,0,0,0,,استنبطنا أن القاتل متصلٌ\Nبالشرطةٍ بطريقةٍ ما
Dialogue: 0,0:38:13.45,0:38:17.89,Default 2,,0,0,0,,المحقق [تاكاغي] حقق في أمر\N[توموناري ماكوتو]، ابن المفتش
Dialogue: 0,0:38:17.89,0:38:22.79,Default 2,,0,0,0,,وأنا حققت في أمر [توشيا] ابن الرئيس
Dialogue: 0,0:38:27.10,0:38:32.57,Default 2,,0,0,0,,شعرت بأنه هناك احتمال كبير\Nأن تكون الآنسة [ساتو] هي الهدف القادم
Dialogue: 0,0:38:32.57,0:38:36.81,Default 2,,0,0,0,,لذا قلت لها أن تدع أحدهم يحرسها
Dialogue: 0,0:38:36.81,0:38:39.91,Default 2,,0,0,0,,ولكنها رفضت
Dialogue: 0,0:38:39.91,0:38:45.11,Default 2,,0,0,0,,إذًا فلهذا تكلمت معها في الحفلة أيضًا؟
Dialogue: 0,0:38:45.11,0:38:46.81,Default 2,,0,0,0,,أجل
Dialogue: 0,0:38:48.55,0:38:53.82,Default 2,,0,0,0,,!لقد اكتشفت الحل أيها المفتش\N!القاتل هو [أوداغيري توشيا]
Dialogue: 0,0:38:53.82,0:38:57.83,Default 2,,0,0,0,,كلٌ من المحققين [ناراساوا] و[شيبا] و[ساتو]\Nكانوا قد شرعوا في إعادة التحقيق
Dialogue: 0,0:38:57.83,0:39:01.76,Default 2,,0,0,0,,في قضية [جينو] من العام الماضي\N!لهذا قرر أن يضرب أولًا
Dialogue: 0,0:39:01.76,0:39:05.57,Default 2,,0,0,0,,ولكنه لم يكن من أطلق النار على الآنسة [ساتو]
Dialogue: 0,0:39:05.57,0:39:08.57,Default 2,,0,0,0,,فإننا لم نجد آثار بارودٍ عليه
Dialogue: 0,0:39:08.57,0:39:10.57,Default 2,,0,0,0,,فهمت
Dialogue: 0,0:39:10.57,0:39:15.14,Default 2,,0,0,0,,والأهم من ذلك أننا لا نستطيع\Nتحديد مكان [توموناري ماكوتو]
Dialogue: 0,0:39:15.14,0:39:20.42,Default 2,,0,0,0,,بالإضافة إلى ذلك، فإنه كان قريبًا\Nعندما أُطلق النار على [ناراساوا] و[شيبا]
Dialogue: 0,0:39:20.42,0:39:24.62,Default 2,,0,0,0,,...وبالأخذ في الاعتبار وجوده بحفل اليوم
Dialogue: 0,0:39:24.62,0:39:29.52,Default 2,,0,0,0,,...نحن نعلم أن القاتل أعسر مع ذلك
Dialogue: 0,0:39:29.52,0:39:33.36,Default 2,,0,0,0,,بالتفكير في الأمر، فـ[توموناري ماكوتو]\N!هو أعسرٌ أيضًا
Dialogue: 0,0:39:33.36,0:39:36.00,Default 2,,0,0,0,,حسنًا! ضع [توموناري ماكوتو]\N!على لائحة المطلوبين
Dialogue: 0,0:39:36.00,0:39:37.26,Default 2,,0,0,0,,!علم
Dialogue: 0,0:39:39.63,0:39:45.04,Default 2,,0,0,0,,أخبرني أيها المفتش\Nكيف تم قطع الوريد الوداجي لذلك المدعو [جينو]؟
Dialogue: 0,0:39:45.04,0:39:50.61,Default 2,,0,0,0,,كيف؟ تم قطعه من الجهة اليمنى\Nمباشرةً من الأعلى إلى الأسفل
Dialogue: 0,0:39:50.61,0:39:56.38,Default 2,,0,0,0,,إذًا فإذا كان قتلًا، فإن قاتله\Nمن المحتمل أن يكون أعسرًا
Dialogue: 0,0:39:56.38,0:39:59.45,Default 2,,0,0,0,,ماذا؟ -\N!وكيف عرفت ذلك؟  -
Dialogue: 0,0:39:59.45,0:40:02.62,Default 2,,0,0,0,,...فبعد كل شيء -\Nليتفادى تلطخه بالدماء -
Dialogue: 0,0:40:02.62,0:40:05.46,Default 2,,0,0,0,,...لفعل ذلك
Dialogue: 0,0:40:05.46,0:40:09.36,Default 2,,0,0,0,,عليك أن تقطع الوريد الوداجي الأيمن\Nبيدك اليسرى
Dialogue: 0,0:40:09.36,0:40:11.30,Default 2,,0,0,0,,صحيحٌ يا [كونان]؟
Dialogue: 0,0:40:11.30,0:40:12.97,Default 2,,0,0,0,,أجل
Dialogue: 0,0:40:12.97,0:40:14.30,Default 2,,0,0,0,,!فهمت
Dialogue: 0,0:40:14.30,0:40:18.54,Default 2,,0,0,0,,لا، ولكن لا يوجد علاقةٌ\Nما بين [توموناري ماكوتو] و[جينو]
Dialogue: 0,0:40:18.54,0:40:23.68,Default 2,,0,0,0,,إذا ما كان [جينو] قد قُتل\Nفحتمًا كان قاتلًا أعسرًا مختلف
Dialogue: 0,0:40:23.68,0:40:27.98,Default 2,,0,0,0,,السيد [توشيا] أعسرٌ أيضًا\Nفلقد أشعل الثقاب بيده اليسرى
Dialogue: 0,0:40:27.98,0:40:32.52,Default 2,,0,0,0,,هناك شخصٌ آخر\Nوالده الرئيس [أوداغيري]
Dialogue: 0,0:40:32.52,0:40:34.66,Default 2,,0,0,0,,إنه أعسرٌ أيضًا
Dialogue: 0,0:40:34.66,0:40:39.73,Default 2,,0,0,0,,!لا تكوني حمقاء\N!لا يعقل أن يكون هو القاتل
Dialogue: 0,0:40:39.73,0:40:41.89,Default 2,,0,0,0,,أيها المفتش؟
Dialogue: 0,0:41:19.57,0:41:21.64,Default 2,,0,0,0,,!أنا [يوشيدا أيومي]
Dialogue: 0,0:41:21.64,0:41:26.57,Default 2,,0,0,0,,[كوجيما غينتا]، [تسوبورايا ميتسوهيكو]\N!و[هايبرا آي]
Dialogue: 0,0:41:26.57,0:41:28.58,Default 2,,0,0,0,,كلنا أصدقاء [كونان]
Dialogue: 0,0:41:28.58,0:41:31.65,Default 2,,0,0,0,,وقد جئنا لأننا كنا قلقين عليك
Dialogue: 0,0:41:31.65,0:41:36.75,Default 2,,0,0,0,,شكرًا لكم\Nولكني آسفة، فأنا لا أتذكر أيًا منكم
Dialogue: 0,0:41:36.75,0:41:39.29,Default 2,,0,0,0,,!لا! لا أصدق هذا
Dialogue: 0,0:41:39.29,0:41:41.99,Default 2,,0,0,0,,!لقد كنتِ تلعبين معنا دائمًا
Dialogue: 0,0:41:41.99,0:41:46.49,Default 2,,0,0,0,,ألا تتذكرينني أنا أيضًا؟\Nأنا [أغاسا هيروشي]
Dialogue: 0,0:41:46.49,0:41:50.50,Default 2,,0,0,0,,العالم العبقري الذي يعيش بجوار
Dialogue: 0,0:41:50.50,0:41:54.60,Default 2,,0,0,0,,صديق طفولتك وزميلك بالفصل\N!السيد [كودو شينتشي]
Dialogue: 0,0:41:54.60,0:41:58.67,Default 2,,0,0,0,,[كودو]... [شينتشي]؟
Dialogue: 0,0:41:58.67,0:42:01.34,Default 2,,0,0,0,,أتتذكرين [شينتشي]؟
Dialogue: 0,0:42:01.34,0:42:03.61,Default 2,,0,0,0,,لا...لا أتذكر
Dialogue: 0,0:42:05.41,0:42:06.78,Default 2,,0,0,0,,حسنًا
Dialogue: 0,0:42:15.19,0:42:16.76,Default 2,,0,0,0,,ماذا هنالك يا [هايبرا]؟
Dialogue: 0,0:42:16.76,0:42:20.42,Default 2,,0,0,0,,شعرت بأن أحدهم كان\N...يحدق بنا الآن
Dialogue: 0,0:42:25.67,0:42:27.69,Default 2,,0,0,0,,لابد أنني كنت أتخيل
Dialogue: 0,0:42:35.14,0:42:37.78,Default 2,,0,0,0,,أنا آسفة، فأنا متعبةٌ قليلًا
Dialogue: 0,0:42:37.78,0:42:40.81,Default 2,,0,0,0,,لا بأس، احصلي على بعض الراحة
Dialogue: 0,0:42:42.52,0:42:43.68,Default 2,,0,0,0,,!من هناك؟
Dialogue: 0,0:42:50.29,0:42:51.03,Default 2,,0,0,0,,!اللعنة
Dialogue: 0,0:42:51.03,0:42:53.03,Default 2,,0,0,0,,ماذا هناك يا [كونان]؟
Dialogue: 0,0:42:53.03,0:42:56.63,Default 2,,0,0,0,,عمي! هل تعتقد بأن [ران]\N قد رأت وجه القاتل؟
Dialogue: 0,0:42:56.63,0:42:58.97,Default 2,,0,0,0,,!عندما أُطلق النار على المحققة [ساتو]؟
Dialogue: 0,0:42:58.97,0:42:59.97,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:42:59.97,0:43:04.70,Default 2,,0,0,0,,إذا كان الأمر كذلك فمن المحتمل\N!أن يطاردها القاتل
Dialogue: 0,0:43:09.58,0:43:11.15,Default 2,,0,0,0,,لقد كنت في انتظارك
Dialogue: 0,0:43:11.15,0:43:16.02,Default 2,,0,0,0,,لا تقلقي، السيد [تاكاغي] والسيد [شيبا]\Nسيتناوبون في حراستها
Dialogue: 0,0:43:16.02,0:43:16.72,Default 2,,0,0,0,,أين هي الآن؟
Dialogue: 0,0:43:16.72,0:43:20.66,Default 2,,0,0,0,,زوجي معها -\Nحسنًا، فلنذهب -
Dialogue: 0,0:43:20.66,0:43:23.19,Default 2,,0,0,0,,سيدة [كيساكي]؟ -\Nنعم؟ -
Dialogue: 0,0:43:23.19,0:43:27.86,Default 2,,0,0,0,,يقول الدكتور [كازاتو] أنه يود مكالمتك بشأن ابنتك
Dialogue: 0,0:43:27.86,0:43:32.06,Default 2,,0,0,0,,آشعة الرنين المغناطيسي\Nلا تظهر أي تلفٍ في دماغها
Dialogue: 0,0:43:33.67,0:43:36.67,Default 2,,0,0,0,,على ما يبدو قد أصيبت ابنتكم بفقدان الذاكرة
Dialogue: 0,0:43:36.67,0:43:40.71,Default 2,,0,0,0,,كطريقةٍ لتنقذ نفسها من الصدمة الدماغية
Dialogue: 0,0:43:40.71,0:43:45.75,Default 2,,0,0,0,,أيعني ذلك أننا إذا أخذناها\Nإلى ذلك الفندق و أعدنا تمثيل الحادث
Dialogue: 0,0:43:45.75,0:43:47.68,Default 2,,0,0,0,,فستستعيد ذاكرتها؟
Dialogue: 0,0:43:47.68,0:43:49.52,Default 2,,0,0,0,,!عن ماذا تتكلم أنت؟
Dialogue: 0,0:43:49.52,0:43:53.86,Default 2,,0,0,0,,لا حاجة في أن نجعلها تتذكر أمرًا\N!لا تريد هي تذكره
Dialogue: 0,0:43:53.86,0:43:57.73,Default 2,,0,0,0,,أتقولين أنك لا تهتمين إذا\N!ما لم تعد إليها ذاكرتها أبدًا؟
Dialogue: 0,0:43:57.73,0:44:01.23,Default 2,,0,0,0,,أنا ضد أي شيءٍ\N!يجعلها تعاني
Dialogue: 0,0:44:01.23,0:44:07.74,Default 2,,0,0,0,,!مهلًا، مهلًا\Nإجبارها على تذكر شيءٍ قد يسبب الضر لدماغها
Dialogue: 0,0:44:07.74,0:44:09.10,Default 2,,0,0,0,,أرأيت؟
Dialogue: 0,0:44:11.64,0:44:12.80,Default 2,,0,0,0,,المعذرة
Dialogue: 0,0:44:13.91,0:44:15.90,Default 2,,0,0,0,,هنا [كازاتو]
Dialogue: 0,0:44:17.31,0:44:20.88,Default 2,,0,0,0,,حسنًا، مفهوم\Nسأتصل به
Dialogue: 0,0:44:20.88,0:44:24.79,Thoughts,,0,0,0,,إذا كانت [ران] قد رأت وجه القاتل\Nفهي في خطر
Dialogue: 0,0:44:24.79,0:44:29.82,Thoughts,,0,0,0,,إلا إذا أعدنا لها ذاكرتها\N!وقبضنا على ذلك الشخص في أقرب وقتٍ ممكن
Dialogue: 0,0:44:29.82,0:44:35.10,Thoughts,,0,0,0,,ولكن كما قال الطبيب\N...لا نستطيع إجبارها على التذكر
Dialogue: 0,0:44:35.10,0:44:39.30,Thoughts,,0,0,0,,!سيتحتم علي حماية [ران] بنفسي
Dialogue: 0,0:44:39.30,0:44:42.77,Default 2,,0,0,0,,ماذا؟ إنه لا يجيب
Dialogue: 0,0:44:42.77,0:44:44.47,Default 2,,0,0,0,,عذرًا على هذا
Dialogue: 0,0:44:44.47,0:44:50.85,Default 2,,0,0,0,,دكتور، أهناك أي طريقةٍ\Nلاستعادة ذاكرتها بشكلٍ طبيعي؟
Dialogue: 0,0:44:50.85,0:44:56.35,Default 2,,0,0,0,,إنه من الشائع أن يتذكر\Nالناس الأشياء فجأةً بينما هم في حالة الاسترخاء
Dialogue: 0,0:44:56.35,0:44:57.95,Default 2,,0,0,0,,مفهوم
Dialogue: 0,0:44:57.95,0:45:00.76,Default 2,,0,0,0,,بمجرد أن تخرج [ران]\Nفسأنتقل للعيش بمكتبك أيضًا
Dialogue: 0,0:45:00.76,0:45:02.02,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:45:02.02,0:45:06.76,Default 2,,0,0,0,,ليكون باستطاعتي الاعتناء بها\Nبهذه الطريقة، وأساعدها على الاسترخاء
Dialogue: 0,0:45:06.76,0:45:10.30,Default 2,,0,0,0,,!هذه ليست مزحة\N!أنت ستسببين لي التوتر أكثر
Dialogue: 0,0:45:10.30,0:45:14.80,Default 2,,0,0,0,,!لا يهمني ما يحل بك\N!هذا كله من أجل [ران]
Dialogue: 0,0:45:14.80,0:45:15.77,Default 2,,0,0,0,,!هل فهمت؟
Dialogue: 0,0:45:16.77,0:45:19.30,Thoughts,,0,0,0,,...لن يكون هذا جيدًا
Dialogue: 0,0:45:26.18,0:45:30.49,Default 2,,0,0,0,,آنسة [ران]، رجاءً لا تدفعي نفسك\Nبقوةٍ لتذكر أي شيء
Dialogue: 0,0:45:30.49,0:45:31.79,Default 2,,0,0,0,,مفهوم؟
Dialogue: 0,0:45:31.79,0:45:33.79,Default 2,,0,0,0,,حسنًا
Dialogue: 0,0:45:33.79,0:45:36.82,Default 2,,0,0,0,,رجاءً اتصلوا بي\Nإذا ما استعادت أيًا من ذاكرتها
Dialogue: 0,0:45:36.82,0:45:38.62,Default 2,,0,0,0,,مفهوم
Dialogue: 0,0:45:41.33,0:45:46.40,Default 2,,0,0,0,,لقد عشت بهذه البلدة لسبعة عشر عامًا\Nمنذ ولادتك
Dialogue: 0,0:45:46.40,0:45:48.20,Default 2,,0,0,0,,أتعرفينها؟
Dialogue: 0,0:45:57.85,0:46:01.08,Default 2,,0,0,0,,هذا هو منزلك
Dialogue: 0,0:46:01.08,0:46:04.98,Default 2,,0,0,0,,"...وكالة موري للتحريات"
Dialogue: 0,0:46:06.82,0:46:08.05,Default 2,,0,0,0,,ستبتلين
Dialogue: 0,0:46:11.19,0:46:12.82,Default 2,,0,0,0,,ماذا هناك يا [ران]؟
Dialogue: 0,0:46:17.33,0:46:19.37,Default 2,,0,0,0,,بالتأكيد لا تحب برك الماء
Dialogue: 0,0:46:19.37,0:46:23.33,Default 2,,0,0,0,,فقد كان هناك الكثير من الماء\N...عندما أُطلق النار على المحققة [ساتو] أيضًا، لهذا
Dialogue: 0,0:46:24.84,0:46:26.74,Default 2,,0,0,0,,قُد للأمام قليلًا
Dialogue: 0,0:46:26.74,0:46:27.94,Default 2,,0,0,0,,حسنًا
Dialogue: 0,0:46:31.68,0:46:34.05,Default 2,,0,0,0,,الطابق الثاني هو المكتب
Dialogue: 0,0:46:34.05,0:46:37.54,Default 2,,0,0,0,,أنا دائمًا أحل القضايا الصعبة\N!على هذا المكتب هناك
Dialogue: 0,0:46:38.85,0:46:42.05,Thoughts,,0,0,0,,كل ما تفعله هو شرب الجعة ومشاهدة التلفاز
Dialogue: 0,0:46:46.59,0:46:49.26,Default 2,,0,0,0,,هنا بالطابق الثالث\Nتوجد غرفة المعيشة والمطبخ
Dialogue: 0,0:46:49.26,0:46:51.79,Default 2,,0,0,0,,وهناك تقع غرفتك
Dialogue: 0,0:47:09.92,0:47:12.49,Default 2,,0,0,0,,هذا يدعى [كودو شينتشي]
Dialogue: 0,0:47:12.49,0:47:16.49,Default 2,,0,0,0,,!إنه أحمقٌ يحاول إغواءَكِ
Dialogue: 0,0:47:16.49,0:47:19.22,Thoughts,,0,0,0,,!أنا لا أحاول إغواء أحد
Dialogue: 0,0:47:21.43,0:47:23.93,Default 2,,0,0,0,,صحيح! أنت تمارسين الكاراتيه\N!يا [ران]
Dialogue: 0,0:47:23.93,0:47:26.43,Default 2,,0,0,0,,أنا أعرف الكاراتيه؟
Dialogue: 0,0:47:26.43,0:47:31.74,Default 2,,0,0,0,,!لقد ربحت بطولة المرحلة الثانوية\Nألا تتذكرين؟
Dialogue: 0,0:47:31.74,0:47:33.61,Default 2,,0,0,0,,لا
Dialogue: 0,0:47:33.61,0:47:35.01,Default 2,,0,0,0,,حسنًا
Dialogue: 0,0:47:36.81,0:47:41.02,Default 2,,0,0,0,,ولكن لا تقلقي! سأتذكر كل شيءٍ\N!عاجلًا أم آجلًا
Dialogue: 0,0:47:41.02,0:47:44.32,Default 2,,0,0,0,,أجل! فلنعد شيئًا جيدًا\Nلنأكله الليلة
Dialogue: 0,0:47:44.32,0:47:46.02,Default 2,,0,0,0,,!احتفالًا بخروج [ران] من المستشفى
Dialogue: 0,0:47:46.02,0:47:49.85,Default 2,,0,0,0,,في هذه الحالة دعوني أُعد\N!شيئًا كما بالماضي
Dialogue: 0,0:47:52.13,0:47:55.13,Default 2,,0,0,0,,ماذا؟ ما الذي دهاكم فجأة؟
Dialogue: 0,0:47:55.13,0:47:58.30,Default 2,,0,0,0,,ماذا تعنين؟\N...أن تُعدي
Dialogue: 0,0:47:58.30,0:48:03.04,Default 2,,0,0,0,,!لا أريد أي شيء إذًا\N...فأنا لست جائع
Dialogue: 0,0:48:03.04,0:48:06.04,Default 2,,0,0,0,,ليس عليك الرفض لتكون مهذبًا\Nيا [كونان]
Dialogue: 0,0:48:06.04,0:48:13.61,Default 2,,0,0,0,,سأعمل جاهدةً لأُعد لك بعضًا من\N!حساء اللحم الشهي
Dialogue: 0,0:48:13.61,0:48:14.95,Thoughts,,0,0,0,,...هذا أسوأ شيء
Dialogue: 0,0:48:14.95,0:48:17.95,Default 2,,0,0,0,,ماذا؟\Nإلى أين أنت ذاهبٌ يا عزيزي؟
Dialogue: 0,0:48:17.95,0:48:22.56,Default 2,,0,0,0,,لا، لقد نسيت تمامًا أني قد وعدت\Nبأن ألعب الماجونغ
Dialogue: 0,0:48:22.56,0:48:24.69,Default 2,,0,0,0,,!مع الجيران الليلة
Dialogue: 0,0:48:24.69,0:48:29.86,Default 2,,0,0,0,,هذا ليس وقت لعب الماجونغ\N!بينما ابنتك بهذه الحالة
Dialogue: 0,0:48:29.86,0:48:34.70,Default 2,,0,0,0,,أم ماذا؟\Nأتقول أنك لا تستطيع أكل ما سأطبخ؟
Dialogue: 0,0:48:45.98,0:48:49.98,Thoughts,,0,0,0,,!رائع! [ران] أكثر ابتهاجًا مما ظننت
Dialogue: 0,0:48:49.98,0:48:51.58,Thoughts,,0,0,0,,!ستكون بخيرٍ حتمًا
Dialogue: 0,0:49:22.92,0:49:24.21,Thoughts,,0,0,0,,...[ران]
Dialogue: 0,0:49:34.93,0:49:37.10,Default 2,,0,0,0,,حراس؟ لي؟
Dialogue: 0,0:49:37.10,0:49:41.87,Default 2,,0,0,0,,لقد سمعنا من المحقق [تاكاغي]\N!أن القاتل قد يسعى خلفك
Dialogue: 0,0:49:43.64,0:49:48.38,Default 2,,0,0,0,,لذا نحن، فرقة المتحرين الصغار\N!قد قررنا أن نحميك
Dialogue: 0,0:49:48.38,0:49:49.78,Default 2,,0,0,0,,...سندعو أنفسنا
Dialogue: 0,0:49:50.88,0:49:54.44,Default 2,,0,0,0,,!فريق حماية الآنسة [ران]
Dialogue: 0,0:49:55.45,0:49:57.15,Thoughts,,0,0,0,,...يا إلهي
Dialogue: 0,0:49:57.15,0:50:00.66,Default 2,,0,0,0,,لقد أحضرت مسدس مياه\N!مليءٌ بالصوص الحار
Dialogue: 0,0:50:00.66,0:50:02.59,Default 2,,0,0,0,,!وأنا أحضرت الكيد المرتد
Dialogue: 0,0:50:02.59,0:50:04.46,Default 2,,0,0,0,,!وأنا جلبت الأصفاد
Dialogue: 0,0:50:04.46,0:50:08.23,Default 2,,0,0,0,,...بحقكم، ألعاب الأطفال تلك لن تساعدنا
Dialogue: 0,0:50:08.23,0:50:11.93,Default 2,,0,0,0,,!شكرًا لكم يا رفاق\N!أشعر بأمانٍ أكبر
Dialogue: 0,0:50:14.80,0:50:18.11,Default 2,,0,0,0,,ولأشكركم، سأقدم لكم شيئًا لطيفًا\N!وباردًا! تعالو إلى الأعلى
Dialogue: 0,0:50:18.11,0:50:20.61,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,0:50:20.61,0:50:23.18,Default 2,,0,0,0,,!مرحى
Dialogue: 0,0:50:23.18,0:50:25.61,Default 2,,0,0,0,,ألا تستطيع تذكر أي شيءٍ بعد؟
Dialogue: 0,0:50:25.61,0:50:27.28,Default 2,,0,0,0,,لا
Dialogue: 0,0:50:27.28,0:50:32.12,Default 2,,0,0,0,,ألن يكون من الأفضل لك ألا\Nتستعيد ذاكرتها أبدًا؟
Dialogue: 0,0:50:32.12,0:50:33.09,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:50:33.09,0:50:37.86,Default 2,,0,0,0,,لن يكون هناك هاجس القلق لديك\Nبشأن معرفتها لهويتك الحقيقة
Dialogue: 0,0:50:37.86,0:50:40.70,Default 2,,0,0,0,,!ماذا قلتِ؟
Dialogue: 0,0:50:40.70,0:50:47.20,Default 2,,0,0,0,,لو كان باستطاعتي\N!فسأود أن أفقد ذاكرتي أيضًا
Dialogue: 0,0:50:47.20,0:50:49.70,Default 2,,0,0,0,,مقتل أختي
Dialogue: 0,0:50:49.70,0:50:53.97,Default 2,,0,0,0,,...وانضمامي إلى المنظمة وصناعة هذا العقار
Dialogue: 0,0:50:53.97,0:50:57.71,Default 2,,0,0,0,,لكم هو رائعٌ إذا نسيت كل شيءٍ\Nوأصبحت [هايبرا آي]
Dialogue: 0,0:50:57.71,0:51:01.22,Default 2,,0,0,0,,...فتاةٌ عاديةٌ بالمدرسة
Dialogue: 0,0:51:01.22,0:51:02.34,Default 2,,0,0,0,,...وعندها
Dialogue: 0,0:51:04.05,0:51:06.11,Default 2,,0,0,0,,...أنا وأنت
Dialogue: 0,0:51:09.32,0:51:11.73,Default 2,,0,0,0,,...يكون باستطاعتنا البقاء معًا دائمًا
Dialogue: 0,0:51:11.73,0:51:15.66,Thoughts,,0,0,0,,...[هايبرا]...أأنت
Dialogue: 0,0:51:15.66,0:51:19.03,Default 2,,0,0,0,,!لقد أوقعت بك\Nأتشعر بتحسن؟
Dialogue: 0,0:51:21.74,0:51:23.87,Default 2,,0,0,0,,!مرحبًا، يا أطفال
Dialogue: 0,0:51:23.87,0:51:25.87,Default 2,,0,0,0,,صديقتك الجديدة؟
Dialogue: 0,0:51:25.87,0:51:28.34,Thoughts,,0,0,0,,...وها قد جاءت المُزعجة الأخرى
Dialogue: 0,0:51:31.15,0:51:36.15,Default 2,,0,0,0,,انظري! تم التقاط هذه عندما\N!فزتِ ببطولة المدينة في الكاراتيه
Dialogue: 0,0:51:36.15,0:51:37.55,Default 2,,0,0,0,,أتتذكرين؟
Dialogue: 0,0:51:37.55,0:51:39.25,Default 2,,0,0,0,,لا
Dialogue: 0,0:51:41.52,0:51:43.26,Default 2,,0,0,0,,...إنه
Dialogue: 0,0:51:43.26,0:51:46.26,Default 2,,0,0,0,,!هذا [كودو]! إنه عاشقك
Dialogue: 0,0:51:46.26,0:51:48.69,Thoughts,,0,0,0,,!أنا لست عاشقها
Dialogue: 0,0:51:50.20,0:51:53.10,Default 2,,0,0,0,,يبدو أنها تميزه
Dialogue: 0,0:51:53.10,0:51:55.34,Default 2,,0,0,0,,!أحقًا يا [ران]؟
Dialogue: 0,0:51:55.34,0:51:57.41,Default 2,,0,0,0,,لا
Dialogue: 0,0:51:57.41,0:51:59.24,Default 2,,0,0,0,,...ولكن -\N!لكن؟ -
Dialogue: 0,0:51:59.24,0:52:03.68,Default 2,,0,0,0,,أشعر بحنينٍ عارم لسببٍ ما
Dialogue: 0,0:52:03.68,0:52:06.17,Default 2,,0,0,0,,لا أعرف لماذا على الرغم من ذلك
Dialogue: 0,0:52:09.08,0:52:11.92,Default 2,,0,0,0,,مهلًا! ألن تتذكر\Nإذا ما رأت [شينتشي]؟
Dialogue: 0,0:52:11.92,0:52:13.92,Default 2,,0,0,0,,!أجل! أحضروه إلى هنا
Dialogue: 0,0:52:13.92,0:52:17.26,Default 2,,0,0,0,,!كنت لأفعل لو كان باستطاعتي
Dialogue: 0,0:52:17.26,0:52:20.59,Default 2,,0,0,0,,إنه متحر المرحلة الثانوية الذي\Nيحل كل القضايا الصعبة
Dialogue: 0,0:52:20.59,0:52:22.43,Default 2,,0,0,0,,حول البلاد، أليس كذلك؟
Dialogue: 0,0:52:22.43,0:52:27.89,Default 2,,0,0,0,,لا أستطيع تصديقه! أين هو\N!بينما [ران] بتلك الحالة؟
Dialogue: 0,0:52:49.62,0:52:51.49,Default 2,,0,0,0,,نعم؟
Dialogue: 0,0:52:51.49,0:52:54.16,Default 2,,0,0,0,,[ران]، الحمام خالٍ الآن
Dialogue: 0,0:52:54.16,0:52:55.23,Default 2,,0,0,0,,شكرًا
Dialogue: 0,0:52:55.23,0:52:59.43,Default 2,,0,0,0,,أخبرني يا [كونان]\Nكيف هو [كودو شينتشي]؟
Dialogue: 0,0:52:59.43,0:53:01.60,Default 2,,0,0,0,,كيف هو؟
Dialogue: 0,0:53:01.60,0:53:06.17,Default 2,,0,0,0,,أعتقد أنه يفكر بك كثيرًا
Dialogue: 0,0:53:06.17,0:53:10.58,Default 2,,0,0,0,,ولكن ليس باستطاعته أن يأتي ويخبرك عن مشاعره
Dialogue: 0,0:53:12.95,0:53:16.44,Default 2,,0,0,0,,...أعتقد أني أود مقابلته
Dialogue: 0,0:53:18.35,0:53:21.19,Default 2,,0,0,0,,[ران]، أتريدين الذهاب إلى "غينزا" بالغد؟
Dialogue: 0,0:53:21.19,0:53:22.26,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:53:22.26,0:53:25.83,Default 2,,0,0,0,,!أتضايق بشدة عندما أكون مع هذا الرجل
Dialogue: 0,0:53:25.83,0:53:28.80,Default 2,,0,0,0,,لهذا فلنذهب ونتسوق\N!لنشعر بتحسن
Dialogue: 0,0:53:28.80,0:53:31.00,Default 2,,0,0,0,,!أنت أيضًا يا [كونان]
Dialogue: 0,0:53:31.00,0:53:32.43,Default 2,,0,0,0,,!أجل
Dialogue: 0,0:53:50.82,0:53:53.22,Default 2,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:53:53.22,0:53:57.29,DCFlashback,,0,0,0,,!آنسة [ساتو]! آنسة [ساتو]\N!أرجوكِ قولي شيئًا
Dialogue: 0,0:53:57.29,0:53:59.03,Default 2,,0,0,0,,!شكرًا لك
Dialogue: 0,0:54:01.03,0:54:02.89,Default 2,,0,0,0,,!اللعنة
Dialogue: 0,0:54:04.80,0:54:06.32,Default 2,,0,0,0,,ها قد وصل
Dialogue: 0,0:54:15.41,0:54:16.40,Default 2,,0,0,0,,![ران]
Dialogue: 0,0:54:19.75,0:54:20.81,Default 2,,0,0,0,,![ران]
Dialogue: 0,0:54:39.77,0:54:44.00,Default 2,,0,0,0,,![ران] -\Nصه! لقد أعطاها الطبيب مهدئًا للتو -
Dialogue: 0,0:54:44.00,0:54:45.87,Default 2,,0,0,0,,!هل [ران] بخير؟
Dialogue: 0,0:54:45.87,0:54:48.68,Default 2,,0,0,0,,بضع خدوشٍ فقط، لحسن الحظ
Dialogue: 0,0:54:48.68,0:54:56.08,Default 2,,0,0,0,,ولكني قلقٌ من أن يجعلها هذا\Nخائفة من استعادة ذاكرتها
Dialogue: 0,0:54:56.08,0:54:59.12,Default 2,,0,0,0,,![تاكاغي]\N!ماذا كنت تراقب؟
Dialogue: 0,0:54:59.12,0:55:00.29,Default 2,,0,0,0,,!أنا آسف
Dialogue: 0,0:55:00.29,0:55:03.36,Default 2,,0,0,0,,ولكننا نعلم الآن بالتأكيد
Dialogue: 0,0:55:03.36,0:55:10.20,Default 2,,0,0,0,,أن [ران] قد رأت وجه القاتل\Nعندما أطلق النار على الآنسة [ساتو]
Dialogue: 0,0:55:10.20,0:55:13.57,Default 2,,0,0,0,,!استمع إلي\N!مهما حدث، فعلينا الحفاظ على أمان [ران]
Dialogue: 0,0:55:13.57,0:55:14.37,Default 2,,0,0,0,,!علم
Dialogue: 0,0:55:14.37,0:55:18.77,Thoughts,,0,0,0,,ابقاؤها بأمانٍ ليس بكافٍ\N!علينا أن نهاجم أيضًا
Dialogue: 0,0:55:28.22,0:55:33.89,Thoughts,,0,0,0,,بعد حدوث الأمر، لم توجد\Nآثار بارود على أي شخص
Dialogue: 0,0:55:33.89,0:55:38.95,Thoughts,,0,0,0,,أمن المستحيل حقًا إطلاق النار بدون التعرض لآثار البارود؟
Dialogue: 0,0:55:40.43,0:55:41.83,Thoughts,,0,0,0,,!مهلًا
Dialogue: 0,0:55:43.80,0:55:46.50,Thoughts,,0,0,0,,...إذا كنت أتذكر جيدًا
Dialogue: 0,0:55:46.50,0:55:49.97,Thoughts,,0,0,0,,!تلك المظلة كانت مغلقةً وقتها
Dialogue: 0,0:55:49.97,0:55:52.41,Thoughts,,0,0,0,,...وبعد الحادث
Dialogue: 0,0:55:52.41,0:55:56.48,Thoughts,,0,0,0,,!لم تكن مغلقة ولكن أيضًا في مكان آخر...
Dialogue: 0,0:55:56.48,0:55:59.07,Thoughts,,0,0,0,,...وبعد أن غادرت [ران] المستشفى
Dialogue: 0,0:56:04.59,0:56:06.32,Thoughts,,0,0,0,,!أيعقل هذا؟
Dialogue: 0,0:56:06.32,0:56:09.16,Default 2,,0,0,0,,ماذا؟ تلك كانت مظلتك أيها الصغير؟
Dialogue: 0,0:56:09.16,0:56:11.26,Default 2,,0,0,0,,أتعرفين أين هي الآن؟
Dialogue: 0,0:56:11.26,0:56:14.93,Default 2,,0,0,0,,آسفة، ولكن كان بها ثقبٌ فرميتها
Dialogue: 0,0:56:14.93,0:56:16.43,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:56:16.43,0:56:20.60,Thoughts,,0,0,0,,...كان علي أن أعرف، بعد كل هذا الوقت
Dialogue: 0,0:56:20.60,0:56:25.44,Default 2,,0,0,0,,!أنا أمزح معك\N!فلقد حفظتها
Dialogue: 0,0:56:25.44,0:56:27.21,Thoughts,,0,0,0,,...يا إلهي
Dialogue: 0,0:56:27.21,0:56:28.64,Default 2,,0,0,0,,!شكرًا
Dialogue: 0,0:56:33.18,0:56:36.22,Thoughts,,0,0,0,,!تمامًا كما ظننت
Dialogue: 0,0:56:36.22,0:56:41.31,Thoughts,,0,0,0,,!وجدت طريقة إطلاق النار بدون التعرض لآثار البارود
Dialogue: 0,0:56:42.82,0:56:47.13,Thoughts,,0,0,0,,!إن الأمر ليس متعلقًا بـ[توموناري ماكوتو] و[جينو تاماكي] فقط الآن
Dialogue: 0,0:56:47.13,0:56:52.46,Thoughts,,0,0,0,,هذا يجعل جميع من بالحفل\N!حتى السيد [توشيا]، مشتبهًا فيهم
Dialogue: 0,0:57:03.64,0:57:04.80,Default 2,,0,0,0,,!هذا هو
Dialogue: 0,0:57:31.57,0:57:33.61,Default 2,,0,0,0,,!الآن فهمت
Dialogue: 0,0:57:33.61,0:57:39.57,Default 2,,0,0,0,,!الآنسة [تاماكي] كانت بالحفل تراقب [توشيا]
Dialogue: 0,0:57:44.05,0:57:48.11,Default 2,,0,0,0,,اللعنة! لم تتبعينني في كل مكانٍ\N!يومًا بعد يوم؟
Dialogue: 0,0:57:50.52,0:57:51.73,Default 2,,0,0,0,,أيضايقك ذلك؟
Dialogue: 0,0:57:51.73,0:57:52.93,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,0:57:52.93,0:57:55.93,Default 2,,0,0,0,,سأجد دليلًا أنك قد قتلته
Dialogue: 0,0:57:55.93,0:57:58.92,Default 2,,0,0,0,,في المكان الذي قتلت\N!به المحققين
Dialogue: 0,0:58:15.45,0:58:17.38,Default 2,,0,0,0,,أتحاولين اصطياده؟
Dialogue: 0,0:58:18.45,0:58:23.29,Default 2,,0,0,0,,أنت أخت السيد [جينو تاموتسو]\Nالسيدة [تاماكي]، أليس كذلك؟
Dialogue: 0,0:58:23.29,0:58:28.76,Default 2,,0,0,0,,لقد اكتشفتِ أنه هو من كان يتجادل\Nمع شقيقك منذ عامٍ مضى
Dialogue: 0,0:58:28.76,0:58:31.47,Default 2,,0,0,0,,وأنه لم يتم استجوابه
Dialogue: 0,0:58:31.47,0:58:34.63,Default 2,,0,0,0,,لأن والده هو مدير الشرطة أليس كذلك؟
Dialogue: 0,0:58:35.67,0:58:38.41,Default 2,,0,0,0,,من أنت أيها الفتى؟
Dialogue: 0,0:58:38.41,0:58:41.61,Default 2,,0,0,0,,[إيدوغاوا كونان] متحري
Dialogue: 0,0:58:41.61,0:58:43.58,Default 2,,0,0,0,,متحري؟
Dialogue: 0,0:58:43.58,0:58:46.91,Default 2,,0,0,0,,إذا ما كنت قد أحببت أخيكِ عن ظهر قلب
Dialogue: 0,0:58:46.91,0:58:51.59,Default 2,,0,0,0,,فلعلك قد حملتِ الضغينة ضد محققي الشرطة الثلاث
Dialogue: 0,0:58:51.59,0:58:55.52,Default 2,,0,0,0,,الذين أطلقوا على مقتل أخيكِ انتحارًا ولم يلقوا بالًا للأمر
Dialogue: 0,0:58:55.52,0:58:57.96,Default 2,,0,0,0,,!لقد كرهت أخي
Dialogue: 0,0:58:57.96,0:59:02.70,Default 2,,0,0,0,,أنا فقط أتحقق مما حدث\N!لأعرف الحقيقة
Dialogue: 0,0:59:02.70,0:59:07.60,Default 2,,0,0,0,,!إذًا فلنجازف ونداهم مقر وبيت العدو
Dialogue: 0,0:59:07.60,0:59:09.19,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,0:59:19.81,0:59:22.65,Thoughts,,0,0,0,,{\be1}...إنه مبارز
Dialogue: 0,0:59:28.32,0:59:30.31,Thoughts,,0,0,0,,!مدهش
Dialogue: 0,0:59:34.66,0:59:37.40,Default 2,,0,0,0,,الآنسة [جينو تاماكي] أليس كذلك؟
Dialogue: 0,0:59:37.40,0:59:41.00,Default 2,,0,0,0,,لدي شيءٌ لك
Dialogue: 0,0:59:41.00,0:59:42.64,Default 2,,0,0,0,,لي؟
Dialogue: 0,0:59:42.64,0:59:47.30,Default 2,,0,0,0,,وجدتها منذ شهرٍ في غرفة ابني [توشيا]
Dialogue: 0,0:59:48.48,0:59:51.14,Default 2,,0,0,0,,...ت.جينو
Dialogue: 0,0:59:51.14,0:59:52.48,Default 2,,0,0,0,,هذه تخص أخي؟
Dialogue: 0,0:59:52.48,0:59:53.75,Default 2,,0,0,0,,أجل
Dialogue: 0,0:59:53.75,0:59:58.75,Default 2,,0,0,0,,تذكرت الاسم لأنه كان في قضية\Nالمفتش [توموناري] الأخيرة
Dialogue: 0,0:59:58.75,1:00:03.26,Default 2,,0,0,0,,قبل أن يموت فجأةً بنوبةٍ قلبية\Nمنذ عامٍ مضى
Dialogue: 0,1:00:03.26,1:00:05.56,Default 2,,0,0,0,,عندما ضغطت على [توشيا] بشأنها
Dialogue: 0,1:00:05.56,1:00:09.36,Default 2,,0,0,0,,اعترف لي بأنه قد علم بأن [تاموتسو]\Nكان يتاجر في العقاقير في الخفاء
Dialogue: 0,1:00:09.36,1:00:13.67,Default 2,,0,0,0,,وأنه ابتزه من أجل المال
Dialogue: 0,1:00:13.67,1:00:19.71,Default 2,,0,0,0,,وعلى الرغم من ذلك، لم يكن [توشيا] بأيًا من ملفات التحقيق
Dialogue: 0,1:00:19.71,1:00:24.75,Default 2,,0,0,0,,لهذا أمرت المحقق [ناراساوا]\Nبأن يعيد التحقيق في القضية
Dialogue: 0,1:00:24.75,1:00:30.72,Default 2,,0,0,0,,{\be1}طلبت منهم أن يعيدوا التحقيق ضد ابنك؟
Dialogue: 0,1:00:30.72,1:00:35.96,Default 2,,0,0,0,,بعد مقتل المحقق [ناراساوا] تولى المفتش [ميغوري] الأمر
Dialogue: 0,1:00:35.96,1:00:40.73,Default 2,,0,0,0,,ولكن إذا كان المحقق [ناراساوا] قد بدأ في إعادة التحقيق من نفسه
Dialogue: 0,1:00:40.73,1:00:45.29,Default 2,,0,0,0,,فلعلك حاولت إبقاء ابنك خارج الصورة، أليس كذلك؟
Dialogue: 0,1:00:49.90,1:00:55.21,Default 2,,0,0,0,,بالتأكيد، وأيضًا لدي الدافع\Nلارتكاب جريمة قتل الثلاثة محققين
Dialogue: 0,1:00:55.21,1:00:58.75,Default 2,,0,0,0,,إذًا، فإذا كنت جادًا بشأن كشف الحقيقة
Dialogue: 0,1:00:58.75,1:01:00.75,Default 2,,0,0,0,,!فأطلعني على ملفات التحقيق
Dialogue: 0,1:01:00.75,1:01:02.92,Default 2,,0,0,0,,!لا أستطيع فعل ذلك
Dialogue: 0,1:01:02.92,1:01:08.05,Default 2,,0,0,0,,!كشف الحقيقة هو عملنا، نحن الشرطة
Dialogue: 0,1:01:10.22,1:01:12.66,Default 2 - Copy,,0,0,0,,!ولكنه من الجيد أنك لم تصابي بأي أذًى
Dialogue: 0,1:01:12.66,1:01:17.12,Default 2 - Copy,,0,0,0,,شكرًا لك، الطبيب قال بأنه يمكنني المغادرة الآن
Dialogue: 0,1:01:18.23,1:01:20.23,Default 2,,0,0,0,,أخبريني يا آنسة [سونوكو]
Dialogue: 0,1:01:20.23,1:01:23.34,Default 2,,0,0,0,,!توقفي عن ذلك\N!فقط [سونوكو]
Dialogue: 0,1:01:23.34,1:01:25.91,Default 2,,0,0,0,,أي نوعٍ من الأولاد هو [كونان]؟
Dialogue: 0,1:01:25.91,1:01:26.91,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,1:01:26.91,1:01:30.81,Default 2,,0,0,0,,...لقد خاطر بحياته لينقذني
Dialogue: 0,1:01:30.81,1:01:38.29,Default 2,,0,0,0,,أجل إنه غريب\Nإنه سريع البديهة بالنسبة لطفل
Dialogue: 0,1:01:38.29,1:01:42.99,Default 2,,0,0,0,,على الرغم من ذلك إذا ما سألتيني\N!فهو مجرد طفلٍ صغيرٍ عادي
Dialogue: 0,1:01:42.99,1:01:44.82,Default 2,,0,0,0,,فهمت
Dialogue: 0,1:01:46.86,1:01:51.33,Default 2,,0,0,0,,"جزيرة العصور القديمة الجامحة"\N"أحدث إضافةٍ لـ"تروبيكال لاند
Dialogue: 0,1:01:51.33,1:01:53.93,Default 2,,0,0,0,,!بالتأكيد ستثير العملاء
Dialogue: 0,1:01:53.93,1:01:57.27,Default 2,,0,0,0,,...أنا أعرف هذا المكان
Dialogue: 0,1:01:57.27,1:02:00.31,Default 2,,0,0,0,,تروبيكال لاند"؟"
Dialogue: 0,1:02:00.31,1:02:04.80,Default 2,,0,0,0,,!أجل! أنتِ و[شينتشي] ذهبتما إلى هناك سويًا
Dialogue: 0,1:02:07.21,1:02:08.65,Default 2,,0,0,0,,فهمت
Dialogue: 0,1:02:08.65,1:02:09.38,Default 2,,0,0,0,,فهمت
Dialogue: 0,1:02:09.38,1:02:12.35,Default 2,,0,0,0,,ذاكرتك على وشك العودة
Dialogue: 0,1:02:12.35,1:02:19.23,Default 2,,0,0,0,,"أيها الطبيب، إذا زارت "تروبيكال لاند\Nحقًا فهل ستستعيد ذاكرتها؟
Dialogue: 0,1:02:19.23,1:02:21.46,Default 2,,0,0,0,,أجل من الممكن
Dialogue: 0,1:02:21.46,1:02:24.80,Default 2,,0,0,0,,سأذهب إلى هناك غدًا -\Nماذا؟ -
Dialogue: 0,1:02:24.80,1:02:30.17,Default 2,,0,0,0,,!مهلًا! أنا ضد ذلك\Nفالقاتل قد يلاحقك مجددًا
Dialogue: 0,1:02:30.17,1:02:34.01,Default 2,,0,0,0,,وسيؤذيك ذلك إذا ما تذكرتِ الحادث
Dialogue: 0,1:02:34.01,1:02:38.85,Default 2,,0,0,0,,لأكون صريحةً، فأنا\Nنفسي خائفةٌ من تذكر الحادث
Dialogue: 0,1:02:38.85,1:02:41.85,Default 2,,0,0,0,,ولكن لا يمكنني البقاء هكذا
Dialogue: 0,1:02:41.85,1:02:45.85,Default 2,,0,0,0,,علي أن آخذ تلك الخطوة إلى الأمام
Dialogue: 0,1:02:45.85,1:02:47.25,Default 2,,0,0,0,,...[ران]
Dialogue: 0,1:02:47.25,1:02:50.66,Default 2,,0,0,0,,!إنك شجاعة بالتأكيد يا آنسة [ران]
Dialogue: 0,1:02:50.66,1:02:55.43,Default 2,,0,0,0,,بما يبدو ظاهرًا لي\N!"فأعتقد أنك ستكونين بخيرٍ إذا ما زرتِ "تروبيكال لاند
Dialogue: 0,1:02:55.43,1:02:58.73,Default 2,,0,0,0,,إذًا فعلى الأقل هل باستطاعتك الانتظار لبعد الغد؟
Dialogue: 0,1:02:58.73,1:03:00.43,Default 2,,0,0,0,,...لدي عملٌ بالغد ولا أستطيع
Dialogue: 0,1:03:00.43,1:03:02.94,Default 2,,0,0,0,,!توقفي عن القلق! سأذهب معها
Dialogue: 0,1:03:02.94,1:03:07.04,Default 2,,0,0,0,,!سأحمي [ران] وإن كلفني ذلك حياتي
Dialogue: 0,1:03:07.04,1:03:09.54,Default 2,,0,0,0,,...عزيزي
Dialogue: 0,1:03:09.54,1:03:11.58,Default 2,,0,0,0,,![ران]! أنا قادمةٌ أيضًا
Dialogue: 0,1:03:11.58,1:03:12.95,Default 2,,0,0,0,,!شكرًا
Dialogue: 0,1:03:12.95,1:03:16.38,Default 2,,0,0,0,,ولكن أبقوا الأمر سرًا عن [كونان]
Dialogue: 0,1:03:16.38,1:03:18.05,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,1:03:18.05,1:03:21.69,Default 2,,0,0,0,,أعتقد أنه بالتأكيد سيأتي إذا ما أخبرناه
Dialogue: 0,1:03:21.69,1:03:26.35,Default 2,,0,0,0,,ولا أريد تعريضه لمزيدٍ من الخطر
Dialogue: 0,1:03:27.86,1:03:29.59,Default 2,,0,0,0,,حسنًا
Dialogue: 0,1:03:34.03,1:03:37.07,Default 2,,0,0,0,,!لقد تأخر الوقت بسرعة -\Nأجل -
Dialogue: 0,1:03:37.07,1:03:38.27,Default 2,,0,0,0,,[كونان]
Dialogue: 0,1:03:38.27,1:03:41.88,Default 2,,0,0,0,,إذا أردت رؤية ملفات التحقيق فإن لدي نسخٌ منها
Dialogue: 0,1:03:41.88,1:03:42.91,Default 2,,0,0,0,,!حقًا؟
Dialogue: 0,1:03:42.91,1:03:45.28,Default 2,,0,0,0,,!أنا مراسلة تحقيقات
Dialogue: 0,1:03:45.28,1:03:47.81,Default 2,,0,0,0,,إنهم بشقتي\Nولهذا سأريك إياهم غدًا
Dialogue: 0,1:03:47.81,1:03:49.11,Default 2,,0,0,0,,!حسنًا
Dialogue: 0,1:03:54.72,1:03:56.31,Default 2,,0,0,0,,!سأعود لاحقًا
Dialogue: 0,1:04:00.89,1:04:03.50,Default 2,,0,0,0,,!ها هو قد ذهب\N!وهو لا يعلم شيئًا
Dialogue: 0,1:04:03.50,1:04:06.06,Default 2,,0,0,0,,!حسنًا! فلنذهب نحن أيضًا
Dialogue: 0,1:04:12.34,1:04:14.81,Default 2,,0,0,0,,!أجل! [ران] تغادر
Dialogue: 0,1:04:14.81,1:04:17.94,Default 2,,0,0,0,,!لقد أجدت مراقبتنا طوال اليوم بالنفع
Dialogue: 0,1:04:17.94,1:04:20.45,Default 2,,0,0,0,,هل تعتقدون أن [إيدوغاوا] لم يتم إطلاعه على الأمر؟
Dialogue: 0,1:04:20.45,1:04:24.12,Default 2,,0,0,0,,!لا مشكلة لي في ذلك\N!فهو دائمًا ما يسبقنا إلى فعل الأشياء
Dialogue: 0,1:04:24.12,1:04:27.92,Default 2,,0,0,0,,!استمعوا الآن! لا شيء خطير
Dialogue: 0,1:04:39.03,1:04:41.09,Default 2,,0,0,0,,!اتبع تلك السيارة أمامنا
Dialogue: 0,1:04:50.04,1:04:53.48,Default 2,,0,0,0,,إذًا؟ هل اكتشفت شيئًا أيها المحقق؟
Dialogue: 0,1:04:53.48,1:04:56.48,Default 2,,0,0,0,,دفتر الملاحظات الذي يحمله\N...المحقق [شيبا] ذاك
Dialogue: 0,1:04:56.48,1:04:58.55,Default 2,,0,0,0,,ماذا عنه؟
Dialogue: 0,1:04:58.55,1:05:00.95,Default 2,,0,0,0,,إذا كان قد أخرجه من جيب صدره
Dialogue: 0,1:05:00.95,1:05:04.99,Default 2,,0,0,0,,أليس من المفترض أن يكون مقلوبًا للجهة الأخرى؟
Dialogue: 0,1:05:04.99,1:05:09.00,Default 2,,0,0,0,,...إنه كذلك، وعندما تسحبه من الجيب\N!أنت محق
Dialogue: 0,1:05:09.00,1:05:14.73,Default 2,,0,0,0,,من المحتمل أن القاتل هو من أخرج الدفتر\N!وليس المحقق [شيبا]
Dialogue: 0,1:05:14.73,1:05:19.90,Default 2,,0,0,0,,!ماذا؟\Nفهمت، هذا ممكن
Dialogue: 0,1:05:21.64,1:05:23.34,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,1:05:23.34,1:05:24.98,Default 2,,0,0,0,,!سأجده
Dialogue: 0,1:05:24.98,1:05:28.38,Default 2,,0,0,0,,لقد ظننت أنكِ تستخدمين يدك اليمنى آنسة [تاماكي]؟
Dialogue: 0,1:05:28.38,1:05:34.02,Default 2,,0,0,0,,ماذا؟ أجل، فقد كنت في الأساس\Nعسراء ولكني تغيرت لاستخدام يدي اليمنى
Dialogue: 0,1:05:34.02,1:05:37.16,Default 2,,0,0,0,,لهذا عندما أفكر أو أدخن أو شيءٍ من هذا القبيل
Dialogue: 0,1:05:37.16,1:05:40.39,Default 2,,0,0,0,,فأحنّ إلى طبيعتي وأستخدم يدي اليسرى بلا وعي
Dialogue: 0,1:05:40.39,1:05:42.70,Thoughts,,0,0,0,,دون أن تعي؟
Dialogue: 0,1:05:42.70,1:05:45.10,Thoughts,,0,0,0,,...بالتفكير في الأمر، عندما كنا
Dialogue: 0,1:05:46.33,1:05:49.33,Thoughts,,0,0,0,,...مهلًا! هل هذا يعني أن
Dialogue: 0,1:05:52.91,1:05:54.40,Thoughts,,0,0,0,,!أيمكن هذا؟
Dialogue: 0,1:05:55.41,1:05:58.04,Thoughts,,0,0,0,,!أهذا ما كان يعنيه بالأمر؟
Dialogue: 0,1:05:59.05,1:06:03.12,Default 2,,0,0,0,,أخبريني، أخاكِ كان يعمل\Nبمستشفى جامعة "توتو"، أليس كذلك؟
Dialogue: 0,1:06:03.12,1:06:08.09,Default 2,,0,0,0,,أجل، ولكني آسفة يا [كونان]\Nفعلي التواجد بمكان ما الآن
Dialogue: 0,1:06:08.09,1:06:10.08,Default 2,,0,0,0,,هذا كل ما أستطيع تقديمه اليوم -\Nماذا؟ -
Dialogue: 0,1:06:17.10,1:06:19.60,Default 2,,0,0,0,,!وداعًا يا [كونان]
Dialogue: 0,1:06:19.60,1:06:20.80,Default 2,,0,0,0,,"تروبيكال لاند"
Dialogue: 0,1:06:20.80,1:06:22.13,Default 2,,0,0,0,,!بالطبع
Dialogue: 0,1:06:41.96,1:06:44.72,Default 2,,0,0,0,,...أتذكر هذا المكان
Dialogue: 0,1:06:44.72,1:06:48.06,Default 2,,0,0,0,,حسب ما أتذكر، عندما أتى[شينتشي] إلى هنا معك
Dialogue: 0,1:06:48.06,1:06:51.63,Default 2,,0,0,0,,قام بحل جريمة قتلٍ قد حدثت على الأفعوانية
Dialogue: 0,1:06:51.63,1:06:54.33,Default 2,,0,0,0,,!إذًا فلنركبها
Dialogue: 0,1:06:54.33,1:06:56.80,Default 2,,0,0,0,,!قد تتذكرين بعض الأشياء الأخرى
Dialogue: 0,1:06:56.80,1:06:58.07,Default 2,,0,0,0,,...فلنر
Dialogue: 0,1:06:58.07,1:07:03.81,Default 2,,0,0,0,,قطار الأفعوانية تقع في جزيرة الغموض والخيال
Dialogue: 0,1:07:07.25,1:07:09.34,Default 2,,0,0,0,,أنتما الاثنتان خذا المقعد الأمامي
Dialogue: 0,1:07:15.92,1:07:20.63,Default 2,,0,0,0,,إذا هل لاحظتِ؟\N!أراد [كونان دويل] بالتأكيد قول ذلك
Dialogue: 0,1:07:20.63,1:07:21.62,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,1:07:23.10,1:07:25.12,Default 2,,0,0,0,,!لا، لا شيء
Dialogue: 0,1:07:34.01,1:07:36.14,Default 2,,0,0,0,,!ها هي الآنسة [ران] والآخرين
Dialogue: 0,1:07:36.14,1:07:38.18,Default 2,,0,0,0,,!هذا ممل\N...أريد ركوبها
Dialogue: 0,1:07:38.18,1:07:40.21,Default 2,,0,0,0,,!عم تتحدث أنت؟
Dialogue: 0,1:07:40.21,1:07:44.72,Default 2,,0,0,0,,علينا استغلال ذلك الوقت في البحث\N!عن أي شخصٍ مشبوه
Dialogue: 0,1:07:44.72,1:07:46.95,Default 2,,0,0,0,,!فلننطلق -\N!حسنًا -
Dialogue: 0,1:07:48.86,1:07:53.46,Default 2,,0,0,0,,ألم يكن [موري] يخاف المرتفعات؟
Dialogue: 0,1:07:53.46,1:07:57.73,Default 2,,0,0,0,,!اللعنة\N!محال
Dialogue: 0,1:08:10.68,1:08:13.08,Default 2,,0,0,0,,هل أنت بخير؟
Dialogue: 0,1:08:13.08,1:08:15.48,Default 2,,0,0,0,,[ران]! هل تريدين الكولا؟ -\N!بالطبع -
Dialogue: 0,1:08:17.22,1:08:20.39,Default 2,,0,0,0,,!"مرحى! بالونات "تروبي
Dialogue: 0,1:08:20.39,1:08:24.35,Default 2,,0,0,0,,يا إلهي! من صنع ذلك\N!الشيء الغبي على أي حال؟
Dialogue: 0,1:08:30.10,1:08:32.22,Default 2,,0,0,0,,!هاكِ\N!لابد أنك ظمآنة
Dialogue: 0,1:08:34.83,1:08:36.27,Default 2,,0,0,0,,!تفضلي الكولا
Dialogue: 0,1:08:36.27,1:08:38.26,Default 2,,0,0,0,,!شكرًا
Dialogue: 0,1:08:41.94,1:08:45.55,Thoughts,,0,0,0,,أنت هو [كودو شينتشي]؟
Dialogue: 0,1:08:45.55,1:08:50.68,Thoughts,,0,0,0,,ولكني...مازلت لا أستطيع تذكر من أنت
Dialogue: 0,1:08:56.39,1:08:58.43,Default 2,,0,0,0,,...سيد [موري]
Dialogue: 0,1:08:58.43,1:09:01.42,Default 2,,0,0,0,,علي الذهاب إلى الحمام -\Nأجل -
Dialogue: 0,1:09:05.20,1:09:07.46,Default 2,,0,0,0,,!مرحى! شكرًا لك
Dialogue: 0,1:09:10.60,1:09:13.13,Default 2,,0,0,0,,!البالونات تطير بعيدًا
Dialogue: 0,1:09:27.82,1:09:29.62,Default 2,,0,0,0,,!آنسة [ران]\N!احترسي
Dialogue: 0,1:09:30.62,1:09:31.96,Default 2,,0,0,0,,!توقف
Dialogue: 0,1:09:31.96,1:09:34.05,Default 2,,0,0,0,,!مهلًا، أيها الأطفال\N!توقفوا
Dialogue: 0,1:09:35.76,1:09:38.16,Default 2,,0,0,0,,!لن أدعك تهرب
Dialogue: 0,1:09:38.16,1:09:39.15,Default 2,,0,0,0,,!يا إلهي
Dialogue: 0,1:09:43.00,1:09:46.23,Default 2,,0,0,0,,!خذ هذا! مسدس الصوص الحار
Dialogue: 0,1:09:56.95,1:10:00.19,Default 2,,0,0,0,,!أنت [توموناري ماكوتو]
Dialogue: 0,1:10:00.19,1:10:01.79,Default 2,,0,0,0,,!ما هذا؟
Dialogue: 0,1:10:01.79,1:10:03.26,Default 2,,0,0,0,,!سكين
Dialogue: 0,1:10:03.26,1:10:05.02,Default 2,,0,0,0,,...هذا
Dialogue: 0,1:10:05.02,1:10:09.63,Default 2,,0,0,0,,![توموناري ماكوتو]\N!أنت رهن الاعتقال بالشروع في القتل
Dialogue: 0,1:10:09.63,1:10:12.30,Default 2,,0,0,0,,!لقد فعلناها
Dialogue: 0,1:10:12.30,1:10:18.27,Default 2,,0,0,0,,"...فريق حماية الآنسة [ران]"\N!قد انتصر
Dialogue: 0,1:10:18.27,1:10:21.54,Default 2,,0,0,0,,!سيد [موري]\N!سوف آخذه مباشرةً إلى المركز الآن
Dialogue: 0,1:10:21.54,1:10:24.01,Default 2,,0,0,0,,مهلًا أنا قادمٌ معك
Dialogue: 0,1:10:25.38,1:10:29.18,Default 2,,0,0,0,,!مرحى -\N!لقد فعلناها -
Dialogue: 0,1:10:29.18,1:10:31.52,Default 2,,0,0,0,,لا داعِ للقلق من التعرض للهجوم الآن
Dialogue: 0,1:10:31.52,1:10:35.65,Default 2,,0,0,0,,وسيكون من الأسهل لك\Nأن تتذكري [شينتشي] بغير وجودي هنا
Dialogue: 0,1:10:36.89,1:10:39.89,Default 2,,0,0,0,,...أبي
Dialogue: 0,1:10:39.89,1:10:45.13,Default 2,,0,0,0,,لا بأس، تستطيعين أن تناديني بذلك\Nعندما تتذكرين كل شيء
Dialogue: 0,1:10:47.67,1:10:52.66,Default 2,,0,0,0,,!فرقة المتحرين الصغار قد أنقذها\N!كان هذا عملًا رائعًا
Dialogue: 0,1:10:55.31,1:10:58.24,Default 2,,0,0,0,,...لقد قال أن هذا كان عملًا رائعًا
Dialogue: 0,1:10:58.24,1:11:02.88,Default 2,,0,0,0,,...متحرٍ عظيم -\N!قد مدحنا... -
Dialogue: 0,1:11:02.88,1:11:05.39,Default 2,,0,0,0,,حسنًا! والآن نستطيع أن نحظى\N!بأي قدرٍ نريده من المرح
Dialogue: 0,1:11:05.39,1:11:07.25,Default 2,,0,0,0,,!أريد رؤية العرض
Dialogue: 0,1:11:07.25,1:11:10.06,Default 2,,0,0,0,,!نستطيع البقاء حتى الليل أليس كذلك يا بروفيسور
Dialogue: 0,1:11:10.06,1:11:15.23,Default 2,,0,0,0,,أجل، ففي النهاية قد بقيت [ران] و[شينتشي] حتى الليل أيضًا
Dialogue: 0,1:11:15.23,1:11:18.23,Default 2,,0,0,0,,!مرحى
Dialogue: 0,1:11:18.23,1:11:21.33,Thoughts,,0,0,0,,هل انتهى الأمر حقًا؟
Dialogue: 0,1:11:21.33,1:11:26.33,Default 2,,0,0,0,,يا [ران]! فلنذهب إلى مختبر\N!الشيطان! سيكون الأمر ممتعًا
Dialogue: 0,1:11:35.78,1:11:41.22,Default 2 - Copy,,0,0,0,,!ماذا؟! أنت مساعد المتحري الشهير [موري كوغورو]، أيها الصغير؟
Dialogue: 0,1:11:41.22,1:11:42.36,Default 2,,0,0,0,,!أجل
Dialogue: 0,1:11:42.36,1:11:46.56,Default 2,,0,0,0,,إذا ما ساعدتك، فهل تعتقد أن\N!باستطاعتي الحصول على توقيع السيد [موري]؟
Dialogue: 0,1:11:46.56,1:11:47.93,Default 2,,0,0,0,,!أجل، وأنا أيضًا
Dialogue: 0,1:11:47.93,1:11:49.23,Default 2,,0,0,0,,!بالطبع
Dialogue: 0,1:11:49.23,1:11:53.40,Thoughts,,0,0,0,,يمكنني إعطاءكم الكم الذي تريدون\N!من توقيعات ذلك العجوز
Dialogue: 0,1:11:53.40,1:11:55.40,Default 2,,0,0,0,,بروفيسور [جينو]، أليس كذلك؟
Dialogue: 0,1:11:55.40,1:11:58.91,Default 2,,0,0,0,,أعرف أنه ليس من اللطيف قول ذلك\Nولكنه كان طبيبًا غريب الأطوار
Dialogue: 0,1:11:58.91,1:12:03.21,Default 2,,0,0,0,,هذا مؤكد! فقد كان بخيلًا\N!ولم يكن يمتلك أي مهارة
Dialogue: 0,1:12:03.21,1:12:06.21,Default 2,,0,0,0,,وقد سبب الكثير من المشاكل\N!بسبب جراحاته الفاشلة
Dialogue: 0,1:12:06.21,1:12:10.48,Default 2,,0,0,0,,أتذكرين مريض القلب الذي جلبوه إلى هنا؟
Dialogue: 0,1:12:10.48,1:12:14.49,Default 2,,0,0,0,,!جرح الدكتور [جينو] يد الجراح الآخر خلال العملية
Dialogue: 0,1:12:14.49,1:12:20.49,Default 2,,0,0,0,,!أجل! أجل! ولهذا لم يتم إنقاذ المريض
Dialogue: 0,1:12:20.49,1:12:22.83,Default 2,,0,0,0,,!أخبريني أكثر عن ذلك
Dialogue: 0,1:12:31.34,1:12:34.07,Thoughts,,0,0,0,,!تمامًا كما توقعت
Dialogue: 0,1:12:34.07,1:12:36.06,Thoughts,,0,0,0,,!علي أن أخبر عمي حالًا
Dialogue: 0,1:12:42.42,1:12:45.15,Another,,0,0,0,,مرحبًا، هنا وكالة موري للتحريات
Dialogue: 0,1:12:45.15,1:12:49.26,Another,,0,0,0,,المتحرِ العظيم [موري كوغورو]\N...مشغولٌ حاليًا، يحل
Dialogue: 0,1:12:49.26,1:12:50.45,Thoughts,,0,0,0,,!اللعنة
Dialogue: 0,1:12:53.49,1:12:55.03,Default 2,,0,0,0,,مكتب [كيساكي] للمحاماة
Dialogue: 0,1:12:55.03,1:12:57.46,Default 2,,0,0,0,,![كونان] يتكلم -\N[كونان]؟ -
Dialogue: 0,1:12:57.46,1:12:59.37,Default 2,,0,0,0,,!هل السيدة [كيساكي] موجودة؟
Dialogue: 0,1:12:59.37,1:13:04.27,Default 2 - Copy,,0,0,0,,انتهت مرافعتها منذ قليل\N"واتجهت إلى "تروبيكال لاند
Dialogue: 0,1:13:04.27,1:13:06.61,Default 2,,0,0,0,,تروبيكال لاند"؟"
Dialogue: 0,1:13:06.61,1:13:08.94,Default 2,,0,0,0,,...على ما يبدو آنسة [ران] هناك، لهذا
Dialogue: 0,1:13:08.94,1:13:10.27,Default 2,,0,0,0,,!لا
Dialogue: 0,1:13:54.02,1:13:57.42,Default 2,,0,0,0,,حسنًا؟ هل أنت قادرٌ على الكلام الآن؟
Dialogue: 0,1:13:57.42,1:14:00.66,Default 2,,0,0,0,,لقد تلقيت اتصالًا من رجل
Dialogue: 0,1:14:00.66,1:14:03.50,Default 2,,0,0,0,,أخبرني فيه أنه سيخبرني الحقيقة\Nوراء موت والدي
Dialogue: 0,1:14:03.50,1:14:06.87,Default 2,,0,0,0,,"لذا ذهبت إلى التقاطع في "بيكا
Dialogue: 0,1:14:06.87,1:14:09.54,Default 2,,0,0,0,,ولكن الرجل لم يأت
Dialogue: 0,1:14:09.54,1:14:13.04,Default 2,,0,0,0,,!وقُتل المحقق [ناراساوا] بالقرب من ذلك المكان
Dialogue: 0,1:14:13.04,1:14:17.61,Default 2,,0,0,0,,عندما عدت إلى المنزل\Nاتصل الرجل مجددًا
Dialogue: 0,1:14:17.61,1:14:21.91,Default 2,,0,0,0,,هذه المرة أخبرني بأن آتي\N"إلى شقق حديقة "ميدوريداي ماسون
Dialogue: 0,1:14:21.91,1:14:25.08,Default 2,,0,0,0,,ولكن مجددًا لم يظهر أبدًا
Dialogue: 0,1:14:25.08,1:14:30.92,Default 2,,0,0,0,,ووُجد المحقق [شيبا] في ساحة الانتظار بالقبو\Nمقتولًا بالرصاص
Dialogue: 0,1:14:30.92,1:14:34.72,Default 2,,0,0,0,,!عندها أدركت أن القاتل كان يوقع بي
Dialogue: 0,1:14:36.56,1:14:40.13,Default 2,,0,0,0,,تلك الليلة قضيتها في فندق عمل
Dialogue: 0,1:14:40.13,1:14:43.37,Default 2,,0,0,0,,وفي اليوم التالي حين تفقدت\Nرسائل هاتفي
Dialogue: 0,1:14:43.37,1:14:45.64,Default 2,,0,0,0,,امرأة تدعو نفسها المحققة [ساتو]
Dialogue: 0,1:14:45.64,1:14:50.14,Default 2,,0,0,0,,"كانت قد تركت رسالة تخبرني فيها بأن آتي إلى فندق "بيكا صان بلازا
Dialogue: 0,1:14:50.14,1:14:53.55,Default 2,,0,0,0,,قالت أنها ستعتقلني بتهمة القتل إذا لم آتِ
Dialogue: 0,1:14:53.55,1:14:58.32,Default 2,,0,0,0,,ولكن عندما ذهبت، وجدت المكان يعج برجال الشرطة
Dialogue: 0,1:14:58.32,1:15:01.31,Default 2,,0,0,0,,لهذا رحلت، كأنني أهرب
Dialogue: 0,1:15:04.09,1:15:07.39,Default 2,,0,0,0,,...ولكن حينها، المحققة [ساتو] قد
Dialogue: 0,1:15:07.39,1:15:11.30,Default 2,,0,0,0,,لم لم تخبر الشرطة في الحال؟
Dialogue: 0,1:15:11.30,1:15:15.56,Default 2,,0,0,0,,لأني لم أكن أستطيع الثقة بهم\N!بعد كل ما حدث لأبي
Dialogue: 0,1:15:17.57,1:15:23.51,Default 2,,0,0,0,,وقد قررت أن أطلب مساعدة المتحري\Nالشهير السيد [موري] لهذا كنت أحوم حوله
Dialogue: 0,1:15:23.51,1:15:27.95,Default 2,,0,0,0,,!أتقول أنك لم تكن تقترب من الآنسة [ران] في "تروبيكال لاند"؟
Dialogue: 0,1:15:27.95,1:15:32.12,Default 2,,0,0,0,,...هذا صحيح\N...لقد كنت أنوي التحدث مع السيد [موري]
Dialogue: 0,1:15:32.12,1:15:34.65,Default 2,,0,0,0,,!تمهل، الآن\N!ولكن كان بحوزتك سكين
Dialogue: 0,1:15:34.65,1:15:40.13,Default 2,,0,0,0,,للحماية\N...فالقاتل قد يحاول قتلي
Dialogue: 0,1:15:40.13,1:15:41.96,Default 2,,0,0,0,,...تمهل الآن
Dialogue: 0,1:15:41.96,1:15:46.13,Default 2,,0,0,0,,!إذًا فالقاتل شخصٌ آخر؟
Dialogue: 0,1:15:46.13,1:15:49.70,Default 2,,0,0,0,,!وله شريكةٌ أنثى
Dialogue: 0,1:15:49.70,1:15:52.43,Thoughts,,0,0,0,,![ران].. احذري
Dialogue: 0,1:16:30.81,1:16:33.01,Default 2,,0,0,0,,!أجل! يجب أن يأخذني ذلك إلى هناك
Dialogue: 0,1:16:34.58,1:16:37.05,Default 2,,0,0,0,,!هل المرصد خالٍ؟
Dialogue: 0,1:16:37.05,1:16:40.25,Default 2,,0,0,0,,!أجل! فالجميع يشاهدون العرض
Dialogue: 0,1:16:40.25,1:16:41.38,Default 2,,0,0,0,,!شكرًا
Dialogue: 0,1:16:43.06,1:16:46.25,Default 2,,0,0,0,,!أهلًا بك في متاهة الجليد والضباب
Dialogue: 0,1:16:51.70,1:16:54.26,Thoughts,,0,0,0,,[ران]! أين؟\N!أين أنت؟
Dialogue: 0,1:16:59.67,1:17:02.68,Thoughts,,0,0,0,,![غينتا] والآخرون؟\N!لم أعلم أنهم قادمين أيضًا
Dialogue: 0,1:17:02.68,1:17:05.61,Thoughts,,0,0,0,,!مما يعني أن [ران] قريبة
Dialogue: 0,1:17:05.61,1:17:06.67,Thoughts,,0,0,0,,!هذا هو
Dialogue: 0,1:17:07.75,1:17:09.08,Thoughts,,0,0,0,,![ران]
Dialogue: 0,1:17:09.08,1:17:11.58,Thoughts,,0,0,0,,!أجل! شارات المتحرين
Dialogue: 0,1:17:11.58,1:17:13.45,Default 2,,0,0,0,,![غينتا]! [ميتسوهيكو]! [أيومي]
Dialogue: 0,1:17:13.45,1:17:15.96,Another,,0,0,0,,!هل تسمعونني؟\N!استجيبوا
Dialogue: 0,1:17:15.96,1:17:17.96,Default 2,,0,0,0,,[كونان]؟\N!أسمعك
Dialogue: 0,1:17:17.96,1:17:20.69,Default 2,,0,0,0,,!خمن أين نحن
Dialogue: 0,1:17:20.69,1:17:23.73,Default 2,,0,0,0,,!لا تنصدم الآن\N!"تروبيكال لاند"
Dialogue: 0,1:17:23.73,1:17:26.80,Default 2,,0,0,0,,!على مهلكم\N!استرخوا وأنصتوا جيدًا
Dialogue: 0,1:17:26.80,1:17:29.24,Default 2,,0,0,0,,!القاتل هناك ومعه سلاحٌ ليقتل [ران]
Dialogue: 0,1:17:29.24,1:17:30.80,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:17:30.80,1:17:35.81,Another,,0,0,0,,أخبروا [ران] أن تذهب إلى المناطق المزدحمة\N!"وتخرج من "تروبيكال لاند
Dialogue: 0,1:17:35.81,1:17:37.90,Default 2,,0,0,0,,!هل تسمعونني؟
Dialogue: 0,1:17:39.95,1:17:43.22,Default 2,,0,0,0,,!آنسة [ران]! اهربي -\N!هناك سلاحٌ موجهٌ إليك -
Dialogue: 0,1:17:43.22,1:17:45.48,Default 2,,0,0,0,,!احترسي
Dialogue: 0,1:17:45.48,1:17:46.89,Default 2,,0,0,0,,!بروفيسور
Dialogue: 0,1:17:46.89,1:17:50.62,Thoughts,,0,0,0,,...الناس من حولي في خطرٍ بسببي
Dialogue: 0,1:17:50.62,1:17:55.73,Default 2,,0,0,0,,!لا ترحلي يا [ران]\N!فالقاتل يريدك أن تكوني وحدك
Dialogue: 0,1:17:55.73,1:17:58.73,Default 2,,0,0,0,,![ران]! [ران]
Dialogue: 0,1:17:58.73,1:17:59.93,Thoughts,,0,0,0,,!اللعنة
Dialogue: 0,1:18:02.84,1:18:05.84,Thoughts,,0,0,0,,![ران] في جزيرة الأحلام والروايات وهو المكان المجاور لهنا
Dialogue: 0,1:18:05.84,1:18:07.67,Thoughts,,0,0,0,,...الطريقة الوحيدة لأصل إلى هناك
Dialogue: 0,1:18:09.74,1:18:11.14,Default 2,,0,0,0,,!المجموعة القادمةُ من فضلكم
Dialogue: 0,1:18:11.14,1:18:12.77,Default 2,,0,0,0,,!أنت\N!أيها الصغير
Dialogue: 0,1:18:26.83,1:18:27.99,Thoughts,,0,0,0,,!ها هي
Dialogue: 0,1:19:00.63,1:19:01.96,Default 2,,0,0,0,,![كونان]
Dialogue: 0,1:19:01.96,1:19:04.36,Default 2,,0,0,0,,!أنتِ بأمانٍ الآن يا [ران]
Dialogue: 0,1:19:04.36,1:19:06.63,Default 2,,0,0,0,,!لنندمج مع الزحام و نخرج من هنا
Dialogue: 0,1:19:08.47,1:19:09.40,Default 2,,0,0,0,,!من هنا
Dialogue: 0,1:19:11.67,1:19:12.64,Thoughts,,0,0,0,,!اللعنة
Dialogue: 0,1:19:12.64,1:19:15.90,Thoughts,,0,0,0,,إذًا فلا يهم ما يحدث لأي\N!شخصٍ طالما كانت [ران] ستموت في النهاية
Dialogue: 0,1:19:23.02,1:19:26.09,Default 2,,0,0,0,,!ساعدنا! هناك شخصٌ مختل
Dialogue: 0,1:19:26.09,1:19:27.99,Default 2,,0,0,0,,!اقفزي إلى المركب -\Nماذا؟ -
Dialogue: 0,1:19:30.99,1:19:32.48,Default 2,,0,0,0,,!يا هذا
Dialogue: 0,1:19:43.10,1:19:46.67,Default 2,,0,0,0,,!أين تعلمت قيادة المركب يا [كونان]؟
Dialogue: 0,1:19:46.67,1:19:48.87,Default 2,,0,0,0,,!أبي قد علمني في هاواي
Dialogue: 0,1:19:48.87,1:19:50.00,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,1:19:54.25,1:19:57.45,Default 2,,0,0,0,,نحنٌ بأمانٍ الآن، أليس كذلك؟
Dialogue: 0,1:19:57.45,1:19:58.68,Default 2,,0,0,0,,!لا
Dialogue: 0,1:20:11.80,1:20:13.06,Default 2,,0,0,0,,!الكولا خاصتي
Dialogue: 0,1:20:14.80,1:20:15.86,Thoughts,,0,0,0,,!كولا؟
Dialogue: 0,1:20:25.08,1:20:27.27,Thoughts,,0,0,0,,!عشرون دقيقة حتى التاسعة
Dialogue: 0,1:20:34.72,1:20:36.62,Default 2,,0,0,0,,![كونان]\N!شلال
Dialogue: 0,1:20:36.62,1:20:38.06,Default 2,,0,0,0,,!تمسكي
Dialogue: 0,1:20:59.01,1:21:00.17,Default 2,,0,0,0,,!فلنسرع
Dialogue: 0,1:21:10.82,1:21:13.16,Default 2,,0,0,0,,!تبقى القليل! تماسكِ
Dialogue: 0,1:21:13.16,1:21:14.79,Default 2,,0,0,0,,...أجل
Dialogue: 0,1:21:15.93,1:21:18.93,Default 2,,0,0,0,,!اللعنة! لقد لحق بنا بالفعل
Dialogue: 0,1:21:18.93,1:21:22.99,Default 2,,0,0,0,,تسلقي إلى الأعلى\N!واستتري خلف الصخور! أسرعي
Dialogue: 0,1:21:35.78,1:21:38.05,Default 2,,0,0,0,,![كونان]؟
Dialogue: 0,1:21:38.05,1:21:44.18,Default 2,,0,0,0,,لا أحد هنا، هذا المكان مغلقٌ\Nبالليل، يمكنك إظهار نفسك
Dialogue: 0,1:21:45.96,1:21:48.79,Default 2,,0,0,0,,أنت حذرٌ جدًا
Dialogue: 0,1:21:48.79,1:21:51.36,Default 2,,0,0,0,,...ولكن لا فائدة من الاختباء
Dialogue: 0,1:21:51.36,1:21:56.34,Default 2,,0,0,0,,لأني عرفت معنى رسالة المحقق [ناراساوا] الحقيقية
Dialogue: 0,1:21:56.34,1:22:01.07,Default 2,,0,0,0,,لم يمسك بالجانب الأيسر من صدره ليشير إلى\N!دفتر ملاحظاته الشرطية
Dialogue: 0,1:22:01.07,1:22:02.63,Default 2,,0,0,0,,!لقد كان يشير إلى قلبه
Dialogue: 0,1:22:04.08,1:22:09.01,Default 2,,0,0,0,,"أحد حروف الكلمة اليابانية "الطب النفسي\N!"هي "قلب
Dialogue: 0,1:22:09.01,1:22:12.97,Default 2,,0,0,0,,أليس كذلك، دكتور [كازاتو كايوسكوي]؟
Dialogue: 0,1:22:24.16,1:22:26.50,Default 2,,0,0,0,,متى اكتشفت أنه كان أنا؟
Dialogue: 0,1:22:26.50,1:22:32.20,Default 2,,0,0,0,,أول مرةٍ أظن كانت عندما تذكرت الهاتف
Dialogue: 0,1:22:32.20,1:22:36.88,Default 2,,0,0,0,,أولًا، مستخدمي اليد اليمنى لا يتصلون بيدهم اليسرى
Dialogue: 0,1:22:36.88,1:22:40.35,Default 2,,0,0,0,,أجل، لقد كنت أعسرًا
Dialogue: 0,1:22:40.35,1:22:43.12,Default 2,,0,0,0,,فهمت، كان ذلك إهمالًا مني
Dialogue: 0,1:22:43.12,1:22:51.02,Default 2,,0,0,0,,منذ سبع سنوات، كنت أفضل جراحٍ\N"شاب في مستشفى جامعة "توتو
Dialogue: 0,1:22:51.02,1:22:55.76,Default 2,,0,0,0,,ولكن يومًا ما، بينما كنت تجري عمليةً\Nأنت والسيد [جينو]
Dialogue: 0,1:22:55.76,1:22:59.96,Default 2,,0,0,0,,جرح معصمك الأيسر عرضًا\Nبمشرطه
Dialogue: 0,1:23:03.64,1:23:09.71,Default 2,,0,0,0,,بسبب تلك الحادثة، يدك التى كانت\Nتسمى "اليد الذهبية" قد دُمرت
Dialogue: 0,1:23:09.71,1:23:12.81,Default 2,,0,0,0,,وبسبب كبريائك، تركت المشرط
Dialogue: 0,1:23:12.81,1:23:16.58,Default 2,,0,0,0,,وتحولت من الجراحة إلى الطب النفسي
Dialogue: 0,1:23:16.58,1:23:22.59,Default 2,,0,0,0,,منذ ذلك الحين، ولعله بدافع الكبرياء عشت مستخدمًا يدك اليمنى
Dialogue: 0,1:23:22.59,1:23:24.09,Default 2,,0,0,0,,بالضبط
Dialogue: 0,1:23:24.09,1:23:28.39,Default 2,,0,0,0,,لم أتخيل قط أن\Nاستخدام الهاتف قد يوقع بي
Dialogue: 0,1:23:28.39,1:23:32.67,Default 2,,0,0,0,,تحولت إلى مستشفى "بيكا" المركزي كطبيبٍ نفسي
Dialogue: 0,1:23:32.67,1:23:36.07,Default 2,,0,0,0,,وحدث بينك وبين السيد [جينو] شيءٌ ما منذ عامٍ مضى
Dialogue: 0,1:23:36.07,1:23:40.44,Default 2,,0,0,0,,!قابلته مجددًا، بمحض الصدفة
Dialogue: 0,1:23:40.44,1:23:43.81,Default 2,,0,0,0,,دعاني لتناول الشراب في بيته
Dialogue: 0,1:23:43.81,1:23:48.85,Default 2,,0,0,0,,وكوني ثملًا، فقد أطلقت العنان لشكوكي التى خبأتها في قلبي لست سنوات
Dialogue: 0,1:23:48.85,1:23:51.28,Default 2,,0,0,0,,سألته إذا ما كان الحادث كان مقصودًا
Dialogue: 0,1:23:55.29,1:23:58.35,DCFlashback,,0,0,0,,"دومًا ما تجعلني أظهر بمظهرٍ سيئ"
Dialogue: 0,1:24:00.16,1:24:02.86,Default 2,,0,0,0,,!كانت مقصودةً في النهاية
Dialogue: 0,1:24:02.86,1:24:07.10,Default 2,,0,0,0,,!عندها نشأت رغبتي في القتل
Dialogue: 0,1:24:07.10,1:24:10.44,Default 2,,0,0,0,,كان يتم محاكمته\Nمن أجل عمليةٍ فاشلة في ذلك الوقت
Dialogue: 0,1:24:10.44,1:24:13.60,Default 2,,0,0,0,,لهذا كان لديه الكثير من الأسباب ليقتل نفسه
Dialogue: 0,1:24:18.64,1:24:22.31,Default 2,,0,0,0,,كما كان متوقعًا، اعتبرت التحقيقات الأمر انتحارًا
Dialogue: 0,1:24:22.31,1:24:27.22,Default 2,,0,0,0,,ولكنك كنت تعلم أنه سيتم فتح القضية مجددًا
Dialogue: 0,1:24:27.22,1:24:30.69,Default 2,,0,0,0,,أجل، عرفت من المحقق [ناراساوا]\N"الذي انتقل إلى مركز شرطة "بيكا
Dialogue: 0,1:24:30.69,1:24:35.49,Default 2,,0,0,0,,موت شريكه المحقق [توموناري] مثل صدمةً بالنسبة له
Dialogue: 0,1:24:35.49,1:24:37.90,Default 2,,0,0,0,,لهذا قصدني من أجل الاستشارة
Dialogue: 0,1:24:37.90,1:24:42.23,Default 2,,0,0,0,,علمت منه أيضًا أن [توموناري ماكوتو]\N!كان يلوم الشرطة
Dialogue: 0,1:24:42.23,1:24:47.14,Default 2,,0,0,0,,ولهذا، قبل أن تتوصل الشرطة إليك بعد فتح القضية
Dialogue: 0,1:24:47.14,1:24:51.64,Default 2,,0,0,0,,قتلت المحققين الثلاثة\Nواستدرجت السيد [توموناري ماكوتو]
Dialogue: 0,1:24:51.64,1:24:53.25,Default 2,,0,0,0,,للمكان لتلصق به التهمة؟
Dialogue: 0,1:24:53.25,1:24:59.35,Default 2,,0,0,0,,هذا صحيح\Nعندما قتلت المحقق [ناراساوا]، والمحقق [شيبا] اتصلت به مستخدماً صوتي
Dialogue: 0,1:24:59.35,1:25:01.35,Default 2,,0,0,0,,{\be1}...[أما صوت المحققة [ساتو{}
Dialogue: 0,1:25:01.35,1:25:07.26,Default 2,,0,0,0,,عدلت شريطًا سجلته لامرأة من المرضى، أليس كذلك؟
Dialogue: 0,1:25:07.26,1:25:09.26,Default 2,,0,0,0,,بالضبط
Dialogue: 0,1:25:09.26,1:25:13.40,Default 2,,0,0,0,,سمعت بأن المحقق [ناراساوا] مات حاملًا دفتر ملاحظاته
Dialogue: 0,1:25:13.40,1:25:15.70,Default 2,,0,0,0,,من المحقق [شيراتوري] أليس كذلك؟
Dialogue: 0,1:25:15.70,1:25:18.60,Default 2,,0,0,0,,أنا طبيبه في النهاية
Dialogue: 0,1:25:18.60,1:25:24.08,Default 2,,0,0,0,,ولكي تجعلهم يعتقدون بأن [توموناري ماكوتو ] هو الفاعل
Dialogue: 0,1:25:24.08,1:25:28.58,Default 2,,0,0,0,,!وضعت دفتر الملاحظات الشرطية عمدًا بيد المحقق [شيبا]
Dialogue: 0,1:25:28.58,1:25:34.42,Default 2,,0,0,0,,!عملٌ مذهلٌ يا [كونان]\Nولكن لا دليل على أني فعلتها
Dialogue: 0,1:25:34.42,1:25:40.46,Default 2,,0,0,0,,عندما أُطلق النار على المحققة [ساتو] لم يتم إيجاد آثار بارودٍ علي
Dialogue: 0,1:25:40.46,1:25:44.56,Default 2,,0,0,0,,!إذا ما أردت، فيمكنني شرح الخدعة لك
Dialogue: 0,1:25:44.56,1:25:45.76,Default 2,,0,0,0,,!ماذا؟
Dialogue: 0,1:25:45.76,1:25:48.79,Default 2,,0,0,0,,بعد أن تلقي الشرطة القبض عليك بالطبع
Dialogue: 0,1:26:05.22,1:26:06.85,Default 2,,0,0,0,,!من هذا الطريق -\N!ماذا؟ -
Dialogue: 0,1:26:06.85,1:26:07.22,Default 2,,0,0,0,,!من هذا الطريق -\N!ماذا؟ -
Dialogue: 0,1:26:07.22,1:26:09.35,Default 2,,0,0,0,,!سيكون بانتظارنا عند المخرج
Dialogue: 0,1:26:09.35,1:26:09.72,Default 2,,0,0,0,,!سيكون بانتظارنا عند المخرج
Dialogue: 0,1:26:31.28,1:26:32.74,Default 2,,0,0,0,,أين هذا؟
Dialogue: 0,1:26:32.74,1:26:35.81,Default 2,,0,0,0,,!الجزء الرئيسي من جزيرة البركان والمغامرات
Dialogue: 0,1:26:35.81,1:26:38.35,Default 2,,0,0,0,,لقد عبرنا تحت المحيط\N!من تلك الجزيرة الصغيرة هناك
Dialogue: 0,1:26:38.35,1:26:40.09,Default 2,,0,0,0,,حقًا؟
Dialogue: 0,1:26:40.09,1:26:41.25,Default 2,,0,0,0,,!فلننطلق
Dialogue: 0,1:26:47.09,1:26:49.26,Default 2,,0,0,0,,!مازلنا لم ننه النقاش
Dialogue: 0,1:26:49.26,1:26:52.43,Default 2,,0,0,0,,!اللعنة! لقد تبعنا في قارب
Dialogue: 0,1:26:52.43,1:26:56.77,Default 2,,0,0,0,,لا أستطيع تركك تظهر تلك الخدعة الآن
Dialogue: 0,1:26:56.77,1:27:02.27,Default 2,,0,0,0,,سيجعلني ذلك من الأشخاص المشتبهين\Nالذين أطلقوا النار على المحققة [ساتو]
Dialogue: 0,1:27:02.27,1:27:04.81,Default 2,,0,0,0,,حتى إذا تقدمت [ران] كشاهد عيان
Dialogue: 0,1:27:04.81,1:27:08.21,Default 2,,0,0,0,,يمكنك تمثيل دور البريء\Nوذلك لنقص آثار البارود، أليس كذلك؟
Dialogue: 0,1:27:08.21,1:27:12.99,Default 2,,0,0,0,,هذا صحيح\Nلأن [ران] قد رأتني لوهلةٍ من الزمن فقط
Dialogue: 0,1:27:12.99,1:27:16.32,Default 2,,0,0,0,,!ولكن علي أن أنتزع تلك البراعم الخطرة مبكرًا
Dialogue: 0,1:27:16.32,1:27:20.63,Default 2,,0,0,0,,لذا فلنسمع ما إذا كانت نظريتك صحيحة أم لا
Dialogue: 0,1:27:20.63,1:27:22.29,Default 2,,0,0,0,,!بكل سرور
Dialogue: 0,1:27:22.29,1:27:27.83,Default 2,,0,0,0,,أولًا وبعد أن أعتمت الطابق\Nالخامس عشر بالفندق
Dialogue: 0,1:27:27.83,1:27:30.34,Default 2,,0,0,0,,قد وضعت قفازات جراحية
Dialogue: 0,1:27:30.34,1:27:35.91,Default 2,,0,0,0,,وأخذت مظلةً كنت قد أعددتها مسبقًا\Nإلى حمام السيدات
Dialogue: 0,1:27:35.91,1:27:40.05,Default 2,,0,0,0,,وصنعت ثقبًا قريبًا من طرف\Nالمظلة قبل ذلك
Dialogue: 0,1:27:40.05,1:27:43.31,Default 2,,0,0,0,,وأخرجت مسدسك من الثقب وأطلقت
Dialogue: 0,1:27:47.22,1:27:52.82,Default 2,,0,0,0,,باختصار، قد حمتك المظلةُ من البارود والدخان
Dialogue: 0,1:27:54.09,1:27:58.76,Default 2,,0,0,0,,!لهذا لم يتم إيجاد آثار بارود عليك
Dialogue: 0,1:27:58.76,1:28:02.94,Default 2,,0,0,0,,أفترض أنك قد دفعت بالقفازات\Nفي مراحيض الرجال؟
Dialogue: 0,1:28:02.94,1:28:06.27,Default 2,,0,0,0,,!صحيح يا [كونان]
Dialogue: 0,1:28:06.27,1:28:09.74,Default 2,,0,0,0,,يبدو أنه سيتوجب عليك الموت
Dialogue: 0,1:28:09.74,1:28:12.34,Default 2,,0,0,0,,...[كونان]
Dialogue: 0,1:28:28.53,1:28:31.70,Default 2,,0,0,0,,!أخبرني! لماذا؟ -\N!ماذا؟ -
Dialogue: 0,1:28:31.70,1:28:36.53,Default 2,,0,0,0,,لم عليك التمادي في حمايتي هكذا؟
Dialogue: 0,1:28:37.90,1:28:40.24,Default 2,,0,0,0,,أخبرني...لماذا؟
Dialogue: 0,1:28:44.21,1:28:46.78,Default 2,,0,0,0,,!لأني أحبك -\N!ماذا؟ -
Dialogue: 0,1:28:46.78,1:28:52.15,Default 2,,0,0,0,,...لأني أحبك! أكثر من أي شخص
Dialogue: 0,1:28:52.15,1:28:53.58,Default 2,,0,0,0,,!على هذه الأرض...
Dialogue: 0,1:28:55.15,1:28:56.21,Default 2,,0,0,0,,!اقفزي
Dialogue: 0,1:28:57.72,1:28:59.56,Default 2,,0,0,0,,!خذي نفسًا عميقًا -\N!ماذا؟ -
Dialogue: 0,1:28:59.56,1:29:00.92,Default 2,,0,0,0,,!أسرعي
Dialogue: 0,1:29:11.84,1:29:13.27,Default 2,,0,0,0,,!شكرًا
Dialogue: 0,1:29:14.41,1:29:16.24,Default 2,,0,0,0,,!أيها الراشد
Dialogue: 0,1:29:17.31,1:29:18.58,Default 2,,0,0,0,,أجل
Dialogue: 0,1:29:18.58,1:29:19.98,Default 2,,0,0,0,,!اللعنة
Dialogue: 0,1:29:37.83,1:29:39.83,Default 2,,0,0,0,,!ستةٌ وأربعون ثانية
Dialogue: 0,1:29:39.83,1:29:41.03,Default 2,,0,0,0,,!إنه هنا
Dialogue: 0,1:29:43.97,1:29:47.51,Default 2,,0,0,0,,ما رأيك لو ننهي الأمر هنا يا [كونان]؟
Dialogue: 0,1:29:47.51,1:29:51.67,Default 2,,0,0,0,,...بجانب أنه ليس لديك مكانًا للهرب
Dialogue: 0,1:29:58.45,1:30:00.49,Default 2,,0,0,0,,![كونان]
Dialogue: 0,1:30:00.49,1:30:03.89,Default 2,,0,0,0,,!أنا بخير! لقد خدشت ذراعي فقط
Dialogue: 0,1:30:03.89,1:30:07.38,Default 2,,0,0,0,,!لقد أخبرتك للتو لا مكان لك للهرب
Dialogue: 0,1:30:09.16,1:30:15.37,Default 2,,0,0,0,,إذا قتلت [ران] الآن، ألن يثبت ذلك\Nبراءة السيد [توموناري ماكوتو]؟
Dialogue: 0,1:30:15.37,1:30:20.37,Default 2,,0,0,0,,هذا صحيح، لقد خططت أن أتخلص\N...من [توموناري] قبل أن يتم القبض عليه
Dialogue: 0,1:30:20.37,1:30:22.07,Default 2,,0,0,0,,ولكن لا يسعني فعل شيءٍ الآن
Dialogue: 0,1:30:22.07,1:30:27.05,Default 2,,0,0,0,,والآن أعتقد أنه يجب أن تكون\Nالسيدات أولًا؟
Dialogue: 0,1:30:27.05,1:30:29.48,Default 2,,0,0,0,,عشرة. تسعة
Dialogue: 0,1:30:29.48,1:30:30.68,Default 2,,0,0,0,,ثمانية
Dialogue: 0,1:30:30.68,1:30:31.68,Default 2,,0,0,0,,سبعة
Dialogue: 0,1:30:31.68,1:30:33.05,Default 2,,0,0,0,,ستة
Dialogue: 0,1:30:33.05,1:30:35.42,Default 2,,0,0,0,,خمسة -\Nأهذا نوعٌ من التعويذات السحرية؟ -
Dialogue: 0,1:30:35.42,1:30:36.49,Default 2,,0,0,0,,ثلاثة
Dialogue: 0,1:30:36.49,1:30:37.82,Default 2,,0,0,0,,!اثنان
Dialogue: 0,1:30:37.82,1:30:38.81,Default 2,,0,0,0,,!واحد
Dialogue: 0,1:30:46.43,1:30:49.10,Default 2,,0,0,0,,!كلا، [ران]
Dialogue: 0,1:30:49.10,1:30:50.50,Default 2,,0,0,0,,!محققة [ساتو]
Dialogue: 0,1:30:57.08,1:30:59.08,Default 2,,0,0,0,,!تفضلي\N!لابد أنك ظمآنة
Dialogue: 0,1:30:59.08,1:31:00.07,Default 2,,0,0,0,,!واحد
Dialogue: 0,1:31:16.56,1:31:18.56,Default 2,,0,0,0,,!أبعدي نفسك عني
Dialogue: 0,1:31:18.56,1:31:22.73,Default 2,,0,0,0,,!سينتهي أمرك بمجرد أن تتوقف النافورات\N!استسلم
Dialogue: 0,1:31:32.74,1:31:35.21,Default 2,,0,0,0,,!خدعةٌ طفولية
Dialogue: 0,1:31:35.21,1:31:36.61,Default 2,,0,0,0,,!ها أنت ذا
Dialogue: 0,1:31:42.75,1:31:45.22,Default 2,,0,0,0,,!مُت
Dialogue: 0,1:31:45.22,1:31:46.62,Default 2,,0,0,0,,!خذ هذا
Dialogue: 0,1:32:02.67,1:32:04.68,Default 2,,0,0,0,,\N...[كونان]
Dialogue: 0,1:32:04.68,1:32:06.68,Thoughts,,0,0,0,,\N![ران]! هل يعقل ذلك؟
Dialogue: 0,1:32:09.85,1:32:13.52,Default 2,,0,0,0,,\N!تبًا لهذا! سأتولى أمرك أنت أولًا
Dialogue: 0,1:32:19.12,1:32:21.99,Default 2,,0,0,0,,\N...هذا...محال
Dialogue: 0,1:32:21.99,1:32:22.49,Default 2,,0,0,0,,\N!أتذكر كل شيءٍ الآن
Dialogue: 0,1:32:22.49,1:32:24.13,Default 2,,0,0,0,,\N!أتذكر كل شيءٍ الآن
Dialogue: 0,1:32:24.13,1:32:26.53,Default 2,,0,0,0,,\Nأتذكر أنك أنت من أطلق النار على المحققة [ساتو]
Dialogue: 0,1:32:26.53,1:32:29.53,Default 2,,0,0,0,,\N!وأنني كنت بطلة بطولة المدينة للكاراتيه
Dialogue: 0,1:32:29.53,1:32:32.20,Default 2,,0,0,0,,\N!بطلة...كاراتيه؟
Dialogue: 0,1:32:47.52,1:32:48.82,Default 2,,0,0,0,,\N!رائع
Dialogue: 0,1:32:58.80,1:33:01.53,Default 2,,0,0,0,,![ران] -\N![ران] -
Dialogue: 0,1:33:01.53,1:33:03.74,Default 2,,0,0,0,,!أمي! أبي
Dialogue: 0,1:33:03.74,1:33:05.74,Default 2,,0,0,0,,...أنتِ
Dialogue: 0,1:33:05.74,1:33:07.87,Default 2,,0,0,0,,!هل استعدت ذاكرتك؟
Dialogue: 0,1:33:07.87,1:33:10.04,Default 2,,0,0,0,,!أتتذكرينني أنا أيضًا إذًا؟
Dialogue: 0,1:33:10.04,1:33:16.72,Default 2,,0,0,0,,بالطبع، [سوزوكي سونوكو]\N!صديقة عمري
Dialogue: 0,1:33:16.72,1:33:18.34,Default 2,,0,0,0,,[ران]
Dialogue: 0,1:33:21.55,1:33:25.51,Default 2,,0,0,0,,![ران]! الحمد لله
Dialogue: 0,1:33:27.76,1:33:31.73,Default 2,,0,0,0,,إذًا فقد كان هو القاتل في النهاية؟
Dialogue: 0,1:33:31.73,1:33:37.04,Default 2,,0,0,0,,المدير [اوداغيري] أعاد فتح القضية\Nبنفسه وأطلعنا على كل شيء
Dialogue: 0,1:33:37.04,1:33:40.57,Default 2,,0,0,0,,!هذا ليس عادلًا يا [كونان]\N!أن تمسك به وحدك
Dialogue: 0,1:33:40.57,1:33:44.88,Default 2,,0,0,0,,!لا تكونوا سخيفين\N!أراد [كونان] أن يبعدكم عن الخطر
Dialogue: 0,1:33:44.88,1:33:50.85,Default 2,,0,0,0,,!هذا بالضبط ما نعنيه -\N!نحن أيضاً في فرقة المتحرين الصغار -
Dialogue: 0,1:33:50.85,1:33:52.62,Default 2,,0,0,0,,!آسف، آسف
Dialogue: 0,1:33:52.62,1:33:55.12,Default 2,,0,0,0,,ماذا؟\N...أنت تنزف يا [كونان]
Dialogue: 0,1:33:55.12,1:33:57.29,Default 2,,0,0,0,,ماذا؟ -\Nتفضل -
Dialogue: 0,1:33:57.29,1:33:58.86,Default 2,,0,0,0,,شكرًا
Dialogue: 0,1:33:58.86,1:34:02.12,Default 2,,0,0,0,,الأمور بخيرٍ حتى الآن
Dialogue: 0,1:34:03.73,1:34:05.76,Default 2,,0,0,0,,...أجل
Dialogue: 0,1:34:05.76,1:34:08.77,Default 2,,0,0,0,,!عملًا رائعًا يا حضرة المتحري
Dialogue: 0,1:34:08.77,1:34:11.54,Default 2,,0,0,0,,!سيدة [تاماكي]\N!ماذا تفعلين هنا؟
Dialogue: 0,1:34:11.54,1:34:14.97,Default 2,,0,0,0,,أنا هنا لأراقب [توشيا]\Nفقد كان يعزف هنا اليوم
Dialogue: 0,1:34:14.97,1:34:17.31,Default 2,,0,0,0,,!ولكن اكتشفت أنه بلا جدوى على الرغم من ذلك
Dialogue: 0,1:34:17.31,1:34:22.61,Default 2,,0,0,0,,!"إذًا فماذا عن هراء "سأحمي [ران] وإن كلفني حياتي
Dialogue: 0,1:34:22.61,1:34:26.72,Default 2,,0,0,0,,لقد كان [كونان] والبروفيسور [أغاسا]\N!هما من خاطرا بحياتهما لإنقاذها
Dialogue: 0,1:34:26.72,1:34:28.92,Default 2,,0,0,0,,...لا
Dialogue: 0,1:34:28.92,1:34:31.72,Default 2,,0,0,0,,!على كل حالٍ، من الجيد أنها على ما يرام
Dialogue: 0,1:34:33.76,1:34:36.09,Default 2,,0,0,0,,!حقًا؟ -\N!أجل -
Dialogue: 0,1:34:36.09,1:34:39.73,Default 2,,0,0,0,,!اسمعوا جميعكم\N!لقد أفاقت الآنسة [ساتو] مجددًا
Dialogue: 0,1:34:39.73,1:34:41.67,Default 2,,0,0,0,,!لا داع للقلق بعد الآن
Dialogue: 0,1:34:41.67,1:34:43.66,Default 2,,0,0,0,,!حقًا؟
Dialogue: 0,1:34:50.14,1:34:52.01,Default 2,,0,0,0,,!آنسة [ساتو]
Dialogue: 0,1:34:52.01,1:34:53.85,Default 2,,0,0,0,,!هذا رائعٌ يا [تاكاغي]
Dialogue: 0,1:34:53.85,1:34:55.75,Default 2,,0,0,0,,!عظيم
Dialogue: 0,1:34:55.75,1:34:57.85,Default 2,,0,0,0,,!هذا ينهي كل شيء
Dialogue: 0,1:34:57.85,1:34:59.92,Default 2,,0,0,0,,!لا تكن أحمقًا
Dialogue: 0,1:34:59.92,1:35:03.29,Default 2,,0,0,0,,!مازالت هناك قضية ابتزاز [توشيا]
Dialogue: 0,1:35:03.29,1:35:05.86,Default 2,,0,0,0,,حتى وإن مات الضحية بالفعل
Dialogue: 0,1:35:05.86,1:35:09.13,Default 2,,0,0,0,,ولكن أريدك أن تقسو عليه\N!وتستخرج منه كل الحقائق
Dialogue: 0,1:35:09.13,1:35:10.79,Default 2,,0,0,0,,!مفهومٌ يا سيدي
Dialogue: 0,1:35:13.26,1:35:18.10,Default 2,,0,0,0,,يبدو أنك أول من يكشف عن الحقيقة
Dialogue: 0,1:35:18.10,1:35:20.14,Default 2,,0,0,0,,ولكن من أنت؟
Dialogue: 0,1:35:20.14,1:35:22.37,Default 2 - Copy,,0,0,0,,"لا تحتاج للمعرفة"
Dialogue: 0,1:35:24.38,1:35:26.41,Default 2,,0,0,0,,!أنا مجرد طفلٍ بالمدرسة
Dialogue: 0,1:38:21.12,1:38:22.95,Default 2,,0,0,0,,!شكرًا يا [كونان]
Dialogue: 0,1:38:22.95,1:38:27.36,Default 2,,0,0,0,,لقد قلت هذه الأشياء من قبل\Nلتساعدني على استعادة ذاكرتي، أليس كذلك؟
Dialogue: 0,1:38:27.36,1:38:28.89,Default 2,,0,0,0,,ماذا؟
Dialogue: 0,1:38:28.89,1:38:35.17,Default 2,,0,0,0,,سمعت ذلك بالفندق صحيح؟\N!كيف تقدم أبي للزواج من أمي
Dialogue: 0,1:38:35.17,1:38:41.14,DCFlashback,,0,0,0,,"أحبك. أكثر من أي شخصٍ على تلك الأرض"
Dialogue: 0,1:38:41.14,1:38:43.91,Default 2,,0,0,0,,!لذلك قلت نفس الشيء عمدًا
Dialogue: 0,1:38:43.91,1:38:47.38,Default 2,,0,0,0,,!قال عمي ذلك؟ -\Nماذا؟ لم يكن عن عمد؟
Dialogue: 0,1:38:47.38,1:38:50.42,Default 2,,0,0,0,,لا، لقد كان كذلك
Dialogue: 0,1:38:50.42,1:38:52.52,Default 2,,0,0,0,,!ظننت ذلك
Dialogue: 0,1:38:52.52,1:38:57.36,Default 2,,0,0,0,,في النهاية\N!يوجد فارقٌ في السن كبيرٌ بيننا
Dialogue: 0,1:38:57.36,1:39:00.35,Default 2,,0,0,0,,!ولكن ذلك أسعدني\N!طابت ليلتك
Dialogue: 0,1:39:02.26,1:39:04.19,Default 2,,0,0,0,,...طابت ليلتك
Dialogue: 0,1:39:08.03,1:39:10.02,Default 2,,0,0,0,,حسنًا
Dialogue: 0,1:39:11.27,1:39:14.44,Default 2,,0,0,0,,...مهلًا! هذا يعني
Dialogue: 0,1:39:14.44,1:39:18.71,Default 2,,0,0,0,,!أني فكرت بنفس الشيء الذي فكر هو به؟
Dialogue: 0,1:39:18.71,1:39:20.11,Default 2,,0,0,0,,...يا إلهي

