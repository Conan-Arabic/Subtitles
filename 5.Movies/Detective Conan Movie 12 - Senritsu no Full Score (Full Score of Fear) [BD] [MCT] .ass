Dialogue: 0,0:29:59.01,0:30:01.41,ANMAR,,0,0,0,,{\be1}نود ان نسمع منكِ شيئاً بسيطاً  قبل ان تغادري
Dialogue: 0,0:30:01.41,0:30:02.26,ANMAR,,0,0,0,,{\be1}أجل
Dialogue: 0,0:30:04.16,0:30:05.60,ANMAR,,0,0,0,,{\be1}كم ستدفعون بالمقابل ؟
Dialogue: 0,0:30:08.06,0:30:11.31,ANMAR,,0,0,0,,{\be1}فالمشاهير لا يغنون مجاناً للآخرين
Dialogue: 0,0:30:11.49,0:30:12.03,ANMAR,,0,0,0,,{\be1}أراكم لاحقاً
Dialogue: 0,0:30:12.84,0:30:13.77,ANMAR,,0,0,0,,هذا هو, هذا هو
Dialogue: 0,0:30:15.60,0:30:17.34,ANMAR,,0,0,0,,انت, هذا الشاي الخاص بي
Dialogue: 0,0:30:17.69,0:30:19.01,ANMAR,,0,0,0,,شكراً على الشاي
Dialogue: 0,0:30:24.49,0:30:25.31,ANMAR,,0,0,0,,ما بك يا [غينتا]؟
Dialogue: 0,0:30:27.09,0:30:28.00,ANMAR,,0,0,0,,ما الذي يجري ؟
Dialogue: 0,0:30:28.00,0:30:28.73,ANMAR,,0,0,0,,[غينتا]
Dialogue: 0,0:30:29.07,0:30:29.96,ANMAR,,0,0,0,,[غينتا]
Dialogue: 0,0:30:30.70,0:30:32.06,ANMAR,,0,0,0,,هل انت بخير يا [غينتا] ؟
Dialogue: 0,0:30:34.89,0:30:37.79,ANMAR,,0,0,0,,احدهم دسَّ شيئاً ما فيها
Dialogue: 0,0:30:38.30,0:30:39.26,ANMAR,,0,0,0,,هذا ما يبدو
Dialogue: 0,0:30:39.77,0:30:40.48,ANMAR,,0,0,0,,مستحيل
Dialogue: 0,0:30:41.02,0:30:41.91,ANMAR,,0,0,0,,كيف لهذا ان
Dialogue: 0,0:30:43.34,0:30:45.00,ANMAR,,0,0,0,,على كل حال, فالنأخذه إلى المشفى
Dialogue: 0,0:30:47.39,0:30:49.06,ANMAR,,0,0,0,,هل [غينتا], على ما يرام ؟
Dialogue: 0,0:30:49.52,0:30:51.40,ANMAR,,0,0,0,,بدا لي انه يتألم كثيراً
Dialogue: 0,0:30:52.31,0:30:53.61,ANMAR,,0,0,0,,عيناه كانتا شديدتي الاحمرار
Dialogue: 0,0:30:54.20,0:30:56.36,ANMAR,,0,0,0,,متى شربتي من تلك الحافظة آخر مرة
Dialogue: 0,0:30:57.76,0:30:59.11,ANMAR,,0,0,0,,قُبيل الظهيرة حسب ما أذكر
Dialogue: 0,0:30:59.60,0:31:00.24,ANMAR,,0,0,0,,أين ؟
Dialogue: 0,0:31:00.84,0:31:04.67,ANMAR,,0,0,0,,حجزتُ غرفة تدريب في اكاديمية دوموتو
Dialogue: 0,0:31:04.67,0:31:06.08,ANMAR,,0,0,0,,من اجل ان امرن صوتي
Dialogue: 0,0:31:06.71,0:31:08.14,ANMAR,,0,0,0,,وذهبتُ إلى دورة مياه السيدات قبل مغادرتي
Dialogue: 0,0:31:08.62,0:31:13.54,ANMAR,,0,0,0,,واثناء تلك الفترة تركت حافظة الشاي مع بقية اغراضي في غرفة التدريب
Dialogue: 0,0:31:14.18,0:31:16.55,ANMAR,,0,0,0,,الوقت الوحيد الذي كان يمكن اثناءه دس شيء في الحافظة
Dialogue: 0,0:31:16.55,0:31:17.52,ANMAR,,0,0,0,,كان في تلك الفترة
Dialogue: 0,0:31:18.10,0:31:19.55,ANMAR,,0,0,0,,ولكن من هو الفاعل؟
Dialogue: 0,0:31:20.87,0:31:22.24,ANMAR,,0,0,0,,شكراً جزيلاً لك
Dialogue: 0,0:31:25.19,0:31:25.98,ANMAR,,0,0,0,,[غينتا]
Dialogue: 0,0:31:27.22,0:31:28.18,ANMAR,,0,0,0,,هل انت بخير ؟
Dialogue: 0,0:31:28.57,0:31:30.02,ANMAR,,0,0,0,,في اسوأ حال
Dialogue: 0,0:31:30.70,0:31:32.09,ANMAR,,0,0,0,,ماذا قال الطبيب ؟
Dialogue: 0,0:31:32.94,0:31:34.73,ANMAR,,0,0,0,,قال ان حلقه ملتهب جداً
Dialogue: 0,0:31:35.22,0:31:36.99,ANMAR,,0,0,0,,لكنه سيشفى في غضون اربعة او خمسة ايام
Dialogue: 0,0:31:36.99,0:31:38.26,ANMAR,,0,0,0,,ستُشفى
Dialogue: 0,0:31:38.26,0:31:38.90,ANMAR,,0,0,0,,حمداً لله
Dialogue: 0,0:31:39.36,0:31:44.29,ANMAR,,0,0,0,,إذن, فهذا يعني انه لن يكون قادراً على الكلام خلال الاربعة ايام المقبلة
Dialogue: 0,0:31:44.29,0:31:45.31,ANMAR,,0,0,0,,اجل
Dialogue: 0,0:31:45.31,0:31:47.87,ANMAR,,0,0,0,,ولم يتبقى سوى ثلاثة ايام على حفل قاعة دوموتو
Dialogue: 0,0:31:48.41,0:31:49.78,ANMAR,,0,0,0,,لو أن الآنسة [ريبيكو] شربت منه
Dialogue: 0,0:31:50.19,0:31:51.77,ANMAR,,0,0,0,,لم تكن لتستطع الغناء
Dialogue: 0,0:31:54.17,0:31:55.45,ANMAR,,0,0,0,,أخبر المفتش [ميغوري]
Dialogue: 0,0:31:55.91,0:31:58.19,ANMAR,,0,0,0,,ان يفحصو محتويات تلك الحافظة
Dialogue: 0,0:31:58.72,0:32:00.23,ANMAR,,0,0,0,,سأذهب لإعلامهم حالاً
Dialogue: 0,0:32:01.04,0:32:02.09,ANMAR,,0,0,0,,ولكن قبل ان اذهب
Dialogue: 0,0:32:02.57,0:32:04.68,ANMAR,,0,0,0,,لا تقلقي ,سنرافق [غينتا] إلى منزله
Dialogue: 0,0:32:05.07,0:32:05.83,ANMAR,,0,0,0,,وانا ايضاً
Dialogue: 0,0:32:05.83,0:32:06.64,ANMAR,,0,0,0,,وانا ايضاً سأذهب
Dialogue: 0,0:32:07.38,0:32:09.39,ANMAR,,0,0,0,,اريد ان أرى والدي هذا الطفل لأخبرهما
Dialogue: 0,0:32:10.21,0:32:12.10,ANMAR,,0,0,0,,أن ابنهما شرب من اشياء الآخرين دون استئذان
Dialogue: 0,0:32:12.10,0:32:13.85,ANMAR,,0,0,0,,أية تربية تلقاها هذا الصغير
Dialogue: 0,0:32:14.42,0:32:15.69,ANMAR,,0,0,0,,أنا اسف
Dialogue: 0,0:32:15.69,0:32:16.92,ANMAR,,0,0,0,,غينتا
Dialogue: 0,0:32:25.86,0:32:27.33,ANMAR,,0,0,0,,تشجع يا [غينتا]
Dialogue: 0,0:32:28.33,0:32:29.52,ANMAR,,0,0,0,,كلها اربع ايام
Dialogue: 0,0:32:29.52,0:32:30.45,ANMAR,,0,0,0,,ستمر كلمح البصر
Dialogue: 0,0:32:31.98,0:32:36.42,ANMAR,,0,0,0,,انا اريد .. اريد ان اخذ... حبة دواء الرجل العجوز
Dialogue: 0,0:32:37.20,0:32:40.13,ANMAR,,0,0,0,,يبدو ان لغز البروفيسور قد اصبح حقيقة
Dialogue: 0,0:32:50.16,0:32:51.81,ANMAR,,0,0,0,,تنحو جانباً
Dialogue: 0,0:32:51.81,0:32:52.49,ANMAR,,0,0,0,,كلا
Dialogue: 0,0:32:52.49,0:32:53.15,ANMAR,,0,0,0,,اركضو
Dialogue: 0,0:32:55.39,0:32:56.01,ANMAR,,0,0,0,,بسرعة
Dialogue: 0,0:33:01.11,0:33:02.53,ANMAR,,0,0,0,,تباً, لا استطيع رؤية وجهه
Dialogue: 0,0:33:06.02,0:33:07.45,ANMAR,,0,0,0,,والآن انعطفوا إلى اليمين
Dialogue: 0,0:33:29.57,0:33:30.14,ANMAR,,0,0,0,,ماذا
Dialogue: 0,0:33:44.48,0:33:45.28,ANMAR,,0,0,0,,هل انت بخير
Dialogue: 0,0:33:52.87,0:33:53.49,ANMAR,,0,0,0,,تباً
Dialogue: 0,0:33:56.80,0:33:58.01,ANMAR,,0,0,0,,هل انت بخير ؟
Dialogue: 0,0:33:58.01,0:33:58.30,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:33:59.17,0:34:00.87,ANMAR,,0,0,0,,ما بال سائق تلك الشاحنة ؟
Dialogue: 0,0:34:00.87,0:34:02.56,ANMAR,,0,0,0,,يسير باتجاه معاكس في شارعٍ احادي المسار
Dialogue: 0,0:34:02.56,0:34:03.45,ANMAR,,0,0,0,,معلمة [رييكو]
Dialogue: 0,0:34:03.99,0:34:04.92,ANMAR,,0,0,0,,ساقكٍ تنزف
Dialogue: 0,0:34:06.62,0:34:07.88,ANMAR,,0,0,0,,لا يهم
Dialogue: 0,0:34:09.95,0:34:12.74,ANMAR,,0,0,0,,هل توقف الهجوم بسبب سيارة الاجرة يا ترى
Dialogue: 0,0:34:13.94,0:34:15.10,ANMAR,,0,0,0,,ام لأن
Dialogue: 0,0:34:15.42,0:34:17.96,ANMAR,,0,0,0,,اعتذر منكِ, ولكنني مضطرة لترك الأطفال معكِ
Dialogue: 0,0:34:19.36,0:34:21.17,ANMAR,,0,0,0,,ساستقل سيارة الاجرة هذه واعود إلى منزلي
Dialogue: 0,0:34:21.70,0:34:24.15,ANMAR,,0,0,0,,أخبروا الشرطة عما حدث للتو
Dialogue: 0,0:34:25.15,0:34:26.19,ANMAR,,0,0,0,,هل ستغادرين ؟
Dialogue: 0,0:34:26.94,0:34:29.86,ANMAR,,0,0,0,,مرافقتكم جلبت لي الحظ السيء
Dialogue: 0,0:34:30.46,0:34:31.70,ANMAR,,0,0,0,,ماذا ؟
Dialogue: 0,0:34:31.70,0:34:32.66,ANMAR,,0,0,0,,يا لها من لئيمة
Dialogue: 0,0:35:31.87,0:35:32.42,ANMAR,,0,0,0,,سيدي المفتش
Dialogue: 0,0:35:33.54,0:35:34.92,ANMAR,,0,0,0,,كيف حدث الانفجار ؟
Dialogue: 0,0:35:34.92,0:35:35.73,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:35:35.73,0:35:40.48,ANMAR,,0,0,0,,اتضح ان الغرفة كانت مليئة بغاز "البروبان" الذي\Nانفجر بمجرد إشعال الضحية لعود الثقاب
Dialogue: 0,0:35:40.48,0:35:44.52,ANMAR,,0,0,0,,كما اثبتت التحقيقات ان كاشف تسريب الغاز قد تم تعطيله عمداً
Dialogue: 0,0:35:45.06,0:35:47.27,ANMAR,,0,0,0,,مما يعني ان ما حدث كان جريمة قتل, وليس مجرد حادثة عرضية
Dialogue: 0,0:35:47.66,0:35:49.82,ANMAR,,0,0,0,,الضحية هو صاحب المتجر
Dialogue: 0,0:35:50.15,0:35:52.37,ANMAR,,0,0,0,,ويدعى السيد [شيدا اوسامو], وعمرة 36 عاماً
Dialogue: 0,0:35:52.37,0:35:56.78,ANMAR,,0,0,0,,السيد [شيدا] كان عازف كمان, وهو أحد\Nخريجي الدفعة الاولى لاكاديمية دوموتو
Dialogue: 0,0:35:57.12,0:35:58.31,ANMAR,,0,0,0,,الدفعة الاولى ؟
Dialogue: 0,0:35:58.86,0:36:01.71,ANMAR,,0,0,0,,الامر تفسه ينطبق على ضحيتي الانفجار السابق
Dialogue: 0,0:36:02.38,0:36:04.37,ANMAR,,0,0,0,,لا أظن الامر محض مصادفة
Dialogue: 0,0:36:04.37,0:36:04.84,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:36:05.20,0:36:06.00,ANMAR,,0,0,0,,ليست مصادفة
Dialogue: 0,0:36:06.81,0:36:07.62,ANMAR,,0,0,0,,المفتشة [ساتو]
Dialogue: 0,0:36:10.29,0:36:11.42,ANMAR,,0,0,0,,وجدنا هذا داخل المتجر
Dialogue: 0,0:36:12.49,0:36:13.15,ANMAR,,0,0,0,,ماهذا
Dialogue: 0,0:36:13.83,0:36:15.45,ANMAR,,0,0,0,, "قطعة الذيل لآلة "الفلوت
Dialogue: 0,0:36:16.34,0:36:17.23,ANMAR,,0,0,0,,لا مجال للشك
Dialogue: 0,0:36:17.90,0:36:19.75,ANMAR,,0,0,0,,إنها سلسلة جرائم قتل من تنفيذ شخص واحد
Dialogue: 0,0:36:20.52,0:36:23.60,ANMAR,,0,0,0,,إضافة إلى ذلك, فلقد ترك لنا القاتل رسالتين
Dialogue: 0,0:36:24.05,0:36:25.83,ANMAR,,0,0,0,,قطعة الربط وقطعة الذيل
Dialogue: 0,0:36:26.49,0:36:28.54,ANMAR,,0,0,0,,بقيت قطعة الرأس لم تظهر
Dialogue: 0,0:36:30.12,0:36:33.95,ANMAR,,0,0,0,,في هذه الحالة, فأن جريمة اخرى ستقع
Dialogue: 0,0:37:09.52,0:37:14.82,ANMAR,,0,0,0,,الرجل الذي غرق بعد سقوطه من طائرته الشراعية\Nيدعى السيد [سوني هياسو], أليس كذلك ؟
Dialogue: 0,0:37:15.30,0:37:16.06,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:37:16.06,0:37:18.37,ANMAR,,0,0,0,,"ولقد كان عازف "فيولا
Dialogue: 0,0:37:18.96,0:37:22.29,ANMAR,,0,0,0,,وللأشارة, فقد كان من خريجي الدفعة الأولى لطلاب أكاديمية دوموتو
Dialogue: 0,0:37:23.23,0:37:24.46,ANMAR,,0,0,0,,إذن فإنه
Dialogue: 0,0:37:24.46,0:37:25.25,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:37:25.76,0:37:28.55,ANMAR,,0,0,0,,كان زميلا لضحايا الاسبوع الماضي, السيد [ميزومي] والسيد [رينجو]
Dialogue: 0,0:37:29.01,0:37:32.54,ANMAR,,0,0,0,,وكذلك السيد [شيدا] الذي قضى نحبه في الانفجار الذي وقع قبل يومين
Dialogue: 0,0:37:33.42,0:37:37.72,ANMAR,,0,0,0,,وفق ذلك فقد كان اربعتهم يشكلون فرقة \Nرباعية الــ "بيانو" إلى ما قبل السنتين الماضيتين
Dialogue: 0,0:37:40.23,0:37:43.38,ANMAR,,0,0,0,,كما توقعت, انها سلسلة جرائم قتل من تنفيذ شخص واحد
Dialogue: 0,0:37:43.38,0:37:44.62,ANMAR,,0,0,0,,لا شك في ذلك
Dialogue: 0,0:37:45.28,0:37:48.07,ANMAR,,0,0,0,,وفقاً  لأقوال الشرطة المحلية لتلك المنطقة, فالأجنحة القماشية
Dialogue: 0,0:37:48.56,0:37:52.78,ANMAR,,0,0,0,,وقبة تلك الطائرة الشراعية, ظهرت عليها\Nعلامات قطع صغيرة جداً بواسطة أداة حادة
Dialogue: 0,0:37:52.78,0:37:56.57,ANMAR,,0,0,0,,وفوق هذا, وجدنا اسفل مقعد سيارة السيد [سوني]
Dialogue: 0,0:37:57.17,0:38:00.95,ANMAR,,0,0,0,,وجدتم القطعة الاخيرة من "الفلوت" قطعة الرأس, اليس كذلك ؟
Dialogue: 0,0:38:01.86,0:38:02.74,ANMAR,,0,0,0,,أ...أجل
Dialogue: 0,0:38:03.38,0:38:06.88,ANMAR,,0,0,0,,بما ان اجزاء "الفلوت" الثلاثة قد ظهرت
Dialogue: 0,0:38:06.88,0:38:09.88,ANMAR,,0,0,0,,ألا يعني هذا ان سلسلة الجرائم قد انتهت ؟
Dialogue: 0,0:38:10.19,0:38:11.69,ANMAR,,0,0,0,,اتمنى ذلك
Dialogue: 0,0:38:12.25,0:38:13.25,ANMAR,,0,0,0,,بالمناسبة يا [ران]
Dialogue: 0,0:38:13.25,0:38:13.80,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:38:14.43,0:38:17.99,ANMAR,,0,0,0,,لقد فحصنا حافظة الشاي التي احضرتيها  إلينا
Dialogue: 0,0:38:18.57,0:38:20.49,ANMAR,,0,0,0,,وقد اثبت التحليل الجنائي انها تحتوي
Dialogue: 0,0:38:20.49,0:38:23.24,ANMAR,,0,0,0,,مواد كيميائية مهيجة
Dialogue: 0,0:38:24.24,0:38:26.43,ANMAR,,0,0,0,,الأمر اخطر من ان يكون مجرد دعابة إذن
Dialogue: 0,0:38:27.10,0:38:28.89,ANMAR,,0,0,0,,ماذا عن الشاحنة التي هاجمتنا ؟
Dialogue: 0,0:38:29.34,0:38:32.11,ANMAR,,0,0,0,,يبدو انها سرقت من مكان قريب من موقع الحادث
Dialogue: 0,0:38:32.82,0:38:35.63,ANMAR,,0,0,0,,بعبارة اخرى, لان خطة وضع المواد الكيميائية في الحافظة
Dialogue: 0,0:38:35.63,0:38:38.07,ANMAR,,0,0,0,,لم تفلح في إلحاق الأذى بالآنسة [اكيبا]
Dialogue: 0,0:38:38.76,0:38:41.86,ANMAR,,0,0,0,,لجأ الفاعل إلى خطة أخرى, وهي ان يسرق الشاحنة ومن ثم يحاول دهسها
Dialogue: 0,0:38:42.36,0:38:44.79,ANMAR,,0,0,0,,وما كل هذا إلا لتحقيق هدف واحد
Dialogue: 0,0:38:45.61,0:38:52.63,ANMAR,,0,0,0,,وهو ان يمنع الانسة من الغناء في حفل افتتاح قاعة دوموتو
Dialogue: 0,0:38:54.30,0:38:57.51,ANMAR,,0,0,0,,عفواُ, في حال لم تتمكن الآنسة [رييكو] من الغناء في الحفل
Dialogue: 0,0:38:57.51,0:38:58.97,ANMAR,,0,0,0,,من سيكون بديلها ؟
Dialogue: 0,0:38:59.56,0:39:02.34,ANMAR,,0,0,0,,حسب ما اعتقد, فإن الآنسة [تشيغوسا رارا] ستكون بديلتها على الاجرح
Dialogue: 0,0:39:03.72,0:39:06.03,ANMAR,,0,0,0,,"لقد كانت في الاصل الخيار الاول لفقرة "السوبرانو
Dialogue: 0,0:39:06.43,0:39:11.39,ANMAR,,0,0,0,,كونها من طلاب الدفعة التاسعة لأكاديمية دوموتو\Nوتلميذة السيد [دوموتو] في الوقت نفسه
Dialogue: 0,0:39:13.25,0:39:14.20,ANMAR,,0,0,0,,لكن مؤخراً
Dialogue: 0,0:39:14.56,0:39:17.66,ANMAR,,0,0,0,,الانسة [كابي سوكو] التي تم اعتمادها للعرض مسبقاً
Dialogue: 0,0:39:18.11,0:39:23.11,ANMAR,,0,0,0,,أوصت بالآنسة [اكيبا] لأداء هذا الدور, وأشارت\Nإلى رغبتها في العمل معها في حفل رسمي
Dialogue: 0,0:39:23.88,0:39:26.24,ANMAR,,0,0,0,,ولهذا تم اسناد الدور إليها
Dialogue: 0,0:39:26.85,0:39:29.24,ANMAR,,0,0,0,,السؤال الذي يطرح نفسه الان
Dialogue: 0,0:39:29.24,0:39:31.37,ANMAR,,0,0,0,,ما القاسم المشترك بين الضحايا الاربع وهذا الموضوع ؟
Dialogue: 0,0:39:31.95,0:39:32.84,ANMAR,,0,0,0,,
Dialogue: 0,0:39:33.30,0:39:36.21,ANMAR,,0,0,0,,حتى هذه اللحظة لم نجد ما يربط الأنسة [اكيبا] بالضحايا الاربع
Dialogue: 0,0:39:36.83,0:39:38.10,ANMAR,,0,0,0,,كل ما نعرفة فقط
Dialogue: 0,0:39:38.10,0:39:41.62,ANMAR,,0,0,0,,هو  ان العلاقة بين الآنسة [كابي سوكو]  وضحايا الانفجاريين الاول والثاني
Dialogue: 0,0:39:42.51,0:39:44.51,ANMAR,,0,0,0,,ما يزال هناك مسألة الغناء
Dialogue: 0,0:39:45.16,0:39:49.81,ANMAR,,0,0,0,,القنبلة زرعت تحت الواح البلاط القريبة من الضحيتين
Dialogue: 0,0:39:50.27,0:39:51.24,ANMAR,,0,0,0,,في هذه الحال
Dialogue: 0,0:39:51.82,0:39:55.15,ANMAR,,0,0,0,,فأن سوء حظ الآنسة [كابي] هو من جعلها تتواجد هناك
Dialogue: 0,0:39:55.43,0:39:58.28,ANMAR,,0,0,0,,لا يزال الوقت مبكراً على مثل هذا الاستنتاج
Dialogue: 0,0:39:58.28,0:40:01.53,ANMAR,,0,0,0,,فهناك آخرون لديهم دوافع لقتل الآنسة [كابي]
Dialogue: 0,0:40:02.42,0:40:05.95,ANMAR,,0,0,0,,اتعني المرشحة السابقة من قبل الآنسة [اكيبا], الآنسة [تشيغوسا رارا] ؟
Dialogue: 0,0:40:06.56,0:40:07.60,ANMAR,,0,0,0,,هناك شخص آخر
Dialogue: 0,0:40:08.14,0:40:11.66,ANMAR,,0,0,0,,بديلة الآنسة [اكابي] في العرض, الآنسة [يماني شيون]
Dialogue: 0,0:40:14.66,0:40:15.58,ANMAR,,0,0,0,,هي كذلك ؟
Dialogue: 0,0:40:15.98,0:40:16.64,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:40:17.10,0:40:19.48,ANMAR,,0,0,0,,"لأنها لو اخذت مكان الانسىة [اكابي] في فقرة "التراديفاريوس
Dialogue: 0,0:40:19.99,0:40:23.66,ANMAR,,0,0,0,,لا سيما في هذه الحفلة الموسيقية التي يحضرها موسيقيون مرموقون ومشهورون
Dialogue: 0,0:40:24.01,0:40:25.79,ANMAR,,0,0,0,,وكان عرضها في غاية الروعة
Dialogue: 0,0:40:26.29,0:40:29.85,ANMAR,,0,0,0,,فإن هذا سيفتح لها باب الشهرة على مصراعيه
Dialogue: 0,0:40:31.48,0:40:33.22,ANMAR,,0,0,0,,على اية حال, هناك احتمال آخر
Dialogue: 0,0:40:33.80,0:40:36.19,ANMAR,,0,0,0,,فعلى الرغم من ان الانسة [كابي] هي افضلُ وأكثرُ تلميذات [دوموتو] تفوقاً
Dialogue: 0,0:40:37.05,0:40:39.93,ANMAR,,0,0,0,,إلا ان اختيارها لأداء العرض الموسيقي القادم
Dialogue: 0,0:40:40.44,0:40:44.96,ANMAR,,0,0,0,, "لم يكن بسبب انه يفضلها, بل لانها كان يخطط للاسيلاء على كمان "التراديفاريوس \Nالخاص بها
Dialogue: 0,0:40:45.60,0:40:48.89,ANMAR,,0,0,0,,كانت نيته الدائمة ان يجعل الآنسة [شيون] تؤدي العرض
Dialogue: 0,0:40:49.36,0:40:52.57,ANMAR,,0,0,0,,ولهذا وكخطوة أولى, جعلها البديلة الرئيسية
Dialogue: 0,0:40:53.26,0:40:57.67,ANMAR,,0,0,0,,ثم حرص على أن تتعرض الآنسة [كابي] لإصابات\N"بالغة ليستولي على كمان "التراديفاريوس
Dialogue: 0,0:40:58.06,0:41:00.21,ANMAR,,0,0,0,,هذا الاحتمال لا يمكن تجاهله ايضاً
Dialogue: 0,0:41:01.53,0:41:05.14,ANMAR,,0,0,0,,العلاقات الانسانية معقدة جدا لدرجة انها اصبحت صعبة الفهم
Dialogue: 0,0:41:05.52,0:41:06.22,ANMAR,,0,0,0,,الخلاصة
Dialogue: 0,0:41:06.68,0:41:11.33,ANMAR,,0,0,0,,الشخص الذي لديه الدافع لقتل الآنستين [كابي] و [رييكو] هو الانسة [تشيغوسا رارا] فقط
Dialogue: 0,0:41:12.18,0:41:16.13,ANMAR,,0,0,0,,واللذان لديهما الدافع لقتل الآنسة [كابي] هما السيد [دوموتو] والآنسة [شيون]
Dialogue: 0,0:41:16.70,0:41:21.00,ANMAR,,0,0,0,,لكننا ما زلنا نجهل سبب إقدام احد الثلاثة على قتل الاربعة الآخرون
Dialogue: 0,0:41:22.23,0:41:23.40,ANMAR,,0,0,0,,أليس هذا صحيحاً ؟
Dialogue: 0,0:41:24.04,0:41:25.57,ANMAR,,0,0,0,,نعم , صحيح
Dialogue: 0,0:41:27.51,0:41:31.23,ANMAR,,0,0,0,,بالمناسبة, "البيانو" الذي كان في غرفة التدريب التي وقع فيها الانفجار
Dialogue: 0,0:41:31.61,0:41:34.00,ANMAR,,0,0,0,,هل هناك ما يميزهُ ؟
Dialogue: 0,0:41:34.44,0:41:37.90,ANMAR,,0,0,0,,كلا, لم اسمع اي شيء يميزه
Dialogue: 0,0:41:38.36,0:41:39.79,ANMAR,,0,0,0,,لِمَ تظن ذلك ؟
Dialogue: 0,0:41:40.13,0:41:42.05,ANMAR,,0,0,0,,عندما ذهبتُ إلى هناك في ذلك اليوم
Dialogue: 0,0:41:42.05,0:41:46.40,ANMAR,,0,0,0,,رأيت السيد [فوا] يحمل حطام مفتاح "بيانو" في يده, كما لو انه شيء نفسي
Dialogue: 0,0:41:46.91,0:41:49.60,ANMAR,,0,0,0,,"فظننت ان هناك ما يميزه ذلك "البيانو
Dialogue: 0,0:41:49.60,0:41:50.74,ANMAR,,0,0,0,,ولد
Dialogue: 0,0:41:50.74,0:41:52.94,ANMAR,,0,0,0,,كم مرة أخبرتك ألا تتسكع في الجوار بمفردك ؟
Dialogue: 0,0:41:53.43,0:41:54.47,ANMAR,,0,0,0,,أسف
Dialogue: 0,0:41:55.01,0:42:00.27,ANMAR,,0,0,0,,عزف السيد [دوموتو] على ذلك البيانو لأكثر\Nمن ثلاثين عاماً وكان يحتفظ به في منزله
Dialogue: 0,0:42:01.08,0:42:03.21,ANMAR,,0,0,0,,"وبعد ان اعتزل العزف على "البيانو
Dialogue: 0,0:42:03.68,0:42:07.28,ANMAR,,0,0,0,,قرر ان يضعه في الاكاديمية حتى يتمكن الموسيقيون المبتدئون من التدريب عليه
Dialogue: 0,0:42:08.12,0:42:10.53,ANMAR,,0,0,0,,والجدير بالذكر انه وعندما كان "البيانو" في بيت السيد [دوموتو]
Dialogue: 0,0:42:10.53,0:42:12.39,ANMAR,,0,0,0,,وحتى بعدما نُقِل لاحقاً إلى الأكاديمية
Dialogue: 0,0:42:12.39,0:42:14.70,ANMAR,,0,0,0,,كان السيد [فوا] هو المسؤول عن ضبط إيقاعه
Dialogue: 0,0:42:16.30,0:42:20.29,ANMAR,,0,0,0,,حسنٌ, ربما كان يعد ذلك "البيانو" مثل ولده الصغير
Dialogue: 0,0:42:20.79,0:42:22.07,ANMAR,,0,0,0,,هل فهمت ايها الشقي ؟
Dialogue: 0,0:42:23.44,0:42:24.89,ANMAR,,0,0,0,,على ذكر الموضوع
Dialogue: 0,0:42:24.89,0:42:28.06,ANMAR,,0,0,0,,السيد [فوا] كان ينتقد الضحايا الاربع كثيراً في ما مضى
Dialogue: 0,0:42:28.68,0:42:31.77,ANMAR,,0,0,0,,كان يقول ان مشكلتهم في الحياة هي منهجهم السطحي
Dialogue: 0,0:42:31.77,0:42:36.08,ANMAR,,0,0,0,,لكن ... يستحيل ان يكون ما قلته سبباً يدفعه لقتل الاربعة, اليس كذلك ؟
Dialogue: 0,0:42:36.70,0:42:37.73,ANMAR,,0,0,0,,أظن ذلك
Dialogue: 0,0:42:38.20,0:42:44.28,ANMAR,,0,0,0,,لنفترض ان الامر كما قلت, قتلهم بعد ان ضاق\Nذرعاً بهم بسبب منهجهم السطحي في الحياة
Dialogue: 0,0:42:44.67,0:42:48.23,ANMAR,,0,0,0,,ولكن ليس لهذا صلة بما حصل مؤخراً مع الآنسة [اكيبا]
Dialogue: 0,0:42:49.38,0:42:50.58,ANMAR,,0,0,0,,حضرة المفتش
Dialogue: 0,0:42:50.58,0:42:55.09,ANMAR,,0,0,0,,اليس من الافضل لو فصلنا قضية الآنسة [اكيبا] عن قضية الاربعة الآخرين ؟
Dialogue: 0,0:42:55.50,0:43:00.31,ANMAR,,0,0,0,,لكن القضيتين كلتيهما تتمحورران حول شخص واحد الا وهو السيد [دوموتو]
Dialogue: 0,0:43:00.31,0:43:03.22,ANMAR,,0,0,0,,لا اظن ما حدث هو محض مصادفة فقط
Dialogue: 0,0:43:03.82,0:43:05.06,ANMAR,,0,0,0,,ربما
Dialogue: 0,0:43:05.39,0:43:06.34,ANMAR,,0,0,0,,على كل حال
Dialogue: 0,0:43:06.94,0:43:09.95,ANMAR,,0,0,0,,من الآن وحتى انتهاء الحفل الموسيقى بعد يومين
Dialogue: 0,0:43:10.30,0:43:13.36,ANMAR,,0,0,0,,علينا تشديد الحراسة على الآنسة [اكيبا]
Dialogue: 0,0:43:13.98,0:43:16.10,ANMAR,,0,0,0,,لقد ارسلت [تاكاغي] مسبقاً, ولكن
Dialogue: 0,0:43:17.27,0:43:20.56,ANMAR,,0,0,0,,لقد رفضت وجودي معها معللة ذلك بانني ازعجها
Dialogue: 0,0:43:21.74,0:43:22.49,ANMAR,,0,0,0,,!يا حبيبي
Dialogue: 0,0:43:22.49,0:43:24.61,ANMAR,,0,0,0,,ما هذا يا [تاكاغي] ؟
Dialogue: 0,0:43:24.61,0:43:26.97,ANMAR,,0,0,0,,اذا هوجمت الآنسة [رييكو ]مجدداً
Dialogue: 0,0:43:26.97,0:43:28.65,ANMAR,,0,0,0,,فلم يجدي الاعتذار نفعاً
Dialogue: 0,0:43:28.65,0:43:32.96,ANMAR,,0,0,0,,لكنها اخبرتني انها ستبقى اليوم وغداً ملازمة منزلها
Dialogue: 0,0:43:32.96,0:43:34.25,ANMAR,,0,0,0,,ايها الاحمق
Dialogue: 0,0:43:34.25,0:43:36.31,ANMAR,,0,0,0,,هل من المنطقى ان ترد عليها بقولك فهمت, ثم تغادر ؟
Dialogue: 0,0:43:36.56,0:43:37.45,ANMAR,,0,0,0,,انا اسف
Dialogue: 0,0:43:40.53,0:43:41.61,ANMAR,,0,0,0,,انا خارج
Dialogue: 0,0:43:43.89,0:43:45.09,ANMAR,,0,0,0,,كونان
Dialogue: 0,0:43:45.79,0:43:47.18,ANMAR,,0,0,0,,صباح الخير يا [كونان]
Dialogue: 0,0:43:47.76,0:43:48.88,ANMAR,,0,0,0,,صباح الخير
Dialogue: 0,0:43:49.63,0:43:50.63,ANMAR,,0,0,0,,ما بكم يا رفاق ؟
Dialogue: 0,0:43:51.02,0:43:52.15,ANMAR,,0,0,0,,اتيتم مبكراً هذا الصباح
Dialogue: 0,0:43:52.50,0:43:54.47,ANMAR,,0,0,0,,"نحن ذاهبون لمشاهدة " كامين يايبا
Dialogue: 0,0:43:54.94,0:43:55.93,ANMAR,,0,0,0,,كامين يايبا ؟
Dialogue: 0,0:43:56.14,0:44:00.46,ANMAR,,0,0,0,,سيصورون اليوم في متنزه (ريوكوتشي) بالقرب من نهر (تيموزو)
Dialogue: 0,0:44:00.46,0:44:02.01,ANMAR,,0,0,0,,وفقا للمعلومات السرية التي وصلتني
Dialogue: 0,0:44:02.34,0:44:05.72,ANMAR,,0,0,0,,ربما سيتحسن [غينتا] إذا ما ذهب هناك
Dialogue: 0,0:44:06.77,0:44:09.23,ANMAR,,0,0,0,,لا ادري كيف سيساعد ذلك في التحسن
Dialogue: 0,0:44:09.67,0:44:12.38,ANMAR,,0,0,0,,ولهذا اتينا لنصحبك معنا, ولكن
Dialogue: 0,0:44:12.38,0:44:13.58,ANMAR,,0,0,0,,يبدو  انك ذاهب إلى مكان ما
Dialogue: 0,0:44:14.12,0:44:15.32,ANMAR,,0,0,0,,نعم, تقريباً
Dialogue: 0,0:44:15.71,0:44:16.60,ANMAR,,0,0,0,,تقريباً؟
Dialogue: 0,0:44:17.26,0:44:18.79,ANMAR,,0,0,0,,ليس بالامر المهم
Dialogue: 0,0:44:18.91,0:44:21.62,ANMAR,,0,0,0,,اهو اكثر اهمية من صديقك [غينتا] ؟
Dialogue: 0,0:44:23.22,0:44:24.53,ANMAR,,0,0,0,,ما باليد حيلة
Dialogue: 0,0:44:25.19,0:44:26.42,ANMAR,,0,0,0,,ساذهب إلى منزل الآنسة [رييكو]
Dialogue: 0,0:44:26.91,0:44:27.84,ANMAR,,0,0,0,,المعملة [رييكو] ؟
Dialogue: 0,0:44:28.19,0:44:29.58,ANMAR,,0,0,0,,من الافضل ألا تذهب
Dialogue: 0,0:44:29.97,0:44:32.33,ANMAR,,0,0,0,,لأنها ستثور من الغذب ثانيةً
Dialogue: 0,0:44:32.33,0:44:36.26,ANMAR,,0,0,0,,ربما, ولكن يتوجب عليَّ حمايتها من الاشرار
Dialogue: 0,0:44:36.66,0:44:38.86,ANMAR,,0,0,0,,اتقصد بالاشرار أولئك الذين هاجموها ؟
Dialogue: 0,0:44:39.17,0:44:40.93,ANMAR,,0,0,0,,لما انت مهتم بحمايتها إلى هذه الدرجة ؟
Dialogue: 0,0:44:42.38,0:44:43.95,ANMAR,,0,0,0,,فعلاً, حتى انا اتساءل عن السبب
Dialogue: 0,0:44:44.69,0:44:46.55,ANMAR,,0,0,0,,انا نفسي لا اعرف لماذل, ولكن
Dialogue: 0,0:44:47.21,0:44:50.90,ANMAR,,0,0,0,,لم اتحمل نفسي ابداً إن لم افعل ذلك
Dialogue: 0,0:44:59.80,0:45:02.28,ANMAR,,0,0,0,,إنه يعني انكَ وقعت في حبها
Dialogue: 0,0:45:02.66,0:45:04.71,ANMAR,,0,0,0,,[كونان] يفضل النساء الكبيرات في السن
Dialogue: 0,0:45:05.25,0:45:06.70,ANMAR,,0,0,0,,ماهذا الهراء
Dialogue: 0,0:45:07.32,0:45:09.75,ANMAR,,0,0,0,,على كل حال, سأترك [غينتا] معكما
Dialogue: 0,0:45:10.22,0:45:10.67,ANMAR,,0,0,0,,اعتمد عليكما
Dialogue: 0,0:45:11.07,0:45:11.96,ANMAR,,0,0,0,,[كونان]
Dialogue: 0,0:45:13.46,0:45:16.24,ANMAR,,0,0,0,,هل يقصد بكلامه انه يثق بنا ؟
Dialogue: 0,0:45:17.01,0:45:17.78,ANMAR,,0,0,0,,ربما
Dialogue: 0,0:45:51.97,0:45:52.64,ANMAR,,0,0,0,,اجل
Dialogue: 0,0:45:55.37,0:45:56.84,ANMAR,,0,0,0,,صباح الخير آنسة [رييكو]
Dialogue: 0,0:45:57.15,0:45:58.07,ANMAR,,0,0,0,,اسمحي لي بالدخول
Dialogue: 0,0:45:59.16,0:45:59.97,ANMAR,,0,0,0,,انت ! انتظر
Dialogue: 0,0:46:01.12,0:46:02.51,ANMAR,,0,0,0,,يا لها من شقة جميلة
Dialogue: 0,0:46:02.97,0:46:04.87,ANMAR,,0,0,0,,وهذا الحي يبدو هادئاً للغاية
Dialogue: 0,0:46:06.62,0:46:07.60,ANMAR,,0,0,0,,لحظة ايها الصغير
Dialogue: 0,0:46:08.41,0:46:11.65,ANMAR,,0,0,0,,كيف تقتحم بيوت الناس من دون استئذان ؟
Dialogue: 0,0:46:11.65,0:46:12.36,ANMAR,,0,0,0,,ما الذي تريده ؟
Dialogue: 0,0:46:12.90,0:46:14.21,ANMAR,,0,0,0,,دروساً في الغناء
Dialogue: 0,0:46:14.55,0:46:16.07,ANMAR,,0,0,0,,اريد اخذ دروس مكثفة
Dialogue: 0,0:46:18.00,0:46:19.73,ANMAR,,0,0,0,,تذكرتك الآن
Dialogue: 0,0:46:19.73,0:46:21.04,ANMAR,,0,0,0,,انت الصبي صاحب الاذن اللاموسيقية
Dialogue: 0,0:46:21.70,0:46:22.79,ANMAR,,0,0,0,,لكنني لا استطيع اليوم
Dialogue: 0,0:46:23.18,0:46:24.58,ANMAR,,0,0,0,,هل انتِ ذاهبة للخارج ؟
Dialogue: 0,0:46:25.75,0:46:28.98,ANMAR,,0,0,0,,لقد سمعت انكِ تذهبين إلى الغابة في اليوم\Nالذي يسبق الحفلات الموسيقة أو التسجيل
Dialogue: 0,0:46:28.98,0:46:31.81,ANMAR,,0,0,0,,كيْ ترفهي عن نفسكِ وتعيدي نشاطكِ
Dialogue: 0,0:46:32.32,0:46:34.00,ANMAR,,0,0,0,,بما انك تعلم هذا, فما الذي يبقيكَ هنا ؟
Dialogue: 0,0:46:34.62,0:46:36.86,ANMAR,,0,0,0,,اريد الذهاب معكِ
Dialogue: 0,0:46:36.86,0:46:37.85,ANMAR,,0,0,0,,يا الهي
Dialogue: 0,0:46:37.85,0:46:39.14,ANMAR,,0,0,0,,الم اقل لكم مسبقاً ؟
Dialogue: 0,0:46:40.04,0:46:43.97,ANMAR,,0,0,0,,وجودكم معي يجلب لي الحظ السئ, ابقَ بعيداً عني من فضلك
Dialogue: 0,0:46:44.78,0:46:47.09,ANMAR,,0,0,0,,ولنقل انكِ بقيت بعيدة عنا
Dialogue: 0,0:46:47.09,0:46:48.95,ANMAR,,0,0,0,,فهل ستكوني في مأمن من الاشرار ؟
Dialogue: 0,0:46:50.07,0:46:53.11,ANMAR,,0,0,0,,السبب الحقيقي وراء تصرفاتكِ يا \Nآنسة [رييكو] هو تأكدك من انكِ هدف المجرم
Dialogue: 0,0:46:55.18,0:46:57.55,ANMAR,,0,0,0,,عندما قلتِ إنك تريدين الذهاب إلى منزل [غينتا] في ذلك اليوم
Dialogue: 0,0:46:58.13,0:47:00.53,ANMAR,,0,0,0,,لم يكن لأنك تريدين توبيخ والديه
Dialogue: 0,0:47:00.53,0:47:02.99,ANMAR,,0,0,0,,بل حتى تتأكدي ان [غينتا] سيصل سالماً إلى منزله, أليس كذلك ؟
Dialogue: 0,0:47:04.03,0:47:05.54,ANMAR,,0,0,0,,ما هذا الهراء الذي تهذي به ؟
Dialogue: 0,0:47:06.15,0:47:08.92,ANMAR,,0,0,0,,هلا احضرتِ لي كوباً من العصير من فضلكِ قبل ان تغادري ؟
Dialogue: 0,0:47:08.92,0:47:09.87,ANMAR,,0,0,0,,اشعر بالعطش
Dialogue: 0,0:47:11.49,0:47:12.54,ANMAR,,0,0,0,,ما باليد حيلة
Dialogue: 0,0:47:15.37,0:47:17.65,ANMAR,,0,0,0,,لدي عصير برتقال طبيعي فقط
Dialogue: 0,0:47:18.03,0:47:19.34,ANMAR,,0,0,0,,لا تطلب المستحيل إذن
Dialogue: 0,0:47:19.67,0:47:21.30,ANMAR,,0,0,0,,اجل , انه جيد
Dialogue: 0,0:47:23.10,0:47:23.97,ANMAR,,0,0,0,,فلوت
Dialogue: 0,0:47:24.54,0:47:26.05,ANMAR,,0,0,0,,وهذا الرجل في الصورة
Dialogue: 0,0:47:27.13,0:47:27.43,ANMAR,,0,0,0,,ولد
Dialogue: 0,0:47:29.59,0:47:32.81,ANMAR,,0,0,0,,لا تزال اماكَ عشر سنوات حتى تبدأ غرف السيدات بإثارة اهتمامك
Dialogue: 0,0:47:33.24,0:47:35.85,ANMAR,,0,0,0,,اخبريني يا آنسة [رييكو] هل تعزفين على "الفلوت" ايضاَ ؟
Dialogue: 0,0:47:35.85,0:47:37.40,ANMAR,,0,0,0,,هذا ليس من شأنك
Dialogue: 0,0:47:37.98,0:47:39.44,ANMAR,,0,0,0,,عد فوراً إلى منزلك بعد ان تشرب العصير
Dialogue: 0,0:47:40.02,0:47:41.30,ANMAR,,0,0,0,,لن اعطيك اي درس في الغناء
Dialogue: 0,0:47:41.92,0:47:43.51,ANMAR,,0,0,0,,كما انني لم آخذك معي إلى الغابة
Dialogue: 0,0:47:46.41,0:47:47.38,ANMAR,,0,0,0,,حاضر
Dialogue: 0,0:47:59.95,0:48:02.18,ANMAR,,0,0,0,,سأتبعكِ عن بعد, لا تعيريني أي اهتمام
Dialogue: 0,0:48:03.43,0:48:03.93,ANMAR,,0,0,0,,على العموم
Dialogue: 0,0:48:04.69,0:48:06.35,ANMAR,,0,0,0,,لن اتحمل المسؤولية ان ضعت
Dialogue: 0,0:48:08.67,0:48:09.84,ANMAR,,0,0,0,,لا تقلقي .. لا تقلقي
Dialogue: 0,0:48:13.98,0:48:14.67,ANMAR,,0,0,0,,ايها [المفتش ميغوري]
Dialogue: 0,0:48:16.33,0:48:18.53,ANMAR,,0,0,0,,وجدنا صلة تربط الآنسة [أكيبا] بالضحايا الاربعة
Dialogue: 0,0:48:18.75,0:48:19.35,ANMAR,,0,0,0,,ماذا؟
Dialogue: 0,0:48:20.13,0:48:21.11,ANMAR,,0,0,0,,قبل ثلاث سنوات, وتحديدا في شهر يناير
Dialogue: 0,0:48:21.80,0:48:25.06,ANMAR,,0,0,0,,وفي نُزلٍ تابع لأكاديمية (دوموتو) بمنطقة (إيزو)
Dialogue: 0,0:48:25.06,0:48:27.70,ANMAR,,0,0,0,,"كان يقيم معهم عازف للـ "فولت
Dialogue: 0,0:48:28.13,0:48:32.41,ANMAR,,0,0,0,,وذات ليلة, أسرف ذلك الشخص في الشرب\Nفسقط من اعلى جرف مجاورٍ لاقياً مصرعه
Dialogue: 0,0:48:32.66,0:48:35.29,ANMAR,,0,0,0,,انه يدعى السيد [سوما هيكارو], وكان وقتها في الثامنة والعشرين من العمر
Dialogue: 0,0:48:35.53,0:48:37.59,ANMAR,,0,0,0,,وهو من خريجي الدفعة السادسة للأكاديمية
Dialogue: 0,0:48:38.47,0:48:39.75,ANMAR,,0,0,0,,ايعقل ان تكون لديهم يد في مقتله ؟
Dialogue: 0,0:48:40.23,0:48:41.04,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:48:41.04,0:48:44.81,ANMAR,,0,0,0,,لقد أجبروه على الشرب رغم كونه لا يحتمل تأثير الخمور ابداً
Dialogue: 0,0:48:45.44,0:48:50.47,ANMAR,,0,0,0,, وحيث إن هذا لا يعد سبباً مباشراً لسقوطه, فقد أغلق ملف التحقيق على كونها حادثة قضاء وقدر
Dialogue: 0,0:48:50.93,0:48:52.22,ANMAR,,0,0,0,,فهمت
Dialogue: 0,0:48:52.22,0:48:54.60,ANMAR,,0,0,0,,وما علاقة الآنسة [اكيبا] بكل هذا
Dialogue: 0,0:48:55.05,0:48:58.98,ANMAR,,0,0,0,,ذلك السيد المدعو [سوما] كان خيب الآنسة [أكيبا] في الواقع
Dialogue: 0,0:48:59.32,0:48:59.91,ANMAR,,0,0,0,,ماذا ؟
Dialogue: 0,0:49:00.32,0:49:00.95,ANMAR,,0,0,0,,سيدي
Dialogue: 0,0:49:02.20,0:49:06.47,ANMAR,,0,0,0,,هذا يقودنا إلى احتمال ان الآنسة كانت تكنُ الضعينة للضحايا الأربع
Dialogue: 0,0:49:07.60,0:49:10.91,ANMAR,,0,0,0,,ولكن, لماذا تمت مهاجمتها هي الأخرى ؟
Dialogue: 0,0:49:42.61,0:49:43.58,ANMAR,,0,0,0,,مرحباً
Dialogue: 0,0:49:44.09,0:49:44.65,ANMAR,,0,0,0,,مرحباً
Dialogue: 0,0:49:47.38,0:49:47.82,ANMAR,,0,0,0,,مرحباً
Dialogue: 0,0:49:51.81,0:49:53.63,ANMAR,,0,0,0,,هل هي امه يا ترى ؟
Dialogue: 0,0:49:53.91,0:49:55.61,ANMAR,,0,0,0,,انهما لا يشبهان بعضهما ابداً
Dialogue: 0,0:49:55.95,0:49:58.15,ANMAR,,0,0,0,,لم يسيران بعيداً عن بعضهما ؟
Dialogue: 0,0:49:58.72,0:50:00.79,ANMAR,,0,0,0,,ربما فعل شيئاً أغضب والدته
Dialogue: 0,0:50:03.17,0:50:03.93,ANMAR,,0,0,0,,تباً
Dialogue: 0,0:50:03.93,0:50:04.52,ANMAR,,0,0,0,,أخبرني
Dialogue: 0,0:50:05.31,0:50:09.43,ANMAR,,0,0,0,,هل تعلم لماذا اتمشى في الغابة في اليوم الذي يسبق الحفل مباشرة ؟
Dialogue: 0,0:50:11.54,0:50:14.64,ANMAR,,0,0,0,,لأنني اريد ان احبس الطبيعية في جسدي
Dialogue: 0,0:50:15.24,0:50:20.54,ANMAR,,0,0,0,,فالموسيقى الاوروبية استوحت الفذ من الطبيعية الخلابة{\b1}
Dialogue: 0,0:50:31.11,0:50:32.12,ANMAR,,0,0,0,,هل تفهم ما اعنيه ؟
Dialogue: 0,0:50:32.78,0:50:33.34,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:50:34.18,0:50:35.38,ANMAR,,0,0,0,,أظنني فهمت
Dialogue: 0,0:50:47.41,0:50:48.67,ANMAR,,0,0,0,,هل انت بخير يا ىنسة [رييكو] ؟
Dialogue: 0,0:50:49.26,0:50:49.86,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:50:56.33,0:50:56.86,ANMAR,,0,0,0,,أركضي
Dialogue: 0,0:51:07.03,0:51:07.69,ANMAR,,0,0,0,,بسرعة إلى الامام
Dialogue: 0,0:51:08.79,0:51:10.28,ANMAR,,0,0,0,,لقد هاجمها  كما توقعت
Dialogue: 0,0:51:20.88,0:51:21.62,ANMAR,,0,0,0,,تباً
Dialogue: 0,0:51:26.06,0:51:26.84,ANMAR,,0,0,0,,سيُطلق الآن
Dialogue: 0,0:51:35.86,0:51:37.14,ANMAR,,0,0,0,,آنسة [رييكو] من هنا
Dialogue: 0,0:51:38.74,0:51:39.56,ANMAR,,0,0,0,,لماذا ؟
Dialogue: 0,0:51:39.78,0:51:40.78,ANMAR,,0,0,0,,لماذا لم يطلق النار ؟
Dialogue: 0,0:51:42.26,0:51:43.64,ANMAR,,0,0,0,,ما الذي يسعى اليه ؟
Dialogue: 0,0:51:51.15,0:51:54.69,ANMAR,,0,0,0,,أخبريني, أليس من الافضل ان نخبر الشرطة بما جرى ؟
Dialogue: 0,0:51:54.69,0:51:55.67,ANMAR,,0,0,0,,لا يمكن
Dialogue: 0,0:51:55.67,0:51:58.33,ANMAR,,0,0,0,,سبقَ واخبرتك .. إذا اخبرنا الشرطة بما جرى
Dialogue: 0,0:51:59.06,0:52:03.89,ANMAR,,0,0,0,,فسيستغرق التحقيق وقتاً طويلا, وهو ما قد يعطلكم عن حفل الغد, أليس كذلك؟
Dialogue: 0,0:52:03.89,0:52:05.17,ANMAR,,0,0,0,,افهم ذلك ولكن
Dialogue: 0,0:52:05.78,0:52:07.25,ANMAR,,0,0,0,,ما دمت تفهم ذلك فالزم الصمت إذن
Dialogue: 0,0:52:08.19,0:52:10.83,ANMAR,,0,0,0,,سأخبرهم بكل شيء يعد انتهاء الحفل
Dialogue: 0,0:52:11.58,0:52:12.01,ANMAR,,0,0,0,,هل فهمت ؟
Dialogue: 0,0:52:12.59,0:52:13.40,ANMAR,,0,0,0,,نعم
Dialogue: 0,0:52:18.21,0:52:19.10,ANMAR,,0,0,0,,الضابط [تاغاكي] ؟
Dialogue: 0,0:52:20.03,0:52:21.29,ANMAR,,0,0,0,,آنسة [أكايببا] ؟
Dialogue: 0,0:52:21.29,0:52:22.22,ANMAR,,0,0,0,,و [كونان] أيضاً ؟
Dialogue: 0,0:52:26.75,0:52:29.42,ANMAR,,0,0,0,,اين كنت يا آنسة [أكيببا] ؟
Dialogue: 0,0:52:29.42,0:52:30.99,ANMAR,,0,0,0,,ألم تخبرينا انكِ لن تخرجي من منزلكِ اليوم ؟
Dialogue: 0,0:52:30.99,0:52:32.52,ANMAR,,0,0,0,,كان عندي موعد مع هذا الصبي
Dialogue: 0,0:52:33.15,0:52:34.24,ANMAR,,0,0,0,,مـ ... موعد ؟
Dialogue: 0,0:52:34.63,0:52:36.95,ANMAR,,0,0,0,,آنسة [اكيبا].. نود التحدث إليك عن موضوع مهم
Dialogue: 0,0:52:36.95,0:52:37.86,ANMAR,,0,0,0,,في وقت اخر
Dialogue: 0,0:52:39.15,0:52:41.28,ANMAR,,0,0,0,,ماذا لو كان بخصوص السيد [سوما هيكارو] ؟
Dialogue: 0,0:52:43.64,0:52:46.87,ANMAR,,0,0,0,,السيد [سوما هيكارو] كان خطيبك, اليس كذلك ؟
Dialogue: 0,0:52:48.88,0:52:49.55,ANMAR,,0,0,0,,حضرة المفتش
Dialogue: 0,0:52:50.20,0:52:52.24,ANMAR,,0,0,0,,سأخبرك بكل ما أعرفه
Dialogue: 0,0:52:53.21,0:52:56.23,ANMAR,,0,0,0,,لكن, كل ما اطلبه هو أن تؤجل ذلك إلى ما بعد حفل الغد
Dialogue: 0,0:53:02.85,0:53:03.92,ANMAR,,0,0,0,,عفواً حضرة المفتش
Dialogue: 0,0:53:04.49,0:53:07.44,ANMAR,,0,0,0,,هل كان للسيد [سوما] شامة هنا ؟
Dialogue: 0,0:53:08.03,0:53:10.28,ANMAR,,0,0,0,,أجل, كيف عرفت ذلك ؟
Dialogue: 0,0:53:11.27,0:53:13.95,ANMAR,,0,0,0,,رأيت صورة له في شقة الىنسة [رييكو]
Dialogue: 0,0:53:15.19,0:53:17.12,ANMAR,,0,0,0,,صورة له في شقة الآنسة [أكيبا] ؟
Dialogue: 0,0:53:18.65,0:53:20.53,ANMAR,,0,0,0,,ما رأيكم ان توصلوني إلى المنزل, وهناك سأخبركم بكل شيء
Dialogue: 0,0:53:24.52,0:53:27.29,ANMAR,,0,0,0,,وهكذا اوصلنا [كونان] إلى هنا
Dialogue: 0,0:53:27.69,0:53:34.63,ANMAR,,0,0,0,,اتضح في النهاية, ان كل ما يعرفه, هو انها تحتفظ\N"في شقتها بصورة للسيد [سوما], إضافة إلى "الفلوت
Dialogue: 0,0:53:35.69,0:53:36.48,ANMAR,,0,0,0,,تباً
Dialogue: 0,0:53:37.51,0:53:38.64,ANMAR,,0,0,0,,ولكن حضرة المفتش
Dialogue: 0,0:53:39.18,0:53:43.04,ANMAR,,0,0,0,,حتى وان كان لديها دافع قوي لقتل أولئك الاربعة
Dialogue: 0,0:53:43.04,0:53:45.25,ANMAR,,0,0,0,,فهذا لا يكفي أبداً لوضعها في قفص الاتهام
Dialogue: 0,0:53:45.25,0:53:47.78,ANMAR,,0,0,0,,لا تنس انها هوجمت من قبل شاحنة
Dialogue: 0,0:53:48.82,0:53:49.73,ANMAR,,0,0,0,,بالمناسبة
Dialogue: 0,0:53:49.73,0:53:54.15,ANMAR,,0,0,0,,هل للسيد [سوما] أقارب ربما يفكرون بالانتقام له ؟
Dialogue: 0,0:53:54.51,0:53:56.41,ANMAR,,0,0,0,,كلا, لا أظن ذلك
Dialogue: 0,0:53:57.37,0:53:58.25,ANMAR,,0,0,0,,المعذرة
Dialogue: 0,0:53:58.25,0:53:59.62,ANMAR,,0,0,0,,لقد اعددت لكم الشاي
Dialogue: 0,0:53:59.62,0:54:00.33,ANMAR,,0,0,0,,شكراً لك
Dialogue: 0,0:54:01.08,0:54:01.97,ANMAR,,0,0,0,,معذرة لاتعابك معنا يا [ران]
Dialogue: 0,0:54:02.39,0:54:02.97,ANMAR,,0,0,0,,تفضل
Dialogue: 0,0:54:07.80,0:54:08.73,ANMAR,,0,0,0,,لنرَ
Dialogue: 0,0:54:08.73,0:54:12.17,ANMAR,,0,0,0,,والدته لن تتزوج غير والده, وقد وافتها المنية قبل خمس سنوات
Dialogue: 0,0:54:12.89,0:54:14.38,ANMAR,,0,0,0,,كما انه ليس لديه اشقاء
Dialogue: 0,0:54:14.38,0:54:15.25,ANMAR,,0,0,0,,ماذا عن والده ؟
Dialogue: 0,0:54:15.66,0:54:16.84,ANMAR,,0,0,0,,ليست لدينا أية معلومات عنه
Dialogue: 0,0:54:17.37,0:54:19.20,ANMAR,,0,0,0,,حتى إننا لا ندري إن كان لا يزال على قيد الحياة
Dialogue: 0,0:54:20.83,0:54:21.59,ANMAR,,0,0,0,,هذا
Dialogue: 0,0:54:26.54,0:54:30.61,ANMAR,,0,0,0,,هناك امرآخر مهم جداً يخص الضحايا الاربع
Dialogue: 0,0:54:31.09,0:54:34.80,ANMAR,,0,0,0,,لقد أدو حفلة ذات مرة وهم سُكارى
Dialogue: 0,0:54:34.80,0:54:37.57,ANMAR,,0,0,0,,فما كان من السيد [دوموتو] إلا ان وبخهم وبشدة
Dialogue: 0,0:54:37.57,0:54:38.88,ANMAR,,0,0,0,,ماذا تقول ؟
Dialogue: 0,0:54:38.88,0:54:40.28,ANMAR,,0,0,0,,متى حدث ذلك ؟
Dialogue: 0,0:54:40.28,0:54:41.45,ANMAR,,0,0,0,,حسنٌ
Dialogue: 0,0:54:41.59,0:54:42.55,ANMAR,,0,0,0,,لنرَ
Dialogue: 0,0:54:43.58,0:54:44.21,ANMAR,,0,0,0,,ها هي
Dialogue: 0,0:54:44.81,0:54:46.39,ANMAR,,0,0,0,,تلك الحفلة كانت في السنة الماضية
Dialogue: 0,0:54:46.39,0:54:49.54,ANMAR,,0,0,0,,وقد عزفو مقطوعة "بيانو" رباعية لــ بيتهوفن
Dialogue: 0,0:54:52.24,0:54:53.92,ANMAR,,0,0,0,,عرفت كل شيء ايها المفتش
Dialogue: 0,0:54:54.72,0:55:02.35,ANMAR,,0,0,0,,عرفت الدافع والمجرم الذي قتل الاربعة, وإصتبة [كابي]\Nبإصابات بالغة, حقيقة الهجوم على الآنسة [أكيبا]
Dialogue: 0,0:55:03.60,0:55:04.68,ANMAR,,0,0,0,,حقاً انت جاد يا [موري] ؟
Dialogue: 0,0:55:05.34,0:55:05.88,ANMAR,,0,0,0,,أجل
Dialogue: 0,0:55:06.27,0:55:07.63,ANMAR,,0,0,0,,المجرم هو
Dialogue: 0,0:55:09.50,0:55:10.77,ANMAR,,0,0,0,,سيد [دوموتو غينيا]
Dialogue: 0,0:55:11.15,0:55:12.06,ANMAR,,0,0,0,,إنه انت
Dialogue: 0,0:55:16.36,0:55:17.58,ANMAR,,0,0,0,,والسبب
Dialogue: 0,0:55:17.58,0:55:19.24,ANMAR,,0,0,0,,انك شديد الاعجاب ببتهوفن
Dialogue: 0,0:55:20.02,0:55:20.49,ANMAR,,0,0,0,,لدرجة
Dialogue: 0,0:55:21.89,0:55:25.41,ANMAR,,0,0,0,,لدرجة انك اصبحت متطرفاً
Dialogue: 0,0:55:29.35,0:55:30.12,ANMAR,,0,0,0,,هاي...هاي
Dialogue: 0,0:55:30.64,0:55:32.33,ANMAR,,0,0,0,,ما هذا الهراء الذي تهذي به ؟
Dialogue: 0,0:55:32.99,0:55:39.01,ANMAR,,0,0,0,,قتلت الاربعة لانهم أدو عملاً في غلية السوء لـ بيتهوفن نتيجة اسرافهم في الشرب
Dialogue: 0,0:55:39.29,0:55:43.40,ANMAR,,0,0,0,,اعتبرتها إهانة كبيرة في حق ملحن بحجمه
Dialogue: 0,0:55:43.83,0:55:52.15,ANMAR,,0,0,0,,كما تسببت بإصابات بالغة للآنسة [كابي], لأن أداءها \Nللمقطوعة في آخر مرة علمتُمها فيها سوية كان مغايراً كلياً لأدائك
Dialogue: 0,0:55:53.87,0:55:57.45,ANMAR,,0,0,0,,هذا ما ورد, وبأدق التفاصيل, في مذكرة الآنسة [كابي] اليومية
Dialogue: 0,0:55:58.12,0:56:01.95,ANMAR,,0,0,0,,"واخيراً, قمت بمهاجمة الآنسة [أكيبا] وذلك لانها قالت في "البروفة
Dialogue: 0,0:56:03.74,0:56:05.64,ANMAR,,0,0,0,,اتمنى ألا يكون ما ستؤدونه هو مقطوعة دايكو التاسعة
Dialogue: 0,0:56:06.14,0:56:07.91,ANMAR,,0,0,0,,لاني لا احب سماع تلك المقطوعة
Dialogue: 0,0:56:08.97,0:56:11.83,ANMAR,,0,0,0,,عددت كلاهمها إهانة لمقطوعة بيتهوفن التاسعة
Dialogue: 0,0:56:13.72,0:56:14.95,ANMAR,,0,0,0,,انتظر لحظة من فضلك
Dialogue: 0,0:56:15.35,0:56:16.92,ANMAR,,0,0,0,,صحيح انني معجب بــ بيتهوفن
Dialogue: 0,0:56:17.18,0:56:20.62,ANMAR,,0,0,0,,واكن له كل الاحترام .. لكنني لن اقوم بتصرف بشع كهذا
Dialogue: 0,0:56:20.96,0:56:22.30,ANMAR,,0,0,0,,كلا, لا شك في ذلك
Dialogue: 0,0:56:23.19,0:56:27.43,ANMAR,,0,0,0,,وتسريحة شعرك المشابه تماماً لتسريحة \Nشعر بيتهوفن هي الدليل القاطع على صحة استنتاجي
Dialogue: 0,0:56:30.47,0:56:31.27,ANMAR,,0,0,0,,مــ .. [موري] ؟
Dialogue: 0,0:56:34.80,0:56:36.32,ANMAR,,0,0,0,,لا بد انك تمزح ؟
Dialogue: 0,0:56:36.32,0:56:37.69,ANMAR,,0,0,0,,هذه تسريحة شعري الطبيعية
Dialogue: 0,0:56:39.74,0:56:41.29,ANMAR,,0,0,0,,كل ما في الامر انني اشبه والدتي الراحلة
Dialogue: 0,0:56:41.83,0:56:42.99,ANMAR,,0,0,0,,وان كنت لا تصدقني
Dialogue: 0,0:56:45.21,0:56:45.74,ANMAR,,0,0,0,,فأنظر من فضلك
Dialogue: 0,0:56:48.59,0:56:50.12,ANMAR,,0,0,0,,بالفعل
Dialogue: 0,0:56:50.12,0:56:51.37,ANMAR,,0,0,0,,انه يشببها كثيراً
Dialogue: 0,0:56:53.04,0:56:54.15,ANMAR,,0,0,0,,ما رأيك الآن ؟
Dialogue: 0,0:56:54.15,0:56:56.03,ANMAR,,0,0,0,,بالنسبة للضحايا الاربع والآنسة [اكيببا]
Dialogue: 0,0:56:56.55,0:56:59.99,ANMAR,,0,0,0,,فلا تربطني بهم أية علاقة سوى بيتهوفن
Dialogue: 0,0:57:00.35,0:57:02.72,ANMAR,,0,0,0,,ولا تنسى ايضاً  انني والآنسة [كابي] موسيقيان
Dialogue: 0,0:57:02.91,0:57:06.93,ANMAR,,0,0,0,,وغالبا ما تنشب خلافات بسبب اختلاف طريقة أدائنا
Dialogue: 0,0:57:07.40,0:57:09.97,ANMAR,,0,0,0,,الامر بطريقة الاداء ليس إلا
Dialogue: 0,0:57:09.97,0:57:12.30,ANMAR,,0,0,0,,لن نكره بعضنا لسبب تافه كهذا
Dialogue: 0,0:57:12.67,0:57:14.64,ANMAR,,0,0,0,,لا تكرر هذه السخافات مرة اخرى لو سمحت
Dialogue: 0,0:57:15.24,0:57:16.46,ANMAR,,0,0,0,,لا... اعني
Dialogue: 0,0:57:16.46,0:57:17.22,ANMAR,,0,0,0,,سيدي المفتش
Dialogue: 0,0:57:17.82,0:57:22.26,ANMAR,,0,0,0,,هل جئتم في هذا الوقت المتأخر لتسمعونا هذا الاستنتاج المضحك؟
Dialogue: 0,0:57:23.36,0:57:26.45,ANMAR,,0,0,0,,وفوق كل هذا لدينا حفل في غية الاهمية في الغد
Dialogue: 0,0:57:28.00,0:57:28.91,ANMAR,,0,0,0,,هذا صحيح
Dialogue: 0,0:57:30.04,0:57:31.95,ANMAR,,0,0,0,,على كل حال ارجو ان تغادروا الان
Dialogue: 0,0:57:32.51,0:57:37.19,ANMAR,,0,0,0,,وبعد انتهاء الحفل, سنجيب عن كل اسئلتكم بالشكل الذي يرضيكم
Dialogue: 0,0:57:38.81,0:57:42.30,ANMAR,,0,0,0,,يا الهاي ! كنت اظن انني على حق
Dialogue: 0,0:57:42.80,0:57:45.13,ANMAR,,0,0,0,,من اين اتيت بكل هذه الثقة
Dialogue: 0,0:57:46.18,0:57:47.54,ANMAR,,0,0,0,,عفواً أيها الضابط [تاكاغي]
Dialogue: 0,0:57:47.87,0:57:50.50,ANMAR,,0,0,0,,ألم تستعد الآنسة [كابي] ذاكرتها بعد ؟
Dialogue: 0,0:57:50.50,0:57:52.10,ANMAR,,0,0,0,,ليس بعد
Dialogue: 0,0:57:52.10,0:57:55.02,ANMAR,,0,0,0,,بدأت تستعيد قدراتها على التحدث عن بعض الاشياء
Dialogue: 0,0:57:55.38,0:57:59.79,ANMAR,,0,0,0,,ولكنها تقول اشياء مثل كونها تلاحظ طبقة الصوت\Nالصادر عن جهاز التكييف وان ذلك يمنعها من النوم
Dialogue: 0,0:57:59.79,0:58:02.48,ANMAR,,0,0,0,,لا شك انها تتحدث عن اشياء مبهمة
Dialogue: 0,0:58:03.51,0:58:05.54,ANMAR,,0,0,0,,طبقة الصوت الصادر عن جهاز التكييف ؟
Dialogue: 0,0:58:06.31,0:58:07.17,ANMAR,,0,0,0,,ايعقل انها...؟
Dialogue: 0,0:58:11.08,0:58:13.45,ANMAR,,0,0,0,,لا تأخذه الآن
Dialogue: 0,0:58:13.59,0:58:14.95,ANMAR,,0,0,0,,أسفة حقاً
Dialogue: 0,0:58:14.95,0:58:15.77,ANMAR,,0,0,0,,رجاءً, استخدموا هذه
Dialogue: 0,0:58:16.11,0:58:16.41,ANMAR,,0,0,0,,حسنٌ
Dialogue: 0,0:58:18.07,0:58:20.99,ANMAR,,0,0,0,,ستكون مثل الحفل الرسمي تماماً
Dialogue: 0,0:58:20.99,0:58:26.83,ANMAR,,0,0,0,,ما يجعل حضور "البروفة" النهائية أمر جديراً بالاهتمام, وهو حصولك على\Nفرصة لاختيار مقعدك في قاعة فارغة, ثم الاستماع إليهم وهم يعزفون
Dialogue: 0,0:58:35.70,0:58:37.81,ANMAR,,0,0,0,,سنجلس في مقاعد الطابق العلوي اثناء الحفل الرسمي
Dialogue: 0,0:58:38.41,0:58:39.94,ANMAR,,0,0,0,,لقد طلبت من ابي ان يحجزهل لنا
Dialogue: 0,0:58:41.78,0:58:43.18,ANMAR,,0,0,0,,اتعنين تلك الشرفة ؟
Dialogue: 0,0:58:43.58,0:58:47.07,ANMAR,,0,0,0,,يوجد فيها عشرة مقاعد وجميعها محجوزة لنا
Dialogue: 0,0:58:47.93,0:58:49.01,ANMAR,,0,0,0,,عشرة مقاعد لنا ؟
Dialogue: 0,0:58:49.25,0:58:51.66,ANMAR,,0,0,0,,لقد دعوت البروفسور [أغاسا] والاطفال ايضاً
Dialogue: 0,0:58:52.20,0:58:53.88,ANMAR,,0,0,0,,كما حجزت مقعداً لــ[شينتشي]
Dialogue: 0,0:58:55.84,0:58:56.90,ANMAR,,0,0,0,,اخبريه بذلك
Dialogue: 0,0:58:57.41,0:58:59.65,ANMAR,,0,0,0,,سنترك له التذكرة عند مكتب الاستقبال
Dialogue: 0,0:59:00.15,0:59:01.44,ANMAR,,0,0,0,,لا تقلقي بشأنه
Dialogue: 0,0:59:01.80,0:59:04.88,ANMAR,,0,0,0,,لا عليك, هيا اسرعي وأخبرية حتى لا يذهب مقعده سُدىً
Dialogue: 0,0:59:05.08,0:59:06.46,ANMAR,,0,0,0,,ما باليد حيلة
Dialogue: 0,0:59:06.98,0:59:08.38,ANMAR,,0,0,0,,لا أظنه سيأتي
Dialogue: 0,0:59:10.59,0:59:11.74,ANMAR,,0,0,0,,اسف حقاً يا [ران]
Dialogue: 0,0:59:18.50,0:59:21.69,ANMAR,,0,0,0,,يبدو انك كتمت ما حصل معنا البارحة عن الشرطة
Dialogue: 0,0:59:22.38,0:59:24.06,ANMAR,,0,0,0,,انا ممتنة لك
Dialogue: 0,0:59:24.51,0:59:26.12,ANMAR,,0,0,0,,ليس هذا هو الامر المهم
Dialogue: 0,0:59:26.12,0:59:27.56,ANMAR,,0,0,0,,كيف حال الجرح في ساقكِ ؟
Dialogue: 0,0:59:28.71,0:59:30.17,ANMAR,,0,0,0,,لن يؤثر اطلاقا على غنائي
Dialogue: 0,0:59:31.36,0:59:32.22,ANMAR,,0,0,0,,بالمناسبة
Dialogue: 0,0:59:32.22,0:59:35.33,ANMAR,,0,0,0,,الآنسة [كابي] تمتلك مثلكِ موهبة الحس الموسيقي الفائق, اليس كذلك ؟
Dialogue: 0,0:59:35.90,0:59:39.32,ANMAR,,0,0,0,,أجل, استنتجت ذلك عندما قابلتها اول مرة
Dialogue: 0,0:59:39.32,0:59:40.79,ANMAR,,0,0,0,,وبعدها اصبحنا صديقتين حميمتين
Dialogue: 0,0:59:41.56,0:59:42.38,ANMAR,,0,0,0,,هل يهمك ذلك ؟
Dialogue: 0,0:59:43.70,0:59:44.75,ANMAR,,0,0,0,,إطلاقاً
Dialogue: 0,0:59:45.96,0:59:46.42,ANMAR,,0,0,0,,حقاً ؟
Dialogue: 0,0:59:48.16,0:59:49.05,ANMAR,,0,0,0,,حسنٌ, سأذهب الآن
Dialogue: 0,0:59:50.38,0:59:51.77,ANMAR,,0,0,0,,حظاً طيباً في الحفل
Dialogue: 0,0:59:55.95,0:59:58.79,ANMAR,,0,0,0,,الانستان [ريكو و كابي] تمتلكان موهبة الحس الموسقي الفائق
Dialogue: 0,0:59:59.66,1:00:00.35,ANMAR,,0,0,0,,هذا يعني
Dialogue: 0,1:00:01.32,1:00:04.33,ANMAR,,0,0,0,,أرسلت له رسالة نصية, لكوني سأنزعج لو حادثته
Dialogue: 0,1:00:04.68,1:00:05.56,ANMAR,,0,0,0,,حقاً ؟
Dialogue: 0,1:00:05.56,1:00:07.19,ANMAR,,0,0,0,,سيكون أمراً رائعاً لو تمكن [شينتشي] من الحضور
Dialogue: 0,1:00:08.16,1:00:10.40,ANMAR,,0,0,0,,لا يهمني ان اتى ام لا
Dialogue: 0,1:00:10.84,1:00:12.41,ANMAR,,0,0,0,,كل ما في الامر ان مقعده سيذهب سدىً
Dialogue: 0,1:00:12.93,1:00:14.91,ANMAR,,0,0,0,,هذا ما قلته لكِ قبل قليل
Dialogue: 0,1:00:14.91,1:00:15.81,ANMAR,,0,0,0,,حقاً
Dialogue: 0,1:00:16.54,1:00:19.19,ANMAR,,0,0,0,,لا تشغلوا بالكم, سنبدأ من دونه
Dialogue: 0,1:00:21.78,1:00:22.83,ANMAR,,0,0,0,,هل من مشكلة ؟
Dialogue: 0,1:00:23.57,1:00:24.56,ANMAR,,0,0,0,,سيد [موري]
Dialogue: 0,1:00:25.16,1:00:26.92,ANMAR,,0,0,0,,لم يحضر السيد [مولر] بعد
Dialogue: 0,1:00:27.70,1:00:28.97,ANMAR,,0,0,0,,"اتقصد ضابط إقاع "الاروغن
Dialogue: 0,1:00:29.65,1:00:33.30,ANMAR,,0,0,0,,اتفقنا على ان يحضر "البروفة" النهائية ليقوم بما يلزم من الضبط النهائي
Dialogue: 0,1:00:33.78,1:00:35.32,ANMAR,,0,0,0,,يا إلهي ! هذا مزعج فعلاً
Dialogue: 0,1:00:36.47,1:00:41.18,ANMAR,,0,0,0,,لم يرد على أيّ من مكالماتي, كما اخبرني موظفو الفندق لم يعد منذ ليلة البارحة
Dialogue: 0,1:00:42.37,1:00:43.14,ANMAR,,0,0,0,,منذ ليلة البارحة ؟
Dialogue: 0,1:00:44.03,1:00:49.46,ANMAR,,0,0,0,,كل ما تبقى هو الضبط النهائي, أي ان عدم حضورة ليس بتلك المشكلة
Dialogue: 0,1:00:49.80,1:00:52.10,ANMAR,,0,0,0,,لكن, ألا يعني هذا أنه مفقود ؟
Dialogue: 0,1:00:52.49,1:00:54.11,ANMAR,,0,0,0,,هل اخبرتم الشرطة بالأمر ؟
Dialogue: 0,1:00:54.67,1:00:55.10,ANMAR,,0,0,0,,كلا
Dialogue: 0,1:00:55.66,1:00:59.10,ANMAR,,0,0,0,,التحقيق سيستغرق وقتاً طويلا مما قد يتسبب لنا بمشاكل
Dialogue: 0,1:00:59.86,1:01:02.97,ANMAR,,0,0,0,,كل ما يهمنا الآن هو التركيز على الحفل الموسيقي فقط
Dialogue: 0,1:01:15.88,1:01:17.80,ANMAR,,0,0,0,,وكأن التي امامي ليست الآنسة [شيون]
Dialogue: 0,1:02:39.82,1:02:41.02,ANMAR,,0,0,0,,صوتها
Dialogue: 0,1:03:03.21,1:03:05.66,ANMAR,,0,0,0,,عزف الأنسة [شيون] على الكمان كان في غاية الروعة
Dialogue: 0,1:03:05.66,1:03:08.76,ANMAR,,0,0,0,,فعلاً, كان مغايراً تماماً لأدائها في "البروفة" السابقة
Dialogue: 0,1:03:09.50,1:03:13.27,ANMAR,,0,0,0,,لقد جعلت "التراديفاريوس" ملكها
Dialogue: 0,1:03:13.46,1:03:14.55,ANMAR,,0,0,0,,ما دخلك بالموسيقى ايها الشقي ؟
Dialogue: 0,1:03:15.33,1:03:17.83,ANMAR,,0,0,0,,ناهيكم عن غناء الآنسة [رييكا] المذهل
Dialogue: 0,1:03:22.87,1:03:24.02,ANMAR,,0,0,0,,[كونان]
Dialogue: 0,1:03:27.65,1:03:29.12,ANMAR,,0,0,0,,لقد حضرتم مبكراً جداً يا رفاق
Dialogue: 0,1:03:29.55,1:03:32.14,ANMAR,,0,0,0,,بما انهم لن يسمحوا لأحد بالدخول اذا ما تأخر دقيقة واحدة
Dialogue: 0,1:03:32.80,1:03:34.82,ANMAR,,0,0,0,,طلبنا من البروفسور ان يحضرنا إلى هنا باكراً
Dialogue: 0,1:03:35.28,1:03:37.15,ANMAR,,0,0,0,,مال الذي تحمله في يدك ؟
Dialogue: 0,1:03:38.66,1:03:39.86,ANMAR,,0,0,0,,اليس هذا "ريكوردر" ؟
Dialogue: 0,1:03:40.40,1:03:42.15,ANMAR,,0,0,0,,ايها الاحمق
Dialogue: 0,1:03:42.15,1:03:45.49,ANMAR,,0,0,0,,كيف تحضر معك شيئاً كهذا إلى حفلٍ موسيقي كلاسيكي ؟
Dialogue: 0,1:03:45.49,1:03:46.91,ANMAR,,0,0,0,,لا تصرخ عليه
Dialogue: 0,1:03:46.91,1:03:50.96,ANMAR,,0,0,0,,[غينتا] يريد ان يصدر بعض النغمات فقط, كونة لا يستطيع الكلام
Dialogue: 0,1:03:50.96,1:03:52.17,ANMAR,,0,0,0,,وان يكن
Dialogue: 0,1:03:52.73,1:03:55.48,ANMAR,,0,0,0,,لن يستعمله بالطبع اثناء الحفل
Dialogue: 0,1:03:56.02,1:03:57.03,ANMAR,,0,0,0,,اليس كذلك يا [غينتا] ؟
Dialogue: 0,1:03:59.34,1:04:01.25,ANMAR,,0,0,0,,"هذا يعني "أجل
Dialogue: 0,1:04:02.87,1:04:04.53,ANMAR,,0,0,0,,أخفِه عندما تدخل للقاعة
Dialogue: 0,1:04:05.71,1:04:07.81,ANMAR,,0,0,0,,والهواتف النقالة ممنوعة ايضاً
Dialogue: 0,1:04:08.17,1:04:09.51,ANMAR,,0,0,0,,يعلمون هذا
Dialogue: 0,1:04:09.51,1:04:11.85,ANMAR,,0,0,0,,حتى انهم لم يحضروا شارات المحققين معهم
Dialogue: 0,1:04:12.11,1:04:13.73,ANMAR,,0,0,0,,بالمناسبة انا جائعة جداً
Dialogue: 0,1:04:16.37,1:04:18.20,ANMAR,,0,0,0,,اكل شيئاحسنُ بما اننا نشعر بالجوع., فلم لا نأكل شيئاً ؟
Dialogue: 0,1:04:18.72,1:04:19.68,ANMAR,,0,0,0,,فكرة جيدة
Dialogue: 0,1:04:19.68,1:04:23.11,ANMAR,,0,0,0,,سيبدأ الحفل في تمام الخامسة مساءً, ولن يكون موقفنا لطيفاً إذا ما تعالت اصوات معدتنا اثناء الحفل
Dialogue: 0,1:04:27.08,1:04:28.74,ANMAR,,0,0,0,,"إنه يقول "اوناجو بالأرز
Dialogue: 0,1:04:29.60,1:04:32.58,ANMAR,,0,0,0,,"يا ليته كان ممكناً إجراء حوارات بـ"الريكزردر
Dialogue: 0,1:04:32.59,1:04:35.00,ANMAR,,0,0,0,,هذا بيس مستحيلاً
Dialogue: 0,1:04:35.82,1:04:37.80,ANMAR,,0,0,0,,كل ما عليك فعله هو تحويل النغمات إلى احرف
Dialogue: 0,1:04:38.17,1:04:39.08,ANMAR,,0,0,0,,تحويل النغمات
Dialogue: 0,1:04:39.38,1:04:40.97,ANMAR,,0,0,0,,إلى احرف  ؟
Dialogue: 0,1:04:42.42,1:04:46.01,ANMAR,,0,0,0,,أنا اتحدث هنا عن الأحرف الابجدية الإنجليزية\Nأي ان [كوجيما]   لا يمكنها فعل ذلك
Dialogue: 0,1:04:46.43,1:04:48.27,ANMAR,,0,0,0,,تلك النغمة تقلقني
Dialogue: 0,1:04:48.66,1:04:51.77,ANMAR,,0,0,0,,[ران] , تذكرت شيئاً عليَّ القيام به
Dialogue: 0,1:04:52.24,1:04:54.41,ANMAR,,0,0,0,,أعِدك أن اكون على مقعدي قبل فتح الستارة
Dialogue: 0,1:04:56.01,1:04:57.32,ANMAR,,0,0,0,,انتظر [كونان]
Dialogue: 0,1:04:57.84,1:04:59.86,ANMAR,,0,0,0,,يا له من شقي اناني
Dialogue: 0,1:05:21.25,1:05:22.57,ANMAR,,0,0,0,,تلك النوتة
Dialogue: 0,1:05:22.57,1:05:23.88,ANMAR,,0,0,0,,أليس تلك النوتة خافضة بعد الشيء ؟
Dialogue: 0,1:05:24.14,1:05:24.88,ANMAR,,0,0,0,,أجل
Dialogue: 0,1:05:24.88,1:05:25.85,ANMAR,,0,0,0,,نفس الشعور يراودني
Dialogue: 0,1:05:26.55,1:05:28.35,ANMAR,,0,0,0,,لاحظتها عندما كنت اغني
Dialogue: 0,1:05:28.92,1:05:31.12,ANMAR,,0,0,0,,ورغم أنني اعرف المفتاح الذي أصدرها
Dialogue: 0,1:05:31.74,1:05:34.02,ANMAR,,0,0,0,,stopإلا انني لا اعرف الجرس الموسيقي أو حتى الـ\Nالمستخدم
Dialogue: 0,1:05:34.83,1:05:36.65,ANMAR,,0,0,0,,فعدة انابيب كانت تصدر النوتة في الوقت نفسه
Dialogue: 0,1:05:42.65,1:05:44.58,ANMAR,,0,0,0,,النوتة التي صدرت خافضة فعلاً
Dialogue: 0,1:05:44.58,1:05:45.65,ANMAR,,0,0,0,,لا شك في ذلك
Dialogue: 0,1:05:45.98,1:05:47.76,ANMAR,,0,0,0,,انها تصدر من تلك المنطقة
Dialogue: 0,1:05:48.26,1:05:51.12,ANMAR,,0,0,0,,اغلب الظن انها تصدر من احد الانابيب الداخلية القصيرة
Dialogue: 0,1:05:51.82,1:05:54.25,ANMAR,,0,0,0,,يبدو انه لم يعد مضبوطاً كما يجب
Dialogue: 0,1:05:54.91,1:05:57.08,ANMAR,,0,0,0,,يجب ان يضبط قبل بدء الحفل
Dialogue: 0,1:05:57.65,1:06:01.09,ANMAR,,0,0,0,,لكن مكان السيد [مولر] لا يزال مجهولاً بعد
Dialogue: 0,1:06:01.09,1:06:01.83,ANMAR,,0,0,0,,هذا صحيح
Dialogue: 0,1:06:02.09,1:06:03.30,ANMAR,,0,0,0,,على كل حال يجب ان نُعلم السيد [دوموتو] بالأمر
Dialogue: 0,1:06:11.86,1:06:13.18,ANMAR,,0,0,0,,يبدو انه ليس في الداخل
Dialogue: 0,1:06:13.76,1:06:14.43,ANMAR,,0,0,0,,معك حق
Dialogue: 0,1:06:14.95,1:06:16.92,ANMAR,,0,0,0,,ربمما ذهب لأحتساء الشاي
Dialogue: 0,1:06:17.80,1:06:19.40,ANMAR,,0,0,0,,او ربما في ذلك المكان
Dialogue: 0,1:06:19.96,1:06:22.93,ANMAR,,0,0,0,,هل تعلم انني مندهشة لانك لاحظتَ تلك النوتة ؟
Dialogue: 0,1:06:24.69,1:06:26.43,ANMAR,,0,0,0,,اذاني حادتا السمع
Dialogue: 0,1:06:27.01,1:06:28.44,ANMAR,,0,0,0,,وصفهما بالحادتين لن يفيهما حقهما
Dialogue: 0,1:06:28.87,1:06:31.69,ANMAR,,0,0,0,,أعتقد انك تمتلك موهبة الحس الموسيقي الفائق
Dialogue: 0,1:06:31.92,1:06:33.04,ANMAR,,0,0,0,,أرجو ان يكون كلانك صحيحاً
Dialogue: 0,1:06:39.71,1:06:41.79,ANMAR,,0,0,0,,يبدو ان السيد [دوموتو] ليس هنا ايضاً
Dialogue: 0,1:06:43.53,1:06:45.84,ANMAR,,0,0,0,,هل عرفين اماكن أخرى قد يتواجد فيها ؟
Dialogue: 0,1:06:48.09,1:06:49.27,ANMAR,,0,0,0,,لا ادري
Dialogue: 0,1:06:49.27,1:06:51.39,ANMAR,,0,0,0,,ربما ذهب فعلاً لاحتساء الشاي كما قلت
Dialogue: 0,1:07:14.52,1:07:17.12,ANMAR,,0,0,0,,ايتها السيدات والسادة, نرجو منكم الانتباه
Dialogue: 0,1:07:17.88,1:07:21.85,ANMAR,,0,0,0,,رجاءً تذكروا ان التدخين ممنوع إلا في الاماكن المخصصة لذلك
Dialogue: 0,1:07:19.39,1:07:21.04,ANMAR,,0,0,0,,ألم تحضر الآنسة [أكيببا] بعد ؟
Dialogue: 0,1:07:21.37,1:07:21.90,ANMAR,,0,0,0,,كلا
Dialogue: 0,1:07:22.48,1:07:24.30,ANMAR,,0,0,0,,اتصلت بها على هاتفها المحمو, ولكنها لا ترد
Dialogue: 0,1:07:24.99,1:07:27.41,ANMAR,,0,0,0,,كما طلبت من الموظفين البحث عنها, ولكن
Dialogue: 0,1:07:27.41,1:07:28.88,ANMAR,,0,0,0,,هل اختفت هي ايضاً ؟
Dialogue: 0,1:07:29.39,1:07:30.20,ANMAR,,0,0,0,,لا ادري
Dialogue: 0,1:07:30.78,1:07:32.83,ANMAR,,0,0,0,,السيد [مولر] اولاً والآن هي
Dialogue: 0,1:07:33.68,1:07:35.18,ANMAR,,0,0,0,,لِمَ يحدث هذا بحق الله ؟
Dialogue: 0,1:07:35.57,1:07:37.39,ANMAR,,0,0,0,,ما يزال هناك خمسة عشر دقيقة على بدء العرض
Dialogue: 0,1:07:38.12,1:07:40.44,ANMAR,,0,0,0,,واذا لم تظهر قبل ذلك الحين
Dialogue: 0,1:07:40.44,1:07:41.98,ANMAR,,0,0,0,,ارجوكم, دعوني اخذ مكانها
Dialogue: 0,1:07:44.04,1:07:45.74,ANMAR,,0,0,0,,توقعت حصول هذا
Dialogue: 0,1:07:46.32,1:07:49.53,ANMAR,,0,0,0,,نظراً لما حدث مع الآنسة [اكابي] مسبقاً
Dialogue: 0,1:07:50.21,1:07:52.38,ANMAR,,0,0,0,,ولهذا كثفت من تدريباتي
Dialogue: 0,1:07:53.85,1:07:54.66,ANMAR,,0,0,0,,ولكن
Dialogue: 0,1:07:56.45,1:07:57.92,ANMAR,,0,0,0,,أرجوك يا معلمي
Dialogue: 0,1:07:58.23,1:08:00.87,ANMAR,,0,0,0,,اعدك ان اغني افضل من الآنسة [اكيبا]
Dialogue: 0,1:08:00.87,1:08:03.54,ANMAR,,0,0,0,,ليس هناك ما يدفعم للغناء افضل منها
Dialogue: 0,1:08:05.16,1:08:08.14,ANMAR,,0,0,0,,فالموسيقى اشبه بحلقة وصل بين العقل والجسد
Dialogue: 0,1:08:09.45,1:08:10.92,ANMAR,,0,0,0,,حاولي ان تجدي تلك الوصلة
Dialogue: 0,1:08:19.65,1:08:21.93,ANMAR,,0,0,0,,لم يأتِ [شينتشي] إذن
Dialogue: 0,1:08:23.09,1:08:25.37,ANMAR,,0,0,0,,والاهم من هذا, ماذا حل بـ [كونان] ؟
Dialogue: 0,1:08:25.56,1:08:26.98,ANMAR,,0,0,0,,فالحفل على وشك ان يبدأ
Dialogue: 0,1:08:27.64,1:08:30.43,ANMAR,,0,0,0,,فعلاً اين هو [كونان] الآن يا ترى ؟
Dialogue: 0,1:08:32.01,1:08:33.95,ANMAR,,0,0,0,,لكن بما انه [كونان] فلا شك انه بخير
Dialogue: 0,1:08:34.32,1:08:35.99,ANMAR,,0,0,0,,فأنا أثق به
Dialogue: 0,1:08:36.50,1:08:37.31,ANMAR,,0,0,0,,انتِ معك حق
Dialogue: 0,1:08:37.80,1:08:40.35,ANMAR,,0,0,0,,لقد وثق بنا [كونان]
Dialogue: 0,1:08:41.08,1:08:41.83,ANMAR,,0,0,0,,علينا فعل الشيء نفسه
Dialogue: 0,1:08:43.87,1:08:46.68,ANMAR,,0,0,0,,[كونان] سيكون بخير دون شك
Dialogue: 0,1:08:50.65,1:08:52.93,ANMAR,,0,0,0,,سيداتي سادتي, نرجو الانتباه
Dialogue: 0,1:08:53.47,1:08:57.22,ANMAR,,0,0,0,,نظراً لظروف غير متوقعة, فالآنسة [اكيبا رييكو]
Dialogue: 0,1:08:57.22,1:08:59.14,ANMAR,,0,0,0,,لن تغني هذه الليلة
Dialogue: 0,1:09:01.85,1:09:06.65,ANMAR,,0,0,0,,وستحل مكانها الآنسة [تشيغوسا رارا] خريجة الدفعة الناسعة لأكاديمية (دوموتو)
Dialogue: 0,1:09:07.50,1:09:11.40,ANMAR,,0,0,0,,نرجو من حضارتكم تتفهم الامر
Dialogue: 0,1:09:12.18,1:09:13.18,ANMAR,,0,0,0,,لماذا ؟
Dialogue: 0,1:09:13.47,1:09:16.20,ANMAR,,0,0,0,,لقد غنت بشكل رائع جداً اثناء "البروفة" النهائية
Dialogue: 0,1:09:17.63,1:09:20.18,ANMAR,,0,0,0,,أيعقل ان تكون هي و [شينتشي] في خطر ؟
Dialogue: 0,1:09:29.76,1:09:30.76,ANMAR,,0,0,0,,غطاء من " الفينيل" ؟
Dialogue: 0,1:09:31.12,1:09:31.71,ANMAR,,0,0,0,,ماذا ؟
Dialogue: 0,1:09:42.95,1:09:43.56,ANMAR,,0,0,0,,آنسة [رييكو]
Dialogue: 0,1:09:43.74,1:09:44.31,ANMAR,,0,0,0,,انسة [رييكو]
Dialogue: 0,1:09:51.16,1:09:51.61,ANMAR,,0,0,0,,ماذا ؟
Dialogue: 0,1:09:53.01,1:09:54.71,ANMAR,,0,0,0,,اين نحن الآن ؟
Dialogue: 0,1:09:55.13,1:09:56.57,ANMAR,,0,0,0,,اعتقد اننا في مجرى القناة
Dialogue: 0,1:09:57.78,1:09:59.71,ANMAR,,0,0,0,,المجرم الذي هاجمنا
Dialogue: 0,1:09:59.71,1:10:02.84,ANMAR,,0,0,0,,وضعنا في قارب ثم جعله يطفو في البحيرة التي خلف\Nقاعة دوموتو بحيث تجرفة المياه إلى مجرى القناة
Dialogue: 0,1:10:03.46,1:10:04.97,ANMAR,,0,0,0,,من فعلها يا ترى ؟
Dialogue: 0,1:10:05.59,1:10:06.33,ANMAR,,0,0,0,,لا اعلم
Dialogue: 0,1:10:07.72,1:10:11.55,ANMAR,,0,0,0,,وفوق ذلك, لماذا تكبد عناء وضعنا في القارب بعد ان افقدنا الوعي ؟
Dialogue: 0,1:10:11.97,1:10:14.13,ANMAR,,0,0,0,,على كل حال علينا الإسراع في العودة
Dialogue: 0,1:10:14.13,1:10:14.83,ANMAR,,0,0,0,,وإلا فأن الحفل
Dialogue: 0,1:10:15.29,1:10:17.75,ANMAR,,0,0,0,,ولكن حتى لو سبحنا إلى هناك
Dialogue: 0,1:10:17.75,1:10:19.76,ANMAR,,0,0,0,,فالسور إعلى من ان نستطيع تسلقه
Dialogue: 0,1:10:35.04,1:10:36.47,ANMAR,,0,0,0,,لا احد في الجوار
Dialogue: 0,1:10:38.86,1:10:39.83,ANMAR,,0,0,0,,لكن انظر هناك
Dialogue: 0,1:10:39.83,1:10:41.70,ANMAR,,0,0,0,,هناك هاتف مثبت على ذلك الجدار
Dialogue: 0,1:10:43.72,1:10:46.20,ANMAR,,0,0,0,,إذا تمكنا من الوصول إله, فسيكون بمقدورنا طلب المساعدة
Dialogue: 0,1:10:47.48,1:10:48.29,ANMAR,,0,0,0,,لحظة
Dialogue: 0,1:10:49.01,1:10:50.82,ANMAR,,0,0,0,,ليس مهماً ان نصل إلى الهاتف
Dialogue: 0,1:10:50.82,1:10:52.92,ANMAR,,0,0,0,,إذا تمكنا من رفع السماعة فقط, فسيكون عندئذٍ قادرين على طلب المساعة
Dialogue: 0,1:10:53.49,1:10:55.13,ANMAR,,0,0,0,,وكيف سنفعل ذلك ؟
Dialogue: 0,1:10:55.93,1:10:58.15,ANMAR,,0,0,0,,عندما تضغطين أزرار الهاتف لطلب رقم ما
Dialogue: 0,1:10:58.15,1:10:59.83,ANMAR,,0,0,0,,تصدر النغمات "بي" , "بو" , " با" من الازرار
Dialogue: 0,1:11:00.26,1:11:03.13,ANMAR,,0,0,0,,DTMF تلك النغمات تعرف باشارة
Dialogue: 0,1:11:03.63,1:11:06.45,ANMAR,,0,0,0,,وتستخدم فيها تركيبة من نغمة عالية وأخرة منخفضة, بترددات معينة
Dialogue: 0,1:11:06.45,1:11:08.38,ANMAR,,0,0,0,,حتى يتم نقل رقم الهاتف المطلوب
Dialogue: 0,1:11:09.61,1:11:12.23,ANMAR,,0,0,0,,إي اننا لو نجحنا في إصدار تلك الاصوات
Dialogue: 0,1:11:12.23,1:11:13.94,ANMAR,,0,0,0,,يمكننا عندها اجراء المكالمة
Dialogue: 0,1:11:15.29,1:11:20.32,ANMAR,,0,0,0,,الرقم 1 في هاتف الطوارئ 110 يتكون من نغمة \Nترددها  المنخفض 697 هرتز والعالي 1209 هرتز
Dialogue: 0,1:11:20.86,1:11:26.66,ANMAR,,0,0,0,,اما الرقم 0 فيتكون من نغمة ترددها 941 و 1336 هرتز على التوالي
Dialogue: 0,1:11:27.08,1:11:27.76,ANMAR,,0,0,0,,حسنٌ
Dialogue: 0,1:11:28.13,1:11:30.66,ANMAR,,0,0,0,,بأمكاني تذكر نغمات أزرار الهاتف
Dialogue: 0,1:11:31.39,1:11:33.63,ANMAR,,0,0,0,,لكن قبل ذلك علينا رفع تلك السماعة
Dialogue: 0,1:11:34.14,1:11:35.18,ANMAR,,0,0,0,,دعي الامر لي
Dialogue: 0,1:11:36.15,1:11:39.73,ANMAR,,0,0,0,,لكن المشكلة  تكمن في ان هناك زمناً قصيراً لإجراء الاتصال بعد رفع السماعة
Dialogue: 0,1:11:40.05,1:11:42.09,ANMAR,,0,0,0,,وبعدها لن نستطيع ابداً إجراء اية مكالمة
Dialogue: 0,1:11:42.92,1:11:45.05,ANMAR,,0,0,0,,أي ان امانا فرصة واحدة فقط لطلب الرقم
Dialogue: 0,1:11:45.62,1:11:49.60,ANMAR,,0,0,0,,وإذا فشلنا فسنضطر للانتظار إلى ان يجدنا احدهم
Dialogue: 0,1:11:50.28,1:11:51.79,ANMAR,,0,0,0,,ليس لدينا وقت نضيعه
Dialogue: 0,1:11:52.25,1:11:53.34,ANMAR,,0,0,0,,فلنفعل ذلك
Dialogue: 0,1:11:55.39,1:11:56.53,ANMAR,,0,0,0,,بما اننا عرفنا الامر
Dialogue: 0,1:11:56.53,1:11:58.19,ANMAR,,0,0,0,,دعينا نقم بتجربة سريعة اولاً
Dialogue: 0,1:12:01.06,1:12:02.07,ANMAR,,0,0,0,,ما ذلك الصوت
Dialogue: 0,1:12:02.49,1:12:03.09,ANMAR,,0,0,0,,إنفجار ؟
Dialogue: 0,1:12:03.78,1:12:04.70,ANMAR,,0,0,0,,شيءٌ ما قد انفجر
Dialogue: 0,1:12:07.39,1:12:08.75,ANMAR,,0,0,0,,الصوت قادمٌ من جهة قاعة (دوموتو)
Dialogue: 0,1:12:09.97,1:12:10.52,ANMAR,,0,0,0,,هل يعقل
Dialogue: 0,1:12:20.73,1:12:22.89,ANMAR,,0,0,0,,نحن الان في موقع الحدث وتحديداً عند غابات مدينة (نيشيتاما) الموسيقية
Dialogue: 0,1:12:23.47,1:12:27.59,ANMAR,,0,0,0,,قبل لحظات وقع انفجارات عند قاعة (دوموتو) الموسيقية
Dialogue: 0,1:12:28.55,1:12:30.53,ANMAR,,0,0,0,,{\be1}The explosions were at the innermost section on the left and…
Dialogue: 0,1:12:30.53,1:12:32.81,ANMAR,,0,0,0,,وعند باب المسرح في القسم الاوسط من الناحية اليمنى
Dialogue: 0,1:12:33.02,1:12:34.97,ANMAR,,0,0,0,,بدأ الحفل الموسيقي قبل خمس دقائق
Dialogue: 0,1:12:34.97,1:12:35.69,ANMAR,,0,0,0,,والوضع بالداخل لا يزال
Dialogue: 0,1:12:41.78,1:12:42.46,ANMAR,,0,0,0,,انفجار اخر
Dialogue: 0,1:12:42.78,1:12:44.29,ANMAR,,0,0,0,,بسرعة نغمة الرقم 0
Dialogue: 0,1:12:51.96,1:12:52.54,ANMAR,,0,0,0,,هذا سيفي بالغرض
Dialogue: 0,1:12:53.27,1:12:54.04,ANMAR,,0,0,0,,لنحرك القارب اولاً
Dialogue: 0,1:13:03.71,1:13:04.61,ANMAR,,0,0,0,,هذا يكفي
Dialogue: 0,1:13:04.61,1:13:05.26,ANMAR,,0,0,0,,اوقفي القارب
Dialogue: 0,1:13:08.36,1:13:10.68,ANMAR,,0,0,0,,والآن كيف سنرفع السماعة ؟
Dialogue: 0,1:13:11.06,1:13:11.98,ANMAR,,0,0,0,,انتظري وسترين
Dialogue: 0,1:13:26.26,1:13:26.91,ANMAR,,0,0,0,,رائع
Dialogue: 0,1:13:27.48,1:13:28.08,ANMAR,,0,0,0,,هيا بنا
Dialogue: 0,1:13:36.99,1:13:39.67,ANMAR,,0,0,0,,مرحبا, هنا مركز 110 لطلب النجدة
Dialogue: 0,1:13:44.49,1:13:45.96,ANMAR,,0,0,0,,ماذا؟ الآنسة [اكيبا] و [كونان] ؟
Dialogue: 0,1:13:46.49,1:13:46.72,ANMAR,,0,0,0,,أجل
Dialogue: 0,1:13:47.57,1:13:51.93,ANMAR,,0,0,0,,يبدو ان احدهم قد افقدهما الوعي, ثم وضعهما \Nفي قارب, فانجرفا بعدها إلى مجرى القناة
Dialogue: 0,1:13:52.53,1:13:56.02,ANMAR,,0,0,0,,الموقع  هو مدينة (نيشيتاما), بالقرب من مركز (نيشيتاما) للتحكم بتصريف مياه السدود
Dialogue: 0,1:14:01.38,1:14:02.07,ANMAR,,0,0,0,,ها قد اتو
Dialogue: 0,1:14:05.26,1:14:06.35,ANMAR,,0,0,0,,ها هما هناك
Dialogue: 0,1:14:06.35,1:14:07.03,ANMAR,,0,0,0,,في الاسفل
Dialogue: 0,1:14:16.05,1:14:17.42,ANMAR,,0,0,0,,كما توقعنا, كانت قاعة (دوموتو) إذن
Dialogue: 0,1:14:18.60,1:14:20.90,ANMAR,,0,0,0,,وقعت اكثر من عشرة انفجارات حتى الآن
Dialogue: 0,1:14:20.90,1:14:23.21,ANMAR,,0,0,0,,وجميعها استهدفت الاعمدة الخارجية للقاعة
Dialogue: 0,1:14:23.21,1:14:24.37,ANMAR,,0,0,0,,والفاعل لا يزال
Dialogue: 0,1:14:24.80,1:14:26.77,ANMAR,,0,0,0,,احدهم زرع القنابل هناك
Dialogue: 0,1:14:27.46,1:14:29.90,ANMAR,,0,0,0,,ورغم اننا ما نزال نجهل إن كانت تلك القنابلمؤقتة او تنفجر عن بعد
Dialogue: 0,1:14:30.63,1:14:34.35,ANMAR,,0,0,0,,فهناك احتمال كبير بأننا نواجه نفس الشخص المسؤول عن مقتل الموسيقيين الاربعة
Dialogue: 0,1:14:34.82,1:14:35.81,ANMAR,,0,0,0,,بالضبط
Dialogue: 0,1:14:35.81,1:14:38.11,ANMAR,,0,0,0,,الحادثة الاولى كانت انفجاراً ايضاً
Dialogue: 0,1:14:39.19,1:14:39.87,ANMAR,,0,0,0,,ولكن
Dialogue: 0,1:14:40.52,1:14:43.87,ANMAR,,0,0,0,,لماذا لم يقتلنا نحن ايضاً عوضاً عن إرسالنا بعيداً عن قاعة الحفل ؟
Dialogue: 0,1:14:46.90,1:14:47.86,ANMAR,,0,0,0,,ايعقل انها...؟
Dialogue: 0,1:14:53.85,1:14:54.59,ANMAR,,0,0,0,,انفجار اخر
Dialogue: 0,1:14:55.13,1:14:55.69,ANMAR,,0,0,0,,اخبروني
Dialogue: 0,1:14:56.48,1:14:57.87,ANMAR,,0,0,0,,الا يمكنكم الاتصال باحد داخل القاعة ؟
Dialogue: 0,1:14:58.45,1:15:00.05,ANMAR,,0,0,0,,[ران] العم والآخرون موجودين هناك
Dialogue: 0,1:15:00.29,1:15:02.38,ANMAR,,0,0,0,,هذا غير ممكن الان
Dialogue: 0,1:15:02.92,1:15:04.59,ANMAR,,0,0,0,,فقد قطع المجرم خطوط الهاتف
Dialogue: 0,1:15:05.01,1:15:06.31,ANMAR,,0,0,0,,ماذا عن الهواتف المحمولة ؟
Dialogue: 0,1:15:06.31,1:15:06.93,ANMAR,,0,0,0,,لا فائدة
Dialogue: 0,1:15:08.25,1:15:10.80,ANMAR,,0,0,0,,فأصول اللباقة تحتم عليك إقفال الهاتف المحمول اثناء الحفل الموسيقي
Dialogue: 0,1:15:11.22,1:15:13.56,ANMAR,,0,0,0,,ناهيكم عن كون الارسال داخل القاعة ممكنا في منطقة واحد فقط
Dialogue: 0,1:15:14.16,1:15:17.35,ANMAR,,0,0,0,,اعتقد ان الوضع لا يزال آمنا في الداخل
Dialogue: 0,1:15:19.07,1:15:22.54,ANMAR,,0,0,0,,فالقسم الداخلي لقاعة الحفل عازل للصوت ومقاوم للحرائق
Dialogue: 0,1:15:23.47,1:15:26.29,ANMAR,,0,0,0,,وأغلب الظن, بأنهم لم يشعروا بالانفجارات بعد
Dialogue: 0,1:15:27.92,1:15:30.10,ANMAR,,0,0,0,,إذ كان الامر كذلك فالحفل مايزال مستمر اذن
Dialogue: 0,1:15:30.51,1:15:31.17,ANMAR,,0,0,0,,أجل
Dialogue: 0,1:15:31.17,1:15:32.24,ANMAR,,0,0,0,,هذا ما اعتقده
Dialogue: 0,1:15:32.68,1:15:35.70,ANMAR,,0,0,0,,لكن, من المستحيل ان تبقى الانفجارات مقتصرة على القسم الخارجي فقط
Dialogue: 0,1:15:36.82,1:15:37.75,ANMAR,,0,0,0,,لانها ستطال القسم الداخلي
Dialogue: 0,1:15:38.58,1:15:39.08,ANMAR,,0,0,0,,كلا
Dialogue: 0,1:15:39.88,1:15:41.30,ANMAR,,0,0,0,,ربما تكون قد طالته فعلاً
Dialogue: 0,1:15:43.55,1:15:44.05,ANMAR,,0,0,0,,[ران]
Dialogue: 0,1:17:12.58,1:17:13.97,ANMAR,,0,0,0,,سيداتي سادتي, طاب مساؤكم
Dialogue: 0,1:17:14.47,1:17:16.52,ANMAR,,0,0,0,,نرحب بكم ترحيباً حاراً
Dialogue: 0,1:17:17.26,1:17:18.84,ANMAR,,0,0,0,,اسمي [دوموتو كازوكي]
Dialogue: 0,1:17:21.78,1:17:25.77,ANMAR,,0,0,0,,كما تعلمون جميعاً, ففي هذه القاعة الخاصة في هذه الليلة\Nالاستثنائية, وفي حضرة هذه " الاروغَن" الانبوبي
Dialogue: 0,1:17:27.30,1:17:28.22,ANMAR,,0,0,0,,اسرع
Dialogue: 0,1:17:28.22,1:17:29.07,ANMAR,,0,0,0,,بسرعة إلى هنا
Dialogue: 0,1:17:29.58,1:17:30.43,ANMAR,,0,0,0,,ماذا تفعل عندك ؟
Dialogue: 0,1:17:30.74,1:17:32.15,ANMAR,,0,0,0,,اسرع واجلب الخراطيم إلى هنا
Dialogue: 0,1:17:42.88,1:17:43.58,ANMAR,,0,0,0,,الوضع سيء
Dialogue: 0,1:17:43.99,1:17:46.71,ANMAR,,0,0,0,,القسم الاوسط لم يتضرر بعد على ما يبدو
Dialogue: 0,1:17:47.28,1:17:49.17,ANMAR,,0,0,0,,لا بد ان الناس هناك ما يزالون بخير
Dialogue: 0,1:17:49.60,1:17:51.03,ANMAR,,0,0,0,,لا يزال الوقت مبكراً على تنفس الصعداء
Dialogue: 0,1:17:52.22,1:17:54.97,ANMAR,,0,0,0,,جميع الممرات الموصلة للخارج قد انسدت
Dialogue: 0,1:17:55.44,1:17:56.72,ANMAR,,0,0,0,,اي ان عملية الانقاذ مستحيلة
Dialogue: 0,1:17:57.00,1:17:57.70,ANMAR,,0,0,0,,مستحيل
Dialogue: 0,1:17:58.12,1:18:01.37,ANMAR,,0,0,0,,وفوق ذلك, لا نزال نجهل العمود المستهدف في الانفجار التالي
Dialogue: 0,1:18:01.99,1:18:04.54,ANMAR,,0,0,0,,هناك ثلاثة وعشرون عموداً في الجهة الخارجية
Dialogue: 0,1:18:05.04,1:18:07.15,ANMAR,,0,0,0,,ربما يخطط لتفجيرها كلها
Dialogue: 0,1:18:07.63,1:18:09.37,ANMAR,,0,0,0,,تباً ! ماذا عليما ان نفعل إذن ؟
Dialogue: 0,1:18:10.34,1:18:12.08,ANMAR,,0,0,0,,بإمكاننا الدخول من السطح فقط
Dialogue: 0,1:18:13.26,1:18:13.96,ANMAR,,0,0,0,,هل هذا ممكن ؟
Dialogue: 0,1:18:14.31,1:18:15.65,ANMAR,,0,0,0,,يبدو ممكناً حتى هذه اللحظة
Dialogue: 0,1:18:16.44,1:18:19.17,ANMAR,,0,0,0,,ولكن ليس هناك مهبط مناسب للمروحية
Dialogue: 0,1:18:19.56,1:18:22.08,ANMAR,,0,0,0,,ولا نعرف إذا كان السطح قادراً على تحمل وزن المروحية
Dialogue: 0,1:18:22.54,1:18:23.24,ANMAR,,0,0,0,,حسنٌ إذن
Dialogue: 0,1:18:23.89,1:18:25.94,ANMAR,,0,0,0,,جاول ان تهبط إلى اقل ارتفاع  ممكن عن السطح
Dialogue: 0,1:18:26.48,1:18:27.56,ANMAR,,0,0,0,,ونحن سنقفز
Dialogue: 0,1:18:28.92,1:18:30.23,ANMAR,,0,0,0,,سأدلكم على ا لطريق
Dialogue: 0,1:18:31.36,1:18:34.51,ANMAR,,0,0,0,,لان الطريق من السطح إلى الطابق الرابع معقد للغاية
Dialogue: 0,1:18:34.72,1:18:35.41,ANMAR,,0,0,0,,ولذلك
Dialogue: 0,1:18:36.07,1:18:37.16,ANMAR,,0,0,0,,لكن هذا
Dialogue: 0,1:18:37.16,1:18:38.74,ANMAR,,0,0,0,,ليس هذا وقتاً للجدال
Dialogue: 0,1:18:39.20,1:18:41.67,ANMAR,,0,0,0,,علينا ان نسرع طالما  ان الانفجارات متوقفة الان
Dialogue: 0,1:18:47.67,1:18:48.60,ANMAR,,0,0,0,,انخفض لأرتفاع أقل
Dialogue: 0,1:18:50.22,1:18:50.90,ANMAR,,0,0,0,,انخفض اكثر
Dialogue: 0,1:18:51.90,1:18:52.77,ANMAR,,0,0,0,,قليلاً بعد
Dialogue: 0,1:18:55.23,1:18:56.12,ANMAR,,0,0,0,,قليلاً بعد
Dialogue: 0,1:18:57.59,1:18:58.79,ANMAR,,0,0,0,,لا يمكنني الانخفاض اكثر
Dialogue: 0,1:18:59.14,1:19:01.07,ANMAR,,0,0,0,,فالاتضطرابات الهوائية أسوأ مما كنت اتوقعه
Dialogue: 0,1:19:01.07,1:19:02.11,ANMAR,,0,0,0,,لا استطيع ابقائها ثابتة
Dialogue: 0,1:19:03.66,1:19:05.20,ANMAR,,0,0,0,,إذا ارتم الخروج, فأفعلوها الآن
Dialogue: 0,1:19:09.07,1:19:10.29,ANMAR,,0,0,0,,هيا بنا آنسة [اكيبا]
Dialogue: 0,1:19:17.15,1:19:19.85,ANMAR,,0,0,0,,وانت يا [كونان], ابقَ في المروحية و
Dialogue: 0,1:19:20.87,1:19:21.72,ANMAR,,0,0,0,,[كونان]
Dialogue: 0,1:19:22.41,1:19:23.67,ANMAR,,0,0,0,,سأبقى معكم
Dialogue: 0,1:19:23.98,1:19:26.53,ANMAR,,0,0,0,,إلى ان يتم إنقاذ [ران] والآخرون ايضاً
Dialogue: 0,1:19:26.96,1:19:27.68,ANMAR,,0,0,0,,[كونان]
Dialogue: 0,1:19:28.25,1:19:30.15,ANMAR,,0,0,0,,كما أنني رأيت وجه المجرم
Dialogue: 0,1:19:31.85,1:19:33.55,ANMAR,,0,0,0,,ورغم اننا لا نزال نجهل المسؤول عن هذه الانفجارات
Dialogue: 0,1:19:34.09,1:19:35.73,ANMAR,,0,0,0,,إلا انني رأيت من هاجمنا
Dialogue: 0,1:19:36.49,1:19:38.57,ANMAR,,0,0,0,,ألا يُحتمل ان يكون داخل القاعة الآن
Dialogue: 0,1:19:38.57,1:19:38.90,ANMAR,,0,0,0,,لهذا
Dialogue: 0,1:19:42.46,1:19:44.08,ANMAR,,0,0,0,,بسرعة لا يمكنني الصمود اكثر
Dialogue: 0,1:19:44.61,1:19:46.76,ANMAR,,0,0,0,,لا خيار امامنا, نحن مضطرون لأخذه معنا
Dialogue: 0,1:19:47.34,1:19:48.64,ANMAR,,0,0,0,,اسرع يا [تاكاغي]
Dialogue: 0,1:19:48.90,1:19:49.29,ANMAR,,0,0,0,,حسنٌ
Dialogue: 0,1:20:08.06,1:20:09.65,ANMAR,,0,0,0,,هذا احد ممرات الطابق الرابع الداخلية
Dialogue: 0,1:20:10.38,1:20:13.40,ANMAR,,0,0,0,,ولكننا وصلنا مباشرة من السطح إلى هنا
Dialogue: 0,1:20:14.03,1:20:16.27,ANMAR,,0,0,0,,لو لم اقل لكم ذلك لما سمحتم لي بالمجئ معكم
Dialogue: 0,1:20:16.74,1:20:17.78,ANMAR,,0,0,0,,والحال نفسه ينطبق على هذا الصبي
Dialogue: 0,1:20:19.42,1:20:21.99,ANMAR,,0,0,0,,هل رأيت وجه المجرم حقاً؟
Dialogue: 0,1:20:41.06,1:20:42.14,ANMAR,,0,0,0,,يا لها من مفاجأة
Dialogue: 0,1:20:42.72,1:20:46.39,ANMAR,,0,0,0,,حسبناه مجرد أحتمال, لكن ان يكونو فعلاً لم يشعروا بشيئ
Dialogue: 0,1:20:46.97,1:20:47.51,ANMAR,,0,0,0,,أجل
Dialogue: 0,1:20:48.21,1:20:50.14,ANMAR,,0,0,0,,على كل حال, فالنبحث عن القنابل
Dialogue: 0,1:20:50.72,1:20:53.69,ANMAR,,0,0,0,,من الصعب إخلاء القاعة من كل هذا الجمع اغفير من الناس
Dialogue: 0,1:20:54.32,1:20:57.14,ANMAR,,0,0,0,,وفوق هذا, إن كان تدمير هذه القاعة هو هدف المجرم الرئيسي
Dialogue: 0,1:20:57.67,1:21:00.49,ANMAR,,0,0,0,,فلا بد ان القنابل مزروعة هنا ايضاً
Dialogue: 0,1:21:01.06,1:21:01.80,ANMAR,,0,0,0,,فهمت
Dialogue: 0,1:21:02.41,1:21:05.81,ANMAR,,0,0,0,,[كونان] ستبقى هنا مع الآنسة[اكيبا]
Dialogue: 0,1:21:06.02,1:21:06.72,ANMAR,,0,0,0,,حسنٌ
Dialogue: 0,1:21:07.13,1:21:07.83,ANMAR,,0,0,0,,فالنذهب
Dialogue: 0,1:21:07.83,1:21:08.35,ANMAR,,0,0,0,,أجل
Dialogue: 0,1:21:17.78,1:21:18.50,ANMAR,,0,0,0,,[ران]
Dialogue: 0,1:21:20.84,1:21:21.82,ANMAR,,0,0,0,,انتظريني
Dialogue: 0,1:21:31.39,1:21:32.19,ANMAR,,0,0,0,,ما الذي يجري ؟
Dialogue: 0,1:21:32.62,1:21:34.10,ANMAR,,0,0,0,,كيف الوضع في الداخل  ؟
Dialogue: 0,1:22:12.96,1:22:16.09,ANMAR,,0,0,0,,المجرم يعرف تصميم هذه القاعة جيداً
Dialogue: 0,1:22:16.44,1:22:18.34,ANMAR,,0,0,0,,وعلى هذا الاساس زرع قنابله
Dialogue: 0,1:22:20.46,1:22:22.90,ANMAR,,0,0,0,,ربما يكون احد العاملين هنا
Dialogue: 0,1:22:26.37,1:22:28.25,ANMAR,,0,0,0,,تلك النوتة غريبة فعلاً
Dialogue: 0,1:22:29.42,1:22:30.74,ANMAR,,0,0,0,,حتى السيد [دوموتو] لم يلاحظها
Dialogue: 0,1:22:31.23,1:22:33.04,ANMAR,,0,0,0,,ربما كان سيلاحظها لو صدرت من البيانو
Dialogue: 0,1:22:33.58,1:22:37.21,ANMAR,,0,0,0,,فهو يعزف على "الاورغن" من سنتين فقط ولهذا\Nهو غير قادر ربما على ملاحظة هذا الاختلاف
Dialogue: 0,1:22:38.93,1:22:39.97,ANMAR,,0,0,0,,الاختلاف في النغمات
Dialogue: 0,1:22:40.59,1:22:43.63,ANMAR,,0,0,0,,"زمرة من الهواة, لا يستطيعو التفريق بين النغمات"
Dialogue: 0,1:22:44.42,1:22:45.69,ANMAR,,0,0,0,,هذا ما قصدته إذن
Dialogue: 0,1:22:46.35,1:22:48.07,ANMAR,,0,0,0,,الآنسة [كابي] لاحظت الاختلاف
Dialogue: 0,1:22:48.49,1:22:50.04,ANMAR,,0,0,0,,لانها تمتلك موهبة الحس الموسيقي الفائق
Dialogue: 0,1:22:50.66,1:22:51.42,ANMAR,,0,0,0,,لحظة
Dialogue: 0,1:22:51.87,1:22:53.13,ANMAR,,0,0,0,,لماذا اذن قام ذلك الشخص بــ .. ؟
Dialogue: 0,1:22:54.15,1:22:55.93,ANMAR,,0,0,0,,ايعقل ان ذلك الشخص .. ؟
Dialogue: 0,1:22:57.32,1:22:58.24,ANMAR,,0,0,0,,ان كانت القضية هكذا
Dialogue: 0,1:22:59.52,1:23:00.37,ANMAR,,0,0,0,,لماذا هي
Dialogue: 0,1:23:05.50,1:23:08.57,ANMAR,,0,0,0,,والدته لم تتزوج غير والده
Dialogue: 0,1:23:09.53,1:23:12.00,ANMAR,,0,0,0,,فهمت هكذا إذن
Dialogue: 0,1:23:12.50,1:23:15.98,ANMAR,,0,0,0,,لكن ما علاقة النوتة الغريبة بالانفجارات ؟
Dialogue: 0,1:23:19.27,1:23:21.33,ANMAR,,0,0,0,,بالمناسبة تذكرت شيئاً
Dialogue: 0,1:23:21.98,1:23:23.87,ANMAR,,0,0,0,,الوقت الذي توقفت فيه الانفجارات
Dialogue: 0,1:23:24.51,1:23:27.30,ANMAR,,0,0,0,,كان عندما القى السيد [دوموتو] كلمته
Dialogue: 0,1:23:28.37,1:23:31.32,ANMAR,,0,0,0,,ربما يُريد المجرم ان يلحظ الناس أمر الانفجارات
Dialogue: 0,1:23:32.20,1:23:33.63,ANMAR,,0,0,0,,كلا ليس هذا هو السبب
Dialogue: 0,1:23:34.36,1:23:36.41,ANMAR,,0,0,0,,الانفجارات لا تحدث إلا اثناء العرض الموسيقي
Dialogue: 0,1:23:37.50,1:23:39.93,ANMAR,,0,0,0,,فهمت.. لهذا بدت تلك النوتة غريبة
Dialogue: 0,1:23:41.75,1:23:42.60,ANMAR,,0,0,0,,تلك النوتة مجدداً
Dialogue: 0,1:23:44.05,1:23:45.53,ANMAR,,0,0,0,,كم مرة صدرت تلك النوتة
Dialogue: 0,1:23:46.54,1:23:48.16,ANMAR,,0,0,0,,منذ بداية الحفل حتى هذه اللحظة
Dialogue: 0,1:23:48.62,1:23:50.49,ANMAR,,0,0,0,,هل تعرفين كم مرة صدرت تلك النوتة الغريبة ؟
Dialogue: 0,1:23:50.87,1:23:52.22,ANMAR,,0,0,0,,اعتقد انها صدرت
Dialogue: 0,1:23:52.68,1:23:54.45,ANMAR,,0,0,0,, الاولى Ave Marai مرتين اثناء مقطوعة
Dialogue: 0,1:23:59.18,1:24:00.72,ANMAR,,0,0,0,,التي تلتها Cantata كما صدرت اثناء مقطوعة
Dialogue: 0,1:24:02.05,1:24:03.08,ANMAR,,0,0,0,,عشر مرات
Dialogue: 0,1:24:15.24,1:24:18.01,ANMAR,,0,0,0,,وثمان مرات اثناء المقطوعة الحالية
Dialogue: 0,1:24:18.54,1:24:19.85,ANMAR,,0,0,0,,مجموعها عشرون
Dialogue: 0,1:24:20.30,1:24:22.35,ANMAR,,0,0,0,,هذا يعني انه مايزال هناك اربعة انفجارات
Dialogue: 0,1:24:24.27,1:24:26.55,ANMAR,,0,0,0,,الانفجارات مرتبطة بتلك النوتة من دون شك
Dialogue: 0,1:24:27.05,1:24:30.95,ANMAR,,0,0,0,,لهذا لم تحدث أي انفجارات أثناء كلمة السيد [دوموتو]
Dialogue: 0,1:24:42.41,1:24:44.87,ANMAR,,0,0,0,,هناك ثلاثة وعشرون عموداً في الجهة الخارجية لقاعة الحفل
Dialogue: 0,1:24:45.36,1:24:45.88,ANMAR,,0,0,0,,بعبارة أُخرى
Dialogue: 0,1:24:46.38,1:24:48.37,ANMAR,,0,0,0,,فإن تدمير جميع الاعمدة
Dialogue: 0,1:24:48.37,1:24:49.71,ANMAR,,0,0,0,,إضافة إلى القسم الداخلي لهذه القاعة
Dialogue: 0,1:24:50.14,1:24:52.33,ANMAR,,0,0,0,,يستلزم 24 انفجاراً
Dialogue: 0,1:24:55.93,1:24:56.78,ANMAR,,0,0,0,,هذا يعني
Dialogue: 0,1:24:58.89,1:24:59.55,ANMAR,,0,0,0,,تماماً
Dialogue: 0,1:25:02.28,1:25:05.56,ANMAR,,0,0,0,,إذا لم نوقف العرض قبل صدور النوتة الغريبة\Nللمرة الرابعة إبتداءً من المرة القادمة
Dialogue: 0,1:25:06.17,1:25:08.66,ANMAR,,0,0,0,,فإن  القنبلة التي في داخل القاعة ستنفجر
Dialogue: 0,1:25:18.05,1:25:18.86,ANMAR,,0,0,0,,تلك النوتة مجدداً
Dialogue: 0,1:25:19.21,1:25:20.24,ANMAR,,0,0,0,,تباً
Dialogue: 0,1:25:20.24,1:25:22.25,ANMAR,,0,0,0,,الانفجارات مرتبطة فعلاً بتلك النوتة
Dialogue: 0,1:25:23.33,1:25:25.53,ANMAR,,0,0,0,,لا بد ان المجرم يتابع ما يجري هنا عن كثب
Dialogue: 0,1:25:35.04,1:25:35.80,ANMAR,,0,0,0,,مجدداً
Dialogue: 0,1:25:36.40,1:25:37.43,ANMAR,,0,0,0,,وجدته
Dialogue: 0,1:25:38.43,1:25:39.89,ANMAR,,0,0,0,,انه ذلك الشخص فعلاً
Dialogue: 0,1:25:42.96,1:25:45.50,ANMAR,,0,0,0,,حسنٌ سأصعد على خشبة المسرح لأوقف العرض
Dialogue: 0,1:25:45.50,1:25:45.85,ANMAR,,0,0,0,,إنتظري
Dialogue: 0,1:25:46.87,1:25:47.79,ANMAR,,0,0,0,,إذا لم تحسني التصرف
Dialogue: 0,1:25:48.22,1:25:49.65,ANMAR,,0,0,0,,فسيفجر المجرم القنابل بواسطة جهاز التحكم
Dialogue: 0,1:25:50.22,1:25:52.82,ANMAR,,0,0,0,,لقد رأيت المجرم وكان بحوزته جهاز التحكم
Dialogue: 0,1:25:53.54,1:25:54.15,ANMAR,,0,0,0,,ولكن
Dialogue: 0,1:25:54.79,1:25:56.17,ANMAR,,0,0,0,,تباً مال العمل
Dialogue: 0,1:25:56.67,1:25:59.49,ANMAR,,0,0,0,,أما من وسيلة لإيقاف العرض ؟
Dialogue: 0,1:26:00.42,1:26:02.86,ANMAR,,0,0,0,,كيف سنبطل مفعول القنابل ؟
Dialogue: 0,1:26:04.49,1:26:05.14,ANMAR,,0,0,0,,ثلاث دقائق
Dialogue: 0,1:26:07.07,1:26:08.33,ANMAR,,0,0,0,,هل تكفيك ثلاث دقائق ؟
Dialogue: 0,1:26:10.12,1:26:10.74,ANMAR,,0,0,0,,ولكن
Dialogue: 0,1:26:15.87,1:26:18.26,ANMAR,,0,0,0,,سأترك لك الباقي ايها المتحري
Dialogue: 0,1:27:06.77,1:27:08.10,ANMAR,,0,0,0,,انها المعلمة [رييكو]
Dialogue: 0,1:27:08.47,1:27:09.41,ANMAR,,0,0,0,,تلك الاغنية
Dialogue: 0,1:27:09.88,1:27:11.48,ANMAR,,0,0,0,,''Amazing Grace,'' انها اغنبية
Dialogue: 0,1:27:35.41,1:27:36.65,ANMAR,,0,0,0,,مالذي تنوين فعله الآن
Dialogue: 0,1:29:57.12,1:29:58.41,ANMAR,,0,0,0,,الشخص الذي كان يغني الاغنية في ذلك الوقت
Dialogue: 0,1:29:58.90,1:30:00.89,ANMAR,,0,0,0,,انها الآنسة [رييكو]
Dialogue: 0,1:30:10.89,1:30:13.29,ANMAR,,0,0,0,,كان يجب ان اقضي عليها في ذلك الوقت
Dialogue: 0,1:30:13.68,1:30:14.60,ANMAR,,0,0,0,,لن اسمح لك
Dialogue: 0,1:30:16.64,1:30:19.50,ANMAR,,0,0,0,,هذا الصوت يصدح بغناء يبث الدفء في القلوب
Dialogue: 0,1:30:21.04,1:30:23.05,ANMAR,,0,0,0,,هو ما جعلك تتردد, اليس كذلك ؟
Dialogue: 0,1:30:24.61,1:30:25.87,ANMAR,,0,0,0,,علاوة على ذلك, فإن هذه الاغنية
Dialogue: 0,1:30:26.41,1:30:30.63,ANMAR,,0,0,0,,كانت المفضلة لأبنك السيد [سوما هيكارو]
Dialogue: 0,1:30:31.59,1:30:35.96,ANMAR,,0,0,0,,والآنسة التي تغني الآن, كانت المرأة التي أحبها
Dialogue: 0,1:30:37.85,1:30:39.42,ANMAR,,0,0,0,,الاساس الذي بنيت عليه استنتاجي
Dialogue: 0,1:30:39.42,1:30:40.82,ANMAR,,0,0,0,,كانت تلك النوتة الغريبة
Dialogue: 0,1:30:41.44,1:30:45.17,ANMAR,,0,0,0,,في البداية, ظننا ان سبب تلك النوتة الغريبة هي أحد الانابيب غير مضبوطة
Dialogue: 0,1:30:45.71,1:30:47.26,ANMAR,,0,0,0,,لكن اتضح ان هذا ليس هو السبب
Dialogue: 0,1:30:48.77,1:30:50.58,ANMAR,,0,0,0,,"بل لأن في أحد انابيب "الاروغَن
Dialogue: 0,1:30:51.13,1:30:54.84,ANMAR,,0,0,0,,يوجد مستشعر صغير يسجل التغير الدقيق في تدفق الهواء
Dialogue: 0,1:30:55.42,1:30:59.13,ANMAR,,0,0,0,,ولهذا كانت النوتة الصادرة من ذلك الانبوب غريبة نوعاً ما
Dialogue: 0,1:31:00.11,1:31:03.69,ANMAR,,0,0,0,,وعندما يسجل المستشعر تغيراً في التدفق الهوائي داخل الانبوب
Dialogue: 0,1:31:05.60,1:31:10.05,ANMAR,,0,0,0,,يرسل على الفور إشارات متسلسلة إلى القنابل التي زرعها\Nمسبقاً والتي ستنفجر باترتيب بعد إشارة
Dialogue: 0,1:31:14.76,1:31:17.58,ANMAR,,0,0,0,,وعندما تنفجر القنبلة الاخيرة
Dialogue: 0,1:31:18.16,1:31:20.29,ANMAR,,0,0,0,,سيتحقق الحلم الذي طالما أنتظرته, وهو تدمير هذه القاعة
Dialogue: 0,1:31:21.52,1:31:23.69,ANMAR,,0,0,0,,لم يحدث إيُ انفجار أثناء البروفة النهائية
Dialogue: 0,1:31:24.23,1:31:26.78,ANMAR,,0,0,0,,لأن المفجر لم يفعل بعد
Dialogue: 0,1:31:27.44,1:31:28.53,ANMAR,,0,0,0,,أليس كذلك
Dialogue: 0,1:31:29.56,1:31:33.25,ANMAR,,0,0,0,,يا مدير قاعة (دوموتو), والضابط السابق لإيقاع البيانو
Dialogue: 0,1:31:33.65,1:31:35.12,ANMAR,,0,0,0,,السيد [فوا تاكومي] ؟
Dialogue: 0,1:31:41.79,1:31:42.80,ANMAR,,0,0,0,,لا شيء هنا ايضاً
Dialogue: 0,1:31:43.27,1:31:44.57,ANMAR,,0,0,0,,هذا ليس جيداً
Dialogue: 0,1:31:44.95,1:31:47.94,ANMAR,,0,0,0,,إن بقينا على هذا المنوال, فستنفجر القنبلة قبل ان نحدد مكانها
Dialogue: 0,1:31:48.59,1:31:49.29,ANMAR,,0,0,0,,اصمت
Dialogue: 0,1:31:52.72,1:31:54.11,ANMAR,,0,0,0,,أنصت ! ما هذا ؟
Dialogue: 0,1:32:17.86,1:32:18.59,ANMAR,,0,0,0,,لا تتحرك
Dialogue: 0,1:32:18.94,1:32:19.68,ANMAR,,0,0,0,,هذه الشرطة
Dialogue: 0,1:32:21.96,1:32:22.95,ANMAR,,0,0,0,,السيد [مولر]
Dialogue: 0,1:32:31.88,1:32:34.97,ANMAR,,0,0,0,,كيف عرفت انني المجرم ؟
Dialogue: 0,1:32:35.53,1:32:36.73,ANMAR,,0,0,0,,الحس الموسيقي الفائق
Dialogue: 0,1:32:37.72,1:32:40.19,ANMAR,,0,0,0,,مع انك تمتلك تلك الموهبة
Dialogue: 0,1:32:40.80,1:32:43.69,ANMAR,,0,0,0,,إلا انك لم تشر إلى النوتة الغريبة اثناء البروفة النهائية
Dialogue: 0,1:32:45.03,1:32:47.40,ANMAR,,0,0,0,,هذا ما أثار شكوكي نحوك
Dialogue: 0,1:32:50.69,1:32:51.78,ANMAR,,0,0,0,,هكذا إذن
Dialogue: 0,1:32:52.86,1:32:55.57,ANMAR,,0,0,0,,وكيف عرفت إنني والد [هيكارو] ؟
Dialogue: 0,1:32:56.15,1:32:59.57,ANMAR,,0,0,0,,"لوحة سيارتك رقمها .. " 83-52
Dialogue: 0,1:33:00.17,1:33:02.83,ANMAR,,0,0,0,,لقد استوحيته من تاريخ ميلاد أبنك, اليس كذلك ؟
Dialogue: 0,1:33:04.60,1:33:07.86,ANMAR,,0,0,0,,استخدمته كإقرار على صلتك بولدك الحبيب
Dialogue: 0,1:33:08.47,1:33:10.51,ANMAR,,0,0,0,,لأنك لم تكن لتبوح بذلك أمام الملأ
Dialogue: 0,1:33:11.36,1:33:15.68,ANMAR,,0,0,0,,إضافة لهذا ... الصورة التي في منزل السيد [دوموتو] حين كنت شاباً
Dialogue: 0,1:33:16.32,1:33:17.77,ANMAR,,0,0,0,,أبنك يشبهك فيها تماماً
Dialogue: 0,1:33:22.64,1:33:25.08,ANMAR,,0,0,0,,قتلت أولئك الموسيقيين الاربع
Dialogue: 0,1:33:25.54,1:33:27.94,ANMAR,,0,0,0,,انتقاماً لأبنك الذي توفي في الحادثة
Dialogue: 0,1:33:28.94,1:33:30.92,ANMAR,,0,0,0,,وتركت اجزاء "الفلوت" في مسرح الجريمة
Dialogue: 0,1:33:31.54,1:33:35.41,ANMAR,,0,0,0,,لتحمل الشرطة على الاعتقاد ان سلسلة الجرائم قد انتهت بارتكاب الجريمة الثالثة
Dialogue: 0,1:33:36.74,1:33:40.53,ANMAR,,0,0,0,,وتسببت بجروح بالغة للآنسة [كابي سوكو]
Dialogue: 0,1:33:41.31,1:33:45.87,ANMAR,,0,0,0,,لأنك خشيت من أنها ستلاحظ النوتة الغريبة \Nكونها تمتلك موهبة الحس الموسيقي الفائق
Dialogue: 0,1:33:46.41,1:33:49.00,ANMAR,,0,0,0,,الشخص الذي يخاف ممن يمتلكون هذه الموهبة لسبب كهذا
Dialogue: 0,1:33:49.38,1:33:51.28,ANMAR,,0,0,0,,لا بد أن يكون لديه هذه الموهبة هو أيضاً
Dialogue: 0,1:33:52.40,1:33:55.34,ANMAR,,0,0,0,,واستناداً على هذه النقطة فقط, فالمجرم\Nلا يمكن ان يكون غيرك انت يا سيد [فوا]
Dialogue: 0,1:33:58.19,1:33:59.31,ANMAR,,0,0,0,,شيء آخر
Dialogue: 0,1:34:00.16,1:34:02.67,ANMAR,,0,0,0,,الآنسة [اكيبا رييكو] تمتلك هذه الموهبة هي ايضاً
Dialogue: 0,1:34:11.10,1:34:14.93,ANMAR,,0,0,0,,ولكن .. بما انها خطيبة ابنك الراحل
Dialogue: 0,1:34:15.86,1:34:21.02,ANMAR,,0,0,0,,فلم تطاوعك نفسك على تعريضها لخطر المتفجرات\Nكما فعلت مع الآنسة [سوكو ] من قبل
Dialogue: 0,1:34:24.09,1:34:27.14,ANMAR,,0,0,0,,لذك .. اخترت وضع مادة مهيجة في شربها
Dialogue: 0,1:34:27.70,1:34:30.21,ANMAR,,0,0,0,,وهاجمتها  لاحقاً بشاحنة, ثم ببندقية هوائية
Dialogue: 0,1:34:30.66,1:34:33.03,ANMAR,,0,0,0,,وذلك كي تمنعها من الظهور على خشبة المسرح
Dialogue: 0,1:34:33.68,1:34:35.04,ANMAR,,0,0,0,,أردت ان تفقدها صوتها مؤقتاً
Dialogue: 0,1:34:35.50,1:34:37.97,ANMAR,,0,0,0,,أو ان تكسر ساقها على الاقل
Dialogue: 0,1:35:19.25,1:35:20.14,ANMAR,,0,0,0,,ذلك التناغم
Dialogue: 0,1:35:24.36,1:35:25.18,ANMAR,,0,0,0,,النوتة
Dialogue: 0,1:35:38.81,1:35:39.57,ANMAR,,0,0,0,,لماذا
Dialogue: 0,1:35:40.11,1:35:40.82,ANMAR,,0,0,0,,لماذا لم .. ؟
Dialogue: 0,1:35:41.28,1:35:42.64,ANMAR,,0,0,0,,لن تنفجر
Dialogue: 0,1:35:43.91,1:35:45.83,ANMAR,,0,0,0,,قبل أن اتي إليك
Dialogue: 0,1:35:45.83,1:35:49.01,ANMAR,,0,0,0,,قمت بإستخراج المستشعر من الانبوب
Dialogue: 0,1:35:49.42,1:35:50.21,ANMAR,,0,0,0,,ثلاث دقائق
Dialogue: 0,1:35:50.73,1:35:52.46,ANMAR,,0,0,0,,لا, بل تطلب ذلك دقيقتين فقط
Dialogue: 0,1:35:56.85,1:35:58.28,ANMAR,,0,0,0,,عمل مميز أيها الطفل الصغير
Dialogue: 0,1:35:58.69,1:36:00.30,ANMAR,,0,0,0,,هلا أخبرتني بإسمك مرة ثانية ؟
Dialogue: 0,1:36:01.38,1:36:03.77,ANMAR,,0,0,0,,[إيدوغاوا كونان] .. متحرٍ
Dialogue: 0,1:36:07.23,1:36:08.33,ANMAR,,0,0,0,,برافو
Dialogue: 0,1:36:08.58,1:36:10.09,ANMAR,,0,0,0,,برافو
Dialogue: 0,1:36:10.38,1:36:12.65,ANMAR,,0,0,0,,برافو .. برافو
Dialogue: 0,1:36:15.73,1:36:16.23,ANMAR,,0,0,0,,ها هو هناك
Dialogue: 0,1:36:16.70,1:36:17.81,ANMAR,,0,0,0,,يحمل جهاز التحكم عن بعد
Dialogue: 0,1:36:18.47,1:36:19.94,ANMAR,,0,0,0,,إذن فقد كان هو بالفعل
Dialogue: 0,1:36:20.75,1:36:21.60,ANMAR,,0,0,0,,ماذا يجب ان نفعل الآن ؟
Dialogue: 0,1:36:22.30,1:36:24.19,ANMAR,,0,0,0,,هل نهجم عليه قبل ان يُفجر القنابل ؟
Dialogue: 0,1:36:24.19,1:36:24.83,ANMAR,,0,0,0,,لن ينفع
Dialogue: 0,1:36:25.47,1:36:28.21,ANMAR,,0,0,0,,إذا هاجمناه, فسيُفجر القنابل بواسطة جهاز التحكم
Dialogue: 0,1:36:29.04,1:36:30.44,ANMAR,,0,0,0,,ماذا علينا ان نفعل إذن ؟
Dialogue: 0,1:36:32.76,1:36:33.67,ANMAR,,0,0,0,,تلك الغرفة
Dialogue: 0,1:36:34.43,1:36:36.70,ANMAR,,0,0,0,,ربما نستطيع فعل شيء من تلك الغرفة
Dialogue: 0,1:36:36.95,1:36:37.84,ANMAR,,0,0,0,,مثل ماذا ؟
Dialogue: 0,1:36:38.96,1:36:39.89,ANMAR,,0,0,0,,نطلق عليه النار
Dialogue: 0,1:36:40.38,1:36:42.23,ANMAR,,0,0,0,,قبل ان يضغط على زر التفجير
Dialogue: 0,1:36:48.27,1:36:49.87,ANMAR,,0,0,0,,لسوء حظك ايها المتحري الصغير
Dialogue: 0,1:36:50.76,1:36:53.23,ANMAR,,0,0,0,,يإمكان جهاز التحكم ان يُفجر القنابل
Dialogue: 0,1:36:53.79,1:36:55.19,ANMAR,,0,0,0,,لقد خسرت
Dialogue: 0,1:36:55.39,1:36:56.20,ANMAR,,0,0,0,,من يدري ؟
Dialogue: 0,1:36:56.71,1:36:58.11,ANMAR,,0,0,0,,لا يمكننا معرفة ذلك بعد
Dialogue: 0,1:37:00.38,1:37:01.81,ANMAR,,0,0,0,,ما الذي لا تعرفة بعد ؟
Dialogue: 0,1:37:02.86,1:37:05.83,ANMAR,,0,0,0,,صحيح أنني لا اعلم كيف دخلت القاعة
Dialogue: 0,1:37:06.62,1:37:09.38,ANMAR,,0,0,0,,إلا ان الشرطة لم تقتحم المكان بعد
Dialogue: 0,1:37:09.86,1:37:14.46,ANMAR,,0,0,0,,والقاعة تسبح الآن على الارجح في بحر من اللهب\Nويستحيل الدخول إليها .. تماماً كما خططت
Dialogue: 0,1:37:16.23,1:37:18.83,ANMAR,,0,0,0,,موضوع إزالة المستشعر كان هفوة مني فقط , لكن
Dialogue: 0,1:37:20.36,1:37:21.26,ANMAR,,0,0,0,,لايهم
Dialogue: 0,1:37:21.73,1:37:25.21,ANMAR,,0,0,0,,بإمكاني الآن على الاقل, إختيار لحظة الانفجار
Dialogue: 0,1:37:27.41,1:37:28.84,ANMAR,,0,0,0,,وكهدية وداعٍ مني إليك
Dialogue: 0,1:37:29.40,1:37:32.02,ANMAR,,0,0,0,,سأقتلك بينما تؤدي عرضك
Dialogue: 0,1:37:38.69,1:37:39.98,ANMAR,,0,0,0,,تبا ! في ذلك الوقت
Dialogue: 0,1:37:41.28,1:37:45.32,ANMAR,,0,0,0,,وذلك حالما تبدأ بالعزفِ على " اورغنك" العزيز يا
Dialogue: 0,1:37:46.40,1:37:47.70,ANMAR,,0,0,0,,[دوموتو  كازوكي]
Dialogue: 0,1:37:57.51,1:37:58.28,ANMAR,,0,0,0,,[كونان] ؟
Dialogue: 0,1:37:59.03,1:38:00.04,ANMAR,,0,0,0,,لا فائدة
Dialogue: 0,1:38:00.04,1:38:01.17,ANMAR,,0,0,0,,من الصعب إطلاق النار
Dialogue: 0,1:38:11.47,1:38:12.47,ANMAR,,0,0,0,,انتهى الامر
Dialogue: 0,1:38:12.47,1:38:15.31,ANMAR,,0,0,0,,هيا اسرع وابدأ عرضك الموسيقي يا [دوموتو]
Dialogue: 0,1:38:15.56,1:38:16.22,ANMAR,,0,0,0,,ما العمل ؟
Dialogue: 0,1:38:16.80,1:38:18.73,ANMAR,,0,0,0,,ليس بمقدوري استخدام ساعة التخدير
Dialogue: 0,1:38:19.45,1:38:20.69,ANMAR,,0,0,0,,أما من حل آخر ؟
Dialogue: 0,1:38:23.63,1:38:24.66,ANMAR,,0,0,0,,تنحَ جانباً يا [كونان]
Dialogue: 0,1:38:25.62,1:38:26.40,ANMAR,,0,0,0,,ارجوك
Dialogue: 0,1:38:35.19,1:38:35.84,ANMAR,,0,0,0,,أعطني إياها
Dialogue: 0,1:38:35.84,1:38:37.08,ANMAR,,0,0,0,,ريكوردري
Dialogue: 0,1:38:37.90,1:38:38.67,ANMAR,,0,0,0,,لقد عاد صوتي
Dialogue: 0,1:38:42.16,1:38:43.67,ANMAR,,0,0,0,,أجل, كذا تماماً
Dialogue: 0,1:38:44.04,1:38:44.59,ANMAR,,0,0,0,,مشكلة
Dialogue: 0,1:38:53.71,1:38:55.31,ANMAR,,0,0,0,,الوداع أيها المتحري الصغير
Dialogue: 0,1:38:55.74,1:38:56.44,ANMAR,,0,0,0,,لن اسمح لك
Dialogue: 0,1:39:03.44,1:39:06.27,ANMAR,,0,0,0,," مي - لا - لا - فا " ؟
Dialogue: 0,1:39:08.03,1:39:08.76,ANMAR,,0,0,0,,{\be1}''SHOOT''?\Nطلقة
Dialogue: 0,1:39:08.95,1:39:09.53,ANMAR,,0,0,0,,ستُطلق النار
Dialogue: 0,1:39:10.49,1:39:11.45,ANMAR,,0,0,0,,ما ذاك الصوت ؟
Dialogue: 0,1:39:12.04,1:39:13.99,ANMAR,,0,0,0,,إنه اللحن الذي يعلن نهاية هذه اللعبة
Dialogue: 0,1:39:14.49,1:39:14.91,ANMAR,,0,0,0,,ماذا ؟
Dialogue: 0,1:39:27.78,1:39:28.70,ANMAR,,0,0,0,,هنا الشرطة
Dialogue: 0,1:39:28.70,1:39:29.18,ANMAR,,0,0,0,,لا تتحرك
Dialogue: 0,1:39:31.42,1:39:32.77,ANMAR,,0,0,0,,لقد هُزمت
Dialogue: 0,1:40:25.53,1:40:26.22,ANMAR,,0,0,0,,سيد [فوا]
Dialogue: 0,1:40:26.65,1:40:27.73,ANMAR,,0,0,0,,أين القنبلة الأخيرة ؟
Dialogue: 0,1:40:28.20,1:40:30.70,ANMAR,,0,0,0,,داخل السقف الموجود أعلى خشبة المسرح
Dialogue: 0,1:40:31.48,1:40:33.52,ANMAR,,0,0,0,,[تاكاغي], أعلم المفتش بالأمر
Dialogue: 0,1:40:33.76,1:40:34.30,ANMAR,,0,0,0,,حالاً
Dialogue: 0,1:40:35.37,1:40:36.72,ANMAR,,0,0,0,,معذرة من فضلك
Dialogue: 0,1:40:37.50,1:40:41.04,ANMAR,,0,0,0,,هلا سمحتم لي أن اكمل ما تبقى من العرض ؟
Dialogue: 0,1:40:41.56,1:40:44.22,ANMAR,,0,0,0,,سأخبركم بكل شيء بعدها
Dialogue: 0,1:40:55.79,1:40:56.52,ANMAR,,0,0,0,,فهمت
Dialogue: 0,1:40:57.01,1:40:59.28,ANMAR,,0,0,0,,تم إخماد النيران أخيراً في هذه الناحية
Dialogue: 0,1:40:59.63,1:41:00.63,ANMAR,,0,0,0,,سنكون عندكم بعد برهة
Dialogue: 0,1:41:00.63,1:41:01.29,ANMAR,,0,0,0,,سيدي المفتش
Dialogue: 0,1:41:02.66,1:41:04.40,ANMAR,,0,0,0,,عثرنا على فتحة في القسم الشرقي
Dialogue: 0,1:41:05.02,1:41:05.79,ANMAR,,0,0,0,,حسنٌ  فلنذهب
Dialogue: 0,1:41:06.53,1:41:07.46,ANMAR,,0,0,0,,سنأتي في الحال
Dialogue: 0,1:41:13.44,1:41:14.16,ANMAR,,0,0,0,,أخبرني
Dialogue: 0,1:41:14.74,1:41:17.20,ANMAR,,0,0,0,,لماذا زرعت القنابل في هذه القاعة بالذات ؟
Dialogue: 0,1:41:18.66,1:41:21.35,ANMAR,,0,0,0,,طوال خمس وثلاثين سنة الماضية
Dialogue: 0,1:41:22.48,1:41:25.13,ANMAR,,0,0,0,,كنت الوحيد الذي يضبط " البيانو" للسيد [دوموتو كازوكي]
Dialogue: 0,1:41:25.55,1:41:27.50,ANMAR,,0,0,0,,عشنا هذه التجربة سوية بحلوها ومرها
Dialogue: 0,1:41:30.84,1:41:32.21,ANMAR,,0,0,0,,وقبل عامين
Dialogue: 0,1:41:32.56,1:41:35.38,ANMAR,,0,0,0,,اعتزل العزف على "البيانو" من دون اية مقدمات
Dialogue: 0,1:41:39.54,1:41:40.55,ANMAR,,0,0,0,,قال لي وقتها
Dialogue: 0,1:41:41.05,1:41:45.61,ANMAR,,0,0,0,,انه يتمنى ان أصبح مدير قاعة (دوموتو) والتي\Nكان سيكمل بناؤها في غضون سنتين
Dialogue: 0,1:41:46.19,1:41:48.70,ANMAR,,0,0,0,,وبالطبع كنت قادراً على رفض طلبه
Dialogue: 0,1:41:49.36,1:41:52.78,ANMAR,,0,0,0,,"فقد كنت حراً في تحديد مصيري كضابط لإيقاع " البيانو
Dialogue: 0,1:41:53.30,1:42:01.23,ANMAR,,0,0,0,,ولكن عملي لخمسة وثلاثين عاماً كضابط "البيانو" الوحيد للسيد [دوموتو كازوكي] العازف الذي وصلت شهرته عنان السماء
Dialogue: 0,1:42:01.66,1:42:05.33,ANMAR,,0,0,0,,لم يسمح لي أن أعمل مع عازفِ "بيانو" آخر
Dialogue: 0,1:42:05.89,1:42:08.20,ANMAR,,0,0,0,,لقد منعني كبريائي من ذلك
Dialogue: 0,1:42:08.90,1:42:11.99,ANMAR,,0,0,0,,سبق وقلتها مراراً لستُ سوى ميكانيكي بسيط
Dialogue: 0,1:42:12.38,1:42:14.93,ANMAR,,0,0,0,,فإمكاناتي لا تؤهلني ابداً لكي اصبح مديراً
Dialogue: 0,1:42:15.43,1:42:18.26,ANMAR,,0,0,0,,ولكنني استسلمت لليأس في نهاية المطاف
Dialogue: 0,1:42:56.26,1:42:59.31,ANMAR,,0,0,0,,توفيت زوجتي قبل سنتين بسبب المرض
Dialogue: 0,1:42:59.89,1:43:02.76,ANMAR,,0,0,0,,وبعدها بسنة مات إبني في حادث
Dialogue: 0,1:43:03.33,1:43:09.19,ANMAR,,0,0,0,,كما فقدت وظيفتي كضابط "للبيانو" , وهو الشيء\Nالوحيد الذي كان قد بقيَ له معنة في حياتي
Dialogue: 0,1:43:09.75,1:43:12.65,ANMAR,,0,0,0,,لقد خسرتُ  كل شيئ في هذه الحياة
Dialogue: 0,1:43:13.65,1:43:16.11,ANMAR,,0,0,0,,حتى الموسيقى التي كنت اعشقها كثيراً
Dialogue: 0,1:43:16.64,1:43:20.62,ANMAR,,0,0,0,,اصبحت مجرد اصواتٍ ناشزة تسبب لي الآلام
Dialogue: 0,1:43:24.67,1:43:25.52,ANMAR,,0,0,0,,أجل
Dialogue: 0,1:43:25.90,1:43:27.62,ANMAR,,0,0,0,,حتى في أحلامي كنت أسمعها
Dialogue: 0,1:43:28.16,1:43:31.21,ANMAR,,0,0,0,,كانت تحول احلامي إلى كوابيس, ثم ذات ليلة أتخذت قراري
Dialogue: 0,1:43:32.09,1:43:33.59,ANMAR,,0,0,0,,سأزيلهم جميعاً عن الوجود
Dialogue: 0,1:43:34.00,1:43:35.66,ANMAR,,0,0,0,,سأمحوا كل شيء عن هذا الوجود
Dialogue: 0,1:43:36.84,1:43:39.63,ANMAR,,0,0,0,,حتى تعود إلى الهيمنه على هذه الليلة الصامتة
Dialogue: 0,1:43:40.22,1:43:43.10,ANMAR,,0,0,0,,سأمحو الأربعة الذين سرقوا حياة ابني
Dialogue: 0,1:43:43.10,1:43:44.57,ANMAR,,0,0,0,,وذلك الأناني [دوموتو]
Dialogue: 0,1:43:44.57,1:43:48.48,ANMAR,,0,0,0,,الذي فقد اهتمامه بـ  "البيانو" بسبب هذه "الاورغن" الانبوبي\Nوسأمحو هذه القاعة أيضاً
Dialogue: 0,1:43:48.97,1:43:52.68,ANMAR,,0,0,0,,"وحتى الناس الذين اتوا ليستمعو إلى "الاورغن
Dialogue: 0,1:43:53.03,1:43:56.94,ANMAR,,0,0,0,,والموسيقيين الذين جاؤوا إلى هنا من شتى بقاع الارض
Dialogue: 0,1:43:57.84,1:44:03.02,ANMAR,,0,0,0,,قبلت العمل مديراً لقاعة (دوموتو) حتى اصل  إلى مرادي
Dialogue: 0,1:44:03.02,1:44:04.49,ANMAR,,0,0,0,,"هو الوصول إلى هذه " الاورغن
Dialogue: 0,1:44:05.30,1:44:07.65,ANMAR,,0,0,0,,وليسهل عليَّ كذلك زرع المتفجرات في القاعة
Dialogue: 0,1:44:07.65,1:44:10.67,ANMAR,,0,0,0,,لهذا فقط وافقت على ان اصبح مديراً لهذه القاعة
Dialogue: 0,1:44:11.08,1:44:15.85,ANMAR,,0,0,0,,[ما ذلك " البيانو" الذي هجرناه انا و [دوموتو \Nعلى حد سواء
Dialogue: 0,1:44:15.85,1:44:17.40,ANMAR,,0,0,0,,فقد شعرت اتجاه بالشفقة
Dialogue: 0,1:44:18.05,1:44:18.88,ANMAR,,0,0,0,,هذا يعني
Dialogue: 0,1:44:19.56,1:44:22.55,ANMAR,,0,0,0,,تفجير "البيانو" في غرفة التدريب
Dialogue: 0,1:44:22.55,1:44:24.83,ANMAR,,0,0,0,,كان طريقتك في إظهار حبك له
Dialogue: 0,1:44:25.68,1:44:28.58,ANMAR,,0,0,0,,حسنٌ .. هذا كل مالدي لأقوله
Dialogue: 0,1:44:29.28,1:44:30.06,ANMAR,,0,0,0,,والآن
Dialogue: 0,1:44:33.77,1:44:35.73,ANMAR,,0,0,0,,والان استعدوا (دوموتو) حالاً
Dialogue: 0,1:44:36.21,1:44:37.78,ANMAR,,0,0,0,,سيد [فوا], إهدأ
Dialogue: 0,1:44:38.26,1:44:39.19,ANMAR,,0,0,0,,لا تخافوا
Dialogue: 0,1:44:39.57,1:44:41.05,ANMAR,,0,0,0,,سأقدم على الانتحار فقط
Dialogue: 0,1:44:41.47,1:44:43.52,ANMAR,,0,0,0,,ليس لدي اية نية في إيذاء احد
Dialogue: 0,1:44:44.35,1:44:46.74,ANMAR,,0,0,0,,[كونان] غادر هذه الغرفة بسرعة رجاءً
Dialogue: 0,1:44:46.94,1:44:47.62,ANMAR,,0,0,0,,لن اغادر
Dialogue: 0,1:44:47.88,1:44:49.31,ANMAR,,0,0,0,,ارتكبت تلك الافعال الشنيعة
Dialogue: 0,1:44:49.57,1:44:51.46,ANMAR,,0,0,0,,وتريد الموت قبل ان تكفر عنها ؟
Dialogue: 0,1:44:51.81,1:44:53.38,ANMAR,,0,0,0,,لن ادعك تتمادى في الظلم
Dialogue: 0,1:44:53.38,1:44:54.39,ANMAR,,0,0,0,,[كونان]
Dialogue: 0,1:44:54.57,1:44:56.59,ANMAR,,0,0,0,,لا تفعل شيئاً تندم عليه يا سيد [فوا]
Dialogue: 0,1:44:56.91,1:44:57.89,ANMAR,,0,0,0,,أصمت
Dialogue: 0,1:44:57.89,1:44:59.23,ANMAR,,0,0,0,,استدعوا[دوموتو] الآن
Dialogue: 0,1:44:59.65,1:45:00.35,ANMAR,,0,0,0,,[فوا]
Dialogue: 0,1:45:02.40,1:45:04.10,ANMAR,,0,0,0,,ها قد جئت لرؤيتك
Dialogue: 0,1:45:06.96,1:45:07.81,ANMAR,,0,0,0,,سيد [دوموتو]
Dialogue: 0,1:45:12.06,1:45:13.95,ANMAR,,0,0,0,,[فوا] انا اسف حقاً
Dialogue: 0,1:45:14.34,1:45:17.48,ANMAR,,0,0,0,,لم أتخيل ابداً ان عدم إظهار امتنناي لك, سيجعلك تعاني كل هذه المعاناة
Dialogue: 0,1:45:17.89,1:45:19.09,ANMAR,,0,0,0,,هل ادركت هذا اخيراً ؟
Dialogue: 0,1:45:19.44,1:45:21.68,ANMAR,,0,0,0,,بسبب انانيتك كنت في غاية 
Dialogue: 0,1:45:21.68,1:45:23.41,ANMAR,,0,0,0,,الامر ليس كما نظن يا [فوا]
Dialogue: 0,1:45:23.85,1:45:26.75,ANMAR,,0,0,0,,"اعتزلت مهنة العزف على "البيانو
Dialogue: 0,1:45:26.75,1:45:31.04,ANMAR,,0,0,0,,لأنني لاحظت ان ضبطك له بدأ يفلت منك شيئاً فئيئاً
Dialogue: 0,1:45:32.75,1:45:34.63,ANMAR,,0,0,0,,أخذت كبرياءك بالحسبان
Dialogue: 0,1:45:34.63,1:45:36.60,ANMAR,,0,0,0,,ففضلت ان لا اخبرك بالأمر
Dialogue: 0,1:45:37.37,1:45:41.67,ANMAR,,0,0,0,,وما زلت أرفض العمل مع ضابط آخر, حتى بعدما أخبرتك بالسبب
Dialogue: 0,1:45:42.52,1:45:45.36,ANMAR,,0,0,0,,لهذا السبب فقط, اتزلت العزف على البيانو
Dialogue: 0,1:45:45.36,1:45:46.39,ANMAR,,0,0,0,,هراء
Dialogue: 0,1:45:46.39,1:45:48.19,ANMAR,,0,0,0,,انا امتلك حساً موسيقياً فائقاً
Dialogue: 0,1:45:48.19,1:45:51.35,ANMAR,,0,0,0,,بالتأكيد, ولا احد ينكر امتلاكك لهذه الموهبة
Dialogue: 0,1:45:51.66,1:45:55.27,ANMAR,,0,0,0,,لكن ومع تقدمك في السن ضعف سمعك
Dialogue: 0,1:45:55.92,1:46:00.79,ANMAR,,0,0,0,,لدرجة ان اللحن خرج عن الايقاع مرات عديدة دون ان تلحظ ذلك
Dialogue: 0,1:46:03.57,1:46:06.80,ANMAR,,0,0,0,,كذب
Dialogue: 0,1:46:07.41,1:46:12.39,ANMAR,,0,0,0,,لو كنت أعلم ان هذا سيحصل,  لكنت أخبرتك بالحقيقة حينها
Dialogue: 0,1:46:12.74,1:46:14.88,ANMAR,,0,0,0,,انا حقاً اسف
Dialogue: 0,1:46:14.88,1:46:16.40,ANMAR,,0,0,0,,فات الاوان على تقديم الاعتذارات
Dialogue: 0,1:46:16.40,1:46:17.97,ANMAR,,0,0,0,,كل ما حدث كان بسببك
Dialogue: 0,1:46:17.97,1:46:18.74,ANMAR,,0,0,0,,هذا ليس صحيحاً
Dialogue: 0,1:46:20.48,1:46:23.96,ANMAR,,0,0,0,,لو ان صديقة عزيزة علي فعلت الشيء نفسه معي
Dialogue: 0,1:46:24.50,1:46:27.93,ANMAR,,0,0,0,,لالتمست لها مئة عذر على فعلتها
Dialogue: 0,1:46:28.81,1:46:35.89,ANMAR,,0,0,0,,فلربما رأت في ذلك فائدة لم أرها أنا, فتكون بهذا قد أثرت\Nعلى نفسخا بتفضيل مصلحتي على مصلحتها الشخصية
Dialogue: 0,1:46:36.46,1:46:38.15,ANMAR,,0,0,0,,هذا ما كنت سأفعله
Dialogue: 0,1:46:39.08,1:46:40.11,ANMAR,,0,0,0,,والسبب
Dialogue: 0,1:46:41.46,1:46:43.45,ANMAR,,0,0,0,,إنني أثِق بصديقتي
Dialogue: 0,1:46:45.23,1:46:46.61,ANMAR,,0,0,0,,وأنا ايضاً ذلك
Dialogue: 0,1:47:15.59,1:47:18.10,ANMAR,,0,0,0,,لا أصدق ان كل هذه الانفجارات قد وقعت في الخارج
Dialogue: 0,1:47:18.44,1:47:20.38,ANMAR,,0,0,0,,لم أشعر بأس شيء على الإطلاق
Dialogue: 0,1:47:21.11,1:47:23.78,ANMAR,,0,0,0,,ويبدو ان [كونان] قد لعب دوراً مهما مجدداً
Dialogue: 0,1:47:24.28,1:47:27.53,ANMAR,,0,0,0,,كنت أعلم, الم اقل لكم ذلك ؟
Dialogue: 0,1:47:28.15,1:47:33.03,ANMAR,,0,0,0,,انا مندهش حقاً من قدرة [شينتشي] على فهم شفرة " الريكوردر" بسرعة
Dialogue: 0,1:47:33.65,1:47:35.96,ANMAR,,0,0,0,,استبدال النوتة باحرف من الابجدية
Dialogue: 0,1:47:36.30,1:47:38.37,ANMAR,,0,0,0,,شيء تجده في كثير من روايات المتحرين
Dialogue: 0,1:47:38.81,1:47:41.67,ANMAR,,0,0,0,,.."H" على الرغم من ان النوتة "سي" في التدوين الالماني ترمز إلى الحرف 
Dialogue: 0,1:47:42.45,1:47:46.39,ANMAR,,0,0,0,,إلا انه أخذ بالحسبان بأن بريطانية
Dialogue: 0,1:47:46.74,1:47:50.77,ANMAR,,0,0,0,,في النوتة " سي" لانه علم أنني استخدم التدوين البريطاني "B" فأستخدم الحرف 
Dialogue: 0,1:47:51.15,1:47:53.10,ANMAR,,0,0,0,,عندما أعلم انه سيفهم ما اقصده فواً
Dialogue: 0,1:47:53.76,1:47:57.57,ANMAR,,0,0,0,,لقد اعتمدت ايضاً على حسّه الموسيقي الفائق
Dialogue: 0,1:47:57.57,1:47:58.77,ANMAR,,0,0,0,,هكذا إذن
Dialogue: 0,1:47:59.77,1:48:02.40,ANMAR,,0,0,0,,والاهم من ذلك, فأنا أثق به
Dialogue: 0,1:48:03.48,1:48:04.73,ANMAR,,0,0,0,,كوني شريكته
Dialogue: 0,1:48:07.37,1:48:11.20,ANMAR,,0,0,0,,وانا الذي كنت متأكداً  ان المجرم هو شبيه (بيتهوفن)
Dialogue: 0,1:48:11.45,1:48:13.39,ANMAR,,0,0,0,,أبي, أما زلت تقول هذا الكلام ؟
Dialogue: 0,1:48:14.00,1:48:17.07,ANMAR,,0,0,0,,لم يأتِ في النهاية إذن
Dialogue: 0,1:48:17.07,1:48:18.31,ANMAR,,0,0,0,,مهوس التحريات ذلك
Dialogue: 0,1:48:18.63,1:48:19.89,ANMAR,,0,0,0,,تقصدين [شينتشبي]
Dialogue: 0,1:48:20.26,1:48:21.89,ANMAR,,0,0,0,,لا يهمني أمره على الإطلاق
Dialogue: 0,1:48:22.51,1:48:23.71,ANMAR,,0,0,0,,هيا بنا يا [كونان]
Dialogue: 0,1:48:24.50,1:48:25.22,ANMAR,,0,0,0,,ماذا ؟
Dialogue: 0,1:48:25.22,1:48:26.88,ANMAR,,0,0,0,,كان هنا قبل لحظات
Dialogue: 0,1:48:30.03,1:48:30.56,ANMAR,,0,0,0,,ماذا ؟
Dialogue: 0,1:48:36.18,1:48:36.71,ANMAR,,0,0,0,,اسمعي
Dialogue: 0,1:48:37.00,1:48:37.81,ANMAR,,0,0,0,,هذا الصوت
Dialogue: 0,1:48:41.17,1:48:42.06,ANMAR,,0,0,0,,صوت كمان
Dialogue: 0,1:48:42.60,1:48:44.19,ANMAR,,0,0,0,,أليس كذلك ؟ ''Amazing Grace,'' لحن 
Dialogue: 0,1:48:44.54,1:48:46.74,ANMAR,,0,0,0,,ليس هذا ما اعنيه, بل اعني اسلوب العزف
Dialogue: 0,1:48:47.05,1:48:47.69,ANMAR,,0,0,0,,اسلوب العزف ؟
Dialogue: 0,1:48:50.21,1:48:51.12,ANMAR,,0,0,0,,[شينتشي]
Dialogue: 0,1:48:52.81,1:48:53.49,ANMAR,,0,0,0,,انظري يا [ران]
Dialogue: 0,1:49:10.44,1:49:11.41,ANMAR,,0,0,0,,[شينتشي]
Dialogue: 0,1:49:12.41,1:49:13.53,ANMAR,,0,0,0,,[شينتشي]
Dialogue: 0,1:49:15.25,1:49:17.22,ANMAR,,0,0,0,,غادر [شينتشي] منذ برهة
Dialogue: 0,1:49:18.77,1:49:19.51,ANMAR,,0,0,0,,[كونان]
Dialogue: 0,1:49:19.89,1:49:20.85,ANMAR,,0,0,0,,قال إن عنده قضيه مهمة
Dialogue: 0,1:49:21.67,1:49:23.39,ANMAR,,0,0,0,,هل أتى [شينتشي]؟
Dialogue: 0,1:49:23.65,1:49:24.28,ANMAR,,0,0,0,,أجل
Dialogue: 0,1:49:25.31,1:49:27.18,ANMAR,,0,0,0,,بعجما سمع اغنية الآنسة [رييكو]
Dialogue: 0,1:49:27.18,1:49:29.15,ANMAR,,0,0,0,,تذكر ما حدث معكما قبل ثلاث سنوات
Dialogue: 0,1:49:29.65,1:49:34.57,ANMAR,,0,0,0,,واستعار هذا الكمان من المدرسة, ليعزف الاغنية التي سمعتها للتو
Dialogue: 0,1:49:35.18,1:49:39.22,ANMAR,,0,0,0,,كي يسمعها هو و [ران] معاً
Dialogue: 0,1:49:41.51,1:49:45.18,ANMAR,,0,0,0,,أخبرني [شينتشي] أنه أخطأ في حقك
Dialogue: 0,1:49:46.37,1:49:47.57,ANMAR,,0,0,0,,هل تشاجرتما يا تُرى ؟
Dialogue: 0,1:49:49.32,1:49:50.47,ANMAR,,0,0,0,,لم يحصل شيئاً من هذا
Dialogue: 0,1:49:52.53,1:49:54.97,ANMAR,,0,0,0,,كنت سأسامحك حتى لو لم تأتِ
Dialogue: 0,1:49:59.63,1:50:01.26,ANMAR,,0,0,0,,ايها الاحمق
Dialogue: 0,1:50:21.16,1:50:21.29,ANMAR,,0,0,0,,
Dialogue: 0,1:54:27.52,1:54:29.84,ANMAR,,0,0,0,,لقد اعتدت ان آتي إلى هنا دوماً برفقته
Dialogue: 0,1:54:30.69,1:54:32.62,ANMAR,,0,0,0,,كنا نتمشى هنا عند كل لقاء
Dialogue: 0,1:54:33.25,1:54:35.12,ANMAR,,0,0,0,,هكذا اذن
Dialogue: 0,1:54:35.74,1:54:37.58,ANMAR,,0,0,0,,في الربيع الذي تلا حادثة وفاته
Dialogue: 0,1:54:38.40,1:54:40.29,ANMAR,,0,0,0,,وفي المكان الذي يفيض بذكرياتنا
Dialogue: 0,1:54:40.29,1:54:42.30,ANMAR,,0,0,0,,غنيت اغنيته المفضلة
Dialogue: 0,1:54:42.77,1:54:45.17,ANMAR,,0,0,0,,أليس كذلك ؟ ''Amazing Grace,' اغنية 
Dialogue: 0,1:54:46.06,1:54:46.67,ANMAR,,0,0,0,,أجل
Dialogue: 0,1:54:47.72,1:54:48.64,ANMAR,,0,0,0,,بالنسبة لي
Dialogue: 0,1:54:49.32,1:54:52.24,ANMAR,,0,0,0,,فلقد ضِقت ذرعاُ مما فعله اولئك الأربعة
Dialogue: 0,1:54:53.19,1:54:55.74,ANMAR,,0,0,0,,إلى حد الذي جعلني أرغب بقتلهم
Dialogue: 0,1:54:56.59,1:54:58.57,ANMAR,,0,0,0,,لكنني سامحتهم فيما بعد
Dialogue: 0,1:54:59.69,1:55:03.53,ANMAR,,0,0,0,, مضمونها التسامح ''Amazing Grace,' فأغنية 
Dialogue: 0,1:55:06.36,1:55:07.87,ANMAR,,0,0,0,,حسنٌ استأذنكم الآن
Dialogue: 0,1:55:08.64,1:55:10.66,ANMAR,,0,0,0,,فلنغنِ بإنسجام مرة أخرى يا  [كونان]
Dialogue: 0,1:55:14.14,1:55:14.76,ANMAR,,0,0,0,,إلى اللقاء
Dialogue: 0,1:55:15.79,1:55:16.49,ANMAR,,0,0,0,,إلى اللقاء
Dialogue: 0,1:55:17.53,1:55:18.42,ANMAR,,0,0,0,,إلى اللقاء
Dialogue: 0,1:55:21.84,1:55:23.36,ANMAR,,0,0,0,,بالمناسبة يا  [ران]
Dialogue: 0,1:55:23.94,1:55:27.17,ANMAR,,0,0,0,,كيف عرفتي ان الذي كان يعزف في ذلك الوقت هو  [شينتشي]
Dialogue: 0,1:55:29.33,1:55:31.84,ANMAR,,0,0,0,,لديه عادة غريبة في العزف
Dialogue: 0,1:55:31.84,1:55:33.14,ANMAR,,0,0,0,,يمكنني ملاحظتها مباشرة
Dialogue: 0,1:55:35.03,1:55:35.85,ANMAR,,0,0,0,,حقاً ؟
Dialogue: 0,1:55:43.23,1:55:45.86,ANMAR,,0,0,0,,ما هي تلك العادة الغريبة يا ترى ؟
Dialogue: 0,1:56:00.86,1:56:05.86,ANMAR,,0,0,0,,
Dialogue: 0,1:56:03.85,1:56:06.37,ANMAR,,0,0,0,,لن ندعه وشأنه
Dialogue: 0,1:56:06.58,1:56:09.61,ANMAR,,0,0,0,,هذا افضل يوم لقتل ذلك الشخص
Dialogue: 0,1:56:14.61,1:56:19.61,ANMAR,,0,0,0,,
Dialogue: 1,0:49:32.22,0:49:35.11,ANMAR,,0,0,0,,لو ان الجميع يناديه باسمه
Dialogue: 1,0:49:39.08,0:49:42.27,ANMAR,,0,0,0,,فسيأتي دائماً معنا
