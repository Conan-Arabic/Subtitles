Dialogue: 0,0:00:00.00,0:00:07.30,DCDialogRedName,,0,0,0,,{\fs110\pos(959,739)\fnAl-Jazeera-Arabic-Bold}CodeSubs :ترجمة وتعديل\N\NTelegram: CodeSubs\N\NX: CodeSubs
Dialogue: 0,0:00:07.53,0:00:11.45,DC,,0,0,0,,{\an8}‫"محطة ناغويا"
Dialogue: 0,0:00:12.33,0:00:13.75,DC,,0,0,0,,‫لذيذ!
Dialogue: 0,0:00:13.83,0:00:16.13,DC,,0,0,0,,!إذًا هذا هو كوشي كاتسو بالميسو
Dialogue: 0,0:00:13.83,0:00:16.13,DCHint-xOpacity,,0,0,0,,{\an8}‫كوشي كاتسو هو طبق ياباني يتكوّن من لحم أو خضروات مغروسة في أسياخ، تُغطى بالبقسماط وتُقلى حتى تصبح مقرمشة.
Dialogue: 0,0:00:13.83,0:00:16.13,DCHint-xOpacity,,0,0,0,,{\an8}‫ميسو = معجون فول الصويا المخمر، يُستخدم كثيرًا في المطبخ الياباني.
Dialogue: 0,0:00:16.21,0:00:18.04,DC,,0,0,0,,!طعمها رائع
Dialogue: 0,0:00:18.13,0:00:20.00,DC,,0,0,0,,‫يمكنني تناول الكثير منها!
Dialogue: 0,0:00:21.38,0:00:22.97,DC,,0,0,0,,‫مهلًا، ماذا تفعلين؟
Dialogue: 0,0:00:23.05,0:00:24.38,DC,,0,0,0,,ألن تأكلي؟
Dialogue: 0,0:00:25.05,0:00:29.31,DC,,0,0,0,,‫بما أننا أتينا كل هذه المسافة إلى ناغويا،\N‫فكرت في نشر بعض الصور على الإنستا.
Dialogue: 0,0:00:29.39,0:00:30.47,DC,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:00:30.56,0:00:32.85,DC,,0,0,0,,.لا تلوميني إذا انتزعتها منكِ
Dialogue: 0,0:00:34.60,0:00:37.06,DC,,0,0,0,,!يا لهم من قومٍ لا يُبالون بشيء
Dialogue: 0,0:00:39.44,0:00:40.98,DC,,0,0,0,,‫أنت...
Dialogue: 0,0:00:41.78,0:00:44.57,DC,,0,0,0,,‫رجل البزاقة!
Dialogue: 0,0:00:48.16,0:00:49.66,DC,,0,0,0,,‫أنت مخطئ.
Dialogue: 0,0:00:50.16,0:00:53.75,DC,,0,0,0,,...أنا واحد من الشياطين الثمانية الذين يخدمون أونيمارو-ساما
Dialogue: 0,0:00:53.83,0:00:56.42,DC,,0,0,0,,‫أنا رجل الحلزون،
Dialogue: 0,0:00:57.00,0:00:59.54,DC,,0,0,0,,‫ويمكنكم منادتي دين-تشان!
Dialogue: 0,0:01:01.71,0:01:04.22,DCHint-wOpacity,,0,0,0,,{\an8}‫معلومة: البزاقة والحلزون كلاهما كائنان رخويان ينتميان لفصيلة الرخويات، غير أن البزاقة لا تملك صدفة على ظهرها، بينما الحلزون يملك صدفة صلبة يختبئ داخلها.
Dialogue: 0,0:01:01.71,0:01:04.22,DC,,0,0,0,,أليست مجرد قوقعة قد التصقت به الآن؟
Dialogue: 0,0:01:04.30,0:01:06.47,DC,,0,0,0,,!ليس مجددًا
Dialogue: 0,0:01:06.55,0:01:08.68,DC,,0,0,0,,!أحضروا الملح! الملح
Dialogue: 0,0:01:10.26,0:01:13.85,DC,,0,0,0,,.لقد عرفنا نقطة ضعفك بالفعل
Dialogue: 0,0:01:13.93,0:01:15.14,DC,,0,0,0,,!خذ هذه
Dialogue: 0,0:01:17.15,0:01:18.15,DC,,0,0,0,,ماذا؟
Dialogue: 0,0:01:23.86,0:01:28.32,DC,,0,0,0,,!الآن بعد أن أصبح لدى دين-تشان قوقعة، لن يجدي ذلك نفعًا
Dialogue: 0,0:01:28.91,0:01:31.83,DC,,0,0,0,,،صحيح أن القوقعة تحميك
Dialogue: 0,0:01:31.91,0:01:35.16,DC,,0,0,0,,.لكن إذا لم تستطع التحرك بسببها، فلا معنى لذلك
Dialogue: 0,0:01:39.63,0:01:41.09,DC,,0,0,0,,!‫سيف المروحـة (سنبوكين)
Dialogue: 0,0:01:45.67,0:01:47.17,DC,,0,0,0,,...يا إلهي
Dialogue: 0,0:01:47.26,0:01:51.18,DC,,0,0,0,,‫هل هو حقًا واحد من أتباع أونيمارو؟
Dialogue: 0,0:01:53.68,0:01:55.43,DC,,0,0,0,,‫في المرة القادمة التي أرى فيها أونيمارو،
Dialogue: 0,0:01:55.52,0:01:58.14,DC,,0,0,0,,‫سأهزمه بـسيف المروحـة (سنبوكين)!
Dialogue: 0,0:02:00.44,0:02:02.86,DC,,0,0,0,,!ليس بهذه السرعة
Dialogue: 0,0:02:11.74,0:02:13.91,DC,,0,0,0,,!يايبا! كن على أهبة الاستعداد
Dialogue: 0,0:02:16.20,0:02:19.96,DC,,0,0,0,,.هذا الشخص قد يكون قويًا بعض الشيء
Dialogue: 0,0:02:34.93,0:02:37.18,DCDialogRedName,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:03:53.09,0:03:58.01,DCNN,,0,0,0,,{\pos(960,1000.0)}‫الحلقة 6: الظهور المفاجئ لرجل الوطواط
Dialogue: 0,0:03:59.97,0:04:01.56,DC,,0,0,0,,!من أنت أيها الوغد؟
Dialogue: 0,0:04:03.35,0:04:04.90,DC,,0,0,0,,‫مرحبًا!
Dialogue: 0,0:04:04.98,0:04:09.03,DC,,0,0,0,,!أنا واحد من الشياطين الثمانية الذين يخدمون أونيمارو-ساما
Dialogue: 0,0:04:09.11,0:04:11.99,DC,,0,0,0,,!الرجل الوطواط، في خدمتكم
Dialogue: 0,0:04:13.82,0:04:16.12,DC,,0,0,0,,‫أعِد إليّ كوشي كاتسو خاصتي!
Dialogue: 0,0:04:22.62,0:04:26.00,DC,,0,0,0,,!ناغويا بها الكثير من الأشياء اللذيذة
Dialogue: 0,0:04:26.50,0:04:28.46,DC,,0,0,0,,!مهلًا، يا فتى الرعد
Dialogue: 0,0:04:28.54,0:04:33.92,DC,,0,0,0,,!سيف حاكم الرعد (رايجينكين) لا يخصّ سوى الملك أونيمارو-ساما
Dialogue: 0,0:04:34.01,0:04:36.59,DC,,0,0,0,,‫إنه غير مناسب لك تمامًا!
Dialogue: 0,0:04:36.68,0:04:37.72,DC,,0,0,0,,!ماذا قلت؟
Dialogue: 0,0:04:37.80,0:04:40.85,DC,,0,0,0,,‫الآن، قبل أن تتعرض للأذى،
Dialogue: 0,0:04:40.93,0:04:44.64,DC,,0,0,0,,‫كن لطيفًا، وسلّمني سيف حاكم الرعد (رايجينكين).
Dialogue: 0,0:04:45.64,0:04:47.94,DC,,0,0,0,,!حاول أن تأخذه إن استطعت
Dialogue: 0,0:04:48.02,0:04:51.19,DC,,0,0,0,,‫سأقضي عليك بضربة واحدة بسيف المروحة (سنبوكين)!
Dialogue: 0,0:04:51.86,0:04:53.57,DC,,0,0,0,,‫حسنًا، يا فتى.
Dialogue: 0,0:04:53.65,0:04:59.16,DC,,0,0,0,,!إذن، كما تتمنى، سآخذه منك بالقوة
Dialogue: 0,0:05:00.37,0:05:01.66,DC,,0,0,0,,‫استعد...
Dialogue: 0,0:05:07.00,0:05:08.00,DC,,0,0,0,,‫انطلق!
Dialogue: 0,0:05:19.97,0:05:21.68,DC,,0,0,0,,!سهل جداً
Dialogue: 0,0:05:24.48,0:05:26.02,DC,,0,0,0,,‫احترس!
Dialogue: 0,0:05:35.11,0:05:36.24,DC,,0,0,0,,!يا هذا
Dialogue: 0,0:05:36.86,0:05:38.91,DC,,0,0,0,,!التحليق بهذا الشكل تصرّف جبان
Dialogue: 0,0:05:38.99,0:05:40.24,DC,,0,0,0,,‫اصمت!
Dialogue: 0,0:05:40.74,0:05:45.00,DC,,0,0,0,,!البشر الذين لا يستطيعون حتى الطيران هم الحمقى
Dialogue: 0,0:05:48.12,0:05:49.83,DC,,0,0,0,,‫أيها الوغد.
Dialogue: 0,0:05:50.38,0:05:51.88,DC,,0,0,0,,!هيا بنا، شونوسكي
Dialogue: 0,0:05:57.76,0:06:00.68,DC,,0,0,0,,...أجنحة
Dialogue: 0,0:06:00.76,0:06:02.81,DC,,0,0,0,,‫يايبا.
Dialogue: 0,0:06:03.51,0:06:06.89,DC,,0,0,0,,‫أوه! أحسنت، يا فتى الرعد!
Dialogue: 0,0:06:06.98,0:06:07.89,DC,,0,0,0,,‫لكن...
Dialogue: 0,0:06:07.98,0:06:11.81,DC,,0,0,0,,!ولكن حتى لو استطعت الطيران، لا يمكنك هزيمتي
Dialogue: 0,0:06:11.90,0:06:13.61,DC,,0,0,0,,‫اصمت!
Dialogue: 0,0:06:15.73,0:06:17.86,DC,,0,0,0,,‫إنه سريع.
Dialogue: 0,0:06:17.95,0:06:21.41,DC,,0,0,0,,‫إنه يصد هجماتنا وكأنها لا شيء.
Dialogue: 0,0:06:21.49,0:06:26.37,DC,,0,0,0,,!ولكن إذا تمكنا من اختراق دفاعاته، فلدينا فرصة
Dialogue: 0,0:06:39.09,0:06:42.47,DC,,0,0,0,,‫حسنًا، حان وقت سيف المروحة (سنبوكين)!
Dialogue: 0,0:06:45.64,0:06:47.47,DC,,0,0,0,,‫يايبا...
Dialogue: 0,0:06:48.43,0:06:52.35,DC,,0,0,0,,.‫سيف المروحة (سنبوكين)
Dialogue: 0,0:06:56.53,0:06:57.53,DC,,0,0,0,,‫تبًا!
Dialogue: 0,0:06:57.61,0:06:59.61,DC,,0,0,0,,‫في هذا الوضع، لا يمكنني استخدام سيف المروحة (سنبوكين)!
Dialogue: 0,0:07:03.53,0:07:08.33,DC,,0,0,0,,!التلويح بالسيف بلا تفكير هو محض هراء
Dialogue: 0,0:07:14.67,0:07:17.30,DC,,0,0,0,,!حان وقت الضربة القاضية
Dialogue: 0,0:07:21.18,0:07:22.59,DC,,0,0,0,,‫استعد!
Dialogue: 0,0:07:28.27,0:07:30.73,DC,,0,0,0,,...يا له من استخدام بارع للسيف
Dialogue: 0,0:07:30.81,0:07:33.81,DC,,0,0,0,,‫من أنت أيها الوغد؟
Dialogue: 0,0:07:35.81,0:07:37.65,DC,,0,0,0,,‫أنا...
Dialogue: 0,0:07:37.73,0:07:39.53,DC,,0,0,0,,!لا مثيل له في كل العصور
Dialogue: 0,0:07:39.61,0:07:41.15,DC,,0,0,0,,!الأول تحت السماء
Dialogue: 0,0:07:41.78,0:07:44.91,DC,,0,0,0,,...السياف الذي يُسكت بكاء الأطفال
Dialogue: 0,0:07:44.99,0:07:48.24,DC,,0,0,0,,.مياموتو موساشي
Dialogue: 0,0:07:48.33,0:07:51.21,DC,,0,0,0,,‫ولا تنس ذلك!
Dialogue: 0,0:07:53.37,0:07:56.42,DC,,0,0,0,,!أوه! موساشي مياموتو
Dialogue: 0,0:07:56.92,0:07:58.46,DC,,0,0,0,,‫رائع!
Dialogue: 0,0:07:58.55,0:08:01.17,DC,,0,0,0,,‫معلمي الروحي!
Dialogue: 0,0:08:01.88,0:08:06.89,DC,,0,0,0,,‫أن ألتقي بأعظم مبارز في اليابان، أنا محظوظ جداً جداً!
Dialogue: 0,0:08:06.97,0:08:08.97,DC,,0,0,0,,.لقد أخجلتني
Dialogue: 0,0:08:09.06,0:08:13.48,DC,,0,0,0,,‫سأكون سعيدًا جدًا لو كنت واحدًا منا!
Dialogue: 0,0:08:18.02,0:08:19.11,DC,,0,0,0,,‫موساشي-سان!
Dialogue: 0,0:08:23.95,0:08:25.24,DC,,0,0,0,,‫موساشي-سان!
Dialogue: 0,0:08:25.32,0:08:26.78,DC,,0,0,0,,‫هل أنت بخير؟
Dialogue: 0,0:08:40.05,0:08:42.01,DC,,0,0,0,,!لـ-لا تقترب
Dialogue: 0,0:08:49.35,0:08:51.14,DC,,0,0,0,,‫حسنًا، أيتها الفتاة الجميلة.
Dialogue: 0,0:08:52.10,0:08:55.02,DC,,0,0,0,,!سلميني فتى الرعد
Dialogue: 0,0:08:55.69,0:08:57.65,DC,,0,0,0,,‫يا رفاق...
Dialogue: 0,0:09:01.94,0:09:02.86,DC,,0,0,0,,!كاجيتورا
Dialogue: 0,0:09:03.61,0:09:06.70,DC,,0,0,0,,‫حان وقت العرض!
Dialogue: 0,0:09:12.45,0:09:15.96,DC,,0,0,0,,!أيها العجوز المنحرف
Dialogue: 0,0:09:16.96,0:09:18.00,DC,,0,0,0,,!شونوسكي
Dialogue: 0,0:09:27.59,0:09:30.47,DC,,0,0,0,,‫كاجيتورا، ابقَ آمنًا!
Dialogue: 0,0:09:33.64,0:09:35.68,DC,,0,0,0,,!لن تفلتوا
Dialogue: 0,0:09:56.79,0:09:58.00,DC,,0,0,0,,!شونوسكي
Dialogue: 0,0:10:00.96,0:10:02.17,DC,,0,0,0,,‫تبًا...
Dialogue: 0,0:10:04.51,0:10:05.51,DC,,0,0,0,,!ساياكا
Dialogue: 0,0:10:08.38,0:10:10.93,DC,,0,0,0,,!إياكِ أن تبتعدي عني
Dialogue: 0,0:10:11.01,0:10:12.18,DC,,0,0,0,,‫حسنًا.
Dialogue: 0,0:10:24.07,0:10:27.86,DC,,0,0,0,,‫لقد هربت جيدًا، يا فتى الرعد.
Dialogue: 0,0:10:27.95,0:10:28.99,DC,,0,0,0,,‫لكن...
Dialogue: 0,0:10:33.95,0:10:37.08,DC,,0,0,0,,‫أنا رجل الوطواط، وسأنتزع منك سيف حاكم الرعد (رايجينكين)!
Dialogue: 0,0:10:37.16,0:10:41.29,DC,,0,0,0,,!سأحصل عليه بالتأكيد
Dialogue: 0,0:10:45.50,0:10:47.59,DC,,0,0,0,,.أتمنى أن يكون الجميع بخير
Dialogue: 0,0:10:50.01,0:10:51.01,DC,,0,0,0,,يايبا؟
Dialogue: 0,0:10:51.89,0:10:52.89,DC,,0,0,0,,.اسمعي، ساياكا
Dialogue: 0,0:10:53.80,0:10:55.10,DC,,0,0,0,,‫أعطني تلك الكرة.
Dialogue: 0,0:10:55.18,0:10:56.56,DC,,0,0,0,,هاه؟
Dialogue: 0,0:10:56.64,0:10:59.85,DC,,0,0,0,,!إذا حصلت عليها، قد أتمكن من هزيمة ذلك الوغد الوطواط
Dialogue: 0,0:10:59.94,0:11:00.94,DC,,0,0,0,,!مستحيل
Dialogue: 0,0:11:02.52,0:11:03.73,DC,,0,0,0,,...لأن
Dialogue: 0,0:11:04.69,0:11:07.36,DC,,0,0,0,,!قد تتحول إلى شيطان مرة أخرى
Dialogue: 0,0:11:07.44,0:11:09.03,DC,,0,0,0,,!سأكون بخير
Dialogue: 0,0:11:09.11,0:11:10.90,DC,,0,0,0,,!لقد كنت أتدرب، أتعلمين
Dialogue: 0,0:11:10.99,0:11:12.53,DC,,0,0,0,,1أنا مختلف عن ذي قبل
Dialogue: 0,0:11:13.37,0:11:18.50,DC,,0,0,0,,!ولكن إن حدث شيء كهذا مرة أخرى، فمن سيوقفك، يا يايبا؟
Dialogue: 0,0:11:27.05,0:11:29.34,DC,,0,0,0,,!إذن كيف من المفترض أن نهزمه؟
Dialogue: 0,0:11:29.42,0:11:32.68,DC,,0,0,0,,‫لا يمكنني حتى إصابة شخص يطير بسيف المروحة (سنبوكين)!
Dialogue: 0,0:11:33.34,0:11:34.72,DC,,0,0,0,,...حسناً
Dialogue: 0,0:11:34.80,0:11:38.56,DC,,0,0,0,,!من أجلهم أيضاً، يجب عليّ بالتأكيد أن أهزمه
Dialogue: 0,0:11:38.64,0:11:39.73,DC,,0,0,0,,‫لكن...
Dialogue: 0,0:11:40.85,0:11:43.85,DC,,0,0,0,,!لقد وجدتك، يا فتى الرعد
Dialogue: 0,0:11:43.94,0:11:45.11,DC,,0,0,0,,!الرجل الوطواط
Dialogue: 0,0:11:45.61,0:11:46.44,DC,,0,0,0,,!ابقي خلفي
Dialogue: 0,0:11:46.52,0:11:49.32,DC,,0,0,0,,!لن أدعك تهرب هذه المرة
Dialogue: 0,0:11:49.40,0:11:54.87,DC,,0,0,0,,.أما النمر، فربما أمسك به الآن موساشي مياموتو والآخرون
Dialogue: 0,0:11:54.95,0:11:59.41,DC,,0,0,0,,‫الآن، سلمني سيف حاكم الرعد (رايجينكين)!
Dialogue: 0,0:11:59.50,0:12:00.70,DC,,0,0,0,,‫ثمانية، أربعة، خمسة،
Dialogue: 0,0:12:00.79,0:12:02.08,DC,,0,0,0,,‫ثلاثة، اثنان، سبعة...
Dialogue: 0,0:12:02.66,0:12:04.04,DC,,0,0,0,,‫استعد، انطلق...
Dialogue: 0,0:12:04.12,0:12:05.83,DC,,0,0,0,,‫هيا! هيا! هيا!
Dialogue: 0,0:12:06.42,0:12:07.25,DC,,0,0,0,,‫انطلقوا!
Dialogue: 0,0:12:18.85,0:12:19.93,DC,,0,0,0,,‫تبًا!
Dialogue: 0,0:12:20.02,0:12:21.77,DC,,0,0,0,,‫بسيف المروحة (سنبوكين)، سأقضي عليكم بضربة واحدة—
Dialogue: 0,0:12:21.85,0:12:23.81,DC,,0,0,0,,!لن أسمح لك
Dialogue: 0,0:12:25.73,0:12:27.11,DC,,0,0,0,,!يايبا
Dialogue: 0,0:12:27.19,0:12:29.40,DC,,0,0,0,,‫هذا يؤلم...
Dialogue: 0,0:12:37.37,0:12:41.91,DC,,0,0,0,,!مع وجود الفتاة الجميلة هنا، لا يمكنك حتى الهروب
Dialogue: 0,0:12:42.45,0:12:44.92,DC,,0,0,0,,‫هذه هي النهاية.
Dialogue: 0,0:12:48.79,0:12:49.80,DC,,0,0,0,,!كاجيتورا
Dialogue: 0,0:12:51.51,0:12:53.17,DC,,0,0,0,,‫أنا سعيد لأنك بخير!
Dialogue: 0,0:12:54.47,0:12:58.97,DC,,0,0,0,,.يبدو أن موساشي مياموتو والآخرين قد فشلوا
Dialogue: 0,0:13:02.18,0:13:04.69,DC,,0,0,0,,.يا له من صراع عقيم
Dialogue: 0,0:13:09.57,0:13:12.03,DC,,0,0,0,,مـ-ماذا ستفعل يا يايبا؟
Dialogue: 0,0:13:14.24,0:13:17.16,DC,,0,0,0,,‫كاجيتورا! إلى هناك! لنذهب إلى هناك!
Dialogue: 0,0:13:38.76,0:13:41.26,DC,,0,0,0,,.إنها مسألة وقت فقط قبل أن يتم العثور علينا
Dialogue: 0,0:13:41.76,0:13:43.18,DC,,0,0,0,,‫انظري، ساياكا!
Dialogue: 0,0:13:44.77,0:13:46.06,DC,,0,0,0,,‫رائع، أليس كذلك؟
Dialogue: 0,0:13:46.14,0:13:47.98,DC,,0,0,0,,ماذا تفعل...؟
Dialogue: 0,0:13:50.69,0:13:51.69,DC,,0,0,0,,‫لقد أتوا.
Dialogue: 0,0:13:52.94,0:13:54.57,DC,,0,0,0,,مـ-ماذا سنفعل؟
Dialogue: 0,0:14:22.89,0:14:28.19,DC,,0,0,0,,!لقد انتهت لعبة الاختباء، يا فتى الرعد
Dialogue: 0,0:14:29.77,0:14:32.44,DC,,0,0,0,,!واو! إنها الفتاة الجميلة
Dialogue: 0,0:14:33.07,0:14:34.27,DC,,0,0,0,,!من هنا
Dialogue: 0,0:14:36.44,0:14:38.74,DC,,0,0,0,,!لقد رأيت ذلك قادمًا
Dialogue: 0,0:14:48.08,0:14:49.83,DC,,0,0,0,,!فرصة سانحة
Dialogue: 0,0:14:53.13,0:14:54.21,DC,,0,0,0,,‫هل أصبته؟
Dialogue: 0,0:15:01.51,0:15:03.80,DC,,0,0,0,,‫كيف تجرؤ.
Dialogue: 0,0:15:04.35,0:15:05.97,DC,,0,0,0,,!تباً! لقد صدها
Dialogue: 0,0:15:06.06,0:15:08.06,DC,,0,0,0,,‫كان يجب أن أستخدم سيف المروحة (سنبوكين).
Dialogue: 0,0:15:09.56,0:15:13.23,DC,,0,0,0,,.كيف تجرؤ على فعل ذلك بنظارتي الشمسية الثمينة
Dialogue: 0,0:15:15.32,0:15:22.28,DC,,0,0,0,,.يبدو أنك قد نجحت في إغضابي، يا فتى الرعد
Dialogue: 0,0:15:40.59,0:15:41.80,DC,,0,0,0,,!يايبا
Dialogue: 0,0:15:50.89,0:15:53.44,DC,,0,0,0,,.يا لك من عنيد
Dialogue: 0,0:15:54.10,0:15:56.06,DC,,0,0,0,,...اصمت! أنت هو الذي
Dialogue: 0,0:15:58.36,0:16:00.44,DC,,0,0,0,,‫لقد اختفى! سيف حاكم الرعد (رايجينكين)!
Dialogue: 0,0:16:02.99,0:16:05.37,DC,,0,0,0,,‫يبدو أن هذه هي النهاية.
Dialogue: 0,0:16:05.45,0:16:10.16,DC,,0,0,0,,‫أما بالنسبة لسيف حاكم الرعد (رايجينكين)، فبعد أن أهزمك—
Dialogue: 0,0:16:10.25,0:16:12.87,DC,,0,0,0,,!سآخذ وقتي في الاستيلاء عليه
Dialogue: 0,0:16:15.63,0:16:16.92,DC,,0,0,0,,‫سيف حاكم الرعد (رايجينكين)!
Dialogue: 0,0:16:22.59,0:16:23.72,DC,,0,0,0,,!إنه ثقيل
Dialogue: 0,0:16:23.80,0:16:27.35,DC,,0,0,0,,!يايبا، هل كنت تحمل مثل هذا السيف الثقيل كل يوم؟
Dialogue: 0,0:16:28.01,0:16:29.93,DC,,0,0,0,,!كاجيتورا، أرجوك
Dialogue: 0,0:16:32.81,0:16:34.23,DC,,0,0,0,,‫نحن قادمون، يايبا!
Dialogue: 0,0:16:55.17,0:16:56.37,DC,,0,0,0,,!لا تقترب
Dialogue: 0,0:17:03.42,0:17:05.80,DC,,0,0,0,,‫استسلم!
Dialogue: 0,0:17:19.65,0:17:20.65,DC,,0,0,0,,‫تبًا!
Dialogue: 0,0:17:33.12,0:17:37.29,DC,,0,0,0,,.أنت خاسر فاشل، يا فتى الرعد
Dialogue: 0,0:17:40.84,0:17:41.80,DC,,0,0,0,,!يايبا
Dialogue: 0,0:17:47.97,0:17:50.26,DC,,0,0,0,,‫استخدم سيف المروحة (سنبوكين)!
Dialogue: 0,0:17:52.56,0:17:53.60,DC,,0,0,0,,!أجل
Dialogue: 0,0:17:54.81,0:17:57.35,DC,,0,0,0,,‫سيف المروحـ...
Dialogue: 0,0:18:01.06,0:18:03.19,DC,,0,0,0,,!ما هذا أيها الوغد؟
Dialogue: 0,0:18:05.36,0:18:07.53,DC,,0,0,0,,!تلك الكرة لن تخرج
Dialogue: 0,0:18:07.61,0:18:09.53,DC,,0,0,0,,‫وسيفك المتألق هذا
Dialogue: 0,0:18:09.61,0:18:12.70,DC,,0,0,0,,‫غير قابل للاستخدام بدون تلك الفتحة في المقبض.
Dialogue: 0,0:18:12.78,0:18:15.54,DC,,0,0,0,,!سد الثقب، وسيكون الفوز لي
Dialogue: 0,0:18:16.83,0:18:21.71,DC,,0,0,0,,‫حتى لو لم أستطع استخدام سيف المروحة (سنبوكين)، سأظل أقطعك!
Dialogue: 0,0:18:21.79,0:18:23.09,DC,,0,0,0,,‫لا، لا.
Dialogue: 0,0:18:23.17,0:18:26.09,DC,,0,0,0,,.يجب ألا تتحدث بمثل هذه القوة
Dialogue: 0,0:18:55.16,0:18:56.29,DC,,0,0,0,,‫يايبا!
Dialogue: 0,0:18:59.50,0:19:00.83,DC,,0,0,0,,‫تبًا.
Dialogue: 0,0:19:02.13,0:19:06.21,DC,,0,0,0,,.انتهت اللعبة، يا فتى الرعد
Dialogue: 0,0:19:06.88,0:19:07.88,DC,,0,0,0,,!لقد انتهى أمري
Dialogue: 0,0:19:08.51,0:19:10.13,DC,,0,0,0,,‫تصبح على خير.
Dialogue: 0,0:19:11.93,0:19:14.60,DC,,0,0,0,,!توقف
Dialogue: 0,0:19:17.35,0:19:19.02,DC,,0,0,0,,‫يا إلهي!
Dialogue: 0,0:19:31.07,0:19:32.07,DC,,0,0,0,,!فهمت
Dialogue: 0,0:19:48.92,0:19:50.09,DC,,0,0,0,,ماااذا!؟
Dialogue: 0,0:19:55.89,0:19:58.22,DC,,0,0,0,,...مـ-مستحيل
Dialogue: 0,0:20:06.98,0:20:08.98,DC,,0,0,0,,!تحطّمت الكرة بسبب ضوء شمس الصباح
Dialogue: 0,0:20:09.82,0:20:10.94,DC,,0,0,0,,.تباً
Dialogue: 0,0:20:12.86,0:20:16.41,DC,,0,0,0,,‫الآن فرصتي!
Dialogue: 0,0:20:17.03,0:20:22.25,DC,,0,0,0,,‫سيف المروحة (سنبوكين)!
Dialogue: 0,0:20:28.84,0:20:31.51,DC,,0,0,0,,.تبًا
Dialogue: 0,0:20:42.43,0:20:44.44,DC,,0,0,0,,!لقد فعلتها، يايبا
Dialogue: 0,0:20:45.10,0:20:47.23,DC,,0,0,0,,.أنا سعيدة جداً لأنك فزت
Dialogue: 0,0:20:49.82,0:20:50.82,DC,,0,0,0,,!توقفي
Dialogue: 0,0:20:51.32,0:20:53.74,DC,,0,0,0,,.ليس لدي وقت للتعامل مع الفتيات الآن
Dialogue: 0,0:20:56.20,0:20:57.24,DC,,0,0,0,,‫يا له من غريب!
Dialogue: 0,0:21:08.17,0:21:10.00,DC,,0,0,0,,‫يا إلهي.
Dialogue: 0,0:21:10.50,0:21:13.59,DC,,0,0,0,,.لقد مررنا بالكثير هذه المرة
Dialogue: 0,0:21:14.30,0:21:17.01,DC,,0,0,0,,مهلًا، يا يايبا! ألن تأكل؟
Dialogue: 0,0:21:18.64,0:21:21.89,DC,,0,0,0,,‫لقد أدرك أنه لا يزال أمامه الكثير.
Dialogue: 0,0:21:22.68,0:21:25.60,DC,,0,0,0,,!هذا فظيع، انظروا إلى هذا
Dialogue: 0,0:21:26.35,0:21:28.81,DC,,0,0,0,,!ماذا؟! أهذا... مانجو على شكل شيطان؟
Dialogue: 0,0:21:28.90,0:21:33.32,DC,,0,0,0,,!هذا ليس مانجو عاديًا، إنه مانجو أونيمارو-سان
Dialogue: 0,0:21:33.40,0:21:34.65,DC,,0,0,0,,!ماذا قلت؟
Dialogue: 0,0:21:34.74,0:21:37.74,DC,,0,0,0,,‫المتجر هناك يبيعها.
Dialogue: 0,0:21:38.74,0:21:40.49,DC,,0,0,0,,!أوه... انظروا إلى هذا
Dialogue: 0,0:21:40.58,0:21:44.25,DC,,0,0,0,,‫أونيمارو، الذي استولى على مبنى البرلمان الوطني،
Dialogue: 0,0:21:44.33,0:21:47.58,DC,,0,0,0,,بات يكتسب مؤيدين على مستوى البلاد بفضل منتجات أونيمارو
Dialogue: 0,0:21:47.67,0:21:50.63,DC,,0,0,0,,‫بما في ذلك الحلويات الفاخرة والتعاون مع العديد من المنتجات.
Dialogue: 0,0:21:50.71,0:21:52.50,DC,,0,0,0,,‫ذلك الأونيمارو!
Dialogue: 0,0:21:53.05,0:21:55.34,DC,,0,0,0,,،قبل أن يزداد تأثيره أكثر
Dialogue: 0,0:21:55.42,0:21:57.76,DC,,0,0,0,,.يجب أن نسارع إلى جزيرة غانريو
Dialogue: 0,0:21:59.93,0:22:01.51,DC,,0,0,0,,‫أقوى...
Dialogue: 0,0:22:02.43,0:22:04.52,DC,,0,0,0,,!يجب أن أصبح أقوى
Dialogue: 0,0:23:39.74,0:23:41.74,DC,,0,0,0,,‫أخيرًا وصلنا إلى جزيرة غانريو.
Dialogue: 0,0:23:41.82,0:23:43.07,DC,,0,0,0,,‫لكن عندما وصلنا...
Dialogue: 0,0:23:43.16,0:23:46.28,DC,,0,0,0,,!هل تمزحون معي!؟ لا أصدق أن شيئاً كهذا سيحدث
Dialogue: 0,0:23:46.37,0:23:48.12,DC,,0,0,0,,‫يايبااا~!
Dialogue: 0,0:23:48.20,0:23:53.20,DCNN,,0,0,0,,{\pos(960,1000.0)}‫في الحلقة القادمة: عودة كوجيرو من العالم الآخر
Dialogue: 0,0:23:50.16,0:23:51.92,DC,,0,0,0,,{\an8}!هـ-هذا فظيع
