Dialogue: 0,0:00:00.00,0:00:08.00,Default2,,0,0,0,,{\fs70\pos(960,60)\an5}لا تنسوا الدعاء لإخوانكم في فلسطين والسودان وفي سائر بلاد المسلمين
Dialogue: 0,0:00:01.00,0:00:08.00,DCRights,,0,0,0,,{\fs70\pos(20,25)} ABOODY SUBS | ترجمة \NTelegram : ABOODY-SUBS\NX : @ABOODY_SUBS
Dialogue: 0,0:00:02.25,0:00:03.83,Default,,0,0,0,,!لقد عدت
Dialogue: 0,0:00:03.84,0:00:06.30,Default,,0,0,0,,!س-ساياكا
Dialogue: 0,0:00:07.26,0:00:08.80,Default,,0,0,0,,...الحمد لله أنكِ بخير
Dialogue: 0,0:00:08.80,0:00:11.18,Default,,0,0,0,,.لقد عدت لأبقى معكم، أبي، أمي
Dialogue: 0,0:00:13.64,0:00:14.81,Default,,0,0,0,,.أنا جائع جدًا
Dialogue: 0,0:00:14.81,0:00:16.19,Default,,0,0,0,,.وأنا متعب جداً
Dialogue: 0,0:00:16.18,0:00:17.56,Default,,0,0,0,,.لقد قلتها أيضاً
Dialogue: 0,0:00:17.56,0:00:22.06,Default,,0,0,0,,...حسنًا، الآنسة الصغيرة المشاغبة قررت أخيرًا العودة إلى المنزل
Dialogue: 0,0:00:22.06,0:00:24.48,Default,,0,0,0,,!إذن ، من أنتم جميعًا؟
Dialogue: 0,0:00:24.48,0:00:26.77,Default,,0,0,0,,.جدتي، دعيني أعرّفكِ عليهم
Dialogue: 0,0:00:27.36,0:00:31.20,Default,,0,0,0,,...هذا جيروزايمون والسيد خيار البحر.وايضاً
Dialogue: 0,0:00:31.74,0:00:35.45,Default,,0,0,0,,.وهذا الشخص هنا هو الوحيد والأوحد مياموتو موساشي
Dialogue: 0,0:00:36.41,0:00:39.83,Default,,0,0,0,,!اتمزحين؟، ايعقل انه مبتكر أسلوب السيفين؟
Dialogue: 0,0:00:39.83,0:00:41.91,Default,,0,0,0,,...أ-أنت، أنت، أنت
Dialogue: 0,0:00:41.92,0:00:47.26,Default,,0,0,0,,!اتقولين لي أن هذا العجوز الضعيف مياموتو ماساشي؟
Dialogue: 0,0:00:48.42,0:00:50.80,Default,,0,0,0,,.أنتِ عجوز مثلي أيضاً
Dialogue: 0,0:00:50.80,0:00:53.14,Default,,0,0,0,,.موساشي عمره أربعمائة عام، كما تعلمين
Dialogue: 0,0:00:54.93,0:00:59.27,Default,,0,0,0,,...لقد كنتُ معجبًا بك... كنتَ بطلي
Dialogue: 0,0:01:01.77,0:01:03.10,Default,,0,0,0,,!جدتي
Dialogue: 0,0:01:05.23,0:01:06.61,Default,,0,0,0,,!ما هذا...؟
Dialogue: 0,0:01:06.61,0:01:09.32,Default,,0,0,0,,!ما الذي تفعله هنا، كوجيرو؟
Dialogue: 0,0:01:11.82,0:01:14.36,Default,,0,0,0,,.لقد قابلته في المدينة
Dialogue: 0,0:01:14.37,0:01:17.75,Default,,0,0,0,,!لقد سال عنك وكان لطيفًا جدًا ومهتمًا
Dialogue: 0,0:01:18.41,0:01:21.58,Default,,0,0,0,,!حسنًا، كما ترى، لدي دائمًا ضعف للجمال في الكيمونو
Dialogue: 0,0:01:23.96,0:01:26.55,Default,,0,0,0,,...ما زلتَ مغرمًا بالنساء، كما أرى
Dialogue: 0,0:01:26.54,0:01:29.42,Default,,0,0,0,,وما هي الأعمال الودية التي تجلبك إلى هنا؟
Dialogue: 0,0:01:29.42,0:01:31.84,Default,,0,0,0,,.أنا هنا بلا أي نية للمنافسة
Dialogue: 0,0:01:31.84,0:01:33.30,Default,,0,0,0,,.أنا مجرد صديق قديم
Dialogue: 0,0:01:33.30,0:01:34.47,Default,,0,0,0,,.لا شيء أكثر من ذلك
Dialogue: 0,0:01:35.14,0:01:36.97,Default,,0,0,0,,.أنا نوعًا ما متشرد في الوقت الحالي
Dialogue: 0,0:01:36.97,0:01:38.93,Default,,0,0,0,,...اسمعوا هذا الرجل
Dialogue: 0,0:01:40.98,0:01:42.07,Default,,0,0,0,,...سيف الرعد
Dialogue: 0,0:01:43.02,0:01:44.98,Default,,0,0,0,,...الشيء الوحيد الذي يفصل بيني
Dialogue: 0,0:01:44.98,0:01:47.65,Default,,0,0,0,,...وبين أن أصبح أعظم ساموراي في كل الأرض
Dialogue: 0,0:01:48.40,0:01:51.36,Default,,0,0,0,,!أعظم ساموراي في العالم
Dialogue: 0,0:02:03.87,0:02:06.12,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:02:07.76,0:02:09.85,Opening,,0,0,0,,الإرادة للفوز هي شهادة على جديتي
Dialogue: 0,0:02:09.86,0:02:12.91,Opening,,0,0,0,,لكنك لن تصدق ذلك، أليس كذلك؟
Dialogue: 0,0:02:12.82,0:02:15.27,Opening,,0,0,0,,المنطق السليم يمكن أن يكون عبئًا
Dialogue: 0,0:02:15.26,0:02:18.04,Opening,,0,0,0,,أستطيع التحدي لأني جاهل
Dialogue: 0,0:02:18.05,0:02:19.19,Opening,,0,0,0,,هل أنا "ساموراي حقيقي"؟
Dialogue: 0,0:02:19.20,0:02:20.46,Opening,,0,0,0,,أم مجرد "لاعب وقح؟
Dialogue: 0,0:02:20.46,0:02:23.12,Opening,,0,0,0,,علي أن أتحدى لأني أريد أن أعرف
Dialogue: 0,0:02:23.11,0:02:28.48,Opening,,0,0,0,,الشغف في قلبي كان ساطعًا مثل البرق
Dialogue: 0,0:02:28.94,0:02:33.66,Opening,,0,0,0,,بغض النظر عن مقدار تغيرك
Dialogue: 0,0:02:33.92,0:02:38.35,Opening,,0,0,0,,لا يوجد كذب في المعارك التي خضناها
Dialogue: 0,0:02:38.35,0:02:43.10,Opening,,0,0,0,,أنا أمضي قدمًا بالشجاعة لأعيش بسرعة وتهور
Dialogue: 0,0:02:43.09,0:02:49.04,Opening,,0,0,0,,لأصل إلى القوة الجديدة المثيرة
Dialogue: 0,0:02:50.42,0:02:55.20,Opening,,0,0,0,,لنرفع سيوفنا نحو الغد
Dialogue: 0,0:02:55.21,0:03:00.23,Opening,,0,0,0,,أيقظ القوة الطبية 
Dialogue: 0,0:03:00.23,0:03:05.00,Opening,,0,0,0,,الآن تهب علينا الأقدار المحترقة
Dialogue: 0,0:03:05.00,0:03:09.92,Opening,,0,0,0,,سأقطع علامات اليأس
Dialogue: 0,0:03:09.92,0:03:11.74,Opening,,0,0,0,,بهذا "السيف" الحقيقي
Dialogue: 0,0:03:21.99,0:03:26.91,Default,,0,0,0,,الحلقة 9: فجر ضربة البرق
Dialogue: 0,0:03:27.46,0:03:32.37,Default,,0,0,0,,!تلك الشياطين والأشرار الآخرين لم يكونوا شيئًا مقابل يايبا و سيف الزوبعة
Dialogue: 0,0:03:32.38,0:03:34.51,Default,,0,0,0,,!لقد كان قويًا جدًا
Dialogue: 0,0:03:35.05,0:03:36.76,Default,,0,0,0,,!...ساياكا
Dialogue: 0,0:03:36.76,0:03:39.47,Default,,0,0,0,,!لديكِ الكثير لتقوليه عن يايبا
Dialogue: 0,0:03:39.47,0:03:41.18,Default,,0,0,0,,...حسنًا، أقصد
Dialogue: 0,0:03:41.76,0:03:43.60,Default,,0,0,0,,.كان نوعًا ما قويًا
Dialogue: 0,0:03:44.10,0:03:45.02,Default,,0,0,0,,...هذا فقط
Dialogue: 0,0:03:47.19,0:03:52.07,Default,,0,0,0,,إذًا هذا هو السيف الأسطوري الذي كان يتحدث عنه كينجورو؟
Dialogue: 0,0:03:53.78,0:03:57.07,Default,,0,0,0,,.سمعتُ أن مجرد لمس النصل شبه مستحيل
Dialogue: 0,0:03:57.07,0:04:01.03,Default,,0,0,0,,.حمله على ظهره هكذا، حسنًا، يجب أن أقول، هذا يُظهر نضجًا
Dialogue: 0,0:04:02.62,0:04:05.92,Default,,0,0,0,,!وسأستخدمه لسحق أونيمارو
Dialogue: 0,0:04:07.00,0:04:10.21,Default,,0,0,0,,.وهذا من فتى لا يستطيع التحكم فيه بالكامل بعد
Dialogue: 0,0:04:10.21,0:04:13.46,Default,,0,0,0,,!أنت بحاجة إلى تدريب! أنت بحاجة إلى تقنيات جديدة
Dialogue: 0,0:04:13.46,0:04:14.42,Default,,0,0,0,,!أحمق صغير
Dialogue: 0,0:04:16.01,0:04:17.47,Default,,0,0,0,,!تقنيات جديدة؟
Dialogue: 0,0:04:17.47,0:04:18.85,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:04:18.84,0:04:22.05,Default,,0,0,0,,!شاهد، سأبتكر تقنية مذهلة وأصبح أقوى
Dialogue: 0,0:04:22.80,0:04:24.88,Default,,0,0,0,, !إذًا فقد تقرر الأمر! التدريب يبدأ الآن
Dialogue: 0,0:04:24.89,0:04:25.81,Default,,0,0,0,,!نعم
Dialogue: 0,0:04:25.81,0:04:27.69,Default,,0,0,0,,!سنبدأ بالتغذية السليمة
Dialogue: 0,0:04:27.68,0:04:30.39,Default,,0,0,0,,!ملء البطن جزء من التدريب
Dialogue: 0,0:04:30.77,0:04:31.69,Default,,0,0,0,,!نعم
Dialogue: 0,0:04:33.48,0:04:35.94,Default,,0,0,0,,...عزيزتي، فاتورة الطعام ستكون كبيرة جدًا
Dialogue: 0,0:04:35.94,0:04:37.82,Default,,0,0,0,,.مثل هذا الحماس
Dialogue: 0,0:04:37.82,0:04:38.95,Default,,0,0,0,,.نعم
Dialogue: 0,0:04:39.40,0:04:42.69,Default,,0,0,0,,.من الواضح أنه كان يعمل على أكثر من مهاراته بالسيف
Dialogue: 0,0:04:42.70,0:04:43.78,Default,,0,0,0,,!نعم
Dialogue: 0,0:04:46.91,0:04:50.83,Default,,0,0,0,,...يجب أن أتحرك قبل أن يصبح مصدر إزعاج أكبر
Dialogue: 0,0:04:56.00,0:04:57.08,Default,,0,0,0,,.اسمع الآن، يايبا
Dialogue: 0,0:04:57.09,0:05:00.88,Default,,0,0,0,,.النينجا لا يعلنون عن وجودهم أبدًا
Dialogue: 0,0:05:00.88,0:05:01.80,Default,,0,0,0,,!صحيح
Dialogue: 0,0:05:02.47,0:05:04.31,Default,,0,0,0,,...أيًا كان ما تقوله
Dialogue: 0,0:05:04.30,0:05:05.93,Default,,0,0,0,,!يجب أن يكون مهمًا
Dialogue: 0,0:05:05.93,0:05:09.68,Default,,0,0,0,,!بالضبط! التخفي مهم للغاية
Dialogue: 0,0:05:09.68,0:05:14.02,Default,,0,0,0,,!بدونه، الخبرة القاتلة لا معنى لها
Dialogue: 0,0:05:15.11,0:05:16.65,Default,,0,0,0,,!هيا الآن! اتبعني
Dialogue: 0,0:05:17.48,0:05:18.61,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:05:25.28,0:05:27.45,Default,,0,0,0,,...هذا غريب
Dialogue: 0,0:05:38.17,0:05:41.63,Default,,0,0,0,,...ماذا؟ كنتُ اعتقد أن هناك أحدًا هنا
Dialogue: 0,0:05:42.22,0:05:43.81,Default,,0,0,0,,أكان خيالي؟
Dialogue: 0,0:05:47.85,0:05:50.52,Default,,0,0,0,,ماذا حدث لكم ؟
Dialogue: 0,0:05:50.52,0:05:53.86,Default,,0,0,0,,...لقد بالغنا قليلًا في تدريبنا
Dialogue: 0,0:05:54.35,0:05:56.89,Default,,0,0,0,,.محاولة للتلصص، بلا شك
Dialogue: 0,0:05:56.90,0:05:58.36,Default,,0,0,0,,!هذا هراء
Dialogue: 0,0:05:59.03,0:06:01.57,Default,,0,0,0,,.تدريب قوي بالفعل
Dialogue: 0,0:06:02.07,0:06:05.28,Default,,0,0,0,,إذن، هل توصلت إلى تقنية جديدة؟
Dialogue: 0,0:06:12.62,0:06:15.29,Default,,0,0,0,,م-ماذا هناك؟
Dialogue: 0,0:06:15.29,0:06:16.67,Default,,0,0,0,,!هذا هو
Dialogue: 0,0:06:18.04,0:06:20.25,Default,,0,0,0,,!لدي فكرة
Dialogue: 0,0:06:24.97,0:06:26.51,Default,,0,0,0,,!ها أنا ذا، موساشي
Dialogue: 0,0:06:27.05,0:06:28.09,Default,,0,0,0,,...حسنًا
Dialogue: 0,0:06:28.10,0:06:29.35,Default,,0,0,0,,ماذا لديك، يا فتى؟
Dialogue: 0,0:06:29.35,0:06:31.31,Default,,0,0,0,,.ها نحن ذا
Dialogue: 0,0:06:31.97,0:06:33.43,Default,,0,0,0,,...أسميها
Dialogue: 0,0:06:33.43,0:06:34.35,Default,,0,0,0,,ماذا...؟!
Dialogue: 0,0:06:35.56,0:06:36.56,Default,,0,0,0,,...يايبا
Dialogue: 0,0:06:37.27,0:06:38.81,Default,,0,0,0,,!ضربة الضوء 
Dialogue: 0,0:06:41.40,0:06:42.78,Default,,0,0,0,,حسنًا؟ رائع، أليس كذلك؟
Dialogue: 0,0:06:43.24,0:06:44.45,Default,,0,0,0,,!أيها الأحمق
Dialogue: 0,0:06:44.45,0:06:47.54,Default,,0,0,0,,هذا لن ينجح في النهار!
Dialogue: 0,0:06:47.53,0:06:49.49,Default,,0,0,0,,صحيح...
Dialogue: 0,0:06:49.49,0:06:53.83,Default,,0,0,0,,!تبا... لن تحصل على لقمة أخرى حتى تبتكر تقنية جديدة
Dialogue: 0,0:06:53.83,0:06:56.33,Default,,0,0,0,,!مهلا!، انتظر لحظة
Dialogue: 0,0:06:56.33,0:06:57.46,Default,,0,0,0,,!انت
Dialogue: 0,0:06:57.96,0:07:00.71,Default,,0,0,0,,...يبدو أن الأمر سيستغرق بعض الوقت
Dialogue: 0,0:07:05.13,0:07:07.59,Default,,0,0,0,,...تألق العيون بضوء ألف شمس
Dialogue: 0,0:07:09.55,0:07:12.68,Default,,0,0,0,,!يا له من فعل همجي
Dialogue: 0,0:07:20.02,0:07:23.52,Default,,0,0,0,,.يايبا كان هكذا منذ الليلة الماضية
Dialogue: 0,0:07:24.15,0:07:26.57,Default,,0,0,0,,.تركيز مثير للإعجاب
Dialogue: 0,0:07:26.57,0:07:30.45,Default,,0,0,0,,...إذا فعلت هذا، فسيفعلون هذا
Dialogue: 0,0:07:32.70,0:07:34.91,Default,,0,0,0,,...أنا جائع جدًا
Dialogue: 0,0:07:34.91,0:07:36.20,Default,,0,0,0,,!يايبا
Dialogue: 0,0:07:38.33,0:07:39.16,Default,,0,0,0,,...تفضل
Dialogue: 0,0:07:39.17,0:07:40.71,Default,,0,0,0,,.لا بد أنك جائع
Dialogue: 0,0:07:42.96,0:07:44.46,Default,,0,0,0,,!كرات الأرز
Dialogue: 0,0:07:46.09,0:07:49.47,Default,,0,0,0,,!لن تحصل على لقمة أخرى حتى تبتكر تقنية جديدة
Dialogue: 0,0:07:50.05,0:07:52.18,Default,,0,0,0,,!لا. لا أستطيع فعل ذلك
Dialogue: 0,0:07:52.68,0:07:53.68,Default,,0,0,0,,حسنًا، لماذا؟
Dialogue: 0,0:07:54.18,0:07:58.64,Default,,0,0,0,,!لأنه لهزيمة أونيمارو لأكون أفضل ساموراي في اليابان، يجب أن أفكر في شيء
Dialogue: 0,0:07:59.19,0:08:03.07,Default,,0,0,0,,!ليس لدي وقت لكرات الأرز، حسنًا؟
Dialogue: 0,0:08:03.57,0:08:06.11,Default,,0,0,0,,!يمكنك أن تكون وقحًا حقًا، أتعلم؟
Dialogue: 0,0:08:06.65,0:08:09.70,Default,,0,0,0,,هل ترغب في رؤية تقنيتي الجديدة؟
Dialogue: 0,0:08:11.24,0:08:12.20,Default,,0,0,0,,...كرة الأرز
Dialogue: 0,0:08:12.20,0:08:13.12,Default,,0,0,0,,!ضربة
Dialogue: 0,0:08:15.70,0:08:17.66,Default,,0,0,0,,!لا أعرف لماذا،  ولكن هذا مضحك
Dialogue: 0,0:08:18.50,0:08:20.00,Default,,0,0,0,,!ضربة كرة الأرز
Dialogue: 0,0:08:21.21,0:08:24.63,Default,,0,0,0,,!هل يمكنني الحصول على بعض الهدوء؟
Dialogue: 0,0:08:25.76,0:08:27.09,Default,,0,0,0,,...تبا
Dialogue: 0,0:08:32.35,0:08:34.52,Default,,0,0,0,,...إذا أرجعت السيف للأسفل
Dialogue: 0,0:08:35.60,0:08:37.64,Default,,0,0,0,,.فسوف يحجبونه فقط
Dialogue: 0,0:08:39.06,0:08:41.31,Default,,0,0,0,,...يجب أن أجعلها غير قابلة للحجب
Dialogue: 0,0:08:56.08,0:08:57.04,Default,,0,0,0,,!ذلك...
Dialogue: 0,0:08:58.25,0:09:00.09,Default,,0,0,0,,!هذا هو
Dialogue: 0,0:09:07.55,0:09:10.76,Default,,0,0,0,,اعذرني، ولكن... إلى متى تخطط للبقاء؟
Dialogue: 0,0:09:10.76,0:09:13.30,Default,,0,0,0,,.نحن أصدقاء منذ وقت طويل. لا داعي لأن تكون غاضبًا
Dialogue: 0,0:09:13.30,0:09:14.97,Default,,0,0,0,,...ها أنت ذا مرة أخرى
Dialogue: 0,0:09:14.97,0:09:16.72,Default,,0,0,0,,!حسنًا، استعد، موساشي
Dialogue: 0,0:09:16.72,0:09:19.10,Default,,0,0,0,,.لقد توصلت إلى ثلاث تقنيات جديدة
Dialogue: 0,0:09:19.10,0:09:20.94,Default,,0,0,0,,...ها هي الأولى
Dialogue: 0,0:09:23.15,0:09:24.15,Default,,0,0,0,,...يايبا
Dialogue: 0,0:09:24.15,0:09:26.19,Default,,0,0,0,,!وابل الخناجر
Dialogue: 0,0:09:29.86,0:09:30.99,Default,,0,0,0,,ما رأيك؟
Dialogue: 0,0:09:32.49,0:09:33.70,Default,,0,0,0,,!أحمق
Dialogue: 0,0:09:33.70,0:09:35.66,Default,,0,0,0,,!هذه ليست تقنية
Dialogue: 0,0:09:36.70,0:09:38.37,Default,,0,0,0,,...فهمت
Dialogue: 0,0:09:39.12,0:09:40.75,Default,,0,0,0,,!حسنًا، لدي شيء آخر
Dialogue: 0,0:09:43.33,0:09:44.33,Default,,0,0,0,,!شاهد هذا
Dialogue: 0,0:09:44.33,0:09:46.79,Default,,0,0,0,,!ضربة يايبا البوميرانغ
Dialogue: 0,0:09:46.79,0:09:47.96,Default,,0,0,0,,بوو...؟
Dialogue: 0,0:09:47.96,0:09:49.42,Default,,0,0,0,,ضربة البوميرانغ؟
Dialogue: 0,0:10:02.31,0:10:03.77,Default,,0,0,0,,!ما هذا...؟
Dialogue: 0,0:10:04.23,0:10:05.77,Default,,0,0,0,,!إنه بوميرانغ حقيقي
Dialogue: 0,0:10:12.49,0:10:13.37,Default,,0,0,0,,!أحمق
Dialogue: 0,0:10:13.36,0:10:16.11,Default,,0,0,0,,!ممتاز لجعلك تشعر بالدوار
Dialogue: 0,0:10:17.53,0:10:18.53,Default,,0,0,0,,.سخيف
Dialogue: 0,0:10:18.53,0:10:20.78,Default,,0,0,0,,!مهلا! لدي المزيد
Dialogue: 0,0:10:21.58,0:10:22.66,Default,,0,0,0,,!تبا
Dialogue: 0,0:10:22.66,0:10:24.70,Default,,0,0,0,,!حان الوقت لأريهم ورقة رابحتي
Dialogue: 0,0:10:29.75,0:10:31.54,Default,,0,0,0,,...سيف الرعد بدون كرة
Dialogue: 0,0:10:33.55,0:10:35.39,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:10:48.86,0:10:51.32,Default,,0,0,0,,!ما الذي شاهدت للتو؟
Dialogue: 0,0:10:54.32,0:10:55.91,Default,,0,0,0,,\N... لم تنجح
Dialogue: 0,0:10:56.57,0:10:59.53,Default,,0,0,0,,.لا، يا فتى، أنت الآن على الطريق الصحيح
Dialogue: 0,0:10:59.53,0:11:00.74,Default,,0,0,0,,!أ-أحقًا؟
Dialogue: 0,0:11:01.16,0:11:03.29,Default,,0,0,0,,.لكنها ليست مثالية بعد
Dialogue: 0,0:11:03.29,0:11:04.75,Default,,0,0,0,,!تبا
Dialogue: 0,0:11:04.75,0:11:06.59,Default,,0,0,0,,!إذًا سأحاول مرة أخرى
Dialogue: 0,0:11:07.33,0:11:12.09,Default,,0,0,0,,.يا فتى، مثابرتك بدأت تؤتي ثمارها
Dialogue: 0,0:11:12.67,0:11:14.80,Default,,0,0,0,,أراهن أنه لن يمضي وقت طويل
Dialogue: 0,0:11:14.80,0:11:17.80,Default,,0,0,0,,...قبل أن تتمكن من التحكم في سيف الرعد
Dialogue: 0,0:11:19.22,0:11:21.76,Default,,0,0,0,,...يجب أن أحصل على سيف الرعد
Dialogue: 0,0:11:22.22,0:11:25.01,Default,,0,0,0,,...قبل أن يكمّل هذه التقنية
Dialogue: 0,0:11:34.94,0:11:37.48,Default,,0,0,0,, .جيد، هذا يجب أن يكفي
Dialogue: 0,0:11:37.49,0:11:38.78,Default,,0,0,0,,!ها أنا ذا
Dialogue: 0,0:11:38.78,0:11:39.70,Default,,0,0,0,, !انطلق
Dialogue: 0,0:11:42.74,0:11:44.53,Default,,0,0,0,,!سيف الرعد بدون كرة
Dialogue: 0,0:11:45.08,0:11:46.42,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:11:57.88,0:12:01.09,Default,,0,0,0,,...واحد... اثنان
Dialogue: 0,0:12:02.76,0:12:04.34,Default,,0,0,0,,!لا! غير مرضٍ
Dialogue: 0,0:12:04.35,0:12:06.64,Default,,0,0,0,,!كان ذلك مجرد ثلاثة عشر
Dialogue: 0,0:12:06.64,0:12:09.56,Default,,0,0,0,,!إذًا كم يجب أن أقطع؟
Dialogue: 0,0:12:09.56,0:12:11.15,Default,,0,0,0,,...لنرى
Dialogue: 0,0:12:11.81,0:12:13.40,Default,,0,0,0,,...مع خيزران بهذا السماكة
Dialogue: 0,0:12:13.90,0:12:16.40,Default,,0,0,0,,.أقول أربعة أضعاف ذلك، حوالي خمسين
Dialogue: 0,0:12:16.40,0:12:18.07,Default,,0,0,0,,!خ-خمسين؟
Dialogue: 0,0:12:18.65,0:12:21.69,Default,,0,0,0,,.وما هذا؟ انظر إلى القطع التي صنعتها
Dialogue: 0,0:12:21.70,0:12:25.45,Default,,0,0,0,,!اقلب تلك المعاصم... اقطع أفقيًا
Dialogue: 0,0:12:25.91,0:12:27.37,Default,,0,0,0,,أفقيًا؟
Dialogue: 0,0:12:28.54,0:12:30.50,Default,,0,0,0,,!نعم، افعلها الآن، يايبا
Dialogue: 0,0:12:30.50,0:12:33.17,Default,,0,0,0,,!أكمِل ضربة البرق
Dialogue: 0,0:12:33.17,0:12:34.09,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:12:36.01,0:12:37.22,Default,,0,0,0,,!ماذا تفعل؟
Dialogue: 0,0:12:37.21,0:12:38.75,Default,,0,0,0,,،بهذا المعدل
Dialogue: 0,0:12:38.76,0:12:41.72,Default,,0,0,0,,.إنها مسألة وقت قبل أن يصاب بالإرهاق
Dialogue: 0,0:12:42.26,0:12:44.68,Default,,0,0,0,,،سأنتظر حتى يتعب
Dialogue: 0,0:12:45.60,0:12:47.60,Default,,0,0,0,,!ثم سأهاجم وآخذ سيف الرعد
Dialogue: 0,0:12:52.06,0:12:53.69,Default,,0,0,0,,!أيها الملك أونيمارو
Dialogue: 0,0:12:54.23,0:12:58.11,Default,,0,0,0,,!خطتي لجذبهم تسير على ما يرام
Dialogue: 0,0:12:58.90,0:13:01.36,Default,,0,0,0,,.أعتمد عليك، سيد العنكبوت
Dialogue: 0,0:13:01.36,0:13:02.57,Default,,0,0,0,,.نعم
Dialogue: 0,0:13:02.57,0:13:05.07,Default,,0,0,0,,.سأنشر الخبر في الأرجاء
Dialogue: 0,0:13:09.46,0:13:12.05,Default,,0,0,0,,.هذه المرة نحسم الأمور
Dialogue: 0,0:13:20.42,0:13:23.80,Default,,0,0,0,,.أفضل بكثير، أفضل بكثير، ولكن ليس تمامًا بعد
Dialogue: 0,0:13:23.80,0:13:25.43,Default,,0,0,0,,!فقط قليلًا أكثر الآن
Dialogue: 0,0:13:26.31,0:13:27.19,Default,,0,0,0,,!تبا
Dialogue: 0,0:13:28.18,0:13:31.18,Default,,0,0,0,,.سرعة ضرباتك تحتاج للتحسين
Dialogue: 0,0:13:31.19,0:13:34.69,Default,,0,0,0,,.لكن جودة كل ضربة أصبحت أكثر حدة
Dialogue: 0,0:13:34.69,0:13:39.03,Default,,0,0,0,,.بخلاف ذلك، لا يمكن قول شيء خارج معركة حقيقية بالسيوف
Dialogue: 0,0:13:42.78,0:13:44.11,Default,,0,0,0,,...أنا متعب جدًا
Dialogue: 0,0:13:45.03,0:13:46.24,Default,,0,0,0,,!الآن جاء دوري
Dialogue: 0,0:13:53.21,0:13:54.13,Default,,0,0,0,,!إنه لي
Dialogue: 0,0:13:54.12,0:13:55.87,Default,,0,0,0,,ماذا تفعل، كوجيرو؟
Dialogue: 0,0:13:55.88,0:13:58.63,Default,,0,0,0,,... أنا، في الحقيقة
Dialogue: 0,0:13:58.63,0:14:00.92,Default,,0,0,0,,لماذا تتسلل هكذا؟
Dialogue: 0,0:14:00.92,0:14:02.76,Default,,0,0,0,,!ي-يايبا
Dialogue: 0,0:14:03.43,0:14:05.01,Default,,0,0,0,,لقد تعرقت كثيرًا.
Dialogue: 0,0:14:05.01,0:14:06.55,Default,,0,0,0,,!أحضرت لك منشفة ناعمة
Dialogue: 0,0:14:08.56,0:14:10.35,Default,,0,0,0,,...لقد رآني قادمًا
Dialogue: 0,0:14:10.98,0:14:12.61,Default,,0,0,0,,.لقد قللت من شأنه
Dialogue: 0,0:14:13.10,0:14:14.77,Default,,0,0,0,,!...فرصتي القادمة
Dialogue: 0,0:14:14.77,0:14:17.73,Default,,0,0,0,,.يجب ألا تصاب بالبرد، يايبا -\N !مهلا، توقف! هذا مؤلم -
Dialogue: 0,0:14:21.94,0:14:24.07,Default,,0,0,0,,...هذا ثقيل
Dialogue: 0,0:14:24.70,0:14:27.70,Default,,0,0,0,,...حسنًا! إنه مشغول الآن
Dialogue: 0,0:14:27.70,0:14:29.37,Default,,0,0,0,,!الآن جاء دوري
Dialogue: 0,0:14:33.91,0:14:35.54,Default,,0,0,0,,.مرحبًا، كوجيرو
Dialogue: 0,0:14:35.54,0:14:37.37,Default,,0,0,0,,أتيت لمساعدتي؟
Dialogue: 0,0:14:37.38,0:14:39.17,Default,,0,0,0,,!هذا لطيف جدًا
Dialogue: 0,0:14:47.97,0:14:49.56,Default,,0,0,0,,...طالما بقي نائمًا
Dialogue: 0,0:14:51.27,0:14:53.69,Default,,0,0,0,,!مهلا! هذا لحمي
Dialogue: 0,0:14:58.27,0:14:59.69,Default,,0,0,0,,!...أيها الوغد
Dialogue: 0,0:15:00.98,0:15:03.52,Default,,0,0,0,,.يايبا، يجب أن ترتاح
Dialogue: 0,0:15:03.53,0:15:05.11,Default,,0,0,0,,ماذا عن حمام لطيف مريح؟
Dialogue: 0,0:15:05.11,0:15:06.53,Default,,0,0,0,,.حسناً
Dialogue: 0,0:15:07.36,0:15:08.40,Default,,0,0,0,,!نعم
Dialogue: 0,0:15:08.87,0:15:11.75,Default,,0,0,0,,...سيستمتع بحمامه، وسآخذ سيفه
Dialogue: 0,0:15:13.75,0:15:14.83,Default,,0,0,0,,...أنت
Dialogue: 0,0:15:15.46,0:15:18.80,Default,,0,0,0,,تأخذ سيفك معك إلى الحمام؟
Dialogue: 0,0:15:18.79,0:15:20.88,Default,,0,0,0,,.بالطبع
Dialogue: 0,0:15:20.88,0:15:24.80,Default,,0,0,0,,.تقول التقارير إنه طالب في المدرسة الإعدادية
Dialogue: 0,0:15:24.80,0:15:27.47,Default,,0,0,0,, ماذا يحدث؟ -\N ...المزيد من التفاصيل قريبًا -
Dialogue: 0,0:15:27.47,0:15:28.60,Default,,0,0,0,,.يايبا
Dialogue: 0,0:15:28.59,0:15:30.55,Default,,0,0,0,, .مزيد من التحقيق -\N ...الأخبار -
Dialogue: 0,0:15:31.10,0:15:32.10,Default,,0,0,0,,.أخبار عاجلة
Dialogue: 0,0:15:32.10,0:15:34.56,Default,,0,0,0,,،بالإضافة إلى مبنى البرلمان الوطني
Dialogue: 0,0:15:34.56,0:15:36.90,Default,,0,0,0,,أونيمارو سيطر على عدد من المناطق
Dialogue: 0,0:15:36.89,0:15:38.72,Default,,0,0,0,,.في جميع أنحاء منطقة كانتو
Dialogue: 0,0:15:38.73,0:15:42.48,Default,,0,0,0,,.يعتقد أن أجزاء من سايتاما قد وقعت أيضًا تحت سيطرته
Dialogue: 0,0:15:42.48,0:15:44.81,Default,,0,0,0,,متى فعل كل هذا؟
Dialogue: 0,0:15:44.82,0:15:48.16,Default,,0,0,0,,.يجب أن تكمِل تقنيتك الجديدة
Dialogue: 0,0:15:48.16,0:15:51.62,Default,,0,0,0,,.يجب أن نتعامل مع هذا، على الفور
Dialogue: 0,0:15:52.16,0:15:53.74,Default,,0,0,0,,...أونيمارو، هذا الوغد
Dialogue: 0,0:15:53.74,0:15:55.37,Default,,0,0,0,,!يعتقد أنه يمكنه فعل ما يريد؟
Dialogue: 0,0:15:55.37,0:15:58.12,Default,,0,0,0,,!يجب أن أكتشف أمر ضربة البرق بسرعة
Dialogue: 0,0:15:58.12,0:15:59.25,Default,,0,0,0,,!هذا سيء
Dialogue: 0,0:15:59.25,0:16:04.71,Default,,0,0,0,,...يجب أن أحصل على سيف الرعد قبل أن يكمِل ضربة البرق
Dialogue: 0,0:16:06.92,0:16:10.13,Default,,0,0,0,,.في هذه الحالة، سأساعدك في تدريبك كخصم متواضع
Dialogue: 0,0:16:10.14,0:16:11.14,Default,,0,0,0,, حقًا؟
Dialogue: 0,0:16:11.14,0:16:12.81,Default,,0,0,0,,أتعتقد أن هذا جيد؟
Dialogue: 0,0:16:12.81,0:16:14.94,Default,,0,0,0,,أن تثق بكوجيرو بهذا، موساشي؟
Dialogue: 0,0:16:15.98,0:16:18.15,Default,,0,0,0,,.سيكون خصمًا ممتازًا
Dialogue: 0,0:16:28.53,0:16:31.20,Default,,0,0,0,,،ربما فاجأتني المرة السابقة
Dialogue: 0,0:16:31.91,0:16:34.66,Default,,0,0,0,,.لكن تقنيتك سهلة القراءة
Dialogue: 0,0:16:35.54,0:16:37.42,Default,,0,0,0,,ستحتاج إلى ابتكار شيء آخر
Dialogue: 0,0:16:37.41,0:16:38.66,Default,,0,0,0,,!لتتفوق علي
Dialogue: 0,0:16:49.38,0:16:50.34,Default,,0,0,0,,.تبا
Dialogue: 0,0:16:50.84,0:16:53.88,Default,,0,0,0,,!يجب أن أتحرك أسرع إذا أردت اللحاق بكوجيرو
Dialogue: 0,0:16:55.85,0:16:57.85,Default,,0,0,0,,.هذه الضربة القادمة ستنهي كل شيء
Dialogue: 0,0:16:58.98,0:17:01.02,Default,,0,0,0,,!سيف الرعد سيكون ملكي
Dialogue: 0,0:17:02.02,0:17:03.02,Default,,0,0,0,,!هيا
Dialogue: 0,0:17:04.31,0:17:06.52,Default,,0,0,0,,...أسرع... أسرع
Dialogue: 0,0:17:13.70,0:17:14.66,Default,,0,0,0,,!تسوباميغايشي
Dialogue: 0,0:17:17.41,0:17:19.54,Default,,0,0,0,,!ت-تسوباميغايشي؟
Dialogue: 0,0:17:25.54,0:17:26.50,Default,,0,0,0,,!هذا هو
Dialogue: 0,0:17:30.42,0:17:31.88,Default,,0,0,0,,...تسوباميغايشي الخاص بي
Dialogue: 0,0:17:32.68,0:17:34.06,Default,,0,0,0,,!لقد أحبط تقنيتي؟
Dialogue: 0,0:17:39.35,0:17:41.27,Default,,0,0,0,,!ها أنا ذا، كوجيرو
Dialogue: 0,0:17:44.52,0:17:46.65,Default,,0,0,0,,!سيف الرعد بدون كرة
Dialogue: 0,0:17:49.03,0:17:51.07,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:17:58.70,0:17:59.66,Default,,0,0,0,,!ما رأيك؟
Dialogue: 0,0:18:00.33,0:18:03.21,Default,,0,0,0,,...لقد تعلم من تسوباميغايشي الخاص بي
Dialogue: 0,0:18:06.63,0:18:07.84,Default,,0,0,0,,!أحسنت
Dialogue: 0,0:18:08.92,0:18:11.71,Default,,0,0,0,,.سرعتك وحدة قطعك لا مثيل لها
Dialogue: 0,0:18:11.72,0:18:14.01,Default,,0,0,0,,.ضربة البرق كانت رائعة
Dialogue: 0,0:18:14.01,0:18:15.22,Default,,0,0,0,,.حقا
Dialogue: 0,0:18:16.47,0:18:18.64,Default,,0,0,0,,!لقد فعلتها! لقد فعلتها
Dialogue: 0,0:18:18.64,0:18:21.14,Default,,0,0,0,,!لقد أكمَلت ضربة البرق
Dialogue: 0,0:18:21.14,0:18:22.77,Default,,0,0,0,,!أنا مدين لك، كوجيرو
Dialogue: 0,0:18:24.90,0:18:27.61,Default,,0,0,0,,!م-ماذا فعلت؟
Dialogue: 0,0:18:28.65,0:18:31.74,Default,,0,0,0,,...حسنًا، الآن بضربة البرق المحسنة
Dialogue: 0,0:18:31.74,0:18:33.70,Default,,0,0,0,,!سآتي لأجلك، أونيمارو
Dialogue: 0,0:18:33.70,0:18:35.83,Default,,0,0,0,,!لن تعرف ما الذي أصابك
Dialogue: 0,0:18:35.82,0:18:39.45,Default,,0,0,0,,!هذه هي الروح!، الآن، يجب أن نناقش الاستراتيجية
Dialogue: 0,0:18:39.45,0:18:40.37,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:18:42.83,0:18:44.08,Default,,0,0,0,,.انظروا جيدًا إلى هذا
Dialogue: 0,0:18:44.79,0:18:47.17,Default,,0,0,0,,.هذه خريطة لقلعة أونيمارو
Dialogue: 0,0:18:49.50,0:18:51.79,Default,,0,0,0,,إذًا أين يختبئ؟
Dialogue: 0,0:18:51.80,0:18:56.14,Default,,0,0,0,,.الملك أونيمارو على الأرجح هنا، في الطابق العلوي
Dialogue: 0,0:18:56.14,0:18:57.43,Default,,0,0,0,,...حسنًا، انتظر
Dialogue: 0,0:18:58.51,0:19:02.43,Default,,0,0,0,,.أرجاء القلعة محروسة بشدة من قبل شياطين الظل
Dialogue: 0,0:19:02.43,0:19:06.43,Default,,0,0,0,,.لا يمكننا اقتحامها، سيقبضون علينا
Dialogue: 0,0:19:06.90,0:19:08.07,Default,,0,0,0,,...هذا ما سنفعله
Dialogue: 0,0:19:09.02,0:19:13.69,Default,,0,0,0,,.نجمع النساء عند المدخل الأمامي
Dialogue: 0,0:19:14.40,0:19:15.65,Default,,0,0,0,,...ثم
Dialogue: 0,0:19:16.24,0:19:18.66,Default,,0,0,0,,...نقيم حفلة رائعة
Dialogue: 0,0:19:19.16,0:19:22.12,Default,,0,0,0,,.ونشتت انتباه شياطين الظل
Dialogue: 0,0:19:23.12,0:19:24.83,Default,,0,0,0,,...يا لها من استراتيجية أنيقة
Dialogue: 0,0:19:27.12,0:19:29.20,Default,,0,0,0,,!أعني، يا لها من خطة وقحة
Dialogue: 0,0:19:29.21,0:19:30.67,Default,,0,0,0,,.تبا
Dialogue: 0,0:19:30.67,0:19:34.09,Default,,0,0,0,,.قلت إن أونيمارو في القمة
Dialogue: 0,0:19:34.63,0:19:38.84,Default,,0,0,0,,أليس التحليق من الأعلى على شونوسوكي أسرع طريقة؟
Dialogue: 0,0:19:40.10,0:19:42.19,Default,,0,0,0,,!نعم! هذه هي خطتنا
Dialogue: 0,0:19:42.18,0:19:43.81,Default,,0,0,0,,...ما هذه الخطة
Dialogue: 0,0:19:46.89,0:19:49.52,Default,,0,0,0,,!لقد حان وقت اقتحام القلعة
Dialogue: 0,0:19:50.44,0:19:51.94,Default,,0,0,0,, !واحد -\N- !اثنان -
Dialogue: 0,0:19:52.65,0:19:53.48,Default,,0,0,0,,!أربعة
Dialogue: 0,0:19:53.98,0:19:54.81,Default,,0,0,0,,!ستة
Dialogue: 0,0:19:54.82,0:19:55.91,Default,,0,0,0,,!سبعة
Dialogue: 0,0:19:57.40,0:20:00.36,Default,,0,0,0,,.مهمة التسلل إلى قلعة أونيمارو على وشك البدء
Dialogue: 0,0:20:00.37,0:20:01.87,Default,,0,0,0,,!هل أنتم مستعدون؟
Dialogue: 0,0:20:03.29,0:20:06.17,Default,,0,0,0,,!حسنًا... انطلقوا
Dialogue: 0,0:20:11.04,0:20:14.79,Default,,0,0,0,,.كما توقعت، إنهم يتجهون بهذا الاتجاه
Dialogue: 0,0:20:14.80,0:20:17.22,Default,,0,0,0,,!أنهم بسطاء
Dialogue: 0,0:20:19.26,0:20:20.51,Default,,0,0,0,,.لقد حان الوقت
Dialogue: 0,0:20:21.14,0:20:23.23,Default,,0,0,0,,!أنت! استعدوا لمواقعكم
Dialogue: 0,0:20:24.51,0:20:26.85,Default,,0,0,0,,!أسحقوا هجومهم
Dialogue: 0,0:20:30.48,0:20:32.82,Default,,0,0,0,,!انظروا! تلك قلعة أونيمارو
Dialogue: 0,0:20:35.65,0:20:37.23,Default,,0,0,0,,!مذهل
Dialogue: 0,0:20:37.24,0:20:40.70,Default,,0,0,0,,!هناك عدد أكبر بكثير من شياطين الظل مما توقعت
Dialogue: 0,0:20:40.70,0:20:43.70,Default,,0,0,0,,!نلتزم بالخطة ونهاجم من الأعلى
Dialogue: 0,0:20:43.70,0:20:46.54,Default,,0,0,0,,كيف سنفعل ذلك؟ 
Dialogue: 0,0:20:47.58,0:20:48.58,Default,,0,0,0,,.هذا سهل بالنسبة لي
Dialogue: 0,0:20:50.87,0:20:52.75,Default,,0,0,0,,!امدد! مونوهوشيزاو
Dialogue: 0,0:20:59.22,0:21:01.14,Default,,0,0,0,,.لقد سار الأمر بشكل جيد
Dialogue: 0,0:21:03.22,0:21:04.39,Default,,0,0,0,,...يايبا
Dialogue: 0,0:21:05.01,0:21:05.84,Default,,0,0,0,,...هذه
Dialogue: 0,0:21:13.31,0:21:15.10,Default,,0,0,0,,.احتفظي بها
Dialogue: 0,0:21:15.61,0:21:16.94,Default,,0,0,0,,...لكن
Dialogue: 0,0:21:16.94,0:21:19.40,Default,,0,0,0,,.انت تحتفظين بها دائمًا
Dialogue: 0,0:21:20.24,0:21:23.16,Default,,0,0,0,,.بالإضافة إلى ذلك، لدي تقنية جديدة الآن
Dialogue: 0,0:21:25.45,0:21:26.83,Default,,0,0,0,,.أنت محق
Dialogue: 0,0:21:35.00,0:21:36.21,Default,,0,0,0,,!أونيمارو
Dialogue: 0,0:21:44.34,0:21:46.26,Default,,0,0,0,,...سوف
Dialogue: 0,0:21:47.26,0:21:48.55,Default,,0,0,0,,!أهزمك
Dialogue: 0,0:21:57.48,0:21:59.36,Default,,0,0,0,,!أونيمارو
Dialogue: 0,0:22:20.99,0:22:28.55,Ending,,0,0,0,,"ضُربتُ ببرقٍ حلوٍ لاذع، وانشغلت تماماً، يا "أومي
Dialogue: 0,0:22:28.74,0:22:36.53,Ending,,0,0,0,,تذوقت طعامك وانفجرتُ في الطريق
Dialogue: 0,0:22:37.15,0:22:41.03,Ending,,0,0,0,,ينبثق من أعماق قلبي شعور غامض، لم أعرفه من قبل
Dialogue: 0,0:22:41.10,0:22:45.07,Ending,,0,0,0,,كعكة اللحظة المنتظرة في كل احتفال مميز
Dialogue: 0,0:22:45.10,0:22:48.81,Ending,,0,0,0,,"نظرنا إلى بعضنا البعض وقلنا "إنه لذيذ
Dialogue: 0,0:22:48.89,0:22:52.08,Ending,,0,0,0,,"إنه لذيذ"، قلنا، ونحن ننظر إلى بعضنا البعض
Dialogue: 0,0:22:52.17,0:22:55.76,Ending,,0,0,0,,تلك الأيام التي تخطفك من الواقع بجمالها
Dialogue: 0,0:22:55.78,0:23:00.12,Ending,,0,0,0,,...أتمنى أن تدوم
Dialogue: 0,0:23:00.13,0:23:04.15,Ending,,0,0,0,,كأنه يتمنى، وكأنني أرجو
Dialogue: 0,0:23:04.14,0:23:07.74,Ending,,0,0,0,,أتذوقها واحدةً تلو الأخرى
Dialogue: 0,0:23:07.76,0:23:11.82,Ending,,0,0,0,,فوق أضواء الزينة
Dialogue: 0,0:23:11.84,0:23:15.72,Ending,,0,0,0,,ستقوم بتلوينه كما تشاء
Dialogue: 0,0:23:15.97,0:23:19.62,Ending,,0,0,0,,لا أحد يستطيع أن يفعل ذلك
Dialogue: 0,0:23:19.73,0:23:24.53,Ending,,0,0,0,,لا أستطيع مساعدته، لا أستطيع أن أتركه
Dialogue: 0,0:23:36.79,0:23:39.54,Default,,0,0,0,,!المعركة الحاسمة ضد أونيمارو جارية
Dialogue: 0,0:23:39.54,0:23:42.71,Default,,0,0,0,,!ماذا؟ هناك فخ
Dialogue: 0,0:23:42.71,0:23:44.96,Default,,0,0,0,,!ما هذا المكان؟
Dialogue: 0,0:23:45.72,0:23:48.18,Default,,0,0,0,,."في الحلقة القادمة، "ملوك الشيطان لأونيمارو
Dialogue: 0,0:23:48.18,0:23:50.02,Default,,0,0,0,,!سنكون في الانتظار
Dialogue: 0,0:23:48.18,0:23:50.89,Top,,0,0,0,,".في الحلقة القادمة، "ملوك الشيطان لأونيمارو
