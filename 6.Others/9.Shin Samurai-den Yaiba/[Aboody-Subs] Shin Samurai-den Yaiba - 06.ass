Dialogue: 0,0:00:04.44,0:00:08.45,Top,,0,0,0,,"محطة ناغويا"
Dialogue: 0,0:00:09.23,0:00:10.37,Default,,0,0,0,,!لذيذ
Dialogue: 0,0:00:10.37,0:00:13.12,Default,,0,0,0,,!إذن هذا هو ميسو كوشيكاتسو؟
Dialogue: 0,0:00:13.12,0:00:14.91,Default,,0,0,0,,،لذيذ جدًا
Dialogue: 0,0:00:14.91,0:00:17.87,Default,,0,0,0,,،يمكنني أكل عشرات منها
Dialogue: 0,0:00:18.28,0:00:21.09,Default,,0,0,0,,ماذا تفعلين؟ ألم ستأكلين؟
Dialogue: 0,0:00:21.09,0:00:26.31,Default,,0,0,0,,.حسنًا، بما أننا في ناغويا، فكرت في نشر صورة على حسابي في الانستا
Dialogue: 0,0:00:26.31,0:00:27.44,Default,,0,0,0,,ما هذا الشيء؟
Dialogue: 0,0:00:27.44,0:00:29.94,Default,,0,0,0,,.لا تأتي تبكي لي إذا خطفها صقر
Dialogue: 0,0:00:31.45,0:00:34.11,Default,,0,0,0,,.بجدية، أنتم غير مبالين جدًا
Dialogue: 0,0:00:35.28,0:00:37.58,Default,,0,0,0,,!...أنت
Dialogue: 0,0:00:37.58,0:00:41.65,Default,,0,0,0,,!ر-رجل الحلزون
Dialogue: 0,0:00:44.98,0:00:46.79,Default,,0,0,0,,!لا، أنت مخطئ
Dialogue: 0,0:00:47.24,0:00:50.74,Default,,0,0,0,,...أنا أحد الشياطين الثمانية الذين يخدمون الملك أونيمارو
Dialogue: 0,0:00:50.74,0:00:53.41,Default,,0,0,0,,...أنا رجل الحلزون
Dialogue: 0,0:00:53.96,0:00:56.62,Default,,0,0,0,,!واسمي هو دين
Dialogue: 0,0:00:58.57,0:01:01.17,Default,,0,0,0,,...لقد حصل على قوقعة إذن
Dialogue: 0,0:01:01.17,0:01:03.37,Default,,0,0,0,,أنت مرة أخرى؟
Dialogue: 0,0:01:03.37,0:01:05.00,Default,,0,0,0,,!أحضر لي الملح
Dialogue: 0,0:01:06.88,0:01:10.84,Default,,0,0,0,,نحن نعرف بالفعل نقطة ضعفك!
Dialogue: 0,0:01:10.84,0:01:12.29,Default,,0,0,0,,!خذ هذا
Dialogue: 0,0:01:20.74,0:01:25.32,Default,,0,0,0,,!هذا لن يؤثر علي بعد الآن لأن لدي قوقعة الآن
Dialogue: 0,0:01:25.67,0:01:28.64,Default,,0,0,0,,.صحيح، أنت محمي بقوقعتك
Dialogue: 0,0:01:28.64,0:01:32.28,Default,,0,0,0,,ولكن إذا كنت لا تستطيع الحركة بسببها، فما الفائدة؟
Dialogue: 0,0:01:36.37,0:01:38.40,Default,,0,0,0,,!سيف الزوبعة
Dialogue: 0,0:01:42.44,0:01:44.17,Default,,0,0,0,,...بجدية
Dialogue: 0,0:01:44.51,0:01:48.17,Default,,0,0,0,,هل هذا الكائن حقًا أحد أتباع أونيمارو؟
Dialogue: 0,0:01:50.42,0:01:55.14,Default,,0,0,0,,!في المرة القادمة التي ألتقي فيها بأونيمارو، سأهزمه بتقنيتي السرية الزوبعة
Dialogue: 0,0:01:57.35,0:01:59.85,Default,,0,0,0,,!ليس بهذه السرعة
Dialogue: 0,0:02:08.96,0:02:11.07,Default,,0,0,0,,!يايبا! استعد لوضعك
Dialogue: 0,0:02:13.06,0:02:16.79,Default,,0,0,0,,!هذا الشخص قد يكون قويًا بعض الشيء
Dialogue: 0,0:02:31.63,0:02:34.18,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:02:35.76,0:02:37.97,Opening,,0,0,0,,الإرادة للفوز هي شهادة على جديتي
Dialogue: 0,0:02:37.96,0:02:40.91,Opening,,0,0,0,,لكنك لن تصدق ذلك، أليس كذلك؟
Dialogue: 0,0:02:40.92,0:02:43.27,Opening,,0,0,0,,المنطق السليم يمكن أن يكون عبئًا
Dialogue: 0,0:02:43.26,0:02:46.04,Opening,,0,0,0,,أستطيع التحدي لأني جاهل
Dialogue: 0,0:02:46.05,0:02:47.19,Opening,,0,0,0,,هل أنا "ساموراي حقيقي"؟
Dialogue: 0,0:02:47.20,0:02:48.46,Opening,,0,0,0,,أم مجرد "لاعب وقح"؟
Dialogue: 0,0:02:48.46,0:02:51.12,Opening,,0,0,0,,علي أن أتحدى لأني أريد أن أعرف
Dialogue: 0,0:02:51.11,0:02:56.48,Opening,,0,0,0,,الشغف في قلبي كان ساطعًا مثل البرق
Dialogue: 0,0:02:56.94,0:03:01.66,Opening,,0,0,0,,بغض النظر عن مقدار تغيرك
Dialogue: 0,0:03:01.92,0:03:06.35,Opening,,0,0,0,,لا يوجد كذب في المعارك التي خضناها
Dialogue: 0,0:03:06.35,0:03:11.10,Opening,,0,0,0,,أنا أمضي قدمًا بالشجاعة لأعيش بسرعة وتهور
Dialogue: 0,0:03:11.09,0:03:17.04,Opening,,0,0,0,,لأصل إلى القوة الجديدة المثيرة
Dialogue: 0,0:03:18.42,0:03:23.20,Opening,,0,0,0,,لنرفع سيوفنا نحو الغد
Dialogue: 0,0:03:23.21,0:03:28.23,Opening,,0,0,0,,أيقظ القوة الطبية
Dialogue: 0,0:03:28.23,0:03:33.00,Opening,,0,0,0,,الآن تهب علينا الأقدار المحترقة
Dialogue: 0,0:03:33.00,0:03:37.92,Opening,,0,0,0,,سأقطع علامات اليأس
Dialogue: 0,0:03:37.92,0:03:39.74,Opening,,0,0,0,,بهذا "السيف" الحقيقي
Dialogue: 0,0:03:50.00,0:03:55.01,Default,,0,0,0,,الحلقة 6: ظهور رجل الخفاش فجأة
Dialogue: 0,0:03:57.00,0:03:58.64,Default,,0,0,0,,!من أنت؟
Dialogue: 0,0:04:00.05,0:04:01.85,Default,,0,0,0,,!مرحبًا
Dialogue: 0,0:04:01.85,0:04:06.02,Default,,0,0,0,,...أنا أحد الشياطين الثمانية الذين يخدمون الملك أونيمارو
Dialogue: 0,0:04:06.34,0:04:08.98,Default,,0,0,0,,!...رجل الخفاش
Dialogue: 0,0:04:09.74,0:04:13.11,Default,,0,0,0,,!انت! أعيد لي كوشيكاتسو الخاصة بي
Dialogue: 0,0:04:19.45,0:04:23.41,Default,,0,0,0,,!ناغويا مليئة بالطعام اللذيذ
Dialogue: 0,0:04:23.41,0:04:25.45,Default,,0,0,0,,!يا فتى الرعد
Dialogue: 0,0:04:25.45,0:04:30.93,Default,,0,0,0,,!سيف الرعد ينتمي فقط إلى ملك هذا العالم، وهو أونيمارو
Dialogue: 0,0:04:30.93,0:04:33.63,Default,,0,0,0,,!انه لا يستحقك
Dialogue: 0,0:04:33.63,0:04:34.71,Default,,0,0,0,,!ماذا قلت؟
Dialogue: 0,0:04:34.71,0:04:37.78,Default,,0,0,0,,،الآن، قبل أن تتأذى
Dialogue: 0,0:04:37.78,0:04:41.64,Default,,0,0,0,,.سلمني سيف الرعد
Dialogue: 0,0:04:41.64,0:04:44.85,Default,,0,0,0,,! إذا كنت تعتقد أنك تستطيع أخذه، فحاول
Dialogue: 0,0:04:44.85,0:04:48.18,Default,,0,0,0,,!سأهزمك بضربة واحدة بسيف الزوبعة
Dialogue: 0,0:04:48.62,0:04:50.47,Default,,0,0,0,,!حسنًا،  أيها الفتى
Dialogue: 0,0:04:50.47,0:04:56.15,Default,,0,0,0,,!كما تريد... سآخذه منك بالقوة
Dialogue: 0,0:04:57.16,0:04:58.65,Default,,0,0,0,,...استعد
Dialogue: 0,0:05:03.99,0:05:04.99,Default,,0,0,0,,!...الان
Dialogue: 0,0:05:16.83,0:05:18.67,Default,,0,0,0,,!ساذج جدًا
Dialogue: 0,0:05:21.38,0:05:23.32,Default,,0,0,0,,!انتبه
Dialogue: 0,0:05:32.10,0:05:35.72,Default,,0,0,0,,!يا أنت! ليس من العدل أن تستطيع الطيران
Dialogue: 0,0:05:35.72,0:05:37.23,Default,,0,0,0,,!اصمت
Dialogue: 0,0:05:37.58,0:05:42.46,Default,,0,0,0,,!البشر الذين لا يستطيعون حتى الطيران هم حقًا مثيرون للشفقة
Dialogue: 0,0:05:44.88,0:05:46.83,Default,,0,0,0,,...يا وغد
Dialogue: 0,0:05:47.26,0:05:49.10,Default,,0,0,0,,!لنذهب، شونوسوكي
Dialogue: 0,0:05:54.21,0:05:57.67,Default,,0,0,0,,...يايبا
Dialogue: 0,0:05:57.67,0:05:59.82,Default,,0,0,0,,!...جناح
Dialogue: 0,0:06:00.42,0:06:03.83,Default,,0,0,0,,!أحسنت! فتى الرعد
Dialogue: 0,0:06:03.83,0:06:08.81,Default,,0,0,0,,!ولكن حتى إذا استطعت الطيران، فلا يزال لا يمكنك هزيمتي
Dialogue: 0,0:06:08.81,0:06:10.66,Default,,0,0,0,,!اصمت
Dialogue: 0,0:06:12.50,0:06:14.68,Default,,0,0,0,,.إنه سريع
Dialogue: 0,0:06:14.68,0:06:18.40,Default,,0,0,0,,.هجمات يايبا يتم صدها بسهولة
Dialogue: 0,0:06:18.72,0:06:21.85,Default,,0,0,0,,.ومع ذلك، إذا استطاع يايبا اختراق ذلك الدفاع تمامًا
Dialogue: 0,0:06:21.85,0:06:23.28,Default,,0,0,0,,.قد تكون لديه فرصة
Dialogue: 0,0:06:36.00,0:06:39.52,Default,,0,0,0,,!حسنًا، حان وقت سيف الزوبعة
Dialogue: 0,0:06:42.38,0:06:44.11,Default,,0,0,0,,!يايبا
Dialogue: 0,0:06:45.07,0:06:50.14,Default,,0,0,0,,!سيف الزوبعة
Dialogue: 0,0:06:53.27,0:06:56.77,Default,,0,0,0,,!تبا! لا يمكنني استخدام الزوبعة في هذا الشكل
Dialogue: 0,0:07:00.44,0:07:05.28,Default,,0,0,0,,!الضرب دون تفكير هو هراء
Dialogue: 0,0:07:11.33,0:07:14.29,Default,,0,0,0,,!والآن حالت نهايتك
Dialogue: 0,0:07:18.08,0:07:20.38,Default,,0,0,0,,!استعد
Dialogue: 0,0:07:25.16,0:07:27.70,Default,,0,0,0,,...تلك المهارة السيفية الرائعة
Dialogue: 0,0:07:27.70,0:07:30.81,Default,,0,0,0,,من أنت حقًا؟
Dialogue: 0,0:07:32.73,0:07:34.30,Default,,0,0,0,,...أنا
Dialogue: 0,0:07:34.64,0:07:36.48,Default,,0,0,0,,!الأعظم عبر العصور
Dialogue: 0,0:07:36.48,0:07:38.69,Default,,0,0,0,,!الأفضل في العالم
Dialogue: 0,0:07:38.69,0:07:41.90,Default,,0,0,0,,...المفاتل الذي يصمت حتى الأطفال الباكين
Dialogue: 0,0:07:41.90,0:07:45.24,Default,,0,0,0,,...أنا مياموتو موساشي
Dialogue: 0,0:07:45.24,0:07:48.70,Default,,0,0,0,,!...هذا أنا
Dialogue: 0,0:07:50.03,0:07:53.41,Default,,0,0,0,,! مياموتو موساشي
Dialogue: 0,0:07:53.41,0:07:58.84,Default,,0,0,0,,!لقد أخجلتني بهذا
Dialogue: 0,0:07:58.84,0:08:03.53,Default,,0,0,0,,!أنا محظوظ جدًا لأنني ألتقي بأعظم سيف في اليابان
Dialogue: 0,0:08:03.53,0:08:05.97,Default,,0,0,0,,.مهلا، أنت تجعلني أخجل
Dialogue: 0,0:08:05.97,0:08:10.47,Default,,0,0,0,,.الآن، أريدك أن تنضم إلى حليفي
Dialogue: 0,0:08:14.78,0:08:16.10,Default,,0,0,0,,!السيد موساشي
Dialogue: 0,0:08:20.78,0:08:22.23,Default,,0,0,0,,!السيد موساشي
Dialogue: 0,0:08:22.23,0:08:23.77,Default,,0,0,0,,!هل أنت بخير؟
Dialogue: 0,0:08:36.82,0:08:39.28,Default,,0,0,0,,!ا-ابتعد عنه!
Dialogue: 0,0:08:46.13,0:08:48.36,Default,,0,0,0,,...الآن، ايتها الفتاة الجميلة
Dialogue: 0,0:08:48.90,0:08:52.03,Default,,0,0,0,,.سلمي لي فتى الرعد
Dialogue: 0,0:08:53.51,0:08:54.81,Default,,0,0,0,,....يا رفاق
Dialogue: 0,0:08:58.95,0:08:59.81,Default,,0,0,0,,!كاجيتورا
Dialogue: 0,0:09:00.43,0:09:03.69,Default,,0,0,0,,!حان وقت العرض
Dialogue: 0,0:09:09.36,0:09:12.84,Default,,0,0,0,,!أنت... أيها العجوز المنحرف
Dialogue: 0,0:09:14.00,0:09:14.99,Default,,0,0,0,,!شونوسوكي
Dialogue: 0,0:09:24.50,0:09:25.71,Default,,0,0,0,,...كاجيتورا
Dialogue: 0,0:09:25.71,0:09:27.55,Default,,0,0,0,,....أرجو أن تكون بأمان
Dialogue: 0,0:09:30.55,0:09:32.68,Default,,0,0,0,,!لن أدعك تهرب
Dialogue: 0,0:09:53.50,0:09:55.08,Default,,0,0,0,,!شونوسوكي
Dialogue: 0,0:09:57.87,0:09:59.16,Default,,0,0,0,,...تبا
Dialogue: 0,0:10:01.30,0:10:02.60,Default,,0,0,0,,!سايكا
Dialogue: 0,0:10:05.33,0:10:07.80,Default,,0,0,0,,!يجب ألا تبتعدي عني، مهما كانت الظروف
Dialogue: 0,0:10:07.80,0:10:09.32,Default,,0,0,0,,!ح-حسنًا
Dialogue: 0,0:10:20.93,0:10:24.68,Default,,0,0,0,,.لقد هربت جيدًا، فتى الرعد
Dialogue: 0,0:10:24.68,0:10:26.12,Default,,0,0,0,,...ولكن
Dialogue: 0,0:10:30.83,0:10:38.44,Default,,0,0,0,,!سيف الرعد سيكون بالتأكيد ملكي، أنا رجل الخفاش
Dialogue: 0,0:10:42.46,0:10:44.71,Default,,0,0,0,,...أتساءل إذا كان الجميع بخير
Dialogue: 0,0:10:46.95,0:10:48.13,Default,,0,0,0,,يايبا؟
Dialogue: 0,0:10:48.88,0:10:49.88,Default,,0,0,0,,...يا سايكا
Dialogue: 0,0:10:50.76,0:10:52.28,Default,,0,0,0,,.أعطيني تلك الكرة
Dialogue: 0,0:10:53.58,0:10:56.87,Default,,0,0,0,,!بذلك، قد أستطيع هزيمة ذلك الوغد الخفاش
Dialogue: 0,0:10:56.87,0:10:57.93,Default,,0,0,0,,!لا، لا يمكنني
Dialogue: 0,0:10:59.57,0:11:00.80,Default,,0,0,0,,...لأن
Dialogue: 0,0:11:01.70,0:11:04.27,Default,,0,0,0,,!قد تتحول إلى شيطان مرة أخرى
Dialogue: 0,0:11:04.27,0:11:05.92,Default,,0,0,0,,!سأكون بخير
Dialogue: 0,0:11:05.92,0:11:07.88,Default,,0,0,0,,!لقد تدربت
Dialogue: 0,0:11:07.88,0:11:09.52,Default,,0,0,0,,.أنا لست كما كنت من قبل
Dialogue: 0,0:11:10.38,0:11:15.49,Default,,0,0,0,,ولكن إذا حدث ذلك مرة أخرى، من سيمنعك؟
Dialogue: 0,0:11:24.14,0:11:26.33,Default,,0,0,0,,!إذن كيف سأهزمه؟
Dialogue: 0,0:11:26.33,0:11:29.67,Default,,0,0,0,,!لا يمكنني حتى ضرب عدو طائر بسيف الزوبعة
Dialogue: 0,0:11:30.11,0:11:31.91,Default,,0,0,0,,...هذا
Dialogue: 0,0:11:31.91,0:11:35.48,Default,,0,0,0,,!يجب أن أهزمه من أجلهم أيضًا
Dialogue: 0,0:11:35.48,0:11:36.68,Default,,0,0,0,,!...ولكن لا يزال
Dialogue: 0,0:11:37.76,0:11:40.85,Default,,0,0,0,,.كنت أبحث عنك، فتى الرعد
Dialogue: 0,0:11:40.85,0:11:42.59,Default,,0,0,0,,!رجل الخفاش
Dialogue: 0,0:11:42.59,0:11:43.43,Default,,0,0,0,,!ابتعد
Dialogue: 0,0:11:43.43,0:11:46.44,Default,,0,0,0,,.هذه المرة لن تهرب
Dialogue: 0,0:11:46.44,0:11:51.86,Default,,0,0,0,,.ذلك النمر على الأرجح يتم القبض عليه من قبل مياموتو موساشي والآخرين بينما نتحدث
Dialogue: 0,0:11:52.30,0:11:56.40,Default,,0,0,0,,!الآن، سلمني سيف الرعد
Dialogue: 0,0:11:56.40,0:11:59.07,Default,,0,0,0,,8-4-5، 3-2-7!
Dialogue: 0,0:11:59.65,0:12:01.03,Default,,0,0,0,,!استعد
Dialogue: 0,0:12:01.39,0:12:02.83,Default,,0,0,0,,!هت، هت، هت
Dialogue: 0,0:12:03.33,0:12:04.24,Default,,0,0,0,,!الان،
Dialogue: 0,0:12:15.55,0:12:18.76,Default,,0,0,0,,!تبا! سأنهيك بسيف الزوبعة
Dialogue: 0,0:12:18.76,0:12:21.03,Default,,0,0,0,,!ليس بهذه السرعة
Dialogue: 0,0:12:22.64,0:12:24.26,Default,,0,0,0,,!يايبا
Dialogue: 0,0:12:24.26,0:12:26.39,Default,,0,0,0,,...أوتش
Dialogue: 0,0:12:34.39,0:12:38.90,Default,,0,0,0,,!مع الفتاة الجميلة هنا، لا يمكنك حتى الهروب
Dialogue: 0,0:12:39.31,0:12:42.26,Default,,0,0,0,,.هذه هي النهاية
Dialogue: 0,0:12:45.88,0:12:47.12,Default,,0,0,0,,!كاجيتورا
Dialogue: 0,0:12:48.40,0:12:50.28,Default,,0,0,0,,!إذن أنت بأمان
Dialogue: 0,0:12:51.38,0:12:55.96,Default,,0,0,0,,يبدو أن مياموتو موساشي والآخرين قد فشلوا، إذن؟
Dialogue: 0,0:12:59.14,0:13:01.68,Default,,0,0,0,,.صراع عديم الفائدة
Dialogue: 0,0:13:06.48,0:13:09.00,Default,,0,0,0,,م-ماذا يجب أن نفعل الآن، يايبا؟
Dialogue: 0,0:13:11.30,0:13:14.23,Default,,0,0,0,,!كاجيتورا، هناك! لنذهب هناك
Dialogue: 0,0:13:35.74,0:13:38.21,Default,,0,0,0,,...إنها مسألة وقت فقط قبل أن يجدنا
Dialogue: 0,0:13:38.72,0:13:40.27,Default,,0,0,0,,...ياسايكا
Dialogue: 0,0:13:41.59,0:13:43.24,Default,,0,0,0,,هذا رائع، أليس كذلك؟
Dialogue: 0,0:13:43.24,0:13:45.39,Default,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:13:47.69,0:13:48.38,Default,,0,0,0,,.إنه قادم
Dialogue: 0,0:13:49.96,0:13:51.56,Default,,0,0,0,,م-ماذا الآن؟
Dialogue: 0,0:14:19.80,0:14:22.98,Default,,0,0,0,,...انتهت لعبة الغميضة
Dialogue: 0,0:14:22.98,0:14:25.05,Default,,0,0,0,,!...فتى الرعد
Dialogue: 0,0:14:26.70,0:14:29.47,Default,,0,0,0,,! وجدتك، ايتها الفتاة جميلة
Dialogue: 0,0:14:30.05,0:14:31.52,Default,,0,0,0,,!أنا هنا
Dialogue: 0,0:14:33.48,0:14:35.77,Default,,0,0,0,,!أستطيع رؤيتك هناك
Dialogue: 0,0:14:43.36,0:14:44.32,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:14:45.03,0:14:46.78,Default,,0,0,0,,!لقد خفضت حذرك
Dialogue: 0,0:14:50.04,0:14:51.31,Default,,0,0,0,,!لقد فعلتها
Dialogue: 0,0:14:58.40,0:15:00.82,Default,,0,0,0,,...كيف تجرؤ
Dialogue: 0,0:15:01.08,0:15:02.92,Default,,0,0,0,,!تبا، لقد صدها
Dialogue: 0,0:15:02.92,0:15:05.27,Default,,0,0,0,,!علي استخدام سيف الزوبعة بعد كل شيء
Dialogue: 0,0:15:06.50,0:15:10.44,Default,,0,0,0,,...كيف تجرؤ على كسر نظارتي الشمسية الثمينة.
Dialogue: 0,0:15:12.52,0:15:19.27,Default,,0,0,0,,.يبدو أنك أغضبتني، يا فتى الرعد
Dialogue: 0,0:15:37.47,0:15:38.89,Default,,0,0,0,,!يايبا
Dialogue: 0,0:15:47.86,0:15:50.43,Default,,0,0,0,,.أنت عنيد جدًا
Dialogue: 0,0:15:50.97,0:15:53.11,Default,,0,0,0,,!اصمت! أنت أيضًا
Dialogue: 0,0:15:55.28,0:15:57.44,Default,,0,0,0,,!لقد اختفى! سيف الرعد
Dialogue: 0,0:15:59.97,0:16:02.46,Default,,0,0,0,,.يبدو أن هذه هي نهايتك
Dialogue: 0,0:16:02.46,0:16:09.87,Default,,0,0,0,,.بعد أن أهزمك، سآخذ وقتي ببطء لأخذ سيف الرعد
Dialogue: 0,0:16:12.57,0:16:14.09,Default,,0,0,0,,!سيف الرعد
Dialogue: 0,0:16:19.49,0:16:20.74,Default,,0,0,0,,!إنه ثقيل جدًا
Dialogue: 0,0:16:20.74,0:16:24.52,Default,,0,0,0,,!يايبا، هل كنت حقًا تحمل سيفًا ثقيلًا كهذا كل يوم؟
Dialogue: 0,0:16:24.93,0:16:26.92,Default,,0,0,0,,!كاجيتورا، أعتمد عليك
Dialogue: 0,0:16:29.87,0:16:31.22,Default,,0,0,0,,!انتظرني، يايبا
Dialogue: 0,0:16:52.07,0:16:53.95,Default,,0,0,0,,!لا تأتي إلى هنا
Dialogue: 0,0:17:00.46,0:17:03.34,Default,,0,0,0,,!استسلم بالفعل
Dialogue: 0,0:17:29.98,0:17:34.28,Default,,0,0,0,,أنت حقًا لا تعرف متى تستسلم، أليس كذلك، فتى الرعد؟
Dialogue: 0,0:17:37.93,0:17:38.81,Default,,0,0,0,,!يايبا
Dialogue: 0,0:17:44.79,0:17:47.11,Default,,0,0,0,,!استخدم سبف الزوبعة
Dialogue: 0,0:17:49.46,0:17:50.59,Default,,0,0,0,,!نعم
Dialogue: 0,0:17:51.84,0:17:54.18,Default,,0,0,0,,...سيف الزو
Dialogue: 0,0:17:58.04,0:18:00.25,Default,,0,0,0,,!م-ما هذا؟
Dialogue: 0,0:18:02.25,0:18:04.56,Default,,0,0,0,,!لا يمكنك سحب تلك الكرة
Dialogue: 0,0:18:04.56,0:18:09.75,Default,,0,0,0,,.تقنية السيف الزوبعة تعمل عن طريق إدخال إصبعك في الثقب
Dialogue: 0,0:18:09.75,0:18:12.53,Default,,0,0,0,,!إذا سددت الثقب، فستنتهي بالنسبة لك
Dialogue: 0,0:18:13.58,0:18:18.70,Default,,0,0,0,,!حتى إذا لم أستطع استخدام الزوبعة، سأهزمك بقوة
Dialogue: 0,0:18:18.97,0:18:20.12,Default,,0,0,0,,.لا، لا
Dialogue: 0,0:18:20.12,0:18:23.54,Default,,0,0,0,,!ليس جيدًا أن تكون واثقًا أكثر من اللازم
Dialogue: 0,0:18:52.22,0:18:53.32,Default,,0,0,0,,!يايبا
Dialogue: 0,0:18:56.45,0:18:57.74,Default,,0,0,0,,...تبا
Dialogue: 0,0:18:59.30,0:19:03.21,Default,,0,0,0,,.انتهت اللعبة، فتى الرعد
Dialogue: 0,0:19:03.69,0:19:04.87,Default,,0,0,0,,...سأُقتل
Dialogue: 0,0:19:05.50,0:19:07.13,Default,,0,0,0,,.تصبح على خير
Dialogue: 0,0:19:08.96,0:19:11.59,Default,,0,0,0,,!توقف عن هذا
Dialogue: 0,0:19:14.35,0:19:16.05,Default,,0,0,0,,!تبا
Dialogue: 0,0:19:27.93,0:19:29.27,Default,,0,0,0,,!فهمت
Dialogue: 0,0:19:46.01,0:19:47.08,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:19:53.07,0:19:55.42,Default,,0,0,0,,...لا ايعقل
Dialogue: 0,0:20:04.21,0:20:06.02,Default,,0,0,0,,!الكرة تختفي بسبب شروق الشمس
Dialogue: 0,0:20:06.73,0:20:07.94,Default,,0,0,0,,...تبًا
Dialogue: 0,0:20:09.65,0:20:13.40,Default,,0,0,0,,!هذه فرصتي
Dialogue: 0,0:20:13.90,0:20:19.24,Default,,0,0,0,,!سيف الزوبعة
Dialogue: 0,0:20:25.13,0:20:28.31,Default,,0,0,0,,...تبا
Dialogue: 0,0:20:39.34,0:20:41.60,Default,,0,0,0,,!لقد فعلتها، يايبا
Dialogue: 0,0:20:42.05,0:20:44.30,Default,,0,0,0,,!أنا سعيدة أنك انتصرت
Dialogue: 0,0:20:46.83,0:20:47.94,Default,,0,0,0,,.توقفي عن هذا
Dialogue: 0,0:20:48.26,0:20:50.90,Default,,0,0,0,,.ليس لدي وقت للنساء الآن
Dialogue: 0,0:20:53.12,0:20:54.39,Default,,0,0,0,,.غريب
Dialogue: 0,0:21:05.14,0:21:07.10,Default,,0,0,0,,...حقًا
Dialogue: 0,0:21:07.41,0:21:10.64,Default,,0,0,0,,.لقد مررنا بوقت صعب هذه المرة
Dialogue: 0,0:21:11.24,0:21:14.38,Default,,0,0,0,,يا يايبا، ألست ستأكل؟
Dialogue: 0,0:21:15.59,0:21:18.92,Default,,0,0,0,,.أعتقد أنه أدرك الآن كم هو قليل الخبرة
Dialogue: 0,0:21:19.59,0:21:22.59,Default,,0,0,0,,!هذا سيء، انظروا إلى هذا
Dialogue: 0,0:21:23.27,0:21:25.81,Default,,0,0,0,,ما هذا، مانجو الشيطان؟
Dialogue: 0,0:21:26.10,0:21:30.33,Default,,0,0,0,,!إنه ليس مانجو عاديًا! إنه مانجو الملك أونيمارو
Dialogue: 0,0:21:30.33,0:21:31.65,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:21:32.07,0:21:35.02,Default,,0,0,0,,!كانت تُباع في ذلك المتجر هناك
Dialogue: 0,0:21:35.65,0:21:37.48,Default,,0,0,0,,!انظروا
Dialogue: 0,0:21:37.91,0:21:38.61,Default,,0,0,0,,،حاليًا
Dialogue: 0,0:21:38.61,0:21:41.45,Default,,0,0,0,,،أونيمارو استولى على مبنى الكابيتول
Dialogue: 0,0:21:41.45,0:21:43.34,Default,,0,0,0,,.والمؤيدون يظهرون في جميع أنحاء البلاد
Dialogue: 0,0:21:43.34,0:21:45.60,Default,,0,0,0,,المنتجات التعاونية
Dialogue: 0,0:21:45.60,0:21:47.58,Default,,0,0,0,,.والأطعمة المحلية تنتشر بسرعة
Dialogue: 0,0:21:47.94,0:21:49.69,Default,,0,0,0,,...ذلك أونيمارو
Dialogue: 0,0:21:49.98,0:21:52.49,Default,,0,0,0,,،قبل أن تصبح الامور اسوء
Dialogue: 0,0:21:52.49,0:21:54.75,Default,,0,0,0,,!يجب أن نسرع إلى جزيرة جانريو
Dialogue: 0,0:21:57.00,0:21:58.51,Default,,0,0,0,,...أحتاج أن أصبح أقوى
Dialogue: 0,0:21:59.45,0:22:01.51,Default,,0,0,0,,!أحتاج أن أصبح أقوى بكثير
Dialogue: 0,0:22:20.09,0:22:27.65,Ending,,0,0,0,,"ضُربتُ ببرقٍ حلوٍ لاذع، وانشغلت تماماً، يا "أومي
Dialogue: 0,0:22:27.84,0:22:35.63,Ending,,0,0,0,,تذوقت طعامك وانفجرتُ في الطريق
Dialogue: 0,0:22:36.25,0:22:40.13,Ending,,0,0,0,,يتدفق من أعماق قلبي شعور غامض، لم أعرفه من قبل
Dialogue: 0,0:22:40.20,0:22:44.17,Ending,,0,0,0,,كعكة اللحظة المنتظرة في كل احتفال مميز
Dialogue: 0,0:22:44.20,0:22:47.91,Ending,,0,0,0,,"نظرنا إلى بعضنا البعض وقلنا "إنه لذيذ
Dialogue: 0,0:22:47.99,0:22:51.18,Ending,,0,0,0,,"إنه لذيذ"، قلنا، ونحن ننظر إلى بعضنا البعض
Dialogue: 0,0:22:51.27,0:22:54.86,Ending,,0,0,0,,تلك الأيام التي تخطفك من الواقع بجمالها
Dialogue: 0,0:22:54.88,0:22:59.22,Ending,,0,0,0,,...أتمنى أن تدوم
Dialogue: 0,0:22:59.23,0:23:03.25,Ending,,0,0,0,,كأنه يتمنى، وكأنني أرجو
Dialogue: 0,0:23:03.24,0:23:06.84,Ending,,0,0,0,,أتذوقها واحدةً تلو الأخرى
Dialogue: 0,0:23:06.86,0:23:10.92,Ending,,0,0,0,,فوق أضواء الزينة
Dialogue: 0,0:23:10.94,0:23:14.82,Ending,,0,0,0,,ستقوم بتلوينه كما تشاء
Dialogue: 0,0:23:15.07,0:23:18.72,Ending,,0,0,0,,لا أحد يستطيع أن يفعل ذلك
Dialogue: 0,0:23:18.83,0:23:23.63,Ending,,0,0,0,,لا أستطيع مساعدته، لا أستطيع أن أتركه
Dialogue: 0,0:23:36.69,0:23:38.73,Default,,0,0,0,,.وصلنا أخيرًا إلى جزيرة جانريو
Dialogue: 0,0:23:38.73,0:23:41.11,Default,,0,0,0,,!وبينما كنت أشعر بالراحة... مستحيل
Dialogue: 0,0:23:41.11,0:23:43.28,Default,,0,0,0,,!هذا لا يمكن أن يحدث
Dialogue: 0,0:23:43.28,0:23:45.11,Default,,0,0,0,,!يايبا
Dialogue: 0,0:23:45.37,0:23:47.07,Default,,0,0,0,,في المرة القادمة، "بعث كوجيرو."
Dialogue: 0,0:23:47.07,0:23:50.70,Default,,0,0,0,,!الحلقة 7: بعث كوجيرو\Nهذا سيء
Dialogue: 0,0:23:47.07,0:23:49.50,Top,,0,0,0,,! هذا سيء

