Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs40\pos(200,200)} ABOODY SUBS | ترجمة \NTelegram : ABOODY-SUBS\NX : @ABOODY_SUBS
Dialogue: 0,0:00:05.08,0:00:07.38,Default,,0,0,0,,.وصلنا إلى منطقة الهدف
Dialogue: 0,0:00:08.09,0:00:09.92,Default,,0,0,0,,!سنبدأ الهجوم الآن
Dialogue: 0,0:00:16.76,0:00:17.51,Default,,0,0,0,,!أطلقوا الآن
Dialogue: 0,0:00:24.69,0:00:25.31,Default,,0,0,0,,!أحسنتم
Dialogue: 0,0:00:34.99,0:00:36.74,Default,,0,0,0,,هل تعتقدون حقًا
Dialogue: 0,0:00:37.57,0:00:40.66,Default,,0,0,0,,أن هجومكم الصغير سيقضي على قلعتي؟
Dialogue: 0,0:00:42.58,0:00:46.21,Default,,0,0,0,,!أيها الملك أونيمارو، كل شيء جاهز
Dialogue: 0,0:00:46.79,0:00:48.13,Default,,0,0,0,,!اقضوا عليهم
Dialogue: 0,0:00:59.93,0:01:01.43,Default,,0,0,0,,!أونيمارو مرعب
Dialogue: 0,0:01:02.47,0:01:05.81,Default,,0,0,0,,!لقد هزم قوات القوات الجوية في لحظة
Dialogue: 0,0:01:09.11,0:01:11.61,Default,,0,0,0,,.جيشه يزداد قوة يومًا بعد يوم
Dialogue: 0,0:01:13.49,0:01:16.95,Default,,0,0,0,,.نفوذه الشيطاني ينتشر في كل أنحاء البلاد
Dialogue: 0,0:01:17.91,0:01:21.28,Default,,0,0,0,,!مواطنونا يعيشون في خوف، ليالي بلا نوم
Dialogue: 0,0:01:22.70,0:01:27.08,Default,,0,0,0,,أليس هناك أحد قادر على إيقاف أونيمارو؟
Dialogue: 0,0:01:31.63,0:01:34.59,Default,,0,0,0,,ألا يمكنك أن تسرع أكثر؟
Dialogue: 0,0:01:35.13,0:01:36.34,Default,,0,0,0,,!اصمتِ فحسب
Dialogue: 0,0:01:36.51,0:01:39.72,Default,,0,0,0,,!ساقاي لا تستطيع التجديف أسرع من هذا
Dialogue: 0,0:01:40.43,0:01:43.31,Default,,0,0,0,,.ظهرك القوي يستطيع حمل الكثير
Dialogue: 0,0:01:45.27,0:01:48.27,Default,,0,0,0,,!هذا بطيء... بطيء جدًا
Dialogue: 0,0:01:48.65,0:01:50.23,Default,,0,0,0,,!هذا بطيء
Dialogue: 0,0:01:51.11,0:01:54.19,Default,,0,0,0,,!حتى الطوافات العادية ليست بهذا البطء
Dialogue: 0,0:01:54.57,0:01:58.74,Default,,0,0,0,,.أنت دائمًا غير صبور. لهذا خسرت أمامي
Dialogue: 0,0:01:59.61,0:02:02.20,Default,,0,0,0,,ماذا قلت يا موساشي؟
Dialogue: 0,0:02:02.37,0:02:04.24,Default,,0,0,0,,!اهدأوا
Dialogue: 0,0:02:05.41,0:02:07.83,Default,,0,0,0,,!أيها الوغد! لم أعد أتحملك
Dialogue: 0,0:02:08.25,0:02:09.71,Default,,0,0,0,,!تعال وقاتل
Dialogue: 0,0:02:12.71,0:02:13.55,Default,,0,0,0,,!اميري يايبا
Dialogue: 0,0:02:16.34,0:02:17.92,Default,,0,0,0,,!نحن نسير بسرعة
Dialogue: 0,0:02:18.63,0:02:21.05,Default,,0,0,0,,!سنصل إلى كيوشو قريبًا
Dialogue: 0,0:02:34.32,0:02:36.82,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:03:53.06,0:03:57.90,Default,,0,0,0,,الحلقة 15: مواجهة بين يايبا والساحر
Dialogue: 0,0:03:59.69,0:04:02.15,Default,,0,0,0,,!نعم! لقد وصلنا بسرعة
Dialogue: 0,0:04:02.74,0:04:03.86,Default,,0,0,0,,...سنصل قريبًا
Dialogue: 0,0:04:05.20,0:04:06.49,Default,,0,0,0,,!لا! يايبا، توقف
Dialogue: 0,0:04:15.75,0:04:18.59,Default,,0,0,0,,!ليخرج أحدكم هذا السيف من مؤخرتي
Dialogue: 0,0:04:21.67,0:04:24.18,Default,,0,0,0,,!أحسنت، حقًا
Dialogue: 0,0:04:24.59,0:04:27.14,Default,,0,0,0,,لقد وضعته هناك، أتذكر؟
Dialogue: 0,0:04:27.30,0:04:28.81,Default,,0,0,0,,!أنت من فعل هذا
Dialogue: 0,0:04:29.31,0:04:32.27,Default,,0,0,0,,هل أنتم جميعًا بخير؟
Dialogue: 0,0:04:34.27,0:04:35.23,Default,,0,0,0,,...أنت
Dialogue: 0,0:04:35.48,0:04:36.94,Default,,0,0,0,,!رجل نجم البحر
Dialogue: 0,0:04:38.02,0:04:41.11,Default,,0,0,0,,يايبا، هل هذا أنت؟ ماذا تفعل هنا؟
Dialogue: 0,0:04:41.69,0:04:43.95,Default,,0,0,0,,عزيزي، هل تعرفهم؟
Dialogue: 0,0:04:45.20,0:04:47.32,Default,,0,0,0,,هناك رجلان نجم البحر؟
Dialogue: 0,0:04:48.49,0:04:51.54,Default,,0,0,0,,!أيها الحمقى! أنا امرأة، امرأة حقيقية
Dialogue: 0,0:04:52.50,0:04:53.29,Default,,0,0,0,,امرأة؟
Dialogue: 0,0:04:53.54,0:04:57.25,Default,,0,0,0,,!مهلا، لا تضربيهم! أنا مدين لهم بحياتي
Dialogue: 0,0:04:57.42,0:04:58.75,Default,,0,0,0,,...ولكن، عزيزي
Dialogue: 0,0:05:02.01,0:05:05.43,Default,,0,0,0,,.من فضلكم اعذروها. هذه ميبورين، زوجتي
Dialogue: 0,0:05:05.97,0:05:06.68,Default,,0,0,0,,،وهذا
Dialogue: 0,0:05:06.97,0:05:09.01,Default,,0,0,0,,.ابني، كويتشي
Dialogue: 0,0:05:13.39,0:05:15.27,Default,,0,0,0,,ابنك؟
Dialogue: 0,0:05:21.82,0:05:24.99,Default,,0,0,0,,...يايبا وأصدقاءه وصلوا إلى كيوشو
Dialogue: 0,0:05:25.15,0:05:28.24,Default,,0,0,0,,يجب أن نتحرك بسرعة. هل لديك أخبار؟
Dialogue: 0,0:05:30.12,0:05:31.37,Default,,0,0,0,,...ولكن
Dialogue: 0,0:05:31.54,0:05:34.37,Default,,0,0,0,,أحد المحاربين الأسطوريين لدى الملك اونيمارو الذين عادوا إلى الحياة
Dialogue: 0,0:05:34.54,0:05:38.46,Default,,0,0,0,,...يجب أن يكون في جسد أحد الحيوانات هنا
Dialogue: 0,0:05:39.17,0:05:40.34,Default,,0,0,0,,هل هو هذا الأرنب؟
Dialogue: 0,0:05:41.46,0:05:42.88,Default,,0,0,0,,...لا
Dialogue: 0,0:05:44.09,0:05:45.38,Default,,0,0,0,,هل هو الثعلب الصغير؟
Dialogue: 0,0:05:46.47,0:05:47.43,Default,,0,0,0,,.لا يزال ليس هو
Dialogue: 0,0:05:53.52,0:05:55.89,Default,,0,0,0,,!أين أنت؟ أيها الحيوان
Dialogue: 0,0:05:56.35,0:05:57.39,Default,,0,0,0,,،بصراحة
Dialogue: 0,0:05:57.56,0:06:02.07,Default,,0,0,0,,!كان يمكن لملك أونيمارو أن يخبرني بأي حيوان يجب أن أبحث
Dialogue: 0,0:06:02.32,0:06:04.36,Default,,0,0,0,,...إنه غير مراعٍ، وبخيل أيضًا
Dialogue: 0,0:06:04.53,0:06:07.49,Default,,0,0,0,,.يبدو وكأنه وغد حقًا
Dialogue: 0,0:06:11.70,0:06:14.33,Default,,0,0,0,,.أنت، أيها الملك أونيمارو!، ماذا تفعل هنا
Dialogue: 0,0:06:17.16,0:06:18.79,Default,,0,0,0,,لديك ذيل؟
Dialogue: 0,0:06:21.59,0:06:22.38,Default,,0,0,0,,!أنت
Dialogue: 0,0:06:22.84,0:06:23.75,Default,,0,0,0,,من تكون؟
Dialogue: 0,0:06:26.67,0:06:29.22,Default,,0,0,0,,،بفضل قوة أونيمارو، ملك الشياطين
Dialogue: 0,0:06:29.43,0:06:32.72,Default,,0,0,0,,.أنا المحارب العظيم الذي عاد من بين الأموات
Dialogue: 0,0:06:37.43,0:06:40.19,Default,,0,0,0,,!أنا أمكوسا شيرو توكيسادا
Dialogue: 0,0:06:40.65,0:06:41.98,Default,,0,0,0,,!ذيلك ظاهر
Dialogue: 0,0:06:43.94,0:06:46.32,Default,,0,0,0,,ماذا نفعل، شيرو؟
Dialogue: 0,0:06:46.65,0:06:49.57,Default,,0,0,0,,لا أعرف أين يمكن أن أجد
Dialogue: 0,0:06:49.74,0:06:51.45,Default,,0,0,0,,.الكرة الأسطورية لهذه الجزيرة
Dialogue: 0,0:06:52.87,0:06:53.91,Default,,0,0,0,,!لا تقلق
Dialogue: 0,0:06:54.45,0:06:58.21,Default,,0,0,0,,!سأجدها سريعًا، باستخدام السحر
Dialogue: 0,0:07:02.21,0:07:03.13,Default,,0,0,0,,!عجباً
Dialogue: 0,0:07:03.29,0:07:06.05,Default,,0,0,0,,!لم نلتقِ منذ النزل
Dialogue: 0,0:07:06.51,0:07:08.72,Default,,0,0,0,,.اعذرونا على سوء الاستقبال
Dialogue: 0,0:07:08.92,0:07:11.76,Default,,0,0,0,,.هذا صحيح لقد أخبرتنا عن زوجتك
Dialogue: 0,0:07:12.22,0:07:14.89,Default,,0,0,0,,.بفضلكم، ابني يكبر بسرعة
Dialogue: 0,0:07:15.47,0:07:18.77,Default,,0,0,0,,.حياتنا عادية، ولكنها مليئة بالفرح
Dialogue: 0,0:07:20.31,0:07:21.94,Default,,0,0,0,,!إنه لطيف جدًا
Dialogue: 0,0:07:22.48,0:07:24.82,Default,,0,0,0,,لماذا أنتم في كيوشو؟
Dialogue: 0,0:07:25.15,0:07:28.69,Default,,0,0,0,,.نحن نبحث عن كرة روح التنين الموجودة في هذه الجزيرة
Dialogue: 0,0:07:29.40,0:07:30.99,Default,,0,0,0,,...كرة روح التنين
Dialogue: 0,0:07:31.78,0:07:33.66,Default,,0,0,0,,.لقد سمعت عنها
Dialogue: 0,0:07:34.07,0:07:36.95,Default,,0,0,0,,يُقال أن في أعماق جبل آسو
Dialogue: 0,0:07:37.91,0:07:41.12,Default,,0,0,0,,".توجد كرة اسمها "كرة التنين القرمزي
Dialogue: 0,0:07:41.67,0:07:43.63,Default,,0,0,0,,!هذا هو! هذا ما نبحث عنه
Dialogue: 0,0:07:43.79,0:07:48.13,Default,,0,0,0,,بما أنك تعرف مكانها، هل يمكنك أن تأخذنا إلى هناك؟
Dialogue: 0,0:07:49.55,0:07:51.84,Default,,0,0,0,,!دعوني أتولى الأمر
Dialogue: 0,0:07:52.30,0:07:55.97,Default,,0,0,0,,هذا خطير جدًا! من يعرف متى سينفجر البركان؟
Dialogue: 0,0:07:59.18,0:08:01.48,Default,,0,0,0,,.لا تمنعيني، عزيزتي
Dialogue: 0,0:08:02.31,0:08:05.52,Default,,0,0,0,,.يجب أن أرد الجميل للذين أنقذوني
Dialogue: 0,0:08:06.06,0:08:08.82,Default,,0,0,0,,!هذا واجب الرجل الحقيقي
Dialogue: 0,0:08:09.94,0:08:11.45,Default,,0,0,0,,!عزيزي
Dialogue: 0,0:08:12.20,0:08:13.32,Default,,0,0,0,,.كن حذرًا
Dialogue: 0,0:08:15.41,0:08:16.87,Default,,0,0,0,,!يا له من رجل وسيم
Dialogue: 0,0:08:18.37,0:08:21.62,Default,,0,0,0,,.ابقوا هنا الليلة للاسترخاء جيدًا
Dialogue: 0,0:08:21.96,0:08:24.37,Default,,0,0,0,,!سنغادر غدًا عند الفجر
Dialogue: 0,0:08:24.83,0:08:26.33,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:08:30.34,0:08:32.17,Default,,0,0,0,,...أيتها الشياطين الكثر
Dialogue: 0,0:08:34.76,0:08:38.85,Default,,0,0,0,,!من فضلكم استمعوا لسحر أماكوسا شيرو توكيسادا
Dialogue: 0,0:08:40.60,0:08:42.35,Default,,0,0,0,,!تعالوا إلي
Dialogue: 0,0:08:49.19,0:08:50.86,Default,,0,0,0,,!أيها الأوتسوكي العظيم
Dialogue: 0,0:08:51.03,0:08:54.28,Default,,0,0,0,,!من فضلك أرشدني إلى مكان الكرة الأسطورية
Dialogue: 0,0:08:58.53,0:09:01.87,Default,,0,0,0,,!أطلب منك أين مكان الكرة الأسطورية
Dialogue: 0,0:09:05.46,0:09:08.50,Default,,0,0,0,,!كم هو جميل القمر الليلة
Dialogue: 0,0:09:11.17,0:09:13.26,Default,,0,0,0,,!هذا العجوز غبي
Dialogue: 0,0:09:13.80,0:09:14.51,Default,,0,0,0,,!كفى
Dialogue: 0,0:09:14.88,0:09:16.09,Default,,0,0,0,,!اختف من وجهي
Dialogue: 0,0:09:20.18,0:09:23.56,Default,,0,0,0,,!شيرو، هذه المرة السادسة والثلاثون
Dialogue: 0,0:09:23.89,0:09:26.65,Default,,0,0,0,,.ربما يجب أن نعتمد على الكاشف
Dialogue: 0,0:09:27.02,0:09:29.15,Default,,0,0,0,,.لا شك أن يايبا سيبحث عن الكرة
Dialogue: 0,0:09:31.86,0:09:33.99,Default,,0,0,0,,...لذا إذا تتبعنا أثره
Dialogue: 0,0:09:37.74,0:09:39.57,Default,,0,0,0,,!يومًا سعيدًا
Dialogue: 0,0:09:40.24,0:09:42.54,Default,,0,0,0,,!كن حذرًا -\N!بالطبع -
Dialogue: 0,0:09:44.29,0:09:47.79,Default,,0,0,0,,ماذا تنوي أن تفعل بكرة التنين القرمزي؟
Dialogue: 0,0:09:47.96,0:09:49.96,Default,,0,0,0,,!هذا واضح
Dialogue: 0,0:09:50.13,0:09:52.84,Default,,0,0,0,,!سأهزم هذا الوغد أونيمارو
Dialogue: 0,0:09:55.80,0:09:57.76,Default,,0,0,0,,تهزم الملك أونيمارو؟
Dialogue: 0,0:09:58.22,0:10:01.64,Default,,0,0,0,,!إذا ساعدتنا، فهذا يعني أنك حليفنا
Dialogue: 0,0:10:02.14,0:10:03.18,Default,,0,0,0,,...لكن
Dialogue: 0,0:10:03.60,0:10:05.89,Default,,0,0,0,,هل ستأتي وتقاتل معنا؟
Dialogue: 0,0:10:06.60,0:10:10.61,Default,,0,0,0,,!مهلا، انتظر لحظة
Dialogue: 0,0:10:17.24,0:10:18.99,Default,,0,0,0,,!هذا جبل آهو
Dialogue: 0,0:10:19.28,0:10:21.20,Default,,0,0,0,,...لا، اسمه جبل آسو
Dialogue: 0,0:10:25.91,0:10:27.58,Default,,0,0,0,,.نحن نختنق من الحر هنا
Dialogue: 0,0:10:27.96,0:10:32.25,Default,,0,0,0,,.البركان عاد للإثارة، مؤخرًا
Dialogue: 0,0:10:32.63,0:10:35.30,Default,,0,0,0,,.وسينفجر قريبًا
Dialogue: 0,0:10:37.59,0:10:41.05,Default,,0,0,0,,.أشعر أنه من الأفضل أن نسرع
Dialogue: 0,0:10:48.27,0:10:50.81,Default,,0,0,0,,.نحن على وشك الوصول إلى الأسفل
Dialogue: 0,0:10:52.73,0:10:53.52,Default,,0,0,0,,!لا
Dialogue: 0,0:10:55.98,0:10:58.70,Default,,0,0,0,,!لا يمكننا التقدم أكثر
Dialogue: 0,0:11:08.96,0:11:10.25,Default,,0,0,0,,!إنها الكرة
Dialogue: 0,0:11:12.58,0:11:13.96,Default,,0,0,0,,في المنتصف تمامًا؟
Dialogue: 0,0:11:14.42,0:11:16.59,Default,,0,0,0,,...إذا سقطنا، سنتحول إلى رماد
Dialogue: 0,0:11:19.42,0:11:21.34,Default,,0,0,0,,!هيا! شونوسوكي
Dialogue: 0,0:11:30.48,0:11:34.15,Default,,0,0,0,,!لا فائدة! لا أرى شيئًا بسبب الدخان
Dialogue: 0,0:11:35.98,0:11:37.53,Default,,0,0,0,,!إلى اليسار أكثر
Dialogue: 0,0:11:38.61,0:11:40.49,Default,,0,0,0,,!لا يوجد شيء هناك
Dialogue: 0,0:11:40.90,0:11:43.16,Default,,0,0,0,,!أيها الأحمق! أنت تذهب إلى اليمين
Dialogue: 0,0:11:43.45,0:11:44.53,Default,,0,0,0,,!اذهب إلى الاتجاه المعاكس
Dialogue: 0,0:11:44.87,0:11:47.12,Default,,0,0,0,,!أميري يايبا، اذهب أكثر إلى اليسار
Dialogue: 0,0:11:47.33,0:11:49.45,Default,,0,0,0,,!ه‍يا، اذهب إلى اليسار
Dialogue: 0,0:11:49.83,0:11:53.17,Default,,0,0,0,,ألا تميز بين اليسار واليمين، أيها الغبي؟
Dialogue: 0,0:11:55.00,0:11:56.17,Default,,0,0,0,,!رجل العنكبوت
Dialogue: 0,0:11:58.55,0:12:01.22,Default,,0,0,0,,...حسنًا، بما أنهم اكتشفونا
Dialogue: 0,0:12:01.76,0:12:05.64,Default,,0,0,0,,.أنا، أماكوسا شيرو توكيسادا، سأواجههم
Dialogue: 0,0:12:06.05,0:12:06.89,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:12:11.31,0:12:14.06,Default,,0,0,0,,!سيف نيكرومانسي أماكوسا
Dialogue: 0,0:12:14.90,0:12:17.23,Default,,0,0,0,,...سيف الرعد وكرتك الأسطورية
Dialogue: 0,0:12:17.65,0:12:19.82,Default,,0,0,0,,!سوف تعطيني إياها بلطف
Dialogue: 0,0:12:20.40,0:12:24.28,Default,,0,0,0,,!في أحلامك، أيها الأحمق! لن أعطيك إياها أبدًا
Dialogue: 0,0:12:25.99,0:12:27.70,Default,,0,0,0,,!انا قادم، أماكوسا غورو
Dialogue: 0,0:12:27.87,0:12:29.70,Default,,0,0,0,,!أنا اسمي شيرو، أيها الغبي
Dialogue: 0,0:12:29.87,0:12:30.75,Default,,0,0,0,,...يايبا
Dialogue: 0,0:12:33.87,0:12:35.13,Default,,0,0,0,,!هناك شيء غريب
Dialogue: 0,0:12:35.58,0:12:37.17,Default,,0,0,0,,هل هو على وشك الانفجار؟
Dialogue: 0,0:12:37.75,0:12:38.75,Default,,0,0,0,,!هذا فظيع
Dialogue: 0,0:12:39.25,0:12:41.63,Default,,0,0,0,,هل يجب أن نتخلى عن الكرة؟
Dialogue: 0,0:12:42.97,0:12:44.63,Default,,0,0,0,,!سأتولى الأمر
Dialogue: 0,0:12:45.18,0:12:47.60,Default,,0,0,0,,!هذا خطير! سينفجر
Dialogue: 0,0:12:48.06,0:12:51.10,Default,,0,0,0,,.لدي دين كبير تجاه يايبا
Dialogue: 0,0:12:51.56,0:12:54.06,Default,,0,0,0,,.أنا واحد من الشياطين الثمانية
Dialogue: 0,0:12:54.69,0:12:57.56,Default,,0,0,0,,!لدي بعض الخداع في جعبتي
Dialogue: 0,0:13:04.61,0:13:06.11,Default,,0,0,0,,!لا، توقف
Dialogue: 0,0:13:10.62,0:13:11.50,Default,,0,0,0,,!لقد فعلها
Dialogue: 0,0:13:16.71,0:13:18.09,Default,,0,0,0,,!رجل نجم البحر
Dialogue: 0,0:13:20.46,0:13:22.76,Default,,0,0,0,,...لقد استرجعت الكرة
Dialogue: 0,0:13:23.80,0:13:24.97,Default,,0,0,0,,!تماسك
Dialogue: 0,0:13:28.85,0:13:31.01,Default,,0,0,0,,.عمل رائع، أيها الخائن
Dialogue: 0,0:13:31.35,0:13:35.52,Default,,0,0,0,,هل يمكنك أن تعطيني هذه الكرة، الآن؟
Dialogue: 0,0:13:36.31,0:13:39.65,Default,,0,0,0,,!انتظر، البركان على وشك الانفجار
Dialogue: 0,0:13:39.82,0:13:41.02,Default,,0,0,0,,!اترك السيوف واهرب
Dialogue: 0,0:13:42.11,0:13:43.61,Default,,0,0,0,,!لن أُخدع بك
Dialogue: 0,0:13:44.82,0:13:47.11,Default,,0,0,0,,!لننسحب
Dialogue: 0,0:13:50.53,0:13:51.62,Default,,0,0,0,,...ساياكا
Dialogue: 0,0:13:52.45,0:13:54.79,Default,,0,0,0,,!سأعيقكم فقط. أنقذوا أنفسكم
Dialogue: 0,0:13:55.29,0:13:57.62,Default,,0,0,0,,...أسرعوا واهربوا
Dialogue: 0,0:13:58.25,0:14:02.00,Default,,0,0,0,,!اصمت! وإلا سأجعلك طعامي
Dialogue: 0,0:14:02.75,0:14:04.92,Default,,0,0,0,,.كأنني أسمع صوت يايبا يتكلم عبرها
Dialogue: 0,0:14:05.09,0:14:05.97,Default,,0,0,0,,...نعم
Dialogue: 0,0:14:19.15,0:14:20.11,Default,,0,0,0,,!شونوسوكي
Dialogue: 0,0:14:20.56,0:14:21.90,Default,,0,0,0,,أين يايبا؟
Dialogue: 0,0:14:30.70,0:14:32.33,Default,,0,0,0,,!سيف الرعد بدون الكرة
Dialogue: 0,0:14:32.99,0:14:35.25,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:14:41.04,0:14:44.34,Default,,0,0,0,,!سحر أماكوسا! ثعابين
Dialogue: 0,0:14:58.52,0:15:00.77,Default,,0,0,0,,!تحول الثعلب إلى نمر
Dialogue: 0,0:15:02.69,0:15:03.98,Default,,0,0,0,,!ساياكا! الكرة
Dialogue: 0,0:15:04.78,0:15:06.44,Default,,0,0,0,,أي واحدة تريد؟
Dialogue: 0,0:15:07.24,0:15:08.65,Default,,0,0,0,,...أريد الكرة
Dialogue: 0,0:15:08.90,0:15:09.86,Default,,0,0,0,,!توقف
Dialogue: 0,0:15:10.41,0:15:12.49,Default,,0,0,0,,!أريد الكرة الذهبية
Dialogue: 0,0:15:14.41,0:15:15.62,Default,,0,0,0,,!تبا
Dialogue: 0,0:15:16.04,0:15:18.87,Default,,0,0,0,,!هيا! سأتحول
Dialogue: 0,0:15:19.54,0:15:21.25,Default,,0,0,0,,!أريد أن أصبح تنينًا
Dialogue: 0,0:15:28.30,0:15:31.51,Default,,0,0,0,,.نمر ضد تنين، كما في اللوحات الكلاسيكية
Dialogue: 0,0:15:32.55,0:15:34.05,Default,,0,0,0,,أتعتقد ذلك؟
Dialogue: 0,0:15:43.06,0:15:44.36,Default,,0,0,0,,...يا لك من وغد
Dialogue: 0,0:15:45.82,0:15:48.15,Default,,0,0,0,,ماذا ستفعل كحوت على اليابسة؟
Dialogue: 0,0:15:49.11,0:15:50.11,Default,,0,0,0,,!أنا كوبرا
Dialogue: 0,0:15:50.90,0:15:52.07,Default,,0,0,0,,!أنا منقوس
Dialogue: 0,0:15:52.32,0:15:53.66,Default,,0,0,0,,!مركبة فضائية
Dialogue: 0,0:15:53.82,0:15:55.28,Default,,0,0,0,,!جسم غامض
Dialogue: 0,0:15:56.08,0:15:58.83,Default,,0,0,0,,...معركة سخيفة كما في ساحة المدرسة
Dialogue: 0,0:15:59.20,0:16:01.25,Default,,0,0,0,,...حسنًا، بما أن الأمر كذلك
Dialogue: 0,0:16:07.00,0:16:08.88,Default,,0,0,0,,.تعال في حضني، يا صغيري
Dialogue: 0,0:16:09.84,0:16:12.05,Default,,0,0,0,,!أصبح الأمر مثيرًا الآن
Dialogue: 0,0:16:12.22,0:16:15.10,Default,,0,0,0,,!يايبا! إنه يحاول خداعك
Dialogue: 0,0:16:16.05,0:16:17.31,Default,,0,0,0,,!أنا أمزح
Dialogue: 0,0:16:17.72,0:16:19.73,Default,,0,0,0,,هل تلعب دور فتاة الأرنب؟
Dialogue: 0,0:16:21.31,0:16:23.10,Default,,0,0,0,,!أنا ساياكا
Dialogue: 0,0:16:23.77,0:16:27.27,Default,,0,0,0,,!أحسنت يا يايبا حارب الجمال بالجمال
Dialogue: 0,0:16:23.80,0:16:30.80,Default,,0,0,0,,{\a6}!ملاحظة | سيتحول يايبا الآن إلى هيئة ناديشيكو شبه عارية فشاهد المشهد أو تجنبه على مسؤوليتك
Dialogue: 0,0:16:27.44,0:16:30.99,Default,,0,0,0,,يايبا، هل يمكنك التحول إلى ناديشيكو؟
Dialogue: 0,0:16:31.36,0:16:32.36,Default,,0,0,0,,!نعم، يمكنني
Dialogue: 0,0:16:43.62,0:16:45.04,Default,,0,0,0,,لماذا ترتدي ملابس السباحة؟
Dialogue: 0,0:16:45.25,0:16:46.59,Default,,0,0,0,,...اميري يايبا
Dialogue: 0,0:16:49.25,0:16:50.88,Default,,0,0,0,,!تحول رائع
Dialogue: 0,0:16:51.05,0:16:55.43,Default,,0,0,0,,!أراهن أنك لا تستطيع التحول إلى حبة صغيرة
Dialogue: 0,0:16:55.59,0:16:58.51,Default,,0,0,0,,!ماذا؟ سأريك
Dialogue: 0,0:16:59.31,0:16:59.85,Default,,0,0,0,,!لا
Dialogue: 0,0:17:00.43,0:17:01.60,Default,,0,0,0,,ما رأيك بهذا؟
Dialogue: 0,0:17:01.77,0:17:03.69,Default,,0,0,0,,!رائع. ممتاز
Dialogue: 0,0:17:04.81,0:17:05.90,Default,,0,0,0,,!لذيذ
Dialogue: 0,0:17:09.07,0:17:10.73,Default,,0,0,0,,!كان ذلك سهلاً جدًا
Dialogue: 0,0:17:11.99,0:17:13.45,Default,,0,0,0,,.حان دوركم الآن
Dialogue: 0,0:17:13.99,0:17:15.82,Default,,0,0,0,,.استعدوا
Dialogue: 0,0:17:19.83,0:17:20.79,Default,,0,0,0,,...مؤلم
Dialogue: 0,0:17:21.04,0:17:22.33,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:17:32.13,0:17:34.30,Default,,0,0,0,,!لا تستهين بكوروغاني يايبا
Dialogue: 0,0:17:35.09,0:17:36.39,Default,,0,0,0,,!أيها الوغد
Dialogue: 0,0:17:40.39,0:17:41.18,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:17:41.47,0:17:44.64,Default,,0,0,0,,!سأعضك حتى الموت
Dialogue: 0,0:17:48.06,0:17:49.52,Default,,0,0,0,,!في أحلامك
Dialogue: 0,0:17:57.20,0:18:01.91,Default,,0,0,0,,...يايبا، استخدم هذه الكرة، من فضلك
Dialogue: 0,0:18:02.91,0:18:04.12,Default,,0,0,0,,!لا تتحرك
Dialogue: 0,0:18:04.29,0:18:07.29,Default,,0,0,0,,...أعطي هذه الكرة ليايبا
Dialogue: 0,0:18:08.50,0:18:12.96,Default,,0,0,0,,...حصلت على هذه الكرة بخطر حياتي لمساعدتك
Dialogue: 0,0:18:13.59,0:18:16.38,Default,,0,0,0,,...طالما أنا لا أزال حيًا
Dialogue: 0,0:18:17.13,0:18:19.05,Default,,0,0,0,,...أرني قوتها
Dialogue: 0,0:18:21.43,0:18:22.76,Default,,0,0,0,,\N...حسناً
Dialogue: 0,0:18:24.60,0:18:25.85,Default,,0,0,0,,!فهمت
Dialogue: 0,0:18:28.19,0:18:29.56,Default,,0,0,0,,...الكرة الأسطورية
Dialogue: 0,0:18:30.56,0:18:32.07,Default,,0,0,0,,...كرة التنين القرمزي
Dialogue: 0,0:18:33.32,0:18:34.61,Default,,0,0,0,,!أعطني قوتك
Dialogue: 0,0:18:41.70,0:18:45.87,Default,,0,0,0,,!دعني أستعير قوتك
Dialogue: 0,0:18:46.66,0:18:47.41,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:18:47.58,0:18:49.29,Default,,0,0,0,,!ابتعدوا من هنا
Dialogue: 0,0:18:50.25,0:18:52.92,Default,,0,0,0,,!خذ هذا
Dialogue: 0,0:19:01.26,0:19:02.51,Default,,0,0,0,,...هذا مذهل
Dialogue: 0,0:19:02.89,0:19:03.85,Default,,0,0,0,,!تبًا
Dialogue: 0,0:19:04.47,0:19:06.10,Default,,0,0,0,,!لا يمكنني السيطرة عليها
Dialogue: 0,0:19:13.23,0:19:14.61,Default,,0,0,0,,...في هذه الحالة
Dialogue: 0,0:19:16.03,0:19:19.36,Default,,0,0,0,,.يبدو أنك لا تستطيع السيطرة على قوتها
Dialogue: 0,0:19:19.61,0:19:21.32,Default,,0,0,0,,!أنت تفقد صبرك
Dialogue: 0,0:19:22.41,0:19:25.24,Default,,0,0,0,,!يمكنك التدرب في العالم الآخر
Dialogue: 0,0:19:26.12,0:19:27.79,Default,,0,0,0,,!انظر جيدًا، يا رجل نجم البحر
Dialogue: 0,0:19:28.46,0:19:30.21,Default,,0,0,0,,!هذه هي قوة هذه الكرة
Dialogue: 0,0:19:30.62,0:19:32.17,Default,,0,0,0,,!مت، أيها الوغد
Dialogue: 0,0:19:32.88,0:19:33.38,Default,,0,0,0,,.تعال
Dialogue: 0,0:19:34.25,0:19:34.75,Default,,0,0,0,,.تعال
Dialogue: 0,0:19:35.59,0:19:36.13,Default,,0,0,0,,.تعال
Dialogue: 0,0:20:08.45,0:20:10.33,Default,,0,0,0,,!لقد... فعلتها
Dialogue: 0,0:20:10.83,0:20:12.71,Default,,0,0,0,,!أحسنت يا يايبا
Dialogue: 0,0:20:12.96,0:20:16.13,Default,,0,0,0,,!كرة النار؟ قوة مجنونة
Dialogue: 0,0:20:16.84,0:20:19.09,Default,,0,0,0,,!أسرعوا، هذا فظيع
Dialogue: 0,0:20:20.63,0:20:23.51,Default,,0,0,0,,!لا، يجب علاجه سريعًا
Dialogue: 0,0:20:24.14,0:20:26.35,Default,,0,0,0,,...لا فائدة
Dialogue: 0,0:20:26.72,0:20:30.18,Default,,0,0,0,,.فقدت السيطرة على جسدي
Dialogue: 0,0:20:31.94,0:20:34.69,Default,,0,0,0,,...يمكنكم إخبار زوجتي
Dialogue: 0,0:20:35.40,0:20:36.44,Default,,0,0,0,,...أنني
Dialogue: 0,0:20:37.15,0:20:38.15,Default,,0,0,0,,...أديت
Dialogue: 0,0:20:38.82,0:20:41.70,Default,,0,0,0,,.واجبي بفخر
Dialogue: 0,0:20:44.16,0:20:45.28,Default,,0,0,0,,هل تمزح؟
Dialogue: 0,0:20:47.20,0:20:48.70,Default,,0,0,0,,!لا
Dialogue: 0,0:20:49.58,0:20:52.46,Default,,0,0,0,,!لا تموت
Dialogue: 0,0:21:01.13,0:21:03.18,Default,,0,0,0,,!لقد تعافيت
Dialogue: 0,0:21:04.09,0:21:07.05,Default,,0,0,0,,!كنت تجف فقط، أيها الأحمق
Dialogue: 0,0:21:07.60,0:21:10.56,Default,,0,0,0,,!لا تخيفنا هكذا
Dialogue: 0,0:21:21.23,0:21:23.20,Default,,0,0,0,,يايبا، هل أنت بخير؟
Dialogue: 0,0:21:23.65,0:21:26.32,Default,,0,0,0,,،حسنًا، منذ ذلك اليوم
Dialogue: 0,0:21:26.66,0:21:29.95,Default,,0,0,0,,.أرى صورًا غريبة كلما لمست الكرة
Dialogue: 0,0:21:36.33,0:21:37.63,Default,,0,0,0,,!وداعًا
Dialogue: 0,0:21:37.79,0:21:38.88,Default,,0,0,0,,!كونوا حذرين
Dialogue: 0,0:21:39.63,0:21:42.42,Default,,0,0,0,,.لم تكن هذه كرة روح التنين
Dialogue: 0,0:21:43.55,0:21:45.59,Default,,0,0,0,,...ربما الآخرون
Dialogue: 0,0:21:46.09,0:21:47.93,Default,,0,0,0,,!لا يهم
Dialogue: 0,0:21:48.10,0:21:51.60,Default,,0,0,0,,!لقد رأينا أن هناك كرات رائعة
Dialogue: 0,0:21:52.27,0:21:55.14,Default,,0,0,0,,.سنبحث عن الكرات الأربع المتبقية
Dialogue: 0,0:21:55.77,0:21:59.40,Default,,0,0,0,,!وسٱهزم أونيمارو بقوة الكرات السبعة
Dialogue: 0,0:22:00.69,0:22:02.36,Default,,0,0,0,,تريدهم جميعًا؟
Dialogue: 0,0:22:02.65,0:22:04.61,Default,,0,0,0,,...يبدو هذا مرهقًا
Dialogue: 0,0:23:37.16,0:23:40.12,Default,,0,0,0,,،أتينا إلى نارا من أجل العثور على الكرة
Dialogue: 0,0:23:40.46,0:23:43.13,Default,,0,0,0,,لكن أين هي، في هذا المعبد الضخم؟
Dialogue: 0,0:23:44.42,0:23:46.46,Default,,0,0,0,,!المعبد تحرّك
Dialogue: 0,0:23:46.84,0:23:48.38,Default,,0,0,0,,."في الحلقة القادمة: "معركة العمالقة
Dialogue: 0,0:23:48.55,0:23:51.05,Default,,0,0,0,,الحلقة 16: معركة العمالقة
