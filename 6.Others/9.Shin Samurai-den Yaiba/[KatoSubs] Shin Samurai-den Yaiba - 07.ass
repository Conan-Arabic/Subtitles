Dialogue: 0,0:00:00.00,0:00:07.00,IBM,,0,0,0,,{\fs73.5\pos(1033,108)}@KatoSubs :ترجمة
Dialogue: 0,0:00:09.38,0:00:10.25,IBM,,0,0,0,,ما الأمر؟
Dialogue: 0,0:00:10.25,0:00:11.37,IBM,,0,0,0,,ما هذا الصوت؟
Dialogue: 0,0:00:11.37,0:00:12.78,IBM,,0,0,0,,!هنـاك-\Nما ذاك يا أمّي؟-
Dialogue: 0,0:00:13.50,0:00:15.93,IBM,,0,0,0,,!مـا ذاك بحقٍّ؟
Dialogue: 0,0:00:17.75,0:00:19.54,IBM,,0,0,0,,!!اخبار عاجلة
Dialogue: 0,0:00:19.54,0:00:21.00,IBM,,0,0,0,,!اليكم آخر الأخبار
Dialogue: 0,0:00:21.00,0:00:23.21,IBM,,0,0,0,,!ننتقل إلى قلب الحدث
Dialogue: 0,0:00:23.21,0:00:25.48,IBM,,0,0,0,,.مراسلة شيوجي معكم
Dialogue: 0,0:00:25.48,0:00:28.09,IBM,,0,0,0,,!اونيمـارو، أونيمـارو قد ظهـر
Dialogue: 0,0:00:28.97,0:00:33.10,IBM,,0,0,0,,!حوّل مبنى البرلمان إلى قلعةٍ، وهو يخطّط لِغزو اليابان
Dialogue: 0,0:00:33.78,0:00:36.06,IBM,,0,0,0,,!ما يجول بخاطر ذاك الرجل بحقٍّ؟
Dialogue: 0,0:00:40.05,0:00:44.07,IBM,,0,0,0,,!صارت اليابان مِلكًا لـسيّدكم أونيمارو
Dialogue: 0,0:00:44.07,0:00:45.40,IBM,,0,0,0,,،يا أقزام
Dialogue: 0,0:00:45.78,0:00:47.86,IBM,,0,0,0,,!فلتنصاعوا لأمري
Dialogue: 0,0:00:47.86,0:00:51.12,IBM,,0,0,0,,!من ذا المدعو أونيمارو؟\N!كفاك عبثًا معنا
Dialogue: 0,0:00:51.12,0:00:54.58,IBM,,0,0,0,,!لن يستسلم شعب اليابان بسهولة
Dialogue: 0,0:00:54.58,0:00:56.00,IBM,,0,0,0,,!هذا صحيح
Dialogue: 0,0:00:56.00,0:00:57.58,IBM,,0,0,0,,!لن نرضخ
Dialogue: 0,0:00:57.58,0:00:59.97,IBM,,0,0,0,,.كما شئتم
Dialogue: 0,0:00:59.97,0:01:03.00,IBM,,0,0,0,,!لـتشهدوا قوّتي بأمّ أعينكم إذن
Dialogue: 0,0:01:13.77,0:01:15.24,IBM,,0,0,0,,!...مـ- محـال
Dialogue: 0,0:01:15.24,0:01:16.49,IBM,,0,0,0,,أهذا حقيقي...؟
Dialogue: 0,0:01:26.50,0:01:28.48,IBM,,0,0,0,,أشاهدتم ذلك يا أذلّة القوم؟
Dialogue: 0,0:01:28.94,0:01:32.98,IBM,,0,0,0,,!لـتتذكّروا هذه القوة جيّدًا
Dialogue: 0,0:01:37.61,0:01:39.66,IBM,,0,0,0,,...الـ- السيد أونيمارو
Dialogue: 0,0:01:40.14,0:01:41.41,IBM,,0,0,0,,ما بك؟
Dialogue: 0,0:01:42.09,0:01:46.38,IBM,,0,0,0,,...الأمر وأنّه... الرجل الخفاش قد قُهر
Dialogue: 0,0:01:46.80,0:01:47.85,IBM,,0,0,0,,!ماذا؟
Dialogue: 0,0:01:48.60,0:01:50.84,IBM,,0,0,0,,حتّى هو قد هُزم؟
Dialogue: 0,0:01:51.87,0:01:54.72,IBM,,0,0,0,,.بهذا اندثرت كل الوحوش الثمانية
Dialogue: 0,0:01:54.72,0:01:56.56,IBM,,0,0,0,,...لـ- لكنّي ما زلت
Dialogue: 0,0:01:56.56,0:01:58.10,IBM,,0,0,0,,وماذا عنهم؟
Dialogue: 0,0:01:59.15,0:02:01.85,IBM,,0,0,0,,...بان أنّهم مقبلون على غانريو
Dialogue: 0,0:02:02.64,0:02:04.79,IBM,,0,0,0,,تقول جزيرة غانريو...؟
Dialogue: 0,0:02:04.79,0:02:06.36,IBM,,0,0,0,,.مثـالي
Dialogue: 0,0:02:06.36,0:02:09.07,IBM,,0,0,0,,.فلتصل قبلهم ولتبعثه
Dialogue: 0,0:02:09.47,0:02:11.31,IBM,,0,0,0,,من المنشود؟
Dialogue: 0,0:02:11.31,0:02:13.61,IBM,,0,0,0,,،ساموراي عاش قبل 4 قرون
Dialogue: 0,0:02:14.32,0:02:15.79,IBM,,0,0,0,,...واسمه
Dialogue: 0,0:02:16.28,0:02:18.20,IBM,,0,0,0,,.ساساكي كوجيرو
Dialogue: 0,0:03:51.06,0:03:52.71,IBM,,0,0,0,,.ساساكي كوجيرو
Dialogue: 0,0:03:53.70,0:03:57.58,IBM,,0,0,0,,...كان مُبارزًا عبقريًّا يُولد مرّة كل قرن
Dialogue: 0,0:03:57.58,0:03:59.85,IBM,,0,0,0,,...به من الحسن شيءٌ أيضًا
Dialogue: 0,0:03:59.85,0:04:03.68,IBM,,0,0,0,,.لكنه كان أدنى منّي شأنًا مع ذلك
Dialogue: 0,0:04:04.03,0:04:06.91,IBM,,0,0,0,,.روَيت هذا سابقًـا
Dialogue: 0,0:04:06.91,0:04:09.48,IBM,,0,0,0,,لك شأنٌ مع سيفه، أليس كذلك؟
Dialogue: 0,0:04:09.48,0:04:10.65,IBM,,0,0,0,,.نعم
Dialogue: 0,0:04:11.21,0:04:13.97,IBM,,0,0,0,,.انّه سيفٌ شيطاني يسعه التمدّد
Dialogue: 0,0:04:13.97,0:04:16.09,IBM,,0,0,0,,.ويُدعى مونوهوشيزاو
Dialogue: 0,0:04:16.09,0:04:17.50,IBM,,0,0,0,,،قبل 400 عامٍ
Dialogue: 0,0:04:17.50,0:04:22.12,IBM,,0,0,0,,.بارزت كوجيرو حامل ذلك السيف وغلبته
Dialogue: 0,0:04:22.12,0:04:23.41,IBM,,0,0,0,,وكيف ذلك؟
Dialogue: 0,0:04:25.01,0:04:27.71,IBM,,0,0,0,,.حسنٌ، أروي لكم إذن
Dialogue: 0,0:04:29.26,0:04:34.67,IBM,,0,0,0,,.حينَ عَلِمتُ أنَّه امتلكَ السيفَ الشيطانيَّ، دبَّرتُ استراتيجيّتي السريّة
Dialogue: 0,0:04:34.67,0:04:35.99,IBM,,0,0,0,,استراتيجيّة؟
Dialogue: 0,0:04:35.99,0:04:38.88,IBM,,0,0,0,,...صحيح. وهي
Dialogue: 0,0:04:39.25,0:04:42.26,IBM,,0,0,0,,!أن أتأخّر على النزال عمدًا
Dialogue: 0,0:04:42.26,0:04:44.29,IBM,,0,0,0,,...يبدو ذلك غير منصفٍ
Dialogue: 0,0:04:44.29,0:04:46.27,IBM,,0,0,0,,!بل هي استراتيجيّة مشروعة
Dialogue: 0,0:04:46.81,0:04:49.98,IBM,,0,0,0,,.لأنّه كان حادّ الطباع مثلك
Dialogue: 0,0:04:49.98,0:04:51.48,IBM,,0,0,0,,...فلتخرس
Dialogue: 0,0:04:51.48,0:04:55.74,IBM,,0,0,0,,.حمْلَقَ غضبًا حتى ثَقُلَ سيفُه
Dialogue: 0,0:04:55.74,0:04:58.74,IBM,,0,0,0,,،وما إن بدأ النزالُ
Dialogue: 0,0:04:58.74,0:05:03.07,IBM,,0,0,0,,!حتَّى أطلقَ ضربتَه القاتلة تسوبامي غايشي كافتتاحيّته
Dialogue: 0,0:05:03.07,0:05:07.75,IBM,,0,0,0,,!ولكن إذ بي أصدها ببراعة وأطيح به
Dialogue: 0,0:05:07.75,0:05:09.58,IBM,,0,0,0,,أحقًّا ما تقول~؟
Dialogue: 0,0:05:09.58,0:05:11.68,IBM,,0,0,0,,!"غُلب كوجيرو"
Dialogue: 0,0:05:11.68,0:05:14.11,IBM,,0,0,0,,'هكذا صارَتْ حكايةُ 'مبارزة جزيرة غانريو
Dialogue: 0,0:05:14.11,0:05:17.09,IBM,,0,0,0,,!تُرْوَى على كلِّ لسان
Dialogue: 0,0:05:17.09,0:05:18.17,IBM,,0,0,0,,ما...؟
Dialogue: 0,0:05:18.49,0:05:21.75,IBM,,0,0,0,,.ذهب كلّ ذلك في غياهب النسيان
Dialogue: 0,0:05:21.75,0:05:25.22,IBM,,0,0,0,,.لكن الشاهد على النزال تذكّر كل التفاصيل
Dialogue: 0,0:05:25.22,0:05:29.86,IBM,,0,0,0,,.هاك، كل شيء مكتوب هنا فاقرأه بحرصٍ
Dialogue: 0,0:05:31.10,0:05:32.78,IBM,,0,0,0,,!اود رؤية ذلك أيضًا
Dialogue: 0,0:05:32.78,0:05:35.23,IBM,,0,0,0,,،ها نحن ذا\N.يسعنا رؤيتها الآن
Dialogue: 0,0:05:35.91,0:05:38.37,IBM,,0,0,0,,.تلـك جزيرة غـانريو
Dialogue: 0,0:05:40.70,0:05:45.70,IBM,,0,0,0,,الحلقـة 7: انبعـاث كوجيـرو
Dialogue: 0,0:05:45.70,0:05:48.70,IBM,,0,0,0,,...ثقيلٌ- لٌ... ثقيلٌ- لٌ
Dialogue: 0,0:05:49.38,0:05:54.16,IBM,,0,0,0,,أثمّة حقًّا قبرٌ في مكانٍ كهذا؟
Dialogue: 0,0:05:59.48,0:06:01.63,IBM,,0,0,0,,!عجبًا، بان حقًّا
Dialogue: 0,0:06:01.63,0:06:03.63,IBM,,0,0,0,,~هذا جِدّ مقزّزٍ
Dialogue: 0,0:06:04.62,0:06:08.86,IBM,,0,0,0,,.لعلَّ طاقةَ السيفِ الشيطانيَّةَ هي ما منعَ جثمانَهُ مِنَ التَّحَنُّط
Dialogue: 0,0:06:09.40,0:06:11.48,IBM,,0,0,0,,...حسنٌ، الآتي
Dialogue: 0,0:06:12.18,0:06:15.24,IBM,,0,0,0,,...لـنرى\N،بيض كابا
Dialogue: 0,0:06:15.24,0:06:17.04,IBM,,0,0,0,,،تليها دموع تنين
Dialogue: 0,0:06:17.04,0:06:19.23,IBM,,0,0,0,,...ونختمها بمسحوق بعوضة
Dialogue: 0,0:06:21.53,0:06:24.95,IBM,,0,0,0,,.الجسد سليم
Dialogue: 0,0:06:25.37,0:06:27.16,IBM,,0,0,0,,!لكنَّ التحديَ الحقيقيَّ يبدأ الآن
Dialogue: 0,0:06:27.16,0:06:32.29,IBM,,0,0,0,,. أولًا، عليَّ إطلاقُ طاقةِ السيفِ الشيطانيَّةِ المُكَبَّلةِ منذُ أربعةِ قرونٍ
Dialogue: 0,0:06:34.13,0:06:39.22,IBM,,0,0,0,,بهذه القوة، سأشقُّ نسيجَ الزمكانِ
Dialogue: 0,0:06:39.22,0:06:41.34,IBM,,0,0,0,,عندَ اللحظةِ التي ماتَ فيها كوجيرو
Dialogue: 0,0:06:49.41,0:06:55.90,IBM,,0,0,0,,.وأقبض روحه العابرة
Dialogue: 0,0:06:56.84,0:06:58.58,IBM,,0,0,0,,!حـســــــنٌ
Dialogue: 0,0:06:58.58,0:07:02.65,IBM,,0,0,0,,!أمّا الآن فعليّ حشرها في الجسد
Dialogue: 0,0:07:03.39,0:07:06.11,IBM,,0,0,0,,!والآن، فلـتفق
Dialogue: 0,0:07:13.61,0:07:14.61,IBM,,0,0,0,,...غريبة
Dialogue: 0,0:07:15.03,0:07:17.29,IBM,,0,0,0,,!اوي فلتفق
Dialogue: 0,0:07:18.50,0:07:21.38,IBM,,0,0,0,,بمَ أخطأت؟
Dialogue: 0,0:07:29.18,0:07:33.35,IBM,,0,0,0,,أأنت من كان يضرب وجهي البهيّ؟
Dialogue: 0,0:07:34.51,0:07:36.85,IBM,,0,0,0,,!ايّها الوغد... من تكون؟
Dialogue: 0,0:07:36.85,0:07:39.02,IBM,,0,0,0,,!لا تبرح مكـانك لأقطعـك
Dialogue: 0,0:07:41.00,0:07:43.79,IBM,,0,0,0,,!مـ- مـ- مـ- مهـلًا
Dialogue: 0,0:07:43.79,0:07:45.61,IBM,,0,0,0,,!لسـتُ عدوّك
Dialogue: 0,0:07:45.61,0:07:50.24,IBM,,0,0,0,,!متتَ قبل 400 سنة وها أنا أعدتك وفقًا لأوامر السيد أونيمارو
Dialogue: 0,0:07:51.70,0:07:52.81,IBM,,0,0,0,,مت...؟
Dialogue: 0,0:07:54.14,0:07:56.54,IBM,,0,0,0,,...مهلًا... أنا
Dialogue: 0,0:08:02.47,0:08:03.41,IBM,,0,0,0,,!مـاذا؟
Dialogue: 0,0:08:04.43,0:08:06.60,IBM,,0,0,0,,!أبلغوا هذا الحد بالفعل؟
Dialogue: 0,0:08:06.60,0:08:08.67,IBM,,0,0,0,,!عليّ الإسراع في تخبيئك
Dialogue: 0,0:08:08.67,0:08:10.41,IBM,,0,0,0,,!فلتقف خلف التمثال يا كوجيرو
Dialogue: 0,0:08:11.20,0:08:12.45,IBM,,0,0,0,,...لا أستحضر شيئًا
Dialogue: 0,0:08:16.48,0:08:18.67,IBM,,0,0,0,,...اراها خاليةً
Dialogue: 0,0:08:18.67,0:08:21.50,IBM,,0,0,0,,!فلتلقوا نظرة، ثمّة ثماثيلٌ هناك
Dialogue: 0,0:08:21.50,0:08:25.74,IBM,,0,0,0,,ذلكم تمثالان لمياموتو موساشي أعظم سيّاف\N.وغريمه كوجيرو
Dialogue: 0,0:08:26.13,0:08:28.33,IBM,,0,0,0,,...وحدك من يشهد بعظمتك
Dialogue: 0,0:08:28.33,0:08:30.81,IBM,,0,0,0,,همم؟ ما ذلك الشيء الأسود؟
Dialogue: 0,0:08:32.47,0:08:34.09,IBM,,0,0,0,,هذا الحضور... أهو موساشي؟
Dialogue: 0,0:08:34.74,0:08:35.79,IBM,,0,0,0,,...مهلًا
Dialogue: 0,0:08:36.18,0:08:38.40,IBM,,0,0,0,,...أذكر أنّني خُدعت بحيلته وتلقيت ضربة-\N.يعلو هذا التمثال قبره-
Dialogue: 0,0:08:38.40,0:08:42.88,IBM,,0,0,0,,.لكنّي لا أستحضر شيئًا بعد ذلك-\N.انّه يرقد تحته رفقة سيفه-
Dialogue: 0,0:08:44.12,0:08:45.60,IBM,,0,0,0,,....أيُعقل
Dialogue: 0,0:08:46.84,0:08:49.59,IBM,,0,0,0,,...انّني... أنّني
Dialogue: 0,0:08:50.30,0:08:53.89,IBM,,0,0,0,,!متتُ حقًّــا؟...
Dialogue: 0,0:08:53.89,0:08:57.50,IBM,,0,0,0,,.لـهذا بعثتـك
Dialogue: 0,0:08:57.50,0:09:00.01,IBM,,0,0,0,,.مضى وقتٌ طويل يا كوجيرو
Dialogue: 0,0:09:01.17,0:09:06.10,IBM,,0,0,0,,.كنت  سيّافًا عبقريًّا يولد مرّةً كلّ قرن
Dialogue: 0,0:09:06.10,0:09:10.82,IBM,,0,0,0,,.وا حسرتاه على فقدان محاربٍ مثلك
Dialogue: 0,0:09:11.74,0:09:14.94,IBM,,0,0,0,,.اراك صرت صريحًا يا موساشي
Dialogue: 0,0:09:14.94,0:09:15.99,IBM,,0,0,0,,...علـى كلٍّ
Dialogue: 0,0:09:15.99,0:09:20.82,IBM,,0,0,0,,!أمّا أنـا فسيّـافٌ عظيم يأتي مرّةً كلّ مليون عـامٍ
Dialogue: 0,0:09:20.82,0:09:25.36,IBM,,0,0,0,,!ما كان لـساموراي غرٍّ مثلـك أن يغلبنـي إطلاقًـا
Dialogue: 0,0:09:28.30,0:09:30.11,IBM,,0,0,0,,!فلـتلم حظّـك العـاثر
Dialogue: 0,0:09:32.47,0:09:35.60,IBM,,0,0,0,,!كفـاك هذيـانًا يـا موسـاشي
Dialogue: 0,0:09:36.78,0:09:40.82,IBM,,0,0,0,,،انا المدعو ساساكي كوجيرو\N...أتيت من قعر الجحيم
Dialogue: 0,0:09:40.82,0:09:43.77,IBM,,0,0,0,,!بعد دهرٍ لأغلبنّك
Dialogue: 0,0:09:44.14,0:09:47.11,IBM,,0,0,0,,!سـاسـاكي كوجيـرو... قـد عـاد
Dialogue: 0,0:09:47.11,0:09:49.08,IBM,,0,0,0,,!كـ- كـوجيـرو؟
Dialogue: 0,0:09:49.08,0:09:50.82,IBM,,0,0,0,,أهو الحقيقي؟
Dialogue: 0,0:09:51.31,0:09:52.73,IBM,,0,0,0,,!الى ما ترمي؟
Dialogue: 0,0:09:56.10,0:09:59.11,IBM,,0,0,0,,.انـا من أعدته
Dialogue: 0,0:09:59.11,0:10:01.91,IBM,,0,0,0,,.هذا لقاؤنا الأوّل في الواقع
Dialogue: 0,0:10:02.35,0:10:05.24,IBM,,0,0,0,,...انا أحد الوحوش الثمانية-\N...انّه أحد الوحوش الثمانية-
Dialogue: 0,0:10:05.24,0:10:07.05,IBM,,0,0,0,,!الرجل العنكبوت، نقيـق
Dialogue: 0,0:10:08.03,0:10:10.42,IBM,,0,0,0,,!كنت في خضم التعريف عن نفسي
Dialogue: 0,0:10:10.76,0:10:13.73,IBM,,0,0,0,,أعنكبوتهم أتى هذه المرّة؟
Dialogue: 0,0:10:13.73,0:10:15.68,IBM,,0,0,0,,!لن أسلّمك سيف الرايجين
Dialogue: 0,0:10:16.01,0:10:20.72,IBM,,0,0,0,,.حسنٌ، سيقلّ غرورك بعد حين
Dialogue: 0,0:10:20.72,0:10:24.40,IBM,,0,0,0,,!سينســي! عليـك بهـم
Dialogue: 0,0:10:24.40,0:10:26.85,IBM,,0,0,0,,...لا زلت أجهل ما يحدث
Dialogue: 0,0:10:27.33,0:10:29.88,IBM,,0,0,0,,.ولكن لك ذلك\N!أوّلهم موساشي
Dialogue: 0,0:10:29.88,0:10:32.53,IBM,,0,0,0,,...لأقطعنّك إربًا
Dialogue: 0,0:10:34.21,0:10:36.66,IBM,,0,0,0,,بالمناسبة، أين موساشي- غوزارو؟
Dialogue: 0,0:10:36.66,0:10:38.31,IBM,,0,0,0,,.ها هو ذا
Dialogue: 0,0:10:38.31,0:10:40.83,IBM,,0,0,0,,.انا مياموتو موساشي
Dialogue: 0,0:10:41.34,0:10:43.55,IBM,,0,0,0,,!مـا- مــــــــــــــــــــــــــــــاذا؟
Dialogue: 0,0:10:43.55,0:10:45.92,IBM,,0,0,0,,!أهو هذا الشيخ القزم؟
Dialogue: 0,0:10:45.92,0:10:50.17,IBM,,0,0,0,,!ما الّذي حدث لوجهك الّذي كان يلي وجهي جمالًا؟
Dialogue: 0,0:10:50.70,0:10:52.59,IBM,,0,0,0,,!لا زلت وسيمًا
Dialogue: 0,0:10:52.59,0:10:56.42,IBM,,0,0,0,,لكن ماذا عنك؟\Nأما نظرت إلى عينيكَ المُحمَرَّتين؟
Dialogue: 0,0:10:56.42,0:11:00.16,IBM,,0,0,0,,أَبعَدَ أربعمئة عامٍ عن الدنيا وما زلتَ تبحثُ عن غفوةٍ؟
Dialogue: 0,0:11:01.12,0:11:02.93,IBM,,0,0,0,,...اراك تهذي كما جرت العادة
Dialogue: 0,0:11:05.44,0:11:07.07,IBM,,0,0,0,,!لـتبارزني يا موسـاشي
Dialogue: 0,0:11:07.07,0:11:08.77,IBM,,0,0,0,,!لـك ذلـك
Dialogue: 0,0:11:11.05,0:11:12.07,IBM,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:11:12.70,0:11:14.65,IBM,,0,0,0,,!يـــــــــا أبلـــــــــــــــــــه
Dialogue: 0,0:11:21.74,0:11:25.58,IBM,,0,0,0,,!بان أنّك سقلت سيافتك بينما كنت نائمًا في ذلك الصندوق
Dialogue: 0,0:11:25.58,0:11:28.50,IBM,,0,0,0,,!انت من صدأت سيـافته
Dialogue: 0,0:11:31.61,0:11:32.69,IBM,,0,0,0,,...امتـدّ
Dialogue: 0,0:11:33.27,0:11:35.04,IBM,,0,0,0,,!يـا مونوهـوشيـزاو...
Dialogue: 0,0:11:35.47,0:11:37.09,IBM,,0,0,0,,!امتدّ السيف حقًّـا
Dialogue: 0,0:11:46.17,0:11:48.22,IBM,,0,0,0,,.أشبت يا موساشي
Dialogue: 0,0:11:48.22,0:11:51.43,IBM,,0,0,0,,.موساشي زمان كان ليتفاداها بسهولة
Dialogue: 0,0:11:53.75,0:11:54.90,IBM,,0,0,0,,!تــأهّب
Dialogue: 0,0:11:54.90,0:11:56.36,IBM,,0,0,0,,!لـن أسمـح لـك
Dialogue: 0,0:12:01.09,0:12:02.14,IBM,,0,0,0,,...ايّها الغرّ
Dialogue: 0,0:12:02.55,0:12:05.62,IBM,,0,0,0,,أأستنتج من هذا أنّك تود مبارزة المبجّل كوجيرو؟
Dialogue: 0,0:12:05.62,0:12:08.29,IBM,,0,0,0,,!لسـتُ غرًّا! بـل يـايبـا
Dialogue: 0,0:12:08.77,0:12:13.21,IBM,,0,0,0,,!لا فائدة! لن تقدر على لمسي حتّى
Dialogue: 0,0:12:13.80,0:12:16.05,IBM,,0,0,0,,!!اخــــــــــــــــــــــــــــــــرس
Dialogue: 0,0:12:28.23,0:12:31.15,IBM,,0,0,0,,...قـ- قويٌّ\N...احتاج
Dialogue: 0,0:12:35.82,0:12:36.57,IBM,,0,0,0,,!ها هو ذا
Dialogue: 0,0:12:37.02,0:12:41.57,IBM,,0,0,0,,!هــاك\N!سيـــنبـــــــوكيـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــن
Dialogue: 0,0:12:41.57,0:12:44.26,IBM,,0,0,0,,!فلتمتدّ يــا مونوهوشيزاو
Dialogue: 0,0:12:49.15,0:12:50.71,IBM,,0,0,0,,!مــــاذا...؟
Dialogue: 0,0:12:54.67,0:12:57.69,IBM,,0,0,0,,...تلك التقنية\N.لا حاجة لمواجهتها
Dialogue: 0,0:12:57.69,0:13:01.09,IBM,,0,0,0,,.كل ما عليّ هو صدها من الأعلى
Dialogue: 0,0:13:01.45,0:13:04.29,IBM,,0,0,0,,!السينبوكين... قد قُمعـت
Dialogue: 0,0:13:04.68,0:13:06.31,IBM,,0,0,0,,...السينبوكيــن قد
Dialogue: 0,0:13:06.76,0:13:08.48,IBM,,0,0,0,,...لا حيلة لي أمامه
Dialogue: 0,0:13:12.78,0:13:14.40,IBM,,0,0,0,,.هذه النهاية
Dialogue: 0,0:13:14.40,0:13:15.65,IBM,,0,0,0,,!يا للهول
Dialogue: 0,0:13:16.11,0:13:17.69,IBM,,0,0,0,,!تسوبـامي غـايشي
Dialogue: 0,0:13:25.43,0:13:27.54,IBM,,0,0,0,,...فات الأوان
Dialogue: 0,0:13:35.54,0:13:37.71,IBM,,0,0,0,,!ما كان ذلك؟
Dialogue: 0,0:13:38.09,0:13:39.67,IBM,,0,0,0,,!لـن تفــــــــــــرّ
Dialogue: 0,0:13:39.67,0:13:41.68,IBM,,0,0,0,,!!سحقًـــــــــــا
Dialogue: 0,0:13:42.39,0:13:44.85,IBM,,0,0,0,,!فـلتهلـــــــك
Dialogue: 0,0:13:45.66,0:13:47.53,IBM,,0,0,0,,!...إنّي لـمقتول
Dialogue: 0,0:13:50.46,0:13:51.56,IBM,,0,0,0,,-مـا
Dialogue: 0,0:13:57.52,0:14:00.32,IBM,,0,0,0,,!!يــــــايــــبــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــا
Dialogue: 0,0:14:19.26,0:14:20.23,IBM,,0,0,0,,هذا المكان...؟
Dialogue: 0,0:14:20.23,0:14:23.01,IBM,,0,0,0,,...يا ابن الـ\N!من تكون؟
Dialogue: 0,0:14:24.77,0:14:29.48,IBM,,0,0,0,,!أتجاسرُ على هذه الجريمةِ وأنتَ تعلمُ أنَّ هذا الرجلَ هو السيد آيناغا، والي سيتسو؟
Dialogue: 0,0:14:31.02,0:14:34.24,IBM,,0,0,0,,!ايـن هـذا المكـان بحقٍّ؟
Dialogue: 0,0:14:35.47,0:14:37.46,IBM,,0,0,0,,!ما الّذي حدث لساياكا والبقيّة؟
Dialogue: 0,0:14:37.46,0:14:39.33,IBM,,0,0,0,,وماذا عن كوجيرو؟
Dialogue: 0,0:14:39.33,0:14:41.11,IBM,,0,0,0,,!ايـ- أيـن نحـن؟
Dialogue: 0,0:14:41.95,0:14:43.56,IBM,,0,0,0,,!كفـى! فلتقطعوه
Dialogue: 0,0:14:43.56,0:14:44.70,IBM,,0,0,0,,!حـاضر
Dialogue: 0,0:14:45.72,0:14:47.60,IBM,,0,0,0,,سيفٌ حقيقي...؟
Dialogue: 0,0:14:47.60,0:14:49.79,IBM,,0,0,0,,أتُراكم أتباع أونيمارو؟
Dialogue: 0,0:14:53.19,0:14:54.21,IBM,,0,0,0,,!ايّـاكم
Dialogue: 0,0:14:56.87,0:14:59.19,IBM,,0,0,0,,.لا يزال غلامًا
Dialogue: 0,0:14:59.19,0:15:01.63,IBM,,0,0,0,,اين فخر الساموراي الّذي لديكم؟
Dialogue: 0,0:15:01.63,0:15:04.17,IBM,,0,0,0,,!ايّها الوغد! هاتِ اسمك
Dialogue: 0,0:15:05.11,0:15:07.01,IBM,,0,0,0,,...رونين متشرّد من ساكوشو
Dialogue: 0,0:15:08.76,0:15:10.76,IBM,,0,0,0,,.ميـاموتـو موسـاشـي
Dialogue: 0,0:15:11.29,0:15:12.72,IBM,,0,0,0,,موساشي؟
Dialogue: 0,0:15:12.72,0:15:15.66,IBM,,0,0,0,,!مياموتو موساشي...؟
Dialogue: 0,0:15:15.66,0:15:20.02,IBM,,0,0,0,,!...ذاك المُبارز الأسطوريُّ الذي هزم المئات بمفرده
Dialogue: 0,0:15:20.54,0:15:23.07,IBM,,0,0,0,,.عظيمًا كنتُ أم لا، لستُ أدري
Dialogue: 0,0:15:24.24,0:15:26.78,IBM,,0,0,0,,.فينا إلي مكفينا
Dialogue: 0,0:15:26.78,0:15:29.25,IBM,,0,0,0,,!لـنتراجع
Dialogue: 0,0:15:32.70,0:15:33.87,IBM,,0,0,0,,...أأنت
Dialogue: 0,0:15:34.38,0:15:35.95,IBM,,0,0,0,,حقًّا موساشي؟
Dialogue: 0,0:15:37.49,0:15:40.54,IBM,,0,0,0,,أتعرفني؟
Dialogue: 0,0:15:40.98,0:15:43.21,IBM,,0,0,0,,...أعرفك حسن المعرفة
Dialogue: 0,0:15:45.44,0:15:48.47,IBM,,0,0,0,,!أ- أي عامٍ نحن فيه؟
Dialogue: 0,0:15:48.87,0:15:51.14,IBM,,0,0,0,,.السنة السابعة عشرة مِن عصر كييتشو
Dialogue: 0,0:15:51.14,0:15:53.23,IBM,,0,0,0,,!مـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــاذا؟
Dialogue: 0,0:15:53.23,0:15:53.85,IBM,,0,0,0,,ما بك؟
Dialogue: 0,0:15:54.56,0:15:59.98,IBM,,0,0,0,,!بالمختصر، نحن عدنـا بالزمن إلى عصر إيدو أي قبل 400 سنةٍ
Dialogue: 0,0:15:59.98,0:16:02.36,IBM,,0,0,0,,!مـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــاذا؟
Dialogue: 0,0:16:03.71,0:16:06.45,IBM,,0,0,0,,مهلًا... ماذا تقصد بعدنا بالزمن؟
Dialogue: 0,0:16:07.78,0:16:09.78,IBM,,0,0,0,,غوكونيجين، آوياما غونوسوكي
Dialogue: 0,0:16:11.63,0:16:12.49,IBM,,0,0,0,,...اذن
Dialogue: 0,0:16:12.49,0:16:15.53,IBM,,0,0,0,,تقول أنّكما أتيتما من المستقبل؟
Dialogue: 0,0:16:15.53,0:16:16.81,IBM,,0,0,0,,.وهو كذلك
Dialogue: 0,0:16:16.81,0:16:18.67,IBM,,0,0,0,,...هذا صعب التصديق
Dialogue: 0,0:16:19.35,0:16:23.20,IBM,,0,0,0,,كيف آل بنا الأمر في الماضي أصلًا؟
Dialogue: 0,0:16:23.20,0:16:25.69,IBM,,0,0,0,,،علينا الإسراع في العودة\N...أو أنّهم
Dialogue: 0,0:16:26.12,0:16:31.76,IBM,,0,0,0,,.ذكر أونيمارو إنَّ سيفَ مونوهوشيزاو الشيطانيَّ يستطيع اختراق الزمان والمكان
Dialogue: 0,0:16:32.13,0:16:36.02,IBM,,0,0,0,,لابد أنَّ ذاك الرجل العنكبوت استخدم تلك القوة لفتح ثُقبٍ زمنيٍّ
Dialogue: 0,0:16:36.02,0:16:39.39,IBM,,0,0,0,,.فجلب كوجيرو إلى عصرنا
Dialogue: 0,0:16:39.39,0:16:43.39,IBM,,0,0,0,,...ونحن سُقنا في ذلك الثُّقب
Dialogue: 0,0:16:43.39,0:16:46.86,IBM,,0,0,0,,اذن كوجيرو لم يعد هنا؟
Dialogue: 0,0:16:47.17,0:16:49.07,IBM,,0,0,0,,.ما ذاك بصحيح
Dialogue: 0,0:16:49.07,0:16:53.08,IBM,,0,0,0,,.لديّ مبارزة مع كوجيرو بعد 7 أيّام
Dialogue: 0,0:16:53.08,0:16:54.63,IBM,,0,0,0,,سأغلبه وأظفر
Dialogue: 0,0:16:54.63,0:16:56.40,IBM,,0,0,0,,،بلقب أعظم ساموراي في اليابان
Dialogue: 0,0:16:56.40,0:16:57.24,IBM,,0,0,0,,—انـا مياموتو
Dialogue: 0,0:16:57.24,0:16:59.75,IBM,,0,0,0,,!لا أحسب موساشي شيئًا
Dialogue: 0,0:17:00.79,0:17:03.69,IBM,,0,0,0,,!ها هو عظيم اليابان كوجيرو هنا
Dialogue: 0,0:17:03.69,0:17:05.45,IBM,,0,0,0,,~كلّنا يقينٌ بذلك
Dialogue: 0,0:17:05.45,0:17:07.22,IBM,,0,0,0,,~أليـــــــس كذلـــــك؟
Dialogue: 0,0:17:09.12,0:17:11.00,IBM,,0,0,0,,...كـ- كوجيرو
Dialogue: 0,0:17:13.25,0:17:15.33,IBM,,0,0,0,,أليس ذاك كوجيرو؟
Dialogue: 0,0:17:15.33,0:17:17.81,IBM,,0,0,0,,!اذن ذلك الملتحي هو موساشي؟
Dialogue: 0,0:17:18.30,0:17:21.06,IBM,,0,0,0,,!سيبدأ سفك الدماء
Dialogue: 0,0:17:21.06,0:17:22.77,IBM,,0,0,0,,!مبــــارزة
Dialogue: 0,0:17:31.57,0:17:33.10,IBM,,0,0,0,,!القِ نظرة
Dialogue: 0,0:17:35.03,0:17:36.90,IBM,,0,0,0,,!اِ- إنتبهــــــــــــــــا
Dialogue: 0,0:17:48.22,0:17:50.97,IBM,,0,0,0,,!عجبًـا... تلك الخشبة تحولت إلى عيدان أكلٍ
Dialogue: 0,0:17:50.97,0:17:52.40,IBM,,0,0,0,,مياموتو موساشي - ساساكي كوجيرو\Nوقد نقشا اسميهما
Dialogue: 0,0:17:52.40,0:17:53.93,IBM,,0,0,0,,مياموتو موساشي - ساساكي كوجيرو\N!عليها أيضًا
Dialogue: 0,0:17:53.93,0:17:56.70,IBM,,0,0,0,,...وعددها متساوٍ أيضًا \N.عشر آلافٍ لكلٍّ منهما
Dialogue: 0,0:17:56.70,0:17:58.57,IBM,,0,0,0,,...تعادل
Dialogue: 0,0:18:00.33,0:18:02.67,IBM,,0,0,0,,.اراك تطورت يا موساشي
Dialogue: 0,0:18:02.67,0:18:03.85,IBM,,0,0,0,,.ذات الأمر أراه عليك
Dialogue: 0,0:18:04.54,0:18:07.94,IBM,,0,0,0,,.لـنطلق العنان حين نزالنا بعد 7 أيّامٍ
Dialogue: 0,0:18:08.34,0:18:09.74,IBM,,0,0,0,,.لا حاجة لإخباري
Dialogue: 0,0:18:10.80,0:18:12.34,IBM,,0,0,0,,.تحت شرف الساموراي
Dialogue: 0,0:18:13.59,0:18:15.66,IBM,,0,0,0,,!ثمّة كوجيرو هنا أيضًا
Dialogue: 0,0:18:16.39,0:18:21.15,IBM,,0,0,0,,.اذكر أنّ أونيمارو سبق وأن قال أنّ الجثمانُ لا يزالُ صالحًا
Dialogue: 0,0:18:21.15,0:18:25.57,IBM,,0,0,0,,.حين ظهر كوجيرو في الزمن الحاضر، كان قريبًا مِن قبره
Dialogue: 0,0:18:26.88,0:18:28.80,IBM,,0,0,0,,لعلَّ الرجل العنكبوت
Dialogue: 0,0:18:28.80,0:18:31.71,IBM,,0,0,0,,فتحَ الثُّقبَ الزمنيَّ عند النقطةِ ذاتِها التي مات فيها
Dialogue: 0,0:18:31.71,0:18:33.47,IBM,,0,0,0,,...فانتزعَ روحَهُ وحدَها
Dialogue: 0,0:18:34.02,0:18:39.43,IBM,,0,0,0,,...ثم حبسَها في الجثمانِ المُحنَّطِ داخل التابوت، وأعادَ إحياءَه
Dialogue: 0,0:18:40.24,0:18:43.76,IBM,,0,0,0,,ان صحّ هذا، فاندفاعُنا العنيفُ في الثُّقبِ قذفَ
Dialogue: 0,0:18:43.76,0:18:46.86,IBM,,0,0,0,,...بنا إلى ماضٍ أبعد
Dialogue: 0,0:18:47.32,0:18:48.98,IBM,,0,0,0,,،ان صحّ قولك
Dialogue: 0,0:18:48.98,0:18:52.02,IBM,,0,0,0,,.إذا هزمَ موساشي خصمَهُ مرَّةً أخرى، فربما ينفتحُ الثُّقبُ مِن جديد
Dialogue: 0,0:18:52.02,0:18:55.82,IBM,,0,0,0,,!عندها، سنعبرُهُ عائدينَ إلى ساياكا والآخرين
Dialogue: 0,0:18:56.14,0:18:58.97,IBM,,0,0,0,,!حســنٌ! انتظرنـي يـا كوجيرو
Dialogue: 0,0:18:58.97,0:19:03.58,IBM,,0,0,0,,من الآن إلى حينها سأصبح أقوى\N!وسأهزمك فور عودتي
Dialogue: 0,0:19:09.14,0:19:10.93,IBM,,0,0,0,,!السيّـد موسـاشي
Dialogue: 0,0:19:12.22,0:19:13.84,IBM,,0,0,0,,أتُراكم ضيوفًا؟
Dialogue: 0,0:19:14.26,0:19:16.01,IBM,,0,0,0,,.اُدعى أوتسو
Dialogue: 0,0:19:16.40,0:19:17.72,IBM,,0,0,0,,وأنتما؟
Dialogue: 0,0:19:20.20,0:19:23.81,IBM,,0,0,0,,اذن تقول أنّكما لستما من هذا العصر؟
Dialogue: 0,0:19:24.19,0:19:25.29,IBM,,0,0,0,,.صحيح
Dialogue: 0,0:19:25.29,0:19:27.18,IBM,,0,0,0,,.هذا ما بان
Dialogue: 0,0:19:28.70,0:19:31.27,IBM,,0,0,0,,أدائمًا يتمرّن؟
Dialogue: 0,0:19:31.62,0:19:33.36,IBM,,0,0,0,,.نعم، كلّ يومٍ
Dialogue: 0,0:19:33.36,0:19:37.95,IBM,,0,0,0,,.ما مرّ يومٌ دون أن يحمل السيد موساشي سيفه
Dialogue: 0,0:19:37.95,0:19:42.37,IBM,,0,0,0,,.انّه جِدّ حـازمٍ\Nكيف آل به الأمر إلى ما عليه الآن؟
Dialogue: 0,0:19:45.61,0:19:49.46,IBM,,0,0,0,,.خلافًا لذلك، فهو يتدرّب تجهيزًا لمبارزته القادمة مع كوجيرو
Dialogue: 0,0:19:49.87,0:19:51.42,IBM,,0,0,0,,.فهمـت
Dialogue: 0,0:19:52.63,0:19:55.73,IBM,,0,0,0,,آل النصر لموساشي، صحيح؟
Dialogue: 0,0:19:57.32,0:19:58.65,IBM,,0,0,0,,!اقول يا موساشي
Dialogue: 0,0:19:59.49,0:20:03.24,IBM,,0,0,0,,لـكوجيرو تقنية رائعة، صحيح؟
Dialogue: 0,0:20:03.24,0:20:05.59,IBM,,0,0,0,,أتتحدّث على التسوبامي غايشي؟
Dialogue: 0,0:20:06.34,0:20:08.48,IBM,,0,0,0,,أبوسعك قهرها؟
Dialogue: 0,0:20:09.22,0:20:13.32,IBM,,0,0,0,,...تقنية تسوبامي غايشي\N،اوّلًا، يضرب بسيفه من الأعلى
Dialogue: 0,0:20:13.32,0:20:16.80,IBM,,0,0,0,,فإذا تفاداها الخصم إذ به\N.ينقضُّ عليه بضربةٍ خاطفةٍ من الأسفل
Dialogue: 0,0:20:17.19,0:20:21.45,IBM,,0,0,0,,،حركةٌ تُنجز في طرفة عين\N.كَسُنونو يقلبُ جناحيهِ في الهواء
Dialogue: 0,0:20:22.12,0:20:24.43,IBM,,0,0,0,,.وكوجيرو متقنٌ لهـا
Dialogue: 0,0:20:24.43,0:20:27.78,IBM,,0,0,0,,،ان تلقيّتها\N.ستشعرُ كأنما انقسمَ جسدُكَ إلى نصفين
Dialogue: 0,0:20:28.30,0:20:30.92,IBM,,0,0,0,,اذن كيف تنوي قمعها؟
Dialogue: 0,0:20:32.21,0:20:34.13,IBM,,0,0,0,,!عبر المضيّ بلا خشيةٍ
Dialogue: 0,0:20:35.14,0:20:37.11,IBM,,0,0,0,,.ذاك الدرب الحقّ للـنصر
Dialogue: 0,0:20:37.11,0:20:38.42,IBM,,0,0,0,,فقط؟
Dialogue: 0,0:20:38.42,0:20:39.47,IBM,,0,0,0,,.نعـم
Dialogue: 0,0:20:39.91,0:20:43.31,IBM,,0,0,0,,لكن لسيفه ميزة التمدّد، أليس كذلك؟
Dialogue: 0,0:20:43.91,0:20:47.84,IBM,,0,0,0,,،من يعتقد أنّ إصابة الخصم من بُعدٍ تعطيه الأفضليّة
Dialogue: 0,0:20:47.84,0:20:50.72,IBM,,0,0,0,,.فـهو ضعيـف الروح
Dialogue: 0,0:20:51.12,0:20:53.43,IBM,,0,0,0,,،أمّا اقترابك من عدوِّكَ في أي موقفٍ كان
Dialogue: 0,0:20:53.43,0:20:55.29,IBM,,0,0,0,,.يمنحكَ فرصةَ الانتصار
Dialogue: 0,0:20:55.29,0:20:56.61,IBM,,0,0,0,,،علاوةً
Dialogue: 0,0:20:56.61,0:21:00.30,IBM,,0,0,0,,...مَن يخطو إلى ساحةِ المُبارزةِ وهو يَستشعِرُ الهزيمةَ
Dialogue: 0,0:21:00.30,0:21:02.32,IBM,,0,0,0,,.ليسَ بِساموراي...
Dialogue: 0,0:21:02.92,0:21:04.70,IBM,,0,0,0,,ألست خائفًا؟
Dialogue: 0,0:21:04.70,0:21:07.38,IBM,,0,0,0,,...ان تسرّب الخوف إليّ
Dialogue: 0,0:21:07.88,0:21:10.53,IBM,,0,0,0,,.فذاكَ دليلُ نقصٍ في تدريبي
Dialogue: 0,0:21:10.92,0:21:15.26,IBM,,0,0,0,,.أدِمِ التدريب بإتقان، تَنمُ ثقتك في نفسك
Dialogue: 0,0:21:15.26,0:21:18.13,IBM,,0,0,0,,...وإذا نمَت سريتْ إلى سيفـك
Dialogue: 0,0:21:18.66,0:21:20.88,IBM,,0,0,0,,.فـتُنير دربـك إلى النصـر
Dialogue: 0,0:21:22.45,0:21:26.14,IBM,,0,0,0,,.رُكنـك الأهمّ هو الإيمـان بـحدّ سيفـك
Dialogue: 0,0:21:27.88,0:21:29.94,IBM,,0,0,0,,،واظب على التدريب كلّ يومٍ
Dialogue: 0,0:21:29.94,0:21:33.29,IBM,,0,0,0,,.حتّى يأتي اليوم الّذي تُدرك فيه
Dialogue: 0,0:21:33.73,0:21:37.57,IBM,,0,0,0,,اذن، ألك بالتدريب معي حتى يوم النزال؟
Dialogue: 0,0:21:38.70,0:21:40.58,IBM,,0,0,0,,!طبعًـا
Dialogue: 0,0:21:41.01,0:21:42.28,IBM,,0,0,0,,...اذن هيّـا
Dialogue: 0,0:21:43.12,0:21:44.45,IBM,,0,0,0,,!هـاجمنـي
Dialogue: 0,0:21:53.44,0:21:58.30,IBM,,0,0,0,,!في المبارزة، عليـك دائمًا بالمبادرة والهجوم
Dialogue: 0,0:21:59.01,0:22:01.83,IBM,,0,0,0,,،وللتتّخذ وضعيّةً للضرب
Dialogue: 0,0:22:01.83,0:22:04.21,IBM,,0,0,0,,.وسيفك سيتبع ذلك بدوره
Dialogue: 0,0:22:08.20,0:22:10.41,IBM,,0,0,0,,!لن تخونك تدريباتك أبدًا
Dialogue: 0,0:22:10.77,0:22:14.69,IBM,,0,0,0,,!فبتراكمها تنكشف قوّتك الحقيقيّة
Dialogue: 0,0:22:19.26,0:22:21.82,IBM,,0,0,0,,.حسنٌ، انتهينا لليوم
Dialogue: 0,0:22:21.82,0:22:24.11,IBM,,0,0,0,,إنتهينا بالفعل؟
Dialogue: 0,0:22:24.91,0:22:27.06,IBM,,0,0,0,,.لنا 6 أيّامٍ منذ بدأنا التمرين
Dialogue: 0,0:22:27.06,0:22:29.64,IBM,,0,0,0,,.غدًا يوم النزال الموعود
Dialogue: 0,0:22:30.13,0:22:33.73,IBM,,0,0,0,,.تلويحك بالسيف ليس نوع التمرين الوحيد
Dialogue: 0,0:22:33.73,0:22:37.09,IBM,,0,0,0,,...انا قلقةٌ إن كان بإمكان السيّد موساشي الفوز
Dialogue: 0,0:22:37.44,0:22:41.55,IBM,,0,0,0,,،لا حاجة للقلق\N.فأنا أدري النتيجة
Dialogue: 0,0:22:41.55,0:22:43.48,IBM,,0,0,0,,يفوز موساشي عبر التأخّر عمدًا
Dialogue: 0,0:22:43.48,0:22:47.17,IBM,,0,0,0,,.إذا يجد كوجيرو مرخيًا دفاعه فينقضّ عليه
Dialogue: 0,0:22:47.71,0:22:50.98,IBM,,0,0,0,,!حاشا للسيّد موساشي أن ينحطّ لمكر الجبناء
Dialogue: 0,0:22:51.77,0:22:55.62,IBM,,0,0,0,,"لكنّه قال أنّها "استراتيجيّة مشروعة
Dialogue: 0,0:22:55.62,0:22:56.98,IBM,,0,0,0,,أليس كذلك يا موساشي؟
Dialogue: 0,0:22:57.73,0:23:00.80,IBM,,0,0,0,,انّ التأخّر عن النزال\N!لعارٌ على الساموراي
Dialogue: 0,0:23:00.80,0:23:03.90,IBM,,0,0,0,,!ما كنت أنا موساشي أن أفعل شيئًا كهذا
Dialogue: 0,0:23:04.75,0:23:06.57,IBM,,0,0,0,,هل استوعبت؟
Dialogue: 0,0:23:09.49,0:23:13.05,IBM,,0,0,0,,،هذه مصيبة! إن آل الحدث بالتغيّر في التاريخ
Dialogue: 0,0:23:13.05,0:23:16.24,IBM,,0,0,0,,!فمآل النزال قد يتغيّر أيضًا
Dialogue: 0,0:23:16.24,0:23:18.81,IBM,,0,0,0,,...ان انتهى الأمر بخسارة موساشي
Dialogue: 0,0:23:19.31,0:23:22.84,IBM,,0,0,0,,...قد لا نعود إلى عصرنا
Dialogue: 0,0:23:23.34,0:23:24.71,IBM,,0,0,0,,...محال
Dialogue: 0,0:23:25.17,0:23:27.22,IBM,,0,0,0,,،ان صحّ قولك\N،اذن ساياكا والبقيّة
Dialogue: 0,0:23:28.32,0:23:31.90,IBM,,0,0,0,,!ما الّذي سيحدث لهم؟
Dialogue: 0,0:23:35.56,0:23:40.27,IBM,,0,0,0,,!محال! أتقول إنّ يايبا قد عاد بالزمن؟
Dialogue: 0,0:23:40.27,0:23:42.48,IBM,,0,0,0,,!فلتعد بسرعة يا يايبـــا
Dialogue: 0,0:23:42.48,0:23:44.57,IBM,,0,0,0,,...ان استمرّ الوضع هكذا فجميعنا سـ
Dialogue: 0,0:23:44.95,0:23:47.05,IBM,,0,0,0,,"قادمًا، "معركة جزيرة غانريو
Dialogue: 0,0:23:47.05,0:23:47.91,IBM,,0,0,0,,!انّـه نزالٌ يـا كوجيرو
