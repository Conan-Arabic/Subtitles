Dialogue: 0,0:00:01.00,0:00:08.00,Default,,0,0,0,,{\fs50\pos(200,200)} ABOODY SUBS | ترجمة \NTelegram : ABOODY-SUBS\NX : @ABOODY_SUBS
Dialogue: 0,0:00:02.12,0:00:03.62,Default,,0,0,0,,{\an8} مدينة نارا
Dialogue: 0,0:00:04.50,0:00:06.17,Default,,0,0,0,,...بنك أونيمارو
Dialogue: 0,0:00:06.71,0:00:07.92,Default,,0,0,0,,...كتب أونيمارو
Dialogue: 0,0:00:08.59,0:00:10.17,Default,,0,0,0,,مقهى أونيمارو؟
Dialogue: 0,0:00:11.09,0:00:13.72,Default,,0,0,0,,!ذلك الوغد أونيمارو قد تجاوز كل الحدود
Dialogue: 0,0:00:14.76,0:00:17.97,Default,,0,0,0,,...هذه الرحلة فقدت كل متعتها بدون ناديشيكو
Dialogue: 0,0:00:18.05,0:00:19.43,Default,,0,0,0,,.كان لا بد من ذلك
Dialogue: 0,0:00:19.51,0:00:22.81,Default,,0,0,0,,.لقد ذهبت لمعرفة مكان الكرة التالية
Dialogue: 0,0:00:22.89,0:00:25.85,Default,,0,0,0,,أنت متأكد من وجود واحدة هنا، أليس كذلك؟
Dialogue: 0,0:00:25.94,0:00:29.23,Default,,0,0,0,,علينا فقط الانتظار حتى تعود، صحيح؟
Dialogue: 0,0:00:29.32,0:00:33.36,Default,,0,0,0,,...أتمنى ذلك، لكن العدو قد يسبقنا
Dialogue: 0,0:00:34.45,0:00:35.78,Default,,0,0,0,,!اعذروني
Dialogue: 0,0:00:36.53,0:00:39.28,Default,,0,0,0,,.أنا إيشيكاوا غويمون
Dialogue: 0,0:00:39.37,0:00:43.29,Default,,0,0,0,,!أظن أنكم يجب أن تكونوا كوروغاني يايبا ورفاقه
Dialogue: 0,0:00:43.37,0:00:44.33,Default,,0,0,0,,...أنا أتوسل
Dialogue: 0,0:00:44.41,0:00:46.96,Default,,0,0,0,,!امنحوني شرف الانضمام إلى صفوفكم
Dialogue: 0,0:00:47.96,0:00:50.88,Default,,0,0,0,,...هذا مفاجئ جدًا
Dialogue: 0,0:00:51.92,0:00:53.38,Default,,0,0,0,,...أنا أعرف
Dialogue: 0,0:00:53.47,0:00:56.68,Default,,0,0,0,,،كلما زاد عددنا، كان ذلك أفضل
Dialogue: 0,0:00:56.76,0:01:00.77,Default,,0,0,0,,.لكننا لا نملك المال الكافي لإطعام فرد إضافي
Dialogue: 0,0:01:00.93,0:01:02.23,Default,,0,0,0,,!لا تقلقوا
Dialogue: 0,0:01:03.09,0:01:05.98,Default,,0,0,0,,!أنا لدي الكثير من المال
Dialogue: 0,0:01:07.81,0:01:10.11,Default,,0,0,0,,كيف استطعت جمع كل هذا المال؟
Dialogue: 0,0:01:11.90,0:01:15.82,Default,,0,0,0,,.المال هو سبب حركة العالم
Dialogue: 0,0:01:28.25,0:01:30.75,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:02:47.54,0:02:52.38,Default,,0,0,0,,الحلقة 16: المعركة العملاقة
Dialogue: 0,0:02:53.09,0:02:55.67,Default,,0,0,0,,!لنحتفل يا أصدقاء
Dialogue: 0,0:02:55.84,0:02:57.34,Default,,0,0,0,,لنستمتع!
Dialogue: 0,0:02:57.51,0:03:01.64,Default,,0,0,0,,إنهم يبالغون... دائمًا ما ينتهي الأمر\N...هكذا عندما نحصل على بعض المال
Dialogue: 0,0:03:02.01,0:03:04.14,Default,,0,0,0,,هل تتدرب لتصبح محاربًا؟
Dialogue: 0,0:03:04.31,0:03:08.44,Default,,0,0,0,,.نعم! سمعت عن يايبا أثناء سفري
Dialogue: 0,0:03:08.60,0:03:12.73,Default,,0,0,0,,!وعنك أيضًا بالطبع، ساساكي كوجيرو
Dialogue: 0,0:03:13.19,0:03:14.52,Default,,0,0,0,,...فهمت
Dialogue: 0,0:03:14.69,0:03:18.11,Default,,0,0,0,,!ستصبح قويًا! أنا أضمن لك ذلك
Dialogue: 0,0:03:18.65,0:03:21.62,Default,,0,0,0,,!شكرًا! إنه شرف عظيم لي
Dialogue: 0,0:03:21.78,0:03:25.62,Default,,0,0,0,,.رسالة من ناديشيكو. أتساءل إذا كانت قد اكتشفت موقع الكرة
Dialogue: 0,0:03:25.79,0:03:30.04,Default,,0,0,0,,.سايكا, من المحتمل أن أحدًا يستمع، ولا أحد يعلم
Dialogue: 0,0:03:30.21,0:03:32.75,Default,,0,0,0,,.خذينا إلى هناك غدًا، لا تقولي شيئًا الليلة
Dialogue: 0,0:03:33.00,0:03:34.38,Default,,0,0,0,,...حسنًا، لا مشكلة
Dialogue: 0,0:03:34.96,0:03:36.25,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:03:38.13,0:03:38.97,Default,,0,0,0,,.اسمح لي
Dialogue: 0,0:03:43.43,0:03:43.93,Default,,0,0,0,,.خذ
Dialogue: 0,0:03:44.10,0:03:45.35,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,0:03:45.51,0:03:46.26,Default,,0,0,0,,.عفواً
Dialogue: 0,0:03:46.85,0:03:47.35,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:03:48.31,0:03:49.39,Default,,0,0,0,,...هاتفي
Dialogue: 0,0:03:49.56,0:03:51.27,Default,,0,0,0,,.كان على وشك السقوط من الطاولة
Dialogue: 0,0:03:51.77,0:03:53.36,Default,,0,0,0,,!أشكرك
Dialogue: 0,0:04:02.66,0:04:03.99,Default,,0,0,0,,هل ستتبول؟
Dialogue: 0,0:04:08.75,0:04:12.50,Default,,0,0,0,,أعتذر، هل أيقظتك؟
Dialogue: 0,0:04:13.00,0:04:14.57,Default,,0,0,0,,.لا بأس، اذهب
Dialogue: 0,0:04:14.75,0:04:17.50,Default,,0,0,0,,.كلما تقدمنا في العمر، كلما أصبح نومنا خفيفًا
Dialogue: 0,0:04:18.51,0:04:19.67,Default,,0,0,0,,إذن، هل ستذهب؟
Dialogue: 0,0:04:22.09,0:04:24.26,Default,,0,0,0,,.نعم، على الفور
Dialogue: 0,0:04:28.27,0:04:30.06,Default,,0,0,0,,"معبد مدرسة كيجون الكبرى"
Dialogue: 0,0:04:32.23,0:04:34.19,Default,,0,0,0,,!إنه ضخم
Dialogue: 0,0:04:37.27,0:04:38.32,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:04:38.61,0:04:40.94,Default,,0,0,0,,.لم أنم جيدًا الليلة الماضية
Dialogue: 0,0:04:41.49,0:04:43.99,Default,,0,0,0,,.سأتحقق من الأمر بنفسي
Dialogue: 0,0:04:45.16,0:04:48.08,Default,,0,0,0,,!ما هذا؟ إنه رائع
Dialogue: 0,0:04:48.33,0:04:50.25,Default,,0,0,0,,.إنهم حراس المعبد
Dialogue: 0,0:04:50.79,0:04:52.91,Default,,0,0,0,,.ذاك الذي فمه مفتوح هو أجيو
Dialogue: 0,0:04:53.08,0:04:55.21,Default,,0,0,0,,.والآخر هو أونغيو
Dialogue: 0,0:04:55.63,0:04:58.21,Default,,0,0,0,,.يمثلان بداية العالم ونهايته
Dialogue: 0,0:04:58.50,0:05:00.38,Default,,0,0,0,,أجيو وأونغيو؟
Dialogue: 0,0:05:00.88,0:05:02.59,Default,,0,0,0,,موساشي، هل تعرفهما جيدًا؟
Dialogue: 0,0:05:02.92,0:05:05.80,Default,,0,0,0,,.لقد قاتلت هنا في الماضي
Dialogue: 0,0:05:06.72,0:05:08.93,Default,,0,0,0,,إذن، أين الكرة؟
Dialogue: 0,0:05:09.56,0:05:12.35,Default,,0,0,0,,...في الحقيقة، نعلم فقط أنها داخل المعبد
Dialogue: 0,0:05:12.52,0:05:15.10,Default,,0,0,0,,...سنضطر مرة أخرى للبحث في كل مكان
Dialogue: 0,0:05:16.02,0:05:19.11,Default,,0,0,0,,!البحث في كل مكان؟ لا أريد ذلك
Dialogue: 0,0:05:19.27,0:05:21.44,Default,,0,0,0,,...هذا يعني أنه سيكون مرهقًا
Dialogue: 0,0:05:21.61,0:05:23.86,Default,,0,0,0,,!لنتفرق للبحث بشكل أفضل
Dialogue: 0,0:05:27.45,0:05:30.41,Default,,0,0,0,,هذا هي كرتي الصغيرة. هل تريدون حملها؟
Dialogue: 0,0:05:32.37,0:05:35.04,Default,,0,0,0,,!الكرة؟ لدي شيء جميل منها هنا
Dialogue: 0,0:05:36.00,0:05:37.29,Default,,0,0,0,,!ها هو طلبكم
Dialogue: 0,0:05:37.79,0:05:39.29,Default,,0,0,0,,!آيس كريم روح التنين
Dialogue: 0,0:05:41.71,0:05:43.13,Default,,0,0,0,,...كرة هذا
Dialogue: 0,0:05:44.17,0:05:45.22,Default,,0,0,0,,كرة ذلك…
Dialogue: 0,0:05:47.09,0:05:50.14,Default,,0,0,0,,!هذا ليس ما نبحث عنه إطلاقًا
Dialogue: 0,0:05:57.19,0:05:59.56,Default,,0,0,0,,...لا أستطيع العثور عليها
Dialogue: 0,0:06:01.86,0:06:04.44,Default,,0,0,0,,انتظروا! ماذا تفعلون؟
Dialogue: 0,0:06:05.99,0:06:07.24,Default,,0,0,0,,لماذا تصرخ؟
Dialogue: 0,0:06:10.24,0:06:11.62,Default,,0,0,0,,!تراجعوا
Dialogue: 0,0:06:15.75,0:06:19.79,Default,,0,0,0,,.هذا غريب... عادة ما يكونون هادئين
Dialogue: 0,0:06:20.88,0:06:24.80,Default,,0,0,0,,يا صغير، هل لعبت بأي خدعة قذرة على الغزلان؟
Dialogue: 0,0:06:25.13,0:06:28.97,Default,,0,0,0,,!لم أفعل شيئًا! وأنت الذي تبدو مثل الفول
Dialogue: 0,0:06:29.51,0:06:30.55,Default,,0,0,0,,،بالمناسبة
Dialogue: 0,0:06:30.76,0:06:33.18,Default,,0,0,0,,هل تعرف أين الكرة الأسطورية؟
Dialogue: 0,0:06:35.27,0:06:38.56,Default,,0,0,0,,أخبرني، من أين سمعت عن تلك الكرة؟
Dialogue: 0,0:06:38.73,0:06:39.94,Default,,0,0,0,,هل تعرفها؟
Dialogue: 0,0:06:40.40,0:06:43.94,Default,,0,0,0,,.لا أعرف من أخبركم عنها، لكن اذهبوا
Dialogue: 0,0:06:44.19,0:06:48.45,Default,,0,0,0,,هيا، كن لطيفًا وأخبرنا بما تعرف، حسنًا؟
Dialogue: 0,0:06:48.74,0:06:50.57,Default,,0,0,0,,!اغربوا عن وجهي
Dialogue: 0,0:06:50.74,0:06:52.87,Default,,0,0,0,,!ولا تعودوا أبدًا
Dialogue: 0,0:06:55.20,0:06:56.12,Default,,0,0,0,,...لكن
Dialogue: 0,0:07:00.67,0:07:03.00,Default,,0,0,0,,!يا صغير، لا بد أنك محبط
Dialogue: 0,0:07:03.17,0:07:06.42,Default,,0,0,0,,!لقد حصلت بالفعل على الكرة
Dialogue: 0,0:07:07.30,0:07:08.26,Default,,0,0,0,,!مستحيل
Dialogue: 0,0:07:09.80,0:07:12.22,Default,,0,0,0,,...لا، لا تزال هناك
Dialogue: 0,0:07:13.93,0:07:15.85,Default,,0,0,0,,.فهمت، إنها هي إذن
Dialogue: 0,0:07:16.64,0:07:17.73,Default,,0,0,0,,!يا ويلي
Dialogue: 0,0:07:18.27,0:07:21.02,Default,,0,0,0,,!أيها الجرذ الحقير، أخيرًا تظهر حقيقتك
Dialogue: 0,0:07:21.44,0:07:23.52,Default,,0,0,0,,من أنت بالضبط؟
Dialogue: 0,0:07:25.44,0:07:28.20,Default,,0,0,0,,،أظن أنك قد تجده وقحًا
Dialogue: 0,0:07:28.53,0:07:31.49,Default,,0,0,0,,!لكني أعظم لص مشى على الأرض
Dialogue: 0,0:07:31.66,0:07:34.49,Default,,0,0,0,,!أعرف! أنت كايتو كيد
Dialogue: 0,0:07:35.66,0:07:37.00,Default,,0,0,0,,!ايتها الغبية
Dialogue: 0,0:07:37.16,0:07:40.25,Default,,0,0,0,,.افتحي أذنيكِ جيدًا واسمعيني
Dialogue: 0,0:07:41.46,0:07:43.00,Default,,0,0,0,,...أنا
Dialogue: 0,0:07:44.09,0:07:46.71,Default,,0,0,0,,!أعظم لص عرفه هذا العالم
Dialogue: 0,0:07:46.88,0:07:51.43,Default,,0,0,0,,!اسمي إيشيكاوا غويمون
Dialogue: 0,0:07:52.55,0:07:53.76,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:07:53.93,0:07:55.01,Default,,0,0,0,,!يايبا
Dialogue: 0,0:07:57.18,0:07:58.89,Default,,0,0,0,,هل هذه الكرة المشهورة؟
Dialogue: 0,0:08:09.07,0:08:13.32,Default,,0,0,0,,!أنت ماهر، ايها الصغير، لكنك لن تحصل على الكرة
Dialogue: 0,0:08:23.88,0:08:25.50,Default,,0,0,0,,...الوغد
Dialogue: 0,0:08:26.17,0:08:27.84,Default,,0,0,0,,!سايكا، الكرة
Dialogue: 0,0:08:28.01,0:08:29.88,Default,,0,0,0,,!كرة النار -\N...حسنا -
Dialogue: 0,0:08:30.79,0:08:32.67,Default,,0,0,0,,!تعال، أيها الصغير
Dialogue: 0,0:08:33.79,0:08:34.67,Default,,0,0,0,,!أسرعي
Dialogue: 0,0:08:35.22,0:08:38.14,Default,,0,0,0,,!انت مزعج كثيراً
Dialogue: 0,0:08:47.27,0:08:48.57,Default,,0,0,0,,...ما هذا.
Dialogue: 0,0:08:55.66,0:08:56.95,Default,,0,0,0,,هل كان ذلك مدفعًا؟
Dialogue: 0,0:08:57.41,0:08:59.87,Default,,0,0,0,,...إذا أصابتني هذه في وجهي
Dialogue: 0,0:09:00.50,0:09:03.92,Default,,0,0,0,,.مواجهته مباشرة ليست فكرة جيدة
Dialogue: 0,0:09:05.13,0:09:06.17,Default,,0,0,0,,!لم تترك لي خيارًا
Dialogue: 0,0:09:08.75,0:09:12.09,Default,,0,0,0,,!أيها الصغير، اقترب وستكون في خطر
Dialogue: 0,0:09:13.13,0:09:13.97,Default,,0,0,0,,!سايكا
Dialogue: 0,0:09:14.80,0:09:15.89,Default,,0,0,0,,!تبًا
Dialogue: 0,0:09:20.10,0:09:22.31,Default,,0,0,0,,،"إذا أردت استعادة الفتاة
Dialogue: 0,0:09:22.48,0:09:26.56,Default,,0,0,0,,."أحضر الكرة الأسطورية إلى قلعة أونيمارو في أوساكا
Dialogue: 0,0:09:26.77,0:09:28.61,Default,,0,0,0,,".الموقّع: إيشيكاوا غويمون"
Dialogue: 0,0:09:29.11,0:09:31.23,Default,,0,0,0,,!لا! توقف عن هذا الجنون
Dialogue: 0,0:09:31.61,0:09:33.78,Default,,0,0,0,,!لا تأخذ هذه الكرة
Dialogue: 0,0:09:34.24,0:09:37.70,Default,,0,0,0,,...أيها الأحمق! إذا لم أستعدها، سايكا سوف
Dialogue: 0,0:09:38.16,0:09:39.12,Default,,0,0,0,,!توقف
Dialogue: 0,0:09:39.33,0:09:43.16,Default,,0,0,0,,!إنها مصدر القوة العظيمة التي تستخدم لختم الشر
Dialogue: 0,0:09:43.33,0:09:45.04,Default,,0,0,0,,!إنها خط دفاعنا الأخير
Dialogue: 0,0:09:45.21,0:09:47.21,Default,,0,0,0,,!يجب التعامل معها بحذر
Dialogue: 0,0:09:47.38,0:09:50.75,Default,,0,0,0,,!استمع إلى خبرتي التي تمتد مئة عام
Dialogue: 0,0:09:51.51,0:09:55.01,Default,,0,0,0,,!لم تتعلم شيئًا في تلك المائة عام التافهة
Dialogue: 0,0:09:56.89,0:10:00.64,Default,,0,0,0,,!إذا كنت تخشى الفشل، فلن تنتصر أبدًا
Dialogue: 0,0:10:06.40,0:10:07.90,Default,,0,0,0,,،أحضروا لي فرشاة
Dialogue: 0,0:10:08.06,0:10:08.61,Default,,0,0,0,,!نعم
Dialogue: 0,0:10:09.94,0:10:12.07,Default,,0,0,0,,ماذا يفعل ذلك العجوز؟
Dialogue: 0,0:10:13.28,0:10:14.44,Default,,0,0,0,,...لا تقل لي أن
Dialogue: 0,0:10:15.03,0:10:17.61,Default,,0,0,0,,!هيا، انظروا
Dialogue: 0,0:10:48.48,0:10:49.48,Default,,0,0,0,,ماذا يفعلون؟
Dialogue: 0,0:10:49.77,0:10:51.19,Default,,0,0,0,,!استقيظ
Dialogue: 0,0:11:12.25,0:11:12.88,Default,,0,0,0,,مرة أخرى؟
Dialogue: 0,0:11:13.05,0:11:14.71,Default,,0,0,0,,!علينا الهروب
Dialogue: 0,0:11:15.51,0:11:16.76,Default,,0,0,0,,.لا تخافوا
Dialogue: 0,0:11:17.22,0:11:18.51,Default,,0,0,0,,.أنا هنا
Dialogue: 0,0:11:26.14,0:11:28.10,Default,,0,0,0,,!رائع جدًا
Dialogue: 0,0:11:29.73,0:11:32.94,Default,,0,0,0,,هل هذا ما كنت تقصده بـ"القوة العظيمة"؟
Dialogue: 0,0:11:35.90,0:11:38.99,Default,,0,0,0,,!هيا، إلى قلعة أونيمارو في أوساكا
Dialogue: 0,0:11:40.07,0:11:41.82,Default,,0,0,0,,!سنقتحمها
Dialogue: 0,0:11:45.95,0:11:48.33,Default,,0,0,0,,{\a6}  نفس اليوم، في أوساكا
Dialogue: 0,0:11:49.21,0:11:51.63,Default,,0,0,0,,!هيا، تعال، كوروغاني يايبا
Dialogue: 0,0:11:51.96,0:11:55.63,Default,,0,0,0,,!العظيم إيشيكاوا غويمون سيعاقبك
Dialogue: 0,0:11:56.09,0:11:57.84,Default,,0,0,0,,!غويمون
Dialogue: 0,0:11:59.17,0:12:01.18,Default,,0,0,0,,...هذا فظيع! انظر
Dialogue: 0,0:12:01.34,0:12:02.47,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:12:02.80,0:12:05.47,Default,,0,0,0,,.هذا إعلان من قسم التحكم في الكوارث
Dialogue: 0,0:12:05.76,0:12:07.52,Default,,0,0,0,,!تقدم! إلى الأمام
Dialogue: 0,0:12:10.94,0:12:12.52,Default,,0,0,0,,ما هذا الهراء؟
Dialogue: 0,0:12:13.56,0:12:15.98,Default,,0,0,0,,.تم إخلاء معظم المدنيين
Dialogue: 0,0:12:16.15,0:12:20.03,Default,,0,0,0,,أخبرني، هل يمكن لهذا التمثال المشي دون تدمير كل شيء؟
Dialogue: 0,0:12:20.70,0:12:21.61,Default,,0,0,0,,...لا أعرف
Dialogue: 0,0:12:21.99,0:12:24.57,Default,,0,0,0,,.هذه المرة الأولى التي أُوقظه فيها
Dialogue: 0,0:12:26.58,0:12:28.16,Default,,0,0,0,,!آسف على الانتظار
Dialogue: 0,0:12:30.29,0:12:34.17,Default,,0,0,0,,!سأسحقك مع هذه القلعة، استعد
Dialogue: 0,0:12:36.96,0:12:38.05,Default,,0,0,0,,!هذا مثير
Dialogue: 0,0:12:38.38,0:12:40.38,Default,,0,0,0,,!حاول إذا استطعت
Dialogue: 0,0:12:40.55,0:12:41.84,Default,,0,0,0,,،لكن
Dialogue: 0,0:12:42.59,0:12:45.55,Default,,0,0,0,,!إذا هزمتني، ستنهي حياة الفتاة أيضًا
Dialogue: 0,0:12:45.72,0:12:46.85,Default,,0,0,0,,!يايبا
Dialogue: 0,0:12:47.72,0:12:49.39,Default,,0,0,0,,!أيها الغشاش الحقير
Dialogue: 0,0:12:51.73,0:12:53.98,Default,,0,0,0,,،إذا أردت استعادتها سالمة
Dialogue: 0,0:12:54.15,0:12:57.48,Default,,0,0,0,,!أعطني سيفك والكرة بهدوء
Dialogue: 0,0:12:58.73,0:13:01.45,Default,,0,0,0,,تبا، أيها الوغد! ألا تهتم بمصير الفتاة؟
Dialogue: 0,0:13:01.61,0:13:04.53,Default,,0,0,0,,!لم أفعل شيئًا! إنه يتحرك وحده
Dialogue: 0,0:13:08.04,0:13:09.58,Default,,0,0,0,,!تبًا، لا يتوقف
Dialogue: 0,0:13:09.87,0:13:12.50,Default,,0,0,0,,....التمثال لا يسمع
Dialogue: 0,0:13:13.25,0:13:15.67,Default,,0,0,0,,!أيها النذل... استعد للأسوأ
Dialogue: 0,0:13:18.42,0:13:20.09,Default,,0,0,0,,!هيا، يا رجل العنكبوت
Dialogue: 0,0:13:27.93,0:13:30.14,Default,,0,0,0,,!%قوة 120
Dialogue: 0,0:13:30.31,0:13:31.43,Default,,0,0,0,,!نحن مستعدون
Dialogue: 0,0:13:31.93,0:13:34.35,Default,,0,0,0,,!أيها الآلي العظيم لقلعة أوساكا
Dialogue: 0,0:13:34.52,0:13:37.31,Default,,0,0,0,,!افتح عينيك وانظر جيدًا
Dialogue: 0,0:13:52.54,0:13:53.91,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:55.54,0:13:58.25,Default,,0,0,0,,.المفاجأة لم تأتِ بعد
Dialogue: 0,0:13:59.17,0:14:00.71,Default,,0,0,0,,النقطة المملوءة
Dialogue: 0,0:14:00.92,0:14:03.42,Default,,0,0,0,,!في حي نانيوا
Dialogue: 0,0:14:12.02,0:14:13.48,Default,,0,0,0,,.لكمة البدائية
Dialogue: 0,0:14:13.89,0:14:16.06,Default,,0,0,0,,،هيا، إذا أردت استعادة الفتاة
Dialogue: 0,0:14:16.23,0:14:19.56,Default,,0,0,0,,!أعطني سيفك والكرة بهدوء
Dialogue: 0,0:14:23.69,0:14:26.20,Default,,0,0,0,,!غويمون، أعظم لص؟ هراء
Dialogue: 0,0:14:26.36,0:14:30.41,Default,,0,0,0,,!تحتاج لرهائن لتحصل على ما تريد
Dialogue: 0,0:14:30.95,0:14:32.49,Default,,0,0,0,,...إذا كنت تريد سيفي بشدة
Dialogue: 0,0:14:35.08,0:14:37.50,Default,,0,0,0,,!فتعال خذه بالقوة
Dialogue: 0,0:14:39.25,0:14:40.38,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:14:40.67,0:14:43.38,Default,,0,0,0,,!أظهر قوتك كاملة! هيا، جرّب
Dialogue: 0,0:14:43.71,0:14:46.43,Default,,0,0,0,,!بل أنا من يجب أن يقول ذلك
Dialogue: 0,0:15:21.38,0:15:24.05,Default,,0,0,0,,!إنها مظلة مصنوعة من المعدن
Dialogue: 0,0:15:24.38,0:15:27.22,Default,,0,0,0,,أتظن أنك ستخدعني مرة أخرى؟
Dialogue: 0,0:16:27.61,0:16:30.53,Default,,0,0,0,,!ما زلتُ عالقةُ داخل هذا الشيء
Dialogue: 0,0:16:30.70,0:16:34.95,Default,,0,0,0,,!أخبريه أن يترُك
Dialogue: 0,0:16:41.75,0:16:43.67,Default,,0,0,0,,من يظن نفسه؟
Dialogue: 0,0:16:45.04,0:16:46.59,Default,,0,0,0,,!ستدفع ثمن هذا
Dialogue: 0,0:16:49.97,0:16:50.97,Default,,0,0,0,,ماذا يفعل؟
Dialogue: 0,0:16:57.72,0:16:59.68,Default,,0,0,0,,!لا يمكنك إصابتي
Dialogue: 0,0:17:05.10,0:17:06.06,Default,,0,0,0,,!الكرة
Dialogue: 0,0:17:09.53,0:17:10.69,Default,,0,0,0,,!إنها لي
Dialogue: 0,0:17:15.78,0:17:17.49,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:17:18.61,0:17:19.54,Default,,0,0,0,,!أخيرًا لحقت بنا
Dialogue: 0,0:17:19.91,0:17:21.54,Default,,0,0,0,,!كوجيرو! كاجيتورا
Dialogue: 0,0:17:21.71,0:17:23.36,Default,,0,0,0,,!يايبا، استغل الفرصة
Dialogue: 0,0:17:23.71,0:17:24.61,Default,,0,0,0,,!نعم
Dialogue: 0,0:17:25.00,0:17:26.46,Default,,0,0,0,,!في أحلامك
Dialogue: 0,0:17:31.55,0:17:32.67,Default,,0,0,0,,!سآخذها معي
Dialogue: 0,0:17:41.85,0:17:43.60,Default,,0,0,0,,!لا مفر الآن
Dialogue: 0,0:17:44.10,0:17:46.31,Default,,0,0,0,,!ستنتهي مسطحًا مثل سيفك
Dialogue: 0,0:17:46.73,0:17:47.69,Default,,0,0,0,,...الوغد
Dialogue: 0,0:17:48.98,0:17:50.57,Default,,0,0,0,,!هذه النهاية
Dialogue: 0,0:17:51.11,0:17:53.20,Default,,0,0,0,,!لم أقل كلمتي الأخيرة
Dialogue: 0,0:17:55.32,0:17:56.32,Default,,0,0,0,,!يايبا
Dialogue: 0,0:17:59.37,0:18:02.04,Default,,0,0,0,,!فطيرة يايبا قادمة
Dialogue: 0,0:18:08.17,0:18:08.96,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:18:24.69,0:18:27.56,Default,,0,0,0,,!لا يصدق! لقد أصبحت ضخمًا
Dialogue: 0,0:18:27.81,0:18:29.27,Default,,0,0,0,,أنا ضخم؟
Dialogue: 0,0:18:32.53,0:18:33.57,Default,,0,0,0,,...رائع
Dialogue: 0,0:18:34.99,0:18:36.91,Default,,0,0,0,,!لدي شيء أيضًا أصبح ضخمًا
Dialogue: 0,0:18:37.07,0:18:39.83,Default,,0,0,0,,!توقف عن قول الهراء
Dialogue: 0,0:18:43.00,0:18:44.91,Default,,0,0,0,,...مؤلم
Dialogue: 0,0:18:47.96,0:18:50.71,Default,,0,0,0,,!خذ هذا
Dialogue: 0,0:18:51.09,0:18:52.92,Default,,0,0,0,,!سأحطمك
Dialogue: 0,0:18:54.09,0:18:55.42,Default,,0,0,0,,!أنت مكشوف تمامًا
Dialogue: 0,0:19:08.02,0:19:09.10,Default,,0,0,0,,!انتظر
Dialogue: 0,0:19:11.98,0:19:13.82,Default,,0,0,0,,!يايبا
Dialogue: 0,0:19:14.19,0:19:17.28,Default,,0,0,0,,أيها الصغير، هل نسيت أن الفتاة هنا؟
Dialogue: 0,0:19:17.53,0:19:20.74,Default,,0,0,0,,!أيها الوغد! واجهني بشرف
Dialogue: 0,0:19:22.49,0:19:24.58,Default,,0,0,0,,!لقد سئمت من وقاحتك
Dialogue: 0,0:19:40.09,0:19:40.68,Default,,0,0,0,,...تبًا
Dialogue: 0,0:19:43.22,0:19:45.52,Default,,0,0,0,,حسنًا، ماذا لديك؟
Dialogue: 0,0:19:59.74,0:20:02.91,Default,,0,0,0,,!ارجع إلى الطفل الصغير الضعيف الذي كنت عليه
Dialogue: 0,0:20:15.59,0:20:16.46,Default,,0,0,0,,.أصمت
Dialogue: 0,0:20:22.34,0:20:25.68,Default,,0,0,0,,!أنت تتباهى أكثر من اللازم
Dialogue: 0,0:20:26.52,0:20:29.10,Default,,0,0,0,,!سأقتلك، استعد
Dialogue: 0,0:20:30.10,0:20:31.81,Default,,0,0,0,,هل فقدت عقلك؟
Dialogue: 0,0:20:31.98,0:20:34.90,Default,,0,0,0,,أتريد أن تترك الفتاة التي تحبها تموت؟
Dialogue: 0,0:20:39.28,0:20:41.03,Default,,0,0,0,,هل تمزح؟
Dialogue: 0,0:20:41.28,0:20:43.82,Default,,0,0,0,,!أنا لست واقعًا في حب هذه القبيحة
Dialogue: 0,0:20:46.58,0:20:48.87,Default,,0,0,0,,"هذه القبيحة"؟
Dialogue: 0,0:20:52.58,0:20:54.38,Default,,0,0,0,,!آسفة لأنني قبيحة
Dialogue: 0,0:20:54.88,0:20:57.67,Default,,0,0,0,,!لماذا فعلتِ ذلك، أيتها القبيحة؟
Dialogue: 0,0:20:58.01,0:20:59.59,Default,,0,0,0,,!ماذا تقصد بأنني قبيحة
Dialogue: 0,0:20:59.76,0:21:01.43,Default,,0,0,0,,ماذا فعلتِ، أيتها العجوز البالية؟
Dialogue: 0,0:21:01.59,0:21:02.80,Default,,0,0,0,,!أيها المنحرف
Dialogue: 0,0:21:07.47,0:21:09.18,Default,,0,0,0,,!لقد هربت
Dialogue: 0,0:21:12.81,0:21:15.31,Default,,0,0,0,,.ساعدتك رغم أني لا أحبك
Dialogue: 0,0:21:16.69,0:21:18.03,Default,,0,0,0,,!حسنًا، اصمت
Dialogue: 0,0:21:18.36,0:21:19.94,Default,,0,0,0,,!تمسكي جيدًا
Dialogue: 0,0:21:25.16,0:21:27.20,Default,,0,0,0,,!تقنية سيف الرعد الخاصة
Dialogue: 0,0:21:33.04,0:21:34.79,Default,,0,0,0,,...ضربة البرق
Dialogue: 0,0:21:35.50,0:21:37.63,Default,,0,0,0,,!الضخمة
Dialogue: 0,0:21:55.10,0:21:56.61,Default,,0,0,0,,!كوروغاني يايبا
Dialogue: 0,0:21:58.07,0:22:01.90,Default,,0,0,0,,!لن تفوز في المرة القادمة! انظر
Dialogue: 0,0:22:03.15,0:22:04.82,Default,,0,0,0,,!لديه كرتي الماء والذهب
Dialogue: 0,0:22:04.99,0:22:08.62,Default,,0,0,0,,!إذا أردت استعادتها، تعال إلى كاواناكاجيما
Dialogue: 0,0:22:08.78,0:22:10.20,Default,,0,0,0,,!سنقاتل هناك
Dialogue: 0,0:22:10.54,0:22:14.62,Default,,0,0,0,,!سنحسم الأمر في المرة القادمة
Dialogue: 0,0:22:14.79,0:22:17.04,Default,,0,0,0,,!أيها الوغد، لن تهرب
Dialogue: 0,0:22:18.75,0:22:19.54,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:22:21.17,0:22:22.67,Default,,0,0,0,,مهلا! يايبا؟
Dialogue: 0,0:22:22.84,0:22:25.88,Default,,0,0,0,,...ماذا؟ جسدي أصبح ثقيلًا فجأة
Dialogue: 0,0:22:27.72,0:22:29.93,Default,,0,0,0,,!ماذا يحدث؟ تماسك
Dialogue: 0,0:22:31.47,0:22:33.35,Default,,0,0,0,,هل عاد حجمه الطبيعي؟
Dialogue: 0,0:22:33.64,0:22:36.77,Default,,0,0,0,,.يايبا والكرة كلاهما انطفأ
Dialogue: 0,0:22:37.02,0:22:40.57,Default,,0,0,0,,.النمو إلى هذا الحجم الضخم استنفذ كل طاقته
Dialogue: 0,0:22:41.32,0:22:43.49,Default,,0,0,0,,.لا تقلقوا بشأن الكرة
Dialogue: 0,0:22:43.78,0:22:46.99,Default,,0,0,0,,.ستعود إلى طبيعتها مع الوقت
Dialogue: 0,0:22:47.66,0:22:51.37,Default,,0,0,0,,...تبا، لا أستطيع الحركة
Dialogue: 0,0:22:59.13,0:23:02.67,Default,,0,0,0,,يايبا؟ هل رأيت شيئًا آخر؟
Dialogue: 0,0:23:03.05,0:23:05.80,Default,,0,0,0,,...نعم، أتساءل ما هذا
Dialogue: 0,0:23:06.43,0:23:10.22,Default,,0,0,0,,.ربما تكون ذكريات مخزنة في الكرة
Dialogue: 0,0:23:10.51,0:23:11.76,Default,,0,0,0,,الذكريات؟
Dialogue: 0,0:23:12.22,0:23:14.89,Default,,0,0,0,,.قوة الكرات لا حدود لها
Dialogue: 0,0:23:15.52,0:23:20.06,Default,,0,0,0,,.ربما ترى ذكريات من امتلكوها
Dialogue: 0,0:23:24.53,0:23:25.99,Default,,0,0,0,,.شكرًا، كوجيرو -\N...لكن -
Dialogue: 0,0:23:27.11,0:23:29.95,Default,,0,0,0,,.المدينة مدمرة تمامًا
Dialogue: 0,0:23:30.28,0:23:34.04,Default,,0,0,0,,...أخشى على المستقبل مع هؤلاء
Dialogue: 0,0:23:37.33,0:23:40.96,Default,,0,0,0,,ما هذا الزي؟ هل هذه مجموعة دراما تاريخية؟
Dialogue: 0,0:23:41.13,0:23:43.42,Default,,0,0,0,,هل هذا الوسيم ممثل؟
Dialogue: 0,0:23:44.09,0:23:45.46,Default,,0,0,0,,تلميذ موساشي؟
Dialogue: 0,0:23:45.67,0:23:48.09,Default,,0,0,0,,".في الحلقة القادمة: "رجل المدرسة الجديدة للظل
Dialogue: 0,0:23:48.26,0:23:51.47,Default,,0,0,0,,{\a6}الحلقة 17: رجل المدرسة الجديدة للظل
Dialogue: 0,0:23:48.43,0:23:51.39,Default,,0,0,0,,حقًا، هذا الرجل تلميذي؟
