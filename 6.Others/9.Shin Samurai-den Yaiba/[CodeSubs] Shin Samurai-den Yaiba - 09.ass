Dialogue: 0,0:00:00.00,0:00:03.90,DCDialogRedName,,0,0,0,,{\fs110\pos(959,629)\fnAl-Jazeera-Arabic-Bold}CodeSubs :ترجمة وتدقيق\N{\fs80}linktr.ee/CodeSubs
Dialogue: 0,0:00:02.25,0:00:03.84,DC,,0,0,0,,‫لقد عدت~!
Dialogue: 0,0:00:03.84,0:00:06.30,DC,,0,0,0,,‫سـ... ساياكا~!
Dialogue: 0,0:00:07.26,0:00:08.80,DC,,0,0,0,,‫أنا سعيد أنكِ بخير.
Dialogue: 0,0:00:08.80,0:00:11.18,DC,,0,0,0,,‫لقد عدت، أبي، أمي.
Dialogue: 0,0:00:13.64,0:00:14.81,DC,,0,0,0,,‫أنا جائع جدًا.
Dialogue: 0,0:00:14.81,0:00:16.18,DC,,0,0,0,,‫وأنا متعب.
Dialogue: 0,0:00:16.18,0:00:17.56,DC,,0,0,0,,!بالفعل
Dialogue: 0,0:00:17.56,0:00:22.06,DC,,0,0,0,,‫ما إن اعتقدتُ أن الفتاة الشقية قررت أخيراً العودة إلى المنزل...
Dialogue: 0,0:00:22.06,0:00:24.48,DC,,0,0,0,,من أنتم يا هؤلاء!؟
Dialogue: 0,0:00:24.48,0:00:26.78,DC,,0,0,0,,!يا جدتي، دعيني أقدمهم لكِ
Dialogue: 0,0:00:27.36,0:00:31.20,DC,,0,0,0,,...هذا هو غيروزايمون ورجل خيار البحر و
Dialogue: 0,0:00:31.74,0:00:35.45,DC,,0,0,0,,!وهذا الشخص هو مياموتو موساشي الشهير
Dialogue: 0,0:00:36.41,0:00:39.83,DC,,0,0,0,,‫أنتِ تمزحين! أتعنين مبتكر أسلوب السيفين؟!
Dialogue: 0,0:00:39.83,0:00:41.92,DC,,0,0,0,,‫أ-أنت، أنت، أنت...
Dialogue: 0,0:00:41.92,0:00:47.26,DC,,0,0,0,,‫أتخبرينني أن هذا العجوز الضعيف هو مياموتو موساشي العظيم؟!
Dialogue: 0,0:00:48.42,0:00:50.80,DC,,0,0,0,,!وأنتِ أيضًا عجوز متهالكة
Dialogue: 0,0:00:50.80,0:00:53.14,DC,,0,0,0,,!موساشي عمره 400 عام بالفعل
Dialogue: 0,0:00:54.93,0:00:59.27,DC,,0,0,0,,‫أهذا هو موساشي-ساما الذي كنت معجبةً به وكان بطلي؟
Dialogue: 0,0:01:01.77,0:01:03.10,DC,,0,0,0,,‫جدتي!
Dialogue: 0,0:01:05.23,0:01:06.70,DC,,0,0,0,,!لـ... لماذا
Dialogue: 0,0:01:06.70,0:01:09.32,DC,,0,0,0,,لماذا كوجيرو هنا!؟
Dialogue: 0,0:01:11.82,0:01:14.36,DC,,0,0,0,,.لقد التقينا به في البلدة
Dialogue: 0,0:01:14.37,0:01:17.74,DC,,0,0,0,,!عندما قلنا له أننا نعرفك، قال إنه يريد أن يتحدث معك
Dialogue: 0,0:01:18.41,0:01:21.58,DC,,0,0,0,,!حسنًا، لا أستطيع مقاومة السيدات الجميلات اللاتي يرتدين الكيمونو
Dialogue: 0,0:01:23.96,0:01:26.54,DC,,0,0,0,,!ما زلتَ محبًا للنساء كعادتك
Dialogue: 0,0:01:26.54,0:01:29.42,DC,,0,0,0,,ما الذي تنوي فعله بحضورك هنا؟
Dialogue: 0,0:01:29.42,0:01:31.84,DC,,0,0,0,,!لا نية لي في القتال
Dialogue: 0,0:01:31.84,0:01:33.30,DC,,0,0,0,,‫أنا مجرد صديق قديم،
Dialogue: 0,0:01:33.30,0:01:34.47,DC,,0,0,0,,.فلا داعي للقلق
Dialogue: 0,0:01:35.14,0:01:36.97,DC,,0,0,0,,!لكنني ببساطة لا أجد مكانًا آخر أذهب إليه
Dialogue: 0,0:01:36.97,0:01:38.93,DC,,0,0,0,,!ما باليد حيلة
Dialogue: 0,0:01:40.98,0:01:42.06,DC,,0,0,0,,{\i1}‫سيف حاكم الرعد (رايجينكين)...{\i}
Dialogue: 0,0:01:43.02,0:01:44.98,DC,,0,0,0,,{\i1}‫لو حصلتُ على ذلك السيف فقط،{\i}
Dialogue: 0,0:01:44.98,0:01:47.65,DC,,0,0,0,,{\i1}.سأصبح الساموراي رقم واحد في العالم{\i}
Dialogue: 0,0:01:48.40,0:01:51.36,DC,,0,0,0,,{\i1}‫أعظم ساموراي في العالم!{\i}
Dialogue: 0,0:02:03.87,0:02:06.13,DCDialogRedName,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:03:21.99,0:03:26.92,DCNN,,0,0,0,,{\pos(960,1000.0)}‫الحلقة 9: مـيـلاد ضـربـة الـرعـد
Dialogue: 0,0:03:27.46,0:03:29.83,DC,,0,0,0,,تلك الشياطين والوحوش ما كانوا شيئًا يُذكر
Dialogue: 0,0:03:29.83,0:03:32.38,DC,,0,0,0,,‫بالنسبة إلى يايبا وحركة سيف المروحة (سنبوكين) التي ينفذها!
Dialogue: 0,0:03:32.38,0:03:34.51,DC,,0,0,0,,‫لقد كان قويًا جدًا!
Dialogue: 0,0:03:35.05,0:03:36.76,DC,,0,0,0,,،أوه، ساياكا
Dialogue: 0,0:03:36.76,0:03:39.47,DC,,0,0,0,,‫لقد كنت تتحدثين عن يايبا-كن طوال هذا الوقت.
Dialogue: 0,0:03:39.47,0:03:41.18,DC,,0,0,0,,‫حسنًا، بسبب أنه...
Dialogue: 0,0:03:41.76,0:03:43.60,DC,,0,0,0,,‫كان قويًا إلى حد ما.
Dialogue: 0,0:03:44.10,0:03:45.02,DC,,0,0,0,,‫فقط قليلًا...
Dialogue: 0,0:03:47.19,0:03:52.07,DC,,0,0,0,,إذن، هذا السيف الذي تحمله على ظهرك، هل هو السيف الشيطاني الأسطوري الذي كان كينجورو يتحدث عنه؟
Dialogue: 0,0:03:53.78,0:03:57.07,DC,,0,0,0,,‫لقد سمعت أن مجرد لمس النصل يكاد يكون مستحيلاً.
Dialogue: 0,0:03:57.07,0:04:01.03,DC,,0,0,0,,!أن تتمكن من استخدام سيف كهذا... يبدو أنك قد نضجت
Dialogue: 0,0:04:02.62,0:04:05.91,DC,,0,0,0,,‫بسيف حاكم الرعد (رايجينكين) هذا، سأُسحق أونيمارو!
Dialogue: 0,0:04:07.00,0:04:10.21,DC,,0,0,0,,‫من أنت لتقول ذلك وأنت لا تستطيع التحكم فيه بالكامل؟
Dialogue: 0,0:04:10.21,0:04:13.46,DC,,0,0,0,,لماذا لا تتدرب أو تتعلم تقنيات جديدة أو شيء من هذا القبيل؟
Dialogue: 0,0:04:13.46,0:04:14.42,DC,,0,0,0,,!يا لك من أحمق
Dialogue: 0,0:04:16.01,0:04:17.46,DC,,0,0,0,,{\i1}‫تقنيات جديدة؟!{\i}
Dialogue: 0,0:04:17.47,0:04:18.84,DC,,0,0,0,,‫حسنًا!
Dialogue: 0,0:04:18.84,0:04:22.05,DC,,0,0,0,,!سأفكر في تقنية جديدة رائعة، وسأصبح أقوى
Dialogue: 0,0:04:22.80,0:04:24.89,DC,,0,0,0,,!إذا قررت ذلك، فابدأ التدريب فوراً
Dialogue: 0,0:04:24.89,0:04:25.81,DC,,0,0,0,,!أجل
Dialogue: 0,0:04:25.81,0:04:27.68,DC,,0,0,0,,أولًا، بعض الطعام
Dialogue: 0,0:04:27.68,0:04:30.40,DC,,0,0,0,,!الأكل جزء من التدريب أيضًا
Dialogue: 0,0:04:30.77,0:04:31.69,DC,,0,0,0,,!حسنًا
Dialogue: 0,0:04:33.48,0:04:35.94,DC,,0,0,0,,.تكاليف الطعام سوف تزداد
Dialogue: 0,0:04:35.94,0:04:37.82,DC,,0,0,0,,!إنه متحمس
Dialogue: 0,0:04:37.82,0:04:38.95,DC,,0,0,0,,‫نعم.
Dialogue: 0,0:04:39.40,0:04:42.70,DC,,0,0,0,,.من الواضح أنه لم يكن يكتفي بتطوير مهاراته في السيف فقط
Dialogue: 0,0:04:42.70,0:04:43.78,DC,,0,0,0,,!أجل
Dialogue: 0,0:04:46.91,0:04:50.83,DC,,0,0,0,,{\i1}‫يجب أن أتصرف قبل أن يصبح مصدر إزعاج أكبر.{\i}
Dialogue: 0,0:04:56.00,0:04:57.09,DC,,0,0,0,,!استمع يا يايبا
Dialogue: 0,0:04:57.09,0:05:00.88,DC,,0,0,0,,!لا يجب أن يسمح النينجا للآخرين بملاحظة وجوده
Dialogue: 0,0:05:00.88,0:05:01.80,DC,,0,0,0,,!أجل
Dialogue: 0,0:05:02.47,0:05:04.30,DC,,0,0,0,,،لا أفهم هذا التدريب جيدًا
Dialogue: 0,0:05:04.30,0:05:05.93,DC,,0,0,0,,!ولكنه مهم أيضًا، أليس كذلك؟
Dialogue: 0,0:05:05.93,0:05:09.68,DC,,0,0,0,,‫بالضبط! إخفاء وجودك أمر مهم للغاية!
Dialogue: 0,0:05:09.68,0:05:14.02,DC,,0,0,0,,!إذا تم رصد وجودك، حتى لو كانت لديك تقنيات جيدة، فلن تستطيع استخدامها
Dialogue: 0,0:05:15.11,0:05:16.65,DC,,0,0,0,,‫هيا! اتبعني!
Dialogue: 0,0:05:17.48,0:05:18.61,DC,,0,0,0,,‫حسنًا!
Dialogue: 0,0:05:22.55,0:05:24.65,DCAgain,,0,0,0,,{\pos(544,798)}~~~~
Dialogue: 0,0:05:25.28,0:05:27.45,DC,,0,0,0,,!ها~؟ هذا غريب
Dialogue: 0,0:05:37.50,0:05:43.90,DCAgain,,0,0,0,,{\pos(1292.8,959.6)}~
Dialogue: 0,0:05:38.17,0:05:41.63,DC,,0,0,0,,‫ها؟ شعرتُ أن هناك شخصًا ما...
Dialogue: 0,0:05:42.22,0:05:43.80,DC,,0,0,0,,هل كنت أتخيل ذلك؟
Dialogue: 0,0:05:47.85,0:05:50.52,DC,,0,0,0,,ماذا حدث بالضبط؟
Dialogue: 0,0:05:50.52,0:05:53.85,DC,,0,0,0,,‫لقد أصبحنا متحمسين قليلًا في تدريبنا.
Dialogue: 0,0:05:54.35,0:05:56.90,DC,,0,0,0,,.لا بد أنه كان يتلصص على حمّامٍ ما، أو شيء من هذا القبيل
Dialogue: 0,0:05:56.90,0:05:58.36,DC,,0,0,0,,!هذا ليس صحيحًا
Dialogue: 0,0:05:59.03,0:06:01.57,DC,,0,0,0,,!يا له من تدريب شاق
Dialogue: 0,0:06:02.07,0:06:05.28,DC,,0,0,0,,‫إذن، هل ابتكرت تقنية جديدة؟
Dialogue: 0,0:06:12.62,0:06:15.29,DC,,0,0,0,,مـ... ماذا هناك؟
Dialogue: 0,0:06:15.29,0:06:16.67,DC,,0,0,0,,‫هذا هو!
Dialogue: 0,0:06:17.21,0:06:18.04,DC,,0,0,0,,‫آه!
Dialogue: 0,0:06:18.04,0:06:20.25,DC,,0,0,0,,!لقد توصلتُ إلى فكرة رائعة
Dialogue: 0,0:06:24.97,0:06:26.51,DC,,0,0,0,,!ها أنا ذا يا موساشي
Dialogue: 0,0:06:27.05,0:06:28.10,DC,,0,0,0,,‫حسنًا،
Dialogue: 0,0:06:28.10,0:06:29.35,DC,,0,0,0,,‫أرني إياها!
Dialogue: 0,0:06:29.35,0:06:31.31,DC,,0,0,0,,!هيا بنا
Dialogue: 0,0:06:31.97,0:06:33.43,DC,,0,0,0,,...سأسميها
Dialogue: 0,0:06:33.43,0:06:34.35,DC,,0,0,0,,‫ماذا...؟!
Dialogue: 0,0:06:35.56,0:06:38.82,DC,,0,0,0,,‫سيف الضوء الساطع لـ يايبا!
Dialogue: 0,0:06:41.40,0:06:42.78,DC,,0,0,0,,ما رأيك! رائع، أليس كذلك؟
Dialogue: 0,0:06:43.24,0:06:44.44,DC,,0,0,0,,!أيها الأحمق
Dialogue: 0,0:06:44.45,0:06:47.53,DC,,0,0,0,,!مثل هذه التقنية لن تعمل في وضح النهار
Dialogue: 0,0:06:47.53,0:06:49.49,DC,,0,0,0,,‫أوه، صحيح.
Dialogue: 0,0:06:49.49,0:06:53.83,DC,,0,0,0,,!يا إلهي... حتى تتمكن من ابتكار تقنية جديدة، ستبقى بدون طعام
Dialogue: 0,0:06:53.83,0:06:56.33,DC,,0,0,0,,!لـ... لحظة! انتظر
Dialogue: 0,0:06:56.33,0:06:57.46,DC,,0,0,0,,!مـ... مهلاً
Dialogue: 0,0:06:57.96,0:07:00.71,DC,,0,0,0,,‫يبدو أنه سيستغرق بعض الوقت.
Dialogue: 0,0:07:00.71,0:07:01.63,DC,,0,0,0,,‫نعم.
Dialogue: 0,0:07:05.13,0:07:07.59,DC,,0,0,0,,...أن يستخدم الضوء لإعماء العيون
Dialogue: 0,0:07:09.55,0:07:12.68,DC,,0,0,0,,!يـ... يا لها من تقنية مرعبة
Dialogue: 0,0:07:20.02,0:07:23.53,DC,,0,0,0,,‫لقد كان يايبا هكذا منذ الليلة الماضية.
Dialogue: 0,0:07:24.15,0:07:26.57,DC,,0,0,0,,‫يا لها من قوة تركيز عظيمة لديه!
Dialogue: 0,0:07:26.57,0:07:30.45,DC,,0,0,0,,...إذا فعلتُ هذا بهذه الطريقة، فسيأتي الخصم من هذا الاتجاه
Dialogue: 0,0:07:32.70,0:07:34.91,DC,,0,0,0,,‫أنا جائع جدًا.
Dialogue: 0,0:07:34.91,0:07:36.21,DC,,0,0,0,,‫يايبا!
Dialogue: 0,0:07:38.33,0:07:39.17,DC,,0,0,0,,،تفضل
Dialogue: 0,0:07:39.17,0:07:40.71,DC,,0,0,0,,‫يجب أن تكون جائعًا، أليس كذلك؟
Dialogue: 0,0:07:42.96,0:07:44.46,DC,,0,0,0,,‫كرات الأرز!
Dialogue: 0,0:07:46.09,0:07:49.47,DC,,0,0,0,,{\i1}!حتى تتمكن من ابتكار تقنية جديدة، ستبقى بدون طعام{\i}
Dialogue: 0,0:07:50.05,0:07:52.18,DC,,0,0,0,,.لا... لا أريد هذا الشيء
Dialogue: 0,0:07:52.68,0:07:53.68,DC,,0,0,0,,‫لماذا؟
Dialogue: 0,0:07:54.18,0:07:58.64,DC,,0,0,0,,‫أريد هزيمة أونيمارو وأطمح أن أكون أفضل ساموراي في اليابان، لذلك يجب أن أفكر في تقنية!
Dialogue: 0,0:07:59.19,0:08:03.07,DC,,0,0,0,,‫ليس لدي وقت لأضيعه في كرات الأرز، أيتها الحمقاء!
Dialogue: 0,0:08:03.57,0:08:06.11,DC,,0,0,0,,‫يا إلهي، إنه عنيد جدًا!
Dialogue: 0,0:08:06.65,0:08:09.70,DC,,0,0,0,,!أوه! لقد توصلتُ إلى تقنية جديدة
Dialogue: 0,0:08:11.24,0:08:13.12,DCHint-xOpacity,,0,0,0,,{\an8}‫لقد حصل تلاعب لفظي بين كلمة "Onigiri" التي تعني "كرات الأرز"، وبين كلمتي "Oni" (شيطان) و"Giri" (قطع) لتكوين التعبير "Oni Giri" الذي يعني "قطع الشيطان" كاسم تقنية قتالية، حيث يُقارب نطق هذه الكلمة كلمة "Onigiri" تمامًا، مما يصنع مفارقة هزلية بين موضوع الطعام البسيط والقوة القتالية، ليضيف بعدًا فكاهيًا للمشهد.
Dialogue: 0,0:08:11.24,0:08:12.20,DC,,0,0,0,,‫قاطع كرات...
Dialogue: 0,0:08:12.20,0:08:13.12,DC,,0,0,0,,!الأرز
Dialogue: 0,0:08:15.70,0:08:17.66,DC,,0,0,0,,‫لا أعلم لماذا، لكن هذا مضحك للغاية!
Dialogue: 0,0:08:18.50,0:08:20.00,DC,,0,0,0,,‫قاطع كرات الأرز!
Dialogue: 0,0:08:21.21,0:08:24.63,DC,,0,0,0,,!لا تزعجوني
Dialogue: 0,0:08:25.76,0:08:27.09,DC,,0,0,0,,‫يا إلهي...
Dialogue: 0,0:08:32.35,0:08:34.51,DC,,0,0,0,,‫إذا قمت بالضرب مباشرة لأسفل...
Dialogue: 0,0:08:35.60,0:08:37.64,DC,,0,0,0,,!سيتم تفاديها بسهولة
Dialogue: 0,0:08:39.06,0:08:41.31,DC,,0,0,0,,...لأجعله غير قادر على تفاديها
Dialogue: 0,0:08:56.08,0:08:57.04,DC,,0,0,0,,‫هذا...
Dialogue: 0,0:08:58.25,0:09:00.08,DC,,0,0,0,,‫هذا هو!
Dialogue: 0,0:09:07.55,0:09:10.76,DC,,0,0,0,,‫عذراً، ولكن... كم من الوقت تخطط للبقاء؟
Dialogue: 0,0:09:10.76,0:09:13.30,DC,,0,0,0,,‫نحن أصدقاء قدامى. لا داعي لأن تكون غاضباً هكذا.
Dialogue: 0,0:09:13.30,0:09:14.97,DC,,0,0,0,,‫ها أنت مرة أخرى...
Dialogue: 0,0:09:14.97,0:09:16.72,DC,,0,0,0,,‫حسناً، استعد يا موساشي!
Dialogue: 0,0:09:16.72,0:09:19.10,DC,,0,0,0,,!لقد فكرتُ في ثلاث تقنيات جديدة
Dialogue: 0,0:09:19.10,0:09:20.94,DC,,0,0,0,,...الأولى هي
Dialogue: 0,0:09:23.15,0:09:26.19,DC,,0,0,0,,!ضربة الأمطار المنهمرة لـِ يايبا
Dialogue: 0,0:09:29.86,0:09:30.99,DC,,0,0,0,,‫ماذا تعتقد؟
Dialogue: 0,0:09:32.49,0:09:33.70,DC,,0,0,0,,!أيها الأحمق
Dialogue: 0,0:09:33.70,0:09:35.66,DC,,0,0,0,,!هذا لا يمكن أن يُدعى تقنية
Dialogue: 0,0:09:36.70,0:09:38.37,DC,,0,0,0,,!فـ... فهمتُ
Dialogue: 0,0:09:39.12,0:09:40.75,DC,,0,0,0,,!إذاً، التالية! التالية
Dialogue: 0,0:09:43.33,0:09:44.33,DC,,0,0,0,,‫شاهد هذا!
Dialogue: 0,0:09:44.33,0:09:46.79,DC,,0,0,0,,!ضربة البوميرانج القاطعة لـِ يايبا
Dialogue: 0,0:09:44.33,0:09:46.79,DCHint-xOpacity,,0,0,0,,{\an8}‫البوميرانج أداة أو سلاح على شكل منحني يُرمى في الهواء فيدور ويعود إلى راميها إذا أُطلق بطريقة صحيحة. لمعرفة شكلها، ابحث في جوجل.
Dialogue: 0,0:09:46.79,0:09:47.96,DC,,0,0,0,,‫بو...؟
Dialogue: 0,0:09:47.96,0:09:49.42,DC,,0,0,0,,البوميرانج القاطعة؟
Dialogue: 0,0:10:02.31,0:10:03.77,DC,,0,0,0,,‫ما هذا...؟!
Dialogue: 0,0:10:04.23,0:10:05.77,DC,,0,0,0,,!إنها بالتأكيد تشبه البوميرانج
Dialogue: 0,0:10:12.49,0:10:13.36,DC,,0,0,0,,!أيها الأحمق
Dialogue: 0,0:10:13.36,0:10:16.12,DC,,0,0,0,,!ما الذي ستفعله إذا أُغمي عليك
Dialogue: 0,0:10:17.53,0:10:18.53,DC,,0,0,0,,!هذا سخيف
Dialogue: 0,0:10:18.53,0:10:20.79,DC,,0,0,0,,!مهلًا، لم أنتهِ بعد
Dialogue: 0,0:10:21.58,0:10:22.66,DC,,0,0,0,,!تبًا
Dialogue: 0,0:10:22.66,0:10:24.71,DC,,0,0,0,,!إذاً سأريك أفضل ما لدي
Dialogue: 0,0:10:29.75,0:10:31.55,DC,,0,0,0,,‫سيف حاكم الرعد (رايجينكين) الخالي من الجوهرة:
Dialogue: 0,0:10:33.55,0:10:35.38,DC,,0,0,0,,!القطع الرعدي
Dialogue: 0,0:10:48.86,0:10:51.32,DC,,0,0,0,,{\i1}‫مـ... ما هذه التقنية؟!{\i}
Dialogue: 0,0:10:54.32,0:10:55.91,DC,,0,0,0,,.كما توقعت، لا فائدة
Dialogue: 0,0:10:56.57,0:10:59.53,DC,,0,0,0,,!لا... لقد اقتربتَ كثيرًا هذه المرة
Dialogue: 0,0:10:59.53,0:11:00.74,DC,,0,0,0,,‫ح-حقاً؟!
Dialogue: 0,0:11:01.16,0:11:03.29,DC,,0,0,0,,.لا زلتَ بعيدًا عن المستوى المطلوب
Dialogue: 0,0:11:03.29,0:11:04.75,DC,,0,0,0,,!تبًا
Dialogue: 0,0:11:04.75,0:11:06.58,DC,,0,0,0,,‫إذن سأحاول مرة أخرى!
Dialogue: 0,0:11:07.33,0:11:12.09,DC,,0,0,0,,{\i1}‫هذا الفتى يتحسن بشكل ملحوظ بفضل التدريب اليومي!{\i}
Dialogue: 0,0:11:12.67,0:11:14.80,DC,,0,0,0,,{\i1}‫أنا متأكد أنه لن يمضي وقت طويل{\i}
Dialogue: 0,0:11:14.80,0:11:17.80,DC,,0,0,0,,{\i1}‫قبل أن يتمكن من التحكم في سيف حاكم الرعد (رايجينكين).{\i}
Dialogue: 0,0:11:19.22,0:11:21.76,DC,,0,0,0,,{\i1}‫يجب أن أحصل على سيف حاكم الرعد (رايجينكين){\i}
Dialogue: 0,0:11:22.22,0:11:25.02,DC,,0,0,0,,{\i1}.قبل أن يتقن هذه التقنية تمامًا{\i}
Dialogue: 0,0:11:34.94,0:11:37.49,DC,,0,0,0,,‫جيد، يجب أن يكون هذا كافياً.
Dialogue: 0,0:11:37.49,0:11:38.78,DC,,0,0,0,,‫ها أنا قادم!
Dialogue: 0,0:11:38.78,0:11:39.70,DC,,0,0,0,,‫انطلق!
Dialogue: 0,0:11:42.74,0:11:44.54,DC,,0,0,0,,‫سيف حاكم الرعد (رايجينكين) الخالي من الجوهرة:
Dialogue: 0,0:11:45.08,0:11:46.41,DC,,0,0,0,,!القطع الرعدي
Dialogue: 0,0:11:57.88,0:12:01.10,DC,,0,0,0,,‫واحد... اثنان... ثلاثة... أربعة...
Dialogue: 0,0:12:02.76,0:12:04.35,DC,,0,0,0,,!هذا لا ينفع، لا ينفع
Dialogue: 0,0:12:04.35,0:12:06.64,DC,,0,0,0,,‫لم تقطع إلا ثلاثة عشر قطعة!
Dialogue: 0,0:12:06.64,0:12:09.56,DC,,0,0,0,,‫إذن كم يجب أن أقطع؟!
Dialogue: 0,0:12:09.56,0:12:11.15,DC,,0,0,0,,‫دعنا نرى...
Dialogue: 0,0:12:11.81,0:12:13.40,DC,,0,0,0,,‫مع خيزران بهذا الحجم...
Dialogue: 0,0:12:13.90,0:12:16.40,DC,,0,0,0,,‫يجب أن تقطع أربعة أضعاف ذلك، حوالي خمسين قطعة!
Dialogue: 0,0:12:16.40,0:12:18.07,DC,,0,0,0,,‫خ-خمسين؟!
Dialogue: 0,0:12:18.65,0:12:21.70,DC,,0,0,0,,وبالإضافة إلى ذلك، ما هذه الطريقة في القطع؟
Dialogue: 0,0:12:21.70,0:12:25.45,DC,,0,0,0,,!زد من سرعة دوران معصمك واقطع بشكل أفقي
Dialogue: 0,0:12:25.91,0:12:27.37,DC,,0,0,0,,‫أفقي؟
Dialogue: 0,0:12:28.54,0:12:30.50,DC,,0,0,0,,‫هيا، الآن افعلها، يا يايبا!
Dialogue: 0,0:12:30.50,0:12:33.17,DC,,0,0,0,,!أتقن القطع الرعدي
Dialogue: 0,0:12:33.17,0:12:34.09,DC,,0,0,0,,!حسنًا
Dialogue: 0,0:12:36.01,0:12:37.21,DC,,0,0,0,,‫ماذا تفعل؟!
Dialogue: 0,0:12:37.21,0:12:38.76,DC,,0,0,0,,‫بهذه الوتيرة،
Dialogue: 0,0:12:38.76,0:12:41.72,DC,,0,0,0,,!مسألة وقت فقط قبل أن يتعب
Dialogue: 0,0:12:42.26,0:12:44.68,DC,,0,0,0,,‫سأنتظر حتى يتعب،
Dialogue: 0,0:12:45.60,0:12:47.60,DC,,0,0,0,,‫ثم سأخذ سيف حاكم الرعد (رايجينكين)!
Dialogue: 0,0:12:48.31,0:12:49.77,DC,,0,0,0,,‫- كل ما يفعله رائعٌ للغاية!\N‫- أرجوك، سيطر علينا من جديد ♡\N‫- أونيمارو-ساما هو أميرُنا في العصر الحديث!\N‫- أسرِعْ وسيطر علينا!\N‫- يا له من جسد رائع!
Dialogue: 0,0:12:49.77,0:12:50.98,DC,,0,0,0,,‫- أسرِعْ وسيطر علينا!\N‫- يا له من جسد رائع!\N‫- أمل العصر الحديث!\N‫- قرناه الاثنان ساحران حقًا ♡\N‫- إنه كوول للغاية!
Dialogue: 0,0:12:50.98,0:12:52.06,DC,,0,0,0,,‫- قرناه الاثنان ساحران حقًا ♡\N‫- إنه كوول للغاية!\N‫- أونيمارو هو الأفضل!!!!!\N‫- سأتبعك مدى الحياة!!
Dialogue: 0,0:12:52.50,0:12:53.69,DC,,0,0,0,,‫أونيمارو-ساما!
Dialogue: 0,0:12:54.23,0:12:58.11,DC,,0,0,0,,!خطتي لاستدراجهم تسير على ما يرام
Dialogue: 0,0:12:58.90,0:13:01.36,DC,,0,0,0,,‫إنني أعتمد عليك، يا رجل العنكبوت.
Dialogue: 0,0:13:01.36,0:13:02.57,DC,,0,0,0,,‫نعم، سيدي.
Dialogue: 0,0:13:02.57,0:13:05.08,DC,,0,0,0,,!سأنشرها في كل مكان
Dialogue: 0,0:13:09.46,0:13:12.04,DC,,0,0,0,,!هذه المرة، سأنهي الأمر بالتأكيد
Dialogue: 0,0:13:20.42,0:13:23.80,DC,,0,0,0,,...‫لقد أصبحت قريبة من الشكل المطلوب، ولكن
Dialogue: 0,0:13:23.80,0:13:25.43,DC,,0,0,0,,!لا يزال هناك نقص بسيط
Dialogue: 0,0:13:26.31,0:13:27.18,DC,,0,0,0,,!تبًا
Dialogue: 0,0:13:28.18,0:13:31.18,DC,,0,0,0,,!سرعة القطع لا تزال ضعيفة
Dialogue: 0,0:13:31.19,0:13:34.69,DC,,0,0,0,,!لكن جودة القطع المقطوعة أصبحت أفضل
Dialogue: 0,0:13:34.69,0:13:39.03,DC,,0,0,0,,‫عدا ذلك، لا يمكننا الجزم بشيء دون معركة حقيقية بالسيوف.
Dialogue: 0,0:13:42.78,0:13:44.11,DC,,0,0,0,,‫أنا متعب جدًا...
Dialogue: 0,0:13:45.03,0:13:46.24,DC,,0,0,0,,{\i1}‫الآن فرصتي!{\i}
Dialogue: 0,0:13:53.21,0:13:54.12,DC,,0,0,0,,!لقد حصلتُ عليه
Dialogue: 0,0:13:54.12,0:13:55.88,DC,,0,0,0,,!ماذا تفعل؟ كوجيرو
Dialogue: 0,0:13:55.88,0:13:58.63,DC,,0,0,0,,...إيه!؟ آه، حسنًا
Dialogue: 0,0:13:58.63,0:14:00.92,DC,,0,0,0,,‫لماذا تتسلل؟
Dialogue: 0,0:14:00.92,0:14:02.76,DC,,0,0,0,,‫ي-يايبا-دونو!
Dialogue: 0,0:14:03.43,0:14:05.01,DC,,0,0,0,,!لا بد أنك تعرقت كثيرًا
Dialogue: 0,0:14:05.01,0:14:06.55,DC,,0,0,0,,!تفضل، لقد جلبت لك منشفة
Dialogue: 0,0:14:08.56,0:14:10.35,DC,,0,0,0,,{\i1}‫لقد رآني قادمًا...{\i}
Dialogue: 0,0:14:10.98,0:14:12.60,DC,,0,0,0,,{\i1}‫لقد قللت من شأنه.{\i}
Dialogue: 0,0:14:13.10,0:14:14.77,DC,,0,0,0,,{\i1}‫في المرة القادمة بالتأكيد!{\i}
Dialogue: 0,0:14:14.77,0:14:17.73,DC,,0,0,0,,‫- لا يجب أن تصاب بالبرد، يايبا.\N‫- مهلاً، توقف! هذا يؤلم!
Dialogue: 0,0:14:21.94,0:14:24.07,DC,,0,0,0,,‫هذا ثقيل...
Dialogue: 0,0:14:24.70,0:14:27.70,DC,,0,0,0,,{\i1}‫حسنًا، بينما يداه مشغولتان بحمل الأمتعة،{\i}
Dialogue: 0,0:14:27.70,0:14:29.37,DC,,0,0,0,,{\i1}‫الآن فرصتي!{\i}
Dialogue: 0,0:14:33.91,0:14:35.54,DC,,0,0,0,,‫أوه، كوجيرو-سان.
Dialogue: 0,0:14:35.54,0:14:37.38,DC,,0,0,0,,‫هل جئت للمساعدة؟
Dialogue: 0,0:14:37.38,0:14:39.17,DC,,0,0,0,,‫هذا لطيف جدًا!
Dialogue: 0,0:14:47.97,0:14:49.56,DC,,0,0,0,,...بينما هو نائم
Dialogue: 0,0:14:51.27,0:14:53.68,DC,,0,0,0,,!مهلًا، قطعة اللحم هذه لي
Dialogue: 0,0:14:58.27,0:14:59.69,DC,,0,0,0,,...تبًا لك
Dialogue: 0,0:15:00.98,0:15:03.53,DC,,0,0,0,,!يايبا-دونو، لا بد أنك متعب
Dialogue: 0,0:15:03.53,0:15:05.11,DC,,0,0,0,,‫ماذا عن حمام مريح؟
Dialogue: 0,0:15:05.11,0:15:06.53,DC,,0,0,0,,‫أوه، حسنًا.
Dialogue: 0,0:15:07.36,0:15:08.41,DC,,0,0,0,,{\i1}‫نعم!{\i}
Dialogue: 0,0:15:08.87,0:15:11.74,DC,,0,0,0,,{\i1}.بينما هو في الحمام، سآخذ السيف بسرعة وأهرب{\i}
Dialogue: 0,0:15:13.75,0:15:14.83,DC,,0,0,0,,‫أنت...
Dialogue: 0,0:15:15.46,0:15:18.79,DC,,0,0,0,,هل تحمل السيف حتى عندما تدخل الحمام؟
Dialogue: 0,0:15:18.79,0:15:20.88,DC,,0,0,0,,!هاه؟ نعم، هذا صحيح
Dialogue: 0,0:15:20.88,0:15:24.80,DC,,0,0,0,,{\i1}‫تقول التقارير أنه طالب في المدرسة الإعدادية.{\i}
Dialogue: 0,0:15:24.80,0:15:27.47,DC,,0,0,0,,‫- ما بكم جميعًا؟\N‫- المزيد من التفاصيل قادمة...
Dialogue: 0,0:15:27.47,0:15:28.59,DC,,0,0,0,,‫يايبا.
Dialogue: 0,0:15:28.59,0:15:30.55,DC,,0,0,0,,...هذا
Dialogue: 0,0:15:30.60,0:15:41.85,DC-NE,,0,0,0,,{\fscx122\fscy90\pos(315.2,234.8)}‫قناة كود\N‫الإخبارية
Dialogue: 0,0:15:30.60,0:15:41.85,DC-L,,0,0,0,,{\fscx106\fscy90\pos(1571.2,359.6)}‫مباشر
Dialogue: 0,0:15:30.60,0:15:41.85,DC-N1,,0,0,0,,{\fscx103\fscy111\pos(1404.8,188.4)}‫أونيمارو يسيطر على مناطق مختلفة في كانتو
Dialogue: 0,0:15:30.60,0:15:41.85,DC-N2,,0,0,0,,{\fscx113\fscy107\pos(1404.8,257.2)}‫صدور أوامر وتعليمات بالإخلاء فورًا
Dialogue: 0,0:15:30.60,0:15:41.85,DC-N3,,0,0,0,,{\fscx175\fscy94\pos(308.8,889.2)}أخبار عاجلة
Dialogue: 0,0:15:30.60,0:15:41.85,DC-N4,,0,0,0,,{\pos(649.6,964.4)}محافظة توتشيغي
Dialogue: 0,0:15:31.10,0:15:32.10,DC,,0,0,0,,{\i1}‫أخبار عاجلة.{\i}
Dialogue: 0,0:15:32.10,0:15:34.56,DC,,0,0,0,,{\i1}‫بالإضافة إلى مبنى البرلمان الوطني،{\i}
Dialogue: 0,0:15:34.56,0:15:36.89,DC,,0,0,0,,{\i1}‫سيطر أونيمارو على عدد من المناطق{\i}
Dialogue: 0,0:15:36.89,0:15:38.73,DC,,0,0,0,,{\i1}‫في منطقة كانتو.{\i}
Dialogue: 0,0:15:38.73,0:15:42.48,DC,,0,0,0,,{\i1}‫كما أن أجزاءً من منطقة سايتاما قد سقطت تحت سيطرته.{\i}
Dialogue: 0,0:15:42.48,0:15:44.82,DC,,0,0,0,,‫متى فعل كل هذا؟
Dialogue: 0,0:15:44.82,0:15:48.15,DC,,0,0,0,,،بعد إتقانك للتقنية الجديدة
Dialogue: 0,0:15:48.16,0:15:51.62,DC,,0,0,0,,!يبدو أنه من الأفضل أن نحسم الأمر في أقرب وقت ممكن
Dialogue: 0,0:15:52.16,0:15:53.74,DC,,0,0,0,,‫أونيمارو، ذلك الوغد...
Dialogue: 0,0:15:53.74,0:15:55.37,DC,,0,0,0,,‫يعتقد أنه يمكنه فعل ما يريد؟!
Dialogue: 0,0:15:55.37,0:15:58.12,DC,,0,0,0,,!يجب أن أُكمل القطع الرعدي بسرعة
Dialogue: 0,0:15:58.12,0:15:59.25,DC,,0,0,0,,{\i1}‫هذا ليس جيدًا!{\i}
Dialogue: 0,0:15:59.25,0:16:04.71,DC,,0,0,0,,{\i1}‫يجب أن أحصل على سيف حاكم الرعد (رايجينكين) قبل أن يتقن القطع الرعدي!{\i}
Dialogue: 0,0:16:06.92,0:16:10.13,DC,,0,0,0,,‫في هذه الحالة، سأكون خصمك في التدريب!
Dialogue: 0,0:16:10.14,0:16:11.14,DC,,0,0,0,,حقاً!؟
Dialogue: 0,0:16:11.14,0:16:12.80,DC,,0,0,0,,‫هل تعتقد أن هذا مقبول يا موساشي؟
Dialogue: 0,0:16:12.81,0:16:14.93,DC,,0,0,0,,هل ستترك الأمر لكوجيرو؟
Dialogue: 0,0:16:15.98,0:16:18.14,DC,,0,0,0,,!سيكون خصمًا جيدًا له
Dialogue: 0,0:16:28.53,0:16:31.20,DC,,0,0,0,,‫قد تكون قد فاجأتني في المرة الماضية،
Dialogue: 0,0:16:31.91,0:16:34.66,DC,,0,0,0,,‫لكن تقنيتك سهلة القراءة.
Dialogue: 0,0:16:35.54,0:16:38.66,DC,,0,0,0,,!بتقنية كهذه، لن تتمكن من إصابتي
Dialogue: 0,0:16:49.38,0:16:50.34,DC,,0,0,0,,{\i1}‫تبًا.{\i}
Dialogue: 0,0:16:50.84,0:16:53.89,DC,,0,0,0,,{\i1}!إذا لم أتحرك أسرع، فلن أستطيع إصابة كوجيرو{\i}
Dialogue: 0,0:16:55.85,0:16:57.85,DC,,0,0,0,,{\i1}‫الضربة التالية ستنهي كل شيء.{\i}
Dialogue: 0,0:16:58.98,0:17:01.02,DC,,0,0,0,,{\i1}‫وسوف يصبح سيف حاكم الرعد (رايجينكين) ملكي!{\i}
Dialogue: 0,0:17:02.02,0:17:03.02,DC,,0,0,0,,‫تعال!
Dialogue: 0,0:17:04.31,0:17:06.53,DC,,0,0,0,,{\i1}‫أسرع... أسرع...{\i}
Dialogue: 0,0:17:13.70,0:17:14.66,DC,,0,0,0,,‫ضربة السنونو (تسوباميغايشي)!
Dialogue: 0,0:17:17.41,0:17:19.54,DC,,0,0,0,,{\i1}‫ض- ضربة السنونو (تسوباميغايشي)؟!{\i}
Dialogue: 0,0:17:25.54,0:17:26.50,DC,,0,0,0,,{\i1}‫هذا هو!{\i}
Dialogue: 0,0:17:30.42,0:17:31.88,DC,,0,0,0,,{\i1}،‫ضربة السنونو (تسوباميغايشي) خاصتي{\i}
Dialogue: 0,0:17:32.68,0:17:34.05,DC,,0,0,0,,{\i1}لقد أوقفها!؟{\i}
Dialogue: 0,0:17:39.35,0:17:41.27,DC,,0,0,0,,‫ها أنا قادم، كوجيرو!
Dialogue: 0,0:17:44.52,0:17:46.65,DC,,0,0,0,,‫سيف حاكم الرعد (رايجينكين) الخالي من الجوهرة:
Dialogue: 0,0:17:49.03,0:17:51.07,DC,,0,0,0,,!القطع الرعدي
Dialogue: 0,0:17:58.70,0:17:59.66,DC,,0,0,0,,‫ماذا تعتقد؟!
Dialogue: 0,0:18:00.33,0:18:03.21,DC,,0,0,0,,{\i1}!هذا الفتى، لقد رأى من خلال ضربة السنونو (تسوباميغايشي) خاصتي{\i}
Dialogue: 0,0:18:06.63,0:18:07.84,DC,,0,0,0,,!لقد فعلتها بشكل جيد
Dialogue: 0,0:18:08.92,0:18:11.71,DC,,0,0,0,,!السرعة والقطع، كلاهما مثالي
Dialogue: 0,0:18:11.72,0:18:14.01,DC,,0,0,0,,‫لقد كانت تقنية قطع رعدي رائعة!
Dialogue: 0,0:18:14.01,0:18:15.22,DC,,0,0,0,,حقاً!؟
Dialogue: 0,0:18:16.47,0:18:18.64,DC,,0,0,0,,‫لقد فعلتها! لقد فعلتها!
Dialogue: 0,0:18:18.64,0:18:21.14,DC,,0,0,0,,‫لقد أتقنت القطع الرعدي!
Dialogue: 0,0:18:21.14,0:18:22.77,DC,,0,0,0,,!شكرًا لك يا كوجيرو
Dialogue: 0,0:18:24.90,0:18:27.61,DC,,0,0,0,,{\i1}‫م-ماذا فعلت؟!{\i}
Dialogue: 0,0:18:28.65,0:18:31.73,DC,,0,0,0,,،حسنًا، بما أن تقنية القطع الرعدي اكتملت
Dialogue: 0,0:18:31.74,0:18:33.69,DC,,0,0,0,,!انتظرني يا أونيمارو
Dialogue: 0,0:18:33.70,0:18:35.82,DC,,0,0,0,,!سأأتي وأهزمك فورًا
Dialogue: 0,0:18:35.82,0:18:39.45,DC,,0,0,0,,!إذًا، فقد تقرر الأمر. أولًا، سنعقد اجتماعًا استراتيجيًا
Dialogue: 0,0:18:39.45,0:18:40.37,DC,,0,0,0,,‫حسنًا!
Dialogue: 0,0:18:42.83,0:18:44.08,DC,,0,0,0,,!انظروا لهذا
Dialogue: 0,0:18:44.79,0:18:47.17,DC,,0,0,0,,‫هذه خريطة قلعة أونيمارو.
Dialogue: 0,0:18:49.50,0:18:51.80,DC,,0,0,0,,‫إذن، أين مكان أونيمارو؟
Dialogue: 0,0:18:51.80,0:18:56.13,DC,,0,0,0,,‫من المحتمل أن يكون أونيمارو-ساما هنا، في الطابق العلوي.
Dialogue: 0,0:18:56.14,0:18:57.43,DC,,0,0,0,,‫حسنًا، انتظر...
Dialogue: 0,0:18:58.51,0:19:02.43,DC,,0,0,0,,{\i1}‫أولًا، المنطقة المحيطة بالقلعة محروسة بشدة بواسطة الشياطين السوداء.{\i}
Dialogue: 0,0:19:02.43,0:19:06.44,DC,,0,0,0,,{\i1}‫إذا اقتحمنا بشكل عشوائي، فسيتم القبض علينا فورًا!{\i}
Dialogue: 0,0:19:06.90,0:19:08.06,DC,,0,0,0,,‫إليك ما سنفعله...
Dialogue: 0,0:19:09.02,0:19:13.69,DC,,0,0,0,,‫استمعوا جيدًا!\N‫أولًا، سنجمع الفتيات عند المدخل الأمامي!
Dialogue: 0,0:19:14.40,0:19:15.65,DC,,0,0,0,,‫ثم...
Dialogue: 0,0:19:16.24,0:19:18.66,DC,,0,0,0,,{\i1}‫نقيم وليمة كبيرة ورائعة هناك...{\i}
Dialogue: 0,0:19:19.16,0:19:22.12,DC,,0,0,0,,!لتشتيت انتباه الشياطين السوداء
Dialogue: 0,0:19:23.12,0:19:24.83,DC,,0,0,0,,.أوه~، يا لها من خطة راقية
Dialogue: 0,0:19:27.12,0:19:29.21,DC,,0,0,0,,!أ... أعني، يا لها من استراتيجية مبتذلة وغير لائقة
Dialogue: 0,0:19:29.21,0:19:30.67,DC,,0,0,0,,.يا إلهي
Dialogue: 0,0:19:30.67,0:19:34.09,DC,,0,0,0,,مهلًا، ألم تقل إن أونيمارو في الأعلى؟
Dialogue: 0,0:19:34.63,0:19:38.84,DC,,0,0,0,,‫أليس من الأسرع أن نهاجم من الأعلى بركوبنا على ظهر شونوسوكي؟
Dialogue: 0,0:19:40.10,0:19:42.18,DC,,0,0,0,,‫نعم! هذه هي!
Dialogue: 0,0:19:42.18,0:19:43.81,DC,,0,0,0,,!ما هذا بحق
Dialogue: 0,0:19:46.89,0:19:49.52,DC,,0,0,0,,‫يا رفاق، لقد حان وقت الهجوم على القلعة!
Dialogue: 0,0:19:49.52,0:19:50.44,DC,,0,0,0,,‫أرقامكم؟
Dialogue: 0,0:19:50.44,0:19:51.94,DC,,0,0,0,,‫- واحد!\N‫- اثنان!
Dialogue: 0,0:19:51.94,0:19:52.65,DC,,0,0,0,,!ثلاثة
Dialogue: 0,0:19:52.65,0:19:53.48,DC,,0,0,0,,‫أربعة!
Dialogue: 0,0:19:53.48,0:19:53.98,DC,,0,0,0,,!خمسة
Dialogue: 0,0:19:53.98,0:19:54.82,DC,,0,0,0,,‫ستة!
Dialogue: 0,0:19:54.82,0:19:55.90,DC,,0,0,0,,‫سبعة!
Dialogue: 0,0:19:57.40,0:20:00.36,DC,,0,0,0,,!من الآن فصاعدًا، سنشن هجومًا كاملًا على قلعة أونيمارو
Dialogue: 0,0:20:00.37,0:20:01.87,DC,,0,0,0,,‫هل أنتم مستعدون؟!
Dialogue: 0,0:20:03.29,0:20:06.16,DC,,0,0,0,,!هيا بنا إلى المعركة
Dialogue: 0,0:20:11.04,0:20:14.80,DC,,0,0,0,,!كما توقعت، لقد أصيبوا بالذعر ويتجهون إلى هنا
Dialogue: 0,0:20:14.80,0:20:17.22,DC,,0,0,0,,!يا لهم من أغبياء
Dialogue: 0,0:20:19.26,0:20:20.51,DC,,0,0,0,,‫لقد حان الوقت.
Dialogue: 0,0:20:21.14,0:20:23.22,DC,,0,0,0,,!يا رفاق، خذوا مواقعكم
Dialogue: 0,0:20:24.51,0:20:26.85,DC,,0,0,0,,!سنسحقهم ونجبرهم على التراجع
Dialogue: 0,0:20:30.48,0:20:32.81,DC,,0,0,0,,‫انظروا! هذه هي قلعة أونيمارو!
Dialogue: 0,0:20:35.65,0:20:37.24,DC,,0,0,0,,!واااه
Dialogue: 0,0:20:37.24,0:20:40.70,DC,,0,0,0,,‫هناك الكثير من الشياطين السوداء أكثر مما توقعت!
Dialogue: 0,0:20:40.70,0:20:43.70,DC,,0,0,0,,!كما خططنا، سنهجم من السطح
Dialogue: 0,0:20:43.70,0:20:46.54,DC,,0,0,0,,كيف سنصعد نحن إلى الأعلى؟
Dialogue: 0,0:20:47.58,0:20:48.58,DC,,0,0,0,,!لا مشكلة
Dialogue: 0,0:20:50.87,0:20:52.75,DC,,0,0,0,,‫تمدد يا عصا الغسيل (مونوهوشيزاوا)!
Dialogue: 0,0:20:59.22,0:21:01.13,DC,,0,0,0,,!همم... يبدو أن الأمر سار على ما يرام
Dialogue: 0,0:21:03.22,0:21:04.39,DC,,0,0,0,,‫يايبا...
Dialogue: 0,0:21:05.01,0:21:05.85,DC,,0,0,0,,‫هذا هو...
Dialogue: 0,0:21:05.85,0:21:07.81,DC,,0,0,0,,‫"رعد"
Dialogue: 0,0:21:13.31,0:21:15.11,DC,,0,0,0,,!هذه الجوهرة سأعهد بها إليكِ
Dialogue: 0,0:21:15.61,0:21:16.94,DC,,0,0,0,,‫ماذا؟ ولكن...
Dialogue: 0,0:21:16.94,0:21:19.40,DC,,0,0,0,,أنتِ دائمًا من كان يحملها، أليس كذلك؟
Dialogue: 0,0:21:20.24,0:21:23.16,DC,,0,0,0,,‫بالإضافة إلى ذلك، لدي تقنية جديدة الآن.
Dialogue: 0,0:21:25.45,0:21:26.83,DC,,0,0,0,,‫نعم، أنت محق.
Dialogue: 0,0:21:35.00,0:21:36.21,DC,,0,0,0,,{\i1}‫أونيمارو!{\i}
Dialogue: 0,0:21:44.34,0:21:46.26,DC,,0,0,0,,{\i1}...أنا سأقوم{\i}
Dialogue: 0,0:21:47.26,0:21:48.56,DC,,0,0,0,,{\i1}‫بهزيمتك!{\i}
Dialogue: 0,0:21:57.48,0:21:59.36,DC,,0,0,0,,‫أونيمارو!
Dialogue: 0,0:23:36.79,0:23:39.54,DC,,0,0,0,,{\i1}!أخيرًا المعركة الحاسمة مع أونيمارو-كن{\i}
Dialogue: 0,0:23:39.54,0:23:42.71,DC,,0,0,0,,{\i1}‫هذا ما ظننته...\N‫إيه!؟ هل هذه حفرة فخ؟{\i}
Dialogue: 0,0:23:42.71,0:23:44.97,DC,,0,0,0,,{\i1}‫ما هذا المكان بالضبط!{\i}
Dialogue: 0,0:23:45.72,0:23:51.00,DCNN,,0,0,0,,{\pos(960,1000.0)}‫في الحلقة القادمة: ظهور أباطرة السماء الأربعة لأونيمارو
Dialogue: 0,0:23:48.18,0:23:50.10,DC,,0,0,0,,{\an8}{\i1}‫سنكون في إنتظاركم!{\i}
Dialogue: 0,0:23:51.00,0:23:53.10,DCDialogRedName,,0,0,0,,{\fs110\pos(959,629)\fnAl-Jazeera-Arabic-Bold}CodeSubs :ترجمة وتدقيق\N{\fs80}linktr.ee/CodeSubs
