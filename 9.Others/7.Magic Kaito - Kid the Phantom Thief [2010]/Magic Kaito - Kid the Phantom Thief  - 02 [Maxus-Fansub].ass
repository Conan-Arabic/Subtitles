Dialogue: 0,0:00:15.16,0:00:23.92,OP,,0,0,0,,لمَ تسير صوب المستقبل مُبهم العوالم بهذا الأمل؟
Dialogue: 0,0:00:24.12,0:00:33.17,OP,,0,0,0,,قلبي مُفعم بالحماس كما وكأنني مازلت أفكر بك
Dialogue: 0,0:00:33.42,0:00:42.31,OP,,0,0,0,,ما كان العائد عليك من الانفصال والدموع؟
Dialogue: 0,0:00:42.52,0:00:52.11,OP,,0,0,0,,صادفت رؤية القمر المنير والذي يُشاع عنه بأنه يُوصل دعواتي إليك
Dialogue: 0,0:00:52.86,0:00:57.28,OP,,0,0,0,,إنها صورة محفورة بذاكرتي، تعبر عن الذكريات الجميلة
Dialogue: 0,0:00:57.41,0:01:01.91,OP,,0,0,0,,مشهد مُماثل لعاصفةٍ صيفية   هذا ما يمكنني رؤيته
Dialogue: 0,0:01:02.12,0:01:06.58,OP,,0,0,0,,الحزن ظاهرة طبيعية          بينما الطمأنينة مجرد تطبّع
Dialogue: 0,0:01:06.79,0:01:12.21,OP,,0,0,0,,كلمة السر التي تحرر مشاعري     جدها من فضلك
Dialogue: 0,0:01:12.38,0:01:22.14,OP,,0,0,0,,كضوءٍ من المروج المتلاشية في الريح... غموض مُبهم
Dialogue: 0,0:01:23.31,0:01:27.73,OP,,0,0,0,,إنها صورة محفورة بذاكرتي، تعبر عن الذكريات الجميلة
Dialogue: 0,0:01:27.90,0:01:33.32,OP,,0,0,0,,مشهد مُماثل لعاصفةٍ صيفية   فلتجده رجاءً
Dialogue: 0,0:01:33.44,0:01:39.70,OP,,0,0,0,,كضوءٍ من المروج المتلاشية في الريح... غموض مُبهم
Dialogue: 0,0:22:35.33,0:22:42.25,ED,,0,0,0,,آلاف من بتلات الأزهار المتراقصة بفعل الرياح
Dialogue: 0,0:22:44.67,0:22:51.39,ED,,0,0,0,,تمامًا كالفراشات زهرية اللون، تعبر الطريق مسرعةً
Dialogue: 0,0:22:52.18,0:23:00.85,ED,,0,0,0,,لقد كان هذا شيئًا رأيته من قبل، في وقتٍ ما لا يمكنني استرجاعه
Dialogue: 0,0:23:02.61,0:23:09.91,ED,,0,0,0,,...عندما همست بكلمةٍ لا مبالية
Dialogue: 0,0:23:10.95,0:23:19.41,ED,,0,0,0,,مددت يديك وأمسكت بيديّ بإحكام
Dialogue: 0,0:23:20.12,0:23:25.34,ED,,0,0,0,,مازلت أتأرجح، وصادفت رؤيتك مجددًا
Dialogue: 0,0:23:25.55,0:23:29.22,ED,,0,0,0,,الفصول تنال مني
Dialogue: 0,0:23:29.42,0:23:34.60,ED,,0,0,0,,حاول مقارعة المستقبل، حاول التحلي بالإيمان
Dialogue: 0,0:23:34.76,0:23:39.43,ED,,0,0,0,,فالمستقبل دائمًا عرضةً للتغيير
Dialogue: 0,0:00:01.30,0:00:03.00,Otanoshimi,,0,0,0,,لا تظهر تعابير وجهك دومًا
Dialogue: 0,0:00:03.08,0:00:04.68,Otanoshimi,,0,0,0,,...اقتناعًا تامًا منه بكلمات أبيه
Dialogue: 0,0:00:04.82,0:00:06.78,Otanoshimi,,0,0,0,,الساحر الإعجازي يسير وسط ناطحات السحاب
Dialogue: 0,0:00:06.90,0:00:08.58,Otanoshimi,,0,0,0,,تألق كايتو كيد بدأ
Dialogue: 0,0:00:08.76,0:00:11.66,Otanoshimi,,0,0,0,,هدف اليوم هو تاج الملاك
Dialogue: 0,0:00:11.72,0:00:12.62,Otanoshimi,,0,0,0,,{\pos(770.667,1050.333)}والآن
Dialogue: 0,0:00:12.70,0:00:14.42,Otanoshimi,,0,0,0,,{\pos(658.667,1058.333)}!فلنبدأ العرض
Dialogue: 0,0:01:56.09,0:01:56.83,Default,,0,0,0,,مرحبًا
Dialogue: 0,0:01:56.87,0:01:58.43,Default,,0,0,0,,أنا كوروبا كايتو
Dialogue: 0,0:01:58.59,0:02:00.43,Default,,0,0,0,,...قد يبدو هذا تغطرسًا ولكن
Dialogue: 0,0:02:00.51,0:02:02.63,Default,,0,0,0,,!إنني ساحر رائع بحق
Dialogue: 0,0:02:06.85,0:02:09.65,Default,,0,0,0,,هذه الفتاة هي صديقة طفولتي واسمها ناكاموري أوكو
Dialogue: 0,0:02:09.85,0:02:12.63,Default,,0,0,0,,!إنها في الصف الـ11 ولكنها مازالت تتصرف كالأطفال
Dialogue: 0,0:02:16.47,0:02:19.62,Default,,0,0,0,,والد أوكو مفتش صارم يعمل بالشرطة
Dialogue: 0,0:02:19.63,0:02:21.65,Default,,0,0,0,,...ويبدو أن الحماس بلغ أوجه معه هذه الأيام
Dialogue: 0,0:02:21.73,0:02:26.19,Default,,0,0,0,,جرّاء محاولته للإيقاع بكايتو كيد اللص \Nالذي أحدث الكثير من الجلبة
Dialogue: 0,0:02:27.45,0:02:31.02,Default,,0,0,0,,!لا تخل نفسك بهذه العظمة؛ فلم تستطع هزيمة كايتو كيد بعد
Dialogue: 0,0:02:32.27,0:02:33.85,Default,,0,0,0,,يا لها من مزحة
Dialogue: 0,0:02:34.05,0:02:35.71,Default,,0,0,0,,الساحر الوحيد الذي لم أتمكن من هزيمته بعد
Dialogue: 0,0:02:35.71,0:02:38.80,Default,,0,0,0,,هو كوروبا تويتشي، والدي
Dialogue: 0,0:02:45.77,0:02:48.03,Default,,0,0,0,,اتضح أنه خلف الجدار تواجدت غرفة سرية
Dialogue: 0,0:02:48.31,0:02:49.23,Default,,0,0,0,,ولسبب ما
Dialogue: 0,0:02:49.31,0:02:52.15,Default,,0,0,0,,زي كايتو كيد تواجد بهذه الغرفة أيضًا
Dialogue: 0,0:02:54.57,0:02:57.49,Default,,0,0,0,,على الرغم من أن كيد اختفى فجأة\N...منذ ثمانية أعوام
Dialogue: 0,0:02:57.49,0:02:59.49,Default,,0,0,0,,إلا أنه مؤخرًا باشر بعمله مجددًا
Dialogue: 0,0:03:00.07,0:03:02.39,Default,,0,0,0,,...أبي، الساحر المشهور على مستوى العالم
Dialogue: 0,0:03:02.47,0:03:06.21,Default,,0,0,0,,فقد حياته بينما كان بعرضٍ ما منذ ثمانية أعوام
Dialogue: 0,0:03:11.17,0:03:13.95,Default,,0,0,0,,...وبغيّة معرفة الحقيقة الغامضة التي تركها أبي خلفه
Dialogue: 0,0:03:14.19,0:03:16.89,Default,,0,0,0,,توجّهت صوب المكان الذي حدده كيد كجريمته التالية
Dialogue: 0,0:03:19.55,0:03:21.43,Default,,0,0,0,,...ولكن هوية كيد الذي قابلته هناك
Dialogue: 0,0:03:21.61,0:03:26.11,Default,,0,0,0,,كان خادمًا لأبي واسمه جي-شان، أو جي كونوسكي
Dialogue: 0,0:03:21.61,0:03:26.11,note,,0,0,0,,جي-شان: تعني الجد
Dialogue: 0,0:03:29.17,0:03:34.60,Default,,0,0,0,,وعرفت من جي-شان بأن أبي، كوروبا تويتشي\N...هو نفسه كايتو كيد ومنذ ثمانية أعوام
Dialogue: 0,0:03:34.97,0:03:39.05,Default,,0,0,0,,تم قتله بواسطة شخص ما تحت مُسمّى مجرد حادثة
Dialogue: 0,0:03:41.29,0:03:43.67,Default,,0,0,0,,...وبغيّة إيجاد المسؤول عن موت أبي
Dialogue: 0,0:03:43.67,0:03:45.35,Default,,0,0,0,,-أنا -كوروبا كايتو
Dialogue: 0,0:03:45.41,0:03:47.75,Default,,0,0,0,,!تقمصت شخصيته وأصبحت كايتو كيد الثاني
Dialogue: 0,0:03:56.25,0:03:59.46,DCEpTitle,,0,0,0,,{\fad(300,0)\pos(946.667,264)}موعد كايتو كيد الحافل
Dialogue: 0,0:04:20.23,0:04:24.03,Default,,0,0,0,,!اهدأ قليلًا يا سيدي الصغير كايتو رجاءً
Dialogue: 0,0:04:24.74,0:04:30.12,Default,,0,0,0,,!فأنا لم أسمع أي تفاصيل من سيدي تويتشي أيضًا
Dialogue: 0,0:04:30.29,0:04:31.33,Default,,0,0,0,,...ولهذا تحديدًا
Dialogue: 0,0:04:31.43,0:04:35.81,Default,,0,0,0,,أخبرتك بأن تقول كل ما تعرفه من البداية يا جي-شان، أليس كذلك؟
Dialogue: 0,0:04:36.05,0:04:37.39,Default,,0,0,0,,...لمَ قام أبي
Dialogue: 0,0:04:38.07,0:04:42.65,Default,,0,0,0,,كوروبا تويتشي، بجعل كايتو كيد على هذه الشاكلة\Nوشرّع في سرقة الكنوز؟
Dialogue: 0,0:04:42.74,0:04:45.85,Default,,0,0,0,,وأيضًا، لمَ مات؟
Dialogue: 0,0:04:46.75,0:04:49.55,Default,,0,0,0,,...هذا
Dialogue: 0,0:04:58.33,0:04:59.49,Thoughts,,0,0,0,,...أيعقل
Dialogue: 0,0:04:59.57,0:05:01.71,Thoughts,,0,0,0,,بأن أمي طالبته بجعل الأمر سرًا؟
Dialogue: 0,0:05:03.19,0:05:07.09,Flashback,,0,0,0,,أراهن بأنك ستنشغل في الأيام المقبلة
Dialogue: 0,0:05:11.07,0:05:13.89,Default,,0,0,0,,!حسنًا، لا تقل شيئًا إن لم تُرد
Dialogue: 0,0:05:14.01,0:05:17.11,Default,,0,0,0,,...لا فكرة لي عن ذاك السر بينك وبين أمي، ولكن
Dialogue: 0,0:05:17.43,0:05:21.23,Default,,0,0,0,,!سأصبح كيد وأحدث جلبة لمعرفة ما أريد
Dialogue: 0,0:05:26.53,0:05:28.53,Default,,0,0,0,,!حان وقت العرض
Dialogue: 0,0:05:57.75,0:05:59.25,Default,,0,0,0,,!حصلت عليها
Dialogue: 0,0:06:04.23,0:06:06.45,Default,,0,0,0,,لا داعي للقلق يا سيدتي
Dialogue: 0,0:06:07.19,0:06:09.31,Default,,0,0,0,,خادمكم المخلص جي كونوسكي
Dialogue: 0,0:06:09.39,0:06:10.85,Default,,0,0,0,,...يقسم بحياته
Dialogue: 0,0:06:11.05,0:06:15.91,Default,,0,0,0,,بأن يدعم السيد الصغير كايتو مهما تطلب الأمر
Dialogue: 0,0:06:22.19,0:06:24.01,Default,,0,0,0,,!تمهل يا كيد
Dialogue: 0,0:06:24.01,0:06:26.01,Default,,0,0,0,,!يجدر بي الإمساك بك الليلة
Dialogue: 0,0:06:29.53,0:06:30.99,Default,,0,0,0,,!لقد تلاشى -\N!أين ذهب؟ -
Dialogue: 0,0:06:31.45,0:06:33.73,Default,,0,0,0,,!لا تذعروا، هكذا يفعل دائمًا
Dialogue: 0,0:06:36.09,0:06:38.57,Default,,0,0,0,,!لقد وقعت في الفخ يا كيد
Dialogue: 0,0:06:45.57,0:06:46.49,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:06:50.39,0:06:52.65,Default,,0,0,0,,هل رأيت؟
Dialogue: 0,0:06:52.69,0:06:55.27,Default,,0,0,0,,!استراتيجية ناكاموري جينزو العبقرية للإيقاع بكيد
Dialogue: 0,0:06:55.27,0:06:58.07,Default,,0,0,0,,...لا أوافقك الرأي، بشأن نعتها بالخطة العبقرية
Dialogue: 0,0:07:00.03,0:07:01.11,Default,,0,0,0,,...ماذا
Dialogue: 0,0:07:06.33,0:07:07.57,Default,,0,0,0,,!هذا سيئ
Dialogue: 0,0:07:29.39,0:07:30.63,Default,,0,0,0,,!اللعنة
Dialogue: 0,0:07:30.73,0:07:32.25,Default,,0,0,0,,...إنه يعبث معي
Dialogue: 0,0:07:32.59,0:07:34.87,Default,,0,0,0,,...ولكن ملامحه كانت حقًا
Dialogue: 0,0:07:37.09,0:07:38.25,Default,,0,0,0,,!لا شك في هذا
Dialogue: 0,0:07:39.77,0:07:41.61,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:07:41.69,0:07:43.61,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:07:43.61,0:07:45.61,Default,,0,0,0,,أتريدني أن أقولها مجددًا؟
Dialogue: 0,0:07:45.87,0:07:46.59,Default,,0,0,0,,...فلتأتي معي
Dialogue: 0,0:07:47.65,0:07:49.51,Default,,0,0,0,,!في موعدٍ غرامي
Dialogue: 0,0:07:49.51,0:07:51.73,Default,,0,0,0,,هل هذه دعابة جديدة أو ما شابه؟
Dialogue: 0,0:07:52.71,0:07:54.27,Default,,0,0,0,,...لا تخيفيني بهذه الطريقة
Dialogue: 0,0:07:54.27,0:07:56.67,Default,,0,0,0,,هل ستأتي أم لا؟
Dialogue: 0,0:07:56.77,0:07:59.59,Default,,0,0,0,,ومن قد يخرج مع قصيرة مثلك؟
Dialogue: 0,0:08:00.39,0:08:02.21,Default,,0,0,0,,...أعرف
Dialogue: 0,0:08:02.37,0:08:04.53,Default,,0,0,0,,...أعرف هذا أيضًا ولكن
Dialogue: 0,0:08:04.93,0:08:05.99,Default,,0,0,0,,...ولكن
Dialogue: 0,0:08:07.01,0:08:07.99,Default,,0,0,0,,...رجاءً
Dialogue: 0,0:08:12.93,0:08:13.88,Default,,0,0,0,,...حسنًا
Dialogue: 0,0:08:13.88,0:08:15.88,Default,,0,0,0,,!حقا؟
Dialogue: 0,0:08:17.03,0:08:19.99,Default,,0,0,0,,!إذًا مدينة ملاهي الأراضي الاستوائية، يوم الأحد
Dialogue: 0,0:08:19.99,0:08:20.93,Default,,0,0,0,,!هذا وعد
Dialogue: 0,0:08:21.41,0:08:22.93,Default,,0,0,0,,!مهلًا
Dialogue: 0,0:08:23.61,0:08:26.13,Thoughts,,0,0,0,,!ولكن يوم الأحد هو موعد السرقة
Dialogue: 0,0:08:27.63,0:08:30.67,Default,,0,0,0,,إذًا يا أوكو، هل تحبين كايتو-كن؟
Dialogue: 0,0:08:30.67,0:08:31.95,Default,,0,0,0,,ومن قد يحب شخص مثله!؟
Dialogue: 0,0:08:31.95,0:08:34.11,Default,,0,0,0,,...ولكنكِ طلبتِ منه الخروج في موعد
Dialogue: 0,0:08:34.17,0:08:36.73,Default,,0,0,0,,...هذا لأن، أبي
Dialogue: 0,0:08:37.23,0:08:38.49,Thoughts,,0,0,0,,أجل
Dialogue: 0,0:08:38.57,0:08:40.21,Thoughts,,0,0,0,,هذا خطأ أبي
Dialogue: 0,0:08:41.61,0:08:42.91,Default,,0,0,0,,...أوكو
Dialogue: 0,0:08:43.93,0:08:46.51,Default,,0,0,0,,!كايتو كيد هو كايتو-كن
Dialogue: 0,0:08:49.61,0:08:51.89,Default,,0,0,0,,ما هذا الخيال الذي تتحدث عنه يا أبي؟
Dialogue: 0,0:08:51.89,0:08:53.89,Default,,0,0,0,,بلى، لا شك بهذا
Dialogue: 0,0:08:53.89,0:08:55.89,Default,,0,0,0,,لقد رأيت وجهه
Dialogue: 0,0:08:55.89,0:08:57.01,Default,,0,0,0,,وأيضًا، كايتو-كن بوسعه
Dialogue: 0,0:08:57.25,0:08:59.69,Default,,0,0,0,,عمل خدع سحرية، أليس كذلك؟
Dialogue: 0,0:08:59.69,0:09:01.35,Default,,0,0,0,,وهذا يجعله مشبوه به
Dialogue: 0,0:09:01.67,0:09:02.91,Default,,0,0,0,,...أبي
Dialogue: 0,0:09:03.03,0:09:05.49,Default,,0,0,0,,أعلن كيد بأن يوم الأحد هو موعد الجريمة
Dialogue: 0,0:09:05.49,0:09:09.03,Default,,0,0,0,,سيظهر كل شيءٍ على حقيقته آنذاك
Dialogue: 0,0:09:10.15,0:09:12.91,Default,,0,0,0,,!اخرس
Dialogue: 0,0:09:13.01,0:09:15.81,Default,,0,0,0,,مُحال بأن يكون كايتو هو كايتو كيد، حسنًا!؟
Dialogue: 0,0:09:15.97,0:09:17.67,Default,,0,0,0,,لأن كايتو وعدني بالفعل بأنه
Dialogue: 0,0:09:17.67,0:09:19.99,Default,,0,0,0,,!سيأتي معي في موعدٍ غرامي يوم الأحد
Dialogue: 0,0:09:21.29,0:09:23.29,Thoughts,,0,0,0,,...كايتو لن يقوم بشيءٍ كهذا
Dialogue: 0,0:09:23.57,0:09:25.63,Thoughts,,0,0,0,,البتة، أليس كذلك؟
Dialogue: 0,0:09:26.51,0:09:29.87,Default,,0,0,0,,إنه كايتو-كن مجددًا، أليس كذلك!؟\N!يختلس النظر بغرفة تغيير الملابس
Dialogue: 0,0:09:29.91,0:09:30.45,Default,,0,0,0,,!يا إلهي
Dialogue: 0,0:09:31.53,0:09:34.05,Default,,0,0,0,,!هذا خطؤك؛ لاستخدامك قفل صغير كهذا
Dialogue: 0,0:09:34.13,0:09:35.69,Default,,0,0,0,,!تريث
Dialogue: 0,0:09:38.69,0:09:40.03,Default,,0,0,0,,...مشبوه به قال
Dialogue: 0,0:09:53.55,0:09:56.01,Default,,0,0,0,,...لقد تأخر كايتو
Dialogue: 0,0:09:56.47,0:09:59.27,Thoughts,,0,0,0,,يا إلهي، بماذا تفكر هذه الفتاة؟
Dialogue: 0,0:09:59.39,0:10:02.61,Thoughts,,0,0,0,,...لا تخبرني بأنها تعرف بشأن بيان السرقة
Dialogue: 0,0:10:02.79,0:10:05.79,Thoughts,,0,0,0,,أيعقل بأن المفتش قد اكتشف هويتي الحقيقة؟
Dialogue: 0,0:10:05.85,0:10:07.59,Thoughts,,0,0,0,,...مُحال
Dialogue: 0,0:10:09.29,0:10:10.67,Default,,0,0,0,,!مرحبًا
Dialogue: 0,0:10:10.79,0:10:12.29,Default,,0,0,0,,عذرًا على التأخر
Dialogue: 0,0:10:12.79,0:10:14.11,Thoughts,,0,0,0,,...كايتو
Dialogue: 0,0:10:16.71,0:10:18.17,Default,,0,0,0,,لقد عرفت
Dialogue: 0,0:10:18.23,0:10:19.67,Default,,0,0,0,,بأنك ستأتي من أجلي
Dialogue: 0,0:10:19.99,0:10:22.43,Default,,0,0,0,,ألم أعدك؟
Dialogue: 0,0:10:23.35,0:10:24.49,Default,,0,0,0,,!هيا بنا
Dialogue: 0,0:10:30.41,0:10:31.55,Default,,0,0,0,,!انظر، انظر
Dialogue: 0,0:10:31.63,0:10:33.61,Default,,0,0,0,,!هذا الفيل مذهل
Dialogue: 0,0:10:33.67,0:10:34.51,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:10:35.15,0:10:36.85,Default,,0,0,0,,إنه فيل آلي
Dialogue: 0,0:10:36.97,0:10:38.25,Default,,0,0,0,,هكذا إذًا؟
Dialogue: 0,0:10:38.91,0:10:39.93,Default,,0,0,0,,!فلندخل
Dialogue: 0,0:10:44.27,0:10:46.35,Default,,0,0,0,,الصورة تتحرك!؟
Dialogue: 0,0:10:52.15,0:10:54.67,Default,,0,0,0,,!بل الغرفة هي ما تتحرك
Dialogue: 0,0:10:54.73,0:10:55.97,Default,,0,0,0,,هكذا إذًا؟
Dialogue: 0,0:10:56.07,0:11:01.03,Default,,0,0,0,,!فلنلعب
Dialogue: 0,0:11:02.95,0:11:04.29,Default,,0,0,0,,!يا لها من دمية ظريفة
Dialogue: 0,0:11:06.71,0:11:08.63,Default,,0,0,0,,!يا إلهي، رائحة العرق مقرفة
Dialogue: 0,0:11:08.81,0:11:10.75,Default,,0,0,0,,...كايتو
Dialogue: 0,0:11:12.73,0:11:13.89,Default,,0,0,0,,...كايتو
Dialogue: 0,0:11:14.35,0:11:15.69,Default,,0,0,0,,...تمهل
Dialogue: 0,0:11:17.85,0:11:19.03,Default,,0,0,0,,...لقد قلت
Dialogue: 0,0:11:19.17,0:11:20.83,Default,,0,0,0,,!تمهل
Dialogue: 0,0:11:21.83,0:11:24.25,Default,,0,0,0,,لمَ تحب افتعال المقالب بهذا القدر؟
Dialogue: 0,0:11:24.49,0:11:26.53,Default,,0,0,0,,!انظر إليّ يا كايتو
Dialogue: 0,0:11:27.88,0:11:29.55,Default,,0,0,0,,!عظيم
Dialogue: 0,0:11:30.95,0:11:33.85,Default,,0,0,0,,!هكذا تكون أوكو الحقيقة\N!والآن أنتِ على طبيعتك يا أوكو
Dialogue: 0,0:11:38.01,0:11:39.03,Default,,0,0,0,,...ماذا بحق
Dialogue: 0,0:11:39.09,0:11:41.35,Default,,0,0,0,,!كل ما تفعله هو السخرية من الناس
Dialogue: 0,0:11:41.41,0:11:42.57,Default,,0,0,0,,...أيتها الـ
Dialogue: 0,0:11:44.19,0:11:48.27,خط - إعلانات روابط الموقع المترجم والعامل,,0,0,0,,كلن من كايتو و أوكو ادخلا كلمة غباء بالأسم وهي باكا وأهو ليصبح باكا-يتو و أهو-كو
Dialogue: 0,0:11:44.19,0:11:48.27,Default,,0,0,0,,!توقفي مكانك يا أهو-كو -\N!من تنعتها بالغبية، يا باكا-يتو -
Dialogue: 0,0:11:59.17,0:12:03.47,Default,,0,0,0,,أيتها البلهاء\Nلمَ تأكلين السمك أمام عينيّ!؟
Dialogue: 0,0:12:03.47,0:12:05.87,Default,,0,0,0,,!ولكنني أحبه
Dialogue: 0,0:12:09.69,0:12:12.21,Default,,0,0,0,,!كيف تجرؤين -\N!خذ هذه -
Dialogue: 0,0:12:12.27,0:12:13.97,Default,,0,0,0,,!أرد الدين
Dialogue: 0,0:12:33.89,0:12:37.05,Thoughts,,0,0,0,,...لقد أوشك الوقت الذي ذكرته في البيان على القدوم
Dialogue: 0,0:12:41.09,0:12:42.95,Default,,0,0,0,,!أريد مشاهدته بشدة
Dialogue: 0,0:12:43.03,0:12:46.15,Thoughts,,0,0,0,,فيلم؟\Nإنها فرصة مثالية للهرب
Dialogue: 0,0:12:49.85,0:12:52.17,Thoughts,,0,0,0,,...مدة العرض 40 دقيقة
Dialogue: 0,0:12:52.21,0:12:54.27,Thoughts,,0,0,0,,...إن لم أتمكن من العودة قبيل هذا
Dialogue: 0,0:12:56.27,0:12:57.07,Default,,0,0,0,,...أنا
Dialogue: 0,0:12:57.15,0:12:59.97,Default,,0,0,0,,!لا أطيق تقنية ثلاثي الأبعاد؛ لذا سأنتظركِ بالخارج
Dialogue: 0,0:13:00.05,0:13:01.28,Default,,0,0,0,,مهلًا
Dialogue: 0,0:13:05.51,0:13:07.25,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:13:07.29,0:13:08.21,Default,,0,0,0,,...آسفة
Dialogue: 0,0:13:08.27,0:13:09.65,Default,,0,0,0,,ولكن لبعض الوقت فقط
Dialogue: 0,0:13:09.87,0:13:12.45,Default,,0,0,0,,...ابق قليلًا
Dialogue: 0,0:13:13.07,0:13:15.67,Default - up,,0,0,0,,!فليضع الجميع نظاراتهم ثلاثية الأبعاد
Dialogue: 0,0:13:13.11,0:13:14.73,Thoughts,,0,0,0,,...أوكو
Dialogue: 0,0:13:14.73,0:13:16.44,Default,,0,0,0,,!فلنشاهد هذا
Dialogue: 0,0:13:17.75,0:13:19.03,Thoughts,,0,0,0,,...هل تعرف
Dialogue: 0,0:13:19.19,0:13:20.49,Thoughts,,0,0,0,,هويتي الحقيقة؟
Dialogue: 0,0:13:20.59,0:13:22.05,Thoughts,,0,0,0,,...إذًا، لقد استطاع المفتش
Dialogue: 0,0:13:22.11,0:13:24.13,Thoughts,,0,0,0,,...رؤية وجهي ليلة الأمس حقًا
Dialogue: 0,0:13:24.39,0:13:26.29,Default,,0,0,0,,!هذا مثير جدًا
Dialogue: 0,0:13:26.49,0:13:27.77,Default,,0,0,0,,...والآن سنبدأ عرض
Dialogue: 0,0:13:27.83,0:13:31.35,Default,,0,0,0,,يايبر المقنع ثلاثي الأبعاد
Dialogue: 0,0:13:40.71,0:13:42.59,Default,,0,0,0,,أسرع يا سيدي الصغير
Dialogue: 0,0:13:44.83,0:13:48.83,Default,,0,0,0,,...يجدر بي إنهاء كل شيءٍ قبلما ينتهي الفيلم
Dialogue: 0,0:13:50.55,0:13:53.73,Default,,0,0,0,,ألا يمكنك القيادة بطريقةٍ مسالمة أكثر، يا جي-شان؟
Dialogue: 0,0:13:53.79,0:13:56.89,Default,,0,0,0,,!إن فعلت ما تطلب؛ فلن تصل لمبتغاك أبدًا
Dialogue: 0,0:13:57.21,0:13:58.93,Default,,0,0,0,,...هذا صحيح ولكن
Dialogue: 0,0:14:17.60,0:14:19.68,Default,,0,0,0,,!ثمة خمس دقائق متبقية
Dialogue: 0,0:14:19.69,0:14:21.39,Default,,0,0,0,,!جهزوا أنفسكم لأسوأ الحالات
Dialogue: 0,0:14:21.45,0:14:22.37,Default,,0,0,0,,علم
Dialogue: 0,0:14:25.29,0:14:27.65,Default,,0,0,0,,يايبر المقنع ثلاثي الأبعاد
Dialogue: 0,0:14:31.17,0:14:32.51,Default,,0,0,0,,!تبقت دقيقة واحدة
Dialogue: 0,0:14:33.57,0:14:35.81,Default,,0,0,0,,أتعلم إلى أين ذهب المفتش؟
Dialogue: 0,0:14:35.89,0:14:37.41,Default,,0,0,0,,...لا فكرة لدي
Dialogue: 0,0:14:57.67,0:15:01.05,Default,,0,0,0,,...يجدر بي الإسراع\N!تبقت 18 دقيقة فقط حتى نهاية الفيلم
Dialogue: 0,0:15:12.45,0:15:13.93,Default,,0,0,0,,المفتش!؟
Dialogue: 0,0:15:14.23,0:15:16.17,Default,,0,0,0,,!لقد وقعت في المكيدة يا كيد
Dialogue: 0,0:15:16.73,0:15:19.33,Default,,0,0,0,,!لقد وقعت في المكيدة أيها المقنع يايبر
Dialogue: 0,0:15:19.43,0:15:22.89,Default,,0,0,0,,!سأكشف هويتك الحقيقة الآن وهنا
Dialogue: 0,0:15:24.67,0:15:28.09,Default,,0,0,0,,!سأكشف هويتك الحقيقة الآن وهنا
Dialogue: 0,0:15:33.55,0:15:35.31,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:15:40.87,0:15:42.77,Default,,0,0,0,,!هويتي الحقيقة هي أنت
Dialogue: 0,0:15:42.95,0:15:44.83,Default,,0,0,0,,!أنت في الواقع مجرد نسخة لي
Dialogue: 0,0:15:50.41,0:15:52.23,Default,,0,0,0,,!إنني أُجيد التنكر
Dialogue: 0,0:15:52.33,0:15:54.77,Default,,0,0,0,,!يمككني أن أصبح على الشاكلة التي أريد
Dialogue: 0,0:16:02.45,0:16:04.13,Default,,0,0,0,,!ثمة حقيقة واحدة دومًا
Dialogue: 0,0:16:05.29,0:16:06.83,Default,,0,0,0,,!أيها الحمقى
Dialogue: 0,0:16:06.93,0:16:08.63,Default,,0,0,0,,!لا تصفقوا
Dialogue: 0,0:16:13.03,0:16:14.75,Default,,0,0,0,,...أوكو
Dialogue: 0,0:16:14.87,0:16:15.75,Default,,0,0,0,,...هذا صحيح
Dialogue: 0,0:16:15.91,0:16:17.15,Default,,0,0,0,,أيها المفتش ناكاموري
Dialogue: 0,0:16:17.33,0:16:20.97,Default,,0,0,0,,!لقد درست كل من هم حولك عن ظهر قلب
Dialogue: 0,0:16:21.05,0:16:24.49,Default,,0,0,0,,إذًا، وجه كايتو-كن كان تنكرًا أيضًا!؟
Dialogue: 0,0:16:24.53,0:16:25.85,Default,,0,0,0,,!مُحق
Dialogue: 0,0:16:26.21,0:16:27.77,Default,,0,0,0,,!اللعنة
Dialogue: 0,0:16:27.85,0:16:29.89,Default,,0,0,0,,!وداعًا إذًا، يا أبي
Dialogue: 0,0:16:30.73,0:16:32.83,Default,,0,0,0,,!أيها المسخ
Dialogue: 0,0:16:38.97,0:16:40.13,Default,,0,0,0,,!اللعنة
Dialogue: 0,0:16:40.65,0:16:42.97,Default,,0,0,0,,لا تتقهقروا\N!طاردوه
Dialogue: 0,0:16:43.03,0:16:45.33,Default,,0,0,0,,...كيد
Dialogue: 0,0:16:49.89,0:16:51.31,Default,,0,0,0,,اللعنة
Dialogue: 0,0:16:51.39,0:16:53.99,Default,,0,0,0,,...يا له من إهدار كبير للوقت
Dialogue: 0,0:16:53.99,0:16:56.29,Default,,0,0,0,,!تبقى خمس دقائق قبل نهاية العرض
Dialogue: 0,0:16:56.35,0:16:58.66,Default,,0,0,0,,...إن لم أستطع العودة في الوقت المناسب، أوكو سوف
Dialogue: 0,0:16:58.66,0:17:00.29,Default,,0,0,0,,!تكتشف هويتي الحقيقية
Dialogue: 0,0:17:00.49,0:17:03.01,Default,,0,0,0,,!أسرع يا جي-شان -\Nدع الأمر لي -
Dialogue: 0,0:17:16.47,0:17:18.03,Default,,0,0,0,,!مُحال
Dialogue: 0,0:17:18.09,0:17:20.03,Default,,0,0,0,,...لقد أصلحتها جيدًا
Dialogue: 0,0:17:20.03,0:17:22.79,Default,,0,0,0,,!هذا كله جرّاء قيادتك المتهورة
Dialogue: 0,0:17:22.87,0:17:24.55,Default,,0,0,0,,صحيح، ماذا عن طائرتي الشراعية؟
Dialogue: 0,0:17:24.71,0:17:26.55,Default,,0,0,0,,!مازالت قيد التصليح
Dialogue: 0,0:17:26.79,0:17:30.21,Default,,0,0,0,,منذ قمت بتحطيهما جرّاء استعمالك الخشن يا سيدي الصغير
Dialogue: 0,0:17:30.53,0:17:31.91,Default,,0,0,0,,!أرجو المعذرة
Dialogue: 0,0:17:32.09,0:17:34.15,Default,,0,0,0,,!تبقى أربع دقائق، تباً
Dialogue: 0,0:17:34.21,0:17:35.73,Default,,0,0,0,,...يجدر بي الركض
Dialogue: 0,0:17:36.07,0:17:37.51,Default,,0,0,0,,!سيدي الصغير
Dialogue: 0,0:17:43.75,0:17:47.87,Default,,0,0,0,,!اركض!.. اركض
Dialogue: 0,0:17:48.39,0:17:50.57,Default,,0,0,0,,!دقيقة واحدة فقط
Dialogue: 0,0:17:53.89,0:17:56.39,Thoughts,,0,0,0,,!يفصلني 2كم عن الوصول إلى قاعة العرض
Dialogue: 0,0:17:56.45,0:17:57.99,Default,,0,0,0,,هل انتهى أمري!؟
Dialogue: 0,0:18:01.31,0:18:05.39,Default,,0,0,0,,...لقد انتهى أمرك يا كامين يايبر
Dialogue: 0,0:18:07.27,0:18:08.15,Default,,0,0,0,,...لا جدوى
Dialogue: 0,0:18:10.51,0:18:11.99,Default,,0,0,0,,!لا يمكنني فعلها
Dialogue: 0,0:18:18.45,0:18:20.19,Default,,0,0,0,,...هذا
Dialogue: 0,0:18:20.83,0:18:22.29,Default,,0,0,0,,!جميل
Dialogue: 0,0:18:22.31,0:18:23.69,Default,,0,0,0,,...القتال ما يزال
Dialogue: 0,0:18:23.77,0:18:24.79,Default,,0,0,0,,!قائمًا
Dialogue: 0,0:18:25.01,0:18:28.05,Default,,0,0,0,,!فلتمتع نظرك بقوتي الحقيقة
Dialogue: 0,0:18:29.51,0:18:32.81,Default,,0,0,0,,!هذه هي الروح المطلوبة
Dialogue: 0,0:18:41.63,0:18:44.35,Default,,0,0,0,,...تبقى 30 ثانية\Nهل يمكنني فعلها؟
Dialogue: 0,0:18:51.79,0:18:53.51,Default,,0,0,0,,...مهلا
Dialogue: 0,0:19:11.17,0:19:12.87,Default,,0,0,0,,!عشرون ثانية فقط
Dialogue: 0,0:19:14.19,0:19:16.49,Default,,0,0,0,,!هيا
Dialogue: 0,0:19:24.48,0:19:26.34,Default,,0,0,0,,!اهزمه
Dialogue: 0,0:19:48.37,0:19:51.07,Default,,0,0,0,,أمزح فقط\N!هيا
Dialogue: 0,0:20:01.51,0:20:04.63,Default,,0,0,0,,!ركلة يايبا
Dialogue: 0,0:20:13.69,0:20:16.47,Default,,0,0,0,,جميعًا، الإلقاء بالأشياء ليس مسموحًا
Dialogue: 0,0:20:18.43,0:20:20.49,Default,,0,0,0,,لقد كان هذا مشوقًا للغاية يا كايتو
Dialogue: 0,0:20:21.36,0:20:22.57,Default,,0,0,0,,أجل
Dialogue: 0,0:20:22.57,0:20:24.24,Default,,0,0,0,,!لقد كان الأروع
Dialogue: 0,0:20:32.21,0:20:34.89,Thoughts,,0,0,0,,...على كلٍ، إنني منهك بشدة
Dialogue: 0,0:20:35.59,0:20:36.61,Default,,0,0,0,,!أبي
Dialogue: 0,0:20:37.47,0:20:39.91,Flashback,,0,0,0,,إنك تشاهد، أليس كذلك يا كايتو كيد!؟
Dialogue: 0,0:20:39.99,0:20:42.95,Flashback,,0,0,0,,!سأعتقلك المرة القادمة بكل تأكيد أيها الوغد
Dialogue: 0,0:20:42.99,0:20:44.71,Thoughts,,0,0,0,,...يا إلهي، إنه التلفاز فقط
Dialogue: 0,0:20:42.99,0:20:44.71,Default - up,,0,0,0,,...كان معكم المفتش ناكاموري
Dialogue: 0,0:20:44.77,0:20:46.11,Default,,0,0,0,,...إنني سعيدة بحق
Dialogue: 0,0:20:44.77,0:20:48.31,Default - up,,0,0,0,,والذي قام بحماية تاج الملاك من قبضة كايتو كيد
Dialogue: 0,0:20:46.15,0:20:48.27,Default,,0,0,0,,بأن كايتو هو كايتو
Dialogue: 0,0:20:49.47,0:20:50.73,Default,,0,0,0,,!انتظرني قليلًا
Dialogue: 0,0:20:52.27,0:20:54.05,Thoughts,,0,0,0,,...إذًا، فعلت أوكو هذا
Dialogue: 0,0:20:54.27,0:20:56.25,Thoughts,,0,0,0,,...لتبرئة اسمي
Dialogue: 0,0:20:57.81,0:20:59.89,Thoughts,,0,0,0,,!يا له من مجهودٍ مُهدر
Dialogue: 0,0:21:07.49,0:21:08.13,Default,,0,0,0,,!تفضل
Dialogue: 0,0:21:09.25,0:21:11.33,Default,,0,0,0,,مثلجاتك المفضلة يا كايتو
Dialogue: 0,0:21:11.59,0:21:14.61,Default,,0,0,0,,!لا تفعلي أشياءًا لا تشبه شخصيتكِ
Dialogue: 0,0:21:15.47,0:21:16.93,Default,,0,0,0,,...حتى وإن خالف هذا شخصيتي
Dialogue: 0,0:21:17.09,0:21:18.45,Default,,0,0,0,,أوكو هي أوكو
Dialogue: 0,0:21:19.81,0:21:21.95,Default,,0,0,0,,يا إلهي، إنك بارد القلب
Dialogue: 0,0:21:23.39,0:21:24.89,Default,,0,0,0,,تمامًا كهذه المثلجات
Dialogue: 0,0:21:27.21,0:21:28.09,Default,,0,0,0,,...ولكن
Dialogue: 0,0:21:29.61,0:21:31.29,Default,,0,0,0,,...المثلجات
Dialogue: 0,0:21:34.49,0:21:36.03,Default,,0,0,0,,لذيذة
Dialogue: 0,0:21:36.39,0:21:37.56,Default,,0,0,0,,...كايتو
Dialogue: 0,0:22:05.93,0:22:09.11,Default,,0,0,0,,!يبدو بأن النهاية باتت جميلة بعد كل شيء
