Dialogue: 0,0:00:15.16,0:00:23.92,OP,,0,0,0,,لمَ تسير صوب المستقبل مُبهم العوالم بهذا الأمل؟
Dialogue: 0,0:00:24.12,0:00:33.17,OP,,0,0,0,,قلبي مُفعم بالحماس كما وكأنني مازلت أفكر بك
Dialogue: 0,0:00:33.42,0:00:42.31,OP,,0,0,0,,ما كان العائد عليك من الانفصال والدموع؟
Dialogue: 0,0:00:42.52,0:00:52.11,OP,,0,0,0,,صادفت رؤية القمر المنير والذي يُشاع عنه بأنه يُوصل دعواتي إليك
Dialogue: 0,0:00:52.86,0:00:57.28,OP,,0,0,0,,إنها صورة محفورة بذاكرتي، تعبر عن الذكريات الجميلة
Dialogue: 0,0:00:57.41,0:01:01.91,OP,,0,0,0,,مشهد مُماثل لعاصفةٍ صيفية   هذا ما يمكنني رؤيته
Dialogue: 0,0:01:02.12,0:01:06.58,OP,,0,0,0,,الحزن ظاهرة طبيعية          بينما الطمأنينة مجرد تطبّع
Dialogue: 0,0:01:06.79,0:01:12.21,OP,,0,0,0,,كلمة السر التي تحرر مشاعري     جدها من فضلك
Dialogue: 0,0:01:12.38,0:01:22.14,OP,,0,0,0,,كضوءٍ من المروج المتلاشية في الريح... غموض مُبهم
Dialogue: 0,0:01:23.31,0:01:27.73,OP,,0,0,0,,إنها صورة محفورة بذاكرتي، تعبر عن الذكريات الجميلة
Dialogue: 0,0:01:27.90,0:01:33.32,OP,,0,0,0,,مشهد مُماثل لعاصفةٍ صيفية   فلتجده رجاءً
Dialogue: 0,0:01:33.44,0:01:39.70,OP,,0,0,0,,{\fad(0,500)}كضوءٍ من المروج المتلاشية في الريح... غموض مُبهم
Dialogue: 0,0:22:46.74,0:22:55.79,ED,,0,0,0,,{\be2}{\be2}ولكنني أعلم بأنك كنت تمنع دموعك لكثير من الوقت
Dialogue: 0,0:22:56.91,0:23:05.75,ED,,0,0,0,,{\be2}{\be2}للحد الذي جعل قلبك قد شارف على الانكسار
Dialogue: 0,0:23:06.30,0:23:15.60,ED,,0,0,0,,{\be2}{\be2}حتى لو كنت تضع قناعًا فبمجرد النظر إلى عينيك
Dialogue: 0,0:23:16.06,0:23:21.27,ED,,0,0,0,,{\be2}{\be2}فسأعرف في الحال أنك محبوبي
Dialogue: 0,0:23:21.52,0:23:25.57,ED,,0,0,0,,{\be2}{\be2}يمكنك الاتكاء علي
Dialogue: 0,0:23:25.86,0:23:30.15,ED,,0,0,0,,{\be2}{\be2}مشاعرك قد وصلت إلي
Dialogue: 0,0:23:30.65,0:23:34.99,ED,,0,0,0,,{\be2}{\be2}يتردد صداها في قلبي
Dialogue: 0,0:23:35.66,0:23:40.37,ED,,0,0,0,,{\be2}{\be2}ليس عليك أن تتلفظ بكلمة
Dialogue: 0,0:23:40.54,0:23:45.04,ED,,0,0,0,,{\be2}{\be2}أعرف قلبك وأنا بجوارك تمامًا
Dialogue: 0,0:23:45.54,0:23:49.92,ED,,0,0,0,,{\be2}{\be2}على الرغم من بعدي عنك الآن
Dialogue: 0,0:23:50.42,0:23:54.84,ED,,0,0,0,,{\be2}{\be2}يسعني سماع صوت قلبك
Dialogue: 0,0:23:55.35,0:24:00.07,ED,,0,0,0,,{\be2}{\be2}ليس عليك أن تتلفظ بكلمة من أجل أن أفهم
Dialogue: 0,0:24:00.43,0:24:04.92,ED,,0,0,0,,{\be2}{\be2}فأنت صديقي العزيز دومًا {\fad(0,500)}
Dialogue: 0,0:00:01.30,0:00:03.04,Otanoshimi,,0,0,0,,أبق وجهك خالٍ من التعبيرات
Dialogue: 0,0:00:03.04,0:00:04.76,Otanoshimi,,0,0,0,,...حافظًا لتعليمات أبيه عن ظهر قلب
Dialogue: 0,0:00:04.76,0:00:06.52,Otanoshimi,,0,0,0,,يطير الساحر العجيب بين ناطحات السحاب
Dialogue: 0,0:00:06.52,0:00:08.79,Otanoshimi,,0,0,0,,!كايتو كيد فلتعد نفسك
Dialogue: 0,0:00:09.26,0:00:10.21,Otanoshimi,,0,0,0,,!أكاكو؟
Dialogue: 0,0:00:10.21,0:00:14.70,Otanoshimi,,0,0,0,,{\fad(0,500)\pos(472,1073)}!هدف اليوم هو قلب كايتو
Dialogue: 0,0:01:59.22,0:02:02.47,DCEpTitle,,0,0,0,,{\pos(969,295)}{\blur7.5}{\fad(300,00)}حبٌ على منحدر التـزلج في عشية يوم الميلاد
Dialogue: 0,0:02:12.87,0:02:14.00,Default,,0,0,0,,...يا عالم الجحيم
Dialogue: 0,0:02:14.53,0:02:16.87,Default,,0,0,0,,...يا من يهيمن على قدرات الظلام
Dialogue: 0,0:02:16.87,0:02:18.43,Default,,0,0,0,,...مدني بالقوة
Dialogue: 0,0:02:18.43,0:02:20.26,Default,,0,0,0,,مدني بالقوة
Dialogue: 0,0:02:31.22,0:02:32.81,Default,,0,0,0,,!اكتمل الأمر
Dialogue: 0,0:02:36.46,0:02:39.20,Default,,0,0,0,,غُمرتا هاتان الشاراتان بالسحر الأحمر
Dialogue: 0,0:02:39.54,0:02:43.04,Default,,0,0,0,,...من سيرتدونها يقعوا في حب بعضهم البعض في الحال
Dialogue: 0,0:02:43.04,0:02:45.66,Default,,0,0,0,,ويتحدان ليكونا رفيقين لا ينفصلا
Dialogue: 0,0:02:50.56,0:02:56.13,Default,,0,0,0,,كوروبا كايتو\Nسوف أجعل منك عبدًا لي للأبد
Dialogue: 0,0:02:59.24,0:03:01.05,Default,,0,0,0,,!الجو مشمس
Dialogue: 0,0:03:01.05,0:03:01.70,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:03:01.70,0:03:04.81,Default,,0,0,0,,درس تزلج في يوم الميلاد\Nأليس هذا رائعًا؟
Dialogue: 0,0:03:04.81,0:03:06.72,Default,,0,0,0,,صحيح\N!رائع حتمًا
Dialogue: 0,0:03:07.63,0:03:11.02,Default,,0,0,0,,يمكنني تخيل منحدر التزلج\N!والنجوم تملأ سماءه الآن
Dialogue: 0,0:03:11.58,0:03:12.84,Default,,0,0,0,,...نوعًا ما
Dialogue: 0,0:03:12.84,0:03:14.90,Default,,0,0,0,,...المعلمة هي الوحيدة الأكثر حماسًا
Dialogue: 0,0:03:17.73,0:03:19.60,Default,,0,0,0,,الجميع سعيد
Dialogue: 0,0:03:19.60,0:03:22.48,Default,,0,0,0,,...ولكن أوكو لا تعرف كيف تتزلج على الإطلاق
Dialogue: 0,0:03:23.00,0:03:24.35,Default,,0,0,0,,كايتو
Dialogue: 0,0:03:26.26,0:03:27.79,Default,,0,0,0,,هل سمعت بالأمر؟
Dialogue: 0,0:03:27.79,0:03:29.56,Default,,0,0,0,,لديهم ينابيع ساخنة هناك كذلك
Dialogue: 0,0:03:29.56,0:03:31.22,Default,,0,0,0,,!وهو حمام مشترك
Dialogue: 0,0:03:31.22,0:03:32.38,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:03:35.03,0:03:36.47,Default,,0,0,0,,يا له من شاب غافل
Dialogue: 0,0:03:36.47,0:03:38.85,Default,,0,0,0,,لا يعلم أنه سينتهي به الأمر أسيرًا لي\N...في لمح البصر
Dialogue: 0,0:03:38.85,0:03:40.13,Default,,0,0,0,,!آنسة أكاكو
Dialogue: 0,0:03:40.13,0:03:42.68,Default,,0,0,0,,هلا تفكرين رجاءًا بالتزلج برفقتي؟
Dialogue: 0,0:03:42.68,0:03:43.72,Default,,0,0,0,,!أكاكو-ساما انضمي إلي أنا
Dialogue: 0,0:03:43.72,0:03:44.35,Default,,0,0,0,,!لا، انضمي إلي
Dialogue: 0,0:03:44.35,0:03:45.76,Default,,0,0,0,,!لا، أنا
Dialogue: 0,0:03:51.36,0:03:53.90,Default,,0,0,0,,أيها السادة\N!عودوا إلى مقاعدكم
Dialogue: 0,0:04:14.55,0:04:16.38,Default,,0,0,0,,!ابتعد عن طريقي
Dialogue: 0,0:04:19.72,0:04:21.05,Default,,0,0,0,,...مؤلم
Dialogue: 0,0:04:21.38,0:04:23.90,Default,,0,0,0,,لا، لا\N!ليس بهذه السرعة
Dialogue: 0,0:04:33.65,0:04:36.11,Default,,0,0,0,,أيتها الغبية\N!توقفي في الحال
Dialogue: 0,0:04:36.11,0:04:38.56,Default,,0,0,0,,!إنكِ تصطدمين بي كثيرًا
Dialogue: 0,0:04:38.56,0:04:41.47,Default,,0,0,0,,...ليس الأمر كما لو أنني أفعل ذلك عن عمد
Dialogue: 0,0:04:43.48,0:04:46.16,Default,,0,0,0,,إنكِ لا تجيدي التزلج على الإطلاق\Nهذا مؤلم
Dialogue: 0,0:04:46.78,0:04:48.32,Default,,0,0,0,,لا يسعني فعل شيء، أليس كذلك؟
Dialogue: 0,0:04:48.32,0:04:49.91,Default,,0,0,0,,!مازلت مبتدئة
Dialogue: 0,0:04:49.91,0:04:51.52,Default,,0,0,0,,جدال المحبين مجددًا؟
Dialogue: 0,0:04:52.03,0:04:53.16,Default,,0,0,0,,!اذهبي للتزلج هناك
Dialogue: 0,0:04:53.16,0:04:56.08,Default,,0,0,0,,أنت من عليه أن يبتعد\N!عن المكان الذي تتجه إليه أوكو
Dialogue: 0,0:04:57.47,0:04:59.44,Default,,0,0,0,,ما الذي يفعلونه بحق الجحيم؟
Dialogue: 0,0:05:01.51,0:05:04.73,Thoughts,,0,0,0,,ومع ذلك\N...تلك المدعوة ناكاموري أوكو
Dialogue: 0,0:05:04.73,0:05:06.25,Thoughts,,0,0,0,,إنها حقًا قبيحة
Dialogue: 0,0:05:06.25,0:05:09.89,Thoughts,,0,0,0,,كلما حاولت التقرب منه\Nأجدها دائمًا بجواره تعيق طريقي
Dialogue: 0,0:05:10.25,0:05:11.82,Default,,0,0,0,,!والآن
Dialogue: 0,0:05:11.82,0:05:13.64,Default,,0,0,0,,!أرجو من الجميع الانتباه
Dialogue: 0,0:05:13.64,0:05:18.65,Default,,0,0,0,,حسنًا\N!أعددت حدثًا مثيرًا من أجل هذا المساء
Dialogue: 0,0:05:19.13,0:05:19.90,Default,,0,0,0,,حدث؟
Dialogue: 0,0:05:19.90,0:05:21.06,Default,,0,0,0,,لم أسمع عن هذا
Dialogue: 0,0:05:21.06,0:05:23.93,Default,,0,0,0,,بالطبع لم تفعل\Nفأنا سوف أعلن عنه الآن
Dialogue: 0,0:05:23.93,0:05:24.80,Default,,0,0,0,,حسنًا؟
Dialogue: 0,0:05:24.80,0:05:27.59,Default,,0,0,0,,:الحدث هو\N"مسابقة التزلج التنكرية في الليلة المقدسة"
Dialogue: 0,0:05:27.59,0:05:30.87,Default,,0,0,0,,على كل منكم إيجاد شريكًا\Nوالاستعداد للتزلج سويًّا كقرينين
Dialogue: 0,0:05:32.25,0:05:33.27,Default,,0,0,0,,قرينين؟
Dialogue: 0,0:05:33.27,0:05:33.99,Default,,0,0,0,,أتمزحين؟
Dialogue: 0,0:05:33.99,0:05:36.67,Default,,0,0,0,,حضرة المعلمة\Nألا يمكننا التزلج كقرينين ولكن من الإناث
Dialogue: 0,0:05:36.94,0:05:37.96,Default,,0,0,0,,لا يسعكم هذا
Dialogue: 0,0:05:37.96,0:05:40.59,Default,,0,0,0,,الزوج مكون من فتى وفتاة
Dialogue: 0,0:05:40.59,0:05:43.96,Default,,0,0,0,,يتركان أثر التزلج على المنحدر\N...ويتلألئان في الشفق
Dialogue: 0,0:05:43.96,0:05:45.97,Default,,0,0,0,,هناك يقبع عالم يتسع لشخصين فقط
Dialogue: 0,0:05:45.97,0:05:50.06,Default,,0,0,0,,سوف تكون صفحة لا تُنسى\N!في ألبوم شبابكم
Dialogue: 0,0:05:50.06,0:05:52.10,Default,,0,0,0,,!تخيلوا كم أن هذا رومانسي
Dialogue: 0,0:05:52.10,0:05:54.87,Default,,0,0,0,,حضرة المعلمة\N...يمكنني رؤية النجوم تحلق فوق رأسك
Dialogue: 0,0:05:54.87,0:05:58.45,Default,,0,0,0,,يا إلهي\Nما الذي يمكنني فعله؟ إنها فكرة جيدة طالما قلتها بنفسي
Dialogue: 0,0:06:01.53,0:06:02.13,Default,,0,0,0,,هذا كل شيء
Dialogue: 0,0:06:02.13,0:06:03.90,Default,,0,0,0,,تعجلوا وقرروا من سيكون شريككم
Dialogue: 0,0:06:04.28,0:06:07.30,Default,,0,0,0,,لقد أعددت لكم بعض الأزياء في النزل بالفعل\Nلذا اهتموا بالتفاصيل جميعًا
Dialogue: 0,0:06:07.90,0:06:10.89,Default,,0,0,0,,!ثمة جائزة ستُمنح للزوج الفائز
Dialogue: 0,0:06:11.64,0:06:13.04,Default,,0,0,0,,ماذا نفعل الآن؟
Dialogue: 0,0:06:13.84,0:06:15.96,Default,,0,0,0,,...رفيق إذًا
Dialogue: 0,0:06:15.96,0:06:18.92,Default,,0,0,0,,سمعت بأن الفصل الآخر سيعقد\Nمسابقة تزلج على الجليد
Dialogue: 0,0:06:18.92,0:06:21.88,Default,,0,0,0,,يا إلهي\N...إنني أحسدهم
Dialogue: 0,0:06:26.53,0:06:29.43,Default,,0,0,0,,يستحيل أن أتعاون مع مبتدئة مثلك، هل لديكِ شك بهذا؟
Dialogue: 0,0:06:29.43,0:06:29.97,Default,,0,0,0,,!حمقاء
Dialogue: 0,0:06:32.60,0:06:34.42,Default,,0,0,0,,ناكاموري\Nتعالي إلى هنا
Dialogue: 0,0:06:34.42,0:06:35.43,Default,,0,0,0,,!أكاكو-تشان
Dialogue: 0,0:06:36.81,0:06:38.10,Default,,0,0,0,,...ناكاموري-سان
Dialogue: 0,0:06:38.55,0:06:41.49,Default,,0,0,0,,إنك معجبة بـكوروبا، أليس كذلك؟
Dialogue: 0,0:06:43.04,0:06:44.34,Default,,0,0,0,,!مستحيل
Dialogue: 0,0:06:44.34,0:06:45.61,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:06:46.25,0:06:47.86,Default,,0,0,0,,إنني أحبه بالفعل
Dialogue: 0,0:06:48.57,0:06:53.44,Default,,0,0,0,,كوروبا ليس شخصًا بسيطًا كما تخالين
Dialogue: 0,0:06:53.44,0:06:55.58,Default,,0,0,0,,ما الذي تعنيه بهذا؟
Dialogue: 0,0:06:55.58,0:06:58.56,Default,,0,0,0,,إنه أكثر تعقيدًا وروعة من هذا
Dialogue: 0,0:06:58.56,0:06:59.44,Default,,0,0,0,,روعة؟
Dialogue: 0,0:06:59.44,0:07:03.54,Default,,0,0,0,,باختصار\Nشخص عادي مثلك ببساطة لا يصلح له
Dialogue: 0,0:07:04.23,0:07:09.36,Default,,0,0,0,,ما رأيك أن نتراهن؟\Nنتراهن على أي منا يمكنها مرافقته
Dialogue: 0,0:07:09.36,0:07:11.78,Default,,0,0,0,,...على الخاسر أن يتخلى عنه بشكل
Dialogue: 0,0:07:13.12,0:07:14.35,Default,,0,0,0,,علام تضحكين؟
Dialogue: 0,0:07:14.35,0:07:16.66,Default,,0,0,0,,!لأن هذا الشيء طريف للغاية
Dialogue: 0,0:07:16.66,0:07:20.51,Default,,0,0,0,,لم أتوقع أن تُعجب الجميلة أكاكو\N!بشاب كـكايتو
Dialogue: 0,0:07:20.51,0:07:22.60,Default,,0,0,0,,المدعو كايتو لابد وأنه مغناطيس نساء
Dialogue: 0,0:07:23.80,0:07:24.93,Default,,0,0,0,,...لقد أخطأتِ
Dialogue: 0,0:07:24.93,0:07:27.50,Default,,0,0,0,,أخبريني\Nما الرائع بشأن كايتو؟
Dialogue: 0,0:07:27.50,0:07:30.50,Default,,0,0,0,,!أخبريني، أخبريني\N...لا شيء جيد يقال
Dialogue: 0,0:07:31.50,0:07:33.32,Default,,0,0,0,,على كل حال\N!الرهان يظل قائمًا
Dialogue: 0,0:07:33.32,0:07:35.12,Default,,0,0,0,,لقد استحال وجهها ورديًا
Dialogue: 0,0:07:35.12,0:07:37.00,Default,,0,0,0,,!إن أكاكو لطيفة حتمًا
Dialogue: 0,0:07:37.77,0:07:39.35,Default,,0,0,0,,...فهمت
Dialogue: 0,0:07:39.35,0:07:40.94,Default,,0,0,0,,...فهمت، فهمـ
Dialogue: 0,0:07:44.40,0:07:46.13,Default,,0,0,0,,...فهمت
Dialogue: 0,0:07:52.35,0:07:53.30,Default,,0,0,0,,!فوجي
Dialogue: 0,0:07:53.30,0:07:55.30,Default,,0,0,0,,!أكاكو
Dialogue: 0,0:07:56.10,0:07:57.52,Default,,0,0,0,,...أكاكو
Dialogue: 0,0:07:57.52,0:08:00.41,Default,,0,0,0,,فوجي\N!لم أعلم بأنك مُعجب بـأكاكو
Dialogue: 0,0:08:00.41,0:08:02.02,Default,,0,0,0,,...لا فائدة مني
Dialogue: 0,0:08:02.02,0:08:04.74,Default,,0,0,0,,...كنت أعلم بأن شخصًا مثلي ليس جيدًا بالقدر الكافي
Dialogue: 0,0:08:04.74,0:08:07.93,Default,,0,0,0,,إنني نكرة وبدين\N...ناهيك عن ذكر فشلي في التزلج
Dialogue: 0,0:08:07.93,0:08:11.53,Default,,0,0,0,,وحاولت استجماع شجاعتي\N!وبذل قصارى جهدي اليوم
Dialogue: 0,0:08:11.53,0:08:12.32,Default,,0,0,0,,...ولكن
Dialogue: 0,0:08:12.32,0:08:16.92,Default,,0,0,0,,!يستحيل أن ترافقني أي فتاة بالعالم
Dialogue: 0,0:08:16.92,0:08:19.12,Default,,0,0,0,,...هذا ليس\N!هذا ليس صحيحًا على الإطلاق
Dialogue: 0,0:08:19.12,0:08:20.59,Default,,0,0,0,,...ولكن
Dialogue: 0,0:08:20.59,0:08:21.90,Default,,0,0,0,,...في هذه الحالة
Dialogue: 0,0:08:22.42,0:08:24.38,Default,,0,0,0,,لم لا تتزلج برفقة أوكو؟
Dialogue: 0,0:08:24.81,0:08:26.39,Default,,0,0,0,,المبتدؤون يتسكعون سويًا
Dialogue: 0,0:08:26.39,0:08:27.68,Default,,0,0,0,,فلنفعل ما بوسعنا\Nحسنًا؟
Dialogue: 0,0:08:27.68,0:08:30.59,Default,,0,0,0,,ولكن يا أوكو\N...لديك كايتو
Dialogue: 0,0:08:30.59,0:08:33.13,Default,,0,0,0,,لا صلة لهذا بالموضوع\N...كايتو برفقة أكا
Dialogue: 0,0:08:33.13,0:08:34.24,Default,,0,0,0,,لا يهم
Dialogue: 0,0:08:34.24,0:08:36.60,Default,,0,0,0,,أراهن بأنه سوف يتزلج مع محترفة أخرى
Dialogue: 0,0:08:40.48,0:08:42.44,Default,,0,0,0,,!أنت الرائع كالعادة يا كايتو
Dialogue: 0,0:08:46.35,0:08:47.26,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:08:48.45,0:08:49.86,Default,,0,0,0,,!أنا أولًا
Dialogue: 0,0:08:50.19,0:08:51.42,Default,,0,0,0,,!أراك لاحقًا
Dialogue: 0,0:08:51.89,0:08:53.28,Default,,0,0,0,,لم كان هذا؟
Dialogue: 0,0:08:57.70,0:09:00.14,signs,,0,0,0,,{\pos(1167,651)\frz347.9\fscx246\fscy189\c&HF7DED6&\4c&HFFFFFF&\4a&HFF&\3c&H909FAF&\3a&H00&}نقطة الاتصال الرابعة
Dialogue: 0,0:08:58.43,0:09:00.08,Default,,0,0,0,,كما هو متوقع من كوروبا
Dialogue: 0,0:09:00.65,0:09:02.91,Default,,0,0,0,,!كان هذا تزلجًا رائعًا
Dialogue: 0,0:09:00.14,0:09:04.06,signs,,0,0,0,,{\frz3.744\fscx126\fscy124\c&HBC9685&\3c&H000000&\3a&HFF&\4c&HFFFFFF&\4a&HFC&\fs120\pos(1644.333,23.333)}نقطة الاتصال الرابعة
Dialogue: 0,0:09:02.91,0:09:04.00,Default,,0,0,0,,...أكاكو
Dialogue: 0,0:09:05.85,0:09:07.68,Thoughts,,0,0,0,,...لا أفهم هذه الفتاة البتة
Dialogue: 0,0:09:08.42,0:09:10.33,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:09:10.33,0:09:11.46,Default,,0,0,0,,مجددًا؟
Dialogue: 0,0:09:12.38,0:09:15.77,Default,,0,0,0,,أيتها الحمقاء\Nلن يتحسن أداؤك، أليس كذلك؟
Dialogue: 0,0:09:15.77,0:09:18.18,Thoughts,,0,0,0,,...كايتو\Nوأكاكو؟
Dialogue: 0,0:09:18.53,0:09:20.68,Default,,0,0,0,,!فلتراقب لسانك
Dialogue: 0,0:09:20.68,0:09:23.62,Default,,0,0,0,,أوكو تبذل قصارى جهدها\Nحسنًا؟
Dialogue: 0,0:09:24.21,0:09:26.47,Default,,0,0,0,,لم لا تذهبي وتصنعي\Nرجل ثلج هناك؟
Dialogue: 0,0:09:26.47,0:09:28.40,Default,,0,0,0,,!ما الذي تعنيه بهذا؟
Dialogue: 0,0:09:27.58,0:09:28.40,Default,,0,0,0,,!توقفا
Dialogue: 0,0:09:30.90,0:09:31.65,Default,,0,0,0,,فوجي؟
Dialogue: 0,0:09:34.48,0:09:35.90,Default,,0,0,0,,...لقد تذكرت يا أوكو
Dialogue: 0,0:09:35.90,0:09:37.63,Default,,0,0,0,,لم تقرري بعد، أليس كذلك؟
Dialogue: 0,0:09:37.63,0:09:38.65,Default,,0,0,0,,أقرر ماذا؟
Dialogue: 0,0:09:38.65,0:09:41.75,Default,,0,0,0,,اختيار رفيق المسابقة التي لا أعلم اسمها الليلة
Dialogue: 0,0:09:42.10,0:09:44.54,Default,,0,0,0,,لا خيار لدي\N!أعتقد أنني سوف أرافقك وحسب
Dialogue: 0,0:09:49.66,0:09:52.30,Default,,0,0,0,,لقد قطعت أوكو وعدًا لـفوجي بأن ترافقه
Dialogue: 0,0:09:52.30,0:09:54.04,Default,,0,0,0,,مع فوجي؟
Dialogue: 0,0:09:54.04,0:09:55.30,Default,,0,0,0,,مهلًا ومن هذا؟
Dialogue: 0,0:09:55.30,0:09:57.00,Default,,0,0,0,,لقد أخبرتك للتو\N...أوكو و
Dialogue: 0,0:09:57.42,0:09:58.65,Default,,0,0,0,,فوجي
Dialogue: 0,0:10:05.12,0:10:07.79,Default,,0,0,0,,!إنه الشخص المناسب لكِ يا ناكاموري
Dialogue: 0,0:10:07.79,0:10:09.69,Default,,0,0,0,,!الآن فلنذهب
Dialogue: 0,0:10:16.58,0:10:18.02,Default,,0,0,0,,!الوداع
Dialogue: 0,0:10:18.02,0:10:21.75,Default,,0,0,0,,يجدر بكما الذهاب وصنع رجل ثلج أو شيء من هذا القبيل
Dialogue: 0,0:10:49.36,0:10:50.85,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,0:10:50.85,0:10:52.74,Default,,0,0,0,,تبدو متوترًا منذ بعض الوقت
Dialogue: 0,0:10:52.74,0:10:54.95,Default,,0,0,0,,لست متوترًا على الإطلاق
Dialogue: 0,0:10:56.05,0:10:57.63,Default,,0,0,0,,!يا لك من شاب لطيف
Dialogue: 0,0:10:57.63,0:11:00.12,Default,,0,0,0,,هل تقبل شرف مرافقتي؟
Dialogue: 0,0:11:00.12,0:11:01.54,Default,,0,0,0,,أجل\Nأيًا يكن
Dialogue: 0,0:11:01.54,0:11:03.31,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:11:03.31,0:11:05.01,Default,,0,0,0,,!انظر إلى رداء التزلج الخاص بي
Dialogue: 0,0:11:05.01,0:11:05.78,Default,,0,0,0,,أليس لطيفًا؟
Dialogue: 0,0:11:05.78,0:11:07.67,Default,,0,0,0,,أجل\Nأيًا يكن
Dialogue: 0,0:11:09.58,0:11:11.75,Default,,0,0,0,,انظر\N!يا له من منظر بديع
Dialogue: 0,0:11:11.75,0:11:13.76,Default,,0,0,0,,أجل\Nأيًا يكن
Dialogue: 0,0:11:15.30,0:11:18.94,Thoughts,,0,0,0,,أيعقل أن هذا الشاب لم يخضع لتعويذتي؟
Dialogue: 0,0:11:18.94,0:11:20.21,Thoughts,,0,0,0,,أيعقل أن يكون بهذا الجمود؟
Dialogue: 0,0:11:20.77,0:11:22.14,Default,,0,0,0,,!انظر إلي الآن
Dialogue: 0,0:11:23.08,0:11:25.05,Default,,0,0,0,,يبدو أنك كنت شارد الذهن
Dialogue: 0,0:11:25.05,0:11:29.50,Default,,0,0,0,,فـكايتو كيد العظيم لا يسعه حتى تمالك\Nنفسه في وجود تلك الفتاة بالجوار؟
Dialogue: 0,0:11:30.02,0:11:31.56,Default,,0,0,0,,...ليس لدي فكرة عما تتحدثين عنه
Dialogue: 0,0:11:31.56,0:11:34.97,Default,,0,0,0,,على الرغم من أن ما أقوله ليس مبهمًا البتة
Dialogue: 0,0:11:34.97,0:11:37.76,Default,,0,0,0,,ما رأيك لو رافقتك للأبد في هذه الحالة؟
Dialogue: 0,0:11:37.76,0:11:38.71,Default,,0,0,0,,!فهمت
Dialogue: 0,0:11:38.71,0:11:40.84,Default,,0,0,0,,فهمت\N!سوف أرافقك
Dialogue: 0,0:11:40.84,0:11:43.16,Default,,0,0,0,,يا إلهي\N!احمرار وجهك مثير
Dialogue: 0,0:11:43.83,0:11:47.03,Thoughts,,0,0,0,,إذًا فشارتي السحرية تعمل بالفعل
Dialogue: 0,0:11:47.03,0:11:50.58,Thoughts,,0,0,0,,لصقها على كلينا سوف يجعلنا نحب\N!بعضنا ونترافق بلا انفصال
Dialogue: 0,0:11:52.90,0:11:54.33,Thoughts,,0,0,0,,...هذه الفتاة
Dialogue: 0,0:11:54.33,0:11:56.00,Thoughts,,0,0,0,,...ليست نوعي المفضل
Dialogue: 0,0:12:02.35,0:12:04.63,Default,,0,0,0,,...يا للملل
Dialogue: 0,0:12:04.63,0:12:07.16,Default,,0,0,0,,هذا ممل للغاية
Dialogue: 0,0:12:07.16,0:12:08.66,Default,,0,0,0,,أليس هذا حمامًا مختلطًا؟
Dialogue: 0,0:12:08.66,0:12:12.27,Default,,0,0,0,,لا بأس\Nلقد تفقدت سابقًا ولم يكن هناك أحد
Dialogue: 0,0:12:12.75,0:12:14.22,Default,,0,0,0,,أسرعي يا أوكو
Dialogue: 0,0:12:14.22,0:12:15.39,Default,,0,0,0,,أسرعي وانزلي إلى الماء
Dialogue: 0,0:12:15.39,0:12:17.15,Default,,0,0,0,,يؤلمني جسدي كله بشكل ما
Dialogue: 0,0:12:17.15,0:12:19.72,Default,,0,0,0,,!أوكو
Dialogue: 0,0:12:20.25,0:12:21.07,Default,,0,0,0,,...هذا سيئ
Dialogue: 0,0:12:22.35,0:12:23.85,Default,,0,0,0,,!يا له من إحساس مريح
Dialogue: 0,0:12:23.85,0:12:24.98,Default,,0,0,0,,!رائع
Dialogue: 0,0:12:27.76,0:12:30.30,Default,,0,0,0,,انظروا\Nثمة شخص ما هناك
Dialogue: 0,0:12:32.88,0:12:36.24,Default,,0,0,0,,هل تتحدثون عني؟
Dialogue: 0,0:12:36.24,0:12:38.18,Default,,0,0,0,,!صوت مبحوح لطيف
Dialogue: 0,0:12:38.18,0:12:40.43,Default,,0,0,0,,إنها مجرد فتاة
Dialogue: 0,0:12:41.39,0:12:44.84,Default,,0,0,0,,أخبريني يا أوكو، لم لم ترافقي كايتو؟
Dialogue: 0,0:12:44.84,0:12:46.30,Default,,0,0,0,,صحيح\Nلماذا لم تفعلي؟
Dialogue: 0,0:12:46.68,0:12:50.00,Default,,0,0,0,,لأن أوكو لا تجيد التزلج
Dialogue: 0,0:12:50.54,0:12:52.53,Default,,0,0,0,,هل استسلمتِ بسبب هذا؟
Dialogue: 0,0:12:52.53,0:12:54.56,Default,,0,0,0,,...ليس استسلامًا
Dialogue: 0,0:12:54.56,0:12:55.99,Default,,0,0,0,,الأمر وما فيه أن كايتو محترف
Dialogue: 0,0:12:55.99,0:12:58.70,Default,,0,0,0,,لو أنه تزلج برفقة أوكو فسوف يحرج نفسه
Dialogue: 0,0:12:58.70,0:13:04.02,Default,,0,0,0,,وأنا التي ظننت بأن كايتو لعب دور مدربك الخاص
Dialogue: 0,0:13:04.02,0:13:05.21,Default,,0,0,0,,!وأنا كذلك
Dialogue: 0,0:13:05.21,0:13:08.51,Default,,0,0,0,,ولكن مجددًا\Nلم لم يدعوكِ كايتو لمرافقته؟
Dialogue: 0,0:13:08.51,0:13:10.83,Default,,0,0,0,,كايتو مازال كالطفل ألا تظنون هذا؟
Dialogue: 0,0:13:10.83,0:13:11.96,Default,,0,0,0,,!أحسنت قولًا
Dialogue: 0,0:13:11.96,0:13:12.87,Default,,0,0,0,,!مازال طفلًا
Dialogue: 0,0:13:13.59,0:13:15.04,Thoughts,,0,0,0,,...هذا لا يخصكن على الإطلاق
Dialogue: 0,0:13:15.67,0:13:18.66,Default,,0,0,0,,على الرغم من هذا مازال به الكثير من الخير
Dialogue: 0,0:13:18.66,0:13:21.62,Default,,0,0,0,,عندما كان كايتو صبيًا صغيرًا فقد والده
Dialogue: 0,0:13:21.62,0:13:23.04,Default,,0,0,0,,أوكو تعلم هذا
Dialogue: 0,0:13:23.97,0:13:25.33,Default,,0,0,0,,...كايتو
Dialogue: 0,0:13:25.33,0:13:27.39,Default,,0,0,0,,...كان يحب والده كثيرًا
Dialogue: 0,0:13:30.20,0:13:33.49,Default,,0,0,0,,على الرغم من هذا\Nلم يظهر تعبيرًا كئيبًا قط
Dialogue: 0,0:13:33.49,0:13:35.22,Default,,0,0,0,,يقوم بأشياء حمقاء طوال الوقت بدلًا عن هذا، أليس كذلك؟
Dialogue: 0,0:13:38.23,0:13:40.34,Default,,0,0,0,,ولهذا\N...كيف أصيغ الأمر
Dialogue: 0,0:13:40.34,0:13:42.48,Default,,0,0,0,,...كصديقة طفولته
Dialogue: 0,0:13:42.48,0:13:45.94,Default,,0,0,0,,أحيانًا أود بالفعل أن يبدو كايتو\Nرائعًا ويحصل على كل المجد
Dialogue: 0,0:13:48.37,0:13:50.44,Default,,0,0,0,,لهذا لا يزعجني تفضيله لصالحه\Nهكذا الأمر
Dialogue: 0,0:13:50.44,0:13:51.28,Default,,0,0,0,,!هذا ليس جيدًا على الإطلاق
Dialogue: 0,0:13:51.28,0:13:52.44,Default,,0,0,0,,!ليس جيدًا على الإطلاق
Dialogue: 0,0:13:55.70,0:13:57.18,Default,,0,0,0,,!ليس جيدًا على الإطلاق
Dialogue: 0,0:14:03.89,0:14:07.04,Default,,0,0,0,,!مستحيل أن أرتدي مثل هذا الزي
Dialogue: 0,0:14:06.03,0:14:07.04,Default,,0,0,0,,!توقفي عن البكاء
Dialogue: 0,0:14:08.99,0:14:09.96,Default,,0,0,0,,...الجو حار للغاية
Dialogue: 0,0:14:10.79,0:14:13.38,Default,,0,0,0,,تمهل \Nفلتثبت لبعض الوقت
Dialogue: 0,0:14:22.54,0:14:25.15,Default,,0,0,0,,ما الذي عنته بـ"لا يزعجني هذا"؟
Dialogue: 0,0:14:33.16,0:14:34.62,Default,,0,0,0,,ما هذا بحق الجحيم؟
Dialogue: 0,0:14:39.51,0:14:40.94,Thoughts,,0,0,0,,...أحقًا
Dialogue: 0,0:14:40.94,0:14:42.42,Thoughts,,0,0,0,,لا يزعجني الأمر؟
Dialogue: 0,0:14:49.87,0:14:51.29,Thoughts,,0,0,0,,...أحقًا
Dialogue: 0,0:14:51.29,0:14:53.09,Thoughts,,0,0,0,,يمكنني فعل هذا؟
Dialogue: 0,0:14:53.12,0:14:55.54,signs,,0,0,0,,{\fs70\frx54\fry354\frz323.8\c&H000000&\3c&H000000&\3a&HFF&\4c&HFFFFFF&\4a&HEA&\pos(761.905,336.667)}إلى أكاكو ساما
Dialogue: 0,0:15:10.59,0:15:12.56,Default,,0,0,0,,!كايتو كيد يعتلي المسرح
Dialogue: 0,0:15:16.10,0:15:18.05,Default,,0,0,0,,...أراهن أن أوكو
Dialogue: 0,0:15:18.05,0:15:21.87,Default,,0,0,0,,قالت شيئًا عن النصر الأكيد\Nعند ارتداء زي كيد والمفتش ناكاموري، أليس كذلك؟
Dialogue: 0,0:15:22.54,0:15:24.20,Default,,0,0,0,,!هذا صحيح بالفعل
Dialogue: 0,0:15:24.95,0:15:27.58,Default,,0,0,0,,ولكن معدتك\Nأهي أكبر من الطبيعي؟
Dialogue: 0,0:15:29.87,0:15:32.14,Default,,0,0,0,,هذه من أجل أكاكو
Dialogue: 0,0:15:32.14,0:15:34.38,Default,,0,0,0,,...ولكن لا يسعني استجماع شجاعتي
Dialogue: 0,0:15:34.38,0:15:35.89,Default,,0,0,0,,ولكن\N...ولكن
Dialogue: 0,0:15:35.89,0:15:38.36,Default,,0,0,0,,أعطتني أوكو بعض كلمات التشجيع
Dialogue: 0,0:15:38.36,0:15:39.74,Default,,0,0,0,,...لهذا
Dialogue: 0,0:15:39.74,0:15:41.17,Default,,0,0,0,,...لهذا
Dialogue: 0,0:15:42.15,0:15:45.06,Default,,0,0,0,,!تريد أوكو التزلج برفقتك في الواقع
Dialogue: 0,0:15:47.33,0:15:48.48,Default,,0,0,0,,أعرف هذا
Dialogue: 0,0:15:49.34,0:15:50.65,Default,,0,0,0,,لدي هدية من أجلك يا فوجي
Dialogue: 0,0:15:53.15,0:15:53.77,Default,,0,0,0,,تفضل
Dialogue: 0,0:15:54.72,0:15:55.94,Default,,0,0,0,,!...هذا
Dialogue: 0,0:15:56.79,0:16:00.37,Default,,0,0,0,,!سوف أنهمك في العمل الآن
Dialogue: 0,0:16:01.29,0:16:03.30,Default,,0,0,0,,!حسنًا انتبهوا جميعًا
Dialogue: 0,0:16:03.30,0:16:08.12,Default,,0,0,0,,مسابقة التزلج التنكرية للأزواج\N!في الليلة المقدسة سوف تبدأ
Dialogue: 0,0:16:11.17,0:16:14.13,Default,,0,0,0,,أتساءل أين ذهب فوجي؟
Dialogue: 0,0:16:14.48,0:16:16.67,Default,,0,0,0,,الآن الفريق الأول
Dialogue: 0,0:16:16.67,0:16:18.76,Default,,0,0,0,,زوج الباندا\N!لينغ لينغ وشين شين
Dialogue: 0,0:16:18.76,0:16:20.97,Default,,0,0,0,,!فلنبدأ الآن
Dialogue: 0,0:16:20.97,0:16:21.58,Default,,0,0,0,,أجل
Dialogue: 0,0:16:31.76,0:16:33.68,LT,,0,0,0,,لجنة التحكيم
Dialogue: 0,0:16:33.66,0:16:36.23,Default,,0,0,0,,!مصاص الدماء والمستذئبة
Dialogue: 0,0:16:36.23,0:16:38.15,Default,,0,0,0,,!الطبيب والممرضة
Dialogue: 0,0:16:40.08,0:16:41.84,Default,,0,0,0,,!الأخطبوط والدجاجة
Dialogue: 0,0:16:44.42,0:16:46.83,Default,,0,0,0,,!الديناصور والنحلة
Dialogue: 0,0:16:48.26,0:16:50.66,Default,,0,0,0,,!يايبا المقنع والوحش
Dialogue: 0,0:16:53.65,0:16:55.51,Default,,0,0,0,,يا إلهي يا ناكاموري-سان
Dialogue: 0,0:16:57.32,0:16:59.43,Default,,0,0,0,,ماذا حلّ برفيقك؟
Dialogue: 0,0:16:59.90,0:17:02.35,Default,,0,0,0,,على كل حال\Nفقد فُزت بالرهان، أليس كذلك؟
Dialogue: 0,0:17:02.81,0:17:04.75,Default,,0,0,0,,...الفريق رقم 18
Dialogue: 0,0:17:04.75,0:17:06.99,Default,,0,0,0,,!ملكة الثلج واليتي الملك
Dialogue: 0,0:17:07.56,0:17:09.43,Default,,0,0,0,,ابذل قصارى جهدك يا كايتو
Dialogue: 0,0:17:10.78,0:17:13.19,Default,,0,0,0,,الآن فلنكمل يا كوروبا
Dialogue: 0,0:17:15.36,0:17:18.81,Default,,0,0,0,,!أمتعي عيناك بمهاراتنا  الرائعة في التزلج
Dialogue: 0,0:17:30.04,0:17:31.44,Default,,0,0,0,,فوجي؟
Dialogue: 0,0:17:31.44,0:17:32.09,Default,,0,0,0,,لماذا؟
Dialogue: 0,0:17:33.77,0:17:35.04,Default,,0,0,0,,...أكاكو-ساما
Dialogue: 0,0:17:42.35,0:17:43.94,Default,,0,0,0,,ما خطبي؟
Dialogue: 0,0:17:43.94,0:17:45.82,Thoughts,,0,0,0,,...صورته في عيني
Dialogue: 0,0:17:45.82,0:17:48.86,Thoughts,,0,0,0,,...بشكل ما تختلف عن العادة
Dialogue: 0,0:17:48.86,0:17:50.07,Default,,0,0,0,,...أكاكو
Dialogue: 0,0:17:50.07,0:17:51.61,Thoughts,,0,0,0,,!كما لو أنه يشع ضوئًا
Dialogue: 0,0:17:53.38,0:17:54.52,Default,,0,0,0,,!ميلادًا مجيدًا
Dialogue: 0,0:17:54.91,0:17:56.03,Default,,0,0,0,,من أجلي؟
Dialogue: 0,0:17:56.03,0:17:56.96,Default,,0,0,0,,!أجل
Dialogue: 0,0:17:56.96,0:17:58.61,Default,,0,0,0,,!شكرًا يا فوجي
Dialogue: 0,0:17:58.61,0:18:00.44,Default,,0,0,0,,الآن\Nدع الأمر لي
Dialogue: 0,0:18:10.75,0:18:13.39,Default,,0,0,0,,كويزومي أكاكو\N!تقدم مذهل
Dialogue: 0,0:18:13.39,0:18:15.45,Default,,0,0,0,,!هذا هو نوع تزلج الأزواج الذي أتحدث عنه
Dialogue: 0,0:18:15.45,0:18:17.24,Default,,0,0,0,,!كما هو متوقع من أكاكو
Dialogue: 0,0:18:17.24,0:18:19.13,Default,,0,0,0,,لم ليست برفقتي؟
Dialogue: 0,0:18:19.54,0:18:21.05,Default,,0,0,0,,!تسع وثلاثون نقطة
Dialogue: 0,0:18:21.76,0:18:23.75,Default,,0,0,0,,!إنه أعلى تقدير
Dialogue: 0,0:18:23.75,0:18:25.12,Default,,0,0,0,,!يا فوجي-كن
Dialogue: 0,0:18:25.12,0:18:25.97,Default,,0,0,0,,!أكاكو-ساما
Dialogue: 0,0:18:26.55,0:18:28.41,Default,,0,0,0,,ماذا حدث لـأوكو؟
Dialogue: 0,0:18:28.41,0:18:29.89,Default,,0,0,0,,لم يظهر كايتو كذلك
Dialogue: 0,0:18:29.89,0:18:31.29,Default,,0,0,0,,!أكاكو-ساما
Dialogue: 0,0:18:31.29,0:18:32.31,Default,,0,0,0,,!لم أتوقع أقل من هذا
Dialogue: 0,0:18:32.72,0:18:34.24,Default,,0,0,0,,أتساءل عما يفعلانه؟
Dialogue: 0,0:18:34.24,0:18:36.24,Default,,0,0,0,,...والشمس تغرب كذلك
Dialogue: 0,0:18:42.07,0:18:44.58,Thoughts,,0,0,0,,...الآن لا يسعني رؤية أي شيء
Dialogue: 0,0:18:47.93,0:18:49.92,Thoughts,,0,0,0,,...كيف له ألا
Dialogue: 0,0:18:50.48,0:18:52.91,Thoughts,,0,0,0,,يدعو أوكو للتزلج معه في وقتٍ أقرب؟
Dialogue: 0,0:18:56.33,0:18:57.75,Default,,0,0,0,,...كايتو
Dialogue: 0,0:18:57.75,0:19:01.69,Default,,0,0,0,,!هو وغد أحمق
Dialogue: 0,0:19:04.80,0:19:06.85,Default,,0,0,0,,اعتذاري على كوني وغدًا أحمقًا
Dialogue: 0,0:19:11.79,0:19:13.19,Default,,0,0,0,,!كايتو كيد؟
Dialogue: 0,0:19:16.65,0:19:17.57,Default,,0,0,0,,...كايتو
Dialogue: 0,0:19:17.57,0:19:18.03,Default,,0,0,0,,أهذا أنت؟
Dialogue: 0,0:19:18.81,0:19:21.49,Default,,0,0,0,,انتهى فوجي ومحبوبته أكاكو من التزلج للتو
Dialogue: 0,0:19:21.49,0:19:23.04,Default,,0,0,0,,...كايتو
Dialogue: 0,0:19:23.04,0:19:24.74,Default,,0,0,0,,...تبدو تمامًا كـكيد الحقيقي
Dialogue: 0,0:19:24.74,0:19:25.97,Default,,0,0,0,,!حمقاء
Dialogue: 0,0:19:25.97,0:19:27.66,Default,,0,0,0,,!أنا أكثر روعة من الحقيقي
Dialogue: 0,0:19:27.98,0:19:30.85,Default,,0,0,0,,على الرغم من هذا\Nألا يسعك فعل شيء بخصوص هذا؟
Dialogue: 0,0:19:30.85,0:19:32.00,Default,,0,0,0,,زيك
Dialogue: 0,0:19:32.00,0:19:33.83,Default,,0,0,0,,...على الأقل
Dialogue: 0,0:19:35.41,0:19:37.67,Default,,0,0,0,,!لا تقبلي بأقل من هذا
Dialogue: 0,0:19:42.86,0:19:44.61,Default,,0,0,0,,!هل لمست مؤخرتي للتو؟
Dialogue: 0,0:19:44.61,0:19:45.93,Default,,0,0,0,,لم ألمس أي شيء
Dialogue: 0,0:19:46.82,0:19:48.48,Default,,0,0,0,,والآن\Nفلنبدأ هذا
Dialogue: 0,0:19:48.48,0:19:49.88,Default,,0,0,0,,...الفريق الأخير
Dialogue: 0,0:19:49.88,0:19:52.36,Default,,0,0,0,,!كايتو كيد والأميرة ناكاموري
Dialogue: 0,0:19:52.36,0:19:54.35,Default,,0,0,0,,...ولكن أوكو لا تجيد التزلج
Dialogue: 0,0:19:54.35,0:19:56.65,Default,,0,0,0,,هذا خطأ\Nأوكو يمكنها التزلج
Dialogue: 0,0:19:57.24,0:20:00.81,Default,,0,0,0,,لقد وقعتي في الكثير من المرات حتى الآن\Nإذًا فلا يجب أن تكوني خائفة، أليس كذلك؟
Dialogue: 0,0:20:00.81,0:20:04.46,Default,,0,0,0,,فقط استرخي وتخيلي نفسك تتزلجين بثقة\N!يمكنك فعلها
Dialogue: 0,0:20:07.16,0:20:07.83,Default,,0,0,0,,!عظيم
Dialogue: 0,0:20:15.59,0:20:17.01,Default,,0,0,0,,!إنه كايتو
Dialogue: 0,0:20:17.01,0:20:18.50,Default,,0,0,0,,!إنه سحر كايتو
Dialogue: 0,0:20:31.36,0:20:34.33,Thoughts,,0,0,0,,...لم أتوقع أن يتنكر في زي كايتو كيد عن عمد
Dialogue: 0,0:20:34.33,0:20:35.86,Thoughts - up,,0,0,0,,...يا له من رجل وقح
Dialogue: 0,0:20:43.32,0:20:44.74,Default,,0,0,0,,!يا إلهي
Dialogue: 0,0:20:49.70,0:20:51.89,Default,,0,0,0,,!ها نحن ننطلق
Dialogue: 0,0:20:59.15,0:21:00.41,Default,,0,0,0,,!لقد فازوا بالنتيجة الأفضل
Dialogue: 0,0:21:00.41,0:21:02.33,Default,,0,0,0,,كوروبا كايتو\N!وناكاموري أوكو
Dialogue: 0,0:21:07.26,0:21:08.63,Default,,0,0,0,,!لقد فعلتها
Dialogue: 0,0:21:11.26,0:21:14.34,Thoughts,,0,0,0,,لقد هزمني كليًا\N...هذا المدعو كوروبا كايتو
Dialogue: 0,0:21:14.34,0:21:17.23,Thoughts,,0,0,0,,!لم أتوقع أن أقع تحت تأثير سحري
Dialogue: 0,0:21:19.41,0:21:22.29,Default,,0,0,0,,ولكن ألا يعني هذا أن سحري مازال لا يهزم؟
Dialogue: 0,0:21:25.24,0:21:26.86,Default,,0,0,0,,!مبارك
Dialogue: 0,0:21:28.67,0:21:30.07,Default,,0,0,0,,!شكرًا، شكرًا
Dialogue: 0,0:21:32.50,0:21:34.31,Default,,0,0,0,,!إنك حقًا حمقاء
Dialogue: 0,0:21:34.31,0:21:35.71,Default,,0,0,0,,لم هذه القسوة\N...يا إلهي
Dialogue: 0,0:21:36.72,0:21:39.79,Default,,0,0,0,,إن بقيتِ على حالكِ هذا؛ فلن تتمكني أبدًا من مواكبتي
Dialogue: 0,0:21:41.17,0:21:42.50,Default,,0,0,0,,يا حضرة المفتشة
Dialogue: 0,0:21:43.89,0:21:47.09,Default,,0,0,0,,كايتو كيد\N!سوف أقبض عليك هذه المرة حتمًا
Dialogue: 0,0:21:51.11,0:21:53.80,Thoughts,,0,0,0,,...ما معنى هذا
Dialogue: 0,0:22:05.98,0:22:06.94,Default,,0,0,0,,...هذا
Dialogue: 0,0:22:06.94,0:22:09.86,Default,,0,0,0,,إنه من صناعة يدي\Nتمثال أكاكو
Dialogue: 0,0:22:13.29,0:22:14.73,Default,,0,0,0,,!أكاكو-ساما
Dialogue: 0,0:22:16.04,0:22:18.42,Default,,0,0,0,,!ميلاد مجيد يا أكاكو-ساما
Dialogue: 0,0:22:18.42,0:22:20.16,Default,,0,0,0,,!رجاءًا اقبلي هديتي
Dialogue: 0,0:22:20.16,0:22:22.22,Default,,0,0,0,,!وهديتي كذلك يا أكاكو-ساما
Dialogue: 0,0:22:22.22,0:22:23.58,Default,,0,0,0,,!تفضلي بالقبول
Dialogue: 0,0:22:23.58,0:22:25.47,Default,,0,0,0,,!أكاكو-ساما
