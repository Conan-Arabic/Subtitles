Dialogue: 0,0:00:38.05,0:00:39.93,Default,,0,0,0,,!لطالما انتظرت يا كايتو كيد
Dialogue: 0,0:00:39.93,0:00:42.27,Default,,0,0,0,,!لقد مضت ثمانية أعوام حتى اللحظة
Dialogue: 0,0:00:42.27,0:00:43.89,Default,,0,0,0,,!سأقبض عليك هذه المرة
Dialogue: 0,0:00:50.36,0:00:51.85,Default,,0,0,0,,!اللعنة
Dialogue: 0,0:00:52.93,0:00:54.85,Default,,0,0,0,,!لا تتجمدوا بأماكنكم هكذا\N!اقبضوا عليه! اقبضوا عليه
Dialogue: 0,0:00:58.31,0:00:59.72,Default,,0,0,0,,!"الفريق "آلفا
Dialogue: 0,0:00:59.72,0:01:01.27,Default,,0,0,0,,!اذهبوا للمنطقة بي3 القابعة في الدور الخامس
Dialogue: 0,0:01:01.60,0:01:03.64,Default,,0,0,0,,!الفريق "بيتا"، اتجهوا للمنطقة سي6
Dialogue: 0,0:01:08.43,0:01:09.39,Default,,0,0,0,,!لقد تلاشى
Dialogue: 0,0:01:09.39,0:01:10.56,Default,,0,0,0,,!هذا لا يعقل
Dialogue: 0,0:01:14.06,0:01:15.18,Default,,0,0,0,,لمَ كل هذه الجلبة؟
Dialogue: 0,0:01:21.14,0:01:22.31,Default,,0,0,0,,!ها أنت ذا يا كيد
Dialogue: 0,0:01:49.06,0:01:52.02,Default,,0,0,0,,...يا كيد، كم مر على اشتياقي لـ
Dialogue: 0,0:01:52.02,0:01:53.43,Default,,0,0,0,,...كلا، ما أعنيه هو
Dialogue: 0,0:01:53.43,0:01:55.31,Default,,0,0,0,,كم مر وأنا أسعى خلفك؟
Dialogue: 0,0:01:55.77,0:01:58.18,Default,,0,0,0,,!أنا، ناكاموري جيننزو، لن أتعثر بهذه المكيدة التافهة
Dialogue: 0,0:02:04.77,0:02:05.77,Default,,0,0,0,,!لقد اختفى جسدك
Dialogue: 0,0:02:20.72,0:02:21.72,Default,,0,0,0,,هل رأيت هذا؟
Dialogue: 0,0:02:22.02,0:02:23.18,Default,,0,0,0,,!كايتو كيد
Dialogue: 0,0:02:23.18,0:02:24.52,Default,,0,0,0,,!إنه الأروع
Dialogue: 0,0:02:24.85,0:02:25.72,Default,,0,0,0,,مرحبًا يا كايتو
Dialogue: 0,0:02:26.64,0:02:27.52,Default,,0,0,0,,!كوروبا-كن
Dialogue: 0,0:02:27.52,0:02:28.47,Default,,0,0,0,,صباح الخير يا كايتو-كن
Dialogue: 0,0:02:28.81,0:02:30.56,Default,,0,0,0,,هل رأيتِ الأخبار؟
Dialogue: 0,0:02:30.56,0:02:32.02,Default,,0,0,0,,بشأن كايتو كيد؟
Dialogue: 0,0:02:32.02,0:02:32.93,Default,,0,0,0,,!إنه مذهل بحق
Dialogue: 0,0:02:33.52,0:02:34.06,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:02:34.06,0:02:34.64,Default,,0,0,0,,...كايتو
Dialogue: 0,0:02:35.81,0:02:38.35,Default - up,,0,0,0,,...إلامَ\N...توقف عن التحديق بهذه الطريقة
Dialogue: 0,0:02:38.77,0:02:40.39,Default,,0,0,0,,صباح الخير يا أوكو
Dialogue: 0,0:02:41.85,0:02:42.27,Default,,0,0,0,,...صباح الخير
Dialogue: 0,0:02:44.47,0:02:45.18,Default,,0,0,0,,كايتو؟
Dialogue: 0,0:02:45.56,0:02:47.60,Default,,0,0,0,,...ما هو
Dialogue: 0,0:02:47.93,0:02:50.52,Default,,0,0,0,,...لون
Dialogue: 0,0:02:49.89,0:02:50.52,Default,,0,0,0,,...رقبته
Dialogue: 0,0:02:50.81,0:02:51.72,Default,,0,0,0,,اليوم؟
Dialogue: 0,0:02:54.47,0:02:56.06,Default,,0,0,0,,!إنه الأبيض
Dialogue: 0,0:02:56.06,0:02:57.81,Default,,0,0,0,,!الأبيض جميل ونقي جدًا
Dialogue: 0,0:03:00.31,0:03:01.68,Default,,0,0,0,,!كايتو
Dialogue: 0,0:03:02.14,0:03:03.60,Default,,0,0,0,,...لمَ أنت
Dialogue: 0,0:03:03.60,0:03:04.89,Default,,0,0,0,,مهلًا
Dialogue: 0,0:03:04.89,0:03:07.22,Default,,0,0,0,,لا تنعتيني بعزيزي
Dialogue: 0,0:03:04.89,0:03:07.22,خط - إعلانات روابط الموقع المترجم والعامل,,0,0,0,,{\fad(200,200)}ملاحظة: كلمة (آناتا) قد تكون أنت أو عزيزي
Dialogue: 0,0:03:07.85,0:03:10.52,Default,,0,0,0,,فهكذا يتحدث الأحباب كما تعلمين
Dialogue: 0,0:03:11.97,0:03:13.43,Default,,0,0,0,,الأحباب؟
Dialogue: 0,0:03:13.43,0:03:14.60,Default,,0,0,0,,!كما وكأننا كذلك
Dialogue: 0,0:03:16.02,0:03:16.56,Default,,0,0,0,,أوكو
Dialogue: 0,0:03:16.56,0:03:18.60,Default,,0,0,0,,!لا تقل أوكو وفقط
Dialogue: 0,0:03:18.60,0:03:20.39,Default,,0,0,0,,!فلست حبيبتك
Dialogue: 0,0:03:20.93,0:03:22.93,Default,,0,0,0,,...لقد بدأ الصف فعليًا
Dialogue: 0,0:03:23.35,0:03:25.60,Default,,0,0,0,,!كوروبا كايتو\Nفلتبسّط هذه الصيغة
Dialogue: 0,0:03:26.93,0:03:28.22,Default,,0,0,0,,2xy...
Dialogue: 0,0:03:28.22,0:03:29.14,Default,,0,0,0,,أُس اثنين
Dialogue: 0,0:03:29.60,0:03:30.39,Default,,0,0,0,,صحيح
Dialogue: 0,0:03:30.63,0:03:32.85,Default,,0,0,0,,!بحقك، إنها مجرد ملابس داخلية
Dialogue: 0,0:03:32.85,0:03:33.81,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:03:34.02,0:03:35.81,Default,,0,0,0,,إذًا، ماذا عن هذا السؤال؟
Dialogue: 0,0:03:35.81,0:03:36.47,Default,,0,0,0,,!يا ناكاموري أوكو
Dialogue: 0,0:03:36.77,0:03:38.88,Default,,0,0,0,, 3X جذر\N!على اثنين
Dialogue: 0,0:03:38.88,0:03:39.72,Default,,0,0,0,,!صحيح
Dialogue: 0,0:03:39.72,0:03:41.02,Default,,0,0,0,,ما الذي عنيته بقولك إنها مجرد ملابس داخلية؟
Dialogue: 0,0:03:41.27,0:03:44.39,Default,,0,0,0,,!هذا خطؤك أن تقعي في سحري في المقام الأول
Dialogue: 0,0:03:44.77,0:03:47.72,Default,,0,0,0,,!بالطبع، لا يمكن لأحدهم مواكبة سحري
Dialogue: 0,0:03:48.27,0:03:49.72,Default,,0,0,0,,!لا تخل نفسك عظيمًا لهذه الدرجة يا كايتو
Dialogue: 0,0:03:49.72,0:03:51.39,Default,,0,0,0,,!لم تتمكن من هزيمة كايتو كيد بعد
Dialogue: 0,0:03:52.06,0:03:53.60,Default,,0,0,0,,كايتو كيد؟
Dialogue: 0,0:03:53.60,0:03:55.31,Default,,0,0,0,,!ذاك اللص الذي يستخدم السحر
Dialogue: 0,0:03:55.31,0:03:56.52,Default,,0,0,0,,ألم تسمع؟
Dialogue: 0,0:04:02.06,0:04:04.06,Default,,0,0,0,,وأخيرًا نزلت إلى هنا يا كايتو
Dialogue: 0,0:04:04.06,0:04:05.31,Default,,0,0,0,,!مخطئة
Dialogue: 0,0:04:05.31,0:04:07.10,Default,,0,0,0,,!أنا لست كايتو
Dialogue: 0,0:04:07.10,0:04:07.89,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:04:07.89,0:04:09.68,Default,,0,0,0,,أتظن بأنه يمكنك إخفاء هويتك بنظارة؟
Dialogue: 0,0:04:09.97,0:04:11.22,Default,,0,0,0,,هذا مثير للاهتمام
Dialogue: 0,0:04:11.22,0:04:12.97,Default,,0,0,0,,سأقبض على ذاك اللص إذًا
Dialogue: 0,0:04:15.22,0:04:15.81,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:04:16.27,0:04:18.10,Default,,0,0,0,,!سأذهب للإمساك به
Dialogue: 0,0:04:18.10,0:04:19.52,Default,,0,0,0,,!كلا، بل أنا من ستمسك بك
Dialogue: 0,0:04:20.52,0:04:22.31,Default,,0,0,0,,مخطئة، أنا لست كايتو
Dialogue: 0,0:04:22.64,0:04:24.68,Default,,0,0,0,,حسنًا، حسنًا، ومن أنت الآن؟
Dialogue: 0,0:04:24.68,0:04:25.72,Default,,0,0,0,,...في الواقع
Dialogue: 0,0:04:25.72,0:04:26.60,Default,,0,0,0,,...أنا
Dialogue: 0,0:04:26.60,0:04:28.27,Default,,0,0,0,,!من المريخ
Dialogue: 0,0:04:34.22,0:04:34.93,Default,,0,0,0,,...مُحال
Dialogue: 0,0:04:35.43,0:04:36.18,Default,,0,0,0,,!وداعًا
Dialogue: 0,0:04:37.56,0:04:38.89,Default,,0,0,0,,كايتو من سكان المريخ!؟
Dialogue: 0,0:04:39.10,0:04:41.56,Default,,0,0,0,,!كما وكأنك محق
Dialogue: 0,0:04:42.39,0:04:43.60,Default,,0,0,0,,!أيتها الغبية أوكو
Dialogue: 0,0:04:43.60,0:04:44.77,Default,,0,0,0,,!توقفي
Dialogue: 0,0:04:48.72,0:04:49.35,Default,,0,0,0,,ما هذا!؟
Dialogue: 0,0:04:49.72,0:04:50.68,Default,,0,0,0,,...هذا سيئ
Dialogue: 0,0:05:01.06,0:05:04.64,Default,,0,0,0,,!!كايتو
Dialogue: 0,0:05:12.68,0:05:14.02,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:05:14.02,0:05:17.10,Default,,0,0,0,,...يجدر بك الامتنان بأنك لم تفصل من المدرسة
Dialogue: 0,0:05:17.10,0:05:20.27,Default,,0,0,0,,...أظن بأنه يجدر بي التدرب على الخاتمة
Dialogue: 0,0:05:20.27,0:05:21.85,Default,,0,0,0,,...سأجرب كوكب الزهرة في المرة القادمة
Dialogue: 0,0:05:20.60,0:05:22.64,Default - up,,0,0,0,,!حفلة شواء اليوم
Dialogue: 0,0:05:22.64,0:05:24.02,Default - up,,0,0,0,,حفلة شواء، حفلة شواء
Dialogue: 0,0:05:21.85,0:05:22.89,Default,,0,0,0,,...يا إلهي
Dialogue: 0,0:05:22.89,0:05:24.35,Default,,0,0,0,,لمَ تود فعل هذا من الأساس؟
Dialogue: 0,0:05:27.27,0:05:28.77,Default,,0,0,0,,...يا أنت
Dialogue: 0,0:05:28.77,0:05:30.56,Default,,0,0,0,,!رائع
Dialogue: 0,0:05:30.56,0:05:32.81,Default,,0,0,0,,هل لديك حفلة شواء مع والديك اليوم؟
Dialogue: 0,0:05:32.81,0:05:34.64,Default,,0,0,0,,!لا يجدر بك البكاء
Dialogue: 0,0:05:34.64,0:05:35.27,Default,,0,0,0,,!انظر إلى هنا
Dialogue: 0,0:05:36.14,0:05:36.72,Default,,0,0,0,,ها هي ذا
Dialogue: 0,0:05:39.22,0:05:42.77,Default,,0,0,0,,والآن عد آمنا للمنزل مع مومو-تشان، حسنًا؟
Dialogue: 0,0:05:42.77,0:05:43.43,Default,,0,0,0,,أجل
Dialogue: 0,0:05:45.52,0:05:46.47,Default,,0,0,0,,فهمت
Dialogue: 0,0:05:48.18,0:05:48.93,Default,,0,0,0,,لا تكترث
Dialogue: 0,0:05:49.60,0:05:50.72,Default,,0,0,0,,عن ماذا تتحدثين؟
Dialogue: 0,0:05:50.72,0:05:52.35,Default,,0,0,0,,لقد قلت لا شيء
Dialogue: 0,0:05:52.35,0:05:53.60,Default,,0,0,0,,!أنتِ
Dialogue: 0,0:05:57.47,0:06:00.27,Default,,0,0,0,,أنا بالمنزل، عودًا حميدًا
Dialogue: 0,0:06:06.68,0:06:08.72,Flashback,,0,0,0,,!مرحبًا بك بمنزلك يا كايتو{\fad(200,200)}
Dialogue: 0,0:06:08.72,0:06:10.27,Flashback,,0,0,0,,كيف كانت المدرسة؟{\fad(200,200)}
Dialogue: 0,0:06:10.27,0:06:13.06,Flashback,,0,0,0,,وخمّن أين هي أمك؟{\fad(200,200)}
Dialogue: 0,0:06:13.06,0:06:15.47,Flashback,,0,0,0,,...أراهن أنها بجينزا أو شينجوكو مجددًا{\fad(200,200)}
Dialogue: 0,0:06:15.93,0:06:17.22,Default,,0,0,0,,لاس فيغاس!؟
Dialogue: 0,0:06:17.89,0:06:20.27,Flashback,,0,0,0,,!عروض السحر الحقيقة مختلفة بحق{\fad(200,200)}
Dialogue: 0,0:06:20.27,0:06:22.85,Flashback,,0,0,0,,!لقد رأيت ثلاثة عروض اليوم{\fad(200,200)}
Dialogue: 0,0:06:22.85,0:06:27.68,Default,,0,0,0,,...يا إلهي، تبذرين في دخل أبي كالماء المنهمر
Dialogue: 0,0:06:27.68,0:06:28.60,Flashback,,0,0,0,,وخمن ماذا؟{\fad(200,200)}
Dialogue: 0,0:06:28.60,0:06:33.14,Flashback,,0,0,0,,لقد اصطدمت بصديقة تويتشي، وستقوم باصطحابي لبعض الوقت{\fad(200,200)}
Dialogue: 0,0:06:35.85,0:06:37.10,Flashback,,0,0,0,,...لا بد من أنك تشعر بالوحدة، ولكن{\fad(200,200)}
Dialogue: 0,0:06:37.10,0:06:38.85,Flashback,,0,0,0,,!تريد أمك منك الصمود{\fad(200,200)}
Dialogue: 0,0:06:38.85,0:06:42.02,Flashback,,0,0,0,,أراهن بأنك ستكون مشغولًا هذه الأيام يا عزيزي
Dialogue: 0,0:06:42.47,0:06:43.77,Default,,0,0,0,,ماذا تعنين بهذا؟
Dialogue: 0,0:06:43.77,0:06:47.22,Flashback,,0,0,0,,صحيح، قبلما أذهب\N...لقد أرسلت أوكو-شان رسالةً إلي{\fad(200,200)}
Dialogue: 0,0:06:47.22,0:06:48.27,Default,,0,0,0,,حسنًا، حسنًا، يكفي{\fad(200,200)}
Dialogue: 0,0:06:49.77,0:06:50.35,Default,,0,0,0,,أوكو؟{\fad(200,200)}
Dialogue: 0,0:06:51.31,0:06:52.60,Flashback,,0,0,0,,!لا تخل نفسك بهذه العظمة يا كايتو{\fad(200,200)}
Dialogue: 0,0:06:52.60,0:06:54.27,Flashback,,0,0,0,,!لم تتمكن من هزيمة كايتو كيد بعد{\fad(200,200)}
Dialogue: 0,0:06:55.18,0:06:57.39,Default,,0,0,0,,...تقول ما يحلو لها
Dialogue: 0,0:06:57.39,0:06:59.39,Default,,0,0,0,,...الساحر الوحيد الذي لم أتمكن من هزيمته
Dialogue: 0,0:07:00.47,0:07:02.14,Default,,0,0,0,,هو ذاك الشخص القابع أمامي
Dialogue: 0,0:07:17.39,0:07:19.27,Flashback,,0,0,0,,!انظري، إنه أبي{\fad(200,200)}
Dialogue: 0,0:07:19.27,0:07:21.31,Flashback,,0,0,0,,!كما وكأنني لم أُدرك هذا فعليًا{\fad(200,200)}
Dialogue: 0,0:07:25.35,0:07:27.85,Flashback,,0,0,0,,هل تعرف كيف تظهر خلاف ما تبطن يا كايتو؟{\fad(200,200)}
Dialogue: 0,0:07:28.06,0:07:29.60,Flashback,,0,0,0,,أظهر خلاف ما أبطن؟{\fad(200,200)}
Dialogue: 0,0:07:28.06,0:07:35.64,خط - إعلانات روابط الموقع المترجم والعامل,,0,0,0,,{\fad(200,200)}بوكر فيس: تختلف كثيراً الترجمات الحرفية لهذه الكلمة في ترجمات الفرق الأخرى لكن المعنى ثابت وهو الوجه الواثق أو عدم اظهار تعابير الفشل والخوف
Dialogue: 0,0:07:30.22,0:07:35.64,Flashback,,0,0,0,,في لعبة البوكر، لا يهم ما إن كان ما بيدك جيد أم سيئ\Nما يهم، هو كيفية إخفاءك لتعابير وجهك{\fad(200,200)}
Dialogue: 0,0:07:37.18,0:07:38.60,Flashback,,0,0,0,,ينطبق الأمر نفسه على السحر{\fad(200,200)}
Dialogue: 0,0:07:39.10,0:07:40.81,Flashback,,0,0,0,,في بعض الأحيان، قد لا تنجح خدعة ما{\fad(200,200)}
Dialogue: 0,0:07:41.31,0:07:43.06,Thoughts,,0,0,0,,...وجه بلا تعبيرات{\fad(200,200)}
Dialogue: 0,0:07:43.52,0:07:46.39,Flashback,,0,0,0,,ولكن لا تدع الجمهور يلاحظوا الأمر{\fad(200,200)}
Dialogue: 0,0:07:47.81,0:07:48.43,Flashback,,0,0,0,,طلب{\fad(200,200)}
Dialogue: 0,0:07:53.06,0:07:53.85,Flashback,,0,0,0,,...كايتو{\fad(200,200)}
Dialogue: 0,0:07:53.85,0:07:56.97,Flashback,,0,0,0,,أيمّا كان موقفك، لا تنسَ إخفاء تعابير وجهك{\fad(200,200)}
Dialogue: 0,0:07:58.77,0:08:01.06,Thoughts,,0,0,0,,في بعض الأحيان، قد لا تنجح خدعة ما{\fad(200,200)}
Dialogue: 0,0:08:03.64,0:08:04.72,Flashback,,0,0,0,,...هذا سيئ{\fad(200,200)}
Dialogue: 0,0:08:05.97,0:08:07.18,Flashback,,0,0,0,,...ولكن{\fad(200,200)}
Dialogue: 0,0:08:07.18,0:08:09.89,Flashback,,0,0,0,,ولكن لا تدع الجمهور يلاحظوا الأمر{\fad(200,200)}
Dialogue: 0,0:08:10.47,0:08:11.68,Default,,0,0,0,,إنك محق
Dialogue: 0,0:08:11.68,0:08:13.93,Default,,0,0,0,,...ما يجدر بي التدرب عليه ليس الخاتمة، بل
Dialogue: 0,0:08:14.68,0:08:16.72,Default,,0,0,0,,إخفاء تعبيرات الوجه
Dialogue: 0,0:08:18.06,0:08:19.64,Default,,0,0,0,,مفهوم يا أبي
Dialogue: 0,0:08:42.27,0:08:43.85,Default,,0,0,0,,...رسالة من والدة كايتو
Dialogue: 0,0:08:47.47,0:08:48.93,Default,,0,0,0,,هكذا إذًا؟
Dialogue: 0,0:08:51.43,0:08:54.43,Default,,0,0,0,,!عرفت نقطة ضعفه
Dialogue: 0,0:08:59.27,0:09:01.35,Default,,0,0,0,,ما هذا بحق الجحيم؟
Dialogue: 0,0:09:04.31,0:09:06.18,Flashback,,0,0,0,,لقد مر وقت طويل يا كايتو
Dialogue: 0,0:09:06.97,0:09:07.72,Default,,0,0,0,,أبي؟
Dialogue: 0,0:09:08.02,0:09:11.27,Flashback,,0,0,0,,...سأخبرك حقًا بماهيّة
Dialogue: 0,0:09:11.27,0:09:13.14,Flashback,,0,0,0,,...أنا كاي
Dialogue: 0,0:09:15.68,0:09:20.52,Default,,0,0,0,,إذًا خزنة عمرها ثمانية سنوات تحررت \N...مما أدى إلى تشغيل شريط كاسيت
Dialogue: 0,0:09:21.22,0:09:25.43,Default,,0,0,0,,هذا يعني بأن تلك كانت خدعة كوروبا تويتشي\N...النهائية، منذ ثمانية أعوام منصرمة
Dialogue: 0,0:09:27.47,0:09:29.77,Default,,0,0,0,,...لقد مضى ثمانية سنوات
Dialogue: 0,0:09:29.77,0:09:32.52,Default,,0,0,0,,لمَ شريط كاسيت؟
Dialogue: 0,0:09:32.52,0:09:35.35,Default,,0,0,0,,يا له من عتيق الطراز
Dialogue: 0,0:09:39.39,0:09:40.14,Default,,0,0,0,,...هذه
Dialogue: 0,0:09:41.52,0:09:42.68,Default,,0,0,0,,...تمامًا كـ
Dialogue: 0,0:10:08.31,0:10:09.14,Default,,0,0,0,,!استمعوا
Dialogue: 0,0:10:09.81,0:10:12.81,Default,,0,0,0,,العلامة التجارية الخاصة بكايتو كيد\Nهي رداءه وقبعته الطويلة
Dialogue: 0,0:10:13.22,0:10:14.97,Default,,0,0,0,,!احفروا هذا بعقولكم
Dialogue: 0,0:10:14.97,0:10:15.47,Default,,0,0,0,,!علم يا سيدي
Dialogue: 0,0:10:15.85,0:10:18.64,Default,,0,0,0,,...منذ ثمانية أعوام، اختفى على حين غرة
Dialogue: 0,0:10:18.64,0:10:20.93,Default,,0,0,0,,...وبالأمس، ظهر فجأة أيضًا
Dialogue: 0,0:10:21.85,0:10:24.77,Default,,0,0,0,,لا أعلم ما يسعى خلفه، ولكنني \Nسأعتقله بكل تأكيد هذه المرة
Dialogue: 0,0:10:26.31,0:10:27.97,Default,,0,0,0,,!لم أشعر بالحماس هكذا منذ مدة طويلة
Dialogue: 0,0:10:28.72,0:10:30.06,Default,,0,0,0,,أبي، لقد أحضرت ملابسك
Dialogue: 0,0:10:30.39,0:10:31.89,Default,,0,0,0,,شكرًا جزيلًا
Dialogue: 0,0:10:32.47,0:10:34.47,Default,,0,0,0,,سنقوم بنخب بعدما أمسك بكيد
Dialogue: 0,0:10:34.47,0:10:35.89,Default,,0,0,0,,!سأبذل قصارى جهدي
Dialogue: 0,0:10:36.14,0:10:37.31,Default,,0,0,0,,!حقًا
Dialogue: 0,0:10:37.31,0:10:39.31,Default,,0,0,0,,ولكن، لقد ظهر مجددًا بالأمس
Dialogue: 0,0:10:39.31,0:10:41.22,Default,,0,0,0,,هل سيظهر مجددًا بهذه السرعة؟
Dialogue: 0,0:10:41.43,0:10:42.02,Default,,0,0,0,,!أيها المفتش
Dialogue: 0,0:10:43.56,0:10:44.10,Default,,0,0,0,,...انظر
Dialogue: 0,0:10:44.31,0:10:47.97,Flashback,,0,0,0,,منذ لحظات، وصل بريد رسمي من كايتو على البريد الإلكتروني{\fad(200,200)}
Dialogue: 0,0:10:48.93,0:10:50.10,Flashback,,0,0,0,,غدًا في تمام الساعة 23:54{\fad(200,200)}
Dialogue: 0,0:10:50.10,0:10:51.06,Default,,0,0,0,,مُحال
Dialogue: 0,0:10:52.35,0:10:54.31,Default,,0,0,0,,!سنحتفل غدًا
Dialogue: 0,0:11:24.72,0:11:26.27,Default,,0,0,0,,عظيم، شغلوا الكاميرات
Dialogue: 0,0:11:31.64,0:11:34.52,Default,,0,0,0,,قامت الشرطة بتأمين نطاق واسع
Dialogue: 0,0:11:35.18,0:11:39.10,Default,,0,0,0,,وبعد ظهور شائعات بشأن موته، عاد كايتو كيد\Nبعد غياب ثمانية أعوام
Dialogue: 0,0:11:39.52,0:11:42.18,Default,,0,0,0,,...هل سيظهر نفسه الليلة، أم
Dialogue: 0,0:11:42.60,0:11:44.47,Default,,0,0,0,,ثمانية أعوام؟
Dialogue: 0,0:11:44.47,0:11:47.10,Default,,0,0,0,,...عندما مات أبي بذاك العرض كان أيضًا
Dialogue: 0,0:11:55.93,0:11:57.39,Default,,0,0,0,,...أيعقل أن أبي
Dialogue: 0,0:11:58.97,0:12:00.27,Default,,0,0,0,,...ربما
Dialogue: 0,0:12:00.27,0:12:01.85,Default,,0,0,0,,...يمكنني مقابلته ومعرفة الحقيقة
Dialogue: 0,0:12:02.31,0:12:03.77,Default,,0,0,0,,!لو أن باستطاعتي مقابلة كيد
Dialogue: 0,0:12:08.97,0:12:11.27,Default,,0,0,0,,...خدعة كوروبا تويتشي الأخيرة
Dialogue: 0,0:12:11.89,0:12:13.22,Default,,0,0,0,,!ستكشف بواسطتي
Dialogue: 0,0:12:14.97,0:12:15.85,Default,,0,0,0,,!حاذر يا أبي
Dialogue: 0,0:12:27.47,0:12:29.22,Default,,0,0,0,,!لقد حان الموعد أخيرًا
Dialogue: 0,0:12:29.22,0:12:30.89,Default,,0,0,0,,!قفوا بأماكنكم واحذروا
Dialogue: 0,0:12:31.22,0:12:33.06,Default,,0,0,0,,...ثمان ثوانٍ فقط
Dialogue: 0,0:12:33.06,0:12:33.81,Default,,0,0,0,,...سبعة
Dialogue: 0,0:12:34.14,0:12:35.22,Default,,0,0,0,,...ستة
Dialogue: 0,0:12:35.22,0:12:36.18,Default,,0,0,0,,...خمسة
Dialogue: 0,0:12:36.18,0:12:36.72,Default,,0,0,0,,...أربعة
Dialogue: 0,0:12:37.27,0:12:38.14,Default,,0,0,0,,...ثلاثة
Dialogue: 0,0:12:38.14,0:12:39.31,Default,,0,0,0,,...اثنان
Dialogue: 0,0:12:39.31,0:12:39.64,Default,,0,0,0,,...واحد
Dialogue: 0,0:12:40.10,0:12:40.56,Default,,0,0,0,,!صفر
Dialogue: 0,0:12:42.52,0:12:43.31,Default,,0,0,0,,!أضواء الطوارئ
Dialogue: 0,0:12:43.56,0:12:44.72,Default,,0,0,0,,افتحوا أضواء الطوارئ
Dialogue: 0,0:12:48.35,0:12:49.77,Default,,0,0,0,,ما الذي تفعله بحق الجحيم!؟
Dialogue: 0,0:12:53.64,0:12:55.31,Default,,0,0,0,,!كايتو كيد
Dialogue: 0,0:12:59.06,0:13:00.64,Default,,0,0,0,,!إذًا لقد قدمت يا كيد
Dialogue: 0,0:13:00.64,0:13:01.97,Default,,0,0,0,,لن أدعك تلوذ بالفرار هذه المرة
Dialogue: 0,0:13:03.27,0:13:04.39,Default,,0,0,0,,!خلفه
Dialogue: 0,0:13:12.27,0:13:13.56,Default,,0,0,0,,اقبضوا عليه
Dialogue: 0,0:13:20.18,0:13:21.31,Flashback,,0,0,0,,!لا تُخدعوا{\fad(200,200)}
Dialogue: 0,0:13:22.18,0:13:23.02,Default,,0,0,0,,...إنه ليس بالأعلى
Dialogue: 0,0:13:23.02,0:13:24.14,Default,,0,0,0,,!إنه أمامكم مباشرةً
Dialogue: 0,0:13:24.60,0:13:26.18,Default,,0,0,0,,أمسكوا به
Dialogue: 0,0:13:37.64,0:13:38.43,Default,,0,0,0,,!اللعنة
Dialogue: 0,0:13:44.39,0:13:46.27,Default,,0,0,0,,محال، أليس ذاك الطابق الـ50؟
Dialogue: 0,0:13:46.27,0:13:47.10,Default,,0,0,0,,!أيها المفتش
Dialogue: 0,0:13:47.43,0:13:48.27,Default,,0,0,0,,...هذا الشخص
Dialogue: 0,0:13:49.06,0:13:50.68,Default,,0,0,0,,يطير!؟
Dialogue: 0,0:13:51.89,0:13:52.60,Default,,0,0,0,,!ها هو ذا
Dialogue: 0,0:13:54.52,0:13:56.85,Default,,0,0,0,,!لقد هرب الهدف ناحية الطريق ويتجه صوب الغرب
Dialogue: 0,0:13:56.85,0:13:58.02,Default,,0,0,0,,!هلموا إلى هناك
Dialogue: 0,0:14:00.22,0:14:02.27,Flashback,,0,0,0,,!الفريق "ألفا"، قوموا بتطويقه من ناحية الشرق{\fad(200,200)}
Dialogue: 0,0:14:02.27,0:14:03.60,Flashback,,0,0,0,,!والفريق "بيتا" من الشمال{\fad(200,200)}
Dialogue: 0,0:14:03.60,0:14:04.89,Flashback,,0,0,0,,و"جاما" من الجنوب{\fad(200,200)}
Dialogue: 0,0:14:05.22,0:14:06.81,Default,,0,0,0,,سنحاصره
Dialogue: 0,0:14:25.97,0:14:26.85,Default,,0,0,0,,ما هذا!؟
Dialogue: 0,0:14:26.85,0:14:27.72,Default,,0,0,0,,دمية!؟
Dialogue: 0,0:14:27.72,0:14:28.60,Default,,0,0,0,,وجهاز تحكم!؟
Dialogue: 0,0:14:28.60,0:14:29.52,Default,,0,0,0,,ما هذا بحق الجحيم؟
Dialogue: 0,0:14:36.56,0:14:37.77,Default,,0,0,0,,...بالون
Dialogue: 0,0:15:00.97,0:15:03.85,Default,,0,0,0,,...التحكم في دمية للتضليل بينما تتسلق للأعلى
Dialogue: 0,0:15:03.85,0:15:05.52,Default,,0,0,0,,يا لها من خدعة عتيقة
Dialogue: 0,0:15:06.31,0:15:08.22,Default,,0,0,0,,!إنك تلطخ اسم اللص الشبح
Dialogue: 0,0:15:09.18,0:15:10.81,Default,,0,0,0,,من أنت!؟
Dialogue: 0,0:15:10.81,0:15:12.31,Default,,0,0,0,,...لطالما قمت بانتظارك
Dialogue: 0,0:15:12.72,0:15:13.77,Default,,0,0,0,,!يا كايتو كيد
Dialogue: 0,0:15:15.93,0:15:17.60,Default,,0,0,0,,ما الذي يعنيه هذا؟
Dialogue: 0,0:15:17.60,0:15:19.60,Default,,0,0,0,,...لا تقل لي بأنه ما يزال هنا
Dialogue: 0,0:15:20.47,0:15:22.68,Default,,0,0,0,,...كلا، لقد هرب للخارج
Dialogue: 0,0:15:23.81,0:15:24.64,Default,,0,0,0,,...كل ما تبقى هو
Dialogue: 0,0:15:34.31,0:15:37.68,Default,,0,0,0,,إذًا، هل يمكنك اكتشاف ماهية هذا السحر؟
Dialogue: 0,0:15:44.18,0:15:45.64,Flashback,,0,0,0,,حافظ على هدوئك يا كايتو{\fad(200,200)}
Dialogue: 0,0:15:45.64,0:15:48.22,Flashback,,0,0,0,,أيمّا كان موقفك، لا تنسَ إخفاء تعابير وجهك{\fad(200,200)}
Dialogue: 0,0:15:51.81,0:15:54.43,Default,,0,0,0,,ما المشكلة؟ لقد صدمت لدرجة عدم المقدرة على الكلام\Nأليس كذلك؟
Dialogue: 0,0:15:57.31,0:15:59.35,Default,,0,0,0,,!خدعتك البسيطة تجعلني أضحك بشدة
Dialogue: 0,0:16:01.06,0:16:02.02,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:16:02.39,0:16:02.93,Thoughts,,0,0,0,,!فهمت
Dialogue: 0,0:16:03.77,0:16:04.64,Default,,0,0,0,,أيها الوغد
Dialogue: 0,0:16:05.10,0:16:06.68,Default,,0,0,0,,!جهز نفسك
Dialogue: 0,0:16:16.10,0:16:19.60,Default,,0,0,0,,لقد قمت بوضع مرآة بداخل جسدك\Nلتماثل كل ما هو حولك
Dialogue: 0,0:16:19.60,0:16:21.35,Default,,0,0,0,,!وبهذا يمكن لجسدك الاختفاء
Dialogue: 0,0:16:21.81,0:16:24.02,Default,,0,0,0,,يا له من سحر بسيط
Dialogue: 0,0:16:27.27,0:16:29.64,Default,,0,0,0,,يا إلهي، من الصعب الرؤية جرّاء الظلام
Dialogue: 0,0:16:30.10,0:16:31.39,Default,,0,0,0,,استدعوا الطائرات المروحية
Dialogue: 0,0:16:31.39,0:16:32.93,Default,,0,0,0,,!وأخبروهم بإضاءة السطح
Dialogue: 0,0:16:33.56,0:16:35.60,Default,,0,0,0,,!لا شك بأن كيد مختبئًا على السطح
Dialogue: 0,0:16:38.85,0:16:40.02,Default,,0,0,0,,...أنت
Dialogue: 0,0:16:40.81,0:16:41.43,Default,,0,0,0,,...أيعقل
Dialogue: 0,0:16:41.85,0:16:42.81,Default,,0,0,0,,تويشتي-ساما؟
Dialogue: 0,0:16:44.52,0:16:46.43,Default,,0,0,0,,!ما تزال حيًّا
Dialogue: 0,0:16:46.43,0:16:48.06,Default,,0,0,0,,!لقد افتقدتك بشدة
Dialogue: 0,0:16:48.89,0:16:50.60,Thoughts,,0,0,0,,لمَ قال اسم والدي؟
Dialogue: 0,0:16:50.85,0:16:53.14,Thoughts,,0,0,0,,وأين رأيت هذا الكهل من قبل؟
Dialogue: 0,0:16:54.10,0:16:57.27,Default,,0,0,0,,!إنه أنا خادمك المخلص جي، طوع خدمتك
Dialogue: 0,0:16:57.68,0:16:59.85,Default,,0,0,0,,لقد مضى ثمانية أعوام فقط... ألا يمكنك التعرف عليّ؟
Dialogue: 0,0:17:00.52,0:17:01.52,Thoughts,,0,0,0,,جي-شان!؟
Dialogue: 0,0:17:01.89,0:17:05.81,Default,,0,0,0,,!لطالما اعتقدت بأنك قتلت في ذاك العرض منذ ثمانية أعوام منصرمة
Dialogue: 0,0:17:07.06,0:17:10.89,Default,,0,0,0,,...لمدة ثمانية أعوام، ازداد غضبي
Dialogue: 0,0:17:10.89,0:17:16.06,Default,,0,0,0,,...ولهذا قررت أخيرًا ارتداء زي كايتو كيد المتفاخر
Dialogue: 0,0:17:16.06,0:17:20.14,Default,,0,0,0,,محاولًا اكتشاف هوية أولئك الحثالة الذين قتلوا تويتشي-ساما
Dialogue: 0,0:17:20.93,0:17:21.81,Default,,0,0,0,,ماذا قلت!؟
Dialogue: 0,0:17:22.10,0:17:23.64,Default,,0,0,0,,أبي تم قتله!؟
Dialogue: 0,0:17:23.64,0:17:24.85,Default,,0,0,0,,بواسطة من!؟
Dialogue: 0,0:17:24.85,0:17:25.93,Default,,0,0,0,,من قام بقتله!؟
Dialogue: 0,0:17:27.39,0:17:28.85,Default,,0,0,0,,...سيدي كايتو الصغير
Dialogue: 0,0:17:29.27,0:17:31.43,Default,,0,0,0,,...لمَ... أنت
Dialogue: 0,0:17:32.18,0:17:33.64,Default,,0,0,0,,لدي سؤال واحد فقط
Dialogue: 0,0:17:33.64,0:17:35.43,Default,,0,0,0,,أجب عنه بصدقٍ من فضلك
Dialogue: 0,0:17:35.43,0:17:36.35,Default,,0,0,0,,...يا جي-شان
Dialogue: 0,0:17:37.43,0:17:40.06,Default,,0,0,0,,أكان لصًا بحق؟
Dialogue: 0,0:17:40.81,0:17:44.22,Default,,0,0,0,,أكان أبي... هو كايتو كيد؟
Dialogue: 0,0:17:54.81,0:17:56.06,Default,,0,0,0,,!هلموا
Dialogue: 0,0:18:05.97,0:18:06.35,Default,,0,0,0,,أجل
Dialogue: 0,0:18:07.31,0:18:09.18,Default,,0,0,0,,كما أخبرك حدسك تمامًا
Dialogue: 0,0:18:13.85,0:18:15.22,Default,,0,0,0,,...هكذا إذًا
Dialogue: 0,0:18:15.68,0:18:20.14,Default,,0,0,0,,...هذا خطأ جي يا تويتشي-ساما
Dialogue: 0,0:18:20.14,0:18:22.89,Default,,0,0,0,,...لم يكن يجدر بي إخبار السيد الصغير
Dialogue: 0,0:18:33.52,0:18:34.89,Default,,0,0,0,,سأقوم بصرف انتباههم
Dialogue: 0,0:18:34.89,0:18:35.85,Default,,0,0,0,,وأنت اخرج من هنا يا جي
Dialogue: 0,0:18:36.06,0:18:37.43,Default,,0,0,0,,...ولكن يا سيدي الصغير
Dialogue: 0,0:18:37.43,0:18:39.43,Default,,0,0,0,,!لم أعد السيد الصغير بعد الآن
Dialogue: 0,0:18:40.97,0:18:42.56,Default,,0,0,0,,!أنا كايتو كيد
Dialogue: 0,0:18:50.97,0:18:53.35,Default,,0,0,0,,لقد وجدناك أخيرًا يا كايتو كيد
Dialogue: 0,0:18:55.02,0:18:56.35,Default,,0,0,0,,!أمسكوا به
Dialogue: 0,0:18:59.02,0:19:01.35,Default,,0,0,0,,...فلتبقَ آمنًا يا سيدي الصغير
Dialogue: 0,0:19:08.18,0:19:09.47,Default,,0,0,0,,!لقد انتهى الأمر
Dialogue: 0,0:19:09.47,0:19:11.27,Default,,0,0,0,,!لا يمكنك الهرب يا كيد
Dialogue: 0,0:19:16.77,0:19:18.10,Default,,0,0,0,,ما الذي تفعله؟
Dialogue: 0,0:19:28.72,0:19:29.35,Default,,0,0,0,,ماذا!؟
Dialogue: 0,0:19:36.85,0:19:39.02,Flashback,,0,0,0,,!لقد تم رفع رداء كيد بواسطة رافعة ونش {\fad(200,200)}
Dialogue: 0,0:19:44.52,0:19:46.56,Flashback,,0,0,0,,!لقد فجّر دمية لتوّه{\fad(200,200)}
Dialogue: 0,0:19:47.85,0:19:49.39,Default,,0,0,0,,!اللعنة
Dialogue: 0,0:19:49.39,0:19:51.10,Default,,0,0,0,,!لقد فعلها مجددًا
Dialogue: 0,0:19:58.43,0:19:59.56,Default,,0,0,0,,وداعًا
Dialogue: 0,0:20:23.14,0:20:25.06,Default,,0,0,0,,...أربعمائة مليون ين
Dialogue: 0,0:20:26.31,0:20:27.02,Default,,0,0,0,,!كايتو
Dialogue: 0,0:20:27.39,0:20:28.60,Default,,0,0,0,,دعني أريك شيئًا عظيمًا
Dialogue: 0,0:20:30.10,0:20:31.68,Default,,0,0,0,,...إنها المفضلة لديك
Dialogue: 0,0:20:33.60,0:20:35.39,Default,,0,0,0,,!سمكة
Dialogue: 0,0:20:39.35,0:20:40.68,Thoughts,,0,0,0,,!لقد أكلت بؤبؤ القمر
Dialogue: 0,0:20:41.02,0:20:42.52,Default - up,,0,0,0,,فلتعيديها يا سمكة السلمون
Dialogue: 0,0:20:42.52,0:20:43.89,Default - up,,0,0,0,,أم تكونين سمكة البونيتو!؟
Dialogue: 0,0:20:43.89,0:20:45.39,Default - up,,0,0,0,,!أكره كل الأسماك
Dialogue: 0,0:20:44.52,0:20:45.89,Default,,0,0,0,,ما الذي تفعله؟
Dialogue: 0,0:20:45.89,0:20:47.81,Default,,0,0,0,,ألا يمكنك معرفة سعر هذه السمكة؟
Dialogue: 0,0:20:47.81,0:20:49.81,Default,,0,0,0,,!لا تفقدي وعيكِ فقط عندما تسمعي هذا
Dialogue: 0,0:21:02.10,0:21:04.10,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:21:05.81,0:21:08.43,Default,,0,0,0,,{\fad(0,500)}إنها...!؟
Dialogue: 0,0:21:18.06,0:21:19.97,Default,,0,0,0,,!والآن عرضنا يبدأ
