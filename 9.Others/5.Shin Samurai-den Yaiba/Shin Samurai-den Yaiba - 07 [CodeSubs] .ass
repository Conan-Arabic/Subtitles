Dialogue: 0,0:00:10.26,0:00:12.55,DC,,0,0,0,,‫-ما هذا؟\N‫-ما هذا الصوت؟
Dialogue: 0,0:00:12.68,0:00:14.26,DC,,0,0,0,,‫انظر! هناك في الأعلى!
Dialogue: 0,0:00:15.43,0:00:17.02,DC,,0,0,0,,!مـ... ما هذا الشيء
Dialogue: 0,0:00:18.77,0:00:24.19,DCH,,0,0,0,,{\pos(954.8,1020.4)\fscx111\fscy100}‫أخبار عاجلة: سفينة أونيمارو الهوائية تحوم فوق طوكيو
Dialogue: 0,0:00:21.19,0:00:24.19,DC,,0,0,0,,{\an8}‫لدينا الآن خبر عاجل، تم ربطنا بموقع الحدث.
Dialogue: 0,0:00:24.27,0:00:26.44,DC,,0,0,0,,‫شيوجي هنا، من موقع الحدث.
Dialogue: 0,0:00:26.53,0:00:29.03,DC,,0,0,0,,‫أونيمارو! أونيمارو قد ظهر!
Dialogue: 0,0:00:29.53,0:00:32.28,DC,,0,0,0,,‫لقد حول مبنى البرلمان الوطني إلى قلعته الخاصة،
Dialogue: 0,0:00:32.37,0:00:34.78,DC,,0,0,0,,‫ويخطط للسيطرة على اليابان!
Dialogue: 0,0:00:34.87,0:00:36.95,DC,,0,0,0,,ترى من هو هذا الشخص بالضبط!؟
Dialogue: 0,0:00:41.12,0:00:44.75,DC,,0,0,0,,‫لقد فات الأوان. اليابان أصبحت لي!
Dialogue: 0,0:00:44.88,0:00:48.80,DC,,0,0,0,,‫الآن، أطيعوني، أيتها الحشرات الحقيرة!
Dialogue: 0,0:00:49.88,0:00:52.30,DC,,0,0,0,,!من هو أونيمارو هذا؟ لا تكن سخيفاً
Dialogue: 0,0:00:52.39,0:00:55.51,DC,,0,0,0,,!الشعب الياباني لن يستسلم بهذه السهولة
Dialogue: 0,0:00:55.60,0:00:57.14,DC,,0,0,0,,!أجل، أجل
Dialogue: 0,0:00:57.22,0:00:58.89,DC,,0,0,0,,!نحن لا نعترف بذلك
Dialogue: 0,0:00:59.52,0:01:01.02,DC,,0,0,0,,‫حسناً.
Dialogue: 0,0:01:01.10,0:01:03.94,DC,,0,0,0,,!إذاً، فلتنظروا إلى قوتي
Dialogue: 0,0:01:04.19,0:01:05.90,DC,,0,0,0,,‫"رياح"
Dialogue: 0,0:01:14.91,0:01:16.16,DC,,0,0,0,,‫لا يمكن أن يحدث هذا...
Dialogue: 0,0:01:16.24,0:01:17.91,DC,,0,0,0,,هل أنت جاد؟
Dialogue: 0,0:01:27.42,0:01:29.80,DC,,0,0,0,,!هل رأيتم أيها السفلة
Dialogue: 0,0:01:29.88,0:01:34.18,DC,,0,0,0,,!تذكروا هذه القوة جيداً
Dialogue: 0,0:01:38.68,0:01:40.60,DC,,0,0,0,,!أونيـ... أونيمارو-ساما
Dialogue: 0,0:01:41.18,0:01:42.56,DC,,0,0,0,,ماذا؟
Dialogue: 0,0:01:43.27,0:01:47.32,DC,,0,0,0,,‫حسنًا، يبدو أن رجل الوطواط قد هُزم...
Dialogue: 0,0:01:47.40,0:01:48.78,DC,,0,0,0,,‫ماذا؟
Dialogue: 0,0:01:49.53,0:01:51.78,DC,,0,0,0,,أتقول إن حتى هو قد هُزِم؟
Dialogue: 0,0:01:52.78,0:01:55.57,DC,,0,0,0,,‫بهذا يكون جميع الشياطين الثمانية قد انهزموا إذن...
Dialogue: 0,0:01:55.66,0:01:57.66,DC,,0,0,0,,...لـ... لا يزال أنا
Dialogue: 0,0:01:57.74,0:01:59.33,DC,,0,0,0,,إذن أين هم الآن؟
Dialogue: 0,0:02:00.16,0:02:02.75,DC,,0,0,0,,.يبدو أنهم ما زالوا يتجهون إلى جزيرة غانريو
Dialogue: 0,0:02:03.62,0:02:05.67,DC,,0,0,0,,جزيرة غانريو إذن؟
Dialogue: 0,0:02:05.75,0:02:07.17,DC,,0,0,0,,‫رائع.
Dialogue: 0,0:02:07.25,0:02:10.00,DC,,0,0,0,,‫اسبقهم، وأعِد استدعاءه.
Dialogue: 0,0:02:10.59,0:02:12.09,DC,,0,0,0,,‫من تقصد بإعادة استدعائه؟
Dialogue: 0,0:02:12.17,0:02:14.55,DC,,0,0,0,,،محارب ساموراي من أربعةِ قرونٍ مضت
Dialogue: 0,0:02:15.43,0:02:19.22,DC,,0,0,0,,.اسمه... ساساكي كوجيرو
Dialogue: 0,0:02:31.86,0:02:34.11,DCDialogRedName,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:03:52.07,0:03:53.65,DC,,0,0,0,,‫ساساكي كوجيرو...
Dialogue: 0,0:03:54.69,0:03:58.53,DC,,0,0,0,,‫إنه مبارز عبقري لا يظهر إلا مرة كل مئة عام،
Dialogue: 0,0:03:58.61,0:04:00.74,DC,,0,0,0,,‫وكان وسيماً جداً،
Dialogue: 0,0:04:00.82,0:04:04.62,DC,,0,0,0,,‫ولكنه أقل مني بمقدار ضئيل بالطبع.
Dialogue: 0,0:04:05.16,0:04:07.87,DC,,0,0,0,,.لقد سمعتُ هذه القصة من قبل
Dialogue: 0,0:04:07.96,0:04:10.29,DC,,0,0,0,,لذلك نحن بحاجةٍ إلى سيفه الشيطاني، أليس كذلك؟
Dialogue: 0,0:04:10.38,0:04:11.58,DC,,0,0,0,,.أجل
Dialogue: 0,0:04:12.29,0:04:14.92,DC,,0,0,0,,،إنه سيف شيطاني يتمدد ويتقلص بحرية
Dialogue: 0,0:04:15.00,0:04:17.05,DCHint-xOpacity,,0,0,0,,{\an8}‫سُمِّي سيف ساساكي كوجيرو بـ"عصا الغسيل" بسبب طوله الكبير الذي يُشبه العصا التي تُستخدم لنشر الغسيل، وهو ما ميّزه وجعل أسلوبه فريداً وخطيراً في القتال.
Dialogue: 0,0:04:15.00,0:04:17.05,DC,,0,0,0,,‫ويُعرف باسم عصا الغسيل (مونوهوشيزاوا).
Dialogue: 0,0:04:17.13,0:04:18.59,DC,,0,0,0,,‫قبل أكثر من 400 عام،
Dialogue: 0,0:04:18.68,0:04:23.05,DC,,0,0,0,,‫تنافستُ مع كوجيرو، الذي كان يحمل ذلك السيف الشيطاني، وانتصرتُ عليه.
Dialogue: 0,0:04:23.14,0:04:24.31,DC,,0,0,0,,‫كيف؟
Dialogue: 0,0:04:26.06,0:04:28.64,DC,,0,0,0,,.حسناً، سأخبرك بالتفصيل
Dialogue: 0,0:04:30.35,0:04:32.61,DC,,0,0,0,,،عندما سمعتُ أنه حصل على السيف الشيطاني
Dialogue: 0,0:04:32.69,0:04:35.61,DC,,0,0,0,,‫وضعت خطة سرية.
Dialogue: 0,0:04:35.69,0:04:36.90,DC,,0,0,0,,خطة سرية؟
Dialogue: 0,0:04:36.99,0:04:38.19,DC,,0,0,0,,‫هذا صحيح،
Dialogue: 0,0:04:38.28,0:04:39.82,DC,,0,0,0,,‫وهي...
Dialogue: 0,0:04:39.90,0:04:43.20,DC,,0,0,0,,.أن أتأخر عن المعركة الحاسمة عمداً
Dialogue: 0,0:04:43.28,0:04:45.20,DC,,0,0,0,,.هذا يبدو جباناً نوعاً ما
Dialogue: 0,0:04:45.29,0:04:47.20,DC,,0,0,0,,!هذه أيضًا إحدى أساليب فنون الحرب
Dialogue: 0,0:04:47.91,0:04:51.00,DC,,0,0,0,,.لقد كان حاد الطباع مثلكَ أنت
Dialogue: 0,0:04:51.08,0:04:52.42,DC,,0,0,0,,‫اصمت.
Dialogue: 0,0:04:52.50,0:04:54.34,DC,,0,0,0,,،كان يشعر بالضيق
Dialogue: 0,0:04:54.42,0:04:56.75,DC,,0,0,0,,.وأصبح سيفه ثقيلاً من الغضب
Dialogue: 0,0:04:56.84,0:04:59.80,DC,,0,0,0,,...وعندما بدأت المبارزة بينه وبيني
Dialogue: 0,0:04:59.88,0:05:04.05,DCHint-xOpacity,,0,0,0,,{\an8}‫سُمّيت ضربة السنونو بهذا الاسم لأنها تُحاكي حركة طيران طائر السنونو الذي يغيّر اتجاهه بسرعة ومهارة، مثل الضربة المرتدة المفاجئة التي اشتهر بها كوجيرو.
Dialogue: 0,0:04:59.88,0:05:04.05,DC,,0,0,0,,‫استخدم ضربته القاضية، ضربة السنونو (تسوباميغايشي)، من أول هجمة،
Dialogue: 0,0:05:04.14,0:05:08.68,DC,,0,0,0,,!ولكني صدتها ببراعة وهزمته
Dialogue: 0,0:05:08.77,0:05:10.52,DC,,0,0,0,,‫هل أنت جاد؟
Dialogue: 0,0:05:10.60,0:05:12.60,DC,,0,0,0,,‫"كوجيرو المهزوم"
Dialogue: 0,0:05:12.69,0:05:16.82,DC,,0,0,0,,‫هذا ما أصبح يعرف لاحقاً بمباراة جزيرة غانريو.
Dialogue: 0,0:05:16.90,0:05:19.11,DC,,0,0,0,,{\an8}‫"كوجيرو المهزوم - تأليف: مياموتو موساشي"
Dialogue: 0,0:05:19.19,0:05:22.66,DC,,0,0,0,,...لقد نسيتُ معظم الأشياء القديمة ولكن
Dialogue: 0,0:05:22.74,0:05:26.16,DC,,0,0,0,,‫شاهد المبارزة تذكرها بتفصيل كبير،
Dialogue: 0,0:05:26.24,0:05:27.37,DC,,0,0,0,,،تفضل
Dialogue: 0,0:05:27.45,0:05:30.83,DC,,0,0,0,,.ها هو مكتوب هنا بالتفصيل، اقرأه جيداً
Dialogue: 0,0:05:32.17,0:05:33.33,DC,,0,0,0,,‫أريد أن أقرأها أيضاً!
Dialogue: 0,0:05:33.88,0:05:36.17,DC,,0,0,0,,،انظروا، يمكننا رؤيتها من هنا
Dialogue: 0,0:05:37.13,0:05:39.38,DC,,0,0,0,,.تلك هي جزيرة غانريو
Dialogue: 0,0:05:41.72,0:05:46.64,DCNN,,0,0,0,,{\pos(960,1000.0)}‫الحلقة 7: عودة كوجيرو من العالم الآخر
Dialogue: 0,0:05:50.48,0:05:54.94,DC,,0,0,0,,...هـ... هل يوجد حقاً قبر في مكان كهذا
Dialogue: 0,0:06:00.57,0:06:02.49,DC,,0,0,0,,!واو، لقد كان موجوداً حقاً
Dialogue: 0,0:06:02.57,0:06:04.57,DC,,0,0,0,,.إنه أمر مثير للقشعريرة
Dialogue: 0,0:06:05.78,0:06:09.74,DC,,0,0,0,,‫لا بد أن طاقة هذا السيف الشيطاني هي التي منعت تحلل الجسد.
Dialogue: 0,0:06:10.41,0:06:12.41,DC,,0,0,0,,...حسناً، الخطوة التالية هي
Dialogue: 0,0:06:13.25,0:06:14.37,DC,,0,0,0,,‫دعنا نرى الآن...
Dialogue: 0,0:06:14.46,0:06:16.13,DC,,0,0,0,,‫بيضة كابا.
Dialogue: 0,0:06:14.46,0:06:16.13,DCHint-xOpacity,,0,0,0,,{\an8}‫الكابا (Kappa): كائن أسطوري في التراث الشعبي الياباني، يُشبه الإنسان والسلحفاة، يعيش في الماء، ويشتهر بطبيعته الماكرة أو المرعبة أحيانًا.
Dialogue: 0,0:06:16.21,0:06:17.59,DC,,0,0,0,,‫دموع تنين.
Dialogue: 0,0:06:18.13,0:06:20.13,DC,,0,0,0,,‫وقليل من مسحوق غبار العثة.
Dialogue: 0,0:06:23.34,0:06:25.89,DC,,0,0,0,,‫أوه، لقد عاد الجسد في حالةٍ جيدة.
Dialogue: 0,0:06:26.47,0:06:28.10,DC,,0,0,0,,‫الآن يأتي الجزء الصعب.
Dialogue: 0,0:06:28.18,0:06:33.23,DC,,0,0,0,,...أولاً، أطلق طاقة السيف الشيطاني المتراكمة لمدة 400 عام
Dialogue: 0,0:06:35.27,0:06:36.69,DC,,0,0,0,,‫بهذه القوة،
Dialogue: 0,0:06:36.77,0:06:39.52,DC,,0,0,0,,‫كل ما علي فعله هو استهدف لحظة وفاة كوجيرو-هان...
Dialogue: 0,0:06:36.77,0:06:39.52,DCHint-xOpacity,,0,0,0,,{\an8}‫"هان" لاحقة مهذبة تُستخدم باللهجة الغربية في اليابان (كانساي) بدلاً من "سان"، وتعني "السيد" أو "الآنسة" احتراماً.
Dialogue: 0,0:06:40.27,0:06:42.78,DC,,0,0,0,,‫وفتح بوابة في الزمان والمكان.
Dialogue: 0,0:06:50.49,0:06:56.67,DC,,0,0,0,,‫ثم أمسك الروح التي تركت جسده...\N‫وأعيدها.
Dialogue: 0,0:06:58.17,0:06:59.59,DC,,0,0,0,,.‫لقد حصلتُ عليها
Dialogue: 0,0:06:59.67,0:07:03.63,DC,,0,0,0,,!الآن، لم يتبقَّ سوى إدخال الروح في الجسد
Dialogue: 0,0:07:04.63,0:07:07.05,DC,,0,0,0,,!هيا، استيقظ
Dialogue: 0,0:07:14.68,0:07:15.52,DC,,0,0,0,,‫هذا غريب.
Dialogue: 0,0:07:16.10,0:07:18.02,DC,,0,0,0,,‫مرحبًا! استيقظ!
Dialogue: 0,0:07:19.61,0:07:21.94,DC,,0,0,0,,‫هل أخطأت في شيء ما؟
Dialogue: 0,0:07:30.28,0:07:34.12,DC,,0,0,0,,أنتَ من ضرب وجهي الجميل، أليس كذلك؟
Dialogue: 0,0:07:35.58,0:07:37.79,DC,,0,0,0,,‫أيها الوغد! من أنت؟
Dialogue: 0,0:07:37.87,0:07:39.96,DC,,0,0,0,,!اثبُت مكانك! سأقطعك إربًا
Dialogue: 0,0:07:42.17,0:07:44.76,DC,,0,0,0,,!انتظر من فضلك
Dialogue: 0,0:07:44.84,0:07:47.93,DC,,0,0,0,,‫أنا لست عدوك! كنت فقط أتبع أوامر أونيمارو-ساما،
Dialogue: 0,0:07:48.01,0:07:51.18,DC,,0,0,0,,‫لقد متُّ قبل 400 عام، وأنا من أعادك من العالم الآخر!
Dialogue: 0,0:07:52.76,0:07:53.68,DC,,0,0,0,,‫مت؟
Dialogue: 0,0:07:55.27,0:07:57.48,DC,,0,0,0,,‫تعني، أنا...
Dialogue: 0,0:08:05.11,0:08:07.57,DC,,0,0,0,,!لقد وصلوا بالفعل
Dialogue: 0,0:08:07.65,0:08:09.61,DC,,0,0,0,,!يجب أن أعيده بسرعة وأختبئ
Dialogue: 0,0:08:09.70,0:08:11.28,DC,,0,0,0,,‫ابق بعيدًا عن الأنظار، كوجيرو-هان!
Dialogue: 0,0:08:12.16,0:08:13.49,DC,,0,0,0,,‫لا أستطيع أن أتذكر...
Dialogue: 0,0:08:17.50,0:08:19.75,DC,,0,0,0,,.يا لها من جزيرة فارغة
Dialogue: 0,0:08:19.83,0:08:22.54,DC,,0,0,0,,!انظر انظر! يوجد تمثال هناك
Dialogue: 0,0:08:22.63,0:08:26.67,DC,,0,0,0,,‫ذاك تمثال كوجيرو... وأما التمثال الآخر، فهو للمبارز العظيم مياموتو موساشي.
Dialogue: 0,0:08:27.17,0:08:29.26,DC,,0,0,0,,.لقد أضاف لقب "عظيم" لنفسه فقط
Dialogue: 0,0:08:30.30,0:08:31.72,DC,,0,0,0,,ما ذلك الشيء الأسود؟
Dialogue: 0,0:08:33.51,0:08:34.89,DC,,0,0,0,,هذه هالة، موساشي؟
Dialogue: 0,0:08:35.81,0:08:36.72,DC,,0,0,0,,‫انتظر...
Dialogue: 0,0:08:37.23,0:08:39.27,DC,,0,0,0,,،لقد خدعني بتكتيك التأخير ذاك
Dialogue: 0,0:08:39.35,0:08:41.85,DC,,0,0,0,,.وليس لدي ذاكرة لما حدث بعد تلقي الضربة الأولى
Dialogue: 0,0:08:41.94,0:08:44.27,DC,,0,0,0,,.إنه نائم تحت ذلك التمثال
Dialogue: 0,0:08:45.23,0:08:46.65,DC,,0,0,0,,هل يمكن...؟
Dialogue: 0,0:08:47.94,0:08:50.36,DC,,0,0,0,,‫أنني... أنني...
Dialogue: 0,0:08:51.70,0:08:55.03,DC,,0,0,0,,‫هل أنا ميت؟!
Dialogue: 0,0:08:55.12,0:08:58.20,DC,,0,0,0,,.حسنًا، لهذا السبب أعدتك من العالم الآخر
Dialogue: 0,0:08:58.70,0:09:00.83,DC,,0,0,0,,.لقد مر وقت طويل يا كوجيرو
Dialogue: 0,0:09:02.29,0:09:07.00,DC,,0,0,0,,،لقد كنتَ مبارزاً عبقرياً لا يظهر إلا مرة كل مئة عام
Dialogue: 0,0:09:07.09,0:09:11.63,DC,,0,0,0,,.خسارة محارب قوي مثلك أمر مؤسف حقاً
Dialogue: 0,0:09:12.72,0:09:15.89,DC,,0,0,0,,.موساشي، أحياناً تقول شيئاً جيداً
Dialogue: 0,0:09:15.97,0:09:16.93,DC,,0,0,0,,...لكن
Dialogue: 0,0:09:17.01,0:09:19.73,DC,,0,0,0,,...أنا مبارز خارق وعظيم
Dialogue: 0,0:09:19.81,0:09:21.98,DC,,0,0,0,,!يظهر مرة كل مليون عام
Dialogue: 0,0:09:22.06,0:09:26.19,DC,,0,0,0,,!ساموراي صغير مثلك ليس له فرصة لهزيمتي
Dialogue: 0,0:09:29.32,0:09:30.82,DC,,0,0,0,,لقد كان حظك سيئاً يا رجل
Dialogue: 0,0:09:33.70,0:09:36.53,DC,,0,0,0,,!اسكت يا موساشي
Dialogue: 0,0:09:37.83,0:09:41.87,DC,,0,0,0,,‫أنا بعد نـــــوم طـــــويل عدت...
Dialogue: 0,0:09:41.96,0:09:44.71,DC,,0,0,0,,.لأهزمك يا موساشي
Dialogue: 0,0:09:44.79,0:09:48.05,DC,,0,0,0,,!ساساكي كوجيرو قد وصل
Dialogue: 0,0:09:48.13,0:09:50.01,DC,,0,0,0,,‫كوجيرو!
Dialogue: 0,0:09:50.09,0:09:51.76,DC,,0,0,0,,الحـ... الحقيقي؟
Dialogue: 0,0:09:52.34,0:09:53.55,DC,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:09:57.31,0:09:59.56,DC,,0,0,0,,.أنا من أعدته من العالم الآخر
Dialogue: 0,0:10:00.18,0:10:02.48,DC,,0,0,0,,هذه أول مرة نلتقي فيها مباشرة، أليس كذلك؟
Dialogue: 0,0:10:03.44,0:10:06.31,DC,,0,0,0,,‫-أنا واحد من الشياطين الثمانية...\N‫-إنه واحد من الشياطين الثمانية...
Dialogue: 0,0:10:06.40,0:10:07.73,DC,,0,0,0,,‫رجل العنكبوت!
Dialogue: 0,0:10:09.11,0:10:11.36,DC,,0,0,0,,‫أنا أقدم نفسي هنا!
Dialogue: 0,0:10:11.82,0:10:14.53,DC,,0,0,0,,كيه! هذه المرة رجل العنكبوت؟
Dialogue: 0,0:10:14.61,0:10:16.66,DC,,0,0,0,,‫لن تحصل على سيف حاكم الرعد (رايجينكين)!
Dialogue: 0,0:10:18.45,0:10:21.66,DC,,0,0,0,,...لن تستطيع التباهي بهذا طويلاً أيها
Dialogue: 0,0:10:21.75,0:10:24.79,DC,,0,0,0,,‫أيها المعلم! أطلب منك بتواضع أن تقضي عليهم.
Dialogue: 0,0:10:25.37,0:10:27.71,DC,,0,0,0,,‫أخشى أنني لا أزال مرتبكًا، ولكن...
Dialogue: 0,0:10:28.42,0:10:29.25,DC,,0,0,0,,‫حسنًا.
Dialogue: 0,0:10:29.34,0:10:33.09,DC,,0,0,0,,‫أولاً، موساشي! سأقطعك أنت أولاً...
Dialogue: 0,0:10:35.34,0:10:37.60,DC,,0,0,0,,همم؟ آه، صحيح أين موساشي؟
Dialogue: 0,0:10:37.68,0:10:39.26,DC,,0,0,0,,‫إنه هنا.
Dialogue: 0,0:10:39.35,0:10:41.39,DC,,0,0,0,,.أنا مياموتو موساشي
Dialogue: 0,0:10:42.43,0:10:46.85,DC,,0,0,0,,‫مـ... ماذا~!؟\N‫هذا العجوز الهرِم؟
Dialogue: 0,0:10:46.94,0:10:51.07,DC,,0,0,0,,!ما الذي حدث لذلك الوجه الذي كان ثاني أجمل وجه بعد وجهي؟
Dialogue: 0,0:10:51.94,0:10:53.53,DC,,0,0,0,,‫ما زلتُ وسيماً كما كنتُ دائمًا!
Dialogue: 0,0:10:53.61,0:10:55.53,DC,,0,0,0,,وماذا عنك أنت؟
Dialogue: 0,0:10:55.61,0:10:57.41,DC,,0,0,0,,!ما هذا الاحتقان في عينيك
Dialogue: 0,0:10:57.49,0:11:00.95,DC,,0,0,0,,‫حتى قيلولة الأربعمئة عام لم تكن كافية.
Dialogue: 0,0:11:01.04,0:11:03.87,DC,,0,0,0,,...إيهي... ما زلت تقول أشياء تافهة
Dialogue: 0,0:11:06.50,0:11:07.96,DC,,0,0,0,,!هيا لنتقاتل، يا موساشي
Dialogue: 0,0:11:08.04,0:11:09.71,DC,,0,0,0,,!هذا ما أتمناه
Dialogue: 0,0:11:12.05,0:11:13.01,DC,,0,0,0,,‫ماذا؟
Dialogue: 0,0:11:13.92,0:11:15.55,DC,,0,0,0,,‫هناك!
Dialogue: 0,0:11:23.43,0:11:26.52,DC,,0,0,0,,‫لقد تمكنت من تطوير مهاراتك بينما كنت في ذلك التابوت!
Dialogue: 0,0:11:26.60,0:11:29.44,DC,,0,0,0,,‫أنتَ الذي أصبحتَ ضعيفًا!
Dialogue: 0,0:11:32.73,0:11:35.69,DC,,0,0,0,,‫تمدد يا عصا الغسيل (مونوهوشيزاوا)!
Dialogue: 0,0:11:36.49,0:11:38.07,DC,,0,0,0,,!لقد تمدد السيف حقًا
Dialogue: 0,0:11:47.04,0:11:48.79,DC,,0,0,0,,.لقد تقدمت في السن يا موساشي
Dialogue: 0,0:11:49.29,0:11:52.13,DC,,0,0,0,,.لو كنت في شبابك، لتمكنت من تفادي ذلك بسهولة
Dialogue: 0,0:11:54.80,0:11:55.84,DC,,0,0,0,,!استعد
Dialogue: 0,0:11:55.92,0:11:57.51,DC,,0,0,0,,!لن أسمح لك
Dialogue: 0,0:12:02.10,0:12:02.93,DC,,0,0,0,,‫طفل...
Dialogue: 0,0:12:03.51,0:12:06.56,DC,,0,0,0,,‫يا فتى... هل تقول أنك ستكون خصمًا لهذا الموقر كوجيرو؟
Dialogue: 0,0:12:06.64,0:12:09.23,DC,,0,0,0,,‫أنا لست طفلًا! اسمي يايبا!
Dialogue: 0,0:12:09.81,0:12:11.02,DC,,0,0,0,,.يا له من أمر لا فائدة منه
Dialogue: 0,0:12:11.56,0:12:14.15,DC,,0,0,0,,!لن تستطيع حتى لمسي يا فتى
Dialogue: 0,0:12:14.86,0:12:16.78,DC,,0,0,0,,‫اصمت!
Dialogue: 0,0:12:29.79,0:12:31.96,DC,,0,0,0,,{\i1}‫إنه قوي. هذا يتطلب...{\i}
Dialogue: 0,0:12:36.71,0:12:37.55,DC,,0,0,0,,{\i1}‫إنه قادم...{\i}
Dialogue: 0,0:12:38.13,0:12:39.38,DC,,0,0,0,,‫خذ هذا!
Dialogue: 0,0:12:39.47,0:12:42.55,DC,,0,0,0,,!‫سيف المروحة (سنبوكين)
Dialogue: 0,0:12:42.64,0:12:45.18,DC,,0,0,0,,‫تمدد يا عصا الغسيل (مونوهوشيزاوا)!
Dialogue: 0,0:12:50.14,0:12:51.65,DC,,0,0,0,,ماذا!؟
Dialogue: 0,0:12:55.57,0:12:58.69,DC,,0,0,0,,،لا حاجة إلى صدّ هذه التقنية مباشرةً
Dialogue: 0,0:12:58.78,0:13:02.03,DC,,0,0,0,,.يكفي صدها من الأسفل ودفعها بعيداً
Dialogue: 0,0:13:02.11,0:13:05.62,DC,,0,0,0,,!لقد تغلبتُ على تقنية سيف المروحة (سنبوكين) خاصتك
Dialogue: 0,0:13:05.70,0:13:07.24,DC,,0,0,0,,‫ سيف المروحة (سنبوكين)...
Dialogue: 0,0:13:07.95,0:13:09.41,DC,,0,0,0,,‫لم تنجح.
Dialogue: 0,0:13:13.75,0:13:15.34,DC,,0,0,0,,.هذه هي النهاية
Dialogue: 0,0:13:15.42,0:13:16.59,DC,,0,0,0,,!لـ... ليس جيداً
Dialogue: 0,0:13:17.21,0:13:18.63,DC,,0,0,0,,!‫ضربة السنونو (تسوباميغايشي)
Dialogue: 0,0:13:26.60,0:13:28.27,DC,,0,0,0,,!لا أستطيع تفاديها
Dialogue: 0,0:13:37.48,0:13:38.65,DC,,0,0,0,,مـ... ما هذا الذي حدث الآن؟
Dialogue: 0,0:13:39.15,0:13:40.61,DC,,0,0,0,,!لن أسمح لك بالهرب
Dialogue: 0,0:13:41.20,0:13:42.61,DC,,0,0,0,,‫تبًا!
Dialogue: 0,0:13:43.49,0:13:45.78,DC,,0,0,0,,‫أنت لي!
Dialogue: 0,0:13:46.83,0:13:48.16,DC,,0,0,0,,{\i1}‫أنا هالك!{\i}
Dialogue: 0,0:13:51.50,0:13:52.37,DC,,0,0,0,,‫ماذا...
Dialogue: 0,0:13:58.63,0:14:01.09,DC,,0,0,0,,!يـ... يايبااا
Dialogue: 0,0:14:20.36,0:14:21.61,DC,,0,0,0,,‫أين أنا؟
Dialogue: 0,0:14:21.69,0:14:23.65,DC,,0,0,0,,‫أنت هناك، عرّف عن نفسك!
Dialogue: 0,0:14:25.74,0:14:30.24,DC,,0,0,0,,‫إنه السيد إيمامورا سيتسو-نو-كامي أيناغا،\N‫هل تعرف هذا وأنت تتصرف بهذه الوقاحة!؟
Dialogue: 0,0:14:25.74,0:14:30.24,DCHint-xOpacity,,0,0,0,,{\an8}‫سيتسو-نو-كامي هو لقب شرفي ياباني قديم يعني "حاكم منطقة سيتسو" أو "المسؤول عن سيتسو"، ويُستخدم للدلالة على مرتبة رسمية أو منصب نبيل.
Dialogue: 0,0:14:32.12,0:14:35.04,DC,,0,0,0,,‫انتظر... ما هذا المكان؟
Dialogue: 0,0:14:36.46,0:14:38.42,DC,,0,0,0,,ماذا حدث لساياكا والآخرين؟
Dialogue: 0,0:14:38.50,0:14:40.17,DC,,0,0,0,,‫وماذا حدث لكوجيرو؟
Dialogue: 0,0:14:40.25,0:14:42.05,DC,,0,0,0,,‫ماذا يحدث؟
Dialogue: 0,0:14:42.13,0:14:44.63,DC,,0,0,0,,‫لا يهم! تخلصوا منهم!
Dialogue: 0,0:14:44.72,0:14:45.63,DC,,0,0,0,,!أجل
Dialogue: 0,0:14:46.80,0:14:48.51,DC,,0,0,0,,!سـ... سيف حقيقي
Dialogue: 0,0:14:48.60,0:14:50.72,DC,,0,0,0,,!هل أنتم من أتباع أونيمارو
Dialogue: 0,0:14:52.39,0:14:53.68,DC,,0,0,0,,‫يـ... يا رجل
Dialogue: 0,0:14:54.27,0:14:55.14,DC,,0,0,0,,‫توقفوا!
Dialogue: 0,0:14:57.90,0:15:00.11,DC,,0,0,0,,!الخصم لا يزال مجرد طفل
Dialogue: 0,0:15:00.19,0:15:02.57,DC,,0,0,0,,...أيها المحاربون، أن تجتمعوا عليه هكذا
Dialogue: 0,0:15:02.65,0:15:05.15,DC,,0,0,0,,!أيها الوقح! من أنت
Dialogue: 0,0:15:05.95,0:15:07.74,DC,,0,0,0,,‫أنا رونين من ساكوشو.
Dialogue: 0,0:15:05.95,0:15:07.74,DCHint-xOpacity,,0,0,0,,{\an8}‫رونين = ساموراي فقد سيده إما بسبب موت سيده أو سقوطه من منصبه، وغالبًا ما يتجول دون انتماء. في فترات اليابان الإقطاعية، كان الرونين يُنظر إليهم على أنهم محاربون سقطوا من مكانتهم، وأحيانًا يُعاملون بازدراء، لكن بعضهم كان يحتفظ بروح الساموراي وشرفه.
Dialogue: 0,0:15:05.95,0:15:07.74,DCHint-xOpacity,,0,0,0,,{\an8}.ساكوشو = اسم مكان قديم لمنطقة في اليابان، غالبًا ضمن مقاطعة أوكاياما التاريخية
Dialogue: 0,0:15:09.70,0:15:11.08,DC,,0,0,0,,.مياموتو موساشي
Dialogue: 0,0:15:12.37,0:15:13.66,DC,,0,0,0,,‫موساشي...
Dialogue: 0,0:15:13.75,0:15:16.17,DC,,0,0,0,,!مياموتو موساشي
Dialogue: 0,0:15:16.75,0:15:20.67,DC,,0,0,0,,‫ذلك المبارز العظيم الذي هزم مئات الأعداء بمفرده؟
Dialogue: 0,0:15:21.55,0:15:24.01,DC,,0,0,0,,.لا أدري إن كنتُ أنا ذلك المبارز أم لا
Dialogue: 0,0:15:25.26,0:15:27.30,DC,,0,0,0,,‫نحن لا نبحث عن المتاعب.
Dialogue: 0,0:15:27.80,0:15:29.51,DC,,0,0,0,,‫انسحبوا!
Dialogue: 0,0:15:33.72,0:15:36.85,DC,,0,0,0,,هل أنت حقاً موساشي؟
Dialogue: 0,0:15:38.48,0:15:41.48,DC,,0,0,0,,أنتم يا رفاق، هل تعرفونني؟
Dialogue: 0,0:15:41.57,0:15:44.15,DC,,0,0,0,,‫يمكنك أن تقول ذلك...
Dialogue: 0,0:15:46.57,0:15:49.41,DC,,0,0,0,,في أي سنة نحن الآن؟
Dialogue: 0,0:15:49.99,0:15:52.08,DC,,0,0,0,,.نحن في السنة السابعة عشرة من عصر كيتشو
Dialogue: 0,0:15:49.99,0:15:52.08,DCHint-xOpacity,,0,0,0,,{\an8}‫عصر كيتشو (1596-1615) هو الفترة الانتقالية الحاسمة في تاريخ اليابان التي شهدت توحيد البلاد تحت حكم توكوغاوا إياسو وتأسيس شوغونية توكوغاوا، مما مهد الطريق لعصر إيدو المسالم الذي دام لأكثر من 250 عامًا.
Dialogue: 0,0:15:52.16,0:15:54.29,DC,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:15:55.75,0:15:57.08,DC,,0,0,0,,...هذا يعني أننا
Dialogue: 0,0:15:57.16,0:16:00.92,DC,,0,0,0,,‫سافرنا عبر الزمن إلى الماضي، إلى عصر إيدو قبل 400 عام.
Dialogue: 0,0:15:57.16,0:16:00.92,DCHint-xOpacity,,0,0,0,,{\an8}‫عصر إيدو (1603-1868) هو فترة حكم شوغونية توكوغاوا في اليابان، اتسمت بأكثر من 250 عامًا من السلام الداخلي النسبي، وسياسة العزلة الوطنية (ساكوكو)، وتطور ثقافي واقتصادي مميز.
Dialogue: 0,0:16:01.00,0:16:02.88,DC,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:16:04.76,0:16:07.22,DC,,0,0,0,,‫ماذا تعني بـالسفر عبر الزمن؟
Dialogue: 0,0:16:08.80,0:16:10.72,DC,,0,0,0,,!يا له من وجه فظيع
Dialogue: 0,0:16:08.80,0:16:10.72,DCHint-xOpacity,,0,0,0,,{\an8}‫مجرم شديد الخطورة: أوياما غوشونوسكي (تحية لملك الفلرات غوشو أوياما – مع ملاحظة أن "نوسكي" لاحقة تُستخدم في الأسماء اليابانية التقليدية، وغالبًا ما تُضاف إلى أسماء الذكور لتعطي طابعًا رسميًا أو قديمًا)\N‫كتب في مارس، العام السابع عشر من عصر كيتشو - مكتب قاضي تانيماشي"
Dialogue: 0,0:16:12.60,0:16:16.31,DC,,0,0,0,,إذاً، أنتم تقولون إنكم جئتم من المستقبل؟
Dialogue: 0,0:16:16.39,0:16:17.73,DC,,0,0,0,,‫نعم.
Dialogue: 0,0:16:17.81,0:16:19.60,DC,,0,0,0,,‫من الصعب تصديق ذلك.
Dialogue: 0,0:16:20.35,0:16:23.69,DC,,0,0,0,,‫كيف انتهى بنا المطاف في الماضي؟
Dialogue: 0,0:16:24.32,0:16:26.40,DC,,0,0,0,,‫يجب أن نعود بسرعة، أو أنهم...
Dialogue: 0,0:16:27.11,0:16:29.91,DC,,0,0,0,,‫أونيمارو-ساما قال إن السيف الشيطاني عصا الغسيل (مونوهوشيزاوا)...
Dialogue: 0,0:16:29.99,0:16:32.70,DC,,0,0,0,,.لديه القدرة على السفر عبر الزمن
Dialogue: 0,0:16:32.78,0:16:36.83,DC,,0,0,0,,‫لا بد أن رجل العنكبوت قد استخدمه لإنشاء ممر عبر الزمان والمكان،
Dialogue: 0,0:16:36.91,0:16:40.33,DC,,0,0,0,,‫ليجلب كوجيرو-سان إلى الحاضر.
Dialogue: 0,0:16:40.42,0:16:43.92,DC,,0,0,0,,وقد دخلنا نحن في ذلك الثقب. أليس هذا ما حدث؟
Dialogue: 0,0:16:44.46,0:16:47.80,DC,,0,0,0,,‫هل يعني ذلك أن كوجيرو ليس هنا؟
Dialogue: 0,0:16:47.88,0:16:49.51,DC,,0,0,0,,.لا، ليس الأمر كذلك
Dialogue: 0,0:16:50.09,0:16:54.01,DC,,0,0,0,,‫من المقرر أن أشارك في مبارزة مع كوجيرو بعد سبعة أيام.
Dialogue: 0,0:16:54.10,0:16:55.43,DC,,0,0,0,,،أنا من سيهزمه
Dialogue: 0,0:16:55.51,0:16:58.27,DC,,0,0,0,,‫وسيكون لقب الرقم واحد في اليابان من نصيبي أنا، مياموتو...
Dialogue: 0,0:16:58.35,0:17:00.77,DC,,0,0,0,,!موساشي لا يعني لي شيئاً
Dialogue: 0,0:17:01.81,0:17:04.77,DC,,0,0,0,,‫أنا كوجيرو، أفضل مبارز في اليابان!
Dialogue: 0,0:17:04.86,0:17:06.44,DC,,0,0,0,,‫بالطبع أنت كذلك!
Dialogue: 0,0:17:06.53,0:17:07.36,DC,,0,0,0,,‫نعم!
Dialogue: 0,0:17:10.15,0:17:11.86,DC,,0,0,0,,‫كوجيرو!
Dialogue: 0,0:17:14.28,0:17:16.24,DC,,0,0,0,,‫مهلاً، أليس هذا كوجيرو؟
Dialogue: 0,0:17:16.33,0:17:18.75,DC,,0,0,0,,إذن، هل ذلك الملتحي هناك هو موساشي؟
Dialogue: 0,0:17:19.29,0:17:22.04,DC,,0,0,0,,‫ستبدأ المجزرة قريبًا.
Dialogue: 0,0:17:22.12,0:17:23.71,DC,,0,0,0,,‫إنها مبارزة!
Dialogue: 0,0:17:32.59,0:17:33.93,DC,,0,0,0,,!مهلاً، انظر إلى ذلك
Dialogue: 0,0:17:36.39,0:17:37.97,DC,,0,0,0,,‫احذر!
Dialogue: 0,0:17:49.19,0:17:51.90,DC,,0,0,0,,‫مذهل! لقد حولوا الخشب إلى عيدان الطعام!
Dialogue: 0,0:17:52.45,0:17:54.87,DC,,0,0,0,,‫وأسماؤهم منقوشة!
Dialogue: 0,0:17:54.95,0:17:57.58,DC,,0,0,0,,!بالضبط عشرة آلاف لكل منهما
Dialogue: 0,0:17:57.66,0:17:59.33,DC,,0,0,0,,.إنه تعادل
Dialogue: 0,0:18:01.41,0:18:03.58,DC,,0,0,0,,!لقد تحسنتَ يا موساشي
Dialogue: 0,0:18:03.67,0:18:04.79,DC,,0,0,0,,!وأنت كذلك
Dialogue: 0,0:18:05.54,0:18:08.63,DC,,0,0,0,,.سنتبارز بعد سبعة أيام، بلا قيود ودون تردد
Dialogue: 0,0:18:09.21,0:18:10.67,DC,,0,0,0,,!لا حاجة لذكر ذلك
Dialogue: 0,0:18:11.88,0:18:13.26,DC,,0,0,0,,‫أتعهد على سيفي بذلك.
Dialogue: 0,0:18:14.72,0:18:16.60,DC,,0,0,0,,‫إنه كوجيرو هناك.
Dialogue: 0,0:18:17.39,0:18:18.56,DC,,0,0,0,,‫الآن بعد أن ذكرت ذلك،
Dialogue: 0,0:18:18.64,0:18:22.06,DC,,0,0,0,,‫قال أونيمارو-ساما إن جسده لا يزال قابل للاستخدام.
Dialogue: 0,0:18:22.14,0:18:26.27,DC,,0,0,0,,...في المستقبل الذي كنا فيه، ظهر السيد كوجيرو بالقرب من القبر، لذا
Dialogue: 0,0:18:27.82,0:18:30.03,DC,,0,0,0,,‫هل يمكن أن يكون الرجل العنكبوت...
Dialogue: 0,0:18:30.11,0:18:32.49,DC,,0,0,0,,،قد فتح ثقباً حيث مات السيد كوجيرو
Dialogue: 0,0:18:32.57,0:18:37.62,DC,,0,0,0,,‫وأخذ الروح التي خرجت فقط ووضعها في الجسد الموجود في التابوت، في المستقبل الذي كنا فيه.
Dialogue: 0,0:18:37.70,0:18:40.04,DC,,0,0,0,,‫لإعادته إلى الحاضر؟
Dialogue: 0,0:18:41.20,0:18:44.58,DC,,0,0,0,,...إذا كان الأمر كذلك، فإننا بسبب دخولنا الثقب بقوة
Dialogue: 0,0:18:44.67,0:18:47.84,DC,,0,0,0,,.قد نكون قد سافرنا أبعد في الزمن قبل موته
Dialogue: 0,0:18:48.46,0:18:49.75,DC,,0,0,0,,‫حسنًا، إذا كان هذا صحيحًا،
Dialogue: 0,0:18:49.84,0:18:52.97,DC,,0,0,0,,‫إذًا ستظهر تلك البوابة مرة أخرى عندما يفوز ميوساشي، أليس كذلك؟
Dialogue: 0,0:18:53.05,0:18:56.80,DC,,0,0,0,,‫ثم يمكننا القفز داخلها والعودة إلى ساياكا والآخرين!
Dialogue: 0,0:18:56.89,0:18:58.39,DC,,0,0,0,,‫لقد تم الأمر!
Dialogue: 0,0:18:58.47,0:18:59.89,DC,,0,0,0,,!انتظرني يا كوجيرو
Dialogue: 0,0:18:59.97,0:19:01.60,DC,,0,0,0,,،سأصبح أقوى بحلول ذلك الوقت
Dialogue: 0,0:19:01.68,0:19:04.52,DC,,0,0,0,,!وعندما أعود، سنعيد المبارزة
Dialogue: 0,0:19:10.73,0:19:11.86,DC,,0,0,0,,‫ميوساشي-ساما!
Dialogue: 0,0:19:13.19,0:19:14.61,DC,,0,0,0,,هل أنتم ضيوف؟
Dialogue: 0,0:19:15.15,0:19:18.53,DC,,0,0,0,,‫اسمي أوتسو. هل يمكنني أن أسأل عن أسمائكم؟
Dialogue: 0,0:19:21.12,0:19:24.75,DC,,0,0,0,,‫إذًا أنتم لستم من هذا الزمن؟
Dialogue: 0,0:19:24.83,0:19:26.17,DC,,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:19:26.25,0:19:27.96,DC,,0,0,0,,‫يبدو أن الأمر كذلك.
Dialogue: 0,0:19:29.63,0:19:32.21,DC,,0,0,0,,‫هل يتدرب هكذا دائمًا؟
Dialogue: 0,0:19:32.71,0:19:34.30,DC,,0,0,0,,‫نعم، كل يوم.
Dialogue: 0,0:19:34.38,0:19:38.89,DC,,0,0,0,,.لا يمر يوم واحد دون أن يمسك موساشي-ساما بسيفه ويتدرب
Dialogue: 0,0:19:38.97,0:19:40.76,DC,,0,0,0,,‫مثل هذا الالتزام والجدية.
Dialogue: 0,0:19:40.85,0:19:43.31,DC,,0,0,0,,.لماذا أصبح هكذا
Dialogue: 0,0:19:46.64,0:19:50.44,DC,,0,0,0,,.إضافة إلى ذلك، هو يستعد لمبارزة مع كوجيرو-ساما
Dialogue: 0,0:19:50.52,0:19:52.36,DC,,0,0,0,,‫أوه، فهمت.
Dialogue: 0,0:19:53.69,0:19:56.45,DC,,0,0,0,,موساشي سينتصر على ذلك الكوجيرو، أليس كذلك؟
Dialogue: 0,0:19:58.32,0:19:59.41,DC,,0,0,0,,.مهلاً، موساشي
Dialogue: 0,0:20:00.49,0:20:04.12,DC,,0,0,0,,كوجيرو يستخدم نوعاً من الضربات القاضية الرائعة، أليس كذلك؟
Dialogue: 0,0:20:04.20,0:20:06.29,DC,,0,0,0,,هل تتحدث عن ‫ضربة السنونو (تسوباميغايشي)؟
Dialogue: 0,0:20:07.37,0:20:09.42,DC,,0,0,0,,‫هل يمكنك هزيمتها؟
Dialogue: 0,0:20:10.25,0:20:14.13,DC,,0,0,0,,‫ضربة السنونو (تسوباميغايشي): تبدأ بضربة من الأعلى إلى الأسفل،
Dialogue: 0,0:20:14.21,0:20:15.80,DC,,0,0,0,,،وعندما يتفاداها الخصم
Dialogue: 0,0:20:15.88,0:20:17.80,DC,,0,0,0,,.يضرب فورًا للأعلى دون تردد
Dialogue: 0,0:20:18.30,0:20:22.39,DC,,0,0,0,,.يُنفذ هذا الهجوم في لحظة واحدة، مثل السنونو وهي تحلق
Dialogue: 0,0:20:23.10,0:20:24.93,DC,,0,0,0,,.كوجيرو هو خبير في هذه التقنية
Dialogue: 0,0:20:25.43,0:20:28.48,DC,,0,0,0,,.إذا تلقيتها، ستشعر بأنك قُطعت في نفس اللحظة تقريبًا
Dialogue: 0,0:20:29.23,0:20:31.86,DC,,0,0,0,,‫إذن كيف ستتمكن من هزيمتها؟
Dialogue: 0,0:20:33.23,0:20:35.07,DC,,0,0,0,,.تقدم للأمام بلا خوف
Dialogue: 0,0:20:36.11,0:20:38.03,DC,,0,0,0,,.هذه هي طريقة النصر المؤكدة
Dialogue: 0,0:20:38.11,0:20:39.03,DC,,0,0,0,,‫هل هذا كل شيء؟
Dialogue: 0,0:20:39.53,0:20:40.41,DC,,0,0,0,,‫بالتأكيد.
Dialogue: 0,0:20:40.95,0:20:44.24,DC,,0,0,0,,.ولكن هذا الشخص يملك سيفًا شيطانيًا يمتد بشكل كبير
Dialogue: 0,0:20:44.91,0:20:48.71,DC,,0,0,0,,‫الاعتقاد بأن القدرة على قطع الخصم من مسافة بعيدة، ويعدّها البعض تفوقًا،
Dialogue: 0,0:20:48.79,0:20:51.54,DC,,0,0,0,,.ليس إلا تفكير أصحاب العقول الضعيفة
Dialogue: 0,0:20:52.04,0:20:54.34,DC,,0,0,0,,‫إذا تمكن المرء من اختراق دفاع الخصم،
Dialogue: 0,0:20:54.42,0:20:56.13,DC,,0,0,0,,.فهناك فرصة للفوز
Dialogue: 0,0:20:56.21,0:20:57.13,DC,,0,0,0,,‫بالإضافة إلى ذلك…
Dialogue: 0,0:20:57.63,0:21:03.26,DC,,0,0,0,,‫الشخص الذي يدخل مبارزة وهو يعتقد أنه سيخسر منذ البداية،\N‫لا يستحق أن يُسمّى ساموراي.
Dialogue: 0,0:21:03.93,0:21:05.64,DC,,0,0,0,,‫ألا تشعر بالخوف؟
Dialogue: 0,0:21:05.72,0:21:08.02,DC,,0,0,0,,...أن أشعر بالخوف
Dialogue: 0,0:21:08.89,0:21:11.35,DC,,0,0,0,,‫فهذا يعني أنني لم أتدرب بما فيه الكفاية.
Dialogue: 0,0:21:11.94,0:21:16.28,DC,,0,0,0,,،بمواصلة التدريب، ستكتسب الثقة بنفسك بشكل طبيعي
Dialogue: 0,0:21:16.36,0:21:19.07,DC,,0,0,0,,،وإذا اكتسبتَ الثقة، فستننتقل تلك الثقة إلى السيف أيضًا
Dialogue: 0,0:21:19.65,0:21:21.53,DC,,0,0,0,,.وستُقاد إلى النصر
Dialogue: 0,0:21:23.57,0:21:26.95,DC,,0,0,0,,.الأمر المهم هو أن تؤمن بقوتك الخاصة
Dialogue: 0,0:21:28.95,0:21:30.83,DC,,0,0,0,,‫استمر في التدريب، يومًا بعد يوم،
Dialogue: 0,0:21:30.91,0:21:34.04,DC,,0,0,0,,.سيأتي اليوم الذي تفهم فيه هذا، يا يايبا-دونو
Dialogue: 0,0:21:30.91,0:21:34.04,DCHint-xOpacity,,0,0,0,,{\an8}‫دونو هو لقب تكريمي قديم في اليابانية يُستخدم لإظهار احترام كبير عند مخاطبة شخص، ويعادل في معناه "السيد المحترم" أو "السيدة المحترمة".
Dialogue: 0,0:21:34.75,0:21:38.51,DC,,0,0,0,,إذاً، يا موساشي، هل ستتدرب معي حتى يوم المبارزة؟
Dialogue: 0,0:21:39.72,0:21:41.30,DC,,0,0,0,,.أجل، لا بأس
Dialogue: 0,0:21:42.01,0:21:43.22,DC,,0,0,0,,.إذاً، لنبدأ فوراً
Dialogue: 0,0:21:44.09,0:21:45.35,DC,,0,0,0,,!تعال
Dialogue: 0,0:21:54.44,0:21:58.82,DC,,0,0,0,,‫في المبارزة، من المهم دائمًا أن تتغلب على خصمك بأخذ المبادرة أولًا.
Dialogue: 0,0:22:00.03,0:22:04.91,DC,,0,0,0,,‫تهيئة وضعية الجسم لضرب الخصم هي الخطوة الأولى، والسيف يتبع ذلك الوضع.
Dialogue: 0,0:22:09.20,0:22:11.29,DC,,0,0,0,,.التدريب لا يخون أبدًا
Dialogue: 0,0:22:11.79,0:22:15.38,DC,,0,0,0,,‫فذلك التراكم هو الذي يمكّنك من إبراز قوتك.
Dialogue: 0,0:22:20.34,0:22:22.26,DC,,0,0,0,,‫حسنًا، هذا كل شيء.
Dialogue: 0,0:22:22.84,0:22:25.05,DC,,0,0,0,,‫ماذا؟ هل انتهينا بالفعل؟
Dialogue: 0,0:22:26.09,0:22:27.89,DC,,0,0,0,,.لقد مرت ستة أيام منذ ذلك الحين
Dialogue: 0,0:22:27.97,0:22:30.47,DC,,0,0,0,,.أخيراً، غداً هو يوم المبارزة المنتظرة
Dialogue: 0,0:22:31.06,0:22:34.27,DC,,0,0,0,,!التلويح العشوائي بالسيف لا يُعد تدريبًا
Dialogue: 0,0:22:34.77,0:22:37.69,DC,,0,0,0,,.أنا قلقة بشأن ما إذا كان موساشي-ساما سيستطيع الفوز
Dialogue: 0,0:22:39.36,0:22:40.90,DC,,0,0,0,,!لا تقلقي
Dialogue: 0,0:22:40.98,0:22:42.11,DC,,0,0,0,,،أنا أعرف
Dialogue: 0,0:22:42.61,0:22:48.08,DC,,0,0,0,,!موساشي سيتعمّد التأخّر، وعندما يكون كوجيرو في حالة ضيق، سيتغلّب عليه تمامًا
Dialogue: 0,0:22:48.78,0:22:51.79,DC,,0,0,0,,!موساشي-ساما لن يستخدم أسلوباً جباناً كهذا
Dialogue: 0,0:22:52.79,0:22:56.54,DC,,0,0,0,,.قال شيئًا عن كونها جزءًا من استراتيجية الحرب، أو شيئًا من هذا القبيل
Dialogue: 0,0:22:56.63,0:22:57.92,DC,,0,0,0,,أليس كذلك، موساشي؟
Dialogue: 0,0:22:58.71,0:23:01.84,DC,,0,0,0,,!التأخر عن المبارزة عارٌ على المحارب
Dialogue: 0,0:23:01.92,0:23:04.84,DC,,0,0,0,,!هذا الموساشي لا يفكر في ذلك أبدًا
Dialogue: 0,0:23:05.93,0:23:07.18,DC,,0,0,0,,‫أرأيت؟ لقد قلت لك!
Dialogue: 0,0:23:07.76,0:23:09.30,DC,,0,0,0,,...أممم
Dialogue: 0,0:23:10.60,0:23:12.14,DC,,0,0,0,,!هذا أمر خطير
Dialogue: 0,0:23:12.22,0:23:14.23,DC,,0,0,0,, ،إذا تغير التاريخ
Dialogue: 0,0:23:14.31,0:23:17.15,DC,,0,0,0,,.فقد تتغير نتيجة المبارزة أيضًا
Dialogue: 0,0:23:17.23,0:23:19.65,DC,,0,0,0,,...إذا خسر موساشي
Dialogue: 0,0:23:20.27,0:23:23.40,DC,,0,0,0,,.فلن نتمكن من العودة إلى زمننا الأصلي
Dialogue: 0,0:23:24.53,0:23:25.45,DC,,0,0,0,,‫لا يمكن.
Dialogue: 0,0:23:26.07,0:23:28.37,DC,,0,0,0,,إذا حدث شيء كهذا، فما الذي سيحصل لساياكا والآخرين؟
Dialogue: 0,0:23:29.53,0:23:32.70,DC,,0,0,0,,‫حقا... ماذا سيحدث لنا؟
Dialogue: 0,0:23:36.58,0:23:37.42,DC,,0,0,0,,!مستحيل
Dialogue: 0,0:23:37.50,0:23:41.21,DC,,0,0,0,,ألا يعني هذا أن يايبا والآخرين أُرسلوا إلى الماضي؟
Dialogue: 0,0:23:41.29,0:23:43.55,DC,,0,0,0,,!عودوا بسرعة، يايبا
Dialogue: 0,0:23:43.63,0:23:45.51,DC,,0,0,0,,...إذا استمر الوضع هكذا، فنحن
Dialogue: 0,0:23:45.59,0:23:51.00,DCNN,,0,0,0,,{\pos(960,1000.0)}‫في الحلقة القادمة: معركة جزيرة غانريو
Dialogue: 0,0:23:48.05,0:23:49.99,DC,,0,0,0,,{\an8}‫حان وقت المبارزة، كوجيرو!
Dialogue: 0,0:23:51.00,0:23:52.99,DCDialogRedName,,0,0,0,,{\fs110\pos(959,629)\fnAl-Jazeera-Arabic-Bold}CodeSubs :ترجمة وتدقيق\N{\fs80}linktr.ee/CodeSubs
