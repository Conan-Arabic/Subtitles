Dialogue: 0,0:00:00.00,0:00:07.07,try,,0,0,0,,{\fs110.25\pos(1399.5,162)}@KatoSubs :ترجمة
Dialogue: 0,0:00:04.56,0:00:06.48,try,,0,0,0,,محطة ناغويا
Dialogue: 0,0:00:09.44,0:00:10.56,try,,0,0,0,,!!لذيـــــــــــــــــــــــــذ
Dialogue: 0,0:00:10.77,0:00:13.14,try,,0,0,0,,!هذا هو الميسو كوشيكاتسو إذن
Dialogue: 0,0:00:13.23,0:00:14.82,try,,0,0,0,,!في غـاية الـلذة! نقيق
Dialogue: 0,0:00:15.19,0:00:17.90,try,,0,0,0,,!بوسعي أكل ما لا يحصى منه
Dialogue: 0,0:00:18.49,0:00:20.07,try,,0,0,0,,ما الّذي تصنعين فجأةً؟
Dialogue: 0,0:00:20.07,0:00:21.32,try,,0,0,0,,أما طاب لكِ؟
Dialogue: 0,0:00:22.20,0:00:26.41,try,,0,0,0,,،ما دمنا جئنا إلى ناغويا\N.فعليّ نشر بعض الصور على الإنستي
Dialogue: 0,0:00:26.49,0:00:27.50,try,,0,0,0,,وما ذاك؟
Dialogue: 0,0:00:27.66,0:00:29.96,try,,0,0,0,,~لا تلومينني إن نشله منكِ نسرٌ
Dialogue: 0,0:00:31.67,0:00:34.17,try,,0,0,0,,.اراكم غير مبالين كالعادة
Dialogue: 0,0:00:35.42,0:00:36.38,try,,0,0,0,,!نقيــــــق
Dialogue: 0,0:00:36.46,0:00:38.30,try,,0,0,0,,...انـــت
Dialogue: 0,0:00:38.88,0:00:41.68,try,,0,0,0,,!!يـرقــــــــــــــــانة
Dialogue: 0,0:00:45.26,0:00:46.89,try,,0,0,0,,.اخطأت
Dialogue: 0,0:00:47.52,0:00:50.77,try,,0,0,0,,...انا أحد الوحوش الثمانية الخادمين لأونيمارو
Dialogue: 0,0:00:51.06,0:00:53.44,try,,0,0,0,,...السيد حلزون أو
Dialogue: 0,0:00:54.10,0:00:57.15,try,,0,0,0,,~حلزونـــة
Dialogue: 0,0:00:58.90,0:01:01.31,try,,0,0,0,,اذن كل ما في الأمر أنّك أضفت صدفةً؟
Dialogue: 0,0:01:01.40,0:01:03.36,try,,0,0,0,,ألا يتعلم من درسه؟
Dialogue: 0,0:01:03.74,0:01:05.03,try,,0,0,0,,!هـات بالملح، هـات
Dialogue: 0,0:01:05.16,0:01:06.16,try,,0,0,0,,.نقيق
Dialogue: 0,0:01:07.41,0:01:10.53,try,,0,0,0,,!علمنا نقطة ضعفك سابقًا
Dialogue: 0,0:01:11.20,0:01:12.25,try,,0,0,0,,!هــــــاك
Dialogue: 0,0:01:14.42,0:01:15.25,try,,0,0,0,,آري؟
Dialogue: 0,0:01:21.05,0:01:25.34,try,,0,0,0,,~طالما أنّي في الصدفة فمحالٌ عليك لمسي
Dialogue: 0,0:01:26.01,0:01:28.93,try,,0,0,0,,،لا شك أن الصدفة تحميه
Dialogue: 0,0:01:29.02,0:01:31.14,try,,0,0,0,,لكن هذا ليس في صالحه أيضًا
Dialogue: 0,0:01:31.22,0:01:32.27,try,,0,0,0,,.فلا يسعه الحراك
Dialogue: 0,0:01:36.65,0:01:37.97,try,,0,0,0,,!سينبوكيــن
Dialogue: 0,0:01:42.78,0:01:44.20,try,,0,0,0,,...آهٍ منه
Dialogue: 0,0:01:44.66,0:01:48.20,try,,0,0,0,,أهو حقًّا من أتباع أونيمارو؟
Dialogue: 0,0:01:50.70,0:01:52.53,try,,0,0,0,,،فور رؤيتي لأونيمارو المرة القادمة
Dialogue: 0,0:01:52.62,0:01:55.17,try,,0,0,0,,!لأطيحنّ به بالسينبوكين خاصتي
Dialogue: 0,0:01:57.75,0:01:59.88,try,,0,0,0,,!لا أعتقد ذلــك
Dialogue: 0,0:02:09.22,0:02:10.93,try,,0,0,0,,!تأهّب يا يايبـا
Dialogue: 0,0:02:13.31,0:02:17.06,try,,0,0,0,,...لعلّ هذا الشخص بئيس
Dialogue: 0,0:02:31.95,0:02:34.37,try,,0,0,0,,يـايبـا: أسطـورة السـاموراي
Dialogue: 0,0:03:50.24,0:03:55.04,try,,0,0,0,,الحلقـة 6\Nبـاتمان
Dialogue: 0,0:03:57.08,0:03:58.58,try,,0,0,0,,!من تكون يـا هذا؟
Dialogue: 0,0:04:00.54,0:04:01.79,try,,0,0,0,,!~هـاي
Dialogue: 0,0:04:02.04,0:04:03.38,try,,0,0,0,,،كما تبصر
Dialogue: 0,0:04:03.46,0:04:06.05,try,,0,0,0,,...انا أحد الوحوش الثمانية الخادمين لأونيمارو
Dialogue: 0,0:04:06.42,0:04:09.01,try,,0,0,0,,!الرجل الخفـاش
Dialogue: 0,0:04:10.93,0:04:13.14,try,,0,0,0,,!فلتعد لي الكوشيكاتسو خاصتي
Dialogue: 0,0:04:19.81,0:04:23.02,try,,0,0,0,,ناغويا جنّةٌ للذوّاقين، أليس كذلك؟
Dialogue: 0,0:04:23.52,0:04:25.27,try,,0,0,0,,!هاي يا فتى الرعود
Dialogue: 0,0:04:25.69,0:04:30.57,try,,0,0,0,,!لا يحق لأحدٍ حمل سيف الرايجين عدا السيد أونيمارو
Dialogue: 0,0:04:31.11,0:04:33.45,try,,0,0,0,,!لا يليق بك تمامًا
Dialogue: 0,0:04:33.74,0:04:34.74,try,,0,0,0,,!ماذا قلـت؟
Dialogue: 0,0:04:35.15,0:04:37.87,try,,0,0,0,,،الآن وقبل أن تتأذى
Dialogue: 0,0:04:37.95,0:04:41.65,try,,0,0,0,,.فلتسلّم لي السيف بكل لطف
Dialogue: 0,0:04:42.71,0:04:44.63,try,,0,0,0,,!فلتحاول أخذه إن أردته
Dialogue: 0,0:04:45.09,0:04:48.21,try,,0,0,0,,!كل ما يتطلبه الأمر هو تلويحة من السينبوكين وانتهى أمرك
Dialogue: 0,0:04:49.05,0:04:50.76,try,,0,0,0,,~لك ذلك يا فتى
Dialogue: 0,0:04:50.80,0:04:56.18,try,,0,0,0,,.طالما تريد هزيمةً فلن أرد طلبك
Dialogue: 0,0:04:57.52,0:04:58.68,try,,0,0,0,,...استعداد
Dialogue: 0,0:05:04.10,0:05:04.93,try,,0,0,0,,!انطلاق
Dialogue: 0,0:05:16.99,0:05:18.33,try,,0,0,0,,!يا لسذاجتــــك
Dialogue: 0,0:05:21.70,0:05:23.04,try,,0,0,0,,!انتبـه! نقيق
Dialogue: 0,0:05:32.22,0:05:33.26,try,,0,0,0,,!مهلًا يا هذا
Dialogue: 0,0:05:33.93,0:05:35.93,try,,0,0,0,,!الطيران غشٌّ يا جبان
Dialogue: 0,0:05:36.01,0:05:37.26,try,,0,0,0,,!اخــرس
Dialogue: 0,0:05:37.64,0:05:42.02,try,,0,0,0,,!ايّها البشري العاجز على الطيران
Dialogue: 0,0:05:45.31,0:05:46.86,try,,0,0,0,,...يا ابن الـ
Dialogue: 0,0:05:47.36,0:05:48.73,try,,0,0,0,,!هيّـا بنـا يا شينوسكي
Dialogue: 0,0:05:54.78,0:05:57.70,try,,0,0,0,,...جنـاحا
Dialogue: 0,0:05:58.08,0:06:00.45,try,,0,0,0,,!يايبـا
Dialogue: 0,0:06:00.91,0:06:03.71,try,,0,0,0,,!برافــو يـا فتـى الرعود
Dialogue: 0,0:06:04.08,0:06:05.00,try,,0,0,0,,...ولكن
Dialogue: 0,0:06:05.00,0:06:08.84,try,,0,0,0,,~طرت أم لا، محالٌ أن تهزمني
Dialogue: 0,0:06:09.13,0:06:10.80,try,,0,0,0,,!فلتخرس
Dialogue: 0,0:06:12.84,0:06:14.51,try,,0,0,0,,...سريعٌ هو
Dialogue: 0,0:06:15.09,0:06:18.05,try,,0,0,0,,.يتصدى لهجمات يايبا بكل سهولة
Dialogue: 0,0:06:18.80,0:06:23.35,try,,0,0,0,,ولكن إن حدث واخترق دفاعة\N...فلعلّ النصر حليفه
Dialogue: 0,0:06:36.15,0:06:39.74,try,,0,0,0,,!حسنٌ، حان وقت السينبوكين
Dialogue: 0,0:06:42.83,0:06:44.87,try,,0,0,0,,...يـايبـا
Dialogue: 0,0:06:45.37,0:06:50.17,try,,0,0,0,,!!سـينبوكـيــــــــــــــــــــــــــــــــن
Dialogue: 0,0:06:53.55,0:06:54.42,try,,0,0,0,,!سحقًا
Dialogue: 0,0:06:54.55,0:06:56.80,try,,0,0,0,,...لن يتسنى لي استخدام السينبوكين هكذا
Dialogue: 0,0:07:00.89,0:07:05.02,try,,0,0,0,,!عبـثٌ مـا تقوم به
Dialogue: 0,0:07:11.69,0:07:14.32,try,,0,0,0,,!آن أوان هلاكك
Dialogue: 0,0:07:18.20,0:07:19.45,try,,0,0,0,,!تـأهّب
Dialogue: 0,0:07:25.25,0:07:27.54,try,,0,0,0,,...يا لحدّة سيافتك
Dialogue: 0,0:07:27.92,0:07:30.83,try,,0,0,0,,!من تكون بـحقٍّ؟
Dialogue: 0,0:07:32.88,0:07:34.67,try,,0,0,0,,...انـا
Dialogue: 0,0:07:35.09,0:07:36.51,try,,0,0,0,,!الـفريد
Dialogue: 0,0:07:37.05,0:07:38.47,try,,0,0,0,,!الـفذّ
Dialogue: 0,0:07:39.05,0:07:41.80,try,,0,0,0,,!جالب الرعب
Dialogue: 0,0:07:42.43,0:07:45.27,try,,0,0,0,,...مياموتو موساشي من أكون
Dialogue: 0,0:07:45.85,0:07:48.73,try,,0,0,0,,!فـإيّاك نسيانه
Dialogue: 0,0:07:50.35,0:07:53.44,try,,0,0,0,,!!اووووه! موساشي مياموتو
Dialogue: 0,0:07:53.98,0:07:55.28,try,,0,0,0,,!عظيـم
Dialogue: 0,0:07:55.57,0:07:58.20,try,,0,0,0,,!مرشدي الروحي
Dialogue: 0,0:07:59.07,0:08:03.91,try,,0,0,0,,!لقاء أعظم سياف في اليابان لحظٌّ عظيم
Dialogue: 0,0:08:03.99,0:08:05.99,try,,0,0,0,,...تبالغ يا هذا
Dialogue: 0,0:08:06.16,0:08:10.50,try,,0,0,0,,.لكن ليتك أحدنا
Dialogue: 0,0:08:15.09,0:08:16.13,try,,0,0,0,,!مـوسـاشي
Dialogue: 0,0:08:21.22,0:08:22.26,try,,0,0,0,,!موسـاشي
Dialogue: 0,0:08:22.43,0:08:23.80,try,,0,0,0,,أبخيرٍ أنت؟
Dialogue: 0,0:08:30.17,0:08:33.48,try,,0,0,0,,!!نقيـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــق
Dialogue: 0,0:08:37.57,0:08:39.53,try,,0,0,0,,!ايّاك أن تقترب
Dialogue: 0,0:08:46.28,0:08:48.16,try,,0,0,0,,...والآن أيّتها الحسناء
Dialogue: 0,0:08:49.12,0:08:52.04,try,,0,0,0,,.هـاتي بـفتى الرعود
Dialogue: 0,0:08:53.04,0:08:54.38,try,,0,0,0,,...يا جماعة
Dialogue: 0,0:08:59.13,0:08:59.96,try,,0,0,0,,!كاغيتــورا
Dialogue: 0,0:09:00.80,0:09:03.72,try,,0,0,0,,!حـان وقت العرض
Dialogue: 0,0:09:09.48,0:09:10.60,try,,0,0,0,,...ايّهـا
Dialogue: 0,0:09:11.27,0:09:12.81,try,,0,0,0,,!العجوز المنحط...
Dialogue: 0,0:09:14.15,0:09:15.02,try,,0,0,0,,!شونوسكـي
Dialogue: 0,0:09:24.74,0:09:25.74,try,,0,0,0,,...كاغيتورا
Dialogue: 0,0:09:26.37,0:09:28.54,try,,0,0,0,,!توخ الحذر
Dialogue: 0,0:09:31.12,0:09:32.71,try,,0,0,0,,!لـن تفـرّ
Dialogue: 0,0:09:53.81,0:09:54.90,try,,0,0,0,,!شونوسكـي
Dialogue: 0,0:09:58.27,0:09:59.19,try,,0,0,0,,...سحقًا
Dialogue: 0,0:10:01.53,0:10:02.53,try,,0,0,0,,!سـايـاكـا
Dialogue: 0,0:10:05.45,0:10:07.74,try,,0,0,0,,!لا تفلتينني مهما حصل
Dialogue: 0,0:10:08.20,0:10:09.20,try,,0,0,0,,.حـ- حسنٌ
Dialogue: 0,0:10:21.09,0:10:24.88,try,,0,0,0,,.ابدعت في الهرب يا فتى الرعود
Dialogue: 0,0:10:25.01,0:10:26.05,try,,0,0,0,,...ولكن
Dialogue: 0,0:10:31.01,0:10:34.18,try,,0,0,0,,...انا رجل الخفاش
Dialogue: 0,0:10:34.18,0:10:39.02,try,,0,0,0,,!لأجعلنّ سيف الرايجين مِلكــــــــــــــي
Dialogue: 0,0:10:42.74,0:10:44.65,try,,0,0,0,,...اتساءل إن كان الجميع بخير
Dialogue: 0,0:10:47.16,0:10:48.16,try,,0,0,0,,يايبا؟
Dialogue: 0,0:10:49.07,0:10:49.91,try,,0,0,0,,...اقول يا ساياكا
Dialogue: 0,0:10:50.91,0:10:51.99,try,,0,0,0,,.هاتي بتلك الكرة
Dialogue: 0,0:10:52.33,0:10:53.20,try,,0,0,0,,مـا...؟
Dialogue: 0,0:10:53.66,0:10:56.83,try,,0,0,0,,!لعلّي أغلب رجل الخفاش بها
Dialogue: 0,0:10:57.08,0:10:57.96,try,,0,0,0,,!كـلّا
Dialogue: 0,0:10:59.67,0:11:00.67,try,,0,0,0,,...فقد
Dialogue: 0,0:11:01.84,0:11:04.13,try,,0,0,0,,تتحول لشيطانٍ ثانيةً، صحيح؟
Dialogue: 0,0:11:04.30,0:11:05.88,try,,0,0,0,,!سـأكون بـخير
Dialogue: 0,0:11:06.05,0:11:07.84,try,,0,0,0,,!فقد كنت أتمرن
Dialogue: 0,0:11:08.05,0:11:09.55,try,,0,0,0,,.هذه المرة ليست كسابقيها
Dialogue: 0,0:11:10.60,0:11:15.10,try,,0,0,0,,،ولكن إن حدث الأمر ثانيةً\Nفمن سيوقفك حينها؟
Dialogue: 0,0:11:24.23,0:11:26.07,try,,0,0,0,,!اذن أنّى لي أن أغلبه؟
Dialogue: 0,0:11:26.49,0:11:29.70,try,,0,0,0,,!حتى السينبوكين عقيمة أمام من يطير
Dialogue: 0,0:11:30.49,0:11:31.53,try,,0,0,0,,...هذا
Dialogue: 0,0:11:32.03,0:11:35.50,try,,0,0,0,,!عليّ هزيمته وإنقاذ البقية
Dialogue: 0,0:11:35.87,0:11:36.70,try,,0,0,0,,!ولكن
Dialogue: 0,0:11:37.87,0:11:40.88,try,,0,0,0,,!ها أنت ذا يا فتى الرعد
Dialogue: 0,0:11:41.21,0:11:42.21,try,,0,0,0,,!رجل الخفاش
Dialogue: 0,0:11:42.75,0:11:43.58,try,,0,0,0,,!تنحِّ
Dialogue: 0,0:11:43.63,0:11:45.92,try,,0,0,0,,.لا مجال لكما بالهرب هذه المرة
Dialogue: 0,0:11:46.63,0:11:49.93,try,,0,0,0,,وغالبًا أن موساشي والبقية
Dialogue: 0,0:11:50.01,0:11:51.89,try,,0,0,0,,.أمسكوا بنمرك الأليف
Dialogue: 0,0:11:52.39,0:11:56.43,try,,0,0,0,,!والآن هـاتِ بـسيف الرايجين
Dialogue: 0,0:11:56.77,0:11:57.73,try,,0,0,0,,8 – 4 – 5 –
Dialogue: 0,0:11:58.14,0:11:59.10,try,,0,0,0,,3 – 2 – 7...
Dialogue: 0,0:11:59.94,0:12:01.06,try,,0,0,0,,...استعداد
Dialogue: 0,0:12:01.44,0:12:02.86,try,,0,0,0,,!هيّـا! هيّـا! هيّـا
Dialogue: 0,0:12:03.52,0:12:04.35,try,,0,0,0,,!انطلقـــوا
Dialogue: 0,0:12:16.04,0:12:16.87,try,,0,0,0,,!سحقًـا
Dialogue: 0,0:12:16.87,0:12:18.79,try,,0,0,0,,!السينبوكين كفيلة بهزمكم
Dialogue: 0,0:12:19.16,0:12:20.87,try,,0,0,0,,!لا أظن ذلـك
Dialogue: 0,0:12:23.13,0:12:24.04,try,,0,0,0,,!يـايبـا
Dialogue: 0,0:12:34.64,0:12:38.93,try,,0,0,0,,!لا يسعك الهرب وبرفقتك حسناء
Dialogue: 0,0:12:39.60,0:12:41.90,try,,0,0,0,,.هذه النهاية
Dialogue: 0,0:12:45.98,0:12:47.07,try,,0,0,0,,!كـاغيتـورا
Dialogue: 0,0:12:48.65,0:12:50.28,try,,0,0,0,,!اذن انت بخيرٍ
Dialogue: 0,0:12:51.86,0:12:55.87,try,,0,0,0,,...يبدو أن موساشي والبقية فشلوا
Dialogue: 0,0:12:59.37,0:13:01.71,try,,0,0,0,,...يا لخيبة المسعى
Dialogue: 0,0:13:06.71,0:13:09.05,try,,0,0,0,,ما الّذي ستفعله يا يايبا؟
Dialogue: 0,0:13:11.38,0:13:13.93,try,,0,0,0,,!من هناك يا كاغيتورا
Dialogue: 0,0:13:36.03,0:13:38.24,try,,0,0,0,,...لم يتبق الكثير حتى يجدنا
Dialogue: 0,0:13:38.91,0:13:40.12,try,,0,0,0,,...اقول يا ساياكا
Dialogue: 0,0:13:41.83,0:13:42.96,try,,0,0,0,,أليس رائعًا؟
Dialogue: 0,0:13:43.37,0:13:45.42,try,,0,0,0,,ما الّذي تفعله؟
Dialogue: 0,0:13:47.84,0:13:48.84,try,,0,0,0,,!اتى
Dialogue: 0,0:13:49.88,0:13:51.59,try,,0,0,0,,!ما نحن فاعلون؟
Dialogue: 0,0:14:20.08,0:14:24.79,try,,0,0,0,,!كفانا من الغميضة يا فتى الرعـــــود
Dialogue: 0,0:14:26.92,0:14:29.50,try,,0,0,0,,!واو! الحسنـاء
Dialogue: 0,0:14:30.13,0:14:31.34,try,,0,0,0,,!ها أنا ذا
Dialogue: 0,0:14:33.67,0:14:35.72,try,,0,0,0,,!كنــت أعلـم
Dialogue: 0,0:14:45.39,0:14:46.81,try,,0,0,0,,!ثغـــرة
Dialogue: 0,0:14:50.27,0:14:51.78,try,,0,0,0,,أنالت منه؟
Dialogue: 0,0:14:58.66,0:15:00.83,try,,0,0,0,,...انّى لك
Dialogue: 0,0:15:01.20,0:15:02.83,try,,0,0,0,,!سحقًا فقد صدها
Dialogue: 0,0:15:02.95,0:15:04.96,try,,0,0,0,,!عليّ استخدام السينبوكين
Dialogue: 0,0:15:06.71,0:15:10.38,try,,0,0,0,,...انّى لك تحطيم نظاراتي الشمسية العزيزة
Dialogue: 0,0:15:12.55,0:15:19.01,try,,0,0,0,,!يبدو أن عليّ قتلك يا فتى الرعود
Dialogue: 0,0:15:37.74,0:15:38.82,try,,0,0,0,,!يـايبـا
Dialogue: 0,0:15:48.04,0:15:50.46,try,,0,0,0,,...اراك عنيدًا
Dialogue: 0,0:15:51.08,0:15:53.00,try,,0,0,0,,!اخرس\N!فالأمر ينطبق عليك أيضًا
Dialogue: 0,0:15:55.76,0:15:57.47,try,,0,0,0,,!اختفى\N!سيف الرايجين
Dialogue: 0,0:16:00.26,0:16:02.26,try,,0,0,0,,.يبدو أنها النهاية
Dialogue: 0,0:16:02.64,0:16:03.93,try,,0,0,0,,،امّا عن سيف الرايجين
Dialogue: 0,0:16:04.01,0:16:07.14,try,,0,0,0,,فسأتلذذ بغنيمتي الجديدة بأناءٍ
Dialogue: 0,0:16:07.22,0:16:09.90,try,,0,0,0,,!حالما انتهي منك
Dialogue: 0,0:16:12.77,0:16:13.94,try,,0,0,0,,!سيف الرايجين
Dialogue: 0,0:16:19.74,0:16:20.74,try,,0,0,0,,!ثقيـل
Dialogue: 0,0:16:20.95,0:16:24.28,try,,0,0,0,,أكنت تحمل هذا الشيء الثقيل طوال الوقت يا يايبا...؟
Dialogue: 0,0:16:24.91,0:16:26.95,try,,0,0,0,,!ساعدني يـا كاغيتورا
Dialogue: 0,0:16:29.92,0:16:31.21,try,,0,0,0,,!اصمد يا يايبا
Dialogue: 0,0:16:52.31,0:16:53.65,try,,0,0,0,,!مو وقتك
Dialogue: 0,0:17:00.57,0:17:03.35,try,,0,0,0,,!فـلتـستسلــــــم
Dialogue: 0,0:17:16.71,0:17:18.05,try,,0,0,0,,!تبًّا
Dialogue: 0,0:17:30.14,0:17:34.31,try,,0,0,0,,...خـائبٌ أنت يا فتى الرعود
Dialogue: 0,0:17:38.11,0:17:39.48,try,,0,0,0,,!يايبـا
Dialogue: 0,0:17:44.99,0:17:46.78,try,,0,0,0,,!عليك بالسينبوكين
Dialogue: 0,0:17:49.70,0:17:50.62,try,,0,0,0,,!حسـنٌ
Dialogue: 0,0:17:52.00,0:17:54.21,try,,0,0,0,,...سينـ... بو
Dialogue: 0,0:17:58.67,0:18:00.59,try,,0,0,0,,!ما هذه بحقٍّ؟
Dialogue: 0,0:18:02.34,0:18:04.51,try,,0,0,0,,!تلك الكرة لن تتزحزح
Dialogue: 0,0:18:04.93,0:18:06.51,try,,0,0,0,,وسيفك العزيز 
Dialogue: 0,0:18:06.60,0:18:09.68,try,,0,0,0,,!عقيمٌ بدون تلك الفتحة
Dialogue: 0,0:18:09.89,0:18:12.56,try,,0,0,0,,!يبدو أن لا حيلة لك الآن
Dialogue: 0,0:18:13.81,0:18:15.73,try,,0,0,0,,...لا حاجة لي بالسينبوكين
Dialogue: 0,0:18:16.73,0:18:18.73,try,,0,0,0,,!لـقطعك إلى نصفين
Dialogue: 0,0:18:19.06,0:18:20.15,try,,0,0,0,,...لا، لا
Dialogue: 0,0:18:20.32,0:18:23.49,try,,0,0,0,,!ايّاك والغـــــــــــرور
Dialogue: 0,0:18:52.39,0:18:53.85,try,,0,0,0,,!يايبـا
Dialogue: 0,0:18:56.44,0:18:57.94,try,,0,0,0,,!...سحقًا
Dialogue: 0,0:18:59.36,0:19:03.24,try,,0,0,0,,.مجموعة لعب يا فتى الرعود
Dialogue: 0,0:19:03.90,0:19:04.90,try,,0,0,0,,!انّه لقاتلني
Dialogue: 0,0:19:05.65,0:19:07.16,try,,0,0,0,,~تصبح على خير
Dialogue: 0,0:19:09.07,0:19:11.62,try,,0,0,0,,!!كُـــــــــــــــــــــــــــــــــــــــــــــفّ
Dialogue: 0,0:19:14.50,0:19:16.54,try,,0,0,0,,!يـا إلهي
Dialogue: 0,0:19:28.09,0:19:29.05,try,,0,0,0,,!فهمـت
Dialogue: 0,0:19:46.28,0:19:47.11,try,,0,0,0,,!مـا الّـ...؟
Dialogue: 0,0:19:53.33,0:19:55.66,try,,0,0,0,,...مـ- محال
Dialogue: 0,0:20:04.34,0:20:06.76,try,,0,0,0,,!اشعة الشمس هي السبيل
Dialogue: 0,0:20:06.92,0:20:07.97,try,,0,0,0,,!الـلعنة
Dialogue: 0,0:20:10.09,0:20:13.43,try,,0,0,0,,!هذه فرصتــــــــــــــــــــــــي
Dialogue: 0,0:20:14.01,0:20:19.18,try,,0,0,0,,!!سينـ... بو... كيـــــــــــــــــــــــــــــــــــــــــــــــــن
Dialogue: 0,0:20:26.07,0:20:29.40,try,,0,0,0,,...غـاد دايم
Dialogue: 0,0:20:39.54,0:20:41.33,try,,0,0,0,,!!فعلتهـا يا يايبـــا
Dialogue: 0,0:20:42.17,0:20:44.13,try,,0,0,0,,!حمدًا لـفوزك
Dialogue: 0,0:20:47.00,0:20:48.09,try,,0,0,0,,!كفّي
Dialogue: 0,0:20:48.21,0:20:50.59,try,,0,0,0,,.لا وقت لي للنساء حاليًّا
Dialogue: 0,0:20:53.30,0:20:54.55,try,,0,0,0,,...يا له من غريب
Dialogue: 0,0:21:05.19,0:21:07.44,try,,0,0,0,,...يا إلهي
Dialogue: 0,0:21:07.69,0:21:10.40,try,,0,0,0,,...كان مأزقًا مروّعًا
Dialogue: 0,0:21:11.36,0:21:13.95,try,,0,0,0,,ألن تأكل يا يايبا؟
Dialogue: 0,0:21:15.78,0:21:19.62,try,,0,0,0,,...ادرك أنّ طريقه طويل
Dialogue: 0,0:21:19.91,0:21:22.62,try,,0,0,0,,!مصيبـة! فلتلقوا نظرة على هذا، نقيق
Dialogue: 0,0:21:23.46,0:21:25.84,try,,0,0,0,,ما ذلك؟ مانجو على شكل شيطان؟
Dialogue: 0,0:21:26.25,0:21:30.05,try,,0,0,0,,،ليست أي مانجو\N!بل مانجو أونيمارو
Dialogue: 0,0:21:30.55,0:21:31.51,try,,0,0,0,,!ماذا قلت؟
Dialogue: 0,0:21:32.13,0:21:35.10,try,,0,0,0,,!ذاك المحل هناك يبيعها
Dialogue: 0,0:21:35.89,0:21:36.89,try,,0,0,0,,...شاهدوا
Dialogue: 0,0:21:37.47,0:21:47.61,try,,0,0,0,,{\pos(896,108)}مبنى الحمية الوطنية/ قناة نيشيوري: المراسلة شيوجي
Dialogue: 0,0:21:38.10,0:21:41.43,try,,0,0,0,,،ونيمارو، الذي استحوذ على مبنى الحمية الوطنية
Dialogue: 0,0:21:41.56,0:21:43.35,try,,0,0,0,,،يكتسب الآن مؤيدين في جميع أنحاء البلاد
Dialogue: 0,0:21:43.44,0:21:44.43,try,,0,0,0,,وقد ألهم ذلك سلسلة من منتجات أونيمارو
Dialogue: 0,0:21:45.02,0:21:47.61,try,,0,0,0,,بما في ذلك الحلويات الشهية وعدد لا \N.يحصى من المنتجات التي تم التعاون فيها
Dialogue: 0,0:21:48.07,0:21:49.78,try,,0,0,0,,...ذاك الوغد أونيمارو
Dialogue: 0,0:21:50.07,0:21:51.65,try,,0,0,0,,علينا التعجيل بالذهاب إلى غانريو
Dialogue: 0,0:21:51.78,0:21:54.78,try,,0,0,0,,.قبل أن ينشر سمّه أكثر حول البلاد
Dialogue: 0,0:21:57.28,0:21:58.54,try,,0,0,0,,...اقوى
Dialogue: 0,0:21:59.70,0:22:01.54,try,,0,0,0,,!عليّ أن أصبح أقوى
Dialogue: 0,0:23:36.84,0:23:38.76,try,,0,0,0,,~ادركنا جزيرة غانريو أخيرًا
Dialogue: 0,0:23:39.01,0:23:39.93,try,,0,0,0,,...ولكن حينما وصلنا
Dialogue: 0,0:23:40.01,0:23:43.14,try,,0,0,0,,محالٌ، أليس كذلك؟\N!انّى لهذا أن يحدث؟
Dialogue: 0,0:23:43.39,0:23:45.10,try,,0,0,0,,!يـايبــــا
Dialogue: 0,0:23:45.56,0:23:46.98,try,,0,0,0,,المرة القادمة\Nانبعاث كوجيرو
Dialogue: 0,0:23:47.94,0:23:49.31,try,,0,0,0,,!مصيبة- زورا
