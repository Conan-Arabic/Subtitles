Dialogue: 0,0:00:01.00,0:00:08.00,DCRights,,0,0,0,,{\fs70\pos(20,25)} ABOODY SUBS | ترجمة \NTelegram : ABOODY-SUBS\NX : @ABOODY_SUBS
Dialogue: 0,0:00:06.03,0:00:07.80,Default,,0,0,0,,!إذن هذه هي شيكوكو
Dialogue: 0,0:00:07.96,0:00:08.84,Default,,0,0,0,,!أيها الأحمق
Dialogue: 0,0:00:09.09,0:00:11.93,Default,,0,0,0,,!ما زال علينا عبور خليج أوساكا هذا
Dialogue: 0,0:00:12.09,0:00:14.34,Default,,0,0,0,,هل شيكوكو تعتبر دولة أخرى؟
Dialogue: 0,0:00:14.51,0:00:18.06,Default,,0,0,0,,...إذا كان الأمر كذلك، فسنحتاج إلى تصاريح سفر دولية
Dialogue: 0,0:00:18.22,0:00:20.39,Default,,0,0,0,,ما هذا الهراء الذي تقوله؟
Dialogue: 0,0:00:20.77,0:00:23.02,Default,,0,0,0,,.شيكوكو جزء من اليابان
Dialogue: 0,0:00:23.98,0:00:25.65,Default,,0,0,0,,لكن، كيف سنصل إلى هناك؟
Dialogue: 0,0:00:25.81,0:00:29.78,Default,,0,0,0,,.لقد أنفقنا كل أموالنا تقريبًا على رحلة القطار السريع
Dialogue: 0,0:00:31.03,0:00:35.07,Default,,0,0,0,,.سنعبر الخليج في ثانية واحدة، بفضل سيف كوجيرو
Dialogue: 0,0:00:35.57,0:00:36.62,Default,,0,0,0,,!لن افعل
Dialogue: 0,0:00:38.16,0:00:40.37,Default,,0,0,0,,!الماء المالح سوف يصدئ سيفي الجميل
Dialogue: 0,0:00:40.58,0:00:42.54,Default,,0,0,0,,أنت قلق بشأن القليل من الصدأ الآن؟
Dialogue: 0,0:00:42.87,0:00:45.79,Default,,0,0,0,,...لا يمكننا جميعًا الركب على شونوسوكي
Dialogue: 0,0:00:47.38,0:00:48.34,Default,,0,0,0,,!لدي فكرة
Dialogue: 0,0:00:48.59,0:00:51.72,Default,,0,0,0,,ألا يمكنك مساعدتنا باستخدام كرة الماء؟
Dialogue: 0,0:00:52.01,0:00:54.84,Default,,0,0,0,,.تبا، لا أعتقد أن هذه الكرة مفيدة كثيرًا
Dialogue: 0,0:00:55.01,0:00:58.76,Default,,0,0,0,,!لم تستخدمها بعد بشكل جيد!، كن أكثر حماسًا
Dialogue: 0,0:00:59.35,0:01:00.47,Default,,0,0,0,,حماس؟
Dialogue: 0,0:01:01.18,0:01:02.26,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:01:19.99,0:01:21.70,Default,,0,0,0,,.لم يحدث شيء
Dialogue: 0,0:01:23.00,0:01:25.21,Default,,0,0,0,,!تبا!، سأحاول مرة أخرى
Dialogue: 0,0:01:25.71,0:01:27.58,Default,,0,0,0,,!كن أكثر حماسًا، يايبا
Dialogue: 0,0:01:33.09,0:01:34.30,Default,,0,0,0,,!شكرًا جزيلاً
Dialogue: 0,0:01:44.81,0:01:47.10,Default,,0,0,0,,أتساءل، ما سبب كل هذا الضجيج؟
Dialogue: 0,0:01:47.35,0:01:49.15,Default,,0,0,0,,!لقد سئمت!، سأتوقف
Dialogue: 0,0:01:49.44,0:01:52.86,Default,,0,0,0,,!مهما حاولت، لا شيء يحدث
Dialogue: 0,0:01:56.66,0:01:59.24,Default,,0,0,0,,!هذه الكرة عديمة الفائدة
Dialogue: 0,0:02:05.50,0:02:06.53,Default,,0,0,0,,...البحر
Dialogue: 0,0:02:07.78,0:02:10.34,Default,,0,0,0,,!لقد انشق إلى نصفين
Dialogue: 0,0:03:45.56,0:03:47.14,Default,,0,0,0,,!رائع جدًا
Dialogue: 0,0:03:47.81,0:03:51.10,Default,,0,0,0,,...إنها حقًا كرة روح الماء
Dialogue: 0,0:03:51.31,0:03:54.82,Default,,0,0,0,,!القدرة على التحكم في الماء حسب الرغبة أمر رائع حقًا
Dialogue: 0,0:03:55.98,0:03:57.94,Default,,0,0,0,,!إنها كرة جميلة
Dialogue: 0,0:04:14.83,0:04:19.67,Default,,0,0,0,,!الحلقة 14: ظهور النينجا كوتارو
Dialogue: 0,0:04:33.94,0:04:36.48,Default,,0,0,0,,.المنظر من جبل فوجي رائع
Dialogue: 0,0:04:37.11,0:04:40.94,Default,,0,0,0,,.ايها الملك أونيمارو، لقد تقدمت كثيرًا في مشروعنا الشهير
Dialogue: 0,0:04:41.53,0:04:45.95,Default,,0,0,0,,!"لقد أطلقت عليه:"مشروع غزو العالم بواسطة أونيمارو
Dialogue: 0,0:04:46.37,0:04:48.41,Default,,0,0,0,,،أولًا نسيطر على اليابان
Dialogue: 0,0:04:48.58,0:04:51.54,Default,,0,0,0,,.ثم ننتشر عالميًا
Dialogue: 0,0:04:51.71,0:04:56.92,Default,,0,0,0,,.لقد استولينا بالفعل على جميع المناطق الحضرية الرئيسية في اليابان
Dialogue: 0,0:04:57.25,0:04:59.38,Default,,0,0,0,,.أراك مستعدًا، كما أرى
Dialogue: 0,0:05:01.88,0:05:03.93,Default,,0,0,0,,أوساكا لم تسقط بعد؟
Dialogue: 0,0:05:04.30,0:05:06.51,Default,,0,0,0,,هل هددت المدينة جيدًا؟
Dialogue: 0,0:05:08.81,0:05:10.72,Default,,0,0,0,, .لا بأس
Dialogue: 0,0:05:11.68,0:05:12.81,Default,,0,0,0,,.أحرقوها
Dialogue: 0,0:05:13.19,0:05:14.73,Default,,0,0,0,,!انعطاف بزاوية 160 درجة
Dialogue: 0,0:05:14.90,0:05:17.81,Default,,0,0,0,,!°زاوية التصويب: -0.4
Dialogue: 0,0:05:20.40,0:05:22.24,Default,,0,0,0,,لقد قمت بتحسين بعد تحسين
Dialogue: 0,0:05:22.40,0:05:26.20,Default,,0,0,0,,!لجعل مدفع أونيمارو أكثر رعبًا
Dialogue: 0,0:05:26.78,0:05:28.20,Default,,0,0,0,,!انظرو
Dialogue: 0,0:05:28.37,0:05:32.04,Default,,0,0,0,,!إلى قوة مدفع أونيمارو الجديد
Dialogue: 0,0:05:48.10,0:05:50.43,Default,,0,0,0,,.حسنًا، أوساكا سقطت
Dialogue: 0,0:05:53.31,0:05:54.73,Default,,0,0,0,,!قوة جنونية
Dialogue: 0,0:05:57.27,0:06:01.19,Default,,0,0,0,,.يا رجل العنكبوت، اذهب إلى كوروغاني يايبا
Dialogue: 0,0:06:01.69,0:06:05.28,Default,,0,0,0,,.أحد رجالي المبعوثين يجب أن يكون قريبًا
Dialogue: 0,0:06:05.49,0:06:06.78,Default,,0,0,0,,اعثره
Dialogue: 0,0:06:07.03,0:06:11.45,Default,,0,0,0,,!واحصل على إحدى الكرات الأسطورية قبل يايبا هذه المرة
Dialogue: 0,0:06:11.62,0:06:14.16,Default,,0,0,0,,!فهمت!، سأبذل قصارى جهدي
Dialogue: 0,0:06:15.29,0:06:18.75,Default,,0,0,0,,...حسنًا، نحن أخيرًا في شيكوكو هذه المرة
Dialogue: 0,0:06:19.33,0:06:22.34,Default,,0,0,0,,إذن، هل ستستمر الاستراحة طويلاً؟
Dialogue: 0,0:06:22.59,0:06:25.05,Default,,0,0,0,,.لا ينبغي أن نتأخر كثيرًا
Dialogue: 0,0:06:26.72,0:06:28.30,Default,,0,0,0,,!اميري يايبا
Dialogue: 0,0:06:29.47,0:06:31.30,Default,,0,0,0,,!ناديشيكو
Dialogue: 0,0:06:32.51,0:06:35.31,Default,,0,0,0,,!اميري يايبا، لقد اشتقت إليك كثيرًا
Dialogue: 0,0:06:35.48,0:06:36.23,Default,,0,0,0,,!مرحبًا
Dialogue: 0,0:06:36.73,0:06:37.85,Default,,0,0,0,,ما الذي تفعليه هنا؟
Dialogue: 0,0:06:38.02,0:06:42.61,Default,,0,0,0,,.لقد طلبت من ناديشيكو أن تبحث أكثر عن موقع الكرة
Dialogue: 0,0:06:42.98,0:06:46.36,Default,,0,0,0,,.حتى لا نبحث بشكل عشوائي، كما حدث المرة السابقة
Dialogue: 0,0:06:46.65,0:06:50.16,Default,,0,0,0,,.ناديشيكو، لا بد أن الرحلة كانت طويلة -\N.أعتذر -
Dialogue: 0,0:06:50.62,0:06:53.04,Default,,0,0,0,,،كان يجب أن ألتقي بكم عند بحيرة بيوا
Dialogue: 0,0:06:53.33,0:06:55.20,Default,,0,0,0,,...لكني لا أجيد استخدام المواصلات العامة
Dialogue: 0,0:06:55.37,0:06:58.00,Default,,0,0,0,,لا تخبريني أنكِ مشيتِ كل هذا الطريق؟
Dialogue: 0,0:06:58.17,0:06:58.83,Default,,0,0,0,,!نعم
Dialogue: 0,0:06:59.54,0:07:02.96,Default,,0,0,0,,،بعد لقائي بأميري يايبا، لأتدرب
Dialogue: 0,0:07:03.21,0:07:06.30,Default,,0,0,0,,.لقد تابعتُ والدي في مغامراته سيرًا على الأقدام
Dialogue: 0,0:07:06.59,0:07:10.84,Default,,0,0,0,,.لن يكون هذا عبثًا، إذا سمح لي بإرشادكم
Dialogue: 0,0:07:12.26,0:07:13.89,Default,,0,0,0,,!أنتِ قوية جدًا
Dialogue: 0,0:07:14.06,0:07:17.68,Default,,0,0,0,,.لا، ما زلتُ بعيدة جدًا عن مستواك
Dialogue: 0,0:07:18.31,0:07:22.48,Default,,0,0,0,,،وإن كان هذا سيقودني للاعتراف بقوتي يومًا ما
Dialogue: 0,0:07:22.69,0:07:24.73,Default,,0,0,0,,...لنتزوج ونبقى
Dialogue: 0,0:07:25.23,0:07:26.99,Default,,0,0,0,,!لا، كان هذا سوء فهم
Dialogue: 0,0:07:27.15,0:07:30.74,Default,,0,0,0,,.صحيح، لكن مشاعري لم تتغير
Dialogue: 0,0:07:32.66,0:07:33.45,Default,,0,0,0,,!هيا
Dialogue: 0,0:07:34.12,0:07:36.33,Default,,0,0,0,,!لنستعجل، قبل غروب الشمس
Dialogue: 0,0:07:37.66,0:07:40.33,Default,,0,0,0,,!انتظرني! -\N!مهلا، انتظروني
Dialogue: 0,0:07:40.87,0:07:43.75,Default,,0,0,0,,...هذا ما يعنيه الجهل نعمة
Dialogue: 0,0:07:46.05,0:07:48.13,Default,,0,0,0,,،منذ زمن بعيد، في جبل تسوروغي
Dialogue: 0,0:07:48.59,0:07:53.72,Default,,0,0,0,,.قام تانوكي كينشو بإخفاء كرة أسطورية\Nداخل صخرة ضخمة
Dialogue: 0,0:07:54.35,0:07:58.27,Default,,0,0,0,,.باستخدام تلك الكرة، يمكن تحقيق أي أمنية
Dialogue: 0,0:07:58.56,0:07:59.64,Default,,0,0,0,,تانوكي؟
Dialogue: 0,0:08:03.98,0:08:04.77,Default,,0,0,0,,.إنه هنا
Dialogue: 0,0:08:04.94,0:08:06.98,Default,,0,0,0,,في هذه الصخرة الكبيرة؟
Dialogue: 0,0:08:07.90,0:08:10.95,Default,,0,0,0,,!حسناً، سأحطم هذه الصخرة
Dialogue: 0,0:08:13.49,0:08:15.37,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:08:23.21,0:08:24.63,Default,,0,0,0,,!لـ-لم أكن مستعدًا لهذا
Dialogue: 0,0:08:24.79,0:08:26.46,Default,,0,0,0,,...لقد انفجرت فحسب
Dialogue: 0,0:08:26.63,0:08:28.59,Default,,0,0,0,,من فعل هذا؟
Dialogue: 0,0:08:28.76,0:08:30.51,Default,,0,0,0,,هل الكرة بخير؟
Dialogue: 0,0:08:32.13,0:08:34.79,Default,,0,0,0,,!أهذا مدخل كهف
Dialogue: 0,0:08:35.60,0:08:39.05,Default,,0,0,0,,،ربما لم تكن الكرة الأسطورية مخبأة في الصخرة
Dialogue: 0,0:08:39.42,0:08:43.27,Default,,0,0,0,,بل كانت محبوسة في مكان ما داخل الكهف؟
Dialogue: 0,0:08:46.11,0:08:49.57,Default,,0,0,0,,يايبا، ألا يجب أن نعود؟
Dialogue: 0,0:08:51.86,0:08:53.49,Default,,0,0,0,,!مهلا، انتظروني
Dialogue: 0,0:08:53.99,0:08:57.37,Default,,0,0,0,,.لا شك أن أحدهم نصب فخاخًا
Dialogue: 0,0:08:57.70,0:08:59.20,Default,,0,0,0,,!يجب أن نبقى معًا
Dialogue: 0,0:09:07.84,0:09:08.92,Default,,0,0,0,,ما هذا الصوت؟
Dialogue: 0,0:09:09.84,0:09:10.55,Default,,0,0,0,,!انظروا
Dialogue: 0,0:09:15.26,0:09:16.26,Default,,0,0,0,,!تانوكي
Dialogue: 0,0:09:16.80,0:09:17.55,Default,,0,0,0,,حقيقيون؟
Dialogue: 0,0:09:17.72,0:09:20.10,Default,,0,0,0,,هذا فظيع!، من الذي قيدهم؟
Dialogue: 0,0:09:27.98,0:09:28.57,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:31.23,0:09:33.99,Default,,0,0,0,,.لقد تجنبتها؟، أهنئك، أيها الصبي
Dialogue: 0,0:09:34.15,0:09:36.66,Default,,0,0,0,,!كنا ننتظرك فقط، كوروغاني يايبا
Dialogue: 0,0:09:37.45,0:09:38.62,Default,,0,0,0,,!رجل العنكبوت
Dialogue: 0,0:09:38.99,0:09:40.54,Default,,0,0,0,,!أميري يايبا، الكرة
Dialogue: 0,0:09:41.33,0:09:43.87,Default,,0,0,0,,!تبا!، لقد وصلنا متأخرين
Dialogue: 0,0:09:44.33,0:09:46.83,Default,,0,0,0,,تبا!، من أنت، أيها الوغد؟
Dialogue: 0,0:09:48.79,0:09:51.17,Default,,0,0,0,,.أونيمارو، ملك الشياطين أحياني
Dialogue: 0,0:09:51.34,0:09:54.63,Default,,0,0,0,,.أنا الزعيم الخامس لعشيرة النينجا فوما
Dialogue: 0,0:09:55.55,0:09:57.34,Default,,0,0,0,,!اسمي هو فوما كوتارو
Dialogue: 0,0:09:59.05,0:10:00.10,Default,,0,0,0,,كوتارو؟
Dialogue: 0,0:10:01.10,0:10:02.77,Default,,0,0,0,,."يبدو مثل "مغفل كبير
Dialogue: 0,0:10:02.93,0:10:05.14,Default,,0,0,0,,!توقف، هذا الاسم يحرجني
Dialogue: 0,0:10:05.31,0:10:07.31,Default,,0,0,0,,.ينطبق عليك أيضًا، كوجيرو
Dialogue: 0,0:10:07.48,0:10:09.06,Default,,0,0,0,,..ثقتي ليست أقل صلابة
Dialogue: 0,0:10:09.31,0:10:12.90,Default,,0,0,0,,!يكفي!، اصمت وأعطني سيفك
Dialogue: 0,0:10:13.94,0:10:16.45,Default,,0,0,0,,!تعال وخذه، إذا كنت قادرًا
Dialogue: 0,0:10:17.66,0:10:18.78,Default,,0,0,0,,!تقنية فوما نينجا
Dialogue: 0,0:10:21.70,0:10:23.25,Default,,0,0,0,,!تقنية الإعصار
Dialogue: 0,0:10:25.25,0:10:26.16,Default,,0,0,0,,!يايبا
Dialogue: 0,0:10:26.96,0:10:27.75,Default,,0,0,0,,!ما كان ذلك؟
Dialogue: 0,0:10:29.71,0:10:31.38,Default,,0,0,0,,.تقنية الإعصار
Dialogue: 0,0:10:31.55,0:10:34.30,Default,,0,0,0,,اندفاع الهواء بسرعة إلى جسدي
Dialogue: 0,0:10:34.63,0:10:38.34,Default,,0,0,0,,.يخلق فراغًا يُحدث جروحًا حادة كالموس على جلد الخصم
Dialogue: 0,0:10:39.55,0:10:41.26,Default,,0,0,0,,.هذا يرهق الرئتين
Dialogue: 0,0:10:41.51,0:10:43.18,Default,,0,0,0,,!قدرة رئوية مذهلة
Dialogue: 0,0:10:43.35,0:10:45.52,Default,,0,0,0,,.تقنياته خطيرة
Dialogue: 0,0:10:45.68,0:10:49.48,Default,,0,0,0,,.لنهاجمه جميعًا حتى لا يتمكن من استخدامها
Dialogue: 0,0:10:49.65,0:10:50.19,Default,,0,0,0,,!نعم
Dialogue: 0,0:10:53.48,0:10:54.94,Default,,0,0,0,,!لا أحد سيؤذي اميري يايبا
Dialogue: 0,0:10:55.19,0:10:57.20,Default,,0,0,0,,!تمدد!، يا عامود الغسيل
Dialogue: 0,0:10:58.61,0:11:01.74,Default,,0,0,0,,تقتربون مني دون معرفة تقنياتي؟
Dialogue: 0,0:11:02.28,0:11:03.24,Default,,0,0,0,,.أغبياء
Dialogue: 0,0:11:05.12,0:11:07.66,Default,,0,0,0,,!تقنية تقنية فوما النينجا!، مسحوق التحجر
Dialogue: 0,0:11:09.67,0:11:10.63,Default,,0,0,0,,!شونوسوكي
Dialogue: 0,0:11:15.67,0:11:17.30,Default,,0,0,0,,هل أنتم بخير، يا رفاق؟
Dialogue: 0,0:11:18.51,0:11:20.47,Default,,0,0,0,,...انتبه إلى حيث تنظر!، أيها الأحمق
Dialogue: 0,0:11:20.64,0:11:22.85,Default,,0,0,0,,...كل شيء سقط علينا
Dialogue: 0,0:11:23.01,0:11:26.10,Default,,0,0,0,,!هذا سيء، لقد أصبتُ أيضًا
Dialogue: 0,0:11:27.52,0:11:29.44,Default,,0,0,0,,!يايبا، سأعتني بهم
Dialogue: 0,0:11:29.60,0:11:30.27,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:11:33.52,0:11:35.36,Default,,0,0,0,,!سوف تدفع ثمن هذا
Dialogue: 0,0:11:36.03,0:11:37.36,Default,,0,0,0,,!أيها النينجا الوغد
Dialogue: 0,0:11:48.12,0:11:50.21,Default,,0,0,0,,.أنا معجب، أيها الصبي
Dialogue: 0,0:11:50.50,0:11:52.75,Default,,0,0,0,,لكن ماذا عن هذا؟
Dialogue: 0,0:12:02.14,0:12:02.93,Default,,0,0,0,,أين هو؟
Dialogue: 0,0:12:03.43,0:12:07.72,Default,,0,0,0,,سحابة التخفي ناتجة عن هذه القنبلة
Dialogue: 0,0:12:07.89,0:12:11.31,Default,,0,0,0,,.التي تسمح بالاختباء في هذا الضباب دون ترك أثر
Dialogue: 0,0:12:11.48,0:12:14.77,Default,,0,0,0,,!أيها الوغد المتفلسف!، فلسفتك تصيبني بالغثيان
Dialogue: 0,0:12:15.15,0:12:16.48,Default,,0,0,0,,!اخرج من مخبئك
Dialogue: 0,0:12:18.78,0:12:19.57,Default,,0,0,0,,!أمسكت بك
Dialogue: 0,0:12:20.70,0:12:21.95,Default,,0,0,0,,!وجدتك
Dialogue: 0,0:12:23.95,0:12:24.91,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:12:25.20,0:12:28.20,Default,,0,0,0,,...صوت قد تسمعه، لكن الشخص غير موجود
Dialogue: 0,0:12:28.62,0:12:30.75,Default,,0,0,0,,،تقنية فوما نينجا!، سحابة التخفي
Dialogue: 0,0:12:30.91,0:12:33.83,Default,,0,0,0,,!تقنية الاستبدال
Dialogue: 0,0:12:34.38,0:12:35.34,Default,,0,0,0,,!خذ هذا
Dialogue: 0,0:12:40.05,0:12:42.09,Default,,0,0,0,,...كان ذلك وشيكاً
Dialogue: 0,0:12:42.51,0:12:45.01,Default,,0,0,0,,ظننت أنك تجنبتها، أيها الأحمق؟
Dialogue: 0,0:12:49.89,0:12:50.48,Default,,0,0,0,,!يايبا
Dialogue: 0,0:12:59.90,0:13:04.45,Default,,0,0,0,,!كوتارو! سأريك تقنية من صنعي أنا
Dialogue: 0,0:13:06.99,0:13:11.00,Default,,0,0,0,,!تقنية يايبا على طريقة روح الماء!، شفرة النافورة
Dialogue: 0,0:13:20.30,0:13:21.26,Default,,0,0,0,,!شونوسوكي
Dialogue: 0,0:13:25.14,0:13:27.14,Default,,0,0,0,,!وداعًا، كوتارو
Dialogue: 0,0:13:30.10,0:13:30.97,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:13:34.77,0:13:37.98,Default,,0,0,0,,.الملك أونيمارو يريد سيف الرعد الخاص بك
Dialogue: 0,0:13:38.15,0:13:39.90,Default,,0,0,0,,!سلمه لي الآن
Dialogue: 0,0:13:40.11,0:13:44.49,Default,,0,0,0,,!اصمت!، أعطيني الكرة بدلاً من ذلك، أيها الوغد
Dialogue: 0,0:13:46.49,0:13:50.41,Default,,0,0,0,,،يبدو أن لديك مشكلة في فهمي، أنا، فوما كوتارو
Dialogue: 0,0:13:50.83,0:13:54.33,Default,,0,0,0,,!سوف أهزمك وأستولي على سيفك
Dialogue: 0,0:13:56.21,0:13:59.50,Default,,0,0,0,,.شكرًا، كاجيتورا. لقد أنقذتنا
Dialogue: 0,0:14:06.22,0:14:07.43,Default,,0,0,0,,...يايبا
Dialogue: 0,0:14:10.39,0:14:12.52,Default,,0,0,0,,!تقنية فوما نينجا!، دائرة النار
Dialogue: 0,0:14:18.19,0:14:19.61,Default,,0,0,0,,!شونوسوكي، إلى الأعلى
Dialogue: 0,0:14:22.53,0:14:23.74,Default,,0,0,0,,!هذا عديم الفائدة
Dialogue: 0,0:14:24.11,0:14:26.91,Default,,0,0,0,,!لا يمكنك الهروب مني، في السماء
Dialogue: 0,0:14:30.74,0:14:32.37,Default,,0,0,0,,...سترى
Dialogue: 0,0:14:36.04,0:14:39.88,Default,,0,0,0,,!تقنية يايبا… نور الشمس الذي لا يرحم
Dialogue: 0,0:14:44.80,0:14:45.59,Default,,0,0,0,,!تبا
Dialogue: 0,0:14:46.55,0:14:50.72,Default,,0,0,0,,إذن، هذا هو حجاب السحاب الحقيقي، أليس كذلك؟
Dialogue: 0,0:14:54.06,0:14:55.48,Default,,0,0,0,,!لننهي هذا
Dialogue: 0,0:15:01.77,0:15:03.07,Default,,0,0,0,,!خذ هذا
Dialogue: 0,0:15:08.41,0:15:09.91,Default,,0,0,0,,هل يختبئ مرة أخرى؟
Dialogue: 0,0:15:11.70,0:15:12.74,Default,,0,0,0,,...هذا مؤلم
Dialogue: 0,0:15:13.04,0:15:15.12,Default,,0,0,0,,كيف عرف؟
Dialogue: 0,0:15:24.71,0:15:27.05,Default,,0,0,0,,.الاختباء هو أساس النينجا
Dialogue: 0,0:15:27.22,0:15:30.51,Default,,0,0,0,,!وكذلك إدراك وجود الخصم
Dialogue: 0,0:15:31.09,0:15:33.64,Default,,0,0,0,,!لقد كنت دائمًا أعرف مكانك
Dialogue: 0,0:15:37.93,0:15:40.56,Default,,0,0,0,,!تقنية فوما نينجا!، ضربة البرق الساحقة
Dialogue: 0,0:15:51.16,0:15:52.70,Default,,0,0,0,,...هذا مؤلم
Dialogue: 0,0:15:53.08,0:15:54.99,Default,,0,0,0,,يايبا، هل أنت بخير؟
Dialogue: 0,0:15:55.16,0:15:59.16,Default,,0,0,0,,...كوتارو يشعر تمامًا بوجود يايبا
Dialogue: 0,0:15:59.37,0:16:02.54,Default,,0,0,0,,.إنه متفوق لأنه نينجا حقيقي
Dialogue: 0,0:16:06.21,0:16:08.47,Default,,0,0,0,,تبا... ماذا علي أن أفعل؟
Dialogue: 0,0:16:08.67,0:16:10.34,Default,,0,0,0,,!بهذا المعدل، سيهزمني في النهاية
Dialogue: 0,0:16:13.14,0:16:13.93,Default,,0,0,0,,!خذوا هذا
Dialogue: 0,0:16:20.48,0:16:22.90,Default,,0,0,0,,ابتعدوا من هنا!، هل تريدون الموت؟
Dialogue: 0,0:16:25.94,0:16:26.61,Default,,0,0,0,,!يايبا
Dialogue: 0,0:16:31.45,0:16:32.66,Default,,0,0,0,,...تبا
Dialogue: 0,0:16:33.07,0:16:35.62,Default,,0,0,0,,...علينا التمييز بين الحقيقي والمزيف
Dialogue: 0,0:16:35.91,0:16:37.29,Default,,0,0,0,,كيف؟
Dialogue: 0,0:16:37.58,0:16:39.12,Default,,0,0,0,,!انتبه، اميري يايبا
Dialogue: 0,0:16:52.34,0:16:52.84,Default,,0,0,0,,!لا
Dialogue: 0,0:16:53.14,0:16:53.93,Default,,0,0,0,,!السيف
Dialogue: 0,0:16:54.51,0:16:55.93,Default,,0,0,0,,!واخيراً
Dialogue: 0,0:16:56.30,0:16:56.97,Default,,0,0,0,,!يايبا
Dialogue: 0,0:17:00.31,0:17:02.98,Default,,0,0,0,,!ماذا تفعلون!، قلت لكم أن تبتعدوا
Dialogue: 0,0:17:03.52,0:17:04.65,Default,,0,0,0,,!هذا خطير
Dialogue: 0,0:17:13.49,0:17:14.99,Default,,0,0,0,,!استنساخ يايبا
Dialogue: 0,0:17:16.24,0:17:17.20,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:17:21.11,0:17:22.04,Default,,0,0,0,,!لننطلق
Dialogue: 0,0:17:25.13,0:17:28.84,Default,,0,0,0,,هناك الكثير منهم!، أيهما سهاجم؟
Dialogue: 0,0:17:29.17,0:17:33.09,Default,,0,0,0,,!تقنية سيف الرعد!، ضربة البرق
Dialogue: 0,0:17:42.52,0:17:43.39,Default,,0,0,0,,!يايبا
Dialogue: 0,0:17:44.23,0:17:45.52,Default,,0,0,0,,!كان هذا مذهلاً
Dialogue: 0,0:17:45.73,0:17:47.27,Default,,0,0,0,,!معركة رائعة
Dialogue: 0,0:17:48.48,0:17:50.48,Default,,0,0,0,,.تدريبك يؤتي ثماره
Dialogue: 0,0:17:51.03,0:17:52.65,Default,,0,0,0,,.هذا تانوكي
Dialogue: 0,0:17:54.07,0:17:56.20,Default,,0,0,0,,...إنه نسخة طبق الأصل منك
Dialogue: 0,0:17:56.37,0:17:59.66,Default,,0,0,0,,!لقد أنقذتمونا!، أشكركم
Dialogue: 0,0:18:04.37,0:18:05.46,Default,,0,0,0,,هل ستعطيني إياها؟
Dialogue: 0,0:18:06.67,0:18:07.75,Default,,0,0,0,,!شكرًا
Dialogue: 0,0:18:10.71,0:18:12.51,Default,,0,0,0,,إذن هذه هي الكرة الأسطورية؟
Dialogue: 0,0:18:12.67,0:18:14.26,Default,,0,0,0,,هل يمكنني رؤيتها؟
Dialogue: 0,0:18:14.42,0:18:17.51,Default,,0,0,0,,!أريد رؤيتها أيضًا -\N!أنا أيضًا، أنا أيضًا -
Dialogue: 0,0:18:21.35,0:18:23.27,Default,,0,0,0,,!اغرب عن وجهي، أيها الأحمق
Dialogue: 0,0:18:24.69,0:18:28.02,Default,,0,0,0,,.تبا، لا مجال للتراخي
Dialogue: 0,0:18:28.19,0:18:29.23,Default,,0,0,0,,...حسناً
Dialogue: 0,0:18:29.40,0:18:32.61,Default,,0,0,0,,!ستأكد إذا كانت هذه فعلا كرة روح التنين
Dialogue: 0,0:18:32.78,0:18:33.90,Default,,0,0,0,,...انتظر، يايبا
Dialogue: 0,0:18:34.07,0:18:36.07,Default,,0,0,0,,.كن حذرًا قليلاً
Dialogue: 0,0:18:36.45,0:18:40.37,Default,,0,0,0,,ماذا سنفعل إذا ظهر تنين ضخم وهاجمنا؟
Dialogue: 0,0:18:40.53,0:18:44.75,Default,,0,0,0,,! لا بأس!، إذا حدث ذلك، سنقطعه إلى شرائح
Dialogue: 0,0:18:45.04,0:18:47.54,Default,,0,0,0,,أيها الأحمق!، ألم تفهم بعد؟
Dialogue: 0,0:18:47.83,0:18:51.46,Default,,0,0,0,,!قد تتحول إلى تنين
Dialogue: 0,0:18:53.71,0:18:55.51,Default,,0,0,0,,،حتى لو حدث ذلك
Dialogue: 0,0:18:57.43,0:19:00.55,Default,,0,0,0,,عليكم فقط هزيمتي، هذا كل شيء. أليس كذلك؟
Dialogue: 0,0:19:01.60,0:19:03.02,Default,,0,0,0,,ماذا قلت؟
Dialogue: 0,0:19:03.77,0:19:07.27,Default,,0,0,0,,!لنبدأ!، تنينًا أم لا، اخرج من هناك
Dialogue: 0,0:19:21.99,0:19:22.87,Default,,0,0,0,,...اميري يايبا
Dialogue: 0,0:19:23.66,0:19:25.41,Default,,0,0,0,,هل سيكون بخير؟
Dialogue: 0,0:19:34.80,0:19:38.13,Default,,0,0,0,,...ممتاز، كما قلت، يايبا
Dialogue: 0,0:19:39.01,0:19:41.18,Default,,0,0,0,,!بسيفي سوف اهزمك
Dialogue: 0,0:19:41.85,0:19:45.14,Default,,0,0,0,,!مهلا!، توقف!، أريد استعادة هيئتي
Dialogue: 0,0:19:47.77,0:19:49.19,Default,,0,0,0,,...كدت أموت
Dialogue: 0,0:19:49.35,0:19:51.02,Default,,0,0,0,,...لقد عدت
Dialogue: 0,0:19:53.48,0:19:54.52,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:19:54.69,0:19:58.74,Default,,0,0,0,,هذه الكرة تسمح لي بالتحول إلى أي شيء اريده؟
Dialogue: 0,0:20:00.45,0:20:03.16,Default,,0,0,0,,لماذا مكتوب عليها كلمة "ذهب"؟
Dialogue: 0,0:20:05.04,0:20:08.46,Default,,0,0,0,,.فهمت، إنها تشير إلى كينشو تانوكي
Dialogue: 0,0:20:08.62,0:20:10.71,Default,,0,0,0,,...إنها كرة التانوكي الذهبية
Dialogue: 0,0:20:11.46,0:20:14.00,Default,,0,0,0,,!توقف!، أعرف ما ستقوله
Dialogue: 0,0:20:14.67,0:20:17.71,Default,,0,0,0,,...نعم، إنها إحدى كرات التانوكي
Dialogue: 0,0:20:26.77,0:20:27.77,Default,,0,0,0,,،من هنا
Dialogue: 0,0:20:27.93,0:20:31.73,Default,,0,0,0,,.أقترح أن نتجه إلى جبل آسو القريب في كيوشو
Dialogue: 0,0:20:31.98,0:20:34.86,Default,,0,0,0,,سنحتاج إلى يايبا
Dialogue: 0,0:20:35.02,0:20:37.57,Default,,0,0,0,,.لشق البحر مرة أخرى
Dialogue: 0,0:20:37.78,0:20:39.53,Default,,0,0,0,,...هذا متعب جدًا
Dialogue: 0,0:20:53.67,0:20:55.71,Default,,0,0,0,,ماذا؟، هذا يحدث مرة أخرى؟
Dialogue: 0,0:20:56.96,0:20:59.76,Default,,0,0,0,,!صحيح!، لدي فكرة رائعة
Dialogue: 0,0:20:59.92,0:21:01.22,Default,,0,0,0,,أليس كذلك يا يايبا؟
Dialogue: 0,0:21:04.64,0:21:06.43,Default,,0,0,0,,هل يجب أن أفعل هذا حقًا؟
Dialogue: 0,0:21:06.72,0:21:09.31,Default,,0,0,0,,!لا تقلق، سيكون الأمر جيدًا
Dialogue: 0,0:21:09.56,0:21:11.52,Default,,0,0,0,,ما الذي تخطط لفعله؟
Dialogue: 0,0:21:12.19,0:21:13.90,Default,,0,0,0,,...حسناً
Dialogue: 0,0:21:15.65,0:21:17.27,Default,,0,0,0,,!حولني إلى قارب
Dialogue: 0,0:21:19.90,0:21:21.65,Default,,0,0,0,,!إنها سفينة حربية
Dialogue: 0,0:21:23.36,0:21:24.99,Default,,0,0,0,,!إنها ناقلة نفط
Dialogue: 0,0:21:25.16,0:21:27.20,Default,,0,0,0,,هل يمكنك صنع شيء أصغر؟
Dialogue: 0,0:21:28.79,0:21:30.20,Default,,0,0,0,,هل هذا يناسبكم؟
Dialogue: 0,0:21:30.62,0:21:33.58,Default,,0,0,0,,طوافة؟، أليست تلك مبالغة؟
Dialogue: 0,0:21:33.75,0:21:35.42,Default,,0,0,0,,!طوافة رائعة
Dialogue: 0,0:21:35.58,0:21:37.13,Default,,0,0,0,,!أحسنت، يايبا
Dialogue: 0,0:21:38.67,0:21:41.26,Default,,0,0,0,,...كم أنتم مستغلون
Dialogue: 0,0:21:44.63,0:21:48.31,Default,,0,0,0,,!ناديشيكو، إذا كنتِ خائفة، تمسكي بي
Dialogue: 0,0:21:48.47,0:21:52.14,Default,,0,0,0,,!سامحني لركوبي عليك، اميري يايبا
Dialogue: 0,0:21:52.31,0:21:56.19,Default,,0,0,0,,!توقفوا عن الحركة!، وإلا ستغرقون
Dialogue: 0,0:21:56.56,0:21:59.90,Default,,0,0,0,,!هيا!، لنذهب إلى كيوشو
Dialogue: 0,0:22:00.40,0:22:03.32,Default,,0,0,0,,!أحمق، لقد قلت توقفوا عن الحركة
Dialogue: 0,0:23:37.08,0:23:40.50,Default,,0,0,0,,الجو حار جدًا!، هل الجو دائمًا حار هكذا في جبل آسو؟
Dialogue: 0,0:23:40.67,0:23:43.50,Default,,0,0,0,,هل توجد كرة روح التنين حقًا هنا؟
Dialogue: 0,0:23:44.17,0:23:47.34,Default,,0,0,0,,!"في الحلقة القادمة: "مواجهة بين يايبا والساحر
Dialogue: 0,0:23:47.67,0:23:50.97,Default,,0,0,0,,{\a6}الحلقة 15: مواجهة بين يايبا والساحر
Dialogue: 0,0:23:48.55,0:23:50.97,Default,,0,0,0,,!هذا يجعلني أشعر بالحنين
