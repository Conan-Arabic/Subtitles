Dialogue: 0,0:00:02.33,0:00:03.46,Default,,0,0,0,,!عزيزي
Dialogue: 0,0:00:03.54,0:00:04.87,Default,,0,0,0,,!أمي العزيزة
Dialogue: 0,0:00:04.96,0:00:06.75,Default,,0,0,0,,أسرعو!
Dialogue: 0,0:00:07.79,0:00:10.63,Default,,0,0,0,,"."سأغادر في رحلة لبعض الوقت
Dialogue: 0,0:00:11.26,0:00:13.51,Default,,0,0,0,,...ساياكا -\N...ساياكا -
Dialogue: 0,0:00:13.59,0:00:15.76,Default,,0,0,0,,...عادوا إلى البكاء
Dialogue: 0,0:00:16.89,0:00:20.22,Default,,0,0,0,,!إلى جوهرة روح التنين، هيا، هيا، هيا
Dialogue: 0,0:00:21.10,0:00:22.52,Default,,0,0,0,,!يا للروعة
Dialogue: 0,0:00:22.60,0:00:25.27,Default,,0,0,0,,!هذا أسرع حتى من تلك السيارات
Dialogue: 0,0:00:25.35,0:00:26.98,Default,,0,0,0,,.هذا القطار السريع
Dialogue: 0,0:00:27.06,0:00:28.23,Default,,0,0,0,,.لا تتحمس كثيرًا
Dialogue: 0,0:00:28.77,0:00:31.32,Default,,0,0,0,,.نحن لسنا هنا للسياحة
Dialogue: 0,0:00:32.44,0:00:38.20,Default,,0,0,0,,،نحن ذاهبون للحصول على جوهرة روح التنين لتتمكن من الطيران
Dialogue: 0,0:00:38.28,0:00:41.62,Default,,0,0,0,,واستعادة جوهرة حاكم الرعد من تلك القلعة في السماء،
Dialogue: 0,0:00:41.70,0:00:44.25,Default,,0,0,0,,.وتدمير أونيمارو
Dialogue: 0,0:00:44.91,0:00:46.12,Default,,0,0,0,,...نعم، نعم
Dialogue: 0,0:00:46.21,0:00:49.50,Default,,0,0,0,,إذن، هل تعرف أين يمكن العثور على الجوهرة؟
Dialogue: 0,0:00:49.59,0:00:54.72,Default,,0,0,0,,.حسنًا، وفقًا للآنسة ناديشيكو، إنها في مكان ما حول بحيرة بيوا
Dialogue: 0,0:00:55.63,0:00:58.43,Default,,0,0,0,,،حسنًا، إذا بحثنا في المنطقة بدقة
Dialogue: 0,0:00:58.51,0:00:59.85,Default,,0,0,0,,.فسنعثر عليها
Dialogue: 0,0:00:59.93,0:01:02.68,Default,,0,0,0,,لكن بحيرة بيوا هذه ضخمة.
Dialogue: 0,0:01:16.91,0:01:18.95,Default,,0,0,0,,.الاستعدادات اكتملت
Dialogue: 0,0:01:19.45,0:01:20.37,Default,,0,0,0,,...إذن
Dialogue: 0,0:01:21.24,0:01:22.16,Default,,0,0,0,,!انطلق
Dialogue: 0,0:01:36.76,0:01:38.18,Default,,0,0,0,,حسنًا، ما رأيك؟
Dialogue: 0,0:01:38.26,0:01:41.72,Default,,0,0,0,,هل يروي مدفع أونيمارو عطشك للقوة؟
Dialogue: 0,0:01:42.51,0:01:44.22,Default,,0,0,0,,.حسنًا، مقبول
Dialogue: 0,0:01:44.89,0:01:48.60,Default,,0,0,0,,.لديه قوة نارية، لكنه يحتاج إلى أن يكون أسرع
Dialogue: 0,0:01:49.10,0:01:52.23,Default,,0,0,0,,.أنت دائمًا غير صبور
Dialogue: 0,0:01:52.82,0:01:56.90,Default,,0,0,0,,ما كل هذا التأخير في سيف الرياح؟، كم يجب أن أنتظر حتى يتم إصلاحه؟
Dialogue: 0,0:01:56.99,0:01:58.91,Default,,0,0,0,,!لا تستعجل
Dialogue: 0,0:01:58.99,0:02:02.12,Default,,0,0,0,,.لقد رأيت بعينيك. لدينا الآن مدفع أونيمارو
Dialogue: 0,0:02:02.20,0:02:03.58,Default,,0,0,0,,!أحمق
Dialogue: 0,0:02:03.66,0:02:06.16,Default,,0,0,0,,!سيف الرياح هو ما يمنحني قوتي
Dialogue: 0,0:02:06.70,0:02:10.13,Default,,0,0,0,,!أحتاج إلى ذلك السيف للسيطرة على اليابان
Dialogue: 0,0:02:10.96,0:02:15.34,Default,,0,0,0,,.ليس لدي خيار. يجب أن أستولي على سيفه
Dialogue: 0,0:02:18.00,0:02:20.80,Default,,0,0,0,,!سيف الرعد لكوروغاني يايبا
Dialogue: 0,0:02:20.89,0:02:25.93,Default,,0,0,0,,.لكن لا تنسى، أن ذلك الطفل قاومك بشدة
Dialogue: 0,0:02:26.02,0:02:28.14,Default,,0,0,0,,.قد يكون الاستيلاء عليه صعبًا
Dialogue: 0,0:02:28.23,0:02:29.35,Default,,0,0,0,,!اخرس
Dialogue: 0,0:02:29.44,0:02:32.02,Default,,0,0,0,,،طالما لدي جوهرة حاكم الرعد
Dialogue: 0,0:02:32.11,0:02:34.98,Default,,0,0,0,,!فسيفه ليس أكثر من لعبة معدنية
Dialogue: 0,0:02:35.07,0:02:37.44,Default,,0,0,0,,...بالحديث عن الجواهر
Dialogue: 0,0:02:37.53,0:02:38.36,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:02:38.44,0:02:40.95,Default,,0,0,0,,حسنًا، يبدو أن هناك ما يسمى بجوهرة روح التنين
Dialogue: 0,0:02:41.03,0:02:43.78,Default,,0,0,0,,.التي تمكن حاملها من التحليق في السماء
Dialogue: 0,0:02:44.33,0:02:47.50,Default,,0,0,0,,.ويبدو أنهم يبحثون عنها
Dialogue: 0,0:02:48.83,0:02:50.62,Default,,0,0,0,,جوهرة روح التنين، إذن؟
Dialogue: 0,0:02:52.42,0:02:53.46,Default,,0,0,0,,!كم هذا مثير
Dialogue: 0,0:02:54.17,0:02:59.55,Default,,0,0,0,,!إذن أعتقد أن سيف الرعد وتلك الجوهرة الرائعة سيكونان ملكي
Dialogue: 0,0:03:12.15,0:03:15.73,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:04:30.97,0:04:35.90,Default,,0,0,0,,الحلقة 13: البحث عن جوهرة روح التنين
Dialogue: 0,0:04:42.86,0:04:45.91,Default,,0,0,0,,،أيها المحاربون الموقرون الذين يتجولون في الظلمات الملعونة
Dialogue: 0,0:04:46.61,0:04:48.57,Default,,0,0,0,,!استيقظو من ظلامكم اللعين
Dialogue: 0,0:04:49.33,0:04:53.54,Default,,0,0,0,,.والتحالف معي بقواكم المدمرة
Dialogue: 0,0:04:53.62,0:04:57.00,Default,,0,0,0,,! هيا، اظهروا أمامي
Dialogue: 0,0:05:09.51,0:05:11.93,Default,,0,0,0,,،أيتها الكائنات المشؤومة
Dialogue: 0,0:05:12.02,0:05:14.56,Default,,0,0,0,,!تعالوا أمامي وقدموا أنفسكم
Dialogue: 0,0:05:31.83,0:05:36.33,Default,,0,0,0,,.اسمي مياوشي سيكاي نيودو
Dialogue: 0,0:05:36.83,0:05:39.33,Default,,0,0,0,,.كم هو جميل أن أراك حيًا
Dialogue: 0,0:05:39.42,0:05:41.50,Default,,0,0,0,,!الآن، استعد لتنفيذ كل أوامري
Dialogue: 0,0:05:47.76,0:05:49.01,Default,,0,0,0,, !أرفض
Dialogue: 0,0:05:49.09,0:05:52.76,Default,,0,0,0,,!ليس لدي أي تعلق بهذا العالم
Dialogue: 0,0:05:54.35,0:05:58.19,Default,,0,0,0,,.أطع، وستحصل على الحياة الأبدية
Dialogue: 0,0:05:58.73,0:06:02.27,Default,,0,0,0,,.قل لا، وستعود جثة مقززة
Dialogue: 0,0:06:06.19,0:06:08.78,Default,,0,0,0,,!أنت لا تخاف أحد ولا بوذا
Dialogue: 0,0:06:08.86,0:06:10.28,Default,,0,0,0,,هذا يعجبني
Dialogue: 0,0:06:10.36,0:06:12.53,Default,,0,0,0,,.سأقدم لك المساعدة
Dialogue: 0,0:06:14.95,0:06:17.21,Default,,0,0,0,,.لكن في هذا العالم، ليس لدينا حاكماً أو بوذا
Dialogue: 0,0:06:17.75,0:06:19.37,Default,,0,0,0,,...إذا كان هناك حاكم
Dialogue: 0,0:06:20.46,0:06:22.67,Default,,0,0,0,,!فسيكون أنا، أونيمارو
Dialogue: 0,0:06:25.88,0:06:28.09,Default,,0,0,0,,.هذا ما قالته ناديشيكو
Dialogue: 0,0:06:28.17,0:06:32.43,Default,,0,0,0,,.في مكان ما حول هذه البحيرة، يجب أن نجد جوهرة روح التنين
Dialogue: 0,0:06:33.18,0:06:35.10,Default,,0,0,0,,...لكن "مكان ما" ليس بالضبط
Dialogue: 0,0:06:36.39,0:06:38.43,Default,,0,0,0,,!انظر إلى هذا المكان فقط
Dialogue: 0,0:06:38.94,0:06:40.52,Default,,0,0,0,,،حسنًا، أبي دائمًا يقول
Dialogue: 0,0:06:40.60,0:06:43.19,Default,,0,0,0,,.إذا كنت لا تعرف أين تبحث، اسأل بومة
Dialogue: 0,0:06:43.69,0:06:44.90,Default,,0,0,0,,بومة؟
Dialogue: 0,0:06:48.40,0:06:51.24,Default,,0,0,0,,هل يمكن للبومة حقًا مساعدتك في العثور على شيء؟
Dialogue: 0,0:06:54.70,0:06:56.41,Default,,0,0,0,,!هذا عصفور
Dialogue: 0,0:06:59.00,0:07:00.79,Default,,0,0,0,,!توقف عن العبث
Dialogue: 0,0:07:00.87,0:07:02.13,Default,,0,0,0,,.لم يكن ذلك أنا
Dialogue: 0,0:07:03.38,0:07:05.71,Default,,0,0,0,,.ساياكا، انظري خلفك
Dialogue: 0,0:07:08.05,0:07:10.34,Default,,0,0,0,,.هذه البومة يبدو أنها تعرف طريقها جيدًا
Dialogue: 0,0:07:10.43,0:07:12.47,Default,,0,0,0,,.لقد جاءت بومة حقًا
Dialogue: 0,0:07:13.01,0:07:16.35,Default,,0,0,0,,.إنه لطيف جدًا أيضًا
Dialogue: 0,0:07:19.56,0:07:22.73,Default,,0,0,0,,.ستجيب إذا أعطيناها طعامًا
Dialogue: 0,0:07:23.56,0:07:25.06,Default,,0,0,0,,...هذا أقل لطفًا
Dialogue: 0,0:07:31.11,0:07:32.45,Default,,0,0,0,,ماذا قال الآن؟
Dialogue: 0,0:07:33.11,0:07:34.78,Default,,0,0,0,,،منذ زمن بعيد
Dialogue: 0,0:07:34.87,0:07:37.95,Default,,0,0,0,,.غرق جزيرة روح الماء في البحيرة
Dialogue: 0,0:07:40.37,0:07:42.12,Default,,0,0,0,,،يقول إنه في مكان ما في البحيرة
Dialogue: 0,0:07:42.21,0:07:45.08,Default,,0,0,0,,.سنجد نصبًا حجريًا لروح الماء
Dialogue: 0,0:07:45.17,0:07:47.67,Default,,0,0,0,,.هناك حيث توجد الجوهرة
Dialogue: 0,0:07:47.75,0:07:49.88,Default,,0,0,0,,نصب حجري لروح الماء؟
Dialogue: 0,0:07:52.80,0:07:56.14,Default,,0,0,0,,...يبدو أنه يمكن تمييزها بسهولة، ستبدو كوجه
Dialogue: 0,0:07:58.43,0:08:02.48,Default,,0,0,0,,!هل تقول الحقيقة؟، إذا اكتشفت أنك كذبت، سآكلك
Dialogue: 0,0:08:04.77,0:08:07.82,Default,,0,0,0,,،روح الماء هو روح مائي
Dialogue: 0,0:08:07.90,0:08:10.99,Default,,0,0,0,,.لكنه غالبًا ما يكون على شكل تنين
Dialogue: 0,0:08:11.53,0:08:14.24,Default,,0,0,0,,.قد تكون جوهرة روح التنين التي نبحث عنها
Dialogue: 0,0:08:14.78,0:08:15.95,Default,,0,0,0,,!حسناً
Dialogue: 0,0:08:16.45,0:08:18.41,Default,,0,0,0,,!إذن أعتقد أنني سأسبح قليلاً
Dialogue: 0,0:08:28.54,0:08:30.05,Default,,0,0,0,,...حسناً
Dialogue: 0,0:08:33.34,0:08:34.88,Default,,0,0,0,,!إنه بارد
Dialogue: 0,0:08:34.97,0:08:36.55,Default,,0,0,0,,!في الماء، ولنذهب
Dialogue: 0,0:08:39.18,0:08:40.68,Default,,0,0,0,,.أنت جبان
Dialogue: 0,0:08:40.77,0:08:45.52,Default,,0,0,0,,.الساموراي الحقيقي لا يرتجف أمام الماء أو النار
Dialogue: 0,0:08:45.60,0:08:47.94,Default,,0,0,0,,!ما زال أمامك طريق طويل
Dialogue: 0,0:08:49.61,0:08:51.94,Default,,0,0,0,,!أنا ذاهب، أنا ذاهب
Dialogue: 0,0:09:17.05,0:09:18.76,Default,,0,0,0,,.لم أستطع العثور عليها
Dialogue: 0,0:09:19.26,0:09:22.22,Default,,0,0,0,,.على الأقل، قلصنا الاحتمالات
Dialogue: 0,0:09:22.31,0:09:26.02,Default,,0,0,0,,.التالي، سنبحث أكثر نحو وسط البحيرة
Dialogue: 0,0:09:27.14,0:09:28.48,Default,,0,0,0,,...أنا أتجمد
Dialogue: 0,0:09:29.06,0:09:32.48,Default,,0,0,0,,لماذا غيروزايمون ليس معنا؟
Dialogue: 0,0:09:34.03,0:09:35.78,Default,,0,0,0,,.هذا رائع
Dialogue: 0,0:09:35.86,0:09:36.95,Default,,0,0,0,,.نعم
Dialogue: 0,0:09:37.03,0:09:40.12,Default,,0,0,0,,لماذا قررتما البقاء هنا؟
Dialogue: 0,0:09:40.62,0:09:44.95,Default,,0,0,0,,.حسنًا، ساياكا طلبت منا البقاء لمساعدتكِ
Dialogue: 0,0:09:45.04,0:09:46.62,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:09:47.50,0:09:49.58,Default,,0,0,0,,.المزيد من المتطفلين
Dialogue: 0,0:09:53.63,0:09:55.76,Default,,0,0,0,,.كدنا نصل
Dialogue: 0,0:09:58.59,0:10:00.22,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:10:00.30,0:10:03.22,Default,,0,0,0,,!جهاز استشعار السيوف الروحية
Dialogue: 0,0:10:03.31,0:10:07.14,Default,,0,0,0,,.تخبرني بالموقع الدقيق لكوروغاني يايبا
Dialogue: 0,0:10:07.23,0:10:10.06,Default,,0,0,0,,. ويبدو أننا نقترب
Dialogue: 0,0:10:13.02,0:10:14.69,Default,,0,0,0,,!طفل صغير أو اثنين لن يكونا شيئًا
Dialogue: 0,0:10:14.78,0:10:17.74,Default,,0,0,0,,!سأحطمهم مثل الصراصير
Dialogue: 0,0:10:18.70,0:10:21.45,Default,,0,0,0,,!من فضلك حاول ألا تهز الطائرة
Dialogue: 0,0:10:28.08,0:10:30.25,Default,,0,0,0,,!اجتهد أكثر، يايبا
Dialogue: 0,0:10:30.33,0:10:32.00,Default,,0,0,0,,.اخرس
Dialogue: 0,0:10:33.54,0:10:36.13,Default,,0,0,0,,.حسنًا، هذا يكفي
Dialogue: 0,0:10:37.01,0:10:39.55,Default,,0,0,0,,.هذه المرة، سيكون هذا محور بحثك
Dialogue: 0,0:10:41.01,0:10:43.51,Default,,0,0,0,,ألا يمكن لكوجيرو المساعدة مرة واحدة؟
Dialogue: 0,0:10:44.31,0:10:45.85,Default,,0,0,0,,ولماذا يجب أن أفعل ذلك؟
Dialogue: 0,0:10:45.93,0:10:47.43,Default,,0,0,0,,...حسنًا
Dialogue: 0,0:10:47.52,0:10:51.27,Default,,0,0,0,,!حسنًا، سنقرر بالحجر ورقة مقص، ولا مزيد من الشكوى
Dialogue: 0,0:10:51.90,0:10:53.65,Default,,0,0,0,,!فكرة جيدة
Dialogue: 0,0:10:54.61,0:10:55.44,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:11:00.24,0:11:02.45,Default,,0,0,0,,!امتد! يا عامود الغسيل
Dialogue: 0,0:11:03.99,0:11:04.83,Default,,0,0,0,,!تمسكوا
Dialogue: 0,0:11:07.66,0:11:09.21,Default,,0,0,0,,!يايبا
Dialogue: 0,0:11:15.04,0:11:16.71,Default,,0,0,0,,ما الذي حدث للتو؟
Dialogue: 0,0:11:18.96,0:11:21.01,Default,,0,0,0,,هل هذه هي؟
Dialogue: 0,0:11:21.09,0:11:23.14,Default,,0,0,0,,!الصخرة التي تشبه الوجه
Dialogue: 0,0:11:23.22,0:11:24.80,Default,,0,0,0,,أخيرًا وجدتها
Dialogue: 0,0:11:35.48,0:11:37.53,Default,,0,0,0,,هل سيعيقني؟
Dialogue: 0,0:11:37.61,0:11:38.90,Default,,0,0,0,,!أيها الوغد
Dialogue: 0,0:11:38.98,0:11:41.36,Default,,0,0,0,,!ليس بعد أن وجدت الجوهرة للتو
Dialogue: 0,0:11:48.20,0:11:49.37,Default,,0,0,0,,يايبا؟
Dialogue: 0,0:11:53.00,0:11:57.34,Default,,0,0,0,,!سلمني سيف الرعد، كوروغاني يايبا
Dialogue: 0,0:11:58.71,0:12:01.55,Default,,0,0,0,,ومن أنت، أيها الوغد؟
Dialogue: 0,0:12:02.34,0:12:06.51,Default,,0,0,0,,.أنا قادم من أرض الموتى، بطل من الماضي
Dialogue: 0,0:12:06.60,0:12:09.18,Default,,0,0,0,,.مياوشي سيكاي نيودو
Dialogue: 0,0:12:09.27,0:12:11.14,Default,,0,0,0,,هل قال نيودو؟
Dialogue: 0,0:12:12.94,0:12:16.94,Default,,0,0,0,,!ما زلت تعيش حياة مليئة بالعار، يا مساكين، يا موساشي العجوز
Dialogue: 0,0:12:17.57,0:12:19.32,Default,,0,0,0,,لكن كيف حالك؟
Dialogue: 0,0:12:19.40,0:12:23.61,Default,,0,0,0,,،كلمات أونيمارو عن السيطرة على العالم جعلتني أفكر
Dialogue: 0,0:12:23.70,0:12:26.62,Default,,0,0,0,,.سأستمتع قليلاً
Dialogue: 0,0:12:27.83,0:12:29.49,Default,,0,0,0,,!شونوسوكي
Dialogue: 0,0:12:36.58,0:12:39.13,Default,,0,0,0,,!لم تدعوا لهذه المعركة
Dialogue: 0,0:12:39.21,0:12:40.80,Default,,0,0,0,,!رجل العنكبوت
Dialogue: 0,0:12:40.88,0:12:42.05,Default,,0,0,0,,!سأعاقبك
Dialogue: 0,0:12:42.13,0:12:44.47,Default,,0,0,0,,!بيدي، ستعرف الألم الحقيقي
Dialogue: 0,0:12:44.55,0:12:46.76,Default,,0,0,0,,...يمكنك الكلام، أيها الزومبي
Dialogue: 0,0:12:47.47,0:12:50.35,Default,,0,0,0,,.سلم السيف بسرعة
Dialogue: 0,0:12:50.43,0:12:53.10,Default,,0,0,0,,!أو سأفصل رأسك عن جسدك
Dialogue: 0,0:12:54.85,0:12:57.27,Default,,0,0,0,,!في احلامك، أيها الوغد
Dialogue: 0,0:12:57.35,0:12:59.52,Default,,0,0,0,,!أيها الزومبي الأصلع المجنون
Dialogue: 0,0:13:01.53,0:13:03.36,Default,,0,0,0,,!أيها الوغد الصغير
Dialogue: 0,0:13:03.44,0:13:06.49,Default,,0,0,0,,هل تفتقد حليب أمك، أليس كذلك؟
Dialogue: 0,0:13:10.70,0:13:11.99,Default,,0,0,0,,!أيها الوغد
Dialogue: 0,0:13:23.46,0:13:25.59,Default,,0,0,0,,!يا رجل العنكبوت اللعين
Dialogue: 0,0:13:26.09,0:13:29.14,Default,,0,0,0,,!كوجيرو! سننقسم لمساعدة يايبا
Dialogue: 0,0:13:29.22,0:13:31.18,Default,,0,0,0,,ننقسم؟
Dialogue: 0,0:13:31.26,0:13:33.52,Default,,0,0,0,,.لدينا مركبة أخرى
Dialogue: 0,0:13:38.40,0:13:40.11,Default,,0,0,0,,!لنذهب
Dialogue: 0,0:13:51.87,0:13:52.87,Default,,0,0,0,,!تبا
Dialogue: 0,0:14:06.22,0:14:07.88,Default,,0,0,0,,!الضربة القاضية
Dialogue: 0,0:14:15.06,0:14:16.52,Default,,0,0,0,,!انتظر -\N !عد -
Dialogue: 0,0:14:24.61,0:14:26.19,Default,,0,0,0,,!هذا رائع
Dialogue: 0,0:14:34.87,0:14:37.33,Default,,0,0,0,,!انتهى الأمر، أيها الفتى
Dialogue: 0,0:14:47.76,0:14:49.43,Default,,0,0,0,,أرأيت ذلك، يا أصلع؟
Dialogue: 0,0:14:52.68,0:14:55.35,Default,,0,0,0,,.أنت تبلي حسنًا، أيها الساموراي الصغير
Dialogue: 0,0:14:55.43,0:14:57.56,Default,,0,0,0,,.لكن هذا لا يكفي
Dialogue: 0,0:14:57.64,0:14:59.14,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:14:59.69,0:15:02.40,Default,,0,0,0,,...سأريك
Dialogue: 0,0:15:13.53,0:15:16.12,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:15:23.75,0:15:27.09,Default,,0,0,0,,.سأريك قوتي الحقيقية
Dialogue: 0,0:15:29.92,0:15:30.76,Default,,0,0,0,,...تلك الصخرة هي
Dialogue: 0,0:15:32.18,0:15:35.35,Default,,0,0,0,,!سأحولك إلى اشلاء
Dialogue: 0,0:15:37.97,0:15:39.22,Default,,0,0,0,,!ها هي
Dialogue: 0,0:15:42.73,0:15:43.81,Default,,0,0,0,,!الجوهرة
Dialogue: 0,0:15:47.86,0:15:50.28,Default,,0,0,0,,.رائع، لقد نجح الأمر
Dialogue: 0,0:15:51.32,0:15:54.78,Default,,0,0,0,,!بجوهرة روح التنين، يمكنني الطيران أيضًا
Dialogue: 0,0:15:54.87,0:15:57.99,Default,,0,0,0,,!سأرميك بعيدًا، أيها الأصلع نيودو
Dialogue: 0,0:15:58.08,0:15:59.75,Default,,0,0,0,,!انتظر، يايبا
Dialogue: 0,0:15:59.83,0:16:02.37,Default,,0,0,0,,!الأمر يشبه جوهرة الرعد
Dialogue: 0,0:16:02.46,0:16:06.38,Default,,0,0,0,,!لا يجب أن تستخدم جوهرة بتهور
Dialogue: 0,0:16:06.46,0:16:07.88,Default,,0,0,0,,!لا أهتم
Dialogue: 0,0:16:07.96,0:16:11.51,Default,,0,0,0,,!لن نعرف ما سيحدث حتى أجرب
Dialogue: 0,0:16:11.59,0:16:14.22,Default,,0,0,0,,!استعد لنهايتك
Dialogue: 0,0:16:14.84,0:16:15.93,Default,,0,0,0,,...يايبا
Dialogue: 0,0:16:17.47,0:16:19.64,Default,,0,0,0,,!ها أنا قادم، أيها الأحمق
Dialogue: 0,0:16:32.74,0:16:34.07,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:16:34.15,0:16:37.74,Default,,0,0,0,,مهلا، موساشي! هل هذه حقًا جوهرة روح التنين؟
Dialogue: 0,0:16:37.83,0:16:40.20,Default,,0,0,0,,.يبدو أننا أخطأنا
Dialogue: 0,0:16:41.54,0:16:43.08,Default,,0,0,0,,!هذا سيء حقًا
Dialogue: 0,0:16:43.16,0:16:45.08,Default,,0,0,0,,!توقف عن السخرية، أنت
Dialogue: 0,0:16:45.17,0:16:46.00,Default,,0,0,0,,!موساشي
Dialogue: 0,0:16:49.09,0:16:54.34,Default,,0,0,0,,!توقف! أنت تدمر آليتي البرمائية
Dialogue: 0,0:17:00.76,0:17:02.06,Default,,0,0,0,,!ستدفعون للإصلاحات
Dialogue: 0,0:17:02.14,0:17:04.18,Default,,0,0,0,,!حسنًا، لم يبقَ سوى نيودو
Dialogue: 0,0:17:04.27,0:17:05.10,Default,,0,0,0,,!هيا
Dialogue: 0,0:17:07.69,0:17:09.11,Default,,0,0,0,,،خذ هذا، وهذا
Dialogue: 0,0:17:09.19,0:17:14.07,Default,,0,0,0,,!توقف عن اللعب بالماء، أيها الصبي
Dialogue: 0,0:17:14.78,0:17:15.86,Default,,0,0,0,,مارايك في هذا؟
Dialogue: 0,0:17:15.95,0:17:18.32,Default,,0,0,0,,!هكذا يفعل الأخطبوط
Dialogue: 0,0:17:18.41,0:17:20.91,Default,,0,0,0,,!أعطني ذلك السيف اللعين
Dialogue: 0,0:17:23.95,0:17:26.08,Default,,0,0,0,,!نيودو
Dialogue: 0,0:17:26.17,0:17:28.50,Default,,0,0,0,,!هذه لكم
Dialogue: 0,0:17:46.73,0:17:49.40,Default,,0,0,0,,!الآن، أعطني ذلك الشيء
Dialogue: 0,0:17:51.69,0:17:53.23,Default,,0,0,0,,!أيها الوغد
Dialogue: 0,0:18:04.12,0:18:05.58,Default,,0,0,0,,!لقد أخطأت
Dialogue: 0,0:18:09.96,0:18:15.01,Default,,0,0,0,,.لو تعاونت فقط، كنت سأدعك تعيش
Dialogue: 0,0:18:15.09,0:18:17.38,Default,,0,0,0,,!يايبا
Dialogue: 0,0:18:24.18,0:18:25.81,Default,,0,0,0,,...تبا
Dialogue: 0,0:18:30.85,0:18:32.65,Default,,0,0,0,,!إما أن تنجح أو تفشل
Dialogue: 0,0:18:33.27,0:18:36.11,Default,,0,0,0,,!امتد! يا عامود الغسيل
Dialogue: 0,0:18:37.99,0:18:42.07,Default,,0,0,0,,!ما هذا؟، افعلها كما يقول كوجيرو ذلك
Dialogue: 0,0:18:50.29,0:18:51.33,Default,,0,0,0,,!توقف
Dialogue: 0,0:18:51.42,0:18:54.25,Default,,0,0,0,,!هيا، فقط امتد! يا عامود الغسيل
Dialogue: 0,0:18:54.34,0:18:56.34,Default,,0,0,0,,...إذا لم تفعل، يايبا سوف
Dialogue: 0,0:18:57.21,0:19:00.80,Default,,0,0,0,,!لقد… انتهيت
Dialogue: 0,0:19:01.39,0:19:03.51,Default,,0,0,0,,!امتد! امتد! امتد
Dialogue: 0,0:19:04.26,0:19:05.26,Default,,0,0,0,,!أرجوك
Dialogue: 0,0:19:05.35,0:19:06.39,Default,,0,0,0,,!امتد
Dialogue: 0,0:19:08.43,0:19:12.06,Default,,0,0,0,,!يا عامود الغسيل
Dialogue: 0,0:19:21.99,0:19:24.24,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:19:24.32,0:19:25.66,Default,,0,0,0,,!لقد حصلت عليه
Dialogue: 0,0:19:26.62,0:19:28.41,Default,,0,0,0,,!يا ويلي
Dialogue: 0,0:19:29.04,0:19:30.96,Default,,0,0,0,,سيف الرعد 
Dialogue: 0,0:19:31.62,0:19:34.33,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:19:48.77,0:19:49.81,Default,,0,0,0,,كيف كان ذلك؟
Dialogue: 0,0:19:49.89,0:19:52.35,Default,,0,0,0,,....مياوشي سيكاي نيودو
Dialogue: 0,0:19:52.44,0:19:54.98,Default,,0,0,0,,.ليكن في سلام أخيرًا
Dialogue: 0,0:19:55.06,0:19:57.73,Default,,0,0,0,,.لقد كان خصمًا شرسًا
Dialogue: 0,0:19:57.82,0:20:00.28,Default,,0,0,0,,!كيف عرفت؟ لقد كنت فاقدًا للوعي
Dialogue: 0,0:20:01.45,0:20:03.16,Default,,0,0,0,,.لقد أنقذتني حقًا،  ساياكا
Dialogue: 0,0:20:06.91,0:20:08.95,Default,,0,0,0,,.شكرًا لك، يا عامود الغسيل
Dialogue: 0,0:20:18.50,0:20:20.67,Default,,0,0,0,,!شكرًا، صديقي
Dialogue: 0,0:20:22.93,0:20:25.80,Default,,0,0,0,,،اتضح أنها لم تكن جوهرة روح التنين
Dialogue: 0,0:20:25.89,0:20:27.80,Default,,0,0,0,,.بل جوهرة الماء
Dialogue: 0,0:20:27.89,0:20:29.77,Default,,0,0,0,,...جوهرة الماء
Dialogue: 0,0:20:42.69,0:20:43.53,Default,,0,0,0,,يايبا؟
Dialogue: 0,0:20:45.20,0:20:46.20,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:20:47.07,0:20:47.91,Default,,0,0,0,,.نعم
Dialogue: 0,0:20:49.45,0:20:51.16,Default,,0,0,0,,ما الذي حدث للتو؟
Dialogue: 0,0:21:00.96,0:21:03.47,Default,,0,0,0,,!ما الذي تنتظره؟، أسرع
Dialogue: 0,0:21:03.55,0:21:04.68,Default,,0,0,0,,!قادم
Dialogue: 0,0:21:06.13,0:21:10.18,Default,,0,0,0,,أتعتقد أنه مع المزيد من التدريب، يمكنني فعل أشياء رائعة بهذه الجوهرة؟
Dialogue: 0,0:21:10.26,0:21:12.02,Default,,0,0,0,,مثل شق البحار؟
Dialogue: 0,0:21:13.31,0:21:15.02,Default,,0,0,0,,.سيكون ذلك مشهدًا رائعًا
Dialogue: 0,0:21:22.32,0:21:24.03,Default,,0,0,0,,.إذن نيودو قد اختفى إلى الأبد
Dialogue: 0,0:21:25.07,0:21:28.74,Default,,0,0,0,,...كلام كثير، ولا فعل
Dialogue: 0,0:21:29.45,0:21:30.74,Default,,0,0,0,,.لا يهم
Dialogue: 0,0:21:31.79,0:21:35.37,Default,,0,0,0,,.أينما كانت الجوهرة، سيكونون هناك
Dialogue: 0,0:21:36.54,0:21:37.42,Default,,0,0,0,,...مما يعني
Dialogue: 0,0:21:45.92,0:21:47.68,Default,,0,0,0,,!يا محاربيّ الشجعان
Dialogue: 0,0:21:48.43,0:21:50.43,Default,,0,0,0,,،وجهوا أرواحكم إلى أجساد الوحوش
Dialogue: 0,0:21:50.51,0:21:52.93,Default,,0,0,0,,!اضربوا كوروغاني يايبا أينما يختبئ
Dialogue: 0,0:21:53.93,0:21:58.77,Default,,0,0,0,,!حددوا موقع جوهرة روح التنين واستولوا على سيف الرعد
Dialogue: 0,0:23:36.99,0:23:39.33,Default,,0,0,0,,.لقد وصلنا إلى شيكوكو
Dialogue: 0,0:23:39.41,0:23:42.29,Default,,0,0,0,,لكن في انتظارنا أقوى نينجا على الإطلاق؟
Dialogue: 0,0:23:42.37,0:23:45.09,Default,,0,0,0,,كيف نصد مثل هذه الهجمات؟
Dialogue: 0,0:23:45.17,0:23:47.59,Default,,0,0,0,,".في الحلقة القادمة، "ظهور النينجا كوتارو
Dialogue: 0,0:23:47.67,0:23:50.09,Default,,0,0,0,,!أتساءل كيف يكون حال النساء في شيكوكو
Dialogue: 0,0:23:49.67,0:23:52.75,Top,,0,0,0,,".الحلقة 14 : "ظهور النينجا كوتارو
