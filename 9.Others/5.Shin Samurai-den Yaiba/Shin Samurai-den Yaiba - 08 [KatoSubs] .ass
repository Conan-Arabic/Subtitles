Dialogue: 0,0:00:00.00,0:00:06.20,IBM,,0,0,0,,{\fs73.5\pos(1033,108)}@KatoSubs :ترجمة
Dialogue: 0,0:00:01.08,0:00:03.32,IBM,,0,0,0,,...بحثًا عن السيف الشيطاني المدعو مونوهوشيزاو
Dialogue: 0,0:00:03.32,0:00:05.69,IBM,,0,0,0,,.مضـى يايبـا ورفـاقه إلى جزيرة غـانريو
Dialogue: 0,0:00:06.22,0:00:10.87,IBM,,0,0,0,,.ليجدوا في انتظارهم ساساكي كوجيرو سيّد السيف المُبعث
Dialogue: 0,0:00:12.11,0:00:16.04,IBM,,0,0,0,,،بعد معركةٍ ضارية\Nيجد يايبا نفسه في مأزقٍ من مونوهوشيزاو
Dialogue: 0,0:00:16.04,0:00:17.91,IBM,,0,0,0,,.وتقنيته القاتلة، تسوبامي غايشي
Dialogue: 0,0:00:18.35,0:00:21.09,IBM,,0,0,0,,لكنَّ ثغرة الزمكانِ التي فتحها الرجل العنكبوت
Dialogue: 0,0:00:21.09,0:00:23.20,IBM,,0,0,0,,...ابتلعته فجأةً
Dialogue: 0,0:00:23.20,0:00:25.55,IBM,,0,0,0,,.فنجا من الموتِ بأعجوبة
Dialogue: 0,0:00:26.42,0:00:30.72,IBM,,0,0,0,,،اذ به يجد نفسه قبل 400 سنة من الحاضر
Dialogue: 0,0:00:31.48,0:00:37.35,IBM,,0,0,0,,.وقبل أيامٍ فقط مِن المبارزة الأسطورية على جزيرة غانريو
Dialogue: 0,0:00:38.94,0:00:43.61,IBM,,0,0,0,,،ان أعاد التاريخ نفسه\Nفإنّ اللحظة الّتي يهزم فيها موساشي خصمه كوجيرو
Dialogue: 0,0:00:43.61,0:00:48.19,IBM,,0,0,0,,.ستُفتح الثغرة ثانيةً من قِبل الرجل العنكبوت
Dialogue: 0,0:00:49.11,0:00:55.99,IBM,,0,0,0,,،حتّى ذلك الحين\N.يتدرب يايبا رفقة موساشي اليافع
Dialogue: 0,0:00:56.79,0:00:58.79,IBM,,0,0,0,,لكنَّ كلمةً طائشةً مِن يايبا
Dialogue: 0,0:00:58.79,0:01:01.17,IBM,,0,0,0,,ليلةَ النزالِ
Dialogue: 0,0:01:01.17,0:01:04.16,IBM,,0,0,0,,.تُهدِّدُ بتشويهِ مسارِ التاريخِ إلى الأبد
Dialogue: 0,0:01:15.02,0:01:18.40,IBM,,0,0,0,,يايبـا... أين اختفيت...؟
Dialogue: 0,0:01:19.09,0:01:20.54,IBM,,0,0,0,,...ان استمرّ الوضع هكذا
Dialogue: 0,0:01:29.57,0:01:31.95,IBM,,0,0,0,,!امتــدّ يـا مونوهوشيـزاو
Dialogue: 0,0:01:33.57,0:01:34.66,IBM,,0,0,0,,!سحقًـــا
Dialogue: 0,0:01:34.66,0:01:36.08,IBM,,0,0,0,,!مــوســــاشي
Dialogue: 0,0:01:38.96,0:01:41.08,IBM,,0,0,0,,!هذه النهاية يا موساشي
Dialogue: 0,0:01:42.25,0:01:43.83,IBM,,0,0,0,,!تــــــأهّـب
Dialogue: 0,0:01:56.99,0:01:58.25,IBM,,0,0,0,,!...انــت
Dialogue: 0,0:03:32.63,0:03:34.49,IBM,,0,0,0,,...اقول يا موساشي
Dialogue: 0,0:03:34.80,0:03:38.61,IBM,,0,0,0,,لست تخطط للتأخر على النزال غدًا، أليس كذلك؟
Dialogue: 0,0:03:39.82,0:03:40.75,IBM,,0,0,0,,!حـــاشا
Dialogue: 0,0:03:41.11,0:03:43.95,IBM,,0,0,0,,،ما أنا نائمٌ الليلة\N.وإنّي مغادرٌ فجـرًا
Dialogue: 0,0:03:55.09,0:03:56.62,IBM,,0,0,0,,!ا- اختفى؟
Dialogue: 0,0:03:56.62,0:04:00.54,IBM,,0,0,0,,!و- وا مصيبتـاه يا يايبـا\N!...كتــاب موسـاشي
Dialogue: 0,0:04:01.05,0:04:02.04,IBM,,0,0,0,,"موسـاشي قـد غُلـب"
Dialogue: 0,0:04:02.04,0:04:04.68,IBM,,0,0,0,,تـأليف: سـاساكي كوجيرو\N!موسـاشي قـد غُلـب"؟"
Dialogue: 0,0:04:05.18,0:04:10.69,IBM,,0,0,0,,...فهمت... بدأ التاريخ بالتغيّر لقولي ما لم ينبغي قوله
Dialogue: 0,0:04:10.69,0:04:14.72,IBM,,0,0,0,,،وبما أنّي حصلت على سيف الرايجين من موساشي\N.فـإذا خسـر، مـا أنـا بحـاصلـه
Dialogue: 0,0:04:14.72,0:04:15.85,IBM,,0,0,0,,...ممّـا يعني
Dialogue: 0,0:04:16.28,0:04:20.34,IBM,,0,0,0,,،أنّي وبدون سيف الرايجين\N!سأُقتل من أونيمارو؟
Dialogue: 0,0:04:21.05,0:04:22.41,IBM,,0,0,0,,!يـ- يـايبـا
Dialogue: 0,0:04:22.72,0:04:24.51,IBM,,0,0,0,,!انّـك تختفـي
Dialogue: 0,0:04:24.51,0:04:27.19,IBM,,0,0,0,,!مـا- لا بـدّ أنّـك تمزح
Dialogue: 0,0:04:27.19,0:04:28.37,IBM,,0,0,0,,!...مهلًا
Dialogue: 0,0:04:29.63,0:04:32.63,IBM,,0,0,0,,.اقول، قلّة النوم مضرّةٌ لصحتك لعلمك
Dialogue: 0,0:04:32.63,0:04:34.36,IBM,,0,0,0,,.فعليـك بـالراحـة
Dialogue: 0,0:04:34.36,0:04:36.16,IBM,,0,0,0,,.ما ذاك بعسير
Dialogue: 0,0:04:36.16,0:04:39.31,IBM,,0,0,0,,!لـنقم وليمةً ونـأكل حتّـى التخـم
Dialogue: 0,0:04:39.31,0:04:40.83,IBM,,0,0,0,,.لسـتُ أبتغـي النوم
Dialogue: 0,0:04:40.83,0:04:44.35,IBM,,0,0,0,,.سـأروي لـك قصصًـا رائعـة عن المستقبـل
Dialogue: 0,0:04:44.35,0:04:45.72,IBM,,0,0,0,,!لسـتُ مهتمًّـا
Dialogue: 0,0:04:45.72,0:04:46.68,IBM,,0,0,0,,!عجبًا
Dialogue: 0,0:04:47.12,0:04:49.44,IBM,,0,0,0,,...اتساءل عن ماهيّة المستقبل
Dialogue: 0,0:04:51.50,0:04:52.61,IBM,,0,0,0,,...ثمّـة في المستقبل
Dialogue: 0,0:04:53.54,0:04:57.94,IBM,,0,0,0,,!العديد من الفتيات بتنانير قصيرة مثل هاته يا موساشي
Dialogue: 0,0:04:57.94,0:04:59.32,IBM,,0,0,0,,!يــايبــــــــــا
Dialogue: 0,0:05:01.84,0:05:03.66,IBM,,0,0,0,,!قص علينـا
Dialogue: 0,0:05:03.66,0:05:05.32,IBM,,0,0,0,,...حـ- حسنٌ
Dialogue: 0,0:05:09.23,0:05:11.23,IBM,,0,0,0,,.هكذا إذن
Dialogue: 0,0:05:12.03,0:05:14.87,IBM,,0,0,0,,اذن فالمستقبل جِدّ مرحٍ؟
Dialogue: 0,0:05:14.87,0:05:16.80,IBM,,0,0,0,,!اجل، إنّه في غاية المرح
Dialogue: 0,0:05:18.04,0:05:20.01,IBM,,0,0,0,,.اشعر بالطمأنينة
Dialogue: 0,0:05:23.61,0:05:26.14,IBM,,0,0,0,,...عاد الأمر إلى عاهده بطريقةٍ ما
Dialogue: 0,0:05:26.47,0:05:28.68,IBM,,0,0,0,,تـأليف: ميـاموتو موساشي\N!وكذلك الكتاب
Dialogue: 0,0:05:28.68,0:05:30.12,IBM,,0,0,0,,وبعد؟
Dialogue: 0,0:05:30.52,0:05:33.65,IBM,,0,0,0,,...قص علينا البقيّة يا يايبا
Dialogue: 0,0:05:37.56,0:05:38.61,IBM,,0,0,0,,أنـام؟
Dialogue: 0,0:05:39.24,0:05:42.04,IBM,,0,0,0,,!حسـنٌ، كلّو تمـام
Dialogue: 0,0:05:42.04,0:05:44.91,IBM,,0,0,0,,~كلا، ما هو بقادرٍ على النزال غدًا
Dialogue: 0,0:05:45.29,0:05:46.34,IBM,,0,0,0,,ولمَ؟
Dialogue: 0,0:05:46.34,0:05:48.33,IBM,,0,0,0,,،ما إن يَرتَشفُ الأستاذُ موساشيَ جرعةَ خمرٍ
Dialogue: 0,0:05:48.33,0:05:52.51,IBM,,0,0,0,,حتّى يغرقَ في سُباتٍ ليومٍ كامل\N~إلّا لو حلّت مصيبةٌ
Dialogue: 0,0:05:53.05,0:05:55.38,IBM,,0,0,0,,ألن يستيقـظ؟
Dialogue: 0,0:05:55.38,0:05:57.80,IBM,,0,0,0,,...ماذا عن نزال الغد إذن
Dialogue: 0,0:05:58.24,0:06:01.81,IBM,,0,0,0,,!مــا الّذي علينــــــا فعلــــــــه بــــــــــــــــــــــــــــــــــــــــــــــحقٍّ؟
Dialogue: 0,0:06:22.67,0:06:23.65,IBM,,0,0,0,,!تـأخّر
Dialogue: 0,0:06:24.47,0:06:27.53,IBM,,0,0,0,,!تـأخّر! تـــأخّر! تــــأخّر! تــــــأخّر! تــــــــأخّر! تـــــــــــأخّر
Dialogue: 0,0:06:28.11,0:06:30.12,IBM,,0,0,0,,!!تـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــأخّر
Dialogue: 0,0:06:30.49,0:06:34.33,IBM,,0,0,0,,!ذلـك الوغـــد\N!أتُراك تعبـــــــث يــا موسـاشي؟
Dialogue: 0,0:06:34.69,0:06:37.73,IBM,,0,0,0,,.اراه متأخّرًا بالفعل
Dialogue: 0,0:06:37.73,0:06:40.97,IBM,,0,0,0,,أيُعقل أنّه أصابه مكروه؟
Dialogue: 0,0:06:40.97,0:06:43.86,IBM,,0,0,0,,محالٌ أن يُّخطئ المكان، صحيح؟
Dialogue: 0,0:06:43.86,0:06:47.23,IBM,,0,0,0,,لعلّه ما يزال نائمًـا؟
Dialogue: 0,0:06:57.93,0:07:00.99,IBM,,0,0,0,,!ما- ما أنت فاعلٌ يا كوجيرو؟
Dialogue: 0,0:07:02.47,0:07:05.34,IBM,,0,0,0,,!امتــــــدّ يــا مونـوهوشيـزاو
Dialogue: 0,0:07:05.74,0:07:09.70,IBM,,0,0,0,,!امتــدّ! امتـــــــدّ! امتـــــــــــــدّ
Dialogue: 0,0:07:12.50,0:07:13.84,IBM,,0,0,0,,!فلـتستيقظ
Dialogue: 0,0:07:13.84,0:07:16.58,IBM,,0,0,0,,!هيّـا أفِق يـا موساشي
Dialogue: 0,0:07:17.32,0:07:20.86,IBM,,0,0,0,,!سحقًــــــــــا! إنّه في سابع نومة
Dialogue: 0,0:07:28.01,0:07:30.10,IBM,,0,0,0,,"!انت متأخّرٌ يا موساشي"\N...مـ- مصيبة
Dialogue: 0,0:07:30.58,0:07:34.56,IBM,,0,0,0,,!سحقًـــا، ليس علينا تركه يخسر هذا النزال
Dialogue: 0,0:07:34.56,0:07:36.67,IBM,,0,0,0,,!هيّـا فلتفـق
Dialogue: 0,0:07:36.67,0:07:41.27,IBM,,0,0,0,,،ان لم تفز\N!لن يتسنى لي العودة
Dialogue: 0,0:07:41.99,0:07:45.07,IBM,,0,0,0,,.لا يبدو أنّه ناهضٌ عمّا قريب
Dialogue: 0,0:07:45.07,0:07:47.44,IBM,,0,0,0,,ما يُفترض بنا فعله الآن؟
Dialogue: 0,0:07:48.65,0:07:50.52,IBM,,0,0,0,,روى لنا موساشي عدّة مرات
Dialogue: 0,0:07:50.52,0:07:53.46,IBM,,0,0,0,,.عن معركة جزيرة غانريو
Dialogue: 0,0:07:53.46,0:07:55.87,IBM,,0,0,0,,!وكلٌّ مكتوبٌ هنـا
Dialogue: 0,0:07:55.87,0:07:57.29,IBM,,0,0,0,,!...لهـذا
Dialogue: 0,0:07:58.28,0:08:00.21,IBM,,0,0,0,,!فهمت مقصدك
Dialogue: 0,0:08:00.21,0:08:01.88,IBM,,0,0,0,,...في هذه الحالة
Dialogue: 0,0:08:02.44,0:08:04.96,IBM,,0,0,0,,!سأحرص على أن يمضي كل شيء وفقًا للتاريخ
Dialogue: 0,0:08:14.39,0:08:16.10,IBM,,0,0,0,,!كـوجيـــــرو
Dialogue: 0,0:08:19.06,0:08:20.73,IBM,,0,0,0,,!اتيـت أخيرًا
Dialogue: 0,0:08:21.12,0:08:22.22,IBM,,0,0,0,,!مـوســاشي
Dialogue: 0,0:08:26.47,0:08:28.75,IBM,,0,0,0,,...تبدو مختلفًا
Dialogue: 0,0:08:28.75,0:08:31.37,IBM,,0,0,0,,.ذاك من محض خيالك
Dialogue: 0,0:08:31.37,0:08:33.67,IBM,,0,0,0,,أتُراك منتصرًا حقًّا؟
Dialogue: 0,0:08:33.67,0:08:36.04,IBM,,0,0,0,,...حتّى بارتدائك هاته الجيتا بالغة الطول
Dialogue: 0,0:08:36.04,0:08:36.83,IBM,,0,0,0,,.اجل
Dialogue: 0,0:08:36.83,0:08:39.59,IBM,,0,0,0,,.انّي أفعل ما كتبه موساشي
Dialogue: 0,0:08:39.59,0:08:41.70,IBM,,0,0,0,,.انظر إلى كوجيرو
Dialogue: 0,0:08:41.70,0:08:44.46,IBM,,0,0,0,,،كما ذكر بالضبط\N.انّه يستشاط غضبًا
Dialogue: 0,0:08:44.84,0:08:48.30,IBM,,0,0,0,,!كفـاك ثرثرةً\N!فلتقبل عليّ
Dialogue: 0,0:08:49.38,0:08:50.76,IBM,,0,0,0,,!ها أنـــا ذا
Dialogue: 0,0:08:51.50,0:08:53.32,IBM,,0,0,0,,،وما إن بدأ النزالُ
Dialogue: 0,0:08:53.32,0:08:57.48,IBM,,0,0,0,,!حتَّى أطلقَ ضربتَه القاتلة تسوبامي غايشي كافتتاحيّته
Dialogue: 0,0:08:57.48,0:08:59.69,IBM,,0,0,0,,...ولكن إذ بي أصدها ببراعة
Dialogue: 0,0:08:59.69,0:09:02.62,IBM,,0,0,0,,!وأطيح به
Dialogue: 0,0:09:03.40,0:09:04.23,IBM,,0,0,0,,!آتية
Dialogue: 0,0:09:05.19,0:09:06.56,IBM,,0,0,0,,!التسوبامي غايشي
Dialogue: 0,0:09:09.74,0:09:11.86,IBM,,0,0,0,,!...امضِ بلا خوفٍ
Dialogue: 0,0:09:16.79,0:09:17.95,IBM,,0,0,0,,!اخطــأت
Dialogue: 0,0:09:20.47,0:09:22.77,IBM,,0,0,0,,!امتــــــدّ يــا مونـوهوشيـزاو
Dialogue: 0,0:09:25.13,0:09:26.50,IBM,,0,0,0,,!هذا سيئ
Dialogue: 0,0:09:44.52,0:09:45.56,IBM,,0,0,0,,آري؟
Dialogue: 0,0:09:47.33,0:09:48.28,IBM,,0,0,0,,!تـأهّب
Dialogue: 0,0:09:49.86,0:09:50.95,IBM,,0,0,0,,!هذا سيئ
Dialogue: 0,0:09:59.92,0:10:01.18,IBM,,0,0,0,,!موساشي؟
Dialogue: 0,0:10:03.69,0:10:05.88,IBM,,0,0,0,,...خلتُ أنّك لن تستيقط ليومٍ
Dialogue: 0,0:10:05.88,0:10:09.08,IBM,,0,0,0,,.كانت نيّة القتل خاصّتك تدوي
Dialogue: 0,0:10:09.08,0:10:12.26,IBM,,0,0,0,,!لكنّني استيقظت بفضلها
Dialogue: 0,0:10:13.29,0:10:15.42,IBM,,0,0,0,,!ثمّة اثنان من موساشي؟
Dialogue: 0,0:10:15.42,0:10:16.45,IBM,,0,0,0,,!أبله
Dialogue: 0,0:10:17.46,0:10:20.35,IBM,,0,0,0,,!انـا خصمك
Dialogue: 0,0:10:40.43,0:10:41.87,IBM,,0,0,0,,!...كما هو متوقع
Dialogue: 0,0:10:46.83,0:10:49.23,IBM,,0,0,0,,!امتــــــدّ يــا مونـوهوشيـزاو
Dialogue: 0,0:10:51.42,0:10:52.72,IBM,,0,0,0,,—مـا
Dialogue: 0,0:10:53.08,0:10:54.21,IBM,,0,0,0,,!مـاذا؟
Dialogue: 0,0:10:56.80,0:10:58.14,IBM,,0,0,0,,!رائـع
Dialogue: 0,0:11:02.56,0:11:04.10,IBM,,0,0,0,,!سأحسم هذا النزال
Dialogue: 0,0:11:05.52,0:11:07.73,IBM,,0,0,0,,!تسوبـــــامي غــــــــــايشي
Dialogue: 0,0:11:13.01,0:11:16.01,IBM,,0,0,0,,،آمن بـنفسك\N!وامضِ بلا خوفٍ
Dialogue: 0,0:11:16.98,0:11:20.24,IBM,,0,0,0,,.ذاك الدرب الحقّ للنصر
Dialogue: 0,0:11:36.50,0:11:39.19,IBM,,0,0,0,,!كوجيرو... قد غُلـب
Dialogue: 0,0:11:40.75,0:11:41.77,IBM,,0,0,0,,...خسرت
Dialogue: 0,0:11:45.31,0:11:47.77,IBM,,0,0,0,,!ا- اِنتصر
Dialogue: 0,0:11:59.74,0:12:00.78,IBM,,0,0,0,,!ما الأمر؟
Dialogue: 0,0:12:05.58,0:12:09.17,IBM,,0,0,0,,!فعلناها يا يايبا\N!لنقفز بسرعة
Dialogue: 0,0:12:09.17,0:12:10.29,IBM,,0,0,0,,!اجـل
Dialogue: 0,0:12:13.36,0:12:14.25,IBM,,0,0,0,,!يايبـــا
Dialogue: 0,0:12:20.08,0:12:21.30,IBM,,0,0,0,,...اراك لاحقًا
Dialogue: 0,0:12:21.76,0:12:23.10,IBM,,0,0,0,,.يا موساشي
Dialogue: 0,0:12:34.02,0:12:36.06,IBM,,0,0,0,,ما الّذي حدث للتوّ؟
Dialogue: 0,0:12:42.96,0:12:45.62,IBM,,0,0,0,,!امتــــــدّ يــا مونـوهوشيـزاو
Dialogue: 0,0:12:46.95,0:12:48.25,IBM,,0,0,0,,!سحقًـــــا
Dialogue: 0,0:12:48.25,0:12:49.75,IBM,,0,0,0,,!موســـاشي
Dialogue: 0,0:12:52.13,0:12:54.17,IBM,,0,0,0,,!هذه النهاية يا موساشي
Dialogue: 0,0:12:55.05,0:12:57.24,IBM,,0,0,0,,!تــــــــــــــأهّب
Dialogue: 0,0:13:09.87,0:13:11.07,IBM,,0,0,0,,انت...؟
Dialogue: 0,0:13:12.94,0:13:15.98,IBM,,0,0,0,,.ها قد رددت جميلك يا موساشي
Dialogue: 0,0:13:19.36,0:13:20.82,IBM,,0,0,0,,!يـايبــا
Dialogue: 0,0:13:21.55,0:13:25.26,IBM,,0,0,0,,.عدت إذن أيّها الغرّ\N.ظننتك فارًّا
Dialogue: 0,0:13:25.26,0:13:28.85,IBM,,0,0,0,,!لسـت غرًّا\N!بل يـايبـا! ألم أقل لك؟
Dialogue: 0,0:13:28.85,0:13:32.74,IBM,,0,0,0,,،ولم أكن فارًّا\N!أنـا خصمـك
Dialogue: 0,0:13:34.71,0:13:35.71,IBM,,0,0,0,,...اذن
Dialogue: 0,0:13:36.27,0:13:38.67,IBM,,0,0,0,,!ستكون أول من أقطعه
Dialogue: 0,0:13:41.98,0:13:43.60,IBM,,0,0,0,,...تسوبامي غايشي
Dialogue: 0,0:13:43.60,0:13:45.51,IBM,,0,0,0,,!لأطيحنّ بها هذه المرّة
Dialogue: 0,0:13:47.61,0:13:48.77,IBM,,0,0,0,,!هيّـا بنا
Dialogue: 0,0:14:00.86,0:14:03.36,IBM,,0,0,0,,!امضِ لا خوفٍ
Dialogue: 0,0:14:03.36,0:14:05.07,IBM,,0,0,0,,!تسوبامي غايشي
Dialogue: 0,0:14:11.69,0:14:13.71,IBM,,0,0,0,,!اوقف التسوبامي غايشي
Dialogue: 0,0:14:15.18,0:14:18.64,IBM,,0,0,0,,!كانت فكرته إذن\N...من كان يتوقع هذا
Dialogue: 0,0:14:19.17,0:14:19.80,IBM,,0,0,0,,!...ولكن
Dialogue: 0,0:14:20.51,0:14:24.51,IBM,,0,0,0,,!لا تغتر لإيقافك التسوبامي غايشي فقط
Dialogue: 0,0:14:39.78,0:14:41.07,IBM,,0,0,0,,...لأنّك
Dialogue: 0,0:14:41.55,0:14:43.58,IBM,,0,0,0,,!لن تغلب سيفًا شيطاني أبدًا
Dialogue: 0,0:14:44.29,0:14:45.26,IBM,,0,0,0,,...يايبا
Dialogue: 0,0:14:47.34,0:14:49.30,IBM,,0,0,0,,!ليس بعد
Dialogue: 0,0:14:51.53,0:14:54.06,IBM,,0,0,0,,...لن أخسر
Dialogue: 0,0:14:54.89,0:14:56.74,IBM,,0,0,0,,!حتّى لسيفٍ شيطاني
Dialogue: 0,0:14:57.24,0:15:01.76,IBM,,0,0,0,,اهم ركنٍ للساموراي هو\N!الإيمان بـقوّتك
Dialogue: 0,0:15:03.00,0:15:04.96,IBM,,0,0,0,,...ذلك الفتى
Dialogue: 0,0:15:05.43,0:15:08.45,IBM,,0,0,0,,!هاتي بكرة الرايجين يا ساياكا
Dialogue: 0,0:15:08.45,0:15:10.16,IBM,,0,0,0,,...ولكن
Dialogue: 0,0:15:10.16,0:15:13.46,IBM,,0,0,0,,!انها السبيل الوحيد لقهر سيف شيطاني
Dialogue: 0,0:15:13.46,0:15:14.48,IBM,,0,0,0,,...علاوةً
Dialogue: 0,0:15:14.48,0:15:18.62,IBM,,0,0,0,,،بالنظر لحالة يايبا الآن\N.لربما يغلب حاكم الرعود
Dialogue: 0,0:15:23.32,0:15:24.30,IBM,,0,0,0,,!يايبـــا
Dialogue: 0,0:15:28.33,0:15:30.37,IBM,,0,0,0,,!عليك بكرة الرايجين
Dialogue: 0,0:15:30.37,0:15:32.09,IBM,,0,0,0,,أمتأكّدٌ؟
Dialogue: 0,0:15:32.09,0:15:33.95,IBM,,0,0,0,,.لا تلمني إن تحولت لشيطانٍ
Dialogue: 0,0:15:33.95,0:15:36.70,IBM,,0,0,0,,!لا تهتـم! عليك بها
Dialogue: 0,0:15:38.25,0:15:39.99,IBM,,0,0,0,,.حســنٌ
Dialogue: 0,0:15:44.38,0:15:47.34,IBM,,0,0,0,,أوتخال أنّك قادرٌ\Nعلى مجابهة سيفي الشيطاني؟
Dialogue: 0,0:15:47.34,0:15:50.67,IBM,,0,0,0,,.اتوق لرؤية ما سيحدث بعد قليل
Dialogue: 0,0:15:50.67,0:15:53.68,IBM,,0,0,0,,!سأريك قوة سيف الرايجين الحقيقية
Dialogue: 0,0:16:15.08,0:16:18.45,IBM,,0,0,0,,!يايبا! لا تدع حاكم الرعود يقهرك
Dialogue: 0,0:16:18.45,0:16:21.80,IBM,,0,0,0,,!عليك بقهره بإرادتك القوية
Dialogue: 0,0:16:22.25,0:16:24.00,IBM,,0,0,0,,،طالما تؤمن بقوتك
Dialogue: 0,0:16:24.00,0:16:27.67,IBM,,0,0,0,,!لن يقهرك الرايجين ولن تتحول إلى شيطان
Dialogue: 0,0:16:28.26,0:16:30.21,IBM,,0,0,0,,!سحقًــــا
Dialogue: 0,0:16:30.21,0:16:37.77,IBM,,0,0,0,,!محالٌ أن أنقاد للتحول إلى شيطان
Dialogue: 0,0:16:49.15,0:16:51.45,IBM,,0,0,0,,!ما- مـــــا ذاك؟
Dialogue: 0,0:16:57.61,0:16:59.18,IBM,,0,0,0,,ما الذي يحدث؟
Dialogue: 0,0:16:59.18,0:17:01.21,IBM,,0,0,0,,...محال\Nثانيةً؟
Dialogue: 0,0:17:06.51,0:17:10.88,IBM,,0,0,0,,...انــــــــــــا
Dialogue: 0,0:17:10.88,0:17:14.34,IBM,,0,0,0,,!كوروغــاني يـايبــــــا
Dialogue: 0,0:17:15.94,0:17:18.45,IBM,,0,0,0,,!لقد قهر الرايجين
Dialogue: 0,0:17:18.45,0:17:19.60,IBM,,0,0,0,,!يايبــا
Dialogue: 0,0:17:19.60,0:17:23.27,IBM,,0,0,0,,!الـ- اللأمر يزداد لإثارة
Dialogue: 0,0:17:24.33,0:17:26.28,IBM,,0,0,0,,.لست إلا سياف مبتدئ بعد كل
Dialogue: 0,0:17:27.11,0:17:29.49,IBM,,0,0,0,,!لن تنطلي حيلتك عليّ
Dialogue: 0,0:17:29.49,0:17:31.81,IBM,,0,0,0,,!ها أنا ذا يا كوجيرو
Dialogue: 0,0:17:40.14,0:17:41.96,IBM,,0,0,0,,...عجبًا
Dialogue: 0,0:17:41.96,0:17:43.61,IBM,,0,0,0,,...ايّها الـ
Dialogue: 0,0:17:43.61,0:17:45.82,IBM,,0,0,0,,!استخدام القذائف لحركةٌ جبانة
Dialogue: 0,0:17:45.82,0:17:49.92,IBM,,0,0,0,,!اخـــرس! أوليس باستطاعة سيفك الامتداد أيضًا؟
Dialogue: 0,0:17:49.92,0:17:51.19,IBM,,0,0,0,,!صمتًـا
Dialogue: 0,0:17:59.83,0:18:01.35,IBM,,0,0,0,,...سحقًـا
Dialogue: 0,0:18:06.57,0:18:09.48,IBM,,0,0,0,,!!هــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــاك
Dialogue: 0,0:18:09.48,0:18:12.79,IBM,,0,0,0,,!امتــــــدّ يــا مونـوهوشيـزاو
Dialogue: 0,0:18:40.27,0:18:41.31,IBM,,0,0,0,,ماذا؟
Dialogue: 0,0:18:44.71,0:18:47.44,IBM,,0,0,0,,!ما الذي يحدث بــحقٍّ؟
Dialogue: 0,0:18:47.44,0:18:50.36,IBM,,0,0,0,,!ايها الأحمق! فلتسرع بنزع الكرة
Dialogue: 0,0:18:50.36,0:18:53.11,IBM,,0,0,0,,!القول أسهل من الفعل
Dialogue: 0,0:18:56.62,0:18:58.29,IBM,,0,0,0,,!اخرجــــــــــــــي
Dialogue: 0,0:19:07.93,0:19:12.02,IBM,,0,0,0,,...آري؟ قوتي
Dialogue: 0,0:19:14.61,0:19:15.96,IBM,,0,0,0,,!يايبـا
Dialogue: 0,0:19:16.34,0:19:18.82,IBM,,0,0,0,,...يا له من سيف مرعب
Dialogue: 0,0:19:18.82,0:19:23.42,IBM,,0,0,0,,...ان يستنزف قوته الجسدية والنفسية حتّى آخر ذرّة لأمرٌ غير متوقع
Dialogue: 0,0:19:25.69,0:19:29.54,IBM,,0,0,0,,.على كل، كانت تلك خطوة كبيرة
Dialogue: 0,0:19:41.08,0:19:44.04,IBM,,0,0,0,,.خـارقٌ يا كوروغاني يايبا
Dialogue: 0,0:19:44.56,0:19:47.57,IBM,,0,0,0,,حتّى أنا ساساكي كوجيرو\N،لم أستطع خدشك
Dialogue: 0,0:19:47.57,0:19:49.80,IBM,,0,0,0,,.ذاك يجرح كبريائي
Dialogue: 0,0:19:59.73,0:20:02.16,IBM,,0,0,0,,اذن أنت المدعو الدكتور كانابا؟
Dialogue: 0,0:20:02.68,0:20:05.86,IBM,,0,0,0,,،من الآن فصاعدًا\N.قوّاك في خدمتي
Dialogue: 0,0:20:05.86,0:20:09.40,IBM,,0,0,0,,.اجل، أرى نفسي ذو نفعٍ
Dialogue: 0,0:20:09.78,0:20:14.28,IBM,,0,0,0,,.مو من باب الغرور بس أنا داهية
Dialogue: 0,0:20:14.28,0:20:18.14,IBM,,0,0,0,,.حسنٌ، ليس وكأنّ ثمّة أحدٌ يشهد بذلك
Dialogue: 0,0:20:21.60,0:20:25.95,IBM,,0,0,0,,،في هذه الحالة\N.لنختبر قدراتك حالًا
Dialogue: 0,0:20:27.34,0:20:29.18,IBM,,0,0,0,,.تحت أمرك
Dialogue: 0,0:20:29.18,0:20:33.17,IBM,,0,0,0,,.حسنٌ، أستأذن الآن
Dialogue: 0,0:20:37.76,0:20:39.76,IBM,,0,0,0,,...عـ- عدت
Dialogue: 0,0:20:40.15,0:20:41.77,IBM,,0,0,0,,اين سيف الرايجين؟
Dialogue: 0,0:20:41.77,0:20:44.44,IBM,,0,0,0,,...حسنٌ... بشأن ذلك
Dialogue: 0,0:20:44.44,0:20:45.47,IBM,,0,0,0,,!ماذا؟
Dialogue: 0,0:20:45.47,0:20:49.10,IBM,,0,0,0,,...حسنُ... أدري أنّه ليس ذات المطلوب
Dialogue: 0,0:20:49.47,0:20:52.29,IBM,,0,0,0,,.لكنّني جلبت كوجيرو عوضًا
Dialogue: 0,0:20:53.53,0:20:54.76,IBM,,0,0,0,,.كوجيرو
Dialogue: 0,0:20:55.20,0:20:59.53,IBM,,0,0,0,,.انضمامُ مُبارزٍ عبقري مثلك لجيش أونيمارو لأمرٌ عظيم
Dialogue: 0,0:20:59.84,0:21:01.53,IBM,,0,0,0,,.فلتصبح ذراعي اليمنى
Dialogue: 0,0:21:01.53,0:21:02.72,IBM,,0,0,0,,!ارفض
Dialogue: 0,0:21:02.72,0:21:04.03,IBM,,0,0,0,,!ماذا قلت؟
Dialogue: 0,0:21:04.70,0:21:06.85,IBM,,0,0,0,,.لا أدين لك بشيء
Dialogue: 0,0:21:06.85,0:21:07.60,IBM,,0,0,0,,!ايّها الوغد
Dialogue: 0,0:21:07.60,0:21:09.62,IBM,,0,0,0,,!على رسلك يا سيدي أونيمارو
Dialogue: 0,0:21:10.15,0:21:14.44,IBM,,0,0,0,,بالمناسبة، ألا يعتريك الفصول بخصوص شيءٍ؟
Dialogue: 0,0:21:14.44,0:21:15.80,IBM,,0,0,0,,عمّ تتحدث؟
Dialogue: 0,0:21:15.80,0:21:20.13,IBM,,0,0,0,,.من أقوى ساموراي في عصرنا هذا
Dialogue: 0,0:21:23.25,0:21:26.63,IBM,,0,0,0,,...بناءً على المعلومات التي جمعتها وحلّلتها
Dialogue: 0,0:21:26.63,0:21:29.10,IBM,,0,0,0,,...أقوى ساموراي في العالم هو
Dialogue: 0,0:21:35.57,0:21:38.52,IBM,,0,0,0,,!ماذا؟! ذلك الغرّ؟
Dialogue: 0,0:21:40.25,0:21:41.65,IBM,,0,0,0,,.فهمت
Dialogue: 0,0:21:41.65,0:21:47.18,IBM,,0,0,0,,،لن يكون موساشي خصم كوجيرو الأبدي من الآن فصاعدًا
Dialogue: 0,0:21:47.18,0:21:49.55,IBM,,0,0,0,,.بل عوضًا، سيكون كوروغاني يايبا
Dialogue: 0,0:21:50.65,0:21:55.90,IBM,,0,0,0,,.لن تصير أعظم ساموراي دون هزيمة يايبا
Dialogue: 0,0:21:55.90,0:21:59.70,IBM,,0,0,0,,!...بالتفكير أن ذاك الغر يحوز على لقب الأقوى
Dialogue: 0,0:22:07.37,0:22:08.77,IBM,,0,0,0,,...انا المدعو
Dialogue: 0,0:22:09.38,0:22:12.49,IBM,,0,0,0,,!ساساكي كوجيرو، لأقطعنّ كوروغاني يايبا
Dialogue: 0,0:22:13.67,0:22:15.26,IBM,,0,0,0,,.والآن، أستأذن
Dialogue: 0,0:22:16.06,0:22:19.67,IBM,,0,0,0,,!مرحـــــــى! أفلح الأمر
Dialogue: 0,0:22:19.67,0:22:25.29,IBM,,0,0,0,,.يا للسهولة! سقط في الفخ أسرع مما توقعت
Dialogue: 0,0:22:31.24,0:22:35.67,IBM,,0,0,0,,!سيدي أونيمارو! أرجو رحمتك
Dialogue: 0,0:22:35.67,0:22:38.38,IBM,,0,0,0,,!انا الأقوى في العالم
Dialogue: 0,0:22:38.38,0:22:42.02,IBM,,0,0,0,,!...ذـ ذلك كان ضمن خطّتي
Dialogue: 0,0:22:42.51,0:22:44.59,IBM,,0,0,0,,...كوروغاني يايبا
Dialogue: 0,0:22:44.59,0:22:47.51,IBM,,0,0,0,,.حزت أخيرًا على قوة الرايجين
Dialogue: 0,0:22:49.62,0:22:52.11,IBM,,0,0,0,,.يبدو أنّ عليّ الشروع في التجهيزات
Dialogue: 0,0:23:01.01,0:23:02.66,IBM,,0,0,0,,سيف الرايجين...؟
Dialogue: 0,0:23:17.27,0:23:18.80,IBM,,0,0,0,,!لن أموت
Dialogue: 0,0:23:19.44,0:23:21.67,IBM,,0,0,0,,.سأقاتل واستمرّ بالفوز
Dialogue: 0,0:23:22.01,0:23:24.32,IBM,,0,0,0,,...وسأشق طريقي إلى
Dialogue: 0,0:23:27.11,0:23:30.40,IBM,,0,0,0,,~ستقبلٍ أشبه بالجنّة
Dialogue: 0,0:23:35.35,0:23:37.94,IBM,,0,0,0,,،بما أنّ يايبا قهر الرايجين
Dialogue: 0,0:23:37.94,0:23:39.81,IBM,,0,0,0,,!فقد آن أوان مداهمة قلعة أونيمارو
Dialogue: 0,0:23:40.57,0:23:44.32,IBM,,0,0,0,,،لكن قبل ذلك\N.يبدو أنّ لديه حركة جديدة لإتقانها
Dialogue: 0,0:23:44.32,0:23:46.15,IBM,,0,0,0,,"قادمًا، "ولادة كاميناري غيري
