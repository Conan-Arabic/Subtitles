Dialogue: 0,0:00:00.56,0:00:01.93,Default,,0,0,0,,...يايبا
Dialogue: 0,0:00:01.00,0:00:08.00,DCRights,,0,0,0,,{\fs70\pos(20,25)} ABOODY SUBS | ترجمة \NTelegram : ABOODY-SUBS\NX : @ABOODY_SUBS
Dialogue: 0,0:00:02.58,0:00:03.86,Default,,0,0,0,,...هذه
Dialogue: 0,0:00:08.62,0:00:11.01,Default,,0,0,0,,.احتفظي بها
Dialogue: 0,0:00:11.01,0:00:12.53,Default,,0,0,0,,...لكن
Dialogue: 0,0:00:12.53,0:00:14.99,Default,,0,0,0,,.انت تحتفظين بها دائمًا
Dialogue: 0,0:00:15.68,0:00:18.83,Default,,0,0,0,,.بالإضافة إلى ذلك، لدي تقنيتي الجديدة الآن
Dialogue: 0,0:00:20.62,0:00:22.25,Default,,0,0,0,,.أنت محق
Dialogue: 0,0:00:30.05,0:00:31.59,Default,,0,0,0,,...أونيمارو
Dialogue: 0,0:00:35.37,0:00:36.89,Default,,0,0,0,,...هذه المرة، سأ
Dialogue: 0,0:00:37.37,0:00:38.35,Default,,0,0,0,,...أهزمك
Dialogue: 0,0:00:40.34,0:00:42.31,Default,,0,0,0,,!أونيمارو
Dialogue: 0,0:00:46.53,0:00:49.40,Default,,0,0,0,,!أونيمارو! هيا قاتلني
Dialogue: 0,0:01:00.61,0:01:01.83,Default,,0,0,0,,.أيها الحمقى
Dialogue: 0,0:01:06.08,0:01:08.18,Default,,0,0,0,,!يايبا
Dialogue: 0,0:01:11.19,0:01:13.70,Default,,0,0,0,,!وداعًا
Dialogue: 0,0:01:14.77,0:01:17.42,Default,,0,0,0,,.حاولوا الزحف للأعلى إذا استطعتم
Dialogue: 0,0:01:18.00,0:01:21.06,Default,,0,0,0,,.حينها فقط سأتعامل معكم شخصيًا
Dialogue: 0,0:01:24.06,0:01:25.71,Default,,0,0,0,,...يايبا، امسك بـ
Dialogue: 0,0:01:30.34,0:01:32.23,Default,,0,0,0,,!اصمد، يا عمود الغسيل
Dialogue: 0,0:01:43.25,0:01:45.78,Default,,0,0,0,,ما هذا المكان؟
Dialogue: 0,0:01:58.64,0:02:01.18,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:02:02.56,0:02:04.77,Opening,,0,0,0,,الإرادة للفوز هي شهادة على جديتي
Dialogue: 0,0:02:04.66,0:02:07.71,Opening,,0,0,0,,لكنك لن تصدق ذلك، أليس كذلك؟
Dialogue: 0,0:02:07.62,0:02:10.07,Opening,,0,0,0,,المنطق السليم يمكن أن يكون عبئًا
Dialogue: 0,0:02:10.06,0:02:12.84,Opening,,0,0,0,,أستطيع التحدي لأني جاهل
Dialogue: 0,0:02:12.85,0:02:13.99,Opening,,0,0,0,,هل أنا "ساموراي حقيقي"؟
Dialogue: 0,0:02:14.00,0:02:15.26,Opening,,0,0,0,,أم مجرد "لاعب وقح"؟
Dialogue: 0,0:02:15.26,0:02:17.92,Opening,,0,0,0,,علي أن أتحدى لأني أريد أن أعرف
Dialogue: 0,0:02:17.91,0:02:23.28,Opening,,0,0,0,,الشغف في قلبي كان ساطعًا مثل البرق
Dialogue: 0,0:02:23.74,0:02:28.46,Opening,,0,0,0,,بغض النظر عن مقدار تغيرك
Dialogue: 0,0:02:28.72,0:02:33.15,Opening,,0,0,0,,لا يوجد كذب في المعارك التي خضناها
Dialogue: 0,0:02:33.15,0:02:37.90,Opening,,0,0,0,,أنا أمضي قدمًا بالشجاعة لأعيش بسرعة وتهور
Dialogue: 0,0:02:37.89,0:02:43.84,Opening,,0,0,0,,لأصل إلى القوة الجديدة المثيرة
Dialogue: 0,0:02:45.22,0:02:50.00,Opening,,0,0,0,,لنرفع سيوفنا نحو الغد
Dialogue: 0,0:02:50.01,0:02:55.03,Opening,,0,0,0,,أيقظ القوة الطبية 
Dialogue: 0,0:02:55.03,0:02:59.80,Opening,,0,0,0,,الآن تهب علينا الأقدار المحترقة
Dialogue: 0,0:02:59.80,0:03:04.72,Opening,,0,0,0,,سأقطع علامات اليأس
Dialogue: 0,0:03:04.72,0:03:06.54,Opening,,0,0,0,,بهذا "السيف" الحقيقي
Dialogue: 0,0:03:16.97,0:03:21.97,Default,,0,0,0,,.الحلقة 10: ظهور الملوك السماويون الأربعة لأونيمارو
Dialogue: 0,0:03:22.72,0:03:25.31,Default,,0,0,0,,!ياسايكا! أستيقظي
Dialogue: 0,0:03:25.31,0:03:27.02,Default,,0,0,0,,!هذا سيء
Dialogue: 0,0:03:27.02,0:03:29.61,Default,,0,0,0,,!لقد ابتلعت الكثير من الماء
Dialogue: 0,0:03:29.61,0:03:32.57,Default,,0,0,0,,!يايبا، حان يايبا، حان وقت التنفس الاصطناعي
Dialogue: 0,0:03:32.57,0:03:33.78,Default,,0,0,0,,!نعم
Dialogue: 0,0:03:35.17,0:03:37.86,Default,,0,0,0,,ما هو التنفس الاصطناعي؟
Dialogue: 0,0:03:38.66,0:03:41.82,Default,,0,0,0,,!تقوم بإعطائها التنفس من الفم للفم
Dialogue: 0,0:03:41.82,0:03:42.70,Default,,0,0,0,,!بسرعة
Dialogue: 0,0:03:43.53,0:03:44.56,Default,,0,0,0,,حقًا؟
Dialogue: 0,0:03:53.03,0:03:55.92,Default,,0,0,0,,هل يمكنني فعل هذا حقًا؟
Dialogue: 0,0:03:55.92,0:03:58.22,Default,,0,0,0,,!فقط افعلها! قبل فوات الأوان
Dialogue: 0,0:03:58.22,0:04:00.41,Default,,0,0,0,,...حسنًا
Dialogue: 0,0:04:16.98,0:04:19.32,Default,,0,0,0,,!لماذا فعلت هذا؟
Dialogue: 0,0:04:19.32,0:04:22.62,Default,,0,0,0,,!ماذا تقصد بماذا؟، لقد كنتٓ تحاول تقبيلي
Dialogue: 0,0:04:22.96,0:04:25.22,Default,,0,0,0,,.لم أفعل! كان هذا تنفساً اصطناعياً
Dialogue: 0,0:04:25.22,0:04:27.17,Default,,0,0,0,,!صحيح! أنت منحرف
Dialogue: 0,0:04:27.17,0:04:28.70,Default,,0,0,0,,...أنا لست
Dialogue: 0,0:04:28.70,0:04:30.48,Default,,0,0,0,,هل سمعتِ شيئًا؟
Dialogue: 0,0:04:31.17,0:04:33.19,Default,,0,0,0,,أين نحن، على أي حال؟
Dialogue: 0,0:04:33.19,0:04:36.30,Default,,0,0,0,,...من المفترض أننا داخل القلعة
Dialogue: 0,0:04:36.79,0:04:38.25,Default,,0,0,0,,أين الآخرون؟
Dialogue: 0,0:04:38.25,0:04:41.57,Default,,0,0,0,,.لقد انفصلنا خلال السقوط
Dialogue: 0,0:04:41.57,0:04:43.74,Default,,0,0,0,,...آمل أن يكونوا بخير
Dialogue: 0,0:04:52.27,0:04:54.90,Default,,0,0,0,,.يبدو أننا لن نعود للأعلى
Dialogue: 0,0:04:56.59,0:04:59.36,Default,,0,0,0,,...أين نحن
Dialogue: 0,0:05:01.45,0:05:03.26,Default,,0,0,0,,!ما هذا؟
Dialogue: 0,0:05:07.01,0:05:10.18,Default,,0,0,0,,!هذا وحش
Dialogue: 0,0:05:10.18,0:05:12.98,Default,,0,0,0,,.وحش؟ كم هذا وقح
Dialogue: 0,0:05:12.98,0:05:18.42,Default,,0,0,0,,.أنا أحد الملوك السماويين الأربعة لأونيمارو، سمكة الأنقليس العملاقة ياكيتوري
Dialogue: 0,0:05:18.80,0:05:21.38,Default,,0,0,0,,الملوك السماويون الأربعة لأونيمارو؟
Dialogue: 0,0:05:21.38,0:05:23.47,Default,,0,0,0,,،بأوامر من الملك أونيمارو
Dialogue: 0,0:05:23.47,0:05:26.18,Default,,0,0,0,,.من المفترض أن آكلكم الآن
Dialogue: 0,0:05:26.18,0:05:26.96,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:05:26.96,0:05:30.02,Default,,0,0,0,,!سأبدا
Dialogue: 0,0:05:33.59,0:05:35.54,Default,,0,0,0,,...لو لم تسقطوا في الحفرة
Dialogue: 0,0:05:35.54,0:05:39.07,Default,,0,0,0,,!ماذا لو تعرض وجهي الجميل للتشوه؟
Dialogue: 0,0:05:39.83,0:05:42.32,Default,,0,0,0,,.هذا سيجعلك تبدو وسيمًا على أي حال
Dialogue: 0,0:05:43.45,0:05:45.99,Default,,0,0,0,,.من الجيد أن تكون في معنويات عالية
Dialogue: 0,0:05:45.99,0:05:47.02,Default,,0,0,0,,!من هناك؟
Dialogue: 0,0:05:47.02,0:05:48.69,Default,,0,0,0,,!اظهر نفسك
Dialogue: 0,0:05:48.69,0:05:50.63,Default,,0,0,0,,.هنا بالأسفل
Dialogue: 0,0:05:54.82,0:05:55.75,Default,,0,0,0,,قرد؟
Dialogue: 0,0:05:56.15,0:05:59.51,Default,,0,0,0,,.رغم مظهري، أنا في الواقع أحد الملوك السماويين الأربعة لأونيمارو
Dialogue: 0,0:05:59.51,0:06:01.04,Default,,0,0,0,,.نعم، أنا كذلك
Dialogue: 0,0:06:01.04,0:06:02.30,Default,,0,0,0,,ماذا تقول؟
Dialogue: 0,0:06:09.60,0:06:11.64,Default,,0,0,0,,!أصلب من الفولاذ
Dialogue: 0,0:06:11.64,0:06:12.81,Default,,0,0,0,,!وحش قذر
Dialogue: 0,0:06:13.58,0:06:15.77,Default,,0,0,0,,!أسرع من الرصاصة
Dialogue: 0,0:06:15.77,0:06:19.78,Default,,0,0,0,,!اقفز فوق المباني العالية بقفزة واحدة
Dialogue: 0,0:06:19.78,0:06:21.04,Default,,0,0,0,,...اسمي
Dialogue: 0,0:06:22.87,0:06:25.77,Default,,0,0,0,,!هو سوبر غوريلا دوراي دوراي
Dialogue: 0,0:06:26.64,0:06:29.13,Default,,0,0,0,,انتهيت من تقديمك الصغير؟
Dialogue: 0,0:06:29.13,0:06:32.14,Default,,0,0,0,,!اصمت! لماذا لا تقدمون أنفسكم؟
Dialogue: 0,0:06:32.90,0:06:34.45,Default,,0,0,0,,أنت فضولي، أليس كذلك؟
Dialogue: 0,0:06:34.89,0:06:36.63,Default,,0,0,0,,.إذن، سأفعل ذلك
Dialogue: 0,0:06:36.63,0:06:37.99,Default,,0,0,0,,!لا مثيل له في التاريخ
Dialogue: 0,0:06:37.99,0:06:39.60,Default,,0,0,0,,!الأفضل في البلاد
Dialogue: 0,0:06:39.60,0:06:41.96,Default,,0,0,0,,!المحارب الذي يزرع الخوف في الجميع
Dialogue: 0,0:06:41.96,0:06:43.26,Default,,0,0,0,,!مياموتو موساشي
Dialogue: 0,0:06:43.26,0:06:44.99,Default,,0,0,0,, !ساساكي كوجيرو 
Dialogue: 0,0:06:44.99,0:06:46.93,Default,,0,0,0,,...هذا هو
Dialogue: 0,0:06:46.93,0:06:48.94,Default,,0,0,0,,...اسمي
Dialogue: 0,0:06:49.84,0:06:51.68,Default,,0,0,0,,!مهلاً، هذا خطي
Dialogue: 0,0:06:51.68,0:06:53.37,Default,,0,0,0,,!توقف عن تقليدي
Dialogue: 0,0:06:53.37,0:06:57.27,Default,,0,0,0,,!كيف تجرؤ على تسمية نفسك بلا مثيل
Dialogue: 0,0:06:57.27,0:06:58.56,Default,,0,0,0,, !ماذا تقصد بذلك؟ -\N.هاها -
Dialogue: 0,0:06:58.56,0:07:00.13,Default,,0,0,0,,!تراجع عن ذلك، موساشي -\N هؤلاء هم خصومي؟ -
Dialogue: 0,0:07:00.13,0:07:00.74,Default,,0,0,0,,!لا، شكرًا -\N.لن يكون هناك الكثير من الترفيه لي -
Dialogue: 0,0:07:00.74,0:07:02.78,Default,,0,0,0,,!لا تكن مغرورًا بنفسك، كوجيرو -\N.لن يكون هناك الكثير من الترفيه لي -
Dialogue: 0,0:07:03.38,0:07:04.55,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:07:04.55,0:07:06.24,Default,,0,0,0,,!لقد قلتها الآن
Dialogue: 0,0:07:15.03,0:07:16.54,Default,,0,0,0,,...مثل هذه القوة
Dialogue: 0,0:07:32.16,0:07:34.54,Default,,0,0,0,,.لا وقت لخفض حذرك، كوجيرو
Dialogue: 0,0:07:36.74,0:07:37.98,Default,,0,0,0,,...لحظة
Dialogue: 0,0:07:37.98,0:07:41.87,Default,,0,0,0,,.هدفي هو الحصول على سيف الرعد، على أي حال
Dialogue: 0,0:07:42.29,0:07:43.73,Default,,0,0,0,,،إذا عملت مع هذا القرد
Dialogue: 0,0:07:43.73,0:07:46.22,Default,,0,0,0,,...وأزلت موساشي من الوجود
Dialogue: 0,0:07:46.22,0:07:48.50,Default,,0,0,0,,ألن أتمكن من الحصول عليه بسهولة؟
Dialogue: 0,0:07:52.05,0:07:53.84,Default,,0,0,0,,...تبا
Dialogue: 0,0:07:53.84,0:07:57.74,Default,,0,0,0,,.هذا اونيمارو احمق مثله أن يلقي بنا هنا
Dialogue: 0,0:07:59.42,0:08:00.13,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:08:01.53,0:08:02.21,Default,,0,0,0,,!سايكا
Dialogue: 0,0:08:03.83,0:08:05.30,Default,,0,0,0,,!من هناك؟
Dialogue: 0,0:08:07.52,0:08:10.51,Default,,0,0,0,,،أنا أحد الملوك السماويين الأربعة لأونيمارو
Dialogue: 0,0:08:10.51,0:08:13.04,Default,,0,0,0,,!الحرباء بونابرت
Dialogue: 0,0:08:13.04,0:08:16.62,Default,,0,0,0,,،إذا أعطيتني سيف الرعد والكرة بسلام
Dialogue: 0,0:08:16.62,0:08:19.19,Default,,0,0,0,,.سأسمح لكم بالعيش طول حياتكم
Dialogue: 0,0:08:19.19,0:08:22.16,Default,,0,0,0,,!إذن، تعال واحصل عليه إذا استطعت
Dialogue: 0,0:08:22.16,0:08:24.53,Default,,0,0,0,,!سأريك تقنيتي الجديدة
Dialogue: 0,0:08:26.14,0:08:29.99,Default,,0,0,0,,!لا يوجد مدخل لكلمة "مستحيل" في قاموسي
Dialogue: 0,0:08:31.39,0:08:33.12,Default,,0,0,0,,!سيف الرعد بدون الكرة
Dialogue: 0,0:08:34.08,0:08:35.75,Default,,0,0,0,,...ضربة البرق
Dialogue: 0,0:08:37.11,0:08:38.66,Default,,0,0,0,,هل اختفى؟
Dialogue: 0,0:08:39.42,0:08:42.08,Default,,0,0,0,,!يايبا
Dialogue: 0,0:08:42.08,0:08:44.80,Default,,0,0,0,,!هيا اعطيني الكرة
Dialogue: 0,0:08:44.80,0:08:46.39,Default,,0,0,0,,!ابتعد عنها
Dialogue: 0,0:08:46.39,0:08:49.51,Default,,0,0,0,,!سيف الزوبعة
Dialogue: 0,0:08:56.80,0:08:58.93,Default,,0,0,0,,!لقد اختفى مرة أخرى
Dialogue: 0,0:08:58.93,0:09:00.95,Default,,0,0,0,,ماذا نفعل؟
Dialogue: 0,0:09:00.95,0:09:03.23,Default,,0,0,0,,.ابقوا في مكانكم الآن
Dialogue: 0,0:09:07.37,0:09:08.94,Default,,0,0,0,,يايبا؟
Dialogue: 0,0:09:08.94,0:09:13.41,Default,,0,0,0,,.لا تتحرك. إنه يستخدم عين عقله للبحث عن العدو
Dialogue: 0,0:09:19.54,0:09:21.19,Default,,0,0,0,,!هناك
Dialogue: 0,0:09:23.12,0:09:25.34,Default,,0,0,0,,!تقنية الاستبدال
Dialogue: 0,0:09:28.71,0:09:30.38,Default,,0,0,0,,!كيف تجرؤ
Dialogue: 0,0:09:30.38,0:09:31.97,Default,,0,0,0,,!وابل الخناجر
Dialogue: 0,0:09:33.28,0:09:35.87,Default,,0,0,0,,!تبا، أنت وحيلك التافهة
Dialogue: 0,0:09:35.87,0:09:37.85,Default,,0,0,0,,!لدي فكرة
Dialogue: 0,0:09:37.85,0:09:38.97,Default,,0,0,0,,فكرة؟
Dialogue: 0,0:09:46.01,0:09:50.03,Default,,0,0,0,,لا فائدة من الاختباء! فقط اخرجوا و واستسلموا!
Dialogue: 0,0:10:00.94,0:10:03.65,Default,,0,0,0,,...لست غبياً أقع في مثل هذا الفخ
Dialogue: 0,0:10:03.65,0:10:07.21,Default,,0,0,0,,...فراشة
Dialogue: 0,0:10:08.96,0:10:10.46,Default,,0,0,0,,.لقد وقعت في فخهم
Dialogue: 0,0:10:12.19,0:10:14.42,Default,,0,0,0,,!أمسكت بك الآن
Dialogue: 0,0:10:14.89,0:10:15.72,Default,,0,0,0,,!افعليها
Dialogue: 0,0:10:19.11,0:10:21.74,Default,,0,0,0,,!أنت حقًا مزعج، أتعلم ذلك؟
Dialogue: 0,0:10:21.74,0:10:23.98,Default,,0,0,0,,!ابق مكانك
Dialogue: 0,0:10:26.38,0:10:28.18,Default,,0,0,0,,!حسنًا، لقد أمسكت به
Dialogue: 0,0:10:28.18,0:10:30.65,Default,,0,0,0,,يايبا، لا تتركه، حسنًا؟
Dialogue: 0,0:10:33.28,0:10:34.96,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:10:40.86,0:10:43.27,Default,,0,0,0,,أنت أنا؟
Dialogue: 0,0:10:43.27,0:10:44.75,Default,,0,0,0,,!العكس صحيح
Dialogue: 0,0:10:44.75,0:10:46.43,Default,,0,0,0,,!لا بد أنك تمزح
Dialogue: 0,0:10:46.43,0:10:48.30,Default,,0,0,0,,!يمكنني قول الشيء نفسه لك
Dialogue: 0,0:10:48.30,0:10:49.92,Default,,0,0,0,,...يبدون متشابهين
Dialogue: 0,0:10:49.92,0:10:52.42,Default,,0,0,0,,هل يمكنه نسخ مظهر عدوه أيضًا؟
Dialogue: 0,0:11:03.50,0:11:05.27,Default,,0,0,0,,ماذا نفعل؟
Dialogue: 0,0:11:06.34,0:11:10.13,Default,,0,0,0,,!ألا يمكنكِ التمييز؟! ذلك الأحمق هو المزيف
Dialogue: 0,0:11:10.13,0:11:11.98,Default,,0,0,0,,!أنت المزيف
Dialogue: 0,0:11:12.33,0:11:13.59,Default,,0,0,0,,!ماذا تقول الآن، أيها المزيف؟
Dialogue: 0,0:11:13.59,0:11:14.95,Default,,0,0,0,, !صحيح -\N !ماذا؟ -
Dialogue: 0,0:11:14.95,0:11:15.98,Default,,0,0,0,,.يايبا
Dialogue: 0,0:11:15.98,0:11:18.95,Default,,0,0,0,,ما هو 500 × 1000؟
Dialogue: 0,0:11:19.37,0:11:21.33,Default,,0,0,0,,500 × 1000؟
Dialogue: 0,0:11:21.98,0:11:22.79,Default,,0,0,0,,!50,000
Dialogue: 0,0:11:26.33,0:11:27.67,Default,,0,0,0,,500,000,000؟
Dialogue: 0,0:11:29.34,0:11:31.65,Default,,0,0,0,,.غبي، إنها 50,000
Dialogue: 0,0:11:31.65,0:11:34.19,Default,,0,0,0,,! لقد أخطأ
Dialogue: 0,0:11:34.19,0:11:36.30,Default,,0,0,0,,!هذا مؤلم! لماذا فعلت هذا؟
Dialogue: 0,0:11:37.39,0:11:39.54,Default,,0,0,0,,.حتى لو استطعت نسخ مظهره
Dialogue: 0,0:11:39.54,0:11:42.06,Default,,0,0,0,,!لا يمكنك نسخ عقله أيضًا
Dialogue: 0,0:11:42.72,0:11:44.27,Default,,0,0,0,,!أنت المزيف
Dialogue: 0,0:11:45.36,0:11:48.21,Default,,0,0,0,,.مستحيل أن يجيب يايبا على الإجابة الصحيحة
Dialogue: 0,0:11:48.93,0:11:50.44,Default,,0,0,0,,.هيا استسلم
Dialogue: 0,0:11:53.93,0:11:55.90,Default,,0,0,0,,...في هذه الحالة
Dialogue: 0,0:12:02.11,0:12:02.95,Default,,0,0,0,,!تبا
Dialogue: 0,0:12:02.95,0:12:05.59,Default,,0,0,0,,!يايبا، ارمني
Dialogue: 0,0:12:05.59,0:12:06.46,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:12:10.29,0:12:12.75,Default,,0,0,0,,!ركلة البزاق
Dialogue: 0,0:12:16.33,0:12:18.51,Default,,0,0,0,,...أخطأت
Dialogue: 0,0:12:22.27,0:12:24.35,Default,,0,0,0,,!سيف الرعد بدون الكرة
Dialogue: 0,0:12:26.21,0:12:27.95,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:12:38.07,0:12:39.34,Default,,0,0,0,,!لقد فعلتها
Dialogue: 0,0:12:40.35,0:12:42.83,Default,,0,0,0,,.يا له من ألم في المؤخرة
Dialogue: 0,0:12:42.83,0:12:45.65,Default,,0,0,0,,...هل الآخرون أيضًا
Dialogue: 0,0:12:45.65,0:12:47.33,Default,,0,0,0,,هل سيكونون بخير؟
Dialogue: 0,0:12:47.95,0:12:50.00,Default,,0,0,0,,.يجب أن نتجمع بسرعة
Dialogue: 0,0:13:07.45,0:13:08.64,Default,,0,0,0,,ما رأيك في ذلك؟
Dialogue: 0,0:13:15.93,0:13:19.07,Default,,0,0,0,,.إنجاز مثير للاهتمام حقًا
Dialogue: 0,0:13:19.43,0:13:23.63,Default,,0,0,0,,...إنه قوي جدًا، رغم مظهره
Dialogue: 0,0:13:32.08,0:13:34.42,Default,,0,0,0,,.كنت أنتظر هذه اللحظة
Dialogue: 0,0:13:34.79,0:13:35.84,Default,,0,0,0,,!موساشي
Dialogue: 0,0:13:37.20,0:13:39.37,Default,,0,0,0,,ما بك؟
Dialogue: 0,0:13:39.95,0:13:43.75,Default,,0,0,0,,.إن هدفي ليس هزيمة أونيمارو من البداية
Dialogue: 0,0:13:43.75,0:13:47.81,Default,,0,0,0,,!بل أريد الحصول على سيف الرعد وأصبح أفضل ساموراي في البلاد
Dialogue: 0,0:13:48.62,0:13:50.10,Default,,0,0,0,,!تبا
Dialogue: 0,0:13:51.21,0:13:54.31,Default,,0,0,0,,هذا مثير للاهتمام... هل يتقاتلون؟
Dialogue: 0,0:13:54.95,0:13:57.27,Default,,0,0,0,,إذن، أنت مجرد زومبي في النهاية، أليس كذلك؟
Dialogue: 0,0:13:57.27,0:14:01.18,Default,,0,0,0,,!لا أصدق أن ضميرك فاسد مثل جسدك
Dialogue: 0,0:14:01.18,0:14:03.35,Default,,0,0,0,,،محاولة الفوز بطرق قذرة
Dialogue: 0,0:14:03.35,0:14:06.87,Default,,0,0,0,,...والاعتماد على قوة سيف الرعد وليس قوتك وحدك
Dialogue: 0,0:14:07.68,0:14:12.29,Default,,0,0,0,,!وتخطط أن تصبح الأفضل بهذا؟
Dialogue: 0,0:14:12.29,0:14:13.78,Default,,0,0,0,,!اصمت
Dialogue: 0,0:14:13.78,0:14:16.99,Default,,0,0,0,,!أساليبك المعتادة قذرة أيضًا
Dialogue: 0,0:14:22.57,0:14:23.72,Default,,0,0,0,,...لماذا، أنت
Dialogue: 0,0:14:34.92,0:14:36.15,Default,,0,0,0,,.هذه هي النهاية
Dialogue: 0,0:14:36.53,0:14:37.84,Default,,0,0,0,,!لنذهب
Dialogue: 0,0:14:39.30,0:14:41.69,Default,,0,0,0,,!استعد، موساشي
Dialogue: 0,0:14:53.04,0:14:54.16,Default,,0,0,0,,...ما
Dialogue: 0,0:14:56.96,0:14:58.88,Default,,0,0,0,,!الآن، موساشي
Dialogue: 0,0:15:05.88,0:15:09.05,Default,,0,0,0,,...كوجيرو، أنت
Dialogue: 0,0:15:10.48,0:15:13.49,Default,,0,0,0,,!يا له من أمر، لقد سار كل شيء بشكل جيد
Dialogue: 0,0:15:13.49,0:15:15.94,Default,,0,0,0,,.كما خططت
Dialogue: 0,0:15:15.94,0:15:17.27,Default,,0,0,0,,خططت؟
Dialogue: 0,0:15:17.68,0:15:20.70,Default,,0,0,0,,.لخداع عدوك، يجب أن تخدع صديقك أولاً
Dialogue: 0,0:15:20.70,0:15:22.40,Default,,0,0,0,,...هذا ما يقولونه
Dialogue: 0,0:15:23.86,0:15:26.36,Default,,0,0,0,,...حسنًا، دعنا نترك الأمر
Dialogue: 0,0:15:42.67,0:15:44.51,Default,,0,0,0,,!كاجيتورا
Dialogue: 0,0:15:46.97,0:15:50.43,Default,,0,0,0,,.الآن، حان وقت الاستسلام
Dialogue: 0,0:15:55.74,0:15:59.10,Default,,0,0,0,,!هذا مؤلم!، مؤلم!، مؤلم
Dialogue: 0,0:16:15.53,0:16:18.71,Default,,0,0,0,,!فانوسي الثمين
Dialogue: 0,0:16:23.19,0:16:27.67,Default,,0,0,0,,!أعيدوه، أيها الوحوش
Dialogue: 0,0:16:28.05,0:16:32.27,Default,,0,0,0,,!سأريكم حجم حماقتكم
Dialogue: 0,0:16:32.27,0:16:33.81,Default,,0,0,0,,!سيف الرعد بدون الكرة
Dialogue: 0,0:16:35.35,0:16:37.13,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:16:45.45,0:16:47.85,Default,,0,0,0,,!لقد نَجَونا
Dialogue: 0,0:16:49.27,0:16:51.11,Default,,0,0,0,,هل أنتم الثلاثة بخير؟
Dialogue: 0,0:16:52.70,0:16:55.78,Default,,0,0,0,,!كيف وصلتو إلى هنا؟
Dialogue: 0,0:16:55.78,0:17:00.46,Default,,0,0,0,,يايبا يستطيع التحدث بلغة الحيوانات قليلاً، أتذكر؟
Dialogue: 0,0:17:01.76,0:17:04.92,Default,,0,0,0,,،هذا الغوريلا كان يطاردنا
Dialogue: 0,0:17:05.26,0:17:08.97,Default,,0,0,0,,.لكننا اكتشفنا أنه كان يرغب في العودة إلى الغابة
Dialogue: 0,0:17:08.97,0:17:11.55,Default,,0,0,0,,،مقابل إخباره بمكانها
Dialogue: 0,0:17:11.55,0:17:15.72,Default,,0,0,0,,.أرشدنا إلى هذا المكان
Dialogue: 0,0:17:18.61,0:17:20.39,Default,,0,0,0,,.شكرًا لإرشادنا الطريق
Dialogue: 0,0:17:20.39,0:17:22.98,Default,,0,0,0,,.موطنك هناك
Dialogue: 0,0:17:31.66,0:17:34.91,Default,,0,0,0,,.عجباً... يبدو أنهم يقومون بعمل جيد
Dialogue: 0,0:17:36.02,0:17:37.85,Default,,0,0,0,,!هيا يا رجل العنكبوت
Dialogue: 0,0:17:37.85,0:17:40.07,Default,,0,0,0,,!حان وقت ظهور الملك السماوي الأخير
Dialogue: 0,0:17:40.07,0:17:41.12,Default,,0,0,0,,!حاضر
Dialogue: 0,0:18:07.19,0:18:09.78,Default,,0,0,0,,!لا يمكنني التوقف الآن
Dialogue: 0,0:18:14.05,0:18:18.32,Default,,0,0,0,,!بقي ملك سماوي واحد فقط! قطعة من الكعكة
Dialogue: 0,0:18:18.32,0:18:20.87,Default,,0,0,0,,.لا يزال لا يمكننا خفض حذرنا هنا
Dialogue: 0,0:18:20.87,0:18:24.27,Default,,0,0,0,,.قد يكون هناك فخ أو اثنين هنا أيضًا
Dialogue: 0,0:18:29.79,0:18:30.84,Default,,0,0,0,,!هذا سيء
Dialogue: 0,0:18:30.84,0:18:32.63,Default,,0,0,0,,!انسحبو
Dialogue: 0,0:18:36.66,0:18:38.46,Default,,0,0,0,,أسرعي سايكا؟
Dialogue: 0,0:18:38.46,0:18:41.11,Default,,0,0,0,,!قلت لكِ أسرعي
Dialogue: 0,0:18:42.72,0:18:44.56,Default,,0,0,0,,يايبا؟
Dialogue: 0,0:18:50.73,0:18:52.24,Default,,0,0,0,,!الكرة
Dialogue: 0,0:18:52.24,0:18:53.31,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:19:05.02,0:19:07.23,Default,,0,0,0,,!أنا أمزح
Dialogue: 0,0:19:08.09,0:19:10.01,Default,,0,0,0,,!يايبا ايها الغبي! غبي، غبي، غبي
Dialogue: 0,0:19:10.01,0:19:13.44,Default,,0,0,0,,!أيها الحمقى، هذا ليس وقتًا لمثل هذه الألعاب
Dialogue: 0,0:19:14.63,0:19:15.72,Default,,0,0,0,,ما كان ذلك؟
Dialogue: 0,0:19:20.85,0:19:21.75,Default,,0,0,0,,...س
Dialogue: 0,0:19:21.75,0:19:24.17,Default,,0,0,0,,سلحفاة... عملاقة؟
Dialogue: 0,0:19:28.66,0:19:31.48,Default,,0,0,0,,،أنا آخر الملوك السماويين الأربعة لأونيمارو
Dialogue: 0,0:19:32.96,0:19:36.42,Default,,0,0,0,,!سلحفاة أوروبا
Dialogue: 0,0:19:37.46,0:19:39.97,Default,,0,0,0,,!لا تعبث معي أيها الرجل العنكبوت
Dialogue: 0,0:19:44.18,0:19:45.83,Default,,0,0,0,,!ها نحن ذا، يايبا
Dialogue: 0,0:19:45.83,0:19:49.37,Default,,0,0,0,,!سلحفاة أوروبا لديها قوة 5,000,000 حصان
Dialogue: 0,0:19:50.69,0:19:53.03,Default,,0,0,0,,!لا تستهين بها
Dialogue: 0,0:19:53.76,0:19:57.54,Default,,0,0,0,,!التقنية النهائية: السلحفاة الدوارة
Dialogue: 0,0:19:59.99,0:20:02.48,Default,,0,0,0,,!ا-اهربوا
Dialogue: 0,0:20:09.76,0:20:11.21,Default,,0,0,0,,!إلى السطح
Dialogue: 0,0:20:14.14,0:20:16.78,Default,,0,0,0,,أين ذهب؟
Dialogue: 0,0:20:18.01,0:20:19.81,Default,,0,0,0,,!هنا في الأعلى
Dialogue: 0,0:20:19.81,0:20:21.74,Default,,0,0,0,,!هذه نهايتك
Dialogue: 0,0:20:22.26,0:20:23.66,Default,,0,0,0,,!يايبا
Dialogue: 0,0:20:23.66,0:20:25.33,Default,,0,0,0,,!امسك بهذا، يايبا
Dialogue: 0,0:20:29.18,0:20:30.46,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:20:31.75,0:20:34.46,Default,,0,0,0,,...كان ذلك وشيكًا
Dialogue: 0,0:20:34.46,0:20:37.72,Default,,0,0,0,,...سيف الرعد كاد أن يُدمر
Dialogue: 0,0:20:38.99,0:20:42.45,Default,,0,0,0,,! لا يمكنك النهوض الآن
Dialogue: 0,0:20:42.45,0:20:44.06,Default,,0,0,0,,...حان وقت هزيمتك
Dialogue: 0,0:20:44.06,0:20:46.10,Default,,0,0,0,,!لم أنتهِ بعد
Dialogue: 0,0:20:46.67,0:20:48.50,Default,,0,0,0,,!تحول
Dialogue: 0,0:20:56.05,0:20:59.82,Default,,0,0,0,,!هذا هو الشكل النهائي لسلحفاة أوروبا
Dialogue: 0,0:21:00.49,0:21:02.80,Default,,0,0,0,,!كبايزنجر زد
Dialogue: 0,0:21:03.81,0:21:07.37,Default,,0,0,0,,!سأحطمك الآن! استعد
Dialogue: 0,0:21:10.88,0:21:12.79,Default,,0,0,0,,!هنا
Dialogue: 0,0:21:15.00,0:21:17.21,Default,,0,0,0,,!أيها الوغد الصغير
Dialogue: 0,0:21:24.19,0:21:28.43,Default,,0,0,0,,!ماذا فعلت للتو؟! لقد سقطت ولا يمكنني النهوض
Dialogue: 0,0:21:29.05,0:21:30.89,Default,,0,0,0,,!اصمت
Dialogue: 0,0:21:42.98,0:21:46.70,Default,,0,0,0,,!هذا ما تستحقه
Dialogue: 0,0:21:48.17,0:21:49.66,Default,,0,0,0,,.لقد وصلت أخيرًا
Dialogue: 0,0:21:50.73,0:21:52.62,Default,,0,0,0,,.كوروغاني يايبا
Dialogue: 0,0:21:53.04,0:21:53.84,Default,,0,0,0,,...أو
Dialogue: 0,0:21:55.10,0:21:58.05,Default,,0,0,0,,!أونيمارو
Dialogue: 0,0:22:01.73,0:22:03.39,Default,,0,0,0,,.لقد سئمت الانتظار
Dialogue: 0,0:22:19.79,0:22:27.35,Ending,,0,0,0,,.ضُربتُ ببرقٍ حلوٍ لاذع، وانشغلت تماماً
Dialogue: 0,0:22:27.54,0:22:35.33,Ending,,0,0,0,,تذوقت طعامك وانفجرتُ في الطريق
Dialogue: 0,0:22:35.95,0:22:39.83,Ending,,0,0,0,,ينبثق من أعماق قلبي شعور غامض، لم أعرفه من قبل
Dialogue: 0,0:22:39.90,0:22:43.87,Ending,,0,0,0,,كعكة اللحظة المنتظرة في كل احتفال مميز
Dialogue: 0,0:22:43.90,0:22:47.61,Ending,,0,0,0,,نظرنا إلى بعضنا البعض وقلنا "إنه لذيذ"
Dialogue: 0,0:22:47.69,0:22:50.88,Ending,,0,0,0,,."إنه لذيذ"، قلنا، ونحن ننظر إلى بعضنا البعض
Dialogue: 0,0:22:50.97,0:22:54.56,Ending,,0,0,0,,تلك الأيام التي تخطفك من الواقع بجمالها
Dialogue: 0,0:22:54.58,0:22:58.92,Ending,,0,0,0,,...أتمنى أن تدوم
Dialogue: 0,0:22:58.93,0:23:02.95,Ending,,0,0,0,,كأنه يتمنى، وكأنني أرجو
Dialogue: 0,0:23:02.94,0:23:06.54,Ending,,0,0,0,,أتذوقها واحدةً تلو الأخرى
Dialogue: 0,0:23:06.56,0:23:10.62,Ending,,0,0,0,,فوق أضواء الزينة
Dialogue: 0,0:23:10.64,0:23:14.52,Ending,,0,0,0,,ستقوم بتلوينه كما تشاء
Dialogue: 0,0:23:14.77,0:23:18.42,Ending,,0,0,0,,لا أحد يستطيع أن يفعل ذلك
Dialogue: 0,0:23:18.53,0:23:23.33,Ending,,0,0,0,,لا أستطيع مساعدته، لا أستطيع أن أتركه
Dialogue: 0,0:23:35.53,0:23:38.86,Default,,0,0,0,,!حان وقت المبارزة بين يايبا وأونيمارو أخيرًا
Dialogue: 0,0:23:39.33,0:23:41.40,Default,,0,0,0,,!لا تخسر أمامه
Dialogue: 0,0:23:41.40,0:23:42.98,Default,,0,0,0,,.اذهب و اهزمه، يايبا
Dialogue: 0,0:23:43.39,0:23:46.28,Default,,0,0,0,,.الحلقة القادمة: سيف الرعد ضد سيف الرياح
Dialogue: 0,0:23:46.50,0:23:50.50,Default,,0,0,0,,!سانتقم منك هذه المرة حتماً يا أونيمارو
Dialogue: 0,0:23:48.37,0:23:51.07,Top,,0,0,0,,!الحلقة 11: الحلقة القادمة: سيف الرعد ضد سيف الرياح أونيمارو
