Dialogue: 0,0:00:14.18,0:00:16.55,Default,,0,0,0,,!استحققت ذلك، يا أحمق
Dialogue: 0,0:00:16.64,0:00:20.47,Default,,0,0,0,,.لقد وصلت أخيرًا، كوروغاني يايبا
Dialogue: 0,0:00:20.56,0:00:23.77,Default,,0,0,0,,!أونيمارو
Dialogue: 0,0:00:25.73,0:00:27.56,Default,,0,0,0,,!ما أروع رؤيتك
Dialogue: 0,0:00:28.86,0:00:31.11,Default,,0,0,0,,.لقد حاصرناك
Dialogue: 0,0:00:31.19,0:00:33.03,Default,,0,0,0,,.هذه نهايتك
Dialogue: 0,0:00:34.86,0:00:36.36,Default,,0,0,0,,من أين أتوا؟
Dialogue: 0,0:00:36.45,0:00:39.53,Default,,0,0,0,,،إن إنهاء حياتك سيكون أمرًا سهلاً
Dialogue: 0,0:00:39.62,0:00:43.08,Default,,0,0,0,,.لكنه سيكون من العبث إهدار قوتك
Dialogue: 0,0:00:44.04,0:00:47.75,Default,,0,0,0,,لما لا نتحالف، كوروغاني يايبا؟
Dialogue: 0,0:00:49.04,0:00:51.84,Default,,0,0,0,,!لنحكم العالم معًا
Dialogue: 0,0:00:53.01,0:00:55.22,Default,,0,0,0,,حكم؟
Dialogue: 0,0:01:07.90,0:01:10.19,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:01:11.56,0:01:13.77,Opening,,0,0,0,,الإرادة للفوز هي شهادة على جديتي
Dialogue: 0,0:01:13.66,0:01:16.71,Opening,,0,0,0,,لكنك لن تصدق ذلك، أليس كذلك؟
Dialogue: 0,0:01:16.62,0:01:19.07,Opening,,0,0,0,,المنطق السليم يمكن أن يكون عبئًا
Dialogue: 0,0:01:19.06,0:01:21.84,Opening,,0,0,0,,أستطيع التحدي لأني جاهل
Dialogue: 0,0:01:21.85,0:01:22.99,Opening,,0,0,0,,"هل أنا "ساموراي حقيقي؟
Dialogue: 0,0:01:23.00,0:01:24.26,Opening,,0,0,0,,"أم مجرد "لاعب وقح؟
Dialogue: 0,0:01:24.26,0:01:26.92,Opening,,0,0,0,,علي أن أتحدى لأني أريد أن أعرف
Dialogue: 0,0:01:26.91,0:01:32.28,Opening,,0,0,0,,الشغف في قلبي كان ساطعًا مثل البرق
Dialogue: 0,0:01:32.74,0:01:37.46,Opening,,0,0,0,,بغض النظر عن مقدار تغيرك
Dialogue: 0,0:01:37.72,0:01:42.15,Opening,,0,0,0,,لا يوجد كذب في المعارك التي خضناها
Dialogue: 0,0:01:42.15,0:01:46.90,Opening,,0,0,0,,أنا أمضي قدمًا بالشجاعة لأعيش بسرعة وتهور
Dialogue: 0,0:01:46.89,0:01:52.84,Opening,,0,0,0,,لأصل إلى القوة الجديدة المثيرة
Dialogue: 0,0:01:54.22,0:01:59.00,Opening,,0,0,0,,لنرفع سيوفنا نحو الغد
Dialogue: 0,0:01:59.01,0:02:04.03,Opening,,0,0,0,,أيقظ القوة الطبية 
Dialogue: 0,0:02:04.03,0:02:08.80,Opening,,0,0,0,,الآن تهب علينا الأقدار المحترقة
Dialogue: 0,0:02:08.80,0:02:13.72,Opening,,0,0,0,,سأقطع علامات اليأس
Dialogue: 0,0:02:13.72,0:02:15.54,Opening,,0,0,0,,بهذا "السيف" الحقيقي
Dialogue: 0,0:02:26.02,0:02:30.94,Default,,0,0,0,,الحلقة 11: سيف الرعد ضد سيف الرياح 
Dialogue: 0,0:02:32.77,0:02:36.53,Default,,0,0,0,,!ننقل لكم البث المباشر من طائرتنا المروحية
Dialogue: 0,0:02:36.61,0:02:38.19,Default,,0,0,0,,!يا له من مشهد مذهل
Dialogue: 0,0:02:38.28,0:02:41.49,Default,,0,0,0,,!حشد من المؤيدين تجمع أمام قلعة أونيمارو
Dialogue: 0,0:02:41.57,0:02:42.41,Default,,0,0,0,,!يسقط أونيمارو
Dialogue: 0,0:02:42.49,0:02:46.29,Default,,0,0,0,,!لدعم الثمانية محاربين الذين تسللوا إلى الداخل
Dialogue: 0,0:02:47.33,0:02:52.21,Default,,0,0,0,,هل سيتمكن كوروغاني يايبا من هزيمة أونيمارو؟
Dialogue: 0,0:02:55.21,0:02:57.17,Default,,0,0,0,,!لا تستمع إليه، يايبا
Dialogue: 0,0:03:03.51,0:03:04.89,Default,,0,0,0,,.قوي جدًا
Dialogue: 0,0:03:05.47,0:03:06.47,Default,,0,0,0,,،إذن؟ إذا اتحدنا
Dialogue: 0,0:03:06.56,0:03:10.77,Default,,0,0,0,,.لن يكون هناك شيء مستحيل
Dialogue: 0,0:03:12.44,0:03:14.48,Default,,0,0,0,,هل يعني هذا أنني سآكل ما أريد؟
Dialogue: 0,0:03:16.07,0:03:19.32,Default,,0,0,0,,!كل شيء على وجه الأرض سيكون ملكك
Dialogue: 0,0:03:23.41,0:03:24.91,Default,,0,0,0,,!يبدو هذا رائعًا
Dialogue: 0,0:03:24.99,0:03:26.91,Default,,0,0,0,,...يايبا
Dialogue: 0,0:03:29.87,0:03:31.33,Default,,0,0,0,,!أنا أمزح
Dialogue: 0,0:03:36.67,0:03:38.09,Default,,0,0,0,,.أنا لست مثلك
Dialogue: 0,0:03:38.17,0:03:40.42,Default,,0,0,0,,!أنا أقاتل من أجل الحق
Dialogue: 0,0:03:41.38,0:03:44.09,Default,,0,0,0,,.يبدو أن الحمقى يبقون حمقى إلى الأبد
Dialogue: 0,0:03:47.06,0:03:49.10,Default,,0,0,0,,!استعدوا، جميعًا
Dialogue: 0,0:03:49.18,0:03:51.68,Default,,0,0,0,,!سنشق طريقنا إلى أونيمارو
Dialogue: 0,0:03:52.31,0:03:53.52,Default,,0,0,0,,!الآن، هاجموهم
Dialogue: 0,0:04:21.51,0:04:23.80,Default,,0,0,0,,!يايبا، لا!، لا تبتعد كثيرًا
Dialogue: 0,0:04:52.54,0:04:54.66,Default,,0,0,0,,.حيلك التافهة لن تنجح
Dialogue: 0,0:04:55.96,0:04:57.75,Default,,0,0,0,,...أنت مجرد مغرور
Dialogue: 0,0:05:01.13,0:05:02.80,Default,,0,0,0,,!لقد نلت منك
Dialogue: 0,0:05:03.46,0:05:06.88,Default,,0,0,0,,!يا أحمق! يا غبي! يا أخرق
Dialogue: 0,0:05:07.59,0:05:08.97,Default,,0,0,0,,!أيها الوغد
Dialogue: 0,0:05:11.14,0:05:12.72,Default,,0,0,0,,!اتركوني
Dialogue: 0,0:05:16.77,0:05:19.44,Default,,0,0,0,,!إنهم يريدون الاستيلاء على جوهرة سيف الرعد
Dialogue: 0,0:05:19.52,0:05:22.19,Default,,0,0,0,,!بسرعة، احموا ساياكا
Dialogue: 0,0:05:31.58,0:05:33.91,Default,,0,0,0,,!هجوم الزوبعة
Dialogue: 0,0:05:39.00,0:05:40.79,Default,,0,0,0,,!حركة سخيفة
Dialogue: 0,0:05:42.17,0:05:43.88,Default,,0,0,0,,وماذا عن هذا؟
Dialogue: 0,0:05:44.55,0:05:46.67,Default,,0,0,0,,!سيف الرعد بدون جوهرة
Dialogue: 0,0:05:48.22,0:05:49.64,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:06:00.52,0:06:02.77,Default,,0,0,0,,...ضربة البرق
Dialogue: 0,0:06:03.36,0:06:05.03,Default,,0,0,0,,...لا تؤثر فيه
Dialogue: 0,0:06:05.11,0:06:06.65,Default,,0,0,0,,.ليس لدينا خيار
Dialogue: 0,0:06:06.74,0:06:08.57,Default,,0,0,0,,!ساياكا!، الجوهرة
Dialogue: 0,0:06:08.65,0:06:09.61,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:06:15.66,0:06:16.87,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:06:23.38,0:06:24.92,Default,,0,0,0,,كوجيرو؟
Dialogue: 0,0:06:25.71,0:06:27.51,Default,,0,0,0,,...ايعقل أنك
Dialogue: 0,0:06:27.59,0:06:28.55,Default,,0,0,0,,!ايها الملك أونيمارو
Dialogue: 0,0:06:30.18,0:06:32.72,Default,,0,0,0,,لما لا تتحالف معي بدلاً من ذلك؟
Dialogue: 0,0:06:33.43,0:06:37.89,Default,,0,0,0,,!لا كما تعلم، لدي قوة مائة رجل
Dialogue: 0,0:06:37.98,0:06:39.48,Default,,0,0,0,,...وكهدية لك
Dialogue: 0,0:06:40.48,0:06:42.69,Default,,0,0,0,,.سأقدم لك جوهرة سيف الرعد
Dialogue: 0,0:06:42.77,0:06:44.77,Default,,0,0,0,,!كوجيرو، أيها النذل
Dialogue: 0,0:06:51.91,0:06:54.33,Default,,0,0,0,,!إذا حاولت خداعنا ستدفع الثمن
Dialogue: 0,0:06:58.96,0:07:00.96,Default,,0,0,0,,...أنت… لا تزال حيًا
Dialogue: 0,0:07:02.04,0:07:04.09,Default,,0,0,0,,!ايها الملك أونيمارو، لقد رأيت بنفسك
Dialogue: 0,0:07:04.92,0:07:09.80,Default,,0,0,0,,!هذا الوغد تظاهر بخيانته لهم ليتمكن من مهاجمتي
Dialogue: 0,0:07:09.88,0:07:12.05,Default,,0,0,0,,!لا! أنه مخطئ
Dialogue: 0,0:07:12.14,0:07:13.76,Default,,0,0,0,,!أنا أقول الحقيقة
Dialogue: 0,0:07:13.85,0:07:16.64,Default,,0,0,0,,!لا، لن ننخدع مرة أخرى
Dialogue: 0,0:07:16.72,0:07:19.31,Default,,0,0,0,,!انتظر! يجب أن تصدقني
Dialogue: 0,0:07:19.39,0:07:23.10,Default,,0,0,0,,. لقد وقع أخيرًا في شباك أكاذيبه
Dialogue: 0,0:07:23.19,0:07:24.31,Default,,0,0,0,,...ما هذا
Dialogue: 0,0:07:24.40,0:07:25.36,Default,,0,0,0,,!انت
Dialogue: 0,0:07:36.12,0:07:37.49,Default,,0,0,0,,!تبا
Dialogue: 0,0:07:45.21,0:07:47.34,Default,,0,0,0,,.أنت حقًا أحمق
Dialogue: 0,0:07:49.17,0:07:53.76,Default,,0,0,0,,،لقد حصلت على سيفك، لأنك كنت تسعى للقوة
Dialogue: 0,0:07:54.30,0:07:56.22,Default,,0,0,0,,.لكنك لا تستخدمه
Dialogue: 0,0:07:58.93,0:08:01.52,Default,,0,0,0,,،سأستخدم هذه القوة
Dialogue: 0,0:08:02.06,0:08:04.40,Default,,0,0,0,,!وسأحكم البشرية جمعاء
Dialogue: 0,0:08:05.73,0:08:07.06,Default,,0,0,0,,!ولكنك
Dialogue: 0,0:08:07.57,0:08:09.11,Default,,0,0,0,,.قد تمتلك القوة
Dialogue: 0,0:08:09.78,0:08:11.99,Default,,0,0,0,,...ولكنك هاوٍ وفاشل
Dialogue: 0,0:08:12.07,0:08:13.95,Default,,0,0,0,,!وهكذا ستموت
Dialogue: 0,0:08:14.03,0:08:15.41,Default,,0,0,0,,!اصمت
Dialogue: 0,0:08:16.57,0:08:19.41,Default,,0,0,0,,.بالتأكيد، لن أموت هنا
Dialogue: 0,0:08:20.24,0:08:23.66,Default,,0,0,0,,!سأصبح أعظم ساموراي في اليابان
Dialogue: 0,0:08:24.37,0:08:27.00,Default,,0,0,0,,!وأقسم أنني سأهزمك
Dialogue: 0,0:08:36.59,0:08:38.60,Default,,0,0,0,,...هذا سيء، إذا لم نفعل شيئًا
Dialogue: 0,0:08:39.31,0:08:40.81,Default,,0,0,0,,!يا كوجيرو
Dialogue: 0,0:08:40.89,0:08:43.48,Default,,0,0,0,,أتسمح له بأن يصبح الأعظم؟
Dialogue: 0,0:08:45.60,0:08:47.81,Default,,0,0,0,,!أمسكوه الآن
Dialogue: 0,0:08:55.53,0:08:57.16,Default,,0,0,0,,!ساياكا! الآن
Dialogue: 0,0:09:05.67,0:09:06.92,Default,,0,0,0,,.أنا أعرف أن يايبا يستطيع فعلها
Dialogue: 0,0:09:07.63,0:09:08.79,Default,,0,0,0,,!أنا متأكدة
Dialogue: 0,0:09:27.23,0:09:29.02,Default,,0,0,0,,أنت، تهزمني؟
Dialogue: 0,0:09:29.86,0:09:32.57,Default,,0,0,0,,ماذا يمكنك أن تفعل بدون جوهرتك؟
Dialogue: 0,0:09:35.03,0:09:36.32,Default,,0,0,0,,!هذه هي النهاية
Dialogue: 0,0:09:45.62,0:09:46.46,Default,,0,0,0,,!يايبا
Dialogue: 0,0:09:48.87,0:09:49.83,Default,,0,0,0,,!ساياكا
Dialogue: 0,0:09:50.38,0:09:51.92,Default,,0,0,0,,!فات الأوان
Dialogue: 0,0:09:54.51,0:09:57.26,Default,,0,0,0,,!يايبا
Dialogue: 0,0:10:01.93,0:10:03.93,Default,,0,0,0,,!لا تخسر
Dialogue: 0,0:10:22.03,0:10:24.54,Default,,0,0,0,,!هيا
Dialogue: 0,0:10:25.79,0:10:26.70,Default,,0,0,0,,...ماذا
Dialogue: 0,0:10:34.75,0:10:35.76,Default,,0,0,0,,!يايبا
Dialogue: 0,0:10:41.01,0:10:43.72,Default,,0,0,0,,!سأنهي هذا الآن، مرة واحدة وإلى الأبد
Dialogue: 0,0:10:46.68,0:10:48.23,Default,,0,0,0,,!أونيمارو
Dialogue: 0,0:10:55.23,0:10:57.61,Default,,0,0,0,,.من الصعب تصديق ذلك
Dialogue: 0,0:10:58.32,0:11:01.11,Default,,0,0,0,,مبارزة القرن بين أونيمارو الشيطان ويايبا المحارب
Dialogue: 0,0:11:01.20,0:11:03.53,Default,,0,0,0,,المواجهة الأسطورية على وشك أن تبدأ
Dialogue: 0,0:11:03.62,0:11:06.12,Default,,0,0,0,,!أمام أعيننا، أيها المشاهدون
Dialogue: 0,0:11:07.87,0:11:12.42,Default,,0,0,0,,لمن ستكون الغلبة؟
Dialogue: 0,0:11:30.98,0:11:33.48,Default,,0,0,0,,.أنت لا تعرف كيف تصيبني بعد
Dialogue: 0,0:11:34.65,0:11:37.61,Default,,0,0,0,,!تأكد... مع مرور الوقت، سأصيبك
Dialogue: 0,0:11:43.16,0:11:44.99,Default,,0,0,0,,أتريد اللعب بهذه الطريقة؟
Dialogue: 0,0:11:45.07,0:11:46.74,Default,,0,0,0,,!افعلها هكذا
Dialogue: 0,0:12:13.10,0:12:15.19,Default,,0,0,0,,!مذهل
Dialogue: 0,0:12:15.27,0:12:19.02,Default,,0,0,0,,!القوة الهائلة لسيف الرعد و سيف الرياح
Dialogue: 0,0:12:20.65,0:12:22.53,Default,,0,0,0,,!انتبهو
Dialogue: 0,0:12:26.41,0:12:29.20,Default,,0,0,0,,.ستدفعين ثمن منحه الجوهرة
Dialogue: 0,0:12:29.29,0:12:31.33,Default,,0,0,0,,!لن أكون رحيمًا بعد الآن
Dialogue: 0,0:12:34.08,0:12:36.58,Default,,0,0,0,,!في هذه الحالة، سأرد الجميل
Dialogue: 0,0:12:36.67,0:12:37.79,Default,,0,0,0,,.كوجيرو
Dialogue: 0,0:12:38.50,0:12:41.71,Default,,0,0,0,,!كفى! استعدو للموت
Dialogue: 0,0:12:41.80,0:12:44.30,Default,,0,0,0,,!انبساط!، يا عامود الغسيل
Dialogue: 0,0:12:52.73,0:12:54.69,Default,,0,0,0,,!سأسقط, التقطوني بسرعة
Dialogue: 0,0:12:54.77,0:12:56.31,Default,,0,0,0,,!بسرعة، امسكوني
Dialogue: 0,0:13:02.82,0:13:03.78,Default,,0,0,0,,!لا
Dialogue: 0,0:13:07.03,0:13:09.87,Default,,0,0,0,,!أنتم قساة جدًا
Dialogue: 0,0:13:17.42,0:13:19.88,Default,,0,0,0,,.الوحيد المتبقي هو أونيمارو
Dialogue: 0,0:13:19.96,0:13:23.80,Default,,0,0,0,,!كل شيء يعتمد على يايبا
Dialogue: 0,0:13:28.51,0:13:30.43,Default,,0,0,0,,!خذ هذا
Dialogue: 0,0:13:37.06,0:13:38.23,Default,,0,0,0,,هكذا؟
Dialogue: 0,0:13:43.32,0:13:44.24,Default,,0,0,0,,!هذا عديم الفائدة
Dialogue: 0,0:13:45.95,0:13:47.61,Default,,0,0,0,,!اختف عن وجهي
Dialogue: 0,0:13:50.03,0:13:51.03,Default,,0,0,0,,!يايبا
Dialogue: 0,0:14:03.25,0:14:04.46,Default,,0,0,0,,...هل كان هذا
Dialogue: 0,0:14:06.42,0:14:08.13,Default,,0,0,0,,!التدريب يؤتي ثماره
Dialogue: 0,0:14:22.52,0:14:23.48,Default,,0,0,0,,...أليس هذا
Dialogue: 0,0:14:24.40,0:14:26.53,Default,,0,0,0,,.لا تخف، وتقدم
Dialogue: 0,0:15:55.99,0:15:58.74,Default,,0,0,0,,!لو كنت فقط انضممت إلي
Dialogue: 0,0:15:58.83,0:16:04.00,Default,,0,0,0,,ولماذا أتحالف مع الوغد الذي باع روحه لحاكم الريح ليصبح شيطانًا؟
Dialogue: 0,0:16:04.08,0:16:06.50,Default,,0,0,0,,!توقف هذا الهراء
Dialogue: 0,0:16:07.21,0:16:09.42,Default,,0,0,0,,!لقد جعلت حاكم الريح حليفي
Dialogue: 0,0:16:34.66,0:16:37.45,Default,,0,0,0,,.ضربتي القادمة ستنهيك للأبد
Dialogue: 0,0:16:39.41,0:16:41.20,Default,,0,0,0,,!تبًا
Dialogue: 0,0:16:46.38,0:16:50.55,Default,,0,0,0,,!لدي فرصة واحدة… أخيرة
Dialogue: 0,0:16:57.30,0:16:58.76,Default,,0,0,0,,!موجة الرياح
Dialogue: 0,0:17:01.39,0:17:04.94,Default,,0,0,0,,!سيف الرعد مع الجوهرة
Dialogue: 0,0:17:10.36,0:17:13.74,Default,,0,0,0,,!ضربة البرق
Dialogue: 0,0:18:24.14,0:18:26.52,Default,,0,0,0,,...الجوهرة
Dialogue: 0,0:18:31.06,0:18:33.32,Default,,0,0,0,,.لقد سئمت من هذا
Dialogue: 0,0:18:43.12,0:18:44.24,Default,,0,0,0,,...هذا مؤلم
Dialogue: 0,0:18:45.24,0:18:46.41,Default,,0,0,0,,!إنه يوم حظي
Dialogue: 0,0:18:48.16,0:18:49.83,Default,,0,0,0,,!أعده لي
Dialogue: 0,0:18:49.92,0:18:51.04,Default,,0,0,0,,!إلى اللقاء
Dialogue: 0,0:18:55.67,0:18:56.67,Default,,0,0,0,,.انتظر!
Dialogue: 0,0:18:57.38,0:19:00.47,Default,,0,0,0,,...من كان ليظن أنك ستتقدم لدرجة كسر سيفي
Dialogue: 0,0:19:03.76,0:19:04.97,Default,,0,0,0,,!تبا
Dialogue: 0,0:19:05.68,0:19:07.39,Default,,0,0,0,,!تعال هنا
Dialogue: 0,0:19:13.77,0:19:14.82,Default,,0,0,0,,ما الذي يحدث؟
Dialogue: 0,0:19:22.28,0:19:23.32,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:19:59.07,0:20:01.36,Default,,0,0,0,,،للأسف، يجب أن أؤجل مبارزتنا
Dialogue: 0,0:20:01.45,0:20:02.78,Default,,0,0,0,,!كوروغاني يايبا
Dialogue: 0,0:20:02.86,0:20:04.16,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:20:12.87,0:20:15.29,Default,,0,0,0,,!تبا! شونوسوكي
Dialogue: 0,0:20:18.84,0:20:21.72,Default,,0,0,0,,!انعطاف بزاوية 180 درجة! أقصى سرعة
Dialogue: 0,0:20:30.89,0:20:34.44,Default,,0,0,0,,!أيها الوغد أونيمارو
Dialogue: 0,0:20:41.32,0:20:44.91,Default,,0,0,0,,!أونيمارو يهرب! لقد نجح
Dialogue: 0,0:20:45.49,0:20:48.95,Default,,0,0,0,,!لقد نجونا! كوروغاني يايبا هزم الشيطان
Dialogue: 0,0:20:49.03,0:20:50.37,Default,,0,0,0,,يايبا
Dialogue: 0,0:20:52.08,0:20:53.83,Default,,0,0,0,,!يايبا
Dialogue: 0,0:20:57.92,0:20:59.67,Default,,0,0,0,,يا رفاق! هل أنتم بخير؟
Dialogue: 0,0:20:59.75,0:21:01.34,Default,,0,0,0,,.عمل رائع
Dialogue: 0,0:21:01.42,0:21:04.42,Default,,0,0,0,,.التدريب معك كان يستحق الجهد
Dialogue: 0,0:21:04.51,0:21:09.05,Default,,0,0,0,,...هذا ما يقوله الخائن الذي حاول التواطؤ من الملك أونيمارو
Dialogue: 0,0:21:09.14,0:21:10.31,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:21:10.39,0:21:12.85,Default,,0,0,0,,!هراء! لقد كانت خدعة
Dialogue: 0,0:21:12.93,0:21:15.73,Default,,0,0,0,,حقاً؟ -\N.نعم -
Dialogue: 0,0:21:20.98,0:21:23.07,Default,,0,0,0,,...في المرة القادمة التي نلتقي فيها
Dialogue: 0,0:21:23.99,0:21:27.78,Default,,0,0,0,,.سيكون آخر يوم في حياتك، أونيمارو
Dialogue: 0,0:21:45.79,0:21:53.35,Ending,,0,0,0,,ضُربتُ ببرقٍ حلوٍ لاذع، وانشغلت تماماً، يا "أومي"
Dialogue: 0,0:21:53.54,0:22:01.33,Ending,,0,0,0,,تذوقت طعامك وانفجرتُ في الطريق
Dialogue: 0,0:22:01.95,0:22:05.83,Ending,,0,0,0,,ينبثق من أعماق قلبي شعور غامض، لم أعرفه من قبل
Dialogue: 0,0:22:05.90,0:22:09.87,Ending,,0,0,0,,كعكة اللحظة المنتظرة في كل احتفال مميز
Dialogue: 0,0:22:09.90,0:22:13.61,Ending,,0,0,0,,نظرنا إلى بعضنا البعض وقلنا "إنه لذيذ"
Dialogue: 0,0:22:13.69,0:22:16.88,Ending,,0,0,0,,"إنه لذيذ"، قلنا، ونحن ننظر إلى بعضنا البعض.
Dialogue: 0,0:22:16.97,0:22:20.56,Ending,,0,0,0,,تلك الأيام التي تخطفك من الواقع بجمالها
Dialogue: 0,0:22:20.58,0:22:24.92,Ending,,0,0,0,,...أتمنى أن تدوم
Dialogue: 0,0:22:24.93,0:22:28.95,Ending,,0,0,0,,كأنه يتمنى، وكأنني أرجو
Dialogue: 0,0:22:28.94,0:22:32.54,Ending,,0,0,0,,أتذوقها واحدةً تلو الأخرى
Dialogue: 0,0:22:32.56,0:22:36.62,Ending,,0,0,0,,فوق أضواء الزينة
Dialogue: 0,0:22:36.64,0:22:40.52,Ending,,0,0,0,,ستقوم بتلوينه كما تشاء
Dialogue: 0,0:22:40.77,0:22:44.42,Ending,,0,0,0,,لا أحد يستطيع أن يفعل ذلك
Dialogue: 0,0:22:44.53,0:22:49.33,Ending,,0,0,0,,لا أستطيع مساعدته، لا أستطيع أن أتركه
Dialogue: 0,0:23:10.13,0:23:12.30,Default,,0,0,0,,...بوجود هذه الجوهرة في حوزتي
Dialogue: 0,0:23:14.93,0:23:15.81,Default,,0,0,0,,!اسمعوا
Dialogue: 0,0:23:16.64,0:23:19.31,Default,,0,0,0,,.حان الوقت لاستكمال القلعة السماوية
Dialogue: 0,0:23:19.39,0:23:21.94,Default,,0,0,0,,!استعدوا للسيطرة على العالم
Dialogue: 0,0:23:22.02,0:23:23.02,Default,,0,0,0,,!نعم
Dialogue: 0,0:23:24.94,0:23:26.82,Default,,0,0,0,,.لا راحة للأشرار
Dialogue: 0,0:23:36.58,0:23:41.00,Default,,0,0,0,,!ماذا؟ أحدهم يتحدى الدوجو؟، ويبحث عن يايبا
Dialogue: 0,0:23:41.67,0:23:45.00,Default,,0,0,0,,!أشعر بالإحباط
Dialogue: 0,0:23:45.09,0:23:47.59,Default,,0,0,0,,".في الحلقة القادمة، "ناديشيكو ياماتو تصل
Dialogue: 0,0:23:47.00,0:23:51.50,Top,,0,0,0,,الحلقة 12: ناديشيكو ياماتو تصل
Dialogue: 0,0:23:47.67,0:23:50.13,Default,,0,0,0,,!إنها رائعة
