Dialogue: 0,0:00:00.00,0:00:08.00,Default2,,0,0,0,,{\fs70\pos(960,60)\an5}لا تنسوا الدعاء لإخوانكم في فلسطين والسودان وفي سائر بلاد المسلمين
Dialogue: 0,0:00:01.00,0:00:08.00,DCRights,,0,0,0,,{\fs70\pos(20,25)} ABOODY SUBS | ترجمة \NTelegram : ABOODY-SUBS\NX : @ABOODY_SUBS
Dialogue: 0,0:00:01.63,0:00:04.13,Default,,0,0,0,,،باحثًا عن السيف الأسطوري، مونوهوشيزاو
Dialogue: 0,0:00:04.21,0:00:06.63,Default,,0,0,0,,.يصل يايبا ورفاقه إلى جزيرة جانريو
Dialogue: 0,0:00:07.26,0:00:11.81,Default,,0,0,0,,.في انتظارهم هناك، كان الساموراي الشهير، ساساكي كوجيرو الذي عاد إلى الحياة
Dialogue: 0,0:00:12.97,0:00:16.97,Default,,0,0,0,,تندلع المعركة مع يايبا الذي بالكاد ينجو من الموت
Dialogue: 0,0:00:17.06,0:00:21.94,Default,,0,0,0,,،حينها يسقط داخل بوابة زمنية فتحها السيد العنكبوت
Dialogue: 0,0:00:22.02,0:00:26.48,Default,,0,0,0,,.في لحظات قبل أن يطلق كوجيرو هجومه القاتل تسوباميغايشي
Dialogue: 0,0:00:27.44,0:00:31.65,Default,,0,0,0,,،يتضح أن يايبا سافر 400 سنة إلى الماضي
Dialogue: 0,0:00:32.45,0:00:38.29,Default,,0,0,0,,.قبل أيام قليلة من المبارزة الأسطورية في جزيرة جانريو
Dialogue: 0,0:00:39.96,0:00:41.71,Default,,0,0,0,,،إذا كان التاريخ يمكن أن يتكرر
Dialogue: 0,0:00:41.79,0:00:44.54,Default,,0,0,0,,فالبوابة يجب أن تفتح مرة أخرى
Dialogue: 0,0:00:44.63,0:00:49.14,Default,,0,0,0,,.عند لحظة هزيمة كوجيرو
Dialogue: 0,0:00:50.18,0:00:53.06,Default,,0,0,0,,.لتعزيز فرصهم
Dialogue: 0,0:00:53.14,0:00:56.89,Default,,0,0,0,,،يتدرب يايبا وموساشي الشاب استعدادًا للمبارزة القادمة
Dialogue: 0,0:00:57.81,0:00:59.73,Default,,0,0,0,,،لكن في ليلة المعركة
Dialogue: 0,0:00:59.81,0:01:02.19,Default,,0,0,0,,تنقلب الموازين عند أول كلمة طائشة من يايبا
Dialogue: 0,0:01:02.27,0:01:05.40,Default,,0,0,0,,.مهددًا بتغيير التاريخ
Dialogue: 0,0:01:15.99,0:01:19.33,Default,,0,0,0,,يايبا… أين أنت؟
Dialogue: 0,0:01:20.04,0:01:21.83,Default,,0,0,0,,...بهذه الحالة
Dialogue: 0,0:01:30.42,0:01:32.88,Default,,0,0,0,,!تمدد يا سيف مونوهوشيزاو
Dialogue: 0,0:01:34.80,0:01:35.84,Default,,0,0,0,,!سحقاً
Dialogue: 0,0:01:35.93,0:01:37.01,Default,,0,0,0,,!موساشي
Dialogue: 0,0:01:40.06,0:01:42.02,Default,,0,0,0,,!انتهى أمرك يا موساشي
Dialogue: 0,0:01:43.27,0:01:44.77,Default,,0,0,0,,!تهيّأ لنهايتك
Dialogue: 0,0:01:58.08,0:01:59.29,Default,,0,0,0,,...تبا 
Dialogue: 0,0:02:14.84,0:02:17.09,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:02:18.76,0:02:20.97,Opening,,0,0,0,,الإرادة للفوز هي شهادة على جديتي
Dialogue: 0,0:02:20.96,0:02:23.91,Opening,,0,0,0,,لكنك لن تصدق ذلك، أليس كذلك؟
Dialogue: 0,0:02:23.92,0:02:26.27,Opening,,0,0,0,,المنطق السليم يمكن أن يكون عبئًا
Dialogue: 0,0:02:26.26,0:02:29.04,Opening,,0,0,0,,أستطيع التحدي لأني جاهل
Dialogue: 0,0:02:29.05,0:02:30.19,Opening,,0,0,0,,هل أنا "ساموراي حقيقي"؟
Dialogue: 0,0:02:30.20,0:02:31.46,Opening,,0,0,0,,أم مجرد "لاعب وقح"؟
Dialogue: 0,0:02:31.46,0:02:34.12,Opening,,0,0,0,,علي أن أتحدى لأني أريد أن أعرف
Dialogue: 0,0:02:34.11,0:02:39.48,Opening,,0,0,0,,الشغف في قلبي كان ساطعًا مثل البرق
Dialogue: 0,0:02:39.94,0:02:44.66,Opening,,0,0,0,,بغض النظر عن مقدار تغيرك
Dialogue: 0,0:02:44.92,0:02:49.35,Opening,,0,0,0,,لا يوجد كذب في المعارك التي خضناها
Dialogue: 0,0:02:49.35,0:02:54.10,Opening,,0,0,0,,أنا أمضي قدمًا بالشجاعة لأعيش بسرعة وتهور
Dialogue: 0,0:02:54.09,0:03:00.04,Opening,,0,0,0,,لأصل إلى القوة الجديدة المثيرة
Dialogue: 0,0:03:01.42,0:03:06.20,Opening,,0,0,0,,لنرفع سيوفنا نحو الغد
Dialogue: 0,0:03:06.21,0:03:11.23,Opening,,0,0,0,,أيقظ القوة الطبية 
Dialogue: 0,0:03:11.23,0:03:16.00,Opening,,0,0,0,,الآن تهب علينا الأقدار المحترقة
Dialogue: 0,0:03:16.00,0:03:20.92,Opening,,0,0,0,,سأقطع علامات اليأس
Dialogue: 0,0:03:20.92,0:03:22.74,Opening,,0,0,0,,بهذا "السيف" الحقيقي
Dialogue: 0,0:03:33.71,0:03:35.42,Default,,0,0,0,,...يا موساشي
Dialogue: 0,0:03:35.51,0:03:39.56,Default,,0,0,0,,أحقًا لن تحاول التأخير في مبارزة الغد؟
Dialogue: 0,0:03:40.51,0:03:44.89,Default,,0,0,0,,!يكفي! سأتنازل عن النوم لأغادر مع شروق الشمس
Dialogue: 0,0:03:56.03,0:03:57.49,Default,,0,0,0,,لقد اختفى؟
Dialogue: 0,0:03:57.57,0:04:00.03,Default,,0,0,0,,!يايبا! نحن في مشكلة كبيرة
Dialogue: 0,0:04:00.11,0:04:01.53,Default,,0,0,0,,...كتاب موساشي
Dialogue: 0,0:04:02.08,0:04:05.00,Default,,0,0,0,,"موساشي، النصر بعيد عنك"؟
Dialogue: 0,0:04:06.29,0:04:11.38,Default,,0,0,0,,.صحيح… بسبب ثرثرتي، بات التاريخ مشوشًا
Dialogue: 0,0:04:11.46,0:04:13.92,Default,,0,0,0,,...أعطاني موساشي سيف الرعد
Dialogue: 0,0:04:14.00,0:04:16.63,Default,,0,0,0,,...إذا خسر، فلن أحصل عليه أبدًا. إذن
Dialogue: 0,0:04:17.30,0:04:21.26,Default,,0,0,0,,.لن أمتلك سيف الرعد، وسيقتلني أونيمارو
Dialogue: 0,0:04:22.05,0:04:23.34,Default,,0,0,0,,!يايبا
Dialogue: 0,0:04:23.43,0:04:25.43,Default,,0,0,0,,!أنت تختفي
Dialogue: 0,0:04:25.52,0:04:28.31,Default,,0,0,0,,!ماذا؟ لا بد أنها مزحة سخيفة
Dialogue: 0,0:04:28.39,0:04:29.31,Default,,0,0,0,,...ما هذا
Dialogue: 0,0:04:30.73,0:04:33.57,Default,,0,0,0,,.أتعلم، النوم مفتاح الصحة
Dialogue: 0,0:04:33.65,0:04:35.32,Default,,0,0,0,,!عليك أن تنام جيدًا
Dialogue: 0,0:04:35.40,0:04:37.32,Default,,0,0,0,,.أؤكد لك أن هذا لا يهم
Dialogue: 0,0:04:37.40,0:04:40.32,Default,,0,0,0,,!هيا، سنأكل، سنستمتع، وسننام مثل الأطفال
Dialogue: 0,0:04:40.41,0:04:41.95,Default,,0,0,0,,.ليس لدي أي نية للنوم
Dialogue: 0,0:04:42.03,0:04:45.37,Default,,0,0,0,,.سيكون ممتعًا. سأخبرك كل شيء عن المستقبل
Dialogue: 0,0:04:45.45,0:04:46.66,Default,,0,0,0,,!لست مهتمًا
Dialogue: 0,0:04:46.74,0:04:47.62,Default,,0,0,0,,...حسنًا إذن
Dialogue: 0,0:04:47.70,0:04:50.37,Default,,0,0,0,,أخبرنا، كيف هو المستقبل؟
Dialogue: 0,0:04:52.63,0:04:53.55,Default,,0,0,0,,...حسنًا
Dialogue: 0,0:04:54.71,0:04:58.88,Default,,0,0,0,,!المستقبل مليء بالفتيات الجميلات اللواتي يرتدين تنانير قصيرة هكذا، موساشي
Dialogue: 0,0:04:58.97,0:05:00.26,Default,,0,0,0,,!سيد يايبا
Dialogue: 0,0:05:02.84,0:05:04.59,Default,,0,0,0,,.لقد جذبت انتباهي
Dialogue: 0,0:05:04.68,0:05:06.31,Default,,0,0,0,,.حسناً 
Dialogue: 0,0:05:10.48,0:05:12.15,Default,,0,0,0,,!حسناً! حسناً
Dialogue: 0,0:05:12.94,0:05:15.82,Default,,0,0,0,,!لم أكن لأتخيل أن المستقبل سيكون بهذا السحر
Dialogue: 0,0:05:15.90,0:05:17.74,Default,,0,0,0,,!نعم، إنه ساحر
Dialogue: 0,0:05:18.99,0:05:20.95,Default,,0,0,0,,!هذا مذهل، مذهل
Dialogue: 0,0:05:24.28,0:05:26.91,Default,,0,0,0,,.الحمد لله أنني عدت إلى طبيعتي
Dialogue: 0,0:05:27.54,0:05:29.63,Default,,0,0,0,,.الكتاب يعود أيضًا
Dialogue: 0,0:05:29.70,0:05:30.91,Default,,0,0,0,,...و
Dialogue: 0,0:05:31.50,0:05:34.59,Default,,0,0,0,,.أخبرني المزيد، سيد يايبا
Dialogue: 0,0:05:38.63,0:05:39.55,Default,,0,0,0,,.لقد نام
Dialogue: 0,0:05:40.09,0:05:42.97,Default,,0,0,0,,.نعم! غدًا سيكون يومًا مثاليًا
Dialogue: 0,0:05:43.05,0:05:45.84,Default,,0,0,0,,.لا، غدًا لن تكون هناك مبارزة
Dialogue: 0,0:05:45.93,0:05:47.22,Default,,0,0,0,,لماذا لا؟
Dialogue: 0,0:05:47.31,0:05:49.23,Default,,0,0,0,,،عندما يشرب السيد موساشي
Dialogue: 0,0:05:49.31,0:05:53.27,Default,,0,0,0,,.يجب أن تحدث معجزة لمنعه من النوم طوال اليوم
Dialogue: 0,0:05:54.06,0:05:56.27,Default,,0,0,0,,ماذا؟ لن يستيقظ؟
Dialogue: 0,0:05:56.36,0:05:58.74,Default,,0,0,0,,.لكن غدًا هو اليوم الكبير
Dialogue: 0,0:05:59.28,0:06:02.58,Default,,0,0,0,,ماذا علي أن أفعل الآن؟
Dialogue: 0,0:06:23.63,0:06:24.84,Default,,0,0,0,,!لقد تأخر
Dialogue: 0,0:06:25.51,0:06:28.47,Default,,0,0,0,,!تأخر! تأخر! تأخر
Dialogue: 0,0:06:29.06,0:06:31.06,Default,,0,0,0,,!لقد تأخر
Dialogue: 0,0:06:31.14,0:06:35.27,Default,,0,0,0,,!تبا لك موساشي! أيها الجبان
Dialogue: 0,0:06:35.35,0:06:38.27,Default,,0,0,0,,.إنه بالتأكيد يختبر حظه
Dialogue: 0,0:06:38.82,0:06:41.53,Default,,0,0,0,,.ربما حدث له شيء
Dialogue: 0,0:06:42.03,0:06:44.95,Default,,0,0,0,,أو ربما وصل إلى مكان آخر؟
Dialogue: 0,0:06:45.03,0:06:48.03,Default,,0,0,0,,هل تتخيل لو كان لا يزال نائمًا؟
Dialogue: 0,0:06:58.84,0:07:01.63,Default,,0,0,0,,كوجيرو، ماذا تفعل؟
Dialogue: 0,0:07:03.59,0:07:06.68,Default,,0,0,0,,!تمدد يا سيف مونوهوشيزاو
Dialogue: 0,0:07:06.76,0:07:09.30,Default,,0,0,0,,!تمدد! تمدد! تمدد
Dialogue: 0,0:07:13.52,0:07:17.61,Default,,0,0,0,,!استيقظ! افتح عينيك! موساشي
Dialogue: 0,0:07:18.40,0:07:21.53,Default,,0,0,0,,!تبا! إنه نائم بعمق
Dialogue: 0,0:07:30.07,0:07:31.03,Default,,0,0,0,,...لا
Dialogue: 0,0:07:31.78,0:07:35.03,Default,,0,0,0,,!تبا، لا يمكنك أن تخسر هذه المبارزة
Dialogue: 0,0:07:35.58,0:07:37.67,Default,,0,0,0,,.انت!، قلت لك استيقظ
Dialogue: 0,0:07:37.75,0:07:42.21,Default,,0,0,0,,!إذا لم تفز… لن أتمكن من العودة إلى عالمي أبدًا
Dialogue: 0,0:07:43.00,0:07:45.59,Default,,0,0,0,,...لا أعتقد أنه سيستيقظ
Dialogue: 0,0:07:46.17,0:07:48.38,Default,,0,0,0,,ماذا سنفعل؟
Dialogue: 0,0:07:49.68,0:07:54.44,Default,,0,0,0,,.مرارًا وتكرارًا، أخبرني موساشي عن المبارزة في جزيرة جانريو
Dialogue: 0,0:07:54.52,0:07:57.69,Default,,0,0,0,,...كل شيء في هذا الكتاب. مما يعني
Dialogue: 0,0:07:59.52,0:08:00.73,Default,,0,0,0,,.أعتقد أنني فهمت
Dialogue: 0,0:08:01.27,0:08:02.81,Default,,0,0,0,,...الأمر يعتمد علي
Dialogue: 0,0:08:03.52,0:08:05.77,Default,,0,0,0,,!للتأكد من تكرار التاريخ
Dialogue: 0,0:08:15.54,0:08:16.67,Default,,0,0,0,,!كوجيرو
Dialogue: 0,0:08:20.17,0:08:23.09,Default,,0,0,0,,!أخيرًا قررت الظهور، موساشي
Dialogue: 0,0:08:27.17,0:08:29.34,Default,,0,0,0,,.هناك شيء مختلف فيك
Dialogue: 0,0:08:29.88,0:08:32.30,Default,,0,0,0,,...أنت تتخيل هذا
Dialogue: 0,0:08:32.39,0:08:36.77,Default,,0,0,0,,أتعتقد أنك تستطيع هزيمته بهذه الأرجل الخشبية؟
Dialogue: 0,0:08:36.85,0:08:37.77,Default,,0,0,0,,...نعم
Dialogue: 0,0:08:37.85,0:08:40.52,Default,,0,0,0,,.كل ما علي فعله هو اتباع ما قاله موساشي
Dialogue: 0,0:08:40.60,0:08:45.40,Default,,0,0,0,,.انظر. كوجيرو غاضب جدًا، تمامًا كما قال موساشي
Dialogue: 0,0:08:45.48,0:08:47.77,Default,,0,0,0,,عم تتمتم؟
Dialogue: 0,0:08:47.86,0:08:49.28,Default,,0,0,0,,!لا تتباطأ. لنبدأ
Dialogue: 0,0:08:50.45,0:08:51.70,Default,,0,0,0,,!ها أنا قادم
Dialogue: 0,0:08:52.53,0:08:54.20,Default,,0,0,0,,.لقد كانت مجرد لحظة
Dialogue: 0,0:08:54.28,0:08:58.41,Default,,0,0,0,,،بدأ بهجومه المميز تسوباميغايشي
Dialogue: 0,0:08:58.50,0:09:03.38,Default,,0,0,0,,!لكن بسرعة، صديت، ثم أطلقت الضربة القاضية
Dialogue: 0,0:09:04.42,0:09:05.26,Default,,0,0,0,,!هذا هو
Dialogue: 0,0:09:06.21,0:09:07.46,Default,,0,0,0,,!تسوباميغايشي
Dialogue: 0,0:09:10.76,0:09:12.80,Default,,0,0,0,,.أقدم للأمام، تاركًا الخوف ورائي
Dialogue: 0,0:09:17.81,0:09:18.89,Default,,0,0,0,,!تبًا
Dialogue: 0,0:09:21.52,0:09:23.69,Default,,0,0,0,,!تمدد يا سيف مونوهوشيزاو
Dialogue: 0,0:09:26.15,0:09:27.44,Default,,0,0,0,,!يا ويلي
Dialogue: 0,0:09:45.67,0:09:46.50,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:09:48.38,0:09:49.21,Default,,0,0,0,,!تهيّأ لنهايتك
Dialogue: 0,0:09:50.88,0:09:51.88,Default,,0,0,0,,!يا ويلي
Dialogue: 0,0:10:01.10,0:10:02.06,Default,,0,0,0,,!موساشي
Dialogue: 0,0:10:04.40,0:10:06.74,Default,,0,0,0,,.إذن لم تنم طوال اليوم، بعد كل شيء
Dialogue: 0,0:10:06.81,0:10:10.02,Default,,0,0,0,,.طاقتك العنيدة والمثابرة أبقتني متوترًا
Dialogue: 0,0:10:10.11,0:10:13.20,Default,,0,0,0,,.بفضلك، استيقظت
Dialogue: 0,0:10:14.28,0:10:16.45,Default,,0,0,0,,موساشي، هناك اثنان منك؟
Dialogue: 0,0:10:16.53,0:10:17.41,Default,,0,0,0,,!أحمق
Dialogue: 0,0:10:18.49,0:10:21.29,Default,,0,0,0,,!خصمك… هو أنا
Dialogue: 0,0:10:41.35,0:10:42.64,Default,,0,0,0,,!مثير للإعجاب
Dialogue: 0,0:10:47.86,0:10:50.11,Default,,0,0,0,,!تمدد يا سيف مونوهوشيزاو
Dialogue: 0,0:10:52.44,0:10:55.03,Default,,0,0,0,,...ماذا
Dialogue: 0,0:10:57.82,0:10:59.07,Default,,0,0,0,,!مذهل
Dialogue: 0,0:11:03.58,0:11:05.04,Default,,0,0,0,,!سأنهي هذا
Dialogue: 0,0:11:06.54,0:11:08.67,Default,,0,0,0,,!تسوباميغايشي
Dialogue: 0,0:11:13.92,0:11:16.63,Default,,0,0,0,,.آمن بنفسك، تقدم للأمام، تاركًا الخوف وراءك
Dialogue: 0,0:11:18.05,0:11:21.18,Default,,0,0,0,,.إنه طريق النصر المؤكد
Dialogue: 0,0:11:37.61,0:11:39.99,Default,,0,0,0,,!كوجيرو، النصر بعيد عنك
Dialogue: 0,0:11:41.58,0:11:43.12,Default,,0,0,0,,...لقد
Dialogue: 0,0:11:47.21,0:11:48.71,Default,,0,0,0,,!لقد فاز
Dialogue: 0,0:12:00.47,0:12:01.76,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:12:06.64,0:12:08.39,Default,,0,0,0,,!لقد فعلتها، يايبا
Dialogue: 0,0:12:08.48,0:12:10.19,Default,,0,0,0,,!بسرعة! البوابة
Dialogue: 0,0:12:10.27,0:12:11.23,Default,,0,0,0,,!صحيح
Dialogue: 0,0:12:14.32,0:12:15.24,Default,,0,0,0,,!يايبا
Dialogue: 0,0:12:21.03,0:12:23.45,Default,,0,0,0,,.أراك قريبًا، موساشي
Dialogue: 0,0:12:35.00,0:12:36.63,Default,,0,0,0,,ماذا حدث للتو؟
Dialogue: 0,0:12:44.10,0:12:46.56,Default,,0,0,0,,!تمدد يا سيف مونوهوشيزاو
Dialogue: 0,0:12:47.98,0:12:49.19,Default,,0,0,0,,!سحقاً
Dialogue: 0,0:12:49.27,0:12:50.69,Default,,0,0,0,,!موساشي
Dialogue: 0,0:12:52.81,0:12:55.23,Default,,0,0,0,,!انتهى أمرك يا موساشي
Dialogue: 0,0:12:56.19,0:12:57.40,Default,,0,0,0,,!تهيّأ لنهايتك
Dialogue: 0,0:13:10.92,0:13:12.34,Default,,0,0,0,,...تبا
Dialogue: 0,0:13:13.79,0:13:16.92,Default,,0,0,0,,.أستطيع أن أقول أننا متساويان الآن، موساشي
Dialogue: 0,0:13:20.38,0:13:21.76,Default,,0,0,0,,!يايبا
Dialogue: 0,0:13:22.47,0:13:26.06,Default,,0,0,0,,.عندما ظننت أنك هربت، تعود زاحفًا
Dialogue: 0,0:13:26.14,0:13:27.52,Default,,0,0,0,,!تعلم اسمي
Dialogue: 0,0:13:27.64,0:13:29.73,Default,,0,0,0,,إنه يايبا. فهمت، أيها الأحمق؟
Dialogue: 0,0:13:29.81,0:13:31.56,Default,,0,0,0,,!وللتوضيح، لم أهرب
Dialogue: 0,0:13:31.64,0:13:33.56,Default,,0,0,0,,!أنا خصمك الآن
Dialogue: 0,0:13:35.52,0:13:39.61,Default,,0,0,0,,!في هذه الحالة… سأقتلك أولاً
Dialogue: 0,0:13:43.20,0:13:46.45,Default,,0,0,0,,.تسوباميغايشي. هذه المرة، هزمته
Dialogue: 0,0:13:48.20,0:13:49.49,Default,,0,0,0,,!حان الوقت
Dialogue: 0,0:14:01.88,0:14:04.30,Default,,0,0,0,,!تقدم للأمام، تاركًا الخوف وراءك
Dialogue: 0,0:14:04.39,0:14:05.93,Default,,0,0,0,,!تسوباميغايشي
Dialogue: 0,0:14:12.39,0:14:14.64,Default,,0,0,0,,!لقد أوقف تسوباميغايشي
Dialogue: 0,0:14:16.23,0:14:19.28,Default,,0,0,0,,.لقد وضع هذه الفكرة في رأسك. قال لك أن تتقدم
Dialogue: 0,0:14:19.90,0:14:20.73,Default,,0,0,0,,!لكن
Dialogue: 0,0:14:21.78,0:14:23.20,Default,,0,0,0,,.كان ذلك مجرد صد واحد
Dialogue: 0,0:14:23.70,0:14:25.03,Default,,0,0,0,,!لديك الكثير لتفعله
Dialogue: 0,0:14:40.75,0:14:42.00,Default,,0,0,0,,.لا تتفاخر كثيرًا
Dialogue: 0,0:14:42.63,0:14:44.47,Default,,0,0,0,,.لن تهزم هذا السيف الأسطوري أبدًا
Dialogue: 0,0:14:45.05,0:14:46.43,Default,,0,0,0,,.يايبا
Dialogue: 0,0:14:48.22,0:14:49.97,Default,,0,0,0,,.لم أنته بعد
Dialogue: 0,0:14:52.35,0:14:54.81,Default,,0,0,0,,...قد يكون لديك سيف أسطوري
Dialogue: 0,0:14:55.85,0:14:57.48,Default,,0,0,0,,!لكنني لن أخسر
Dialogue: 0,0:14:58.06,0:15:02.69,Default,,0,0,0,,!على الساموراي أن يؤمن بنفسه أولاً
Dialogue: 0,0:15:04.03,0:15:05.53,Default,,0,0,0,,...لا أصدق ذلك
Dialogue: 0,0:15:06.41,0:15:09.33,Default,,0,0,0,,!ساياكا! كرة سيف الرعد
Dialogue: 0,0:15:09.41,0:15:11.08,Default,,0,0,0,,...ماذا؟ لكن
Dialogue: 0,0:15:11.16,0:15:14.20,Default,,0,0,0,,.إنها فرصته الوحيدة ضد السيف الأسطوري
Dialogue: 0,0:15:14.29,0:15:15.42,Default,,0,0,0,,.لدي حدس
Dialogue: 0,0:15:15.50,0:15:19.63,Default,,0,0,0,,!أشعر أنه مستعد للسيطرة على حاكم الرعد
Dialogue: 0,0:15:24.34,0:15:25.34,Default,,0,0,0,,!يايبا
Dialogue: 0,0:15:28.93,0:15:31.31,Default,,0,0,0,,!استخدم كرة حاكم الرعد
Dialogue: 0,0:15:31.39,0:15:32.64,Default,,0,0,0,,هل أنت متأكد؟
Dialogue: 0,0:15:33.18,0:15:34.89,Default,,0,0,0,,.قد أتحول إلى شيطان، كما تعلم
Dialogue: 0,0:15:34.98,0:15:37.57,Default,,0,0,0,,!لا يهمني! استخدمها
Dialogue: 0,0:15:39.02,0:15:40.52,Default,,0,0,0,,...حسناً إذن
Dialogue: 0,0:15:45.44,0:15:48.28,Default,,0,0,0,,أتعتقد أنك تستطيع قتال سيفي الأسطوري بهذا؟
Dialogue: 0,0:15:48.36,0:15:51.49,Default,,0,0,0,,.سأستمتع جدًا باكتشاف ذلك
Dialogue: 0,0:15:51.58,0:15:54.63,Default,,0,0,0,,!استعد لرؤية القوة الحقيقية لسيف الرعد
Dialogue: 0,0:16:16.10,0:16:19.48,Default,,0,0,0,,!يايبا! لا تدع حاكم الرعد يتحكم بك
Dialogue: 0,0:16:19.56,0:16:22.27,Default,,0,0,0,,!استخدم إرادتك للسيطرة عليه
Dialogue: 0,0:16:23.11,0:16:24.95,Default,,0,0,0,,.آمن بقوتك
Dialogue: 0,0:16:25.03,0:16:28.62,Default,,0,0,0,,!ستمنع حاكم الرعد من ابتلاعك، ومن تحويلك إلى شيطان
Dialogue: 0,0:16:29.45,0:16:31.41,Default,,0,0,0,,!تبا
Dialogue: 0,0:16:31.49,0:16:38.46,Default,,0,0,0,,!لن تحولني إلى شيطان أبدًا
Dialogue: 0,0:16:50.18,0:16:52.39,Default,,0,0,0,,...ما هذا
Dialogue: 0,0:16:58.73,0:17:00.11,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:17:00.19,0:17:02.15,Default,,0,0,0,,...ايعقل انه
Dialogue: 0,0:17:07.11,0:17:11.82,Default,,0,0,0,,...أنا
Dialogue: 0,0:17:11.91,0:17:15.16,Default,,0,0,0,,!كوروغاني يايبا
Dialogue: 0,0:17:17.08,0:17:19.21,Default,,0,0,0,,!لقد هزم حاكم الرعد
Dialogue: 0,0:17:19.29,0:17:20.54,Default,,0,0,0,,!يايبا
Dialogue: 0,0:17:20.62,0:17:24.21,Default,,0,0,0,,!هذا وضع سيئ للغاية
Dialogue: 0,0:17:25.42,0:17:27.21,Default,,0,0,0,,.انحراف مؤقت
Dialogue: 0,0:17:28.21,0:17:30.42,Default,,0,0,0,,...أنت متفائل جداً
Dialogue: 0,0:17:30.51,0:17:32.47,Default,,0,0,0,,!ها أنا قادم، كوجيرو
Dialogue: 0,0:17:40.73,0:17:42.90,Default,,0,0,0,,!مذهل
Dialogue: 0,0:17:42.98,0:17:46.78,Default,,0,0,0,,!أنت غشاش!  الأسلحة النارية أداة الجبناء فقط
Dialogue: 0,0:17:46.86,0:17:48.03,Default,,0,0,0,,!اصمت
Dialogue: 0,0:17:48.11,0:17:50.86,Default,,0,0,0,,!أنت من يستخدم السيف السحري الممتد
Dialogue: 0,0:17:50.94,0:17:52.15,Default,,0,0,0,,!أغلق فمك
Dialogue: 0,0:18:00.91,0:18:02.29,Default,,0,0,0,,!تبا
Dialogue: 0,0:18:07.42,0:18:10.42,Default,,0,0,0,,!خذ هذا
Dialogue: 0,0:18:10.51,0:18:13.47,Default,,0,0,0,,!تمدد يا سيف مونوهوشيزاو
Dialogue: 0,0:18:41.33,0:18:42.46,Default,,0,0,0,,...ماذا؟
Dialogue: 0,0:18:45.87,0:18:48.37,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:18:48.46,0:18:51.30,Default,,0,0,0,,!أيها الأحمق! أزل الكرة الآن
Dialogue: 0,0:18:51.38,0:18:53.51,Default,,0,0,0,,!الأمر ليس سهلاً كما تقول
Dialogue: 0,0:18:58.47,0:18:59.18,Default,,0,0,0,,!أخرجي
Dialogue: 0,0:19:09.02,0:19:12.65,Default,,0,0,0,,...أنا متعب للغاية
Dialogue: 0,0:19:15.49,0:19:16.74,Default,,0,0,0,,!يايبا
Dialogue: 0,0:19:17.36,0:19:19.74,Default,,0,0,0,,.النصل يحمل قوى مخيفة
Dialogue: 0,0:19:19.83,0:19:24.17,Default,,0,0,0,,.يتطلب تركيزًا جسديًا وعقليًا كاملاً
Dialogue: 0,0:19:26.62,0:19:30.29,Default,,0,0,0,,.مع ذلك، صمدت. لقد قطعت شوطًا طويلاً
Dialogue: 0,0:19:41.76,0:19:44.97,Default,,0,0,0,,.أنت شخص لا يستهان به يا كوروغاني يايبا
Dialogue: 0,0:19:45.60,0:19:48.48,Default,,0,0,0,,.لقد هزمتني تمامًا
Dialogue: 0,0:19:48.56,0:19:50.81,Default,,0,0,0,,.لم أعاني أبدًا من إذلال كهذا
Dialogue: 0,0:20:00.70,0:20:02.99,Default,,0,0,0,,انت البروفيسور كانابو، أليس كذلك؟
Dialogue: 0,0:20:03.70,0:20:06.83,Default,,0,0,0,,.أريدك أن تعمل لصالحي
Dialogue: 0,0:20:06.91,0:20:10.33,Default,,0,0,0,,.نعم. أعتقد أنني أستطيع أن أكون في خدمتك
Dialogue: 0,0:20:10.42,0:20:15.13,Default,,0,0,0,,.أنا لا أتفاخر، لكنني استثنائي جدًا
Dialogue: 0,0:20:15.21,0:20:18.92,Default,,0,0,0,,.أنا أيضًا غير مفهوم جيدًا عند الناس
Dialogue: 0,0:20:22.47,0:20:26.89,Default,,0,0,0,,.إذن ما الذي ننتظره؟ لدي اختبار لك
Dialogue: 0,0:20:28.31,0:20:29.69,Default,,0,0,0,,.كما تريد
Dialogue: 0,0:20:30.27,0:20:33.61,Default,,0,0,0,,.حسنًا… إذا سمحت لي، سأبدأ
Dialogue: 0,0:20:38.78,0:20:40.70,Default,,0,0,0,,.لقد عدت
Dialogue: 0,0:20:40.78,0:20:42.70,Default,,0,0,0,,أين سيف الرعد؟
Dialogue: 0,0:20:42.78,0:20:45.32,Default,,0,0,0,,...في الحقيقة
Dialogue: 0,0:20:45.41,0:20:46.25,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:20:46.33,0:20:47.62,Default,,0,0,0,,...أعني
Dialogue: 0,0:20:47.70,0:20:53.16,Default,,0,0,0,,.بدلاً من ذلك، أحضرت لك كوجيرو
Dialogue: 0,0:20:54.54,0:20:55.88,Default,,0,0,0,,.كوجيرو
Dialogue: 0,0:20:55.96,0:21:00.46,Default,,0,0,0,,.مساهمتك في قوات أونيمارو كساموراي عبقري تبهجني
Dialogue: 0,0:21:00.55,0:21:02.30,Default,,0,0,0,,...ستكون ذراعي اليمنى
Dialogue: 0,0:21:02.39,0:21:03.60,Default,,0,0,0,,!لن أقبل
Dialogue: 0,0:21:03.68,0:21:04.97,Default,,0,0,0,,ماذا تقول؟
Dialogue: 0,0:21:05.72,0:21:07.64,Default,,0,0,0,,!ليس لدي أي التزام تجاهك
Dialogue: 0,0:21:07.72,0:21:08.85,Default,,0,0,0,,!أيها الوغد
Dialogue: 0,0:21:08.93,0:21:10.56,Default,,0,0,0,,!مهلا! مهلا!، سيد أونيمارو
Dialogue: 0,0:21:11.85,0:21:15.31,Default,,0,0,0,,بالمناسبة، هل ترغب في معرفة ذلك الشيء؟
Dialogue: 0,0:21:15.40,0:21:16.73,Default,,0,0,0,,معرفة ماذا؟
Dialogue: 0,0:21:16.82,0:21:21.07,Default,,0,0,0,,.من هو أعظم ساموراي في هذا العصر
Dialogue: 0,0:21:24.12,0:21:27.37,Default,,0,0,0,,,حسب حساباتي
Dialogue: 0,0:21:27.45,0:21:30.04,Default,,0,0,0,,...أقوى ساموراي على الإطلاق هو
Dialogue: 0,0:21:36.59,0:21:38.97,Default,,0,0,0,,ماذا؟ ذلك الطفل؟
Dialogue: 0,0:21:41.22,0:21:42.47,Default,,0,0,0,,.فهمت 
Dialogue: 0,0:21:42.55,0:21:46.05,Default,,0,0,0,,أعتقد أن الشخص الذي يمكن أن يسبب لك أكبر المشاكل
Dialogue: 0,0:21:46.14,0:21:47.89,Default,,0,0,0,,.ليس موساشي
Dialogue: 0,0:21:47.97,0:21:50.01,Default,,0,0,0,,.بل إنه كوروغاني يايبا
Dialogue: 0,0:21:51.73,0:21:53.15,Default,,0,0,0,,.اذا لم تهزم يايبا
Dialogue: 0,0:21:53.23,0:21:56.36,Default,,0,0,0,,.فإن لقب أعظم ساموراي في العالم سيهرب منك إلى الأبد
Dialogue: 0,0:21:55.99,0:22:03.55,Ending,,0,0,0,,"ضُربتُ ببرقٍ حلوٍ لاذع، وانشغلت تماماً، يا "أومي
Dialogue: 0,0:21:56.90,0:22:00.49,Default,,0,0,0,,!لن يأخذ ذلك القزم هذا الشرف مني أبدًا
Dialogue: 0,0:22:03.74,0:22:11.53,Ending,,0,0,0,,تذوقت طعامك وانفجرتُ في الطريق
Dialogue: 0,0:22:08.49,0:22:09.70,Default,,0,0,0,,...كوروغاني يايبا
Dialogue: 0,0:22:10.25,0:22:12.13,Default,,0,0,0,,...تحت نصل ساساكي كوجيرو
Dialogue: 0,0:22:12.15,0:22:16.03,Ending,,0,0,0,,ينبثق من أعماق قلبي شعور غامض، لم أعرفه من قبل
Dialogue: 0,0:22:12.66,0:22:13.62,Default,,0,0,0,,!سوف يموت
Dialogue: 0,0:22:14.54,0:22:16.13,Default,,0,0,0,,!حسنًا… إلى اللقاء
Dialogue: 0,0:22:16.10,0:22:20.07,Ending,,0,0,0,,كعكة اللحظة المنتظرة في كل احتفال مميز
Dialogue: 0,0:22:17.09,0:22:20.51,Default,,0,0,0,,!نعم! لقد نجحت
Dialogue: 0,0:22:20.10,0:22:23.81,Ending,,0,0,0,,نظرنا إلى بعضنا البعض وقلنا "إنه لذيذ"
Dialogue: 0,0:22:20.59,0:22:23.38,Default,,0,0,0,,.لقد وقع في الفخ بسهولة
Dialogue: 0,0:22:23.47,0:22:25.85,Default,,0,0,0,,.إنه أكثر سذاجة مما توقعت
Dialogue: 0,0:22:23.89,0:22:27.08,Ending,,0,0,0,,"إنه لذيذ"، قلنا، ونحن ننظر إلى بعضنا البعض.
Dialogue: 0,0:22:27.17,0:22:30.76,Ending,,0,0,0,,تلك الأيام التي تخطفك من الواقع بجمالها
Dialogue: 0,0:22:30.78,0:22:35.12,Ending,,0,0,0,,...أتمنى أن تدوم
Dialogue: 0,0:22:32.31,0:22:33.77,Default,,0,0,0,,!سيد أونيمارو
Dialogue: 0,0:22:33.85,0:22:36.14,Default,,0,0,0,,!ارجوك سامحني
Dialogue: 0,0:22:35.13,0:22:39.15,Ending,,0,0,0,,كأنه يتمنى، وكأنني أرجو
Dialogue: 0,0:22:36.73,0:22:39.07,Default,,0,0,0,,.أنا أقوى كائن في العالم
Dialogue: 0,0:22:39.14,0:22:42.74,Ending,,0,0,0,,أتذوقها واحدةً تلو الأخرى
Dialogue: 0,0:22:40.07,0:22:42.49,Default,,0,0,0,,!كان ذلك فقط جزءًا من الخطة
Dialogue: 0,0:22:42.76,0:22:46.82,Ending,,0,0,0,,فوق أضواء الزينة
Dialogue: 0,0:22:43.57,0:22:45.11,Default,,0,0,0,,...كوروغاني يايبا
Dialogue: 0,0:22:45.82,0:22:48.45,Default,,0,0,0,,.إذن لقد سيطرت على سيف الرعد
Dialogue: 0,0:22:46.84,0:22:50.72,Ending,,0,0,0,,ستقوم بتلوينه كما تشاء
Dialogue: 0,0:22:50.66,0:22:52.79,Default,,0,0,0,,.يبدو انه حان وقت تجهيز كل شيء
Dialogue: 0,0:22:50.97,0:22:54.62,Ending,,0,0,0,,لا أحد يستطيع أن يفعل ذلك
Dialogue: 0,0:22:54.73,0:22:59.53,Ending,,0,0,0,,لا أستطيع مساعدته، لا أستطيع أن أتركه
Dialogue: 0,0:23:02.09,0:23:03.38,Default,,0,0,0,,...سيف الرعد
Dialogue: 0,0:23:07.72,0:23:12.64,Default,,0,0,0,,الحلقة 8: المبارزة في جزيرة جانريو
Dialogue: 0,0:23:17.98,0:23:19.57,Default,,0,0,0,,.لن يمسك بي الموت أبدًا
Dialogue: 0,0:23:20.36,0:23:22.61,Default,,0,0,0,,.سوف أفوز، وأفوز وأصمد
Dialogue: 0,0:23:22.69,0:23:25.86,Default,,0,0,0,,...لأصل إلى جنّتي في مستقبل بعيد
Dialogue: 0,0:23:28.16,0:23:31.12,Default,,0,0,0,,!سأعيش
Dialogue: 0,0:23:36.25,0:23:38.59,Default,,0,0,0,,،الآن بعد أن تمكن يايبا من السيطرة على كرة حاكم الرعد
Dialogue: 0,0:23:38.67,0:23:41.05,Default,,0,0,0,,!يمكننا أخيرًا اقتحام قلعة أونيمارو
Dialogue: 0,0:23:41.13,0:23:44.88,Default,,0,0,0,,.لكن الآن، يبدو يايبا مركزًا على إتقان تقنية جديدة
