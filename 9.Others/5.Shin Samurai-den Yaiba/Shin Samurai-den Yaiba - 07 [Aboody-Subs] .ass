Dialogue: 0,0:00:00.00,0:00:08.00,Default2,,0,0,0,,{\fs70\pos(960,60)\an5}لا تنسوا الدعاء لإخوانكم في فلسطين والسودان وفي سائر بلاد المسلمين
Dialogue: 0,0:00:01.00,0:00:08.00,DCRights,,0,0,0,,{\fs70\pos(20,25)} ABOODY SUBS | ترجمة \NTelegram : ABOODY-SUBS\NX : @ABOODY_SUBS
Dialogue: 0,0:00:10.26,0:00:12.55,Default,,0,0,0,,ماذا يحدث؟-\Nما كان ذلك؟-
Dialogue: 0,0:00:12.68,0:00:14.27,Default,,0,0,0,,!انظر! هناك في الأعلى
Dialogue: 0,0:00:15.43,0:00:17.02,Default,,0,0,0,,...ما هذا
Dialogue: 0,0:00:18.77,0:00:21.11,Default,,0,0,0,,أخبار عاجلة\Nسفينة أونيمارو الجوية تحوم فوق طوكيو
Dialogue: 0,0:00:21.19,0:00:24.19,Default,,0,0,0,,.هذا ما توصلنا إليه. ننقلكم مباشرة إلى مكان الحدث
Dialogue: 0,0:00:24.27,0:00:26.44,Default,,0,0,0,,.شيوجي يقدم التقرير من هنا مباشرة
Dialogue: 0,0:00:26.53,0:00:29.03,Default,,0,0,0,,!إنه أونيمارو! أونيمارو قد ظهر
Dialogue: 0,0:00:29.53,0:00:32.28,Default,,0,0,0,,لقد حول مبنى البرلمان الوطني إلى قلعته الخاصة
Dialogue: 0,0:00:32.37,0:00:34.79,Default,,0,0,0,,!ويخطط للسيطرة على اليابان
Dialogue: 0,0:00:34.87,0:00:36.96,Default,,0,0,0,,ما هو بالضبط؟
Dialogue: 0,0:00:41.12,0:00:44.75,Default,,0,0,0,,!لقد فات الأوان. اليابان ملكي الآن
Dialogue: 0,0:00:44.88,0:00:48.80,Default,,0,0,0,,!الآن، انحنوا أمامي، أيها الحشرات الحقيرة
Dialogue: 0,0:00:49.88,0:00:52.30,Default,,0,0,0,,!أونيمارو؟ من يهتم! تبًا لك
Dialogue: 0,0:00:52.39,0:00:55.52,Default,,0,0,0,,!اليابان لن تنحني أبدًا لك
Dialogue: 0,0:00:55.60,0:00:57.14,Default,,0,0,0,,!نعم! أبدًا
Dialogue: 0,0:00:57.22,0:00:58.89,Default,,0,0,0,,!أنت لست قائدنا
Dialogue: 0,0:00:59.52,0:01:01.02,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:01:01.10,0:01:03.94,Default,,0,0,0,,!ربما يكون عرضًا توضيحيًا ضروريًا إذن
Dialogue: 0,0:01:14.91,0:01:16.16,Default,,0,0,0,,...لا يمكن
Dialogue: 0,0:01:16.24,0:01:17.91,Default,,0,0,0,,!هذا لا يحدث
Dialogue: 0,0:01:27.42,0:01:29.80,Default,,0,0,0,,هل غيرتم رأيكم، أيها التابعون؟
Dialogue: 0,0:01:29.88,0:01:34.18,Default,,0,0,0,,أقترح أن تتذكروا ما شاهدتموه للتو!
Dialogue: 0,0:01:38.68,0:01:40.60,Default,,0,0,0,,...الملك أونيمارو
Dialogue: 0,0:01:41.18,0:01:42.56,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:01:43.27,0:01:47.32,Default,,0,0,0,,...حسنًا، يبدو أن السيد بات قد هُزم
Dialogue: 0,0:01:47.40,0:01:48.78,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:01:49.53,0:01:51.78,Default,,0,0,0,,حتى هو فشل؟
Dialogue: 0,0:01:52.78,0:01:55.57,Default,,0,0,0,,.كان آخر الثمانية شياطين
Dialogue: 0,0:01:55.66,0:01:57.66,Default,,0,0,0,,...حسنًا، ربما تنسونني
Dialogue: 0,0:01:57.74,0:01:59.33,Default,,0,0,0,,أين هؤلاء الأوغاد الآن؟
Dialogue: 0,0:02:00.16,0:02:02.75,Default,,0,0,0,,.يبدو أنهم يتجهون إلى جزيرة جانريو
Dialogue: 0,0:02:03.62,0:02:05.66,Default,,0,0,0,,جزيرة جانريو، حقًا؟
Dialogue: 0,0:02:05.75,0:02:07.17,Default,,0,0,0,,.ممتاز
Dialogue: 0,0:02:07.25,0:02:10.00,Default,,0,0,0,,.تغلبوا عليهم وأحيوا ذلك الشخص الذي تعرفونه
Dialogue: 0,0:02:10.59,0:02:12.09,Default,,0,0,0,,.لا أعرف من تقصد، سيدي
Dialogue: 0,0:02:12.17,0:02:14.55,Default,,0,0,0,,.ساموراي عاش على الأرض قبل 400 عام
Dialogue: 0,0:02:15.43,0:02:19.23,Default,,0,0,0,,.اسمه، كوجيرو ساساكي
Dialogue: 0,0:02:31.86,0:02:34.11,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:02:35.46,0:02:37.67,Opening,,0,0,0,,الإرادة للفوز هي شهادة على جديتي
Dialogue: 0,0:02:37.66,0:02:40.61,Opening,,0,0,0,,لكنك لن تصدق ذلك، أليس كذلك؟
Dialogue: 0,0:02:40.62,0:02:42.97,Opening,,0,0,0,,المنطق السليم يمكن أن يكون عبئًا
Dialogue: 0,0:02:42.96,0:02:45.74,Opening,,0,0,0,,أستطيع التحدي لأني جاهل
Dialogue: 0,0:02:45.75,0:02:46.89,Opening,,0,0,0,,هل أنا "ساموراي حقيقي"؟
Dialogue: 0,0:02:46.90,0:02:48.16,Opening,,0,0,0,,أم مجرد "لاعب وقح"؟
Dialogue: 0,0:02:48.16,0:02:50.82,Opening,,0,0,0,,علي أن أتحدى لأني أريد أن أعرف
Dialogue: 0,0:02:50.81,0:02:56.18,Opening,,0,0,0,,الشغف في قلبي كان ساطعًا مثل البرق
Dialogue: 0,0:02:56.64,0:03:01.36,Opening,,0,0,0,,بغض النظر عن مقدار تغيرك
Dialogue: 0,0:03:01.62,0:03:06.05,Opening,,0,0,0,,لا يوجد كذب في المعارك التي خضناها
Dialogue: 0,0:03:06.05,0:03:10.80,Opening,,0,0,0,,أنا أمضي قدمًا بالشجاعة لأعيش بسرعة وتهور
Dialogue: 0,0:03:10.79,0:03:16.74,Opening,,0,0,0,,لأصل إلى القوة الجديدة المثيرة
Dialogue: 0,0:03:18.12,0:03:22.90,Opening,,0,0,0,,لنرفع سيوفنا نحو الغد
Dialogue: 0,0:03:22.91,0:03:27.93,Opening,,0,0,0,,أيقظ القوة الطبية 
Dialogue: 0,0:03:27.93,0:03:32.70,Opening,,0,0,0,,الآن تهب علينا الأقدار المحترقة
Dialogue: 0,0:03:32.70,0:03:37.62,Opening,,0,0,0,,سأقطع علامات اليأس
Dialogue: 0,0:03:37.62,0:03:39.44,Opening,,0,0,0,,بهذا "السيف" الحقيقي
Dialogue: 0,0:03:52.07,0:03:53.66,Default,,0,0,0,,...كوجيرو ساساكي
Dialogue: 0,0:03:54.69,0:03:58.53,Default,,0,0,0,,.كان سيفًا لا يُضاهى مرة كل قرن
Dialogue: 0,0:03:58.61,0:04:00.74,Default,,0,0,0,,.ووسيمًا أيضًا، يجب أن أقول
Dialogue: 0,0:04:00.82,0:04:04.62,Default,,0,0,0,,.رغم أنه ليس وسيمًا مثلي
Dialogue: 0,0:04:05.16,0:04:07.87,Default,,0,0,0,,.نعم، أخبرتنا
Dialogue: 0,0:04:07.96,0:04:10.30,Default,,0,0,0,,إذن نحتاج إلى ماكنه، أليس كذلك؟
Dialogue: 0,0:04:10.38,0:04:11.59,Default,,0,0,0,,.نعم
Dialogue: 0,0:04:12.29,0:04:14.92,Default,,0,0,0,,يمكنه التمدد والتقصير كما يشاء
Dialogue: 0,0:04:15.00,0:04:17.04,Default,,0,0,0,,.يسمونه مونوهوشيزاو
Dialogue: 0,0:04:17.13,0:04:18.59,Default,,0,0,0,,،قبل أربعة قرون
Dialogue: 0,0:04:18.68,0:04:23.06,Default,,0,0,0,,.تحديت كوجيرو، الذي كان يحمل ذلك الماكن… وانتصرت
Dialogue: 0,0:04:23.14,0:04:24.31,Default,,0,0,0,,كيف؟
Dialogue: 0,0:04:26.06,0:04:28.65,Default,,0,0,0,,.حسنًا، سأشرح لكم
Dialogue: 0,0:04:30.35,0:04:32.60,Default,,0,0,0,,،عندما سمعت أنه حصل على الماكن
Dialogue: 0,0:04:32.69,0:04:35.61,Default,,0,0,0,,.وضعت خطة سرية للغاية
Dialogue: 0,0:04:35.69,0:04:36.90,Default,,0,0,0,,خطة سرية للغاية؟
Dialogue: 0,0:04:36.99,0:04:38.20,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:04:38.28,0:04:39.82,Default,,0,0,0,,.كانت عبقرية
Dialogue: 0,0:04:39.90,0:04:43.20,Default,,0,0,0,,!في ذلك المبارزة المصيرية، تأخرت في الحضور
Dialogue: 0,0:04:43.28,0:04:45.20,Default,,0,0,0,,أليس هذا مخادعًا بعض الشيء؟
Dialogue: 0,0:04:45.29,0:04:47.21,Default,,0,0,0,,!لا، هذا يسمى فن الحرب
Dialogue: 0,0:04:47.91,0:04:51.00,Default,,0,0,0,,.مثلك، كان صبره قصيرًا مثل البرغوث
Dialogue: 0,0:04:51.08,0:04:52.42,Default,,0,0,0,,.اصمت
Dialogue: 0,0:04:52.50,0:04:54.34,Default,,0,0,0,,...أصبح منزعجًا، غاضبًا
Dialogue: 0,0:04:54.42,0:04:56.76,Default,,0,0,0,,.وتهاوت مهارته في السيف
Dialogue: 0,0:04:56.84,0:04:59.80,Default,,0,0,0,,.ثم بدأت المبارزة
Dialogue: 0,0:04:59.88,0:05:04.05,Default,,0,0,0,,،بدأ بتوقيعه تسوباميغايشي
Dialogue: 0,0:05:04.14,0:05:06.39,Default,,0,0,0,,،لكنني بسرعة صديت
Dialogue: 0,0:05:06.47,0:05:08.68,Default,,0,0,0,,!ثم أطلقت الضربة القاضية
Dialogue: 0,0:05:08.77,0:05:10.52,Default,,0,0,0,,هل أنت جاد؟
Dialogue: 0,0:05:10.60,0:05:12.60,Default,,0,0,0,,ها هو، كوجيرو، النصر يفوتك
Dialogue: 0,0:05:12.69,0:05:16.82,Default,,0,0,0,,.هذا ما عُرف لاحقًا باسم المبارزة في جزيرة جانريو
Dialogue: 0,0:05:19.19,0:05:22.65,Default,,0,0,0,,.ظننت أنك نسيت معظم الماضي
Dialogue: 0,0:05:22.74,0:05:26.16,Default,,0,0,0,,.المشاهد للمبارزة تذكره بوضوح
Dialogue: 0,0:05:26.24,0:05:27.37,Default,,0,0,0,,.هنا
Dialogue: 0,0:05:27.45,0:05:30.83,Default,,0,0,0,,.التفاصيل هنا، اقرأها
Dialogue: 0,0:05:32.17,0:05:33.34,Default,,0,0,0,,!أريد أن أقرأها أيضًا
Dialogue: 0,0:05:33.88,0:05:36.17,Default,,0,0,0,,.ها هو
Dialogue: 0,0:05:37.13,0:05:39.38,Default,,0,0,0,,.هذه جزيرة جانريو
Dialogue: 0,0:05:41.72,0:05:46.64,Default,,0,0,0,,الحلقة 7: إحياء كوجيرو
Dialogue: 0,0:05:50.48,0:05:54.94,Default,,0,0,0,,المفترض أن القبر هنا؟
Dialogue: 0,0:06:00.57,0:06:02.49,Default,,0,0,0,,!لم يكن يمزح
Dialogue: 0,0:06:02.57,0:06:04.57,Default,,0,0,0,,.يا للقرف
Dialogue: 0,0:06:05.78,0:06:09.74,Default,,0,0,0,,.قوة الماكن الشبحية منعته من التحنيط
Dialogue: 0,0:06:10.41,0:06:12.41,Default,,0,0,0,,...حسنًا، التالي
Dialogue: 0,0:06:13.25,0:06:14.38,Default,,0,0,0,,...لنرى الآن
Dialogue: 0,0:06:14.46,0:06:16.13,Default,,0,0,0,,.بيضة كابا واحدة
Dialogue: 0,0:06:16.21,0:06:17.59,Default,,0,0,0,,.دموع تنين
Dialogue: 0,0:06:18.13,0:06:20.13,Default,,0,0,0,,...غبار عثة واحدة
Dialogue: 0,0:06:23.34,0:06:25.88,Default,,0,0,0,,.ليس سيئًا، إذا قلت ذلك بنفسي
Dialogue: 0,0:06:26.47,0:06:28.10,Default,,0,0,0,,.الآن يأتي الجزء الصعب
Dialogue: 0,0:06:28.18,0:06:33.23,Default,,0,0,0,,...الآن، لإطلاق أربعة قرون من سحر الماكن
Dialogue: 0,0:06:35.27,0:06:36.69,Default,,0,0,0,,،بهذه القوة
Dialogue: 0,0:06:36.77,0:06:39.52,Default,,0,0,0,,...كل ما علي فعله هو تحديد لحظة موت كوجيرو
Dialogue: 0,0:06:40.27,0:06:42.77,Default,,0,0,0,,.وفتح بوابة في الزمكان
Dialogue: 0,0:06:50.49,0:06:56.66,Default,,0,0,0,,.ثم أمسك الروح التي غادرت جسده… وأعيدها
Dialogue: 0,0:06:58.17,0:06:59.59,Default,,0,0,0,,!فهمت
Dialogue: 0,0:06:59.67,0:07:03.63,Default,,0,0,0,,!الآن فقط أضعه مرة أخرى في جثته
Dialogue: 0,0:07:04.63,0:07:07.05,Default,,0,0,0,,!تعال إلى الحياة الآن
Dialogue: 0,0:07:14.68,0:07:15.51,Default,,0,0,0,,.هذا غريب
Dialogue: 0,0:07:16.10,0:07:18.02,Default,,0,0,0,,!انت! استيقظ
Dialogue: 0,0:07:19.61,0:07:21.95,Default,,0,0,0,,هل أخطأت في شيء ما؟
Dialogue: 0,0:07:30.28,0:07:34.12,Default,,0,0,0,,!الوحش الذي تجرأ على لمس وجهي المثالي يجب أن يكون أنت
Dialogue: 0,0:07:35.58,0:07:37.79,Default,,0,0,0,,أيها الحقير! من أنت؟
Dialogue: 0,0:07:37.87,0:07:39.96,Default,,0,0,0,,!على ركبتيك واستعد لتحمل سيفي
Dialogue: 0,0:07:42.17,0:07:44.76,Default,,0,0,0,,!انتظر، من فضلك
Dialogue: 0,0:07:44.84,0:07:47.93,Default,,0,0,0,,.أنا لست عدوك! كنت فقط أتبع أوامر الملك أونيمارو
Dialogue: 0,0:07:48.01,0:07:51.18,Default,,0,0,0,,!لقد مت قبل 400 عام وأعدتك إلى الحياة
Dialogue: 0,0:07:52.76,0:07:53.68,Default,,0,0,0,,لقد مت؟
Dialogue: 0,0:07:55.27,0:07:57.48,Default,,0,0,0,,...تقصد، أنا
Dialogue: 0,0:08:05.11,0:08:07.57,Default,,0,0,0,,!إنهم هنا بالفعل
Dialogue: 0,0:08:07.65,0:08:09.61,Default,,0,0,0,,!أعيدوا كل شيء واختبئوا
Dialogue: 0,0:08:09.70,0:08:11.29,Default,,0,0,0,,!ابقَ بعيدًا عن الأنظار، كوجيرو
Dialogue: 0,0:08:12.16,0:08:13.50,Default,,0,0,0,,...لا أستطيع التذكر
Dialogue: 0,0:08:17.50,0:08:19.75,Default,,0,0,0,,.هذا المكان ممل للغاية
Dialogue: 0,0:08:19.83,0:08:22.54,Default,,0,0,0,,!انظر! التماثيل البرونزية هناك
Dialogue: 0,0:08:22.63,0:08:26.68,Default,,0,0,0,,.هذا كوجيرو وأنا، موساشي مياموتو العظيم
Dialogue: 0,0:08:27.17,0:08:29.26,Default,,0,0,0,,إذن أنت الوحيد الذي يستحق لقب "عظيم"؟
Dialogue: 0,0:08:30.30,0:08:31.72,Default,,0,0,0,,ما هذا الشيء الأسود؟
Dialogue: 0,0:08:33.51,0:08:34.89,Default,,0,0,0,,هل أشعر حقًا بموساشي؟
Dialogue: 0,0:08:35.81,0:08:36.73,Default,,0,0,0,,...انتظر
Dialogue: 0,0:08:37.23,0:08:39.27,Default,,0,0,0,,،لقد وقعت في حيله المماطلة
Dialogue: 0,0:08:39.35,0:08:41.85,Default,,0,0,0,,...ثم ضربني، ولم أتذكر شيئًا
Dialogue: 0,0:08:41.94,0:08:44.28,Default,,0,0,0,,.هو وسيفه مدفونان تحت تلك التماثيل
Dialogue: 0,0:08:45.23,0:08:46.65,Default,,0,0,0,,...هل يمكن
Dialogue: 0,0:08:47.94,0:08:50.36,Default,,0,0,0,,...أنني
Dialogue: 0,0:08:51.70,0:08:55.04,Default,,0,0,0,,!هل أنا ميت؟
Dialogue: 0,0:08:55.12,0:08:58.21,Default,,0,0,0,,.حسنًا، لهذا السبب أعدتك إلى الحياة
Dialogue: 0,0:08:58.70,0:09:00.83,Default,,0,0,0,,يا له من وقت طويل، كوجيرو؟
Dialogue: 0,0:09:02.29,0:09:07.00,Default,,0,0,0,,.كنت سيفًا ماهرًا، موهوبة مرة في الجيل
Dialogue: 0,0:09:07.09,0:09:11.64,Default,,0,0,0,,.كان من المؤسف فقدان مثل هذه القوة
Dialogue: 0,0:09:12.72,0:09:15.89,Default,,0,0,0,,.موساشي… لديك طريقة مع الكلمات، عندما ترغب في ذلك
Dialogue: 0,0:09:15.97,0:09:16.93,Default,,0,0,0,,،مع ذلك
Dialogue: 0,0:09:17.01,0:09:19.72,Default,,0,0,0,,،أنا ما تسمونه خبيرًا عظيمًا في السيف
Dialogue: 0,0:09:19.81,0:09:21.98,Default,,0,0,0,,!موهوبة مرة في مليون سنة
Dialogue: 0,0:09:22.06,0:09:26.19,Default,,0,0,0,,!ساموراي مبتدئ مثلك لا يمكنه أبدًا هزيمتي
Dialogue: 0,0:09:29.32,0:09:30.82,Default,,0,0,0,,.لقد اخترت القتال الخطأ
Dialogue: 0,0:09:33.70,0:09:36.54,Default,,0,0,0,,!اصمت، موساشي
Dialogue: 0,0:09:37.83,0:09:41.88,Default,,0,0,0,,،من سبات قرون، من أرض الموتى
Dialogue: 0,0:09:41.96,0:09:44.71,Default,,0,0,0,,!لقد عدت لأدمرك
Dialogue: 0,0:09:44.79,0:09:48.04,Default,,0,0,0,,!لأنني كوجيرو ساساكي… اخشَني
Dialogue: 0,0:09:48.13,0:09:50.01,Default,,0,0,0,,!كوجيرو
Dialogue: 0,0:09:50.09,0:09:51.76,Default,,0,0,0,,!الكوجيرو؟
Dialogue: 0,0:09:52.34,0:09:53.55,Default,,0,0,0,,ما الذي يحدث؟
Dialogue: 0,0:09:57.31,0:09:59.56,Default,,0,0,0,,.لقد أعدته إلى الحياة
Dialogue: 0,0:10:00.18,0:10:02.47,Default,,0,0,0,,.لم نكن قد تقابلنا
Dialogue: 0,0:10:03.44,0:10:06.32,Default,,0,0,0,,...هو أحد الثمانية شياطين
Dialogue: 0,0:10:06.40,0:10:07.74,Default,,0,0,0,,!السيد العنكبوت
Dialogue: 0,0:10:09.11,0:10:11.36,Default,,0,0,0,,!أنا أقدم نفسي هنا
Dialogue: 0,0:10:11.82,0:10:14.53,Default,,0,0,0,,الآن أصبح هناك رجل عنكبوت؟
Dialogue: 0,0:10:14.61,0:10:16.65,Default,,0,0,0,,!لن تحصل على سيف الرعد
Dialogue: 0,0:10:18.45,0:10:21.66,Default,,0,0,0,,!تحدث بقوة ما دمت تستطيع
Dialogue: 0,0:10:21.75,0:10:24.79,Default,,0,0,0,,.يا رئيس! أطلب بتواضع أن تقضي عليهم
Dialogue: 0,0:10:25.37,0:10:27.71,Default,,0,0,0,,...أخشى أنني ما زلت مرتبكًا، لكن
Dialogue: 0,0:10:28.42,0:10:29.25,Default,,0,0,0,,.حسنًا
Dialogue: 0,0:10:29.34,0:10:33.09,Default,,0,0,0,,!سأبدأ بك، موساشي! لديك شرف الموت أولاً
Dialogue: 0,0:10:35.34,0:10:37.59,Default,,0,0,0,,بالمناسبة… أين موساشي؟
Dialogue: 0,0:10:37.68,0:10:39.27,Default,,0,0,0,,.إنه هنا
Dialogue: 0,0:10:39.35,0:10:41.39,Default,,0,0,0,,.أنا موساشي مياموتو
Dialogue: 0,0:10:42.43,0:10:46.85,Default,,0,0,0,,!ماذا؟! هذه الأحفورة البالية؟
Dialogue: 0,0:10:46.94,0:10:51.07,Default,,0,0,0,,!وجهك! ماذا حدث؟ كنت تقريبًا وسيمًا مثلي
Dialogue: 0,0:10:51.94,0:10:53.53,Default,,0,0,0,,!أنا وسيم كما كنت دائمًا
Dialogue: 0,0:10:53.61,0:10:55.53,Default,,0,0,0,,.أنت تتحدث
Dialogue: 0,0:10:55.61,0:10:57.40,Default,,0,0,0,,مع تلك العيون الحمراء؟
Dialogue: 0,0:10:57.49,0:11:00.95,Default,,0,0,0,,.قيلولة الجمال لمدة 400 عام لم تكن كافية
Dialogue: 0,0:11:01.04,0:11:03.88,Default,,0,0,0,,.لا يزال فمك يخرج فقط الفضلات
Dialogue: 0,0:11:06.50,0:11:07.96,Default,,0,0,0,,!استعد للمعركة، موساشي
Dialogue: 0,0:11:08.04,0:11:09.71,Default,,0,0,0,,!كما تريد
Dialogue: 0,0:11:12.05,0:11:13.01,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:11:13.92,0:11:15.55,Default,,0,0,0,,!هناك
Dialogue: 0,0:11:23.43,0:11:26.52,Default,,0,0,0,,.لقد تحسنت أثناء وجودك في ذلك التابوت
Dialogue: 0,0:11:26.60,0:11:29.44,Default,,0,0,0,,!وأنت فقدت قوتك
Dialogue: 0,0:11:32.73,0:11:35.69,Default,,0,0,0,,!تمدد! مونوهوشيزاو
Dialogue: 0,0:11:36.49,0:11:38.08,Default,,0,0,0,,!إنه حقًا يصبح أطول
Dialogue: 0,0:11:47.04,0:11:48.79,Default,,0,0,0,,.لقد لحق بك العمر، موساشي
Dialogue: 0,0:11:49.29,0:11:52.13,Default,,0,0,0,,.نسختك السابقة كانت ستصد ذلك بسهولة
Dialogue: 0,0:11:54.80,0:11:55.84,Default,,0,0,0,,!استعد للموت
Dialogue: 0,0:11:55.92,0:11:57.51,Default,,0,0,0,,!ليس تحت مراقبتي
Dialogue: 0,0:12:02.10,0:12:02.93,Default,,0,0,0,,...طفل
Dialogue: 0,0:12:03.51,0:12:06.56,Default,,0,0,0,,أتجرؤ على تحديي، كوجيرو؟
Dialogue: 0,0:12:06.64,0:12:09.23,Default,,0,0,0,,!أنا لست طفلاً! اسمي يايبا
Dialogue: 0,0:12:09.81,0:12:11.02,Default,,0,0,0,,.جهودك عديمة الفائدة
Dialogue: 0,0:12:11.56,0:12:14.15,Default,,0,0,0,,!حظًا موفقًا في الاقتراب
Dialogue: 0,0:12:14.86,0:12:16.78,Default,,0,0,0,,!اصمت
Dialogue: 0,0:12:29.79,0:12:31.96,Default,,0,0,0,,...إنه قوي. هذا يتطلب
Dialogue: 0,0:12:36.71,0:12:37.54,Default,,0,0,0,,...إنه قادم
Dialogue: 0,0:12:38.13,0:12:39.38,Default,,0,0,0,,!خذ هذا
Dialogue: 0,0:12:39.47,0:12:42.56,Default,,0,0,0,,!سيف الزوبعة
Dialogue: 0,0:12:42.64,0:12:45.19,Default,,0,0,0,,!تمدد! مونوهوشيزاو
Dialogue: 0,0:12:50.14,0:12:51.64,Default,,0,0,0,,...ما هذا
Dialogue: 0,0:12:55.57,0:12:58.70,Default,,0,0,0,,.لا داعي لمواجهة هذه التقنية مباشرة
Dialogue: 0,0:12:58.78,0:13:02.03,Default,,0,0,0,,.يمكنني ببساطة أن أصد من الأسفل
Dialogue: 0,0:13:02.11,0:13:05.61,Default,,0,0,0,,.سينبوكين… النصر يفوتك
Dialogue: 0,0:13:05.70,0:13:07.24,Default,,0,0,0,,...السينبوكين
Dialogue: 0,0:13:07.95,0:13:09.41,Default,,0,0,0,,…لم تنجح
Dialogue: 0,0:13:13.75,0:13:15.34,Default,,0,0,0,,.النهاية الآن
Dialogue: 0,0:13:15.42,0:13:16.59,Default,,0,0,0,,.لا
Dialogue: 0,0:13:17.21,0:13:18.63,Default,,0,0,0,,!تسوباميغايشي
Dialogue: 0,0:13:26.60,0:13:28.27,Default,,0,0,0,,!سيصيبني
Dialogue: 0,0:13:37.48,0:13:38.65,Default,,0,0,0,,ما كان ذلك؟
Dialogue: 0,0:13:39.15,0:13:40.61,Default,,0,0,0,,!لن تهرب
Dialogue: 0,0:13:41.20,0:13:42.62,Default,,0,0,0,,!تبًا
Dialogue: 0,0:13:43.49,0:13:45.78,Default,,0,0,0,,!أنت لي
Dialogue: 0,0:13:46.83,0:13:48.17,Default,,0,0,0,,!لقد انتهيت
Dialogue: 0,0:13:51.50,0:13:52.38,Default,,0,0,0,,...ما هذا
Dialogue: 0,0:13:58.63,0:14:01.09,Default,,0,0,0,,!يايبا
Dialogue: 0,0:14:20.36,0:14:21.61,Default,,0,0,0,,أين أنا؟
Dialogue: 0,0:14:21.69,0:14:23.65,Default,,0,0,0,,!أنت هناك، عرف بنفسك
Dialogue: 0,0:14:25.74,0:14:30.25,Default,,0,0,0,,!كان ذلك كاميئيناغا إيمامورا، سيد سيتسو
Dialogue: 0,0:14:32.12,0:14:35.04,Default,,0,0,0,,انتظر... ما هذا المكان؟
Dialogue: 0,0:14:36.46,0:14:38.42,Default,,0,0,0,,أين ساياكا؟ أين الجميع؟
Dialogue: 0,0:14:38.50,0:14:40.17,Default,,0,0,0,,وماذا حدث لكوجيرو؟
Dialogue: 0,0:14:40.25,0:14:42.04,Default,,0,0,0,,ما الذي يحدث؟
Dialogue: 0,0:14:42.13,0:14:44.63,Default,,0,0,0,,!لا يهم! تخلص منهم
Dialogue: 0,0:14:46.80,0:14:48.51,Default,,0,0,0,,!هذه سيوف حقيقية
Dialogue: 0,0:14:48.60,0:14:50.73,Default,,0,0,0,,هل أنتم أعوان أونيمارو؟
Dialogue: 0,0:14:52.39,0:14:53.68,Default,,0,0,0,,...يا رجل، هيا
Dialogue: 0,0:14:54.27,0:14:55.15,Default,,0,0,0,,!توقف الآن
Dialogue: 0,0:14:57.90,0:15:00.11,Default,,0,0,0,,أليس خصمك صغيرًا بشكل غير معتاد؟
Dialogue: 0,0:15:00.19,0:15:02.57,Default,,0,0,0,,...أن يتجمع الساموراي ضد طفل
Dialogue: 0,0:15:02.65,0:15:05.15,Default,,0,0,0,,!وقاحة! قل اسمك
Dialogue: 0,0:15:05.95,0:15:07.74,Default,,0,0,0,,.أنا رونين من ساكوشو
Dialogue: 0,0:15:09.70,0:15:11.08,Default,,0,0,0,,.موساشي مياموتو
Dialogue: 0,0:15:12.37,0:15:13.66,Default,,0,0,0,,...موساشي
Dialogue: 0,0:15:13.75,0:15:16.17,Default,,0,0,0,,.موساشي مياموتو
Dialogue: 0,0:15:16.75,0:15:20.67,Default,,0,0,0,,السيف العظيم الذي هزم مئات الأعداء بمفرده؟
Dialogue: 0,0:15:21.55,0:15:24.01,Default,,0,0,0,,.لا أعرف إذا كنت مستحقًا لهذا الثناء
Dialogue: 0,0:15:25.26,0:15:27.30,Default,,0,0,0,,.لا نبحث عن المشاكل
Dialogue: 0,0:15:27.80,0:15:29.51,Default,,0,0,0,,!انسحبوا
Dialogue: 0,0:15:33.72,0:15:36.85,Default,,0,0,0,,هل أنت حقًا... موساشي؟
Dialogue: 0,0:15:38.48,0:15:41.48,Default,,0,0,0,,أنت تعرف اسمي؟
Dialogue: 0,0:15:41.57,0:15:44.16,Default,,0,0,0,,...يمكنك قول ذلك
Dialogue: 0,0:15:46.57,0:15:49.41,Default,,0,0,0,,في أي عام نحن؟
Dialogue: 0,0:15:49.99,0:15:52.08,Default,,0,0,0,,.هذا عام كيتشو 17، 1612
Dialogue: 0,0:15:52.16,0:15:54.29,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:15:55.75,0:15:57.09,Default,,0,0,0,,أعتقد أننا انتقلنا
Dialogue: 0,0:15:57.16,0:16:00.91,Default,,0,0,0,,!400 عام إلى الوراء إلى فترة إيدو
Dialogue: 0,0:16:01.00,0:16:02.88,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:16:04.76,0:16:07.22,Default,,0,0,0,,ماذا تقصد بـ "انتقال زمني"؟
Dialogue: 0,0:16:12.60,0:16:16.31,Default,,0,0,0,,تقول أنك جئت من المستقبل؟
Dialogue: 0,0:16:16.39,0:16:17.72,Default,,0,0,0,,.نعم
Dialogue: 0,0:16:17.81,0:16:19.60,Default,,0,0,0,,.من الصعب تصديق ذلك
Dialogue: 0,0:16:20.35,0:16:23.69,Default,,0,0,0,,كيف انتهى بنا المطاف في الماضي؟
Dialogue: 0,0:16:24.32,0:16:26.41,Default,,0,0,0,,...يجب أن نعود سريعًا، وإلا
Dialogue: 0,0:16:27.11,0:16:29.90,Default,,0,0,0,,قال الملك أونيمارو أن مونوهوشيزاو لديه القوة
Dialogue: 0,0:16:29.99,0:16:32.70,Default,,0,0,0,,.لكسر قواعد الزمان والمكان
Dialogue: 0,0:16:32.78,0:16:36.83,Default,,0,0,0,,يبدو أن السيد العنكبوت استخدمه لفتح ممر عبر الزمان والمكان
Dialogue: 0,0:16:36.91,0:16:40.33,Default,,0,0,0,,.لإحضار كوجيرو إلى المستقبل
Dialogue: 0,0:16:40.42,0:16:43.92,Default,,0,0,0,,إذن سقطنا عبر ذلك البوابة؟
Dialogue: 0,0:16:44.46,0:16:47.80,Default,,0,0,0,,هل هذا يعني أن كوجيرو ليس هنا؟
Dialogue: 0,0:16:47.88,0:16:49.51,Default,,0,0,0,,.أخشى أنه ليس هنا
Dialogue: 0,0:16:50.09,0:16:54.01,Default,,0,0,0,,.سأخوض مبارزة مع كوجيرو بعد سبعة أيام
Dialogue: 0,0:16:54.10,0:16:55.44,Default,,0,0,0,,،سأهزمه
Dialogue: 0,0:16:55.51,0:16:58.26,Default,,0,0,0,,...وسيصبح لقب الأقوى في اليابان ملكي
Dialogue: 0,0:16:58.35,0:17:00.77,Default,,0,0,0,,!موساشي لا يقارن بي
Dialogue: 0,0:17:01.81,0:17:04.77,Default,,0,0,0,,!أنا، كوجيرو، أفضل سيف في اليابان
Dialogue: 0,0:17:04.86,0:17:06.45,Default,,0,0,0,,!بالطبع أنت كذلك
Dialogue: 0,0:17:06.53,0:17:07.36,Default,,0,0,0,,!نعم
Dialogue: 0,0:17:10.15,0:17:11.86,Default,,0,0,0,,!كوجيرو
Dialogue: 0,0:17:14.28,0:17:16.24,Default,,0,0,0,,أليس هذا كوجيرو؟
Dialogue: 0,0:17:16.33,0:17:18.75,Default,,0,0,0,,إذن هذا الرجل القذر هو موساشي؟
Dialogue: 0,0:17:19.29,0:17:22.04,Default,,0,0,0,,.المجزرة على وشك أن تبدأ
Dialogue: 0,0:17:22.12,0:17:23.71,Default,,0,0,0,,!إنها مبارزة
Dialogue: 0,0:17:32.59,0:17:33.92,Default,,0,0,0,,!انظر
Dialogue: 0,0:17:36.39,0:17:37.98,Default,,0,0,0,,!انتبه
Dialogue: 0,0:17:49.19,0:17:51.90,Default,,0,0,0,,!مذهل! لقد حولوا الخشب إلى عيدان تناول الطعام
Dialogue: 0,0:17:52.45,0:17:54.87,Default,,0,0,0,,!وأسماؤهم منقوشة عليها
Dialogue: 0,0:17:54.95,0:17:57.58,Default,,0,0,0,,!10,000 لكل منهما بالضبط
Dialogue: 0,0:17:57.66,0:17:59.33,Default,,0,0,0,,.إنهما متساويان في القوة
Dialogue: 0,0:18:01.41,0:18:03.58,Default,,0,0,0,,.لقد تحسنت، موساشي
Dialogue: 0,0:18:03.67,0:18:04.80,Default,,0,0,0,,.وأنت أيضًا
Dialogue: 0,0:18:05.54,0:18:08.63,Default,,0,0,0,,.سنخوض المبارزة بعد سبعة أيام، بحرية وبدون تردد
Dialogue: 0,0:18:09.21,0:18:10.67,Default,,0,0,0,,.لا داعي لتذكيري
Dialogue: 0,0:18:11.88,0:18:13.26,Default,,0,0,0,,.أقسم ذلك على سيفي
Dialogue: 0,0:18:14.72,0:18:16.60,Default,,0,0,0,,.كوجيرو هناك
Dialogue: 0,0:18:17.39,0:18:18.56,Default,,0,0,0,,،الآن بعد أن ذكرت ذلك
Dialogue: 0,0:18:18.64,0:18:22.06,Default,,0,0,0,,.قال الملك أونيمارو أن جسده لا يزال صالحًا للاستخدام
Dialogue: 0,0:18:22.14,0:18:26.27,Default,,0,0,0,,...كوجيرو في عصرنا ظهر عند قبره
Dialogue: 0,0:18:27.82,0:18:30.03,Default,,0,0,0,,هل يمكن أن يكون السيد العنكبوت قد فتح بوابة
Dialogue: 0,0:18:30.11,0:18:32.49,Default,,0,0,0,,تعود إلى لحظة موت كوجيرو
Dialogue: 0,0:18:32.57,0:18:37.62,Default,,0,0,0,,ثم أخذ روحه ووضعها في جثته في التابوت
Dialogue: 0,0:18:37.70,0:18:40.04,Default,,0,0,0,,لإحيائه؟
Dialogue: 0,0:18:41.20,0:18:44.58,Default,,0,0,0,,.لأننا سقطنا عبر تلك البوابة
Dialogue: 0,0:18:44.67,0:18:47.84,Default,,0,0,0,,.ربما سافرنا إلى وقت أبعد من موته
Dialogue: 0,0:18:48.46,0:18:49.75,Default,,0,0,0,,،حسنًا، إذا كان هذا صحيحًا
Dialogue: 0,0:18:49.84,0:18:52.97,Default,,0,0,0,,فستظهر تلك البوابة مرة أخرى عندما يفوز موساشي، أليس كذلك؟
Dialogue: 0,0:18:53.05,0:18:56.80,Default,,0,0,0,,!ثم يمكننا العودة إلى ساياكا والفريق
Dialogue: 0,0:18:56.89,0:18:58.39,Default,,0,0,0,,!تم الاتفاق
Dialogue: 0,0:18:58.47,0:18:59.89,Default,,0,0,0,,!سآتي لأجلك، كوجيرو
Dialogue: 0,0:18:59.97,0:19:01.60,Default,,0,0,0,,سأصبح أقوى
Dialogue: 0,0:19:01.68,0:19:04.52,Default,,0,0,0,,!وسيكون لدينا مبارزة ثانية عندما أعود
Dialogue: 0,0:19:10.73,0:19:11.86,Default,,0,0,0,,!سيد موساشي
Dialogue: 0,0:19:13.19,0:19:14.61,Default,,0,0,0,,أحضرت ضيوفًا؟
Dialogue: 0,0:19:15.15,0:19:18.53,Default,,0,0,0,,أنا أوتسو. هل يمكنني معرفة أسمائكم؟
Dialogue: 0,0:19:21.12,0:19:24.75,Default,,0,0,0,,إذن أنتم لستم من هذا الزمن؟
Dialogue: 0,0:19:24.83,0:19:26.17,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,0:19:26.25,0:19:27.96,Default,,0,0,0,,.يبدو الأمر كذلك
Dialogue: 0,0:19:29.63,0:19:32.22,Default,,0,0,0,,هل يتدرب دائمًا هكذا؟
Dialogue: 0,0:19:32.71,0:19:34.30,Default,,0,0,0,,.نعم، كل يوم
Dialogue: 0,0:19:34.38,0:19:38.89,Default,,0,0,0,,.لم يفوّت السيد موساشي يومًا واحدًا من التدريب على السيف
Dialogue: 0,0:19:38.97,0:19:40.76,Default,,0,0,0,,.مثل هذا التفاني والجدية
Dialogue: 0,0:19:40.85,0:19:43.31,Default,,0,0,0,,إذن ما الذي حدث بالضبط؟
Dialogue: 0,0:19:46.64,0:19:50.44,Default,,0,0,0,,.مبارزته مع السيد كوجيرو بعد أيام قليلة
Dialogue: 0,0:19:50.52,0:19:52.36,Default,,0,0,0,,.فهمت
Dialogue: 0,0:19:53.69,0:19:56.44,Default,,0,0,0,,.موساشي يهزم كوجيرو
Dialogue: 0,0:19:58.32,0:19:59.40,Default,,0,0,0,,...قل لي، موساشي
Dialogue: 0,0:20:00.49,0:20:04.12,Default,,0,0,0,,كوجيرو يستخدم تقنية ما، أليس كذلك؟
Dialogue: 0,0:20:04.20,0:20:06.29,Default,,0,0,0,,هل تقصد تسوباميغايشي؟
Dialogue: 0,0:20:07.37,0:20:09.41,Default,,0,0,0,,هل يمكنك هزيمتها؟
Dialogue: 0,0:20:10.25,0:20:14.13,Default,,0,0,0,,،تسوباميغايشي تبدأ بضربة لأسفل
Dialogue: 0,0:20:14.21,0:20:15.79,Default,,0,0,0,,،ويجب على الخصم الدفاع
Dialogue: 0,0:20:15.88,0:20:17.80,Default,,0,0,0,,.ثم ضربة سريعة لأعلى
Dialogue: 0,0:20:18.30,0:20:22.39,Default,,0,0,0,,.إنها سريعة كالبرق، مثل عصفور يتحرك، ومن هنا جاء الاسم
Dialogue: 0,0:20:23.10,0:20:24.94,Default,,0,0,0,,.كوجيرو سيد
Dialogue: 0,0:20:25.43,0:20:28.48,Default,,0,0,0,,.بمجرد أن تمنع، ستُقطع إلى أشلاء
Dialogue: 0,0:20:29.23,0:20:31.86,Default,,0,0,0,,كيف ستغلب ذلك؟
Dialogue: 0,0:20:33.23,0:20:35.07,Default,,0,0,0,,.الهجوم للأمام، تاركًا الخوف خلفك
Dialogue: 0,0:20:36.11,0:20:38.03,Default,,0,0,0,,.إنها طريق النصر المؤكد
Dialogue: 0,0:20:38.11,0:20:39.03,Default,,0,0,0,,فقط هذا؟
Dialogue: 0,0:20:39.53,0:20:40.41,Default,,0,0,0,,.بالضبط
Dialogue: 0,0:20:40.95,0:20:44.25,Default,,0,0,0,,.لكن لديه ماكن يتمدد
Dialogue: 0,0:20:44.91,0:20:48.71,Default,,0,0,0,,الاعتقاد بأنه يمكن تحقيق ميزة بقطع الخصم من بعيد
Dialogue: 0,0:20:48.79,0:20:51.54,Default,,0,0,0,,.هو فلسفة خاطئة
Dialogue: 0,0:20:52.04,0:20:54.33,Default,,0,0,0,,،إذا استطعت اختراق دفاع الخصم
Dialogue: 0,0:20:54.42,0:20:56.13,Default,,0,0,0,,.فالنصر ليس بعيدًا
Dialogue: 0,0:20:56.21,0:20:57.13,Default,,0,0,0,,...بالإضافة
Dialogue: 0,0:20:57.63,0:21:03.26,Default,,0,0,0,,.لا يقبل أي ساموراي مبارزة إلا بالنصر في ذهنه
Dialogue: 0,0:21:03.93,0:21:05.64,Default,,0,0,0,,لكن ألست خائفًا؟
Dialogue: 0,0:21:05.72,0:21:08.01,Default,,0,0,0,,...أن يكون لدي خوف
Dialogue: 0,0:21:08.89,0:21:11.35,Default,,0,0,0,,.يعني أنني لم أتدرب بما يكفي
Dialogue: 0,0:21:11.94,0:21:16.28,Default,,0,0,0,,.مع التدريب يأتي الثقة
Dialogue: 0,0:21:16.36,0:21:19.07,Default,,0,0,0,,.والثقة تنتقل عبر السيف
Dialogue: 0,0:21:19.65,0:21:21.53,Default,,0,0,0,,.الثقة تجلب النصر
Dialogue: 0,0:21:23.57,0:21:26.95,Default,,0,0,0,,.الأهم هو الإيمان بقدراتك
Dialogue: 0,0:21:28.95,0:21:30.83,Default,,0,0,0,,،استمر في التدريب، يومًا بعد يوم
Dialogue: 0,0:21:30.91,0:21:34.04,Default,,0,0,0,,.ويومًا ما ستتفهم أيضًا، يايبا
Dialogue: 0,0:21:34.75,0:21:38.50,Default,,0,0,0,,هل ستتدربني، حتى مبارزتك، موساشي؟
Dialogue: 0,0:21:39.72,0:21:41.31,Default,,0,0,0,,.نعم. يمكننا ذلك
Dialogue: 0,0:21:42.01,0:21:43.22,Default,,0,0,0,,.حسنًا، إذن
Dialogue: 0,0:21:44.09,0:21:45.34,Default,,0,0,0,,!لنبدأ
Dialogue: 0,0:21:54.44,0:21:58.82,Default,,0,0,0,,!بغض النظر عن المبارزة، الفوز يأتي بالمبادرة، المبادرة، المبادرة
Dialogue: 0,0:21:58.49,0:22:06.05,Ending,,0,0,0,,"ضُربتُ ببرقٍ حلوٍ لاذع، وانشغلت تماماً، يا "أومي
Dialogue: 0,0:22:00.03,0:22:04.91,Default,,0,0,0,,!جهز نفسك للهجوم، والسيف سيتبع
Dialogue: 0,0:22:06.24,0:22:14.03,Ending,,0,0,0,,تذوقت طعامك وانفجرتُ في الطريق
Dialogue: 0,0:22:09.20,0:22:11.29,Default,,0,0,0,,.تدريبك لن يخونك أبدًا
Dialogue: 0,0:22:11.79,0:22:15.38,Default,,0,0,0,,.التدريبات الكثيرة هي ما تظهر قدراتك
Dialogue: 0,0:22:14.65,0:22:18.53,Ending,,0,0,0,,ينبثق من أعماق قلبي شعور غامض، لم أعرفه من قبل
Dialogue: 0,0:22:18.60,0:22:22.57,Ending,,0,0,0,,كعكة اللحظة المنتظرة في كل احتفال مميز
Dialogue: 0,0:22:20.34,0:22:22.26,Default,,0,0,0,,.حسنًا، هذا كل شيء
Dialogue: 0,0:22:22.60,0:22:26.31,Ending,,0,0,0,,نظرنا إلى بعضنا البعض وقلنا "إنه لذيذ"
Dialogue: 0,0:22:22.84,0:22:25.05,Default,,0,0,0,,ماذا؟ هذا كل شيء؟
Dialogue: 0,0:22:26.09,0:22:27.88,Default,,0,0,0,,.لقد مرت ستة أيام
Dialogue: 0,0:22:26.39,0:22:29.58,Ending,,0,0,0,,"إنه لذيذ"، قلنا، ونحن ننظر إلى بعضنا البعض.
Dialogue: 0,0:22:27.97,0:22:30.47,Default,,0,0,0,,.المبارزة غدًا
Dialogue: 0,0:22:29.67,0:22:33.26,Ending,,0,0,0,,تلك الأيام التي تخطفك من الواقع بجمالها
Dialogue: 0,0:22:31.06,0:22:34.27,Default,,0,0,0,,.التدريب أكثر من مجرد تأرجح السيف
Dialogue: 0,0:22:33.28,0:22:37.62,Ending,,0,0,0,,...أتمنى أن تدوم
Dialogue: 0,0:22:34.77,0:22:37.69,Default,,0,0,0,,.أخشى أن انتصار السيد موساشي غير مضمون
Dialogue: 0,0:22:37.63,0:22:41.65,Ending,,0,0,0,,كأنه يتمنى، وكأنني أرجو
Dialogue: 0,0:22:39.36,0:22:40.90,Default,,0,0,0,,!سيكون بخير
Dialogue: 0,0:22:40.98,0:22:42.11,Default,,0,0,0,,!أنا متأكد
Dialogue: 0,0:22:41.64,0:22:45.24,Ending,,0,0,0,,أتذوقها واحدةً تلو الأخرى
Dialogue: 0,0:22:42.61,0:22:48.07,Default,,0,0,0,,!موساشي سيصل متأخرًا عمدًا لإزعاج كوجيرو والفوز
Dialogue: 0,0:22:45.26,0:22:49.32,Ending,,0,0,0,,فوق أضواء الزينة
Dialogue: 0,0:22:48.78,0:22:51.78,Default,,0,0,0,,!السيد موساشي لن يلجأ إلى مثل هذه الجبن
Dialogue: 0,0:22:49.34,0:22:53.22,Ending,,0,0,0,,ستقوم بتلوينه كما تشاء
Dialogue: 0,0:22:52.79,0:22:56.54,Default,,0,0,0,,.قال إنها فن الحرب أو شيء من هذا القبيل
Dialogue: 0,0:22:53.47,0:22:57.12,Ending,,0,0,0,,لا أحد يستطيع أن يفعل ذلك
Dialogue: 0,0:22:56.63,0:22:57.92,Default,,0,0,0,,أليس كذلك، موساشي؟
Dialogue: 0,0:22:57.23,0:23:02.03,Ending,,0,0,0,,لا أستطيع مساعدته، لا أستطيع أن أتركه
Dialogue: 0,0:22:58.71,0:23:01.84,Default,,0,0,0,,!عدم احترام وقت المبارزة عار على شرف الساموراي
Dialogue: 0,0:23:01.92,0:23:04.84,Default,,0,0,0,,!ليس لدي أي نية لمثل هذا الشيء
Dialogue: 0,0:23:05.93,0:23:07.18,Default,,0,0,0,,أرأيت؟
Dialogue: 0,0:23:07.76,0:23:09.30,Default,,0,0,0,,...لكن
Dialogue: 0,0:23:10.60,0:23:12.14,Default,,0,0,0,,.لدي شعور سيء
Dialogue: 0,0:23:12.22,0:23:14.22,Default,,0,0,0,,،إذا لم نتبع خطى التاريخ
Dialogue: 0,0:23:14.31,0:23:17.15,Default,,0,0,0,,...أخشى أننا قد نغير نتيجة المبارزة
Dialogue: 0,0:23:17.23,0:23:19.65,Default,,0,0,0,,...إذا خسر موساشي
Dialogue: 0,0:23:20.27,0:23:23.40,Default,,0,0,0,,،لن نتمكن من العودة
Dialogue: 0,0:23:24.53,0:23:25.45,Default,,0,0,0,,.مستحيل
Dialogue: 0,0:23:26.07,0:23:28.36,Default,,0,0,0,,إذن، ماذا سيحدث للجميع؟
Dialogue: 0,0:23:29.53,0:23:32.70,Default,,0,0,0,,!ماذا سيحدث لنا؟
Dialogue: 0,0:23:36.58,0:23:37.41,Default,,0,0,0,,!هذا مستحيل
Dialogue: 0,0:23:37.50,0:23:41.21,Default,,0,0,0,,يايبا انتقل إلى الماضي؟
Dialogue: 0,0:23:41.29,0:23:43.54,Default,,0,0,0,,!عد سريعًا، يايبا
Dialogue: 0,0:23:43.63,0:23:45.51,Default,,0,0,0,,ماذا سنفعل بدونك؟
Dialogue: 0,0:23:45.59,0:23:47.97,Default,,0,0,0,,.في الحلقة القادمة، "المبارزة في جزيرة جانريو."
Dialogue: 0,0:23:48.05,0:23:49.84,Default,,0,0,0,,حان وقت المبارزة، كوجيرو!
