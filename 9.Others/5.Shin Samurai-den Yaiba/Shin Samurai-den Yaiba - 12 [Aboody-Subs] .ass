Dialogue: 0,0:00:17.10,0:00:20.11,Default,,0,0,0,,قلعة أونيمارو عادت إلى الظهور
Dialogue: 0,0:00:20.19,0:00:23.82,Default,,0,0,0,,قلعة جديدة من نوع ما، بالإضافة إلى احتلال حديقة غونما سفاري
Dialogue: 0,0:00:23.90,0:00:25.65,Default,,0,0,0,,.ومتحف نييغاتا للعلوم
Dialogue: 0,0:00:25.74,0:00:28.78,Default,,0,0,0,,موسعًا سيطرته على منطقة كانتو-كوشين.
Dialogue: 0,0:00:28.87,0:00:30.62,Default,,0,0,0,,.الحكومة في حالة تأهب قصوى
Dialogue: 0,0:00:30.70,0:00:32.33,Default,,0,0,0,,!أونيمارو! هذا الوغد
Dialogue: 0,0:00:32.41,0:00:35.62,Default,,0,0,0,,،كنا نظن أننا تخلصنا منه أخيرًا
Dialogue: 0,0:00:35.71,0:00:39.54,Default,,0,0,0,,...لكنه يخرج علينا بقلعة في السماء الآن
Dialogue: 0,0:00:40.09,0:00:43.38,Default,,0,0,0,,.الوضع ما زال مشكلًا للغاية
Dialogue: 0,0:00:43.46,0:00:45.55,Default,,0,0,0,,!لا أصدق ما أسمعه الآن
Dialogue: 0,0:00:45.63,0:00:48.64,Default,,0,0,0,,!فأنا لم أنتهِ بعد من حسابي معه
Dialogue: 0,0:00:51.43,0:00:55.31,Default,,0,0,0,,.للأسف، عليّ تأجيل مبارزتنا، كوروغاني يايبا
Dialogue: 0,0:00:57.77,0:00:58.98,Default,,0,0,0,,!شونوسوكي
Dialogue: 0,0:00:59.06,0:01:00.86,Default,,0,0,0,,!خذني إلى أونيمارو الآن
Dialogue: 0,0:01:02.15,0:01:02.98,Default,,0,0,0,,!انتظر
Dialogue: 0,0:01:05.36,0:01:08.41,Default,,0,0,0,,ماذا ستفعل الآن بدون تلك الجوهرة؟
Dialogue: 0,0:01:08.49,0:01:11.87,Default,,0,0,0,,.وتلك القلعة بعيدة جدًا بالنسبة لشونوسوكي
Dialogue: 0,0:01:13.62,0:01:15.66,Default,,0,0,0,,...لكن
Dialogue: 0,0:01:15.75,0:01:17.16,Default,,0,0,0,,.لا تستعجل
Dialogue: 0,0:01:17.71,0:01:21.25,Default,,0,0,0,,.المحارب لايستطيع رؤية طريق النصر
Dialogue: 0,0:01:21.33,0:01:23.92,Default,,0,0,0,,.إلا إذا كان مستعدًا لكل الاحتمالات
Dialogue: 0,0:01:25.84,0:01:27.01,Default,,0,0,0,,.فهمت
Dialogue: 0,0:01:28.93,0:01:30.80,Default,,0,0,0,,!إذن حان وقت التدريب
Dialogue: 0,0:01:30.89,0:01:32.80,Default,,0,0,0,,!سنعود للتدريب إذن!، كوجيرو، ساعدني
Dialogue: 0,0:01:34.93,0:01:36.77,Default,,0,0,0,, أين كوجيرو؟
Dialogue: 0,0:01:39.44,0:01:41.48,Default,,0,0,0,,!أنت معلم رائع، سيد كوجيرو
Dialogue: 0,0:01:42.02,0:01:43.40,Default,,0,0,0,,.أنت جميل جدًا
Dialogue: 0,0:01:45.73,0:01:49.95,Default,,0,0,0,,!هل رأيتم؟ مع هذه القطرات، عيوني لم تعد حمراء
Dialogue: 0,0:01:50.03,0:01:54.74,Default,,0,0,0,,!وأنا أجمل ساموراي، هذا يجعلني أكثر جمالًا
Dialogue: 0,0:01:55.99,0:01:56.91,Default,,0,0,0,,!أنت لطيف جدًا
Dialogue: 0,0:01:59.96,0:02:01.75,Default,,0,0,0,,!يا له من محظوظ
Dialogue: 0,0:02:01.83,0:02:05.88,Default,,0,0,0,,!تدربوا بدلًا من أحلام اليقظة
Dialogue: 0,0:02:05.96,0:02:08.84,Default,,0,0,0,,!وأنت، أترك هاتفك و واجهني
Dialogue: 0,0:02:09.47,0:02:11.51,Default,,0,0,0,,.موتو، انظر إلى هذا
Dialogue: 0,0:02:13.26,0:02:16.10,Default,,0,0,0,,.فتاة تتحدى كل الدوجو في المنطقة
Dialogue: 0,0:02:16.18,0:02:18.85,Default,,0,0,0,,.الجميع يتحدث عن هذا على الإنترنت
Dialogue: 0,0:02:19.39,0:02:20.69,Default,,0,0,0,,هي تتحدى الدوجو؟
Dialogue: 0,0:02:33.66,0:02:35.95,Default,,0,0,0,,يايبا: أسطورة الساموراي
Dialogue: 0,0:02:37.36,0:02:39.57,Opening,,0,0,0,,الإرادة للفوز هي شهادة على جديتي
Dialogue: 0,0:02:39.46,0:02:42.51,Opening,,0,0,0,,لكنك لن تصدق ذلك، أليس كذلك؟
Dialogue: 0,0:02:42.42,0:02:44.87,Opening,,0,0,0,,المنطق السليم يمكن أن يكون عبئًا
Dialogue: 0,0:02:44.86,0:02:47.64,Opening,,0,0,0,,أستطيع التحدي لأني جاهل
Dialogue: 0,0:02:47.65,0:02:48.79,Opening,,0,0,0,,هل أنا "ساموراي حقيقي"؟
Dialogue: 0,0:02:48.80,0:02:50.06,Opening,,0,0,0,,أم مجرد "لاعب وقح"؟
Dialogue: 0,0:02:50.06,0:02:52.72,Opening,,0,0,0,,علي أن أتحدى لأني أريد أن أعرف
Dialogue: 0,0:02:52.71,0:02:58.08,Opening,,0,0,0,,الشغف في قلبي كان ساطعًا مثل البرق
Dialogue: 0,0:02:58.54,0:03:03.26,Opening,,0,0,0,,بغض النظر عن مقدار تغيرك
Dialogue: 0,0:03:03.52,0:03:07.95,Opening,,0,0,0,,لا يوجد كذب في المعارك التي خضناها
Dialogue: 0,0:03:07.95,0:03:12.70,Opening,,0,0,0,,أنا أمضي قدمًا بالشجاعة لأعيش بسرعة وتهور
Dialogue: 0,0:03:12.69,0:03:18.64,Opening,,0,0,0,,لأصل إلى القوة الجديدة المثيرة
Dialogue: 0,0:03:20.02,0:03:24.80,Opening,,0,0,0,,لنرفع سيوفنا نحو الغد
Dialogue: 0,0:03:24.81,0:03:29.83,Opening,,0,0,0,,أيقظ القوة الطبية 
Dialogue: 0,0:03:29.83,0:03:34.60,Opening,,0,0,0,,الآن تهب علينا الأقدار المحترقة
Dialogue: 0,0:03:34.60,0:03:39.52,Opening,,0,0,0,,سأقطع علامات اليأس
Dialogue: 0,0:03:39.52,0:03:41.34,Opening,,0,0,0,,بهذا "السيف" الحقيقي
Dialogue: 0,0:03:59.33,0:04:01.29,Default,,0,0,0,,...كوروغاني يايبا العزيز
Dialogue: 0,0:04:01.37,0:04:03.25,Default,,0,0,0,,.كم اشتقت إليك
Dialogue: 0,0:04:04.04,0:04:06.71,Default,,0,0,0,,...لقد كنت أبحث عنك منذ ثلاث سنوات
Dialogue: 0,0:04:06.79,0:04:10.30,Default,,0,0,0,,.علمتُ من خلال إنجازاتك الأخيرة أنك في طوكيو
Dialogue: 0,0:04:11.25,0:04:15.34,Default,,0,0,0,,...إذا كنت تتدرب في مكان قريب، فأنا أعلم أننا سنلتقي
Dialogue: 0,0:04:16.68,0:04:20.14,Default,,0,0,0,,!اميري يايبا … يجب أن أراك قريبًا
Dialogue: 0,0:04:21.39,0:04:26.31,Default,,0,0,0,,الحلقة 12: ناديشيكو ياماتو تصل
Dialogue: 0,0:04:27.02,0:04:29.77,Default,,0,0,0,,!معركة ضد أونيمارو تتطلب قوة تحمل
Dialogue: 0,0:04:29.86,0:04:34.74,Default,,0,0,0,,.هذا يعني أنك بحاجة إلى بناء أساس قوي ومتين
Dialogue: 0,0:04:34.82,0:04:37.16,Default,,0,0,0,,!يمكنك البدء بمسح الأرضيات يدويًا
Dialogue: 0,0:04:38.16,0:04:39.57,Default,,0,0,0,,!الآن! انطلق، انطلق، انطلق
Dialogue: 0,0:04:39.66,0:04:41.62,Default,,0,0,0,,!تحمل، يايبا
Dialogue: 0,0:04:44.08,0:04:45.16,Default,,0,0,0,,!التالي هو الغسيل
Dialogue: 0,0:04:46.37,0:04:47.96,Default,,0,0,0,,!الآن، الطبخ
Dialogue: 0,0:04:48.04,0:04:49.13,Default,,0,0,0,,!افرك ذلك الوعاء
Dialogue: 0,0:04:50.04,0:04:52.09,Default,,0,0,0,,!وضع كل جهدك فيه
Dialogue: 0,0:04:55.13,0:04:58.05,Default,,0,0,0,,هل هذا الشيء سيجعلني أقوى حقًا؟
Dialogue: 0,0:04:59.22,0:05:01.68,Default,,0,0,0,,!يكفي، توقف عن التذمر
Dialogue: 0,0:05:01.76,0:05:04.18,Default,,0,0,0,,!الآن، أريدك أن تتخيل أن هذه الأوساخ هي أونيمارو
Dialogue: 0,0:05:05.14,0:05:08.14,Default,,0,0,0,,!سيتطلب الأمر أكثر من ذلك لهزيمته
Dialogue: 0,0:05:10.56,0:05:14.48,Default,,0,0,0,,!عندما تنتهي، لا تنسَ المدخل والحديقة، حسنًا
Dialogue: 0,0:05:16.24,0:05:17.74,Default,,0,0,0,,!تبا
Dialogue: 0,0:05:17.82,0:05:20.20,Default,,0,0,0,,!لن أستسلم أبدًا
Dialogue: 0,0:05:20.28,0:05:22.53,Default,,0,0,0,,...التدريب ليس سهلًا
Dialogue: 0,0:05:23.79,0:05:25.41,Default,,0,0,0,,!لدي فكرة
Dialogue: 0,0:05:26.75,0:05:27.66,Default,,0,0,0,,ما هذه؟
Dialogue: 0,0:05:27.75,0:05:29.17,Default,,0,0,0,,.اعتقد انها صنادل حديدية
Dialogue: 0,0:05:29.25,0:05:32.92,Default,,0,0,0,,نعم، هل هذا خفيف جدًا بالنسبة لك؟
Dialogue: 0,0:05:33.00,0:05:34.38,Default,,0,0,0,, ماذا عن هذه؟
Dialogue: 0,0:05:36.42,0:05:39.38,Default,,0,0,0,,!يمكنني المشي بهذه بكل سهولة
Dialogue: 0,0:05:43.85,0:05:45.35,Default,,0,0,0,,!ثقيلة جدًا
Dialogue: 0,0:05:45.43,0:05:49.89,Default,,0,0,0,,.ستصبح أكثر قوة، إذا ارتديتها أثناء التدريب
Dialogue: 0,0:05:49.98,0:05:52.69,Default,,0,0,0,,!مسلسلي على وشك البدء
Dialogue: 0,0:05:53.31,0:05:56.23,Default,,0,0,0,,.اليوم هو المبارزة في جزيرة جانريو
Dialogue: 0,0:05:56.32,0:05:58.03,Default,,0,0,0,,كيف يمكن أن أفوت ذلك!؟
Dialogue: 0,0:05:59.57,0:06:00.78,Default,,0,0,0,,!يايبا
Dialogue: 0,0:06:01.87,0:06:04.16,Default,,0,0,0,,هل يمكنك شراء بعض الأشياء لي من المتجر؟
Dialogue: 0,0:06:04.24,0:06:05.08,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:06:05.16,0:06:08.29,Default,,0,0,0,,!أنا في منتصف التدريب
Dialogue: 0,0:06:08.37,0:06:11.88,Default,,0,0,0,,!حسنًا، جيروزايمون مشغول بأخذ الجدة للنزهة
Dialogue: 0,0:06:12.79,0:06:13.84,Default,,0,0,0,,!لقد سقط الملك
Dialogue: 0,0:06:15.21,0:06:19.92,Default,,0,0,0,,،الأم والأب مشغولان في العمل، أنت تعيش معنا
Dialogue: 0,0:06:20.01,0:06:22.80,Default,,0,0,0,,!لذا اذهب للتسوق دون تذمر
Dialogue: 0,0:06:22.89,0:06:25.76,Default,,0,0,0,,.حسنًا! جيد، سأفعل ذلك
Dialogue: 0,0:06:28.52,0:06:30.44,Default,,0,0,0,,!سأذهب، سأذهب
Dialogue: 0,0:06:36.48,0:06:38.57,Default,,0,0,0,,هل أنت متأكد أنك ستكون بخير؟
Dialogue: 0,0:06:38.65,0:06:40.53,Default,,0,0,0,,قلت أنني بخير، أليس كذلك؟
Dialogue: 0,0:06:40.61,0:06:43.20,Default,,0,0,0,,.صنادلك خطيرة، اخلعها
Dialogue: 0,0:06:43.28,0:06:45.66,Default,,0,0,0,,!يا… يايبا
Dialogue: 0,0:06:48.49,0:06:51.00,Default,,0,0,0,,وبدون انحرافات. فقط عد مباشرة إلى المنزل، حسنًا؟
Dialogue: 0,0:06:51.54,0:06:53.42,Default,,0,0,0,,...نعم، نعم
Dialogue: 0,0:06:57.96,0:06:59.38,Default,,0,0,0,,...أنتِ
Dialogue: 0,0:06:59.46,0:07:01.88,Default,,0,0,0,,.كيف تجرؤين على استغلال حبيبي يايبا
Dialogue: 0,0:07:02.97,0:07:04.18,Default,,0,0,0,,!سوف تدفعين الثمن
Dialogue: 0,0:07:08.47,0:07:10.31,Default,,0,0,0,,!مرحبًا
Dialogue: 0,0:07:10.81,0:07:11.64,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:07:11.73,0:07:13.52,Default,,0,0,0,,...أنتِ
Dialogue: 0,0:07:14.31,0:07:15.36,Default,,0,0,0,,!استعد
Dialogue: 0,0:07:15.44,0:07:16.73,Default,,0,0,0,,!احترس
Dialogue: 0,0:07:19.94,0:07:22.49,Default,,0,0,0,,!شاهدي ما سأفعله الآن
Dialogue: 0,0:07:22.57,0:07:25.20,Default,,0,0,0,,سايكا، هل يمكنك تسجيل هذا؟
Dialogue: 0,0:07:25.28,0:07:27.49,Default,,0,0,0,,!من فضلك، من أجل الذكرى
Dialogue: 0,0:07:28.45,0:07:30.91,Default,,0,0,0,,.الآن الناس يشاهدون ما يريدون متى يريدون
Dialogue: 0,0:07:31.00,0:07:33.29,Default,,0,0,0,,.لا داعي لفعل التسجيل بعد الآن
Dialogue: 0,0:07:35.83,0:07:37.29,Default,,0,0,0,,!نحن في مشكلة
Dialogue: 0,0:07:37.79,0:07:39.25,Default,,0,0,0,,ما كل هذا الضجة؟
Dialogue: 0,0:07:39.75,0:07:40.71,Default,,0,0,0,,موتو؟
Dialogue: 0,0:07:40.80,0:07:42.30,Default,,0,0,0,,!هناك شخص يتحدانا
Dialogue: 0,0:07:42.38,0:07:44.38,Default,,0,0,0,,!يتحدى الدوجو؟
Dialogue: 0,0:07:44.47,0:07:45.47,Default,,0,0,0,,!هذا سيء
Dialogue: 0,0:07:45.55,0:07:48.05,Default,,0,0,0,,!فقط عندما يكون الأب والجدة غائبين
Dialogue: 0,0:07:48.14,0:07:49.93,Default,,0,0,0,,.هذا نادر هذه الأيام
Dialogue: 0,0:07:50.01,0:07:52.98,Default,,0,0,0,,.يجب أن يكون قويًا جدًا إذا كان يتحدى الدوجوهات
Dialogue: 0,0:07:54.85,0:07:55.94,Default,,0,0,0,,...في الواقع
Dialogue: 0,0:07:56.02,0:07:58.61,Default,,0,0,0,,.إنها فتاة قوية بشكل استثنائي
Dialogue: 0,0:07:59.32,0:08:00.98,Default,,0,0,0,,!فتاة؟
Dialogue: 0,0:08:12.79,0:08:14.33,Default,,0,0,0,,...ما هذا
Dialogue: 0,0:08:16.54,0:08:18.58,Default,,0,0,0,,سيدتي ساياكا، ما الخطب؟
Dialogue: 0,0:08:24.51,0:08:26.88,Default,,0,0,0,,!إنها رائعة
Dialogue: 0,0:08:27.76,0:08:29.72,Default,,0,0,0,,.لدي شرطان
Dialogue: 0,0:08:29.80,0:08:32.52,Default,,0,0,0,,،إذا هزمت كل أعضاء هذا الدوجو
Dialogue: 0,0:08:32.60,0:08:34.43,Default,,0,0,0,,،فسوف تفرغون المكان
Dialogue: 0,0:08:34.52,0:08:36.81,Default,,0,0,0,,!وستفارقون كوروغاني يايبا
Dialogue: 0,0:08:37.48,0:08:39.27,Default,,0,0,0,,ماذا؟ لماذا يايبا؟
Dialogue: 0,0:08:42.32,0:08:45.11,Default,,0,0,0,,.سنعيش هنا فقط نحن الاثنان
Dialogue: 0,0:08:45.19,0:08:47.78,Default,,0,0,0,,من أنتِ بالضبط؟
Dialogue: 0,0:08:48.28,0:08:49.57,Default,,0,0,0,,.ادعيني ياماتو
Dialogue: 0,0:08:50.20,0:08:51.58,Default,,0,0,0,,!ناديشيكو ياماتو
Dialogue: 0,0:08:52.08,0:08:55.91,Default,,0,0,0,,!لقد وعدت يايبا بالزواج بي
Dialogue: 0,0:08:58.46,0:09:03.30,Default,,0,0,0,,!ماذا؟
Dialogue: 0,0:09:04.55,0:09:07.59,Default,,0,0,0,,الزواج؟
Dialogue: 0,0:09:09.72,0:09:13.39,Default,,0,0,0,,...حسنًا، البيض ولحم البقر
Dialogue: 0,0:09:14.72,0:09:17.39,Default,,0,0,0,,!واو، يجب أننا سنحصل على سوكيياكي الليلة
Dialogue: 0,0:09:18.35,0:09:20.02,Default,,0,0,0,,!سوكيياكي
Dialogue: 0,0:09:21.56,0:09:23.48,Default,,0,0,0,,!مستحيل! بالطبع لا
Dialogue: 0,0:09:25.78,0:09:29.45,Default,,0,0,0,,!أيها الأحمق! أنا فقط أحاول حماية الدوجو
Dialogue: 0,0:09:30.99,0:09:33.33,Default,,0,0,0,,هل هذا يعني أنكِ ستتبارزيني؟
Dialogue: 0,0:09:35.66,0:09:38.21,Default,,0,0,0,,!بالتأكيد، بكل سرور
Dialogue: 0,0:09:38.29,0:09:39.75,Default,,0,0,0,,!خذ هذا، كوجيرو
Dialogue: 0,0:09:40.38,0:09:44.17,Default,,0,0,0,,!سامحيني، لكنني لا أستطيع إيذاء جمال نادر كهذا
Dialogue: 0,0:09:44.25,0:09:47.47,Default,,0,0,0,,. ستسرق يايبا منا، إذا لم تفعل شيئًا
Dialogue: 0,0:09:47.55,0:09:51.43,Default,,0,0,0,,ساساكي كوجيرو العظيم سيكون خصمك.
Dialogue: 0,0:09:51.51,0:09:53.18,Default,,0,0,0,,!ستفعلها
Dialogue: 0,0:09:53.26,0:09:54.72,Default,,0,0,0,,.يا له من أحمق
Dialogue: 0,0:09:57.73,0:10:00.77,Default,,0,0,0,,!مثيرة للاهتمام! هيا، تقدمي
Dialogue: 0,0:10:00.85,0:10:02.02,Default,,0,0,0,,!حسنًا، لنبدأ
Dialogue: 0,0:10:02.77,0:10:03.98,Default,,0,0,0,,.كما تريد
Dialogue: 0,0:10:10.86,0:10:11.70,Default,,0,0,0,,فوقي؟
Dialogue: 0,0:10:15.87,0:10:17.12,Default,,0,0,0,,...فهمت الآن
Dialogue: 0,0:10:17.20,0:10:19.71,Default,,0,0,0,,.قد تكونين قوية… لكنك تفتقرين إلى الخبرة
Dialogue: 0,0:10:20.79,0:10:21.71,Default,,0,0,0,,إذن، ماذا عن هذا؟
Dialogue: 0,0:10:21.79,0:10:25.42,Default,,0,0,0,,لماذا لا تتركين يايبا وتخرجين معي؟
Dialogue: 0,0:10:26.05,0:10:28.67,Default,,0,0,0,,!سأعلمكِ كل شيء من الألف إلى الياء
Dialogue: 0,0:10:34.14,0:10:35.68,Default,,0,0,0,,.لا فائدة من الهروب
Dialogue: 0,0:10:42.19,0:10:43.06,Default,,0,0,0,,!استعدي
Dialogue: 0,0:10:43.65,0:10:45.11,Default,,0,0,0,,!انطلق! كوجيرو
Dialogue: 0,0:10:46.15,0:10:50.07,Default,,0,0,0,,...امدد! يا عامود الغسيل
Dialogue: 0,0:11:02.04,0:11:03.25,Default,,0,0,0,,!كوجيرو
Dialogue: 0,0:11:03.75,0:11:04.83,Default,,0,0,0,,!يا أحمق
Dialogue: 0,0:11:04.92,0:11:07.04,Default,,0,0,0,,!لا يمكنك مد سيف من الخيزران العادي
Dialogue: 0,0:11:07.13,0:11:09.67,Default,,0,0,0,,...عادة قديمة
Dialogue: 0,0:11:09.76,0:11:11.05,Default,,0,0,0,,من سيتحداني بعد ذلك؟
Dialogue: 0,0:11:14.59,0:11:16.47,Default,,0,0,0,,!دوري، يا فتاة
Dialogue: 0,0:11:16.55,0:11:19.60,Default,,0,0,0,,!لا يجب أن يكون كل شيء ليايبا
Dialogue: 0,0:11:19.68,0:11:20.68,Default,,0,0,0,,!موساشي
Dialogue: 0,0:11:20.77,0:11:24.19,Default,,0,0,0,,!هذا صحيح!، أمامك مياموتو موساشي العظيم
Dialogue: 0,0:11:24.27,0:11:27.52,Default,,0,0,0,,!هو الرجل الذي هزم كوجيرو في جزيرة جانريو
Dialogue: 0,0:11:51.42,0:11:53.26,Default,,0,0,0,,ما خطبكم يا رفاق؟
Dialogue: 0,0:11:53.34,0:11:55.43,Default,,0,0,0,,...أصبت بآلام في الظهر
Dialogue: 0,0:11:55.51,0:11:56.80,Default,,0,0,0,,حسنًا، من التالي؟
Dialogue: 0,0:11:59.31,0:12:00.77,Default,,0,0,0,,أليس هناك أحد لديه الشجاعة؟
Dialogue: 0,0:12:04.94,0:12:07.23,Default,,0,0,0,,--حسنًا، إذن الدوجو ويايبا سيكونان
Dialogue: 0,0:12:07.31,0:12:08.36,Default,,0,0,0,,!انتظري
Dialogue: 0,0:12:11.36,0:12:12.86,Default,,0,0,0,,!سأقاتلك
Dialogue: 0,0:12:12.94,0:12:16.07,Default,,0,0,0,,!لا، مستحيل! لستِ بمستواها
Dialogue: 0,0:12:17.28,0:12:19.45,Default,,0,0,0,,.إذن فتاة ضد فتاة
Dialogue: 0,0:12:20.16,0:12:22.37,Default,,0,0,0,,.أيها السادة، من فضلكم ابتعدوا
Dialogue: 0,0:12:22.45,0:12:24.96,Default,,0,0,0,,.هذه ستكون المبارزة الأخيرة
Dialogue: 0,0:12:25.04,0:12:26.46,Default,,0,0,0,,أي اعتراضات؟
Dialogue: 0,0:12:35.68,0:12:36.97,Default,,0,0,0,,!استعدي
Dialogue: 0,0:12:37.05,0:12:37.93,Default,,0,0,0,,!أنا قادمة
Dialogue: 0,0:12:50.73,0:12:51.82,Default,,0,0,0,,هذا كل شيء؟
Dialogue: 0,0:12:55.15,0:12:56.07,Default,,0,0,0,,!خذي هذا
Dialogue: 0,0:12:59.99,0:13:01.66,Default,,0,0,0,,...سيفي
Dialogue: 0,0:13:01.74,0:13:05.25,Default,,0,0,0,,.ببعض القوة والتركيز، تصبح العصا العادية سيفًا
Dialogue: 0,0:13:06.00,0:13:09.79,Default,,0,0,0,,.كل هذا العمل والتدريب كان لأصبح زوجة يايبا العزيز
Dialogue: 0,0:13:10.67,0:13:11.88,Default,,0,0,0,,زوجته؟
Dialogue: 0,0:13:11.96,0:13:14.76,Default,,0,0,0,,.لا بد أنكِ مخطئة -\N !بالتأكيد لا -
Dialogue: 0,0:13:15.51,0:13:17.47,Default,,0,0,0,,...كان ذلك… قبل ست سنوات
Dialogue: 0,0:13:17.55,0:13:21.30,Default,,0,0,0,,.أبي، المستكشف، أخذني في رحلة استكشافية إلى الغابة
Dialogue: 0,0:13:28.02,0:13:30.31,Default,,0,0,0,,أبي، أين أنت؟
Dialogue: 0,0:13:54.05,0:13:56.05,Default,,0,0,0,,!تبا! لقد هرب
Dialogue: 0,0:13:58.34,0:13:59.51,Default,,0,0,0,,من أنتِ؟
Dialogue: 0,0:14:00.13,0:14:02.93,Default,,0,0,0,,!كنت أحاول الإمساك به!، فقط ابتعدي عن الطريق
Dialogue: 0,0:14:03.01,0:14:03.89,Default,,0,0,0,,...المعذرة
Dialogue: 0,0:14:04.68,0:14:07.60,Default,,0,0,0,,!لقد أنقذت حياتي. شكرًا جزيلاً لك
Dialogue: 0,0:14:09.27,0:14:10.94,Default,,0,0,0,, هل يمكنك أن تخبرني باسمك؟
Dialogue: 0,0:14:11.44,0:14:14.98,Default,,0,0,0,,!أنا؟، أنا كوروغاني يايبا!، ساموراي
Dialogue: 0,0:14:20.40,0:14:23.66,Default,,0,0,0,,...اميري يايبا
Dialogue: 0,0:14:51.56,0:14:54.23,Default,,0,0,0,,ماذا؟، أنتِ تحبينني؟
Dialogue: 0,0:14:54.31,0:14:55.19,Default,,0,0,0,,!نعم
Dialogue: 0,0:14:55.27,0:14:58.61,Default,,0,0,0,,.سأتبعك مدى الحياة
Dialogue: 0,0:14:58.69,0:14:59.99,Default,,0,0,0,,!لا، مستحيل
Dialogue: 0,0:15:00.07,0:15:03.20,Default,,0,0,0,,.والدي دائمًا يقول، الشريك الضعيف الآن سيكون عثرة لاحقًا
Dialogue: 0,0:15:03.28,0:15:04.70,Default,,0,0,0,,ضعيفة؟
Dialogue: 0,0:15:05.41,0:15:08.91,Default,,0,0,0,,!إذن... سأجعل نفسي قوية
Dialogue: 0,0:15:10.33,0:15:11.50,Default,,0,0,0,,.لن أكون ضعيفة بعد الآن
Dialogue: 0,0:15:11.58,0:15:12.87,Default,,0,0,0,,...إذا استطعت فعل ذلك
Dialogue: 0,0:15:12.96,0:15:15.42,Default,,0,0,0,,هل ستسمح لي بأن أكون معك؟
Dialogue: 0,0:15:15.92,0:15:17.50,Default,,0,0,0,,هل تقبل؟
Dialogue: 0,0:15:20.92,0:15:23.47,Default,,0,0,0,,حسنًا، إذا أصبحتِ قوية، فلا مشكلة؟
Dialogue: 0,0:15:24.05,0:15:25.43,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:15:25.51,0:15:27.47,Default,,0,0,0,,!إذن فهذا وعد
Dialogue: 0,0:15:28.97,0:15:31.14,Default,,0,0,0,,.لم أنسَ تلك الكلمات أبداً
Dialogue: 0,0:15:32.39,0:15:34.60,Default,,0,0,0,,.إنه بارع، هذا الصغير -\N.نعم -
Dialogue: 0,0:15:35.15,0:15:36.86,Default,,0,0,0,,!أنتِ تكذبين! هذا غير ممكن
Dialogue: 0,0:15:36.94,0:15:39.15,Default,,0,0,0,,.يايبا العزيز لن يكذب أبداً
Dialogue: 0,0:15:40.86,0:15:42.11,Default,,0,0,0,,...يايبا
Dialogue: 0,0:15:42.61,0:15:44.32,Default,,0,0,0,,.قتالنا انتهى
Dialogue: 0,0:15:44.82,0:15:45.82,Default,,0,0,0,,!هيا استسلمي
Dialogue: 0,0:15:58.54,0:15:59.59,Default,,0,0,0,,!تبا
Dialogue: 0,0:15:59.67,0:16:02.97,Default,,0,0,0,,...هذه سايكا الملعونة جعلتني أشتري الكثير من الأشياء
Dialogue: 0,0:16:04.13,0:16:06.30,Default,,0,0,0,,!مرحبًا! لقد عدت
Dialogue: 0,0:16:06.84,0:16:08.93,Default,,0,0,0,,أين ذهب الجميع؟
Dialogue: 0,0:16:14.94,0:16:18.94,Default,,0,0,0,,!الآن، قبل أن تؤذي نفسك حقاً، استسلمي
Dialogue: 0,0:16:20.15,0:16:21.15,Default,,0,0,0,,!ساياكا
Dialogue: 0,0:16:21.23,0:16:23.65,Default,,0,0,0,,!توقفي فقط! أنتِ في حالة مزرية
Dialogue: 0,0:16:26.32,0:16:28.53,Default,,0,0,0,,.حسناً، إذن لم تتركي لي خياراً
Dialogue: 0,0:16:29.20,0:16:30.28,Default,,0,0,0,,،إلى اللقاء
Dialogue: 0,0:16:32.12,0:16:33.70,Default,,0,0,0,,!مهلاً
Dialogue: 0,0:16:34.33,0:16:35.96,Default,,0,0,0,,!يايبا، حبيبي
Dialogue: 0,0:16:37.42,0:16:41.88,Default,,0,0,0,,!أنتِ تلك الطفلة... من محل السوبا
Dialogue: 0,0:16:41.96,0:16:42.80,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:16:45.38,0:16:46.93,Default,,0,0,0,,محل السوبا؟
Dialogue: 0,0:16:49.30,0:16:50.26,Default,,0,0,0,,"طفلة"؟
Dialogue: 0,0:16:50.35,0:16:51.76,Default,,0,0,0,,عم تتحدث؟
Dialogue: 0,0:16:51.85,0:16:55.85,Default,,0,0,0,,!أنا متأكد. التقينا منذ وقت طويل في الغابة
Dialogue: 0,0:16:55.94,0:16:58.90,Default,,0,0,0,,...لن أكون ضعيفة بعد الآن. إذا استطعت فعل ذلك
Dialogue: 0,0:16:58.98,0:17:00.94,Default,,0,0,0,,هل ستسمح لي بأن أكون معك؟
Dialogue: 0,0:17:01.44,0:17:02.90,Default,,0,0,0,,هل تقبل؟
Dialogue: 0,0:17:03.57,0:17:06.24,Default,,0,0,0,,أقبل بعض السوبا؟
Dialogue: 0,0:17:07.40,0:17:08.95,Default,,0,0,0,,!من فضلك اقبل
Dialogue: 0,0:17:11.28,0:17:15.08,Default,,0,0,0,,حسنًا، إذا أصبحتِ قوية، فلا مشكلة؟
Dialogue: 0,0:17:15.16,0:17:16.91,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:17:17.00,0:17:18.62,Default,,0,0,0,,!إذن فهذا وعد
Dialogue: 0,0:17:19.58,0:17:22.71,Default,,0,0,0,,...العائلة تدير محل سوبا
Dialogue: 0,0:17:23.38,0:17:24.71,Default,,0,0,0,,.وهكذا حدث الأمر
Dialogue: 0,0:17:28.09,0:17:30.76,Default,,0,0,0,,"أيها الأحمق! قالت، "هل تقبل؟
Dialogue: 0,0:17:30.85,0:17:33.26,Default,,0,0,0,,"بمعنى "هل تقبل زواجي؟
Dialogue: 0,0:17:33.76,0:17:35.47,Default,,0,0,0,,ماذا؟ كيف؟
Dialogue: 0,0:17:43.19,0:17:45.28,Default,,0,0,0,,.وداعاً، يايبا حبيبي
Dialogue: 0,0:17:46.11,0:17:47.53,Default,,0,0,0,,!مهلاً! انتظري دقيقة
Dialogue: 0,0:17:50.20,0:17:52.95,Default,,0,0,0,,هل هزمتِ كل هؤلاء بمفردك؟
Dialogue: 0,0:17:55.16,0:17:57.45,Default,,0,0,0,,إذن هل ستتدربين معي؟
Dialogue: 0,0:17:57.96,0:18:00.25,Default,,0,0,0,,هل يمكنني؟
Dialogue: 0,0:18:00.33,0:18:03.84,Default,,0,0,0,,!نعم! أحب الأشخاص الأقوياء
Dialogue: 0,0:18:04.38,0:18:08.47,Default,,0,0,0,,!وسأصبح أقوى بكثير إذا أردت هزيمة أونيمارو
Dialogue: 0,0:18:10.22,0:18:11.09,Default,,0,0,0,,!نعم
Dialogue: 0,0:18:25.02,0:18:26.07,Default,,0,0,0,,...ساياكا
Dialogue: 0,0:18:27.32,0:18:29.57,Default,,0,0,0,,!أحب الأشخاص الأقوياء
Dialogue: 0,0:18:31.24,0:18:32.66,Default,,0,0,0,,.يمكنني أن أكون قوية أيضاً
Dialogue: 0,0:18:38.62,0:18:39.83,Default,,0,0,0,,.هذا من أجلكم
Dialogue: 0,0:18:44.88,0:18:46.09,Default,,0,0,0,,...مع ذلك
Dialogue: 0,0:18:48.26,0:18:52.18,Default,,0,0,0,,.يجب أن أجد طريقة للوصول إلى أونيمارو
Dialogue: 0,0:18:52.26,0:18:55.80,Default,,0,0,0,,.لا يهم كم سأتدرب إذا لم أستطع قتاله
Dialogue: 0,0:18:55.89,0:18:57.93,Default,,0,0,0,,يايبا عزيزي، هل تريد المزيد؟
Dialogue: 0,0:18:58.02,0:18:59.35,Default,,0,0,0,,!نعم! بالتأكيد
Dialogue: 0,0:19:00.39,0:19:03.85,Default,,0,0,0,,.بالطبع لا! لديك تدريب بعد ذلك
Dialogue: 0,0:19:03.94,0:19:06.07,Default,,0,0,0,,.لا يمكنك أن تملأ نفسك هكذا
Dialogue: 0,0:19:06.15,0:19:08.28,Default,,0,0,0,,.لا، الآن هو الوقت المناسب ليأكل
Dialogue: 0,0:19:08.36,0:19:11.24,Default,,0,0,0,,لا يمكنك القتال على معدة فارغة، أليس كذلك؟
Dialogue: 0,0:19:11.32,0:19:12.57,Default,,0,0,0,,!لا
Dialogue: 0,0:19:12.66,0:19:14.78,Default,,0,0,0,,!سأفعلها -\N!قلت لا -
Dialogue: 0,0:19:15.70,0:19:17.33,Default,,0,0,0,,.طاولتنا أصبحت مزدحمة جداً
Dialogue: 0,0:19:18.79,0:19:20.50,Default,,0,0,0,,...لو كنت أستطيع الطيران
Dialogue: 0,0:19:21.04,0:19:22.79,Default,,0,0,0,,!أراهن أنك تستطيع
Dialogue: 0,0:19:23.33,0:19:24.42,Default,,0,0,0,,!والدي -\N!عمي -
Dialogue: 0,0:19:24.50,0:19:25.92,Default,,0,0,0,,من أنت؟
Dialogue: 0,0:19:27.13,0:19:28.21,Default,,0,0,0,,...أنت
Dialogue: 0,0:19:28.30,0:19:31.84,Default,,0,0,0,,.سيد مياموتو العجوز! ، إذن ما زلت حيًا كما أرى
Dialogue: 0,0:19:31.92,0:19:32.76,Default,,0,0,0,,...أيها الوغد
Dialogue: 0,0:19:32.84,0:19:36.01,Default,,0,0,0,,ماذا فعلت بسيفي كوتيتسو الشهير الذي خدعتني به؟
Dialogue: 0,0:19:36.68,0:19:39.97,Default,,0,0,0,,.كان ذلك منذ وقت طويل. دعنا ننسى الماضي
Dialogue: 0,0:19:40.06,0:19:42.85,Default,,0,0,0,,يا ابي! هل ما قلته صحيح؟
Dialogue: 0,0:19:43.35,0:19:44.90,Default,,0,0,0,,!حسناً، اهدأ
Dialogue: 0,0:19:45.48,0:19:46.98,Default,,0,0,0,,،كما سمعت
Dialogue: 0,0:19:47.06,0:19:51.24,Default,,0,0,0,,.يبدو أن هناك كرة تسمح لك بالطيران إذا وضعتها في ذلك السيف
Dialogue: 0,0:19:51.32,0:19:53.90,Default,,0,0,0,,رائع!، هل يمكنها فعل ذلك حقاً؟
Dialogue: 0,0:19:53.99,0:19:56.28,Default,,0,0,0,,.إنها تسمى كرة حاكم التنين
Dialogue: 0,0:19:56.37,0:19:58.45,Default,,0,0,0,,،لكنني لا أعرف أين هي
Dialogue: 0,0:19:58.53,0:20:02.25,Default,,0,0,0,,.ولكن يقال أن هناك خريطة لموقعها
Dialogue: 0,0:20:02.33,0:20:06.33,Default,,0,0,0,,.ربما هي مجرد خرافة قديمة
Dialogue: 0,0:20:06.42,0:20:07.42,Default,,0,0,0,,...المعذرة
Dialogue: 0,0:20:08.34,0:20:12.05,Default,,0,0,0,,.بخصوص تلك الخريطة، أعتقد أنني رأيتها من قبل
Dialogue: 0,0:20:13.26,0:20:14.51,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:20:14.59,0:20:18.68,Default,,0,0,0,,.نعم. كان والدي فخوراً بها جداً
Dialogue: 0,0:20:20.01,0:20:24.89,Default,,0,0,0,,،أظهرت الخريطة عدة مواقع محتملة للكرة
Dialogue: 0,0:20:25.44,0:20:29.27,Default,,0,0,0,,.ولكن لم تحدد أي منها هو المكان الحقيقي
Dialogue: 0,0:20:33.11,0:20:36.36,Default,,0,0,0,,إذن كل ما علي فعله هو الذهاب إلى كل موقع على الخريطة
Dialogue: 0,0:20:36.45,0:20:39.41,Default,,0,0,0,,!وسأجد كرة حاكم التنين
Dialogue: 0,0:20:39.49,0:20:41.70,Default,,0,0,0,,!نعم! هذه الروح، يايبا
Dialogue: 0,0:20:42.20,0:20:46.96,Default,,0,0,0,,!لنحصل على كرة حاكم التنين وننهي أونيمارو
Dialogue: 0,0:20:47.04,0:20:47.88,Default,,0,0,0,,!صحيح
Dialogue: 0,0:20:48.75,0:20:49.84,Default,,0,0,0,,!حسناً
Dialogue: 0,0:20:49.92,0:20:53.05,Default,,0,0,0,,!سنجدها... كرة حاكم التنين لنا
Dialogue: 0,0:21:09.99,0:21:17.55,Ending,,0,0,0,,"ضُربتُ ببرقٍ حلوٍ لاذع، وانشغلت تماماً، يا "أومي
Dialogue: 0,0:21:17.74,0:21:25.53,Ending,,0,0,0,,تذوقت طعامك وانفجرتُ في الطريق
Dialogue: 0,0:21:26.15,0:21:30.03,Ending,,0,0,0,,ينبثق من أعماق قلبي شعور غامض، لم أعرفه من قبل
Dialogue: 0,0:21:30.10,0:21:34.07,Ending,,0,0,0,,كعكة اللحظة المنتظرة في كل احتفال مميز
Dialogue: 0,0:21:34.10,0:21:37.81,Ending,,0,0,0,,نظرنا إلى بعضنا البعض وقلنا "إنه لذيذ"
Dialogue: 0,0:21:37.89,0:21:41.08,Ending,,0,0,0,,"إنه لذيذ"، قلنا، ونحن ننظر إلى بعضنا البعض.
Dialogue: 0,0:21:41.17,0:21:44.76,Ending,,0,0,0,,تلك الأيام التي تخطفك من الواقع بجمالها
Dialogue: 0,0:21:44.78,0:21:49.12,Ending,,0,0,0,,...أتمنى أن تدوم
Dialogue: 0,0:21:49.13,0:21:53.15,Ending,,0,0,0,,كأنه يتمنى، وكأنني أرجو
Dialogue: 0,0:21:53.14,0:21:56.74,Ending,,0,0,0,,أتذوقها واحدةً تلو الأخرى
Dialogue: 0,0:21:56.76,0:22:00.82,Ending,,0,0,0,,فوق أضواء الزينة
Dialogue: 0,0:22:00.84,0:22:04.72,Ending,,0,0,0,,ستقوم بتلوينه كما تشاء
Dialogue: 0,0:22:04.97,0:22:08.62,Ending,,0,0,0,,لا أحد يستطيع أن يفعل ذلك
Dialogue: 0,0:22:08.73,0:22:13.53,Ending,,0,0,0,,لا أستطيع مساعدته، لا أستطيع أن أتركه
Dialogue: 0,0:22:30.44,0:22:32.69,Default,,0,0,0,,ما زلت تصلح سيف الرياح، أليس كذلك؟
Dialogue: 0,0:22:34.27,0:22:36.61,Default,,0,0,0,,.أطلب منك أن تتحلى بالصبر، سيدي
Dialogue: 0,0:22:37.53,0:22:40.24,Default,,0,0,0,,.احذر، من الأفضل ألا تلمسه
Dialogue: 0,0:22:40.32,0:22:44.91,Default,,0,0,0,,،إذا لمسك روبوتي البيترون جي إكس الصغير الجميل
Dialogue: 0,0:22:44.99,0:22:48.66,Default,,0,0,0,,.ويأكلك دون ترك شعرة واحدة
Dialogue: 0,0:22:48.75,0:22:52.71,Default,,0,0,0,,.ولكن مرة أخرى، أعتقد أن هذا ليس مشكلة بالنسبة لك
Dialogue: 0,0:22:55.71,0:22:57.17,Default,,0,0,0,,...أنت تفهم
Dialogue: 0,0:22:57.71,0:23:00.92,Default,,0,0,0,,،إذا لم تستطع استعادة سيف الرياح لمجده السابق
Dialogue: 0,0:23:01.01,0:23:03.09,Default,,0,0,0,,.فستكون أيامك على الأرض معدودة
Dialogue: 0,0:23:04.80,0:23:06.51,Default,,0,0,0,,،بمجرد أن أصلح سيف الرياح
Dialogue: 0,0:23:06.60,0:23:09.10,Default,,0,0,0,,،ويكتمل هذا القلعة ومدفع أونيمارو
Dialogue: 0,0:23:09.18,0:23:12.60,Default,,0,0,0,,،كل اليابان، لا، العالم بأسره
Dialogue: 0,0:23:12.69,0:23:16.69,Default,,0,0,0,,.سيعاني من رعب وظلام لم يسبق له مثيل
Dialogue: 0,0:23:17.69,0:23:20.15,Default,,0,0,0,,.لقد اخترتك بحكمة
Dialogue: 0,0:23:20.78,0:23:24.49,Default,,0,0,0,,بسيف الرياح، سأدمر كوروغاني يايبا
Dialogue: 0,0:23:25.12,0:23:28.87,Default,,0,0,0,,.وأثبت مكانتي كأقوى شخص في العالم
Dialogue: 0,0:23:28.95,0:23:31.54,Default,,0,0,0,,.ولكن أولاً، علي غزو العالم
Dialogue: 0,0:23:31.62,0:23:33.79,Default,,0,0,0,,!وبأي وسيلة كانت
Dialogue: 0,0:23:36.92,0:23:38.75,Default,,0,0,0,,،لكي تكون لديه فرصة ضد أونيمارو
Dialogue: 0,0:23:38.84,0:23:41.76,Default,,0,0,0,,.على يايبا أن يجد كرة حاكم التنين ليستطيع الطيران
Dialogue: 0,0:23:41.84,0:23:44.64,Default,,0,0,0,,ولكن كيف سيجدها؟
Dialogue: 0,0:23:45.39,0:23:51.53,Top,,0,0,0,,".في الحلقة القادمة، "ابحث عن كرة حاكم التنين
Dialogue: 0,0:23:48.01,0:23:49.81,Default,,0,0,0,,!أعتمد عليكم للباقي
