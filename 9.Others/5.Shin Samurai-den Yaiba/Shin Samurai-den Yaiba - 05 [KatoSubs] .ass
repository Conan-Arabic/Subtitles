Dialogue: 0,0:00:00.00,0:00:07.07,try,,0,0,0,,{\fs73.5\pos(933,108)}@KatoSubs :ترجمة
Dialogue: 0,0:00:10.75,0:00:12.21,try,,0,0,0,,...كوروغاني يايبا
Dialogue: 0,0:00:12.75,0:00:15.17,try,,0,0,0,,أتقول أنّه يحوز على سيف الرايجين؟
Dialogue: 0,0:00:15.50,0:00:16.63,try,,0,0,0,,اجل
Dialogue: 0,0:00:16.83,0:00:17.79,try,,0,0,0,,...مثيرٌ
Dialogue: 0,0:00:18.34,0:00:22.47,try,,0,0,0,,لكن ما بظنّي أنّه قادرٌ على التحكم به
Dialogue: 0,0:00:22.67,0:00:24.09,try,,0,0,0,,صدقتَ
Dialogue: 0,0:00:24.84,0:00:28.43,try,,0,0,0,,،اتحدث كأكثر الوحوش الثمانية دهاءً
Dialogue: 0,0:00:29.00,0:00:30.39,try,,0,0,0,,...فوفقًا لحساباتي
Dialogue: 0,0:00:31.43,0:00:33.69,try,,0,0,0,,!امر ذاك الشقي محسوم
Dialogue: 0,0:00:33.93,0:00:37.56,try,,0,0,0,,!ويُفترض أنّ أحد الوحوش الثمانية قد حاز بالفعل على الرايجين
Dialogue: 0,0:00:37.81,0:00:40.27,try,,0,0,0,,بلغنـا تسجيل
Dialogue: 0,0:00:46.07,0:00:49.53,try,,0,0,0,,!يقـف أمامك أحد خادمين السيّد أونيمارو الثمانية
Dialogue: 0,0:00:50.20,0:00:54.62,try,,0,0,0,,!اُدعى يرقة\N!لكن يمكنكم مناداتي بـيرقانة
Dialogue: 0,0:00:55.37,0:00:58.17,try,,0,0,0,,لمَ لا أحد يعين اليرقة؟
Dialogue: 0,0:00:58.63,0:01:01.16,try,,0,0,0,,...على ما يبدو أنّه وصل متأخّرًا
Dialogue: 0,0:01:01.25,0:01:02.67,try,,0,0,0,,~فهو يرقة بعد كلٍّ
Dialogue: 0,0:01:03.09,0:01:05.30,try,,0,0,0,,أغُلبت الأفعى؟
Dialogue: 0,0:01:05.84,0:01:09.97,try,,0,0,0,,.وما يفوق ذلك سوءً أنّ الضفدع انضمّ للأعداء
Dialogue: 0,0:01:10.26,0:01:15.27,try,,0,0,0,,!كل شيءٍ يجري وفقًا لخطتي طبعًا
Dialogue: 0,0:01:17.23,0:01:18.10,try,,0,0,0,,...يا للألم
Dialogue: 0,0:01:18.40,0:01:19.86,try,,0,0,0,,!يـا للحموضة
Dialogue: 0,0:01:19.90,0:01:21.02,try,,0,0,0,,ملح؟
Dialogue: 0,0:01:21.40,0:01:23.61,try,,0,0,0,,...كلّي مغطًّى بالملح الآن
Dialogue: 0,0:01:23.82,0:01:25.28,try,,0,0,0,,!وجدتهـا
Dialogue: 0,0:01:28.28,0:01:34.57,try,,0,0,0,,!لجسدي اللزج ميزة التصدي لأي هجوم
Dialogue: 0,0:01:35.91,0:01:36.79,try,,0,0,0,,!يـايبـا
Dialogue: 0,0:01:36.91,0:01:38.07,try,,0,0,0,,!استخدم السينبوكين
Dialogue: 0,0:01:40.38,0:01:41.13,try,,0,0,0,,!حسـنٌ
Dialogue: 0,0:01:44.13,0:01:45.88,try,,0,0,0,,...سينـ... بـو
Dialogue: 0,0:01:46.21,0:01:47.59,try,,0,0,0,,!مـ- ملـحٌ؟
Dialogue: 0,0:01:48.80,0:01:50.55,try,,0,0,0,,!كيـــــــــــــــــــــــــــــــــــن...
Dialogue: 0,0:02:04.52,0:02:06.40,try,,0,0,0,,!سأردّ لك الصاع الصاعيــن
Dialogue: 0,0:02:06.60,0:02:08.03,try,,0,0,0,,!مهـلًا
Dialogue: 0,0:02:08.91,0:02:11.87,try,,0,0,0,,،كأكثر الوحوش الثمانية دهاءً
Dialogue: 0,0:02:12.83,0:02:15.49,try,,0,0,0,,أفترض أنّ لديك خطة ثانية؟
Dialogue: 0,0:02:15.99,0:02:18.33,try,,0,0,0,,!بـ- بـالطبع، يمكنك الإعتماد عليّ
Dialogue: 0,0:02:19.12,0:02:23.42,try,,0,0,0,,!اخطّط لما لا مثيل له بينمـا نتحدّث
Dialogue: 0,0:02:42.81,0:02:45.07,try,,0,0,0,,يـايبـا: أسطـورة السـاموراي
Dialogue: 0,0:04:02.81,0:04:04.44,try,,0,0,0,,...اتضوّر جوعًـا
Dialogue: 0,0:04:04.69,0:04:07.81,try,,0,0,0,,تذمّرك هذا لن يزيدنا إلّا جوعا
Dialogue: 0,0:04:08.27,0:04:10.07,try,,0,0,0,,نمشي طوال اليوم
Dialogue: 0,0:04:10.19,0:04:11.61,try,,0,0,0,,علاوةً، لم نذق شيئًا
Dialogue: 0,0:04:11.61,0:04:13.40,try,,0,0,0,,منذ أطحنا بتلك اليرقة الغبيّة
Dialogue: 0,0:04:14.95,0:04:16.07,try,,0,0,0,,...ذاهبون للينبوع
Dialogue: 0,0:04:16.36,0:04:17.28,try,,0,0,0,,...يا لحظهم
Dialogue: 0,0:04:17.45,0:04:19.03,try,,0,0,0,,،كما قلتُ سابقًا
Dialogue: 0,0:04:19.12,0:04:20.29,try,,0,0,0,,-من أين لنا بالمال حتّى
Dialogue: 0,0:04:20.37,0:04:21.95,try,,0,0,0,,!مبــاركٌ لـكم
Dialogue: 0,0:04:22.71,0:04:23.50,try,,0,0,0,,ما الأمر؟
Dialogue: 0,0:04:23.66,0:04:27.71,try,,0,0,0,,!صادف أنّكم الزبائن رقم مليون
Dialogue: 0,0:04:27.75,0:04:28.59,try,,0,0,0,,ماذا؟
Dialogue: 0,0:04:29.09,0:04:32.88,try,,0,0,0,,لذا ألنـا باستضـافتكم خصيصًـا؟
Dialogue: 0,0:04:33.34,0:04:35.34,try,,0,0,0,,...لـ- لكن لا مال لدينا
Dialogue: 0,0:04:35.59,0:04:38.35,try,,0,0,0,,!لا مشكلة\N!كلٌّ على حسابنا
Dialogue: 0,0:04:38.43,0:04:39.68,try,,0,0,0,,!رجاءً، رجاءً
Dialogue: 0,0:04:40.22,0:04:43.64,try,,0,0,0,,...لا بأس إذن ما دمت مصرًّا
Dialogue: 0,0:04:43.77,0:04:45.02,try,,0,0,0,,!مرحبًـا بكـم
Dialogue: 0,0:04:45.10,0:04:47.61,try,,0,0,0,,!اذن ها هنّ مرشداتكم
Dialogue: 0,0:04:47.73,0:04:50.82,try,,0,0,0,,!اذن هيّـا بنـا\N!تفضّلـوا
Dialogue: 0,0:04:50.90,0:04:53.44,try,,0,0,0,,!رافقتـكم الـسلامة
Dialogue: 0,0:04:55.99,0:05:00.91,try,,0,0,0,,الحلقة 5\Nينبوعٌ مرح
Dialogue: 0,0:05:04.83,0:05:05.83,try,,0,0,0,,!يـا للروعـــة
Dialogue: 0,0:05:06.08,0:05:09.38,try,,0,0,0,,!هذا هو الينبوع إذن\N!يمكنني السقوط ولا يصيبني البرد
Dialogue: 0,0:05:12.05,0:05:13.97,try,,0,0,0,,عليك به يا غيروزايمون
Dialogue: 0,0:05:25.81,0:05:28.65,try,,0,0,0,,.لم يحتج الكثير ليختلّ توازنك
Dialogue: 0,0:05:29.02,0:05:32.32,try,,0,0,0,,أوتُسمّي نفسك ساموراي وأنت بهذا الضعف؟
Dialogue: 0,0:05:32.53,0:05:33.48,try,,0,0,0,,!اخــرس
Dialogue: 0,0:05:34.19,0:05:35.78,try,,0,0,0,,لأغلبـنّ أونيمـارو
Dialogue: 0,0:05:36.07,0:05:38.36,try,,0,0,0,,!ولأصبحـنّ أعظـم سـاموراي في اليابـان
Dialogue: 0,0:05:39.99,0:05:41.45,try,,0,0,0,,!لـنعد الكرّة إذن
Dialogue: 0,0:05:41.91,0:05:43.66,try,,0,0,0,,!حسنٌ، لـك ذلـك
Dialogue: 0,0:05:44.66,0:05:46.58,try,,0,0,0,,النساء
Dialogue: 0,0:05:48.75,0:05:52.79,try,,0,0,0,,!الحظاء بمكانٍ كهذا مجانًا لهو ضربٌ من الخيال
Dialogue: 0,0:05:53.38,0:05:53.43,try,,0,0,0,,محال، أثمّة علّةٌ وراء ذلك يا تُرى...؟
Dialogue: 0,0:05:57.01,0:05:58.47,try,,0,0,0,,!لا يهمّ
Dialogue: 0,0:06:03.64,0:06:05.43,try,,0,0,0,,!لا بدّ أنّه يايبا
Dialogue: 0,0:06:13.73,0:06:14.94,try,,0,0,0,,!سـايـاكــا أيّتهـا الـ
Dialogue: 0,0:06:15.03,0:06:16.69,try,,0,0,0,,مـا بـكِ فجـأةً؟
Dialogue: 0,0:06:16.78,0:06:19.28,try,,0,0,0,,ألم تحاول استراق النظر آنفًا؟
Dialogue: 0,0:06:19.41,0:06:20.49,try,,0,0,0,,!يـا لك من منحرفٍ يا يايبـا
Dialogue: 0,0:06:20.82,0:06:23.16,try,,0,0,0,,بـمَ تهذين؟
Dialogue: 0,0:06:26.16,0:06:28.87,try,,0,0,0,,أكان ثمّة ما يستحق المشاهدة؟
Dialogue: 0,0:06:29.91,0:06:32.29,try,,0,0,0,,!حان وقت الجزء 2 من التمرين يا يايبا
Dialogue: 0,0:06:32.83,0:06:36.25,try,,0,0,0,,!لنرى إن كنت قادرًا على تسلق هذا الجدار دون أن تنزلق
Dialogue: 0,0:06:37.38,0:06:40.00,try,,0,0,0,,يسعك مرافقته يا غيروزايمون
Dialogue: 0,0:06:40.25,0:06:41.22,try,,0,0,0,,!فـهو سباقٌ
Dialogue: 0,0:06:41.97,0:06:43.35,try,,0,0,0,,!اراك لاحقًـــا
Dialogue: 0,0:06:43.47,0:06:44.80,try,,0,0,0,,!اِ- اِجحافٌ هذا، نقيق
Dialogue: 0,0:06:46.64,0:06:49.64,try,,0,0,0,,!لقــد فــــــــــــــــزت
Dialogue: 0,0:06:54.52,0:06:56.11,try,,0,0,0,,!لن أستسلم
Dialogue: 0,0:06:56.32,0:06:57.94,try,,0,0,0,,...لا بأس به
Dialogue: 0,0:06:58.36,0:06:58.99,try,,0,0,0,,...ولكن
Dialogue: 0,0:06:59.15,0:07:00.07,try,,0,0,0,,...استعدّوا
Dialogue: 0,0:07:00.15,0:07:01.03,try,,0,0,0,,!الآن
Dialogue: 0,0:07:08.54,0:07:11.08,try,,0,0,0,,،شتّت من فوق واضرب من تحت
Dialogue: 0,0:07:11.08,0:07:13.13,try,,0,0,0,,.أحد أساسيات الحرب
Dialogue: 0,0:07:13.21,0:07:14.96,try,,0,0,0,,مكانٌ بهكذا جمال
Dialogue: 0,0:07:15.17,0:07:18.67,try,,0,0,0,,...لا بدّ أن يجذب الكثير من الحسناوات
Dialogue: 0,0:07:25.76,0:07:27.14,try,,0,0,0,,!يـا للــــلـذّة
Dialogue: 0,0:07:27.72,0:07:30.35,try,,0,0,0,,!لا يسعني تصديق أنّ كل هذا مجاني
Dialogue: 0,0:07:31.73,0:07:33.19,try,,0,0,0,,هذه مزحة، صحيح؟
Dialogue: 0,0:07:33.73,0:07:35.11,try,,0,0,0,,!ما هذا الّذي أراه؟
Dialogue: 0,0:07:35.36,0:07:37.40,try,,0,0,0,,.هذا عقابك لما حدث آنفًا
Dialogue: 0,0:07:37.44,0:07:39.44,try,,0,0,0,,!موساشي من استرق النظر، أليس كذلك؟
Dialogue: 0,0:07:39.65,0:07:41.69,try,,0,0,0,,وألم تتسلّق الجدار؟
Dialogue: 0,0:07:41.78,0:07:43.74,try,,0,0,0,,!كان ذلك جزءً من التمرين
Dialogue: 0,0:07:44.78,0:07:48.20,try,,0,0,0,,ما نحن فاعلون الآن؟
Dialogue: 0,0:07:48.83,0:07:52.54,try,,0,0,0,,لم يكن الرايجين بحوزة الفتاة
Dialogue: 0,0:07:53.21,0:07:55.25,try,,0,0,0,,ما الّذي وجدته بدورك يا نجم البحر؟
Dialogue: 0,0:07:55.54,0:07:57.67,try,,0,0,0,,.السيف بحوزة الشقي
Dialogue: 0,0:07:58.13,0:08:00.88,try,,0,0,0,,!لكنّه يأخذه معه للينبوع حتى
Dialogue: 0,0:08:02.05,0:08:05.84,try,,0,0,0,,...أونستنتج من كلامك هذا يا خيار البحر أنّك
Dialogue: 0,0:08:06.51,0:08:08.93,try,,0,0,0,,!رأيت تلك الفتاة بزيّ عيد ميلادها؟
Dialogue: 0,0:08:09.56,0:08:11.60,try,,0,0,0,,!!محـالٌ أن أفـعل
Dialogue: 0,0:08:13.27,0:08:16.94,try,,0,0,0,,...لـنركّز على الخطة يا سرعوف
Dialogue: 0,0:08:18.36,0:08:19.90,try,,0,0,0,,.لا تحاول كتمان مشاعرك
Dialogue: 0,0:08:20.32,0:08:21.90,try,,0,0,0,,!لسـتُ أفعـل
Dialogue: 0,0:08:21.99,0:08:24.61,try,,0,0,0,,!ولـعلمك، أنّي نجم بحر متزوّج
Dialogue: 0,0:08:24.61,0:08:25.99,try,,0,0,0,,!...على كـلٍّ
Dialogue: 0,0:08:26.24,0:08:29.62,try,,0,0,0,,.حرّي بنا إيجاد طريقة للحوزة على السيف
Dialogue: 0,0:08:29.83,0:08:32.29,try,,0,0,0,,...ما يعيقنا هو السينبوكين
Dialogue: 0,0:08:33.15,0:08:37.04,try,,0,0,0,,ألا توجد طريقة للحظاء به دون الحاجة للقتال؟
Dialogue: 0,0:08:37.71,0:08:42.05,try,,0,0,0,,فقط لو أنّ بمقدوري التحول مثل الأفعى
Dialogue: 0,0:08:42.34,0:08:46.76,try,,0,0,0,,.لحظة إظهار أنفسنا سيتوجّب علينا القتال
Dialogue: 0,0:08:48.22,0:08:50.14,try,,0,0,0,,...تحوّل
Dialogue: 0,0:08:50.68,0:08:52.68,try,,0,0,0,,ما رأيكم بهذا؟
Dialogue: 0,0:08:56.06,0:08:57.40,try,,0,0,0,,!يمكنك الإعتماد عليّ
Dialogue: 0,0:08:57.48,0:08:59.06,try,,0,0,0,,...فهمت
Dialogue: 0,0:09:02.53,0:09:04.45,try,,0,0,0,,!هذا مثالي
Dialogue: 0,0:09:06.11,0:09:09.74,try,,0,0,0,,!امّا الآن فعلينا إيجاد خطة لكلّ أحدٍ منا
Dialogue: 0,0:09:09.83,0:09:11.66,try,,0,0,0,,!لا يسعني الانتظار
Dialogue: 0,0:09:11.87,0:09:14.91,try,,0,0,0,,!لـنفعلها
Dialogue: 0,0:09:16.54,0:09:18.75,try,,0,0,0,,...صحيحٌ أنّني أتحت لك أكل الأرز ولكن
Dialogue: 0,0:09:19.71,0:09:22.96,try,,0,0,0,,لكنّكِ لم تضعي حدًّا لذلك، صحيح؟
Dialogue: 0,0:09:23.42,0:09:25.63,try,,0,0,0,,!لذيـــذ
Dialogue: 0,0:09:27.76,0:09:29.26,try,,0,0,0,,كيموداميشي؟
Dialogue: 0,0:09:29.72,0:09:30.60,try,,0,0,0,,ما هذا؟
Dialogue: 0,0:09:30.72,0:09:34.60,try,,0,0,0,,!اعددنا للتو تحدي كيموداميشي خصيصًا لكم
Dialogue: 0,0:09:34.68,0:09:36.94,try,,0,0,0,,إن تجتازه تنل تجربة
Dialogue: 0,0:09:37.06,0:09:40.31,try,,0,0,0,,...حمّامنـا السرّي الحصري الّذي
Dialogue: 0,0:09:40.77,0:09:42.65,try,,0,0,0,,،يرخي العضلات المتصلبة\N،ينهي آلام الظهر
Dialogue: 0,0:09:42.73,0:09:44.69,try,,0,0,0,,،يعزّز درجاتك الدراسية\Nيعمّ بالرومانسيّة
Dialogue: 0,0:09:44.78,0:09:47.49,try,,0,0,0,,!ويهبك بشرةً كـالحرير
Dialogue: 0,0:09:47.65,0:09:48.95,try,,0,0,0,,!كـالحرير؟
Dialogue: 0,0:09:49.28,0:09:51.03,try,,0,0,0,,لحظة، أوقلت "يعزّز درجات الدراسة"؟
Dialogue: 0,0:09:51.49,0:09:53.87,try,,0,0,0,,اقول، ألذيذٌ هو الكيموداميشي؟
Dialogue: 0,0:09:53.95,0:09:55.70,try,,0,0,0,,.ما هو بأكلٍ
Dialogue: 0,0:09:56.08,0:09:58.29,try,,0,0,0,,.حسنٌ، فكر بالأمر وكأنّه اختبار قوّة
Dialogue: 0,0:09:58.50,0:10:00.96,try,,0,0,0,,،الأمر فحسب أنّه ليس لاختبار جسدك
Dialogue: 0,0:10:01.13,0:10:02.34,try,,0,0,0,,.بل روحك
Dialogue: 0,0:10:04.00,0:10:05.80,try,,0,0,0,,!يبدو مرحًـا
Dialogue: 0,0:10:05.88,0:10:07.05,try,,0,0,0,,!لـنذهب يا ساياكـا
Dialogue: 0,0:10:08.38,0:10:09.89,try,,0,0,0,,،انّـه ينبـوعٌ حارٌّ
Dialogue: 0,0:10:09.93,0:10:11.51,try,,0,0,0,,!لن تجدي له مثيل
Dialogue: 0,0:10:11.85,0:10:14.89,try,,0,0,0,,...حسنٌ، سنقبل كرمك إذن
Dialogue: 0,0:10:14.97,0:10:16.68,try,,0,0,0,,هذه فرصة مثاليّة
Dialogue: 0,0:10:16.77,0:10:19.77,try,,0,0,0,,.لتري ساياكا أنّك مرافق جيّد
Dialogue: 0,0:10:20.27,0:10:21.81,try,,0,0,0,,مرافق؟ وما ذلك؟
Dialogue: 0,0:10:22.11,0:10:24.61,try,,0,0,0,,.أي حامٍ جيّد
Dialogue: 0,0:10:24.69,0:10:27.07,try,,0,0,0,,!فهمت، دع الأمر لي
Dialogue: 0,0:10:32.16,0:10:35.33,try,,0,0,0,,كيموداميشي
Dialogue: 0,0:10:38.21,0:10:39.75,try,,0,0,0,,!يبـدو مثاليًّـا
Dialogue: 0,0:10:40.50,0:10:42.54,try,,0,0,0,,...لـربما علينا العودة
Dialogue: 0,0:10:42.96,0:10:44.75,try,,0,0,0,,...عمّ تتحدّثين بعدما وصلنا
Dialogue: 0,0:10:45.00,0:10:47.01,try,,0,0,0,,.مرحبًا أيّها الأشقياء
Dialogue: 0,0:10:47.51,0:10:48.84,try,,0,0,0,,!من تكون يا هذا؟
Dialogue: 0,0:10:49.38,0:10:51.59,try,,0,0,0,,.اعمل لدى الفندق
Dialogue: 0,0:10:51.89,0:10:55.89,try,,0,0,0,,.اتيت لتفسير نظام الكيموداميشي
Dialogue: 0,0:10:56.39,0:10:58.31,try,,0,0,0,,لمَ يتنكر نجم بحرٍ؟
Dialogue: 0,0:10:58.52,0:11:00.35,try,,0,0,0,,.بسيطةٌ هي القوانين
Dialogue: 0,0:11:01.31,0:11:06.15,try,,0,0,0,,.امضِ ولا تدرن ظهرًا
Dialogue: 0,0:11:06.69,0:11:08.90,try,,0,0,0,,أذاك كل ما في الأمر؟
Dialogue: 0,0:11:08.99,0:11:11.57,try,,0,0,0,,.والآن، لكم بالذهاب
Dialogue: 0,0:11:12.07,0:11:12.95,try,,0,0,0,,!ولكن قبل ذلك
Dialogue: 0,0:11:12.99,0:11:16.49,try,,0,0,0,,!دعني أحمل ذاك السيف الخطير عليك
Dialogue: 0,0:11:16.91,0:11:18.16,try,,0,0,0,,!ولـمَ؟
Dialogue: 0,0:11:19.12,0:11:20.71,try,,0,0,0,,!انّها مجرد لعبة
Dialogue: 0,0:11:20.83,0:11:22.29,try,,0,0,0,,!فلا حاجة لسيفٍ خطير
Dialogue: 0,0:11:23.37,0:11:25.00,try,,0,0,0,,أحقًّا ما يقول؟
Dialogue: 0,0:11:25.25,0:11:26.79,try,,0,0,0,,...اعتقد
Dialogue: 0,0:11:27.30,0:11:30.17,try,,0,0,0,,...اعتدت على رؤيتك حاملًا له فما فطنت لخطورته
Dialogue: 0,0:11:30.63,0:11:31.97,try,,0,0,0,,.حسنٌ إذن
Dialogue: 0,0:11:32.72,0:11:34.64,try,,0,0,0,,!حسـنٌ! كلٌّ يجري وفقًا للخطة
Dialogue: 0,0:11:35.14,0:11:37.51,try,,0,0,0,,!...قليلٌ بعد ويصبح الرايجين ملكنا
Dialogue: 0,0:11:39.39,0:11:40.89,try,,0,0,0,,لا بأس ما دام في الغمد إذن، صحيح؟
Dialogue: 0,0:11:41.93,0:11:43.44,try,,0,0,0,,.حسنٌ، هيّا بنا يا ساياكا
Dialogue: 0,0:11:43.56,0:11:46.07,try,,0,0,0,,!انتظرنــي
Dialogue: 0,0:11:48.27,0:11:51.11,try,,0,0,0,,...لم يسر الأمر كما خلت
Dialogue: 0,0:11:51.53,0:11:52.36,try,,0,0,0,,...ولكن
Dialogue: 0,0:11:52.78,0:11:54.78,try,,0,0,0,,!لا زالت الخطة تسير
Dialogue: 0,0:11:58.79,0:11:59.75,try,,0,0,0,,،بالمناسبة
Dialogue: 0,0:11:59.91,0:12:02.67,try,,0,0,0,,من هم الوحوش الثمانية خلافك؟
Dialogue: 0,0:12:03.04,0:12:06.88,try,,0,0,0,,،حسنٌ، على سبيل المثال\N.ثمّة المدعو سرعوف، نقيق
Dialogue: 0,0:12:07.38,0:12:08.96,try,,0,0,0,,،وهو خصمٌ خبيث
Dialogue: 0,0:12:09.05,0:12:11.34,try,,0,0,0,,.يختفي ثمّ ينقض
Dialogue: 0,0:12:11.67,0:12:14.39,try,,0,0,0,,...سرعوفٌ إذن
Dialogue: 0,0:12:16.01,0:12:19.14,try,,0,0,0,,.السرعوف من صفوة الممثلين
Dialogue: 0,0:12:19.81,0:12:22.64,try,,0,0,0,,.متيقنٌ أنّه سيجد طريقة
Dialogue: 0,0:12:22.73,0:12:26.61,try,,0,0,0,,.سيحوز على الرايجين دون أن يرتاب أحدٌ ذلك
Dialogue: 0,0:12:31.94,0:12:33.24,try,,0,0,0,,!مـا- مــاذا؟
Dialogue: 0,0:12:34.24,0:12:35.82,try,,0,0,0,,...احدٌ ما
Dialogue: 0,0:12:36.20,0:12:39.24,try,,0,0,0,,...فليمدّ لي أحدٌ ما يد العون
Dialogue: 0,0:12:40.03,0:12:43.08,try,,0,0,0,,أجدّةٌ هي...؟
Dialogue: 0,0:12:44.96,0:12:47.50,try,,0,0,0,,...تمثّل عجوزًا إذن
Dialogue: 0,0:12:48.46,0:12:52.21,try,,0,0,0,,!قد يفلح الأمر مع ذلك
Dialogue: 0,0:12:52.59,0:12:55.05,try,,0,0,0,,!عليك بهـما يا سرعـوف
Dialogue: 0,0:12:56.47,0:12:58.72,try,,0,0,0,,ما بكِ يا جدّة؟
Dialogue: 0,0:13:00.26,0:13:02.81,try,,0,0,0,,.اصبت ساقي
Dialogue: 0,0:13:03.43,0:13:05.69,try,,0,0,0,,ألي بالاتكاء على كتفك...؟
Dialogue: 0,0:13:05.89,0:13:09.19,try,,0,0,0,,.كتفًا تقولين؟ لكنكِ جِدّ ضخمة
Dialogue: 0,0:13:09.40,0:13:12.03,try,,0,0,0,,!ويا لأعينٍ كبيرة تمتلكينها
Dialogue: 0,0:13:12.36,0:13:17.82,try,,0,0,0,,...حتى أستطيع رؤيتك جيّدًا
Dialogue: 0,0:13:17.91,0:13:18.57,try,,0,0,0,,ماذا؟
Dialogue: 0,0:13:18.91,0:13:21.37,try,,0,0,0,,...اقترب أكثر
Dialogue: 0,0:13:21.74,0:13:23.54,try,,0,0,0,,...سمعت ذلك من قبل
Dialogue: 0,0:13:23.70,0:13:25.29,try,,0,0,0,,ذات الرداء الأحمر؟
Dialogue: 0,0:13:27.54,0:13:28.54,try,,0,0,0,,ما هذه؟
Dialogue: 0,0:13:28.79,0:13:30.59,try,,0,0,0,,...هذه
Dialogue: 0,0:13:30.92,0:13:34.05,try,,0,0,0,,!نصـولٌ لـتقطيعك إربًـا
Dialogue: 0,0:13:34.59,0:13:37.47,try,,0,0,0,,،ما بمقدورك أن تستل سيفك\N!فلا حيلة لك
Dialogue: 0,0:13:37.89,0:13:39.97,try,,0,0,0,,!نجحت خطّتـــي
Dialogue: 0,0:13:41.76,0:13:43.77,try,,0,0,0,,!...ويحـك يـا يايبـا
Dialogue: 0,0:13:45.35,0:13:47.85,try,,0,0,0,,.ما بكِ يا ساياكا؟ لم أخرجه من الغمد
Dialogue: 0,0:13:48.44,0:13:51.02,try,,0,0,0,,!لا يجوز ضرب عجوزٍ مسكينة
Dialogue: 0,0:13:51.77,0:13:53.27,try,,0,0,0,,.نحن جِدّ آسفان
Dialogue: 0,0:13:53.61,0:13:54.90,try,,0,0,0,,أبخيرٍ أنتِ؟
Dialogue: 0,0:13:55.82,0:13:57.49,try,,0,0,0,,!حمدًا
Dialogue: 0,0:13:57.86,0:13:59.49,try,,0,0,0,,.هيّا نمضِ يا يايبا
Dialogue: 0,0:13:59.53,0:14:01.83,try,,0,0,0,,لكن ما الّذي أخطأت بشأنه؟
Dialogue: 0,0:14:02.62,0:14:05.08,try,,0,0,0,,!...ضربك بكلّ قوته ومع ذلك صمدت
Dialogue: 0,0:14:05.16,0:14:06.91,try,,0,0,0,,!كما هو متوقّعٌ من السيد سرعوف
Dialogue: 0,0:14:07.46,0:14:09.63,try,,0,0,0,,...فشلت الخطة ولكن
Dialogue: 0,0:14:11.59,0:14:15.67,try,,0,0,0,,!!الـسيّـد سـرعــــــــــــــــــــــــــــــــــوف
Dialogue: 0,0:14:17.13,0:14:18.88,try,,0,0,0,,...وثمّة أيضًا
Dialogue: 0,0:14:18.97,0:14:21.09,try,,0,0,0,,.خيار البحر، نقيق
Dialogue: 0,0:14:21.22,0:14:24.51,try,,0,0,0,,،انّه ألطف الوحوش الثمانية\N~لو رأيت كم هو ظريف
Dialogue: 0,0:14:24.77,0:14:27.85,try,,0,0,0,,ولكن ما بمقدور خيار البحر فعله؟
Dialogue: 0,0:14:29.31,0:14:30.81,try,,0,0,0,,مـا هذه؟
Dialogue: 0,0:14:31.35,0:14:32.90,try,,0,0,0,,"ألسنة الشياطين"
Dialogue: 0,0:14:33.02,0:14:35.78,try,,0,0,0,,...يُفترض أنهم لإخافة الناس ولكن
Dialogue: 0,0:14:37.65,0:14:40.70,try,,0,0,0,,.علقوها بشكلٍ هش حتى تسقط بسهولة
Dialogue: 0,0:14:41.32,0:14:43.41,try,,0,0,0,,.اظنّ أنّي دست على أحدها منذ برهة
Dialogue: 0,0:14:43.58,0:14:45.99,try,,0,0,0,,...وأنا أيضًا
Dialogue: 0,0:14:47.66,0:14:48.62,try,,0,0,0,,...فهمت
Dialogue: 0,0:14:49.04,0:14:52.17,try,,0,0,0,,...اختفى هو أيضًا
Dialogue: 0,0:14:52.58,0:14:54.79,try,,0,0,0,,...فـعندما يمرون
Dialogue: 0,0:14:55.75,0:14:59.88,try,,0,0,0,,...فلترهم أنّك لست مجرد كتلة
Dialogue: 0,0:14:59.97,0:15:01.38,try,,0,0,0,,!يـا خيار البحر
Dialogue: 0,0:15:07.14,0:15:11.77,try,,0,0,0,,!!الـسيّد خيـــــــــــــــــار البحـــــــــــــــــــر
Dialogue: 0,0:15:13.35,0:15:16.65,try,,0,0,0,,.وثمّة نجم البحر أيضًا
Dialogue: 0,0:15:16.77,0:15:18.78,try,,0,0,0,,.وهو أكثرنا حماسًا
Dialogue: 0,0:15:18.99,0:15:21.15,try,,0,0,0,,...نجم بحرٍ تقول
Dialogue: 0,0:15:24.66,0:15:27.49,try,,0,0,0,,...لا أكاد أصدق أنهم هُزموا
Dialogue: 0,0:15:28.20,0:15:31.46,try,,0,0,0,,.لكن خطتي النهائية منيعة
Dialogue: 0,0:15:31.71,0:15:35.71,try,,0,0,0,,!سيسلموننا سيف الرايجين طوعًا
Dialogue: 0,0:15:38.80,0:15:44.14,try,,0,0,0,,ادخل سيفك هنا لـيظهر الحمام السري"؟"
Dialogue: 0,0:15:45.26,0:15:47.51,try,,0,0,0,,اين يقصد؟
Dialogue: 0,0:15:47.85,0:15:48.72,try,,0,0,0,,هنـا؟
Dialogue: 0,0:15:48.77,0:15:51.48,try,,0,0,0,,!مهـلًا، لا يُفترض بك أن تستل سيفك
Dialogue: 0,0:15:53.65,0:15:56.65,try,,0,0,0,,!كاصطياد السمك
Dialogue: 0,0:15:57.02,0:15:58.90,try,,0,0,0,,!انت ذاك العامل في الفندق
Dialogue: 0,0:15:59.07,0:16:01.45,try,,0,0,0,,!لسـتُ كذلـك
Dialogue: 0,0:16:04.41,0:16:07.58,try,,0,0,0,,!بل أحد الوحوش الثمانية الخادمين للسيد أونيمارو
Dialogue: 0,0:16:08.24,0:16:09.91,try,,0,0,0,,!نجـم الـبحر
Dialogue: 0,0:16:10.62,0:16:11.71,try,,0,0,0,,!احد الوحوش؟
Dialogue: 0,0:16:12.00,0:16:14.54,try,,0,0,0,,~لا عجب أنّه بدا مضحكًا
Dialogue: 0,0:16:14.83,0:16:16.33,try,,0,0,0,,مضحكـ-؟
Dialogue: 0,0:16:17.21,0:16:20.25,try,,0,0,0,,!لن تطول إهانتكِ لي بعد قليل
Dialogue: 0,0:16:20.42,0:16:21.71,try,,0,0,0,,!-ايّـها الـ
Dialogue: 0,0:16:24.05,0:16:25.72,try,,0,0,0,,!ماذا؟ لا أستطيع سحبه
Dialogue: 0,0:16:25.84,0:16:26.47,try,,0,0,0,,!ماذا؟
Dialogue: 0,0:16:28.26,0:16:32.73,try,,0,0,0,,!حشوت الشق بصمغٍ منيع
Dialogue: 0,0:16:33.14,0:16:34.19,try,,0,0,0,,!ما الّذي قلت؟
Dialogue: 0,0:16:34.52,0:16:38.52,try,,0,0,0,,!لا فائدة لـسيف الرايجين الآن
Dialogue: 0,0:16:39.27,0:16:40.73,try,,0,0,0,,!استـعدّ
Dialogue: 0,0:16:41.07,0:16:44.57,try,,0,0,0,,،بدون سيفك العزيز\N!يمكنني الإطاحة بك بنفسي
Dialogue: 0,0:16:44.82,0:16:46.49,try,,0,0,0,,!لسـت وحـدك
Dialogue: 0,0:16:48.28,0:16:51.83,try,,0,0,0,,!انا أحد الوحوش الثمانية، السرعـوف
Dialogue: 0,0:16:52.45,0:16:55.04,try,,0,0,0,,!وأنـا خيـار البـحر -زورا
Dialogue: 0,0:16:55.12,0:16:56.58,try,,0,0,0,,!يا جماعة
Dialogue: 0,0:16:56.83,0:16:58.88,try,,0,0,0,,!انت من حاول إخافتنا آنفًا
Dialogue: 0,0:16:59.17,0:17:00.95,try,,0,0,0,,!أجميعكم مع أونيمارو؟
Dialogue: 0,0:17:01.80,0:17:04.63,try,,0,0,0,,!والآن، يستحيل نصركم
Dialogue: 0,0:17:04.88,0:17:05.92,try,,0,0,0,,...لذا فلـ
Dialogue: 0,0:17:07.84,0:17:09.55,try,,0,0,0,,!على رسلك يا يايبا
Dialogue: 0,0:17:10.81,0:17:12.52,try,,0,0,0,,!عقيمةٌ هي محاولاتك
Dialogue: 0,0:17:12.71,0:17:14.14,try,,0,0,0,,،ان لم تود تسليمه بطواعية
Dialogue: 0,0:17:14.89,0:17:17.18,try,,0,0,0,,!فسيتوجب علينا أخذه قسـرًا
Dialogue: 0,0:17:25.15,0:17:28.24,try,,0,0,0,,!!الـسيّد نجــــــــــــــــــــم البحـــــــــــــــــــــــــر
Dialogue: 0,0:17:36.71,0:17:39.75,try,,0,0,0,,...ارى أنّ الأدريلانين عنده مرتفع
Dialogue: 0,0:17:41.17,0:17:42.55,try,,0,0,0,,!سحـب سيف الرايجين
Dialogue: 0,0:17:42.92,0:17:46.80,try,,0,0,0,,.باءت خطّتي العبقرية... بالفشل
Dialogue: 0,0:17:47.43,0:17:48.43,try,,0,0,0,,...انصتوا يا رفقة
Dialogue: 0,0:17:48.72,0:17:50.55,try,,0,0,0,,...لا خيار لدينا الآن
Dialogue: 0,0:17:51.01,0:17:54.27,try,,0,0,0,,!ان عدنا خالي الوفاض ليقطعنّ السيد أونيمارو رؤوسنا
Dialogue: 0,0:17:54.56,0:17:59.23,try,,0,0,0,,!لذا لـنتحد ثلاثتنـا ولـنطح بهمـا
Dialogue: 0,0:17:59.60,0:18:03.19,try,,0,0,0,,!فلـنريهما ممّا نحن مصنوعون حقًّا
Dialogue: 0,0:18:06.65,0:18:09.32,try,,0,0,0,,!استعد لتنال حتفك يا يايبـا\Nما خطب الأرض فجأةً؟-
Dialogue: 0,0:18:09.45,0:18:10.28,try,,0,0,0,,زلزال؟
Dialogue: 0,0:18:31.51,0:18:32.76,try,,0,0,0,,!مـا هذا يا تُرى؟
Dialogue: 0,0:18:33.26,0:18:35.64,try,,0,0,0,,!قصة الينبوع السري صحيحة
Dialogue: 0,0:18:37.60,0:18:39.14,try,,0,0,0,,ايـن اختفوا أولئك؟
Dialogue: 0,0:18:42.94,0:18:44.94,try,,0,0,0,,.الدنيا دوارة، نقيق
Dialogue: 0,0:18:45.73,0:18:48.69,try,,0,0,0,,...محالٌ أن يخاف ساموراي عظيم مثلي من هكذا
Dialogue: 0,0:18:49.24,0:18:52.16,try,,0,0,0,,~احـدٌ قادم
Dialogue: 0,0:18:56.91,0:18:59.04,try,,0,0,0,,أهذا الشيء يُدعى خيار بحر؟
Dialogue: 0,0:18:59.12,0:19:01.17,try,,0,0,0,,!كُـفّ عن ذلك
Dialogue: 0,0:19:05.21,0:19:06.51,try,,0,0,0,,...هذا
Dialogue: 0,0:19:08.63,0:19:09.88,try,,0,0,0,,.افقت إذن
Dialogue: 0,0:19:15.26,0:19:16.97,try,,0,0,0,,!انّى لكم مهاجمتنا في نومنـا؟
Dialogue: 0,0:19:17.27,0:19:19.81,try,,0,0,0,,...عمّ تتحدث؟ لقد أغثناكم
Dialogue: 0,0:19:22.15,0:19:23.35,try,,0,0,0,,إلى ما ترمي؟
Dialogue: 0,0:19:23.48,0:19:24.77,try,,0,0,0,,ما الّذي حدث؟
Dialogue: 0,0:19:25.15,0:19:28.03,try,,0,0,0,,...اصحاب الفندق أخبرونا بأنّكم أسرتموهم
Dialogue: 0,0:19:28.65,0:19:31.82,try,,0,0,0,,.بـاغين سرقـة سيف الرايجين
Dialogue: 0,0:19:33.49,0:19:35.24,try,,0,0,0,,اذن لمَ...؟
Dialogue: 0,0:19:35.57,0:19:37.20,try,,0,0,0,,تقول لمَ؟
Dialogue: 0,0:19:37.62,0:19:40.04,try,,0,0,0,,...لا يمكننا ترككم في تلك حالة حتى لو كنتم أعداءنا
Dialogue: 0,0:19:40.08,0:19:43.62,try,,0,0,0,,حسنٌ، كان تحدي الكيموداميشي ممتعًا قليلًا
Dialogue: 0,0:19:43.96,0:19:48.51,try,,0,0,0,,.علاوةً، أشاد غيروزايمون بطيبة قلبكم
Dialogue: 0,0:19:48.67,0:19:49.55,try,,0,0,0,,!نقيـق
Dialogue: 0,0:19:53.01,0:19:54.51,try,,0,0,0,,...يـا لـ
Dialogue: 0,0:19:54.59,0:19:56.68,try,,0,0,0,,!يــا لـطيبـة قلـبـكم
Dialogue: 0,0:19:57.01,0:19:59.43,try,,0,0,0,,!مضى الكثير منذ حظينا بهكذا لطف
Dialogue: 0,0:19:59.52,0:20:02.02,try,,0,0,0,,!فـأونيمارو جِدّ لئيم
Dialogue: 0,0:20:02.35,0:20:04.77,try,,0,0,0,,!ولا يعطينا فلسًـا
Dialogue: 0,0:20:05.98,0:20:07.61,try,,0,0,0,,،لقد أنقذتموننا
Dialogue: 0,0:20:08.27,0:20:11.65,try,,0,0,0,,لكن فور عودتنا سيفعل\N!النقيض تمامًا
Dialogue: 0,0:20:12.15,0:20:14.66,try,,0,0,0,,.لا حاجة لكم بالعودة إذن
Dialogue: 0,0:20:16.12,0:20:19.62,try,,0,0,0,,.لكم حرية فعل ما تبتغونه
Dialogue: 0,0:20:20.25,0:20:22.04,try,,0,0,0,,.هذا ما فعلته
Dialogue: 0,0:20:22.66,0:20:26.75,try,,0,0,0,,ولكن إن عبثتم معنا ثانيةً\Nبنتعشاكم، تمام؟
Dialogue: 0,0:20:28.34,0:20:30.05,try,,0,0,0,,...ما أبتغي
Dialogue: 0,0:20:31.59,0:20:35.34,try,,0,0,0,,...اعود إلى موطني على ما أظن
Dialogue: 0,0:20:35.84,0:20:37.01,try,,0,0,0,,.وأنا أيضًا
Dialogue: 0,0:20:37.43,0:20:40.81,try,,0,0,0,,...سأعود لزوجتي في كيوشو\N.وأعيش حياةً هنيئةً
Dialogue: 0,0:20:41.14,0:20:42.64,try,,0,0,0,,أقلت كيوشو؟
Dialogue: 0,0:20:43.02,0:20:45.48,try,,0,0,0,,.نحن متجهون إلى جزيرة غانريو
Dialogue: 0,0:20:45.65,0:20:46.35,try,,0,0,0,,!جزيرة غانريو؟
Dialogue: 0,0:20:46.98,0:20:50.77,try,,0,0,0,,أتلك الّتي تقع بين هونشو وكيوشو؟
Dialogue: 0,0:20:51.23,0:20:53.19,try,,0,0,0,,...صحيح
Dialogue: 0,0:20:53.28,0:20:55.15,try,,0,0,0,,!لطالما وددت الذهاب إليها
Dialogue: 0,0:20:55.57,0:20:58.20,try,,0,0,0,,أيمكنني مرافقتكم؟
Dialogue: 0,0:20:59.49,0:21:02.75,try,,0,0,0,,...كنت عدوًّا قبل قليل
Dialogue: 0,0:21:07.00,0:21:09.84,try,,0,0,0,,!ليس الأمر كما يبدو\N!كلٌّ يجري وفقًا لخطتي
Dialogue: 0,0:21:10.00,0:21:11.21,try,,0,0,0,,!اخـــرس
Dialogue: 0,0:21:12.13,0:21:14.93,try,,0,0,0,,...السيد أونيمارو
Dialogue: 0,0:21:19.97,0:21:24.39,try,,0,0,0,,...لم يتبق إليّ إلا الاعتماد على أقواهم
Dialogue: 0,0:21:37.32,0:21:40.03,try,,0,0,0,,أناديتني يا سيدي أونيمارو؟
Dialogue: 0,0:21:40.74,0:21:42.33,try,,0,0,0,,!كفـانا لهـوًا
Dialogue: 0,0:21:42.70,0:21:43.62,try,,0,0,0,,قلتنتزع سيف الرايجين
Dialogue: 0,0:21:43.62,0:21:45.37,try,,0,0,0,,...من يدي كوروغاني يايبا
Dialogue: 0,0:21:45.91,0:21:47.41,try,,0,0,0,,!ولتسلمني إيّاه
Dialogue: 0,0:21:48.46,0:21:50.33,try,,0,0,0,,.تحت أمرك
Dialogue: 0,0:23:35.81,0:23:38.73,try,,0,0,0,,!مهلًا، فلتعد إليّ الكوشيكاتسو خاصتي
Dialogue: 0,0:23:38.82,0:23:42.32,try,,0,0,0,,.هذا الوحش يبدو كالمهرج
Dialogue: 0,0:23:42.53,0:23:44.07,try,,0,0,0,,أهو قويٌّ حقًّا؟
Dialogue: 0,0:23:44.62,0:23:46.28,try,,0,0,0,,،في المرة القادمة\N"دراكولا"
Dialogue: 0,0:23:46.48,0:23:49.05,try,,0,0,0,,!انّه أقوى الوحوش الثمانية، نقيق
